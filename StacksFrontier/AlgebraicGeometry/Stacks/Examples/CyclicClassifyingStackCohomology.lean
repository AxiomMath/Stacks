/-!
# `H^m([S/(ℤ/pℤ)], 𝒪)` contains `k[x]` as a direct summand

Let `k` be a field of characteristic `p`, `S = Spec k[x]`, `𝒳 = [S/(ℤ/pℤ)]` and
`f : 𝒳 ⟶ S` the structure morphism. This file proves that for every `m ≥ 0` the higher direct
image `R^m(Γ(S, f_* -))(𝒪_𝒳)` has `Γ(S, 𝒪_S) = k[x]` as a linear retract (Stacks 07DC): there are
a class `e` and a `Γ(S, 𝒪_S)`-linear form `ψ` with `ψ e = 1`.

## The argument

It is the source's. The trivial torsor `U` covers the final object of the pointwise quotient
`𝒫 = [S/_p(ℤ/pℤ)]`, a dense subsite of `𝒳`, and its powers `U^{n+1}` lie over the affine schemes
`(ℤ/pℤ)ⁿ_S`, where `𝒪_𝒳` has no higher cohomology. So the Čech complex of `𝒪` for `U` computes
the cohomology of `𝒪_𝒳` (Stacks 03F7, `Stacks.CechTop.exists_quasiIso_cechFunctorZ`). Restricting
along the morphisms `σ_t : U ⟶ U^{n+1}` given by the partial products of `t ∈ Aut(U)ⁿ`
identifies it with the complex of inhomogeneous cochains of `Aut(U) ≅ ℤ/pℤ` with values in
`Γ(S, 𝒪_S)` for the trivial action, and `H^m(ℤ/pℤ, k[x]) ≅ k[x]`
(`Stacks.GroupCohomology.TrivialCochains.exists_cocycle_pairing`).

## Main results

* `exists_linearMap_rightDerived_cyclicPushforwardSections` (in
  `Stacks.Examples.UnboundedDerivedPushforward`): for every `m`, a class `e` in
  `R^m Γ(S, f_* -)(𝒪_𝒳)` and a `Γ(S, 𝒪_S)`-linear form `ψ` with `ψ e = 1`.
* `Stacks.Examples.UnboundedDerivedPushforward.exists_cocycle_pairing_cyclicGroup`: a cocycle and
  dual weights for the trivial cohomology of `ℤ/pℤ` with coefficients in `ℤ/pℤ`, in every positive
  degree.
* `CategoryTheory.InjectiveResolution.mapRightDerivedObjIsoOfCompIso`: right derived functors
  through an isomorphism of composites `F ⋙ L ≅ R₁ ⋙ R₂`, `L` preserving homology.

## References

* [Stacks Project, Tag 07DC](https://stacks.math.columbia.edu/tag/07DC)
* [Stacks Project, Tag 03F7](https://stacks.math.columbia.edu/tag/03F7)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open Stacks.GroupCohomology.TrivialCochains Simplicial Stacks.Cohomology.SiteModules

universe u

namespace Stacks.Examples.UnboundedDerivedPushforward

section Algebra

variable (p : ℕ) [Fact p.Prime]

/-- `ℤ/pℤ`, written multiplicatively, is generated by the image of `1`. -/
theorem mem_zpowers_ofAdd_one (x : CyclicGroup p) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod p)) := by
  refine ⟨((Multiplicative.toAdd x).val : ℤ), ?_⟩
  simp only [← ofAdd_zsmul]
  apply Multiplicative.toAdd.injective
  change ((Multiplicative.toAdd x).val : ℤ) • (1 : ZMod p) = Multiplicative.toAdd x
  simp [zsmul_eq_mul, ZMod.natCast_val, ZMod.cast_id]

/-- **The trivial cohomology of `ℤ/pℤ` with coefficients in `ℤ/pℤ` is not zero** in any
degree. -/
theorem nontrivial_groupCohomology_cyclicGroup (n : ℕ) :
    Nontrivial (groupCohomology (Rep.trivial (ZMod p) (CyclicGroup p) (ZMod p)) n) := by
  have : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have : Fact (1 < p) := ⟨(Fact.out : p.Prime).one_lt⟩
  exact (Stacks.GroupCohomology.TrivialCyclic.cohomologyIsoOfCharP
    (Rep.trivial (ZMod p) (CyclicGroup p) (ZMod p)) (Multiplicative.ofAdd (1 : ZMod p))
    (mem_zpowers_ofAdd_one p) p (by simp) n).toLinearEquiv.toEquiv.nontrivial

/-- **A cocycle and dual weights for the trivial cohomology of `ℤ/pℤ`**, in degree `n + 1`, with
coefficients in `ℤ/pℤ`: a cocycle `c` and weights `ℓ` whose pairing kills every coboundary and
takes the value `1` on `c`. -/
theorem exists_cocycle_pairing_cyclicGroup (n : ℕ) :
    ∃ c ℓ : (Fin (n + 1) → CyclicGroup p) → ZMod p, trivialCoboundary (ZMod p) (n + 1) c = 0 ∧
      (∀ w : (Fin n → CyclicGroup p) → ZMod p, pairing ℓ (trivialCoboundary (ZMod p) n w) = 0) ∧
        pairing ℓ c = 1 := by
  have : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  classical
  exact exists_cocycle_pairing n (nontrivial_groupCohomology_cyclicGroup p (n + 1))

end Algebra

section Cech

variable (p : ℕ) [NeZero p] [Fact p.Prime] {k : Type u} [Field k] (𝒞 : BigFppfSite.{u})
  (hS : 𝒞.Contains (Spec (.of (Polynomial k))))

/-- Every endomorphism of the trivial torsor `U` is an automorphism. -/
def cyclicPointwiseAutEquivEnd :
    Aut (cyclicPointwiseUnitObject p 𝒞 hS) ≃
      (cyclicPointwiseUnitObject p 𝒞 hS ⟶ cyclicPointwiseUnitObject p 𝒞 hS) :=
  Equiv.ofBijective (fun α => α.asIso.hom) ⟨fun _ _ h => Aut.ext (Iso.ext h), fun f =>
    haveI := isIso_of_cyclicPointwiseUnitObject_endo p 𝒞 hS f
    ⟨.of (asIso f), rfl⟩⟩

omit [Fact p.Prime] in
/-- The automorphism group of `U` has order `p`. -/
theorem natCard_aut_cyclicPointwiseUnitObject :
    Nat.card (Aut (cyclicPointwiseUnitObject p 𝒞 hS)) = p :=
  (Nat.card_congr (cyclicPointwiseAutEquivEnd p 𝒞 hS)).trans
    (natCard_cyclicPointwiseUnitObject_end p 𝒞 hS)

/-- **The automorphism group of `U` is `ℤ/pℤ`**: both are groups of prime order `p`. -/
def cyclicPointwiseAutMulEquiv : CyclicGroup p ≃* Aut (cyclicPointwiseUnitObject p 𝒞 hS) :=
  mulEquivOfPrimeCardEq (by rw [Nat.card_eq_fintype_card]; simp)
    (natCard_aut_cyclicPointwiseUnitObject p 𝒞 hS)

/-- The action of `ℤ/pℤ` on `U` through `cyclicPointwiseAutMulEquiv`. -/
def cyclicPointwiseAction (g : CyclicGroup p) :
    cyclicPointwiseUnitObject p 𝒞 hS ⟶ cyclicPointwiseUnitObject p 𝒞 hS :=
  (cyclicPointwiseAutMulEquiv p 𝒞 hS g).asIso.hom

/-- The action of `ℤ/pℤ` on `U` is multiplicative (`ℤ/pℤ` is commutative). -/
theorem cyclicPointwiseAction_mul (a b : CyclicGroup p) :
    cyclicPointwiseAction p 𝒞 hS (a * b) =
      cyclicPointwiseAction p 𝒞 hS a ≫ cyclicPointwiseAction p 𝒞 hS b := by
  simp only [cyclicPointwiseAction]
  rw [mul_comm a b, map_mul, Aut.mul_asIso]
  rfl

/-- The action of `ℤ/pℤ` on `U` sends `1` to the identity. -/
theorem cyclicPointwiseAction_one : cyclicPointwiseAction p 𝒞 hS 1 = 𝟙 _ := by
  rw [cyclicPointwiseAction, map_one]
  rfl

/-- The action of `ℤ/pℤ` on `U` is faithful. -/
theorem cyclicPointwiseAction_injective : Function.Injective (cyclicPointwiseAction p 𝒞 hS) :=
  fun _ _ h => (cyclicPointwiseAutMulEquiv p 𝒞 hS).injective (Aut.ext (Iso.ext h))

/-- The structure sheaf of `[S/(ℤ/pℤ)]`, restricted to the pointwise quotient. -/
abbrev cyclicPointwiseStructureModule : SheafOfModules.{u} (cyclicPointwiseRing p 𝒞 hS) :=
  (cyclicPointwiseRestriction p 𝒞 hS).obj (SheafOfModules.unit (cyclicStackRing p 𝒞 hS))

omit [Fact p.Prime] in
/-- The restriction maps of the restricted structure sheaf are pullback of functions along the
underlying morphisms of schemes. -/
theorem cyclicPointwiseStructureModule_map_apply {x y : (cyclicPointwise p 𝒞 hS).obj}
    (f : x ⟶ y) (s : (cyclicPointwiseStructureModule p 𝒞 hS).val.obj (op y)) :
    (cyclicPointwiseStructureModule p 𝒞 hS).val.map f.op s =
      ((BigFppfOver.structureSheaf 𝒞 _ hS).obj.map ((cyclicPointwise p 𝒞 hS).p.map f).op).hom
        s := by
  change ((BigFppfOver.structureSheaf 𝒞 _ hS).obj.map
    ((cyclicStackModel p 𝒞 hS).p.map ((cyclicPointwiseInclusion p 𝒞 hS).map f)).op).hom s = _
  rw [cyclicStackModel_p_map_cyclicPointwiseInclusion_map]
  rfl

/-- The automorphisms of `U` act trivially on the structure sheaf: they lie over the identity of
the final object. -/
theorem cyclicPointwiseStructureModule_map_action (g : CyclicGroup p) :
    (cyclicPointwiseStructureModule p 𝒞 hS).val.presheaf.map
      (cyclicPointwiseAction p 𝒞 hS g).op = 𝟙 _ := by
  ext s
  have h : (cyclicPointwise p 𝒞 hS).p.map (cyclicPointwiseAction p 𝒞 hS g) = 𝟙 _ :=
    (isTerminalCyclicBaseObject 𝒞 hS).hom_ext _ _
  refine (cyclicPointwiseStructureModule_map_apply p 𝒞 hS _ s).trans ?_
  rw [h, op_id, CategoryTheory.Functor.map_id]
  rfl

/-- The tuple of morphisms `U ⟶ U^{n+1}` attached to a tuple of elements of `ℤ/pℤ`, by partial
products. -/
abbrev cyclicPointwisePoint (n : ℕ) (t : Fin n → CyclicGroup p) :=
  Stacks.CechTop.groupCochainPoint (cyclicPointwiseUnitObject p 𝒞 hS)
    (cyclicPointwiseAction p 𝒞 hS) n t

/-- The morphisms of `U` to the powers `U^{n+1}`, as pairs. -/
def cyclicPointwisePiHomEquiv (n : ℕ) :
    (cyclicPointwiseUnitObject p 𝒞 hS ⟶ ∏ᶜ fun _ : Fin (n + 1) => cyclicPointwiseUnitObject p 𝒞 hS)
      ≃ (Fin (n + 1) → (cyclicPointwiseUnitObject p 𝒞 hS ⟶ cyclicPointwiseUnitObject p 𝒞 hS)) where
  toFun g i := g ≫ Pi.π _ i
  invFun g := Pi.lift g
  left_inv g := Pi.hom_ext _ _ fun i => by simp
  right_inv g := funext fun i => by simp

omit [Fact p.Prime] in
/-- There are `pⁿ` morphisms from the final object to the scheme underlying `U^{n+1}`. -/
theorem natCard_cyclicPointwisePi_base (n : ℕ) :
    Nat.card ((cyclicPointwise p 𝒞 hS).p.obj (cyclicPointwiseUnitObject p 𝒞 hS) ⟶
      (cyclicPointwise p 𝒞 hS).p.obj
      ((Stacks.CechTop.cechNerve (cyclicPointwiseUnitObject p 𝒞 hS)).obj (op ⦋n⦌))) = p ^ n := by
  have h1 := Nat.card_congr
    (Equiv.ofBijective _ (bijective_cyclicPointwiseUnitObject_hom_pi p 𝒞 hS n))
  have h2 := Nat.card_congr (cyclicPointwisePiHomEquiv p 𝒞 hS n)
  rw [Nat.card_prod, natCard_cyclicPointwiseUnitObject_end] at h1
  rw [Nat.card_fun, natCard_cyclicPointwiseUnitObject_end,
    Nat.card_eq_fintype_card (α := Fin (n + 1)), Fintype.card_fin] at h2
  have hp : 0 < p := Nat.pos_of_ne_zero (NeZero.ne p)
  have h1' : Nat.card (cyclicPointwiseUnitObject p 𝒞 hS ⟶
      ∏ᶜ fun _ : Fin (n + 1) => cyclicPointwiseUnitObject p 𝒞 hS) =
      Nat.card ((cyclicPointwise p 𝒞 hS).p.obj (cyclicPointwiseUnitObject p 𝒞 hS) ⟶
        (cyclicPointwise p 𝒞 hS).p.obj
          ((Stacks.CechTop.cechNerve (cyclicPointwiseUnitObject p 𝒞 hS)).obj (op ⦋n⦌))) * p := h1
  exact Nat.eq_of_mul_eq_mul_right hp (h1'.symm.trans (h2.trans (pow_succ p n)))

/-- **The morphisms `σ_t : U ⟶ U^{n+1}` lie over all the morphisms from the final object to the
scheme underlying `U^{n+1}`, each exactly once.** -/
theorem bijective_cyclicPointwisePoint (n : ℕ) :
    Function.Bijective (fun t : Fin n → CyclicGroup p =>
      (cyclicPointwise p 𝒞 hS).p.map (cyclicPointwisePoint p 𝒞 hS n t)) := by
  have hinj : Function.Injective (fun t : Fin n → CyclicGroup p =>
      (cyclicPointwise p 𝒞 hS).p.map (cyclicPointwisePoint p 𝒞 hS n t)) := by
    intro t t' h
    have h0 : ∀ t : Fin n → CyclicGroup p, cyclicPointwisePoint p 𝒞 hS n t ≫
        Stacks.CechTop.cechπ (cyclicPointwiseUnitObject p 𝒞 hS) n 0 = 𝟙 _ := by
      intro t
      refine (Stacks.CechTop.groupCochainPoint_π _ _ n t 0).trans ?_
      rw [Fin.partialProd_zero, cyclicPointwiseAction_one]
    have hσ : cyclicPointwisePoint p 𝒞 hS n t = cyclicPointwisePoint p 𝒞 hS n t' :=
      (bijective_cyclicPointwiseUnitObject_hom_pi p 𝒞 hS n).1 (Prod.ext h
        ((h0 t).trans (h0 t').symm))
    have hpp : ∀ i, Fin.partialProd t i = Fin.partialProd t' i := fun i =>
      cyclicPointwiseAction_injective p 𝒞 hS
        ((Stacks.CechTop.groupCochainPoint_π _ _ n t i).symm.trans
          ((congrArg (· ≫ Stacks.CechTop.cechπ (cyclicPointwiseUnitObject p 𝒞 hS) n i) hσ).trans
            (Stacks.CechTop.groupCochainPoint_π _ _ n t' i)))
    funext j
    rw [← Fin.partialProd_right_inv t j, ← Fin.partialProd_right_inv t' j, hpp, hpp]
  have : Finite ((cyclicPointwise p 𝒞 hS).p.obj (cyclicPointwiseUnitObject p 𝒞 hS) ⟶
      (cyclicPointwise p 𝒞 hS).p.obj
        ((Stacks.CechTop.cechNerve (cyclicPointwiseUnitObject p 𝒞 hS)).obj (op ⦋n⦌))) :=
    Nat.finite_of_card_ne_zero (by
      rw [natCard_cyclicPointwisePi_base]
      exact pow_ne_zero _ (NeZero.ne p))
  refine hinj.bijective_of_nat_card_le ?_
  rw [natCard_cyclicPointwisePi_base, Nat.card_fun, Nat.card_eq_fintype_card (α := Fin n),
    Fintype.card_fin, Nat.card_eq_fintype_card (α := CyclicGroup p)]
  simp

/-- Restriction along the `σ_t` is injective on the sections of the structure sheaf over
`U^{n+1}`. -/
theorem cyclicPointwisePoint_injective (n : ℕ)
    (x : (cyclicPointwiseStructureModule p 𝒞 hS).val.obj
      (op ((Stacks.CechTop.cechNerve (cyclicPointwiseUnitObject p 𝒞 hS)).obj (op ⦋n⦌))))
    (hx : ∀ t, (cyclicPointwiseStructureModule p 𝒞 hS).val.map
      (cyclicPointwisePoint p 𝒞 hS n t).op x = 0) : x = 0 := by
  refine (bijective_structureSheaf_map_cyclicPointwisePi p 𝒞 hS n).1 (funext fun b => ?_)
  obtain ⟨t, rfl⟩ := (bijective_cyclicPointwisePoint p 𝒞 hS n).2 b
  refine ((cyclicPointwiseStructureModule_map_apply p 𝒞 hS _ x).symm.trans (hx t)).trans ?_
  exact (map_zero _).symm

/-- Restriction along the `σ_t` is surjective on the sections of the structure sheaf over
`U^{n+1}`: every `ℤ/pℤ`-cochain is attained. -/
theorem cyclicPointwisePoint_surjective (n : ℕ)
    (v : (Fin n → CyclicGroup p) →
      (cyclicPointwiseStructureModule p 𝒞 hS).val.obj (op (cyclicPointwiseUnitObject p 𝒞 hS))) :
    ∃ x : (cyclicPointwiseStructureModule p 𝒞 hS).val.obj
        (op ((Stacks.CechTop.cechNerve (cyclicPointwiseUnitObject p 𝒞 hS)).obj (op ⦋n⦌))),
      ∀ t, (cyclicPointwiseStructureModule p 𝒞 hS).val.map
        (cyclicPointwisePoint p 𝒞 hS n t).op x = v t := by
  let e := Equiv.ofBijective _ (bijective_cyclicPointwisePoint p 𝒞 hS n)
  obtain ⟨x, hx⟩ := (bijective_structureSheaf_map_cyclicPointwisePi p 𝒞 hS n).2
    (fun b => v (e.symm b))
  refine ⟨x, fun t => ?_⟩
  refine (cyclicPointwiseStructureModule_map_apply p 𝒞 hS _ x).trans ?_
  have := congrFun hx ((cyclicPointwise p 𝒞 hS).p.map (cyclicPointwisePoint p 𝒞 hS n t))
  refine this.trans ?_
  exact congrArg v (e.symm_apply_apply t)

variable [CharP k p]

omit [NeZero p] [Fact p.Prime] in
/-- `Γ(S, 𝒪_S) = k[x]` has characteristic `p`. -/
theorem charP_cyclicBaseRing : CharP (cyclicBaseRing 𝒞 hS) p :=
  charP_of_injective_ringHom (R := Polynomial k)
    (f := (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv.hom)
    ((ConcreteCategory.bijective_of_isIso
      (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv).1) p

/-- **A cocycle and dual weights for the trivial cohomology of `ℤ/pℤ` with coefficients in
`Γ(S, 𝒪_S)`**, in degree `n + 1`, reduced from `ℤ/pℤ` along `ℤ/pℤ ⟶ k[x]`. -/
theorem exists_cocycle_pairing_cyclicBaseRing (n : ℕ) :
    ∃ c ℓ : (Fin (n + 1) → CyclicGroup p) → cyclicBaseRing 𝒞 hS,
      trivialCoboundary (cyclicBaseRing 𝒞 hS) (n + 1) c = 0 ∧
      (∀ w : (Fin n → CyclicGroup p) → cyclicBaseRing 𝒞 hS,
        pairing ℓ (trivialCoboundary (cyclicBaseRing 𝒞 hS) n w) = 0) ∧ pairing ℓ c = 1 := by
  have := charP_cyclicBaseRing p 𝒞 hS
  classical
  obtain ⟨c, ℓ, hc, hℓ, hcℓ⟩ := exists_cocycle_pairing_cyclicGroup p n
  let φ : ZMod p →+* cyclicBaseRing 𝒞 hS := ZMod.castHom (dvd_refl p) _
  let : Module (ZMod p) (cyclicBaseRing 𝒞 hS) := Module.compHom _ φ
  refine ⟨φ ∘ c, φ ∘ ℓ, ?_, fun w => ?_, ?_⟩
  · rw [show φ ∘ c = φ.toAddMonoidHom ∘ c from rfl, trivialCoboundary_comp, hc]
    funext t
    exact map_zero φ
  · exact pairing_trivialCoboundary_eq_zero ℓ hℓ w
  · change ∑ t, φ (ℓ t) * φ (c t) = 1
    rw [← map_one φ, ← hcℓ]
    simp only [pairing, map_sum, map_mul, smul_eq_mul]

end Cech

section Main

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck
  Stacks.Cohomology.SiteModules.moduleSheavesEnoughInjectives
  AlgebraicGeometry.BigFppfOver.hasPointwiseRightKanExtension_op_homFunctor

attribute [local instance 10] hasSheafifyEssentiallySmallSite
attribute [local instance] FibredSite.wEqualsLocallyBijective_associatedTopology
  AlgebraicGeometry.Stack.enoughInjectives_fppfSiteModules_of_essentiallySmall
  SheafOfModules.isGrothendieckAbelian_of_essentiallySmall

variable (p : ℕ) [NeZero p] [Fact p.Prime] {k : Type u} [Field k] [CharP k p]
  (𝒞 : BigFppfSite.{u}) (hS : 𝒞.Contains (Spec (.of (Polynomial k))))

/-- The ring `Γ(S, 𝒪_S)` of sections of the structure sheaf of `S` at the final object of its
total category: the ring over which `Γ(S, f_* -)` takes values. It is `cyclicBaseRing`. -/
abbrev cyclicBaseStackRing.{w} : RingCat.{u} :=
  (FibredSite.ringStructureSheafCore 𝒞 _ hS (baseStack.{u, w} 𝒞 hS).val.val.p
    (baseStack.{u, w} 𝒞 hS).val.isFiberedInGroupoids .fppf).obj.obj
      (op (cyclicBaseStackTerminal 𝒞 hS))

/-- The ring at the final object of the total category of `S` as a module over itself. -/
abbrev cyclicBaseStackRingModule.{w} : ModuleCat.{u} (cyclicBaseStackRing.{u, w} 𝒞 hS) :=
  @ModuleCat.of (cyclicBaseStackRing.{u, w} 𝒞 hS) _ (cyclicBaseStackRing.{u, w} 𝒞 hS) _
    Semiring.toModule

omit [Fact p.Prime] [CharP k p] in
/-- The scalars act on the sections of the structure sheaf over `U` by multiplication:
`U` lies over the final object, so `Γ(S, 𝒪_S) ⟶ 𝒪(U)` is the identity. -/
theorem baseToSections_cyclicPointwiseUnitObject (a : cyclicBaseRing 𝒞 hS) :
    Stacks.CechTop.baseToSections (cyclicPointwiseRing p 𝒞 hS)
      (cyclicPointwiseBaseRingHom p 𝒞 hS) (op (cyclicPointwiseUnitObject p 𝒞 hS)) a = a := by
  change ((BigFppfOver.structureSheaf 𝒞 _ hS).obj.map ((isTerminalCyclicBaseObject 𝒞 hS).from
    (cyclicBaseObject 𝒞 hS)).op).hom a = a
  rw [show (isTerminalCyclicBaseObject 𝒞 hS).from (cyclicBaseObject 𝒞 hS) = 𝟙 _ from
    (isTerminalCyclicBaseObject 𝒞 hS).hom_ext _ _, op_id, CategoryTheory.Functor.map_id]
  rfl

/-- **A Čech class with a linear form taking the value `1`**, in every degree `m`, for the
structure sheaf on the pointwise quotient and the cover `U` of the final object. -/
theorem exists_homology_cechFunctorOverBase_cyclic (m : ℕ) :
    ∃ (e : ((Stacks.CechTop.cechFunctorOverBase (cyclicPointwiseUnitObject p 𝒞 hS)
        (cyclicPointwiseRing p 𝒞 hS) (cyclicPointwiseBaseRingHom p 𝒞 hS)).obj
          (cyclicPointwiseStructureModule p 𝒞 hS)).homology m)
      (ψ : ((Stacks.CechTop.cechFunctorOverBase (cyclicPointwiseUnitObject p 𝒞 hS)
        (cyclicPointwiseRing p 𝒞 hS) (cyclicPointwiseBaseRingHom p 𝒞 hS)).obj
          (cyclicPointwiseStructureModule p 𝒞 hS)).homology m ⟶
        (ModuleCat.uliftFunctor.{u + 1} (cyclicBaseRing 𝒞 hS)).obj
          (Stacks.CechTop.sectionsOverBaseObj (cyclicPointwiseRing p 𝒞 hS)
            (cyclicPointwiseBaseRingHom p 𝒞 hS)
              (cyclicPointwiseStructureModule p 𝒞 hS) (op (cyclicPointwiseUnitObject p 𝒞 hS)))),
      ψ e = ULift.up (1 : (cyclicStackRing p 𝒞 hS).obj.obj
        (op ((cyclicPointwiseInclusion p 𝒞 hS).obj (cyclicPointwiseUnitObject p 𝒞 hS)))) := by
  classical
  cases m with
  | zero =>
    exact Stacks.CechTop.exists_homology_cechFunctorOverBase_zero _ _ _
      (cyclicPointwiseAction_mul p 𝒞 hS) (cyclicPointwiseStructureModule_map_action p 𝒞 hS)
      (cyclicPointwisePoint_injective p 𝒞 hS 1) (cyclicPointwisePoint_surjective p 𝒞 hS 0) _
  | succ n =>
    obtain ⟨c, ℓ, hc, hℓ, hcℓ⟩ := exists_cocycle_pairing_cyclicBaseRing p 𝒞 hS n
    exact Stacks.CechTop.exists_homology_cechFunctorOverBase_succ _ _ _
      (cyclicPointwiseAction_mul p 𝒞 hS) (cyclicPointwiseStructureModule_map_action p 𝒞 hS) n
      (cyclicPointwisePoint_injective p 𝒞 hS (n + 2))
      (cyclicPointwisePoint_surjective p 𝒞 hS (n + 1))
      c ℓ hc hℓ hcℓ _

omit [Fact p.Prime] [CharP k p] in
/-- The global sections over the pointwise quotient of the restriction of an injective resolution
of `𝒪_𝒳` compute the Čech cohomology of `𝒪` for the cover `U` of the final object (Stacks 03F7):
the sections over every power `U^{m+1}`, lying over an affine scheme, have no higher
cohomology. -/
theorem nonempty_iso_homology_globalSections_cechFunctorOverBase
    (R : InjectiveResolution (SheafOfModules.unit (cyclicStackRing p 𝒞 hS))) (m : ℕ) :
    Nonempty ((((Stacks.CechTop.globalSectionsOverBase (cyclicPointwiseRing p 𝒞 hS)
      (cyclicPointwiseBaseRingHom p 𝒞 hS)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj (cyclicPointwiseInjectiveResolution p 𝒞 hS R).cocomplex).homology
          m ≅
      ((Stacks.CechTop.cechFunctorOverBase (cyclicPointwiseUnitObject p 𝒞 hS)
        (cyclicPointwiseRing p 𝒞 hS) (cyclicPointwiseBaseRingHom p 𝒞 hS)).obj
          (cyclicPointwiseStructureModule p 𝒞 hS)).homology m) := by
  obtain ⟨T, φ, ψ, hφ, hψ⟩ := Stacks.CechTop.exists_quasiIso_cechFunctorZ
    (cyclicPointwiseRing p 𝒞 hS) (cyclicPointwiseBaseRingHom p 𝒞 hS)
    (cyclicPointwiseInjectiveResolution p 𝒞 hS R)
    (coversTop_cyclicPointwiseUnitObject p 𝒞 hS)
    (fun n q hq => exactAt_evaluation_cyclicPointwiseInjectiveResolution p 𝒞 hS R _
      (isAffine_cyclicPointwisePi p 𝒞 hS n) q hq)
  exact ⟨((((Stacks.CechTop.globalSectionsOverBase (cyclicPointwiseRing p 𝒞 hS)
      (cyclicPointwiseBaseRingHom p 𝒞 hS)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj (cyclicPointwiseInjectiveResolution p 𝒞 hS R).cocomplex
          ).extendHomologyIso ComplexShape.embeddingUpNat (j := m) rfl).symm ≪≫
      (HomologicalComplex.homologyFunctor _ _ (m : ℤ)).mapIso
        (Stacks.DerivedIndexing.mapExtendIso (Stacks.CechTop.globalSectionsOverBase
          (cyclicPointwiseRing p 𝒞 hS) (cyclicPointwiseBaseRingHom p 𝒞 hS))
          ComplexShape.embeddingUpNat (cyclicPointwiseInjectiveResolution p 𝒞 hS R).cocomplex) ≪≫
      @asIso _ _ _ _ (HomologicalComplex.homologyMap φ (m : ℤ))
        ((quasiIsoAt_iff_isIso_homologyMap φ (m : ℤ)).mp (hφ.quasiIsoAt (m : ℤ))) ≪≫
      (@asIso _ _ _ _ (HomologicalComplex.homologyMap ψ (m : ℤ))
        ((quasiIsoAt_iff_isIso_homologyMap ψ (m : ℤ)).mp (hψ.quasiIsoAt (m : ℤ)))).symm ≪≫
      HomologicalComplex.extendHomologyIso ((Stacks.CechTop.cechFunctorOverBase
        (cyclicPointwiseUnitObject p 𝒞 hS) (cyclicPointwiseRing p 𝒞 hS)
          (cyclicPointwiseBaseRingHom p 𝒞 hS)).obj
            (cyclicPointwiseStructureModule p 𝒞 hS)) ComplexShape.embeddingUpNat (j := m) rfl⟩

/-- The universe lift of modules over `Γ(S, 𝒪_S)`, read on the modules over the ring at the final
object of the total category of `S` (the same ring), to the universe of the objects of `𝒳`. -/
def cyclicBaseStackULift.{w} :
    ModuleCat.{u} (cyclicBaseStackRing.{u, w} 𝒞 hS) ⥤ ModuleCat.{u + 1} (cyclicBaseRing 𝒞 hS) :=
  ModuleCat.uliftFunctor.{u + 1} (cyclicBaseRing 𝒞 hS)

/-- **`Γ(S, f_* -) ≅ Γ(𝒫, -|_𝒫)`**: the sections of the direct image over the final object of `S`,
lifted to the universe of the objects of `𝒳`, are the global sections of the restriction to the
pointwise quotient, linearly over `Γ(S, 𝒪_S)` and naturally in the module. -/
def cyclicPushforwardSectionsIsoPointwise.{w} :
    cyclicPushforwardSections.{u, w} p 𝒞 hS ⋙ cyclicBaseStackULift.{u, w} 𝒞 hS ≅
      cyclicPointwiseRestriction p 𝒞 hS ⋙
        Stacks.CechTop.globalSectionsOverBase (cyclicPointwiseRing p 𝒞 hS)
          (cyclicPointwiseBaseRingHom p 𝒞 hS) :=
  cyclicPushforwardSectionsIso.{u, w} p 𝒞 hS ≪≫ cyclicPointwiseSectionsIso p 𝒞 hS

end Main

