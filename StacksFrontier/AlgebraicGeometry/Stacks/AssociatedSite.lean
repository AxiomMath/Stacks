module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Stacks.RepresentableDiagonal
public import StacksFrontier.CategoryTheory.Sites.Stack.InheritedSite
public import StacksFrontier.CategoryTheory.TwoYoneda.Basic

/-!
# The site associated to a category over the big fppf site of a scheme

Let `S` be a scheme contained in a big fppf site `B` and let `p : 𝒳 ⥤ (Sch/S)` be a category
over the big fppf category of `S`. For each of the five standard topologies — Zariski, étale,
smooth, syntomic and fppf — `𝒳` carries the structure of a site, with the topology inherited
(Stacks 06NV) from the localization at `S` of the corresponding big topology on the underlying
category of schemes. The construction is given once, for an arbitrary topology on the
underlying category of schemes of `B`.

## Main definitions

* `AlgebraicGeometry.Stack.associatedTopology`: the site associated to a category over the big
  fppf category of `S` and a topology on the underlying category of schemes.
* `AlgebraicGeometry.Stack.fppfTopology`: the fppf site of a category fibred in groupoids over
  the big fppf category of `S`.
* `AlgebraicGeometry.Stack.objectMorphism`: the 1-morphism to a category fibred in groupoids
  from the category represented by a scheme an object of its fibre lies over.

## Implementation notes

The construction asks only for a functor to the big fppf category, not for a category fibred in
groupoids: `CategoryTheory.Functor.inheritedTopology` is the Grothendieck topology generated by
the inherited collection of covering families, and fibredness of `p` is what makes that
collection a site (Stacks 06NU), not what makes it exist.

## References

* [Stacks Project, Tag 06TP](https://stacks.math.columbia.edu/tag/06TP)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Stack

universe u v w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The site associated to a category `p : 𝒳 ⥤ (Sch/S)` over the big fppf category of `S` and a
topology `τ` on the underlying category of schemes of `B`: the topology `𝒳` inherits from the
localization of `τ` at `S`. -/
@[stacks 06TP]
abbrev associatedTopology {X : Type v} [Category.{w} X] (p : X ⥤ BigFppfOver B S hS)
    (τ : GrothendieckTopology B.Schemes) : GrothendieckTopology X :=
  p.inheritedTopology (τ.over (B.obj hS))

/-- The fppf site of a category fibred in groupoids over the big fppf category of `S`: the
topology its total category inherits from the big fppf site localized at `S`. -/
abbrev fppfTopology (𝒳 : CatFiberedInGroupoids.{u, v, u + 1, w} (BigFppfOver B S hS)) :
    GrothendieckTopology 𝒳.val.obj :=
  associatedTopology B S hS 𝒳.val.p B.topology

/-- The 1-morphism to a category fibred in groupoids over the big fppf category of `S` from the
category represented by a scheme over `S` that a given object lies over.

For `x` an object of the fibre of `𝒳` over `U`, this is the 1-morphism `x : U → 𝒳`: the
essential preimage of `x` under the evaluation functor of the 2-Yoneda lemma (Stacks 004B),
assembled from the chosen lifts of `x`. -/
noncomputable def objectMorphism
    (𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS))
    {U : BigFppfOver B S hS} (x : 𝒳.val.p.Fiber U) :
    schemeFibredCategory B S hS U ⟶ 𝒳 :=
  Bicategory.InducedBicategory.mkHom
    (Functor.TwoYoneda.liftBased 𝒳.val.p 𝒳.isFiberedInGroupoids U x)

end AlgebraicGeometry.Stack

end
