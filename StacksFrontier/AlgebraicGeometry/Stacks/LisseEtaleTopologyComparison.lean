@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.LisseEtale

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

/-- **The topology the lisse-étale site inherits from `𝒳_{étale}` is coarser than the one
generated by the chosen étale covering families between smooth objects.**

With `AlgebraicGeometry.Stack.LisseEtale.topology_le_inclusionTopology` this makes the two
topologies equal; see the implementation notes of this module for the refinement that produces a
*chosen* covering family out of a covering sieve.

This is `AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_le_topology` with its closure
hypothesis discharged, proved here directly rather than through that hypothesis; the primed name
follows the convention of
`AlgebraicGeometry.Stack.LisseEtale.isContinuous_inclusion'`. -/
theorem inclusionTopology_le_topology' :
    inclusionTopology.{u, w} B S hS 𝒳 ≤ topology.{u, w} B S hS 𝒳 := by
  have hfib : 𝒳.val.val.p.IsFibered := 𝒳.val.isFiberedInGroupoids.isFibered
  refine Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr ?_
  intro x R hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  have h1 : Sieve.generate (R.map (smoothObject.{u, w} B S hS 𝒳).ι) ∈
      𝒳.val.val.p.inheritedTopology ((etaleTopology B).over (B.obj hS)) x.obj := by
    have := hR.2
    rwa [GrothendieckTopology.mem_toPrecoverage_iff] at this
  rw [Functor.inheritedTopology_eq,
    Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at h1
  obtain ⟨R₁, hR₁, hR₁le⟩ := h1
  have h2 := hR₁.2
  rw [GrothendieckTopology.mem_toPrecoverage_iff, GrothendieckTopology.mem_over_iff] at h2
  obtain ⟨E₂, hE₂, hle₂⟩ := exists_etaleCovering_le_of_mem_etaleTopology B h2
  -- lift each member of the chosen étale family to a smooth object over `x`
  have key : ∀ i : E₂.I₀, ∃ (v : LisseEtale.{u, w} B S hS 𝒳) (k : v ⟶ x),
      (Sieve.generate R).arrows k ∧
      ∃ h : (toSchemes.{u, w} B S hS 𝒳).obj v = E₂.X i,
        (toSchemes.{u, w} B S hS 𝒳).map k = eqToHom h ≫ E₂.f i := by
    intro i
    have h3 : (Sieve.overEquiv _ (Sieve.generate (R₁.map 𝒳.val.val.p))).arrows (E₂.f i) :=
      hle₂ _ _ (Presieve.ofArrows.mk i)
    rw [Sieve.overEquiv_iff] at h3
    obtain ⟨Z, c, d, hd, hcd⟩ := h3
    obtain ⟨hρ⟩ := hd
    rename_i y ρ
    obtain ⟨wobj, v, hv⟩ := Functor.IsFibered.exists_isStronglyCartesian 𝒳.val.val.p (Y := y) c
    have := hv
    have hdom : 𝒳.val.val.p.obj wobj = Over.mk (E₂.f i ≫ (𝒳.val.val.p.obj x.obj).hom) :=
      IsHomLift.domain_eq 𝒳.val.val.p c v
    have hmapv : 𝒳.val.val.p.map v = eqToHom hdom ≫ c := by
      simpa using IsHomLift.fac' 𝒳.val.val.p c v
    have hmap : 𝒳.val.val.p.map (v ≫ ρ) =
        eqToHom hdom ≫ (Over.homMk (E₂.f i) :
          Over.mk (E₂.f i ≫ (𝒳.val.val.p.obj x.obj).hom) ⟶ 𝒳.val.val.p.obj x.obj) := by
      rw [Functor.map_comp, hmapv, Category.assoc, hcd]
    have hleft : (BigFppfOver.forget B S hS).obj (𝒳.val.val.p.obj wobj) = E₂.X i :=
      congrArg (BigFppfOver.forget B S hS).obj hdom
    have hleftmap : (BigFppfOver.forget B S hS).map (𝒳.val.val.p.map (v ≫ ρ)) =
        eqToHom hleft ≫ E₂.f i := by
      rw [hmap, Functor.map_comp, eqToHom_map]
      rfl
    -- the lifted morphism lies over an étale, hence smooth, morphism of schemes
    have hetale : Etale (B.inclusion.map (E₂.f i)) := by
      have h := hE₂.2
      change (E₂.map B.inclusion).presieve₀ ∈ Scheme.etalePrecoverage _ at h
      exact h.2 (Presieve.ofArrows.mk i)
    have hsm : Smooth (B.inclusion.map (𝒳.val.val.p.map (v ≫ ρ)).left) := by
      change Smooth (B.inclusion.map
        ((BigFppfOver.forget B S hS).map (𝒳.val.val.p.map (v ≫ ρ))))
      rw [hleftmap, Functor.map_comp]
      have : IsIso (B.inclusion.map (eqToHom hleft)) := by
        rw [eqToHom_map]; infer_instance
      have : Smooth (B.inclusion.map (E₂.f i)) := inferInstance
      infer_instance
    have hwsm : smoothObject.{u, w} B S hS 𝒳 wobj :=
      closedUnderSmoothMorphisms.{u, w} B S hS 𝒳 (v ≫ ρ) hsm x.property
    refine ⟨⟨wobj, hwsm⟩, ObjectProperty.homMk (v ≫ ρ), ?_, hleft, ?_⟩
    · -- the lift lies in the sieve generated by `R`
      obtain ⟨Z', a, r, hr, har⟩ := hR₁le _ _ hρ
      obtain ⟨hr₀⟩ := hr
      rename_i z r₀
      refine ⟨z, ObjectProperty.homMk (v ≫ a), r₀, hr₀, ?_⟩
      apply (smoothObject.{u, w} B S hS 𝒳).ι.map_injective
      change (v ≫ a) ≫ (smoothObject.{u, w} B S hS 𝒳).ι.map r₀ = v ≫ ρ
      rw [Category.assoc, har]
    · exact hleftmap
  choose W k hk hWX hkf using key
  -- the lifts assemble into a chosen covering family of the lisse-étale site
  set E : PreZeroHypercover.{u + 1} x := ⟨E₂.I₀, W, k⟩ with hE
  have hcomb₂ : PreZeroHypercover.CombinatoriallyEquivalent
      (E.map (toSchemes.{u, w} B S hS 𝒳)) E₂ :=
    ⟨⟨id, hWX, hkf⟩, ⟨id, fun i => (hWX i).symm, fun i => by
      change E₂.f i = eqToHom (hWX i).symm ≫ (toSchemes.{u, w} B S hS 𝒳).map (k i)
      rw [hkf i]
      simp⟩⟩
  have hcomb : Covering.CombEquiv
      (⟨(toSchemes.{u, w} B S hS 𝒳).obj x, E.map (toSchemes.{u, w} B S hS 𝒳)⟩ :
        Covering B.Schemes)
      ⟨(toSchemes.{u, w} B S hS 𝒳).obj x, E₂⟩ :=
    ⟨rfl, hcomb₂⟩
  have hpres : (E.map (toSchemes.{u, w} B S hS 𝒳)).presieve₀ = E₂.presieve₀ :=
    PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hcomb₂
  have hcov : IsCovering.{u, w} B S hS 𝒳 ⟨x, E⟩ := by
    refine ⟨⟨?_, hE₂.1.2⟩,
      (map_mem_iff_of_combEquiv B.inclusion Scheme.etalePrecoverage hcomb).mpr hE₂.2⟩
    have h := hE₂.1.1
    change E₂.presieve₀ ∈ Scheme.fppfPrecoverage.comap B.inclusion _ at h
    change (E.map (toSchemes.{u, w} B S hS 𝒳)).presieve₀ ∈
      Scheme.fppfPrecoverage.comap B.inclusion _
    rw [hpres]
    exact h
  refine (topology.{u, w} B S hS 𝒳).superset_covering ?_
    (Precoverage.generate_mem_toGrothendieck
      (J := precoverage.{u, w} B S hS 𝒳) ⟨E, rfl, hcov⟩)
  rw [Sieve.generate_le_iff]
  rintro Y g ⟨i⟩
  exact hk i

/-- **The two topologies of the lisse-étale site of an algebraic stack agree**: the topology
generated by the chosen étale covering families between smooth objects is the topology the site
inherits from the étale site of `𝒳`. -/
theorem topology_eq_inclusionTopology :
    topology.{u, w} B S hS 𝒳 = inclusionTopology.{u, w} B S hS 𝒳 :=
  le_antisymm (topology_le_inclusionTopology.{u, w} B S hS 𝒳)
    (inclusionTopology_le_topology'.{u, w} B S hS 𝒳)

end AlgebraicGeometry.Stack.LisseEtale

end
