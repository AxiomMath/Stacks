-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

namespace LisseEtale

/-- **The closure condition of Stacks 07AK (1) for the smooth objects.** An object of `𝒳` with a
morphism to a smooth object, lying over a smooth morphism of schemes, is smooth.

This is the only input of Stacks 0788 (1) beyond full faithfulness of the inclusion. Its content
is that smoothness of the 1-morphisms `x : U → 𝒳` of the 2-Yoneda lemma is preserved by
precomposition with a smooth morphism of schemes. -/
def ClosedUnderSmoothMorphisms : Prop :=
  ∀ ⦃x y : 𝒳.val.val.obj⦄ (f : x ⟶ y),
    Smooth (B.inclusion.map (𝒳.val.val.p.map f).left) →
    smoothObject.{u, w} B S hS 𝒳 y → smoothObject.{u, w} B S hS 𝒳 x

/-- The topology of the lisse-étale site in the sense of the source: a family of morphisms of
smooth objects covers exactly when its image covers in the étale site of `𝒳` (**Stacks 06TP** at
the big étale topology of **Stacks 03FF**). -/
abbrev inclusionTopology : GrothendieckTopology (LisseEtale.{u, w} B S hS 𝒳) :=
  (smoothObject.{u, w} B S hS 𝒳).ι.inheritedTopology
    (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))

/-- The image in the category of all schemes of a chosen étale covering family of a big fppf
site is an étale covering family. -/
alias map_mem_etalePrecoverage :=
  AlgebraicGeometry.map_mem_schemeEtalePrecoverage_of_mem_etalePrecoverage

/-- **Continuity of the inclusion of the lisse-étale site (Stacks 0788 (1)), conditional on the
closure property.** This is the étale case of Stacks 07AK with its closure hypothesis exposed. -/
theorem isContinuous_inclusion (h : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    (smoothObject.{u, w} B S hS 𝒳).ι.IsContinuous (inclusionTopology.{u, w} B S hS 𝒳)
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) :=
  isContinuous_ι_etaleTopology B S hS 𝒳.val.val.p (etalePrecoverage B)
    (map_mem_etalePrecoverage B) 𝒳.val.isFiberedInGroupoids _ h

/-- **Cocontinuity of the inclusion of the lisse-étale site (Stacks 0788 (1)), conditional on
the closure property.** -/
theorem isCocontinuous_inclusion (h : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    (smoothObject.{u, w} B S hS 𝒳).ι.IsCocontinuous (inclusionTopology.{u, w} B S hS 𝒳)
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) :=
  isCocontinuous_ι_etaleTopology B S hS 𝒳.val.val.p (etalePrecoverage B)
    (map_mem_etalePrecoverage B) 𝒳.val.isFiberedInGroupoids _ h

/-- **The topology generated by the chosen covering families of the lisse-étale site is coarser
than the one it inherits from `𝒳_{étale}`.**

No hypothesis is needed. A chosen covering family of `AlgebraicGeometry.Stack.LisseEtale.topology`
is a family of morphisms of smooth objects whose family of underlying schemes is a chosen étale
covering family of the big site. Each of its members is strongly cartesian for the inclusion of
the full subcategory, by `CategoryTheory.ObjectProperty.instIsStronglyCartesianIotaMap`, and its
image in `𝒳` is a family of strongly cartesian morphisms, because every morphism of a category
fibred in groupoids is strongly cartesian over its own image; pushing it down to `B.Schemes` gives
back the chosen étale family. So it is a covering family of the inherited precoverage at each of
the two steps `AlgebraicGeometry.Stack.LisseEtale.inclusionTopology` is built from. -/
theorem topology_le_inclusionTopology :
    topology.{u, w} B S hS 𝒳 ≤ inclusionTopology.{u, w} B S hS 𝒳 := by
  refine Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr ?_
  intro X R hR
  obtain ⟨E, rfl, hE⟩ := hR
  refine Precoverage.generate_mem_toGrothendieck ⟨fun _ _ _ => inferInstance, ?_⟩
  refine Precoverage.generate_mem_toGrothendieck
    ⟨fun _ f _ => 𝒳.val.isFiberedInGroupoids.isStronglyCartesian f, ?_⟩
  rw [GrothendieckTopology.mem_toPrecoverage_iff, GrothendieckTopology.mem_over_iff,
    Sieve.overEquiv_generate, ← Sieve.arrows_generate_map_eq_functorPushforward,
    Sieve.generate_sieve]
  apply Precoverage.generate_mem_toGrothendieck
  exact ⟨((E.map (smoothObject.{u, w} B S hS 𝒳).ι).map 𝒳.val.val.p).map
      (BigFppfOver.forget B S hS),
    by simp only [PreZeroHypercover.presieve₀_map], hE⟩

/-- **Every étale covering sieve of a smooth object is refined by a chosen étale covering family
with smooth sources**, conditional on the closure property. This is the converse inequality to
`AlgebraicGeometry.Stack.LisseEtale.topology_le_inclusionTopology`, and the assertion with
content: the inherited topology of the source's own definition is no finer than the topology
generated by the chosen étale covering families.

Both sides are generated by a collection of families, so it suffices to refine a generating family
of the first by a covering family of the second. A generating family of the inherited topology is
one whose image in `𝒳` generates an étale covering sieve there, and
`AlgebraicGeometry.Stack.exists_etaleCovering_le_of_mem_associatedTopology` refines that sieve by
a family whose image is a *chosen* étale covering family. The members of a chosen étale family are
étale (**Stacks 03FF**, through `AlgebraicGeometry.etale_of_mem_etalePrecoverage`), hence smooth,
so their sources are smooth objects by the closure condition; the family therefore lives in the
lisse-étale site, where it is a covering family by construction, and each of its members factors
through a member of the family one started with. -/
theorem inclusionTopology_le_topology
    (hclose : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    inclusionTopology.{u, w} B S hS 𝒳 ≤ topology.{u, w} B S hS 𝒳 := by
  rw [inclusionTopology, Functor.inheritedTopology_eq,
    Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
  intro x R hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  obtain ⟨E, hEcov, hEle⟩ := exists_etaleCovering_le_of_mem_associatedTopology B S hS
    𝒳.val.val.p 𝒳.val.isFiberedInGroupoids _ hR.2
  have hmem : ((E.map 𝒳.val.val.p).map (BigFppfOver.forget B S hS)).presieve₀ ∈
      etalePrecoverage B ((BigFppfOver.forget B S hS).obj (𝒳.val.val.p.obj x.obj)) :=
    ⟨_, rfl, hEcov⟩
  have hsmooth : ∀ i, smoothObject.{u, w} B S hS 𝒳 (E.X i) := fun i => by
    refine hclose (E.f i) ?_ x.property
    have : Etale (B.inclusion.map (𝒳.val.val.p.map (E.f i)).left) :=
      etale_of_mem_etalePrecoverage B _ hmem _ (Presieve.ofArrows.mk i)
    infer_instance
  refine (topology.{u, w} B S hS 𝒳).superset_covering ?_
    (Precoverage.generate_mem_toGrothendieck (J := precoverage.{u, w} B S hS 𝒳)
      (R := (⟨E.I₀, fun i => ⟨E.X i, hsmooth i⟩, fun i => ObjectProperty.homMk (E.f i)⟩ :
        PreZeroHypercover.{u + 1} x).presieve₀) ⟨_, rfl, hEcov⟩)
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  intro i
  obtain ⟨W, h, g, hg, hcomp⟩ := hEle _ _ (Presieve.ofArrows.mk i)
  obtain ⟨hg₀⟩ := hg
  rename_i y₀ g₀
  exact ⟨y₀, ObjectProperty.homMk h, g₀, hg₀,
    (smoothObject.{u, w} B S hS 𝒳).ι.map_injective (by simpa using hcomp)⟩

/-- **The two descriptions of the topology of the lisse-étale site agree**, conditional on the
closure property. The inherited topology of the source's own definition and the topology generated
by the inherited chosen étale covering families are the same Grothendieck topology. -/
theorem inclusionTopology_eq_topology
    (hclose : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    inclusionTopology.{u, w} B S hS 𝒳 = topology.{u, w} B S hS 𝒳 :=
  le_antisymm (inclusionTopology_le_topology.{u, w} B S hS 𝒳 hclose)
    (topology_le_inclusionTopology.{u, w} B S hS 𝒳)

/-- **Continuity of the inclusion for the topology generated by the chosen covering families**,
conditional on the closure property. Restriction along the inclusion carries a sheaf on
`𝒳_{étale}` to a sheaf for the inherited topology by
`AlgebraicGeometry.Stack.LisseEtale.isContinuous_inclusion`, hence to a sheaf for the coarser
generated topology by `AlgebraicGeometry.Stack.LisseEtale.topology_le_inclusionTopology`.

Cocontinuity does *not* transport in this direction, so
`AlgebraicGeometry.Stack.LisseEtale.isCocontinuous_inclusion_topology` goes through the equality
of the two topologies instead. -/
theorem isContinuous_inclusion_topology (h : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    (smoothObject.{u, w} B S hS 𝒳).ι.IsContinuous (topology.{u, w} B S hS 𝒳)
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) := by
  have := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  constructor
  intro G
  exact Presieve.isSheaf_of_le _ (topology_le_inclusionTopology.{u, w} B S hS 𝒳)
    (Functor.op_comp_isSheaf_of_types _ _ _ G)

/-- **Cocontinuity of the inclusion for the topology generated by the chosen covering families**,
conditional on the closure property. Unlike continuity, cocontinuity does not transfer from a
topology to a smaller one, so this needs the equality
`AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology` and not merely
`AlgebraicGeometry.Stack.LisseEtale.topology_le_inclusionTopology`. -/
theorem isCocontinuous_inclusion_topology
    (hclose : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    (smoothObject.{u, w} B S hS 𝒳).ι.IsCocontinuous (topology.{u, w} B S hS 𝒳)
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) := by
  rw [← inclusionTopology_eq_topology.{u, w} B S hS 𝒳 hclose]
  exact isCocontinuous_inclusion.{u, w} B S hS 𝒳 hclose

/-- **The morphism of topoi `g` of Stacks 0788 (1)(a), conditional on the closure property**:
`g : Sh(𝒳_{lisse,étale}) ⟶ Sh(𝒳_{étale})`, with inverse image restriction along the inclusion of
the smooth objects, pushforward its cocontinuous right adjoint, and left exactness of the inverse
image automatic.

Note the shape: the two locality instances cannot be hypotheses of a statement that *names* the
two sheaf functors, because they are needed to form those functors; they are supplied inside the
construction instead, from the closure property. -/
noncomputable def toposMorphism (h : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    MorphismOfTopoi
      (Sheaf (inclusionTopology.{u, w} B S hS 𝒳) (Type (u + 1)))
      (Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (Type (u + 1))) := by
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  exact
    { pushforward :=
        (smoothObject.{u, w} B S hS 𝒳).ι.sheafPushforwardCocontinuous (Type (u + 1)) _ _
      inverseImage :=
        (smoothObject.{u, w} B S hS 𝒳).ι.sheafPushforwardContinuous (Type (u + 1)) _ _
      adj := (smoothObject.{u, w} B S hS 𝒳).ι.sheafAdjunctionCocontinuous (Type (u + 1)) _ _
      preservesFiniteLimits := by infer_instance }

/-- **The morphism of topoi of Stacks 0788 (1)(a), for the chosen-family topology, conditional on
the closure property**: the same morphism of topoi as
`AlgebraicGeometry.Stack.LisseEtale.toposMorphism`, transported along
`AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`, so that its source is the
topos of sheaves for `AlgebraicGeometry.Stack.LisseEtale.topology`. No second construction is
involved: the two topologies are equal, and this is the one morphism of topoi read at the other
description. -/
noncomputable def toposMorphismTopology
    (hclose : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳) :
    MorphismOfTopoi
      (Sheaf (topology.{u, w} B S hS 𝒳) (Type (u + 1)))
      (Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (Type (u + 1))) :=
  inclusionTopology_eq_topology.{u, w} B S hS 𝒳 hclose ▸
    toposMorphism.{u, w} B S hS 𝒳 hclose

/-! ### Abelian sheaves and the lower shriek -/

section Abelian

open Stacks.Sites.LowerShriek.FullyFaithful

variable (h : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳)

include h

/-- **The inverse image `g⁻¹` of Stacks 0788 (1)(a) on abelian sheaves, conditional on the
closure property**: restriction of an abelian sheaf on the étale site of `𝒳` to the smooth
objects. -/
noncomputable abbrev abelianInverseImage :
    Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) AbCat.{u, u + 1} ⥤
      Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AbCat.{u, u + 1} :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  gInv (smoothObject.{u, w} B S hS 𝒳).ι _ _

/-- **The direct image `g_*` of Stacks 0788 (1)(a) on abelian sheaves, conditional on the
closure property.** -/
noncomputable abbrev abelianPushforward :
    Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AbCat.{u, u + 1} ⥤
      Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) AbCat.{u, u + 1} :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  gStar (smoothObject.{u, w} B S hS 𝒳).ι _ _

/-- **The lower shriek `g_!` of Stacks 0788 (1)(b) on abelian sheaves, conditional on the
closure property**: the left adjoint of restriction, obtained from the continuous inclusion as a
left Kan extension followed by sheafification. -/
noncomputable abbrev abelianLowerShriek :
    Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AbCat.{u, u + 1} ⥤
      Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) AbCat.{u, u + 1} :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  gShriek (smoothObject.{u, w} B S hS 𝒳).ι _ _

/-- **The adjunction `g_! ⊣ g⁻¹` of Stacks 0788 (1)(b) on abelian sheaves.** -/
noncomputable abbrev abelianLowerShriekAdjunction :
    abelianLowerShriek.{u, w} B S hS 𝒳 h ⊣ abelianInverseImage.{u, w} B S hS 𝒳 h :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  adjShriek (smoothObject.{u, w} B S hS 𝒳).ι _ _

/-- **The adjunction `g⁻¹ ⊣ g_*` of Stacks 0788 (1)(a) on abelian sheaves.** -/
noncomputable abbrev abelianPushforwardAdjunction :
    abelianInverseImage.{u, w} B S hS 𝒳 h ⊣ abelianPushforward.{u, w} B S hS 𝒳 h :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  adjStar (smoothObject.{u, w} B S hS 𝒳).ι _ _

/-- **Stacks 077I for the lisse-étale inclusion.** The unit `F ⟶ g⁻¹ (g_! F)` of the adjunction
defining the lower shriek on abelian sheaves is an isomorphism: the inclusion is continuous,
cocontinuous and fully faithful, which is exactly the hypothesis of Stacks 077I. -/
theorem isIso_abelianLowerShriek_unit
    (F : Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AbCat.{u, u + 1}) :
    IsIso ((abelianLowerShriekAdjunction.{u, w} B S hS 𝒳 h).unit.app F) := by
  have := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  have := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  exact stacks077I_unit_isIso (smoothObject.{u, w} B S hS 𝒳).ι _ _ F

/-- **Stacks 077I for the lisse-étale inclusion**, counit half: the counit
`g⁻¹ (g_* F) ⟶ F` of the adjunction of the morphism of topoi is an isomorphism. -/
theorem isIso_abelianPushforward_counit
    (F : Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AbCat.{u, u + 1}) :
    IsIso ((abelianPushforwardAdjunction.{u, w} B S hS 𝒳 h).counit.app F) := by
  have := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  have := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  exact stacks077I_counit_isIso (smoothObject.{u, w} B S hS 𝒳).ι _ _ F

end Abelian

/-! ### The lisse-étale site as a ringed topos -/

section Ringed

variable [EssentiallySmall.{u} 𝒳.val.val.obj]

/-- **The étale site of an algebraic stack as a ringed topos**, with the structure sheaf of
**Stacks 06TV**. This is the target of the morphism of ringed topoi of **Stacks 0788** (1). -/
noncomputable abbrev etaleRingedTopos : RingedTopos.{u, u + 1, u} :=
  associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
    (etaleTopology_le_topology B)

variable (h : ClosedUnderSmoothMorphisms.{u, w} B S hS 𝒳)

include h

/-- **The lisse-étale site as a ringed topos**, conditional on the closure property: the smooth
objects with the restriction of the étale structure sheaf. -/
noncomputable abbrev ringedTopos : RingedTopos.{u, u + 1, u} :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  subsiteRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
    (etaleTopology_le_topology B) (smoothObject.{u, w} B S hS 𝒳)

/-- **The morphism of ringed topoi of Stacks 0788 (1)**, conditional on the closure property:
the morphism of topoi `g` together with the structure map identifying the inverse image of the
étale structure sheaf with the lisse-étale one. -/
noncomputable def ringedToposMorphism :
    RingedToposHom (ringedTopos.{u, w} B S hS 𝒳 h) (etaleRingedTopos.{u, w} B S hS 𝒳) :=
  haveI := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  haveI := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  subsiteRingedToposHom B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
    (etaleTopology_le_topology B) (smoothObject.{u, w} B S hS 𝒳)

/-- **The morphism of ringed topoi of Stacks 0788 (1) is flat (Stacks 04JB)**, conditional on
the closure property. -/
theorem isFlat_ringedToposMorphism :
    RingedToposHom.IsFlat
      (X := ringedTopos.{u, w} B S hS 𝒳 h) (Y := etaleRingedTopos.{u, w} B S hS 𝒳)
      (ringedToposMorphism.{u, w} B S hS 𝒳 h) :=
  have := isContinuous_inclusion.{u, w} B S hS 𝒳 h
  have := isCocontinuous_inclusion.{u, w} B S hS 𝒳 h
  isFlat_subsiteRingedToposHom B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
    (etaleTopology_le_topology B) (smoothObject.{u, w} B S hS 𝒳)

end Ringed

end LisseEtale

end AlgebraicGeometry.Stack

