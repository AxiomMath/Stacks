open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Functor

universe v₁ v₂ v₃ v₄ u₁ u₂ u₃ u₄

variable {A : Type u₁} [Category.{v₁} A] {A' : Type u₂} [Category.{v₂} A']
  {D : Type u₃} [Category.{v₃} D] {D' : Type u₄} [Category.{v₄} D']
  [Abelian A] [Abelian A'] [Abelian D] [Abelian D']
  [HasInjectiveResolutions A] [HasInjectiveResolutions A']

/-- **Collapse of the right derived functor of a composite along an exact first factor.** If
`E` is additive, exact and preserves injective objects, then `E` applied to an injective
resolution is an injective resolution, so the right derived functors of `E ⋙ T` are those of `T`
at the image of `E`.

This is `Stacks.RightDerivedComp.objIso` on the whole category: exactness of `E` makes every
object `E`-acyclic, which is the hypothesis that result is stated with. -/
@[sga "4½ Etat_0 4.3.1" "partial"]
def rightDerivedCollapseIsoOfExact (E : A ⥤ A') [E.Additive] [PreservesFiniteLimits E]
    [PreservesFiniteColimits E] [E.PreservesInjectiveObjects] (T : A' ⥤ D') [T.Additive]
    (n : ℕ) :
    (E ⋙ T).rightDerived n ≅ E ⋙ T.rightDerived n :=
  NatIso.ofComponents
    (fun X => _root_.Stacks.RightDerivedComp.objIso E (injectiveResolution X)
      (fun m hm => E.isZero_rightDerived_of_exact X m hm) T n)
    (fun {X Y} g => by
      exact _root_.Stacks.RightDerivedComp.objIso_hom_naturality E T n
        (fun m hm => E.isZero_rightDerived_of_exact X m hm)
        (fun m hm => E.isZero_rightDerived_of_exact Y m hm) g)

/-- **The derived comparison of a commuting square of additive functors.** Let `T : A ⥤ D` and
`T' : A' ⥤ D'` be additive, let `G : D ⥤ D'` be additive and exact and let `E : A ⥤ A'` be
additive, exact and preserve injective objects. An isomorphism `T ⋙ G ≅ E ⋙ T'` induces, in
every degree, an isomorphism `R^n T ⋙ G ≅ E ⋙ R^n T'`.

Right derivation commutes with postcomposition by the exact `G`
(`CategoryTheory.Functor.rightDerivedCompIso`) and collapses along the exact, injective-preserving
`E` (`CategoryTheory.Functor.rightDerivedCollapseIsoOfExact`); in between, the given
isomorphism is derived degreewise. -/
@[sga "4 V 2.5.2" "more general"]
def rightDerivedSquareIsoOfExact (T : A ⥤ D) [T.Additive] (G : D ⥤ D') [G.Additive]
    [G.PreservesHomology] (E : A ⥤ A') [E.Additive] [PreservesFiniteLimits E]
    [PreservesFiniteColimits E] [E.PreservesInjectiveObjects] (T' : A' ⥤ D') [T'.Additive]
    (e : T ⋙ G ≅ E ⋙ T') (n : ℕ) :
    T.rightDerived n ⋙ G ≅ E ⋙ T'.rightDerived n :=
  (T.rightDerivedCompIso G n).symm ≪≫ rightDerivedIsoOfNatIso e n ≪≫
    rightDerivedCollapseIsoOfExact E T' n

end CategoryTheory.Functor

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

namespace LisseEtale

/-- Continuity of the inclusion of the lisse-étale site, with the closure condition of
**Stacks 07AK** (1) discharged, as a local instance. -/
local instance instIsContinuousInclusion (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (smoothObject.{u, w} B S hS 𝒵).ι.IsContinuous (inclusionTopology.{u, w} B S hS 𝒵)
      (associatedTopology B S hS 𝒵.val.val.p (etaleTopology B)) :=
  isContinuous_inclusion B S hS 𝒵 (closedUnderSmoothMorphisms.{u, w} B S hS 𝒵)

/-- Cocontinuity of the inclusion of the lisse-étale site, with the closure condition of
**Stacks 07AK** (1) discharged, as a local instance. -/
local instance instIsCocontinuousInclusion (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (smoothObject.{u, w} B S hS 𝒵).ι.IsCocontinuous (inclusionTopology.{u, w} B S hS 𝒵)
      (associatedTopology B S hS 𝒵.val.val.p (etaleTopology B)) :=
  isCocontinuous_inclusion B S hS 𝒵 (closedUnderSmoothMorphisms.{u, w} B S hS 𝒵)

/-- **Restriction of abelian sheaves to the lisse-étale site is additive**, part of the exactness
assertion of **Stacks 07AS** (1). -/
local instance instAdditiveRestriction (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (subsiteRestriction B S hS 𝒵.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒵)).Additive :=
  Stacks.Cohomology.DerivedLowerShriek.additive_abelianRestriction.{u + 1, u, u + 1, u, u + 1}
    (inclusionTopology.{u, w} B S hS 𝒵)
    (associatedTopology B S hS 𝒵.val.val.p (etaleTopology B))
    (smoothObject.{u, w} B S hS 𝒵).ι

/-- **Restriction of abelian sheaves to the lisse-étale site preserves finite colimits**, part of
**Stacks 07AS** (1): cocontinuity of the inclusion gives restriction the right adjoint `g_*` of
the morphism of topoi, so restriction is a left adjoint. -/
local instance instPreservesFiniteColimitsRestriction
    (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    PreservesFiniteColimits (subsiteRestriction B S hS 𝒵.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒵)) :=
  Stacks.Cohomology.DerivedLowerShriek.preservesFiniteColimits_abelianRestriction.{u + 1, u,
      u + 1, u, u + 1}
    (inclusionTopology.{u, w} B S hS 𝒵)
    (associatedTopology B S hS 𝒵.val.val.p (etaleTopology B))
    (smoothObject.{u, w} B S hS 𝒵).ι

/-- **Restriction of abelian sheaves to the lisse-étale site preserves finite limits**, part of
**Stacks 07AS** (1): restriction is the right adjoint of the lower-shriek functor `g_!`. -/
local instance instPreservesFiniteLimitsRestriction
    (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    PreservesFiniteLimits (subsiteRestriction B S hS 𝒵.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒵)) :=
  inferInstance

/-- Restriction of abelian sheaves to the lisse-étale site preserves homology, being exact. -/
local instance instPreservesHomologyRestriction (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (subsiteRestriction B S hS 𝒵.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒵)).PreservesHomology :=
  Functor.preservesHomologyOfExact _

variable {𝒳 𝒴 : Stack.AlgebraicStacks.{u, w} B S hS}
  (f : 𝒳 ⟶ 𝒴) (hf : AlgebraicStacks.IsSmooth B S hS f)

/-- Continuity of the restriction of a smooth 1-morphism to the lisse-étale sites, for the
topology of the source's own definition. This is **Stacks 07AT** (1) transported along
`AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`. -/
theorem isContinuous_subsiteFunctor :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (smoothObject.{u, w} B S hS 𝒳)
        (smoothObject_map.{u, w} B S hS f hf)).IsContinuous
      (inclusionTopology.{u, w} B S hS 𝒳) (inclusionTopology.{u, w} B S hS 𝒴) := by
  have h := siteFunctor_isContinuous.{u, w} B S hS f hf
  rw [← inclusionTopology_eq_topology.{u, w} B S hS 𝒳
      (closedUnderSmoothMorphisms.{u, w} B S hS 𝒳),
    ← inclusionTopology_eq_topology.{u, w} B S hS 𝒴
      (closedUnderSmoothMorphisms.{u, w} B S hS 𝒴)] at h
  exact h

/-- Cocontinuity of the restriction of a smooth 1-morphism to the lisse-étale sites, for the
topology of the source's own definition. This is **Stacks 07AT** (1) transported along
`AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`. -/
theorem isCocontinuous_subsiteFunctor :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (smoothObject.{u, w} B S hS 𝒳)
        (smoothObject_map.{u, w} B S hS f hf)).IsCocontinuous
      (inclusionTopology.{u, w} B S hS 𝒳) (inclusionTopology.{u, w} B S hS 𝒴) := by
  have h := siteFunctor_isCocontinuous.{u, w} B S hS f hf
  rw [← inclusionTopology_eq_topology.{u, w} B S hS 𝒳
      (closedUnderSmoothMorphisms.{u, w} B S hS 𝒳),
    ← inclusionTopology_eq_topology.{u, w} B S hS 𝒴
      (closedUnderSmoothMorphisms.{u, w} B S hS 𝒴)] at h
  exact h

/-- **Stacks 0GR3, the lisse-étale case: degree zero implies every degree.** Let `f : 𝒳 ⟶ 𝒴` be a
smooth 1-morphism of algebraic stacks, let `g⁻¹` and `(g')⁻¹` be restriction of abelian sheaves
to the lisse-étale sites of `𝒴` and of `𝒳`, and let `f_*` and `f'_*` be the direct images along
`f` and along its restriction `f'` to the lisse-étale sites. Suppose `(g')⁻¹` carries injective
abelian sheaves to injective ones, and that the degree-zero identification
`f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ f'_*` of **Stacks 07AT** (1) holds. Then the higher direct images satisfy

`R^p f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ R^p f'_*`

in every degree `p`, which is the conclusion of **Stacks 0GR3**. -/
@[stacks 0GR3 "the lisse-étale case, as an isomorphism of functors R^p f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ \
R^p f'_* in every degree rather than as invertibility of the canonical base-change map, and \
conditional on two things: its degree-zero case — the identification f'_*(g')⁻¹ = g⁻¹f_* of \
Stacks 07AT (1), which rests on the instance of Stacks 07AK whose hypotheses the source declines \
to verify — and restriction to the subsite preserving injective abelian sheaves, which is \
Stacks 07AS (3)"]
theorem rightDerivedPushforwardRestrictionIso (p : ℕ) :
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (smoothObject.{u, w} B S hS 𝒳)
        (smoothObject_map.{u, w} B S hS f hf)).IsContinuous
          (inclusionTopology.{u, w} B S hS 𝒳) (inclusionTopology.{u, w} B S hS 𝒴) :=
      isContinuous_subsiteFunctor.{u, w} B S hS f hf
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (smoothObject.{u, w} B S hS 𝒳)
        (smoothObject_map.{u, w} B S hS f hf)).IsCocontinuous
          (inclusionTopology.{u, w} B S hS 𝒳) (inclusionTopology.{u, w} B S hS 𝒴) :=
      isCocontinuous_subsiteFunctor.{u, w} B S hS f hf
    letI : f.hom.hom.toFunctor.IsContinuous
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) :=
      (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
        (etaleTopology B)).1
    letI : f.hom.hom.toFunctor.IsCocontinuous
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) :=
      (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
        (etaleTopology B)).2
    letI : (f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    letI : ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
          (smoothObject.{u, w} B S hS 𝒳)
          (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardCocontinuous
        AddCommGrpCat.{u + 1} (inclusionTopology.{u, w} B S hS 𝒳)
        (inclusionTopology.{u, w} B S hS 𝒴)).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    ∀ (_ : (subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
          (smoothObject.{u, w} B S hS 𝒳)).PreservesInjectiveObjects)
      (_ : f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
            (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
            (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) ⋙
          subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
            (smoothObject.{u, w} B S hS 𝒴) ≅
        subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
            (smoothObject.{u, w} B S hS 𝒳) ⋙
          (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
              (smoothObject.{u, w} B S hS 𝒳)
              (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardCocontinuous
            AddCommGrpCat.{u + 1} (inclusionTopology.{u, w} B S hS 𝒳)
            (inclusionTopology.{u, w} B S hS 𝒴)),
      Nonempty
        ((f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
                (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
                (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))).rightDerived p ⋙
            subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
              (smoothObject.{u, w} B S hS 𝒴) ≅
          subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
              (smoothObject.{u, w} B S hS 𝒳) ⋙
            ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
                  (smoothObject.{u, w} B S hS 𝒳)
                  (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardCocontinuous
                AddCommGrpCat.{u + 1} (inclusionTopology.{u, w} B S hS 𝒳)
                (inclusionTopology.{u, w} B S hS 𝒴)).rightDerived p) := by
  have := isContinuous_subsiteFunctor.{u, w} B S hS f hf
  have := isCocontinuous_subsiteFunctor.{u, w} B S hS f hf
  have := isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
    (etaleTopology B)
  obtain ⟨_, _⟩ := this
  exact fun _ hzero => ⟨Functor.rightDerivedSquareIsoOfExact _ _ _ _ hzero p⟩

section Unbounded

attribute [local instance] HasDerivedCategory.standard

/-- **The abelian sheaves on the étale site of an algebraic stack form a Grothendieck abelian
category.** The site of **Stacks 06TP** has objects in `Type (u + 1)` and morphisms in `Type u`,
hence is essentially small in `Type (u + 1)`, which is also the universe of the coefficients; the
assertion then transports along the equivalence with a small model. This is what makes K-injective
resolutions available on the étale site. -/
local instance isGrothendieckAbelian_sheaf_associatedTopology
    (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    IsGrothendieckAbelian.{u + 1} (Sheaf
      (associatedTopology B S hS 𝒵.val.val.p (etaleTopology B)) AddCommGrpCat.{u + 1}) := by
  have : EssentiallySmall.{u + 1} 𝒵.val.val.obj := inferInstance
  have : IsGrothendieckAbelian.{u + 1} AddCommGrpCat.{u + 1} := inferInstance
  have : ∀ X : 𝒵.val.val.objᵒᵖ, HasLimitsOfShape
      (StructuredArrow X (equivSmallModel.{u + 1} 𝒵.val.val.obj).inverse.op)
      AddCommGrpCat.{u + 1} := inferInstance
  have : HasSheafify ((equivSmallModel.{u + 1} 𝒵.val.val.obj).inverse.inducedTopology
      (associatedTopology B S hS 𝒵.val.val.p (etaleTopology B))) AddCommGrpCat.{u + 1} :=
    inferInstance
  exact Sheaf.isGrothendieckAbelian_of_essentiallySmall.{u + 1} _ _

/-- **The abelian sheaves on the lisse-étale site form a Grothendieck abelian category.** As for
the étale site: a full subcategory of an essentially small category is essentially small, so the
lisse-étale site is essentially small in `Type (u + 1)`, the universe of the coefficients. -/
local instance isGrothendieckAbelian_sheaf_inclusionTopology
    (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    IsGrothendieckAbelian.{u + 1}
      (Sheaf (inclusionTopology.{u, w} B S hS 𝒵) AddCommGrpCat.{u + 1}) := by
  have : EssentiallySmall.{u + 1} (LisseEtale.{u, w} B S hS 𝒵) := inferInstance
  have : IsGrothendieckAbelian.{u + 1} AddCommGrpCat.{u + 1} := inferInstance
  have : ∀ X : (LisseEtale.{u, w} B S hS 𝒵)ᵒᵖ, HasLimitsOfShape
      (StructuredArrow X (equivSmallModel.{u + 1} (LisseEtale.{u, w} B S hS 𝒵)).inverse.op)
      AddCommGrpCat.{u + 1} := inferInstance
  have : HasSheafify ((equivSmallModel.{u + 1}
      (LisseEtale.{u, w} B S hS 𝒵)).inverse.inducedTopology
      (inclusionTopology.{u, w} B S hS 𝒵)) AddCommGrpCat.{u + 1} := inferInstance
  exact Sheaf.isGrothendieckAbelian_of_essentiallySmall.{u + 1} _ _

/-- **Stacks 07AV, the lisse-étale case for abelian sheaves: `g⁻¹ ∘ Rf_* = Rf'_* ∘ (g')⁻¹`.** Let
`f : 𝒳 ⟶ 𝒴` be a smooth 1-morphism of algebraic stacks, let `g⁻¹` and `(g')⁻¹` be restriction of
abelian sheaves to the lisse-étale sites of `𝒴` and of `𝒳`, and let `f_*` and `f'_*` be the direct
images along `f` and along its restriction `f'` to the lisse-étale sites. Suppose `(g')⁻¹` carries
K-injective cochain complexes to K-injective ones, and that the degree-zero identification
`f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ f'_*` of **Stacks 07AT** (1) holds. Then, on the unbounded derived
categories,

`Rf'_* ∘ (g')⁻¹ ≅ g⁻¹ ∘ Rf_*`.

Both restrictions are exact, so they act degreewise on derived categories, and the abelian sheaves
on the two sites of `𝒳` are Grothendieck abelian, so both sides are right derived functors of one
and the same functor out of the homotopy category; the isomorphism is the comparison that the
universal property produces. This is
`Stacks.Cohomology.UnboundedComplexes.derivedBaseChangeIso` at this square of sites. -/
@[stacks 07AV "the lisse-étale case for abelian sheaves, first identity: \
Rf'_* ∘ (g')⁻¹ ≅ g⁻¹ ∘ Rf_* on the *unbounded* derived categories. An isomorphism rather than an \
equality, a right derived functor being determined only up to a canonical isomorphism; the two \
total right derived direct images, their comparisons from the degreewise direct images and the two \
IsRightDerivedFunctor properties are carried as data, as in Stacks 0FN6 and 0FN7. Granted: that \
restriction to the lisse-étale site carries K-injective cochain complexes to K-injective ones, \
which is Stacks 08BJ from exactness of g_! = Stacks 07AS (3); and the degree-zero identification \
f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ f'_* of Stacks 07AT (1). The module case is not proved here."]
theorem derivedPushforwardRestrictionIso :
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (smoothObject.{u, w} B S hS 𝒳)
        (smoothObject_map.{u, w} B S hS f hf)).IsContinuous
          (inclusionTopology.{u, w} B S hS 𝒳) (inclusionTopology.{u, w} B S hS 𝒴) :=
      isContinuous_subsiteFunctor.{u, w} B S hS f hf
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (smoothObject.{u, w} B S hS 𝒳)
        (smoothObject_map.{u, w} B S hS f hf)).IsCocontinuous
          (inclusionTopology.{u, w} B S hS 𝒳) (inclusionTopology.{u, w} B S hS 𝒴) :=
      isCocontinuous_subsiteFunctor.{u, w} B S hS f hf
    letI : f.hom.hom.toFunctor.IsContinuous
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) :=
      (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
        (etaleTopology B)).1
    letI : f.hom.hom.toFunctor.IsCocontinuous
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) :=
      (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
        (etaleTopology B)).2
    letI : (f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    letI : ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
          (smoothObject.{u, w} B S hS 𝒳)
          (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardCocontinuous
        AddCommGrpCat.{u + 1} (inclusionTopology.{u, w} B S hS 𝒳)
        (inclusionTopology.{u, w} B S hS 𝒴)).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    ∀ (_hKinj : ∀ I : CochainComplex (Sheaf
            (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
            AddCommGrpCat.{u + 1}) ℤ, I.IsKInjective →
          CochainComplex.IsKInjective
            (((subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
              (smoothObject.{u, w} B S hS 𝒳)).mapHomologicalComplex
                (ComplexShape.up ℤ)).obj I))
      (_hzero : f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
              (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
              (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) ⋙
            subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
              (smoothObject.{u, w} B S hS 𝒴) ≅
          subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
              (smoothObject.{u, w} B S hS 𝒳) ⋙
            (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
                (smoothObject.{u, w} B S hS 𝒳)
                (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardCocontinuous
              AddCommGrpCat.{u + 1} (inclusionTopology.{u, w} B S hS 𝒳)
              (inclusionTopology.{u, w} B S hS 𝒴))
      (Rf : DerivedCategory (Sheaf
            (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
            AddCommGrpCat.{u + 1}) ⥤
          DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))
            AddCommGrpCat.{u + 1}))
      (Rf' : DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒳)
            AddCommGrpCat.{u + 1}) ⥤
          DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒴) AddCommGrpCat.{u + 1}))
      (αf : (f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
              (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
              (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))).mapHomotopyCategory
            (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh ⟶ DerivedCategory.Qh ⋙ Rf)
      (αf' : ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
                (smoothObject.{u, w} B S hS 𝒳)
                (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardCocontinuous
              AddCommGrpCat.{u + 1} (inclusionTopology.{u, w} B S hS 𝒳)
              (inclusionTopology.{u, w} B S hS 𝒴)).mapHomotopyCategory (ComplexShape.up ℤ) ⋙
            DerivedCategory.Qh ⟶ DerivedCategory.Qh ⋙ Rf')
      (_hRf : Rf.IsRightDerivedFunctor αf (HomotopyCategory.quasiIso
          (Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
            AddCommGrpCat.{u + 1}) (ComplexShape.up ℤ)))
      (_hRf' : Rf'.IsRightDerivedFunctor αf' (HomotopyCategory.quasiIso
          (Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AddCommGrpCat.{u + 1})
          (ComplexShape.up ℤ))),
      Nonempty ((subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
            (smoothObject.{u, w} B S hS 𝒳)).mapDerivedCategory ⋙ Rf' ≅
          Rf ⋙ (subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
            (smoothObject.{u, w} B S hS 𝒴)).mapDerivedCategory) := by
  have := isContinuous_subsiteFunctor.{u, w} B S hS f hf
  have := isCocontinuous_subsiteFunctor.{u, w} B S hS f hf
  have := isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
    (etaleTopology B)
  obtain ⟨_, _⟩ := this
  exact fun hKinj hzero Rf Rf' αf αf' hRf hRf' =>
    haveI := hRf
    haveI := hRf'
    ⟨Stacks.Cohomology.UnboundedComplexes.derivedBaseChangeIso
      (subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
        (smoothObject.{u, w} B S hS 𝒳))
      (subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
        (smoothObject.{u, w} B S hS 𝒴)) _ _ Rf Rf' αf αf' hzero.symm hKinj⟩

/-- **Stacks 07AV, the lisse-étale case for abelian sheaves: `L(g')_! ∘ (f')⁻¹ = f⁻¹ ∘ Lg_!`.**
Let `Rf_*` and `Rf'_*` be the total right derived direct images along a smooth 1-morphism
`f : 𝒳 ⟶ 𝒴` and along its restriction `f'` to the lisse-étale sites, let `Lg_!` and `L(g')_!` be
the derived lower shrieks of **Stacks 07AS** (3) over `𝒴` and over `𝒳`, left adjoint to the derived
restrictions `g⁻¹` and `(g')⁻¹`, and let `f⁻¹` and `(f')⁻¹` be the derived inverse images, left
adjoint to `Rf_*` and `Rf'_*`. Then the base change isomorphism
`σ : Rf'_* ∘ (g')⁻¹ ≅ g⁻¹ ∘ Rf_*` of
`AlgebraicGeometry.Stack.LisseEtale.derivedPushforwardRestrictionIso` gives

`f⁻¹ ∘ Lg_! ≅ L(g')_! ∘ (f')⁻¹`.

This is the source's "the rest of the proof is formal": the two sides are left adjoint to the two
sides of `σ`, by composing the adjunctions, and `σ` is the conjugate of the asserted isomorphism
under `CategoryTheory.conjugateIsoEquiv`. -/
@[stacks 07AV "the lisse-étale case for abelian sheaves, second identity: \
f⁻¹ ∘ Lg_! ≅ L(g')_! ∘ (f')⁻¹ on the unbounded derived categories, obtained formally from the \
first identity as its conjugate under the composed adjunctions. An isomorphism rather than an \
equality, the derived functors being determined only up to canonical isomorphism and carried as \
data. Granted: the first identity itself, and the four derived adjunctions Lg_! ⊣ g⁻¹ and \
L(g')_! ⊣ (g')⁻¹ — which are Stacks 07AS (3) — together with f⁻¹ ⊣ Rf_* and (f')⁻¹ ⊣ Rf'_*, which \
are standard. The module case is not proved here."]
def derivedShriekInverseImageIso
    (Rf : DerivedCategory (Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))
        AddCommGrpCat.{u + 1}))
    (Rf' : DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒴) AddCommGrpCat.{u + 1}))
    (Lg : DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒴) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))
        AddCommGrpCat.{u + 1}))
    (Lg' : DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        AddCommGrpCat.{u + 1}))
    (finv : DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))
        AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        AddCommGrpCat.{u + 1}))
    (f'inv : DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒴) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (inclusionTopology.{u, w} B S hS 𝒳) AddCommGrpCat.{u + 1}))
    (adjg : Lg ⊣ (subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒴)).mapDerivedCategory)
    (adjg' : Lg' ⊣ (subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒳)).mapDerivedCategory)
    (adjf : finv ⊣ Rf) (adjf' : f'inv ⊣ Rf')
    (σ : (subsiteRestriction B S hS 𝒳.val.val.p (etaleTopology B)
          (smoothObject.{u, w} B S hS 𝒳)).mapDerivedCategory ⋙ Rf' ≅
        Rf ⋙ (subsiteRestriction B S hS 𝒴.val.val.p (etaleTopology B)
          (smoothObject.{u, w} B S hS 𝒴)).mapDerivedCategory) :
    Lg ⋙ finv ≅ f'inv ⋙ Lg' :=
  (conjugateIsoEquiv (adjf'.comp adjg') (adjg.comp adjf)).symm σ

end Unbounded

end LisseEtale

namespace FlatFppf

/-- Continuity of the inclusion of the flat-fppf site, with the closure condition of
**Stacks 07AK** (1) discharged, as a local instance. -/
local instance instIsContinuousInclusion (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (objectProperty B S hS 𝒵).ι.IsContinuous (inclusionTopology B S hS 𝒵)
      (associatedTopology B S hS 𝒵.val.val.p B.topology) :=
  isContinuous_inclusion B S hS 𝒵 (closedUnderFlatMorphisms B S hS 𝒵)

/-- Cocontinuity of the inclusion of the flat-fppf site, with the closure condition of
**Stacks 07AK** (1) discharged, as a local instance. -/
local instance instIsCocontinuousInclusion (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (objectProperty B S hS 𝒵).ι.IsCocontinuous (inclusionTopology B S hS 𝒵)
      (associatedTopology B S hS 𝒵.val.val.p B.topology) :=
  isCocontinuous_inclusion B S hS 𝒵 (closedUnderFlatMorphisms B S hS 𝒵)

/-- **Restriction of abelian sheaves to the flat-fppf site is additive**, part of the exactness
assertion of **Stacks 07AS** (2). -/
local instance instAdditiveRestriction (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (subsiteRestriction B S hS 𝒵.val.val.p B.topology
      (flatObject B S hS 𝒵.val)).Additive :=
  Stacks.Cohomology.DerivedLowerShriek.additive_abelianRestriction.{u + 1, u, u + 1, u, u + 1}
    (inclusionTopology B S hS 𝒵)
    (associatedTopology B S hS 𝒵.val.val.p B.topology)
    (objectProperty B S hS 𝒵).ι

/-- **Restriction of abelian sheaves to the flat-fppf site preserves finite colimits**, part of
**Stacks 07AS** (2): cocontinuity of the inclusion gives restriction the right adjoint `g_*` of
the morphism of topoi, so restriction is a left adjoint. -/
local instance instPreservesFiniteColimitsRestriction
    (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    PreservesFiniteColimits (subsiteRestriction B S hS 𝒵.val.val.p B.topology
      (flatObject B S hS 𝒵.val)) :=
  Stacks.Cohomology.DerivedLowerShriek.preservesFiniteColimits_abelianRestriction.{u + 1, u,
      u + 1, u, u + 1}
    (inclusionTopology B S hS 𝒵)
    (associatedTopology B S hS 𝒵.val.val.p B.topology)
    (objectProperty B S hS 𝒵).ι

/-- **Restriction of abelian sheaves to the flat-fppf site preserves finite limits**, part of
**Stacks 07AS** (2): restriction is the right adjoint of the lower-shriek functor `g_!`. -/
local instance instPreservesFiniteLimitsRestriction
    (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    PreservesFiniteLimits (subsiteRestriction B S hS 𝒵.val.val.p B.topology
      (flatObject B S hS 𝒵.val)) :=
  inferInstance

/-- Restriction of abelian sheaves to the flat-fppf site preserves homology, being exact. -/
local instance instPreservesHomologyRestriction (𝒵 : Stack.AlgebraicStacks.{u, w} B S hS) :
    (subsiteRestriction B S hS 𝒵.val.val.p B.topology
      (flatObject B S hS 𝒵.val)).PreservesHomology :=
  Functor.preservesHomologyOfExact _

variable {𝒳 𝒴 : Stack.AlgebraicStacks.{u, w} B S hS}
  (f : 𝒳 ⟶ 𝒴) (hf : AlgebraicStacks.IsFlat B S hS f)

/-- Continuity of the restriction of a flat 1-morphism to the flat-fppf sites, for the
topology of the source's own definition. This is **Stacks 07AT** (2) transported along
`AlgebraicGeometry.Stack.FlatFppf.inclusionTopology_eq_topology`. -/
theorem isContinuous_subsiteFunctor :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (flatObject B S hS 𝒳.val)
        (flatObject_map B S hS f hf)).IsContinuous
      (inclusionTopology B S hS 𝒳) (inclusionTopology B S hS 𝒴) := by
  have h := siteFunctor_isContinuous B S hS f hf
  rw [← inclusionTopology_eq_topology B S hS 𝒳, ← inclusionTopology_eq_topology B S hS 𝒴] at h
  exact h

/-- Cocontinuity of the restriction of a flat 1-morphism to the flat-fppf sites, for the
topology of the source's own definition. This is **Stacks 07AT** (2) transported along
`AlgebraicGeometry.Stack.FlatFppf.inclusionTopology_eq_topology`. -/
theorem isCocontinuous_subsiteFunctor :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (flatObject B S hS 𝒳.val)
        (flatObject_map B S hS f hf)).IsCocontinuous
      (inclusionTopology B S hS 𝒳) (inclusionTopology B S hS 𝒴) := by
  have h := siteFunctor_isCocontinuous B S hS f hf
  rw [← inclusionTopology_eq_topology B S hS 𝒳, ← inclusionTopology_eq_topology B S hS 𝒴] at h
  exact h

/-- **Stacks 0GR3, the flat-fppf case: degree zero implies every degree.** Let `f : 𝒳 ⟶ 𝒴` be a
flat 1-morphism of algebraic stacks, let `g⁻¹` and `(g')⁻¹` be restriction of abelian sheaves
to the flat-fppf sites of `𝒴` and of `𝒳`, and let `f_*` and `f'_*` be the direct images along
`f` and along its restriction `f'` to the flat-fppf sites. Suppose `(g')⁻¹` carries injective
abelian sheaves to injective ones, and that the degree-zero identification
`f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ f'_*` of **Stacks 07AT** (2) holds. Then the higher direct images satisfy

`R^p f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ R^p f'_*`

in every degree `p`, which is the conclusion of **Stacks 0GR3**. -/
@[stacks 0GR3 "the flat-fppf case, as an isomorphism of functors R^p f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ \
R^p f'_* in every degree rather than as invertibility of the canonical base-change map, and \
conditional on two things: its degree-zero case — the identification f'_*(g')⁻¹ = g⁻¹f_* of \
Stacks 07AT (2), which rests on the instance of Stacks 07AK whose hypotheses the source declines \
to verify — and restriction to the subsite preserving injective abelian sheaves, which is \
Stacks 07AS (3)"]
theorem rightDerivedPushforwardRestrictionIso (p : ℕ) :
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (flatObject B S hS 𝒳.val)
        (flatObject_map B S hS f hf)).IsContinuous
          (inclusionTopology B S hS 𝒳) (inclusionTopology B S hS 𝒴) :=
      isContinuous_subsiteFunctor B S hS f hf
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (flatObject B S hS 𝒳.val)
        (flatObject_map B S hS f hf)).IsCocontinuous
          (inclusionTopology B S hS 𝒳) (inclusionTopology B S hS 𝒴) :=
      isCocontinuous_subsiteFunctor B S hS f hf
    letI : f.hom.hom.toFunctor.IsContinuous
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology) :=
      (isContinuous_and_isCocontinuous_homFunctor B S hS f).1
    letI : f.hom.hom.toFunctor.IsCocontinuous
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology) :=
      (isContinuous_and_isCocontinuous_homFunctor B S hS f).2
    letI : (f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology)).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    letI : ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
          (flatObject B S hS 𝒳.val)
          (flatObject_map B S hS f hf)).sheafPushforwardCocontinuous
        AddCommGrpCat.{u + 1} (inclusionTopology B S hS 𝒳)
        (inclusionTopology B S hS 𝒴)).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    ∀ (_ : (subsiteRestriction B S hS 𝒳.val.val.p B.topology
          (flatObject B S hS 𝒳.val)).PreservesInjectiveObjects)
      (_ : f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
            (associatedTopology B S hS 𝒳.val.val.p B.topology)
            (associatedTopology B S hS 𝒴.val.val.p B.topology) ⋙
          subsiteRestriction B S hS 𝒴.val.val.p B.topology
            (flatObject B S hS 𝒴.val) ≅
        subsiteRestriction B S hS 𝒳.val.val.p B.topology
            (flatObject B S hS 𝒳.val) ⋙
          (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
              (flatObject B S hS 𝒳.val)
              (flatObject_map B S hS f hf)).sheafPushforwardCocontinuous
            AddCommGrpCat.{u + 1} (inclusionTopology B S hS 𝒳)
            (inclusionTopology B S hS 𝒴)),
      Nonempty
        ((f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
                (associatedTopology B S hS 𝒳.val.val.p B.topology)
                (associatedTopology B S hS 𝒴.val.val.p B.topology)).rightDerived p ⋙
            subsiteRestriction B S hS 𝒴.val.val.p B.topology
              (flatObject B S hS 𝒴.val) ≅
          subsiteRestriction B S hS 𝒳.val.val.p B.topology
              (flatObject B S hS 𝒳.val) ⋙
            ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
                  (flatObject B S hS 𝒳.val)
                  (flatObject_map B S hS f hf)).sheafPushforwardCocontinuous
                AddCommGrpCat.{u + 1} (inclusionTopology B S hS 𝒳)
                (inclusionTopology B S hS 𝒴)).rightDerived p) := by
  have := isContinuous_subsiteFunctor B S hS f hf
  have := isCocontinuous_subsiteFunctor B S hS f hf
  have := isContinuous_and_isCocontinuous_homFunctor B S hS f
  obtain ⟨_, _⟩ := this
  exact fun _ hzero => ⟨Functor.rightDerivedSquareIsoOfExact _ _ _ _ hzero p⟩

section Unbounded

attribute [local instance] HasDerivedCategory.standard

/-- **Stacks 07AV, the flat-fppf case for abelian sheaves: `g⁻¹ ∘ Rf_* = Rf'_* ∘ (g')⁻¹`.** Let
`f : 𝒳 ⟶ 𝒴` be a flat 1-morphism of algebraic stacks, let `g⁻¹` and `(g')⁻¹` be restriction of
abelian sheaves to the flat-fppf sites of `𝒴` and of `𝒳`, and let `f_*` and `f'_*` be the direct
images along `f` and along its restriction `f'` to the flat-fppf sites. Suppose `(g')⁻¹` carries
K-injective cochain complexes to K-injective ones, and that the degree-zero identification
`f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ f'_*` of **Stacks 07AT** (2) holds. Then, on the unbounded derived
categories,

`Rf'_* ∘ (g')⁻¹ ≅ g⁻¹ ∘ Rf_*`.

Both restrictions are exact, so they act degreewise on derived categories, and the abelian sheaves
on the two sites of `𝒳` are Grothendieck abelian, so both sides are right derived functors of one
and the same functor out of the homotopy category; the isomorphism is the comparison that the
universal property produces. This is
`Stacks.Cohomology.UnboundedComplexes.derivedBaseChangeIso` at this square of sites. -/
@[stacks 07AV "the flat-fppf case for abelian sheaves, first identity: \
Rf'_* ∘ (g')⁻¹ ≅ g⁻¹ ∘ Rf_* on the *unbounded* derived categories. An isomorphism rather than an \
equality, a right derived functor being determined only up to a canonical isomorphism; the two \
total right derived direct images, their comparisons from the degreewise direct images and the two \
IsRightDerivedFunctor properties are carried as data, as in Stacks 0FN6 and 0FN7. Granted: that \
restriction to the flat-fppf site carries K-injective cochain complexes to K-injective ones, \
which is Stacks 08BJ from exactness of g_! = Stacks 07AS (3); and the degree-zero identification \
f_* ∘ g⁻¹ ≅ (g')⁻¹ ∘ f'_* of Stacks 07AT (2). The module case is not proved here."]
theorem derivedPushforwardRestrictionIso :
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (flatObject B S hS 𝒳.val)
        (flatObject_map B S hS f hf)).IsContinuous
          (inclusionTopology B S hS 𝒳) (inclusionTopology B S hS 𝒴) :=
      isContinuous_subsiteFunctor B S hS f hf
    letI : (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
        (flatObject B S hS 𝒳.val)
        (flatObject_map B S hS f hf)).IsCocontinuous
          (inclusionTopology B S hS 𝒳) (inclusionTopology B S hS 𝒴) :=
      isCocontinuous_subsiteFunctor B S hS f hf
    letI : f.hom.hom.toFunctor.IsContinuous
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology) :=
      (isContinuous_and_isCocontinuous_homFunctor B S hS f).1
    letI : f.hom.hom.toFunctor.IsCocontinuous
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology) :=
      (isContinuous_and_isCocontinuous_homFunctor B S hS f).2
    letI : (f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology)).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    letI : ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
          (flatObject B S hS 𝒳.val)
          (flatObject_map B S hS f hf)).sheafPushforwardCocontinuous
        AddCommGrpCat.{u + 1} (inclusionTopology B S hS 𝒳)
        (inclusionTopology B S hS 𝒴)).Additive :=
      Functor.sheafPushforwardCocontinuous_additive.{u + 1, u + 1, u, u, u + 1} _ _ _
    ∀ (_hKinj : ∀ I : CochainComplex (Sheaf
            (associatedTopology B S hS 𝒳.val.val.p B.topology)
            AddCommGrpCat.{u + 1}) ℤ, I.IsKInjective →
          CochainComplex.IsKInjective
            (((subsiteRestriction B S hS 𝒳.val.val.p B.topology
              (flatObject B S hS 𝒳.val)).mapHomologicalComplex
                (ComplexShape.up ℤ)).obj I))
      (_hzero : f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
              (associatedTopology B S hS 𝒳.val.val.p B.topology)
              (associatedTopology B S hS 𝒴.val.val.p B.topology) ⋙
            subsiteRestriction B S hS 𝒴.val.val.p B.topology
              (flatObject B S hS 𝒴.val) ≅
          subsiteRestriction B S hS 𝒳.val.val.p B.topology
              (flatObject B S hS 𝒳.val) ⋙
            (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
                (flatObject B S hS 𝒳.val)
                (flatObject_map B S hS f hf)).sheafPushforwardCocontinuous
              AddCommGrpCat.{u + 1} (inclusionTopology B S hS 𝒳)
              (inclusionTopology B S hS 𝒴))
      (Rf : DerivedCategory (Sheaf
            (associatedTopology B S hS 𝒳.val.val.p B.topology)
            AddCommGrpCat.{u + 1}) ⥤
          DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p B.topology)
            AddCommGrpCat.{u + 1}))
      (Rf' : DerivedCategory (Sheaf (inclusionTopology B S hS 𝒳)
            AddCommGrpCat.{u + 1}) ⥤
          DerivedCategory (Sheaf (inclusionTopology B S hS 𝒴) AddCommGrpCat.{u + 1}))
      (αf : (f.hom.hom.toFunctor.sheafPushforwardCocontinuous AddCommGrpCat.{u + 1}
              (associatedTopology B S hS 𝒳.val.val.p B.topology)
              (associatedTopology B S hS 𝒴.val.val.p B.topology)).mapHomotopyCategory
            (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh ⟶ DerivedCategory.Qh ⋙ Rf)
      (αf' : ((SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor
                (flatObject B S hS 𝒳.val)
                (flatObject_map B S hS f hf)).sheafPushforwardCocontinuous
              AddCommGrpCat.{u + 1} (inclusionTopology B S hS 𝒳)
              (inclusionTopology B S hS 𝒴)).mapHomotopyCategory (ComplexShape.up ℤ) ⋙
            DerivedCategory.Qh ⟶ DerivedCategory.Qh ⋙ Rf')
      (_hRf : Rf.IsRightDerivedFunctor αf (HomotopyCategory.quasiIso
          (Sheaf (associatedTopology B S hS 𝒳.val.val.p B.topology)
            AddCommGrpCat.{u + 1}) (ComplexShape.up ℤ)))
      (_hRf' : Rf'.IsRightDerivedFunctor αf' (HomotopyCategory.quasiIso
          (Sheaf (inclusionTopology B S hS 𝒳) AddCommGrpCat.{u + 1})
          (ComplexShape.up ℤ))),
      Nonempty ((subsiteRestriction B S hS 𝒳.val.val.p B.topology
            (flatObject B S hS 𝒳.val)).mapDerivedCategory ⋙ Rf' ≅
          Rf ⋙ (subsiteRestriction B S hS 𝒴.val.val.p B.topology
            (flatObject B S hS 𝒴.val)).mapDerivedCategory) := by
  have := isContinuous_subsiteFunctor B S hS f hf
  have := isCocontinuous_subsiteFunctor B S hS f hf
  have := isContinuous_and_isCocontinuous_homFunctor B S hS f
  obtain ⟨_, _⟩ := this
  exact fun hKinj hzero Rf Rf' αf αf' hRf hRf' =>
    haveI := hRf
    haveI := hRf'
    ⟨Stacks.Cohomology.UnboundedComplexes.derivedBaseChangeIso
      (subsiteRestriction B S hS 𝒳.val.val.p B.topology
        (flatObject B S hS 𝒳.val))
      (subsiteRestriction B S hS 𝒴.val.val.p B.topology
        (flatObject B S hS 𝒴.val)) _ _ Rf Rf' αf αf' hzero.symm hKinj⟩

/-- **Stacks 07AV, the flat-fppf case for abelian sheaves: `L(g')_! ∘ (f')⁻¹ = f⁻¹ ∘ Lg_!`.**
Let `Rf_*` and `Rf'_*` be the total right derived direct images along a flat 1-morphism
`f : 𝒳 ⟶ 𝒴` and along its restriction `f'` to the flat-fppf sites, let `Lg_!` and `L(g')_!` be the
derived lower shrieks of **Stacks 07AS** (3) over `𝒴` and over `𝒳`, left adjoint to the derived
restrictions `g⁻¹` and `(g')⁻¹`, and let `f⁻¹` and `(f')⁻¹` be the derived inverse images, left
adjoint to `Rf_*` and `Rf'_*`. Then the base change isomorphism
`σ : Rf'_* ∘ (g')⁻¹ ≅ g⁻¹ ∘ Rf_*` of
`AlgebraicGeometry.Stack.FlatFppf.derivedPushforwardRestrictionIso` gives

`f⁻¹ ∘ Lg_! ≅ L(g')_! ∘ (f')⁻¹`.

This is the source's "the rest of the proof is formal": the two sides are left adjoint to the two
sides of `σ`, by composing the adjunctions, and `σ` is the conjugate of the asserted isomorphism
under `CategoryTheory.conjugateIsoEquiv`. -/
@[stacks 07AV "the flat-fppf case for abelian sheaves, second identity: \
f⁻¹ ∘ Lg_! ≅ L(g')_! ∘ (f')⁻¹ on the unbounded derived categories, obtained formally from the \
first identity as its conjugate under the composed adjunctions. An isomorphism rather than an \
equality, the derived functors being determined only up to canonical isomorphism and carried as \
data. Granted: the first identity itself, and the four derived adjunctions Lg_! ⊣ g⁻¹ and \
L(g')_! ⊣ (g')⁻¹ — which are Stacks 07AS (3) — together with f⁻¹ ⊣ Rf_* and (f')⁻¹ ⊣ Rf'_*, which \
are standard. The module case is not proved here."]
def derivedShriekInverseImageIso
    (Rf : DerivedCategory (Sheaf (associatedTopology B S hS 𝒳.val.val.p B.topology)
        AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p B.topology)
        AddCommGrpCat.{u + 1}))
    (Rf' : DerivedCategory (Sheaf (inclusionTopology B S hS 𝒳) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (inclusionTopology B S hS 𝒴) AddCommGrpCat.{u + 1}))
    (Lg : DerivedCategory (Sheaf (inclusionTopology B S hS 𝒴) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p B.topology)
        AddCommGrpCat.{u + 1}))
    (Lg' : DerivedCategory (Sheaf (inclusionTopology B S hS 𝒳) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒳.val.val.p B.topology)
        AddCommGrpCat.{u + 1}))
    (finv : DerivedCategory (Sheaf (associatedTopology B S hS 𝒴.val.val.p B.topology)
        AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (associatedTopology B S hS 𝒳.val.val.p B.topology)
        AddCommGrpCat.{u + 1}))
    (f'inv : DerivedCategory (Sheaf (inclusionTopology B S hS 𝒴) AddCommGrpCat.{u + 1}) ⥤
      DerivedCategory (Sheaf (inclusionTopology B S hS 𝒳) AddCommGrpCat.{u + 1}))
    (adjg : Lg ⊣ (subsiteRestriction B S hS 𝒴.val.val.p B.topology
      (flatObject B S hS 𝒴.val)).mapDerivedCategory)
    (adjg' : Lg' ⊣ (subsiteRestriction B S hS 𝒳.val.val.p B.topology
      (flatObject B S hS 𝒳.val)).mapDerivedCategory)
    (adjf : finv ⊣ Rf) (adjf' : f'inv ⊣ Rf')
    (σ : (subsiteRestriction B S hS 𝒳.val.val.p B.topology
          (flatObject B S hS 𝒳.val)).mapDerivedCategory ⋙ Rf' ≅
        Rf ⋙ (subsiteRestriction B S hS 𝒴.val.val.p B.topology
          (flatObject B S hS 𝒴.val)).mapDerivedCategory) :
    Lg ⋙ finv ≅ f'inv ⋙ Lg' :=
  (conjugateIsoEquiv (adjf'.comp adjg') (adjg.comp adjf)).symm σ

end Unbounded

end FlatFppf

end AlgebraicGeometry.Stack

