/-!
# Descent of morphisms of smooth lifts (condition (2) of Stacks 02ZI for Stacks 0CJU)

Let `p : 𝒞 ⟶ W_{spaces, étale}` be the category of smooth lifts of étale opens of `W` of
**Stacks 0CJP**. This file proves that morphisms of `𝒞` glue along coverings: condition (2) of
**Stacks 02ZI** for `p`, the part of the proof of **Stacks 0CJU** that the source leaves to the
reader ("we leave it to the reader to check descent of morphisms").

## Main results

* `AlgebraicGeometry.Stack.EtaleSmoothLift.isPullback_ambient`: over a cartesian square of the
  base, the ambient components of a commutative square of smooth lifts form a cartesian square of
  algebraic spaces.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Bicategory

universe u w v

namespace AlgebraicGeometry.Space.SpacesEtale

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {X : AlgebraicSpaces B S hS}

/-- **A covering family of the spaces-étale site is jointly surjective on points.** The topology
is generated by the jointly point-surjective families, and it is stable under composition and
base change, so a covering sieve contains such a family. -/
theorem exists_point_of_ofArrows_mem_topology {U : SpacesEtale B S hS X} {I : Type*}
    {V : I → SpacesEtale B S hS X} {f : ∀ i, V i ⟶ U}
    (hf : Sieve.ofArrows V f ∈ topology B S hS X U)
    (p : points B S hS ((toSpaces B S hS X).obj U).1) :
    ∃ (i : I) (q : points B S hS ((toSpaces B S hS X).obj (V i)).1),
      pointsMap B S hS _ ((toSpaces B S hS X).map (f i)).hom q = p := by
  rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hf
  obtain ⟨R, hR, hle⟩ := hf
  obtain ⟨Z, g, hg, y, hy⟩ := (mem_precoverage_iff_forall_exists_point B S hS).1 hR p
  obtain ⟨Y, h, _, ⟨i⟩, rfl⟩ := hle _ _ hg
  refine ⟨i, pointsMap B S hS _ ((toSpaces B S hS X).map h).hom y, ?_⟩
  rw [← pointsMap_comp_apply, ← hy, Functor.map_comp]
  rfl

end AlgebraicGeometry.Space.SpacesEtale

namespace CategoryTheory.Bicategory

/-- **Compatibility of the gluing data of a comparison 2-morphism on an overlap.** In a strict
bicategory, let `αa : xO ⟶ a ≫ xA` and `αb : xO ⟶ b ≫ xB` be invertible, and let `μA, μB, νA, νB`
be 2-morphisms such that `a^*μA` and `b^*μB`, respectively `a^*νA` and `b^*νB`, agree after
`αa` and `αb`. Then `a^*(μA⁻¹ ≫ νA)` and `b^*(μB⁻¹ ≫ νB)` agree up to transports. -/
theorem whiskerLeft_gluing_compat {𝔅 : Type*} [Bicategory 𝔅] [Bicategory.Strict 𝔅]
    {O A B' X Y Z : 𝔅} {a : O ⟶ A} {b : O ⟶ B'} {mA : A ⟶ X} {mB : B' ⟶ X} {nA : A ⟶ Y}
    {nB : B' ⟶ Y} {g : X ⟶ Y} {xO : O ⟶ Z} {xA : A ⟶ Z} {xB : B' ⟶ Z} {xX : X ⟶ Z}
    {xY : Y ⟶ Z} (αa : xO ⟶ a ≫ xA) (αb : xO ⟶ b ≫ xB) (μA : xA ⟶ mA ≫ xX)
    (μB : xB ⟶ mB ≫ xX) (νA : xA ⟶ nA ≫ xY) (νB : xB ⟶ nB ≫ xY) [IsIso αa] [IsIso αb]
    [IsIso μA] [IsIso μB] (hA : nA ≫ xY = mA ≫ (g ≫ xY)) (hB : nB ≫ xY = mB ≫ (g ≫ xY))
    (h₁ : a ≫ (mA ≫ xX) = b ≫ (mB ≫ xX)) (h₂ : a ≫ (nA ≫ xY) = b ≫ (nB ≫ xY))
    (h₃ : b ≫ (mB ≫ (g ≫ xY)) = a ≫ (mA ≫ (g ≫ xY)))
    (E₁ : (αa ≫ (a ◁ μA)) ≫ eqToHom h₁ = αb ≫ (b ◁ μB))
    (E₂ : (αa ≫ (a ◁ νA)) ≫ eqToHom h₂ = αb ≫ (b ◁ νB)) :
    a ◁ (inv μA ≫ νA ≫ eqToHom hA) =
      eqToHom h₁ ≫ (b ◁ (inv μB ≫ νB ≫ eqToHom hB)) ≫ eqToHom h₃ := by
  have e₁ : a ◁ μA = inv αa ≫ αb ≫ (b ◁ μB) ≫ eqToHom h₁.symm := by
    rw [IsIso.eq_inv_comp, ← reassoc_of% E₁]
    simp
  have e₂ : a ◁ νA = inv αa ≫ αb ≫ (b ◁ νB) ≫ eqToHom h₂.symm := by
    rw [IsIso.eq_inv_comp, ← reassoc_of% E₂]
    simp
  rw [whiskerLeft_comp, whiskerLeft_comp, ← inv_whiskerLeft, IsIso.inv_comp_eq, e₁, e₂]
  simp [whiskerLeft_comp]

/-- **The coherence of a glued comparison 2-morphism, restricted to a member of the covering.**
In a strict bicategory, let `(u, m', μ)` and `(v, n', ν)` be coherent morphisms out of the
triangle `αk` to the triangles `αU` and `αV`, with `v = u ≫ hh`, and let `γ` be a 2-morphism
with `m'^*γ = μ⁻¹ ≫ ν` up to transport. Then the coherence of `(hh, g', γ)` holds after
whiskering by `u`. -/
theorem coherence_glue {𝔅 : Type*} [Bicategory 𝔅] [Bicategory.Strict 𝔅]
    {Uk U V Uk' U' V' Z : 𝔅}
    {u : Uk ⟶ U} {hh : U ⟶ V} {v : Uk ⟶ V} {iU : U ⟶ U'} {iV : V ⟶ V'} {ik : Uk ⟶ Uk'}
    {m' : Uk' ⟶ U'} {g' : U' ⟶ V'} {n' : Uk' ⟶ V'}
    {LUk : Uk ⟶ Z} {LU : U ⟶ Z} {LV : V ⟶ Z} {xU : U' ⟶ Z} {xV : V' ⟶ Z} {xk : Uk' ⟶ Z}
    (αU : LU ⟶ iU ≫ xU) (αV : LV ⟶ iV ≫ xV) (αk : LUk ⟶ ik ≫ xk)
    (μ : xk ⟶ m' ≫ xU) [IsIso μ] (ν : xk ⟶ n' ≫ xV) (γ : xU ⟶ g' ≫ xV)
    (hv : v = u ≫ hh) (hsq : u ≫ iU = ik ≫ m')
    (hLU : LU = hh ≫ LV)
    (hm₁ : LUk = u ≫ LU) (hm₂ : u ≫ (iU ≫ xU) = ik ≫ (m' ≫ xU))
    (hn₁ : LUk = v ≫ LV) (hn₂ : v ≫ (iV ≫ xV) = ik ≫ (n' ≫ xV))
    (hr : hh ≫ (iV ≫ xV) = iU ≫ (g' ≫ xV))
    (hγe : n' ≫ xV = m' ≫ (g' ≫ xV))
    (Cm : αk ≫ ik ◁ μ = eqToHom hm₁ ≫ u ◁ αU ≫ eqToHom hm₂)
    (Cn : αk ≫ ik ◁ ν = eqToHom hn₁ ≫ v ◁ αV ≫ eqToHom hn₂)
    (Hγ : m' ◁ γ = inv μ ≫ ν ≫ eqToHom hγe) :
    u ◁ (αU ≫ iU ◁ γ) = u ◁ (eqToHom hLU ≫ hh ◁ αV ≫ eqToHom hr) := by
  subst hv
  have e₁ : u ◁ αU = eqToHom hm₁.symm ≫ αk ≫ ik ◁ μ ≫ eqToHom hm₂.symm := by
    rw [reassoc_of% Cm]
    simp
  have h₂ : u ≫ (iU ≫ (g' ≫ xV)) = ik ≫ (m' ≫ (g' ≫ xV)) := by
    rw [← Strict.assoc, hsq, Strict.assoc]
  have e₄ : u ◁ iU ◁ γ = eqToHom hm₂ ≫ ik ◁ m' ◁ γ ≫ eqToHom h₂.symm := by
    rw [← whiskerLeft_whiskerLeft_eqToHom hsq γ hm₂.symm h₂.symm]
    simp
  have hc : ik ◁ μ ≫ ik ◁ inv μ = 𝟙 _ := by
    rw [← whiskerLeft_comp, IsIso.hom_inv_id, whiskerLeft_id]
  rw [whiskerLeft_comp, e₁, e₄, Hγ]
  simp only [whiskerLeft_comp, Category.assoc, eqToHom_trans_assoc,
    whiskerLeft_eqToHom, eqToHom_refl, Category.id_comp, reassoc_of% hc]
  rw [reassoc_of% Cn]
  simp [comp_whiskerLeft, Strict.associator_eqToIso]

end CategoryTheory.Bicategory

namespace CategoryTheory

/-- Cancelling an inverse followed by a transport, in a plain category. -/
theorem comp_inv_comp_eqToHom_cancel {C : Type*} [Category C] {X Y Z Z' : C} (μ : X ⟶ Y)
    [IsIso μ] (ν : X ⟶ Z) (h₁ : Z = Z') (h₂ : Z' = Z) (θ : Y ⟶ Z')
    (hθ : θ = inv μ ≫ ν ≫ eqToHom h₁) : (μ ≫ θ) ≫ eqToHom h₂ = ν := by
  subst hθ
  simp

/-- Solving `(μ ≫ θ) ≫ eqToHom h = ν` for `θ`, in a plain category. -/
theorem eq_inv_comp_of_comp_eqToHom {C : Type*} [Category C] {X Y Z Z' : C} (μ : X ⟶ Y)
    [IsIso μ] (ν : X ⟶ Z) (h₂ : Z' = Z) (θ : Y ⟶ Z') (e : (μ ≫ θ) ≫ eqToHom h₂ = ν) :
    θ = inv μ ≫ ν ≫ eqToHom h₂.symm := by
  rw [← e]
  simp

end CategoryTheory

namespace AlgebraicGeometry.Stack

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {𝒳 𝒳' : AlgebraicStacks.{u, w} B S hS} {ι : 𝒳 ⟶ 𝒳'} {hι : IsThickening ι}
  {W : AlgebraicSpaces B S hS}
  {x : (algebraicSpaceStackFunctor B S hS).obj W ⟶ 𝒳}
  {hx : AlgebraicStacks.IsSmooth B S hS x}

namespace EtaleSmoothLift

/-- **The ambient spaces of an overlap form a fibre product.** Let `m₁ : ζ₁ ⟶ ξ` and
`m₂ : ζ₂ ⟶ ξ` be morphisms of smooth lifts and let `a : ω ⟶ ζ₁`, `b : ω ⟶ ζ₂` be morphisms with
`a ≫ m₁ = b ≫ m₂` whose base components form a cartesian square of the spaces-étale site of `W`.
Then the ambient components form a cartesian square: `ω' = ζ₁' ×_{ξ'} ζ₂'`.

The canonical comparison `c : ω' ⟶ ζ₁' ×_{ξ'} ζ₂'` is inverted by the topological invariance of
the étale site along the thickening `ξ ⊂ ξ'` (**Stacks 05ZH**, the source's **Stacks 07VW**): both
sides are étale over `ξ'` (**Stacks 0CJS**) and restrict over `ξ` to the fibre product of the
bases, so a morphism back exists by fullness, and the two composites are identities by
faithfulness. -/
theorem isPullback_ambient {ξ ζ₁ ζ₂ ω : EtaleSmoothLift B S hS ι hι W x hx} (m₁ : ζ₁ ⟶ ξ)
    (m₂ : ζ₂ ⟶ ξ) (a : ω ⟶ ζ₁) (b : ω ⟶ ζ₂) (hab : a ≫ m₁ = b ≫ m₂)
    (hbase : IsPullback (Hom.base a) (Hom.base b) (Hom.base m₁) (Hom.base m₂)) :
    IsPullback (Hom.ambient a) (Hom.ambient b) (Hom.ambient m₁) (Hom.ambient m₂) := by
  have hw : Hom.ambient a ≫ Hom.ambient m₁ = Hom.ambient b ≫ Hom.ambient m₂ :=
    congrArg Hom.ambient hab
  let P := AlgebraicSpaces.fiberProduct B S hS (Hom.ambient m₁) (Hom.ambient m₂)
  have hP := AlgebraicSpaces.isPullback_fiberProduct B S hS (Hom.ambient m₁) (Hom.ambient m₂)
  set fst : P ⟶ ζ₁.ambient := ObjectProperty.homMk (pullback.fst _ _)
  set snd : P ⟶ ζ₂.ambient := ObjectProperty.homMk (pullback.snd _ _)
  let c : ω.ambient ⟶ P := hP.lift (Hom.ambient a) (Hom.ambient b) hw
  have hc₁ : c ≫ fst = Hom.ambient a := hP.lift_fst _ _ hw
  have hc₂ : c ≫ snd = Hom.ambient b := hP.lift_snd _ _ hw
  have hbase' := hbase.map (Space.SpacesEtale.toSpaces B S hS W)
  have q₁ := isPullback_of_hom m₁
  have q₂ := isPullback_of_hom m₂
  have hetP : Space.IsEtale B S hS (fst ≫ Hom.ambient m₁).hom :=
    Space.isEtale_comp B S hS
      (Space.isEtale_of_isPullback_of_isAlgebraicSpace B S hS
        (AlgebraicSpaces.isPullback_hom B S hS hP) P.property ζ₁.ambient.property
        ζ₂.ambient.property ξ.ambient.property (Hom.isEtale_ambient _ _ m₂))
      (Hom.isEtale_ambient _ _ m₁)
  have haω : Space.IsEtale B S hS (Hom.ambient a ≫ Hom.ambient m₁).hom :=
    Hom.isEtale_ambient _ _ (a ≫ m₁)
  let Y₀ := AlgebraicSpaces.fiberProduct B S hS (fst ≫ Hom.ambient m₁) ξ.inclusion
  have hY := AlgebraicSpaces.isPullback_fiberProduct B S hS (fst ≫ Hom.ambient m₁) ξ.inclusion
  set k : Y₀ ⟶ P := ObjectProperty.homMk (pullback.fst _ _)
  set g : Y₀ ⟶ ξ.base.obj.left := ObjectProperty.homMk (pullback.snd _ _)
  have hk : Space.IsSurjective B S hS k.hom :=
    Space.isSurjective_of_isPullback B S hS hY.flip
      ξ.isThickeningHom_inclusion.surjective_pointsMap
  let l₁ : Y₀ ⟶ ζ₁.base.obj.left := q₁.lift (k ≫ fst) g ((Category.assoc _ _ _).trans hY.w)
  let l₂ : Y₀ ⟶ ζ₂.base.obj.left := q₂.lift (k ≫ snd) g
    ((Category.assoc _ _ _).trans ((congrArg (k ≫ ·) hP.w.symm).trans hY.w))
  have hl₁ : l₁ ≫ (Hom.base m₁).hom.left = g := q₁.lift_snd _ _ _
  have hl₂ : l₂ ≫ (Hom.base m₂).hom.left = g := q₂.lift_snd _ _ _
  let t : Y₀ ⟶ ω.base.obj.left := hbase'.lift l₁ l₂ (hl₁.trans hl₂.symm)
  have ht₁ : t ≫ (Hom.base a).hom.left = l₁ := hbase'.lift_fst _ _ _
  have ht₂ : t ≫ (Hom.base b).hom.left = l₂ := hbase'.lift_snd _ _ _
  have hh : t ≫ (Hom.base (a ≫ m₁)).hom.left = g :=
    (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (Hom.base m₁).hom.left) ht₁).trans hl₁)
  obtain ⟨d, hd₁, hd₂⟩ := Space.IsThickeningHom.exists_lift_of_isPullback
    ξ.isThickeningHom_inclusion hY hetP (isPullback_of_hom (a ≫ m₁)) haω t hh
  have hωc : (ω.inclusion ≫ c) ≫ (fst ≫ Hom.ambient m₁) =
      (Hom.base (a ≫ m₁)).hom.left ≫ ξ.inclusion := by
    rw [Category.assoc, ← Category.assoc c, hc₁]
    exact Hom.inclusion_comp (a ≫ m₁)
  let s : ω.base.obj.left ⟶ Y₀ := hY.lift (ω.inclusion ≫ c) (Hom.base (a ≫ m₁)).hom.left hωc
  have hs₁ : s ≫ k = ω.inclusion ≫ c := hY.lift_fst _ _ _
  have hs₂ : s ≫ g = (Hom.base (a ≫ m₁)).hom.left := hY.lift_snd _ _ _
  have hsl₁ : s ≫ l₁ = (Hom.base a).hom.left := by
    refine q₁.hom_ext ?_ ?_
    · rw [Category.assoc, q₁.lift_fst, ← Category.assoc, hs₁, Category.assoc, hc₁]
      exact Hom.inclusion_comp a
    · rw [Category.assoc, hl₁, hs₂]
      rfl
  have hsl₂ : s ≫ l₂ = (Hom.base b).hom.left := by
    refine q₂.hom_ext ?_ ?_
    · rw [Category.assoc, q₂.lift_fst, ← Category.assoc, hs₁, Category.assoc, hc₂]
      exact Hom.inclusion_comp b
    · rw [Category.assoc, hl₂, hs₂]
      exact congrArg (fun t => t.hom.left) (congrArg Hom.base hab)
  have hst : s ≫ t = 𝟙 _ :=
    hbase'.hom_ext ((Category.assoc _ _ _).trans ((congrArg (s ≫ ·) ht₁).trans
        (hsl₁.trans (Category.id_comp _).symm)))
      ((Category.assoc _ _ _).trans ((congrArg (s ≫ ·) ht₂).trans
        (hsl₂.trans (Category.id_comp _).symm)))
  have hd₁' : d ≫ Hom.ambient a ≫ Hom.ambient m₁ = fst ≫ Hom.ambient m₁ := hd₁
  have hcd : c ≫ d = 𝟙 _ := by
    refine Space.hom_ext_of_isEtale_of_isSurjective haω
      ω.isThickeningHom_inclusion.surjective_pointsMap ?_ ?_
    · rw [Category.assoc, hd₁', ← Category.assoc, hc₁, Category.id_comp]
    · rw [← Category.assoc, ← hs₁, Category.assoc, hd₂, ← Category.assoc, hst, Category.id_comp,
        Category.comp_id]
  have hdc : d ≫ c = 𝟙 _ := by
    refine Space.hom_ext_of_isEtale_of_isSurjective hetP hk ?_ ?_
    · rw [Category.assoc, ← Category.assoc c, hc₁, Category.id_comp]
      exact hd₁'
    · rw [← Category.assoc, hd₂, Category.comp_id]
      refine hP.hom_ext ?_ ?_
      · rw [Category.assoc, Category.assoc, hc₁, Hom.inclusion_comp a, ← Category.assoc, ht₁]
        exact q₁.lift_fst _ _ _
      · rw [Category.assoc, Category.assoc, hc₂, Hom.inclusion_comp b, ← Category.assoc, ht₂]
        exact q₂.lift_fst _ _ _
  refine IsPullback.of_iso hP ⟨d, c, hdc, hcd⟩ (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_
    (by simp) (by simp)
  · show fst ≫ 𝟙 _ = d ≫ Hom.ambient a
    rw [Category.comp_id, ← hc₁, ← Category.assoc, hdc, Category.id_comp]
  · show snd ≫ 𝟙 _ = d ≫ Hom.ambient b
    rw [Category.comp_id, ← hc₂, ← Category.assoc, hdc, Category.id_comp]

/-- **The ambient components of a covering family form an étale covering.** If the base
components of morphisms `m k : ζ k ⟶ ξ` of smooth lifts are jointly surjective on points, their
ambient components are an étale covering of the ambient space of `ξ`: they are étale by
**Stacks 0CJS**, and a point of the ambient space comes from a point of the thickening `ξ`, which
comes from some `ζ k`. -/
theorem isEtaleCovering_ambient {ξ : EtaleSmoothLift B S hS ι hι W x hx} {K : Type v}
    {ζ : K → EtaleSmoothLift B S hS ι hι W x hx} (m : ∀ k, ζ k ⟶ ξ)
    (hm : ∀ p : Space.points B S hS ξ.base.obj.left.obj, ∃ (k : K)
      (q : Space.points B S hS (ζ k).base.obj.left.obj),
      Space.pointsMap B S hS _ (Hom.base (m k)).hom.left.hom q = p) :
    Space.IsEtaleCovering B S hS (fun k => (ζ k).ambient.obj)
      (fun k => (Hom.ambient (m k)).hom) where
  target_isAlgebraicSpace := ξ.ambient.property
  source_isAlgebraicSpace k := (ζ k).ambient.property
  etale k := Hom.isEtale_ambient _ _ (m k)
  jointly_surjective := by
    refine Set.eq_univ_of_forall fun p' => ?_
    obtain ⟨p, rfl⟩ := ξ.isThickeningHom_inclusion.surjective_pointsMap p'
    obtain ⟨k, q, rfl⟩ := hm p
    refine Set.mem_iUnion.2 ⟨k, Space.pointsMap B S hS _ (ζ k).inclusion.hom q, ?_⟩
    rw [← Space.pointsMap_comp_apply, ← Space.pointsMap_comp_apply]
    exact congrArg (fun t => Space.pointsMap B S hS _ t.hom q) (Hom.inclusion_comp (m k))

/-- **The comparison 2-morphisms of two equal morphisms of smooth lifts** agree up to the
transport along the induced equality of 1-morphisms. -/
theorem Hom.comm_eq_of_eq {ζ ξ : EtaleSmoothLift B S hS ι hι W x hx} {f₁ f₂ : ζ ⟶ ξ}
    (h : f₁ = f₂) :
    Hom.comm f₁ ≫ eqToHom (congrArg (fun f : ζ ⟶ ξ =>
      (algebraicSpaceStackFunctor.{u, w} B S hS).map (Hom.ambient f) ≫ ξ.ambientMap) h) =
        Hom.comm f₂ := by
  subst h
  simp

/-- **The candidate gluing data for the comparison 2-morphism of a glued morphism.** For
morphisms `m : ζ ⟶ ξ`, `n : ζ ⟶ η` of smooth lifts and `g' : ξ' ⟶ η'` with
`m' ≫ g' = n'` on the ambient spaces, the 2-morphism `m'^* x'_ξ ⟶ m'^* (g'^* x'_η)` obtained by
inverting the comparison 2-morphism of `m` and following it by that of `n`. -/
def gluingComm {ζ ξ η : EtaleSmoothLift B S hS ι hι W x hx} (m : ζ ⟶ ξ) (n : ζ ⟶ η)
    (g' : ξ.ambient ⟶ η.ambient) (hg : Hom.ambient m ≫ g' = Hom.ambient n) :
    (algebraicSpaceStackFunctor.{u, w} B S hS).map (Hom.ambient m) ≫ ξ.ambientMap ⟶
      (algebraicSpaceStackFunctor.{u, w} B S hS).map (Hom.ambient m) ≫
        ((algebraicSpaceStackFunctor.{u, w} B S hS).map g' ≫ η.ambientMap) :=
  inv (Hom.comm m) ≫ Hom.comm n ≫ eqToHom
    ((congrArg (fun t => (algebraicSpaceStackFunctor.{u, w} B S hS).map t ≫ η.ambientMap)
      hg.symm).trans ((congrArg (· ≫ η.ambientMap)
        ((algebraicSpaceStackFunctor.{u, w} B S hS).map_comp _ _)).trans
          (Bicategory.Strict.assoc _ _ _)))

/-- **The base components of a covering family form an étale covering.** -/
theorem isEtaleCovering_base {ξ : EtaleSmoothLift B S hS ι hι W x hx} {K : Type v}
    {ζ : K → EtaleSmoothLift B S hS ι hι W x hx} (m : ∀ k, ζ k ⟶ ξ)
    (hm : ∀ p : Space.points B S hS ξ.base.obj.left.obj, ∃ (k : K)
      (q : Space.points B S hS (ζ k).base.obj.left.obj),
      Space.pointsMap B S hS _ (Hom.base (m k)).hom.left.hom q = p) :
    Space.IsEtaleCovering B S hS (fun k => (ζ k).base.obj.left.obj)
      (fun k => (Hom.base (m k)).hom.left.hom) where
  target_isAlgebraicSpace := ξ.base.obj.left.property
  source_isAlgebraicSpace k := (ζ k).base.obj.left.property
  etale k := Space.SpacesEtale.isEtale_toSpaces_map B S hS W (Hom.base (m k))
  jointly_surjective := Set.eq_univ_of_forall fun p => by
    obtain ⟨k, q, hq⟩ := hm p
    exact Set.mem_iUnion.2 ⟨k, q, hq⟩

/-- **An overlap of two morphisms of smooth lifts.** For `m₁ : ζ₁ ⟶ ξ` and `m₂ : ζ₂ ⟶ ξ` there is
a smooth lift `ω` with morphisms to `ζ₁` and `ζ₂` agreeing in `ξ`, whose base components form a
cartesian square: the pullback of `ζ₁` along the first projection of `U₁ ×_U U₂`
(**Stacks 0CJT**), with the second morphism its fill-in through `m₂`. -/
theorem exists_overlap {ξ ζ₁ ζ₂ : EtaleSmoothLift B S hS ι hι W x hx} (m₁ : ζ₁ ⟶ ξ)
    (m₂ : ζ₂ ⟶ ξ) :
    ∃ (ω : EtaleSmoothLift B S hS ι hι W x hx) (a : ω ⟶ ζ₁) (b : ω ⟶ ζ₂),
      IsPullback (Hom.base a) (Hom.base b) (Hom.base m₁) (Hom.base m₂) ∧ a ≫ m₁ = b ≫ m₂ := by
  obtain ⟨ω, a, ha⟩ := exists_hom_isHomLift ζ₁ (pullback.fst (Hom.base m₁) (Hom.base m₂))
  have hdom : ω.base = pullback (Hom.base m₁) (Hom.base m₂) :=
    IsHomLift.domain_eq (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _)
      (pullback.fst (Hom.base m₁) (Hom.base m₂)) a
  have hfac : Hom.base a = eqToHom hdom ≫ pullback.fst _ _ :=
    (IsHomLift.fac' (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _)
      (pullback.fst (Hom.base m₁) (Hom.base m₂)) a).trans
      (congrArg (eqToHom _ ≫ ·) (Category.comp_id _))
  let hb : ω.base ⟶ ζ₂.base := eqToHom hdom ≫ pullback.snd (Hom.base m₁) (Hom.base m₂)
  have hhb : hb ≫ Hom.base m₂ = Hom.base (a ≫ m₁) := by
    show _ = Hom.base a ≫ Hom.base m₁
    rw [hfac, Category.assoc, Category.assoc, pullback.condition]
  refine ⟨ω, a, fillIn m₂ (a ≫ m₁) hb hhb, ?_, (fillIn_comp _ _ _ _).symm⟩
  show IsPullback (Hom.base a) hb _ _
  rw [hfac]
  exact IsPullback.of_iso (IsPullback.of_hasPullback _ _) (eqToIso hdom).symm (Iso.refl _)
    (Iso.refl _) (Iso.refl _) (by simp) (by simp [hb]) (by simp) (by simp)

/-- **Morphisms of smooth lifts glue along a covering.** Let `m k : ζ k ⟶ ξ` be morphisms of
smooth lifts whose base components are jointly surjective on points, and let `n k : ζ k ⟶ η` be
morphisms lying over `m k` followed by `h : U ⟶ V`, which agree on every overlap. Then there is
exactly one morphism `g : ξ ⟶ η` over `h` with `m k ≫ g = n k` for every `k`. -/
theorem existsUnique_hom_of_jointlySurjective {ξ η : EtaleSmoothLift B S hS ι hι W x hx}
    {K : Type v} {ζ : K → EtaleSmoothLift B S hS ι hι W x hx} (m : ∀ k, ζ k ⟶ ξ)
    (hm : ∀ p : Space.points B S hS ξ.base.obj.left.obj, ∃ (k : K)
      (q : Space.points B S hS (ζ k).base.obj.left.obj),
      Space.pointsMap B S hS _ (Hom.base (m k)).hom.left.hom q = p)
    (n : ∀ k, ζ k ⟶ η) (h : ξ.base ⟶ η.base) (hn : ∀ k, Hom.base (m k) ≫ h = Hom.base (n k))
    (hcompat : ∀ k l (ω : EtaleSmoothLift B S hS ι hι W x hx) (a : ω ⟶ ζ k) (b : ω ⟶ ζ l),
      IsPullback (Hom.base a) (Hom.base b) (Hom.base (m k)) (Hom.base (m l)) →
      a ≫ m k = b ≫ m l → a ≫ n k = b ≫ n l) :
    ∃! g : ξ ⟶ η, Hom.base g = h ∧ ∀ k, m k ≫ g = n k := by
  classical
  have he := isEtaleCovering_ambient m hm
  have heb := isEtaleCovering_base m hm
  choose ω a b hωpb hωab using fun k l => exists_overlap (m k) (m l)
  have hamb : ∀ k l, IsPullback (Hom.ambient (a k l)) (Hom.ambient (b k l))
      (Hom.ambient (m k)) (Hom.ambient (m l)) := fun k l =>
    isPullback_ambient (m k) (m l) (a k l) (b k l) (hωab k l) (hωpb k l)
  have hnab := fun k l => hcompat k l (ω k l) (a k l) (b k l) (hωpb k l) (hωab k l)
  have h04 : ∀ k l,
      (ObjectProperty.homMk (pullback.fst (Hom.ambient (m k)).hom (Hom.ambient (m l)).hom) :
        AlgebraicSpaces.fiberProduct B S hS (Hom.ambient (m k)) (Hom.ambient (m l)) ⟶ _) ≫
          Hom.ambient (n k) =
      (ObjectProperty.homMk (pullback.snd (Hom.ambient (m k)).hom (Hom.ambient (m l)).hom) :
        AlgebraicSpaces.fiberProduct B S hS (Hom.ambient (m k)) (Hom.ambient (m l)) ⟶ _) ≫
          Hom.ambient (n l) := by
    intro k l
    let e := (hamb k l).isoIsPullback _ _
      (AlgebraicSpaces.isPullback_fiberProduct B S hS (Hom.ambient (m k)) (Hom.ambient (m l)))
    rw [← cancel_epi e.hom, ← Category.assoc, IsPullback.isoIsPullback_hom_fst, ← Category.assoc,
      IsPullback.isoIsPullback_hom_snd]
    exact congrArg Hom.ambient (hnab k l)
  obtain ⟨g', hg', hg'u⟩ := Space.existsUnique_desc_of_fpqcCovering B S hS
    (fun k => Hom.ambient (m k)) (Space.isFpqcCovering_of_isEtaleCovering B S hS _ _ he)
    η.ambient (fun k => Hom.ambient (n k)) h04
  have hnk : ∀ k, (Hom.base (n k)).hom.left = (Hom.base (m k)).hom.left ≫ h.hom.left :=
    fun k => (congrArg (fun t => t.hom.left) (hn k)).symm
  obtain ⟨_, -, hbu⟩ := Space.existsUnique_desc_of_fpqcCovering B S hS
    (fun k => (Hom.base (m k)).hom.left)
    (Space.isFpqcCovering_of_isEtaleCovering B S hS _ _ heb) η.ambient
    (fun k => (Hom.base (n k)).hom.left ≫ η.inclusion) (by
      intro k l
      rw [hnk, hnk, ← Category.assoc, ← Category.assoc, ← Category.assoc, ← Category.assoc,
        (AlgebraicSpaces.isPullback_fiberProduct B S hS _ _).w])
  have hincl : ξ.inclusion ≫ g' = h.hom.left ≫ η.inclusion := by
    refine (hbu _ fun k => ?_).trans (hbu _ fun k => ?_).symm
    · rw [← Category.assoc, ← Hom.inclusion_comp (m k), Category.assoc, hg' k]
      exact Hom.inclusion_comp (n k)
    · rw [← Category.assoc, ← hnk]
  obtain ⟨γ, hγ⟩ := exists_hom₂_of_isEtaleCovering_of_isPullback (fun k => Hom.ambient (m k)) he
    (F := ξ.ambientMap) (G := (algebraicSpaceStackFunctor.{u, w} B S hS).map g' ≫ η.ambientMap)
    (fun k => gluingComm (m k) (n k) g' (hg' k)) (fun k l => (ω k l).ambient)
    (fun k l => Hom.ambient (a k l)) (fun k l => Hom.ambient (b k l)) hamb
    (fun k l => Bicategory.whiskerLeft_gluing_compat (Hom.comm (a k l)) (Hom.comm (b k l))
      (Hom.comm (m k)) (Hom.comm (m l)) (Hom.comm (n k)) (Hom.comm (n l)) _ _ _ _ _
      (Hom.comm_eq_of_eq (hωab k l)) (Hom.comm_eq_of_eq (hnab k l)))
  have hcoh : ξ.comm.hom ≫ ((algebraicSpaceStackFunctor.{u, w} B S hS).map ξ.inclusion ◁ γ) =
      eqToHom (left_leg ξ η h) ≫
        ((algebraicSpaceStackFunctor.{u, w} B S hS).map h.hom.left ◁ η.comm.hom) ≫
          eqToHom (right_leg ξ η h g' hincl) := by
    refine hom₂_ext_of_isEtaleCovering (fun k => (Hom.base (m k)).hom.left) heb fun k => ?_
    exact Bicategory.coherence_glue ξ.comm.hom η.comm.hom (ζ k).comm.hom (Hom.comm (m k))
      (Hom.comm (n k)) γ
      ((congrArg (algebraicSpaceStackFunctor.{u, w} B S hS).map (hnk k)).trans
        ((algebraicSpaceStackFunctor.{u, w} B S hS).map_comp _ _))
      (lift_leg (ζ k) ξ (Hom.base (m k)) (Hom.ambient (m k)) (Hom.inclusion_comp (m k)))
      (left_leg ξ η h) (left_leg (ζ k) ξ (Hom.base (m k)))
      (right_leg (ζ k) ξ (Hom.base (m k)) (Hom.ambient (m k)) (Hom.inclusion_comp (m k)))
      (left_leg (ζ k) η (Hom.base (n k)))
      (right_leg (ζ k) η (Hom.base (n k)) (Hom.ambient (n k)) (Hom.inclusion_comp (n k)))
      (right_leg ξ η h g' hincl) _ (Hom.coherence (m k)) (Hom.coherence (n k)) (hγ k)
  let g : ξ ⟶ η :=
    { base := h
      ambient := g'
      inclusion_comp := hincl
      comm := γ
      coherence := hcoh }
  refine ⟨g, ⟨rfl, fun k => ?_⟩, ?_⟩
  · refine hom_congr _ _ (hn k) (hg' k) (heq_of_comp_eqToHom
      (congrArg (fun t => (algebraicSpaceStackFunctor.{u, w} B S hS).map t ≫ η.ambientMap)
        (hg' k)) _ _ ?_)
    exact comp_inv_comp_eqToHom_cancel (Hom.comm (m k)) (Hom.comm (n k)) _ _ _ (hγ k)
  · rintro ⟨b₂, a₂, r₂, c₂, k₂⟩ ⟨hb₂, hg₂⟩
    have ha₂ : a₂ = g' := hg'u _ fun k => congrArg Hom.ambient (hg₂ k)
    dsimp only at hb₂
    subst hb₂ ha₂
    refine hom_congr _ _ rfl rfl (heq_of_eq ?_)
    refine hom₂_ext_of_isEtaleCovering (fun k => Hom.ambient (m k)) he fun k => ?_
    exact (eq_inv_comp_of_comp_eqToHom (Hom.comm (m k)) (Hom.comm (n k)) _ _
      (Hom.comm_eq_of_eq (hg₂ k))).trans (hγ k).symm

/-- Points lift along a transport followed by a morphism of the spaces-étale site as soon as
they lift along the morphism. -/
theorem exists_pointsMap_eqToHom_comp {A A' C : Space.SpacesEtale B S hS W} (e : A = A')
    (g : A' ⟶ C) {p : Space.points B S hS C.obj.left.obj}
    (hp : ∃ q : Space.points B S hS A'.obj.left.obj,
      Space.pointsMap B S hS _ (g.hom.left).hom q = p) :
    ∃ q : Space.points B S hS A.obj.left.obj,
      Space.pointsMap B S hS _ ((eqToHom e ≫ g).hom.left).hom q = p := by
  subst e
  simpa using hp

/-- **Stacks 0CJU, condition (2) of Stacks 02ZI, read on covering families.** For two smooth
lifts `ξ, η` over `U`, a covering family `{f i : V i ⟶ U}` and fibre isomorphisms between the
restrictions of `ξ` and `η` to the `V i` which agree on the overlaps, there is exactly one fibre
isomorphism `ξ ⟶ η` restricting to them: descent of morphisms, which the source leaves to the
reader. It is `AlgebraicGeometry.Stack.EtaleSmoothLift.existsUnique_hom_of_jointlySurjective`
for the restriction morphisms of `ξ`. -/
theorem isomIsSheafFor_proj {U : Space.SpacesEtale B S hS W}
    (ξ η : EtaleSmoothLift B S hS ι hι W x hx)
    (hξ : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).obj ξ = U)
    (hη : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).obj η = U)
    {I : Type v} (V : I → Space.SpacesEtale B S hS W) (f : ∀ i, V i ⟶ U)
    (hf : Sieve.ofArrows V f ∈ Space.SpacesEtale.topology B S hS W U)
    (Vij : I → I → Space.SpacesEtale B S hS W)
    (pr₁ : ∀ i j, Vij i j ⟶ V i) (pr₂ : ∀ i j, Vij i j ⟶ V j)
    (hVij : ∀ i j, IsPullback (pr₁ i j) (pr₂ i j) (f i) (f j))
    (ξr : ∀ i, Functor.Restriction proj (f i) ξ hξ)
    (ηr : ∀ i, Functor.Restriction proj (f i) η hη)
    (ξrij : ∀ i j, Functor.Restriction proj (pr₁ i j ≫ f i) ξ hξ)
    (ηrij : ∀ i j, Functor.Restriction proj (pr₁ i j ≫ f i) η hη) :
    Functor.IsomIsSheafFor proj ξ η hξ hη V f Vij pr₁ pr₂ hVij ξr ηr ξrij ηrij := by
  classical
  intro φ hφ _ hc
  subst hξ
  have hg := isFiberedInGroupoids_proj (B := B) (S := S) (hS := hS) (ι := ι) (hι := hι) (W := W)
    (x := x) (hx := hx)
  -- the base components of the restrictions
  have hbr : ∀ {V' : Space.SpacesEtale B S hS W} {g : V' ⟶ proj.obj ξ}
      {ζ : EtaleSmoothLift B S hS ι hι W x hx} {hζ : proj.obj ζ = proj.obj ξ}
      (r : Functor.Restriction proj g ζ hζ),
      proj.map r.hom = eqToHom r.hpt ≫ g ≫ eqToHom hζ.symm := fun {_ g _ hζ} r =>
    (IsHomLift.fac' proj (eqToHom r.hpt ≫ g ≫ eqToHom hζ.symm) r.hom).trans (by simp)
  have hbφ : ∀ i, proj.map (φ i) = eqToHom ((ξr i).hpt.trans (ηr i).hpt.symm) := fun i =>
    (IsHomLift.fac' proj (eqToHom (ξr i).hpt ≫ eqToHom (ηr i).hpt.symm) (φ i)).trans (by simp)
  have : proj.IsFibered := hg.isFibered
  -- two morphisms with the same base and the same composite with a morphism agree
  have hext : ∀ {ζ₁ ζ₂ ζ₃ : EtaleSmoothLift B S hS ι hι W x hx} (φ' : ζ₂ ⟶ ζ₃)
      {χ₁ χ₂ : ζ₁ ⟶ ζ₂}, proj.map χ₁ = proj.map χ₂ → χ₁ ≫ φ' = χ₂ ≫ φ' → χ₁ = χ₂ := by
    intro ζ₁ ζ₂ ζ₃ φ' χ₁ χ₂ hb hc'
    have h₁ : proj.IsHomLift (proj.map χ₂) χ₁ := hb ▸ IsHomLift.map _ χ₁
    have h₂ : proj.IsHomLift (proj.map χ₂) χ₂ := IsHomLift.map _ χ₂
    have h₃ : proj.IsHomLift (proj.map φ') φ' := IsHomLift.map _ φ'
    exact hg.hom_ext (f := proj.map φ') (proj.map χ₂) φ' hc'
  have hm : ∀ q : Space.points B S hS ξ.base.obj.left.obj, ∃ (i : I)
      (q' : Space.points B S hS (ξr i).pt.base.obj.left.obj),
      Space.pointsMap B S hS _ (Hom.base (ξr i).hom).hom.left.hom q' = q := by
    intro q
    obtain ⟨i, q₀, hq₀⟩ := Space.SpacesEtale.exists_point_of_ofArrows_mem_topology hf q
    obtain ⟨q', hq'⟩ := exists_pointsMap_eqToHom_comp (ξr i).hpt (f i) ⟨q₀, hq₀⟩
    exact ⟨i, q', (congrArg (fun t : (ξr i).pt.base ⟶ ξ.base => Space.pointsMap B S hS _
      t.hom.left.hom q') (hbr (ξr i))).trans hq'⟩
  have hn : ∀ i, Hom.base (ξr i).hom ≫ eqToHom hη.symm = Hom.base (φ i ≫ (ηr i).hom) := by
    intro i
    show proj.map (ξr i).hom ≫ eqToHom hη.symm = proj.map (φ i) ≫ proj.map (ηr i).hom
    rw [hbr (ξr i), hbφ, hbr (ηr i)]
    simp
  have hcompat : ∀ k l (ω : EtaleSmoothLift B S hS ι hι W x hx) (a : ω ⟶ (ξr k).pt)
      (b : ω ⟶ (ξr l).pt),
      IsPullback (Hom.base a) (Hom.base b) (Hom.base (ξr k).hom) (Hom.base (ξr l).hom) →
      a ≫ (ξr k).hom = b ≫ (ξr l).hom → a ≫ (φ k ≫ (ηr k).hom) = b ≫ (φ l ≫ (ηr l).hom) := by
    intro k l ω a b _ hab
    obtain ⟨γ, -, hγ₁, hγ₂⟩ := hc k l
    have hab' : (proj.map a ≫ eqToHom (ξr k).hpt) ≫ f k =
        (proj.map b ≫ eqToHom (ξr l).hpt) ≫ f l := by
      have h := congrArg proj.map hab
      rw [proj.map_comp, proj.map_comp, hbr (ξr k), hbr (ξr l)] at h
      simpa using h
    let e : proj.obj ω ⟶ proj.obj (ξrij k l).pt :=
      (hVij k l).lift _ _ hab' ≫ eqToHom (ξrij k l).hpt.symm
    have hce : e ≫ proj.map (ξrij k l).hom = proj.map (a ≫ (ξr k).hom) := by
      rw [proj.map_comp, hbr (ξrij k l), hbr (ξr k)]
      simp only [e, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
      rw [(hVij k l).lift_fst_assoc]
      simp
    let c := fillIn (ξrij k l).hom (a ≫ (ξr k).hom) e hce
    have hc' : c ≫ (ξrij k l).hom = a ≫ (ξr k).hom := fillIn_comp _ _ _ _
    have hPc : proj.map c = e := rfl
    -- a morphism `z` into `(ξr m).pt` over the same composite factors through `c`
    have hfac : ∀ (m : I) (p : Vij k l ⟶ V m) (hp : pr₁ k l ≫ f k = p ≫ f m)
        (z : ω ⟶ (ξr m).pt) (hzc : z ≫ (ξr m).hom = a ≫ (ξr k).hom)
        (hzp : proj.map z ≫ eqToHom (ξr m).hpt = (hVij k l).lift _ _ hab' ≫ p),
        Functor.Restriction.compTo proj p (f m) hp (ξr m) (ξrij k l) ≫ φ m =
          γ ≫ Functor.Restriction.compTo proj p (f m) hp (ηr m) (ηrij k l) →
        z ≫ (φ m ≫ (ηr m).hom) = c ≫ (γ ≫ (ηrij k l).hom) := by
      intro m p hp z hzc hzp hγ
      have hτ : proj.map (Functor.Restriction.compTo proj p (f m) hp (ξr m) (ξrij k l)) =
          eqToHom (ξrij k l).hpt ≫ p ≫ eqToHom (ξr m).hpt.symm := by
        have := Functor.Restriction.isHomLift_compTo (p := proj) p (f m) hp (ξr m) (ξrij k l)
        exact IsHomLift.fac' proj p _
      have hz : z = c ≫ Functor.Restriction.compTo proj p (f m) hp (ξr m) (ξrij k l) := by
        refine hext (ξr m).hom ?_ ?_
        · rw [proj.map_comp, hPc, hτ]
          simp only [e, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
          rw [← Category.assoc, ← hzp]
          simp
        · rw [Category.assoc, Functor.Restriction.compTo_hom, hc', hzc]
      rw [hz, Category.assoc, ← Category.assoc _ (φ m), hγ, Category.assoc,
        Functor.Restriction.compTo_hom]
    exact (hfac k (pr₁ k l) rfl a rfl ((hVij k l).lift_fst _ _ hab').symm hγ₁.symm).trans
      (hfac l (pr₂ k l) (hVij k l).w b hab.symm ((hVij k l).lift_snd _ _ hab').symm hγ₂.symm).symm
  obtain ⟨g, ⟨hgb, hgr⟩, hgu⟩ := existsUnique_hom_of_jointlySurjective (fun i => (ξr i).hom) hm
    (fun i => φ i ≫ (ηr i).hom) (eqToHom hη.symm) hn hcompat
  have hgf : ∀ g' : ξ ⟶ η, Hom.base g' = eqToHom hη.symm →
      Functor.FibreHom proj ξ η rfl hη g' := fun g' hb => by
    have h : proj.IsHomLift (eqToHom hη.symm) g' := hb ▸ IsHomLift.map _ g'
    show proj.IsHomLift (eqToHom rfl ≫ eqToHom hη.symm) g'
    rw [eqToHom_trans]
    exact h
  have := hgf g hgb
  refine ⟨g, ⟨hgf g hgb, hg.isIso_of_isHomLift_isIso (eqToHom rfl ≫ eqToHom hη.symm) g, hgr⟩,
    fun g' hg' => hgu g' ⟨?_, hg'.2.2⟩⟩
  have := hg'.1
  have h := IsHomLift.fac' proj (eqToHom rfl ≫ eqToHom hη.symm) g'
  exact h.trans (by simp; rfl)

/-- **Stacks 0CJU, condition (2) of Stacks 026F**: the presheaves `Mor(ξ, η)` of the category of
smooth lifts are sheaves on the spaces-étale site of `W`. It is the bridge
`CategoryTheory.Functor.isMorSheaf_of_isomIsSheaf` applied to
`AlgebraicGeometry.Stack.EtaleSmoothLift.isomIsSheafFor_proj`. -/
theorem isMorSheaf_proj (U : Space.SpacesEtale B S hS W) :
    haveI : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsFibered :=
      isFiberedInGroupoids_proj.isFibered
    ∀ ξ η : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).Fiber U,
      Functor.IsMorSheaf proj (Space.SpacesEtale.topology B S hS W) U ξ η := by
  have : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsFibered :=
    isFiberedInGroupoids_proj.isFibered
  intro ξ η
  exact Functor.isMorSheaf_of_isomIsSheaf isFiberedInGroupoids_proj
    (fun {_} a b ha hb {_} V g hg Vij pr₁ pr₂ hVij ar br arij brij =>
      isomIsSheafFor_proj a b ha hb V g hg Vij pr₁ pr₂ hVij ar br arij brij) U ξ η

end EtaleSmoothLift

end AlgebraicGeometry.Stack

