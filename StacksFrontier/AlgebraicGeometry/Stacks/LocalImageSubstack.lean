module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Stacks.FullSubcategoryBaseChange
public import StacksFrontier.AlgebraicGeometry.Stacks.RelativePropertyDescent
public import StacksFrontier.AlgebraicGeometry.Stacks.RelativePropertyInvariance
public import StacksFrontier.CategoryTheory.TwoFibreProduct.OverFunctoriality

/-!
# The strictly full subcategory locally generated by a 1-morphism

Let `g : 𝒰 ⟶ 𝒳` be a 1-morphism of categories fibred in groupoids over the big fppf site of a
scheme `S`. This file cuts out of `𝒳` the strictly full subcategory of those objects which are,
after restriction to a covering sieve of their base, in the image of `g`:
`AlgebraicGeometry.Stack.localImage`.

The arrows along which an object restricts into the image of `g` form a sieve,
`AlgebraicGeometry.Stack.localImageSieve`, and the property is that this sieve is a covering
sieve. So stated, the property is inherited along arbitrary morphisms of `𝒳` — hence cuts out a
full subcategory which is again fibred in groupoids, by
`AlgebraicGeometry.Stack.isFiberedInGroupoids_fullSubcategoryBased` — and is local on the big
fppf site.

## Main definitions

* `AlgebraicGeometry.Stack.localImageSieve`: the sieve of arrows along which an object of `𝒳`
  restricts into the image of `g`.
* `AlgebraicGeometry.Stack.localImage`: the objects of `𝒳` locally in the image of `g`.

* `AlgebraicGeometry.Stack.localImageStack`: the full subcategory they cut out, as a category
  fibred in groupoids.
* `AlgebraicGeometry.Stack.toLocalImage`: the factorization of `g` through it.
* `AlgebraicGeometry.Stack.localImageRelationCompare`: the comparison of the two
  self-intersections.

## Main results

* `AlgebraicGeometry.Stack.localImage_of_hom`: the property is inherited along morphisms.
* `AlgebraicGeometry.Stack.localImage_of_locally`: the property is local on the site.
* `AlgebraicGeometry.Stack.localImage_obj`: the image of `g` lies in the subcategory.
* `AlgebraicGeometry.Stack.localEssSurj_toLocalImage`: the factorization is locally essentially
  surjective, in the form **Stacks 045D** consumes.
* `AlgebraicGeometry.Stack.relativeProperty_toLocalImage`: every relative property of
  **Stacks 03YK** that the self-intersection projection of `g` has, the factorization has too.
  The self-intersection of the factorization *is* the self-intersection of `g`, because changing
  the target of a 2-fibre product along the fully faithful inclusion of a full subcategory does
  not change it (`CategoryTheory.TwoFibreProductOver.isEquivalence_mapBase`), and Stacks 045D
  descends a relative property along a locally essentially surjective 1-morphism.

## References

* [Stacks Project, Tag 03YK](https://stacks.math.columbia.edu/tag/03YK)
* [Stacks Project, Tag 045D](https://stacks.math.columbia.edu/tag/045D)
* [Stacks Project, Tag 04TU](https://stacks.math.columbia.edu/tag/04TU)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Stack

universe u w

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {𝒰 𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS)}

/-- **The sieve of arrows along which an object restricts into the image of `g`.** An arrow
`k : V ⟶ 𝒳.p ξ` belongs to it when some object `z` of `𝒰` has a morphism `g z ⟶ ξ` lying over
`k`; since every morphism of a category fibred in groupoids is strongly cartesian, that says
exactly that the restriction of `ξ` along `k` is isomorphic to an object in the image of `g`.

It is a sieve because an object of `𝒰` can be restricted: `𝒰` is fibred in groupoids and `g`
lies over the site. -/
def localImageSieve (g : 𝒰 ⟶ 𝒳) (ξ : 𝒳.val.obj) : Sieve (𝒳.val.p.obj ξ) where
  arrows V k := ∃ (z : 𝒰.val.obj) (φ : (CatFiberedInGroupoids.homFunctor g).obj z ⟶ ξ),
    𝒳.val.p.IsHomLift k φ
  downward_closed := by
    classical
    rintro V W k ⟨z, φ, hφ⟩ m
    have : 𝒰.val.p.IsFibered := 𝒰.property.isFibered
    have hdom : 𝒳.val.p.obj ((CatFiberedInGroupoids.homFunctor g).obj z) = V := by
      have := hφ
      exact IsHomLift.domain_eq 𝒳.val.p k φ
    have hbase : 𝒰.val.p.obj z = V :=
      (Functor.congr_obj (CatFiberedInGroupoids.homFunctor_comp_p g) z).symm.trans hdom
    obtain ⟨y, χ, hχ⟩ := IsPreFibered.exists_isCartesian 𝒰.val.p hbase m
    have hlift : 𝒰.val.p.IsHomLift m χ := hχ.toIsHomLift
    have hgχ : 𝒳.val.p.IsHomLift m ((CatFiberedInGroupoids.homFunctor g).map χ) :=
      (Functor.isHomLift_map_iff_of_comp_eq 𝒰.val.p 𝒳.val.p
        (CatFiberedInGroupoids.homFunctor g) (CatFiberedInGroupoids.homFunctor_comp_p g)
        m χ).2 hlift
    have := hφ
    have := hgχ
    exact ⟨y, (CatFiberedInGroupoids.homFunctor g).map χ ≫ φ, inferInstance⟩

/-- **The objects of `𝒳` locally in the image of a 1-morphism `g : 𝒰 ⟶ 𝒳`.** The sieve
`AlgebraicGeometry.Stack.localImageSieve` of arrows along which the object restricts into the
image of `g` is a covering sieve for the fppf topology. -/
def localImage (g : 𝒰 ⟶ 𝒳) : ObjectProperty 𝒳.val.obj := fun ξ =>
  localImageSieve g ξ ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj ξ)

/-- Membership of `AlgebraicGeometry.Stack.localImage` from any covering sieve witnessing it. -/
theorem localImage_of_sieve (g : 𝒰 ⟶ 𝒳) {ξ : 𝒳.val.obj} {R : Sieve (𝒳.val.p.obj ξ)}
    (hR : R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj ξ))
    (hle : R ≤ localImageSieve g ξ) : localImage g ξ :=
  (BigFppfOver.topology B S hS).superset_covering hle hR

/-- **The image of `g` lies in the subcategory it locally generates.** Every arrow of the site
into the base of `g z` lies in the sieve, by restricting `z` itself. -/
theorem localImage_obj (g : 𝒰 ⟶ 𝒳) (z : 𝒰.val.obj) :
    localImage g ((CatFiberedInGroupoids.homFunctor g).obj z) := by
  classical
  refine localImage_of_sieve g ((BigFppfOver.topology B S hS).top_mem _) ?_
  intro V k _
  have : 𝒰.val.p.IsFibered := 𝒰.property.isFibered
  have hbase : 𝒰.val.p.obj z = 𝒳.val.p.obj ((CatFiberedInGroupoids.homFunctor g).obj z) :=
    (Functor.congr_obj (CatFiberedInGroupoids.homFunctor_comp_p g) z).symm
  obtain ⟨y, χ, hχ⟩ := IsPreFibered.exists_isCartesian 𝒰.val.p hbase k
  refine ⟨y, (CatFiberedInGroupoids.homFunctor g).map χ, ?_⟩
  exact (Functor.isHomLift_map_iff_of_comp_eq 𝒰.val.p 𝒳.val.p
    (CatFiberedInGroupoids.homFunctor g) (CatFiberedInGroupoids.homFunctor_comp_p g)
    k χ).2 hχ.toIsHomLift

/-- **The property is inherited along morphisms of `𝒳`.** If `b` is locally in the image of `g`
and `φ₀ : a ⟶ b` is any morphism, then `a` is locally in the image of `g`: restrict the
witnessing sieve along the base of `φ₀` and factor each witness through `φ₀`, which is strongly
cartesian because `𝒳` is fibred in groupoids. -/
theorem localImage_of_hom (g : 𝒰 ⟶ 𝒳) {a b : 𝒳.val.obj} (φ₀ : a ⟶ b)
    (hb : localImage g b) : localImage g a := by
  classical
  refine localImage_of_sieve g
    ((BigFppfOver.topology B S hS).pullback_stable (𝒳.val.p.map φ₀) hb) ?_
  intro V k hk
  obtain ⟨z, φ, hφ⟩ := hk
  have hcart : 𝒳.val.p.IsStronglyCartesian (𝒳.val.p.map φ₀) φ₀ :=
    𝒳.property.isStronglyCartesian_homLift _ _
  have := hφ
  refine ⟨z, Functor.IsStronglyCartesian.map 𝒳.val.p (𝒳.val.p.map φ₀) φ₀
    (g := k) (f' := k ≫ 𝒳.val.p.map φ₀) rfl φ, ?_⟩
  exact Functor.IsStronglyCartesian.map_isHomLift 𝒳.val.p (𝒳.val.p.map φ₀) φ₀
    (g := k) (f' := k ≫ 𝒳.val.p.map φ₀) rfl φ

/-- **The property is local on the big fppf site.** If every arrow of a covering sieve of the
base of `ξ` carries an object locally in the image of `g` mapping to `ξ` over it, then `ξ` is
itself locally in the image of `g`.

The witnessing sieve is `AlgebraicGeometry.Stack.localImageSieve` itself, and the hypothesis
makes its pullback along each arrow of the covering sieve a covering sieve, so transitivity of
the topology applies. -/
theorem localImage_of_locally (g : 𝒰 ⟶ 𝒳) {ξ : 𝒳.val.obj}
    {R : Sieve (𝒳.val.p.obj ξ)} (hR : R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj ξ))
    (h : ∀ ⦃V : BigFppfOver B S hS⦄ ⦃k : V ⟶ 𝒳.val.p.obj ξ⦄, R.arrows k →
      ∃ (η : 𝒳.val.obj) (ψ : η ⟶ ξ), 𝒳.val.p.IsHomLift k ψ ∧ localImage g η) :
    localImage g ξ := by
  classical
  refine (BigFppfOver.topology B S hS).transitive hR _ ?_
  intro V k hk
  obtain ⟨η, ψ, hψ, hη⟩ := h hk
  have hdom : 𝒳.val.p.obj η = V := by have := hψ; exact IsHomLift.domain_eq 𝒳.val.p k ψ
  subst hdom
  refine (BigFppfOver.topology B S hS).superset_covering ?_ hη
  intro W l hl
  obtain ⟨z, φ, hφ⟩ := hl
  have := hφ
  have := hψ
  exact ⟨z, φ ≫ ψ, inferInstance⟩

/-! ### The subcategory, and the factorization of `g` through it -/

section Substack

variable {𝒴 : AlgebraicStacks.{u, w} B S hS} (g : 𝒰 ⟶ 𝒴.val)

/-- **The property is inherited along morphisms**, in the form the substack machinery of
`StacksFrontier.AlgebraicGeometry.Stacks.FullSubcategoryBaseChange` takes it. -/
theorem localImage_inherited :
    ∀ {a b : 𝒴.val.val.obj}, (a ⟶ b) → localImage g b → localImage g a :=
  fun φ h => localImage_of_hom g φ h

/-- **The strictly full subcategory of `𝒴` locally generated by `g`, as a category fibred in
groupoids over the big fppf site of `S`.** -/
abbrev localImageStack : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS) :=
  CatFiberedInGroupoids.mk (fullSubcategoryBased 𝒴 (localImage g))
    (isFiberedInGroupoids_fullSubcategoryBased 𝒴 (localImage_inherited g))

/-- **The factorization of `g` through the subcategory it locally generates**, as a 1-morphism
of categories over the big fppf site. Composed with the inclusion it is `g` on the nose. -/
def toLocalImageBased : 𝒰.val ⥤ᵇ fullSubcategoryBased 𝒴 (localImage g) where
  toFunctor :=
    ObjectProperty.lift _ (CatFiberedInGroupoids.homFunctor g) (localImage_obj g)
  w := CatFiberedInGroupoids.homFunctor_comp_p g

/-- **The factorization of `g` through the subcategory it locally generates**, as a 1-morphism
of categories fibred in groupoids. -/
def toLocalImage : 𝒰 ⟶ localImageStack g :=
  Bicategory.InducedBicategory.mkHom (toLocalImageBased g)

/-- Composing the factorization with the inclusion of the subcategory returns `g`. -/
theorem toLocalImageBased_comp_inclusion :
    (toLocalImageBased g).comp (fullSubcategoryBasedInclusion 𝒴 (localImage g)) = g.hom :=
  rfl

/-- **The factorization of `g` through the subcategory it locally generates is locally
essentially surjective**, in the form the descent lemma **Stacks 045D** consumes: every object
of a fibre of the subcategory becomes, after restriction along each arrow of a covering sieve,
the image of an object of `𝒰`.

The covering sieve is the one witnessing membership of the subcategory, and the morphism it
provides is a morphism of `𝒴` between objects of the subcategory, hence a morphism of the
subcategory, the inclusion being full. -/
theorem localEssSurj_toLocalImage (U : BigFppfOver B S hS)
    (y : (localImageStack g).val.p.Fiber U) :
    ∃ R ∈ BigFppfOver.topology B S hS U,
      ∀ ⦃V : BigFppfOver B S hS⦄ ⦃k : V ⟶ U⦄, R.arrows k →
        ∃ (z : 𝒰.val.obj) (φ : (CatFiberedInGroupoids.homFunctor (toLocalImage g)).obj z ⟶ y.1),
          (localImageStack g).val.p.IsHomLift k φ := by
  classical
  obtain ⟨ξ, hξ⟩ := y
  subst hξ
  refine ⟨localImageSieve g ξ.obj, ξ.property, fun V k hk => ?_⟩
  obtain ⟨z, φ, hφ⟩ := hk
  refine ⟨z, (ObjectProperty.homMk φ :
    (CatFiberedInGroupoids.homFunctor (toLocalImage g)).obj z ⟶ ξ), ?_⟩
  exact (Functor.isHomLift_map_iff_of_comp_eq (localImageStack g).val.p 𝒴.val.val.p
    (localImage g).ι rfl k _).1 hφ

/-! ### Relative properties of the factorization -/

/-- **The self-intersection of the factorization is the self-intersection of `g`.** Changing the
target of a 2-fibre product along a fully faithful 1-morphism over the site does not change it
(`CategoryTheory.TwoFibreProductOver.mapBase`), and the inclusion of a full subcategory is fully
faithful. The comparison is strictly compatible with the structure functors and with both
projections. -/
def localImageRelationCompare :
    (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1}
        (toLocalImage g) (toLocalImage g)).pt.val ⥤ᵇ
      (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1} g g).pt.val where
  toFunctor :=
    TwoFibreProductOver.mapBase (pT := 𝒰.val.p) (p𝒜 := 𝒰.val.p)
      (toLocalImage g).hom.toFunctor (toLocalImage g).hom.toFunctor
      (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor rfl
  w := rfl

/-- The comparison of the two self-intersections is an equivalence of the underlying
categories. -/
instance isEquivalence_localImageRelationCompare :
    Functor.IsEquivalence (localImageRelationCompare g).toFunctor :=
  by
  have hfullP : (localImage g).ι.Full := ObjectProperty.full_ι (localImage g)
  have hfaithfulP : (localImage g).ι.Faithful := ObjectProperty.faithful_ι (localImage g)
  have hfull : (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor.Full := hfullP
  have hfaithful : (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor.Faithful :=
    hfaithfulP
  exact TwoFibreProductOver.isEquivalence_mapBase (pT := 𝒰.val.p) (p𝒜 := 𝒰.val.p)
    (G := (toLocalImage g).hom.toFunctor) (F := (toLocalImage g).hom.toFunctor)
    (b := (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor) rfl

/-- **Every relative property of the self-intersection projection of `g` is a relative property
of the factorization of `g` through the subcategory it locally generates.**

This is **Stacks 045D** at the factorization: it is locally essentially surjective by
`AlgebraicGeometry.Stack.localEssSurj_toLocalImage`, so the relative property of Stacks 03YK may
be read off its base change along itself, and that base change is the self-intersection
projection of `g`, the inclusion of the subcategory being fully faithful. -/
theorem relativeProperty_toLocalImage
    (P : MorphismProperty (AlgebraicSpaces B S hS)) [P.IsStableUnderBaseChange]
    [P.IsLocalAtTarget (Space.Topology.fppf.precoverage.{u, u} B S hS)]
    (hP : RelativeProperty B S hS P
      (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1} g g).fst) :
    RelativeProperty B S hS P (toLocalImage g) := by
  refine relativeProperty_of_baseChange.{u, u, u, u} B S hS 𝒰 (localImageStack g) 𝒰 P
    (toLocalImage g) (toLocalImage g)
    (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1}
      (toLocalImage g) (toLocalImage g))
    (CatFiberedInGroupoids.isTwoFibreProduct_twoFibreProductSquare.{u, u, u + 1, u + 1} _ _)
    (localEssSurj_toLocalImage g) ?_
  let : Functor.IsEquivalence (BasedFunctor.id 𝒰.val).toFunctor :=
    inferInstanceAs (Functor.IsEquivalence (𝟭 𝒰.val.obj))
  exact relativeProperty_of_equivalences B S hS P
    (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1}
      (toLocalImage g) (toLocalImage g)).fst.hom
    (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1} g g).fst.hom
    (localImageRelationCompare g) (BasedFunctor.id 𝒰.val) (Iso.refl _) hP

end Substack

end AlgebraicGeometry.Stack

end
