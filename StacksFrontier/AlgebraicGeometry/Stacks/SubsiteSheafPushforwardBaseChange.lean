module

public import StacksFrontier.AlgebraicGeometry.Stacks.LisseEtaleSmoothClosure
public import StacksFrontier.AlgebraicGeometry.Stacks.SubsitePushforwardAmbientNaturality

/-!
# The identity `f'_*(g')^{-1} = g^{-1}f_*` of Stacks 07AT on sheaves of sets

Let `f : 𝒳 ⟶ 𝒴` be a smooth (respectively flat) 1-morphism of algebraic stacks, let `f'` be its
restriction to the lisse-étale (respectively flat-fppf) sites of **Stacks 07AT**, and let `g`,
`g'` be the two inclusions of **Stacks 0788**. The canonical map
`g^{-1}f_* ⟶ f'_*(g')^{-1}` of Sites, Section 06UM is an isomorphism of functors on sheaves of
sets.

## Main results

* `AlgebraicGeometry.Stack.LisseEtale.isIso_sheafBaseChange`: **Stacks 07AT** (1), the identity
  `f'_*(g')^{-1} = g^{-1}f_*`.
* `AlgebraicGeometry.Stack.FlatFppf.isIso_sheafBaseChange`: **Stacks 07AT** (2), the same.

## Implementation notes

The identity is formalized at the canonical map rather than as an unnamed isomorphism: the
source asserts that the pullback map of Sites, Section 06UM "is an isomorphism", and that map is
`CategoryTheory.SubsitePushforward.subsiteRanBaseChange`, the base-change transformation of the
commuting square of `f`, `f'` and the two inclusions. Because it is a natural transformation of
functors to begin with, naturality in the object of the subsite — which the objectwise
bijections of `StacksFrontier/AlgebraicGeometry/Stacks/SubsitePushforwardAmbientUnconditional.lean`
do not carry — is part of the datum rather than something to be proved.

The coefficient universe is `Type (u + 1)`, the one in which the right Kan extensions computing
the two direct images exist: the two sites have their objects there and their morphisms in
`Type u`.

## References

* [Stacks Project, Tag 06UM](https://stacks.math.columbia.edu/tag/06UM)
* [Stacks Project, Tag 07AT](https://stacks.math.columbia.edu/tag/07AT)
* [Stacks Project, Tag 0788](https://stacks.math.columbia.edu/tag/0788)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 𝒴 : Stack.AlgebraicStacks.{u, w} B S hS} (f : 𝒳 ⟶ 𝒴)

attribute [local instance] hasPointwiseRightKanExtension_homFunctor

namespace LisseEtale

attribute [local instance] hasPointwiseRightKanExtension_inclusion_comp_homFunctor
  hasPointwiseRightKanExtension_primedSiteFunctor

variable (hf : AlgebraicStacks.IsSmooth B S hS f)

/-- The canonical map `g^{-1}f_*ℱ ⟶ f'_*(g')^{-1}ℱ` of **Stacks 07AT** (1) is bijective at every
smooth object of `𝒴`, for every sheaf of sets on the étale site of `𝒳`. -/
theorem bijective_subsiteRanBaseChange (ℱ : (𝒳.val.val.obj)ᵒᵖ ⥤ Type (u + 1))
    (hℱ : Presieve.IsSheaf (BigFppfOver.associatedTopology B S hS 𝒳.val.val.p .etale) ℱ)
    (y : LisseEtale.{u, w} B S hS 𝒴) :
    Function.Bijective
      (((SubsitePushforward.subsiteRanBaseChange.{_, _, _, _, u + 1} f.hom.hom.toFunctor
        (smoothObject.{u, w} B S hS 𝒳) (smoothObject_map.{u, w} B S hS f hf)).app ℱ).app
          (op y)) :=
  SubsitePushforward.bijective_subsiteRanBaseChange_app_app.{_, _, _, _, _, _, u + 1}
    𝒳.val.val.p 𝒴.val.val.p
    f.hom.hom.toFunctor (smoothObject.{u, w} B S hS 𝒳) (ambientChoiceOfPullbacks B S hS 𝒴)
    (smoothObject_map.{u, w} B S hS f hf) 𝒴.val.isFiberedInGroupoids f.hom.hom.w y ℱ
    (ambientTwoFibreProductTopology B S hS f y .etale)
    (isSheaf_comp_ambientProjection B S hS f y .etale ℱ hℱ)
    (hasLocalFactorizations_primedInclusion B S hS f y)
    (hasLocallyConnectedFactorizations_primedInclusion B S hS f y)

/-- Cocontinuity of the site functor of **Stacks 07AT** (1), in the shape in which it is the
restriction of `f` to the two full subcategories, for the topology generated by the chosen
covering families. The same property for the topology each subsite inherits from the ambient site
is `AlgebraicGeometry.Stack.LisseEtale.isCocontinuous_subsiteFunctor`; the two topologies are
equal by `AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`. -/
theorem isCocontinuous_subsiteFunctor_topology :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (smoothObject.{u, w} B S hS 𝒳)
      (smoothObject_map.{u, w} B S hS f hf)).IsCocontinuous
        (topology.{u, w} B S hS 𝒳) (topology.{u, w} B S hS 𝒴) := by
  have h := siteFunctor_isCocontinuous.{u, w} B S hS f hf
  rwa [siteFunctor_eq_primedSiteFunctor.{u, w}] at h

/-- **Stacks 07AT** (1), the identity `f'_*(g')^{-1} = g^{-1}f_*`. For a smooth 1-morphism
`f : 𝒳 ⟶ 𝒴` of algebraic stacks, the canonical map of Sites, Section 06UM from the restriction
along the inclusion `g` of the lisse-étale site of `𝒴` of the pushforward along `f`, to the
pushforward along the restriction `f'` of the restriction along the inclusion `g'` of the
lisse-étale site of `𝒳`, is an isomorphism of functors on sheaves of sets. -/
@[stacks 07AT "part (1), the identity `f'_*(g')^{-1} = g^{-1}f_*` for the lisse-étale site, on \
sheaves of sets and natural in the object of the lisse-étale site of `𝒴`: the canonical map of \
Sites, Section 06UM, which is \
`CategoryTheory.SubsitePushforward.subsiteRanBaseChange` at the square of `f`, its restriction \
`f'` and the two inclusions, is invertible. The site functor and its continuity and cocontinuity \
are registered in `StacksFrontier/AlgebraicGeometry/Stacks/LisseEtaleSiteFunctor.lean`"]
theorem isIso_sheafBaseChange :
    IsIso (SubsitePushforward.subsiteSheafBaseChange.{_, _, _, _, u + 1} f.hom.hom.toFunctor
      (smoothObject.{u, w} B S hS 𝒳) (smoothObject_map.{u, w} B S hS f hf)
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
      (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))
      (topology.{u, w} B S hS 𝒳) (topology.{u, w} B S hS 𝒴)
      (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
        (etaleTopology B)).2
      (isCocontinuous_subsiteFunctor_topology.{u, w} B S hS f hf)
      (isContinuous_inclusion_topology'.{u, w} B S hS 𝒳)
      (isContinuous_inclusion_topology'.{u, w} B S hS 𝒴)) :=
  SubsitePushforward.isIso_subsiteSheafBaseChange _ _ _ _ _ _ _ _ _ _ _
    (fun G y => bijective_subsiteRanBaseChange B S hS f hf G.obj
      ((isSheaf_iff_isSheaf_of_type _ _).mp G.property) y)

/-- Continuity of the site functor of **Stacks 07AT** (1), in the shape in which it is the
restriction of `f` to the two full subcategories, for the topology generated by the chosen
covering families. The same property for the topology each subsite inherits from the ambient site
is `AlgebraicGeometry.Stack.LisseEtale.isContinuous_subsiteFunctor`; the two topologies are equal
by `AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`. -/
theorem isContinuous_subsiteFunctor_topology :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (smoothObject.{u, w} B S hS 𝒳)
      (smoothObject_map.{u, w} B S hS f hf)).IsContinuous
        (topology.{u, w} B S hS 𝒳) (topology.{u, w} B S hS 𝒴) := by
  have h := siteFunctor_isContinuous.{u, w} B S hS f hf
  rwa [siteFunctor_eq_primedSiteFunctor.{u, w}] at h

/-- **Stacks 07AT** (1), the identity `g'_!(f')^{-1} = f^{-1}g_!`. It is the conjugate of
`AlgebraicGeometry.Stack.LisseEtale.isIso_sheafBaseChange` along the adjointness of `f^{-1}` and
`f_*`, of `g_!` and `g^{-1}`, and of their primed versions. -/
@[stacks 07AT "part (1), the identity `g'_!(f')^{-1} = f^{-1}g_!` for the lisse-étale site, on \
sheaves of sets: the conjugate of the first identity along the four adjunctions, exactly as the \
source derives it"]
noncomputable def shriekBaseChangeIso :
    letI := (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
      (etaleTopology B)).1
    letI := (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
      (etaleTopology B)).2
    letI := isContinuous_subsiteFunctor_topology.{u, w} B S hS f hf
    letI := isCocontinuous_subsiteFunctor_topology.{u, w} B S hS f hf
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (smoothObject.{u, w} B S hS 𝒳)
          (smoothObject_map.{u, w} B S hS f hf)).sheafPushforwardContinuous (Type (u + 1))
          (topology.{u, w} B S hS 𝒳) (topology.{u, w} B S hS 𝒴) ⋙
        setsShriek B S hS 𝒳 ≅
      setsShriek B S hS 𝒴 ⋙ f.hom.hom.toFunctor.sheafPushforwardContinuous (Type (u + 1))
        (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B)) :=
  SubsitePushforward.subsiteShriekBaseChangeIso.{_, _, _, _, u + 1} f.hom.hom.toFunctor
    (smoothObject.{u, w} B S hS 𝒳) (smoothObject_map.{u, w} B S hS f hf)
    (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
    (associatedTopology B S hS 𝒴.val.val.p (etaleTopology B))
    (topology.{u, w} B S hS 𝒳) (topology.{u, w} B S hS 𝒴)
    (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f (etaleTopology B)).1
    (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f (etaleTopology B)).2
    (isContinuous_subsiteFunctor_topology.{u, w} B S hS f hf)
    (isCocontinuous_subsiteFunctor_topology.{u, w} B S hS f hf)
    (isContinuous_inclusion_topology'.{u, w} B S hS 𝒳)
    (isContinuous_inclusion_topology'.{u, w} B S hS 𝒴)
    (setsShriek B S hS 𝒴) (setsShriek B S hS 𝒳)
    (setsShriekAdjunction B S hS 𝒴) (setsShriekAdjunction B S hS 𝒳)
    (isIso_sheafBaseChange B S hS f hf)

end LisseEtale

namespace FlatFppf

attribute [local instance] hasPointwiseRightKanExtension_inclusion_comp_homFunctor
  hasPointwiseRightKanExtension_primedSiteFunctor

variable (hf : AlgebraicStacks.IsFlat B S hS f)

/-- The canonical map `g^{-1}f_*ℱ ⟶ f'_*(g')^{-1}ℱ` of **Stacks 07AT** (2) is bijective at every
flat object of `𝒴`, for every sheaf of sets on the fppf site of `𝒳`. -/
theorem bijective_subsiteRanBaseChange (ℱ : (𝒳.val.val.obj)ᵒᵖ ⥤ Type (u + 1))
    (hℱ : Presieve.IsSheaf (BigFppfOver.associatedTopology B S hS 𝒳.val.val.p .fppf) ℱ)
    (y : FlatFppf B S hS 𝒴) :
    Function.Bijective
      (((SubsitePushforward.subsiteRanBaseChange.{_, _, _, _, u + 1} f.hom.hom.toFunctor
        (objectProperty B S hS 𝒳) (flatObject_map B S hS f hf)).app ℱ).app (op y)) :=
  SubsitePushforward.bijective_subsiteRanBaseChange_app_app.{_, _, _, _, _, _, u + 1}
    𝒳.val.val.p 𝒴.val.val.p
    f.hom.hom.toFunctor (objectProperty B S hS 𝒳) (ambientChoiceOfPullbacks B S hS 𝒴)
    (flatObject_map B S hS f hf) 𝒴.val.isFiberedInGroupoids f.hom.hom.w y ℱ
    (ambientTwoFibreProductTopology B S hS f y .fppf)
    (isSheaf_comp_ambientProjection B S hS f y .fppf ℱ hℱ)
    (hasLocalFactorizations_primedInclusion B S hS f y)
    (hasLocallyConnectedFactorizations_primedInclusion B S hS f y)

/-- Cocontinuity of the site functor of **Stacks 07AT** (2), in the shape in which it is the
restriction of `f` to the two full subcategories, for the topology generated by the chosen
covering families. The same property for the topology each subsite inherits from the ambient site
is `AlgebraicGeometry.Stack.FlatFppf.isCocontinuous_subsiteFunctor`; the two topologies are equal
by `AlgebraicGeometry.Stack.FlatFppf.inclusionTopology_eq_topology`. -/
theorem isCocontinuous_subsiteFunctor_topology :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (objectProperty B S hS 𝒳)
      (flatObject_map B S hS f hf)).IsCocontinuous
        (topology B S hS 𝒳) (topology B S hS 𝒴) := by
  have h := siteFunctor_isCocontinuous B S hS f hf
  rwa [siteFunctor_eq_primedSiteFunctor] at h

/-- **Stacks 07AT** (2), the identity `f'_*(g')^{-1} = g^{-1}f_*`. For a flat 1-morphism
`f : 𝒳 ⟶ 𝒴` of algebraic stacks, the canonical map of Sites, Section 06UM from the restriction
along the inclusion `g` of the flat-fppf site of `𝒴` of the pushforward along `f`, to the
pushforward along the restriction `f'` of the restriction along the inclusion `g'` of the
flat-fppf site of `𝒳`, is an isomorphism of functors on sheaves of sets. -/
@[stacks 07AT "part (2), the identity `f'_*(g')^{-1} = g^{-1}f_*` for the flat-fppf site, on \
sheaves of sets and natural in the object of the flat-fppf site of `𝒴`: the canonical map of \
Sites, Section 06UM, which is \
`CategoryTheory.SubsitePushforward.subsiteRanBaseChange` at the square of `f`, its restriction \
`f'` and the two inclusions, is invertible. The site functor and its continuity and cocontinuity \
are registered in `StacksFrontier/AlgebraicGeometry/Stacks/FlatFppfSiteFunctor.lean`"]
theorem isIso_sheafBaseChange :
    IsIso (SubsitePushforward.subsiteSheafBaseChange.{_, _, _, _, u + 1} f.hom.hom.toFunctor
      (objectProperty B S hS 𝒳) (flatObject_map B S hS f hf)
      (associatedTopology B S hS 𝒳.val.val.p B.topology)
      (associatedTopology B S hS 𝒴.val.val.p B.topology)
      (topology B S hS 𝒳) (topology B S hS 𝒴)
      (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f B.topology).2
      (isCocontinuous_subsiteFunctor_topology B S hS f hf)
      (isContinuous_inclusion_topology B S hS 𝒳)
      (isContinuous_inclusion_topology B S hS 𝒴)) :=
  SubsitePushforward.isIso_subsiteSheafBaseChange _ _ _ _ _ _ _ _ _ _ _
    (fun G y => bijective_subsiteRanBaseChange B S hS f hf G.obj
      ((isSheaf_iff_isSheaf_of_type _ _).mp G.property) y)

/-- Continuity of the site functor of **Stacks 07AT** (2), in the shape in which it is the
restriction of `f` to the two full subcategories, for the topology generated by the chosen
covering families. The same property for the topology each subsite inherits from the ambient site
is `AlgebraicGeometry.Stack.FlatFppf.isContinuous_subsiteFunctor`; the two topologies are equal
by `AlgebraicGeometry.Stack.FlatFppf.inclusionTopology_eq_topology`. -/
theorem isContinuous_subsiteFunctor_topology :
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (objectProperty B S hS 𝒳)
      (flatObject_map B S hS f hf)).IsContinuous
        (topology B S hS 𝒳) (topology B S hS 𝒴) := by
  have h := siteFunctor_isContinuous B S hS f hf
  rwa [siteFunctor_eq_primedSiteFunctor] at h

/-- **Stacks 07AT** (2), the identity `g'_!(f')^{-1} = f^{-1}g_!`. It is the conjugate of
`AlgebraicGeometry.Stack.FlatFppf.isIso_sheafBaseChange` along the adjointness of `f^{-1}` and
`f_*`, of `g_!` and `g^{-1}`, and of their primed versions. The two lower-shriek adjunctions are
the ones of **Stacks 0788** already in the tree. -/
@[stacks 07AT "part (2), the identity `g'_!(f')^{-1} = f^{-1}g_!` for the flat-fppf site, on \
sheaves of sets: the conjugate of the first identity along the four adjunctions, exactly as the \
source derives it"]
noncomputable def shriekBaseChangeIso :
    letI := (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
      B.topology).1
    letI := (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f
      B.topology).2
    letI := isContinuous_subsiteFunctor_topology B S hS f hf
    letI := isCocontinuous_subsiteFunctor_topology B S hS f hf
    (SubsitePushforward.subsiteFunctor f.hom.hom.toFunctor (objectProperty B S hS 𝒳)
          (flatObject_map B S hS f hf)).sheafPushforwardContinuous (Type (u + 1))
          (topology B S hS 𝒳) (topology B S hS 𝒴) ⋙
        setsShriek B S hS 𝒳 ≅
      setsShriek B S hS 𝒴 ⋙ f.hom.hom.toFunctor.sheafPushforwardContinuous (Type (u + 1))
        (associatedTopology B S hS 𝒳.val.val.p B.topology)
        (associatedTopology B S hS 𝒴.val.val.p B.topology) :=
  SubsitePushforward.subsiteShriekBaseChangeIso.{_, _, _, _, u + 1} f.hom.hom.toFunctor
    (objectProperty B S hS 𝒳) (flatObject_map B S hS f hf)
    (associatedTopology B S hS 𝒳.val.val.p B.topology)
    (associatedTopology B S hS 𝒴.val.val.p B.topology)
    (topology B S hS 𝒳) (topology B S hS 𝒴)
    (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f B.topology).1
    (isContinuous_and_isCocontinuous_homFunctor_associatedTopology B S hS f B.topology).2
    (isContinuous_subsiteFunctor_topology B S hS f hf)
    (isCocontinuous_subsiteFunctor_topology B S hS f hf)
    (isContinuous_inclusion_topology B S hS 𝒳)
    (isContinuous_inclusion_topology B S hS 𝒴)
    (setsShriek B S hS 𝒴) (setsShriek B S hS 𝒳)
    (setsShriekAdjunction B S hS 𝒴) (setsShriekAdjunction B S hS 𝒳)
    (isIso_sheafBaseChange B S hS f hf)

end FlatFppf

end AlgebraicGeometry.Stack

end
