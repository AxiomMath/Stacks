module

public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.IdealSheafResolution

/-!
# Generators of a power of the product ideal sheaf on an affine open

Let `X` and `Y` be schemes over `S`, let `I` and `I'` be quasi-coherent sheaves of ideals on `X`
and on `Y`, and let `𝓙 = pr₁^*𝓘 · pr₂^*𝓘'` be their product on `X ×_S Y`.
`AlgebraicGeometry.Scheme.IdealSheafData.ideal_externalProduct_pow` computes the ideal of `𝓙ⁿ`
on an affine open `W` of the fibre product lying over affine opens `U ⊆ X` and `V ⊆ Y` as a
product of two extended ideals. This file rewrites that product as a span: the ideal of `𝓙ⁿ` on
`W` is generated by the products `pr₁^#(a) · pr₂^#(b)` with `a ∈ 𝓘(U)ⁿ` and `b ∈ 𝓘'(V)ⁿ`.

## Main results

* `Ideal.map_mul_map_eq_span_mul_image`: the product of the extensions of two ideals along two
  ring maps into a common ring is generated by the products of the images of their elements.
* `AlgebraicGeometry.Scheme.IdealSheafData.ideal_externalProduct_pow_eq_span`: the ideal of
  `𝓙ⁿ` on `W` is generated by those products.
* `Stacks.AlgebraicGeometry.IdealPowerColimit.obj_idealPow_externalProduct_affineOpen_eq_span`:
  the same statement for the sections of `𝓙ⁿ` viewed as a sheaf of modules.

## Implementation notes

`Ideal.map φ A` is by definition the span of `φ '' A`, so the product of two such is the span of
the setwise product of the two images by `Ideal.span_mul_span`; rewriting that set as the set of
products of images of elements is what makes the statement usable.

The span form is the shape a local-surjectivity argument consumes: it presents a section of
`𝓙ⁿ` over `W` as a finite `Γ(X ×_S Y, W)`-linear combination of products of pullbacks of
sections of `𝓘ⁿ` over `U` and of `𝓘'ⁿ` over `V`, which is what a section of the external tensor
product of `𝓘ⁿ` and `𝓘'ⁿ` has to be matched against.

## References

* [Stacks Project, Tag 0FZ0](https://stacks.math.columbia.edu/tag/0FZ0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open Stacks.AlgebraicGeometry.IdealPower
open Stacks.AlgebraicGeometry.IdealPowerColimit

universe u

/-- **The product of two extended ideals is generated by the products of the images.** For ring
maps `φ : R →+* T` and `ψ : S →+* T` and ideals `A ⊆ R`, `B ⊆ S`, the product of the ideals
generated by `φ '' A` and by `ψ '' B` is generated by the elements `φ a * ψ b`. -/
theorem Ideal.map_mul_map_eq_span_mul_image {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] (φ : R →+* T) (ψ : S →+* T) (A : Ideal R) (B : Ideal S) :
    Ideal.map φ A * Ideal.map ψ B = Ideal.span {z | ∃ a ∈ A, ∃ b ∈ B, z = φ a * ψ b} := by
  rw [Ideal.map, Ideal.map, Ideal.span_mul_span]
  congr 1
  ext z
  constructor
  · rintro ⟨x, ⟨a, ha, rfl⟩, y, ⟨b, hb, rfl⟩, rfl⟩
    exact ⟨a, ha, b, hb, rfl⟩
  · rintro ⟨a, ha, b, hb, rfl⟩
    exact ⟨φ a, ⟨a, ha, rfl⟩, ψ b, ⟨b, hb, rfl⟩, rfl⟩

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- **The ideal of `𝓙ⁿ` on an affine open of `X ×_S Y`, as a span.** If `W` is an affine open of
the fibre product contained in `pr₁⁻¹ U ⊓ pr₂⁻¹ V` for affine opens `U ⊆ X` and `V ⊆ Y`, then
the ideal of the `n`-th power of `𝓙 = pr₁^*𝓘 · pr₂^*𝓘'` on `W` is generated by the products of
the pullbacks of a section of `𝓘(U)ⁿ` and a section of `𝓘'(V)ⁿ`. -/
theorem ideal_externalProduct_pow_eq_span {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)
    (I : X.IdealSheafData) (I' : Y.IdealSheafData) (n : ℕ)
    (U : X.affineOpens) (V : Y.affineOpens) (W : (pullback f g).affineOpens)
    (hU : W.1 ≤ pullback.fst f g ⁻¹ᵁ U.1) (hV : W.1 ≤ pullback.snd f g ⁻¹ᵁ V.1) :
    ((externalProduct f g I I') ^ n).ideal W =
      Ideal.span {z | ∃ a ∈ I.ideal U ^ n, ∃ b ∈ I'.ideal V ^ n,
        z = ((pullback.fst f g).appLE U.1 W.1 hU).hom a *
          ((pullback.snd f g).appLE V.1 W.1 hV).hom b} :=
  (ideal_externalProduct_pow f g I I' n U V W hU hV).trans
    (Ideal.map_mul_map_eq_span_mul_image _ _ _ _)

end AlgebraicGeometry.Scheme.IdealSheafData

namespace Stacks.AlgebraicGeometry.IdealPowerColimit

/-- **The sections of `𝓙ⁿ` on an affine open of `X ×_S Y`, as a span.** The submodule of
`𝒪_{X ×_S Y}(W)` cut out by `idealPow (externalProduct f g I I') n` is generated by the products
of the pullbacks of a section of `𝓘(U)ⁿ` and a section of `𝓘'(V)ⁿ`, for `W` an affine open
contained in `pr₁⁻¹ U ⊓ pr₂⁻¹ V`. -/
theorem obj_idealPow_externalProduct_affineOpen_eq_span {X Y S : Scheme.{u}} (f : X ⟶ S)
    (g : Y ⟶ S) (I : X.IdealSheafData) (I' : Y.IdealSheafData) (n : ℕ)
    (U : X.affineOpens) (V : Y.affineOpens) (W : (pullback f g).affineOpens)
    (hU : W.1 ≤ pullback.fst f g ⁻¹ᵁ U.1) (hV : W.1 ≤ pullback.snd f g ⁻¹ᵁ V.1) :
    (idealPowerMultiple (Scheme.IdealSheafData.externalProduct f g I I') n
          (structureModule (pullback f g))).toSubmodule.obj (op W.1) =
      Ideal.span {z | ∃ a ∈ I.ideal U ^ n, ∃ b ∈ I'.ideal V ^ n,
        z = ((pullback.fst f g).appLE U.1 W.1 hU).hom a *
          ((pullback.snd f g).appLE V.1 W.1 hV).hom b} :=
  (obj_idealPow_externalProduct_affineOpen f g I I' n U V W hU hV).trans
    (Ideal.map_mul_map_eq_span_mul_image _ _ _ _)

end Stacks.AlgebraicGeometry.IdealPowerColimit

end
