/-!
# Finite type quasi-coherent submodules

The quasi-coherent submodules of finite type of a quasi-coherent module `F` on a scheme form a
diagram over `F`: a subobject of `F` in the category of modules, together with the conditions
that its underlying module be quasi-coherent and of finite type. Stacks 01PG says that this
diagram is filtered and that `F` is its colimit; the filteredness is proved here.

## Main definitions

* `AlgebraicGeometry.finiteTypeQuasicoherentSubobjectProperty` is the property of a subobject of
  `F` that its underlying module is quasi-coherent and of finite type.
* `AlgebraicGeometry.FiniteTypeQuasicoherentSubobject` is the category of such subobjects.
* `AlgebraicGeometry.finiteTypeQuasicoherentSubobjectFunctor` is the diagram they form, and
  `AlgebraicGeometry.finiteTypeQuasicoherentSubobjectCocone` its canonical cocone with point
  `F`.

## Main results

* `AlgebraicGeometry.unit_isQuasicoherent_and_isFiniteType`: the structure sheaf is
  quasi-coherent and of finite type as a module over itself.
* `AlgebraicGeometry.finiteType_biprod`: the direct sum of two modules of finite type is of
  finite type.
* `AlgebraicGeometry.imageSubobject_isQuasicoherent` and
  `AlgebraicGeometry.imageSubobject_isFiniteType`: the image of a morphism of modules is
  quasi-coherent when its source and target are, and of finite type when its source is.
* `AlgebraicGeometry.finiteTypeQuasicoherentSubobject_isFiltered`: the first assertion of
  Stacks 01PG. The category is filtered, because the image in `F` of the direct sum of two
  finite type quasi-coherent submodules is again one.

## Implementation notes

A submodule is a categorical `Subobject` in `X.Modules`, so that two submodules with the same
image in `F` are equal, and the category of submodules satisfying a property is the
corresponding `ObjectProperty.FullSubcategory`; its morphisms are the inclusions, which makes
the canonical cocone well defined. Filteredness rather than directedness of a partial order is
what the subobject formulation gives: between two objects there is at most one morphism, so the
`cocone_maps` condition is automatic.

## References

* [Stacks Project, Tag 01PG](https://stacks.math.columbia.edu/tag/01PG)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

universe u

open _root_.SheafOfModules

/-- The property of a subobject of `F` that its underlying module is quasi-coherent and of
finite type. -/
def finiteTypeQuasicoherentSubobjectProperty {X : Scheme.{u}} (F : X.Modules) :
    ObjectProperty (Subobject F) :=
  fun G => SheafOfModules.IsQuasicoherent (G : X.Modules) ∧
    SheafOfModules.IsFiniteType (G : X.Modules)

/-- The category of quasi-coherent finite type subobjects of an `𝒪_X`-module `F`. -/
abbrev FiniteTypeQuasicoherentSubobject {X : Scheme.{u}} (F : X.Modules) :=
  (finiteTypeQuasicoherentSubobjectProperty F).FullSubcategory

/-- A module generated by finitely many sections over each member of a covering is of finite
type. -/
private lemma isFiniteType_of_generatingSections {X : Scheme.{u}} {M : X.Modules}
    (G : M.GeneratingSections) [G.IsFiniteType] : M.IsFiniteType := by
  have h : G.localGeneratorsData.IsFiniteType := by
    constructor
    intro i
    exact ⟨(inferInstance : G.IsFiniteType).finite⟩
  exact SheafOfModules.IsFiniteType.mk.{u, u, u} ⟨G.localGeneratorsData, h⟩

/-- The structure sheaf, as a module over itself, is quasi-coherent and of finite type: it is
the free module on a one-element index type. -/
lemma unit_isQuasicoherent_and_isFiniteType {X : Scheme.{u}} :
    (SheafOfModules.unit X.ringCatSheaf).IsQuasicoherent ∧
      (SheafOfModules.unit X.ringCatSheaf).IsFiniteType := by
  let O := SheafOfModules.unit X.ringCatSheaf
  let e : free (R := X.ringCatSheaf) PUnit.{u + 1} ≅ O := coproductUniqueIso _
  let σ := (free.generatingSections (R := X.ringCatSheaf) PUnit.{u + 1}).ofEpi e.hom
  have : σ.IsFiniteType := ⟨inferInstanceAs (Finite PUnit.{u + 1})⟩
  exact ⟨(SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso e (by infer_instance),
    isFiniteType_of_generatingSections σ⟩

/-- The direct sum of two modules of finite type is of finite type: it is an extension of one by
the other, and finite type is stable under extensions. -/
theorem finiteType_biprod {X : Scheme.{u}} (M N : X.Modules)
    [HasBinaryBiproduct M N] [M.IsFiniteType] [N.IsFiniteType] :
    (M ⊞ N).IsFiniteType :=
  Stacks.SheafOfModules.isFiniteType_middle_of_shortExact _
    (ShortComplex.Splitting.ofHasBinaryBiproduct M N).shortExact ‹_› ‹_›

/-- The image of a morphism between quasi-coherent modules is quasi-coherent: the largest
quasi-coherent subobject of the image receives the source, so its inclusion into the image is
both monic and epic. -/
lemma imageSubobject_isQuasicoherent {X : Scheme.{u}} {M N : X.Modules}
    [M.IsQuasicoherent] [N.IsQuasicoherent] (f : M ⟶ N) :
    (Subobject.underlying.obj (imageSubobject f)).IsQuasicoherent := by
  let I : Subobject N := imageSubobject f
  obtain ⟨G, hG, -⟩ := existsUnique_quasicoherentSubobject X N I
  let p : M ⟶ (I : X.Modules) := factorThruImageSubobject f
  have hp : Epi p := by dsimp [p]; infer_instance
  obtain ⟨g, hg⟩ := (hG M).surjective p
  have : Epi G.1.arrow := epi_of_epi_fac hg
  have hGiso : IsIso G.1.arrow := isIso_of_mono_of_epi G.1.arrow
  exact (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso
    (@asIso _ _ _ _ G.1.arrow hGiso) G.2

/-- The image of a morphism out of a module of finite type is of finite type: it is a quotient
of the source. -/
lemma imageSubobject_isFiniteType {X : Scheme.{u}} {M N : X.Modules}
    [M.IsFiniteType] (f : M ⟶ N) :
    (Subobject.underlying.obj (imageSubobject f)).IsFiniteType := by
  have hp : Epi (factorThruImageSubobject f) := by
    dsimp [factorThruImageSubobject]
    apply epi_comp
  exact @Stacks.SheafOfModules.isFiniteType_of_epi'.{u} _ _ _ _ _ _ _ _ _
    (factorThruImageSubobject f) inferInstance hp

/-- The diagram of all quasi-coherent finite type subobjects of `F`. -/
noncomputable def finiteTypeQuasicoherentSubobjectFunctor {X : Scheme.{u}} (F : X.Modules) :
    FiniteTypeQuasicoherentSubobject F ⥤ X.Modules :=
  (finiteTypeQuasicoherentSubobjectProperty F).ι ⋙ Subobject.underlying

/-- The canonical cocone from the quasi-coherent finite type subobjects of `F` to `F`, whose
legs are their inclusions. -/
noncomputable def finiteTypeQuasicoherentSubobjectCocone {X : Scheme.{u}} (F : X.Modules) :
    Cocone (finiteTypeQuasicoherentSubobjectFunctor F) :=
  Cocone.mk F
    { app := fun G => G.obj.arrow
      naturality := fun {_ _} f => Subobject.underlying_arrow f.hom }

/-- **Stacks Project, Tag 01PG.** The category of quasi-coherent finite type submodules of a
quasi-coherent module is filtered.

This is the directedness half of the tag; the other half, that the canonical cocone over this
diagram is a colimit cocone, is
`AlgebraicGeometry.isColimit_finiteTypeQuasicoherentSubobjectCocone`. Together the two are the
tag's assertion that a quasi-coherent module is the directed colimit of its quasi-coherent
submodules of finite type, so the tag is attached to both. -/
@[stacks 01PG]
instance finiteTypeQuasicoherentSubobject_isFiltered {X : Scheme.{u}} (F : X.Modules)
    [F.IsQuasicoherent] :
    IsFiltered (FiniteTypeQuasicoherentSubobject F) := by
  classical
  let P := finiteTypeQuasicoherentSubobjectProperty F
  refine {
    cocone_objs := ?_
    cocone_maps := ?_
    nonempty := ?_ }
  · intro A B
    have : (A.1 : X.Modules).IsQuasicoherent := A.2.1
    have : (B.1 : X.Modules).IsQuasicoherent := B.2.1
    have : (A.1 : X.Modules).IsFiniteType := A.2.2
    have : (B.1 : X.Modules).IsFiniteType := B.2.2
    let : HasBinaryBiproducts X.Modules := HasBinaryBiproducts.of_hasBinaryProducts
    let : HasBinaryBiproduct (A.1 : X.Modules) (B.1 : X.Modules) :=
      HasBinaryBiproduct.of_hasBinaryProduct _ _
    have : ((A.1 : X.Modules) ⊞ (B.1 : X.Modules)).IsQuasicoherent :=
      directSum_isQuasicoherent X.ringCatSheaf (A.1 : X.Modules) (B.1 : X.Modules)
    have := finiteType_biprod (A.1 : X.Modules) (B.1 : X.Modules)
    let f : (A.1 : X.Modules) ⊞ (B.1 : X.Modules) ⟶ F := biprod.desc A.1.arrow B.1.arrow
    let I : Subobject F := imageSubobject f
    have hA : A.1 ≤ I := by
      apply Subobject.le_of_comm (biprod.inl ≫ factorThruImageSubobject f)
      change (biprod.inl ≫ factorThruImageSubobject f) ≫ I.arrow = A.1.arrow
      rw [Category.assoc, imageSubobject_arrow_comp]
      simp [f]
    have hB : B.1 ≤ I := by
      apply Subobject.le_of_comm (biprod.inr ≫ factorThruImageSubobject f)
      change (biprod.inr ≫ factorThruImageSubobject f) ≫ I.arrow = B.1.arrow
      rw [Category.assoc, imageSubobject_arrow_comp]
      simp [f]
    exact ⟨⟨I, imageSubobject_isQuasicoherent f, imageSubobject_isFiniteType f⟩,
      P.homMk (homOfLE hA), P.homMk (homOfLE hB), trivial⟩
  · exact fun A B f g => ⟨B, 𝟙 B, P.hom_ext (Subsingleton.elim _ _)⟩
  · let : Preadditive X.Modules := inferInstance
    let O : X.Modules := SheafOfModules.unit X.ringCatSheaf
    let : O.IsQuasicoherent := (unit_isQuasicoherent_and_isFiniteType (X := X)).1
    let : O.IsFiniteType := (unit_isQuasicoherent_and_isFiniteType (X := X)).2
    let f : O ⟶ F := 0
    exact ⟨⟨imageSubobject f, imageSubobject_isQuasicoherent f, imageSubobject_isFiniteType f⟩⟩

end AlgebraicGeometry
