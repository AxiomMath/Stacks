module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import StacksCore.Tactic.StacksAttribute

/-!
# The ideal sheaf of a complement, and the product ideal on a fibre product

Fix a base scheme `S` and two schemes `X`, `Y` over it. The proof of Stacks 0FZ0 starts from two
opens `U ⊆ X` and `V ⊆ Y`, takes ideal sheaves `I ⊆ O_X` and `I' ⊆ O_Y` cutting out the
complements of `U` and of `V`, and forms

`J = Im(pr₁^*I ⊗_{O_{X ×_S Y}} pr₂^*I' → O_{X ×_S Y})`,

which is required to satisfy `V(J) = X ×_S Y \ U ×_S V`. This file supplies both inputs.

The ideal sheaf of a complement is `Scheme.IdealSheafData.complementIdeal`, the vanishing ideal
of the closed set `X \ U`; this is the ideal sheaf of the reduced induced closed subscheme
structure, and its vanishing locus is `X \ U` on the nose. Nothing below needs the reduced
structure: the support computation is stated for an arbitrary pair of ideal sheaves whose
supports are the two complements, so any quasi-coherent ideal cutting out the complement serves.

The product ideal is `Scheme.IdealSheafData.externalProduct`, the product of the two pullbacks
`pr₁^*I` and `pr₂^*I'`. This is the `J` of the source: the pullback `IdealSheafData.comap` of an
ideal sheaf along a morphism is the ideal sheaf generated by the image of `f^*I → O`, and the
product of two ideal sheaves is computed affine-locally as the product of the two ideals
(`Scheme.IdealSheafData.ideal_mul`), which is exactly the image of the tensor product map.

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.complementIdeal`: the vanishing ideal sheaf of the
  complement of an open subset.
* `AlgebraicGeometry.Scheme.IdealSheafData.externalProduct`: the product
  `pr₁^*I · pr₂^*I'` on `X ×_S Y`.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_complementIdeal`: the vanishing locus of
  `complementIdeal U` is `X \ U`.
* `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_externalProduct`: the vanishing locus of
  the product ideal is the union of the preimages of the two vanishing loci.
* `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_externalProduct_eq_compl`: the
  computation `V(J) = X ×_S Y \ U ×_S V` asked for by the proof of Stacks 0FZ0, where
  `U ×_S V` is the open `pr₁⁻¹ U ⊓ pr₂⁻¹ V` of the fibre product.
* `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_externalProduct_pow_eq_compl`: the same
  for every positive power of the product ideal, which is the form in which Stacks 0FZ0 uses it.
* `AlgebraicGeometry.Scheme.IdealSheafData.support_externalProduct_compl` and
  `AlgebraicGeometry.Scheme.IdealSheafData.support_externalProduct_pow_compl`: the same two
  computations read as equalities of opens rather than of sets, which is the form consumed by
  the global-sections clause of [Stacks, Tag 01YB].

## Implementation notes

Everything is a support computation, so it reduces to the two Galois-connection facts
`Scheme.IdealSheafData.support_mul` (the support of a product of ideal sheaves is the union of
the supports) and `Scheme.IdealSheafData.support_comap` (the support of a pullback is the
preimage of the support), both from Mathlib. The complement of an intersection of two opens is
the union of the two complements, which turns the union of preimages into the complement of
`pr₁⁻¹ U ⊓ pr₂⁻¹ V`.

Supports are compared as subsets of the fibre product rather than as elements of `Closeds`,
because one consumer of the computation is the statement that a family of opens of the shape
`pr₁⁻¹ U ⊓ pr₂⁻¹ V` covers the locus where the product ideal does not vanish. The other
consumer takes sections over the complement of the vanishing locus, which is an open rather
than a set, so the set-level computations are restated at that level as well; a complement of
a closed subset has the complement of its underlying set as underlying set by definition, so
the restatement is `TopologicalSpace.Opens.ext` applied to the set-level form.

## References

* [Stacks Project, Tag 0FZ0](https://stacks.math.columbia.edu/tag/0FZ0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y S : Scheme.{u}}

/-- The complement of an open subset of a scheme, as a closed subset. -/
def complAsCloseds (U : X.Opens) : Closeds X :=
  ⟨(U : Set X)ᶜ, U.isOpen.isClosed_compl⟩

/-- The underlying set of `complAsCloseds U` is the complement of `U`. -/
@[simp]
lemma coe_complAsCloseds (U : X.Opens) : (complAsCloseds U : Set X) = (U : Set X)ᶜ := rfl

/-- The ideal sheaf cutting out the complement of an open subset `U`: the vanishing ideal of the
closed set `X \ U`, i.e. the ideal sheaf of the reduced induced closed subscheme structure
on `X \ U`. -/
@[ega "III 2.6.2.5"]
noncomputable def complementIdeal (U : X.Opens) : X.IdealSheafData :=
  vanishingIdeal (complAsCloseds U)

/-- The vanishing locus of the ideal sheaf of the complement of `U` is exactly `X \ U`. -/
@[simp]
lemma coe_support_complementIdeal (U : X.Opens) :
    ((complementIdeal U).support : Set X) = (U : Set X)ᶜ := by
  simp [complementIdeal]

/-- The product ideal sheaf `pr₁^*I · pr₂^*I'` on the fibre product `X ×_S Y`. This is the
ideal sheaf `J = Im(pr₁^*I ⊗ pr₂^*I' → O_{X ×_S Y})` of the proof of Stacks 0FZ0. -/
noncomputable def externalProduct (f : X ⟶ S) (g : Y ⟶ S)
    (I : X.IdealSheafData) (I' : Y.IdealSheafData) : (pullback f g).IdealSheafData :=
  I.comap (pullback.fst f g) * I'.comap (pullback.snd f g)

/-- The vanishing locus of the product ideal sheaf is the union of the preimages of the two
vanishing loci. -/
lemma coe_support_externalProduct (f : X ⟶ S) (g : Y ⟶ S)
    (I : X.IdealSheafData) (I' : Y.IdealSheafData) :
    ((externalProduct f g I I').support : Set ↥(pullback f g)) =
      (pullback.fst f g).base ⁻¹' (I.support : Set X) ∪
        (pullback.snd f g).base ⁻¹' (I'.support : Set Y) := by
  simp [externalProduct]

/-- **The computation `V(J) = X ×_S Y \ U ×_S V`.** If `I` cuts out the complement of `U ⊆ X`
and `I'` cuts out the complement of `V ⊆ Y`, then the product ideal `pr₁^*I · pr₂^*I'` on
`X ×_S Y` cuts out the complement of the open `U ×_S V = pr₁⁻¹ U ⊓ pr₂⁻¹ V`. -/
theorem coe_support_externalProduct_eq_compl (f : X ⟶ S) (g : Y ⟶ S)
    {I : X.IdealSheafData} {I' : Y.IdealSheafData} {U : X.Opens} {V : Y.Opens}
    (hI : (I.support : Set X) = (U : Set X)ᶜ) (hI' : (I'.support : Set Y) = (V : Set Y)ᶜ) :
    ((externalProduct f g I I').support : Set ↥(pullback f g)) =
      ((pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V :
        (pullback f g).Opens) : Set ↥(pullback f g))ᶜ := by
  rw [coe_support_externalProduct, hI, hI', Set.preimage_compl, Set.preimage_compl,
    ← Set.compl_inter]
  rfl

/-- Every positive power of the product ideal sheaf cuts out the same locus: this is the form
`V(J ^ n) = X ×_S Y \ U ×_S V` in which Stacks 0FZ0 uses the computation. -/
theorem coe_support_externalProduct_pow_eq_compl (f : X ⟶ S) (g : Y ⟶ S)
    {I : X.IdealSheafData} {I' : Y.IdealSheafData} {U : X.Opens} {V : Y.Opens}
    (hI : (I.support : Set X) = (U : Set X)ᶜ) (hI' : (I'.support : Set Y) = (V : Set Y)ᶜ)
    {n : ℕ} (hn : n ≠ 0) :
    (((externalProduct f g I I') ^ n).support : Set ↥(pullback f g)) =
      ((pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V :
        (pullback f g).Opens) : Set ↥(pullback f g))ᶜ := by
  rw [support_pow _ _ hn]
  exact coe_support_externalProduct_eq_compl f g hI hI'

/-- The open complement of a closed set whose underlying set is `Wᶜ` is `W`. -/
private theorem compl_eq_of_coe_eq_compl {T : Scheme.{u}} {Z : Closeds T} {W : T.Opens}
    (h : (Z : Set T) = (W : Set T)ᶜ) : Z.compl = W :=
  Opens.ext <| by rw [show (Z.compl : Set T) = (Z : Set T)ᶜ from rfl, h, compl_compl]

/-- **The open complement of `V(J)` is `U ×_S V`.** This is
`coe_support_externalProduct_eq_compl` read as an equality of opens of the fibre product, which
is the form in which the complement of the vanishing locus of an ideal sheaf occurs in the
global-sections clause of [Stacks, Tag 01YB]. -/
theorem support_externalProduct_compl (f : X ⟶ S) (g : Y ⟶ S)
    {I : X.IdealSheafData} {I' : Y.IdealSheafData} {U : X.Opens} {V : Y.Opens}
    (hI : (I.support : Set X) = (U : Set X)ᶜ) (hI' : (I'.support : Set Y) = (V : Set Y)ᶜ) :
    ((externalProduct f g I I').support.compl : (pullback f g).Opens) =
      pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V :=
  compl_eq_of_coe_eq_compl (coe_support_externalProduct_eq_compl f g hI hI')

/-- **The open complement of `V(Jⁿ)` is `U ×_S V`**, for every positive `n`. -/
theorem support_externalProduct_pow_compl (f : X ⟶ S) (g : Y ⟶ S)
    {I : X.IdealSheafData} {I' : Y.IdealSheafData} {U : X.Opens} {V : Y.Opens}
    (hI : (I.support : Set X) = (U : Set X)ᶜ) (hI' : (I'.support : Set Y) = (V : Set Y)ᶜ)
    {n : ℕ} (hn : n ≠ 0) :
    (((externalProduct f g I I') ^ n).support.compl : (pullback f g).Opens) =
      pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V :=
  compl_eq_of_coe_eq_compl (coe_support_externalProduct_pow_eq_compl f g hI hI' hn)

end AlgebraicGeometry.Scheme.IdealSheafData

end
