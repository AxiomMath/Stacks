universe u

noncomputable section

/-- **An element of `Ideal.map f J` is a finite sum `∑ rⱼ f(aⱼ)` with `aⱼ ∈ J`.** -/
theorem Ideal.exists_sum_mul_of_mem_map {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    {J : Ideal R} {x : S} (hx : x ∈ J.map f) :
    ∃ (m : ℕ) (r : Fin m → S) (a : Fin m → R), (∀ j, a j ∈ J) ∧ x = ∑ j, r j * f (a j) := by
  obtain ⟨m, c, g, hsum⟩ := Submodule.mem_span_set'.1 hx
  choose a ha hfa using fun j ↦ (g j).2
  refine ⟨m, c, a, ha, ?_⟩
  rw [← hsum]
  exact Finset.sum_congr rfl fun j _ ↦ by rw [hfa j, smul_eq_mul]

namespace Stacks.AlgebraicGeometry.IdealPullback

variable {Z X : Scheme.{u}} (h : Z ⟶ X)

/-! ### The pushforward of a subsheaf of a sheaf of modules -/

/-- **The pushforward of a subsheaf.** A subsheaf `N` of a sheaf of `𝒪_Z`-modules `M` gives a
subsheaf of `h_* M`, whose sections over an open `U` of `X` are the sections of `N` over
`h⁻¹ U`.

The sections of `h_* M` over `U` *are* the sections of `M` over `h⁻¹ U`, with `Γ(X, U)` acting
through `h^♯`, so no restriction of scalars is needed beyond the one already built into the
pushforward. The locality of the membership condition holds because the inverse images of a
cover of `U` cover `h⁻¹ U`. -/
def pushforwardSubmodule {M : Z.Modules} (N : M.Submodule) :
    ((Scheme.Modules.pushforward h).obj M).Submodule where
  obj U := Submodule.mk (N.toSubmodule.obj (op (h ⁻¹ᵁ U.unop))).toAddSubmonoid (by
    intro c x hx
    exact (N.toSubmodule.obj (op (h ⁻¹ᵁ U.unop))).smul_mem _ hx)
  map {U V} f := by
    intro x hx
    exact N.toSubmodule.map ((Opens.map h.base).map f.unop).op hx
  isSheaf := by
    intro U s hs
    change s ∈ N.toSubmodule.obj (op (h ⁻¹ᵁ U.unop))
    refine N.isSheaf s ?_
    rw [Opens.mem_grothendieckTopology] at hs ⊢
    intro p hp
    obtain ⟨V, k, hk, hpV⟩ := hs (h.base p) hp
    exact ⟨h ⁻¹ᵁ V, (Opens.map h.base).map k, hk, hpV⟩

/-- The sheaf of modules cut out by the pushforward of a subsheaf is the pushforward of the
sheaf of modules cut out by the subsheaf. -/
theorem subMod_pushforwardSubmodule {M : Z.Modules} (N : M.Submodule) :
    subMod (pushforwardSubmodule h N) = (Scheme.Modules.pushforward h).obj (subMod N) := rfl

/-! ### The comparison morphism `h^*(Iⁿ) ⟶ (h⁻¹I)ⁿ` -/

/-- `h^♯` as a morphism of `𝒪_X`-modules `𝒪_X ⟶ h_* 𝒪_Z`. -/
def structureToPushforward :
    structureModule X ⟶ (Scheme.Modules.pushforward h).obj (structureModule Z) :=
  SheafOfModules.unitToPushforwardObjUnit h.toRingCatSheafHom

/-- On sections, `𝒪_X ⟶ h_* 𝒪_Z` is `h^♯`. -/
theorem structureToPushforward_app (U : X.Opens) (a : Γ(X, U)) :
    (structureToPushforward h).app U a = h.app U a := rfl

variable (I : X.IdealSheafData) (n : ℕ)

/-- The composition `Iⁿ ⟶ 𝒪_X ⟶ h_* 𝒪_Z`. -/
def idealPowToPushforwardStructure :
    idealPow I n ⟶ (Scheme.Modules.pushforward h).obj (structureModule Z) :=
  (idealPowerMultiple I n (structureModule X)).ι ≫ structureToPushforward h

/-- On sections, `Iⁿ ⟶ h_* 𝒪_Z` sends a section `a` of `Iⁿ` to `h^♯(a)`. -/
theorem idealPowToPushforwardStructure_app (U : X.Opens) (x : Γ(idealPow I n, U)) :
    (idealPowToPushforwardStructure h I n).app U x = h.app U (x.1 : Γ(X, U)) :=
  structureToPushforward_app h U (x.1 : Γ(X, U))

/-- On affine opens, the `n`-th power of the ideal of `h⁻¹I` is the extension of the `n`-th power of
the ideal of `I`. -/
private theorem ideal_comap_pow_eq_map (I : X.IdealSheafData) (n : ℕ) (U : X.affineOpens)
    (W : Z.affineOpens) (hW : W.1 ≤ h ⁻¹ᵁ U.1) :
    (I.comap h).ideal W ^ n = Ideal.map (h.appLE U.1 W.1 hW).hom (I.ideal U ^ n) := by
  rw [Ideal.map_pow, Scheme.IdealSheafData.ideal_comap_of_isAffineOpen I h U W hW]

/-- **`h^♯` carries `Iⁿ` into `(h⁻¹I)ⁿ`.** The containment is checked on an affine open `W` of
`Z` contained in the inverse image of an affine open `U` of `X`, where the ideal of `h⁻¹I` is
generated by the image of the ideal of `I` on `U`. -/
theorem app_mem_pushforwardSubmodule (U : X.affineOpens) (x : Γ(idealPow I n, U.1)) :
    (idealPowToPushforwardStructure h I n).app U.1 x ∈
      (pushforwardSubmodule h
        (idealPowerMultiple (I.comap h) n (structureModule Z))).toSubmodule.obj (op U.1) := by
  show h.app U.1 (x.1 : Γ(X, U.1)) ∈
    (idealPowerMultiple (I.comap h) n (structureModule Z)).toSubmodule.obj (op (h ⁻¹ᵁ U.1))
  refine mem_of_forall_affineOpens _ _ fun W hW ↦ ?_
  have key : (h.appLE U.1 W.1 hW) (x.1 : Γ(X, U.1)) ∈
      (idealPowerMultiple (I.comap h) n (structureModule Z)).toSubmodule.obj (op W.1) := by
    refine (obj_idealPow_affineOpen (I.comap h) n W).ge ?_
    exact (ideal_comap_pow_eq_map h I n U W hW).ge
      (Ideal.mem_map_of_mem _ ((obj_idealPow_affineOpen I n U).le x.2))
  exact key

/-- **The adjoint transpose `Iⁿ ⟶ h_*((h⁻¹I)ⁿ)`** of the comparison morphism. -/
def idealPowToPushforward :
    idealPow I n ⟶ (Scheme.Modules.pushforward h).obj (idealPow (I.comap h) n) :=
  factorThruOfForallAffineOpens
    (pushforwardSubmodule h (idealPowerMultiple (I.comap h) n (structureModule Z)))
    (idealPowToPushforwardStructure h I n) (app_mem_pushforwardSubmodule h I n)

/-- The transpose does not change the value of a section: as a section of the structure sheaf
of `Z` it is `h^♯` of the given section. -/
theorem val_idealPowToPushforward_app (U : X.Opens) (x : Γ(idealPow I n, U)) :
    (((idealPowToPushforward h I n).app U x).1 : Γ(structureModule Z, h ⁻¹ᵁ U)) =
      h.app U (x.1 : Γ(X, U)) :=
  (val_factorThruOfForallAffineOpens_app _ _ _ U x).trans
    (idealPowToPushforwardStructure_app h I n U x)

/-- **The comparison morphism `h^*(Iⁿ) ⟶ (h⁻¹I)ⁿ`**, the adjoint of
`idealPowToPushforward`. -/
def pullbackIdealPow :
    (Scheme.Modules.pullback h).obj (idealPow I n) ⟶ idealPow (I.comap h) n :=
  ((Scheme.Modules.pullbackPushforwardAdjunction h).homEquiv _ _).symm
    (idealPowToPushforward h I n)

/-- The transpose of the comparison morphism is `idealPowToPushforward`, written out as the
triangle identity of the adjunction. -/
theorem unit_comp_pushforward_map_pullbackIdealPow :
    (Scheme.Modules.pullbackPushforwardAdjunction h).unit.app (idealPow I n) ≫
        (Scheme.Modules.pushforward h).map (pullbackIdealPow h I n) =
      idealPowToPushforward h I n :=
  ((Scheme.Modules.pullbackPushforwardAdjunction h).homEquiv_unit _ _
    (pullbackIdealPow h I n)).symm.trans (Equiv.apply_symm_apply _ _)

/-- **The comparison morphism on the sections supplied by the unit of the adjunction.** -/
theorem pullbackIdealPow_app_unit (U : X.Opens) (x : Γ(idealPow I n, U)) :
    (pullbackIdealPow h I n).app (h ⁻¹ᵁ U)
        (((Scheme.Modules.pullbackPushforwardAdjunction h).unit.app (idealPow I n)).app U x) =
      (idealPowToPushforward h I n).app U x :=
  congr($(unit_comp_pushforward_map_pullbackIdealPow h I n).app U x)

/-- The comparison morphism followed by the inclusion of `(h⁻¹I)ⁿ` into the structure sheaf. -/
def pullbackIdealPowToStructure :
    (Scheme.Modules.pullback h).obj (idealPow I n) ⟶ structureModule Z :=
  pullbackIdealPow h I n ≫ (idealPowerMultiple (I.comap h) n (structureModule Z)).ι

/-- The comparison morphism does not change the value of a section. -/
theorem val_pullbackIdealPow_app (V : Z.Opens)
    (z : Γ((Scheme.Modules.pullback h).obj (idealPow I n), V)) :
    (((pullbackIdealPow h I n).app V z).1 : Γ(structureModule Z, V)) =
      (pullbackIdealPowToStructure h I n).app V z := rfl

/-- The value of the comparison morphism on a section supplied by the unit of the adjunction is
`h^♯` of the given section of `Iⁿ`. -/
theorem pullbackIdealPowToStructure_app_unit (U : X.Opens) (x : Γ(idealPow I n, U)) :
    (pullbackIdealPowToStructure h I n).app (h ⁻¹ᵁ U)
        (((Scheme.Modules.pullbackPushforwardAdjunction h).unit.app (idealPow I n)).app U x) =
      h.app U (x.1 : Γ(X, U)) :=
  (congrArg (fun y ↦ (y.1 : Γ(structureModule Z, h ⁻¹ᵁ U)))
      (pullbackIdealPow_app_unit h I n U x)).trans (val_idealPowToPushforward_app h I n U x)

/-- **A section of `(h⁻¹I)ⁿ` over an affine open is a finite sum `∑ rⱼ h^♯(aⱼ)`** with each
`aⱼ` a section of `Iⁿ` over an affine open `U` of `X` whose inverse image contains it. -/
theorem exists_sum_mul_appLE (U : X.affineOpens) (W : Z.affineOpens) (hWU : W.1 ≤ h ⁻¹ᵁ U.1)
    (y : Γ(Z, W.1))
    (hy : y ∈ (idealPowerMultiple (I.comap h) n (structureModule Z)).toSubmodule.obj (op W.1)) :
    ∃ (m : ℕ) (r : Fin m → Γ(Z, W.1)) (a : Fin m → Γ(X, U.1)),
      (∀ j, a j ∈ (idealPowerMultiple I n (structureModule X)).toSubmodule.obj (op U.1)) ∧
        y = ∑ j, r j * (h.appLE U.1 W.1 hWU) (a j) := by
  have hmem : y ∈ Ideal.map (h.appLE U.1 W.1 hWU).hom (I.ideal U ^ n) := by
    rw [← ideal_comap_pow_eq_map h I n U W hWU]
    exact (obj_idealPow_affineOpen (I.comap h) n W).le hy
  obtain ⟨m, r, a, ha, hsum⟩ := Ideal.exists_sum_mul_of_mem_map _ hmem
  exact ⟨m, r, a, fun j ↦ (obj_idealPow_affineOpen I n U).ge (ha j), hsum⟩

/-- **The comparison morphism `h^*(Iⁿ) ⟶ (h⁻¹I)ⁿ` is an epimorphism.** Every section of
`(h⁻¹I)ⁿ` is, on an affine open `W` of `Z` inside the inverse image of an affine open `U` of
`X`, a finite sum `∑ rⱼ h^♯(aⱼ)` with `aⱼ` a section of `Iⁿ` over `U`, hence the image of
`∑ rⱼ · η(aⱼ)|_W` for `η` the unit of the adjunction. -/
theorem epi_pullbackIdealPow : Epi (pullbackIdealPow h I n) := by
  have hepi : @Epi (SheafOfModules Z.ringCatSheaf) _ _ _ (pullbackIdealPow h I n) := by
    refine Stacks.SheafOfModules.StalkEpiMono.epi_of_exists_sections _ fun V t p hp ↦ ?_
    obtain ⟨-, ⟨U, hUaff, rfl⟩, hpU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (h.base p)) isOpen_univ
    have hpU' : p ∈ h ⁻¹ᵁ U := hpU
    obtain ⟨-, ⟨W, hWaff, rfl⟩, hpW, hWsub⟩ :=
      Z.isBasis_affineOpens.exists_subset_of_mem_open
        (show p ∈ ((V ⊓ h ⁻¹ᵁ U : Z.Opens) : Set Z) from ⟨hp, hpU'⟩) (V ⊓ h ⁻¹ᵁ U).isOpen
    have hWV : W ≤ V := fun q hq ↦ (hWsub hq).1
    have hWU : W ≤ h ⁻¹ᵁ U := fun q hq ↦ (hWsub hq).2
    obtain ⟨m, r, a, ha, hsum⟩ := exists_sum_mul_appLE h I n ⟨U, hUaff⟩ ⟨W, hWaff⟩ hWU
      ((idealPow (I.comap h) n).val.map (homOfLE hWV).op t).1
      ((idealPow (I.comap h) n).val.map (homOfLE hWV).op t).2
    obtain ⟨s, hs⟩ : ∃ s : Fin m → Γ((Scheme.Modules.pullback h).obj (idealPow I n), W),
        ∀ j, (pullbackIdealPowToStructure h I n).app W (s j) = (h.appLE U W hWU) (a j) :=
      ⟨fun j ↦ ((Scheme.Modules.pullback h).obj (idealPow I n)).presheaf.map (homOfLE hWU).op
          (((Scheme.Modules.pullbackPushforwardAdjunction h).unit.app (idealPow I n)).app U
            ⟨a j, ha j⟩), fun j ↦
        (app_naturality (pullbackIdealPowToStructure h I n) hWU _).symm.trans
          (congrArg (ConcreteCategory.hom ((structureModule Z).presheaf.map (homOfLE hWU).op))
            (pullbackIdealPowToStructure_app_unit h I n U ⟨a j, ha j⟩))⟩
    refine ⟨W, hWV, hpW, ∑ j, r j • s j, Subtype.ext ?_⟩
    refine (val_pullbackIdealPow_app h I n W _).trans (Eq.trans ?_ hsum.symm)
    refine (map_sum (ConcreteCategory.hom ((pullbackIdealPowToStructure h I n).app W)) _ _).trans ?_
    exact Finset.sum_congr rfl fun j _ ↦
      (Scheme.Modules.Hom.app_smul _ (r j) _).trans (congrArg (r j • ·) (hs j))
  exact ⟨fun g₁ g₂ hg ↦ hepi.left_cancellation g₁ g₂ hg⟩

/-- **The pullback of `Iⁿ` surjects onto `(h⁻¹I)ⁿ`.** -/
theorem exists_epi_pullback_idealPow :
    ∃ e : (Scheme.Modules.pullback h).obj (idealPow I n) ⟶ idealPow (I.comap h) n, Epi e :=
  ⟨pullbackIdealPow h I n, epi_pullbackIdealPow h I n⟩

/-! ### The surjection onto a power of the product ideal sheaf of a fibre product -/

variable {Y S : Scheme.{u}}

/-- **The morphism `pr₁^*(𝓘ⁿ) ⊗ pr₂^*(𝓘'ⁿ) ⟶ 𝓙ⁿ`** onto a power of the product ideal sheaf
`𝓙 = pr₁^*𝓘 · pr₂^*𝓘'` of a fibre product: the external tensor product of the two comparison
morphisms, followed by multiplication of sections. -/
def externalTensorIdealPowMul (f : X ⟶ S) (g : Y ⟶ S)
    (I : X.IdealSheafData) (I' : Y.IdealSheafData) (n : ℕ) :
    externalTensorProduct f g (idealPow I n) (idealPow I' n) ⟶
      idealPow (Scheme.IdealSheafData.externalProduct f g I I') n :=
  idealPowMulOfHom (I.comap (pullback.fst f g)) (I'.comap (pullback.snd f g)) n
    (pullbackIdealPow (pullback.fst f g) I n) (pullbackIdealPow (pullback.snd f g) I' n)

/-- **The morphism `pr₁^*(𝓘ⁿ) ⊗ pr₂^*(𝓘'ⁿ) ⟶ 𝓙ⁿ` is an epimorphism.** The two comparison
morphisms are epimorphisms by `epi_pullbackIdealPow`, and multiplication along a pair of
epimorphisms is an epimorphism by `Stacks.AlgebraicGeometry.IdealProduct.epi_idealPowMulOfHom`. -/
theorem epi_externalTensorIdealPowMul (f : X ⟶ S) (g : Y ⟶ S)
    (I : X.IdealSheafData) (I' : Y.IdealSheafData) (n : ℕ) :
    Epi (externalTensorIdealPowMul f g I I' n) :=
  epi_idealPowMulOfHom _ _ n _ _ (epi_pullbackIdealPow _ _ _) (epi_pullbackIdealPow _ _ _)

end Stacks.AlgebraicGeometry.IdealPullback

