module

public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.SheafExtVanishingOn
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.CoherenceClosure
public import StacksFrontier.AlgebraicGeometry.PseudoCoherentSites.IteratedSliceFiniteType
public import StacksFrontier.CategoryTheory.Sites.Topos.LocalizedSpecialCocontinuous

/-!
# A syzygy of a coherent module near a point

Let `(X, 𝒪_X)` be a ringed space whose structure sheaf is coherent, let `A` be an `𝒪_X`-module
which is coherent on an open `W`, and let `y ∈ W`. Near `y` the module `A` is generated by
finitely many sections over an open `U ∋ y`. Extending the corresponding free module by zero
outside `U` gives an `𝒪_X`-module `P ⊆ 𝒪_X^{⊕ ι}`, equal to `𝒪_X^{⊕ ι}` on `U`, with a morphism
`π : P ⟶ A` which is surjective on `U`; its kernel is again coherent on `U`. This is the step
that builds, near a point, a resolution of a coherent module by free ones, carried out with
modules on the whole of `X`.

## Main results

* `Stacks.SheafHomInjective.exists_epi_free_over_of_isFiniteType`: generating sections of a
  module of finite type on a neighbourhood of a point.
* `Stacks.SheafHomInjective.exists_syzygy`: the syzygy step.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.SheafHomInjective

variable {X : Type u} [TopologicalSpace X]
    {O : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}

/-- **Generating sections near a point.** If `A|_W` is of finite type and `y ∈ W`, then `A` is
generated by finitely many sections over some open `U` with `y ∈ U ⊆ W`. -/
theorem exists_epi_free_over_of_isFiniteType
    {A : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)} {W : Opens X}
    (hA : (A.over W).IsFiniteType) {y : X} (hy : y ∈ W) :
    ∃ (U : Opens X) (_ : y ∈ U) (_ : U ≤ W) (ι : Type u) (_ : Finite ι)
      (φ : SheafOfModules.free (R := (Stacks.SheafOfModules.Tensor.ringSheaf O).over U) ι ⟶
        A.over U), Epi φ := by
  obtain ⟨σ, hσ⟩ := hA.exists_localGeneratorsData
  have hcov := Stacks.LocalizedDenseSubsite.ofArrows_mem_of_coversTop_over
    (Opens.grothendieckTopology X) W σ.X σ.coversTop
  obtain ⟨V, f, hf, hyV⟩ := (Opens.mem_grothendieckTopology _).1 hcov y hy
  obtain ⟨i, g, -⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hf
  obtain ⟨τ, hτ⟩ := (Stacks.SheafOfModules.exists_isFiniteType_generatingSections_over_over_iff
    (R := Stacks.SheafOfModules.Tensor.ringSheaf O) A W (σ.X i)).1
      ⟨σ.generators i, hσ.isFiniteType i⟩
  exact ⟨(σ.X i).left, leOfHom g hyV, leOfHom (σ.X i).hom, τ.I, hτ.finite,
    (A.over (σ.X i).left).freeHomEquiv.symm τ.s, τ.epi⟩

/-- The restriction to `U` of the free module on `ι` is the free module on `ι` over the slice
site: restriction is a left adjoint, so it preserves the coproduct defining a free module. -/
def overFreeIso (U : Opens X) (ι : Type u) :
    (SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf O) ι).over U ≅
      SheafOfModules.free (R := (Stacks.SheafOfModules.Tensor.ringSheaf O).over U) ι := by
  let Q := SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O) U
  letI : Q.IsLeftAdjoint :=
    (SheafOfModules.overPushforwardOverAdj
      (R := Stacks.SheafOfModules.Tensor.ringSheaf O) U).isLeftAdjoint
  letI hpres : PreservesColimitsOfShape (Discrete ι) Q :=
    (Adjunction.ofIsLeftAdjoint Q).leftAdjoint_preservesColimits.preservesColimitsOfShape
  exact (@SheafOfModules.mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _ Q ι hpres (Iso.refl _)).symm

/-- A morphism of modules whose restriction to `U` is an isomorphism has cokernel vanishing on
`U`. -/
theorem vanishesOn_cokernel_of_epi_over
    {E E' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)} (f : E ⟶ E')
    {U : Opens X} (hf : Epi (f.over U)) : VanishesOn (cokernel f) U := by
  apply vanishesOn_of_isZero_over
  let Q := SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O) U
  exact (isZero_cokernel_of_epi (Q.map f)).of_iso (PreservesCokernel.iso Q f)

/-- **A morphism on `U` out of a free module, extended by zero.** For `φ : 𝒪^{⊕ ι}|_U ⟶ A|_U`
there are a module `P`, a monomorphism `i : P ⟶ 𝒪_X^{⊕ ι}` which is an isomorphism on `U`, and a
morphism `π : P ⟶ A` whose restriction to `U` is `φ` read through `i`. -/
theorem exists_supported_lift (U : Opens X) (ι : Type u)
    {A : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)}
    (φ : (SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf O) ι).over U ⟶
      A.over U) :
    ∃ (P : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O))
      (i : P ⟶ SheafOfModules.free ι) (π : P ⟶ A),
      Mono i ∧ VanishesOn (cokernel i) U ∧ IsIso (i.over U) ∧ π.over U = i.over U ≫ φ := by
  let F := SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf O) ι
  let N := Stacks.Cohomology.InjectiveRestriction.supportedSubmodule F U
  let i : N.toSheafOfModules ⟶ F := N.ι
  let π : N.toSheafOfModules ⟶ A :=
    Stacks.SupportedExtension.supportedMap φ ≫
      (Stacks.Cohomology.InjectiveRestriction.supportedSubmodule A U).ι
  have hiU : Epi (i.over U) := by
    apply SheafOfModules.epi_of_sectionwise_surjective
    intro Z s
    exact ⟨⟨s, (Stacks.Cohomology.InjectiveRestriction.mem_supportedSubmodule_iff F U s).2
      fun _ hx hxU => (hxU (leOfHom Z.unop.hom hx)).elim⟩, rfl⟩
  have hπU : π.over U = i.over U ≫ φ := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro Z
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro s
    exact Stacks.SupportedExtension.supportedMap_apply φ (leOfHom Z.unop.hom) s
  exact ⟨N.toSheafOfModules, i, π, inferInstance, vanishesOn_cokernel_of_epi_over i hiU,
    isIso_of_mono_of_epi _, hπU⟩

/-- **The syzygy step near a point.** Let `A` be coherent on `W` and `y ∈ W`. There are an open
`U` with `y ∈ U ⊆ W`, a finite type `ι`, a module `P` with a monomorphism `P ⟶ 𝒪_X^{⊕ ι}`
which is an isomorphism on `U`, and a morphism `π : P ⟶ A` which is an epimorphism on `U` and
whose kernel is coherent on `U`. -/
theorem exists_syzygy
    [hO : Stacks.SheafOfModules.IsCoherent
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O))]
    {A : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)} {W : Opens X}
    (hA : Stacks.SheafOfModules.IsCoherentOn A W) {y : X} (hy : y ∈ W) :
    ∃ (U : Opens X) (_ : y ∈ U) (_ : U ≤ W) (ι : Type u) (_ : Finite ι)
      (P : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O))
      (i : P ⟶ SheafOfModules.free ι) (π : P ⟶ A),
      Mono i ∧ VanishesOn (cokernel i) U ∧ VanishesOn (cokernel π) U ∧
        Stacks.SheafOfModules.IsCoherentOn (kernel π) U := by
  obtain ⟨U, hyU, hUW, ι, hι, φ, hφ⟩ := exists_epi_free_over_of_isFiniteType (hA W le_rfl).1 hy
  let F := SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf O) ι
  let φ' : F.over U ⟶ A.over U := (overFreeIso U ι).hom ≫ φ
  obtain ⟨P, i, π, hmono, hci, hiUi, hπU⟩ := exists_supported_lift U ι φ'
  have hφ' : Epi φ' := epi_comp _ _
  have hπUe : Epi (π.over U) := by
    rw [hπU]
    exact epi_comp _ _
  refine ⟨U, hyU, hUW, ι, hι, P, i, π, hmono, hci,
    vanishesOn_cokernel_of_epi_over π hπUe, ?_⟩
  -- the kernel of `π` is coherent on `U`
  have hF : Stacks.SheafOfModules.IsCoherent F :=
    Stacks.SheafOfModules.isCoherent_sigma (fun _ : ι => SheafOfModules.unit _) (fun _ => hO)
  have hker : (kernel φ).IsFiniteType := (hA U hUW).2 _ (SheafOfModules.free.generatingSections ι)
    hι φ
  let Q := SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O) U
  let e₁ : (kernel π).over U ≅ kernel (π.over U) := PreservesKernel.iso Q π
  let e₂ : kernel (π.over U) ≅ kernel φ :=
    kernelIsoOfEq hπU ≪≫ kernelIsIsoComp (i.over U) φ' ≪≫
      kernelIsIsoComp (overFreeIso U ι).hom φ
  have hft : ((kernel π).over U).IsFiniteType :=
    Stacks.SheafOfModules.isFiniteType_of_iso (e₁ ≪≫ e₂).symm
  exact Stacks.SheafOfModules.isCoherentOn_of_mono hft ((kernel.ι π ≫ i).over U)

/-! ### Transferring the vanishing of sheaf Ext's along the syzygy sequence -/

section Transfer

variable {G : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)}
  (Res : InjectiveResolution G)

/-- A submodule of a finite free module which equals it on `U` has vanishing higher `𝓔xt`'s on
`U`. -/
theorem vanishesOn_homology_of_mono_free
    {P : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)} {ι : Type u} [Finite ι]
    (i : P ⟶ SheafOfModules.free ι) [Mono i] {U : Opens X} (hc : VanishesOn (cokernel i) U)
    (q : ℕ) : VanishesOn ((cx O P Res.cocomplex).homology (q + 1)) U := by
  let S := ShortComplex.mk i (cokernel.π i) (cokernel.condition i)
  have hS : S.ShortExact := { exact := ShortComplex.exact_cokernel i }
  exact vanishesOn_homology_X₁_of_shortExact hS Res.cocomplex (q + 1)
    (vanishesOn_of_isZero (isZero_homology_cx_free ι Res q) U)
    (vanishesOn_homology_cx_of_vanishesOn hc _ _)

/-- **Dimension shifting.** For `π : P ⟶ A` with cokernel vanishing on `U`, the vanishing of
`𝓔xt^{q+1}(P, G)` and of `𝓔xt^q(ker π, G)` on `U` gives the vanishing of `𝓔xt^{q+1}(A, G)` on
`U`. -/
theorem vanishesOn_homology_succ_of_cokernel
    {P A : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)} (π : P ⟶ A)
    {U : Opens X} (q : ℕ) (hc : VanishesOn (cokernel π) U)
    (hP : VanishesOn ((cx O P Res.cocomplex).homology (q + 1)) U)
    (hK : VanishesOn ((cx O (kernel π) Res.cocomplex).homology q) U) :
    VanishesOn ((cx O A Res.cocomplex).homology (q + 1)) U := by
  have hz : kernel.ι π ≫ Abelian.factorThruImage π = 0 := by
    rw [← cancel_mono (Abelian.image.ι π), Category.assoc, Abelian.image.fac, kernel.condition,
      zero_comp]
  let S₁ := ShortComplex.mk (kernel.ι π) (Abelian.factorThruImage π) hz
  have hS₁ : S₁.ShortExact := by
    let S₀ := ShortComplex.mk (kernel.ι π) π (kernel.condition π)
    have hS₀ : S₀.Exact := ShortComplex.exact_kernel π
    let φ : S₁ ⟶ S₀ :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := Abelian.image.ι π
        comm₁₂ := by simp [S₁, S₀]
        comm₂₃ := by simp [S₁, S₀] }
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 hS₀)
      inferInstance inferInstance
  let S₂ := ShortComplex.mk (Abelian.image.ι π) (cokernel.π π) (kernel.condition _)
  have hS₂ : S₂.ShortExact := { exact := ShortComplex.exact_kernel (cokernel.π π) }
  exact vanishesOn_homology_X₂_of_shortExact hS₂ Res.cocomplex (q + 1)
    (vanishesOn_homology_cx_of_vanishesOn hc _ _)
    (vanishesOn_homology_X₃_succ_of_shortExact hS₁ Res.cocomplex q hK hP)

/-- **`𝓔xt^{q+1}(A, G)` vanishes where `A` is free.** -/
theorem vanishesOn_homology_of_over_iso_free
    {A : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)} {U : Opens X}
    {ρ : Type u} [Finite ρ]
    (e : A.over U ≅ SheafOfModules.free (R := (Stacks.SheafOfModules.Tensor.ringSheaf O).over U) ρ)
    (q : ℕ) : VanishesOn ((cx O A Res.cocomplex).homology (q + 1)) U := by
  obtain ⟨P, i, π, hmono, hci, hiUi, hπU⟩ :=
    exists_supported_lift U ρ ((overFreeIso U ρ).hom ≫ e.inv)
  have hπiso : IsIso (π.over U) := by
    rw [hπU]
    infer_instance
  let Q := SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O) U
  have hk : VanishesOn (kernel π) U := vanishesOn_of_isZero_over
    ((isZero_kernel_of_mono (Q.map π)).of_iso (PreservesKernel.iso Q π))
  exact vanishesOn_homology_succ_of_cokernel Res π q
    (vanishesOn_cokernel_of_epi_over π inferInstance)
    (vanishesOn_homology_of_mono_free Res i hci q)
    (vanishesOn_homology_cx_of_vanishesOn hk _ _)

end Transfer

end Stacks.SheafHomInjective

end
