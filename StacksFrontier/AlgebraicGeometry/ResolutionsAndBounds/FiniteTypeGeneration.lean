/-!
# Finite type submodules generated by finitely many sections

A module on a scheme generated by a family of global sections is the filtered union of the
submodules generated by the finite subfamilies. On a quasi-compact open over which the module is of
finite type, one of those finite subfamilies already generates it.

On an affine scheme every quasi-coherent module is generated by its global sections, so a
quasi-coherent module on an affine scheme whose restriction to a quasi-compact open `W` is of
finite type has a finite type quasi-coherent submodule which agrees with it on `W`.

## Main definitions

* `AlgebraicGeometry.Scheme.Modules.freeOn` and `AlgebraicGeometry.Scheme.Modules.unitOn` are the
  free module on a type and the structure sheaf, read in the category of modules on a scheme,
  with `freeOnMap`, `ιFreeOn`, `freeOnDesc` and `unitOnDesc` for their maps.
* `AlgebraicGeometry.generatedSubobject` is the submodule generated by a finite subfamily of a
  family of generating sections, and `AlgebraicGeometry.generatedSubobjectCocone` the cocone
  these submodules form over the ambient module.
* `AlgebraicGeometry.generatingSectionsOfIsAffine`: a quasi-coherent module on an affine scheme
  is generated by its global sections.

## Main results

* `AlgebraicGeometry.iSup_generatedSubobject`: the submodules generated by the finite subfamilies
  cover the module, and `AlgebraicGeometry.isColimit_generatedSubobjectCocone`: their cocone is a
  colimit cocone.
* `AlgebraicGeometry.exists_generatedSubobject_restrict_isIso`: over a quasi-compact open on
  which the module is of finite type, one finite subfamily already generates it.
* `AlgebraicGeometry.exists_finiteTypeSubobject_isIso_app_of_isAffine`: the affine case of
  Stacks 01PF.
* `AlgebraicGeometry.isFiniteType_of_iso_modules`: finite type transports along an isomorphism.

## References

* [Stacks Project, Tag 01BB](https://stacks.math.columbia.edu/tag/01BB)
* [Stacks Project, Tag 01PF](https://stacks.math.columbia.edu/tag/01PF)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace SheafOfModules

universe u v₁ u₁

namespace SheafOfModules

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- The maps of free sheaves of modules induced by maps of index types compose. -/
lemma freeMap_comp {I I' I'' : Type u} (f : I → I') (g : I' → I'') :
    freeMap (R := R) f ≫ freeMap g = freeMap (g ∘ f) := by
  apply (freeHomEquiv _).injective
  funext i
  simp [freeHomEquiv_comp_apply]

end SheafOfModules

namespace AlgebraicGeometry.Scheme.Modules

variable {Y : Scheme.{u}}

/-- The free module on a type, as a module on the scheme. -/
noncomputable def freeOn (Y : Scheme.{u}) (I : Type u) : Y.Modules := free (R := Y.ringCatSheaf) I

/-- The structure sheaf, as a module on the scheme. -/
noncomputable def unitOn (Y : Scheme.{u}) : Y.Modules := unit Y.ringCatSheaf

/-- A free module on a scheme is quasi-coherent. -/
instance freeOn_isQuasicoherent (I : Type u) : (freeOn Y I).IsQuasicoherent :=
  inferInstanceAs ((free (R := Y.ringCatSheaf) I).IsQuasicoherent)

/-- The free module on a finite index type is of finite type. -/
instance freeOn_isFiniteType (I : Type u) [Finite I] : (freeOn Y I).IsFiniteType := by
  have hgs : Finite (free.generatingSections (R := Y.ringCatSheaf) I).I :=
    inferInstanceAs (Finite I)
  exact Stacks.AlgebraicGeometry.CoherentTFAE.isFiniteType_of_generatingSections
    (M := (free (R := Y.ringCatSheaf) I)) (free.generatingSections (R := Y.ringCatSheaf) I)

/-- The map of free modules induced by a map of index types. -/
noncomputable def freeOnMap {I I' : Type u} (f : I → I') : freeOn Y I ⟶ freeOn Y I' := freeMap f

/-- The inclusion of the `i`-th summand of a free module. -/
noncomputable def ιFreeOn {I : Type u} (i : I) : unitOn Y ⟶ freeOn Y I := ιFree i

/-- The map out of a free module given by a family of sections. -/
noncomputable def freeOnDesc {N : Y.Modules} {I : Type u} (t : I → N.sections) :
    freeOn Y I ⟶ N := (freeHomEquiv N).symm t

/-- The map out of the structure sheaf given by a section. -/
noncomputable def unitOnDesc {N : Y.Modules} (s : N.sections) : unitOn Y ⟶ N :=
  N.unitHomEquiv.symm s

/-- The maps of free modules induced by maps of index types compose. -/
lemma freeOnMap_comp {I I' I'' : Type u} (f : I → I') (g : I' → I'') :
    (freeOnMap f : freeOn Y I ⟶ _) ≫ freeOnMap g = freeOnMap (g ∘ f) :=
  freeMap_comp f g

/-- The map of free modules induced by `f` sends the `i`-th summand to the `f i`-th summand. -/
lemma ιFreeOn_freeOnMap {I I' : Type u} (f : I → I') (i : I) :
    (ιFreeOn i : unitOn Y ⟶ _) ≫ freeOnMap f = ιFreeOn (f i) :=
  ιFree_freeMap f i

/-- Composing the map given by a family of sections with `p` gives the map given by the images of
the sections under `p`. -/
lemma freeOnDesc_comp {N P : Y.Modules} {I : Type u} (t : I → N.sections) (p : N ⟶ P) :
    freeOnDesc t ≫ p = freeOnDesc (fun i => sectionsMap p (t i)) :=
  freeHomEquiv_symm_comp t p

/-- The map given by a family of sections `t` restricts on the `i`-th summand to the map given by
`t i`. -/
lemma ιFreeOn_freeOnDesc {N : Y.Modules} {I : Type u} (t : I → N.sections) (i : I) :
    (ιFreeOn i : unitOn Y ⟶ _) ≫ freeOnDesc t = unitOnDesc (t i) := by
  refine Eq.trans ?_ (congrArg N.unitHomEquiv.symm (sectionsMap_freeHomEquiv_symm_freeSection t i))
  exact (unitHomEquiv_symm_freeHomEquiv_apply (freeOnDesc t) i).symm

/-- Composing the map given by a section with `p` gives the map given by its image under `p`. -/
lemma unitOnDesc_comp {N P : Y.Modules} (s : N.sections) (p : N ⟶ P) :
    unitOnDesc s ≫ p = unitOnDesc (sectionsMap p s) :=
  unitHomEquiv_symm_comp s p

end AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry

open AlgebraicGeometry.Scheme.Modules

variable {Y : Scheme.{u}} {M : Y.Modules} (σ : M.GeneratingSections)

/-- The epimorphism from the free module on the index type of a family of generating sections. -/
noncomputable def generatingSectionsDesc : freeOn Y σ.I ⟶ M := freeOnDesc σ.s

/-- The map from the free module on a family of generating sections is an epimorphism. -/
instance epi_generatingSectionsDesc : Epi (generatingSectionsDesc σ) := σ.epi

/-- The morphism from the free module on a finite subfamily of the generating sections. -/
noncomputable def generatedSubobjectHom (J : Finset σ.I) : freeOn Y (↥J) ⟶ M :=
  freeOnMap Subtype.val ≫ generatingSectionsDesc σ

/-- The submodule generated by a finite subfamily of the generating sections. -/
noncomputable def generatedSubobject (J : Finset σ.I) : Subobject M :=
  imageSubobject (generatedSubobjectHom σ J)

/-- The morphism from the free module on a finite subfamily has an image. -/
instance hasImage_generatedSubobjectHom (J : Finset σ.I) :
    HasImage (generatedSubobjectHom σ J) := inferInstance

/-- For `J ≤ J'`, the morphism from the free module on `J` factors through the one on `J'`. -/
lemma generatedSubobjectHom_factor {J J' : Finset σ.I} (h : J ≤ J') :
    (freeOnMap (fun x : ↥J => (⟨x.1, h x.2⟩ : ↥J')) : freeOn Y (↥J) ⟶ _) ≫
      generatedSubobjectHom σ J' = generatedSubobjectHom σ J :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ generatingSectionsDesc σ) (freeOnMap_comp _ _))

/-- The submodule generated by a finite subfamily is monotone in the subfamily. -/
lemma generatedSubobject_monotone : Monotone (generatedSubobject σ) := by
  intro J J' h
  refine imageSubobject_le (generatedSubobjectHom σ J)
    (freeOnMap (fun x : ↥J => (⟨x.1, h x.2⟩ : ↥J')) ≫
      factorThruImageSubobject (generatedSubobjectHom σ J')) ?_
  exact (Category.assoc _ _ _).trans
    ((congrArg _ (imageSubobject_arrow_comp _)).trans (generatedSubobjectHom_factor σ h))

/-- The submodule generated by a finite subfamily is of finite type. -/
lemma generatedSubobject_isFiniteType (J : Finset σ.I) :
    ((generatedSubobject σ J : Y.Modules)).IsFiniteType :=
  imageSubobject_isFiniteType (generatedSubobjectHom σ J)

/-- The submodule of a quasi-coherent module generated by a finite subfamily is quasi-coherent. -/
lemma generatedSubobject_isQuasicoherent [M.IsQuasicoherent] (J : Finset σ.I) :
    ((generatedSubobject σ J : Y.Modules)).IsQuasicoherent :=
  imageSubobject_isQuasicoherent (generatedSubobjectHom σ J)

/-- The submodules generated by the finite subfamilies of a family of generating sections cover
the module. -/
lemma iSup_generatedSubobject : (⨆ J, generatedSubobject σ J) = ⊤ := by
  classical
  have hle : ∀ i : σ.I, generatedSubobject σ {i} ≤ (⨆ J, generatedSubobject σ J) :=
    fun i => le_iSup _ _
  set T : Subobject M := ⨆ J, generatedSubobject σ J with hTdef
  let lift : ∀ i : σ.I, unitOn Y ⟶ (T : Y.Modules) := fun i =>
    ιFreeOn (⟨i, Finset.mem_singleton_self i⟩ : (↥({i} : Finset σ.I))) ≫
      factorThruImageSubobject (generatedSubobjectHom σ {i}) ≫
        Subobject.ofLE (generatedSubobject σ {i}) T (hle i)
  have hlift : ∀ i, lift i ≫ T.arrow = unitOnDesc (σ.s i) := by
    intro i
    calc lift i ≫ T.arrow
        = ιFreeOn (⟨i, Finset.mem_singleton_self i⟩ : (↥({i} : Finset σ.I))) ≫
            (factorThruImageSubobject (generatedSubobjectHom σ {i}) ≫
              (Subobject.ofLE (generatedSubobject σ {i}) T (hle i) ≫ T.arrow)) :=
          (Category.assoc _ _ _).trans (congrArg _ (Category.assoc _ _ _))
      _ = ιFreeOn (⟨i, Finset.mem_singleton_self i⟩ : (↥({i} : Finset σ.I))) ≫
            (factorThruImageSubobject (generatedSubobjectHom σ {i}) ≫
              (generatedSubobject σ {i}).arrow) :=
          congrArg _ (congrArg _ (Subobject.ofLE_arrow _))
      _ = ιFreeOn (⟨i, Finset.mem_singleton_self i⟩ : (↥({i} : Finset σ.I))) ≫
            generatedSubobjectHom σ {i} :=
          congrArg _ (imageSubobject_arrow_comp _)
      _ = (ιFreeOn (⟨i, Finset.mem_singleton_self i⟩ : (↥({i} : Finset σ.I))) ≫
            freeOnMap Subtype.val) ≫ generatingSectionsDesc σ := (Category.assoc _ _ _).symm
      _ = ιFreeOn (Y := Y) i ≫ generatingSectionsDesc σ :=
          congrArg (· ≫ generatingSectionsDesc σ) (ιFreeOn_freeOnMap _ _)
      _ = unitOnDesc (σ.s i) := ιFreeOn_freeOnDesc σ.s i
  have hq : freeOnDesc (fun i => (T : Y.Modules).unitHomEquiv (lift i)) ≫ T.arrow =
      generatingSectionsDesc σ := by
    refine (freeOnDesc_comp (fun i => (T : Y.Modules).unitHomEquiv (lift i)) T.arrow).trans ?_
    refine congrArg freeOnDesc ?_
    funext i
    exact ((unitHomEquiv_comp_apply (lift i) T.arrow).symm.trans
      (congrArg M.unitHomEquiv (hlift i))).trans (M.unitHomEquiv.apply_symm_apply _)
  have hepi : Epi T.arrow := epi_of_epi_fac hq
  have hiso : IsIso T.arrow := isIso_of_mono_of_epi T.arrow
  simpa only [Subobject.mk_arrow] using Subobject.mk_eq_top_of_isIso T.arrow

/-- The diagram of the submodules generated by the finite subfamilies. -/
noncomputable def generatedSubobjectFunctor : Finset σ.I ⥤ Subobject M :=
  (generatedSubobject_monotone σ).functor

/-- The same diagram, read in the category of modules. -/
noncomputable def generatedSubobjectDiagram : Finset σ.I ⥤ Y.Modules :=
  generatedSubobjectFunctor σ ⋙ Subobject.underlying

/-- The canonical cocone with point `M`. -/
noncomputable def generatedSubobjectCocone : Cocone (generatedSubobjectDiagram σ) :=
  Cocone.mk M
    { app := fun J => (generatedSubobject σ J).arrow
      naturality _ _ _ := (Subobject.underlying_arrow _).trans (Category.comp_id _).symm }

/-- The diagram read in `MonoOver M`. -/
noncomputable def generatedSubobjectMonoOver : Finset σ.I ⥤ MonoOver M :=
  generatedSubobjectFunctor σ ⋙ Subobject.representative

/-- The cocone in `Over M`. -/
noncomputable def generatedSubobjectCoconeOver :
    Cocone (generatedSubobjectMonoOver σ ⋙ MonoOver.forget M) :=
  Cocone.mk (Over.mk (𝟙 M))
    { app := fun J => (MonoOver.forget M).map (MonoOver.leTop _)
      naturality := by
        intro J J' f
        apply Over.OverMorphism.ext
        simp only [MonoOver.leTop]
        exact MonoOver.w _ }

/-- The canonical cocone is a colimit cocone. -/
noncomputable def isColimit_generatedSubobjectCocone :
    IsColimit (generatedSubobjectCocone σ) := by
  have hmono : Mono (generatedSubobjectCoconeOver σ).pt.hom := by
    change Mono (𝟙 M)
    infer_instance
  have hsup : Subobject.mk (generatedSubobjectCoconeOver σ).pt.hom =
      ⨆ J, Subobject.mk ((generatedSubobjectMonoOver σ).obj J).obj.hom := by
    change Subobject.mk (𝟙 M) = _
    rw [← Subobject.top_eq_id]
    simpa [generatedSubobjectMonoOver, generatedSubobjectFunctor, Subobject.mk_arrow]
      using (iSup_generatedSubobject σ).symm
  have hc := IsGrothendieckAbelian.isColimitMapCoconeOfSubobjectMkEqISup
    (generatedSubobjectMonoOver σ) (generatedSubobjectCoconeOver σ) hsup
  refine IsColimit.ofIsoColimit hc (Cocone.ext (Iso.refl M) ?_)
  intro J
  change (generatedSubobject σ J).arrow ≫ 𝟙 M = (generatedSubobject σ J).arrow
  exact Category.comp_id _

/-- The restriction to an open of the diagram of submodules generated by finite subfamilies. -/
noncomputable def generatedSubobjectRestrictDiagram (W : Y.Opens) :
    Finset σ.I ⥤ W.toScheme.Modules :=
  generatedSubobjectDiagram σ ⋙ Scheme.Modules.restrictFunctor W.ι

/-- The transition maps of the restricted diagram of generated submodules are monomorphisms. -/
instance generatedSubobjectRestrictDiagram_map_mono (W : Y.Opens)
    (i j : Finset σ.I) (f : i ⟶ j) :
    Mono ((generatedSubobjectRestrictDiagram σ W).map f) := by
  have h1 : Mono ((generatedSubobjectDiagram σ).map f) :=
    @mono_of_mono_fac _ _ _ _ _ _ _ _ (Subobject.arrow_mono _)
      (Subobject.underlying_arrow ((generatedSubobjectFunctor σ).map f))
  exact CategoryTheory.preserves_mono_of_preservesLimit
    (Scheme.Modules.restrictFunctor W.ι) ((generatedSubobjectDiagram σ).map f)

/-- Finite type transports along an isomorphism of modules on a scheme. -/
lemma isFiniteType_of_iso_modules {Z : Scheme.{u}} {A B : Z.Modules} (e : A ≅ B)
    (h : B.IsFiniteType) : A.IsFiniteType :=
  @Stacks.SheafOfModules.isFiniteType_of_epi'.{u} _ _ _ _ _ _ _ _ _ e.inv h
    (IsIso.epi_of_iso e.inv)

/-- If `f` is an isomorphism and `f ≫ e.hom = g` for an isomorphism `e`, then `g` is an
isomorphism. -/
private lemma isIso_of_comp_iso_eq {C : Type u₁} [Category.{v₁} C] {A B D : C} {f : A ⟶ B}
    {g : A ⟶ D} (e : B ≅ D) (hfac : f ≫ e.hom = g) (h : IsIso f) : IsIso g := by
  rw [← hfac]
  infer_instance

/-- Over a quasi-compact open on which `M` is of finite type, the submodule generated by some
finite subfamily of the generating sections is already all of `M`. -/
theorem exists_generatedSubobject_restrict_isIso
    (W : Y.Opens) [CompactSpace W.toScheme]
    (hft : ((Scheme.Modules.restrictFunctor W.ι).obj M).IsFiniteType) :
    ∃ J : Finset σ.I,
      IsIso ((Scheme.Modules.restrictFunctor W.ι).map (generatedSubobject σ J).arrow) := by
  classical
  have hcol : IsColimit ((Scheme.Modules.restrictFunctor W.ι).mapCocone
      (generatedSubobjectCocone σ)) :=
    isColimitOfPreserves (Scheme.Modules.restrictFunctor W.ι)
      (isColimit_generatedSubobjectCocone σ)
  let e := (colimit.isColimit (generatedSubobjectRestrictDiagram σ W)).coconePointUniqueUpToIso
    hcol
  have hftcol : (colimit (generatedSubobjectRestrictDiagram σ W)).IsFiniteType :=
    isFiniteType_of_iso_modules e hft
  have hcpt : CompactSpace W.toScheme.toPresheafedSpace := inferInstance
  obtain ⟨J, hJ⟩ := @Stacks.SheafOfModules.exists_isIso_to_colimit_of_isFiniteType
    W.toScheme.toPresheafedSpace W.toScheme.ringCatSheaf _ _ _ _ _ _ _ _ _
    (generatedSubobjectRestrictDiagram σ W)
    (fun i j f => generatedSubobjectRestrictDiagram_map_mono σ W i j f) hftcol
  exact ⟨J, isIso_of_comp_iso_eq e (IsColimit.comp_coconePointUniqueUpToIso_hom _ hcol J) hJ⟩

/-- Restriction along an open immersion preserves quasi-coherence. -/
lemma restrictFunctor_isQuasicoherent {Z : Scheme.{u}} (e : Y ⟶ Z) [IsOpenImmersion e]
    (N : Z.Modules) [N.IsQuasicoherent] :
    ((Scheme.Modules.restrictFunctor e).obj N).IsQuasicoherent :=
  (SheafOfModules.isQuasicoherent Y.ringCatSheaf).prop_of_iso
    ((Scheme.Modules.restrictFunctorIsoPullback e).app N).symm
    (Stacks.Modules.isQuasicoherent_pullback e N inferInstance)

/-- A family of generating sections of a quasi-coherent module on an affine scheme, made of its
global sections. -/
noncomputable def generatingSectionsOfIsAffine [IsAffine Y] (N : Y.Modules)
    [N.IsQuasicoherent] : N.GeneratingSections := by
  have hoi : IsOpenImmersion Y.isoSpec.inv := IsOpenImmersion.of_isIso Y.isoSpec.inv
  have hqc : ((Scheme.Modules.restrictFunctor Y.isoSpec.inv).obj N).IsQuasicoherent :=
    restrictFunctor_isQuasicoherent Y.isoSpec.inv N
  have hiso : IsIso ((Scheme.Modules.restrictFunctor Y.isoSpec.inv).obj N).fromTildeΓ :=
    (isQuasicoherent_iff_isIso_fromTildeΓ _).mp hqc
  refine Stacks.AlgebraicGeometry.CoherenceCriteria.generatingSectionsOfEquivalence
    (Stacks.AlgebraicGeometry.CoherenceCriteria.restrictEquiv Y.isoSpec)
    (Stacks.AlgebraicGeometry.CoherenceCriteria.freeInverseIso _
      (fun I => Stacks.AlgebraicGeometry.CoherenceCriteria.restrictFreeIso Y.isoSpec.inv I))
    (GeneratingSections.equivOfIso (@asIso _ _ _ _ _ hiso)
      (Stacks.AlgebraicGeometry.CoherentTFAE.tildeGeneratingSections _ id (by simp)))

/-- On an affine scheme, a quasi-coherent module whose
restriction to a quasi-compact open `W` is of finite type has a quasi-coherent submodule of
finite type whose inclusion is bijective on sections over every open contained in `W`. -/
theorem exists_finiteTypeSubobject_isIso_app_of_isAffine [IsAffine Y] (N : Y.Modules)
    [N.IsQuasicoherent] (W : Y.Opens) (hW : IsCompact (W : Set Y))
    (hft : ((Scheme.Modules.restrictFunctor W.ι).obj N).IsFiniteType) :
    ∃ B : Subobject N, (B : Y.Modules).IsQuasicoherent ∧ (B : Y.Modules).IsFiniteType ∧
      ∀ W' : Y.Opens, W' ≤ W → IsIso (B.arrow.app W') := by
  have hcpt : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hW
  obtain ⟨J, hJ⟩ := exists_generatedSubobject_restrict_isIso
    (generatingSectionsOfIsAffine N) W hft
  refine ⟨generatedSubobject _ J, generatedSubobject_isQuasicoherent _ J,
    generatedSubobject_isFiniteType _ J, fun W' hW' => ?_⟩
  have h := isIso_app_of_isIso
    ((Scheme.Modules.restrictFunctor W.ι).map (generatedSubobject _ J).arrow) (W.ι ⁻¹ᵁ W')
  have hopens : W.ι ''ᵁ (W.ι ⁻¹ᵁ W') = W' :=
    (TopologicalSpace.Opens.functor_map_eq_inf W W').trans (inf_eq_left.mpr hW')
  exact hopens ▸ h

end AlgebraicGeometry
