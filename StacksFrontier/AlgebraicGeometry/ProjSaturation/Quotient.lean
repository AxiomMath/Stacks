module

public import StacksFrontier.AlgebraicGeometry.ProjClosedImmersion.Quotient
public import StacksFrontier.AlgebraicGeometry.ProjSaturation.Basic

/-!
# The saturation of a homogeneous ideal, read off `Proj` of the quotient

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a Noetherian graded ring generated in degree one over `𝒜 0`, and let
`I` be a homogeneous ideal. The *saturation* of `I` is

`{x ∈ A | 𝒜 n · x ⊆ I for some n ≥ 0}`,

and this file identifies it with the kernel of

`A ⟶ A ⧸ I ⟶ ⨁_{n ≥ 0} Γ(Proj (𝒜 ⧸ I), 𝒪(n))`.

That is the algebraic content of the formula `I(V₊(I)) = {x ∈ A | 𝒜 n x ⊆ I for some n}` of the
source: `V₊(I) = Proj (𝒜 ⧸ I)` is the closed subscheme
`AlgebraicGeometry.Proj.isClosedImmersion_map_quotientMk`, and what is computed here is the
vanishing of the twisted sections *on `V₊(I)` itself*.

## Main results

* `GradedRingHom.adjoin_image_eq_top_of_surjective` and
  `GradedRingHom.adjoin_degreeOne_eq_top_of_surjective`: a generating set, and in particular
  generation in degree one, passes to a quotient.
* `Stacks.HomogeneousIdeal.adjoin_quotientGrading_degreeOne_eq_top` and
  `Stacks.HomogeneousIdeal.adjoin_quotientGrading_range_eq_top`: the quotient of a graded ring
  generated in degree one is generated in degree one, and a generating family of any degrees
  generates the quotient with the same degrees.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection_quotientGradingMk_eq_zero_iff`:
  **the twisted section of the class of `a ∈ 𝒜 n` on `Proj (𝒜 ⧸ I)` vanishes exactly when `a`
  lies in the saturation of `I`.**
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.setOf_degreeSection_quotientGradingMk_eq_zero`: the
  same, as an equality of sets.

## Implementation notes

The criterion on `Proj (𝒜 ⧸ I)` is
`AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection_eq_zero_iff`, whose hypotheses are that
the ring be Noetherian and generated in degree one. Both transfer along the quotient map:
Noetherianness by `isNoetherianRing_of_surjective`, and degree-one generation by
`GradedRingHom.adjoin_degreeOne_eq_top_of_surjective`, which pushes the adjoining forward along
a surjective homomorphism of graded rings. Translating "every element of `(𝒜 ⧸ I) N` kills the
class of `a`" into "every element of `𝒜 N` multiplies `a` into `I`" uses only that
`Stacks.HomogeneousIdeal.quotientGradingMk` is surjective in each degree.

This file itself does not compute `idealOfClosedSubscheme 𝒜 (Proj.map (quotientMk I) …)`, which
asks for the vanishing of sections of `𝒪_{Proj 𝒜}(n)` *pulled back* to `V₊(I)` rather than of
the sections of `𝒪_{V₊(I)}(n)`. Identifying the two is the comparison map
`(Proj.map ψ)^* 𝒪_{Proj 𝒜}(n) ⟶ 𝒪_{Proj ℬ}(n)` of Stacks tag 01N0 part (3), and that
identification **is** now available, in
`StacksFrontier/AlgebraicGeometry/ProjSaturation/QuotientComparison.lean`:
`AlgebraicGeometry.ProjectiveSpectrum.Proj`
`.pullbackGlobalSections_degreeSection_eq_zero_iff_degreeSection_map_eq_zero` says that for a
surjective `ψ` out of a Noetherian graded ring generated in degree one the pulled-back section of
`a ∈ 𝒜 n` vanishes exactly when the section of `ψ a` does, and
`.idealOfClosedSubscheme_map_eq_of_ker_eq_of_saturated` reads off that a saturated kernel is the
ideal of equations; at the quotient map this is
`AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme_projMap_quotientMk_eq`. What
remains open is only the sheaf-level statement that the comparison map is an isomorphism, rather
than injective on these canonical sections.

## References

* [Stacks Project, Tag 0BXD](https://stacks.math.columbia.edu/tag/0BXD)
* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
-/

@[expose] public noncomputable section

open DirectSum

namespace GradedRingHom

variable {ι A B σ τ : Type*} [CommRing A] [CommRing B] [SetLike σ A] [SetLike τ B]
  [AddSubmonoidClass σ A] [AddSubmonoidClass τ B] [DecidableEq ι] [AddMonoid ι]
  {𝒜 : ι → σ} {ℬ : ι → τ} [GradedRing 𝒜] [GradedRing ℬ]

/-- **A generating set pushes forward along a surjective homomorphism of graded rings.** If `A`
is generated by `s` over `𝒜 0` and `ψ : 𝒜 →+*ᵍ ℬ` is surjective, then `B` is generated by the
image of `s` over `ℬ 0`. -/
theorem adjoin_image_eq_top_of_surjective {s : Set A} (ψ : 𝒜 →+*ᵍ ℬ)
    (hψ : Function.Surjective ψ) (hgen : Algebra.adjoin (𝒜 0) s = ⊤) :
    Algebra.adjoin (ℬ 0) (ψ '' s) = ⊤ := by
  refine top_unique fun b _ ↦ ?_
  obtain ⟨a, rfl⟩ := hψ b
  refine Algebra.adjoin_induction (p := fun x _ ↦ ψ x ∈ Algebra.adjoin (ℬ 0) (ψ '' s))
    ?_ ?_ ?_ ?_ (hgen.ge Algebra.mem_top)
  · exact fun x hx ↦ Algebra.subset_adjoin ⟨x, hx, rfl⟩
  · intro r
    simpa using Subalgebra.algebraMap_mem (Algebra.adjoin (ℬ 0) (ψ '' s))
      (⟨ψ r, ψ.map_mem r.2⟩ : ℬ 0)
  · exact fun x y _ _ hx hy ↦ (map_add ψ x y).symm ▸ add_mem hx hy
  · exact fun x y _ _ hx hy ↦ (map_mul ψ x y).symm ▸ mul_mem hx hy

/-- **Generation in degree one passes along a surjective homomorphism of graded rings.** If `A`
is generated by `𝒜 1` over `𝒜 0` and `ψ : 𝒜 →+*ᵍ ℬ` is surjective, then `B` is generated by
`ℬ 1` over `ℬ 0`. -/
theorem adjoin_degreeOne_eq_top_of_surjective {i : ι} (ψ : 𝒜 →+*ᵍ ℬ)
    (hψ : Function.Surjective ψ) (hgen : Algebra.adjoin (𝒜 0) (𝒜 i : Set A) = ⊤) :
    Algebra.adjoin (ℬ 0) (ℬ i : Set B) = ⊤ := by
  refine top_unique ?_
  rw [← adjoin_image_eq_top_of_surjective ψ hψ hgen]
  refine Algebra.adjoin_mono ?_
  rintro b ⟨a, ha, rfl⟩
  exact ψ.map_mem ha

end GradedRingHom

namespace Stacks.HomogeneousIdeal

variable {ι σ A : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [DecidableEq ι]
  [AddMonoid ι] {𝒜 : ι → σ} [GradedRing 𝒜] (I : _root_.HomogeneousIdeal 𝒜)

/-- The quotient of a graded ring generated in degree one is generated in degree one. -/
theorem adjoin_quotientGrading_degreeOne_eq_top {i : ι}
    (hgen : Algebra.adjoin (𝒜 0) (𝒜 i : Set A) = ⊤) :
    Algebra.adjoin (quotientGrading I 0) (quotientGrading I i : Set (A ⧸ I.toIdeal)) = ⊤ :=
  (quotientMk I).adjoin_degreeOne_eq_top_of_surjective (surjective_quotientMk I) hgen

/-- **A generating family of a graded ring generates its quotient by a homogeneous ideal**, with
the same degrees. This is what makes the integer `d` of Stacks tag 0BXK's general formula — the
least common multiple of the degrees of a family of generators of `A` over `𝒜 0` — serve for
`A ⧸ I` as well as for `A`. -/
theorem adjoin_quotientGrading_range_eq_top {ι' : Type*} (g : ι' → A)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range g) = ⊤) :
    Algebra.adjoin (quotientGrading I 0)
      (Set.range fun j ↦ (quotientMk I (g j) : A ⧸ I.toIdeal)) = ⊤ := by
  rw [show (Set.range fun j ↦ (quotientMk I (g j) : A ⧸ I.toIdeal)) =
      quotientMk I '' Set.range g from Set.range_comp _ _]
  exact (quotientMk I).adjoin_image_eq_top_of_surjective (surjective_quotientMk I) hgen

/-- An element of the degree-`i` part of the quotient grading kills the class of `a` exactly when
its preimages in `𝒜 i` multiply `a` into `I`. -/
theorem forall_mul_quotientGradingMk_eq_zero_iff {i n : ι} (a : 𝒜 n) :
    (∀ y : A ⧸ I.toIdeal, y ∈ quotientGrading I i →
        y * (quotientGradingMk I n a : A ⧸ I.toIdeal) = 0) ↔
      ∀ y : A, y ∈ 𝒜 i → y * (a : A) ∈ I.toIdeal := by
  refine ⟨fun h y hy ↦ Ideal.Quotient.eq_zero_iff_mem.mp
      ((map_mul (Ideal.Quotient.mk I.toIdeal) y a).trans (h _ (mk_mem_quotientGrading I hy))),
    fun h y hy ↦ ?_⟩
  obtain ⟨z, hz, rfl⟩ := (mem_quotientGrading_iff I y).mp hy
  exact (map_mul (Ideal.Quotient.mk I.toIdeal) z a).symm.trans
    (Ideal.Quotient.eq_zero_iff_mem.mpr (h z hz))

end Stacks.HomogeneousIdeal

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open Stacks.HomogeneousIdeal

universe u w

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] (I : HomogeneousIdeal 𝒜)

/-- **The twisted section on `V₊(I) = Proj (𝒜 ⧸ I)` attached to the class of a homogeneous
element `a` vanishes exactly when `a` lies in the saturation of `I`**, i.e. when some whole
homogeneous component `𝒜 N` multiplies `a` into `I`. -/
theorem degreeSection_quotientGradingMk_eq_zero_iff [IsNoetherianRing A]
    (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) {n : ℕ} (a : 𝒜 n) :
    degreeSection (quotientGrading I) n (quotientGradingMk I n a) = 0 ↔
      ∃ N : ℕ, ∀ y : A, y ∈ 𝒜 N → y * (a : A) ∈ I.toIdeal := by
  rw [degreeSection_eq_zero_iff (quotientGrading I)
    (adjoin_quotientGrading_degreeOne_eq_top I hgen) (quotientGradingMk I n a)]
  exact exists_congr fun N ↦ forall_mul_quotientGradingMk_eq_zero_iff I a

/-- **The kernel of `A ⟶ ⨁_{n ≥ 0} Γ(Proj (𝒜 ⧸ I), 𝒪(n))` on homogeneous elements is the
saturation of `I`**, stated as an equality of sets of homogeneous elements of each degree. -/
theorem setOf_degreeSection_quotientGradingMk_eq_zero [IsNoetherianRing A]
    (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℕ) :
    {a : 𝒜 n | degreeSection (quotientGrading I) n (quotientGradingMk I n a) = 0} =
      {a : 𝒜 n | ∃ N : ℕ, ∀ y : A, y ∈ 𝒜 N → y * (a : A) ∈ I.toIdeal} :=
  Set.ext fun a ↦ degreeSection_quotientGradingMk_eq_zero_iff 𝒜 I hgen a

end AlgebraicGeometry.ProjectiveSpectrum.Proj

end
