-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open AlgebraicGeometry

universe u w

variable {S : Type u} [CommRing S] {σ : Type w} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

variable {f : S} {d : ℕ}

/-- **Raising numerator and denominator of a chart function by the same power of `f` changes
nothing.** If `c = f ^ N * b` then the chart function `c / f ^ (N + n)` of `c` equals the chart
function `b / f ^ n` of `b`, both being sections over `D₊(f)`. -/
theorem chartFraction_pow_mul_left (hf : f ∈ 𝒮 d) (N n : ℕ) (b : 𝒮 (n • d))
    (c : 𝒮 ((N + n) • d)) (hc : (c : S) = f ^ N * (b : S)) :
    chartFraction 𝒮 hf (N + n) c = chartFraction 𝒮 hf n b := by
  refine congrArg (Proj.awayToSection 𝒮 f).hom (HomogeneousLocalization.val_injective _ ?_)
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hc]
  refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
  change f ^ n * (f ^ N * (b : S)) = f ^ (N + n) * (b : S)
  rw [pow_add]
  ring

/-- `AlgebraicGeometry.ProjectiveSpectrum.Proj.zeroScheme_degreeSection_ideal_basicOpen` with the
degree of the homogeneous element supplied by an equation rather than written `n • d`.

The homogeneous elements that arise in practice have a degree such as `n` or `N + n`, which is
only propositionally equal to the `n • d` the indexing of `chartFraction` demands; stating the
local equation this way discharges the cast by `subst` once instead of at every use site. -/
theorem zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq (hf : f ∈ 𝒮 d) (hd : 0 < d)
    (n : ℕ) {m : ℕ} (hm : n • d = m) (b : 𝒮 m) (hb : (b : S) ∈ 𝒮 (n • d))
    [SheafOfModules.IsInvertible (Proj 𝒮).sheaf.obj (Proj 𝒮).ringCatSheaf.property
      (twistingSheafModule 𝒮 (m : ℤ))] :
    (zeroScheme (Proj 𝒮) (twistingSheafModule 𝒮 (m : ℤ)) (degreeSection 𝒮 m b)).ideal
        ⟨Proj.basicOpen 𝒮 f, Proj.isAffineOpen_basicOpen 𝒮 f hf hd⟩
      = Ideal.span {chartFraction 𝒮 hf n ⟨(b : S), hb⟩} := by
  subst hm
  exact zeroScheme_degreeSection_ideal_basicOpen 𝒮 hf hd n ⟨(b : S), hb⟩

/-- **Membership in `I(Z)` is checked chart by chart on a cover by standard opens of one common
degree.** If the chart function of a homogeneous element `z` of degree `m · d` lies in
`Ker(i.app D₊(fam j))` for every member of a family of elements of degree `d > 0` whose standard
opens cover `Proj 𝒮`, then `z` lies in the ideal of `Z`.

The defining ideal over `D₊(fam j)` of the zero scheme of the twisted section of `z` is generated
by that one chart function, and an inequality of ideal sheaves may be checked on an affine cover.

The twists `𝒪(k · d)` this needs invertible are invertible because of the cover itself, by
`algebraicGeometry_isInvertible_twistingSheaf_of_cover`: no generation in degree one and no
Noetherian hypothesis enters. -/
theorem mem_idealOfClosedSubscheme_of_forall_chartFraction_mem_ker (hd : 0 < d)
    {ι : Type*} (fam : ι → S) (hfam : ∀ j, fam j ∈ 𝒮 d)
    (hcov : ⨆ j, Proj.basicOpen 𝒮 (fam j) = ⊤)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] {m : ℕ} (z : 𝒮 (m • d))
    (hz : ∀ j : ι, chartFraction 𝒮 (hfam j) m z ∈
      RingHom.ker (i.app (Proj.basicOpen 𝒮 (fam j))).hom) :
    (z : S) ∈ idealOfClosedSubscheme 𝒮 i := by
  have hinv := algebraicGeometry_isInvertible_twistingSheaf_of_cover 𝒮 fam d hfam hcov
  refine mem_idealOfClosedSubscheme 𝒮 i (m • d) z ?_
  rw [pullbackGlobalSections_degreeSection_eq_zero_iff_zeroScheme_le_ker]
  refine Scheme.IdealSheafData.le_of_iSup_eq_top
    (fun j => ⟨Proj.basicOpen 𝒮 (fam j),
      Proj.isAffineOpen_basicOpen 𝒮 (fam j) (hfam j) hd⟩) hcov ?_
  intro j
  rw [Scheme.Hom.ker_apply]
  exact le_of_eq_of_le (zeroScheme_degreeSection_ideal_basicOpen 𝒮 (hfam j) hd m z)
    ((Ideal.span_singleton_le_iff_mem _).mpr (hz j))

/-- **The homogeneous case of saturation.** If one whole homogeneous component `𝒮 N` multiplies a
homogeneous element `b` into the ideal of a closed subscheme `Z ⊆ Proj 𝒮`, then `b` itself lies in
that ideal.

On the standard open of a degree-one element `f` the multiplier `f ^ N` suffices: the chart
function of `f ^ N b` is the chart function of `b`, which therefore lies in
`Ker(i.app D₊(f))`. The standard opens of the degree-one elements cover `Proj 𝒮`, so the
chartwise criterion applies. -/
theorem mem_idealOfClosedSubscheme_of_forall_mul_mem
    (hgen : Algebra.adjoin (𝒮 0) ((𝒮 1 : Set S)) = ⊤)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] {n : ℕ} (b : 𝒮 n) (N : ℕ)
    (hb : ∀ y : S, y ∈ 𝒮 N → y * (b : S) ∈ idealOfClosedSubscheme 𝒮 i) :
    (b : S) ∈ idealOfClosedSubscheme 𝒮 i := by
  have inst : ∀ k : ℤ, SheafOfModules.IsInvertible (Proj 𝒮).sheaf.obj
      (Proj 𝒮).ringCatSheaf.property (twistingSheaf 𝒮 k) :=
    algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen
  have hsm : ∀ {k : ℕ} {x : S}, x ∈ 𝒮 k ↔ x ∈ 𝒮 (k • 1) := by simp
  have hb1 : (b : S) ∈ 𝒮 (n • 1) := hsm.mp b.2
  refine mem_idealOfClosedSubscheme_of_forall_chartFraction_mem_ker 𝒮 Nat.one_pos
    (fun g : 𝒮 1 => (g : S)) (fun g => g.2)
    (Stacks.AlgebraicGeometry.ProjDegreeOne.iSup_basicOpen_degreeOne_eq_top 𝒮 hgen)
    i (m := n) ⟨(b : S), hb1⟩ fun g => ?_
  have hfN : (g : S) ^ N ∈ 𝒮 N := hsm.mpr (SetLike.pow_mem_graded N g.2)
  have hcmem : (g : S) ^ N * (b : S) ∈ 𝒮 ((N + n) • 1) :=
    hsm.mp (SetLike.mul_mem_graded hfN b.2)
  have hker := chartFraction_mem_ker_app_of_mem_idealOfClosedSubscheme 𝒮 g.2 Nat.one_pos i
    (N + n) ⟨(g : S) ^ N * (b : S), hcmem⟩ (hb _ hfN)
  rwa [chartFraction_pow_mul_left 𝒮 g.2 N n ⟨(b : S), hb1⟩
    ⟨(g : S) ^ N * (b : S), hcmem⟩ rfl] at hker

/-- **The ideal of a closed subscheme of `Proj` is saturated.** For a graded ring generated in
degree one over its degree-zero part, an element of `S` that one whole homogeneous component
multiplies into the ideal of a closed subscheme `Z ⊆ Proj 𝒮` already lies in that ideal.

No Noetherian hypothesis is needed. -/
theorem saturated_idealOfClosedSubscheme
    (hgen : Algebra.adjoin (𝒮 0) ((𝒮 1 : Set S)) = ⊤)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] (x : S)
    (hx : ∃ N : ℕ, ∀ y : S, y ∈ 𝒮 N → y * x ∈ idealOfClosedSubscheme 𝒮 i) :
    x ∈ idealOfClosedSubscheme 𝒮 i := by
  classical
  obtain ⟨N, hN⟩ := hx
  rw [← DirectSum.sum_support_decompose 𝒮 x]
  refine Submodule.sum_mem _ fun n _ => ?_
  refine mem_idealOfClosedSubscheme_of_forall_mul_mem 𝒮 hgen i
    (DirectSum.decompose 𝒮 x n) N fun y hy => ?_
  have h := (Stacks.GradedRing.mul_mem_isHomogeneous_iff_forall_proj 𝒮
    (idealOfClosedSubscheme_isHomogeneous 𝒮 i) hy x).mp (hN y hy) n
  rwa [GradedRing.proj_apply] at h

/-- **The associated primes of the ideal of a closed subscheme of `Proj` are homogeneous points of
`Proj 𝒮`.** Over a Noetherian graded ring generated in degree one, every associated prime of
`I(Z)` is a homogeneous prime that does not contain the irrelevant ideal.

Homogeneity is `Stacks.GradedRing.isHomogeneous_of_mem_associatedPrimes` applied to the
homogeneous ideal `I(Z)`; relevance is
`Stacks.GradedRing.not_irrelevant_le_of_mem_associatedPrimes_of_saturated` applied to its
saturation. -/
theorem isHomogeneous_and_not_irrelevant_le_of_mem_associatedPrimes_idealOfClosedSubscheme
    [IsNoetherianRing S] (hgen : Algebra.adjoin (𝒮 0) ((𝒮 1 : Set S)) = ⊤)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] {p : Ideal S}
    (hp : p ∈ Submodule.associatedPrimes (idealOfClosedSubscheme 𝒮 i)) :
    Ideal.IsHomogeneous 𝒮 p ∧ ¬(HomogeneousIdeal.irrelevant 𝒮).toIdeal ≤ p :=
  Stacks.GradedRing.isHomogeneous_and_not_irrelevant_le_of_mem_associatedPrimes 𝒮
    (idealOfClosedSubscheme_isHomogeneous 𝒮 i) (saturated_idealOfClosedSubscheme 𝒮 hgen i) hp

section ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (e : ℕ)

/-- **The homogeneous ideal of a closed subscheme of projective space is saturated.** A polynomial
that some whole degree of `R[T₀, …, T_{e-1}]` multiplies into the ideal of `Z ⊆ P^{e-1}_R` already
lies in it. The degree-one generation hypothesis of the general statement holds for a polynomial
ring. -/
theorem projectiveSpace_saturated_idealOfClosedSubscheme {Z : Scheme.{u}}
    (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin e) R)) [IsClosedImmersion i]
    (x : MvPolynomial (Fin e) R)
    (hx : ∃ N : ℕ, ∀ y : MvPolynomial (Fin e) R,
      y ∈ MvPolynomial.homogeneousSubmodule (Fin e) R N →
        y * x ∈ idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i) :
    x ∈ idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i :=
  saturated_idealOfClosedSubscheme _
    (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin e) R) i x hx

/-- **On projective space over a Noetherian ring, every associated prime of the ideal of a closed
subscheme is a homogeneous prime not containing the irrelevant ideal.** -/
theorem projectiveSpace_isHomogeneous_and_not_irrelevant_le_of_mem_associatedPrimes
    [IsNoetherianRing R] {Z : Scheme.{u}}
    (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin e) R)) [IsClosedImmersion i]
    {p : Ideal (MvPolynomial (Fin e) R)}
    (hp : p ∈ Submodule.associatedPrimes
      (idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i)) :
    Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin e) R) p ∧
      ¬(HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin e) R)).toIdeal ≤ p :=
  isHomogeneous_and_not_irrelevant_le_of_mem_associatedPrimes_idealOfClosedSubscheme _
    (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin e) R) i hp

end ProjectiveSpace

end AlgebraicGeometry.ProjectiveSpectrum.Proj

end
