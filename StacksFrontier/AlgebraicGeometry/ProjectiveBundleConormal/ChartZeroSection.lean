module

public import StacksFrontier.AlgebraicGeometry.ProjAwayChartFactor.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleConormal.ChartRatio
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleConormal.SplitChart

/-!
# The section of a projective bundle is the zero section of the affine chart

Let `W` be an affine open of `X` carrying a frame `eL` for `𝓛` and a section `s` of `ℰ` at which
the chart's linear form `p = eL ∘ q` takes the value `1`. Then the chart section `σ|_W` lands in
the standard open `D₊(ι s)` of `Proj(Sym_A M)`, `A = Γ(X, W)`, `M = Γ(ℰ, W)`, which
`Stacks.ProjectiveBundleConormal.splitChartMap` identifies with the affine bundle
`𝐀(ker p) = Spec (Sym_A (ker p))`. **This file identifies the resulting point of the affine
bundle: it is the zero section.**

That is the geometric content of clause 3 of [Stacks, Tag 0B3V] on a chart. With it the conormal
sheaf of `σ` over `W` is the conormal sheaf of the zero section of an affine bundle, which
`Stacks.ProjectiveBundleConormal.conormalZeroSectionTildeIso` computes.

## The route

Both sides are morphisms into `Proj(Sym_A M)` landing in `D₊(ι s)`, so by
`Stacks.AlgebraicGeometry.ProjF1DegreeOneChart.chartHomEquiv` they are ring maps out of the chart
ring `(Sym_A M)_{(ι s)}`. Two such ring maps agreeing at every degree-one ratio `ι m / ι s` are
equal (`SymmetricAlgebra.ringHom_ext_mk_ι`), and that is exactly what is known:
`Stacks.ProjectiveBundleConormal.chartHomEquiv_chartSection_mk_ι` evaluates the chart section's
ring map at `ι m / ι s` as `p(m)`, and
`Stacks.ProjectiveBundleConormal.splitChartOrigin_mk` evaluates the origin's there as
`SymmetricAlgebra.lift p (ι m)`, which is `p(m)` as well.

So no statement that the chart ring is generated by the degree-one ratios is needed beyond
`SymmetricAlgebra.ringHom_ext_mk_ι`, and the comparison never has to be made at a general
fraction.

## Main results

* `Stacks.ProjectiveBundleConormal.chartHomEquiv_chartSection_eq`: **the chart section's ring map
  is the origin of the chart**, read in `Γ(W, ⊤)`.
* `Stacks.ProjectiveBundleConormal.chartSection_eq_zeroSection_comp_splitChartMap`: **the chart
  section is the zero section of the affine bundle**, composed with the chart.

## References

* [Stacks Project, Tag 0B3V](https://stacks.math.columbia.edu/tag/0B3V)
* [Stacks Project, Tag 01NA](https://stacks.math.columbia.edu/tag/01NA)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.ProjectiveBundleSplitting
open Stacks.SymGraded

universe u

namespace Stacks.ProjectiveBundleConormal

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent]
  (Q : Stacks.Divisors.InvertibleQuotient X E)
  {σ : X ⟶ (bundle E).scheme} (hσ : σ ≫ (bundle E).toBase = 𝟙 X)
  (e : (Scheme.Modules.pullback σ).obj (tautologicalTwist E (symPieces E)) ≅ Q.L)
  (hqe : (Scheme.Modules.pullbackId X).inv.app E ≫
    (Scheme.Modules.pullbackCongr hσ).inv.app E ≫
      (Scheme.Modules.pullbackComp σ (bundle E).toBase).inv.app E ≫
        (Scheme.Modules.pullback σ).map (tautologicalMap E (symPieces E)) ≫ e.hom = Q.q)
  {W : X.Opens} (hW : IsAffineOpen W)

include hσ e hqe in
/-- **The chart section's ring map is the origin of the chart.** Under the chart bijection of
`Proj` at `ι s`, the chart section `σ|_W` corresponds to the `A`-point
`Stacks.ProjectiveBundleConormal.splitChartOrigin` of the chart, read in `Γ(W, ⊤)` along the
restriction `Γ(X, W) ≅ Γ(W, ⊤)`.

Both ring maps are compared at the degree-one ratios only, which
`SymmetricAlgebra.ringHom_ext_mk_ι` says is enough: there
`Stacks.ProjectiveBundleConormal.chartHomEquiv_chartSection_mk_ι` gives `p(m)` on the left and
`Stacks.ProjectiveBundleConormal.splitChartOrigin_mk` gives `SymmetricAlgebra.lift p (ι m)`,
i.e. `p(m)`, on the right. -/
theorem chartHomEquiv_chartSection_eq (eL : Γ(Q.L, W) ≃ₗ[Γ(X, W)] Γ(X, W)) (s : Γ(E, W))
    (hs : chartLinearForm Q W eL s = 1) :
    Stacks.AlgebraicGeometry.ProjF1DegreeOneChart.chartHomEquiv
        (SymmetricAlgebra.grading Γ(X, W) Γ(E, W))
        (SymmetricAlgebra.ι_mem_grading_one s) Nat.one_pos (↑W : Scheme.{u})
        ⟨chartSection E hW hσ,
          chartSection_preimage_basicOpen_eq_top E Q hσ e hqe hW s
            (span_singleton_app_eq_top_of_chartLinearForm_eq_one Q W eL hs)⟩ =
      splitChartOrigin (chartLinearForm Q W eL) s hs ≫
        W.ι.appLE W ⊤ W.ι_preimage_self.ge := by
  refine CommRingCat.hom_ext
    (SymmetricAlgebra.ringHom_ext_mk_ι (chartLinearForm Q W eL) s hs fun m =>
      (chartHomEquiv_chartSection_mk_ι E Q hσ e hqe hW eL s m hs).trans
        (congrArg (W.ι.appLE W ⊤ W.ι_preimage_self.ge).hom
          ((SymmetricAlgebra.lift_ι_apply (chartLinearForm Q W eL) m).symm.trans
            (splitChartOrigin_mk (chartLinearForm Q W eL) s hs 1
              (SymmetricAlgebra.ι Γ(X, W) Γ(E, W) m)
              (SymmetricAlgebra.ι_mem_grading_smul m)).symm)))

include hσ e hqe in
/-- **The chart section, computed.** It is the unit of the `Γ`–`Spec` adjunction, the spectrum of
the origin of the chart, and Mathlib's open immersion `AlgebraicGeometry.Proj.awayι`.

This is `Stacks.ProjectiveBundleConormal.chartHomEquiv_chartSection_eq` read through
`Stacks.AlgebraicGeometry.ProjAwayChartFactor.chartHomEquiv_symm_val`, which computes the inverse
of the chart bijection. -/
theorem chartSection_eq_awayι (eL : Γ(Q.L, W) ≃ₗ[Γ(X, W)] Γ(X, W)) (s : Γ(E, W))
    (hs : chartLinearForm Q W eL s = 1) :
    chartSection E hW hσ =
      (↑W : Scheme.{u}).toSpecΓ ≫
        Spec.map (splitChartOrigin (chartLinearForm Q W eL) s hs ≫
            W.ι.appLE W ⊤ W.ι_preimage_self.ge) ≫
          AlgebraicGeometry.Proj.awayι (SymmetricAlgebra.grading Γ(X, W) Γ(E, W))
            (SymmetricAlgebra.ι Γ(X, W) Γ(E, W) s)
            (SymmetricAlgebra.ι_mem_grading_one s) Nat.one_pos := by
  rw [← chartHomEquiv_chartSection_eq E Q hσ e hqe hW eL s hs,
    ← Stacks.AlgebraicGeometry.ProjAwayChartFactor.chartHomEquiv_symm_val]
  rw [Equiv.symm_apply_apply]

include hσ e hqe in
/-- **The chart section is the zero section of the affine bundle.** Over an affine open carrying
a frame and a section at which the chart's linear form takes the value `1`, the section `σ` read
on the chart `𝐀(ker p) = Spec (Sym_A (ker p))` of `Proj(Sym_A M)` is the zero section.

This is the geometric content of clause 3 of [Stacks, Tag 0B3V] on a chart: the conormal sheaf of
`σ` over `W` is the conormal sheaf of the zero section of an affine bundle. -/
theorem chartSection_eq_zeroSection_comp_splitChartMap
    (eL : Γ(Q.L, W) ≃ₗ[Γ(X, W)] Γ(X, W)) (s : Γ(E, W))
    (hs : chartLinearForm Q W eL s = 1) :
    chartSection E hW hσ =
      ((↑W : Scheme.{u}).toSpecΓ ≫ Spec.map (W.ι.appLE W ⊤ W.ι_preimage_self.ge)) ≫
        zeroSection Γ(X, W) (LinearMap.ker (chartLinearForm Q W eL)) ≫
          splitChartMap (chartLinearForm Q W eL) s hs := by
  rw [chartSection_eq_awayι E Q hσ e hqe hW eL s hs, splitChartOrigin, splitChartMap,
    Spec.map_comp, Spec.map_comp]
  simp only [Category.assoc]

/-- **The canonical isomorphism of an affine open with the spectrum of its sections, written out.**
`AlgebraicGeometry.IsAffineOpen.isoSpec` is `AlgebraicGeometry.Scheme.Opens.toSpecΓ`, which is the
unit of the `Γ`–`Spec` adjunction followed by the spectrum of
`AlgebraicGeometry.Scheme.Opens.topIso`; and the inverse of that comparison is the restriction
`AlgebraicGeometry.Scheme.Hom.appLE` of the inclusion of `W`, the two being `X.presheaf` applied
to the only arrow there is between the two opens.

It is needed because the source of clause 3's map is identified over the chart at the
`AlgebraicGeometry.IsAffineOpen.isoSpec` spelling, by
`Stacks.ProjectiveBundleConormal.restrictKernelIsoTilde`, and the chart section is computed here
at the `AlgebraicGeometry.Scheme.Hom.appLE` one. -/
theorem isoSpec_hom_eq_toSpecΓ_comp {X : Scheme.{u}} {W : X.Opens} (hW : IsAffineOpen W) :
    hW.isoSpec.hom =
      (↑W : Scheme.{u}).toSpecΓ ≫ Spec.map (W.ι.appLE W ⊤ W.ι_preimage_self.ge) := by
  rw [IsAffineOpen.isoSpec_hom, Scheme.Opens.toSpecΓ, Scheme.Opens.ι_appLE,
    Scheme.Opens.topIso_inv]
  exact congrArg (fun φ => (↑W : Scheme.{u}).toSpecΓ ≫ Spec.map φ)
    (congrArg X.presheaf.map (Subsingleton.elim _ _))

include hσ e hqe in
/-- **The chart section is the zero section, read through
`AlgebraicGeometry.IsAffineOpen.isoSpec`.** This is
`Stacks.ProjectiveBundleConormal.chartSection_eq_zeroSection_comp_splitChartMap` with its first
factor written as the canonical identification of the affine open with the spectrum of its
sections. -/
theorem chartSection_eq_isoSpec_comp_zeroSection
    (eL : Γ(Q.L, W) ≃ₗ[Γ(X, W)] Γ(X, W)) (s : Γ(E, W))
    (hs : chartLinearForm Q W eL s = 1) :
    chartSection E hW hσ =
      hW.isoSpec.hom ≫
        zeroSection Γ(X, W) (LinearMap.ker (chartLinearForm Q W eL)) ≫
          splitChartMap (chartLinearForm Q W eL) s hs :=
  (chartSection_eq_zeroSection_comp_splitChartMap E Q hσ e hqe hW eL s hs).trans
    (congrArg
      (fun g => g ≫ zeroSection Γ(X, W) (LinearMap.ker (chartLinearForm Q W eL)) ≫
        splitChartMap (chartLinearForm Q W eL) s hs)
      (isoSpec_hom_eq_toSpecΓ_comp hW).symm)

end Stacks.ProjectiveBundleConormal

end
