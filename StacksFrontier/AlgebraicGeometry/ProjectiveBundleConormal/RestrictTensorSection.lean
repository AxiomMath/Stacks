* [Stacks Project, Tag 01CD](https://stacks.math.columbia.edu/tag/01CD)
* [Stacks Project, Tag 01CU](https://stacks.math.columbia.edu/tag/01CU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MonoidalCategory Opposite
open Stacks.SheafOfModules (tensorSectionsAt)

universe u

namespace Stacks.ProjectiveBundleConormal

attribute [local instance] monoidalSheafTensor

variable {X : Scheme.{u}}

/-! ### Bookkeeping -/

/-- **A restriction map along `le_refl` is the identity**, read on a section. The hom-sets of
`TopologicalSpace.Opens` are subsingletons, so `homOfLE (le_refl U)` is the identity of `U`. -/
theorem val_map_le_refl (A : X.Modules) (U : X.Opens) (a : A.val.obj (op U)) :
    A.val.map (homOfLE (le_refl U)).op a = a := by
  have hid : (homOfLE (le_refl U)).op = 𝟙 (op U) := Subsingleton.elim _ _
  rw [hid]
  simp
  rfl

/-- **Naming the value of the inverse of an isomorphism on a section by naming the value of the
isomorphism.** This is how the formulas below are turned around: the generator of the chart
computation lies on the far side of the identification, so its `inv` direction is the one needed,
while the composite is read in the `hom` direction. -/
theorem iso_inv_val_app_eq_of {Y : Scheme.{u}} {M N : Y.Modules} (i : M ≅ N) (V : Y.Opens)
    (x : M.val.obj (op V)) (y : N.val.obj (op V)) (hy : i.hom.val.app (op V) x = y) :
    i.inv.val.app (op V) y = x :=
  (congrArg (fun z : N.val.obj (op V) => i.inv.val.app (op V) z) hy).symm.trans
    (congrArg (fun φ : M ⟶ M => φ.val.app (op V) x) i.hom_inv_id)

/-! ### The monoidal constraints on a product section -/

/-- **A whiskering on the left acts on a product section through its second factor alone.** This
is `Stacks.SheafOfModules.tensorSections_tensorMapAt` at `f = 𝟙 A`, the companion of
`Stacks.ProjectiveBundleConormal.tensorSectionsAt_whiskerRight`. -/
theorem tensorSectionsAt_whiskerLeft (A : X.Modules) {B B' : X.Modules} (g : B ⟶ B')
    (V : X.Opens) (z : A.val.obj (op V)) (w : B.val.obj (op V)) :
    (A ◁ g).val.app (op V)
        (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op V) A B z w) =
      tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op V) A B' z (g.val.app (op V) w) :=
  Stacks.SheafOfModules.tensorSections_tensorMapAt X.presheaf X.ringCatSheaf.2 (op V)
    A A B B' (𝟙 A) g z w

/-- **The inverse of the right unitor inserts the unit section on the right.** Since
`monoidalSheafTensor` re-seats its constraints,
`Stacks.SheafOfModules.tensorSections_rightUnitorAt` is not a statement about `ρ_`;
`SheafOfModules.rightUnitor_sheafTensor_eq_iso` identifies the two, and
`Stacks.SheafOfModules.tensorSheafUnitRightIso_inv_app` is the formula. -/
theorem rightUnitor_inv_tensorSectionsAt (M : X.Modules) (V : X.Opens)
    (t : M.val.obj (op V)) :
    (ρ_ M).inv.val.app (op V) t =
      tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op V) M (𝟙_ X.Modules) t (1 : Γ(X, V)) :=
  (congrArg (fun i : M ⊗ 𝟙_ X.Modules ≅ M => i.inv.val.app (op V) t)
      (_root_.SheafOfModules.rightUnitor_sheafTensor_eq_iso X.toRingedSpace.sheaf M)).trans
    (Stacks.SheafOfModules.tensorSheafUnitRightIso_inv_app _ _ M (op V) t)

/-! ### The restricted tensor product on a product section -/

/-- **Tag 01CD on the pullback of a product section.** The comparison carries the pullback of the
section determined by `a` and `b` to the section determined by their pullbacks, over any open of
the source contained in the preimage.

This is `Stacks.ProjectiveBundleConormal.pullbackTensorComparison_unit_tensorSectionsAt`, which
is stated at the unit of `f^* ⊣ f_*` and hence over the whole preimage, carried down by the
naturality of the comparison and of
`Stacks.AlgebraicGeometry.GradedAlgebraTwist.tensorSectionsAt_naturality`. -/
theorem pullbackTensorComparison_pullbackSection_tensorSectionsAt {Y : Scheme.{u}} (f : Y ⟶ X)
    (A B : X.Modules) (U : X.Opens) (V : Y.Opens) (h : V ≤ f ⁻¹ᵁ U)
    (a : A.val.obj (op U)) (b : B.val.obj (op U)) :
    (pullbackTensorComparison f A B).val.app (op V)
        (Scheme.Modules.pullbackSection f (A ⊗ B) U V h
          (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op U) A B a b)) =
      tensorSectionsAt Y.presheaf Y.ringCatSheaf.2 (op V)
        ((Scheme.Modules.pullback f).obj A) ((Scheme.Modules.pullback f).obj B)
        (Scheme.Modules.pullbackSection f A U V h a)
        (Scheme.Modules.pullbackSection f B U V h b) := by
  refine Eq.trans (PresheafOfModules.naturality_apply (pullbackTensorComparison f A B).val
    (homOfLE h).op
    (((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app (A ⊗ B)).val.app (op U)
      (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op U) A B a b))) ?_
  refine Eq.trans (congrArg
    (fun y : ((Scheme.Modules.pullback f).obj A ⊗
        (Scheme.Modules.pullback f).obj B).val.obj (op (f ⁻¹ᵁ U)) =>
      ((Scheme.Modules.pullback f).obj A ⊗
        (Scheme.Modules.pullback f).obj B).val.map (homOfLE h).op y)
    (pullbackTensorComparison_unit_tensorSectionsAt f A B U a b)) ?_
  exact Stacks.AlgebraicGeometry.GradedAlgebraTwist.tensorSectionsAt_naturality
    Y.presheaf Y.ringCatSheaf.2 ((Scheme.Modules.pullback f).obj A)
    ((Scheme.Modules.pullback f).obj B) (homOfLE h).op _ _

/-- **Tag 01CD on the pullback of a product section, in the inverse direction**: the section of
`f^*A ⊗ f^*B` determined by the pullbacks of `a` and of `b` comes from the pullback of the section
of `A ⊗ B` determined by `a` and `b`.

This is the direction the chart computation of [Stacks, Tag 0B3V] clause 3 consumes: the source of
the clause's map is read on a product section downstairs, and
`Stacks.ProjectiveBundleConormal.pullbackSourceIso` crosses it to `σ^*((π^*ker q) ⊗ 𝒪(-1))`, where
`Stacks.ProjectiveBundleConormal.idealSheafLift` is computed. -/
theorem pullbackTensorComparison_inv_tensorSectionsAt {Y : Scheme.{u}} (f : Y ⟶ X)
    (A B : X.Modules) (U : X.Opens) (V : Y.Opens) (h : V ≤ f ⁻¹ᵁ U)
    (a : A.val.obj (op U)) (b : B.val.obj (op U)) :
    (pullbackTensorComparisonIso f A B).inv.val.app (op V)
        (tensorSectionsAt Y.presheaf Y.ringCatSheaf.2 (op V)
          ((Scheme.Modules.pullback f).obj A) ((Scheme.Modules.pullback f).obj B)
          (Scheme.Modules.pullbackSection f A U V h a)
          (Scheme.Modules.pullbackSection f B U V h b)) =
      Scheme.Modules.pullbackSection f (A ⊗ B) U V h
        (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op U) A B a b) :=
  iso_inv_val_app_eq_of (pullbackTensorComparisonIso f A B) V _ _
    (pullbackTensorComparison_pullbackSection_tensorSectionsAt f A B U V h a b)

/-- **The restriction of a tensor product, on a product section.** The section of `A ⊗ B` over
`W.ι ''ᵁ V` determined by `a` and `b` is, read through
`Stacks.ProjectiveBundleConormal.restrictTensorIso`, the section of `A|_W ⊗ B|_W` over `V`
determined by the same two.

`Stacks.ProjectiveBundleConormal.restrictTensorIso_hom` splits the isomorphism into the crossing
to the pullback, Tag 01CD and the two crossings back; the first is
`Stacks.AlgebraicGeometry.ModuleLimits.restrictFunctorIsoPullback_hom_val_app`, the second is
`pullbackTensorComparison_pullbackSection_tensorSectionsAt`, and the two crossings back are
`AlgebraicGeometry.Scheme.Modules.restrictFunctorIsoPullback_inv_pullbackSection` inside a
whiskering. -/
theorem restrictTensorIso_hom_tensorSectionsAt (W : X.Opens) (A B : X.Modules)
    (V : (↑W : Scheme.{u}).Opens) (h : V ≤ W.ι ⁻¹ᵁ (W.ι ''ᵁ V))
    (a : A.val.obj (op (W.ι ''ᵁ V))) (b : B.val.obj (op (W.ι ''ᵁ V))) :
    (restrictTensorIso W A B).hom.val.app (op V)
        (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op (W.ι ''ᵁ V)) A B a b) =
      tensorSectionsAt (↑W : Scheme.{u}).presheaf (↑W : Scheme.{u}).ringCatSheaf.2 (op V)
        ((Scheme.Modules.restrictFunctor W.ι).obj A)
        ((Scheme.Modules.restrictFunctor W.ι).obj B)
        (A.val.map (homOfLE (le_refl (W.ι ''ᵁ V))).op a)
        (B.val.map (homOfLE (le_refl (W.ι ''ᵁ V))).op b) := by
  refine Eq.trans (congrArg (fun φ : (Scheme.Modules.restrictFunctor W.ι).obj (A ⊗ B) ⟶
      (Scheme.Modules.restrictFunctor W.ι).obj A ⊗
        (Scheme.Modules.restrictFunctor W.ι).obj B =>
    φ.val.app (op V) (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op (W.ι ''ᵁ V)) A B a b))
    (restrictTensorIso_hom W A B)) ?_
  refine Eq.trans (congrArg (fun y : ((Scheme.Modules.pullback W.ι).obj (A ⊗ B)).val.obj (op V) =>
      ((Scheme.Modules.restrictFunctor W.ι).obj A ◁
          (Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app B).val.app (op V)
        (((Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app A ▷
            (Scheme.Modules.pullback W.ι).obj B).val.app (op V)
          ((pullbackTensorComparison W.ι A B).val.app (op V) y)))
    (Stacks.AlgebraicGeometry.ModuleLimits.restrictFunctorIsoPullback_hom_val_app W.ι (A ⊗ B) V h
      (tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op (W.ι ''ᵁ V)) A B a b))) ?_
  refine Eq.trans (congrArg (fun y : ((Scheme.Modules.pullback W.ι).obj A ⊗
        (Scheme.Modules.pullback W.ι).obj B).val.obj (op V) =>
      ((Scheme.Modules.restrictFunctor W.ι).obj A ◁
          (Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app B).val.app (op V)
        (((Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app A ▷
            (Scheme.Modules.pullback W.ι).obj B).val.app (op V) y))
    (pullbackTensorComparison_pullbackSection_tensorSectionsAt W.ι A B (W.ι ''ᵁ V) V h a b)) ?_
  refine Eq.trans (congrArg (fun y : ((Scheme.Modules.restrictFunctor W.ι).obj A ⊗
        (Scheme.Modules.pullback W.ι).obj B).val.obj (op V) =>
      ((Scheme.Modules.restrictFunctor W.ι).obj A ◁
        (Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app B).val.app (op V) y)
    ((tensorSectionsAt_whiskerRight ((Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app A)
          ((Scheme.Modules.pullback W.ι).obj B) V
          (Scheme.Modules.pullbackSection W.ι A (W.ι ''ᵁ V) V h a)
          (Scheme.Modules.pullbackSection W.ι B (W.ι ''ᵁ V) V h b)).trans
      (congrArg (fun z : ((Scheme.Modules.restrictFunctor W.ι).obj A).val.obj (op V) =>
          tensorSectionsAt (↑W : Scheme.{u}).presheaf (↑W : Scheme.{u}).ringCatSheaf.2 (op V)
            ((Scheme.Modules.restrictFunctor W.ι).obj A)
            ((Scheme.Modules.pullback W.ι).obj B) z
            (Scheme.Modules.pullbackSection W.ι B (W.ι ''ᵁ V) V h b))
        (Scheme.Modules.restrictFunctorIsoPullback_inv_pullbackSection W.ι A (W.ι ''ᵁ V) V h
          le_rfl a)))) ?_
  refine Eq.trans (tensorSectionsAt_whiskerLeft ((Scheme.Modules.restrictFunctor W.ι).obj A)
    ((Scheme.Modules.restrictFunctorIsoPullback W.ι).inv.app B) V
    (A.val.map (homOfLE (le_refl (W.ι ''ᵁ V))).op a)
    (Scheme.Modules.pullbackSection W.ι B (W.ι ''ᵁ V) V h b)) ?_
  exact congrArg (fun z : ((Scheme.Modules.restrictFunctor W.ι).obj B).val.obj (op V) =>
      tensorSectionsAt (↑W : Scheme.{u}).presheaf (↑W : Scheme.{u}).ringCatSheaf.2 (op V)
        ((Scheme.Modules.restrictFunctor W.ι).obj A)
        ((Scheme.Modules.restrictFunctor W.ι).obj B)
        (A.val.map (homOfLE (le_refl (W.ι ''ᵁ V))).op a) z)
    (Scheme.Modules.restrictFunctorIsoPullback_inv_pullbackSection W.ι B (W.ι ''ᵁ V) V h le_rfl b)

/-- **The restriction of a tensor product on a product section, in the inverse direction**: the
section of `A|_W ⊗ B|_W` determined by `a` and `b` comes from the section of `A ⊗ B` determined by
the same two. This is `restrictTensorIso_hom_tensorSectionsAt` turned around by
`Stacks.ProjectiveBundleConormal.iso_inv_val_app_eq_of`, the two restrictions along `le_refl`
removed by `Stacks.ProjectiveBundleConormal.val_map_le_refl`. -/
theorem restrictTensorIso_inv_tensorSectionsAt (W : X.Opens) (A B : X.Modules)
    (V : (↑W : Scheme.{u}).Opens) (h : V ≤ W.ι ⁻¹ᵁ (W.ι ''ᵁ V))
    (a : A.val.obj (op (W.ι ''ᵁ V))) (b : B.val.obj (op (W.ι ''ᵁ V))) :
    (restrictTensorIso W A B).inv.val.app (op V)
        (tensorSectionsAt (↑W : Scheme.{u}).presheaf (↑W : Scheme.{u}).ringCatSheaf.2 (op V)
          ((Scheme.Modules.restrictFunctor W.ι).obj A)
          ((Scheme.Modules.restrictFunctor W.ι).obj B) a b) =
      tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op (W.ι ''ᵁ V)) A B a b :=
  iso_inv_val_app_eq_of (restrictTensorIso W A B) V _ _
    ((restrictTensorIso_hom_tensorSectionsAt W A B V h a b).trans
      (by rw [val_map_le_refl, val_map_le_refl]))

/-! ### Dropping the inverse twist on a chart, on a section -/

section Source

variable (L : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]

/-- **The reduction of the source of the conormal map over an open trivialising `L`, read on a
section and inverted.** A section `κ` of `K|_W` is the image of the section `κ ⊗ s̄^{⊗ -1}` of
`(K ⊗ L^{⊗ -1})|_W`, where `s̄^{⊗ -1}` is the section of the inverse twist that the trivialisation
names: the value at `1` of the inverse of
`Stacks.ProjectiveBundleConormal.restrictInverseTwistIso`.

This is the statement the module docstring of
`StacksFrontier.AlgebraicGeometry.ProjectiveBundleConormal.RestrictTensor` promised of
`Stacks.ProjectiveBundleConormal.restrictSourceIso_hom`, which is only the `rfl` decomposition.
The three factors of that decomposition are discharged in turn: the right unitor by
`Stacks.ProjectiveBundleConormal.rightUnitor_inv_tensorSectionsAt`, the trivialisation by
`Stacks.ProjectiveBundleConormal.tensorSectionsAt_whiskerLeft`, and Tag 01CD by
`Stacks.ProjectiveBundleConormal.restrictTensorIso_inv_tensorSectionsAt`. -/
theorem restrictSourceIso_inv_tensorSectionsAt (W : X.Opens) (K : X.Modules)
    (τ : (Scheme.Modules.restrictFunctor W.ι).obj L ≅ 𝟙_ (↑W : Scheme.{u}).Modules)
    (V : (↑W : Scheme.{u}).Opens) (h : V ≤ W.ι ⁻¹ᵁ (W.ι ''ᵁ V))
    (κ : K.val.obj (op (W.ι ''ᵁ V))) :
    (restrictSourceIso L W K τ).inv.val.app (op V) κ =
      tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op (W.ι ''ᵁ V)) K
        (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 L (-1)) κ
        ((restrictInverseTwistIso L W τ).inv.val.app (op V) (1 : Γ((↑W : Scheme.{u}), V))) := by
  refine Eq.trans (congrArg (fun φ : (Scheme.Modules.restrictFunctor W.ι).obj K ⟶
      (Scheme.Modules.restrictFunctor W.ι).obj
        (K ⊗ Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 L (-1)) =>
    φ.val.app (op V) κ)
    (congrArg Iso.inv
      (rfl : restrictSourceIso L W K τ =
        restrictTensorIso W K
            (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 L (-1)) ≪≫
          whiskerLeftIso ((Scheme.Modules.restrictFunctor W.ι).obj K)
            (restrictInverseTwistIso L W τ) ≪≫
          ρ_ ((Scheme.Modules.restrictFunctor W.ι).obj K)))) ?_
  refine Eq.trans (congrArg (fun y : ((Scheme.Modules.restrictFunctor W.ι).obj K ⊗
        𝟙_ (↑W : Scheme.{u}).Modules).val.obj (op V) =>
      (restrictTensorIso W K
            (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2
              L (-1))).inv.val.app (op V)
        (((Scheme.Modules.restrictFunctor W.ι).obj K ◁
          (restrictInverseTwistIso L W τ).inv).val.app (op V) y))
    (rightUnitor_inv_tensorSectionsAt ((Scheme.Modules.restrictFunctor W.ι).obj K) V κ)) ?_
  refine Eq.trans (congrArg (fun y : ((Scheme.Modules.restrictFunctor W.ι).obj K ⊗
        (Scheme.Modules.restrictFunctor W.ι).obj
          (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2
            L (-1))).val.obj (op V) =>
      (restrictTensorIso W K
            (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2
              L (-1))).inv.val.app (op V) y)
    (tensorSectionsAt_whiskerLeft ((Scheme.Modules.restrictFunctor W.ι).obj K)
      (restrictInverseTwistIso L W τ).inv V κ (1 : Γ((↑W : Scheme.{u}), V)))) ?_
  exact restrictTensorIso_inv_tensorSectionsAt W K
    (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 L (-1)) V h κ
    ((restrictInverseTwistIso L W τ).inv.val.app (op V) (1 : Γ((↑W : Scheme.{u}), V)))

end Source

/-! ### The source identification of clause 3 on a chart, on a generator -/

section Chart

variable {E : X.Modules} (Q : Stacks.Divisors.InvertibleQuotient X E) [E.IsQuasicoherent]
  (W : X.Opens) (eL : Γ(Q.L, W) ≃ₗ[Γ(X, W)] Γ(X, W)) (hW : IsAffineOpen W)

/-- `Stacks.ProjectiveBundleConormal.restrictConormalSourceIsoTilde` inverted: its two factors,
in the order they are applied. The composite is a single `CategoryTheory.Iso.trans`, so the split
is `rfl`; naming it as an equation of *morphisms* keeps the generator formula below from having to
perform it on a section, which exhausts the recursion budget. -/
theorem restrictConormalSourceIsoTilde_inv
    (τ : (Scheme.Modules.restrictFunctor W.ι).obj Q.L ≅ 𝟙_ (↑W : Scheme.{u}).Modules) :
    (restrictConormalSourceIsoTilde Q W eL hW τ).inv =
      (restrictKernelIsoTilde Q W eL hW).inv ≫ (restrictSourceIso Q.L W (kernel Q.q) τ).inv :=
  rfl

/-- **The source of the conormal map of [Stacks, Tag 0B3V] clause 3, over a chart, read on a
canonical global section of `(ker p)^~`.** The generator named by an element `k` of the kernel of
the chart's linear form — the unit of `hW.isoSpec.hom^* ⊣ (hW.isoSpec.hom)_*` applied to
`AlgebraicGeometry.tilde.toOpen _ ⊤ k` — comes from the section `k ⊗ s̄^{⊗ -1}` of
`ker(q) ⊗ 𝓛^{⊗ -1}` over `W`: the product of the section of `ker(q)|_W` that `k` *is* with the
section of the inverse twist the trivialisation names.

This is the source half of the equation
`Stacks.ProjectiveBundleConormal.isIso_conormalCanonicalMap_of_restrict_eq'` reduces clause 3 to,
read on the generators that
`Stacks.AlgebraicGeometry.ModuleLimits.hom_ext_of_unit_toOpen` reduces that equation to; the
target half is
`Stacks.ProjectiveBundleConormal.conormalZeroSectionTildeIso_hom_unit_toOpen`.

It is `Stacks.ProjectiveBundleConormal.restrictKernelIsoTilde_inv_unit_toOpen` followed by
`Stacks.ProjectiveBundleConormal.restrictSourceIso_inv_tensorSectionsAt`. -/
theorem restrictConormalSourceIsoTilde_inv_unit_toOpen
    (τ : (Scheme.Modules.restrictFunctor W.ι).obj Q.L ≅ 𝟙_ (↑W : Scheme.{u}).Modules)
    (h : (⊤ : (↑W : Scheme.{u}).Opens) ≤ hW.isoSpec.inv ''ᵁ ⊤)
    (h' : (⊤ : (↑W : Scheme.{u}).Opens) ≤ W.ι ⁻¹ᵁ (W.ι ''ᵁ ⊤))
    (k : chartKerModule Q W eL) :
    (restrictConormalSourceIsoTilde Q W eL hW τ).inv.val.app (op ⊤)
        (((Scheme.Modules.pullbackPushforwardAdjunction hW.isoSpec.hom).unit.app
            (tilde (chartKerModule Q W eL))).val.app (op ⊤)
          (tilde.toOpen (chartKerModule Q W eL) ⊤ k)) =
      tensorSectionsAt X.presheaf X.ringCatSheaf.2 (op (W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens)))
        (kernel Q.q)
        (Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 Q.L (-1))
        (((kernel Q.q).restrict W.ι).val.map (homOfLE h).op
          ((specModuleChartKerIso Q W eL hW).inv k))
        ((restrictInverseTwistIso Q.L W τ).inv.val.app (op ⊤)
          (1 : Γ((↑W : Scheme.{u}), (⊤ : (↑W : Scheme.{u}).Opens)))) := by
  refine Eq.trans (congrArg
    (fun φ : (Scheme.Modules.pullback hW.isoSpec.hom).obj (tilde (chartKerModule Q W eL)) ⟶
        (Scheme.Modules.restrictFunctor W.ι).obj
          (kernel Q.q ⊗
            Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 Q.L (-1)) =>
      φ.val.app (op ⊤)
        (((Scheme.Modules.pullbackPushforwardAdjunction hW.isoSpec.hom).unit.app
            (tilde (chartKerModule Q W eL))).val.app (op ⊤)
          (tilde.toOpen (chartKerModule Q W eL) ⊤ k)))
    (restrictConormalSourceIsoTilde_inv Q W eL hW τ)) ?_
  refine Eq.trans (SheafOfModules.comp_val_app_apply (restrictKernelIsoTilde Q W eL hW).inv
    (restrictSourceIso Q.L W (kernel Q.q) τ).inv (op ⊤) _) ?_
  refine Eq.trans (congrArg
    (fun y : ((Scheme.Modules.restrictFunctor W.ι).obj (kernel Q.q)).val.obj (op ⊤) =>
      (restrictSourceIso Q.L W (kernel Q.q) τ).inv.val.app (op ⊤) y)
    (restrictKernelIsoTilde_inv_unit_toOpen Q W eL hW h k)) ?_
  exact restrictSourceIso_inv_tensorSectionsAt Q.L W (kernel Q.q) τ ⊤ h'
    (((kernel Q.q).restrict W.ι).val.map (homOfLE h).op ((specModuleChartKerIso Q W eL hW).inv k))

end Chart

/-! ### A trivialisation of the restriction names a generator -/

section Generator

open Stacks.SheafOfModules.TensorStalkRingedSpace (grpGerm grpStalk ringStalk)

/-- **The restriction of the section a trivialisation names is the section it names there.** For
`θ : N ≅ 𝒪_Y`, the section `θ⁻¹(1)` over `U` restricts to `θ⁻¹(1)` over `V ≤ U`, because `θ⁻¹` is
natural and the restriction maps of the monoidal unit are those of the structure sheaf, which
carry `1` to `1`. -/
theorem restrictₛₗ_isoUnit_inv_one {Y : Scheme.{u}} (N : Y.Modules) (θ : N ≅ 𝟙_ Y.Modules)
    {U V : Y.Opens} (h : V ≤ U) :
    N.val.restrictₛₗ (homOfLE h).op (θ.inv.val.app (op U) (1 : Γ(Y, U)))
      = θ.inv.val.app (op V) (1 : Γ(Y, V)) :=
  (PresheafOfModules.naturality_apply θ.inv.val (homOfLE h).op (1 : Γ(Y, U))).symm.trans
    (congrArg (fun z : Γ(Y, V) => θ.inv.val.app (op V) z)
      (map_one (Y.ringCatSheaf.obj.map (homOfLE h).op).hom))

/-- **The section a trivialisation names generates the sections over every open.** If
`θ : N ≅ 𝒪_Y` then every section of `N` over `V` is a function on `V` times `θ⁻¹(1)`: the function
is `θ` of the section, since `θ⁻¹` is linear and `r • 1 = r` in the structure sheaf.

The section is a variable `x` together with the equation `hx` naming it, rather than the term
`θ⁻¹(1)` itself, so that the consumer instantiates `x` from its own goal instead of unfolding; see
this module's implementation notes. -/
theorem surjective_smul_isoUnit_inv_one {Y : Scheme.{u}} (N : Y.Modules)
    (θ : N ≅ 𝟙_ Y.Modules) (V : Y.Opens) (x : Γ(N, V))
    (hx : x = θ.inv.val.app (op V) (1 : Γ(Y, V))) :
    Function.Surjective fun d : Γ(Y, V) => d • x := by
  intro m
  obtain ⟨r, hrm⟩ : ∃ r : Γ(Y, V), θ.inv.val.app (op V) r = m :=
    ⟨θ.hom.val.app (op V) m, iso_inv_val_app_eq_of θ V m (θ.hom.val.app (op V) m) rfl⟩
  refine ⟨r, ?_⟩
  refine Eq.trans (congrArg (fun u : Γ(N, V) => r • u) hx) ?_
  refine Eq.trans (((θ.inv.val.app (op V)).hom.map_smul r (1 : Γ(Y, V))).symm) ?_
  exact Eq.trans (congrArg (fun z : Γ(Y, V) => θ.inv.val.app (op V) z) (mul_one r)) hrm

/-- **Generation of the sections of a restricted module over `V` is generation of the sections of
the module over `j(V)`.** The two scalar actions on the one section module differ by the ring
isomorphism `AlgebraicGeometry.Scheme.Hom.appIso`, which
`AlgebraicGeometry.Scheme.Modules.smul_restrictAppIso_hom_apply` identifies them through; being a
bijection on scalars, it carries surjectivity across.

The section is a variable `x` read in `Γ(M|_W, V)` together with the equation `hxz` naming its
reading `z` in `Γ(M, j(V))`: the two section modules are definitionally equal but carry different
`HSMul` instances, and the `@id` ascription is what makes each of them resolvable.

`Stacks.Chow.GenuineChern.restrict_smul_eq` is the same crossing named as a lemma; it is not
reused because its module is not in this file's import closure and adding it costs 272 further
modules, so the two lines are inlined here instead. -/
theorem surjective_smul_image_of_surjective_smul (M : X.Modules) (W : X.Opens)
    (V : (↑W : Scheme.{u}).Opens) (x : Γ((Scheme.Modules.restrictFunctor W.ι).obj M, V))
    (z : Γ(M, W.ι ''ᵁ V)) (hxz : @id Γ(M, W.ι ''ᵁ V) x = z)
    (hs : Function.Surjective fun d : Γ((↑W : Scheme.{u}), V) => d • x) :
    Function.Surjective fun c : Γ(X, W.ι ''ᵁ V) => c • z := by
  intro m
  obtain ⟨d, hd⟩ := hs m
  refine ⟨(W.ι.appIso V).inv d, ?_⟩
  refine Eq.trans (congrArg (fun u : Γ(M, W.ι ''ᵁ V) => (W.ι.appIso V).inv d • u) hxz.symm) ?_
  have hcross : @id Γ(M, W.ι ''ᵁ V) (((W.ι.appIso V).hom ((W.ι.appIso V).inv d)) • x)
      = (W.ι.appIso V).inv d • @id Γ(M, W.ι ''ᵁ V) x := by
    have h := Scheme.Modules.smul_restrictAppIso_hom_apply W.ι M V
      ((W.ι.appIso V).hom ((W.ι.appIso V).inv d)) x
    rw [Iso.hom_inv_id_apply] at h
    exact h
  refine Eq.trans hcross.symm ?_
  exact Eq.trans (congrArg (fun e : Γ((↑W : Scheme.{u}), V) => @id Γ(M, W.ι ''ᵁ V) (e • x))
    (Iso.inv_hom_id_apply (W.ι.appIso V) d)) hd

/-- **Restricting on `X` and restricting on the open subscheme are the same map on sections.** A
`rfl`, named on its own because it is the one definitional crossing of
`Stacks.ProjectiveBundleConormal.surjective_smul_restrictIsoUnit` and does not fit in the same
heartbeat budget as the rest of that proof. -/
theorem restrictₛₗ_restrict_eq (M : X.Modules) (W : X.Opens) (V : (↑W : Scheme.{u}).Opens)
    (h : V ≤ (⊤ : (↑W : Scheme.{u}).Opens))
    (h' : W.ι ''ᵁ V ≤ W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens))
    (w : Γ(M, W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens))) :
    (M.val.restrictₛₗ (homOfLE h').op w
        : Γ((Scheme.Modules.restrictFunctor W.ι).obj M, V))
      = ((Scheme.Modules.restrictFunctor W.ι).obj M).val.restrictₛₗ (homOfLE h).op w := rfl

/-- **A trivialisation of `M|_W` makes `θ⁻¹(1)` generate the sections of `M` over every open of
the form `j(V)`.** The section it names generates on the open subscheme
(`Stacks.ProjectiveBundleConormal.surjective_smul_isoUnit_inv_one`), restriction commutes with
naming it (`restrictₛₗ_isoUnit_inv_one`), and the two scalar actions are matched by
`surjective_smul_image_of_surjective_smul`. -/
theorem surjective_smul_restrictIsoUnit (M : X.Modules) (W : X.Opens)
    (θ : (Scheme.Modules.restrictFunctor W.ι).obj M ≅ 𝟙_ (↑W : Scheme.{u}).Modules)
    (V : (↑W : Scheme.{u}).Opens)
    (h' : W.ι ''ᵁ V ≤ W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens))
    (w : Γ(M, W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens)))
    (hw : w = θ.inv.val.app (op (⊤ : (↑W : Scheme.{u}).Opens))
      (1 : Γ((↑W : Scheme.{u}), (⊤ : (↑W : Scheme.{u}).Opens))))
    (z : Γ(M, W.ι ''ᵁ V)) (hz : z = M.val.restrictₛₗ (homOfLE h').op w) :
    Function.Surjective fun c : Γ(X, W.ι ''ᵁ V) => c • z := by
  refine surjective_smul_image_of_surjective_smul M W V z z rfl ?_
  refine surjective_smul_isoUnit_inv_one ((Scheme.Modules.restrictFunctor W.ι).obj M) θ V z ?_
  refine hz.trans (Eq.trans (restrictₛₗ_restrict_eq M W V le_top h' w) ?_)
  refine Eq.trans (congrArg (fun y : Γ((Scheme.Modules.restrictFunctor W.ι).obj M,
      (⊤ : (↑W : Scheme.{u}).Opens)) =>
        ((Scheme.Modules.restrictFunctor W.ι).obj M).val.restrictₛₗ
          (homOfLE (le_top : V ≤ (⊤ : (↑W : Scheme.{u}).Opens))).op y) hw) ?_
  exact restrictₛₗ_isoUnit_inv_one ((Scheme.Modules.restrictFunctor W.ι).obj M) θ le_top

/-- **A trivialisation of a restriction names a generator: the germ condition.** If `M` is an
invertible sheaf of modules on `X` and `θ : M|_W ≅ 𝒪_W` is a trivialisation of its restriction to
an open `W`, then at every point of `W` the germ of the section `θ⁻¹(1)` does not lie in
`𝔪_y M_y`.

This is the hypothesis that
`Stacks.SheafOfModules.exists_tensorPairing_eq_one_of_forall_germ_notMem_maximalIdeal_smul_top`
asks of a section before it produces the pairing partner, so with it a trivialisation of a
restriction yields the inverse factor that the hypothesis `hdown` of
`Stacks.ProjBundleInverseBaseChange.inverseTwistBaseChangeIso_inv_val_app` needs. At
`θ = Stacks.ProjectiveBundleConormal.restrictInverseTwistIso Q.L W τ` and
`M = 𝓛^{⊗ -1}` it says that the generator of the inverse twist named by
`Stacks.ProjectiveBundleConormal.restrictConormalSourceIsoTilde_inv_unit_toOpen` generates, which
is what the chart computation of [Stacks, Tag 0B3V] clause 3 was missing; the module is kept a
variable because `Submodule (ringStalk X y) (grpStalk X (Invertible.tensorPower …).val y)` has no
`Module` instance at that spelling — instance search finds the stalk module structure only for a
module variable over the root-namespace `structureSheafRing`, which is how both this statement and
its consumer are written.

Affineness of `W` is *not* needed, unlike in
`Stacks.ProjectiveBundleConormal.notMem_maximalSmul_germ_of_span_eq_top`: there generation is
known only over the one open and the passage to the stalk needs quasi-coherence, whereas a
trivialisation generates on arbitrarily small opens, and
`Stacks.SheafOfModules.notMem_maximalIdeal_smul_top_of_exists_surjective_smul` asks exactly for
that. -/
theorem notMem_maximalIdeal_smul_top_restrictIsoUnit_inv_one
    (M : _root_.SheafOfModules.{u} (_root_.structureSheafRing X.toRingedSpace))
    [Stacks.SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (_root_.structureSheafRing X.toRingedSpace).property M]
    (W : X.Opens)
    (θ : (Scheme.Modules.restrictFunctor W.ι).obj M ≅ 𝟙_ (↑W : Scheme.{u}).Modules)
    (y : X) (hy : y ∈ W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens)) :
    grpGerm X.toRingedSpace M.val y (W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens)) hy
        (θ.inv.val.app (op (⊤ : (↑W : Scheme.{u}).Opens))
          (1 : Γ((↑W : Scheme.{u}), (⊤ : (↑W : Scheme.{u}).Opens))))
      ∉ IsLocalRing.maximalIdeal (ringStalk X.toRingedSpace y) •
        (⊤ : Submodule (ringStalk X.toRingedSpace y)
          (grpStalk X.toRingedSpace M.val y)) := by
  have : ∀ z : X.toRingedSpace.carrier, IsLocalRing (ringStalk X.toRingedSpace z) :=
    fun z => inferInstance
  refine Stacks.SheafOfModules.notMem_maximalIdeal_smul_top_of_exists_surjective_smul
    (X := X.toRingedSpace) _ _ y hy fun V hyV => ?_
  obtain ⟨x, -, rfl⟩ := hy
  refine ⟨W.ι ''ᵁ (W.ι ⁻¹ᵁ V), ⟨x, hyV, rfl⟩, W.ι.image_preimage_le V,
    (W.ι.opensFunctor.map (homOfLE (le_top : W.ι ⁻¹ᵁ V ≤ ⊤))).le, ?_⟩
  exact surjective_smul_restrictIsoUnit M W θ (W.ι ⁻¹ᵁ V) _ _ rfl _ rfl

/-- **The same germ condition for the generator read on a smaller open.** The section
`Stacks.ProjectiveBundleConormal.notMem_maximalIdeal_smul_top_restrictIsoUnit_inv_one` speaks
about lives over `j(⊤)` for `j = W.ι`, and that open is `W` only up to
`AlgebraicGeometry.Scheme.Opens.ι_image_top` — equal as opens, not the same term. A consumer whose
other data lives over `W` itself therefore meets the *restriction* of the generator, and this is
the germ condition for it: germs are unchanged by restriction
(`TopCat.Presheaf.germ_res_apply`), so the statement at the point applies verbatim.

The open `U` and the inequality `U ≤ j(⊤)` are parameters rather than `W` and
`(AlgebraicGeometry.Scheme.Opens.ι_image_top W).ge`, and the section is a variable `w` named by
the equation `hw`, for the transparency reason in this module's implementation notes: the consumer
instantiates both from its own goal. -/
theorem notMem_maximalIdeal_smul_top_restrictIsoUnit_res
    (M : _root_.SheafOfModules.{u} (_root_.structureSheafRing X.toRingedSpace))
    [Stacks.SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (_root_.structureSheafRing X.toRingedSpace).property M]
    (W : X.Opens)
    (θ : (Scheme.Modules.restrictFunctor W.ι).obj M ≅ 𝟙_ (↑W : Scheme.{u}).Modules)
    (U : X.Opens) (hU : U ≤ W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens)) (w : M.val.obj (op U))
    (hw : w = M.val.restrictₛₗ (homOfLE hU).op
      (θ.inv.val.app (op (⊤ : (↑W : Scheme.{u}).Opens))
        (1 : Γ((↑W : Scheme.{u}), (⊤ : (↑W : Scheme.{u}).Opens)))))
    (y : X) (hy : y ∈ U) :
    grpGerm X.toRingedSpace M.val y U hy w ∉
      IsLocalRing.maximalIdeal (ringStalk X.toRingedSpace y) •
        (⊤ : Submodule (ringStalk X.toRingedSpace y)
          (grpStalk X.toRingedSpace M.val y)) := by
  have hres : grpGerm X.toRingedSpace M.val y U hy w
      = grpGerm X.toRingedSpace M.val y (W.ι ''ᵁ (⊤ : (↑W : Scheme.{u}).Opens)) (hU hy)
        (θ.inv.val.app (op (⊤ : (↑W : Scheme.{u}).Opens))
          (1 : Γ((↑W : Scheme.{u}), (⊤ : (↑W : Scheme.{u}).Opens)))) :=
    (congrArg (grpGerm X.toRingedSpace M.val y U hy) hw).trans
      (TopCat.Presheaf.germ_res_apply (C := AddCommGrpCat.{u}) M.val.presheaf (homOfLE hU) y hy _)
  exact hres ▸ notMem_maximalIdeal_smul_top_restrictIsoUnit_inv_one M W θ y (hU hy)

end Generator

