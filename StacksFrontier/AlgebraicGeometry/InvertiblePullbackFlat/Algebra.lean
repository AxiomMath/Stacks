module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import StacksFrontier.RingTheory.DiscreteValuationRing.TFAE
public import StacksFrontier.RingTheory.Flat.ShortExact
public import StacksFrontier.RingTheory.Ideal.Invertible
public import StacksFrontier.RingTheory.Ideal.SymbolicPower
import StacksCore.Tactic.StacksAttribute

/-!
# Ideals along a flat algebra, for invertible modules pulled back from the base

The affine step in the proof of Stacks Tag 0BD7 manipulates ideals of a Noetherian normal
domain `R` along a faithfully flat algebra `A`. This file collects the four ring-theoretic
facts it uses which are not themselves Stacks lemmas, each assembled from one that is.

The first is that extension of ideals along a flat algebra commutes with finite intersections.
Stacks Tag 0BBY gives the binary case as the equality `IM ∩ JM = (I ∩ J)M` for a flat module
`M`; taking `M = A` and iterating gives the statement for a `Finset`-indexed family, which is
how Tag 0BD7 uses it, applied to a family of symbolic powers of the minimal primes over an
element. Combined with Tag 0BC0, which identifies the extension of a symbolic power with the
symbolic power of the extension, this gives
`(⋂ᵢ pᵢ^(eᵢ)) A = ⋂ᵢ (pᵢ A)^(eᵢ)`.

The second is a descent: Tag 0BD7 establishes `I A · I' A = f A` and concludes `I I' = (f)`
by faithful flatness, so that Tag 09ME applies over `R` rather than over `A`.

The third is the "ramification index `1`" observation. If `R` is a discrete valuation ring and
`A` is a Noetherian local domain containing `R` with `m_R A = m_A`, then `A` is again a discrete
valuation ring — the maximal ideal of `A` is generated by the image of a uniformizer of `R` —
and the valuation of an element of `R` is the same computed in `R` or in `A`.

## Main results

* `Ideal.map_inf_of_flat`, `Ideal.map_finsetInf_of_flat`: extension of ideals along a flat
  algebra commutes with finite intersections.
* `Ideal.map_finsetInf_symbolicPower_of_flat`: the same for a finite family of symbolic powers
  of primes whose extensions stay prime.
* `Ideal.invertible_of_map_mul_map_eq_span_singleton`: faithfully flat descent of Tag 09ME.
* `isDiscreteValuationRing_of_maximalIdeal_eq_map`: a Noetherian local domain whose maximal
  ideal is the extension of the maximal ideal of a discrete valuation ring is a discrete
  valuation ring.
* `IsDiscreteValuationRing.addVal_algebraMap`: and the valuation of an element of the base is
  unchanged, so the extension is unramified.

## References

* [Stacks Project, Tag 0BD7](https://stacks.math.columbia.edu/tag/0BD7)
* [Stacks Project, Tag 0BBY](https://stacks.math.columbia.edu/tag/0BBY)
* [Stacks Project, Tag 0BC0](https://stacks.math.columbia.edu/tag/0BC0)
* [Stacks Project, Tag 09ME](https://stacks.math.columbia.edu/tag/09ME)
* [Stacks Project, Tag 00PD](https://stacks.math.columbia.edu/tag/00PD)
-/

@[expose] public section

universe u

open IsLocalRing

namespace Ideal

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Extension of ideals along a flat algebra commutes with intersection. This is Stacks Tag
0BBY for the flat module `A`, read as a statement about ideals. -/
theorem map_inf_of_flat [Module.Flat R A] (I J : Ideal R) :
    (I ⊓ J).map (algebraMap R A) = I.map (algebraMap R A) ⊓ J.map (algebraMap R A) := by
  refine le_antisymm (le_inf (map_mono inf_le_left) (map_mono inf_le_right)) fun x hx => ?_
  have hx' : x ∈ (I • (⊤ : Submodule R A)) ⊓ (J • (⊤ : Submodule R A)) := by
    rw [Ideal.smul_top_eq_map, Ideal.smul_top_eq_map]
    exact ⟨hx.1, hx.2⟩
  rw [ideal_smul_top_inf, Ideal.smul_top_eq_map] at hx'
  exact hx'

/-- Extension of ideals along a flat algebra commutes with finite intersections. -/
theorem map_finsetInf_of_flat [Module.Flat R A] {ι : Type*} (t : Finset ι) (I : ι → Ideal R) :
    (t.inf I).map (algebraMap R A) = t.inf fun i => (I i).map (algebraMap R A) := by
  classical
  induction t using Finset.induction with
  | empty => simp [Ideal.map_top]
  | insert a t _ ih =>
      rw [Finset.inf_insert, Finset.inf_insert, map_inf_of_flat, ih]

/-- The extension along a flat algebra of a finite intersection of symbolic powers of primes
whose extensions remain prime is the intersection of the symbolic powers of the extensions.
This is the combination of Stacks Tags 0BBY and 0BC0 used in the affine step of Tag 0BD7. -/
theorem map_finsetInf_symbolicPower_of_flat [Module.Flat R A] {ι : Type*} (t : Finset ι)
    (p : ι → Ideal R) [∀ i, (p i).IsPrime]
    [∀ i, ((p i).map (algebraMap R A)).IsPrime] (e : ι → ℕ) :
    (t.inf fun i => symbolicPower' (p i) (e i)).map (algebraMap R A)
      = t.inf fun i => symbolicPower' ((p i).map (algebraMap R A)) (e i) := by
  rw [map_finsetInf_of_flat]
  refine congrArg t.inf (funext fun i => ?_)
  exact symbolicPower_map_of_flat (algebraMap R A)
    (RingHom.flat_algebraMap_iff.mpr inferInstance) (p i) inferInstance (e i)

/-- **Faithfully flat descent of Stacks Tag 09ME.** If the extensions of two ideals `I`, `J` of
`R` to a faithfully flat algebra `A` have product the ideal generated by the image of a
nonzerodivisor `f ∈ R`, then `I` is an invertible `R`-module. -/
theorem invertible_of_map_mul_map_eq_span_singleton [Module.FaithfullyFlat R A] {I J : Ideal R}
    {f : R} (hf : f ∈ nonZeroDivisors R)
    (h : I.map (algebraMap R A) * J.map (algebraMap R A) = Ideal.span {algebraMap R A f}) :
    Module.Invertible R I := by
  refine invertible_of_mul_eq_span_singleton (J := J) hf
    (Ideal.map_injective_of_faithfullyFlat (B := A) (a₁ := I * J) (a₂ := Ideal.span {f}) ?_)
  rw [Ideal.map_mul, h, Ideal.map_span]
  simp

end Ideal

/-- If the maximal ideal of `R` extends to that of `A`, a uniformizer of `R` generates the maximal
ideal of `A` and has nonzero image. -/
private theorem maximalIdeal_eq_span_algebraMap {R A : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing A] [IsLocalRing A] [Algebra R A] [FaithfulSMul R A]
    (h : (maximalIdeal R).map (algebraMap R A) = maximalIdeal A) {π : R} (hπ : Irreducible π) :
    maximalIdeal A = Ideal.span {algebraMap R A π} ∧ algebraMap R A π ≠ 0 := by
  refine ⟨?_, fun hc => hπ.ne_zero (FaithfulSMul.algebraMap_injective R A (by simpa using hc))⟩
  rw [← h, hπ.maximalIdeal_eq, Ideal.map_span]
  simp

/-- A Noetherian local domain whose maximal ideal is the extension of the maximal ideal of a
discrete valuation ring is itself a discrete valuation ring. This is Stacks Tag 00PD, item (4)
implies item (1): the maximal ideal is generated by the image of a uniformizer, which is
nonzero because the algebra map is injective. -/
theorem isDiscreteValuationRing_of_maximalIdeal_eq_map {R A : Type u} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing A] [IsDomain A] [IsLocalRing A] [IsNoetherianRing A]
    [Algebra R A] [FaithfulSMul R A]
    (h : (maximalIdeal R).map (algebraMap R A) = maximalIdeal A) :
    IsDiscreteValuationRing A := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨hspan, hπ0⟩ := maximalIdeal_eq_span_algebraMap h hπ
  have hbot : maximalIdeal A ≠ ⊥ := by
    simpa [hspan, Ideal.span_singleton_eq_bot] using hπ0
  have h4 : ∃ _ : IsLocalRing A, IsNoetherianRing A ∧ IsDomain A ∧
      (maximalIdeal A).IsPrincipal ∧ maximalIdeal A ≠ ⊥ :=
    ⟨‹IsLocalRing A›, ‹IsNoetherianRing A›, ‹IsDomain A›, ⟨⟨_, hspan⟩⟩, hbot⟩
  obtain ⟨_, hdvr⟩ := ((isDiscreteValuationRing_tfae A).out 4 1).mp h4
  exact hdvr

/-- The extension of discrete valuation rings in `isDiscreteValuationRing_of_maximalIdeal_eq_map`
is unramified: the valuation of an element of the base is the same computed upstairs. -/
theorem IsDiscreteValuationRing.addVal_algebraMap {R A : Type u} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing A] [IsDomain A] [IsLocalRing A] [IsNoetherianRing A]
    [Algebra R A] [FaithfulSMul R A]
    (h : (maximalIdeal R).map (algebraMap R A) = maximalIdeal A) (x : R) :
    haveI := isDiscreteValuationRing_of_maximalIdeal_eq_map h
    addVal A (algebraMap R A x) = addVal R x := by
  have := isDiscreteValuationRing_of_maximalIdeal_eq_map (R := R) (A := A) h
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨hspan, hπ0⟩ := maximalIdeal_eq_span_algebraMap h hπ
  have hirr : Irreducible (algebraMap R A π) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hπ0 hspan
  rcases eq_or_ne x 0 with rfl | hx
  · simp
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx hπ
  rw [addVal_def' u hπ n, map_mul, map_pow]
  exact addVal_def _ (Units.map (algebraMap R A : R →* A) u) hirr n (by simp)

end
