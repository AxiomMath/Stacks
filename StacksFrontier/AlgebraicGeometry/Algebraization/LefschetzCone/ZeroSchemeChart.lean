module

public import StacksFrontier.AlgebraicGeometry.Morphisms.AmpleNonvanishingUniversallyClosed
public import StacksFrontier.AlgebraicGeometry.SectionRingChartMap.Multiplicative
public import StacksFrontier.AlgebraicGeometry.TensorPowerDivision.Basic
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemePower
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.SectionPowerThickenings

/-!
# The zero scheme of a section on a chart of consecutive degrees

Let `X` be a scheme, `L` an invertible `𝒪_X`-module and `s ∈ Γ(X, L)`. Write `f ∈ Γ_*(X, L)_1` for
`s` read in degree one of the section ring. Let `c` and `b` be global sections of `L^{⊗ (m+1)}` and
`L^{⊗ m}`, and let `U` be an affine open on which neither vanishes. On `U` the quotient `e = c / b`
is a section of `L` which generates it freely, and `s = (bf / c) · e`. Hence the ideal of the zero
scheme `Z(s)` on `U` is generated by the single function

`bf / c`,

the ratio of two global sections of `L^{⊗ (m + 1)}`. In terms of the chart `D₊(cb)` of
`Proj Γ_*(X, L)` this is the function `f b² / (cb)`, the chart ratio of
`Stacks.DegreeOneUnitAway.chartRatio`.

This is the description of the ideal of the zero scheme of `s` in which the cone over a projective
scheme computes it, and it is what lets the infinitesimal neighbourhoods of `Z(s)` be read on the
punctured affine cone in the proof of Stacks 0EL5.

## Main definitions

* `Stacks.LefschetzCone.degreeOneSection`: the element of `Γ(X, L^{⊗ 1})` attached to `s`.

## Main results

* `Stacks.LefschetzCone.zeroScheme_ideal_eq_span_ratio`: the ideal of `Z(s)` on `U` is generated
  by `bf / c`.

## Implementation notes

The quotient `c / b` is produced by the bijectivity of multiplication by a nonvanishing section
across degrees, `Stacks.TensorPowerDivision.bijective_app_mulMap`, so no trivialization of `L` has
to be chosen: the generator is determined by `c` and `b`. The first tensor power `L^{⊗ 1}` is
`𝟙 ⊗ L`, and the left unitor `Stacks.AmpleNonvanishingUniversallyClosed.oneIso` carries the
generator to `L` itself, where the zero scheme lives.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite MonoidalCategory
open Stacks.TensorPowers (natTensorPow)
open Stacks.GradedSections (powSections mulMap mul)
open Stacks.SectionProduct (globalSection)
open Stacks.AmpleFiniteAvoidance (nvOpen)
open Stacks.TensorPowerTrivialize (resTop trivEquiv resTop_app resTop_globalSection_mul)
open Stacks.SectionRingChartMap (ratio ratio_smul_resTop)
open Stacks.AmpleNonvanishingUniversallyClosed (oneIso)

universe u

namespace Stacks.LefschetzCone

section Monoidal

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- **A global section of `L`, read in degree one of the section ring** `Γ_*(X, L)`, through the
left unitor `L^{⊗ 1} = 𝟙 ⊗ L ≅ L`. -/
def degreeOneSection (s : Γ(L, ⊤)) : powSections L 1 :=
  (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X (natTensorPow L 1)).symm
    ((oneIso L).inv.app ⊤ s)

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The global section of `L^{⊗ 1}` underlying `degreeOneSection L s` is the image of `s` under
the inverse of the left unitor `L^{⊗ 1} ≅ L`. -/
theorem globalSection_degreeOneSection (s : Γ(L, ⊤)) :
    globalSection X (natTensorPow L 1) (degreeOneSection L s) = (oneIso L).inv.app ⊤ s :=
  (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X
    (natTensorPow L 1)).apply_symm_apply _

/-- **The ideal of the zero scheme on a chart of consecutive degrees.** Let `c` and `b` be global
sections of `L^{⊗ (m + 1)}` and `L^{⊗ m}` and `U` an affine open inside both nonvanishing opens.
Then on `U` the ideal of the zero scheme of `s` is generated by the ratio `bf / c`, `f` being `s`
read in degree one. -/
theorem zeroScheme_ideal_eq_span_ratio {m : ℕ} (c : powSections L (m + 1)) (b : powSections L m)
    (s : Γ(L, ⊤)) (U : X.affineOpens) (hc : U.1 ≤ nvOpen L c) (hb : U.1 ≤ nvOpen L b) :
    (zeroScheme X L s).ideal U =
      Ideal.span {ratio L c hc (mul b (degreeOneSection L s))} := by
  set V : X.Opens := U.1
  have hmul : Function.Bijective ((mulMap b 1).app V) :=
    Stacks.TensorPowerDivision.bijective_app_mulMap L b hb 1 V le_rfl
  obtain ⟨e, he⟩ := hmul.2 (resTop (natTensorPow L (m + 1)) (globalSection X _ c) V)
  have hgen : Function.Bijective (fun r : Γ(X, V) => r • e) := by
    have htriv : Function.Bijective
        (fun r : Γ(X, V) => r • resTop (natTensorPow L (m + 1)) (globalSection X _ c) V) :=
      (trivEquiv (natTensorPow L (m + 1)) (globalSection X _ c) hc).bijective
    have hcomp : ((mulMap b 1).app V) ∘ (fun r : Γ(X, V) => r • e) =
        fun r : Γ(X, V) => r • resTop (natTensorPow L (m + 1)) (globalSection X _ c) V := by
      funext r
      simp only [Function.comp_apply, Scheme.Modules.Hom.app_smul, he]
    exact (Function.Bijective.of_comp_iff' hmul _).mp (hcomp ▸ htriv)
  have hf : resTop (natTensorPow L 1) (globalSection X _ (degreeOneSection L s)) V =
      ratio L c hc (mul b (degreeOneSection L s)) • e := by
    apply hmul.1
    rw [Scheme.Modules.Hom.app_smul, he, ← resTop_globalSection_mul, ratio_smul_resTop]
  let φ := (oneIso L).hom.app V
  have hφ : Function.Bijective φ :=
    (ConcreteCategory.isIso_iff_bijective _).mp (inferInstance : IsIso ((oneIso L).hom.app V))
  refine zeroScheme_ideal_eq_span_singleton_of_bijective_smul X L s U (φ e) ?_ _ ?_
  · have hcomp : (fun r : Γ(X, V) => r • φ e) = φ ∘ (fun r : Γ(X, V) => r • e) :=
      funext fun r => (Scheme.Modules.Hom.app_smul (oneIso L).hom r e).symm
    rw [hcomp]
    exact hφ.comp hgen
  · have hs : L.presheaf.map (homOfLE le_top).op s =
        φ (resTop (natTensorPow L 1) (globalSection X _ (degreeOneSection L s)) V) := by
      have hinv : (oneIso L).hom.app ⊤ ((oneIso L).inv.app ⊤ s) = s := by
        rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, Iso.inv_hom_id,
          Scheme.Modules.Hom.id_app]
        rfl
      rw [globalSection_degreeOneSection, ← resTop_app, hinv]
    rw [hs, hf]
    exact Scheme.Modules.Hom.app_smul (oneIso L).hom _ e

end Monoidal

end Stacks.LefschetzCone

end
