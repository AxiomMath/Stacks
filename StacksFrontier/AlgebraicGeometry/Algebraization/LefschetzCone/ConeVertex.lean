module

public import StacksFrontier.AlgebraicGeometry.Algebraization.LefschetzCone.FiniteSheaves
public import StacksFrontier.AlgebraicGeometry.ProperGeomConnected.Basic

/-!
# The vertex of the affine cone over a proper scheme

Let `X` be proper over a field `k` and `L` an ample invertible `𝒪_X`-module, with section ring
`A = Γ_*(X, L)`, a `k`-algebra through `k → Γ(X, 𝒪_X) = A₀`. Since `Γ(X, 𝒪_X)` is integral over
`k`, so is `A₀`, and every prime of `A` containing the irrelevant ideal `A₊` is maximal: the
quotient by it is a domain generated by the image of `A₀`, hence a field. In the algebraization
situation of the proof of Stacks 0EL5 these are the points of `Z`, the vertex of the cone, which
are therefore closed points.

## Main results

* `Stacks.LefschetzCone.isMaximal_of_irrelevant_le`
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory MonoidalCategory
open Stacks.GradedSections (powSections sectionRing)
open Stacks.AmpleFiniteAvoidance (grading)

universe u

namespace Stacks.LefschetzCone

section Monoidal

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} {k : Type u} [Field k] (fX : X ⟶ Spec (CommRingCat.of k)) (L : X.Modules)
  [Stacks.Ample.IsInvertibleModule X L]

/-- The structure map `k → Γ(X, 𝒪_X) → Γ_*(X, L)`. -/
abbrev sectionRingStructureMap : k →+* sectionRing L :=
  (Stacks.SectionRingZero.sectionRingZeroHom X L).comp
    (Stacks.AlgebraicGeometry.GradedProperCohomology.specAlgebraRingHom k fX)

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- Every element of degree zero comes from a global function. -/
theorem exists_sectionRingZeroHom_eq {a : sectionRing L} (ha : a ∈ grading L 0) :
    ∃ x : Γ(X, ⊤), Stacks.SectionRingZero.sectionRingZeroHom X L x = a := by
  obtain ⟨t, rfl⟩ := ha
  let t' : 𝟙_ X.Modules ⟶ 𝟙_ X.Modules := t
  refine ⟨Stacks.SectionRingGeometric.unitScalarAddEquiv X t', ?_⟩
  exact congrArg (DirectSum.of (powSections L) 0)
    ((Stacks.SectionRingGeometric.unitScalarAddEquiv X).symm_apply_apply t')

/-- **Every prime of the section ring containing the irrelevant ideal is maximal**, for `X` proper
over a field. -/
public theorem isMaximal_of_irrelevant_le [IsProper fX] (q : Ideal (sectionRing L)) [q.IsPrime]
    (hq : (HomogeneousIdeal.irrelevant (grading L)).toIdeal ≤ q) : q.IsMaximal := by
  let : Algebra k (sectionRing L ⧸ q) :=
    ((Ideal.Quotient.mk q).comp (sectionRingStructureMap fX L)).toAlgebra
  have hint := Stacks.AlgebraicGeometry.ProperGeomConnected.isIntegral_toSpecΓ_algebraMap fX
  have : Algebra.IsIntegral k (sectionRing L ⧸ q) := by
    refine ⟨fun y => ?_⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    -- `a` agrees with its degree-zero component modulo `A₊ ⊆ q`
    have h0 : Ideal.Quotient.mk q a = Ideal.Quotient.mk q
        (DirectSum.decompose (grading L) a 0 : sectionRing L) := by
      rw [Ideal.Quotient.eq]
      apply hq
      change GradedRing.proj (grading L) 0 _ = 0
      rw [GradedRing.proj_apply, DirectSum.decompose_sub,
        DirectSum.decompose_coe, DirectSum.sub_apply, DirectSum.of_eq_same,
        AddSubgroupClass.coe_sub, sub_self]
    obtain ⟨x, hx⟩ := exists_sectionRingZeroHom_eq L (DirectSum.decompose (grading L) a 0).2
    rw [h0, ← hx]
    let : Algebra k Γ(X, ⊤) :=
      (Stacks.AlgebraicGeometry.GradedProperCohomology.specAlgebraRingHom k fX).toAlgebra
    have hxint : _root_.IsIntegral k x := hint x
    let φ : Γ(X, ⊤) →ₐ[k] sectionRing L ⧸ q :=
      { toRingHom := (Ideal.Quotient.mk q).comp (Stacks.SectionRingZero.sectionRingZeroHom X L)
        commutes' := fun _ => rfl }
    exact hxint.map φ
  rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
  exact isField_of_isIntegral_of_isField' (Field.toIsField k)

end Monoidal

end Stacks.LefschetzCone

end
