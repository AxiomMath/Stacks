universe u

namespace Stacks.LefschetzCone

section Graded

variable {A : Type*} [CommRing A] {σ : Type*} [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **An idempotent multiple of an element of degree one vanishes**: it lies in `(fⁿ)` for every
`n`, so its components below every degree vanish. -/
theorem eq_zero_of_isIdempotentElem_of_mem_span {e f : A} (hf : f ∈ 𝒜 1)
    (he : IsIdempotentElem e) (hef : e ∈ Ideal.span {f}) : e = 0 := by
  classical
  have hcomp : ∀ i : ℕ, (DirectSum.decompose 𝒜 e i : A) = 0 := by
    intro i
    have hpow : e = e ^ (i + 1) := (IsIdempotentElem.pow_succ_eq i he).symm
    have hmem : e ^ (i + 1) ∈ Ideal.span {f ^ (i + 1)} := by
      rw [← Ideal.span_singleton_pow]
      exact Ideal.pow_mem_pow hef _
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hmem
    rw [hpow, ← ha]
    exact DirectSum.coe_decompose_mul_of_right_mem_of_not_le 𝒜
      (SetLike.pow_mem_graded (i + 1) hf) (by simp)
  rw [← DirectSum.sum_support_decompose 𝒜 e]
  exact Finset.sum_eq_zero fun i _ => hcomp i

/-- **An element of degree one whose zero locus is open and closed is nilpotent.** -/
theorem isNilpotent_of_isClopen_zeroLocus {f : A} (hf : f ∈ 𝒜 1)
    (h : IsClopen (PrimeSpectrum.zeroLocus ({f} : Set A))) : IsNilpotent f := by
  obtain ⟨e, he, hfe⟩ := PrimeSpectrum.isClopen_iff_zeroLocus.mp h
  have hrad : (Ideal.span {f}).radical = (Ideal.span {e}).radical := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, PrimeSpectrum.zeroLocus_span,
      PrimeSpectrum.zeroLocus_span, hfe]
  have hmem : ∀ {x y : A}, (Ideal.span {x}).radical = (Ideal.span {y}).radical →
      y ∈ (Ideal.span {x}).radical := fun h =>
    h ▸ Ideal.le_radical (Ideal.mem_span_singleton_self _)
  have he' : e ∈ Ideal.span {f} := by
    obtain ⟨n, hn⟩ := hmem hrad
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · rw [pow_zero] at hn
      simpa using Ideal.mul_mem_left _ e hn
    · rwa [IsIdempotentElem.pow_eq he hpos.ne'] at hn
  have he0 : e = 0 := eq_zero_of_isIdempotentElem_of_mem_span 𝒜 hf he he'
  obtain ⟨n, hn⟩ := hmem hrad.symm
  exact ⟨n, by simpa [he0] using hn⟩

/-- **A degree-one element with `cd(A, (f)) ≤ 0` is nilpotent.** -/
theorem isNilpotent_of_cohomologicalDimension_le_zero {f : A} (hf : f ∈ 𝒜 1)
    (hfg : (Ideal.span ({f} : Set A)).FG)
    (h : Stacks.LocalCohomology.cohomologicalDimension A (Ideal.span {f}) hfg ≤ 0) :
    IsNilpotent f := by
  have hcl := (Stacks.LocalCohomology.isClopen_zeroLocus_iff_cohomologicalDimension_le_zero A
    (Ideal.span {f}) hfg).mp h
  rw [PrimeSpectrum.zeroLocus_span] at hcl
  exact isNilpotent_of_isClopen_zeroLocus 𝒜 hf hcl

omit [SetLike σ A] [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- **A principal ideal has cohomological dimension at most one**, hence either at most zero or
exactly one. -/
theorem cohomologicalDimension_span_singleton_le_zero_or_eq_one (f : A)
    (hfg : (Ideal.span ({f} : Set A)).FG) :
    Stacks.LocalCohomology.cohomologicalDimension A (Ideal.span {f}) hfg ≤ 0 ∨
      Stacks.LocalCohomology.cohomologicalDimension A (Ideal.span {f}) hfg = 1 := by
  have h := Stacks.LocalCohomology.cohomologicalDimension_le_card_generators A
    (Ideal.span {f}) hfg (n := 1) ![f] (by simp)
  omega

end Graded

section Monoidal

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
  (hL : Stacks.Ample.IsAmple X L) [IsIso (projHomOfIsAmple L hL)] (s : Γ(L, ⊤))

omit [IsIso (projHomOfIsAmple L hL)] in
/-- A power of `f` vanishing makes the same power of every chart ratio vanish. -/
theorem chartRatioOf_pow_eq_zero {k : ℕ} (hk : sectionElt L s ^ k = 0) (ch : ConsecutiveChart L) :
    chartRatioOf L s ch ^ k = 0 := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_pow, Stacks.DegreeOneUnitAway.val_chartRatio, Localization.mk_pow,
    HomogeneousLocalization.val_zero, mul_pow, hk, zero_mul, Localization.mk_zero]

include hL in
/-- **A nilpotent section makes the ideal of its zero scheme nilpotent**: `𝓘ᵏ M = 0` for every
quasi-coherent `M` once `fᵏ = 0`. -/
theorem idealPowerMultiple_eq_bot_of_pow_eq_zero {k : ℕ} (hk : sectionElt L s ^ k = 0)
    (M : X.Modules) [M.IsQuasicoherent] :
    Stacks.Algebraization.idealPowerMultiple (zeroScheme X L s) k M = ⊥ := by
  refine submodule_eq_of_isBasis (isBasis_consecutiveChart L hL) fun ch => ?_
  rw [show (Stacks.Algebraization.idealPowerMultiple (zeroScheme X L s) k M).obj (op ch.nv) =
      (Stacks.Algebraization.idealPowerMultiple (zeroScheme X L s) k M).toSubmodule.obj
        (op (ch.affineOpen hL).1) from rfl,
    Stacks.Algebraization.idealPowerMultiple_toSubmodule_obj_affine,
    zeroScheme_ideal_consecutiveChart L hL s ch, Ideal.span_singleton_pow, ← map_pow]
  have h0 : Stacks.DegreeOneUnitAway.chartRatio ch.cR_mem ch.bR_mem ch.cR_mul_bR
      (Stacks.ExternalGrading.of_mem_summand 1 (degreeOneSection L s)) ^ k = 0 :=
    chartRatioOf_pow_eq_zero L s hk ch
  rw [h0, map_zero, Ideal.span_singleton_eq_bot.2 rfl, Submodule.bot_smul]
  exact (Stacks.Algebraization.bot_submodule_obj_eq_bot M _).symm

include hL in
/-- **With `f` nilpotent, every object of `Coh(X, 𝓘)` is the completion of a coherent module**
([Stacks, Tag 0EHP]: it is the completion of one of its own terms). -/
public theorem isCompletionOfCoherent_of_isNilpotent [IsLocallyNoetherian X]
    (hnil : IsNilpotent (sectionElt L s))
    (F : Stacks.Coherent.CoherentAdicSystems (zeroScheme X L s)) :
    Stacks.Algebraization.IsCompletionOfCoherent (zeroScheme X L s) F := by
  obtain ⟨k, hk⟩ := hnil
  have hann : Stacks.Algebraization.IsSystemPowerAnnihilated (zeroScheme X L s) F.obj :=
    ⟨k, fun n => by
      have := F.property.isQuasicoherent n
      exact idealPowerMultiple_eq_bot_of_pow_eq_zero L hL s hk _⟩
  obtain ⟨G, ⟨e⟩⟩ :=
    Stacks.Algebraization.mem_essImage_completionFunctor_of_isSystemPowerAnnihilated X _ F hann
  exact ⟨G, ⟨(ObjectProperty.ι _).mapIso e⟩⟩

end Monoidal

end Stacks.LefschetzCone

