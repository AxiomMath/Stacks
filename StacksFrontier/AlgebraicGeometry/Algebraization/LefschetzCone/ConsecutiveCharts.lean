module

public import StacksFrontier.AlgebraicGeometry.Algebraization.LefschetzCone.ZeroSchemeChart
public import StacksFrontier.AlgebraicGeometry.Algebraization.LefschetzCone.ChartSections
public import StacksFrontier.AlgebraicGeometry.SectionRingVeroneseChart.DegreeOne
public import StacksFrontier.RingTheory.GradedAlgebra.Proj.DegreeOneUnitAway

/-!
# Charts of consecutive degrees on a scheme with an ample invertible module

Let `X` be a scheme with an ample invertible `𝒪_X`-module `L` and graded section ring
`A = Γ_*(X, L)`. A **chart of consecutive degrees** is a pair of global sections `c` of
`L^{⊗ (m + 1)}` and `b` of `L^{⊗ m}`; its open is the nonvanishing open `X_{cb} = X_c ∩ X_b`. On
it the localization `A[1/cb]` has the unit `c² / (cb)` of degree one
(`Stacks.DegreeOneUnitAway`), which is what makes these charts the right ones for comparing `X`
with the punctured affine cone over it.

This file proves that the charts of consecutive degrees form a basis of the topology of `X`
(using that the nonvanishing opens of sections cover `X` in every large degree, a consequence of
ampleness), and that on such a chart the ideal of the zero scheme of a global section `s` of `L` is
generated by the image under the chart ring map of the chart ratio `f b² / (cb)`,
`f ∈ A₁` being `s`.

## Main definitions

* `Stacks.LefschetzCone.ConsecutiveChart`: a chart of consecutive degrees.
* `Stacks.LefschetzCone.ConsecutiveChart.toGoodChart`: the chart as a chart of `Proj A`.

## Main results

* `Stacks.LefschetzCone.isBasis_consecutiveChart`: the charts of consecutive degrees form a basis.
* `Stacks.LefschetzCone.zeroScheme_ideal_consecutiveChart`: the ideal of `Z(s)` on a chart.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open Stacks.TensorPowers (natTensorPow)
open Stacks.GradedSections (powSections mul sectionRing)
open Stacks.AmpleFiniteAvoidance (nvOpen grading)
open Stacks.SectionRingProjMorphism (projHomOfIsAmple)
open Stacks.SectionRingChartMap (ratio ratioR ratioR_of ratioR_mul of_mul_eq)

universe u

namespace Stacks.LefschetzCone

section Monoidal

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- **A chart of consecutive degrees**: global sections `c` of `L^{⊗ (m+1)}` and `b` of `L^{⊗ m}`.
Its open is `X_{cb}`. -/
structure ConsecutiveChart (L : X.Modules) where
  /-- The smaller of the two degrees. -/
  m : ℕ
  /-- The section of degree `m + 1`. -/
  c : powSections L (m + 1)
  /-- The section of degree `m`. -/
  b : powSections L m

namespace ConsecutiveChart

variable {L}

/-- The product `cb`, a section of `L^{⊗ (2m + 1)}`. -/
abbrev prod (ch : ConsecutiveChart L) : powSections L (ch.m + 1 + ch.m) := mul ch.c ch.b

/-- The open `X_{cb}` of a chart. -/
abbrev nv (ch : ConsecutiveChart L) : X.Opens := nvOpen L ch.prod

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The degree `2m + 1` of the product is positive. -/
theorem deg_pos (ch : ConsecutiveChart L) : 0 < ch.m + 1 + ch.m := by omega

/-- The section `c`, read in the section ring. -/
abbrev cR (ch : ConsecutiveChart L) : sectionRing L := DirectSum.of (powSections L) (ch.m + 1) ch.c

/-- The section `b`, read in the section ring. -/
abbrev bR (ch : ConsecutiveChart L) : sectionRing L := DirectSum.of (powSections L) ch.m ch.b

/-- The product `cb`, read in the section ring. -/
abbrev gR (ch : ConsecutiveChart L) : sectionRing L :=
  DirectSum.of (powSections L) (ch.m + 1 + ch.m) ch.prod

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The element `c` of the section ring is homogeneous of degree `m + 1`. -/
theorem cR_mem (ch : ConsecutiveChart L) : ch.cR ∈ grading L (ch.m + 1) :=
  Stacks.ExternalGrading.of_mem_summand _ _

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The element `b` of the section ring is homogeneous of degree `m`. -/
theorem bR_mem (ch : ConsecutiveChart L) : ch.bR ∈ grading L ch.m :=
  Stacks.ExternalGrading.of_mem_summand _ _

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- In the section ring, the product of `c` and `b` is the section `cb`. -/
theorem cR_mul_bR (ch : ConsecutiveChart L) : ch.cR * ch.bR = ch.gR :=
  (of_mul_eq L ch.c ch.b).symm

/-- The open `X_{cb}` of a chart is contained in `X_c`. -/
theorem nv_le_c (ch : ConsecutiveChart L) : ch.nv ≤ nvOpen L ch.c := by
  rw [nv, Stacks.SectionRingChartMap.nvOpen_mul]; exact inf_le_left

/-- The open `X_{cb}` of a chart is contained in `X_b`. -/
theorem nv_le_b (ch : ConsecutiveChart L) : ch.nv ≤ nvOpen L ch.b := by
  rw [nv, Stacks.SectionRingChartMap.nvOpen_mul]; exact inf_le_right

variable (hL : Stacks.Ample.IsAmple X L)

/-- The chart as a chart of `Proj A`, when the canonical morphism is an isomorphism. -/
abbrev toGoodChart [IsIso (projHomOfIsAmple L hL)] (ch : ConsecutiveChart L) :
    Stacks.SectionRingProjQuasicoherent.GoodChart L hL :=
  ⟨⟨ch.m + 1 + ch.m, ch.deg_pos, ch.prod⟩, by
    rw [Scheme.Hom.opensRange_of_isIso]; exact le_top⟩

/-- The open of a chart is affine. -/
theorem isAffineOpen_nv [IsIso (projHomOfIsAmple L hL)] (ch : ConsecutiveChart L) :
    IsAffineOpen ch.nv := by
  rw [nv, ← Stacks.SectionRingProjMorphism.projHomOfIsAmple_preimage_projBasicOpen L hL ch.prod
    ch.deg_pos]
  exact (Proj.isAffineOpen_basicOpen (grading L) _
    (Stacks.ExternalGrading.of_mem_summand _ ch.prod) ch.deg_pos).preimage_of_isIso _

/-- The open of a chart, as an affine open. -/
abbrev affineOpen [IsIso (projHomOfIsAmple L hL)] (ch : ConsecutiveChart L) : X.affineOpens :=
  ⟨ch.nv, ch.isAffineOpen_nv hL⟩

end ConsecutiveChart

/-- **The charts of consecutive degrees form a basis of `X`**, for `L` ample. Around a point of an
open `W` there is a chart `X_a ⊆ W` of positive degree `e`, and sections `t` of `L^{⊗ d}` and `t'`
of `L^{⊗ (d+1)}` not vanishing at the point; then `at'` and `at` have the consecutive degrees
`e + d + 1` and `e + d`, and `X_{at' · at} = X_a ∩ X_t ∩ X_{t'}`. -/
public theorem isBasis_consecutiveChart (hL : Stacks.Ample.IsAmple X L) :
    Opens.IsBasis (Set.range (fun ch : ConsecutiveChart L => ch.nv)) := by
  have := Stacks.SectionRingProjImmersion.isOpenImmersion_projHomOfIsAmple L hL
  obtain ⟨d, -, hcov, hcov'⟩ :=
    Stacks.SectionRingVeroneseChart.exists_consecutive_iSup_nvOpen_eq_top L hL
  rw [Opens.isBasis_iff_nbhd]
  intro W x hx
  obtain ⟨_, ⟨a, rfl⟩, hxa, haW⟩ :=
    (Opens.isBasis_iff_nbhd.mp (Stacks.SectionRingProjQuasicoherent.isBasis_goodChart L hL)) hx
  have hxt : x ∈ (⨆ t : powSections L d, nvOpen L t) := by rw [hcov]; trivial
  have hxt' : x ∈ (⨆ t : powSections L (d + 1), nvOpen L t) := by rw [hcov']; trivial
  obtain ⟨t, ht⟩ := Opens.mem_iSup.mp hxt
  obtain ⟨t', ht'⟩ := Opens.mem_iSup.mp hxt'
  let ch : ConsecutiveChart L :=
    ⟨a.1.deg + d, (mul a.1.val t' : powSections L (a.1.deg + (d + 1))), mul a.1.val t⟩
  have hnv : ch.nv = nvOpen L a.1.val ⊓ nvOpen L t' ⊓ (nvOpen L a.1.val ⊓ nvOpen L t) := by
    simp only [ConsecutiveChart.nv, ConsecutiveChart.prod, ch,
      Stacks.SectionRingChartMap.nvOpen_mul]
  refine ⟨ch.nv, ⟨ch, rfl⟩, ?_, ?_⟩
  · rw [hnv]; exact ⟨⟨hxa, ht'⟩, hxa, ht⟩
  · rw [hnv]; exact (inf_le_left.trans inf_le_left).trans haW

/-- **The ideal of the zero scheme on a chart of consecutive degrees** is generated by the image of
the chart ratio `f b² / (cb)` under the chart ring map, `f ∈ A₁` being `s`. -/
public theorem zeroScheme_ideal_consecutiveChart (hL : Stacks.Ample.IsAmple X L)
    [IsIso (projHomOfIsAmple L hL)] (s : Γ(L, ⊤)) (ch : ConsecutiveChart L) :
    (zeroScheme X L s).ideal (ch.affineOpen hL) =
      Ideal.span {Stacks.SectionRingChartMap.chartRingMap L ch.prod le_rfl
                    (Stacks.DegreeOneUnitAway.chartRatio ch.cR_mem ch.bR_mem ch.cR_mul_bR
                      (Stacks.ExternalGrading.of_mem_summand 1 (degreeOneSection L s)))} := by
  rw [zeroScheme_ideal_eq_span_ratio L ch.c ch.b s (ch.affineOpen hL) ch.nv_le_c ch.nv_le_b]
  congr 2
  set fR : sectionRing L := DirectSum.of (powSections L) 1 (degreeOneSection L s) with hfR
  have hfmem : fR ∈ grading L 1 := Stacks.ExternalGrading.of_mem_summand _ _
  have hfb : fR * ch.bR ^ 2 ∈ grading L (ch.m + 1 + ch.m) := by
    have h := SetLike.mul_mem_graded hfmem (SetLike.pow_mem_graded 2 ch.bR_mem)
    convert h using 2
    ring
  have hfb' : fR * ch.bR ^ 2 ∈ grading L (1 • (ch.m + 1 + ch.m)) := by rwa [one_smul]
  have hcr : Stacks.DegreeOneUnitAway.chartRatio ch.cR_mem ch.bR_mem ch.cR_mul_bR hfmem =
      HomogeneousLocalization.Away.mk (grading L)
        (Stacks.ExternalGrading.of_mem_summand (ch.m + 1 + ch.m) ch.prod) 1 (fR * ch.bR ^ 2)
        hfb' := by
    apply HomogeneousLocalization.val_injective
    rw [Stacks.DegreeOneUnitAway.val_chartRatio, HomogeneousLocalization.Away.val_mk]
    congr 1
    apply Subtype.ext
    simp [Stacks.DegreeOneUnitAway.gen]
  rw [hcr, Stacks.SectionRingChartMap.chartRingMap_mk,
    Stacks.SectionRingChartMap.chartFamily_apply, Stacks.SectionRingChartMap.numMapR_def]
  -- `(cb) · f b²` over `(cb)²` is `f b² / cb`, which is `bf / c`
  have hV1 : ch.nv ≤ nvOpen L (Stacks.SectionExtension.powSec L ch.prod 1) :=
    Stacks.SectionRingChartMap.le_nvOpen_powSec L ch.prod le_rfl 1 le_rfl
  have hgR : ch.gR ∈ grading L ((ch.m + 1 + ch.m) * 1) := by
    rw [mul_one]; exact Stacks.ExternalGrading.of_mem_summand _ _
  have key := ratioR_mul L (Stacks.SectionExtension.powSec L ch.prod 1) ch.prod hV1 le_rfl
    (Stacks.SectionRingChartMap.le_nvOpen_powSec L ch.prod le_rfl (1 + 1) (Nat.le_add_left 1 1))
    hgR hfb
  refine Eq.trans ?_ key.symm
  have h1 : ratioR L (Stacks.SectionExtension.powSec L ch.prod 1) hV1 ch.gR = 1 := by
    have := Stacks.SectionRingChartMap.numMapR_of_self L ch.prod le_rfl le_rfl
    rwa [Stacks.SectionRingChartMap.numMapR_def] at this
  rw [h1, one_mul]
  have hbf : fR * ch.bR ^ 2 =
      DirectSum.of (powSections L) (ch.m + 1) (mul ch.b (degreeOneSection L s)) * ch.bR := by
    rw [of_mul_eq]; ring
  rw [hbf, ratioR_mul L ch.c ch.b ch.nv_le_c ch.nv_le_b le_rfl
    (Stacks.ExternalGrading.of_mem_summand _ _) ch.bR_mem, ratioR_of, ratioR_of,
    Stacks.SectionRingChartMap.ratio_self, mul_one]

end Monoidal

end Stacks.LefschetzCone

end
