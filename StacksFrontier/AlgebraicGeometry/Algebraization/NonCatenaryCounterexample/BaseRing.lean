module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Filtration
public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian

/-!
# The semilocal ring of the non-catenary counterexample to Stacks 0EJA

Let `K` be a field and `R = K[x₁, …, x₆]`, written `MvPolynomial (Fin 6) K` with `xᵢ = X (i - 1)`.
This file builds the semilocal ring `B = S⁻¹R` obtained by inverting everything outside the two
primes `𝔪₁ = (x₁, …, x₆)` (maximal, of height six, residue field `K`) and
`𝔫 = (x₁, x₂, x₃ - 1)` (of height three, residue field `K(x₄, x₅, x₆)`). Its two maximal ideals
are `𝔪₁B` and `𝔫B`; pinching them together along an isomorphism of residue fields produces the
non-catenary local ring of the counterexample.

The primes of `R` used later are

* `W = (x₁)`, contained in both `𝔪₁` and `𝔫`;
* `V = (x₁, x₃ - 1) = W + (x₃ - 1)`, contained in `𝔫` but not in `𝔪₁`, with `𝔫 = V + (x₂)`;
* `C = (x₁, x₄)` and `P = (x₁, x₄, x₅)`, contained in `𝔪₁` but not in `𝔫`;
* `Q₀ = (x₄, x₅)`.

Each is introduced as an ideal generated by explicit elements and identified with the kernel of an
explicit `K`-algebra map to a polynomial ring, which makes it prime and decides membership.

## Main results

* `Stacks.NonCatenaryExample.maximal_eq_or_eq` — `𝔪₁B` and `𝔫B` are the only maximal ideals.
* `Stacks.NonCatenaryExample.eq_of_le_of_lt_extN` and `eq_of_le_of_lt_extV` — nothing lies strictly
  between `VB` and `𝔫B`, nor between `WB` and `VB`: the two covering relations of the short chain
  `W ⊂ V ⊂ 𝔫`.
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks.NonCatenaryExample

/-- An ideal contained in the kernel of a ring map, through whose target the quotient map
factors, is the kernel. -/
theorem ker_eq_of_comp_eq {R T : Type*} [CommRing R] [CommRing T] (I : Ideal R) (f : R →+* T)
    (hI : I ≤ RingHom.ker f) (g : T →+* R ⧸ I) (hg : g.comp f = Ideal.Quotient.mk I) :
    RingHom.ker f = I := by
  refine le_antisymm (fun a ha => ?_) hI
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  have h := congrArg (fun φ : R →+* R ⧸ I => φ a) hg
  simp only [RingHom.comp_apply, RingHom.mem_ker.mp ha, map_zero] at h
  exact h.symm

/-- In a Noetherian ring, a prime `Q` squeezed between a prime `V` and `V + (t)`, with `t ∉ Q`
and `V + (t)` proper, equals `V`. -/
theorem eq_of_le_of_le_sup_span {R : Type*} [CommRing R] [IsNoetherianRing R] {V Q : Ideal R}
    [V.IsPrime] [Q.IsPrime] {t : R} (hVQ : V ≤ Q) (htQ : t ∉ Q)
    (hQ : Q ≤ V ⊔ Ideal.span {t}) (hne : V ⊔ Ideal.span {t} ≠ ⊤) : Q = V := by
  refine le_antisymm (fun a ha => ?_) hVQ
  set π := Ideal.Quotient.mk V
  have hT : Ideal.span {π t} ≠ ⊤ := by
    intro htop
    apply hne
    rw [Ideal.eq_top_iff_one] at htop ⊢
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp htop
    obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective c
    have : c' * t - 1 ∈ V := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one]
      exact sub_eq_zero.mpr hc
    rw [show (1 : R) = c' * t - (c' * t - 1) by ring]
    exact Ideal.sub_mem _
      (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self t)))
      (Ideal.mem_sup_left this)
  have hdiv : ∀ k : ℕ, ∀ b ∈ Q, π b ∈ Ideal.span {π t} ^ k := by
    intro k
    induction k with
    | zero => intro b _; simp
    | succ k ih =>
      intro b hb
      obtain ⟨v, hv, w, hw, rfl⟩ := Submodule.mem_sup.mp (hQ hb)
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hw
      have hcQ : c ∈ Q := by
        have : c * t ∈ Q := by simpa using Q.sub_mem hb (hVQ hv)
        exact (Ideal.IsPrime.mem_or_mem inferInstance this).resolve_right htQ
      rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hv, zero_add, map_mul, pow_succ]
      exact Ideal.mul_mem_mul (ih c hcQ) (Ideal.mem_span_singleton_self _)
  have hbot := Ideal.iInf_pow_eq_bot_of_isDomain (Ideal.span {π t}) hT
  have : π a ∈ (⊥ : Ideal (R ⧸ V)) := by
    rw [← hbot]
    exact Ideal.mem_iInf.mpr fun k => hdiv k a ha
  exact Ideal.Quotient.eq_zero_iff_mem.mp ((Ideal.mem_bot).mp this)

variable (K : Type u) [Field K]

/-- The polynomial ring `K[x₁, …, x₆]`. -/
abbrev R6 := MvPolynomial (Fin 6) K

/-! ### The primes of `R` -/

/-- `𝔪₁ = (x₁, …, x₆)`. -/
def idealM : Ideal (R6 K) := Ideal.span (Set.range X)
/-- `𝔫 = (x₁, x₂, x₃ - 1)`. -/
def idealN : Ideal (R6 K) := Ideal.span {X 0, X 1, X 2 - 1}
/-- `W = (x₁)`. -/
def idealW : Ideal (R6 K) := Ideal.span {X 0}
/-- `V = (x₁, x₃ - 1)`. -/
def idealV : Ideal (R6 K) := Ideal.span {X 0, X 2 - 1}
/-- `C = (x₁, x₄)`. -/
def idealC : Ideal (R6 K) := Ideal.span {X 0, X 3}
/-- `P = (x₁, x₄, x₅)`. -/
def idealP : Ideal (R6 K) := Ideal.span {X 0, X 3, X 4}
/-- `Q₀ = (x₄, x₅)`. -/
def idealQ0 : Ideal (R6 K) := Ideal.span {X 3, X 4}

/-- Evaluation at the origin, whose kernel is `𝔪₁`. -/
def mapM : R6 K →ₐ[K] K := aeval (fun _ => 0)
/-- The map `x₁, x₂ ↦ 0`, `x₃ ↦ 1`, `x₄, x₅, x₆ ↦ y₁, y₂, y₃`, whose kernel is `𝔫`. -/
def mapN : R6 K →ₐ[K] MvPolynomial (Fin 3) K := aeval ![0, 0, 1, X 0, X 1, X 2]
/-- The map `x₁ ↦ 0`, `xᵢ ↦ yᵢ₋₁`, whose kernel is `W`. -/
def mapW : R6 K →ₐ[K] MvPolynomial (Fin 5) K := aeval ![0, X 0, X 1, X 2, X 3, X 4]
/-- The map whose kernel is `V`. -/
def mapV : R6 K →ₐ[K] MvPolynomial (Fin 4) K := aeval ![0, X 0, 1, X 1, X 2, X 3]
/-- The map whose kernel is `C`. -/
def mapC : R6 K →ₐ[K] MvPolynomial (Fin 4) K := aeval ![0, X 0, X 1, 0, X 2, X 3]
/-- The map whose kernel is `P`. -/
def mapP : R6 K →ₐ[K] MvPolynomial (Fin 3) K := aeval ![0, X 0, X 1, 0, 0, X 2]
/-- The map whose kernel is `Q₀`. -/
def mapQ0 : R6 K →ₐ[K] MvPolynomial (Fin 4) K := aeval ![X 0, X 1, X 2, 0, 0, X 3]

/-- The kernel of `aeval v` is an ideal `I` containing it as soon as substituting the `w j` back
into the `v i` recovers each variable modulo `I`. -/
theorem ker_aeval_eq {m : ℕ} (I : Ideal (R6 K)) (v : Fin 6 → MvPolynomial (Fin m) K)
    (hI : I ≤ RingHom.ker (aeval v : R6 K →ₐ[K] MvPolynomial (Fin m) K))
    (w : Fin m → R6 K)
    (hw : ∀ i, aeval (fun j => Ideal.Quotient.mk I (w j)) (v i) = Ideal.Quotient.mk I (X i)) :
    RingHom.ker (aeval v : R6 K →ₐ[K] MvPolynomial (Fin m) K) = I := by
  refine ker_eq_of_comp_eq I _ hI
    (aeval (R := K) (fun j => Ideal.Quotient.mk I (w j))).toRingHom ?_
  have h : (aeval (R := K) (fun j => Ideal.Quotient.mk I (w j))).comp
      (aeval v : R6 K →ₐ[K] MvPolynomial (Fin m) K) = Ideal.Quotient.mkₐ K I := by
    refine MvPolynomial.algHom_ext fun i => ?_
    rw [AlgHom.comp_apply, aeval_X, hw i]
    rfl
  exact congrArg AlgHom.toRingHom h

/-- An element of `I` maps to zero in `R ⧸ I`. -/
theorem mk_eq_zero_of_mem {I : Ideal (R6 K)} {a : R6 K} (h : a ∈ I) :
    Ideal.Quotient.mk I a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h

/-- If `a - 1 ∈ I`, then `a` maps to one in `R ⧸ I`. -/
theorem mk_eq_one_of_sub_one_mem {I : Ideal (R6 K)} {a : R6 K} (h : a - 1 ∈ I) :
    (1 : R6 K ⧸ I) = Ideal.Quotient.mk I a := by
  rw [← map_one (Ideal.Quotient.mk I), Ideal.Quotient.eq, ← neg_sub]
  exact I.neg_mem h

/-- The kernel of `mapN` is `𝔫`. -/
theorem ker_mapN : RingHom.ker (mapN K) = idealN K := by
  refine ker_aeval_eq K _ _ ?_ ![X 3, X 4, X 5] ?_
  · refine Ideal.span_le.mpr ?_
    simp [Set.insert_subset_iff, mapN]
  · intro i
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, map_zero, map_one, aeval_X] <;>
      first
        | (rw [aeval_X]; rfl)
        | exact (mk_eq_zero_of_mem K (Ideal.subset_span (by simp))).symm
        | exact mk_eq_zero_of_mem K (Ideal.subset_span (by simp))
        | exact Ideal.subset_span (by simp)
        | exact mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))
        | exact (mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))).symm

/-- The kernel of `mapW` is `W`. -/
theorem ker_mapW : RingHom.ker (mapW K) = idealW K := by
  refine ker_aeval_eq K _ _ ?_ ![X 1, X 2, X 3, X 4, X 5] ?_
  · refine Ideal.span_le.mpr ?_
    simp [mapW]
  · intro i
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, map_zero, aeval_X] <;>
      first
        | (rw [aeval_X]; rfl)
        | exact (mk_eq_zero_of_mem K (Ideal.subset_span (by simp))).symm
        | exact mk_eq_zero_of_mem K (Ideal.subset_span (by simp))
        | exact Ideal.subset_span (by simp)
        | exact mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))
        | exact (mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))).symm

/-- The kernel of `mapV` is `V`. -/
theorem ker_mapV : RingHom.ker (mapV K) = idealV K := by
  refine ker_aeval_eq K _ _ ?_ ![X 1, X 3, X 4, X 5] ?_
  · refine Ideal.span_le.mpr ?_
    simp [Set.insert_subset_iff, mapV]
  · intro i
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, map_zero, map_one, aeval_X] <;>
      first
        | (rw [aeval_X]; rfl)
        | exact (mk_eq_zero_of_mem K (Ideal.subset_span (by simp))).symm
        | exact mk_eq_zero_of_mem K (Ideal.subset_span (by simp))
        | exact Ideal.subset_span (by simp)
        | exact mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))
        | exact (mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))).symm

/-- The kernel of `mapC` is `C`. -/
theorem ker_mapC : RingHom.ker (mapC K) = idealC K := by
  refine ker_aeval_eq K _ _ ?_ ![X 1, X 2, X 4, X 5] ?_
  · refine Ideal.span_le.mpr ?_
    simp [Set.insert_subset_iff, mapC]
  · intro i
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, map_zero, aeval_X] <;>
      first
        | (rw [aeval_X]; rfl)
        | exact (mk_eq_zero_of_mem K (Ideal.subset_span (by simp))).symm
        | exact mk_eq_zero_of_mem K (Ideal.subset_span (by simp))
        | exact Ideal.subset_span (by simp)
        | exact mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))
        | exact (mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))).symm

/-- The kernel of `mapP` is `P`. -/
theorem ker_mapP : RingHom.ker (mapP K) = idealP K := by
  refine ker_aeval_eq K _ _ ?_ ![X 1, X 2, X 5] ?_
  · refine Ideal.span_le.mpr ?_
    simp [Set.insert_subset_iff, mapP]
  · intro i
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, map_zero, aeval_X] <;>
      first
        | (rw [aeval_X]; rfl)
        | exact (mk_eq_zero_of_mem K (Ideal.subset_span (by simp))).symm
        | exact mk_eq_zero_of_mem K (Ideal.subset_span (by simp))
        | exact Ideal.subset_span (by simp)
        | exact mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))
        | exact (mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))).symm

/-- The kernel of `mapQ0` is `Q₀`. -/
theorem ker_mapQ0 : RingHom.ker (mapQ0 K) = idealQ0 K := by
  refine ker_aeval_eq K _ _ ?_ ![X 0, X 1, X 2, X 5] ?_
  · refine Ideal.span_le.mpr ?_
    simp [Set.insert_subset_iff, mapQ0]
  · intro i
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val, map_zero, aeval_X] <;>
      first
        | (rw [aeval_X]; rfl)
        | exact (mk_eq_zero_of_mem K (Ideal.subset_span (by simp))).symm
        | exact mk_eq_zero_of_mem K (Ideal.subset_span (by simp))
        | exact Ideal.subset_span (by simp)
        | exact mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))
        | exact (mk_eq_one_of_sub_one_mem K (Ideal.subset_span (by simp))).symm

/-- The kernel of `mapM` is `𝔪₁`. -/
theorem ker_mapM : RingHom.ker (mapM K) = idealM K := by
  refine ker_eq_of_comp_eq _ _ ?_ (algebraMap K (R6 K ⧸ idealM K)) ?_
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    simp [mapM]
  · refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp [mapM, Ideal.Quotient.mk_algebraMap]
      rfl
    · show algebraMap K (R6 K ⧸ idealM K) (mapM K (X i)) = _
      rw [show mapM K (X i) = 0 by simp [mapM], map_zero]
      exact (mk_eq_zero_of_mem K (Ideal.subset_span (Set.mem_range_self i))).symm

/-- `𝔪₁` is a maximal ideal. -/
instance : (idealM K).IsMaximal := by
  rw [← ker_mapM]
  exact RingHom.ker_isMaximal_of_surjective (mapM K) (fun a => ⟨C a, by simp [mapM]⟩)

/-- `𝔫` is a prime ideal. -/
instance : (idealN K).IsPrime := by rw [← ker_mapN]; exact RingHom.ker_isPrime _
/-- `W` is a prime ideal. -/
instance : (idealW K).IsPrime := by rw [← ker_mapW]; exact RingHom.ker_isPrime _
/-- `V` is a prime ideal. -/
instance : (idealV K).IsPrime := by rw [← ker_mapV]; exact RingHom.ker_isPrime _
/-- `C` is a prime ideal. -/
instance : (idealC K).IsPrime := by rw [← ker_mapC]; exact RingHom.ker_isPrime _
/-- `P` is a prime ideal. -/
instance : (idealP K).IsPrime := by rw [← ker_mapP]; exact RingHom.ker_isPrime _
/-- `Q₀` is a prime ideal. -/
instance : (idealQ0 K).IsPrime := by rw [← ker_mapQ0]; exact RingHom.ker_isPrime _

/-! ### Inclusions and memberships in `R` -/

/-- `W ≤ V`. -/
theorem idealW_le_idealV : idealW K ≤ idealV K := Ideal.span_mono (by simp)
/-- `V ≤ 𝔫`. -/
theorem idealV_le_idealN : idealV K ≤ idealN K :=
  Ideal.span_mono (by simp [Set.insert_subset_iff])
/-- `W ≤ C`. -/
theorem idealW_le_idealC : idealW K ≤ idealC K := Ideal.span_mono (by simp)
/-- `C ≤ P`. -/
theorem idealC_le_idealP : idealC K ≤ idealP K :=
  Ideal.span_mono (by simp [Set.insert_subset_iff])
/-- `Q₀ ≤ P`. -/
theorem idealQ0_le_idealP : idealQ0 K ≤ idealP K :=
  Ideal.span_mono (by simp [Set.insert_subset_iff])
/-- `P ≤ 𝔪₁`. -/
theorem idealP_le_idealM : idealP K ≤ idealM K := by
  refine Ideal.span_le.mpr ?_
  simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
  exact ⟨Ideal.subset_span ⟨0, rfl⟩, Ideal.subset_span ⟨3, rfl⟩, Ideal.subset_span ⟨4, rfl⟩⟩
/-- `W ≤ 𝔪₁`. -/
theorem idealW_le_idealM : idealW K ≤ idealM K :=
  (idealW_le_idealC K).trans ((idealC_le_idealP K).trans (idealP_le_idealM K))
/-- `Q₀ ≤ 𝔪₁`. -/
theorem idealQ0_le_idealM : idealQ0 K ≤ idealM K :=
  (idealQ0_le_idealP K).trans (idealP_le_idealM K)
/-- `W ≤ 𝔫`. -/
theorem idealW_le_idealN : idealW K ≤ idealN K :=
  (idealW_le_idealV K).trans (idealV_le_idealN K)

/-- `a ∈ 𝔪₁` if and only if `mapM a = 0`. -/
theorem mem_idealM_iff (a : R6 K) : a ∈ idealM K ↔ mapM K a = 0 := by
  rw [← ker_mapM]; rfl
/-- `a ∈ 𝔫` if and only if `mapN a = 0`. -/
theorem mem_idealN_iff (a : R6 K) : a ∈ idealN K ↔ mapN K a = 0 := by
  rw [← ker_mapN]; rfl
/-- `a ∈ W` if and only if `mapW a = 0`. -/
theorem mem_idealW_iff (a : R6 K) : a ∈ idealW K ↔ mapW K a = 0 := by
  rw [← ker_mapW]; rfl
/-- `a ∈ V` if and only if `mapV a = 0`. -/
theorem mem_idealV_iff (a : R6 K) : a ∈ idealV K ↔ mapV K a = 0 := by
  rw [← ker_mapV]; rfl
/-- `a ∈ C` if and only if `mapC a = 0`. -/
theorem mem_idealC_iff (a : R6 K) : a ∈ idealC K ↔ mapC K a = 0 := by
  rw [← ker_mapC]; rfl
/-- `a ∈ P` if and only if `mapP a = 0`. -/
theorem mem_idealP_iff (a : R6 K) : a ∈ idealP K ↔ mapP K a = 0 := by
  rw [← ker_mapP]; rfl
/-- `a ∈ Q₀` if and only if `mapQ0 a = 0`. -/
theorem mem_idealQ0_iff (a : R6 K) : a ∈ idealQ0 K ↔ mapQ0 K a = 0 := by
  rw [← ker_mapQ0]; rfl

/-- `𝔫 = V + (x₂)`. -/
theorem idealN_eq_sup : idealN K = idealV K ⊔ Ideal.span {X 1} := by
  rw [idealN, idealV, ← Ideal.span_union]
  congr 1
  ext a
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_union]
  tauto

/-- `V = W + (x₃ - 1)`. -/
theorem idealV_eq_sup : idealV K = idealW K ⊔ Ideal.span {X 2 - 1} := by
  rw [idealV, idealW, ← Ideal.span_union]
  rfl

/-! ### The semilocal ring `B` -/

/-- The multiplicative set `R ∖ (𝔪₁ ∪ 𝔫)`. -/
def submonoidS : Submonoid (R6 K) := (idealM K).primeCompl ⊓ (idealN K).primeCompl

/-- The semilocal ring `B = S⁻¹R`. -/
abbrev RingB := Localization (submonoidS K)

/-- `B` is Noetherian. -/
instance : IsNoetherianRing (RingB K) :=
  IsLocalization.isNoetherianRing (submonoidS K) _ inferInstance

/-- The extension `𝔭B` of an ideal of `R`. -/
abbrev ext (𝔭 : Ideal (R6 K)) : Ideal (RingB K) := 𝔭.map (algebraMap (R6 K) (RingB K))

/-- An ideal contained in `𝔪₁` or in `𝔫` is disjoint from `S`. -/
theorem disjoint_of_le_or_le {𝔭 : Ideal (R6 K)} (h : 𝔭 ≤ idealM K ∨ 𝔭 ≤ idealN K) :
    Disjoint (submonoidS K : Set (R6 K)) 𝔭 :=
  Set.disjoint_left.mpr fun _ ha hp => h.elim (fun h => ha.1 (h hp)) fun h => ha.2 (h hp)

/-- The extension `𝔭B` of a prime `𝔭` contained in `𝔪₁` or in `𝔫` is prime. -/
theorem isPrime_ext {𝔭 : Ideal (R6 K)} [𝔭.IsPrime] (h : 𝔭 ≤ idealM K ∨ 𝔭 ≤ idealN K) :
    (ext K 𝔭).IsPrime :=
  IsLocalization.isPrime_of_isPrime_disjoint (submonoidS K) _ 𝔭 inferInstance
    (disjoint_of_le_or_le K h)

/-- For a prime `𝔭` contained in `𝔪₁` or in `𝔫`, the contraction of `𝔭B` to `R` is `𝔭`. -/
theorem comap_ext {𝔭 : Ideal (R6 K)} [𝔭.IsPrime] (h : 𝔭 ≤ idealM K ∨ 𝔭 ≤ idealN K) :
    (ext K 𝔭).comap (algebraMap (R6 K) (RingB K)) = 𝔭 :=
  IsLocalization.under_map_of_isPrime_disjoint (submonoidS K) _ inferInstance
    (disjoint_of_le_or_le K h)

/-- For a prime `𝔭` contained in `𝔪₁` or in `𝔫`, the image of `a ∈ R` lies in `𝔭B` if and only
if `a ∈ 𝔭`. -/
theorem algebraMap_mem_ext_iff {𝔭 : Ideal (R6 K)} [𝔭.IsPrime]
    (h : 𝔭 ≤ idealM K ∨ 𝔭 ≤ idealN K) (a : R6 K) :
    algebraMap (R6 K) (RingB K) a ∈ ext K 𝔭 ↔ a ∈ 𝔭 := by
  conv_rhs => rw [← comap_ext K h]
  rfl

/-- `𝔪₁B` is a prime ideal. -/
instance : (ext K (idealM K)).IsPrime := isPrime_ext K (Or.inl le_rfl)
/-- `𝔫B` is a prime ideal. -/
instance : (ext K (idealN K)).IsPrime := isPrime_ext K (Or.inr le_rfl)
/-- `WB` is a prime ideal. -/
instance : (ext K (idealW K)).IsPrime := isPrime_ext K (Or.inl (idealW_le_idealM K))
/-- `VB` is a prime ideal. -/
instance : (ext K (idealV K)).IsPrime := isPrime_ext K (Or.inr (idealV_le_idealN K))
/-- `CB` is a prime ideal. -/
instance : (ext K (idealC K)).IsPrime :=
  isPrime_ext K (Or.inl ((idealC_le_idealP K).trans (idealP_le_idealM K)))
/-- `PB` is a prime ideal. -/
instance : (ext K (idealP K)).IsPrime := isPrime_ext K (Or.inl (idealP_le_idealM K))
/-- `Q₀B` is a prime ideal. -/
instance : (ext K (idealQ0 K)).IsPrime := isPrime_ext K (Or.inl (idealQ0_le_idealM K))

/-- Every prime of `B` lies in `𝔪₁B` or in `𝔫B`. -/
theorem le_extM_or_le_extN (Q : Ideal (RingB K)) [Q.IsPrime] :
    Q ≤ ext K (idealM K) ∨ Q ≤ ext K (idealN K) := by
  set q := Q.comap (algebraMap (R6 K) (RingB K))
  have hsub : (q : Set (R6 K)) ⊆ idealM K ∪ idealN K := by
    intro a ha
    by_contra hcon
    simp only [Set.mem_union, not_or] at hcon
    have hS : a ∈ submonoidS K := ⟨hcon.1, hcon.2⟩
    exact (Ideal.IsPrime.ne_top (inferInstance : Q.IsPrime))
      (Ideal.eq_top_of_isUnit_mem Q ha (IsLocalization.map_units (RingB K) ⟨a, hS⟩))
  have hmap : Q = q.map (algebraMap (R6 K) (RingB K)) :=
    (IsLocalization.map_comap (submonoidS K) (RingB K) Q).symm
  rcases Ideal.subset_union.mp hsub with h | h
  · exact Or.inl (hmap ▸ Ideal.map_mono h)
  · exact Or.inr (hmap ▸ Ideal.map_mono h)

/-- `x₄ ∉ 𝔫`. -/
theorem X3_notMem_idealN : (X 3 : R6 K) ∉ idealN K := by
  rw [mem_idealN_iff]; simp [mapN]

/-- `x₃ - 1 ∉ 𝔪₁`. -/
theorem X2_sub_one_notMem_idealM : (X 2 - 1 : R6 K) ∉ idealM K := by
  rw [mem_idealM_iff]; simp [mapM]

/-- `𝔪₁B` is not contained in `𝔫B`. -/
theorem extM_not_le_extN : ¬ ext K (idealM K) ≤ ext K (idealN K) := fun h =>
  X3_notMem_idealN K <| (algebraMap_mem_ext_iff K (Or.inr le_rfl) _).mp
    (h (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨3, rfl⟩)))

/-- `𝔫B` is not contained in `𝔪₁B`. -/
theorem extN_not_le_extM : ¬ ext K (idealN K) ≤ ext K (idealM K) := fun h =>
  X2_sub_one_notMem_idealM K <| (algebraMap_mem_ext_iff K (Or.inl le_rfl) _).mp
    (h (Ideal.mem_map_of_mem _ (Ideal.subset_span (by simp))))

/-- `𝔪₁B` is a maximal ideal of `B`. -/
instance isMaximal_extM : (ext K (idealM K)).IsMaximal := by
  obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _
    (Ideal.IsPrime.ne_top (inferInstance : (ext K (idealM K)).IsPrime))
  rcases le_extM_or_le_extN K M with h | h
  · exact (le_antisymm hle h) ▸ hM
  · exact absurd (hle.trans h) (extM_not_le_extN K)

/-- `𝔫B` is a maximal ideal of `B`. -/
instance isMaximal_extN : (ext K (idealN K)).IsMaximal := by
  obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _
    (Ideal.IsPrime.ne_top (inferInstance : (ext K (idealN K)).IsPrime))
  rcases le_extM_or_le_extN K M with h | h
  · exact absurd (hle.trans h) (extN_not_le_extM K)
  · exact (le_antisymm hle h) ▸ hM

/-- `𝔪₁B ≠ 𝔫B`. -/
theorem extM_ne_extN : ext K (idealM K) ≠ ext K (idealN K) := fun h =>
  extM_not_le_extN K h.le

/-- `𝔪₁B` and `𝔫B` are the only maximal ideals of `B`. -/
theorem maximal_eq_or_eq (Q : Ideal (RingB K)) (hQ : Q.IsMaximal) :
    Q = ext K (idealM K) ∨ Q = ext K (idealN K) := by
  rcases le_extM_or_le_extN K Q with h | h
  · exact Or.inl (hQ.eq_of_le (isMaximal_extM K).ne_top h)
  · exact Or.inr (hQ.eq_of_le (isMaximal_extN K).ne_top h)

/-- Nothing lies strictly between `VB` and `𝔫B`. -/
theorem eq_of_le_of_lt_extN (Q : Ideal (RingB K)) [Q.IsPrime] (h₁ : ext K (idealV K) ≤ Q)
    (h₂ : Q < ext K (idealN K)) : Q = ext K (idealV K) := by
  have hN : ext K (idealN K) =
      ext K (idealV K) ⊔ Ideal.span {algebraMap (R6 K) (RingB K) (X 1)} := by
    rw [ext, idealN_eq_sup, Ideal.map_sup, Ideal.map_span, Set.image_singleton]
  refine eq_of_le_of_le_sup_span h₁ (fun hx => ?_) (hN ▸ h₂.le)
    (hN ▸ (Ideal.IsPrime.ne_top (inferInstance : (ext K (idealN K)).IsPrime)))
  exact h₂.not_ge (hN ▸ sup_le h₁ ((Ideal.span_singleton_le_iff_mem _).mpr hx))

/-- Nothing lies strictly between `WB` and `VB`. -/
theorem eq_of_le_of_lt_extV (Q : Ideal (RingB K)) [Q.IsPrime] (h₁ : ext K (idealW K) ≤ Q)
    (h₂ : Q < ext K (idealV K)) : Q = ext K (idealW K) := by
  have hV : ext K (idealV K) =
      ext K (idealW K) ⊔ Ideal.span {algebraMap (R6 K) (RingB K) (X 2 - 1)} := by
    rw [ext, idealV_eq_sup, Ideal.map_sup, Ideal.map_span, Set.image_singleton]
  refine eq_of_le_of_le_sup_span h₁ (fun hx => ?_) (hV ▸ h₂.le)
    (hV ▸ (Ideal.IsPrime.ne_top (inferInstance : (ext K (idealV K)).IsPrime)))
  exact h₂.not_ge (hV ▸ sup_le h₁ ((Ideal.span_singleton_le_iff_mem _).mpr hx))

/-! ### The residue fields of `B` -/

/-- The residue map of `B` at `𝔪₁B`, extending evaluation at the origin. -/
def resM : RingB K →+* K :=
  IsLocalization.lift (M := submonoidS K) (g := (mapM K : R6 K →+* K)) fun y =>
    isUnit_iff_ne_zero.mpr fun h => y.2.1 ((mem_idealM_iff K _).mpr h)

/-- The residue map of `B` at `𝔫B`, to the fraction field of `K[y₁, y₂, y₃]`. -/
def resN : RingB K →+* FractionRing (MvPolynomial (Fin 3) K) :=
  IsLocalization.lift (M := submonoidS K)
    (g := (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K))).comp
      (mapN K : R6 K →+* MvPolynomial (Fin 3) K)) fun y =>
    isUnit_iff_ne_zero.mpr fun h => y.2.2 ((mem_idealN_iff K _).mpr
      ((IsFractionRing.injective (MvPolynomial (Fin 3) K)
        (FractionRing (MvPolynomial (Fin 3) K))) (by simpa using h)))

/-- The kernel of `resM` is `𝔪₁B`. -/
theorem ker_resM : RingHom.ker (resM K) = ext K (idealM K) := by
  ext x
  obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective (submonoidS K) x
  rw [RingHom.mem_ker, resM, IsLocalization.lift_mk', IsLocalization.mk'_mem_iff,
    algebraMap_mem_ext_iff K (Or.inl le_rfl), mem_idealM_iff]
  simp only [Units.mul_inv_eq_iff_eq_mul, zero_mul]
  rfl

/-- The kernel of `resN` is `𝔫B`. -/
theorem ker_resN : RingHom.ker (resN K) = ext K (idealN K) := by
  ext x
  obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective (submonoidS K) x
  rw [RingHom.mem_ker, resN, IsLocalization.lift_mk', IsLocalization.mk'_mem_iff,
    algebraMap_mem_ext_iff K (Or.inr le_rfl), mem_idealN_iff]
  simp only [Units.mul_inv_eq_iff_eq_mul, zero_mul, RingHom.comp_apply]
  exact map_eq_zero_iff _ (IsFractionRing.injective (MvPolynomial (Fin 3) K)
    (FractionRing (MvPolynomial (Fin 3) K)))

/-- `resM` is surjective. -/
theorem resM_surjective : Function.Surjective (resM K) := fun a =>
  ⟨algebraMap (R6 K) (RingB K) (C a), by
    rw [resM, IsLocalization.lift_eq]; simp [mapM]⟩

/-- `mapN` sends `aeval ![x₄, x₅, x₆] p` back to `p`. -/
theorem mapN_aeval (p : MvPolynomial (Fin 3) K) :
    mapN K (aeval ![(X 3 : R6 K), X 4, X 5] p) = p := by
  have : (mapN K).comp (aeval (R := K) ![(X 3 : R6 K), X 4, X 5]) = AlgHom.id K _ := by
    refine MvPolynomial.algHom_ext fun j => ?_
    fin_cases j <;> simp [mapN]
  exact AlgHom.congr_fun this p

/-- Every nonzero polynomial in `K[y₁, y₂, y₃]` is the image under `mapN` of an element of `S`. -/
theorem exists_mem_submonoidS_mapN_eq (q : MvPolynomial (Fin 3) K) (hq : q ≠ 0) :
    ∃ s ∈ submonoidS K, mapN K s = q := by
  let s₀ : R6 K := aeval ![X 3, X 4, X 5] q
  have hs₀ : mapN K s₀ = q := mapN_aeval K q
  refine ⟨s₀ + (X 2 - 1) * C (mapM K s₀ - 1), ⟨?_, ?_⟩, ?_⟩
  · show _ ∉ idealM K
    rw [mem_idealM_iff]
    simp [mapM]
  · show _ ∉ idealN K
    rw [mem_idealN_iff, map_add, hs₀]
    simpa [mapN] using hq
  · rw [map_add, hs₀]
    simp [mapN]

/-- `resN` is surjective. -/
theorem resN_surjective : Function.Surjective (resN K) := by
  intro z
  obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := MvPolynomial (Fin 3) K) z
  obtain ⟨s, hs, hsq⟩ := exists_mem_submonoidS_mapN_eq K q (nonZeroDivisors.ne_zero hq)
  let r₀ : R6 K := aeval ![X 3, X 4, X 5] p
  have hr₀ : mapN K r₀ = p := mapN_aeval K p
  refine ⟨IsLocalization.mk' (RingB K) r₀ ⟨s, hs⟩, ?_⟩
  rw [resN, IsLocalization.lift_mk'_spec]
  show algebraMap _ _ (mapN K r₀) = algebraMap _ _ (mapN K s) * _
  rw [hr₀, hsq]
  rw [mul_div_cancel₀ _ (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq)]

/-- `B ⧸ 𝔪₁B ≅ K`. -/
def quotientExtMEquiv : RingB K ⧸ ext K (idealM K) ≃+* K :=
  (Ideal.quotEquivOfEq (ker_resM K).symm).trans
    (RingHom.quotientKerEquivOfSurjective (resM_surjective K))

/-- `B ⧸ 𝔫B ≅ K(y₁, y₂, y₃)`. -/
def quotientExtNEquiv : RingB K ⧸ ext K (idealN K) ≃+* FractionRing (MvPolynomial (Fin 3) K) :=
  (Ideal.quotEquivOfEq (ker_resN K).symm).trans
    (RingHom.quotientKerEquivOfSurjective (resN_surjective K))

/-- Given `K ≅ K(y₁, y₂, y₃)`, the residue fields of `B` at its two maximal ideals are
isomorphic. -/
def residueEquiv (e : K ≃+* FractionRing (MvPolynomial (Fin 3) K)) :
    RingB K ⧸ ext K (idealN K) ≃+* RingB K ⧸ ext K (idealM K) :=
  (quotientExtNEquiv K).trans (e.symm.trans (quotientExtMEquiv K).symm)

end Stacks.NonCatenaryExample

