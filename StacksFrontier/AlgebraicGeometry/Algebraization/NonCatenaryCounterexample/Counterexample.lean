/-!
# Stacks 0EJA is false as published

Stacks 0EJA asserts: in Situation 0EHC, with `A` local, `𝔞 = 𝔪` and `cd(A, I) = 1`, an object
`(ℱₙ)` of `Coh(U, I𝒪_U)` satisfies the `(2, 3)`-inequalities if and only if
`depth((ℱ_y^∧)_𝔭) + dim(𝒪_{X,y}^∧/𝔭) > 2` for every `y ∈ U ∩ Y` with `dim({y}‾) = 1` and every
prime `𝔭 ∉ V(I𝒪_{X,y}^∧)`. The "if" direction is false. Its published proof identifies
`δ^Y_Z(y)` with `dim({y}‾)` by Stacks 0EIY (5), which needs `A/I` catenary.

## The counterexample

Let `K` be a field with `K ≅ K(y₁, y₂, y₃)` (e.g. `K = k(t₀, t₁, …)`), `R = K[x₁, …, x₆]`,
`𝔪₁ = (x₁, …, x₆)` (height six, residue field `K`) and `𝔫 = (x₁, x₂, x₃ − 1)` (height three,
residue field `K(x₄, x₅, x₆) ≅ K`). Let `B` be `R` with everything outside `𝔪₁ ∪ 𝔫` inverted, and
let `A ⊆ B` be the pinch of `𝔪₁B` and `𝔫B` along the residue-field isomorphism: a Noetherian local
domain whose spectrum is that of `B` with the two closed points identified, and with
`A_{Q∩A} = B_Q` away from the closed point (`Stacks.Pinch`). With `W = (x₁)`, `V = (x₁, x₃ − 1)`,
`C = (x₁, x₄)`, `P = (x₁, x₄, x₅)`, `Q₀ = (x₄, x₅)`, put `𝔟 = (Q₀B ∩ WB) ∩ A`, `A'' = A/𝔟`,
`I = (x₁)` and `𝔞 = 𝔪_{A''}`, and let `ℱₙ = 𝒪_U/Iⁿ⁺¹𝒪_U`.

* `cd(A'', I) = 1`: `I` is principal and `V(I)` is not open, a prime (`Q₀''`) avoiding `x₁`.
* `δ^Y_Z(P) ≤ 2`: in `Y = V(W)` the chain `W ⊂ V ⊂ 𝔪_A` is saturated (`V` lies only under `𝔫`,
  of height three), so the zigzag `{𝔪_A}‾ ⊆ V(V) ⊆ V(W) ⊇ V(C) ⊇ V(P)` has weight
  `2 + max(1 + 1 − 2, 1 − 2, 0) = 2`; yet `dim({P}‾) = 3`.
* The `(2, 3)`-inequalities fail at `P`: in the `x₁`-adic completion of `A''_P` the prime
  `𝔭 = Q₀`-component is minimal, avoids `x₁`, has `V(𝔭) ∩ V(I) = {𝔪}`, and depth zero, so clause
  (2) of Stacks 0EJ3 asks `0 + δ(P) > 2`.
* The right-hand side holds: at a point `y'` of dimension one, either `x₄` or `x₅` is a unit at
  `y'` and then `x₁ = 0` in `𝒪_{X,y'}` (the condition is vacuous), or `y' ⊇ P` lies only under
  `𝔪₁`, has height five, and `𝒪_{X,y'}^∧/Q₀` is regular local of dimension three, giving
  `depth + dim = 3` at every relevant prime.

## Main results

* `Stacks.Algebraization.not_satisfiesDepthInequalities_of_annihilatedPrime` and
  `Stacks.Algebraization.two_lt_depth_add_dim_of_cases` — the failure and the bound, for any
  algebraization situation with `I` principal and completed stalks free of rank one.
* `Stacks.NonCatenaryExample.not_iff_of_local` — the equivalence of Stacks 0EJA fails for the
  counterexample, given the two local computations in `A''`.
-/

@[expose] public noncomputable section

universe u

namespace Stacks.Algebraization

/-- `3 ≤ depth + e` gives `2 < depth + e` in the extended integers. -/
theorem two_lt_enatToEInt_add_krullDimToEInt {dep : ℕ∞} {e : ℕ} (h : (3 : ℕ∞) ≤ dep + e) :
    ((2 : ℤ) : EInt) < enatToEInt dep + krullDimToEInt ((e : ℕ∞) : WithBot ℕ∞) := by
  cases dep using ENat.recTopCoe with
  | top =>
    change ((2 : ℤ) : EInt) < (⊤ : EInt) + ((e : ℤ) : EInt)
    have : (⊤ : EInt) + ((e : ℤ) : EInt) = ⊤ := by
      change ((⊤ : WithTop ℤ) : WithBot (WithTop ℤ)) + (((e : ℤ) : WithTop ℤ) : WithBot _) = _
      rw [← WithBot.coe_add, WithTop.top_add]
      rfl
    rw [this]
    exact lt_top_iff_ne_top.mpr (WithBotTop.coe_ne_top _)
  | coe n =>
    have h' : 3 ≤ n + e := by exact_mod_cast h
    change ((2 : ℤ) : EInt) < ((n : ℤ) : EInt) + ((e : ℤ) : EInt)
    rw [← Stacks.Chow.coe_add_coe_eq_coe_add]
    exact WithBotTop.coe_lt_coe.mpr (by omega)

open IsLocalRing _root_.Stacks.AlgebraicGeometry

variable (S : AlgebraizationSituation.{u})

/-- The stalk of `I𝒪_U` at `y`, for `I = (g)`, is generated by the image of `g`. -/
theorem stalk_idealOnOpen_eq_span (g : S.A) (hI : S.I = Ideal.span {g}) (y : S.U.toScheme) :
    AlgebraicGeometry.IdealSheafData.stalk (idealOnOpen S) y =
      Ideal.span {baseToPointStalk S y g} := by
  rw [stalk_idealOnOpen_eq_map, hI, Ideal.map_span, Set.image_singleton]

/-- For `I = (g)`, the image of `g` in the stalk at a point of `U ∩ Y` is not a unit. -/
private theorem baseToPointStalk_mem_maximalIdeal (g : S.A) (hI : S.I = Ideal.span {g})
    (y : S.U.toScheme) (z : S.Y) (hyz : S.U.ι.base y = S.Yι.base z) :
    baseToPointStalk S y g ∈ maximalIdeal (S.U.toScheme.presheaf.stalk y) := by
  have := stalk_idealOnOpen_le_maximalIdeal S y z hyz
  rw [stalk_idealOnOpen_eq_span S g hI] at this
  exact this (Ideal.mem_span_singleton_self _)

/-- **Failure of the `(2, 3)`-inequalities from an annihilated prime.** Let `I = (g)`, let `y` be a
point of `U ∩ Y` at distance at most two from `Z`, and suppose the completed stalks of `(ℱₙ)` are
free of rank one. If in `A_𝔮` (`𝔮` the prime under `y`) some prime `𝔨` avoids `g`, is killed by
`g`, and `𝔨 + (g)` has radical the maximal ideal, then `(ℱₙ)` does not satisfy the
`(2, 3)`-inequalities. -/
theorem not_satisfiesDepthInequalities_of_annihilatedPrime
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))
    (hF : ∀ y : S.U.toScheme, Nonempty (completedStalk (idealOnOpen S) F y ≃ₗ[completedLocalRing
      (idealOnOpen S) y] completedLocalRing (idealOnOpen S) y))
    (g : S.A) (hI : S.I = Ideal.span {g}) (y : S.U.toScheme) (z : S.Y)
    (hyz : S.U.ι.base y = S.Yι.base z) (hδ : S.distanceToZ z ≤ 2)
    (𝔨 : Ideal (Localization.AtPrime (underlyingPrime S y).asIdeal)) [𝔨.IsPrime]
    (hg𝔨 : algebraMap S.A _ g ∉ 𝔨) (hann : ∀ k ∈ 𝔨, algebraMap S.A _ g * k = 0)
    (hrad : maximalIdeal _ ≤ (𝔨 ⊔ Ideal.span {algebraMap S.A _ g}).radical) :
    ¬ SatisfiesDepthInequalities S F 2 3 := by
  let ey := pointStalkRingEquiv S y
  have hey : ey (baseToPointStalk S y g) = algebraMap S.A _ g :=
    pointStalkRingEquiv_baseToPointStalk_apply S y g
  obtain ⟨𝔨', h𝔨'p, ht𝔨', hann', hrad'⟩ :=
    Stacks.AnnihilatedPrime.exists_prime_of_ringEquiv ey (baseToPointStalk S y g) 𝔨
      (hey ▸ hg𝔨) (hey ▸ hann) (hey ▸ hrad)
  obtain ⟨eM⟩ := hF y
  obtain ⟨p, hp, hfib, hdep⟩ :=
    Stacks.AdicCompletionAnnihilated.exists_prime_depth_localizedModule_eq_zero
      (AlgebraicGeometry.IdealSheafData.stalk (idealOnOpen S) y)
      (stalk_idealOnOpen_eq_span S g hI y) (baseToPointStalk_mem_maximalIdeal S g hI y z hyz) 𝔨'
      ht𝔨' hann' hrad' (completedStalk (idealOnOpen S) F y) eM
  exact not_satisfiesDepthInequalities_two_three S F y z hyz hδ p hp hfib hdep

/-- **The pointwise bound from a regular annihilated quotient.** Let `I = (g)` and suppose the
completed stalks of `(ℱₙ)` are free of rank one. At a point `y` of `U ∩ Y`, if either `g` vanishes
in `A_𝔮`, or some ideal of `A_𝔮` killed by `g` has a regular local quotient of dimension at least
three, then `depth((ℱ_y^∧)_𝔭) + dim(𝒪_{X,y}^∧/𝔭) > 2` at every `𝔭 ∉ V(I𝒪_{X,y}^∧)`. -/
theorem two_lt_depth_add_dim_of_cases
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))
    (hF : ∀ y : S.U.toScheme, Nonempty (completedStalk (idealOnOpen S) F y ≃ₗ[completedLocalRing
      (idealOnOpen S) y] completedLocalRing (idealOnOpen S) y))
    (g : S.A) (hI : S.I = Ideal.span {g}) (y : S.U.toScheme) (z : S.Y)
    (hyz : S.U.ι.base y = S.Yι.base z)
    (hcases : algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal) g = 0 ∨
      ∃ 𝔨 : Ideal (Localization.AtPrime (underlyingPrime S y).asIdeal),
        (∀ k ∈ 𝔨, algebraMap S.A _ g * k = 0) ∧ IsRegularLocalRing (_ ⧸ 𝔨) ∧
          (3 : WithBot ℕ∞) ≤ ringKrullDim (_ ⧸ 𝔨))
    (p : PrimeSpectrum (completedLocalRing (idealOnOpen S) y))
    (hp : ¬ completedLocalIdeal (idealOnOpen S) y ≤ p.asIdeal) :
    ((2 : ℤ) : EInt) <
      enatToEInt (completedStalkDepth (idealOnOpen S) F y p) +
        krullDimToEInt (ringKrullDim (completedLocalRing (idealOnOpen S) y ⧸ p.asIdeal)) := by
  let ey := pointStalkRingEquiv S y
  have hey : ey (baseToPointStalk S y g) = algebraMap S.A _ g :=
    pointStalkRingEquiv_baseToPointStalk_apply S y g
  rcases hcases with h0 | ⟨𝔨, hann, hreg, hdim⟩
  · exfalso
    apply hp
    have hg0 : baseToPointStalk S y g = 0 := ey.injective (by rw [hey, h0, map_zero])
    refine Ideal.map_le_iff_le_comap.mpr fun j hj => ?_
    rw [stalk_idealOnOpen_eq_span S g hI, hg0, Ideal.mem_span_singleton] at hj
    obtain ⟨c, rfl⟩ := hj
    simp
  · obtain ⟨𝔨', hann', hreg', hdim'⟩ :=
      Stacks.AnnihilatedPrime.exists_regular_quotient_of_ringEquiv ey (baseToPointStalk S y g) 𝔨
        3 (hey ▸ hann) hreg hdim
    obtain ⟨eM⟩ := hF y
    have := hreg'
    obtain ⟨e, he, hle⟩ :=
      Stacks.AdicCompletionAnnihilated.exists_ringKrullDim_quotient_eq_and_le_depth_add
        (AlgebraicGeometry.IdealSheafData.stalk (idealOnOpen S) y)
        (stalk_idealOnOpen_eq_span S g hI y) (baseToPointStalk_mem_maximalIdeal S g hI y z hyz) 𝔨'
        hann' (d := 3) (by exact_mod_cast hdim') (completedStalk (idealOnOpen S) F y) eM p hp
    rw [he]
    exact two_lt_enatToEInt_add_krullDimToEInt (by exact_mod_cast hle)

end Stacks.Algebraization


namespace Stacks.NonCatenaryExample

open IsLocalRing Stacks.Algebraization Stacks.Pinch

variable (K : Type u) [Field K] (e : K ≃+* FractionRing (MvPolynomial (Fin 3) K))

/-- `x₁ · (Q₀B ∩ A) ⊆ 𝔟`. -/
theorem elemF_mul_mem_idealB (a : RingA K e) (ha : a ∈ primeA K e (idealQ0 K)) :
    elemF K e * a ∈ idealB K e := by
  refine Ideal.mem_comap.mpr ⟨?_, ?_⟩
  · simpa using Ideal.mul_mem_left _ ((elemF K e : RingB K)) ha
  · simpa using Ideal.mul_mem_right ((a : RingB K)) _ (elemF_mem_primeA_W K e)

/-- In every localization of `A''` at a prime, `x₁` kills the extension of `Q₀''`. -/
theorem elemF_mul_eq_zero_of_mem (q : Ideal (RingA2 K e)) [q.IsPrime]
    (k : Localization.AtPrime q)
    (hk : k ∈ ((primeA K e (idealQ0 K)).map (Ideal.Quotient.mk (idealB K e))).map
      (algebraMap (RingA2 K e) (Localization.AtPrime q))) :
    algebraMap (RingA2 K e) (Localization.AtPrime q) (Ideal.Quotient.mk _ (elemF K e)) * k = 0 := by
  have hann : ∀ a ∈ (primeA K e (idealQ0 K)).map (Ideal.Quotient.mk (idealB K e)),
      Ideal.Quotient.mk (idealB K e) (elemF K e) * a = 0 := by
    intro a ha
    obtain ⟨a', ha', rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp ha
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact elemF_mul_mem_idealB K e a' ha'
  obtain ⟨⟨⟨a, ha⟩, t⟩, hkt⟩ := (IsLocalization.mem_map_algebraMap_iff q.primeCompl _).mp hk
  have hu : IsUnit (algebraMap (RingA2 K e) (Localization.AtPrime q) t) :=
    IsLocalization.map_units _ t
  refine (hu.mul_left_eq_zero).mp ?_
  rw [mul_assoc, hkt, ← map_mul, hann a ha, map_zero]

/-- The prime `P'' = (PB ∩ A)/𝔟` of `A''`. -/
def primePpp : PrimeSpectrum (RingA2 K e) :=
  ⟨(primeA K e (idealP K)).map (Ideal.Quotient.mk (idealB K e)),
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
      rw [Ideal.mk_ker]
      exact (idealB_le_primeA_Q0 K e).trans
        (Ideal.comap_mono (Ideal.map_mono (idealQ0_le_idealP K))))⟩

/-- The preimage of `P''` in `A` is `PB ∩ A`. -/
theorem comap_primePpp :
    (primePpp K e).asIdeal.comap (Ideal.Quotient.mk (idealB K e)) = primeA K e (idealP K) := by
  change ((primeA K e (idealP K)).map _).comap _ = _
  exact Ideal.comap_map_mk
    ((idealB_le_primeA_Q0 K e).trans (Ideal.comap_mono (Ideal.map_mono (idealQ0_le_idealP K))))

/-- The prime `P''` is not the maximal ideal of `A''`. -/
theorem primePpp_ne_maximalIdeal : (primePpp K e).asIdeal ≠ maximalIdeal (RingA2 K e) := by
  intro h
  have h1 := comap_primePpp K e
  rw [h] at h1
  have h2 : (maximalIdeal (RingA2 K e)).comap (Ideal.Quotient.mk (idealB K e)) =
      maximalIdeal (RingA K e) :=
    IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
  exact comap_isPrime_ne_maximalIdeal (φ := residueEquiv K e) (maximal_eq_or_eq K)
    (ext K (idealP K)) (notMax_P K) (h1.symm.trans h2)

/-- The image of `P` in `X = Spec A''` is the image of the point `P` of `Y`. -/
theorem Yι_base_ptP :
    (((situation K e).Yι.base (show (situation K e).Y from ptP K e) : (situation K e).X) :
      PrimeSpectrum (RingA2 K e)) =
      primePpp K e := by
  apply PrimeSpectrum.ext
  rw [Yι_base_asIdeal]
  change ((primeA K e (idealP K)).map (toY K e)).comap (Ideal.Quotient.mk (idealI K e)) = _
  rw [toY, ← Ideal.map_map]
  refine Ideal.comap_map_mk ?_
  change Ideal.span _ ≤ _
  rw [Ideal.span_le, Set.singleton_subset_iff]
  exact Ideal.mem_map_of_mem _ (elemF_mem_primeA K e (Ideal.subset_span (by simp)))

/-- The element `g = x₁` of `A''` generating `I`. -/
abbrev elemG : RingA2 K e := Ideal.Quotient.mk (idealB K e) (elemF K e)

/-- The formal module of the counterexample: the completion of `𝒪_U` along `I𝒪_U`. -/
abbrev formalModule : Stacks.Coherent.CoherentAdicSystems (idealOnOpen (situation K e)) :=
  structureAdicSystem (situation K e).U.toScheme (idealOnOpen (situation K e))

/-- **The counterexample, from the two local computations.** If the localization of `A''` at
`P''` carries an annihilated prime, and at every prime `q ⊇ W''` of coheight one either `x₁`
vanishes in `A''_q` or some ideal killed by `x₁` has a regular local quotient of dimension at least
three, then the criterion of Stacks 0EJA fails for the completion of `𝒪_U`. -/
theorem not_iff_of_local
    (hR2 : ∃ 𝔨 : Ideal (Localization.AtPrime (primePpp K e).asIdeal), 𝔨.IsPrime ∧
      algebraMap (RingA2 K e) _ (elemG K e) ∉ 𝔨 ∧
      (∀ k ∈ 𝔨, algebraMap (RingA2 K e) _ (elemG K e) * k = 0) ∧
      maximalIdeal _ ≤ (𝔨 ⊔ Ideal.span {algebraMap (RingA2 K e) _ (elemG K e)}).radical)
    (hR1 : ∀ q : PrimeSpectrum (RingA2 K e),
      (primeA K e (idealW K)).map (Ideal.Quotient.mk (idealB K e)) ≤ q.asIdeal →
      q.asIdeal ≠ maximalIdeal (RingA2 K e) → Order.coheight q = 1 →
      algebraMap (RingA2 K e) (Localization.AtPrime q.asIdeal) (elemG K e) = 0 ∨
        ∃ 𝔨 : Ideal (Localization.AtPrime q.asIdeal),
          (∀ k ∈ 𝔨, algebraMap (RingA2 K e) _ (elemG K e) * k = 0) ∧
          IsRegularLocalRing (_ ⧸ 𝔨) ∧ (3 : WithBot ℕ∞) ≤ ringKrullDim (_ ⧸ 𝔨)) :
    ¬ (SatisfiesDepthInequalities (situation K e) (formalModule K e) 2 3 ↔
      ∀ (y : (situation K e).U.toScheme) (z : (situation K e).Y),
        (situation K e).U.ι.base y = (situation K e).Yι.base z →
        Order.height ((situation K e).U.ι.base y) = 1 →
        ∀ p : PrimeSpectrum (completedLocalRing (idealOnOpen (situation K e)) y),
          ¬ completedLocalIdeal (idealOnOpen (situation K e)) y ≤ p.asIdeal →
          ((2 : ℤ) : EInt) <
            enatToEInt (completedStalkDepth (idealOnOpen (situation K e)) (formalModule K e) y p) +
              krullDimToEInt (ringKrullDim
                (completedLocalRing (idealOnOpen (situation K e)) y ⧸ p.asIdeal))) := by
  set S := situation K e
  have hF : ∀ y : S.U.toScheme, Nonempty (completedStalk (idealOnOpen S) (formalModule K e) y ≃ₗ[
      completedLocalRing (idealOnOpen S) y] completedLocalRing (idealOnOpen S) y) :=
    fun y => nonempty_completedStalk_structureAdicSystem_linearEquiv _ _ y
  have hI : S.I = Ideal.span {elemG K e} := rfl
  intro hiff
  have hrhs := fun y z hyz hheight p hp =>
    two_lt_depth_add_dim_of_cases S (formalModule K e) hF (elemG K e) hI y z hyz (by
      have hcoh : Order.coheight (underlyingPrime S y) = 1 := by
        rwa [← height_U_ι_base_eq_coheight]
      have hne : (underlyingPrime S y).asIdeal ≠ maximalIdeal (RingA2 K e) := fun h =>
        not_le_underlyingPrime S y (h ▸ le_rfl)
      have hW : (primeA K e (idealW K)).map (Ideal.Quotient.mk (idealB K e)) ≤
          (underlyingPrime S y).asIdeal :=
        Ideal.map_le_iff_le_comap.mpr <| primeA_W_le K e _
          (fun a ha => Ideal.mem_comap.mpr (by
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
            exact Submodule.zero_mem _))
          (I_le_of_eq_Yι_base S y z hyz (Ideal.subset_span (Set.mem_singleton _)))
      exact hR1 _ hW hne hcoh) p hp
  obtain ⟨y, hy⟩ := exists_underlyingPrime_eq S (primePpp K e) fun h =>
    primePpp_ne_maximalIdeal K e
      (le_antisymm (le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)) h)
  have hyz : S.U.ι.base y = S.Yι.base (show S.Y from ptP K e) := by
    change (underlyingPrime S y : S.X) = _
    rw [hy]
    exact (Yι_base_ptP K e).symm
  have key : ∀ q : PrimeSpectrum (RingA2 K e), q = primePpp K e →
      ∃ 𝔨 : Ideal (Localization.AtPrime q.asIdeal), 𝔨.IsPrime ∧
        algebraMap (RingA2 K e) _ (elemG K e) ∉ 𝔨 ∧
        (∀ k ∈ 𝔨, algebraMap (RingA2 K e) _ (elemG K e) * k = 0) ∧
        maximalIdeal _ ≤ (𝔨 ⊔ Ideal.span {algebraMap (RingA2 K e) _ (elemG K e)}).radical := by
    rintro q rfl
    exact hR2
  obtain ⟨𝔨', h𝔨'p, h1', h2', h3'⟩ := key (underlyingPrime S y) hy
  exact not_satisfiesDepthInequalities_of_annihilatedPrime S (formalModule K e) hF (elemG K e) hI
    y (show S.Y from ptP K e) hyz (distanceToZ_ptP_le_two K e) 𝔨' h1' h2' h3'
    (hiff.mpr hrhs)

end Stacks.NonCatenaryExample

end
