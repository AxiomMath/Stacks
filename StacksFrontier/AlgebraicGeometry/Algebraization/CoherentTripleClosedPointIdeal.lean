module

public import StacksFrontier.AlgebraicGeometry.Algebraization.CoherentTriplePuncturedComplement
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.ExtensionOfSections

/-!
# The ideal of the closed point, read at the global sections of `Spec A`

`Stacks.Algebraization.puncturedSpectrum_eq_idealComplement` identifies the punctured spectrum
with the ideal-sheaf complement of the closed point's kernel ideal sheaf
`Scheme.Hom.ker (Spec.map (IsLocalRing.residue A))`. To apply the affine extension-of-sections
machinery of `Stacks.LocalCohomology.exists_idealPow_hom_of_section_on_affine_of_torsionFree` to
that ideal sheaf, its value at the global sections of `Spec A` is needed as an ideal of `A`
itself, read through the canonical identification `Scheme.ΓSpecIso`. This file supplies that.

## Main results

* `Stacks.Algebraization.closedPointIdealSheaf_ideal_top`: the ideal of the closed point's
  kernel ideal sheaf, at the global sections of `Spec A`, is the image of the maximal ideal of
  `A` under the inverse of `Scheme.ΓSpecIso`.
* `Stacks.Algebraization.exists_finite_generators_closedPointIdealSheaf`: since `A` is
  Noetherian, that ideal is generated by a finite family of global sections, as the extension
  machinery of `exists_idealPow_hom_of_section_on_affine_of_torsionFree` requires.
* `Stacks.Algebraization.exists_idealPow_hom_of_preparedExtension`: the extension machinery
  applied to the coherent module of a prepared extension, discharging its torsion-freeness
  hypothesis directly from the prepared extension's own `f`-regularity.

## References

* [Stacks Project, Tag 0F23](https://stacks.math.columbia.edu/tag/0F23)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Algebraization

/-- **The ideal of the closed point, read at the global sections of `Spec A`.** The kernel ideal
sheaf of `Spec (ResidueField A) ⟶ Spec A`, evaluated at the top affine open, is the image of the
maximal ideal of `A` under the inverse of the canonical identification `Scheme.ΓSpecIso`.

The computation is pointwise: `Scheme.ΓSpecIso_naturality` identifies, for every global section
`x`, the image of `x` under `Scheme.ΓSpecIso` followed by the residue map with the image of
`x` under the kernel map followed by `Scheme.ΓSpecIso` on the residue field side; since the
latter is injective, `x` lies in the kernel of the residue-field map exactly when the former
image of `x` lies in the kernel of the residue map, i.e. in the maximal ideal. -/
public theorem closedPointIdealSheaf_ideal_top (A : Type u) [CommRing A] [IsLocalRing A] :
    (Scheme.Hom.ker
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
      ⟨⊤, isAffineOpen_top (baseScheme A)⟩ =
      Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (IsLocalRing.maximalIdeal A) := by
  have htop : (Scheme.Hom.ker
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
        ⟨⊤, isAffineOpen_top (baseScheme A)⟩ =
      RingHom.ker (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))).appTop.hom := by
    rw [Scheme.ker_of_isAffine]
    simp [Scheme.IdealSheafData.ofIdealTop]
  rw [htop]
  set R := CommRingCat.of A
  set S := CommRingCat.of (IsLocalRing.ResidueField A)
  set φ : R ⟶ S := CommRingCat.ofHom (IsLocalRing.residue A)
  have hpoint : ∀ y : Γ((baseScheme A), ⊤),
      (Scheme.ΓSpecIso S).hom.hom ((Spec.map φ).appTop.hom y) =
        IsLocalRing.residue A ((Scheme.ΓSpecIso R).hom.hom y) :=
    fun y => ConcreteCategory.congr_hom (Scheme.ΓSpecIso_naturality φ) y
  ext x
  rw [RingHom.mem_ker, Ideal.mem_map_iff_of_surjective _
    (fun a => ⟨(Scheme.ΓSpecIso R).hom.hom a, Iso.hom_inv_id_apply (Scheme.ΓSpecIso R) a⟩)]
  constructor
  · intro hx
    refine ⟨(Scheme.ΓSpecIso R).hom.hom x, ?_, Iso.hom_inv_id_apply (Scheme.ΓSpecIso R) x⟩
    rw [← IsLocalRing.ker_residue, RingHom.mem_ker, ← hpoint x, hx, map_zero]
  · rintro ⟨a, ha, rfl⟩
    have h0 : (Scheme.ΓSpecIso S).hom.hom
        ((Spec.map φ).appTop.hom ((Scheme.ΓSpecIso R).inv.hom a)) = 0 := by
      rw [hpoint, Iso.inv_hom_id_apply (Scheme.ΓSpecIso R) a]
      exact RingHom.mem_ker.mp (IsLocalRing.ker_residue (R := A) ▸ ha)
    exact (map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso
      (Scheme.ΓSpecIso S).hom).1).mp h0

/-- **A finite family of generators for the closed point's kernel ideal sheaf, at the global
sections of `Spec A`.** Since `A` is Noetherian, its maximal ideal is finitely generated by some
finite family `t`; pushing `t` through `(Scheme.ΓSpecIso A).inv` and through
`closedPointIdealSheaf_ideal_top` gives a finite family of global sections of `Spec A` generating
the ideal `(Scheme.Hom.ker (Spec.map (IsLocalRing.residue A))).ideal ⊤`. -/
public theorem exists_finite_generators_closedPointIdealSheaf
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] :
    ∃ (ι : Type u) (_ : Fintype ι) (a : ι → Γ(baseScheme A, ⊤)),
      (Scheme.Hom.ker
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
        ⟨⊤, isAffineOpen_top (baseScheme A)⟩ = Ideal.span (Set.range a) := by
  obtain ⟨t, ht⟩ := Ideal.fg_of_isNoetherianRing (IsLocalRing.maximalIdeal A)
  classical
  refine ⟨(t : Set A), inferInstance,
    fun x => (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom x, ?_⟩
  rw [closedPointIdealSheaf_ideal_top, ← ht, Ideal.map_span]
  congr 1
  ext y
  simp [Set.range, Subtype.exists]

/-- **The extension machinery applied to a prepared extension.** Let `P` be a prepared extension
of a coherent triple `T` at `f`, and let `s` be a section of `P.F'` on the ideal-sheaf complement
of the closed point. Then some power of the closed point's kernel ideal sheaf, read at the
global sections of `Spec A`, admits a `Γ(Spec A, ⊤)`-linear map into `Γ(P.F', ⊤)` which, on the
basic open of each generator of a chosen finite generating family, agrees with multiplication by
`s`.

The torsion-freeness hypothesis of
`Stacks.LocalCohomology.exists_idealPow_hom_of_section_on_affine_of_torsionFree` is discharged
directly from `P.regular` at `V = ⊤`: an element of the closed point's ideal killing a section is,
in particular, killed by the image of `f` itself (since `f` lies in the maximal ideal), and `f`
acts regularly on `Γ(P.F', ⊤)` by `P.regular`. This bypasses the associated-prime framing of
`not_isAssociatedPrimeStacks_maximalIdeal_of_isSMulRegular` entirely: that lemma is not needed to
supply this hypothesis, which is a direct one-line consequence of regularity. -/
public theorem exists_idealPow_hom_of_preparedExtension
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    {f : A} (hf : f ∈ IsLocalRing.maximalIdeal A)
    {T : CoherentTriple A f} (P : PreparedExtension A f T)
    (s : Γ(P.F', Stacks.LocalCohomology.idealComplement
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))))) :
    ∃ (ι : Type u) (_ : Fintype ι) (a : ι → Γ(Spec (CommRingCat.of A), ⊤))
      (hspan : (Scheme.Hom.ker
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
          ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩ = Ideal.span (Set.range a))
      (ha : ∀ i, a i ∈ (Scheme.Hom.ker
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
          ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩)
      (N : ℕ)
      (φ : ↥(((Scheme.Hom.ker
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
            ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩) ^ N) →ₗ[Γ(Spec (CommRingCat.of A), ⊤)]
          Γ(P.F', ⊤)),
      ∀ (i : ι) (x : ↥(((Scheme.Hom.ker
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).ideal
            ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩) ^ N)),
        P.F'.presheaf.map (homOfLE ((Spec (CommRingCat.of A)).basicOpen_le (a i))).op (φ x) =
          ((Spec (CommRingCat.of A)).presheaf.map
            (homOfLE ((Spec (CommRingCat.of A)).basicOpen_le (a i))).op
            (x : Γ(Spec (CommRingCat.of A), ⊤))) •
            P.F'.presheaf.map (homOfLE (Stacks.LocalCohomology.basicOpen_le_idealComplement
              _ _ (ha i))).op s := by
  let I : (Spec (CommRingCat.of A)).IdealSheafData :=
    Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
  let U : (Spec (CommRingCat.of A)).affineOpens :=
    ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩
  obtain ⟨ι, hι, a, hspan⟩ := exists_finite_generators_closedPointIdealSheaf A
  have ha : ∀ i, a i ∈ I.ideal U := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  have := P.coherent
  have : P.F'.IsQuasicoherent := isQuasicoherent_of_isCoherent P.F'
  have hmapId :
      (Spec (CommRingCat.of A)).presheaf.map
        (homOfLE (le_top : (U : (Spec (CommRingCat.of A)).Opens) ≤ ⊤)).op = 𝟙 _ := by
    rw [show (homOfLE (le_top : (U : (Spec (CommRingCat.of A)).Opens) ≤ ⊤))
      = 𝟙 (U : (Spec (CommRingCat.of A)).Opens) from rfl]
    exact (Spec (CommRingCat.of A)).presheaf.map_id _
  have hfmem : (Scheme.ΓSpecIso (CommRingCat.of A)).inv f ∈ I.ideal U := by
    rw [closedPointIdealSheaf_ideal_top]
    exact Ideal.mem_map_of_mem _ hf
  have htf : ∀ y : Γ(P.F', (U : (Spec (CommRingCat.of A)).Opens)),
      (∀ b ∈ I.ideal U, b • y = 0) → y = 0 :=
    fun y hy => P.regular ⊤ (by
      simp only [hmapId, ConcreteCategory.id_apply]
      rw [hy _ hfmem, smul_zero])
  exact ⟨ι, hι, a, hspan, ha,
    Stacks.LocalCohomology.exists_idealPow_hom_of_section_on_affine_of_torsionFree
      I P.F' U a ha hspan s htf⟩

end Stacks.Algebraization

end
