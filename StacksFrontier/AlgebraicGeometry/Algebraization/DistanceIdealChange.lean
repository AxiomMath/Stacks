module

public import Mathlib.Topology.Homeomorph.Lemmas
public import StacksFrontier.AlgebraicGeometry.Algebraization.DistanceOneImmediateSpecialization
public import StacksFrontier.Topology.Dimension.Catenary

/-!
# The distance function under a change of the ideal with the same radical

The distance `δᵞ_Z(y)` of a point of a Noetherian scheme `Y` from a closed subset `Z` is built
from zigzags of irreducible closed subsets and the codimensions between them, so it depends
only on the topological space `Y` and the closed subset `Z`. A homeomorphism `Y ≃ Y'` carrying
`Z` onto `Z'` therefore carries `δᵞ_Z` to `δᵞ'_Z'`.

In an algebraization situation `(A, I ⊆ 𝔞)`, replace `I` by an ideal `J ⊆ 𝔞` with the same
radical. The closed subschemes `V(I)` and `V(J)` of `X = Spec(A)` have the same underlying set,
the zero locus of the common radical, so `Spec(A/J)` and `Spec(A/I)` are homeomorphic over `X`,
and the homeomorphism matches the two copies of `Z = V(𝔞)`. Hence the distance functions of the
two situations agree at points with the same image in `X`. This is the reduction used in the
proof of Stacks Tag 0EJN to replace `I` by an ideal generated by finitely many elements.

## Main definitions

* `Stacks.Algebraization.AlgebraizationSituation.withIdeal` — the situation with the same ring
  and the same `𝔞`, and the ideal `I` replaced by `J ⊆ 𝔞`.
* `Stacks.Algebraization.AlgebraizationSituation.withIdealYHomeomorph` — the homeomorphism
  `Spec(A/J) ≃ Spec(A/I)` over `X` when `J` and `I` have the same radical.

## Main results

* `Stacks.Algebraization.distanceFunction_homeomorph` — the distance function is invariant
  under homeomorphisms.
* `Stacks.Algebraization.AlgebraizationSituation.distanceToZ_withIdeal` — changing `I` to an
  ideal with the same radical does not change `δᵞ_Z`.
* `Stacks.Algebraization.AlgebraizationSituation.exists_withIdeal_Yι_eq` and
  `Stacks.Algebraization.AlgebraizationSituation.exists_Yι_eq_of_withIdeal` — the points of the
  two copies of `Y` correspond through their images in `X`.

## Implementation notes

A zigzag is transported along a homeomorphism by taking images of its irreducible closed subsets
(`TopologicalSpace.IrreducibleCloseds.map`), an order isomorphism, which preserves the
relative codimension of every pair by `IrreducibleClosedsCodim.topCodim_eq_of_le_iff`.

The situation `withIdeal` is a structure literal, so its ring, its ideal `𝔞`, and the schemes
`X`, `Z` and the open `U` built from them are definitionally those of the original situation.

## References

* [Stacks Project, Tag 0EIX](https://stacks.math.columbia.edu/tag/0EIX), the distance function.
* [Stacks Project, Tag 0EJN](https://stacks.math.columbia.edu/tag/0EJN)
-/

@[expose] public noncomputable section

open AlgebraicGeometry TopologicalSpace IrreducibleClosedsCodim

universe u v

namespace Stacks.Algebraization

section Homeomorph

variable {Y : Scheme.{u}} {Y' : Scheme.{v}}

/-- The irreducible closed subset induced by a homeomorphism is the image. -/
private theorem coe_map_homeomorph (h : Y ≃ₜ Y') (T : IrreducibleCloseds Y) :
    (IrreducibleCloseds.map h h.continuous T : Set Y') = h '' T := by
  rw [IrreducibleCloseds.coe_map]
  exact (h.isClosedMap _ T.isClosed).closure_eq

/-- Taking images along a homeomorphism reflects and preserves inclusions. -/
private theorem map_homeomorph_le_iff (h : Y ≃ₜ Y') (T T' : IrreducibleCloseds Y) :
    IrreducibleCloseds.map h h.continuous T ≤ IrreducibleCloseds.map h h.continuous T' ↔
      T ≤ T' := by
  rw [← SetLike.coe_subset_coe, coe_map_homeomorph, coe_map_homeomorph,
    Set.image_subset_image_iff h.injective, SetLike.coe_subset_coe]

/-- Every irreducible closed subset is the image of one along a homeomorphism. -/
private theorem map_homeomorph_surjective (h : Y ≃ₜ Y') :
    Function.Surjective (IrreducibleCloseds.map h h.continuous) := fun T' =>
  ⟨IrreducibleCloseds.map h.symm h.symm.continuous T', SetLike.coe_injective (by
    rw [coe_map_homeomorph, IrreducibleCloseds.coe_map,
      (h.symm.isClosedMap _ T'.isClosed).closure_eq, ← Set.image_comp, h.self_comp_symm,
      Set.image_id])⟩

/-- A homeomorphism carrying `Z` to `Z'` transports systems from `Z` to `y` into systems from
`Z'` to `h y`, by taking images of all the irreducible closed subsets. -/
private def DistanceSystem.mapHomeomorph (h : Y ≃ₜ Y') {Z : Closeds Y} {Z' : Closeds Y'}
    (hZ : h ⁻¹' (Z' : Set Y') = Z) {y : Y} (s : DistanceSystem Y Z y) :
    DistanceSystem Y' Z' (h y) where
  k := s.k
  V i := IrreducibleCloseds.map h h.continuous (s.V i)
  W i := IrreducibleCloseds.map h h.continuous (s.W i)
  V_le_W i := (map_homeomorph_le_iff h _ _).mpr (s.V_le_W i)
  V_next_le_W i := (map_homeomorph_le_iff h _ _).mpr (s.V_next_le_W i)
  V_zero_subset := by
    rw [coe_map_homeomorph, Set.image_subset_iff, hZ]
    exact s.V_zero_subset
  W_last_eq_closure := by
    rw [coe_map_homeomorph, s.W_last_eq_closure, h.image_closure,
      Set.image_singleton]

private theorem DistanceSystem.weight_mapHomeomorph [IsNoetherian Y] [IsNoetherian Y']
    (h : Y ≃ₜ Y') {Z : Closeds Y} {Z' : Closeds Y'} (hZ : h ⁻¹' (Z' : Set Y') = Z) {y : Y}
    (s : DistanceSystem Y Z y) :
    (s.mapHomeomorph h hZ).weight = s.weight := by
  classical
  have hc (a b : IrreducibleCloseds Y) :
      topCodim (IrreducibleCloseds.map h h.continuous a)
        (IrreducibleCloseds.map h h.continuous b) = topCodim a b :=
    topCodim_eq_of_le_iff _ (fun _ _ => map_homeomorph_le_iff h _ _)
      a b (fun T _ => map_homeomorph_surjective h T)
  simp only [DistanceSystem.weight, DistanceSystem.upCodimension,
    DistanceSystem.downCodimension, DistanceSystem.mapHomeomorph, hc]
  rfl

private theorem distanceFunction_homeomorph_le [IsNoetherian Y] [IsNoetherian Y']
    (h : Y ≃ₜ Y') (Z : Closeds Y) (Z' : Closeds Y') (hZ : h ⁻¹' (Z' : Set Y') = Z) (y : Y) :
    distanceFunction Y' Z' (h y) ≤ distanceFunction Y Z y := by
  by_cases hY : (connectedComponent y ∩ (Z : Set Y)).Nonempty
  · have hY' : (connectedComponent (h y) ∩ (Z' : Set Y')).Nonempty := by
      obtain ⟨x, hx, hxZ⟩ := hY
      refine ⟨h x, h.continuous.image_connectedComponent_subset y ⟨x, hx, rfl⟩, ?_⟩
      rw [← hZ] at hxZ
      exact hxZ
    rw [distanceFunction_eq_iInf_of_nonempty Y Z y hY,
      distanceFunction_eq_iInf_of_nonempty Y' Z' (h y) hY']
    refine le_iInf fun s => ?_
    exact (iInf_le _ (s.mapHomeomorph h hZ)).trans_eq
      (congrArg (fun n : ℕ => (n : ℕ∞)) (s.weight_mapHomeomorph h hZ))
  · rw [distanceFunction_eq_top_of_disjoint Y Z y hY]
    exact le_top

/-- The distance function of a Noetherian scheme from a closed subset is a topological
invariant: a homeomorphism `h : Y ≃ Y'` with `h⁻¹(Z') = Z` satisfies
`δᵞ'_Z'(h y) = δᵞ_Z(y)`. -/
public theorem distanceFunction_homeomorph [IsNoetherian Y] [IsNoetherian Y']
    (h : Y ≃ₜ Y') (Z : Closeds Y) (Z' : Closeds Y') (hZ : h ⁻¹' (Z' : Set Y') = Z) (y : Y) :
    distanceFunction Y' Z' (h y) = distanceFunction Y Z y := by
  refine le_antisymm (distanceFunction_homeomorph_le h Z Z' hZ y) ?_
  have hZ' : h.symm ⁻¹' (Z : Set Y) = Z' := by
    rw [← hZ, ← Set.preimage_comp, h.self_comp_symm, Set.preimage_id]
  simpa using distanceFunction_homeomorph_le h.symm Z' Z hZ' (h y)

end Homeomorph

namespace AlgebraizationSituation

variable (S : AlgebraizationSituation.{u}) (J : Ideal S.A) (hJ : J ≤ S.a)

/-- The algebraization situation with the same ring and the same `𝔞`, and the ideal `I`
replaced by `J ≤ 𝔞`. -/
public abbrev withIdeal : AlgebraizationSituation.{u} where
  A := S.A
  I := J
  a := S.a
  I_le_a := hJ

/-- The ideal `I` of `S.withIdeal J hJ` is `J`. -/
@[simp]
public theorem withIdeal_I : (S.withIdeal J hJ).I = J := rfl

/-- The ideal `𝔞` of `S.withIdeal J hJ` is that of `S`. -/
@[simp]
public theorem withIdeal_a : (S.withIdeal J hJ).a = S.a := rfl

/-- The range of the closed immersion `Spec(A/I) ⟶ Spec(A)` is the zero locus of the
radical of `I`. -/
private theorem range_Yι_base_eq_zeroLocus_radical (T : AlgebraizationSituation.{u}) :
    Set.range T.Yι.base = PrimeSpectrum.zeroLocus (T.I.radical : Set T.A) := by
  have h := _root_.range_comap_of_surjective (T.A ⧸ T.I) (Ideal.Quotient.mk T.I)
    Ideal.Quotient.mk_surjective
  rw [Ideal.mk_ker] at h
  rw [PrimeSpectrum.zeroLocus_radical]
  exact h

variable {S J hJ}

/-- Ideals with the same radical give closed subschemes of `X` with the same range. -/
public theorem range_withIdeal_Yι_base (hrad : J.radical = S.I.radical) :
    Set.range (S.withIdeal J hJ).Yι.base = Set.range S.Yι.base := by
  rw [range_Yι_base_eq_zeroLocus_radical, range_Yι_base_eq_zeroLocus_radical]
  exact congrArg (fun K : Ideal S.A => PrimeSpectrum.zeroLocus (K : Set S.A)) hrad

/-- For `J` with the same radical as `I`, the homeomorphism `Spec(A/J) ≃ Spec(A/I)` over
`X = Spec(A)`: both closed immersions into `X` are closed embeddings with the same range. -/
public def withIdealYHomeomorph (hrad : J.radical = S.I.radical) :
    (S.withIdeal J hJ).Y ≃ₜ S.Y :=
  ((S.withIdeal J hJ).Yι.isClosedEmbedding.isEmbedding.toHomeomorph.trans
    (Homeomorph.setCongr (range_withIdeal_Yι_base hrad))).trans
    S.Yι.isClosedEmbedding.isEmbedding.toHomeomorph.symm

/-- The homeomorphism `withIdealYHomeomorph` lies over `X`. -/
@[simp]
public theorem Yι_base_withIdealYHomeomorph (hrad : J.radical = S.I.radical)
    (z' : (S.withIdeal J hJ).Y) :
    S.Yι.base (withIdealYHomeomorph hrad z') = (S.withIdeal J hJ).Yι.base z' := by
  have key := congrArg Subtype.val
    (S.Yι.isClosedEmbedding.isEmbedding.toHomeomorph.apply_symm_apply
      (Homeomorph.setCongr (range_withIdeal_Yι_base hrad)
        ((S.withIdeal J hJ).Yι.isClosedEmbedding.isEmbedding.toHomeomorph z')))
  rw [Topology.IsEmbedding.toHomeomorph_apply_coe] at key
  exact key

/-- The homeomorphism `withIdealYHomeomorph` matches the two copies of `Z = V(𝔞)`: both are the
points whose image in `X` lies in `V(𝔞)`. -/
public theorem preimage_withIdealYHomeomorph_closedSubsetZ (hrad : J.radical = S.I.radical) :
    withIdealYHomeomorph hrad ⁻¹' (S.closedSubsetZ : Set S.Y) =
      ((S.withIdeal J hJ).closedSubsetZ : Set (S.withIdeal J hJ).Y) := by
  ext z'
  rw [Set.mem_preimage, mem_closedSubsetZ_iff_mem_range_Zι,
    mem_closedSubsetZ_iff_mem_range_Zι, Yι_base_withIdealYHomeomorph]
  rfl

/-- Replacing `I` by an ideal `J ⊆ 𝔞` with the same radical does not change the distance
function `δᵞ_Z`: it agrees at points of `V(J)` and `V(I)` with the same image in `X`. -/
public theorem distanceToZ_withIdeal (S : AlgebraizationSituation.{u}) (J : Ideal S.A)
    (hJ : J ≤ S.a) (hrad : J.radical = S.I.radical) (z' : (S.withIdeal J hJ).Y) (z : S.Y)
    (h : (S.withIdeal J hJ).Yι.base z' = S.Yι.base z) :
    (S.withIdeal J hJ).distanceToZ z' = S.distanceToZ z := by
  have hz : withIdealYHomeomorph hrad z' = z :=
    S.Yι.isClosedEmbedding.injective ((Yι_base_withIdealYHomeomorph hrad z').trans h)
  rw [← hz]
  exact (distanceFunction_homeomorph _ _ _ (preimage_withIdealYHomeomorph_closedSubsetZ hrad)
    z').symm

/-- Every point of `V(I)` has the same image in `X` as a point of `V(J)`, when `J` and `I`
have the same radical. -/
public theorem exists_withIdeal_Yι_eq (S : AlgebraizationSituation.{u}) (J : Ideal S.A)
    (hJ : J ≤ S.a) (hrad : J.radical = S.I.radical) (z : S.Y) :
    ∃ z' : (S.withIdeal J hJ).Y, (S.withIdeal J hJ).Yι.base z' = S.Yι.base z :=
  ⟨(withIdealYHomeomorph hrad).symm z, by
    rw [← Yι_base_withIdealYHomeomorph hrad, Homeomorph.apply_symm_apply]⟩

/-- Every point of `V(J)` has the same image in `X` as a point of `V(I)`, when `J` and `I`
have the same radical. -/
public theorem exists_Yι_eq_of_withIdeal (S : AlgebraizationSituation.{u}) (J : Ideal S.A)
    (hJ : J ≤ S.a) (hrad : J.radical = S.I.radical) (z' : (S.withIdeal J hJ).Y) :
    ∃ z : S.Y, S.Yι.base z = (S.withIdeal J hJ).Yι.base z' :=
  ⟨withIdealYHomeomorph hrad z', Yι_base_withIdealYHomeomorph hrad z'⟩

end AlgebraizationSituation

end Stacks.Algebraization
