module

public import StacksFrontier.AlgebraicGeometry.Algebraization.CoherentTripleInvertible
public import StacksFrontier.AlgebraicGeometry.Algebraization.CoherentTripleTorsionFreeSnake
public import StacksFrontier.AlgebraicGeometry.Scheme.Immersion.Quotient

/-!
# The kernel of the stalk map of the punctured closed immersion

Let `A` be a local ring and `f ∈ A`. The *punctured closed immersion*
`Stacks.Algebraization.puncturedClosedFibreRestriction` is the restriction of the closed immersion
`Spec (A / fA) ⟶ Spec A` to the punctured spectrum of `A`. This file computes the kernel of the
map it induces on local rings: at a point `p'` of the punctured closed fibre it is the principal
ideal generated by the germ of `f`,

  `ker 𝒪_{U, q} ⟶ 𝒪_{U', p'} = (germ_q f)`,

where `U` is the punctured spectrum, `U'` the punctured closed fibre and `q` the image of `p'`.

## Main results

* `Stacks.Algebraization.ker_stalkMap_closedImmersion`: the kernel of the stalk map of
  `Spec (A / fA) ⟶ Spec A` is the extension of `(f)` to the local ring of `Spec A`.
* `Stacks.Algebraization.ker_stalkMap_morphismRestrict`: the kernel of the stalk map of a
  restricted morphism `f ∣_ U` is the contraction of the kernel of the stalk map of `f` along
  the comparison of stalks `AlgebraicGeometry.morphismRestrictStalkMap`.
* `Stacks.Algebraization.Γgerm_comp_morphismRestrictStalkMap_left` and
  `Stacks.Algebraization.left_Γgerm_ι_appTop`: that comparison carries the germ of the
  restriction of a global section to the germ of the global section.
* `Stacks.Algebraization.ker_stalkMap_puncturedClosedImmersion`: the kernel at a point of the
  punctured closed fibre is `Ideal.span {germ (scalarGlobal A f)}`.

This is one of the two stalk computations the closed-fibre monicity of the third clause of
`Stacks.Algebraization.HasHilbertInductionStep` was waiting on; the other is in
`StacksFrontier.AlgebraicGeometry.Algebraization.CoherentTripleCokernelStalk`, and the consumer
that joins them is
`StacksFrontier.AlgebraicGeometry.Algebraization.CoherentTripleAssociatedPointsTransfer`.

## Implementation notes

The commutative algebra is `AlgebraicGeometry.stalkMap_quotient_ker`, Tag 01IG for
`Spec (R / I) ⟶ Spec R`, which identifies the kernel with `I R_p` through
`AlgebraicGeometry.quotientPrime`. What is added here is, first, the observation that every
point of `Spec (A / fA)` *is* such a `quotientPrime`, namely of its own contraction — that is
`Stacks.Algebraization.eq_quotientPrime`, by `Ideal.map_comap_of_surjective` — and second the
two transports: along the restriction of the morphism to an open of the target, and along the
identification of the germ of `Stacks.Algebraization.scalarGlobal` with the germ of `f`.

Both transports are written in term mode rather than with `rw`. The reason is specific:
`AlgebraicGeometry.morphismRestrictStalkMap` is stated at `x.1` for `x` a point of
`f ⁻¹ᵁ U`, whose type is the carrier of a *scheme* while the subtype projection expects the
carrier of an *open*; the two are definitionally equal but not at the reducible transparency
`kabstract` uses, so a goal mentioning `x.1` is rejected as not type-correct and every rewrite
into it fails with "did not find an occurrence". `exact` and `congrArg` elaborate at default
transparency and are unaffected. The one `rw` that survives,
`Scheme.Opens.germ_stalkIso_hom_assoc`, is given all its explicit arguments, which leaves the
pattern with no metavariable whose type needs that reduction.
-/

@[expose] public section

open CategoryTheory Opposite AlgebraicGeometry IsLocalRing

universe u

namespace Stacks.Algebraization

/-- The inclusion of the closed fibre is a closed immersion. -/
instance isClosedImmersion_closedImmersion (A : Type u) [CommRing A] (f : A) :
    IsClosedImmersion (closedImmersion A f) :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- The punctured closed immersion is a closed immersion: it is the restriction of one to an
open of the target. -/
instance isClosedImmersion_puncturedClosedImmersion (A : Type u) [CommRing A] [IsLocalRing A]
    (f : A) : IsClosedImmersion (puncturedClosedFibreRestriction A f) :=
  IsZariskiLocalAtTarget.restrict (P := @IsClosedImmersion) inferInstance _

/-- The ideal `(f)` is contained in the contraction of any prime of `A / fA`: its elements are
`0` there. -/
theorem span_le_comap (A : Type u) [CommRing A] (f : A)
    (z : PrimeSpectrum (A ⧸ Ideal.span {f})) :
    Ideal.span {f} ≤
      (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {f})) z).asIdeal := by
  intro a ha
  show (Ideal.Quotient.mk (Ideal.span {f})) a ∈ z.asIdeal
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
  exact Submodule.zero_mem _

/-- Every point of `Spec (A / fA)` is the `AlgebraicGeometry.quotientPrime` of its own
contraction to `Spec A`: the quotient map is surjective, so `(f)`-saturated ideals are recovered
by extension from their contractions. This is what lets Tag 01IG, which is stated at a
`quotientPrime`, be read at an arbitrary point. -/
theorem eq_quotientPrime (A : Type u) [CommRing A] (f : A)
    (z : PrimeSpectrum (A ⧸ Ideal.span {f})) :
    z = quotientPrime (Ideal.span {f})
      (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {f})) z).asIdeal
      (span_le_comap A f z) :=
  PrimeSpectrum.ext (Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective z.asIdeal).symm

/-- The kernel of the stalk map of the closed immersion `Spec (A/fA) ⟶ Spec A` is the ideal of
the local ring of `Spec A` generated by the germ of `f`. -/
theorem ker_stalkMap_closedImmersion (A : Type u) [CommRing A] (f : A)
    (z : closedFibre A f) :
    RingHom.ker ((closedImmersion A f).stalkMap z).hom =
      Ideal.map (StructureSheaf.toStalk A
        (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {f})) z)).hom (Ideal.span {f}) := by
  rw [eq_quotientPrime A f z]
  exact stalkMap_quotient_ker (Ideal.span {f})
    (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {f})) z).asIdeal (span_le_comap A f z)

/-- The kernel of the stalk map of a restricted morphism is the contraction of the kernel of the
stalk map of the morphism along the comparison of the stalks. -/
theorem ker_stalkMap_morphismRestrict {X Y : Scheme.{u}} (g : X ⟶ Y) (U : Y.Opens)
    (x : (g ⁻¹ᵁ U).toScheme) :
    RingHom.ker ((g ∣_ U).stalkMap x).hom =
      Ideal.comap ((AlgebraicGeometry.morphismRestrictStalkMap g U x).hom.left).hom
        (RingHom.ker (g.stalkMap x.1).hom) := by
  have hrinj : Function.Injective
      ((AlgebraicGeometry.morphismRestrictStalkMap g U x).hom.right).hom :=
    (ConcreteCategory.bijective_of_isIso _).1
  rw [RingHom.comap_ker, ← RingHom.ker_comp_of_injective
    (((g ∣_ U).stalkMap x).hom) hrinj]
  exact congrArg RingHom.ker
    (congrArg CommRingCat.Hom.hom (AlgebraicGeometry.morphismRestrictStalkMap g U x).hom.w.symm)

/-- The stalk comparison of `AlgebraicGeometry.morphismRestrictStalkMap` carries the germ of the
restriction of a global section to the germ of that global section. -/
theorem Γgerm_comp_morphismRestrictStalkMap_left {X Y : Scheme.{u}} (g : X ⟶ Y) (U : Y.Opens)
    (x : (g ⁻¹ᵁ U).toScheme) :
    U.ι.appTop ≫ U.toScheme.presheaf.Γgerm ((g ∣_ U) x) ≫
        (AlgebraicGeometry.morphismRestrictStalkMap g U x).hom.left =
      Y.presheaf.Γgerm (g.base x.1) := by
  simp only [AlgebraicGeometry.morphismRestrictStalkMap, Arrow.isoMk_hom_left, Iso.trans_hom,
    TopCat.Presheaf.stalkCongr_hom, Scheme.Opens.ι_appTop, TopCat.Presheaf.Γgerm]
  rw [Scheme.Opens.germ_stalkIso_hom_assoc U (V := ⊤) ((g ∣_ U) x) trivial]
  exact (congrArg (fun t => Y.presheaf.map (homOfLE (le_top : U.ι ''ᵁ ⊤ ≤ ⊤)).op ≫ t)
      (Y.presheaf.germ_stalkSpecializes _ _)).trans
    (Y.presheaf.germ_res (homOfLE le_top) (g.base x.1) (by simpa using x.2))

/-- The stalk comparison of `AlgebraicGeometry.morphismRestrictStalkMap` carries the germ of the
restriction of a global section to the germ of that global section. -/
theorem left_Γgerm_ι_appTop {X Y : Scheme.{u}} (g : X ⟶ Y) (U : Y.Opens)
    (x : (g ⁻¹ᵁ U).toScheme) (s : Γ(Y, ⊤)) :
    ((AlgebraicGeometry.morphismRestrictStalkMap g U x).hom.left).hom
        ((U.toScheme.presheaf.Γgerm ((g ∣_ U) x)).hom (U.ι.appTop.hom s)) =
      (Y.presheaf.Γgerm (g.base x.1)).hom s :=
  ConcreteCategory.congr_hom (Γgerm_comp_morphismRestrictStalkMap_left g U x) s

private theorem left_germ_scalarGlobal (A : Type u) [CommRing A] [IsLocalRing A] (f : A)
    (p' : (puncturedClosedFibre A f).toScheme) :
    ((AlgebraicGeometry.morphismRestrictStalkMap (closedImmersion A f)
        (Stacks.Divisors.puncturedSpectrum A) p').hom.left).hom
      (((Stacks.Divisors.puncturedSpectrum A).toScheme.presheaf.Γgerm
        ((puncturedClosedFibreRestriction A f).base p')).hom (scalarGlobal A f)) =
      (StructureSheaf.toStalk A
        (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {f})) p'.1)).hom f :=
  left_Γgerm_ι_appTop (closedImmersion A f) (Stacks.Divisors.puncturedSpectrum A) p'
    ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f)

/-- The kernel of the stalk map at `p'` of the restriction of the closed immersion
`Spec (A ⧸ (f)) → Spec A` to the punctured spectrum is the principal ideal generated by the germ of
the global section `scalarGlobal A f`. -/
theorem ker_stalkMap_puncturedClosedImmersion (A : Type u) [CommRing A] [IsLocalRing A] (f : A)
    (p' : (puncturedClosedFibre A f).toScheme) :
    RingHom.ker ((puncturedClosedFibreRestriction A f).stalkMap p').hom =
      Ideal.span {((Stacks.Divisors.puncturedSpectrum A).toScheme.presheaf.Γgerm
        ((puncturedClosedFibreRestriction A f).base p')).hom (scalarGlobal A f)} := by
  have hebij : Function.Bijective
      ((AlgebraicGeometry.morphismRestrictStalkMap (closedImmersion A f)
        (Stacks.Divisors.puncturedSpectrum A) p').hom.left).hom :=
    ConcreteCategory.bijective_of_isIso _
  have key : Ideal.map ((AlgebraicGeometry.morphismRestrictStalkMap (closedImmersion A f)
        (Stacks.Divisors.puncturedSpectrum A) p').hom.left).hom
      (Ideal.span {((Stacks.Divisors.puncturedSpectrum A).toScheme.presheaf.Γgerm
        ((puncturedClosedFibreRestriction A f).base p')).hom (scalarGlobal A f)}) =
      Ideal.map (StructureSheaf.toStalk A
        (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {f})) p'.1)).hom
        (Ideal.span {f}) := by
    rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton,
      left_germ_scalarGlobal]
    rfl
  rw [ker_stalkMap_morphismRestrict, ker_stalkMap_closedImmersion, ← key,
    Ideal.comap_map_of_bijective _ hebij]

end Stacks.Algebraization

end
