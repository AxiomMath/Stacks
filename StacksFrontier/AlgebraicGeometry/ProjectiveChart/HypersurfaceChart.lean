module

public import StacksFrontier.AlgebraicGeometry.ProjectiveChart.CoefficientAlgebra
public import StacksFrontier.AlgebraicGeometry.ProjectiveChart.Dehomogenization

/-!
# A hypersurface of `ℙⁿ_R` is an affine hypersurface on each standard chart

Let `i : Z ⟶ ℙⁿ_R` be a closed immersion whose homogeneous ideal is generated by a homogeneous
`F` of degree `d`.  `Stacks.ProjectiveChart.ker_app_basicOpen_X_eq_span_dehomCoeff` computes the
kernel of `i` over the standard open `D₊(Tⱼ)`; this file turns that computation into a
presentation of the chart `Z ∩ D₊(Tⱼ)` of `Z` itself:

`Γ(Z, Z ∩ D₊(Tⱼ)) ≅ R[Y₁, …, Yₙ] ⧸ (F(Tⱼ = 1))`,

an isomorphism of `R`-algebras for the `R`-algebra structure that `Z` carries as a scheme over
`Spec R`.  Together with `Stacks.ProjectiveChart.totalDegree_dehomCoeff_le` the generator has
total degree at most `d`, so this is the affine equation of the hypersurface on the chart with
its degree bound.

## Main definitions

* `Stacks.ProjectiveChart.subschemeChart`: the open `Z ∩ D₊(Tⱼ)` of `Z`.
* `Stacks.ProjectiveChart.chartPresentation`: the surjection
  `R[Y₁, …, Yₙ] → Γ(Z, Z ∩ D₊(Tⱼ))`.
* `Stacks.ProjectiveChart.chartQuotientEquiv`: the resulting isomorphism
  `R[Y₁, …, Yₙ] ⧸ (F(Tⱼ = 1)) ≅ Γ(Z, Z ∩ D₊(Tⱼ))`.

## Main results

* `Stacks.ProjectiveChart.isAffineOpen_subschemeChart`: the chart is an affine open of `Z`.
* `Stacks.ProjectiveChart.ker_chartPresentation`: the presentation has kernel
  `(F(Tⱼ = 1))`.
* `Stacks.ProjectiveChart.chartPresentation_C`: **the presentation is `R`-linear** — it carries
  `C r` to the pullback of `r` along the structure morphism `Z ⟶ Spec R`.

## Implementation notes

The chart is affine because a closed immersion is an affine morphism and `D₊(Tⱼ)` is affine, and
the presentation is surjective because a closed immersion is surjective on sections over an
affine open (`AlgebraicGeometry.Scheme.Hom.app_surjective`).  Neither needs `Z` to be anything
in particular; the hypersurface equation enters only through the kernel.

Nothing here assumes `n = 2` or that `R` is a field: the statement is about an arbitrary closed
immersion into `Proj` of a polynomial ring over a Noetherian base, which is the generality the
kernel computation already has.

## References

* [Stacks Project, Tag 01NG](https://stacks.math.columbia.edu/tag/01NG)
* [Stacks Project, Tag 0CCU](https://stacks.math.columbia.edu/tag/0CCU)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

namespace Stacks.ProjectiveChart

universe u

variable {R : Type u} [CommRing R]

attribute [local instance] MvPolynomial.gradedAlgebra

variable {n : ℕ} {Z : Scheme.{u}}
  (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)) (j : Fin (n + 1))

/-- The chart `Z ∩ D₊(Tⱼ)` of a subscheme of projective space. -/
abbrev subschemeChart : Z.Opens :=
  i ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) (MvPolynomial.X j)

/-- The standard open `D₊(Tⱼ)` of `ℙⁿ_R` is affine. -/
theorem isAffineOpen_basicOpen_X :
    IsAffineOpen (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
      (MvPolynomial.X j)) :=
  Proj.isAffineOpen_basicOpen _ _ (X_mem_degree_one R j) Nat.one_pos

/-- **The chart of a closed subscheme of projective space is affine.** -/
theorem isAffineOpen_subschemeChart [IsClosedImmersion i] :
    IsAffineOpen (subschemeChart i j) :=
  (isAffineOpen_basicOpen_X j).preimage i

/-- **The affine coordinate ring of the chart, presented as a quotient of a polynomial ring.**
The chart identification of `ℙⁿ_R` followed by restriction of functions along `i`. -/
def chartPresentation : MvPolynomial (Fin n) R →+* Γ(Z, subschemeChart i j) :=
  (i.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
    (MvPolynomial.X j))).hom.comp (sectionsChartEquiv R j).toRingHom

/-- For a closed immersion `i`, the presentation `R[Y₁, …, Yₙ] → Γ(Z, Z ∩ D₊(Tⱼ))` is
surjective. -/
theorem chartPresentation_surjective [IsClosedImmersion i] :
    Function.Surjective (chartPresentation i j) :=
  (i.app_surjective _ (isAffineOpen_basicOpen_X j)).comp (sectionsChartEquiv R j).surjective

/-- **The presentation of the chart is `R`-linear.**  A constant polynomial `C r` becomes the
pullback of `r` along the structure morphism `Z ⟶ Spec R` of the subscheme. -/
theorem chartPresentation_C (r : R) :
    chartPresentation i j (MvPolynomial.C r) =
      ((i ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff R n).appLE ⊤
        (subschemeChart i j) le_top).hom
          ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r) := by
  have key : (Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff R n).appLE ⊤
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
          (MvPolynomial.X j)) le_top ≫
      i.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
        (MvPolynomial.X j)) =
      (i ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff R n).appLE ⊤
        (subschemeChart i j) le_top := by
    rw [← i.appLE_eq_app]
    exact Scheme.Hom.appLE_comp_appLE i _ _ _ _ _ _
  show (i.app _).hom (sectionsChartEquiv R j (MvPolynomial.C r)) = _
  rw [sectionsChartEquiv_C, ← key]
  rfl

variable [IsClosedImmersion i] [IsNoetherianRing R] {d : ℕ} (F : MvPolynomial (Fin (n + 1)) R)
  (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R (d • 1))
  (hideal : AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme
    (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) i = Ideal.span {F})

include hF hideal in
/-- **The affine equation of the chart.**  The presentation of `Γ(Z, Z ∩ D₊(Tⱼ))` has kernel the
principal ideal of the dehomogenization `F(Tⱼ = 1)`. -/
theorem ker_chartPresentation :
    RingHom.ker (chartPresentation i j) = Ideal.span {dehomCoeff R j F} := by
  ext y
  simp only [RingHom.mem_ker, chartPresentation, RingHom.coe_comp, Function.comp_apply,
    RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
  rw [show ((i.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
      (MvPolynomial.X j))).hom (sectionsChartEquiv R j y) = 0) ↔
      sectionsChartEquiv R j y ∈ RingHom.ker (i.app (Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) (MvPolynomial.X j))).hom from
    Iff.rfl, ker_app_basicOpen_X_eq_span_dehomCoeff R j i F hF hideal,
    Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨(sectionsChartEquiv R j).symm c,
      (sectionsChartEquiv R j).injective (by rw [map_mul, RingEquiv.apply_symm_apply, hc])⟩
  · rintro ⟨c, rfl⟩
    exact ⟨sectionsChartEquiv R j c, by rw [map_mul]⟩

include hF hideal in
/-- **The chart of a hypersurface is an affine hypersurface.**
`Γ(Z, Z ∩ D₊(Tⱼ)) ≅ R[Y₁, …, Yₙ] ⧸ (F(Tⱼ = 1))`. -/
def chartQuotientEquiv :
    (MvPolynomial (Fin n) R ⧸ Ideal.span {dehomCoeff R j F}) ≃+* Γ(Z, subschemeChart i j) :=
  (Ideal.quotEquivOfEq (ker_chartPresentation i j F hF hideal).symm).trans
    (RingHom.quotientKerEquivOfSurjective (chartPresentation_surjective i j))

end Stacks.ProjectiveChart

end
