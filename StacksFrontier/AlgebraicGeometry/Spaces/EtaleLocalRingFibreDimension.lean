/-!
# The closed fibre of a map of étale local rings has the dimension of the fibre's local ring

Let `f : X ⟶ Y` be a morphism of algebraic spaces over `S` and let `x̄` be a geometric point of
`X`. This file compares the ring `AlgebraicGeometry.Space.closedFibreEtaleLocalRing`, the quotient
of `𝒪_{X, x̄}` by the ideal generated by the image of the maximal ideal of `𝒪_{Y, f(x̄)}`, with the
local ring of a fibre of a scheme, at the level of Krull dimension:

`dim(𝒪_{X, x̄} / 𝔪_{𝒪_{Y, f(x̄)}}·𝒪_{X, x̄}) = dim(𝒪_{Z_w, z})`,

where `q : Z ⟶ W` is a pointed étale chart square for `f` at `x̄` and `Z_w` is the scheme-theoretic
fibre of `q` over the image point.

The comparison is a chain of three identifications:

* the étale local ring is a strict henselization of the Zariski local ring of a chart, and the
  ideal generated by the maximal ideal of the target's étale local ring is the extension of the
  ideal generated by the maximal ideal of the target's Zariski local ring
  (`AlgebraicGeometry.Space.nonempty_quotient_maximalIdeal_map_ringEquiv`);
* Krull dimension of a quotient is unchanged by a strict henselization — **Stacks 05WS** that the
  quotient of a strict henselization is a strict henselization of the quotient, and
  **Stacks 06LK** that a strict henselization has the same dimension;
* the quotient of the Zariski local ring by the extended maximal ideal is the local ring of the
  scheme-theoretic fibre (`AlgebraicGeometry.quotientStalkEquivFiberStalk`).

The fibre on the right is the fibre over the scheme point, not the geometric fibre.

## Main results

* `ringKrullDim_quotient_map_eq_of_isHenselization`: the Krull dimension of `A/I` is that of
  `Ash/I·Ash` for a strict henselization `Ash` of a local ring `A` and `I` inside the maximal
  ideal.
* `AlgebraicGeometry.ringKrullDim_quotient_maximalIdeal_map_eq_fiberStalk`: the scheme-level
  comparison, for a morphism with affine target read through chosen strict henselizations.
* `AlgebraicGeometry.Space.ringKrullDim_closedFibreEtaleLocalRing_eq_fiberStalk`: the comparison
  for a pointed square of étale charts with affine target chart.
* `Space.exists_chartSquare_ringKrullDim_closedFibreEtaleLocalRing_eq_fiberStalk`: a square as
  above exists.

## References

* [Stacks Project, Tag 05WS](https://stacks.math.columbia.edu/tag/05WS)
* [Stacks Project, Tag 06LK](https://stacks.math.columbia.edu/tag/06LK)
* [Stacks Project, Tag 07QL](https://stacks.math.columbia.edu/tag/07QL)
* [Stacks Project, Tag 0DS9](https://stacks.math.columbia.edu/tag/0DS9)
* [Stacks Project, Tag 0E0W](https://stacks.math.columbia.edu/tag/0E0W)
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u v

/-- **The Krull dimension of a quotient is unchanged by a strict henselization.** If `Ash` is a
strict henselization of a local ring `(A, 𝔪)` relative to a separably closed extension `L` of
its residue field, and `I ⊆ 𝔪`, then `Ash/I·Ash` and `A/I` have the same Krull dimension. -/
@[sga "5 I 3.1.3" "more general"]
theorem ringKrullDim_quotient_map_eq_of_isHenselization
    {A : Type u} [CommRing A] [IsLocalRing A]
    {Ash : Type u} [CommRing Ash] [IsLocalRing Ash] [Algebra A Ash]
    (L : Type v) [Field L] [Algebra (ResidueField A) L] [IsSepClosure (ResidueField A) L]
    [IsHenselization A L Ash] (I : Ideal A) (hI : I ≤ maximalIdeal A) :
    ringKrullDim (Ash ⧸ I.map (algebraMap A Ash)) = ringKrullDim (A ⧸ I) := by
  have : IsLocalHom (algebraMap A Ash) := IsHenselization.isLocalHom (L := L)
  have : HenselianLocalRing Ash := IsHenselization.henselian (R := A) (L := L)
  obtain ⟨a, _, hsep, hres⟩ :=
    IsHenselization.exists_residueFieldAlgebra (R := A) (L := L) (Rh := Ash)
  have halg : a = ResidueField.instAlgebra (R := A) (S := Ash) :=
    Algebra.algebra_ext _ _ fun z ↦ by
      obtain ⟨r, rfl⟩ := residue_surjective z
      exact (hres r).trans (ResidueField.algebraMap_residue (S := Ash) r).symm
  subst halg
  have : IsSepClosure (ResidueField A) (ResidueField Ash) := hsep inferInstance
  obtain ⟨_, _, _, hhens, hind, _, _⟩ :=
    IsLocalRing.strictHenselization_quotient (R := A) (Rsh := Ash)
      (IsHenselization.ind_etale_of_universe_le.{u, v, u} L)
      (IsHenselization.map_maximalIdeal (R := A) (L := L) (Rh := Ash)) I hI
  have : IsHenselization (A ⧸ I) (ResidueField (Ash ⧸ I.map (algebraMap A Ash)))
      (Ash ⧸ I.map (algebraMap A Ash)) :=
    IsHenselization.of_ind_etale hhens hind
      ⟨RingEquiv.refl _, fun z ↦ ResidueField.algebraMap_residue z⟩
  obtain ⟨Ah, _, _, _, _⟩ := IsLocalRing.exists_isHenselization_residueField (A ⧸ I)
  obtain ⟨hd₁, hd₂⟩ := ringKrullDim_eq_henselization_eq_strictHenselization (A ⧸ I) Ah
    (Ash ⧸ I.map (algebraMap A Ash)) (ResidueField (Ash ⧸ I.map (algebraMap A Ash)))
  exact (hd₁.trans hd₂).symm

namespace AlgebraicGeometry

/-- **The closed fibre of a map of étale local rings has the dimension of the local ring of the
scheme-theoretic fibre.** For a morphism `q : Z ⟶ W` of schemes with affine target, read through
chosen strict henselizations `C` of `𝒪_{W, q(z)}` and `D` of `𝒪_{Z, z}` and a homomorphism `φ`
between them compatible with the germs of global sections,

`dim(D / 𝔪_C·D) = dim(𝒪_{Z_{q(z)}, z})`. -/
theorem ringKrullDim_quotient_maximalIdeal_map_eq_fiberStalk {Z W : Scheme.{u}} [IsAffine W]
    (q : Z ⟶ W) (z : Z) (w : W) (hzw : q z = w) {K L : Type u} [Field K]
    [Algebra (ResidueField (W.presheaf.stalk w)) K]
    [IsSepClosure (ResidueField (W.presheaf.stalk w)) K] [Field L]
    [Algebra (ResidueField (Z.presheaf.stalk z)) L]
    [IsSepClosure (ResidueField (Z.presheaf.stalk z)) L]
    (T : HenselizationTower (W.presheaf.stalk w) K)
    (U : HenselizationTower (Z.presheaf.stalk z) L) {C D : Type*} [CommRing C] [IsLocalRing C]
    [CommRing D] (eW : T.strictHenselization ≃+* C) (eZ : U.strictHenselization ≃+* D)
    (φ : C →+* D)
    (hc : ∀ a : Γ(W, ⊤),
      φ (eW (algebraMap _ T.strictHenselization (W.presheaf.germ ⊤ w trivial a))) =
        eZ (algebraMap _ U.strictHenselization
          (Z.presheaf.germ ⊤ z trivial ((Scheme.Γ.map q.op).hom a)))) :
    ringKrullDim (D ⧸ (maximalIdeal C).map φ) =
      ringKrullDim ((q.fiber (q z)).presheaf.stalk (q.asFiber z)) := by
  subst hzw
  obtain ⟨e⟩ := Space.nonempty_quotient_maximalIdeal_map_ringEquiv K L T U eW eZ
    (q.stalkMap z).hom φ
    (RingHom.ext (Space.apply_algebraMap_strictHenselization_eq q z T U eW eZ φ hc))
  have hlocal : IsLocalHom (q.stalkMap z).hom := q.toLRSHom.prop z
  calc ringKrullDim (D ⧸ (maximalIdeal C).map φ)
      = ringKrullDim (U.strictHenselization ⧸
          ((maximalIdeal (W.presheaf.stalk (q z))).map (q.stalkMap z).hom).map
            (algebraMap _ U.strictHenselization)) := (ringKrullDim_eq_of_ringEquiv e).symm
    _ = ringKrullDim (Z.presheaf.stalk z ⧸
          (maximalIdeal (W.presheaf.stalk (q z))).map (q.stalkMap z).hom) :=
        ringKrullDim_quotient_map_eq_of_isHenselization L _ (map_maximalIdeal_le _)
    _ = ringKrullDim ((q.fiber (q z)).presheaf.stalk (q.asFiber z)) :=
        ringKrullDim_eq_of_ringEquiv (quotientStalkEquivFiberStalk q z)

namespace Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- **The closed fibre of the map of étale local rings has the dimension of the local ring of
the scheme-theoretic fibre of a chart.** Given a pointed square of étale charts for
`f : X ⟶ Y` at a geometric point `x̄`, with underlying morphism of schemes `q` and underlying
point `u`, and with the target chart affine,

`dim(𝒪_{X, x̄} / 𝔪_{𝒪_{Y, f(x̄)}}·𝒪_{X, x̄}) = dim(𝒪_{Z_{q(u)}, u})`. -/
theorem ringKrullDim_closedFibreEtaleLocalRing_eq_fiberStalk
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (x : GeometricPoint B S hS X) (U : SmallEtaleNeighborhood x)
    (V : SmallEtaleNeighborhood (geometricPointMap f x))
    (g : U.chart.obj.left ⟶ V.chart.obj.left)
    (hcomm : U.chart.obj.hom ≫ f = yoneda.map g ≫ V.chart.obj.hom)
    (hpoint : U.point ≫ g = V.point) (hVaffine : IsAffine (chartScheme V.chart))
    (q : chartScheme U.chart ⟶ chartScheme V.chart)
    (hq : q = (BigFppfOver.toScheme B S hS).map g) (u : chartScheme U.chart)
    (hu : u = (chartGeometricPoint U).hom
      (IsLocalRing.closedPoint (chartGeometricPoint U).residueField)) :
    ringKrullDim (closedFibreEtaleLocalRing B S hS hX f x) =
      ringKrullDim ((q.fiber (q u)).presheaf.stalk (q.asFiber u)) := by
  subst hq
  subst hu
  have _ : IsAffine (chartScheme V.chart) := hVaffine
  have _ : IsAffine (neighborhoodChartScheme V) := hVaffine
  set E := bigEtaleSiteOfFppfSite B
  set v := (chartGeometricPoint V).hom
    (IsLocalRing.closedPoint (chartGeometricPoint V).residueField)
  have huv : ((BigFppfOver.toScheme B S hS).map g)
      ((chartGeometricPoint U).hom
        (IsLocalRing.closedPoint (chartGeometricPoint U).residueField)) = v :=
    congrArg (fun k => ((BigFppfOver.toScheme B S hS).map k)
      (show (BigFppfOver.toScheme B S hS).obj x.val.siteObject from
        IsLocalRing.closedPoint x.val.carrier)) hpoint
  set RU := (neighborhoodChartScheme U).presheaf.stalk ((chartGeometricPoint U).hom
    (IsLocalRing.closedPoint (chartGeometricPoint U).residueField))
  set RV := (neighborhoodChartScheme V).presheaf.stalk v
  set TU := henselizationTower RU
    (separableClosure (ResidueField RU) (chartGeometricPoint U).residueField)
  set TV := henselizationTower RV
    (separableClosure (ResidueField RV) (chartGeometricPoint V).residueField)
  have _ : IsLocalRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    isLocalRing_etaleLocalRing B S hS Y hY (geometricPointMap f x)
  have hjac : (⊥ : Ideal (etaleLocalRing B S hS Y (geometricPointMap f x))).jacobson =
      IsLocalRing.maximalIdeal (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top
  change ringKrullDim (etaleLocalRing B S hS X x ⧸
      Ideal.map (etaleLocalRingMap hX f x)
        (⊥ : Ideal (etaleLocalRing B S hS Y (geometricPointMap f x))).jacobson) = _
  rw [hjac]
  refine ringKrullDim_quotient_maximalIdeal_map_eq_fiberStalk _ _ v huv TV TU
    (strictHenselizationEquivEtaleLocalRing hY V E V.chart.obj.left.left.property TV)
    (strictHenselizationEquivEtaleLocalRing hX U E U.chart.obj.left.left.property TU)
    (etaleLocalRingMap hX f x) fun a ↦ ?_
  calc
    _ = (etaleLocalRingMap hX f x)
        (etaleLocalRingGerm B S hS Y (geometricPointMap f x) (Opposite.op V) a) :=
      congrArg _ (strictHenselizationEquivEtaleLocalRing_germ hY V E
        V.chart.obj.left.left.property TV a)
    _ = etaleLocalRingGerm B S hS X x (Opposite.op U)
        ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map g).op).hom a) :=
      (congrArg (fun k => k a)
        (etaleLocalRingMap_isEtaleLocalRingMap hX f x U V g hcomm hpoint)).symm
    _ = _ := (strictHenselizationEquivEtaleLocalRing_germ hX U E
      U.chart.obj.left.left.property TU
      ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map g).op).hom a)).symm

/-- The scheme morphism underlying a square of étale charts of a smooth morphism of algebraic
spaces is smooth. -/
theorem smooth_toSchemeMap_of_isSmooth {f : X ⟶ Y} (hf : IsSmooth B S hS f)
    (x : GeometricPoint B S hS X) (U : SmallEtaleNeighborhood x)
    (V : SmallEtaleNeighborhood (geometricPointMap f x))
    (g : U.chart.obj.left ⟶ V.chart.obj.left)
    (hcomm : U.chart.obj.hom ≫ f = yoneda.map g ≫ V.chart.obj.hom) :
    Smooth ((BigFppfOver.toScheme B S hS).map g) :=
  hf _ _ U.chart.obj.hom V.chart.obj.hom g U.chart.property V.chart.property hcomm.symm

/-- **A pointed affine chart square computing the closed fibre's dimension exists.** For
`f : X ⟶ Y` and a geometric point `x̄` of `X`, there is a pointed square of étale charts for `f` at
`x̄` with affine target chart such that `dim(𝒪_{X, x̄} / 𝔪_{𝒪_{Y, f(x̄)}}·𝒪_{X, x̄})` is the
dimension of the local ring of the scheme-theoretic fibre of the square's morphism at the
underlying point. -/
theorem exists_chartSquare_ringKrullDim_closedFibreEtaleLocalRing_eq_fiberStalk
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (x : GeometricPoint B S hS X) :
    ∃ (U : SmallEtaleNeighborhood x) (V : SmallEtaleNeighborhood (geometricPointMap f x))
      (g : U.chart.obj.left ⟶ V.chart.obj.left),
      U.chart.obj.hom ≫ f = yoneda.map g ≫ V.chart.obj.hom ∧ U.point ≫ g = V.point ∧
      IsAffine (chartScheme V.chart) ∧
      ringKrullDim (closedFibreEtaleLocalRing B S hS hX f x) =
        ringKrullDim ((((BigFppfOver.toScheme B S hS).map g).fiber
            (((BigFppfOver.toScheme B S hS).map g)
              ((chartGeometricPoint U).hom (IsLocalRing.closedPoint
                (chartGeometricPoint U).residueField)))).presheaf.stalk
          (((BigFppfOver.toScheme B S hS).map g).asFiber
            ((chartGeometricPoint U).hom (IsLocalRing.closedPoint
              (chartGeometricPoint U).residueField)))) := by
  obtain ⟨U, V, g, hcomm, hpoint, hVaffine⟩ :=
    exists_compatible_affine_chart_square B S hS hX hY f x
  exact ⟨U, V, g, hcomm, hpoint, hVaffine,
    ringKrullDim_closedFibreEtaleLocalRing_eq_fiberStalk B S hS hX hY f x U V g hcomm hpoint
      hVaffine _ rfl _ rfl⟩

/-! ### Geometric points of a fibre product -/

set_option synthInstance.maxHeartbeats 400000 in
-- instance search for `HasPullbacks` of presheaves on the big fppf site needs a deep search
/-- Pullbacks of presheaves on the big fppf site (instance search times out without this
shortcut). -/
local instance hasPullbacks_presheaf_EtaleLocalRingFibreDimension :
    Limits.HasPullbacks ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) := inferInstance

/-- Pullbacks of presheaves on the big fppf site, as a high-priority shortcut. -/
local instance (priority := high) hasPullback_presheaf_EtaleLocalRingFibreDimension
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    Limits.HasLimit (Limits.cospan f g) :=
  Limits.HasLimitsOfShape.has_limit _

/-- **The two feet of a geometric point of a fibre product agree.** For a geometric point `a` of
`W ×_U U'`, the image in `U` of its first projection and the image in `U` of its second
projection are the same geometric point. -/
theorem geometricPointMap_pullback_feet_eq {W U U' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (k : W ⟶ U) (h : U' ⟶ U)
    (a : GeometricPoint B S hS (Limits.pullback k h)) :
    geometricPointMap k (geometricPointMap (Limits.pullback.fst k h) a) =
      geometricPointMap h (geometricPointMap (Limits.pullback.snd k h) a) :=
  congrArg (fun m => geometricPointMap m a) Limits.pullback.condition

/-- **Taking the image of a geometric point does not change its site object.** The image is
formed by applying the morphism to the defining section, leaving the carrier, the field, their
containment and the structure morphism to the base untouched. -/
theorem siteObject_geometricPointMap {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : F ⟶ G)
    (z : GeometricPoint B S hS F) :
    (geometricPointMap f z).val.siteObject = z.val.siteObject :=
  rfl

/-- **The chosen lift of the image of a geometric point sits over the applied section.** For a
small étale neighbourhood `Q` of `geometricPointMap f z`, the chart of `Q` sends `Q.point` to `f`
applied to the value of `z`, at the site object of `z`. -/
theorem point_comp_geometricPointMap {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : F ⟶ G)
    (z : GeometricPoint B S hS F) (Q : SmallEtaleNeighborhood (geometricPointMap f z)) :
    Q.chart.obj.hom.app (Opposite.op z.val.siteObject) Q.point =
      f.app (Opposite.op z.val.siteObject) z.val.value :=
  Q.point_comp

/-- **A chart of `W` at a geometric point lying over a PRESCRIBED chart of `U`, with the chosen
lift carried along.** For `k : W ⟶ U`, a small étale neighbourhood `V` of a geometric point `w`
of `W`, and a small étale neighbourhood `Q` of its image in `U`, the representable fibre product
`V ×_U Q` is again a small étale neighbourhood of `w`; it refines `V`, and it carries a morphism
to `Q` over `k` compatible with all three chosen lifts. -/
theorem exists_pointed_chart_over {W U : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (k : W ⟶ U)
    (w : GeometricPoint B S hS W) (V : SmallEtaleNeighborhood w)
    (Q : SmallEtaleNeighborhood (geometricPointMap k w)) :
    ∃ (N : SmallEtaleNeighborhood w) (π : N.chart ⟶ V.chart)
      (q : N.chart.obj.left ⟶ Q.chart.obj.left),
      yoneda.map q ≫ Q.chart.obj.hom = N.chart.obj.hom ≫ k ∧
        N.point ≫ (SmallEtale.toOver B S hS W).map π = V.point ∧
          N.point ≫ q = Q.point := by
  set g : yoneda.obj V.chart.obj.left ⟶ U := V.chart.obj.hom ≫ k
  have hcompat : yoneda.map Q.point ≫ Q.chart.obj.hom = yoneda.map V.point ≫ g := by
    apply yonedaEquiv.injective
    change Q.chart.obj.hom.app (Opposite.op w.val.siteObject) Q.point =
      k.app (Opposite.op w.val.siteObject)
        (V.chart.obj.hom.app (Opposite.op w.val.siteObject) V.point)
    rw [V.point_comp]
    exact point_comp_geometricPointMap B S hS k w Q
  let Nchart : SmallEtale B S hS W :=
    ⟨CostructuredArrow.mk (yoneda.map (Q.chart.property.rep.snd g) ≫ V.chart.obj.hom),
      AlgebraicGeometry.Space.etale_comp_of_scheme B S hS _ V.chart.obj.hom
        (Q.chart.property.property_snd g) V.chart.property⟩
  let Npoint : w.val.siteObject ⟶ Q.chart.property.rep.pullback g :=
    Q.chart.property.rep.lift (yoneda.map Q.point) V.point hcompat
  have hsnd : Npoint ≫ Q.chart.property.rep.snd g = V.point :=
    Q.chart.property.rep.lift_snd _ _ hcompat
  have hNpc : Nchart.obj.hom.app (Opposite.op w.val.siteObject) Npoint = w.val.value := by
    change V.chart.obj.hom.app _ (Npoint ≫ Q.chart.property.rep.snd g) = w.val.value
    rw [hsnd]
    exact V.point_comp
  refine ⟨⟨Nchart, Npoint, hNpc⟩,
    ObjectProperty.homMk (CostructuredArrow.homMk (Q.chart.property.rep.snd g) rfl),
    Q.chart.property.rep.fst' g, ?_, hsnd, ?_⟩
  · rw [Q.chart.property.rep.map_fst' g, Q.chart.property.rep.w g, ← Category.assoc]
    rfl
  · refine yoneda.map_injective ?_
    change yoneda.map Npoint ≫ yoneda.map (Q.chart.property.rep.fst' g) = yoneda.map Q.point
    rw [Q.chart.property.rep.map_fst' g]
    exact Q.chart.property.rep.lift_fst (yoneda.map Q.point) V.point hcompat

/-- **An affine chart of `W` at a geometric point lying over a prescribed chart of `U`.** For an
algebraic space `W`, `k : W ⟶ U`, a small étale neighbourhood `V` of a geometric point `w` of `W`
and a small étale neighbourhood `Q` of its image in `U`, there is a small étale neighbourhood of
`w` with affine chart that refines `V` and carries a morphism to `Q` over `k`, compatible with the
chosen lifts. -/
theorem exists_pointed_affine_chart_over {W U : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hW : IsAlgebraicSpace B S hS W) (k : W ⟶ U) (w : GeometricPoint B S hS W)
    (V : SmallEtaleNeighborhood w) (Q : SmallEtaleNeighborhood (geometricPointMap k w)) :
    ∃ (N : SmallEtaleNeighborhood w) (π : N.chart ⟶ V.chart)
      (q : N.chart.obj.left ⟶ Q.chart.obj.left),
      IsAffine (chartScheme N.chart) ∧
        yoneda.map q ≫ Q.chart.obj.hom = N.chart.obj.hom ≫ k ∧
          N.point ≫ (SmallEtale.toOver B S hS W).map π = V.point ∧
            N.point ≫ q = Q.point := by
  obtain ⟨N, π, q, hcomm, hπ, hq⟩ := exists_pointed_chart_over B S hS k w V Q
  obtain ⟨M, m, hMaff⟩ := exists_smallEtaleNeighborhoodHom_isAffine B S hS ⟨W, hW⟩ w N
  refine ⟨M, m.hom ≫ π, (SmallEtale.toOver B S hS W).map m.hom ≫ q, hMaff, ?_, ?_, ?_⟩
  · rw [Functor.map_comp, Category.assoc, hcomm, ← Category.assoc,
      yoneda_map_toOver_map_comp_hom m.hom]
  · rw [Functor.map_comp, ← Category.assoc, m.point_comp, hπ]
  · rw [← Category.assoc, m.point_comp, hq]

end Space

end AlgebraicGeometry

