module

public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.ThickeningStageSystem
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.AffineOfLiftedEtalePresentation
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.AffineChartOfAffineThickening
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.BaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierDivisorSum
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.Comap

/-!
# An affine stage of a thickening of an affine algebraic space

Let `G ⊂ X` be a thickening of algebraic spaces over `S` with `G` affine, and let
`D : AlgebraicGeometry.Space.ThickeningStageSystem` be a directed system of closed subspaces
`G ⊆ H_i ⊆ X` whose chartwise ideals on one affine surjective étale chart `V` exhaust the
chartwise ideal of `G`. This file proves that some stage `H_i` is affine.

This is the half of the proof that a thickening of an affine algebraic space is affine which
replaces Stacks 07SQ; the other half, producing such a system with finite-order stages, is
`AlgebraicGeometry.Space.nonempty_thickeningStageSystem`.

## Main results

* `AlgebraicGeometry.Space.chartIdeal_eq_map`: the chart ideal of a closed subspace on a chart
  lying over an affine chart is generated by the chart ideal there.
* `AlgebraicGeometry.Space.sub_mem_map_chartIdeal_of_restrict_eq`: a function on `V` whose
  restriction to `G ×_X V` comes from `G` is invariant modulo the ideal of `G` on the kernel pair.
* `AlgebraicGeometry.Space.appTop_eq_of_sub_mem_map_chartIdeal`: a function invariant modulo the
  ideal of a closed subspace `Z` restricts to an invariant function on the chart of `Z`.
* `AlgebraicGeometry.Space.exists_stage_forall_mem_map_chartIdeal`: finitely many elements of the
  ideal of `G` on the kernel pair lie in the ideal of one stage.
* `AlgebraicGeometry.Space.exists_liftedEtalePresentation_mod_chartIdeal`: the chart of `G` has a
  lifted étale presentation over a finitely generated ring, invariant modulo the ideal of `G`.
* `AlgebraicGeometry.Space.isAffineSpace_of_forall_sub_mem_map_chartIdeal`: a closed subspace
  `H ⊇ G` modulo whose ideal the presentation is invariant is affine.
* `AlgebraicGeometry.Space.exists_isAffineSpace_stage`: some stage is affine.

## Implementation notes

Nothing about the order of the stages is used. The finiteness that makes one stage suffice is
that the ring `P` of the étale model is finitely generated: its generators become invariant at a
single stage because the stage ideals exhaust that of `G` on the kernel pair `V ×_X V`, which is
affine by `AlgebraicGeometry.Space.isAffine_of_isPullback_of_isThickening`.

## References

* [Stacks Project, Tag 07SQ](https://stacks.math.columbia.edu/tag/07SQ)
* [Stacks Project, Tag 05ZH](https://stacks.math.columbia.edu/tag/05ZH)
* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The ideal of global functions on a chart `V` of `X` vanishing on a closed subspace
`Z`: the kernel of restriction to `Z ×_X V`. -/
noncomputable abbrev closedSubspaceChartIdeal {X : AlgebraicSpaces B S hS}
    (Z : ClosedSubspaces B S hS X.1)
    {V : BigFppfOver B S hS} (φ : yoneda.obj V ⟶ X.1) :
    Ideal Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) :=
  RingHom.ker ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd φ)).appTop.hom

variable {B S hS}

/-- On an affine chart the chart ideal sheaf is the one attached to the chart ideal. -/
theorem chartKer_eq_ofIdealTop {X : AlgebraicSpaces B S hS} (Z : ClosedSubspaces B S hS X.1)
    {V : BigFppfOver B S hS} (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (φ : yoneda.obj V ⟶ X.1) :
    chartKer B S hS X Z φ =
      Scheme.IdealSheafData.ofIdealTop (closedSubspaceChartIdeal B S hS Z φ) :=
  Scheme.ker_of_isAffine _

/-- The chart ideal of a closed subspace on a chart `R` lying over the affine chart `V` through
`r : R ⟶ V` is generated by the chart ideal on `V`. -/
theorem chartIdeal_eq_map {X : AlgebraicSpaces B S hS} (Z : ClosedSubspaces B S hS X.1)
    {V R : BigFppfOver B S hS} (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (hR : IsAffine ((BigFppfOver.toScheme B S hS).obj R)) (φ : yoneda.obj V ⟶ X.1)
    (r : R ⟶ V) :
    closedSubspaceChartIdeal B S hS Z (yoneda.map r ≫ φ) =
      (closedSubspaceChartIdeal B S hS Z φ).map
        ((BigFppfOver.toScheme B S hS).map r).appTop.hom := by
  have h := comap_chartKer B S hS X Z φ r (yoneda.map r ≫ φ) rfl
  rw [chartKer_eq_ofIdealTop Z hV, chartKer_eq_ofIdealTop Z hR,
    Stacks.AlgebraicGeometry.comap_ofIdealTop] at h
  exact Scheme.IdealSheafData.equivOfIsAffine.symm.injective h.symm

/-- A cone over a pullback square with a representable corner is induced by a morphism of the
site. -/
private theorem exists_comp_eq_of_isPullback {F Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V W : BigFppfOver B S hS} {fst : yoneda.obj U ⟶ F} {snd : U ⟶ V} {g : F ⟶ Y}
    {φ : yoneda.obj V ⟶ Y} (h : IsPullback fst (yoneda.map snd) g φ) (a : yoneda.obj W ⟶ F)
    (b : W ⟶ V) (w : a ≫ g = yoneda.map b ≫ φ) :
    ∃ u : W ⟶ U, yoneda.map u ≫ fst = a ∧ u ≫ snd = b :=
  ⟨yoneda.preimage (h.lift a (yoneda.map b) w), by simp,
    yoneda.map_injective (by simp)⟩

/-- A smaller closed subspace has a larger chart ideal. -/
theorem chartIdeal_antitone {X : AlgebraicSpaces B S hS} {Z Z' : ClosedSubspaces B S hS X.1}
    (h : Z'.1 ≤ Z.1) {V : BigFppfOver B S hS} (φ : yoneda.obj V ⟶ X.1) :
    closedSubspaceChartIdeal B S hS Z φ ≤ closedSubspaceChartIdeal B S hS Z' φ := by
  intro x hx
  have hw : (Z'.2.2.rep.fst φ ≫ Subfunctor.homOfLe h) ≫ Z.1.ι =
      yoneda.map (Z'.2.2.rep.snd φ) ≫ φ := by
    rw [Category.assoc, Subfunctor.homOfLe_ι]
    exact (Z'.2.2.rep.isPullback φ).w
  obtain ⟨k, -, hk⟩ := exists_comp_eq_of_isPullback (Z.2.2.rep.isPullback φ) _ _ hw
  rw [RingHom.mem_ker, ← hk, Functor.map_comp, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
    RingHom.comp_apply, RingHom.mem_ker.mp hx, map_zero]

/-- Global sections of a composite of morphisms of the site, applied to an element. -/
theorem appTop_comp_apply {X Y Z : BigFppfOver B S hS} (f : X ⟶ Y) (g : Y ⟶ Z)
    (x : Γ((BigFppfOver.toScheme B S hS).obj Z, ⊤)) :
    ((BigFppfOver.toScheme B S hS).map (f ≫ g)).appTop.hom x =
      ((BigFppfOver.toScheme B S hS).map f).appTop.hom
        (((BigFppfOver.toScheme B S hS).map g).appTop.hom x) := by
  rw [Functor.map_comp, Scheme.Hom.comp_appTop]
  rfl

/-- The chart of a closed subspace `G ≅ yoneda TG`, as a pullback square over `G` along `πU`. -/
private theorem isPullback_snd_comp_inv {X : AlgebraicSpaces B S hS}
    (G : ClosedSubspaces B S hS X.1) {TG : BigFppfOver B S hS} (eG : G.1.toFunctor ≅ yoneda.obj TG)
    {V : BigFppfOver B S hS} (φ : yoneda.obj V ⟶ X.1) (πU : G.2.2.rep.pullback φ ⟶ TG)
    (hπU : yoneda.map πU = G.2.2.rep.fst φ ≫ eG.hom) :
    IsPullback (yoneda.map (G.2.2.rep.snd φ)) (yoneda.map πU ≫ eG.inv) φ G.1.ι := by
  rw [hπU, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  exact (G.2.2.rep.isPullback φ).flip

/-- **A function on the chart whose restriction to `G` comes from `G` is invariant modulo the
ideal of `G`.** Let `R ⇉ V` be the kernel pair of an affine chart `φ`, with `R` affine, and let
`b` be a function on `V` whose restriction to the chart `U₀ = G ×_X V` of `G` is the pullback
of a function `a` on `T_G ≅ G`. Then `t♯ b - s♯ b` lies in the ideal of `G ×_X R` in `Γ(R)`,
which is generated by the chart ideal of `G` on `V`. -/
theorem sub_mem_map_chartIdeal_of_restrict_eq {X : AlgebraicSpaces B S hS}
    (G : ClosedSubspaces B S hS X.1) {TG : BigFppfOver B S hS} (eTG : G.1.toFunctor ≅ yoneda.obj TG)
    {V R : BigFppfOver B S hS} (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (hR : IsAffine ((BigFppfOver.toScheme B S hS).obj R)) (φ : yoneda.obj V ⟶ X.1)
    (t s : R ⟶ V) (hpb : IsPullback (yoneda.map t) (yoneda.map s) φ φ)
    (πU : G.2.2.rep.pullback φ ⟶ TG) (hπU : yoneda.map πU = G.2.2.rep.fst φ ≫ eTG.hom)
    (b : Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) (a : Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤))
    (hb : ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)).appTop.hom b =
      ((BigFppfOver.toScheme B S hS).map πU).appTop.hom a) :
    ((BigFppfOver.toScheme B S hS).map t).appTop.hom b -
        ((BigFppfOver.toScheme B S hS).map s).appTop.hom b ∈
      (closedSubspaceChartIdeal B S hS G φ).map
        ((BigFppfOver.toScheme B S hS).map t).appTop.hom := by
  rw [← chartIdeal_eq_map G hV hR φ t, RingHom.mem_ker, map_sub, sub_eq_zero]
  set ψ := yoneda.map t ≫ φ
  have hR' := G.2.2.rep.isPullback ψ
  have hU := G.2.2.rep.isPullback φ
  set sR := G.2.2.rep.snd ψ
  set fR := G.2.2.rep.fst ψ
  have w₁ : fR ≫ G.1.ι = yoneda.map (sR ≫ t) ≫ φ := by
    rw [hR'.w, Functor.map_comp, Category.assoc]
  have w₂ : fR ≫ G.1.ι = yoneda.map (sR ≫ s) ≫ φ := by
    rw [hR'.w, Functor.map_comp, Category.assoc, ← hpb.w]
  obtain ⟨u₁, hf₁, hu₁⟩ := exists_comp_eq_of_isPullback hU _ _ w₁
  obtain ⟨u₂, hf₂, hu₂⟩ := exists_comp_eq_of_isPullback hU _ _ w₂
  have hπ : u₁ ≫ πU = u₂ ≫ πU := yoneda.map_injective (by
    rw [Functor.map_comp, Functor.map_comp, hπU, ← Category.assoc, ← Category.assoc, hf₁, hf₂])
  rw [← appTop_comp_apply, ← appTop_comp_apply, ← hu₁, ← hu₂, appTop_comp_apply,
    appTop_comp_apply, hb, ← appTop_comp_apply, ← appTop_comp_apply, hπ]

/-- **A function invariant modulo the ideal of `Z` restricts to an invariant function on the
chart of `Z`.** Let `R ⇉ V` be the kernel pair of an affine chart `φ` of `X`, with `R` affine,
and `Z ⊆ X` a closed subspace with chart `V_Z = Z ×_X V`. If `t♯ x - s♯ x` lies in the ideal of
`Z ×_X R`, then the restriction of `x` to `V_Z` has equal pullbacks along any two morphisms
into `V_Z` agreeing over `Z`. -/
theorem appTop_eq_of_sub_mem_map_chartIdeal {X : AlgebraicSpaces B S hS}
    (Z : ClosedSubspaces B S hS X.1)
    {V R : BigFppfOver B S hS} (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (hR : IsAffine ((BigFppfOver.toScheme B S hS).obj R)) (φ : yoneda.obj V ⟶ X.1)
    (t s : R ⟶ V) (hpb : IsPullback (yoneda.map t) (yoneda.map s) φ φ)
    (x : Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
    (hx : ((BigFppfOver.toScheme B S hS).map t).appTop.hom x -
        ((BigFppfOver.toScheme B S hS).map s).appTop.hom x ∈
      (closedSubspaceChartIdeal B S hS Z φ).map ((BigFppfOver.toScheme B S hS).map t).appTop.hom)
    {W : BigFppfOver B S hS} (r₁ r₂ : W ⟶ Z.2.2.rep.pullback φ)
    (hr : yoneda.map r₁ ≫ Z.2.2.rep.fst φ = yoneda.map r₂ ≫ Z.2.2.rep.fst φ) :
    ((BigFppfOver.toScheme B S hS).map (r₁ ≫ Z.2.2.rep.snd φ)).appTop.hom x =
      ((BigFppfOver.toScheme B S hS).map (r₂ ≫ Z.2.2.rep.snd φ)).appTop.hom x := by
  rw [← chartIdeal_eq_map Z hV hR φ t] at hx
  have hZ := Z.2.2.rep.isPullback φ
  have hw : ∀ r : W ⟶ Z.2.2.rep.pullback φ,
      yoneda.map (r ≫ Z.2.2.rep.snd φ) ≫ φ = (yoneda.map r ≫ Z.2.2.rep.fst φ) ≫ Z.1.ι := by
    intro r
    rw [Functor.map_comp, Category.assoc, Category.assoc, hZ.w]
  have h₁₂ : yoneda.map (r₁ ≫ Z.2.2.rep.snd φ) ≫ φ = yoneda.map (r₂ ≫ Z.2.2.rep.snd φ) ≫ φ := by
    rw [hw, hw, hr]
  obtain ⟨ρ, hρt', hρs⟩ := exists_comp_eq_of_isPullback hpb _ _ h₁₂
  have hρt : ρ ≫ t = r₁ ≫ Z.2.2.rep.snd φ := yoneda.map_injective (by
    rw [Functor.map_comp, hρt'])
  have hZR := Z.2.2.rep.isPullback (yoneda.map t ≫ φ)
  have hw' : (yoneda.map r₁ ≫ Z.2.2.rep.fst φ) ≫ Z.1.ι = yoneda.map ρ ≫ yoneda.map t ≫ φ := by
    rw [← hw, ← hρt, Functor.map_comp, Category.assoc]
  obtain ⟨ρ', -, hρ'⟩ := exists_comp_eq_of_isPullback hZR _ _ hw'
  have hσ : ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd (yoneda.map t ≫ φ))).appTop.hom
      (((BigFppfOver.toScheme B S hS).map t).appTop.hom x) =
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd (yoneda.map t ≫ φ))).appTop.hom
      (((BigFppfOver.toScheme B S hS).map s).appTop.hom x) := by
    rw [← sub_eq_zero, ← map_sub]
    exact RingHom.mem_ker.mp hx
  rw [← hρt, ← hρs, ← hρ', Category.assoc, Category.assoc, appTop_comp_apply, appTop_comp_apply,
    appTop_comp_apply, appTop_comp_apply, hσ]

/-- **The chart ideals of the stages exhaust that of `G`, after extension along a chart
morphism.** Finitely many elements of the extension of the chart ideal of `G` along
`r : R ⟶ V` already lie in the extension of the chart ideal of one stage. -/
theorem exists_stage_forall_mem_map_chartIdeal {X : AlgebraicSpaces B S hS}
    {G : ClosedSubspaces B S hS X.1} (D : ThickeningStageSystem B S hS X G) {R : BigFppfOver B S hS}
    (r : R ⟶ D.V) (T : Finset Γ((BigFppfOver.toScheme B S hS).obj R, ⊤))
    (hT : ∀ y ∈ T, y ∈ (closedSubspaceChartIdeal B S hS G D.φ).map
      ((BigFppfOver.toScheme B S hS).map r).appTop.hom) :
    ∃ i, ∀ y ∈ T, y ∈ (closedSubspaceChartIdeal B S hS (D.stage i) D.φ).map
      ((BigFppfOver.toScheme B S hS).map r).appTop.hom := by
  classical
  have hV := D.isAffine_V
  have htop : ∀ a : Ideal Γ((BigFppfOver.toScheme B S hS).obj D.V, ⊤),
      (Scheme.IdealSheafData.ofIdealTop a).ideal ⟨⊤, isAffineOpen_top _⟩ = a := fun a =>
    Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply a
  have hsup : closedSubspaceChartIdeal B S hS G D.φ =
      ⨆ i, closedSubspaceChartIdeal B S hS (D.stage i) D.φ := by
    have h0 : ⨆ i, chartKer B S hS X (D.stage i) D.φ = chartKer B S hS X G D.φ :=
      D.iSup_etaleChartKer
    have h := congrArg (fun I : Scheme.IdealSheafData _ =>
      I.ideal ⟨⊤, isAffineOpen_top ((BigFppfOver.toScheme B S hS).obj D.V)⟩) h0
    simp only at h
    rw [Scheme.IdealSheafData.ideal_iSup, iSup_apply] at h
    simp only [chartKer_eq_ofIdealTop _ hV, htop] at h
    exact h.symm
  have hmono : Monotone fun i => (closedSubspaceChartIdeal B S hS (D.stage i) D.φ).map
      ((BigFppfOver.toScheme B S hS).map r).appTop.hom := fun i j hij =>
    Ideal.map_mono (chartIdeal_antitone (D.antitone hij) D.φ)
  rw [hsup, Ideal.map_iSup] at hT
  choose! f hf using fun y hy => (Submodule.mem_iSup_of_directed _ hmono.directed_le).1 (hT y hy)
  obtain ⟨M, hM⟩ := Finset.exists_le (T.image f)
  exact ⟨M, fun y hy => hmono (hM _ (Finset.mem_image_of_mem f hy)) (hf y hy)⟩

/-- **The lifted étale presentation of the chart of `G`, with invariance modulo the ideal of
`G`.** In the situation of `AlgebraicGeometry.Space.exists_isAffineSpace_stage`, the étale,
faithfully flat `Γ(T_G)`-algebra `Γ(U)` is the base change of an étale, faithfully flat algebra `E`
over a countable ring `P` generated by finitely many elements, along `α : P → Γ(T_G)`, and `α`
lifts to `γ : P → Γ(V)` with every `t♯ γ x - s♯ γ x` in the ideal of `G ×_X R`. -/
theorem exists_liftedEtalePresentation_mod_chartIdeal {X : AlgebraicSpaces B S hS}
    (G : ClosedSubspaces B S hS X.1) (hG : IsThickening B S hS X G.1) {TG : BigFppfOver B S hS}
    (eG : G.1.toFunctor ≅ yoneda.obj TG) (hTG : IsAffine ((BigFppfOver.toScheme B S hS).obj TG))
    {V R : BigFppfOver B S hS} (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (hR : IsAffine ((BigFppfOver.toScheme B S hS).obj R)) (φ : yoneda.obj V ⟶ X.1)
    (hφs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
    (hφe : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
    (t s : R ⟶ V) (hpb : IsPullback (yoneda.map t) (yoneda.map s) φ φ)
    (πU : G.2.2.rep.pullback φ ⟶ TG) (hπU : yoneda.map πU = G.2.2.rep.fst φ ≫ eG.hom) :
    ∃ (P E : Type u) (_ : CommRing P) (_ : CommRing E) (_ : Algebra P E) (_ : Algebra.Etale P E)
      (_ : Module.FaithfullyFlat P E) (_ : Countable P)
      (α : P →+* Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤))
      (ε : E →+* Γ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ), ⊤))
      (γ : P →+* Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) (T : Finset P),
      Algebra.adjoin ℤ (T : Set P) = ⊤ ∧
      IsPushout (CommRingCat.ofHom α) (CommRingCat.ofHom (algebraMap P E))
        ((BigFppfOver.toScheme B S hS).map πU).appTop (CommRingCat.ofHom ε) ∧
      ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)).appTop.hom.comp γ =
        ((BigFppfOver.toScheme B S hS).map πU).appTop.hom.comp α ∧
      ∀ x, ((BigFppfOver.toScheme B S hS).map t).appTop.hom (γ x) -
          ((BigFppfOver.toScheme B S hS).map s).appTop.hom (γ x) ∈
        (closedSubspaceChartIdeal B S hS G φ).map
          ((BigFppfOver.toScheme B S hS).map t).appTop.hom := by
  classical
  have sqU := isPullback_snd_comp_inv G eG φ πU hπU
  have sqU' : IsPullback (yoneda.map (G.2.2.rep.snd φ)) (yoneda.map πU) φ (eG.inv ≫ G.1.ι) :=
    sqU.of_iso (Iso.refl _) (Iso.refl _) eG (Iso.refl _) (by simp) (by simp) (by simp)
      (by simp)
  have _ : Etale ((BigFppfOver.toScheme B S hS).map πU) := hφe.property _ _ _ sqU'
  have _ : Surjective ((BigFppfOver.toScheme B S hS).map πU) := hφs.property _ _ _ sqU'
  have _ : AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)) :=
    G.2.2.property_snd φ
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ)) :=
    isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ))
  have _ : Surjective ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)) :=
    surjective_of_isPullback_of_isThickening hG (G.2.2.rep.snd φ) _ sqU
  let rU := ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)).appTop.hom
  let pU := ((BigFppfOver.toScheme B S hS).map πU).appTop.hom
  let tR := ((BigFppfOver.toScheme B S hS).map t).appTop.hom
  let sR := ((BigFppfOver.toScheme B S hS).map s).appTop.hom
  have hpU : Function.Injective pU :=
    Scheme.Hom.appTop_injective_of_flat_of_surjective ((BigFppfOver.toScheme B S hS).map πU)
  have hrU : Function.Surjective rU :=
    ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)).app_surjective ⊤ (isAffineOpen_top _)
  let J := (closedSubspaceChartIdeal B S hS G φ).map tR
  let Inv : Subring Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) :=
    RingHom.eqLocus ((Ideal.Quotient.mk J).comp tR) ((Ideal.Quotient.mk J).comp sR)
  have hInv : ∀ b, b ∈ Inv ↔ tR b - sR b ∈ J := fun b => by
    change Ideal.Quotient.mk J (tR b) = Ideal.Quotient.mk J (sR b) ↔ _
    exact Ideal.Quotient.eq
  let C := Inv ⊓ pU.range.comap rU
  let e : Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤) ≃+* pU.range :=
    RingEquiv.ofBijective pU.rangeRestrict
      ⟨fun a b h => hpU (congrArg Subtype.val h), pU.rangeRestrict_surjective⟩
  let c : C →+* pU.range :=
    (rU.comp C.subtype).codRestrict pU.range (fun b => (Subring.mem_inf.mp b.2).2)
  let α : C →+* Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤) := e.symm.toRingHom.comp c
  have hα : ∀ b : C, pU (α b) = rU b := fun b =>
    congrArg Subtype.val (e.apply_symm_apply (c b))
  let : Algebra C Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤) := α.toAlgebra
  let : Algebra Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ), ⊤) := pU.toAlgebra
  have hαsurj : Function.Surjective
      (algebraMap C Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤)) := by
    intro a
    obtain ⟨b, hb⟩ := hrU (pU a)
    have hbInv : b ∈ Inv := (hInv b).2
      (sub_mem_map_chartIdeal_of_restrict_eq G eG hV hR φ t s hpb πU hπU b a hb)
    have hbC : b ∈ C := Subring.mem_inf.mpr ⟨hbInv, ⟨a, hb.symm⟩⟩
    exact ⟨⟨b, hbC⟩, hpU ((hα ⟨b, hbC⟩).trans hb)⟩
  have hnil : RingHom.ker (algebraMap C Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤)) ≤
      nilradical C := by
    intro b hb
    have h0 : rU b = 0 := by
      rw [← hα b]
      change pU (algebraMap C _ b) = 0
      rw [RingHom.mem_ker.mp hb, map_zero]
    obtain ⟨n, hn⟩ := ker_appTop_le_nilradical_of_surjective
      ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)) (RingHom.mem_ker.mpr h0)
    exact ⟨n, Subtype.ext (by simpa using hn)⟩
  have _ : Algebra.Etale Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ), ⊤) := by
    rw [← RingHom.etale_algebraMap]
    exact (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp inferInstance
  have _ : Module.FaithfullyFlat Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ), ⊤) := by
    rw [← RingHom.faithfullyFlat_algebraMap_iff]
    exact (Flat.flat_and_surjective_iff_faithfullyFlat_of_isAffine
      ((BigFppfOver.toScheme B S hS).map πU)).1 ⟨inferInstance, inferInstance⟩
  obtain ⟨P, E, _, _, hPfg, _, _, ε, hpush⟩ :=
    Algebra.exists_countable_etale_faithfullyFlat_model
      (B := Γ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ), ⊤)) hαsurj hnil
  have := Subalgebra.countable_of_fg hPfg
  obtain ⟨T, hT⟩ := (Subalgebra.fg_top P).mpr hPfg
  refine ⟨P, E, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, (algebraMap C _).comp P.val.toRingHom, ε, C.subtype.comp P.val.toRingHom,
    T, hT, hpush, ?_, ?_⟩
  · ext x
    change rU x.1.1 = pU (α x.1)
    exact (hα x.1).symm
  · intro x
    exact (hInv x.1.1).1 (Subring.mem_inf.mp x.1.2).1

/-- **A stage on whose chart the presentation becomes invariant is affine.** Let `H ⊇ G` be a
closed subspace of `X`, and let the étale, faithfully flat model `E` over `P` of the chart `U` of
`G` come with a lift `γ : P → Γ(V)` whose values are invariant modulo the ideal of `H ×_X R`.
Then `H` is affine: restricted to the chart `H ×_X V` of `H`, `γ` is an invariant lift, and
`AlgebraicGeometry.Space.isAffineSpace_of_liftedEtalePresentation` applies to `G ⊂ H`. -/
theorem isAffineSpace_of_forall_sub_mem_map_chartIdeal {X : AlgebraicSpaces B S hS}
    (G : ClosedSubspaces B S hS X.1) (hG : IsThickening B S hS X G.1) {TG : BigFppfOver B S hS}
    (eG : G.1.toFunctor ≅ yoneda.obj TG) (hTG : IsAffine ((BigFppfOver.toScheme B S hS).obj TG))
    (H : ClosedSubspaces B S hS X.1) (hGH : G.1 ≤ H.1)
    {V R : BigFppfOver B S hS} (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (hR : IsAffine ((BigFppfOver.toScheme B S hS).obj R)) (φ : yoneda.obj V ⟶ X.1)
    (hφs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
    (hφe : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
    (t s : R ⟶ V) (hpb : IsPullback (yoneda.map t) (yoneda.map s) φ φ)
    (πU : G.2.2.rep.pullback φ ⟶ TG) (hπU : yoneda.map πU = G.2.2.rep.fst φ ≫ eG.hom)
    (P E : Type u) [CommRing P] [CommRing E] [Algebra P E] [Algebra.Etale P E]
    [Module.FaithfullyFlat P E] [Countable P]
    (α : P →+* Γ((BigFppfOver.toScheme B S hS).obj TG, ⊤))
    (ε : E →+* Γ((BigFppfOver.toScheme B S hS).obj (G.2.2.rep.pullback φ), ⊤))
    (γ : P →+* Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
    (hpush : IsPushout (CommRingCat.ofHom α) (CommRingCat.ofHom (algebraMap P E))
        ((BigFppfOver.toScheme B S hS).map πU).appTop (CommRingCat.ofHom ε))
    (hγU : ((BigFppfOver.toScheme B S hS).map (G.2.2.rep.snd φ)).appTop.hom.comp γ =
        ((BigFppfOver.toScheme B S hS).map πU).appTop.hom.comp α)
    (hγ : ∀ x, ((BigFppfOver.toScheme B S hS).map t).appTop.hom (γ x) -
          ((BigFppfOver.toScheme B S hS).map s).appTop.hom (γ x) ∈
        (closedSubspaceChartIdeal B S hS H φ).map
          ((BigFppfOver.toScheme B S hS).map t).appTop.hom) :
    IsAffineSpace B S hS H.1.toFunctor := by
  classical
  have hUpb : IsPullback (G.2.2.rep.fst φ) (yoneda.map (G.2.2.rep.snd φ)) G.1.ι φ :=
    G.2.2.rep.isPullback φ
  have sqU := isPullback_snd_comp_inv G eG φ πU hπU
  -- the closed subspace `H` as an algebraic space, with `G` as a thickening of it
  let Xi : AlgebraicSpaces B S hS := ⟨H.1.toFunctor, H.2.1⟩
  let ιH : Xi ⟶ X := ObjectProperty.homMk H.1.ι
  let Gi : Subfunctor Xi.1 := G.1.preimage H.1.ι
  have hGi : IsThickening B S hS Xi Gi := isThickening_preimage B S hS G.1 ιH hG
  let eGG : Gi.toFunctor ≅ G.1.toFunctor :=
    { hom := Subfunctor.lift (Gi.ι ≫ H.1.ι) (by
        rintro W _ ⟨x, rfl⟩
        exact x.2)
      inv := Subfunctor.lift (Subfunctor.homOfLe hGH) (by
        rintro W _ ⟨x, rfl⟩
        exact x.2)
      hom_inv_id := by ext W x; rfl
      inv_hom_id := by ext W x; rfl }
  let eGi : Gi.toFunctor ≅ yoneda.obj TG := eGG ≪≫ eG
  -- the chart of `H`
  have hHpb : IsPullback (H.2.2.rep.fst φ) (yoneda.map (H.2.2.rep.snd φ)) H.1.ι φ :=
    H.2.2.rep.isPullback φ
  have _ : AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (H.2.2.rep.snd φ)) := H.2.2.property_snd φ
  have hVi : IsAffine ((BigFppfOver.toScheme B S hS).obj (H.2.2.rep.pullback φ)) :=
    isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map (H.2.2.rep.snd φ))
  have _ : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS))).IsStableUnderBaseChange :=
    MorphismProperty.relative_isStableUnderBaseChange _
  have _ : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS))).IsStableUnderBaseChange :=
    MorphismProperty.relative_isStableUnderBaseChange _
  have hφis := MorphismProperty.of_isPullback hHpb.flip hφs
  have hφie := MorphismProperty.of_isPullback hHpb.flip hφe
  -- `U` as the chart of `G` inside `H`
  have hw : (G.2.2.rep.fst φ ≫ Subfunctor.homOfLe hGH) ≫ H.1.ι =
      yoneda.map (G.2.2.rep.snd φ) ≫ φ := by
    rw [Category.assoc, Subfunctor.homOfLe_ι]
    exact hUpb.w
  obtain ⟨ιUi, hιUi', hιUi⟩ := exists_comp_eq_of_isPullback hHpb _ _ hw
  have hGG : eGG.inv ≫ Gi.ι = Subfunctor.homOfLe hGH := rfl
  have hGG' : eGG.hom ≫ G.1.ι = Gi.ι ≫ H.1.ι := rfl
  have sqUi : IsPullback (yoneda.map ιUi) (yoneda.map πU ≫ eGi.inv) (H.2.2.rep.fst φ) Gi.ι := by
    have big : IsPullback (yoneda.map ιUi ≫ yoneda.map (H.2.2.rep.snd φ))
        (yoneda.map πU ≫ eGi.inv) φ (Gi.ι ≫ H.1.ι) :=
      sqU.of_iso (Iso.refl _) (Iso.refl _) eGG.symm (Iso.refl _)
        (by rw [Iso.refl_hom, Category.comp_id, Iso.refl_hom, Category.id_comp,
          ← Functor.map_comp, hιUi])
        (by simp [eGi])
        (by simp)
        (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hGG', Iso.inv_hom_id_assoc])
    refine IsPullback.of_right big ?_ hHpb.flip
    rw [hιUi', Category.assoc]
    simp only [eGi, Iso.trans_inv, Category.assoc, hGG]
    rw [← Category.assoc (yoneda.map πU), hπU, Category.assoc, Category.assoc,
      Iso.hom_inv_id_assoc]
  -- the invariant lift
  let β : P →+* Γ((BigFppfOver.toScheme B S hS).obj (H.2.2.rep.pullback φ), ⊤) :=
    ((BigFppfOver.toScheme B S hS).map (H.2.2.rep.snd φ)).appTop.hom.comp γ
  refine isAffineSpace_of_liftedEtalePresentation B S hS Xi Gi hGi hTG eGi hVi
    (H.2.2.rep.fst φ) hφis hφie ιUi πU sqUi P E α ε hpush β ?_ ?_
  · ext x
    change ((BigFppfOver.toScheme B S hS).map ιUi).appTop.hom
        (((BigFppfOver.toScheme B S hS).map (H.2.2.rep.snd φ)).appTop.hom (γ x)) =
      ((BigFppfOver.toScheme B S hS).map πU).appTop.hom (α x)
    rw [← appTop_comp_apply, hιUi]
    exact RingHom.congr_fun hγU x
  · intro W r₁ r₂ h
    ext x
    change ((BigFppfOver.toScheme B S hS).map r₁).appTop.hom
        (((BigFppfOver.toScheme B S hS).map (H.2.2.rep.snd φ)).appTop.hom (γ x)) =
      ((BigFppfOver.toScheme B S hS).map r₂).appTop.hom
        (((BigFppfOver.toScheme B S hS).map (H.2.2.rep.snd φ)).appTop.hom (γ x))
    rw [← appTop_comp_apply, ← appTop_comp_apply]
    exact appTop_eq_of_sub_mem_map_chartIdeal H hV hR φ t s hpb (γ x) (hγ x) r₁ r₂ h

variable (B S hS) in
/-- **A system of finite-order stages of a thickening of an affine space has an affine stage.**
Let `G ⊂ X` be a thickening of algebraic spaces over `S` with `G` affine, and let `D` be a system
of closed subspaces `G ⊆ H_i ⊆ X` whose chartwise ideals on the affine chart `V` of `D` exhaust
that of `G`. Then some `H_i` is an affine algebraic space.

This plays the role of Stacks 07SQ (an affine limit of quasi-compact and quasi-separated
algebraic spaces with affine transition maps has an affine stage) for this situation. Write
`R ⇉ V` for the kernel pair of the chart, `N ⊆ Γ(V)` for the ideal of `G` and `U = G ×_X V`. The
functions on `V` whose restriction to `U` comes from `Γ(G)` are invariant modulo `N · Γ(R)` and
form a ring mapping onto `Γ(G)` with nil kernel, so the étale, faithfully flat `Γ(G)`-algebra
`Γ(U)` is the base change of an étale, faithfully flat algebra over a finitely generated subring
`P` of it (`AlgebraicGeometry.Space.exists_liftedEtalePresentation_mod_chartIdeal`). The finitely
many generators of `P` are invariant modulo the ideal of one stage `H_i` on `R`
(`AlgebraicGeometry.Space.exists_stage_forall_mem_map_chartIdeal`), hence so is all of `P`, and
the lifted étale presentation makes `H_i` affine
(`AlgebraicGeometry.Space.isAffineSpace_of_forall_sub_mem_map_chartIdeal`), the topological
invariance of the étale site, Stacks 05ZH, doing the work of Stacks 07SI and 084S. The
finite-order condition on the stages is not used. -/
theorem exists_isAffineSpace_stage (X : AlgebraicSpaces B S hS)
    (G : ClosedSubspaces B S hS X.1) (hG : IsThickening B S hS X G.1)
    (hGaff : IsAffineSpace B S hS G.1.toFunctor) (D : ThickeningStageSystem B S hS X G) :
    ∃ i, IsAffineSpace B S hS (D.stage i).1.toFunctor := by
  classical
  have hV := D.isAffine_V
  have hrep : yoneda.relativelyRepresentable D.φ := D.etale.rep
  have hpb : IsPullback (yoneda.map (hrep.fst' D.φ)) (yoneda.map (hrep.snd D.φ)) D.φ D.φ :=
    hrep.isPullback' D.φ
  have hR : IsAffine ((BigFppfOver.toScheme B S hS).obj (hrep.pullback D.φ)) :=
    isAffine_of_isPullback_of_isThickening B S hS hG hGaff hV D.φ _ _ hpb
  obtain ⟨TG, hTG, ⟨eG⟩⟩ := hGaff
  let πU : G.2.2.rep.pullback D.φ ⟶ TG := yoneda.preimage (G.2.2.rep.fst D.φ ≫ eG.hom)
  have hπU : yoneda.map πU = G.2.2.rep.fst D.φ ≫ eG.hom := Functor.map_preimage _ _
  obtain ⟨P, E, _, _, _, _, _, _, α, ε, γ, T, hT, hpush, hγU, hγ⟩ :=
    exists_liftedEtalePresentation_mod_chartIdeal G hG eG hTG hV hR D.φ D.surjective D.etale
      _ _ hpb πU hπU
  let tR := ((BigFppfOver.toScheme B S hS).map (hrep.fst' D.φ)).appTop.hom
  let sR := ((BigFppfOver.toScheme B S hS).map (hrep.snd D.φ)).appTop.hom
  obtain ⟨i, hi⟩ := exists_stage_forall_mem_map_chartIdeal D (hrep.fst' D.φ)
    (T.image fun x => tR (γ x) - sR (γ x)) (by
      intro y hy
      obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hy
      exact hγ x)
  -- the invariance passes from the generators of `P` to all of `P`
  let K := (closedSubspaceChartIdeal B S hS (D.stage i) D.φ).map tR
  let Inv : Subring P :=
    (RingHom.eqLocus ((Ideal.Quotient.mk K).comp tR) ((Ideal.Quotient.mk K).comp sR)).comap γ
  have hTle : Algebra.adjoin ℤ (T : Set P) ≤ subalgebraOfSubring Inv := by
    rw [Algebra.adjoin_le_iff]
    intro x hx
    change Ideal.Quotient.mk K (tR (γ x)) = Ideal.Quotient.mk K (sR (γ x))
    exact Ideal.Quotient.eq.mpr (hi _ (Finset.mem_image_of_mem _ hx))
  have hall : ∀ x, tR (γ x) - sR (γ x) ∈ K := by
    intro x
    have hx : x ∈ subalgebraOfSubring Inv := hTle (hT ▸ Algebra.mem_top)
    exact Ideal.Quotient.eq.mp hx
  exact ⟨i, isAffineSpace_of_forall_sub_mem_map_chartIdeal G hG eG hTG (D.stage i)
    (D.le_stage i) hV hR D.φ D.surjective D.etale _ _ hpb πU hπU P E α ε γ hpush hγU hall⟩

