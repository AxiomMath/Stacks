/-!
# Flatness over a base makes the action of the ideal of a base change injective

Let `f : X ⟶ T` be a morphism of algebraic spaces, `Z_T ⊆ T` a closed subspace and
`Z = f⁻¹(Z_T) ⊆ X` its inverse image, with defining ideal `𝓘 ⊆ 𝒪_X`.  If an `𝒪_X`-module `ℱ'` is
flat over `T` (Stacks 05VV), the action of `𝓘` on `ℱ'` is injective in the local form of
`Deformation.ToposThickening.IdealTensorLocallyVanishes`: a tensor `∑ ε_j ⊗ s_j` of sections of
`𝓘` and of `ℱ'` with `∑ ε_j s_j = 0` vanishes on a covering.

This is the input of Stacks 08VU for a thickening of algebraic spaces obtained by base change,
and it is what Stacks 08MQ provides in the source.  Here it is proved on charts: over a
commutative square of affine étale charts `U ⟶ V` the ideal of `Z` is generated by the ideal of
`Z_T` (`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map_chartDiagram`), and the Zariski
stalks of the restriction of `ℱ'` to `U` are flat over `𝒪_T(V)`; a relation with coefficients in
the ideal of `Z_T` is then trivial near every point
(`AlgebraicGeometry.exists_mem_sum_balanced_eq_zero_of_flat_stalk`).

## Main results

* `AlgebraicGeometry.Space.flat_chartStalk_of_isFlatOver`: the Zariski stalks of the restriction
  of `ℱ'` to a chart of `X` are flat over the functions on an affine chart of `T`.
* `AlgebraicGeometry.Space.exists_sum_mul_chartDiagramFunctionPullback_eq`: over an affine
  square of charts the ideal of `f⁻¹(Z_T)` is generated by the ideal of `Z_T`.
* `AlgebraicGeometry.Space.exists_open_sum_tmul_eq_zero_of_isFlatOver`: a relation with
  coefficients in the ideal of `f⁻¹(Z_T)` vanishes in the tensor product near every point.

The global statement, `AlgebraicGeometry.Space.idealTensorLocallyVanishes_of_isFlatOver`, is in
`StacksFrontier/AlgebraicGeometry/Spaces/Thickenings/FlatIdealTensorLocal.lean`.

## Implementation notes

The proofs are split into many small declarations and avoid `rcases` and `rw` on the sections of
the structure sheaves: the rings of sections of the small étale ringed topos and of the small
étale ringed site are the same rings in two spellings, and unifying the two through a large
declaration exhausts the heartbeat budget.

## References

* [Stacks Project, Tag 08VU](https://stacks.math.columbia.edu/tag/08VU)
* [Stacks Project, Tag 08MQ](https://stacks.math.columbia.edu/tag/08MQ)
* [Stacks Project, Tag 05VV](https://stacks.math.columbia.edu/tag/05VV)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open Stacks.SheafOfModules.Tensor (ringSheaf)
open Stacks.Sheaves.LocalGeneration (restr)
open scoped TensorProduct

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (X : AlgebraicSpaces B S hS)

/-- The inclusion of the étale chart cut out by a Zariski open factors through the chart cut out
by the whole chart's scheme. -/
theorem chartOpens_map_comp_chartOpensTopHom (A : SmallEtale B S hS X.1)
    (V : (chartScheme A).Opens) :
    (chartOpens B S hS A).map (homOfLE le_top) ≫ chartOpensTopHom B S hS X A =
      chartOpensHom B S hS X A V :=
  ObjectProperty.hom_ext _ <| CostructuredArrow.hom_ext _ _ <|
    chartOpenOverMap_comp_ι B S hS A (homOfLE le_top)

/-- The comparison of the structure sheaf of the chart's scheme with that of `X`, at a Zariski
open `V`, on a function restricted from the whole chart: it is restriction of functions along the
inclusion of the chart of `V`. -/
theorem chartRestrictionRingHom_app_map_top (A : SmallEtale B S hS X.1)
    (V : (chartScheme A).Opens) (r : (structureRingSheaf B S hS X).obj.obj (op A)) :
    (chartRestrictionRingHom B S hS X.2 A).app (op V)
        ((chartScheme A).presheaf.map (homOfLE le_top).op r) =
      (structureRingSheaf B S hS X).obj.map (chartOpensHom B S hS X A V).op r := by
  have h := congrArg (fun φ => φ r)
    (congrArg RingCat.Hom.hom ((chartRestrictionRingHom B S hS X.2 A).naturality
      (homOfLE (le_top : V ≤ ⊤)).op))
  simp only [RingCat.hom_comp, RingHom.coe_comp] at h
  refine h.trans ?_
  rw [← chartOpens_map_comp_chartOpensTopHom B S hS X A V]
  change ((structureRingSheaf B S hS X).obj.map ((chartOpens B S hS A).map (homOfLE le_top)).op)
      ((structureRingSheaf B S hS X).obj.map (chartOpensTopHom B S hS X A).op r) = _
  rw [← RingCat.comp_apply, ← Functor.map_comp]
  rfl

/-- The ringed space underlying the scheme of an étale chart. -/
noncomputable abbrev chartRingedSpace {Y : AlgebraicSpaces B S hS} (A : SmallEtale B S hS Y.1) :
    RingedSpace.{u} :=
  LocallyRingedSpace.forgetToSheafedSpace.obj (chartScheme A).toLocallyRingedSpace

/-- The restriction of an `𝒪_X`-module to the Zariski site of an étale chart, as a presheaf of
modules over the structure sheaf of the ringed space of the chart's scheme. -/
noncomputable abbrev chartPresheafModule (F' : Modules.{u, u} B S hS X.1 X.2)
    (A : SmallEtale B S hS X.1) :
    PresheafOfModules.{u} ((chartRingedSpace B S hS A).presheaf ⋙ forget₂ CommRingCat RingCat) :=
  (chartRestrictionSheaf B S hS X F' A).val

variable {X} {T : AlgebraicSpaces B S hS}

/-- The morphism of ringed spaces underlying the vertical morphism of a commutative square of
étale charts. -/
noncomputable abbrev chartDiagramShHom {f : X ⟶ T} (d : ChartDiagram B S hS X.1 T.1 f.hom) :
    chartRingedSpace B S hS d.U ⟶ chartRingedSpace B S hS d.V :=
  LocallyRingedSpace.forgetToSheafedSpace.map ((BigFppfOver.toScheme B S hS).map d.g).toLRSHom

/-- The ring map `𝒪_T(V) ⟶ 𝒪_{U, y}` along which the Zariski stalk at `y` of the restriction of an
`𝒪_X`-module to the chart `U` of a commutative square of charts is a module over `𝒪_T(V)`. -/
noncomputable abbrev chartDiagramGlobalToStalkRingHom {f : X ⟶ T}
    (d : ChartDiagram B S hS X.1 T.1 f.hom)
    (y : chartRingedSpace B S hS d.U) :
    (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤) →+*
      (chartRingedSpace B S hS d.U).presheaf.stalk y :=
  ((chartDiagramShHom B S hS d).hom.stalkMap y).hom.comp
    ((chartRingedSpace B S hS d.V).presheaf.germ ⊤ ((chartDiagramShHom B S hS d).hom.base y)
      trivial).hom

attribute [-instance] Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule in
/-- **The Zariski stalks of a module flat over `T` are flat over the functions on an affine
chart of `T`.**  For a commutative square of charts `U ⟶ V` with `V` affine and a point `y` of
`U`, the stalk at `y` of the restriction of `ℱ'` to `U` is flat over `𝒪_T(V)`: it is flat over
the local ring `𝒪_{V, g(y)}` by Stacks 05VV, which is a localization of `𝒪_T(V)`. -/
theorem flat_chartStalk_of_isFlatOver (f : X ⟶ T) (F' : Modules.{u, u} B S hS X.1 X.2)
    (hflat : IsFlatOver B S hS X.2 f.hom F') (d : ChartDiagram B S hS X.1 T.1 f.hom)
    [IsAffine (chartScheme d.V)] (y : chartRingedSpace B S hS d.U) :
    letI : Module ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
        (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
          (chartPresheafModule B S hS X F' d.U).presheaf y) :=
      Module.compHom _ (chartDiagramGlobalToStalkRingHom B S hS d y)
    Module.Flat ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (chartPresheafModule B S hS X F' d.U).presheaf y) := by
  have h := (AlgebraicGeometry.isFlatOverAt_iff_of_moduleIso _
    (restrictToChartIsoChartRestrictionSheaf B S hS X F' d.U) y).1 (hflat d y)
  let p := chartDiagramShHom B S hS d
  let : Module ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (chartPresheafModule B S hS X F' d.U).presheaf y) :=
    Module.compHom _ (p.hom.stalkMap y).hom
  have : Module.Flat ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (chartPresheafModule B S hS X F' d.U).presheaf y) := h
  let : Module ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (chartPresheafModule B S hS X F' d.U).presheaf y) :=
    Module.compHom _ (chartDiagramGlobalToStalkRingHom B S hS d y)
  let : Algebra ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
      ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y)) :=
    TopCat.Presheaf.algebra_section_stalk (chartRingedSpace B S hS d.V).presheaf
      (⟨p.hom.base y, trivial⟩ : (⊤ : Opens (chartRingedSpace B S hS d.V).carrier))
  have : IsScalarTower ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
      ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (chartPresheafModule B S hS X F' d.U).presheaf y) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let P : Ideal ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) :=
    ((isAffineOpen_top (chartScheme d.V)).primeIdealOf ⟨p.hom.base y, trivial⟩).asIdeal
  have hP : P.IsPrime :=
    ((isAffineOpen_top (chartScheme d.V)).primeIdealOf ⟨p.hom.base y, trivial⟩).isPrime
  have : IsLocalization P.primeCompl
      ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y)) :=
    (isAffineOpen_top (chartScheme d.V)).isLocalization_stalk ⟨p.hom.base y, trivial⟩
  have : Module.Flat ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
      ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y)) :=
    IsLocalization.flat _ P.primeCompl
  exact Module.Flat.trans ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
    ((chartRingedSpace B S hS d.V).presheaf.stalk (p.hom.base y)) _

/-- An element of the extension `φ(I)·R` of an ideal is a finite combination of images of
elements of `I`. -/
theorem exists_sum_mul_eq_of_mem_map {R₀ R : Type*} [Semiring R₀] [Semiring R] (φ : R₀ →+* R)
    (I : Ideal R₀) {x : R} (hx : x ∈ Ideal.map φ I) :
    ∃ (m : ℕ) (c : Fin m → R) (bb : Fin m → R₀), (∀ l, bb l ∈ I) ∧ ∑ l, c l * φ (bb l) = x := by
  obtain ⟨m, c, g, hg⟩ := Submodule.mem_span_set'.1 hx
  choose bb hbb hφ using fun l => (g l).2
  exact ⟨m, c, bb, hbb, by simpa only [smul_eq_mul, hφ] using hg⟩

/-- `AlgebraicGeometry.Space.exists_sum_mul_eq_of_mem_map` for rings given as commutative ring
objects, so that its ring structures are the ones of the category. -/
theorem exists_sum_mul_eq_of_mem_map_commRingCat {A A' : CommRingCat.{u}} (φ : A →+* A')
    (I : Ideal A) {x : A'} (hx : x ∈ Ideal.map φ I) :
    ∃ (m : ℕ) (c : Fin m → A') (bb : Fin m → A), (∀ l, bb l ∈ I) ∧ ∑ l, c l * φ (bb l) = x :=
  exists_sum_mul_eq_of_mem_map φ I hx

/-- Pullback of functions along the vertical morphism of a commutative square of étale charts,
between the sections of the structure sheaves of the small étale ringed topoi. -/
noncomputable def chartDiagramFunctionPullback {f : X ⟶ T}
    (d : ChartDiagram B S hS X.1 T.1 f.hom) :
    (smallEtaleRingedTopos B S hS T).O.obj.obj (op d.V) →+*
      (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U) :=
  (chartDiagramPullback B S hS f d).hom

/-- The kernel of the structure map of the inclusion of a closed subspace is its defining ideal. -/
private theorem ker_fSharp_app_eq_definingIdealAt {Y : AlgebraicSpaces B S hS}
    (Z : ClosedSubspaces B S hS Y.1) (U : (SmallEtale B S hS Y.1)ᵒᵖ) :
    RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS Y Z)).fSharp.hom.app U).hom = definingIdealAt B S hS Y Z U :=
  Ideal.ext fun a => RingHom.mem_ker.trans (fSharp_app_eq_zero_iff B S hS Z U a)

/-- Over an affine square of charts, the kernel of the inclusion of `f⁻¹(Z_T)` is the extension of
the kernel of the inclusion of `Z_T`. -/
private theorem ker_preimage_eq_map_ker_chartDiagramFunctionPullback (f : X ⟶ T)
    (ZT : ClosedSubspaces B S hS T.1) (d : ChartDiagram B S hS X.1 T.1 f.hom)
    [IsAffine (chartScheme d.U)] [IsAffine (chartScheme d.V)] :
    RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT))).fSharp.hom.app (op d.U)).hom =
    Ideal.map (chartDiagramFunctionPullback B S hS d) (RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS T ZT)).fSharp.hom.app (op d.V)).hom) := by
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.1.left) := ‹IsAffine (chartScheme d.V)›
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj d.U.1.left) := ‹IsAffine (chartScheme d.U)›
  exact (ker_fSharp_app_eq_definingIdealAt B S hS _ _).trans
    ((definingIdealAt_preimage_eq_map_chartDiagram B S hS f ZT d).trans
      (congrArg (Ideal.map _) (ker_fSharp_app_eq_definingIdealAt B S hS _ _).symm))

/-- **The kernel of the inclusion of `f⁻¹(Z_T)` over an affine square of charts is generated by
the kernel of the inclusion of `Z_T`**, in the spelling of the small étale ringed topoi. -/
theorem exists_sum_mul_chartDiagramFunctionPullback_eq (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)]
    (e : RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT))).fSharp.hom.app (op d.U)).hom) :
    ∃ (m : ℕ) (c : Fin m → (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U))
      (bb : Fin m → RingHom.ker ((smallEtaleRingedToposHom B S hS
        (subspaceInclusion B S hS T ZT)).fSharp.hom.app (op d.V)).hom),
      ∑ l, c l * chartDiagramFunctionPullback B S hS d (bb l) = e := by
  have h4 : (e : (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U)) ∈
      Ideal.map (chartDiagramFunctionPullback B S hS d) (RingHom.ker ((smallEtaleRingedToposHom
        B S hS (subspaceInclusion B S hS T ZT)).fSharp.hom.app (op d.V)).hom) :=
    (SetLike.ext_iff.1 (ker_preimage_eq_map_ker_chartDiagramFunctionPullback B S hS f ZT d) _).1
      e.2
  have h5 := exists_sum_mul_eq_of_mem_map_commRingCat (chartDiagramFunctionPullback B S hS d)
    (RingHom.ker ((smallEtaleRingedToposHom B S hS
        (subspaceInclusion B S hS T ZT)).fSharp.hom.app (op d.V)).hom) h4
  exact h5.elim fun m h => h.elim fun c h => h.elim fun bb h =>
    ⟨m, c, fun l => ⟨bb l, h.1 l⟩, h.2⟩

/-- Pullback of functions along a square of charts carries the kernel of the inclusion of `Z_T`
into the kernel of the inclusion of `f⁻¹(Z_T)`. -/
theorem chartDiagramFunctionPullback_mem_kernel (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)]
    (c : RingHom.ker ((smallEtaleRingedToposHom B S hS
        (subspaceInclusion B S hS T ZT)).fSharp.hom.app (op d.V)).hom) :
    chartDiagramFunctionPullback B S hS d c ∈ RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X
        (preimageSubspace B S hS f ZT))).fSharp.hom.app (op d.U)).hom :=
  (SetLike.ext_iff.1 (ker_preimage_eq_map_ker_chartDiagramFunctionPullback B S hS f ZT d) _).2
    (Ideal.mem_map_of_mem _ c.2)

/-- Expanding the first factor of a sum of tensors. -/
theorem sum_tmul_eq_sum_sigma {R K M : Type*} [CommRing R] [AddCommGroup K] [Module R K]
    [AddCommGroup M] [Module R M] {n : ℕ} (m : Fin n → ℕ) (x : Fin n → K) (y : Fin n → M)
    (a : ∀ j, Fin (m j) → R) (k : ∀ j, Fin (m j) → K) (hx : ∀ j, x j = ∑ l, a j l • k j l) :
    ∑ j, x j ⊗ₜ[R] y j = ∑ i : (Σ j, Fin (m j)), k i.1 i.2 ⊗ₜ[R] (a i.1 i.2 • y i.1) := by
  rw [Fintype.sum_sigma]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hx j, TensorProduct.sum_tmul]
  exact Finset.sum_congr rfl fun l _ => TensorProduct.smul_tmul _ _ _

/-- Substituting combinations into a relation: if `ε_j = ∑_l c_{jl} b_{jl}` and `∑_j ε_j s_j = 0`,
then `∑_{(j, l)} b_{jl} (c_{jl} s_j) = 0`. -/
theorem sum_sigma_smul_smul_eq_zero {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {n : ℕ} (m : Fin n → ℕ) (ε : Fin n → R) (s : Fin n → M) (c b : ∀ j, Fin (m j) → R)
    (hsum : ∀ j, ∑ l, c j l * b j l = ε j) (hs : ∑ j, ε j • s j = 0) :
    ∑ k : (Σ j, Fin (m j)), b k.1 k.2 • (c k.1 k.2 • s k.1) = 0 := by
  rw [Fintype.sum_sigma]
  refine Eq.trans (Finset.sum_congr rfl fun j _ => ?_) hs
  simp only [smul_smul]
  rw [← Finset.sum_smul, ← hsum j]
  congr 1
  exact Finset.sum_congr rfl fun l _ => mul_comm _ _

/-- **A relation among sections over a chart is a relation among the sections of the chart
restriction over the whole chart's scheme.** -/
theorem chartPresheafModule_top_relation
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (A : SmallEtale B S hS X.1) {n : ℕ}
    (a : Fin n → (smallEtaleRingedTopos B S hS X).O.obj.obj (op A))
    (t : Fin n → F'.val.obj (op A)) (h : ∑ k, a k • t k = 0) :
    ∑ k, (show ((chartRingedSpace B S hS A).presheaf ⋙ forget₂ CommRingCat RingCat).obj (op ⊤)
        from a k) •
      (show (chartPresheafModule B S hS X F' A).obj (op ⊤) from
        ULift.up (restr F' (chartOpensTopHom B S hS X A).op (t k))) = 0 := by
  have hterm : ∀ k, (show ((chartRingedSpace B S hS A).presheaf ⋙ forget₂ CommRingCat RingCat).obj
      (op ⊤) from a k) •
      (show (chartPresheafModule B S hS X F' A).obj (op ⊤) from
        ULift.up (restr F' (chartOpensTopHom B S hS X A).op (t k))) =
      (show (chartPresheafModule B S hS X F' A).obj (op ⊤) from
        ULift.up (restr F' (chartOpensTopHom B S hS X A).op (a k • t k))) := fun k =>
    congrArg ULift.up (F'.val.map_smul (chartOpensTopHom B S hS X A).op (a k) (t k)).symm
  refine (Finset.sum_congr rfl fun k _ => hterm k).trans ?_
  have hsum := map_sum (AddEquiv.ulift (α := F'.val.obj (op ((chartOpens B S hS A).obj ⊤)))).symm
    (fun k => restr F' (chartOpensTopHom B S hS X A).op (a k • t k)) Finset.univ
  have h0 : ∑ k, restr F' (chartOpensTopHom B S hS X A).op (a k • t k) = 0 :=
    (map_sum (F'.val.map (chartOpensTopHom B S hS X A).op).hom _ _).symm.trans
      ((congrArg (F'.val.map (chartOpensTopHom B S hS X A).op).hom h).trans (map_zero _))
  exact hsum.symm.trans ((congrArg _ h0).trans (map_zero _))

/-- The kernel of the inclusion of `Z_T` over a chart `V` of `T`, as an ideal of the functions on
the scheme of `V`. -/
noncomputable abbrev chartTargetIdeal (ZT : ClosedSubspaces B S hS T.1) {f : X ⟶ T}
    (d : ChartDiagram B S hS X.1 T.1 f.hom) :
    Ideal ((chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) :=
  RingHom.ker ((smallEtaleRingedToposHom B S hS
    (subspaceInclusion B S hS T ZT)).fSharp.hom.app (op d.V)).hom

/-- The ideal of `f⁻¹(Z_T)` over the étale chart cut out by a Zariski open `V` of a chart `U`. -/
noncomputable abbrev chartOpensKernel (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (U : SmallEtale B S hS X.1) (V : (chartScheme U).Opens) :=
  RingHom.ker ((smallEtaleRingedToposHom B S hS
    (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT))).fSharp.hom.app
      (op ((chartOpens B S hS U).obj V))).hom

/-- Pulling back a function in the ideal of `Z_T` along a square of affine charts and restricting
it to a Zariski open `V` of the source chart gives a function in the ideal of `f⁻¹(Z_T)`. -/
noncomputable def chartKernelRestr (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)] (V : (chartScheme d.U).Opens) :
    chartTargetIdeal B S hS ZT d →+ chartOpensKernel B S hS f ZT d.U V where
  toFun c := Deformation.ToposThickening.kernelRestr (smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT)))
    (chartOpensHom B S hS X d.U V).op
    ⟨chartDiagramFunctionPullback B S hS d (c : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)),
      chartDiagramFunctionPullback_mem_kernel B S hS f ZT d c⟩
  map_zero' := Subtype.ext ((congrArg
    ((smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op).hom
      (map_zero (chartDiagramFunctionPullback B S hS d))).trans (map_zero _))
  map_add' c c' := Subtype.ext ((congrArg
    ((smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op).hom
      (map_add (chartDiagramFunctionPullback B S hS d)
        (c : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))
        (c' : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)))).trans (map_add _ _ _))

/-- The function underlying `chartKernelRestr` at `c` is the pullback of `c` along the square of
charts, restricted to the Zariski open `V`. -/
theorem chartKernelRestr_coe (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)] (V : (chartScheme d.U).Opens) (c : chartTargetIdeal B S hS ZT d) :
    (chartKernelRestr B S hS f ZT d V c :
        (smallEtaleRingedTopos B S hS X).O.obj.obj (op ((chartOpens B S hS d.U).obj V))) =
      (smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op
        (chartDiagramFunctionPullback B S hS d
          (c : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))) :=
  rfl

/-- The balanced map `J × N(V) ⟶ 𝓘(V) ⊗ ℱ'(V)` through which a relation in the chart restriction
becomes a vanishing tensor. -/
noncomputable def chartBalancedTensor (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)] (V : (chartScheme d.U).Opens) :
    chartTargetIdeal B S hS ZT d →+ (chartPresheafModule B S hS X F' d.U).obj (op V) →+
      (chartOpensKernel B S hS f ZT d.U V ⊗[(smallEtaleRingedTopos B S hS X).O.obj.obj
        (op ((chartOpens B S hS d.U).obj V))] F'.val.obj (op ((chartOpens B S hS d.U).obj V))) :=
  AddMonoidHom.mk' (fun c => AddMonoidHom.mk'
    (fun m => chartKernelRestr B S hS f ZT d V c ⊗ₜ
      (ULift.down (show ULift.{u} (F'.val.obj (op ((chartOpens B S hS d.U).obj V))) from m)))
    (fun _ _ => TensorProduct.tmul_add _ _ _))
    (fun c c' => AddMonoidHom.ext fun m =>
      (congrArg (· ⊗ₜ (ULift.down
        (show ULift.{u} (F'.val.obj (op ((chartOpens B S hS d.U).obj V))) from m)))
        (map_add (chartKernelRestr B S hS f ZT d V) c c')).trans (TensorProduct.add_tmul _ _ _))

/-- `chartBalancedTensor` sends `(c, m)` to the pure tensor of `chartKernelRestr` at `c` with the
section `m`. -/
theorem chartBalancedTensor_apply (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)] (V : (chartScheme d.U).Opens) (c : chartTargetIdeal B S hS ZT d)
    (m : (chartPresheafModule B S hS X F' d.U).obj (op V)) :
    chartBalancedTensor B S hS f ZT F' d V c m = chartKernelRestr B S hS f ZT d V c ⊗ₜ
      (ULift.down (show ULift.{u} (F'.val.obj (op ((chartOpens B S hS d.U).obj V))) from m)) :=
  rfl

/-- The balanced map `chartBalancedTensor` is balanced over the functions on the target chart. -/
theorem chartBalancedTensor_balanced (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)] (V : (chartScheme d.U).Opens)
    (r : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) (c : chartTargetIdeal B S hS ZT d)
    (m : (chartPresheafModule B S hS X F' d.U).obj (op V)) :
    chartBalancedTensor B S hS f ZT F' d V (r • c) m =
      chartBalancedTensor B S hS f ZT F' d V c
        ((show ((chartRingedSpace B S hS d.U).presheaf ⋙ forget₂ CommRingCat RingCat).obj (op V)
          from topRestr (O := (chartRingedSpace B S hS d.U).presheaf) V
            ((show (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤) →+*
              (chartRingedSpace B S hS d.U).presheaf.obj (op ⊤) from
                chartDiagramFunctionPullback B S hS d) r)) • m) := by
  have hκ : chartKernelRestr B S hS f ZT d V (r • c) =
      ((smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op
        (chartDiagramFunctionPullback B S hS d r)) • chartKernelRestr B S hS f ZT d V c :=
    Subtype.ext ((congrArg
      ((smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op).hom
        (map_mul (chartDiagramFunctionPullback B S hS d) r
          (c : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)))).trans (map_mul _ _ _))
  have hring : (show (ringSheaf (smallEtaleRingedTopos B S hS X).O).obj.obj
      (op ((chartOpens B S hS d.U).obj V)) from
        (chartRestrictionRingHom B S hS X.2 d.U).app (op V)
          ((chartScheme d.U).presheaf.map (homOfLE le_top).op
            (chartDiagramFunctionPullback B S hS d r))) =
      (show (ringSheaf (smallEtaleRingedTopos B S hS X).O).obj.obj
        (op ((chartOpens B S hS d.U).obj V)) from
          (smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op
            (chartDiagramFunctionPullback B S hS d r)) :=
    chartRestrictionRingHom_app_map_top B S hS X d.U V (chartDiagramFunctionPullback B S hS d r)
  have hm := congrArg (fun (a : (ringSheaf (smallEtaleRingedTopos B S hS X).O).obj.obj
      (op ((chartOpens B S hS d.U).obj V))) =>
        a • ULift.down (show ULift.{u} (F'.val.obj (op ((chartOpens B S hS d.U).obj V))) from m))
    hring
  exact (congrArg (· ⊗ₜ (ULift.down
      (show ULift.{u} (F'.val.obj (op ((chartOpens B S hS d.U).obj V))) from m))) hκ).trans
    ((TensorProduct.smul_tmul _ _ _).trans
      (congrArg (chartKernelRestr B S hS f ZT d V c ⊗ₜ ·) hm.symm))

/-- Restricting from the whole chart to a Zariski open `V`, read on the chart restriction. -/
theorem chartPresheafModule_map_top_up (F' : SheafOfModules.{u}
      (ringSheaf (smallEtaleRingedTopos B S hS X).O)) (A : SmallEtale B S hS X.1)
    (V : (chartScheme A).Opens) (x : F'.val.obj (op A)) :
    ULift.down (show ULift.{u} (F'.val.obj (op ((chartOpens B S hS A).obj V))) from
      (chartPresheafModule B S hS X F' A).map (homOfLE le_top).op
        (show (chartPresheafModule B S hS X F' A).obj (op ⊤) from
          ULift.up (restr F' (chartOpensTopHom B S hS X A).op x))) =
      restr F' (chartOpensHom B S hS X A V).op x := by
  change restr F' ((chartOpens B S hS A).map (homOfLE le_top)).op
    (restr F' (chartOpensTopHom B S hS X A).op x) = restr F' (chartOpensHom B S hS X A V).op x
  rw [Stacks.Sheaves.LocalGeneration.restr_restr, ← op_comp]
  exact congrArg (fun h => restr F' (Quiver.Hom.op h) x)
    (chartOpens_map_comp_chartOpensTopHom B S hS X A V)

attribute [-instance] Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule in
/-- **A relation with coefficients pulled back from the ideal of `Z_T` vanishes in the tensor
product near every point**, over an affine square of charts, for a module flat over `T`. -/
theorem exists_open_sum_chartKernelRestr_tmul_eq_zero (f : X ⟶ T)
    (ZT : ClosedSubspaces B S hS T.1)
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (hflat : IsFlatOver B S hS X.2 f.hom F') (d : ChartDiagram B S hS X.1 T.1 f.hom)
    [IsAffine (chartScheme d.U)] [IsAffine (chartScheme d.V)] {N : ℕ}
    (b : Fin N → chartTargetIdeal B S hS ZT d) (t' : Fin N → F'.val.obj (op d.U))
    (hrel₀ : ∑ k, chartDiagramFunctionPullback B S hS d
      (b k : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) • t' k = 0)
    (y : chartScheme d.U) :
    ∃ V : (chartScheme d.U).Opens, y ∈ V ∧
      ∑ k, chartKernelRestr B S hS f ZT d V (b k) ⊗ₜ[(smallEtaleRingedTopos B S hS X).O.obj.obj
          (op ((chartOpens B S hS d.U).obj V))]
        restr F' (chartOpensHom B S hS X d.U V).op (t' k) = 0 := by
  have hrel := chartPresheafModule_top_relation B S hS F' d.U
    (fun k => chartDiagramFunctionPullback B S hS d
      (b k : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))) t' hrel₀
  let α : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤) →+*
      (chartRingedSpace B S hS d.U).presheaf.obj (op ⊤) :=
    chartDiagramFunctionPullback B S hS d
  have hσ : ∀ r, chartDiagramGlobalToStalkRingHom B S hS d y r =
      (chartRingedSpace B S hS d.U).presheaf.germ ⊤ y trivial (α r) := fun r =>
    PresheafedSpace.stalkMap_germ_apply (chartDiagramShHom B S hS d).hom ⊤ y trivial r
  have key := exists_mem_sum_balanced_eq_zero_of_flat_stalk
    (chartPresheafModule B S hS X F' d.U) y α (chartDiagramGlobalToStalkRingHom B S hS d y) hσ
    (flat_chartStalk_of_isFlatOver B S hS f F' hflat d y) (chartTargetIdeal B S hS ZT d) b
    (fun k => ULift.up (restr F' (chartOpensTopHom B S hS X d.U).op (t' k))) hrel
  refine key.elim fun V hV => hV.elim fun hyV hβ => ⟨V, hyV, ?_⟩
  have hfin := hβ _ (chartBalancedTensor B S hS f ZT F' d V)
    (chartBalancedTensor_balanced B S hS f ZT F' d V)
  exact (Finset.sum_congr rfl fun k _ => congrArg (chartKernelRestr B S hS f ZT d V (b k) ⊗ₜ ·)
    (chartPresheafModule_map_top_up B S hS F' d.U V (t' k)).symm).trans hfin

/-- Restricting a combination of pulled back functions in the ideal of `Z_T`. -/
theorem kernelRestr_eq_sum_chartKernelRestr (f : X ⟶ T) (ZT : ClosedSubspaces B S hS T.1)
    (d : ChartDiagram B S hS X.1 T.1 f.hom) [IsAffine (chartScheme d.U)]
    [IsAffine (chartScheme d.V)] (V : (chartScheme d.U).Opens)
    (e : RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT))).fSharp.hom.app (op d.U)).hom)
    {m : ℕ} (c : Fin m → (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U))
    (bb : Fin m → chartTargetIdeal B S hS ZT d)
    (hsum : ∑ l, c l * chartDiagramFunctionPullback B S hS d
      (bb l : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) = e) :
    Deformation.ToposThickening.kernelRestr (smallEtaleRingedToposHom B S hS
        (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT)))
        (chartOpensHom B S hS X d.U V).op e =
      ∑ l, ((smallEtaleRingedTopos B S hS X).O.obj.map (chartOpensHom B S hS X d.U V).op (c l)) •
        chartKernelRestr B S hS f ZT d V (bb l) := by
  apply Subtype.ext
  refine Eq.trans ?_ (Submodule.coe_sum (chartOpensKernel B S hS f ZT d.U V) _ Finset.univ).symm
  refine ((congrArg ((smallEtaleRingedTopos B S hS X).O.obj.map
    (chartOpensHom B S hS X d.U V).op).hom hsum.symm).trans
      (map_sum _ _ _)).trans (Finset.sum_congr rfl fun l _ => ?_)
  exact map_mul _ _ _

/-- The chart vanishing statement, given the decomposition of the coefficients through the
ideal of `Z_T`. -/
theorem exists_open_sum_tmul_eq_zero_of_decomposition (f : X ⟶ T)
    (ZT : ClosedSubspaces B S hS T.1)
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (hflat : IsFlatOver B S hS X.2 f.hom F') (d : ChartDiagram B S hS X.1 T.1 f.hom)
    [IsAffine (chartScheme d.U)] [IsAffine (chartScheme d.V)] {n : ℕ}
    (ε : Fin n → RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT))).fSharp.hom.app (op d.U)).hom)
    (s : Fin n → F'.val.obj (op d.U))
    (hs : ∑ j, (ε j : (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U)) • s j = 0)
    (m : Fin n → ℕ) (c : ∀ j, Fin (m j) → (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U))
    (bb : ∀ j, Fin (m j) → chartTargetIdeal B S hS ZT d)
    (hsum : ∀ j, ∑ l, c j l * chartDiagramFunctionPullback B S hS d
      (bb j l : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) = ε j)
    (y : chartScheme d.U) :
    ∃ V : (chartScheme d.U).Opens, y ∈ V ∧
      ∑ j, Deformation.ToposThickening.kernelRestr (smallEtaleRingedToposHom B S hS
          (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT)))
          (chartOpensHom B S hS X d.U V).op (ε j) ⊗ₜ[(smallEtaleRingedTopos B S hS X).O.obj.obj
            (op ((chartOpens B S hS d.U).obj V))]
        restr F' (chartOpensHom B S hS X d.U V).op (s j) = 0 := by
  let e := Fintype.equivFin (Σ j, Fin (m j))
  let t' : (Σ j, Fin (m j)) → F'.val.obj (op d.U) := fun i => c i.1 i.2 • s i.1
  have hrel₀ : ∑ k, chartDiagramFunctionPullback B S hS d
      (bb (e.symm k).1 (e.symm k).2 : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) •
        t' (e.symm k) = 0 :=
    (Equiv.sum_comp e.symm (fun i => chartDiagramFunctionPullback B S hS d
      (bb i.1 i.2 : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤)) • t' i)).trans
      (sum_sigma_smul_smul_eq_zero m
        (fun j => (ε j : (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U))) s c
        (fun j l => chartDiagramFunctionPullback B S hS d
          (bb j l : (chartRingedSpace B S hS d.V).presheaf.obj (op ⊤))) hsum hs)
  refine (exists_open_sum_chartKernelRestr_tmul_eq_zero B S hS f ZT F' hflat d
    (fun k => bb (e.symm k).1 (e.symm k).2) (fun k => t' (e.symm k)) hrel₀ y).elim
      fun V hV => ⟨V, hV.1, ?_⟩
  refine (sum_tmul_eq_sum_sigma m _ _ _ _ fun j =>
    kernelRestr_eq_sum_chartKernelRestr B S hS f ZT d V (ε j) (c j) (bb j) (hsum j)).trans ?_
  refine Eq.trans ?_ ((Equiv.sum_comp e.symm (fun i => chartKernelRestr B S hS f ZT d V
    (bb i.1 i.2) ⊗ₜ restr F' (chartOpensHom B S hS X d.U V).op (t' i))).symm.trans hV.2)
  exact Finset.sum_congr rfl fun i _ =>
    congrArg (chartKernelRestr B S hS f ZT d V (bb i.1 i.2) ⊗ₜ ·)
      (F'.val.map_smul (chartOpensHom B S hS X d.U V).op (c i.1 i.2) (s i.1)).symm

/-- **Over an affine square of charts, a relation with coefficients in the ideal of `f⁻¹(Z_T)`
vanishes in the tensor product near every point**, for a module flat over `T`. -/
theorem exists_open_sum_tmul_eq_zero_of_isFlatOver (f : X ⟶ T)
    (ZT : ClosedSubspaces B S hS T.1)
    (F' : SheafOfModules.{u} (ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (hflat : IsFlatOver B S hS X.2 f.hom F') (d : ChartDiagram B S hS X.1 T.1 f.hom)
    [IsAffine (chartScheme d.U)] [IsAffine (chartScheme d.V)] {n : ℕ}
    (ε : Fin n → RingHom.ker ((smallEtaleRingedToposHom B S hS
      (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT))).fSharp.hom.app (op d.U)).hom)
    (s : Fin n → F'.val.obj (op d.U))
    (hs : ∑ j, (ε j : (smallEtaleRingedTopos B S hS X).O.obj.obj (op d.U)) • s j = 0)
    (y : chartScheme d.U) :
    ∃ V : (chartScheme d.U).Opens, y ∈ V ∧
      ∑ j, Deformation.ToposThickening.kernelRestr (smallEtaleRingedToposHom B S hS
          (subspaceInclusion B S hS X (preimageSubspace B S hS f ZT)))
          (chartOpensHom B S hS X d.U V).op (ε j) ⊗ₜ[(smallEtaleRingedTopos B S hS X).O.obj.obj
            (op ((chartOpens B S hS d.U).obj V))]
        restr F' (chartOpensHom B S hS X d.U V).op (s j) = 0 :=
  have hdec := fun j => exists_sum_mul_chartDiagramFunctionPullback_eq B S hS f ZT d (ε j)
  exists_open_sum_tmul_eq_zero_of_decomposition B S hS f ZT F' hflat d ε s hs
    (fun j => (hdec j).choose) (fun j => (hdec j).choose_spec.choose)
    (fun j => (hdec j).choose_spec.choose_spec.choose)
    (fun j => (hdec j).choose_spec.choose_spec.choose_spec) y

