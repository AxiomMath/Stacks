/-!
# A square-zero extension of the étale structure sheaf over an affine chart

Let `0 ⟶ ℐ ⟶ 𝒜 ⟶ 𝒪_X ⟶ 0` be a square-zero extension of the structure sheaf of an algebraic
space `X` on its small étale site, with `ℐ` quasi-coherent
(`AlgebraicGeometry.Space.SquareZeroExtension`, the data of Stacks 05ZT). This file proves the
first two steps of the source's proof of Stacks 05ZT. First, over every affine étale chart `U`
of `X` the sequence of sections

```
0 ⟶ ℐ(U) ⟶ 𝒜(U) ⟶ 𝒪_X(U) ⟶ 0
```

is exact, that is, `𝒜(U) ⟶ 𝒪_X(U)` is surjective. The source's reason is
`H¹(U_étale, ℐ) = 0` for the quasi-coherent `ℐ` on the affine `U`. Second, for a morphism
`V ⟶ U` of affine étale charts the ring map `𝒜(U) ⟶ 𝒜(V)` is étale, which is what makes
`U ↦ Spec 𝒜(U)` a functor to affine schemes and étale morphisms.

## Main definitions

* `AlgebraicGeometry.Space.SquareZeroExtension.kernelSequence`: the short complex of abelian
  sheaves `ℐ ⟶ 𝒜 ⟶ 𝒪_X` underlying the extension.

## Main results

* `AlgebraicGeometry.Space.SquareZeroExtension.kernelSequence_shortExact`: it is short exact.
* `AlgebraicGeometry.Space.SquareZeroExtension.surjective_π_app_of_isAffineChart`: the
  surjection `𝒜 ⟶ 𝒪_X` is surjective on the sections over every affine étale chart.
* `AlgebraicGeometry.Space.SquareZeroExtension.etale_map_of_isAffineChart`: the restriction
  map `𝒜(U) ⟶ 𝒜(V)` along a morphism of affine étale charts is étale.
* `IsBaseChange.ker_of_retraction`: a criterion for the kernel of `B' ⟶ B` to be the base
  change of the kernel of `A' ⟶ A`, in the form the étaleness argument supplies it.

## Implementation notes

The kernel is a sheaf of `𝒪_X`-modules and `𝒜` is not, so the sequence is formed in abelian
sheaves: `ℐ` through `SheafOfModules.toSheaf`, and `𝒜`, `𝒪_X` as the unit modules over
themselves. Exactness in the middle is proved by exhibiting `ℐ ⟶ 𝒜` as a kernel of `𝒜 ⟶ 𝒪_X`
with the `exact_kernel` field; surjectivity on affine charts is then Cohomology on Sites,
Lemma 03F8 (`Stacks.CechSite.surjective_on_sections_of_isZero_cechCohomology`) with the
vanishing of first Čech cohomology of a quasi-coherent module on a finite affine covering of an
affine chart (`AlgebraicGeometry.Space.isZero_cechCohomology_succ_of_isQuasicoherentOnSite`).

Étaleness is Algebra, Lemma 05YT (`Algebra.Etale.of_ker_sq_eq_bot_of_isBaseChange`), whose
base-change hypothesis is over `𝒜(U)`; quasi-coherence gives it over `𝒪_X(U)`, as bijectivity
of `𝒪_X(V) ⊗_{𝒪_X(U)} ℐ(U) ⟶ ℐ(V)`. The passage is `IsBaseChange.ker_of_retraction`: the
image of `ℐ(U)` generates `ℐ(V)`, so `j ⊗ k = 0` in `𝒜(V) ⊗_{𝒜(U)} ℐ(U)` for `j ∈ ℐ(V)` (the
kernel has square zero), which makes `o ⊗ m ↦ õ ⊗ m` independent of the lift `õ` of `o` and
hence an additive retraction of `𝒜(V) ⊗_{𝒜(U)} ℐ(U) ⟶ ℐ(V)`.

## References

* [Stacks Project, Tag 05ZT](https://stacks.math.columbia.edu/tag/05ZT)
* [Stacks Project, Tag 03F8](https://stacks.math.columbia.edu/tag/03F8)
* [Stacks Project, Tag 05YT](https://stacks.math.columbia.edu/tag/05YT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.SheafOfModules.Tensor (ringSheaf)
open scoped TensorProduct

universe u

/-! ### Two lemmas of commutative algebra -/

section Algebra

variable {A' A B' B : Type*} [CommRing A'] [CommRing A] [CommRing B'] [CommRing B]
  [Algebra A' B']

/-- If `K` is an ideal of square zero of `A'`, then `b ⊗ k = 0` in `B' ⊗[A'] K` for every `b` in
the ideal of `B'` generated by `K`. -/
theorem _root_.Ideal.tmul_eq_zero_of_mem_span_image (K : Ideal A') (hK : K ^ 2 = ⊥) {b : B'}
    (hb : b ∈ Submodule.span B' (algebraMap A' B' '' K)) (k : K) :
    (b ⊗ₜ[A'] k : B' ⊗[A'] K) = 0 := by
  induction hb using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    have h : a * (k : A') ∈ K ^ 2 := sq K ▸ Ideal.mul_mem_mul ha k.2
    rw [hK, Submodule.mem_bot] at h
    have hak : a • k = 0 := Subtype.ext h
    rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, hak, TensorProduct.tmul_zero]
  | zero => exact TensorProduct.zero_tmul _ _
  | add x y _ _ hx hy => rw [TensorProduct.add_tmul, hx, hy, add_zero]
  | smul c x _ hx => rw [← TensorProduct.smul_tmul', hx, smul_zero]

/-- A criterion for the kernel of a surjection `B' ⟶ B` to be the base change of the kernel of
`A' ⟶ A`: the image of the latter generates the former, and the canonical map
`B' ⊗[A'] ker ⟶ ker` has an additive retraction. -/
theorem _root_.IsBaseChange.ker_of_retraction (πA : A' →+* A) (πB : B' →+* B)
    (κ : RingHom.ker πA →ₗ[A'] RingHom.ker πB)
    (hκ : ∀ x, (κ x : B') = algebraMap A' B' (x : A'))
    (hgen : ∀ j ∈ RingHom.ker πB, j ∈ Submodule.span B' (algebraMap A' B' '' RingHom.ker πA))
    (Θ : RingHom.ker πB →+ B' ⊗[A'] RingHom.ker πA)
    (hΘ : ∀ (b : B') (x : RingHom.ker πA), Θ (b • κ x) = b ⊗ₜ x) :
    IsBaseChange B' κ := by
  refine ⟨fun t t' htt' => ?_, fun j => ?_⟩
  · have hret : ∀ t, Θ (κ.liftBaseChange B' t) = t := by
      intro t
      induction t using TensorProduct.inductionOn with
      | tmul b x => rw [LinearMap.liftBaseChange_tmul, hΘ]
      | add t t' ht ht' => rw [map_add, map_add, ht, ht']
    exact (hret t).symm.trans ((congrArg Θ htt').trans (hret t'))
  · have key : ∀ y ∈ Submodule.span B' (algebraMap A' B' '' RingHom.ker πA),
        ∃ t, ((κ.liftBaseChange B' t : RingHom.ker πB) : B') = y := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        refine ⟨1 ⊗ₜ ⟨a, ha⟩, ?_⟩
        rw [LinearMap.liftBaseChange_tmul, one_smul, hκ]
      | zero => exact ⟨0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨t, ht⟩ := hx
        obtain ⟨t', ht'⟩ := hy
        exact ⟨t + t', by rw [map_add, Submodule.coe_add, ht, ht']⟩
      | smul c x _ hx =>
        obtain ⟨t, ht⟩ := hx
        exact ⟨c • t, by rw [map_smul, Submodule.coe_smul, ht, smul_eq_mul]⟩
    exact (key j (hgen j j.2)).imp fun _ => Subtype.ext

end Algebra

namespace AlgebraicGeometry.Space.SquareZeroExtension

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {X Y : AlgebraicSpaces B S hS} {f : X ⟶ Y} (E : SquareZeroExtension B S hS f)

/-- The kernel `ℐ` of the extension, as an abelian sheaf. -/
abbrev kernelSheaf : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u} :=
  (SheafOfModules.toSheaf (ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)).obj E.I

/-- The extension sheaf `𝒜`, as an abelian sheaf. -/
abbrev extensionSheaf : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u} :=
  (SheafOfModules.toSheaf (ringSheaf E.A)).obj (SheafOfModules.unit (ringSheaf E.A))

/-- The structure sheaf `𝒪_X`, as an abelian sheaf. -/
abbrev structureAddSheaf : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u} :=
  (SheafOfModules.toSheaf (ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)).obj
    (SheafOfModules.unit (ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O))

/-- The inclusion `ℐ ⟶ 𝒜` of abelian sheaves. -/
def kernelInclusion : E.kernelSheaf ⟶ E.extensionSheaf :=
  ⟨{ app U := AddCommGrpCat.ofHom (E.ι U)
     naturality := fun U V i => by
       ext x
       exact E.naturality i x }⟩

/-- The surjection `𝒜 ⟶ 𝒪_X` of abelian sheaves. -/
def quotientMap : E.extensionSheaf ⟶ structureAddSheaf (X := X) :=
  ⟨{ app U := AddCommGrpCat.ofHom (E.π.hom.app U).hom.toAddMonoidHom
     naturality := fun U V i => by
       ext x
       exact congrFun (congrArg (fun q => q.hom) (E.π.hom.naturality i)) x }⟩

/-- The composite `ℐ ⟶ 𝒜 ⟶ 𝒪_X` of abelian sheaves is zero. -/
theorem kernelInclusion_quotientMap : E.kernelInclusion ≫ E.quotientMap = 0 := by
  ext U x
  exact E.mem_kernel U x

/-- The inclusion `ℐ ⟶ 𝒜` of abelian sheaves is a monomorphism. -/
theorem mono_kernelInclusion : Mono E.kernelInclusion := by
  constructor
  intro Z g h hgh
  apply (sheafToPresheaf _ _).map_injective
  ext U x
  exact injective_ι B S hS E U (congrArg (fun q => q.hom.app U x) hgh)

/-- If a map `q : Z ⟶ 𝒜` of abelian sheaves composes to zero with `𝒜 ⟶ 𝒪_X`, then every section
of `Z` is sent by `q` to a section of `𝒜` killed by `𝒜 ⟶ 𝒪_X`. -/
theorem quotientMap_app_kernel {Z : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u}}
    (q : Z ⟶ E.extensionSheaf) (hq : q ≫ E.quotientMap = 0) (U : (SmallEtale B S hS X.1)ᵒᵖ)
    (z : Z.obj.obj U) : (E.π.hom.app U).hom (q.hom.app U z) = 0 :=
  congrArg (fun t => t.hom.app U z) hq

/-- The section of `ℐ` through which a section of `𝒜` killed by `𝒜 ⟶ 𝒪_X` factors. -/
def kernelLiftApp {Z : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u}}
    (q : Z ⟶ E.extensionSheaf) (hq : q ≫ E.quotientMap = 0) (U : (SmallEtale B S hS X.1)ᵒᵖ)
    (z : Z.obj.obj U) : E.I.val.obj U :=
  Classical.choose (E.exact_kernel U _ (E.quotientMap_app_kernel q hq U z))

/-- The section `kernelLiftApp q hq U z` of `ℐ` maps to `q z` in `𝒜`. -/
theorem ι_kernelLiftApp {Z : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u}}
    (q : Z ⟶ E.extensionSheaf) (hq : q ≫ E.quotientMap = 0) (U : (SmallEtale B S hS X.1)ᵒᵖ)
    (z : Z.obj.obj U) : E.ι U (E.kernelLiftApp q hq U z) = q.hom.app U z :=
  (Classical.choose_spec (E.exact_kernel U _ (E.quotientMap_app_kernel q hq U z))).1

/-- The factorization through `ℐ` of a map of abelian sheaves into `𝒜` killed by `𝒜 ⟶ 𝒪_X`. -/
def kernelLift {Z : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u}}
    (q : Z ⟶ E.extensionSheaf) (hq : q ≫ E.quotientMap = 0) : Z ⟶ E.kernelSheaf :=
  ⟨{ app U := AddCommGrpCat.ofHom
      { toFun := E.kernelLiftApp q hq U
        map_zero' := injective_ι B S hS E U (by
          rw [E.ι_kernelLiftApp, map_zero, map_zero]
          rfl)
        map_add' := fun z w => injective_ι B S hS E U (by
          rw [E.ι_kernelLiftApp, map_add, map_add, E.ι_kernelLiftApp, E.ι_kernelLiftApp]
          rfl) }
     naturality := fun U V i => by
       ext z
       apply injective_ι B S hS E V
       change E.ι V (E.kernelLiftApp q hq V (Z.obj.map i z)) =
         E.ι V (E.I.val.map i (E.kernelLiftApp q hq U z))
       rw [E.naturality i, E.ι_kernelLiftApp, E.ι_kernelLiftApp]
       exact congrFun (congrArg (fun t => t.hom) (q.hom.naturality i)) z }⟩

/-- The factorization `kernelLift q hq` composed with `ℐ ⟶ 𝒜` is `q`. -/
theorem kernelLift_fac {Z : Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u}}
    (q : Z ⟶ E.extensionSheaf) (hq : q ≫ E.quotientMap = 0) :
    E.kernelLift q hq ≫ E.kernelInclusion = q := by
  apply (sheafToPresheaf _ _).map_injective
  ext U z
  exact E.ι_kernelLiftApp q hq U z

/-- `ℐ ⟶ 𝒜` is a kernel of `𝒜 ⟶ 𝒪_X` in abelian sheaves. -/
def kernelInclusionIsKernel :
    IsLimit (KernelFork.ofι (f := E.quotientMap) E.kernelInclusion
      E.kernelInclusion_quotientMap) :=
  KernelFork.IsLimit.ofι _ _ E.kernelLift E.kernelLift_fac
    (fun q hq _ hr => E.mono_kernelInclusion.right_cancellation _ _
      (hr.trans (E.kernelLift_fac q hq).symm))

/-- **The short complex `ℐ ⟶ 𝒜 ⟶ 𝒪_X` of abelian sheaves** underlying the extension. -/
abbrev kernelSequence : ShortComplex (Sheaf (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u}) :=
  ShortComplex.mk E.kernelInclusion E.quotientMap E.kernelInclusion_quotientMap

/-- The surjection `𝒜 ⟶ 𝒪_X` of abelian sheaves is an epimorphism. -/
theorem epi_quotientMap : Epi E.quotientMap := by
  have htype : Presheaf.IsLocallySurjective (SmallEtale.topology B S hS X.1)
      (Functor.whiskerRight E.quotientMap.hom (forget AddCommGrpCat.{u})) := by
    change Presheaf.IsLocallySurjective _ (Functor.whiskerRight E.π.hom (forget CommRingCat.{u}))
    exact (Presheaf.isLocallySurjective_iff_whisker_forget _ E.π.hom).mp E.locallySurjective_π
  have : Sheaf.IsLocallySurjective E.quotientMap :=
    (Presheaf.isLocallySurjective_iff_whisker_forget _ E.quotientMap.hom).mpr htype
  exact Sheaf.epi_of_isLocallySurjective E.quotientMap

/-- **The sequence `0 ⟶ ℐ ⟶ 𝒜 ⟶ 𝒪_X ⟶ 0` of abelian sheaves is short exact.** -/
theorem kernelSequence_shortExact : E.kernelSequence.ShortExact :=
  ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ E.kernelInclusionIsKernel)
    E.mono_kernelInclusion E.epi_quotientMap

/-- **The first step of the proof of Stacks 05ZT.** Over an affine étale chart `U` of `X`,
the surjection `𝒜 ⟶ 𝒪_X` of a square-zero extension with quasi-coherent kernel is surjective on
sections, so that `0 ⟶ ℐ(U) ⟶ 𝒜(U) ⟶ 𝒪_X(U) ⟶ 0` is exact.

This is Cohomology on Sites, Lemma 03F8, applied to `E.kernelSequence` with the finite affine
covering families of `U`, on which the first Čech cohomology of the quasi-coherent `ℐ`
vanishes. -/
theorem surjective_π_app_of_isAffineChart (W : SmallEtale B S hS X.1)
    (hW : IsAffineChart B S hS X.1 W) :
    Function.Surjective (E.π.hom.app (op W)) := by
  have hfl : HasFiniteLimits (Over W) := hasFiniteLimits_of_hasTerminal_and_pullbacks
  exact Stacks.CechSite.surjective_on_sections_of_isZero_cechCohomology.{u, u, u + 1, u}
    (SmallEtale.topology B S hS X.1) _ E.kernelSequence_shortExact W
    {E' : PreZeroHypercover.{u} W | Finite E'.I₀ ∧ (∀ i, IsAffineChart B S hS X.1 (E'.X i)) ∧
      E'.sieve₀ ∈ SmallEtale.topology B S hS X.1 W}
    (fun _ hE ↦ hE.2.2)
    (fun R hR ↦ SmallEtale.exists_finite_affine_preZeroHypercover_univ W hW R hR)
    (fun _ _ _ _ ↦ inferInstance)
    (fun E' hE' ↦ isZero_cechCohomology_succ_of_isQuasicoherentOnSite B S hS X.1 X.2 E.I
      E.quasicoherent W hW E' hE'.1 hE'.2.1 hE'.2.2 1 one_pos)

/-- Over every étale `U`, the kernel of `𝒜(U) ⟶ 𝒪_X(U)` has square zero. -/
theorem ker_π_app_sq_eq_bot (U : (SmallEtale B S hS X.1)ᵒᵖ) :
    RingHom.ker (E.π.hom.app U).hom ^ 2 = ⊥ := by
  rw [sq, eq_bot_iff, Submodule.mul_le]
  exact fun a ha b hb => Ideal.mem_bot.2 (E.mul_eq_zero_of_mem_ker U a b ha hb)

/-! ### The ring map between two affine charts is étale -/

section Etale

variable {U V : SmallEtale B S hS X.1} (hU : IsAffineChart B S hS X.1 U)
  (hV : IsAffineChart B S hS X.1 V) (g : V ⟶ U)

/-- A chosen lift to `𝒜(V)` of a section of `𝒪_X` over an affine chart `V`. -/
def liftSection (o : chartRing B S hS X.1 X.2 V) : E.A.obj.obj (op V) :=
  Classical.choose (E.surjective_π_app_of_isAffineChart V hV o)

/-- The lift `liftSection hV o` maps to `o` under `𝒜(V) ⟶ 𝒪_X(V)`. -/
theorem π_liftSection (o : chartRing B S hS X.1 X.2 V) :
    E.π.hom.app (op V) (E.liftSection hV o) = o :=
  Classical.choose_spec (E.surjective_π_app_of_isAffineChart V hV o)

/-- Over an affine chart, the `𝒪_X`-action on the kernel is multiplication by a chosen lift. -/
theorem ι_smul (o : chartRing B S hS X.1 X.2 V) (y : E.I.val.obj (op V)) :
    E.ι (op V) (o • y) = E.liftSection hV o * E.ι (op V) y := by
  have h := E.smul_lift (op V) (E.liftSection hV o) y
  rwa [E.π_liftSection hV o] at h

/-- Over any chart, the `𝒪_X`-action on the kernel is multiplication by any lift. -/
theorem ι_smul_π (a : E.A.obj.obj (op V)) (o : chartRing B S hS X.1 X.2 V)
    (ho : E.π.hom.app (op V) a = o) (y : E.I.val.obj (op V)) :
    E.ι (op V) (o • y) = a * E.ι (op V) y :=
  ho ▸ E.smul_lift (op V) a y

/-- The section of `ℐ` over `W`, as a section of `ker (𝒜(W) → 𝒪_X(W))`. -/
private def kerι (W : SmallEtale B S hS X.1) :
    E.I.val.obj (op W) →+ RingHom.ker (E.π.hom.app (op W)).hom where
  toFun y := ⟨E.ι (op W) y, E.mem_kernel (op W) y⟩
  map_zero' := Subtype.ext (E.ι (op W)).map_zero
  map_add' := fun y y' => Subtype.ext ((E.ι (op W)).map_add y y')

/-- The map `ℐ(W) ⟶ ker (𝒜(W) → 𝒪_X(W))` is bijective. -/
private theorem bijective_kerι (W : SmallEtale B S hS X.1) : Function.Bijective (E.kerι W) :=
  ⟨fun _ _ h => injective_ι B S hS E (op W) (congrArg Subtype.val h),
    fun j => (E.exists_ι_eq (op W) j.1 j.2).imp fun _ => Subtype.ext⟩

include hU hV in
/-- **The kernel over `V` is generated by the kernel over `U`.** For a morphism `V ⟶ U` of affine
étale charts, `ker (𝒜(V) → 𝒪_X(V))` is the ideal generated by the image of
`ker (𝒜(U) → 𝒪_X(U))`: by quasi-coherence `ℐ(V) = 𝒪_X(V) ⊗_{𝒪_X(U)} ℐ(U)` (Descent,
Proposition 03DX(2)). -/
theorem ker_le_map_ker_of_isAffineChart :
    RingHom.ker (E.π.hom.app (op V)).hom ≤
      Ideal.map (E.A.obj.map g.op).hom (RingHom.ker (E.π.hom.app (op U)).hom) := by
  classical
  let πU : E.A.obj.obj (op U) →+* chartRing B S hS X.1 X.2 U := (E.π.hom.app (op U)).hom
  let φ := (E.A.obj.map g.op).hom
  let : Algebra (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) :=
    chartAlgebra (hF := X.2) g
  intro j hj
  change j ∈ Submodule.span (E.A.obj.obj (op V)) (φ '' RingHom.ker πU)
  obtain ⟨y, rfl⟩ := E.exists_ι_eq (op V) j hj
  obtain ⟨t, rfl⟩ := (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 E.I
    E.quasicoherent U V hU hV g).2 y
  let L := (E.ι (op V)).comp (sectionsBaseChange E.I g).toAddMonoidHom
  change L t ∈ _
  induction t using TensorProduct.inductionOn with
  | tmul o m =>
    change E.ι (op V) (sectionsBaseChange E.I g (o ⊗ₜ m)) ∈ _
    rw [chartBaseChange_tmul, E.ι_smul hV]
    exact Submodule.smul_mem _ (E.liftSection hV o)
      (Submodule.subset_span ⟨_, E.mem_kernel (op U) m, (E.naturality g.op m).symm⟩)
  | add t t' ht ht' =>
    rw [map_add]
    exact Submodule.add_mem _ (ht (E.mem_kernel _ _)) (ht' (E.mem_kernel _ _))

include hU hV in
/-- Over a morphism `V ⟶ U` of affine étale charts, `b ⊗ k` in `𝒜(V) ⊗_{𝒜(U)} ker (𝒜(U) → 𝒪_X(U))`
only depends on the image of `b` in `𝒪_X(V)`. -/
theorem tmul_eq_tmul_of_π_eq_of_isAffineChart :
    letI : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := (E.A.obj.map g.op).hom.toAlgebra
    ∀ b b' : E.A.obj.obj (op V), (E.π.hom.app (op V)).hom b = (E.π.hom.app (op V)).hom b' →
      ∀ k : RingHom.ker (E.π.hom.app (op U)).hom,
        (b ⊗ₜ[E.A.obj.obj (op U)] k :
          E.A.obj.obj (op V) ⊗[E.A.obj.obj (op U)] RingHom.ker (E.π.hom.app (op U)).hom) =
          b' ⊗ₜ k := by
  let : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := (E.A.obj.map g.op).hom.toAlgebra
  intro b b' hbb' k
  rw [← sub_eq_zero, ← TensorProduct.sub_tmul]
  exact Ideal.tmul_eq_zero_of_mem_span_image _ (E.ker_π_app_sq_eq_bot (op U))
    (E.ker_le_map_ker_of_isAffineChart hU hV g
      (by rw [RingHom.mem_ker, map_sub, hbb', sub_self])) k

include hU hV in
/-- Over a morphism `V ⟶ U` of affine étale charts, `o ⊗ m ↦ ã ⊗ m`, for `ã` any lift of `o` to
`𝒜(V)`, is a well-defined additive map `𝒪_X(V) ⊗_{𝒪_X(U)} ℐ(U) ⟶ 𝒜(V) ⊗_{𝒜(U)} ℐ(U)`. -/
theorem exists_tensorLift_of_isAffineChart :
    letI : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := (E.A.obj.map g.op).hom.toAlgebra
    letI : Algebra (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) :=
      chartAlgebra (hF := X.2) g
    ∃ Ψ : chartRing B S hS X.1 X.2 V ⊗[chartRing B S hS X.1 X.2 U] E.I.val.obj (op U) →+
        E.A.obj.obj (op V) ⊗[E.A.obj.obj (op U)] RingHom.ker (E.π.hom.app (op U)).hom,
      ∀ o m, Ψ (o ⊗ₜ m) = E.liftSection hV o ⊗ₜ[E.A.obj.obj (op U)]
        (⟨E.ι (op U) m, E.mem_kernel (op U) m⟩ : RingHom.ker (E.π.hom.app (op U)).hom) := by
  let : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := (E.A.obj.map g.op).hom.toAlgebra
  let : Algebra (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) :=
    chartAlgebra (hF := X.2) g
  let πU : E.A.obj.obj (op U) →+* chartRing B S hS X.1 X.2 U := (E.π.hom.app (op U)).hom
  let πV : E.A.obj.obj (op V) →+* chartRing B S hS X.1 X.2 V := (E.π.hom.app (op V)).hom
  let φ := (E.A.obj.map g.op).hom
  let ρ := chartRestrict (hF := X.2) g
  have hnat : πV.comp φ = ρ.comp πU := congrArg CommRingCat.Hom.hom (E.π.hom.naturality g.op)
  have hA : Function.Surjective πU := E.surjective_π_app_of_isAffineChart U hU
  have hdiff := E.tmul_eq_tmul_of_π_eq_of_isAffineChart hU hV g
  let ιU : E.I.val.obj (op U) →+ RingHom.ker πU := E.kerι U
  let Ψ₀ : chartRing B S hS X.1 X.2 V →+ E.I.val.obj (op U) →+
      E.A.obj.obj (op V) ⊗[E.A.obj.obj (op U)] RingHom.ker πU :=
    AddMonoidHom.mk' (fun o => AddMonoidHom.mk' (fun m => E.liftSection hV o ⊗ₜ ιU m)
      (fun m m' => by
        rw [map_add]
        exact TensorProduct.tmul_add _ _ _))
      (fun o o' => AddMonoidHom.ext fun m => by
        change E.liftSection hV (o + o') ⊗ₜ ιU m =
          E.liftSection hV o ⊗ₜ ιU m + E.liftSection hV o' ⊗ₜ ιU m
        rw [← TensorProduct.add_tmul]
        refine hdiff _ _ ?_ _
        rw [map_add]
        exact (E.π_liftSection hV _).trans
          (congrArg₂ (· + ·) (E.π_liftSection hV o) (E.π_liftSection hV o')).symm)
  refine ⟨TensorProduct.liftAddHom Ψ₀ ?_, fun _ _ => rfl⟩
  intro r o m
  change E.liftSection hV (r • o) ⊗ₜ ιU m = E.liftSection hV o ⊗ₜ ιU (r • m)
  obtain ⟨r', rfl⟩ := hA r
  have hm : ιU (πU r' • m) = r' • ιU m :=
    Subtype.ext (E.ι_smul_π (V := U) r' _ rfl m)
  rw [hm, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
  refine hdiff _ _ ?_ _
  change πV (E.liftSection hV (ρ (πU r') * o)) = πV (φ r' * E.liftSection hV o)
  have e3 : πV (φ r') = ρ (πU r') := congrArg (fun h => h r') hnat
  rw [map_mul, e3]
  exact (E.π_liftSection hV _).trans (congrArg (ρ (πU r') * ·) (E.π_liftSection hV o).symm)

include hU hV in
/-- **The kernel over `V` is the base change of the kernel over `U`.** For a morphism `V ⟶ U` of
affine étale charts of `X`, every `𝒜(U)`-linear map `ker (𝒜(U) → 𝒪_X(U)) → ker (𝒜(V) → 𝒪_X(V))`
lifting the restriction `𝒜(U) ⟶ 𝒜(V)` is a base change along it: `ℐ(V) = 𝒜(V) ⊗_{𝒜(U)} ℐ(U)`.
This is the kernel hypothesis of Algebra, Lemma 05YT in the proof of Stacks 05ZT, obtained from
`ℐ(V) = 𝒪_X(V) ⊗_{𝒪_X(U)} ℐ(U)` (Descent, Proposition 03DX(2)). -/
theorem isBaseChange_ker_of_isAffineChart :
    letI : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := (E.A.obj.map g.op).hom.toAlgebra
    ∀ κ : RingHom.ker (E.π.hom.app (op U)).hom →ₗ[E.A.obj.obj (op U)]
        RingHom.ker (E.π.hom.app (op V)).hom,
      (∀ x, (κ x : E.A.obj.obj (op V)) = (E.A.obj.map g.op).hom (x : E.A.obj.obj (op U))) →
        IsBaseChange (E.A.obj.obj (op V)) κ := by
  intro κ hκ
  let : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := (E.A.obj.map g.op).hom.toAlgebra
  classical
  let πU : E.A.obj.obj (op U) →+* chartRing B S hS X.1 X.2 U := (E.π.hom.app (op U)).hom
  let πV : E.A.obj.obj (op V) →+* chartRing B S hS X.1 X.2 V := (E.π.hom.app (op V)).hom
  let : Algebra (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) :=
    chartAlgebra (hF := X.2) g
  have hcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 E.I
    E.quasicoherent U V hU hV g
  obtain ⟨Ψ, hΨ⟩ := E.exists_tensorLift_of_isAffineChart hU hV g
  let eV := AddEquiv.ofBijective (E.kerι V) (E.bijective_kerι V)
  let := chartSectionsModule E.I g
  let eC := AddEquiv.ofBijective (sectionsBaseChange E.I g).toAddMonoidHom hcart
  let Θ : RingHom.ker πV →+ E.A.obj.obj (op V) ⊗[E.A.obj.obj (op U)] RingHom.ker πU :=
    Ψ.comp (eC.symm.toAddMonoidHom.comp eV.symm.toAddMonoidHom)
  have hΘ : ∀ (b : E.A.obj.obj (op V)) (x : RingHom.ker πU), Θ (b • κ x) = b ⊗ₜ x := by
    intro b x
    obtain ⟨m, rfl⟩ := (E.bijective_kerι U).2 x
    have h1 : eV.symm (b • κ (E.kerι U m)) = sectionsBaseChange E.I g (πV b ⊗ₜ m) := by
      refine (AddEquiv.symm_apply_eq eV).2 (Subtype.ext ?_)
      change b * (κ (E.kerι U m) : E.A.obj.obj (op V)) =
        E.ι (op V) (πV b • chartRestrictLinear E.I g m)
      exact (congrArg (b * ·) ((hκ (E.kerι U m)).trans (E.naturality g.op m).symm)).trans
        (E.ι_smul_π b (πV b) rfl (chartRestrictLinear E.I g m)).symm
    change Ψ (eC.symm (eV.symm (b • κ (E.kerι U m)))) = b ⊗ₜ E.kerι U m
    rw [h1]
    exact (congrArg Ψ (eC.symm_apply_apply _)).trans <| (hΨ _ _).trans
      (E.tmul_eq_tmul_of_π_eq_of_isAffineChart hU hV g _ _ (E.π_liftSection hV _) _)
  exact IsBaseChange.ker_of_retraction πU πV κ hκ
    (fun j hj => E.ker_le_map_ker_of_isAffineChart hU hV g hj) Θ hΘ

include hU hV in
/-- **The second step of the proof of Stacks 05ZT.** For a morphism `V ⟶ U` of affine étale
charts of `X`, the restriction map `𝒜(U) ⟶ 𝒜(V)` of a square-zero extension with
quasi-coherent kernel is étale.

The source's argument: `𝒜(U) ⟶ 𝒪_X(U)` and `𝒜(V) ⟶ 𝒪_X(V)` are surjective with square-zero
kernels `ℐ(U)`, `ℐ(V)` (`surjective_π_app_of_isAffineChart`), the map `𝒪_X(U) ⟶ 𝒪_X(V)` is
étale, and `ℐ(V) = ℐ(U) ⊗_{𝒪_X(U)} 𝒪_X(V)` by quasi-coherence (Descent, Proposition 03DX(2),
`isCartesianOnAffineCharts_of_isQuasicoherentOnSite`); so Algebra, Lemma 05YT applies
(`Algebra.Etale.of_ker_sq_eq_bot_of_isBaseChange`). -/
theorem etale_map_of_isAffineChart : (E.A.obj.map g.op).hom.Etale := by
  classical
  let πU : E.A.obj.obj (op U) →+* chartRing B S hS X.1 X.2 U := (E.π.hom.app (op U)).hom
  let πV : E.A.obj.obj (op V) →+* chartRing B S hS X.1 X.2 V := (E.π.hom.app (op V)).hom
  let φ := (E.A.obj.map g.op).hom
  let ρ := chartRestrict (hF := X.2) g
  have hnat : πV.comp φ = ρ.comp πU := congrArg CommRingCat.Hom.hom (E.π.hom.naturality g.op)
  let : Algebra (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) := φ.toAlgebra
  let : Algebra (E.A.obj.obj (op U)) (chartRing B S hS X.1 X.2 U) := πU.toAlgebra
  let : Algebra (E.A.obj.obj (op V)) (chartRing B S hS X.1 X.2 V) := πV.toAlgebra
  let : Algebra (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) :=
    chartAlgebra (hF := X.2) g
  let : Algebra (E.A.obj.obj (op U)) (chartRing B S hS X.1 X.2 V) := (πV.comp φ).toAlgebra
  have : IsScalarTower (E.A.obj.obj (op U)) (chartRing B S hS X.1 X.2 U)
      (chartRing B S hS X.1 X.2 V) := IsScalarTower.of_algebraMap_eq' hnat
  have : IsScalarTower (E.A.obj.obj (op U)) (E.A.obj.obj (op V))
      (chartRing B S hS X.1 X.2 V) := IsScalarTower.of_algebraMap_eq' rfl
  have : Algebra.Etale (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) := by
    have : IsAffine (chartScheme U) := hU
    have : IsAffine (chartScheme V) := hV
    exact HasRingHomProperty.appTop @Etale (chartSchemeMap g)
      (etale_toScheme_toOver_map B S hS X.1 g)
  have hA : Function.Surjective πU := E.surjective_π_app_of_isAffineChart U hU
  have hB : Function.Surjective πV := E.surjective_π_app_of_isAffineChart V hV
  have hI : RingHom.ker πU ^ 2 = ⊥ := E.ker_π_app_sq_eq_bot (op U)
  let κ : RingHom.ker πU →ₗ[E.A.obj.obj (op U)] RingHom.ker πV :=
    { toFun := fun x => ⟨φ x.1, by
        rw [RingHom.mem_ker]
        change (πV.comp φ) x.1 = 0
        rw [hnat, RingHom.comp_apply, RingHom.mem_ker.mp x.2, map_zero]⟩
      map_add' := fun x y => Subtype.ext (map_add φ x.1 y.1)
      map_smul' := fun a x => Subtype.ext (map_mul φ a x.1) }
  have hκ : ∀ x, (κ x : E.A.obj.obj (op V)) =
      algebraMap (E.A.obj.obj (op U)) (E.A.obj.obj (op V)) (x : E.A.obj.obj (op U)) :=
    fun _ => rfl
  exact RingHom.etale_algebraMap.2 (Algebra.Etale.of_ker_sq_eq_bot_of_isBaseChange hA hB hI κ hκ
    (E.isBaseChange_ker_of_isAffineChart hU hV g κ hκ))

end Etale

end AlgebraicGeometry.Space.SquareZeroExtension

