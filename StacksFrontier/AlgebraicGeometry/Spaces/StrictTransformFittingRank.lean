      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away g) g)

/-! #### From pointwise chart data to the rank of a quotient -/

/-- Let `M` be an `𝒪_X`-module and `K` a sheaf submodule, both cartesian on affine charts, such
that the projection onto the cokernel of `K ⟶ M` is surjective on sections over affine charts and
`M` satisfies `AlgebraicGeometry.Space.IsChartwiseFreeAwayFromPrincipalFitting`.  Suppose that
through every point of every chart some affine chart carries a nonzerodivisor `g` generating the
`k`-th Fitting ideal of the sections of `M`, with the sections of `K` the `g`-power torsion.  Then
the cokernel of `K ⟶ M` is finite locally free of rank `k`. -/
theorem isFiniteLocallyFreeOfRank_cokernel_of_pointwise_principal_fitting
    (X : AlgebraicSpaces B S hS) (M : Modules.{u, u} B S hS X.1 X.2) (K : M.Submodule) (k : ℕ)
    (hMcart : IsCartesianOnAffineCharts M)
    (hKcart : IsCartesianOnAffineCharts K.toSheafOfModules)
    (hcoker : HasAffineChartCokernelSurjectivity B S hS K)
    (hfree : IsChartwiseFreeAwayFromPrincipalFitting B S hS M k)
    (hpt : ∀ (W : SmallEtale B S hS X.1) (z : chartScheme W),
      ∃ (V : SmallEtale B S hS X.1) (m : V ⟶ W) (g : chartRing B S hS X.1 X.2 V)
        (hfin : Module.Finite (chartRing B S hS X.1 X.2 V) (M.val.obj (op V))),
        IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V) ∧
        g ∈ nonZeroDivisors (chartRing B S hS X.1 X.2 V) ∧
        @fittingIdealOnChart B S hS X.1 X.2 M k V hfin = Ideal.span {g} ∧
        (∀ s : M.val.obj (op V), s ∈ K.toSubmodule.obj (op V) ↔
          s ∈ Ideal.primaryComponent (M.val.obj (op V)) (Ideal.span {g})) ∧
        ∃ z' : chartScheme V, (BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map m) z' = z) :
    RingedSite.IsFiniteLocallyFreeOfRank (smallEtaleRingedSite B S hS X.1 X.2)
      (cokernel K.ι) k := by
  have hcart : IsCartesianOnAffineCharts (cokernel K.ι) :=
    isCartesianOnAffineCharts_cokernel K.ι (cokernel.π K.ι) hcoker
      (fun V _ ↦ exact_app_cokernel_π B S hS K V) hKcart hMcart
  refine isFiniteLocallyFreeOfRank_of_freeRankPresieve B S hS X.1 X.2 (cokernel K.ι) hcart k
    fun W ↦ ?_
  refine smallEtale_sieve_of_pointwise_covering B S hS X.1 W _ fun z ↦ ?_
  obtain ⟨V, m, g, hfin, hVaff, hreg, hfit, hK, z', hz'⟩ := hpt W z
  refine ⟨V, m, ⟨V, 𝟙 _, m, ⟨hVaff, ?_⟩, Category.id_comp m⟩, z', hz'⟩
  have := hfin
  have hrangeK : ∀ s : M.val.obj (op V),
      s ∈ Set.range (K.ι.val.app (op V)) ↔ s ∈ K.toSubmodule.obj (op V) :=
    fun s ↦ ⟨by rintro ⟨t, rfl⟩; exact t.2, fun hs ↦ ⟨⟨s, hs⟩, rfl⟩⟩
  have hker : LinearMap.ker ((cokernel.π K.ι).val.app (op V)).hom =
      Ideal.primaryComponent (M.val.obj (op V)) (Ideal.span {g}) :=
    Submodule.ext fun s ↦ ((exact_app_cokernel_π B S hS K V s).trans (hrangeK s)).trans (hK s)
  have hQ : Module.IsFiniteLocallyFreeOfRank (chartRing B S hS X.1 X.2 V)
      (M.val.obj (op V) ⧸
        Ideal.primaryComponent (M.val.obj (op V)) (Ideal.span {g})) k :=
    Module.isFiniteLocallyFreeOfRank_quotient_primaryComponent k g hreg hfit
      (hfree V hVaff hfin g hfit)
  exact Module.isFiniteLocallyFreeOfRank_of_linearEquiv
    ((Submodule.quotEquivOfEq _ _ hker.symm).trans
      (LinearMap.quotKerEquivOfSurjective ((cokernel.π K.ι).val.app (op V)).hom
        (hcoker V hVaff))) k hQ

/-! #### The rank of the strict transform -/

section Stacks0D0Q

attribute [local instance] pointTopology

/-- Let `F` be a finite type quasi-coherent module on an algebraic space `Bsp`, let `Z ⊆ Bsp` be
the closed subspace cut out by the `k`-th Fitting ideal sheaf of `F`, let `b : Bsp' ⟶ Bsp` be the
blowup of `Bsp` in `Z`, and assume that `F` is locally free of rank `k` on the open complement
`Bsp ∖ Z`.  Then the strict transform of `F` is locally free of rank `k`. -/
@[stacks 0D0Q]
theorem isFiniteLocallyFreeOfRank_strictTransformSheaf
    {Bsp Bsp' : AlgebraicSpaces B S hS} (F : Modules.{u, u} B S hS Bsp.1 Bsp.2) (k : ℕ)
    (Z : ClosedSubspaces B S hS Bsp.1)
    (hZ : definingIdealSheaf B S hS Bsp Z = fittingIdeal B S hS Bsp.1 Bsp.2 F k)
    {b : Bsp' ⟶ Bsp} (hb : IsBlowupAlong B S hS Z b) (hFqc : F.IsQuasicoherentOnSite)
    (hFfin : ∀ W : SmallEtale B S hS Bsp.1,
      IsAffine ((SmallEtale.toOver B S hS Bsp.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS Bsp.1 Bsp.2 W) (F.val.obj (op W)))
    (h : RingedSite.IsFiniteLocallyFreeOfRank
      (smallEtaleRingedSite B S hS (openComplementSpace B S hS Bsp Z).1
        (openComplementSpace B S hS Bsp Z).2)
      ((modulePullback B S hS (openComplementHom B S hS Bsp Z)).obj F) k) :
    RingedSite.IsFiniteLocallyFreeOfRank
      (smallEtaleRingedSite B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1
        (strictTransformPullback B S hS (𝟙 Bsp) b).2)
      (strictTransformSheaf B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1 F) k := by
  classical
  have hdiag : IsCartesianOnAffineChartDiagrams B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F :=
    isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F hFqc
  have hpb : ((modulePullback B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F hFqc
  have hMcart : IsCartesianOnAffineCharts ((modulePullback B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS
      (strictTransformPullback B S hS (𝟙 Bsp) b).1
      (strictTransformPullback B S hS (𝟙 Bsp) b).2 _ hpb
  have hcd : HasComplementChartDiagrams B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) Z F k :=
    hasComplementChartDiagrams_of_eq B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) Z F k
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Bsp.1 Bsp.2 F hFqc)
      hFfin hdiag hMcart hZ
  have hcl : IsClosedSubspace B S hS
      (exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1) :=
    exceptionalPreimage_isClosedSubspace B S hS (𝟙 Bsp) b
      (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2
  have hTclosed : IsClosed
      (exceptionalPreimageSet B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1) :=
    isClosed_range_pointsMap_of_isClosedImmersion B S hS
      (strictTransformPullback B S hS (𝟙 Bsp) b).2 _ hcl.2
  have hOopen := isOpenSubspace_openComplement B S hS
    (strictTransformPullback B S hS (𝟙 Bsp) b).2
    (exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1) hcl
  have hOqc : IsQuasiCompact B S hS (openComplement B S hS
      (exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1)).ι :=
    isQuasiCompact_of_isAffineHom' B S hS _ hOopen.1
      (strictTransformPullback B S hS (𝟙 Bsp) b).2
      (isAffineHom_ι_openComplement_of_isEffectiveCartierDivisor B S hS
        (strictTransformPullback B S hS (𝟙 Bsp) b)
        ⟨exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1, hcl⟩
        (isEffectiveCartierDivisor_exceptionalPreimage_id hb))
  have hKcart : IsCartesianOnAffineCharts
      (supportedSectionsSubmodule B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1
        (strictTransformPullback B S hS (𝟙 Bsp) b).2
        (exceptionalPreimageSet B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1)
        ((modulePullback B S hS
          (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F)).toSheafOfModules :=
    (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS
      (strictTransformPullback B S hS (𝟙 Bsp) b).1
      (strictTransformPullback B S hS (𝟙 Bsp) b).2 _).mp
      (isQuasicoherentOnSite_supportedSectionsSubmodule B S hS
        (strictTransformPullback B S hS (𝟙 Bsp) b).2 _ hpb hTclosed hOopen
        (range_pointsMap_ι_openComplement B S hS _) hOqc)
  have hcoker : HasAffineChartCokernelSurjectivity B S hS
      (supportedSectionsSubmodule B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1
        (strictTransformPullback B S hS (𝟙 Bsp) b).2
        (exceptionalPreimageSet B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1)
        ((modulePullback B S hS
          (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F)) :=
    fun V hV ↦ surjective_val_app_cokernel_π_of_h03DW
      (supportedSectionsSubmodule B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1
        (strictTransformPullback B S hS (𝟙 Bsp) b).2
        (exceptionalPreimageSet B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1)
        ((modulePullback B S hS
          (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F)).ι
      (fun {_P _Q} q hq hk Y hY ↦
        surjective_val_app_of_epi_of_kernel_isCartesian_unconditional B S hS
          (strictTransformPullback B S hS (𝟙 Bsp) b) q hq hk Y hY)
      hKcart hMcart V hV
  have hcomm : (strictTransformPullbackToBlowUp B S hS (𝟙 Bsp) b).hom ≫ b.hom =
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b).hom := by
    have h1 : strictTransformPullbackToBlowUp B S hS (𝟙 Bsp) b ≫ b =
        strictTransformPullbackToSource B S hS (𝟙 Bsp) b := by
      rw [← (AlgebraicSpaces.isPullback_fiberProduct B S hS (𝟙 Bsp) b).w, Category.comp_id]
    exact congrArg
      (fun φ : strictTransformPullback B S hS (𝟙 Bsp) b ⟶ Bsp ↦ φ.hom) h1
  have hDZ : (⟨exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1,
        exceptionalPreimage_isClosedSubspace B S hS (𝟙 Bsp) b
          (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ :
        ClosedSubspaces B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1) =
      preimageClosedSubspace (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) Z :=
    Subtype.ext ((Subfunctor.preimage_comp Z.1
      (strictTransformPullbackToBlowUp B S hS (𝟙 Bsp) b).hom b.hom).symm.trans
      (congrArg (fun φ ↦ Z.1.preimage φ) hcomm))
  refine isFiniteLocallyFreeOfRank_cokernel_of_pointwise_principal_fitting B S hS
    (strictTransformPullback B S hS (𝟙 Bsp) b)
    ((modulePullback B S hS (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F)
    (supportedSectionsSubmodule B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1
      (strictTransformPullback B S hS (𝟙 Bsp) b).2
      (exceptionalPreimageSet B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1)
      ((modulePullback B S hS
        (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F))
    k hMcart hKcart hcoker
    (isChartwiseFreeAwayFromPrincipalFitting_of_hasComplementChartDiagrams B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) Z F k hdiag hFfin hMcart hcd h)
    fun W z ↦ ?_
  obtain ⟨d, m, g, hUaff, hVaff, hreg, hgen, z₂, hz₂⟩ :=
    exists_chartDiagram_isRegular_span_definingIdealAt B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) _
      (hasEffectiveCartierEtalePullbacks_exceptionalPreimage_id hb) W z
  have := hFfin d.V hVaff
  have hfinU := module_finite_sections_modulePullback
    (f := strictTransformPullbackToSource B S hS (𝟙 Bsp) b) (G := F) (d := d)
    (hdiag d hUaff hVaff).some
  refine ⟨d.U, m, g, hfinU, hUaff, hreg.mem_nonZeroDivisors, ?_, ?_, z₂, hz₂⟩
  · refine Eq.trans (fittingIdealOnChart_modulePullback_eq_definingIdealAt B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F hFqc hFfin hdiag k Z hZ d
      hUaff hVaff) ?_
    rwa [← hDZ]
  · exact fun s ↦ mem_supportedSectionsSubmodule_iff_mem_primaryComponent B S hS
      (strictTransformPullback B S hS (𝟙 Bsp) b)
      ⟨exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1,
        exceptionalPreimage_isClosedSubspace B S hS (𝟙 Bsp) b
          (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩
      _ hpb d.U hUaff g hgen s

end Stacks0D0Q

