    have e := (hdiag d hdUaff hdVaff).some
    have hPfinU := module_finite_sections_modulePullback (f := f) (G := G) (d := d) e
    have hbotV : @fittingIdealOnChart B S hS Y.1 Y.2 G n d.V hGfinV = ⊥ := by
      obtain ⟨hlow, -⟩ := ((finiteLocallyFreeOfRank_fittingIdeal_tfae
        (R := chartRing B S hS Y.1 Y.2 d.V) (M := G.val.obj (op d.V)) k).out 1 2).mp hV₀free
      rwa [hn, show (((n + 1 : ℕ) : ℤ) - 1) = (n : ℤ) by omega] at hlow
    have hbotU : @fittingIdealOnChart B S hS X.1 X.2
        ((modulePullback B S hS f).obj G) n d.U hPfinU = ⊥ := by
      rw [fittingIdealOnChart_modulePullback n e, hbotV, Ideal.map_bot]
    have hmem : chartRestrict (hF := X.2)
        (ff ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g)) x ∈
        @fittingIdealOnChart B S hS X.1 X.2
          ((modulePullback B S hS f).obj G) n d.U hPfinU :=
      fittingIdealOnChart_map_le_of_surjective_chartBaseChange
        ((modulePullback B S hS f).obj G) n _
        (hpbcart V d.U hVaff hdUaff _).2 (Ideal.mem_map_of_mem _ hx)
    rw [hbotU] at hmem
    have hm' : m ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g) =
        t ≫ (ff ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g)) := by
      rw [← hfacm, Category.assoc]
    calc chartRestrict (hF := X.2) m (chartRestrict (hF := X.2)
            (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g)) x)
        = chartRestrict (hF := X.2)
            (m ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g)) x := by
          rw [chartRestrict_comp]; rfl
      _ = chartRestrict (hF := X.2) t (chartRestrict (hF := X.2)
            (ff ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g)) x) := by
          rw [hm', chartRestrict_comp]; rfl
      _ = 0 := (congrArg (chartRestrict (hF := X.2) t) (Ideal.mem_bot.mp hmem)).trans (map_zero _)
  apply ((finiteLocallyFreeOfRank_fittingIdeal_tfae (R := Localization.Away g)
    (M := LocalizedModule.Away g
      (((modulePullback B S hS f).obj G).val.obj (op V))) k).out 2 1).mp
  have hbase := (_root_.fittingIdeal_basic_properties.{u, u, u, u}
    (R := chartRing B S hS X.1 X.2 V)
    (M := ((modulePullback B S hS f).obj G).val.obj (op V))).2.2.1
    (Localization.Away g)
  have hfit' : _root_.fittingIdeal (R := chartRing B S hS X.1 X.2 V)
      (M := ((modulePullback B S hS f).obj G).val.obj (op V)) (k : ℤ) = Ideal.span {g} := hfit
  refine ⟨?_, ?_⟩
