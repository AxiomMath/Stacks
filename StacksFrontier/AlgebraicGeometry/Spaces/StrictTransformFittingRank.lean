        (G.val.obj (op W)) k)
    (fun _ hW ↦ hW.1)
    (freeRankPresieve_complementChart_mem_topology B S hS Y Z G k h)
  have hkill : ∀ n : ℕ, k = n + 1 →
      ∀ x ∈ @fittingIdealOnChart B S hS X.1 X.2
        ((modulePullback B S hS f).obj G) n V hfin,
        chartRestrict (hF := X.2)
          (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g)) x = 0 := by
    intro n hn x hx
    refine eq_zero_of_chartRestrict_eq_zero B S hS X _ _ hcov fun W m hm ↦ ?_
    obtain ⟨U, t, ff, ⟨d, hdU, hdUaff, hdVaff, -, hV₀free⟩, hfacm⟩ := hm
    subst hdU
    have hGfinV : Module.Finite (chartRing B S hS Y.1 Y.2 d.V) (G.val.obj (op d.V)) :=
