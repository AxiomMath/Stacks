/-!
# The rank of a strict transform

Let `F` be a finite type quasi-coherent module on an algebraic space `Bsp`, let `Z ⊆ Bsp` be the
closed subspace cut out by the `k`-th Fitting ideal sheaf of `F`, let `b : Bsp' ⟶ Bsp` be the
blowup of `Bsp` in `Z` and assume that `F` is locally free of rank `k` on the open complement
`Bsp \ Z`.  Then the strict transform of `F` is locally free of rank `k`.

## Main results

* `AlgebraicGeometry.Space.isFiniteLocallyFreeOfRank_strictTransformSheaf`: the strict transform
  of `F` is locally free of rank `k`.
* `Module.isFiniteLocallyFreeOfRank_quotient_primaryComponent`: a finite module whose `k`-th
  Fitting ideal is generated by a single nonzerodivisor `g`, and which becomes finite locally free
  of rank `k` after inverting `g`, has a quotient by its `g`-power torsion which is finite locally
  free of rank `k`.
* `AlgebraicGeometry.Space.exact_app_cokernel_π`: the sections of a sheaf submodule over a chart
  are the kernel of the projection onto the cokernel.
* `AlgebraicGeometry.Space.isChartwiseFreeAwayFromPrincipalFitting_of_hasComplementChartDiagrams`:
  if affine chart diagrams whose target chart comes from the open complement are cofinal, then
  the sections of the pullback module over an affine chart on which the `k`-th Fitting ideal is
  generated by `g` become finite locally free of rank `k` after inverting `g`.
* `AlgebraicGeometry.Space.hasComplementChartDiagrams_of_eq`: that cofinality holds for the
  Fitting closed subspace.
* `AlgebraicGeometry.Space.eq_zero_of_chartRestrict_eq_zero`: a regular function vanishing on
  the members of a covering sieve vanishes.
* `AlgebraicGeometry.Space.freeRankPresieve_complementChart_mem_topology`: the affine charts of
  the open complement over which the sections of a module are finite locally free of rank `k`
  cover every chart of the complement.
* `AlgebraicGeometry.Space.isFiniteLocallyFreeOfRank_cokernel_of_pointwise_principal_fitting`:
  a quotient of a module by a sheaf submodule is finite locally free of rank `k` when, through
  every point, some affine chart carries a nonzerodivisor generating the `k`-th Fitting ideal and
  cutting out the submodule as its power torsion.

## References

* [Stacks Project, Tag 0D0Q](https://stacks.math.columbia.edu/tag/0D0Q)
* [Stacks Project, Tag 0CZQ](https://stacks.math.columbia.edu/tag/0CZQ)
* [Stacks Project, Tag 0CZN](https://stacks.math.columbia.edu/tag/0CZN)
-/

@[expose] public section

open scoped TensorProduct

universe u v

/-! ### The commutative algebra -/

namespace Stacks.Fitting

/-- An element of the primary component of the principal ideal generated by `g` is killed by a
power of `g`. -/
private lemma exists_pow_smul_eq_zero_of_mem_primaryComponent
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M] (g : R) {x : M}
    (hx : x ∈ Ideal.primaryComponent M (Ideal.span {g})) : ∃ n : ℕ, g ^ n • x = 0 := by
  obtain ⟨n, hn⟩ := (Ideal.primaryComponent_mem _ _ _).mp hx
  exact ⟨n, (Submodule.mem_torsionBySet_iff _ _).mp hn
    ⟨g ^ n, Ideal.pow_mem_pow (Ideal.mem_span_singleton_self g) n⟩⟩

/-- The primary component of the principal ideal generated by `g` is contained in the torsion
for the monoid of powers of `g`. -/
private lemma primaryComponent_le_torsion'
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M] (g : R) :
    Ideal.primaryComponent M (Ideal.span {g}) ≤
      Submodule.torsion' R M (Submonoid.powers g) := fun _ hx ↦
  let ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_mem_primaryComponent g hx
  ⟨⟨g ^ n, ⟨n, rfl⟩⟩, hn⟩

/-- For a submodule `T` of `g`-power torsion elements the base change of `M ⧸ T` to a
localization away from `g` is the base change of `M`. -/
noncomputable def baseChangeQuotEquivAway
    {R : Type u} {M : Type v} {A : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    [CommRing A] [Algebra R A] (g : R) [IsLocalization.Away g A]
    (T : Submodule R M) (hT : T ≤ Submodule.torsion' R M (Submonoid.powers g)) :
    A ⊗[R] (M ⧸ T) ≃ₗ[A] A ⊗[R] M :=
  let e : ((A ⊗[R] M) ⧸
      (T.localized' A (Submonoid.powers g) (TensorProduct.mk R A M 1))) ≃ₗ[A]
      (A ⊗[R] (M ⧸ T)) :=
    (IsLocalizedModule.linearEquiv (Submonoid.powers g)
      (T.toLocalizedQuotient' A (Submonoid.powers g) (TensorProduct.mk R A M 1))
      (TensorProduct.mk R A (M ⧸ T) 1)).extendScalarsOfIsLocalization
        (Submonoid.powers g) A
  e.symm.trans (Submodule.quotEquivOfEqBot _ (localized'_eq_bot_of_le_torsion' g T hT))

/-- Multiplication by `g` is injective on the quotient of `M` by its `g`-power torsion. -/
private lemma eq_zero_of_smul_eq_zero_quotient_primaryComponent
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M] (g : R)
    (x : M ⧸ Ideal.primaryComponent M (Ideal.span {g})) (hx : g • x = 0) : x = 0 := by
  obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hx
  obtain ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_mem_primaryComponent g hx
  have hkill : g ^ (n + 1) • m = 0 := by rwa [smul_smul, ← pow_succ] at hn
  rw [Submodule.Quotient.mk_eq_zero, Ideal.primaryComponent_mem]
  refine ⟨n + 1, ?_⟩
  rw [Submodule.mem_torsionBySet_iff]
  rintro ⟨r, hr⟩
  rw [Ideal.span_singleton_pow] at hr
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hr
  change (g ^ (n + 1) * c) • m = 0
  rw [mul_comm, mul_smul, hkill, smul_zero]

/-- If the `k`-th Fitting ideal of a finite module `M` is generated by `g`, the `k`-th Fitting
ideal of the quotient of `M` by its `g`-power torsion is the unit ideal. -/
theorem fittingIdeal_quotient_primaryComponent_eq_top
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (g : R) (hfit : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {g}) :
    fittingIdeal (R := R) (M := M ⧸ Ideal.primaryComponent M (Ideal.span {g})) (k : ℤ) = ⊤ :=
  fittingIdeal_eq_top_of_surjective_of_regular (Submodule.mkQ _)
    (Submodule.mkQ_surjective _) k g hfit
    (eq_zero_of_smul_eq_zero_quotient_primaryComponent g)

/-- If `g` is a nonzerodivisor and `M` becomes finite locally free of rank `k` after inverting
`g`, the `(k-1)`-st Fitting ideal of the quotient of `M` by its `g`-power torsion vanishes. -/
theorem fittingIdeal_pred_quotient_primaryComponent_eq_bot
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (g : R) (hreg : g ∈ nonZeroDivisors R)
    (hf : Module.IsFiniteLocallyFreeOfRank (Localization.Away g)
      (LocalizedModule.Away g M) k) :
    fittingIdeal (R := R) (M := M ⧸ Ideal.primaryComponent M (Ideal.span {g}))
      ((k : ℤ) - 1) = ⊥ := by
  cases k with
  | zero => simp [fittingIdeal]
  | succ n =>
    rw [show (((n + 1 : ℕ) : ℤ) - 1) = (n : ℤ) by omega]
    have hinj : Function.Injective (algebraMap R (Localization.Away g)) :=
      IsLocalization.injective _ (Submonoid.powers_le.mpr hreg)
    apply (Ideal.map_eq_bot_iff_of_injective hinj).mp
    rw [← (fittingIdeal_basic_properties.{u, v, v, u} (R := R)
      (M := M ⧸ Ideal.primaryComponent M (Ideal.span {g}))).2.2.1 (Localization.Away g) n,
      fittingIdeal_eq_of_linearEquiv
        (baseChangeQuotEquivAway (A := Localization.Away g) g _
          (primaryComponent_le_torsion' g)) n]
    obtain ⟨hlow, -⟩ := ((finiteLocallyFreeOfRank_fittingIdeal_tfae
      (R := Localization.Away g) (M := LocalizedModule.Away g M) (n + 1)).out 1 2).mp hf
    rwa [show (((n + 1 : ℕ) : ℤ) - 1) = (n : ℤ) by omega,
      fittingIdeal_eq_of_linearEquiv
        (LocalizedModule.equivTensorProduct (Submonoid.powers g) M) n] at hlow

end Stacks.Fitting

namespace Module

/-- Let `M` be a finite module over a commutative ring `R`, let `k` be a natural number and let
`g` be a nonzerodivisor of `R` generating the `k`-th Fitting ideal of `M`.  Assume that `M`
becomes finite locally free of rank `k` after inverting `g`.  Then the quotient of `M` by its
`g`-power torsion is finite locally free of rank `k`. -/
theorem isFiniteLocallyFreeOfRank_quotient_primaryComponent
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (g : R) (hreg : g ∈ nonZeroDivisors R)
    (hfit : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {g})
    (hf : Module.IsFiniteLocallyFreeOfRank (Localization.Away g)
      (LocalizedModule.Away g M) k) :
    Module.IsFiniteLocallyFreeOfRank R (M ⧸ Ideal.primaryComponent M (Ideal.span {g})) k := by
  apply ((finiteLocallyFreeOfRank_fittingIdeal_tfae (R := R)
    (M := M ⧸ Ideal.primaryComponent M (Ideal.span {g})) k).out 2 1).mp
  exact ⟨Stacks.Fitting.fittingIdeal_pred_quotient_primaryComponent_eq_bot k g hreg hf,
    Stacks.Fitting.fittingIdeal_quotient_primaryComponent_eq_top k g hfit⟩

/-- Finite local freeness of a fixed rank transports along a linear equivalence. -/
theorem isFiniteLocallyFreeOfRank_of_linearEquiv {R : Type u} {M N : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module.Finite R M]
    (e : M ≃ₗ[R] N) (k : ℕ) (h : Module.IsFiniteLocallyFreeOfRank R M k) :
    Module.IsFiniteLocallyFreeOfRank R N k := by
  have : Module.Finite R N := Module.Finite.equiv e
  obtain ⟨hlo, hhi⟩ :=
    ((finiteLocallyFreeOfRank_fittingIdeal_tfae (R := R) (M := M) k).out 1 2).mp h
  apply ((finiteLocallyFreeOfRank_fittingIdeal_tfae (R := R) (M := N) k).out 2 1).mp
  refine ⟨?_, by rwa [← fittingIdeal_eq_of_linearEquiv e k]⟩
  cases k with
  | zero => simp [fittingIdeal]
  | succ n =>
    rw [show (((n + 1 : ℕ) : ℤ) - 1) = (n : ℤ) by omega] at hlo ⊢
    rwa [← fittingIdeal_eq_of_linearEquiv e n]

end Module

/-! ### The geometry -/

namespace AlgebraicGeometry.Space

open CategoryTheory CategoryTheory.Limits Opposite

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! #### Local vanishing of regular functions -/

/-- A regular function on an étale chart whose restrictions
(`AlgebraicGeometry.Space.chartRestrict`) to the members of a covering sieve vanish is zero. -/
theorem eq_zero_of_chartRestrict_eq_zero (X : AlgebraicSpaces B S hS)
    {V : SmallEtale B S hS X.1} (x : chartRing B S hS X.1 X.2 V) (T : Sieve V)
    (hT : T ∈ SmallEtale.topology B S hS X.1 V)
    (hx : ∀ ⦃W : SmallEtale B S hS X.1⦄ (m : W ⟶ V), T m →
      chartRestrict (hF := X.2) m x = 0) :
    x = 0 := by
  have hsep := (SheafOfModules.unit
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X.1 X.2).O))).isSheaf.isSeparated
  exact hsep _ _ hT x 0 fun _ m hm ↦ by rw [map_zero]; exact hx m hm

/-! #### The sections of a module over the charts of an open subspace -/

/-- Let `f : X ⟶ Y` be an étale morphism of algebraic spaces and `G` an `𝒪_Y`-module.  If the
sections of `f^*G` over a chart `V` of `X` are finite locally free of rank `k`, so are the
sections of `G` over the composite chart of `Y`. -/
theorem isFiniteLocallyFreeOfRank_sections_smallEtalePostcomp
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hf : IsEtale B S hS f.hom)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (k : ℕ) (V : SmallEtale B S hS X.1)
    (hV : Module.IsFiniteLocallyFreeOfRank (chartRing B S hS X.1 X.2 V)
      (((modulePullback B S hS f).obj G).val.obj (op V)) k) :
    Module.IsFiniteLocallyFreeOfRank
      (chartRing B S hS Y.1 Y.2 ((smallEtalePostcomp B S hS f hf).obj V))
      (G.val.obj (op ((smallEtalePostcomp B S hS f hf).obj V))) k := by
  have := hV.finite
  have e : (((modulePullback B S hS f).obj G).val.obj (op V)) ≃ₗ[chartRing B S hS X.1 X.2 V]
      (((etaleModulePullback.{u, u} B S hS f hf).obj G).val.obj (op V)) :=
    ((SheafOfModules.evaluation
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O))
        (op V)).mapIso ((modulePullbackIsoEtaleModulePullback B S hS f hf).app G)).toLinearEquiv
  exact Module.isFiniteLocallyFreeOfRank_of_linearEquiv e k hV

/-- If a module `G` on `X` is finite locally free of rank `k` on the open complement of a
closed subspace `Z`, the charts of the complement whose composite chart of `X` is affine and
carries sections of `G` finite locally free of rank `k` generate a covering sieve of every chart
of the complement. -/
theorem freeRankPresieve_complementChart_mem_topology (X : AlgebraicSpaces B S hS)
    (Z : ClosedSubspaces B S hS X.1) (G : Modules.{u, u} B S hS X.1 X.2) (k : ℕ)
    (h : RingedSite.IsFiniteLocallyFreeOfRank
      (smallEtaleRingedSite B S hS (openComplementSpace B S hS X Z).1
        (openComplementSpace B S hS X Z).2)
      ((modulePullback B S hS (openComplementHom B S hS X Z)).obj G) k)
    (U₀ : SmallEtale B S hS (openComplementSpace B S hS X Z).1) :
    Sieve.generate (fun (V₀ : SmallEtale B S hS (openComplementSpace B S hS X Z).1) _ =>
      IsAffine (chartScheme ((complementChart B S hS X Z).obj V₀)) ∧
        Module.IsFiniteLocallyFreeOfRank
          (chartRing B S hS X.1 X.2 ((complementChart B S hS X Z).obj V₀))
          (G.val.obj (op ((complementChart B S hS X Z).obj V₀))) k)
      ∈ SmallEtale.topology B S hS (openComplementSpace B S hS X Z).1 U₀ := by
  refine (SmallEtale.topology B S hS (openComplementSpace B S hS X Z).1).superset_covering ?_
    (freeRankPresieve_mem_topology_of_isFiniteLocallyFreeOfRank B S hS
      (openComplementSpace B S hS X Z).1 (openComplementSpace B S hS X Z).2
      ((modulePullback B S hS (openComplementHom B S hS X Z)).obj G) k h U₀)
  rintro W m ⟨V₀, t, ff, ⟨hVaff, hVfree⟩, hcomp⟩
  exact ⟨V₀, t, ff, ⟨hVaff, isFiniteLocallyFreeOfRank_sections_smallEtalePostcomp B S hS
    (openComplementHom B S hS X Z) (isEtale_openComplementHom B S hS X Z) G k V₀ hVfree⟩, hcomp⟩

/-! #### Sections of a cokernel over a chart -/

/-- The sections of a sheaf submodule over a chart are exactly the kernel of the projection
onto the cokernel, over an arbitrary chart. -/
theorem exact_app_cokernel_π {X : AlgebraicSpaces B S hS}
    {M : Modules.{u, u} B S hS X.1 X.2} (K : M.Submodule) (V : SmallEtale B S hS X.1) :
    Function.Exact (K.ι.val.app (op V)) ((cokernel.π K.ι).val.app (op V)) := by
  let _ : Abelian (Modules.{u, u} B S hS X.1 X.2) := SheafOfModules.instAbelian _
  rw [LinearMap.exact_iff]
  exact ((ShortComplex.moduleCat_exact_iff_range_eq_ker _).mp
    ((ShortComplex.exact_cokernel K.ι).map_of_mono_of_preservesKernel
      (SheafOfModules.evaluation
        ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)) (op V))
      inferInstance inferInstance)).symm

/-- The projection onto the cokernel of the inclusion of a sheaf submodule `K` is surjective on
the sections over every affine chart. -/
def HasAffineChartCokernelSurjectivity {X : AlgebraicSpaces B S hS}
    {M : Modules.{u, u} B S hS X.1 X.2} (K : M.Submodule) : Prop :=
  ∀ V : SmallEtale B S hS X.1,
    IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V) →
      Function.Surjective ((cokernel.π K.ι).val.app (op V))

/-- For every affine étale chart `V` on which the `k`-th Fitting ideal of the finite sections of
`M` is generated by a single element `g`, the sections of `M` over `V` become finite locally free
of rank `k` after inverting `g`. -/
def IsChartwiseFreeAwayFromPrincipalFitting {X : AlgebraicSpaces B S hS}
    (M : Modules.{u, u} B S hS X.1 X.2) (k : ℕ) : Prop :=
  ∀ (V : SmallEtale B S hS X.1),
    IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V) →
    ∀ (hfin : Module.Finite (chartRing B S hS X.1 X.2 V) (M.val.obj (op V)))
      (g : chartRing B S hS X.1 X.2 V),
      @fittingIdealOnChart B S hS X.1 X.2 M k V hfin = Ideal.span {g} →
        Module.IsFiniteLocallyFreeOfRank (Localization.Away g)
          (LocalizedModule.Away g (M.val.obj (op V))) k

/-- Affine chart diagrams whose target chart comes from the open complement are cofinal over
the basic open of a Fitting generator.

Let `f : X ⟶ Y` be a morphism of algebraic spaces, let `Z ⊆ Y` be a closed subspace and let `V`
be an affine étale chart of `X` on which the `k`-th Fitting ideal of `f^*G` is generated by a
single element `g`.  For every property `Q` of charts of `Y` implying affineness and holding over
a covering of every chart of `Y ∖ Z`, the sources of affine chart diagrams over `f` whose target
chart satisfies `Q` generate a covering sieve of the basic open of `g` in `V`. -/
def HasComplementChartDiagrams {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (Z : ClosedSubspaces B S hS Y.1) (G : Modules.{u, u} B S hS Y.1 Y.2) (k : ℕ) : Prop :=
  ∀ (V : SmallEtale B S hS X.1), IsAffine (chartScheme V) →
    ∀ (hfin : Module.Finite (chartRing B S hS X.1 X.2 V)
        (((modulePullback B S hS f).obj G).val.obj (op V)))
      (g : chartRing B S hS X.1 X.2 V),
      @fittingIdealOnChart B S hS X.1 X.2 ((modulePullback B S hS f).obj G) k V hfin =
          Ideal.span {g} →
      ∀ Q : SmallEtale B S hS Y.1 → Prop,
        (∀ W : SmallEtale B S hS Y.1, Q W → IsAffine (chartScheme W)) →
        (∀ U₀ : SmallEtale B S hS (openComplementSpace B S hS Y Z).1,
          Sieve.generate
            (fun (V₀ : SmallEtale B S hS (openComplementSpace B S hS Y Z).1) _ =>
              Q ((complementChart B S hS Y Z).obj V₀)) ∈
              SmallEtale.topology B S hS (openComplementSpace B S hS Y Z).1 U₀) →
        Sieve.generate (fun (U : SmallEtale B S hS X.1)
            (_ : U ⟶ openChart B S hS X.1 V ((chartScheme V).basicOpen g)) =>
          ∃ (d : ChartDiagram B S hS X.1 Y.1 f.hom) (_ : d.U = U),
            IsAffine (chartScheme d.U) ∧ IsAffine (chartScheme d.V) ∧ Q d.V) ∈
          SmallEtale.topology B S hS X.1
            (openChart B S hS X.1 V ((chartScheme V).basicOpen g))

/-- The cofinality of affine chart diagrams over the open complement,
`AlgebraicGeometry.Space.HasComplementChartDiagrams`, holds when `Z` is the closed subspace cut out
by the `k`-th Fitting ideal of `G`. -/
theorem hasComplementChartDiagrams_of_eq {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (Z : ClosedSubspaces B S hS Y.1) (G : Modules.{u, u} B S hS Y.1 Y.2) (k : ℕ)
    (hGcart : IsCartesianOnAffineCharts G)
    (hGfin : ∀ W : SmallEtale B S hS Y.1, IsAffine (chartScheme W) →
      Module.Finite (chartRing B S hS Y.1 Y.2 W) (G.val.obj (op W)))
    (hdiag : IsCartesianOnAffineChartDiagrams B S hS f G)
    (hpbcart : IsCartesianOnAffineCharts ((modulePullback B S hS f).obj G))
    (hZ : definingIdealSheaf B S hS Y Z = fittingIdeal B S hS Y.1 Y.2 G k) :
    HasComplementChartDiagrams B S hS f Z G k :=
  fun V hVaff hfin g hfit Q hQaff hQ ↦
    generate_complementChartDiagram_mem_topology B S hS f Z G k hGcart hGfin hdiag hpbcart hZ
      V hVaff hfin g hfit Q hQaff hQ

/-- Let `f : X ⟶ Y` be a morphism of algebraic spaces and `G` an `𝒪_Y`-module which is finite
locally free of rank `k` on the open complement of a closed subspace `Z ⊆ Y`.  If affine chart
diagrams with target over the complement are cofinal over the basic open of a Fitting generator
(the hypothesis `hcd`), the sections of `f^*G` over an affine chart on which the `k`-th Fitting
ideal is generated by `g` become finite locally free of rank `k` after inverting `g`. -/
theorem isChartwiseFreeAwayFromPrincipalFitting_of_hasComplementChartDiagrams
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (Z : ClosedSubspaces B S hS Y.1)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (k : ℕ)
    (hdiag : IsCartesianOnAffineChartDiagrams B S hS f G)
    (hGfin : ∀ W : SmallEtale B S hS Y.1, IsAffine (chartScheme W) →
      Module.Finite (chartRing B S hS Y.1 Y.2 W) (G.val.obj (op W)))
    (hpbcart : IsCartesianOnAffineCharts ((modulePullback B S hS f).obj G))
    (hcd : HasComplementChartDiagrams B S hS f Z G k)
    (h : RingedSite.IsFiniteLocallyFreeOfRank
      (smallEtaleRingedSite B S hS (openComplementSpace B S hS Y Z).1
        (openComplementSpace B S hS Y Z).2)
      ((modulePullback B S hS (openComplementHom B S hS Y Z)).obj G) k) :
    IsChartwiseFreeAwayFromPrincipalFitting B S hS ((modulePullback B S hS f).obj G) k := by
  classical
  intro V hVaff hfin g hfit
  have := hfin
  let _ : Algebra (chartRing B S hS X.1 X.2 V)
      (chartRing B S hS X.1 X.2
        (openChart B S hS X.1 V ((chartScheme V).basicOpen g))) :=
    chartAlgebra (hF := X.2)
      (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen g))
  have hloc : IsLocalization.Away g (chartRing B S hS X.1 X.2
      (openChart B S hS X.1 V ((chartScheme V).basicOpen g))) :=
    isLocalization_away_chartRing_openChart_basicOpen B S hS X.2 V hVaff g
  have hcov := hcd V hVaff hfin g hfit
    (fun W ↦ IsAffine (chartScheme W) ∧
