module

public import Mathlib.CategoryTheory.Sites.LocallyBijective
public import StacksFrontier.AlgebraicGeometry.Spaces.QuotientSheaf
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Equality in the quotient sheaf of a pre-equivalence relation

Two `T`-valued points of `U` have the same image in the quotient sheaf of a pre-equivalence
relation `j : R ⟶ U ×_S U` exactly when, locally on a covering sieve of `T`, they are the
source and the target of a point of `R`. Equivalently, the canonical map
`h_R ⟶ h_U ×_{U/R} h_U` is a surjection of sheaves.

## Main results

* `Stacks.Groupoids.toQuotientPresheaf_apply_eq_iff_related` computes equality in the
  quotient *presheaf*: it is the induced relation itself, with no further equivalence
  closure.
* `Stacks.Groupoids.toQuotientSheaf_apply_eq_iff_locally_related` is the local
  characterization of equality in the quotient *sheaf*.

## Implementation notes

The site is presented by an arbitrary functor `F : C ⥤ Over S` into `S`-schemes, which
covers the big and small Zariski, étale, fppf, smooth and syntomic sites at once. The
sheafification is asked to satisfy `CategoryTheory.GrothendieckTopology.WEqualsLocallyBijective`,
the characterization of the sheafification maps as the locally bijective ones; this holds
for sets in `Type (max v w)` on a site with objects in `Type v` and morphisms in `Type w`,
and keeping it as a hypothesis also permits smaller value universes where the
characterization is available. It expresses the ordinary sheafification used on the five
sites of the source statement, which an abstract left exact reflector alone does not
supply.

The source statement uses a covering family `{f i : T i ⟶ T}`; a covering sieve is used
instead. Passing to the sieve generated by a family, or to the family of all arrows of a
sieve, gives the same local condition.

The presheaf computation is the content of the source's proof: the quotient presheaf is a
pointwise coequalizer of types, hence a `Quot` of the relation generated by the `T`-valued
points of `R`, and the pre-equivalence hypothesis says that this generated relation is
already the induced relation. The sheaf statement then follows from local injectivity of
the sheafification map in one direction and from separatedness of the quotient sheaf in the
other.

## References

* [Stacks Project, Tag 045Y](https://stacks.math.columbia.edu/tag/045Y)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace Stacks.Groupoids

/-- Equality in the quotient presheaf of a pre-equivalence relation is the induced relation
on points, with no further equivalence closure. -/
@[sga "3 IV 3.1.2" "partial"]
theorem toQuotientPresheaf_apply_eq_iff_related {S : Scheme.{u}} {C : Type v}
    [Category.{w} C] (F : C ⥤ Over S) {R U : Over S}
    (j : PreRelation R U) (hj : IsPreEquivalenceRelation j)
    (T : C) (a b : F.obj T ⟶ U) :
    (toQuotientPresheaf F j).app (op T) a = (toQuotientPresheaf F j).app (op T) b ↔
      j.Rel a b := by
  classical
  let s := (sourceMap F j).app (op T)
  let t := (targetMap F j).app (op T)
  let H := parallelPair (sourceMap F j) (targetMap F j)
  let e₁ := colimitObjIsoColimitCompEvaluation H (op T)
  let eH : H ⋙ (evaluation Cᵒᵖ (Type u)).obj (op T) ≅ parallelPair s t :=
    NatIso.ofComponents (fun x => by
      cases x <;> dsimp [H, s, t, sourceMap, targetMap]
      all_goals rfl) (by
      intro i k g
      cases g <;> ext q <;> simp [H, s, t, sourceMap, targetMap,
        PreRelation.source, PreRelation.target, Category.assoc])
  let e₂ : colimit (H ⋙ (evaluation Cᵒᵖ (Type u)).obj (op T)) ≅
      Function.Coequalizer ⇑(ConcreteCategory.hom s) ⇑(ConcreteCategory.hom t) :=
    HasColimit.isoOfNatIso eH ≪≫ colimit.isoColimitCocone (Types.coequalizerColimit s t)
  have hrep (x : F.obj T ⟶ U) :
      e₂.hom (e₁.hom ((toQuotientPresheaf F j).app (op T) x)) =
        Function.Coequalizer.mk s t x := by
    let G := H ⋙ (evaluation Cᵒᵖ (Type u)).obj (op T)
    have h₁ : e₁.hom ((toQuotientPresheaf F j).app (op T) x) =
        (colimit.ι G WalkingParallelPair.one) x :=
      congrArg (fun k => k x)
        (colimitObjIsoColimitCompEvaluation_ι_app_hom H WalkingParallelPair.one (op T))
    have h₂ : (HasColimit.isoOfNatIso eH).hom ((colimit.ι G WalkingParallelPair.one) x) =
        ((eH.hom.app WalkingParallelPair.one) ≫
          colimit.ι (parallelPair s t) WalkingParallelPair.one) x :=
      congrArg (fun k => k x) (HasColimit.ι_isoOfNatIso_hom eH WalkingParallelPair.one)
    have h₃ : (colimit.isoColimitCocone (Types.coequalizerColimit s t)).hom
        ((colimit.ι (parallelPair s t) WalkingParallelPair.one) x) =
          Function.Coequalizer.mk s t x :=
      congrArg (fun k => k x)
        (colimit.isoColimitCocone_ι_hom (Types.coequalizerColimit s t) WalkingParallelPair.one)
    change (colimit.isoColimitCocone (Types.coequalizerColimit s t)).hom
      ((HasColimit.isoOfNatIso eH).hom
        ((colimitObjIsoColimitCompEvaluation H (op T)).hom
          ((toQuotientPresheaf F j).app (op T) x))) = _
    rw [h₁, h₂]
    exact h₃
  have he : Equivalence (j.Rel (T := F.obj T)) := hj (F.obj T)
  constructor
  · intro hab
    have hquot : Function.Coequalizer.mk s t a = Function.Coequalizer.mk s t b := by
      rw [← hrep a, ← hrep b, hab]
    change Quot.mk (Function.Coequalizer.Rel s t) a =
      Quot.mk (Function.Coequalizer.Rel s t) b at hquot
    have hstep : ∀ x y, Function.Coequalizer.Rel s t x y → j.Rel x y := by
      rintro x y ⟨q⟩
      exact he.symm ⟨q, rfl, rfl⟩
    exact he.eqvGen_iff.mp (Relation.EqvGen.mono hstep a b (Quot.eqvGen_exact hquot))
  · rintro ⟨q, rfl, rfl⟩
    exact (congrArg (fun k => k.app (op T) q)
      (coequalizer.condition (sourceMap F j) (targetMap F j))).symm

/-- Restricting the class of a point of `U` along `f` gives the class of the restricted
point. -/
private lemma toQuotientPresheaf_app_map_comp {S : Scheme.{u}} {C : Type v} [Category.{w} C]
    (F : C ⥤ Over S) {R U : Over S} (j : PreRelation R U) {X T : C} (f : X ⟶ T)
    (a : F.obj T ⟶ U) :
    (toQuotientPresheaf F j).app (op X) (F.map f ≫ a) =
      (quotientPresheaf F j).map f.op ((toQuotientPresheaf F j).app (op T) a) :=
  NatTrans.naturality_apply (toQuotientPresheaf F j) f.op a

/-- **Stacks 045Y.** Two `T`-valued points of `U` have the same image in the quotient sheaf
of a pre-equivalence relation if and only if, on some covering sieve of `T`, their
restrictions are the source and the target of a point of the relation scheme. -/
@[stacks 045Y]
theorem toQuotientSheaf_apply_eq_iff_locally_related
    {S : Scheme.{u}} {C : Type v} [Category.{w} C]
    (J : GrothendieckTopology C) [HasSheafify J (Type u)]
    [J.WEqualsLocallyBijective (Type u)]
    (F : C ⥤ Over S) {R U : Over S} (j : PreRelation R U)
    (hj : IsPreEquivalenceRelation j)
    (T : C) (a b : F.obj T ⟶ U) :
    (toQuotientSheaf J F j).app (op T) a = (toQuotientSheaf J F j).app (op T) b ↔
      ∃ W : Sieve T, W ∈ J T ∧
        ∀ (X : C) (f : X ⟶ T), W.arrows f →
          ∃ r : F.obj X ⟶ R,
            (r ≫ j.source = F.map f ≫ a) ∧ (r ≫ j.target = F.map f ≫ b) := by
  let P := quotientPresheaf F j
  let θ := toSheafify J P
  let q := toQuotientPresheaf F j
  let qa := q.app (op T) a
  let qb := q.app (op T) b
  change θ.app (op T) qa = θ.app (op T) qb ↔ _
  have key {X : C} (f : X ⟶ T) : P.map f.op qa = P.map f.op qb ↔
      ∃ r : F.obj X ⟶ R, (r ≫ j.source = F.map f ≫ a) ∧ (r ≫ j.target = F.map f ≫ b) := by
    rw [← toQuotientPresheaf_app_map_comp F j f a, ← toQuotientPresheaf_app_map_comp F j f b,
      eq_comm, toQuotientPresheaf_apply_eq_iff_related F j hj X]
    exact ⟨fun ⟨r, hrt, hrs⟩ => ⟨r, hrs, hrt⟩, fun ⟨r, hrs, hrt⟩ => ⟨r, hrt, hrs⟩⟩
  constructor
  · intro hab
    let W := Presheaf.equalizerSieve (F := P) (X := op T) qa qb
    have hW : W ∈ J T :=
      (J.W_toSheafify P).isLocallyInjective.equalizerSieve_mem qa qb hab
    refine ⟨W, hW, fun X f hf => (key f).1 ?_⟩
    simpa [W, qa, qb, Presheaf.equalizerSieve] using hf
  · rintro ⟨W, hW, hlocal⟩
    apply (quotientSheaf J F j).property.isSeparated T W hW
      (θ.app (op T) qa) (θ.app (op T) qb)
    intro X f hf
    have hθq' := congrArg (θ.app (op X)) ((key f).2 (hlocal X f hf))
    rwa [NatTrans.naturality_apply (X := op T) (Y := op X) θ f.op qa,
      NatTrans.naturality_apply (X := op T) (Y := op X) θ f.op qb] at hθq'

end Stacks.Groupoids

end
