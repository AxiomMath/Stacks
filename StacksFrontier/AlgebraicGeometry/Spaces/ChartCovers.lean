module

public import StacksFrontier.AlgebraicGeometry.Spaces.ElementaryDistinguishedSquarePushout
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleSourceLocalityTransfer
public import StacksFrontier.AlgebraicGeometry.Spaces.FpqcSourceLocalityTransfer
public import StacksFrontier.AlgebraicGeometry.Spaces.Morphisms.QuasiCompact
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleAffineRefinement
public import StacksFrontier.AlgebraicGeometry.Spaces.SurjectiveOnPoints

/-!
# Covering charts of `X` by charts factoring through an étale covering

Let `X` be an algebraic space over a scheme `S`.  An étale chart `T` of `X` together with a
morphism `z : T ⟶ Z` to an algebraic space `Z` is covered, in the small étale site of `X`, by
charts on which `z` factors through some member of any given étale covering `{Yᵢ ⟶ Z}`
(`AlgebraicGeometry.Space.generate_mem_of_isEtaleCovering`).  Two consequences are recorded:

* `AlgebraicGeometry.Space.exists_finite_affine_pullback_cover`: when `Z` is quasi-separated and
  `Y ⟶ Z` is an étale morphism from a quasi-compact algebraic space, a quasi-compact chart
  `a : T ⟶ Z` admits finitely many affine charts over `T` and `Y` through which every chart
  over `T` and `Y` locally factors.  These are the affine charts covering the quasi-compact
  fibre product `T ×_Z Y`.
* `AlgebraicGeometry.Space.generate_mem_of_isElementaryDistinguishedSquare` and
  `AlgebraicGeometry.Space.generate_mem_of_isElementaryDistinguishedSquare_overlap`: the two
  étale coverings of an elementary distinguished square `(U ⊂ W, f : V ⟶ W)` read on charts —
  every chart of `W` locally factors through `U` or through `V`, and two charts of `V` with the
  same image in `W` locally agree or lie over `U`.

## References

* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 08GM](https://stacks.math.columbia.edu/tag/08GM)
* [Stacks Project, Tag 0DVI](https://stacks.math.columbia.edu/tag/0DVI)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- Restricting along a composite of chart morphisms, on the represented presheaves. -/
theorem yoneda_map_comp_left {T T' T'' : SmallEtale B S hS X} (h : T'' ⟶ T') (g : T' ⟶ T) :
    yoneda.map (h ≫ g).hom.left = yoneda.map h.hom.left ≫ yoneda.map g.hom.left :=
  yoneda.map_comp _ _

/-- Two chart morphisms are equal when their underlying morphisms of the big fppf site are. -/
theorem SmallEtale.hom_ext' {T T' : SmallEtale B S hS X} {g g' : T ⟶ T'}
    (h : g.hom.left = g'.hom.left) : g = g' :=
  ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ h)

/-- A morphism of the site whose represented map is étale is an étale morphism of schemes. -/
private theorem etale_toScheme_map_of_isEtale {A C : BigFppfOver B S hS} {f : A ⟶ C}
    (hf : IsEtale B S hS (yoneda.map f)) : Etale ((BigFppfOver.toScheme B S hS).map f) :=
  (presheaf_yoneda_map_etale_iff B S hS f).1 (presheaf_etale_of_isEtale B S hS hf)

/-- A sieve generated by charts satisfying `P` is a covering sieve when `P` implies `Q` and the
sieve generated by `Q` is a covering. -/
private theorem generate_mem_topology_of_imp {T : SmallEtale B S hS X}
    {P Q : Presieve T} (hPQ : ∀ ⦃T'⦄ (g : T' ⟶ T), P g → Q g)
    (hP : Sieve.generate P ∈ SmallEtale.topology B S hS X T) :
    Sieve.generate Q ∈ SmallEtale.topology B S hS X T := by
  refine (SmallEtale.topology B S hS X).superset_covering ?_ hP
  rw [Sieve.generate_le_iff]
  exact fun T' g hg => ⟨T', 𝟙 _, g, hPQ g hg, Category.id_comp _⟩

/-- **A chart of `X` with a morphism to an algebraic space `Z` is covered by charts on which
that morphism factors through a member of an étale covering of `Z`.**  The fibre products with
the members of the covering form an étale covering of the represented presheaf, and atlases of
those fibre products give an étale covering family of schemes of the chart. -/
theorem generate_mem_of_isEtaleCovering {I : Type v} {Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {Yi : I → (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {qi : ∀ i, Yi i ⟶ Z}
    (hcov : IsEtaleCovering B S hS Yi qi) (T : SmallEtale B S hS X)
    (z : yoneda.obj T.1.left ⟶ Z) :
    Sieve.generate (fun T' (g : T' ⟶ T) => ∃ i, ∃ y : yoneda.obj T'.1.left ⟶ Yi i,
        y ≫ qi i = yoneda.map g.hom.left ≫ z) ∈ SmallEtale.topology B S hS X T := by
  classical
  let Zs : AlgebraicSpaces B S hS := ⟨Z, hcov.target_isAlgebraicSpace⟩
  let Ts : AlgebraicSpaces B S hS := ⟨yoneda.obj T.1.left, isAlgebraicSpace_yoneda B S hS _⟩
  let Ys : I → AlgebraicSpaces B S hS := fun i => ⟨Yi i, hcov.source_isAlgebraicSpace i⟩
  have hpb : IsEtaleCovering B S hS (fun i => pullback (qi i) z)
      (fun i => pullback.snd (qi i) z) :=
    isEtaleCovering_pullback_snd B S hS Ys (fun i => (ObjectProperty.homMk (qi i) : Ys i ⟶ Zs))
      (ObjectProperty.homMk z : Ts ⟶ Zs) hcov
  choose U a hsurj het using fun i => (hpb.source_isAlgebraicSpace i).exists_atlas
  let h : ∀ i, U i ⟶ T.1.left := fun i => yoneda.preimage (a i ≫ pullback.snd (qi i) z)
  have hh : ∀ i, yoneda.map (h i) = a i ≫ pullback.snd (qi i) z := fun i =>
    Functor.map_preimage _ _
  have hEt : ∀ i, Etale ((BigFppfOver.toScheme B S hS).map (h i)) := by
    intro i
    apply etale_toScheme_map_of_isEtale
    rw [hh]
    exact isEtale_comp B S hS (isEtale_of_presheaf_etale B S hS (het i)) (hpb.etale i)
  let E : I → SmallEtale B S hS X := fun i =>
    ⟨CostructuredArrow.mk (yoneda.map (h i) ≫ T.1.hom),
      etale_comp_of_scheme B S hS (h i) T.1.hom (hEt i) T.property⟩
  let φ : ∀ i, E i ⟶ T := fun i => ObjectProperty.homMk (CostructuredArrow.homMk (h i) rfl)
  have hjs : ∀ x : (BigFppfOver.toScheme B S hS).obj T.1.left,
      ∃ i, x ∈ Set.range ((BigFppfOver.toScheme B S hS).map (h i)) :=
    scheme_family_jointly_surjective_of_points B S hS U T.1.left h (by
      refine Set.eq_univ_of_forall fun p => ?_
      have hp : p ∈ ⋃ i, Set.range (pointsMap B S hS (pullback (qi i) z)
          (pullback.snd (qi i) z)) := by
        rw [hpb.jointly_surjective]
        trivial
      obtain ⟨i, w, hw⟩ := Set.mem_iUnion.1 hp
      obtain ⟨v, rfl⟩ := isSurjective_of_presheafSurjective B S hS (a i) (hsurj i) w
      exact Set.mem_iUnion.2 ⟨i, v, by rwa [hh, pointsMap_comp_apply]⟩)
  refine (SmallEtale.topology B S hS X).superset_covering ?_
    (SmallEtale.ofArrows_mem_topology B S hS X E φ
      (Scheme.ofArrows_mem_etalePrecoverage_iff.2 ⟨hjs, hEt⟩))
  rw [Sieve.ofArrows, Sieve.generate_le_iff]
  rintro _ _ ⟨i⟩
  refine ⟨E i, 𝟙 _, φ i, ⟨i, a i ≫ pullback.fst (qi i) z, ?_⟩, Category.id_comp _⟩
  show _ = yoneda.map (h i) ≫ z
  rw [hh, Category.assoc, Category.assoc, pullback.condition]

/-- Opens covering the scheme of a surjective étale morphism `g : A ⟶ P` give an étale
covering of `P` by the open subschemes. -/
private theorem isEtaleCovering_openSubHom_comp {I : Type v} {A : BigFppfOver B S hS}
    {P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hP : IsAlgebraicSpace B S hS P)
    (g : yoneda.obj A ⟶ P)
    (hgs : (MorphismProperty.inverseImage (@AlgebraicGeometry.Surjective.{u} :
      MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS)).presheaf g)
    (hge : IsEtale B S hS g) (O : I → ((BigFppfOver.toScheme B S hS).obj A).Opens)
    (hO : ∀ x, ∃ l, x ∈ (O l : Set ((BigFppfOver.toScheme B S hS).obj A))) :
    IsEtaleCovering B S hS (fun l => yoneda.obj (openSub A (O l)))
      (fun l => yoneda.map (openSubHom A (O l)) ≫ g) := by
  refine ⟨hP, fun l => isAlgebraicSpace_yoneda B S hS _, fun l => ?_, ?_⟩
  · exact isEtale_comp B S hS
      (isEtale_of_presheaf_etale B S hS
        ((presheaf_yoneda_map_etale_iff B S hS _).2 (etale_toScheme_map_openSubHom B S hS _ _)))
      hge
  · refine Set.eq_univ_of_forall fun p => ?_
    obtain ⟨w, rfl⟩ := isSurjective_of_presheafSurjective B S hS g hgs p
    have hjs := jointlySurjective_yoneda_of_scheme B S hS (fun l => openSub A (O l))
      (fun l => openSubHom A (O l)) (fun x => by
        obtain ⟨l, hl⟩ := hO x
        obtain ⟨y', hy'⟩ := (Scheme.Opens.range_ι (O l)).ge hl
        refine ⟨l, y', ?_⟩
        rw [toScheme_map_openSubHom]
        exact hy')
    have hw : w ∈ ⋃ l, Set.range (pointsMap B S hS (yoneda.obj (openSub A (O l)))
        (yoneda.map (openSubHom A (O l)))) := by
      rw [hjs]
      trivial
    obtain ⟨l, w', hw'⟩ := Set.mem_iUnion.1 hw
    exact Set.mem_iUnion.2 ⟨l, w', by rw [pointsMap_comp_apply, hw']⟩

/-- Restricting a morphism of the site whose represented map is étale to an open of its source
gives an étale morphism of schemes. -/
private theorem etale_toScheme_map_openSubHom_comp {A C : BigFppfOver B S hS}
    (O : ((BigFppfOver.toScheme B S hS).obj A).Opens) (f : A ⟶ C)
    (hf : IsEtale B S hS (yoneda.map f)) :
    Etale ((BigFppfOver.toScheme B S hS).map (openSubHom A O ≫ f)) := by
  apply etale_toScheme_map_of_isEtale
  rw [Functor.map_comp]
  exact isEtale_comp B S hS (isEtale_of_presheaf_etale B S hS
    ((presheaf_yoneda_map_etale_iff B S hS _).2 (etale_toScheme_map_openSubHom B S hS _ _))) hf

/-- A chart morphism `d : R ⟶ T` whose underlying morphism factors through an étale
`f : A ⟶ T` lifts to the chart `A` of `X`. -/
private theorem SmallEtale.exists_lift_of_comp_eq {T R : SmallEtale B S hS X}
    {A : BigFppfOver B S hS} (f : A ⟶ T.1.left) (hf : Etale ((BigFppfOver.toScheme B S hS).map f))
    (d : R ⟶ T) (k₀ : R.1.left ⟶ A) (hk : k₀ ≫ f = d.hom.left) :
    ∃ k : R ⟶ (⟨CostructuredArrow.mk (yoneda.map f ≫ T.1.hom),
        etale_comp_of_scheme B S hS f T.1.hom hf T.property⟩ : SmallEtale B S hS X),
      k.hom.left = k₀ ∧ k ≫ ObjectProperty.homMk (CostructuredArrow.homMk f rfl) = d := by
  refine ⟨ObjectProperty.homMk (CostructuredArrow.homMk k₀ ?_), rfl, SmallEtale.hom_ext' hk⟩
  show yoneda.map k₀ ≫ yoneda.map f ≫ T.1.hom = R.1.hom
  rw [← Category.assoc, ← Functor.map_comp, hk, CostructuredArrow.w d.hom]

/-- **Finitely many affine charts covering the fibre product of a quasi-compact chart with a
quasi-compact algebraic space étale over a quasi-separated one.**  For an étale `q : Y ⟶ Z` with
`Y` quasi-compact and `Z` quasi-separated, and a chart `a : T ⟶ Z` of `X` with `T`
quasi-compact, there are finitely many affine charts `E l` with morphisms `e l : E l ⟶ T` and
`y l : E l ⟶ Y` over `Z`, through which every chart over `T` and `Y` locally factors. -/
theorem exists_finite_affine_pullback_cover (hZ : B.Contains (⊤_ Scheme.{u}))
    {Z Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hZa : IsAlgebraicSpace B S hS Z)
    (hZqs : IsAbsolutelyQuasiSeparated B S hS hZ Z) (hY : IsAlgebraicSpace B S hS Y)
    (hYqc : IsQuasiCompactSpace B S hS Y) (q : Y ⟶ Z) (hq : IsEtale B S hS q)
    (T : SmallEtale B S hS X) (hT : CompactSpace (chartScheme T))
    (a : yoneda.obj T.1.left ⟶ Z) :
    ∃ (n : ℕ) (E : Fin n → SmallEtale B S hS X) (e : ∀ l, E l ⟶ T)
      (y : ∀ l, yoneda.obj (E l).1.left ⟶ Y),
      (∀ l, IsAffine (chartScheme (E l))) ∧ (∀ l, y l ≫ q = yoneda.map (e l).hom.left ≫ a) ∧
      ∀ (R : SmallEtale B S hS X) (c : R ⟶ T) (yR : yoneda.obj R.1.left ⟶ Y),
        yR ≫ q = yoneda.map c.hom.left ≫ a →
        Sieve.generate (fun R' (d : R' ⟶ R) => ∃ l, ∃ k : R' ⟶ E l, k ≫ e l = d ≫ c ∧
            yoneda.map k.hom.left ≫ y l = yoneda.map d.hom.left ≫ yR) ∈
          SmallEtale.topology B S hS X R := by
  classical
  have hTa := isAlgebraicSpace_yoneda B S hS T.1.left
  have hPqc : IsQuasiCompactSpace B S hS (pullback a q) :=
    isQuasiCompactSpace_pullback B S hS hZ a q hTa hZa
      (isQuasiCompact_yoneda_of_compact B S hS T.1.left hT) hYqc hZqs
  -- the first projection is étale, as a base change of `q`
  have hfst : IsEtale B S hS (pullback.fst a q) :=
    isEtale_of_isPullback B S hS _ _ _ _
      (AlgebraicSpaces.isPullback_fiberProduct B S hS
        (ObjectProperty.homMk a : (⟨_, hTa⟩ : AlgebraicSpaces B S hS) ⟶ ⟨Z, hZa⟩)
        (ObjectProperty.homMk q : (⟨Y, hY⟩ : AlgebraicSpaces B S hS) ⟶ ⟨Z, hZa⟩)).flip hq
  obtain ⟨Z₀, g, hZ₀, hgs, hge⟩ := hPqc
  obtain ⟨n, O, hO⟩ : ∃ (n : ℕ) (O : Fin n → ((BigFppfOver.toScheme B S hS).obj Z₀).affineOpens),
      ∀ x : (BigFppfOver.toScheme B S hS).obj Z₀, ∃ l, x ∈ (O l : Set _) := by
    have hcomp : IsCompact ((⊤ : ((BigFppfOver.toScheme B S hS).obj Z₀).Opens) :
        Set ((BigFppfOver.toScheme B S hS).obj Z₀)) := by
      rw [TopologicalSpace.Opens.coe_top]
      exact isCompact_univ
    obtain ⟨s, hs, hsU⟩ := (isCompact_iff_finite_and_eq_biUnion_affineOpens
      (X := (BigFppfOver.toScheme B S hS).obj Z₀) (U := ⊤)).1 hcomp
    refine ⟨hs.toFinset.card, fun l => (hs.toFinset.equivFin.symm l).1, fun x => ?_⟩
    have hx : x ∈ (⊤ : ((BigFppfOver.toScheme B S hS).obj Z₀).Opens) := trivial
    rw [hsU] at hx
    obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.1 hx
    obtain ⟨hVs, hxV⟩ := TopologicalSpace.Opens.mem_iSup.1 hV
    exact ⟨hs.toFinset.equivFin ⟨V, hs.mem_toFinset.2 hVs⟩, by simpa using hxV⟩
  let h₀ : Z₀ ⟶ T.1.left := yoneda.preimage (g ≫ pullback.fst a q)
  have hh₀ : yoneda.map h₀ = g ≫ pullback.fst a q := Functor.map_preimage _ _
  let oi : ∀ l, openSub Z₀ (O l : _) ⟶ Z₀ := fun l => openSubHom Z₀ (O l : _)
  have hEt : ∀ l, Etale ((BigFppfOver.toScheme B S hS).map (oi l ≫ h₀)) := fun l =>
    etale_toScheme_map_openSubHom_comp (O l).1 h₀ (by rw [hh₀]; exact isEtale_comp B S hS hge hfst)
  let E : Fin n → SmallEtale B S hS X := fun l =>
    ⟨CostructuredArrow.mk (yoneda.map (oi l ≫ h₀) ≫ T.1.hom),
      etale_comp_of_scheme B S hS _ T.1.hom (hEt l) T.property⟩
  let e : ∀ l, E l ⟶ T := fun l => ObjectProperty.homMk (CostructuredArrow.homMk (oi l ≫ h₀) rfl)
  let y : ∀ l, yoneda.obj (E l).1.left ⟶ Y := fun l =>
    yoneda.map (oi l) ≫ g ≫ pullback.snd a q
  refine ⟨n, E, e, y, fun l => ?_, fun l => ?_, fun R c yR hR => ?_⟩
  · show IsAffine ((BigFppfOver.toScheme B S hS).obj (openSub Z₀ (O l : _)))
    have : IsAffine ((O l : ((BigFppfOver.toScheme B S hS).obj Z₀).Opens) : Scheme) := (O l).2
    exact this
  · show _ = yoneda.map (oi l ≫ h₀) ≫ a
    rw [Functor.map_comp, hh₀]
    simp only [y, Category.assoc, pullback.condition]
  · -- the members `O l ⟶ Z₀ ⟶ T ×_Z Y` form an étale covering of the fibre product
    have hcov : IsEtaleCovering B S hS (fun l => yoneda.obj (openSub Z₀ (O l : _)))
        (fun l => yoneda.map (oi l) ≫ g) :=
      isEtaleCovering_openSubHom_comp (isAlgebraicSpace_pullback B S hS a q hTa hY hZa) g hgs
        hge (fun l => (O l).1) hO
    refine (SmallEtale.topology B S hS X).superset_covering ?_
      (generate_mem_of_isEtaleCovering hcov R (pullback.lift (yoneda.map c.hom.left) yR hR.symm))
    rintro R' d ⟨R'', d₁, d₂, ⟨l, w, hw⟩, rfl⟩
    refine ⟨R'', d₁, d₂, ?_, rfl⟩
    let k₀ : R''.1.left ⟶ openSub Z₀ (O l : _) := yoneda.preimage w
    have hk₀ : yoneda.map k₀ = w := Functor.map_preimage _ _
    have hfst' : k₀ ≫ oi l ≫ h₀ = (d₂ ≫ c).hom.left := yoneda.map_injective (by
      rw [Functor.map_comp, Functor.map_comp, hh₀, hk₀, yoneda_map_comp_left]
      simpa only [Category.assoc, pullback.lift_fst] using
        congrArg (fun m => m ≫ pullback.fst a q) hw)
    obtain ⟨k, hk, hke⟩ := SmallEtale.exists_lift_of_comp_eq (oi l ≫ h₀) (hEt l) (d₂ ≫ c) k₀ hfst'
    refine ⟨l, k, hke, ?_⟩
    show yoneda.map k.hom.left ≫ yoneda.map (oi l) ≫ g ≫ pullback.snd a q = _
    rw [hk, hk₀]
    simpa only [Category.assoc, pullback.lift_snd] using
      congrArg (fun m => m ≫ pullback.snd a q) hw


/-- **Every chart of the target of an elementary distinguished square `(U ⊂ W, f : V ⟶ W)`
locally factors through `U` or through `V`.** -/
theorem generate_mem_of_isElementaryDistinguishedSquare {W V : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hW : IsAlgebraicSpace B S hS W) (U : Subfunctor W) (f : V ⟶ W)
    (h : IsElementaryDistinguishedSquare B S hS hW U f) (T : SmallEtale B S hS X)
    (a : yoneda.obj T.1.left ⟶ W) :
    Sieve.generate (fun T' (g : T' ⟶ T) =>
        (∃ u : yoneda.obj T'.1.left ⟶ U.toFunctor, u ≫ U.ι = yoneda.map g.hom.left ≫ a) ∨
          ∃ v : yoneda.obj T'.1.left ⟶ V, v ≫ f = yoneda.map g.hom.left ≫ a) ∈
      SmallEtale.topology B S hS X T := by
  refine generate_mem_topology_of_imp ?_
    (generate_mem_of_isEtaleCovering
      (isEtaleCovering_of_isElementaryDistinguishedSquare B S hS hW U f h) T a)
  rintro T' g ⟨i, y, hy⟩
  cases i
  · exact Or.inl ⟨y, hy⟩
  · exact Or.inr ⟨y, hy⟩

/-- **Two charts of the étale member of an elementary distinguished square with the same image
in the target locally agree or lie over the open subspace.** -/
theorem generate_mem_of_isElementaryDistinguishedSquare_overlap
    {W V : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hW : IsAlgebraicSpace B S hS W) (U : Subfunctor W) (f : V ⟶ W)
    (h : IsElementaryDistinguishedSquare B S hS hW U f) (T : SmallEtale B S hS X)
    (v₁ v₂ : yoneda.obj T.1.left ⟶ V) (hv : v₁ ≫ f = v₂ ≫ f) :
    Sieve.generate (fun T' (g : T' ⟶ T) =>
        yoneda.map g.hom.left ≫ v₁ = yoneda.map g.hom.left ≫ v₂ ∨
          ∃ u : yoneda.obj T'.1.left ⟶ U.toFunctor,
            u ≫ U.ι = yoneda.map g.hom.left ≫ v₁ ≫ f) ∈
      SmallEtale.topology B S hS X T := by
  refine generate_mem_topology_of_imp ?_
    (generate_mem_of_isEtaleCovering
      (isEtaleCovering_overlap_of_isElementaryDistinguishedSquare B S hS hW U f h) T
      (pullback.lift v₁ v₂ hv))
  rintro T' g ⟨i, y, hy⟩
  cases i
  · refine Or.inl ?_
    have h₁ := congrArg (fun m => m ≫ pullback.fst f f) hy
    have h₂ := congrArg (fun m => m ≫ pullback.snd f f) hy
    simp only [Category.assoc, pullback.lift_fst, pullback.lift_snd] at h₁ h₂
    change y ≫ pullback.diagonal f ≫ pullback.fst f f = _ at h₁
    change y ≫ pullback.diagonal f ≫ pullback.snd f f = _ at h₂
    rw [pullback.diagonal_fst, Category.comp_id] at h₁
    rw [pullback.diagonal_snd, Category.comp_id] at h₂
    exact h₁.symm.trans h₂
  · refine Or.inr ⟨y ≫ pullback.fst _ _, ?_⟩
    have h₁ := congrArg (fun m => m ≫ pullback.fst f f ≫ f) hy
    simp only [Category.assoc, pullback.lift_fst_assoc] at h₁
    change y ≫ pullback.snd U.ι (pullback.fst f f ≫ f) ≫ pullback.fst f f ≫ f = _ at h₁
    exact (Category.assoc _ _ _).trans ((congrArg (fun m => y ≫ m)
      (pullback.condition (f := U.ι) (g := pullback.fst f f ≫ f))).trans h₁)

end AlgebraicGeometry.Space

