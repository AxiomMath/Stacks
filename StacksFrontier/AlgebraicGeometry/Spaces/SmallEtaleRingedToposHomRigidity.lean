-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

/-! ### The rigidity argument in the abstract -/

namespace AlgebraicGeometry.Space

open Stacks.Sites

universe u v w

/-- The rigidity argument, with everything but the bare bookkeeping abstracted away.

`A` is a family of "sections", functorial in the object by `Amap`; `τ` is an endomorphism of that
family, natural in the object; `E` corepresents it by an object `Q`; and `c` is a family of maps
out of `Q`, jointly monic, which corepresents a family `r` of sections that `τ` fixes.  Then `τ`
is the identity. -/
private theorem eq_self_of_corepresented {𝒞 : Type*} [Category 𝒞] {A : 𝒞 → Type*}
    (Amap : ∀ {G H : 𝒞}, (G ⟶ H) → A G → A H) (τ : ∀ G : 𝒞, A G → A G)
    (hτ : ∀ {G H : 𝒞} (q : G ⟶ H) (a : A G), Amap q (τ G a) = τ H (Amap q a))
    (Q : 𝒞) (E : ∀ G : 𝒞, A G ≃ (Q ⟶ G))
    (hE : ∀ {G H : 𝒞} (q : G ⟶ H) (a : A G), E H (Amap q a) = E G a ≫ q)
    {I : Type*} (O : 𝒞) (r : I → A O) (c : I → (Q ⟶ O)) (hc : ∀ i, E O (r i) = c i)
    (hfix : ∀ i, τ O (r i) = r i)
    (hjoint : ∀ g h : Q ⟶ Q, (∀ i, g ≫ c i = h ≫ c i) → g = h)
    (F : 𝒞) (s : A F) : τ F s = s := by
  have ha : E Q ((E Q).symm (𝟙 Q)) = 𝟙 Q := Equiv.apply_symm_apply _ _
  have hac (i : I) : Amap (c i) ((E Q).symm (𝟙 Q)) = r i := by
    refine (E O).injective ?_
    rw [hE, ha, Category.id_comp, hc]
  have hid : E Q (τ Q ((E Q).symm (𝟙 Q))) = 𝟙 Q := by
    refine hjoint _ _ fun i ↦ ?_
    rw [← hE, hτ, hac, hfix, hc, Category.id_comp]
  have ht : τ Q ((E Q).symm (𝟙 Q)) = (E Q).symm (𝟙 Q) := (E Q).injective (hid.trans ha.symm)
  have hs : Amap (E F s) ((E Q).symm (𝟙 Q)) = s := by
    refine (E F).injective ?_
    rw [hE, ha, Category.id_comp]
  rw [← hs, ← hτ, ht]

/-! ### Sections of a sheaf through a cover-dense subsite -/

/-- `Stacks.Sites.denseYonedaEquiv` is natural in the sheaf. -/
private theorem denseYonedaEquiv_symm_naturality {C : Type v} [Category.{u} C] {D : Type w}
    [Category.{u + 1} D] (K : GrothendieckTopology D) (I : C ⥤ D) [I.IsCoverDense K]
    [I.IsLocallyFull K] (Z : D) (P : Cᵒᵖ ⥤ Type u)
    (e : I.op ⋙ yoneda.obj Z ≅ P ⋙ uliftFunctor.{u + 1, u})
    {H H' : Sheaf K (Type u)} (q : H ⟶ H') (s : H.obj.obj (op Z)) :
    (denseYonedaEquiv K I Z P e H).symm s ≫ Functor.whiskerLeft I.op q.hom =
      (denseYonedaEquiv K I Z P e H').symm (q.hom.app (op Z) s) := by
  ext U x
  let k := e.inv.app U (ULift.up x)
  have hx : (e.hom.app U k).down = x := by
    have hh := ConcreteCategory.congr_hom (e.inv_hom_id_app U)
      (show (P ⋙ uliftFunctor.{u + 1, u}).obj U from ULift.up x)
    exact congrArg (fun z : ULift.{u + 1, u} (P.obj U) ↦ z.down) hh
  show q.hom.app (I.op.obj U) (((denseYonedaEquiv K I Z P e H).symm s).app U x) =
    ((denseYonedaEquiv K I Z P e H').symm (q.hom.app (op Z) s)).app U x
  rw [← hx]
  calc _ = q.hom.app (I.op.obj U) (H.obj.map k.op s) :=
        congrArg (fun z ↦ q.hom.app (I.op.obj U) z)
          (denseYonedaEquiv_symm_apply K I Z P e H s U k)
    _ = H'.obj.map k.op (q.hom.app (op Z) s) :=
        ConcreteCategory.congr_hom (q.hom.naturality k.op) s
    _ = _ := (denseYonedaEquiv_symm_apply K I Z P e H' (q.hom.app (op Z) s) U k).symm

/-! ### The presheaf of chart morphisms over a fixed chart of the target -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)

/-- A morphism from an étale scheme chart of `X` into the cartesian base change `X ×_Y V`, read
as a section of `AlgebraicGeometry.Space.chartFiber`: it is the chartwise morphism of
Stacks 03G4. -/
noncomputable def chartFiberOfBaseChangeArrow (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (h : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    (chartFiber B S hS f V).toFunctor.obj (op U) :=
  ⟨chartBaseChangeMap B S hS f V (StructuredArrow.mk (Y := op U) h.op),
    chartBaseChangeMap_comm B S hS f U V h⟩

/-- A section of `AlgebraicGeometry.Space.chartFiber`, read as a morphism into the cartesian
base change `X ×_Y V`. -/
noncomputable def baseChangeArrowOfChartFiber (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1) (g : (chartFiber B S hS f V).toFunctor.obj (op U)) :
    (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V :=
  baseChangeArrowOfChartDiagram B S hS f ⟨U, V, g.1, g.2⟩

/-- The two constructions are mutually inverse. -/
theorem chartFiberOfBaseChangeArrow_baseChangeArrow (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1) (g : (chartFiber B S hS f V).toFunctor.obj (op U)) :
    chartFiberOfBaseChangeArrow B S hS f V U
        (baseChangeArrowOfChartFiber B S hS f V U g) = g :=
  Subtype.ext (chartDiagramOfBaseChangeArrow_baseChangeArrow_g B S hS f ⟨U, V, g.1, g.2⟩)

/-- The two constructions are mutually inverse. -/
theorem baseChangeArrowOfChartFiber_chartFiberOfBaseChangeArrow (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (h : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    baseChangeArrowOfChartFiber B S hS f V U
        (chartFiberOfBaseChangeArrow B S hS f V U h) = h :=
  baseChangeArrowOfChartDiagram_chartDiagram B S hS f U V h

/-- Reading a morphism into the cartesian base change as a section of
`AlgebraicGeometry.Space.chartFiber` is natural in the chart of `X`. -/
theorem chartFiberOfBaseChangeArrow_naturality (V : SmallEtale B S hS Y.1)
    {U U' : SmallEtale B S hS X.1} (i : U' ⟶ U)
    (h : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    chartFiberOfBaseChangeArrow B S hS f V U'
        ((comparisonFunctor B S hS X).map i ≫ h) =
      (chartFiber B S hS f V).toFunctor.map i.op
        (chartFiberOfBaseChangeArrow B S hS f V U h) :=
  Subtype.ext <| chartBaseChangeMap_comp B S hS f V (j₁ := StructuredArrow.mk (Y := op U) h.op)
    (j₂ := StructuredArrow.mk (Y := op U') ((comparisonFunctor B S hS X).map i ≫ h).op)
    (StructuredArrow.homMk i.op rfl)

/-- The morphism into the cartesian base change attached to a section of
`AlgebraicGeometry.Space.chartFiber` composes with the cartesian projection to the Yoneda
morphism of that section.  This is the hypothesis of
`AlgebraicGeometry.Space.IsChartCorrespondence`. -/
theorem baseChangeArrowOfChartFiber_projection_heq (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1) (g : (chartFiber B S hS f V).toFunctor.obj (op U)) :
    HEq (((SpacesEtale.toSpaces B S hS X).map
        (baseChangeArrowOfChartFiber B S hS f V U g) ≫
      (spacesBaseChange B S hS f).projection.app
        ((comparisonFunctor B S hS Y).obj V)).hom) (yoneda.map g.1) :=
  heq_of_eq (yoneda_map_baseChangeArrowOfChartDiagram B S hS f ⟨U, V, g.1, g.2⟩)

/-! ### The sections of the direct image over a chart of the target -/

/-- The direct image of `AlgebraicGeometry.Space.smallEtaleRingedToposHom`, read through the
comparison equivalence of Stacks 03G1 as the spaces-étale direct image. -/
noncomputable def pushforwardComparison :
    (smallEtaleRingedToposHom B S hS f).toToposHom.pushforward ≅
      (smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse ⋙
        spacesDirectImageRestrictionTypeU B S hS f :=
  (Functor.leftUnitor _).symm ≪≫
    Functor.isoWhiskerRight
      (smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.symm
      (smallEtaleRingedToposHom B S hS f).toToposHom.pushforward ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse
      (smallEtaleRingedToposHom_pushforward B S hS f)

/-- The sections of the direct image of a sheaf `F` over an étale scheme chart `V` of `Y` are the
maps of `AlgebraicGeometry.Space.chartFiber` into `F`: by Stacks 03G4 a section of the direct
image is a compatible family of sections of `F` over the étale scheme charts of `X` above
`X ×_Y V`, and those charts are the sections of `chartFiber`. -/
noncomputable def sectionEquivChartFiberHom (V : SmallEtale B S hS Y.1)
    (F : Sheaf (SmallEtale.topology B S hS X.1) (Type u)) :
    (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj F).obj.obj (op V)) ≃
      ((chartFiber B S hS f V).toFunctor ⟶ F.obj) :=
  have := Functor.IsDenseSubsite.isCoverDense (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  have := Functor.IsDenseSubsite.isLocallyFull (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  ((((sheafToPresheaf (SmallEtale.topology B S hS Y.1) (Type u)).mapIso
    ((pushforwardComparison B S hS f).app F)).app (op V)).toEquiv).trans
    ((denseYonedaEquiv (SpacesEtale.topology B S hS X)
      (comparisonFunctor B S hS X) _ (chartFiber B S hS f V).toFunctor
      (chartFiberLiftIso B S hS f V)
      ((smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse.obj F)).symm.trans
      ((Iso.refl _).homCongr
        ((sheafToPresheaf (SmallEtale.topology B S hS X.1) (Type u)).mapIso
          ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app F))))

/-- The map attached to a section of the direct image, evaluated at the section of
`AlgebraicGeometry.Space.chartFiber` coming from a morphism into the cartesian base change: it is
restriction of the section along that morphism. -/
private theorem sectionEquivChartFiberHom_apply (V : SmallEtale B S hS Y.1)
    (F : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (s : (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj F).obj.obj (op V)))
    (U : SmallEtale B S hS X.1)
    (h : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    ((sectionEquivChartFiberHom B S hS f V F) s).app (op U)
        (chartFiberOfBaseChangeArrow B S hS f V U h) =
      ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app F).hom.hom.app
        (op U)
        (((smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse.obj F).obj.map h.op
          (((pushforwardComparison B S hS f).hom.app F).hom.app (op V) s)) :=
  have := Functor.IsDenseSubsite.isCoverDense (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  have := Functor.IsDenseSubsite.isLocallyFull (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  congrArg
    (fun z ↦ ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app F).hom.hom.app
      (op U) z)
    (denseYonedaEquiv_symm_apply _ _ _ _ (chartFiberLiftIso B S hS f V) _ _ (op U) h)

/-- Two maps out of `AlgebraicGeometry.Space.chartFiber` agree if they agree on the sections
coming from morphisms into the cartesian base change. -/
private theorem chartFiber_hom_ext (V : SmallEtale B S hS Y.1)
    {F : Sheaf (SmallEtale.topology B S hS X.1) (Type u)}
    {φ ψ : (chartFiber B S hS f V).toFunctor ⟶ F.obj}
    (H : ∀ (U : SmallEtale B S hS X.1) (g : (chartFiber B S hS f V).toFunctor.obj (op U)),
      φ.app (op U) (chartFiberOfBaseChangeArrow B S hS f V U
          (baseChangeArrowOfChartFiber B S hS f V U g)) =
        ψ.app (op U) (chartFiberOfBaseChangeArrow B S hS f V U
          (baseChangeArrowOfChartFiber B S hS f V U g))) :
    φ = ψ := by
  apply NatTrans.ext
  funext U
  obtain ⟨U⟩ := U
  apply TypeCat.homEquiv.injective
  funext g
  have := H U g
  rwa [chartFiberOfBaseChangeArrow_baseChangeArrow] at this

/-- The description of the sections of the direct image is natural in the sheaf. -/
theorem sectionEquivChartFiberHom_naturality (V : SmallEtale B S hS Y.1)
    {F G : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : F ⟶ G)
    (s : (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj F).obj.obj (op V))) :
    sectionEquivChartFiberHom B S hS f V G
        (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map q).hom.app (op V) s) =
      sectionEquivChartFiberHom B S hS f V F s ≫ q.hom := by
  refine chartFiber_hom_ext B S hS f V fun U g ↦ ?_
  generalize baseChangeArrowOfChartFiber B S hS f V U g = h
  show ((sectionEquivChartFiberHom B S hS f V G)
      (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map q).hom.app
        (op V) s)).app (op U) (chartFiberOfBaseChangeArrow B S hS f V U h) =
    q.hom.app (op U) ((sectionEquivChartFiberHom B S hS f V F s).app (op U)
      (chartFiberOfBaseChangeArrow B S hS f V U h))
  rw [sectionEquivChartFiberHom_apply, sectionEquivChartFiberHom_apply]
  have hd := ConcreteCategory.congr_hom (congr_app (congrArg (fun z ↦ z.hom)
    ((pushforwardComparison B S hS f).hom.naturality q)) (op V)) s
  change ((pushforwardComparison B S hS f).hom.app G).hom.app (op V)
      (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map q).hom.app (op V) s) =
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse.map q).hom.app _
      (((pushforwardComparison B S hS f).hom.app F).hom.app (op V) s) at hd
  rw [hd]
  have hn := ConcreteCategory.congr_hom
    (((smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse.map q).hom.naturality
      h.op)
    (((pushforwardComparison B S hS f).hom.app F).hom.app (op V) s)
  have hc := congr_app (congrArg (fun z ↦ z.hom)
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.hom.naturality q)) (op U)
  exact (congrArg (fun z ↦
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app G).hom.hom.app
      (op U) z) hn.symm).trans (ConcreteCategory.congr_hom hc _)

/-- The section of the direct image of the structure sheaf given by the structure map goes, under
the description of the sections, to the coordinate map of the corresponding regular function on
`V`.  This is the chartwise formula for the structure map, Stacks 03G8. -/
theorem sectionEquivChartFiberHom_fSharp (V : SmallEtale B S hS Y.1)
    (b : Γ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Y.1).obj V), ⊤)) :
    sectionEquivChartFiberHom B S hS f V (structureSetSheaf B S hS X)
        ((AlgebraicGeometry.RingedToposHom.forgetFSharp
          (smallEtaleRingedToposHom B S hS f)).hom.app (op V) b) =
      chartFiberCoordinate B S hS f V b := by
  refine chartFiber_hom_ext B S hS f V fun U g ↦ ?_
  have hg := chartFiberOfBaseChangeArrow_baseChangeArrow B S hS f V U g
  refine (sectionEquivChartFiberHom_apply B S hS f V (structureSetSheaf B S hS X)
    ((AlgebraicGeometry.RingedToposHom.forgetFSharp
      (smallEtaleRingedToposHom B S hS f)).hom.app (op V) b) U
    (baseChangeArrowOfChartFiber B S hS f V U g)).trans ?_
  have hc := fMapEquivPushforwardHom_ringUniverse_chart B S hS f
    (structureSetSheaf B S hS X) (structureSetSheaf B S hS Y)
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.inverse.obj
      (structureSetSheaf B S hS X))
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app
      (structureSetSheaf B S hS X)).symm
    ((fMapEquivPushforwardHom_ringUniverse B S hS f (structureSetSheaf B S hS X)
      (structureSetSheaf B S hS Y)).symm
        (AlgebraicGeometry.RingedToposHom.forgetFSharp (smallEtaleRingedToposHom B S hS f)))
    ⟨U, V, g.1, g.2⟩ (baseChangeArrowOfChartFiber B S hS f V U g)
    (baseChangeArrowOfChartFiber_projection_heq B S hS f V U g) b
  have hξ : fMapEquivPushforwardHom_ringUniverse B S hS f (structureSetSheaf B S hS X)
      (structureSetSheaf B S hS Y)
      ((fMapEquivPushforwardHom_ringUniverse B S hS f (structureSetSheaf B S hS X)
        (structureSetSheaf B S hS Y)).symm
          (AlgebraicGeometry.RingedToposHom.forgetFSharp
            (smallEtaleRingedToposHom B S hS f))) =
      AlgebraicGeometry.RingedToposHom.forgetFSharp (smallEtaleRingedToposHom B S hS f) :=
    Equiv.apply_symm_apply _ _
  dsimp only at hc
  rw [hξ] at hc
  have hh := congrArg (fun z ↦
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app
      (structureSetSheaf B S hS X)).hom.hom.app (op U) z) hc.symm
  have hi := ConcreteCategory.congr_hom (congr_app (congrArg (fun z ↦ z.hom)
    ((smallEtaleComparisonRestriction B S hS X).asEquivalence.counitIso.app
      (structureSetSheaf B S hS X)).inv_hom_id) (op U))
    (((fMapEquivPushforwardHom_ringUniverse B S hS f (structureSetSheaf B S hS X)
      (structureSetSheaf B S hS Y)).symm
        (AlgebraicGeometry.RingedToposHom.forgetFSharp
          (smallEtaleRingedToposHom B S hS f))).app ⟨U, V, g.1, g.2⟩ b)
  refine (hh.trans hi).trans ?_
  rw [hg]
  exact smallEtaleRingedToposHom_chart B S hS f ⟨U, V, g.1, g.2⟩ b

/-! ### Rigidity -/

/-- The rigidity argument, with the corepresenting sheaf kept abstract.

Suppose the sections over a fixed étale scheme chart `V` of `Y` of the direct images of the
sheaves on the small étale site of `X` are corepresented by a single sheaf `Q`, naturally in the
sheaf; that a family `c` of maps out of `Q` is the image of the structure map under the
corepresentation; and that `c` is jointly monic.  Then a 2-endomorphism of the morphism of small
étale ringed topoi acts as the identity on those sections. -/
private theorem twoMorphism_app_eq_id_of_corepresentation
    (t : AlgebraicGeometry.RingedToposHom.TwoMorphism.{u, u + 1, u, u, u + 1, u}
      (smallEtaleRingedToposHom B S hS f)
      (smallEtaleRingedToposHom B S hS f))
    (V : SmallEtale B S hS Y.1) (Q : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (E : (G : Sheaf (SmallEtale.topology B S hS X.1) (Type u)) →
      (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj G).obj.obj (op V)) ≃
        (Q ⟶ G))
    (hEnat : ∀ {G H : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : G ⟶ H)
      (a : ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj G).obj.obj (op V)),
      E H (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map q).hom.app (op V) a) =
        E G a ≫ q)
    (c : Γ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Y.1).obj V), ⊤) →
      (Q ⟶ structureSetSheaf B S hS X))
    (hcE : ∀ b : Γ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Y.1).obj V), ⊤),
      E (structureSetSheaf B S hS X)
      ((AlgebraicGeometry.RingedToposHom.forgetFSharp
        (smallEtaleRingedToposHom B S hS f)).hom.app (op V) b) = c b)
    (hjoint : ∀ g h : Q ⟶ Q, (∀ b, g ≫ c b = h ≫ c b) → g = h)
    (F : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (s : (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj F).obj.obj (op V))) :
    (t.t.app F).hom.app (op V) s = s :=
  eq_self_of_corepresented
    (A := fun G ↦
      ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj G).obj.obj (op V))
    (fun q a ↦ ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map q).hom.app
      (op V) a)
    (fun G a ↦ (t.t.app G).hom.app (op V) a)
    (fun q a ↦ (ConcreteCategory.congr_hom
      (congr_app (congrArg (fun z ↦ z.hom) (t.t.naturality q)) (op V)) a).symm)
    Q E (fun q a ↦ hEnat q a) (structureSetSheaf B S hS X)
    (fun b ↦ (AlgebraicGeometry.RingedToposHom.forgetFSharp
      (smallEtaleRingedToposHom B S hS f)).hom.app (op V) b)
    c hcE
    (fun b ↦ ConcreteCategory.congr_hom
      (congr_app (congrArg (fun z ↦ z.hom) t.commutes) (op V)) b)
    hjoint F s

section Affine

variable (V : SmallEtale B S hS Y.1)
  [IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)]

/-- Over an affine étale scheme chart `V` of `Y`, the sections of the direct image of a sheaf on
the small étale site of `X` are the maps into it out of the subsheaf generated by the image of
the coordinate map: the maps out of `AlgebraicGeometry.Space.chartFiber` factor uniquely through
that subsheaf because the coordinate map is a monomorphism. -/
private noncomputable def sectionEquivSheafOfMono
    (G : Sheaf (SmallEtale.topology B S hS X.1) (Type u)) :
    (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj G).obj.obj (op V)) ≃
      (sheafOfMono (chartCoordinateMap B S hS f V) ⟶ G) :=
  (sectionEquivChartFiberHom B S hS f V G).trans
    (sheafOfMonoHomEquiv (chartCoordinateMap B S hS f V) G).symm

/-- The map corresponding to a section of the direct image restricts on
`AlgebraicGeometry.Space.chartFiber` to the map of
`AlgebraicGeometry.Space.sectionEquivChartFiberHom`. -/
private theorem sheafOfMonoUnit_sectionEquivSheafOfMono
    (G : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (a : ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj G).obj.obj (op V)) :
    sheafOfMonoUnit (chartCoordinateMap B S hS f V) ≫
        (sectionEquivSheafOfMono B S hS f V G a).hom =
      sectionEquivChartFiberHom B S hS f V G a :=
  (sheafOfMonoHomEquiv (chartCoordinateMap B S hS f V) G).apply_symm_apply _

/-- The corepresentation of the sections of the direct image is natural in the sheaf. -/
private theorem sectionEquivSheafOfMono_naturality
    {G H : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : G ⟶ H)
    (a : ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj G).obj.obj (op V)) :
    sectionEquivSheafOfMono B S hS f V H
        (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map q).hom.app (op V) a) =
      sectionEquivSheafOfMono B S hS f V G a ≫ q := by
  refine sheafOfMono_hom_ext (chartCoordinateMap B S hS f V) _ _ ?_
  show sheafOfMonoUnit (chartCoordinateMap B S hS f V) ≫
      (sectionEquivSheafOfMono B S hS f V H _).hom =
    sheafOfMonoUnit (chartCoordinateMap B S hS f V) ≫
      (sectionEquivSheafOfMono B S hS f V G a).hom ≫ q.hom
  rw [sheafOfMonoUnit_sectionEquivSheafOfMono, ← Category.assoc,
    sheafOfMonoUnit_sectionEquivSheafOfMono]
  exact sectionEquivChartFiberHom_naturality B S hS f V q a

/-- Under the corepresentation the section of the direct image of the structure sheaf given by
the structure map goes to the extension of the coordinate of the corresponding regular
function. -/
private theorem sectionEquivSheafOfMono_fSharp
    (b : Γ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Y.1).obj V), ⊤)) :
    sectionEquivSheafOfMono B S hS f V (structureSetSheaf B S hS X)
        ((AlgebraicGeometry.RingedToposHom.forgetFSharp
          (smallEtaleRingedToposHom B S hS f)).hom.app (op V) b) =
      sheafOfMonoLift (chartCoordinateMap B S hS f V)
        (chartFiberCoordinate B S hS f V b) := by
  show (sheafOfMonoHomEquiv (chartCoordinateMap B S hS f V) _).symm
    (sectionEquivChartFiberHom B S hS f V (structureSetSheaf B S hS X) _) = _
  rw [sectionEquivChartFiberHom_fSharp]
  rfl

/-- A 2-endomorphism of the morphism of small étale ringed topoi acts as the identity on the
sections of every direct image over an *affine* étale scheme chart of `Y`. -/
private theorem twoMorphism_app_eq_id_on_affine
    (t : AlgebraicGeometry.RingedToposHom.TwoMorphism.{u, u + 1, u, u, u + 1, u}
      (smallEtaleRingedToposHom B S hS f)
      (smallEtaleRingedToposHom B S hS f))
    (F : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (s : (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj F).obj.obj (op V))) :
    (t.t.app F).hom.app (op V) s = s := by
  refine twoMorphism_app_eq_id_of_corepresentation B S hS f t V
    (sheafOfMono (chartCoordinateMap B S hS f V)) (sectionEquivSheafOfMono B S hS f V)
    (fun q a ↦ sectionEquivSheafOfMono_naturality B S hS f V q a)
    (fun b ↦ sheafOfMonoLift (chartCoordinateMap B S hS f V)
      (chartFiberCoordinate B S hS f V b))
    (fun b ↦ sectionEquivSheafOfMono_fSharp B S hS f V b) (fun g h hgh ↦ ?_) F s
  refine sheafOfMono_hom_ext_of_pi
    (fun _ : (structureSetSheaf B S hS Y).obj.obj (op V) => structureSetSheaf B S hS X)
    (chartCoordinateMap B S hS f V) g h (fun b ↦ ?_)
  rw [show chartCoordinateMap B S hS f V ≫
      (Pi.π (fun _ : (structureSetSheaf B S hS Y).obj.obj (op V) =>
        structureSetSheaf B S hS X) b).hom =
      chartFiberCoordinate B S hS f V b from chartCoordinateMap_π B S hS f V b]
  exact hgh b

end Affine

/-- The transformation of direct-image functors underlying a 2-endomorphism of the morphism of
small étale ringed topoi is the identity: affine étale scheme charts of `Y` are a dense subsite
of its small étale site by Stacks 04JS, and
`AlgebraicGeometry.Space.twoMorphism_app_eq_id_on_affine` is the statement over one of them. -/
private theorem twoMorphism_natTrans_eq_id
    (t : AlgebraicGeometry.RingedToposHom.TwoMorphism.{u, u + 1, u, u, u + 1, u}
      (smallEtaleRingedToposHom B S hS f)
      (smallEtaleRingedToposHom B S hS f)) :
    t.t = 𝟙 (smallEtaleRingedToposHom B S hS f).toToposHom.pushforward := by
  have hsub : (AffineEtale.inclusion B S hS Y.1).IsDenseSubsite
      (AffineEtale.topology B S hS Y.1) (SmallEtale.topology B S hS Y.1) :=
    (AffineEtale.inclusion_isSpecialCocontinuous B S hS Y.1 Y.2).2
  have := Functor.IsDenseSubsite.isCoverDense (AffineEtale.topology B S hS Y.1)
    (SmallEtale.topology B S hS Y.1) (AffineEtale.inclusion B S hS Y.1)
  have := Functor.IsDenseSubsite.isLocallyFull (AffineEtale.topology B S hS Y.1)
    (SmallEtale.topology B S hS Y.1) (AffineEtale.inclusion B S hS Y.1)
  apply NatTrans.ext
  funext F
  apply ((AffineEtale.inclusion B S hS Y.1).sheafPushforwardContinuous (Type u)
    (AffineEtale.topology B S hS Y.1) (SmallEtale.topology B S hS Y.1)).map_injective
  apply Sheaf.hom_ext
  ext U s
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj U.unop.obj.1.left) := U.unop.property
  exact twoMorphism_app_eq_id_on_affine B S hS f U.unop.obj t F s

/-- **Stacks 04KK.** A 2-endomorphism of the morphism of small étale ringed topoi induced by a
morphism of algebraic spaces is the identity. -/
@[stacks 04KK]
theorem smallEtaleRingedToposHom_twoMorphism_eq_id
    (t : AlgebraicGeometry.RingedToposHom.TwoMorphism.{u, u + 1, u, u, u + 1, u}
      (smallEtaleRingedToposHom B S hS f)
      (smallEtaleRingedToposHom B S hS f)) :
    t = AlgebraicGeometry.RingedToposHom.TwoMorphism.id
      (smallEtaleRingedToposHom B S hS f) := by
  apply AlgebraicGeometry.RingedToposHom.TwoMorphism.ext
  exact twoMorphism_natTrans_eq_id B S hS f t

end AlgebraicGeometry.Space

end
