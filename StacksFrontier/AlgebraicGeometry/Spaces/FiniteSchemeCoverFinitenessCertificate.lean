module

public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteSchemeCoverChartSquares
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceApproximation

/-!
# Finiteness of a closed subspace read on one chart

Let `q : P ⟶ X` be a morphism of algebraic spaces and `ψ : h_Z ⟶ P` the base change of a
surjective étale chart `v : h_V ⟶ X` with `Z` and `V` affine. If an ideal `I` of `Γ(Z)` makes
`Γ(Z) ⧸ I` finite over `Γ(V)`, then every closed subspace `T ⊆ P` whose ideal on `Z` contains `I`
is finite over `X`: its base change to `V` is a closed subscheme of `Spec Γ(Z) ⧸ I`.

In the proof of Stacks 0GUN this is how monic equations for generators of a finitely presented
algebra, imposed on the closed subspace of finite presentation, make it finite.

## Main results

* `AlgebraicGeometry.Space.isFinite_ι_comp_of_ofIdealTop_le_chartKer`.
* `AlgebraicGeometry.Space.range_yoneda_map_le_idealPoints`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A morphism of the site lands in the closed subscheme cut out by an ideal sheaf contained in its
kernel. -/
theorem range_yoneda_map_le_idealPoints {W Z : BigFppfOver B S hS} (f : W ⟶ Z)
    (J : ((BigFppfOver.toScheme B S hS).obj Z).IdealSheafData)
    (hJ : J ≤ ((BigFppfOver.toScheme B S hS).map f).ker) :
    Subfunctor.range (yoneda.map f) ≤ idealPoints B S hS J := by
  have key : (((BigFppfOver.toScheme B S hS).map f).toImage ≫
      Scheme.IdealSheafData.inclusion hJ) ≫ J.subschemeι = (BigFppfOver.toScheme B S hS).map f := by
    rw [Category.assoc, Scheme.IdealSheafData.inclusion_subschemeι]
    exact Scheme.Hom.toImage_imageι _
  have hf : f ∈ (idealPoints B S hS J).obj (op W) := by
    rw [mem_subschemePoints_iff]
    exact (Subobject.mk_factors_iff _ _).2 ⟨_, key⟩
  rintro T _ ⟨h, rfl⟩
  exact (idealPoints B S hS J).map h.op hf

/-- A closed subspace whose ideal on a chart contains an ideal with finite quotient is finite. -/
theorem isFinite_ι_comp_of_ofIdealTop_le_chartKer {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (P : AlgebraicSpaces B S hS) (q : P.1 ⟶ X)
    {V Z : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj Z)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
    (v : yoneda.obj V ⟶ X) (hvs : IsSurjective B S hS v) (hve : IsEtale B S hS v)
    (ψ : yoneda.obj Z ⟶ P.1) (π : Z ⟶ V) (hsq : IsPullback ψ (yoneda.map π) q v)
    (I : Ideal Γ((BigFppfOver.toScheme B S hS).obj Z, ⊤))
    (hI : RingHom.Finite ((Ideal.Quotient.mk I).comp
      ((BigFppfOver.toScheme B S hS).map π).appTop.hom))
    (T : ClosedSubspaces B S hS P.1)
    (hT : Scheme.IdealSheafData.ofIdealTop I ≤ chartKer B S hS P T ψ) :
    IsFinite B S hS (T.1.ι ≫ q) := by
  let G := BigFppfOver.toScheme B S hS
  let R := T.2.2.rep
  let i := R.snd ψ
  have : _root_.AlgebraicGeometry.IsClosedImmersion (G.map i) := T.2.2.property_snd ψ
  have : IsAffine (G.obj (R.pullback ψ)) := isAffine_of_isAffineHom (G.map i)
  -- `I` is killed on the base change of `T`.
  have hker : I ≤ RingHom.ker (G.map i).appTop.hom := by
    have h : Scheme.IdealSheafData.ofIdealTop I ≤ (G.map i).ker := hT
    rw [Scheme.ker_of_isAffine] at h
    exact (map_le_map_iff (Scheme.IdealSheafData.equivOfIsAffine (X := G.obj Z)).symm).1 h
  let lift := Ideal.Quotient.lift I (G.map i).appTop.hom hker
  have hfin : RingHom.Finite (G.map (i ≫ π)).appTop.hom := by
    have : (G.map (i ≫ π)).appTop.hom =
        lift.comp ((Ideal.Quotient.mk I).comp (G.map π).appTop.hom) := by
      rw [Functor.map_comp, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
      ext x
      rfl
    rw [this]
    exact (RingHom.Finite.of_surjective lift (Ideal.Quotient.lift_surjective_of_surjective I hker
      ((G.map i).app_surjective ⊤ (isAffineOpen_top _)))).comp hI
  have hschfin : _root_.AlgebraicGeometry.IsFinite (G.map (i ≫ π)) := by
    have : MorphismProperty.RespectsIso
        (@_root_.AlgebraicGeometry.IsFinite.{u} : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsStableUnderBaseChange.respectsIso
    exact (MorphismProperty.arrow_mk_iso_iff _ (arrowIsoSpecΓOfIsAffine (G.map (i ≫ π)))).2
      ((IsFinite.SpecMap_iff _).2 hfin)
  have big := (R.isPullback ψ).paste_vert hsq
  refine isFinite_of_surjectiveEtaleChart B S hS T.2.1 hX _ hvs hve ?_
  have h : pullback.snd (T.1.ι ≫ q) v = big.isoPullback.inv ≫ (yoneda.map i ≫ yoneda.map π) :=
    big.isoPullback_inv_snd.symm
  rw [h]
  exact isFinite_comp B S hS (isFinite_of_isIso B S hS _)
    (by rw [← Functor.map_comp]; exact (isFinite_yoneda_map_iff B S hS _).2 hschfin)

/-- **Monic equations for generators make a quotient finite.** If `f : R →+* A` makes `A` an
`R`-algebra generated by the finite set `s`, and every `x ∈ s` has a monic polynomial `P x` over
`R`, then `A` modulo the ideal generated by the values `P x (x)` is finite over `R`. -/
theorem finite_comp_quotient_span_eval₂ {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A)
    (s : Finset A) (hs : letI := f.toAlgebra; Algebra.adjoin R (s : Set A) = ⊤)
    (P : A → Polynomial R) (hP : ∀ x ∈ s, (P x).Monic) :
    RingHom.Finite ((Ideal.Quotient.mk
      (Ideal.span ((fun x => Polynomial.eval₂ f x (P x)) '' (s : Set A)))).comp f) := by
  let := f.toAlgebra
  set I := Ideal.span ((fun x => Polynomial.eval₂ f x (P x)) '' (s : Set A))
  let q := Ideal.Quotient.mkₐ R I
  have h1 : Algebra.adjoin R (q '' (s : Set A)) = ⊤ := by
    rw [Algebra.adjoin_image, hs, Algebra.map_top]
    exact (AlgHom.range_eq_top q).2 (Ideal.Quotient.mkₐ_surjective R I)
  have h2 : ∀ y ∈ q '' (s : Set A), _root_.IsIntegral R y := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨P x, hP x hx, ?_⟩
    have h0 : Ideal.Quotient.mk I (Polynomial.eval₂ f x (P x)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨x, hx, rfl⟩)
    rwa [Polynomial.hom_eval₂] at h0
  have h3 := fg_adjoin_of_finite ((s : Set A).toFinite.image q) h2
  rw [h1, Algebra.top_toSubmodule] at h3
  exact RingHom.finite_algebraMap.2 ⟨h3⟩

end AlgebraicGeometry.Space

end
