module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceFromQuasicoherentIdeal
public import StacksFrontier.AlgebraicGeometry.Spaces.UniversalFirstOrderThickening
public import StacksFrontier.AlgebraicGeometry.Spaces.ZeroSchemeProperties

/-!
# The closed subspace cut out by finitely many global regular functions

Let `X` be an algebraic space over a scheme `S` contained in a big fppf site, and let
`f₁, …, f_r ∈ Γ(X, 𝒪_X)`.  This file constructs the closed subspace `V(f₁, …, f_r) ⊆ X` cut out
by `f₁, …, f_r`: the intersection, in the lattice of subfunctors of `X`, of the closed subspaces
whose defining ideal on every affine étale chart `U` is contained in the ideal of `𝒪_X(U)`
generated by the restrictions `f₁|_U, …, f_r|_U`.

## Main definitions

* `AlgebraicGeometry.Space.unitSectionValue` is the value of a global regular function on an étale
  chart.
* `AlgebraicGeometry.Space.vanishingIdealAt` is the ideal generated on an étale chart by the
  restrictions of the given functions.
* `AlgebraicGeometry.Space.vanishingSubfunctor` and
  `AlgebraicGeometry.Space.vanishingSubspace` are `V(f₁, …, f_r)` as a subfunctor of `X` and as
  a bundled closed subspace of `X`.

## Main results

* `AlgebraicGeometry.Space.vanishingSubfunctor_isClosedSubspace`: `V(f₁, …, f_r)` is a closed
  subspace of `X`.
* `AlgebraicGeometry.Space.vanishingSubfunctor_le` and
  `AlgebraicGeometry.Space.le_vanishingSubfunctor`: the two bounds comparing `V(f₁, …, f_r)`
  with a closed subspace whose chart ideals are bounded by the ideal of the functions.
* `AlgebraicGeometry.Space.vanishingSubfunctor_eq`: a closed subspace whose defining ideal on
  every affine étale chart *is* the ideal of the functions is `V(f₁, …, f_r)`.
* `AlgebraicGeometry.Space.exists_vanishingSubfunctor_eq_of_isQuasicoherentOnSite`: such a
  closed subspace exists as soon as the ideal of the functions is the ideal sheaf of a
  quasi-coherent sheaf of ideals, by the surjectivity half of Stacks 03MB.
* `AlgebraicGeometry.Space.vanishingSubfunctor_isEmpty`: the empty family cuts out the whole of
  `X`.
* `AlgebraicGeometry.Space.vanishingSubfunctor_eq_zeroSchemeSubfunctor`: for a single function
  `V(f)` is the zero scheme of Stacks 0845 of `f` seen as a global section of `𝒪_X` as a module
  over itself.

## Implementation notes

The construction is the one of `AlgebraicGeometry.Space.zeroSchemeSubfunctor` with the
evaluation ideal of a section of an `𝒪_X`-module replaced by the ideal generated by a family of
global functions, and closedness is the same infimum theorem
`AlgebraicGeometry.Space.isClosedSubspace_sInf`.  Stacks 0845 cuts out the zero scheme of *one*
section of *one* module, and reading `V(f₁, …, f_r)` off it would mean presenting the family as
a single section of the free module `𝒪_X^r` and identifying the evaluation ideal of that section
with the ideal of the family; the direct form here avoids that detour, and the two agree for a
single function by `vanishingSubfunctor_eq_zeroSchemeSubfunctor`.

What the infimum gives unconditionally is an upper bound: every closed subspace whose chart
ideals are contained in the ideal of the family contains `V(f₁, …, f_r)`.  The *reverse*
containment, and with it the identification of the defining ideal of `V(f₁, …, f_r)` with the
ideal of the family, is the surjectivity half of Stacks 03MB, which
`AlgebraicGeometry.Space.exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite` now supplies for
a quasi-coherent sheaf of ideals; `vanishingSubfunctor_eq` is phrased so that it is exactly what
that half has to produce.

## References

* [Stacks Project, Section 06LV](https://stacks.math.columbia.edu/tag/06LV)
* [Stacks Project, Tag 03MB](https://stacks.math.columbia.edu/tag/03MB)
* [Stacks Project, Tag 0845](https://stacks.math.columbia.edu/tag/0845)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The value on an étale chart of a global regular function on an algebraic space. -/
noncomputable def unitSectionValue (X : AlgebraicSpaces B S hS)
    (a : (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : (SmallEtale B S hS X.1)ᵒᵖ) : ToType ((structureRingSheaf B S hS X).obj.obj U) :=
  a.eval U

/-- The ideal of the regular functions on an étale chart `U` of `X` generated by the
restrictions to `U` of a family of global regular functions on `X`. -/
noncomputable def vanishingIdealAt (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : SmallEtale B S hS X.1) :
    Ideal (ToType ((structureRingSheaf B S hS X).obj.obj (op U))) :=
  Ideal.span (Set.range fun i => unitSectionValue B S hS X (f i) (op U))

/-- The closed subspace `V(f₁, …, f_r) ⊆ X` cut out by finitely many global regular functions:
the intersection of the closed subspaces of `X` whose defining ideal on every affine étale chart
is contained in the ideal generated by the restrictions of the functions. -/
noncomputable def vanishingSubfunctor (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    Subfunctor X.1 :=
  sInf {Z | ∃ hZ : IsClosedSubspace B S hS Z,
    ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X ⟨Z, hZ⟩ (op U) ≤ vanishingIdealAt B S hS X f U}

/-- `V(f₁, …, f_r)` is a closed subspace of `X`: it is an intersection of closed subspaces. -/
theorem vanishingSubfunctor_isClosedSubspace (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    IsClosedSubspace B S hS (vanishingSubfunctor B S hS X f) :=
  isClosedSubspace_sInf B S hS X.2 _ fun _ hZ => hZ.elim fun h _ => h

/-- `V(f₁, …, f_r)`, bundled as a closed subspace of `X`. -/
noncomputable abbrev vanishingSubspace (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    ClosedSubspaces B S hS X.1 :=
  ⟨vanishingSubfunctor B S hS X f, vanishingSubfunctor_isClosedSubspace B S hS X f⟩

/-- `V(f₁, …, f_r)` is contained in every closed subspace whose defining ideal on the affine
étale charts is contained in the ideal of the functions: such a subspace is a member of the
family being intersected. -/
theorem vanishingSubfunctor_le (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) ≤ vanishingIdealAt B S hS X f U) :
    vanishingSubfunctor B S hS X f ≤ Z.1 :=
  sInf_le ⟨Z.2, h⟩

/-- A closed subspace whose defining ideal on every affine étale chart contains the ideal of the
functions — chartwise, a closed subspace on which the functions vanish — is contained in
`V(f₁, …, f_r)`. -/
theorem le_vanishingSubfunctor (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      vanishingIdealAt B S hS X f U ≤ definingIdealAt B S hS X Z (op U)) :
    Z.1 ≤ vanishingSubfunctor B S hS X f := by
  refine le_sInf ?_
  rintro W ⟨hW, hWle⟩
  exact le_of_forall_definingIdealAt_le B S hS X Z ⟨W, hW⟩
    fun U hU => (hWle U hU).trans (h U hU)

/-- A closed subspace of `X` whose defining ideal on every affine étale chart is the ideal
generated by `f₁, …, f_r` is `V(f₁, …, f_r)`. -/
theorem vanishingSubfunctor_eq (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = vanishingIdealAt B S hS X f U) :
    vanishingSubfunctor B S hS X f = Z.1 :=
  le_antisymm (vanishingSubfunctor_le B S hS X f Z fun U hU => (h U hU).le)
    (le_vanishingSubfunctor B S hS X f Z fun U hU => (h U hU).ge)

/-- **`V(f₁, …, f_r)` is the closed subspace cut out by the ideal of the functions as soon as
that ideal is quasi-coherent.**  The surjectivity half of Stacks 03MB turns a quasi-coherent
sheaf of ideals matching the ideal of the functions on the affine étale charts into a closed
subspace, and that subspace is `V(f₁, …, f_r)`. -/
theorem exists_vanishingSubfunctor_eq_of_isQuasicoherentOnSite (X : AlgebraicSpaces B S hS)
    {r : ℕ} (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)
    (hN : N.toSheafOfModules.IsQuasicoherentOnSite)
    (hmatch : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      N.obj (op U) = vanishingIdealAt B S hS X f U) :
    ∃ Z : ClosedSubspaces B S hS X.1,
      vanishingSubfunctor B S hS X f = Z.1 ∧ definingIdealSheaf B S hS X Z = N := by
  obtain ⟨Z, hZ⟩ := exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS X N hN
  refine ⟨Z, vanishingSubfunctor_eq B S hS X f Z fun U hU => ?_, hZ⟩
  rw [← hmatch U hU, ← definingIdealSheaf_obj B S hS X Z (op U), hZ]

/-- The ideal generated on a chart by the empty family of functions is zero. -/
theorem vanishingIdealAt_isEmpty (X : AlgebraicSpaces B S hS) {r : ℕ} [IsEmpty (Fin r)]
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : SmallEtale B S hS X.1) :
    vanishingIdealAt B S hS X f U = ⊥ := by
  rw [vanishingIdealAt, Set.range_eq_empty, Ideal.span_empty]

/-- **The empty family of functions cuts out the whole of `X`.**  Its ideal on every chart is
zero, and the only closed subspace of `X` with zero defining ideal is `X` itself. -/
theorem vanishingSubfunctor_isEmpty (X : AlgebraicSpaces B S hS) {r : ℕ} [IsEmpty (Fin r)]
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    vanishingSubfunctor B S hS X f = ⊤ := by
  refine le_antisymm le_top ?_
  have hret : (ObjectProperty.homMk (inv (⊤ : Subfunctor X.1).ι) :
      X ⟶ (⟨(⊤ : Subfunctor X.1).toFunctor, (isClosedSubspace_top B S hS X).1⟩ :
        AlgebraicSpaces B S hS)) ≫ ObjectProperty.homMk (⊤ : Subfunctor X.1).ι = 𝟙 X := by
    apply ObjectProperty.hom_ext
    exact IsIso.inv_hom_id _
  exact le_vanishingSubfunctor B S hS X f ⟨⊤, isClosedSubspace_top B S hS X⟩ fun U hU => by
    rw [vanishingIdealAt_isEmpty B S hS X f U,
      definingIdealAt_eq_bot_of_retraction B S hS X ⟨⊤, isClosedSubspace_top B S hS X⟩ _ hret
        (op U)]

/-- **The ideal of a single global function is the evaluation ideal of Stacks 0845** for that
function seen as a global section of `𝒪_X` as a module over itself. -/
theorem vanishingIdealAt_eq_sectionEvaluationIdealAt (X : AlgebraicSpaces B S hS)
    (a : (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : SmallEtale B S hS X.1) :
    vanishingIdealAt B S hS X (fun _ : Fin 1 => a) U =
      sectionEvaluationIdealAt B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X)) a U :=
  by
  let l₀ : Module.Dual ((structureRingSheaf B S hS X).obj.obj (op U))
      ((SheafOfModules.unit (structureRingSheaf B S hS X)).val.obj (op U)) := LinearMap.id
  have hid : ∀ x, l₀ x • (1 : ToType ((structureRingSheaf B S hS X).obj.obj (op U))) = x :=
    fun x => mul_one (M := ToType ((structureRingSheaf B S hS X).obj.obj (op U))) x
  rw [sectionEvaluationIdealAt_eq_span_singleton B S hS X
    (SheafOfModules.unit (structureRingSheaf B S hS X)) a U
    (1 : ToType ((structureRingSheaf B S hS X).obj.obj (op U))) l₀ hid,
    vanishingIdealAt]
  congr 1
  simp only [Set.range_const]
  rfl

/-- **`V(f)` of a single global function is the zero scheme of Stacks 0845** of that function,
seen as a global section of `𝒪_X` as a module over itself. -/
theorem vanishingSubfunctor_eq_zeroSchemeSubfunctor (X : AlgebraicSpaces B S hS)
    (a : (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    vanishingSubfunctor B S hS X (fun _ : Fin 1 => a) =
      zeroSchemeSubfunctor B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X)) a := by
  rw [vanishingSubfunctor, zeroSchemeSubfunctor_eq_sInf B S hS X
    (SheafOfModules.unit (structureRingSheaf B S hS X)) a]
  congr 1
  ext Z
  simp only [Set.mem_ofPred_eq]
  exact exists_congr fun hZ => forall_congr' fun U => forall_congr' fun _ => by
    rw [vanishingIdealAt_eq_sectionEvaluationIdealAt]

end AlgebraicGeometry.Space

end
