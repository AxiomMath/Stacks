module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.Separated
public import StacksFrontier.AlgebraicGeometry.Spaces.TwistedDoubledOriginEtaleRelation

/-!
# The relation of the twisted doubled origin is not closed in the product of the chart

The relation `R = Δ(U) ⨿ Δ'(U ∖ {0})` of the twisted doubled origin maps to the absolute
product `U ⨯ U` of two copies of the chart by its two projections.  That map is an immersion,
because `R` is an open subscheme of the self-product `U ×_S U` over the base and the
self-product is a subscheme of the absolute product; but it is **not** a closed immersion,
because the puncture `U ∖ {0}` is not closed in the chart.  This failure is the geometric
content of the non-separatedness of the twisted doubled origin: the diagonal of the quotient
is the base change of this map along the atlas of the quotient.

## Main definitions

* `AlgebraicGeometry.TwistedDoubledOrigin.relationToProduct` is the map from the relation
  scheme to the absolute product of two copies of the chart given by its two projections.

## Main results

* `AlgebraicGeometry.TwistedDoubledOrigin.relationToProduct_eq` factors it through the
  self-product of the chart over the base.
* `AlgebraicGeometry.TwistedDoubledOrigin.mono_relationToProduct`: it is a monomorphism.
* `AlgebraicGeometry.TwistedDoubledOrigin.relationToProduct_not_isClosedImmersion`: it is not
  a closed immersion.

## Implementation notes

The map to the absolute product factors as the inclusion of the relation into the
self-product over the base followed by the canonical map `U ×_S U ⟶ U ⨯ U`, and that
canonical map is a monomorphism, hence separated.  So if the composite were a closed
immersion then the inclusion of the relation into the self-product would be one as well; by
`AlgebraicGeometry.TwistedDoubledOrigin.relationToSelfProduct_eq` that inclusion is
`U ⨿ (U ∖ {0}) ⟶ U ⨿ U`, whose base change along the second coprojection is the inclusion of
the puncture.  The puncture is a nonempty open subscheme of the irreducible scheme
`U = Spec K[x]`, hence dense, so it is not closed: the prime ideal generated by `x` is in its
closure and not in it.

This statement carries no `@[stacks 03FN]` attribute.  It is an input to the clause
`not_separated` of that tag, whose conclusion is about the diagonal of the quotient sheaf,
not about the relation scheme.

## References

* [Stacks Project, Tag 03FN](https://stacks.math.columbia.edu/tag/03FN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.TwistedDoubledOrigin

variable (k K : Type u) [Field k] [Field K] [Algebra k K]

/-- The canonical map from a fibre product to the absolute product is a monomorphism: a pair
of morphisms into a fibre product is determined by its two projections. -/
private theorem mono_prod_lift_pullback {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) :
    Mono (prod.lift (pullback.fst f g) (pullback.snd f g)) :=
  ⟨fun a b h => pullback.hom_ext
    (by simpa using congrArg (fun φ => φ ≫ prod.fst) h)
    (by simpa using congrArg (fun φ => φ ≫ prod.snd) h)⟩

/-- The relation scheme with its two projections, as a map to the absolute product of two
copies of the chart. -/
def relationToProduct (σ : K ≃ₐ[k] K) : relationScheme K ⟶ cover K ⨯ cover K :=
  prod.lift (relationFirst k K).left (relationSecond k K σ).left

/-- The map to the absolute product factors through the self-product of the chart over the
base. -/
theorem relationToProduct_eq (σ : K ≃ₐ[k] K) :
    relationToProduct k K σ =
      relationToSelfProduct k K σ ≫
        prod.lift (pullback.fst (coverMap k K) (coverMap k K))
          (pullback.snd (coverMap k K) (coverMap k K)) := by
  refine prod.hom_ext ?_ ?_
  · rw [relationToProduct, prod.lift_fst, Category.assoc, prod.lift_fst,
      relationToSelfProduct, pullback.lift_fst]
  · rw [relationToProduct, prod.lift_snd, Category.assoc, prod.lift_snd,
      relationToSelfProduct, pullback.lift_snd]

/-- The relation injects into the absolute product of two copies of the chart. -/
theorem mono_relationToProduct [FiniteDimensional k K] [IsGalois k K]
    (hdegree : Module.finrank k K = 2) (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1) :
    Mono (relationToProduct k K σ) := by
  have h₁ : Mono (relationToSelfProduct k K σ) :=
    have := isOpenImmersion_relationToSelfProduct k K hdegree σ hσ
    inferInstance
  have h₂ := mono_prod_lift_pullback (coverMap k K) (coverMap k K)
  rw [relationToProduct_eq]
  exact mono_comp _ _

/-- The puncture of the chart is not a closed subscheme: it is a nonempty open subscheme of
an irreducible scheme, hence dense, and it is proper because the prime ideal generated by the
coordinate is not in it. -/
theorem not_isClosedImmersion_puncturedCover_ι :
    ¬ _root_.AlgebraicGeometry.IsClosedImmersion (puncturedCover K).ι := by
  intro h
  have hclosed : IsClosed ((puncturedCover K : Set (cover K))) := by
    rw [← Scheme.Opens.range_ι (U := puncturedCover K)]
    exact (IsClosedImmersion.isClosedEmbedding (puncturedCover K).ι).isClosed_range
  have : PreirreducibleSpace (cover K) := by
    change PreirreducibleSpace (PrimeSpectrum (Polynomial K)); infer_instance
  have hdense : Dense ((puncturedCover K : Set (cover K))) := by
    refine (puncturedCover K).isOpen.dense ⟨⟨⊥, inferInstance⟩, ?_⟩
    exact Polynomial.X_ne_zero
  have huniv : (puncturedCover K : Set (cover K)) = Set.univ := by
    rw [← hclosed.closure_eq, hdense.closure_eq]
  have hprime : (Ideal.span {(Polynomial.X : Polynomial K)}).IsPrime :=
    (Ideal.span_singleton_prime Polynomial.X_ne_zero).2 Polynomial.prime_X
  have hmem : (⟨Ideal.span {(Polynomial.X : Polynomial K)}, hprime⟩ :
      PrimeSpectrum (Polynomial K)) ∈ (puncturedCover K : Set (cover K)) := by
    rw [huniv]; trivial
  exact (PrimeSpectrum.mem_basicOpen _ _).1 hmem (Ideal.mem_span_singleton_self _)

/-- **The relation of the twisted doubled origin is not closed in the product of the chart.**
If it were, the inclusion of the puncture into the chart would be a closed immersion.

This is the geometric input to the clause `not_separated` of Stacks 03FN, which it does not
itself state: that clause says the quotient sheaf is not separated, and deducing it from this
needs the diagonal of the quotient to be identified with a base change of this map, which in
turn needs the quotient's atlas to be a kernel-pair quotient
(`AlgebraicGeometry.Space.isPullback_toQuotientSheaf_bigFppf`). -/
theorem relationToProduct_not_isClosedImmersion [FiniteDimensional k K] [IsGalois k K]
    (hdegree : Module.finrank k K = 2) (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1) :
    ¬ _root_.AlgebraicGeometry.IsClosedImmersion (relationToProduct k K σ) := by
  intro h
  rw [relationToProduct_eq] at h
  have hmono := mono_prod_lift_pullback (coverMap k K) (coverMap k K)
  have hsplit : _root_.AlgebraicGeometry.IsClosedImmersion (relationToSelfProduct k K σ) :=
    IsClosedImmersion.of_comp (relationToSelfProduct k K σ)
      (prod.lift (pullback.fst (coverMap k K) (coverMap k K))
        (pullback.snd (coverMap k K) (coverMap k K)))
  rw [relationToSelfProduct_eq k K hdegree σ hσ,
    MorphismProperty.cancel_right_of_respectsIso
      (P := @_root_.AlgebraicGeometry.IsClosedImmersion)] at hsplit
  exact not_isClosedImmersion_puncturedCover_ι K
    (MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @_root_.AlgebraicGeometry.IsClosedImmersion)
      (isPullback_inr_inr_coprodMap (𝟙 (cover K)) (puncturedCover K).ι).flip hsplit)

end AlgebraicGeometry.TwistedDoubledOrigin

end
