module

public import StacksFrontier.AlgebraicGeometry.Spaces.PushforwardIdealImage

/-!
# The image of the ideal generated by a submodule of a direct image

Let `f : Y ⟶ X` and `g : Z ⟶ X` be morphisms of algebraic spaces with `g` affine, and let
`t : g_*𝒪_Z ⟶ f_*𝒪_Y` be a map of `𝒪_X`-modules which is multiplicative on sections.  For a
submodule `ℳ ⊆ g_*𝒪_Z`, cartesian on affine charts, and a sheaf of ideals `ℐ ⊆ 𝒪_Y` with
`t(ℳ) ⊆ f_*ℐ`, the image under `t` of the direct image `g_*(ℳ · 𝒪_Z)` of the ideal generated by
`ℳ` (`AlgebraicGeometry.Space.submoduleIdeal`) still lies in `f_*ℐ`.

Over an affine chart `Q` of `X` a section of `g_*(ℳ · 𝒪_Z)` lies in the ideal of the ring of
`Q ×_X Z` generated by the sections of `ℳ` over `Q`
(`AlgebraicGeometry.Space.mem_submoduleChartSpan_of_mem_submoduleIdeal_of_isAffine`), so its
image is a combination `∑ t(aᵢ) t(mᵢ)` with `t(mᵢ) ∈ ℐ(Q ×_X Y)`, which is an ideal.  Membership
in `f_*ℐ` is local on `X`, and every chart is covered by affine ones.

## Main results

* `AlgebraicGeometry.Space.imageSubmodule_pushforwardSubmodule_submoduleIdeal_le`: the image
  under `t` of `g_*(ℳ · 𝒪_Z)` lies in `f_*ℐ`.

## References

* [Stacks Project, Tag 0GV1](https://stacks.math.columbia.edu/tag/0GV1)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.SheafOfModules.ImageSubsheaf

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X Y Z : AlgebraicSpaces B S hS} {f : Y ⟶ X} {hf : yoneda.relativelyRepresentable f.hom}
  {g : Z ⟶ X} {hg : yoneda.relativelyRepresentable g.hom}
  (t : chartBaseChangeStructureModule B S hS g hg ⟶ chartBaseChangeStructureModule B S hS f hf)
  (M : ((smallBaseChangeModulePushforward.{u, u} B S hS g hg).obj
    (SheafOfModules.unit (smallEtaleRingSheaf B S hS Z.1 Z.2))).Submodule)
  (I : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).Submodule)

/-- Over an affine chart, the image of a section of `g_*(ℳ · 𝒪_Z)` lies in `f_*ℐ`. -/
private theorem mem_pushforwardSubmodule_of_mem_submoduleIdeal_of_isAffine
    (hmul : ∀ (Q : SmallEtale B S hS X.1)
      (a b : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)),
        t.val.app (op Q) (a * b) =
          @HMul.hMul (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q))
            (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q))
            (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)) instHMul
            (t.val.app (op Q) a) (t.val.app (op Q) b))
    (hMc : IsCartesianOnAffineCharts (hF := X.2) M.toSheafOfModules)
    (haff : IsAffineHom B S hS g.hom)
    (hM : ∀ (Q : SmallEtale B S hS X.1)
      (m : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)),
        m ∈ M.obj (op Q) → t.val.app (op Q) m ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q))
    (Q : SmallEtale B S hS X.1)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    {x : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)}
    (hx : x ∈ (submoduleIdeal B S hS g hg M).obj (op ((smallBaseChange B S hS g hg).obj Q))) :
    t.val.app (op Q) x ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q) := by
  refine Submodule.span_induction
    (p := fun (x : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)) _ =>
      t.val.app (op Q) x ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q))
    ?_ ?_ ?_ ?_
    (mem_submoduleChartSpan_of_mem_submoduleIdeal_of_isAffine B S hS g hg hMc haff Q hQ hx)
  · exact hM Q
  · exact (congrArg (· ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q))
      (map_zero (ConcreteCategory.hom (t.val.app (op Q))))).mpr (zero_mem _)
  · intro a b _ _ ha hb
    exact (congrArg (· ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q))
      (map_add (ConcreteCategory.hom (t.val.app (op Q))) a b)).mpr (add_mem ha hb)
  · intro a b _ hb
    rw [smul_eq_mul, hmul Q a b]
    exact (I.obj (op ((smallBaseChange B S hS f hf).obj Q))).smul_mem _ hb

/-- Over any chart, the image of a section of `g_*(ℳ · 𝒪_Z)` lies in `f_*ℐ`. -/
private theorem mem_pushforwardSubmodule_of_mem_submoduleIdeal
    (hmul : ∀ (Q : SmallEtale B S hS X.1)
      (a b : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)),
        t.val.app (op Q) (a * b) =
          @HMul.hMul (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q))
            (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q))
            (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)) instHMul
            (t.val.app (op Q) a) (t.val.app (op Q) b))
    (hMc : IsCartesianOnAffineCharts (hF := X.2) M.toSheafOfModules)
    (haff : IsAffineHom B S hS g.hom)
    (hM : ∀ (Q : SmallEtale B S hS X.1)
      (m : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)),
        m ∈ M.obj (op Q) → t.val.app (op Q) m ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q))
    (W : SmallEtale B S hS X.1)
    {x : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj W)}
    (hx : x ∈ (submoduleIdeal B S hS g hg M).obj (op ((smallBaseChange B S hS g hg).obj W))) :
    t.val.app (op W) x ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op W) := by
  obtain ⟨ι, Zc, c, hZaff, hcov, -⟩ := SmallEtale.exists_affine_etale_ofArrows B S hS X.1 W
  refine (pushforwardSubmodule B S hS f hf _ I).isSheaf (t.val.app (op W) x)
    ((SmallEtale.topology B S hS X.1).superset_covering ?_ hcov)
  intro V h hh
  obtain ⟨j, k, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hh
  have hj : t.val.app (op (Zc j))
      ((chartBaseChangeStructureModule B S hS g hg).val.map (c j).op x) ∈
        (pushforwardSubmodule B S hS f hf _ I).obj (op (Zc j)) :=
    mem_pushforwardSubmodule_of_mem_submoduleIdeal_of_isAffine t M I hmul hMc haff hM (Zc j)
      (hZaff j) ((submoduleIdeal B S hS g hg M).map_mem ((smallBaseChange B S hS g hg).map (c j)).op
        hx)
  have hj' : (chartBaseChangeStructureModule B S hS f hf).val.map (c j).op (t.val.app (op W) x) ∈
      (pushforwardSubmodule B S hS f hf _ I).obj (op (Zc j)) :=
    (PresheafOfModules.naturality_apply (X := op W) (Y := op (Zc j)) t.val (c j).op x) ▸ hj
  change (chartBaseChangeStructureModule B S hS f hf).val.map ((c j).op ≫ k.op)
    (t.val.app (op W) x) ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op V)
  exact (congrArg (· ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op V))
    (PresheafOfModules.map_comp_apply (U := op W) (V := op (Zc j)) (W := op V)
      (chartBaseChangeStructureModule B S hS f hf).val (c j).op k.op
      (t.val.app (op W) x))).mpr ((pushforwardSubmodule B S hS f hf _ I).map_mem k.op hj')

/-- **The image of the direct image of the ideal generated by a submodule.**  Let `g : Z ⟶ X` be
affine, `t : g_*𝒪_Z ⟶ f_*𝒪_Y` a map of `𝒪_X`-modules which is multiplicative on sections,
`ℳ ⊆ g_*𝒪_Z` a submodule cartesian on affine charts and `ℐ ⊆ 𝒪_Y` a sheaf of ideals such that
`t` maps `ℳ` into `f_*ℐ`.  Then the image under `t` of the direct image `g_*(ℳ · 𝒪_Z)` of the
ideal generated by `ℳ` lies in `f_*ℐ`. -/
theorem imageSubmodule_pushforwardSubmodule_submoduleIdeal_le
    (hmul : ∀ (Q : SmallEtale B S hS X.1)
      (a b : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)),
        t.val.app (op Q) (a * b) =
          @HMul.hMul (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q))
            (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q))
            (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)) instHMul
            (t.val.app (op Q) a) (t.val.app (op Q) b))
    (hMc : IsCartesianOnAffineCharts (hF := X.2) M.toSheafOfModules)
    (haff : IsAffineHom B S hS g.hom)
    (hM : ∀ (Q : SmallEtale B S hS X.1)
      (m : chartSectionsRing B S hS Z ((smallBaseChange B S hS g hg).obj Q)),
        m ∈ M.obj (op Q) → t.val.app (op Q) m ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op Q)) :
    imageSubmodule ((pushforwardSubmodule B S hS g hg _ (submoduleIdeal B S hS g hg M)).ι ≫ t) ≤
      pushforwardSubmodule B S hS f hf _ I := by
  rintro ⟨Q⟩ y hy
  refine (pushforwardSubmodule B S hS f hf _ I).isSheaf y
    ((SmallEtale.topology B S hS X.1).superset_covering ?_ hy)
  intro W h hh
  obtain ⟨⟨x, hx⟩, hxy⟩ := (sieveOfSection_rangeSubmodule_apply
    ((pushforwardSubmodule B S hS g hg _ (submoduleIdeal B S hS g hg M)).ι ≫ t) y h).1 hh
  have hxy' : t.val.app (op W) x = (chartBaseChangeStructureModule B S hS f hf).val.map h.op y :=
    hxy
  exact (congrArg (· ∈ (pushforwardSubmodule B S hS f hf _ I).obj (op W)) hxy').mp
    (mem_pushforwardSubmodule_of_mem_submoduleIdeal t M I hmul hMc haff hM W hx)

end AlgebraicGeometry.Space

end
