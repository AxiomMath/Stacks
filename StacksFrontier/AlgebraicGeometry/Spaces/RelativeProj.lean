@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Space

universe u m

/-- **Stacks 0849.** A scheme `S`, an algebraic space `X` over `S`, and a quasi-coherent graded
`𝒪_X`-algebra, commutative and concentrated in nonnegative degrees: the data from which the
relative homogeneous spectrum `Proj_X(𝒜)` is built. -/
@[stacks 0849]
structure RelativeProjSituation where
  /-- The ambient big fppf site. -/
  site : BigFppfSite.{u}
  /-- The base scheme. -/
  base : Scheme.{u}
  /-- The base scheme belongs to the ambient big fppf site. -/
  containsBase : site.Contains base
  /-- The algebraic space over the base. -/
  space : AlgebraicSpaces site base containsBase
  /-- The graded `𝒪_X`-algebra. -/
  algebra : SheafOfModules.GradedAlgebra.{u, m, u, u + 1}
    (structureRingSheaf site base containsBase space)
  /-- Multiplication of homogeneous sections is commutative. -/
  mul_comm (i j : ℤ) (U : (SmallEtale site base containsBase space.1)ᵒᵖ)
      (a : (algebra.piece i).val.obj U) (b : (algebra.piece j).val.obj U) :
    HEq ((algebra.mul i j).app U a b) ((algebra.mul j i).app U b a)
  /-- The homogeneous pieces of negative degree vanish. -/
  negative_isZero (n : ℤ) (hn : n < 0) : Limits.IsZero (algebra.piece n)
  /-- Each homogeneous piece is quasi-coherent. -/
  isQuasicoherent (n : ℤ) : (algebra.piece n).IsQuasicoherentOnSite
  /-- The homogeneous sections are bounded by the size cutoff of the chosen big fppf site: the
  standing set-theoretic convention of Stacks 025T and 000H, made explicit.

  This is not an extra hypothesis on Situation 0849: the world `Sch_fppf` of the source is
  chosen, by the standing convention of Stacks 025T, to contain every object under
  consideration, the relative Proj of `𝒜` included.  Without it the functor of Stacks 084A
  need not be an algebraic space over the site: for `S = X = Spec k` and `𝒜 = k[x_i : i ∈ I]`
  with `I` of cardinality at least the cutoff, `Proj(𝒜)` has an affine chart that is not an
  object of the site (Stacks 000P). -/
  sections_hasCardinalLT (n : ℤ) (U : (SmallEtale site base containsBase space.1)ᵒᵖ) :
    HasCardinalLT ↥((algebra.piece n).val.obj U) site.cutoff

attribute [instance] RelativeProjSituation.isQuasicoherent

/-! ### The relative Proj, read on a surjective étale scheme chart -/

section ChartData

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The relative Proj of an algebraic space, presented on a surjective étale scheme chart.**

Data exhibiting a morphism `π : P ⟶ X` of algebraic spaces over `S` as a relative homogeneous
spectrum: a surjective étale scheme chart `V ⟶ X`, a relative Proj situation `t` of
Stacks 01NN whose base is the scheme underlying `V`, and a cartesian square identifying
`P ×_X V` with the scheme `Proj_V(t)` of Stacks 01NQ over `V`.

This is what Stacks 084B provides for `π : Proj_X(𝒜) ⟶ X`: its second assertion is a canonical
isomorphism `Proj_Z(g^*𝒜) = Z ×_X Proj_X(𝒜)` for every scheme `Z` over `X`, and the discussion
following Stacks 084C applies it to a surjective étale chart `Z = V`, with `t` the situation of
`g^*𝒜` on `V`.  It is also all that the proofs of Stacks 084F and 084G use: each reads a
property of `π` off this one square, by an étale-local-on-the-target criterion, and then quotes
the case of schemes. -/
structure RelativeProjChart {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (π : P ⟶ X)
    (t : Stacks.RelativeProj.Situation.{u}) where
  /-- The scheme chart of the target. -/
  chart : BigFppfOver B S hS
  /-- The structure morphism of the chart. -/
  chartHom : yoneda.obj chart ⟶ X
  /-- The chart is étale over the target. -/
  chartHom_etale : (MorphismProperty.inverseImage
    (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS)).presheaf chartHom
  /-- The chart is surjective onto the target. -/
  chartHom_surjective : (MorphismProperty.inverseImage
    (@AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS)).presheaf chartHom
  /-- The scheme underlying the chart is the base of the relative Proj situation. -/
  baseIso : (BigFppfOver.toScheme B S hS).obj chart ≅ t.base
  /-- The scheme chart of the source, lying over the chart of the target. -/
  proj : BigFppfOver B S hS
  /-- Its structure morphism to the chart of the target. -/
  projHom : proj ⟶ chart
  /-- The scheme underlying it is the relative Proj of the situation. -/
  projIso : (BigFppfOver.toScheme B S hS).obj proj ≅ t.relativeProj
  /-- Its structure morphism is the structure morphism of the relative Proj. -/
  projHom_comp : (BigFppfOver.toScheme B S hS).map projHom ≫ baseIso.hom =
    projIso.hom ≫ t.relativeProjToBase
  /-- The morphism from the chart of the source to the source. -/
  projToSpace : yoneda.obj proj ⟶ P
  /-- The chart square is cartesian: the chart of the source is `P ×_X V`. -/
  isPullback : IsPullback projToSpace (yoneda.map projHom) π chartHom

end ChartData

namespace RelativeProjChart

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {π : P ⟶ X}
    {t : Stacks.RelativeProj.Situation.{u}} (d : RelativeProjChart B S hS π t)

/-- The structure morphism of the chart of the source is the structure morphism of the
relative Proj, read through the two identifications of schemes. -/
theorem map_projHom_eq :
    (BigFppfOver.toScheme B S hS).map d.projHom =
      d.projIso.hom ≫ t.relativeProjToBase ≫ d.baseIso.inv := by
  rw [← Category.assoc, ← d.projHom_comp, Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- A property of scheme morphisms which is invariant under isomorphism and holds for the
structure morphism of the relative Proj holds for the structure morphism of the chart of the
source. -/
theorem map_projHom_property (Q : MorphismProperty Scheme.{u}) (hQiso : Q.RespectsIso)
    (hQ : Q t.relativeProjToBase) : Q ((BigFppfOver.toScheme B S hS).map d.projHom) := by
  have := hQiso
  rw [d.map_projHom_eq]
  exact MorphismProperty.RespectsIso.precomp Q d.projIso.hom _
    (MorphismProperty.RespectsIso.postcomp Q d.baseIso.inv _ hQ)

/-- The chart of the source is étale over the source: it is the base change of the chart of
the target along `π`. -/
theorem projToSpace_etale : (MorphismProperty.inverseImage
    (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS)).presheaf d.projToSpace :=
  (MorphismProperty.relative_isStableUnderBaseChange _).of_isPullback d.isPullback.flip
    d.chartHom_etale

/-- The chart of the source is surjective onto the source: it is the base change of the chart
of the target along `π`. -/
theorem projToSpace_surjective : (MorphismProperty.inverseImage
    (@AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS)).presheaf d.projToSpace :=
  (MorphismProperty.relative_isStableUnderBaseChange _).of_isPullback d.isPullback.flip
    d.chartHom_surjective

include d in
/-- The chart square of a relative Proj presentation is a surjective étale chart in the sense
of Stacks 03MJ, condition (2), for any property of scheme morphisms, invariant under
isomorphism, that the structure morphism of the relative Proj has. -/
theorem holdsOnSurjectiveEtaleChart (Q : MorphismProperty Scheme.{u}) (hQiso : Q.RespectsIso)
    (hQ : Q t.relativeProjToBase) : HoldsOnSurjectiveEtaleChart B S hS Q π :=
  ⟨d.proj, d.chart, d.projToSpace, d.chartHom, d.projHom, d.projToSpace_etale,
    d.chartHom_etale, d.projToSpace_surjective, d.isPullback.w.symm,
    d.map_projHom_property Q hQiso hQ⟩

set_option synthInstance.maxHeartbeats 100000 in
/-- The projection of the base change of `π` along the chart of the target is, up to the
canonical isomorphism, the structure morphism of the chart of the source. -/
private theorem isPullback_pullback_snd :
    IsPullback (d.isPullback.isoIsPullback _ _
      (IsPullback.of_hasPullback π d.chartHom)).inv (pullback.snd π d.chartHom)
      (yoneda.map d.projHom) (𝟙 (yoneda.obj d.chart)) := by
  refine IsPullback.of_horiz_isIso ⟨?_⟩
  rw [Category.comp_id]
  exact IsPullback.isoIsPullback_inv_snd _ _ d.isPullback (IsPullback.of_hasPullback π d.chartHom)

/-- The base change of `π` along the chart of the target is quasi-compact as soon as the
structure morphism of the relative Proj is. -/
theorem isQuasiCompact_pullback_snd (hQ : AlgebraicGeometry.QuasiCompact t.relativeProjToBase) :
    IsQuasiCompact B S hS (pullback.snd π d.chartHom) := by
  have hmap : AlgebraicGeometry.QuasiCompact ((BigFppfOver.toScheme B S hS).map d.projHom) :=
    d.map_projHom_property (@AlgebraicGeometry.QuasiCompact.{u})
      MorphismProperty.IsStableUnderBaseChange.respectsIso hQ
  have hyon : IsQuasiCompact B S hS (yoneda.map d.projHom) :=
    isQuasiCompact_of_presheaf_quasiCompact B S hS
      (presheaf_yoneda_map_of_inverseImage B S hS
        AlgebraicGeometry.quasiCompact_isStableUnderBaseChange d.projHom hmap)
  exact isQuasiCompact_of_isPullback B S hS d.isPullback_pullback_snd hyon

/-- The structure morphism of the space-level relative Proj is quasi-compact as soon as that of
the scheme-level relative Proj is. -/
private theorem isQuasiCompact_of_relativeProjToBase
    (d : RelativeProjChart B S hS π t) (hP : IsAlgebraicSpace B S hS P)
    (hX : IsAlgebraicSpace B S hS X) (hQ : AlgebraicGeometry.QuasiCompact t.relativeProjToBase) :
    IsQuasiCompact B S hS π :=
  isQuasiCompact_of_surjectiveEtale_atlas B S hS π hP hX d.chart d.chartHom
    (isSurjective_of_presheafSurjective B S hS d.chartHom d.chartHom_surjective)
    ((isEtale_iff_presheaf_of_yoneda B S hS d.chartHom).2 d.chartHom_etale)
    (d.isQuasiCompact_pullback_snd hQ)

/-- The base change of `π` along the chart of the target is separated as soon as the structure
morphism of the relative Proj is. -/
theorem isSeparated_pullback_snd
    (hQ : _root_.AlgebraicGeometry.IsSeparated t.relativeProjToBase) :
    IsSeparated B S hS (pullback.snd π d.chartHom) := by
  have hstable : ((MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf).IsStableUnderBaseChange :=
    MorphismProperty.relative_isStableUnderBaseChange _
  have hmap : _root_.AlgebraicGeometry.IsSeparated
      ((BigFppfOver.toScheme B S hS).map d.projHom) :=
    d.map_projHom_property (@_root_.AlgebraicGeometry.IsSeparated.{u}) inferInstance hQ
  have hyon : IsSeparated B S hS (yoneda.map d.projHom) :=
    (isSeparated_yoneda_map_iff B S hS d.projHom).2 hmap
  exact MorphismProperty.IsStableUnderBaseChange.of_isPullback
    (P := (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf.diagonal) d.isPullback_pullback_snd hyon

end RelativeProjChart

section Main

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Stacks 084E.** In the relative Proj situation of Stacks 0849, the structure morphism
`π : Proj_X(𝒜) ⟶ X` is separated.

There is no hypothesis on the graded algebra.  The relative Proj enters through a surjective
étale scheme chart of `X`, as Stacks 084B presents it. -/
@[stacks 084E, ega "II 8.14.1" "more general"]
theorem isSeparated_relativeProj {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hP : IsAlgebraicSpace B S hS P) (π : P ⟶ X)
    {t : Stacks.RelativeProj.Situation.{u}} (d : RelativeProjChart B S hS π t) :
    IsSeparated B S hS π :=
  isSeparated_of_etaleChart B S hS hP d.chartHom_surjective d.chartHom_etale
    (d.isSeparated_pullback_snd (Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase t))

/-- **Stacks 084F.** In the relative Proj situation of Stacks 0849, the structure morphism
`π : Proj_X(𝒜) ⟶ X` is quasi-compact if one of the following holds: `𝒜` is of finite type as a
sheaf of `𝒜₀`-algebras; `𝒜` is generated by `𝒜₁` as an `𝒜₀`-algebra and `𝒜₁` is a finite type
`𝒜₀`-module; or there is a finite type quasi-coherent `𝒜₀`-submodule `ℱ ⊆ 𝒜₊` such that
`𝒜₊/ℱ𝒜` is a locally nilpotent sheaf of ideals of `𝒜/ℱ𝒜`.

The relative Proj enters through a surjective étale scheme chart of `X`, as Stacks 084B
presents it, and the three hypotheses are those of Stacks 07ZX on the restricted algebra living
on that chart. -/
@[stacks 084F]
theorem isQuasiCompact_relativeProj {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hP : IsAlgebraicSpace B S hS P) (hX : IsAlgebraicSpace B S hS X) (π : P ⟶ X)
    {t : Stacks.RelativeProj.Situation.{u}} (d : RelativeProjChart B S hS π t)
    (h : t.IsFiniteTypeOverDegreeZero ∨ t.IsFinitelyGeneratedInDegreeOne ∨
      t.HasNilpotentPositiveQuotient) :
    IsQuasiCompact B S hS π :=
  RelativeProjChart.isQuasiCompact_of_relativeProjToBase d hP hX
    (Stacks.RelativeProj.Situation.quasiCompact_relativeProj t h)

/-- **Stacks 084G.** In the relative Proj situation of Stacks 0849, if `𝒜` is of finite type as
a sheaf of `𝒪_X`-algebras then the structure morphism `π : Proj_X(𝒜) ⟶ X` is of finite type.

The relative Proj enters through a surjective étale scheme chart of `X`, as Stacks 084B
presents it, and the hypothesis is that of Stacks 07ZY on the restricted algebra living on that
chart. -/
@[stacks 084G]
theorem isFiniteType_relativeProj {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hP : IsAlgebraicSpace B S hS P) (hX : IsAlgebraicSpace B S hS X) (π : P ⟶ X)
    {t : Stacks.RelativeProj.Situation.{u}} (d : RelativeProjChart B S hS π t)
    (h : t.IsFiniteType) :
    IsFiniteType B S hS π :=
  ⟨isLocallyOfFiniteType_of_holdsOnSurjectiveEtaleChart B S hS
      (d.holdsOnSurjectiveEtaleChart (@AlgebraicGeometry.LocallyOfFiniteType.{u})
        MorphismProperty.IsStableUnderBaseChange.respectsIso
        (Stacks.RelativeProj.Situation.relativeProj_locallyOfFiniteType t h)),
    RelativeProjChart.isQuasiCompact_of_relativeProjToBase d hP hX
      (Stacks.RelativeProj.Situation.relativeProj_quasiCompact t h)⟩

end Main

/-! ### Non-vacuity of the chart presentation -/

section NonVacuity

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (t : Stacks.RelativeProj.Situation.{u}) (hbase : B.Contains t.base)
    (hproj : B.Contains t.relativeProj) (p : t.base ⟶ S)

/-- The base of a relative Proj situation of Stacks 01NN, viewed as an object of the big fppf
category over `S` along a chosen structure morphism `p`. -/
def situationBaseObj : BigFppfOver B S hS := BigFppfOver.mk B S hS hbase p

/-- The relative Proj of a situation of Stacks 01NN, viewed as an object of the big fppf
category over `S`; its structure morphism to `S` factors through the base. -/
noncomputable def situationProjObj : BigFppfOver B S hS :=
  BigFppfOver.mk B S hS hproj (t.relativeProjToBase ≫ p)

/-- The structure morphism `Proj_V(t) ⟶ V` of a situation of Stacks 01NN, viewed as a morphism
of the big fppf category over `S`. -/
noncomputable def situationProjHom :
    situationProjObj B S hS t hproj p ⟶ situationBaseObj B S hS t hbase p :=
  BigFppfOver.homMk B S hS hbase p t.relativeProjToBase rfl

/-- The underlying scheme morphism of `AlgebraicGeometry.Space.situationProjHom` is the
structure morphism of the relative Proj. -/
theorem toScheme_map_situationProjHom :
    (BigFppfOver.toScheme B S hS).map (situationProjHom B S hS t hbase hproj p) =
      t.relativeProjToBase :=
  rfl

/-- **The chart presentation of Stacks 084B is inhabited: the non-vacuity witness for
Stacks 084F and 084G.**

For every relative Proj situation `t` of Stacks 01NN whose base and whose relative Proj are
contained in the ambient big fppf site, the scheme-level structure morphism
`Proj_{t.base}(t) ⟶ t.base`, regarded as a morphism of the representable presheaves it defines
on the big fppf site over `S`, carries a `AlgebraicGeometry.Space.RelativeProjChart` for `t`.
The chart of the target is the base itself with `chartHom = 𝟙`, so the cartesian square of
Stacks 084B degenerates to the identity square. -/
noncomputable def relativeProjChartOfSituation :
    RelativeProjChart B S hS (yoneda.map (situationProjHom B S hS t hbase hproj p)) t where
  chart := situationBaseObj B S hS t hbase p
  chartHom := 𝟙 _
  chartHom_etale := by
    rw [← yoneda.map_id]
    exact presheaf_yoneda_map_of_inverseImage B S hS inferInstance (𝟙 _)
      (by rw [CategoryTheory.Functor.map_id]; infer_instance)
  chartHom_surjective := by
    rw [← yoneda.map_id]
    exact presheaf_yoneda_map_of_inverseImage B S hS inferInstance (𝟙 _)
      (by rw [CategoryTheory.Functor.map_id]; infer_instance)
  baseIso := Iso.refl _
  proj := situationProjObj B S hS t hproj p
  projHom := situationProjHom B S hS t hbase hproj p
  projIso := Iso.refl _
  projHom_comp := by
    rw [toScheme_map_situationProjHom]
    exact (Category.comp_id _).trans (Category.id_comp _).symm
  projToSpace := 𝟙 _
  isPullback := IsPullback.of_id_fst

include hbase hproj in
/-- The chart presentation of Stacks 084B is inhabited over any base scheme in the site. -/
theorem nonempty_relativeProjChart :
    Nonempty (RelativeProjChart B S hS (yoneda.map (situationProjHom B S hS t hbase hproj p)) t) :=
  ⟨relativeProjChartOfSituation B S hS t hbase hproj p⟩

/-- **The chart presentation of Stacks 084B is inhabited, with no hypothesis on the situation.**

Every relative Proj situation `t` of Stacks 01NN lies in some big fppf site, by
`AlgebraicGeometry.BigFppfSite.exists_containing`, and over that site
`AlgebraicGeometry.Space.relativeProjChartOfSituation` presents its structure morphism as a
relative Proj on the trivial chart of its base.  Together with
`AlgebraicGeometry.Space.isQuasiCompact_relativeProj` and
`AlgebraicGeometry.Space.isFiniteType_relativeProj` this says Stacks 084F and 084G have
instances for every situation of Stacks 01NN. -/
theorem exists_relativeProjChart (t : Stacks.RelativeProj.Situation.{u}) :
    ∃ (B : BigFppfSite.{u}) (hS : B.Contains t.base)
      (X P : (BigFppfOver B t.base hS)ᵒᵖ ⥤ Type u) (π : P ⟶ X),
      Nonempty (RelativeProjChart B t.base hS π t) := by
  obtain ⟨B, hB⟩ := BigFppfSite.exists_containing {t.base, t.relativeProj}
  have hbase : B.Contains t.base := hB _ (by simp)
  have hproj : B.Contains t.relativeProj := hB _ (by simp)
  exact ⟨B, hbase, _, _, _, nonempty_relativeProjChart B t.base hbase t hbase hproj (𝟙 t.base)⟩

include hbase hproj in
/-- **Stacks 084E for the relative Proj of a scheme, read on the big fppf site.**

`AlgebraicGeometry.Space.isSeparated_relativeProj` applied to the witness
`AlgebraicGeometry.Space.relativeProjChartOfSituation`. -/
theorem isSeparated_relativeProj_of_situation :
    IsSeparated B S hS (yoneda.map (situationProjHom B S hS t hbase hproj p)) :=
  isSeparated_relativeProj B S hS (isAlgebraicSpace_yoneda B S hS _) _
    (relativeProjChartOfSituation B S hS t hbase hproj p)

include hbase hproj in
/-- **Stacks 084F for the relative Proj of a scheme, read on the big fppf site.**

`AlgebraicGeometry.Space.isQuasiCompact_relativeProj` applied to the witness
`AlgebraicGeometry.Space.relativeProjChartOfSituation`. -/
theorem isQuasiCompact_relativeProj_of_situation
    (h : t.IsFiniteTypeOverDegreeZero ∨ t.IsFinitelyGeneratedInDegreeOne ∨
      t.HasNilpotentPositiveQuotient) :
    IsQuasiCompact B S hS (yoneda.map (situationProjHom B S hS t hbase hproj p)) :=
  isQuasiCompact_relativeProj B S hS
    (isAlgebraicSpace_yoneda B S hS _) (isAlgebraicSpace_yoneda B S hS _) _
    (relativeProjChartOfSituation B S hS t hbase hproj p) h

include hbase hproj in
/-- **Stacks 084G for the relative Proj of a scheme, read on the big fppf site.**

`AlgebraicGeometry.Space.isFiniteType_relativeProj` applied to the witness
`AlgebraicGeometry.Space.relativeProjChartOfSituation`. -/
theorem isFiniteType_relativeProj_of_situation (h : t.IsFiniteType) :
    IsFiniteType B S hS (yoneda.map (situationProjHom B S hS t hbase hproj p)) :=
  isFiniteType_relativeProj B S hS
    (isAlgebraicSpace_yoneda B S hS _) (isAlgebraicSpace_yoneda B S hS _) _
    (relativeProjChartOfSituation B S hS t hbase hproj p) h

end NonVacuity

/-! ### The universal property in the degree-one generated case

Stacks 085D asserts, for a graded algebra generated as an `𝒜₀`-algebra by `𝒜₁`, that
`P = Proj_X(𝒜)` represents the functor `F₁` of triples `(f : T ⟶ X, ℒ, ψ)` with `ℒ` invertible
on `T` and `ψ : f^*𝒜 ⟶ ⨁_{n ≥ 0} ℒ^{⊗ n}` a map of graded algebras surjective in degree one.

The source proves it by base change to a scheme: Stacks 084B identifies `T ×_X P` with the
scheme-level relative Proj of `f^*𝒜` for every scheme `T` over `X`, and Stacks 01O4 says that
scheme represents the scheme-level `F₁` of `f^*𝒜`. The same two inputs are taken here, in the
same shape: `AlgebraicGeometry.Space.RelativeProjPoints` is Stacks 084B's base-change assertion
as data, and the representing bijections of Stacks 01O4 enter as
`Stacks.AlgebraicGeometry.ProjRepresentsF1.F1Representation`, a structure the library states
and does not inhabit. -/

section DegreeOne

open Stacks.AlgebraicGeometry.RelativeProjBridge Stacks.AlgebraicGeometry.ProjRepresentsF1
open Stacks.AlgebraicGeometry.RelativeProj (relativeProj)

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Morphisms over `r` in the big fppf category over `S` are morphisms over the underlying
morphism of schemes.** A morphism `T' ⟶ Z` of the site is a morphism of the underlying schemes
compatible with the structure morphisms to `S`, and that compatibility is implied by
commutation with `g` once `r` itself has it. -/
def overEquivSchemeOver {T Z T' : BigFppfOver B S hS} (g : Z ⟶ T) (r : T' ⟶ T) :
    {s : T' ⟶ Z // s ≫ g = r} ≃
      {h : (BigFppfOver.toScheme B S hS).obj T' ⟶ (BigFppfOver.toScheme B S hS).obj Z //
        h ≫ (BigFppfOver.toScheme B S hS).map g = (BigFppfOver.toScheme B S hS).map r} where
  toFun s := ⟨(BigFppfOver.toScheme B S hS).map s.1, by
    rw [← CategoryTheory.Functor.map_comp, s.2]⟩
  invFun h := ⟨Over.homMk (ObjectProperty.homMk h.1) (by
      apply ObjectProperty.hom_ext
      change h.1 ≫ (Over.hom Z).hom = (Over.hom T').hom
      have hwg : (BigFppfOver.toScheme B S hS).map g ≫ (Over.hom T).hom = (Over.hom Z).hom :=
        congrArg (fun m => m.hom) (Over.w g)
      have hwr : (BigFppfOver.toScheme B S hS).map r ≫ (Over.hom T).hom = (Over.hom T').hom :=
        congrArg (fun m => m.hom) (Over.w r)
      rw [← hwg, ← Category.assoc, h.2, hwr]),
    Over.OverMorphism.ext (ObjectProperty.hom_ext _ h.2)⟩
  left_inv s := by
    apply Subtype.ext
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    rfl
  right_inv h := Subtype.ext rfl

/-- Morphisms into `Y` over `p` are morphisms into `Y'` over `p'`, when `p` factors through `p'`
by an isomorphism of its source. -/
def overEquivOfIso {C : Type*} [Category C] {W T Y Y' : C} (e : Y ≅ Y') {p : Y ⟶ T}
    {p' : Y' ⟶ T} (h : p = e.hom ≫ p') (k : W ⟶ T) :
    {g : W ⟶ Y // g ≫ p = k} ≃ {g : W ⟶ Y' // g ≫ p' = k} where
  toFun g := ⟨g.1 ≫ e.hom, by rw [Category.assoc, ← h, g.2]⟩
  invFun g := ⟨g.1 ≫ e.inv, by rw [Category.assoc, h, Iso.inv_hom_id_assoc, g.2]⟩
  left_inv g := Subtype.ext (by simp)
  right_inv g := Subtype.ext (by simp)

/-- **The relative Proj of an algebraic space, presented over the scheme points of its base.**

Data exhibiting a morphism `π : P ⟶ X` of algebraic spaces over `S` as a relative homogeneous
spectrum through its base changes to schemes: for every object `T` of the site and every
`T`-point `f` of `X` a quasi-coherent graded algebra on the scheme of `T` — the restriction
`f^*𝒜` — an object of the site whose scheme is the relative Proj of Stacks 01NQ of that algebra,
and a cartesian square identifying it with `T ×_X P`.

This is Stacks 084B's second assertion: a canonical isomorphism `Proj_T(f^*𝒜) = T ×_X P` for
every scheme `T` over `X`. It is the only property of the relative Proj that the proof of
Stacks 085D uses. -/
structure RelativeProjPoints {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (π : P ⟶ X) where
  /-- The restriction of the graded algebra to a scheme point of the base. -/
  algebra (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) :
    SheafGradedAlgebra ((BigFppfOver.toScheme B S hS).obj T)
  /-- The object of the site representing the base change of `π` along the point. -/
  fibre (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) : BigFppfOver B S hS
  /-- Its scheme is the relative Proj of the restricted algebra. -/
  fibreIso (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) :
    (BigFppfOver.toScheme B S hS).obj (fibre T f) ≅ (relativeProj (algebra T f)).scheme
  /-- Its structure morphism to the test object. -/
  fibreHom (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) : fibre T f ⟶ T
  /-- That structure morphism is the structure morphism of the relative Proj. -/
  fibreHom_comp (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) :
    (BigFppfOver.toScheme B S hS).map (fibreHom T f) =
      (fibreIso T f).hom ≫ (relativeProj (algebra T f)).toBase
  /-- The morphism from the base change to the source. -/
  fibreToSpace (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) : yoneda.obj (fibre T f) ⟶ P
  /-- The square is cartesian: the object is `T ×_X P`. -/
  isPullback (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X) :
    IsPullback (fibreToSpace T f) (yoneda.map (fibreHom T f)) π f

namespace RelativeProjPoints

variable {B S hS} {X P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {π : P ⟶ X}
    (d : RelativeProjPoints B S hS π)

/-- **The points of `P` over a point of `X` are the sections of the base change.** A `T'`-point
of `P` lying over `f ∘ r` is, by the cartesian square of Stacks 084B, a section over `r` of the
structure morphism of `T ×_X P`. -/
noncomputable def pointEquivOver (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' : BigFppfOver B S hS} (r : T' ⟶ T) :
    {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f} ≃
      {s : T' ⟶ d.fibre T f // s ≫ d.fibreHom T f = r} where
  toFun u := ⟨Yoneda.fullyFaithful.preimage
      ((d.isPullback T f).lift u.1 (yoneda.map r) u.2), by
    apply Yoneda.fullyFaithful.map_injective
    rw [CategoryTheory.Functor.map_comp, Yoneda.fullyFaithful.map_preimage,
      (d.isPullback T f).lift_snd]⟩
  invFun s := ⟨yoneda.map s.1 ≫ d.fibreToSpace T f, by
    rw [Category.assoc, (d.isPullback T f).w, ← Category.assoc,
      ← CategoryTheory.Functor.map_comp, s.2]⟩
  left_inv u := by
    apply Subtype.ext
    change yoneda.map (Yoneda.fullyFaithful.preimage _) ≫ _ = _
    rw [Yoneda.fullyFaithful.map_preimage, (d.isPullback T f).lift_fst]
  right_inv s := by
    apply Subtype.ext
    apply Yoneda.fullyFaithful.map_injective
    rw [Yoneda.fullyFaithful.map_preimage]
    refine (d.isPullback T f).hom_ext ?_ ?_
    · exact (d.isPullback T f).lift_fst _ _ _
    · rw [(d.isPullback T f).lift_snd, ← CategoryTheory.Functor.map_comp, s.2]

/-- The section attached to a point of `P` recovers that point along the morphism from the base
change to `P`. -/
theorem map_pointEquivOver (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' : BigFppfOver B S hS} (r : T' ⟶ T)
    (u : {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f}) :
    yoneda.map (d.pointEquivOver T f r u).1 ≫ d.fibreToSpace T f = u.1 :=
  congrArg Subtype.val ((d.pointEquivOver T f r).left_inv u)

/-- **The points of `P` over a point of `X` are the sections of the scheme-level relative Proj
of the restricted algebra.** The previous bijection, read through the full faithfulness of the
big fppf category over `S` on morphisms of schemes and through the identification of the base
change with the relative Proj of Stacks 01NQ. -/
noncomputable def pointEquivProjOver (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' : BigFppfOver B S hS} (r : T' ⟶ T) :
    {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f} ≃
      {g : (BigFppfOver.toScheme B S hS).obj T' ⟶ (relativeProj (d.algebra T f)).scheme //
        g ≫ (relativeProj (d.algebra T f)).toBase = (BigFppfOver.toScheme B S hS).map r} :=
  (d.pointEquivOver T f r).trans <|
    (overEquivSchemeOver B S hS (d.fibreHom T f) r).trans
      (overEquivOfIso (d.fibreIso T f) (d.fibreHom_comp T f) _)

/-- The section of the relative Proj attached to a point of `P`, computed. -/
theorem pointEquivProjOver_apply (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' : BigFppfOver B S hS} (r : T' ⟶ T)
    (u : {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f}) :
    (d.pointEquivProjOver T f r u).1 =
      (BigFppfOver.toScheme B S hS).map (d.pointEquivOver T f r u).1 ≫ (d.fibreIso T f).hom :=
  rfl

/-- **The bijection is natural in the test object.** Restricting a point of `P` along
`r' : T'' ⟶ T'` restricts the section it corresponds to; both sides are sections over
`r' ≫ r` with the same image in `P`, and the cartesian square makes such a section unique. -/
theorem pointEquivOver_natural (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' T'' : BigFppfOver B S hS} (r : T' ⟶ T) (r' : T'' ⟶ T')
    (u : {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f}) :
    d.pointEquivOver T f (r' ≫ r) ⟨yoneda.map r' ≫ u.1, by
        rw [Category.assoc, u.2, ← Category.assoc, ← CategoryTheory.Functor.map_comp]⟩
      = ⟨r' ≫ (d.pointEquivOver T f r u).1, by
        rw [Category.assoc, (d.pointEquivOver T f r u).2]⟩ := by
  refine (Equiv.eq_symm_apply _).1 ?_
  apply Subtype.ext
  show yoneda.map r' ≫ u.1 =
    yoneda.map (r' ≫ (d.pointEquivOver T f r u).1) ≫ d.fibreToSpace T f
  rw [CategoryTheory.Functor.map_comp, Category.assoc, map_pointEquivOver]

/-- **The bijection with the sections of the relative Proj is natural in the test object.** -/
theorem pointEquivProjOver_natural (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' T'' : BigFppfOver B S hS} (r : T' ⟶ T) (r' : T'' ⟶ T')
    (u : {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f}) :
    (d.pointEquivProjOver T f (r' ≫ r) ⟨yoneda.map r' ≫ u.1, by
        rw [Category.assoc, u.2, ← Category.assoc, ← CategoryTheory.Functor.map_comp]⟩).1
      = (BigFppfOver.toScheme B S hS).map r' ≫ (d.pointEquivProjOver T f r u).1 := by
  rw [pointEquivProjOver_apply, pointEquivProjOver_apply,
    congrArg Subtype.val (pointEquivOver_natural d T f r r' u)]
  show (BigFppfOver.toScheme B S hS).map (r' ≫ _) ≫ _ = _
  rw [CategoryTheory.Functor.map_comp, Category.assoc]

section Represents

variable (TA : TensorAlgebras.{u}) (i : TensorAlgebraPullbackIsos.{u} TA)
    {D : ∀ (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X),
      Stacks.AlgebraicGeometry.RelativeProjTwists.TwistData (d.algebra T f)}
    (hgen : ∀ (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X),
      IsGeneratedInDegreeOne (d.algebra T f))
    (rep : ∀ (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X),
      F1Representation (d.algebra T f) TA i (D T f))

/-- **Stacks 085D, part (1), fibred over a point of the base.**

For a quasi-coherent graded `𝒪_X`-algebra `𝒜` generated as an `𝒜₀`-algebra by `𝒜₁`, and
`P = Proj_X(𝒜)`, the `T'`-points of `P` lying over a point `f` of `X` at `T` are the
isomorphism classes of pairs `(ℒ, ψ)` with `ℒ` invertible on the scheme of `T'` and
`ψ : f^*𝒜 ⟶ ⨁_{n ≥ 0} ℒ^{⊗ n}` a graded algebra map surjective in degree one — that is, the
triples `(f ∘ r, ℒ, ψ)` of the functor `F₁`.

The relative Proj enters through its base changes to schemes, as Stacks 084B presents them, and
the scheme-level representing bijections of Stacks 01O4 are the hypothesis `rep`; the degree-one
generation hypothesis of the source is `hgen`. -/
@[stacks 085D "part (1): the relative Proj represents the functor of triples, over a point of \
the base"]
noncomputable def pointEquivF1 (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' : BigFppfOver B S hS} (r : T' ⟶ T) :
    {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f} ≃
      F1 (d.algebra T f) TA ((BigFppfOver.toScheme B S hS).map r) :=
  have := hgen
  (d.pointEquivProjOver T f r).trans ((rep T f).homEquiv _)

/-- The class of triples attached to a point of `P`, computed through the section of the
scheme-level relative Proj. -/
theorem pointEquivF1_apply (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' : BigFppfOver B S hS} (r : T' ⟶ T)
    (u : {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f}) :
    d.pointEquivF1 TA i hgen rep T f r u =
      (rep T f).homEquiv ((BigFppfOver.toScheme B S hS).map r)
        (d.pointEquivProjOver T f r u) := rfl

/-- **Stacks 085D, part (1): the representing bijection is natural in the test object.**

Restricting a `T'`-point of `P` along `r' : T'' ⟶ T'` pulls back the class of triples it
represents. -/
@[stacks 085D "part (1): naturality of the representing bijection in the test object"]
theorem pointEquivF1_natural (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X)
    {T' T'' : BigFppfOver B S hS} (r : T' ⟶ T) (r' : T'' ⟶ T')
    (u : {u : yoneda.obj T' ⟶ P // u ≫ π = yoneda.map r ≫ f}) :
    d.pointEquivF1 TA i hgen rep T f (r' ≫ r) ⟨yoneda.map r' ≫ u.1, by
        rw [Category.assoc, u.2, ← Category.assoc, ← CategoryTheory.Functor.map_comp]⟩
      = (rep T f).pullbackClass ((BigFppfOver.toScheme B S hS).map r')
          (d.pointEquivF1 TA i hgen rep T f r u) := by
  rw [pointEquivF1_apply, pointEquivF1_apply,
    ← (rep T f).homEquiv_natural ((BigFppfOver.toScheme B S hS).map r')
      (d.pointEquivProjOver T f r u)]
  exact congrArg _ (Subtype.ext (pointEquivProjOver_natural d T f r r' u))

/-- **Stacks 085D, part (1).** The `T`-points of `P = Proj_X(𝒜)` are the isomorphism classes of
triples `(f, ℒ, ψ)` of the functor `F₁`: a point `f` of `X` at `T`, an invertible module `ℒ` on
the scheme of `T`, and a graded algebra map `f^*𝒜 ⟶ ⨁_{n ≥ 0} ℒ^{⊗ n}` surjective in degree one.

The decomposition of a point of `P` by its image in `X` matches the decomposition of a triple by
its first component, and over each point of `X` the two fibres agree by
`AlgebraicGeometry.Space.RelativeProjPoints.pointEquivF1`. -/
@[stacks 085D "part (1): the relative Proj represents the functor of triples"]
noncomputable def homEquivF1 (T : BigFppfOver B S hS) :
    (yoneda.obj T ⟶ P) ≃ Σ f : yoneda.obj T ⟶ X, F1 (d.algebra T f) TA (𝟙 _) :=
  (Equiv.sigmaFiberEquiv (fun u : yoneda.obj T ⟶ P => u ≫ π)).symm.trans
    (Equiv.sigmaCongrRight fun f =>
      (Equiv.subtypeEquivRight (fun u => by
        rw [CategoryTheory.Functor.map_id, Category.id_comp])).trans
        (d.pointEquivF1 TA i hgen rep T f (𝟙 T)))

end Represents

