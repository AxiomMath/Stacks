-/

@[expose] public noncomputable section

open CategoryTheory Opposite TensorProduct
open Stacks.PresheafOfModules.TensorInternalHom
open Stacks.SheafOfModules.Invertible

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (hD : IsEffectiveCartierDivisor B S hS X D)

/-! ### Contraction of a section of `𝒪_X(D)` with a section of `𝓘_D` -/

/-- Contraction with a section `t` of `𝓘_D` over an étale chart, through the evaluation pairing
`𝒪_X(D) ⊗_{𝒪_X} 𝓘_D ≅ 𝒪_X` of Stacks 0841: a linear functional on the sections of `𝒪_X(D)`
there. -/
def canonicalSectionDual (W : (SmallEtale B S hS X.1)ᵒᵖ)
    (t : (modulePresheaf B S hS X (idealSheafOfModules B S hS X D)).obj W) :
    Module.Dual ((structureCommRings B S hS X).obj W)
      ((modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj W) where
  toFun σ :=
    tensorHomAt (structureCommRings B S hS X)
      (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD))
      (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
      (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X)))
      (tensorPairing (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
        (idealSheafOfModules B S hS X D) (associatedInvertibleSheaf B S hS X D hD)
        (SheafOfModules.unit (structureRingSheaf B S hS X))
        (associatedInvertibleSheafEvaluation B S hS X D hD)) W (σ ⊗ₜ t)
  map_add' σ σ' := by rw [TensorProduct.add_tmul, map_add]; rfl
  map_smul' r σ := by rw [← TensorProduct.smul_tmul', map_smul]; rfl

/-- Contraction of the canonical section `1_D` with a section `t` of `𝓘_D` is `t` itself, read in
`𝒪_X`: the evaluation pairing at the canonical section is the inclusion `𝓘_D ⟶ 𝒪_X`. -/
theorem canonicalSectionDual_canonicalSection (W : (SmallEtale B S hS X.1)ᵒᵖ)
    (t : (modulePresheaf B S hS X (idealSheafOfModules B S hS X D)).obj W) :
    canonicalSectionDual B S hS X D hD W t ((canonicalSection B S hS X D hD).eval W) =
      ((valPresheafMap (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
        (definingIdealSheaf B S hS X D).ι).app W).hom t :=
  tensorPairing_canonicalSection_tmul B S hS X D hD W t

/-- **The defining ideal of `D` is contained in the evaluation ideal of its canonical section**,
on every étale chart and with no trivialization: a section `t` of `𝓘_D` is the value at `1_D` of
contraction with `t`. -/
theorem definingIdealAt_le_sectionEvaluationIdealAt_canonicalSection
    (U : SmallEtale B S hS X.1) :
    definingIdealAt B S hS X D (op U) ≤
      sectionEvaluationIdealAt B S hS X (associatedInvertibleSheaf B S hS X D hD)
        (canonicalSection B S hS X D hD) U := fun a ha =>
  Ideal.subset_span ⟨canonicalSectionDual B S hS X D hD (op U) ⟨a, ha⟩,
    canonicalSectionDual_canonicalSection B S hS X D hD (op U) ⟨a, ha⟩⟩

/-! ### A chart trivializing the defining ideal sheaf -/

section Trivialized

variable (V : SmallEtale B S hS X.1)
    (e : SheafOfModules.unit ((structureRingSheaf B S hS X).over V) ≅
      (definingIdealSheaf B S hS X D).toSheafOfModules.over V)

/-- The section of `𝒪_X(D)` over a chart trivializing `𝓘_D` which the inverse trivialization
`𝓘_D|_V ⟶ 𝒪_X|_V` is, under the identification of `𝒪_X(D)` with
`SheafHom_{𝒪_X}(𝓘_D, 𝒪_X)`. -/
def associatedSheafGenerator :
    (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj (op V) :=
  (associatedInvertibleSheafHomEquiv B S hS X D hD V).symm e.inv.val

/-- The sheaf-hom attached to a section `σ` of `𝒪_X(D)`, evaluated at the identity of the chart,
is contraction of `σ` with the section of `𝓘_D`. -/
private theorem homSectionCoeff_associatedInvertibleSheafHomEquiv_id
    (σ : (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj (op V))
    (t : (modulePresheaf B S hS X (idealSheafOfModules B S hS X D)).obj (op V)) :
    homSectionCoeff (structureCommRings B S hS X)
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
        (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) V
        (associatedInvertibleSheafHomEquiv B S hS X D hD V σ) (op V) (𝟙 V) t =
      canonicalSectionDual B S hS X D hD (op V) t σ := by
  have h := associatedInvertibleSheafHomEquiv_apply B S hS X D hD V σ (op V) (𝟙 V) t
  erw [restrictₛₗ_id_apply B S hS X (associatedInvertibleSheaf B S hS X D hD) V σ] at h
  exact h

/-- **Contraction of that section with the generator of `𝓘_D` is `1`.**  The identification of
`𝒪_X(D)` with the sheaf-hom evaluates the pairing as the sheaf-hom does, and the inverse
trivialization takes the generator to the unit section. -/
theorem canonicalSectionDual_associatedSheafGenerator :
    canonicalSectionDual B S hS X D hD (op V)
        (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e)
        (associatedSheafGenerator B S hS X D hD V e) = 1 := by
  have heq : associatedInvertibleSheafHomEquiv B S hS X D hD V
      (associatedSheafGenerator B S hS X D hD V e) = e.inv.val :=
    (associatedInvertibleSheafHomEquiv B S hS X D hD V).apply_symm_apply _
  refine (homSectionCoeff_associatedInvertibleSheafHomEquiv_id B S hS X D hD V _ _).symm.trans ?_
  rw [heq]
  exact congrArg (fun φ : SheafOfModules.unit ((structureRingSheaf B S hS X).over V) ⟶
      SheafOfModules.unit ((structureRingSheaf B S hS X).over V) =>
    (φ.val.app (op (Over.mk (𝟙 V)))).hom
      (1 : ToType ((structureRingSheaf B S hS X).obj.obj (op V)))) e.hom_inv_id

/-- **The sheaf-hom attached to a section of `𝒪_X(D)` takes a multiple of the restricted
generator of `𝓘_D` to that multiple of the restricted contraction.**  This is linearity of the
sheaf-hom together with its compatibility with restriction. -/
theorem homSectionCoeff_smul_unitIsoGenerator (W : SmallEtale B S hS X.1) (f : W ⟶ V)
    (r : ToType ((structureRingSheaf B S hS X).obj.obj (op W)))
    (σ : (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj (op V)) :
    homSectionCoeff (structureCommRings B S hS X)
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
        (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) V
        (associatedInvertibleSheafHomEquiv B S hS X D hD V σ) (op W) f
        (r • (idealSheafOfModules B S hS X D).val.restrictₛₗ f.op
          (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e)) =
      r * ((structureRingSheaf B S hS X).obj.map f.op).hom
        (canonicalSectionDual B S hS X D hD (op V)
          (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e) σ) := by
  have hmap := map_smul (homSectionCoeff (structureCommRings B S hS X)
      (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
      (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) V
      (associatedInvertibleSheafHomEquiv B S hS X D hD V σ) (op W) f)
    (show ToType ((structureCommRings B S hS X).obj (op W)) from r)
    (show (modulePresheaf B S hS X (idealSheafOfModules B S hS X D)).obj (op W) from
      (idealSheafOfModules B S hS X D).val.restrictₛₗ f.op
        (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e))
  refine hmap.trans (congrArg (fun z => r * z) ?_)
  have hr := homSectionCoeff_restrict (structureCommRings B S hS X)
    (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
    (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) V
    (associatedInvertibleSheafHomEquiv B S hS X D hD V σ) f.op (𝟙 V)
    (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e)
  rw [Category.comp_id] at hr
  refine hr.trans (congrArg _ ?_)
  exact homSectionCoeff_associatedInvertibleSheafHomEquiv_id B S hS X D hD V σ _

/-- **Contraction with the generator of `𝓘_D` is injective on the sections of `𝒪_X(D)` over a
trivializing chart.**  A sheaf-hom out of `𝓘_D|_V` is determined by its value on the generator,
every section of `𝓘_D` below `V` being a multiple of the restriction of the generator. -/
theorem canonicalSectionDual_unitIsoGenerator_injective :
    Function.Injective (canonicalSectionDual B S hS X D hD (op V)
      (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e)) := by
  intro σ σ' hσ
  refine (associatedInvertibleSheafHomEquiv B S hS X D hD V).injective ?_
  refine homSection_ext (structureCommRings B S hS X)
    (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
    (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) V _ _
    fun W f t => ?_
  obtain ⟨r, hrt⟩ := exists_smul_unitIsoGenerator B S hS X
    (idealSheafOfModules B S hS X D) V e W.unop f t
  rw [hrt, homSectionCoeff_smul_unitIsoGenerator B S hS X D hD V e W.unop f r σ,
    homSectionCoeff_smul_unitIsoGenerator B S hS X D hD V e W.unop f r σ', hσ]

/-- The section of `𝒪_X(D)` attached to the inverse trivialization is a basis of the sections over
the chart, with contraction against the generator of `𝓘_D` as its coordinate functional. -/
theorem canonicalSectionDual_smul_associatedSheafGenerator
    (x : (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj (op V)) :
    canonicalSectionDual B S hS X D hD (op V)
        (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e) x •
      associatedSheafGenerator B S hS X D hD V e = x := by
  refine canonicalSectionDual_unitIsoGenerator_injective B S hS X D hD V e ?_
  rw [map_smul, canonicalSectionDual_associatedSheafGenerator B S hS X D hD V e, smul_eq_mul,
    mul_one]

include e in
/-- **On a chart trivializing `𝓘_D` the evaluation ideal of the canonical section is the defining
ideal of `D`.**  The section attached to the inverse trivialization is a basis there, so the
evaluation ideal is generated by the contraction of `1_D` against the generator of `𝓘_D`, which
is that generator; and the generator lies in `𝓘_D`. -/
theorem definingIdealAt_eq_sectionEvaluationIdealAt_of_unitIso :
    definingIdealAt B S hS X D (op V) =
      sectionEvaluationIdealAt B S hS X (associatedInvertibleSheaf B S hS X D hD)
        (canonicalSection B S hS X D hD) V := by
  refine le_antisymm
    (definingIdealAt_le_sectionEvaluationIdealAt_canonicalSection B S hS X D hD V) ?_
  rw [sectionEvaluationIdealAt_eq_span_singleton B S hS X
    (associatedInvertibleSheaf B S hS X D hD) (canonicalSection B S hS X D hD) V
    (associatedSheafGenerator B S hS X D hD V e)
    (canonicalSectionDual B S hS X D hD (op V)
      (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e))
    (canonicalSectionDual_smul_associatedSheafGenerator B S hS X D hD V e)]
  refine Ideal.span_le.2 (Set.singleton_subset_iff.2 ?_)
  have hv : canonicalSectionDual B S hS X D hD (op V)
      (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e)
      ((canonicalSection B S hS X D hD).eval (op V)) =
      (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e).val :=
    canonicalSectionDual_canonicalSection B S hS X D hD (op V)
      (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e)
  exact SetLike.mem_coe.2 (Eq.mp (congrArg
    (fun z => z ∈ definingIdealAt B S hS X D (op V)) hv.symm)
    (unitIsoGenerator B S hS X (idealSheafOfModules B S hS X D) V e).property)

end Trivialized

/-! ### The evaluation ideal of the canonical section on an affine chart -/

/-- **The evaluation ideal of `(𝒪_X(D), 1_D)` of Stacks 0845 is the defining ideal of `D` on every
affine étale chart.**  One containment needs no trivialization; for the other, `𝓘_D` is a sheaf,
so membership descends along a covering of the chart by charts which are affine and trivialize
`𝓘_D`, and the evaluation ideal restricts into the evaluation ideal between affine charts because
`𝒪_X(D)` is quasi-coherent. -/
theorem definingIdealAt_eq_sectionEvaluationIdealAt_canonicalSection
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1) :
    definingIdealAt B S hS X D (op U) =
      sectionEvaluationIdealAt B S hS X (associatedInvertibleSheaf B S hS X D hD)
        (canonicalSection B S hS X D hD) U := by
  classical
  refine le_antisymm
    (definingIdealAt_le_sectionEvaluationIdealAt_canonicalSection B S hS X D hD U) ?_
  have hqc : (associatedInvertibleSheaf B S hS X D hD).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_of_isInvertible B S hS X _
      (associatedInvertibleSheaf_isInvertible B S hS X D hD)
  have hcart : IsCartesianOnAffineCharts (associatedInvertibleSheaf B S hS X D hD) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hqc
  obtain ⟨T, hT, htriv⟩ := exists_covering_unitIso_of_isInvertible B S hS X
    (idealSheafOfModules B S hS X D) hD U
  intro a ha
  refine submodule_mem_of_cover (definingIdealSheaf B S hS X D) a T hT fun V' g hg => ?_
  obtain ⟨eV⟩ := htriv g hg
  obtain ⟨K, A, k, hcovA, hAff⟩ := affine_chart_cover B S hS X.1 V'
  refine submodule_mem_of_cover (definingIdealSheaf B S hS X D) _ (Sieve.ofArrows A k)
    hcovA fun T' m hm => ?_
  obtain ⟨j, c, rfl⟩ := (Sieve.mem_ofArrows_iff A k m).mp hm
  have hmemA : (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map (k j ≫ g).op a ∈
      (definingIdealSheaf B S hS X D).obj (op (A j)) := by
    rw [definingIdealSheaf_obj,
      definingIdealAt_eq_sectionEvaluationIdealAt_of_unitIso B S hS X D hD (A j)
        (unitIsoRestrict (smallEtaleRingedSite B S hS X.1 X.2) _ (k j) eV)]
    exact sectionEvaluationIdealAt_map_le_of_bijective_sectionsBaseChange B S hS X
      (associatedInvertibleSheaf B S hS X D hD) (canonicalSection B S hS X D hD)
      (k j ≫ g) (hcart U (A j) hU (hAff j) (k j ≫ g)) (Ideal.mem_map_of_mem _ ha)
  have hcomp : (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map (c ≫ k j).op
        ((SheafOfModules.unit (structureRingSheaf B S hS X)).val.map g.op a) =
      (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map c.op
        ((SheafOfModules.unit (structureRingSheaf B S hS X)).val.map (k j ≫ g).op a) := by
    refine Eq.trans ?_ ((SheafOfModules.unit (structureRingSheaf B S hS X)).val.map_comp_apply
      (k j ≫ g).op c.op a)
    refine Eq.trans ((SheafOfModules.unit (structureRingSheaf B S hS X)).val.map_comp_apply
      g.op (c ≫ k j).op a).symm ?_
    refine congrArg
      (fun z => (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map z a) ?_
    rw [← op_comp, ← op_comp, Category.assoc]
  rw [hcomp]
  exact (definingIdealSheaf B S hS X D).toSubmodule.map_mem c.op hmemA

/-! ### The two clauses of Stacks 0847, part (2) -/

/-- **Stacks 0847 (2): an effective Cartier divisor is the zero scheme of its canonical
section.**  This is the assertion of the source that the construction `D ↦ (𝒪_X(D), 1_D)` followed
by `(L, s) ↦ Z(s)` is the identity on effective Cartier divisors.

The evaluation ideal of `(𝒪_X(D), 1_D)` of Stacks 0845 is the defining ideal of `D` on every
affine étale chart, and a closed subspace whose defining ideal is the evaluation ideal on every
affine chart is the zero scheme, by `AlgebraicGeometry.Space.zeroSchemeSubfunctor_eq`. -/
@[stacks 0847 "part (2): the construction D ↦ (𝒪_X(D), 1_D) followed by (L, s) ↦ Z(s) is the \
identity on effective Cartier divisors, with no assumed inputs"]
theorem zeroScheme_canonicalSection_eq :
    zeroScheme B S hS X (associatedInvertibleSheaf B S hS X D hD)
        (canonicalSection B S hS X D hD) = D :=
  Subtype.ext (zeroSchemeSubfunctor_eq B S hS X (associatedInvertibleSheaf B S hS X D hD)
    (canonicalSection B S hS X D hD) D
    (definingIdealAt_eq_sectionEvaluationIdealAt_canonicalSection B S hS X D hD))

/-- **The evaluation ideal of Stacks 0845 depends only on the isomorphism class of the pair.**  An
isomorphism of modules carrying one section to the other matches the linear functionals on the
sections over a chart, so the two families of values at the sections coincide. -/
theorem sectionEvaluationIdealAt_eq_of_iso
    (L L' : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (s' : L'.sections) (i : L ≅ L')
    (hi : ∀ W : (SmallEtale B S hS X.1)ᵒᵖ, (i.hom.val.app W).hom (s.eval W) = s'.eval W)
    (U : SmallEtale B S hS X.1) :
    sectionEvaluationIdealAt B S hS X L s U = sectionEvaluationIdealAt B S hS X L' s' U := by
  have hinv : (i.inv.val.app (op U)).hom (s'.eval (op U)) = s.eval (op U) := by
    have h1 : (i.inv.val.app (op U)).hom ((i.hom.val.app (op U)).hom (s.eval (op U))) =
        s.eval (op U) :=
      congrArg (fun φ : L ⟶ L => (φ.val.app (op U)).hom (s.eval (op U))) i.hom_inv_id
    exact (congrArg (fun z => (i.inv.val.app (op U)).hom z) (hi (op U))).symm.trans h1
  refine congrArg Ideal.span (Set.eq_of_subset_of_subset ?_ ?_)
  · refine Set.range_subset_iff.2 fun l => ⟨l.comp (i.inv.val.app (op U)).hom, ?_⟩
    exact congrArg l hinv
  · refine Set.range_subset_iff.2 fun l => ⟨l.comp (i.hom.val.app (op U)).hom, ?_⟩
    exact congrArg l (hi (op U))

/-- **The zero scheme of Stacks 0845 depends only on the isomorphism class of the pair.**  The
zero scheme is the intersection of the closed subspaces whose defining ideal is contained in the
evaluation ideal of the pair on every affine chart, and an isomorphism carrying one section to
the other matches those evaluation ideals, so the two families being intersected coincide. -/
theorem zeroScheme_eq_of_iso (L L' : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (s' : L'.sections) (i : L ≅ L')
    (hi : SheafOfModules.sectionsMap i.hom s = s') :
    zeroScheme B S hS X L s = zeroScheme B S hS X L' s' := by
  have hval : ∀ W : (SmallEtale B S hS X.1)ᵒᵖ,
      (i.hom.val.app W).hom (s.eval W) = s'.eval W :=
    fun W => congrArg (fun t : L'.sections => t.eval W) hi
  have heq : ∀ U : SmallEtale B S hS X.1,
      sectionEvaluationIdealAt B S hS X L s U = sectionEvaluationIdealAt B S hS X L' s' U :=
    sectionEvaluationIdealAt_eq_of_iso B S hS X L L' s s' i hval
  refine Subtype.ext ?_
  change zeroSchemeSubfunctor B S hS X L s = zeroSchemeSubfunctor B S hS X L' s'
  rw [zeroSchemeSubfunctor_eq_sInf, zeroSchemeSubfunctor_eq_sInf]
  refine congrArg sInf (Set.ext fun Z => ?_)
  constructor
  · rintro ⟨hZ, h⟩
    exact ⟨hZ, fun U hU => (h U hU).trans (heq U).le⟩
  · rintro ⟨hZ, h⟩
    exact ⟨hZ, fun U hU => (h U hU).trans (heq U).ge⟩

/-- **Stacks 0847 (2): the effective Cartier divisor is unique.**  Let `L` be an `𝒪_X`-module with
a global section `s`.  An effective Cartier divisor `D ⊆ X` carrying an isomorphism
`𝒪_X(D) ≅ L` which sends the canonical section `1_D` to `s` is the zero scheme `Z(s)` of
Stacks 0845 — so there is at most one such divisor.

The isomorphism matches the evaluation ideals of the two pairs, so the defining ideal of `D` is
the evaluation ideal of `(L, s)` on every affine étale chart, which by
`AlgebraicGeometry.Space.zeroSchemeSubfunctor_eq` makes `D` the zero scheme. -/
@[stacks 0847 "part (2): uniqueness of the divisor — an effective Cartier divisor with an \
isomorphism from its associated invertible sheaf to L carrying the canonical section to s is the \
zero scheme of s, with no assumed inputs"]
theorem eq_zeroScheme_of_canonicalSectionHom_comp
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (i : associatedInvertibleSheaf B S hS X D hD ≅ L)
    (hi : canonicalSectionHom B S hS X D hD ≫ i.hom = L.unitHomEquiv.symm s) :
    D = zeroScheme B S hS X L s := by
  have hsec : SheafOfModules.sectionsMap i.hom (canonicalSection B S hS X D hD) = s :=
    L.unitHomEquiv.symm.injective
      ((SheafOfModules.unitHomEquiv_symm_comp (canonicalSection B S hS X D hD) i.hom).symm.trans
        hi)
  have hval : ∀ W : (SmallEtale B S hS X.1)ᵒᵖ,
      (i.hom.val.app W).hom ((canonicalSection B S hS X D hD).eval W) = s.eval W :=
    fun W => congrArg (fun t : L.sections => t.eval W) hsec
  refine (Subtype.ext (zeroSchemeSubfunctor_eq B S hS X L s D fun U hU => ?_)).symm
  exact (definingIdealAt_eq_sectionEvaluationIdealAt_canonicalSection B S hS X D hD U hU).trans
    (sectionEvaluationIdealAt_eq_of_iso B S hS X
      (associatedInvertibleSheaf B S hS X D hD) L (canonicalSection B S hS X D hD) s i hval U)

end AlgebraicGeometry.Space

