module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleLocalRingChart
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleMorphisms
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.Quotient.RestrictionFieldExtension
public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.EtaleSiteOfFppfSite

/-!
# The étale local ring of a representable algebraic space whose local rings are fields

The algebraic space represented by an object `X` of the big fppf site of `S` is its own étale
chart, and that chart is a small étale neighbourhood of *every* geometric point of it: the
section defining the geometric point is itself the required lift.  So Tag 04KF identifies the
étale local ring at any geometric point of `yoneda.obj X` with a strict henselization of the
local ring of the scheme underlying `X` at the point the geometric point selects, without having
to produce a chart at all.

When those local rings are fields the strict henselization is a field too, its maximal ideal
being generated by the maximal ideal of the base ([Stacks Project, Tag 08HS]).  This applies to
the algebraic space of the spectrum of a field, which is the object space of a groupoid in
algebraic spaces over a field.

## Main definitions

* `AlgebraicGeometry.Space.yonedaIdentityNeighborhood`: the identity chart of a representable
  algebraic space, read as a small étale neighbourhood of an arbitrary geometric point.

## Main results

* `AlgebraicGeometry.Space.isField_etaleLocalRing_yoneda`: the étale local ring of a
  representable algebraic space at a geometric point is a field as soon as the local rings of the
  representing scheme are.
* `AlgebraicGeometry.Space.isField_etaleLocalRing_fieldSpace`: the étale local ring of the
  algebraic space of the spectrum of a field, at any geometric point, is a field.
* `AlgebraicGeometry.Space.isAlgClosed_etaleLocalRing_yoneda`: the étale local ring of a
  representable algebraic space at a geometric point is an algebraically closed field as soon as
  the local rings of the representing scheme are isomorphic to one algebraically closed field.
* `AlgebraicGeometry.Space.isAlgClosed_etaleLocalRing_fieldSpace`: the étale local ring of the
  algebraic space of the spectrum of an algebraically closed field, at any geometric point, is an
  algebraically closed field.

## Implementation notes

The identity chart `𝟙 (yoneda.obj X)` is étale because the condition is stable under base change
and an identity is étale, which is how
`AlgebraicGeometry.Space.isEtale_iff_presheaf_of_yoneda` reads it; the lift of the geometric
point is its own section `w.val.value`, a morphism of site objects into `X`, and the
compatibility `point_comp` is then `rfl`.

The local rings of the spectrum of a field are fields, which is
`AlgebraicGeometry.isField_stalk_Spec_field`.

## References

* [Stacks Project, Tag 04KF](https://stacks.math.columbia.edu/tag/04KF)
* [Stacks Project, Tag 08HS](https://stacks.math.columbia.edu/tag/08HS)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry.Space

/-- A henselization of a local ring which is a field is again a field: its maximal ideal is
generated by the maximal ideal of the base, which is zero. -/
private theorem isField_of_isHenselization (R : Type*) [CommRing R] [IsLocalRing R]
    (hR : IsField R) (L : Type*) [Field L] [Algebra (ResidueField R) L]
    (Rh : Type*) [CommRing Rh] [IsLocalRing Rh] [Algebra R Rh]
    [IsLocalRing.IsHenselization R L Rh] : IsField Rh := by
  refine IsLocalRing.isField_iff_maximalIdeal_eq.mpr ?_
  rw [← IsLocalRing.IsHenselization.map_maximalIdeal (R := R) (L := L) (Rh := Rh),
    IsLocalRing.isField_iff_maximalIdeal_eq.mp hR, Ideal.map_bot]

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **A representable algebraic space is its own pointed étale chart.** The identity of
`yoneda.obj X` is an étale chart, and it is a small étale neighbourhood of *every* geometric
point of `yoneda.obj X`: the section defining the point is itself the required lift. -/
@[stacks 04JY "the identity chart of a representable algebraic space"]
abbrev yonedaIdentityNeighborhood (X : BigFppfOver B S hS)
    (w : GeometricPoint B S hS (yoneda.obj X)) : SmallEtaleNeighborhood w :=
  { chart := ⟨CostructuredArrow.mk (𝟙 (yoneda.obj X)),
      (isEtale_iff_presheaf_of_yoneda B S hS (𝟙 (yoneda.obj X))).mp
        (fun _ _ hφ => by simpa using hφ)⟩
    point := w.val.value
    point_comp := rfl }

/-- **The étale local ring of a representable algebraic space whose local rings are fields.**
If every local ring of the scheme underlying an object `X` of the big fppf site is a field, then
the étale local ring of the algebraic space `yoneda.obj X` at every geometric point is a field:
it is a strict henselization of one of those local rings. -/
theorem isField_etaleLocalRing_yoneda (X : BigFppfOver B S hS)
    (hX : ∀ x : (BigFppfOver.toScheme B S hS).obj X,
      IsField (((BigFppfOver.toScheme B S hS).obj X).presheaf.stalk x))
    (w : GeometricPoint B S hS (yoneda.obj X)) :
    IsField (etaleLocalRing B S hS (yoneda.obj X) w) := by
  let V : SmallEtaleNeighborhood w := yonedaIdentityNeighborhood X w
  let R := (neighborhoodChartScheme V).presheaf.stalk
    ((chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField))
  let κ := separableClosure (ResidueField R) (chartGeometricPoint V).residueField
  let T := IsLocalRing.henselizationTower R κ
  exact (strictHenselizationEquivEtaleLocalRing
    (_root_.AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS X) V
    (bigEtaleSiteOfFppfSite B) V.chart.obj.left.left.property T).symm.isField
    (isField_of_isHenselization R (hX _) κ T.strictHenselization)

/-- **The étale local ring of the algebraic space of the spectrum of a field is a field.** -/
theorem isField_etaleLocalRing_fieldSpace (C : BigFppfSite.{u}) {S : Scheme.{u}}
    (hS : C.Contains S) {k : Type u} [Field k] (hk : C.Contains (Spec (.of k)))
    (structureMap : Spec (.of k) ⟶ S)
    (w : GeometricPoint C S hS (fieldSpace C hS hk structureMap).obj) :
    IsField (etaleLocalRing C S hS (fieldSpace C hS hk structureMap).obj w) :=
  isField_etaleLocalRing_yoneda (Over.mk (⟨structureMap⟩ : C.obj hk ⟶ C.obj hS))
    (fun x => _root_.AlgebraicGeometry.isField_stalk_Spec_field k x) w

/-- A local ring which is a field is isomorphic to its residue field through the residue map. -/
private noncomputable def residueEquivOfIsField (R : Type*) [CommRing R] [IsLocalRing R]
    (hR : IsField R) : R ≃+* ResidueField R :=
  RingEquiv.ofBijective (residue R)
    ⟨fun a b hab => by
      rw [← sub_eq_zero, ← map_sub, residue_eq_zero_iff,
        IsLocalRing.isField_iff_maximalIdeal_eq.mp hR, Ideal.mem_bot] at hab
      exact sub_eq_zero.mp hab, residue_surjective⟩

/-- Algebraic closedness is carried along a ring isomorphism, across universes. -/
private theorem isAlgClosed_of_ringEquiv {k : Type*} {k' : Type*} [Field k] [Field k']
    [IsAlgClosed k] (e : k ≃+* k') : IsAlgClosed k' := by
  refine IsAlgClosed.of_exists_root _ fun q hm hq => ?_
  have hqe : (q.map e.symm.toRingHom).degree ≠ 0 := by
    rw [Polynomial.degree_map]
    exact (Polynomial.degree_pos_of_irreducible hq).ne'
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_root (q.map e.symm.toRingHom) hqe
  refine ⟨e x, e.symm.injective ?_⟩
  rw [Polynomial.IsRoot] at hx
  rw [map_zero, ← hx]
  clear hx hqe hq hm
  induction q using Polynomial.induction_on <;> simp_all

/-- **The étale local ring of a representable algebraic space whose local rings are an
algebraically closed field.** If every local ring of the scheme underlying an object `X` of the
big fppf site is isomorphic to a fixed algebraically closed field `K`, then the étale local ring of
the algebraic space `yoneda.obj X` at every geometric point is an algebraically closed field: it
is a strict henselization of one of those local rings, and a separable algebraic closure of an
algebraically closed field is that field. -/
theorem isAlgClosed_etaleLocalRing_yoneda (X : BigFppfOver B S hS)
    (hX : ∀ x : (BigFppfOver.toScheme B S hS).obj X,
      IsField (((BigFppfOver.toScheme B S hS).obj X).presheaf.stalk x))
    (K : Type u) [Field K] [IsAlgClosed K]
    (hK : ∀ x : (BigFppfOver.toScheme B S hS).obj X,
      Nonempty (((BigFppfOver.toScheme B S hS).obj X).presheaf.stalk x ≃+* K))
    (w : GeometricPoint B S hS (yoneda.obj X)) :
    letI := (isField_etaleLocalRing_yoneda X hX w).toField
    IsAlgClosed (etaleLocalRing B S hS (yoneda.obj X) w) := by
  let V : SmallEtaleNeighborhood w := yonedaIdentityNeighborhood X w
  let p := (chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField)
  let R := (neighborhoodChartScheme V).presheaf.stalk p
  let κ := separableClosure (ResidueField R) (chartGeometricPoint V).residueField
  let T := IsLocalRing.henselizationTower R κ
  -- the local ring is a field, isomorphic to its residue field, and so is the strict henselization
  let : Field R := (hX p).toField
  have hT : IsField T.strictHenselization := isField_of_isHenselization R (hX p) κ _
  let : Field T.strictHenselization := hT.toField
  -- `K` is isomorphic to the residue field of `R`, hence `κ` is algebraically closed too
  let e₁ : K ≃+* ResidueField R := (hK p).some.symm.trans (residueEquivOfIsField R (hX p))
  have : IsAlgClosed (ResidueField R) := isAlgClosed_of_ringEquiv e₁
  have hκ : Function.Bijective (algebraMap (ResidueField R) κ) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  -- and the étale local ring is the strict henselization, a field with residue field `κ`
  let := (isField_etaleLocalRing_yoneda X hX w).toField
  exact isAlgClosed_of_ringEquiv
    ((((e₁.trans (RingEquiv.ofBijective _ hκ)).trans T.strictHenselizationResidueEquiv).trans
      (residueEquivOfIsField _ hT).symm).trans
      (strictHenselizationEquivEtaleLocalRing
        (_root_.AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS X) V (bigEtaleSiteOfFppfSite B)
        V.chart.obj.left.left.property T))

/-- **The étale local ring of the algebraic space of the spectrum of an algebraically closed
field is an algebraically closed field**, at every geometric point. -/
theorem isAlgClosed_etaleLocalRing_fieldSpace (C : BigFppfSite.{u}) {S : Scheme.{u}}
    (hS : C.Contains S) {k : Type u} [Field k] [IsAlgClosed k] (hk : C.Contains (Spec (.of k)))
    (structureMap : Spec (.of k) ⟶ S)
    (w : GeometricPoint C S hS (fieldSpace C hS hk structureMap).obj) :
    letI := (isField_etaleLocalRing_fieldSpace C hS hk structureMap w).toField
    IsAlgClosed (etaleLocalRing C S hS (fieldSpace C hS hk structureMap).obj w) := by
  refine isAlgClosed_etaleLocalRing_yoneda (Over.mk (⟨structureMap⟩ : C.obj hk ⟶ C.obj hS))
    (fun x => _root_.AlgebraicGeometry.isField_stalk_Spec_field k x) k (fun x => ?_) w
  have hfield : IsField Γ(Spec (CommRingCat.of k), ⊤) :=
    isField_of_isIntegral_of_subsingleton (Spec (CommRingCat.of k))
  let _ : Field Γ(Spec (CommRingCat.of k), ⊤) := hfield.toField
  let _ := (Spec (CommRingCat.of k)).presheaf.algebra_section_stalk
    (U := (⊤ : (Spec (CommRingCat.of k)).Opens)) ⟨x, trivial⟩
  have hloc := (isAffineOpen_top (Spec (CommRingCat.of k))).isLocalization_stalk ⟨x, trivial⟩
  have hbij : Function.Bijective
      (algebraMap Γ(Spec (CommRingCat.of k), ⊤) ((Spec (CommRingCat.of k)).presheaf.stalk x)) :=
    IsField.localization_map_bijective
      (M := Ideal.primeCompl ((isAffineOpen_top (Spec (CommRingCat.of k))).primeIdealOf
        ⟨x, trivial⟩).asIdeal)
      (fun h ↦ h (Ideal.zero_mem _)) hfield
  exact ⟨(RingEquiv.ofBijective _ hbij).symm.trans
    (Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv⟩

end AlgebraicGeometry.Space

end
