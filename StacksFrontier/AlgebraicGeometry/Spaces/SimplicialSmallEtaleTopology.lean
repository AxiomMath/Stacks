module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology
public import Mathlib.CategoryTheory.Sites.DenseSubsite.SheafEquiv
public import StacksFrontier.AlgebraicGeometry.Spaces.SimplicialSmallEtaleSite
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.SpacesAffineCovering
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.SpacesAffineDensity
public import StacksFrontier.AlgebraicGeometry.Spaces.UniformHigherDirectImageVanishing
public import StacksFrontier.AlgebraicGeometry.Topologies.BigSites.CoveringRefinesSieve

/-!
# The small and affine étale sites of a simplicial algebraic space

Let `X` be a simplicial algebraic space (Stacks 0DE7). Inside its spaces-étale site
`X_{spaces,étale}` sit the full subcategories `X_{affine,étale} ⊂ X_étale` of the objects `U/X_n`
with `U` affine, respectively a scheme. Each carries its natural topology, generated by the
jointly point-surjective étale families in a single simplicial degree, and the inclusions define
equivalences of topoi `Sh(X_{affine,étale}) = Sh(X_étale) = Sh(X_{spaces,étale})`.

## Main definitions

* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.subsiteTopology`: the natural topology on a
  full subcategory of `X_{spaces,étale}` containing the affine objects.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.IsScheme` and `.IsAffine`: the objects of
  `X_étale` and `X_{affine,étale}`; `.etaleTopology` and `.affineTopology` their topologies.

## Main results

* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.functorPushforward_degreeInclusion_mem` and
  `.functorPullback_degreeInclusion_mem`: a sieve on an object of degree `n` covers exactly
  when its restriction to the spaces-étale site of `X_n` covers.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.degreeInclusion_isContinuous` and
  `.degreeInclusion_isCocontinuous`: the inclusion of the spaces-étale site of `X_n` is continuous
  and cocontinuous.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.isDenseSubsite_ι`: such a full subcategory
  is a dense subsite.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.etale_sheafEquivalence`,
  `.affine_sheafEquivalence` and `.affineToEtale_sheafEquivalence`: the three equivalences of
  topoi.
-/

@[expose] public section

open CategoryTheory Opposite CategoryTheory.Limits

universe u w w'

namespace AlgebraicGeometry.Space.SimplicialSpacesEtaleSite

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : SimplicialObject (AlgebraicSpaces B S hS)}

/-! ### Sieves on an object of a single degree -/

/-- A covering sieve of the spaces-étale site is refined by a covering family. -/
private theorem exists_isCovering_ofArrows_le {Y : AlgebraicSpaces B S hS}
    {V : SpacesEtale B S hS Y} {T : Sieve V} (hT : T ∈ SpacesEtale.topology B S hS Y V) :
    ∃ E : PreZeroHypercover.{u + 1} V, SpacesEtale.IsCovering B S hS Y ⟨V, E⟩ ∧
      Presieve.ofArrows E.X E.f ≤ T :=
  CategoryTheory.exists_covering_refining_sieve
    (SpacesEtale.IsCovering B S hS _) (SpacesEtale.precoverage B S hS _)
    (fun ⟨E, h₁, h₂⟩ ↦ ⟨E, h₂, h₁⟩) (SpacesEtale.isSite B S hS _) hT

/-- A sieve containing the image of a covering family of degree `n` covers in
`X_{spaces,étale}`. -/
private theorem mem_topology_of_ofArrows_le {n : SimplexCategory}
    {V : SpacesEtale B S hS (X.obj (op n))}
    (E : PreZeroHypercover.{u + 1} V) (hE : SpacesEtale.IsCovering B S hS _ ⟨V, E⟩)
    {T : Sieve ((degreeInclusion X n).obj V)}
    (h : ∀ ⦃Z⦄ ⦃f : Z ⟶ (degreeInclusion X n).obj V⦄,
      Presieve.ofArrows (fun i ↦ (degreeInclusion X n).obj (E.X i))
        (fun i ↦ (degreeInclusion X n).map (E.f i)) f → T f) :
    T ∈ topology X ((degreeInclusion X n).obj V) :=
  Coverage.mem_toGrothendieck_sieves_of_superset (coverage X) h ⟨E, hE, rfl⟩

/-- The image of a covering sieve of the spaces-étale site of `X_n` covers in
`X_{spaces,étale}`. -/
theorem functorPushforward_degreeInclusion_mem {n : SimplexCategory}
    {V : SpacesEtale B S hS (X.obj (op n))} {T : Sieve V}
    (hT : T ∈ SpacesEtale.topology B S hS (X.obj (op n)) V) :
    T.functorPushforward (degreeInclusion X n) ∈ topology X ((degreeInclusion X n).obj V) := by
  obtain ⟨E, hE, hle⟩ := exists_isCovering_ofArrows_le hT
  refine mem_topology_of_ofArrows_le E hE ?_
  rintro _ _ ⟨i⟩
  exact ⟨E.X i, E.f i, 𝟙 _, hle _ _ (Presieve.ofArrows.mk i), (Category.id_comp _).symm⟩

/-- Pulling a sieve back along the inclusion of a degree commutes with pullback of sieves. -/
theorem functorPullback_pullback_degreeInclusion {n : SimplexCategory}
    {V W : SpacesEtale B S hS (X.obj (op n))} (R : Sieve ((degreeInclusion X n).obj V))
    (g : W ⟶ V) :
    (R.functorPullback (degreeInclusion X n)).pullback g =
      (R.pullback ((degreeInclusion X n).map g)).functorPullback (degreeInclusion X n) := by
  ext Z h
  show R ((degreeInclusion X n).map (h ≫ g)) ↔ R ((degreeInclusion X n).map h ≫ _)
  rw [Functor.map_comp]

/-- A covering sieve of `X_{spaces,étale}` on an object of degree `n` restricts to a covering
sieve of the spaces-étale site of `X_n`. -/
theorem functorPullback_degreeInclusion_mem {U : SimplicialSpacesEtaleSite B S hS X}
    {R : Sieve U} (hR : R ∈ topology X U) :
    (R : Sieve ((degreeInclusion X U.degree).obj U.obj)).functorPullback
      (degreeInclusion X U.degree) ∈ SpacesEtale.topology B S hS _ U.obj := by
  change (coverage X).Saturate U R at hR
  induction hR with
  | of U R hR =>
    obtain ⟨E, hE, rfl⟩ := hR
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck (R := E.presieve₀) ⟨E, rfl, hE⟩)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact Sieve.le_generate _ _ _ (Presieve.ofArrows.mk i)
  | top U => exact (SpacesEtale.topology B S hS _).top_mem _
  | transitive U R T _ _ ih₁ ih₂ =>
    refine (SpacesEtale.topology B S hS _).transitive ih₁ _ fun W g hg ↦ ?_
    exact (congrArg (· ∈ SpacesEtale.topology B S hS _ W)
      (functorPullback_pullback_degreeInclusion (V := U.obj) T g)).mpr (ih₂ hg)

/-! ### Continuity and cocontinuity of the inclusion of a degree -/

/-- The inclusion of a degree preserves compatible families: two morphisms `f₁, f₂` into objects
of degree `n` with `f₁ ≫ g₁ = f₂ ≫ g₂` factor through the fibre product of `g₁` and `g₂` in
degree `n`. -/
theorem compatiblePreserving_degreeInclusion (n : SimplexCategory) :
    CompatiblePreserving.{w} (topology X) (degreeInclusion X n) where
  compatible ℱ {Z} {T} {x} hx {Y₁ Y₂} {W} f₁ f₂ {g₁} {g₂} hg₁ hg₂ e := by
    have hb : f₁.base = f₂.base := by
      have h := congrArg Hom.base e
      simp only [comp_base, degreeInclusion_map_base] at h
      exact (Category.id_comp _).symm.trans (h.trans (Category.id_comp _))
    have e' : f₁.hom ≫ g₁.hom.left = f₂.hom ≫ g₂.hom.left := congrArg Hom.hom e
    let P : SpacesEtale B S hS (X.obj (op n)) := (pairObj g₁ g₂).obj
    let q₁ : P ⟶ Y₁ := ObjectProperty.homMk (Over.homMk (pullback.fst g₁.hom.left g₂.hom.left) rfl)
    let q₂ : P ⟶ Y₂ := ObjectProperty.homMk (Over.homMk (pullback.snd g₁.hom.left g₂.hom.left)
      ((whisker_eq _ (Over.w g₂.hom).symm).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker pullback.condition.symm _).trans ((Category.assoc _ _ _).trans
          (whisker_eq _ (Over.w g₁.hom)))))))
    let ℓ : W ⟶ (degreeInclusion X n).obj P :=
      ⟨f₁.base, pullback.lift f₁.hom f₂.hom e',
        (pullback.lift_fst_assoc f₁.hom f₂.hom e' Y₁.1.hom).trans f₁.w⟩
    have h₁ : f₁ = ℓ ≫ (degreeInclusion X n).map q₁ :=
      Hom.ext (Category.id_comp _).symm (pullback.lift_fst _ _ _).symm
    have h₂ : f₂ = ℓ ≫ (degreeInclusion X n).map q₂ :=
      Hom.ext (hb.symm.trans (Category.id_comp _).symm) (pullback.lift_snd _ _ _).symm
    rw [h₁, h₂, op_comp, op_comp, FunctorToTypes.map_comp_apply, FunctorToTypes.map_comp_apply]
    exact congrArg (ℱ.obj.map ℓ.op)
      (hx q₁ q₂ hg₁ hg₂ (ObjectProperty.hom_ext _ (Over.OverMorphism.ext pullback.condition)))

/-- The inclusion of a degree is cover-preserving. -/
theorem coverPreserving_degreeInclusion (n : SimplexCategory) :
    CoverPreserving (SpacesEtale.topology B S hS (X.obj (op n))) (topology X)
      (degreeInclusion X n) where
  cover_preserve hT := functorPushforward_degreeInclusion_mem hT

/-- **The inclusion of the spaces-étale site of `X_n` into `X_{spaces,étale}` is continuous.** -/
instance degreeInclusion_isContinuous (n : SimplexCategory) :
    (degreeInclusion X n).IsContinuous (SpacesEtale.topology B S hS (X.obj (op n)))
      (topology X) :=
  Functor.isContinuous_of_coverPreserving (compatiblePreserving_degreeInclusion n)
    (coverPreserving_degreeInclusion n)

/-- **The inclusion of the spaces-étale site of `X_n` into `X_{spaces,étale}` is cocontinuous.** -/
instance degreeInclusion_isCocontinuous (n : SimplexCategory) :
    (degreeInclusion X n).IsCocontinuous (SpacesEtale.topology B S hS (X.obj (op n)))
      (topology X) where
  cover_lift {V} _ hR := functorPullback_degreeInclusion_mem (U := (degreeInclusion X n).obj V) hR

/-! ### Full subcategories containing the affine objects -/

section Subsite

variable (P : ObjectProperty (SimplicialSpacesEtaleSite B S hS X))

/-- The natural covering families of a full subcategory of `X_{spaces,étale}`: the jointly
point-surjective étale families, in a single simplicial degree, whose members lie in it. -/
def subsiteCoveringFamilies (U : P.FullSubcategory) : Set (Presieve U) :=
  {R | ∃ E : PreZeroHypercover.{u + 1} U.obj.obj,
    SpacesEtale.IsCovering B S hS (X.obj (op U.obj.degree)) ⟨U.obj.obj, E⟩ ∧
      ∃ hE : ∀ i, P ((degreeInclusion X U.obj.degree).obj (E.X i)),
        R = Presieve.ofArrows (fun i ↦ (⟨_, hE i⟩ : P.FullSubcategory))
          (fun i ↦ ObjectProperty.homMk ((degreeInclusion X U.obj.degree).map (E.f i)))}

variable {P}

/-- The natural covering families of a full subcategory containing the affine objects are
stable under base change: the base change of a family is refined by affine objects. -/
theorem subsiteCoveringFamilies_pullback
    (hP : ∀ U : SimplicialSpacesEtaleSite B S hS X,
      SpacesEtale.IsAffineScheme B S hS _ U.obj → P U)
    {U U' : P.FullSubcategory} (g : U' ⟶ U) (R : Presieve U)
    (hR : R ∈ subsiteCoveringFamilies P U) :
    ∃ T : Presieve U', T ∈ subsiteCoveringFamilies P U' ∧ T.FactorsThruAlong R g := by
  obtain ⟨E, hE, hEP, rfl⟩ := hR
  let E' : PreZeroHypercover.{u + 1} U'.obj.obj :=
    { I₀ := E.I₀
      X := fun i ↦ baseChangeObj g.hom (E.f i)
      f := fun i ↦ baseChangeSnd g.hom (E.f i) }
  have hE' : SpacesEtale.IsCovering B S hS _ ⟨U'.obj.obj, E'⟩ := fun x ↦ by
    obtain ⟨i, y, hy⟩ := hE (pointsMap B S hS _ g.hom.hom.hom x)
    obtain ⟨w, -, hw⟩ := exists_point_of_isPullback B S hS
      (IsPullback.of_hasPullback (E.f i).hom.left g.hom.hom) y x hy
    exact ⟨i, w, hw⟩
  obtain ⟨F, hF, hFa, hFE⟩ :=
    SpacesEtale.exists_isCovering_isAffineScheme_refinement_spacesAffineCovering B S hS _ E' hE'
  refine ⟨_, ⟨F, hF, fun j ↦ hP _ (hFa j), rfl⟩, ?_⟩
  rintro _ _ ⟨j⟩
  obtain ⟨i, a, ha⟩ := hFE j
  refine ⟨⟨_, hEP i⟩, ObjectProperty.homMk ((degreeInclusion X U'.obj.degree).map a ≫
    baseChangeFst g.hom (E.f i)), _, Presieve.ofArrows.mk i, ?_⟩
  ext1
  exact (Category.assoc _ _ _).trans ((whisker_eq _ (baseChangeFst_comp g.hom (E.f i))).trans
    ((Category.assoc _ _ _).symm.trans (eq_whisker
      (((degreeInclusion X U'.obj.degree).map_comp a (E'.f i)).symm.trans (congrArg _ ha)) g.hom)))

variable (P) in
/-- The natural coverage of a full subcategory of `X_{spaces,étale}` containing the affine
objects. -/
noncomputable def subsiteCoverage
    (hP : ∀ U : SimplicialSpacesEtaleSite B S hS X,
      SpacesEtale.IsAffineScheme B S hS _ U.obj → P U) : Coverage P.FullSubcategory where
  coverings := subsiteCoveringFamilies P
  pullback _ _ g R hR := subsiteCoveringFamilies_pullback hP g R hR

variable (P) in
/-- The natural topology of a full subcategory of `X_{spaces,étale}` containing the affine
objects, generated by the jointly point-surjective étale families in a single degree. -/
noncomputable abbrev subsiteTopology
    (hP : ∀ U : SimplicialSpacesEtaleSite B S hS X,
      SpacesEtale.IsAffineScheme B S hS _ U.obj → P U) :
    GrothendieckTopology P.FullSubcategory :=
  (subsiteCoverage P hP).toGrothendieck

variable (hP : ∀ U : SimplicialSpacesEtaleSite B S hS X,
  SpacesEtale.IsAffineScheme B S hS _ U.obj → P U)

include hP in
/-- Every object of `X_{spaces,étale}` is covered by objects of a full subcategory containing the
affine objects. -/
theorem isCoverDense_ι : P.ι.IsCoverDense (topology X) where
  is_cover U := by
    refine GrothendieckTopology.superset_covering _ ?_ (functorPushforward_degreeInclusion_mem
      (SpacesEtale.generate_affineSchemePresieve_mem B S hS _ U.obj))
    rintro Y f ⟨Z, g, h, ⟨W, k, a, ha, rfl⟩, rfl⟩
    exact ⟨{ obj := ⟨_, hP ((degreeInclusion X U.degree).obj W)
               (show SpacesEtale.IsAffineScheme B S hS _ W from ha)⟩
             lift := h ≫ (degreeInclusion X U.degree).map k
             map := (degreeInclusion X U.degree).map a
             fac := (Category.assoc _ _ _).trans (whisker_eq h (Functor.map_comp _ _ _).symm) }⟩

/-- The image of a covering sieve of the subsite covers in `X_{spaces,étale}`. -/
theorem functorPushforward_ι_mem {U : P.FullSubcategory} {R : Sieve U}
    (hR : R ∈ subsiteTopology P hP U) :
    R.functorPushforward P.ι ∈ topology X (P.ι.obj U) := by
  have := isCoverDense_ι hP
  refine Functor.mem_restrictedTopology_iff.1 ((((Coverage.gi _).gc _ _).2 ?_) U hR)
  intro V T hT
  obtain ⟨E, hE, hEP, rfl⟩ := hT
  rw [GrothendieckTopology.mem_toCoverage_iff, Functor.mem_restrictedTopology_iff]
  refine mem_topology_of_ofArrows_le E hE ?_
  rintro _ _ ⟨i⟩
  exact ⟨⟨_, hEP i⟩, ObjectProperty.homMk ((degreeInclusion X V.obj.degree).map (E.f i)), 𝟙 _,
    Sieve.le_generate _ _ _ (Presieve.ofArrows.mk i), (Category.id_comp _).symm⟩

/-- A sieve of the subsite whose image covers in `X_{spaces,étale}` is covering. -/
theorem mem_of_functorPushforward_ι_mem {U : P.FullSubcategory} {R : Sieve U}
    (hR : R.functorPushforward P.ι ∈ topology X (P.ι.obj U)) :
    R ∈ subsiteTopology P hP U := by
  have h₀ := functorPullback_degreeInclusion_mem hR
  obtain ⟨E, hE, hle⟩ := exists_isCovering_ofArrows_le h₀
  obtain ⟨F, hF, hFa, hFE⟩ :=
    SpacesEtale.exists_isCovering_isAffineScheme_refinement_spacesAffineCovering B S hS _ E hE
  refine Coverage.mem_toGrothendieck_sieves_of_superset _ (R := Presieve.ofArrows
    (fun j ↦ (⟨_, hP _ (hFa j)⟩ : P.FullSubcategory))
    (fun j ↦ ObjectProperty.homMk ((degreeInclusion X U.obj.degree).map (F.f j)))) ?_
    ⟨F, hF, fun j ↦ hP _ (hFa j), rfl⟩
  rintro _ _ ⟨j⟩
  obtain ⟨i, a, ha⟩ := hFE j
  obtain ⟨Z, g, h, hg, hfac⟩ := hle _ _ (Presieve.ofArrows.mk i)
  convert R.downward_closed hg
    (ObjectProperty.homMk ((degreeInclusion X U.obj.degree).map a ≫ h) :
      (⟨_, hP _ (hFa j)⟩ : P.FullSubcategory) ⟶ Z) using 1
  ext1
  exact ((congrArg (degreeInclusion X U.obj.degree).map ha.symm).trans
    (Functor.map_comp _ _ _)).trans ((whisker_eq _ hfac).trans (Category.assoc _ _ _).symm)

/-- **Stacks 0DE7.** A full subcategory of `X_{spaces,étale}` containing the affine objects,
with its natural topology, is a dense subsite. -/
theorem isDenseSubsite_ι : P.ι.IsDenseSubsite (subsiteTopology P hP) (topology X) :=
  have := isCoverDense_ι hP
  { functorPushforward_mem_iff :=
      ⟨mem_of_functorPushforward_ι_mem hP, functorPushforward_ι_mem hP⟩ }

end Subsite

/-! ### The small étale site and the affine étale site -/

variable (X)

/-- The objects `U/X_n` of `X_{spaces,étale}` with `U` a scheme: the objects of the small étale
site `X_étale`. -/
def IsScheme : ObjectProperty (SimplicialSpacesEtaleSite B S hS X) :=
  fun U ↦ IsRepresentableSpace B S hS U.obj.1.left

/-- The objects `U/X_n` of `X_{spaces,étale}` with `U` affine: the objects of the affine étale
site `X_{affine,étale}`. -/
def IsAffine : ObjectProperty (SimplicialSpacesEtaleSite B S hS X) :=
  fun U ↦ SpacesEtale.IsAffineScheme B S hS _ U.obj

/-- An affine object is a scheme. -/
theorem isAffine_le_isScheme : IsAffine X ≤ IsScheme X := by
  rintro U ⟨W, -, ⟨e⟩⟩
  exact ⟨W, ⟨((ObjectProperty.ι _).mapIso e).symm⟩⟩

/-- **Stacks 0DE7.** The topology of the small étale site `X_étale` of a simplicial algebraic
space: generated by the jointly surjective étale families of schemes in a single degree. -/
noncomputable abbrev etaleTopology : GrothendieckTopology (IsScheme X).FullSubcategory :=
  subsiteTopology (IsScheme X) fun U hU ↦ isAffine_le_isScheme X U hU

/-- **Stacks 0DE7.** The topology of the affine étale site `X_{affine,étale}` of a simplicial
algebraic space: generated by the jointly surjective étale families of affine schemes in a
single degree. -/
noncomputable abbrev affineTopology : GrothendieckTopology (IsAffine X).FullSubcategory :=
  subsiteTopology (IsAffine X) fun _ hU ↦ hU

/-- The inclusion `X_étale ⊂ X_{spaces,étale}` is a dense subsite. -/
instance isDenseSubsite_etale :
    (IsScheme X).ι.IsDenseSubsite (etaleTopology X) (topology X) :=
  isDenseSubsite_ι _

/-- The inclusion `X_{affine,étale} ⊂ X_{spaces,étale}` is a dense subsite. -/
instance isDenseSubsite_affine :
    (IsAffine X).ι.IsDenseSubsite (affineTopology X) (topology X) :=
  isDenseSubsite_ι _

/-- The inclusion `X_{affine,étale} ⊂ X_étale`. -/
abbrev affineToEtale : (IsAffine X).FullSubcategory ⥤ (IsScheme X).FullSubcategory :=
  ObjectProperty.ιOfLE (isAffine_le_isScheme X)

/-- **Stacks 0DE7.** The inclusion `X_étale ⊂ X_{spaces,étale}` defines an equivalence of topoi
`Sh(X_étale) = Sh(X_{spaces,étale})`. -/
instance etale_sheafEquivalence (A : Type w) [Category.{w'} A]
    [∀ Y, HasLimitsOfShape (StructuredArrow Y (IsScheme X).ι.op) A] :
    ((IsScheme X).ι.sheafPushforwardContinuous A (etaleTopology X)
      (topology X)).IsEquivalence := inferInstance

/-- **Stacks 0DE7.** The inclusion `X_{affine,étale} ⊂ X_{spaces,étale}` defines an equivalence
of topoi `Sh(X_{affine,étale}) = Sh(X_{spaces,étale})`. -/
instance affine_sheafEquivalence (A : Type w) [Category.{w'} A]
    [∀ Y, HasLimitsOfShape (StructuredArrow Y (IsAffine X).ι.op) A] :
    ((IsAffine X).ι.sheafPushforwardContinuous A (affineTopology X)
      (topology X)).IsEquivalence := inferInstance

/-- The inclusion `X_{affine,étale} ⊂ X_étale` followed by `X_étale ⊂ X_{spaces,étale}` is the
inclusion of `X_{affine,étale}`. -/
theorem affineToEtale_comp_ι : affineToEtale X ⋙ (IsScheme X).ι = (IsAffine X).ι := rfl

/-- The inclusion `X_{affine,étale} ⊂ X_étale` is continuous. -/
instance affineToEtale_isContinuous :
    (affineToEtale X).IsContinuous (affineTopology X) (etaleTopology X) where
  op_comp_isSheaf_of_types G := by
    let Φ := (IsScheme X).ι.sheafPushforwardContinuous (Type (u + 1)) (etaleTopology X)
      (topology X)
    exact Presieve.isSheaf_iso _ (Functor.isoWhiskerLeft (affineToEtale X).op
        ((sheafToPresheaf _ _).mapIso (Φ.objObjPreimageIso G)))
      ((isSheaf_iff_isSheaf_of_type _ _).1
        (Functor.op_comp_isSheaf (IsAffine X).ι (affineTopology X) (topology X)
          (Φ.objPreimage G)))

/-- **Stacks 0DE7.** The inclusion `X_{affine,étale} ⊂ X_étale` defines an equivalence of topoi
`Sh(X_{affine,étale}) = Sh(X_étale)`. -/
instance affineToEtale_sheafEquivalence (A : Type w) [Category.{w'} A]
    [∀ Y, HasLimitsOfShape (StructuredArrow Y (IsScheme X).ι.op) A]
    [∀ Y, HasLimitsOfShape (StructuredArrow Y (IsAffine X).ι.op) A] :
    ((affineToEtale X).sheafPushforwardContinuous A (affineTopology X)
      (etaleTopology X)).IsEquivalence := by
  have : ((IsScheme X).ι.sheafPushforwardContinuous A (etaleTopology X) (topology X) ⋙
      (affineToEtale X).sheafPushforwardContinuous A (affineTopology X)
        (etaleTopology X)).IsEquivalence :=
    inferInstanceAs ((IsAffine X).ι.sheafPushforwardContinuous A (affineTopology X)
      (topology X)).IsEquivalence
  exact Functor.isEquivalence_of_comp_left
    ((IsScheme X).ι.sheafPushforwardContinuous A (etaleTopology X) (topology X)) _

end AlgebraicGeometry.Space.SimplicialSpacesEtaleSite
