module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartDiagramBaseChangeComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePullbackSectionGenerators

/-!
# An inverse image of modules is locally generated by its chart sections

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` of a big fppf site `B` and
let `M` be a sheaf of `𝒪_Y`-modules on the small étale site.  Every section `s` of `M` over the
chart of `Y` of a commuting square `d` of étale scheme charts has a canonical image
`f^*s = AlgebraicGeometry.Space.modulePullbackChartSection` in `(f^*M)(d.U)`, the chart component
of the unit of the Stacks 03D7 adjunction.  This file proves that **those sections generate
`f^*M` locally**: every section of `f^*M` over a chart of `X` restricts, along the members of a
covering sieve, into the `𝒪_X`-submodule spanned by the restrictions of the sections `f^*s`.

No hypothesis on `M` is needed, and nothing about the construction of `f^*` is used.  The
argument is the one of
`StacksFrontier/Algebra/Category/ModuleCat/Sheaf/PullbackUnitGenerators.lean` for a morphism of
ringed spaces: let `S ⊆ f^*M` be the subsheaf of sections lying *locally* in the span of the
chart sections.  A morphism `g : f^*M ⟶ Z` killing `S` kills every chart section, so the
chartwise transpose `AlgebraicGeometry.Space.modulePullbackHomFMap` of `g` is the zero linear map
of sections (`AlgebraicGeometry.Space.modulePullbackHomFMap_app`: the values of the transpose
*are* the values of `g` on the chart sections); the transpose is injective, being two bijections,
so `g = 0`.  As the sheaves of modules are preadditive this says that the inclusion of `S` is an
epimorphism, and an epimorphism of sheaves of modules is locally surjective, which upgrades
"locally in the span" to "in the span" and gives the statement.

## Main results

* `AlgebraicGeometry.Space.injective_modulePullbackHomFMap`: the chartwise transpose of a
  morphism out of an inverse image of modules determines it.
* `AlgebraicGeometry.Space.modulePullbackChartFMap_app_eq_unitSection`: the values of the chart
  component of the unit are the unit sections.
* `AlgebraicGeometry.Space.epi_localSpan_modulePullbackChart_ι`: the inclusion of the local span
  of the chart sections into `f^*M` is an epimorphism.
* `AlgebraicGeometry.Space.spanSieve_modulePullbackChart_mem`: **an inverse image of modules is
  locally generated by its chart sections.**

## Implementation notes

The spanning family is `AlgebraicGeometry.Space.moduleFMapSpanningSet` at the chart component of
the unit, which is the family of *all restrictions* of the values `f^*s`; that is what makes the
family stable under restriction with no side condition, and it is the form
`Stacks.SheafOfModules.spanSubmodule` consumes.

The two sheafification hypotheses of `Stacks.SheafOfModules.mem_localSpan_of_epi_ι` are at
`AddCommGrpCat.{u}`, the universe of the sections of the structure sheaf, and are supplied as
local instances: they are registered for `AlgebraicGeometry.Space.SmallEtale.topology` and
instance search does not unfold `AlgebraicGeometry.Space.smallEtaleRingedSite` to see that the
topology of the ringed site is that one.

## References

* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU)
* [Stacks Project, Tag 03D7](https://stacks.math.columbia.edu/tag/03D7)
* [Stacks Project, Tag 01AH](https://stacks.math.columbia.edu/tag/01AH)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (M : Modules.{u, u} B S hS Y.1 Y.2)

/-- **The chartwise transpose determines a morphism out of an inverse image of modules.**  It is
the composite of the hom-set bijection of the Stacks 03D7 adjunction with the chart
correspondence of Stacks 03LU for the direct image, both bijections. -/
theorem injective_modulePullbackHomFMap (N : Modules.{u, u} B S hS X.1 X.2) :
    Function.Injective (modulePullbackHomFMap B S hS f M N) := fun _ _ h ↦
  ((modulePullbackAdjunction B S hS f).homEquiv M N).injective
    ((modulePushforwardHomEquiv B S hS f N M).injective h)

/-- The values of the chart component of the unit are the unit sections of
`AlgebraicGeometry.Space.modulePullbackSectionGenerators`. -/
theorem modulePullbackChartFMap_app_eq_unitSection
    (d : ChartDiagram B S hS X.1 Y.1 f.hom) (s : M.val.obj (op d.V)) :
    (modulePullbackChartFMap B S hS f M).app d s =
      modulePullbackUnitSection B S hS f M d s :=
  modulePullbackHomFMap_app B S hS f M ((modulePullback B S hS f).obj M) (𝟙 _) d s

/-- The chart sections of `f^*M` belong to the spanning family of the chart component of the
unit. -/
theorem modulePullbackUnitSection_mem_moduleFMapSpanningSet
    (d : ChartDiagram B S hS X.1 Y.1 f.hom) (s : M.val.obj (op d.V)) :
    modulePullbackUnitSection B S hS f M d s ∈
      moduleFMapSpanningSet B S hS f M ((modulePullback B S hS f).obj M)
        (modulePullbackChartFMap B S hS f M) (op d.U) :=
  ⟨d, 𝟙 d.U, s,
    (CategoryTheory.congr_fun
        (((modulePullback B S hS f).obj M).val.presheaf.map_id (op d.U))
        ((modulePullbackChartFMap B S hS f M).app d s)).trans
      (modulePullbackChartFMap_app_eq_unitSection B S hS f M d s)⟩

/-- **The inclusion of the local span of the chart sections into `f^*M` is an epimorphism.**  A
morphism killing that local span kills every chart section, hence has zero chartwise transpose,
hence is zero; and the sheaves of modules are preadditive. -/
theorem epi_localSpan_modulePullbackChart_ι :
    Epi (Stacks.SheafOfModules.localSpan ((modulePullback B S hS f).obj M)
      (moduleFMapSpanningSet B S hS f M ((modulePullback B S hS f).obj M)
        (modulePullbackChartFMap B S hS f M))).ι := by
  rw [Preadditive.epi_iff_cancel_zero]
  intro Z g hg
  refine injective_modulePullbackHomFMap B S hS f M Z ?_
  refine ModuleFMap.ext B S hS (funext fun d ↦ funext fun s ↦ ?_)
  rw [modulePullbackHomFMap_app B S hS f M Z g d s,
    modulePullbackHomFMap_app B S hS f M Z 0 d s]
  refine Eq.trans ?_ (congrArg (fun φ : (modulePullback B S hS f).obj M ⟶ Z ↦
    φ.val.app (op d.U) (modulePullbackUnitSection B S hS f M d s))
      (rfl : (0 : (modulePullback B S hS f).obj M ⟶ Z) = 0)).symm
  refine Eq.trans (Stacks.SheafOfModules.apply_eq_zero_of_mem_localSpan g hg
    (Stacks.SheafOfModules.mem_localSpan
      (modulePullbackUnitSection_mem_moduleFMapSpanningSet B S hS f M d s))) ?_
  exact (map_zero ((0 : (modulePullback B S hS f).obj M ⟶ Z).val.app (op d.U)).hom).symm

/-- **An inverse image of modules is locally generated by its chart sections.**  Every section of
`f^*M` over an étale scheme chart `W` of `X` restricts, along the members of a covering sieve of
`W`, into the `𝒪_X`-submodule spanned by the restrictions of the chart components of the unit.

No hypothesis on `M` is needed: `M` is not assumed quasi-coherent, nor of finite type, nor to
have local generating sections. -/
theorem spanSieve_modulePullbackChart_mem (W : SmallEtale B S hS X.1)
    (x : ((modulePullback B S hS f).obj M).val.obj (op W)) :
    Stacks.SheafOfModules.spanSieve ((modulePullback B S hS f).obj M)
        (moduleFMapSpanningSet B S hS f M ((modulePullback B S hS f).obj M)
          (modulePullbackChartFMap B S hS f M)) x ∈
      SmallEtale.topology B S hS X.1 W := by
  have h₁ : HasSheafify (smallEtaleRingedSite B S hS X.1 X.2).J AddCommGrpCat.{u} :=
    inferInstanceAs (HasSheafify (SmallEtale.topology B S hS X.1) AddCommGrpCat.{u})
  have h₂ : (smallEtaleRingedSite B S hS X.1 X.2).J.WEqualsLocallyBijective AddCommGrpCat.{u} :=
    inferInstanceAs ((SmallEtale.topology B S hS X.1).WEqualsLocallyBijective AddCommGrpCat.{u})
  have := epi_localSpan_modulePullbackChart_ι B S hS f M
  exact Stacks.SheafOfModules.spanSieve_mem_of_epi_ι x

end AlgebraicGeometry.Space

end
