/-- A chain of rewrites between composites of functions, stated abstractly so that it can be
instantiated at large terms without the elaborator comparing them. -/
theorem eq_of_chain {T₀ T₁ T₂ T₃ T₄ T₅ T₆ T₇ T₈ : Type*} (P₁ : T₁ → T₅) (M : T₂ → T₁)
    (q : T₂) (PG' : T₃ → T₂) (Ge : T₀ → T₃) (ν : T₀) (PG : T₄ → T₁) (Gm : T₃ → T₄)
    (Gem Gfc : T₀ → T₄) (Gc : T₆ → T₄) (Gf : T₀ → T₆) (PIg' : T₇ → T₅) (PIf : T₆ → T₇)
    (Gη : T₈ → T₇) (PIf₀ : T₀ → T₈) (pbm : T₈ → T₅)
    (e0 : q = PG' (Ge ν)) (e1 : PG (Gm (Ge ν)) = M (PG' (Ge ν)))
    (e2 : Gem ν = Gm (Ge ν)) (hu : Gem = Gfc) (e3 : Gfc ν = Gc (Gf ν))
    (e4 : P₁ (PG (Gc (Gf ν))) = PIg' (PIf (Gf ν))) (e5 : PIf (Gf ν) = Gη (PIf₀ ν))
    (e6 : pbm (PIf₀ ν) = PIg' (Gη (PIf₀ ν))) :
    P₁ (M q) = pbm (PIf₀ ν) := by
  rw [e0, ← e1, ← e2, hu, e3, e4, e5, e6]

/-- An abstract form of the span argument: a surjective chain of additive maps out of a module
generated by pure tensors, whose value on each pure tensor `b ⊗ ν` is a scalar multiple of an
element of a set, lands in the span of that set. -/
theorem mem_span_of_surjective_chain {R T P Q M X N K : Type*} [Semiring R] [AddCommMonoid M]
    [Module R M] [AddCommMonoid T] [AddCommMonoid P] [AddCommMonoid Q] [SMul K T] [SMul K P]
    [SMul K Q] (ρ : K → R)
    (tm : K → N → T) (hind : ∀ p : T → Prop, p 0 → (∀ b ν, p (tm b ν)) →
      (∀ x y, p x → p y → p (x + y)) → ∀ z, p z)
    (a : T →+ P) (m : P →+ Q) (c : Q →+ M) (ha : Function.Surjective a)
    (hm : Function.Surjective m) (hc : Function.Surjective c)
    (pb : N → P) (hatm : ∀ b ν, a (tm b ν) = b • pb ν)
    (hmsmul : ∀ (b : K) x, m (b • x) = b • m x) (hcsmul : ∀ (b : K) y, c (b • y) = ρ b • c y)
    (ps : X → M) (π₀ : N → X) (hcm : ∀ ν, c (m (pb ν)) = ps (π₀ ν)) (s : M) :
    s ∈ Submodule.span R (Set.range ps) := by
  obtain ⟨y, rfl⟩ := hc s
  obtain ⟨x, rfl⟩ := hm y
  obtain ⟨z, rfl⟩ := ha x
  refine hind (fun z => c (m (a z)) ∈ Submodule.span R (Set.range ps)) ?_ ?_ ?_ z
  · simp only [map_zero]
    exact Submodule.zero_mem _
  · intro b ν
    rw [hatm, hmsmul, hcsmul, hcm]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)
  · intro x y hx hy
    simp only [map_add]
    exact Submodule.add_mem _ hx hy

/-- `AlgebraicGeometry.Space.mem_span_of_surjective_chain` with the scalars of the source kept:
the conclusion is membership in the span over `K`, acting on `M` through `ρ`. -/
theorem mem_span_compHom_of_surjective_chain {R T P Q M X N K : Type*} [Semiring R] [Semiring K]
    [AddCommMonoid M] [Module R M] [AddCommMonoid T] [AddCommMonoid P] [AddCommMonoid Q]
    [SMul K T] [SMul K P] [SMul K Q] (ρ : K →+* R)
    (tm : K → N → T) (hind : ∀ p : T → Prop, p 0 → (∀ b ν, p (tm b ν)) →
      (∀ x y, p x → p y → p (x + y)) → ∀ z, p z)
    (a : T →+ P) (m : P →+ Q) (c : Q →+ M) (ha : Function.Surjective a)
    (hm : Function.Surjective m) (hc : Function.Surjective c)
    (pb : N → P) (hatm : ∀ b ν, a (tm b ν) = b • pb ν)
    (hmsmul : ∀ (b : K) x, m (b • x) = b • m x) (hcsmul : ∀ (b : K) y, c (b • y) = ρ b • c y)
    (ps : X → M) (π₀ : N → X) (hcm : ∀ ν, c (m (pb ν)) = ps (π₀ ν)) (s : M) :
    letI := Module.compHom M ρ
    s ∈ Submodule.span K (Set.range ps) := by
  let := Module.compHom M ρ
  obtain ⟨y, rfl⟩ := hc s
  obtain ⟨x, rfl⟩ := hm y
  obtain ⟨z, rfl⟩ := ha x
  refine hind (fun z => c (m (a z)) ∈ Submodule.span K (Set.range ps)) ?_ ?_ ?_ z
  · simp only [map_zero]
    exact Submodule.zero_mem _
  · intro b ν
    rw [hatm, hmsmul, hcsmul, hcm]
    exact Submodule.smul_mem _ b (Submodule.subset_span ⟨_, rfl⟩)
  · intro x y hx hy
    simp only [map_add]
    exact Submodule.add_mem _ hx hy

section Square

variable {X' X Y' Y : AlgebraicSpaces B S hS} {g' : X' ⟶ X} {f' : X' ⟶ Y'} {f : X ⟶ Y}
  {g : Y' ⟶ Y} (hsq : IsPullback g' f' f g) (F : Modules.{u, u} B S hS X.1 X.2)
  [hF : F.IsQuasicoherentOnSite]

omit hF in
/-- **The degree-zero base change map on global sections, at a pulled-back section.** For a
global section `ν` of `f_*𝓕` over `Y`, the base change map `g^*f_*𝓕 ⟶ f'_*(g')^*𝓕` applied to the
pullback of `ν` along `g`, read on `X'` through Stacks 0732 for `f'`, is the pullback along `g'` of
the section of `𝓕` that `ν` is by Stacks 0732 for `f`. -/
theorem globalSectionsPushforwardIsoSite_baseChange_pullbackMap
    (ν : (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)).obj
        ((modulePushforward B S hS f).obj F)) :
    ((globalSectionsPushforwardIsoSite B S hS f').hom.app ((modulePullback B S hS g').obj F)).hom
        (((globalSectionsFunctor.{u + 1, u, u, u}
          (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O)).map
          ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
            (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
            (modulePushforward B S hS f')
            (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F)).hom
          ((globalSectionsPullbackMap B S hS g ((modulePushforward B S hS f).obj F)).hom ν)) =
      (globalSectionsPullbackMap B S hS g' F).hom
        (((globalSectionsPushforwardIsoSite B S hS f).hom.app F).hom ν) := by
  have hu := unit_comp_map_mate_comp_map f g f' g' hsq.w F (𝟙 ((modulePullback B S hS g').obj F))
  simp only [CategoryTheory.Functor.map_id] at hu
  rw [modulePushforwardSquareComparisonIso_hom] at hu
  have e0 := globalSectionsPullbackMap_apply g ((modulePushforward B S hS f).obj F) ν
  have e1 := globalSectionsPushforwardIsoSite_hom_app_naturality_apply g
    (M := (modulePullback B S hS g).obj ((modulePushforward B S hS f).obj F))
    (N := (modulePushforward B S hS f').obj ((modulePullback B S hS g').obj F))
    ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F)
    (((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)).map
        ((modulePullbackAdjunction B S hS g).unit.app
          ((modulePushforward B S hS f).obj F))).hom ν)
  have e2 := globalSectionsFunctor_map_comp_apply
    ((modulePullbackAdjunction B S hS g).unit.app ((modulePushforward B S hS f).obj F))
    ((modulePushforward B S hS g).map
      ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
        (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
        (modulePushforward B S hS f')
        (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F)) ν
  have e3 := globalSectionsFunctor_map_comp_apply
    ((modulePushforward B S hS f).map ((modulePullbackAdjunction B S hS g').unit.app F))
    ((modulePushforwardSquareComparison B S hS g' f' f g hsq.w).app
      ((modulePullback B S hS g').obj F)) ν
  have e4 := globalSectionsPushforwardIsoSite_squareComparison f g f' g' hsq.w
    ((modulePullback B S hS g').obj F) (((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)).map
        ((modulePushforward B S hS f).map
          ((modulePullbackAdjunction B S hS g').unit.app F))).hom ν)
  have e5 := globalSectionsPushforwardIsoSite_hom_app_naturality_apply f
    (M := F) (N := (modulePushforward B S hS g').obj ((modulePullback B S hS g').obj F))
    ((modulePullbackAdjunction B S hS g').unit.app F) ν
  have e6 := globalSectionsPullbackMap_apply g' F
    (((globalSectionsPushforwardIsoSite B S hS f).hom.app F).hom ν)
  exact eq_of_chain _ _ _ _ _ ν _ _ _ _ _ _ _ _ _ _ _ e0 e1 e2
    (congrArg (fun m => ⇑(((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)).map m).hom)) hu) e3
          (by convert e4 using 4) e5 e6

variable (V₀ : SmallEtale B S hS Y.1) [IsIso V₀.obj.hom] [IsAffine (chartScheme V₀)]
  (V₀' : SmallEtale B S hS Y'.1) [IsIso V₀'.obj.hom] [IsAffine (chartScheme V₀')]

include hsq V₀ V₀' in
/-- **After a flat base change over affine bases, global sections are spanned by pullbacks.**
For `g` flat and `f` quasi-compact and quasi-separated, every global section of `(g')^*𝓕` on `X'`
lies in the `Γ(X', 𝒪)`-submodule spanned by the pullbacks along `g'` of the global sections of
`𝓕` on `X`. -/
theorem mem_span_range_pullbackSection (hg : IsFlat B S hS g.hom)
    (hqc : IsQuasiCompact B S hS f.hom) (hqs : IsQuasiSeparated B S hS f.hom)
    (s : (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O)).obj
          ((modulePullback B S hS g').obj F)) :
    s ∈ Submodule.span (RingCat.sectionsSubring
        (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O).obj)
      (Set.range (globalSectionsPullbackMap B S hS g' F).hom) := by
  have hN := isQuasicoherentOnSite_modulePushforward_of_qcqs B S hS f hqc hqs F
    hF
  have hV₀ : IsTerminal V₀ := isTerminal_of_isIso_chart B S hS Y V₀
  have hV₀' : IsTerminal V₀' := isTerminal_of_isIso_chart B S hS Y' V₀'
  have h₁ := bijective_globalSectionsPullbackBaseChange B S hS g
    ((modulePushforward B S hS f).obj F) (baseChartHomDiagram B S hS g V₀ V₀')
      hV₀' hV₀ hN ‹IsAffine (chartScheme V₀')› ‹IsAffine (chartScheme V₀)›
  have h₂ : IsIso ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F) := by
    have := isIso_moduleBaseChangeMap_app_of_isFlat hsq hqc hqs hg F hF
    rwa [moduleBaseChangeMap_eq_mate] at this
  have h₂' := (ConcreteCategory.isIso_iff_bijective _).mp (Functor.map_isIso
    (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O))
      ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F))
  have h₃ := (ConcreteCategory.isIso_iff_bijective _).mp
    (inferInstance : IsIso ((globalSectionsPushforwardIsoSite B S hS f').hom.app
        ((modulePullback B S hS g').obj F)))
  exact mem_span_of_surjective_chain
    (T := (ModuleCat.extendScalars.{u + 1, u + 1, u + 1} (globalSectionsRingHomSite B S hS g)).obj
        ((globalSectionsFunctor.{u + 1, u, u, u}
          (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)).obj
            ((modulePushforward B S hS f).obj F)))
    (M := (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O)).obj ((modulePullback B S hS g').obj F))
    (globalSectionsRingHomSite B S hS f')
    (fun b ν => b ⊗ₜ[RingCat.sectionsSubring
        (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O).obj,
          globalSectionsRingHomSite B S hS g] ν)
    (fun p h0 h1 h2 z => TensorProduct.induction_on z h0 h1 h2)
    (globalSectionsPullbackBaseChange B S hS g
      ((modulePushforward B S hS f).obj F)).hom.toAddMonoidHom
    ((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O)).map
      ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F)).hom.toAddMonoidHom
    ((globalSectionsPushforwardIsoSite B S hS f').hom.app ((modulePullback B S hS g').obj
        F)).hom.toAddMonoidHom
    h₁.2 h₂'.2 h₃.2
    (globalSectionsPullbackMap B S hS g ((modulePushforward B S hS f).obj F)).hom
    (fun b ν => globalSectionsPullbackBaseChange_tmul B S hS g _ b ν)
    (fun b x => LinearMap.map_smul ((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O)).map
      ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F)).hom b x)
    (fun b y => LinearMap.map_smul
      ((globalSectionsPushforwardIsoSite B S hS f').hom.app ((modulePullback B S hS g').obj F)).hom
          b y)
    (globalSectionsPullbackMap B S hS g' F).hom (((globalSectionsPushforwardIsoSite B S hS
        f).hom.app F).hom)
    (globalSectionsPushforwardIsoSite_baseChange_pullbackMap hsq F) s


include hsq V₀ V₀' in
/-- **After a flat base change over affine bases, global sections are spanned by pullbacks, with
coefficients from the base.**
For `g` flat and `f` quasi-compact and quasi-separated, every global section of `(g')^*𝓕` on `X'`
lies in the `Γ(X', 𝒪)`-submodule spanned by the pullbacks along `g'` of the global sections of
`𝓕` on `X`. -/
theorem mem_span_baseScalars_range_pullbackSection (hg : IsFlat B S hS g.hom)
    (hqc : IsQuasiCompact B S hS f.hom) (hqs : IsQuasiSeparated B S hS f.hom)
    (s : (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O)).obj
          ((modulePullback B S hS g').obj F)) :
    letI := Module.compHom ((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O)).obj
          ((modulePullback B S hS g').obj F)) (globalSectionsRingHomSite B S hS f')
    s ∈ Submodule.span (RingCat.sectionsSubring
        (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O).obj)
      (Set.range fun σ => @id ((globalSectionsFunctor.{u + 1, u, u, u}
          (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O)).obj
            ((modulePullback B S hS g').obj F)) ((globalSectionsPullbackMap B S hS g' F).hom σ)) :=
                by
  have hN := isQuasicoherentOnSite_modulePushforward_of_qcqs B S hS f hqc hqs F
    hF
  have hV₀ : IsTerminal V₀ := isTerminal_of_isIso_chart B S hS Y V₀
  have hV₀' : IsTerminal V₀' := isTerminal_of_isIso_chart B S hS Y' V₀'
  have h₁ := bijective_globalSectionsPullbackBaseChange B S hS g
    ((modulePushforward B S hS f).obj F) (baseChartHomDiagram B S hS g V₀ V₀')
      hV₀' hV₀ hN ‹IsAffine (chartScheme V₀')› ‹IsAffine (chartScheme V₀)›
  have h₂ : IsIso ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F) := by
    have := isIso_moduleBaseChangeMap_app_of_isFlat hsq hqc hqs hg F hF
    rwa [moduleBaseChangeMap_eq_mate] at this
  have h₂' := (ConcreteCategory.isIso_iff_bijective _).mp (Functor.map_isIso
    (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O))
      ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F))
  have h₃ := (ConcreteCategory.isIso_iff_bijective _).mp
    (inferInstance : IsIso ((globalSectionsPushforwardIsoSite B S hS f').hom.app
        ((modulePullback B S hS g').obj F)))
  exact mem_span_compHom_of_surjective_chain
    (T := (ModuleCat.extendScalars.{u + 1, u + 1, u + 1} (globalSectionsRingHomSite B S hS g)).obj
        ((globalSectionsFunctor.{u + 1, u, u, u}
          (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)).obj
            ((modulePushforward B S hS f).obj F)))
    (M := (globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O)).obj ((modulePullback B S hS g').obj F))
    (globalSectionsRingHomSite B S hS f')
    (fun b ν => b ⊗ₜ[RingCat.sectionsSubring
        (ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O).obj,
          globalSectionsRingHomSite B S hS g] ν)
    (fun p h0 h1 h2 z => TensorProduct.induction_on z h0 h1 h2)
    (globalSectionsPullbackBaseChange B S hS g
      ((modulePushforward B S hS f).obj F)).hom.toAddMonoidHom
    ((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS Y'.1 Y'.2).O)).map
      ((Stacks.Cohomology.BaseChange.mate (modulePullbackAdjunction B S hS g)
      (modulePullbackAdjunction B S hS g') (modulePushforward B S hS f)
      (modulePushforward B S hS f')
      (modulePushforwardSquareComparisonIso f g f' g' hsq.w)).app F)).hom.toAddMonoidHom
    ((globalSectionsPushforwardIsoSite B S hS f').hom.app ((modulePullback B S hS g').obj
        F)).hom.toAddMonoidHom
    h₁.2 h₂'.2 h₃.2
    (globalSectionsPullbackMap B S hS g ((modulePushforward B S hS f).obj F)).hom
    (fun b ν => globalSectionsPullbackBaseChange_tmul B S hS g _ b ν)
