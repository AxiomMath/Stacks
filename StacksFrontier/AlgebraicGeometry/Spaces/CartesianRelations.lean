open CategoryTheory CategoryTheory.Limits Opposite SheafOfModules
open scoped TensorProduct

universe s r v u m

namespace Stacks.Sites

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{r}}

/-- The comparison map attached to a family `ι : ∀ i : I, E ⟶ P` of morphisms of sheaves of
modules: the `R(X)`-linear map from the finitely supported `I`-indexed families of sections of
`E` over `X` to the sections of `P` over `X` which sends `Finsupp.single i x` to the image of
`x` under `ι i`.

For `E` the structure sheaf and `P` Mathlib's `SheafOfModules.free I` with its tautological
family this is `Stacks.Sites.freeSectionsMap`.  It is bijective over a quasi-compact object of
the site whenever the family is a colimiting cofan, by
`Stacks.Sites.bijective_familySectionsMap`, and not in general. -/
noncomputable def familySectionsMap {I : Type s} {E P : SheafOfModules.{s} R}
    (ι : ∀ _ : I, E ⟶ P) (X : Cᵒᵖ) :
    ModuleCat.of (R.obj.obj X) (I →₀ (E.val.obj X : Type s)) ⟶ P.val.obj X :=
  ModuleCat.ofHom (Finsupp.lsum ℕ (fun i => ((ι i).val.app X).hom))

/-- The comparison map of `Stacks.Sites.familySectionsMap` sends `Finsupp.single i x` to the
image of `x` under the `i`-th member of the family. -/
theorem familySectionsMap_single {I : Type s} {E P : SheafOfModules.{s} R}
    (ι : ∀ _ : I, E ⟶ P) (X : Cᵒᵖ) (i : I) (x : E.val.obj X) :
    (familySectionsMap ι X).hom (Finsupp.single i x) = ((ι i).val.app X).hom x :=
  Finsupp.lsum_single ℕ _ i x

/-- The comparison map of `Stacks.Sites.familySectionsMap` is the finite sum of the images of the
members of the family. -/
theorem familySectionsMap_apply {I : Type s} {E P : SheafOfModules.{s} R}
    (ι : ∀ _ : I, E ⟶ P) (X : Cᵒᵖ) (t : I →₀ (E.val.obj X : Type s)) :
    (familySectionsMap ι X).hom t = t.sum fun i x => ((ι i).val.app X).hom x :=
  Finsupp.lsum_apply ℕ _ t

/-- **The sections over a quasi-compact object of a coproduct of copies of a sheaf of modules
are the finitely supported families of sections of that sheaf.**

This is Stacks 0935(2) — `Stacks.Sites.sheafOfModules_sections_preserves_coproducts` — read on
an abstract colimiting cofan rather than on Mathlib's `SheafOfModules.free`, so it applies at
any module universe, in particular to a coproduct of copies of the universe-lifted structure
sheaf `SheafOfModules.liftUnit` in which a global presentation is taken.  Quasi-compactness is
what makes it true: a coproduct of sheaves is the sheafification of the objectwise direct sum,
so a section of the coproduct is only *locally* a finite sum of sections of the summands.

The inverse is the morphism out of the colimiting cofan of abelian groups whose `i`-th leg is
`Finsupp.singleAddHom i`; bijectivity may be checked after forgetting the module structure
because the comparison map is `R(X)`-linear by construction. -/
theorem bijective_familySectionsMap {I : Type s} {E P : SheafOfModules.{s} R}
    (ι : ∀ _ : I, E ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (W : C) (hW : J.IsQuasiCompactObject W) :
    Function.Bijective (familySectionsMap ι (op W)).hom := by
  classical
  have hpres := sheafOfModules_sections_preserves_coproducts.{s, s} J R W hW I
  set G := SheafOfModules.toSheaf.{s} R ⋙ (sheafSections J AddCommGrpCat.{s}).obj (op W)
  have hcof : IsColimit (Cofan.mk (G.obj P) (fun i => G.map (ι i))) :=
    Cofan.isColimitMapCoconeEquiv G _ (Cofan.mk P ι) (isColimitOfPreserves G hP)
  let T : AddCommGrpCat.{s} := AddCommGrpCat.of (I →₀ (E.val.obj (op W) : Type s))
  let ψ : G.obj P ⟶ T := Cofan.IsColimit.desc hcof
    (fun i => AddCommGrpCat.ofHom (Finsupp.singleAddHom (M := (E.val.obj (op W) : Type s)) i))
  let φa : T ⟶ G.obj P :=
    AddCommGrpCat.ofHom ((familySectionsMap ι (op W)).hom.toAddMonoidHom)
  have hfac (i : I) : G.map (ι i) ≫ ψ =
      AddCommGrpCat.ofHom (Finsupp.singleAddHom (M := (E.val.obj (op W) : Type s)) i) :=
    Cofan.IsColimit.fac hcof _ i
  have key (i : I) (x : (E.val.obj (op W) : Type s)) :
      (G.map (ι i)).hom x = (familySectionsMap ι (op W)).hom (Finsupp.single i x) := by
    rw [familySectionsMap_single]
    rfl
  have key2 (i : I) :
      AddCommGrpCat.ofHom (Finsupp.singleAddHom (M := (E.val.obj (op W) : Type s)) i) ≫ φa
        = G.map (ι i) := by
    refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun x => ?_)
    rw [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
      Finsupp.singleAddHom_apply]
    exact (key i x).symm
  have hfac' (i : I) (x : (E.val.obj (op W) : Type s)) :
      ψ.hom ((G.map (ι i)).hom x) = Finsupp.single i x :=
    DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom (hfac i)) x
  have h1 : ψ ≫ φa = 𝟙 _ := by
    refine Cofan.IsColimit.hom_ext hcof _ _ (fun i => ?_)
    have hi : (Cofan.mk (G.obj P) (fun i => G.map (ι i))).inj i = G.map (ι i) := rfl
    rw [hi, ← Category.assoc, hfac i]
    exact (key2 i).trans (Category.comp_id _).symm
  have h2 : φa ≫ ψ = 𝟙 T := by
    apply AddCommGrpCat.hom_ext
    apply Finsupp.addHom_ext
    intro i x
    have e1 : (AddCommGrpCat.Hom.hom φa) (Finsupp.single i x)
        = (G.map (ι i)).hom x := (key i x).symm
    show ψ.hom ((AddCommGrpCat.Hom.hom φa) (Finsupp.single i x)) = _
    rw [e1, hfac' i x]
    rfl
  exact Function.bijective_iff_has_inverse.mpr
    ⟨ψ.hom, DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom h2),
      DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom h1)⟩

end Stacks.Sites

namespace AlgebraicGeometry.Space

/-! ### The relations among a generating family base change along a flat ring map -/

/-- **The relations among a generating family base change along a flat ring map.**

Let `A'` be a flat `A`-algebra, let `φ₀ : (I →₀ A) ⟶ M₀` and `φ₁ : (I →₀ A') ⟶ M₁` be two maps
out of the finitely supported families on one index type, and let `c` be an injective additive
map from the base change `A' ⊗_A M₀` to `M₁` making the square

`(I →₀ A') ⟶ M₁`,  `A' ⊗_A (I →₀ A) ⟶ A' ⊗_A M₀`

commute, in the form `hsq` below.  Then the relations among the images of the generators in
`M₁` — the kernel of `φ₁` — are generated, as an `A'`-module, by the restrictions of the
relations among the generators of `M₀`.

This is the commutative-algebra content of the relations half of Descent,
Proposition 03DX(2): the generators of a cartesian module over a larger affine chart generate
it over a smaller one, and their relations over the smaller chart are generated by their
relations over the larger one, because the restriction map is flat.

Flatness enters once, through `Module.Flat.lTensor_exact` applied to the tautological exact
sequence `ker φ₀ ⟶ (I →₀ A) ⟶ M₀`; the identification of `A' ⊗_A (I →₀ A)` with `I →₀ A'` is
Mathlib's `TensorProduct.finsuppScalarRight`.  It is the companion of
`AlgebraicGeometry.Space.bijective_baseChange_of_exact`, which runs the same argument for the
kernel of a map rather than for the span of its relations and uses, in addition, flatness in
its injectivity form. -/
theorem ker_eq_span_image_mapRange_of_flat {A A' : Type*} [instA : CommRing A]
    [instA' : CommRing A'] [instAlg : Algebra A A'] [instFlat : Module.Flat A A']
    {I : Type*} {M₀ : Type*} [AddCommGroup M₀] [Module A M₀]
    {M₁ : Type*} [AddCommGroup M₁] [Module A' M₁]
    (φ₀ : (I →₀ A) →ₗ[A] M₀) (φ₁ : (I →₀ A') →ₗ[A'] M₁)
    (c : TensorProduct A A' M₀ →+ M₁) (hc : Function.Injective c)
    (hsq : ∀ (b : A') (p : I →₀ A),
      φ₁ (b • Finsupp.mapRange (algebraMap A A') (map_zero _) p) =
        c (TensorProduct.tmul A b (φ₀ p))) :
    LinearMap.ker φ₁ = Submodule.span A'
      ((fun p : I →₀ A => Finsupp.mapRange (algebraMap A A') (map_zero _) p) ''
        (LinearMap.ker φ₀ : Set (I →₀ A))) := by
  classical
  refine le_antisymm (fun y hy => ?_) (Submodule.span_le.2 ?_)
  swap
  · rintro w ⟨p, hp, rfl⟩
    refine LinearMap.mem_ker.2 ?_
    refine Eq.trans (congrArg φ₁ (one_smul A'
      (Finsupp.mapRange (algebraMap A A') (map_zero _) p)).symm) ?_
    refine Eq.trans (hsq 1 p) ?_
    refine Eq.trans (congrArg (fun w : M₀ => c (TensorProduct.tmul A (1 : A') w))
      (LinearMap.mem_ker.1 hp)) ?_
    rw [TensorProduct.tmul_zero, map_zero]
  replace hy : φ₁ y = 0 := LinearMap.mem_ker.1 hy
  set e := TensorProduct.finsuppScalarRight A A' A' I with he
  have htmul : ∀ (b : A') (p : I →₀ A),
      e (TensorProduct.tmul A b p) = b • Finsupp.mapRange (algebraMap A A') (map_zero _) p := by
    intro b p
    refine Finsupp.ext fun i => ?_
    rw [he, TensorProduct.finsuppScalarRight_apply_tmul_apply]
    show p i • b = b * algebraMap A A' (p i)
    rw [Algebra.smul_def]
    exact mul_comm _ _
  have hkey : ∀ t : TensorProduct A A' (I →₀ A),
      φ₁ (e t) = c (LinearMap.lTensor A' φ₀ t) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero, map_zero]
    | tmul b p => rw [htmul, hsq, LinearMap.lTensor_tmul]
    | add t t' ht ht' => rw [map_add, map_add, ht, ht', map_add, map_add]
  have ht0 : LinearMap.lTensor A' φ₀ (e.symm y) = 0 := by
    refine hc ?_
    rw [← hkey, e.apply_symm_apply, hy, map_zero]
  have hex0 : Function.Exact (LinearMap.ker φ₀).subtype φ₀ :=
    LinearMap.exact_subtype_ker_map φ₀
  have hex := Module.Flat.lTensor_exact (R := A) (M := A')
    (N := (LinearMap.ker φ₀)) (N' := (I →₀ A)) (N'' := M₀) hex0 (e.symm y)
  obtain ⟨z, hz⟩ := hex.mp ht0
  have hgoal : ∀ z : TensorProduct A A' (LinearMap.ker φ₀),
      e (LinearMap.lTensor A' (LinearMap.ker φ₀).subtype z) ∈ Submodule.span A'
        ((fun p : I →₀ A => Finsupp.mapRange (algebraMap A A') (map_zero _) p) ''
          (LinearMap.ker φ₀ : Set (I →₀ A))) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]; exact Submodule.zero_mem _
    | tmul b p =>
      rw [LinearMap.lTensor_tmul, htmul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨p.1, p.2, rfl⟩)
    | add z z' hz hz' => rw [map_add, map_add]; exact Submodule.add_mem _ hz hz'
  have hfin := hgoal z
  rw [hz, e.apply_symm_apply] at hfin
  exact hfin

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

section Relations

variable (V : (smallEtaleRingedSite B S hS F hF).C)

/-- **A regular function on a chart `V`, read as a global section of the structure sheaf of the
slice of the small étale site at `V`.**

The slice at `V` has `CategoryTheory.Over.mk (𝟙 V)` as a terminal object, so a global section of
the restriction of a sheaf is the same thing as a section over `V`; this is
`Stacks.SheafOfModules.sectionsOverEquivFreeUniverse` applied to the structure sheaf, which is
legitimate because the restriction of `SheafOfModules.unit` to a slice *is* the unit module of
the restricted sheaf of rings, on the nose. -/
noncomputable def chartUnitSection (a : chartRing B S hS F hF V) :
    (_root_.SheafOfModules.unit
      (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V)).sections :=
  (Stacks.SheafOfModules.sectionsOverEquivFreeUniverse
    (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)))
    V).symm a

/-- The component of `AlgebraicGeometry.Space.chartUnitSection` at an object `Z` of the slice is
the restriction of the function along the structure morphism of `Z`.  It holds by `rfl`, and it is
what drives every computation with the relations morphism below. -/
theorem chartUnitSection_eval (a : chartRing B S hS F hF V) (Z : Over V) :
    (chartUnitSection V a).eval (op Z) = chartRestrict (hF := hF) Z.hom a := rfl

/-- **Evaluation of a finitely supported family of regular functions at the tautological
generating family of `G` over the chart `V`**: the `𝒪_F(V)`-linear map sending a family
`(c_x)_{x ∈ G(V)}` to `∑ c_x · x`.

The index type is `AlgebraicGeometry.Space.chartGeneratorsIndex`, the universe lift of `G(V)`
in which `SheafOfModules.HasGlobalPresentation` indexes its coproducts, and `i.down` is the
section of `G` over `V` that the index `i` names.  It is Mathlib's
`Finsupp.linearCombination`, so its API — in particular `Finsupp.linearCombination_apply` — is
available; the kernel of this map is the module of relations among the generators. -/
noncomputable def chartGeneratorsCombination (G : Modules.{u, m} B S hS F hF) :
    (chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) →ₗ[chartRing B S hS F hF V]
      (G.val.obj (op V) : Type m) :=
  Finsupp.linearCombination (chartRing B S hS F hF V)
    (fun i : chartGeneratorsIndex V G => (i.down : (G.val.obj (op V) : Type m)))

/-- `AlgebraicGeometry.Space.chartGeneratorsCombination` is the finite sum of the coefficients
acting on the generators.  This is `Finsupp.linearCombination_apply`. -/
theorem chartGeneratorsCombination_apply (G : Modules.{u, m} B S hS F hF)
    (p : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) :
    chartGeneratorsCombination V G p =
      ∑ i ∈ p.support, p i • (i.down : (G.val.obj (op V) : Type m)) :=
  Finsupp.linearCombination_apply _ _

/-- **The index type of the canonical relations among the generators of `G` over the chart
`V`**: the kernel of `AlgebraicGeometry.Space.chartGeneratorsCombination`, that is, the module of
finitely supported families of regular functions on `V` which annihilate the tautological
generating family.

It is a subtype of a module of finitely supported families, not an abstract index type with a
chosen family, and that is deliberate: the relations morphism below is indexed by *all* the
relations, so the obligation "the chosen family generates the relations" is discharged by
definition.  Its universe is `max (u + 1) m`, as `AlgebraicGeometry.Space.chartGeneratorsIndex`
is, so it fits the index slot of `SheafOfModules.HasGlobalPresentation` at the small étale site. -/
abbrev chartRelationsIndex (G : Modules.{u, m} B S hS F hF) : Type (max (u + 1) m) :=
  ↥(LinearMap.ker (chartGeneratorsCombination V G))

/-- Restriction to a smaller chart carries a linear combination of the tautological generators
to the combination of the restricted generators with the restricted coefficients.  Restriction of
sections is only semilinear, so this is `map_sum` together with the scalar law
`AlgebraicGeometry.Space.chartSectionsModule_smul`. -/
theorem chartRestrictLinear_chartGeneratorsCombination (G : Modules.{u, m} B S hS F hF)
    (Z : Over V) (p : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) :
    chartRestrictLinear G Z.hom (chartGeneratorsCombination V G p) =
      ∑ i ∈ p.support, chartRestrict (hF := hF) Z.hom (p i) •
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m)) := by
  let _ := chartSectionsModule G Z.hom
  rw [chartGeneratorsCombination_apply, map_sum]
  exact Finset.sum_congr rfl fun i _ =>
    (chartRestrictLinear G Z.hom).map_smul (p i) (i.down : (G.val.obj (op V) : Type m))

variable
  [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
  [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
    AddCommGrpCat.{max (u + 1) m}]

/-- The coproduct injections of `AlgebraicGeometry.Space.chartGeneratorsSource`, named so that
the statements below fit on a line.  It is an `abbrev`, hence reducible, so that it is
interchangeable with the spelled-out `CategoryTheory.Limits.Sigma.ι` that
`AlgebraicGeometry.Space.chartGenerators` is defined by. -/
noncomputable abbrev chartGeneratorsInj (G : Modules.{u, m} B S hS F hF) :
    ∀ _ : chartGeneratorsIndex V G,
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V) ⟶
      chartGeneratorsSource V G :=
  Sigma.ι (fun _ : chartGeneratorsIndex V G =>
    _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
      (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))

/-- **The sections of `AlgebraicGeometry.Space.chartGeneratorsSource` over an affine object of
the slice are the finitely supported families of regular functions on it.**

This closes, for the coproduct a global presentation actually takes, the computation that
`Stacks.Sites.bijective_freeSectionsMap` makes for Mathlib's `SheafOfModules.free`: the input is
`Stacks.Sites.bijective_familySectionsMap`, and the quasi-compactness it needs is
`AlgebraicGeometry.Space.isQuasiCompactObject_over_of_isAffine`.  Affineness of the object is not
a convenience; see the implementation notes of
`StacksFrontier.AlgebraicGeometry.Spaces.FreeModuleSections`. -/
theorem bijective_chartGeneratorsSectionsMap (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left)) :
    Function.Bijective
      (Stacks.Sites.familySectionsMap (chartGeneratorsInj V G) (op Z)).hom :=
  Stacks.Sites.bijective_familySectionsMap _
    (coproductIsCoproduct (fun _ : chartGeneratorsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V)))
    Z (isQuasiCompactObject_over_of_isAffine V Z hZ)

/-- The generating family `AlgebraicGeometry.Space.chartGenerators` sends the image of a lifted
regular function under the `i`-th coproduct injection to that function acting on the restriction
of the `i`-th generator.  This is `AlgebraicGeometry.Space.iota_comp_chartGenerators` read on
sections. -/
theorem chartGenerators_val_app_inj (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (i : chartGeneratorsIndex V G)
    (x : (_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
      (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z)) :
    (chartGenerators V G).val.app (op Z) ((chartGeneratorsInj V G i).val.app (op Z) x) =
      ULift.up ((ULift.down x : chartRing B S hS F hF Z.left) •
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) := by
  rw [← _root_.SheafOfModules.comp_val_app_apply, iota_comp_chartGenerators,
    _root_.SheafOfModules.liftSectionHomPresentation_val_app_apply]
  rfl

/-- The generating family sends a finite sum of coproduct injections of lifted coefficients to
the corresponding combination of the restricted generators. -/
private theorem chartGenerators_val_app_sum (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (s : Finset (chartGeneratorsIndex V G))
    (x : chartGeneratorsIndex V G →
      (_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z)) :
    (chartGenerators V G).val.app (op Z)
        (∑ i ∈ s, (chartGeneratorsInj V G i).val.app (op Z) (x i)) =
      ULift.up (∑ i ∈ s, (ULift.down (x i) : chartRing B S hS F hF Z.left) •
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) := by
  rw [map_sum, _root_.SheafOfModules.uliftForPresentation_up_sum.{u + 1, u, u, m, u + 1}]
  exact Finset.sum_congr rfl fun i _ => chartGenerators_val_app_inj V G Z i (x i)

/-- The generating family, evaluated on a finitely supported family of coefficients through
`Stacks.Sites.familySectionsMap`, is the corresponding combination of the restricted
generators. -/
theorem chartGenerators_val_app_familySectionsMap (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (t : chartGeneratorsIndex V G →₀
      ((_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z) :
          Type (max (u + 1) m))) :
    (chartGenerators V G).val.app (op Z)
        ((Stacks.Sites.familySectionsMap (chartGeneratorsInj V G) (op Z)).hom t) =
      ULift.up (t.sum fun i x => (ULift.down x : chartRing B S hS F hF Z.left) •
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) := by
  rw [Stacks.Sites.familySectionsMap_apply, Finsupp.sum, Finsupp.sum]
  exact chartGenerators_val_app_sum V G Z _ t

/-- The source of the canonical relations morphism: the coproduct, indexed by the relations
among the generators of `G` over `V`, of copies of the universe-lifted structure sheaf of the
slice at `V`.  This is the second coproduct of a global presentation. -/
noncomputable abbrev chartRelationsSource (G : Modules.{u, m} B S hS F hF) :
    SheafOfModules.{max (u + 1) m}
      (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V) :=
  ∐ (fun _ : chartRelationsIndex V G =>
    _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
      (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))

/-- The leg of the relations morphism at a finitely supported family `k` of regular functions on
`V`: the finite sum, over the support of `k`, of multiplication by `k i` followed by the `i`-th
coproduct injection.

This is the arbitrary-index analogue of `SheafOfModules.powRel`, which does the same for a
`Fin p`-indexed family of relations among `Fin n` generators using biproducts.  It is defined for
*every* coefficient family, not only for the relations, because that is what makes the
computation of its sections independent of the kernel condition. -/
noncomputable def chartRelationsLeg (G : Modules.{u, m} B S hS F hF)
    (k : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) :
    _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V) ⟶
      chartGeneratorsSource V G :=
  ∑ i ∈ k.support,
    _root_.SheafOfModules.liftSectionHomPresentation.{u + 1, u, u, u, m}
      (chartUnitSection V (k i)) ≫ chartGeneratorsInj V G i

/-- **The canonical relations morphism**: the morphism out of the coproduct indexed by the
relations among the generators of `G` over `V` whose leg at a relation `k` is
`AlgebraicGeometry.Space.chartRelationsLeg` of `k`.

Together with `AlgebraicGeometry.Space.chartGenerators` this is the two-term complex a global
presentation of the restriction of `G` to the slice at an affine chart is built from; that it
composes to zero is `AlgebraicGeometry.Space.chartRelations_comp_chartGenerators` and that it
exhausts the relations is `AlgebraicGeometry.Space.epi_kernelLift_chartRelations`. -/
noncomputable def chartRelations (G : Modules.{u, m} B S hS F hF) :
    chartRelationsSource V G ⟶ chartGeneratorsSource V G :=
  Cofan.IsColimit.desc
    (coproductIsCoproduct (fun _ : chartRelationsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V)))
    (fun k => chartRelationsLeg V G k.1)

/-- The leg of `AlgebraicGeometry.Space.chartRelations` at a relation is
`AlgebraicGeometry.Space.chartRelationsLeg` of that relation. -/
theorem inj_comp_chartRelations (G : Modules.{u, m} B S hS F hF)
    (k : chartRelationsIndex V G) :
    Sigma.ι (fun _ : chartRelationsIndex V G =>
        _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over V)) k ≫
      chartRelations V G = chartRelationsLeg V G k.1 :=
  Cofan.IsColimit.fac
    (coproductIsCoproduct (fun _ : chartRelationsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V))) _ k

/-- A relation leg, read on the sections over an object `Z` of the slice: the image of a lifted
regular function `c` on `Z` is the family of coefficients `c · (k i)|_Z`, placed in the coproduct
by the injections.  This is `SheafOfModules.liftSectionHomPresentation_val_app_apply` together with
`AlgebraicGeometry.Space.chartUnitSection_eval`. -/
theorem chartRelationsLeg_val_app (G : Modules.{u, m} B S hS F hF)
    (k : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) (Z : Over V)
    (c : (_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
      (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z)) :
    (chartRelationsLeg V G k).val.app (op Z) c =
      k.sum fun i a => (chartGeneratorsInj V G i).val.app (op Z)
        (ULift.up ((ULift.down c : chartRing B S hS F hF Z.left) *
          chartRestrict (hF := hF) Z.hom a)) := by
  rw [chartRelationsLeg, _root_.SheafOfModules.sum_val_app_apply, Finsupp.sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [_root_.SheafOfModules.comp_val_app_apply,
    _root_.SheafOfModules.liftSectionHomPresentation_val_app_apply]
  rfl

end Relations

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Core

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
variable (V : (smallEtaleRingedSite B S hS F hF).C)

variable
  [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
  [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
    AddCommGrpCat.{max (u + 1) m}]

/-- **A relation leg composed with the generating family is zero.**  For a coefficient family
`k` annihilating the tautological generators, the morphism
`AlgebraicGeometry.Space.chartRelationsLeg` of `k` followed by
`AlgebraicGeometry.Space.chartGenerators` is the zero morphism.

The computation is on sections over an arbitrary object of the slice — no affineness is used —
and it reduces, through
`AlgebraicGeometry.Space.chartRestrictLinear_chartGeneratorsCombination`, to the restriction of
the vanishing combination. -/
theorem chartRelationsLeg_comp_chartGenerators (G : Modules.{u, m} B S hS F hF)
    (k : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V)
    (hk : chartGeneratorsCombination V G k = 0) :
    chartRelationsLeg V G k ≫ chartGenerators V G = 0 := by
  classical
  ext X z
  obtain ⟨Z⟩ := X
  rw [_root_.SheafOfModules.zero_val_app_apply,
    _root_.SheafOfModules.comp_val_app_apply, chartRelationsLeg_val_app, Finsupp.sum]
  refine (chartGenerators_val_app_sum V G Z k.support fun i =>
    ULift.up ((ULift.down z : chartRing B S hS F hF Z.left) *
      chartRestrict (hF := hF) Z.hom (k i))).trans ?_
  refine congrArg ULift.up ?_
  have hzero : (∑ i ∈ k.support, chartRestrict (hF := hF) Z.hom (k i) •
      chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) = 0 :=
    (chartRestrictLinear_chartGeneratorsCombination V G Z k).symm.trans
      ((congrArg (fun w : (G.val.obj (op V) : Type m) => chartRestrictLinear G Z.hom w)
        hk).trans (map_zero (chartRestrictLinear G Z.hom)))
  simp only [mul_smul, ← Finset.smul_sum, hzero, smul_zero]
  rfl

/-- **The two morphisms of the canonical presentation compose to zero.**  This is the `hab`
clause of `hrel` in
`AlgebraicGeometry.Space.isQuasicoherentOnSite_of_isCartesianOnAffineCharts_of_rel`, and it
holds over an arbitrary chart: no affineness and no cartesian hypothesis is used. -/
theorem chartRelations_comp_chartGenerators (G : Modules.{u, m} B S hS F hF) :
    chartRelations V G ≫ chartGenerators V G = 0 := by
  refine Cofan.IsColimit.hom_ext
    (coproductIsCoproduct (fun _ : chartRelationsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V))) _ _ (fun k => ?_)
  rw [comp_zero, ← Category.assoc]
  exact (congrArg (· ≫ chartGenerators V G) (inj_comp_chartRelations V G k)).trans
    (chartRelationsLeg_comp_chartGenerators V G k.1 k.2)

end Core

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Core2

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
variable (V : (smallEtaleRingedSite B S hS F hF).C)

/-- **The commuting square of the base change comparison, in the shape
`AlgebraicGeometry.Space.ker_eq_span_image_mapRange_of_flat` consumes.**

Scaling the restriction of a coefficient family and evaluating at the restricted generators is
the base change comparison `AlgebraicGeometry.Space.sectionsBaseChange` of the combination.  Both
sides are the finite sum `∑ b · (q i)|_Z · x_i|_Z`; the left-hand side needs
`Finsupp.sum_of_support_subset` because scaling and restricting can shrink the support, and the
right-hand side is `AlgebraicGeometry.Space.chartBaseChange_tmul` followed by
`AlgebraicGeometry.Space.chartRestrictLinear_chartGeneratorsCombination`.

No affineness and no cartesian hypothesis is used: this is the compatibility of the comparison
with the generating family, not its bijectivity. -/
theorem chartGeneratorsCombination_baseChange_square (G : Modules.{u, m} B S hS F hF)
    (Z : Over V) (b : chartRing B S hS F hF Z.left)
    (q : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) :
    letI := chartRing_commRing B S hS F hF V
    letI := chartRing_commRing B S hS F hF Z.left
    letI := chartAlgebra (hF := hF) Z.hom
    letI := chartSectionsModule G Z.hom
    Finsupp.linearCombination (chartRing B S hS F hF Z.left)
        (fun i : chartGeneratorsIndex V G =>
          chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m)))
        (b • Finsupp.mapRange
          (algebraMap (chartRing B S hS F hF V) (chartRing B S hS F hF Z.left))
          (map_zero _) q) =
      sectionsBaseChange G Z.hom
        (TensorProduct.tmul _ b (chartGeneratorsCombination V G q)) := by
  classical
  let _ := chartRing_commRing B S hS F hF V
  let _ := chartRing_commRing B S hS F hF Z.left
  let _ := chartAlgebra (hF := hF) Z.hom
  let _ := chartSectionsModule G Z.hom
  have _ := chartSections_isScalarTower G Z.hom
  have hsub : (b • Finsupp.mapRange
      (algebraMap (chartRing B S hS F hF V) (chartRing B S hS F hF Z.left))
      (map_zero (algebraMap (chartRing B S hS F hF V)
        (chartRing B S hS F hF Z.left))) q).support ⊆ q.support :=
    (Finsupp.support_smul).trans Finsupp.support_mapRange
  have hL := Finsupp.sum_of_support_subset _ hsub
    (fun (i : chartGeneratorsIndex V G) (a : chartRing B S hS F hF Z.left) =>
      a • chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m)))
    (fun i _ => zero_smul _ _)
  refine Eq.trans (Finsupp.linearCombination_apply _ _) (Eq.trans hL ?_)
  refine Eq.trans (Finset.sum_congr rfl fun i _ => mul_smul b
    (algebraMap (chartRing B S hS F hF V) (chartRing B S hS F hF Z.left) (q i))
    (chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m)))) ?_
  refine Eq.trans (Finset.smul_sum (r := b)
    (f := fun i : chartGeneratorsIndex V G =>
      algebraMap (chartRing B S hS F hF V) (chartRing B S hS F hF Z.left) (q i) •
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m)))
    (s := q.support)).symm ?_
  refine Eq.trans (congrArg (fun w : (G.val.obj (op Z.left) : Type m) => b • w)
    (chartRestrictLinear_chartGeneratorsCombination V G Z q).symm) ?_
  exact (chartBaseChange_tmul G Z.hom b (chartGeneratorsCombination V G q)).symm

end Core2

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Core3

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
variable (V : (smallEtaleRingedSite B S hS F hF).C)

/-- **The relations among the restricted generators over a smaller affine chart are generated by
the restrictions of the relations over the larger one.**

This is `AlgebraicGeometry.Space.ker_eq_span_image_mapRange_of_flat` applied at the restriction
map of regular functions between two affine étale charts: its flatness is
`AlgebraicGeometry.Space.moduleFlat_chartRing_of_isAffine`, the injectivity of the comparison is
the cartesian hypothesis `hG`, and the commuting square is
`AlgebraicGeometry.Space.chartGeneratorsCombination_baseChange_square`.  It is the one place in
this file where the cartesian hypothesis and affineness of the charts are used.

The instances of the flat base change lemma are supplied by name rather than by instance search:
the commutative ring structure of `AlgebraicGeometry.Space.chartRing_commRing` and the algebra
structure of `AlgebraicGeometry.Space.chartAlgebra` are stated for an object of
`AlgebraicGeometry.Space.SmallEtale`, and instance search does not unfold the projection `.C` of
`AlgebraicGeometry.Space.smallEtaleRingedSite` to find them; see the implementation notes. -/
theorem mem_span_image_mapRange_ker_chartGeneratorsCombination
    (G : Modules.{u, m} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left))
    (y : chartGeneratorsIndex V G →₀ chartRing B S hS F hF Z.left)
    (hy : Finsupp.linearCombination (chartRing B S hS F hF Z.left)
      (fun i : chartGeneratorsIndex V G =>
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) y = 0) :
    y ∈ Submodule.span (chartRing B S hS F hF Z.left)
      ((fun q : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V =>
          Finsupp.mapRange (chartRestrict (hF := hF) Z.hom)
            (map_zero (chartRestrict (hF := hF) Z.hom)) q) ''
        (LinearMap.ker (chartGeneratorsCombination V G) :
          Set (chartGeneratorsIndex V G →₀ chartRing B S hS F hF V))) := by
  have hker := ker_eq_span_image_mapRange_of_flat
    (instA := chartRing_commRing B S hS F hF V)
    (instA' := chartRing_commRing B S hS F hF Z.left)
    (instAlg := chartAlgebra (hF := hF) Z.hom)
    (instFlat := moduleFlat_chartRing_of_isAffine (hF := hF) Z.hom hV hZ)
    (chartGeneratorsCombination V G)
    (Finsupp.linearCombination (chartRing B S hS F hF Z.left)
      (fun i : chartGeneratorsIndex V G =>
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))))
    (sectionsBaseChange G Z.hom).toAddMonoidHom (hG V Z.left hV hZ Z.hom).1
    (fun b q => chartGeneratorsCombination_baseChange_square V G Z b q)
  exact hker ▸ LinearMap.mem_ker.2 hy

end Core3

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Core4

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
variable (V : (smallEtaleRingedSite B S hS F hF).C)

variable
  [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
  [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
    AddCommGrpCat.{max (u + 1) m}]

/-- **The comparison from the finitely supported families of regular functions on an object `Z`
of the slice to the sections of the generating coproduct over `Z`**, as a linear map: the family
`(a_i)` goes to `∑ a_i · ι_i(1)`.

It is `AlgebraicGeometry.Space.chartGeneratorsInj` read through
`Finsupp.linearCombination`, so it is linear by construction — which is what makes the span
induction below free of hand-rolled additivity and homogeneity lemmas.  It agrees with
`Stacks.Sites.familySectionsMap` through the universe lift of the coefficients, by
`AlgebraicGeometry.Space.chartGeneratorsCoeffMap_mapRange_down`. -/
noncomputable def chartGeneratorsCoeffMap (G : Modules.{u, m} B S hS F hF) (Z : Over V) :
    (chartGeneratorsIndex V G →₀
        ((((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
          Type u)) →ₗ[((((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over
        V).obj.obj (op Z) : Type u)]
      ((chartGeneratorsSource V G).val.obj (op Z) : Type (max (u + 1) m)) :=
  Finsupp.linearCombination _ (fun i : chartGeneratorsIndex V G =>
    (chartGeneratorsInj V G i).val.app (op Z) (ULift.up
      (1 : ((((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
        Type u))))

/-- A regular function acting on the image of the lift of `1` under a coproduct injection is the
image of the lift of that function. -/
theorem smul_chartGeneratorsInj_one (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (i : chartGeneratorsIndex V G)
    (a : ((((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
      Type u)) :
    a • ((chartGeneratorsInj V G i).val.app (op Z) (ULift.up
        (1 : ((((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over
          V).obj.obj (op Z) : Type u)))) =
      (chartGeneratorsInj V G i).val.app (op Z) (ULift.up a) :=
  (map_smul ((chartGeneratorsInj V G i).val.app (op Z)).hom a _).symm.trans
    (congrArg (fun z => (chartGeneratorsInj V G i).val.app (op Z) z)
      (congrArg ULift.up (mul_one a)))

/-- `AlgebraicGeometry.Space.chartGeneratorsCoeffMap` is the finite sum of the images of the
lifted coefficients under the coproduct injections. -/
theorem chartGeneratorsCoeffMap_apply (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (w : chartGeneratorsIndex V G →₀
      ((((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
        Type u)) :
    chartGeneratorsCoeffMap V G Z w =
      w.sum fun i a => (chartGeneratorsInj V G i).val.app (op Z) (ULift.up a) :=
  (Finsupp.linearCombination_apply _ _).trans
    (Finsupp.sum_congr fun i _ => smul_chartGeneratorsInj_one V G Z i (w i))

/-- `AlgebraicGeometry.Space.chartGeneratorsCoeffMap` is homogeneous.  It is stated separately,
with its scalar in the spelling the slice site gives it, so that it can be applied to a scalar
written in the chart spelling without a scalar action having to be synthesized there; see the
implementation notes. -/
theorem chartGeneratorsCoeffMap_smul (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (a : ((((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
      Type u))
    (w : chartGeneratorsIndex V G →₀
      ((((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
        Type u)) :
    chartGeneratorsCoeffMap V G Z (a • w) = a • chartGeneratorsCoeffMap V G Z w :=
  map_smul _ _ _

/-- `AlgebraicGeometry.Space.chartGeneratorsCoeffMap` is `Stacks.Sites.familySectionsMap`
precomposed with the universe lift of the coefficients. -/
theorem chartGeneratorsCoeffMap_mapRange_down (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (t : chartGeneratorsIndex V G →₀
      ((_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z) :
          Type (max (u + 1) m))) :
    chartGeneratorsCoeffMap V G Z (Finsupp.mapRange
        (fun x : ((_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z) :
            Type (max (u + 1) m)) => ULift.down x) rfl t) =
      (Stacks.Sites.familySectionsMap (chartGeneratorsInj V G) (op Z)).hom t :=
  (chartGeneratorsCoeffMap_apply V G Z _).trans
    ((Finsupp.sum_mapRange_index
        (f := fun x : ((_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z) :
            Type (max (u + 1) m)) => ULift.down x) (hf := rfl) (g := t)
        (h := fun i a => (chartGeneratorsInj V G i).val.app (op Z) (ULift.up a))
        (h0 := fun _ => map_zero _)).trans
      ((Finsupp.sum_congr fun _ _ => rfl).trans
        (Stacks.Sites.familySectionsMap_apply (chartGeneratorsInj V G) (op Z) t).symm))

/-- **Every section of the generating coproduct over an affine object of the slice is a finite
combination of the images of the lift of `1`.**  This is
`AlgebraicGeometry.Space.bijective_chartGeneratorsSectionsMap` transported along the universe
lift of the coefficients. -/
theorem surjective_chartGeneratorsCoeffMap (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left)) :
    Function.Surjective (chartGeneratorsCoeffMap V G Z) := by
  intro p
  obtain ⟨t, ht⟩ := (bijective_chartGeneratorsSectionsMap V G Z hZ).2 p
  exact ⟨_, (chartGeneratorsCoeffMap_mapRange_down V G Z t).trans ht⟩

/-- The generating family, evaluated on a family of coefficients through
`AlgebraicGeometry.Space.chartGeneratorsCoeffMap`, is the combination of the restricted
generators with those coefficients. -/
theorem chartGenerators_val_app_chartGeneratorsCoeffMap (G : Modules.{u, m} B S hS F hF)
    (Z : Over V) (w : chartGeneratorsIndex V G →₀
      ((((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
        Type u)) :
    (chartGenerators V G).val.app (op Z) (chartGeneratorsCoeffMap V G Z w) =
      ULift.up (∑ i ∈ w.support, (@id (chartRing B S hS F hF Z.left) (w i)) •
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) := by
  rw [chartGeneratorsCoeffMap_apply, Finsupp.sum]
  exact chartGenerators_val_app_sum V G Z _ fun i => ULift.up (w i)

/-- The restriction of a coefficient family, read through
`AlgebraicGeometry.Space.chartGeneratorsCoeffMap`, is the value of the corresponding relation leg
at the lift of `1`.  This is what identifies the generators of the span produced by the flat base
change lemma with sections in the image of `AlgebraicGeometry.Space.chartRelations`. -/
theorem chartGeneratorsCoeffMap_mapRange_chartRestrict (G : Modules.{u, m} B S hS F hF)
    (Z : Over V) (q : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V) :
    chartGeneratorsCoeffMap V G Z (Finsupp.mapRange (chartRestrict (hF := hF) Z.hom)
        (map_zero (chartRestrict (hF := hF) Z.hom)) q) =
      (chartRelationsLeg V G q).val.app (op Z) (ULift.up
        (1 : ((((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) :
          Type u))) := by
  refine Eq.trans (chartGeneratorsCoeffMap_apply V G Z _) ?_
  refine Eq.trans (Finsupp.sum_mapRange_index (fun i => map_zero _)) ?_
  refine Eq.trans ?_ (chartRelationsLeg_val_app V G q Z _).symm
  exact Finsupp.sum_congr fun i _ => congrArg
    (fun a : chartRing B S hS F hF Z.left =>
      (chartGeneratorsInj V G i).val.app (op Z) (ULift.up a))
    (one_mul (chartRestrict (hF := hF) Z.hom (q i))).symm

end Core4

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Core5

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
variable (V : (smallEtaleRingedSite B S hS F hF).C)

variable
  [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
  [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
    AddCommGrpCat.{max (u + 1) m}]

/-- **Every relation among the chart generators, over an affine object of the slice, is in the
range of the relations morphism on sections.**

This is the heart of the relations half of Descent, Proposition 03DX(2).  A section of the
generating coproduct killed by the generating family is a finitely supported family of regular
functions annihilating the restricted generators
(`AlgebraicGeometry.Space.surjective_chartGeneratorsCoeffMap` and
`AlgebraicGeometry.Space.chartGenerators_val_app_chartGeneratorsCoeffMap`); by flat base change
it is a combination of restrictions of relations over the chart
(`AlgebraicGeometry.Space.mem_span_image_mapRange_ker_chartGeneratorsCombination`); and each such
restriction is the value of a leg of the relations morphism
(`AlgebraicGeometry.Space.chartGeneratorsCoeffMap_mapRange_chartRestrict`).  The passage from the
generators of the span to the whole span is `Submodule.span_induction`, whose three closure
clauses are the linearity of `AlgebraicGeometry.Space.chartGeneratorsCoeffMap`. -/
theorem mem_range_chartRelations_val_app (G : Modules.{u, m} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left))
    (p : (chartGeneratorsSource V G).val.obj (op Z))
    (hp : (chartGenerators V G).val.app (op Z) p = 0) :
    p ∈ LinearMap.range ((chartRelations V G).val.app (op Z)).hom := by
  classical
  obtain ⟨y, hy⟩ := surjective_chartGeneratorsCoeffMap V G Z hZ p
  have hzero : Finsupp.linearCombination (chartRing B S hS F hF Z.left)
      (fun i : chartGeneratorsIndex V G =>
        chartRestrictLinear G Z.hom (i.down : (G.val.obj (op V) : Type m))) y = 0 := by
    have h1 := chartGenerators_val_app_chartGeneratorsCoeffMap V G Z y
    rw [hy, hp] at h1
    exact (congrArg ULift.down h1).symm
  have hspan := mem_span_image_mapRange_ker_chartGeneratorsCombination V G hG hV Z hZ y hzero
  have key : ∀ w : chartGeneratorsIndex V G →₀ chartRing B S hS F hF Z.left,
      w ∈ Submodule.span (chartRing B S hS F hF Z.left)
        ((fun q : chartGeneratorsIndex V G →₀ chartRing B S hS F hF V =>
            Finsupp.mapRange (chartRestrict (hF := hF) Z.hom)
              (map_zero (chartRestrict (hF := hF) Z.hom)) q) ''
          (LinearMap.ker (chartGeneratorsCombination V G) :
            Set (chartGeneratorsIndex V G →₀ chartRing B S hS F hF V))) →
      chartGeneratorsCoeffMap V G Z w ∈
        LinearMap.range ((chartRelations V G).val.app (op Z)).hom := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      refine LinearMap.mem_range.2 ⟨(Sigma.ι (fun _ : chartRelationsIndex V G =>
        _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))
        ⟨q, hq⟩).val.app (op Z) (ULift.up
          (1 : ((((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over
            V).obj.obj (op Z) : Type u))), ?_⟩
      exact (_root_.SheafOfModules.comp_val_app_apply _ (chartRelations V G) (op Z) _).symm.trans
        ((congrArg (fun ρ : _ ⟶ chartGeneratorsSource V G => ρ.val.app (op Z) (ULift.up
          (1 : ((((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) : Type u))))
          (inj_comp_chartRelations V G ⟨q, hq⟩)).trans
          (chartGeneratorsCoeffMap_mapRange_chartRestrict V G Z q).symm)
    | zero =>
      exact LinearMap.mem_range.2 ⟨0, (map_zero _).trans
        (map_zero (chartGeneratorsCoeffMap V G Z)).symm⟩
    | add x x' hx hx' ihx ihx' =>
      obtain ⟨q, hq⟩ := LinearMap.mem_range.1 ihx
      obtain ⟨q', hq'⟩ := LinearMap.mem_range.1 ihx'
      refine LinearMap.mem_range.2 ⟨q + q', ?_⟩
      refine Eq.trans (map_add _ q q') ?_
      refine Eq.trans (congrArg
        (fun z => z + ((chartRelations V G).val.app (op Z)).hom q') hq) ?_
      exact (congrArg (fun z => chartGeneratorsCoeffMap V G Z x + z) hq').trans
        (map_add (chartGeneratorsCoeffMap V G Z) x x').symm
    | smul a x hx ih =>
      obtain ⟨q, hq⟩ := LinearMap.mem_range.1 ih
      refine LinearMap.mem_range.2 ⟨(@id ((((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) : Type u) a) • q, ?_⟩
      refine Eq.trans (map_smul _ _ q) ?_
      refine Eq.trans (congrArg (fun z => (@id ((((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over V).obj.obj (op Z) : Type u) a) • z) hq) ?_
      exact (chartGeneratorsCoeffMap_smul V G Z a x).symm
  exact hy ▸ key y hspan

end Core5

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Final

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
variable (V : (smallEtaleRingedSite B S hS F hF).C)

variable
  [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
  [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
    AddCommGrpCat.{max (u + 1) m}]

/-- The lift of the relations morphism to the kernel of the generating family is surjective on
the sections over an affine object of the slice.

Sections take a kernel to a kernel (`SheafOfModules.exact_kernel_ι_val_app`), so a section of the
kernel is a relation among the generators; it is hit by
`AlgebraicGeometry.Space.mem_range_chartRelations_val_app`, and the inclusion of the kernel is
injective on sections, so the lift hits the section itself. -/
theorem surjective_kernelLift_chartRelations_val_app (G : Modules.{u, m} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left)) :
    Function.Surjective ((kernel.lift (chartGenerators V G) (chartRelations V G)
      (chartRelations_comp_chartGenerators V G)).val.app (op Z)) := by
  intro n
  have h0 : (chartGenerators V G).val.app (op Z)
      ((kernel.ι (chartGenerators V G)).val.app (op Z) n) = 0 :=
    (_root_.SheafOfModules.exact_kernel_ι_val_app (chartGenerators V G)
      (op Z)).apply_apply_eq_zero n
  obtain ⟨q, hq⟩ := LinearMap.mem_range.1
    (mem_range_chartRelations_val_app V G hG hV Z hZ _ h0)
  refine ⟨q, _root_.SheafOfModules.kernel_ι_val_app_injective (chartGenerators V G) (op Z) ?_⟩
  refine Eq.trans (Eq.trans (_root_.SheafOfModules.comp_val_app_apply
    (kernel.lift (chartGenerators V G) (chartRelations V G)
      (chartRelations_comp_chartGenerators V G)) (kernel.ι (chartGenerators V G))
    (op Z) q).symm ?_) hq
  exact congrArg (fun ρ : chartRelationsSource V G ⟶ chartGeneratorsSource V G =>
    ρ.val.app (op Z) q) (kernel.lift_ι (chartGenerators V G) (chartRelations V G)
      (chartRelations_comp_chartGenerators V G))

/-- **The relations among the chart generators are generated by global ones.**  The lift of
`AlgebraicGeometry.Space.chartRelations` to the kernel of `AlgebraicGeometry.Space.chartGenerators`
is an epimorphism.

It is surjective on the sections over every affine object of the slice by
`AlgebraicGeometry.Space.surjective_kernelLift_chartRelations_val_app`, those objects are
cover-dense by `AlgebraicGeometry.Space.isCoverDense_affineChartsOver`, hence it is locally
surjective by
`Stacks.PresheafOfModules.isLocallySurjective_of_surjective_of_isCoverDense`, and a locally
surjective morphism of sheaves of modules is an epimorphism. -/
theorem epi_kernelLift_chartRelations (G : Modules.{u, m} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    Epi (kernel.lift (chartGenerators V G) (chartRelations V G)
      (chartRelations_comp_chartGenerators V G)) := by
  have hls := Stacks.PresheafOfModules.isLocallySurjective_of_surjective_of_isCoverDense
    ((smallEtaleRingedSite B S hS F hF).J.over V)
    (ObjectProperty.ι (fun Z : Over V => IsAffineChart B S hS F Z.left))
    (isCoverDense_affineChartsOver hF V)
    (kernel.lift (chartGenerators V G) (chartRelations V G)
      (chartRelations_comp_chartGenerators V G)).val
    (fun A => surjective_kernelLift_chartRelations_val_app V G hG hV A.obj A.property)
  exact _root_.SheafOfModules.epi_of_isLocallySurjective _ hls

end Final

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space

section Final2

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-- **The hypothesis `hrel` of
`AlgebraicGeometry.Space.isQuasicoherentOnSite_of_isCartesianOnAffineCharts_of_rel`,
discharged.**  Over an affine étale chart of a module cartesian on affine charts there is a
coproduct of copies of the universe-lifted structure sheaf of the slice mapping onto the kernel
of the canonical generating family.

The witnesses are `AlgebraicGeometry.Space.chartRelationsIndex`,
`AlgebraicGeometry.Space.chartRelationsSource` and `AlgebraicGeometry.Space.chartRelations`. -/
theorem exists_chartRelations_epi_kernelLift (V : (smallEtaleRingedSite B S hS F hF).C)
    [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
    [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
      AddCommGrpCat.{max (u + 1) m}]
    (G : Modules.{u, m} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    ∃ (K : Type (max (u + 1) m))
      (Q : SheafOfModules.{max (u + 1) m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))
      (κ : ∀ _ : K, _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V) ⟶ Q)
      (_ : IsColimit (Cofan.mk Q κ))
      (a : Q ⟶ chartGeneratorsSource V G) (hab : a ≫ chartGenerators V G = 0),
      Epi (kernel.lift (chartGenerators V G) a hab) :=
  ⟨chartRelationsIndex V G, chartRelationsSource V G,
    Sigma.ι (fun _ : chartRelationsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V)),
    coproductIsCoproduct _, chartRelations V G,
    chartRelations_comp_chartGenerators V G, epi_kernelLift_chartRelations V G hG hV⟩

/-- **A module cartesian on affine charts is quasi-coherent on the small étale site of the
algebraic space**, at an arbitrary universe of module sections.

This is the direction "base change criterion ⟹ quasi-coherent" of Descent,
Proposition 03DX(2).  It is
`AlgebraicGeometry.Space.isQuasicoherentOnSite_of_isCartesianOnAffineCharts_of_rel` with its two
sheafification hypotheses, at the universe `max (u + 1) m` of a global presentation, discharged
by `AlgebraicGeometry.Space.hasSheafify_over_presentationUniverse` and
`AlgebraicGeometry.Space.wEqualsLocallyBijective_over_presentationUniverse`, and its relations
hypothesis `hrel` discharged by
`AlgebraicGeometry.Space.exists_chartRelations_epi_kernelLift`.  The converse implication is
`AlgebraicGeometry.Space.isCartesianOnAffineCharts_of_isQuasicoherentOnSite_anyUniverse`. -/
theorem isQuasicoherentOnSite_of_isCartesianOnAffineCharts_anyUniverse
    (G : Modules.{u, m} B S hS F hF) (hG : IsCartesianOnAffineCharts G) :
    G.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts_of_rel G hG
    (fun W => hasSheafify_over_presentationUniverse.{u, m} W)
    (fun W => wEqualsLocallyBijective_over_presentationUniverse.{u, m} W)
    (fun W hW =>
      let := hasSheafify_over_presentationUniverse.{u, m} W
      let := wEqualsLocallyBijective_over_presentationUniverse.{u, m} W
      exists_chartRelations_epi_kernelLift W G hG hW)

/-- **A module cartesian on affine charts is quasi-coherent on the small étale site of the
algebraic space**, for module sections in the universe of the schemes.  This is
`AlgebraicGeometry.Space.isQuasicoherentOnSite_of_isCartesianOnAffineCharts_anyUniverse` at that
universe. -/
theorem isQuasicoherentOnSite_of_isCartesianOnAffineCharts (G : Modules.{u, u} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G) : G.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts_anyUniverse G hG

end Final2

end AlgebraicGeometry.Space

end
