/-!
# Base change on the spaces-étale sites of algebraic spaces

A morphism `f : X ⟶ Y` of algebraic spaces over `S` induces, by base change, a functor from the
spaces-étale site of `Y` to that of `X`, and this functor is a morphism of sites. Base change
along a composite is canonically isomorphic to the iterated base change.

## Main definitions

* `AlgebraicGeometry.Space.SpacesBaseChange` packages a base-change functor on spaces-étale
  sites together with its cartesian projection to the original object.
* `AlgebraicGeometry.Space.spacesBaseChange` is the canonical such datum.

## Main results

* `AlgebraicGeometry.Space.spacesBaseChange_isMorphismOfSites`: base change is a morphism of
  sites.
* `AlgebraicGeometry.Space.spacesBaseChange_comp` and
  `AlgebraicGeometry.Space.spacesBaseChange_comp_projection`: the composition isomorphism and
  its compatibility with the cartesian projections.
* `AlgebraicGeometry.Space.SpacesEtale.isTerminal_of_isIso`: an object whose structure morphism
  is an isomorphism — in particular the identity of `X` — is terminal in the spaces-étale site.

## Implementation notes

The functor is the base change `CategoryTheory.Over.pullback f` of the slice over `Y`,
restricted to the étale objects: a base change of an étale morphism of algebraic spaces is
étale by Stacks 03FU, so the restriction exists, and the projection is the other projection of
that same fibre product, which makes the `isPullback` field hold by construction.

The site-morphism property is the criterion of Stacks 00X6,
`CategoryTheory.Functor.isMorphismOfSites_of_isTerminal`: the spaces-étale site has a terminal
object — the identity of the base — and fibre products, which are
`AlgebraicGeometry.Space.SpacesEtale.instHasPullbacks`, and base change preserves both. Fibre
products are preserved because the inclusion into the slice *creates* them and base change in a
slice preserves them; the terminal object is preserved because the base change of an
isomorphism is an isomorphism, and an object of the site whose structure morphism is an
isomorphism is terminal.

Continuity, the remaining hypothesis of the criterion, is not proved by checking the covering
axioms a second time: the image of a jointly point-surjective family is jointly
point-surjective — by surjectivity on points of a base change, Stacks 03H4 — so the
precoverage of `Y` is below the comap of the spaces-étale topology of `X`, and
`Stacks.Sites.isContinuous_toGrothendieck_of_le_comap` descends continuity to the topology
generated by it. The pullback square needed for the point-surjectivity statement is
`AlgebraicGeometry.Space.isPullback_overPullback_map`, the cartesian square expressing that
base change in a slice is computed by a fibre product in the ambient category.

The composition isomorphism is `CategoryTheory.Over.pullbackComp` restricted to the étale
objects, and its compatibility with the projections is the corresponding statement for the
counits of the base-change adjunctions, `CategoryTheory.conjugateEquiv_counit`.

## References

* [Stacks Project, Tag 03G2](https://stacks.math.columbia.edu/tag/03G2)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Base change in a slice is a cartesian square -/

/-- Base change along `f : X ⟶ Y` of a morphism `a` of the slice over `Y` sits in a cartesian
square with the two projections to the original objects.

This is the statement that `CategoryTheory.Over.pullback f` is computed by a fibre product in
the ambient category, in the form consumed by a point-set argument. -/
theorem isPullback_overPullback_map {C : Type*} [Category* C] {X Y : C} (f : X ⟶ Y)
    [HasPullbacksAlong f] {A V : Over Y} (a : A ⟶ V) :
    IsPullback (((Over.pullback f).map a).left) (pullback.fst A.hom f)
      (pullback.fst V.hom f) a.left := by
  refine IsPullback.of_right ?_ (by simpa using pullback.lift_fst _ _ _)
    (IsPullback.of_hasPullback V.hom f).flip
  have hA : A.hom = a.left ≫ V.hom := (Over.w a).symm
  have hsnd : ((Over.pullback f).map a).left ≫ pullback.snd V.hom f =
      pullback.snd A.hom f := by simpa using pullback.lift_snd _ _ _
  rw [hsnd, ← hA]
  exact (IsPullback.of_hasPullback A.hom f).flip

/-! ### The terminal object of the spaces-étale site -/

namespace SpacesEtale

variable {X : AlgebraicSpaces B S hS}

/-- An object of the spaces-étale site of `X` whose structure morphism is an isomorphism is a
terminal object: every object has exactly one morphism to it, namely its own structure
morphism followed by the inverse. -/
noncomputable def isTerminal_of_isIso (U : SpacesEtale B S hS X) (hU : IsIso U.1.hom) :
    IsTerminal U :=
  letI := hU
  IsTerminal.ofUniqueHom
    (fun A ↦ ObjectProperty.homMk (Over.homMk (A.1.hom ≫ inv U.1.hom) (by simp)))
    (fun A m ↦ by
      refine ObjectProperty.hom_ext _ (Over.OverMorphism.ext ?_)
      rw [← Category.comp_id m.hom.left, ← IsIso.hom_inv_id U.1.hom, ← Category.assoc,
        Over.w m.hom]
      rfl)

variable (X)

/-- The identity of `X`, as an object of the spaces-étale site of `X`. It is the terminal
object. -/
def idObj : SpacesEtale B S hS X :=
  ⟨Over.mk (𝟙 X), fun _ φ hφ ↦ by simpa using hφ⟩

/-- The identity of `X` is terminal in the spaces-étale site of `X`. -/
noncomputable def isTerminal_idObj : IsTerminal (idObj B S hS X) :=
  isTerminal_of_isIso B S hS _ (by change IsIso (𝟙 X); infer_instance)

end SpacesEtale

/-! ### The base-change functor -/

/-- Base change of the objects of a spaces-étale site, together with the cartesian projection
to the original object. The projection and its cartesianness are part of the datum because the
chosen fibre products of two base changes need not be equal on the nose, so the comparison
isomorphisms below are pinned down by their compatibility with the projections. -/
structure SpacesBaseChange {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) where
  /-- The base-change functor from the spaces-étale site of `Y` to that of `X`. -/
  functor : SpacesEtale B S hS Y ⥤ SpacesEtale B S hS X
  /-- The projection from a base-changed object to the original one. -/
  projection : functor ⋙ SpacesEtale.toSpaces B S hS X ⟶ SpacesEtale.toSpaces B S hS Y
  /-- The projection exhibits the base-changed object as a fibre product. -/
  isPullback (V : SpacesEtale B S hS Y) :
    IsPullback (projection.app V) (functor.obj V).1.hom V.1.hom f

/-- A base change along `f` of an object étale over `Y` is étale over `X`, by Stacks 03FU. -/
theorem isEtaleOver_overPullback {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (V : Over Y)
    (hV : IsEtaleOver B S hS Y V) :
    IsEtaleOver B S hS X ((Over.pullback f).obj V) :=
  isEtale_of_isPullback B S hS _ _ _ _ (IsPullback.of_hasPullback V.hom f) hV

/-- **Stacks 03G2, part (1).** The canonical base-change datum on the spaces-étale sites: the
base change `CategoryTheory.Over.pullback f` of the slice over `Y`, restricted to the objects
étale over the base, with the first projection of the fibre product. -/
@[stacks 03G2 "part (1), the cartesian base-change functor"]
noncomputable def spacesBaseChange {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) :
    SpacesBaseChange B S hS f where
  functor := (IsEtaleOver B S hS X).lift (SpacesEtale.inclusion B S hS Y ⋙ Over.pullback f)
    (fun V ↦ isEtaleOver_overPullback B S hS f _ V.property)
  projection :=
    { app := fun V ↦ pullback.fst V.1.hom f
      naturality := fun _ _ _ ↦ by simpa using pullback.lift_fst _ _ _ }
  isPullback V := IsPullback.of_hasPullback V.1.hom f

/-! ### Base change is a morphism of sites -/

/-- Base change preserves fibre products of spaces-étale sites: the inclusion into the slice
creates them, and base change in a slice, being a right adjoint, preserves all limits. -/
instance preservesPullbacks_spacesBaseChange {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) :
    PreservesLimitsOfShape WalkingCospan (spacesBaseChange B S hS f).functor := by
  have h₀ : PreservesLimitsOfShape WalkingCospan
      (SpacesEtale.inclusion B S hS Y ⋙ Over.pullback f) := comp_preservesLimitsOfShape _ _
  have h₁ : PreservesLimitsOfShape WalkingCospan
      ((spacesBaseChange B S hS f).functor ⋙ SpacesEtale.inclusion B S hS X) :=
    preservesLimitsOfShape_of_natIso (J := WalkingCospan)
      (ObjectProperty.liftCompιIso (IsEtaleOver B S hS X)
        (SpacesEtale.inclusion B S hS Y ⋙ Over.pullback f)
        (fun V ↦ isEtaleOver_overPullback B S hS f _ V.property)).symm
  exact preservesLimitsOfShape_of_reflects_of_preserves _ (SpacesEtale.inclusion B S hS X)

/-- Base change sends the terminal object of the spaces-étale site of `Y` to a terminal object:
the structure morphism of the base change of the identity of `Y` is a base change of an
isomorphism. -/
noncomputable def isTerminal_spacesBaseChange_idObj {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) :
    IsTerminal ((spacesBaseChange B S hS f).functor.obj (SpacesEtale.idObj B S hS Y)) :=
  SpacesEtale.isTerminal_of_isIso B S hS _
    ((IsPullback.of_hasPullback (𝟙 Y) f).isIso_snd_of_isIso)

/-- The image under base change of a jointly point-surjective family is jointly
point-surjective, by surjectivity on points of a base change (Stacks 03H4). Equivalently: the
spaces-étale precoverage of `Y` lies below the comap along base change of the spaces-étale
topology of `X`. -/
theorem precoverage_le_comap_spacesBaseChange {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) :
    SpacesEtale.precoverage B S hS Y ≤
      (SpacesEtale.topology B S hS X).toPrecoverage.comap
        (spacesBaseChange B S hS f).functor := by
  intro V R hR
  obtain ⟨E, rfl, hE⟩ := hR
  rw [Precoverage.mem_comap_iff, GrothendieckTopology.mem_toPrecoverage_iff,
    ← PreZeroHypercover.presieve₀_map]
  refine Precoverage.generate_mem_toGrothendieck
    ⟨E.map (spacesBaseChange B S hS f).functor, rfl, fun x ↦ ?_⟩
  obtain ⟨i, y, hy⟩ := hE (pointsMap B S hS _
    ((spacesBaseChange B S hS f).projection.app V).hom x)
  obtain ⟨w, hw, -⟩ := exists_points_of_isPullback B S hS
    (AlgebraicSpaces.isPullback_hom B S hS
      (isPullback_overPullback_map f ((SpacesEtale.inclusion B S hS Y).map (E.f i))))
    x y hy.symm
  exact ⟨i, w, hw⟩

/-- Base change on spaces-étale sites is continuous. -/
instance isContinuous_spacesBaseChange {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) :
    (spacesBaseChange B S hS f).functor.IsContinuous
      (SpacesEtale.topology B S hS Y) (SpacesEtale.topology B S hS X) :=
  Stacks.Sites.isContinuous_toGrothendieck_of_le_comap _ _ _
    (precoverage_le_comap_spacesBaseChange B S hS f)

/-- **Stacks 03G2, part (1).** Base change defines a morphism of sites in the direction
`X → Y`: it is continuous, the spaces-étale site of `Y` has a terminal object and fibre
products, and base change preserves both. -/
@[stacks 03G2 "part (1), morphism of sites"]
theorem spacesBaseChange_isMorphismOfSites {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) :
    (spacesBaseChange B S hS f).functor.IsMorphismOfSites
      (SpacesEtale.topology B S hS Y) (SpacesEtale.topology B S hS X) :=
  Functor.isMorphismOfSites_of_isTerminal _ _ _ (SpacesEtale.isTerminal_idObj B S hS Y)
    (isTerminal_spacesBaseChange_idObj B S hS f)

/-! ### Compatibility with composition -/

/-- **Stacks 03G2, part (2).** Base change along a composite is canonically isomorphic to the
iterated base change, by `CategoryTheory.Over.pullbackComp` restricted to the objects étale
over the base. -/
@[stacks 03G2 "part (2), canonical composition isomorphism"]
noncomputable def spacesBaseChange_comp {X Y Z : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (g : Y ⟶ Z) :
    (spacesBaseChange B S hS g).functor ⋙ (spacesBaseChange B S hS f).functor ≅
      (spacesBaseChange B S hS (f ≫ g)).functor :=
  NatIso.ofComponents
    (fun V ↦ (IsEtaleOver B S hS X).isoMk
      ((Over.pullbackComp f g).symm.app ((SpacesEtale.inclusion B S hS Z).obj V)))
    (fun k ↦ ObjectProperty.hom_ext _ (by
      simpa [spacesBaseChange, SpacesEtale.inclusion, IsEtaleOver] using
        (Over.pullbackComp f g).symm.hom.naturality
          ((SpacesEtale.inclusion B S hS Z).map k)))

/-- **Stacks 03G2, part (2).** The composition isomorphism is compatible with the cartesian
projections to the original object, which pins it down. -/
@[stacks 03G2 "part (2), compatibility with cartesian projections"]
theorem spacesBaseChange_comp_projection {X Y Z : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (g : Y ⟶ Z) (V : SpacesEtale B S hS Z) :
    ((spacesBaseChange_comp B S hS f g).hom.app V).hom.left ≫
        (spacesBaseChange B S hS (f ≫ g)).projection.app V =
      (spacesBaseChange B S hS f).projection.app
          ((spacesBaseChange B S hS g).functor.obj V) ≫
        (spacesBaseChange B S hS g).projection.app V := by
  have h := CategoryTheory.conjugateEquiv_counit
    ((Over.mapPullbackAdj f).comp (Over.mapPullbackAdj g))
    (Over.mapPullbackAdj (f ≫ g)) (Over.mapComp f g).hom V.1
  refine ObjectProperty.hom_ext _ ?_
  simpa [spacesBaseChange_comp, spacesBaseChange, SpacesEtale.toSpaces,
    SpacesEtale.inclusion, IsEtaleOver, Over.pullbackComp,
    Over.mapPullbackAdj_counit_app, ObjectProperty.homMk_hom] using
      congrArg (fun q => q.hom) (congrArg Over.Hom.left h)

end AlgebraicGeometry.Space

end
