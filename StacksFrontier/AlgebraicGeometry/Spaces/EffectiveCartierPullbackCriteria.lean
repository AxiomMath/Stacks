/-!
# Criteria for the pullback of an effective Cartier divisor on an algebraic space

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` and let `D ⊆ Y` be an
effective Cartier divisor.  The pullback of `D` along `f` is defined — its inverse image
`f⁻¹(D) ⊆ X` is again an effective Cartier divisor — in each of two cases: when `f` carries no
weakly associated point of `X` into `|D|`, and when `f` is flat.  Both are reduced, through the
étale-chart characterization of Stacks 083C, to the corresponding criteria for schemes.

## Main results

* `AlgebraicGeometry.Space.isPullbackDefined_of_notMem_weaklyAssociatedPoints`:
  **Stacks 083Z (1)**, the pullback is defined when the images of the weakly associated points of
  the source avoid the divisor.
* `AlgebraicGeometry.Space.isPullbackDefined_of_isFlat`: **Stacks 083Z (2)**, the pullback is
  defined along a flat morphism.
* `Stacks.Divisors.isPullbackDefined_of_notMem_support_of_weaklyAssociated`:
  **Stacks 02OO (1)**, the scheme case of the first criterion.
* `AlgebraicGeometry.Space.mem_weaklyAssociatedPointsOfSpace_chartSchemeToPoints`: a weakly
  associated point of an étale scheme chart lies over a weakly associated point of the space.

## Implementation notes

The chart comparison for weakly associated points goes through Stacks 04KF: the étale local ring
of the space at a geometric point is the strict henselization of the local ring of a scheme chart
at the induced point, and a strict henselization is flat over the ring it henselizes with maximal
ideal generated by the maximal ideal below, so weak association of the maximal ideal passes from
the chart to the space.  Only that direction is needed, and it uses no base-change formula for
the geometric stalk.

## References

* [Stacks Project, Tag 083Z](https://stacks.math.columbia.edu/tag/083Z)
* [Stacks Project, Tag 083C](https://stacks.math.columbia.edu/tag/083C)
* [Stacks Project, Tag 02OO](https://stacks.math.columbia.edu/tag/02OO)
* [Stacks Project, Tag 056M](https://stacks.math.columbia.edu/tag/056M)
* [Stacks Project, Tag 04KF](https://stacks.math.columbia.edu/tag/04KF)
* [Stacks Project, Tag 0CTX](https://stacks.math.columbia.edu/tag/0CTX)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Divisors

/-- **Stacks 02OO (1), the scheme case.** The pullback of an effective Cartier divisor `D ⊆ Y`
along a morphism of schemes `f : X ⟶ Y` is defined as soon as `f` carries no weakly associated
point of `X` into the support of `D`.

The question is affine-local: near a point `x` of the support of the inverse image, `D` is cut
out on an affine open `V ∋ f x` by a nonzerodivisor `t`, and on an affine open `U ∋ x` inside
`f⁻¹(V)` the inverse image is cut out by the image `φ t` of `t`.  Were `φ t` a zerodivisor, a
minimal prime `q` over the annihilator of a witness would be a weakly associated prime of
`Γ(X, U)` containing `φ t`, hence by Stacks 056M a weakly associated point `x₀` of `X` with
`t` in the prime of `f x₀`; so `f x₀` would lie in the support of `D`. -/
@[stacks 02OO "part (1): a morphism carrying no weakly associated point into the support",
  ega "IV 21.4.5" "special case"]
theorem isPullbackDefined_of_notMem_support_of_weaklyAssociated {X Y : Scheme.{u}} (f : X ⟶ Y)
    (D : Y.IdealSheafData) (hD : IsEffectiveCartierDivisor D)
    (hf : ∀ x ∈ schemeWeaklyAssociatedPoints X, f x ∉ D.supportSet) :
    IsPullbackDefined f D := by
  show IsEffectiveCartierDivisor (D.comap f)
  refine (isEffectiveCartierDivisor_iff_affineLocal (D.comap f)).2 fun x hx => ?_
  have hxSupport : x ∈ (D.comap f).support :=
    Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mp hx
  have hySupport : f x ∈ D.support := by
    rwa [Scheme.IdealSheafData.support_comap] at hxSupport
  obtain ⟨V, hV, hfxV, t, ht, e, he⟩ :=
    (isEffectiveCartierDivisor_iff_affineLocal D).mp hD (f x)
      (Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mpr hySupport)
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ f ⁻¹ᵁ V from hfxV) (f ⁻¹ᵁ V).isOpen
  let Va : Y.affineOpens := ⟨V, hV⟩
  let Ua : X.affineOpens := ⟨U, hU⟩
  have hDideal : D.ideal Va = Ideal.span {t} :=
    ideal_eq_quotient_of_chart D V hV (Ideal.span {t}) e he
  have hJideal : (D.comap f).ideal Ua = Ideal.span {(f.appLE Va Ua hUV).hom t} := by
    rw [Stacks.IdealSheaf.ideal_comap_appLE D f Va Ua hUV, hDideal, Ideal.map_span]
    simp
  have hsm : IsSMulRegular Γ(X, U) ((f.appLE Va Ua hUV).hom t) := by
    apply IsSMulRegular.of_right_eq_zero_of_smul
    intro m hm
    by_contra hm0
    obtain ⟨q, hq⟩ := Ideal.nonempty_minimalPrimes
      (I := (Γ(X, U) ∙ m).annihilator) (by
        simpa [Submodule.annihilator_eq_top_iff, Submodule.span_singleton_eq_bot] using hm0)
    let p : PrimeSpectrum Γ(X, U) := ⟨q, hq.isPrime⟩
    let x₀ : X := hU.fromSpec p
    have hx₀U : x₀ ∈ U := (hU.range_fromSpec ▸ Set.mem_range_self p : x₀ ∈ (U : Set X))
    have hoi : _root_.AlgebraicGeometry.IsOpenImmersion hU.fromSpec :=
      hU.isOpenImmersion_fromSpec
    have hqx₀ : q = (hU.primeIdealOf ⟨x₀, hx₀U⟩).asIdeal :=
      (congrArg PrimeSpectrum.asIdeal <| hU.fromSpec.isOpenEmbedding.injective
        (hU.fromSpec_primeIdealOf ⟨x₀, hx₀U⟩)).symm
    have hx₀wa : x₀ ∈ schemeWeaklyAssociatedPoints X := by
      rw [mem_schemeWeaklyAssociatedPoints_iff,
        ← AlgebraicGeometry.isWeaklyAssociatedPrime_iff_isWeaklyAssociatedPoint
          (SheafOfModules.unit X.ringCatSheaf) U hU x₀ hx₀U, ← hqx₀]
      exact ⟨m, hq⟩
    have htq : (f.appLE Va Ua hUV).hom t ∈ q :=
      hq.1.2 (by rw [Submodule.mem_annihilator_span_singleton]; exact hm)
    have hfx₀V : f x₀ ∈ V := hUV hx₀U
    have htp : t ∈ (hV.primeIdealOf ⟨f x₀, hfx₀V⟩).asIdeal := by
      rw [← IsAffineOpen.comap_primeIdealOf_appLE V hV U hU hUV hx₀U]
      show (f.appLE Va Ua hUV).hom t ∈ (hU.primeIdealOf ⟨x₀, hx₀U⟩).asIdeal
      rw [← hqx₀]
      exact htq
    refine hf x₀ hx₀wa ?_
    rw [Scheme.IdealSheafData.mem_supportSet_iff_of_mem (U := Va) hfx₀V, hDideal,
      Scheme.zeroLocus_span]
    simp only [Scheme.mem_zeroLocus_iff, Set.mem_singleton_iff, forall_eq]
    intro hmem
    have h1 : hV.fromSpec (hV.primeIdealOf ⟨f x₀, hfx₀V⟩) ∈ Y.basicOpen t := by
      rw [hV.fromSpec_primeIdealOf]
      exact hmem
    have h2 : hV.primeIdealOf ⟨f x₀, hfx₀V⟩ ∈ hV.fromSpec ⁻¹ᵁ Y.basicOpen t := h1
    rw [hV.fromSpec_preimage_basicOpen] at h2
    exact h2 htp
  have htU : IsRegular ((f.appLE Va Ua hUV).hom t) := by
    refine (Commute.isRegular_iff fun b => mul_comm ((f.appLE Va Ua hUV).hom t) b).2 ?_
    simpa only [IsSMulRegular, IsLeftRegular, smul_eq_mul] using hsm
  obtain ⟨eJ, heJ⟩ :=
    exists_quotient_chart_of_ideal_span (D.comap f) U hU
      ((f.appLE Va Ua hUV).hom t) hJideal
  exact ⟨U, hU, hxU, (f.appLE Va Ua hUV).hom t, htU, eJ, heJ⟩

end Stacks.Divisors

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Stacks 083Z (2).** The pullback of an effective Cartier divisor `D ⊆ Y` along a flat
morphism `f : X ⟶ Y` of algebraic spaces is defined.

A surjective étale scheme chart `q : V ⟶ Y` lifts to a surjective étale scheme chart
`p : U ⟶ X` sitting over it by a morphism `α : U ⟶ V` of the site, and `α` is flat because `f`
is.  By Stacks 083C the inverse image of `D` is an effective Cartier divisor on `V`, hence by
the scheme case Stacks 02OO also on `U`; and the inverse image of `D` on `U` through `α` is the
inverse image of `f⁻¹(D)` through `p`, so Stacks 083C applies again, on `X`. -/
@[stacks 083Z "part (2): a flat morphism"]
theorem isPullbackDefined_of_isFlat {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (D : ClosedSubspaces B S hS Y.1) (hD : IsEffectiveCartierDivisor B S hS Y D)
    (hf : IsFlat B S hS f.hom) :
    IsPullbackDefined B S hS f D := by
  obtain ⟨V, q, hqSurj, hqEtale⟩ := Y.2.exists_atlas
  obtain ⟨U, p, α, hcomm, hpSurj, hpEtale⟩ :=
    exists_surjective_etale_presentation_lift B S hS X.2 Y.2 f.hom V q hqSurj hqEtale
  have : Flat ((BigFppfOver.toScheme B S hS).map α) :=
    hf U V p q α hpEtale hqEtale hcomm.symm
  obtain ⟨I, R, j, e, hI, hmap, hran⟩ :=
    isSchemeEffectiveCartierPullback_comp_of_flat B S hS Y D q α
      (hasEffectiveCartierEtalePullbacks_of_isEffectiveCartier B S hS Y D hD V q
        (isEtale_of_presheaf_etale B S hS hqEtale))
  refine isEffectiveCartierDivisor_of_hasEffectiveCartierEtaleCover B S hS X _
    ⟨U, p, isEtale_of_presheaf_etale B S hS hpEtale,
      (presheafSurjective_iff_isSurjective_yoneda B S hS X.1 X.2 U p).1 hpSurj,
      I, R, j, e, hI, hmap, ?_⟩
  rw [← hran]
  show (D.1.preimage f.hom).preimage p = _
  rw [← Subfunctor.preimage_comp, hcomm]

/-! ### Weakly associated points read on an étale scheme chart -/

/-- Weak association of the maximal ideal to a local ring passes to a flat local algebra over it
whose maximal ideal is generated by the maximal ideal below. -/
private theorem isWeaklyAssociatedPrime_maximalIdeal_of_flat
    {A C : Type*} [CommRing A] [IsLocalRing A] [CommRing C] [IsLocalRing C] [Algebra A C]
    [Module.Flat A C]
    (hmax : Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal C)
    (h : IsWeaklyAssociatedPrime A A (IsLocalRing.maximalIdeal A)) :
    IsWeaklyAssociatedPrime C C (IsLocalRing.maximalIdeal C) := by
  have hrad : (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)).radical =
      IsLocalRing.maximalIdeal C := by
    rw [hmax]
    exact Ideal.IsPrime.radical inferInstance
  exact (LinearEquiv.isWeaklyAssociatedPrime_iff (Algebra.TensorProduct.rid A C C).toLinearEquiv
    _).mp (isWeaklyAssociatedPrime_maximalIdeal_tensorProduct_of_flat_of_radical_eq hrad h)

/-- Weak association of the maximal ideal to a local ring transports along a ring
isomorphism. -/
private theorem isWeaklyAssociatedPrime_maximalIdeal_of_ringEquiv
    {A C : Type*} [CommRing A] [IsLocalRing A] [CommRing C] [IsLocalRing C] (e : A ≃+* C)
    (h : IsWeaklyAssociatedPrime A A (IsLocalRing.maximalIdeal A)) :
    IsWeaklyAssociatedPrime C C (IsLocalRing.maximalIdeal C) :=
  (isWeaklyAssociatedPrime_maximalIdeal_congr_semilinearEquiv e e.toAddEquiv
    (fun r z => by simp)).mp h

/-- A point of an algebraic space whose étale local ring has its maximal ideal weakly associated
to itself is a weakly associated point of the space: the geometric stalk of the structure sheaf
at a geometric point is that étale local ring. -/
private theorem mem_weaklyAssociatedPointsOfSpace_of_etaleLocalRing
    (X : AlgebraicSpaces B S hS) (xbar : GeometricPoint B S hS X.1) :
    letI : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
      isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
    IsWeaklyAssociatedPrime (etaleLocalRing B S hS X.1 xbar)
        (etaleLocalRing B S hS X.1 xbar) (IsLocalRing.maximalIdeal _) →
      xbar.image ∈ weaklyAssociatedPointsOfSpace B S hS X := by
  let _ : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  intro h3
  rw [mem_weaklyAssociatedPointsOfSpace_iff]
  refine (isWeaklyAssociatedPoint_iff_moduleStalkLarge B S hS X _ xbar.image).mpr
    ⟨xbar, rfl, ?_⟩
  let _ : IsLocalRing
      (((etaleSitePoint B S hS X.1 xbar X.2).presheafFiber (A := CommRingCat.{u})).obj
        (smallEtaleRingedTopos B S hS X).O.obj) :=
    (pointStalkRingEquiv B S hS X xbar).symm.isLocalRing
  exact (LinearEquiv.isWeaklyAssociatedPrime_iff
    (Stacks.unitModuleStalkLargeEquiv (etaleSitePoint B S hS X.1 xbar X.2)
      (smallEtaleRingedTopos B S hS X).O).symm _).mp
    (isWeaklyAssociatedPrime_maximalIdeal_of_ringEquiv (pointStalkRingEquiv B S hS X xbar).symm h3)

/-- **Stacks 04KF transports weak association from a chart to the space.** If the maximal ideal
of the local ring of a small étale neighbourhood at its selected point is weakly associated to
that local ring, then the image of the geometric point is a weakly associated point of the
algebraic space: the étale local ring is the strict henselization of that local ring, which is
flat over it with maximal ideal generated by the one below. -/
private theorem mem_weaklyAssociatedPointsOfSpace_of_chartStalk
    (X : AlgebraicSpaces B S hS) (xbar : GeometricPoint B S hS X.1)
    (V : SmallEtaleNeighborhood xbar)
    (hA : IsWeaklyAssociatedPrime
        ((neighborhoodChartScheme V).presheaf.stalk ((chartGeometricPoint V).hom
          (IsLocalRing.closedPoint (chartGeometricPoint V).residueField)))
        ((neighborhoodChartScheme V).presheaf.stalk ((chartGeometricPoint V).hom
          (IsLocalRing.closedPoint (chartGeometricPoint V).residueField)))
        (IsLocalRing.maximalIdeal _)) :
    xbar.image ∈ weaklyAssociatedPointsOfSpace B S hS X := by
  have hE : (bigEtaleSiteOfFppfSite B).Contains (neighborhoodChartScheme V) :=
    V.chart.obj.left.left.property
  set A := (neighborhoodChartScheme V).presheaf.stalk ((chartGeometricPoint V).hom
    (IsLocalRing.closedPoint (chartGeometricPoint V).residueField)) with hAdef
  set κ := separableClosure (IsLocalRing.ResidueField A) (chartGeometricPoint V).residueField
    with hκdef
  set T := IsLocalRing.henselizationTower A κ with hTdef
  have hflat : Module.Flat A T.strictHenselization :=
    IsLocalRing.IsHenselization.flat (L := κ)
  have h2 : IsWeaklyAssociatedPrime T.strictHenselization T.strictHenselization
      (IsLocalRing.maximalIdeal T.strictHenselization) :=
    isWeaklyAssociatedPrime_maximalIdeal_of_flat
      (IsLocalRing.IsHenselization.map_maximalIdeal (L := κ)) hA
  let _ : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  exact mem_weaklyAssociatedPointsOfSpace_of_etaleLocalRing B S hS X xbar
    (isWeaklyAssociatedPrime_maximalIdeal_of_ringEquiv
      (strictHenselizationEquivEtaleLocalRing X.2 V (bigEtaleSiteOfFppfSite B) hE T) h2)

/-- The point of an algebraic space under the chart point of a field-valued point of an étale
scheme chart is the class of that field-valued point. -/
private theorem chartSchemeToPoints_schemePoint (X : AlgebraicSpaces B S hS)
    (U : SmallEtale B S hS X.1)
    (pq : FieldValuedPoint B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U))) :
    chartSchemeToPoints B S hS X.1 U
        (schemePoint B S hS ((SmallEtale.toOver B S hS X.1).obj U) pq) =
      pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.obj.hom
        (pq.class B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U))) := by
  rw [chartSchemeToPoints_eq_pointsMap, canonicalSiteFieldPoint_class_eq B S hS _ pq
    (schemePoint B S hS ((SmallEtale.toOver B S hS X.1).obj U) pq) rfl]

/-- **A weakly associated point of an étale scheme chart is a weakly associated point of the
algebraic space.** The point of the chart carries a geometric point of the space above it, and
the étale local ring there is the strict henselization of the local ring of the chart. -/
theorem mem_weaklyAssociatedPointsOfSpace_chartSchemeToPoints (X : AlgebraicSpaces B S hS)
    (U : SmallEtale B S hS X.1) (u : chartScheme U)
    (hu : u ∈ Stacks.Divisors.schemeWeaklyAssociatedPoints (chartScheme U)) :
    chartSchemeToPoints B S hS X.1 U u ∈ weaklyAssociatedPointsOfSpace B S hS X := by
  obtain ⟨xbar, q, hq, hqu⟩ := exists_geometricPoint_chartLift B S hS X.2 U u
  have hupq : u = schemePoint B S hS ((SmallEtale.toOver B S hS X.1).obj U)
      ⟨xbar.val.carrier, xbar.val.contained, xbar.val.toBase, q⟩ := hqu.symm
  subst hupq
  rw [chartSchemeToPoints_schemePoint]
  have hcl : pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.obj.hom
      ((FieldValuedPoint.mk xbar.val.carrier xbar.val.contained xbar.val.toBase
        q).class B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U))) = xbar.image :=
    (FieldValuedPoint.class_eq_class_iff B S hS X.1 _ _).mpr
      ⟨xbar.val, ⟨𝟙 _, by
        show X.1.map (𝟙 _).op (U.obj.hom.app (Opposite.op xbar.val.siteObject) q) =
          xbar.val.value
        simpa using hq⟩, FieldValuedPoint.dominates_refl B S hS X.1 xbar.val⟩
  rw [hcl]
  refine mem_weaklyAssociatedPointsOfSpace_of_chartStalk B S hS X xbar ⟨U, q, hq⟩ ?_
  exact (LinearEquiv.isWeaklyAssociatedPrime_iff
    (AlgebraicGeometry.structureSheafStalkLinearEquiv (chartScheme U)
      (schemePoint B S hS ((SmallEtale.toOver B S hS X.1).obj U)
        ⟨xbar.val.carrier, xbar.val.contained, xbar.val.toBase, q⟩))
    (IsLocalRing.maximalIdeal _)).mp hu

/-! ### The pullback along a morphism avoiding the weakly associated points -/

/-- **Stacks 083Z (1).** The pullback of an effective Cartier divisor `D ⊆ Y` along a morphism
`f : X ⟶ Y` of algebraic spaces is defined as soon as `f` carries no weakly associated point of
`X` into `|D|`.

A surjective étale scheme chart `q : V ⟶ Y` lifts to a surjective étale scheme chart
`p : U ⟶ X` over a morphism `α : U ⟶ V` of the site.  By Stacks 083C the inverse image of `D` is
an effective Cartier divisor on `V`, and the ideal sheaf of `f⁻¹(D) ×_X U` is its inverse image
along `α`; the scheme case Stacks 02OO (1) therefore applies, because a weakly associated point
of `U` lying over `|D ×_Y V|` would be a weakly associated point of `X` carried into `|D|`.
Stacks 083C then returns the conclusion on `X`. -/
@[stacks 083Z "part (1): no weakly associated point of the source is carried into the divisor"]
theorem isPullbackDefined_of_notMem_weaklyAssociatedPoints {X Y : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (D : ClosedSubspaces B S hS Y.1)
    (hD : IsEffectiveCartierDivisor B S hS Y D)
    (hf : ∀ x ∈ weaklyAssociatedPointsOfSpace B S hS X,
      pointsMap B S hS X.1 f.hom x ∉
        Set.range (pointsMap B S hS D.1.toFunctor D.1.ι)) :
    IsPullbackDefined B S hS f D := by
  obtain ⟨V, q, hqSurj, hqEtale⟩ := Y.2.exists_atlas
  obtain ⟨U, p, α, hcomm, hpSurj, hpEtale⟩ :=
    exists_surjective_etale_presentation_lift B S hS X.2 Y.2 f.hom V q hqSurj hqEtale
  set D' : ClosedSubspaces B S hS X.1 :=
    ⟨D.1.preimage f.hom,
      isClosedSubspace_preimage B S hS f.hom D.1 Y.2 X.2 D.2⟩ with hD'def
  have hD'1 : D'.1 = D.1.preimage f.hom := by rw [hD'def]
  have hpre : D'.1.preimage p = D.1.preimage (yoneda.map α ≫ q) := by
    rw [hD'1, ← Subfunctor.preimage_comp, hcomm]
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd (yoneda.map α ≫ q))) :=
    D.2.2.property_snd (yoneda.map α ≫ q)
  have hker : ((BigFppfOver.toScheme B S hS).map (D'.2.2.rep.snd p)).ker =
      (((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd q)).ker).comap
        ((BigFppfOver.toScheme B S hS).map α) := by
    rw [← schemeKer_snd_comp B S hS D q α]
    refine ker_rep_snd_eq_ker_of_range_eq B S hS X D' U _ p
      (D.2.2.rep.snd (yoneda.map α ≫ q)) ?_
    rw [hpre]
    exact preimage_eq_range_rep_snd B S hS Y D U (yoneda.map α ≫ q)
  have hci' : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (D'.2.2.rep.snd p)) := D'.2.2.property_snd p
  have hUchart : Stacks.Divisors.IsEffectiveCartierDivisor
      ((BigFppfOver.toScheme B S hS).map (D'.2.2.rep.snd p)).ker := by
    rw [hker]
    refine Stacks.Divisors.isPullbackDefined_of_notMem_support_of_weaklyAssociated
      ((BigFppfOver.toScheme B S hS).map α) _
      ((isSchemeEffectiveCartierPullback_iff B S hS Y D V q).1
        (hasEffectiveCartierEtalePullbacks_of_isEffectiveCartier B S hS Y D hD V q
          (isEtale_of_presheaf_etale B S hS hqEtale))) ?_
    intro w hw hmem
    have hmem' : w ∈ ((((BigFppfOver.toScheme B S hS).map
        (D'.2.2.rep.snd p)).ker).support : Set ((BigFppfOver.toScheme B S hS).obj U)) := by
      rw [hker, Scheme.IdealSheafData.support_comap]
      exact hmem
    rw [Scheme.Hom.support_ker] at hmem'
    rw [((BigFppfOver.toScheme B S hS).map
      (D'.2.2.rep.snd p)).isClosedEmbedding.isClosed_range.closure_eq] at hmem'
    obtain ⟨w₀, hw₀⟩ := hmem'
    set Û : SmallEtale B S hS X.1 := ⟨CostructuredArrow.mk p, hpEtale⟩ with hÛdef
    refine hf _ (mem_weaklyAssociatedPointsOfSpace_chartSchemeToPoints B S hS X Û w hw) ?_
    set y : points B S hS (yoneda.obj (D'.2.2.rep.pullback p)) :=
      (pointsEquivScheme B S hS (D'.2.2.rep.pullback p)).symm w₀ with hydef
    have hc : chartSchemeToPoints B S hS X.1 Û w =
        pointsMap B S hS (yoneda.obj U) p
          (pointsMap B S hS _ (yoneda.map (D'.2.2.rep.snd p)) y) := by
      rw [chartSchemeToPoints_eq_pointsMap_pointsEquivScheme_symm]
      congr 1
      refine (pointsEquivScheme B S hS U).symm_apply_eq.mpr ?_
      show w = pointsToScheme B S hS U _
      rw [pointsToScheme_pointsMap_yoneda, hydef]
      show w = (BigFppfOver.toScheme B S hS).map (D'.2.2.rep.snd p)
        ((pointsEquivScheme B S hS (D'.2.2.rep.pullback p))
          ((pointsEquivScheme B S hS (D'.2.2.rep.pullback p)).symm w₀))
      rw [Equiv.apply_symm_apply]
      exact hw₀.symm
    have hwsq : D'.2.2.rep.fst p ≫ (D.1.preimage f.hom).ι =
        yoneda.map (D'.2.2.rep.snd p) ≫ p := D'.2.2.rep.w p
    have key : pointsMap B S hS X.1 f.hom (chartSchemeToPoints B S hS X.1 Û w) =
        pointsMap B S hS D.1.toFunctor D.1.ι
          (pointsMap B S hS _ (D.1.fromPreimage f.hom)
            (pointsMap B S hS _ (D'.2.2.rep.fst p) y)) := by
      rw [hc, ← pointsMap_comp_apply, ← pointsMap_comp_apply, ← pointsMap_comp_apply,
        ← pointsMap_comp_apply]
      congr 1
      rw [Subfunctor.fromPreimage_ι, ← Category.assoc, ← hwsq, Category.assoc]
    rw [key]
    exact Set.mem_range_self _
  refine isEffectiveCartierDivisor_of_hasEffectiveCartierEtaleCover B S hS X D'
    ⟨U, p, isEtale_of_presheaf_etale B S hS hpEtale,
      (presheafSurjective_iff_isSurjective_yoneda B S hS X.1 X.2 U p).1 hpSurj, ?_⟩
  exact (isSchemeEffectiveCartierPullback_iff B S hS X D' U p).2 hUchart

end AlgebraicGeometry.Space

