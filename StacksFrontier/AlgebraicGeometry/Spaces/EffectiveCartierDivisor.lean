@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A closed subspace `Z` of an algebraic space `X` is *locally principal* when its defining ideal
sheaf `𝓘_Z ⊆ 𝒪_X` is locally generated by one section on the small étale site of `X`. -/
@[stacks 083B "locally_principal_closed_subspace"]
noncomputable abbrev IsLocallyPrincipal (X : AlgebraicSpaces B S hS)
    (Z : ClosedSubspaces B S hS X.1) : Prop :=
  _root_.SheafOfModules.IsLocallyGeneratedByOnSite
    (definingIdealSheaf B S hS X Z).toSheafOfModules 1

/-- A closed subspace `D` of an algebraic space `X` is an *effective Cartier divisor* when its
defining ideal sheaf `𝓘_D ⊆ 𝒪_X` is an invertible `𝒪_X`-module on the small étale site of `X`. -/
@[stacks 083B "effective_cartier_divisor"]
noncomputable abbrev IsEffectiveCartierDivisor (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) : Prop :=
  AlgebraicGeometry.SheafOfModules.IsInvertible
    (smallEtaleRingedSite B S hS X.1 X.2).O.obj
    (structureRingSheaf B S hS X).property
    (definingIdealSheaf B S hS X D).toSheafOfModules

/-- The *pullback of a closed subspace `D ⊆ X` along a morphism `f : Y ⟶ X` of algebraic spaces is
defined* when the inverse image `f⁻¹(D) ⊆ Y` is an effective Cartier divisor; in that case
`f^*D = f⁻¹(D)` is the *pullback of the effective Cartier divisor*. -/
@[stacks 083Y]
noncomputable abbrev IsPullbackDefined {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (D : ClosedSubspaces B S hS X.1) : Prop :=
  IsEffectiveCartierDivisor B S hS Y
    ⟨D.1.preimage f.hom, isClosedSubspace_preimage B S hS f.hom D.1 X.2 Y.2 D.2⟩

/-- A closed subspace `D ⊆ X` is a *relative effective Cartier divisor* on `X` over `Y`, for a
morphism `f : X ⟶ Y` of algebraic spaces, when `D` is an effective Cartier divisor on `X` and the
structure morphism `D ⟶ Y` is flat. -/
@[stacks 0EPP]
noncomputable abbrev IsRelativeEffectiveCartierDivisor {X Y : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (D : ClosedSubspaces B S hS X.1) : Prop :=
  IsEffectiveCartierDivisor B S hS X D ∧ IsFlat B S hS (D.1.ι ≫ f.hom)

/-! ### The invertible sheaf associated to an effective Cartier divisor -/

section AssociatedInvertibleSheaf

open Stacks.PresheafOfModules.TensorInternalHom
open Stacks.SheafOfModules.Invertible
open Stacks.SheafOfModules.TensorSheafification

variable (X : AlgebraicSpaces B S hS)

/-- The structure sheaf of `X` as a presheaf of commutative rings on its small étale site. -/
noncomputable abbrev structureCommRings : (SmallEtale B S hS X.1)ᵒᵖ ⥤ CommRingCat.{u} :=
  (smallEtaleRingedSite B S hS X.1 X.2).O.obj

/-- The underlying presheaf of an `𝒪_X`-module, indexed by the presheaf of commutative rings
of the small étale site. -/
noncomputable abbrev modulePresheaf (M : SheafOfModules.{u} (structureRingSheaf B S hS X)) :
    PresheafOfModules.{u} (Oforget (structureCommRings B S hS X)) :=
  valPresheaf (structureCommRings B S hS X) (structureRingSheaf B S hS X).property M

/-- The defining ideal sheaf `𝓘_Z ⊆ 𝒪_X` of a closed subspace, as a sheaf of
`𝒪_X`-modules. -/
noncomputable abbrev idealSheafOfModules (Z : ClosedSubspaces B S hS X.1) :
    SheafOfModules.{u} (structureRingSheaf B S hS X) :=
  (definingIdealSheaf B S hS X Z).toSheafOfModules

/-- The *invertible sheaf `𝒪_X(D)` associated to an effective Cartier divisor* `D ⊆ X`: the
inverse tensor power `𝓘_D^{⊗ -1}` of its defining ideal sheaf. -/
@[stacks 0841 "part (1): the associated invertible sheaf"]
noncomputable def associatedInvertibleSheaf (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    SheafOfModules.{u} (structureRingSheaf B S hS X) :=
  haveI : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D) := hD
  tensorPower (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
    (idealSheafOfModules B S hS X D) (-1)

/-- An effective Cartier divisor has an invertible defining ideal sheaf, as an instance. -/
private theorem isInvertible_idealSheafOfModules {D : ClosedSubspaces B S hS X.1}
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D) := hD

/-- The sheaf `𝒪_X(D)` associated to an effective Cartier divisor is invertible. -/
@[stacks 0841 "part (1): the associated invertible sheaf"]
theorem associatedInvertibleSheaf_isInvertible (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property
      (associatedInvertibleSheaf B S hS X D hD) :=
  have := isInvertible_idealSheafOfModules B S hS X hD
  tensorPower_isInvertible (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
    (idealSheafOfModules B S hS X D) (-1)

/-- The sheaf-hom `SheafHom_{𝒪_X}(𝓘_D, 𝒪_X)`, the second description of `𝒪_X(D)`. Its sections over
an étale chart `U` are the morphisms `𝓘_D|_U ⟶ 𝒪_X|_U` of `𝒪_X|_U`-modules on the slice site over
`U`, hence live one universe above the sections of the structure sheaf. -/
@[stacks 0841 "part (1): the associated invertible sheaf"]
noncomputable def idealSheafHom (Z : ClosedSubspaces B S hS X.1) :
    SheafOfModules.{u + 1} (structureRingSheaf B S hS X) where
  val := internalHom (structureCommRings B S hS X)
    (modulePresheaf B S hS X (idealSheafOfModules B S hS X Z))
    (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X)))
  isSheaf := internalHom_isSheaf (structureCommRings B S hS X)
    (modulePresheaf B S hS X (idealSheafOfModules B S hS X Z))
    (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X)))
    (SheafOfModules.unit (structureRingSheaf B S hS X)).isSheaf

/-- The evaluation pairing `𝒪_X(D) ⊗_{𝒪_X} 𝓘_D ⟶ 𝒪_X`, as an isomorphism of `𝒪_X`-modules:
the successor comparison of the tensor powers of `𝓘_D` in degree `-1`. -/
noncomputable def associatedInvertibleSheafEvaluation (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
      ⟨(structureCommRings B S hS X), Presheaf.isSheaf_of_isSheaf_comp _
        ((structureCommRings B S hS X)) (forget₂ CommRingCat RingCat)
        ((structureRingSheaf B S hS X).property)⟩).obj
          ((associatedInvertibleSheaf B S hS X D hD))).obj ((idealSheafOfModules B S hS X D))) ≅
      SheafOfModules.unit (structureRingSheaf B S hS X) :=
  haveI : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D) := hD
  tensorPowerSuccIso (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
    (idealSheafOfModules B S hS X D) (-1)

/-- The two descriptions of `𝒪_X(D)` agree: a section of `𝓘_D^{⊗ -1}` over an étale chart `U`
is the same thing as a morphism `𝓘_D|_U ⟶ 𝒪_X|_U`, by a linear equivalence of sections. -/
@[stacks 0841 "part (1): the associated invertible sheaf"]
noncomputable def associatedInvertibleSheafHomEquiv (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) (U : SmallEtale B S hS X.1) :
    (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj (Opposite.op U)
        ≃ₗ[(structureCommRings B S hS X).obj (Opposite.op U)]
      internalHomObj (structureCommRings B S hS X)
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
        (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) U :=
  haveI : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D) := hD
  tensorCurryLinearEquiv (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
    (idealSheafOfModules B S hS X D) (associatedInvertibleSheaf B S hS X D hD)
    (SheafOfModules.unit (structureRingSheaf B S hS X))
    (associatedInvertibleSheafEvaluation B S hS X D hD) U

/-- The identification of the two descriptions of `𝒪_X(D)` commutes with restriction. -/
theorem associatedInvertibleSheafHomEquiv_natural (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) {U V : (SmallEtale B S hS X.1)ᵒᵖ} (f : U ⟶ V)
    (s : (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).obj U) :
    associatedInvertibleSheafHomEquiv B S hS X D hD V.unop
        ((modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD)).map f s) =
      (internalHom (structureCommRings B S hS X)
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
        (modulePresheaf B S hS X
          (SheafOfModules.unit (structureRingSheaf B S hS X)))).map f
        (associatedInvertibleSheafHomEquiv B S hS X D hD U.unop s) :=
  have := isInvertible_idealSheafOfModules B S hS X hD
  tensorCurryLinearEquiv_natural (structureCommRings B S hS X)
    (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D)
    (associatedInvertibleSheaf B S hS X D hD)
    (SheafOfModules.unit (structureRingSheaf B S hS X))
    (associatedInvertibleSheafEvaluation B S hS X D hD) f s

/-- The identification of the two descriptions of `𝒪_X(D)` is given by the evaluation pairing: the
morphism `𝓘_D|_U ⟶ 𝒪_X|_U` attached to a section `s` of `𝓘_D^{⊗ -1}` over `U` sends a section `t`
of `𝓘_D` over an étale chart `V` over `U` to the value of the evaluation pairing on the restriction
of `s` tensored with `t`. -/
@[stacks 0841 "part (1): the associated invertible sheaf"]
theorem associatedInvertibleSheafHomEquiv_apply (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) (U : SmallEtale B S hS X.1)
    (s : (modulePresheaf B S hS X
      (associatedInvertibleSheaf B S hS X D hD)).obj (Opposite.op U))
    (V : (SmallEtale B S hS X.1)ᵒᵖ) (f : V.unop ⟶ U)
    (t : (modulePresheaf B S hS X (idealSheafOfModules B S hS X D)).obj V) :
    homSectionCoeff (structureCommRings B S hS X)
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
        (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) U
        (associatedInvertibleSheafHomEquiv B S hS X D hD U s) V f t =
      tensorHomAt (structureCommRings B S hS X)
        (modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD))
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X D))
        (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X)))
        (tensorPairing (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
          (idealSheafOfModules B S hS X D) (associatedInvertibleSheaf B S hS X D hD)
          (SheafOfModules.unit (structureRingSheaf B S hS X))
          (associatedInvertibleSheafEvaluation B S hS X D hD)) V
        ((modulePresheaf B S hS X
          (associatedInvertibleSheaf B S hS X D hD)).restrictₛₗ f.op s ⊗ₜ t) :=
  have := isInvertible_idealSheafOfModules B S hS X hD
  tensorCurryLinearEquiv_apply (structureCommRings B S hS X)
    (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D)
    (associatedInvertibleSheaf B S hS X D hD)
    (SheafOfModules.unit (structureRingSheaf B S hS X))
    (associatedInvertibleSheafEvaluation B S hS X D hD) U s V f t

/-! ### The canonical section -/

/-- The inclusion `𝓘_Z ⟶ 𝒪_X` of the defining ideal sheaf, read as a section of
`SheafHom_{𝒪_X}(𝓘_Z, 𝒪_X)` over an étale chart. -/
noncomputable def idealInclusionSection (Z : ClosedSubspaces B S hS X.1)
    (U : (SmallEtale B S hS X.1)ᵒᵖ) :
    internalHomObj (structureCommRings B S hS X)
      (modulePresheaf B S hS X (idealSheafOfModules B S hS X Z))
      (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) U.unop :=
  (restrFun (structureCommRings B S hS X) U.unop).map
    (valPresheafMap (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
      (definingIdealSheaf B S hS X Z).ι)

/-- The sections of `SheafHom_{𝒪_X}(𝓘_Z, 𝒪_X)` cut out by the inclusion `𝓘_Z ⟶ 𝒪_X` on the
étale charts form a compatible family. -/
theorem internalHom_map_idealInclusionSection (Z : ClosedSubspaces B S hS X.1)
    {U V : (SmallEtale B S hS X.1)ᵒᵖ} (f : U ⟶ V) :
    (internalHom (structureCommRings B S hS X)
        (modulePresheaf B S hS X (idealSheafOfModules B S hS X Z))
        (modulePresheaf B S hS X
          (SheafOfModules.unit (structureRingSheaf B S hS X)))).map f
        (idealInclusionSection B S hS X Z U) =
      idealInclusionSection B S hS X Z V :=
  internalHom_map_restrFun_map (structureCommRings B S hS X)
    (modulePresheaf B S hS X (idealSheafOfModules B S hS X Z))
    (modulePresheaf B S hS X (SheafOfModules.unit (structureRingSheaf B S hS X))) f
    (valPresheafMap (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
      (definingIdealSheaf B S hS X Z).ι)

/-- The *canonical section* `1_D` of `𝒪_X(D)`: the global section corresponding, under the
identification of `𝒪_X(D)` with `SheafHom_{𝒪_X}(𝓘_D, 𝒪_X)`, to the inclusion `𝓘_D ⟶ 𝒪_X`. -/
@[stacks 0841 "part (2): the canonical section"]
noncomputable def canonicalSection (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    (associatedInvertibleSheaf B S hS X D hD).sections :=
  PresheafOfModules.sectionsMk
    (M := modulePresheaf B S hS X (associatedInvertibleSheaf B S hS X D hD))
    (fun U ↦ (associatedInvertibleSheafHomEquiv B S hS X D hD U.unop).symm
      (idealInclusionSection B S hS X D U))
    (fun {U V} f ↦ by
      refine (associatedInvertibleSheafHomEquiv B S hS X D hD V.unop).injective ?_
      rw [associatedInvertibleSheafHomEquiv_natural, LinearEquiv.apply_symm_apply,
        LinearEquiv.apply_symm_apply]
      exact internalHom_map_idealInclusionSection B S hS X D f)

/-- The canonical section of `𝒪_X(D)` is, on every étale chart, the inclusion `𝓘_D ⟶ 𝒪_X` read
through the identification of `𝒪_X(D)` with `SheafHom_{𝒪_X}(𝓘_D, 𝒪_X)`. -/
@[stacks 0841 "part (2): the canonical section"]
theorem canonicalSection_apply (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) (U : (SmallEtale B S hS X.1)ᵒᵖ) :
    associatedInvertibleSheafHomEquiv B S hS X D hD U.unop
        ((canonicalSection B S hS X D hD).val U) =
      idealInclusionSection B S hS X D U :=
  (associatedInvertibleSheafHomEquiv B S hS X D hD U.unop).apply_symm_apply _

/-! ### The negative of a divisor, and the difference of two divisors -/

/-- The sheaf `𝒪_X(-D) = 𝒪_X(D)^{⊗ -1}`. -/
@[stacks 0841 "part (3): the negative of a divisor"]
noncomputable def negativeDivisorSheaf (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    SheafOfModules.{u} (structureRingSheaf B S hS X) :=
  haveI : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (associatedInvertibleSheaf B S hS X D hD) :=
    associatedInvertibleSheaf_isInvertible B S hS X D hD
  tensorPower (structureCommRings B S hS X) (structureRingSheaf B S hS X).property
    (associatedInvertibleSheaf B S hS X D hD) (-1)

/-- The identification `𝒪_X(-D) ≅ 𝓘_D`. -/
@[stacks 0841 "part (3): the negative of a divisor"]
noncomputable def negativeDivisorSheafIso (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    negativeDivisorSheaf B S hS X D hD ≅ idealSheafOfModules B S hS X D := by
  haveI : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (idealSheafOfModules B S hS X D) := hD
  haveI : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property (associatedInvertibleSheaf B S hS X D hD) :=
    associatedInvertibleSheaf_isInvertible B S hS X D hD
  set O := structureCommRings B S hS X
  set hO := (structureRingSheaf B S hS X).property
  set G := idealSheafOfModules B S hS X D
  set M := associatedInvertibleSheaf B S hS X D hD
  set N := negativeDivisorSheaf B S hS X D hD
  have eM : (((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
      ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ (O) (forget₂ CommRingCat RingCat) (hO)⟩).obj
        (M)).obj (G)) ≅ SheafOfModules.unit (structureRingSheaf B S hS X) :=
    tensorPowerSuccIso O hO G (-1)
  have eN : (((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
      ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ (O) (forget₂ CommRingCat RingCat) (hO)⟩).obj
        (N)).obj (M)) ≅ SheafOfModules.unit (structureRingSheaf B S hS X) :=
    tensorPowerSuccIso O hO M (-1)
  exact (tensorProductRightUnitor O hO N).symm ≪≫
    tensorProductIso O hO (Iso.refl N) eM.symm ≪≫
    (tensorProductAssociator O hO N M G).symm ≪≫
    tensorProductIso O hO eN (Iso.refl G) ≪≫
    tensorProductLeftUnitor O hO G

/-- The sheaf `𝒪_X(D - D') = 𝒪_X(D) ⊗_{𝒪_X} 𝒪_X(-D')` attached to a pair of effective Cartier
divisors. -/
@[stacks 0841 "part (4): the difference of two divisors"]
noncomputable def differenceDivisorSheaf (D D' : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D)
    (hD' : IsEffectiveCartierDivisor B S hS X D') :
    SheafOfModules.{u} (structureRingSheaf B S hS X) :=
  (((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
    ⟨(structureCommRings B S hS X), Presheaf.isSheaf_of_isSheaf_comp _
      ((structureCommRings B S hS X)) (forget₂ CommRingCat RingCat)
      ((structureRingSheaf B S hS X).property)⟩).obj
        ((associatedInvertibleSheaf B S hS X D hD))).obj ((negativeDivisorSheaf B S hS X D' hD')))

end AssociatedInvertibleSheaf

end AlgebraicGeometry.Space

end
