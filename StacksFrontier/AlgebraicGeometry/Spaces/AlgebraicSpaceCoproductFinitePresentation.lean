-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe v u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Local finite presentation is Zariski local on the source -/

/-- A point of a space with a Zariski covering lies in the point set of some member. -/
private theorem exists_mem_range_pointsMap_of_isZariskiCover
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    {I : Type u} {W : I → Subfunctor X} (hW : IsZariskiCover B S hS I W) (x : points B S hS X) :
    ∃ i, x ∈ Set.range (pointsMap B S hS (W i).toFunctor (W i).ι) := by
  have hx : x ∈ ⋃ i, Set.range (pointsMap B S hS (W i).toFunctor (W i).ι) := by
    rw [(isZariskiCover_iff_iUnion_points B S hS X hX I W hW.1).mp hW]
    exact Set.mem_univ x
  exact Set.mem_iUnion.mp hx

/-- A colimit cofan indexed by a `u`-small type is still one after reindexing along
`Shrink.{u}`. -/
private def isColimitCofanMkShrink {C : Type*} [Category C] {I : Type v} [Small.{u} I]
    {F : I → C} {P : C} (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι)) :
    IsColimit (Cofan.mk P fun j : Shrink.{u} I ↦ ι ((equivShrink I).symm j)) :=
  Cofan.isColimitEquivOfEquiv (equivShrink I).symm (Cofan.mk P ι) hP

/-- **Being locally of finite presentation is Zariski local on the source.**  If the source of a
morphism of algebraic spaces over `S` carries a Zariski covering by open subspaces on each of
which the morphism restricts to one which is locally of finite presentation, then the morphism
is locally of finite presentation.

This is conditions (1) and (2) of Stacks 0410: a point of the source lies in some member of the
covering, which is then the open neighbourhood required by
`AlgebraicGeometry.Space.IsFinitePresentationAt`. -/
theorem isLocallyOfFinitePresentation_of_isZariskiCover
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    {I : Type u} {W : I → Subfunctor X} (hW : IsZariskiCover B S hS I W)
    (hf : ∀ i, IsLocallyOfFinitePresentation B S hS ((W i).ι ≫ f)) :
    IsLocallyOfFinitePresentation B S hS f := by
  refine (isLocallyOfFinitePresentation_iff_forall_isFinitePresentationAt B S hS hX hY f).2
    fun x ↦ ?_
  obtain ⟨i, hi⟩ := exists_mem_range_pointsMap_of_isZariskiCover B S hS hX hW x
  exact ⟨W i, hW.1 i, hi, hf i⟩

/-- **A morphism out of a coproduct is locally of finite presentation as soon as its
restrictions are.**  Let a sheaf `P` on the big fppf site over `S` be the coproduct of a family
of algebraic spaces over `S` with legs `ι i`, and let `f` be a morphism from `P` to an
algebraic space over `S`.  If each `ι i ≫ f` is locally of finite presentation then so is `f`.

The ranges of the legs are a Zariski covering of `P`, and a leg is an isomorphism onto its
range because it is a monomorphism; an isomorphism is étale, hence locally of finite
presentation, so the hypothesis transfers from the leg to the inclusion of its range. -/
theorem isLocallyOfFinitePresentation_of_isColimit_cofan {I : Type v} [Small.{u} I]
    {F : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
    {P : Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (hF : ∀ i, IsAlgebraicSpace B S hS (F i).obj)
    (hPalg : IsAlgebraicSpace B S hS P.obj)
    {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hY : IsAlgebraicSpace B S hS Y) (f : P.obj ⟶ Y)
    (hf : ∀ i, IsLocallyOfFinitePresentation B S hS ((ι i).hom ≫ f)) :
    IsLocallyOfFinitePresentation B S hS f := by
  classical
  let e : Shrink.{u} I ≃ I := (equivShrink I).symm
  let ι' : ∀ j : Shrink.{u} I, F (e j) ⟶ P := fun j ↦ ι (e j)
  have hP' : IsColimit (Cofan.mk P ι') := isColimitCofanMkShrink ι hP
  let W : Shrink.{u} I → Subfunctor P.obj := fun j ↦ Subfunctor.range (ι' j).hom
  refine isLocallyOfFinitePresentation_of_isZariskiCover B S hS hPalg hY f
    (W := W) (isZariskiCover_range_cofan_inj ι' hP' fun j ↦ hF (e j)) fun j ↦ ?_
  have hmono : Mono (ι' j).hom := AlgebraicGeometry.Sheaf.mono_hom_cofan_inj ι' hP' j
  let d : (F (e j)).obj ⟶ (W j).toFunctor := Subfunctor.toRange (ι' j).hom
  have hd : IsIso d := inferInstance
  have hinv : CategoryTheory.inv d ≫ (ι' j).hom = (W j).ι := by
    rw [← Subfunctor.toRange_ι (ι' j).hom, IsIso.inv_hom_id_assoc]
  have hcomp := isLocallyOfFinitePresentation_comp B S hS
    (isOpenSubspace_range_cofan_inj ι' hP' j (hF (e j))).1 (hF (e j)) hY
    (CategoryTheory.inv d) ((ι' j).hom ≫ f)
    (isLocallyOfFinitePresentation_of_isEtale B S hS
      (isEtale_of_isIso B S hS (CategoryTheory.inv d))) (hf (e j))
  rwa [← Category.assoc, hinv] at hcomp

/-! ### Emptiness of a fibre product -/

/-- **A fibre product of presheaves has no points when the point set of its second factor misses
the image of the point set of its first.**  The two projections carry a point of the fibre
product to points with the same image, by functoriality of the point comparison of clause (2) of
Stacks 03BX applied to the cartesian square. -/
theorem isEmpty_points_pullback_of_preimage_range_eq_empty
    {Z F Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (g : Z ⟶ Y) (h : F ⟶ Y) [HasPullback g h]
    (hempty : pointsMap B S hS Z g ⁻¹' Set.range (pointsMap B S hS F h) = ∅) :
    IsEmpty (points B S hS (pullback g h)) := by
  refine ⟨fun p ↦ ?_⟩
  have key : pointsMap B S hS Z g ∘ pointsMap B S hS (pullback g h) (pullback.fst g h) =
      pointsMap B S hS F h ∘ pointsMap B S hS (pullback g h) (pullback.snd g h) := by
    rw [← pointsMap_comp, ← pointsMap_comp, pullback.condition]
  refine Set.eq_empty_iff_forall_notMem.1 hempty
    (pointsMap B S hS (pullback g h) (pullback.fst g h) p) ?_
  exact ⟨pointsMap B S hS (pullback g h) (pullback.snd g h) p, (congrFun key p).symm⟩

/-! ### Quasi-compactness of a morphism out of a coproduct -/

/-- Pullbacks of fppf sheaves of sets, found once: instance search for them times out inside the
proof below. -/
instance (priority := high) hasPullbacks_sheaf_AlgebraicSpaceCoproductFinitePresentation :
    HasPullbacks (Sheaf (BigFppfOver.topology B S hS) (Type u)) := by
  set_option synthInstance.maxHeartbeats 400000 in infer_instance

/-- The pullback of two morphisms of fppf sheaves of sets, given directly so that instance search
does not time out looking for it. -/
instance (priority := high) hasLimit_cospan_sheaf_AlgebraicSpaceCoproductFinitePresentation
    {X Y Z : Sheaf (BigFppfOver.topology B S hS) (Type u)} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

/-- **A morphism out of a coproduct of algebraic spaces over `S` is quasi-compact when its
restrictions to the summands are and, over every affine test object of the site, all but
finitely many of their base changes have no points.**

The extra hypothesis cannot be dropped: an infinite coproduct of quasi-compact morphisms need
not be quasi-compact.  For a finite index type it is vacuous, and the statement is
`AlgebraicGeometry.Space.isQuasiCompact_of_isColimit_cofan`.

The base change of `P` along the test morphism is the coproduct of the base changes of the
summands by `AlgebraicGeometry.Space.isColimitCofanMkPullback`; the ranges of the legs of that
coproduct are a Zariski covering, hence cover its points, and the summands outside the finite
set contribute no points, so the finitely many remaining ones are jointly surjective on
points. -/
theorem isQuasiCompact_of_isColimit_cofan_of_cofinitely_isEmpty {I : Type v} [Small.{u} I]
    {F : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
    {P : Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (hF : ∀ i, IsAlgebraicSpace B S hS (F i).obj)
    (hPalg : IsAlgebraicSpace B S hS P.obj)
    {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hY : IsAlgebraicSpace B S hS Y) (f : P.obj ⟶ Y)
    (hf : ∀ i, IsQuasiCompact B S hS ((ι i).hom ≫ f))
    (hcof : ∀ T : BigFppfOver B S hS, IsAffine ((BigFppfOver.toScheme B S hS).obj T) →
      ∀ g : yoneda.obj T ⟶ Y, ∃ J : Set I, J.Finite ∧
        ∀ i ∉ J, IsEmpty (points B S hS (pullback g ((ι i).hom ≫ f)))) :
    IsQuasiCompact B S hS f := by
  classical
  refine isQuasiCompact_of_isQuasiCompactSpace_pullback_affine B S hS hPalg hY f
    fun T hT g ↦ ?_
  have hZ : IsAlgebraicSpace B S hS (yoneda.obj T) := isAlgebraicSpace_yoneda B S hS T
  have hZqc : IsQuasiCompactSpace B S hS (yoneda.obj T) :=
    isQuasiCompactSpace_yoneda_of_isAffine B S hS T hT
  obtain ⟨J, hJfin, hJ⟩ := hcof T hT g
  have := hJfin.to_subtype
  let gs : (⟨yoneda.obj T, hZ.isSheaf⟩ : Sheaf (BigFppfOver.topology B S hS) (Type u)) ⟶
    ⟨Y, hY.isSheaf⟩ := ⟨g⟩
  let fs : P ⟶ (⟨Y, hY.isSheaf⟩ : Sheaf (BigFppfOver.topology B S hS) (Type u)) := ⟨f⟩
  let t : pullback gs fs ⟶ P := pullback.snd gs fs
  have hsq : IsPullback (pullback.fst gs fs).hom t.hom g f :=
    isPullback_hom_of_sheaf (IsPullback.of_hasPullback gs fs)
  have eA : pullback g f ≅ (pullback gs fs).obj :=
    (IsPullback.of_hasPullback g f).isoIsPullback _ _ hsq
  have hpaste : ∀ i, IsPullback ((pullback.snd (ι i) t).hom ≫ (pullback.fst gs fs).hom)
      (pullback.fst (ι i) t).hom g ((ι i).hom ≫ f) := fun i ↦
    (isPullback_hom_of_sheaf (IsPullback.of_hasPullback (ι i) t)).flip.paste_horiz hsq
  have eP : ∀ i, pullback g ((ι i).hom ≫ f) ≅ (pullback (ι i) t).obj := fun i ↦
    (IsPullback.of_hasPullback g ((ι i).hom ≫ f)).isoIsPullback _ _ (hpaste i)
  have hialg : ∀ i, IsAlgebraicSpace B S hS (pullback (ι i) t).obj := fun i ↦
    (isAlgebraicSpace_pullback B S hS g ((ι i).hom ≫ f) hZ (hF i) hY).of_iso (eP i)
  have hqci : ∀ i, IsQuasiCompactSpace B S hS (pullback (ι i) t).obj := fun i ↦
    IsQuasiCompactSpace.of_iso B S hS (hf i (yoneda.obj T) hZ hZqc g) (eP i)
  have hAalg : IsAlgebraicSpace B S hS (pullback gs fs).obj :=
    (isAlgebraicSpace_pullback B S hS g f hZ hPalg hY).of_iso eA
  -- the base change of the coproduct is the coproduct of the base changes, reindexed in `Type u`
  have hcofan : IsColimit (Cofan.mk (pullback gs fs) fun i ↦ pullback.snd (ι i) t) :=
    isColimitCofanMkPullback B S hS ι hP t
  let e : Shrink.{u} I ≃ I := (equivShrink I).symm
  let leg : ∀ j : Shrink.{u} I, pullback (ι (e j)) t ⟶ pullback gs fs := fun j ↦
    pullback.snd (ι (e j)) t
  have hcofan' : IsColimit (Cofan.mk (pullback gs fs) leg) := isColimitCofanMkShrink _ hcofan
  have hW := isZariskiCover_range_cofan_inj leg hcofan' fun j ↦ hialg (e j)
  refine IsQuasiCompactSpace.of_iso B S hS
    (isQuasiCompactSpace_of_finite_jointly_surjective' B S hS hAalg
      (A := fun i : ↥J ↦ (pullback (ι i.1) t).obj) (fun i ↦ hialg i.1)
      (fun i ↦ (pullback.snd (ι i.1) t).hom) (fun i ↦ hqci i.1) fun w ↦ ?_) eA.symm
  obtain ⟨j, hj⟩ := exists_mem_range_pointsMap_of_isZariskiCover B S hS hAalg hW w
  have : Mono (leg j).hom := AlgebraicGeometry.Sheaf.mono_hom_cofan_inj leg hcofan' j
  rw [range_pointsMap_ι_range] at hj
  have hmem : e j ∈ J := by
    by_contra hnot
    have := hJ (e j) hnot
    have hempty : IsEmpty (points B S hS (pullback (ι (e j)) t).obj) :=
      Function.isEmpty (pointsMap B S hS _ (eP (e j)).inv)
    exact hempty.elim hj.choose
  exact ⟨⟨e j, hmem⟩, hj⟩

/-! ### Separatedness and quasi-separatedness at a `u`-small index type -/

/-- **A morphism out of a coproduct of algebraic spaces over `S` indexed by a `u`-small type is
separated as soon as its restrictions to the summands are.**  This is
`AlgebraicGeometry.Space.isSeparated_of_isColimit_cofan`, whose index type is in `Type u`,
transported along a reindexing of the cofan. -/
theorem isSeparated_of_isColimit_cofan_small {I : Type v} [Small.{u} I]
    {F : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
    {P : Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (hF : ∀ i, IsAlgebraicSpace B S hS (F i).obj)
    (hPalg : IsAlgebraicSpace B S hS P.obj)
    {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hY : IsAlgebraicSpace B S hS Y) (f : P.obj ⟶ Y)
    (hf : ∀ i, IsSeparated B S hS ((ι i).hom ≫ f)) :
    IsSeparated B S hS f := by
  classical
  let e : Shrink.{u} I ≃ I := (equivShrink I).symm
  let ι' : ∀ j : Shrink.{u} I, F (e j) ⟶ P := fun j ↦ ι (e j)
  have hP' : IsColimit (Cofan.mk P ι') := isColimitCofanMkShrink ι hP
  exact isSeparated_of_isColimit_cofan B S hS ι' hP' (fun j ↦ hF (e j)) hPalg hY f
    fun j ↦ hf (e j)

/-- **A morphism out of a coproduct of algebraic spaces over `S` is quasi-separated as soon as
its restrictions to the summands are separated.**  Separatedness implies
quasi-separatedness. -/
theorem isQuasiSeparated_of_isColimit_cofan {I : Type v} [Small.{u} I]
    {F : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
    {P : Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (hF : ∀ i, IsAlgebraicSpace B S hS (F i).obj)
    (hPalg : IsAlgebraicSpace B S hS P.obj)
    {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hY : IsAlgebraicSpace B S hS Y) (f : P.obj ⟶ Y)
    (hf : ∀ i, IsSeparated B S hS ((ι i).hom ≫ f)) :
    IsQuasiSeparated B S hS f :=
  isQuasiSeparated_of_isSeparated B S hS
    (isSeparated_of_isColimit_cofan_small B S hS ι hP hF hPalg hY f hf)

/-! ### Finite presentation -/

/-- **A morphism out of a coproduct of algebraic spaces over `S` is of finite presentation when
its restrictions to the summands are of finite presentation and separated and, over every
affine test object of the site, all but finitely many of their base changes have no points.**

The three clauses of Stacks 03XP part (3) are
`AlgebraicGeometry.Space.isLocallyOfFinitePresentation_of_isColimit_cofan`,
`AlgebraicGeometry.Space.isQuasiCompact_of_isColimit_cofan_of_cofinitely_isEmpty` and
`AlgebraicGeometry.Space.isQuasiSeparated_of_isColimit_cofan`.  Separatedness of the
restrictions is not implied by their finite presentation, so it is a hypothesis; for the
inclusion of a subspace it holds because the inclusion is a monomorphism. -/
theorem isFinitePresentation_of_isColimit_cofan_of_cofinitely_isEmpty {I : Type v} [Small.{u} I]
    {F : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
    {P : Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (hF : ∀ i, IsAlgebraicSpace B S hS (F i).obj)
    (hPalg : IsAlgebraicSpace B S hS P.obj)
    {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hY : IsAlgebraicSpace B S hS Y) (f : P.obj ⟶ Y)
    (hf : ∀ i, IsFinitePresentation B S hS ((ι i).hom ≫ f))
    (hsep : ∀ i, IsSeparated B S hS ((ι i).hom ≫ f))
    (hcof : ∀ T : BigFppfOver B S hS, IsAffine ((BigFppfOver.toScheme B S hS).obj T) →
      ∀ g : yoneda.obj T ⟶ Y, ∃ J : Set I, J.Finite ∧
        ∀ i ∉ J, IsEmpty (points B S hS (pullback g ((ι i).hom ≫ f)))) :
    IsFinitePresentation B S hS f :=
  ⟨isLocallyOfFinitePresentation_of_isColimit_cofan B S hS ι hP hF hPalg hY f
      fun i ↦ (hf i).1,
    isQuasiCompact_of_isColimit_cofan_of_cofinitely_isEmpty B S hS ι hP hF hPalg hY f
      (fun i ↦ (hf i).2.1) hcof,
    isQuasiSeparated_of_isColimit_cofan B S hS ι hP hF hPalg hY f hsep⟩

end AlgebraicGeometry.Space

end
