module

public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentSubquotientNoetherian
public import StacksFrontier.AlgebraicGeometry.Spaces.NoetherianSpaces
public import StacksFrontier.AlgebraicGeometry.Spaces.PointsAndCoverings.SpecialCoverings
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasicoherentEtaleChart
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleAffineRefinement
public import StacksFrontier.AlgebraicGeometry.Spaces.SurjectiveOnPoints
public import StacksFrontier.CategoryTheory.Sites.Modules.LocallyBijective
public import Mathlib.CategoryTheory.Subobject.Lattice

/-!
# Ascending chains of quasi-coherent submodules on a Noetherian algebraic space

An ascending chain of quasi-coherent submodules of a coherent module on a Noetherian algebraic
space eventually stabilizes.

## Main results

* `AlgebraicGeometry.Space.exists_eventually_constant_quasicoherentSubobjects`: **Stacks 07UJ**,
  the ascending chain condition for quasi-coherent subobjects of a coherent `𝒪_F`-module on a
  Noetherian algebraic space `F`.

## Implementation notes

A submodule of `M` is a categorical `CategoryTheory.Subobject`, so that two submodules with the
same sections are equal, exactly as in the scheme case
`AlgebraicGeometry.exists_eventually_constant_quasicoherentSubobjects`.

The chain is tested on a *finite* family of étale charts which are affine with Noetherian ring of
sections `A` and over which `M` is generated by finitely many sections `s₁, …, sₙ`.  Such a family
exists because those charts cover the small étale site
(`AlgebraicGeometry.Space.coversTop_isNoetherianAffineChart_generates`) and because a quasi-compact
algebraic space has an affine surjective étale chart, which is a quasi-compact object of the site
and so is covered by finitely many of them.

Over such a chart the chain becomes an ascending chain of submodules of `Aⁿ`: the coefficient
tuples `x` with `∑ xᵢ sᵢ` a section of the given subobject.  Those stabilize because `Aⁿ` is a
Noetherian module — *no* finiteness of the sections `M(V)` is used, which is what makes the
argument available here.  Once the coefficient tuples agree, the two subobjects have the same
sections over every chart over `V`: a section of the larger one is, locally on affine charts, a
combination of the restricted `sᵢ`, and flat base change
(`AlgebraicGeometry.Space.exists_coeffs_of_mem_range_of_bijective_sectionsBaseChange`) rewrites its
coefficient tuple along a generating family of the coefficient tuples, which lands in the smaller
one.  Agreement over a covering family makes the inclusion locally surjective, hence — being
injective on sections — an isomorphism.

Only quasi-coherence of the members of the chain is used, through
`AlgebraicGeometry.Space.IsCartesianOnAffineCharts`; coherence of each member, which is
Stacks 07UD, is not needed.

The module universe is the universe `u` of the schemes, as it is in
`StacksFrontier.AlgebraicGeometry.Spaces.CoherentSubquotientNoetherian`: that is the universe at
which Descent, Proposition 03DX(2) is available.

## References

* [Stacks Project, Tag 07UJ](https://stacks.math.columbia.edu/tag/07UJ)
* [Stacks Project, Tag 01Y8](https://stacks.math.columbia.edu/tag/01Y8)
* [Stacks Project, Tag 03H6](https://stacks.math.columbia.edu/tag/03H6)
* [Stacks Project, Tag 03EA](https://stacks.math.columbia.edu/tag/03EA)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-! ### Sections of a subobject -/

variable {B S hS F hF}

/-- The arrow of a smaller subobject factors through the arrow of a larger one, on sections. -/
private theorem arrow_apply_ofLE {M : Modules.{u, u} B S hS F hF} {P Q : Subobject M} (h : P ≤ Q)
    (X : (SmallEtale B S hS F)ᵒᵖ) (t : (P : Modules.{u, u} B S hS F hF).val.obj X) :
    Q.arrow.val.app X ((Subobject.ofLE P Q h).val.app X t) = P.arrow.val.app X t :=
  congrArg (fun k : (P : Modules.{u, u} B S hS F hF) ⟶ M =>
    PresheafOfModules.Hom.app k.val X t) (Subobject.ofLE_arrow h)

/-- The sections of a smaller subobject are sections of a larger one. -/
private theorem range_arrow_mono {M : Modules.{u, u} B S hS F hF} {P Q : Subobject M} (h : P ≤ Q)
    (X : (SmallEtale B S hS F)ᵒᵖ) :
    LinearMap.range (P.arrow.val.app X).hom ≤ LinearMap.range (Q.arrow.val.app X).hom := by
  rintro _ ⟨t, rfl⟩
  exact ⟨(Subobject.ofLE P Q h).val.app X t, arrow_apply_ofLE h X t⟩

/-- The arrow of a subobject commutes with restriction to a smaller chart. -/
private theorem arrow_app_chartRestrictLinear {M : Modules.{u, u} B S hS F hF} (P : Subobject M)
    {U V : SmallEtale B S hS F} (f : V ⟶ U) (t : (P : Modules.{u, u} B S hS F hF).val.obj (op U)) :
    P.arrow.val.app (op V) (chartRestrictLinear (P : Modules.{u, u} B S hS F hF) f t) =
      chartRestrictLinear M f (P.arrow.val.app (op U) t) :=
  PresheafOfModules.naturality_apply P.arrow.val f.op t

/-- Restricting a section of a subobject to a smaller chart gives a section of that subobject. -/
private theorem chartRestrictLinear_mem_range {M : Modules.{u, u} B S hS F hF} (P : Subobject M)
    {U V : SmallEtale B S hS F} (f : V ⟶ U) {y : M.val.obj (op U)}
    (hy : y ∈ LinearMap.range (P.arrow.val.app (op U)).hom) :
    chartRestrictLinear M f y ∈ LinearMap.range (P.arrow.val.app (op V)).hom := by
  obtain ⟨t, rfl⟩ := hy
  exact ⟨_, arrow_app_chartRestrictLinear P f t⟩

variable (B S hS F hF)

/-! ### Local surjectivity on the small étale site -/

/-- The sieve of chart morphisms along which a section of the target of a morphism of
`𝒪_F`-modules restricts into the range of that morphism. -/
private noncomputable def liftSieve {M N : Modules.{u, u} B S hS F hF} (ψ : M ⟶ N)
    {X : SmallEtale B S hS F} (x : N.val.obj (op X)) : Sieve X where
  arrows Y g := ∃ t : M.val.obj (op Y), ψ.val.app (op Y) t = chartRestrictLinear N g x
  downward_closed := by
    rintro Y Y' g ⟨t, ht⟩ q
    refine ⟨chartRestrictLinear M q t, ?_⟩
    rw [chartRestrictLinear_comp N g q x, ← ht]
    exact PresheafOfModules.naturality_apply ψ.val q.op t

/-- A morphism of `𝒪_F`-modules whose sections lift on a covering sieve over every chart is
locally surjective. -/
private theorem isLocallySurjective_of_liftSieve_mem {M N : Modules.{u, u} B S hS F hF}
    (ψ : M ⟶ N) (h : ∀ (X : SmallEtale B S hS F) (x : N.val.obj (op X)),
      liftSieve B S hS F hF ψ x ∈ (smallEtaleRingedSite B S hS F hF).J X) :
    PresheafOfModules.IsLocallySurjective (smallEtaleRingedSite B S hS F hF).J ψ.val :=
  ⟨fun {X} x => (smallEtaleRingedSite B S hS F hF).J.superset_covering
    (fun _ _ hg => hg) (h X x)⟩

/-! ### The coefficient tuples of a subobject over a chart -/

/-- The coefficient tuples over an étale chart whose combination of a finite family of sections of
`M` is a section of a given subobject of `M`. -/
private noncomputable def chartCoeffSubmodule {M : Modules.{u, u} B S hS F hF}
    {V : SmallEtale B S hS F} {n : ℕ} (s : Fin n → M.val.obj (op V)) (P : Subobject M) :
    Submodule (chartRing B S hS F hF V) (Fin n → chartRing B S hS F hF V) :=
  Submodule.comap (Fintype.linearCombination (chartRing B S hS F hF V) s)
    (LinearMap.range (P.arrow.val.app (op V)).hom)

private theorem mem_chartCoeffSubmodule_iff {M : Modules.{u, u} B S hS F hF}
    {V : SmallEtale B S hS F} {n : ℕ} (s : Fin n → M.val.obj (op V)) (P : Subobject M)
    (x : Fin n → chartRing B S hS F hF V) :
    x ∈ chartCoeffSubmodule B S hS F hF s P ↔
      (∑ i, x i • s i) ∈ LinearMap.range (P.arrow.val.app (op V)).hom := by
  rw [chartCoeffSubmodule, Submodule.mem_comap, Fintype.linearCombination_apply]

private theorem chartCoeffSubmodule_mono {M : Modules.{u, u} B S hS F hF}
    {V : SmallEtale B S hS F} {n : ℕ} (s : Fin n → M.val.obj (op V)) {P Q : Subobject M}
    (h : P ≤ Q) :
    chartCoeffSubmodule B S hS F hF s P ≤ chartCoeffSubmodule B S hS F hF s Q := fun x hx =>
  (mem_chartCoeffSubmodule_iff B S hS F hF s Q x).2
    (range_arrow_mono h (op V) ((mem_chartCoeffSubmodule_iff B S hS F hF s P x).1 hx))

/-! ### The local step -/

/-- **Two quasi-coherent subobjects with the same coefficient tuples over a Noetherian affine chart
carrying generators of the ambient module have the same sections over every chart over it.**  The
conclusion is phrased locally: a section of the larger subobject restricts into the smaller one on
a covering sieve.

A section of `Q` over a chart over `V` is, locally on affine charts, a combination of the
restricted generators of `M`; flat base change rewrites its coefficient tuple along a finite
generating family of the coefficient tuples landing in `Q`, and that family lands in `P` by
hypothesis. -/
private theorem exists_covering_mem_range_of_chartCoeffSubmodule_le
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    {M : Modules.{u, u} B S hS F hF} (hMcart : IsCartesianOnAffineCharts M)
    {V : SmallEtale B S hS F} (hV : IsNoetherianAffineChart B S hS F V)
    {n : ℕ} (s : Fin n → M.val.obj (op V))
    (hs : PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J M.val s)
    {P Q : Subobject M}
    (hQcart : IsCartesianOnAffineCharts (Q : Modules.{u, u} B S hS F hF))
    (hPQ : chartCoeffSubmodule B S hS F hF s Q ≤ chartCoeffSubmodule B S hS F hF s P)
    {W : SmallEtale B S hS F} (f : W ⟶ V) (y : M.val.obj (op W))
    (hy : y ∈ LinearMap.range (Q.arrow.val.app (op W)).hom) :
    ∃ Sv : Sieve W, Sv ∈ (smallEtaleRingedSite B S hS F hF).J W ∧
      ∀ ⦃Y : SmallEtale B S hS F⦄ (h : Y ⟶ W), Sv.arrows h →
        chartRestrictLinear M h y ∈ LinearMap.range (P.arrow.val.app (op Y)).hom := by
  classical
  have hVaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V) := hV.1
  have hVn : IsNoetherianRing (chartRing B S hS F hF V) := hV.2
  -- a finite generating family of the coefficient tuples landing in `Q`
  obtain ⟨k, g, hgmem, hgspan⟩ := IsNoetherianRing.exists_fin_generating_coeffs_mem
    (A := chartRing B S hS F hF V) (M := M.val.obj (op V))
    (LinearMap.range (Q.arrow.val.app (op V)).hom) s
  -- which, by hypothesis, already lands in `P`
  have hgP : ∀ j, (∑ i, g j i • s i) ∈ LinearMap.range (P.arrow.val.app (op V)).hom := fun j =>
    (mem_chartCoeffSubmodule_iff B S hS F hF s P (g j)).1
      (hPQ ((mem_chartCoeffSubmodule_iff B S hS F hF s Q (g j)).2 (hgmem j)))
  -- locally on `W` the section is a combination of the generators of `M`
  obtain ⟨Sv₁, hSv₁, hgen⟩ := hs W f y
  -- refine that covering sieve by the charts with affine underlying scheme
  let Sv₂ : Sieve W :=
    { arrows := fun Y h => ∃ (A : SmallEtale B S hS F) (l : Y ⟶ A) (mm : A ⟶ W),
        IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A) ∧
          Sv₁.arrows mm ∧ h = l ≫ mm
      downward_closed := by
        rintro Y Y' h ⟨A, l, mm, hA, hmm, rfl⟩ q
        exact ⟨A, q ≫ l, mm, hA, hmm, (Category.assoc q l mm).symm⟩ }
  refine ⟨Sv₂, ?_, ?_⟩
  · refine (smallEtaleRingedSite B S hS F hF).J.transitive hSv₁ _ ?_
    intro Y mm hmm
    obtain ⟨I, zz, ψ, hzaff, hzcov, -⟩ := SmallEtale.exists_affine_etale_ofArrows B S hS F Y
    refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_ hzcov
    rintro Y' q ⟨T, l, kk, hk, rfl⟩
    cases hk with
    | mk j =>
      exact ⟨zz j, l, ψ j ≫ mm, hzaff j, Sv₁.downward_closed hmm (ψ j),
        (Category.assoc l (ψ j) mm).symm⟩
  · rintro Y h ⟨A, l, mm, hAaff, hmm, rfl⟩
    let _ := chartAlgebra (hF := hF) (mm ≫ f)
    -- the combination of the generators of `M` available over the affine chart `A`
    obtain ⟨a, ha⟩ := hgen A mm hmm
    have ha' : (∑ i, a i • chartRestrictLinear M (mm ≫ f) (s i)) = chartRestrictLinear M mm y := ha
    have hyA : chartRestrictLinear M mm y ∈ LinearMap.range (Q.arrow.val.app (op A)).hom :=
      chartRestrictLinear_mem_range Q mm hy
    have hflat : Module.Flat (chartRing B S hS F hF V) (chartRing B S hS F hF A) :=
      flat_chartRestrict_of_isAffine (hF := hF) (mm ≫ f) hVaff hAaff
    obtain ⟨c, hc⟩ := exists_coeffs_of_mem_range_of_bijective_sectionsBaseChange
      B S hS F hF Q.arrow (mm ≫ f) (hMcart V A hVaff hAaff (mm ≫ f))
      (hQcart V A hVaff hAaff (mm ≫ f)).2 s g hflat hgspan a (by rw [ha']; exact hyA)
    -- rewriting the coefficient tuple along the generating family lands the section in `P`
    have hPA : chartRestrictLinear M mm y ∈ LinearMap.range (P.arrow.val.app (op A)).hom := by
      rw [← ha']
      have hrw : (∑ i, a i • chartRestrictLinear M (mm ≫ f) (s i))
          = ∑ j, c j • chartRestrictLinear M (mm ≫ f) (∑ i, g j i • s i) :=
        calc (∑ i, a i • chartRestrictLinear M (mm ≫ f) (s i))
            = ∑ i, (∑ j, c j * chartRestrict (hF := hF) (mm ≫ f) (g j i)) •
                chartRestrictLinear M (mm ≫ f) (s i) :=
              Finset.sum_congr rfl fun i _ =>
                congrArg (fun r => r • chartRestrictLinear M (mm ≫ f) (s i)) (hc i)
          _ = ∑ i, ∑ j, (c j * chartRestrict (hF := hF) (mm ≫ f) (g j i)) •
                chartRestrictLinear M (mm ≫ f) (s i) :=
              Finset.sum_congr rfl fun i _ => Finset.sum_smul
          _ = ∑ j, ∑ i, (c j * chartRestrict (hF := hF) (mm ≫ f) (g j i)) •
                chartRestrictLinear M (mm ≫ f) (s i) := Finset.sum_comm
          _ = ∑ j, c j • chartRestrictLinear M (mm ≫ f) (∑ i, g j i • s i) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [map_sum, Finset.smul_sum]
              exact Finset.sum_congr rfl fun i _ =>
                (smul_smul _ _ _).symm.trans (congrArg (fun z => c j • z)
                  (chartRestrictLinear_smul M (mm ≫ f) (g j i) (s i)).symm)
      rw [hrw]
      exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _
        (chartRestrictLinear_mem_range P (mm ≫ f) (hgP j))
    rw [chartRestrictLinear_comp M mm l y]
    exact chartRestrictLinear_mem_range P l hPA

/-! ### A finite covering family of Noetherian affine charts carrying generators -/

/-- **A Noetherian algebraic space carries a finite family of étale charts which are affine with
Noetherian ring of sections, cover its small étale site, and each carry finitely many generators of
a given module of finite type.**

The affine surjective étale chart of Stacks 03H6 covers the site by itself, and it is a
quasi-compact object of the site, so the covering by the Noetherian affine charts carrying
generators is refined through finitely many of its members. -/
private theorem exists_finite_coversTop_isNoetherianAffineChart_generates
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (hqc : IsQuasiCompactSpace B S hS F) (M : Modules.{u, u} B S hS F hF)
    (hM : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J M.val) :
    ∃ (r : ℕ) (V : Fin r → SmallEtale B S hS F),
      (smallEtaleRingedSite B S hS F hF).J.CoversTop V ∧
        ∀ i, IsNoetherianAffineChart B S hS F (V i) ∧
          ∃ (n : ℕ) (s : Fin n → M.val.obj (op (V i))),
            PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J M.val s := by
  classical
  obtain ⟨U, a, hUaff, hasurj, haet⟩ :=
    (isQuasiCompactSpace_iff_exists_affine_etale_surjective_cover B S hS F hF).mp hqc
  -- the atlas, read as an object of the small étale site
  have hid : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf (yoneda.map (𝟙 U)) :=
    (BigFppfOver.presheaf_inverseImage_yoneda_map_iff B S hS
      (@Etale.{u} : MorphismProperty Scheme.{u}) (𝟙 U)).2
      (by rw [CategoryTheory.Functor.map_id]; infer_instance)
  have haet' : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf a := by
    have h := haet U (yoneda.map (𝟙 U)) hid
    rwa [CategoryTheory.Functor.map_id, Category.id_comp] at h
  let Uc : SmallEtale B S hS F := ⟨CostructuredArrow.mk a, haet'⟩
  have hUcsurj : IsSurjective B S hS Uc.obj.hom :=
    (presheafSurjective_iff_isSurjective_yoneda B S hS F hF U a).1 hasurj
  have hcovU : (smallEtaleRingedSite B S hS F hF).J.CoversTop (fun _ : PUnit.{u + 2} => Uc) :=
    SmallEtale.coversTop_of_isSurjective B S hS F hF Uc hUcsurj
  have hUcaff : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS F).obj Uc)) := hUaff
  -- finitely many members of the Noetherian affine covering refine the atlas
  obtain ⟨r, zz, φ, -, hzmem, hzcov, -⟩ :=
    SmallEtale.exists_finite_affine_etale_ofArrows_le B S hS F hUcaff
      (coversTop_isNoetherianAffineChart_generates B S hS F hF M hM Uc)
  choose jj qq using fun i => (Sieve.mem_ofObjects_iff _ (φ i)).1 (hzmem i)
  refine ⟨r, fun i => (jj i).1, ?_, fun i => (jj i).2⟩
  intro X
  refine (smallEtaleRingedSite B S hS F hF).J.transitive (hcovU X) _ ?_
  intro Z h hh
  obtain ⟨-, ⟨p⟩⟩ := (Sieve.mem_ofObjects_iff _ h).1 hh
  refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_
    ((smallEtaleRingedSite B S hS F hF).J.pullback_stable p hzcov)
  rintro Y q ⟨T, l, kk, hk, -⟩
  cases hk with
  | mk i => exact ⟨i, ⟨l ≫ (qq i).some⟩⟩

/-! ### The ascending chain condition -/

/-- **Stacks 07UJ.** The ascending chain condition holds for the quasi-coherent submodules of a
coherent module on a Noetherian algebraic space: an ascending sequence of quasi-coherent subobjects
of a coherent `𝒪_F`-module is eventually constant. -/
@[stacks 07UJ]
theorem exists_eventually_constant_quasicoherentSubobjects
    (hZ : B.Contains (⊤_ Scheme.{u})) (hN : IsNoetherian B S hS hZ F)
    (M : Modules.{u, u} B S hS F hF) (hM : IsCoherent B S hS F hF M)
    (G : ℕ → Subobject M)
    (hG : ∀ n, SheafOfModules.IsQuasicoherentOnSite (G n : Modules.{u, u} B S hS F hF))
    (hmono : Monotone G) :
    ∃ n, ∀ k, n ≤ k → G k = G n := by
  classical
  have : Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V)) :=
    ⟨hN.2.2⟩
  have hMcart : IsCartesianOnAffineCharts M :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF M hM.toIsQuasicoherentOnSite
  have hGcart : ∀ m, IsCartesianOnAffineCharts (G m : Modules.{u, u} B S hS F hF) := fun m =>
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ (hG m)
  obtain ⟨r, V, hcov, hVprop⟩ := exists_finite_coversTop_isNoetherianAffineChart_generates
    B S hS F hF hN.1 M hM.isFiniteType
  choose hVN hVgen using hVprop
  choose nn ss hss using hVgen
  -- chart by chart, the coefficient tuples form an ascending chain in a Noetherian module
  have hstab : ∀ i : Fin r, ∃ N : ℕ, ∀ m, N ≤ m →
      chartCoeffSubmodule B S hS F hF (ss i) (G N) =
        chartCoeffSubmodule B S hS F hF (ss i) (G m) := by
    intro i
    have : IsNoetherianRing (chartRing B S hS F hF (V i)) := (hVN i).2
    exact monotone_stabilizes_iff_noetherian.2 inferInstance
      ⟨fun m => chartCoeffSubmodule B S hS F hF (ss i) (G m),
        fun _ _ hm => chartCoeffSubmodule_mono B S hS F hF (ss i) (hmono hm)⟩
  choose start hstart using hstab
  refine ⟨Finset.sup Finset.univ start, fun k hk => ?_⟩
  set n₀ := Finset.sup Finset.univ start with hn₀def
  have hleN : ∀ i, start i ≤ n₀ := fun i => Finset.le_sup (Finset.mem_univ i)
  have heq : ∀ i, chartCoeffSubmodule B S hS F hF (ss i) (G k) =
      chartCoeffSubmodule B S hS F hF (ss i) (G n₀) :=
    fun i => (hstart i k (le_trans (hleN i) hk)).symm.trans (hstart i n₀ (hleN i))
  have hle : G n₀ ≤ G k := hmono hk
  set φ := Subobject.ofLE (G n₀) (G k) hle with hφdef
  have hφ : φ ≫ (G k).arrow = (G n₀).arrow := Subobject.ofLE_arrow hle
  have : Mono φ := mono_of_mono_fac hφ
  have hinj : PresheafOfModules.IsLocallyInjective
      (smallEtaleRingedSite B S hS F hF).J φ.val :=
    Presheaf.isLocallyInjective_of_injective _ _
      fun X => Stacks.SheafOfModules.injective_val_of_mono φ X
  have hsurj : PresheafOfModules.IsLocallySurjective
      (smallEtaleRingedSite B S hS F hF).J φ.val := by
    refine isLocallySurjective_of_liftSieve_mem B S hS F hF φ fun X x => ?_
    refine (smallEtaleRingedSite B S hS F hF).J.transitive (hcov X) _ ?_
    intro Z h hh
    obtain ⟨i, ⟨qZ⟩⟩ := (Sieve.mem_ofObjects_iff _ h).1 hh
    have hyZ : chartRestrictLinear M h ((G k).arrow.val.app (op X) x) ∈
        LinearMap.range ((G k).arrow.val.app (op Z)).hom :=
      chartRestrictLinear_mem_range (G k) h ⟨x, rfl⟩
    obtain ⟨Sv, hSv, hmem⟩ := exists_covering_mem_range_of_chartCoeffSubmodule_le
      B S hS F hF hMcart (hVN i) (ss i) (hss i) (hGcart k) (le_of_eq (heq i)) qZ _ hyZ
    refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_ hSv
    intro Y g hg
    obtain ⟨t, ht⟩ := hmem g hg
    refine ⟨t, Stacks.SheafOfModules.injective_val_of_mono (G k).arrow (op Y) ?_⟩
    calc (G k).arrow.val.app (op Y) (φ.val.app (op Y) t)
        = (G n₀).arrow.val.app (op Y) t := arrow_apply_ofLE hle (op Y) t
      _ = chartRestrictLinear M g (chartRestrictLinear M h ((G k).arrow.val.app (op X) x)) := ht
      _ = chartRestrictLinear M (g ≫ h) ((G k).arrow.val.app (op X) x) :=
          (chartRestrictLinear_comp M h g _).symm
      _ = (G k).arrow.val.app (op Y)
            (chartRestrictLinear (G k : Modules.{u, u} B S hS F hF) (g ≫ h) x) :=
          (arrow_app_chartRestrictLinear (G k) (g ≫ h) x).symm
  have : IsIso φ := Stacks.SheafOfModules.isIso_of_isLocallyBijective φ
  symm
  rw [← Subobject.mk_arrow (G n₀), ← Subobject.mk_arrow (G k)]
  exact Subobject.mk_eq_mk_of_comm _ _ (asIso φ) hφ

end AlgebraicGeometry.Space

