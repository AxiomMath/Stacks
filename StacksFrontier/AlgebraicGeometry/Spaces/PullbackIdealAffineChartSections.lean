module

public import StacksFrontier.AlgebraicGeometry.Spaces.PullbackIdealChartGeneration

/-!
# The inverse-image ideal of a representable morphism over an affine chart

Let `f : X ⟶ Y` be a representable morphism of algebraic spaces over a scheme `S`, let
`𝓙 ⊆ 𝒪_Y` be a sheaf of ideals cartesian on affine charts, let `V` be an affine étale chart of
`Y` and let `Z` be an affine étale chart of `X` mapping to the base-changed chart `V ×_Y X`.
Then the sections over `Z` of the inverse-image ideal `f⁻¹𝓙 · 𝒪_X` are the ideal generated by
the restrictions to `Z` of the pullbacks of the sections of `𝓙` over `V`:

`(f⁻¹𝓙 · 𝒪_X)(Z) = 𝓙(V) · 𝒪_X(Z)`.

## Main results

* `AlgebraicGeometry.Space.pullbackIdealSubsheaf_obj_eq_map_of_isAffine`: the displayed
  equality.

## References

* [Stacks Project, Tag 0GF8](https://stacks.math.columbia.edu/tag/0GF8)
* [Stacks Project, Tag 08BD](https://stacks.math.columbia.edu/tag/08BD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hf : yoneda.relativelyRepresentable f.hom)
    (J : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).Submodule)

/-- **The inverse-image ideal over an affine chart above an affine base-changed chart is generated
by the sections pulled back from the base.** -/
theorem pullbackIdealSubsheaf_obj_eq_map_of_isAffine
    (hJ : IsCartesianOnAffineCharts (hF := Y.2) J.toSheafOfModules)
    (V : SmallEtale B S hS Y.1)
    (hV : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    (Z : SmallEtale B S hS X.1) (v : Z ⟶ (smallBaseChange B S hS f hf).obj V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Z)) :
    (pullbackIdealSubsheaf B S hS f hf J).obj (op Z) =
      Ideal.map (chartSectionsRestrict B S hS X v)
        (Ideal.map (chartIdealPullbackHom B S hS f hf V) (chartSectionsIdeal B S hS Y J V)) := by
  refine le_antisymm (fun s hs => ?_) ?_
  · obtain ⟨T, hT, hTs⟩ := (mem_pullbackIdealSubsheaf_iff B S hS f hf J).1 hs
    refine mem_of_forall_restrict_mem_map B S hS X hZ hT _ fun W g hg hW => ?_
    have := pullbackChartIdeal_le_map B S hS f hf J hJ V hV W (g ≫ v) hW (hTs g hg)
    rwa [map_chartSectionsRestrict_comp] at this
  · exact Ideal.map_le_iff_le_comap.2 (Ideal.map_le_iff_le_comap.2 fun a ha =>
      (pullbackIdealSubsheaf B S hS f hf J).map_mem v.op
        (chartIdealPullbackHom_mem_pullbackIdealSubsheaf B S hS f hf J V ha))

end AlgebraicGeometry.Space

end
