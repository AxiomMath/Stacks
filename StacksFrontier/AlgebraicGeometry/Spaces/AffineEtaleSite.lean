module

public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleSite

/-!
# The affine étale site of an algebraic space

Let `B` be a big fppf site containing a scheme `S`, and let `F` be a presheaf on the big fppf
site of `S`. The *affine étale site* of `F` is the part of its small étale site
(`AlgebraicGeometry.Space.SmallEtale`) consisting of the charts whose underlying scheme is affine,
with

* as objects the étale charts `φ : yoneda.obj U ⟶ F` of `F` with `U` affine;
* as morphisms the morphisms of the small étale site between them, that is, the morphisms of
  schemes making the triangle over `F` commute;
* as covering families the *finite* families of affine charts which cover in the small étale
  site.

## Main definitions

* `AlgebraicGeometry.Space.IsAffineChart` is the property of an étale chart of `F` that its
  underlying scheme is affine.
* `AlgebraicGeometry.Space.AffineEtale` is the affine étale site of `F`, as a category, with
  `AlgebraicGeometry.Space.AffineEtale.inclusion` the inclusion into the small étale site and
  `AlgebraicGeometry.Space.AffineEtale.toOver`,
  `AlgebraicGeometry.Space.AffineEtale.toSchemes`,
  `AlgebraicGeometry.Space.AffineEtale.toScheme` the projections to the big fppf site of `S`,
  to `Sch_κ` and to all schemes.
* `AlgebraicGeometry.Space.AffineEtale.IsCovering` specifies its covering families,
  `AlgebraicGeometry.Space.AffineEtale.precoverage` is the precoverage they present, and
  `AlgebraicGeometry.Space.AffineEtale.topology` the Grothendieck topology they generate.

## References

* [Stacks Project, Tag 0H01](https://stacks.math.columbia.edu/tag/0H01)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-- An étale chart of `F` is an *affine* chart when its underlying scheme is affine. -/
abbrev IsAffineChart : ObjectProperty (SmallEtale B S hS F) :=
  fun X ↦ IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj X))

/-- The *affine étale site* of a presheaf `F` on the big fppf site of `S`, as a category: its
objects are the étale charts of `F` with affine source, and its morphisms are the morphisms of
schemes whose triangle over `F` commutes. -/
@[stacks 0H01 "objects and morphisms"]
abbrev AffineEtale := (IsAffineChart B S hS F).FullSubcategory

namespace AffineEtale

/-- The canonical full embedding of the affine étale charts of `F` into all its étale charts. -/
abbrev inclusion : AffineEtale B S hS F ⥤ SmallEtale B S hS F :=
  (IsAffineChart B S hS F).ι

/-- The object of the big fppf site of `S` underlying an affine étale chart. -/
abbrev toOver : AffineEtale B S hS F ⥤ BigFppfOver B S hS :=
  inclusion B S hS F ⋙ SmallEtale.toOver B S hS F

/-- The object of `Sch_κ` underlying an affine étale chart. -/
abbrev toSchemes : AffineEtale B S hS F ⥤ B.Schemes :=
  inclusion B S hS F ⋙ SmallEtale.toSchemes B S hS F

/-- The scheme underlying an affine étale chart. -/
abbrev toScheme : AffineEtale B S hS F ⥤ Scheme.{u} :=
  toOver B S hS F ⋙ BigFppfOver.toScheme B S hS

/-- The scheme underlying an affine étale chart is affine. -/
instance isAffine_toScheme (X : AffineEtale B S hS F) :
    IsAffine ((toScheme B S hS F).obj X) :=
  X.property

/-- A family of affine étale charts of `F` is a covering family exactly when it is a covering
family of the small étale site and its index type is finite. -/
@[stacks 0H01 "coverings"]
abbrev IsCovering (E : Covering (AffineEtale B S hS F)) : Prop :=
  SmallEtale.IsCovering B S hS F
      ⟨(inclusion B S hS F).obj E.1, E.2.map (inclusion B S hS F)⟩ ∧
    Finite E.2.I₀

/-- The precoverage presented by the covering families of affine étale charts. -/
def precoverage : Precoverage (AffineEtale B S hS F) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS F ⟨X, E⟩}

/-- Membership in the affine étale precoverage is characterized by a presenting covering family
of affine charts. -/
theorem mem_precoverage_iff {X : AffineEtale B S hS F} {R : Presieve X} :
    R ∈ precoverage B S hS F X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS F ⟨X, E⟩ := Iff.rfl

/-- The affine étale topology of `F`, generated by its covering families of affine charts. -/
abbrev topology : GrothendieckTopology (AffineEtale B S hS F) :=
  (precoverage B S hS F).toGrothendieck

end AffineEtale

end AlgebraicGeometry.Space
