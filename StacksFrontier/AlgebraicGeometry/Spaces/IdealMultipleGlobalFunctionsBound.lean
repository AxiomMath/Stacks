/-!
# Global functions lying in `Iᵐ 𝒪` lie in `Iᵐ⁻ᶜ Γ(X, 𝒪)`, for `X` proper over an affine scheme

Let `V` be an affine object of the site with Noetherian ring of functions `A`, let
`f : X ⟶ V` be a proper morphism of algebraic spaces and let `I ⊆ A` be an ideal. This file
draws from [Stacks, Tag 08AX], clause (2), in degree `0` and at `n = 0`, the following bound on
global functions: there is a `c` such that a global function `x` of `X` whose value on every
étale chart lies in the subsheaf `Iᵐ 𝒪_X ⊆ 𝒪_X` lies in the ideal of `Γ(X, 𝒪_X)` generated by
`Iᵐ⁻ᶜ`, for every `m ≥ c`.

This is the special case `p = 0`, `ℱ = 𝒪_X` of clause (1) of [Stacks, Tag 08AY]: the kernel of
`H⁰(X, 𝒪_X) ⟶ H⁰(X, 𝒪_X / Iᵐ 𝒪_X)` is the image of `H⁰(X, Iᵐ 𝒪_X)`, which the
hypothesis describes chart by chart, and clause (2) of Tag 08AX at `n = 0` bounds that image.

## Main results

* `AlgebraicGeometry.Space.mem_range_cohomologyResMap_idealMultipleι`: a global function whose
  values lie in `J 𝒪_X` is, read in degree-zero cohomology, in the image of
  `H⁰(X, J 𝒪_X) ⟶ H⁰(X, 𝒪_X)`.
* `AlgebraicGeometry.Space.exists_mem_map_pow_of_isReesFinite`: the bound, from finiteness of
  `⨁ₙ H⁰(X, Iⁿ 𝒪_X)` over the Rees algebra.
* `AlgebraicGeometry.Space.exists_mem_map_pow_of_isProper`: **the bound** for `X` proper over an
  affine Noetherian `V`, by Stacks 08AW.

## Implementation notes

Degree-zero cohomology is identified with global sections by
`CategoryTheory.Functor.rightDerivedZeroIsoSelf`, global sections of `𝒪`-modules being left
exact at the universe of the structure rings
(`AlgebraicGeometry.Space.preservesFiniteLimits_globalSectionsFunctor_structureRingSheaf`). The
global sections of the structure sheaf read as a module over itself are, on the nose, the
compatible families of regular functions on the étale charts.

## References

* [Stacks Project, Tag 08AX](https://stacks.math.columbia.edu/tag/08AX)
* [Stacks Project, Tag 08AY](https://stacks.math.columbia.edu/tag/08AY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite DirectSum
open Stacks.Cohomology.SiteModules Stacks.Blowup Stacks.RingTheory
open scoped IsMulCommutative

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

attribute [local instance] hasInjectiveResolutions_modules

section Bound

variable {X : AlgebraicSpaces B S hS} {A : Type u} [CommRing A]
  (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedSite B S hS X.1 X.2).O))))

/-- The structure sheaf of `X` as a module over itself. -/
abbrev oModule (X : AlgebraicSpaces B S hS) : Modules.{u, u} B S hS X.1 X.2 :=
  SheafOfModules.unit
    (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)

/-- Degree-zero cohomology is global sections, naturally. -/
abbrev spaceCohomologyZeroIso (X : AlgebraicSpaces B S hS) :
    spaceCohomology B S hS X 0 ≅
      globalSectionsFunctor.{u + 1, u, u, u}
        (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O) :=
  haveI := preservesFiniteLimits_globalSectionsFunctor_structureRingSheaf B S hS X.1 X.2
  Functor.rightDerivedZeroIsoSelf _

/-- **A global function with values in `J 𝒪_X` is, in degree-zero cohomology, in the image of
`H⁰(X, J 𝒪_X)`.** -/
theorem mem_range_cohomologyResMap_idealMultipleι (J : Ideal A)
    (x : (oModule X).sections)
    (hx : ∀ W : (SmallEtale B S hS X.1)ᵒᵖ,
      x.eval W ∈ Set.range ((idealMultipleι φ (oModule X) J).val.app W)) :
    (spaceCohomologyZeroIso X).inv.app (oModule X) x ∈
      LinearMap.range (cohomologyResMap φ 0 (idealMultipleι φ (oModule X) J)) := by
  choose y hy using hx
  have hinj : ∀ W, Function.Injective ((idealMultipleι φ (oModule X) J).val.app W) :=
    fun W => Stacks.SheafOfModules.injective_app_of_mono (idealMultipleι φ (oModule X) J) W
  let t : (idealMultiple φ (oModule X) J).sections :=
    ⟨fun W => y W, fun {W W'} g => hinj W'
      ((PresheafOfModules.naturality_apply (idealMultipleι φ (oModule X) J).val g (y W)).trans
        ((congrArg (fun z => (oModule X).val.map g z) (hy W)).trans
          ((x.2 g).trans (hy W').symm)))⟩
  have ht : (globalSectionsFunctor.{u + 1, u, u, u} _).map
      (idealMultipleι φ (oModule X) J) t = x :=
    Subtype.ext (funext fun W => hy W)
  refine ⟨(spaceCohomologyZeroIso X).inv.app _ t, ?_⟩
  have hnat := (spaceCohomologyZeroIso X).inv.naturality (idealMultipleι φ (oModule X) J)
  have h : ((spaceCohomologyZeroIso X).inv.app (oModule X)).hom
        (((globalSectionsFunctor.{u + 1, u, u, u} _).map
          (idealMultipleι φ (oModule X) J)).hom t) =
      ((spaceCohomology B S hS X 0).map (idealMultipleι φ (oModule X) J)).hom
        (((spaceCohomologyZeroIso X).inv.app _).hom t) :=
    congrArg (fun m => ModuleCat.Hom.hom m t) hnat
  exact h.symm.trans
    (congrArg (fun z => ((spaceCohomologyZeroIso X).inv.app (oModule X)).hom z) ht)

/-- A linear map carries `I • ⊤` into `I • ⊤`. -/
@[ega "0 7.8.1" "partial"]
theorem _root_.Submodule.mem_smul_top_of_mem_smul_top_map {R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (L : M →ₗ[R] N) (I : Ideal R)
    {x : M} (hx : x ∈ I • (⊤ : Submodule R M)) : L x ∈ I • (⊤ : Submodule R N) :=
  Submodule.smul_top_le_comap_smul_top I L hx

/-- The global sections of the structure sheaf read as a module over itself, as global
functions. -/
abbrev unitSectionsToRing (x : (oModule X).sections) :
    ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X.1 X.2).O))) :=
  ⟨x.1, x.2⟩

/-- An element of `I • ⊤` in the global sections of `𝒪_X`, the scalars acting through `φ`, lies
in the ideal generated by the image of `I`. -/
theorem unitSectionsToRing_mem_map_of_mem_smul_top (I : Ideal A)
    (x : (ModuleCat.restrictScalars φ).obj
      ((globalSectionsFunctor.{u + 1, u, u, u} (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj (oModule X)))
    (hx : x ∈ I • (⊤ : Submodule A ((ModuleCat.restrictScalars φ).obj
      ((globalSectionsFunctor.{u + 1, u, u, u} (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj (oModule X))))) :
    unitSectionsToRing x ∈ Ideal.map φ I := by
  refine Submodule.smul_induction_on hx (fun r hr n _ => ?_) (fun a b ha hb => ?_)
  · change φ r * unitSectionsToRing n ∈ _
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem φ hr)
  · change unitSectionsToRing a + unitSectionsToRing b ∈ _
    exact Ideal.add_mem _ ha hb

/-- **The bound from Stacks 08AX at `p = 0`, `n = 0`, on global functions.** If the
`Hᵖ(X, Iⁿ 𝒪_X)` form a finite module over the Rees algebra, there is a `c` such that a global
function of `X` whose values lie in `Iᵐ 𝒪_X` lies in the ideal generated by `Iᵐ⁻ᶜ`, for
`m ≥ c`. -/
theorem exists_mem_map_pow_of_isReesFinite [IsNoetherianRing A] (I : Ideal A)
    (h : (cohomologyIdealPowerSystem φ (oModule X) I 0).IsReesFinite) :
    ∃ c : ℕ, ∀ m : ℕ, c ≤ m → ∀ x : (oModule X).sections,
      (∀ W : (SmallEtale B S hS X.1)ᵒᵖ,
        x.eval W ∈ Set.range ((idealMultipleι φ (oModule X) (I ^ m)).val.app W)) →
      unitSectionsToRing x ∈ Ideal.map φ (I ^ (m - c)) := by
  obtain ⟨c, -, h2⟩ := exists_cohomologyIdealPower_bounds_of_isReesFinite φ (oModule X) I 0 h
  refine ⟨c, fun m hm x hx => ?_⟩
  obtain ⟨z, hz⟩ := mem_range_cohomologyResMap_idealMultipleι φ (I ^ m) x hx
  have hle : I ^ m ≤ I ^ 0 := Ideal.pow_le_pow_right (Nat.zero_le m)
  have hfac : cohomologyResMap φ 0 (idealMultipleι φ (oModule X) (I ^ m)) z =
      cohomologyIdealPowerProj φ (oModule X) I 0 0
        (cohomologyIdealPowerTr φ (oModule X) I 0 (Nat.zero_le m) z) := by
    rw [cohomologyIdealPowerProj, cohomologyIdealPowerTr, cohomologyResMap_comp_apply,
      idealMultipleMap_one_ι φ (oModule X) hle]
  have hTr := h2 0 m (Nat.zero_le m) (by omega) ⟨z, rfl⟩
  rw [Nat.sub_zero] at hTr
  have h0 := Submodule.mem_smul_top_of_mem_smul_top_map
    (cohomologyIdealPowerProj φ (oModule X) I 0 0) (I ^ (m - c)) hTr
  rw [← hfac, hz] at h0
  have h1 := Submodule.mem_smul_top_of_mem_smul_top_map
    ((ModuleCat.restrictScalars φ).map ((spaceCohomologyZeroIso X).hom.app (oModule X))).hom
    (I ^ (m - c)) h0
  have e : ((ModuleCat.restrictScalars φ).map
      ((spaceCohomologyZeroIso X).hom.app (oModule X))).hom
        ((spaceCohomologyZeroIso X).inv.app (oModule X) x) = x :=
    congrArg (fun g => ModuleCat.Hom.hom g x)
      ((spaceCohomologyZeroIso X).inv_hom_id_app (oModule X))
  rw [e] at h1
  exact unitSectionsToRing_mem_map_of_mem_smul_top φ _ x h1

end Bound

section Proper

variable {X : AlgebraicSpaces B S hS} {V : BigFppfOver B S hS}
  [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]

/-- **Stacks 08AY, clause (1), at `p = 0` and `ℱ = 𝒪_X`, read on global functions.** Let
`f : X ⟶ V` be a proper morphism to an affine object of the site with Noetherian ring of
functions `A`, with `X` locally Noetherian, and let `I ⊆ A` be an ideal. There is a `c` such that
for every `m ≥ c`, a global function of `X` whose values on the étale charts lie in `Iᵐ 𝒪_X` lies
in the ideal of `Γ(X, 𝒪_X)` generated by the pullback of `Iᵐ⁻ᶜ`. -/
theorem exists_mem_map_pow_of_isProper
    [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
    (f : X ⟶ schemeSpace V) (hf : IsProper B S hS f.hom)
    [Fact (HasEtaleLocalProperty B S hS X.1 (fun T : Scheme.{u} => IsLocallyNoetherian T))]
    (I : Ideal Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) :
    ∃ c : ℕ, ∀ m : ℕ, c ≤ m → ∀ x : (oModule X).sections,
      (∀ W : (SmallEtale B S hS X.1)ᵒᵖ, x.eval W ∈ Set.range
        ((idealMultipleι (pullbackToGlobalFunctions B S hS X V f) (oModule X)
          (I ^ m)).val.app W)) →
      unitSectionsToRing x ∈ Ideal.map (pullbackToGlobalFunctions B S hS X V f) (I ^ (m - c)) :=
  exists_mem_map_pow_of_isReesFinite (pullbackToGlobalFunctions B S hS X V f) I
    (isReesFinite_cohomologyIdealPowerSystem_of_isAffine (RingEquiv.refl _) f hf
      (pullbackToGlobalFunctions B S hS X V f) (fun _ => rfl) (oModule X) I 0)

end Proper

end AlgebraicGeometry.Space

end
