module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.GeometricModuleStalkGerm
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealAnnihilatorQuasicoherentSpace
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleSitePoint
public import StacksFrontier.AlgebraicGeometry.Spaces.WeaklyAssociatedMinimalSupport

/-!
# The geometric stalk of the annihilator subsheaf

Let `F` be an algebraic space, `I ⊆ 𝒪_F` a quasi-coherent sheaf of ideals of finite type and
`G` a quasi-coherent `𝒪_F`-module.  At a geometric point `x̄` the stalk of the subsheaf `G'` of
sections annihilated by `I` is the annihilator of `I_x̄` in `G_x̄`.

This is part (3) of [Stacks, Tag 0856].

## Main results

* `AlgebraicGeometry.Space.exists_germ_annihilatorSubmodule_iff`: a germ of `G` at a geometric
  point comes from the annihilator subsheaf exactly when every germ of a section of `I` kills
  it.

## Implementation notes

The stalk is the filtered colimit of the sections over the small étale neighbourhoods
(Stacks 04JY), and `G'_x̄ → G_x̄` need not be shown injective for the statement: the left-hand
side says that `s` is the germ of a section of `G'`, which is exactly membership in the image
of `G'_x̄`.  Germs of sections of `I` at `x̄` exhaust `I_x̄`, so the right-hand side is
`I_x̄ s = 0`.

Both directions are the affine case plus the cofiltered calculus of neighbourhoods.  For the
forward direction a common refinement of the two neighbourhoods involved reduces the claim to
the defining property of the annihilator subsheaf; no finiteness is used there.  For the
converse one refines a representative to an *affine* neighbourhood
(`AlgebraicGeometry.Space.exists_smallEtaleNeighborhoodHom_isAffine`), where `I` has finitely
many generating sections, kills them one at a time on a further refinement — finitely many
conditions, so a single refinement suffices by `CategoryTheory.IsCofiltered.wideCospan` — and
refines once more to an affine neighbourhood, on which part (2) of the tag turns the vanishing
on generators into membership in the annihilator subsheaf.

## References

* [Stacks Project, Tag 0856](https://stacks.math.columbia.edu/tag/0856)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

variable {B S hS F hF}
  {I : (SheafOfModules.unit
    (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)).Submodule}
  {G : Modules.{u, u} B S hS F hF}

/-- An element of an ideal generated by a finite family annihilates whatever the family
annihilates. -/
theorem smul_eq_zero_of_mem_span_range {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {n : ℕ} {g : Fin n → R} {J : Ideal R} (hJ : Submodule.span R (Set.range g) = J)
    {m : M} (hm : ∀ i, g i • m = 0) {a : R} (ha : a ∈ J) : a • m = 0 := by
  have hle : J ≤ LinearMap.ker (LinearMap.toSpanSingleton R M m) := by
    rw [← hJ]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    exact hm i
  exact hle ha

/-- The germ of a regular function in the étale local ring is unchanged by restricting it to a
refinement of the small étale neighbourhood. -/
theorem etaleLocalRingGerm_chartRestrict' {x : GeometricPoint B S hS F}
    {N M : SmallEtaleNeighborhood x} (φ : M ⟶ N) (a : chartRing B S hS F hF N.chart) :
    etaleLocalRingGerm B S hS F x (op M) (chartRestrict (hF := hF) φ.hom a) =
      etaleLocalRingGerm B S hS F x (op N) a :=
  DFunLike.congr_fun (spaceGerm_naturality (x := x) (B := B) (S := S) (hS := hS) (F := F)
    (U := op N) (W := op M) φ.op) a

/-- **[Stacks, Tag 0856], part (3): the geometric stalk of the annihilator subsheaf.**  Let `F`
be an algebraic space, `I ⊆ 𝒪_F` a quasi-coherent sheaf of ideals of finite type and `G` a
quasi-coherent `𝒪_F`-module.  An element of the stalk of `G` at a geometric point `x̄` is the
germ of a section of the subsheaf annihilated by `I` exactly when every germ at `x̄` of a
section of `I` kills it; that is, `G'_x̄ = {s ∈ G_x̄ | I_x̄ s = 0}` inside `G_x̄`. -/
@[stacks 0856 "part (3)"]
theorem exists_germ_annihilatorSubmodule_iff
    (hI : I.toSheafOfModules.IsQuasicoherentOnSite)
    (hIft : SheafOfModules.IsFiniteTypeOnSite I.toSheafOfModules)
    (x : GeometricPoint B S hS F)
    (s : geometricModuleStalk B S hS ⟨F, hF⟩ x G) :
    (∃ (N : SmallEtaleNeighborhood x)
        (t : (annihilatorSubmodule B S hS F hF I G).toSheafOfModules.val.obj (op N.chart)),
        geometricModuleStalkGerm B S hS ⟨F, hF⟩ x G N
          ((annihilatorSubmodule B S hS F hF I G).ι.val.app (op N.chart) t) = s) ↔
      ∀ (N : SmallEtaleNeighborhood x) (a : chartRing B S hS F hF N.chart),
        a ∈ I.obj (op N.chart) →
          etaleLocalRingGerm B S hS F x (op N) a • s = 0 := by
  classical
  have hcof : IsCofiltered (SmallEtaleNeighborhood x) :=
    isCofiltered_smallEtaleNeighborhood B S hS F hF x
  constructor
  · rintro ⟨N, t, ht⟩ M a ha
    obtain ⟨W, f, g, -⟩ := IsCofilteredOrEmpty.cone_objs N M
    have hrep := (geometricModuleStalkGerm_map B S hS ⟨F, hF⟩ x G f _).trans ht
    rw [← etaleLocalRingGerm_chartRestrict' g a, ← hrep]
    refine (geometricModuleStalkGerm_smul B S hS ⟨F, hF⟩ x G W _ _).symm.trans
      ((congrArg _ ?_).trans (map_zero (geometricModuleStalkGerm B S hS ⟨F, hF⟩ x G W)))
    exact (mem_annihilatorSubmodule_obj (I := I) (op N.chart) _).mp t.property
      (op W.chart) f.hom.op _ (I.toSubmodule.map_mem g.hom.op ha)
  · intro hs
    obtain ⟨N₀, t₀, ht₀⟩ :=
      geometricModuleStalkGerm_jointly_surjective B S hS ⟨F, hF⟩ x G s
    obtain ⟨N, fN, hNaff⟩ := exists_smallEtaleNeighborhoodHom_isAffine B S hS ⟨F, hF⟩ x N₀
    obtain ⟨t, htg⟩ : ∃ t : G.val.obj (op N.chart),
        geometricModuleStalkGerm B S hS ⟨F, hF⟩ x G N t = s :=
      ⟨_, (geometricModuleStalkGerm_map B S hS ⟨F, hF⟩ x G fN t₀).trans ht₀⟩
    have hfg : (chartSectionIdeal B S hS F hF I N.chart).FG :=
      Module.Finite.iff_fg.mp (module_finite_sections_of_isFiniteTypeOnSite
        I.toSheafOfModules hI hIft N.chart hNaff)
    obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hzero : ∀ i, geometricModuleStalkGerm B S hS ⟨F, hF⟩ x G N (g i • t) = 0 := by
      intro i
      refine (geometricModuleStalkGerm_smul B S hS ⟨F, hF⟩ x G N (g i) t).trans ?_
      rw [htg]
      exact hs N (g i) (hg.le (Submodule.subset_span ⟨i, rfl⟩))
    choose Mi fi hfi using fun i =>
      (geometricModuleStalkGerm_eq_zero_iff B S hS ⟨F, hF⟩ x G N (g i • t)).mp (hzero i)
    obtain ⟨Z, q, rr, hrr⟩ := IsCofiltered.wideCospan fi
    obtain ⟨Z', e, hZaff⟩ := exists_smallEtaleNeighborhoodHom_isAffine B S hS ⟨F, hF⟩ x Z
    obtain ⟨v, hvdef⟩ : ∃ v : G.val.obj (op Z'.chart),
        G.val.map (e ≫ q).hom.op t = v := ⟨_, rfl⟩
    have hvzero : ∀ i, chartRestrict (hF := hF) (e ≫ q).hom (g i) • v = 0 := by
      intro i
      have hcomp : e ≫ q = (e ≫ rr i) ≫ fi i := by rw [← hrr i, Category.assoc]
      have h1 : G.val.map (e ≫ q).hom.op (g i • t) = 0 := by
        rw [hcomp]
        refine Eq.trans (G.val.map_comp_apply (fi i).hom.op (e ≫ rr i).hom.op _) ?_
        rw [hfi i]
        exact map_zero (G.val.map (e ≫ rr i).hom.op).hom
      rw [← hvdef]
      exact (map_smulₛₗ (G.val.restrictₛₗ (e ≫ q).hom.op) (g i) t).symm.trans h1
    have hspanZ := span_range_algebraMap_eq_chartSectionIdeal
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hI) hNaff hZaff
      (e ≫ q).hom hg
    have hv : v ∈ (annihilatorSubmodule B S hS F hF I G).toSubmodule.obj (op Z'.chart) :=
      (mem_annihilatorSubmodule_obj_of_isAffine hI (op Z'.chart) hZaff v).mpr
        fun a ha => smul_eq_zero_of_mem_span_range hspanZ hvzero ha
    have hgerm : geometricModuleStalkGerm B S hS ⟨F, hF⟩ x G Z' v = s := by
      rw [← hvdef]
      exact (geometricModuleStalkGerm_map B S hS ⟨F, hF⟩ x G (e ≫ q) t).trans htg
    exact ⟨Z', ⟨v, hv⟩, hgerm⟩

end AlgebraicGeometry.Space

end
