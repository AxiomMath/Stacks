-/

@[expose] public section

open CategoryTheory Opposite

universe w v u v' u'

namespace Stacks

namespace Sites

/-- A functor of sites is *pairwise cofiltered* when any two morphisms of the target into
images of objects of the source factor through the image of a single object.  Equivalently,
every structured-arrow category over the functor admits a cone on each pair of objects. -/
def PairwiseCofiltered {C : Type u} [Category.{v} C] {D : Type u'} [Category.{v'} D]
    (G : C ⥤ D) : Prop :=
  ∀ (U U' : C) (W : D) (p : W ⟶ G.obj U) (q : W ⟶ G.obj U'),
    ∃ (U'' : C) (α : U'' ⟶ U) (β : U'' ⟶ U') (r : W ⟶ G.obj U''),
      r ≫ G.map α = p ∧ r ≫ G.map β = q

/-- A functor preserving fibre products and sending a terminal object to a terminal object is
pairwise cofiltered: the common factorisation is the product of the two objects. -/
theorem pairwiseCofiltered_of_isTerminal {C : Type u} [Category.{v} C] {D : Type u'}
    [Category.{v'} D] (G : C ⥤ D) [Limits.HasPullbacks C]
    [Limits.PreservesLimitsOfShape Limits.WalkingCospan G] {T : C}
    (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal (G.obj T)) :
    PairwiseCofiltered G := by
  intro U U' W p q
  have hG := IsPullback.map G
    (IsPullback.of_hasPullback (hT.from U) (hT.from U'))
  exact ⟨Limits.pullback (hT.from U) (hT.from U'), Limits.pullback.fst _ _,
    Limits.pullback.snd _ _, hG.lift p q (hT'.hom_ext _ _), hG.lift_fst _ _ _,
    hG.lift_snd _ _ _⟩

end Sites

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
  {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D} {Gl : C ⥤ D}
  [Gl.IsContinuous J K] {R' : Sheaf K RingCat.{w}}
  (φ : R ⟶ (Gl.sheafPushforwardContinuous RingCat.{w} J K).obj R')

/-! ### The inverse image of an ideal sheaf -/

/-- The pullback along `φ` of a section of the base sheaf of rings. -/
def ringPullback {U : Cᵒᵖ} (a : R.obj.obj U) : R'.obj.obj (Gl.op.obj U) := φ.hom.app U a

/-- Pulling back a section of the base sheaf of rings commutes with restriction. -/
theorem ringPullback_map {U V : Cᵒᵖ} (g : U ⟶ V) (a : R.obj.obj U) :
    ringPullback φ (R.obj.map g a) = R'.obj.map (Gl.op.map g) (ringPullback φ a) :=
  CategoryTheory.ConcreteCategory.congr_hom (φ.hom.naturality g) a

/-- **The inverse image ideal sheaf `Gl^{-1}I · R'`**: the smallest ideal subsheaf of `R'` whose
sections over `Gl U` contain the pullbacks of the sections of `I` over `U`, for every `U`. -/
@[ega "0 4.3.5" "more general"]
noncomputable def inverseImageIdeal (I : (_root_.SheafOfModules.unit R).Submodule) :
    (_root_.SheafOfModules.unit R').Submodule :=
  sInf {N | ∀ (U : Cᵒᵖ) (a : R.obj.obj U), a ∈ I.obj U →
    ringPullback φ a ∈ N.obj (Gl.op.obj U)}

/-- The inverse image ideal sheaf contains the pullback of every section of `I`. -/
theorem ringPullback_mem_inverseImageIdeal (I : (_root_.SheafOfModules.unit R).Submodule)
    {U : Cᵒᵖ} {a : R.obj.obj U} (ha : a ∈ I.obj U) :
    ringPullback φ a ∈ (inverseImageIdeal φ I).obj (Gl.op.obj U) :=
  (_root_.SheafOfModules.Submodule.mem_sInf_obj
    (M := _root_.SheafOfModules.unit R') _ (Gl.op.obj U) (ringPullback φ a)).2
    fun _ hN => hN U a ha

/-- The inverse image ideal sheaf is the smallest ideal subsheaf of `R'` containing the
pullbacks of the sections of `I`. -/
theorem inverseImageIdeal_le (I : (_root_.SheafOfModules.unit R).Submodule)
    (N : (_root_.SheafOfModules.unit R').Submodule)
    (hN : ∀ (U : Cᵒᵖ) (a : R.obj.obj U), a ∈ I.obj U →
      ringPullback φ a ∈ N.obj (Gl.op.obj U)) :
    inverseImageIdeal φ I ≤ N :=
  sInf_le hN

variable (M : _root_.SheafOfModules.{w} R')

/-! ### The ideal annihilating the restrictions of one section -/

/-- The sections of `R'` over `W` which, after any further restriction, annihilate every
restriction of a fixed section `s` of `M` over `Gl V` along the image of a morphism out of
`V`. -/
def restrictionAnnihilatorIdealAt (V : Cᵒᵖ) (s : M.val.obj (Gl.op.obj V)) (W : Dᵒᵖ) :
    Ideal (R'.obj.obj W) where
  carrier := {b | ∀ (W' : Dᵒᵖ) (h : W ⟶ W') (V' : Cᵒᵖ) (g : V ⟶ V') (k : Gl.op.obj V' ⟶ W'),
    R'.obj.map h b • M.val.restrictₛₗ (Gl.op.map g ≫ k) s = 0}
  zero_mem' := by
    intro W' h V' g k
    rw [map_zero, zero_smul]
  add_mem' := by
    intro b c hb hc W' h V' g k
    rw [map_add, add_smul, hb W' h V' g k, hc W' h V' g k, add_zero]
  smul_mem' := by
    intro r b hb W' h V' g k
    change R'.obj.map h (r * b) • _ = 0
    rw [map_mul, mul_smul, hb W' h V' g k, smul_zero]

/-- Restricting `b • s'` along `p` restricts both the scalar and the section. -/
private theorem restrictₛₗ_map_smul_restrictₛₗ {A W W' Z : Dᵒᵖ} (b : R'.obj.obj W) (h : W ⟶ W')
    (g : A ⟶ W') (p : W' ⟶ Z) (s : M.val.obj A) :
    M.val.restrictₛₗ p (R'.obj.map h b • M.val.restrictₛₗ g s) =
      R'.obj.map (h ≫ p) b • M.val.restrictₛₗ (g ≫ p) s := by
  rw [map_smulₛₗ, ← restrictₛₗ_comp_apply, ← CategoryTheory.comp_apply, ← R'.obj.map_comp]

/-- The ideals `Stacks.SheafOfModules.restrictionAnnihilatorIdealAt` are stable under
restriction. -/
theorem restrictionAnnihilatorIdealAt_map (V : Cᵒᵖ) (s : M.val.obj (Gl.op.obj V))
    {W W' : Dᵒᵖ} (h : W ⟶ W') {b : R'.obj.obj W}
    (hb : b ∈ restrictionAnnihilatorIdealAt M V s W) :
    R'.obj.map h b ∈ restrictionAnnihilatorIdealAt M V s W' := by
  intro W'' h'' V' g k
  rw [← CategoryTheory.comp_apply, ← R'.obj.map_comp]
  exact hb W'' (h ≫ h'') V' g k

/-- Membership in `Stacks.SheafOfModules.restrictionAnnihilatorIdealAt` is local: it holds as
soon as it holds after the restrictions of a covering sieve. -/
theorem mem_restrictionAnnihilatorIdealAt_of_sieve (V : Cᵒᵖ) (s : M.val.obj (Gl.op.obj V))
    {W : Dᵒᵖ} (b : R'.obj.obj W) (T : Sieve W.unop) (hT : T ∈ K W.unop)
    (hb : ∀ ⦃Z : D⦄ (p : Z ⟶ W.unop), T p →
      R'.obj.map p.op b ∈ restrictionAnnihilatorIdealAt M V s (op Z)) :
    b ∈ restrictionAnnihilatorIdealAt M V s W := by
  intro W' h V' g k
  apply M.isSheaf.isSeparated _ _ (K.pullback_stable h.unop hT)
  intro Z p hp
  change M.val.restrictₛₗ p.op (R'.obj.map h b • M.val.restrictₛₗ (Gl.op.map g ≫ k) s) =
    M.val.restrictₛₗ p.op 0
  rw [restrictₛₗ_map_smul_restrictₛₗ, map_zero, Category.assoc]
  have := hb (p ≫ h.unop) hp (op Z) (𝟙 _) V' g (k ≫ p.op)
  rw [R'.obj.map_id] at this
  simpa using this

/-- The ideal subsheaf of `R'` of sections annihilating all restrictions of a fixed section `s`
of `M` over `Gl V` that come from morphisms out of `V`. -/
noncomputable def restrictionAnnihilatorIdeal (V : Cᵒᵖ) (s : M.val.obj (Gl.op.obj V)) :
    (_root_.SheafOfModules.unit R').Submodule where
  obj W := restrictionAnnihilatorIdealAt M V s W
  map h _ hb := restrictionAnnihilatorIdealAt_map M V s h hb
  isSheaf {_} b hb :=
    mem_restrictionAnnihilatorIdealAt_of_sieve M V s b _ hb fun _ _ hp => hp

/-! ### The direct image of a submodule sheaf -/

omit [Gl.IsContinuous J K] in
/-- A section of `M` over `Gl V` lying in a submodule sheaf `N` after the restrictions of a
covering sieve of `V` lies in `N`. -/
theorem mem_of_sieve_functorPushforward (hGl : CoverPreserving J K Gl)
    (N : M.Submodule) (V : Cᵒᵖ) (s : M.val.obj (Gl.op.obj V)) (T : Sieve V.unop)
    (hT : T ∈ J V.unop)
    (h : ∀ ⦃Y : C⦄ (p : Y ⟶ V.unop), T p →
      M.val.restrictₛₗ (Gl.map p).op s ∈ N.toSubmodule.obj (op (Gl.obj Y))) :
    s ∈ N.toSubmodule.obj (Gl.op.obj V) := by
  refine N.isSheaf (X := Gl.op.obj V) s (K.superset_covering ?_ (hGl.cover_preserve hT))
  rintro Z _ ⟨Y, p, q, hq, rfl⟩
  change M.val.restrictₛₗ ((Gl.map p).op ≫ q.op) s ∈ N.toSubmodule.obj (op Z)
  rw [restrictₛₗ_comp_apply]
  exact N.toSubmodule.map_mem q.op (h p hq)

/-- **The direct image `Gl_*N ⊆ Gl_*M` of a submodule sheaf `N ⊆ M`**: its sections over `V`
are the sections of `N` over `Gl V`. -/
noncomputable def pushforwardSubmodule (hGl : CoverPreserving J K Gl) (N : M.Submodule) :
    ((_root_.SheafOfModules.pushforward.{w} φ).obj M).Submodule where
  obj V :=
    { carrier := {x : ((_root_.SheafOfModules.pushforward.{w} φ).obj M).val.obj V |
        x ∈ N.toSubmodule.obj (Gl.op.obj V)}
      zero_mem' := (N.toSubmodule.obj (Gl.op.obj V)).zero_mem
      add_mem' := fun hx hy => (N.toSubmodule.obj (Gl.op.obj V)).add_mem hx hy
      smul_mem' := fun a _ hx => (N.toSubmodule.obj (Gl.op.obj V)).smul_mem
        (ringPullback φ a) hx }
  map g _ hx := N.toSubmodule.map_mem (Gl.op.map g) hx
  isSheaf {V} s hs :=
    mem_of_sieve_functorPushforward M hGl N V s _ hs fun _ _ hp => hp

/-! ### Tag 0858 -/

/-- A section of `M` over `Gl V` annihilated by the pullbacks of the sections of `I` over the
objects above `V` is annihilated by the whole inverse image ideal sheaf `Gl^{-1}I · R'`. -/
theorem mem_annihilatorSubmodule_inverseImageIdeal
    (hcomm' : ∀ (W : Dᵒᵖ) (a b : R'.obj.obj W), a * b = b * a)
    (hGl : Sites.PairwiseCofiltered Gl)
    (I : (_root_.SheafOfModules.unit R).Submodule) (V : Cᵒᵖ) (s : M.val.obj (Gl.op.obj V))
    (hs : ∀ (V' : Cᵒᵖ) (g : V ⟶ V') (a : R.obj.obj V'), a ∈ I.obj V' →
      ringPullback φ a • M.val.restrictₛₗ (Gl.op.map g) s = 0) :
    s ∈ (annihilatorSubmodule M hcomm' (inverseImageIdeal φ I)).obj (Gl.op.obj V) := by
  have hle : inverseImageIdeal φ I ≤ restrictionAnnihilatorIdeal M V s := by
    refine inverseImageIdeal_le φ I _ ?_
    intro U a ha W' h' V' g k
    obtain ⟨U'', α, β, r, hα, hβ⟩ := hGl U.unop V'.unop W'.unop h'.unop k.unop
    have e1 : Gl.op.map α.op ≫ r.op = h' := Quiver.Hom.unop_inj (by simpa using hα)
    have e2 : Gl.op.map β.op ≫ r.op = k := Quiver.Hom.unop_inj (by simpa using hβ)
    have h3 := congrArg (M.val.restrictₛₗ r.op)
      (hs (op U'') (g ≫ β.op) (R.obj.map α.op a) (I.toSubmodule.map_mem α.op ha))
    rwa [ringPullback_map, Gl.op.map_comp, restrictₛₗ_map_smul_restrictₛₗ, map_zero,
      Category.assoc, e1, e2] at h3
  intro W h b hb
  have h2 := hle W hb W (𝟙 W) V (𝟙 V) h
  rw [show Gl.op.map (𝟙 V) ≫ h = h by simp] at h2
  simpa using h2

/-- **The sections of the two subsheaves of [Stacks, Tag 0858] agree.**  A section of `Gl_*M`
over `V` is annihilated by `I` exactly when, read as a section of `M` over `Gl V`, it is
annihilated by the inverse image ideal sheaf `Gl^{-1}I · R'`. -/
theorem mem_annihilatorSubmodule_pushforward_iff
    (hcomm : ∀ (U : Cᵒᵖ) (a b : R.obj.obj U), a * b = b * a)
    (hcomm' : ∀ (W : Dᵒᵖ) (a b : R'.obj.obj W), a * b = b * a)
    (hGl : Sites.PairwiseCofiltered Gl)
    (I : (_root_.SheafOfModules.unit R).Submodule) (V : Cᵒᵖ)
    (s : ((_root_.SheafOfModules.pushforward.{w} φ).obj M).val.obj V) :
    s ∈ (annihilatorSubmodule ((_root_.SheafOfModules.pushforward.{w} φ).obj M) hcomm I).obj V ↔
      s ∈ (annihilatorSubmodule M hcomm' (inverseImageIdeal φ I)).obj (Gl.op.obj V) := by
  constructor
  · exact fun h => mem_annihilatorSubmodule_inverseImageIdeal φ M hcomm' hGl I V s
      fun V' g a ha => h V' g a ha
  · intro h V' g a ha
    change ringPullback φ a • M.val.restrictₛₗ (Gl.op.map g) s = 0
    exact h (Gl.op.obj V') (Gl.op.map g) _ (ringPullback_mem_inverseImageIdeal φ I ha)

/-- **[Stacks, Tag 0858].**  Let `Gl_* : Mod(R') ⥤ Mod(R)` be the direct image of modules along
a continuous, cover-preserving and pairwise cofiltered functor of sites, and let `I ⊆ R` be an
ideal subsheaf.  The direct image of the subsheaf of sections of `M` annihilated by the inverse
image ideal sheaf `Gl^{-1}I · R'` is the subsheaf of sections of `Gl_*M` annihilated by `I`.

The source states this for a quasi-compact and quasi-separated morphism of algebraic spaces,
a quasi-coherent ideal sheaf of finite type and a quasi-coherent module; none of those
hypotheses is used, and none is needed to state either subsheaf. -/
theorem pushforwardSubmodule_annihilatorSubmodule (hGlc : CoverPreserving J K Gl)
    (hcomm : ∀ (U : Cᵒᵖ) (a b : R.obj.obj U), a * b = b * a)
    (hcomm' : ∀ (W : Dᵒᵖ) (a b : R'.obj.obj W), a * b = b * a)
    (hGl : Sites.PairwiseCofiltered Gl)
    (I : (_root_.SheafOfModules.unit R).Submodule) :
    pushforwardSubmodule φ M hGlc (annihilatorSubmodule M hcomm' (inverseImageIdeal φ I)) =
      annihilatorSubmodule ((_root_.SheafOfModules.pushforward.{w} φ).obj M) hcomm I :=
  _root_.SheafOfModules.Submodule.ext (PresheafOfModules.Submodule.ext fun V =>
    Submodule.ext fun s =>
      (mem_annihilatorSubmodule_pushforward_iff φ M hcomm hcomm' hGl I V s).symm)

end SheafOfModules

end Stacks

namespace AlgebraicGeometry.Space

open Stacks

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- Base change on the spaces-étale sites of a morphism of algebraic spaces is pairwise
cofiltered: two étale algebraic spaces over `Y` have a fibre product over `Y`, and base change
preserves it and the terminal object. -/
theorem pairwiseCofiltered_spacesBaseChange (f : X ⟶ Y) :
    Sites.PairwiseCofiltered (spacesBaseChange B S hS f).functor :=
  Sites.pairwiseCofiltered_of_isTerminal _ (SpacesEtale.isTerminal_idObj B S hS Y)
    (isTerminal_spacesBaseChange_idObj B S hS f)

/-- The structure map `f^♯ : 𝒪_Y ⟶ f_*𝒪_X` of [Stacks, Tag 03G8] on the spaces-étale sites, as
a map of sheaves of (not necessarily commutative) rings — the form in which sheaves of modules
consume it. -/
noncomputable def spacesEtaleSharpRing (f : X ⟶ Y) :
    (Stacks.SheafOfModules.Tensor.ringSheaf (spacesEtaleRingedSite B S hS Y).O) ⟶
      ((spacesBaseChange B S hS f).functor.sheafPushforwardContinuous RingCat.{u + 1}
        (SpacesEtale.topology B S hS Y) (SpacesEtale.topology B S hS X)).obj
        ((Stacks.SheafOfModules.Tensor.ringSheaf (spacesEtaleRingedSite B S hS X).O)) :=
  (sheafCompose (SpacesEtale.topology B S hS Y) (forget₂ CommRingCat.{u + 1} RingCat.{u + 1})).map
    (spacesEtaleRingedSiteHom B S hS f).fsharp

/-- **[Stacks, Tag 0858].**  Let `f : X ⟶ Y` be a morphism of algebraic spaces, `I ⊆ 𝒪_Y` a
sheaf of ideals and `M` an `𝒪_X`-module on the spaces-étale site.  The direct image along `f`
of the subsheaf of sections of `M` annihilated by `f^{-1}I · 𝒪_X` is the subsheaf of sections
of `f_*M` annihilated by `I`.

The source assumes `f` quasi-compact and quasi-separated, `I` quasi-coherent of finite type and
`M` quasi-coherent; all three are discharged as unnecessary, being needed in the source only so
that the subsheaf of [Stacks, Tag 0857] is available for `I` and `f_*M`. -/
@[stacks 0858]
theorem pushforwardSubmodule_annihilatorSubmodule (f : X ⟶ Y)
    (I : (SheafOfModules.unit
      ((Stacks.SheafOfModules.Tensor.ringSheaf (spacesEtaleRingedSite B S hS Y).O))).Submodule)
    (M : SheafOfModules.{u + 1}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (spacesEtaleRingedSite B S hS X).O))) :
    Stacks.SheafOfModules.pushforwardSubmodule (spacesEtaleSharpRing B S hS f) M
        (CoverPreserving.of_isContinuous _ _ _)
        (Stacks.SheafOfModules.annihilatorSubmodule M
          (RingedSite.mul_comm_ringSheaf (spacesEtaleRingedSite B S hS X))
          (Stacks.SheafOfModules.inverseImageIdeal (spacesEtaleSharpRing B S hS f) I)) =
      Stacks.SheafOfModules.annihilatorSubmodule
        ((_root_.SheafOfModules.pushforward.{u + 1}
          (spacesEtaleSharpRing B S hS f)).obj M)
        (RingedSite.mul_comm_ringSheaf (spacesEtaleRingedSite B S hS Y)) I :=
  Stacks.SheafOfModules.pushforwardSubmodule_annihilatorSubmodule _ M _ _ _
    (pairwiseCofiltered_spacesBaseChange B S hS f) I

end AlgebraicGeometry.Space

