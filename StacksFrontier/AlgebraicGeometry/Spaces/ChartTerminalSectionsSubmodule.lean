module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSubmoduleRestrictionSections
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeSubmoduleAffineSpace
public import StacksFrontier.AlgebraicGeometry.Spaces.FreeModuleSections

/-!
# The submodule generated by sections over a terminal chart, on affine charts

Let `F` be an algebraic space whose small étale site has a terminal chart `T₀`, `M` a
quasi-coherent `𝒪_F`-module and `a : I → M(T₀)` a family of sections. The submodule
`K ⊆ M` they generate is the image of `𝒪^I ⟶ M`
(`AlgebraicGeometry.Space.terminalSectionsHom`). This file computes it on affine data:

* over an affine étale chart `T`, the sections of `K` are the `𝒪(T)`-span of the restrictions
  `a i|_T`;
* over an affine open `O` of the chart scheme of an étale chart `W`, the sections of the chart
  restriction `K|_W` (`AlgebraicGeometry.Space.restrictSubmoduleToChart`) are the `𝒪(O)`-span of
  the readings of the restrictions `a i|_O`.

The second statement is the bridge between site-level submodules generated by sections and
Zariski submodules generated by their readings, used to pass between the étale site of an affine
member of an elementary distinguished square and the Zariski site of its scheme in the induction
[Stacks, Tag 08GP] for the module form of [Stacks, Tag 0829].

## Main results

* `AlgebraicGeometry.Space.terminalSectionsHom_app_ιFree`: the morphism `𝒪^I ⟶ M` on the `i`-th
  coordinate over a chart `T` is `r ↦ r • a i|_T`.
* `AlgebraicGeometry.Space.imageSubmodule_terminalSectionsHom_obj_eq_span`: **over an affine
  chart the generated submodule is the span of the restricted generators.**
* `AlgebraicGeometry.Space.mem_restrictSubmoduleToChart_imageSubmodule_terminalSectionsHom_iff`:
  **over an affine open of a chart scheme the chart restriction of the generated submodule is
  the span of the readings of the restricted generators.**

## References

* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 08GP](https://stacks.math.columbia.edu/tag/08GP)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.SheafOfModules.ImageSubsheaf

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

section Site

variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-- The morphism `𝒪^I ⟶ M` defined by sections `a` over a terminal chart sends `r` in the
`i`-th coordinate over a chart `T` to `r • a i|_T`. -/
theorem terminalSectionsHom_app_ιFree (M : Modules.{u, u} B S hS F hF)
    {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀) {I : Type u}
    (a : I → M.val.obj (op T₀)) (i : I) (T : SmallEtale B S hS F)
    (r : chartRing B S hS F hF T) :
    (terminalSectionsHom M hT₀ a).val.app (op T)
        (((SheafOfModules.ιFree (R := (Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)) i).val.app (op T)).hom r) =
      r • chartRestrictLinear M (hT₀.from T) (a i) := by
  let σ := (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT₀).symm (a i)
  have h1 : SheafOfModules.ιFree i ≫ terminalSectionsHom M hT₀ a = M.unitHomEquiv.symm σ := by
    rw [← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply]
    unfold terminalSectionsHom
    rw [Equiv.apply_symm_apply]
  have h2 : (M.unitHomEquiv.symm σ).val.app (op T) (1 : chartRing B S hS F hF T) =
      σ.val (op T) := by
    rw [← SheafOfModules.unitHomEquiv_apply_coe, Equiv.apply_symm_apply]
  have h3 := congrArg (fun g => g.val.app (op T) r) h1
  simp only [SheafOfModules.comp_val] at h3
  have h4 : (M.unitHomEquiv.symm σ).val.app (op T) r =
      r • (M.unitHomEquiv.symm σ).val.app (op T) (1 : chartRing B S hS F hF T) :=
    (congrArg _ (mul_one r).symm).trans
      (((M.unitHomEquiv.symm σ).val.app (op T)).hom.map_smul r (1 : chartRing B S hS F hF T))
  exact h3.trans (h4.trans (congrArg (r • ·) h2))

/-- **Over an affine chart, the submodule generated by sections over a terminal chart is the
span of their restrictions.** The sections of the free module over an affine chart are the
finitely supported families (`AlgebraicGeometry.Space.bijective_freeSectionsMap_of_isAffine`),
and the sections of the image submodule are the range of `𝒪^I ⟶ M` there
(`AlgebraicGeometry.Space.mem_imageSubmodule_iff_of_isAffine`). -/
theorem imageSubmodule_terminalSectionsHom_obj_eq_span (M : Modules.{u, u} B S hS F hF)
    (hM : M.IsQuasicoherentOnSite) {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀)
    {I : Type u} (a : I → M.val.obj (op T₀)) (T : SmallEtale B S hS F)
    (hT : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj T)) :
    (imageSubmodule (terminalSectionsHom M hT₀ a)).obj (op T) =
      Submodule.span (chartRing B S hS F hF T)
        (Set.range fun i => chartRestrictLinear M (hT₀.from T) (a i)) := by
  refine le_antisymm (fun x hx => ?_) (Submodule.span_le.2 ?_)
  · obtain ⟨y, rfl⟩ := (mem_imageSubmodule_iff_of_isAffine _
      (isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
        (isCartesianOnAffineCharts_free (hF := hF) I)) hM T hT x).1 hx
    obtain ⟨c, rfl⟩ := (bijective_freeSectionsMap_of_isAffine B S hS F hF I T hT).2 y
    clear hx
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add f g hf hg =>
      rw [map_add, map_add]
      exact Submodule.add_mem _ hf hg
    | single i r =>
      rw [Stacks.Sites.freeSectionsMap_single, terminalSectionsHom_app_ιFree]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  · rintro _ ⟨i, rfl⟩
    exact (imageSubmodule (terminalSectionsHom M hT₀ a)).map_mem (hT₀.from T).op
      (mem_imageSubmodule_terminalSectionsHom M hT₀ a i)

end Site

section Chart

variable (X : AlgebraicSpaces B S hS)

/-- The identification of the functions on a Zariski open of a chart scheme with the functions
on the étale chart it cuts out is surjective. -/
theorem surjective_chartSchemeRestrictionRingHom_app (W : SmallEtale B S hS X.1)
    (O : (chartScheme W).Opens) :
    Function.Surjective ((chartSchemeRestrictionRingHom B S hS X.1 W).app (op O)).hom := by
  have : IsIso ((chartSchemeRestrictionRingHom B S hS X.1 W).app (op O)) := by
    change IsIso ((forget₂ CommRingCat RingCat).map
      ((Scheme.restrictFunctorΓ (X := chartScheme W)).inv.app (op O)))
    infer_instance
  intro r
  refine ⟨(inv ((chartSchemeRestrictionRingHom B S hS X.1 W).app (op O))).hom r, ?_⟩
  rw [← RingCat.comp_apply, IsIso.inv_hom_id]
  rfl

/-- **The chart restriction of the submodule generated by sections over a terminal chart, over an
affine open of a chart scheme, is the span of the readings of the restricted generators.** This
is the bridge between the site-level submodule generated by finitely many sections and the
Zariski submodule generated by their readings. -/
theorem mem_restrictSubmoduleToChart_imageSubmodule_terminalSectionsHom_iff
    (M : Modules.{u, u} B S hS X.1 X.2) (hM : M.IsQuasicoherentOnSite)
    {T₀ : SmallEtale B S hS X.1} (hT₀ : IsTerminal T₀) {I : Type u}
    (a : I → M.val.obj (op T₀)) (W : SmallEtale B S hS X.1) (O : (chartScheme W).Opens)
    (hO : IsAffineOpen O) (y : (restrictToChartScheme B S hS X.1 X.2 M W).val.obj (op O)) :
    y ∈ (restrictSubmoduleToChart M (imageSubmodule (terminalSectionsHom M hT₀ a)) W).obj
        (op O) ↔
      y ∈ Submodule.span ((chartScheme W).ringCatSheaf.obj.obj (op O))
        (Set.range fun i => chartSectionsToRestrict X M W O
          (chartRestrictLinear M (hT₀.from (openChart B S hS X.1 W O)) (a i))) := by
  have hOa : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj
      (openChart B S hS X.1 W O)) := hO
  obtain ⟨x, rfl⟩ := (bijective_chartSectionsToRestrict X M W O).2 y
  rw [chartSectionsToRestrict_mem_restrictSubmoduleToChart_iff,
    imageSubmodule_terminalSectionsHom_obj_eq_span M hM hT₀ a _ hOa]
  let cs := chartSectionsToRestrict X M W O
  refine ⟨fun hx => ?_, fun hy => ?_⟩
  · induction hx using Submodule.span_induction with
    | mem _ hz =>
      obtain ⟨i, rfl⟩ := hz
      exact Submodule.subset_span ⟨i, rfl⟩
    | zero => simp
    | add z z' _ _ hz hz' =>
      rw [map_add]
      exact Submodule.add_mem _ hz hz'
    | smul c z _ hz =>
      obtain ⟨r, rfl⟩ := surjective_chartSchemeRestrictionRingHom_app X W O c
      exact chartSectionsToRestrict_smul X M W O r z ▸ Submodule.smul_mem _ r hz
  · let P : Submodule ((chartScheme W).ringCatSheaf.obj.obj (op O))
        ((restrictToChartScheme B S hS X.1 X.2 M W).val.obj (op O)) :=
      { carrier := {y | ∃ z ∈ Submodule.span
          (chartRing B S hS X.1 X.2 (openChart B S hS X.1 W O))
          (Set.range fun i =>
            chartRestrictLinear M (hT₀.from (openChart B S hS X.1 W O)) (a i)),
            cs z = y}
        zero_mem' := ⟨0, Submodule.zero_mem _, map_zero cs⟩
        add_mem' := fun {_ _} ⟨z, hz, e⟩ ⟨z', hz', e'⟩ =>
          ⟨z + z', Submodule.add_mem _ hz hz', by rw [map_add, e, e']⟩
        smul_mem' := fun r _ ⟨z, hz, e⟩ =>
          ⟨(show chartRing B S hS X.1 X.2 (openChart B S hS X.1 W O) from
            ((chartSchemeRestrictionRingHom B S hS X.1 W).app (op O)).hom r) • z,
            Submodule.smul_mem _ _ hz, by
              rw [← e]
              exact chartSectionsToRestrict_smul X M W O r z⟩ }
    obtain ⟨z, hz, e⟩ := (Submodule.span_le (p := P)).2 (by
      rintro _ ⟨i, rfl⟩
      exact ⟨_, Submodule.subset_span ⟨i, rfl⟩, rfl⟩) hy
    exact (bijective_chartSectionsToRestrict X M W O).1 e ▸ hz

end Chart

end AlgebraicGeometry.Space

end
