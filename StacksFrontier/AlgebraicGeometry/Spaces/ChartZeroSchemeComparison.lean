module

public import Mathlib.RingTheory.Regular.RegularSequence
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdeals
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleDescentIdealMembership

/-!
# A closed subspace, base changed to an étale chart, is a scheme-theoretic zero scheme

Let `X` be an algebraic space over a scheme `S` contained in a big fppf site, let `Z ⊆ X` be a
closed subspace and let `U` be an étale chart of `X` whose underlying scheme is affine.  The
inclusion of `Z` is representable, so the base change `Z ×_X U` is a scheme and the projection
`Z ×_X U ⟶ U` is a closed immersion of schemes.  Its kernel is the ideal sheaf cut out on the
affine scheme `U` by the defining ideal of `Z` at the chart, and a closed immersion identifies
its source with the closed subscheme cut out by its kernel.

For `Z = V(f₁, …, f_r)` the closed subspace cut out by finitely many global regular functions
the defining ideal at an affine chart is the ideal generated by the restrictions
`f₁|_U, …, f_r|_U`, by `AlgebraicGeometry.Space.exists_vanishingSubfunctor_eq`.  Hence

`V(f₁, …, f_r) ×_X U ≅ V(f₁|_U, …, f_r|_U)`

as closed subschemes of `U`, with the right-hand side the scheme-theoretic zero scheme of the
restricted functions, that is the closed subscheme of
`AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop` on the ideal they span.

## Main definitions

* `AlgebraicGeometry.Space.chartBaseChangeHom`: the closed immersion of schemes
  `Z ×_X U ⟶ U` base changing the inclusion of a closed subspace along an étale chart.

## Main results

* `AlgebraicGeometry.Space.ker_chartBaseChangeHom`: for an affine chart, the kernel of that
  closed immersion is `ofIdealTop` applied to the defining ideal of `Z` at the chart.
* `AlgebraicGeometry.Space.exists_iso_subscheme_ofIdealTop_definingIdealAt`: the base change is
  therefore isomorphic, over the chart, to the closed subscheme cut out by that ideal.
* `AlgebraicGeometry.Space.exists_closedSubspace_ker_chartBaseChangeHom_eq` and
  `AlgebraicGeometry.Space.exists_closedSubspace_iso_zeroScheme_chartBaseChange`: **for
  `V(f₁, …, f_r)` the base change along an affine étale chart is the scheme-theoretic zero
  scheme of the restricted functions**, with no hypothesis.

The ideal cut out is written both as the span of the range of the restricted functions and, by
`Ideal.ofList_ofFn`, in the `Ideal.ofList (List.ofFn _)` form in which the scheme-level slicing
lemma Stacks 06LI phrases its zero scheme.

## Implementation notes

The base change is taken through the representability datum
`CategoryTheory.Functor.relativelyRepresentable` carried by the closed immersion `Z ⟶ X`, so no
fibre product of presheaves is formed: `Z ×_X U` *is* an object of the big fppf site, and the
morphism to the chart is a morphism of schemes to begin with.  Closedness of that immersion is
the defining property of a closed immersion of algebraic spaces, applied to the pullback square
of the representability datum.

The kernel computation is `AlgebraicGeometry.Space.definingIdealAt_eq_ker`, which identifies the
defining ideal of a closed subspace at a chart with the kernel of pullback of global regular
functions along exactly this closed immersion, combined with
`AlgebraicGeometry.Scheme.ker_of_isAffine`: over an affine target an ideal sheaf is determined
by its ideal of global sections, which is where affineness of the chart enters.  Nothing else in
the comparison uses it.

The isomorphism with the zero scheme is `AlgebraicGeometry.Scheme.Hom.toImage`, an isomorphism
for a closed immersion, transported along the kernel computation; it is produced existentially
together with the identity exhibiting it as an isomorphism *over* the chart, since that
compatibility and not the bare isomorphism is what a comparison of closed subschemes means.

## References

* [Stacks Project, Tag 03MB](https://stacks.math.columbia.edu/tag/03MB)
* [Stacks Project, Section 06LV](https://stacks.math.columbia.edu/tag/06LV)
* [Stacks Project, Tag 06LI](https://stacks.math.columbia.edu/tag/06LI)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-- **A closed immersion with a prescribed kernel identifies its source with the closed
subscheme that kernel cuts out.**  The identification is a morphism over the target. -/
private theorem exists_iso_subscheme_of_ker_eq {W T : Scheme.{u}} (j : W ⟶ T)
    [IsClosedImmersion j] (I : T.IdealSheafData) (hI : j.ker = I) :
    ∃ e : W ≅ I.subscheme, e.hom ≫ I.subschemeι = j := by
  subst hI
  exact ⟨asIso j.toImage, j.toImage_imageι⟩

namespace Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The base change of a closed subspace along an étale chart -/

/-- The base change `Z ×_X U ⟶ U` of the inclusion of a closed subspace `Z ⊆ X` along an étale
chart `U` of `X`, read as a morphism of schemes through the representability datum of the
inclusion. -/
abbrev chartBaseChangeHom (X : AlgebraicSpaces B S hS) (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1) :
    (BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback U.1.hom) ⟶
      (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj U) :=
  (BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd U.1.hom)

/-- **The base change of a closed subspace along an étale chart is a closed immersion of
schemes.**  This is the defining property of a closed immersion of algebraic spaces, applied to
the pullback square of the representability datum. -/
instance isClosedImmersion_chartBaseChangeHom (X : AlgebraicSpaces B S hS)
    (Z : ClosedSubspaces B S hS X.1) (U : SmallEtale B S hS X.1) :
    _root_.AlgebraicGeometry.IsClosedImmersion (chartBaseChangeHom B S hS X Z U) :=
  Z.2.2.property U.1.hom (Z.2.2.rep.fst U.1.hom) (Z.2.2.rep.snd U.1.hom)
    (Z.2.2.rep.isPullback U.1.hom)

/-- **The kernel of the base changed closed immersion is the defining ideal of the closed
subspace at the chart.**  Over an affine chart an ideal sheaf is determined by its ideal of
global sections, and that ideal is the kernel of pullback of regular functions along the
immersion, which is `AlgebraicGeometry.Space.definingIdealAt`. -/
theorem ker_chartBaseChangeHom (X : AlgebraicSpaces B S hS) (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (chartBaseChangeHom B S hS X Z U).ker =
      Scheme.IdealSheafData.ofIdealTop (definingIdealAt B S hS X Z (op U)) := by
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj U)) :=
    hU
  rw [Scheme.ker_of_isAffine, definingIdealAt_eq_ker B S hS X Z U, Scheme.Γ_map_op]
  rfl

/-- **The base change of a closed subspace along an affine étale chart is the closed subscheme
cut out by the defining ideal of the subspace at that chart**, as a closed subscheme of the
chart. -/
theorem exists_iso_subscheme_ofIdealTop_definingIdealAt (X : AlgebraicSpaces B S hS)
    (Z : ClosedSubspaces B S hS X.1) (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    ∃ e : (BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback U.1.hom) ≅
        (Scheme.IdealSheafData.ofIdealTop (definingIdealAt B S hS X Z (op U))).subscheme,
      e.hom ≫
          (Scheme.IdealSheafData.ofIdealTop (definingIdealAt B S hS X Z (op U))).subschemeι =
        chartBaseChangeHom B S hS X Z U :=
  exists_iso_subscheme_of_ker_eq _ _ (ker_chartBaseChangeHom B S hS X Z U hU)

/-! ### The zero scheme of finitely many global functions on an affine chart -/

/-- **`V(f₁, …, f_r)` is a closed subspace whose base change along every affine étale chart has
the ideal generated by the restricted functions as its kernel**, with no hypothesis.

The closed subspace and the identification of its defining ideal with the ideal of the functions
come from `AlgebraicGeometry.Space.exists_vanishingSubfunctor_eq`; the kernel computation is
`AlgebraicGeometry.Space.ker_chartBaseChangeHom`. -/
theorem exists_closedSubspace_ker_chartBaseChangeHom_eq (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    ∃ Z : ClosedSubspaces B S hS X.1,
      vanishingSubfunctor B S hS X f = Z.1 ∧
        ∀ (U : SmallEtale B S hS X.1),
          IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) →
          (chartBaseChangeHom B S hS X Z U).ker =
            Scheme.IdealSheafData.ofIdealTop
              (Ideal.span (Set.range fun i => (f i).eval (op U))) := by
  obtain ⟨Z, hZeq, hZid⟩ := exists_vanishingSubfunctor_eq B S hS X f
  refine ⟨Z, hZeq, fun U hU => ?_⟩
  rw [ker_chartBaseChangeHom B S hS X Z U hU]
  congr 1
  rw [← definingIdealSheaf_obj B S hS X Z (op U), hZid,
    vanishingIdealSheaf_obj_of_isAffine B S hS X f U hU]
  rfl

/-- **The base change of `V(f₁, …, f_r)` along an affine étale chart `U` is the scheme-theoretic
zero scheme of the restricted functions `f₁|_U, …, f_r|_U`**, with no hypothesis.

The zero scheme is written with `Ideal.ofList (List.ofFn _)`, the form in which the scheme-level
slicing lemma Stacks 06LI states its conclusion. -/
theorem exists_closedSubspace_iso_zeroScheme_chartBaseChange (X : AlgebraicSpaces B S hS)
    {r : ℕ} (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    ∃ Z : ClosedSubspaces B S hS X.1,
      vanishingSubfunctor B S hS X f = Z.1 ∧
        ∀ (U : SmallEtale B S hS X.1),
          IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) →
          ∃ e : (BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback U.1.hom) ≅
              (Scheme.IdealSheafData.ofIdealTop
                (Ideal.ofList (List.ofFn fun i => (f i).eval (op U)))).subscheme,
            e.hom ≫ (Scheme.IdealSheafData.ofIdealTop
                  (Ideal.ofList (List.ofFn fun i => (f i).eval (op U)))).subschemeι =
              chartBaseChangeHom B S hS X Z U := by
  obtain ⟨Z, hZeq, hker⟩ := exists_closedSubspace_ker_chartBaseChangeHom_eq B S hS X f
  refine ⟨Z, hZeq, fun U hU => exists_iso_subscheme_of_ker_eq _ _ ?_⟩
  refine (hker U hU).trans ?_
  congr 1
  exact (Ideal.ofList_ofFn _).symm

end Space

end AlgebraicGeometry

end
