module

public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedEpsilonDerivationInjective
public import StacksFrontier.CategoryTheory.Sites.Modules.DerivationLocalExtension

/-!
# Stacks 0D0X: extending a Zariski derivation along `ε`, over affine charts

Let `U` be an object of the big fppf site over a scheme `S`, `X₀` its underlying scheme, `X = h_U`
the algebraic space it represents and `ε : X_étale ⟶ X_{0,Zar}` the morphism of Stacks 08H7.  Let
`T` be a sheaf of `𝒪_X`-modules and `D₀` a derivation of `𝒪_{X₀}` with values in `ε_*T`.

Over an affine chart `A` of `X` together with a morphism `j : A ⟶ ε(Z)` to the chart of an affine
open `Z` of `X₀`, the ring map `Γ(Z) = 𝒪_X(ε Z) ⟶ 𝒪_X(A)` is étale, so the Leibniz map
`s ↦ T(j)(D₀ s)` on `Γ(Z)` extends to a Leibniz map on `𝒪_X(A)`
(`Stacks.SheafOfModules.exists_leibnizHom_extension_of_etale`).  These local extensions are the
input of `Stacks.SheafOfModules.glueDerivationOfCover`, the affine charts mapping to such `ε(Z)`
covering every object.

## Main definitions

* `AlgebraicGeometry.Space.representedEpsilonAffineChart`: the affine charts of `X` admitting a
  morphism to the chart of an affine open of `X₀`.
* `AlgebraicGeometry.Space.representedEpsilonDerivationSeed`: `D₀` over `Z`, read on
  `𝒪_X(ε Z) = Γ(Z)`.

## Main results

* `AlgebraicGeometry.Space.generate_representedEpsilonAffineChart_mem`: those charts cover every
  object of the small étale site of `X`.
* `AlgebraicGeometry.Space.etale_representedStructureSheaf_map`: the restriction
  `𝒪_X(ε Z) ⟶ 𝒪_X(A)` along a morphism from an affine chart is étale.
* `AlgebraicGeometry.Space.exists_representedEpsilonLocalDerivation`: the local extension of `D₀`.

## References

* [Stacks Project, Tag 0D0X](https://stacks.math.columbia.edu/tag/0D0X)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (U : BigFppfOver B S hS)

/-- **The affine charts of `X = h_U` over an affine open of `X₀`**: the étale charts `A` whose
scheme is affine and which admit a morphism to the chart `ε(Z)` of an affine open `Z`. -/
def representedEpsilonAffineChart : ObjectProperty (SmallEtale B S hS (yoneda.obj U)) :=
  fun A =>
    IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj A) ∧
    ∃ Z : ((BigFppfOver.toScheme B S hS).obj U).Opens, IsAffineOpen Z ∧
      Nonempty (A ⟶ (representedEpsilonFunctor B S hS U).obj Z)

variable {V : BigFppfOver B S hS} (φ : U ⟶ V)

/-- A sieve generated by a property of charts is covering after pullback along `g : A' ⟶ A`, if the
property holds on the charts of the affine opens of `A'`. -/
private theorem pullback_generate_mem_of_openChart {A A' : SmallEtale B S hS (yoneda.obj U)}
    (g : A' ⟶ A) (P : SmallEtale B S hS (yoneda.obj U) → Prop)
    (hP : ∀ O : (chartScheme A').affineOpens, P (openChart B S hS _ A' O.1)) :
    (Sieve.generate (fun (Y : SmallEtale B S hS (yoneda.obj U)) (_ : Y ⟶ A) => P Y)).pullback g ∈
      (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).J A' := by
  refine GrothendieckTopology.superset_covering _ ?_
    (SmallEtale.ofArrows_openChart_affineOpens_mem B S hS _ A')
  rintro Y k ⟨Y', h, k', ⟨O⟩, rfl⟩
  exact ⟨_, h, openChartInclusion B S hS _ A' O.down.1 ≫ g, hP O.down, (Category.assoc _ _ _).symm⟩

include φ in
/-- **The affine charts over affine opens of `X₀` cover every object** of the small étale site
of `X = h_U`: the charts `ε(Z)` of the affine opens cover, and the affine opens of a chart mapping
to `ε(Z)` cover it. -/
theorem generate_representedEpsilonAffineChart_mem (A : SmallEtale B S hS (yoneda.obj U)) :
    Sieve.generate (fun (Y : SmallEtale B S hS (yoneda.obj U)) (_ : Y ⟶ A) =>
      representedEpsilonAffineChart B S hS U Y) ∈
        (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).J A := by
  refine GrothendieckTopology.transitive _
    (coversTop_representedEpsilonFunctor_affineSquare B S hS φ A) _ ?_
  rintro A' g ⟨i, ⟨j⟩⟩
  exact pullback_generate_mem_of_openChart B S hS U g _ fun O =>
    ⟨isAffine_chartScheme_openChart B S hS _ A' O, i.1.1, i.2.1,
      ⟨openChartInclusion B S hS _ A' O.1 ≫ j⟩⟩

/-- **The restriction `𝒪_X(ε Z) ⟶ 𝒪_X(A)` along a morphism from an affine chart is étale**, for
`Z` an affine open of `X₀`: the structure morphism of `A` is étale and factors through the étale
structure morphism of `ε(Z)`. -/
theorem etale_representedStructureSheaf_map
    {A : SmallEtale B S hS (yoneda.obj U)} {Z : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (j : A ⟶ (representedEpsilonFunctor B S hS U).obj Z) (hZ : IsAffineOpen Z)
    (hA : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A)) :
    ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map
      j.op).hom.Etale := by
  have hetA : Etale ((BigFppfOver.toScheme B S hS).map (yonedaEquiv A.1.hom)) :=
    etale_toScheme_representedChartBase B S hS U A
  have hetZ : Etale ((BigFppfOver.toScheme B S hS).map
      (yonedaEquiv ((representedEpsilonFunctor B S hS U).obj Z).1.hom)) :=
    etale_toScheme_representedChartBase B S hS U ((representedEpsilonFunctor B S hS U).obj Z)
  have hfac : (BigFppfOver.toScheme B S hS).map j.hom.left ≫
      (BigFppfOver.toScheme B S hS).map
        (yonedaEquiv ((representedEpsilonFunctor B S hS U).obj Z).1.hom) =
      (BigFppfOver.toScheme B S hS).map (yonedaEquiv A.1.hom) := by
    rw [← Functor.map_comp]
    congr 1
    apply yoneda.map_injective
    rw [Functor.map_comp, yoneda_map_yonedaEquiv, yoneda_map_yonedaEquiv]
    exact j.hom.w
  have h1 : Etale ((BigFppfOver.toScheme B S hS).map j.hom.left ≫
      (BigFppfOver.toScheme B S hS).map
        (yonedaEquiv ((representedEpsilonFunctor B S hS U).obj Z).1.hom)) := by
    rw [hfac]
    infer_instance
  have h2 : Etale ((BigFppfOver.toScheme B S hS).map j.hom.left) :=
    Etale.of_comp _ ((BigFppfOver.toScheme B S hS).map
      (yonedaEquiv ((representedEpsilonFunctor B S hS U).obj Z).1.hom))
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((representedEpsilonFunctor B S hS U).obj Z).1.left) :=
    isAffine_representedEpsilonFunctor_obj B S hS U hZ
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj A.1.left) := hA
  have he : (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map j.op
      = ((BigFppfOver.toScheme B S hS).map j.hom.left).appLE ⊤ ⊤ le_rfl :=
    (Scheme.Γ_map_op _).trans (Scheme.Hom.appLE_eq_app _).symm
  rw [he]
  exact ((BigFppfOver.toScheme B S hS).map j.hom.left).etale_appLE
    (isAffineOpen_top _) (isAffineOpen_top _) le_rfl

attribute [local instance] isContinuous_representedToZariskiRingedToposSiteHom_u

variable {U}
variable (T : SheafOfModules.{u + 1} (Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O))
  (D₀ : ((representedEpsilonModulePushforward B S hS U).obj T).val.Derivation'
    (representedZariskiSchemeHom B S hS φ).fSharpInverseImage.hom)

/-- `ε^♯` over a Zariski open `Z` undoes `Γ(Z) ≅ 𝒪_X(ε Z)`. -/
theorem representedToZariskiRingedToposSiteHom_fSharp_app_topIso_hom
    (Z : ((BigFppfOver.toScheme B S hS).obj U).Opens)
    (x : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op ((representedEpsilonFunctor B S hS U).obj Z)))) :
    ((representedToZariskiRingedToposSiteHom B S hS U).fSharp.hom.app (op Z)).hom
      ((Scheme.Opens.topIso Z).hom.hom x) = x :=
  (representedToZariskiRingedToposSiteHom_fSharp_app_apply B S hS U Z _).trans
    (ConcreteCategory.congr_hom (Scheme.Opens.topIso Z).hom_inv_id x)

/-- **The seed of the extension**: `D₀` over a Zariski open `Z`, read on `𝒪_X(ε Z) = Γ(Z)`, with
values in `T(ε Z) = (ε_*T)(Z)`. -/
def representedEpsilonDerivationSeed (Z : ((BigFppfOver.toScheme B S hS).obj U).Opens) :
    ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op ((representedEpsilonFunctor B S hS U).obj Z))) →+
      T.val.obj (op ((representedEpsilonFunctor B S hS U).obj Z)) :=
  (D₀.d (X := op Z)).comp (Scheme.Opens.topIso Z).hom.hom.toAddMonoidHom

/-- The seed satisfies the Leibniz rule over `𝒪_X(ε Z)`. -/
theorem representedEpsilonDerivationSeed_mul (Z : ((BigFppfOver.toScheme B S hS).obj U).Opens)
    (x y : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op ((representedEpsilonFunctor B S hS U).obj Z)))) :
    representedEpsilonDerivationSeed B S hS φ T D₀ Z (x * y) =
      x • representedEpsilonDerivationSeed B S hS φ T D₀ Z y +
        y • representedEpsilonDerivationSeed B S hS φ T D₀ Z x := by
  refine (congrArg (D₀.d (X := op Z)) (map_mul (Scheme.Opens.topIso Z).hom.hom x y)).trans
    ((D₀.d_mul _ _).trans ?_)
  exact congrArg₂ (· + ·)
    (congrArg (fun r : ToType ((smallEtaleRingedTopos B S hS
        (representedAlgebraicSpace B S hS U)).O.obj.obj
        (op ((representedEpsilonFunctor B S hS U).obj Z))) =>
      r • representedEpsilonDerivationSeed B S hS φ T D₀ Z y)
      (representedToZariskiRingedToposSiteHom_fSharp_app_topIso_hom B S hS Z x))
    (congrArg (fun r : ToType ((smallEtaleRingedTopos B S hS
        (representedAlgebraicSpace B S hS U)).O.obj.obj
        (op ((representedEpsilonFunctor B S hS U).obj Z))) =>
      r • representedEpsilonDerivationSeed B S hS φ T D₀ Z x)
      (representedToZariskiRingedToposSiteHom_fSharp_app_topIso_hom B S hS Z y))

/-- **The local extension of `D₀`**: over an affine chart `A` with a morphism `j : A ⟶ ε(Z)` to the
chart of an affine open, `s ↦ T(j)(D₀ s)` extends along the étale ring map `𝒪_X(ε Z) ⟶ 𝒪_X(A)` to
a Leibniz map on `𝒪_X(A)`. -/
theorem exists_representedEpsilonLocalDerivation
    {A : SmallEtale B S hS (yoneda.obj U)} {Z : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (j : A ⟶ (representedEpsilonFunctor B S hS U).obj Z) (hZ : IsAffineOpen Z)
    (hA : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A)) :
    ∃ δ : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
        (op A)) →+ T.val.obj (op A),
      (∀ x y, δ (x * y) = x • δ y + y • δ x) ∧
        ∀ s, δ ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map
          j.op s) = T.val.map j.op (representedEpsilonDerivationSeed B S hS φ T D₀ Z s) := by
  refine Stacks.SheafOfModules.exists_leibnizHom_extension_of_etale
    ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map j.op)
    (etale_representedStructureSheaf_map B S hS U j hZ hA) (M := ToType (T.val.obj (op A)))
    ((T.val.map j.op).hom.toAddMonoidHom.comp (representedEpsilonDerivationSeed B S hS φ T D₀ Z))
    fun x y => ?_
  show T.val.map j.op (representedEpsilonDerivationSeed B S hS φ T D₀ Z (x * y)) = _
  rw [representedEpsilonDerivationSeed_mul, map_add]
  exact congrArg₂ (· + ·) (PresheafOfModules.map_smul T.val j.op x _)
    (PresheafOfModules.map_smul T.val j.op y _)

/-- `Γ(Z) ≅ 𝒪_X(ε Z)` undoes `ε^♯` over a Zariski open `Z`. -/
theorem topIso_hom_representedToZariskiRingedToposSiteHom_fSharp_app
    (Z : ((BigFppfOver.toScheme B S hS).obj U).Opens)
    (t : ((BigFppfOver.toScheme B S hS).obj U).presheaf.obj (op Z)) :
    (Scheme.Opens.topIso Z).hom.hom
      (((representedToZariskiRingedToposSiteHom B S hS U).fSharp.hom.app (op Z)).hom t) = t :=
  (congrArg (Scheme.Opens.topIso Z).hom.hom
    (representedToZariskiRingedToposSiteHom_fSharp_app_apply B S hS U Z t)).trans
    (ConcreteCategory.congr_hom (Scheme.Opens.topIso Z).inv_hom_id t)

/-- **The seed is natural in the Zariski open**: restricting along `Z₂ ≤ Z₁` commutes with it. -/
theorem representedEpsilonDerivationSeed_map {Z₁ Z₂ : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (hle : Z₂ ≤ Z₁)
    (s : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op ((representedEpsilonFunctor B S hS U).obj Z₁)))) :
    representedEpsilonDerivationSeed B S hS φ T D₀ Z₂
        ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map
          ((representedEpsilonFunctor B S hS U).map (homOfLE hle)).op s) =
      T.val.map ((representedEpsilonFunctor B S hS U).map (homOfLE hle)).op
        (representedEpsilonDerivationSeed B S hS φ T D₀ Z₁ s) := by
  have hnat : ((representedToZariskiRingedToposSiteHom B S hS U).fSharp.hom.app (op Z₂)).hom
      (((BigFppfOver.toScheme B S hS).obj U).presheaf.map (homOfLE hle).op
        ((Scheme.Opens.topIso Z₁).hom.hom s)) =
      (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map
        ((representedEpsilonFunctor B S hS U).map (homOfLE hle)).op
        (((representedToZariskiRingedToposSiteHom B S hS U).fSharp.hom.app (op Z₁)).hom
          ((Scheme.Opens.topIso Z₁).hom.hom s)) :=
    ConcreteCategory.congr_hom
      ((representedToZariskiRingedToposSiteHom B S hS U).fSharp.hom.naturality (homOfLE hle).op)
      ((Scheme.Opens.topIso Z₁).hom.hom s)
  rw [representedToZariskiRingedToposSiteHom_fSharp_app_topIso_hom B S hS Z₁ s] at hnat
  show D₀.d ((Scheme.Opens.topIso Z₂).hom.hom
    ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map
      ((representedEpsilonFunctor B S hS U).map (homOfLE hle)).op s)) = _
  rw [← hnat, topIso_hom_representedToZariskiRingedToposSiteHom_fSharp_app]
  exact D₀.d_map (homOfLE hle).op _

include φ in
/-- **The affine charts over affine opens below `W` cover every chart mapping to `ε(W)`.**  The
affine opens below `W` cover `W`, `ε` preserves covering sieves, and the affine opens of a chart
mapping to `ε(Z₂)` cover it. -/
theorem generate_affineChart_le_mem {A : SmallEtale B S hS (yoneda.obj U)}
    {W : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (k : A ⟶ (representedEpsilonFunctor B S hS U).obj W) :
    Sieve.generate (fun (Y : SmallEtale B S hS (yoneda.obj U)) (_ : Y ⟶ A) =>
      IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj Y) ∧
        ∃ Z₂ : ((BigFppfOver.toScheme B S hS).obj U).Opens, IsAffineOpen Z₂ ∧ Z₂ ≤ W ∧
          Nonempty (Y ⟶ (representedEpsilonFunctor B S hS U).obj Z₂)) ∈
        (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).J A := by
  have hW : Sieve.generate (fun (Z₂ : ((BigFppfOver.toScheme B S hS).obj U).Opens) (_ : Z₂ ⟶ W) =>
      IsAffineOpen Z₂) ∈ ((BigFppfOver.toScheme B S hS).obj U).zariskiRingedTopos.J W := by
    intro x hx
    obtain ⟨_, ⟨Z₂, hZ₂, rfl⟩, hxZ, hZle⟩ :=
      ((BigFppfOver.toScheme B S hS).obj U).isBasis_affineOpens.exists_subset_of_mem_open hx
        W.isOpen
    exact ⟨Z₂, homOfLE hZle, ⟨Z₂, 𝟙 _, homOfLE hZle, hZ₂, Category.id_comp _⟩, hxZ⟩
  have h1 := GrothendieckTopology.pullback_stable _ k
    ((CoverPreserving.of_isContinuous (representedToZariskiRingedToposSiteHom B S hS U).u
      ((BigFppfOver.toScheme B S hS).obj U).zariskiRingedTopos.J
      (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).J).cover_preserve hW)
  refine GrothendieckTopology.transitive _ h1 _ ?_
  rintro A' g ⟨Z', q, h, ⟨Z₂, a, b, hZ₂, -⟩, -⟩
  exact pullback_generate_mem_of_openChart B S hS U g _ fun O =>
    ⟨isAffine_chartScheme_openChart B S hS _ A' O, Z₂, hZ₂, leOfHom b,
      ⟨openChartInclusion B S hS _ A' O.1 ≫ h ≫ (representedEpsilonFunctor B S hS U).map a⟩⟩

/-- The local extension of `D₀` over an affine chart with a morphism to the chart of an affine
open, chosen by `AlgebraicGeometry.Space.exists_representedEpsilonLocalDerivation`. -/
def representedEpsilonLocalDerivation
    {A : SmallEtale B S hS (yoneda.obj U)} {Z : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (j : A ⟶ (representedEpsilonFunctor B S hS U).obj Z) (hZ : IsAffineOpen Z)
    (hA : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A)) :
    ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op A)) →+ T.val.obj (op A) :=
  (exists_representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA).choose

/-- The local extension `representedEpsilonLocalDerivation` satisfies the Leibniz rule
`D(xy) = x • D(y) + y • D(x)`. -/
theorem representedEpsilonLocalDerivation_mul
    {A : SmallEtale B S hS (yoneda.obj U)} {Z : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (j : A ⟶ (representedEpsilonFunctor B S hS U).obj Z) (hZ : IsAffineOpen Z)
    (hA : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A))
    (x y : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op A))) :
    representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA (x * y) =
      x • representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA y +
        y • representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA x :=
  (exists_representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA).choose_spec.1 x y

/-- The local extension `representedEpsilonLocalDerivation` agrees with the restriction along `j`
of `representedEpsilonDerivationSeed` on sections pulled back from the chart of `Z`. -/
theorem representedEpsilonLocalDerivation_map
    {A : SmallEtale B S hS (yoneda.obj U)} {Z : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (j : A ⟶ (representedEpsilonFunctor B S hS U).obj Z) (hZ : IsAffineOpen Z)
    (hA : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A))
    (s : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op ((representedEpsilonFunctor B S hS U).obj Z)))) :
    representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA
        ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map j.op s) =
      T.val.map j.op (representedEpsilonDerivationSeed B S hS φ T D₀ Z s) :=
  (exists_representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA).choose_spec.2 s

/-- **Comparison of local extensions along a morphism of affine charts over nested affine
opens**: for `m : A₂ ⟶ A₁` and `Z₂ ≤ Z₁`, restricting the extension over `A₁` along `m` is the
extension over `A₂` after restriction.  Both are Leibniz maps on `𝒪_X(A₁)` agreeing on the image
of the formally unramified `𝒪_X(ε Z₁) ⟶ 𝒪_X(A₁)`. -/
theorem representedEpsilonLocalDerivation_comp
    {A₁ A₂ : SmallEtale B S hS (yoneda.obj U)}
    {Z₁ Z₂ : ((BigFppfOver.toScheme B S hS).obj U).Opens} (m : A₂ ⟶ A₁)
    (j₁ : A₁ ⟶ (representedEpsilonFunctor B S hS U).obj Z₁)
    (j₂ : A₂ ⟶ (representedEpsilonFunctor B S hS U).obj Z₂) (hZ₁ : IsAffineOpen Z₁)
    (hZ₂ : IsAffineOpen Z₂)
    (hA₁ : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A₁))
    (hA₂ : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A₂))
    (hle : Z₂ ≤ Z₁)
    (r : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op A₁))) :
    representedEpsilonLocalDerivation B S hS φ T D₀ j₂ hZ₂ hA₂
        ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map m.op r) =
      T.val.presheaf.map m.op (representedEpsilonLocalDerivation B S hS φ T D₀ j₁ hZ₁ hA₁ r) := by
  have hw : m ≫ j₁ = j₂ ≫ (representedEpsilonFunctor B S hS U).map (homOfLE hle) :=
    Subsingleton.elim _ _
  have hTT : ∀ {Y₁ Y₂ Y₃ : SmallEtale B S hS (yoneda.obj U)} (f : Y₁ ⟶ Y₂) (g : Y₂ ⟶ Y₃)
      (x : ToType (T.val.presheaf.obj (op Y₃))),
      T.val.presheaf.map f.op (T.val.presheaf.map g.op x) = T.val.presheaf.map (f ≫ g).op x := by
    intro Y₁ Y₂ Y₃ f g x
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  refine leibnizHom_comp_eq_of_formallyUnramified
    ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map j₁.op)
    (formallyUnramified_representedStructureSheaf_map B S hS U j₁ hZ₁ hA₁)
    ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map m.op)
    (M₁ := ToType (T.val.obj (op A₁))) (M₂ := ToType (T.val.obj (op A₂)))
    (T.val.presheaf.map m.op).hom (fun b x => PresheafOfModules.map_smul T.val m.op b x)
    _ _ (representedEpsilonLocalDerivation_mul B S hS φ T D₀ j₁ hZ₁ hA₁)
    (representedEpsilonLocalDerivation_mul B S hS φ T D₀ j₂ hZ₂ hA₂) (fun s => ?_) r
  have e1 : (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map m.op
      ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map j₁.op s) =
      (smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map j₂.op
      ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.map
        ((representedEpsilonFunctor B S hS U).map (homOfLE hle)).op s) := by
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hw, op_comp,
      Functor.map_comp, ConcreteCategory.comp_apply]
  refine (congrArg (representedEpsilonLocalDerivation B S hS φ T D₀ j₂ hZ₂ hA₂) e1).trans ?_
  refine (representedEpsilonLocalDerivation_map B S hS φ T D₀ j₂ hZ₂ hA₂ _).trans ?_
  refine (congrArg (T.val.presheaf.map j₂.op).hom
    (representedEpsilonDerivationSeed_map B S hS φ T D₀ hle s)).trans ?_
  refine (hTT j₂ ((representedEpsilonFunctor B S hS U).map (homOfLE hle)) _).trans ?_
  refine (congrArg (fun k => T.val.presheaf.map k.op
    (representedEpsilonDerivationSeed B S hS φ T D₀ Z₁ s)) hw.symm).trans ?_
  refine (hTT m j₁ _).symm.trans ?_
  exact congrArg (T.val.presheaf.map m.op).hom
    (representedEpsilonLocalDerivation_map B S hS φ T D₀ j₁ hZ₁ hA₁ s).symm

/-- **The local extension does not depend on the affine open**: two affine opens `Z`, `Z'` with
morphisms from the affine chart `A` give the same extension.  Both restrict, over the affine charts
of `A` mapping to affine opens below `Z ⊓ Z'`, to the extension there, and `T` is separated. -/
theorem representedEpsilonLocalDerivation_eq
    {A : SmallEtale B S hS (yoneda.obj U)} {Z Z' : ((BigFppfOver.toScheme B S hS).obj U).Opens}
    (j : A ⟶ (representedEpsilonFunctor B S hS U).obj Z)
    (j' : A ⟶ (representedEpsilonFunctor B S hS U).obj Z') (hZ : IsAffineOpen Z)
    (hZ' : IsAffineOpen Z')
    (hA : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj U) ⋙ BigFppfOver.toScheme B S hS).obj
      A))
    (r : ToType ((smallEtaleRingedTopos B S hS (representedAlgebraicSpace B S hS U)).O.obj.obj
      (op A))) :
    representedEpsilonLocalDerivation B S hS φ T D₀ j hZ hA r =
      representedEpsilonLocalDerivation B S hS φ T D₀ j' hZ' hA r := by
  let adj := representedImageOpenEpsilonAdjunction B S hS U
  let k : A ⟶ (representedEpsilonFunctor B S hS U).obj (Z ⊓ Z') :=
    adj.homEquiv A (Z ⊓ Z') (homOfLE (le_inf (leOfHom ((adj.homEquiv A Z).symm j))
      (leOfHom ((adj.homEquiv A Z').symm j'))))
  refine T.isSheaf.isSeparated A _ (generate_affineChart_le_mem B S hS φ k) _ _ ?_
  rintro Y g ⟨Y', h, g', ⟨hY', Z₂, hZ₂, hle, ⟨j₂⟩⟩, rfl⟩
  have e₁ := representedEpsilonLocalDerivation_comp B S hS φ T D₀ g' j j₂ hZ hZ₂ hA hY'
    (hle.trans inf_le_left) r
  have e₂ := representedEpsilonLocalDerivation_comp B S hS φ T D₀ g' j' j₂ hZ' hZ₂ hA hY'
    (hle.trans inf_le_right) r
  rw [op_comp, Functor.map_comp]
  exact congrArg (T.val.presheaf.map h.op).hom (e₁.symm.trans e₂)

end AlgebraicGeometry.Space

