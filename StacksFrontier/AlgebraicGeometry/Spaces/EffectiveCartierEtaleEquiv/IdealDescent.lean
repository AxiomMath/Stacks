/-!
# Flat descent of effective Cartier ideal sheaves on schemes

Scheme-level input for the étale-chart characterization of effective Cartier divisors on an
algebraic space (Stacks 083C): ideals generated by a nonzerodivisor, descent of effective
Cartier-ness of an ideal sheaf along flat universally open morphisms checked one point of the
target at a time (`Stacks.Divisors.isEffectiveCartierDivisor_of_flat_universallyOpen_pointwise`),
effective Cartier ideal sheaves on affine schemes, kernels of closed immersions, and two
category-theoretic facts about pullbacks of subfunctors and one-arm cofans.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open scoped TensorProduct

namespace Stacks.Divisors

universe u

/-! ### Ideals generated by a nonzerodivisor -/

/-- **A free ideal of rank one is generated by a nonzerodivisor.** If an ideal `I` of a
commutative ring is free as a module and nonzero, then any basis of it is a single element, and
that element generates `I` and is a nonzerodivisor.

Freeness forces the basis to be a singleton: for two distinct basis vectors `b i`, `b j` the
relation `(b j) • b i = (b i) • b j` inside `I` reads off, in the basis, as `b i = 0`. -/
theorem exists_isRegular_span_of_module_free {A : Type*} [CommRing A] (I : Ideal A)
    [Module.Free A I] (hI : I ≠ ⊥) :
    ∃ f : A, IsRegular f ∧ I = Ideal.span {f} := by
  classical
  have : Nontrivial I := Submodule.nontrivial_iff_ne_bot.mpr hI
  have : Nontrivial A :=
    Function.Injective.nontrivial (f := fun x : I => (x : A)) Subtype.val_injective
  let b := Module.Free.chooseBasis A I
  let i : Module.Free.ChooseBasisIndex A I := Classical.choice inferInstance
  have hindex : ∀ j, j = i := by
    intro j
    by_contra hji
    have hmul : (b j : A) • b i = (b i : A) • b j := Subtype.ext (mul_comm _ _)
    have hz : (b i : A) = 0 := by
      have hh := congrArg (fun x => b.repr x j) hmul
      simpa [map_smul, Module.Basis.repr_self, hji, Ne.symm hji] using hh.symm
    exact b.ne_zero i (Subtype.ext hz)
  have hsmul (x : I) : (b.repr x i) • b i = x := by
    apply b.repr.injective
    ext j
    rw [hindex j]
    simp
  refine ⟨b i, ?_, ?_⟩
  · apply (Commute.isRegular_iff (fun _ => Commute.all _ _)).2
    intro a c hac
    have heq : a • b i = c • b i := Subtype.ext (by simpa [mul_comm] using hac)
    simpa using congrArg (fun x => b.repr x i) heq
  · refine le_antisymm (fun x hx => ?_)
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (b i).property))
    rw [Ideal.mem_span_singleton]
    exact ⟨b.repr ⟨x, hx⟩ i, by
      simpa [mul_comm] using (congrArg Subtype.val (hsmul ⟨x, hx⟩)).symm⟩

/-- **Multiplication by a nonzerodivisor is a linear isomorphism onto the ideal it
generates.** -/
def isRegularSpanEquiv {A : Type*} [CommRing A] (f : A) (hf : IsRegular f) :
    A ≃ₗ[A] (Ideal.span {f} : Ideal A) := by
  let m : A →ₗ[A] (Ideal.span {f} : Ideal A) :=
    { toFun := fun a => ⟨a * f, Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)⟩
      map_add' := fun a b => Subtype.ext (add_mul a b f)
      map_smul' := fun a b => Subtype.ext (mul_assoc a b f) }
  refine LinearEquiv.ofBijective m ⟨fun a b h => hf.right (congrArg Subtype.val h), ?_⟩
  rintro ⟨x, hx⟩
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hx
  exact ⟨a, Subtype.ext (by simpa [m, mul_comm] using ha.symm)⟩

/-- The image of a nonzerodivisor under a flat ring extension is again a nonzerodivisor:
multiplication by it is injective because flatness preserves injectivity of the corresponding
multiplication map. -/
theorem isRegular_algebraMap_of_flat {R C : Type*} [CommRing R] [CommRing C]
    [Algebra R C] [Module.Flat R C] {r : R} (hr : IsRegular r) :
    IsRegular (algebraMap R C r) := by
  refine (Commute.isRegular_iff (fun _ => Commute.all _ _)).2 fun a b hab => ?_
  exact Module.Flat.isSMulRegular_of_isRegular (M := C) hr
    (by simpa [Algebra.smul_def] using hab)

/-- **An ideal becomes its extension along a flat ring map after base change.** For a flat
`R`-algebra `C` the canonical map `C ⊗_R I ⟶ C` is injective with image `I·C`, so it
identifies `C ⊗_R I` with the extended ideal. -/
def idealTensorEquivMap {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]
    [Module.Flat A C] (I : Ideal A) :
    TensorProduct A C I ≃ₗ[C] (I.map (algebraMap A C)) := by
  let f : TensorProduct A C I →ₗ[C] C :=
    (TensorProduct.AlgebraTensorModule.rid A C C).toLinearMap ∘ₗ
      TensorProduct.AlgebraTensorModule.lTensor C C I.subtype
  have hf : Function.Injective f :=
    (TensorProduct.AlgebraTensorModule.rid A C C).injective.comp
      (Module.Flat.lTensor_preserves_injective_linearMap I.subtype I.injective_subtype)
  have hrange : I.map (algebraMap A C) = LinearMap.range f := by
    refine le_antisymm ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact ⟨TensorProduct.tmul A 1 (⟨x, hx⟩ : I), by simp [f, Algebra.smul_def]⟩
    · rintro _ ⟨x, rfl⟩
      induction x with
      | add x y hx hy => simpa using Ideal.add_mem _ hx hy
      | tmul s x =>
        change f (TensorProduct.tmul A s x) ∈ _
        simp only [f, LinearMap.comp_apply, LinearEquiv.coe_coe,
          TensorProduct.AlgebraTensorModule.lTensor_tmul,
          TensorProduct.AlgebraTensorModule.rid_tmul]
        simpa only [Submodule.coe_subtype, Algebra.smul_def] using
          Ideal.mul_mem_right s (I.map (algebraMap A C))
            (Ideal.mem_map_of_mem (algebraMap A C) x.property)
  exact (LinearEquiv.ofInjective f hf).trans (LinearEquiv.ofEq _ _ hrange.symm)

/-- **An ideal whose extension along a faithfully flat map is principal on a nonzerodivisor is
itself free of rank one at every prime, hence principal on a nonzerodivisor after one
localization.**

The extension `I·C` is free of rank one over `C`, so `C ⊗_R I` is finite and flat over `C`;
faithful flatness descends both to `I` over `R`, and the rank of `I` at every prime is `1`
because every prime of `R` is the image of a prime of `C`.  A finite flat module of constant
rank is free after inverting one element outside a given prime, and a free nonzero ideal is
generated by a nonzerodivisor. -/
theorem exists_isRegular_span_localizationAway_of_faithfullyFlat
    {R : Type u} [CommRing R] (J : Ideal R)
    (C : Type u) [CommRing C] [Algebra R C] [Module.FaithfullyFlat R C]
    (f : C) (hf : IsRegular f) (hJ : J.map (algebraMap R C) = Ideal.span {f})
    (p : Ideal R) [hp : p.IsPrime] :
    ∃ a ∉ p, ∃ b : Localization.Away a, IsRegular b ∧
      J.map (algebraMap R (Localization.Away a)) = Ideal.span {b} := by
  obtain ⟨q₀, -⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := C) ⟨p, hp⟩
  have hC : Nontrivial C := by
    rcases subsingleton_or_nontrivial C with h | h
    · exact absurd (Subsingleton.elim q₀.asIdeal ⊤) q₀.isPrime.ne_top
    · exact h
  let e : TensorProduct R C J ≃ₗ[C] C :=
    (idealTensorEquivMap J).trans
      ((LinearEquiv.ofEq _ _ hJ).trans (isRegularSpanEquiv f hf).symm)
  have : Module.Finite C (TensorProduct R C J) := Module.Finite.equiv e.symm
  have : Module.Flat C (TensorProduct R C J) := Module.Flat.of_linearEquiv e
  have hfin : Module.Finite R J := Module.Finite.of_finite_tensorProduct_of_faithfullyFlat C
  have hflat : Module.Flat R J := Module.Flat.of_flat_tensorProduct R J C
  have hrank : ∀ q : PrimeSpectrum R, Module.rankAtStalk (R := R) (M := J) q = 1 := by
    intro q
    obtain ⟨q', hq'⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := C) q
    rw [← hq', ← Module.rankAtStalk_baseChange (M := (J : Type _)) q',
      Module.rankAtStalk_eq_of_equiv e, Module.rankAtStalk_self]
    rfl
  obtain ⟨a, hap, hfree⟩ := Module.Free.away_of_finite_of_flat_of_rankAtStalk_constant
    (R := R) (M := J) p (fun m _ => by rw [hrank, hrank])
  refine ⟨a, hap, ?_⟩
  have hbc := LocalizedModule.isBaseChange (Submonoid.powers a) (M := (J : Type _))
  have hfree2 : Module.Free (Localization.Away a)
      (TensorProduct R (Localization.Away a) J) := Module.Free.of_equiv hbc.equiv.symm
  have hfree3 : Module.Free (Localization.Away a)
      (J.map (algebraMap R (Localization.Away a))) :=
    Module.Free.of_equiv (idealTensorEquivMap (C := Localization.Away a) J)
  have hne : J.map (algebraMap R (Localization.Away a)) ≠ ⊥ := by
    intro h0
    obtain ⟨q, hq⟩ : ∃ q : PrimeSpectrum (Localization.Away a),
        PrimeSpectrum.comap (algebraMap R (Localization.Away a)) q = ⟨p, hp⟩ := by
      have hmem : (⟨p, hp⟩ : PrimeSpectrum R) ∈
          Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away a))) := by
        rw [PrimeSpectrum.localization_away_comap_range _ a]
        exact hap
      exact hmem
    have h1 : Module.rankAtStalk (R := Localization.Away a)
        (M := (J.map (algebraMap R (Localization.Away a)) : Type _)) q = 1 := by
      rw [← Module.rankAtStalk_eq_of_equiv
        (idealTensorEquivMap (C := Localization.Away a) J),
        Module.rankAtStalk_baseChange q, hq, hrank]
    have : Subsingleton (J.map (algebraMap R (Localization.Away a)) : Type _) := by
      rw [h0]; infer_instance
    rw [Module.rankAtStalk_eq_zero_of_subsingleton] at h1
    exact absurd h1 (by simp)
  exact exists_isRegular_span_of_module_free _ hne

/-- `exists_isRegular_span_localizationAway_of_faithfullyFlat` stated for an arbitrary
localization away from the element it produces, rather than for the chosen model
`Localization.Away`.  This is the form in which it is applied to the sections of a basic open
of a scheme. -/
theorem exists_isRegular_span_isLocalizationAway_of_faithfullyFlat
    {R : Type u} [CommRing R] (J : Ideal R)
    (C : Type u) [CommRing C] [Algebra R C] [Module.FaithfullyFlat R C]
    (f : C) (hf : IsRegular f) (hJ : J.map (algebraMap R C) = Ideal.span {f})
    (p : Ideal R) [p.IsPrime] :
    ∃ a ∉ p, ∀ (R' : Type u) [CommRing R'] [Algebra R R'] [IsLocalization.Away a R'],
      ∃ b : R', IsRegular b ∧ J.map (algebraMap R R') = Ideal.span {b} := by
  obtain ⟨a, hap, b, hb, hbeq⟩ :=
    exists_isRegular_span_localizationAway_of_faithfullyFlat J C f hf hJ p
  refine ⟨a, hap, fun R' _ _ _ => ?_⟩
  let ε := IsLocalization.algEquiv (Submonoid.powers a) (Localization.Away a) R'
  refine ⟨ε b, isRegular_ringEquiv ε.toRingEquiv hb, ?_⟩
  have halg : (ε.toRingEquiv : Localization.Away a →+* R').comp
      (algebraMap R (Localization.Away a)) = algebraMap R R' := by
    ext r; simp
  rw [← halg, ← Ideal.map_map, hbeq, Ideal.map_span, Set.image_singleton]
  rfl

/-! ### Flat descent of effective Cartier ideal sheaves on schemes -/

/-- Transporting an ideal along an isomorphism of rings and back returns it. -/
private theorem ideal_map_inv_map_hom {A C : CommRingCat.{u}} (e : A ≅ C) (J : Ideal C) :
    (J.map e.inv.hom).map e.hom.hom = J := by
  rw [Ideal.map_map,
    show e.hom.hom.comp e.inv.hom = RingHom.id _ by
      rw [← CommRingCat.hom_comp, e.inv_hom_id, CommRingCat.hom_id],
    Ideal.map_id]

/-- **The inverse image of an ideal sheaf, read on a pair of affine opens.** If an affine open
`A'` of the source is carried into an affine open `A₀` of the target, then the ideal of
`I.comap q` on `A'` is the extension of the ideal of `I` on `A₀` along the restricted map of
sections `q.appLE A₀ A' hle`.

This is `Stacks.IdealSheaf.ideal_comap_appLE` with the two affine opens unbundled, which is the
form in which the charts below present them.  No affineness of `q` is needed. -/
theorem ideal_comap_appLE {X Y : Scheme.{u}} (I : Y.IdealSheafData) (q : X ⟶ Y)
    (A₀ : Y.Opens) (hA₀ : IsAffineOpen A₀) (A' : X.Opens) (hA' : IsAffineOpen A')
    (hle : A' ≤ q ⁻¹ᵁ A₀) :
    (I.comap q).ideal ⟨A', hA'⟩ = (I.ideal ⟨A₀, hA₀⟩).map (q.appLE A₀ A' hle).hom :=
  Stacks.IdealSheaf.ideal_comap_appLE I q ⟨A₀, hA₀⟩ ⟨A', hA'⟩ hle

/-- An ideal sheaf is the unit ideal on an affine open disjoint from its support. -/
theorem ideal_eq_top_of_disjoint_supportSet {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.Opens) (hU : IsAffineOpen U) (h : (U : Set X) ⊆ I.supportSetᶜ) :
    I.ideal ⟨U, hU⟩ = ⊤ := by
  have : IsAffine U.toScheme := hU
  have hsupp : (I.comap U.ι).support = ⊥ := by
    refine le_antisymm (fun z hz => ?_) bot_le
    rw [Scheme.IdealSheafData.support_comap] at hz
    exact absurd hz (h z.2)
  have htop : I.comap U.ι = ⊤ := (Scheme.IdealSheafData.support_eq_bot_iff _).mp hsupp
  have h2 : (I.ideal ⟨U, hU⟩).map U.topIso.inv.hom = ⊤ := by
    rw [← Stacks.IdealSheaf.ideal_comap_ι_top I hU (isAffineOpen_top U.toScheme), htop]
    rfl
  have h3 : I.ideal ⟨U, hU⟩ =
      Ideal.map U.topIso.hom.hom (⊤ : Ideal Γ(U.toScheme, ⊤)) := by
    rw [← h2, ideal_map_inv_map_hom]
  rw [h3, Ideal.map_top]

/-- If an ideal sheaf is generated by a nonzerodivisor `f` on an affine open `A`, then on a basic
open of `A` it is generated by the image of `f`, again a nonzerodivisor. -/
private theorem isRegular_and_ideal_basicOpen_eq_span {W : Scheme.{u}} (K : W.IdealSheafData)
    {A : W.Opens} (hA : IsAffineOpen A) {f : Γ(W, A)} (hf : IsRegular f)
    (hgen : K.ideal ⟨A, hA⟩ = Ideal.span {f}) (s : Γ(W, A)) :
    IsRegular (algebraMap Γ(W, A) Γ(W, W.basicOpen s) f) ∧
      K.ideal ⟨W.basicOpen s, hA.basicOpen s⟩ =
        Ideal.span {algebraMap Γ(W, A) Γ(W, W.basicOpen s) f} := by
  have := hA.isLocalization_basicOpen s
  have : Module.Flat Γ(W, A) Γ(W, W.basicOpen s) := IsLocalization.flat _ (Submonoid.powers s)
  refine ⟨isRegular_algebraMap_of_flat hf, ?_⟩
  have hmib := K.map_ideal_basicOpen ⟨A, hA⟩ s
  rw [hgen, Ideal.map_span, Set.image_singleton] at hmib
  exact hmib.symm

/-- **An effective Cartier ideal sheaf is generated by a nonzerodivisor on arbitrarily small
affine opens.** Given a point `w` and an open `O` containing it, there is an affine open `A`
with `w ∈ A ≤ O` on which the ideal sheaf is generated by a nonzerodivisor.

Shrinking is possible because the generator survives localization: a basic open of an affine
open on which the ideal is `(f)` carries the ideal generated by the image of `f`, and that
image is again a nonzerodivisor since a localization is flat. -/
theorem exists_basicOpen_isRegular_span_of_isEffectiveCartierDivisor {W : Scheme.{u}}
    (K : W.IdealSheafData) (h : IsEffectiveCartierDivisor K)
    (w : W) (O : W.Opens) (hwO : w ∈ O) :
    ∃ (A : W.Opens) (hA : IsAffineOpen A), w ∈ A ∧ A ≤ O ∧
      ∃ f : Γ(W, A), IsRegular f ∧ K.ideal ⟨A, hA⟩ = Ideal.span {f} := by
  obtain ⟨A₁, hwA₁, f₁, hf₁, hgen₁⟩ := Stacks.CartierAffineLocal.exists_affineOpen_isRegular K h w
  obtain ⟨s, hsle, hsmem⟩ := A₁.2.exists_basicOpen_le
    (V := A₁.1 ⊓ O) ⟨w, ⟨hwA₁, hwO⟩⟩ hwA₁
  have hAff : IsAffineOpen (W.basicOpen s) := A₁.2.basicOpen s
  obtain ⟨hreg, hgen⟩ := isRegular_and_ideal_basicOpen_eq_span K A₁.2 hf₁ hgen₁ s
  exact ⟨W.basicOpen s, hAff, hsmem, hsle.trans inf_le_right, _, hreg, hgen⟩

/-- **Effective Cartier-ness descends along flat universally open morphisms, pointwise on the
target.** If every point of `Y` admits a flat universally open morphism `q : W ⟶ Y` whose image
contains it and along which `I` pulls back to an effective Cartier ideal sheaf, then `I` is
itself effective Cartier.

This is the converse direction to Stacks 02OO (`Stacks.Divisors.isPullbackDefined_of_flat`),
and the input that makes condition (4) of Stacks 083C imply condition (3): an arbitrary étale
chart is compared with the charts of condition (4) on a common refinement, which is flat and
universally open over it.

The proof shrinks twice.  First, `I.comap q` is generated by a nonzerodivisor on an affine open
`A'` of `W` around a preimage `w` of the given point `y`, chosen inside the preimage of an
affine open `A₀ ∋ y`.  Second, universal openness makes the image of `A'` open, so a basic open
`Y.basicOpen g ⊆ A₀` around `y` can be chosen inside it; the corresponding basic open of `A'`
then maps onto `Spec Γ(Y, Y.basicOpen g)`, which by
`Module.FaithfullyFlat.of_comap_surjective` makes its sections a faithfully flat algebra.  Over
it the ideal of `I` becomes principal on a nonzerodivisor, so
`exists_isRegular_span_isLocalizationAway_of_faithfullyFlat` provides a nonzerodivisor
generating the ideal of `I` on a basic open around `y`, and the converse half of Stacks 01WS
concludes.  Universal openness is used only to make the image of `A'` open in `Y`, so that the
basic open `Y.basicOpen g` can be chosen inside it.

Deliberately untagged: Stacks 02OO lists the morphisms along which the pullback of an effective
Cartier divisor is *defined*, and this is the descent statement in the opposite direction,
which is not one of its clauses. -/
theorem isEffectiveCartierDivisor_of_flat_universallyOpen_pointwise {Y : Scheme.{u}}
    (I : Y.IdealSheafData)
    (h : ∀ y : Y, ∃ (W : Scheme.{u}) (q : W ⟶ Y), Flat q ∧ UniversallyOpen q ∧
      y ∈ Set.range q.base ∧ IsEffectiveCartierDivisor (I.comap q)) :
    IsEffectiveCartierDivisor I := by
  refine (Stacks.CartierAffineLocalConverse.isEffectiveCartierDivisor_iff_isRegular I).2
    fun y _ => ?_
  obtain ⟨W, q, hflatq, hopenq, ⟨w, hw⟩, hI⟩ := h y
  have : Flat q := hflatq
  have : UniversallyOpen q := hopenq
  obtain ⟨A₀, hA₀, hyA₀, -⟩ := exists_isAffineOpen_mem_and_subset
    (show y ∈ (⊤ : Y.Opens) from trivial)
  have hwq : w ∈ q ⁻¹ᵁ A₀ := by
    show q.base w ∈ A₀
    rw [hw]; exact hyA₀
  obtain ⟨A', hA', hwA', hA'le, f₁, hf₁, hgen₁⟩ :=
    exists_basicOpen_isRegular_span_of_isEffectiveCartierDivisor (I.comap q) hI w
      (q ⁻¹ᵁ A₀) hwq
  obtain ⟨g, hgle, hgmem⟩ := hA₀.exists_basicOpen_le
    (V := A₀ ⊓ ⟨q.base '' A'.carrier, q.isOpenMap _ A'.isOpen⟩)
    ⟨y, ⟨hyA₀, ⟨w, hwA', hw⟩⟩⟩ hyA₀
  have hV₀ : IsAffineOpen (Y.basicOpen g) := hA₀.basicOpen g
  have hA'' : IsAffineOpen (W.basicOpen (q.appLE A₀ A' hA'le g)) :=
    hA'.basicOpen (q.appLE A₀ A' hA'le g)
  have hA''eq : W.basicOpen (q.appLE A₀ A' hA'le g) = A' ⊓ q ⁻¹ᵁ Y.basicOpen g := by
    rw [Scheme.preimage_basicOpen]
    exact Scheme.basicOpen_res _ _ _
  have hle'' : W.basicOpen (q.appLE A₀ A' hA'le g) ≤ q ⁻¹ᵁ Y.basicOpen g := by
    rw [hA''eq]; exact inf_le_right
  let : Algebra Γ(Y, Y.basicOpen g) Γ(W, W.basicOpen (q.appLE A₀ A' hA'le g)) :=
    (q.appLE (Y.basicOpen g) (W.basicOpen (q.appLE A₀ A' hA'le g)) hle'').hom.toAlgebra
  have : Module.Flat Γ(Y, Y.basicOpen g) Γ(W, W.basicOpen (q.appLE A₀ A' hA'le g)) :=
    q.flat_appLE hV₀ hA'' hle''
  have hsurjSpec : Function.Surjective (PrimeSpectrum.comap
      (q.appLE (Y.basicOpen g) (W.basicOpen (q.appLE A₀ A' hA'le g)) hle'').hom) := by
    intro P
    have hPz : hV₀.primeIdealOf (hV₀.isoSpec.inv P) = P := by
      show hV₀.isoSpec.hom (hV₀.isoSpec.inv P) = P
      exact congrArg (fun k : Spec Γ(Y, Y.basicOpen g) ⟶ Spec Γ(Y, Y.basicOpen g) => k P)
        hV₀.isoSpec.inv_hom_id
    obtain ⟨x, hxA', hqx⟩ := (hgle (hV₀.isoSpec.inv P).2).2
    have hxA'' : x ∈ W.basicOpen (q.appLE A₀ A' hA'le g) := by
      rw [hA''eq]
      exact ⟨hxA', by
        show q.base x ∈ Y.basicOpen g
        rw [hqx]
        exact (hV₀.isoSpec.inv P).2⟩
    refine ⟨hA''.primeIdealOf ⟨x, hxA''⟩, ?_⟩
    rw [IsAffineOpen.comap_primeIdealOf_appLE (Y.basicOpen g) hV₀ _ hA'' hle'' hxA'', ← hPz]
    congr 1
    exact Subtype.ext hqx
  have : Module.FaithfullyFlat Γ(Y, Y.basicOpen g)
      Γ(W, W.basicOpen (q.appLE A₀ A' hA'le g)) :=
    Module.FaithfullyFlat.of_comap_surjective hsurjSpec
  obtain ⟨hfreg, hgen''⟩ :=
    isRegular_and_ideal_basicOpen_eq_span (I.comap q) hA' hf₁ hgen₁ (q.appLE A₀ A' hA'le g)
  have hJ : (I.ideal ⟨Y.basicOpen g, hV₀⟩).map
      (algebraMap Γ(Y, Y.basicOpen g) Γ(W, W.basicOpen (q.appLE A₀ A' hA'le g))) =
      Ideal.span {algebraMap Γ(W, A') Γ(W, W.basicOpen (q.appLE A₀ A' hA'le g)) f₁} := by
    rw [← hgen'', ideal_comap_appLE I q (Y.basicOpen g) hV₀ _ hA'' hle'']
    rfl
  have : (hV₀.primeIdealOf ⟨y, hgmem⟩).asIdeal.IsPrime :=
    (hV₀.primeIdealOf ⟨y, hgmem⟩).isPrime
  obtain ⟨a, hap, hall⟩ := exists_isRegular_span_isLocalizationAway_of_faithfullyFlat
    (I.ideal ⟨Y.basicOpen g, hV₀⟩) Γ(W, W.basicOpen (q.appLE A₀ A' hA'le g)) _ hfreg hJ
    (hV₀.primeIdealOf ⟨y, hgmem⟩).asIdeal
  have hyba : y ∈ Y.basicOpen a := by
    have h1 : hV₀.primeIdealOf ⟨y, hgmem⟩ ∈ PrimeSpectrum.basicOpen a :=
      (PrimeSpectrum.mem_basicOpen _ _).2 hap
    rw [← hV₀.fromSpec_preimage_basicOpen a] at h1
    have h2 : hV₀.fromSpec (hV₀.primeIdealOf ⟨y, hgmem⟩) ∈ Y.basicOpen a := h1
    rwa [hV₀.fromSpec_primeIdealOf ⟨y, hgmem⟩] at h2
  have := hV₀.isLocalization_basicOpen a
  obtain ⟨b, hb, hbeq⟩ := hall Γ(Y, Y.basicOpen a)
  exact ⟨⟨Y.basicOpen a, hV₀.basicOpen a⟩, hyba, b, hb,
    (I.map_ideal_basicOpen ⟨Y.basicOpen g, hV₀⟩ a).symm.trans hbeq⟩

/-! ### Effective Cartier ideal sheaves on affine schemes -/

/-- The ideal of global sections of the ideal sheaf of an ideal of global sections, on a scheme
whose whole space is an affine open, is that ideal back again. -/
theorem ideal_ofIdealTop_top {X : Scheme.{u}} (hX : IsAffineOpen (⊤ : X.Opens))
    (K : Ideal Γ(X, ⊤)) :
    (Scheme.IdealSheafData.ofIdealTop K).ideal ⟨⊤, hX⟩ = K := by
  simp only [Scheme.IdealSheafData.ofIdealTop_ideal, homOfLE_refl, op_id,
    CategoryTheory.Functor.map_id]
  rw [CommRingCat.hom_id, Ideal.map_id]

/-- **A principal ideal sheaf on a nonzerodivisor is effective Cartier.** On an affine scheme
the ideal sheaf `(f)` with `f` a nonzerodivisor of the global sections is an effective Cartier
divisor: the whole scheme is an affine open on which the ideal is `(f)`. -/
@[ega "IV 21.2.5" "special case"]
theorem isEffectiveCartierDivisor_ofIdealTop_span {U : Scheme.{u}} [IsAffine U]
    (f : Γ(U, ⊤)) (hf : IsRegular f) :
    IsEffectiveCartierDivisor (Scheme.IdealSheafData.ofIdealTop (Ideal.span {f})) :=
  (Stacks.CartierAffineLocalConverse.isEffectiveCartierDivisor_iff_isRegular _).2
    fun _ _ => ⟨⟨⊤, isAffineOpen_top U⟩, trivial, f, hf, by simp⟩

/-- **The inverse image of an ideal sheaf along the inclusion of an affine open on which it is
principal.** If `I` is generated by `f` on an affine open `V`, then `I.comap V.ι` is the
principal ideal sheaf of the corresponding global section of `V`. -/
theorem comap_ι_eq_ofIdealTop_of_ideal_eq_span {X : Scheme.{u}} (I : X.IdealSheafData)
    (V : X.Opens) (hV : IsAffineOpen V) (f : Γ(X, V))
    (hgen : I.ideal ⟨V, hV⟩ = Ideal.span {f}) :
    I.comap V.ι = Scheme.IdealSheafData.ofIdealTop (Ideal.span {V.topIso.inv.hom f}) := by
  have : IsAffine V.toScheme := hV
  refine Scheme.IdealSheafData.ext_of_isAffine ?_
  rw [Stacks.IdealSheaf.ideal_comap_ι_top I hV (isAffineOpen_top V.toScheme), hgen,
    Ideal.map_span, Set.image_singleton, ideal_ofIdealTop_top]

/-- **An ideal sheaf of an affine scheme is determined by its ideal of global sections.** The
construction `Scheme.IdealSheafData.ofIdealTop` is injective on an affine scheme. -/
theorem ofIdealTop_injective {X : Scheme.{u}} [IsAffine X] {K L : Ideal Γ(X, ⊤)}
    (h : Scheme.IdealSheafData.ofIdealTop K = Scheme.IdealSheafData.ofIdealTop L) : K = L := by
  rw [← ideal_ofIdealTop_top (isAffineOpen_top X) K,
    ← ideal_ofIdealTop_top (isAffineOpen_top X) L, h]

/-! ### Kernels of closed immersions -/

/-- A closed immersion identifies its source with the closed subscheme cut out by its
kernel. -/
def closedImmersionKerIso {U R : Scheme.{u}} (j : R ⟶ U) [IsClosedImmersion j] :
    R ≅ j.ker.subscheme :=
  asIso j.toImage

/-- A closed immersion factors as the identification of its source with the closed subscheme
cut out by its kernel, followed by the inclusion of that subscheme. -/
theorem closedImmersion_eq_kerIso_comp {U R : Scheme.{u}} (j : R ⟶ U)
    [IsClosedImmersion j] : j = (closedImmersionKerIso j).hom ≫ j.ker.subschemeι := by
  simp [closedImmersionKerIso]

/-- **The kernel of a base change of a closed immersion is the inverse image of its kernel.**
In a cartesian square with a closed immersion `j` on the right, the kernel of the opposite
side is `j.ker.comap f`. -/
theorem ker_eq_comap_of_isPullback {P U R X : Scheme.{u}} {a : P ⟶ U} {b : P ⟶ R}
    {f : U ⟶ X} {j : R ⟶ X} [IsClosedImmersion j] (h : IsPullback a b f j) :
    a.ker = j.ker.comap f := by
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion j f,
    ← Scheme.Hom.ker_comp_of_isIso h.isoPullback.hom]
  simp

end Stacks.Divisors

namespace CategoryTheory

universe u

/-- **The range of a base change is the inverse image of the range.** In a cartesian square of
presheaves of types, the subfunctor swept out by one projection is the inverse image of the
subfunctor swept out by the opposite side. -/
theorem Subfunctor.range_snd_eq_preimage_range_of_isPullback {C : Type*} [Category C]
    {A Bo Z P : C ⥤ Type u} {fst : P ⟶ A} {snd : P ⟶ Bo} {f : A ⟶ Z} {g : Bo ⟶ Z}
    (hP : IsPullback fst snd f g) :
    Subfunctor.range snd = (Subfunctor.range f).preimage g := by
  ext U x
  have hU : IsPullback (fst.app U) (snd.app U) (f.app U) (g.app U) :=
    ((evaluation C (Type u)).obj U).map_isPullback hP
  show x ∈ Set.range (snd.app U) ↔ g.app U x ∈ Set.range (f.app U)
  rw [CategoryTheory.Limits.Types.range_snd_of_isPullback hU]
  simp only [Set.mem_preimage]

/-- **A cofan over a one-element index type is a colimit exactly when its single arm is an
isomorphism.** This reads a rank-one coproduct presentation as a trivialization. -/
theorem Limits.isIso_cofan_inj_of_unique {C : Type*} [Category C] {M N : C}
    {I : Type*} [Unique I] (ι : I → (M ⟶ N))
    (hc : Limits.IsColimit (Limits.Cofan.mk N ι)) : IsIso (ι default) := by
  have hd : ι default ≫ Limits.Cofan.IsColimit.desc hc (fun _ => 𝟙 M) = 𝟙 M :=
    Limits.Cofan.IsColimit.fac hc _ default
  refine ⟨Limits.Cofan.IsColimit.desc hc (fun _ => 𝟙 M), hd, ?_⟩
  refine Limits.Cofan.IsColimit.hom_ext hc _ _ fun i => ?_
  obtain rfl : i = default := Subsingleton.elim _ _
  show ι default ≫ _ ≫ _ = ι default ≫ _
  rw [← Category.assoc, hd, Category.id_comp, Category.comp_id]

end CategoryTheory

