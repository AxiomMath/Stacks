module

public import Mathlib.CategoryTheory.Widesubcategory
public import StacksFrontier.AlgebraicGeometry.Spaces.TestSchemeFpqcSite

/-!
# The fpqc site of the test schemes over an algebraic space with flat morphisms

Let `Y` be an algebraic space over a scheme `S` of a big fppf site.  Some conditions on test
schemes over `Y`, such as injectivity of the base change of a map of modules, are stable only
under flat base change, so they define presheaves only on the test schemes with the flat
morphisms between them.  Stacks 05MJ asks for the sheaf property of such a presheaf for the
fpqc topology on that category; this file sets up the category and the topology.

## Main definitions

* `AlgebraicGeometry.Space.flatMorphisms`: the morphisms of test schemes over `Y` whose
  underlying morphism of schemes is flat.
* `AlgebraicGeometry.Space.FlatSchemesOver`: the test schemes over `Y` with flat morphisms.
* `AlgebraicGeometry.Space.flatFpqcTopology`: the fpqc topology on that category, generated by
  the families whose underlying families of scheme morphisms cover for the fpqc topology on
  schemes.

## References

* [Stacks Project, Tag 05MJ](https://stacks.math.columbia.edu/tag/05MJ)
* [Stacks Project, Tag 083H](https://stacks.math.columbia.edu/tag/083H)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- The morphisms of test schemes over an algebraic space whose underlying morphism of schemes
is flat. -/
def flatMorphisms (Y : AlgebraicSpaces B S hS) : MorphismProperty (SchemesOver Y) :=
  MorphismProperty.inverseImage (@AlgebraicGeometry.Flat : MorphismProperty Scheme.{u})
    (testSchemeFunctor Y)

/-- A morphism of test schemes is in `flatMorphisms` exactly when its underlying morphism of
schemes is flat. -/
theorem flatMorphisms_iff {Y : AlgebraicSpaces B S hS} {T T' : SchemesOver Y} (g : T' ⟶ T) :
    flatMorphisms Y g ↔ Flat ((testSchemeFunctor Y).map g) :=
  Iff.rfl

/-- Flat morphisms of test schemes contain the identities and are stable under composition. -/
instance isMultiplicative_flatMorphisms (Y : AlgebraicSpaces B S hS) :
    (flatMorphisms Y).IsMultiplicative where
  id_mem T := by
    rw [flatMorphisms_iff, CategoryTheory.Functor.map_id]
    infer_instance
  comp_mem f g hf hg := by
    rw [flatMorphisms_iff] at hf hg ⊢
    rw [CategoryTheory.Functor.map_comp]
    exact MorphismProperty.comp_mem _ _ _ hf hg

/-- The test schemes over an algebraic space with the flat morphisms between them: the category
of schemes over the base with flat morphisms of Stacks 05MJ. -/
abbrev FlatSchemesOver (Y : AlgebraicSpaces B S hS) := WideSubcategory (flatMorphisms Y)

/-- The fpqc topology on the test schemes over an algebraic space with flat morphisms: the
topology generated by the families whose underlying families of morphisms of schemes cover for
the fpqc topology on schemes.  The members of such a family are flat, so they are morphisms of
this category. -/
def flatFpqcTopology (Y : AlgebraicSpaces B S hS) : GrothendieckTopology (FlatSchemesOver Y) :=
  (Scheme.fpqcPrecoverage.comap
    (wideSubcategoryInclusion (flatMorphisms Y) ⋙ testSchemeFunctor Y)).toGrothendieck

end AlgebraicGeometry.Space

end
