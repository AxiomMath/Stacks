/-!
# Field-valued points of a quotient by a group action

Let a group `G` act on an object `V` of the big fppf site over a scheme `S`, and let
`b : Spec K ⟶ S` be a field-valued point of the base. A `K`-valued point of the quotient of
`V` by `G` comes from a finite Galois extension `L/K`, a finite subgroup of `G` identified
with the Galois group of `L/K`, and a `G`-equivariant `L`-valued point of `V`. Conversely such
data descend to a unique `K`-valued point of the quotient. In both directions the point
upstairs maps to the pullback of the specified quotient point.

## Main definitions

* `AlgebraicGeometry.Space.IsQuotientLift` says that the image of an `L`-valued point of `V`
  in the quotient is the pullback of a given `K`-valued point of the quotient.

## Main results

* `AlgebraicGeometry.Space.quotientPoint_of_galois_equivariant` is the descent direction:
  Galois-equivariant field-valued data give a point of the quotient, and
  `AlgebraicGeometry.Space.existsUnique_quotientPoint_of_galois_equivariant` adds that the point
  is unique.
* `AlgebraicGeometry.Space.exists_galois_equivariant_lift_of_descent` is the lifting
  direction: every field-valued point of the quotient is the image of an equivariant point
  over a finite Galois extension.

## Implementation notes

The field-valued point of the base is evaluated at the object of the big fppf site defined by
the morphism `Spec K ⟶ S`, which is `AlgebraicGeometry.Space.fieldObject`. Equivariance uses
the inverse field automorphism, since `Spec` is contravariant. The two directions of the
source are separate declarations. `IsQuotientLift` expresses the commuting square on every
test object of the site, so it does not require a chosen site-membership witness for the
spectrum of the extension field. The fields belong to the ambient scheme universe; the group
has an independent universe.

The descent direction is unconditional. The lifting direction goes through the chart
`h_V ⟶ V/G` of the quotient, whose surjectivity, étaleness and kernel-pair property
(`AlgebraicGeometry.Space.quotientMap_surjective`,
`AlgebraicGeometry.Space.quotientMap_etale` and
`AlgebraicGeometry.Space.quotientMap_isPullback`) are conditional on the quotient being an
algebraic space. That is `AlgebraicGeometry.Space.isAlgebraicSpace_actionQuotient`, which
carries a hypothesis of effective descent along the covering sieves of the site at the
monomorphisms locally of finite type; the hypothesis is therefore carried by the lifting
direction as its last explicit argument, named `hdesc`, rather than being dropped from a
statement that needs it. That hypothesis is a theorem,
`AlgebraicGeometry.Space.isEffectiveDescentAlongCoveringSieve_monomorphisms_inf_lft`, proved in
`StacksFrontier.AlgebraicGeometry.Descent.QuasiAffineFlatChartDescent`, which this module does not
import; the discharged form of the lifting direction, where `@[stacks 02Z5]` sits for that half,
is therefore `AlgebraicGeometry.Space.exists_galois_equivariant_lift` in
`StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.ActionQuotientFieldPointsUnconditional`.

## References

* [Stacks Project, Tag 02Z5](https://stacks.math.columbia.edu/tag/02Z5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.Groupoids

universe u v

namespace AlgebraicGeometry.Space

/-! ### Covering sieves generated by étale families -/

/-- A jointly surjective family of étale morphisms into an object of the big fppf category
over `S` generates a covering sieve of the localized topology. -/
theorem sieve_ofArrows_mem_topology_of_etale {S : Scheme.{u}} (B : BigFppfSite.{u})
    (hS : B.Contains S) {T : BigFppfOver B S hS} {I : Type u}
    (X : I → BigFppfOver B S hS) (f : ∀ i, X i ⟶ T)
    (hcov : ∀ t : B.inclusion.obj T.left, ∃ i x, (B.inclusion.map (f i).left) x = t)
    (hf : ∀ i, Etale (B.inclusion.map (f i).left)) :
    Sieve.ofArrows X f ∈ BigFppfOver.topology B S hS T := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  let E : PreZeroHypercover.{u + 1} T.left :=
    ⟨ULift.{u + 1} I, fun i => (X i.down).left, fun i => (f i.down).left⟩
  have heq : E.presieve₀ =
      Presieve.ofArrows (fun i => (X i).left) (fun i => (f i).left) := by
    funext Z g
    refine propext ⟨?_, ?_⟩
    · rintro ⟨i⟩
      exact ⟨i.down⟩
    · rintro ⟨i⟩
      exact ⟨ULift.up i⟩
  rw [Sieve.ofArrows, ← heq]
  refine B.generate_mem_topology E ?_
  change E.presieve₀ ∈ Scheme.fppfPrecoverage.comap B.inclusion T.left
  rw [Precoverage.mem_comap_iff, heq, Presieve.map_ofArrows, Scheme.fppfPrecoverage,
    Scheme.ofArrows_mem_precoverage_iff]
  exact ⟨hcov, fun i => have := hf i; ⟨inferInstance, inferInstance⟩⟩

/-- A finite extension of a field whose spectrum satisfies the size cutoff of a big fppf site
again has its spectrum in the site. -/
private theorem contains_spec_of_finiteDimensional (B : BigFppfSite.{u}) (K : Type u) [Field K]
    (hK : B.Contains (Spec (.of K))) (L : Type u) [Field L] [Algebra K L]
    [FiniteDimensional K L] : B.Contains (Spec (.of L)) :=
  Scheme.size_Spec_lt_of_finiteType B.aleph0_lt_cutoff B.cutoff_isStrongPrelimit K L hK

variable {S : Scheme.{u}} (B : BigFppfSite.{u}) (hS : B.Contains S)
  (V : BigFppfOver B S hS) (G : Type v) [Group G] [Small.{u} G]
  (a : G →* Aut (underlyingOver B hS V))
  [HasSheafify (BigFppfOver.topology B S hS) (Type u)]
  (K : Type u) [Field K] (hK : B.Contains (Spec (.of K))) (b : Spec (.of K) ⟶ S)

/-! ### Objects and morphisms of the site attached to a field extension -/

/-- The object of the big fppf site over `S` given by an extension field `L` of `K`, mapping
to `S` through `Spec K`. -/
private def fieldExtensionObject (L : Type u) [Field L] [Algebra K L]
    (hL : B.Contains (Spec (.of L))) : BigFppfOver B S hS :=
  fieldObject (hS := hS) L hL (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)

/-- The morphism of `S`-schemes from the spectrum of an extension field to the spectrum of the
base field. -/
private def fieldExtensionPostRestrict (L : Type u) [Field L] [Algebra K L]
    (hL : B.Contains (Spec (.of L))) :
    (Over.post B.inclusion).obj (fieldExtensionObject B hS K b L hL) ⟶
      (Over.post B.inclusion).obj (fieldObject (hS := hS) K hK b) := by
  change Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) ⟶ Over.mk b
  exact Over.homMk (Spec.map (CommRingCat.ofHom (algebraMap K L))) (by simp)

/-- The morphism of the site from the object of an extension field to the object of the base
field. -/
private def fieldExtensionRestrict (L : Type u) [Field L] [Algebra K L]
    (hL : B.Contains (Spec (.of L))) :
    fieldExtensionObject B hS K b L hL ⟶ fieldObject (hS := hS) K hK b :=
  (Over.post B.inclusion).preimage (fieldExtensionPostRestrict B hS K hK b L hL)

/-- An algebra map between extension fields of `K` is compatible with the structure maps on
spectra. -/
private theorem specMap_algHom_comp_specMap_algebraMap {E M : Type u} [Field E] [Field M]
    [Algebra K E] [Algebra K M] (φ : E →ₐ[K] M) :
    Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K E)) =
      Spec.map (CommRingCat.ofHom (algebraMap K M)) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  exact congrArg Spec.map (CommRingCat.hom_ext (RingHom.ext φ.commutes))

/-- The morphism of the site induced by an algebra map between two extension fields of the
base field. -/
private def fieldExtensionMap (E L : Type u) [Field E] [Field L] [Algebra K E] [Algebra K L]
    (hE : B.Contains (Spec (.of E))) (hL : B.Contains (Spec (.of L))) (φ : E →ₐ[K] L) :
    fieldExtensionObject B hS K b L hL ⟶ fieldExtensionObject B hS K b E hE := by
  refine Over.homMk (ObjectProperty.homMk (Spec.map (CommRingCat.ofHom φ.toRingHom))) ?_
  apply ObjectProperty.hom_ext
  change Spec.map (CommRingCat.ofHom φ.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K E)) ≫ b =
    Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b
  rw [← Category.assoc,
    specMap_algHom_comp_specMap_algebraMap]

/-- An `L`-valued point of `V` over the given point of the base, as a morphism of the site
from the object of `L`. -/
private def fieldPointMorphism (L : Type u) [Field L] [Algebra K L]
    (hL : B.Contains (Spec (.of L)))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) :
    fieldExtensionObject B hS K b L hL ⟶ V :=
  Over.homMk (ObjectProperty.homMk f) (by apply ObjectProperty.hom_ext; exact hf)

/-- The action of an automorphism of `L` over `K` on the object of the site attached to
`L`. -/
private def fieldExtensionSiteAut (L : Type u) [Field L] [Algebra K L]
    (hL : B.Contains (Spec (.of L))) (σ : L ≃ₐ[K] L) :
    fieldExtensionObject B hS K b L hL ⟶ fieldExtensionObject B hS K b L hL :=
  Over.homMk (ObjectProperty.homMk (Spec.map (CommRingCat.ofHom σ.toRingEquiv.toRingHom)))
    (by
      apply ObjectProperty.hom_ext
      change Spec.map (CommRingCat.ofHom σ.toRingEquiv.toRingHom) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b =
        Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b
      rw [← Category.assoc, specMap_algEquiv_comp_specMap_algebraMap])

/-! ### Lifts of a field-valued point of the quotient -/

/-- The image of `f` in the quotient is the pullback of `ξ` along `Spec L ⟶ Spec K`. This is
equality of the two maps on the restricted functor of points of `Spec L`, written on test
objects of the site to avoid requiring `Spec L` itself to lie in the site. -/
def IsQuotientLift
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (L : Type u) [Field L] [Algebra K L]
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) : Prop :=
  ∀ (T : BigFppfOver B S hS)
    (t : (Over.post B.inclusion).obj T ⟶
      Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)),
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T) (t ≫ Over.homMk f hf) =
      (actionQuotient G B hS V a).map
        ((Over.post B.inclusion).preimage
          (t ≫ (Over.homMk (Spec.map (CommRingCat.ofHom (algebraMap K L))) :
            Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) ⟶
              (Over.post B.inclusion).obj (fieldObject (hS := hS) K hK b)))).op ξ

/-- To check `IsQuotientLift` it suffices to check the identity on the object of the site
attached to the extension field, since every test object factors through it. -/
private theorem isQuotientLift_of_section
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (L : Type u) [Field L] [Algebra K L] (hL : B.Contains (Spec (.of L)))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (hsec : (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldExtensionObject B hS K b L hL)) (𝟙 _ ≫ Over.homMk f hf) =
      (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b L hL).op ξ) :
    IsQuotientLift B hS V G a K hK b ξ L f hf := by
  intro T t
  have htgt : (Over.post B.inclusion).obj (fieldExtensionObject B hS K b L hL) =
      Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) := rfl
  let t' : (Over.post B.inclusion).obj T ⟶
      (Over.post B.inclusion).obj (fieldExtensionObject B hS K b L hL) := htgt.symm ▸ t
  let g : T ⟶ fieldExtensionObject B hS K b L hL := (Over.post B.inclusion).preimage t'
  have hg : (Over.post B.inclusion).map g = t := (Over.post B.inclusion).map_preimage t'
  let η := toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
    (actionRelation (underlyingOver B hS V) G a)
  have hmap := congrArg (fun φ => φ (𝟙 _ ≫ Over.homMk f hf)) (η.naturality g.op)
  have hleft : η.app (op T) (t ≫ Over.homMk f hf) =
      (actionQuotient G B hS V a).map g.op
        (η.app (op (fieldExtensionObject B hS K b L hL)) (𝟙 _ ≫ Over.homMk f hf)) := by
    rw [← hg]
    exact hmap
  rw [hleft, hsec]
  let r := fieldExtensionRestrict B hS K hK b L hL
  let q := (Over.post B.inclusion).preimage
    (t ≫ fieldExtensionPostRestrict B hS K hK b L hL)
  have hr : (Over.post B.inclusion).map r = fieldExtensionPostRestrict B hS K hK b L hL :=
    (Over.post B.inclusion).map_preimage _
  have hq : (Over.post B.inclusion).map q =
      t ≫ fieldExtensionPostRestrict B hS K hK b L hL :=
    (Over.post B.inclusion).map_preimage _
  have hmaps : g ≫ r = q := by
    refine (Over.post B.inclusion).map_injective ?_
    calc
      (Over.post B.inclusion).map (g ≫ r) =
          (Over.post B.inclusion).map g ≫ (Over.post B.inclusion).map r :=
        (Over.post B.inclusion).map_comp g r
      _ = t ≫ fieldExtensionPostRestrict B hS K hK b L hL := by rw [hg, hr]; rfl
      _ = (Over.post B.inclusion).map q := hq.symm
  have hop : (fieldExtensionRestrict B hS K hK b L hL).op ≫ g.op = q.op :=
    congrArg Quiver.Hom.op hmaps
  change (actionQuotient G B hS V a).map g.op
      ((actionQuotient G B hS V a).map r.op ξ) =
    (actionQuotient G B hS V a).map q.op ξ
  calc
    _ = (actionQuotient G B hS V a).map (r.op ≫ g.op) ξ :=
      (congrArg (fun z => z ξ) ((actionQuotient G B hS V a).map_comp r.op g.op)).symm
    _ = (actionQuotient G B hS V a).map q.op ξ := by rw [hop]

/-- The converse of `AlgebraicGeometry.Space.isQuotientLift_of_section`: a lift satisfies the
identity on the object of the site attached to the extension field, obtained by taking that
object as the test object and the identity as the test morphism. -/
private theorem section_of_isQuotientLift
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (L : Type u) [Field L] [Algebra K L] (hL : B.Contains (Spec (.of L)))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (hlift : IsQuotientLift B hS V G a K hK b ξ L f hf) :
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldExtensionObject B hS K b L hL)) (𝟙 _ ≫ Over.homMk f hf) =
      (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b L hL).op ξ := by
  have h := hlift (fieldExtensionObject B hS K b L hL) (𝟙 _)
  have hpre : (Over.post B.inclusion).preimage
      (𝟙 ((Over.post B.inclusion).obj (fieldExtensionObject B hS K b L hL)) ≫
        (Over.homMk (Spec.map (CommRingCat.ofHom (algebraMap K L))) :
          Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) ⟶
            (Over.post B.inclusion).obj (fieldObject (hS := hS) K hK b))) =
      fieldExtensionRestrict B hS K hK b L hL := by
    refine (Over.post B.inclusion).map_injective ?_
    rw [(Over.post B.inclusion).map_preimage, fieldExtensionRestrict,
      (Over.post B.inclusion).map_preimage]
    refine Over.OverMorphism.ext ?_
    change 𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K L)) =
      Spec.map (CommRingCat.ofHom (algebraMap K L))
    exact Category.id_comp _
  rw [← hpre]
  exact h

/-- A lift over an extension field remains a lift after any further extension. -/
private theorem isQuotientLift_comp_fieldExtensionMap
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (E M : Type u) [Field E] [Field M] [Algebra K E] [Algebra K M]
    (hE : B.Contains (Spec (.of E))) (hM : B.Contains (Spec (.of M))) (φ : E →ₐ[K] M)
    (f : Spec (.of E) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K E)) ≫ b)
    (hsec : IsQuotientLift B hS V G a K hK b ξ E f hf) :
    IsQuotientLift B hS V G a K hK b ξ M
      (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ f)
      (by rw [Category.assoc, hf, ← Category.assoc,
    specMap_algHom_comp_specMap_algebraMap]) := by
  let fM := Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ f
  have hfM : fM ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K M)) ≫ b := by
    rw [Category.assoc, hf, ← Category.assoc,
    specMap_algHom_comp_specMap_algebraMap]
  let T := fieldExtensionObject B hS K b M hM
  let t := fieldExtensionMap B hS K b E M hE hM φ
  let tPost := (Over.post B.inclusion).map t
  have ht : tPost ≫ fieldExtensionPostRestrict B hS K hK b E hE =
      fieldExtensionPostRestrict B hS K hK b M hM := by
    refine Over.OverMorphism.ext ?_
    exact specMap_algHom_comp_specMap_algebraMap K φ
  have hright : (Over.post B.inclusion).preimage
      (tPost ≫ fieldExtensionPostRestrict B hS K hK b E hE) =
      fieldExtensionRestrict B hS K hK b M hM := by
    refine (Over.post B.inclusion).map_injective ?_
    rw [(Over.post B.inclusion).map_preimage, ht]
    exact ((Over.post B.inclusion).map_preimage _).symm
  have hsecT := hsec T tPost
  refine isQuotientLift_of_section B hS V G a K hK b ξ M hM fM hfM ?_
  change (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T) (Over.homMk fM hfM) =
    (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b M hM).op ξ
  calc
    _ = (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app (op T)
        (tPost ≫ Over.homMk f hf) := by congr 1
    _ = (actionQuotient G B hS V a).map
        ((Over.post B.inclusion).preimage
          (tPost ≫ fieldExtensionPostRestrict B hS K hK b E hE)).op ξ := hsecT
    _ = (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b M hM).op ξ :=
      congrArg (fun m => (actionQuotient G B hS V a).map m.op ξ) hright

/-- The image in the quotient of a lift of `ξ` over an extension field is unchanged by the
action of an automorphism of that extension on the object of the site. -/
private theorem quotient_section_invariant_under_site_field_automorphism
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (L : Type u) [Field L] [Algebra K L] (hL : B.Contains (Spec (.of L)))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (hsec : IsQuotientLift B hS V G a K hK b ξ L f hf) (σ : L ≃ₐ[K] L) :
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app
      (op (fieldExtensionObject B hS K b L hL))
      ((Over.post B.inclusion).map (fieldExtensionSiteAut B hS K b L hL σ ≫
        fieldPointMorphism B hS V K b L hL f hf)) =
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app
      (op (fieldExtensionObject B hS K b L hL))
      ((Over.post B.inclusion).map (fieldPointMorphism B hS V K b L hL f hf)) := by
  classical
  let T := fieldExtensionObject B hS K b L hL
  let τ := Spec.map (CommRingCat.ofHom σ.toRingEquiv.toRingHom)
  let ρ := Spec.map (CommRingCat.ofHom (algebraMap K L))
  have hτσ := specMap_algEquiv_comp_specMap_algebraMap K L σ
  let t := (Over.post B.inclusion).map (fieldExtensionSiteAut B hS K b L hL σ)
  let m := fieldPointMorphism B hS V K b L hL f hf
  let r := fieldExtensionPostRestrict B hS K hK b L hL
  have hrr : r = Over.homMk ρ (Over.w r) := by
    apply Over.OverMorphism.ext
    rfl
  let rraw : Over.mk (ρ ≫ b) ⟶
    (Over.post B.inclusion).obj (fieldObject (hS := hS) K hK b) := Over.homMk ρ
  have hrraw : rraw = r := by
    apply Over.OverMorphism.ext
    rfl
  have hrσ : (Over.post B.inclusion).preimage (t ≫ r) =
      fieldExtensionRestrict B hS K hK b L hL := by
    apply (Over.post B.inclusion).map_injective
    change (Over.post B.inclusion).map ((Over.post B.inclusion).preimage (t ≫ r)) =
      (Over.post B.inclusion).map
        ((Over.post B.inclusion).preimage (fieldExtensionPostRestrict B hS K hK b L hL))
    rw [(Over.post B.inclusion).map_preimage, (Over.post B.inclusion).map_preimage]
    apply Over.OverMorphism.ext
    change τ ≫ ρ = ρ
    exact hτσ
  have hσ := hsec T t
  have hid := hsec T (𝟙 _)
  have hσarg : (Over.post B.inclusion).preimage (t ≫ rraw) =
      (Over.post B.inclusion).preimage (t ≫ r) := by
    congr 1
  have hσ' : (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T)
      (t ≫ (Over.post B.inclusion).map m) =
      (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b L hL).op ξ := by
    calc
      _ = (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
          (actionRelation (underlyingOver B hS V) G a)).app (op T)
          (t ≫ Over.homMk f hf) := by congr 1
      _ = (actionQuotient G B hS V a).map
          ((Over.post B.inclusion).preimage (t ≫ rraw)).op ξ := by
        rw [hrraw, hrr]
        exact hσ
      _ = (actionQuotient G B hS V a).map
          ((Over.post B.inclusion).preimage (t ≫ r)).op ξ :=
        congrArg (fun g => (actionQuotient G B hS V a).map g.op ξ) hσarg
      _ = (actionQuotient G B hS V a).map
          (fieldExtensionRestrict B hS K hK b L hL).op ξ := by rw [hrσ]
  have hid' : (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T)
      ((Over.post B.inclusion).map m) =
      (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b L hL).op ξ := by
    calc
      _ = (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
          (actionRelation (underlyingOver B hS V) G a)).app (op T)
          (𝟙 _ ≫ Over.homMk f hf) := by congr 1
      _ = (actionQuotient G B hS V a).map
          ((Over.post B.inclusion).preimage
            ((𝟙 _ : (Over.post B.inclusion).obj T ⟶
              (Over.post B.inclusion).obj T) ≫ r)).op ξ := by
        rw [hrr]
        exact hid
      _ = (actionQuotient G B hS V a).map
          (fieldExtensionRestrict B hS K hK b L hL).op ξ := by
        simp [fieldExtensionRestrict, r]
  change _ = _
  exact hσ'.trans hid'.symm

/-! ### The descent direction -/


omit [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- A section of a sheaf on the big fppf site over the object of a finite Galois extension of
`K` which is invariant under the Galois group descends uniquely to the object of `K`. -/
private theorem galois_invariant_section_descends
    (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (hL : B.Contains (Spec (.of L))) (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf (BigFppfOver.topology B S hS) F)
    (x : F.obj (op (fieldExtensionObject B hS K b L hL)))
    (hx : ∀ σ : L ≃ₐ[K] L, F.map (fieldExtensionSiteAut B hS K b L hL σ).op x = x) :
    ∃! y : F.obj (op (fieldObject (hS := hS) K hK b)),
      F.map (fieldExtensionRestrict B hS K hK b L hL).op y = x := by
  let D := fieldObject (hS := hS) K hK b
  let E := fieldExtensionObject B hS K b L hL
  let R := fieldExtensionRestrict B hS K hK b L hL
  let r := Spec.map (CommRingCat.ofHom (algebraMap K L))
  let toSch := BigFppfOver.toScheme B S hS
  have hR : toSch.map R = r := by
    change ((Over.post B.inclusion).map ((Over.post B.inclusion).preimage _)).left = _
    rw [(Over.post B.inclusion).map_preimage]
    rfl
  have hr : Etale r := etale_specMap_algebraMap K L
  have hc : Sieve.generate (Presieve.singleton R) ∈ BigFppfOver.topology B S hS D := by
    rw [← Presieve.ofArrows_pUnit.{u}]
    refine sieve_ofArrows_mem_topology_of_etale B hS (fun _ : PUnit.{u + 1} => E)
      (fun _ => R) (fun y => ⟨PUnit.unit, (default : Spec (.of L)),
        Subsingleton.elim (α := Spec (.of K)) _ _⟩) fun _ => ?_
    change Etale (toSch.map R)
    rwa [hR]
  have hs := (Presieve.isSheafFor_iff_generate (P := F) (Presieve.singleton R)).mpr
    (hF.isSheafFor _ hc)
  apply Presieve.isSheafFor_singleton.mp hs x
  intro Z p q hpq
  let p' := toSch.map p
  let q' := toSch.map q
  have hpq' : p' ≫ r = q' ≫ r := by
    rw [← hR, ← toSch.map_comp, ← toSch.map_comp, hpq]
  have : QuasiCompact r := inferInstanceAs (QuasiCompact (Spec.map _))
  let P : Scheme.{u} := pullback r r
  let hP : B.Contains P :=
    Scheme.size_lt_of_locallyOfFiniteType_of_quasiCompact (pullback.fst r r) hL
  let Pobj : BigFppfOver B S hS :=
    Over.mk (ObjectProperty.homMk (pullback.fst r r ≫ r ≫ b) : B.obj hP ⟶ B.obj hS)
  let p₁ : Pobj ⟶ E :=
    Over.homMk (ObjectProperty.homMk (pullback.fst r r))
      (by apply ObjectProperty.hom_ext; rfl)
  let p₂ : Pobj ⟶ E :=
    Over.homMk (ObjectProperty.homMk (pullback.snd r r)) (by
      apply ObjectProperty.hom_ext
      change pullback.snd r r ≫ r ≫ b = pullback.fst r r ≫ r ≫ b
      rw [← Category.assoc, ← Category.assoc, pullback.condition])
  let aut (σ : L ≃ₐ[K] L) := Spec.map (CommRingCat.ofHom σ.toRingHom)
  have har (σ : L ≃ₐ[K] L) : aut σ ≫ r = r :=
    specMap_algEquiv_comp_specMap_algebraMap K L σ
  let graph (σ : L ≃ₐ[K] L) : Spec (.of L) ⟶ P :=
    pullback.lift (aut σ) (𝟙 _) (by simp [har])
  have hg₁ (σ) : graph σ ≫ pullback.fst r r = aut σ := pullback.lift_fst _ _ _
  have hg₂ (σ) : graph σ ≫ pullback.snd r r = 𝟙 _ := pullback.lift_snd _ _ _
  let g (σ : L ≃ₐ[K] L) : E ⟶ Pobj :=
    Over.homMk (ObjectProperty.homMk (graph σ)) (by
      apply ObjectProperty.hom_ext
      change graph σ ≫ pullback.fst r r ≫ r ≫ b = r ≫ b
      rw [← Category.assoc, hg₁, ← Category.assoc, har])
  have hg (σ) : g σ ≫ p₁ = fieldExtensionSiteAut B hS K b L hL σ := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    exact hg₁ σ
  have hg' (σ) : g σ ≫ p₂ = 𝟙 E := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    exact hg₂ σ
  have hgc : Sieve.ofArrows (fun _ => E) g ∈ BigFppfOver.topology B S hS Pobj := by
    refine sieve_ofArrows_mem_topology_of_etale B hS (fun _ => E) g
      (exists_graph_eq_of_isGalois K L r rfl aut (fun _ => rfl) har) fun σ => ?_
    have := isOpenImmersion_of_section_of_etale (pullback.snd r r) (graph σ) (hg₂ σ)
    exact inferInstanceAs (Etale (graph σ))
  have hxeq : F.map p₁.op x = F.map p₂.op x := by
    have sep := (Presieve.isSeparatedFor_iff_generate (P := F)).mpr
      (hF.isSheafFor _ hgc).isSeparatedFor
    refine sep.ext ?_
    rintro T f ⟨σ⟩
    change (F.map p₁.op ≫ F.map (g σ).op) x = (F.map p₂.op ≫ F.map (g σ).op) x
    rw [← F.map_comp, ← F.map_comp, ← op_comp, ← op_comp, hg, hg', op_id, F.map_id]
    exact hx σ
  let t' : toSch.obj Z ⟶ P := pullback.lift p' q' hpq'
  let t : Z ⟶ Pobj :=
    Over.homMk (ObjectProperty.homMk t') (by
      apply ObjectProperty.hom_ext
      change t' ≫ pullback.fst r r ≫ r ≫ b = B.inclusion.map Z.hom
      rw [← Category.assoc, show t' ≫ pullback.fst r r = p' from pullback.lift_fst _ _ _]
      exact congrArg B.inclusion.map (Over.w p))
  have ht₁ : t ≫ p₁ = p := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    exact pullback.lift_fst _ _ _
  have ht₂ : t ≫ p₂ = q := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    exact pullback.lift_snd _ _ _
  have heq := congrArg (F.map t.op) hxeq
  change (F.map p₁.op ≫ F.map t.op) x = (F.map p₂.op ≫ F.map t.op) x at heq
  simpa only [← F.map_comp, ← op_comp, ht₁, ht₂] using heq

/-- The projection to the quotient sheaf is invariant under the group action. -/
private theorem quotient_image_action_invariant (T : BigFppfOver B S hS)
    (t : (Over.post B.inclusion).obj T ⟶ underlyingOver B hS V) (g : G) :
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T) (t ≫ (a g).hom) =
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T) t := by
  have h := congrArg
    (fun α => α.app (op T) (t ≫ Sigma.ι (fun _ : G => underlyingOver B hS V) g))
    (sourceMap_toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a))
  change (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T)
      (t ≫ Sigma.ι (fun _ : G => underlyingOver B hS V) g ≫
        (actionRelation (underlyingOver B hS V) G a).source) =
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T)
      (t ≫ Sigma.ι (fun _ : G => underlyingOver B hS V) g ≫
        (actionRelation (underlyingOver B hS V) G a).target) at h
  simpa only [actionRelation, Stacks.Groupoids.PreRelation.source,
    Stacks.Groupoids.PreRelation.target, prod.lift_fst, prod.lift_snd, actionRelationSource,
    actionRelationTarget, Sigma.ι_desc, Category.comp_id] using h.symm

/-- The image in the quotient of an equivariant point over an extension field is invariant under
the automorphisms of the extension. -/
private theorem quotient_image_invariant_of_equivariant (L : Type u) [Field L] [Algebra K L]
    (hL : B.Contains (Spec (.of L))) (H : Subgroup G) (e : H ≃* (L ≃ₐ[K] L))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (he : ∀ h : H,
      Spec.map (CommRingCat.ofHom (e h⁻¹).toRingHom) ≫ f = f ≫ (a h.1).hom.left)
    (σ : L ≃ₐ[K] L) :
    (actionQuotient G B hS V a).map (fieldExtensionSiteAut B hS K b L hL σ).op
      ((toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldExtensionObject B hS K b L hL)) (Over.homMk f hf)) =
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldExtensionObject B hS K b L hL)) (Over.homMk f hf) := by
  let E := fieldExtensionObject B hS K b L hL
  let F := actionQuotient G B hS V a
  let η := toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
    (actionRelation (underlyingOver B hS V) G a)
  let t : (Over.post B.inclusion).obj E ⟶ underlyingOver B hS V := Over.homMk f hf
  let x := η.app (op E) t
  let h : H := (e.symm σ)⁻¹
  have heh : e h⁻¹ = σ := by simp [h]
  have ht : (Over.post B.inclusion).map (fieldExtensionSiteAut B hS K b L hL σ) ≫ t =
      t ≫ (a h.1).hom := by
    refine Over.OverMorphism.ext ?_
    change Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ f = f ≫ (a h.1).hom.left
    rw [← heh]
    exact he h
  have hn := congrArg (fun φ => φ t)
    (η.naturality (fieldExtensionSiteAut B hS K b L hL σ).op)
  change η.app (op E)
    ((Over.post B.inclusion).map (fieldExtensionSiteAut B hS K b L hL σ) ≫ t) =
    F.map (fieldExtensionSiteAut B hS K b L hL σ).op x at hn
  rw [← hn, ht]
  exact quotient_image_action_invariant B hS V G a E t h.1

/-- **Stacks 02Z5, the converse descent.** Galois-equivariant field-valued data descend to a
point of the action quotient whose pullback is the image of the supplied point upstairs.

Let `L/K` be finite Galois with Galois group identified with a finite subgroup `H` of `G`,
and let `f : Spec L ⟶ V` be a point over the given point of the base which is equivariant for
that identification. Then the image of `f` in the quotient is invariant under the Galois
group, so it descends through the sheaf condition on the étale covering `Spec L ⟶ Spec K` to a
`K`-valued point of the quotient. -/
@[stacks 02Z5 "converse descent"]
theorem quotientPoint_of_galois_equivariant (L : Type u) [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (H : Subgroup G) [Finite H]
    (e : H ≃* (L ≃ₐ[K] L))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (he : ∀ h : H,
      Spec.map (CommRingCat.ofHom (e h⁻¹).toRingHom) ≫ f = f ≫ (a h.1).hom.left) :
    ∃ ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)),
      IsQuotientLift B hS V G a K hK b ξ L f hf := by
  let hL := contains_spec_of_finiteDimensional B K hK L
  let E := fieldExtensionObject B hS K b L hL
  let F := actionQuotient G B hS V a
  let η := toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
    (actionRelation (underlyingOver B hS V) G a)
  let t : (Over.post B.inclusion).obj E ⟶ underlyingOver B hS V := Over.homMk f hf
  let x := η.app (op E) t
  have hx (σ : L ≃ₐ[K] L) : F.map (fieldExtensionSiteAut B hS K b L hL σ).op x = x :=
    quotient_image_invariant_of_equivariant B hS V G a K b L hL H e f hf he σ
  obtain ⟨ξ, hξ, _⟩ := galois_invariant_section_descends B hS K hK b L hL F
    (quotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).property x hx
  exact ⟨ξ, isQuotientLift_of_section B hS V G a K hK b ξ L hL f hf hξ.symm⟩

/-- **Stacks 02Z5, the converse, with uniqueness.** Galois-equivariant field-valued data
*determine* a point of the action quotient: there is exactly one `K`-valued point whose pullback
is the image of the supplied point upstairs.

Existence is `AlgebraicGeometry.Space.quotientPoint_of_galois_equivariant`, by the same
descent through the sheaf condition; uniqueness holds
because `Spec L ⟶ Spec K` is a covering of the site, so the quotient sheaf is separated for it
and at most one `K`-valued point pulls back to the image of `f`. -/
theorem existsUnique_quotientPoint_of_galois_equivariant (L : Type u) [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (H : Subgroup G) [Finite H]
    (e : H ≃* (L ≃ₐ[K] L))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (he : ∀ h : H,
      Spec.map (CommRingCat.ofHom (e h⁻¹).toRingHom) ≫ f = f ≫ (a h.1).hom.left) :
    ∃! ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)),
      IsQuotientLift B hS V G a K hK b ξ L f hf := by
  let hL := contains_spec_of_finiteDimensional B K hK L
  let E := fieldExtensionObject B hS K b L hL
  let F := actionQuotient G B hS V a
  let η := toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
    (actionRelation (underlyingOver B hS V) G a)
  let t : (Over.post B.inclusion).obj E ⟶ underlyingOver B hS V := Over.homMk f hf
  let x := η.app (op E) t
  have hx (σ : L ≃ₐ[K] L) : F.map (fieldExtensionSiteAut B hS K b L hL σ).op x = x :=
    quotient_image_invariant_of_equivariant B hS V G a K b L hL H e f hf he σ
  obtain ⟨ξ, hξ, huniq⟩ := galois_invariant_section_descends B hS K hK b L hL F
    (quotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).property x hx
  refine ⟨ξ, isQuotientLift_of_section B hS V G a K hK b ξ L hL f hf hξ.symm, ?_⟩
  intro ξ' hξ'
  exact huniq ξ'
    (section_of_isQuotientLift B hS V G a K hK b ξ' L hL f hf hξ').symm

/-! ### The lifting direction -/

omit [Group G] [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- A point of the relation scheme of a group action valued in a field factors through one of
the copies of `V`. -/
private theorem exists_sigmaι_factor_of_fieldPoint {k : Type u} [Field k]
    (z : Spec (.of k) ⟶ (actionRelationScheme (underlyingOver B hS V) G).left) :
    ∃ g : G, ∃ z' : Spec (.of k) ⟶ (underlyingOver B hS V).left,
      z ≫ (actionRelationUnderlyingIso (underlyingOver B hS V) G).hom =
        z' ≫ Sigma.ι (fun _ : G => (underlyingOver B hS V).left) g := by
  let U := underlyingOver B hS V
  let z'' := z ≫ (actionRelationUnderlyingIso U G).hom
  obtain ⟨g, x, hx⟩ := (AlgebraicGeometry.sigmaOpenCover
    (fun _ : G => U.left)).exists_eq (z'' (default : Spec (.of k)))
  have hrange : Set.range z'' ⊆ Set.range (Sigma.ι (fun _ : G => U.left) g) := by
    rintro y ⟨t, rfl⟩
    have ht : t = (default : Spec (.of k)) := Subsingleton.elim _ _
    subst t
    exact ⟨x, hx⟩
  exact ⟨g, IsOpenImmersion.lift (Sigma.ι (fun _ : G => U.left) g) z'' hrange,
    (IsOpenImmersion.lift_fac _ _ _).symm⟩

omit [Small.{u} G] [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- The inclusion of the copy of `V` indexed by a group element into the relation scheme of the
action, on underlying schemes. -/
private def actionCopy (g : G) :
    (underlyingOver B hS V).left ⟶ (actionRelationScheme (underlyingOver B hS V) G).left :=
  (Over.forget S).map (Sigma.ι (fun _ : G => underlyingOver B hS V) g)

omit [Group G] [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- The source map restricted to the copy indexed by `g` is the identity. -/
private theorem actionCopy_source (g : G) :
    actionCopy B hS V G g ≫ (actionRelationSource (underlyingOver B hS V) G).left =
      𝟙 (underlyingOver B hS V).left := by
  change (Over.forget S).map (Sigma.ι (fun _ : G => underlyingOver B hS V) g) ≫
      (Over.forget S).map (actionRelationSource (underlyingOver B hS V) G) = _
  rw [← (Over.forget S).map_comp]
  exact congrArg Over.Hom.left
    (Sigma.ι_desc (fun _ : G => 𝟙 (underlyingOver B hS V)) g)

omit [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- The target map restricted to the copy indexed by `g` is the action of `g`. -/
private theorem actionCopy_target (g : G) :
    actionCopy B hS V G g ≫ (actionRelationTarget (underlyingOver B hS V) G a).left =
      (a g).hom.left := by
  change (Over.forget S).map (Sigma.ι (fun _ : G => underlyingOver B hS V) g) ≫
      (Over.forget S).map (actionRelationTarget (underlyingOver B hS V) G a) = _
  rw [← (Over.forget S).map_comp]
  exact congrArg Over.Hom.left (Sigma.ι_desc (fun g : G => (a g).hom) g)

omit [Small.{u} G] [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- A group element fixing a field-valued point of `V` together with its residue field is the
identity. -/
private theorem eq_one_of_fixes_fieldPoint
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a) {k : Type u}
    [Field k] (z : Spec (.of k) ⟶ (underlyingOver B hS V).left) (g : G)
    (hfix : z ≫ (a g).hom.left = z) : g = 1 := by
  let U := underlyingOver B hS V
  let E := Scheme.SpecToEquivOfField k U.left
  let x := z (IsLocalRing.closedPoint k)
  have hpair : E (z ≫ (a g).hom.left) = E z := congrArg E hfix
  obtain ⟨hx, hres⟩ := Scheme.SpecToEquivOfField_eq_iff.mp hpair
  simp only [Scheme.SpecToEquivOfField, Equiv.coe_fn_mk, Scheme.Hom.comp_base,
    TopCat.hom_comp, ContinuousMap.coe_comp,
    Scheme.descResidueField_stalkClosedPointTo_comp, E] at hx hres
  have hres' : (a g).hom.left.residueFieldMap x = (U.left.residueFieldCongr hx).hom := by
    let lam := (E z).2
    have : Mono lam := ConcreteCategory.mono_of_injective lam (RingHom.injective lam.hom)
    exact (cancel_mono lam).mp hres
  by_contra hne
  have hx' : (a g).hom.left x = x := by
    change (TopCat.Hom.hom (a g).hom.left.base) (z (IsLocalRing.closedPoint k)) =
      z (IsLocalRing.closedPoint k) at hx
    exact hx
  exact (ha g x hx' hne) hres'

omit [Small.{u} G] [HasSheafify (BigFppfOver.topology B S hS) (Type u)] in
/-- The action of the group on a field-valued point of `V` is free. -/
private theorem action_injective_on_fieldPoint
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a) {k : Type u}
    [Field k] (z : Spec (.of k) ⟶ (underlyingOver B hS V).left) {g h : G}
    (heq : z ≫ (a g).hom.left = z ≫ (a h).hom.left) : g = h := by
  have hfix : z ≫ (a (h⁻¹ * g)).hom.left = z := by
    have hcancel : (a h).hom.left ≫ ((a h)⁻¹).hom.left = 𝟙 _ := by
      have hh : (a h).hom ≫ (a h)⁻¹.hom = 𝟙 _ := Iso.hom_inv_id (a h)
      simpa using congrArg
        (fun m : underlyingOver B hS V ⟶ underlyingOver B hS V => m.left) hh
    calc
      z ≫ (a (h⁻¹ * g)).hom.left = (z ≫ (a g).hom.left) ≫ (a h⁻¹).hom.left := by
        simp only [map_mul, CategoryTheory.Aut.Aut_mul_def]
        rfl
      _ = (z ≫ (a h).hom.left) ≫ (a h⁻¹).hom.left := by rw [heq]
      _ = z := by rw [map_inv a h, Category.assoc, hcancel, Category.comp_id]
  have h₁ := eq_one_of_fixes_fieldPoint B hS V G a ha z (h⁻¹ * g) hfix
  calc
    g = h * (h⁻¹ * g) := by rw [← mul_assoc, mul_inv_cancel, one_mul]
    _ = h := by rw [h₁, mul_one]

/-- The canonical chart of the quotient of `V` by the group action: the quotient map of the
graph relation, which lies in the site. -/
private def actionQuotientAtlasMap
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a) :
    yoneda.obj V ⟶ actionQuotient G B hS V a :=
  quotientMap B S hS
    (siteActionRelationSource G B hS V (contains_actionRelationScheme G B hS V a ha))
    (siteActionRelationTarget G B hS V (contains_actionRelationScheme G B hS V a ha) a)

/-- The chart sends a point `f : T ⟶ V` of the site to the class of `f` in the quotient
sheaf. -/
private theorem actionQuotientAtlasMap_app
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    {T : BigFppfOver B S hS} (f : T ⟶ V) :
    (actionQuotientAtlasMap B hS V G a ha).app (op T) f =
      (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app (op T)
        ((Over.post B.inclusion).map f) := by
  let J := BigFppfOver.topology B S hS
  let F : BigFppfOver B S hS ⥤ Over S := Over.post (X := B.obj hS) B.inclusion
  let j := actionRelation (underlyingOver B hS V) G a
  change (quotientSheaf J F j).obj.map f.op ((toQuotientSheaf J F j).app (op V) (𝟙 (F.obj V))) =
    (toQuotientSheaf J F j).app (op T) (F.map f)
  exact (NatTrans.naturality_apply (toQuotientSheaf J F j) (op f) (𝟙 (F.obj V))).symm

/-- The chart of the quotient is surjective and étale after every representable base change,
and the relation is its kernel pair. -/
private theorem actionQuotientAtlas_properties
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType)) :
    (MorphismProperty.presheaf (MorphismProperty.inverseImage
        (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS)))
      (actionQuotientAtlasMap B hS V G a ha) ∧
    (MorphismProperty.presheaf (MorphismProperty.inverseImage
        (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS)))
      (actionQuotientAtlasMap B hS V G a ha) ∧
    IsPullback
      (yoneda.map (siteActionRelationTarget G B hS V
        (contains_actionRelationScheme G B hS V a ha) a))
      (yoneda.map (siteActionRelationSource G B hS V
        (contains_actionRelationScheme G B hS V a ha)))
      (actionQuotientAtlasMap B hS V G a ha) (actionQuotientAtlasMap B hS V G a ha) := by
  let hR := contains_actionRelationScheme G B hS V a ha
  let s := siteActionRelationSource G B hS V hR
  let t := siteActionRelationTarget G B hS V hR a
  have hrel : relation B S hS s t = actionRelation (underlyingOver B hS V) G a := rfl
  have : IsEtaleEquivalenceRelation (relation B S hS s t) := by
    rw [hrel]
    exact actionRelation_isEtaleEquivalenceRelation (underlyingOver B hS V) G a ha
  have hQ : IsAlgebraicSpace B S hS
      (quotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (relation B S hS s t)).obj :=
    isAlgebraicSpace_quotientSheaf_relation_of_diagDescent B S hS s t hdesc
  have hrep := relativelyRepresentable_quotientMap_of_isAlgebraicSpace B S hS s t hQ
  exact ⟨quotientMap_surjective B S hS s t hrep, quotientMap_etale B S hS s t hrep,
    quotientMap_isPullback B S hS s t⟩

/-- A field-valued point of the quotient is covered by a surjective étale base change of the
chart. -/
private theorem exists_actionQuotient_field_fiber
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType))
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b))) :
    ∃ (W : BigFppfOver B S hS) (p : W ⟶ V) (q : W ⟶ fieldObject (hS := hS) K hK b),
      IsPullback (yoneda.map p) (yoneda.map q) (actionQuotientAtlasMap B hS V G a ha)
        (yonedaEquiv.symm ξ) ∧
      Surjective ((BigFppfOver.toScheme B S hS).map q) ∧
      Etale ((BigFppfOver.toScheme B S hS).map q) := by
  let hs := (actionQuotientAtlas_properties B hS V G a ha hdesc).1
  let he := (actionQuotientAtlas_properties B hS V G a ha hdesc).2.1
  let g : yoneda.obj (fieldObject (hS := hS) K hK b) ⟶ actionQuotient G B hS V a :=
    yonedaEquiv.symm ξ
  obtain ⟨W, q, fst, hpb⟩ := hs.rep (f := actionQuotientAtlasMap B hS V G a ha) g
  refine ⟨W, yoneda.preimage fst, q, ?_, hs.property g fst q hpb, he.property g fst q hpb⟩
  simpa only [yoneda.map_preimage] using hpb

/-- The chart evaluated at the covering object agrees with the pullback of the given point of
the quotient. -/
private theorem actionQuotient_fiber_section_eq
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (W : BigFppfOver B S hS) (p : W ⟶ V) (q : W ⟶ fieldObject (hS := hS) K hK b)
    (hpb : IsPullback (yoneda.map p) (yoneda.map q) (actionQuotientAtlasMap B hS V G a ha)
      (yonedaEquiv.symm ξ)) :
    (actionQuotientAtlasMap B hS V G a ha).app (op W) p =
      (yoneda.map q ≫ yonedaEquiv.symm ξ).app (op W) (𝟙 W) := by
  simpa using congrArg (fun η => η.app (op W) (𝟙 W)) hpb.w

/-- Two points of `V` with the same image in the quotient are the target and the source of a
point of the relation. -/
private theorem actionRelation_point_of_quotient_eq
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType))
    {T : BigFppfOver B S hS} (p q : T ⟶ V)
    (heq : (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app (op T)
        ((Over.post B.inclusion).map p) =
      (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app (op T)
        ((Over.post B.inclusion).map q)) :
    ∃ r : T ⟶ siteActionRelationScheme G B hS V (contains_actionRelationScheme G B hS V a ha),
      r ≫ siteActionRelationTarget G B hS V
          (contains_actionRelationScheme G B hS V a ha) a = p ∧
      r ≫ siteActionRelationSource G B hS V
          (contains_actionRelationScheme G B hS V a ha) = q := by
  let atlas := actionQuotientAtlasMap B hS V G a ha
  have hcomp : yoneda.map p ≫ atlas = yoneda.map q ≫ atlas :=
    (yonedaEquiv (X := T) (F := actionQuotient G B hS V a)).injective (by
      simpa only [yonedaEquiv_comp, yonedaEquiv_yoneda_map, actionQuotientAtlasMap_app,
        atlas] using heq)
  let hpull := (actionQuotientAtlas_properties B hS V G a ha hdesc).2.2
  let ell := hpull.lift (yoneda.map p) (yoneda.map q) hcomp
  refine ⟨yonedaEquiv ell, ?_, ?_⟩
  · exact (congrArg yonedaEquiv (hpull.lift_fst _ _ hcomp)).trans (yonedaEquiv_yoneda_map p)
  · exact (congrArg yonedaEquiv (hpull.lift_snd _ _ hcomp)).trans (yonedaEquiv_yoneda_map q)

/-- A field-valued point of the quotient lifts to a point of `V` over a finite separable
extension of the base field, with the prescribed image in the quotient. -/
private theorem quotient_point_has_finite_separable_lift
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType))
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b))) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : Module.Finite K L)
      (_ : Algebra.IsSeparable K L) (hL : B.Contains (Spec (.of L)))
      (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
      (hf : f ≫ (underlyingOver B hS V).hom =
        Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b),
      (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldExtensionObject B hS K b L hL)) (𝟙 _ ≫ Over.homMk f hf) =
      (actionQuotient G B hS V a).map (fieldExtensionRestrict B hS K hK b L hL).op ξ := by
  classical
  obtain ⟨W, p, q, hpb, hq, hqEtale⟩ :=
    exists_actionQuotient_field_fiber B hS V G a K hK b ha hdesc ξ
  let qPost := (Over.post B.inclusion).map q
  let qScheme := (BigFppfOver.toScheme B S hS).map q
  have : Etale qScheme := hqEtale
  obtain ⟨x, hx⟩ := hq.surj (default : Spec (.of K))
  obtain ⟨L, hField, hAlg, hFinite, hSep, fW, hfW⟩ :=
    Etale.exists_finiteSeparable_point K qScheme ⟨x⟩
  let hL : B.Contains (Spec (.of L)) := contains_spec_of_finiteDimensional B K hK L
  let T := fieldExtensionObject B hS K b L hL
  have hqw : qScheme ≫ b = ((Over.post B.inclusion).obj W).hom := qPost.w
  have hbase : fW ≫ ((Over.post B.inclusion).obj W).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b := by
    rw [← hqw, ← Category.assoc, hfW]
  let tPost : (Over.post B.inclusion).obj T ⟶ (Over.post B.inclusion).obj W := by
    change Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b) ⟶
      Over.mk ((Over.post B.inclusion).obj W).hom
    exact Over.homMk fW hbase
  let t : T ⟶ W := (Over.post B.inclusion).preimage tPost
  have ht : (Over.post B.inclusion).map t = tPost := (Over.post B.inclusion).map_preimage tPost
  let pPost := (Over.post B.inclusion).map p
  let pScheme := (BigFppfOver.toScheme B S hS).map p
  have hpbase : pScheme ≫ (underlyingOver B hS V).hom =
      ((Over.post B.inclusion).obj W).hom := pPost.w
  let f : Spec (.of L) ⟶ (underlyingOver B hS V).left := fW ≫ pScheme
  have hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b := by
    rw [show f ≫ (underlyingOver B hS V).hom =
      fW ≫ pScheme ≫ (underlyingOver B hS V).hom from Category.assoc _ _ _, hpbase, hbase]
  refine ⟨L, hField, hAlg, hFinite, hSep, hL, f, hf, ?_⟩
  have hEqAtlas : (actionQuotientAtlasMap B hS V G a ha).app (op T) (t ≫ p) =
      (actionQuotient G B hS V a).map (t ≫ q).op ξ :=
    congrArg (fun η => η.app (op T) t) hpb.w
  have hpT : t ≫ p = fieldPointMorphism B hS V K b L hL f hf := by
    refine (Over.post B.inclusion).map_injective (Over.OverMorphism.ext ?_)
    change ((Over.post B.inclusion).map t).left ≫ pPost.left = f
    rw [ht]
    rfl
  have hqT : t ≫ q = fieldExtensionRestrict B hS K hK b L hL := by
    refine (Over.post B.inclusion).map_injective (Over.OverMorphism.ext ?_)
    change ((Over.post B.inclusion).map t).left ≫ qPost.left = _
    rw [ht]
    have hrestrict : ((Over.post B.inclusion).map
        (fieldExtensionRestrict B hS K hK b L hL)).left =
        Spec.map (CommRingCat.ofHom (algebraMap K L)) := by
      change ((Over.post B.inclusion).map ((Over.post B.inclusion).preimage
        (fieldExtensionPostRestrict B hS K hK b L hL))).left = _
      rw [(Over.post B.inclusion).map_preimage]
      rfl
    exact hfW.trans hrestrict.symm
  rw [actionQuotientAtlasMap_app, hpT, hqT] at hEqAtlas
  exact hEqAtlas

/-- A field-valued point of the quotient lifts to a point of `V` over a finite Galois
extension of the base field. -/
private theorem exists_galois_field_lift
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType))
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b))) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : FiniteDimensional K L)
      (_ : IsGalois K L) (_ : B.Contains (Spec (.of L)))
      (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
      (hf : f ≫ (underlyingOver B hS V).hom =
        Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b),
      IsQuotientLift B hS V G a K hK b ξ L f hf := by
  classical
  obtain ⟨E, hFieldE, hAlgKE, hFiniteE, hSepE, hE, f, hf, hsecE⟩ :=
    quotient_point_has_finite_separable_lift B hS V G a K hK b ha hdesc ξ
  let : Field E := hFieldE
  let : Algebra K E := hAlgKE
  let : Module.Finite K E := hFiniteE
  let : Algebra.IsSeparable K E := hSepE
  obtain ⟨M, hFieldM, hAlgKM, hFiniteM, hGaloisM, ⟨ι⟩⟩ :=
    exists_isGalois_of_finiteDimensional_of_isSeparable K E
  let : Field M := hFieldM
  let : Algebra K M := hAlgKM
  let : FiniteDimensional K M := hFiniteM
  let : IsGalois K M := hGaloisM
  let hM : B.Contains (Spec (.of M)) := contains_spec_of_finiteDimensional B K hK M
  refine ⟨M, hFieldM, hAlgKM, hFiniteM, hGaloisM, hM,
    Spec.map (CommRingCat.ofHom ι.toRingHom) ≫ f, ?_, ?_⟩
  · rw [Category.assoc, hf, ← Category.assoc,
    specMap_algHom_comp_specMap_algebraMap]
  · exact isQuotientLift_comp_fieldExtensionMap B hS V G a K hK b ξ E M hE hM ι f hf
      (isQuotientLift_of_section B hS V G a K hK b ξ E hE f hf hsecE)

/-- Two field-valued points of `V` over the same point of the base with the same image in the
quotient differ by the action of a group element. -/
private theorem action_related_by_quotient_field_points
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType))
    {k : Type u} [Field k] (hk : B.Contains (Spec (.of k))) (c : Spec (.of k) ⟶ S)
    (p q : Spec (.of k) ⟶ (underlyingOver B hS V).left)
    (hp : p ≫ (underlyingOver B hS V).hom = c)
    (hq : q ≫ (underlyingOver B hS V).hom = c)
    (heq : (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldObject (hS := hS) k hk c)) (𝟙 _ ≫ Over.homMk p hp) =
      (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).app
        (op (fieldObject (hS := hS) k hk c)) (𝟙 _ ≫ Over.homMk q hq)) :
    ∃ g : G, p = q ≫ (a g).hom.left := by
  let T := fieldObject (hS := hS) k hk c
  let pPost : (Over.post B.inclusion).obj T ⟶ (Over.post B.inclusion).obj V :=
    Over.homMk p hp
  let qPost : (Over.post B.inclusion).obj T ⟶ (Over.post B.inclusion).obj V :=
    Over.homMk q hq
  let pT : T ⟶ V := (Over.post B.inclusion).preimage pPost
  let qT : T ⟶ V := (Over.post B.inclusion).preimage qPost
  have hpT : (Over.post B.inclusion).map pT = pPost := (Over.post B.inclusion).map_preimage _
  have hqT : (Over.post B.inclusion).map qT = qPost := (Over.post B.inclusion).map_preimage _
  have hquot : (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T)
      ((Over.post B.inclusion).map pT) =
    (toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)).app (op T)
      ((Over.post B.inclusion).map qT) := by
    rw [hpT, hqT]
    simpa [pPost, qPost, T] using heq
  obtain ⟨r, hrt, hrs⟩ :=
    actionRelation_point_of_quotient_eq B hS V G a ha hdesc pT qT hquot
  let z : Spec (.of k) ⟶ (actionRelationScheme (underlyingOver B hS V) G).left :=
    ((Over.post B.inclusion).map r).left
  obtain ⟨g, z', hz⟩ := exists_sigmaι_factor_of_fieldPoint B hS V G z
  have hsourceMap : ((Over.post B.inclusion).map (siteActionRelationSource G B hS V
      (contains_actionRelationScheme G B hS V a ha))).left =
      (actionRelationSource (underlyingOver B hS V) G).left := rfl
  have htargetMap : ((Over.post B.inclusion).map (siteActionRelationTarget G B hS V
      (contains_actionRelationScheme G B hS V a ha) a)).left =
      (actionRelationTarget (underlyingOver B hS V) G a).left := rfl
  have hz' : z = z' ≫ actionCopy B hS V G g := by
    calc
      z = (z ≫ (actionRelationUnderlyingIso (underlyingOver B hS V) G).hom) ≫
          (actionRelationUnderlyingIso (underlyingOver B hS V) G).inv := by simp
      _ = z' ≫ (Sigma.ι (fun _ : G => (underlyingOver B hS V).left) g ≫
          (actionRelationUnderlyingIso (underlyingOver B hS V) G).inv) := by
        rw [hz, Category.assoc]
      _ = z' ≫ actionCopy B hS V G g := by
        rw [actionRelationUnderlyingIso_inv_ι]
        rfl
  have hsource : z ≫ (actionRelationSource (underlyingOver B hS V) G).left = q := by
    rw [← hsourceMap]
    refine (congrArg Over.Hom.left
      (congrArg (Over.post B.inclusion).map hrs)).trans ?_
    rw [hqT]
    rfl
  have htarget : z ≫ (actionRelationTarget (underlyingOver B hS V) G a).left = p := by
    rw [← htargetMap]
    refine (congrArg Over.Hom.left
      (congrArg (Over.post B.inclusion).map hrt)).trans ?_
    rw [hpT]
    rfl
  have hqz : z' = q := by
    calc
      z' = z' ≫ (actionCopy B hS V G g ≫
          (actionRelationSource (underlyingOver B hS V) G).left) := by
        rw [actionCopy_source, Category.comp_id]
      _ = z ≫ (actionRelationSource (underlyingOver B hS V) G).left := by
        rw [← Category.assoc, ← hz']
      _ = q := hsource
  refine ⟨g, ?_⟩
  calc
    p = z ≫ (actionRelationTarget (underlyingOver B hS V) G a).left := htarget.symm
    _ = z' ≫ (actionCopy B hS V G g ≫
        (actionRelationTarget (underlyingOver B hS V) G a).left) := by
      rw [← Category.assoc, hz']
    _ = q ≫ (a g).hom.left := by rw [actionCopy_target, hqz]

/-- The Galois group of a finite Galois extension carrying an equivariant lift acts through a
homomorphism to the acting group. -/
private theorem exists_galois_action_hom
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType))
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (L : Type u) [Field L] [Algebra K L] (hL : B.Contains (Spec (.of L)))
    (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
    (hf : f ≫ (underlyingOver B hS V).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
    (hsec : IsQuotientLift B hS V G a K hK b ξ L f hf) :
    ∃ ρ : (L ≃ₐ[K] L) →* G, ∀ σ,
      Spec.map (CommRingCat.ofHom (σ⁻¹).toRingHom) ≫ f = f ≫ (a (ρ σ)).hom.left := by
  have hex (σ : L ≃ₐ[K] L) : ∃ g : G,
      Spec.map (CommRingCat.ofHom (σ⁻¹).toRingHom) ≫ f = f ≫ (a g).hom.left := by
    refine action_related_by_quotient_field_points B hS V G a ha hdesc hL
      (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b)
      (Spec.map (CommRingCat.ofHom (σ⁻¹).toRingHom) ≫ f) f
      (by rw [Category.assoc, hf, ← Category.assoc,
        specMap_algEquiv_comp_specMap_algebraMap]) hf ?_
    exact quotient_section_invariant_under_site_field_automorphism B hS V G a K hK b ξ L hL
      f hf hsec σ⁻¹
  choose g hg using hex
  refine ⟨{ toFun := g, map_one' := ?_, map_mul' := ?_ }, hg⟩
  · refine action_injective_on_fieldPoint B hS V G a ha f ?_
    rw [← hg, map_one]
    change Spec.map (𝟙 (CommRingCat.of L)) ≫ f = f ≫ 𝟙 _
    simp
  · intro σ τ
    refine action_injective_on_fieldPoint B hS V G a ha f ?_
    calc
      f ≫ (a (g (σ * τ))).hom.left =
          Spec.map (CommRingCat.ofHom ((σ * τ)⁻¹).toRingHom) ≫ f := (hg _).symm
      _ = Spec.map (CommRingCat.ofHom (τ⁻¹).toRingHom) ≫
          Spec.map (CommRingCat.ofHom (σ⁻¹).toRingHom) ≫ f := by
        rw [mul_inv_rev, ← Category.assoc, ← Spec.map_comp]
        rfl
      _ = f ≫ (a (g τ)).hom.left ≫ (a (g σ)).hom.left := by
        rw [hg, ← Category.assoc, hg, Category.assoc]
      _ = f ≫ (a (g σ * g τ)).hom.left := by
        simp only [map_mul, Aut.Aut_mul_def]
        rfl

/-- **Stacks 02Z5, the Galois-equivariant lift, granted effective descent along the covering
sieves of the site.** Every field-valued point of an action quotient lifts equivariantly after
a finite Galois extension, with quotient image equal to the given point's pullback.

The chart `h_V ⟶ V/G` is surjective and étale with the graph relation for its kernel pair, so
the given `K`-valued point `ξ` of the quotient lifts to a point of `V` over some finite
separable, hence after enlarging some finite Galois, extension `M/K`. Two lifts of `ξ` over the
same field differ by the action of a group element, which is unique because the action is free
on field-valued points; so the Galois group of `M/K` acts through a homomorphism `ρ` to `G`.
Over the fixed field `N` of the kernel of `ρ` the lift descends, and the Galois group of `N/K`
is the range of `ρ`, a finite subgroup of `G`.

The hypothesis `hdesc` is the one carried by
`AlgebraicGeometry.Space.isAlgebraicSpace_actionQuotient`, which is what makes the chart
surjective and étale; the source has no such hypothesis. -/
theorem exists_galois_equivariant_lift_of_descent
    (ha : ActsNontriviallyOnFixedResidueFields (underlyingOver B hS V) G a)
    (ξ : (actionQuotient G B hS V a).obj (op (fieldObject (hS := hS) K hK b)))
    (hdesc : IsEffectiveDescentAlongCoveringSieve B S hS
      (MorphismProperty.monomorphisms Scheme.{u} ⊓ @LocallyOfFiniteType)) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : FiniteDimensional K L)
      (_ : IsGalois K L) (H : Subgroup G) (_ : Finite H) (e : H ≃* (L ≃ₐ[K] L))
      (f : Spec (.of L) ⟶ (underlyingOver B hS V).left)
      (hf : f ≫ (underlyingOver B hS V).hom =
        Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ b),
      (∀ h : H,
        Spec.map (CommRingCat.ofHom (e h⁻¹).toRingHom) ≫ f = f ≫ (a h.1).hom.left) ∧
      IsQuotientLift B hS V G a K hK b ξ L f hf := by
  classical
  obtain ⟨M, hMField, hMAlg, hMFinite, hMGal, hM, fM, hfM, hsecM⟩ :=
    exists_galois_field_lift B hS V G a K hK b ha hdesc ξ
  let : Field M := hMField
  let : Algebra K M := hMAlg
  let : FiniteDimensional K M := hMFinite
  let : IsGalois K M := hMGal
  obtain ⟨ρ, hρ⟩ := exists_galois_action_hom B hS V G a K hK b ha hdesc ξ M hM fM hfM hsecM
  let N : IntermediateField K M := IntermediateField.fixedField ρ.ker
  have : IsGalois K N := IsGalois.of_fixedField_normal_subgroup ρ.ker
  have : Finite ρ.range := Finite.of_surjective ρ.rangeRestrict ρ.rangeRestrict_surjective
  let e : ρ.range ≃* (N ≃ₐ[K] N) :=
    (QuotientGroup.quotientKerEquivRange ρ).symm.trans
      (IsGalois.normalAutEquivQuotient ρ.ker)
  have he (σ : M ≃ₐ[K] M) :
      e (ρ.rangeRestrict σ) = AlgEquiv.restrictNormalHom N σ := by
    change IsGalois.normalAutEquivQuotient ρ.ker
      ((QuotientGroup.quotientKerEquivRange ρ).symm (ρ.rangeRestrict σ)) = _
    have hq : (QuotientGroup.quotientKerEquivRange ρ) (QuotientGroup.mk σ) =
        ρ.rangeRestrict σ := rfl
    rw [← hq, MulEquiv.symm_apply_apply]
    rfl
  have hfix (σ : M ≃ₐ[N] M) :
      Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ fM = fM := by
    have ht : σ.restrictScalars K ∈ ρ.ker := by
      rw [← IntermediateField.fixingSubgroup_fixedField ρ.ker]
      exact ((IntermediateField.fixingSubgroupEquiv N).symm σ).property
    have h := hρ (σ.restrictScalars K)⁻¹
    rw [map_inv, show ρ (σ.restrictScalars K) = 1 from ht, inv_one, map_one] at h
    change Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ fM = fM ≫ 𝟙 _ at h
    simpa only [Category.comp_id] using h
  obtain ⟨f, hfac⟩ := exists_specMap_comp_eq_of_isGaloisInvariant N M
    (underlyingOver B hS V).left fM hfix
  let r : Spec (.of M) ⟶ Spec (.of N) := Spec.map (CommRingCat.ofHom (algebraMap N M))
  let n : Spec (.of N) ⟶ Spec (.of K) := Spec.map (CommRingCat.ofHom (algebraMap K N))
  have hrn : r ≫ n = Spec.map (CommRingCat.ofHom (algebraMap K M)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, IsScalarTower.algebraMap_eq K N M]
  have : Etale r := etale_specMap_algebraMap N M
  have : Surjective r := ⟨fun y => ⟨default, Subsingleton.elim _ _⟩⟩
  have hf : f ≫ (underlyingOver B hS V).hom = n ≫ b := by
    refine (cancel_epi r).mp ?_
    rw [← Category.assoc, hfac, hfM, ← hrn, Category.assoc]
  refine ⟨N, inferInstance, inferInstance, inferInstance, inferInstance, ρ.range,
    inferInstance, e, f, hf, ?_, ?_⟩
  · intro h
    obtain ⟨σ, rfl⟩ := ρ.rangeRestrict_surjective h
    refine (cancel_epi r).mp ?_
    have hcomm : r ≫ Spec.map (CommRingCat.ofHom (e ((ρ.rangeRestrict σ)⁻¹)).toRingHom) =
        Spec.map (CommRingCat.ofHom (σ⁻¹).toRingHom) ≫ r := by
      rw [← map_inv, he, ← Spec.map_comp, ← Spec.map_comp]
      exact congrArg Spec.map (CommRingCat.hom_ext
        (RingHom.ext fun x => AlgEquiv.restrictNormal_commutes σ⁻¹ N x))
    rw [← Category.assoc, hcomm, Category.assoc, hfac, ← Category.assoc, hfac]
    exact hρ σ
  · let hN : B.Contains (Spec (.of N)) := contains_spec_of_finiteDimensional B K hK N
    let T := fieldExtensionObject B hS K b N hN
    let T' := fieldExtensionObject B hS K b M hM
    let j := fieldExtensionMap B hS K b N M hN hM N.val
    let F := actionQuotient G B hS V a
    let η := toQuotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
      (actionRelation (underlyingOver B hS V) G a)
    have hjcover : Sieve.ofArrows (fun _ : PUnit.{u + 1} => T') (fun _ => j) ∈
        BigFppfOver.topology B S hS T := by
      refine sieve_ofArrows_mem_topology_of_etale B hS _ _
        (fun y => ⟨PUnit.unit, (default : Spec (.of M)),
          Subsingleton.elim (α := Spec (.of N)) _ _⟩) fun _ => inferInstanceAs (Etale r)
    refine isQuotientLift_of_section B hS V G a K hK b ξ N hN f hf ?_
    have sep := (Presieve.isSeparatedFor_iff_generate (P := F)).mpr
      ((quotientSheaf (BigFppfOver.topology B S hS) (Over.post B.inclusion)
        (actionRelation (underlyingOver B hS V) G a)).property.isSheafFor
        _ hjcover).isSeparatedFor
    refine sep.ext ?_
    rintro W s ⟨i⟩
    have hn := congrArg (fun φ => φ (Over.homMk f hf)) (η.naturality j.op)
    have hjf : (Over.post B.inclusion).map j ≫ Over.homMk f hf = Over.homMk fM hfM :=
      Over.OverMorphism.ext hfac
    have hjr : j ≫ fieldExtensionRestrict B hS K hK b N hN =
        fieldExtensionRestrict B hS K hK b M hM := by
      refine (Over.post B.inclusion).map_injective ?_
      simp only [Functor.map_comp, fieldExtensionRestrict, Functor.map_preimage]
      exact Over.OverMorphism.ext hrn
    change η.app (op T') ((Over.post B.inclusion).map j ≫ Over.homMk f hf) =
      F.map j.op (η.app (op T) (Over.homMk f hf)) at hn
    change F.map j.op (η.app (op T) (Over.homMk f hf)) =
      F.map j.op (F.map (fieldExtensionRestrict B hS K hK b N hN).op ξ)
    rw [← hn, hjf]
    change _ = (F.map (fieldExtensionRestrict B hS K hK b N hN).op ≫ F.map j.op) ξ
    rw [← F.map_comp, ← op_comp, hjr]
    exact hsecM T' (𝟙 _)

end AlgebraicGeometry.Space

end
