-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Space

universe u

/-- Every covering sieve of the big fppf site is refined by the family of a covering. -/
theorem exists_fppf_hypercover_refining_sieve
    {site : BigFppfSite.{u}} {S : Scheme.{u}} (hS : site.Contains S)
    (T : BigFppfOver site S hS) (W : Sieve T) (hW : W ∈ BigFppfOver.topology site S hS T) :
    ∃ E : PreZeroHypercover.{u + 1} T,
      BigFppfOver.IsCovering site S hS ⟨T, E⟩ ∧ E.presieve₀ ≤ W := by
  have hextract : ∀ {X : site.Schemes} {V : Sieve X}, site.precoverage.Saturate X V →
      ∃ E : PreZeroHypercover.{u + 1} X, site.IsCovering ⟨X, E⟩ ∧ E.presieve₀ ≤ V := by
    intro X V hV
    induction hV with
    | of X R hR =>
        rcases hR with ⟨E, hE, hcov⟩
        exact ⟨E, hcov, hE ▸ Sieve.le_generate E.presieve₀⟩
    | top X =>
        refine ⟨PreZeroHypercover.singleton (𝟙 X), site.coverings_isSite.1 (𝟙 X), ?_⟩
        exact Presieve.ofArrows_le_iff.2 fun _ => trivial
    | @pullback X V hV Y f ih =>
        obtain ⟨E, hE, hle⟩ := ih
        obtain ⟨P, p₁, p₂, hpb, hP⟩ := site.coverings_isSite.2.2 ⟨X, E⟩ hE Y f
        refine ⟨⟨E.I₀, P, p₂⟩, hP, ?_⟩
        show Presieve.ofArrows P p₂ ≤ (Sieve.pullback f V).arrows
        rw [Presieve.ofArrows_le_iff]
        intro i
        show V (p₂ i ≫ f)
        rw [← (hpb i).w]
        exact V.downward_closed (hle _ _ ⟨i⟩) (p₁ i)
    | @transitive X V Z hV hstep ih ihstep =>
        obtain ⟨E, hE, hle⟩ := ih
        have hlocal : ∀ i : E.I₀, ∃ F : PreZeroHypercover.{u + 1} (E.X i),
            site.IsCovering ⟨E.X i, F⟩ ∧ F.presieve₀ ≤ (Z.pullback (E.f i)) :=
          fun i => ihstep (hle _ _ ⟨i⟩)
        choose F hF hFle using hlocal
        have hcomp := site.coverings_isSite.2.1 ⟨X, E⟩ hE
          (fun i => ⟨E.X i, F i⟩) hF (fun _ => rfl)
        refine ⟨E.bind (fun i => (F i).pushforward (eqToHom rfl)), hcomp, ?_⟩
        show Presieve.ofArrows (fun ij : Σ i, (F i).I₀ => (F ij.1).X ij.2)
          (fun ij => (F ij.1).f ij.2 ≫ E.f ij.1) ≤ Z.arrows
        rw [Presieve.ofArrows_le_iff]
        exact fun ij => hFle ij.1 _ _ ⟨ij.2⟩
  obtain ⟨E, hE, hle⟩ := hextract
    (Precoverage.mem_toGrothendieck_iff.mp
      ((GrothendieckTopology.mem_over_iff site.topology W).mp hW))
  let Eover : PreZeroHypercover.{u + 1} T :=
    ⟨E.I₀, (fun i => Over.mk (E.f i ≫ T.hom)), (fun i => Over.homMk (E.f i))⟩
  refine ⟨Eover, ?_, ?_⟩
  · show site.IsCovering ⟨(BigFppfOver.forget site S hS).obj T,
      (Eover.map (BigFppfOver.forget site S hS))⟩
    exact hE
  · show Presieve.ofArrows Eover.X Eover.f ≤ W.arrows
    rw [Presieve.ofArrows_le_iff]
    exact fun i => (Sieve.overEquiv_iff W (E.f i)).mp (hle _ _ (show E.presieve₀ (E.f i) from ⟨i⟩))

/-- The sieve generated by a covering family of the big fppf site is a covering sieve. -/
theorem fppf_hypercover_sieve_mem
    {site : BigFppfSite.{u}} {S : Scheme.{u}} (hS : site.Contains S)
    (T : BigFppfOver site S hS) (E : PreZeroHypercover.{u + 1} T)
    (hE : BigFppfOver.IsCovering site S hS ⟨T, E⟩) :
    Sieve.generate E.presieve₀ ∈ BigFppfOver.topology site S hS T := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate]
  apply (Precoverage.mem_toGrothendieck_iff).2
  let F := BigFppfOver.forget site S hS
  have hsat : site.precoverage.Saturate T.left (Sieve.generate ((E.map F).presieve₀)) :=
    Precoverage.Saturate.of _ _ ⟨E.map F, rfl, hE⟩
  rw [PreZeroHypercover.presieve₀_map] at hsat
  simpa only [← Sieve.arrows_generate_map_eq_functorPushforward, Sieve.generate_sieve] using hsat

/-- A sieve containing every member of a covering family of the big fppf site is covering. -/
private theorem sieve_mem_topology_of_forall_f
    {site : BigFppfSite.{u}} {S : Scheme.{u}} (hS : site.Contains S)
    (T : BigFppfOver site S hS) (E : PreZeroHypercover.{u + 1} T)
    (hE : BigFppfOver.IsCovering site S hS ⟨T, E⟩) (W : Sieve T) (h : ∀ i, W (E.f i)) :
    W ∈ BigFppfOver.topology site S hS T := by
  refine (BigFppfOver.topology site S hS).superset_covering ?_
    (fppf_hypercover_sieve_mem hS T E hE)
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  exact h

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {Z : (BigFppfOver site S hS)ᵒᵖ ⥤ Type u} {R U : Over Z}

/-- The point of the base under a section of `U`. -/
def sectionBaseMorphism (T : BigFppfOver site S hS) (x : U.left.obj (op T)) :
    yoneda.obj T ⟶ Z :=
  yonedaEquiv.symm x ≫ U.hom

/-- Two sections of `U` over a test object are related by the pre-relation when they lie over a
common point of the base and are related there. -/
def sectionRelated (j : PreRelation R U) (T : BigFppfOver site S hS)
    (x y : U.left.obj (op T)) : Prop :=
  ∃ (b : yoneda.obj T ⟶ Z) (hx : sectionBaseMorphism T x = b)
      (hy : sectionBaseMorphism T y = b),
    j.Rel b ⟨yonedaEquiv.symm x, by simpa [sectionBaseMorphism] using hx⟩
      ⟨yonedaEquiv.symm y, by simpa [sectionBaseMorphism] using hy⟩

/-- The base point of the image of a section of `R` under a morphism over `Z` is the base point
of that section. -/
theorem sectionBaseMorphism_app (T : BigFppfOver site S hS) (η : R ⟶ U)
    (r : R.left.obj (op T)) :
    sectionBaseMorphism T (η.left.app (op T) r) = yonedaEquiv.symm r ≫ R.hom := by
  rw [sectionBaseMorphism, ← yonedaEquiv_symm_naturality_right, Category.assoc, Over.w η]

/-- For a pre-equivalence relation, two sections with the same class in the quotient *presheaf*
are already related in one step. -/
theorem related_of_quotientPresheaf_eq (j : PreRelation R U)
    (hj : IsPreEquivalenceRelation j) (T : BigFppfOver site S hS)
    (x y : U.left.obj (op T))
    (hxy : (coequalizer.π j.target.left j.source.left).app (op T) x =
      (coequalizer.π j.target.left j.source.left).app (op T) y) :
    sectionRelated j T y x := by
  let edge : U.left.obj (op T) → U.left.obj (op T) → Prop := fun a b =>
    ∃ r : R.left.obj (op T),
      j.target.left.app (op T) r = a ∧ j.source.left.app (op T) r = b
  obtain ⟨e, he⟩ := quotientPresheaf_obj_equiv j T
  have hgen : Relation.EqvGen edge x y := Quot.eqvGen_exact (by
    rw [← he x, ← he y]
    exact congrArg e hxy)
  have hEquiv : Equivalence (sectionRelated j T) := by
    refine ⟨fun a => ?_, ?_, ?_⟩
    · exact ⟨sectionBaseMorphism T a, rfl, rfl,
        (hj T (sectionBaseMorphism T a)).refl ⟨yonedaEquiv.symm a, rfl⟩⟩
    · rintro a b ⟨base, ha, hb, hrel⟩
      exact ⟨base, hb, ha, (hj T base).symm hrel⟩
    · rintro a b c ⟨base₁, ha, hb₁, habrel⟩ ⟨base₂, hb₂, hc, hbcrel⟩
      obtain rfl := hb₁.symm.trans hb₂
      exact ⟨base₁, ha, hc, (hj T base₁).trans habrel hbcrel⟩
  refine hEquiv.symm (hEquiv.eqvGen_iff.mp (hgen.mono ?_))
  rintro _ _ ⟨r, rfl, rfl⟩
  have hRbase : yonedaEquiv.symm r ≫ R.hom =
      sectionBaseMorphism T (j.target.left.app (op T) r) :=
    (sectionBaseMorphism_app T j.target r).symm
  refine ⟨_, rfl,
    (sectionBaseMorphism_app T j.source r).trans (sectionBaseMorphism_app T j.target r).symm,
    ⟨yonedaEquiv.symm r, hRbase⟩, ?_, ?_⟩
  all_goals
    apply yonedaEquiv.injective
    simp [yonedaEquiv_comp]

/-- The unit of sheafification on the big fppf site is locally injective. This is not available as
an instance at these universes, and follows from the site being essentially small. -/
theorem isLocallyInjective_toSheafify_bigFppfOver
    (J : GrothendieckTopology (BigFppfOver site S hS)) [HasWeakSheafify J (Type u)]
    (P : (BigFppfOver site S hS)ᵒᵖ ⥤ Type u) :
    Presheaf.IsLocallyInjective J (toSheafify J P) := by
  have : EssentiallySmall.{u} (BigFppfOver site S hS) := essentiallySmall_bigFppfOver site S hS
  let : J.WEqualsLocallyBijective (Type u) :=
    GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall J
  exact (J.W_toSheafify P).isLocallyInjective

variable [HasSheafify (BigFppfOver.topology site S hS) (Type u)]
  (j : PreRelation R U) (hj : IsPreEquivalenceRelation j)

include hj

/-- **Stacks 046O.** Two sections of `U` have the same image in the quotient sheaf if and only
if, on an fppf covering, they are the source and the target of a common section of `R`. -/
@[stacks 046O "local characterization"]
theorem toQuotientSheaf_eq_iff_locally_related (T : BigFppfOver site S hS)
    (a b : U.left.obj (op T)) :
    ((toQuotientSheaf j).app (op T) a = (toQuotientSheaf j).app (op T) b) ↔
      ∃ E : PreZeroHypercover.{u + 1} T,
        BigFppfOver.IsCovering site S hS ⟨T, E⟩ ∧
          ∀ i : E.I₀, ∃ r : R.left.obj (op (E.X i)),
            (U.left.map (E.f i).op a = j.source.left.app (op (E.X i)) r) ∧
              (U.left.map (E.f i).op b = j.target.left.app (op (E.X i)) r) := by
  constructor
  · intro hab
    let P := quotientPresheaf j
    let π := coequalizer.π j.target.left j.source.left
    let J := BigFppfOver.topology site S hS
    let W := Presheaf.equalizerSieve (F := P) (X := op T) (π.app (op T) a) (π.app (op T) b)
    have hW : W ∈ J T := by
      have : Presheaf.IsLocallyInjective J (toSheafify J P) :=
        isLocallyInjective_toSheafify_bigFppfOver J P
      exact Presheaf.equalizerSieve_mem J (toSheafify J P) (π.app (op T) a) (π.app (op T) b) hab
    obtain ⟨E, hE, hEref⟩ := exists_fppf_hypercover_refining_sieve hS T W hW
    refine ⟨E, hE, fun i => ?_⟩
    obtain ⟨_, _, _, ⟨r, hrT, hrS⟩⟩ := related_of_quotientPresheaf_eq j hj (E.X i)
      (U.left.map (E.f i).op a) (U.left.map (E.f i).op b) (by
        rw [NatTrans.naturality_apply, NatTrans.naturality_apply]
        exact hEref _ _ ⟨i⟩)
    exact ⟨yonedaEquiv r.1, by simpa [yonedaEquiv_comp] using (congrArg yonedaEquiv hrS).symm,
      by simpa [yonedaEquiv_comp] using (congrArg yonedaEquiv hrT).symm⟩
  · rintro ⟨E, hE, hrel⟩
    let q := toQuotientSheaf j
    let W := Presheaf.equalizerSieve (F := (quotientSheaf j).obj) (X := op T)
      (q.app (op T) a) (q.app (op T) b)
    have hW : W ∈ BigFppfOver.topology site S hS T := by
      refine sieve_mem_topology_of_forall_f hS T E hE _ fun i => ?_
      obtain ⟨r, ha, hb⟩ := hrel i
      show (quotientSheaf j).obj.map (E.f i).op (q.app (op T) a) =
        (quotientSheaf j).obj.map (E.f i).op (q.app (op T) b)
      rw [← NatTrans.naturality_apply q (E.f i).op a,
        ← NatTrans.naturality_apply q (E.f i).op b, ha, hb]
      exact (congrArg (fun f => f.app (op (E.X i)) r) (target_toQuotientSheaf_eq_source j)).symm
    have hsep := (isSheaf_iff_isSheaf_of_type (BigFppfOver.topology site S hS)
      (quotientSheaf j).obj).1 (quotientSheaf j).property
    show q.app (op T) a = q.app (op T) b
    exact (hsep W hW).isSeparatedFor.ext (fun Y f hf => hf)

/-- **Stacks 046O.** The relation covers the fibre square of the quotient projection, as a map of
fppf sheaves. -/
@[stacks 046O "surjectivity of the relation map"]
theorem isLocallySurjective_relationToQuotientPullback :
    Presheaf.IsLocallySurjective (BigFppfOver.topology site S hS)
      (pullback.lift j.source.left j.target.left
        (target_toQuotientSheaf_eq_source j).symm) := by
  let q := toQuotientSheaf j
  let lift := pullback.lift j.source.left j.target.left (target_toQuotientSheaf_eq_source j).symm
  refine ⟨?_⟩
  intro T x
  let a := (pullback.fst q q).app (op T) x
  let b := (pullback.snd q q).app (op T) x
  have hab : q.app (op T) a = q.app (op T) b := by
    simpa [a, b, q] using congrArg (fun f => f.app (op T) x) (pullback.condition (f := q) (g := q))
  obtain ⟨E, hE, hrel⟩ := (toQuotientSheaf_eq_iff_locally_related j hj T a b).1 hab
  refine sieve_mem_topology_of_forall_f hS T E hE _ fun i => ?_
  obtain ⟨r, ha, hb⟩ := hrel i
  refine ⟨r, ?_⟩
  have hmor : yonedaEquiv.symm (lift.app (op (E.X i)) r) =
      yonedaEquiv.symm ((pullback q q).map (E.f i).op x) := by
    rw [← yonedaEquiv_symm_naturality_right, yonedaEquiv_symm_map]
    apply pullback.hom_ext
    · simp only [Category.assoc, lift, pullback.lift_fst]
      simpa [yonedaEquiv_symm_naturality_right, yonedaEquiv_symm_naturality_left, a, q]
        using congrArg yonedaEquiv.symm ha.symm
    · simp only [Category.assoc, lift, pullback.lift_snd]
      simpa [yonedaEquiv_symm_naturality_right, yonedaEquiv_symm_naturality_left, b, q]
        using congrArg yonedaEquiv.symm hb.symm
  exact yonedaEquiv.symm.injective hmor

end AlgebraicGeometry.Space

