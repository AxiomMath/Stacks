module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.RelationsOverSpace
public import Mathlib.CategoryTheory.Limits.FunctorCategory.Basic
public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Equalizers
public import Mathlib.CategoryTheory.Limits.Types.Coequalizers

/-!
# The quotient presheaf of a pre-relation (Stacks 044I)

Let `Z` be a presheaf on the big fppf site of a scheme `S` — in the situation of Stacks 044I the
presheaf of an algebraic space `B` — and let `j : R ⟶ U ×_Z U` be a pre-relation over `Z`.
Stacks 044I writes down the presheaf sending a test object `T` to the quotient `U(T)/∼_T`, where
`∼_T` is the equivalence relation generated by the pairs `(t(r), s(r))` for `r ∈ R(T)`. This file
constructs that presheaf and identifies its values.

## Main definitions

* `AlgebraicGeometry.Space.quotientPresheaf`: **Stacks 044I**, the quotient presheaf, built as the
  coequalizer of the target and source maps.

## Main results

* `AlgebraicGeometry.Space.quotientPresheaf_obj_equiv`: **Stacks 044I**, its value at a test
  object is the quotient of `U(T)` by the relation generated by the image of `R(T)`, compatibly
  with the canonical classes.

## Implementation notes

Taking the coequalizer in the category of set-valued presheaves is what supplies the restriction
maps: it is computed pointwise, so the chosen categorical construction has the displayed quotient
as its value at every test object, and its functoriality is the functoriality of the coequalizer.
This is why the construction is a coequalizer of presheaves rather than a pointwise quotient
assembled by hand.

The source displays the quotient by the equivalence relation *generated* by the image of `R(T)`,
which in general is coarser than that image. `quotientPresheaf_obj_equiv` is stated with `Quot` of
the one-step relation, which is the same type: `Quot` of a relation and `Quot` of the equivalence
relation it generates agree.

Everything is stated for an arbitrary base presheaf `Z` and arbitrary `R` and `U` over it, since
nothing in the construction uses that they are algebraic spaces.

## References

* [Stacks Project, Tag 043C](https://stacks.math.columbia.edu/tag/043C)
* [Stacks Project, Tag 044I](https://stacks.math.columbia.edu/tag/044I)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Space

universe u

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {Z : (BigFppfOver site S hS)ᵒᵖ ⥤ Type u} {R U : Over Z}

/-- **Stacks 044I.** The presheaf quotient of `U` by the equivalence relation generated by the
image of the pre-relation `j`, as the coequalizer of its target and source maps. -/
@[stacks 044I "the presheaf"]
noncomputable def quotientPresheaf (j : PreRelation R U) :
    (BigFppfOver site S hS)ᵒᵖ ⥤ Type u :=
  coequalizer j.target.left j.source.left

/-- **Stacks 044I.** At a test object `T`, the quotient presheaf is the quotient of `U(T)` by the
relation generated by the image of `R(T)`; the identification sends the canonical class of `x` to
the class of `x`. -/
@[stacks 044I "pointwise quotient"]
theorem quotientPresheaf_obj_equiv (j : PreRelation R U) (T : BigFppfOver site S hS) :
    ∃ e : (quotientPresheaf j).obj (Opposite.op T) ≃
        Quot (fun x y : U.left.obj (Opposite.op T) =>
          ∃ r : R.left.obj (Opposite.op T),
            j.target.left.app (Opposite.op T) r = x ∧
            j.source.left.app (Opposite.op T) r = y),
      ∀ x, e ((coequalizer.π j.target.left j.source.left).app (Opposite.op T) x) =
        Quot.mk _ x := by
  let E := (evaluation ((BigFppfOver site S hS)ᵒᵖ) (Type u)).obj (Opposite.op T)
  let f := E.map j.target.left
  let g := E.map j.source.left
  let Q : U.left.obj (Opposite.op T) → U.left.obj (Opposite.op T) → Prop :=
    fun x y => ∃ r : R.left.obj (Opposite.op T), f r = x ∧ g r = y
  let pointIso :=
    (PreservesCoequalizer.iso E j.target.left j.source.left).symm.trans
      (Types.coequalizerIso (E.map j.target.left) (E.map j.source.left))
  let qEquiv : Function.Coequalizer f g ≃ Quot Q :=
    { toFun := Quot.lift (Quot.mk Q) <| by
        rintro _ _ ⟨r⟩
        exact Quot.sound ⟨r, rfl, rfl⟩
      invFun := Quot.lift (Quot.mk (Function.Coequalizer.Rel f g)) <| by
        rintro _ _ ⟨r, rfl, rfl⟩
        exact Quot.sound (.intro r)
      left_inv := fun z => Quot.inductionOn z fun _ => rfl
      right_inv := fun z => Quot.inductionOn z fun _ => rfl }
  refine ⟨pointIso.toEquiv.trans qEquiv, fun x => ?_⟩
  show qEquiv (pointIso.hom
    (((coequalizer.π j.target.left j.source.left).app (Opposite.op T)) x)) = Quot.mk Q x
  rw [show pointIso.hom
      (((coequalizer.π j.target.left j.source.left).app (Opposite.op T)) x) =
      Function.Coequalizer.mk f g x from by
    show ((E.map (coequalizer.π j.target.left j.source.left)) ≫
      (PreservesCoequalizer.iso E j.target.left j.source.left).inv ≫
      (Types.coequalizerIso (E.map j.target.left) (E.map j.source.left)).hom).hom x =
        (↾(Function.Coequalizer.mk f g)).hom x
    rw [← Category.assoc, map_π_preserves_coequalizer_inv, Types.coequalizerIso_π_comp_hom]]
  rfl

end AlgebraicGeometry.Space

end
