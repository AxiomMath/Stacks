module

public import StacksFrontier.AlgebraicGeometry.CardinalGeneratedColimit.Basic
public import StacksFrontier.AlgebraicGeometry.GabberColimit.Keystone
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.CrystalSaturation

/-!
# The subsheaves cut out by a family of sections of a crystal

`StacksFrontier/AlgebraicGeometry/Spaces/Groupoids/CrystalSaturation.lean` produces, from any
`κ`-bounded family of sets of sections of a crystal on a system of schemes, a `κ`-bounded family
whose spans are compatible both under restriction inside each scheme and under the transitions
of the system.  This file turns the first of those two compatibilities into geometry: for each
index `i` of the system the spans cut out a quasi-coherent `κ`-generated subsheaf `G i ⊆ F i`,
by the machinery of Stacks 077N, and a section lying locally in the family is a section of it.

What is *not* done here is the second compatibility: that the subsheaves so obtained satisfy
`α φ ((f φ)^* (G i)) = G i'`, which is what makes the family `G` a submodule of the crystal in
the sense of Stacks 077Z.  That is `CrystalFamilyTransport.lean`; see the section "What is left
for Stacks 077Z" below.

## Main definitions

* `Stacks.AlgebraicGeometry.Crystals.Crystal.familySubmodule`: the spans of the family, as
  submodules of the sections over the affine opens.
* `Stacks.AlgebraicGeometry.Crystals.Crystal.familySubobject`: the subsheaf of `F i` they cut
  out, as a subobject.

## Main results

* `Stacks.AlgebraicGeometry.Crystals.Crystal.isCompatible_familySubmodule`: the restriction
  half of the compatibility is `Stacks.AlgebraicGeometry.GabberColimit.IsCompatible`.
* `Stacks.AlgebraicGeometry.Crystals.Crystal.isQuasicoherent_familySubobject` and
  `Stacks.AlgebraicGeometry.Crystals.Crystal.isCardinalGenerated_familySubobject`: the subsheaf
  is quasi-coherent and `κ`-generated, by the two corresponding results of Stacks 077N.
* `Stacks.AlgebraicGeometry.Crystals.Crystal.mem_range_familySubobject_arrow_app`: a section
  lying locally in the family is a section of the subsheaf.
* `Stacks.AlgebraicGeometry.Crystals.Crystal.exists_bounded_compatible_family_isLocallyIn`:
  every section of `F i` over an affine open lies locally in a doubly-compatible `κ`-bounded
  family.

## What is left for Stacks 077Z

With this file the exhaustion half of Stacks 077Z is reduced to a single statement: that for a
doubly-compatible family `T` the subsheaves cut out by it are matched by the comparison
isomorphisms, that is

```
M.transport φ (M.familySubobject T hc (D.j φ).1) = M.familySubobject T hc (D.j φ).2
```

for every `φ`, where `M.transport` is
`Stacks.AlgebraicGeometry.Crystals.Crystal.transport`.  That statement is
`Stacks.AlgebraicGeometry.Crystals.Crystal.transport_familySubobject`, in
`CrystalFamilyTransport.lean`.  With it the family of subsheaves is a
`Stacks.AlgebraicGeometry.Crystals.Subcrystal`, it is `κ`-generated by
`isCardinalGenerated_familySubobject`, it contains the prescribed section by
`mem_range_familySubobject_arrow_app`, and
`Stacks.AlgebraicGeometry.Crystals.isColimit_cardinalGeneratedSubcrystalCocone_of_exists_mem`
gives the tag.

## References

* [Stacks Project, Tag 077Z](https://stacks.math.columbia.edu/tag/077Z)
* [Stacks Project, Tag 077N](https://stacks.math.columbia.edu/tag/077N)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite AlgebraicGeometry
open Stacks.AlgebraicGeometry.CardinalGeneration

universe u

namespace Stacks.AlgebraicGeometry.Crystals.Crystal

variable {D : SchemeSystem.{u}} (M : Crystal D)

/-- **The spans of a family of sets of sections of a crystal**, as submodules of the sections of
`F i` over the affine opens of `X i`. -/
def familySubmodule (T : M.Family) (i : D.I) (W : (D.X i).affineOpens) :
    Submodule Γ(D.X i, W.1) Γ(M.F i, W.1) :=
  Submodule.span Γ(D.X i, W.1) (T ⟨i, W⟩)

/-- The restriction half of the compatibility of a family is exactly the compatibility condition
of Stacks 077N on each scheme of the system. -/
theorem isCompatible_familySubmodule (T : M.Family)
    (hT : ∀ (i : D.I) (U W : (D.X i).affineOpens) (h : W.1 ≤ U.1),
      Submodule.span Γ(D.X i, W.1) (T ⟨i, W⟩)
        = Submodule.span Γ(D.X i, W.1) ((M.F i).presheaf.map (homOfLE h).op '' T ⟨i, U⟩))
    (i : D.I) : GabberColimit.IsCompatible (M.F i) (M.familySubmodule T i) :=
  GabberColimit.isCompatible_span (M.F i) (fun W => T ⟨i, W⟩) fun U W h => hT i U W h

variable (T : M.Family)
  (hc : ∀ i : D.I, GabberColimit.IsCompatible (M.F i) (M.familySubmodule T i))

/-- The subsheaf of `F i` cut out by the spans of the family. -/
def familySubmoduleSheaf (i : D.I) : (M.F i).Submodule :=
  haveI : (M.F i).IsQuasicoherent := M.isQuasicoherent i
  GabberColimit.sheafSubmodule (M.F i) (M.familySubmodule T i) (hc i)

/-- The inclusion into `F i` of the subsheaf cut out by the spans of the family. -/
def familySubmoduleHom (i : D.I) :
    GabberColimit.submoduleObj (M.F i) (M.familySubmoduleSheaf T hc i) ⟶ M.F i :=
  GabberColimit.submoduleHom (M.F i) (M.familySubmoduleSheaf T hc i)

/-- The inclusion of the subsheaf cut out by the family is a monomorphism. -/
instance mono_familySubmoduleHom (i : D.I) : Mono (M.familySubmoduleHom T hc i) :=
  GabberColimit.mono_submoduleHom (M.F i) (M.familySubmoduleSheaf T hc i)

/-- **The subsheaf of `F i` cut out by the spans of the family**, as a subobject. -/
def familySubobject (i : D.I) : Subobject (M.F i) :=
  Subobject.mk (M.familySubmoduleHom T hc i)

/-- The subobject cut out by the family is isomorphic to the subsheaf it comes from. -/
def familySubobjectIso (i : D.I) :
    GabberColimit.submoduleObj (M.F i) (M.familySubmoduleSheaf T hc i)
      ≅ ((M.familySubobject T hc i : (D.X i).Modules)) :=
  (Subobject.underlyingIso (M.familySubmoduleHom T hc i)).symm

/-- **The subsheaf cut out by the family is quasi-coherent**, by the corresponding result of
Stacks 077N. -/
theorem isQuasicoherent_familySubobject (i : D.I) :
    ((M.familySubobject T hc i : (D.X i).Modules)).IsQuasicoherent :=
  have : (M.F i).IsQuasicoherent := M.isQuasicoherent i
  (SheafOfModules.isQuasicoherent (D.X i).ringCatSheaf).prop_of_iso
    (M.familySubobjectIso T hc i)
    (GabberColimit.isQuasicoherent_sheafSubmodule (M.F i) (M.familySubmodule T i) (hc i))

/-- **The subsheaf cut out by a `κ`-bounded family is `κ`-generated**, by the corresponding
result of Stacks 077N. -/
theorem isCardinalGenerated_familySubobject {κ : Cardinal.{u}}
    (hTb : ∀ p : D.AffineIdx, Cardinal.mk (T p) ≤ κ) (i : D.I) :
    IsCardinalGenerated (R := (D.X i).ringCatSheaf)
      ((M.familySubobject T hc i : (D.X i).Modules)) κ :=
  have : (M.F i).IsQuasicoherent := M.isQuasicoherent i
  isCardinalGenerated_of_iso κ (M.familySubobjectIso T hc i)
    (isCardinalGenerated_sheafSubmodule (M.F i) κ (fun W => T ⟨i, W⟩)
      (fun W => hTb ⟨i, W⟩) (hc i))

/-- A section of `F i` lying locally in the family, read as a section of the subsheaf the
family cuts out.  It is named so that its type is the one written here; the subsheaf is reached
through `GabberColimit.submoduleObj` on one side and `GabberColimit.compatibleModule` on the
other, and the two spellings are equal only after unfolding. -/
def familyMkSection (i : D.I) {U : (D.X i).Opens} (s : Γ(M.F i, U))
    (hs : GabberColimit.IsLocallyIn (M.F i) (M.familySubmodule T i) s) :
    Γ(GabberColimit.submoduleObj (M.F i) (M.familySubmoduleSheaf T hc i), U) :=
  haveI : (M.F i).IsQuasicoherent := M.isQuasicoherent i
  GabberColimit.mkSection (M.F i) (M.familySubmodule T i) (hc i) s hs

/-- The inclusion of the subsheaf sends a section read through `familyMkSection` back to
itself. -/
theorem familySubmoduleHom_app_familyMkSection (i : D.I) (U : (D.X i).Opens) (s : Γ(M.F i, U))
    (hs : GabberColimit.IsLocallyIn (M.F i) (M.familySubmodule T i) s) :
    (M.familySubmoduleHom T hc i).app U (M.familyMkSection T hc i s hs) = s := rfl

/-- **A section lying locally in the family is a section of the subsheaf it cuts out.** -/
theorem mem_range_familySubobject_arrow_app (i : D.I) (U : (D.X i).Opens) (s : Γ(M.F i, U))
    (hs : GabberColimit.IsLocallyIn (M.F i) (M.familySubmodule T i) s) :
    s ∈ Set.range ((M.familySubobject T hc i).arrow.app U) := by
  refine ⟨(Subobject.underlyingIso (M.familySubmoduleHom T hc i)).inv.app U
    (M.familyMkSection T hc i s hs), ?_⟩
  show (Subobject.mk (M.familySubmoduleHom T hc i)).arrow.app U
      ((Subobject.underlyingIso (M.familySubmoduleHom T hc i)).inv.app U
        (M.familyMkSection T hc i s hs)) = s
  rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app,
    Subobject.underlyingIso_arrow]
  exact M.familySubmoduleHom_app_familyMkSection T hc i U s hs

/-- **Every section over an affine open lies locally in a bounded doubly-compatible family.**
The family is the closure of the one-element family consisting of the given section, which is
`κ`-bounded for free. -/
theorem exists_bounded_compatible_family_isLocallyIn {κ : Cardinal.{u}}
    (hκ : Cardinal.aleph0 ≤ κ) (hΦ : Cardinal.mk D.Φ ≤ κ)
    (hX : ∀ i : D.I, Cardinal.mk (D.X i).affineOpens ≤ κ) (i₀ : D.I)
    (U₀ : (D.X i₀).affineOpens) (s : Γ(M.F i₀, U₀.1)) :
    ∃ T : M.Family, (∀ p, Cardinal.mk (T p) ≤ κ) ∧
      (∀ (i : D.I) (U W : (D.X i).affineOpens) (h : W.1 ≤ U.1),
        Submodule.span Γ(D.X i, W.1) (T ⟨i, W⟩)
          = Submodule.span Γ(D.X i, W.1)
            ((M.F i).presheaf.map (homOfLE h).op '' T ⟨i, U⟩)) ∧
      (∀ (φ : D.Φ) (U : (D.X (D.j φ).1).affineOpens) (V : (D.X (D.j φ).2).affineOpens)
        (h : V.1 ≤ (D.f φ) ⁻¹ᵁ U.1),
        Submodule.span Γ(D.X (D.j φ).2, V.1) (T ⟨(D.j φ).2, V⟩)
          = Submodule.span Γ(D.X (D.j φ).2, V.1)
            ((fun a => M.transitionSection φ U.1 V.1 h a) '' T ⟨(D.j φ).1, U⟩)) ∧
      GabberColimit.IsLocallyIn (M.F i₀) (M.familySubmodule T i₀) s := by
  obtain ⟨T, hST, hTb, hTres, hTtrans⟩ :=
    M.exists_bounded_compatible_family hκ hΦ hX
      (fun p => M.castPart p ⟨i₀, U₀⟩ {s})
      (fun p => M.mk_castPart_le p ⟨i₀, U₀⟩ {s}
        (by simpa using Cardinal.one_le_aleph0.trans hκ))
  have hs : s ∈ T ⟨i₀, U₀⟩ := hST ⟨i₀, U₀⟩ ⟨rfl, Set.mem_singleton s⟩
  refine ⟨T, hTb, hTres, hTtrans, fun W h => ?_⟩
  rw [familySubmodule, hTres i₀ U₀ W h]
  exact Submodule.subset_span ⟨s, hs, rfl⟩

end Stacks.AlgebraicGeometry.Crystals.Crystal

end
