/-!
# The category of torsors with an equivariant map to a fixed action

Fix a scheme `S` of a big fppf site, an algebraic space `B` over `S`, a group algebraic space
`G` over `B` and an algebraic space `X` over `B` on which `G` acts.  The category `[[X/G]]` of
Situation 04WL has as objects the quadruples `(U, b, P, φ)` with `U` an object of the big fppf
site of `S`, `b : U ⟶ B` a morphism, `P` an fppf torsor over `U` under `G_U = U ×_{b, B} G`,
and `φ : P ⟶ X` a `G`-equivariant morphism lying over `b`; a morphism `(U, b, P, φ) ⟶
(U', b', P', φ')` is a pair `(f, g)` with `f : U ⟶ U'` over `B` and `g : P ⟶ P'` an
equivariant morphism over `f` identifying `P` with `U ×_{f, U'} P'` and satisfying
`φ = φ' ∘ g`.

The projection `[[X/G]] ⟶ (Sch/S)_fppf` is fibred in groupoids as soon as the projection from
the category of fppf `G`-torsors is, and it is a stack in groupoids for the fppf topology
(Stacks 0370).

## Main definitions

* `AlgebraicGeometry.Space.TorsorObj` is a triple `(U, b, P)`, an object of the category of
  fppf `G`-torsors, with `AlgebraicGeometry.Space.TorsorObj.Hom` its morphisms and
  `AlgebraicGeometry.Space.torsorProjection` its projection to the big fppf site.
* `AlgebraicGeometry.Space.TorsorWithMap` is a quadruple `(U, b, P, φ)`, an object of
  `[[X/G]]`, with `AlgebraicGeometry.Space.TorsorWithMap.Hom` its morphisms,
  `AlgebraicGeometry.Space.TorsorWithMap.forget` the functor forgetting `φ` and
  `AlgebraicGeometry.Space.TorsorWithMap.projection` the projection to the big fppf site.
* `AlgebraicGeometry.Space.actionComparison` is the morphism `G_U ×_U P ⟶ G ×_B X`,
  `(γ, p) ↦ (γ, φ p)`, and `AlgebraicGeometry.Space.actionBaseChange` is the morphism
  `G_U ×_U P ⟶ G_{U'} ×_{U'} P'`, `(γ, p) ↦ (γ, g p)`.
* `AlgebraicGeometry.Space.familyImage` is the subfunctor of a presheaf generated by the images
  of a family of morphisms into it.
* `AlgebraicGeometry.Space.TorsorObj.toTorsorWithMap` and
  `AlgebraicGeometry.Space.torsorObjToTorsorWithMap`: for the trivial action of `G` on the base,
  an fppf `G`-torsor as an object of `[[B/G]]` and the functor `G-Torsors ⥤ [[B/G]]` it defines.

## Main results

* `AlgebraicGeometry.Space.TorsorWithMap.projection_isFiberedInGroupoids`: the projection of
  `[[X/G]]` is fibred in groupoids whenever the projection from the category of fppf
  `G`-torsors is.
* `AlgebraicGeometry.Space.TorsorWithMap.projection_isStackInGroupoids`: the projection of
  `[[X/G]]` is a stack in groupoids whenever the projection from the category of fppf
  `G`-torsors is fibred in groupoids and a stack.
* `AlgebraicGeometry.Space.TorsorWithMap.projection_isStackInGroupoids_unconditional`: the
  projection of `[[X/G]]` is a stack in groupoids for the fppf topology, Stacks 0370.
* `AlgebraicGeometry.Space.glueHom` and
  `AlgebraicGeometry.Space.hom_ext_of_familyImage_cover`: a morphism from a presheaf into a
  sheaf is glued from, and determined by, its restrictions along a family of morphisms whose
  images cover it locally; `AlgebraicGeometry.Space.familyImage_cover` is the covering
  criterion for a family of cartesian squares over a covering family of the base.
* `AlgebraicGeometry.Space.torsorWithMapEquivTorsorObj` is the equivalence
  `[[B/G]] ≌ G-Torsors` of Stacks 0CQJ, for the trivial action of `G` on the base.

## References

* [Stacks Project, Tag 0370](https://stacks.math.columbia.edu/tag/0370)
* [Stacks Project, Situation 04WL](https://stacks.math.columbia.edu/tag/04WL)
* [Stacks Project, Tag 04US](https://stacks.math.columbia.edu/tag/04US)
* [Stacks Project, Tag 0CKJ](https://stacks.math.columbia.edu/tag/0CKJ)
* [Stacks Project, Tag 0CQJ](https://stacks.math.columbia.edu/tag/0CQJ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped MonoidalCategory MonObj

universe u w

namespace AlgebraicGeometry.Space

/-! ### Glueing morphisms out of a presheaf covered by a family -/

section GlueMaps

universe v₁ u₁ t

variable {C : Type u₁} [Category.{v₁} C] {I : Type t}

section Glue

variable {P Q : Cᵒᵖ ⥤ Type w} {Pi : I → Cᵒᵖ ⥤ Type w}

/-- The subfunctor of `P` whose sections over `Z` are those lying in the image of one of a
family of morphisms `Pi i ⟶ P`. -/
def familyImage (p : ∀ i, Pi i ⟶ P) : Subfunctor P where
  obj Z := {x | ∃ i, ∃ y, (p i).app Z y = x}
  map := by
    rintro Z W f x ⟨i, y, rfl⟩
    exact ⟨i, (Pi i).map f y, (p i).naturality_apply f y⟩

/-- A family of morphisms `p i : Pi i ⟶ P` whose images cover `P` locally for `J` glues
morphisms into a sheaf: a compatible family of morphisms `φ i : Pi i ⟶ Q` comes from a unique
morphism `P ⟶ Q`.  Compatibility is agreement on sections with the same image in `P`. -/
theorem glueHom (J : GrothendieckTopology C)
    (p : ∀ i, Pi i ⟶ P)
    (hcover : ∀ Z (x : P.obj (Opposite.op Z)),
      (familyImage p).sieveOfSection x ∈ J Z)
    (hQ : Presheaf.IsSheaf J Q) (φ : ∀ i, Pi i ⟶ Q)
    (hφ : ∀ Z i j (x : (Pi i).obj Z) (y : (Pi j).obj Z),
      (p i).app Z x = (p j).app Z y → (φ i).app Z x = (φ j).app Z y) :
    ∃! ψ : P ⟶ Q, ∀ i, p i ≫ ψ = φ i := by
  classical
  let R := familyImage p
  let val (Z : Cᵒᵖ) (x : R.toFunctor.obj Z) : Q.obj Z :=
    (φ x.property.choose).app Z x.property.choose_spec.choose
  have val_eq (Z : Cᵒᵖ) (x : R.toFunctor.obj Z) (i : I) (y : (Pi i).obj Z)
      (hy : (p i).app Z y = x.val) : val Z x = (φ i).app Z y :=
    hφ Z _ i _ y (x.property.choose_spec.choose_spec.trans hy.symm)
  let a : R.toFunctor ⟶ Q :=
    { app Z := ↾(val Z)
      naturality Z W f := by
        ext x
        obtain ⟨i, y, hy⟩ := x.property
        show val W (R.toFunctor.map f x) = Q.map f (val Z x)
        rw [val_eq Z x i y hy]
        rw [val_eq W (R.toFunctor.map f x) i ((Pi i).map f y)
          (by
            show (p i).app W ((Pi i).map f y) = P.map f x.val
            rw [← hy]
            exact (p i).naturality_apply f y)]
        exact (φ i).naturality_apply f y }
  let b : P ⟶ (R.sheafify J).toFunctor :=
    { app Z := ↾fun x => ⟨x, hcover Z.unop x⟩
      naturality Z W f := by ext x; rfl }
  have hb : b ≫ (R.sheafify J).ι = 𝟙 P := rfl
  have hQ' := (isSheaf_iff_isSheaf_of_type J Q).1 hQ
  let ψ := b ≫ R.sheafifyLift a hQ'
  have hψ (Z : Cᵒᵖ) (x : R.toFunctor.obj Z) : ψ.app Z x.val = val Z x :=
    ConcreteCategory.congr_hom
      (NatTrans.congr_app (R.to_sheafifyLift a hQ') Z) x
  refine ⟨ψ, ?_, ?_⟩
  · intro i
    ext Z x
    exact (hψ Z ⟨(p i).app Z x, i, x, rfl⟩).trans
      (val_eq Z ⟨(p i).app Z x, i, x, rfl⟩ i x rfl)
  · intro ψ' hψ'
    have hrest : R.ι ≫ ψ' = R.ι ≫ ψ := by
      ext Z x
      obtain ⟨i, y, hy⟩ := x.property
      show ψ'.app Z x.val = ψ.app Z x.val
      rw [hψ Z x, val_eq Z x i y hy, ← hy]
      exact ConcreteCategory.congr_hom (NatTrans.congr_app (hψ' i) Z) y
    have he : (R.sheafify J).ι ≫ ψ' = (R.sheafify J).ι ≫ ψ :=
      R.to_sheafify_lift_unique hQ' _ _ hrest
    simpa only [← Category.assoc, hb, Category.id_comp] using congrArg (b ≫ ·) he

/-- Two morphisms from `P` into a sheaf agreeing on a family whose images cover `P` locally
for `J` are equal. -/
theorem hom_ext_of_familyImage_cover (J : GrothendieckTopology C)
    (p : ∀ i, Pi i ⟶ P)
    (hcover : ∀ Z (x : P.obj (Opposite.op Z)),
      (familyImage p).sieveOfSection x ∈ J Z)
    (hQ : Presheaf.IsSheaf J Q) (ψ ψ' : P ⟶ Q)
    (hψ : ∀ i, p i ≫ ψ = p i ≫ ψ') : ψ = ψ' := by
  have hh := glueHom J p hcover hQ (fun i => p i ≫ ψ) (by
    intro Z i j x y h
    exact congrArg (ψ.app Z) h)
  exact hh.unique (fun _ => rfl) (fun i => (hψ i).symm)

end Glue

variable {P : Cᵒᵖ ⥤ Type v₁} {Pi : I → Cᵒᵖ ⥤ Type v₁}

/-- A family of cartesian squares over a covering family of the base covers the total
presheaf: every section of `P` lies locally in the image of one of the `p i`. -/
theorem familyImage_cover (J : GrothendieckTopology C) {U : C}
    {V : I → C} (f : ∀ i, V i ⟶ U) (hf : Sieve.ofArrows V f ∈ J U)
    (a : P ⟶ yoneda.obj U) (p : ∀ i, Pi i ⟶ P)
    (ai : ∀ i, Pi i ⟶ yoneda.obj (V i))
    (hp : ∀ i, IsPullback (p i) (ai i) a (yoneda.map (f i)))
    (Z : C) (x : P.obj (Opposite.op Z)) :
    (familyImage p).sieveOfSection x ∈ J Z := by
  apply J.superset_covering _ (J.pullback_stable (a.app (Opposite.op Z) x) hf)
  intro W g hg
  obtain ⟨Y, k, l, hl, hkl⟩ := hg
  obtain ⟨i⟩ := hl
  have hpb := (hp i).map ((evaluation Cᵒᵖ (Type v₁)).obj (Opposite.op W))
  obtain ⟨y, hy, -⟩ := Types.exists_of_isPullback hpb (P.map g.op x) k (by
    show a.app (Opposite.op W) (P.map g.op x) = k ≫ f i
    rw [(a.naturality_apply g.op x)]
    exact hkl.symm)
  exact ⟨i, y, hy⟩

/-- A family of arrows into `U` generates a covering sieve as soon as `U` is identified with the
base `V` of some covering sieve `R` in such a way that every arrow of `R` factors through a
member of the family. -/
theorem ofArrows_mem_of_sieve_mem (J : GrothendieckTopology C) {U V : C} (hU : U = V)
    {R : Sieve V} (hR : R ∈ J V) (W : I → C) (a : ∀ i, W i ⟶ U)
    (hsurj : ∀ {Z : C} (k : Z ⟶ U), R.arrows (k ≫ eqToHom hU) →
      ∃ (i : I) (e : Z ⟶ W i), e ≫ a i = k) :
    Sieve.ofArrows W a ∈ J U := by
  refine J.superset_covering ?_ (J.pullback_stable (eqToHom hU) hR)
  intro Z k hk
  obtain ⟨i, e, he⟩ := hsurj k hk
  exact he ▸ Sieve.downward_closed _ (Sieve.ofArrows_mk W a i) e

/-- The family of arrows `a i : Wi i ⟶ U`, indexed by the arrows `g` of a covering sieve `R` of
`V = U` and equal to `g` up to identifications of the objects, generates a covering sieve. -/
private theorem ofArrows_mem_of_eqToHom_comp (J : GrothendieckTopology C) {U V : C} (hU : U = V)
    {R : Sieve V} (hR : R ∈ J V) (Wi : (W : C) × {g : W ⟶ V // R.arrows g} → C)
    (hd : ∀ i, Wi i = i.1) (a : ∀ i, Wi i ⟶ U)
    (ha : ∀ i, a i = eqToHom (hd i) ≫ i.2.1 ≫ eqToHom hU.symm) :
    Sieve.ofArrows Wi a ∈ J U := by
  refine ofArrows_mem_of_sieve_mem J hU hR _ _ fun {Z} k hk => ?_
  let i : (W : C) × {g : W ⟶ V // R.arrows g} := ⟨Z, k ≫ eqToHom hU, hk⟩
  exact ⟨i, eqToHom (hd i).symm, by rw [ha]; simp [i]⟩

end GlueMaps

/-! ### The category of fppf torsors under a group algebraic space -/

section Torsors

local instance (priority := high) hasPullbacks_presheaf_torsorsWithEquivariantMap
    {𝒞 : BigFppfSite.{u}} {S : Scheme.{u}} {hS : 𝒞.Contains S} :
    HasPullbacks ((BigFppfOver 𝒞 S hS)ᵒᵖ ⥤ Type u) :=
  Limits.functorCategoryHasLimitsOfShape

local instance (priority := high) hasPullback_presheaf_torsorsWithEquivariantMap
    {𝒞 : BigFppfSite.{u}} {S : Scheme.{u}} {hS : 𝒞.Contains S}
    {X Y Z : (BigFppfOver 𝒞 S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  hasPullbacks_presheaf_torsorsWithEquivariantMap.has_limit _

variable {𝒞 : BigFppfSite.{u}} {S : Scheme.{u}} {hS : 𝒞.Contains S}
  {B : (BigFppfOver 𝒞 S hS)ᵒᵖ ⥤ Type u} (hB : IsAlgebraicSpace 𝒞 S hS B)
  (G : GroupAlgebraicSpace 𝒞 S hS B hB)

/-- The base change `G_U = U ×_{b, B} G` of `G` along a morphism `b : U ⟶ B`, as a group
algebraic space over `U`. -/
def pullbackGroup (U : BigFppfOver 𝒞 S hS) (b : yoneda.obj U ⟶ B) :
    GroupAlgebraicSpace 𝒞 S hS (yoneda.obj U) (isAlgebraicSpace_yoneda 𝒞 S hS U) :=
  GroupAlgebraicSpace.baseChange 𝒞 S hS (isAlgebraicSpace_yoneda 𝒞 S hS U) b G

/-- An object of the category of fppf `G`-torsors: an object `U` of the big fppf site of `S`, a
morphism `b : U ⟶ B`, and an fppf torsor `P` over `U` under `G_U = U ×_{b, B} G`. -/
structure TorsorObj where
  /-- The base, an object of the big fppf site of `S`. -/
  U : BigFppfOver 𝒞 S hS
  /-- The morphism `b : U ⟶ B`. -/
  b : yoneda.obj U ⟶ B
  /-- The total space, as an object over `U`. -/
  total : Over (yoneda.obj U)
  /-- The total space is an algebraic space. -/
  isAlgebraicSpace : IsAlgebraicSpace 𝒞 S hS total.left
  /-- The action of `G_U` on the total space. -/
  action : ModObj (pullbackGroup hB G U b).obj.X total
  /-- The total space is an fppf torsor under `G_U` over `U`, in the sense of Stacks 04TY. -/
  isFppfTorsor :
    @IsFppfTorsor 𝒞 S hS (yoneda.obj U) (isAlgebraicSpace_yoneda 𝒞 S hS U)
      (pullbackGroup hB G U b).obj.X total _ action
      (pullbackGroup hB G U b).property isAlgebraicSpace

variable {hB G}

namespace TorsorObj

/-- The group algebraic space `G_U = U ×_{b, B} G` acting on a torsor. -/
abbrev group (T : TorsorObj hB G) : Over (yoneda.obj T.U) :=
  (pullbackGroup hB G T.U T.b).obj.X

/-- The action of `G_U` on the total space of a torsor. -/
instance instModObj (T : TorsorObj hB G) : ModObj T.group T.total := T.action

/-- The underlying presheaf of `G_U` is the fibre product of `G` and `U` over `B`. -/
theorem group_left (T : TorsorObj hB G) :
    T.group.left = pullback G.obj.X.hom T.b := rfl

/-- The structure morphism of `G_U` is the projection to `U`. -/
theorem group_hom (T : TorsorObj hB G) :
    T.group.hom = pullback.snd G.obj.X.hom T.b := rfl

end TorsorObj

/-- The canonical morphism `G_U ⟶ G_{U'}` induced by a morphism `f : U ⟶ U'` over `B`. -/
def groupBaseChange {T T' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) :
    pullback G.obj.X.hom T.b ⟶ pullback G.obj.X.hom T'.b :=
  pullback.map _ _ _ _ (𝟙 G.obj.X.left) (yoneda.map f) (𝟙 B) (by simp) (by simp [hf])

/-- The base change morphism `G_U ⟶ G_{U'}` commutes with the projections to `G`. -/
@[reassoc (attr := simp)]
theorem groupBaseChange_fst {T T' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) :
    groupBaseChange f hf ≫ pullback.fst G.obj.X.hom T'.b =
      pullback.fst G.obj.X.hom T.b :=
  (pullback.lift_fst _ _ _).trans (Category.comp_id _)

/-- The base change morphism `G_U ⟶ G_{U'}` lies over `f : U ⟶ U'`. -/
@[reassoc (attr := simp)]
theorem groupBaseChange_snd {T T' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) :
    groupBaseChange f hf ≫ pullback.snd G.obj.X.hom T'.b =
      pullback.snd G.obj.X.hom T.b ≫ yoneda.map f :=
  pullback.lift_snd _ _ _

/-- The canonical morphism `G_U ×_U P ⟶ G_{U'} ×_{U'} P'`, `(γ, p) ↦ (γ, g p)`, induced by a
morphism `f : U ⟶ U'` over `B` and a morphism `g : P ⟶ P'` over `f`. -/
def actionBaseChange {T T' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) (g : T.total.left ⟶ T'.total.left)
    (hg : T.total.hom ≫ yoneda.map f = g ≫ T'.total.hom) :
    pullback (pullback.snd G.obj.X.hom T.b) T.total.hom ⟶
      pullback (pullback.snd G.obj.X.hom T'.b) T'.total.hom :=
  pullback.map _ _ _ _ (groupBaseChange f hf) g (yoneda.map f)
    (groupBaseChange_snd f hf).symm hg

/-- On the first factor, the base change morphism `G_U ×_U P ⟶ G_{U'} ×_{U'} P'` is the base
change morphism `G_U ⟶ G_{U'}`. -/
@[reassoc (attr := simp)]
theorem actionBaseChange_fst {T T' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) (g : T.total.left ⟶ T'.total.left)
    (hg : T.total.hom ≫ yoneda.map f = g ≫ T'.total.hom) :
    actionBaseChange f hf g hg ≫
        pullback.fst (pullback.snd G.obj.X.hom T'.b) T'.total.hom =
      pullback.fst (pullback.snd G.obj.X.hom T.b) T.total.hom ≫ groupBaseChange f hf :=
  pullback.lift_fst _ _ _

/-- On the second factor, the base change morphism `G_U ×_U P ⟶ G_{U'} ×_{U'} P'` is
`g : P ⟶ P'`. -/
@[reassoc (attr := simp)]
theorem actionBaseChange_snd {T T' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) (g : T.total.left ⟶ T'.total.left)
    (hg : T.total.hom ≫ yoneda.map f = g ≫ T'.total.hom) :
    actionBaseChange f hf g hg ≫
        pullback.snd (pullback.snd G.obj.X.hom T'.b) T'.total.hom =
      pullback.snd (pullback.snd G.obj.X.hom T.b) T.total.hom ≫ g :=
  pullback.lift_snd _ _ _

/-- The base change morphism `G_U ⟶ G_U` induced by the identity is the identity. -/
@[simp]
theorem groupBaseChange_id (T : TorsorObj hB G)
    (hf : yoneda.map (𝟙 T.U) ≫ T.b = T.b) :
    groupBaseChange (𝟙 T.U) hf = 𝟙 (pullback G.obj.X.hom T.b) := by
  apply pullback.hom_ext <;> simp

/-- The base change morphism `G_U ×_U P ⟶ G_U ×_U P` induced by identities is the identity. -/
@[simp]
theorem actionBaseChange_id (T : TorsorObj hB G)
    (hf : yoneda.map (𝟙 T.U) ≫ T.b = T.b)
    (hg : T.total.hom ≫ yoneda.map (𝟙 T.U) = 𝟙 T.total.left ≫ T.total.hom) :
    actionBaseChange (𝟙 T.U) hf (𝟙 T.total.left) hg = 𝟙 _ := by
  apply pullback.hom_ext <;> simp

/-- Base change morphisms `G_U ⟶ G_{U'}` compose. -/
theorem groupBaseChange_comp {T T' T'' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) (f' : T'.U ⟶ T''.U)
    (hf' : yoneda.map f' ≫ T''.b = T'.b) :
    groupBaseChange f hf ≫ groupBaseChange f' hf' =
      groupBaseChange (f ≫ f') (by rw [Functor.map_comp, Category.assoc, hf', hf]) := by
  apply pullback.hom_ext <;> simp

/-- Base change morphisms `G_U ×_U P ⟶ G_{U'} ×_{U'} P'` compose. -/
theorem actionBaseChange_comp {T T' T'' : TorsorObj hB G} (f : T.U ⟶ T'.U)
    (hf : yoneda.map f ≫ T'.b = T.b) (g : T.total.left ⟶ T'.total.left)
    (hg : T.total.hom ≫ yoneda.map f = g ≫ T'.total.hom) (f' : T'.U ⟶ T''.U)
    (hf' : yoneda.map f' ≫ T''.b = T'.b) (g' : T'.total.left ⟶ T''.total.left)
    (hg' : T'.total.hom ≫ yoneda.map f' = g' ≫ T''.total.hom) :
    actionBaseChange f hf g hg ≫ actionBaseChange f' hf' g' hg' =
      actionBaseChange (f ≫ f') (by rw [Functor.map_comp, Category.assoc, hf', hf])
        (g ≫ g')
        (by rw [Functor.map_comp, ← Category.assoc, hg, Category.assoc, hg',
          Category.assoc]) := by
  apply pullback.hom_ext <;> simp [groupBaseChange_comp f hf f' hf']

/-- A morphism `(U, b, P) ⟶ (U', b', P')` of fppf `G`-torsors: a morphism `f : U ⟶ U'` over
`B` together with an equivariant identification of `P` with `U ×_{f, U'} P'`. -/
structure TorsorObj.Hom (T T' : TorsorObj hB G) where
  /-- The morphism of base objects. -/
  f : T.U ⟶ T'.U
  /-- The morphism `f` is a morphism over `B`. -/
  comp_b : yoneda.map f ≫ T'.b = T.b
  /-- The morphism of total spaces. -/
  g : T.total.left ⟶ T'.total.left
  /-- The morphism `g` identifies `P` with the fibre product `U ×_{f, U'} P'`. -/
  isPullback : IsPullback g T.total.hom T'.total.hom (yoneda.map f)
  /-- The morphism `g` is equivariant for the base change `G_U ⟶ G_{U'}`. -/
  smul_comp : (γ[T.group, T.total]).left ≫ g =
    actionBaseChange f comp_b g isPullback.w.symm ≫ (γ[T'.group, T'.total]).left

/-- Two morphisms of fppf `G`-torsors are equal if their morphisms of base objects and of total
spaces are. -/
@[ext] theorem TorsorObj.Hom.ext {T T' : TorsorObj hB G} {φ ψ : TorsorObj.Hom T T'}
    (hf : φ.f = ψ.f) (hg : φ.g = ψ.g) : φ = ψ := by
  cases φ; cases ψ; cases hf; cases hg; rfl

/-- The composition and identities of the category of fppf `G`-torsors. -/
@[instance_reducible]
def torsorCategoryStruct : CategoryStruct (TorsorObj hB G) where
  Hom := TorsorObj.Hom
  id T :=
    { f := 𝟙 T.U
      comp_b := by simp
      g := 𝟙 T.total.left
      isPullback := by simpa using IsPullback.id_horiz T.total.hom
      smul_comp := by
        rw [actionBaseChange_id]
        exact (Category.comp_id _).trans (Category.id_comp _).symm }
  comp {T₁ T₂ T₃} φ ψ :=
    { f := φ.f ≫ ψ.f
      comp_b := by rw [Functor.map_comp, Category.assoc, ψ.comp_b, φ.comp_b]
      g := φ.g ≫ ψ.g
      isPullback := by simpa using φ.isPullback.paste_horiz ψ.isPullback
      smul_comp := by
        refine Eq.trans ?_ (congrArg (· ≫ (γ[T₃.group, T₃.total]).left)
          (actionBaseChange_comp φ.f φ.comp_b φ.g φ.isPullback.w.symm ψ.f ψ.comp_b
            ψ.g ψ.isPullback.w.symm))
        refine (Category.assoc _ _ _).symm.trans ?_
        refine (congrArg (· ≫ ψ.g) φ.smul_comp).trans ?_
        refine (Category.assoc _ _ _).trans ?_
        refine (congrArg (actionBaseChange φ.f φ.comp_b φ.g φ.isPullback.w.symm ≫ ·)
          ψ.smul_comp).trans ?_
        exact (Category.assoc _ _ _).symm }

/-- The category of fppf `G`-torsors. -/
instance torsorCategory : Category (TorsorObj hB G) where
  toCategoryStruct := torsorCategoryStruct
  id_comp φ := TorsorObj.Hom.ext (Category.id_comp φ.f) (Category.id_comp φ.g)
  comp_id φ := TorsorObj.Hom.ext (Category.comp_id φ.f) (Category.comp_id φ.g)
  assoc φ ψ χ := TorsorObj.Hom.ext (Category.assoc φ.f ψ.f χ.f) (Category.assoc φ.g ψ.g χ.g)

variable (hB G)

/-- The projection from the category of fppf `G`-torsors to the big fppf site of `S`, sending
`(U, b, P)` to `U`. -/
def torsorProjection : TorsorObj hB G ⥤ BigFppfOver 𝒞 S hS where
  obj T := T.U
  map φ := φ.f
  map_id _ := rfl
  map_comp _ _ := rfl

variable {hB G}

/-- The restrictions of an fppf `G`-torsor along a covering family of its base jointly cover its
total space: every section of the total space lies locally in the image of one of them. -/
theorem torsorRestrictions_cover {I : Type*} (T : TorsorObj hB G) (Ti : I → TorsorObj hB G)
    (mi : ∀ i, Ti i ⟶ T)
    (hf : Sieve.ofArrows (fun i => (Ti i).U) (fun i => (mi i).f) ∈
      BigFppfOver.topology 𝒞 S hS T.U)
    (Z : BigFppfOver 𝒞 S hS) (x : T.total.left.obj (Opposite.op Z)) :
    (familyImage (fun i => (mi i).g)).sieveOfSection x ∈ BigFppfOver.topology 𝒞 S hS Z :=
  familyImage_cover _ (fun i => (mi i).f) hf T.total.hom (fun i => (mi i).g)
    (fun i => (Ti i).total.hom) (fun i => (mi i).isPullback) Z x

/-! ### Torsors with an equivariant map -/

section EquivariantMap

variable (X : Over B)

/-- The comparison morphism `G_U ×_U P ⟶ G ×_B X`, `(γ, p) ↦ (γ, φ p)`, attached to a morphism
`φ : P ⟶ X` lying over `b`. -/
def actionComparison (T : TorsorObj hB G) (φ : T.total.left ⟶ X.left)
    (hφ : φ ≫ X.hom = T.total.hom ≫ T.b) :
    pullback (pullback.snd G.obj.X.hom T.b) T.total.hom ⟶ pullback G.obj.X.hom X.hom :=
  pullback.lift
    (pullback.fst (pullback.snd G.obj.X.hom T.b) T.total.hom ≫
      pullback.fst G.obj.X.hom T.b)
    (pullback.snd (pullback.snd G.obj.X.hom T.b) T.total.hom ≫ φ)
    (by
      rw [Category.assoc, Category.assoc, hφ, pullback.condition (f := G.obj.X.hom)
        (g := T.b), ← Category.assoc, pullback.condition
        (f := pullback.snd G.obj.X.hom T.b) (g := T.total.hom), Category.assoc])

/-- On the first factor, the comparison morphism `G_U ×_U P ⟶ G ×_B X` is the projection to `G`. -/
@[reassoc (attr := simp)]
theorem actionComparison_fst (T : TorsorObj hB G) (φ : T.total.left ⟶ X.left)
    (hφ : φ ≫ X.hom = T.total.hom ≫ T.b) :
    actionComparison X T φ hφ ≫ pullback.fst G.obj.X.hom X.hom =
      pullback.fst (pullback.snd G.obj.X.hom T.b) T.total.hom ≫
        pullback.fst G.obj.X.hom T.b :=
  pullback.lift_fst _ _ _

/-- On the second factor, the comparison morphism `G_U ×_U P ⟶ G ×_B X` is `φ`. -/
@[reassoc (attr := simp)]
theorem actionComparison_snd (T : TorsorObj hB G) (φ : T.total.left ⟶ X.left)
    (hφ : φ ≫ X.hom = T.total.hom ≫ T.b) :
    actionComparison X T φ hφ ≫ pullback.snd G.obj.X.hom X.hom =
      pullback.snd (pullback.snd G.obj.X.hom T.b) T.total.hom ≫ φ :=
  pullback.lift_snd _ _ _

/-- Base change commutes with the comparison morphism: the comparison morphism attached to the
restriction `g ≫ φ'` of `φ'` along a morphism of torsors is the base change morphism followed
by the comparison morphism attached to `φ'`. -/
theorem actionBaseChange_actionComparison {T T' : TorsorObj hB G} (m : T ⟶ T')
    (φ' : T'.total.left ⟶ X.left) (hφ' : φ' ≫ X.hom = T'.total.hom ≫ T'.b)
    (hφ : (m.g ≫ φ') ≫ X.hom = T.total.hom ≫ T.b) :
    actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫ actionComparison X T' φ' hφ' =
      actionComparison X T (m.g ≫ φ') hφ := by
  apply pullback.hom_ext
  · rw [Category.assoc, actionComparison_fst, actionBaseChange_fst_assoc,
      groupBaseChange_fst, actionComparison_fst]
  · rw [Category.assoc, actionComparison_snd, actionBaseChange_snd_assoc,
      actionComparison_snd]

/-- A morphism of torsors makes `G_U ×_U P` the base change of `G_{U'} ×_{U'} P'` along the
morphism of base objects. -/
theorem actionBaseChange_isPullback {T T' : TorsorObj hB G} (m : T ⟶ T') :
    IsPullback (actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm)
      (pullback.snd T.group.hom T.total.hom ≫ T.total.hom)
      (pullback.snd T'.group.hom T'.total.hom ≫ T'.total.hom) (yoneda.map m.f) := by
  have hgroup : IsPullback (groupBaseChange m.f m.comp_b)
      T.group.hom T'.group.hom (yoneda.map m.f) := by
    apply IsPullback.of_right _ (groupBaseChange_snd m.f m.comp_b)
      (IsPullback.of_hasPullback G.obj.X.hom T'.b)
    rw [groupBaseChange_fst, m.comp_b]
    exact IsPullback.of_hasPullback G.obj.X.hom T.b
  have houter := (IsPullback.of_hasPullback T.group.hom T.total.hom).paste_horiz hgroup
  have hprod : IsPullback (actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm)
      (pullback.snd T.group.hom T.total.hom)
      (pullback.snd T'.group.hom T'.total.hom) m.g := by
    apply IsPullback.of_right _ (actionBaseChange_snd _ _ _ _)
      (IsPullback.of_hasPullback T'.group.hom T'.total.hom)
    have he : actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫
        pullback.fst T'.group.hom T'.total.hom =
        pullback.fst T.group.hom T.total.hom ≫ groupBaseChange m.f m.comp_b :=
      actionBaseChange_fst _ _ _ _
    rwa [← m.isPullback.w, ← he] at houter
  exact hprod.paste_vert m.isPullback

/-- A morphism of fppf `G`-torsors commutes with the compositions `P ⟶ U ⟶ B`. -/
private theorem hom_g_comp_total_hom_comp_b {T T' : TorsorObj hB G} (m : T ⟶ T') :
    m.g ≫ T'.total.hom ≫ T'.b = T.total.hom ≫ T.b := by
  rw [← Category.assoc, m.isPullback.w, Category.assoc, m.comp_b]

variable [ModObj G.obj.X X]

variable (hB G)

/-- An object of `[[X/G]]`: a quadruple `(U, b, P, φ)` as in Situation 04WL, that is an fppf
`G_U`-torsor `P` over an object `U` of the big fppf site with a morphism `b : U ⟶ B`, together
with a `G`-equivariant morphism `φ : P ⟶ X` lying over `b`. -/
structure TorsorWithMap extends TorsorObj hB G where
  /-- The morphism `φ : P ⟶ X`. -/
  map : toTorsorObj.total.left ⟶ X.left
  /-- `φ` lies over `b`. -/
  map_over : map ≫ X.hom = toTorsorObj.total.hom ≫ toTorsorObj.b
  /-- `φ` is `G`-equivariant. -/
  smul_map : (γ[toTorsorObj.group, toTorsorObj.total]).left ≫ map =
    actionComparison X toTorsorObj map map_over ≫ (γ[G.obj.X, X]).left

variable {hB G}

/-- A morphism of `[[X/G]]`: a morphism of the underlying torsors compatible with the
equivariant maps, that is a pair `(f, g)` with `φ = φ' ∘ g` as in Situation 04WL. -/
structure TorsorWithMap.Hom (A C : TorsorWithMap hB G X) where
  /-- The underlying morphism of torsors. -/
  toHom : A.toTorsorObj ⟶ C.toTorsorObj
  /-- The morphism of total spaces is compatible with the equivariant maps. -/
  comp_map : toHom.g ≫ C.map = A.map

/-- Two morphisms of `[[X/G]]` are equal if their underlying morphisms of torsors are. -/
@[ext] theorem TorsorWithMap.Hom.ext {A C : TorsorWithMap hB G X}
    {m n : TorsorWithMap.Hom X A C} (h : m.toHom = n.toHom) : m = n := by
  cases m; cases n; cases h; rfl

/-- Composition of morphisms of `[[X/G]]` preserves compatibility with the equivariant maps. -/
theorem TorsorWithMap.Hom.comp_map_comp {A C D : TorsorWithMap hB G X}
    (m : TorsorWithMap.Hom X A C) (n : TorsorWithMap.Hom X C D) :
    (m.toHom.g ≫ n.toHom.g) ≫ D.map = A.map := by
  rw [Category.assoc, n.comp_map, m.comp_map]

/-- The identity morphism of `[[X/G]]`. -/
@[reducible] def TorsorWithMap.Hom.id (A : TorsorWithMap hB G X) : TorsorWithMap.Hom X A A where
  toHom := 𝟙 A.toTorsorObj
  comp_map := Category.id_comp A.map

/-- Composition of morphisms of `[[X/G]]`. -/
@[reducible] def TorsorWithMap.Hom.comp {A C D : TorsorWithMap hB G X}
    (m : TorsorWithMap.Hom X A C) (n : TorsorWithMap.Hom X C D) : TorsorWithMap.Hom X A D where
  toHom := m.toHom ≫ n.toHom
  comp_map := TorsorWithMap.Hom.comp_map_comp X m n

/-- The identity of `[[X/G]]` is a left unit for composition. -/
theorem TorsorWithMap.Hom.id_comp {A C : TorsorWithMap hB G X} (m : TorsorWithMap.Hom X A C) :
    TorsorWithMap.Hom.comp X (TorsorWithMap.Hom.id X A) m = m :=
  TorsorWithMap.Hom.ext X (Category.id_comp m.toHom)

/-- The identity of `[[X/G]]` is a right unit for composition. -/
theorem TorsorWithMap.Hom.comp_id {A C : TorsorWithMap hB G X} (m : TorsorWithMap.Hom X A C) :
    TorsorWithMap.Hom.comp X m (TorsorWithMap.Hom.id X C) = m :=
  TorsorWithMap.Hom.ext X (Category.comp_id m.toHom)

/-- Composition of morphisms of `[[X/G]]` is associative. -/
theorem TorsorWithMap.Hom.assoc {A C D E : TorsorWithMap hB G X}
    (m : TorsorWithMap.Hom X A C) (n : TorsorWithMap.Hom X C D)
    (l : TorsorWithMap.Hom X D E) :
    TorsorWithMap.Hom.comp X (TorsorWithMap.Hom.comp X m n) l =
      TorsorWithMap.Hom.comp X m (TorsorWithMap.Hom.comp X n l) :=
  TorsorWithMap.Hom.ext X (Category.assoc m.toHom n.toHom l.toHom)

/-- The composition and identities of `[[X/G]]`. -/
@[instance_reducible]
def torsorWithMapCategoryStruct : CategoryStruct (TorsorWithMap hB G X) where
  Hom := TorsorWithMap.Hom X
  id := TorsorWithMap.Hom.id X
  comp := TorsorWithMap.Hom.comp X

/-- The category `[[X/G]]`. -/
instance torsorWithMapCategory : Category (TorsorWithMap hB G X) where
  toCategoryStruct := torsorWithMapCategoryStruct X
  id_comp := TorsorWithMap.Hom.id_comp X
  comp_id := TorsorWithMap.Hom.comp_id X
  assoc := TorsorWithMap.Hom.assoc X

namespace TorsorWithMap

variable (hB G)

/-- The functor `[[X/G]] ⥤ G-Torsors` forgetting the equivariant map. -/
def forget : TorsorWithMap hB G X ⥤ TorsorObj hB G where
  obj A := A.toTorsorObj
  map m := m.toHom
  map_id _ := rfl
  map_comp _ _ := rfl

/-- Forgetting the equivariant map is faithful. -/
instance forget_faithful : (forget hB G X).Faithful where
  map_injective h := TorsorWithMap.Hom.ext X h

/-- The projection `p : [[X/G]] ⟶ (Sch/S)_fppf`, sending `(U, b, P, φ)` to `U`. -/
def projection : TorsorWithMap hB G X ⥤ BigFppfOver 𝒞 S hS :=
  forget hB G X ⋙ torsorProjection hB G

variable {hB G}

/-- The equivariant map of a quadruple restricts along a morphism of torsors into its
underlying torsor. -/
theorem restrict_map_over (C : TorsorWithMap hB G X) {T : TorsorObj hB G}
    (m : T ⟶ C.toTorsorObj) :
    (m.g ≫ C.map) ≫ X.hom = T.total.hom ≫ T.b := by
  rw [Category.assoc, C.map_over]
  exact hom_g_comp_total_hom_comp_b m

/-- The restricted equivariant map is again equivariant. -/
theorem restrict_smul_map (C : TorsorWithMap hB G X) {T : TorsorObj hB G}
    (m : T ⟶ C.toTorsorObj) :
    (γ[T.group, T.total]).left ≫ (m.g ≫ C.map) =
      actionComparison X T (m.g ≫ C.map) (restrict_map_over X C m) ≫
        (γ[G.obj.X, X]).left := by
  have h1 : ((γ[T.group, T.total]).left ≫ m.g) ≫ C.map =
      (actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫
        (γ[C.toTorsorObj.group, C.toTorsorObj.total]).left) ≫ C.map :=
    congrArg (fun k => k ≫ C.map) m.smul_comp
  have h2 : actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫
        ((γ[C.toTorsorObj.group, C.toTorsorObj.total]).left ≫ C.map) =
      actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫
        (actionComparison X C.toTorsorObj C.map C.map_over ≫ (γ[G.obj.X, X]).left) :=
    congrArg (fun k => actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫ k) C.smul_map
  have h3 : (actionBaseChange m.f m.comp_b m.g m.isPullback.w.symm ≫
        actionComparison X C.toTorsorObj C.map C.map_over) ≫ (γ[G.obj.X, X]).left =
      actionComparison X T (m.g ≫ C.map) (restrict_map_over X C m) ≫ (γ[G.obj.X, X]).left :=
    congrArg (fun k => k ≫ (γ[G.obj.X, X]).left)
      (actionBaseChange_actionComparison X m C.map C.map_over (restrict_map_over X C m))
  refine Eq.trans (Category.assoc _ _ _).symm (Eq.trans h1 ?_)
  refine Eq.trans (Category.assoc _ _ _) (Eq.trans h2 ?_)
  exact Eq.trans (Category.assoc _ _ _).symm h3

/-- The restriction of a quadruple along a morphism of torsors into its underlying torsor: the
equivariant map is composed with the morphism of total spaces. -/
def restrict (C : TorsorWithMap hB G X) (T : TorsorObj hB G)
    (m : T ⟶ C.toTorsorObj) : TorsorWithMap hB G X where
  toTorsorObj := T
  map := m.g ≫ C.map
  map_over := restrict_map_over X C m
  smul_map := restrict_smul_map X C m

/-- The morphism of `[[X/G]]` underlying the restriction of a quadruple. -/
def restrictHom (C : TorsorWithMap hB G X) (T : TorsorObj hB G)
    (m : T ⟶ C.toTorsorObj) :
    TorsorWithMap.Hom X (restrict X C T m) C :=
  ⟨m, rfl⟩

/-- The projection of `[[X/G]]` is fibred in groupoids whenever the projection from the
category of fppf `G`-torsors is. -/
theorem projection_isFiberedInGroupoids
    (hqfib : (torsorProjection hB G).IsFiberedInGroupoids) :
    (projection hB G X).IsFiberedInGroupoids := by
  constructor
  · intro V U f C hC
    obtain ⟨T, m, hm⟩ := hqfib.exists_lift f C.toTorsorObj hC
    obtain ⟨⟩ := hm
    refine ⟨restrict X C T m, restrictHom X C T m, ?_⟩
    show (projection hB G X).IsHomLift ((projection hB G X).map (restrictHom X C T m))
      (restrictHom X C T m)
    infer_instance
  · intro C A D m n f hf
    obtain ⟨χ, ⟨hχ, hfac⟩, huniq⟩ :=
      hqfib.unique_lift ((forget hB G X).map m) ((forget hB G X).map n) f hf
    have hmc : m.toHom.g ≫ C.map = A.map := m.comp_map
    have hnc : n.toHom.g ≫ C.map = D.map := n.comp_map
    have he : χ.g ≫ m.toHom.g = n.toHom.g := congrArg TorsorObj.Hom.g hfac
    have heq : χ.g ≫ A.map = D.map :=
      Eq.trans (congrArg (fun k => χ.g ≫ k) hmc.symm)
        (Eq.trans (Category.assoc χ.g m.toHom.g C.map).symm
          (Eq.trans (congrArg (fun k => k ≫ C.map) he) hnc))
    refine ⟨(⟨χ, heq⟩ : TorsorWithMap.Hom X D A), ⟨hχ, ?_⟩, ?_⟩
    · apply (forget hB G X).map_injective
      rw [Functor.map_comp]
      exact hfac
    · intro a ha
      apply (forget hB G X).map_injective
      refine huniq ((forget hB G X).map a) ⟨ha.1, ?_⟩
      rw [← Functor.map_comp, ha.2]

/-- The equivariant maps of a family of quadruples whose underlying torsors cover a torsor `T`
glue to an equivariant map out of `T`, as soon as they agree on sections with a common image in
`T`. -/
theorem exists_glue_map {I : Type*} (hX : IsAlgebraicSpace 𝒞 S hS X.left) (T : TorsorObj hB G)
    (A : I → TorsorWithMap hB G X) (mi : ∀ i, (A i).toTorsorObj ⟶ T)
    (hf : Sieve.ofArrows (fun i => (A i).toTorsorObj.U) (fun i => (mi i).f) ∈
      BigFppfOver.topology 𝒞 S hS T.U)
    (hcomp : ∀ (Z : (BigFppfOver 𝒞 S hS)ᵒᵖ) (i j : I) (s : (A i).total.left.obj Z)
      (t : (A j).total.left.obj Z), (mi i).g.app Z s = (mi j).g.app Z t →
        (A i).map.app Z s = (A j).map.app Z t) :
    ∃ φ : T.total.left ⟶ X.left, (∀ i, (mi i).g ≫ φ = (A i).map) ∧
      ∃ hφo : φ ≫ X.hom = T.total.hom ≫ T.b,
        (γ[T.group, T.total]).left ≫ φ =
          actionComparison X T φ hφo ≫ (γ[G.obj.X, X]).left := by
  have hcover := torsorRestrictions_cover T (fun i => (A i).toTorsorObj) mi hf
  obtain ⟨φ, hφ, -⟩ := glueHom (BigFppfOver.topology 𝒞 S hS) (fun i => (mi i).g) hcover
    hX.isSheaf (fun i => (A i).map) hcomp
  have hφo : φ ≫ X.hom = T.total.hom ≫ T.b := by
    refine hom_ext_of_familyImage_cover _ (fun i => (mi i).g) hcover hB.isSheaf _ _ ?_
    intro i
    rw [← Category.assoc, hφ i, (A i).map_over]
    exact (hom_g_comp_total_hom_comp_b (mi i)).symm
  refine ⟨φ, hφ, hφo, ?_⟩
  have hcoverH := familyImage_cover (BigFppfOver.topology 𝒞 S hS) (fun i => (mi i).f) hf
    (pullback.snd T.group.hom T.total.hom ≫ T.total.hom)
    (fun i => actionBaseChange (mi i).f (mi i).comp_b (mi i).g (mi i).isPullback.w.symm)
    (fun i => pullback.snd (A i).toTorsorObj.group.hom (A i).toTorsorObj.total.hom ≫
      (A i).toTorsorObj.total.hom)
    (fun i => actionBaseChange_isPullback (mi i))
  refine hom_ext_of_familyImage_cover _ _ hcoverH hX.isSheaf _ _ ?_
  intro i
  have hw : ((mi i).g ≫ φ) ≫ X.hom = (A i).toTorsorObj.total.hom ≫ (A i).toTorsorObj.b := by
    rw [hφ i]; exact (A i).map_over
  have hc : actionBaseChange (mi i).f (mi i).comp_b (mi i).g (mi i).isPullback.w.symm ≫
      actionComparison X T φ hφo =
      actionComparison X (A i).toTorsorObj (A i).map (A i).map_over := by
    rw [actionBaseChange_actionComparison X (mi i) φ hφo hw]
    congr 1
    exact hφ i
  have e1 : actionBaseChange (mi i).f (mi i).comp_b (mi i).g (mi i).isPullback.w.symm ≫
      (γ[T.group, T.total]).left ≫ φ =
      ((γ[(A i).toTorsorObj.group, (A i).toTorsorObj.total]).left ≫ (mi i).g) ≫ φ :=
    (Category.assoc _ _ _).symm.trans (congrArg (· ≫ φ) (mi i).smul_comp.symm)
  have e2 : ((γ[(A i).toTorsorObj.group, (A i).toTorsorObj.total]).left ≫ (mi i).g) ≫ φ =
      (γ[(A i).toTorsorObj.group, (A i).toTorsorObj.total]).left ≫ (A i).map := by
    rw [Category.assoc, hφ i]
  have e4 : actionComparison X (A i).toTorsorObj (A i).map (A i).map_over ≫
      (γ[G.obj.X, X]).left =
      actionBaseChange (mi i).f (mi i).comp_b (mi i).g (mi i).isPullback.w.symm ≫
        actionComparison X T φ hφo ≫ (γ[G.obj.X, X]).left := by
    rw [← hc, Category.assoc]
  exact e1.trans (e2.trans ((A i).smul_map.trans e4))

/-- The projection `p : [[X/G]] ⟶ (Sch/S)_fppf` is a stack in groupoids for the fppf topology
as soon as the projection `AlgebraicGeometry.Space.torsorProjection` from the category of fppf
`G`-torsors is fibred in groupoids and is a stack. -/
theorem projection_isStackInGroupoids
    (hX : IsAlgebraicSpace 𝒞 S hS X.left)
    (hqfib : (torsorProjection hB G).IsFiberedInGroupoids)
    (hqst : (torsorProjection hB G).IsStack (BigFppfOver.topology 𝒞 S hS)) :
    Functor.IsStackInGroupoids.{w} (projection hB G X) (BigFppfOver.topology 𝒞 S hS) := by
  have hp := projection_isFiberedInGroupoids X hqfib
  refine (Functor.isStack_of_faithful_of_isSheaf hp hqfib rfl hqst
    (fun U => inferInstance) ?_ ?_).isStackInGroupoids hp
  · intro y V h R hR x x' f f' hlf hlf' hloc
    classical
    have hxb : x.toTorsorObj.U = V :=
      @IsHomLift.domain_eq _ _ _ _ (torsorProjection hB G) _ _ _ _ h f hlf
    have hxb' : x'.toTorsorObj.U = V :=
      @IsHomLift.domain_eq _ _ _ _ (torsorProjection hB G) _ _ _ _ h f' hlf'
    have hcod : (torsorProjection hB G).obj y = (torsorProjection hB G).obj y := rfl
    have hff : f.f = eqToHom hxb ≫ h ≫ eqToHom hcod.symm :=
      @IsHomLift.fac' _ _ _ _ (torsorProjection hB G) _ _ _ _ h f hlf
    have hff' : f'.f = eqToHom hxb' ≫ h ≫ eqToHom hcod.symm :=
      @IsHomLift.fac' _ _ _ _ (torsorProjection hB G) _ _ _ _ h f' hlf'
    have hq1 : eqToHom (hxb.trans hxb'.symm) ≫ eqToHom hxb' = eqToHom hxb :=
      eqToHom_trans _ _
    have hkey : eqToHom (hxb.trans hxb'.symm) ≫ f'.f = f.f :=
      (congrArg (eqToHom (hxb.trans hxb'.symm) ≫ ·) hff').trans
        ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ h ≫ eqToHom hcod.symm) hq1).trans hff.symm))
    obtain ⟨χ, ⟨hχb, hχf⟩, -⟩ := hqfib.unique_lift f' f (eqToHom (hxb.trans hxb'.symm)) hkey
    have hχb' : χ.f = eqToHom (hxb.trans hxb'.symm) := hχb
    have hq2 : eqToHom hxb ≫ 𝟙 V ≫ eqToHom hxb'.symm =
        eqToHom (hxb.trans hxb'.symm) := by
      rw [Category.id_comp]
      exact eqToHom_trans _ _
    choose zz cz cz' hzl hzl' hze using
      fun (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g) => hloc g hg
    have hd : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (zz W g hg).toTorsorObj.U = W := fun W g hg =>
      @IsHomLift.domain_eq _ _ _ _ (projection hB G X) _ _ _ _ g (cz W g hg) (hzl W g hg)
    have hfb : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (cz W g hg).toHom.f = eqToHom (hd W g hg) ≫ g ≫ eqToHom hxb.symm := fun W g hg =>
      @IsHomLift.fac' _ _ _ _ (projection hB G X) _ _ _ _ g (cz W g hg) (hzl W g hg)
    have hfb' : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (cz' W g hg).toHom.f = eqToHom (hd W g hg) ≫ g ≫ eqToHom hxb'.symm := fun W g hg =>
      @IsHomLift.fac' _ _ _ _ (projection hB G X) _ _ _ _ g (cz' W g hg) (hzl' W g hg)
    have hfarr := ofArrows_mem_of_eqToHom_comp (BigFppfOver.topology 𝒞 S hS) hxb hR
      (fun i => (zz i.1 i.2.1 i.2.2).toTorsorObj.U) (fun i => hd i.1 i.2.1 i.2.2)
      (fun i => (cz i.1 i.2.1 i.2.2).toHom.f) (fun i => hfb i.1 i.2.1 i.2.2)
    have hcover := torsorRestrictions_cover
      (I := (W : BigFppfOver 𝒞 S hS) × {g : W ⟶ V // R.arrows g}) x.toTorsorObj
      (fun i => (zz i.1 i.2.1 i.2.2).toTorsorObj) (fun i => (cz i.1 i.2.1 i.2.2).toHom) hfarr
    have hfam : ∀ i : (W : BigFppfOver 𝒞 S hS) × {g : W ⟶ V // R.arrows g},
        (cz i.1 i.2.1 i.2.2).toHom.g ≫ (χ.g ≫ x'.map) =
          (cz i.1 i.2.1 i.2.2).toHom.g ≫ x.map := by
      intro i
      obtain ⟨W, ⟨g, hg⟩⟩ := i
      have hb0 : (eqToHom (hd W g hg) ≫ g ≫ eqToHom hxb.symm) ≫
          eqToHom (hxb.trans hxb'.symm) =
          eqToHom (hd W g hg) ≫ g ≫ eqToHom hxb'.symm :=
        (Category.assoc _ _ _).trans
          (congrArg (eqToHom (hd W g hg) ≫ ·)
            ((Category.assoc _ _ _).trans (congrArg (g ≫ ·) (eqToHom_trans _ _))))
      have hb1 : (cz W g hg).toHom.f ≫ χ.f =
          eqToHom (hd W g hg) ≫ g ≫ eqToHom hxb'.symm :=
        (congrArg (· ≫ χ.f) (hfb W g hg)).trans
          ((congrArg (fun k =>
            (eqToHom (hd W g hg) ≫ g ≫ eqToHom hxb.symm) ≫ k) hχb').trans hb0)
      have hbase : (cz W g hg).toHom.f ≫ χ.f = (cz' W g hg).toHom.f :=
        hb1.trans (hfb' W g hg).symm
      have h4 : ((cz W g hg).toHom ≫ χ) ≫ f' = (cz' W g hg).toHom ≫ f' :=
        (Category.assoc _ _ _).trans
          ((congrArg ((cz W g hg).toHom ≫ ·) hχf).trans (hze W g hg))
      obtain ⟨wit, -, huq⟩ := hqfib.unique_lift f' ((cz' W g hg).toHom ≫ f')
        (cz' W g hg).toHom.f rfl
      have hfc : (cz W g hg).toHom ≫ χ = (cz' W g hg).toHom :=
        (huq ((cz W g hg).toHom ≫ χ) ⟨hbase, h4⟩).trans
          (huq (cz' W g hg).toHom ⟨rfl, rfl⟩).symm
      have hgg : (cz W g hg).toHom.g ≫ χ.g = (cz' W g hg).toHom.g :=
        congrArg TorsorObj.Hom.g hfc
      have k1 : (cz W g hg).toHom.g ≫ χ.g ≫ x'.map =
          ((cz W g hg).toHom.g ≫ χ.g) ≫ x'.map := (Category.assoc _ _ _).symm
      have k2 : ((cz W g hg).toHom.g ≫ χ.g) ≫ x'.map = (cz' W g hg).toHom.g ≫ x'.map :=
        congrArg (· ≫ x'.map) hgg
      exact k1.trans (k2.trans ((cz' W g hg).comp_map.trans (cz W g hg).comp_map.symm))
    have hcm : χ.g ≫ x'.map = x.map :=
      hom_ext_of_familyImage_cover
        (I := (W : BigFppfOver 𝒞 S hS) × {g : W ⟶ V // R.arrows g})
        (BigFppfOver.topology 𝒞 S hS)
        (fun i => (cz i.1 i.2.1 i.2.2).toHom.g) hcover hX.isSheaf _ _ hfam
    exact ⟨⟨χ, hcm⟩,
      IsHomLift.of_fac' (projection hB G X) (𝟙 V) ⟨χ, hcm⟩ hxb hxb' (hχb'.trans hq2.symm),
      hχf⟩
  · intro y V h R hR xx ff hfl hcompat
    classical
    obtain ⟨T₀, f₀, hf₀⟩ := hqfib.exists_lift h y rfl
    have h0 : T₀.U = V :=
      @IsHomLift.domain_eq _ _ _ _ (torsorProjection hB G) _ _ _ _ h f₀ hf₀
    have hf0f : f₀.f = eqToHom h0 ≫ h := by
      have h1 : f₀.f = eqToHom h0 ≫ h ≫ 𝟙 ((torsorProjection hB G).obj y) :=
        @IsHomLift.fac' _ _ _ _ (torsorProjection hB G) _ _ _ _ h f₀ hf₀
      rwa [Category.comp_id] at h1
    have hd : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (xx g hg).toTorsorObj.U = W := fun W g hg =>
      @IsHomLift.domain_eq _ _ _ _ (torsorProjection hB G) _ _ _ _ (g ≫ h) (ff g hg)
        (hfl g hg)
    have hffb : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (ff g hg).f = eqToHom (hd W g hg) ≫ g ≫ h := by
      intro W g hg
      have h1 : (ff g hg).f =
          eqToHom (hd W g hg) ≫ (g ≫ h) ≫ 𝟙 ((torsorProjection hB G).obj y) :=
        @IsHomLift.fac' _ _ _ _ (torsorProjection hB G) _ _ _ _ (g ≫ h) (ff g hg) (hfl g hg)
      rwa [Category.comp_id] at h1
    have hid : eqToHom h0.symm ≫ eqToHom h0 ≫ h = h :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ h) (eqToHom_trans h0.symm h0)).trans (Category.id_comp h))
    have hcond : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (eqToHom (hd W g hg) ≫ g ≫ eqToHom h0.symm) ≫ f₀.f = (ff g hg).f := by
      intro W g hg
      rw [hf0f, hffb W g hg]
      exact (Category.assoc _ _ _).trans
        ((congrArg (eqToHom (hd W g hg) ≫ ·) (Category.assoc _ _ _)).trans
          (congrArg (fun z => eqToHom (hd W g hg) ≫ g ≫ z) hid))
    have hcclift : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        ∃! c : (xx g hg).toTorsorObj ⟶ T₀,
          c.f = eqToHom (hd W g hg) ≫ g ≫ eqToHom h0.symm ∧ c ≫ f₀ = ff g hg := fun W g hg =>
      hqfib.unique_lift f₀ (ff g hg) (eqToHom (hd W g hg) ≫ g ≫ eqToHom h0.symm)
        (hcond W g hg)
    choose cc hccP hccu using hcclift
    have hccb : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        (cc W g hg).f = eqToHom (hd W g hg) ≫ g ≫ eqToHom h0.symm :=
      fun W g hg => (hccP W g hg).1
    have hccf : ∀ (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g),
        cc W g hg ≫ f₀ = ff g hg := fun W g hg => (hccP W g hg).2
    have hfarr := ofArrows_mem_of_eqToHom_comp (BigFppfOver.topology 𝒞 S hS) h0 hR
      (fun i => (xx i.2.1 i.2.2).toTorsorObj.U) (fun i => hd i.1 i.2.1 i.2.2)
      (fun i => (cc i.1 i.2.1 i.2.2).f) (fun i => hccb i.1 i.2.1 i.2.2)
    have hT₀ : ∀ (Z : (BigFppfOver 𝒞 S hS)ᵒᵖ) (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V)
        (hg : R.arrows g) (u : (xx g hg).total.left.obj Z),
        T₀.total.hom.app Z ((cc W g hg).g.app Z u) =
          (((xx g hg).total.hom.app Z u ≫ eqToHom (hd W g hg)) ≫ g) ≫ eqToHom h0.symm := by
      intro Z W g hg u
      have hw : T₀.total.hom.app Z ((cc W g hg).g.app Z u) =
          (xx g hg).total.hom.app Z u ≫ (cc W g hg).f :=
        ConcreteCategory.congr_hom (NatTrans.congr_app (cc W g hg).isPullback.w Z) u
      rw [hw, hccb W g hg]
      simp
    have main : ∀ (Z : (BigFppfOver 𝒞 S hS)ᵒᵖ) (b : Z.unop ⟶ V) (hb : R.arrows b)
        (W : BigFppfOver 𝒞 S hS) (g : W ⟶ V) (hg : R.arrows g)
        (u : (xx g hg).total.left.obj Z) (k : Z.unop ⟶ W),
        (xx g hg).total.hom.app Z u ≫ eqToHom (hd W g hg) = k → k ≫ g = b →
        ∃ v : (xx b hb).total.left.obj Z,
          (cc Z.unop b hb).g.app Z v = (cc W g hg).g.app Z u ∧
          (xx b hb).total.hom.app Z v = eqToHom (hd Z.unop b hb).symm ∧
          (xx b hb).map.app Z v = (xx g hg).map.app Z u := by
      intro Z b hb W g hg u k hk hkb
      subst hkb
      obtain rfl : hb = R.downward_closed hg k := rfl
      obtain ⟨c₁, hc₁l, hc₁f⟩ := hcompat g hg k
      have hcfac : c₁.toHom.f =
          eqToHom (hd Z.unop (k ≫ g) (R.downward_closed hg k)) ≫ k ≫
            eqToHom (hd W g hg).symm :=
        @IsHomLift.fac' _ _ _ _ (projection hB G X) _ _ _ _ k c₁ hc₁l
      have hpb := c₁.toHom.isPullback.map
        ((evaluation (BigFppfOver 𝒞 S hS)ᵒᵖ (Type u)).obj Z)
      have hcnd : (xx g hg).total.hom.app Z u =
          (yoneda.map c₁.toHom.f).app Z
            (eqToHom (hd Z.unop (k ≫ g) (R.downward_closed hg k)).symm) := by
        show _ = eqToHom (hd Z.unop (k ≫ g) (R.downward_closed hg k)).symm ≫ c₁.toHom.f
        rw [hcfac, ← hk]
        simp
      obtain ⟨v, hv1, hv2⟩ := Types.exists_of_isPullback hpb u
        (eqToHom (hd Z.unop (k ≫ g) (R.downward_closed hg k)).symm) hcnd
      refine ⟨v, ?_, hv2, ?_⟩
      · have hu1 : (c₁.toHom ≫ cc W g hg).f =
            eqToHom (hd Z.unop (k ≫ g) (R.downward_closed hg k)) ≫
              (k ≫ g) ≫ eqToHom h0.symm := by
          show c₁.toHom.f ≫ (cc W g hg).f = _
          rw [hcfac, hccb W g hg]
          simp
        have hu2 : (c₁.toHom ≫ cc W g hg) ≫ f₀ = ff (k ≫ g) (R.downward_closed hg k) :=
          (Category.assoc _ _ _).trans
            ((congrArg (c₁.toHom ≫ ·) (hccf W g hg)).trans hc₁f)
        have hcceq := hccu Z.unop (k ≫ g) (R.downward_closed hg k)
          (c₁.toHom ≫ cc W g hg) ⟨hu1, hu2⟩
        rw [← hcceq]
        show (cc W g hg).g.app Z (c₁.toHom.g.app Z v) = _
        exact congrArg (fun z => (cc W g hg).g.app Z z) hv1
      · rw [← c₁.comp_map]
        show (xx g hg).map.app Z (c₁.toHom.g.app Z v) = _
        exact congrArg (fun z => (xx g hg).map.app Z z) hv1
    have hcomp0 : ∀ (Z : (BigFppfOver 𝒞 S hS)ᵒᵖ) (W₁ : BigFppfOver 𝒞 S hS) (g₁ : W₁ ⟶ V)
        (hg₁ : R.arrows g₁) (W₂ : BigFppfOver 𝒞 S hS) (g₂ : W₂ ⟶ V) (hg₂ : R.arrows g₂)
        (s : (xx g₁ hg₁).total.left.obj Z) (t : (xx g₂ hg₂).total.left.obj Z),
        (cc W₁ g₁ hg₁).g.app Z s = (cc W₂ g₂ hg₂).g.app Z t →
          (xx g₁ hg₁).map.app Z s = (xx g₂ hg₂).map.app Z t := by
      intro Z W₁ g₁ hg₁ W₂ g₂ hg₂ s t hst
      have hb1 : R.arrows
          (((xx g₁ hg₁).total.hom.app Z s ≫ eqToHom (hd W₁ g₁ hg₁)) ≫ g₁) :=
        R.downward_closed hg₁ _
      have hbb : ((xx g₂ hg₂).total.hom.app Z t ≫ eqToHom (hd W₂ g₂ hg₂)) ≫ g₂ =
          ((xx g₁ hg₁).total.hom.app Z s ≫ eqToHom (hd W₁ g₁ hg₁)) ≫ g₁ := by
        have hc := (hT₀ Z W₂ g₂ hg₂ t).symm.trans
          ((congrArg (T₀.total.hom.app Z) hst.symm).trans (hT₀ Z W₁ g₁ hg₁ s))
        simpa using congrArg (· ≫ eqToHom h0) hc
      obtain ⟨v₁, hv₁a, hv₁b, hv₁c⟩ := main Z _ hb1 W₁ g₁ hg₁ s _ rfl rfl
      obtain ⟨v₂, hv₂a, hv₂b, hv₂c⟩ := main Z _ hb1 W₂ g₂ hg₂ t _ rfl hbb
      have hpb0 := (cc Z.unop _ hb1).isPullback.map
        ((evaluation (BigFppfOver 𝒞 S hS)ᵒᵖ (Type u)).obj Z)
      have hveq : v₁ = v₂ :=
        Types.ext_of_isPullback hpb0 (hv₁a.trans (hst.trans hv₂a.symm))
          (hv₁b.trans hv₂b.symm)
      exact hv₁c.symm.trans ((congrArg ((xx _ hb1).map.app Z) hveq).trans hv₂c)
    obtain ⟨φ, hφ, hφo, hφe⟩ := exists_glue_map X
      (I := (W : BigFppfOver 𝒞 S hS) × {g : W ⟶ V // R.arrows g}) hX T₀
      (fun i => xx i.2.1 i.2.2) (fun i => cc i.1 i.2.1 i.2.2) hfarr
      (fun Z i j s t hst => hcomp0 Z i.1 i.2.1 i.2.2 j.1 j.2.1 j.2.2 s t hst)
    refine ⟨{ toTorsorObj := T₀, map := φ, map_over := hφo, smul_map := hφe }, f₀, hf₀, ?_⟩
    intro W g hg
    refine ⟨⟨cc W g hg, hφ ⟨W, ⟨g, hg⟩⟩⟩, ?_, hccf W g hg⟩
    exact IsHomLift.of_fac' (projection hB G X) g _ (hd W g hg) h0 (hccb W g hg)

/-- In Situation 04WL the projection `p : [[X/G]] ⟶ (Sch/S)_fppf` is a stack in groupoids for the
fppf topology. -/
@[stacks 0370 "in Situation 04WL: the projection of [[X/G]] is a stack in groupoids for the \
fppf topology"]
theorem projection_isStackInGroupoids_unconditional
    (hX : IsAlgebraicSpace 𝒞 S hS X.left) :
    Functor.IsStackInGroupoids.{w} (projection hB G X) (BigFppfOver.topology 𝒞 S hS) := by
  have hfib₀ := FppfTorsors.projection_isFiberedInGroupoids (hB := hB) (G := G)
  let : (FppfTorsors.projection hB G).IsFibered := hfib₀.isFibered
  have hst₀ : (FppfTorsors.projection hB G).IsStack (BigFppfOver.topology 𝒞 S hS) :=
    { isFibered := inferInstance
      isMorSheaf :=
        Functor.isMorSheaf_of_isomIsSheaf hfib₀
          (fun {_U} a b ha hb {_K} V g hg Vij pr₁ pr₂ hVij ar br arij brij =>
            FppfTorsors.projection_isomIsSheaf a b ha hb V g hg Vij pr₁ pr₂ hVij ar br arij brij)
      hasEffectiveDescent :=
        FppfTorsors.hasEffectiveDescent_projection_of_bootstrap hB G
          (isBootstrapAlgebraicSpaceAlongFlatSurjection 𝒞 S hS)
          (SheafTorsors.projection_hasEffectiveDescent G.obj hB.isSheaf G.property.isSheaf) }
  let e : BasedCategory.Equivalence (BasedCategory.ofFunctor (FppfTorsors.projection hB G))
      (BasedCategory.ofFunctor (torsorProjection hB G)) :=
    { functor :=
        { toFunctor :=
            { obj := fun T =>
                { U := T.base, b := T.sec, total := T.total
                  isAlgebraicSpace := T.isAlgebraicSpace, action := T.action
                  isFppfTorsor := T.isTorsor }
              map := fun φ =>
                { f := φ.base, comp_b := φ.comp_sec, g := φ.map, isPullback := φ.isPullback
                  smul_comp := φ.smul_comp }
              map_id := fun _ => rfl
              map_comp := fun _ _ => rfl }
          w := rfl }
      inverse :=
        { toFunctor :=
            { obj := fun T =>
                { base := T.U, sec := T.b, total := T.total
                  isAlgebraicSpace := T.isAlgebraicSpace, action := T.action
                  isTorsor := T.isFppfTorsor }
              map := fun φ =>
                { base := φ.f, comp_sec := φ.comp_b, map := φ.g, isPullback := φ.isPullback
                  smul_comp := φ.smul_comp }
              map_id := fun _ => rfl
              map_comp := fun _ _ => rfl }
          w := rfl }
      unitIso := Iso.refl _
      counitIso := Iso.refl _ }
  exact projection_isStackInGroupoids X hX (e.isFiberedInGroupoids hfib₀) (e.isStack _ hst₀)

end TorsorWithMap

end EquivariantMap

/-! ### The classifying stack of `G`: the trivial action on the base -/

section ClassifyingStack

variable (hB) (G)

/-- The trivial action of a group algebraic space `G` over `B` on the base, that is on the
monoidal unit `𝟙_ (Over B)` of the slice over `B`, whose underlying presheaf is `B` itself. -/
instance instModObjTensorUnit : ModObj G.obj.X (𝟙_ (Over B)) :=
  ModObj.trivialAction _ _

/-- The trivial action of `G` on the base is the second projection of `G ×_B B`. -/
theorem smul_tensorUnit_left :
    (γ[G.obj.X, 𝟙_ (Over B)]).left = pullback.snd G.obj.X.hom (𝟙_ (Over B)).hom :=
  rfl

variable {hB} {G}

/-- The composition `P ⟶ U ⟶ B` attached to an fppf `G`-torsor `(U, b, P)` lies over `b`. -/
theorem toBase_over (T : TorsorObj hB G) :
    (T.total.hom ≫ T.b) ≫ (𝟙_ (Over B)).hom = T.total.hom ≫ T.b :=
  Category.comp_id _

/-- The composition `P ⟶ U ⟶ B` is equivariant for the trivial action of `G` on the base. -/
theorem smul_toBase (T : TorsorObj hB G) :
    (γ[T.group, T.total]).left ≫ (T.total.hom ≫ T.b) =
      actionComparison (𝟙_ (Over B)) T (T.total.hom ≫ T.b) (toBase_over T) ≫
        (γ[G.obj.X, 𝟙_ (Over B)]).left := by
  have hover : (γ[T.group, T.total]).left ≫ T.total.hom =
      pullback.snd T.group.hom T.total.hom ≫ T.total.hom := by
    rw [Over.w]
    show (T.group ⊗ T.total).hom = _
    rw [Over.tensorObj_hom, pullback.condition]
  rw [smul_tensorUnit_left, actionComparison_snd]
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ T.b) hover).trans (Category.assoc _ _ _))

/-- An fppf `G`-torsor `(U, b, P)` as an object of `[[B/G]]`, carrying the unique equivariant
morphism to the base lying over `b`, namely the composition `P ⟶ U ⟶ B`. -/
def TorsorObj.toTorsorWithMap (T : TorsorObj hB G) : TorsorWithMap hB G (𝟙_ (Over B)) where
  toTorsorObj := T
  map := T.total.hom ≫ T.b
  map_over := toBase_over T
  smul_map := smul_toBase T

/-- A morphism of fppf `G`-torsors is compatible with the morphisms to the base attached to its
source and target. -/
theorem comp_toBase {T T' : TorsorObj hB G} (φ : T ⟶ T') :
    φ.g ≫ (T'.total.hom ≫ T'.b) = T.total.hom ≫ T.b :=
  hom_g_comp_total_hom_comp_b φ

/-- The equivariant morphism to the base of an object of `[[B/G]]` is the composition
`P ⟶ U ⟶ B`. -/
theorem TorsorWithMap.map_eq_toBase (A : TorsorWithMap hB G (𝟙_ (Over B))) :
    A.map = A.total.hom ≫ A.b :=
  (Category.comp_id A.map).symm.trans A.map_over

variable (hB) (G)

/-- The canonical functor `G-Torsors ⥤ [[B/G]]`, attaching to an fppf `G`-torsor its unique
equivariant morphism to the base and to a morphism of torsors the same morphism. -/
@[stacks 0CQJ "the functor G-Torsors ⥤ [[B/G]]"]
def torsorObjToTorsorWithMap : TorsorObj hB G ⥤ TorsorWithMap hB G (𝟙_ (Over B)) where
  obj T := T.toTorsorWithMap
  map φ := ⟨φ, comp_toBase φ⟩
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The unit of the equivalence `[[B/G]] ≌ G-Torsors`: an object of `[[B/G]]` is isomorphic to
the quadruple attached to its underlying torsor by the identity morphism of that torsor. -/
def torsorWithMapUnitIso :
    𝟭 (TorsorWithMap hB G (𝟙_ (Over B))) ≅
      TorsorWithMap.forget hB G (𝟙_ (Over B)) ⋙ torsorObjToTorsorWithMap hB G :=
  NatIso.ofComponents
    (fun A =>
      { hom := ⟨𝟙 A.toTorsorObj, (Category.id_comp _).trans A.map_eq_toBase.symm⟩
        inv := ⟨𝟙 A.toTorsorObj, (Category.id_comp _).trans A.map_eq_toBase⟩
        hom_inv_id := TorsorWithMap.Hom.ext _ (Category.id_comp _)
        inv_hom_id := TorsorWithMap.Hom.ext _ (Category.id_comp _) })
    (fun _ => TorsorWithMap.Hom.ext _
      ((Category.comp_id _).trans (Category.id_comp _).symm))

/-- The counit of the equivalence `[[B/G]] ≌ G-Torsors`: attaching to an fppf `G`-torsor its
unique equivariant morphism to the base and then forgetting that morphism returns the torsor. -/
def torsorWithMapCounitIso :
    torsorObjToTorsorWithMap hB G ⋙ TorsorWithMap.forget hB G (𝟙_ (Over B)) ≅
      𝟭 (TorsorObj hB G) :=
  NatIso.ofComponents (fun T => Iso.refl T)
    (fun _ => (Category.comp_id _).trans (Category.id_comp _).symm)

/-- The category `[[B/G]]` of fppf `G`-torsors with an equivariant morphism to the base, that is
the quotient category of the trivial action of `G` on `B`, is canonically equivalent to the
category `G-Torsors` of fppf `G`-torsors; the equivalence forgets the equivariant morphism. -/
@[stacks 0CQJ "[[B/G]] ≌ G-Torsors"]
def torsorWithMapEquivTorsorObj : TorsorWithMap hB G (𝟙_ (Over B)) ≌ TorsorObj hB G where
  functor := TorsorWithMap.forget hB G (𝟙_ (Over B))
  inverse := torsorObjToTorsorWithMap hB G
  unitIso := torsorWithMapUnitIso hB G
  counitIso := torsorWithMapCounitIso hB G
  functor_unitIso_comp _ := Category.id_comp _

/-- The functor `G-Torsors ⥤ [[B/G]]` of the equivalence of Stacks 0CQJ lies over the big fppf
site, so the equivalence is one of categories over `(Sch/S)_fppf`. -/
theorem torsorObjToTorsorWithMap_comp_projection :
    torsorObjToTorsorWithMap hB G ⋙ TorsorWithMap.projection hB G (𝟙_ (Over B)) =
      torsorProjection hB G :=
  rfl

/-- The functor `[[B/G]] ⥤ G-Torsors` of the equivalence of Stacks 0CQJ lies over the big fppf
site, so the equivalence is one of categories over `(Sch/S)_fppf`. -/
theorem forget_comp_torsorProjection :
    TorsorWithMap.forget hB G (𝟙_ (Over B)) ⋙ torsorProjection hB G =
      TorsorWithMap.projection hB G (𝟙_ (Over B)) :=
  rfl

end ClassifyingStack

end Torsors

end AlgebraicGeometry.Space

