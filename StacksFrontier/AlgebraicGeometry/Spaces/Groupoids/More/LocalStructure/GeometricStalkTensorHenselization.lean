module

public import Mathlib.Algebra.Category.Ring.Constructions
public import StacksFrontier.AlgebraicGeometry.Spaces.CohenMacaulay.Source
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.More.LocalStructure.GeometricStalkLocalAlgebra
public import StacksFrontier.RingTheory.Branches.WeaklyEtaleTensorProduct

/-!
# The local structure of a groupoid in algebraic spaces at a geometric identity

Let `(U, R, s, t, c, e, i)` be a groupoid in algebraic spaces over a scheme `S`, let `ū` be a
geometric point of `U`, and write

```
A = 𝒪_{U, ū},   B = 𝒪_{R, e(ū)},   C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}
```

for the étale local rings (Stacks 04KG).  This file proves the statements of Stacks, Section
0CK9, about them:

* `A`, `B`, `C` are local rings and the homomorphisms induced by `s, t, c, e, i` and by
  `(e, e) : U ⟶ R ×_{s, U, t} R` are local homomorphisms;
* `e ∘ s = 1 = e ∘ t`, so that `B = s(A) ⊕ I = t(A) ⊕ I` for `I = ker (e : B → A)`;
* the ideal `𝔪_B ⊗ B + B ⊗ 𝔪_B` of `B ⊗_{s, A, t} B` is maximal, the localization at it has
  separably closed residue field, and `C` is the henselization of that localization;
* the ideal `J` of `C` generated by `I ⊗ B + B ⊗ I` is the kernel of `(e, e) : C → A`;
* `c : B → C` sends `I` into `J`.

All of them are collected in `AlgebraicGeometry.GroupoidInAlgebraicSpaces.localStructure`.

## Main definitions

* `StacksDraft.pushoutMaximalIdeal`: the ideal `𝔪_B ⊗ B + B ⊗ 𝔪_B` of the pushout
  `B ⊗_{s, A, t} B` of two homomorphisms `s, t : A → B` of local rings.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityPairMorphism`: the morphism
  `(e, e) : U ⟶ R ×_{s, U, t} R`.
* `StacksDraft.pushoutAugmentation`: the augmentation `B ⊗_{s, A, t} B → A` of a common
  retraction `e` of `s` and `t`.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityPairStalk`: the homomorphism
  `(e, e) : C → A` it induces.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityPairTensorMap`: the homomorphism
  `B ⊗_{s, A, t} B → C`, `b₁ ⊗ b₂ ↦ pr₁(b₁) pr₂(b₂)`.

## Main results

* `StacksDraft.exists_isHenselization_localization_pushout`: a strictly henselian local ring
  which is weakly étale over `B ⊗_{s, A, t} B`, compatibly with a retraction onto `A`, is the
  henselization of the localization of `B ⊗_{s, A, t} B` at `𝔪_B ⊗ B + B ⊗ 𝔪_B`.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.localStructure`: Stacks 0CK9.

## Implementation notes

`B ⊗_{s, A, t} B` carries two different `A`-algebra structures on the same ring `B`, so it is
taken as the pushout of `s` and `t` in `CommRingCat`, which is the tensor product
(`CommRingCat.isPushout_tensorProduct`); the two inclusions of `B` are `pushout.inl` and
`pushout.inr`.

The henselization is the class `IsLocalRing.IsHenselization` of Stacks 04GQ with residue
extension the residue field itself, that is, the henselization `R → R^h` of Lemma 04GN.  It is
obtained from `IsLocalRing.IsHenselization.of_weaklyEtale`, applied to the weakly étale
homomorphism `B ⊗_{s, A, t} B → C` of
`AlgebraicGeometry.Space.cartesian_etaleStalk_tensor_weaklyEtale` after localizing; the residue
field of the localization is that of `A`, which is separably closed, so the strict henselization
that lemma produces is the henselization.

## References

* [Stacks Project, Tag 0CK9](https://stacks.math.columbia.edu/tag/0CK9)
* [Stacks Project, Tag 04KG](https://stacks.math.columbia.edu/tag/04KG)
* [Stacks Project, Tag 04GQ](https://stacks.math.columbia.edu/tag/04GQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u v

namespace StacksDraft

/-- A ring homomorphism with a retraction splits its target as the direct sum of its image and
the kernel of the retraction. -/
theorem isCompl_range_ker_of_comp_eq_id {A B : Type*} [Ring A] [Ring B] (s : A →+* B)
    (e : B →+* A) (h : e.comp s = RingHom.id A) :
    IsCompl s.range.toAddSubgroup (RingHom.ker e).toAddSubgroup := by
  have h' (a : A) : e (s a) = a := RingHom.congr_fun h a
  refine ⟨AddSubgroup.disjoint_def.mpr fun {x} hx hx' => ?_, codisjoint_iff.mpr ?_⟩
  · obtain ⟨a, rfl⟩ := hx
    have h0 : e (s a) = 0 := hx'
    rw [h'] at h0
    rw [h0, map_zero]
  · refine eq_top_iff.mpr fun x _ => AddSubgroup.mem_sup.mpr
      ⟨s (e x), ⟨e x, rfl⟩, x - s (e x), ?_, add_sub_cancel _ _⟩
    show e (x - s (e x)) = 0
    rw [map_sub, h', sub_self]

section PushoutHenselization

variable {A B : CommRingCat.{v}} (s t : A →+* B)

/-- Two ring homomorphisms out of the pushout of two ring homomorphisms which agree on both
inclusions agree. -/
theorem pushout_ringHom_ext {R : Type v} [CommRing R]
    {f g : ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t)) →+* R}
    (hl : f.comp (pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom =
      g.comp (pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom)
    (hr : f.comp (pushout.inr (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom =
      g.comp (pushout.inr (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom) :
    f = g := by
  have h : (CommRingCat.ofHom f : pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t) ⟶
      CommRingCat.of R) = CommRingCat.ofHom g :=
    pushout.hom_ext (CommRingCat.hom_ext hl) (CommRingCat.hom_ext hr)
  exact congrArg CommRingCat.Hom.hom h

/-- The ideal `𝔪_B ⊗ B + B ⊗ 𝔪_B` of `B ⊗_{s, A, t} B`, the pushout of `s` and `t` in
`CommRingCat`: the ideal generated by the images of the maximal ideal of `B` under the two
inclusions. -/
def pushoutMaximalIdeal [IsLocalRing B] :
    Ideal ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t)) :=
  (maximalIdeal B).map (pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom ⊔
    (maximalIdeal B).map (pushout.inr (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom

variable {s t} {e : B →+* A} (hs : e.comp s = RingHom.id A) (ht : e.comp t = RingHom.id A)

/-- The augmentation `B ⊗_{s, A, t} B → A`, `b₁ ⊗ b₂ ↦ e(b₁) e(b₂)`, of a common retraction `e`
of `s` and `t`. -/
def pushoutAugmentation : pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t) ⟶ A :=
  pushout.desc (CommRingCat.ofHom e) (CommRingCat.ofHom e) (CommRingCat.hom_ext
    (RingHom.ext fun a => (RingHom.congr_fun hs a).trans (RingHom.congr_fun ht a).symm))

include hs ht in
/-- The augmentation restricts to the retraction on the first factor. -/
theorem pushoutAugmentation_inl (b : B) :
    (pushoutAugmentation hs ht).hom
      ((pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom b) = e b := by
  show (pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t) ≫
    pushoutAugmentation hs ht).hom b = e b
  rw [pushoutAugmentation, pushout.inl_desc]
  rfl

include hs ht in
/-- The augmentation restricts to the retraction on the second factor. -/
theorem pushoutAugmentation_inr (b : B) :
    (pushoutAugmentation hs ht).hom
      ((pushout.inr (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom b) = e b := by
  show (pushout.inr (CommRingCat.ofHom s) (CommRingCat.ofHom t) ≫
    pushoutAugmentation hs ht).hom b = e b
  rw [pushoutAugmentation, pushout.inr_desc]
  rfl

include hs ht in
/-- The augmentation is surjective: it is split by `a ↦ s(a) ⊗ 1`. -/
theorem pushoutAugmentation_surjective :
    Function.Surjective (pushoutAugmentation hs ht).hom := fun a =>
  ⟨(pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom (s a), by
    rw [pushoutAugmentation_inl hs ht]
    exact RingHom.congr_fun hs a⟩

include hs ht in
/-- **`𝔪_B ⊗ B + B ⊗ 𝔪_B` is the ideal of the augmentation point.**  If the common retraction
`e` of `s` and `t` is local, then `𝔪_B ⊗ B + B ⊗ 𝔪_B` is the preimage of the maximal ideal of
`A` under the augmentation. -/
theorem pushoutMaximalIdeal_eq_comap [IsLocalRing A] [IsLocalRing B] [IsLocalHom e] :
    pushoutMaximalIdeal s t = (maximalIdeal A).comap (pushoutAugmentation hs ht).hom := by
  have hsa (a : A) : e (s a) = a := RingHom.congr_fun hs a
  have hta (a : A) : e (t a) = a := RingHom.congr_fun ht a
  have hcond (a : A) : (pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom (s a) =
      (pushout.inr (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom (t a) :=
    congrArg (fun k => k.hom a)
      (pushout.condition (f := CommRingCat.ofHom s) (g := CommRingCat.ofHom t))
  -- an element killed by the retraction is not a unit
  have hker (b : B) (hb : e b = 0) : b ∈ maximalIdeal B :=
    (mem_maximalIdeal _).mpr fun hu => by
      have := hu.map e
      rw [hb] at this
      exact not_isUnit_zero this
  refine le_antisymm (sup_le ?_ ?_) ?_
  · refine Ideal.map_le_iff_le_comap.mpr fun b hb => ?_
    rw [Ideal.mem_comap, Ideal.mem_comap, pushoutAugmentation_inl hs ht]
    exact map_nonunit e b hb
  · refine Ideal.map_le_iff_le_comap.mpr fun b hb => ?_
    rw [Ideal.mem_comap, Ideal.mem_comap, pushoutAugmentation_inr hs ht]
    exact map_nonunit e b hb
  · intro x hx
    rw [Ideal.mem_comap] at hx
    -- modulo `𝔪_B ⊗ B + B ⊗ 𝔪_B` every element is `s(a) ⊗ 1` for `a` its augmentation
    -- an element and the image of its augmentation agree modulo the ideal
    have hkey (f : B →+* ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t))) (u : A →+* B)
        (hu : ∀ a, e (u a) = a) (hf : (maximalIdeal B).map f ≤ pushoutMaximalIdeal s t) (b : B) :
        Ideal.Quotient.mk (pushoutMaximalIdeal s t) (f b) =
          Ideal.Quotient.mk (pushoutMaximalIdeal s t) (f (u (e b))) :=
      Ideal.Quotient.eq.mpr (by
        rw [← map_sub]
        exact hf (Ideal.mem_map_of_mem _ (hker _ (by rw [map_sub, hu, sub_self]))))
    have hq : Ideal.Quotient.mk (pushoutMaximalIdeal s t) =
        (Ideal.Quotient.mk (pushoutMaximalIdeal s t)).comp
          ((pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom.comp
            (s.comp (pushoutAugmentation hs ht).hom)) := by
      refine pushout_ringHom_ext s t (RingHom.ext fun b => ?_) (RingHom.ext fun b => ?_)
      · simp only [RingHom.comp_apply, pushoutAugmentation_inl hs ht]
        exact hkey _ s hsa le_sup_left b
      · simp only [RingHom.comp_apply, pushoutAugmentation_inr hs ht, hcond]
        exact hkey _ t hta le_sup_right b
    have hs' : s ((pushoutAugmentation hs ht).hom x) ∈ maximalIdeal B :=
      (mem_maximalIdeal _).mpr fun hu =>
        (mem_maximalIdeal _).mp hx (by simpa only [hsa] using hu.map e)
    refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
    rw [show Ideal.Quotient.mk (pushoutMaximalIdeal s t) x =
        Ideal.Quotient.mk (pushoutMaximalIdeal s t)
          ((pushout.inl (CommRingCat.ofHom s) (CommRingCat.ofHom t)).hom
            (s ((pushoutAugmentation hs ht).hom x))) from RingHom.congr_fun hq x]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hs'))

include hs ht in
/-- `𝔪_B ⊗ B + B ⊗ 𝔪_B` is a maximal ideal of `B ⊗_{s, A, t} B`. -/
theorem pushoutMaximalIdeal_isMaximal [IsLocalRing A] [IsLocalRing B] [IsLocalHom e] :
    (pushoutMaximalIdeal s t).IsMaximal := by
  rw [pushoutMaximalIdeal_eq_comap hs ht]
  exact Ideal.comap_isMaximal_of_surjective _ (pushoutAugmentation_surjective hs ht)

include hs ht in
/-- **The localization of `B ⊗_{s, A, t} B` at `𝔪_B ⊗ B + B ⊗ 𝔪_B` has the residue field of
`A`**, so it is separably closed when that of `A` is. -/
theorem isSepClosed_residueField_localization_pushout [IsLocalRing A] [IsLocalRing B] [IsLocalHom e]
    [IsSepClosed (ResidueField A)] [(pushoutMaximalIdeal s t).IsPrime] :
    IsSepClosed (ResidueField (Localization.AtPrime (pushoutMaximalIdeal s t))) := by
  have := pushoutMaximalIdeal_isMaximal hs ht
  set D := Localization.AtPrime (pushoutMaximalIdeal s t)
  have hsurj : Function.Surjective ((residue A).comp (pushoutAugmentation hs ht).hom) :=
    (residue_surjective).comp (pushoutAugmentation_surjective hs ht)
  have hker : pushoutMaximalIdeal s t =
      RingHom.ker ((residue A).comp (pushoutAugmentation hs ht).hom) := by
    rw [pushoutMaximalIdeal_eq_comap hs ht, ← RingHom.comap_ker, ker_residue]
  let e₁ : ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t)) ⧸
      pushoutMaximalIdeal s t ≃+* ResidueField A :=
    (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  let e₂ : ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t)) ⧸
      pushoutMaximalIdeal s t ≃+* D ⧸ maximalIdeal D :=
    IsLocalization.AtPrime.equivQuotMaximalIdeal (pushoutMaximalIdeal s t) D
  exact IsSepClosed.of_ringEquiv (M := ResidueField A) (N := ResidueField D)
    (e₂.symm.trans e₁)

include hs ht in
/-- **A strictly henselian weakly étale algebra over `B ⊗_{s, A, t} B` is the henselization of
its localization at `𝔪_B ⊗ B + B ⊗ 𝔪_B`.**  Let `s, t : A → B` be homomorphisms of local rings
with a common local retraction `e`, let `A` have separably closed residue field, let `C` be a
strictly henselian local ring with a local homomorphism `ε : C → A`, and let
`ψ : B ⊗_{s, A, t} B → C` be weakly étale with `ε ∘ ψ` the augmentation.  Then `ψ` factors
through a local homomorphism `φ` from the localization at `𝔪_B ⊗ B + B ⊗ 𝔪_B`, and `C` is the
henselization of that localization through `φ`. -/
theorem exists_isHenselization_localization_pushout [IsLocalRing A] [IsLocalRing B] [IsLocalHom e]
    [IsSepClosed (ResidueField A)] [(pushoutMaximalIdeal s t).IsPrime]
    {C : CommRingCat.{v}} [HenselianLocalRing C] [IsSepClosed (ResidueField C)]
    (ε : C →+* A) [IsLocalHom ε]
    (ψ : ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t)) →+* C)
    (hw : @Algebra.WeaklyEtale _ _ _ _ ψ.toAlgebra)
    (hψ : ε.comp ψ = (pushoutAugmentation hs ht).hom) :
    ∃ φ : Localization.AtPrime (pushoutMaximalIdeal s t) →+* C,
      φ.comp (algebraMap _ (Localization.AtPrime (pushoutMaximalIdeal s t))) = ψ ∧
        IsLocalHom φ ∧
        @IsLocalRing.IsHenselization (Localization.AtPrime (pushoutMaximalIdeal s t)) _ _
          (ResidueField (Localization.AtPrime (pushoutMaximalIdeal s t))) _ _ C _ _
          φ.toAlgebra := by
  set P := pushoutMaximalIdeal s t
  set T := ↥(pushout (CommRingCat.ofHom s) (CommRingCat.ofHom t))
  set D := Localization.AtPrime P
  have hεψ (x : T) : ε (ψ x) = (pushoutAugmentation hs ht).hom x := RingHom.congr_fun hψ x
  -- an element of `B ⊗_{s, A, t} B` outside `P` has unit augmentation, so unit image in `C`
  have hPc : P = (maximalIdeal A).comap (pushoutAugmentation hs ht).hom :=
    pushoutMaximalIdeal_eq_comap hs ht
  have hP (x : T) : x ∉ P ↔ IsUnit (ε (ψ x)) := by
    rw [hεψ, ← notMem_maximalIdeal, not_iff_not, hPc, Ideal.mem_comap]
  have hunit (y : P.primeCompl) : IsUnit (ψ y) :=
    isUnit_of_map_unit ε _ ((hP y).mp y.property)
  let φ : D →+* C := IsLocalization.lift (M := P.primeCompl) (S := D) hunit
  have hφ : φ.comp (algebraMap T D) = ψ := IsLocalization.lift_comp hunit
  have hφloc : IsLocalHom φ := by
    refine ⟨fun d hd => ?_⟩
    obtain ⟨⟨x, y⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl d
    have hspec := IsLocalization.mk'_spec D x y
    have e₁ : φ (algebraMap T D (y : T)) = ψ y := IsLocalization.lift_eq hunit _
    have e₂ : φ (algebraMap T D x) = ψ x := IsLocalization.lift_eq hunit _
    have hx : IsUnit (ψ x) := by
      have h := hd.mul (hunit y)
      rwa [← e₁, ← map_mul, hspec, e₂] at h
    have hxu : IsUnit (algebraMap T D x) :=
      IsLocalization.map_units D (⟨x, (hP x).mpr (hx.map ε)⟩ : P.primeCompl)
    rw [← hspec] at hxu
    exact isUnit_of_mul_isUnit_left hxu
  let : Algebra D C := φ.toAlgebra
  let : Algebra T C := ψ.toAlgebra
  have : IsScalarTower T D C :=
    IsScalarTower.of_algebraMap_eq fun x => (RingHom.congr_fun hφ x).symm
  have : IsLocalHom (algebraMap D C) := hφloc
  have : Algebra.WeaklyEtale T C := hw
  have hTD : Algebra.WeaklyEtale T D :=
    (weaklyEtale_of_isLocalization_etale_filteredColimit.{v, v, v} T).1 D P.primeCompl
  have : Algebra.WeaklyEtale D C := weaklyEtale_of_comp T D C hTD inferInstance
  have : IsSepClosed (ResidueField D) := isSepClosed_residueField_localization_pushout hs ht
  have : IsLocalRing.IsHenselization D (SeparableClosure (ResidueField D)) C :=
    IsLocalRing.IsHenselization.of_weaklyEtale
  exact ⟨φ, hφ, hφloc, IsLocalRing.IsHenselization.of_algEquiv
    (IsSepClosure.equiv (ResidueField D) (ResidueField D) (SeparableClosure (ResidueField D)))⟩

end PushoutHenselization

end StacksDraft

namespace AlgebraicGeometry.GroupoidInAlgebraicSpaces

open StacksDraft

variable {C : BigFppfSite.{u}} {S : Scheme.{u}} {hS : C.Contains S}
  {B : AlgebraicSpaces C S hS} (G : GroupoidInAlgebraicSpaces C S hS B)

/-! ### The morphism `(e, e)` and the homomorphism it induces -/

/-- The morphism `(e, e) : U ⟶ R ×_{s, U, t} R` pairing the identity arrow at an object with
itself. -/
def identityPairMorphism : G.objects.obj ⟶ pullback G.source.hom G.target.hom :=
  pullback.lift (identityArrow G).hom (identityArrow G).hom (by
    rw [identityArrow_hom_comp_source, identityArrow_hom_comp_target])

/-- The identity section `a ↦ (a, e(s a))` restricted to identity arrows is `(e, e)`. -/
theorem identityArrow_comp_identitySectionAfterSource :
    (identityArrow G).hom ≫ identitySectionAfterSource G = identityPairMorphism G := by
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, identitySectionAfterSource_comp_fst, Category.comp_id,
      identityPairMorphism, pullback.lift_fst]
  · rw [Category.assoc, identitySectionAfterSource_comp_snd, identityArrow_comp_sourceIdentity,
      identityPairMorphism, pullback.lift_snd]

variable (z : Space.GeometricPoint C S hS G.objects.obj)

/-- `(e, e)` carries a geometric point `ū` of the object space to the geometric point
`(e, e)(ū)` of the space of composable pairs. -/
theorem geometricPointMap_identityPairMorphism :
    Space.geometricPointMap (identityPairMorphism G) z = identityPairPoint G z :=
  congrArg (fun k => Space.geometricPointMap k z)
    (identityArrow_comp_identitySectionAfterSource G).symm

/-- The homomorphism `(e, e) : C → A` of étale local rings induced by `(e, e)`. -/
def identityPairStalk :
    Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom) (identityPairPoint G z) →+*
      Space.etaleLocalRing C S hS G.objects.obj z :=
  (Space.etaleLocalRingMap G.objects.property (identityPairMorphism G) z).comp
    (Space.etaleLocalRingCongr (geometricPointMap_identityPairMorphism G z)).symm.toRingHom

/-- `(e, e) : C → A` is the unit `e` after the retraction carried by `a ↦ (a, e(s a))`. -/
theorem identityPairStalk_eq :
    identityPairStalk G z = (identityStalk G z).comp (identityPairFst G z) :=
  RingHom.ext fun m => (Space.comp_etaleLocalRingMap_apply_of_eq G.objects.property
      G.arrows.property (identityArrow G).hom (identitySectionAfterSource G)
      (identityPairMorphism G) (identityArrow_comp_identitySectionAfterSource G) z
      (identityArrowPoint G z) rfl (identityPairPoint G z) rfl
      (geometricPointMap_identityPairMorphism G z) m).symm

/-! ### The étale local rings are strictly henselian, and the homomorphisms are local -/

/-- The étale local ring `A` of the object space at a geometric point is strictly henselian. -/
instance strictlyHenselianLocalRing_objects :
    StrictlyHenselianLocalRing (Space.etaleLocalRing C S hS G.objects.obj z) :=
  Space.strictlyHenselianLocalRing_etaleLocalRing C S hS G.objects.obj G.objects.property z

/-- The étale local ring of the arrow space at a geometric point is strictly henselian. -/
instance strictlyHenselianLocalRing_arrows (x : Space.GeometricPoint C S hS G.arrows.obj) :
    StrictlyHenselianLocalRing (Space.etaleLocalRing C S hS G.arrows.obj x) :=
  Space.strictlyHenselianLocalRing_etaleLocalRing C S hS G.arrows.obj G.arrows.property x

/-- The étale local ring of the space of composable pairs at a geometric point is strictly
henselian. -/
instance strictlyHenselianLocalRing_composablePairs
    (x : Space.GeometricPoint C S hS (pullback G.source.hom G.target.hom)) :
    StrictlyHenselianLocalRing
      (Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom) x) :=
  Space.strictlyHenselianLocalRing_etaleLocalRing C S hS _ (isAlgebraicSpace_composablePairs G)
    x

/-- The homomorphism `s : A → B` induced by the source is local. -/
instance isLocalHom_sourceStalk : IsLocalHom (sourceStalk G z) := by
  have h₁ := Space.isLocalHom_etaleLocalRingMap C S hS G.arrows.property G.objects.property
    G.source.hom (identityArrowPoint G z)
  have h₂ := Space.isLocalHom_ringEquiv
    (Space.etaleLocalRingCongr (geometricPointMap_source_identityArrowPoint G z)).symm
  unfold sourceStalk
  exact @RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ h₁ h₂

/-- The homomorphism `t : A → B` induced by the target is local. -/
instance isLocalHom_targetStalk : IsLocalHom (targetStalk G z) := by
  have h₁ := Space.isLocalHom_etaleLocalRingMap C S hS G.arrows.property G.objects.property
    G.target.hom (identityArrowPoint G z)
  have h₂ := Space.isLocalHom_ringEquiv
    (Space.etaleLocalRingCongr (geometricPointMap_target_identityArrowPoint G z)).symm
  unfold targetStalk
  exact @RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ h₁ h₂

/-- The homomorphism `e : B → A` induced by the unit is local. -/
instance isLocalHom_identityStalk : IsLocalHom (identityStalk G z) :=
  Space.isLocalHom_etaleLocalRingMap C S hS G.objects.property G.arrows.property
    (identityArrow G).hom z

/-- The endomorphism `i : B → B` induced by inversion is local. -/
instance isLocalHom_inverseStalk : IsLocalHom (inverseStalk G z) := by
  have h₁ := Space.isLocalHom_etaleLocalRingMap C S hS G.arrows.property G.arrows.property
    (groupoidInverse G) (identityArrowPoint G z)
  have h₂ := Space.isLocalHom_ringEquiv
    (Space.etaleLocalRingCongr (geometricPointMap_groupoidInverse_identityArrowPoint G z)).symm
  unfold inverseStalk
  exact @RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ h₁ h₂

/-- The homomorphism `c : B → C` induced by the composition law is local. -/
instance isLocalHom_identityPairComp : IsLocalHom (identityPairComp G z) := by
  have h₁ := Space.isLocalHom_etaleLocalRingMap C S hS (isAlgebraicSpace_composablePairs G)
    G.arrows.property G.comp.hom (identityPairPoint G z)
  have h₂ := Space.isLocalHom_ringEquiv
    (Space.etaleLocalRingCongr (geometricPointMap_comp_identityPairPoint G z)).symm
  unfold identityPairComp
  exact @RingHom.isLocalHom_comp _ _ _ _ _ _ _ _ h₁ h₂

/-- The homomorphism `C → B` induced by the identity section `a ↦ (a, e(s a))` is local. -/
instance isLocalHom_identityPairFst : IsLocalHom (identityPairFst G z) :=
  Space.isLocalHom_etaleLocalRingMap C S hS G.arrows.property
    (isAlgebraicSpace_composablePairs G) (identitySectionAfterSource G) (identityArrowPoint G z)

/-- The homomorphism `(e, e) : C → A` is local. -/
instance isLocalHom_identityPairStalk : IsLocalHom (identityPairStalk G z) := by
  rw [identityPairStalk_eq]
  exact RingHom.isLocalHom_comp _ _

/-! ### The tensor square `B ⊗_{s, A, t} B` -/

/-- The ideal `𝔪_B ⊗ B + B ⊗ 𝔪_B` of `B ⊗_{s, A, t} B` is maximal. -/
instance isMaximal_pushoutMaximalIdeal :
    (pushoutMaximalIdeal (sourceStalk G z) (targetStalk G z)).IsMaximal :=
  pushoutMaximalIdeal_isMaximal (identityStalk_comp_sourceStalk G z)
    (identityStalk_comp_targetStalk G z)

/-- The two projections agree after the source and the target: `pr₁ ∘ s = pr₂ ∘ t` as maps
`A → C`. -/
theorem identityPairLeft_comp_sourceStalk :
    (identityPairLeft G z).comp (sourceStalk G z) =
      (identityPairRight G z).comp (targetStalk G z) :=
  RingHom.ext fun m =>
    Space.comp_etaleLocalRingMap_apply_of_factors (isAlgebraicSpace_composablePairs G)
      G.arrows.property G.arrows.property (pullback.fst G.source.hom G.target.hom) G.source.hom
      (pullback.snd G.source.hom G.target.hom) G.target.hom pullback.condition
      (identityPairPoint G z) (identityArrowPoint G z)
      (geometricPointMap_fst_identityPairPoint G z) (identityArrowPoint G z)
      (geometricPointMap_snd_identityPairPoint G z) z
      (geometricPointMap_source_identityArrowPoint G z)
      (geometricPointMap_target_identityArrowPoint G z) m

/-- The homomorphism `B ⊗_{s, A, t} B → C`, `b₁ ⊗ b₂ ↦ pr₁(b₁) pr₂(b₂)`, induced by the two
projections of the space of composable pairs. -/
def identityPairTensorMap :
    ↥(pushout (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z))) →+*
      Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom) (identityPairPoint G z) :=
  (pushout.desc (CommRingCat.ofHom (identityPairLeft G z))
    (CommRingCat.ofHom (identityPairRight G z))
    (CommRingCat.hom_ext (identityPairLeft_comp_sourceStalk G z))).hom

/-- `B ⊗_{s, A, t} B → C` restricts to the first projection on the first factor. -/
theorem identityPairTensorMap_comp_inl :
    (identityPairTensorMap G z).comp (pushout.inl (CommRingCat.ofHom (sourceStalk G z))
      (CommRingCat.ofHom (targetStalk G z))).hom = identityPairLeft G z :=
  congrArg CommRingCat.Hom.hom (pushout.inl_desc (CommRingCat.ofHom (identityPairLeft G z))
    (CommRingCat.ofHom (identityPairRight G z))
    (CommRingCat.hom_ext (identityPairLeft_comp_sourceStalk G z)))

/-- `B ⊗_{s, A, t} B → C` restricts to the second projection on the second factor. -/
theorem identityPairTensorMap_comp_inr :
    (identityPairTensorMap G z).comp (pushout.inr (CommRingCat.ofHom (sourceStalk G z))
      (CommRingCat.ofHom (targetStalk G z))).hom = identityPairRight G z :=
  congrArg CommRingCat.Hom.hom (pushout.inr_desc (CommRingCat.ofHom (identityPairLeft G z))
    (CommRingCat.ofHom (identityPairRight G z))
    (CommRingCat.hom_ext (identityPairLeft_comp_sourceStalk G z)))

/-- **`C` is weakly étale over `B ⊗_{s, A, t} B`.**  The homomorphism
`B ⊗_{s, A, t} B → C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}` restricting to the two projections on the
two factors is weakly étale.  This is
`AlgebraicGeometry.Space.cartesian_etaleStalk_tensor_weaklyEtale` for the cartesian square of the
space of composable pairs, read at `(e, e)(ū)` and transported to the étale local rings at
`e(ū)` and `ū`. -/
theorem exists_pushout_weaklyEtale :
    ∃ ψ : ↥(pushout (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z)))
        →+* Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom)
          (identityPairPoint G z),
      ψ.comp (pushout.inl (CommRingCat.ofHom (sourceStalk G z))
          (CommRingCat.ofHom (targetStalk G z))).hom = identityPairLeft G z ∧
        ψ.comp (pushout.inr (CommRingCat.ofHom (sourceStalk G z))
          (CommRingCat.ofHom (targetStalk G z))).hom = identityPairRight G z ∧
        @Algebra.WeaklyEtale _ _ _ _ ψ.toAlgebra := by
  have hpb := AlgebraicSpaces.isPullback_fiberProduct C S hS G.source G.target
  let x' := identityPairPoint G z
  let y₁ := Space.geometricPointMap (pullback.fst G.source.hom G.target.hom) x'
  let y₂ := Space.geometricPointMap (pullback.snd G.source.hom G.target.hom) x'
  let w₀ := Space.geometricPointMap G.source.hom y₁
  let w₂ := Space.geometricPointMap G.target.hom y₂
  have h : w₀ = w₂ := congrArg
    (fun k : AlgebraicSpaces.fiberProduct C S hS G.source G.target ⟶ G.objects =>
      Space.geometricPointMap k.hom x') hpb.w
  have hfst : y₁ = identityArrowPoint G z := geometricPointMap_fst_identityPairPoint G z
  have hsnd : y₂ = identityArrowPoint G z := geometricPointMap_snd_identityPairPoint G z
  have hsrc : Space.geometricPointMap G.source.hom (identityArrowPoint G z) = z :=
    geometricPointMap_source_identityArrowPoint G z
  have htgt : Space.geometricPointMap G.target.hom (identityArrowPoint G z) = z :=
    geometricPointMap_target_identityArrowPoint G z
  have hw₀ : w₀ = z := (congrArg (Space.geometricPointMap G.source.hom) hfst).trans hsrc
  set cA : Space.etaleLocalRing C S hS G.objects.obj w₀ ≃+*
      Space.etaleLocalRing C S hS G.objects.obj z := Space.etaleLocalRingCongr hw₀ with hcA
  let : Algebra (Space.etaleLocalRing C S hS G.objects.obj w₀)
      (Space.etaleLocalRing C S hS G.arrows.obj y₁) :=
    (Space.etaleLocalRingMap G.arrows.property G.source.hom y₁).toAlgebra
  let : Algebra (Space.etaleLocalRing C S hS G.objects.obj w₀)
      (Space.etaleLocalRing C S hS G.arrows.obj y₂) :=
    ((eqToHom (congrArg (Space.etaleLocalRing C S hS G.objects.obj) h) ≫
      CommRingCat.ofHom
        (Space.etaleLocalRingMap G.arrows.property G.target.hom y₂)).hom).toAlgebra
  have hcart : ∃ φ : TensorProduct (Space.etaleLocalRing C S hS G.objects.obj w₀)
        (Space.etaleLocalRing C S hS G.arrows.obj y₁)
        (Space.etaleLocalRing C S hS G.arrows.obj y₂) →+*
        Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom) x',
      φ.comp Algebra.TensorProduct.includeLeftRingHom =
          Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
            (pullback.fst G.source.hom G.target.hom) x' ∧
        φ.comp Algebra.TensorProduct.includeRight.toRingHom =
          Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
            (pullback.snd G.source.hom G.target.hom) x' ∧
        @Algebra.WeaklyEtale _ _ _ _ φ.toAlgebra :=
    Space.cartesian_etaleStalk_tensor_weaklyEtale C S hS _ _ G.source G.target hpb x'
  obtain ⟨φ, hφl, hφr, hφw⟩ := hcart
  have key {a b : Space.GeometricPoint C S hS G.objects.obj} (hab : a = b)
      (c : Space.etaleLocalRing C S hS G.objects.obj a) :
      (eqToHom (congrArg (Space.etaleLocalRing C S hS G.objects.obj) hab)).hom c =
        Space.etaleLocalRingCongr hab c := by
    subst hab
    rfl
  -- the structure maps of the two factors are the source and target homomorphisms
  have hA (a : Space.etaleLocalRing C S hS G.objects.obj w₀) :
      Space.etaleLocalRingCongr hfst
          ((Space.etaleLocalRingMap G.arrows.property G.source.hom y₁) a) =
        sourceStalk G z (cA a) := by
    have hcp := Space.etaleLocalRingMap_congr_point G.arrows.property G.source.hom hfst
      ((Space.etaleLocalRingCongr hsrc).symm (cA a))
    have ha : (Space.etaleLocalRingCongr
        (congrArg (Space.geometricPointMap G.source.hom) hfst)).symm
        ((Space.etaleLocalRingCongr hsrc).symm (cA a)) = a := by
      rw [Space.etaleLocalRingCongr_symm, Space.etaleLocalRingCongr_symm, hcA,
        Space.etaleLocalRingCongr_trans, Space.etaleLocalRingCongr_trans]
      rfl
    rw [ha] at hcp
    rw [hcp, RingEquiv.apply_symm_apply, sourceStalk, RingHom.comp_apply]
    rfl
  have hB (a : Space.etaleLocalRing C S hS G.objects.obj w₀) :
      Space.etaleLocalRingCongr hsnd
          ((Space.etaleLocalRingMap G.arrows.property G.target.hom y₂)
            ((eqToHom (congrArg (Space.etaleLocalRing C S hS G.objects.obj) h)).hom a)) =
        targetStalk G z (cA a) := by
    have hcp := Space.etaleLocalRingMap_congr_point G.arrows.property G.target.hom hsnd
      ((Space.etaleLocalRingCongr htgt).symm (cA a))
    have ha : (Space.etaleLocalRingCongr
        (congrArg (Space.geometricPointMap G.target.hom) hsnd)).symm
        ((Space.etaleLocalRingCongr htgt).symm (cA a)) = Space.etaleLocalRingCongr h a := by
      rw [Space.etaleLocalRingCongr_symm, Space.etaleLocalRingCongr_symm, hcA,
        Space.etaleLocalRingCongr_trans, Space.etaleLocalRingCongr_trans]
    rw [ha] at hcp
    rw [key h a, hcp, RingEquiv.apply_symm_apply, targetStalk, RingHom.comp_apply]
    rfl
  -- the tensor product is a pushout of `s` and `t`
  let e₁ := cA.toCommRingCatIso
  let e₂ := (Space.etaleLocalRingCongr hfst).toCommRingCatIso
  let e₃ := (Space.etaleLocalRingCongr hsnd).toCommRingCatIso
  have hP : IsPushout (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z))
      (e₂.inv ≫ CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
      (e₃.inv ≫ CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) :=
    (CommRingCat.isPushout_tensorProduct _ _ _).of_iso e₁ e₂ e₃ (Iso.refl _)
      (CommRingCat.hom_ext (RingHom.ext hA))
      (CommRingCat.hom_ext (RingHom.ext hB)) (by simp) (by simp)
  let iso := hP.isoPushout
  refine ⟨φ.comp iso.inv.hom, RingHom.ext fun b => ?_, RingHom.ext fun b => ?_, ?_⟩
  · exact (congrArg φ (congrArg (fun k => k.hom b) hP.inl_isoPushout_inv)).trans
      (RingHom.congr_fun hφl _)
  · exact (congrArg φ (congrArg (fun k => k.hom b) hP.inr_isoPushout_inv)).trans
      (RingHom.congr_fun hφr _)
  · have hcomp : ((RingEquiv.refl _).toRingHom.comp (φ.comp iso.inv.hom)).comp
        iso.commRingCatIsoToRingEquiv.toRingHom = φ :=
      RingHom.ext fun x => congrArg φ (congrArg (fun k => k.hom x) iso.hom_inv_id)
    refine Space.weaklyEtale_of_comp_ringEquiv _ iso.commRingCatIsoToRingEquiv
      (RingEquiv.refl _) ?_
    rw [hcomp]
    exact hφw

/-- **`C` is weakly étale over `B ⊗_{s, A, t} B`** through `b₁ ⊗ b₂ ↦ pr₁(b₁) pr₂(b₂)`. -/
theorem weaklyEtale_identityPairTensorMap :
    @Algebra.WeaklyEtale _ _ _ _ (identityPairTensorMap G z).toAlgebra := by
  obtain ⟨ψ, hψl, hψr, hψw⟩ := exists_pushout_weaklyEtale G z
  rwa [show identityPairTensorMap G z = ψ from pushout_ringHom_ext _ _
    ((identityPairTensorMap_comp_inl G z).trans hψl.symm)
    ((identityPairTensorMap_comp_inr G z).trans hψr.symm)]

/-! ### Stacks 0CK9 -/

/-- **Stacks 0CK9 (Local structure).**  Let `(U, R, s, t, c, e, i)` be a groupoid in algebraic
spaces over `S`, let `ū` be a geometric point of `U`, and let `A = 𝒪_{U, ū}`,
`B = 𝒪_{R, e(ū)}` and `C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}` be the étale local rings, with the
homomorphisms `s, t : A → B`, `c : B → C`, `e : B → A`, `i : B → B` and `(e, e) : C → A` induced
by the structure morphisms.  Then:

1. `A`, `B`, `C` are local rings and `s, t, c, e, i, (e, e)` are local homomorphisms;
2. `e ∘ t = 1` and `e ∘ s = 1`;
3. `B = s(A) ⊕ I = t(A) ⊕ I` for `I = ker (e : B → A)`;
4. `𝔪_B ⊗ B + B ⊗ 𝔪_B` is a maximal ideal of `B ⊗_{s, A, t} B`, the localization at it has
   separably closed residue field, and `C` is the henselization of that localization through
   the homomorphism induced by `b₁ ⊗ b₂ ↦ pr₁(b₁) pr₂(b₂)`;
5. the ideal `J` of `C` generated by `I ⊗ B + B ⊗ I` is the kernel of `(e, e) : C → A`;
6. `c` sends `I` into `J`. -/
@[stacks 0CK9 "The whole section, for the etale local rings A = O_{U,u-bar}, B = O_{R,e(u-bar)} \
and C = O_{R x_{s,U,t} R,(e,e)(u-bar)} of a groupoid in algebraic spaces at a geometric point \
u-bar: (1) A, B, C are local and the maps s, t, c, e, i, (e,e) they induce are local \
homomorphisms; (2) e . t = 1 = e . s; (3) B = s(A) + I = t(A) + I as direct sums, I = ker e; \
(4) m_B (x) B + B (x) m_B is a maximal ideal of B (x)_{s,A,t} B (the pushout of s and t in \
CommRingCat), the localization at it has separably closed residue field, and C is the \
henselization of that localization through the map induced by b1 (x) b2 -> pr1(b1) pr2(b2); \
(5) the ideal J of C generated by I (x) B + B (x) I is the kernel of (e,e) : C -> A; \
(6) c : B -> C sends I into J."]
theorem localStructure :
    (IsLocalRing (Space.etaleLocalRing C S hS G.objects.obj z) ∧
      IsLocalRing (Space.etaleLocalRing C S hS G.arrows.obj (identityArrowPoint G z)) ∧
      IsLocalRing (Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom)
        (identityPairPoint G z)) ∧
      IsLocalHom (sourceStalk G z) ∧ IsLocalHom (targetStalk G z) ∧
      IsLocalHom (identityPairComp G z) ∧ IsLocalHom (identityStalk G z) ∧
      IsLocalHom (inverseStalk G z) ∧ IsLocalHom (identityPairStalk G z)) ∧
    ((identityStalk G z).comp (targetStalk G z) = RingHom.id _ ∧
      (identityStalk G z).comp (sourceStalk G z) = RingHom.id _) ∧
    (IsCompl (sourceStalk G z).range.toAddSubgroup
        (RingHom.ker (identityStalk G z)).toAddSubgroup ∧
      IsCompl (targetStalk G z).range.toAddSubgroup
        (RingHom.ker (identityStalk G z)).toAddSubgroup) ∧
    ((pushoutMaximalIdeal (sourceStalk G z) (targetStalk G z)).IsMaximal ∧
      IsSepClosed (ResidueField
        (Localization.AtPrime (pushoutMaximalIdeal (sourceStalk G z) (targetStalk G z)))) ∧
      ∃ φ : Localization.AtPrime (pushoutMaximalIdeal (sourceStalk G z) (targetStalk G z)) →+*
          Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom)
            (identityPairPoint G z),
        φ.comp (algebraMap _ _) = identityPairTensorMap G z ∧ IsLocalHom φ ∧
        @IsLocalRing.IsHenselization
          (Localization.AtPrime (pushoutMaximalIdeal (sourceStalk G z) (targetStalk G z))) _ _
          (ResidueField
            (Localization.AtPrime (pushoutMaximalIdeal (sourceStalk G z) (targetStalk G z))))
          _ _ (Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom)
            (identityPairPoint G z)) _ _ φ.toAlgebra) ∧
    RingHom.ker (identityPairStalk G z) =
      ((RingHom.ker (identityStalk G z)).map (pushout.inl (CommRingCat.ofHom (sourceStalk G z))
          (CommRingCat.ofHom (targetStalk G z))).hom ⊔
        (RingHom.ker (identityStalk G z)).map (pushout.inr
          (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z))).hom).map
        (identityPairTensorMap G z) ∧
    (RingHom.ker (identityStalk G z)).map (identityPairComp G z) ≤
      ((RingHom.ker (identityStalk G z)).map (pushout.inl (CommRingCat.ofHom (sourceStalk G z))
          (CommRingCat.ofHom (targetStalk G z))).hom ⊔
        (RingHom.ker (identityStalk G z)).map (pushout.inr
          (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z))).hom).map
        (identityPairTensorMap G z) := by
  have hs := identityStalk_comp_sourceStalk G z
  have ht := identityStalk_comp_targetStalk G z
  -- the ideal generated by `I ⊗ B + B ⊗ I` is the one generated by the two images of `I`
  have hJ : ((RingHom.ker (identityStalk G z)).map (pushout.inl
        (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z))).hom ⊔
      (RingHom.ker (identityStalk G z)).map (pushout.inr
        (CommRingCat.ofHom (sourceStalk G z)) (CommRingCat.ofHom (targetStalk G z))).hom).map
        (identityPairTensorMap G z) =
      (RingHom.ker (identityStalk G z)).map (identityPairLeft G z) ⊔
        (RingHom.ker (identityStalk G z)).map (identityPairRight G z) := by
    rw [Ideal.map_sup, Ideal.map_map, Ideal.map_map, identityPairTensorMap_comp_inl,
      identityPairTensorMap_comp_inr]
  -- `(e, e) : C → A` after `B ⊗_{s, A, t} B → C` is the augmentation `b₁ ⊗ b₂ ↦ e(b₁) e(b₂)`
  have hψ : (identityPairStalk G z).comp (identityPairTensorMap G z) =
      (pushoutAugmentation hs ht).hom := by
    refine pushout_ringHom_ext _ _ (RingHom.ext fun b => ?_) (RingHom.ext fun b => ?_)
    · have h1 : identityPairTensorMap G z ((pushout.inl (CommRingCat.ofHom (sourceStalk G z))
          (CommRingCat.ofHom (targetStalk G z))).hom b) = identityPairLeft G z b :=
        RingHom.congr_fun (identityPairTensorMap_comp_inl G z) b
      have h2 : identityPairFst G z (identityPairLeft G z b) = b :=
        RingHom.congr_fun (identityPairFst_comp_identityPairLeft G z) b
      show identityPairStalk G z (identityPairTensorMap G z _) =
        (pushoutAugmentation hs ht).hom _
      rw [pushoutAugmentation_inl hs ht, h1, identityPairStalk_eq, RingHom.comp_apply, h2]
    · have h1 : identityPairTensorMap G z ((pushout.inr (CommRingCat.ofHom (sourceStalk G z))
          (CommRingCat.ofHom (targetStalk G z))).hom b) = identityPairRight G z b :=
        RingHom.congr_fun (identityPairTensorMap_comp_inr G z) b
      have h2 : identityPairFst G z (identityPairRight G z b) =
          sourceStalk G z (identityStalk G z b) :=
        RingHom.congr_fun (identityPairFst_comp_identityPairRight_eq G z) b
      have h3 : identityStalk G z (sourceStalk G z (identityStalk G z b)) = identityStalk G z b :=
        RingHom.congr_fun hs _
      show identityPairStalk G z (identityPairTensorMap G z _) =
        (pushoutAugmentation hs ht).hom _
      rw [pushoutAugmentation_inr hs ht, h1, identityPairStalk_eq, RingHom.comp_apply, h2, h3]
  obtain ⟨φ, hφ, hφloc, hφh⟩ := exists_isHenselization_localization_pushout hs ht
    (identityPairStalk G z) (identityPairTensorMap G z) (weaklyEtale_identityPairTensorMap G z) hψ
  refine ⟨⟨inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, inferInstance⟩, ⟨ht, hs⟩,
    ⟨isCompl_range_ker_of_comp_eq_id _ _ hs, isCompl_range_ker_of_comp_eq_id _ _ ht⟩,
    ⟨inferInstance, isSepClosed_residueField_localization_pushout hs ht, φ, hφ, hφloc, hφh⟩,
    ?_, ?_⟩
  · rw [hJ, identityPairStalk_eq]
    exact geometricPairIdeal_eq_sup G z
  · rw [hJ, ← geometricPairIdeal_eq_sup G z, Ideal.map_le_iff_le_comap]
    exact fun x hx => identityPairComp_mem_pairIdeal G z hx

end AlgebraicGeometry.GroupoidInAlgebraicSpaces

end
