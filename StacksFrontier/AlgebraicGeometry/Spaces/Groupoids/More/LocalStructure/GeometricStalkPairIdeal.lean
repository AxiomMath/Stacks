module

public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.LocalStructure.PullbackStalkKernel
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleLocalRingFibreProduct
public import StacksFrontier.RingTheory.WeaklyEtale.StrictlyHenselian

/-!
# The ideal of a retraction through a weakly étale homomorphism

Let `φ : T ⟶ D` be a weakly étale homomorphism into a local ring, let `A` be a henselian local
ring with separably closed residue field, and let `ε : D ⟶ A` be a homomorphism such that
`ε ∘ φ` admits a section.  Then **the kernel of `ε` is generated by the kernel of `ε ∘ φ`**:
nothing is cut out upstairs beyond what is already cut out on `T`.

The reason is that `D ⧸ (ker (ε ∘ φ))·D` is a weakly étale `A`-algebra, because weak étaleness
is stable under base change and that quotient is the base change of `D` along
`T ⟶ T ⧸ ker (ε ∘ φ) ≅ A`; it is local, being a quotient of `D`; and the section makes
`A ⟶ D ⧸ (ker (ε ∘ φ))·D` a local homomorphism.  So its structure map is bijective by
Stacks 092Z, hence the retraction it carries is injective and the quotient sees nothing of
`ker ε` beyond `(ker (ε ∘ φ))·D`.

## Main results

* `StacksDraft.ker_eq_map_of_weaklyEtale_of_sepClosed`: the statement above.

## Implementation notes

The hypothesis is `Algebra.WeaklyEtale` for `φ.toAlgebra` rather than for an ambient instance,
which is the form `AlgebraicGeometry.Space.cartesian_etaleStalk_tensor_weaklyEtale` produces.
Transporting weak étaleness onto the quotient uses
`AlgebraicGeometry.Space.weaklyEtale_of_comp_ringEquiv` together with
`Algebra.TensorProduct.quotIdealMapEquivQuotTensor`, and the two algebra structures that then
have to be compared are identified by `Algebra.algebra_ext`, their `algebraMap`s agreeing
because `t - ι (ε (φ t))` lies in `ker (ε ∘ φ)` for every `t`.

## References

* [Stacks Project, Tag 092Z](https://stacks.math.columbia.edu/tag/092Z)
* [Stacks Project, Tag 092H](https://stacks.math.columbia.edu/tag/092H)
-/

@[expose] public section

open IsLocalRing
open scoped TensorProduct

universe u v w

namespace StacksDraft

/-- A retraction of a bijective ring homomorphism is injective. -/
theorem injective_of_bijective_of_retraction {A Q : Type*} [CommRing A] [CommRing Q]
    (κ : A →+* Q) (σ : Q →+* A) (hσκ : ∀ a, σ (κ a) = a) (hbij : Function.Bijective κ) :
    Function.Injective σ := by
  intro x y hxy
  obtain ⟨a, rfl⟩ := hbij.2 x
  obtain ⟨b, rfl⟩ := hbij.2 y
  rw [hσκ a, hσκ b] at hxy
  exact congrArg κ hxy

/-- **The ideal of a retraction through a weakly étale homomorphism.**  Let `φ : T →+* D` be
weakly étale with `D` local, let `A` be a henselian local ring with separably closed residue
field, and let `ε : D →+* A` be a homomorphism such that `ε ∘ φ` has a section `ι`.  Then the
kernel of `ε` is generated by the kernel of `ε ∘ φ`. -/
theorem ker_eq_map_of_weaklyEtale_of_sepClosed
    {A : Type u} {T : Type v} {D : Type w} [CommRing A] [CommRing T] [CommRing D]
    [HenselianLocalRing A] [IsSepClosed (ResidueField A)] [IsLocalRing D]
    (φ : T →+* D) (ε : D →+* A) (ι : A →+* T)
    (hw : @Algebra.WeaklyEtale T D _ _ φ.toAlgebra)
    (hsec : ∀ a, ε (φ (ι a)) = a) :
    RingHom.ker ε = (RingHom.ker (ε.comp φ)).map φ := by
  let : Algebra T D := φ.toAlgebra
  let : Algebra.WeaklyEtale T D := hw
  have halgTD (t : T) : algebraMap T D t = φ t := rfl
  have hJle : (RingHom.ker (ε.comp φ)).map φ ≤ RingHom.ker ε := by
    rw [Ideal.map_le_iff_le_comap, RingHom.comap_ker]
  refine le_antisymm ?_ hJle
  have hρsurj : Function.Surjective (ε.comp φ) := fun a => ⟨ι a, hsec a⟩
  -- the quotient of `D` by the ideal generated by `ker (ε ∘ φ)`, with the retraction `σ`
  -- carried by `ε` and the section `κ` carried by `ι`
  set J : Ideal D := (RingHom.ker (ε.comp φ)).map φ with hJ
  set σ : (D ⧸ J) →+* A :=
    Ideal.Quotient.lift J ε (fun x hx => RingHom.mem_ker.mp (hJle hx)) with hσ
  set κ : A →+* (D ⧸ J) := (Ideal.Quotient.mk J).comp (φ.comp ι) with hκ
  have hσmk (d : D) : σ (Ideal.Quotient.mk J d) = ε d := rfl
  have hκε (a : A) : σ (κ a) = a := hsec a
  have : Nontrivial (D ⧸ J) := by
    refine ⟨⟨κ 0, κ 1, fun h => ?_⟩⟩
    have h0 := hκε 0
    rw [h, hκε 1] at h0
    exact one_ne_zero h0
  have : IsLocalRing (D ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  have hlocκ : IsLocalHom κ := ⟨fun a h => by
    have h' := h.map σ
    rwa [hκε a] at h'⟩
  let : Algebra A (D ⧸ J) := κ.toAlgebra
  have halgκ (a : A) : algebraMap A (D ⧸ J) a = κ a := rfl
  have : IsLocalHom (algebraMap A (D ⧸ J)) := hlocκ
  -- the quotient is weakly étale over `A`, being the base change of `D` along
  -- `T ⟶ T ⧸ ker (ε ∘ φ) ≅ A`
  have hwQ : Algebra.WeaklyEtale A (D ⧸ J) := by
    set eA : (T ⧸ RingHom.ker (ε.comp φ)) ≃+* A :=
      RingHom.quotientKerEquivOfSurjective hρsurj with heA
    set eT : (D ⧸ J) ≃+* (T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D :=
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor D
        (RingHom.ker (ε.comp φ))).toRingEquiv with heT
    have hcomp (x : T ⧸ RingHom.ker (ε.comp φ)) :
        ((eT.toRingHom.comp κ).comp eA.toRingHom) x =
          algebraMap (T ⧸ RingHom.ker (ε.comp φ))
            ((T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D) x := by
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hmk : eA.toRingHom (Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) t) = ε (φ t) :=
        RingHom.quotientKerEquivOfSurjective_apply_mk hρsurj t
      have hu : Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) (ι (ε (φ t))) =
          Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) t := by
        refine Ideal.Quotient.eq.mpr ?_
        rw [RingHom.mem_ker, map_sub]
        change ε (φ (ι (ε (φ t)))) - ε (φ t) = 0
        rw [hsec (ε (φ t))]
        exact sub_self _
      have hkey (u : T) :
          (1 : T ⧸ RingHom.ker (ε.comp φ)) ⊗ₜ[T] (φ u) =
            (Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) u) ⊗ₜ[T] (1 : D) := by
        have h1 : (1 : T ⧸ RingHom.ker (ε.comp φ)) ⊗ₜ[T] (φ u) =
            algebraMap T ((T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D) u :=
          (Algebra.TensorProduct.algebraMap_apply' (R := T)
            (A := T ⧸ RingHom.ker (ε.comp φ)) (B := D) u).symm
        rw [h1, IsScalarTower.algebraMap_apply T (T ⧸ RingHom.ker (ε.comp φ))
          ((T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D) u]
        simp
      have hRHS : algebraMap (T ⧸ RingHom.ker (ε.comp φ))
            ((T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D)
            (Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) t) =
          (Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) t) ⊗ₜ[T] (1 : D) := by
        simp
      have hLHS : ((eT.toRingHom.comp κ).comp eA.toRingHom)
            (Ideal.Quotient.mk (RingHom.ker (ε.comp φ)) t) =
          (1 : T ⧸ RingHom.ker (ε.comp φ)) ⊗ₜ[T] (φ (ι (ε (φ t)))) := by
        rw [RingHom.comp_apply, RingHom.comp_apply, hmk]
        exact Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk D
          (RingHom.ker (ε.comp φ)) _
      rw [hLHS, hRHS, hkey (ι (ε (φ t))), hu]
    have halg : ((eT.toRingHom.comp κ).comp eA.toRingHom).toAlgebra =
        (inferInstance : Algebra (T ⧸ RingHom.ker (ε.comp φ))
          ((T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D)) :=
      Algebra.algebra_ext _ _ hcomp
    exact AlgebraicGeometry.Space.weaklyEtale_of_comp_ringEquiv κ eA eT
      (halg ▸ (inferInstance : Algebra.WeaklyEtale (T ⧸ RingHom.ker (ε.comp φ))
        ((T ⧸ RingHom.ker (ε.comp φ)) ⊗[T] D)))
  -- Stacks 092Z makes the structure map bijective, so the retraction `σ` is injective
  have hbij : Function.Bijective κ :=
    bijective_algebraMap_of_weaklyEtale_of_isLocalHom A (D ⧸ J) hwQ
  have hinj := injective_of_bijective_of_retraction κ σ hκε hbij
  intro d hd
  refine Ideal.Quotient.eq_zero_iff_mem.mp (hinj ?_)
  rw [map_zero, hσmk]
  exact RingHom.mem_ker.mp hd

/-- **The ideal of a retraction of a weakly étale algebra over a tensor product.**  Let
`φ : B₁ ⊗[A₀] B₂ →+* D` be weakly étale with `D` local and `A₀` henselian with separably closed
residue field, and let `ε : D →+* A₀` restrict along the two factors to two augmentations `e₁`
and `e₂`.  Then the kernel of `ε` is generated by the images of the kernels of `e₁` and `e₂`. -/
theorem ker_eq_sup_map_of_weaklyEtale_tensor
    {A₀ B₁ B₂ D : Type*} [CommRing A₀] [CommRing B₁] [CommRing B₂] [CommRing D]
    [HenselianLocalRing A₀] [IsSepClosed (ResidueField A₀)] [IsLocalRing D]
    [Algebra A₀ B₁] [Algebra A₀ B₂]
    (φ : (B₁ ⊗[A₀] B₂) →+* D) (ε : D →+* A₀)
    (e₁ : B₁ →ₐ[A₀] A₀) (e₂ : B₂ →ₐ[A₀] A₀)
    (hw : @Algebra.WeaklyEtale _ D _ _ φ.toAlgebra)
    (h₁ : ∀ b, ε (φ (Algebra.TensorProduct.includeLeftRingHom b)) = e₁ b)
    (h₂ : ∀ b, ε (φ ((Algebra.TensorProduct.includeRight :
      B₂ →ₐ[A₀] B₁ ⊗[A₀] B₂) b)) = e₂ b) :
    RingHom.ker ε =
      (RingHom.ker e₁.toRingHom).map (φ.comp Algebra.TensorProduct.includeLeftRingHom) ⊔
        (RingHom.ker e₂.toRingHom).map
          (φ.comp (Algebra.TensorProduct.includeRight :
            B₂ →ₐ[A₀] B₁ ⊗[A₀] B₂).toRingHom) := by
  have hcommutes (a : A₀) : ε (φ (algebraMap A₀ (B₁ ⊗[A₀] B₂) a)) = a := by
    have hal : algebraMap A₀ (B₁ ⊗[A₀] B₂) a =
        Algebra.TensorProduct.includeLeftRingHom (algebraMap A₀ B₁ a) := rfl
    rw [hal, h₁]
    simp
  have hcommutes' (a : A₀) :
      (ε.comp φ) (algebraMap A₀ (B₁ ⊗[A₀] B₂) a) = algebraMap A₀ A₀ a := by
    simpa using hcommutes a
  have hεa : ({ ε.comp φ with commutes' := hcommutes' } : (B₁ ⊗[A₀] B₂) →ₐ[A₀] A₀) =
      Algebra.TensorProduct.lift e₁ e₂ (fun _ _ => Commute.all _ _) := by
    refine Algebra.TensorProduct.ext' (fun b₁ b₂ => ?_)
    change ε (φ (b₁ ⊗ₜ[A₀] b₂)) = _
    rw [Algebra.TensorProduct.lift_tmul]
    have hb : (b₁ ⊗ₜ[A₀] b₂) = (Algebra.TensorProduct.includeLeftRingHom b₁) *
        ((Algebra.TensorProduct.includeRight : B₂ →ₐ[A₀] B₁ ⊗[A₀] B₂) b₂) := by
      simp [Algebra.TensorProduct.tmul_mul_tmul]
    rw [hb, map_mul, map_mul, h₁, h₂]
  have hker : RingHom.ker (ε.comp φ) =
      (RingHom.ker e₁.toRingHom).map Algebra.TensorProduct.includeLeftRingHom ⊔
        (RingHom.ker e₂.toRingHom).map
          (Algebra.TensorProduct.includeRight : B₂ →ₐ[A₀] B₁ ⊗[A₀] B₂).toRingHom := by
    rw [show ε.comp φ =
        (Algebra.TensorProduct.lift e₁ e₂ (fun _ _ => Commute.all _ _)).toRingHom from
      congrArg AlgHom.toRingHom hεa]
    exact Algebra.TensorProduct.ker_lift A₀ B₁ B₂ e₁ e₂
  rw [ker_eq_map_of_weaklyEtale_of_sepClosed φ ε
      (Algebra.TensorProduct.includeLeftRingHom.comp (algebraMap A₀ B₁)) hw hcommutes,
    hker, Ideal.map_sup, Ideal.map_map, Ideal.map_map]

end StacksDraft

end
