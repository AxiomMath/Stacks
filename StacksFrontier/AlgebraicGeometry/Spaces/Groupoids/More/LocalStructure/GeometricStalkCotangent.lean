module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.More.LocalStructure.GeometricStalkTensorHenselization

/-!
# The conormal module of a groupoid in algebraic spaces at a geometric identity

Let `(U, R, s, t, c, e, i)` be a groupoid in algebraic spaces over a scheme `S`, let `ū` be a
geometric point of `U`, and write

```
A = 𝒪_{U, ū},   B = 𝒪_{R, e(ū)},   C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}
```

for the étale local rings (Stacks 04KG).  Let `I ⊆ B` be the kernel of `e : B → A` and let
`J ⊆ C` be the ideal generated by `I ⊗ B + B ⊗ I`, that is, the image in `C` of the ideal
`I ⊗ B + B ⊗ I` of `B ⊗_{s, A, t} B` under the homomorphism `B ⊗_{s, A, t} B → C` induced by the
two projections.  The composition `c : B → C` sends `I` into `J` (Stacks 0CK9).

**Stacks 0CKA.**  The map `I/I² → J/J²` induced by `c` is the diagonal
`(1, 1) : I/I² → I/I² ⊕ I/I²` followed by the map `I/I² ⊕ I/I² → J/J²` coming from
`J = (I ⊗ B + B ⊗ I)C`, and the map `i : B → B` induces `-1` on `I/I²`.  These are
`cotangent_composition` and `cotangent_inverse`.

## Main definitions

* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricIdentityIdeal`: the ideal `I ⊆ B`.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricIdentityPairIdeal`: the ideal
  `J = (I ⊗ B + B ⊗ I)C ⊆ C`.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.compositionCotangent`,
  `...firstCotangent`, `...secondCotangent` and `...inverseCotangent`: the maps of conormal
  modules induced by `c`, by the two projections and by `i`.

## Main results

* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricIdentityPairIdeal_eq_sup`: `J` is the
  ideal generated by the two images of `I` under the projections.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricIdentityPairIdeal_eq_ker`: `J` is the
  kernel of `(e, e) : C → A`.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.bijective_cotangentPairs`: the map
  `I/I² ⊕ I/I² → J/J²` coming from `J = (I ⊗ B + B ⊗ I)C` is an isomorphism.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.cotangent_composition` and
  `AlgebraicGeometry.GroupoidInAlgebraicSpaces.cotangent_inverse`: **Stacks 0CKA**.

## Implementation notes

The rings and the homomorphisms between them are those of
`AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricStalkLocalGroupoidAlgebra`, so the proof is
the computation of `Stacks.Groupoids.LocalGroupoidAlgebra`, which is the one of the source: the
two retractions `C → B` carried by `a ↦ (a, e(s a))` and `a ↦ (e(t a), a)` induce maps
`J/J² → I/I²` which are jointly inverse to `I/I² ⊕ I/I² → J/J²`, and both undo `c`.  The input
specific to algebraic spaces is the identification of `J` with the kernel of `(e, e) : C → A`,
`AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricPairIdeal_eq_sup`: `C` is weakly étale over
`B ⊗_{s, A, t} B` (Stacks 0CK9) and `A` is strictly henselian, so Stacks 092Z applies.

The maps of conormal modules are `Ideal.mapCotangent` of the ring homomorphisms read as
`ℤ`-algebra homomorphisms; an equality of them specifies the value on every element of `I/I²`.

## References

* [Stacks Project, Tag 0CKA](https://stacks.math.columbia.edu/tag/0CKA)
* [Stacks Project, Tag 0CK9](https://stacks.math.columbia.edu/tag/0CK9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.GroupoidInAlgebraicSpaces

variable {C : BigFppfSite.{u}} {S : Scheme.{u}} {hS : C.Contains S}
  {B : AlgebraicSpaces C S hS} (G : GroupoidInAlgebraicSpaces C S hS B)
  (z : Space.GeometricPoint C S hS G.objects.obj)

/-- Pullbacks of presheaves on the big fppf site over `S` (instance search times out without
this shortcut). -/
local instance (priority := high) hasPullback_presheaf_geometricStalkCotangent
    {X Y Z : (BigFppfOver C S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

/-! ### The ideals `I` and `J` -/

/-- The ideal `I ⊆ B = 𝒪_{R, e(ū)}` of the identity: the kernel of `e : B → A`. -/
abbrev geometricIdentityIdeal :
    Ideal (Space.etaleLocalRing C S hS G.arrows.obj (identityArrowPoint G z)) :=
  RingHom.ker (identityStalk G z)

/-- The ideal `J ⊆ C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}` generated by `I ⊗ B + B ⊗ I`: the image
of the ideal `I ⊗ B + B ⊗ I` of `B ⊗_{s, A, t} B` under the homomorphism
`B ⊗_{s, A, t} B → C`, `b₁ ⊗ b₂ ↦ pr₁(b₁) pr₂(b₂)`. -/
def geometricIdentityPairIdeal :
    Ideal (Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom)
      (identityPairPoint G z)) :=
  ((geometricIdentityIdeal G z).map (pushout.inl (CommRingCat.ofHom (sourceStalk G z))
      (CommRingCat.ofHom (targetStalk G z))).hom ⊔
    (geometricIdentityIdeal G z).map (pushout.inr (CommRingCat.ofHom (sourceStalk G z))
      (CommRingCat.ofHom (targetStalk G z))).hom).map (identityPairTensorMap G z)

/-- `J` is generated by the two images of `I` under the projections. -/
theorem geometricIdentityPairIdeal_eq_sup :
    geometricIdentityPairIdeal G z =
      (geometricIdentityIdeal G z).map (identityPairLeft G z) ⊔
        (geometricIdentityIdeal G z).map (identityPairRight G z) := by
  rw [geometricIdentityPairIdeal, Ideal.map_sup, Ideal.map_map, Ideal.map_map,
    identityPairTensorMap_comp_inl, identityPairTensorMap_comp_inr]

/-- `J` is the ideal of the pair of identities of the local model
`geometricStalkLocalGroupoidAlgebra`. -/
theorem geometricIdentityPairIdeal_eq_pairIdeal :
    geometricIdentityPairIdeal G z = (geometricStalkLocalGroupoidAlgebra G z).pairIdeal :=
  (geometricIdentityPairIdeal_eq_sup G z).trans (geometricPairIdeal_eq_sup G z).symm

/-- `J` is the kernel of `(e, e) : C → A`. -/
theorem geometricIdentityPairIdeal_eq_ker :
    geometricIdentityPairIdeal G z = RingHom.ker (identityPairStalk G z) := by
  rw [identityPairStalk_eq]
  exact geometricIdentityPairIdeal_eq_pairIdeal G z

/-! ### The maps of conormal modules -/

/-- The map `I/I² → J/J²` induced by the composition `c : B → C`. -/
def compositionCotangent :
    (geometricIdentityIdeal G z).Cotangent →ₗ[ℤ] (geometricIdentityPairIdeal G z).Cotangent :=
  Ideal.mapCotangent _ _ (identityPairComp G z).toIntAlgHom
    ((geometricStalkLocalGroupoidAlgebra G z).identityIdeal_le_comap_comp _
      (geometricIdentityPairIdeal_eq_pairIdeal G z))

/-- The map `I/I² → J/J²` induced by the first projection `pr₁ : B → C`, `b ↦ b ⊗ 1`. -/
def firstCotangent :
    (geometricIdentityIdeal G z).Cotangent →ₗ[ℤ] (geometricIdentityPairIdeal G z).Cotangent :=
  Ideal.mapCotangent _ _ (identityPairLeft G z).toIntAlgHom
    ((geometricStalkLocalGroupoidAlgebra G z).identityIdeal_le_comap_first _
      (geometricIdentityPairIdeal_eq_pairIdeal G z))

/-- The map `I/I² → J/J²` induced by the second projection `pr₂ : B → C`, `b ↦ 1 ⊗ b`. -/
def secondCotangent :
    (geometricIdentityIdeal G z).Cotangent →ₗ[ℤ] (geometricIdentityPairIdeal G z).Cotangent :=
  Ideal.mapCotangent _ _ (identityPairRight G z).toIntAlgHom
    ((geometricStalkLocalGroupoidAlgebra G z).identityIdeal_le_comap_second _
      (geometricIdentityPairIdeal_eq_pairIdeal G z))

/-- The endomorphism of `I/I²` induced by the inversion `i : B → B`. -/
def inverseCotangent :
    (geometricIdentityIdeal G z).Cotangent →ₗ[ℤ] (geometricIdentityIdeal G z).Cotangent :=
  Ideal.mapCotangent _ _ (inverseStalk G z).toIntAlgHom
    (geometricStalkLocalGroupoidAlgebra G z).identityIdeal_le_comap_inverse

/-! ### Stacks 0CKA -/

/-- **The arrow `I/I² ⊕ I/I² → J/J²` coming from `J = (I ⊗ B + B ⊗ I)C` is an isomorphism.**
At a geometric identity of a groupoid in algebraic spaces, the sum of the maps induced by the
two projections is a bijection `I/I² ⊕ I/I² → J/J²`; its inverse is induced by the two
retractions `C → B` carried by `a ↦ (a, e(s a))` and `a ↦ (e(t a), a)`. -/
@[stacks 0CKA "the arrow I/I^2 + I/I^2 -> J/J^2 coming from J = (I (x) B + B (x) I)C is an \
isomorphism, as shown in the proof"]
theorem bijective_cotangentPairs :
    Function.Bijective ((firstCotangent G z).coprod (secondCotangent G z)) :=
  (geometricStalkLocalGroupoidAlgebra G z).bijective_coprod_mapCotangent _
    (geometricIdentityPairIdeal_eq_pairIdeal G z)

/-- **Stacks 0CKA, composition.**  Let `(U, R, s, t, c, e, i)` be a groupoid in algebraic spaces
and `ū` a geometric point of `U`, with étale local rings `A = 𝒪_{U, ū}`, `B = 𝒪_{R, e(ū)}` and
`C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}`, `I = ker (e : B → A)` and `J = (I ⊗ B + B ⊗ I)C`.  The
map `I/I² → J/J²` induced by `c` is the diagonal `(1, 1) : I/I² → I/I² ⊕ I/I²` followed by the
map `I/I² ⊕ I/I² → J/J²` coming from `J = (I ⊗ B + B ⊗ I)C`, the sum of the maps induced by
the two projections. -/
@[stacks 0CKA "composition: for a groupoid in algebraic spaces at a geometric point u-bar, with \
the etale local rings A = O_{U,u-bar}, B = O_{R,e(u-bar)}, C = O_{R x_{s,U,t} R,(e,e)(u-bar)}, \
I = ker(e) and J = (I (x) B + B (x) I)C, the map I/I^2 -> J/J^2 induced by c is (1,1) followed by \
I/I^2 + I/I^2 -> J/J^2"]
theorem cotangent_composition :
    compositionCotangent G z =
      ((firstCotangent G z).coprod (secondCotangent G z)).comp
        (LinearMap.id.prod LinearMap.id) :=
  (geometricStalkLocalGroupoidAlgebra G z).mapCotangent_comp_eq _
    (geometricIdentityPairIdeal_eq_pairIdeal G z)

/-- **Stacks 0CKA, inversion.**  At a geometric identity of a groupoid in algebraic spaces, the
map `i : B → B` of étale local rings induced by inversion acts as `-1` on `I/I²`. -/
@[stacks 0CKA "inversion: for a groupoid in algebraic spaces at a geometric point u-bar, the map \
i : B -> B of the etale local ring B = O_{R,e(u-bar)} induces -1 on I/I^2, I = ker(e : B -> A)"]
theorem cotangent_inverse : inverseCotangent G z = -LinearMap.id :=
  (geometricStalkLocalGroupoidAlgebra G z).mapCotangent_inverse_eq

end AlgebraicGeometry.GroupoidInAlgebraicSpaces

end
