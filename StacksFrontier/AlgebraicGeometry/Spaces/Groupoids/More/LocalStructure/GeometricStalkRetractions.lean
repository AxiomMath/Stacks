module

public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.EtaleLocalRingChartHenselization
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.More.IdentityArrowRetractions
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.More.LocalStructure.GeometricStalkPairIdeal

/-!
# The étale local rings of a groupoid in algebraic spaces at a geometric identity

Let `(U, R, s, t, c)` be a groupoid in algebraic spaces, let `ū` be a geometric point of `U` and
write

```
A = 𝒪_{U, ū},   B = 𝒪_{R, e(ū)},   C = 𝒪_{R ×_{s, U, t} R, (e, e)(ū)}
```

for the étale local rings (Stacks 04KG).  This file defines the homomorphisms between `A` and
`B` induced by the source, the target and the unit, proves the relations among them and the
homomorphisms `C ⟶ B` and `B ⟶ C` carried by the identity sections, the projections and the
composition law, and computes the ideal of the pair of identities: the kernel of
`(e, e) : C ⟶ A` is generated by the two images of the kernel `I` of `e : B ⟶ A`.

## Main definitions

* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.sourceStalk` and `...targetStalk`: the
  homomorphisms `A ⟶ B` induced by the source and the target.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityStalk`: the homomorphism `B ⟶ A`
  induced by the unit.

## Main results

* `AlgebraicGeometry.Space.etaleLocalRingMap_congr_point`: the canonical homomorphism of étale
  local rings is compatible with transport along an equality of geometric points.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityStalk_comp_sourceStalk` and
  `...identityStalk_comp_targetStalk`: the unit retracts the source and the target.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityPairFst_comp_identityPairRight_eq` and
  `...identityPairSnd_comp_identityPairLeft_eq`: the two mixed composites of a projection with
  an identity section.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.geometricPairIdeal_eq_sup`: the ideal of the
  pair of identities is generated by the two images of the ideal of the identity.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityPairComp_mem_pairIdeal`: the composition
  law carries the ideal of the identity into the ideal of the pair of identities.
* `AlgebraicGeometry.GroupoidInAlgebraicSpaces.identityPairComp_comp_sourceStalk`: the
  composition law and the second projection agree after the source.

## Implementation notes

Every homomorphism is a canonical homomorphism of étale local rings composed with transports
along equalities of geometric points, since the three geometric points `pr₁(e, e)(ū)`,
`pr₂(e, e)(ū)` and `e(ū)` of `R` are equal only propositionally.

## References

* [Stacks Project, Tag 0CK9](https://stacks.math.columbia.edu/tag/0CK9)
* [Stacks Project, Tag 04KG](https://stacks.math.columbia.edu/tag/04KG)
* [Stacks Project, Tag 04NG](https://stacks.math.columbia.edu/tag/04NG)
* [Stacks Project, Tag 092Z](https://stacks.math.columbia.edu/tag/092Z)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing
open scoped TensorProduct

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- Two transports of the étale local ring compose to the transport along the composite
equality. -/
theorem etaleLocalRingCongr_trans {x y z : GeometricPoint B S hS F} (h₁ : x = y) (h₂ : y = z)
    (m : etaleLocalRing B S hS F x) :
    etaleLocalRingCongr h₂ (etaleLocalRingCongr h₁ m) = etaleLocalRingCongr (h₁.trans h₂) m := by
  subst h₁ h₂
  rfl

/-- The inverse of a transport of the étale local ring is the transport along the inverse
equality. -/
theorem etaleLocalRingCongr_symm {x y : GeometricPoint B S hS F} (h : x = y) :
    (etaleLocalRingCongr h).symm = etaleLocalRingCongr h.symm := by
  subst h
  rfl

/-- The canonical homomorphism of étale local rings is compatible with transport along an
equality of geometric points. -/
theorem etaleLocalRingMap_congr_point (hF : IsAlgebraicSpace B S hS F) (f : F ⟶ G)
    {x y : GeometricPoint B S hS F} (h : x = y)
    (m : etaleLocalRing B S hS G (geometricPointMap f y)) :
    etaleLocalRingMap hF f x
        ((etaleLocalRingCongr (congrArg (geometricPointMap f) h)).symm m) =
      (etaleLocalRingCongr h).symm (etaleLocalRingMap hF f y m) := by
  subst h
  rfl

/-- **Two factorisations of one morphism.**  Let `j ≫ p = a ≫ b` be two factorisations of a
morphism out of `F`, let `x` be a geometric point of `F` and let `y`, `v` and `u` be the
geometric points its images determine.  Then the two induced homomorphisms of étale local rings
out of the étale local ring at `u` agree, each read through the transports along the displayed
equalities of geometric points. -/
theorem comp_etaleLocalRingMap_apply_of_factors {H K : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : IsAlgebraicSpace B S hS F) (hG : IsAlgebraicSpace B S hS G)
    (hH : IsAlgebraicSpace B S hS H)
    (j : F ⟶ H) (p : H ⟶ K) (a : F ⟶ G) (b : G ⟶ K) (hjp : j ≫ p = a ≫ b)
    (x : GeometricPoint B S hS F) (y : GeometricPoint B S hS H)
    (hy : geometricPointMap j x = y) (v : GeometricPoint B S hS G)
    (hv : geometricPointMap a x = v) (u : GeometricPoint B S hS K)
    (hu : geometricPointMap p y = u) (hw : geometricPointMap b v = u)
    (m : etaleLocalRing B S hS K u) :
    etaleLocalRingMap hF j x ((etaleLocalRingCongr hy).symm
        (etaleLocalRingMap hH p y ((etaleLocalRingCongr hu).symm m))) =
      etaleLocalRingMap hF a x ((etaleLocalRingCongr hv).symm
        (etaleLocalRingMap hG b v ((etaleLocalRingCongr hw).symm m))) := by
  subst hy hv
  set m₁ := (etaleLocalRingCongr hu).symm m with hm₁
  set m₂ := (etaleLocalRingCongr
    (congrArg (fun k => geometricPointMap k x) hjp)).toRingHom m₁ with hm₂
  have h1 := DFunLike.congr_fun (etaleLocalRingMap_comp hF hH j p x) m₁
  have h2 := DFunLike.congr_fun (etaleLocalRingMap_congr hF hjp x) m₁
  have h3 := DFunLike.congr_fun (etaleLocalRingMap_comp hF hG a b x) m₂
  have hm : m₂ = (etaleLocalRingCongr hw).symm m := by
    rw [hm₂, hm₁, etaleLocalRingCongr_symm, etaleLocalRingCongr_symm]
    exact etaleLocalRingCongr_trans hu.symm
      (congrArg (fun k => geometricPointMap k x) hjp) m
  refine (h1.trans (h2.trans h3.symm)).trans ?_
  rw [hm]
  rfl

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.GroupoidInAlgebraicSpaces

variable {C : BigFppfSite.{u}} {S : Scheme.{u}} {hS : C.Contains S}
  {B : AlgebraicSpaces C S hS} (G : GroupoidInAlgebraicSpaces C S hS B)
  (z : Space.GeometricPoint C S hS G.objects.obj)

/-- The homomorphism `A ⟶ B` of étale local rings induced by the source, at the identity arrow
above a geometric point of the object space. -/
def sourceStalk :
    Space.etaleLocalRing C S hS G.objects.obj z →+*
      Space.etaleLocalRing C S hS G.arrows.obj (identityArrowPoint G z) :=
  (Space.etaleLocalRingMap G.arrows.property G.source.hom (identityArrowPoint G z)).comp
    (Space.etaleLocalRingCongr (geometricPointMap_source_identityArrowPoint G z)).symm.toRingHom

/-- The homomorphism `A ⟶ B` of étale local rings induced by the target, at the identity arrow
above a geometric point of the object space. -/
def targetStalk :
    Space.etaleLocalRing C S hS G.objects.obj z →+*
      Space.etaleLocalRing C S hS G.arrows.obj (identityArrowPoint G z) :=
  (Space.etaleLocalRingMap G.arrows.property G.target.hom (identityArrowPoint G z)).comp
    (Space.etaleLocalRingCongr (geometricPointMap_target_identityArrowPoint G z)).symm.toRingHom

/-- The homomorphism `B ⟶ A` of étale local rings induced by the unit, at the identity arrow
above a geometric point of the object space.  Its kernel is the ideal `I`. -/
def identityStalk :
    Space.etaleLocalRing C S hS G.arrows.obj (identityArrowPoint G z) →+*
      Space.etaleLocalRing C S hS G.objects.obj z :=
  Space.etaleLocalRingMap G.objects.property (identityArrow G).hom z

/-- The unit retracts the source: `e ∘ s = 1` on `A`. -/
theorem identityStalk_comp_sourceStalk :
    (identityStalk G z).comp (sourceStalk G z) = RingHom.id _ :=
  RingHom.ext fun m =>
    Space.comp_etaleLocalRingMap_apply_of_section G.objects.property G.arrows.property
      (identityArrow G).hom G.source.hom (identityArrow_hom_comp_source G) z
      (identityArrowPoint G z) rfl (geometricPointMap_source_identityArrowPoint G z) m

/-- The unit retracts the target: `e ∘ t = 1` on `A`. -/
theorem identityStalk_comp_targetStalk :
    (identityStalk G z).comp (targetStalk G z) = RingHom.id _ :=
  RingHom.ext fun m =>
    Space.comp_etaleLocalRingMap_apply_of_section G.objects.property G.arrows.property
      (identityArrow G).hom G.target.hom (identityArrow_hom_comp_target G) z
      (identityArrowPoint G z) rfl (geometricPointMap_target_identityArrowPoint G z) m

/-- The retraction `j₂^#` composed with the second projection is `s ∘ e`: the second entry of
the pair `(a, e(s a))` is the identity at the source of `a`. -/
theorem identityPairFst_comp_identityPairRight_eq :
    (identityPairFst G z).comp (identityPairRight G z) =
      (sourceStalk G z).comp (identityStalk G z) :=
  RingHom.ext fun m =>
    Space.comp_etaleLocalRingMap_apply_of_factors G.arrows.property G.objects.property
      (isAlgebraicSpace_composablePairs G) (identitySectionAfterSource G)
      (pullback.snd G.source.hom G.target.hom) G.source.hom (identityArrow G).hom
      (identitySectionAfterSource_comp_snd G) (identityArrowPoint G z)
      (identityPairPoint G z) rfl z
      (geometricPointMap_source_identityArrowPoint G z)
      (identityArrowPoint G z) (geometricPointMap_snd_identityPairPoint G z) rfl m

/-- The retraction `j₁^#` composed with the first projection is `t ∘ e`: the first entry of the
pair `(e(t a), a)` is the identity at the target of `a`. -/
theorem identityPairSnd_comp_identityPairLeft_eq :
    (identityPairSnd G z).comp (identityPairLeft G z) =
      (targetStalk G z).comp (identityStalk G z) :=
  RingHom.ext fun m =>
    Space.comp_etaleLocalRingMap_apply_of_factors G.arrows.property G.objects.property
      (isAlgebraicSpace_composablePairs G) (identitySectionAfterTarget G)
      (pullback.fst G.source.hom G.target.hom) G.target.hom (identityArrow G).hom
      (identitySectionAfterTarget_comp_fst G) (identityArrowPoint G z)
      (identityPairPoint G z) (geometricPointMap_identitySectionAfterTarget G z) z
      (geometricPointMap_target_identityArrowPoint G z)
      (identityArrowPoint G z) (geometricPointMap_fst_identityPairPoint G z) rfl m

/-- The kernel of a ring homomorphism precomposed with an equivalence and postcomposed with the
inverse of another is the image of its kernel under the inverse of the first equivalence. -/
private theorem ker_comp_comp_equiv_eq_map_symm {R S T U : Type*} [CommRing R] [CommRing S]
    [CommRing T] [CommRing U] (f : R →+* S) (e : T ≃+* R) (c : U ≃+* S) :
    RingHom.ker (c.symm.toRingHom.comp (f.comp e.toRingHom)) =
      (RingHom.ker f).map e.symm.toRingHom := by
  rw [RingHom.ker_comp_of_injective _ c.symm.injective, ← RingHom.comap_ker]
  exact (Ideal.map_symm e).symm

/-- The kernel of the homomorphism `(e, e) : C ⟶ A` of étale local rings carried by the pair of
identity arrows is the ideal `J` generated by the two images of the ideal `I` of the identity
arrow, that is, by `I ⊗ B + B ⊗ I`. -/
theorem geometricPairIdeal_eq_sup :
    RingHom.ker ((identityStalk G z).comp (identityPairFst G z)) =
      (RingHom.ker (identityStalk G z)).map (identityPairLeft G z) ⊔
        (RingHom.ker (identityStalk G z)).map (identityPairRight G z) := by
  have hpb := AlgebraicSpaces.isPullback_fiberProduct C S hS G.source G.target
  let x' := identityPairPoint G z
  let y₁ := Space.geometricPointMap (pullback.fst G.source.hom G.target.hom) x'
  let y₂ := Space.geometricPointMap (pullback.snd G.source.hom G.target.hom) x'
  let w₀ := Space.geometricPointMap G.source.hom y₁
  let w₂ := Space.geometricPointMap G.target.hom y₂
  have h : w₀ = w₂ := congrArg
    (fun k : AlgebraicSpaces.fiberProduct C S hS G.source G.target ⟶ G.objects =>
      Space.geometricPointMap k.hom x') hpb.w
  have hfst : y₁ = identityArrowPoint G z := geometricPointMap_fst_identityPairPoint G z
  have hsnd : y₂ = identityArrowPoint G z := geometricPointMap_snd_identityPairPoint G z
  have hsrc : Space.geometricPointMap G.source.hom (identityArrowPoint G z) = z :=
    geometricPointMap_source_identityArrowPoint G z
  have hw₀ : w₀ = z := (congrArg (Space.geometricPointMap G.source.hom) hfst).trans hsrc
  set cA : Space.etaleLocalRing C S hS G.objects.obj w₀ ≃+*
      Space.etaleLocalRing C S hS G.objects.obj z := Space.etaleLocalRingCongr hw₀ with hcA
  let : Algebra (Space.etaleLocalRing C S hS G.objects.obj w₀)
      (Space.etaleLocalRing C S hS G.arrows.obj y₁) :=
    (Space.etaleLocalRingMap G.arrows.property G.source.hom y₁).toAlgebra
  let : Algebra (Space.etaleLocalRing C S hS G.objects.obj w₀)
      (Space.etaleLocalRing C S hS G.arrows.obj y₂) :=
    ((eqToHom (congrArg (Space.etaleLocalRing C S hS G.objects.obj) h) ≫
      CommRingCat.ofHom
        (Space.etaleLocalRingMap G.arrows.property G.target.hom y₂)).hom).toAlgebra
  have := Space.strictlyHenselianLocalRing_etaleLocalRing C S hS G.objects.obj
    G.objects.property w₀
  have := Space.strictlyHenselianLocalRing_etaleLocalRing C S hS
    (pullback G.source.hom G.target.hom) (isAlgebraicSpace_composablePairs G) x'
  obtain ⟨φ, hφl, hφr, hφw⟩ : ∃ φ : Space.etaleLocalRing C S hS G.arrows.obj y₁ ⊗[
        Space.etaleLocalRing C S hS G.objects.obj w₀]
        Space.etaleLocalRing C S hS G.arrows.obj y₂ →+*
        Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom) x',
      φ.comp Algebra.TensorProduct.includeLeftRingHom =
          Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
            (pullback.fst G.source.hom G.target.hom) x' ∧
        φ.comp Algebra.TensorProduct.includeRight.toRingHom =
          Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
            (pullback.snd G.source.hom G.target.hom) x' ∧
        @Algebra.WeaklyEtale _ _ _ _ φ.toAlgebra :=
    Space.cartesian_etaleStalk_tensor_weaklyEtale C S hS _ _ G.source G.target hpb x'
  have hA (a : Space.etaleLocalRing C S hS G.objects.obj w₀) :
      (Space.etaleLocalRingCongr hfst)
          ((Space.etaleLocalRingMap G.arrows.property G.source.hom y₁) a) =
        sourceStalk G z (cA a) := by
    have hcp := Space.etaleLocalRingMap_congr_point G.arrows.property G.source.hom hfst
      ((Space.etaleLocalRingCongr hsrc).symm (cA a))
    have ha : (Space.etaleLocalRingCongr
        (congrArg (Space.geometricPointMap G.source.hom) hfst)).symm
        ((Space.etaleLocalRingCongr hsrc).symm (cA a)) = a := by
      rw [Space.etaleLocalRingCongr_symm, Space.etaleLocalRingCongr_symm, hcA,
        Space.etaleLocalRingCongr_trans, Space.etaleLocalRingCongr_trans]
      rfl
    rw [ha] at hcp
    rw [hcp, RingEquiv.apply_symm_apply, sourceStalk, RingHom.comp_apply]
    rfl
  set resA : Space.etaleLocalRing C S hS G.arrows.obj y₁ →ₐ[
      Space.etaleLocalRing C S hS G.objects.obj w₀]
      Space.etaleLocalRing C S hS G.objects.obj w₀ :=
    { cA.symm.toRingHom.comp
        ((identityStalk G z).comp (Space.etaleLocalRingCongr hfst).toRingHom) with
      commutes' := fun a => by
        have h1 : identityStalk G z (sourceStalk G z (cA a)) = cA a :=
          RingHom.congr_fun (identityStalk_comp_sourceStalk G z) (cA a)
        show cA.symm (identityStalk G z ((Space.etaleLocalRingCongr hfst)
          ((Space.etaleLocalRingMap G.arrows.property G.source.hom y₁) a))) = _
        rw [hA a, h1, RingEquiv.symm_apply_apply]
        rfl } with hresA
  set rB : Space.etaleLocalRing C S hS G.arrows.obj y₂ →+*
      Space.etaleLocalRing C S hS G.objects.obj w₀ :=
    cA.symm.toRingHom.comp
      ((identityStalk G z).comp (Space.etaleLocalRingCongr hsnd).toRingHom) with hresB
  set ε₀ : Space.etaleLocalRing C S hS (pullback G.source.hom G.target.hom) x' →+*
      Space.etaleLocalRing C S hS G.objects.obj w₀ :=
    cA.symm.toRingHom.comp ((identityStalk G z).comp (identityPairFst G z)) with hε₀
  have h₁ (b : Space.etaleLocalRing C S hS G.arrows.obj y₁) :
      ε₀ (φ (Algebra.TensorProduct.includeLeftRingHom b)) = resA b := by
    rw [hε₀]
    show cA.symm (identityStalk G z (identityPairFst G z
      (φ (Algebra.TensorProduct.includeLeftRingHom b)))) = _
    rw [show φ (Algebra.TensorProduct.includeLeftRingHom b) =
        Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
          (pullback.fst G.source.hom G.target.hom) x' b from RingHom.congr_fun hφl b]
    have hb : Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
        (pullback.fst G.source.hom G.target.hom) x' b =
          identityPairLeft G z ((Space.etaleLocalRingCongr hfst) b) := by
      rw [identityPairLeft, RingHom.comp_apply]
      exact congrArg _ ((Space.etaleLocalRingCongr hfst).symm_apply_apply b).symm
    rw [hb, show identityPairFst G z (identityPairLeft G z
        ((Space.etaleLocalRingCongr hfst) b)) = (Space.etaleLocalRingCongr hfst) b from
      RingHom.congr_fun (identityPairFst_comp_identityPairLeft G z) _]
    rfl
  have h₂ (b : Space.etaleLocalRing C S hS G.arrows.obj y₂) :
      ε₀ (φ ((Algebra.TensorProduct.includeRight :
        Space.etaleLocalRing C S hS G.arrows.obj y₂ →ₐ[
          Space.etaleLocalRing C S hS G.objects.obj w₀] _) b)) = rB b := by
    rw [hε₀]
    show cA.symm (identityStalk G z (identityPairFst G z (φ _))) = _
    rw [show φ ((Algebra.TensorProduct.includeRight :
          Space.etaleLocalRing C S hS G.arrows.obj y₂ →ₐ[
            Space.etaleLocalRing C S hS G.objects.obj w₀] _) b) =
        Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
          (pullback.snd G.source.hom G.target.hom) x' b from RingHom.congr_fun hφr b]
    have hb : Space.etaleLocalRingMap (isAlgebraicSpace_composablePairs G)
        (pullback.snd G.source.hom G.target.hom) x' b =
          identityPairRight G z ((Space.etaleLocalRingCongr hsnd) b) := by
      rw [identityPairRight, RingHom.comp_apply]
      exact congrArg _ ((Space.etaleLocalRingCongr hsnd).symm_apply_apply b).symm
    rw [hb, show identityPairFst G z (identityPairRight G z
        ((Space.etaleLocalRingCongr hsnd) b)) =
        sourceStalk G z (identityStalk G z ((Space.etaleLocalRingCongr hsnd) b)) from
      RingHom.congr_fun (identityPairFst_comp_identityPairRight_eq G z) _,
      show identityStalk G z (sourceStalk G z
          (identityStalk G z ((Space.etaleLocalRingCongr hsnd) b))) =
          identityStalk G z ((Space.etaleLocalRingCongr hsnd) b) from
        RingHom.congr_fun (identityStalk_comp_sourceStalk G z) _]
    rfl
  have halgR (a : Space.etaleLocalRing C S hS G.objects.obj w₀) :
      (Algebra.TensorProduct.includeRight :
          Space.etaleLocalRing C S hS G.arrows.obj y₂ →ₐ[
            Space.etaleLocalRing C S hS G.objects.obj w₀] _)
          (algebraMap (Space.etaleLocalRing C S hS G.objects.obj w₀)
            (Space.etaleLocalRing C S hS G.arrows.obj y₂) a) =
        Algebra.TensorProduct.includeLeftRingHom
          (algebraMap (Space.etaleLocalRing C S hS G.objects.obj w₀)
            (Space.etaleLocalRing C S hS G.arrows.obj y₁) a) := by
    rw [show (Algebra.TensorProduct.includeRight :
          Space.etaleLocalRing C S hS G.arrows.obj y₂ →ₐ[
            Space.etaleLocalRing C S hS G.objects.obj w₀] _)
          (algebraMap (Space.etaleLocalRing C S hS G.objects.obj w₀)
            (Space.etaleLocalRing C S hS G.arrows.obj y₂) a) =
        algebraMap (Space.etaleLocalRing C S hS G.objects.obj w₀)
          (Space.etaleLocalRing C S hS G.arrows.obj y₁ ⊗[
            Space.etaleLocalRing C S hS G.objects.obj w₀]
            Space.etaleLocalRing C S hS G.arrows.obj y₂) a from
      (Algebra.TensorProduct.algebraMap_apply' a).symm]
    exact Algebra.TensorProduct.algebraMap_apply a
  have hcommB (a : Space.etaleLocalRing C S hS G.objects.obj w₀) :
      rB (algebraMap (Space.etaleLocalRing C S hS G.objects.obj w₀)
          (Space.etaleLocalRing C S hS G.arrows.obj y₂) a) =
        algebraMap (Space.etaleLocalRing C S hS G.objects.obj w₀)
          (Space.etaleLocalRing C S hS G.objects.obj w₀) a := by
    rw [← h₂, halgR, h₁]
    exact resA.commutes a
  set resB : Space.etaleLocalRing C S hS G.arrows.obj y₂ →ₐ[
      Space.etaleLocalRing C S hS G.objects.obj w₀]
      Space.etaleLocalRing C S hS G.objects.obj w₀ :=
    { rB with commutes' := hcommB }
  have key := StacksDraft.ker_eq_sup_map_of_weaklyEtale_tensor φ ε₀ resA resB hφw h₁ h₂
  have hkerε : RingHom.ker ε₀ =
      RingHom.ker ((identityStalk G z).comp (identityPairFst G z)) :=
    RingHom.ker_comp_of_injective _ cA.symm.injective
  have hkerA : RingHom.ker resA.toRingHom =
      (RingHom.ker (identityStalk G z)).map
        (Space.etaleLocalRingCongr hfst).symm.toRingHom :=
    ker_comp_comp_equiv_eq_map_symm _ _ _
  have hkerB : RingHom.ker resB.toRingHom =
      (RingHom.ker (identityStalk G z)).map
        (Space.etaleLocalRingCongr hsnd).symm.toRingHom :=
    ker_comp_comp_equiv_eq_map_symm _ _ _
  rw [← hkerε, key, hkerA, hkerB, Ideal.map_map, Ideal.map_map, hφl, hφr, identityPairLeft,
    identityPairRight]

/-- The composition law carries the ideal `I` of the identity into the ideal `J` of the pair of
identities. -/
theorem identityPairComp_mem_pairIdeal
    {x : Space.etaleLocalRing C S hS G.arrows.obj (identityArrowPoint G z)}
    (hx : x ∈ RingHom.ker (identityStalk G z)) :
    identityPairComp G z x ∈
      RingHom.ker ((identityStalk G z).comp (identityPairFst G z)) := by
  rw [RingHom.mem_ker, RingHom.comp_apply,
    show identityPairFst G z (identityPairComp G z x) = x from
      RingHom.congr_fun (identityPairFst_comp_identityPairComp G z) x]
  exact RingHom.mem_ker.mp hx

/-- The source of a composite is the source of its second entry, read on the underlying
presheaves: `s ∘ c = s ∘ pr₂`. -/
theorem comp_hom_comp_source :
    G.comp.hom ≫ G.source.hom =
      pullback.snd G.source.hom G.target.hom ≫ G.source.hom :=
  congrArg (fun k : AlgebraicSpaces.fiberProduct C S hS G.source G.target ⟶ G.objects => k.hom)
    (comp_comp_source G)

/-- **The source of a composite, on local rings.**  The composition law and the second
projection agree after the source: `c ∘ s = pr₂ ∘ s` as maps `A ⟶ C`. -/
theorem identityPairComp_comp_sourceStalk :
    (identityPairComp G z).comp (sourceStalk G z) =
      (identityPairRight G z).comp (sourceStalk G z) :=
  RingHom.ext fun m =>
    Space.comp_etaleLocalRingMap_apply_of_factors (isAlgebraicSpace_composablePairs G)
      G.arrows.property G.arrows.property G.comp.hom G.source.hom
      (pullback.snd G.source.hom G.target.hom) G.source.hom (comp_hom_comp_source G)
      (identityPairPoint G z) (identityArrowPoint G z)
      (geometricPointMap_comp_identityPairPoint G z) (identityArrowPoint G z)
      (geometricPointMap_snd_identityPairPoint G z) z
      (geometricPointMap_source_identityArrowPoint G z)
      (geometricPointMap_source_identityArrowPoint G z) m

end AlgebraicGeometry.GroupoidInAlgebraicSpaces

