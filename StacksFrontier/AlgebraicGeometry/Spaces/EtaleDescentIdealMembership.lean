-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-! ### A jointly faithfully flat finite affine family inside a covering sieve -/

variable {B S hS F hF}

/-- **Étale descent of membership in the submodule generated by finitely many global sections.**
Let `G` be an `𝒪_F`-module cartesian on affine charts, let `g` be a finite family of global
sections of `G`, and let `U` be an étale chart with affine underlying scheme.  A section over
`U` whose restriction along every member of some covering sieve of `U` lies in the span of the
restrictions of `g` lies in the span of `g` over `U`.

The sieve is refined to a finite family of affine charts whose chart restrictions are jointly
faithfully flat, and `AlgebraicGeometry.Space.mem_span_of_forall_restrict_mem_span` descends the
membership along that family.  Because `g` consists of *global* sections, the restrictions of
`g` to a member of the refinement are the values of `g` there, so the hypothesis applies with no
intersection of coverings. -/
theorem mem_span_eval_of_mem_topology (G : Modules.{u, u} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G) {κ : Type*} [Finite κ] (g : κ → G.sections)
    {U : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    {T : Sieve U} (hT : T ∈ SmallEtale.topology B S hS F U) {x : G.val.obj (op U)}
    (hx : ∀ ⦃V : SmallEtale B S hS F⦄ (h : V ⟶ U), T h →
      G.val.map h.op x ∈ Submodule.span (chartRing B S hS F hF V)
        (Set.range fun l => (g l).eval (op V))) :
    x ∈ Submodule.span (chartRing B S hS F hF U)
      (Set.range fun l => (g l).eval (op U)) := by
  obtain ⟨n, z, φ, hzaff, hzT, hff⟩ :=
    exists_finite_affine_faithfullyFlat_pi_le B S hS F hF hU hT
  refine mem_span_of_forall_restrict_mem_span G hG hU φ hzaff hff
    (fun l => (g l).eval (op U)) fun i => ?_
  have hrange : (Set.range fun l => chartRestrictLinear G (φ i) ((g l).eval (op U))) =
      Set.range fun l => (g l).eval (op (z i)) := by
    refine congrArg Set.range (funext fun l => ?_)
    rw [chartRestrictLinear_apply]
    exact (g l).property (φ i).op
  rw [hrange, chartRestrictLinear_apply]
  exact hx (φ i) (hzT i)

variable (B S hS)

/-! ### The sheaf of ideals generated by finitely many global functions -/

/-- The presheaf of ideals of `𝒪_X` generated on each étale chart by the restrictions of a
finite family of global regular functions.  Membership in it is not a local condition, so it is
a submodule of the underlying presheaf of `𝒪_X` and not a sheaf of ideals; its local closure is
`AlgebraicGeometry.Space.vanishingIdealSheaf`. -/
def vanishingPresheafIdeal (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    (SheafOfModules.unit (structureRingSheaf B S hS X)).val.Submodule where
  obj U := vanishingIdealAt B S hS X f U.unop
  map {U V} h := by
    simp only [vanishingIdealAt]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    change (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map h
        (unitSectionValue B S hS X (f i) U) ∈ vanishingIdealAt B S hS X f V.unop
    rw [show (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map h
        (unitSectionValue B S hS X (f i) U) = unitSectionValue B S hS X (f i) V from
      (f i).property h]
    exact Submodule.subset_span ⟨i, rfl⟩

/-- The sections of `vanishingPresheafIdeal` over an étale chart `U` are the ideal generated by
the restrictions of the functions to `U`. -/
theorem vanishingPresheafIdeal_obj (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : SmallEtale B S hS X.1) :
    (vanishingPresheafIdeal B S hS X f).obj (op U) = vanishingIdealAt B S hS X f U :=
  rfl

/-- The sheaf of ideals of `𝒪_X` generated by a finite family of global regular functions: the
sections lying étale-locally in the ideal generated by their restrictions. -/
def vanishingIdealSheaf (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule :=
  Stacks.SheafOfModules.localClosure _ (vanishingPresheafIdeal B S hS X f)

/-- A section `s` over `U` lies in `vanishingIdealSheaf` if and only if the sieve of étale maps
to `U` along which `s` restricts into `vanishingPresheafIdeal` is a covering sieve of `U`. -/
theorem mem_vanishingIdealSheaf_obj_iff (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : (SmallEtale B S hS X.1)ᵒᵖ)
    (s : (SheafOfModules.unit (structureRingSheaf B S hS X)).val.obj U) :
    s ∈ (vanishingIdealSheaf B S hS X f).obj U ↔
      (vanishingPresheafIdeal B S hS X f).toSubfunctor.sieveOfSection s ∈
        SmallEtale.topology B S hS X.1 U.unop :=
  Iff.rfl

/-- The ideal generated by the restrictions of the functions is contained in the sections of the
sheaf of ideals they generate. -/
theorem vanishingIdealAt_le_vanishingIdealSheaf_obj (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : SmallEtale B S hS X.1) :
    vanishingIdealAt B S hS X f U ≤ (vanishingIdealSheaf B S hS X f).obj (op U) := fun _ hs =>
  (vanishingPresheafIdeal B S hS X f).toSubfunctor.le_sheafify
    (SmallEtale.topology B S hS X.1) (op U) hs

/-! ### Étale descent of membership in the ideal of the functions -/

/-- **Étale descent of membership in the ideal generated by finitely many global regular
functions.**  A regular function on an affine étale chart `U` of `X` which lies in the ideal
generated by the restrictions of `f₁, …, f_r` after restriction along every member of some
covering sieve of `U` already lies in the ideal generated by `f₁|_U, …, f_r|_U`.

This is `AlgebraicGeometry.Space.mem_span_eval_of_mem_topology` for the structure sheaf, which
is cartesian on affine charts unconditionally
(`AlgebraicGeometry.Space.isCartesianOnAffineCharts_unit`), so no quasi-coherence hypothesis
appears. -/
theorem mem_vanishingIdealAt_of_mem_topology (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    {U : SmallEtale B S hS X.1}
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U))
    {T : Sieve U} (hT : T ∈ SmallEtale.topology B S hS X.1 U)
    {s : ToType ((structureRingSheaf B S hS X).obj.obj (op U))}
    (hs : ∀ ⦃V : SmallEtale B S hS X.1⦄ (h : V ⟶ U), T h →
      (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map h.op s ∈
        vanishingIdealAt B S hS X f V) :
    s ∈ vanishingIdealAt B S hS X f U :=
  mem_span_eval_of_mem_topology (SheafOfModules.unit (structureRingSheaf B S hS X))
    isCartesianOnAffineCharts_unit f hU hT fun _ h hTh => hs h hTh

/-- **The sections over an affine étale chart of the sheaf of ideals generated by finitely many
global regular functions are the ideal generated by their restrictions.**

One containment is unconditional; the other is the étale descent
`AlgebraicGeometry.Space.mem_vanishingIdealAt_of_mem_topology`.  Affineness of the chart is what
makes a covering sieve of it refinable by a finite family of affine charts, over which the
product of the rings of regular functions is faithfully flat. -/
theorem vanishingIdealSheaf_obj_of_isAffine (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (vanishingIdealSheaf B S hS X f).obj (op U) = vanishingIdealAt B S hS X f U :=
  le_antisymm (fun _ hs => mem_vanishingIdealAt_of_mem_topology B S hS X f hU hs fun _ _ => id)
    (vanishingIdealAt_le_vanishingIdealSheaf_obj B S hS X f U)

/-! ### Quasi-coherence, and the closed subspace cut out by the functions -/

/-- **The base change comparison of the sheaf of ideals generated by finitely many global
regular functions is surjective over every morphism of étale charts whose source has affine
underlying scheme.**

Over the smaller chart its sections are the ideal generated by the restrictions of the functions
(`AlgebraicGeometry.Space.vanishingIdealSheaf_obj_of_isAffine`), and those restrictions are the
images of the functions over the larger chart, which are sections there for free; so the
comparison hits a generating family.  Affineness of the larger chart is not used: it is only the
sections over the smaller one that have to be computed. -/
theorem surjective_sectionsBaseChange_vanishingIdealSheaf (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections)
    {U V : SmallEtale B S hS X.1}
    (hV : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    (φ : V ⟶ U) :
    Function.Surjective
      (sectionsBaseChange (vanishingIdealSheaf B S hS X f).toSheafOfModules φ) := by
  let _ := chartAlgebra (hF := X.2) φ
  let I := vanishingIdealSheaf B S hS X f
  have hmemU : ∀ i, unitSectionValue B S hS X (f i) (op U) ∈ I.obj (op U) := fun i =>
    vanishingIdealAt_le_vanishingIdealSheaf_obj B S hS X f U (Submodule.subset_span ⟨i, rfl⟩)
  let Q : Ideal (chartRing B S hS X.1 X.2 V) :=
    { carrier := {b | ∃ z, ((sectionsBaseChange I.toSheafOfModules φ z).1 :
        chartRing B S hS X.1 X.2 V) = b}
      zero_mem' := ⟨0, congrArg Subtype.val (map_zero _)⟩
      add_mem' := fun ⟨zx, hzx⟩ ⟨zy, hzy⟩ =>
        ⟨zx + zy, (congrArg Subtype.val (map_add _ zx zy)).trans (congrArg₂ (· + ·) hzx hzy)⟩
      smul_mem' := fun c _ ⟨z, hz⟩ => ⟨c • z, by
        rw [map_smul]
        exact congrArg (fun b => c * b) hz⟩ }
  have hgen : ∀ b : chartRing B S hS X.1 X.2 V, b ∈ I.obj (op V) → b ∈ Q := by
    intro b hb
    rw [show I.obj (op V) = vanishingIdealAt B S hS X f V from
      vanishingIdealSheaf_obj_of_isAffine B S hS X f V hV] at hb
    refine Submodule.span_le.mpr ?_ hb
    rintro _ ⟨i, rfl⟩
    refine ⟨TensorProduct.tmul _ (1 : chartRing B S hS X.1 X.2 V)
      (⟨unitSectionValue B S hS X (f i) (op U), hmemU i⟩ :
        I.toSheafOfModules.val.obj (op U)), ?_⟩
    exact (congrArg (fun w : I.toSheafOfModules.val.obj (op V) =>
      (w.1 : chartRing B S hS X.1 X.2 V))
        (chartBaseChange_one_tmul I.toSheafOfModules φ
          (⟨unitSectionValue B S hS X (f i) (op U), hmemU i⟩ :
            I.toSheafOfModules.val.obj (op U)))).trans ((f i).property φ.op)
  exact fun y => (hgen _ y.2).imp fun _ hz => Subtype.ext hz

/-- **The sheaf of ideals generated by finitely many global regular functions is cartesian on
affine charts.**  For a sheaf of ideals of `𝒪_X` the injectivity half of the comparison is
unconditional, so the surjectivity above suffices. -/
theorem isCartesianOnAffineCharts_vanishingIdealSheaf (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    IsCartesianOnAffineCharts (vanishingIdealSheaf B S hS X f).toSheafOfModules :=
  isCartesianOnAffineCharts_submodule_unit_of_surjective B S hS X _
    fun _ _ _ hV φ => surjective_sectionsBaseChange_vanishingIdealSheaf B S hS X f hV φ

/-- **The sheaf of ideals generated by finitely many global regular functions on an algebraic
space is quasi-coherent on its small étale site**, unconditionally. -/
theorem isQuasicoherentOnSite_vanishingIdealSheaf (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    (vanishingIdealSheaf B S hS X f).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_vanishingIdealSheaf B S hS X f)

/-- **`V(f₁, …, f_r)` is a closed subspace whose defining ideal sheaf is the sheaf of ideals
generated by `f₁, …, f_r`**, with no hypothesis.

The defining ideal on every affine étale chart is therefore the ideal generated by the
restrictions `f₁|_U, …, f_r|_U`, which is what
`AlgebraicGeometry.Space.vanishingSubfunctor_eq` asks for and what identifying the base change
of `V(f₁, …, f_r)` along an étale chart with a scheme-theoretic zero scheme needs. -/
theorem exists_vanishingSubfunctor_eq (X : AlgebraicSpaces B S hS) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) :
    ∃ Z : ClosedSubspaces B S hS X.1,
      vanishingSubfunctor B S hS X f = Z.1 ∧
        definingIdealSheaf B S hS X Z = vanishingIdealSheaf B S hS X f :=
  exists_vanishingSubfunctor_eq_of_isQuasicoherentOnSite B S hS X f
    (vanishingIdealSheaf B S hS X f) (isQuasicoherentOnSite_vanishingIdealSheaf B S hS X f)
    fun U hU => vanishingIdealSheaf_obj_of_isAffine B S hS X f U hU

end AlgebraicGeometry.Space

end
