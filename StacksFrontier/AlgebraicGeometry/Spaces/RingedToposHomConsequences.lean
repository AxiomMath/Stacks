/-!
# Consequences of the morphism of small étale ringed topoi

The morphism of small étale ringed topoi `(f_small, f♯)` of a morphism `f : X ⟶ Y` of
algebraic spaces (Stacks 03G8) is
`AlgebraicGeometry.Space.smallEtaleRingedToposHom`.  This file collects the vocabulary that
statements *about* that morphism need, and the one bridge from it back to the computable
structure map `AlgebraicGeometry.Space.structureSharp`.

## Main definitions

* `SheafOfModules.idealMultiple`: for an ideal `I` of the structure sheaf of a site and a
  sheaf of modules `F`, the subsheaf of `F` generated by the local products `a • s` with `a`
  a local section of `I` and `s` a local section of `F`.  This is the subsheaf written
  `I𝓕` in Stacks 0GF8.
* `SheafOfModules.submoduleImage`: the image of a morphism of sheaves of modules, as a
  subsheaf of its target.

## Main results

* `SheafOfModules.idealMultiple_le_iff` and `SheafOfModules.smul_mem_idealMultiple`: the
  universal property of `SheafOfModules.idealMultiple`, namely that it is the least
  subsheaf containing every product `a • s`.
* `SheafOfModules.mem_submoduleImage` and `SheafOfModules.submoduleImage_le`: the universal
  property of `SheafOfModules.submoduleImage`, namely that it is the least subsheaf through
  which the morphism factors, and that it does contain every section in the image.
* `AlgebraicGeometry.Space.mono_fSharp_of_mono_structureSharp`: injectivity of the
  structure map of sheaves of *rings* gives injectivity of the structure map of the
  morphism of ringed topoi.

## Implementation notes

Both subsheaf constructions are infima of a set of subsheaves, as in Stacks 0GF8, rather
than sheafifications of a presheaf image: subsheaves of a sheaf of modules form a complete
lattice whose infimum is computed objectwise
(`SheafOfModules.Submodule.toSubmodule_sInf`), so the defining property is available
without a sheafification argument.  Neither construction is tagged: the content of
Stacks 0GF8 is the comparison of `SheafOfModules.idealMultiple` with the direct image along
an affine morphism, and these are the two auxiliary definitions that comparison is phrased
with.

`SheafOfModules.idealMultiple` leaves the module universe of `F` free, while
`SheafOfModules.submoduleImage` ties the two modules to the universe of the coefficient
ring sheaf; that is the generality each is used in, and in both cases it is the generality
in which Mathlib's `SheafOfModules.Submodule` lattice is available.

`AlgebraicGeometry.Space.mono_fSharp_of_mono_structureSharp` goes in one direction only.
Forgetting commutativity on sheaves is fully faithful
(`Stacks.Sheaves.ToposPullback.fullyFaithfulForgetCommRingSheaf`), hence *reflects*
monomorphisms, which is this direction.  The converse needs that functor to *preserve*
monomorphisms, which full faithfulness does not give; it would follow from a description of
monomorphisms of sheaves of rings by injectivity on sections, which is not available.  The
direction proved here is the one that produces the hypothesis of Stacks 0B8B from the chart
formula `AlgebraicGeometry.Space.chartProjection_structureMapApp`.

## References

* [Stacks Project, Tag 0GF8](https://stacks.math.columbia.edu/tag/0GF8)
* [Stacks Project, Tag 03G8](https://stacks.math.columbia.edu/tag/03G8)
-/

@[expose] public section

open CategoryTheory Opposite

universe v u w m

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}

/-! ### The multiple of a sheaf of modules by an ideal -/

section IdealMultiple

/-- Membership of a section in the infimum of a set of subsheaves is checked on each member. -/
private theorem mem_sInf_toSubmodule_obj {F : SheafOfModules.{m} R} (T : Set F.Submodule)
    (U : Cᵒᵖ) (x : F.val.obj U) :
    x ∈ (sInf T).toSubmodule.obj U ↔ ∀ N ∈ T, x ∈ N.toSubmodule.obj U := by
  rw [Submodule.toSubmodule_sInf, PresheafOfModules.Submodule.sInf_obj]
  simp [_root_.Submodule.mem_iInf]

/-- The subsheaf of `F` generated by the local products of a section of the ideal `I` of the
structure sheaf with a section of `F`.  This is the subsheaf written `I𝓕` in
Stacks 0GF8. -/
noncomputable def idealMultiple (I : (SheafOfModules.unit R).Submodule)
    (F : SheafOfModules.{m} R) : F.Submodule :=
  sInf {N : F.Submodule | ∀ (U : Cᵒᵖ)
    (a : I.toSheafOfModules.val.obj U) (s : F.val.obj U),
    (show R.obj.obj U from I.ι.val.app U a) • s ∈ N.toSubmodule.obj U}

variable (I : (SheafOfModules.unit R).Submodule) (F : SheafOfModules.{m} R)

/-- The multiple of `F` by the ideal `I` contains every product of a section of `I` with a
section of `F`. -/
theorem smul_mem_idealMultiple (U : Cᵒᵖ) (a : I.toSheafOfModules.val.obj U)
    (s : F.val.obj U) :
    (show R.obj.obj U from I.ι.val.app U a) • s ∈
      (idealMultiple I F).toSubmodule.obj U := by
  rw [idealMultiple, mem_sInf_toSubmodule_obj]
  exact fun N hN ↦ hN U a s

/-- The multiple of `F` by the ideal `I` is the least subsheaf of `F` containing every
product of a section of `I` with a section of `F`. -/
theorem idealMultiple_le_iff {N : F.Submodule} :
    idealMultiple I F ≤ N ↔
      ∀ (U : Cᵒᵖ) (a : I.toSheafOfModules.val.obj U) (s : F.val.obj U),
        (show R.obj.obj U from I.ι.val.app U a) • s ∈ N.toSubmodule.obj U := by
  refine ⟨fun h U a s ↦ h _ (smul_mem_idealMultiple I F U a s), fun h ↦ ?_⟩
  exact sInf_le h

end IdealMultiple

/-! ### The image of a morphism of sheaves of modules -/

section SubmoduleImage

variable {F G : SheafOfModules.{w} R}

/-- The image of a morphism of sheaves of modules, as a subsheaf of its target: the least
subsheaf of the target through which the morphism factors. -/
noncomputable def submoduleImage (h : F ⟶ G) : G.Submodule :=
  sInf {N : G.Submodule | ∃ lift : F ⟶ N.toSheafOfModules, lift ≫ N.ι = h}

/-- The image of `h` is contained in any subsheaf of the target through which `h`
factors. -/
theorem submoduleImage_le {h : F ⟶ G} {N : G.Submodule} (lift : F ⟶ N.toSheafOfModules)
    (hlift : lift ≫ N.ι = h) : submoduleImage h ≤ N :=
  sInf_le ⟨lift, hlift⟩

/-- Every section in the set-theoretic image of `h` is a section of the image subsheaf
of `h`. -/
theorem mem_submoduleImage (h : F ⟶ G) (U : Cᵒᵖ) (x : F.val.obj U) :
    h.val.app U x ∈ (submoduleImage h).toSubmodule.obj U := by
  rw [submoduleImage, mem_sInf_toSubmodule_obj]
  rintro N ⟨lift, hlift⟩
  subst hlift
  exact (lift.val.app U x).2

end SubmoduleImage

end SheafOfModules

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

variable {X Y : AlgebraicSpaces B S hS}

/-- If the structure map `f♯ : 𝒪_Y ⟶ f_*𝒪_X` of sheaves of *rings* is a monomorphism, then
so is the structure map of the morphism of small étale ringed topoi of Stacks 03G8. -/
theorem mono_fSharp_of_mono_structureSharp (f : X ⟶ Y)
    (h : Mono (structureSharp B S hS f)) :
    Mono (smallEtaleRingedToposHom B S hS f).fSharp := by
  have := (Stacks.Sheaves.ToposPullback.fullyFaithfulForgetCommRingSheaf.{u, u, u + 1}
    (SmallEtale.topology B S hS Y.1)).faithful
  refine (sheafCompose (SmallEtale.topology B S hS Y.1)
    (forget₂ CommRingCat.{u} RingCat.{u})).mono_of_mono_map ?_
  rw [forgetCommRingSheaf_map_fSharp]
  exact h

end AlgebraicGeometry.Space

end
