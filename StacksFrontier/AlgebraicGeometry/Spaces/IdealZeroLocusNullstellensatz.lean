module

public import StacksFrontier.AlgebraicGeometry.Spaces.HomOverIdealUnitLocus
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealPowerSupport

/-!
# The Nullstellensatz for sheaves of ideals on a Noetherian algebraic space

Let `X` be a Noetherian algebraic space over a scheme `S`, and let `𝒦, ℒ ⊆ 𝒪_X` be
quasi-coherent sheaves of ideals. If the zero locus of `𝒦` is contained in the zero locus of
`ℒ`, set theoretically, then `ℒⁿ ⊆ 𝒦` for some `n`.

The proof is local. On an étale chart `U` which is affine with Noetherian ring of sections `R`,
a section `f ∈ ℒ(U)` becomes a unit on the chart `D(f)` cut out by its nonvanishing locus, so
`D(f)` lies over the unit locus of `ℒ`, hence over that of `𝒦`, and `𝒦(D(f))` is the unit
ideal. By quasi-coherence `𝒦(D(f))` is generated by the restrictions of `𝒦(U)`, and
`𝒪_X(D(f)) = R_f`, so some power of `f` lies in `𝒦(U)`. Hence `ℒ(U)` lies in the radical of
`𝒦(U)`, and `ℒ(U)ⁿ ⊆ 𝒦(U)` for some `n` because `R` is Noetherian. If `U` is moreover
surjective, every chart is covered by affine charts mapping to `U`; on those, `ℒ` is generated by
the restrictions of `ℒ(U)` and `𝒦` contains the restrictions of `𝒦(U)`, so the inclusion
`ℒⁿ ⊆ 𝒦` holds on them, and it holds everywhere because membership in `𝒦` is local.

## Main results

* `AlgebraicGeometry.Space.chartSectionIdeal_le_radical_of_idealZeroLocus_subset`: over a
  Noetherian affine chart, `ℒ(U) ⊆ √𝒦(U)`.
* `AlgebraicGeometry.Space.exists_idealPow_le_of_idealZeroLocus_subset`: **the Nullstellensatz**,
  `V(𝒦) ⊆ V(ℒ)` implies `ℒⁿ ⊆ 𝒦` for some `n`.

## Implementation notes

The power `ℒⁿ` is `Stacks.Sites.idealPow`, the smallest sheaf of ideals containing the
objectwise `n`-th powers of the ideals of sections, and the zero loci are the point sets
`AlgebraicGeometry.Space.idealZeroLocus`. Only `𝒦` and `ℒ` need be quasi-coherent; finite
type of `ℒ` is automatic over a Noetherian ring of sections.

## References

* [Stacks Project, Tag 07UK](https://stacks.math.columbia.edu/tag/07UK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- If an ideal `K` of `R` generates the unit ideal of the localization `R_f`, then some power
of `f` lies in `K`. -/
private theorem pow_mem_of_map_eq_top {R R' : Type*} [CommRing R] [CommRing R'] [Algebra R R']
    (f : R) (hR' : IsLocalization.Away f R') {K : Ideal R}
    (hK : Ideal.map (algebraMap R R') K = ⊤) : ∃ k : ℕ, f ^ k ∈ K := by
  have h1 : (1 : R') ∈ Ideal.map (algebraMap R R') K := hK ▸ Submodule.mem_top
  obtain ⟨⟨⟨a, ha⟩, ⟨m, hm⟩⟩, hx⟩ :=
    (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f) R').1 h1
  obtain ⟨j, rfl⟩ := (Submonoid.mem_powers_iff _ _).1 hm
  simp only [one_mul] at hx
  obtain ⟨⟨c, hc⟩, hcx⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers f) R').1 hx
  obtain ⟨i, rfl⟩ := (Submonoid.mem_powers_iff _ _).1 hc
  refine ⟨i + j, ?_⟩
  rw [pow_add, hcx]
  exact K.mul_mem_left _ ha

/-- **The local Nullstellensatz.** Let `𝒦, ℒ ⊆ 𝒪_X` be sheaves of ideals on an algebraic space
with `V(𝒦) ⊆ V(ℒ)`, `𝒦` quasi-coherent. Over an étale chart `U` with affine underlying scheme,
`ℒ(U)` lies in the radical of `𝒦(U)`. -/
theorem chartSectionIdeal_le_radical_of_idealZeroLocus_subset (X : AlgebraicSpaces B S hS)
    (K L : IdealSheaves B S hS X.1 X.2) (hK : K.toSheafOfModules.IsQuasicoherentOnSite)
    (h : idealZeroLocus B S hS X K ⊆ idealZeroLocus B S hS X L)
    (U : SmallEtale B S hS X.1) (hU : IsAffine (chartScheme U)) :
    chartSectionIdeal B S hS X.1 X.2 L U ≤ (chartSectionIdeal B S hS X.1 X.2 K U).radical := by
  intro f hf
  let V := openChart B S hS X.1 U ((chartScheme U).basicOpen f)
  let g := openChartInclusion B S hS X.1 U ((chartScheme U).basicOpen f)
  let _ := chartAlgebra (hF := X.2) g
  have hloc := isLocalization_away_chartRing_basicOpen (hF := X.2) hU f
  have hVaff : IsAffine (chartScheme V) := (isAffineOpen_top (chartScheme U)).basicOpen f
  -- `ℒ` is the unit ideal on the nonvanishing locus of `f`
  have hLV : L.obj (op V) = ⊤ := by
    have hunit : IsUnit (chartRestrict (hF := X.2) g f) :=
      IsLocalization.map_units (M := Submonoid.powers f) (chartRing B S hS X.1 X.2 V)
        ⟨f, Submonoid.mem_powers f⟩
    exact Ideal.eq_top_of_isUnit_mem _ (Stacks.Sites.map_mem_sectionIdeal L g.op hf) hunit
  -- hence so is `𝒦`, the unit locus of `ℒ` lying in that of `𝒦`
  have hKV : K.obj (op V) = ⊤ := by
    refine idealSheaf_obj_eq_top_of_range_subset_idealUnitLocus B S hS X K V fun x hx => ?_
    by_contra hxK
    exact h hxK ⟨V, hLV, hx⟩
  -- quasi-coherence: `𝒦(D(f))` is generated by the restrictions of `𝒦(U)`
  have hcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2
    K.toSheafOfModules hK U V hU hVaff g
  have hle := chartIdeal_le_map_chartRestrict B S hS X.1 X.2 K g hcart.2
  have hmap : Ideal.map (algebraMap (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V))
      (chartSectionIdeal B S hS X.1 X.2 K U) = ⊤ :=
    top_le_iff.1 (hKV ▸ hle)
  exact Ideal.mem_radical_iff.2 (pow_mem_of_map_eq_top f hloc hmap)

/-- **The Nullstellensatz on a Noetherian affine chart.** Under the hypotheses of
`AlgebraicGeometry.Space.chartSectionIdeal_le_radical_of_idealZeroLocus_subset`, over an étale
chart which is affine with Noetherian ring of sections, `ℒ(U)ⁿ ⊆ 𝒦(U)` for some `n`. -/
theorem exists_chartSectionIdeal_pow_le_of_idealZeroLocus_subset (X : AlgebraicSpaces B S hS)
    (K L : IdealSheaves B S hS X.1 X.2) (hK : K.toSheafOfModules.IsQuasicoherentOnSite)
    (h : idealZeroLocus B S hS X K ⊆ idealZeroLocus B S hS X L)
    (U : SmallEtale B S hS X.1) (hU : IsNoetherianAffineChart B S hS X.1 U) :
    ∃ n : ℕ, chartSectionIdeal B S hS X.1 X.2 L U ^ n ≤ chartSectionIdeal B S hS X.1 X.2 K U := by
  have hUn : IsNoetherianRing (chartRing B S hS X.1 X.2 U) := hU.2
  exact Ideal.exists_pow_le_of_le_radical_of_fg
    (chartSectionIdeal_le_radical_of_idealZeroLocus_subset B S hS X K L hK h U hU.1)
    (IsNoetherian.noetherian _)

/-- **The Nullstellensatz for sheaves of ideals on a Noetherian algebraic space.** Let `X` be a
Noetherian algebraic space and let `𝒦, ℒ ⊆ 𝒪_X` be quasi-coherent sheaves of ideals with
`V(𝒦) ⊆ V(ℒ)`. Then `ℒⁿ ⊆ 𝒦` for some `n`. -/
theorem exists_idealPow_le_of_idealZeroLocus_subset (hZ : B.Contains (⊤_ Scheme.{u}))
    (X : AlgebraicSpaces B S hS) (hN : IsNoetherian B S hS hZ X.1)
    (K L : IdealSheaves B S hS X.1 X.2) (hK : K.toSheafOfModules.IsQuasicoherentOnSite)
    (hL : L.toSheafOfModules.IsQuasicoherentOnSite)
    (h : idealZeroLocus B S hS X K ⊆ idealZeroLocus B S hS X L) :
    ∃ n : ℕ, Stacks.Sites.idealPow L n ≤ K := by
  obtain ⟨U, hU, hUsurj, -⟩ := exists_surjective_isNoetherianAffineChart B S hS hZ X hN
  obtain ⟨n, hn⟩ := exists_chartSectionIdeal_pow_le_of_idealZeroLocus_subset B S hS X K L hK h U hU
  have hLcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2
    L.toSheafOfModules hL
  -- the inclusion over affine charts mapping to `U`
  have haff : ∀ {A : SmallEtale B S hS X.1}, IsAffine (chartScheme A) → (A ⟶ U) →
      chartSectionIdeal B S hS X.1 X.2 L A ^ n ≤ chartSectionIdeal B S hS X.1 X.2 K A := by
    intro A hA e
    calc chartSectionIdeal B S hS X.1 X.2 L A ^ n
        ≤ Ideal.map (chartRestrict (hF := X.2) e) (chartSectionIdeal B S hS X.1 X.2 L U) ^ n :=
          Ideal.pow_right_mono
            (chartIdeal_le_map_chartRestrict B S hS X.1 X.2 L e (hLcart U A hU.1 hA e).2) n
      _ = Ideal.map (chartRestrict (hF := X.2) e) (chartSectionIdeal B S hS X.1 X.2 L U ^ n) :=
          (Ideal.map_pow _ _ _).symm
      _ ≤ Ideal.map (chartRestrict (hF := X.2) e) (chartSectionIdeal B S hS X.1 X.2 K U) :=
          Ideal.map_mono hn
      _ ≤ chartSectionIdeal B S hS X.1 X.2 K A :=
          Ideal.map_le_iff_le_comap.2 fun _ ha =>
            Ideal.mem_comap.2 (chartIdeal_map_mem B S hS X.1 X.2 K e ha)
  have key : ∀ (W : SmallEtale B S hS X.1) (r : chartRing B S hS X.1 X.2 W),
      r ∈ chartSectionIdeal B S hS X.1 X.2 L W ^ n → r ∈ chartSectionIdeal B S hS X.1 X.2 K W := by
    intro W r hr
    obtain ⟨Sv, hSv, hfac⟩ := exists_covering_through_affine_over B S hS X.1 U hUsurj W
    refine K.isSheaf r ((SmallEtale.topology B S hS X.1).superset_covering ?_ hSv)
    intro Y f hf
    obtain ⟨A, l, m, e, hA, rfl⟩ := hfac f hf
    have hlm : chartRestrict (hF := X.2) (l ≫ m) r ∈ chartSectionIdeal B S hS X.1 X.2 K Y := by
      rw [chartRestrict_comp]
      exact chartIdeal_map_mem B S hS X.1 X.2 K l
        (haff hA e (map_chartIdeal_pow_le B S hS X.1 X.2 L m n (Ideal.mem_map_of_mem _ hr)))
    exact hlm
  exact ⟨n, Stacks.Sites.idealPow_le L n fun W r hr => key W.unop r hr⟩

end AlgebraicGeometry.Space

end
