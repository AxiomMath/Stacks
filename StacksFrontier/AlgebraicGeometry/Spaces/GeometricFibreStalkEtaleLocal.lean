module

public import StacksFrontier.AlgebraicGeometry.Spaces.GeometricFibreStalkBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleFlatTopos
public import StacksFrontier.AlgebraicGeometry.Spaces.SmoothAtlas

/-!
# Clause (1) of Stacks 0CZS is étale-local on the source

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` of a big fppf site, let
`a : V ⟶ X` be étale, let `F` be an `𝒪_X`-module and let `v̄` be a geometric point of `V` with
image `x̄ = a ∘ v̄`.  Clause (1) of Stacks 0CZS — flatness of the geometric fibre stalk — holds
for `a^* F` at `v̄` relative to `a ≫ f` exactly when it holds for `F` at `x̄` relative to `f`.

## Main results

* `AlgebraicGeometry.Space.flat_geometricFibreModuleStalk_comp_modulePullback_iff`: **clause (1)
  of Stacks 0CZS is étale-local on the source.**

## Implementation notes

This is cheaper than the base-change invariance
`AlgebraicGeometry.Space.flat_geometricFibreModuleStalk_modulePullback_iff` and is not a case of
it: here the ideal upstairs *is* the ideal generated by the one downstairs, because the canonical
homomorphisms of étale local rings of Stacks 04NG compose
(`AlgebraicGeometry.Space.etaleLocalRingMap_comp`), so `Ideal.map_map` identifies the two fibre
ideals outright and no comparison of a pushout is needed.

Writing `A` and `A_V` for the étale local rings of `X` at `x̄` and of `V` at `v̄`, the map
`A → A_V` is flat because `a` is étale, hence flat (Stacks 0467 and the criterion of
Stacks 04NG), and it is a local homomorphism of local rings (Stacks 08AH), so it is faithfully
flat; faithful flatness survives dividing by the fibre ideal.  On modules `A_V ⊗_A F_{x̄}` is
the stalk of `a^* F` at `v̄` by Stacks 05VQ, so Stacks 0584 (2) in the form
`Module.Flat.quotSMul_baseChange_iff_of_le` gives both directions.

No hypothesis on `F` is used — not even quasi-coherence, the comparison of Stacks 05VQ carrying
none.

## References

* [Stacks Project, Tag 0CZS](https://stacks.math.columbia.edu/tag/0CZS)
* [Stacks Project, Tag 04NG](https://stacks.math.columbia.edu/tag/04NG)
* [Stacks Project, Tag 05VQ](https://stacks.math.columbia.edu/tag/05VQ)
* [Stacks Project, Tag 0584](https://stacks.math.columbia.edu/tag/0584)
* [Stacks Project, Tag 0467](https://stacks.math.columbia.edu/tag/0467)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

open scoped TensorProduct

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The fibre ideal of a composite is generated by the fibre ideal of its second factor.**  For
`a : V ⟶ X` and `f : X ⟶ Y` and a geometric point `v̄` of `V`, the ideal `𝔪_{ȳ} 𝒪_{V, v̄}` is the
image of `𝔪_{ȳ} 𝒪_{X, x̄}` along the canonical map of étale local rings of `a`.

This is `Ideal.map_map` over the composition law of Stacks 04NG,
`AlgebraicGeometry.Space.etaleLocalRingMap_comp`.  It is a separate declaration because the two
spellings of the image point — `(a ≫ f) ∘ v̄` and `f ∘ (a ∘ v̄)` — are definitionally but not
syntactically equal, and crossing them underneath `Ideal.map`'s instance arguments does not fit
in one elaboration budget. -/
theorem geometricFibreIdeal_comp {V X Y : AlgebraicSpaces B S hS} (a : V ⟶ X) (f : X ⟶ Y)
    (vbar : GeometricPoint B S hS V.1) :
    geometricFibreIdeal B S hS (a ≫ f) vbar =
      (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar)).map
        (etaleLocalRingMap V.2 a.hom vbar) := by
  let : IsLocalRing ↥(etaleLocalRing B S hS Y.1
      (geometricPointMap f.hom (geometricPointMap a.hom vbar))) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 _
  have h1 : geometricFibreIdeal B S hS (a ≫ f) vbar =
      (maximalIdeal ↥(etaleLocalRing B S hS Y.1
        (geometricPointMap f.hom (geometricPointMap a.hom vbar)))).map
        (etaleLocalRingMap V.2 (a.hom ≫ f.hom) vbar) := rfl
  have h2 : geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar) =
      (maximalIdeal ↥(etaleLocalRing B S hS Y.1
        (geometricPointMap f.hom (geometricPointMap a.hom vbar)))).map
        (etaleLocalRingMap X.2 f.hom (geometricPointMap a.hom vbar)) := rfl
  rw [h1, h2, Ideal.map_map, etaleLocalRingMap_comp V.2 X.2 a.hom f.hom vbar]
  rfl

/-- **Clause (1) of Stacks 0CZS is étale-local on the source.**  For `a : V ⟶ X` étale and `v̄` a
geometric point of `V` above `x̄ = a ∘ v̄`, the fibre stalk of `F` at `x̄` is flat over the fibre
local ring of `f` at `x̄` exactly when the fibre stalk of `a^* F` at `v̄` is flat over the fibre
local ring of `a ≫ f` at `v̄`.

The two fibre ideals are related by `Ideal.map` along the étale local ring map of `a`, because
those maps compose (Stacks 04NG), and that map is faithfully flat because `a` is étale and local;
Stacks 05VQ identifies the stalk upstairs with the base change, so Stacks 0584 (2) applies. -/
theorem flat_geometricFibreModuleStalk_comp_modulePullback_iff
    {V X Y : AlgebraicSpaces B S hS} {a : V ⟶ X} (hae : IsEtale B S hS a.hom) (f : X ⟶ Y)
    (F : Modules.{u, u} B S hS X.1 X.2) (vbar : GeometricPoint B S hS V.1) :
    Module.Flat (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
        (geometricFibreModuleStalk B S hS f F (geometricPointMap a.hom vbar)) ↔
      Module.Flat (geometricFibreLocalRing B S hS (a ≫ f) vbar)
        (geometricFibreModuleStalk B S hS (a ≫ f)
          ((modulePullback B S hS a).obj F) vbar) := by
  let : Algebra ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar))
      ↥(etaleLocalRing B S hS V.1 vbar) := (etaleLocalRingMap V.2 a.hom vbar).toAlgebra
  let : IsLocalRing ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar)) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS V.1 vbar) :=
    isLocalRing_etaleLocalRing B S hS V.1 V.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS Y.1
      (geometricPointMap f.hom (geometricPointMap a.hom vbar))) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 _
  have : IsLocalHom (algebraMap ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar))
      ↥(etaleLocalRing B S hS V.1 vbar)) := by
    rw [RingHom.algebraMap_toAlgebra]
    exact isLocalHom_etaleLocalRingMap B S hS V.2 X.2 a.hom vbar
  have : Module.Flat ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar))
      ↥(etaleLocalRing B S hS V.1 vbar) :=
    (isFlat_iff_forall_etaleLocalRingMap_flat B S hS a).1 (isFlat_of_isEtale B S hS hae) vbar
  -- the fibre ideal upstairs is generated by the one downstairs, the étale local ring maps
  -- composing by Stacks 04NG
  have hJ' : geometricFibreIdeal B S hS (a ≫ f) vbar =
      (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar)).map
        (algebraMap ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar))
          ↥(etaleLocalRing B S hS V.1 vbar)) := by
    rw [RingHom.algebraMap_toAlgebra]
    exact geometricFibreIdeal_comp B S hS a f vbar
  have hJ : (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar)).map
      (algebraMap ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar))
        ↥(etaleLocalRing B S hS V.1 vbar)) ≤
      geometricFibreIdeal B S hS (a ≫ f) vbar := le_of_eq hJ'.symm
  let : Algebra (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
      (geometricFibreLocalRing B S hS (a ≫ f) vbar) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1 hJ)
  let : IsLocalRing (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar)) :=
    isLocalRing_geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar)
  let : IsLocalRing (geometricFibreLocalRing B S hS (a ≫ f) vbar) :=
    isLocalRing_geometricFibreLocalRing B S hS (a ≫ f) vbar
  have : Module.Flat (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
      (geometricFibreLocalRing B S hS (a ≫ f) vbar) :=
    Module.Flat.quotient_map_of_idealSMul
      (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar))
      (geometricFibreIdeal B S hS (a ≫ f) vbar) hJ'
  have : IsLocalHom (algebraMap
      (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
      (geometricFibreLocalRing B S hS (a ≫ f) vbar)) := by
    have : IsLocalHom ((algebraMap
        (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
        (geometricFibreLocalRing B S hS (a ≫ f) vbar)).comp
        (Ideal.Quotient.mk
          (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar)))) := by
      have hcomp : (algebraMap
            (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
            (geometricFibreLocalRing B S hS (a ≫ f) vbar)).comp
          (Ideal.Quotient.mk
            (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar))) =
          (Ideal.Quotient.mk (geometricFibreIdeal B S hS (a ≫ f) vbar)).comp
            (algebraMap ↥(etaleLocalRing B S hS X.1 (geometricPointMap a.hom vbar))
              ↥(etaleLocalRing B S hS V.1 vbar)) := RingHom.ext fun _ => rfl
      have : IsLocalHom (Ideal.Quotient.mk
          (geometricFibreIdeal B S hS (a ≫ f) vbar)) :=
        IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
      rw [hcomp]
      exact RingHom.isLocalHom_comp _ _
    exact IsLocalRing.isLocalHom_of_isLocalHom_comp _
      (Ideal.Quotient.mk (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar)))
      Ideal.Quotient.mk_surjective
  have : Module.FaithfullyFlat
      (geometricFibreLocalRing B S hS f (geometricPointMap a.hom vbar))
      (geometricFibreLocalRing B S hS (a ≫ f) vbar) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact Module.Flat.quotSMul_baseChange_iff_of_le ↥(etaleLocalRing B S hS V.1 vbar)
    (geometricFibreIdeal B S hS f (geometricPointMap a.hom vbar))
    (geometricFibreIdeal B S hS (a ≫ f) vbar) hJ
    ↥(geometricModuleStalk B S hS X (geometricPointMap a.hom vbar) F)
    (geometricModuleStalkPullbackIso B S hS a vbar F).symm.toLinearEquiv inferInstance

end AlgebraicGeometry.Space

end
