/-!
# Finite type on the small étale site is finiteness of the sections over the affine charts

Let `F` be an algebraic space over a scheme `S` contained in a big fppf site `B`, and let `G`
be an `𝒪_F`-module which is cartesian on affine charts, that is, for which the base change
comparison between two affine étale charts is bijective.  Then `G` is of finite type on the
small étale site, in the categorical sense of Stacks 03DL (5), exactly when its sections over
every affine étale chart form a finite module over the functions on that chart.

The implication from finite type to finiteness of the sections is
`Space.module_finite_sections_of_isCartesianOnAffineCharts_of_isFiniteTypeOnSite`; this file
proves the converse and records the equivalence.

## The converse

Finiteness of the sections over the affine charts has to produce, for every étale chart `W`, a
covering of `W` on each member of which `G` is generated by finitely many global sections.  The
covering is the family of charts cut out by the affine opens of the scheme underlying `W`, and
the generators come from cartesianness: over an affine chart `V` with a morphism `V ⟶ U` to an
affine chart `U`, the sections over `V` are spanned by the restrictions of the sections over
`U`, because the base change comparison is surjective there.

## Main results

* `AlgebraicGeometry.Space.SmallEtale.ofArrows_openChart_affineOpens_mem`: the charts cut out
  by the affine opens of the scheme underlying an étale chart generate a covering sieve of that
  chart.
* `AlgebraicGeometry.Space.span_chartRestrictLinear_eq_top_of_surjective_sectionsBaseChange`:
  where the base change comparison is surjective, restriction carries a spanning family of
  sections to a spanning family.
* `AlgebraicGeometry.Space.hasFiniteGlobalGenerators_over_of_moduleFinite`: over an affine
  étale chart whose sections form a finite module, a module cartesian on affine charts is
  generated by finitely many global sections in the sense of Stacks 03DE (5).
* `AlgebraicGeometry.Space.isFiniteTypeOnSite_of_forall_affine_moduleFinite`: a module
  cartesian on affine charts whose sections over every affine étale chart form a finite module
  is of finite type on the small étale site.
* `AlgebraicGeometry.Space.isFiniteTypeOnSite_iff_forall_affine_moduleFinite`: the equivalence
  of the two conditions.

## References

* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03DE](https://stacks.math.columbia.edu/tag/03DE)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-! ### The covering of a chart by the charts cut out by its affine opens -/

/-- **The étale charts cut out by the affine opens of the scheme underlying an étale chart `W`
generate a covering sieve of `W`.**  This is the covering used by
`AlgebraicGeometry.Space.SmallEtale.coversTop_affineCharts`, recorded at one chart. -/
theorem SmallEtale.ofArrows_openChart_affineOpens_mem (W : SmallEtale B S hS F) :
    Sieve.ofArrows
        (fun O : ULift.{u + 1} ((chartScheme W).affineOpens) =>
          openChart B S hS F W O.down.1)
        (fun O => openChartInclusion B S hS F W O.down.1) ∈
      SmallEtale.topology B S hS F W := by
  set E : PreZeroHypercover.{u + 1} W :=
    { I₀ := ULift.{u + 1} ((chartScheme W).affineOpens)
      X := fun O => openChart B S hS F W O.down.1
      f := fun O => openChartInclusion B S hS F W O.down.1 }
  have hcov : IsEtaleCovering
      (⟨(SmallEtale.toSchemes B S hS F).obj W, E.map (SmallEtale.toSchemes B S hS F)⟩ :
        Covering B.Schemes) := by
    refine (Scheme.presieve₀_mem_precoverage_iff (P := @Etale)
      ((E.map (SmallEtale.toSchemes B S hS F)).map B.inclusion)).2 ⟨?_, ?_⟩
    · intro x
      have hx : x ∈ (⊤ : ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS F).obj W)).Opens) := trivial
      rw [← iSup_affineOpens_eq_top] at hx
      obtain ⟨O, hO⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      refine ⟨ULift.up O, ?_⟩
      have heq := toScheme_map_toOver_map_openChartInclusion B S hS F W (O : _)
      obtain ⟨y, hy⟩ := (Scheme.Opens.range_ι (X := (BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS F).obj W)) (O : _)).ge hO
      refine ⟨y, ?_⟩
      show ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map
        (openChartInclusion B S hS F W (O : _)))) y = x
      rw [heq]
      exact hy
    · intro O
      exact etale_toScheme_toOver_map B S hS F (openChartInclusion B S hS F W O.down.1)
  have hpre : E.presieve₀ ∈ SmallEtale.precoverage B S hS F W := by
    rw [SmallEtale.precoverage_eq_comap, Precoverage.mem_comap_iff,
      ← PreZeroHypercover.presieve₀_map]
    exact B.presieve₀_mem_etalePrecoverage _ hcov
  exact Precoverage.generate_mem_toGrothendieck hpre

/-- The chart cut out by an affine open of the scheme underlying an étale chart is affine. -/
theorem isAffine_chartScheme_openChart (W : SmallEtale B S hS F)
    (O : (chartScheme W).affineOpens) :
    IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj
      (openChart B S hS F W O.1)) :=
  O.2

variable (hF : IsAlgebraicSpace B S hS F)

/-! ### Restriction of a spanning family of sections -/

/-- Restricting a scalar multiple of a restricted section: the scalar restricts and the two
restrictions compose. -/
theorem chartRestrictLinear_smul_chartRestrictLinear (G : Modules.{u, u} B S hS F hF)
    {U V W : SmallEtale B S hS F} (f : V ⟶ U) (k : W ⟶ V)
    (a : chartRing B S hS F hF V) (x : G.val.obj (op U)) :
    chartRestrictLinear G k (a • chartRestrictLinear G f x)
      = chartRestrict (hF := hF) k a • chartRestrictLinear G (k ≫ f) x := by
  rw [chartRestrictLinear_smul, chartRestrictLinear_comp]


/-- **Where the base change comparison is surjective, restriction carries a spanning family of
sections to a spanning family.**  Surjectivity says that the sections over the smaller chart
are spanned by the restrictions of the sections over the larger one, and a spanning family of
the latter therefore restricts to a spanning family. -/
theorem span_chartRestrictLinear_eq_top_of_surjective_sectionsBaseChange
    (G : Modules.{u, u} B S hS F hF) {U V : SmallEtale B S hS F} (m : V ⟶ U)
    (hm : Function.Surjective (sectionsBaseChange G m))
    {ι : Type*} (g : ι → G.val.obj (op U))
    (hg : Submodule.span (chartRing B S hS F hF U) (Set.range g) = ⊤) :
    Submodule.span (chartRing B S hS F hF V)
        (Set.range fun i => chartRestrictLinear G m (g i)) = ⊤ := by
  let := chartAlgebra (hF := hF) m
  let := chartSectionsModule G m
  have hpush : ∀ x : G.val.obj (op U),
      chartRestrictLinear G m x ∈ Submodule.span (chartRing B S hS F hF V)
        (Set.range fun i => chartRestrictLinear G m (g i)) := by
    intro x
    have hx : x ∈ Submodule.span (chartRing B S hS F hF U) (Set.range g) := by
      rw [hg]; exact Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        exact Submodule.subset_span ⟨i, rfl⟩
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
    | smul r a _ ha =>
        rw [map_smul]
        exact Submodule.smul_mem _ _ ha
  have himg : ∀ z, sectionsBaseChange G m z ∈ Submodule.span (chartRing B S hS F hF V)
      (Set.range fun i => chartRestrictLinear G m (g i)) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul b x =>
        rw [chartBaseChange_tmul]
        exact Submodule.smul_mem _ _ (hpush x)
    | add a b ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  refine Submodule.eq_top_iff'.2 fun y => ?_
  obtain ⟨z, hz⟩ := hm y
  exact hz ▸ himg z

/-! ### Finitely many global generators over an affine chart -/

end AlgebraicGeometry.Space

namespace Stacks.SheafOfModules

universe v w

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}

/-- **Sections over an object which span locally on every object above it generate the
restriction of the module to the slice at that object.**

The hypothesis is the sectionwise form of local generation, read over every object `V` of the
site equipped with a morphism `p : V ⟶ U`: some covering sieve of `V` has the property that
over each of its arrows the given section is a combination of the restricted sections. -/
theorem hasFiniteGlobalGenerators_over_of_locally_span (M : SheafOfModules.{w} R) (U : C)
    {n : ℕ} (g : Fin n → M.val.obj (op U))
    (hgen : ∀ (V : C) (p : V ⟶ U) (y : M.val.obj (op V)), ∃ T : Sieve V, T ∈ J V ∧
      ∀ ⦃D : C⦄ (k : D ⟶ V), T.arrows k → ∃ c : Fin n → R.obj.obj (op D),
        ∑ i, c i • (M.val.map (k ≫ p).op).hom (g i) = (M.val.map k.op).hom y) :
    (M.over U).HasFiniteGlobalGenerators := by
  refine hasFiniteGlobalGenerators_of_sections (M.over U)
    (fun i => mkOver (M := M) (V := U) (g i)) ?_
  intro W x
  obtain ⟨T, hT, hc⟩ := hgen W.left W.hom x
  refine ⟨(Sieve.overEquiv W).symm T,
    CategoryTheory.GrothendieckTopology.overEquiv_symm_mem_over _ _ _ hT, ?_⟩
  intro D q hq
  obtain ⟨c, hc'⟩ := hc q.left hq
  refine ⟨c, ?_⟩
  show ∑ i, c i • (M.val.map D.hom.op).hom (g i) = (M.val.map q.left.op).hom x
  refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) hc'
  refine congrArg (fun z => c i • z) ?_
  exact M.val.congr_map_apply (congrArg Quiver.Hom.op (Over.w q).symm) (g i)

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-- **Over an affine étale chart whose sections form a finite module, a module cartesian on
affine charts is generated by finitely many global sections.**

The generators are a finite spanning family of the sections over the chart.  That they generate
locally is cartesianness: every chart above the given one is covered by the charts cut out by
the affine opens of its scheme, each of which is affine, so the base change comparison from the
given chart is bijective there and the restrictions of the chosen sections span. -/
theorem hasFiniteGlobalGenerators_over_of_moduleFinite
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (C : (smallEtaleRingedSite B S hS F hF).C)
    (hC : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj C))
    (hfin : Module.Finite (chartRing B S hS F hF C) (G.val.obj (op C))) :
    SheafOfModules.HasFiniteGlobalGenerators (G.over C) := by
  obtain ⟨n, g, hg⟩ := @Module.Finite.exists_fin _ _ _ _ _ hfin
  refine Stacks.SheafOfModules.hasFiniteGlobalGenerators_over_of_locally_span G C g ?_
  intro V p y
  refine ⟨Sieve.ofArrows
      (fun O : ULift.{u + 1} ((chartScheme V).affineOpens) => openChart B S hS F V O.down.1)
      (fun O => openChartInclusion B S hS F V O.down.1),
    SmallEtale.ofArrows_openChart_affineOpens_mem B S hS F V, ?_⟩
  intro D k hk
  obtain ⟨O, h, hkh⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hk
  have hPaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj
      (openChart B S hS F V O.down.1)) := isAffine_chartScheme_openChart B S hS F V O.down
  have hspan : Submodule.span (chartRing B S hS F hF (openChart B S hS F V O.down.1))
      (Set.range fun i => chartRestrictLinear G
        (openChartInclusion B S hS F V O.down.1 ≫ p) (g i)) = ⊤ :=
    span_chartRestrictLinear_eq_top_of_surjective_sectionsBaseChange B S hS F hF G _
      (hG C (openChart B S hS F V O.down.1) hC hPaff _).surjective g hg
  have hmem : chartRestrictLinear G (openChartInclusion B S hS F V O.down.1) y ∈
      Submodule.span (chartRing B S hS F hF (openChart B S hS F V O.down.1))
        (Set.range fun i => chartRestrictLinear G
          (openChartInclusion B S hS F V O.down.1 ≫ p) (g i)) := by
    rw [hspan]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hmem
  have hcomp : h ≫ (openChartInclusion B S hS F V O.down.1 ≫ p) = k ≫ p := by
    rw [hkh]
    exact (Category.assoc _ _ _).symm
  refine ⟨fun i => chartRestrict (hF := hF) h (c i), ?_⟩
  have hkey : chartRestrictLinear G h
        (∑ i, c i • chartRestrictLinear G
          (openChartInclusion B S hS F V O.down.1 ≫ p) (g i))
      = ∑ i, chartRestrict (hF := hF) h (c i) • chartRestrictLinear G (k ≫ p) (g i) := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    refine Eq.trans (chartRestrictLinear_smul_chartRestrictLinear B S hS F hF G _ h (c i) (g i))
      (congrArg (fun z => chartRestrict (hF := hF) h (c i) • z) ?_)
    exact G.val.congr_map_apply (congrArg Quiver.Hom.op hcomp) (g i)
  show ∑ i, chartRestrict (hF := hF) h (c i) • chartRestrictLinear G (k ≫ p) (g i)
      = chartRestrictLinear G k y
  refine Eq.trans hkey.symm (Eq.trans (congrArg (fun z => chartRestrictLinear G h z) hc) ?_)
  exact Eq.trans (chartRestrictLinear_comp G _ h y).symm
    (G.val.congr_map_apply (congrArg Quiver.Hom.op hkh.symm) y)

/-! ### Finite type on the site from finiteness of the sections over the affine charts -/

/-- **A module cartesian on affine charts whose sections over every affine étale chart form a
finite module is of finite type on the small étale site.**  The covering of each chart asked
for by `SheafOfModules.IsFiniteTypeOnSite` is the family of charts cut out by the affine opens
of the chart's scheme. -/
theorem isFiniteTypeOnSite_of_forall_affine_moduleFinite
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (hfin : ∀ C : (smallEtaleRingedSite B S hS F hF).C,
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj C) →
        Module.Finite (chartRing B S hS F hF C) (G.val.obj (op C))) :
    SheafOfModules.IsFiniteTypeOnSite G := by
  refine ⟨fun U => ⟨ULift.{u + 1} ((chartScheme U).affineOpens),
    fun O => openChart B S hS F U O.down.1,
    fun O => openChartInclusion B S hS F U O.down.1,
    SmallEtale.ofArrows_openChart_affineOpens_mem B S hS F U, fun O => ?_⟩⟩
  exact hasFiniteGlobalGenerators_over_of_moduleFinite B S hS F hF G hG _
    (isAffine_chartScheme_openChart B S hS F U O.down)
    (hfin _ (isAffine_chartScheme_openChart B S hS F U O.down))

/-- **For a module cartesian on affine charts, finite type on the small étale site is
finiteness of the sections over every affine étale chart.**

The forward implication is
`Space.module_finite_sections_of_isCartesianOnAffineCharts_of_isFiniteTypeOnSite`, which is
where the faithfully flat descent happens; the converse is
`isFiniteTypeOnSite_of_forall_affine_moduleFinite`. -/
theorem isFiniteTypeOnSite_iff_forall_affine_moduleFinite
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G) :
    SheafOfModules.IsFiniteTypeOnSite G ↔
      ∀ C : (smallEtaleRingedSite B S hS F hF).C,
        IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj C) →
          Module.Finite (chartRing B S hS F hF C) (G.val.obj (op C)) :=
  ⟨fun hft C hC =>
      module_finite_sections_of_isCartesianOnAffineCharts_of_isFiniteTypeOnSite G hG hft C hC,
    isFiniteTypeOnSite_of_forall_affine_moduleFinite B S hS F hF G hG⟩

end AlgebraicGeometry.Space

end
