module

public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion

/-!
# Base change of a surjection of rings, and of a closed immersion of affine schemes

A pushout of commutative rings along a surjection `g : A ⟶ A'` is the quotient by the extended
kernel: in a pushout square `f, g, inl, inr` with `g` surjective, `inl` is surjective with kernel
the ideal generated by `f (ker g)`.  Read on global functions, for a cartesian square of affine
schemes whose bottom edge is a closed immersion: pulling back functions along the top edge is
surjective, with kernel generated by the pullback of the ideal of the closed immersion.

## Main results

* `CommRingCat.surjective_inl_of_isPushout` and `CommRingCat.ker_inl_of_isPushout`.
* `AlgebraicGeometry.surjective_appTop_of_isPullback_isClosedImmersion` and
  `AlgebraicGeometry.ker_appTop_of_isPullback_isClosedImmersion`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace CommRingCat

variable {A A' D D' : CommRingCat.{u}} {f : A ⟶ D} {g : A ⟶ A'} {inl : D ⟶ D'} {inr : A' ⟶ D'}

/-- The map `A' ⟶ D/J` of the explicit pushout of a surjection `g`. -/
noncomputable def quotientPushoutInr (f : A ⟶ D) (g : A ⟶ A') (hg : Function.Surjective g) :
    A' →+* D ⧸ (RingHom.ker g.hom).map f.hom :=
  g.hom.liftOfSurjective hg ⟨(Ideal.Quotient.mk _).comp f.hom, fun _ ha ↦
    RingHom.mem_ker.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha))⟩

/-- The map `quotientPushoutInr f g hg` sends `g a` to the class of `f a`. -/
theorem quotientPushoutInr_apply (f : A ⟶ D) (g : A ⟶ A') (hg : Function.Surjective g) (a : A) :
    quotientPushoutInr f g hg (g a) = Ideal.Quotient.mk _ (f a) :=
  g.hom.liftOfSurjective_comp_apply hg _ a

/-- The explicit pushout of a surjection: the quotient by the extended kernel. -/
theorem isPushout_quotient (f : A ⟶ D) (g : A ⟶ A') (hg : Function.Surjective g) :
    IsPushout f g (CommRingCat.ofHom (Ideal.Quotient.mk ((RingHom.ker g.hom).map f.hom)))
      (CommRingCat.ofHom (quotientPushoutInr f g hg)) := by
  set J := (RingHom.ker g.hom).map f.hom
  have hcomm : f ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) =
      g ≫ CommRingCat.ofHom (quotientPushoutInr f g hg) := by
    ext a
    exact (quotientPushoutInr_apply f g hg a).symm
  refine ⟨⟨hcomm⟩, ⟨PushoutCocone.IsColimit.mk _ (fun s ↦ CommRingCat.ofHom
    (Ideal.Quotient.lift J s.inl.hom ?_)) ?_ ?_ ?_⟩⟩
  · intro x hx
    refine Submodule.span_induction ?_ (by simp) (fun _ _ _ _ ha hb ↦ by simp [ha, hb])
      (fun a _ _ hb ↦ by simp [hb]) hx
    rintro _ ⟨a, ha, rfl⟩
    simpa [RingHom.mem_ker.mp ha] using congrArg (fun k ↦ k.hom a) s.condition
  · exact fun _ ↦ rfl
  · intro s
    ext x
    obtain ⟨a, rfl⟩ := hg x
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      quotientPushoutInr_apply]
    exact congrArg (fun k ↦ k.hom a) s.condition
  · intro s m h1 _
    exact CommRingCat.hom_ext <| Ideal.Quotient.ringHom_ext <| RingHom.ext fun d ↦
      congrArg (fun k ↦ k.hom d) h1

/-- In a pushout square along a surjection `g`, `inl` is the quotient map by the ideal generated by
`f (ker g)` followed by the canonical isomorphism with the explicit pushout. -/
theorem inl_eq_of_isPushout (h : IsPushout f g inl inr) (hg : Function.Surjective g) :
    inl = CommRingCat.ofHom (Ideal.Quotient.mk ((RingHom.ker g.hom).map f.hom)) ≫
      (h.isoIsPushout _ _ (isPushout_quotient f g hg)).inv := by
  rw [Iso.eq_comp_inv]
  exact h.inl_isoIsPushout_hom _ _ (isPushout_quotient f g hg)

/-- In a pushout square along a surjection `g`, `inl` is the quotient map by `f (ker g)` followed
by a bijective ring map. -/
private theorem exists_bijective_comp_mk_eq_inl (h : IsPushout f g inl inr)
    (hg : Function.Surjective g) :
    ∃ e : D ⧸ (RingHom.ker g.hom).map f.hom →+* D',
      Function.Bijective e ∧ e.comp (Ideal.Quotient.mk _) = inl.hom :=
  ⟨_, ConcreteCategory.bijective_of_isIso (h.isoIsPushout _ _ (isPushout_quotient f g hg)).inv,
    congrArg CommRingCat.Hom.hom (inl_eq_of_isPushout h hg).symm⟩

/-- In a pushout square of commutative rings along a surjection `g`, the map `inl` is
surjective. -/
theorem surjective_inl_of_isPushout (h : IsPushout f g inl inr) (hg : Function.Surjective g) :
    Function.Surjective inl := by
  obtain ⟨e, he, he'⟩ := exists_bijective_comp_mk_eq_inl h hg
  change Function.Surjective inl.hom
  rw [← he']
  exact he.2.comp Ideal.Quotient.mk_surjective

/-- In a pushout square of commutative rings along a surjection `g`, the kernel of `inl` is the
ideal generated by `f (ker g)`. -/
theorem ker_inl_of_isPushout (h : IsPushout f g inl inr) (hg : Function.Surjective g) :
    RingHom.ker inl.hom = (RingHom.ker g.hom).map f.hom := by
  obtain ⟨e, he, he'⟩ := exists_bijective_comp_mk_eq_inl h hg
  rw [← he', RingHom.ker_comp_of_injective _ he.1, Ideal.mk_ker]

end CommRingCat

namespace AlgebraicGeometry

variable {V' V T' T : Scheme.{u}} [IsAffine V] [IsAffine T] [IsAffine T'] {a : V' ⟶ V}
  {b : V' ⟶ T'} {c : V ⟶ T} {k : T' ⟶ T} (h : IsPullback a b c k) [IsClosedImmersion k]

include h in
/-- **Base change of a closed immersion of affine schemes is surjective on functions.** -/
theorem surjective_appTop_of_isPullback_isClosedImmersion : Function.Surjective a.appTop.hom :=
  CommRingCat.surjective_inl_of_isPushout (isPushout_appTop_of_isPullback h)
    (IsClosedImmersion.isAffine_surjective_of_isAffine k).2

include h in
/-- **The kernel of the base change of a closed immersion of affine schemes on functions** is
generated by the ideal of the closed immersion. -/
theorem ker_appTop_of_isPullback_isClosedImmersion :
    RingHom.ker a.appTop.hom = (RingHom.ker k.appTop.hom).map c.appTop.hom :=
  CommRingCat.ker_inl_of_isPushout (isPushout_appTop_of_isPullback h)
    (IsClosedImmersion.isAffine_surjective_of_isAffine k).2

end AlgebraicGeometry

end
