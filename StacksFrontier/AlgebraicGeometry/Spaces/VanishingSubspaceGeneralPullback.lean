@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-! ### Restriction of global regular functions along an arbitrary morphism -/

/-- The value of a global regular function restricted along an arbitrary morphism `g : X ⟶ Y`,
on an étale chart `V` of `X`, is the value of its all-chart family on the chart `V ⟶ X ⟶ Y` of
`Y`.  That chart is a chart of `Y` whatever `g` is, even though it is not an *étale* chart of
`Y` unless `g` is étale, and that is the whole reason the restriction exists in this
generality. -/
theorem globalFunctionsMap_val_chartFunctions (g : X ⟶ Y)
    (a : (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections)
    (V : SmallEtale B S hS X.1) :
    (globalFunctionsMap B S hS g a).val (op V) =
      ((globalFunctionsChartEquiv B S hS Y).val a).val
        (op ((CostructuredArrow.map g.hom).obj ((SmallEtale.inclusion B S hS X.1).obj V))) :=
  (congrArg (fun t => t.val (op V))
      ((globalFunctionsChartEquiv B S hS X).property
        (globalFunctionsMap B S hS g a))).symm.trans
    (congrArg (fun t => t.val (op ((SmallEtale.inclusion B S hS X.1).obj V)))
      (globalFunctionsMap_chart B S hS g a))

/-- **The value of a restricted global function on a chart that factors.**  Let `g : X ⟶ Y` be an
arbitrary morphism of algebraic spaces, let `U` be an étale chart of `Y`, let `V` be an étale
chart of `X` and let `p : V ⟶ U` be a morphism of the underlying objects of the site with
`p ≫ U = V ≫ g`.  Then the value of `g^*a` on `V` is the pullback of the value of `a` on `U`
along the morphism of schemes underlying `p`.

Only the all-chart compatibility of `a` is used: `V ⟶ X ⟶ Y` and `V ⟶ U ⟶ Y` are the same chart
of `Y`, and `p` is a morphism of charts from it to `U`. -/
theorem globalFunctionsMap_val_of_factor (g : X ⟶ Y)
    (a : (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections)
    (U : SmallEtale B S hS Y.1) (V : SmallEtale B S hS X.1) (p : V.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = V.1.hom ≫ g.hom) :
    (globalFunctionsMap B S hS g a).val (op V) =
      ((BigFppfOver.toScheme B S hS).map p).appTop.hom (a.eval (op U)) := by
  have hU : ((globalFunctionsChartEquiv B S hS Y).val a).val
      (op ((SmallEtale.inclusion B S hS Y.1).obj U)) = a.eval (op U) :=
    congrArg (fun t => t.val (op U)) ((globalFunctionsChartEquiv B S hS Y).property a)
  have hres := ((globalFunctionsChartEquiv B S hS Y).val a).property
    (CostructuredArrow.homMk p hp :
      (CostructuredArrow.map g.hom).obj ((SmallEtale.inclusion B S hS X.1).obj V) ⟶
        (SmallEtale.inclusion B S hS Y.1).obj U).op
  rw [globalFunctionsMap_val_chartFunctions, ← hres, hU]
  rfl

/-- **On an étale morphism this is the étale restriction.**  So the general restriction of
global functions and `AlgebraicGeometry.Space.unitSectionsRestrict` are one map and not two:
on an étale chart `V` of `X` both are the value of the function on the postcomposed chart
`V ⟶ X ⟶ Y`, which for an étale `g` is itself an étale chart of `Y`. -/
theorem globalFunctionsMap_eq_unitSectionsRestrict (g : X ⟶ Y) (hg : IsEtale B S hS g.hom)
    (a : (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections) :
    (globalFunctionsMap B S hS g a :
        (SheafOfModules.unit (structureRingSheaf B S hS X)).sections) =
      unitSectionsRestrict B S hS g hg a := by
  refine Subtype.ext (funext fun V => ?_)
  refine (globalFunctionsMap_val_chartFunctions B S hS g a V.unop).trans ?_
  exact congrArg (fun t => t.val (op ((smallEtalePostcomp B S hS g hg).obj V.unop)))
    ((globalFunctionsChartEquiv B S hS Y).property a)

/-! ### The zero locus of the restricted functions -/

/-- **The chartwise base change of the zero locus along an arbitrary morphism.**  Let
`g : X ⟶ Y` be a morphism of algebraic spaces over `S` — with no hypothesis whatever, in
particular `g` smooth is allowed — let `f₁, …, f_r ∈ Γ(Y, 𝒪_Y)`, let `U` be an affine étale
chart of `Y`, let `V` be an affine étale chart of `X` and let `p : V ⟶ U` be a morphism of the
site over `g`.  Then the defining ideal of `g⁻¹ V(f₁, …, f_r)` on `V` is the ideal generated by
the restrictions of the pulled-back functions:

`definingIdealAt (g⁻¹ V(f₁, …, f_r)) V = (g^*f₁|_V, …, g^*f_r|_V)`.

This is the chartwise content of "the base change of `V(f₁, …, f_r)` along `g` is the zero locus
of the pulled-back functions".  Its two inputs are
`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`, which says the defining ideal of an
inverse image on `V` is generated by the image of the defining ideal on `U` — the only place `g`
enters, and it enters unconditionally — and
`AlgebraicGeometry.Space.definingIdealAt_vanishingSubspace_eq'`, which identifies the defining
ideal of `V(f₁, …, f_r)` on `U` with the ideal of the family. -/
theorem definingIdealAt_preimage_vanishingSubspace_eq_of_factor (g : X ⟶ Y) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections)
    (U : SmallEtale B S hS Y.1) (V : SmallEtale B S hS X.1) (p : V.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = V.1.hom ≫ g.hom)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS Y.1).obj U).1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)] :
    definingIdealAt B S hS X
        (⟨(vanishingSubfunctor B S hS Y f).preimage g.hom,
          isClosedSubspace_preimage B S hS g.hom (vanishingSubfunctor B S hS Y f) Y.2 X.2
            (vanishingSubfunctor_isClosedSubspace B S hS Y f)⟩ :
          ClosedSubspaces B S hS X.1) (op V) =
      vanishingIdealAt B S hS X (fun i => globalFunctionsMap B S hS g (f i)) V := by
  refine (definingIdealAt_preimage_eq_map B S hS g (vanishingSubspace B S hS Y f) U V
    p hp).trans ?_
  refine (congrArg (Ideal.map ((BigFppfOver.toScheme B S hS).map p).appTop.hom)
    (definingIdealAt_vanishingSubspace_eq' B S hS Y f U hU)).trans ?_
  refine (Ideal.map_span ((BigFppfOver.toScheme B S hS).map p).appTop.hom
    (Set.range fun i => unitSectionValue B S hS Y (f i) (op U))).trans ?_
  refine congrArg Ideal.span ((Set.range_comp' _ _).symm.trans
    (congrArg Set.range (funext fun i => ?_)))
  exact (globalFunctionsMap_val_of_factor B S hS g (f i) U V p hp).symm

/-! ### Globalisation to every affine chart -/

/-- The chartwise base change of the zero locus, read on a chart of `X` carrying an affine chart
diagram over `g`.  This is
`AlgebraicGeometry.Space.definingIdealAt_preimage_vanishingSubspace_eq_of_factor` with its two
affine charts and the morphism between them repackaged as
`AlgebraicGeometry.Space.HasAffineChartDiagram`, which is the shape the cover-density statement
`AlgebraicGeometry.Space.mem_topology_of_hasAffineChartDiagram` quantifies over. -/
theorem definingIdealAt_preimage_vanishingSubspace_eq_of_hasAffineChartDiagram (g : X ⟶ Y)
    {r : ℕ} (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections)
    (W : SmallEtale B S hS X.1) (hW : HasAffineChartDiagram B S hS g W) :
    definingIdealAt B S hS X
        (⟨(vanishingSubfunctor B S hS Y f).preimage g.hom,
          isClosedSubspace_preimage B S hS g.hom (vanishingSubfunctor B S hS Y f) Y.2 X.2
            (vanishingSubfunctor_isClosedSubspace B S hS Y f)⟩ :
          ClosedSubspaces B S hS X.1) (op W) =
      vanishingIdealAt B S hS X (fun i => globalFunctionsMap B S hS g (f i)) W := by
  obtain ⟨hWaff, U, q, hq, hUaff⟩ := hW
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) := hWaff
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left) := hUaff
  exact definingIdealAt_preimage_vanishingSubspace_eq_of_factor B S hS g f U W q hq hUaff

/-- **The base change of `V(f₁, …, f_r)` along an arbitrary morphism, on every affine chart.**
Let `g : X ⟶ Y` be a morphism of algebraic spaces over `S` — with no hypothesis whatever, in
particular `g` smooth is allowed — let `f₁, …, f_r ∈ Γ(Y, 𝒪_Y)` and let `V` be *any* affine
étale chart of `X`.  Then the defining ideal of `g⁻¹ V(f₁, …, f_r)` on `V` is the ideal
generated by the restrictions of the pulled-back functions.

This is the globalisation of
`AlgebraicGeometry.Space.definingIdealAt_preimage_vanishingSubspace_eq_of_factor`, which needs
`V` to map over `g` to an affine chart of `Y`.  Its three inputs are all unconditional:

* the charts of `X` which do so factor are cover-dense,
  `AlgebraicGeometry.Space.mem_topology_of_hasAffineChartDiagram`, so the arrows out of them
  generate a covering sieve of `V`;
* membership in the ideal of the family descends along that sieve, because the sheaf of ideals
  generated by finitely many global functions has the ideal of the family as its sections over
  an affine chart — `AlgebraicGeometry.Space.vanishingIdealSheaf_obj_of_isAffine`, the étale
  descent of ideal membership behind
  `AlgebraicGeometry.Space.isQuasicoherentOnSite_vanishingIdealSheaf`;
* membership in the defining ideal of the inverse image descends along it as well,
  `AlgebraicGeometry.Space.mem_definingIdealAt_of_sieve`, by separatedness of the direct image
  of the structure sheaf of the subspace. -/
theorem definingIdealAt_preimage_vanishingSubspace_eq (g : X ⟶ Y) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections)
    (V : SmallEtale B S hS X.1)
    (hV : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj V).1) :
    definingIdealAt B S hS X
        (⟨(vanishingSubfunctor B S hS Y f).preimage g.hom,
          isClosedSubspace_preimage B S hS g.hom (vanishingSubfunctor B S hS Y f) Y.2 X.2
            (vanishingSubfunctor_isClosedSubspace B S hS Y f)⟩ :
          ClosedSubspaces B S hS X.1) (op V) =
      vanishingIdealAt B S hS X (fun i => globalFunctionsMap B S hS g (f i)) V := by
  set Z : ClosedSubspaces B S hS X.1 :=
    ⟨(vanishingSubfunctor B S hS Y f).preimage g.hom,
      isClosedSubspace_preimage B S hS g.hom (vanishingSubfunctor B S hS Y f) Y.2 X.2
        (vanishingSubfunctor_isClosedSubspace B S hS Y f)⟩
  set F := fun i => globalFunctionsMap B S hS g (f i)
  refine le_antisymm (fun s hs => ?_) (fun t ht => ?_)
  · have hsheaf : s ∈ (vanishingIdealSheaf B S hS X F).obj (op V) := by
      refine (vanishingIdealSheaf B S hS X F).isSheaf s ?_
      refine mem_topology_of_hasAffineChartDiagram B S hS g V _ fun W a hW => ?_
      have h1 := definingIdealAt_map B S hS X Z a.op s hs
      rw [definingIdealAt_preimage_vanishingSubspace_eq_of_hasAffineChartDiagram
        B S hS g f W hW] at h1
      exact vanishingIdealAt_le_vanishingIdealSheaf_obj B S hS X F W h1
    rwa [vanishingIdealSheaf_obj_of_isAffine B S hS X F V hV] at hsheaf
  · refine mem_definingIdealAt_of_sieve B S hS X Z (op V) t
      (Sieve.generate fun ⦃W⦄ (a : W ⟶ V) => HasAffineChartDiagram B S hS g W)
      (mem_topology_of_hasAffineChartDiagram B S hS g V _
        fun W a hW => ⟨W, 𝟙 W, a, hW, Category.id_comp a⟩) ?_
    rintro W m ⟨W', b, c, hc, rfl⟩
    have h1 : ((structureRingSheaf B S hS X).obj.map c.op).hom t ∈
        vanishingIdealAt B S hS X F W' :=
      (vanishingPresheafIdeal B S hS X F).map c.op ht
    rw [← definingIdealAt_preimage_vanishingSubspace_eq_of_hasAffineChartDiagram
      B S hS g f W' hc] at h1
    have h2 := definingIdealAt_map B S hS X Z b.op _ h1
    rw [op_comp, Functor.map_comp, RingCat.hom_comp, RingHom.comp_apply]
    exact h2

/-- **The base change of `V(f₁, …, f_r)` along an arbitrary morphism of algebraic spaces.**  For
`g : X ⟶ Y` with no hypothesis whatever — in particular for `g` smooth — the zero locus of the
restricted functions `g^*f₁, …, g^*f_r` is the inverse image of the zero locus of
`f₁, …, f_r`:

`V(g^*f₁, …, g^*f_r) = g⁻¹ V(f₁, …, f_r)`.

This is `AlgebraicGeometry.Space.vanishingSubfunctor_eq` fed with
`AlgebraicGeometry.Space.definingIdealAt_preimage_vanishingSubspace_eq`, which supplies the
defining ideal of the inverse image at *every* affine étale chart of `X` — the quantifier range
of `AlgebraicGeometry.Space.vanishingSubfunctor_le` and
`AlgebraicGeometry.Space.le_vanishingSubfunctor`.  The étale case is
`AlgebraicGeometry.Space.vanishingSubfunctor_restrict_eq_preimage`, whose pulled-back family is
`AlgebraicGeometry.Space.unitSectionsRestrict` of the same functions by
`AlgebraicGeometry.Space.globalFunctionsMap_eq_unitSectionsRestrict`. -/
theorem vanishingSubfunctor_globalFunctionsMap_eq_preimage (g : X ⟶ Y) {r : ℕ}
    (f : Fin r → (SheafOfModules.unit (structureRingSheaf B S hS Y)).sections) :
    vanishingSubfunctor B S hS X (fun i => globalFunctionsMap B S hS g (f i)) =
      (vanishingSubfunctor B S hS Y f).preimage g.hom :=
  vanishingSubfunctor_eq B S hS X (fun i => globalFunctionsMap B S hS g (f i))
    (⟨(vanishingSubfunctor B S hS Y f).preimage g.hom,
      isClosedSubspace_preimage B S hS g.hom (vanishingSubfunctor B S hS Y f) Y.2 X.2
        (vanishingSubfunctor_isClosedSubspace B S hS Y f)⟩ :
      ClosedSubspaces B S hS X.1)
    fun V hV => definingIdealAt_preimage_vanishingSubspace_eq B S hS g f V hV

end AlgebraicGeometry.Space

end
