/-!
# A finite morphism to a qcqs algebraic space is a limit of finite ones along closed immersions

Let `f : X ⟶ Y` be a finite morphism of algebraic spaces over `S`, with `Y` quasi-compact and
quasi-separated.  Then `X` is a directed limit `X = lim X_i` of algebraic spaces `X_i` finite
and of finite presentation over `Y`, whose transition morphisms are closed immersions.

The argument is the source's (Stacks 07VR).  The direct image `𝒜 = f_* 𝒪_X` is a finite
quasi-coherent `𝒪_Y`-algebra; it is a quotient of `Sym(𝒢)` for a module `𝒢` of finite
presentation, and the quotients of `Sym(𝒢)` by the ideals generated by the finite type
quasi-coherent submodules of the kernel form a filtered system of quasi-coherent algebras of
finite presentation with surjective transition maps and colimit `𝒜` (the construction of
Stacks 086Z).  Those quotients are finite from one index on, and after reindexing by a directed
preorder the relative spectra `X_i = \underline{Spec}_Y(𝒜_i)` (Stacks 081W) are finite and of
finite presentation over `Y`, with `X = lim X_i`.  A surjection of algebras gives a monomorphism
of relative spectra, and a finite monomorphism is a closed immersion.

The colimit is taken among *all* algebra sheaves on the small étale site of `Y`, not only among
the quasi-coherent ones: that is the form the relative spectrum turns into a limit
(`AlgebraicGeometry.Space.isLimitMapConeRelativeSpecPointsFunctor`).  So the construction of
Stacks 086Z is rerun here with its colimit assertion kept at that level.

## Main results

* `AlgebraicGeometry.Space.exists_integralFiniteSystem_isClosedImmersion_of_isFinite`: the
  presentation, in the form `AlgebraicGeometry.Space.IntegralFiniteSystem` together with the
  closed immersion property of the transition morphisms.

## References

* [Stacks Project, Tag 07VR](https://stacks.math.columbia.edu/tag/07VR)
* [Stacks Project, Tag 086Z](https://stacks.math.columbia.edu/tag/086Z)
* [Stacks Project, Tag 081W](https://stacks.math.columbia.edu/tag/081W)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

section AlgebraSheafSystem

open AlgebraSheaf

variable {Y : AlgebraicSpaces B S hS}

/-- **The construction of Stacks 086Z with its colimit among all algebra sheaves.**  For a
finite quasi-coherent algebra `𝒜` on a quasi-compact quasi-separated algebraic space and an
epimorphism onto it from a quasi-coherent module `𝒢` of finite presentation, the quotients of
`ℬ = Sym(𝒢)` by the ideals generated by the finite type quasi-coherent submodules of the kernel
of `ℬ ⟶ 𝒜` form a filtered family of quasi-coherent algebras of finite presentation, one of which
is integral, whose cocone over `𝒜` is colimiting in the category of all algebra sheaves.

This is `AlgebraicGeometry.Space.exists_idealQuotient_system_of_epi` with the colimit assertion
read through `AlgebraicGeometry.Space.nonempty_isColimit_idealQuotientAlgCocone_iff_locally`
rather than at the quasi-coherent level. -/
theorem exists_idealQuotient_algSystem_of_epi (A : QuasicoherentAlgebra B S hS Y)
    {G : Modules.{u, u} B S hS Y.1 Y.2} (p : G ⟶ AlgebraSheaf.underlyingModule A.obj)
    (hqc : IsQuasiCompactSpace B S hS Y.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal Y.1)
    (hA : A.obj.IsFinite) (hGqc : G.IsQuasicoherentOnSite)
    (hGfp : SheafOfModules.IsFinitePresentationOnSite G) (hp : Epi p) :
    ∃ (ℬ : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) (f : ℬ ⟶ A.obj) (J : Type u)
      (inst : SmallCategory J),
      let _ := inst
      ∃ (_ : IsFiltered J) (ι : J → ℬ.IdealSheaf)
        (hι : ∀ j j' : J, (j ⟶ j') → ι j ≤ ι j')
        (hkill : ∀ (j : J) (U : (SmallEtale B S hS Y.1)ᵒᵖ) (a : ℬ.right.obj.obj U),
          a ∈ (ι j).obj U → (f.right.hom.app U).hom a = 0),
        (∀ j, (ℬ.idealQuotient (ι j)).IsQuasicoherent) ∧
        (∀ j, (ℬ.idealQuotient (ι j)).IsFinitePresentation) ∧
        (∃ j, (ℬ.idealQuotient (ι j)).IsIntegral) ∧
        Nonempty (IsColimit (Cocone.mk A.obj (idealQuotientAlgCocone ℬ ι hι A.obj f hkill))) := by
  classical
  let ℬ := symmetricAlgebraSheaf B S hS Y G
  let f := SymAlgSheaf.algebraLift B S hS Y A.obj G p
  have hℬ : ℬ.IsQuasicoherent := isQuasicoherent_symmetricAlgebraSheaf B S hS Y G hGqc
  have hℬfp := isFinitePresentation_symmetricAlgebraSheaf B S hS Y G hGqc hGfp
  have hK := isQuasicoherentOnSite_algebraKernel f hℬ A.property
  have := isFiltered_finiteTypeQuasicoherentSubobject B S hS Y.1 Y.2 (algebraKernel f)
  have := essentiallySmall_finiteTypeQuasicoherentSubobject B S hS Y.1 Y.2 (algebraKernel f)
  let e := equivSmallModel.{u}
    (FiniteTypeQuasicoherentSubobject B S hS Y.1 Y.2 (algebraKernel f))
  have := IsFiltered.of_equivalence e
  let ι : SmallModel.{u} (FiniteTypeQuasicoherentSubobject B S hS Y.1 Y.2 (algebraKernel f)) →
      ℬ.IdealSheaf := fun j => kernelSubmoduleIdeal f (e.inverse.obj j)
  have hι : ∀ j j', (j ⟶ j') → ι j ≤ ι j' := fun j j' h =>
    kernelSubmoduleIdeal_mono f (e.inverse.map h)
  have hιE : ∀ E, ι (e.functor.obj E) = kernelSubmoduleIdeal f E := fun E =>
    le_antisymm (kernelSubmoduleIdeal_mono f (e.unitInv.app E))
      (kernelSubmoduleIdeal_mono f (e.unit.app E))
  have hkill : ∀ (j) (U : (SmallEtale B S hS Y.1)ᵒᵖ) (a : ℬ.right.obj.obj U),
      a ∈ (ι j).obj U → (f.right.hom.app U).hom a = 0 := fun j U a ha =>
    apply_eq_zero_of_le_kerIdeal f (kernelSubmoduleIdeal_le_kerIdeal f _) U a ha
  have hIqc : ∀ j, (idealModule ℬ (ι j)).IsQuasicoherentOnSite := fun j =>
    isQuasicoherentOnSite_idealModule_generatedIdeal ℬ hℬ (e.inverse.obj j).property.1 _
  have hqcoh : ∀ j, (ℬ.idealQuotient (ι j)).IsQuasicoherent := fun j =>
    isQuasicoherent_idealQuotient ℬ (ι j) hℬ (hIqc j)
  refine ⟨ℬ, f, _, inferInstance, inferInstance, ι, hι, hkill, hqcoh, ?_, ?_, ?_⟩
  · exact fun j => isFinitePresentation_idealQuotient ℬ (ι j) hℬ (hIqc j) hℬfp fun W hW =>
      fg_sectionIdeal_generatedIdeal ℬ hℬ (e.inverse.obj j).property.1
        (Stacks.SheafOfModules.isFiniteTypeOnSite_of_isFiniteType _
          (e.inverse.obj j).property.2) _ W hW
  · obtain ⟨E, hE⟩ := exists_isIntegral_kernelSubmoduleIdeal_quotient A p hqc hqs hA hGqc hGfp
    exact ⟨e.functor.obj E, by rwa [hιE]⟩
  · refine (nonempty_isColimit_idealQuotientAlgCocone_iff_locally ℬ ι hι A.obj f hkill).2
      ⟨isLocallySurjective_algebraLift hGqc A.obj p A.property hp, ?_⟩
    intro U a ha
    refine (SmallEtale.topology B S hS Y.1).superset_covering ?_
      (SmallEtale.ofArrows_openChart_affineOpens_mem B S hS Y.1 U.unop)
    intro W' g hg
    obtain ⟨O, k, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
    refine (Stacks.Sites.memSieve (O := ℬ.right) ι a).downward_closed ?_ k
    let incl := openChartInclusion B S hS Y.1 U.unop O.down.1
    have hW := isAffine_chartScheme_openChart B S hS Y.1 U.unop O.down
    have hfa : (f.right.hom.app (op (openChart B S hS Y.1 U.unop O.down.1)))
        (ℬ.right.obj.map incl.op a) = 0 := by
      have := congrArg (fun φ => (ConcreteCategory.hom φ : _ → _) a)
        (f.right.hom.naturality incl.op)
      refine this.trans ?_
      show A.obj.right.obj.map incl.op ((f.right.hom.app U) a) = 0
      rw [ha, map_zero]
    obtain ⟨E, hE⟩ := exists_forall_mem_kernelSubmoduleIdeal f hℬ A.property hqc hqs hW
      ({()} : Finset Unit) (fun _ => ℬ.right.obj.map incl.op a) (fun _ _ => hfa)
    refine ⟨e.functor.obj E, ?_⟩
    rw [hιE]
    exact hE () (Finset.mem_singleton_self _)

/-- **Stacks 086Z with its colimit among all algebra sheaves.**  A finite quasi-coherent algebra
`𝒜` on a quasi-compact quasi-separated algebraic space is the colimit, in the category of all
algebra sheaves, of a system indexed by a nonempty directed preorder of quasi-coherent algebras
which are finite and of finite presentation, with locally surjective transition maps. -/
theorem exists_directed_algebraSheaf_isFinite_isFinitePresentation_locallySurjective
    (A : QuasicoherentAlgebra B S hS Y) (hqc : IsQuasiCompactSpace B S hS Y.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal Y.1) (hA : A.obj.IsFinite) :
    ∃ (I : Type u) (_ : Preorder I) (_ : Nonempty I) (_ : IsDirected I (· ≤ ·))
      (D : I ⥤ AlgebraSheaf.{u, u} B S hS Y.1 Y.2) (φ : D ⟶ (Functor.const I).obj A.obj),
      Nonempty (IsColimit (Cocone.mk A.obj φ)) ∧
      (∀ i, (D.obj i).IsQuasicoherent ∧ (D.obj i).IsFinite ∧ (D.obj i).IsFinitePresentation) ∧
      ∀ i j (h : i ≤ j), Presheaf.IsLocallySurjective
        (SmallEtale.topology B S hS Y.1) (D.map (homOfLE h)).right.hom := by
  classical
  have := isFiniteTypeOnSite_underlyingModule_of_isFinite B S hS A.obj A.property hA
  obtain ⟨G, hGfp, p, hp⟩ := exists_epi_of_isFinitePresentationOnSite_of_isFiniteType B S hS
    B.contains_terminal Y.2 hqc hqs (AlgebraSheaf.underlyingModule A.obj) A.property
  have hGqc : G.IsQuasicoherentOnSite :=
    SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentationOnSite G
  obtain ⟨ℬ, f, J, instJ, hfilt, ι, hι, hkill, hqcoh, hfp, ⟨j₀, hj₀⟩, ⟨hcol⟩⟩ :=
    exists_idealQuotient_algSystem_of_epi A p hqc hqs hA hGqc hGfp hp
  let _ := instJ
  let _ : IsFiltered J := hfilt
  let E : J ⥤ AlgebraSheaf.{u, u} B S hS Y.1 Y.2 := idealQuotientDiagram ℬ ι hι
  let ψ : E ⟶ (Functor.const J).obj A.obj := idealQuotientAlgCocone ℬ ι hι A.obj f hkill
  have hls : ∀ (j j' : J) (g : j ⟶ j'), Presheaf.IsLocallySurjective
      (SmallEtale.topology B S hS Y.1) (E.map g).right.hom :=
    fun _ _ g => AlgebraSheaf.isLocallySurjective_idealQuotientMapOfLE (hι _ _ g)
  have hint : ∀ (j : J) (g : j₀ ⟶ j), (E.obj j).IsIntegral := by
    intro j g
    refine AlgebraSheaf.IsIntegral.of_surjective_app (E.map g) (fun U hU => ?_) hj₀
    have hsur := surjective_val_app_of_epi_of_isQuasicoherentOnSite
      (AlgebraSheaf.underlyingModuleMap (E.map g))
      (AlgebraSheaf.epi_underlyingModuleMap_of_isLocallySurjective (E.map g) (hls j₀ j g))
      (hqcoh j₀) (hqcoh j) U hU
    intro y
    obtain ⟨x, hx⟩ := hsur y
    exact ⟨x, hx⟩
  have hcol₁ : IsColimit (Cocone.mk A.obj (Functor.whiskerLeft (Under.forget j₀) ψ)) :=
    Stacks.DirectedCokernelSystem.isColimit_whiskerLeft (Under.forget j₀) E A.obj ψ hcol
  obtain ⟨I, instI, hne, hdir, D, φ, hcolD, hobj, hmor⟩ :=
    Stacks.FiniteAlgebraSurjectiveSystem.exists_directed_of_filtered_colimit_hom.{u}
      (fun C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2 =>
        C.IsQuasicoherent ∧ C.IsFinite ∧ C.IsFinitePresentation)
      (fun (C C' : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) (g : C ⟶ C') =>
        Presheaf.IsLocallySurjective (SmallEtale.topology B S hS Y.1) g.right.hom)
      (Under.forget j₀ ⋙ E) A.obj (Functor.whiskerLeft (Under.forget j₀) ψ) hcol₁
      (fun W => ⟨hqcoh W.right, (AlgebraSheaf.isFinite_iff_isIntegral_and_isFiniteType _).2
        ⟨hint W.right W.hom, (hfp W.right).isFiniteType⟩, hfp W.right⟩)
      (fun _ _ k => hls _ _ ((Under.forget j₀).map k))
  exact ⟨I, instI, hne, hdir, D, φ, ⟨hcolD⟩, hobj, hmor⟩

end AlgebraSheafSystem

/-! ### Monomorphisms of relative spectra -/

/-- A morphism of algebra sheaves which is locally surjective on sections is an epimorphism: a
morphism of algebra sheaves is determined by its morphism of sheaves of rings. -/
private theorem epi_of_isLocallySurjective_algebraSheaf {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {hF : IsAlgebraicSpace B S hS F} {A C : AlgebraSheaf.{u, u} B S hS F hF} (g : A ⟶ C)
    (hg : Presheaf.IsLocallySurjective (SmallEtale.topology B S hS F) g.right.hom) : Epi g := by
  have hls : Sheaf.IsLocallySurjective g.right := hg
  refine ⟨fun {Z} p r hpr => ?_⟩
  apply AlgebraSheaf.Hom.ext
  exact (cancel_epi g.right).mp (congrArg (fun t : A ⟶ Z => t.right) hpr)

/-- **An epimorphism of algebras gives a monomorphism of relative spectra**: precomposition with
an epimorphism `a : 𝒜₁ ⟶ 𝒜₂` is injective on morphisms `𝒜₂ ⟶ x_* 𝒪_T`. -/
theorem mono_relativeSpecPointsMap_of_epi {X : AlgebraicSpaces B S hS}
    {A₁ A₂ : AlgebraSheaf.{u, u} B S hS X.1 X.2} (a : A₁ ⟶ A₂) [Epi a] :
    Mono (relativeSpecPointsMap B S hS a) := by
  refine (NatTrans.mono_iff_mono_app _).2 fun T => ?_
  rw [mono_iff_injective]
  intro p q hpq
  apply (relativeSpecPointsEquiv B S hS A₂ T.unop).injective
  have h := congrArg (relativeSpecPointsEquiv B S hS A₁ T.unop) hpq
  rw [relativeSpecPointsEquiv_relativeSpecPointsMap_app,
    relativeSpecPointsEquiv_relativeSpecPointsMap_app] at h
  set P := relativeSpecPointsEquiv B S hS A₂ T.unop p
  set Q := relativeSpecPointsEquiv B S hS A₂ T.unop q
  have hpt : P.pt = Q.pt := by
    have h' := congrArg RelativeSpecPoint.pt h
    rwa [RelativeSpecPoint.comap_pt, RelativeSpecPoint.comap_pt] at h'
  obtain ⟨α, hα⟩ := RelativeSpecPoint.exists_eq_mk P rfl
  obtain ⟨β, hβ⟩ := RelativeSpecPoint.exists_eq_mk Q hpt.symm
  rw [hα, hβ, RelativeSpecPoint.comap_mk, RelativeSpecPoint.comap_mk] at h
  rw [hα, hβ, (cancel_epi a).mp (RelativeSpecPoint.ext_of_pt_eq h)]

/-! ### The presentation -/

/-- **A finite morphism to a quasi-compact quasi-separated algebraic space is a directed limit of
finite morphisms of finite presentation along closed immersions.**  Let `g : X ⟶ Y` be a finite
morphism of algebraic spaces over `S`, with `Y` quasi-compact and quasi-separated.  Then there
is a presentation of `X` as the limit of a directed inverse system of algebraic spaces finite
and of finite presentation over `Y` (`AlgebraicGeometry.Space.IntegralFiniteSystem`) whose
transition morphisms are closed immersions.

This is the content of Stacks 07VR; see the module documentation for the argument. -/
theorem exists_integralFiniteSystem_isClosedImmersion_of_isFinite
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (g : X ⟶ Y)
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y) (hf : IsFinite B S hS g)
    (hYqc : IsQuasiCompactSpace B S hS Y)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal Y) :
    ∃ s : IntegralFiniteSystem B S hS g,
      letI := s.indexPreorder
      ∀ (i j : s.indexType) (h : i ≤ j),
        IsClosedImmersion B S hS (s.diagram.map (homOfLE h).op) := by
  classical
  let Ya : AlgebraicSpaces B S hS := ⟨Y, hY⟩
  let fa : (⟨X, hX⟩ : AlgebraicSpaces B S hS) ⟶ Ya := ObjectProperty.homMk g
  have haff : IsAffineHom B S hS g := IsFinite.isAffineHom hf
  have hAqc : (pushforwardAlgebra B S hS (Over.mk fa)).IsQuasicoherent :=
    isQuasicoherent_pushforwardAlgebra_of_isAffineHom' B S hS (Over.mk fa) haff
  have hAfin : (pushforwardAlgebra B S hS (Over.mk fa)).IsFinite :=
    isFinite_pushforwardAlgebra_of_isFinite B S hS fa hf
  obtain ⟨I, _, _, _, D, t, ⟨ht⟩, hD, hsurj⟩ :=
    exists_directed_algebraSheaf_isFinite_isFinitePresentation_locallySurjective (Y := Ya)
      ⟨pushforwardAlgebra B S hS (Over.mk fa), hAqc⟩ hYqc hYqs hAfin
  have : IsFiltered I := isFiltered_of_directed_le_nonempty I
  have : IsConnected I := IsFiltered.isConnected I
  have := isIso_toRelativeSpecPoints B S hS (f := fa) haff
  have hspec : ∀ i : I,
      IsAlgebraicSpace B S hS (relativeSpecPoints B S hS (X := Ya) (D.obj i)) ∧
      IsFinite B S hS (relativeSpecPointsπ B S hS (X := Ya) (D.obj i)) ∧
      IsFinitePresentation B S hS (relativeSpecPointsπ B S hS (X := Ya) (D.obj i)) := fun i =>
    isAlgebraicSpace_isFinite_isFinitePresentation_relativeSpecPointsπ B S hS (X := Ya) (D.obj i)
      (hD i).1 (hD i).2.1 (hD i).2.2
  let c : Cone (D.op ⋙ relativeSpecPointsFunctor B S hS Ya) :=
    toRelativeSpecPointsCone B S hS fa t
  have hc : IsLimit ((relativeSpecPointsFunctor B S hS Ya).mapCone (Cocone.mk _ t).op) :=
    isLimitMapConeRelativeSpecPointsFunctor B S hS ht
  have hlim : IsLimit c := hc.ofIsoLimit
    (Cones.ext (asIso (toRelativeSpecPoints B S hS fa)).symm fun j => by
      show relativeSpecPointsMap B S hS (t.app j.unop) =
        inv (toRelativeSpecPoints B S hS fa) ≫ toRelativeSpecPoints B S hS fa ≫
          relativeSpecPointsMap B S hS (t.app j.unop)
      rw [IsIso.inv_hom_id_assoc])
  have hcomp : ∀ i : Iᵒᵖ,
      g = c.π.app i ≫ (relativeSpecPointsπNatTrans B S hS (Y := Ya) D).app i := by
    intro i
    show g = (toRelativeSpecPoints B S hS fa ≫ relativeSpecPointsMap B S hS (t.app i.unop)) ≫
      relativeSpecPointsπ B S hS (X := Ya) (D.obj i.unop)
    rw [Category.assoc, relativeSpecPointsMap_comp_π, toRelativeSpecPoints_comp_π]
    rfl
  refine ⟨{
      indexType := I
      diagram := D.op ⋙ relativeSpecPointsFunctor B S hS Ya
      structureMap := relativeSpecPointsπNatTrans B S hS (Y := Ya) D
      limitCone := c.π
      compatible := hcomp
      isLimit := hlim
      stageAlgebraicSpace := fun i => (hspec i.unop).1
      stageFinite := fun i => (hspec i.unop).2.1
      stageFinitePresentation := fun i => (hspec i.unop).2.2 }, ?_⟩
  intro i j h
  show IsClosedImmersion B S hS (relativeSpecPointsMap B S hS (D.map (homOfLE h)))
  have : Epi (D.map (homOfLE h)) :=
    epi_of_isLocallySurjective_algebraSheaf (D.map (homOfLE h)) (hsurj i j h)
  have := mono_relativeSpecPointsMap_of_epi (X := Ya) (D.map (homOfLE h))
  have hcomm : relativeSpecPointsMap B S hS (D.map (homOfLE h)) ≫
      relativeSpecPointsπ B S hS (X := Ya) (D.obj i) =
        relativeSpecPointsπ B S hS (X := Ya) (D.obj j) :=
    relativeSpecPointsMap_comp_π B S hS _
  have hfin : IsFinite B S hS (relativeSpecPointsMap B S hS (D.map (homOfLE h))) := by
    refine isFinite_of_comp_of_isSeparated B S hS _ (relativeSpecPointsπ B S hS (X := Ya)
      (D.obj i)) ?_ ?_
    · rw [hcomm]
      exact (hspec j).2.1
    · exact isSeparated_of_isFinite B S hS _ (hspec i).1 hY (hspec i).2.1
  -- a finite monomorphism is a closed immersion: it is representable, and its represented base
  -- changes are finite monomorphisms of schemes
  set m := relativeSpecPointsMap B S hS (D.map (homOfLE h))
  have hr := (isFinite_iff_representable B S hS m (hspec j).1 (hspec i).1).mp hfin
  refine ⟨hr.1, ?_⟩
  intro T V k a q hq
  have : Mono (yoneda.map q) := PullbackCone.mono_snd_of_is_pullback_of_mono hq.isLimit
  have : Mono q := yoneda.mono_of_mono_map inferInstance
  have hqfin : _root_.AlgebraicGeometry.IsFinite
      ((BigFppfOver.toScheme B S hS).map q) := hr.2.property k a q hq
  have : Mono ((BigFppfOver.toScheme B S hS).map q) :=
    (BigFppfOver.toScheme B S hS).map_mono q
  exact (_root_.AlgebraicGeometry.IsClosedImmersion.iff_isFinite_and_mono _).mpr
    ⟨hqfin, inferInstance⟩

end AlgebraicGeometry.Space

end
