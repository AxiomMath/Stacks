module

public import StacksFrontier.AlgebraicGeometry.Spaces.DescendingProperties.SeparatedDescent
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleChartSmallerBase
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedModuleComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.RingedSite
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleChartEquivalence
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtalePostcompSlice
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallerBase
public import StacksFrontier.AlgebraicGeometry.Topologies.FinitePresentationSiteEquivalence

/-!
# The small étale site of an algebraic space viewed over `Spec ℤ`

Let `X` be an algebraic space over a scheme `S` of a big fppf site `B`, and let
`X' = AlgebraicGeometry.Space.viewOverIntegers B S hS hZ X` be `X` viewed as an algebraic space
over `Spec ℤ`, the terminal scheme (Stacks 03I5 (2), 03BS).  This file proves that the small
étale site, and with it the category of `𝒪`-modules, does not depend on the base: the small
étale sites of `X` and of `X'` are equivalent, with the same underlying schemes, the same
coverings and the same structure sheaf, so that the two module categories are equivalent by an
equivalence matching quasi-coherence and finite presentation.  This is the step "we may view `X`
as an algebraic space over `Spec ℤ`" of the proof of Stacks 07V9.

## Main definitions

* `AlgebraicGeometry.Space.smallEtaleToIntegers`: a chart `a : h_U ⟶ X` becomes its
  lower-shriek extension, an étale chart of `X'`.
* `AlgebraicGeometry.Space.smallEtaleFromIntegers`: a chart of `X'` is a section of `X'`, that
  is a factorization through `S` together with a section of `X`, hence a chart of `X`.
* `AlgebraicGeometry.Space.smallEtaleIntegersEquivalence`: the two are mutually inverse.
* `AlgebraicGeometry.Space.modulesIntegersEquivalence`: the induced equivalence of the module
  categories.

## Main results

* `AlgebraicGeometry.Space.reindexRing_smallEtaleIntegersEquivalence`: the two structure sheaves
  agree, by `rfl`.
* `AlgebraicGeometry.Space.isQuasicoherentOnSite_modulesIntegersEquivalence_functor_obj_iff` and
  `AlgebraicGeometry.Space.isFinitePresentation_modulesIntegersEquivalence_functor_obj_iff`:
  quasi-coherence and finite presentation are unchanged.
* `AlgebraicGeometry.Space.exists_isFilteredColimit_isFinitePresentation_of_viewOverIntegers`:
  a presentation of every quasi-coherent module on `X'` as a filtered colimit of modules of
  finite presentation gives one on `X`.

The remaining three facts about `X'` which the proof of Stacks 07V9 uses are already in the
tree: `X'` is an algebraic space (`AlgebraicGeometry.Space.isAlgebraicSpace_viewOver`), it is
quasi-compact when `X` is (`AlgebraicGeometry.Space.isQuasiCompactSpace_relocalize` at
`AlgebraicGeometry.Space.integersMap`), and it is absolutely quasi-separated when `X` is
(`AlgebraicGeometry.Space.isAbsolutelyQuasiSeparated_viewOverIntegers`).

## Implementation notes

Both comparison functors leave the underlying object of `Sch_κ` of a chart unchanged on the nose
(`AlgebraicGeometry.Space.smallEtaleToIntegers_comp_toSchemes` and
`AlgebraicGeometry.Space.smallEtaleFromIntegers_comp_toSchemes` are `rfl`), and both small étale
topologies are generated by the families whose underlying schemes form an étale covering
(`AlgebraicGeometry.Space.SmallEtale.precoverage_eq_comap`); this is what makes both functors
cover preserving, hence the equivalence one of sites, and the structure sheaves equal.  The
transport of quasi-coherence and finite presentation is then
`Stacks.SheafOfModules.isQuasicoherentOnSite_reindex_iff` and
`Stacks.SheafOfModules.isFinitePresentation_reindex_iff`.

## References

* [Stacks Project, Tag 03I5](https://stacks.math.columbia.edu/tag/03I5)
* [Stacks Project, Tag 03BS](https://stacks.math.columbia.edu/tag/03BS)
* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u w w'

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u})) (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-- The étale charts of an algebraic space over `S` are étale charts of its view over `Spec ℤ`:
the chart `a : h_U ⟶ X` becomes its lower-shriek extension. -/
noncomputable def smallEtaleToIntegers :
    SmallEtale B S hS X ⥤ SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X) where
  obj U := ⟨CostructuredArrow.mk
      (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) U.obj.hom),
    (presheaf_relocalizeChart_iff B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
      (@AlgebraicGeometry.Etale.{u}) U.obj.hom).2 U.property⟩
  map {U V} g := ObjectProperty.homMk (CostructuredArrow.homMk
      ((Over.map (integersMap B S hS hZ)).map g.hom.left) (by
        change yoneda.map ((Over.map (integersMap B S hS hZ)).map g.hom.left) ≫
            relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) V.obj.hom =
          relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) U.obj.hom
        rw [relocalizeChart_naturality]
        exact congrArg _ (CostructuredArrow.w g.hom)))
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The comparison functor leaves the underlying object of `Sch_κ` of a chart unchanged. -/
theorem smallEtaleToIntegers_comp_toSchemes :
    smallEtaleToIntegers B S hS hZ X ⋙
        SmallEtale.toSchemes B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X) =
      SmallEtale.toSchemes B S hS X := rfl


variable {B S hS hZ X}

/-- The section of the view over `Spec ℤ` named by the extension of a chart, read through the
comparison `relocalizeBaseHom`: it is the factorization together with the section of the chart. -/
theorem yonedaEquiv_relocalizeBaseHom_comp_relocalizeChart
    {V : BigFppfOver B (⊤_ Scheme.{u}) hZ} {ψ : V.left ⟶ B.obj hS}
    (hψ : ψ ≫ integersMap B S hS hZ = V.hom) (a : yoneda.obj (Over.mk ψ) ⟶ X) :
    yonedaEquiv (yoneda.map
        (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) hψ) ≫
        relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a) =
      ⟨⟨ψ, yonedaEquiv a⟩, hψ⟩ := by
  let U : BigFppfOver B S hS := Over.mk ψ
  let ρ := relocalizedYonedaIso B (B.obj hS) (B.obj hZ) (integersMap B S hS hZ) U
  have hρ : ρ.inv.app (op V)
      (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) hψ)
      = ⟨⟨ψ, (𝟙 U : U ⟶ U)⟩, hψ⟩ := by
    show (relocalizedYonedaRepresentableBy B (B.obj hS) (B.obj hZ)
      (integersMap B S hS hZ) U).homEquiv
      (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) hψ) =
        ⟨⟨ψ, (𝟙 U : U ⟶ U)⟩, hψ⟩
    apply Subtype.ext
    apply Sigma.ext
    · dsimp [relocalizedYonedaRepresentableBy]
      show 𝟙 V.left ≫ ψ = ψ
      simp
    · dsimp [relocalizedYonedaRepresentableBy]
      exact heq_of_eq (Over.OverMorphism.ext rfl)
  rw [yonedaEquiv_apply]
  have hEval : ((yoneda.map (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ
        (integersMap B S hS hZ) hψ) ≫
        relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a).app (op V))
        (𝟙 V) =
      ((OverShriek.relocalizePresheafFunctor (integersMap B S hS hZ)).map a).app (op V)
        (ρ.inv.app (op V) (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) hψ)) := rfl
  rw [hEval, hρ]
  rfl

/-- Every chart of the view over `Spec ℤ` is the extension of the chart named by its section,
read through the comparison `relocalizeBaseHom`. -/
theorem eq_relocalizeBaseHom_comp_relocalizeChart {V : BigFppfOver B (⊤_ Scheme.{u}) hZ}
    (ψ : yoneda.obj V ⟶ viewOverIntegers B S hS hZ X) :
    ψ = yoneda.map (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
        (yonedaEquiv ψ).2) ≫
      relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
        (yonedaEquiv.symm (yonedaEquiv ψ).1.2) := by
  apply yonedaEquiv.injective
  rw [yonedaEquiv_relocalizeBaseHom_comp_relocalizeChart]
  exact Subtype.ext (Sigma.ext rfl (heq_of_eq (yonedaEquiv.apply_symm_apply _).symm))


/-- The factorization of a section of the view over `Spec ℤ` transported along a morphism of the
site is the composite of the underlying morphism of schemes with the factorization. -/
theorem viewOverIntegers_fst_eq_of_eq_map {V V' : BigFppfOver B (⊤_ Scheme.{u}) hZ} (m : V ⟶ V')
    {p : (viewOverIntegers B S hS hZ X).obj (op V)}
    {p' : (viewOverIntegers B S hS hZ X).obj (op V')}
    (hp : p = (viewOverIntegers B S hS hZ X).map m.op p') :
    m.left ≫ p'.1.1 = p.1.1 := by
  subst hp
  rfl

/-- The section of `X` of a section of the view over `Spec ℤ` transported along a morphism of the
site is the restriction of the section along the underlying morphism of schemes. -/
theorem viewOverIntegers_snd_eq_of_eq_map {V V' : BigFppfOver B (⊤_ Scheme.{u}) hZ} (m : V ⟶ V')
    {p : (viewOverIntegers B S hS hZ X).obj (op V)}
    {p' : (viewOverIntegers B S hS hZ X).obj (op V')}
    (hp : p = (viewOverIntegers B S hS hZ X).map m.op p') (e : m.left ≫ p'.1.1 = p.1.1) :
    X.map (Over.homMk m.left e : Over.mk p.1.1 ⟶ Over.mk p'.1.1).op p'.1.2 = p.1.2 := by
  subst hp
  rfl

/-- The chart of `X` named by a chart of its view over `Spec ℤ` is an étale chart. -/
theorem isEtaleChart_of_viewOverIntegers
    (A : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :
    IsEtaleChart B S hS X
      (CostructuredArrow.mk (yonedaEquiv.symm (yonedaEquiv A.obj.hom).1.2)) := by
  have h1 : (MorphismProperty.inverseImage (@AlgebraicGeometry.Etale.{u} : MorphismProperty _)
      (BigFppfOver.toScheme B (⊤_ Scheme.{u}) hZ)).presheaf A.obj.hom := A.property
  rw [eq_relocalizeBaseHom_comp_relocalizeChart A.obj.hom] at h1
  have h2 := (MorphismProperty.cancel_left_of_respectsIso _ _ _).1 h1
  exact (presheaf_relocalizeChart_iff B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
    (@AlgebraicGeometry.Etale.{u}) _).1 h2

variable (B S hS hZ X) in
/-- The étale charts of the view over `Spec ℤ` of an algebraic space over `S` are étale charts of
the space: a chart is a section of the view, that is a factorization through `S` together with a
section of `X`. -/
noncomputable def smallEtaleFromIntegers :
    SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X) ⥤ SmallEtale B S hS X where
  obj A := ⟨CostructuredArrow.mk (yonedaEquiv.symm (yonedaEquiv A.obj.hom).1.2),
    isEtaleChart_of_viewOverIntegers A⟩
  map {A A'} f :=
    have hp : yonedaEquiv A.obj.hom =
        (viewOverIntegers B S hS hZ X).map f.hom.left.op (yonedaEquiv A'.obj.hom) := by
      rw [yonedaEquiv_naturality, CostructuredArrow.w f.hom]
    have e := viewOverIntegers_fst_eq_of_eq_map f.hom.left hp
    ObjectProperty.homMk (CostructuredArrow.homMk (Over.homMk f.hom.left.left e :
        Over.mk (yonedaEquiv A.obj.hom).1.1 ⟶ Over.mk (yonedaEquiv A'.obj.hom).1.1) (by
      apply yonedaEquiv.injective
      change yonedaEquiv (yoneda.map (Over.homMk f.hom.left.left e :
          Over.mk (yonedaEquiv A.obj.hom).1.1 ⟶ Over.mk (yonedaEquiv A'.obj.hom).1.1) ≫
          yonedaEquiv.symm (yonedaEquiv A'.obj.hom).1.2) =
        yonedaEquiv (yonedaEquiv.symm (yonedaEquiv A.obj.hom).1.2)
      rw [← yonedaEquiv_naturality, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact viewOverIntegers_snd_eq_of_eq_map f.hom.left hp e))
  map_id _ := ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (Over.OverMorphism.ext rfl))
  map_comp _ _ :=
    ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (Over.OverMorphism.ext rfl))

/-- The inverse comparison functor leaves the underlying object of `Sch_κ` of a chart
unchanged. -/
theorem smallEtaleFromIntegers_comp_toSchemes :
    smallEtaleFromIntegers B S hS hZ X ⋙ SmallEtale.toSchemes B S hS X =
      SmallEtale.toSchemes B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X) := rfl


/-- The factorization named by the extension of a chart `a : h_U ⟶ X` is the structure morphism
of `U`. -/
theorem fst_yonedaEquiv_relocalizeChart {U : BigFppfOver B S hS} (a : yoneda.obj U ⟶ X) :
    (yonedaEquiv (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a)).1.1 =
      U.hom :=
  Category.id_comp U.hom

/-- The chart named by the section of the extension of a chart `a` is `a` itself, read along
the identity of the underlying scheme. -/
theorem homMk_comp_yonedaEquiv_symm_relocalizeChart {U : BigFppfOver B S hS}
    (a : yoneda.obj U ⟶ X) :
    yoneda.map (Over.homMk (𝟙 U.left)
        ((Category.id_comp _).trans (fst_yonedaEquiv_relocalizeChart (hZ := hZ) a)) :
        U ⟶ Over.mk (yonedaEquiv (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) a)).1.1) ≫
      yonedaEquiv.symm (yonedaEquiv (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) a)).1.2 = a := by
  apply yonedaEquiv.injective
  rw [← yonedaEquiv_naturality, Equiv.apply_symm_apply]
  show X.map _ (a.app _ _) = a.app _ _
  refine (NatTrans.naturality_apply a _ _).symm.trans (congrArg (a.app (op U)) ?_)
  exact Over.OverMorphism.ext (by
    show 𝟙 U.left ≫ 𝟙 U.left = 𝟙 U.left
    exact Category.comp_id _)

variable (B S hS hZ X) in
/-- The unit of the comparison of the two small étale sites. -/
noncomputable def smallEtaleIntegersUnitIso :
    𝟭 (SmallEtale B S hS X) ≅
      smallEtaleToIntegers B S hS hZ X ⋙ smallEtaleFromIntegers B S hS hZ X :=
  NatIso.ofComponents
    (fun U => ObjectProperty.isoMk (P := IsEtaleChart B S hS X)
      (CostructuredArrow.isoMk (Over.isoMk (Iso.refl U.obj.left.left)
          ((Category.id_comp _).trans (fst_yonedaEquiv_relocalizeChart (hZ := hZ) U.obj.hom)))
        (homMk_comp_yonedaEquiv_symm_relocalizeChart U.obj.hom)))
    (fun _ => ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _
      (Over.OverMorphism.ext ((Category.comp_id _).trans (Category.id_comp _).symm))))

variable (B S hS hZ X) in
/-- The counit of the comparison of the two small étale sites. -/
noncomputable def smallEtaleIntegersCounitIso :
    smallEtaleFromIntegers B S hS hZ X ⋙ smallEtaleToIntegers B S hS hZ X ≅
      𝟭 (SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  NatIso.ofComponents
    (fun A => ObjectProperty.isoMk
      (P := IsEtaleChart B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (CostructuredArrow.isoMk (asIso (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) (yonedaEquiv A.obj.hom).2)).symm (by
        refine ((congrArg (yoneda.map (inv (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) (yonedaEquiv A.obj.hom).2)) ≫ ·)
            (eq_relocalizeBaseHom_comp_relocalizeChart A.obj.hom)).trans ?_)
        change yoneda.map _ ≫ yoneda.map _ ≫ _ = _
        rw [← Category.assoc, ← CategoryTheory.Functor.map_comp, IsIso.inv_hom_id,
          CategoryTheory.Functor.map_id, Category.id_comp]
        rfl)))
    (fun {A A'} f => ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _
      (Over.OverMorphism.ext (by
        change f.hom.left.left ≫ (inv (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ
            (integersMap B S hS hZ) (yonedaEquiv A'.obj.hom).2)).left =
          (inv (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ
            (integersMap B S hS hZ) (yonedaEquiv A.obj.hom).2)).left ≫ f.hom.left.left
        rw [inv_relocalizeBaseHom_left, inv_relocalizeBaseHom_left, Category.comp_id]
        exact (Category.id_comp _).symm))))

variable (B S hS hZ X) in
/-- **The small étale site of an algebraic space does not depend on the base**: viewing `X`
over `Spec ℤ` gives an equivalent small étale site, with the same underlying schemes. -/
noncomputable def smallEtaleIntegersEquivalence :
    SmallEtale B S hS X ≌ SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X) :=
  CategoryTheory.Equivalence.mk (smallEtaleToIntegers B S hS hZ X)
    (smallEtaleFromIntegers B S hS hZ X)
    (smallEtaleIntegersUnitIso B S hS hZ X) (smallEtaleIntegersCounitIso B S hS hZ X)


variable (B S hS hZ X)

/-- The comparison functor is an equivalence. -/
instance isEquivalence_smallEtaleToIntegers :
    (smallEtaleToIntegers B S hS hZ X).IsEquivalence :=
  (smallEtaleIntegersEquivalence B S hS hZ X).isEquivalence_functor

/-- The inverse comparison functor is an equivalence. -/
instance isEquivalence_smallEtaleFromIntegers :
    (smallEtaleFromIntegers B S hS hZ X).IsEquivalence :=
  (smallEtaleIntegersEquivalence B S hS hZ X).isEquivalence_inverse

/-- A functor between small étale sites leaving the underlying schemes unchanged is cover
preserving: covering families of charts are detected on their underlying schemes. -/
private theorem coverPreserving_of_comp_toSchemes {S₁ S₂ : Scheme.{u}} {hS₁ : B.Contains S₁}
    {hS₂ : B.Contains S₂} {X₁ : (BigFppfOver B S₁ hS₁)ᵒᵖ ⥤ Type u}
    {X₂ : (BigFppfOver B S₂ hS₂)ᵒᵖ ⥤ Type u}
    (F : SmallEtale B S₁ hS₁ X₁ ⥤ SmallEtale B S₂ hS₂ X₂) [F.IsEquivalence]
    (hF : F ⋙ SmallEtale.toSchemes B S₂ hS₂ X₂ = SmallEtale.toSchemes B S₁ hS₁ X₁) :
    CoverPreserving (SmallEtale.topology B S₁ hS₁ X₁) (SmallEtale.topology B S₂ hS₂ X₂) F := by
  refine coverPreserving_of_generators _ (SmallEtale.precoverage B S₁ hS₁ X₁) _ ?_
  intro A R hR
  rw [← Sieve.generate_map_eq_functorPushforward]
  refine Precoverage.generate_mem_toGrothendieck ?_
  rw [SmallEtale.precoverage_eq_comap, Precoverage.mem_comap_iff] at hR ⊢
  have := hF ▸ hR
  rwa [← Presieve.map_functor_comp]

/-- The comparison functor is cover preserving: covering families of charts are detected on
their underlying schemes, which it leaves unchanged. -/
theorem coverPreserving_smallEtaleToIntegers :
    CoverPreserving (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (smallEtaleToIntegers B S hS hZ X) :=
  coverPreserving_of_comp_toSchemes B _ (smallEtaleToIntegers_comp_toSchemes B S hS hZ X)

/-- The inverse comparison functor is cover preserving. -/
theorem coverPreserving_smallEtaleFromIntegers :
    CoverPreserving (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) (smallEtaleFromIntegers B S hS hZ X) :=
  coverPreserving_of_comp_toSchemes B _ smallEtaleFromIntegers_comp_toSchemes

/-- The comparison functor is continuous. -/
instance isContinuous_smallEtaleToIntegers :
    (smallEtaleToIntegers B S hS hZ X).IsContinuous (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) := by
  have : (smallEtaleToIntegers B S hS hZ X).IsRightAdjoint :=
    (smallEtaleIntegersEquivalence B S hS hZ X).symm.isRightAdjoint_inverse
  exact Functor.isContinuous_iff_coverPreserving.2
    (coverPreserving_smallEtaleToIntegers B S hS hZ X)

/-- The inverse comparison functor is continuous. -/
instance isContinuous_smallEtaleFromIntegers :
    (smallEtaleFromIntegers B S hS hZ X).IsContinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) := by
  have : (smallEtaleFromIntegers B S hS hZ X).IsRightAdjoint :=
    (smallEtaleIntegersEquivalence B S hS hZ X).isRightAdjoint_inverse
  exact Functor.isContinuous_iff_coverPreserving.2
    (coverPreserving_smallEtaleFromIntegers B S hS hZ X)

/-- The comparison functor is cocontinuous: its inverse is cover preserving. -/
instance isCocontinuous_smallEtaleToIntegers :
    (smallEtaleToIntegers B S hS hZ X).IsCocontinuous (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  ((smallEtaleIntegersEquivalence B S hS hZ X).toAdjunction.isCocontinuous_iff_coverPreserving
    _ _).2 (coverPreserving_smallEtaleFromIntegers B S hS hZ X)

/-- The inverse comparison functor is cocontinuous: the comparison functor is cover
preserving. -/
instance isCocontinuous_smallEtaleFromIntegers :
    (smallEtaleFromIntegers B S hS hZ X).IsCocontinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) :=
  ((smallEtaleIntegersEquivalence B S hS hZ X).symm.toAdjunction.isCocontinuous_iff_coverPreserving
    _ _).2 (coverPreserving_smallEtaleToIntegers B S hS hZ X)

/-- `AlgebraicGeometry.Space.isCocontinuous_smallEtaleToIntegers`, for the functor of the
equivalence. -/
instance isCocontinuous_smallEtaleIntegersEquivalence_functor :
    (smallEtaleIntegersEquivalence B S hS hZ X).functor.IsCocontinuous
      (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  isCocontinuous_smallEtaleToIntegers B S hS hZ X

/-- `AlgebraicGeometry.Space.isCocontinuous_smallEtaleFromIntegers`, for the inverse of the
equivalence. -/
instance isCocontinuous_smallEtaleIntegersEquivalence_inverse :
    (smallEtaleIntegersEquivalence B S hS hZ X).inverse.IsCocontinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) :=
  isCocontinuous_smallEtaleFromIntegers B S hS hZ X

/-- `AlgebraicGeometry.Space.isContinuous_smallEtaleToIntegers`, for the functor of the
equivalence. -/
instance isContinuous_smallEtaleIntegersEquivalence_functor :
    (smallEtaleIntegersEquivalence B S hS hZ X).functor.IsContinuous
      (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  isContinuous_smallEtaleToIntegers B S hS hZ X

/-- `AlgebraicGeometry.Space.isContinuous_smallEtaleFromIntegers`, for the inverse of the
equivalence. -/
instance isContinuous_smallEtaleIntegersEquivalence_inverse :
    (smallEtaleIntegersEquivalence B S hS hZ X).inverse.IsContinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) :=
  isContinuous_smallEtaleFromIntegers B S hS hZ X

/-- The comparison functor is a dense subsite inclusion: the two small étale topologies
correspond along it. -/
instance isDenseSubsite_smallEtaleIntegersEquivalence_functor :
    (smallEtaleIntegersEquivalence B S hS hZ X).functor.IsDenseSubsite
      (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  Equivalence.isDenseSubsite_functor_of_isCocontinuous _ _
    (smallEtaleIntegersEquivalence B S hS hZ X)

/-- The inverse comparison functor is a dense subsite inclusion. -/
instance isDenseSubsite_smallEtaleIntegersEquivalence_inverse :
    (smallEtaleIntegersEquivalence B S hS hZ X).inverse.IsDenseSubsite
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) :=
  Equivalence.isDenseSubsite_inverse_of_isCocontinuous _ _
    (smallEtaleIntegersEquivalence B S hS hZ X)


/-! ### Modules -/

/-- The structure sheaf of the view over `Spec ℤ`, transported to the small étale site of `X`
along the comparison of the two sites, is the structure sheaf of `X`: the comparison leaves the
underlying schemes unchanged. -/
theorem reindexRing_smallEtaleIntegersEquivalence :
    Stacks.SheafOfModules.reindexRing (SmallEtale.topology B S hS X)
        (smallEtaleIntegersEquivalence B S hS hZ X)
        (ringStructureSheaf B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) =
      ringStructureSheaf B S hS X := rfl

/-- **The `𝒪`-modules of an algebraic space and of its view over `Spec ℤ` agree**: reindexing
along the comparison of the two small étale sites is an equivalence of module categories. -/
noncomputable def modulesIntegersEquivalence (hX : IsAlgebraicSpace B S hS X) :
    Modules.{u, u} B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)
        (isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) X hX) ≌
      Modules.{u, u} B S hS X hX :=
  Stacks.SheafOfModules.reindexEquivalence (J' := SmallEtale.topology B S hS X)
    (smallEtaleIntegersEquivalence B S hS hZ X)
    (ringStructureSheaf B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))

/-- Quasi-coherence is unchanged by the comparison of the module categories. -/
theorem isQuasicoherentOnSite_modulesIntegersEquivalence_functor_obj_iff
    (hX : IsAlgebraicSpace B S hS X)
    (M : Modules.{u, u} B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)
      (isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) X hX)) :
    ((modulesIntegersEquivalence B S hS hZ X hX).functor.obj M).IsQuasicoherentOnSite ↔
      M.IsQuasicoherentOnSite :=
  Stacks.SheafOfModules.isQuasicoherentOnSite_reindex_iff (J' := SmallEtale.topology B S hS X)
    (smallEtaleIntegersEquivalence B S hS hZ X)
    (ringStructureSheaf B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) M

/-- Finite presentation is unchanged by the comparison of the module categories. -/
theorem isFinitePresentation_modulesIntegersEquivalence_functor_obj_iff
    (hX : IsAlgebraicSpace B S hS X)
    (M : Modules.{u, u} B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)
      (isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) X hX)) :
    ((modulesIntegersEquivalence B S hS hZ X hX).functor.obj M).IsFinitePresentation ↔
      M.IsFinitePresentation :=
  (Stacks.SheafOfModules.isFinitePresentation_reindex_iff (J' := SmallEtale.topology B S hS X)
    (smallEtaleIntegersEquivalence B S hS hZ X)
    (ringStructureSheaf B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) M).symm


/-- **A filtered presentation by modules of finite presentation transfers from the view over
`Spec ℤ`.**  If every quasi-coherent module on the view of `X` over `Spec ℤ` is a filtered colimit
of modules of finite presentation, then so is every quasi-coherent module on `X`: the two module
categories are identified by `AlgebraicGeometry.Space.modulesIntegersEquivalence`, which matches
quasi-coherence and finite presentation. -/
theorem exists_isFilteredColimit_isFinitePresentation_of_viewOverIntegers
    (hX : IsAlgebraicSpace B S hS X)
    (h : ∀ F' : Modules.{u, u} B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)
        (isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) X hX),
      F'.IsQuasicoherentOnSite →
        ∃ (K : Type w) (inst : Category.{w'} K),
          let _ := inst
          ∃ (_ : IsFiltered K) (D : K ⥤ Modules.{u, u} B (⊤_ Scheme.{u}) hZ
              (viewOverIntegers B S hS hZ X)
              (isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) X hX))
            (φ : D ⟶ (Functor.const K).obj F'),
            (∀ k, (D.obj k).IsFinitePresentation) ∧ Nonempty (IsColimit (Cocone.mk F' φ)))
    (F : Modules.{u, u} B S hS X hX) (hF : F.IsQuasicoherentOnSite) :
    ∃ (K : Type w) (inst : Category.{w'} K),
      let _ := inst
      ∃ (_ : IsFiltered K) (D : K ⥤ Modules.{u, u} B S hS X hX)
        (φ : D ⟶ (Functor.const K).obj F),
        (∀ k, (D.obj k).IsFinitePresentation) ∧ Nonempty (IsColimit (Cocone.mk F φ)) := by
  let E := modulesIntegersEquivalence B S hS hZ X hX
  have hF' : (E.inverse.obj F).IsQuasicoherentOnSite := by
    rw [← isQuasicoherentOnSite_modulesIntegersEquivalence_functor_obj_iff B S hS hZ X hX]
    exact SheafOfModules.IsQuasicoherentOnSite.of_iso (E.counitIso.app F).symm hF
  obtain ⟨K, inst, hK, D, φ, hD, ⟨hc⟩⟩ := h (E.inverse.obj F) hF'
  let _ := inst
  refine ⟨K, inst, hK, D ⋙ E.functor,
    Functor.whiskerRight φ E.functor ≫ (Functor.constComp K (E.inverse.obj F) E.functor).hom ≫
      (Functor.const K).map (E.counitIso.hom.app F), fun k => ?_, ⟨?_⟩⟩
  · exact (isFinitePresentation_modulesIntegersEquivalence_functor_obj_iff B S hS hZ X hX
      (D.obj k)).2 (hD k)
  · refine IsColimit.ofIsoColimit (isColimitOfPreserves E.functor hc)
      (Cocone.ext (E.counitIso.app F) fun k => ?_)
    simp

end AlgebraicGeometry.Space
