module

public import StacksFrontier.AlgebraicGeometry.Spaces.GrothendieckExistence.HomBijection.BaseIdealSheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.ProperGlobalSections.BaseIdeal
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ImageSubsheafUniversal

/-!
# The two constructions of the sheaf of ideals `I 𝒪_X` agree

For an algebraic space `X` over `Spec A` and an ideal `I ⊆ A`, the sheaf of ideals `I 𝒪_X` has
two constructions:

* `AlgebraicGeometry.Space.C1573.baseIdealSubmodule`, the image subsheaf of the inclusion
  `I 𝒪_X ⟶ 𝒪_X` of the image of multiplication by the elements of `I`
  (`AlgebraicGeometry.Space.idealMultiple`);
* `AlgebraicGeometry.Space.baseIdealSheaf`, the smallest sheaf of ideals with local membership
  containing `I · 𝒪_X(U)` over every étale chart `U`.

They are equal (`AlgebraicGeometry.Space.baseIdealSubmodule_eq_baseIdealSheaf`).  Both are the
smallest sheaf of ideals containing the functions `φ(a)`, `a ∈ I`: the image of `φ(a) : 𝒪_X ⟶ 𝒪_X`
lies in every sheaf of ideals containing `φ(a)`, and `φ(a)` is the image of the section `1`
under `𝒪_X ⟶ I 𝒪_X ⟶ 𝒪_X`.

This identifies the ideal of Grothendieck's existence theorem in the form
`AlgebraicGeometry.Space.isEquivalence_completionFunctorProperOver` (stated with
`C1573.baseIdealSubmodule`) with the ideal of the towers of thickenings (stated with
`baseIdealSheaf`).
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.SiteModules

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {A : Type u} [CommRing A] {hA : B.Contains (Spec (.of A))}
  (X : AlgebraicSpaces B (Spec (.of A)) hA) (I : Ideal A)

/-- `I 𝒪_X`, the sheaf of ideals with local membership generated by `I`, lies in the image of
multiplication by `I`: the function `φ(a)` is the image of `1` under `𝒪_X ⟶ I 𝒪_X ⟶ 𝒪_X`. -/
theorem baseIdealSheaf_le_baseIdealSubmodule :
    baseIdealSheaf A X I ≤ C1573.baseIdealSubmodule X.1 X.2 I := by
  let R := Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedSite B (Spec (.of A)) hA X.1 X.2).O
  refine Stacks.SheafOfModules.sheafifySubmodule_le fun ⟨U⟩ => ?_
  refine Ideal.map_le_of_le_comap fun a ha => ?_
  let : Semiring ((SheafOfModules.unit R).val.obj (op U)) :=
    inferInstanceAs (Semiring (R.obj.obj (op U)))
  have h := Stacks.SheafOfModules.ImageSubsheaf.apply_mem_imageSubmodule
    (idealMultipleι (baseRingHom A B hA X.1 X.2) (SheafOfModules.unit R) I)
    ((idealMultipleFactor (baseRingHom A B hA X.1 X.2) (SheafOfModules.unit R) I ha).val.app
      (op U) 1)
  have e := (C1573.idealMultipleFactor_ι_app (SheafOfModules.unit R) I ha U 1).trans (mul_one _)
  rw [e] at h
  exact Ideal.mem_comap.2 h

/-- The image of multiplication by `I` lies in `I 𝒪_X`: multiplication by `φ(a)`, `a ∈ I`,
factors through every sheaf of ideals containing `φ(a)`, hence so does the image of the sum of
these multiplications. -/
theorem baseIdealSubmodule_le_baseIdealSheaf :
    C1573.baseIdealSubmodule X.1 X.2 I ≤ baseIdealSheaf A X I := by
  set P := baseIdealSheaf A X I
  set φ := baseRingHom A B hA X.1 X.2
  set R := Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedSite B (Spec (.of A)) hA X.1 X.2).O
  set O := SheafOfModules.unit R
  -- each multiplication `φ(a)` factors through `P`
  have hc : ∀ a : ↥I, ∃ c : O ⟶ P.toSheafOfModules, c ≫ P.ι = globalSmul _ (φ a) O := by
    intro a
    refine (Stacks.SheafOfModules.ImageSubsheaf.exists_factorThru_iff_imageSubmodule_le _).2
      (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule_le _ fun U m => ?_)
    rw [globalSmul_app]
    have hr : (φ a).1 U ∈ P.obj U :=
      le_baseIdealSheaf A X I U.unop (Ideal.mem_map_of_mem _ a.2)
    have h := (P.obj U).smul_mem (show R.obj.obj U from m) hr
    convert h using 1
    exact mul_comm ((φ a).1 U : R.obj.obj U) (m : R.obj.obj U)
  choose c hc using hc
  have hf : idealMultipleHom φ O I = Sigma.desc c ≫ P.ι :=
    Sigma.hom_ext _ _ fun a => by rw [ι_idealMultipleHom, Sigma.ι_comp_desc_assoc, hc]
  have hw : idealMultipleHom φ O I ≫ cokernel.π P.ι = 0 := by
    rw [hf, Category.assoc, cokernel.condition, comp_zero]
  have hι : idealMultipleι φ O I ≫ cokernel.π P.ι = 0 := by
    rw [← cokernel.π_desc _ _ hw, ← Category.assoc,
      (kernel.condition (cokernel.π (idealMultipleHom φ O I)) : idealMultipleι φ O I ≫ _ = 0),
      zero_comp]
  exact (Stacks.SheafOfModules.ImageSubsheaf.exists_factorThru_iff_imageSubmodule_le _).1
    ⟨Abelian.monoLift P.ι _ hι, Abelian.monoLift_comp P.ι _ hι⟩

/-- **The two constructions of `I 𝒪_X` agree**: the image of multiplication by the elements of
`I` (`C1573.baseIdealSubmodule`) is the sheaf of ideals with local membership generated by `I`
(`baseIdealSheaf`). -/
theorem baseIdealSubmodule_eq_baseIdealSheaf :
    C1573.baseIdealSubmodule X.1 X.2 I = baseIdealSheaf A X I :=
  le_antisymm (baseIdealSubmodule_le_baseIdealSheaf X I) (baseIdealSheaf_le_baseIdealSubmodule X I)

end AlgebraicGeometry.Space

end
