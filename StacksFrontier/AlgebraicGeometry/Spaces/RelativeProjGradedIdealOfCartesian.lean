module

public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjDegreeIdeal

/-!
# The quasi-coherent graded ideal of a cartesian family of presheaf submodules

In Situation 0849 let `P_n ⊆ 𝒜_n` be objectwise submodules of the homogeneous pieces, stable
under restriction, closed under multiplication by homogeneous sections of `𝒜` on either side, and
such that along every morphism of affine charts `V ⟶ U` the sections of `P_n` over `V` are
generated by restrictions of sections of `P_n` over `U`.  This file shows that the closures of
the `P_n` (the smallest submodules with local membership containing them) form a quasi-coherent
graded ideal of Situation 0849, with the sections of `P_n` over every affine chart.

## Main definitions

* `AlgebraicGeometry.Space.RelativeProjSituation.gradedIdealOfCartesian`: the quasi-coherent
  graded ideal whose degree-`n` piece is the closure of `P_n`.

## Main results

* `AlgebraicGeometry.Space.RelativeProjSituation.gradedIdealOfCartesian_obj_of_isAffine`: over an
  affine chart its sections are those of `P_n`.
* `AlgebraicGeometry.Space.RelativeProjSituation.le_gradedIdealOfCartesian`: it contains `P_n`.
* `AlgebraicGeometry.Space.RelativeProjSituation.mem_gradedIdealOfCartesian_iff`: its sections are
  the sections lying in `P_n` locally.

## Implementation notes

Quasi-coherence is that of a module cartesian on affine charts, by
`AlgebraicGeometry.Space.isCartesianOnAffineCharts_sheafifySubmodule`.  Closure under
multiplication passes to the closure because multiplication is compatible with restriction: a
product with a section lying in `P_n` along a covering sieve lies in `P` along the same sieve.

## References

* [Stacks Project, Tag 085M](https://stacks.math.columbia.edu/tag/085M)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space.RelativeProjSituation

variable (s : RelativeProjSituation.{u, u}) (P : ∀ n : ℤ, (s.algebra.piece n).val.Submodule)

/-- **Left multiplication preserves the closure of a family closed under left multiplication.** -/
theorem mul_mem_sheafifySubmodule_left
    (hmul_left : ∀ (i j : ℤ) (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
      (a : (s.algebra.piece i).val.obj V) {x : (s.algebra.piece j).val.obj V},
      x ∈ (P j).obj V → (s.algebra.mul i j).app V a x ∈ (P (i + j)).obj V)
    (i j : ℤ) (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (a : (s.algebra.piece i).val.obj V) {x : (s.algebra.piece j).val.obj V}
    (hx : x ∈ (Stacks.SheafOfModules.sheafifySubmodule (P j)).obj V) :
    (s.algebra.mul i j).app V a x ∈
      (Stacks.SheafOfModules.sheafifySubmodule (P (i + j))).obj V := by
  obtain ⟨T, hT, hxT⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule hx
  refine Stacks.SheafOfModules.mem_sheafifySubmodule_of_mem hT fun Y g hg => ?_
  rw [(s.algebra.mul i j).naturality g.op a x]
  exact hmul_left i j (op Y) _ (hxT g hg)

/-- **Right multiplication preserves the closure of a family closed under right
multiplication.** -/
theorem mul_mem_sheafifySubmodule_right
    (hmul_right : ∀ (i j : ℤ) (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
      {x : (s.algebra.piece i).val.obj V} (b : (s.algebra.piece j).val.obj V),
      x ∈ (P i).obj V → (s.algebra.mul i j).app V x b ∈ (P (i + j)).obj V)
    (i j : ℤ) (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {x : (s.algebra.piece i).val.obj V} (b : (s.algebra.piece j).val.obj V)
    (hx : x ∈ (Stacks.SheafOfModules.sheafifySubmodule (P i)).obj V) :
    (s.algebra.mul i j).app V x b ∈
      (Stacks.SheafOfModules.sheafifySubmodule (P (i + j))).obj V := by
  obtain ⟨T, hT, hxT⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule hx
  refine Stacks.SheafOfModules.mem_sheafifySubmodule_of_mem hT fun Y g hg => ?_
  rw [(s.algebra.mul i j).naturality g.op x b]
  exact hmul_right i j (op Y) _ (hxT g hg)

variable
  (hmul_left : ∀ (i j : ℤ) (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (a : (s.algebra.piece i).val.obj V) {x : (s.algebra.piece j).val.obj V},
    x ∈ (P j).obj V → (s.algebra.mul i j).app V a x ∈ (P (i + j)).obj V)
  (hmul_right : ∀ (i j : ℤ) (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {x : (s.algebra.piece i).val.obj V} (b : (s.algebra.piece j).val.obj V),
    x ∈ (P i).obj V → (s.algebra.mul i j).app V x b ∈ (P (i + j)).obj V)
  (hcart : ∀ (n : ℤ) {U V : SmallEtale s.site s.base s.containsBase s.space.1},
    IsAffine (chartScheme U) → IsAffine (chartScheme V) → ∀ φ : V ⟶ U,
    (P n).obj (op V) ≤ Submodule.span (chartRing s.site s.base s.containsBase s.space.1 s.space.2 V)
      (chartRestrictLinear (s.algebra.piece n) φ ''
        ((P n).obj (op U) : Set ((s.algebra.piece n).val.obj (op U)))))

/-- **The quasi-coherent graded ideal of a cartesian multiplicative family of submodules.**  Its
degree-`n` piece is the smallest submodule of `𝒜_n` with local membership containing `P_n`. -/
def gradedIdealOfCartesian : s.GradedIdeal where
  piece n := Stacks.SheafOfModules.sheafifySubmodule (P n)
  mul_mem_left := mul_mem_sheafifySubmodule_left s P hmul_left
  mul_mem_right := mul_mem_sheafifySubmodule_right s P hmul_right
  isQuasicoherent n :=
    isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
      (isCartesianOnAffineCharts_sheafifySubmodule
        (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
          s.space.2 _ (s.isQuasicoherent n))
        (P n) fun hU hV φ => hcart n hU hV φ)

/-- The homogeneous pieces of `gradedIdealOfCartesian` are the closures of the `P_n`. -/
theorem gradedIdealOfCartesian_piece (n : ℤ) :
    (gradedIdealOfCartesian s P hmul_left hmul_right hcart).piece n =
      Stacks.SheafOfModules.sheafifySubmodule (P n) :=
  rfl

/-- **Over an affine chart the sections of `gradedIdealOfCartesian` are those of `P_n`.** -/
theorem gradedIdealOfCartesian_obj_of_isAffine (n : ℤ)
    {U : SmallEtale s.site s.base s.containsBase s.space.1} (hU : IsAffine (chartScheme U)) :
    ((gradedIdealOfCartesian s P hmul_left hmul_right hcart).piece n).obj (op U) =
      (P n).obj (op U) :=
  sheafifySubmodule_obj_eq_of_isAffine
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
      s.space.2 _ (s.isQuasicoherent n))
    (P n) (fun hU hV φ => hcart n hU hV φ) hU

/-- **`gradedIdealOfCartesian` contains `P_n`** over every chart. -/
theorem le_gradedIdealOfCartesian (n : ℤ) :
    P n ≤ ((gradedIdealOfCartesian s P hmul_left hmul_right hcart).piece n).toSubmodule :=
  Stacks.SheafOfModules.le_sheafifySubmodule (P n)

/-- **The sections of `gradedIdealOfCartesian` are the sections lying in `P_n` locally**: over any
chart, those restricting into `P_n` along every arrow of some covering sieve. -/
theorem mem_gradedIdealOfCartesian_iff (n : ℤ)
    {V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ}
    {x : (s.algebra.piece n).val.obj V} :
    x ∈ ((gradedIdealOfCartesian s P hmul_left hmul_right hcart).piece n).obj V ↔
      ∃ T : Sieve V.unop, T ∈ SmallEtale.topology s.site s.base s.containsBase s.space.1 V.unop ∧
        ∀ ⦃W : SmallEtale s.site s.base s.containsBase s.space.1⦄ (f : W ⟶ V.unop), T f →
          (s.algebra.piece n).val.map f.op x ∈ (P n).obj (op W) :=
  Stacks.SheafOfModules.mem_sheafifySubmodule_iff

end AlgebraicGeometry.Space.RelativeProjSituation

end
