module

public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationEndpoints
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationPathDecomposition
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.PreRelationTestPoints

/-!
# The generated relation is a pre-equivalence relation

Let `j : R ⟶ U ×_B U` be a pre-relation of algebraic spaces over an algebraic space `B`. The
relation `j_∞ : R_∞ ⟶ U ×_B U` generated by `j`, whose arrows are the finite composable paths
of original, identity and reversed arrows of `j`, is a *pre-equivalence relation* over `B`:
for every test scheme over `B` the relation it induces on the points of `U` is an equivalence
relation.

The three properties come from the three kinds of one-step arrow. Reflexivity is the identity
summand of the one-step relation. Symmetry reverses a path: the one-step relation carries an
involution exchanging its original and its reversed summand and fixing its identity summand,
and reversing a path means applying that involution to each link and reading the links
backwards. Transitivity concatenates two paths, which the iterated fibre products of the path
construction do by recursion on the length of the first.

A point of the generated relation has no single length, so neither reversal nor concatenation
is available on it directly: both are defined length by length, and the point is split into
its parts of each length by pulling the inclusions of the finite lengths back along it. That
the resulting pieces cover the test object is the universality of the coproduct over the
lengths, which is `AlgebraicGeometry.Space.allPaths_pullback_coproduct`.

## Main definitions

* `AlgebraicGeometry.Space.reverseOneStep` is the involution of the one-step relation that
  exchanges the original and the reversed arrows.

## Main results

* `AlgebraicGeometry.Space.reverseOneStep_target` and
  `AlgebraicGeometry.Space.reverseOneStep_source`: that involution exchanges the two endpoint
  maps of the one-step relation.
* `AlgebraicGeometry.Space.exists_concat_path`: two composable points of the path spaces of
  lengths `n + 1` and `m + 1` concatenate to a point of the path space of length `m + n + 2`
  with the outer endpoints.
* `AlgebraicGeometry.Space.isPreEquivalenceRelation_allPathsRelation`: **Stacks 048T**, the
  generated relation is a pre-equivalence relation.

## Implementation notes

`AlgebraicGeometry.Space.PathConstruction` lives in the slice of the algebraic spaces over
`B`, where the coproducts and the fibre products that build the paths are taken, while a
pre-equivalence relation is a condition on test points and is therefore stated in the slice of
presheaves over `B.obj`. The statement here is accordingly about the image of the generated
relation under `AlgebraicGeometry.Space.presheafPreRelation`, and the test points of the
source are turned into morphisms out of a representable algebraic space over `B` by
`AlgebraicGeometry.Space.rel_presheafPreRelation_iff`; all of the work then happens in the
slice of the algebraic spaces.

The concatenation of a path of length `n + 1` and one of length `m + 1` is indexed by
`m + n + 1` rather than by `n + m + 1`: the recursion is on `n`, so writing the summand being
recursed on last makes the index of each recursive call reduce to the index of its result with
no transport along an equality of natural numbers.

Gluing a morphism out of a test object from morphisms out of the pieces of a decomposition of
it, which both symmetry and transitivity need and transitivity needs twice, is done once in
the private `exists_hom_of_pieces`: it takes the pieces as an arbitrary colimit cofan, so the
two decompositions and the nested decomposition of a piece are all instances of it.

## References

* [Stacks Project, Tag 043C](https://stacks.math.columbia.edu/tag/043C)
* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v u

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS} {R U : Over B} {j : PreRelation R U}

/-! ### Reversing a one-step arrow -/

/-- The involution of the one-step relation generated by a pre-relation that exchanges the
summand of the original arrows with the summand of the reversed arrows and fixes the summand
of the identity arrows. -/
noncomputable def reverseOneStep (P : PathConstruction j) : P.path 0 ⟶ P.path 0 :=
  Cofan.IsColimit.desc P.firstIsCoproduct fun i =>
    Fin.cases (P.firstInclusion 2)
      (fun i => Fin.cases (P.firstInclusion 1)
        (fun i => Fin.cases (P.firstInclusion 0) (fun i => Fin.elim0 i) i) i) i

/-- Reversal takes an original arrow to the same arrow, read as a reversed one. -/
private theorem firstInclusion_zero_reverseOneStep (P : PathConstruction j) :
    P.firstInclusion 0 ≫ reverseOneStep P = P.firstInclusion 2 :=
  Cofan.IsColimit.fac P.firstIsCoproduct _ 0

/-- Reversal fixes an identity arrow. -/
private theorem firstInclusion_one_reverseOneStep (P : PathConstruction j) :
    P.firstInclusion 1 ≫ reverseOneStep P = P.firstInclusion 1 :=
  Cofan.IsColimit.fac P.firstIsCoproduct _ 1

/-- Reversal takes a reversed arrow to the same arrow, read as an original one. -/
private theorem firstInclusion_two_reverseOneStep (P : PathConstruction j) :
    P.firstInclusion 2 ≫ reverseOneStep P = P.firstInclusion 0 :=
  Cofan.IsColimit.fac P.firstIsCoproduct _ 2

/-- A morphism out of the one-step relation is determined by what reversal does to each of
the three summands. -/
private theorem reverseOneStep_comp_eq (P : PathConstruction j) {X : Over B}
    (a b : P.path 0 ⟶ X) (h₀ : P.firstInclusion 2 ≫ a = P.firstInclusion 0 ≫ b)
    (h₁ : P.firstInclusion 1 ≫ a = P.firstInclusion 1 ≫ b)
    (h₂ : P.firstInclusion 0 ≫ a = P.firstInclusion 2 ≫ b) :
    reverseOneStep P ≫ a = b := by
  refine Cofan.IsColimit.hom_ext P.firstIsCoproduct _ _ fun i => ?_
  rw [← Category.assoc]
  exact Fin.cases (by
      change (P.firstInclusion 0 ≫ _) ≫ a = _
      rwa [firstInclusion_zero_reverseOneStep]) (fun i => Fin.cases
    (by
      change (P.firstInclusion 1 ≫ _) ≫ a = _
      rwa [firstInclusion_one_reverseOneStep]) (fun i => Fin.cases
      (by
      change (P.firstInclusion 2 ≫ _) ≫ a = _
      rwa [firstInclusion_two_reverseOneStep]) (fun i => Fin.elim0 i) i) i) i

/-- Reversing a one-step arrow exchanges its target with its source. -/
theorem reverseOneStep_target (P : PathConstruction j) :
    reverseOneStep P ≫ (P.pathRelation 0).target = (P.pathRelation 0).source :=
  reverseOneStep_comp_eq P _ _
    (by rw [P.firstInclusion_two_target, P.firstInclusion_zero_source])
    (by rw [P.firstInclusion_one_target, P.firstInclusion_one_source])
    (by rw [P.firstInclusion_zero_target, P.firstInclusion_two_source])

/-- Reversing a one-step arrow exchanges its source with its target. -/
theorem reverseOneStep_source (P : PathConstruction j) :
    reverseOneStep P ≫ (P.pathRelation 0).source = (P.pathRelation 0).target :=
  reverseOneStep_comp_eq P _ _
    (by rw [P.firstInclusion_two_source, P.firstInclusion_zero_target])
    (by rw [P.firstInclusion_one_source, P.firstInclusion_one_target])
    (by rw [P.firstInclusion_zero_source, P.firstInclusion_two_target])

/-! ### Reversing a finite path -/

/-- The reverse of a finite path: each link is reversed, and the links are read backwards. -/
private noncomputable def reverseFinitePath (P : PathConstruction j) {T : Over B} {n : ℕ}
    (p : FinitePath P T n) : FinitePath P T n where
  link i := p.link i.rev ≫ reverseOneStep P
  composable i := by
    rw [Fin.rev_castSucc, Fin.rev_succ, Category.assoc, reverseOneStep_source,
      Category.assoc, reverseOneStep_target]
    exact (p.composable i.rev).symm

/-- The links of a reversed finite path. -/
private theorem reverseFinitePath_link (P : PathConstruction j) {T : Over B} {n : ℕ}
    (p : FinitePath P T n) (i : Fin (n + 1)) :
    (reverseFinitePath P p).link i = p.link i.rev ≫ reverseOneStep P := rfl

/-- The reverse of a point of the path space of a given length. -/
private noncomputable def reversePathPoint (P : PathConstruction j) {T : Over B} (n : ℕ)
    (f : T ⟶ P.path n) : T ⟶ P.path n :=
  (homPathEquivFinitePath P T n).symm (reverseFinitePath P (homPathEquivFinitePath P T n f))

/-- The target of a reversed path is the source of the path. -/
private theorem reversePathPoint_target (P : PathConstruction j) {T : Over B} (n : ℕ)
    (f : T ⟶ P.path n) :
    reversePathPoint P n f ≫ (P.pathRelation n).target =
      f ≫ (P.pathRelation n).source := by
  rw [reversePathPoint, finitePath_to_hom_target, reverseFinitePath_link, Fin.rev_zero,
    Category.assoc, reverseOneStep_target]
  exact (finitePath_source P n f).symm

/-- The source of a reversed path is the target of the path. -/
private theorem reversePathPoint_source (P : PathConstruction j) {T : Over B} (n : ℕ)
    (f : T ⟶ P.path n) :
    reversePathPoint P n f ≫ (P.pathRelation n).source =
      f ≫ (P.pathRelation n).target := by
  rw [reversePathPoint, finitePath_to_hom_source, reverseFinitePath_link, Fin.rev_last,
    Category.assoc, reverseOneStep_source]
  exact (finitePath_target P n f).symm

/-! ### Concatenating two finite paths -/

/-- Two composable points of the path spaces of lengths `n + 1` and `m + 1` concatenate to a
point of the path space of length `m + n + 2`, whose target is the target of the first and
whose source is the source of the second. -/
theorem exists_concat_path (P : PathConstruction j) {T : Over B} (n m : ℕ)
    (f : T ⟶ P.path n) (g : T ⟶ P.path m)
    (h : f ≫ (P.pathRelation n).source = g ≫ (P.pathRelation m).target) :
    ∃ w : T ⟶ P.path (m + n + 1),
      w ≫ (P.pathRelation (m + n + 1)).target = f ≫ (P.pathRelation n).target ∧
        w ≫ (P.pathRelation (m + n + 1)).source = g ≫ (P.pathRelation m).source := by
  induction n with
  | zero =>
    simp only [Nat.add_zero]
    refine ⟨(P.successorIsPullback m).lift f g h, ?_, ?_⟩
    · rw [P.pathRelation_succ_target, ← Category.assoc,
        (P.successorIsPullback m).lift_fst]
    · rw [P.pathRelation_succ_source, ← Category.assoc,
        (P.successorIsPullback m).lift_snd]
  | succ n ih =>
    have htail : (f ≫ P.remainingPath n) ≫ (P.pathRelation n).source =
        g ≫ (P.pathRelation m).target := by
      rw [Category.assoc, ← P.pathRelation_succ_source n, h]
    obtain ⟨t, htt, hts⟩ := ih (f ≫ P.remainingPath n) htail
    have hjoin : (f ≫ P.firstArrow n) ≫ (P.pathRelation 0).source =
        t ≫ (P.pathRelation (m + n + 1)).target := by
      rw [htt, Category.assoc, Category.assoc, (P.successorIsPullback n).w]
    -- The index of the concatenation is stated in its left-associated normal form, which is
    -- the form the fibre product of the path construction has it in.
    have key : ∃ w : T ⟶ P.path (m + n + 1 + 1),
        w ≫ (P.pathRelation (m + n + 1 + 1)).target =
            f ≫ (P.pathRelation (n + 1)).target ∧
          w ≫ (P.pathRelation (m + n + 1 + 1)).source =
            g ≫ (P.pathRelation m).source := by
      refine ⟨(P.successorIsPullback (m + n + 1)).lift (f ≫ P.firstArrow n) t hjoin, ?_, ?_⟩
      · rw [P.pathRelation_succ_target (m + n + 1), ← Category.assoc,
          (P.successorIsPullback (m + n + 1)).lift_fst, Category.assoc,
          ← P.pathRelation_succ_target n]
      · rw [P.pathRelation_succ_source (m + n + 1), ← Category.assoc,
          (P.successorIsPullback (m + n + 1)).lift_snd, hts]
    exact key

/-! ### The generated relation -/

/-- On the part of a point of the generated relation lying over the paths of one length, the
target of that path is the target of the point. -/
private theorem pullback_snd_pathRelation_target (P : PathConstruction j) {T : Over B}
    (r : T ⟶ P.allPaths) (n : ℕ) :
    pullback.snd r (P.pathInclusion n) ≫ (P.pathRelation n).target =
      pullback.fst r (P.pathInclusion n) ≫ r ≫ P.allPathsRelation.target := by
  rw [← P.pathInclusion_target, ← Category.assoc, ← pullback.condition, Category.assoc]

/-- On the part of a point of the generated relation lying over the paths of one length, the
source of that path is the source of the point. -/
private theorem pullback_snd_pathRelation_source (P : PathConstruction j) {T : Over B}
    (r : T ⟶ P.allPaths) (n : ℕ) :
    pullback.snd r (P.pathInclusion n) ≫ (P.pathRelation n).source =
      pullback.fst r (P.pathInclusion n) ≫ r ≫ P.allPathsRelation.source := by
  rw [← P.pathInclusion_source, ← Category.assoc, ← pullback.condition, Category.assoc]

/-- A point of the generated relation with prescribed endpoints may be glued from points over
the pieces of any decomposition of the test object as a coproduct. -/
private theorem exists_hom_of_pieces (P : PathConstruction j) {T : Over B} {I : Type v}
    {X : I → Over B} {pieces : (i : I) → X i ⟶ T} (hc : IsColimit (Cofan.mk T pieces))
    (u v : T ⟶ U)
    (hw : ∀ i, ∃ w : X i ⟶ P.allPaths,
      w ≫ P.allPathsRelation.target = pieces i ≫ u ∧
        w ≫ P.allPathsRelation.source = pieces i ≫ v) :
    ∃ s : T ⟶ P.allPaths,
      s ≫ P.allPathsRelation.target = u ∧ s ≫ P.allPathsRelation.source = v := by
  choose w hwt hws using hw
  have hfac : ∀ i, pieces i ≫ Cofan.IsColimit.desc hc w = w i := fun i =>
    Cofan.IsColimit.fac hc w i
  have h₁ : ∀ i, pieces i ≫ (Cofan.IsColimit.desc hc w ≫ P.allPathsRelation.target) =
      pieces i ≫ u := fun i => by rw [← Category.assoc, hfac i, hwt i]
  have h₂ : ∀ i, pieces i ≫ (Cofan.IsColimit.desc hc w ≫ P.allPathsRelation.source) =
      pieces i ≫ v := fun i => by rw [← Category.assoc, hfac i, hws i]
  exact ⟨Cofan.IsColimit.desc hc w, Cofan.IsColimit.hom_ext hc _ _ h₁,
    Cofan.IsColimit.hom_ext hc _ _ h₂⟩

/-- Every point of the generated relation is the reverse of a point with the two endpoints
exchanged: the test object is decomposed into its parts of each length, and on each part the
path of that length is reversed. -/
private theorem exists_reverse_allPaths (P : PathConstruction j) {T : Over B}
    (r : T ⟶ P.allPaths) :
    ∃ s : T ⟶ P.allPaths,
      s ≫ P.allPathsRelation.target = r ≫ P.allPathsRelation.source ∧
        s ≫ P.allPathsRelation.source = r ≫ P.allPathsRelation.target := by
  obtain ⟨hc⟩ := allPaths_pullback_coproduct P r
  refine exists_hom_of_pieces P hc _ _ fun n => ?_
  refine ⟨reversePathPoint P n (pullback.snd r (P.pathInclusion n)) ≫ P.pathInclusion n,
    ?_, ?_⟩
  · rw [Category.assoc, P.pathInclusion_target, reversePathPoint_target,
      pullback_snd_pathRelation_source]
  · rw [Category.assoc, P.pathInclusion_source, reversePathPoint_source,
      pullback_snd_pathRelation_target]

/-- Two points of the generated relation that meet, the source of the first being the target of
the second, are the two outer endpoints of a single point of it: the test object is decomposed
into its parts of each length twice over, and on each part the two paths are concatenated. -/
private theorem exists_concat_allPaths (P : PathConstruction j) {T : Over B}
    (r₁ r₂ : T ⟶ P.allPaths)
    (h : r₁ ≫ P.allPathsRelation.source = r₂ ≫ P.allPathsRelation.target) :
    ∃ s : T ⟶ P.allPaths,
      s ≫ P.allPathsRelation.target = r₁ ≫ P.allPathsRelation.target ∧
        s ≫ P.allPathsRelation.source = r₂ ≫ P.allPathsRelation.source := by
  obtain ⟨hc₁⟩ := allPaths_pullback_coproduct P r₁
  refine exists_hom_of_pieces P hc₁ _ _ fun n => ?_
  obtain ⟨hc₂⟩ := allPaths_pullback_coproduct P (pullback.fst r₁ (P.pathInclusion n) ≫ r₂)
  refine exists_hom_of_pieces P hc₂ _ _ fun m => ?_
  have hmid : (pullback.fst (pullback.fst r₁ (P.pathInclusion n) ≫ r₂) (P.pathInclusion m) ≫
      pullback.snd r₁ (P.pathInclusion n)) ≫ (P.pathRelation n).source =
        pullback.snd (pullback.fst r₁ (P.pathInclusion n) ≫ r₂) (P.pathInclusion m) ≫
          (P.pathRelation m).target := by
    rw [Category.assoc, pullback_snd_pathRelation_source,
      pullback_snd_pathRelation_target, h, Category.assoc]
  obtain ⟨c, hct, hcs⟩ := exists_concat_path P n m _ _ hmid
  refine ⟨c ≫ P.pathInclusion (m + n + 1), ?_, ?_⟩
  · rw [Category.assoc, P.pathInclusion_target, hct, Category.assoc,
      pullback_snd_pathRelation_target]
  · rw [Category.assoc, P.pathInclusion_source, hcs,
      pullback_snd_pathRelation_source, Category.assoc]

/-- A morphism out of the representable algebraic space of a test scheme is determined by the
test point it cuts out. -/
private theorem eq_of_overTestPoint_eq {T : BigFppfOver site S hS}
    {b : yoneda.obj T ⟶ B.obj} {X : Over B}
    {f g : representableOver (B := B) T b ⟶ X} (h : overTestPoint f = overTestPoint g) :
    f = g := by
  apply Over.OverMorphism.ext
  apply ObjectProperty.hom_ext
  exact congrArg Subtype.val h

/-- **Stacks 048T.** The relation generated by a pre-relation of algebraic spaces over `B`,
whose arrows are the finite composable paths of original, identity and reversed arrows, is a
pre-equivalence relation over `B`: on the points of every test scheme over `B` it induces an
equivalence relation.

Reflexivity is witnessed by the identity arrow of a point, symmetry by the reverse of a path,
and transitivity by the concatenation of two paths. -/
@[stacks 048T "the generated relation is a pre-equivalence relation"]
theorem isPreEquivalenceRelation_allPathsRelation (P : PathConstruction j) :
    IsPreEquivalenceRelation (presheafPreRelation P.allPathsRelation) := by
  intro T b
  refine ⟨?_, ?_, ?_⟩
  · intro x
    refine (rel_presheafPreRelation_iff _ _ _).mpr
      ⟨testPointOver x ≫ P.firstInclusion 1 ≫ P.pathInclusion 0, ?_, ?_⟩
    · simp only [Category.assoc, P.pathInclusion_target, P.firstInclusion_one_target,
        Category.comp_id, overTestPoint_testPointOver]
    · simp only [Category.assoc, P.pathInclusion_source, P.firstInclusion_one_source,
        Category.comp_id, overTestPoint_testPointOver]
  · intro x y hxy
    obtain ⟨r, hrt, hrs⟩ := (rel_presheafPreRelation_iff _ _ _).mp hxy
    obtain ⟨s, hst, hss⟩ := exists_reverse_allPaths P r
    exact (rel_presheafPreRelation_iff _ _ _).mpr ⟨s, by rwa [hst], by rwa [hss]⟩
  · intro x y z hxy hyz
    obtain ⟨r₁, hrt₁, hrs₁⟩ := (rel_presheafPreRelation_iff _ _ _).mp hxy
    obtain ⟨r₂, hrt₂, hrs₂⟩ := (rel_presheafPreRelation_iff _ _ _).mp hyz
    obtain ⟨s, hst, hss⟩ := exists_concat_allPaths P r₁ r₂
      (eq_of_overTestPoint_eq (hrs₁.trans hrt₂.symm))
    exact (rel_presheafPreRelation_iff _ _ _).mpr ⟨s, by rwa [hst], by rwa [hss]⟩

end AlgebraicGeometry.Space

end
