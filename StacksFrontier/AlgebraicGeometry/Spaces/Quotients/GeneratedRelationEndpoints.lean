module

public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationPaths

/-!
# The endpoint maps of the paths generated by a pre-relation

The path construction of a pre-relation `j : R ⟶ U ×_B U` of algebraic spaces over an
algebraic space `B` records its endpoint maps as single morphisms to the product `U ×_B U`.
Every consumer instead needs the two components separately: the target map of the original
arrows is the target map of `j`, the two maps of the reversed arrows are those of `j`
exchanged, the identity arrows have both maps the identity, and the two maps of a longer path
are the outer maps of its two pieces. This file records those equations once.

## Main results

* `AlgebraicGeometry.Space.PathConstruction.firstInclusion_zero_target` and its seven
  siblings: the target and the source maps on each of the three one-step summands.
* `AlgebraicGeometry.Space.PathConstruction.pathInclusion_target` and
  `AlgebraicGeometry.Space.PathConstruction.pathInclusion_source`: the generated relation
  restricts on each length to the relation of that length.
* `AlgebraicGeometry.Space.PathConstruction.pathRelation_succ_target` and
  `AlgebraicGeometry.Space.PathConstruction.pathRelation_succ_source`: the two maps of a path
  of length at least two.
* `AlgebraicGeometry.Space.PathConstruction.originalArrow_target` and
  `AlgebraicGeometry.Space.PathConstruction.originalArrow_source`: the inclusion of the
  original arrows among all finite paths carries the two maps of the generated relation to
  the two maps of `j`.

## Implementation notes

Each equation is the corresponding field of
`AlgebraicGeometry.Space.PathConstruction` composed with a projection of the product, so each
proof is one `congrArg` followed by reassociation; no further input is used.

## References

* [Stacks Project, Tag 048S](https://stacks.math.columbia.edu/tag/048S)
* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space.PathConstruction

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS} {R U : Over B} {j : PreRelation R U}
  (P : PathConstruction j)

/-- On the summand of the original arrows the target map of the one-step relation is the
target map of the pre-relation. -/
theorem firstInclusion_zero_target :
    P.firstInclusion 0 ≫ (P.pathRelation 0).target = j.target := by
  simpa only [PreRelation.target, Category.assoc] using
    congrArg (fun f => f ≫ prod.fst) P.originalEndpoints

/-- On the summand of the original arrows the source map of the one-step relation is the
source map of the pre-relation. -/
theorem firstInclusion_zero_source :
    P.firstInclusion 0 ≫ (P.pathRelation 0).source = j.source := by
  simpa only [PreRelation.source, Category.assoc] using
    congrArg (fun f => f ≫ prod.snd) P.originalEndpoints

/-- On the summand of the identity arrows the target map of the one-step relation is the
identity. -/
theorem firstInclusion_one_target :
    P.firstInclusion 1 ≫ (P.pathRelation 0).target = 𝟙 U := by
  simpa only [PreRelation.target, Category.assoc, diag, prod.lift_fst] using
    congrArg (fun f => f ≫ prod.fst) P.identityEndpoints

/-- On the summand of the identity arrows the source map of the one-step relation is the
identity. -/
theorem firstInclusion_one_source :
    P.firstInclusion 1 ≫ (P.pathRelation 0).source = 𝟙 U := by
  simpa only [PreRelation.source, Category.assoc, diag, prod.lift_snd] using
    congrArg (fun f => f ≫ prod.snd) P.identityEndpoints

/-- On the summand of the reversed arrows the target map of the one-step relation is the
source map of the pre-relation. -/
theorem firstInclusion_two_target :
    P.firstInclusion 2 ≫ (P.pathRelation 0).target = j.source := by
  simpa only [PreRelation.target, PreRelation.source, Category.assoc, flippedRelation,
    prod.lift_fst] using congrArg (fun f => f ≫ prod.fst) P.reversedEndpoints

/-- On the summand of the reversed arrows the source map of the one-step relation is the
target map of the pre-relation. -/
theorem firstInclusion_two_source :
    P.firstInclusion 2 ≫ (P.pathRelation 0).source = j.target := by
  simpa only [PreRelation.target, PreRelation.source, Category.assoc, flippedRelation,
    prod.lift_snd] using congrArg (fun f => f ≫ prod.snd) P.reversedEndpoints

/-- The target map of the generated relation restricts on the paths of one length to the
target map of that length. -/
theorem pathInclusion_target (n : ℕ) :
    P.pathInclusion n ≫ P.allPathsRelation.target = (P.pathRelation n).target := by
  simpa only [PreRelation.target, Category.assoc] using
    congrArg (fun f => f ≫ prod.fst) (P.allPathsEndpoints n)

/-- The source map of the generated relation restricts on the paths of one length to the
source map of that length. -/
theorem pathInclusion_source (n : ℕ) :
    P.pathInclusion n ≫ P.allPathsRelation.source = (P.pathRelation n).source := by
  simpa only [PreRelation.source, Category.assoc] using
    congrArg (fun f => f ≫ prod.snd) (P.allPathsEndpoints n)

/-- The target of a path of length at least two is the target of its first link. -/
theorem pathRelation_succ_target (n : ℕ) :
    (P.pathRelation (n + 1)).target = P.firstArrow n ≫ (P.pathRelation 0).target := by
  simpa only [PreRelation.target, Category.assoc, prod.lift_fst] using
    congrArg (fun f => f ≫ prod.fst) (P.successorEndpoints n)

/-- The source of a path of length at least two is the source of the path that remains after
its first link. -/
theorem pathRelation_succ_source (n : ℕ) :
    (P.pathRelation (n + 1)).source = P.remainingPath n ≫ (P.pathRelation n).source := by
  simpa only [PreRelation.source, Category.assoc, prod.lift_snd] using
    congrArg (fun f => f ≫ prod.snd) (P.successorEndpoints n)

/-- The inclusion of the original arrows among all finite paths carries the target map of the
generated relation to the target map of the pre-relation. -/
theorem originalArrow_target :
    (P.firstInclusion 0 ≫ P.pathInclusion 0) ≫ P.allPathsRelation.target = j.target := by
  rw [Category.assoc, P.pathInclusion_target, P.firstInclusion_zero_target]

/-- The inclusion of the original arrows among all finite paths carries the source map of the
generated relation to the source map of the pre-relation. -/
theorem originalArrow_source :
    (P.firstInclusion 0 ≫ P.pathInclusion 0) ≫ P.allPathsRelation.source = j.source := by
  rw [Category.assoc, P.pathInclusion_source, P.firstInclusion_zero_source]

end AlgebraicGeometry.Space.PathConstruction

end
