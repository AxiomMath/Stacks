module

public import StacksFrontier.AlgebraicGeometry.Spaces.PointsAndCoverings.FieldPointCoproduct
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationEndpoints
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationPathDecomposition
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.OrbitSpaces.GeometricOrbits
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.PreRelationTestPoints

/-!
# Orbits of the relation generated by a pre-relation

Let `j : R ⟶ U ×_B U` be a pre-relation of algebraic spaces over an algebraic space `B` and
let `j_∞ : R_∞ ⟶ U ×_B U` be the relation of all finite paths it generates. Over a
field-valued point of `B` the two relations induce the same weak equivalence on the points of
`U`: an arrow of `j` is a path of length one, and conversely a path over a field is a path of
some single finite length, hence a chain of arrows of `j` traversed in either direction.

Consequently weak orbits and orbits at a geometric point are unchanged by passing to the
generated relation.

## Main results

* `AlgebraicGeometry.Space.weaklyEquivalent_allPathsRelation_iff`: weak equivalence over a
  field-valued point is the same for the two relations.
* `AlgebraicGeometry.Space.weakOrbit_allPathsRelation`: **Stacks 048T, part (3)**.
* `AlgebraicGeometry.Space.equivalent_allPathsRelation_iff` and
  `AlgebraicGeometry.Space.orbit_allPathsRelation`: **Stacks 048T, part (4)**.

## Implementation notes

The relation on points, the weak orbit and the orbit of Stacks 048Q are stated in the slice
of presheaves over the underlying presheaf of `B`, while the path construction lives in the
slice of the algebraic spaces over `B`; the two are joined by
`AlgebraicGeometry.Space.presheafPreRelation`.

That a point of `R_∞` over a field lies in a single `R_n`, and that a point of `R_1` over a
field is a single original, identity or reversed arrow, is
`AlgebraicGeometry.Space.exists_factorisation_of_fieldValuedPoint`: the spectrum of a field is
connected, so it cannot be spread over two summands of a coproduct. This is the only place
where the field enters, and it is the reason the statement is about a field-valued point
rather than about an arbitrary test scheme.

Weak equivalence is proved for every field-valued point, not only for a geometric one. That
is what makes part (4) immediate from part (3): equivalence allows one extension of the
field, and the extension appearing in it is an arbitrary field-valued point, so no passage to
an algebraic closure is needed.

## References

* [Stacks Project, Tag 048Q](https://stacks.math.columbia.edu/tag/048Q)
* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS} {R U : Over B} {j : PreRelation R U}
  (P : PathConstruction j)

/-- An arrow of a pre-relation is an arrow of the relation it generates: it is a path of
length one. -/
theorem rel_allPathsRelation_of_rel {T : BigFppfOver site S hS} {b : yoneda.obj T ⟶ B.obj}
    {x y : TestPoint T b ((overForgetSpace B).obj U)} (h : (presheafPreRelation j).Rel b x y) :
    (presheafPreRelation P.allPathsRelation).Rel b x y := by
  rw [rel_presheafPreRelation_iff] at h ⊢
  obtain ⟨r, rfl, rfl⟩ := h
  have ht : (r ≫ P.firstInclusion 0 ≫ P.pathInclusion 0) ≫ P.allPathsRelation.target =
      r ≫ j.target := by
    rw [← P.originalArrow_target]
    simp only [Category.assoc]
  have hs : (r ≫ P.firstInclusion 0 ≫ P.pathInclusion 0) ≫ P.allPathsRelation.source =
      r ≫ j.source := by
    rw [← P.originalArrow_source]
    simp only [Category.assoc]
  exact ⟨r ≫ P.firstInclusion 0 ≫ P.pathInclusion 0, congrArg overTestPoint ht,
    congrArg overTestPoint hs⟩

/-- Over a field-valued point, the two endpoints of a one-step path are weakly equivalent: the
path is a single original, identity or reversed arrow. -/
private theorem weaklyEquivalent_oneStep (p : FieldValuedPoint site S hS B.obj)
    (r : representableOver (B := B) p.siteObject (yonedaEquiv.symm p.value) ⟶ P.path 0) :
    (presheafPreRelation j).WeaklyEquivalent p
      (overTestPoint (r ≫ (P.pathRelation 0).target))
      (overTestPoint (r ≫ (P.pathRelation 0).source)) := by
  obtain ⟨i, q, hq⟩ := exists_factorisation_of_fieldValuedPoint p (pathComponent R U)
    (P.path 0) P.firstInclusion r
    (Classical.choice (firstPath_pullback_coproduct P r))
  rw [← hq]
  fin_cases i
  · have ht : (q ≫ P.firstInclusion 0) ≫ (P.pathRelation 0).target = q ≫ j.target := by
      rw [Category.assoc, P.firstInclusion_zero_target]
    have hs : (q ≫ P.firstInclusion 0) ≫ (P.pathRelation 0).source = q ≫ j.source := by
      rw [Category.assoc, P.firstInclusion_zero_source]
    show (presheafPreRelation j).WeaklyEquivalent p
      (overTestPoint ((q ≫ P.firstInclusion 0) ≫ (P.pathRelation 0).target))
      (overTestPoint ((q ≫ P.firstInclusion 0) ≫ (P.pathRelation 0).source))
    rw [ht, hs]
    exact Relation.EqvGen.rel _ _ (rel_presheafPreRelation j q)
  · have ht : (q ≫ P.firstInclusion 1) ≫ (P.pathRelation 0).target = q := by
      rw [Category.assoc, P.firstInclusion_one_target]
      exact Category.comp_id q
    have hs : (q ≫ P.firstInclusion 1) ≫ (P.pathRelation 0).source = q := by
      rw [Category.assoc, P.firstInclusion_one_source]
      exact Category.comp_id q
    show (presheafPreRelation j).WeaklyEquivalent p
      (overTestPoint ((q ≫ P.firstInclusion 1) ≫ (P.pathRelation 0).target))
      (overTestPoint ((q ≫ P.firstInclusion 1) ≫ (P.pathRelation 0).source))
    rw [ht, hs]
    exact Relation.EqvGen.refl _
  · have ht : (q ≫ P.firstInclusion 2) ≫ (P.pathRelation 0).target = q ≫ j.source := by
      rw [Category.assoc, P.firstInclusion_two_target]
    have hs : (q ≫ P.firstInclusion 2) ≫ (P.pathRelation 0).source = q ≫ j.target := by
      rw [Category.assoc, P.firstInclusion_two_source]
    show (presheafPreRelation j).WeaklyEquivalent p
      (overTestPoint ((q ≫ P.firstInclusion 2) ≫ (P.pathRelation 0).target))
      (overTestPoint ((q ≫ P.firstInclusion 2) ≫ (P.pathRelation 0).source))
    rw [ht, hs]
    exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ (rel_presheafPreRelation j q))

/-- Over a field-valued point, the two endpoints of a path of any length are weakly
equivalent: a path is a composable chain of one-step arrows. -/
private theorem weaklyEquivalent_path (p : FieldValuedPoint site S hS B.obj) (n : ℕ)
    (r : representableOver (B := B) p.siteObject (yonedaEquiv.symm p.value) ⟶ P.path n) :
    (presheafPreRelation j).WeaklyEquivalent p
      (overTestPoint (r ≫ (P.pathRelation n).target))
      (overTestPoint (r ≫ (P.pathRelation n).source)) := by
  induction n with
  | zero => exact weaklyEquivalent_oneStep P p r
  | succ n ih =>
      have ht : r ≫ (P.pathRelation (n + 1)).target =
          (r ≫ P.firstArrow n) ≫ (P.pathRelation 0).target := by
        rw [P.pathRelation_succ_target, Category.assoc]
      have hs : r ≫ (P.pathRelation (n + 1)).source =
          (r ≫ P.remainingPath n) ≫ (P.pathRelation n).source := by
        rw [P.pathRelation_succ_source, Category.assoc]
      have hmid : (r ≫ P.firstArrow n) ≫ (P.pathRelation 0).source =
          (r ≫ P.remainingPath n) ≫ (P.pathRelation n).target := by
        simpa only [Category.assoc] using
          congrArg (fun g => r ≫ g) (P.successorIsPullback n).w
      rw [ht, hs]
      refine Relation.EqvGen.trans _ _ _ ?_ (ih (r ≫ P.remainingPath n))
      rw [← hmid]
      exact weaklyEquivalent_oneStep P p (r ≫ P.firstArrow n)

/-- Over a field-valued point, an arrow of the generated relation exhibits a weak equivalence
for the original pre-relation. -/
theorem weaklyEquivalent_of_rel_allPathsRelation (p : FieldValuedPoint site S hS B.obj)
    {x y : TestPoint p.siteObject (yonedaEquiv.symm p.value) ((overForgetSpace B).obj U)}
    (h : (presheafPreRelation P.allPathsRelation).Rel (yonedaEquiv.symm p.value) x y) :
    (presheafPreRelation j).WeaklyEquivalent p x y := by
  rw [rel_presheafPreRelation_iff] at h
  obtain ⟨r, rfl, rfl⟩ := h
  obtain ⟨n, q, hq⟩ := exists_factorisation_of_fieldValuedPoint p P.path P.allPaths
    P.pathInclusion r (Classical.choice (allPaths_pullback_coproduct P r))
  have ht : q ≫ (P.pathRelation n).target = r ≫ P.allPathsRelation.target := by
    rw [← P.pathInclusion_target n, ← Category.assoc, hq]
  have hs : q ≫ (P.pathRelation n).source = r ≫ P.allPathsRelation.source := by
    rw [← P.pathInclusion_source n, ← Category.assoc, hq]
  rw [← ht, ← hs]
  exact weaklyEquivalent_path P p n q

/-- Over a field-valued point of `B`, two points of `U` are weakly equivalent for the relation
generated by a pre-relation exactly when they are weakly equivalent for the pre-relation
itself. -/
theorem weaklyEquivalent_allPathsRelation_iff (p : FieldValuedPoint site S hS B.obj)
    (x y : TestPoint p.siteObject (yonedaEquiv.symm p.value) ((overForgetSpace B).obj U)) :
    (presheafPreRelation P.allPathsRelation).WeaklyEquivalent p x y ↔
      (presheafPreRelation j).WeaklyEquivalent p x y :=
  ⟨fun h => Setoid.eqvGen_le
      (s := Relation.EqvGen.setoid ((presheafPreRelation j).Rel (yonedaEquiv.symm p.value)))
      (fun _ _ hab => weaklyEquivalent_of_rel_allPathsRelation P p hab) h,
    fun h => Relation.EqvGen.mono (fun _ _ hab => rel_allPathsRelation_of_rel P hab) x y h⟩

/-- **Stacks 048T, part (3).** The weak orbit of a point of `U` at a geometric point of `B` is
unchanged when the pre-relation is replaced by the relation of all finite paths it
generates. -/
@[stacks 048T "part (3): weak orbits are unchanged"]
theorem weakOrbit_allPathsRelation (p : GeometricPoint site S hS B.obj)
    (x : TestPoint p.val.siteObject (yonedaEquiv.symm p.val.value) ((overForgetSpace B).obj U)) :
    (presheafPreRelation P.allPathsRelation).weakOrbit p x =
      (presheafPreRelation j).weakOrbit p x :=
  Set.ext fun y => weaklyEquivalent_allPathsRelation_iff P p.val x y

/-- Over a field-valued point of `B`, two points of `U` are equivalent for the relation
generated by a pre-relation exactly when they are equivalent for the pre-relation itself:
weak equivalence agrees over the extension field appearing in either statement. -/
theorem equivalent_allPathsRelation_iff (p : FieldValuedPoint site S hS B.obj)
    (x y : TestPoint p.siteObject (yonedaEquiv.symm p.value) ((overForgetSpace B).obj U)) :
    (presheafPreRelation P.allPathsRelation).Equivalent p x y ↔
      (presheafPreRelation j).Equivalent p x y := by
  constructor
  · rintro ⟨q, f, hf, x', y', hx, hy, hw⟩
    exact ⟨q, f, hf, x', y', hx, hy,
      (weaklyEquivalent_allPathsRelation_iff P q x' y').1 hw⟩
  · rintro ⟨q, f, hf, x', y', hx, hy, hw⟩
    exact ⟨q, f, hf, x', y', hx, hy,
      (weaklyEquivalent_allPathsRelation_iff P q x' y').2 hw⟩

/-- **Stacks 048T, part (4).** The orbit of a point of `U` at a geometric point of `B` is
unchanged when the pre-relation is replaced by the relation of all finite paths it
generates. -/
@[stacks 048T "part (4): orbits are unchanged"]
theorem orbit_allPathsRelation (p : GeometricPoint site S hS B.obj)
    (x : TestPoint p.val.siteObject (yonedaEquiv.symm p.val.value) ((overForgetSpace B).obj U)) :
    (presheafPreRelation P.allPathsRelation).orbit p x =
      (presheafPreRelation j).orbit p x :=
  Set.ext fun y => equivalent_allPathsRelation_iff P p.val x y

end AlgebraicGeometry.Space

end
