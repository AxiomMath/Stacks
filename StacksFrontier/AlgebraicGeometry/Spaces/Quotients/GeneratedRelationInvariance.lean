module

public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationEndpoints
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationPathDecomposition

/-!
# Invariance under the relation generated by a pre-relation

Let `j : R ⟶ U ×_B U` be a pre-relation of algebraic spaces over an algebraic space `B`, and
let `j_∞ : R_∞ ⟶ U ×_B U` be the relation of all finite paths generated by it. A morphism out
of `U` is invariant under `j` exactly when it is invariant under `j_∞`.

One direction is formal: the original arrows are the first summand of the one-step paths, so
invariance under all paths restricts to invariance under `j`. The other direction is the
content: a point of the space of paths of a given length is a composable list of links, each
of which is locally an original, an identity or a reversed arrow, and along such a list the
value of an invariant morphism is constant.

## Main results

* `AlgebraicGeometry.Space.isInvariant_allPathsRelation_iff`: **Stacks 048T, part (1)**,
  invariance under a pre-relation and under its generated relation agree.

## Implementation notes

The codomain of the morphism is an arbitrary algebraic space over `S`, not necessarily one
over `B`, as in `AlgebraicGeometry.Space.IsInvariant`; the statement for a morphism `φ` of
algebraic spaces over `B` is the case of its underlying morphism.

Both halves are equations between morphisms out of a coproduct — over the three kinds of
one-step arrow, and over the lengths — and in both the test is made after applying
`CategoryTheory.Over.forget`, which preserves those coproducts; that is
`AlgebraicGeometry.Space.hom_ext_of_isColimit_cofan_left`. The decomposition of a point of a
one-step path space into its three kinds, and of a point of a path space into its links, are
`AlgebraicGeometry.Space.firstPath_pullback_coproduct` and
`AlgebraicGeometry.Space.homPathEquivFinitePath`.

Invariance is an equation between morphisms rather than a condition on points, so the
induction along a list of links is an induction on its length with the links of the tail as
the inductive datum, and the gluing condition of the list is what joins consecutive steps.

## References

* [Stacks Project, Tag 048E](https://stacks.math.columbia.edu/tag/048E)
* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v u

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS}

/-- A morphism out of a coproduct of algebraic spaces over `B`, into an algebraic space that
need not lie over `B`, is determined by its restrictions to the summands: forgetting the
structure morphism to `B` preserves coproducts. -/
theorem hom_ext_of_isColimit_cofan_left {I : Type v} [Small.{u} I] [Countable I]
    {F : I → Over B} {Q : Over B}
    {ι : ∀ i, F i ⟶ Q} (hQ : IsColimit (Cofan.mk Q ι))
    {X : AlgebraicSpaces site S hS} {u v : Q.left ⟶ X}
    (h : ∀ i, (ι i).left ≫ u = (ι i).left ≫ v) : u = v :=
  (isColimitOfPreserves (Over.forget B) hQ).hom_ext fun i => h i.as

variable {R U : Over B} {j : PreRelation R U}

/-! ### Invariance along a finite path -/

section

variable {X : AlgebraicSpaces site S hS}

private theorem oneStep_invariant (P : PathConstruction j) (φ : U.left ⟶ X)
    (hφ : IsInvariant j φ) (i : Fin 3) :
    (P.firstInclusion i ≫ (P.pathRelation 0).target).left ≫ φ =
      (P.firstInclusion i ≫ (P.pathRelation 0).source).left ≫ φ := by
  fin_cases i
  · show (P.firstInclusion 0 ≫ (P.pathRelation 0).target).left ≫ φ =
      (P.firstInclusion 0 ≫ (P.pathRelation 0).source).left ≫ φ
    rw [P.firstInclusion_zero_target, P.firstInclusion_zero_source]
    exact hφ
  · show (P.firstInclusion 1 ≫ (P.pathRelation 0).target).left ≫ φ =
      (P.firstInclusion 1 ≫ (P.pathRelation 0).source).left ≫ φ
    rw [P.firstInclusion_one_target, P.firstInclusion_one_source]
  · show (P.firstInclusion 2 ≫ (P.pathRelation 0).target).left ≫ φ =
      (P.firstInclusion 2 ≫ (P.pathRelation 0).source).left ≫ φ
    rw [P.firstInclusion_two_target, P.firstInclusion_two_source]
    exact hφ.symm

private theorem link_invariant (P : PathConstruction j) (φ : U.left ⟶ X)
    (hφ : IsInvariant j φ) {T : Over B} (f : T ⟶ P.path 0) :
    (f ≫ (P.pathRelation 0).target).left ≫ φ =
      (f ≫ (P.pathRelation 0).source).left ≫ φ := by
  obtain ⟨hc⟩ := firstPath_pullback_coproduct P f
  refine hom_ext_of_isColimit_cofan_left hc fun i => ?_
  have hpb : (pullback.fst f (P.firstInclusion i)).left ≫ f.left =
      (pullback.snd f (P.firstInclusion i)).left ≫ (P.firstInclusion i).left :=
    congrArg (fun g : pullback f (P.firstInclusion i) ⟶ P.path 0 => g.left)
      pullback.condition
  calc
    (pullback.fst f (P.firstInclusion i)).left ≫
        (f ≫ (P.pathRelation 0).target).left ≫ φ =
        ((pullback.fst f (P.firstInclusion i)).left ≫ f.left) ≫
          (P.pathRelation 0).target.left ≫ φ := by
      simp only [Over.comp_left, Category.assoc]
    _ = (pullback.snd f (P.firstInclusion i)).left ≫
        (P.firstInclusion i ≫ (P.pathRelation 0).target).left ≫ φ := by
      rw [hpb]
      simp only [Over.comp_left, Category.assoc]
    _ = (pullback.snd f (P.firstInclusion i)).left ≫
        (P.firstInclusion i ≫ (P.pathRelation 0).source).left ≫ φ :=
      congrArg _ (oneStep_invariant P φ hφ i)
    _ = ((pullback.fst f (P.firstInclusion i)).left ≫ f.left) ≫
        (P.pathRelation 0).source.left ≫ φ := by
      rw [hpb]
      simp only [Over.comp_left, Category.assoc]
    _ = _ := by simp only [Over.comp_left, Category.assoc]

private theorem finitePath_invariant (P : PathConstruction j) (φ : U.left ⟶ X) {T : Over B}
    (n : ℕ) (p : FinitePath P T n)
    (hlink : ∀ i, (p.link i ≫ (P.pathRelation 0).target).left ≫ φ =
      (p.link i ≫ (P.pathRelation 0).source).left ≫ φ) :
    (p.link 0 ≫ (P.pathRelation 0).target).left ≫ φ =
      (p.link (Fin.last n) ≫ (P.pathRelation 0).source).left ≫ φ := by
  induction n with
  | zero => simpa using hlink 0
  | succ n ih =>
      let tail : FinitePath P T n :=
        { link := fun i => p.link i.succ
          composable := fun i => p.composable i.succ }
      have htail := ih tail fun i => hlink i.succ
      have hglue := congrArg (fun g : T ⟶ U => g.left ≫ φ) (p.composable 0)
      have hlast : Fin.last (n + 1) = Fin.succ (Fin.last n) := Fin.ext rfl
      simpa only [tail, hlast] using (hlink 0).trans (hglue.trans htail)

private theorem path_invariant (P : PathConstruction j) (φ : U.left ⟶ X)
    (hφ : IsInvariant j φ) (n : ℕ) {T : Over B} (f : T ⟶ P.path n) :
    (f ≫ (P.pathRelation n).target).left ≫ φ =
      (f ≫ (P.pathRelation n).source).left ≫ φ := by
  rw [finitePath_target P n f, finitePath_source P n f]
  refine finitePath_invariant P φ n _ fun i => ?_
  rw [homPathEquivFinitePath_link]
  exact link_invariant P φ hφ (pathLink P n f i)

private theorem pathRelation_invariant (P : PathConstruction j) (φ : U.left ⟶ X)
    (hφ : IsInvariant j φ) (n : ℕ) :
    (P.pathRelation n).target.left ≫ φ = (P.pathRelation n).source.left ≫ φ := by
  simpa using path_invariant P φ hφ n (𝟙 (P.path n))

/-- **Stacks 048T, part (1).** A morphism out of `U` is invariant under a pre-relation exactly
when it is invariant under the relation of all finite paths that the pre-relation generates.

The codomain is an arbitrary algebraic space over `S`; for a morphism `φ` of algebraic spaces
over `B` take `φ.left`. -/
@[stacks 048T "part (1): invariance under the generated relation"]
theorem isInvariant_allPathsRelation_iff (P : PathConstruction j) (φ : U.left ⟶ X) :
    IsInvariant P.allPathsRelation φ ↔ IsInvariant j φ := by
  refine ⟨fun hφ => ?_, fun hφ => ?_⟩
  · have ht' : (P.firstInclusion 0 ≫ P.pathInclusion 0).left ≫
        P.allPathsRelation.target.left = j.target.left :=
      congrArg (fun g : R ⟶ U => g.left) P.originalArrow_target
    have hs' : (P.firstInclusion 0 ≫ P.pathInclusion 0).left ≫
        P.allPathsRelation.source.left = j.source.left :=
      congrArg (fun g : R ⟶ U => g.left) P.originalArrow_source
    have h := congrArg (fun g : P.allPaths.left ⟶ X =>
      (P.firstInclusion 0 ≫ P.pathInclusion 0).left ≫ g) hφ
    rw [← Category.assoc, ← Category.assoc, ht', hs'] at h
    exact h
  · refine hom_ext_of_isColimit_cofan_left P.allPathsIsCoproduct fun n => ?_
    have h := pathRelation_invariant P φ hφ n
    rw [← P.pathInclusion_target n, ← P.pathInclusion_source n] at h
    simpa only [Over.comp_left, Category.assoc] using h

end

end AlgebraicGeometry.Space

end
