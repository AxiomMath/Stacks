module

public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationPaths
public import StacksFrontier.CategoryTheory.Sites.SemiRepresentable.Sheaves

/-!
# Arrows of a generated relation are finite paths

A point of the relation generated by a pre-relation of algebraic spaces is, locally, a finite
composable path whose links are locally original, identity or reversed arrows. Conversely a
finite composable list of links is a point of the path space of the corresponding length, with
the expected outer endpoints.

"Locally" is made precise by the two decomposition statements: the coproducts of the path
construction are *universal* colimits, so pulling their inclusions back along any morphism
from a test space decomposes that test space into canonical pieces, one for each length and —
on each length — one for each of the three kinds of one-step arrow.

## Main definitions

* `AlgebraicGeometry.Space.FinitePath` is a finite composable list of one-step arrows.
* `AlgebraicGeometry.Space.pathLink` extracts the links of a point of a path space.
* `AlgebraicGeometry.Space.homPathEquivFinitePath` identifies points of the path space of
  length `n + 1` with composable lists of `n + 1` links.

## Main results

* `CategoryTheory.Limits.IsUniversalColimit.isColimit_cofan_pullback`: the pullbacks of the
  legs of a universal colimit cofan along a morphism to its vertex form again a colimit cofan.
* `AlgebraicGeometry.Space.isUniversalColimit_cofan_over`: a countable coproduct of algebraic
  spaces over an algebraic space is a universal colimit.
* `AlgebraicGeometry.Space.allPaths_pullback_coproduct` and
  `AlgebraicGeometry.Space.firstPath_pullback_coproduct`: the two decompositions.
* `AlgebraicGeometry.Space.finitePath_target` and
  `AlgebraicGeometry.Space.finitePath_source`, with their converses
  `AlgebraicGeometry.Space.finitePath_to_hom_target` and
  `AlgebraicGeometry.Space.finitePath_to_hom_source`: the outer endpoints of a finite path are
  the target of its first link and the source of its last.

## Implementation notes

That the coproducts are universal is transported from the corresponding statement about
coproducts of sheaves of sets, which is
`CategoryTheory.SemiRepresentable.isVanKampenColimit_sheafCoproduct`, along
`AlgebraicGeometry.algebraicSpacesToSheaf`. That functor is fully faithful, preserves
fibre products and creates countable coproducts, which are exactly the hypotheses of
`CategoryTheory.Limits.IsUniversalColimit.of_mapCocone`; nothing about universal colimits of
types, of presheaves or of sheaves is re-derived here.

The path of length `n + 1` carries the index `n`, and the links are ordered along the
orientation of the fibre products of the path construction: the source of each link is the
target of the next. The inverse of `AlgebraicGeometry.Space.homPathEquivFinitePath` is built by
recursion on the length, lifting through the fibre product of the path construction and
carrying the two endpoint equations along as part of the recursive datum, which is what makes
the gluing condition available at each step.

## References

* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w₁ w v u

namespace CategoryTheory.Limits

/-- Pulling the legs of a universal colimit cofan back along a morphism to its vertex gives
again a colimit cofan: the pullback squares exhibit the source of that morphism as glued from
the pieces lying over the summands. -/
theorem IsUniversalColimit.isColimit_cofan_pullback {C : Type w} [Category.{w₁} C]
    [HasPullbacks C] {I : Type v} {X : I → C} {c : Cofan X} (hc : IsUniversalColimit c)
    {T : C} (f : T ⟶ c.pt) :
    Nonempty (IsColimit (Cofan.mk T (fun i => pullback.fst f (c.inj i)))) := by
  refine hc (Cofan.mk T (fun i => pullback.fst f (c.inj i)))
    (Discrete.natTrans (fun i => pullback.snd f (c.inj i.as))) f ?_
    (.of_discrete _) (fun i => IsPullback.of_hasPullback f (c.inj i.as))
  ext i
  exact (pullback.condition (f := f) (g := c.inj i.as)).symm

end CategoryTheory.Limits

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS}

/-- A countable coproduct of algebraic spaces over an algebraic space `B` is a universal
colimit: it is so after passing to the underlying sheaves of sets, and the inclusion of the
algebraic spaces into the sheaves preserves fibre products and reflects countable
coproducts. -/
theorem isUniversalColimit_cofan_over {I : Type v} [Small.{u} I] [Countable I]
    (X : I → Over B) (c : Cofan X) (hc : IsColimit c) : IsUniversalColimit c := by
  let K := Over.forget B ⋙ algebraicSpacesToSheaf site S hS
  refine IsUniversalColimit.of_mapCocone K ?_
  let e : Discrete.functor (fun i => K.obj (X i)) ≅ Discrete.functor X ⋙ K :=
    (Discrete.natIsoFunctor (F := Discrete.functor X ⋙ K)).symm
  have hu : IsUniversalColimit ((Cocone.precompose e.inv).obj
      (Sigma.cocone (Discrete.functor (fun i => K.obj (X i))))) :=
    (IsVanKampenColimit.precompose_isIso e.inv
      (SemiRepresentable.isVanKampenColimit_sheafCoproduct _
        (fun i => K.obj (X i)))).isUniversal
  exact hu.of_iso (Cocone.ext
    (hu.isColimit.coconePointUniqueUpToIso (isColimitOfPreserves K hc)) fun i =>
      hu.isColimit.comp_coconePointUniqueUpToIso_hom (isColimitOfPreserves K hc) i)

variable {R U : Over B} {j : PreRelation R U}

/-- A composable path of `n + 1` links in the one-step relation generated by a
pre-relation. -/
structure FinitePath (P : PathConstruction j) (T : Over B) (n : ℕ) where
  /-- The `i`-th link of the path, a point of the one-step relation. -/
  link : Fin (n + 1) → (T ⟶ P.path 0)
  /-- Consecutive links are composable: the source of one is the target of the next. -/
  composable : ∀ i : Fin n,
    link i.castSucc ≫ (P.pathRelation 0).source =
      link i.succ ≫ (P.pathRelation 0).target

/-- The links of a point of the path space of a given length, read off by iterating the first
and remaining projections of the path construction. -/
def pathLink (P : PathConstruction j) {T : Over B} :
    (n : ℕ) → (T ⟶ P.path n) → Fin (n + 1) → (T ⟶ P.path 0)
  | 0, f, _ => f
  | n + 1, f, i =>
      Fin.cases (f ≫ P.firstArrow n)
        (fun k => pathLink P n (f ≫ P.remainingPath n) k) i

/-- The target of a point of a path space is the target of its first link. -/
theorem pathLink_target (P : PathConstruction j) {T : Over B}
    (n : ℕ) (f : T ⟶ P.path n) :
    f ≫ (P.pathRelation n).target =
      pathLink P n f 0 ≫ (P.pathRelation 0).target := by
  induction n with
  | zero => rfl
  | succ n _ =>
    rw [P.successorEndpoints]
    simp [PreRelation.target, pathLink, Category.assoc]

/-- The source of a point of a path space is the source of its last link. -/
theorem pathLink_source (P : PathConstruction j) {T : Over B}
    (n : ℕ) (f : T ⟶ P.path n) :
    f ≫ (P.pathRelation n).source =
      pathLink P n f (Fin.last n) ≫ (P.pathRelation 0).source := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [P.successorEndpoints]
    simp only [PreRelation.source, prod.lift_snd]
    rw [show Fin.last (n + 1) = (Fin.last n).succ from Fin.ext rfl]
    simp only [pathLink, Fin.cases_succ]
    exact ih (f ≫ P.remainingPath n)

/-- Two finite paths with the same links are equal. -/
theorem FinitePath.ext {P : PathConstruction j} {T : Over B} {n : ℕ}
    {p q : FinitePath P T n} (h : ∀ i, p.link i = q.link i) : p = q := by
  obtain ⟨pl, _⟩ := p
  obtain ⟨ql, _⟩ := q
  obtain rfl : pl = ql := funext h
  rfl

/-- A point of the path space of length `n + 1` is exactly a composable path of `n + 1`
links. -/
noncomputable def homPathEquivFinitePath (P : PathConstruction j) (T : Over B) (n : ℕ) :
    (T ⟶ P.path n) ≃ FinitePath P T n := by
  classical
  let buildData : (m : ℕ) → (p : FinitePath P T m) →
      {f : T ⟶ P.path m //
        f ≫ (P.pathRelation m).target = p.link 0 ≫ (P.pathRelation 0).target ∧
        f ≫ (P.pathRelation m).source =
          p.link (Fin.last m) ≫ (P.pathRelation 0).source} :=
    fun m => Nat.rec
      (motive := fun m => (p : FinitePath P T m) →
        {f : T ⟶ P.path m //
          f ≫ (P.pathRelation m).target = p.link 0 ≫ (P.pathRelation 0).target ∧
          f ≫ (P.pathRelation m).source =
            p.link (Fin.last m) ≫ (P.pathRelation 0).source})
      (fun p => ⟨p.link 0, rfl, rfl⟩)
      (fun m ih p => by
        let q : FinitePath P T m :=
          { link := fun i => p.link i.succ
            composable := fun i => p.composable i.succ }
        let tq := ih q
        have hcomp : p.link 0 ≫ (P.pathRelation 0).source =
            tq.1 ≫ (P.pathRelation m).target := by
          calc
            p.link 0 ≫ (P.pathRelation 0).source =
                p.link (0 : Fin (m + 1 + 1)) ≫ (P.pathRelation 0).source := rfl
            _ = p.link (Fin.succ 0) ≫ (P.pathRelation 0).target := p.composable 0
            _ = q.link 0 ≫ (P.pathRelation 0).target := rfl
            _ = tq.1 ≫ (P.pathRelation m).target := tq.2.1.symm
        let g := (P.successorIsPullback m).lift (p.link 0) tq.1 hcomp
        refine ⟨g, ?_, ?_⟩
        · rw [P.successorEndpoints]
          simp [g]
        · rw [P.successorEndpoints]
          have hlast : Fin.last (m + 1) = Fin.succ (Fin.last m) := Fin.ext rfl
          rw [hlast]
          simp [g, q, tq.2.2])
      m
  exact
    { toFun := fun f => ⟨pathLink P n f, by
        have hc : ∀ m (g : T ⟶ P.path m), ∀ i : Fin m,
            pathLink P m g i.castSucc ≫ (P.pathRelation 0).source =
              pathLink P m g i.succ ≫ (P.pathRelation 0).target := by
          intro m
          induction m with
          | zero => intro _ i; exact Fin.elim0 i
          | succ m ih =>
              intro g i
              refine Fin.cases ?_ (fun i => ?_) i
              · calc
                  pathLink P (m + 1) g 0 ≫ (P.pathRelation 0).source =
                      (g ≫ P.firstArrow m) ≫ (P.pathRelation 0).source := by
                    simp [pathLink]
                  _ = (g ≫ P.remainingPath m) ≫ (P.pathRelation m).target := by
                    simpa [Category.assoc] using
                      congrArg (fun h => g ≫ h) (P.successorIsPullback m).w
                  _ = pathLink P m (g ≫ P.remainingPath m) 0 ≫
                      (P.pathRelation 0).target := pathLink_target P m _
              · simpa [pathLink] using ih (g ≫ P.remainingPath m) i
        exact hc n f⟩
      invFun := fun p => (buildData n p).1
      left_inv := by
        intro f
        induction n with
        | zero => rfl
        | succ n ih =>
            apply (P.successorIsPullback n).hom_ext
            · simp [buildData, pathLink]
            · dsimp [buildData]
              rw [(P.successorIsPullback n).lift_snd]
              exact ih (f ≫ P.remainingPath n)
      right_inv := by
        intro p
        induction n with
        | zero =>
            refine FinitePath.ext fun i => ?_
            fin_cases i
            rfl
        | succ n ih =>
            refine FinitePath.ext fun i => ?_
            refine Fin.cases ?_ (fun i => ?_) i
            · simp [buildData, pathLink]
            · let q : FinitePath P T n :=
                { link := fun k => p.link k.succ
                  composable := fun k => p.composable k.succ }
              have hlink := congrArg (fun r : FinitePath P T n => r.link i) (ih q)
              simpa [buildData, pathLink, q] using hlink }

/-- The equivalence of points of a path space with finite paths records exactly the links read
off by the iterated projections. -/
theorem homPathEquivFinitePath_link (P : PathConstruction j) {T : Over B}
    (n : ℕ) (f : T ⟶ P.path n) (i : Fin (n + 1)) :
    (homPathEquivFinitePath P T n f).link i = pathLink P n f i := rfl

/-- Pulling the inclusions of the finite-length path spaces back along a point of the
generated relation decomposes its source into the pieces of each length. -/
theorem allPaths_pullback_coproduct (P : PathConstruction j) {T : Over B}
    (f : T ⟶ P.allPaths) :
    Nonempty (IsColimit (Cofan.mk T
      (fun n : ℕ => pullback.fst f (P.pathInclusion n)))) :=
  IsUniversalColimit.isColimit_cofan_pullback
    (isUniversalColimit_cofan_over P.path _ P.allPathsIsCoproduct) f

/-- Pulling the inclusions of the one-step coproduct back along a link decomposes its source
into the original, identity and reversed pieces. -/
theorem firstPath_pullback_coproduct (P : PathConstruction j) {T : Over B}
    (f : T ⟶ P.path 0) :
    Nonempty (IsColimit (Cofan.mk T
      (fun i : Fin 3 => pullback.fst f (P.firstInclusion i)))) :=
  IsUniversalColimit.isColimit_cofan_pullback
    (isUniversalColimit_cofan_over (pathComponent R U) _ P.firstIsCoproduct) f

/-- The target of a finite path is the target of its first link. -/
theorem finitePath_target (P : PathConstruction j) {T : Over B}
    (n : ℕ) (f : T ⟶ P.path n) :
    f ≫ (P.pathRelation n).target =
      (homPathEquivFinitePath P T n f).link 0 ≫ (P.pathRelation 0).target := by
  rw [homPathEquivFinitePath_link]
  exact pathLink_target P n f

/-- The source of a finite path is the source of its last link. -/
theorem finitePath_source (P : PathConstruction j) {T : Over B}
    (n : ℕ) (f : T ⟶ P.path n) :
    f ≫ (P.pathRelation n).source =
      (homPathEquivFinitePath P T n f).link (Fin.last n) ≫ (P.pathRelation 0).source := by
  rw [homPathEquivFinitePath_link]
  exact pathLink_source P n f

/-- Assembling a composable list of links into a point of the path space preserves the target
endpoint. -/
theorem finitePath_to_hom_target (P : PathConstruction j) {T : Over B}
    (n : ℕ) (p : FinitePath P T n) :
    (homPathEquivFinitePath P T n).symm p ≫ (P.pathRelation n).target =
      p.link 0 ≫ (P.pathRelation 0).target := by
  rw [finitePath_target]
  simp

/-- Assembling a composable list of links into a point of the path space preserves the source
endpoint. -/
theorem finitePath_to_hom_source (P : PathConstruction j) {T : Over B}
    (n : ℕ) (p : FinitePath P T n) :
    (homPathEquivFinitePath P T n).symm p ≫ (P.pathRelation n).source =
      p.link (Fin.last n) ≫ (P.pathRelation 0).source := by
  rw [finitePath_source]
  simp

end AlgebraicGeometry.Space

end
