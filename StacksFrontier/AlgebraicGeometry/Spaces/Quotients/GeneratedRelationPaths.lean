module

public import StacksFrontier.AlgebraicGeometry.Spaces.CoproductCountable
public import StacksFrontier.AlgebraicGeometry.Spaces.InvariantMorphisms

/-!
# Paths generated by a pre-relation

Let `j : R ⟶ U ×_B U` be a pre-relation of algebraic spaces over an algebraic space `B`.
Adjoining the identity arrows and the reversed arrows to `j` gives the *one-step* relation,
the coproduct of the three summands `R`, `U`, `R` with the original, diagonal and flipped
endpoint maps of Tag 048S. Repeatedly forming the fibre product along "the source of one
arrow is the target of the next" gives the space of composable paths of each positive length,
and the coproduct of all of these is the *path relation* generated by `j`.

## Main definitions

* `AlgebraicGeometry.Space.pathComponent` is the family `R, U, R` of one-step summands.
* `AlgebraicGeometry.Space.pathEndpoint` is the endpoint map on each one-step summand.
* `AlgebraicGeometry.Space.PathConstruction` packages the one-step coproduct, the iterated
  fibre products, and the coproduct of all positive-length paths, together with their
  endpoint maps and universal properties.
* `AlgebraicGeometry.Space.pathConstruction` supplies this data for every pre-relation.

## Implementation notes

The path of length `n + 1` carries the index `n`. Coproducts and fibre products are recorded
by their universal properties rather than by a choice of colimit object, so the construction
is canonical up to unique isomorphism and imposes no choices on its consumers.

The two coproducts needed are indexed by `Fin 3` and by `ℕ`. Both are countable and `u`-small,
so both exist in the slice of the algebraic spaces over `B` by
`AlgebraicGeometry.Space.hasColimitsOfShape_discrete_over`; concretely the coproduct is taken
on underlying sheaves and is an algebraic space by Stacks 02WQ. The fibre products exist
because the algebraic spaces over `S` have them, Tag 043C.

The defining equations make the original, diagonal and flipped arrows the three one-step
components, and make the endpoints of a longer path the outer endpoints of its links; the
orientation is that the source of each link is the target of the next.

## References

* [Stacks Project, Tag 043C](https://stacks.math.columbia.edu/tag/043C)
* [Stacks Project, Tag 048S](https://stacks.math.columbia.edu/tag/048S)
* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS}

/-- The three summands of the one-step path space of a pre-relation `R ⟶ U ×_B U`, in the
order `R, U, R`: the original arrows, the identity arrows, and the reversed arrows. -/
abbrev pathComponent (R U : Over B) (i : Fin 3) : Over B :=
  if i = 1 then U else R

/-- The endpoint map on the `i`-th one-step summand of a pre-relation: the pre-relation
itself, the diagonal of `U`, and the flipped pre-relation of Tag 048S. -/
noncomputable def pathEndpoint {R U : Over B} (j : PreRelation R U) (i : Fin 3) :
    pathComponent R U i ⟶ U ⨯ U :=
  match i with
  | 0 => j
  | 1 => diag U
  | 2 => flippedRelation j

/-- The system of all positive-length paths generated by a pre-relation `j : R ⟶ U ×_B U`,
with their endpoint maps and the coproduct and fibre-product universal properties that
characterise them. -/
structure PathConstruction {R U : Over B} (j : PreRelation R U) where
  /-- `path n` is the space of composable paths of length `n + 1`. -/
  path : ℕ → Over B
  /-- The inclusions of the original, identity and reversed arrows into the one-step space. -/
  firstInclusion : (i : Fin 3) → pathComponent R U i ⟶ path 0
  /-- The one-step space is the coproduct of the three summands. -/
  firstIsCoproduct : IsColimit (Cofan.mk (path 0) firstInclusion)
  /-- The endpoint map of the space of paths of each positive length. -/
  pathRelation : (n : ℕ) → PreRelation (path n) U
  /-- On the original summand the endpoint map is the given pre-relation. -/
  originalEndpoints : firstInclusion 0 ≫ pathRelation 0 = j
  /-- On the identity summand the endpoint map is the diagonal. -/
  identityEndpoints : firstInclusion 1 ≫ pathRelation 0 = diag U
  /-- On the reversed summand the endpoint map is the flipped pre-relation. -/
  reversedEndpoints : firstInclusion 2 ≫ pathRelation 0 = flippedRelation j
  /-- The first link of a path of length at least two. -/
  firstArrow : (n : ℕ) → path (n + 1) ⟶ path 0
  /-- The path that remains after the first link. -/
  remainingPath : (n : ℕ) → path (n + 1) ⟶ path n
  /-- A path of length `n + 2` is a first link together with a path of length `n + 1`, glued
  where the source of the former is the target of the latter. -/
  successorIsPullback : (n : ℕ) →
    IsPullback (firstArrow n) (remainingPath n)
      (pathRelation 0).source (pathRelation n).target
  /-- The endpoints of a longer path are the outer endpoints of its two pieces. -/
  successorEndpoints : (n : ℕ) →
    pathRelation (n + 1) =
      prod.lift (firstArrow n ≫ (pathRelation 0).target)
        (remainingPath n ≫ (pathRelation n).source)
  /-- The disjoint union of the spaces of paths of all positive lengths. -/
  allPaths : Over B
  /-- The inclusion of the paths of one length into the disjoint union. -/
  pathInclusion : (n : ℕ) → path n ⟶ allPaths
  /-- The disjoint union is the coproduct of the spaces of paths of each length. -/
  allPathsIsCoproduct : IsColimit (Cofan.mk allPaths pathInclusion)
  /-- The endpoint map of the generated path relation. -/
  allPathsRelation : PreRelation allPaths U
  /-- It restricts on each length to the endpoint map of that length. -/
  allPathsEndpoints : (n : ℕ) →
    pathInclusion n ≫ allPathsRelation = pathRelation n

/-- The path relation generated by a pre-relation of algebraic spaces over `B`. -/
noncomputable def pathConstruction {R U : Over B} (j : PreRelation R U) :
    PathConstruction j := by
  classical
  -- The one-step space: the coproduct of the three summands `R`, `U`, `R`.
  let firstInclusion : (i : Fin 3) → pathComponent R U i ⟶ ∐ pathComponent R U :=
    Sigma.ι (pathComponent R U)
  have hFirst : IsColimit (Cofan.mk (∐ pathComponent R U) firstInclusion) :=
    coproductIsCoproduct (pathComponent R U)
  let rel0 : (∐ pathComponent R U) ⟶ U ⨯ U :=
    hFirst.desc (Cofan.mk (U ⨯ U) (pathEndpoint j))
  have hrel0 : ∀ i : Fin 3, firstInclusion i ≫ rel0 = pathEndpoint j i :=
    fun i => hFirst.fac (Cofan.mk (U ⨯ U) (pathEndpoint j)) (Discrete.mk i)
  -- The spaces of longer paths: iterated fibre products along source-meets-target.
  let step : (Σ' X : Over B, X ⟶ U ⨯ U) → (Σ' X : Over B, X ⟶ U ⨯ U) := fun d =>
    ⟨pullback (rel0 ≫ prod.snd) (d.2 ≫ prod.fst),
      prod.lift (pullback.fst _ _ ≫ rel0 ≫ prod.fst)
        (pullback.snd _ _ ≫ d.2 ≫ prod.snd)⟩
  let data : ℕ → (Σ' X : Over B, X ⟶ U ⨯ U) := fun n =>
    Nat.rec (motive := fun _ => (Σ' X : Over B, X ⟶ U ⨯ U))
      ⟨∐ pathComponent R U, rel0⟩ (fun _ d => step d) n
  let path : ℕ → Over B := fun n => (data n).1
  let pathRelation : (n : ℕ) → PreRelation (path n) U := fun n => (data n).2
  -- The disjoint union of all of them.
  let pathInclusion : (n : ℕ) → path n ⟶ ∐ path := Sigma.ι path
  have hAll : IsColimit (Cofan.mk (∐ path) pathInclusion) := coproductIsCoproduct path
  let allPathsRelation : (∐ path) ⟶ U ⨯ U :=
    hAll.desc (Cofan.mk (U ⨯ U) pathRelation)
  exact
    { path := path
      firstInclusion := firstInclusion
      firstIsCoproduct := hFirst
      pathRelation := pathRelation
      originalEndpoints := hrel0 0
      identityEndpoints := hrel0 1
      reversedEndpoints := hrel0 2
      firstArrow := fun n =>
        pullback.fst (rel0 ≫ prod.snd) (pathRelation n ≫ prod.fst)
      remainingPath := fun n =>
        pullback.snd (rel0 ≫ prod.snd) (pathRelation n ≫ prod.fst)
      successorIsPullback := fun _ => IsPullback.of_hasPullback _ _
      successorEndpoints := fun _ => rfl
      allPaths := ∐ path
      pathInclusion := pathInclusion
      allPathsIsCoproduct := hAll
      allPathsRelation := allPathsRelation
      allPathsEndpoints := fun n =>
        hAll.fac (Cofan.mk (U ⨯ U) pathRelation) (Discrete.mk n) }

end AlgebraicGeometry.Space

end
