/-!
# Orbit spaces and geometric-point quotients

Let `j : R ⟶ U ×_B U` be a pre-relation of algebraic spaces over an algebraic space `B` whose
relation space and whose source are locally of finite type over `B`. A morphism `φ : U ⟶ X`
invariant under `j` is an orbit space for `j` exactly when, over every algebraically closed
field-valued point of `B`, it induces a bijection from the quotient of the points of `U` by
the relation generated by `j` onto the points of `X`: every point of `X` over that point of
the base lifts, and two points of `U` have the same image precisely when a finite chain of
arrows of `j` over that same field joins them.

The finite-type hypothesis enters through the fact that over an algebraically closed field no
field extension is needed to realise an equivalence: that is **Stacks 048U** for a
pre-relation whose two endpoint maps are locally of finite type, proved here from the
surjectivity criterion of **Stacks 0487** applied to the relation generated by `j`.

## Main results

* `AlgebraicGeometry.Space.equivalent_iff_weaklyEquivalent_of_locallyOfFiniteType` is
  **Stacks 048U** in the locally finite type case.
* `AlgebraicGeometry.Space.isOrbitSpace_iff_geometricPoints_quotient_bijective` is
  **Stacks 04A0**.

## Implementation notes

Bijectivity of the induced map on the quotient is expressed elementwise — surjectivity as a
lifting statement and injectivity as an equivalence between equality of images and weak
equivalence — rather than through a quotient type, so that no quotient of the test points has
to be formed and the statement applies verbatim to each geometric point of the base.

The generated relation is `AlgebraicGeometry.Space.PathConstruction.allPathsRelation` of the
path construction of **Stacks 048T**. Since its weak orbits and its orbits agree with those of
`j`, the finite-type statement reduces to the case of a pre-equivalence relation, where an
orbit is cut out by a single arrow. An arrow over an extension of the field then descends
because the pair of points it joins is a point of `U ×_B U` over the field itself, and the
endpoint map of the generated relation is locally of finite type, hence surjective on points
valued in the algebraically closed field as soon as it is surjective on topological points.

## References

* [Stacks Project, Tag 048U](https://stacks.math.columbia.edu/tag/048U)
* [Stacks Project, Tag 04A0](https://stacks.math.columbia.edu/tag/04A0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS} {R U : Over B}

/-! ### No field extension is needed in the locally finite type case -/

/-- The presheaf represented by the object of the site of a field-valued point of `B` has a
single point: every field-valued point of it is dominated by itself and dominates the
canonical one given by the identity. -/
private theorem class_eq_class_id (p : FieldValuedPoint site S hS B.obj)
    (a : FieldValuedPoint site S hS (yoneda.obj p.siteObject)) :
    a.class site S hS (yoneda.obj p.siteObject) =
      (⟨p.carrier, p.contained, p.toBase, 𝟙 p.siteObject⟩ :
        FieldValuedPoint site S hS (yoneda.obj p.siteObject)).class site S hS
          (yoneda.obj p.siteObject) :=
  FieldValuedPoint.class_eq_class_of_hasCommonExtension site S hS _
    ⟨a, FieldValuedPoint.dominates_refl site S hS _ a, ⟨a.value, Category.comp_id a.value⟩⟩

/-- **Stacks 048U.** For a pre-relation whose source and target are locally of finite type,
two points of `U` over a geometric point of `B` are equivalent exactly when they are already
weakly equivalent over the field of that geometric point: no extension of the field is
needed. -/
@[stacks 048U "finite_type_equivalence"]
theorem equivalent_iff_weaklyEquivalent_of_locallyOfFiniteType (j : PreRelation R U)
    (hs : IsLocallyOfFiniteType site S hS j.source.left.hom)
    (ht : IsLocallyOfFiniteType site S hS j.target.left.hom)
    (p : GeometricPoint site S hS B.obj)
    (x y : TestPoint p.val.siteObject (yonedaEquiv.symm p.val.value)
      ((overForgetSpace B).obj U)) :
    (presheafPreRelation j).Equivalent p.val x y ↔
      (presheafPreRelation j).WeaklyEquivalent p.val x y := by
  classical
  refine ⟨fun hxy ↦ ?_, fun h ↦ ⟨p.val, 𝟙 _, by simp, x, y, by simp, by simp, h⟩⟩
  have halg : IsAlgClosed p.val.carrier := p.property
  obtain ⟨P⟩ : Nonempty (PathConstruction j) := ⟨pathConstruction j⟩
  have hpre := isPreEquivalenceRelation_allPathsRelation P
  have hjP : IsLocallyOfFiniteType site S hS P.allPathsRelation.left.hom :=
    isLocallyOfFiniteType_of_comp site S hS P.allPaths.left.property
      (U ⨯ U : Over B).left.property U.left.property P.allPathsRelation.left.hom
      (prod.fst : U ⨯ U ⟶ U).left.hom
      (allPathsRelation_target_locallyOfFiniteType P hs ht)
  -- The pair `(y, x)`, read as a morphism to `U ×_B U` out of a representable space.
  set pair : representableOver (B := B) p.val.siteObject (yonedaEquiv.symm p.val.value) ⟶
    U ⨯ U := prod.lift (testPointOver y) (testPointOver x)
  have hpairFst : pair ≫ (prod.fst : U ⨯ U ⟶ U) = testPointOver y := prod.lift_fst _ _
  have hpairSnd : pair ≫ (prod.snd : U ⨯ U ⟶ U) = testPointOver x := prod.lift_snd _ _
  -- An arrow of the generated relation joining the two points over some extension field.
  have horbit : y ∈ (presheafPreRelation P.allPathsRelation).orbit p x := by
    rwa [orbit_allPathsRelation P p x]
  rw [PreRelation.orbit_eq_targets_after_extension _ hpre p x] at horbit
  obtain ⟨q, f, hf, x', y', hx', hy', hrel⟩ := horbit
  obtain ⟨r, hrt, hrs⟩ := (rel_presheafPreRelation_iff P.allPathsRelation y' x').mp hrel
  have hfb : yoneda.map f ≫ yonedaEquiv.symm p.val.value = yonedaEquiv.symm q.value := by
    rw [yonedaEquiv_symm_naturality_left]
    exact congrArg yonedaEquiv.symm hf
  set fOver : representableOver (B := B) q.siteObject (yonedaEquiv.symm q.value) ⟶
    representableOver (B := B) p.val.siteObject (yonedaEquiv.symm p.val.value) :=
    testPointOver ⟨yoneda.map f, hfb⟩
  have hpairq : r ≫ P.allPathsRelation = fOver ≫ pair := by
    refine prod.hom_ext ?_ ?_
    · simp only [Category.assoc, hpairFst]
      refine Over.OverMorphism.ext (ObjectProperty.hom_ext _ ?_)
      show (r ≫ P.allPathsRelation.target).left.hom = yoneda.map f ≫ y.1
      rw [← hy', ← hrt]
      rfl
    · simp only [Category.assoc, hpairSnd]
      refine Over.OverMorphism.ext (ObjectProperty.hom_ext _ ?_)
      show (r ≫ P.allPathsRelation.source).left.hom = yoneda.map f ≫ x.1
      rw [← hx', ← hrs]
      rfl
  have hrj : r.left.hom ≫ P.allPathsRelation.left.hom = yoneda.map f ≫ pair.left.hom :=
    congrArg (fun m : representableOver (B := B) q.siteObject (yonedaEquiv.symm q.value) ⟶
      U ⨯ U ↦ m.left.hom) hpairq
  -- Hence the image of the pair on points lies in the image of the generated relation.
  have hrange : Set.range (pointsMap site S hS
      (representableOver (B := B) p.val.siteObject
        (yonedaEquiv.symm p.val.value)).left.obj pair.left.hom) ⊆
      Set.range (pointsMap site S hS P.allPaths.left.obj P.allPathsRelation.left.hom) := by
    rintro - ⟨a, rfl⟩
    obtain ⟨a₀, rfl⟩ := Quot.exists_rep a
    refine ⟨(⟨q.carrier, q.contained, q.toBase, yonedaEquiv r.left.hom⟩ :
      FieldValuedPoint site S hS P.allPaths.left.obj).class site S hS P.allPaths.left.obj, ?_⟩
    refine (pointsMap_class site S hS P.allPaths.left.obj P.allPathsRelation.left.hom _).trans ?_
    refine Eq.trans ?_
      (congrArg (pointsMap site S hS (yoneda.obj p.val.siteObject) pair.left.hom)
        (class_eq_class_id p.val a₀)).symm
    refine Eq.trans ?_ (pointsMap_class site S hS (yoneda.obj p.val.siteObject) pair.left.hom
      ⟨p.val.carrier, p.val.contained, p.val.toBase, 𝟙 p.val.siteObject⟩).symm
    exact FieldValuedPoint.class_eq_class_of_hasCommonExtension site S hS _
      ⟨_, FieldValuedPoint.dominates_refl site S hS _ _,
        ⟨f, (yonedaEquiv_naturality pair.left.hom f).trans (congrArg yonedaEquiv hrj.symm)⟩⟩
  -- The arrow therefore already exists over the field of the geometric point.
  obtain ⟨w, hw⟩ := exists_lift_of_lft_of_range_subset P.allPathsRelation pair hjP hrange
    p.val.carrier p.val.contained p.val.toBase (𝟙 p.val.siteObject)
  have hzj : yonedaEquiv.symm w ≫ P.allPathsRelation.left.hom = pair.left.hom := by
    rw [yonedaEquiv_symm_naturality_right, hw]
    exact yonedaEquiv.symm_apply_apply _
  have hzb : yonedaEquiv.symm w ≫ P.allPaths.hom.hom = yonedaEquiv.symm p.val.value := by
    rw [← over_w_hom P.allPathsRelation, ← Category.assoc, hzj]
    exact over_w_hom pair
  show y ∈ (presheafPreRelation j).weakOrbit p x
  rw [← weakOrbit_allPathsRelation P p x, PreRelation.weakOrbit_eq_targets _ hpre p x]
  refine (rel_presheafPreRelation_iff P.allPathsRelation y x).mpr
    ⟨testPointOver ⟨yonedaEquiv.symm w, hzb⟩, Subtype.ext ?_, Subtype.ext ?_⟩
  · show yonedaEquiv.symm w ≫ P.allPathsRelation.target.left.hom = y.1
    rw [show P.allPathsRelation.target.left.hom =
      P.allPathsRelation.left.hom ≫ (prod.fst : U ⨯ U ⟶ U).left.hom from rfl,
      ← Category.assoc, hzj]
    exact congrArg (fun m : representableOver (B := B) p.val.siteObject
      (yonedaEquiv.symm p.val.value) ⟶ U ↦ m.left.hom) hpairFst
  · show yonedaEquiv.symm w ≫ P.allPathsRelation.source.left.hom = x.1
    rw [show P.allPathsRelation.source.left.hom =
      P.allPathsRelation.left.hom ≫ (prod.snd : U ⨯ U ⟶ U).left.hom from rfl,
      ← Category.assoc, hzj]
    exact congrArg (fun m : representableOver (B := B) p.val.siteObject
      (yonedaEquiv.symm p.val.value) ⟶ U ↦ m.left.hom) hpairSnd

/-! ### Orbit spaces through the geometric points -/

/-- A morphism over `B` whose source is locally of finite type over `B` is locally of finite
type. -/
private theorem isLocallyOfFiniteType_left_hom_of_hom {A A' : Over B} (f : A ⟶ A')
    (h : IsLocallyOfFiniteType site S hS A.hom.hom) :
    IsLocallyOfFiniteType site S hS f.left.hom :=
  isLocallyOfFiniteType_of_comp site S hS A.left.property A'.left.property B.property
    f.left.hom A'.hom.hom (by rw [over_w_hom f]; exact h)

/-- **Stacks 04A0.** For a pre-relation whose relation space and whose source are locally of
finite type over the base, an invariant morphism out of `U` is an orbit space for the
pre-relation exactly when, over every algebraically closed field-valued point of the base, it
induces a bijection from the quotient of the points of `U` by the relation generated by the
pre-relation onto the points of the target: every point of the target over that point of the
base lifts, and two points of `U` have the same image precisely when they are weakly
equivalent. -/
@[stacks 04A0]
theorem isOrbitSpace_iff_geometricPoints_quotient_bijective {X : Over B}
    (j : PreRelation R U) (φ : U ⟶ X)
    (hR : IsLocallyOfFiniteType site S hS R.hom.hom)
    (hU : IsLocallyOfFiniteType site S hS U.hom.hom)
    (hφ : IsInvariant j φ.left) :
    IsOrbitSpace (presheafPreRelation j) φ.left.hom ↔
      ∀ p : GeometricPoint site S hS B.obj,
        (∀ y : TestPoint p.val.siteObject (yonedaEquiv.symm p.val.value)
            ((overForgetSpace B).obj X),
          ∃ x : TestPoint p.val.siteObject (yonedaEquiv.symm p.val.value)
            ((overForgetSpace B).obj U), x.1 ≫ φ.left.hom = y.1) ∧
        (∀ x y : TestPoint p.val.siteObject (yonedaEquiv.symm p.val.value)
            ((overForgetSpace B).obj U),
          x.1 ≫ φ.left.hom = y.1 ≫ φ.left.hom ↔
            (presheafPreRelation j).WeaklyEquivalent p.val x y) := by
  have hφlft := isLocallyOfFiniteType_left_hom_of_hom φ hU
  have htarget := isLocallyOfFiniteType_left_hom_of_hom j.target hR
  have hsource := isLocallyOfFiniteType_left_hom_of_hom j.source hR
  have hcrit := isSurjective_iff_surjective_app_isAlgClosed site S hS U.left.property
    X.left.property φ.left.hom hφlft
  constructor
  · rintro ⟨-, hsep, hsurj⟩ p
    have halg : IsAlgClosed p.val.carrier := p.property
    refine ⟨fun y ↦ ?_, fun x y ↦ ⟨fun hxy ↦ ?_, fun hxy ↦ ?_⟩⟩
    · obtain ⟨a, ha⟩ := hcrit.mp hsurj p.val.carrier p.val.contained p.val.toBase
        (yonedaEquiv y.1)
      have hbase : U.hom.hom.app (Opposite.op p.val.siteObject) a = p.val.value :=
        (base_left_hom_app φ (T := p.val.siteObject) a).symm.trans
          ((congrArg (X.hom.hom.app (Opposite.op p.val.siteObject)) ha).trans
            ((congrArg yonedaEquiv y.2).trans (Equiv.apply_symm_apply yonedaEquiv _)))
      exact ⟨⟨yonedaEquiv.symm a,
          (yonedaEquiv_symm_naturality_right p.val.siteObject
              ((overForgetSpace B).obj U).hom a).trans
            (congrArg yonedaEquiv.symm hbase)⟩,
        (yonedaEquiv_symm_naturality_right p.val.siteObject φ.left.hom a).trans
          ((congrArg yonedaEquiv.symm ha).trans (yonedaEquiv.symm_apply_apply y.1))⟩
    · exact (equivalent_iff_weaklyEquivalent_of_locallyOfFiniteType j hsource htarget
        p x y).mp (hsep.2 p x y hxy)
    · induction hxy with
      | rel a c hac => exact hsep.1 p a c hac
      | refl a => rfl
      | symm a c _ ih => exact ih.symm
      | trans a c d _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  · intro hpoints
    refine ⟨(isInvariant_presheafPreRelation_iff j φ).2 hφ,
      ⟨fun p a c hrel ↦ ((hpoints p).2 a c).mpr (Relation.EqvGen.rel _ _ hrel),
        fun p a c hac ↦ ?_⟩, hcrit.mpr ?_⟩
    · exact (equivalent_iff_weaklyEquivalent_of_locallyOfFiniteType j hsource htarget
        p a c).mpr (((hpoints p).2 a c).mp hac)
    · intro k _ _ hk b a
      set p : GeometricPoint site S hS B.obj :=
        ⟨⟨k, hk, b, X.hom.hom.app (Opposite.op (fieldObject (hS := hS) k hk b)) a⟩,
          inferInstance⟩
      have hy : yonedaEquiv.symm a ≫ ((overForgetSpace B).obj X).hom =
          yonedaEquiv.symm p.val.value :=
        yonedaEquiv_symm_naturality_right (fieldObject (hS := hS) k hk b)
          ((overForgetSpace B).obj X).hom a
      obtain ⟨x, hx⟩ := (hpoints p).1 ⟨yonedaEquiv.symm a, hy⟩
      refine ⟨yonedaEquiv x.1, ?_⟩
      show yonedaEquiv (x.1 ≫ φ.left.hom) = a
      rw [hx]
      exact Equiv.apply_symm_apply yonedaEquiv a

end AlgebraicGeometry.Space

end
