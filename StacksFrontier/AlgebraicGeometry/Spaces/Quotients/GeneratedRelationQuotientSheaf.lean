module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.Quotient.Sheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationEndpoints
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.PreRelationTestPoints

/-!
# The quotient sheaf of a pre-relation and of the relation it generates

Let `B` be an algebraic space over a scheme `S` of a big fppf site and let `j : R ⟶ U ×_B U` be
a pre-relation of algebraic spaces over `B`. Adjoining the identity and the reversed arrows to
`j` and composing finite strings of the result gives the relation `R_∞` of all finite paths
generated by `j`. The quotient sheaf `U/R` of **Stacks 044J** only records which points of `U`
are identified, and a map identifying the two endpoints of every arrow of `j` identifies the
two endpoints of every finite path; so passing from `R` to `R_∞` does not change the quotient.
This file constructs the canonical map `U/R ⟶ U/R_∞` and proves that it is an isomorphism,
which is part (2) of **Stacks 048T**.

The canonical map is the map under `U`: it is the unique morphism of sheaves commuting with the
two quotient projections out of `U`. That characterization is recorded on its own, so that
nothing said about the isomorphism depends on the way it was built.

## Main definitions

* `AlgebraicGeometry.Space.quotientSheafToAllPaths` is the canonical map `U/R ⟶ U/R_∞`.

## Main results

* `AlgebraicGeometry.Space.toQuotientSheaf_quotientSheafToAllPaths` and
  `AlgebraicGeometry.Space.quotientSheafToAllPaths_unique`: the canonical map is the unique
  morphism of sheaves compatible with the two quotient projections out of `U`.
* `AlgebraicGeometry.Space.isIso_quotientSheafToAllPaths`: **Stacks 048T**, part (2), the
  canonical map of quotient sheaves is an isomorphism.

## Implementation notes

The quotient sheaf of **Stacks 044J** is stated in the slice of presheaves over the presheaf of
`B`, while the paths generated by a pre-relation live in the slice of the algebraic spaces over
`B`. The two are joined by `AlgebraicGeometry.Space.presheafPreRelation`, whose target and
source maps are literally those of the original pre-relation, so no comparison of quotients is
needed beyond reading one slice inside the other.

Only the universal property of the quotient sheaf is used: both the map and its inverse are
obtained by descent, and that they are mutually inverse is the comparison of two factorizations
of one map out of `U`. The one substantial point is that the projection `U ⟶ U/R` descends to
the generated relation, that is that a map out of `U` identifying the endpoints of every arrow
of `j` identifies the endpoints of every finite path. This is proved by induction on the length
of the path, the base case splitting the one-step relation into its original, identity and
reversed summands of **Stacks 048S**. Both splittings use that the inclusion of the algebraic
spaces over `B` into the sheaves of sets preserves countable coproducts, so that a map out of a
coproduct of algebraic spaces into a sheaf is determined by its restrictions to the summands;
nothing is rebuilt by hand from the coproduct of sheaves.

Everything is stated for an arbitrary `AlgebraicGeometry.Space.PathConstruction`, not only for
the chosen `AlgebraicGeometry.Space.pathConstruction`, so it applies to any realization of the
generated relation.

## References

* [Stacks Project, Tag 044J](https://stacks.math.columbia.edu/tag/044J)
* [Stacks Project, Tag 048S](https://stacks.math.columbia.edu/tag/048S)
* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v u

namespace AlgebraicGeometry.Space

section Presheaves

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {Z : (BigFppfOver site S hS)ᵒᵖ ⥤ Type u} {R U : Over Z}

/-- A morphism out of a quotient sheaf is determined by its restriction to `U`: it and any
other such morphism are both *the* factorization of that restriction. -/
private theorem quotientSheaf_hom_ext (j : PreRelation R U)
    {A : Sheaf (BigFppfOver.topology site S hS) (Type u)} {f g : quotientSheaf j ⟶ A}
    (h : toQuotientSheaf j ≫ f.hom = toQuotientSheaf j ≫ g.hom) : f = g := by
  have hk : j.target.left ≫ (toQuotientSheaf j ≫ f.hom) =
      j.source.left ≫ (toQuotientSheaf j ≫ f.hom) := by
    simpa only [← Category.assoc] using
      congrArg (fun t => t ≫ f.hom) (target_toQuotientSheaf_eq_source j)
  exact (quotientSheafDesc_unique j A _ hk f rfl).trans
    (quotientSheafDesc_unique j A _ hk g h.symm).symm

end Presheaves

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS}

/-- Two morphisms `a` and `b` that the endpoint maps of a pre-relation `r` restrict to along `i`
become equal after a map `q` out of `U'` if and only if the two endpoint maps of `r` become equal
after `q` on the piece cut out by `i`. -/
private theorem comp_eq_iff_of_endpoints {T R' U' : Over B} {r : PreRelation R' U'} {i : T ⟶ R'}
    {a b : T ⟶ U'} {A : Sheaf (BigFppfOver.topology site S hS) (Type u)}
    {q : U'.left.obj ⟶ A.obj} (ht : i ≫ r.target = a) (hs : i ≫ r.source = b) :
    a.left.hom ≫ q = b.left.hom ≫ q ↔
      i.left.hom ≫ r.target.left.hom ≫ q = i.left.hom ≫ r.source.left.hom ≫ q := by
  have ht' : i.left.hom ≫ r.target.left.hom = a.left.hom :=
    congrArg (fun k => k.left.hom) ht
  have hs' : i.left.hom ≫ r.source.left.hom = b.left.hom :=
    congrArg (fun k => k.left.hom) hs
  simp only [← Category.assoc, ht', hs']

/-- If the two endpoint maps of a pre-relation `r` become equal after a map `q` out of `U'`,
then so do any two morphisms `a` and `b` that the endpoint maps of `r` restrict to. -/
private theorem eq_of_endpoints {T R' U' : Over B} {r : PreRelation R' U'} {i : T ⟶ R'}
    {a b : T ⟶ U'} {A : Sheaf (BigFppfOver.topology site S hS) (Type u)}
    {q : U'.left.obj ⟶ A.obj} (ht : i ≫ r.target = a) (hs : i ≫ r.source = b)
    (hr : r.target.left.hom ≫ q = r.source.left.hom ≫ q) :
    a.left.hom ≫ q = b.left.hom ≫ q :=
  (comp_eq_iff_of_endpoints ht hs).2 (by rw [hr])

/-- A map from a countable coproduct of algebraic spaces over `B` to a sheaf of sets is
determined by its restrictions to the summands: the inclusion of the algebraic spaces into the
sheaves of sets preserves countable coproducts. -/
private theorem cofan_hom_ext_sheaf {I : Type v} [Small.{u} I] [Countable I] {F : I → Over B}
    {Q : Over B} {ι : (i : I) → F i ⟶ Q} (hQ : IsColimit (Cofan.mk Q ι))
    {A : Sheaf (BigFppfOver.topology site S hS) (Type u)} {f g : Q.left.obj ⟶ A.obj}
    (h : ∀ i, (ι i).left.hom ≫ f = (ι i).left.hom ≫ g) : f = g := by
  have hK : IsColimit ((Over.forget B ⋙ algebraicSpacesToSheaf site S hS).mapCocone
      (Cofan.mk Q ι)) := isColimitOfPreserves _ hQ
  have hfg : (ObjectProperty.homMk f :
      (Over.forget B ⋙ algebraicSpacesToSheaf site S hS).obj Q ⟶ A) =
      ObjectProperty.homMk g := hK.hom_ext fun i => Sheaf.hom_ext (h i.as)
  exact congrArg (fun k => k.hom) hfg

variable {R U : Over B}

/-- The quotient projection of a pre-relation of algebraic spaces identifies the target and the
source of each of its arrows, read in the slice of algebraic spaces over `B`. -/
private theorem target_toQuotientSheaf_eq_source_hom (r : PreRelation R U) :
    r.target.left.hom ≫ toQuotientSheaf (presheafPreRelation r) =
      r.source.left.hom ≫ toQuotientSheaf (presheafPreRelation r) := by
  have h := target_toQuotientSheaf_eq_source (presheafPreRelation r)
  rwa [presheafPreRelation_target_left, presheafPreRelation_source_left] at h

variable {j : PreRelation R U}

/-- A map out of `U` identifying the two endpoints of every arrow of `j` identifies the two
endpoints of every path of a fixed length generated by `j`.

The length-one case splits the one-step relation into the original, the identity and the
reversed arrows; the inductive step splits a longer path into its first link and the rest. -/
private theorem pathRelation_equalized (P : PathConstruction j)
    {A : Sheaf (BigFppfOver.topology site S hS) (Type u)} {q : U.left.obj ⟶ A.obj}
    (hq : j.target.left.hom ≫ q = j.source.left.hom ≫ q) (n : ℕ) :
    (P.pathRelation n).target.left.hom ≫ q = (P.pathRelation n).source.left.hom ≫ q := by
  have hzero : (P.pathRelation 0).target.left.hom ≫ q =
      (P.pathRelation 0).source.left.hom ≫ q := by
    refine cofan_hom_ext_sheaf P.firstIsCoproduct (A := A) fun i => ?_
    fin_cases i
    · exact (comp_eq_iff_of_endpoints P.firstInclusion_zero_target
        P.firstInclusion_zero_source).1 hq
    · exact (comp_eq_iff_of_endpoints P.firstInclusion_one_target
        P.firstInclusion_one_source).1 rfl
    · exact (comp_eq_iff_of_endpoints P.firstInclusion_two_target
        P.firstInclusion_two_source).1 hq.symm
  induction n with
  | zero => exact hzero
  | succ n ih =>
    have hw : (P.firstArrow n).left.hom ≫ (P.pathRelation 0).source.left.hom =
        (P.remainingPath n).left.hom ≫ (P.pathRelation n).target.left.hom :=
      congrArg (fun k => k.left.hom) (P.successorIsPullback n).w
    rw [P.pathRelation_succ_target n, P.pathRelation_succ_source n]
    simp only [Over.comp_left, ObjectProperty.FullSubcategory.comp_hom]
    calc ((P.firstArrow n).left.hom ≫ (P.pathRelation 0).target.left.hom) ≫ q
        = ((P.firstArrow n).left.hom ≫ (P.pathRelation 0).source.left.hom) ≫ q := by
          simp only [Category.assoc, hzero]
      _ = ((P.remainingPath n).left.hom ≫ (P.pathRelation n).target.left.hom) ≫ q :=
          congrArg (fun m => m ≫ q) hw
      _ = ((P.remainingPath n).left.hom ≫ (P.pathRelation n).source.left.hom) ≫ q := by
          simp only [Category.assoc, ih]

/-- The canonical map from the quotient sheaf of a pre-relation `j` to the quotient sheaf of the
relation of all the finite paths generated by `j`: the quotient projection of the path relation
identifies the two endpoints of every arrow of `j`, so it descends through the quotient by
`j`. -/
noncomputable def quotientSheafToAllPaths (P : PathConstruction j) :
    quotientSheaf (presheafPreRelation j) ⟶
      quotientSheaf (presheafPreRelation P.allPathsRelation) :=
  quotientSheafDesc (presheafPreRelation j)
      (quotientSheaf (presheafPreRelation P.allPathsRelation))
      (toQuotientSheaf (presheafPreRelation P.allPathsRelation)) <| by
    rw [presheafPreRelation_target_left, presheafPreRelation_source_left]
    exact eq_of_endpoints P.originalArrow_target P.originalArrow_source
      (target_toQuotientSheaf_eq_source_hom P.allPathsRelation)

/-- The canonical map of quotient sheaves is a map under `U`: it carries the quotient projection
onto `U/R` to the quotient projection onto `U/R_∞`. -/
theorem toQuotientSheaf_quotientSheafToAllPaths (P : PathConstruction j) :
    toQuotientSheaf (presheafPreRelation j) ≫ (quotientSheafToAllPaths P).hom =
      toQuotientSheaf (presheafPreRelation P.allPathsRelation) :=
  toQuotientSheaf_quotientSheafDesc _ _ _ _

/-- The canonical map of quotient sheaves is the *only* map under `U`, which is what makes it
canonical: any morphism carrying the quotient projection onto `U/R` to the quotient projection
onto `U/R_∞` is it. -/
theorem quotientSheafToAllPaths_unique (P : PathConstruction j)
    (f : quotientSheaf (presheafPreRelation j) ⟶
      quotientSheaf (presheafPreRelation P.allPathsRelation))
    (hf : toQuotientSheaf (presheafPreRelation j) ≫ f.hom =
      toQuotientSheaf (presheafPreRelation P.allPathsRelation)) :
    f = quotientSheafToAllPaths P :=
  quotientSheaf_hom_ext (presheafPreRelation j)
    (hf.trans (toQuotientSheaf_quotientSheafToAllPaths P).symm)

/-- The inverse of the canonical map: the quotient projection onto `U/R` identifies the two
endpoints of every finite path, so it descends through the quotient by the path relation. -/
private noncomputable def allPathsToQuotientSheaf (P : PathConstruction j) :
    quotientSheaf (presheafPreRelation P.allPathsRelation) ⟶
      quotientSheaf (presheafPreRelation j) :=
  quotientSheafDesc (presheafPreRelation P.allPathsRelation)
      (quotientSheaf (presheafPreRelation j))
      (toQuotientSheaf (presheafPreRelation j)) <| by
    rw [presheafPreRelation_target_left, presheafPreRelation_source_left]
    refine cofan_hom_ext_sheaf P.allPathsIsCoproduct
      (A := quotientSheaf (presheafPreRelation j)) fun n => ?_
    exact (comp_eq_iff_of_endpoints (P.pathInclusion_target n) (P.pathInclusion_source n)).1
      (pathRelation_equalized P (target_toQuotientSheaf_eq_source_hom j) n)

/-- **Stacks 048T**, part (2). The canonical map of quotient sheaves `U/R ⟶ U/R_∞`, from the
quotient by a pre-relation to the quotient by the relation of all the finite paths it generates,
is an isomorphism. -/
@[stacks 048T "part (2): the quotient sheaf is unchanged"]
theorem isIso_quotientSheafToAllPaths (P : PathConstruction j) :
    IsIso (quotientSheafToAllPaths P) := by
  have hfj := toQuotientSheaf_quotientSheafToAllPaths P
  have hgj : toQuotientSheaf (presheafPreRelation P.allPathsRelation) ≫
      (allPathsToQuotientSheaf P).hom = toQuotientSheaf (presheafPreRelation j) :=
    toQuotientSheaf_quotientSheafDesc _ _ _ _
  have hgf : quotientSheafToAllPaths P ≫ allPathsToQuotientSheaf P = 𝟙 _ :=
    quotientSheaf_hom_ext (presheafPreRelation j) (by
      simp only [ObjectProperty.FullSubcategory.comp_hom, ← Category.assoc]
      erw [hfj, hgj]; simp)
  have hfg : allPathsToQuotientSheaf P ≫ quotientSheafToAllPaths P = 𝟙 _ :=
    quotientSheaf_hom_ext (presheafPreRelation P.allPathsRelation) (by
      simp only [ObjectProperty.FullSubcategory.comp_hom, ← Category.assoc]
      erw [hgj, hfj]; simp)
  exact ⟨⟨allPathsToQuotientSheaf P, hgf, hfg⟩⟩

end AlgebraicGeometry.Space

end
