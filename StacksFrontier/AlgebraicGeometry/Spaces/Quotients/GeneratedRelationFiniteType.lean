module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.CoproductFiniteType
public import StacksFrontier.AlgebraicGeometry.Spaces.Quotients.GeneratedRelationPaths

/-!
# Local finite type of the relation generated by a pre-relation

Let `j : R ⟶ U ×_B U` be a pre-relation of algebraic spaces over an algebraic space `B` and let
`j_∞ : R_∞ ⟶ U ×_B U` be the relation of all finite paths it generates. If the source and the
target map of `j` are locally of finite type, then so are the source and the target map of
`j_∞`.

Being locally of finite type is stable under composition and under base change and is Zariski
local on the source; those three properties are all the argument uses. The space of paths of
length one is the disjoint union of `R`, `U` and `R`, whose endpoint maps are the source and
target of `j`, the identity, and the source and target of `j` again; a path of length `n + 2`
is a fibre product of a path of length one with a path of length `n + 1`, so its endpoint maps
are composites of base changes of the endpoint maps of the two pieces; and the generated
relation is the disjoint union of the spaces of paths of all lengths.

## Main results

* `AlgebraicGeometry.Space.allPathsRelation_source_locallyOfFiniteType` and
  `AlgebraicGeometry.Space.allPathsRelation_target_locallyOfFiniteType`: **Stacks 048T,
  part (5)**.

## Implementation notes

The two disjoint unions are indexed by `Fin 3` and by `ℕ`, and locality on the source along
them is `AlgebraicGeometry.Space.isLocallyOfFiniteType_of_isColimit_cofan_over`, which asks
only for the colimit cofan recorded by `AlgebraicGeometry.Space.PathConstruction`.

Both endpoint maps are handled by one induction, since the inductive step for the source uses
the length-one target and conversely.

## References

* [Stacks Project, Tag 048T](https://stacks.math.columbia.edu/tag/048T)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable {site : BigFppfSite.{u}} {S : Scheme.{u}} {hS : site.Contains S}
  {B : AlgebraicSpaces site S hS} {R U : Over B} {j : PreRelation R U}

/-- Both endpoint maps of the space of paths of each positive length are locally of finite type
when both endpoint maps of the original pre-relation are.

The two claims are proved together: the source of a path of length `n + 2` is the source of its
tail, based changed along its head, while the target is the target of its head, base changed
along its tail. -/
private theorem pathRelation_locallyOfFiniteType (P : PathConstruction j)
    (hs : IsLocallyOfFiniteType site S hS j.source.left.hom)
    (ht : IsLocallyOfFiniteType site S hS j.target.left.hom) (n : ℕ) :
    IsLocallyOfFiniteType site S hS (P.pathRelation n).source.left.hom ∧
      IsLocallyOfFiniteType site S hS (P.pathRelation n).target.left.hom := by
  have hid (V : Over B) : IsLocallyOfFiniteType site S hS (𝟙 V.left.obj) :=
    isLocallyOfFiniteType_of_isEtale site S hS V.left.property
      (isEtale_of_isIso site S hS (𝟙 V.left.obj))
  have hzero_aux (f : P.path 0 ⟶ U) (a c : R ⟶ U)
      (ha : IsLocallyOfFiniteType site S hS a.left.hom)
      (hc : IsLocallyOfFiniteType site S hS c.left.hom)
      (h0 : P.firstInclusion 0 ≫ f = a) (h1 : P.firstInclusion 1 ≫ f = 𝟙 U)
      (h2 : P.firstInclusion 2 ≫ f = c) :
      IsLocallyOfFiniteType site S hS f.left.hom := by
    refine isLocallyOfFiniteType_of_isColimit_cofan_over site S hS P.firstInclusion
      P.firstIsCoproduct f fun i ↦ ?_
    fin_cases i <;> dsimp only
    · show IsLocallyOfFiniteType site S hS (P.firstInclusion 0 ≫ f).left.hom
      rwa [h0]
    · show IsLocallyOfFiniteType site S hS (P.firstInclusion 1 ≫ f).left.hom
      rw [h1]
      exact hid U
    · show IsLocallyOfFiniteType site S hS (P.firstInclusion 2 ≫ f).left.hom
      rwa [h2]
  have hzero :
      IsLocallyOfFiniteType site S hS (P.pathRelation 0).source.left.hom ∧
      IsLocallyOfFiniteType site S hS (P.pathRelation 0).target.left.hom := by
    constructor
    · refine hzero_aux _ _ _ hs ht ?_ ?_ ?_
      · simpa only [PreRelation.source, ← Category.assoc] using
          congrArg (fun k ↦ k ≫ prod.snd) P.originalEndpoints
      · simp only [PreRelation.source, ← Category.assoc, P.identityEndpoints, diag,
          prod.lift_snd]
      · simp only [PreRelation.source, ← Category.assoc, P.reversedEndpoints,
          flippedRelation, prod.lift_snd]
    · refine hzero_aux _ _ _ ht hs ?_ ?_ ?_
      · simpa only [PreRelation.target, ← Category.assoc] using
          congrArg (fun k ↦ k ≫ prod.fst) P.originalEndpoints
      · simp only [PreRelation.target, ← Category.assoc, P.identityEndpoints, diag,
          prod.lift_fst]
      · simp only [PreRelation.target, ← Category.assoc, P.reversedEndpoints,
          flippedRelation, prod.lift_fst]
  induction n with
  | zero => exact hzero
  | succ n ih =>
    have hbc := isLocallyOfFiniteType_isStableUnderBaseChange site S hS
    have hhead : IsLocallyOfFiniteType site S hS (P.firstArrow n).left.hom :=
      hbc.of_isPullback ((P.successorIsPullback n).map (Over.forget B)).flip ih.2
    have htail : IsLocallyOfFiniteType site S hS (P.remainingPath n).left.hom :=
      hbc.of_isPullback ((P.successorIsPullback n).map (Over.forget B)) hzero.1
    have heS : (P.pathRelation (n + 1)).source =
        P.remainingPath n ≫ (P.pathRelation n).source := by
      simp only [PreRelation.source, P.successorEndpoints, prod.lift_snd]
    have heT : (P.pathRelation (n + 1)).target =
        P.firstArrow n ≫ (P.pathRelation 0).target := by
      simp only [PreRelation.target, P.successorEndpoints, prod.lift_fst]
    refine ⟨?_, ?_⟩
    · rw [heS]
      exact isLocallyOfFiniteType_comp site S hS (P.path (n + 1)).left.property
        (P.path n).left.property U.left.property _ _ htail ih.1
    · rw [heT]
      exact isLocallyOfFiniteType_comp site S hS (P.path (n + 1)).left.property
        (P.path 0).left.property U.left.property _ _ hhead hzero.2

/-- **Stacks 048T, part (5).** The source map of the relation of all finite paths is locally of
finite type when both endpoint maps of the original pre-relation are. -/
@[stacks 048T "part (5): locally of finite type"]
theorem allPathsRelation_source_locallyOfFiniteType (P : PathConstruction j)
    (hs : IsLocallyOfFiniteType site S hS j.source.left.hom)
    (ht : IsLocallyOfFiniteType site S hS j.target.left.hom) :
    IsLocallyOfFiniteType site S hS P.allPathsRelation.source.left.hom := by
  refine isLocallyOfFiniteType_of_isColimit_cofan_over site S hS P.pathInclusion
    P.allPathsIsCoproduct P.allPathsRelation.source fun n ↦ ?_
  have he : P.pathInclusion n ≫ P.allPathsRelation.source = (P.pathRelation n).source := by
    simpa only [PreRelation.source, ← Category.assoc] using
      congrArg (fun k ↦ k ≫ prod.snd) (P.allPathsEndpoints n)
  rw [he]
  exact (pathRelation_locallyOfFiniteType P hs ht n).1

/-- **Stacks 048T, part (5).** The target map of the relation of all finite paths is locally of
finite type when both endpoint maps of the original pre-relation are. -/
@[stacks 048T "part (5): locally of finite type"]
theorem allPathsRelation_target_locallyOfFiniteType (P : PathConstruction j)
    (hs : IsLocallyOfFiniteType site S hS j.source.left.hom)
    (ht : IsLocallyOfFiniteType site S hS j.target.left.hom) :
    IsLocallyOfFiniteType site S hS P.allPathsRelation.target.left.hom := by
  refine isLocallyOfFiniteType_of_isColimit_cofan_over site S hS P.pathInclusion
    P.allPathsIsCoproduct P.allPathsRelation.target fun n ↦ ?_
  have he : P.pathInclusion n ≫ P.allPathsRelation.target = (P.pathRelation n).target := by
    simpa only [PreRelation.target, ← Category.assoc] using
      congrArg (fun k ↦ k ≫ prod.fst) (P.allPathsEndpoints n)
  rw [he]
  exact (pathRelation_locallyOfFiniteType P hs ht n).2

end AlgebraicGeometry.Space

end
