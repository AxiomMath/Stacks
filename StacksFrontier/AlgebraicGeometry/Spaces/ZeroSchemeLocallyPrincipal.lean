/-!
# The zero scheme of a section of an invertible module is locally principal

Let `X` be an algebraic space over a scheme `S` contained in a big fppf site `B`, let `L` be an
invertible `𝒪_X`-module, and let `s` be a global section of `L`. This file proves that the zero
scheme `Z(s)` is a locally principal closed subspace of `X`, with invertibility of `L` the only
hypothesis.

## Main results

* `AlgebraicGeometry.Space.isLocallyPrincipal_zeroScheme`: the zero scheme of a global section
  of an invertible module is a locally principal closed subspace.

## Implementation notes

An invertible module is finite locally free of rank one on the small étale site
(`AlgebraicGeometry.Space.isFiniteLocallyFreeOfRank_one_of_isInvertible`), so on a covering
family `{V i ⟶ U}` of every object `U` the restriction `L.over (V i)` is isomorphic to the
structure sheaf restricted to `V i`.  Transporting the section `s` through that isomorphism
produces, for every further chart `W ⟶ V i`, a coefficient `coeff i W g ∈ 𝒪_X(W)`; by
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_eq_span_singleton` the evaluation ideal of
`s` on an affine chart is the principal ideal generated by this coefficient, and by
`AlgebraicGeometry.Space.exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible`
together with `AlgebraicGeometry.Space.isLocallyPrincipal_zeroScheme_iff` the question reduces
to local principality of the closed subspace `Z` whose defining ideal chartwise *is* that
evaluation ideal. The coefficients then give, on every affine chart, a section of the defining
ideal sheaf that generates it. Every object of the small étale site is covered by affine charts
(`AlgebraicGeometry.Space.affine_chart_cover`), as an explicit covering family rather than as a
`GrothendieckTopology.CoversTop`.

## References

* [Stacks Project, Tag 0846](https://stacks.math.columbia.edu/tag/0846)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace AlgebraicGeometry.Space

/-! ### Generic sheaf-of-modules lemmas -/

/-- A sheaf of modules `M` exhibited by the cofan `ι` as a coproduct of a single copy of the
structure sheaf is isomorphic to the structure sheaf. -/
noncomputable def iso_of_one_coproduct
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{w}) (M : SheafOfModules.{w} R)
    (ι : ∀ _ : Fin 1, SheafOfModules.unit R ⟶ M)
    (hc : IsColimit (Cofan.mk M ι)) :
    M ≅ SheafOfModules.unit R := by
  let c0 : Cofan (fun _ : Fin 1 => SheafOfModules.unit R) :=
    Cofan.mk (SheafOfModules.unit R) (fun _ => 𝟙 _)
  let hc0 : IsColimit c0 := Cofan.isColimitMkOfUnique (Iso.refl _) (Fin 1)
  exact hc.coconePointUniqueUpToIso hc0

/-- An isomorphism `e : M ≅ 𝒪` of sheaves of modules commutes with restriction of sections along
`f`. -/
theorem iso_coefficient_natural
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} {M : SheafOfModules.{w} R}
    (e : M ≅ SheafOfModules.unit R)
    {X Y : Cᵒᵖ} (f : X ⟶ Y) (x : M.val.obj X) :
    (SheafOfModules.unit R).val.map f (e.hom.val.app X x) =
      e.hom.val.app Y (M.val.map f x) :=
  (PresheafOfModules.naturality_apply e.hom.val f x).symm

/-- A morphism of sheaves of modules is an epimorphism if every section of the target lies
locally in its image. -/
theorem epi_of_locally_surjective
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    {M N : SheafOfModules.{w} R} (p : M ⟶ N)
    (h : ∀ (U : C) (x : N.val.obj (op U)),
      Presheaf.imageSieve ((SheafOfModules.toSheaf R).map p).hom x ∈ J U) :
    Epi p := by
  have : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map p) :=
    ⟨fun s => h _ s⟩
  exact (SheafOfModules.toSheaf R).epi_of_epi_map inferInstance

/-- A morphism of sheaves of modules `p` is an epimorphism if every object `U` has a covering
family `{V i ⟶ U}` such that `p` is surjective on sections over each `V i`. -/
theorem epi_of_cover_surjective
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    {M N : SheafOfModules.{w} R} (p : M ⟶ N)
    (h : ∀ U : C, ∃ (I : Type (max u v)) (V : I → C)
      (f : ∀ i, V i ⟶ U),
      Sieve.ofArrows V f ∈ J U ∧
      ∀ i, Function.Surjective (p.val.app (op (V i)))) : Epi p := by
  apply epi_of_locally_surjective p
  intro U x
  obtain ⟨I, V, f, hc, hs⟩ := h U
  refine J.superset_covering (fun W g hg => ?_) hc
  obtain ⟨i, a, rfl⟩ := (Sieve.mem_ofArrows_iff V f g).mp hg
  exact (Presheaf.imageSieve ((SheafOfModules.toSheaf R).map p).hom x).downward_closed
    (hs i (N.val.map (f i).op x)) a

/-- The morphism from the structure sheaf to `M` determined by a global section `a` is an
epimorphism if every object has a covering family `{V i}` such that every section of `M` over
`V i` is an `R(V i)`-multiple of the restriction of `a`. -/
theorem epi_of_section_locally_generates
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R)
    (a : M.sections)
    (h : ∀ U : C, ∃ (ι : Type (max u v)) (V : ι → C)
      (f : ∀ i, V i ⟶ U),
      Sieve.ofArrows V f ∈ J U ∧
        ∀ (i : ι),
          letI : Module (R.obj.obj (op (V i))) (M.val.obj (op (V i))) :=
            (M.val.obj (op (V i))).isModule
          ∀ (x : M.val.obj (op (V i))),
          ∃ r : R.obj.obj (op (V i)), r • a.eval (op (V i)) = x) :
    Epi (M.unitHomEquiv.symm a) := by
  apply epi_of_cover_surjective (M.unitHomEquiv.symm a)
  intro U
  obtain ⟨ι, V, f, hc, hg⟩ := h U
  refine ⟨ι, V, f, hc, fun i => ?_⟩
  let : Module (R.obj.obj (op (V i))) (M.val.obj (op (V i))) :=
    (M.val.obj (op (V i))).isModule
  intro x
  obtain ⟨r, hr⟩ := hg i x
  refine ⟨r, ?_⟩
  let p := M.unitHomEquiv.symm a
  have hp : p.val.app (op (V i)) (1 : R.obj.obj (op (V i))) =
      a.eval (op (V i)) :=
    (M.unitHomEquiv_apply_coe p (op (V i))).symm ▸
      congrArg (fun t : M.sections => t.eval (op (V i)))
        (M.unitHomEquiv.apply_symm_apply a)
  calc
    p.val.app (op (V i)) r =
        p.val.app (op (V i)) (r • (1 : R.obj.obj (op (V i)))) := by simp
    _ = r • p.val.app (op (V i)) (1 : R.obj.obj (op (V i))) := map_smul _ _ _
    _ = x := by rw [hp, hr]

/-- A section `a` of the structure sheaf over `U` lies in the subsheaf of submodules `N` if its
restrictions along every arrow of a covering sieve of `U` lie in `N`. -/
theorem submodule_mem_of_cover
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    (N : (SheafOfModules.unit R).Submodule)
    {U : C} (a : R.obj.obj (op U))
    (S : Sieve U) (hS : S ∈ J U)
    (h : ∀ (V : C) (f : V ⟶ U), S f →
      (SheafOfModules.unit R).val.map f.op a ∈ N.obj (op V)) :
    a ∈ N.obj (op U) :=
  N.isSheaf a (J.superset_covering (fun V f hf => h V f hf) hS)

private noncomputable def unit_generatingSections
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{w})
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}] :
    (SheafOfModules.unit R).GeneratingSections where
  I := PUnit
  s := fun _ => (SheafOfModules.unit R).unitHomEquiv (𝟙 _)
  epi := by
    let s : PUnit → (SheafOfModules.unit R).sections := fun _ =>
      (SheafOfModules.unit R).unitHomEquiv (𝟙 _)
    let e : SheafOfModules.free (R := R) PUnit ⟶ SheafOfModules.unit R :=
      ((SheafOfModules.unit R).freeHomEquiv).symm s
    change Epi e
    refine ⟨?_⟩
    intro M f g h
    have h' : SheafOfModules.sectionsMap f (s PUnit.unit) =
        SheafOfModules.sectionsMap g (s PUnit.unit) := by
      simpa [e, s, SheafOfModules.freeHomEquiv_comp_apply] using
        congrArg (fun k => (M.freeHomEquiv k) PUnit.unit) h
    have key (k : SheafOfModules.unit R ⟶ M) : SheafOfModules.sectionsMap k
        ((SheafOfModules.unit R).unitHomEquiv (𝟙 _)) = M.unitHomEquiv k := by
      simpa using (SheafOfModules.unitHomEquiv_comp_apply
        (M := SheafOfModules.unit R) (N := M) (𝟙 _) k).symm
    rw [key f, key g] at h'
    exact M.unitHomEquiv.injective h'

private theorem has_single_generator_of_epi_from_unit
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    {M : SheafOfModules.{w} R}
    (p : SheafOfModules.unit R ⟶ M) [Epi p] :
    ∃ σ : M.GeneratingSections, Nonempty (σ.I ≃ Fin 1) := by
  let σ := (unit_generatingSections R).ofEpi p
  refine ⟨σ, ?_⟩
  show Nonempty (PUnit ≃ Fin 1)
  exact ⟨(Equiv.equivPUnit (Fin 1)).symm⟩

/-! ### Affine étale covers -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Every object of the small étale site admits a covering family by affine charts. -/
theorem affine_chart_cover
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (U : SmallEtale B S hS F) :
    ∃ (ι : Type (u + 1)) (W : ι → SmallEtale B S hS F) (f : ∀ i, W i ⟶ U),
      Sieve.ofArrows W f ∈ SmallEtale.topology B S hS F U ∧
        ∀ i, IsAffine ((SmallEtale.toSchemes B S hS F).obj (W i)).1 := by
  set E : PreZeroHypercover.{u + 1} U :=
    { I₀ := ULift.{u + 1}
        ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS F).obj U)).affineOpens
      X := fun O => openChart B S hS F U O.down.1
      f := fun O => openChartInclusion B S hS F U O.down.1 }
  have hcov : IsEtaleCovering
      (⟨(SmallEtale.toSchemes B S hS F).obj U, E.map (SmallEtale.toSchemes B S hS F)⟩ :
        Covering B.Schemes) := by
    refine (Scheme.presieve₀_mem_precoverage_iff (P := @Etale)
      ((E.map (SmallEtale.toSchemes B S hS F)).map B.inclusion)).2 ⟨?_, ?_⟩
    · intro x
      have hx : x ∈ (⊤ : ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS F).obj U)).Opens) := trivial
      rw [← iSup_affineOpens_eq_top] at hx
      obtain ⟨O, hO⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      refine ⟨ULift.up O, ?_⟩
      have heq := toScheme_map_toOver_map_openChartInclusion B S hS F U (O : _)
      obtain ⟨y, hy⟩ := (Scheme.Opens.range_ι (X := (BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS F).obj U)) (O : _)).ge hO
      refine ⟨y, ?_⟩
      show ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map
        (openChartInclusion B S hS F U (O : _)))) y = x
      rw [heq]
      exact hy
    · intro O
      exact etale_toScheme_toOver_map B S hS F (openChartInclusion B S hS F U O.down.1)
  have hpre : E.presieve₀ ∈ SmallEtale.precoverage B S hS F U := by
    rw [SmallEtale.precoverage_eq_comap, Precoverage.mem_comap_iff,
      ← PreZeroHypercover.presieve₀_map]
    exact B.presieve₀_mem_etalePrecoverage _ hcov
  refine ⟨E.I₀, E.X, E.f, ?_, fun O => ?_⟩
  · exact Precoverage.generate_mem_toGrothendieck
      (J := SmallEtale.precoverage B S hS F) hpre
  · show IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS F).obj (E.X O)))
    exact O.down.2

/-- The slice-site form of `affine_chart_cover`: an affine étale cover of an object over `Y`
of the small étale site, as a family in `CategoryTheory.Over Y`. -/
theorem affine_chart_cover_over
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (Y : SmallEtale B S hS F) (T : Over Y) :
    ∃ (ι : Type (u + 1)) (W : ι → Over Y) (f : ∀ i, W i ⟶ T),
      Sieve.ofArrows W f ∈ (SmallEtale.topology B S hS F).over Y T ∧
        ∀ i, IsAffine ((SmallEtale.toSchemes B S hS F).obj (W i).left).1 := by
  obtain ⟨ι, W, g, hc, hA⟩ := affine_chart_cover B S hS F T.left
  let W' (i : ι) : Over Y := Over.mk (g i ≫ T.hom)
  let f' (i : ι) : W' i ⟶ T := Over.homMk (g i) rfl
  refine ⟨ι, W', f', ?_, hA⟩
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  exact hc

/-! ### Local principality of the zero scheme -/

variable (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)

/-- The zero scheme of a global section `s` of an invertible `𝒪_X`-module `L` is a locally
principal closed subspace of `X`. -/
@[stacks 0846 "part (3): the zero scheme of a section of an invertible module is a locally \
principal closed subspace"]
theorem isLocallyPrincipal_zeroScheme
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L) :
    IsLocallyPrincipal B S hS X (zeroScheme B S hS X L s) := by
  classical
  let E := smallEtaleRingedSite B S hS X.1 X.2
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hinv
  rw [isLocallyPrincipal_zeroScheme_iff B S hS X L s Z hZ]
  have hRank : RingedSite.IsFiniteLocallyFreeOfRank E L 1 :=
    isFiniteLocallyFreeOfRank_one_of_isInvertible B S hS X L hinv
  let J := definingIdealSheaf B S hS X Z
  let J' : (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf E.O)).Submodule := J
  intro U
  obtain ⟨I, V, f, hcover, htriv⟩ := hRank U
  have hIso (i : I) :
      L.over (V i) ≅
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i)) := by
    let ι := (htriv i).choose
    let hc := Classical.choice (htriv i).choose_spec
    exact iso_of_one_coproduct ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i))
      (L.over (V i)) ι hc
  let coeff (i : I) (W : E.C) (g : W ⟶ V i) :
      (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op W) :=
    (hIso i).hom.val.app (op (Over.mk g)) (s.eval (op W))
  have hCoeffMap (i : I) {W T : E.C} (g : W ⟶ V i) (k : T ⟶ W) :
      (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.map k.op (coeff i W g) =
        coeff i T (k ≫ g) := by
    let q : (Over.mk (k ≫ g) : Over (V i)) ⟶ (Over.mk g : Over (V i)) := Over.homMk k rfl
    have hn := iso_coefficient_natural (hIso i) q.op (s.eval (op W))
    have hs : L.val.map k.op (s.eval (op W)) = s.eval (op T) := s.property k.op
    change (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.map k.op (coeff i W g) =
      (hIso i).hom.val.app (op (Over.mk (k ≫ g))) (L.val.map k.op (s.eval (op W))) at hn
    rw [hs] at hn
    exact hn
  have hIdealCoeff (i : I) (W : E.C) (g : W ⟶ V i)
      (hW : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj W).1) :
      J'.obj (op W) = Ideal.span {coeff i W g} := by
    show J.obj (op W) = Ideal.span {coeff i W g}
    have hJW : J.obj (op W) = definingIdealAt B S hS X Z (op W) :=
      definingIdealSheaf_obj B S hS X Z (op W)
    let eW := (SheafOfModules.evaluation ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i))
      (op (Over.mk g))).mapIso (hIso i)
    let eR : L.val.obj (op W) ≃ₗ[(Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op W)]
        (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op W) :=
      eW.toLinearEquiv
    have hb : ∀ x : L.val.obj (op W), eR x • eR.symm 1 = x := fun x => by
      apply eR.injective
      simp
    have hspan := sectionEvaluationIdealAt_eq_span_singleton B S hS X L s W
      (eR.symm 1) eR.toLinearMap hb
    have hcoeff : eR.toLinearMap (s.eval (op W)) = coeff i W g := rfl
    rw [hJW, hZ W hW, hspan, hcoeff]
  have hCoeffMem (i : I) (Y : E.C) (h : Y ⟶ V i) :
      coeff i Y h ∈ J'.obj (op Y) := by
    obtain ⟨K, W, g, hc, hAff⟩ := affine_chart_cover B S hS X.1 Y
    let W' (k : K) : E.C := W k
    let g' (k : K) : W' k ⟶ Y := g k
    have hc' : Sieve.ofArrows W' g' ∈ E.J Y := hc
    apply submodule_mem_of_cover J' (coeff i Y h) (Sieve.ofArrows W' g') hc'
    intro T k hk
    obtain ⟨j, d, rfl⟩ := (Sieve.mem_ofArrows_iff W' g' k).mp hk
    have hj : (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.map (g' j).op (coeff i Y h) ∈
        J'.obj (op (W' j)) := by
      rw [hCoeffMap i h (g' j), hIdealCoeff i (W' j) (g' j ≫ h) (hAff j)]
      show coeff i (W' j) (g' j ≫ h) ∈
        (Ideal.span {coeff i (W' j) (g' j ≫ h)} :
          Ideal ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op (W' j))))
      exact Ideal.subset_span (Set.mem_singleton _)
    have hd := J'.toSubmodule.map_mem d.op hj
    have heq : (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf E.O)).val.map
        (d ≫ g' j).op (coeff i Y h) =
        (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf E.O)).val.map d.op
          ((SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf E.O)).val.map (g' j).op
            (coeff i Y h)) := by
      rw [op_comp]
      exact (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf E.O)).val.map_comp_apply
        (g' j).op d.op (coeff i Y h)
    rw [heq]
    exact hd
  have hGen (i : I) (Y : E.C) (h : Y ⟶ V i) :
      ∃ σ : (J'.toSheafOfModules.over Y).GeneratingSections, Nonempty (σ.I ≃ Fin 1) := by
    let a : J'.toSheafOfModules.val.obj (op Y) := ⟨coeff i Y h, hCoeffMem i Y h⟩
    let sec := SheafOfModules.sectionOver J'.toSheafOfModules a
    let p := (J'.toSheafOfModules.over Y).unitHomEquiv.symm sec
    have hp : Epi p := by
      apply epi_of_section_locally_generates (J'.toSheafOfModules.over Y) sec
      intro T
      obtain ⟨K, W, g, hc, hAff⟩ := affine_chart_cover_over B S hS X.1 Y T
      let W' (k : K) : Over Y := W k
      let g' (k : K) : W' k ⟶ T := g k
      have hc' : Sieve.ofArrows W' g' ∈ (E.J).over Y T := hc
      refine ⟨K, W', g', hc', ?_⟩
      intro j x
      let xVal : (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op (W' j).left) := x.val
      have hx : xVal ∈
          (Ideal.span {coeff i (W' j).left ((W' j).hom ≫ h)} :
            Ideal ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op (W' j).left))) := by
        have hx' : xVal ∈ J'.obj (op (W' j).left) := x.property
        rw [hIdealCoeff i (W' j).left ((W' j).hom ≫ h) (hAff j)] at hx'
        exact hx'
      let : CommRing ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op (W' j).left)) :=
        CommRingCat.commRing (E.O.obj.obj (op (W' j).left))
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hx
      refine ⟨r, ?_⟩
      apply Subtype.ext
      show r * (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.map (W' j).hom.op
        (coeff i Y h) = xVal
      rw [hCoeffMap i h (W' j).hom]
      exact (mul_comm r (coeff i (W' j).left ((W' j).hom ≫ h))).trans hr.symm
    let : Epi p := hp
    exact has_single_generator_of_epi_from_unit p
  refine ⟨⟨Sieve.ofArrows V f, hcover⟩, ?_⟩
  intro Y g hg
  obtain ⟨i, k, rfl⟩ := (Sieve.mem_ofArrows_iff V f g).mp hg
  exact hGen i Y k

end AlgebraicGeometry.Space

end
