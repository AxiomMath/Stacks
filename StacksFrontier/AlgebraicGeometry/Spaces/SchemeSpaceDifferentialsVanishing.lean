/-!
# The vanishing of the spaces-level differentials of a morphism of schemes

Let `ψ : U ⟶ V` be a morphism of the big fppf category over a scheme `S`. If the sheaf of
differentials `Ω` of the induced morphism of algebraic spaces `schemeSpaceMap ψ` (Stacks 04CT) is
a zero object, then so is the scheme-level sheaf of relative differentials `Ω_{U/V}`
(Stacks 01US). This is one direction of the vanishing statement of Stacks 04CS.

On the small étale site of `U` the assignment `W ↦ Γ(W, W.hom^*Ω_{U/V})` is a sheaf of modules
(`AlgebraicGeometry.Space.schemeSpaceDifferentialsModule`), and `a ↦ d a`, read through the
isomorphism `W.hom^*Ω_{U/V} ≅ Ω_{W/V}` of Stacks 04BX, is a derivation into it relative to `ψ`
(`AlgebraicGeometry.Space.schemeSpaceDifferentialsDerivation`). It factors through the universal
derivation of the spaces-level `Ω`; if that vanishes, so does this derivation, in particular on
every Zariski open `A` of `U`. There `Γ(A, Ω_{U/V})` is generated by the differentials of
functions on `A`, so it vanishes, and `Ω_{U/V}` is zero.

Read through Stacks 04CU on a square of étale charts, this is one half of the chart comparison
for the sheaf of differentials of a morphism of algebraic spaces, which gives Stacks 04G9.

## Main results

* `isZero_relativeDifferentials_of_isZero_sheafOfDifferentials_schemeSpaceMap`: if the
  spaces-level `Ω` of `schemeSpaceMap ψ` vanishes, then so does `Ω_{U/V}`.
* `AlgebraicGeometry.Space.sheafOfDifferentialsChartComparisonMp`: the backward half of the
  chart comparison for the sheaf of differentials of a morphism of algebraic spaces.
* `AlgebraicGeometry.Space.formallyUnramified_iff_isZero_sheafOfDifferentials'`: a morphism of
  algebraic spaces is formally unramified if and only if its sheaf of differentials vanishes.

## References

* [Stacks Project, Tag 04CS](https://stacks.math.columbia.edu/tag/04CS)
* [Stacks Project, Tag 04CT](https://stacks.math.columbia.edu/tag/04CT)
* [Stacks Project, Tag 04CU](https://stacks.math.columbia.edu/tag/04CU)
* [Stacks Project, Tag 04BX](https://stacks.math.columbia.edu/tag/04BX)
* [Stacks Project, Tag 04G9](https://stacks.math.columbia.edu/tag/04G9)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {T R : Scheme.{u}} (φ : T ⟶ R)

/-- Composing `relativeDifferentialsMap` with the isomorphism `pullbackCongr` of an equality
`f₁ = f₂` gives the `relativeDifferentialsMap` of `f₁`. -/
theorem pullbackCongr_hom_app_comp_relativeDifferentialsMap {X X' S S' : Scheme.{u}}
    {f₁ f₂ : X' ⟶ X} (h : f₁ = f₂) (p : X ⟶ S) (p' : X' ⟶ S') (g : S' ⟶ S)
    (h₁ : f₁ ≫ p = p' ≫ g) (h₂ : f₂ ≫ p = p' ≫ g) :
    (Scheme.Modules.pullbackCongr h).hom.app (relativeDifferentials p) ≫
        relativeDifferentialsMap f₂ p p' g h₂ = relativeDifferentialsMap f₁ p p' g h₁ := by
  subst h
  simp [Scheme.Modules.pullbackCongr]

/-- The comparison `Z.hom^*Ω_{T/R} ⟶ Ω_{Z/R}` for a scheme `Z` over `T`. -/
noncomputable abbrev overDifferentialsComparison (Z : Over T) :
    (Scheme.Modules.pullback Z.hom).obj (relativeDifferentials φ) ⟶
      relativeDifferentials (Z.hom ≫ φ) :=
  relativeDifferentialsMap Z.hom φ (Z.hom ≫ φ) (𝟙 R) (Category.comp_id _).symm

/-- The comparison `Z.hom^*Ω_{T/R} ⟶ Ω_{Z/R}` is natural in the scheme `Z` over `T`. -/
theorem overDifferentialsComparison_naturality {Z Z' : Over T} (g : Z' ⟶ Z) :
    (Scheme.Modules.pullbackComp g.left Z.hom).hom.app (relativeDifferentials φ) ≫
        (Scheme.Modules.pullbackCongr (Over.w g)).hom.app (relativeDifferentials φ) ≫
          overDifferentialsComparison φ Z' =
      (Scheme.Modules.pullback g.left).map (overDifferentialsComparison φ Z) ≫
        relativeDifferentialsMap g.left (Z.hom ≫ φ) (Z'.hom ≫ φ) (𝟙 R)
          (by rw [← Over.w g]; simp) := by
  rw [pullbackCongr_hom_app_comp_relativeDifferentialsMap (Over.w g) φ (Z'.hom ≫ φ) (𝟙 R)
      (by simp),
    relativeDifferentialsMap_pullbackComp Z.hom g.left φ (Z.hom ≫ φ) (Z'.hom ≫ φ) (𝟙 R) (𝟙 R)
      (𝟙 R) (Category.comp_id _).symm (by rw [← Over.w g]; simp) (by simp),
    Iso.hom_inv_id_app_assoc]

/-- The naturality of `overDifferentialsComparison`, transposed along the adjunction between
pullback and pushforward along `g.left`. -/
theorem unit_comp_pushforward_map_overDifferentialsComparison {Z Z' : Over T} (g : Z' ⟶ Z) :
    (Scheme.Modules.pullbackPushforwardAdjunction g.left).unit.app
        ((Scheme.Modules.pullback Z.hom).obj (relativeDifferentials φ)) ≫
      (Scheme.Modules.pushforward g.left).map
        (((Scheme.Modules.pullbackComp g.left Z.hom).hom.app (relativeDifferentials φ) ≫
          (Scheme.Modules.pullbackCongr (Over.w g)).hom.app (relativeDifferentials φ)) ≫
            overDifferentialsComparison φ Z') =
      overDifferentialsComparison φ Z ≫
        (Scheme.Modules.pullbackPushforwardAdjunction g.left).homEquiv _ _
          (relativeDifferentialsMap g.left (Z.hom ≫ φ) (Z'.hom ≫ φ) (𝟙 R)
            (by rw [← Over.w g]; simp)) := by
  refine (Adjunction.homEquiv_unit _ _ _ _).symm.trans ?_
  rw [← Adjunction.homEquiv_naturality_left, Category.assoc,
    overDifferentialsComparison_naturality]
  rfl

/-- On global sections, `overDifferentialsComparison` sends the pullback of a section along `g`
to the image under `relativeDifferentialsMap` of its comparison. -/
theorem overDifferentialsComparison_app_pullbackSectionsMap {Z Z' : Over T} (g : Z' ⟶ Z)
    (s : Γ((Scheme.Modules.pullback Z.hom).obj (relativeDifferentials φ), ⊤)) :
    (overDifferentialsComparison φ Z').app ⊤
        (pullbackSectionsMap (relativeDifferentials φ) g s) =
      (relativeDifferentials (Z'.hom ≫ φ)).presheaf.map
        (eqToHom (show (⊤ : Z'.left.Opens) = g.left ⁻¹ᵁ ⊤ by simp)).op
        ((((Scheme.Modules.pullbackPushforwardAdjunction g.left).homEquiv _ _
          (relativeDifferentialsMap g.left (Z.hom ≫ φ) (Z'.hom ≫ φ) (𝟙 R)
            (by rw [← Over.w g]; simp))).app ⊤) ((overDifferentialsComparison φ Z).app ⊤ s)) := by
  exact (PresheafOfModules.naturality_apply (overDifferentialsComparison φ Z').val _ _).trans
    (congrArg _ (congrArg (fun k => (k.app ⊤) s)
      (unit_comp_pushforward_map_overDifferentialsComparison φ g)))

/-- Restriction of a global section along an `eqToHom` between `⊤` and `⊤` is the identity. -/
theorem presheaf_map_eqToHom_top_apply {X : Scheme.{u}} (h : (⊤ : X.Opens) = ⊤)
    (y : Γ(X, ⊤)) : X.presheaf.map (eqToHom h).op y = y := by
  simp

section Etale

variable (Z : Over T) [Etale Z.hom]

/-- For `Z` étale over `T`, the comparison `Z.hom^*Ω_{T/R} ⟶ Ω_{Z/R}` is an isomorphism. -/
instance isIso_overDifferentialsComparison : IsIso (overDifferentialsComparison φ Z) :=
  isIso_relativeDifferentialsMap_of_comp Z.hom φ

/-- The universal derivation of `Z ⟶ R`, read in `Γ(Z, Z.hom^*Ω_{T/R})` through the comparison
isomorphism of Stacks 04BX. -/
noncomputable def overEtaleDifferential (a : Γ(Z.left, ⊤)) :
    Γ((Scheme.Modules.pullback Z.hom).obj (relativeDifferentials φ), ⊤) :=
  (inv (overDifferentialsComparison φ Z)).app ⊤
    ((universalRelativeDerivation (Z.hom ≫ φ)).d (X := op ⊤) a)

/-- The comparison isomorphism sends `overEtaleDifferential φ Z a` to the differential `d a` in
`Γ(Z, Ω_{Z/R})`. -/
theorem overDifferentialsComparison_app_overEtaleDifferential (a : Γ(Z.left, ⊤)) :
    (overDifferentialsComparison φ Z).app ⊤ (overEtaleDifferential φ Z a) =
      (universalRelativeDerivation (Z.hom ≫ φ)).d (X := op ⊤) a := by
  unfold overEtaleDifferential
  show ((inv (overDifferentialsComparison φ Z) ≫ overDifferentialsComparison φ Z).app ⊤) _ = _
  simp only [IsIso.inv_hom_id]
  rfl

/-- For `Z` étale over `T`, the comparison isomorphism is injective on sections over any open. -/
private theorem overDifferentialsComparison_app_injective_open (A : Z.left.Opens) :
    Function.Injective ((overDifferentialsComparison φ Z).app A) := by
  intro x y h
  have h' := congrArg ((inv (overDifferentialsComparison φ Z)).app A) h
  change ((overDifferentialsComparison φ Z ≫ inv (overDifferentialsComparison φ Z)).app _) x =
    ((overDifferentialsComparison φ Z ≫ inv (overDifferentialsComparison φ Z)).app _) y at h'
  simp only [IsIso.hom_inv_id] at h'
  exact h'

/-- For `Z` étale over `T`, the comparison isomorphism is injective on global sections. -/
theorem overDifferentialsComparison_app_injective :
    Function.Injective ((overDifferentialsComparison φ Z).app ⊤) :=
  overDifferentialsComparison_app_injective_open φ Z ⊤

/-- `overEtaleDifferential` commutes with pullback of sections along a morphism of étale schemes
over `T`. -/
theorem pullbackSectionsMap_overEtaleDifferential {Z' : Over T} [Etale Z'.hom] (g : Z' ⟶ Z)
    (a : Γ(Z.left, ⊤)) :
    pullbackSectionsMap (relativeDifferentials φ) g (overEtaleDifferential φ Z a) =
      overEtaleDifferential φ Z' (g.left.appTop a) := by
  apply overDifferentialsComparison_app_injective φ Z'
  rw [overDifferentialsComparison_app_pullbackSectionsMap,
    overDifferentialsComparison_app_overEtaleDifferential,
    overDifferentialsComparison_app_overEtaleDifferential]
  have hd := relativeDifferentialsMap_app_d (f := g.left) (p := Z.hom ≫ φ) (p' := Z'.hom ≫ φ)
    (𝟙 R) (by rw [← Over.w g]; simp) ⊤ a
  refine (congrArg _ hd).trans ?_
  refine ((universalRelativeDerivation (Z'.hom ≫ φ)).d_map _ _).symm.trans ?_
  congr 1
  exact presheaf_map_eqToHom_top_apply _ _

/-- `overEtaleDifferential φ Z` vanishes on functions pulled back along `k : Z ⟶ Y'` from a scheme
`Y'` étale over `R` with `k ≫ v = Z.hom ≫ φ`. -/
theorem overEtaleDifferential_appTop_eq_zero {Y' : Scheme.{u}} (k : Z.left ⟶ Y') (v : Y' ⟶ R)
    [Etale v] (hk : k ≫ v = Z.hom ≫ φ) (b : Γ(Y', ⊤)) :
    overEtaleDifferential φ Z (k.appTop b) = 0 := by
  apply overDifferentialsComparison_app_injective φ Z
  rw [overDifferentialsComparison_app_overEtaleDifferential, map_zero]
  have hd := relativeDifferentialsMap_app_d (f := k) (p := v) (p' := Z.hom ≫ φ)
    (𝟙 R) (by rw [hk]; simp) ⊤ b
  have hz : IsZero ((relativeDifferentials v).val.obj (op ⊤)) :=
    Functor.map_isZero (PresheafOfModules.evaluation _ (op ⊤))
      (Functor.map_isZero (SheafOfModules.forget _)
        (isZero_relativeDifferentials_of_formallyUnramified v))
  have h0 : (universalRelativeDerivation v).d (X := op ⊤) b = 0 :=
    (ModuleCat.isZero_iff_subsingleton.mp hz).elim _ _
  rw [h0, map_zero] at hd
  exact hd.symm

/-- Let `Z` be étale over `T` with `Z.hom ⁻¹ᵁ A = ⊤`, such that the adjunction unit is injective
on sections of `Ω_{T/R}` over `A`. If `overEtaleDifferential φ Z` vanishes, then the universal
derivation of `φ` vanishes on `Γ(T, A)`. -/
theorem universalRelativeDerivation_d_eq_zero_of_overEtaleDifferential (A : T.Opens)
    (h1 : Z.hom ⁻¹ᵁ A = ⊤)
    (h2 : Function.Injective
      (((Scheme.Modules.pullbackPushforwardAdjunction Z.hom).unit.app
        (relativeDifferentials φ)).app A))
    (hD : ∀ a : Γ(Z.left, ⊤), overEtaleDifferential φ Z a = 0) (a : Γ(T, A)) :
    (universalRelativeDerivation φ).d (X := op A) a = 0 := by
  have htop : ∀ y : Γ(Z.left, ⊤),
      (universalRelativeDerivation (Z.hom ≫ φ)).d (X := op ⊤) y = 0 := fun y =>
    (overDifferentialsComparison_app_overEtaleDifferential φ Z y).symm.trans
      ((congrArg _ (hD y)).trans (map_zero _))
  have hx : (universalRelativeDerivation (Z.hom ≫ φ)).d (X := op (Z.hom ⁻¹ᵁ A))
      ((Z.hom.app A).hom a) = 0 := by
    set x := (Z.hom.app A).hom a
    have hxy : x = Z.left.presheaf.map (eqToHom h1).op
        (Z.left.presheaf.map (eqToHom h1.symm).op x) := by
      rw [← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp, ← op_comp,
        eqToHom_trans, eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
      rfl
    rw [hxy]
    refine ((universalRelativeDerivation (Z.hom ≫ φ)).d_map (eqToHom h1).op _).trans ?_
    rw [htop]
    exact map_zero _
  have hd := relativeDifferentialsMap_app_d (f := Z.hom) (p := φ) (p' := Z.hom ≫ φ)
    (𝟙 R) (Category.comp_id _).symm A a
  rw [hx] at hd
  exact h2 (overDifferentialsComparison_app_injective_open φ Z _
    (hd.trans ((congrArg _ (map_zero _)).trans (map_zero _)).symm))

end Etale

/-- A morphism of schemes whose universal derivation vanishes on every section over every open
has a zero sheaf of relative differentials. -/
theorem isZero_relativeDifferentials_of_d_eq_zero
    (h : ∀ (A : T.Opens) (a : Γ(T, A)), (universalRelativeDerivation φ).d (X := op A) a = 0) :
    IsZero (relativeDifferentials φ) := by
  refine (formallyUnramified_iff_isZero_relativeDifferentials φ).mp
    ⟨fun {V} hV {A} hA hAV ↦ ?_⟩
  let : Algebra Γ(R, V) Γ(T, A) := (φ.appLE V A hAV).hom.toAlgebra
  rw [show (φ.appLE V A hAV).hom = algebraMap Γ(R, V) Γ(T, A) from rfl,
    RingHom.formallyUnramified_algebraMap, Algebra.formallyUnramified_iff]
  show Subsingleton (CommRingCat.KaehlerDifferential (φ.appLE V A hAV))
  obtain ⟨e, he, -⟩ :=
    Stacks.AlgebraicGeometry.AffineDifferentialsIso.existsUnique_affineDifferentialsIso
      φ hA hAV hV
  refine ⟨fun x y => ?_⟩
  have hd : ∀ a : Γ(T, A), CommRingCat.KaehlerDifferential.d (f := φ.appLE V A hAV) a = 0 :=
    fun a => by rw [← he a, h A a]; exact map_zero _
  have hid : 𝟙 (CommRingCat.KaehlerDifferential (φ.appLE V A hAV)) = 0 :=
    CommRingCat.KaehlerDifferential.ext fun b => by
      rw [hd b]; exact (map_zero _).trans (map_zero _).symm
  have hall : ∀ z : CommRingCat.KaehlerDifferential (φ.appLE V A hAV), z = 0 := fun z =>
    congrArg (fun g : CommRingCat.KaehlerDifferential (φ.appLE V A hAV) ⟶
      CommRingCat.KaehlerDifferential (φ.appLE V A hAV) => g.hom z) hid
  rw [hall x, hall y]

end AlgebraicGeometry.Scheme.Hom

namespace PresheafOfModules

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] (F : C ⥤ D)
  {R : Dᵒᵖ ⥤ CommRingCat.{u}}
  (M : PresheafOfModules.{u} (R ⋙ forget₂ CommRingCat RingCat))
  {S₀ S' : Cᵒᵖ ⥤ CommRingCat.{u}}
  (φ : S₀ ⋙ forget₂ CommRingCat RingCat ⟶ F.op ⋙ R ⋙ forget₂ CommRingCat RingCat)
  (ψ' : S' ⟶ S₀)

/-- A derivation-like family of additive maps on `D`, carried along the pushforward of modules
by `F` to a derivation on `C`. -/
noncomputable def derivationOfPushforward
    (d : ∀ X : Dᵒᵖ, R.obj X →+ M.obj X)
    (d_mul : ∀ (X : Dᵒᵖ) (a b : R.obj X), d X (a * b) = a • d X b + b • d X a)
    (d_map : ∀ {X Y : Dᵒᵖ} (f : X ⟶ Y) (a : R.obj X), d Y (R.map f a) = M.map f (d X a))
    (d_app : ∀ (X : Cᵒᵖ) (s : S'.obj X), d (F.op.obj X) (φ.app X (ψ'.app X s)) = 0) :
    ((PresheafOfModules.pushforward φ).obj M).Derivation' ψ' where
  d {X} := (d (F.op.obj X)).comp (φ.app X).hom.toAddMonoidHom
  d_mul {X} a b := by
    change d (F.op.obj X) (φ.app X (a * b)) = φ.app X a • d (F.op.obj X) (φ.app X b) +
      φ.app X b • d (F.op.obj X) (φ.app X a)
    rw [map_mul]
    exact d_mul _ _ _
  d_map {X Y} f a := by
    change d (F.op.obj Y) (φ.app Y (S₀.map f a)) = M.map (F.op.map f) (d (F.op.obj X) (φ.app X a))
    rw [← d_map]
    congr 1
    exact congrArg (fun g => g.hom a) (φ.naturality f)
  d_app {X} s := d_app X s

/-- The compatibility of a family of additive maps `d` with restriction on `D` gives its
compatibility with restriction in the pushforward of `M` along `F`. -/
theorem derivationOfPushforward_map
    (d : ∀ X : Dᵒᵖ, R.obj X →+ M.obj X)
    (d_map : ∀ {X Y : Dᵒᵖ} (f : X ⟶ Y) (a : R.obj X), d Y (R.map f a) = M.map f (d X a))
    {X Y : Cᵒᵖ} (f : X ⟶ Y) (a : S₀.obj X) :
    d (F.op.obj Y) (φ.app Y (S₀.map f a)) =
      ((PresheafOfModules.pushforward φ).obj M).map f (d (F.op.obj X) (φ.app X a)) := by
  show d (F.op.obj Y) (φ.app Y (S₀.map f a)) = M.map (F.op.map f) (d (F.op.obj X) (φ.app X a))
  rw [← d_map]
  congr 1
  exact congrArg (fun g => g.hom a) (φ.naturality f)

/-- The pushforward of a sheaf of modules along a continuous functor is a sheaf. -/
theorem isSheaf_pushforward_presheaf (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    [F.IsContinuous J K] (hM : Presheaf.IsSheaf K M.presheaf) :
    Presheaf.IsSheaf J ((PresheafOfModules.pushforward φ).obj M).presheaf :=
  F.op_comp_isSheaf J K ⟨_, hM⟩

end PresheafOfModules

/-- The restriction maps of `moduleSheaf R G` are those of `G`. -/
theorem CategoryTheory.Sheaf.moduleSheaf_obj_map_apply.{v₁, u₁} {C : Type u₁} [Category.{v₁} C]
    {J : GrothendieckTopology C} [J.HasSheafCompose (forget AddCommGrpCat.{u})]
    (R : Sheaf J RingCat.{u}) (G : SheafOfModules.{u} R) {X Y : Cᵒᵖ} (g : X ⟶ Y)
    (x : G.val.obj X) :
    (CategoryTheory.Sheaf.moduleSheaf.{u, v₁, u₁} R G).obj.map g x = G.val.map g x := rfl

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable {U V : BigFppfOver B S hS} (ψ : U ⟶ V)

/-- The sheaf of modules `W ↦ Γ(W, W.hom^*Ω_{U/V})` on the small étale site of the scheme. -/
noncomputable def schemeSmallEtaleDifferentials :
    SheafOfModules.{u} (_root_.AlgebraicGeometry.SmallEtale.structureSheaf
      (associatedBigEtaleSite B) ((BigFppfOver.toScheme B S hS).obj U) U.left.property) where
  val := _root_.AlgebraicGeometry.SmallEtale.sectionsPresheafOfModules _ _ _
    (Scheme.Hom.relativeDifferentials ((BigFppfOver.toScheme B S hS).map ψ))
  isSheaf := _root_.AlgebraicGeometry.SmallEtale.isSheaf_sectionsPresheafOfModules _ _ _ _

/-- `overEtaleDifferential φ Z` is additive. -/
theorem overEtaleDifferential_add {T R : Scheme.{u}} (φ : T ⟶ R) (Z : Over T) [Etale Z.hom]
    (a b : Γ(Z.left, ⊤)) :
    Scheme.Hom.overEtaleDifferential φ Z (a + b) =
      Scheme.Hom.overEtaleDifferential φ Z a + Scheme.Hom.overEtaleDifferential φ Z b := by
  unfold Scheme.Hom.overEtaleDifferential
  exact (congrArg _ (map_add (Scheme.Hom.universalRelativeDerivation (Z.hom ≫ φ)).d a b)).trans
    (map_add _ _ _)

/-- `overEtaleDifferential φ Z` satisfies the Leibniz rule. -/
theorem overEtaleDifferential_mul {T R : Scheme.{u}} (φ : T ⟶ R) (Z : Over T) [Etale Z.hom]
    (a b : Γ(Z.left, ⊤)) :
    Scheme.Hom.overEtaleDifferential φ Z (a * b) =
      a • Scheme.Hom.overEtaleDifferential φ Z b + b • Scheme.Hom.overEtaleDifferential φ Z a := by
  unfold Scheme.Hom.overEtaleDifferential
  refine (congrArg _ ((Scheme.Hom.universalRelativeDerivation (Z.hom ≫ φ)).d_mul a b)).trans ?_
  refine (map_add _ _ _).trans ?_
  exact congrArg₂ (· + ·) (Scheme.Modules.Hom.app_smul _ _ _)
    (Scheme.Modules.Hom.app_smul _ _ _)

/-- The small étale site of `U` read as the small étale site of the algebraic space it
represents, sent to schemes over the scheme underlying `U`. -/
noncomputable abbrev representedToOver :
    SmallEtale B S hS (yoneda.obj U) ⥤ Over ((BigFppfOver.toScheme B S hS).obj U) :=
  (representedSmallEtaleEquivalence B S hS U).functor ⋙
    _root_.AlgebraicGeometry.SmallEtale.toOver (associatedBigEtaleSite B) _ U.left.property

/-- The image of an object of the small étale site of `yoneda.obj U` under `representedToOver`
is étale over the scheme underlying `U`. -/
instance etale_representedToOver_hom (W : SmallEtale B S hS (yoneda.obj U)) :
    Etale ((representedToOver B S hS (U := U)).obj W).hom :=
  ((representedSmallEtaleEquivalence B S hS U).functor.obj W).property

section RelativeVanishing

open CategoryTheory.Sheaf

variable {X Y : AlgebraicSpaces B S hS}

/-- The projection `chartProjection` agrees with the corresponding leg of the limit cone of the
right Kan extension along `comparisonFunctor`. -/
theorem chartProjection_app_apply_general (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (j : StructuredArrow (op (chartBaseChange B S hS f V)) (comparisonFunctor B S hS X).op)
    (E : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (a : ((comparisonFunctor B S hS X).op.ran.obj E.obj).obj
      (op (chartBaseChange B S hS f V))) :
    (chartProjection B S hS f V j).app E a =
      ((Functor.RightExtension.mk _ ((comparisonFunctor B S hS X).op.ranCounit.app E.obj)).coneAt
        (op (chartBaseChange B S hS f V))).π.app j a := by
  have h : (((comparisonFunctor B S hS X).sheafAdjunctionCocontinuous (Type u)
        (SmallEtale.topology B S hS X.1) (SpacesEtale.topology B S hS X)).counit.app E).hom =
      (comparisonFunctor B S hS X).op.ranCounit.app E.obj := by
    rw [Functor.sheafAdjunctionCocontinuous_counit_app_hom, Functor.ranAdjunction_counit]
  show (((comparisonFunctor B S hS X).sheafAdjunctionCocontinuous (Type u)
        (SmallEtale.topology B S hS X.1) (SpacesEtale.topology B S hS X)).counit.app E).hom.app
      j.right (((comparisonFunctor B S hS X).op.ran.obj E.obj).map j.hom a) = _
  rw [h]
  rfl

/-- Two sections over `chartBaseChange f V` of the right Kan extension of a sheaf `E` along
`comparisonFunctor` are equal if all their projections `chartProjection` agree. -/
theorem chartProjection_ext_general (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    {E : Sheaf (SmallEtale.topology B S hS X.1) (Type u)}
    {a b : ((comparisonFunctor B S hS X).op.ran.obj E.obj).obj
      (op (chartBaseChange B S hS f V))}
    (h : ∀ j, (chartProjection B S hS f V j).app E a = (chartProjection B S hS f V j).app E b) :
    a = b := by
  refine (Types.isLimitEquivSections
    ((comparisonFunctor B S hS X).op.isPointwiseRightKanExtensionRanCounit E.obj
      (op (chartBaseChange B S hS f V)))).injective (Subtype.ext (funext fun j ↦ ?_))
  exact (chartProjection_app_apply_general B S hS f V j E a).symm.trans
    ((h j).trans (chartProjection_app_apply_general B S hS f V j E b))

end RelativeVanishing

/-- The scheme small étale site of the scheme underlying `U`, sent to schemes over it. -/
noncomputable abbrev schemeToOver :
    _root_.AlgebraicGeometry.SmallEtale (associatedBigEtaleSite B)
        ((BigFppfOver.toScheme B S hS).obj U) U.left.property ⥤
      Over ((BigFppfOver.toScheme B S hS).obj U) :=
  _root_.AlgebraicGeometry.SmallEtale.toOver (associatedBigEtaleSite B) _ U.left.property

/-- The image of an object of the scheme small étale site under `schemeToOver` is étale. -/
instance etale_schemeToOver_hom (Z : _root_.AlgebraicGeometry.SmallEtale
    (associatedBigEtaleSite B) ((BigFppfOver.toScheme B S hS).obj U) U.left.property) :
    Etale ((schemeToOver B S hS (U := U)).obj Z).hom :=
  Z.property

/-- The étale-differential on the scheme small étale site, as additive maps. -/
noncomputable def schemeEtaleDifferential
    (Z : (_root_.AlgebraicGeometry.SmallEtale (associatedBigEtaleSite B)
      ((BigFppfOver.toScheme B S hS).obj U) U.left.property)ᵒᵖ) :
    ((schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ).obj Z →+
      (schemeSmallEtaleDifferentials B S hS ψ).val.obj Z :=
  AddMonoidHom.mk' (fun a => @Scheme.Hom.overEtaleDifferential _ _
      ((BigFppfOver.toScheme B S hS).map ψ) ((schemeToOver B S hS).obj Z.unop)
      (etale_schemeToOver_hom B S hS Z.unop) a)
    (@overEtaleDifferential_add _ _ _ _ (etale_schemeToOver_hom B S hS Z.unop))

/-- The structure sheaf of `yoneda.obj U` is that of the scheme site, read along the
equivalence. -/
noncomputable abbrev representedStructureHom :
    structurePresheaf B S hS (yoneda.obj U) ⋙ forget₂ CommRingCat RingCat ⟶
      (representedSmallEtaleEquivalence B S hS U).functor.op ⋙
        ((schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ) ⋙ forget₂ CommRingCat RingCat :=
  (representedStructureMap B S hS U).hom

/-- `schemeEtaleDifferential` commutes with the restriction maps of the scheme small étale
site. -/
theorem schemeEtaleDifferential_map
    {Z Z' : (_root_.AlgebraicGeometry.SmallEtale (associatedBigEtaleSite B)
      ((BigFppfOver.toScheme B S hS).obj U) U.left.property)ᵒᵖ} (f : Z ⟶ Z')
    (a : ((schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ).obj Z) :
    schemeEtaleDifferential B S hS ψ Z'
        (((schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ).map f a) =
      (schemeSmallEtaleDifferentials B S hS ψ).val.map f (schemeEtaleDifferential B S hS ψ Z a) :=
  (@Scheme.Hom.pullbackSectionsMap_overEtaleDifferential _ _ _ _
      (etale_schemeToOver_hom B S hS Z.unop) _ (etale_schemeToOver_hom B S hS Z'.unop)
      ((schemeToOver B S hS).map f.unop) a).symm

/-- In the big fppf category over `S`, `yoneda.map (yonedaEquiv g) = g`. -/
theorem yoneda_map_yonedaEquiv_bigFppf {A A' : BigFppfOver B S hS}
    (g : yoneda.obj A ⟶ yoneda.obj A') : yoneda.map (yonedaEquiv g) = g := by
  apply yonedaEquiv.injective
  rw [yonedaEquiv_yoneda_map]

/-- **The étale differential kills the functions pulled back from the étale charts of `V`.** -/
theorem schemeEtaleDifferential_chartPullback (V' : SmallEtale B S hS (yoneda.obj V))
    (j : StructuredArrow (op (chartBaseChange B S hS (schemeSpaceMap ψ) V'))
      (comparisonFunctor B S hS (schemeSpace U)).op)
    (b : (structureSetSheaf B S hS (schemeSpace V)).obj.obj (op V')) :
    schemeEtaleDifferential B S hS ψ
      ((representedSmallEtaleEquivalence B S hS U).functor.op.obj j.right)
      (chartPullback B S hS (schemeSpaceMap ψ) V' j b) = 0 := by
  have hc := chartBaseChangeMap_comm B S hS (schemeSpaceMap ψ) j.right.unop V' j.hom.unop
  have hk : chartBaseChangeMap B S hS (schemeSpaceMap ψ) V' j ≫ yonedaEquiv V'.1.hom =
      yonedaEquiv j.right.unop.1.hom ≫ ψ := by
    apply yoneda.map_injective
    exact ((yoneda.map_comp _ _).trans ((congrArg₂ (· ≫ ·) rfl
      (yoneda_map_yonedaEquiv_bigFppf B S hS _)).trans (hc.symm.trans (congrArg₂ (· ≫ ·)
        (yoneda_map_yonedaEquiv_bigFppf B S hS _).symm rfl)))).trans (yoneda.map_comp _ _).symm
  exact @Scheme.Hom.overEtaleDifferential_appTop_eq_zero _ _ ((BigFppfOver.toScheme B S hS).map ψ)
    ((representedToOver B S hS).obj j.right.unop) (etale_representedToOver_hom B S hS _) _
    ((BigFppfOver.toScheme B S hS).map (chartBaseChangeMap B S hS (schemeSpaceMap ψ) V' j))
    ((BigFppfOver.toScheme B S hS).map (yonedaEquiv V'.1.hom))
    (etale_representedToOver_hom B S hS (U := V) V')
    (((BigFppfOver.toScheme B S hS).map_comp _ _).symm.trans ((congrArg _ hk).trans
      ((BigFppfOver.toScheme B S hS).map_comp _ _))) b

/-- The presheaf of `Ω_{U/V}`-sections on the small étale site of the algebraic space `U`. -/
noncomputable abbrev schemeSpaceDifferentialsPresheaf :=
  (PresheafOfModules.pushforward (F := (representedSmallEtaleEquivalence B S hS U).functor)
    (R := ((schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ) ⋙ forget₂ CommRingCat RingCat)
    (S := structurePresheaf B S hS (yoneda.obj U) ⋙ forget₂ CommRingCat RingCat)
    (representedStructureHom B S hS (U := U))).obj (schemeSmallEtaleDifferentials B S hS ψ).val

/-- The module of `Ω_{U/V}`-sections on the small étale site of the algebraic space `U`. -/
noncomputable def schemeSpaceDifferentialsModule :
    SheafOfModules.{u} (ringStructureSheaf B S hS (yoneda.obj U)) where
  val := schemeSpaceDifferentialsPresheaf B S hS ψ
  isSheaf := PresheafOfModules.isSheaf_pushforward_presheaf _ _ _
    (SmallEtale.topology B S hS (yoneda.obj U))
    (_root_.AlgebraicGeometry.SmallEtale.topology (associatedBigEtaleSite B)
      ((BigFppfOver.toScheme B S hS).obj U) U.left.property)
    (schemeSmallEtaleDifferentials B S hS ψ).isSheaf

/-- The étale differential on the sections of `𝒪` over an étale chart of `U`. -/
noncomputable def schemeSpaceDifferentialFun (W : (SmallEtale B S hS (yoneda.obj U))ᵒᵖ)
    (a : (structureSetSheaf B S hS (schemeSpace U)).obj.obj W) :
    (CategoryTheory.Sheaf.moduleSheaf.{u, u, u + 1} (ringStructureSheaf B S hS (yoneda.obj U))
        (schemeSpaceDifferentialsModule B S hS ψ)).obj.obj W :=
  schemeEtaleDifferential B S hS ψ ((representedSmallEtaleEquivalence B S hS U).functor.op.obj W)
    ((representedStructureHom B S hS (U := U)).app W a)

/-- The restriction maps of `structureSetSheaf` of `schemeSpace U` are those of
`structurePresheaf` of `yoneda.obj U`. -/
theorem structureSetSheaf_schemeSpace_map_apply {W W' : (SmallEtale B S hS (yoneda.obj U))ᵒᵖ}
    (g : W ⟶ W') (a : (structureSetSheaf B S hS (schemeSpace U)).obj.obj W) :
    (structureSetSheaf B S hS (schemeSpace U)).obj.map g a =
      (structurePresheaf B S hS (yoneda.obj U)).map g a := rfl

/-- `schemeSpaceDifferentialFun` commutes with restriction along morphisms of the small étale
site of `yoneda.obj U`. -/
theorem schemeSpaceDifferentialFun_naturality {W W' : (SmallEtale B S hS (yoneda.obj U))ᵒᵖ}
    (g : W ⟶ W') (a : (structureSetSheaf B S hS (schemeSpace U)).obj.obj W) :
    (CategoryTheory.Sheaf.moduleSheaf.{u, u, u + 1} (ringStructureSheaf B S hS (yoneda.obj U))
        (schemeSpaceDifferentialsModule B S hS ψ)).obj.map g
        (schemeSpaceDifferentialFun B S hS ψ W a) =
      schemeSpaceDifferentialFun B S hS ψ W'
        ((structureSetSheaf B S hS (schemeSpace U)).obj.map g a) := by
  show (schemeSpaceDifferentialsPresheaf B S hS ψ).map g
    (schemeSpaceDifferentialFun B S hS ψ W a) = _
  have key := PresheafOfModules.derivationOfPushforward_map
      (representedSmallEtaleEquivalence B S hS U).functor
      (R := (schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ)
      (S₀ := structurePresheaf B S hS (yoneda.obj U))
      (schemeSmallEtaleDifferentials B S hS ψ).val (representedStructureHom B S hS)
      (schemeEtaleDifferential B S hS ψ)
      (fun f a => schemeEtaleDifferential_map B S hS ψ f a) g a
  rw [structureSetSheaf_schemeSpace_map_apply]
  unfold schemeSpaceDifferentialFun
  refine Eq.trans ?_ key.symm
  with_reducible_and_instances rfl

/-- The étale differential, as a morphism from the sheaf of sets underlying `𝒪` to that
underlying the module of `Ω_{U/V}`-sections. -/
noncomputable def schemeSpaceDifferentialHom :
    structureSetSheaf B S hS (schemeSpace U) ⟶
      CategoryTheory.Sheaf.moduleSheaf.{u, u, u + 1} (ringStructureSheaf B S hS (yoneda.obj U))
        (schemeSpaceDifferentialsModule B S hS ψ) :=
  CategoryTheory.Sheaf.unaryOpHom (A := structureSetSheaf B S hS (schemeSpace U))
    (E := CategoryTheory.Sheaf.moduleSheaf.{u, u, u + 1}
      (ringStructureSheaf B S hS (yoneda.obj U)) (schemeSpaceDifferentialsModule B S hS ψ))
    (schemeSpaceDifferentialFun B S hS ψ) (schemeSpaceDifferentialFun_naturality B S hS ψ)

/-- The zero derivation morphism vanishes on every section over any chart. -/
private theorem sectionsFunctor_map_zeroDerivationHom_apply
    (W : (SmallEtale B S hS (yoneda.obj U))ᵒᵖ)
    (x : (structureSetSheaf B S hS (schemeSpace U)).obj.obj W) :
    (Sheaf.sectionsFunctor.{u} (SmallEtale.topology B S hS (yoneda.obj U)) W).map
        (zeroDerivationHom (ringStructureSheaf B S hS (yoneda.obj U))
          (schemeSpaceDifferentialsModule B S hS ψ)) x = 0 :=
  (map_zeroDerivationHom (ringStructureSheaf B S hS (yoneda.obj U))
    (schemeSpaceDifferentialsModule B S hS ψ)
    (Sheaf.sectionsFunctor.{u} (SmallEtale.topology B S hS (yoneda.obj U)) W) x).trans
    (Sheaf.sectionsFunctor_map_moduleZeroHom (J := SmallEtale.topology B S hS (yoneda.obj U))
      (ringStructureSheaf B S hS (yoneda.obj U)) (schemeSpaceDifferentialsModule B S hS ψ) W _)

open CategoryTheory.Sheaf in
/-- On a section where the étale differential vanishes, the étale differential and the zero
morphism agree. -/
theorem schemeSpaceDifferentialHom_eq_zeroDerivationHom_of
    (W : (SmallEtale B S hS (yoneda.obj U))ᵒᵖ)
    (x : (structureSetSheaf B S hS (schemeSpace U)).obj.obj W)
    (hx : schemeEtaleDifferential B S hS ψ
      ((representedSmallEtaleEquivalence B S hS U).functor.op.obj W)
      ((representedStructureHom B S hS (U := U)).app W x) = 0) :
    (sectionsFunctor.{u} (SmallEtale.topology B S hS (yoneda.obj U)) W).map
        (schemeSpaceDifferentialHom B S hS ψ) x =
      (sectionsFunctor.{u} (SmallEtale.topology B S hS (yoneda.obj U)) W).map
        (zeroDerivationHom (ringStructureSheaf B S hS (yoneda.obj U))
          (schemeSpaceDifferentialsModule B S hS ψ)) x := by
  refine Eq.trans ?_ (sectionsFunctor_map_zeroDerivationHom_apply B S hS ψ W x).symm
  exact hx

open CategoryTheory.Sheaf in
/-- **The étale differential kills the functions coming from `V`.**  On every étale chart `W`
of `U` the étale differential vanishes on the image of `ψ♯ : ψ⁻¹𝒪_V ⟶ 𝒪_U`. -/
theorem schemeEtaleDifferential_structureSharp
    (W : (SmallEtale B S hS (yoneda.obj U))ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS (schemeSpaceMap ψ)).obj.obj W) :
    schemeEtaleDifferential B S hS ψ
      ((representedSmallEtaleEquivalence B S hS U).functor.op.obj W)
      ((representedStructureHom B S hS (U := U)).app W
        ((structureSharpInverseImage B S hS (schemeSpaceMap ψ)).hom.app W s)) = 0 := by
  have key := structureSharpInverseImageSet_comp_eq_of_chartPullback B S hS (schemeSpaceMap ψ)
    (schemeSpaceDifferentialHom B S hS ψ)
    (zeroDerivationHom (ringStructureSheaf B S hS (yoneda.obj U))
      (schemeSpaceDifferentialsModule B S hS ψ)) (fun V' j b => ?_)
  · set P := sectionsFunctor.{u} (SmallEtale.topology B S hS (yoneda.obj U)) W
    have h := congrArg (fun m => P.map m s) key
    have hc := P.map_comp_apply (structureSharpInverseImageSet B S hS (schemeSpaceMap ψ))
      (zeroDerivationHom (ringStructureSheaf B S hS (yoneda.obj U))
        (schemeSpaceDifferentialsModule B S hS ψ)) s
    have hc2 := P.map_comp_apply (structureSharpInverseImageSet B S hS (schemeSpaceMap ψ))
      (schemeSpaceDifferentialHom B S hS ψ) s
    have hfin := hc2.symm.trans (h.trans (hc.trans
      (sectionsFunctor_map_zeroDerivationHom_apply B S hS ψ W _)))
    exact hfin
  · have e : (representedStructureHom B S hS (U := U)).app j.right
        (chartPullback B S hS (schemeSpaceMap ψ) V' j b) =
        chartPullback B S hS (schemeSpaceMap ψ) V' j b := rfl
    refine schemeSpaceDifferentialHom_eq_zeroDerivationHom_of B S hS ψ j.right _ ?_
    rw [e]
    exact schemeEtaleDifferential_chartPullback B S hS ψ V' j b

/-- **The scheme-level differentials of `ψ`, read on the small étale site of `U`, carry a
derivation relative to `ψ`.**  On an étale chart `W` of `U` it sends a regular function to its
differential in `Γ(W, W.hom^*Ω_{U/V})`, and it kills the functions coming from `V`. -/
noncomputable def schemeSpaceDifferentialsDerivation :
    (schemeSpaceDifferentialsPresheaf B S hS ψ).Derivation'
      (structureSharpInverseImage B S hS (schemeSpaceMap ψ)).hom :=
  PresheafOfModules.derivationOfPushforward (representedSmallEtaleEquivalence B S hS U).functor
    (R := (schemeToOver B S hS ⋙ Over.forget _).op ⋙ Scheme.Γ)
    (S₀ := structurePresheaf B S hS (yoneda.obj U))
    (S' := (inverseImageStructureSheaf B S hS (schemeSpaceMap ψ)).obj)
    (schemeSmallEtaleDifferentials B S hS ψ).val (representedStructureHom B S hS)
    (structureSharpInverseImage B S hS (schemeSpaceMap ψ)).hom
    (schemeEtaleDifferential B S hS ψ)
    (fun Z a b => @overEtaleDifferential_mul _ _ _ _ (etale_schemeToOver_hom B S hS Z.unop) a b)
    (fun {_ _} f a => schemeEtaleDifferential_map B S hS ψ f a)
    (schemeEtaleDifferential_structureSharp B S hS ψ)

/-- If the spaces-level sheaf of differentials of `schemeSpaceMap ψ` vanishes, then
`overEtaleDifferential` vanishes on every étale chart `W` of `U`. -/
theorem schemeSpaceDifferentialsDerivation_d_eq_zero
    (hz : IsZero (sheafOfDifferentials B S hS (schemeSpaceMap ψ)))
    (W : SmallEtale B S hS (yoneda.obj U)) (a : Γ(((representedToOver B S hS).obj W).left, ⊤)) :
    @Scheme.Hom.overEtaleDifferential _ _ ((BigFppfOver.toScheme B S hS).map ψ)
      ((representedToOver B S hS).obj W) (etale_representedToOver_hom B S hS W) a = 0 := by
  obtain ⟨g, hg, -⟩ := universalDerivation_isUniversal B S hS (schemeSpaceMap ψ)
    (schemeSpaceDifferentialsModule B S hS ψ) (schemeSpaceDifferentialsDerivation B S hS ψ)
  have h0 := (isZero_sheafOfDifferentials_iff B S hS (schemeSpaceMap ψ)).mp hz (op W) a
  have h1 := PresheafOfModules.Derivation.congr_d hg (X := op W) a
  refine h1.symm.trans ?_
  refine (PresheafOfModules.Derivation.postcomp_d_apply _ _ _).trans ?_
  exact (congrArg _ h0).trans (map_zero _)

/-- **The vanishing of the spaces-level differentials of a morphism of schemes forces the
vanishing of its scheme-level differentials.** -/
theorem isZero_relativeDifferentials_of_isZero_sheafOfDifferentials_schemeSpaceMap
    (hz : IsZero (sheafOfDifferentials B S hS (schemeSpaceMap ψ))) :
    IsZero (Scheme.Hom.relativeDifferentials ((BigFppfOver.toScheme B S hS).map ψ)) := by
  refine Scheme.Hom.isZero_relativeDifferentials_of_d_eq_zero _ fun A a => ?_
  have hZ : ((representedToOver B S hS).obj (openBaseChart B S hS U A)).hom = A.ι := by
    show (BigFppfOver.toScheme B S hS).map (yonedaEquiv (yoneda.map (openSubHom U A))) = A.ι
    rw [yonedaEquiv_yoneda_map, toScheme_map_openSubHom]
  have h2 : Function.Injective
      (((Scheme.Modules.pullbackPushforwardAdjunction
        ((representedToOver B S hS).obj (openBaseChart B S hS U A)).hom).unit.app
        (Scheme.Hom.relativeDifferentials ((BigFppfOver.toScheme B S hS).map ψ))).app A) := by
    rw [hZ]
    have hi := Scheme.Modules.isIso_unit_app_app_ι
      (Scheme.Hom.relativeDifferentials ((BigFppfOver.toScheme B S hS).map ψ)) A
    exact (ConcreteCategory.bijective_of_isIso (((Scheme.Modules.pullbackPushforwardAdjunction
      A.ι).unit.app
        (Scheme.Hom.relativeDifferentials ((BigFppfOver.toScheme B S hS).map ψ))).app A)).1
  exact @Scheme.Hom.universalRelativeDerivation_d_eq_zero_of_overEtaleDifferential _ _ _ _
    (etale_representedToOver_hom B S hS (openBaseChart B S hS U A)) A
    (by rw [hZ]; exact Scheme.Opens.ι_preimage_self A) h2
    (schemeSpaceDifferentialsDerivation_d_eq_zero B S hS ψ hz _) a

section ChartComparison

variable {X Y : AlgebraicSpaces B S hS}

/-- **The backward half of the chart comparison of Stacks 04G9.** In a commuting square of étale
scheme charts over `f : X ⟶ Y`, if the restriction of `Ω_{X/Y}` to the source chart vanishes then
so does the scheme-level sheaf of relative differentials of the square's scheme morphism `ψ`. -/
theorem sheafOfDifferentialsChartComparisonMp (f : X ⟶ Y) :
    SheafOfDifferentialsChartComparisonMp B S hS f := by
  intro U V a b ψ ha hb _ hdiag hz
  exact isZero_relativeDifferentials_of_isZero_sheafOfDifferentials_schemeSpaceMap B S hS ψ
    (hz.of_iso (sheafOfDifferentialsEtaleLocalizationIso B S hS f
      (ObjectProperty.homMk a : schemeSpace U ⟶ X) (schemeSpaceMap ψ)
      (ObjectProperty.homMk b : schemeSpace V ⟶ Y) (isEtale_of_presheaf_etale B S hS ha)
      (isEtale_of_presheaf_etale B S hS hb) (ObjectProperty.hom_ext _ hdiag.symm)).symm)

/-- A morphism of algebraic spaces over `S` is formally unramified if and only if its sheaf of
differentials vanishes. -/
@[ega "IV 17.2.1" "more general"]
theorem formallyUnramified_iff_isZero_sheafOfDifferentials' (f : X ⟶ Y) :
    FormallyUnramified f.hom ↔ IsZero (sheafOfDifferentials B S hS f) :=
  formallyUnramified_iff_isZero_sheafOfDifferentials_of_mp B S hS f
    (sheafOfDifferentialsChartComparisonMp B S hS f)

end ChartComparison

