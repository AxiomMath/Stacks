/-!
# Coherent submodules through a section of a quasi-coherent module

Let `X` be a Noetherian algebraic space over a scheme `S` and let `𝓟` be a quasi-coherent
`𝒪_X`-module.  Every section of `𝓟` over an étale chart `V` of `X` with quasi-compact underlying
scheme lies in a coherent `𝒪_X`-submodule of `𝓟`. For a surjective étale chart `j : U → X`
with `U` affine, that submodule is `𝓖 = Ker(𝓟 → j_*j^*𝓟 → j_*(j^*𝓟/𝓗))`, where `𝓗 ⊆ j^*𝓟`
is generated by finitely many sections of `𝓟` over `U`.

## Main definitions

* `AlgebraicGeometry.Space.etaleImageSubmodule`: for an étale representable `f : Y → X` and a
  morphism `φ : 𝓝 ⟶ f^*𝓟`, the submodule `Ker(𝓟 → f_*Coker φ)` of the sections of `𝓟` whose
  restriction to `Y` lies in the image of `φ`.

## Main results

* `AlgebraicGeometry.Space.compactSpace_smallBaseChange_chartToSpace`: the base change of a
  quasi-compact étale chart along another one is quasi-compact over a quasi-separated space.
* `AlgebraicGeometry.Space.isCoherent_of_isCoherent_etaleModulePullback_chartToSpace`: a
  quasi-coherent module on a locally Noetherian space is coherent as soon as its restriction to
  one surjective étale chart is.
* `AlgebraicGeometry.Space.exists_isCoherent_mem_submodule_of_chart`: every section of a
  quasi-coherent module over a quasi-compact étale chart of a Noetherian algebraic space lies in
  a coherent submodule.

## References

* [Stacks Project, Tag 07UV](https://stacks.math.columbia.edu/tag/07UV)
* [Stacks Project, Tag 07TU](https://stacks.math.columbia.edu/tag/07TU)
* [Stacks Project, Tag 03M9](https://stacks.math.columbia.edu/tag/03M9)
* [Stacks Project, Tag 07UB](https://stacks.math.columbia.edu/tag/07UB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u m

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u})) (X : AlgebraicSpaces B S hS)

/-! ### Finiteness from a covering family, and finite affine refinements of covering sieves -/

section ChartCovers

variable (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-- **A module cartesian on affine charts whose sections over the members of a covering family
of affine étale charts form finite modules is of finite type on the small étale site.** -/
theorem isFiniteType_of_coversTop_of_moduleFinite (M : Modules.{u, m} B S hS F hF)
    (hMcart : IsCartesianOnAffineCharts M) {ι : Type (u + 1)} (A : ι → SmallEtale B S hS F)
    (hA : (smallEtaleRingedSite B S hS F hF).J.CoversTop A)
    (haff : ∀ i, IsAffine (chartScheme (A i)))
    (hfin : ∀ i, Module.Finite (chartRing B S hS F hF (A i)) (M.val.obj (op (A i)))) :
    PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J M.val := by
  classical
  refine ⟨ι, A, hA, fun i ↦ ?_⟩
  obtain ⟨n, s, hs⟩ := (hfin i).exists_fin
  refine ⟨n, s, fun W ρ t ↦ ?_⟩
  obtain ⟨I, V', ι', hV'aff, hcov, -⟩ := SmallEtale.exists_affine_etale_ofArrows B S hS F W
  refine ⟨Sieve.ofArrows V' ι', hcov, fun Zc g hg ↦ ?_⟩
  obtain ⟨j, α, rfl⟩ := Sieve.ofArrows.exists hg
  have hspan := span_range_chartRestrict_generators_eq_top B S hS F hF hMcart (haff i)
    (hV'aff j) (ι' j ≫ ρ) hs
  have hmem : chartRestrictLinear M (ι' j) t ∈
      Submodule.span (chartRing B S hS F hF (V' j))
        (Set.range fun i ↦ chartRestrictLinear M (ι' j ≫ ρ) (s i)) := by
    rw [hspan]; exact Submodule.mem_top
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hmem
  refine ⟨fun i ↦ chartRestrict (hF := hF) α (d i), ?_⟩
  have hstep : ∀ i, chartRestrict (hF := hF) α (d i) •
      chartRestrictLinear M ((α ≫ ι' j) ≫ ρ) (s i) =
      chartRestrictLinear M α (d i • chartRestrictLinear M (ι' j ≫ ρ) (s i)) := by
    intro i
    have h1 : chartRestrictLinear M ((α ≫ ι' j) ≫ ρ) (s i) =
        chartRestrictLinear M α (chartRestrictLinear M (ι' j ≫ ρ) (s i)) :=
      (congrArg (fun ψ ↦ chartRestrictLinear M ψ (s i)) (Category.assoc _ _ _)).trans
        (chartRestrictLinear_comp M (ι' j ≫ ρ) α (s i))
    rw [h1]
    exact (chartRestrictLinear_smul M α (d i) _).symm
  calc ∑ i, chartRestrict (hF := hF) α (d i) •
        chartRestrictLinear M ((α ≫ ι' j) ≫ ρ) (s i)
      = ∑ i, chartRestrictLinear M α (d i • chartRestrictLinear M (ι' j ≫ ρ) (s i)) :=
        Finset.sum_congr rfl fun i _ ↦ hstep i
    _ = chartRestrictLinear M α (∑ i, d i • chartRestrictLinear M (ι' j ≫ ρ) (s i)) :=
        (map_sum (chartRestrictLinear M α) _ _).symm
    _ = chartRestrictLinear M α (chartRestrictLinear M (ι' j) t) := congrArg _ hd
    _ = chartRestrictLinear M (α ≫ ι' j) t := (chartRestrictLinear_comp M (ι' j) α t).symm

namespace SmallEtale

/-- **A covering sieve of an étale chart with quasi-compact underlying scheme contains a finite
family of charts with affine underlying scheme whose image in schemes is an étale covering
family.** -/
theorem exists_finite_affine_etale_ofArrows_le_of_compactSpace {x : SmallEtale B S hS F}
    (hx : CompactSpace ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj x)))
    {Sv : Sieve x} (hSv : Sv ∈ SmallEtale.topology B S hS F x) :
    ∃ (n : ℕ) (z : Fin n → SmallEtale B S hS F) (φ : ∀ i, z i ⟶ x),
      (∀ i, IsAffine ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS F).obj (z i)))) ∧ (∀ i, Sv (φ i)) ∧
        Sieve.ofArrows z φ ∈ SmallEtale.topology B S hS F x ∧
        Presieve.ofArrows
            (fun i ↦ (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj (z i)))
            (fun i ↦ (BigFppfOver.toScheme B S hS).map
              ((SmallEtale.toOver B S hS F).map (φ i))) ∈
          Scheme.etalePrecoverage
            ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj x)) := by
  classical
  obtain ⟨R, hR, hRS⟩ := (mem_topology_iff B S hS F).1 hSv
  obtain ⟨E, rfl, hE⟩ := (SmallEtale.mem_precoverage_iff B S hS F).1 hR
  have hEet : Presieve.ofArrows
      (fun i ↦ (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj (E.X i)))
      (fun i ↦ (BigFppfOver.toScheme B S hS).map
        ((SmallEtale.toOver B S hS F).map (E.f i))) ∈
      Scheme.etalePrecoverage
        ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj x)) := by
    have h := hE.2
    rwa [AlgebraicGeometry.IsEtaleCovering, PreZeroHypercover.presieve₀_map,
      PreZeroHypercover.presieve₀, Presieve.map_ofArrows] at h
  choose Ji yi ψi haffi hcovi hetalei using fun i ↦ exists_affine_etale_ofArrows B S hS F (E.X i)
  have hcomp : Presieve.ofArrows
      (fun k : Σ i, Ji i ↦ (BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS F).obj (yi k.1 k.2)))
      (fun k : Σ i, Ji i ↦ (BigFppfOver.toScheme B S hS).map
        ((SmallEtale.toOver B S hS F).map (ψi k.1 k.2 ≫ E.f k.1))) ∈
      Scheme.etalePrecoverage
        ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj x)) := by
    have := Scheme.etalePrecoverage_isStableUnderComposition.{u}
    simpa only [Functor.map_comp] using Precoverage.comp_mem_coverings
      (J := Scheme.etalePrecoverage)
      (fun i ↦ (BigFppfOver.toScheme B S hS).map
        ((SmallEtale.toOver B S hS F).map (E.f i))) hEet
      (fun i j ↦ (BigFppfOver.toScheme B S hS).map
        ((SmallEtale.toOver B S hS F).map (ψi i j))) hetalei
  have : CompactSpace ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS F).obj x)) := hx
  obtain ⟨s, hs⟩ := Scheme.exists_finset_ofArrows_mem_etalePrecoverage hcomp
  have hfin := by
    simpa only [Functor.map_comp] using Scheme.mem_etalePrecoverage_of_equiv s.equivFin.symm hs
  refine ⟨s.card, fun i ↦ yi (s.equivFin.symm i).1.1 (s.equivFin.symm i).1.2,
    fun i ↦ ψi (s.equivFin.symm i).1.1 (s.equivFin.symm i).1.2 ≫ E.f (s.equivFin.symm i).1.1,
    fun i ↦ haffi _ _, fun i ↦ Sv.downward_closed (hRS _ _ (Presieve.ofArrows.mk _)) _, ?_, ?_⟩
  · exact ofArrows_mem_topology B S hS F _ _ hfin
  · exact hfin

end SmallEtale

end ChartCovers

/-- **The base change of a quasi-compact étale chart along another one is quasi-compact**, when
the algebraic space is quasi-separated. -/
theorem compactSpace_smallBaseChange_chartToSpace
    (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1) (U V : SmallEtale B S hS X.1)
    (hU : CompactSpace ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj U)))
    (hV : CompactSpace ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V))) :
    CompactSpace ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS
      (chartSpace B S hS X U).1).obj ((smallBaseChange B S hS (chartToSpace B S hS X U)
        (relativelyRepresentable_chartToSpace B S hS X U)).obj V))) :=
  compactSpace_of_isAbsolutelyQuasiSeparated B S hS hZ hqs
    (U.property.rep.isPullback' V.obj.hom) hU hV

/-- **A section of a module cartesian on affine charts over an affine chart is a finite linear
combination of restrictions of sections over a larger affine chart.** -/
theorem exists_finsupp_sum_chartRestrictLinear {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {hF : IsAlgebraicSpace B S hS F} {M : Modules.{u, u} B S hS F hF}
    (hM : IsCartesianOnAffineCharts M) {A Z : SmallEtale B S hS F}
    (hA : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A))
    (hZaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z))
    (ψ : Z ⟶ A) (x : M.val.obj (op Z)) :
    ∃ c : M.val.obj (op A) →₀ chartRing B S hS F hF Z,
      (c.sum fun y a => a • chartRestrictLinear M ψ y) = x := by
  have hspan := (chartBaseChange_surjective_iff_span_eq_top M ψ).1 (hM A Z hA hZaff ψ).2
  have hx : x ∈ Submodule.span (chartRing B S hS F hF Z)
      (Set.range fun y : M.val.obj (op A) => chartRestrictLinear M ψ y) := by
    simp [hspan]
  exact (Finsupp.mem_span_range_iff_exists_finsupp).1 hx

section EtaleImage

variable {X} {Y : AlgebraicSpaces B S hS} (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
  (hrep : yoneda.relativelyRepresentable f.hom)

/-- **The submodule of `𝓟` cut out by a morphism into its restriction along an étale
morphism.**  For an étale representable `f : Y → X` and a morphism `φ : 𝓝 ⟶ f^*𝓟` of
`𝒪_Y`-modules, this is `Ker(𝓟 → f_*f^*𝓟 → f_*Coker φ)`: the sections of `𝓟` whose restriction
to `Y` lies in the image of `φ`. -/
noncomputable def etaleImageSubmodule (P : Modules.{u, u} B S hS X.1 X.2)
    {N : Modules.{u, u} B S hS Y.1 Y.2}
    (φ : N ⟶ (etaleModulePullback.{u, u} B S hS f hf).obj P) : P.Submodule :=
  SheafOfModules.Submodule.ker
    ((etaleModulePullbackSmallBaseChangeAdjunction B S hS f hf hrep).unit.app P ≫
      (smallBaseChangeModulePushforward.{u, u} B S hS f hrep).map (cokernel.π φ))

/-- A section of `𝓟` over a chart `V` lies in `AlgebraicGeometry.Space.etaleImageSubmodule`
exactly when its restriction to `V ×_X Y` is killed by the cokernel of `φ`. -/
theorem mem_etaleImageSubmodule_iff (P : Modules.{u, u} B S hS X.1 X.2)
    {N : Modules.{u, u} B S hS Y.1 Y.2}
    (φ : N ⟶ (etaleModulePullback.{u, u} B S hS f hf).obj P) (V : SmallEtale B S hS X.1)
    (p : P.val.obj (op V)) :
    p ∈ (etaleImageSubmodule B S hS f hf hrep P φ).obj (op V) ↔
      (cokernel.π φ).val.app (op ((smallBaseChange B S hS f hrep).obj V))
        (P.val.map ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).counit.app V).op
          p) = 0 :=
  Iff.rfl

/-- The cokernel of a morphism from a quasi-coherent module into the restriction of a
quasi-coherent module along an étale morphism is quasi-coherent. -/
private theorem isQuasicoherentOnSite_cokernel_etaleModulePullback
    (P : Modules.{u, u} B S hS X.1 X.2) (hP : P.IsQuasicoherentOnSite)
    {N : Modules.{u, u} B S hS Y.1 Y.2} (hN : N.IsQuasicoherentOnSite)
    (φ : N ⟶ (etaleModulePullback.{u, u} B S hS f hf).obj P) :
    (cokernel φ).IsQuasicoherentOnSite := by
  have := isClosedUnderCokernels_quasicoherentSheaves B S hS Y.1 Y.2
  exact (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u} _).prop_cokernel φ hN
    (isQuasicoherentOnSite_etaleModulePullback B S hS f hf P hP)

/-- **`AlgebraicGeometry.Space.etaleImageSubmodule` is quasi-coherent** when `𝓟` and `𝓝` are and
`f` is quasi-compact and quasi-separated. -/
theorem isQuasicoherentOnSite_etaleImageSubmodule (hfqc : IsQuasiCompact B S hS f.hom)
    (hfqs : IsQuasiSeparated B S hS f.hom) (P : Modules.{u, u} B S hS X.1 X.2)
    (hP : P.IsQuasicoherentOnSite) {N : Modules.{u, u} B S hS Y.1 Y.2}
    (hN : N.IsQuasicoherentOnSite)
    (φ : N ⟶ (etaleModulePullback.{u, u} B S hS f hf).obj P) :
    (etaleImageSubmodule B S hS f hf hrep P φ).toSheafOfModules.IsQuasicoherentOnSite := by
  have := isClosedUnderKernels_quasicoherentSheaves_smallEtale B S hS X.1 X.2
  have hQ := isQuasicoherentOnSite_cokernel_etaleModulePullback B S hS f hf P hP hN φ
  have hPush : ((smallBaseChangeModulePushforward.{u, u} B S hS f hrep).obj
      (cokernel φ)).IsQuasicoherentOnSite :=
    SheafOfModules.IsQuasicoherentOnSite.of_iso
      ((smallBaseChangeModulePushforwardIso B S hS f hf hrep).app (cokernel φ)).symm
      (isQuasicoherentOnSite_modulePushforward_of_qcqs B S hS f hfqc hfqs (cokernel φ)
          inferInstance)
  exact SheafOfModules.IsQuasicoherentOnSite.of_iso (SheafOfModules.Submodule.kerIsoKernel _).symm
    ((SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u} _).prop_kernel _ hP hPush)

/-- **The restriction of `AlgebraicGeometry.Space.etaleImageSubmodule` to `Y` maps into the
image of `φ`**: the restricted inclusion is killed by the cokernel of `φ`. -/
theorem etaleModulePullback_map_ι_comp_cokernel_π (P : Modules.{u, u} B S hS X.1 X.2)
    {N : Modules.{u, u} B S hS Y.1 Y.2}
    (φ : N ⟶ (etaleModulePullback.{u, u} B S hS f hf).obj P) :
    (etaleModulePullback.{u, u} B S hS f hf).map (etaleImageSubmodule B S hS f hf hrep P φ).ι ≫
      cokernel.π φ = 0 := by
  set adj := etaleModulePullbackSmallBaseChangeAdjunction B S hS f hf hrep
  have : (etaleModulePullback.{u, u} B S hS f hf).PreservesZeroMorphisms := ⟨fun _ _ => rfl⟩
  have key : adj.homEquiv _ _ ((etaleModulePullback.{u, u} B S hS f hf).map
      (etaleImageSubmodule B S hS f hf hrep P φ).ι ≫ cokernel.π φ) = 0 := by
    rw [adj.homEquiv_naturality_left, adj.homEquiv_unit]
    exact SheafOfModules.Submodule.ker_ι_comp
      (adj.unit.app P ≫ (smallBaseChangeModulePushforward.{u, u} B S hS f hrep).map (cokernel.π φ))
  rw [← (adj.homEquiv _ _).symm_apply_apply ((etaleModulePullback.{u, u} B S hS f hf).map
      (etaleImageSubmodule B S hS f hf hrep P φ).ι ≫ cokernel.π φ), key, adj.homEquiv_counit,
    Functor.map_zero, zero_comp]

/-- **The restriction of `AlgebraicGeometry.Space.etaleImageSubmodule` to `Y` is coherent** when
`Y` is locally Noetherian, `𝓝` is coherent and `𝓟` is quasi-coherent. -/
theorem isCoherent_etaleModulePullback_etaleImageSubmodule
    [Fact (HasEtaleLocalProperty B S hS Y.1 (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (hfqc : IsQuasiCompact B S hS f.hom) (hfqs : IsQuasiSeparated B S hS f.hom)
    (P : Modules.{u, u} B S hS X.1 X.2) (hP : P.IsQuasicoherentOnSite)
    {N : Modules.{u, u} B S hS Y.1 Y.2} (hN : IsCoherent B S hS Y.1 Y.2 N)
    (φ : N ⟶ (etaleModulePullback.{u, u} B S hS f hf).obj P) :
    IsCoherent B S hS Y.1 Y.2 ((etaleModulePullback.{u, u} B S hS f hf).obj
      (etaleImageSubmodule B S hS f hf hrep P φ).toSheafOfModules) := by
  let : Abelian (Modules.{u, u} B S hS Y.1 Y.2) := SheafOfModules.instAbelian _
  have := isClosedUnderKernels_quasicoherentSheaves_smallEtale B S hS Y.1 Y.2
  have := preservesFiniteLimits_etaleModulePullback B S hS f hf
  have hPY : ((etaleModulePullback.{u, u} B S hS f hf).obj P).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_etaleModulePullback B S hS f hf P hP
  have hQ := isQuasicoherentOnSite_cokernel_etaleModulePullback B S hS f hf P hP
    hN.toIsQuasicoherentOnSite φ
  have hK : (kernel (cokernel.π φ)).IsQuasicoherentOnSite :=
    (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u} _).prop_kernel _ hPY hQ
  have hKcoh : IsCoherent B S hS Y.1 Y.2 (kernel (cokernel.π φ)) :=
    isCoherent_of_epi_of_isQuasicoherentOnSite B S hS Y.1 Y.2 (Abelian.factorThruImage φ) hK hN
  have hG : (etaleImageSubmodule B S hS f hf hrep P φ).toSheafOfModules.IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_etaleImageSubmodule B S hS f hf hrep hfqc hfqs P hP
      hN.toIsQuasicoherentOnSite φ
  have hGY := isQuasicoherentOnSite_etaleModulePullback B S hS f hf _ hG
  have : Mono ((etaleModulePullback.{u, u} B S hS f hf).map
      (etaleImageSubmodule B S hS f hf hrep P φ).ι) := inferInstance
  have hι := etaleModulePullback_map_ι_comp_cokernel_π B S hS f hf hrep P φ
  have : Mono (kernel.lift (cokernel.π φ) _ hι) :=
    mono_of_mono_fac (kernel.lift_ι (cokernel.π φ) _ hι)
  exact isCoherent_of_mono_of_isQuasicoherentOnSite B S hS Y.1 Y.2
    (kernel.lift (cokernel.π φ) _ hι) hGY hKcoh

end EtaleImage

/-! ### Coherence is detected on one surjective chart -/

/-- **The affine charts of the chart space of a surjective étale chart `U → X` cover `X`.** -/
theorem coversTop_postcomp_affineCharts (U : SmallEtale B S hS X.1)
    (hsurj : IsSurjective B S hS U.1.hom) :
    (SmallEtale.topology B S hS X.1).CoversTop
      (fun A : {A : SmallEtale B S hS (chartSpace B S hS X U).1 // IsAffine (chartScheme A)} =>
        (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
          (isEtale_chartToSpace B S hS X U)).obj A.1) := by
  intro W
  refine (SmallEtale.topology B S hS X.1).transitive
    (SmallEtale.coversTop_of_isSurjective B S hS X.1 X.2 U hsurj W) _ ?_
  rintro Z g ⟨_, ⟨a⟩⟩
  set E := SmallEtale.chartLocalizationEquivalence B S hS X.1 U
  set T := E.inverse.obj (Over.mk a)
  let e : (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
      (isEtale_chartToSpace B S hS X U)).obj T ≅ Z :=
    (Over.forget U).mapIso (E.counitIso.app (Over.mk a))
  obtain ⟨I, Yj, aj, haff, -, hpre⟩ :=
    SmallEtale.exists_affine_etale_ofArrows B S hS (chartSpace B S hS X U).1 T
  have hcov : Sieve.ofArrows (fun j => (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
      (isEtale_chartToSpace B S hS X U)).obj (Yj j))
      (fun j => (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
        (isEtale_chartToSpace B S hS X U)).map (aj j)) ∈
      SmallEtale.topology B S hS X.1 _ :=
    SmallEtale.ofArrows_mem_topology B S hS X.1 _ _ hpre
  have hle : Sieve.ofArrows (fun j => (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
      (isEtale_chartToSpace B S hS X U)).obj (Yj j))
      (fun j => (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
        (isEtale_chartToSpace B S hS X U)).map (aj j)) ≤
      (Sieve.ofObjects (fun A : {A : SmallEtale B S hS (chartSpace B S hS X U).1 //
        IsAffine (chartScheme A)} => (smallEtalePostcomp B S hS (chartToSpace B S hS X U)
          (isEtale_chartToSpace B S hS X U)).obj A.1) W).pullback (e.hom ≫ g) := by
    intro Z' h hh
    obtain ⟨j, k, rfl⟩ := Sieve.ofArrows.exists hh
    exact ⟨⟨Yj j, haff j⟩, ⟨k⟩⟩
  have := (SmallEtale.topology B S hS X.1).pullback_stable e.inv
    ((SmallEtale.topology B S hS X.1).superset_covering hle hcov)
  rwa [← Sieve.pullback_comp, Iso.inv_hom_id_assoc] at this

/-- **A quasi-coherent module on a locally Noetherian algebraic space is coherent as soon as its
restriction to one surjective étale chart is.** -/
theorem isCoherent_of_isCoherent_etaleModulePullback_chartToSpace
    [Fact (HasEtaleLocalProperty B S hS X.1 (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (U : SmallEtale B S hS X.1) (hsurj : IsSurjective B S hS U.1.hom)
    (M : Modules.{u, u} B S hS X.1 X.2) (hM : M.IsQuasicoherentOnSite)
    (h : IsCoherent B S hS (chartSpace B S hS X U).1 (chartSpace B S hS X U).2
      ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U)
        (isEtale_chartToSpace B S hS X U)).obj M)) :
    IsCoherent B S hS X.1 X.2 M :=
  (isCoherent_iff_isQuasicoherentOnSite_and_isFiniteType B S hS X.1 X.2 M).2
    ⟨hM, isFiniteType_of_coversTop_of_moduleFinite B S hS X.1 X.2 M
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 M hM) _
      (coversTop_postcomp_affineCharts B S hS X U hsurj) (fun A => A.2)
      (fun A => moduleFinite_sections_of_isCoherent B S hS _ _ _ h A.2)⟩

/-! ### The morphism defined by finitely many sections over a terminal chart -/

section Generators

variable {Y : AlgebraicSpaces B S hS} {T : SmallEtale B S hS Y.1} (hT : IsTerminal T)

/-- The morphism `⨁_{i ∈ I} 𝒪 → 𝓜` sending the `i`-th basis section to `i`, for a finite set
`I` of sections of `𝓜` over a terminal object `T` of the small étale site. -/
noncomputable def sectionsHom (M : Modules.{u, u} B S hS Y.1 Y.2) (I : Finset (M.val.obj (op T))) :
    (⨁ fun _ : I => SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Y.1 Y.2).O)) ⟶ M :=
  biproduct.desc fun i => (SheafOfModules.unitHomEquiv M).symm
    ((Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT).symm i.1)

/-- The cokernel of `AlgebraicGeometry.Space.sectionsHom` kills the restriction of every
member of `I` to every chart. -/
theorem cokernel_π_sectionsHom_app_map (M : Modules.{u, u} B S hS Y.1 Y.2)
    (I : Finset (M.val.obj (op T))) {y : M.val.obj (op T)} (hy : y ∈ I)
    (A : SmallEtale B S hS Y.1) :
    (cokernel.π (sectionsHom B S hS hT M I)).val.app (op A) (M.val.map (hT.from A).op y) = 0 := by
  have h0 : (SheafOfModules.unitHomEquiv M).symm
      ((Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT).symm y) ≫
      cokernel.π (sectionsHom B S hS hT M I) = 0 := by
    have hι := biproduct.ι_desc (fun i : I => (SheafOfModules.unitHomEquiv M).symm
      ((Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT).symm i.1)) ⟨y, hy⟩
    rw [← hι, Category.assoc]
    show _ ≫ sectionsHom B S hS hT M I ≫ _ = 0
    rw [cokernel.condition, comp_zero]
  have h1 := congrArg (fun g => g.val.app (op A) (1 : (Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedSite B S hS Y.1 Y.2).O).obj.obj (op A))) h0
  simp only at h1
  refine Eq.trans (congrArg _ ?_) h1
  exact (CategoryTheory.Sheaf.unitHomEquiv_symm_val_app_one M
    ((Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT).symm y) (op A)).symm

/-- The cokernel of `AlgebraicGeometry.Space.sectionsHom` kills every linear combination of
restrictions of members of `I`. -/
theorem cokernel_π_sectionsHom_app_sum (M : Modules.{u, u} B S hS Y.1 Y.2)
    (I : Finset (M.val.obj (op T))) {A : SmallEtale B S hS Y.1}
    (c : M.val.obj (op T) →₀ chartRing B S hS Y.1 Y.2 A) (hc : c.support ⊆ I) :
    (cokernel.π (sectionsHom B S hS hT M I)).val.app (op A)
      (c.sum fun y a => a • chartRestrictLinear M (hT.from A) y) = 0 := by
  have key : ∀ y ∈ c.support, (cokernel.π (sectionsHom B S hS hT M I)).val.app (op A)
      (c y • chartRestrictLinear M (hT.from A) y) = 0 := by
    intro y hy
    refine ((ModuleCat.Hom.hom ((cokernel.π (sectionsHom B S hS hT M I)).val.app (op A))).map_smul
      (c y) _).trans ?_
    exact (congrArg (fun z => c y • z)
      (cokernel_π_sectionsHom_app_map B S hS hT M I (hc hy) A)).trans (smul_zero _)
  calc (cokernel.π (sectionsHom B S hS hT M I)).val.app (op A)
        (c.sum fun y a => a • chartRestrictLinear M (hT.from A) y)
      = ∑ y ∈ c.support, (cokernel.π (sectionsHom B S hS hT M I)).val.app (op A)
          (c y • chartRestrictLinear M (hT.from A) y) :=
        map_sum (ModuleCat.Hom.hom ((cokernel.π (sectionsHom B S hS hT M I)).val.app (op A))) _ _
    _ = 0 := Finset.sum_eq_zero key

end Generators

/-- **A section killed by a morphism of sheaves of modules locally on a covering family is
killed by it.** -/
theorem val_app_eq_zero_of_ofArrows {Y : AlgebraicSpaces B S hS}
    {M Q : Modules.{u, u} B S hS Y.1 Y.2} (π : M ⟶ Q) {W : SmallEtale B S hS Y.1} {n : ℕ}
    {z : Fin n → SmallEtale B S hS Y.1} {φ : ∀ l, z l ⟶ W}
    (hcov : Sieve.ofArrows z φ ∈ SmallEtale.topology B S hS Y.1 W) (x : M.val.obj (op W))
    (h : ∀ l, π.val.app (op (z l)) (M.val.map (φ l).op x) = 0) :
    π.val.app (op W) x = 0 := by
  refine (SheafOfModules.Submodule.ker π).isSheaf x
    ((SmallEtale.topology B S hS Y.1).superset_covering ?_ hcov)
  intro Z g hg
  obtain ⟨l, k, rfl⟩ := Sieve.ofArrows.exists hg
  exact Sieve.downward_closed _ (h l) k

/-- **Every section of a quasi-coherent module over a quasi-compact étale chart of a Noetherian
algebraic space lies in a coherent submodule.** Here `U` is a surjective étale chart whose
underlying scheme is affine. -/
theorem exists_isCoherent_mem_submodule_of_chart (hN : IsNoetherian B S hS hZ X.1)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj U)))
    (hsurj : IsSurjective B S hS U.1.hom) (P : Modules.{u, u} B S hS X.1 X.2)
    (hP : P.IsQuasicoherentOnSite) (V : SmallEtale B S hS X.1)
    (hV : CompactSpace ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V)))
    (p : P.val.obj (op V)) :
    ∃ G : P.Submodule, IsCoherent B S hS X.1 X.2 G.toSheafOfModules ∧ p ∈ G.obj (op V) := by
  classical
  have hf := isEtale_chartToSpace B S hS X U
  have hrep := relativelyRepresentable_chartToSpace B S hS X U
  have hXN : Fact (HasEtaleLocalProperty B S hS X.1
      (fun V : Scheme.{u} => IsLocallyNoetherian V)) := ⟨hN.2.2⟩
  have hYN : Fact (HasEtaleLocalProperty B S hS (chartSpace B S hS X U).1
      (fun V : Scheme.{u} => IsLocallyNoetherian V)) :=
    ⟨hasEtaleLocalProperty_isLocallyNoetherian_chart B S hS hN.2.2 U⟩
  have hYqc : IsQuasiCompactSpace B S hS (chartSpace B S hS X U).1 :=
    isQuasiCompactSpace_yoneda_of_isAffine B S hS U.1.left hU
  have hYqs : IsAbsolutelyQuasiSeparated B S hS hZ (chartSpace B S hS X U).1 :=
    isAbsolutelyQuasiSeparated_of_isQuasiSeparatedScheme B S hS _ hZ
      ⟨U.1.left, (have : IsAffine ((BigFppfOver.toScheme B S hS).obj U.obj.left) := hU
        inferInstance), ⟨Functor.RepresentableBy.yoneda U.1.left⟩⟩
  have hfqc : IsQuasiCompact B S hS (chartToSpace B S hS X U).hom :=
    isQuasiCompact_of_isQuasiCompactSpace B S hS hZ X.2 hN.2.1 hYqc _
  have hfqs : IsQuasiSeparated B S hS (chartToSpace B S hS X U).hom :=
    isQuasiSeparated_of_isAbsolutelyQuasiSeparated_source B S hS hZ
      (chartSpace B S hS X U).2 hYqs _
  have hPU : ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U) hf).obj
      P).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_etaleModulePullback B S hS _ hf P hP
  have hT : IsTerminal (C := SmallEtale B S hS (chartSpace B S hS X U).1)
      (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj U)) :=
    isTerminalIdEtaleChart B S hS _
  have hTaff : IsAffine ((SmallEtale.toOver B S hS (chartSpace B S hS X U).1 ⋙
      BigFppfOver.toScheme B S hS).obj
        (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj U))) := hU
  obtain ⟨n, z, φ, hzaff, -, hcov, -⟩ :=
    SmallEtale.exists_finite_affine_etale_ofArrows_le_of_compactSpace B S hS
      (chartSpace B S hS X U).1
      (compactSpace_smallBaseChange_chartToSpace B S hS hZ X hN.2.1 U V
        (have : IsAffine ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS X.1).obj U)) := hU
         inferInstance) hV)
      ((SmallEtale.topology B S hS (chartSpace B S hS X U).1).top_mem
        ((smallBaseChange B S hS (chartToSpace B S hS X U) hrep).obj V))
  have hexp := fun l : Fin n => exists_finsupp_sum_chartRestrictLinear B S hS
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS _ _ _ hPU) hTaff (hzaff l)
    (hT.from (z l))
    (((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U) hf).obj P).val.map (φ l).op
      (P.val.map ((smallEtalePostcompBaseChangeAdjunction B S hS (chartToSpace B S hS X U) hf
        hrep).counit.app V).op p))
  choose c hc using hexp
  let I : Finset (((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U) hf).obj P).val.obj
    (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj U)))) :=
    Finset.univ.biUnion fun l => (c l).support
  let Φ := sectionsHom B S hS hT
    ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U) hf).obj P) I
  have hΦ := isCoherent_biproduct (I := I) B S hS (chartSpace B S hS X U).1
    (chartSpace B S hS X U).2 _
    fun _ => isCoherent_structureSheaf B S hS _ _
  refine ⟨etaleImageSubmodule B S hS (chartToSpace B S hS X U) hf hrep P Φ, ?_, ?_⟩
  · refine isCoherent_of_isCoherent_etaleModulePullback_chartToSpace B S hS X U hsurj _
      (isQuasicoherentOnSite_etaleImageSubmodule B S hS _ hf hrep hfqc hfqs P hP
        hΦ.toIsQuasicoherentOnSite Φ) ?_
    exact isCoherent_etaleModulePullback_etaleImageSubmodule B S hS _ hf hrep hfqc hfqs P hP hΦ Φ
  · have hl : ∀ l, (cokernel.π Φ).val.app (op (z l))
        (((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U) hf).obj P).val.map
          (φ l).op (P.val.map ((smallEtalePostcompBaseChangeAdjunction B S hS
            (chartToSpace B S hS X U) hf hrep).counit.app V).op p)) = 0 := by
      intro l
      have hsub : (c l).support ⊆ I := fun y hy => Finset.mem_biUnion.2 ⟨l, Finset.mem_univ _, hy⟩
      have h := cokernel_π_sectionsHom_app_sum B S hS hT
        ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X U) hf).obj P) I (c l) hsub
      rwa [hc l] at h
    exact (mem_etaleImageSubmodule_iff B S hS _ hf hrep P Φ V p).2
      (val_app_eq_zero_of_ofArrows B S hS (cokernel.π Φ) hcov _ hl)

end AlgebraicGeometry.Space

