/-!
# Faithfulness of the base-change functor on modifications

Let `f : V ⟶ W` be an étale morphism of algebraic spaces over a scheme `S` and let `T` be a
closed subspace of `W` whose preimage is carried isomorphically onto `T` by `f`. Write
`W⁰` for the open complement of `T`. This file proves that the base-change functor of
Stacks 0BGY, from the modifications of `W` outside `W⁰` to the modifications of `V` outside
`f⁻¹W⁰`, is faithful.

## Main definitions

* `AlgebraicGeometry.Space.excisionMap` is the two-member family `{W⁰ ⟶ W, V ⟶ W}` of
  morphisms into `W` which the source proof uses as a covering of `W`.
* `AlgebraicGeometry.Space.excisionBaseMap` is its base change along a morphism `g : X ⟶ W`:
  the part of `X` lying over `W⁰`, together with the fibre product `X ×_W V`.

## Main results

* `AlgebraicGeometry.Space.familyImage_excisionMap_sieveOfSection_mem`: every section of `W`
  lies, locally for the fppf topology, either in `W⁰` or in the image of `f`.
* `AlgebraicGeometry.Space.familyImage_excisionBaseMap_sieveOfSection_mem`: the same after an
  arbitrary base change `g : X ⟶ W`.
* `AlgebraicGeometry.Space.faithful_baseChangeFunctor`: **Stacks 0BGY**, the faithfulness of
  the base-change functor.

## Implementation notes

The source proof covers `W` by the étale family `{W⁰ → W, V → W}`. That family is not a
Zariski covering, and `AlgebraicGeometry.Space.IsZariskiCover` is the only covering predicate
the library carries for subfunctors; so the covering is used here in the weaker shape it is
actually needed in, namely the hypothesis of `AlgebraicGeometry.Space.glueHom` — that the
subfunctor `AlgebraicGeometry.Space.familyImage` generated by the images of the family has a
covering sieve of sections at every object. That shape accepts a family of arbitrary
morphisms, not only subfunctor inclusions, which is what lets the second member be `f` itself
rather than its open image.

`AlgebraicGeometry.Space.exists_openImage_isZariskiCover_openComplement` supplies the Zariski
covering of `W` by `W⁰` and the open image `I` of `f`, together with a surjective étale scheme
chart `q : U ⟶ I` factoring through `f`. Passing from that covering to the one used here is
one application of transitivity of the topology: over the `W⁰` member there is nothing to do,
and over the `I` member the chart is locally surjective by
`AlgebraicGeometry.Space.isLocallySurjective_of_presheafSurjective_etale`, so a section of `I`
lifts, after refinement, to `U` and hence to `V`.

Faithfulness itself is then the separation half of the sheaf condition. Two morphisms of
modifications agreeing after base change along `f` agree on `X ×_W V` by construction, and
they agree on the part of `X` lying over `W⁰` because the target is an isomorphism over `W⁰`:
that is `AlgebraicGeometry.Space.eq_of_comp_eq_of_range_le`, whose hypothesis is invertibility
of `CategoryTheory.Subfunctor.fromPreimage`, supplied here from the invertibility of
`CategoryTheory.Limits.pullback.snd` that defines a modification. Since the source of a
modification is an algebraic space, hence an fppf sheaf, the two morphisms are equal.

Separatedness of `f` is not used: it enters the source proof only through the decomposition
`V ×_W V = Δ(V) ⨿ U`, which faithfulness does not need.

## References

* [Stacks Project, Tag 0BGY](https://stacks.math.columbia.edu/tag/0BGY)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Being an isomorphism over a subfunctor, in two shapes -/

/-! ### The covering of `W` by the open complement and `V` -/

/-- The sources of the two-member family covering `W`: the open complement of `T`, and `V`. -/
def excisionSource {V W : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (_f : V ⟶ W) (T : Subfunctor W) :
    Bool → ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
  | true => (openComplement B S hS T).toFunctor
  | false => V

/-- The two-member family covering `W`: the inclusion of the open complement of `T`, and `f`
itself. -/
def excisionMap {V W : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : V ⟶ W) (T : Subfunctor W) :
    ∀ b, excisionSource B S hS f T b ⟶ W
  | true => (openComplement B S hS T).ι
  | false => f

variable {V W : AlgebraicSpaces B S hS}

/-- **The covering of `W` behind Stacks 0BGY.** Every section of `W` lies, locally for the fppf
topology, either in the open complement of `T` or in the image of `f`.

The source proof covers `W` by the étale family `{W⁰ → W, V → W}`; this is that covering, in
the shape the glueing lemmas consume. -/
theorem familyImage_excisionMap_sieveOfSection_mem (f : V ⟶ W) (T : Subfunctor W.obj)
    (hT : IsClosedSubspace B S hS T) (hfT : IsIso (T.fromPreimage f.hom))
    (hf : IsEtale B S hS f.hom) (Z : BigFppfOver B S hS) (w : W.obj.obj (op Z)) :
    (familyImage (excisionMap B S hS f.hom T)).sieveOfSection w
      ∈ BigFppfOver.topology B S hS Z := by
  classical
  obtain ⟨I, hIopen, U, aU, q, hqfac, hqsurj, hqet, hcov⟩ :=
    exists_openImage_isZariskiCover_openComplement B S hS f T hT hfT hf
  have hqls : Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS) q :=
    isLocallySurjective_of_presheafSurjective_etale q
      ((presheafSurjective_iff_isSurjective_yoneda B S hS I.toFunctor hIopen.1 U q).mpr hqsurj)
      (presheaf_etale_of_isEtale B S hS hqet)
  have hS₁ := familyImage_sieveOfSection_mem_of_isZariskiCover B S hS
    (fun b : ULift.{u} Bool => if b.down then openComplement B S hS T else I) hcov Z w
  refine (BigFppfOver.topology B S hS).transitive hS₁ _ ?_
  rintro Z' g hg
  obtain ⟨⟨bb⟩, y, hy⟩ := hg
  cases bb
  · -- The member is the open image `I` of `f`: refine along the chart `q`.
    replace hy : I.ι.app (op Z') y = W.obj.map g.op w := hy
    refine (BigFppfOver.topology B S hS).superset_covering ?_
      (Presheaf.imageSieve_mem (BigFppfOver.topology B S hS) q y)
    rintro Z'' k ⟨z, hz⟩
    refine ⟨false, aU.app (op Z'') z, ?_⟩
    have hc := ConcreteCategory.congr_hom (NatTrans.congr_app hqfac (op Z'')) z
    simp only [NatTrans.comp_app, ConcreteCategory.comp_apply] at hc
    change f.hom.app (op Z'') (aU.app (op Z'') z) = W.obj.map (k ≫ g).op w
    rw [← hc, hz, NatTrans.naturality_apply I.ι k.op y, hy, op_comp,
      Functor.map_comp_apply]
  · -- The member is the open complement: the arrow is already in the sieve.
    replace hy : (openComplement B S hS T).ι.app (op Z') y = W.obj.map g.op w := hy
    have hmem : (familyImage (excisionMap B S hS f.hom T)).sieveOfSection w g := ⟨true, y, hy⟩
    exact (BigFppfOver.topology B S hS).covering_of_eq_top (Sieve.pullback_eq_top_of_mem _ hmem)

/-! ### The covering after a base change -/

/-- The sources of the base change of the covering family along `g : X ⟶ W`: the part of `X`
lying over the open complement of `T`, and the fibre product `X ×_W V`. -/
noncomputable def excisionBaseSource (f : V ⟶ W) (T : Subfunctor W.obj)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (g : X ⟶ W.obj) :
    Bool → ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
  | true => ((openComplement B S hS T).preimage g).toFunctor
  | false => pullback g f.hom

/-- The base change of the covering family along `g : X ⟶ W`. -/
noncomputable def excisionBaseMap (f : V ⟶ W) (T : Subfunctor W.obj)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (g : X ⟶ W.obj) :
    ∀ b, excisionBaseSource B S hS f T g b ⟶ X
  | true => ((openComplement B S hS T).preimage g).ι
  | false => pullback.fst g f.hom

/-- **The covering of Stacks 0BGY after a base change.** Every section of a presheaf `X` over
`W` lies, locally for the fppf topology, either over the open complement of `T` or in the
fibre product `X ×_W V`. -/
theorem familyImage_excisionBaseMap_sieveOfSection_mem (f : V ⟶ W) (T : Subfunctor W.obj)
    (hT : IsClosedSubspace B S hS T) (hfT : IsIso (T.fromPreimage f.hom))
    (hf : IsEtale B S hS f.hom) {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (g : X ⟶ W.obj)
    (Z : BigFppfOver B S hS) (x : X.obj (op Z)) :
    (familyImage (excisionBaseMap B S hS f T g)).sieveOfSection x
      ∈ BigFppfOver.topology B S hS Z := by
  refine (BigFppfOver.topology B S hS).superset_covering ?_
    (familyImage_excisionMap_sieveOfSection_mem B S hS f T hT hfT hf Z (g.app (op Z) x))
  rintro Z' k ⟨bb, y, hy⟩
  cases bb
  · -- Over `V`: the section and its lift span a section of the fibre product.
    change f.hom.app (op Z') y = W.obj.map k.op (g.app (op Z) x) at hy
    have hcomm : g.app (op Z') (X.map k.op x) = f.hom.app (op Z') y := by
      rw [NatTrans.naturality_apply, hy]
    obtain ⟨z, hz, -⟩ := Types.exists_of_isPullback
      ((IsPullback.of_hasPullback g f.hom).map
        ((evaluation ((BigFppfOver B S hS)ᵒᵖ) (Type u)).obj (op Z')))
      (X.map k.op x) y hcomm
    exact ⟨false, z, hz⟩
  · -- Over the open complement: the restricted section lies in the preimage.
    change (openComplement B S hS T).ι.app (op Z') y = W.obj.map k.op (g.app (op Z) x) at hy
    have hmem : g.app (op Z') (X.map k.op x) ∈ (openComplement B S hS T).obj (op Z') := by
      rw [NatTrans.naturality_apply, ← hy]
      exact y.2
    exact ⟨true, ⟨X.map k.op x, hmem⟩, rfl⟩

/-! ### Faithfulness -/

/-- **Stacks 0BGY, faithfulness of the base-change functor.** Let `f : V ⟶ W` be an étale
morphism of algebraic spaces over `S` and let `T` be a closed subspace of `W` whose preimage
is carried isomorphically onto `T`. Then the functor of Stacks 0BGY, base change along `f`
from the modifications of `W` outside the open complement `W⁰` of `T` to the modifications of
`V` outside `f⁻¹W⁰`, is faithful.

Two morphisms of modifications which agree after base change agree on `X ×_W V`, and they
agree over `W⁰` because the target is an isomorphism there; those two parts cover the source
locally, which is a sheaf, so the morphisms are equal. -/
@[stacks 0BGY "the base-change functor is faithful"]
theorem faithful_baseChangeFunctor (f : V ⟶ W) (T : Subfunctor W.obj)
    (hT : IsClosedSubspace B S hS T) (hfT : IsIso (T.fromPreimage f.hom))
    (hf : IsEtale B S hS f.hom) :
    (baseChangeFunctor B S hS f (openComplement B S hS T)).1.Faithful := by
  constructor
  intro X X' a b h
  apply ObjectProperty.hom_ext
  apply Over.OverMorphism.ext
  -- The two morphisms agree on the fibre product with `V`, by hypothesis.
  have hV : pullback.fst X.obj.hom f.hom ≫ a.hom.left
      = pullback.fst X.obj.hom f.hom ≫ b.hom.left := by
    have key (c : X ⟶ X') : pullback.fst X.obj.hom f.hom ≫ c.hom.left =
        ((baseChangeFunctor B S hS f (openComplement B S hS T)).1.map c).hom.left
          ≫ pullback.fst X'.obj.hom f.hom :=
      (pullback.lift_fst _ _ _).symm
    rw [key a, key b, h]
  -- The two morphisms agree over the open complement, because the target is an isomorphism
  -- there.
  have hW₀ : ((openComplement B S hS T).preimage X.obj.hom).ι ≫ a.hom.left
      = ((openComplement B S hS T).preimage X.obj.hom).ι ≫ b.hom.left := by
    refine eq_of_comp_eq_of_range_le B S hS X'.obj.hom (openComplement B S hS T)
      (isIso_fromPreimage_of_isIso_pullback_snd X'.obj.hom _ X'.property.2) ?_ ?_
    · rw [Category.assoc, Category.assoc, Over.w a.hom, Over.w b.hom]
    · rw [Category.assoc, Over.w a.hom,
        ← (openComplement B S hS T).fromPreimage_ι X.obj.hom]
      exact le_of_le_of_eq (Subfunctor.range_comp_le _ _) (Subfunctor.range_ι _)
  refine hom_ext_of_familyImage_cover (BigFppfOver.topology B S hS)
    (excisionBaseMap B S hS f T X.obj.hom)
    (familyImage_excisionBaseMap_sieveOfSection_mem B S hS f T hT hfT hf X.obj.hom)
    X'.property.1.isSheaf a.hom.left b.hom.left ?_
  rintro (_ | _)
  exacts [hV, hW₀]

end AlgebraicGeometry.Space

end
