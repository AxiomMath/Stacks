module

public import StacksFrontier.AlgebraicGeometry.Spaces.ConormalAlgebraFunctorial
public import StacksFrontier.AlgebraicGeometry.Spaces.ConormalModuleBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.KernelIdealEtaleLocal
public import StacksFrontier.AlgebraicGeometry.Spaces.FpqcOpenSubspaceDescent

/-!
# The kernel ideal sheaf of the base change of an immersion

Let
```
Z --i--→ X
|        |
f        g
↓        ↓
Z' -i'-→ X'
```
be a cartesian square of algebraic spaces over a scheme `S` contained in a big fppf site `B`, with
`i'` an immersion.  This file computes the kernel ideal sheaf `𝓘 = Ker(i^♯) ⊆ 𝒪_X` of the base
change `i` on the étale charts of `X` near `Z`, in terms of the kernel ideal sheaf
`𝓘' = Ker((i')^♯) ⊆ 𝒪_{X'}`: **over a commutative diagram of affine étale charts `W ⟶ V'` over
`g` near `Z`, the ideal `𝓘(W)` is generated by the pullback of the ideal `𝓘'(V')`.**

"Near `Z`" is made precise as follows.  The immersion `i'` is a closed immersion into the
complement `U' = X' ∖ ∂Z'` of the boundary of its image (Stacks 04CE), and the base change of
that open subspace is the open subspace `U = g⁻¹(U')` of `X`, through which `i` factors as a
closed immersion.  The charts near `Z` are the étale charts of `U`, read as charts of `X` by
postcomposition with the inclusion `U ⟶ X`.

## Main definitions

* `AlgebraicGeometry.Space.immersionAmbientι`: the inclusion of the complement of the boundary
  of an immersion, as a morphism of algebraic spaces.
* `AlgebraicGeometry.Space.immersionAmbientPreimage`: the base change `U = g⁻¹(X' ∖ ∂Z')` along
  `g : X ⟶ X'`, as an algebraic space, with its inclusion
  `AlgebraicGeometry.Space.immersionAmbientPreimageι` into `X` and its projection
  `AlgebraicGeometry.Space.immersionAmbientPreimageMap` to `X' ∖ ∂Z'`.

## Main results

* `AlgebraicGeometry.Space.kernelIdealSheaf_comp_of_isIso`: the kernel ideal sheaf of a morphism
  does not change when the morphism is precomposed with an isomorphism.
* `AlgebraicGeometry.Space.kernelIdealSheaf_comp_obj_smallEtalePostcomp`: the kernel ideal sheaf
  of a morphism followed by an étale monomorphism, read on a postcomposed chart, is the kernel
  ideal sheaf of the morphism itself.
* `AlgebraicGeometry.Space.kernelIdealSheaf_obj_immersionAmbient`: the kernel ideal sheaf of an
  immersion near its image is the defining ideal sheaf of Stacks 03MB of its image in
  `X' ∖ ∂Z'`.
* `AlgebraicGeometry.Space.kernelIdealSheaf_obj_immersionAmbientPreimage`: the kernel ideal sheaf
  of the base change of an immersion along a cartesian square, near the base change of the image,
  is the defining ideal sheaf of the inverse image of that image.
* `AlgebraicGeometry.Space.kernelIdealSheaf_obj_eq_map_of_isPullback`: **over an affine chart
  diagram near `Z`, the kernel ideal of the base change is generated by the pullback of the kernel
  ideal of the immersion.**

## References

* [Stacks Project, Tag 04CE](https://stacks.math.columbia.edu/tag/04CE)
* [Stacks Project, Tag 03MB](https://stacks.math.columbia.edu/tag/03MB)
* [Stacks Project, Tag 083Q](https://stacks.math.columbia.edu/tag/083Q)
* [Stacks Project, Tag 04CQ](https://stacks.math.columbia.edu/tag/04CQ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Invariance of the kernel ideal sheaf -/

/-- **The kernel ideal sheaf of a morphism does not change under precomposition with an
isomorphism.**  One inclusion is `AlgebraicGeometry.Space.kernelIdealSheaf_le_comp` for the
square `e ≫ p = e ≫ p`, the other the same statement for `e⁻¹` and `e ≫ p`. -/
theorem kernelIdealSheaf_comp_of_isIso {Z R X : AlgebraicSpaces B S hS} (e : Z ⟶ R) [IsIso e]
    (p : R ⟶ X) : kernelIdealSheaf B S hS (e ≫ p) = kernelIdealSheaf B S hS p := by
  refine le_antisymm ?_ (kernelIdealSheaf_le_comp B S hS e p e p rfl)
  have h := kernelIdealSheaf_le_comp B S hS (inv e) (e ≫ p) (inv e) (e ≫ p) rfl
  rwa [IsIso.inv_hom_id_assoc] at h

/-- **The kernel ideal sheaf of a morphism followed by an étale monomorphism, on a postcomposed
chart, is the kernel ideal sheaf of the morphism.**  The square with `𝟙`, `p`, `p ≫ j` and `j`
is cartesian because `j` is a monomorphism, and the kernel ideal sheaf commutes with étale
localization of the target (`AlgebraicGeometry.Space.kernelIdealSheaf_baseChange_obj`). -/
theorem kernelIdealSheaf_comp_obj_smallEtalePostcomp {R U X : AlgebraicSpaces B S hS}
    (p : R ⟶ U) (j : U ⟶ X) [Mono j] (hj : IsEtale B S hS j.hom) (W : SmallEtale B S hS U.1) :
    (kernelIdealSheaf B S hS (p ≫ j)).obj (op ((smallEtalePostcomp B S hS j hj).obj W)) =
      (kernelIdealSheaf B S hS p).obj (op W) :=
  (kernelIdealSheaf_baseChange_obj B S hS (𝟙 R) p (p ≫ j) j
    (IsPullback.of_horiz_isIso_mono ⟨by rw [Category.id_comp]⟩) hj W).symm

/-- The kernel ideal sheaf of `k = e ≫ p ≫ j`, with `e` an isomorphism and `j` an étale
monomorphism, on a postcomposed chart is the kernel ideal sheaf of `p`. -/
private theorem kernelIdealSheaf_obj_postcomp_of_comp_eq {Z R U X : AlgebraicSpaces B S hS}
    (e : Z ⟶ R) [IsIso e] (p : R ⟶ U) (j : U ⟶ X) [Mono j] (hj : IsEtale B S hS j.hom)
    (W : SmallEtale B S hS U.1) {k : Z ⟶ X} (h : e ≫ p ≫ j = k) :
    (kernelIdealSheaf B S hS k).obj (op ((smallEtalePostcomp B S hS j hj).obj W)) =
      (kernelIdealSheaf B S hS p).obj (op W) := by
  rw [← h, ← Category.assoc, kernelIdealSheaf_comp_obj_smallEtalePostcomp B S hS _ j hj W,
    kernelIdealSheaf_comp_of_isIso]

/-! ### The complement of the boundary of an immersion -/

section Immersion

attribute [local instance] pointTopology

variable {Z' X' X : AlgebraicSpaces B S hS} (i' : Z' ⟶ X') (hi' : IsImmersion B S hS i'.hom)

include hi' in
/-- The complement `X' ∖ ∂Z'` of the boundary of the image of an immersion is an open subspace
of `X'`. -/
theorem isOpenSubspace_immersionAmbient :
    IsOpenSubspace B S hS
      (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))) :=
  isOpenSubspace_boundaryComplement B S hS X'.2
    (isLocallyClosed_range_pointsMap_of_isImmersion B S hS X'.2 i'.hom hi')

/-- **The inclusion of the complement of the boundary of an immersion**, as a morphism of
algebraic spaces. -/
noncomputable def immersionAmbientι :
    immersionAmbient B S hS X'.2 Z'.2 i'.hom hi' ⟶ X' :=
  ObjectProperty.homMk
    (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).ι

/-- The inclusion of the complement of the boundary of an immersion is étale. -/
theorem isEtale_immersionAmbientι : IsEtale B S hS (immersionAmbientι B S hS i' hi').hom :=
  isEtale_ι_of_isOpenSubspace (isOpenSubspace_immersionAmbient B S hS i' hi')

/-- The inclusion of the complement of the boundary of an immersion is a monomorphism. -/
instance mono_immersionAmbientι : Mono (immersionAmbientι B S hS i' hi') :=
  (ObjectProperty.ι _).mono_of_mono_map
    (show Mono (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).ι
      from inferInstance)

/-- The closed factorisation of an immersion followed by the inclusion of the complement of
the boundary is the immersion. -/
theorem immersionClosedFactorization_comp_immersionAmbientι :
    immersionClosedFactorization B S hS X'.2 Z'.2 i'.hom hi' ≫ immersionAmbientι B S hS i' hi' =
      i' :=
  ObjectProperty.hom_ext _ (boundaryComplementLift_comp_ι B S hS X'.2 Z'.2 i'.hom hi')

variable (g : X ⟶ X')

/-- **The base change `g⁻¹(X' ∖ ∂Z')` of the complement of the boundary of an immersion**, as a
subfunctor of `X`. -/
noncomputable abbrev immersionAmbientPreimageSubfunctor : Subfunctor X.1 :=
  (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).preimage g.hom

include hi' in
/-- The base change `g⁻¹(X' ∖ ∂Z')` is an open subspace of `X`. -/
theorem isOpenSubspace_immersionAmbientPreimageSubfunctor :
    IsOpenSubspace B S hS (immersionAmbientPreimageSubfunctor B S hS i' g) :=
  isOpenSubspace_preimage B S hS g.hom _ X'.2 X.2 (isOpenSubspace_immersionAmbient B S hS i' hi')

/-- **The base change `U = g⁻¹(X' ∖ ∂Z')`**, as an algebraic space. -/
noncomputable def immersionAmbientPreimage : AlgebraicSpaces B S hS :=
  ⟨(immersionAmbientPreimageSubfunctor B S hS i' g).toFunctor,
    (isOpenSubspace_immersionAmbientPreimageSubfunctor B S hS i' hi' g).1⟩

/-- The inclusion `g⁻¹(X' ∖ ∂Z') ⟶ X`. -/
noncomputable def immersionAmbientPreimageι : immersionAmbientPreimage B S hS i' hi' g ⟶ X :=
  ObjectProperty.homMk (immersionAmbientPreimageSubfunctor B S hS i' g).ι

/-- The inclusion `g⁻¹(X' ∖ ∂Z') ⟶ X` is étale. -/
theorem isEtale_immersionAmbientPreimageι :
    IsEtale B S hS (immersionAmbientPreimageι B S hS i' hi' g).hom :=
  isEtale_ι_of_isOpenSubspace (isOpenSubspace_immersionAmbientPreimageSubfunctor B S hS i' hi' g)

/-- The inclusion `g⁻¹(X' ∖ ∂Z') ⟶ X` is a monomorphism. -/
instance mono_immersionAmbientPreimageι : Mono (immersionAmbientPreimageι B S hS i' hi' g) :=
  (ObjectProperty.ι _).mono_of_mono_map
    (show Mono (immersionAmbientPreimageSubfunctor B S hS i' g).ι from inferInstance)

/-- The projection `g⁻¹(X' ∖ ∂Z') ⟶ X' ∖ ∂Z'`. -/
noncomputable def immersionAmbientPreimageMap :
    immersionAmbientPreimage B S hS i' hi' g ⟶ immersionAmbient B S hS X'.2 Z'.2 i'.hom hi' :=
  ObjectProperty.homMk
    ((boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).fromPreimage
      g.hom)

/-- The square formed by the projection `g⁻¹(X' ∖ ∂Z') ⟶ X' ∖ ∂Z'`, the two inclusions and `g`
commutes. -/
theorem immersionAmbientPreimageMap_comp_immersionAmbientι :
    immersionAmbientPreimageMap B S hS i' hi' g ≫ immersionAmbientι B S hS i' hi' =
      immersionAmbientPreimageι B S hS i' hi' g ≫ g :=
  ObjectProperty.hom_ext _ (Subfunctor.isPullback_preimage g.hom _).w

/-- The inverse image in `g⁻¹(X' ∖ ∂Z')` of the image of an immersion in `X' ∖ ∂Z'`: the closed
subspace through which the base change of the immersion factors. -/
noncomputable abbrev immersionPreimageSubspace :
    ClosedSubspaces B S hS (immersionAmbientPreimage B S hS i' hi' g).1 :=
  preimageSubspace B S hS (immersionAmbientPreimageMap B S hS i' hi' g)
    (immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi')

/-! ### The kernel ideal sheaf near the image -/

/-- The closed factorisation of an immersion is the isomorphism onto its range followed by the
inclusion of the range. -/
theorem toRange_comp_ι_immersionRangeSubspace :
    Subfunctor.toRange (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi') ≫
        (immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').1.ι =
      boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi' :=
  Subfunctor.toRange_ι _

/-- The closed factorisation of an immersion through the complement of the boundary is a
monomorphism. -/
theorem mono_boundaryComplementLift :
    Mono (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi') :=
  mono_of_isClosedImmersion B S hS _
    (isClosedImmersion_boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi')

/-- The closed factorisation of an immersion is an isomorphism onto its range. -/
instance isIso_toRange_boundaryComplementLift :
    IsIso (Subfunctor.toRange (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi')) :=
  haveI := mono_boundaryComplementLift B S hS i' hi'
  inferInstance

/-- The isomorphism of `Z'` onto the image of the immersion, as a morphism of algebraic
spaces. -/
noncomputable def immersionToRange :
    Z' ⟶ (⟨(immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').1.toFunctor,
      (immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').2.1⟩ : AlgebraicSpaces B S hS) :=
  ObjectProperty.homMk (Subfunctor.toRange (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi'))

/-- The morphism of `Z'` onto the image of the immersion is an isomorphism. -/
instance isIso_immersionToRange : IsIso (immersionToRange B S hS i' hi') := by
  have h : IsIso ((ObjectProperty.ι _).map (immersionToRange B S hS i' hi')) :=
    isIso_toRange_boundaryComplementLift B S hS i' hi'
  exact (ObjectProperty.fullyFaithfulι _).isIso_of_isIso_map (immersionToRange B S hS i' hi')

/-- The isomorphism of `Z'` onto the image of the immersion, followed by the inclusions of the
image into `X' ∖ ∂Z'` and of `X' ∖ ∂Z'` into `X'`, is the immersion. -/
theorem immersionToRange_comp :
    immersionToRange B S hS i' hi' ≫
        (subspaceInclusion B S hS _ (immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi') ≫
          immersionAmbientι B S hS i' hi') = i' :=
  ObjectProperty.hom_ext _ (by
    rw [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.FullSubcategory.comp_hom]
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _)
      (toRange_comp_ι_immersionRangeSubspace B S hS i' hi')).trans
        (boundaryComplementLift_comp_ι B S hS X'.2 Z'.2 i'.hom hi')))

/-- **The kernel ideal sheaf of an immersion near its image is the defining ideal sheaf of its
image.**  On a chart of `X' ∖ ∂Z'`, read as a chart of `X'`, the kernel of `(i')^♯` is the
defining ideal of the image of `i'` in `X' ∖ ∂Z'`. -/
theorem kernelIdealSheaf_obj_immersionAmbient
    (V : SmallEtale B S hS (immersionAmbient B S hS X'.2 Z'.2 i'.hom hi').1) :
    (kernelIdealSheaf B S hS i').obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientι B S hS i' hi')
          (isEtale_immersionAmbientι B S hS i' hi')).obj V)) =
      definingIdealAt B S hS _ (immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi') (op V) :=
  kernelIdealSheaf_obj_postcomp_of_comp_eq B S hS _ _ _ _ V
    (immersionToRange_comp B S hS i' hi')

/-- The pasted square: the inverse image of the image of `i'` in `g⁻¹(X' ∖ ∂Z')`, mapped to `X`,
is the fibre product of `g` with the image of `i'` in `X'`. -/
private theorem isPullback_immersionPreimageSubspace :
    IsPullback
      ((immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').1.fromPreimage
        (immersionAmbientPreimageMap B S hS i' hi' g).hom)
      ((immersionPreimageSubspace B S hS i' hi' g).1.ι ≫
        (immersionAmbientPreimageSubfunctor B S hS i' g).ι)
      ((immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').1.ι ≫
        (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).ι)
      g.hom :=
  (Subfunctor.isPullback_preimage _ _).paste_vert (Subfunctor.isPullback_preimage g.hom _)

variable {Z : AlgebraicSpaces B S hS} {i : Z ⟶ X} {f : Z ⟶ Z'}

/-- **The base change of an immersion along a cartesian square is, up to isomorphism, the
inclusion of the inverse image of the image.** -/
private theorem exists_iso_immersionPreimageSubspace (sq : IsPullback i f g i') :
    ∃ e : Z ⟶ (⟨(immersionPreimageSubspace B S hS i' hi' g).1.toFunctor,
        (immersionPreimageSubspace B S hS i' hi' g).2.1⟩ : AlgebraicSpaces B S hS),
      IsIso e ∧ e ≫ (subspaceInclusion B S hS _ (immersionPreimageSubspace B S hS i' hi' g) ≫
        immersionAmbientPreimageι B S hS i' hi' g) = i := by
  have h₁ : IsPullback f.hom i.hom i'.hom g.hom := (AlgebraicSpaces.isPullback_hom B S hS sq).flip
  have hi'eq : i'.hom = Subfunctor.toRange (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi') ≫
      ((immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').1.ι ≫
        (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).ι) :=
    congrArg (fun k => k.hom) (immersionToRange_comp B S hS i' hi').symm
  have h₂ : IsPullback (f.hom ≫ Subfunctor.toRange
        (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi')) i.hom
      ((immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi').1.ι ≫
        (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).ι) g.hom :=
    h₁.of_iso (Iso.refl _)
      (asIso (Subfunctor.toRange (boundaryComplementLift B S hS X'.2 Z'.2 i'.hom hi')))
      (Iso.refl _) (Iso.refl _) (by simp) (by simp) (by simp [hi'eq]) (by simp)
  let e := h₂.isoIsPullback _ _ (isPullback_immersionPreimageSubspace B S hS i' hi' g)
  refine ⟨ObjectProperty.homMk e.hom,
    ⟨ObjectProperty.homMk e.inv, ObjectProperty.hom_ext _ e.hom_inv_id,
      ObjectProperty.hom_ext _ e.inv_hom_id⟩,
    ObjectProperty.hom_ext _ ?_⟩
  exact h₂.isoIsPullback_hom_snd _ _ (isPullback_immersionPreimageSubspace B S hS i' hi' g)

include hi' in
/-- **The base change of an immersion lands in `g⁻¹(X' ∖ ∂Z')`**: `g ∘ i = i' ∘ f` lands in the
image of `i'`, which lies in `X' ∖ ∂Z'`. -/
theorem range_le_immersionAmbientPreimageSubfunctor (sq : IsPullback i f g i') :
    Subfunctor.range i.hom ≤ immersionAmbientPreimageSubfunctor B S hS i' g := by
  rintro T _ ⟨z, rfl⟩
  have hw : (i ≫ g).hom = (f ≫ i').hom := congrArg (fun k => k.hom) sq.w
  have h1 : g.hom.app T (i.hom.app T z) = i'.hom.app T (f.hom.app T z) :=
    congrArg (fun k : Z.1 ⟶ X'.1 => k.app T z) hw
  change g.hom.app T (i.hom.app T z) ∈
    (boundaryComplement B S hS X'.1 (Set.range (pointsMap B S hS Z'.1 i'.hom))).obj T
  rw [h1]
  exact range_le_boundaryComplement B S hS X'.2 Z'.2 i'.hom hi' T ⟨f.hom.app T z, rfl⟩

/-- **The factorisation of the base change of an immersion through `g⁻¹(X' ∖ ∂Z')`.** -/
noncomputable def immersionAmbientPreimageLift (sq : IsPullback i f g i') :
    Z ⟶ immersionAmbientPreimage B S hS i' hi' g :=
  ObjectProperty.homMk
    (Subfunctor.lift i.hom (range_le_immersionAmbientPreimageSubfunctor B S hS i' hi' g sq))

/-- The factorisation of the base change of an immersion through `g⁻¹(X' ∖ ∂Z')`, followed by the
inclusion `g⁻¹(X' ∖ ∂Z') ⟶ X`, is the base change of the immersion. -/
theorem immersionAmbientPreimageLift_comp (sq : IsPullback i f g i') :
    immersionAmbientPreimageLift B S hS i' hi' g sq ≫ immersionAmbientPreimageι B S hS i' hi' g =
      i :=
  ObjectProperty.hom_ext _
    (Subfunctor.lift_ι i.hom (range_le_immersionAmbientPreimageSubfunctor B S hS i' hi' g sq))

/-- **The kernel ideal sheaf of the base change of an immersion, near the base change of the
image, is the defining ideal sheaf of the inverse image of the image.**  On a chart of
`U = g⁻¹(X' ∖ ∂Z')`, read as a chart of `X`, the kernel of `i^♯` is the defining ideal of the
inverse image in `U` of the image of `i'` in `X' ∖ ∂Z'`. -/
theorem kernelIdealSheaf_obj_immersionAmbientPreimage (sq : IsPullback i f g i')
    (W : SmallEtale B S hS (immersionAmbientPreimage B S hS i' hi' g).1) :
    (kernelIdealSheaf B S hS i).obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W)) =
      definingIdealAt B S hS _ (immersionPreimageSubspace B S hS i' hi' g) (op W) := by
  obtain ⟨e, he, hei⟩ := exists_iso_immersionPreimageSubspace B S hS i' hi' g sq
  exact kernelIdealSheaf_obj_postcomp_of_comp_eq B S hS e _ _ _ W hei

/-- **Over an affine chart diagram near `Z`, the kernel ideal of the base change of an immersion
is generated by the pullback of the kernel ideal of the immersion.**  Let `W` be an étale chart
of `U = g⁻¹(X' ∖ ∂Z')` and `V` an étale chart of `X' ∖ ∂Z'`, both affine, with a morphism
`p : W ⟶ V` over the projection `U ⟶ X' ∖ ∂Z'`.  Read as charts of `X` and `X'`, the kernel
ideal of `i` at `W` is the ideal generated by the pullback along `p` of the kernel ideal of `i'`
at `V`.

Both kernel ideals are defining ideals of closed subspaces there
(`AlgebraicGeometry.Space.kernelIdealSheaf_obj_immersionAmbientPreimage` and
`AlgebraicGeometry.Space.kernelIdealSheaf_obj_immersionAmbient`), the first of the inverse image
of the second, and the defining ideal of an inverse image is generated by the pullback of the
defining ideal (`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`). -/
theorem kernelIdealSheaf_obj_eq_map_of_isPullback (sq : IsPullback i f g i')
    (W : SmallEtale B S hS (immersionAmbientPreimage B S hS i' hi' g).1)
    (V : SmallEtale B S hS (immersionAmbient B S hS X'.2 Z'.2 i'.hom hi').1)
    (p : W.1.left ⟶ V.1.left)
    (hp : yoneda.map p ≫ V.1.hom = W.1.hom ≫ (immersionAmbientPreimageMap B S hS i' hi' g).hom)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left)] :
    (kernelIdealSheaf B S hS i).obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W)) =
      Ideal.map ((BigFppfOver.toScheme B S hS).map p).appTop.hom
        ((kernelIdealSheaf B S hS i').obj
          (op ((smallEtalePostcomp B S hS (immersionAmbientι B S hS i' hi')
            (isEtale_immersionAmbientι B S hS i' hi')).obj V))) := by
  rw [kernelIdealSheaf_obj_immersionAmbientPreimage B S hS i' hi' g sq W,
    kernelIdealSheaf_obj_immersionAmbient B S hS i' hi' V]
  exact definingIdealAt_preimage_eq_map B S hS (immersionAmbientPreimageMap B S hS i' hi' g)
    (immersionRangeSubspace B S hS X'.2 Z'.2 i'.hom hi') V W p hp

end Immersion

end AlgebraicGeometry.Space

end
