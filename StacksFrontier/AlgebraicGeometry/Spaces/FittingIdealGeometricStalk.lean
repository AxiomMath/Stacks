module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartOpenNeighborhood
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleLocalRingChart
public import StacksFrontier.AlgebraicGeometry.Spaces.FittingIdealChain
public import StacksFrontier.RingTheory.Fitting.Rank

/-!
# Local generation and the Fitting ideal at a geometric point

Let `F` be a finite type quasi-coherent module on an algebraic space `X` and let `x̄` be a
geometric point of `X`.  Then `F` can be generated by `r` elements on an étale neighbourhood of
`x̄` exactly when the stalk of `Fit_r(F)` at `x̄` is the whole étale local ring.

## Main definitions

* `AlgebraicGeometry.Space.fittingIdealGeometricStalk` is the stalk `Fit_r(F)_{x̄}`: the ideal of
  the étale local ring generated by the germs of the sections of `Fit_r(F)`.

## Main results

* `AlgebraicGeometry.Space.exists_fin_span_iff_fittingIdealGeometricStalk_eq_top`: **Stacks
  0CZ7**.

## References

* [Stacks Project, Tag 0CZ7](https://stacks.math.columbia.edu/tag/0CZ7)
* [Stacks Project, Tag 0CZ3](https://stacks.math.columbia.edu/tag/0CZ3)
* [Stacks Project, Tag 07ZC](https://stacks.math.columbia.edu/tag/07ZC)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped AlgebraicGeometry

universe u v

/-! ### Clearing denominators in a localization of a finite module -/

/-- **A finite module whose `r`-th Fitting ideal escapes a prime is carried into the span of `r`
of its elements by a single element outside that prime.**

Stacks 07ZC produces `r` elements spanning the localization away from some `f ∉ p`; clearing
denominators on a finite generating family of the module replaces `f` by a power of itself
which carries all of the module into the span. -/
theorem exists_notMem_forall_smul_mem_span_of_fittingIdeal_not_le
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (r : ℕ) (p : Ideal R) [hp : p.IsPrime]
    (h : ¬ fittingIdeal (R := R) (M := M) (r : ℤ) ≤ p) :
    ∃ f : R, f ∉ p ∧ ∃ m : Fin r → M,
      ∀ y : M, f • y ∈ Submodule.span R (Set.range m) := by
  classical
  obtain ⟨f₀, hf₀, g, hg⟩ :=
    ((fittingIdeal_local_generation_tfae (R := R) (M := M) r p).out 1 4).mp h
  choose c hc using fun i : Fin r => IsLocalizedModule.mk'_surjective
    (Submonoid.powers f₀) (LocalizedModule.mkLinearMap (Submonoid.powers f₀) M) (g i)
  set a : Fin r → M := fun i => (c i).1
  have hspan : Submodule.span (Localization.Away f₀)
      (Set.range fun i => LocalizedModule.mkLinearMap (Submonoid.powers f₀) M (a i)) = ⊤ := by
    refine top_unique ?_
    rw [← hg]
    refine Submodule.span_le.2 ?_
    rintro - ⟨i, rfl⟩
    obtain ⟨w, hw⟩ : IsUnit (algebraMap R (Localization.Away f₀) ((c i).2 : R)) :=
      IsLocalization.map_units _ (c i).2
    have hcancel : (w : Localization.Away f₀) • g i =
        LocalizedModule.mkLinearMap (Submonoid.powers f₀) M (a i) := by
      rw [hw, algebraMap_smul, ← hc i]
      exact IsLocalizedModule.mk'_cancel' _ (c i).1 (c i).2
    have hgi : g i = ((w⁻¹ : (Localization.Away f₀)ˣ) : Localization.Away f₀) •
        LocalizedModule.mkLinearMap (Submonoid.powers f₀) M (a i) := by
      rw [← hcancel, smul_smul, Units.inv_mul, one_smul]
    rw [hgi]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have key : ∀ y : M, ∃ t : Submonoid.powers f₀,
      (t : R) • y ∈ Submodule.span R (Set.range a) := by
    intro y
    have hmem : LocalizedModule.mkLinearMap (Submonoid.powers f₀) M y ∈
        Submodule.localized' (Localization.Away f₀) (Submonoid.powers f₀)
          (LocalizedModule.mkLinearMap (Submonoid.powers f₀) M)
          (Submodule.span R (Set.range a)) := by
      rw [Submodule.localized'_span, ← Set.range_comp]
      exact hspan.symm ▸ Submodule.mem_top
    obtain ⟨n, hn, t, ht⟩ := (Submodule.mem_localized' _ _ _ _ _).1 hmem
    have h1 : LocalizedModule.mkLinearMap (Submonoid.powers f₀) M n =
        (t : R) • LocalizedModule.mkLinearMap (Submonoid.powers f₀) M y := by
      rw [← ht]
      exact (IsLocalizedModule.mk'_cancel' _ n t).symm
    have h2 : LocalizedModule.mkLinearMap (Submonoid.powers f₀) M (n - (t : R) • y) = 0 := by
      rw [map_sub, map_smul, h1, sub_self]
    obtain ⟨t', ht'⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers f₀) _).1 h2
    refine ⟨t' * t, ?_⟩
    have h3 : (t' : R) • n - (t' : R) • ((t : R) • y) = 0 := by
      rw [← smul_sub]
      simpa [Submonoid.smul_def] using ht'
    have h4 : ((t' * t : Submonoid.powers f₀) : R) • y = (t' : R) • n := by
      rw [Submonoid.coe_mul, mul_smul]
      exact (sub_eq_zero.1 h3).symm
    rw [h4]
    exact Submodule.smul_mem _ _ hn
  obtain ⟨n, z, hz⟩ := Module.Finite.exists_fin (R := R) (M := M)
  choose t ht using fun j : Fin n => key (z j)
  obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ f₀).1
    (Submonoid.prod_mem _ fun j _ => (t j).2 : ∏ j, (t j : R) ∈ Submonoid.powers f₀)
  refine ⟨∏ j, (t j : R), fun hmem => hf₀ (hp.mem_of_pow_mem k (hk ▸ hmem)), a, fun y => ?_⟩
  have hsub : Submodule.span R (Set.range z) ≤
      (Submodule.span R (Set.range a)).comap (LinearMap.lsmul R M (∏ j, (t j : R))) := by
    refine Submodule.span_le.2 ?_
    rintro - ⟨j, rfl⟩
    have hfac : (∏ j', (t j' : R)) = (∏ j' ∈ Finset.univ.erase j, (t j' : R)) * (t j : R) := by
      rw [mul_comm]
      exact (Finset.mul_prod_erase Finset.univ (fun j' => (t j' : R)) (Finset.mem_univ j)).symm
    show (∏ j', (t j' : R)) • z j ∈ Submodule.span R (Set.range a)
    rw [hfac, mul_smul]
    exact Submodule.smul_mem _ _ (ht j)
  exact hsub (hz.ge Submodule.mem_top)

/-! ### Nowhere-vanishing global sections -/

/-- **A global section of a scheme which vanishes at no point is a unit.**  It is a unit on a
neighbourhood of every point, and the local inverses glue. -/
theorem AlgebraicGeometry.Scheme.isUnit_of_basicOpen_eq_top {X : Scheme.{u}} (a : Γ(X, ⊤))
    (h : X.basicOpen a = ⊤) : IsUnit a :=
  RingedSpace.isUnit_of_isUnit_germ X.toLocallyRingedSpace.toRingedSpace ⊤ a fun z hz =>
    (RingedSpace.mem_basicOpen X.toLocallyRingedSpace.toRingedSpace a z hz).1 (h.ge hz)

/-! ### The stalk of the Fitting ideal sheaf at a geometric point -/

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-- The sections of the `r`-th Fitting ideal sheaf over an étale chart, read as an ideal of the
chart ring.  The declared type is what makes the ideal operations on these sections elaborate. -/
noncomputable abbrev fittingIdealSections (G : Modules.{u, u} B S hS F hF) (r : ℕ)
    (U : SmallEtale B S hS F) : Ideal (chartRing B S hS F hF U) :=
  (fittingIdeal B S hS F hF G r).toSubmodule.obj (op U)

/-- The stalk `Fit_r(G)_{x̄}` of the `r`-th Fitting ideal sheaf of an `𝒪_F`-module at a geometric
point: the ideal of the étale local ring generated by the germs of the sections of `Fit_r(G)`
over the small étale neighbourhoods of the point. -/
noncomputable def fittingIdealGeometricStalk (G : Modules.{u, u} B S hS F hF) (r : ℕ)
    (x : GeometricPoint B S hS F) : Ideal (etaleLocalRing B S hS F x) :=
  Ideal.span {z | ∃ (U : SmallEtaleNeighborhood x) (a : chartRing B S hS F hF U.chart),
    a ∈ fittingIdealSections G r U.chart ∧ etaleLocalRingGerm B S hS F x (op U) a = z}

/-- The germ of a regular function is unchanged by restricting it to a refinement of the small
étale neighbourhood. -/
theorem etaleLocalRingGerm_chartRestrict {x : GeometricPoint B S hS F}
    {U V : SmallEtaleNeighborhood x} (φ : V ⟶ U) (a : chartRing B S hS F hF U.chart) :
    etaleLocalRingGerm B S hS F x (op V) (chartRestrict (hF := hF) φ.hom a) =
      etaleLocalRingGerm B S hS F x (op U) a :=
  DFunLike.congr_fun (spaceGerm_naturality (x := x) (B := B) (S := S) (hS := hS) (F := F)
    (U := op U) (W := op V) φ.op) a

/-- A section of the Fitting ideal sheaf restricts to one over any refinement of the chart. -/
theorem chartRestrict_mem_fittingIdealSections (G : Modules.{u, u} B S hS F hF) (r : ℕ)
    {U V : SmallEtale B S hS F} (g : V ⟶ U) {a : chartRing B S hS F hF U}
    (ha : a ∈ fittingIdealSections G r U) :
    chartRestrict (hF := hF) g a ∈ fittingIdealSections G r V :=
  (fittingIdeal B S hS F hF G r).toSubmodule.map_mem g.op ha

/-- If a section of the Fitting ideal sheaf restricts to `1` on a refinement of the chart, the
sheaf is the unit ideal there. -/
private theorem fittingIdealSections_eq_top_of_chartRestrict_eq_one
    (G : Modules.{u, u} B S hS F hF) (r : ℕ) {U V : SmallEtale B S hS F} (g : V ⟶ U)
    {a : chartRing B S hS F hF U} (ha : a ∈ fittingIdealSections G r U)
    (h : chartRestrict (hF := hF) g a = 1) : fittingIdealSections G r V = ⊤ :=
  Ideal.eq_top_iff_one _ |>.2 (h ▸ chartRestrict_mem_fittingIdealSections G r g ha)

/-- Every element of the stalk of the Fitting ideal sheaf is the germ of a single section of that
sheaf over one small étale neighbourhood: the germs of such sections already form an ideal,
because the neighbourhoods are cofiltered and every element of the étale local ring is itself a
germ. -/
theorem exists_germ_of_mem_fittingIdealGeometricStalk (G : Modules.{u, u} B S hS F hF) (r : ℕ)
    (x : GeometricPoint B S hS F) {z : etaleLocalRing B S hS F x}
    (hz : z ∈ fittingIdealGeometricStalk G r x) :
    ∃ (U : SmallEtaleNeighborhood x) (a : chartRing B S hS F hF U.chart),
      a ∈ fittingIdealSections G r U.chart ∧ etaleLocalRingGerm B S hS F x (op U) a = z := by
  have hcof : IsCofiltered (SmallEtaleNeighborhood x) :=
    isCofiltered_smallEtaleNeighborhood B S hS F hF x
  induction hz using Submodule.span_induction with
  | mem z hz => exact hz
  | zero =>
      obtain ⟨U⟩ := IsCofiltered.nonempty (C := SmallEtaleNeighborhood x)
      exact ⟨U, 0, Submodule.zero_mem _, map_zero _⟩
  | add z w _ _ hz hw =>
      obtain ⟨U, a, ha, rfl⟩ := hz
      obtain ⟨V, b, hb, rfl⟩ := hw
      obtain ⟨W, k, l, -⟩ := IsCofilteredOrEmpty.cone_objs U V
      refine ⟨W, chartRestrict (hF := hF) k.hom a + chartRestrict (hF := hF) l.hom b,
        Submodule.add_mem _ (chartRestrict_mem_fittingIdealSections G r k.hom ha)
          (chartRestrict_mem_fittingIdealSections G r l.hom hb), ?_⟩
      refine Eq.trans (map_add (etaleLocalRingGerm B S hS F x (op W)) _ _) ?_
      rw [etaleLocalRingGerm_chartRestrict k a, etaleLocalRingGerm_chartRestrict l b]
  | smul c z _ hz =>
      obtain ⟨U, a, ha, rfl⟩ := hz
      obtain ⟨V, d, hd⟩ := (spaceGerms_isColimit (x := x) hF).ι_jointly_surjective c
      obtain ⟨W, k, l, -⟩ := IsCofilteredOrEmpty.cone_objs U V.unop
      refine ⟨W, chartRestrict (hF := hF) l.hom d * chartRestrict (hF := hF) k.hom a,
        Ideal.mul_mem_left _ _ (chartRestrict_mem_fittingIdealSections G r k.hom ha), ?_⟩
      refine Eq.trans (map_mul (etaleLocalRingGerm B S hS F x (op W)) _ _) ?_
      rw [etaleLocalRingGerm_chartRestrict k a, etaleLocalRingGerm_chartRestrict l d, ← hd,
        smul_eq_mul]

/-- **The stalk of the Fitting ideal sheaf at a geometric point is the unit ideal exactly when
the Fitting ideal sheaf is the unit ideal over some small étale neighbourhood of the point.**

The étale local ring is the filtered colimit of the rings of regular functions on the
neighbourhoods, so a germ equals `1` exactly when the section itself becomes `1` on a
refinement. -/
theorem fittingIdealGeometricStalk_eq_top_iff (G : Modules.{u, u} B S hS F hF) (r : ℕ)
    (x : GeometricPoint B S hS F) :
    fittingIdealGeometricStalk G r x = ⊤ ↔
      ∃ U : SmallEtaleNeighborhood x, fittingIdealSections G r U.chart = ⊤ := by
  have hcof : IsCofiltered (SmallEtaleNeighborhood x) :=
    isCofiltered_smallEtaleNeighborhood B S hS F hF x
  refine ⟨fun h => ?_, ?_⟩
  · obtain ⟨U, a, ha, hga⟩ := exists_germ_of_mem_fittingIdealGeometricStalk G r x
      (Submodule.eq_top_iff'.1 h 1)
    have hc := spaceGerms_isColimit (x := x) hF
    have h1 : etaleLocalRingGerm B S hS F x (op U) a =
        etaleLocalRingGerm B S hS F x (op U) 1 := by
      rw [hga, map_one]
    have h2 : (spaceSections (x := x) ⋙ forget CommRingCat.{u}).ιColimitType (op U) a =
        (spaceSections (x := x) ⋙ forget CommRingCat.{u}).ιColimitType (op U) 1 := by
      rw [← hc.equiv_symm_ι_apply (op U) a, ← hc.equiv_symm_ι_apply (op U) 1]
      exact congrArg hc.equiv.symm h1
    obtain ⟨W, k, hk⟩ :=
      (Functor.ιColimitType_eq_iff_of_isFiltered'
        (spaceSections (x := x) ⋙ forget CommRingCat.{u}) a 1).1 h2
    exact ⟨W.unop, fittingIdealSections_eq_top_of_chartRestrict_eq_one G r k.unop.hom ha
      (hk.trans (map_one (chartRestrict (hF := hF) k.unop.hom)))⟩
  · rintro ⟨U, hU⟩
    refine Ideal.eq_top_iff_one _ |>.2 (Ideal.subset_span ⟨U, 1, ?_, map_one _⟩)
    exact Ideal.eq_top_iff_one _ |>.1 hU


/-! ### Shrinking a chart until the module is generated by `r` sections -/

/-- The prime ideal of the chart ring of a small étale neighbourhood at the point below the
geometric point: the contraction of the maximal ideal of the Zariski local ring there. -/
noncomputable def chartPrime (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)
    {x : GeometricPoint B S hS F} (U : SmallEtaleNeighborhood x) :
    Ideal (chartRing B S hS F hF U.chart) :=
  Ideal.comap ((chartScheme U.chart).presheaf.germ ⊤ (chartPoint B S hS F U) trivial).hom
    (IsLocalRing.maximalIdeal ((chartScheme U.chart).presheaf.stalk (chartPoint B S hS F U)))

/-- The ideal `chartPrime` of a small étale neighbourhood is a prime ideal. -/
instance chartPrime_isPrime {x : GeometricPoint B S hS F} (U : SmallEtaleNeighborhood x) :
    (chartPrime B S hS F hF U).IsPrime :=
  Ideal.IsPrime.comap _

/-- A regular function on the chart lies outside the prime at the chart point exactly when the
chart point lies in its nonvanishing locus. -/
theorem notMem_chartPrime_iff {x : GeometricPoint B S hS F} (U : SmallEtaleNeighborhood x)
    (a : chartRing B S hS F hF U.chart) :
    a ∉ chartPrime B S hS F hF U ↔
      chartPoint B S hS F U ∈ (chartScheme U.chart).basicOpen a :=
  ⟨fun ha => (Scheme.mem_basicOpen_top (chartScheme U.chart) a (chartPoint B S hS F U)).2
      (IsLocalRing.notMem_maximalIdeal.1 ha),
    fun hmem => IsLocalRing.notMem_maximalIdeal.2
      ((Scheme.mem_basicOpen_top (chartScheme U.chart) a (chartPoint B S hS F U)).1 hmem)⟩

/-- Every small étale neighbourhood of a geometric point is refined by a Zariski open of its own
chart whose scheme is affine. -/
theorem exists_affine_chartOpenNeighborhood {x : GeometricPoint B S hS F}
    (U : SmallEtaleNeighborhood x) :
    ∃ (W : (chartScheme U.chart).Opens) (hw : chartPoint B S hS F U ∈ W),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj
        (chartOpenNeighborhood B S hS U W hw).chart) := by
  obtain ⟨-, ⟨W, hW, rfl⟩, hwW, -⟩ :=
    (chartScheme U.chart).isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ (chartPoint B S hS F U)) isOpen_univ
  have hWaff : IsAffineOpen W := by simpa [Scheme.affineOpens] using hW
  exact ⟨W, hwW, hWaff⟩

/-- Restriction to a Zariski open of a chart is the pullback of global functions along the
inclusion of that open. -/
theorem chartRestrict_chartOpenNeighborhoodHom {x : GeometricPoint B S hS F}
    (U : SmallEtaleNeighborhood x) (W : (chartScheme U.chart).Opens)
    (hw : chartPoint B S hS F U ∈ W) (a : chartRing B S hS F hF U.chart) :
    chartRestrict (hF := hF) (chartOpenNeighborhoodHom B S hS U W hw).hom a =
      W.ι.appTop a :=
  rfl

/-- **A section of the structure sheaf of a chart becomes invertible on its own nonvanishing
locus.** -/
theorem isUnit_chartRestrict_basicOpen {x : GeometricPoint B S hS F}
    (U : SmallEtaleNeighborhood x) (a : chartRing B S hS F hF U.chart)
    (hw : chartPoint B S hS F U ∈ (chartScheme U.chart).basicOpen a) :
    IsUnit (chartRestrict (hF := hF)
      (chartOpenNeighborhoodHom B S hS U ((chartScheme U.chart).basicOpen a) hw).hom a) := by
  rw [chartRestrict_chartOpenNeighborhoodHom]
  refine Scheme.isUnit_of_basicOpen_eq_top _ ?_
  exact Eq.trans
    (Scheme.preimage_basicOpen_top ((chartScheme U.chart).basicOpen a).ι a).symm
    (Scheme.Opens.ι_preimage_self ((chartScheme U.chart).basicOpen a))


/-- **Shrinking an affine chart until the module is generated by `r` sections.**  If the `r`-th
chartwise Fitting ideal over an affine étale neighbourhood of a geometric point is the unit
ideal, then the sections of the module over a smaller affine étale neighbourhood are spanned by
`r` elements.

The unit ideal escapes the prime at the chart point, so Stacks 07ZC carries the sections into
the span of `r` of them after multiplication by a function `f` not vanishing there; on the
nonvanishing locus of `f` that function is invertible, and the sections of the module there are
generated by the restricted sections because the module is cartesian on affine charts. -/
theorem exists_affine_span_eq_top_of_fittingIdealOnChart_eq_top
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G) (r : ℕ)
    {x : GeometricPoint B S hS F} (U : SmallEtaleNeighborhood x)
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U.chart))
    (hfinU : Module.Finite (chartRing B S hS F hF U.chart) (G.val.obj (op U.chart)))
    (htop : @fittingIdealOnChart B S hS F hF G r U.chart hfinU = ⊤) :
    ∃ V : SmallEtaleNeighborhood x,
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V.chart) ∧
        ∃ s : Fin r → G.val.obj (op V.chart),
          Submodule.span (chartRing B S hS F hF V.chart) (Set.range s) = ⊤ := by
  have hUaff : IsAffine (chartScheme U.chart) := hU
  have := hfinU
  have hnotle : ¬ _root_.fittingIdeal (R := chartRing B S hS F hF U.chart)
      (M := G.val.obj (op U.chart)) (r : ℤ) ≤ chartPrime B S hS F hF U := fun hle =>
    (chartPrime_isPrime U).ne_top (top_unique (htop.symm.le.trans hle))
  obtain ⟨f, hf, m, hm⟩ := exists_notMem_forall_smul_mem_span_of_fittingIdeal_not_le
    (M := G.val.obj (op U.chart)) r (chartPrime B S hS F hF U) hnotle
  have hw : chartPoint B S hS F U ∈ (chartScheme U.chart).basicOpen f :=
    (notMem_chartPrime_iff U f).1 hf
  have hVaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj
      (chartOpenNeighborhood B S hS U ((chartScheme U.chart).basicOpen f) hw).chart) :=
    (isAffineOpen_top (chartScheme U.chart)).basicOpen f
  have hunit := isUnit_chartRestrict_basicOpen U f hw
  let φ := chartOpenNeighborhoodHom B S hS U ((chartScheme U.chart).basicOpen f) hw
  let _ := chartAlgebra (hF := hF) φ.hom
  let _ := chartSectionsModule G φ.hom
  have hsmul : ∀ (c : chartRing B S hS F hF U.chart) (y : G.val.obj (op U.chart)),
      chartRestrictLinear G φ.hom (c • y) =
        chartRestrict (hF := hF) φ.hom c • chartRestrictLinear G φ.hom y := fun c y =>
    (map_smul (chartRestrictLinear G φ.hom) c y).trans
      (chartSectionsModule_smul G φ.hom c (chartRestrictLinear G φ.hom y))
  refine ⟨_, hVaff, fun i => chartRestrictLinear G φ.hom (m i), top_unique ?_⟩
  rw [← (chartBaseChange_surjective_iff_span_eq_top G φ.hom).1
    (hG U.chart _ hU hVaff φ.hom).2]
  refine Submodule.span_le.2 ?_
  rintro - ⟨y, rfl⟩
  have hmapmem : ∀ z ∈ Submodule.span (chartRing B S hS F hF U.chart) (Set.range m),
      chartRestrictLinear G φ.hom z ∈ Submodule.span
        (chartRing B S hS F hF
          (chartOpenNeighborhood B S hS U ((chartScheme U.chart).basicOpen f) hw).chart)
        (Set.range fun i => chartRestrictLinear G φ.hom (m i)) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨i, rfl⟩ := hz
        exact Submodule.subset_span ⟨i, rfl⟩
    | zero =>
        rw [map_zero]
        exact Submodule.zero_mem _
    | add z w _ _ h1 h2 =>
        rw [map_add]
        exact Submodule.add_mem _ h1 h2
    | smul c z _ h1 =>
        rw [hsmul]
        exact Submodule.smul_mem _ _ h1
  have hy := hmapmem _ (hm y)
  rw [hsmul] at hy
  exact (Submodule.smul_mem_iff_of_isUnit _ hunit).1 hy

/-! ### Stacks 0CZ7 -/

/-- **Stacks 0CZ7.**  Let `G` be a finite type quasi-coherent `𝒪_X`-module on an algebraic space
`X` and let `x̄` be a geometric point of `X`.  Then `G` can be generated by `r` elements on an
affine étale neighbourhood of `x̄` if and only if the stalk `Fit_r(G)_{x̄}` of its `r`-th Fitting
ideal is the whole étale local ring `𝒪_{X, x̄}`.

The finiteness of the sections over every affine étale chart is the étale-local reading of
finite type used by the conventions of Stacks 0CZ3, under which the Fitting ideals are defined
chartwise; `hG` is the cartesian property of Stacks 03DX, which a quasi-coherent module has by
`AlgebraicGeometry.Space.isCartesianOnAffineCharts_of_isQuasicoherentOnSite`. -/
@[stacks 0CZ7]
theorem exists_fin_span_iff_fittingIdealGeometricStalk_eq_top
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (hfin : ∀ W : SmallEtale B S hS F,
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) (G.val.obj (op W)))
    (r : ℕ) (x : GeometricPoint B S hS F) :
    (∃ U : SmallEtaleNeighborhood x,
        IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U.chart) ∧
          ∃ s : Fin r → G.val.obj (op U.chart),
            Submodule.span (chartRing B S hS F hF U.chart) (Set.range s) = ⊤) ↔
      fittingIdealGeometricStalk G r x = ⊤ := by
  classical
  rw [fittingIdealGeometricStalk_eq_top_iff]
  refine ⟨?_, ?_⟩
  · rintro ⟨U, hUaff, s, hs⟩
    have hfinU : Module.Finite (chartRing B S hS F hF U.chart) (G.val.obj (op U.chart)) :=
      ⟨⟨Finset.univ.image s, by rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ]⟩⟩
    have htop : @fittingIdealOnChart B S hS F hF G r U.chart hfinU = ⊤ :=
      (fittingIdeal_basic_properties.{u, u, u, u}
        (R := chartRing B S hS F hF U.chart) (M := G.val.obj (op U.chart))).1 r ⟨s, hs⟩
    refine ⟨U, Ideal.eq_top_iff_one _ |>.2 ?_⟩
    exact mem_fittingIdeal_of_mem_fittingIdealOnChart G r U.chart hUaff 1
      (htop.ge Submodule.mem_top)
  · rintro ⟨U, hUtop⟩
    obtain ⟨W₀, hw₀, hW₀aff⟩ := exists_affine_chartOpenNeighborhood U
    have hU'top := fittingIdealSections_eq_top_of_chartRestrict_eq_one G r
      (chartOpenNeighborhoodHom B S hS U W₀ hw₀).hom (Ideal.eq_top_iff_one _ |>.1 hUtop)
      (map_one _)
    refine exists_affine_span_eq_top_of_fittingIdealOnChart_eq_top G hG r _ hW₀aff
      (hfin _ hW₀aff) ?_
    rwa [← fittingIdeal_obj_eq_fittingIdealOnChart G hG hfin r hW₀aff]

end AlgebraicGeometry.Space

end
