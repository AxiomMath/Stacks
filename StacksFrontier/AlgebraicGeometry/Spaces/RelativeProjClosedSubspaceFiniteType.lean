* [Stacks Project, Tag 0849](https://stacks.math.columbia.edu/tag/0849)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

section Products

variable (s : RelativeProjSituation.{u, u}) (d e : ℤ)

/-- The set of products `a · b` of a local section `a` of `ℱ ⊆ 𝒜_d` with a local section `b` of
`𝒜_e`, over an object of the small étale site: the homogeneous generators of the graded ideal
`ℱ𝒜` in degree `d + e`. -/
def degreeProductSet (ℱ : (s.algebra.piece d).Submodule)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ) :
    Set ((s.algebra.piece (d + e)).val.obj U) :=
  {x | ∃ a ∈ ℱ.obj U, ∃ b : (s.algebra.piece e).val.obj U,
    x = (s.algebra.mul d e).app U a b}

/-- The objectwise submodule of `𝒜_{d+e}` spanned by the products of the local sections of
`ℱ ⊆ 𝒜_d` with the local sections of `𝒜_e`.

Its membership condition is stable under restriction, because the product of two restricted
sections is the restriction of their product, but it need not be local; the graded ideal is its
closure. -/
def presheafDegreeProducts (ℱ : (s.algebra.piece d).Submodule) :
    (s.algebra.piece (d + e)).val.Submodule where
  obj U := Submodule.span _ (degreeProductSet s d e ℱ U)
  map {U V} g := by
    intro x hx
    rw [Submodule.mem_comap]
    change (s.algebra.piece (d + e)).val.map g x ∈
      Submodule.span _ (degreeProductSet s d e ℱ V)
    induction hx using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨a, ha, b, rfl⟩ := hy
        exact Submodule.subset_span
          ⟨(s.algebra.piece d).val.map g a, ℱ.toSubmodule.map_mem g ha,
            (s.algebra.piece e).val.map g b, (s.algebra.mul d e).naturality g a b⟩
    | zero =>
        rw [show (s.algebra.piece (d + e)).val.map g
            (0 : (s.algebra.piece (d + e)).val.obj U) = 0 from map_zero _]
        exact Submodule.zero_mem _
    | add y z _ _ ihy ihz =>
        rw [show (s.algebra.piece (d + e)).val.map g (y + z) =
            (s.algebra.piece (d + e)).val.map g y +
              (s.algebra.piece (d + e)).val.map g z from map_add _ _ _]
        exact Submodule.add_mem _ ihy ihz
    | smul c y _ ih =>
        exact Eq.mpr
          (congrArg (· ∈ Submodule.span _ (degreeProductSet s d e ℱ V))
            ((s.algebra.piece (d + e)).val.map_smul g c y))
          (Submodule.smul_mem _ _ ih)

/-- **The graded ideal `ℱ𝒜` generated by a submodule `ℱ ⊆ 𝒜_d` of one homogeneous piece**, in
degree `d + e`: the smallest submodule of `𝒜_{d+e}` with local membership containing every
product of a local section of `ℱ` with a local section of `𝒜_e`.

This is the ideal appearing in the conclusion `Z = Proj_X(𝒜/ℱ𝒜)` of Stacks 085M. -/
def closedSubspaceDegreeProducts (ℱ : (s.algebra.piece d).Submodule) :
    (s.algebra.piece (d + e)).Submodule :=
  Stacks.SheafOfModules.sheafifySubmodule (presheafDegreeProducts s d e ℱ)

variable {s d e}

/-- The product of a local section of `ℱ ⊆ 𝒜_d` with a local section of `𝒜_e` is a local section
of the graded ideal generated by `ℱ`. -/
theorem mul_mem_closedSubspaceDegreeProducts {ℱ : (s.algebra.piece d).Submodule}
    {U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ}
    {a : (s.algebra.piece d).val.obj U} (ha : a ∈ ℱ.obj U)
    (b : (s.algebra.piece e).val.obj U) :
    (s.algebra.mul d e).app U a b ∈ (closedSubspaceDegreeProducts s d e ℱ).obj U :=
  Stacks.SheafOfModules.le_sheafifySubmodule (presheafDegreeProducts s d e ℱ) U
    (Submodule.subset_span ⟨a, ha, b, rfl⟩)

/-- **The graded ideal generated by `ℱ ⊆ 𝒜_d` is the smallest one containing the products.**  A
submodule of `𝒜_{d+e}` with local membership which contains every product of a local section of
`ℱ` with a local section of `𝒜_e` contains the whole of `ℱ𝒜` in degree `d + e`. -/
theorem closedSubspaceDegreeProducts_le {ℱ : (s.algebra.piece d).Submodule}
    {K : (s.algebra.piece (d + e)).Submodule}
    (h : ∀ (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
      (a : (s.algebra.piece d).val.obj U), a ∈ ℱ.obj U →
      ∀ b : (s.algebra.piece e).val.obj U, (s.algebra.mul d e).app U a b ∈ K.obj U) :
    closedSubspaceDegreeProducts s d e ℱ ≤ K := by
  refine Stacks.SheafOfModules.sheafifySubmodule_le fun U => Submodule.span_le.2 ?_
  rintro _ ⟨a, ha, b, rfl⟩
  exact h U a ha b

/-- The graded ideal generated in degree `d` grows with the submodule generating it. -/
theorem closedSubspaceDegreeProducts_mono {ℱ ℱ' : (s.algebra.piece d).Submodule}
    (hle : ℱ ≤ ℱ') :
    closedSubspaceDegreeProducts s d e ℱ ≤ closedSubspaceDegreeProducts s d e ℱ' :=
  closedSubspaceDegreeProducts_le fun _ _ ha b =>
    mul_mem_closedSubspaceDegreeProducts (hle _ ha) b

/-- **Stacks 085M, the containment `Z ⊆ Proj_X(𝒜/ℱ𝒜)`, in graded-ideal form.**

Let `ψ : 𝒜 ⟶ ℬ` be a degreewise map of graded `𝒪_X`-algebras which is multiplicative in the
bidegree `(d, e)`, and suppose every local section of `ℱ ⊆ 𝒜_d` is killed by `ψ` — that is, `ℱ`
consists of equations for the closed subspace `ℬ` presents.  Then every local section of the
graded ideal `ℱ𝒜` in degree `d + e` is killed by `ψ` as well, so `ℱ𝒜` is contained in the graded
ideal of that closed subspace.

This is the step of the source's proof reading "`Z ⊆ Z'` since `ℱ𝒜 ⊆ ℐ`".  Its content is the
passage from the objectwise products to the ideal they generate: the kernel of `ψ` has local
membership, so a section of `𝒜_{d+e}` that is only *locally* a sum of products `a · b` with
`a` a section of `ℱ` is killed by `ψ` too.

Neither the degree `d > 0` nor the finite type submodule `ℱ` of the source's conclusion is
produced here; see *What is not proved* in the module documentation. -/
@[stacks 085M "the containment Z ⊆ Proj_X(𝒜/ℱ𝒜) in graded-ideal form: the graded ideal ℱ𝒜 \
generated by ℱ ⊆ 𝒜_d is killed by every degreewise, bidegree-(d,e)-multiplicative map of graded \
algebras killing ℱ. The existence of d > 0 and of the finite type quasi-coherent ℱ is not \
claimed"]
theorem closedSubspaceDegreeProducts_le_ker
    {ℬ : SheafOfModules.GradedAlgebra.{u, u, u, u + 1}
      (structureRingSheaf s.site s.base s.containsBase s.space)}
    (ψ : ∀ n : ℤ, s.algebra.piece n ⟶ ℬ.piece n)
    (hmul : ∀ (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
      (a : (s.algebra.piece d).val.obj U) (b : (s.algebra.piece e).val.obj U),
      (ψ (d + e)).val.app U ((s.algebra.mul d e).app U a b) =
        (ℬ.mul d e).app U ((ψ d).val.app U a) ((ψ e).val.app U b))
    {ℱ : (s.algebra.piece d).Submodule}
    (hℱ : ℱ ≤ Stacks.SheafOfModules.kerSubmodule (ψ d)) :
    closedSubspaceDegreeProducts s d e ℱ ≤
      Stacks.SheafOfModules.kerSubmodule (ψ (d + e)) := by
  refine closedSubspaceDegreeProducts_le fun U a ha b => ?_
  have hzero : (ψ d).val.app U a = 0 :=
    (Stacks.SheafOfModules.mem_kerSubmodule_obj (ψ d) U a).1 (hℱ U ha)
  refine (Stacks.SheafOfModules.mem_kerSubmodule_obj (ψ (d + e)) U _).2 ?_
  rw [hmul U a b, hzero, map_zero, AddMonoidHom.zero_apply]

end Products

/-! ### The assertion `Z = Proj_X(𝒜/ℱ𝒜)`, as hypothesis data -/

/-- **The conclusion `Z = Proj_X(𝒜/ℱ𝒜)` of Stacks 085M, as data.**

A graded algebra `ℬ` on `X` together with a degreewise map `𝒜 ⟶ ℬ`, multiplicative in the
bidegrees `(d, e)`, surjective in every degree and with kernel the graded ideal `ℱ𝒜` generated by
`ℱ ⊆ 𝒜_d`; an algebraic space playing the part of `Proj_X(ℬ)` together with a closed immersion of
it into the ambient relative Proj; and an identification of the closed subspace `Z` with that
space over `P`.

Nothing here is proved.  This mirrors
`AlgebraicGeometry.Space.ClosedSubspaceQuotientPresentation`, which carries the corresponding
assertion of Stacks 085L, and the scheme-level
`Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.DegreeQuotientPresentation`, which carries the
assertion of Stacks 0802, in the same shape and for the same reason: all three predate the
construction of `Proj_X(𝒜/ℐ)` on an algebraic space, so the space had to be carried.  That
construction is now `AlgebraicGeometry.Space.RelativeProjSituation.quotient`, with its closed
immersion `…quotientProjHom`; this structure is kept for the statements written against it.
The degrees below `d` are constrained through
`ker_eq` only at the degrees `d + e`; in the degrees `0 ≤ n < d` the ideal generated in degree `d`
is zero, and `𝒜` is concentrated in nonnegative degrees. -/
structure ClosedSubspaceDegreeQuotientPresentation {s : RelativeProjSituation.{u, u}}
    {P : AlgebraicSpaces s.site s.base s.containsBase}
    {Z : AlgebraicSpaces s.site s.base s.containsBase} (i : Z ⟶ P) {d : ℕ} (hd : 0 < d)
    (ℱ : (s.algebra.piece (d : ℤ)).Submodule) where
  /-- The quotient graded algebra `ℬ = 𝒜/ℱ𝒜`. -/
  quotient : SheafOfModules.GradedAlgebra.{u, u, u, u + 1}
    (structureRingSheaf s.site s.base s.containsBase s.space)
  /-- The quotient homomorphism, degreewise. -/
  quotientMap (n : ℤ) : s.algebra.piece n ⟶ quotient.piece n
  /-- It is an epimorphism in each degree. -/
  epi (n : ℤ) : Epi (quotientMap n)
  /-- It is multiplicative on the products the graded ideal is generated by. -/
  map_mul (e : ℤ) (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
      (a : (s.algebra.piece (d : ℤ)).val.obj U) (b : (s.algebra.piece e).val.obj U) :
    (quotientMap ((d : ℤ) + e)).val.app U ((s.algebra.mul (d : ℤ) e).app U a b) =
      (quotient.mul (d : ℤ) e).app U ((quotientMap (d : ℤ)).val.app U a)
        ((quotientMap e).val.app U b)
  /-- Its kernel is the graded ideal generated by `ℱ`: this is what makes `ℬ` the quotient
  `𝒜/ℱ𝒜` rather than an unrelated graded algebra. -/
  ker_eq (e : ℤ) : Stacks.SheafOfModules.kerSubmodule (quotientMap ((d : ℤ) + e)) =
    closedSubspaceDegreeProducts s (d : ℤ) e ℱ
  /-- The algebraic space playing the part of `Proj_X(ℬ)`. -/
  space : AlgebraicSpaces s.site s.base s.containsBase
  /-- Its morphism into the ambient relative Proj. -/
  toAmbient : space ⟶ P
  /-- That morphism is a closed immersion — the assertion of Stacks 085H for the degreewise
  surjection `𝒜 ⟶ ℬ`. -/
  isClosedImmersion : IsClosedImmersion s.site s.base s.containsBase toAmbient.hom
  /-- **The isomorphism `Z = Proj_X(𝒜/ℱ𝒜)`.** -/
  iso : Z ≅ space
  /-- The identification is one over the ambient relative Proj. -/
  iso_comp : iso.hom ≫ toAmbient = i

namespace ClosedSubspaceDegreeQuotientPresentation

variable {s : RelativeProjSituation.{u, u}}
    {P Z : AlgebraicSpaces s.site s.base s.containsBase} {i : Z ⟶ P} {d : ℕ} {hd : 0 < d}
    {ℱ : (s.algebra.piece (d : ℤ)).Submodule}
    (p : ClosedSubspaceDegreeQuotientPresentation i hd ℱ)

/-- Every local section of `ℱ` is an equation for the closed subspace the presentation presents:
`ℱ` is contained in the degree-`d` part of the kernel of the quotient map.

This is `AlgebraicGeometry.Space.mul_mem_closedSubspaceDegreeProducts` at `e = 0` read through
`ker_eq`, using that the degree-zero unit of `𝒜` is a right identity. -/
theorem le_ker_quotientMap :
    ∀ (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
      (a : (s.algebra.piece (d : ℤ)).val.obj U), a ∈ ℱ.obj U →
      (p.quotientMap ((d : ℤ) + 0)).val.app U
        ((s.algebra.mul (d : ℤ) 0).app U a (s.algebra.one.eval U)) = 0 := by
  intro U a ha
  refine (Stacks.SheafOfModules.mem_kerSubmodule_obj
    (p.quotientMap ((d : ℤ) + 0)) U _).1 ?_
  rw [p.ker_eq 0]
  exact mul_mem_closedSubspaceDegreeProducts ha _

end ClosedSubspaceDegreeQuotientPresentation

end AlgebraicGeometry.Space

end
