module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartBaseChangeVanishingIdeal
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.ProperFlatBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealMultipleGlobalFunctionsBound
public import StacksFrontier.AlgebraicGeometry.Spaces.LocallyNoetherianFiniteType
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleAffineRefinement

/-!
# Functions vanishing to high order over a closed subspace, for a proper morphism

Let `g : Y ⟶ X` be a proper morphism of algebraic spaces, `U` an affine étale chart of `X` with
Noetherian ring of functions `A`, `I ⊆ A` an ideal and `P = Y ×_X U`. There is a `c` such that
for every `m ≥ c` and every closed subspace `Z ⊆ X` whose defining ideal at `U` lies in `Iᵐ`, a
global function on `P` vanishing at every point of `P` over `Z` lies in the ideal of `Γ(P, 𝒪_P)`
generated by the pullback of `Iᵐ⁻ᶜ`.

This is the content of the last paragraph of the proof of Stacks 0AGK that rests on
Stacks 08AY: with `Z = Z_k` the `k`-th infinitesimal neighbourhood of a closed subspace cut out
by `I`, the kernel of `Γ(P, 𝒪) ⟶ Γ(P ×_X Z_k, 𝒪)` lies in `Iᵏ⁻ᶜ Γ(P, 𝒪)`. It combines
`AlgebraicGeometry.Space.mem_map_definingIdealAt_of_forall_eq_zero` (such a function has values
in `Iᵐ 𝒪_P` on the affine charts) with
`AlgebraicGeometry.Space.exists_mem_map_pow_of_isProper` (Stacks 08AY, clause (1), at `p = 0`,
from Stacks 08AX).

## Main results

* `Stacks.SheafOfModules.mem_range_of_locally`: membership in the image of a monomorphism of
  sheaves of modules is local.
* `AlgebraicGeometry.Space.exists_mem_map_pow_of_forall_eq_zero`: **the bound.**

## References

* [Stacks Project, Tag 0AGK](https://stacks.math.columbia.edu/tag/0AGK)
* [Stacks Project, Tag 08AY](https://stacks.math.columbia.edu/tag/08AY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.SiteModules

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u v w

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}

/-- **Membership in the image of a monomorphism of sheaves of modules is local.** -/
theorem mem_range_of_locally {M N : _root_.SheafOfModules.{w} R} (ι : N ⟶ M) [Mono ι] {W : C}
    (m : M.val.obj (op W)) (Sv : Sieve W) (hSv : Sv ∈ J W)
    (h : ∀ ⦃V⦄ (f : V ⟶ W), Sv f → M.val.map f.op m ∈ Set.range (ι.val.app (op V))) :
    m ∈ Set.range (ι.val.app (op W)) := by
  choose n hn using h
  let fam : Presieve.FamilyOfElements (N.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{w})
      Sv.arrows := fun V f hf => n f hf
  have hcomp : fam.Compatible := by
    intro V₁ V₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hw
    apply injective_app_of_mono ι (op Z)
    change ι.val.app (op Z) (N.val.map g₁.op (n f₁ h₁)) =
      ι.val.app (op Z) (N.val.map g₂.op (n f₂ h₂))
    rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply, hn, hn,
      ← PresheafOfModules.map_comp_apply, ← PresheafOfModules.map_comp_apply, ← op_comp,
      ← op_comp, hw]
  obtain ⟨t, ht, -⟩ := isSheaf_forgetPresheaf N Sv hSv fam hcomp
  refine ⟨t, (isSheaf_forgetPresheaf M Sv hSv).isSeparatedFor.ext fun V f hf => ?_⟩
  exact (PresheafOfModules.naturality_apply ι.val f.op t).symm.trans
    ((congrArg (ι.val.app (op V)) (ht f hf)).trans (hn f hf))

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

attribute [local instance] hasInjectiveResolutions_modules

section Bound

variable {X Y : AlgebraicSpaces B S hS} (g : Y ⟶ X) (U : SmallEtale B S hS X.1)

/-- The projection `Y ×_X U ⟶ U`, to the algebraic space represented by `U`. -/
abbrev chartBaseChangeToScheme :
    chartBaseChangeSpace B S hS g U ⟶ schemeSpace U.1.left :=
  chartBaseChangeProjection B S hS g U

/-- Membership in the image of a monomorphism of `𝒪`-modules on an algebraic space is local. -/
theorem mem_range_of_locally_smallEtale {Z : AlgebraicSpaces B S hS}
    {M N : Modules.{u, u} B S hS Z.1 Z.2} (ι : N ⟶ M) [Mono ι] {W : SmallEtale B S hS Z.1}
    (m : M.val.obj (op W)) (Sv : Sieve W) (hSv : Sv ∈ SmallEtale.topology B S hS Z.1 W)
    (h : ∀ ⦃V⦄ (f : V ⟶ W), Sv f → M.val.map f.op m ∈ Set.range (ι.val.app (op V))) :
    m ∈ Set.range (ι.val.app (op W)) :=
  Stacks.SheafOfModules.mem_range_of_locally ι m Sv hSv h

/-- Membership in the sections of `J 𝒪_X` is local. -/
theorem mem_range_idealMultipleι_of_locally {Z : AlgebraicSpaces B S hS} {A : Type u}
    [CommRing A] (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Z.1 Z.2).O))))
    (J : Ideal A) {W : SmallEtale B S hS Z.1}
    (m : (oModule Z).val.obj (op W)) (Sv : Sieve W)
    (hSv : Sv ∈ SmallEtale.topology B S hS Z.1 W)
    (h : ∀ ⦃V⦄ (f : V ⟶ W), Sv f →
      (oModule Z).val.map f.op m ∈
        Set.range ((idealMultipleι φ (oModule Z) J).val.app (op V))) :
    m ∈ Set.range ((idealMultipleι φ (oModule Z) J).val.app (op W)) :=
  mem_range_of_locally_smallEtale _ m Sv hSv h

/-- Restriction of a global function, read as a section of `𝒪_X` over a chart. -/
theorem oModule_map_globalFunctions {Z : AlgebraicSpaces B S hS}
    (x : globalFunctions B S hS Z.1) {V W : SmallEtale B S hS Z.1} (f : V ⟶ W) :
    (oModule Z).val.map f.op (x.1 (op W)) = x.1 (op V) :=
  x.2 f.op

/-- The sections of `J 𝒪_X` are stable under restriction. -/
theorem map_mem_range_idealMultipleι {Z : AlgebraicSpaces B S hS} {A : Type u}
    [CommRing A] (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Z.1 Z.2).O))))
    (J : Ideal A) {V W : SmallEtale B S hS Z.1} (f : V ⟶ W) {m : (oModule Z).val.obj (op W)}
    (hm : m ∈ Set.range ((idealMultipleι φ (oModule Z) J).val.app (op W))) :
    (oModule Z).val.map f.op m ∈
      Set.range ((idealMultipleι φ (oModule Z) J).val.app (op V)) := by
  obtain ⟨n, rfl⟩ := hm
  exact ⟨(idealMultiple φ (oModule Z) J).val.map f.op n,
    PresheafOfModules.naturality_apply _ f.op n⟩

/-- Membership of a global function in the sections of `J 𝒪_X` is tested on the affine
charts. -/
theorem forall_mem_range_idealMultipleι_of_forall_isAffine {Z : AlgebraicSpaces B S hS}
    {A : Type u} [CommRing A]
    (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Z.1 Z.2).O))))
    (J : Ideal A) (x : (oModule Z).sections)
    (h : ∀ V : SmallEtale B S hS Z.1,
      IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Z.1).obj V)) →
      x.eval (op V) ∈ Set.range ((idealMultipleι φ (oModule Z) J).val.app (op V)))
    (W : (SmallEtale B S hS Z.1)ᵒᵖ) :
    x.eval W ∈ Set.range ((idealMultipleι φ (oModule Z) J).val.app W) := by
  obtain ⟨W⟩ := W
  obtain ⟨ι, Yj, aj, hYaff, hcov, -⟩ := SmallEtale.exists_affine_etale_ofArrows B S hS Z.1 W
  refine mem_range_of_locally_smallEtale _ (x.eval (op W)) _ hcov ?_
  rintro V f ⟨-, e, -, ⟨j⟩, rfl⟩
  have h3 := map_mem_range_idealMultipleι φ J e (h (Yj j) (hYaff j))
  have e : ∀ {V W : SmallEtale B S hS Z.1} (f : V ⟶ W),
      (oModule Z).val.map f.op (x.eval (op W)) = x.eval (op V) := fun f => x.2 f.op
  rw [e] at h3
  rwa [e]

/-- Pullback of functions along `Y ×_X U ⟶ U`. -/
abbrev chartBaseChangePullback :=
  pullbackToGlobalFunctions B S hS (chartBaseChangeSpace B S hS g U) U.1.left
    (chartBaseChangeToScheme g U)

/-- On an étale chart `W` of `Y ×_X U`, the pullback of a function on `U` is its pullback along
`W ⟶ U`. -/
theorem pullbackToGlobalFunctions_chartBaseChange_val
    (W : SmallEtale B S hS (chartBaseChangeSpace B S hS g U).1)
    (r : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤)) :
    (pullbackToGlobalFunctions B S hS (chartBaseChangeSpace B S hS g U) U.1.left
        (chartBaseChangeToScheme g U) r).1 (op W) =
      (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map (chartBaseChangeChartMap g U W)).op).hom
        r := by
  simp only [pullbackToGlobalFunctions]
  rfl

/-- The unit section of `𝒪_X` over a chart, as a section of the structure sheaf read as a
module over itself. -/
abbrev oModuleOne {Z : AlgebraicSpaces B S hS} (W : (SmallEtale B S hS Z.1)ᵒᵖ) :
    (oModule Z).val.obj W :=
  (1 : (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Z.1 Z.2).O).obj.obj W)

/-- Evaluation of a global function on a chart, as a ring homomorphism. -/
def globalSectionEval {Z : AlgebraicSpaces B S hS} (W : (SmallEtale B S hS Z.1)ᵒᵖ) :
    ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Z.1 Z.2).O))) →+*
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS Z.1 Z.2).O).obj.obj W where
  toFun a := a.1 W
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The image of `1` under `𝒪_X ⟶ J 𝒪_X ⟶ 𝒪_X`, multiplication by `φ r`, is `φ r`. -/
theorem idealMultipleι_idealMultipleFactor_one {Z : AlgebraicSpaces B S hS} {A : Type u}
    [CommRing A] (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Z.1 Z.2).O))))
    (J : Ideal A) {r : A} (hr : r ∈ J) (W : (SmallEtale B S hS Z.1)ᵒᵖ) :
    (idealMultipleι φ (oModule Z) J).val.app W
        ((idealMultipleFactor φ (oModule Z) J hr).val.app W (oModuleOne W)) =
      (φ r).1 W := by
  have h := congrArg (fun ψ => (ψ.val.app W).hom (oModuleOne W))
    (idealMultipleFactor_ι φ (oModule Z) J hr)
  refine h.trans ?_
  change (φ r).1 W * 1 = _
  rw [mul_one]

/-- On a chart, the ideal generated by the values of `φ (J)` lies in the sections of `J 𝒪`. -/
theorem mem_range_idealMultipleι_of_mem_map {Z : AlgebraicSpaces B S hS} {A : Type u}
    [CommRing A] (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS Z.1 Z.2).O))))
    (J : Ideal A) (W : (SmallEtale B S hS Z.1)ᵒᵖ)
    {x : (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Z.1 Z.2).O).obj.obj W}
    (hx : x ∈ Ideal.map ((globalSectionEval W).comp φ) J) :
    x ∈ Set.range ((idealMultipleι φ (oModule Z) J).val.app W) := by
  refine Submodule.span_induction (p := fun x _ =>
    x ∈ Set.range ((idealMultipleι φ (oModule Z) J).val.app W)) ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨r, hr, rfl⟩
    exact ⟨_, idealMultipleι_idealMultipleFactor_one φ J hr W⟩
  · exact ⟨0, map_zero _⟩
  · rintro _ _ _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a + b, map_add _ a b⟩
  · rintro c _ _ ⟨a, rfl⟩
    exact ⟨c • a, ((idealMultipleι φ (oModule Z) J).val.app W).hom.map_smul c a⟩

/-- **The bound.** Let `g : Y ⟶ X` be proper, `U` an affine étale chart of `X` whose scheme is
locally Noetherian, `I ⊆ Γ(U)` an ideal and `P = Y ×_X U`. There is a `c` such that for every
`m ≥ c` and every closed subspace `Z ⊆ X` whose defining ideal at `U` lies in `Iᵐ`, a global
function on `P` vanishing at every point of `P` over `Z` lies in the ideal generated by the
pullback of `Iᵐ⁻ᶜ`. -/
theorem exists_mem_map_pow_of_forall_eq_zero (hg : IsProper B S hS g.hom)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    [IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    (I : Ideal Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤)) :
    ∃ c : ℕ, ∀ m : ℕ, c ≤ m → ∀ Z : ClosedSubspaces B S hS X.1,
      definingIdealAt B S hS X Z (op U) ≤ I ^ m →
      ∀ x : globalFunctions B S hS (chartBaseChangeSpace B S hS g U).1,
        (∀ (a : BigFppfOver B S hS) (y : yoneda.obj a ⟶ (chartBaseChangeSpace B S hS g U).1)
          (z : yoneda.obj a ⟶ Z.1.toFunctor),
          z ≫ Z.1.ι = y ≫ (chartBaseChangeInclusion B S hS g U).hom ≫ g.hom →
            ((globalFunctionsChartEquiv B S hS (chartBaseChangeSpace B S hS g U)).val x).val
              (op (CostructuredArrow.mk y)) = 0) →
        x ∈ Ideal.map (pullbackToGlobalFunctions B S hS (chartBaseChangeSpace B S hS g U) U.1.left
          (chartBaseChangeToScheme g U)) (I ^ (m - c)) := by
  have hp : IsProper B S hS (chartBaseChangeToScheme g U).hom :=
    isProper_of_isPullback B S hS (chartBaseChangeSpace B S hS g U).2 Y.2
      (isAlgebraicSpace_yoneda B S hS U.1.left) X.2
      (isPullback_chartBaseChangeProjection B S hS g U).flip hg
  have hP : HasEtaleLocalProperty B S hS (chartBaseChangeSpace B S hS g U).1
      (fun T : Scheme.{u} ↦ IsLocallyNoetherian T) :=
    isLocallyNoetherian_of_isLocallyOfFiniteType B S hS (chartBaseChangeSpace B S hS g U).2
      (isAlgebraicSpace_yoneda B S hS U.1.left)
      (chartBaseChangeToScheme g U).hom hp.2.1.1
      (hasEtaleLocalProperty_of_representable B S hS _ _ _ (Iso.refl _) inferInstance)
  have : Fact (HasEtaleLocalProperty B S hS (chartBaseChangeSpace B S hS g U).1
      (fun T : Scheme.{u} ↦ IsLocallyNoetherian T)) := ⟨hP⟩
  have : IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top _⟩
  obtain ⟨c, hc⟩ := exists_mem_map_pow_of_isProper (chartBaseChangeToScheme g U) hp I
  refine ⟨c, fun m hm Z hZ x hx => hc m hm ⟨x.1, x.2⟩
    (forall_mem_range_idealMultipleι_of_forall_isAffine _ _ _ fun V hV => ?_)⟩
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) := hV
  have h3 := mem_map_definingIdealAt_of_forall_eq_zero g U Z V
    ((globalFunctionsChartEquiv B S hS (chartBaseChangeSpace B S hS g U)).val x) hx
  have hval : ((globalFunctionsChartEquiv B S hS (chartBaseChangeSpace B S hS g U)).val x).val
      (op (CostructuredArrow.mk V.1.hom)) = x.1 (op V) :=
    congrArg (fun s => s.1 (op V))
      ((globalFunctionsChartEquiv B S hS (chartBaseChangeSpace B S hS g U)).property x)
  rw [hval] at h3
  have hψ : (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (chartBaseChangeChartMap g U V)).op).hom =
        (globalSectionEval (op V)).comp (chartBaseChangePullback g U) :=
    RingHom.ext fun r => (pullbackToGlobalFunctions_chartBaseChange_val g U V r).symm
  rw [hψ] at h3
  exact mem_range_idealMultipleι_of_mem_map (chartBaseChangePullback g U) (I ^ m) (op V)
    (Ideal.map_mono hZ h3)

end Bound

end AlgebraicGeometry.Space

