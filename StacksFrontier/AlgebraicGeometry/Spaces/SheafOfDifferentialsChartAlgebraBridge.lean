module

public import StacksFrontier.AlgebraicGeometry.Spaces.SheafOfDifferentialsFiniteType

/-!
# Finite generation of the chart algebras of a morphism of algebraic spaces

Let `f : X ⟶ Y` be a morphism of algebraic spaces.
`AlgebraicGeometry.Space.HasFiniteTypeAffineChartAlgebras` asks that every object of the small
étale site of `X` have a covering family of charts with affine underlying scheme over each of
which `𝒪_X(V)` is generated as an `(f⁻¹𝒪_Y)(V)`-algebra by finitely many sections. It is the
hypothesis of Stacks 05ZE
(`AlgebraicGeometry.Space.isFiniteTypeOnSite_sheafOfDifferentials_of_affineChartAlgebras`).

This file reduces that condition to finite generation over any ring of coefficients whose image
in `𝒪_X(V)` lies in the image of `(f⁻¹𝒪_Y)(V)`. For `f` locally of finite type (Stacks 03XF(1))
and a commuting square `V ⟶ W` of affine étale charts, `V` a chart of `X` and `W` a chart of `Y`,
it proves finite generation of `𝒪_X(V)` over `(f⁻¹𝒪_Y)(V)`, granted the coefficient comparison
`𝒪_Y(W) ⟶ (f⁻¹𝒪_Y)(V)` of the square.

The algebraic input is `Stacks.Algebra.mem_adjoin_of_forall_exists`: finite generation over a
ring of coefficients is inherited by any ring of coefficients whose image in the algebra contains
the image of the first. No ring map between the two coefficient rings and no scalar tower is
needed; here `𝒪_Y(W)` and `(f⁻¹𝒪_Y)(V)` are sections of sheaves on different sites.

## Main results

* `Stacks.Algebra.mem_adjoin_of_forall_exists`: an element in the `R`-subalgebra generated by a
  set lies in the `R'`-subalgebra generated by it, as soon as every element of the image of `R`
  is in the image of `R'`.
* `AlgebraicGeometry.Space.hasFiniteTypeAffineChartAlgebras_of_affineChartGenerators`:
  `AlgebraicGeometry.Space.HasFiniteTypeAffineChartAlgebras` holds as soon as, on a covering by
  affine charts, the sections are finitely generated over some ring of coefficients whose image
  lies in the image of `(f⁻¹𝒪_Y)(V)`.
* `AlgebraicGeometry.Space.exists_adjoin_inverseImage_of_square`: for `f` locally of finite type,
  `𝒪_X(U)` is finitely generated over `(f⁻¹𝒪_Y)(U)` at a commuting square of affine étale charts,
  granted the coefficient comparison of the square.

## References

* [Stacks Project, Tag 05ZE](https://stacks.math.columbia.edu/tag/05ZE)
* [Stacks Project, Tag 03XF](https://stacks.math.columbia.edu/tag/03XF), part (1), locally of
  finite type for morphisms of algebraic spaces.
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace Stacks.Algebra

/-- **Finite generation passes to a larger ring of coefficients.**  If every element of the image
of `R` in `A` is also in the image of `R'`, then the `R`-subalgebra of `A` generated by a set is
contained in the `R'`-subalgebra generated by it.

Only the containment of images is used: there is no ring map `R ⟶ R'` and no scalar tower. -/
theorem mem_adjoin_of_forall_exists {R R' A : Type*} [CommSemiring R] [CommSemiring R']
    [Semiring A] [_root_.Algebra R A] [_root_.Algebra R' A]
    (h : ∀ r : R, ∃ r' : R', algebraMap R' A r' = algebraMap R A r)
    {s : Set A} {z : A} (hz : z ∈ _root_.Algebra.adjoin R s) :
    z ∈ _root_.Algebra.adjoin R' s := by
  induction hz using _root_.Algebra.adjoin_induction with
  | mem x hx => exact _root_.Algebra.subset_adjoin hx
  | algebraMap r =>
      obtain ⟨r', hr'⟩ := h r
      exact hr' ▸ (_root_.Algebra.adjoin R' s).algebraMap_mem r'
  | add _ _ _ _ hx hy => exact add_mem hx hy
  | mul _ _ _ _ hx hy => exact mul_mem hx hy

end Stacks.Algebra

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : AlgebraicSpaces B S hS}

/-- **Finite generation of the chart algebras from finite generation over some coefficient
ring.**

`AlgebraicGeometry.Space.HasFiniteTypeAffineChartAlgebras` holds as soon as every object of the
small étale site of `X` has a covering family of charts with affine underlying scheme over each
of which there is *some* ring `R` of coefficients such that

* `𝒪_X(V)` is generated as an `R`-algebra by finitely many sections, and
* every element of the image of `R` in `𝒪_X(V)` is in the image of `(f⁻¹𝒪_Y)(V)` under `f♯`. -/
theorem hasFiniteTypeAffineChartAlgebras_of_affineChartGenerators (f : X ⟶ Y)
    (hgen : ∀ U : SmallEtale B S hS X.1,
      ∃ (I : Type (u + 1)) (V : I → SmallEtale B S hS X.1) (a : ∀ i, V i ⟶ U),
        Sieve.ofArrows V a ∈ (SmallEtale.topology B S hS X.1) U ∧
          ∀ i, IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj (V i)) ∧
            ∃ (R : Subring (chartRing B S hS X.1 X.2 (V i))) (n : ℕ)
              (y : Fin n → chartRing B S hS X.1 X.2 (V i)),
              (letI := sharpAlgebra B S hS f (V i)
                ∀ r : R, ∃ u : inverseImageStructureRing B S hS f (V i),
                  algebraMap (inverseImageStructureRing B S hS f (V i))
                      (chartRing B S hS X.1 X.2 (V i)) u = (r : _)) ∧
              (letI := (R.subtype).toAlgebra
                ∀ z : chartRing B S hS X.1 X.2 (V i),
                  z ∈ Algebra.adjoin R (Set.range y))) :
    HasFiniteTypeAffineChartAlgebras B S hS f := by
  intro U
  obtain ⟨I, V, a, hcov, hV⟩ := hgen U
  refine ⟨I, V, a, hcov, fun i => ?_⟩
  obtain ⟨haff, R, n, y, hcomp, hadj⟩ := hV i
  let := sharpAlgebra B S hS f (V i)
  let := (R.subtype).toAlgebra
  refine ⟨haff, n, y, fun z => ?_⟩
  exact Stacks.Algebra.mem_adjoin_of_forall_exists hcomp (hadj z)

/-- **Finite generation of the chart algebra at one square of affine étale charts.**

Let `g : U ⟶ W` be a commuting square of étale charts over `f`, with `U` a chart of `X` and `W` a
chart of `Y`, both with affine underlying scheme.  Then `𝒪_X(U)` is generated as an
`(f⁻¹𝒪_Y)(U)`-algebra by finitely many sections, granted the coefficient comparison `hcomp`:
every section of `𝒪_Y(W)` pulls back into the image of `(f⁻¹𝒪_Y)(U)` under `f♯`. -/
theorem exists_adjoin_inverseImage_of_square (f : X ⟶ Y)
    (hf : IsLocallyOfFiniteType B S hS f.hom)
    (U : SmallEtale B S hS X.1) (W : SmallEtale B S hS Y.1)
    (g : (SmallEtale.toOver B S hS X.1).obj U ⟶ (SmallEtale.toOver B S hS Y.1).obj W)
    (hsq : yoneda.map g ≫ W.obj.hom = U.obj.hom ≫ f.hom)
    (hU : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj U)))
    (hW : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Y.1).obj W)))
    (hcomp : letI := sharpAlgebra B S hS f U
      ∀ r : chartRing B S hS Y.1 Y.2 W, ∃ u : inverseImageStructureRing B S hS f U,
        algebraMap (inverseImageStructureRing B S hS f U) (chartRing B S hS X.1 X.2 U) u =
          ((BigFppfOver.toScheme B S hS).map g).appTop.hom r) :
    ∃ (n : ℕ) (y : Fin n → chartRing B S hS X.1 X.2 U),
      letI := sharpAlgebra B S hS f U
      ∀ z : chartRing B S hS X.1 X.2 U,
        z ∈ Algebra.adjoin (inverseImageStructureRing B S hS f U) (Set.range y) := by
  have := hU
  have := hW
  have hft : LocallyOfFiniteType ((BigFppfOver.toScheme B S hS).map g) :=
    hf U.obj.left W.obj.left U.obj.hom W.obj.hom g U.property W.property hsq
  have hring : RingHom.FiniteType ((BigFppfOver.toScheme B S hS).map g).appTop.hom :=
    HasRingHomProperty.appTop (P := @LocallyOfFiniteType) _ hft
  let : Algebra (chartRing B S hS Y.1 Y.2 W) (chartRing B S hS X.1 X.2 U) :=
    (((BigFppfOver.toScheme B S hS).map g).appTop.hom).toAlgebra
  let := sharpAlgebra B S hS f U
  have hring' : Algebra.FiniteType (chartRing B S hS Y.1 Y.2 W)
      (chartRing B S hS X.1 X.2 U) := hring
  obtain ⟨s, hs⟩ := hring'.out
  refine ⟨s.card, fun i => (s.equivFin.symm i).val, fun z => ?_⟩
  have hrange : Set.range (fun i : Fin s.card => (s.equivFin.symm i).val) =
      (s : Set (chartRing B S hS X.1 X.2 U)) := by
    rw [show (fun i : Fin s.card => (s.equivFin.symm i).val) =
        Subtype.val ∘ s.equivFin.symm from rfl, Set.range_comp,
      (s.equivFin.symm).range_eq_univ, Set.image_univ]
    simp
  refine Stacks.Algebra.mem_adjoin_of_forall_exists hcomp ?_
  rw [hrange, hs]
  trivial

end AlgebraicGeometry.Space

end
