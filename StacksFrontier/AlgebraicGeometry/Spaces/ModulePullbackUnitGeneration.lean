module

public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePullbackSectionGenerators
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealSheafMapStructureSheaf
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.PullbackUnitGenerators

/-!
# A module pullback on an algebraic space is locally generated by the unit sections

Let `g : X ⟶ X'` be a morphism of algebraic spaces over a scheme `S` contained in a big fppf
site `B` and let `M` be a sheaf of `𝒪_{X'}`-modules on the small étale site of `X'`.  Over a
commutative diagram `d` of étale scheme charts a section `s` of `M` over the chart of `X'` has a
canonical image `η(s) = AlgebraicGeometry.Space.modulePullbackUnitSection` in `g^*M` over the
chart of `X`.  **These sections generate `g^*M` locally for the small étale topology of `X`:
every section of `g^*M` over an étale chart of `X` restricts, along the arrows of some étale
covering of that chart, into the `𝒪_X`-span of restrictions of the sections `η(s)`.**  This is
the algebraic-spaces counterpart of `Stacks.PullbackUnitGenerators.spanSieve_mem`, the same
statement for a morphism of ringed spaces.

No hypothesis on `M` is needed: it is not assumed quasi-coherent, nor of finite type, nor to
have local generating sections.

## Main definitions

* `AlgebraicGeometry.Space.modulePullbackUnitSections` — the family of all restrictions of the
  unit sections of `g^*M`, as a family of local sections.
* `AlgebraicGeometry.Space.localModulePullbackUnitSpan` — the subsheaf of `g^*M` of sections
  lying locally in the span of that family.

## Main results

* `AlgebraicGeometry.Space.modulePushforwardHomEquiv_zero_app` — the chartwise transpose of the
  zero morphism into a direct image vanishes.
* `AlgebraicGeometry.Space.mem_localModulePullbackUnitSpan_unitSection` — a unit section lies in
  the local span of the unit sections.
* `AlgebraicGeometry.Space.unit_comp_modulePushforward_map_eq_zero` — a morphism out of `g^*M`
  killing the local span of the unit sections has vanishing adjoint transpose.
* `AlgebraicGeometry.Space.epi_localModulePullbackUnitSpan_ι` — the inclusion of that subsheaf
  into `g^*M` is an epimorphism.
* `AlgebraicGeometry.Space.mem_localModulePullbackUnitSpan` — **every section of `g^*M` lies
  locally in the span of the unit sections.**
* `AlgebraicGeometry.Space.spanSieve_modulePullbackUnitSections_mem` and
  `AlgebraicGeometry.Space.exists_covering_mem_spanSubmodule_modulePullbackUnitSections` —
  **the same statement spelled out on coverings**: the sieve of arrows along which a section of
  `g^*M` restricts into the span of the unit sections is a covering sieve.

## Implementation notes

The inclusion of the local span is an epimorphism by
`Stacks.Adjunction.epi_of_unit_comp_map_eq_zero`, stated for an arbitrary adjunction between
preadditive categories, and local generation follows from `Stacks.SheafOfModules.localSpan` and
`Stacks.SheafOfModules.mem_localSpan_of_epi_ι`, stated for an arbitrary site.  The two
sheafification
hypotheses that `mem_localSpan_of_epi_ι` carries,
`CategoryTheory.HasSheafify` and
`CategoryTheory.GrothendieckTopology.WEqualsLocallyBijective` for abelian groups, are instances
for the small étale topology at the module universe of the schemes, so nothing is assumed.

Vanishing of the adjoint transpose is checked through the chartwise universal property of the
direct image, `AlgebraicGeometry.Space.modulePushforwardHomEquiv`, rather than on sections of
`g_*Z`: the sections of a direct image on the small étale site are a limit over chart diagrams
and are not read off a single chart, which is exactly why the chart correspondence is the tool.
The zero morphism's chartwise transpose is computed from
`AlgebraicGeometry.Space.modulePushforwardHomEquiv_app_comp_right` applied to the zero morphism
of the source module, so no further unfolding of the correspondence is needed.

## References

* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU), the adjunction
  `g^* ⊣ g_*` and the chartwise universal property of the direct image.
* [Stacks Project, Tag 03D7](https://stacks.math.columbia.edu/tag/03D7)
* [Stacks Project, Tag 01AH](https://stacks.math.columbia.edu/tag/01AH), epimorphisms of sheaves
  of modules are the locally surjective morphisms.
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X X' : AlgebraicSpaces B S hS} (g : X ⟶ X')
    (M : Modules.{u, u} B S hS X'.1 X'.2)

/-! ### The chartwise transpose of a zero morphism -/

/-- The chartwise transpose of the zero morphism into a direct image vanishes. -/
theorem modulePushforwardHomEquiv_zero_app (F : Modules.{u, u} B S hS X.1 X.2)
    (G : Modules.{u, u} B S hS X'.1 X'.2)
    (d : ChartDiagram B S hS X.1 X'.1 g.hom) (s : G.val.obj (op d.V)) :
    (modulePushforwardHomEquiv B S hS g F G
        (0 : G ⟶ (modulePushforward B S hS g).obj F)).app d s = 0 := by
  have h0 : (0 : G ⟶ (modulePushforward B S hS g).obj F) =
      (0 : G ⟶ (modulePushforward B S hS g).obj F) ≫
        (modulePushforward B S hS g).map (0 : F ⟶ F) := by
    rw [(modulePushforward B S hS g).map_zero, Limits.comp_zero]
  rw [h0, modulePushforwardHomEquiv_app_comp_right]
  rfl

/-! ### The family of unit sections of a module pullback -/

/-- The family of local sections of `g^*M` consisting of all restrictions of the unit sections:
over a chart `W` of `X`, the sections obtained from a section of `M` over the chart of `X'` of a
chart diagram by taking its unit image and restricting to `W`. -/
def modulePullbackUnitSections (W : (SmallEtale B S hS X.1)ᵒᵖ) :
    Set (((modulePullback B S hS g).obj M).val.obj W) :=
  {y | ∃ (d : ChartDiagram B S hS X.1 X'.1 g.hom) (i : W.unop ⟶ d.U)
    (s : M.val.obj (op d.V)), ((modulePullback B S hS g).obj M).val.map i.op
      (modulePullbackUnitSection B S hS g M d s) = y}

/-- A restriction of a unit section is a member of the family of unit sections. -/
theorem map_modulePullbackUnitSection_mem_modulePullbackUnitSections
    (d : ChartDiagram B S hS X.1 X'.1 g.hom) (s : M.val.obj (op d.V))
    {V : SmallEtale B S hS X.1} (i : V ⟶ d.U) :
    ((modulePullback B S hS g).obj M).val.map i.op
        (modulePullbackUnitSection B S hS g M d s) ∈
      modulePullbackUnitSections B S hS g M (op V) :=
  ⟨d, i, s, rfl⟩

/-- The subsheaf of `g^*M` of sections lying locally in the span of the unit sections. -/
abbrev localModulePullbackUnitSpan : ((modulePullback B S hS g).obj M).Submodule :=
  Stacks.SheafOfModules.localSpan ((modulePullback B S hS g).obj M)
    (modulePullbackUnitSections B S hS g M)

/-- A unit section lies in the local span of the unit sections. -/
theorem mem_localModulePullbackUnitSpan_unitSection
    (d : ChartDiagram B S hS X.1 X'.1 g.hom) (s : M.val.obj (op d.V)) :
    modulePullbackUnitSection B S hS g M d s ∈
      (localModulePullbackUnitSpan B S hS g M).obj (op d.U) := by
  refine (Stacks.SheafOfModules.mem_localSpan_iff _).2
    ((SmallEtale.topology B S hS X.1).superset_covering ?_
      ((SmallEtale.topology B S hS X.1).top_mem d.U))
  intro V i _
  exact Stacks.SheafOfModules.mem_spanSubmodule
    (map_modulePullbackUnitSection_mem_modulePullbackUnitSections B S hS g M d s i)

/-! ### The inclusion of the local span is an epimorphism -/

/-- **A morphism out of `g^*M` which kills the local span of the unit sections has vanishing
adjoint transpose.** -/
theorem unit_comp_modulePushforward_map_eq_zero (Z : Modules.{u, u} B S hS X.1 X.2)
    (q : (modulePullback B S hS g).obj M ⟶ Z)
    (hq : (localModulePullbackUnitSpan B S hS g M).ι ≫ q = 0) :
    (modulePullbackAdjunction B S hS g).unit.app M ≫ (modulePushforward B S hS g).map q = 0 := by
  have key : (modulePullbackAdjunction B S hS g).homEquiv M Z q = 0 := by
    refine (modulePushforwardHomEquiv B S hS g Z M).injective
      (ModuleFMap.ext B S hS (funext fun d => funext fun s => ?_))
    have h1 : (modulePushforwardHomEquiv B S hS g Z M
        ((modulePullbackAdjunction B S hS g).homEquiv M Z q)).app d s =
        q.val.app (op d.U) (modulePullbackUnitSection B S hS g M d s) :=
      modulePullbackHomFMap_app B S hS g M Z q d s
    rw [h1, modulePushforwardHomEquiv_zero_app]
    exact Stacks.SheafOfModules.apply_eq_zero_of_mem_localSpan q hq
      (mem_localModulePullbackUnitSpan_unitSection B S hS g M d s)
  exact (Adjunction.homEquiv_unit (modulePullbackAdjunction B S hS g) M Z q).symm.trans key

/-- **The inclusion into `g^*M` of the subsheaf of sections lying locally in the span of the
unit sections is an epimorphism.** -/
theorem epi_localModulePullbackUnitSpan_ι :
    Epi (localModulePullbackUnitSpan B S hS g M).ι :=
  Stacks.Adjunction.epi_of_unit_comp_map_eq_zero (modulePullbackAdjunction B S hS g) _
    (unit_comp_modulePushforward_map_eq_zero B S hS g M)

/-! ### Local generation -/

/-- **Every section of a module pullback on an algebraic space lies locally in the span of the
unit sections.** -/
theorem mem_localModulePullbackUnitSpan (W : (SmallEtale B S hS X.1)ᵒᵖ)
    (y : ((modulePullback B S hS g).obj M).val.obj W) :
    y ∈ (localModulePullbackUnitSpan B S hS g M).obj W :=
  have := epi_localModulePullbackUnitSpan_ι B S hS g M
  Stacks.SheafOfModules.mem_localSpan_of_epi_ι y

/-- **A module pullback on an algebraic space is locally generated by the unit sections.**  The
sieve of arrows of the small étale site of `X` along which a section of `g^*M` restricts into
the span of the restricted unit sections is a covering sieve. -/
theorem spanSieve_modulePullbackUnitSections_mem (W : (SmallEtale B S hS X.1)ᵒᵖ)
    (y : ((modulePullback B S hS g).obj M).val.obj W) :
    Stacks.SheafOfModules.spanSieve ((modulePullback B S hS g).obj M)
        (modulePullbackUnitSections B S hS g M) y ∈
      SmallEtale.topology B S hS X.1 W.unop :=
  have := epi_localModulePullbackUnitSpan_ι B S hS g M
  Stacks.SheafOfModules.spanSieve_mem_of_epi_ι y

/-- **Local generation of a module pullback, spelled out.**  Every section `y` of `g^*M` over an
étale chart `W` of `X` admits an étale covering sieve of `W` along each arrow of which the
restriction of `y` is an `𝒪_X`-combination of restrictions of unit sections. -/
theorem exists_covering_mem_spanSubmodule_modulePullbackUnitSections
    (W : (SmallEtale B S hS X.1)ᵒᵖ)
    (y : ((modulePullback B S hS g).obj M).val.obj W) :
    ∃ T : Sieve W.unop, T ∈ SmallEtale.topology B S hS X.1 W.unop ∧
      ∀ ⦃V : SmallEtale B S hS X.1⦄ (i : V ⟶ W.unop), T i →
        ((modulePullback B S hS g).obj M).val.map i.op y ∈
          (Stacks.SheafOfModules.spanSubmodule ((modulePullback B S hS g).obj M)
            (modulePullbackUnitSections B S hS g M)).obj (op V) :=
  ⟨_, spanSieve_modulePullbackUnitSections_mem B S hS g M W y, fun _ _ hi => hi⟩

end AlgebraicGeometry.Space

end
