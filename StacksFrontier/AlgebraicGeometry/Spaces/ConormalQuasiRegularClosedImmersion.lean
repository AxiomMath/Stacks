/-!
# The conormal criterion for quasi-regularity of a closed immersion of algebraic spaces

Let `k : Z ⟶ X` be a closed immersion of algebraic spaces over a scheme `S` contained in a big
fppf site `B`, with conormal algebra `𝒞_{Z/X,*}` of Stacks 09RN, conormal sheaf
`𝒞_{Z/X} = 𝒞_{Z/X,1}` and canonical map `Φ : Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` of Stacks 09RQ.  For
an étale scheme chart `V` of `X` write `j_V : Z_V ⟶ V` for the base change of `k`.  This file
proves the two halves of Stacks 09RY for `k`, in terms of the `j_V`:

* if every `j_V` is a quasi-regular immersion of schemes, then `𝒞_{Z/X}` is finite locally free
  and `Φ` is an isomorphism in every degree;
* if every `j_V` is locally of finite presentation, `𝒞_{Z/X}` is finite locally free and `Φ` is
  an isomorphism in every degree, then every `j_V` is a quasi-regular immersion.

Both are reductions to the chart-level rank counts of
`StacksFrontier/AlgebraicGeometry/Spaces/ConormalQuasiRegularChart.lean`, over the affine open
charts
`openChart V U` of `V` and their base changes.  In the first direction, the scheme case of
Stacks 063M (`Stacks.Conormal.exists_quasiRegular_affineChart_mem`) gives around every point of
`Z_V` an affine open `U` of `V` over which the ideal of `Z` is generated by a quasi-regular
sequence, and the base changes of those charts cover `Z`.  In the second direction a Zariski-local
trivialization of `𝒞_{Z/X}` on `Z_V` gives free sections of a fixed rank over the base changes of
small affine open charts, and the shrinking step of the scheme case is run there.

## Main results

* `AlgebraicGeometry.Space.coversTop_smallBaseChange_openChart`: base changes of open charts
  lying under every point of the base-changed charts cover the source.
* `Space.isFiniteLocallyFreeOnSite_conormalAlgebra_piece_one_of_forall_quasiRegular`
  and `AlgebraicGeometry.Space.isIso_symmetricAlgebraToConormalAlgebra_of_forall_quasiRegular`:
  the direction out of quasi-regularity.
* `Stacks.Conormal.exists_affineBasicOpen_chartIdeal_eq_span`: the Nakayama shrinking step of
  Stacks 063M for an immersion of schemes.
* `Space.quasiRegularImmersionProperty_of_isIso_symmetricAlgebraToConormalAlgebra`:
  the direction into quasi-regularity.

## References

* [Stacks Project, Tag 09RY](https://stacks.math.columbia.edu/tag/09RY)
* [Stacks Project, Tag 063M](https://stacks.math.columbia.edu/tag/063M)
* [Stacks Project, Tag 09RQ](https://stacks.math.columbia.edu/tag/09RQ)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace Stacks.Conormal

open _root_.AlgebraicGeometry

variable {Z₁ X₁ : Scheme.{u}}

/-- **Shrinking an affine closed-immersion chart to a basic open on which lifted generators
generate.**  Let `i : Z ⟶ X` be an immersion locally of finite presentation, `U` an affine open
of `X` over which `i` is a closed immersion with chart ideal `I`, and `f` a family of elements of
`I` generating it modulo `I²`.  Then there is `r ∈ Γ(X, U)` with `r ≡ 1` modulo `I` such that the
basic open `D(r)` has the same preimage as `U`, `i` is a closed immersion over it, and the chart
ideal of `D(r)` is generated by the restrictions of `f`.  This is Nakayama's lemma in the form
`Stacks.Conormal.exists_sub_one_mem_mul_mem_of_fg_of_le_sup_sq`, as in the scheme case of
Stacks 063M. -/
theorem exists_affineBasicOpen_chartIdeal_eq_span (i : Z₁ ⟶ X₁)
    [_root_.AlgebraicGeometry.IsImmersion i]
    (hfp : LocallyOfFinitePresentation i) (U : X₁.affineOpens)
    (hU : _root_.AlgebraicGeometry.IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) {n : ℕ}
    (f : Fin n → Γ(X₁, U.1)) (hfmem : ∀ l, f l ∈ chartIdeal i U)
    (hfle : chartIdeal i U ≤ Ideal.span (Set.range f) ⊔ chartIdeal i U ^ 2) :
    ∃ (r : Γ(X₁, U.1)) (hle : X₁.affineBasicOpen r ≤ U),
      _root_.AlgebraicGeometry.IsClosedImmersion
        (i.resLE (X₁.affineBasicOpen r).1 (i ⁻¹ᵁ (X₁.affineBasicOpen r).1) le_rfl) ∧
      i ⁻¹ᵁ (X₁.affineBasicOpen r).1 = i ⁻¹ᵁ U.1 ∧
      chartIdeal i (X₁.affineBasicOpen r) =
        Ideal.span (Set.range fun l => (X₁.presheaf.map (homOfLE hle).op).hom (f l)) := by
  obtain ⟨r, hr1, hr2⟩ := exists_sub_one_mem_mul_mem_of_fg_of_le_sup_sq (chartIdeal i U)
    (Ideal.span (Set.range f)) (fg_chartIdeal_of_locallyOfFinitePresentation i hfp U hU) hfle
  have hle : X₁.affineBasicOpen r ≤ U := X₁.affineBasicOpen_le r
  have hU' : _root_.AlgebraicGeometry.IsClosedImmersion
      (i.resLE (X₁.affineBasicOpen r).1 (i ⁻¹ᵁ (X₁.affineBasicOpen r).1) le_rfl) :=
    _root_.AlgebraicGeometry.isClosedImmersion_resLE_of_le_coborderRange i _
      (le_trans hle (le_coborderRange_of_isClosedImmersion_resLE i U.1 hU))
  have hres1 : (i.app U.1).hom r = 1 := by
    have h0 : (i.app U.1).hom (r - 1) = 0 := hr1
    rwa [map_sub, map_one, sub_eq_zero] at h0
  have hpre : i ⁻¹ᵁ (X₁.affineBasicOpen r).1 = i ⁻¹ᵁ U.1 := by
    change i ⁻¹ᵁ X₁.basicOpen r = i ⁻¹ᵁ U.1
    rw [Scheme.preimage_basicOpen, hres1, Scheme.basicOpen_one]
  refine ⟨r, hle, hU', hpre, ?_⟩
  rw [chartIdeal_map_of_le i U (X₁.affineBasicOpen r) hU hle]
  have hmapspan : Ideal.map (X₁.presheaf.map (homOfLE hle).op).hom
      (Ideal.span (Set.range f)) =
      Ideal.span (Set.range fun l => (X₁.presheaf.map (homOfLE hle).op).hom (f l)) := by
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_) ?_
  · have hmul : (X₁.presheaf.map (homOfLE hle).op).hom (r * a) ∈
        Ideal.span (Set.range fun l => (X₁.presheaf.map (homOfLE hle).op).hom (f l)) := by
      rw [← hmapspan]
      exact Ideal.mem_map_of_mem _ (hr2 a ha)
    rw [map_mul] at hmul
    exact (Ideal.unit_mul_mem_iff_mem _ (X₁.toRingedSpace.isUnit_res_basicOpen r)).mp hmul
  · rw [← hmapspan]
    exact Ideal.map_mono (Ideal.span_le.mpr fun _ ⟨l, hl⟩ => hl ▸ hfmem l)

end Stacks.Conormal

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Z : AlgebraicSpaces B S hS}

/-! ### Base changes of open charts cover the source -/

section Covering

variable (k : Z ⟶ X) (hk : yoneda.relativelyRepresentable k.hom)

/-- **The base changes of a family of open charts cover the source** as soon as every point of
the base change of every chart `V` of `X` lies over one of the opens of `V` in the family.  Here
the family is the set of pairs `(V, O)` of a chart `V` and a Zariski open `O` of its scheme
satisfying `P`. -/
theorem coversTop_smallBaseChange_openChart
    (P : ∀ V : SmallEtale B S hS X.1, (chartScheme V).Opens → Prop)
    (hP : ∀ (V : SmallEtale B S hS X.1)
      (z : chartScheme ((smallBaseChange B S hS k hk).obj V)),
      ∃ O : (chartScheme V).Opens, P V O ∧ smallBaseChangeSchemeProjection B S hS k hk V z ∈ O) :
    (SmallEtale.topology B S hS Z.1).CoversTop
      (fun i : {p : Σ V : SmallEtale B S hS X.1, (chartScheme V).Opens // P p.1 p.2} =>
        (smallBaseChange B S hS k hk).obj (openChart B S hS X.1 i.1.1 i.1.2)) := by
  intro U
  refine GrothendieckTopology.transitive _
    (coversTop_smallBaseChange_obj B S hS k hk U) _ ?_
  rintro T g ⟨V, ⟨b⟩⟩
  have hcov : Sieve.ofObjects
      (fun i : {p : Σ V : SmallEtale B S hS X.1, (chartScheme V).Opens // P p.1 p.2} =>
        (smallBaseChange B S hS k hk).obj (openChart B S hS X.1 i.1.1 i.1.2))
      ((smallBaseChange B S hS k hk).obj V) ∈
        SmallEtale.topology B S hS Z.1 ((smallBaseChange B S hS k hk).obj V) := by
    refine smallEtale_sieve_of_pointwise_covering B S hS Z.1 _ _ fun z => ?_
    obtain ⟨O, hO, hz⟩ := hP V z
    refine ⟨openChart B S hS Z.1 ((smallBaseChange B S hS k hk).obj V)
        (smallBaseChangeSchemeProjection B S hS k hk V ⁻¹ᵁ O),
      openChartInclusion B S hS Z.1 _ _,
      ⟨⟨⟨V, O⟩, hO⟩, ⟨(smallBaseChangeOpenChartIso B S hS k hk V O).inv⟩⟩, ⟨z, hz⟩, ?_⟩
    rw [toScheme_map_toOver_map_openChartInclusion]
    rfl
  refine GrothendieckTopology.superset_covering _ ?_
    (GrothendieckTopology.pullback_stable _ b hcov)
  rintro T' q ⟨i, ⟨c⟩⟩
  exact ⟨i, ⟨c⟩⟩

end Covering

/-! ### From quasi-regular base changes to the conormal conditions -/

section Forward

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable (k : Z ⟶ X) (hk : IsClosedImmersion B S hS k.hom)

/-- **The conormal chart ideal of an open chart is the transport of the scheme chart ideal.** -/
private theorem conormalChartIdeal_openChart_eq_map (V : SmallEtale B S hS X.1)
    [_root_.AlgebraicGeometry.IsImmersion ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom))]
    (W : (chartScheme V).affineOpens) :
    conormalChartIdeal B S hS k (openChart B S hS X.1 V W.1) =
      Ideal.map (RingEquiv.ofBijective (openChartTopRingHom B S hS X V W.1)
        (bijective_openChartTopRingHom B S hS X V W.1)).symm.toRingHom
        (Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) W) := by
  rw [conormalChartIdeal, chartSectionIdeal_kernelIdealSheaf_openChart_eq_comap_chartIdeal
    B S hS k hk.1 V W]
  exact (Ideal.map_symm (RingEquiv.ofBijective (openChartTopRingHom B S hS X V W.1)
    (bijective_openChartTopRingHom B S hS X V W.1))).symm

/-- **Generators of a chart ideal transport to the conormal chart ideal of the open chart.** -/
private theorem conormalChartIdeal_openChart_eq_span (V : SmallEtale B S hS X.1)
    [_root_.AlgebraicGeometry.IsImmersion ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom))]
    (W : (chartScheme V).affineOpens) {c : ℕ} (g : Fin c → Γ(chartScheme V, W.1))
    (hg : Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) W =
      Ideal.span (Set.range g)) :
    conormalChartIdeal B S hS k (openChart B S hS X.1 V W.1) =
      Ideal.span (Set.range fun l => (RingEquiv.ofBijective (openChartTopRingHom B S hS X V W.1)
        (bijective_openChartTopRingHom B S hS X V W.1)).symm (g l)) := by
  rw [conormalChartIdeal_openChart_eq_map B S hS k hk V W, hg, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **Quasi-regular base changes give quasi-regular generators over small affine open charts.**
If the base change `j : Z_V ⟶ V` of the closed immersion `k` along every étale chart `V` of `X`
is a quasi-regular immersion of schemes, then every point of `Z_V` lies over an affine open `O`
of `V` such that the ideal of `Z` over the chart `openChart V O` is generated by a quasi-regular
sequence.  This is Stacks 063M's local description of `j` around the point, read through
`AlgebraicGeometry.Space.chartSectionIdeal_kernelIdealSheaf_openChart_eq_comap_chartIdeal`. -/
theorem exists_quasiRegular_openChart_mem
    (h : ∀ V : SmallEtale B S hS X.1, quasiRegularImmersionProperty
      ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)))
    (V : SmallEtale B S hS X.1) (z : chartScheme ((smallBaseChange B S hS k hk.1).obj V)) :
    ∃ O : (chartScheme V).Opens, (IsAffineOpen O ∧
      ∃ (c : ℕ) (f : Fin c → chartRing B S hS X.1 X.2 (openChart B S hS X.1 V O)),
        conormalChartIdeal B S hS k (openChart B S hS X.1 V O) = Ideal.span (Set.range f) ∧
          RingTheory.Sequence.IsQuasiRegular
            (chartRing B S hS X.1 X.2 (openChart B S hS X.1 V O)) (List.ofFn f)) ∧
      smallBaseChangeSchemeProjection B S hS k hk.1 V z ∈ O := by
  obtain ⟨hImm, hqri⟩ := h V
  obtain ⟨O, -, hzO, -, c, f, hspan, hqr⟩ :=
    Stacks.Conormal.exists_quasiRegular_affineChart_mem _ hqri ⊤ z trivial
  let ε := RingEquiv.ofBijective (openChartTopRingHom B S hS X V O.1)
    (bijective_openChartTopRingHom B S hS X V O.1)
  exact ⟨O.1, ⟨O.2, c, fun l => ε.symm (f l),
    conormalChartIdeal_openChart_eq_span B S hS k hk V O f hspan,
    Stacks.Conormal.isQuasiRegular_ringEquiv ε.symm f hqr⟩, hzO⟩

include hk in
/-- **Quasi-regular base changes make the conormal sheaf finite locally free** (Stacks 09RY,
condition (2) of the forward direction).  The base changes of the affine open charts over which
the ideal of `Z` is generated by a quasi-regular sequence cover `Z`, by
`AlgebraicGeometry.Space.exists_quasiRegular_openChart_mem`, and over each of them the conormal
sheaf is free of finite rank. -/
theorem isFiniteLocallyFreeOnSite_conormalAlgebra_piece_one_of_forall_quasiRegular
    (h : ∀ V : SmallEtale B S hS X.1, quasiRegularImmersionProperty
      ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom))) :
    SheafOfModules.IsFiniteLocallyFreeOnSite ((conormalAlgebra B S hS k).piece 1) := by
  have hT := coversTop_smallBaseChange_openChart B S hS k hk.1 _
    (exists_quasiRegular_openChart_mem B S hS k hk h)
  choose c f hf hqr using fun i : {p : Σ V : SmallEtale B S hS X.1, (chartScheme V).Opens //
      IsAffineOpen p.2 ∧ ∃ (c : ℕ) (f : Fin c → chartRing B S hS X.1 X.2
        (openChart B S hS X.1 p.1 p.2)),
        conormalChartIdeal B S hS k (openChart B S hS X.1 p.1 p.2) = Ideal.span (Set.range f) ∧
          RingTheory.Sequence.IsQuasiRegular
            (chartRing B S hS X.1 X.2 (openChart B S hS X.1 p.1 p.2)) (List.ofFn f)} => i.2.2
  exact isFiniteLocallyFreeOnSite_of_coversTop_iso_free B S hS Z.1 Z.2
    ((modulePullback B S hS k).obj (kernelPowModule B S hS k ((1 : ℕ) : ℤ))) _ hT
    (fun i => ULift.{u} (Fin (c i))) fun i =>
      (nonempty_iso_free_over_conormal_of_isQuasiRegular B S hS k hk
        (openChart B S hS X.1 i.1.1 i.1.2)
        (isAffine_chartScheme_openChart B S hS X.1 i.1.1 ⟨i.1.2, i.2.1⟩)
        (f i) (hf i) (hqr i)).some

include hk in
/-- **Quasi-regular base changes make the map `Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` an isomorphism**
(Stacks 09RY, condition (3) of the forward direction).  Being an isomorphism of sheaves is local
on a covering, and over the base changes of the affine open charts over which the ideal of `Z`
is generated by a quasi-regular sequence the map is an isomorphism in every degree. -/
theorem isIso_symmetricAlgebraToConormalAlgebra_of_forall_quasiRegular
    (h : ∀ V : SmallEtale B S hS X.1, quasiRegularImmersionProperty
      ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)))
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : (conormalAlgebra B S hS k).piece 1 ⟶ A.piece 1)
    (hA : SheafOfModules.GradedAlgebra.IsSymmetricAlgebra A ι) (n : ℤ) :
    IsIso ((symmetricAlgebraToConormalAlgebra B S hS k A ι hA).app n) := by
  have hT := coversTop_smallBaseChange_openChart B S hS k hk.1 _
    (exists_quasiRegular_openChart_mem B S hS k hk h)
  choose c f hf hqr using fun i : {p : Σ V : SmallEtale B S hS X.1, (chartScheme V).Opens //
      IsAffineOpen p.2 ∧ ∃ (c : ℕ) (f : Fin c → chartRing B S hS X.1 X.2
        (openChart B S hS X.1 p.1 p.2)),
        conormalChartIdeal B S hS k (openChart B S hS X.1 p.1 p.2) = Ideal.span (Set.range f) ∧
          RingTheory.Sequence.IsQuasiRegular
            (chartRing B S hS X.1 X.2 (openChart B S hS X.1 p.1 p.2)) (List.ofFn f)} => i.2.2
  exact Stacks.SheafOfModules.isIso_of_isIso_overFunctor_map hT _ fun i =>
    isIso_over_symmetricAlgebraToConormalAlgebra_of_isQuasiRegular B S hS k hk
      (openChart B S hS X.1 i.1.1 i.1.2)
      (isAffine_chartScheme_openChart B S hS X.1 i.1.1 ⟨i.1.2, i.2.1⟩)
      (f i) (hf i) (hqr i) A ι hA n

end Forward

/-! ### From the conormal conditions to quasi-regular base changes -/

section Converse

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable (k : Z ⟶ X) (hk : IsClosedImmersion B S hS k.hom)

include hk in
/-- **The pulled-back conormal sheaf of a closed immersion is quasi-coherent.** -/
private theorem isQuasicoherentOnSite_modulePullback_kernelPowModule_one :
    ((modulePullback B S hS k).obj
      (kernelPowModule B S hS k ((1 : ℕ) : ℤ))).IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS k _
    (isQuasicoherentOnSite_kernelIdealSheafZPow_natCast B S hS k
      (isQuasicoherentOnSite_kernelIdealSheaf B S hS k
        (isQuasiCompact_of_isClosedImmersion' B S hS hk)) 1)

/-- **The conormal chart ideal of an affine open chart is finitely generated** when the base
change of the closed immersion is locally of finite presentation. -/
private theorem fg_conormalChartIdeal_openChart (V : SmallEtale B S hS X.1)
    [_root_.AlgebraicGeometry.IsImmersion ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom))]
    (hfp : LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)))
    (U : (chartScheme V).affineOpens)
    (hU : _root_.AlgebraicGeometry.IsClosedImmersion
      (((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)).resLE U.1
        (((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) ⁻¹ᵁ U.1) le_rfl)) :
    (conormalChartIdeal B S hS k (openChart B S hS X.1 V U.1)).FG := by
  rw [conormalChartIdeal_openChart_eq_map B S hS k hk V U]
  exact (Stacks.Conormal.fg_chartIdeal_of_locallyOfFinitePresentation _ hfp U hU).map _

/-- **Generators modulo the square of the conormal chart ideal transport to the chart ideal.** -/
private theorem mem_chartIdeal_and_le_span_sup_sq_of_conormalChartIdeal (V : SmallEtale B S hS X.1)
    [_root_.AlgebraicGeometry.IsImmersion ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom))]
    (U : (chartScheme V).affineOpens) {n : ℕ}
    (f : Fin n → chartRing B S hS X.1 X.2 (openChart B S hS X.1 V U.1))
    (hfmem : ∀ l, f l ∈ conormalChartIdeal B S hS k (openChart B S hS X.1 V U.1))
    (hfle : conormalChartIdeal B S hS k (openChart B S hS X.1 V U.1) ≤ Ideal.span (Set.range f) ⊔
      conormalChartIdeal B S hS k (openChart B S hS X.1 V U.1) ^ 2) :
    (∀ l, RingEquiv.ofBijective (openChartTopRingHom B S hS X V U.1)
        (bijective_openChartTopRingHom B S hS X V U.1) (f l) ∈
      Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) U) ∧
    Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) U ≤
      Ideal.span (Set.range fun l => RingEquiv.ofBijective (openChartTopRingHom B S hS X V U.1)
        (bijective_openChartTopRingHom B S hS X V U.1) (f l)) ⊔
      Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) U ^ 2 := by
  let ε := RingEquiv.ofBijective (openChartTopRingHom B S hS X V U.1)
    (bijective_openChartTopRingHom B S hS X V U.1)
  have hJ : Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) U =
      Ideal.map (ε : chartRing B S hS X.1 X.2 (openChart B S hS X.1 V U.1) →+*
        Γ(chartScheme V, U.1)) (conormalChartIdeal B S hS k (openChart B S hS X.1 V U.1)) := by
    rw [conormalChartIdeal_openChart_eq_map B S hS k hk V U, Ideal.map_map]
    simp [ε]
  rw [hJ]
  refine ⟨fun l => Ideal.mem_map_of_mem _ (hfmem l), ?_⟩
  have h := Ideal.map_mono (f := (ε : chartRing B S hS X.1 X.2 (openChart B S hS X.1 V U.1) →+*
    Γ(chartScheme V, U.1))) hfle
  rwa [Ideal.map_sup, Ideal.map_pow, Ideal.map_span, ← Set.range_comp] at h

/-- **The conormal conditions give quasi-regular generators around every point of a base
change.**  Let `j : Z_V ⟶ V` be the base change of the closed immersion `k` along an étale
chart `V` of `X`, locally of finite presentation.  If the conormal sheaf of `k` is finite locally
free and `Φ : Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` is an isomorphism in every degree, then every point of
`Z_V` lies over an affine open of `V` over which the chart ideal of `j` is generated by a
quasi-regular sequence.

The conormal sheaf is finite free on the slice at a Zariski open chart of `Z_V` around the point
(`AlgebraicGeometry.Space.exists_mem_isFiniteFree_over_openChart`), so its sections over the base
change of every small affine open chart of `V` there are free of a fixed rank `n`.  As in the
scheme case of Stacks 063M, a basis lifts to `n` elements of the ideal generating it modulo its
square, Nakayama's lemma shrinks the affine open to a basic open on which they generate it
(`Stacks.Conormal.exists_affineBasicOpen_chartIdeal_eq_span`), and the rank count
`AlgebraicGeometry.Space.isQuasiRegular_of_isIso_symmetricAlgebraToConormalAlgebra` makes them
quasi-regular there. -/
theorem exists_quasiRegular_affineChart_of_isIso_symmetricAlgebraToConormalAlgebra
    (V : SmallEtale B S hS X.1)
    [_root_.AlgebraicGeometry.IsImmersion ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom))]
    (hfp : LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)))
    (hflf : SheafOfModules.IsFiniteLocallyFreeOnSite ((conormalAlgebra B S hS k).piece 1))
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : (conormalAlgebra B S hS k).piece 1 ⟶ A.piece 1)
    (hA : SheafOfModules.GradedAlgebra.IsSymmetricAlgebra A ι)
    (hiso : ∀ n : ℤ, IsIso ((symmetricAlgebraToConormalAlgebra B S hS k A ι hA).app n))
    (z : chartScheme ((smallBaseChange B S hS k hk.1).obj V)) :
    ∃ (U : (chartScheme V).affineOpens)
      (_ : _root_.AlgebraicGeometry.IsClosedImmersion
        (((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)).resLE U.1
          (((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) ⁻¹ᵁ U.1) le_rfl))
      (_ : z ∈ ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) ⁻¹ᵁ U.1) (c : ℕ)
      (f : Fin c → Γ(chartScheme V, U.1)),
      Stacks.Conormal.chartIdeal ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) U =
          Ideal.span (Set.range f) ∧
        RingTheory.Sequence.IsQuasiRegular Γ(chartScheme V, U.1) (List.ofFn f) := by
  classical
  obtain ⟨O', hzO', hff⟩ := exists_mem_isFiniteFree_over_openChart B S hS Z _
    (isQuasicoherentOnSite_modulePullback_kernelPowModule_one B S hS k hk)
    ((smallBaseChange B S hS k hk.1).obj V) hflf z
  obtain ⟨n, ι', ⟨hcof⟩⟩ := (SheafOfModules.isFiniteFree_iff_exists_isColimit _ _).1 hff
  have hbasis : ∀ (T : SmallEtale B S hS Z.1)
      (_ : T ⟶ openChart B S hS Z.1 ((smallBaseChange B S hS k hk.1).obj V) O'),
      Nonempty (Module.Basis (Fin n) (chartRing B S hS Z.1 Z.2 T)
        (((modulePullback B S hS k).obj
          (kernelPowModule B S hS k ((1 : ℕ) : ℤ))).val.obj (op T))) :=
    fun T m => RingedSite.nonempty_basis_sections_of_isColimitCofanUnit
      (smallEtaleRingedSite B S hS Z.1 Z.2) _ n _ ι' hcof m
  obtain ⟨U, hzU, hUle, hUcob⟩ := Stacks.Conormal.exists_affineChart_mem
    ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) O' z hzO'
  have hU := _root_.AlgebraicGeometry.isClosedImmersion_resLE_of_le_coborderRange
    ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) U.1 hUcob
  -- the affine open chart `openChart V U` and its presentation
  obtain ⟨c, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (fg_conormalChartIdeal_openChart B S hS k hk V hfp U hU)
  obtain ⟨b⟩ := hbasis ((smallBaseChange B S hS k hk.1).obj (openChart B S hS X.1 V U.1))
    ((smallBaseChangeOpenChartIso B S hS k hk.1 V U.1).hom ≫
      openChartHomOfLE B S hS Z.1 ((smallBaseChange B S hS k hk.1).obj V) hUle)
  obtain ⟨f, hfmem, hfle⟩ := (conormalChartPresentation B S hS k hk _
    (isAffine_chartScheme_openChart B S hS X.1 V U) g hg.symm 1).exists_mem_le_span_sup_sq b
  -- transport to the scheme chart and shrink
  obtain ⟨hfmem', hfle'⟩ :=
    mem_chartIdeal_and_le_span_sup_sq_of_conormalChartIdeal B S hS k hk V U f hfmem hfle
  let ε := RingEquiv.ofBijective (openChartTopRingHom B S hS X V U.1)
    (bijective_openChartTopRingHom B S hS X V U.1)
  obtain ⟨r, hle, hU', hpre, hspan⟩ :=
    Stacks.Conormal.exists_affineBasicOpen_chartIdeal_eq_span _ hfp U hU
    (fun l => ε (f l)) hfmem' hfle'
  -- the rank count over the basic open chart
  let ε'' := RingEquiv.ofBijective
    (openChartTopRingHom B S hS X V ((chartScheme V).affineBasicOpen r).1)
    (bijective_openChartTopRingHom B S hS X V ((chartScheme V).affineBasicOpen r).1)
  have hI'' : conormalChartIdeal B S hS k
      (openChart B S hS X.1 V ((chartScheme V).affineBasicOpen r).1) =
      Ideal.span (Set.range fun l =>
        ε''.symm (((chartScheme V).presheaf.map (homOfLE hle).op).hom (ε (f l)))) :=
    conormalChartIdeal_openChart_eq_span B S hS k hk V ((chartScheme V).affineBasicOpen r) _ hspan
  obtain ⟨b''⟩ := hbasis ((smallBaseChange B S hS k hk.1).obj
      (openChart B S hS X.1 V ((chartScheme V).affineBasicOpen r).1))
    ((smallBaseChangeOpenChartIso B S hS k hk.1 V ((chartScheme V).affineBasicOpen r).1).hom ≫
      openChartHomOfLE B S hS Z.1 ((smallBaseChange B S hS k hk.1).obj V)
        (hpre.le.trans hUle))
  have hqr := Stacks.Conormal.isQuasiRegular_ringEquiv ε'' _
    (isQuasiRegular_of_isIso_symmetricAlgebraToConormalAlgebra B S hS k hk _
      (isAffine_chartScheme_openChart B S hS X.1 V ((chartScheme V).affineBasicOpen r))
      A ι hA hiso _ hI'' b'')
  simp only [RingEquiv.apply_symm_apply] at hqr
  exact ⟨(chartScheme V).affineBasicOpen r, hU', hpre ▸ hzU, n, _, hspan, hqr⟩

/-- **The conormal conditions make the base changes of a closed immersion quasi-regular**
(Stacks 09RY, the direction into quasi-regularity, for a closed immersion).  If the base change
`j_V` of the closed immersion `k` along every étale chart `V` of `X` is locally of finite
presentation, the conormal sheaf of `k` is finite locally free and the map
`Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` is an isomorphism in every degree, then every `j_V` is a
quasi-regular immersion: around every point it has an affine chart carrying a quasi-regular
generating sequence, by
`exists_quasiRegular_affineChart_of_isIso_symmetricAlgebraToConormalAlgebra`, which is the
affine-chart criterion
`Stacks.Conormal.isQuasiRegularImmersion_of_exists_quasiRegular_affineChart`. -/
@[sga "1 II 4.14" "(a)"]
theorem quasiRegularImmersionProperty_of_isIso_symmetricAlgebraToConormalAlgebra
    (hfp : ∀ V : SmallEtale B S hS X.1,
      LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)))
    (hflf : SheafOfModules.IsFiniteLocallyFreeOnSite ((conormalAlgebra B S hS k).piece 1))
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : (conormalAlgebra B S hS k).piece 1 ⟶ A.piece 1)
    (hA : SheafOfModules.GradedAlgebra.IsSymmetricAlgebra A ι)
    (hiso : ∀ n : ℤ, IsIso ((symmetricAlgebraToConormalAlgebra B S hS k A ι hA).app n))
    (V : SmallEtale B S hS X.1) :
    quasiRegularImmersionProperty ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) := by
  have : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (hk.1.snd V.1.hom)) :=
    isClosedImmersion_baseChangeChartDiagram_g B S hS k hk V
  exact ⟨inferInstance, Stacks.Conormal.isQuasiRegularImmersion_of_exists_quasiRegular_affineChart
    _ fun z => by
      obtain ⟨U, hU, hzU, c, f, hspan, hqr⟩ :=
        exists_quasiRegular_affineChart_of_isIso_symmetricAlgebraToConormalAlgebra
          B S hS k hk V (hfp V) hflf A ι hA hiso z
      exact ⟨U, hU, hzU, c, f, hspan, hqr⟩⟩

end Converse

