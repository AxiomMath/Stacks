module

public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleSubmoduleGluing
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeSubmoduleOfSections

/-!
# Dominating a finite type submodule over an étale chart of an affine algebraic space

Let `V` be an affine algebraic space over a scheme `S`, let `ℱ` be a quasi-coherent
`𝒪_V`-module, and let `g : Y ⟶ V` be an étale morphism with `Y` quasi-compact.  A quasi-coherent
submodule of finite type `𝒢 ⊆ ℱ|_Y` is then contained in the restriction of a quasi-coherent
submodule of finite type of `ℱ` itself.

Over a quasi-compact space `𝒢` is generated by finitely many sections over finitely many affine
étale charts of `Y`, each of which is an affine étale chart of `V`; on an affine algebraic space
each such section lies in a finite type quasi-coherent submodule of `ℱ`, and finitely many of
those have a finite type quasi-coherent upper bound.

## Main results

* `AlgebraicGeometry.Space.exists_isFiniteType_le_etaleSubmoduleRestrict_of_isAffineSpace`:
  the domination.

## Implementation notes

No Stacks tag is registered here.  The statement is neither Stacks 0829 — the directedness
and colimit assertions for a quasi-compact quasi-separated algebraic space, whose two clauses
are registered in
`StacksFrontier/AlgebraicGeometry/Spaces/FiniteTypeQuasicoherentSubobjects.lean` — nor Stacks 0853,
which extends a finite type quasi-coherent submodule along an *open immersion* and with equality
rather than containment.  It is the affine case of the containment form along an étale chart, and
affineness enters only through the affine case of the section form of Stacks 0829.

## References

* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 0853](https://stacks.math.columbia.edu/tag/0853)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **A finite type quasi-coherent submodule over a quasi-compact étale chart of an affine
algebraic space is dominated by one on the space.**  For `ℱ` a quasi-coherent module on an
affine algebraic space `V`, an étale `g : Y ⟶ V` with `Y` quasi-compact and a quasi-coherent
submodule of finite type `𝒢` of `ℱ|_Y`, there is a quasi-coherent submodule of finite type `𝒦`
of `ℱ` with `𝒢 ≤ 𝒦|_Y`.

The finitely many generating sections of `𝒢` over affine charts of `Y`
(`AlgebraicGeometry.Space.exists_finite_affine_sections_of_isFiniteType`) are sections of `ℱ`
over affine charts of `V`, so each lies in a finite type quasi-coherent submodule of `ℱ`
(`AlgebraicGeometry.Space.exists_submodule_isFiniteType_mem_of_isAffineSpace`); an upper bound
of those contains them all, hence contains `𝒢` after restriction. -/
theorem exists_isFiniteType_le_etaleSubmoduleRestrict_of_isAffineSpace
    {V : AlgebraicSpaces B S hS} (hVa : IsAffineSpace B S hS V.1)
    {F : Modules.{u, u} B S hS V.1 V.2} (hF : F.IsQuasicoherentOnSite)
    {Y : AlgebraicSpaces B S hS} (g : Y ⟶ V) (hg : IsEtale B S hS g.hom)
    (hYqc : IsQuasiCompactSpace B S hS Y.1)
    (G : ((etaleModulePullback.{u, u} B S hS g hg).obj F).Submodule)
    (hG : G.toSheafOfModules.IsFiniteType) :
    ∃ K : F.Submodule,
      (K.toSheafOfModules.IsQuasicoherentOnSite ∧ K.toSheafOfModules.IsFiniteType) ∧
        G ≤ etaleSubmoduleRestrict B S hS g hg K := by
  classical
  obtain ⟨ι, hι, T, s, hTaff, -, hgen⟩ :=
    exists_finite_affine_sections_of_isFiniteType B S hS hYqc G hG
  have := hι
  have haff : ∀ i, IsAffine ((SmallEtale.toOver B S hS V.1 ⋙ BigFppfOver.toScheme B S hS).obj
      ((smallEtalePostcomp B S hS g hg).obj (T i))) := hTaff
  choose K hK hmem using fun i =>
    exists_submodule_isFiniteType_mem_of_isAffineSpace B S hS V.2 hVa F hF
      ((smallEtalePostcomp B S hS g hg).obj (T i)) (haff i) (s i)
  obtain ⟨K', hK', hle⟩ := exists_submodule_isFiniteType_forall_le B S hS hF K hK
  refine ⟨K', hK', hgen _ fun i => ?_⟩
  exact (mem_etaleSubmoduleRestrict_obj B S hS g hg K' (T i) (s i)).2
    (mem_of_submodule_le B S hS (hle i) (hmem i))

end AlgebraicGeometry.Space

end
