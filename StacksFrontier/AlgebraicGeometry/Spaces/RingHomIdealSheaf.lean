module

public import StacksFrontier.AlgebraicGeometry.Spaces.GrothendieckExistence.HomBijection.BaseIdealSheaf

/-!
# The sheaf of ideals generated by an ideal of a ring mapping to the global functions

Let `X` be an algebraic space over a scheme `S`, `A` a commutative ring and
`φ : A ⟶ Γ(X, 𝒪_X)` a ring map to the global functions.  For an ideal `I ⊆ A` the sheaf of ideals
`I 𝒪_X ⊆ 𝒪_X` is the image of multiplication by the elements of `φ(I)`
(`AlgebraicGeometry.Space.ringHomIdealSheaf`).  Over an affine étale chart `U` its sections are
the extended ideal `I 𝒪(U)`, it is quasi-coherent, and for every `𝒪_X`-module `M` the quotient
`M / (I 𝒪_X)^k M` is the quotient `M / I^k M` of multiplication by the elements of `I^k`
(`AlgebraicGeometry.Space.ringHomIdealQuotientIso`).

For a space over `Spec A` and `φ` its structure map, `I 𝒪_X` is
`AlgebraicGeometry.Space.C1573.baseIdealSubmodule`.

## Main results

* `AlgebraicGeometry.Space.ringHomIdealSheaf`: the sheaf of ideals `I 𝒪_X`.
* `AlgebraicGeometry.Space.ringHomIdealSheaf_obj_of_isAffine`: its sections over an affine chart.
* `AlgebraicGeometry.Space.isQuasicoherentOnSite_ringHomIdealSheaf`: it is quasi-coherent.
* `AlgebraicGeometry.Space.ringHomIdealQuotientIso`: `M / (I 𝒪_X)^k M ≅ M / I^k M`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.SiteModules

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {A : Type u} [CommRing A]
  (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hX : IsAlgebraicSpace B S hS X)
  (φ : A →+* ↥(GlobalSectionRing
    ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O))))

/-- The image of a scalar of the base ring in the ring of an étale chart. -/
def ringHomChartHom (U : SmallEtale B S hS X) :
    A →+* chartRing B S hS X hX U where
  toFun a := (φ a).1 (op U)
  map_one' := congrFun (congrArg Subtype.val (map_one φ)) (op U)
  map_mul' a b := congrFun (congrArg Subtype.val (map_mul φ a b)) (op U)
  map_zero' := congrFun (congrArg Subtype.val (map_zero φ)) (op U)
  map_add' a b := congrFun (congrArg Subtype.val (map_add φ a b)) (op U)

/-- The image of `a` in the ring of the chart `U` is the section of `φ a` over `U`. -/
theorem ringHomChartHom_apply (U : SmallEtale B S hS X) (a : A) :
    ringHomChartHom X hX φ U a = (φ a).1 (op U) := rfl

/-- **The sheaf of ideals `I 𝒪_X`** generated by an ideal `I` of the base ring: the image of
multiplication by the elements of `I` on `𝒪_X`. -/
def ringHomIdealSheaf (I : Ideal A) :
    (SheafOfModules.unit
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X hX).O)).Submodule :=
  Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule
    (idealMultipleι φ (SheafOfModules.unit _) I)

variable {X hX φ}

/-- If `t • s ∈ N` for all generators `t` of `b`, then `b • s ∈ N`. -/
private theorem smul_mem_of_mem_span {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) (s : M) {T : Set R} (hT : ∀ t ∈ T, t • s ∈ N) {b : R}
    (hb : b ∈ Submodule.span R T) : b • s ∈ N :=
  (Submodule.span_le (p := N.comap (LinearMap.toSpanSingleton R M s))).2 hT hb

/-- Multiplication by `a ∈ J` followed by the inclusion of `J M` is multiplication by the image
of `a` on the sections over a chart. -/
theorem ringHomIdealMultipleFactor_ι_app (M : Modules.{u, u} B S hS X hX) (J : Ideal A)
    {a : A} (ha : a ∈ J) (U : SmallEtale B S hS X) (s : M.val.obj (op U)) :
    (idealMultipleι φ M J).val.app (op U)
        ((idealMultipleFactor φ M J ha).val.app (op U) s) =
      ringHomChartHom X hX φ U a • s := by
  have h := congrArg (fun k => k.val.app (op U) s)
    (idealMultipleFactor_ι φ M J ha)
  exact h

/-- **The sections of `J M` over an affine chart are `J 𝒪(U) · M(U)`**, for quasi-coherent `M`,
read inside `M` as the local image of the inclusion of `J M`. -/
theorem ringHom_imageSubmodule_idealMultipleι_obj_of_isAffine (M : Modules.{u, u} B S hS X hX)
    (hM : M.IsQuasicoherentOnSite) (J : Ideal A) (U : SmallEtale B S hS X)
    (hU : IsAffine ((SmallEtale.toOver B S hS X ⋙
      BigFppfOver.toScheme B S hS).obj U)) :
    (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule
        (idealMultipleι φ M J)).obj (op U) =
      Ideal.map (ringHomChartHom X hX φ U) J •
        (⊤ : Submodule (chartRing B S hS X hX U) (M.val.obj (op U))) := by
  set ι := idealMultipleι φ M J
  have hrange : (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule ι).obj (op U) =
      LinearMap.range (ι.val.app (op U)).hom := by
    ext x
    exact Stacks.SheafOfModules.ImageSubsheaf.C1573.mem_imageSubmodule_iff_of_mono ι x
  rw [hrange, LinearMap.range_eq_map, ← span_idealMultipleFactor_sections _ M J hM U hU,
    Submodule.map_span]
  refine le_antisymm (Submodule.span_le.2 ?_) ?_
  · rintro _ ⟨_, ⟨a, ha, s, rfl⟩, rfl⟩
    show (ι.val.app (op U)) ((idealMultipleFactor _ M J ha).val.app (op U) s) ∈ _
    rw [ringHomIdealMultipleFactor_ι_app]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ha) Submodule.mem_top
  · refine Submodule.smul_le.2 fun b hb s _ => ?_
    refine smul_mem_of_mem_span _ s ?_ hb
    rintro _ ⟨a, ha, rfl⟩
    refine Submodule.subset_span ⟨_, ⟨a, ha, s, rfl⟩, ?_⟩
    exact ringHomIdealMultipleFactor_ι_app M J ha U s

/-- **The extended ideal lies in the sections of `I 𝒪_X` over every chart.** -/
theorem map_le_ringHomIdealSheaf_obj (I : Ideal A) (U : SmallEtale B S hS X) :
    Ideal.map (ringHomChartHom X hX φ U) I ≤
      chartIdeal B S hS ⟨X, hX⟩ (ringHomIdealSheaf X hX φ I) U := by
  refine Ideal.map_le_iff_le_comap.2 fun a ha => ?_
  have h := Stacks.SheafOfModules.ImageSubsheaf.apply_mem_imageSubmodule
    (idealMultipleι φ (SheafOfModules.unit _) I)
    ((idealMultipleFactor φ (SheafOfModules.unit _) I ha).val.app (op U)
      (1 : chartRing B S hS X hX U))
  have h2 := ringHomIdealMultipleFactor_ι_app (hX := hX) (φ := φ)
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X hX).O)) I ha U
    (1 : chartRing B S hS X hX U)
  show ringHomChartHom X hX φ U a ∈ (ringHomIdealSheaf X hX φ I).obj (op U)
  have h1 : ringHomChartHom X hX φ U a • (1 : chartRing B S hS X hX U) =
      ringHomChartHom X hX φ U a := mul_one _
  exact (h2.trans h1) ▸ h

/-- **The sections of `I 𝒪_X` over an affine chart are the extended ideal `I 𝒪(U)`.** -/
theorem ringHomIdealSheaf_obj_of_isAffine (I : Ideal A) (U : SmallEtale B S hS X)
    (hU : IsAffine ((SmallEtale.toOver B S hS X ⋙
      BigFppfOver.toScheme B S hS).obj U)) :
    chartIdeal B S hS ⟨X, hX⟩ (ringHomIdealSheaf X hX φ I) U =
      Ideal.map (ringHomChartHom X hX φ U) I := by
  have h := ringHom_imageSubmodule_idealMultipleι_obj_of_isAffine (hX := hX) (φ := φ)
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X hX).O))
    (SheafOfModules.isQuasicoherentOnSite_unit _) I U hU
  show (ringHomIdealSheaf X hX φ I).obj (op U) = _
  refine h.trans ?_
  exact (Ideal.smul_eq_mul _ _).trans (Ideal.mul_top _)

/-- **`I 𝒪_X` is quasi-coherent.** -/
theorem isQuasicoherentOnSite_ringHomIdealSheaf (I : Ideal A) :
    (ringHomIdealSheaf X hX φ I).toSheafOfModules.IsQuasicoherentOnSite :=
  SheafOfModules.IsQuasicoherentOnSite.of_iso
    (Stacks.SheafOfModules.ImageSubsheaf.C1573.isoImageSubmoduleOfMono
      (idealMultipleι φ (SheafOfModules.unit _) I))
    (isQuasicoherentOnSite_idealMultiple _ _ I (SheafOfModules.isQuasicoherentOnSite_unit _))

/-- The image of an element of `I ^ k` in the ring of any chart lies in the `k`-th power of the
sections of `I 𝒪_X`. -/
theorem ringHomChartHom_mem_pow (I : Ideal A) (k : ℕ) {a : A} (ha : a ∈ I ^ k)
    (U : SmallEtale B S hS X) :
    ringHomChartHom X hX φ U a ∈ chartIdeal B S hS ⟨X, hX⟩ (ringHomIdealSheaf X hX φ I) U ^ k := by
  have h1 : ringHomChartHom X hX φ U a ∈ Ideal.map (ringHomChartHom X hX φ U) (I ^ k) :=
    Ideal.mem_map_of_mem _ ha
  rw [Ideal.map_pow] at h1
  exact Ideal.pow_right_mono (map_le_ringHomIdealSheaf_obj I U) k h1

/-- **`(I 𝒪_X)^k` annihilates `M / I^k M`**: over every chart `U`, an element of the `k`-th
power of the sections of `I 𝒪_X` over `U` kills every section of `M / I^k M` over `U`. -/
theorem ringHom_smul_idealQuotient_eq_zero (M : Modules.{u, u} B S hS X hX) (I : Ideal A)
    (k : ℕ) (U : (smallEtaleRingedSite B S hS X hX).C)
    (r : chartRing B S hS X hX U)
    (hr : r ∈ chartIdeal B S hS ⟨X, hX⟩ (ringHomIdealSheaf X hX φ I) U ^ k)
    (y : (idealQuotient φ M (I ^ k)).val.obj (op U)) : r • y = 0 := by
  have key : ∀ (W : (smallEtaleRingedSite B S hS X hX).C) (g : W ⟶ U),
      IsAffine (chartScheme W) →
        (idealQuotient φ M (I ^ k)).val.map g.op (r • y) =
          (idealQuotient φ M (I ^ k)).val.map g.op 0 := by
    intro W g hW
    rw [map_zero, PresheafOfModules.map_smul]
    have hle : Ideal.map ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X hX).O).obj.map g.op).hom
          (chartIdeal B S hS ⟨X, hX⟩ (ringHomIdealSheaf X hX φ I) U) ≤
        chartIdeal B S hS ⟨X, hX⟩ (ringHomIdealSheaf X hX φ I) W :=
      Ideal.map_le_iff_le_comap.2 fun c hc => (ringHomIdealSheaf X hX φ I).map g.op hc
    have h2 := Ideal.mem_map_of_mem ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X hX).O).obj.map g.op).hom hr
    rw [Ideal.map_pow] at h2
    have h3 := Ideal.pow_right_mono hle k h2
    rw [ringHomIdealSheaf_obj_of_isAffine I W hW, ← Ideal.map_pow] at h3
    refine Submodule.mem_bot _ |>.1 <| smul_mem_of_mem_span ⊥ _ ?_ h3
    rintro _ ⟨a, ha, rfl⟩
    exact congrArg (fun e => e.val.app (op W) ((idealQuotient φ M (I ^ k)).val.map g.op y))
      (globalSmul_idealQuotient_eq_zero φ M (I ^ k) ha)
  exact SmallEtale.C1573.eq_of_forall_isAffine B S hS X hX
    (Stacks.SheafOfModules.ImageSubsheaf.isSheaf_forget
      (idealQuotient φ M (I ^ k))) fun W g hW => key W g hW

/-- `(I 𝒪_X)^k M` is killed by the projection onto `M / I^k M`. -/
theorem ringHom_idealPowerSubsheaf_ι_idealQuotientπ (M : Modules.{u, u} B S hS X hX)
    (I : Ideal A) (k : ℕ) :
    (idealPowerSubsheaf B S hS X hX (ringHomIdealSheaf X hX φ I) k M).ι ≫
      idealQuotientπ φ M (I ^ k) = 0 :=
  (idealPowerSubsheaf_ι_comp_zero_iff B S hS X hX _ k _).2 fun U r hr x =>
    (map_smul ((idealQuotientπ φ M (I ^ k)).val.app (op U)).hom r x).trans
      (ringHom_smul_idealQuotient_eq_zero M I k U r hr _)

/-- `I^k M` is killed by the projection onto `M / (I 𝒪_X)^k M`. -/
theorem ringHom_idealMultipleι_smallEtaleAdicQuotientProjection
    (M : Modules.{u, u} B S hS X hX) (I : Ideal A) (k : ℕ) :
    idealMultipleι φ M (I ^ k) ≫
      smallEtaleAdicQuotientProjection B S hS X hX (ringHomIdealSheaf X hX φ I) k M = 0 := by
  refine idealMultiple_hom_ext _ M _ fun a ha => ?_
  rw [comp_zero, ← Category.assoc, idealMultipleFactor_ι,
    ← Stacks.Cohomology.SiteModules.comp_globalSmul]
  have hz : Stacks.Cohomology.SiteModules.globalSmul _ (φ a)
      (smallEtaleAdicQuotient B S hS X hX (ringHomIdealSheaf X hX φ I) k M) = 0 := by
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    exact isPowAnnihilated_smallEtaleAdicQuotient B S hS X hX _ k M U.unop _
      (ringHomChartHom_mem_pow I k ha U.unop) x
  rw [hz, comp_zero]

/-- **`M / (I 𝒪_X)^k M ≅ M / I^k M`**, compatibly with the projections from `M`. -/
def ringHomIdealQuotientIso (M : Modules.{u, u} B S hS X hX) (I : Ideal A) (k : ℕ) :
    smallEtaleAdicQuotient B S hS X hX (ringHomIdealSheaf X hX φ I) k M ≅
      idealQuotient φ M (I ^ k) where
  hom := cokernel.desc _ _ (ringHom_idealPowerSubsheaf_ι_idealQuotientπ M I k)
  inv := cokernel.desc _ _ (ringHom_idealMultipleι_smallEtaleAdicQuotientProjection M I k)
  hom_inv_id := by
    refine (cancel_epi (smallEtaleAdicQuotientProjection B S hS X hX _ k M)).1 ?_
    rw [Category.comp_id, ← Category.assoc, cokernel.π_desc, cokernel.π_desc]
  inv_hom_id := by
    refine (cancel_epi (idealQuotientπ φ M (I ^ k))).1 ?_
    rw [Category.comp_id, ← Category.assoc, cokernel.π_desc, cokernel.π_desc]

/-- The projection `M ⟶ M / (I 𝒪_X)^k M` followed by `ringHomIdealQuotientIso` is the projection
`M ⟶ M / I^k M`. -/
@[reassoc (attr := simp)]
theorem smallEtaleAdicQuotientProjection_ringHomIdealQuotientIso_hom
    (M : Modules.{u, u} B S hS X hX) (I : Ideal A) (k : ℕ) :
    smallEtaleAdicQuotientProjection B S hS X hX (ringHomIdealSheaf X hX φ I) k M ≫
      (ringHomIdealQuotientIso M I k).hom = idealQuotientπ φ M (I ^ k) :=
  cokernel.π_desc _ _ _

end AlgebraicGeometry.Space

end
