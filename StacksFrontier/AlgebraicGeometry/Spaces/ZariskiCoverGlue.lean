module

public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.GroupSpaces.TorsorsWithEquivariantMap
public import StacksFrontier.AlgebraicGeometry.Spaces.ZariskiCover

/-!
# Glueing morphisms along a Zariski covering of an algebraic space

A morphism out of an algebraic space into a sheaf on the big fppf site is glued from, and is
determined by, its restrictions to the members of a Zariski covering. The covering hypothesis of
`AlgebraicGeometry.Space.glueHom` and `AlgebraicGeometry.Space.hom_ext_of_familyImage_cover`, that
the subfunctor `AlgebraicGeometry.Space.familyImage p` generated by the images of a family
`p i : Pi i ⟶ P` has a covering sieve of sections at every object, follows from local
surjectivity of the map `∐ Pi ⟶ P` out of the coproduct, which is how
`AlgebraicGeometry.Space.IsZariskiCover` is stated.

## Main results

* `AlgebraicGeometry.Space.familyImage_sieveOfSection_mem_of_isLocallySurjective`: if the map out
  of the coproduct of a family is locally surjective for a topology, then the subfunctor
  generated by the images of the family satisfies the covering hypothesis of
  `AlgebraicGeometry.Space.glueHom`.
* `AlgebraicGeometry.Space.familyImage_sieveOfSection_mem_of_isZariskiCover`: the same for a
  Zariski covering of an algebraic space.
* `AlgebraicGeometry.Space.glueHom_of_isZariskiCover` and
  `AlgebraicGeometry.Space.hom_ext_of_isZariskiCover`: a morphism from an algebraic space into
  a sheaf on the big fppf site is glued from, and determined by, its restrictions to the
  members of a Zariski covering.

## References

* [Stacks Project, Tag 02YY](https://stacks.math.columbia.edu/tag/02YY)
* [Stacks Project, Tag 089J](https://stacks.math.columbia.edu/tag/089J)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

section Bridge

universe v₁ u₁

variable {C : Type u₁} [Category.{v₁} C] {I : Type v₁} {P : Cᵒᵖ ⥤ Type v₁}
  {Pi : I → Cᵒᵖ ⥤ Type v₁}

/-- If the map out of the coproduct of a family `p` is locally surjective for `J`, then the
subfunctor generated by the images of `p` has a covering sieve of sections at every object. -/
theorem familyImage_sieveOfSection_mem_of_isLocallySurjective (J : GrothendieckTopology C)
    (p : ∀ i, Pi i ⟶ P) [HasCoproduct Pi]
    (h : Presheaf.IsLocallySurjective J (Sigma.desc p)) (Z : C)
    (x : P.obj (Opposite.op Z)) : (familyImage p).sieveOfSection x ∈ J Z := by
  refine J.superset_covering ?_ (Presheaf.imageSieve_mem J (Sigma.desc p) x)
  intro W g hg
  obtain ⟨tW, htW⟩ := hg
  have hc : IsColimit (((evaluation Cᵒᵖ (Type v₁)).obj (Opposite.op W)).mapCocone
      (colimit.cocone (Discrete.functor Pi))) :=
    isColimitOfPreserves _ (colimit.isColimit _)
  obtain ⟨⟨i⟩, y, hy⟩ := Types.jointly_surjective_of_isColimit hc tW
  have hy' : (Sigma.ι Pi i).app (Opposite.op W) y = tW := hy
  refine ⟨i, y, ?_⟩
  rw [← htW, ← hy', ← types_comp_apply ((Sigma.ι Pi i).app (Opposite.op W))
    ((Sigma.desc p).app (Opposite.op W)), ← NatTrans.comp_app, Sigma.ι_desc]

end Bridge

section ZariskiCover

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The subfunctor generated by the members of a Zariski covering has a covering sieve of
sections at every object. -/
theorem familyImage_sieveOfSection_mem_of_isZariskiCover
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {I : Type u} (U : I → Subfunctor F)
    (hU : IsZariskiCover B S hS I U) (Z : BigFppfOver B S hS)
    (x : F.obj (Opposite.op Z)) :
    (familyImage fun i => (U i).ι).sieveOfSection x ∈ BigFppfOver.topology B S hS Z :=
  familyImage_sieveOfSection_mem_of_isLocallySurjective _ _ hU.2 Z x

/-- A morphism out of an algebraic space into a sheaf is glued from its restrictions to the
members of a Zariski covering. -/
theorem glueHom_of_isZariskiCover {F Q : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {I : Type u}
    (U : I → Subfunctor F) (hU : IsZariskiCover B S hS I U)
    (hQ : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Q)
    (φ : ∀ i, (U i).toFunctor ⟶ Q)
    (hφ : ∀ Z i j (x : (U i).toFunctor.obj Z) (y : (U j).toFunctor.obj Z),
      (U i).ι.app Z x = (U j).ι.app Z y → (φ i).app Z x = (φ j).app Z y) :
    ∃! ψ : F ⟶ Q, ∀ i, (U i).ι ≫ ψ = φ i :=
  glueHom _ _ (familyImage_sieveOfSection_mem_of_isZariskiCover B S hS U hU) hQ φ hφ

/-- Two morphisms out of an algebraic space into a sheaf agreeing on a Zariski covering are
equal. -/
theorem hom_ext_of_isZariskiCover {F Q : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {I : Type u}
    (U : I → Subfunctor F) (hU : IsZariskiCover B S hS I U)
    (hQ : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Q) (ψ ψ' : F ⟶ Q)
    (hψ : ∀ i, (U i).ι ≫ ψ = (U i).ι ≫ ψ') : ψ = ψ' :=
  hom_ext_of_familyImage_cover _ _
    (familyImage_sieveOfSection_mem_of_isZariskiCover B S hS U hU) hQ ψ ψ' hψ

end ZariskiCover

end AlgebraicGeometry.Space

end
