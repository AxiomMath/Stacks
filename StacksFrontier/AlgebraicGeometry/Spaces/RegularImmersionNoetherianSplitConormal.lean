-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z Y X : Scheme.{u}}

/-! ### Regularity near every point versus regularity -/

/-- **A regular immersion is a regular immersion on a neighbourhood of each point.**  The
neighbourhood may be taken to be the whole regular locus, which is open over a locally
Noetherian target. -/
theorem exists_opens_isRegularImmersion_of_isRegularImmersion (f : Z ⟶ X) [IsImmersion f]
    [IsLocallyNoetherian X] (hf : IsRegularImmersion f) (z : Z) :
    ∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ f) := by
  refine ⟨⟨regularStalkLocus f, isOpen_regularStalkLocus f⟩,
    exists_isRegular_ker_stalkMap_of_isRegularImmersion f hf z, ?_⟩
  set W : Z.Opens := ⟨regularStalkLocus f, isOpen_regularStalkLocus f⟩ with hW
  refine isRegularImmersion_of_exists_isRegular_ker_stalkMap (W.ι ≫ f) fun w => ?_
  rw [ker_stalkMap_comp_isOpenImmersion W.ι f w]
  exact w.2

/-- **Regularity on a neighbourhood of every point is regularity.**  An immersion into a locally
Noetherian scheme which is a regular immersion near each point of its source is a regular
immersion:  the condition is read on the kernels of the maps of local rings, which the
neighbourhoods already control. -/
theorem isRegularImmersion_of_forall_exists_opens (f : Z ⟶ X) [IsImmersion f]
    [IsLocallyNoetherian X]
    (h : ∀ z : Z, ∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ f)) :
    IsRegularImmersion f :=
  isRegularImmersion_of_exists_isRegular_ker_stalkMap f fun z =>
    mem_regularStalkLocus_of_exists_opens f z (h z)

/-! ### Stacks tag 0690 in global Koszul form -/

/-- **Koszul-regularity of the second immersion near the image of the first.**  For immersions
`i : Z ⟶ Y` and `j : Y ⟶ X`, the condition that every point of the image of `i` has an open
neighbourhood in `Y` on which `j` is a Koszul-regular immersion.

This is the second clause of condition (1) of Stacks tag 0690, and the clause of condition (1)
of Stacks tag 09S2 that is true;  see the module documentation. -/
def IsKoszulRegularImmersionNearImage (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i] [IsImmersion j] :
    Prop :=
  ∀ z : Z, ∃ V : Y.Opens, i.base z ∈ V ∧ IsKoszulRegularImmersion (V.ι ≫ j)

/-- **Stacks tag 0690, `(1) ⇒ (2)`, globally and for Koszul-regularity.**  Let `i : Z ⟶ Y` and
`j : Y ⟶ X` be immersions of schemes with `X` locally Noetherian.  If `i` is a Koszul-regular
immersion and `j` is one near the image of `i`, then `i ≫ j` is a Koszul-regular immersion.

Over a locally Noetherian target Koszul-regularity is regularity by Stacks tag 063L, and
regularity near every point of the source is regularity, so the pointwise statement of the
source globalizes. -/
theorem isKoszulRegularImmersion_comp_of_nearImage (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i]
    [IsImmersion j] [IsLocallyNoetherian X] (hi : IsKoszulRegularImmersion i)
    (hj : IsKoszulRegularImmersionNearImage i j) : IsKoszulRegularImmersion (i ≫ j) := by
  have hY : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian j
  have hireg : IsRegularImmersion i := (isRegularImmersion_iff_isKoszulRegularImmersion i).mpr hi
  refine (isRegularImmersion_iff_isKoszulRegularImmersion (i ≫ j)).mp ?_
  refine isRegularImmersion_of_forall_exists_opens (i ≫ j) fun z => ?_
  obtain ⟨V, hzV, hVK⟩ := hj z
  have hVreg : IsRegularImmersion (V.ι ≫ j) :=
    (isRegularImmersion_iff_isKoszulRegularImmersion (V.ι ≫ j)).mpr hVK
  exact exists_opens_isRegularImmersion_comp_of_factors i j z
    (exists_opens_isRegularImmersion_of_isRegularImmersion i hireg z) ⟨V, hzV, hVreg⟩

/-- **Stacks tag 0690, `(3) ⇒ (1)`, globally and for Koszul-regularity.**  Let `i : Z ⟶ Y` and
`j : Y ⟶ X` be immersions of schemes with `X` locally Noetherian.  If `i ≫ j` is a Koszul-regular
immersion and the conormal sequence of the pair is exact and locally split, then `i` is a
Koszul-regular immersion and `j` is one near the image of `i`.

As for `isKoszulRegularImmersion_comp_of_nearImage`, Stacks tag 063L and the openness of the
regular locus turn the pointwise statement of the source into this one. -/
theorem isKoszulRegularImmersion_and_nearImage_of_comp (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i]
    [IsImmersion j] [IsLocallyNoetherian X] (hseq : IsSplitExactConormalSequence i j)
    (hij : IsKoszulRegularImmersion (i ≫ j)) :
    IsKoszulRegularImmersion i ∧ IsKoszulRegularImmersionNearImage i j := by
  have hY : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian j
  have hijreg : IsRegularImmersion (i ≫ j) :=
    (isRegularImmersion_iff_isKoszulRegularImmersion (i ≫ j)).mpr hij
  have key : ∀ z : Z, (∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ i)) ∧
      ∃ V : Y.Opens, i.base z ∈ V ∧ IsRegularImmersion (V.ι ≫ j) := fun z =>
    exists_opens_isRegularImmersion_of_split i j hseq z
      (exists_opens_isRegularImmersion_of_isRegularImmersion (i ≫ j) hijreg z)
  refine ⟨(isRegularImmersion_iff_isKoszulRegularImmersion i).mp
    (isRegularImmersion_of_forall_exists_opens i fun z => (key z).1), fun z => ?_⟩
  obtain ⟨V, hzV, hVreg⟩ := (key z).2
  exact ⟨V, hzV, (isRegularImmersion_iff_isKoszulRegularImmersion (V.ι ≫ j)).mp hVreg⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

/-! ### Stacks tag 09S2 -/

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {Z Y X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- **Koszul-regularity of `j` near the image of `i`, read on the étale charts of `X`.**  For
representable morphisms `i : Z ⟶ Y` and `j : Y ⟶ X` of algebraic spaces over `S`, the condition
that over every étale scheme chart `c` of `X` the base change of `j` to `c` and the base change
of `i` to the chart of `Y` pulled back from `c` are immersions of schemes with the base change
of `j` Koszul-regular on a neighbourhood of every point of the image of the base change of `i`.

This is the second clause of condition (1) of Stacks tag 09S2, corrected as the module
documentation explains, and stated in the shape in which the conditions of Stacks tags 06BM,
06BN and 03MJ are stated for algebraic spaces. -/
abbrev IsKoszulRegularImmersionNearImageOnEtaleCharts (i : Z ⟶ Y) (j : Y ⟶ X) : Prop :=
  ∃ (hi : yoneda.relativelyRepresentable i) (hj : yoneda.relativelyRepresentable j),
    ∀ (W : BigFppfOver B S hS) (c : yoneda.obj W ⟶ X),
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf c →
      ∃ (hic : _root_.AlgebraicGeometry.IsImmersion
          ((BigFppfOver.toScheme B S hS).map (hi.snd (hj.fst c))))
        (hjc : _root_.AlgebraicGeometry.IsImmersion
          ((BigFppfOver.toScheme B S hS).map (hj.snd c))),
        @Stacks.AlgebraicGeometry.RegularIdealSheaf.IsKoszulRegularImmersionNearImage _ _ _
          ((BigFppfOver.toScheme B S hS).map (hi.snd (hj.fst c)))
          ((BigFppfOver.toScheme B S hS).map (hj.snd c)) hic hjc

/-! #### The chart-level content of Stacks tag 0690 -/

/-- An étale chart of a locally Noetherian algebraic space is a locally Noetherian scheme. -/
private theorem isLocallyNoetherian_obj_of_etale_chart (hX : IsAlgebraicSpace B S hS X)
    (hnoeth : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (W : BigFppfOver B S hS) (c : yoneda.obj W ⟶ X)
    (hc : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf c) :
    IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj W) :=
  (exists_atlas_iff_forall_etale B S hS X
    (fun T : Scheme.{u} => IsLocallyNoetherian T) hX).1 hnoeth W c hc

/-- **Stacks tag 0690, `(3) ⇒ (1)`, on one étale chart of `X`.**  Over an étale chart `c` of a
locally Noetherian `X`, Koszul-regularity of the base change of `i ≫ j` together with the
conormal hypothesis gives Koszul-regularity of the base change of `i` and Koszul-regularity of
the base change of `j` near the image of that of `i`.

The chart is a locally Noetherian scheme by Stacks tag 03E8, the base change of `i ≫ j` is the
composite of the two base changes up to the comparison isomorphism, and the scheme statement is
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegularImmersion_and_nearImage_of_comp`. -/
private theorem exists_koszul_and_nearImage_on_chart (hX : IsAlgebraicSpace B S hS X)
    {i : Z ⟶ Y} {j : Y ⟶ X}
    (hnoeth : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hri : yoneda.relativelyRepresentable i) (hrj : yoneda.relativelyRepresentable j)
    (hrij : yoneda.relativelyRepresentable (i ≫ j))
    (hseq : ∀ (W : BigFppfOver B S hS) (c : yoneda.obj W ⟶ X),
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf c →
      ∃ (hic : _root_.AlgebraicGeometry.IsImmersion
          ((BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst c))))
        (hjc : _root_.AlgebraicGeometry.IsImmersion
          ((BigFppfOver.toScheme B S hS).map (hrj.snd c))),
        @Stacks.AlgebraicGeometry.IsSplitExactConormalSequence _ _ _
          ((BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst c)))
          ((BigFppfOver.toScheme B S hS).map (hrj.snd c)) hic hjc)
    (hij : ∀ (W : BigFppfOver B S hS) (c : yoneda.obj W ⟶ X),
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf c →
      ∃ hf : _root_.AlgebraicGeometry.IsImmersion
          ((BigFppfOver.toScheme B S hS).map (hrij.snd c)),
        @Stacks.AlgebraicGeometry.RegularIdealSheaf.IsKoszulRegularImmersion _ _ _ hf)
    (W : BigFppfOver B S hS) (c : yoneda.obj W ⟶ X)
    (hc : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf c) :
    ∃ (hic : _root_.AlgebraicGeometry.IsImmersion
        ((BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst c))))
      (hjc : _root_.AlgebraicGeometry.IsImmersion
        ((BigFppfOver.toScheme B S hS).map (hrj.snd c))),
      @Stacks.AlgebraicGeometry.RegularIdealSheaf.IsKoszulRegularImmersion _ _ _ hic ∧
        @Stacks.AlgebraicGeometry.RegularIdealSheaf.IsKoszulRegularImmersionNearImage _ _ _
          ((BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst c)))
          ((BigFppfOver.toScheme B S hS).map (hrj.snd c)) hic hjc := by
  obtain ⟨hic, hjc, hseqc⟩ := hseq W c hc
  obtain ⟨hImmOut, hOut⟩ := hij W c hc
  obtain ⟨e, heSch⟩ := exists_toSchemeIso_comp B S hS hri hrj hrij c
  have := isLocallyNoetherian_obj_of_etale_chart B S hS hX hnoeth W c hc
  have := hic
  have := hjc
  have := hImmOut
  have heInv : e.inv ≫ (BigFppfOver.toScheme B S hS).map (hrij.snd c) =
      (BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst c)) ≫
        (BigFppfOver.toScheme B S hS).map (hrj.snd c) := by
    rw [← heSch, Iso.inv_hom_id_assoc]
  have hcomp : ∃ hf : _root_.AlgebraicGeometry.IsImmersion
      ((BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst c)) ≫
        (BigFppfOver.toScheme B S hS).map (hrj.snd c)),
      @Stacks.AlgebraicGeometry.RegularIdealSheaf.IsKoszulRegularImmersion _ _ _ hf := by
    rw [← heInv]
    exact ⟨inferInstance,
      Stacks.AlgebraicGeometry.isKoszulRegularImmersion_iso_hom_comp e.symm _ hOut⟩
  obtain ⟨_, hcompReg⟩ := hcomp
  exact ⟨hic, hjc,
    Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegularImmersion_and_nearImage_of_comp
      _ _ hseqc hcompReg⟩

/-! #### The three equivalent conditions -/

/-- **Stacks tag 09S2.**  Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions of algebraic spaces over
a scheme `S` with `X` locally Noetherian.  Then the following are equivalent:

1. `i` is a Koszul-regular immersion and `j` is a Koszul-regular immersion near the image of `i`,
2. `i` and `i ≫ j` are Koszul-regular immersions,
3. `i ≫ j` is a Koszul-regular immersion and the conormal sequence
   `0 ⟶ i^* 𝒞_{Y/X} ⟶ 𝒞_{Z/X} ⟶ 𝒞_{Z/Y} ⟶ 0` of Stacks tag 06BD is exact and locally split.

Conditions (1) and (3) are read on the étale scheme charts of `X`, as every condition on
algebraic spaces whose scheme analogue this development localizes.  The second clause of
condition (1) is Koszul-regularity of `j` on a neighbourhood of the image of `i`, not on all of
`Y`:  the source states it on all of `Y`, which is false, and the module documentation gives the
counterexample and the reason the cited scheme-level Stacks tag 0690 is itself pointwise. -/
@[stacks 09S2 "all three conditions, with the second clause of condition (1) — Koszul-regularity \
of j — localized to a neighbourhood of the image of i and read on the étale charts of X.  The \
source states that clause on all of Y, which is false:  for Z empty, conditions (2) and (3) hold \
for every j, while j need not be Koszul-regular.  The localized clause is what the cited \
scheme-level Tag 0690 proves, that tag being stated at a point of Z"]
theorem isKoszulRegularImmersion_tfae_of_isLocallyNoetherian (hZ : IsAlgebraicSpace B S hS Z)
    (hY : IsAlgebraicSpace B S hS Y) (hX : IsAlgebraicSpace B S hS X) (i : Z ⟶ Y) (j : Y ⟶ X)
    (_hi : IsImmersion B S hS i) (hj : IsImmersion B S hS j)
    (hnoeth : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T)) :
    List.TFAE
      [IsKoszulRegularImmersion B S hS i ∧
          IsKoszulRegularImmersionNearImageOnEtaleCharts B S hS i j,
        IsKoszulRegularImmersion B S hS i ∧ IsKoszulRegularImmersion B S hS (i ≫ j),
        IsKoszulRegularImmersion B S hS (i ≫ j) ∧
          IsSplitExactConormalSequenceOnEtaleCharts B S hS i j] := by
  tfae_have 1 → 2 := by
    rintro ⟨⟨hri, hiall⟩, hrinear, hrj, hnearall⟩
    have hrc : yoneda.relativelyRepresentable (i ≫ j) :=
      MorphismProperty.comp_mem _ i j hri hrj
    refine ⟨⟨hri, hiall⟩, hrc, fun V q hq => ?_⟩
    obtain ⟨hic, hjc, hnearc⟩ := hnearall V q hq
    obtain ⟨_, hIn⟩ := hiall (hrj.pullback q) (hrj.fst q)
      (presheaf_of_isPullback B S hS (hrj.isPullback q).flip hq)
    obtain ⟨e, heSch⟩ := exists_toSchemeIso_comp B S hS hri hrj hrc q
    have := isLocallyNoetherian_obj_of_etale_chart B S hS hX hnoeth V q hq
    have := hic
    have := hjc
    have hsch :=
      Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegularImmersion_comp_of_nearImage
        ((BigFppfOver.toScheme B S hS).map (hri.snd (hrj.fst q)))
        ((BigFppfOver.toScheme B S hS).map (hrj.snd q)) hIn hnearc
    rw [← heSch]
    exact ⟨inferInstance,
      Stacks.AlgebraicGeometry.isKoszulRegularImmersion_iso_hom_comp e _ hsch⟩
  tfae_have 2 → 3 := by
    rintro ⟨hiK, hijK⟩
    exact ⟨hijK, isSplitExactConormalSequenceOnEtaleCharts_of_isH1RegularImmersion B S hS i j hj
      (isH1RegularImmersion_of_isKoszulRegularImmersion B S hS i hiK)⟩
  tfae_have 3 → 1 := by
    rintro ⟨⟨hrij, hijall⟩, hri, hrj, hseqall⟩
    have core := exists_koszul_and_nearImage_on_chart B S hS hX hnoeth hri hrj hrij
      hseqall hijall
    refine ⟨⟨hri, forall_etale_chart_of_atlas B S hS _
      _root_.AlgebraicGeometry.isLocalAtTarget_koszulRegularImmersion_etale.{u}
      hZ hY hX hri hrj fun W c _ hcEtale => ?_⟩, hri, hrj, fun W c hc => ?_⟩
    · obtain ⟨hic, _, hKi, _⟩ := core W c hcEtale
      exact ⟨hic, hKi⟩
    · obtain ⟨hic, hjc, _, hnear⟩ := core W c hc
      exact ⟨hic, hjc, hnear⟩
  tfae_finish

end AlgebraicGeometry.Space

end
