module

public import StacksFrontier.AlgebraicGeometry.Spaces.ProperGlobalSections.Finiteness
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealPowerModule
public import StacksFrontier.AlgebraicGeometry.Spaces.PullbackIdealChartGeneration
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealSmulAffineObjectwise
public import StacksFrontier.CategoryTheory.Sites.Modules.IdealSubsheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealCartesian
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSectionsKernel
public import StacksFrontier.AlgebraicGeometry.Spaces.CartesianRelations

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

open Stacks.Cohomology.SiteModules

variable (A : Type u) [CommRing A] {B : BigFppfSite.{u}} {hA : B.Contains (Spec (.of A))}
  (X : AlgebraicSpaces B (Spec (.of A)) hA)

/-- The structure ring map `A ⟶ 𝒪_X(U)` of an étale chart, in the spelling of the sections of
sheaves of modules. -/
def chartBaseRingHom (U : SmallEtale B (Spec (.of A)) hA X.1) :
    A →+* chartSectionsRing B (Spec (.of A)) hA X U :=
  (globalSectionEval _ (op U)).comp (baseRingHom A B hA X.1 X.2)

/-- Restriction along a morphism of étale charts commutes with the structure ring maps. -/
theorem chartSectionsRestrict_chartBaseRingHom {U V : SmallEtale B (Spec (.of A)) hA X.1}
    (g : V ⟶ U) (a : A) :
    chartSectionsRestrict B (Spec (.of A)) hA X g (chartBaseRingHom A X U a) =
      chartBaseRingHom A X V a :=
  (baseRingHom A B hA X.1 X.2 a).2 g.op

/-- Restricting `I · 𝒪_X(U)` along `g : V ⟶ U` and extending gives `I · 𝒪_X(V)`. -/
theorem map_chartBaseRingHom {U V : SmallEtale B (Spec (.of A)) hA X.1} (g : V ⟶ U)
    (I : Ideal A) :
    Ideal.map (chartSectionsRestrict B (Spec (.of A)) hA X g)
        (Ideal.map (chartBaseRingHom A X U) I) = Ideal.map (chartBaseRingHom A X V) I := by
  rw [Ideal.map_map]
  exact congrArg (Ideal.map · I)
    (RingHom.ext fun a => chartSectionsRestrict_chartBaseRingHom A X g a)

/-- The objectwise extension `I · 𝒪_X(U)` of an ideal `I` of the base ring. -/
def baseIdealPresheaf (I : Ideal A) :
    (SheafOfModules.unit (smallEtaleRingSheaf B (Spec (.of A)) hA X.1 X.2)).val.Submodule where
  obj U := Ideal.map (chartBaseRingHom A X U.unop) I
  map {U V} f a ha := by
    have h := (map_chartBaseRingHom A X f.unop I).le
    exact h (Ideal.mem_map_of_mem (chartSectionsRestrict B (Spec (.of A)) hA X f.unop) ha)

/-- **The sheaf of ideals `I · 𝒪_X`** generated by an ideal `I` of the base ring: the smallest
sheaf of ideals with local membership containing `I · 𝒪_X(U)` over every étale chart. -/
def baseIdealSheaf (I : Ideal A) : IdealSheaves B (Spec (.of A)) hA X.1 X.2 :=
  Stacks.SheafOfModules.sheafifySubmodule (baseIdealPresheaf A X I)

/-- Over every étale chart `U`, `I · 𝒪_X(U)` is contained in the sections of `I · 𝒪_X`. -/
theorem le_baseIdealSheaf (I : Ideal A) (U : SmallEtale B (Spec (.of A)) hA X.1) :
    Ideal.map (chartBaseRingHom A X U) I ≤ (baseIdealSheaf A X I).obj (op U) :=
  Stacks.SheafOfModules.le_sheafifySubmodule (baseIdealPresheaf A X I) (op U)

/-- The ideal of the sections over a chart `V` which lie in `I · 𝒪_X(W)` after restriction to
every affine chart `W` above `V`. -/
def baseIdealAffineLocalIdeal (I : Ideal A) (V : SmallEtale B (Spec (.of A)) hA X.1) :
    Ideal (chartSectionsRing B (Spec (.of A)) hA X V) :=
  ⨅ (W : SmallEtale B (Spec (.of A)) hA X.1) (g : W ⟶ V)
    (_ : IsAffine ((SmallEtale.toOver B (Spec (.of A)) hA X.1 ⋙
      BigFppfOver.toScheme B (Spec (.of A)) hA).obj W)),
      Ideal.comap (chartSectionsRestrict B (Spec (.of A)) hA X g)
        (Ideal.map (chartBaseRingHom A X W) I)

/-- A section over `V` lies in `baseIdealAffineLocalIdeal A X I V` if and only if its
restriction to every affine chart `W` above `V` lies in `I · 𝒪_X(W)`. -/
theorem mem_baseIdealAffineLocalIdeal_iff (I : Ideal A) {V : SmallEtale B (Spec (.of A)) hA X.1}
    (s : chartSectionsRing B (Spec (.of A)) hA X V) :
    s ∈ baseIdealAffineLocalIdeal A X I V ↔
      ∀ ⦃W : SmallEtale B (Spec (.of A)) hA X.1⦄ (g : W ⟶ V),
        IsAffine ((SmallEtale.toOver B (Spec (.of A)) hA X.1 ⋙
          BigFppfOver.toScheme B (Spec (.of A)) hA).obj W) →
        chartSectionsRestrict B (Spec (.of A)) hA X g s ∈ Ideal.map (chartBaseRingHom A X W) I := by
  simp only [baseIdealAffineLocalIdeal, Submodule.mem_iInf, Ideal.mem_comap]

/-- `baseIdealAffineLocalIdeal` is stable under restriction along morphisms of étale charts. -/
theorem chartSectionsRestrict_mem_baseIdealAffineLocalIdeal (I : Ideal A)
    {V V' : SmallEtale B (Spec (.of A)) hA X.1} (f : V' ⟶ V)
    {s : chartSectionsRing B (Spec (.of A)) hA X V} (hs : s ∈ baseIdealAffineLocalIdeal A X I V) :
    chartSectionsRestrict B (Spec (.of A)) hA X f s ∈ baseIdealAffineLocalIdeal A X I V' := by
  rw [mem_baseIdealAffineLocalIdeal_iff] at hs ⊢
  intro W g hW
  have := hs (g ≫ f) hW
  rwa [chartSectionsRestrict_comp, RingHom.comp_apply] at this

/-- The sections, over every étale chart, which lie in `I · 𝒪_X(W)` after restriction to every
affine chart `W` above it, as a sheaf of ideals. -/
def baseIdealAffineLocal (I : Ideal A) :
    (SheafOfModules.unit (smallEtaleRingSheaf B (Spec (.of A)) hA X.1 X.2)).Submodule where
  obj V := baseIdealAffineLocalIdeal A X I V.unop
  map {V V'} f s hs := chartSectionsRestrict_mem_baseIdealAffineLocalIdeal A X I f.unop hs
  isSheaf V s hs := by
    let s' : chartSectionsRing B (Spec (.of A)) hA X V.unop := s
    change s' ∈ baseIdealAffineLocalIdeal A X I V.unop
    refine (mem_baseIdealAffineLocalIdeal_iff A X I s').2 fun W g hW => ?_
    refine mem_of_forall_restrict_mem_map B (Spec (.of A)) hA X hW
      ((SmallEtale.topology B (Spec (.of A)) hA X.1).pullback_stable g hs) _
      (fun W' h hT hW' => ?_)
    have h1 : chartSectionsRestrict B (Spec (.of A)) hA X (h ≫ g) s ∈
        baseIdealAffineLocalIdeal A X I W' := hT
    have h2 := (mem_baseIdealAffineLocalIdeal_iff A X I _).1 h1 (𝟙 W') hW'
    rw [map_chartBaseRingHom A X h I, ← RingHom.comp_apply, ← chartSectionsRestrict_comp]
    have hid : chartSectionsRestrict B (Spec (.of A)) hA X (𝟙 W') = RingHom.id _ :=
      congrArg RingCat.Hom.hom ((smallEtaleRingSheaf B (Spec (.of A)) hA X.1 X.2).obj.map_id _)
    rwa [hid, RingHom.id_apply] at h2

/-- The presheaf `I · 𝒪_X(U)` is contained in `baseIdealAffineLocal A X I`. -/
theorem baseIdealPresheaf_le_baseIdealAffineLocal (I : Ideal A) :
    baseIdealPresheaf A X I ≤ (baseIdealAffineLocal A X I).toSubmodule := by
  intro V s hs
  let s' : chartSectionsRing B (Spec (.of A)) hA X V.unop := s
  change s' ∈ baseIdealAffineLocalIdeal A X I V.unop
  refine (mem_baseIdealAffineLocalIdeal_iff A X I s').2 fun W g _ => ?_
  rw [← map_chartBaseRingHom A X g I]
  exact Ideal.mem_map_of_mem _ hs

/-- **Over an affine étale chart the sections of `I · 𝒪_X` are `I · 𝒪_X(U)`.** -/
theorem baseIdealSheaf_obj_of_isAffine (I : Ideal A) (U : SmallEtale B (Spec (.of A)) hA X.1)
    (hU : IsAffine ((SmallEtale.toOver B (Spec (.of A)) hA X.1 ⋙
      BigFppfOver.toScheme B (Spec (.of A)) hA).obj U)) :
    (baseIdealSheaf A X I).obj (op U) = Ideal.map (chartBaseRingHom A X U) I := by
  refine le_antisymm (fun s hs => ?_) (le_baseIdealSheaf A X I U)
  have h := Stacks.SheafOfModules.sheafifySubmodule_le
    (baseIdealPresheaf_le_baseIdealAffineLocal A X I) (op U) hs
  let s' : chartSectionsRing B (Spec (.of A)) hA X U := s
  have h' := (mem_baseIdealAffineLocalIdeal_iff A X I s').1 h (𝟙 U) hU
  have hid : chartSectionsRestrict B (Spec (.of A)) hA X (𝟙 U) = RingHom.id _ :=
    congrArg RingCat.Hom.hom ((smallEtaleRingSheaf B (Spec (.of A)) hA X.1 X.2).obj.map_id _)
  rwa [hid, RingHom.id_apply] at h'

/-- **`I · 𝒪_X` is cartesian on affine charts**: over a morphism of affine étale charts its
sections base change. -/
theorem isCartesianOnAffineCharts_baseIdealSheaf (I : Ideal A) :
    IsCartesianOnAffineCharts (baseIdealSheaf A X I).toSheafOfModules := by
  intro U V hU hV f
  let _ := chartAlgebra (hF := X.2) f
  refine ⟨injective_sectionsBaseChange_of_injective_app (baseIdealSheaf A X I).ι f
    (flat_chartRestrict_of_isAffine f hU hV) (fun x y hxy => Subtype.ext hxy)
    (isCartesianOnAffineCharts_unit U V hU hV f), ?_⟩
  rw [chartBaseChange_surjective_iff_span_eq_top]
  have hle := le_baseIdealSheaf A X I V
  have key : ∀ (x : chartSectionsRing B (Spec (.of A)) hA X V)
      (hx : x ∈ Ideal.map (chartBaseRingHom A X V) I),
      (⟨x, hle hx⟩ : (baseIdealSheaf A X I).toSheafOfModules.val.obj (op V)) ∈
        Submodule.span (chartRing B (Spec (.of A)) hA X.1 X.2 V)
          (Set.range fun x => chartRestrictLinear (baseIdealSheaf A X I).toSheafOfModules f x) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      refine Submodule.subset_span ⟨⟨chartBaseRingHom A X U a,
        le_baseIdealSheaf A X I U (Ideal.mem_map_of_mem _ ha)⟩, Subtype.ext ?_⟩
      exact chartSectionsRestrict_chartBaseRingHom A X f a
    | zero => exact Submodule.zero_mem _
    | add x y hx hy ihx ihy => exact Submodule.add_mem _ ihx ihy
    | smul c x hx ih => exact Submodule.smul_mem _ c ih
  refine top_unique fun y _ => ?_
  obtain ⟨y, hy⟩ := y
  have hy' : y ∈ Ideal.map (chartBaseRingHom A X V) I := by
    rw [← baseIdealSheaf_obj_of_isAffine A X I V hV]
    exact hy
  exact key y hy'

/-- **`I · 𝒪_X` is quasi-coherent.** -/
theorem isQuasicoherentOnSite_baseIdealSheaf (I : Ideal A) :
    (baseIdealSheaf A X I).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_baseIdealSheaf A X I)

/-- A scalar of `I` lies, over every chart, in `I · 𝒪_X`. -/
theorem chartBaseRingHom_mem_baseIdealSheaf {I : Ideal A} {a : A} (ha : a ∈ I)
    (U : SmallEtale B (Spec (.of A)) hA X.1) :
    chartBaseRingHom A X U a ∈ (baseIdealSheaf A X I).obj (op U) :=
  le_baseIdealSheaf A X I U (Ideal.mem_map_of_mem _ ha)

end AlgebraicGeometry.Space
