module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartRestrictionFromSite
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartRestrictionReadingsFunctor
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeOnSiteAffineCharts
import StacksFrontier.AlgebraicGeometry.CoherentFinite.Basic

/-!
# Finite type on charts implies finite type on the small étale site

Let `X` be an algebraic space and `M` a quasi-coherent `𝒪_X`-module on the small étale site.
`StacksFrontier.AlgebraicGeometry.Spaces.ChartRestrictionFromSite` shows that if `M` is of finite
type on the site then it is of finite type on charts. This file proves the converse, so that for a
quasi-coherent module the two readings of finite type agree.

## Main results

* `AlgebraicGeometry.Space.isFiniteTypeOnSite_of_isFiniteTypeOnCharts` and
  `AlgebraicGeometry.Space.isFiniteTypeOnSite_iff_isFiniteTypeOnCharts`.

## Implementation notes

The passage runs the three steps of the forward direction backwards: a quasi-coherent module of
finite type on the chart's scheme has finite sections over the affine opens (Stacks 01PB,
`Stacks.AlgebraicGeometry.CoherentFinite.finite_sections`), those are the sections of the module
over the affine étale charts the opens cut out, and a module cartesian on affine charts whose
sections over those charts are finite is generated by finitely many sections on the covering of
each chart by its affine opens, which is
`AlgebraicGeometry.Space.hasFiniteGlobalGenerators_over_of_moduleFinite`.

## References

* [Stacks Project, Tag 01PB](https://stacks.math.columbia.edu/tag/01PB)
* [Stacks Project, Tag 01XZ](https://stacks.math.columbia.edu/tag/01XZ)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (X : AlgebraicSpaces B S hS)

/-- **The sections of a module of finite type on a chart over the étale charts cut out by the
affine opens of that chart are finite.**  If the restriction of a quasi-coherent `𝒪_X`-module `M`
to the scheme of an étale chart `A` is of finite type, then over the étale chart cut out by an
affine open `O` of that scheme the sections of `M` form a finite module over the functions on the
chart: they are the sections of the restriction over `O`, which form a finite module by
Stacks 01PB, the scalars of the two readings differing by `TopologicalSpace.Opens.topIso`. -/
theorem moduleFinite_chartOpens_of_isFiniteType_restrictToChart
    (M : Modules.{u, u} B S hS X.1 X.2) (hqc : M.IsQuasicoherentOnSite) (A : SmallEtale B S hS X.1)
    (hA : (restrictToChart B S hS X.2 M A).IsFiniteType) (O : (chartScheme A).affineOpens) :
    Module.Finite (chartRing B S hS X.1 X.2 ((chartOpens B S hS A).obj O.1))
      (M.val.obj (Opposite.op ((chartOpens B S hS A).obj O.1))) := by
  have := isQuasicoherent_chartRestrictionSheaf B S hS X M hqc A
  have : (chartRestrictionSheaf B S hS X M A).IsFiniteType :=
    Stacks.SheafOfModules.isFiniteType_of_iso (restrictToChartIsoChartRestrictionSheaf B S hS X M A)
  have := Stacks.AlgebraicGeometry.CoherentFinite.finite_sections
    (chartRestrictionSheaf B S hS X M A) O.2
  let : Module (Γ(↑(O.1), ⊤) : Type u)
      (M.val.obj (Opposite.op ((chartOpens B S hS A).obj O.1)) : Type u) :=
    moduleChartSections B S hS X M ((chartOpens B S hS A).obj O.1)
  exact Module.Finite.of_surjective
    (f := ({ toFun := fun m => m.down
             map_add' := fun _ _ => rfl
             map_smul' := fun _ _ => rfl } :
      (Γ(chartRestrictionSheaf B S hS X M A, O.1) : Type u) →ₛₗ[(O.1.topIso.inv).hom]
        (M.val.obj (Opposite.op ((chartOpens B S hS A).obj O.1)) : Type u)))
    (fun y => ⟨ULift.up y, rfl⟩)

/-- **Finite type on charts is finite type on the small étale site**, for a quasi-coherent
module.  Every étale chart is covered by the charts its affine opens cut out; over each of them
the sections of the module form a finite module, by
`AlgebraicGeometry.Space.moduleFinite_chartOpens_of_isFiniteType_restrictToChart`, so the module
is generated there by finitely many sections. -/
theorem isFiniteTypeOnSite_of_isFiniteTypeOnCharts (M : Modules.{u, u} B S hS X.1 X.2)
    (hqc : M.IsQuasicoherentOnSite) (hft : IsFiniteTypeOnCharts B S hS X.2 M) :
    SheafOfModules.IsFiniteTypeOnSite M := by
  refine ⟨fun U => ⟨ULift.{u + 1} ((chartScheme U).affineOpens),
    fun O => openChart B S hS X.1 U O.down.1, fun O => openChartInclusion B S hS X.1 U O.down.1,
    SmallEtale.ofArrows_openChart_affineOpens_mem B S hS X.1 U, fun O => ?_⟩⟩
  have h := moduleFinite_chartOpens_of_isFiniteType_restrictToChart B S hS X M hqc U (hft U)
    O.down
  rw [chartOpens_obj_eq_openChart B S hS U O.down.1] at h
  exact hasFiniteGlobalGenerators_over_of_moduleFinite B S hS X.1 X.2 M
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 M hqc) _
    (isAffine_chartScheme_openChart B S hS X.1 U O.down) h

/-- **For a quasi-coherent module, finite type on the small étale site is finite type on
charts.** -/
theorem isFiniteTypeOnSite_iff_isFiniteTypeOnCharts (M : Modules.{u, u} B S hS X.1 X.2)
    (hqc : M.IsQuasicoherentOnSite) :
    SheafOfModules.IsFiniteTypeOnSite M ↔ IsFiniteTypeOnCharts B S hS X.2 M :=
  ⟨isFiniteTypeOnCharts_of_isFiniteTypeOnSite B S hS X M hqc,
    isFiniteTypeOnSite_of_isFiniteTypeOnCharts B S hS X M hqc⟩

end AlgebraicGeometry.Space

end
