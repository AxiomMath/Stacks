module

public import StacksFrontier.AlgebraicGeometry.Spaces.AffineChartDiagramCover
public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierDivisorSum
public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierEtaleEquiv

/-!
# The principal chart diagrams over a morphism of algebraic spaces are cover-dense

Let `p : Y ⟶ A'` be a morphism of algebraic spaces over a scheme `S` contained in a big fppf
site `B`, and let `E` be a closed subspace of `A'`.  Call an étale scheme chart `W` of `Y`
*principal for `p` and `E`* when its underlying scheme is affine and it fits into a commutative
diagram of étale scheme charts over `p` whose chart `V` of `A'` is affine, maps to the chosen
étale atlas chart of `A'`, and carries the defining ideal of `E` as a principal ideal.

This file proves that the principal charts are **cover-dense in the small étale site of `Y`**:
every sieve of a chart of `Y` which contains all the morphisms out of principal charts is a
covering sieve.  This upgrades a statement proved on principal chart diagrams — where the
closed subspace is cut out by a single equation, so that the affine local theory of effective
Cartier divisors applies — to a local statement on the small étale site of `Y`.

## Main definitions

* `AlgebraicGeometry.Space.HasPrincipalChartDiagram`: the property of an étale scheme chart of
  `Y` of being principal for `p` and `E` in the above sense.

## Main results

* `AlgebraicGeometry.Space.mem_topology_of_hasPrincipalChartDiagram`: a sieve of a chart of `Y`
  containing every morphism out of a principal chart is a covering sieve of the small étale
  site of `Y`, as soon as `E` pulls back to an effective Cartier divisor on every étale scheme
  chart of `A'`.

## Implementation notes

The construction over a point `z` of a chart `U` of `Y` refines the affine chart diagram of
`AlgebraicGeometry.Space.exists_hasAffineChartDiagram` in three further stages, each of which
lifts the point.

1. *Over the atlas.*  The chart `V₀` of `A'` produced by the affine chart diagram is base
   changed along the surjective atlas chart of `A'` using
   `AlgebraicGeometry.Space.exists_chart_over` for the identity of `A'`; the resulting chart
   `V₁` comes with a morphism to the atlas chart.
2. *A principal equation.*  Condition (3) of [Stacks Project, Tag 083C] applied to `V₁` yields
   an affine chart `V₃ ⟶ V₁` on which the defining ideal of `E` is generated by a single
   regular function, still carrying the point.
3. *Back upstairs.*  The chart of `Y` is base changed along `V₃ ⟶ V₀` with
   `AlgebraicGeometry.Space.exists_chart_pullback` and then shrunk to an affine chart with
   `AlgebraicGeometry.Space.exists_affine_chart_at`; the result is principal.

As for the affine chart diagrams, the conclusion is about sieves rather than about
`CategoryTheory.GrothendieckTopology.CoversTop`: being principal is not inherited by a further
étale chart, so the principal charts do not form a sieve.

## References

* [Stacks Project, Tag 083C](https://stacks.math.columbia.edu/tag/083C)
* [Stacks Project, Tag 03G3](https://stacks.math.columbia.edu/tag/03G3)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {Y A' : AlgebraicSpaces B S hS}

/-- **An étale chart of `Y` carrying a principal chart diagram over `p` for `E`.**  An étale
scheme chart `W` of `Y` has this property when its underlying scheme is affine and there is an
étale scheme chart `V` of `A'` together with a morphism `q : W ⟶ V` of the big fppf site over
`S` making the square with `p` and the two structure morphisms commute, such that `V` has
affine underlying scheme, admits a morphism to the chosen étale atlas chart of `A'`, and the
defining ideal of the closed subspace `E` on `V` is generated by a single global regular
function.

Such a `W` is the chart of `Y` of an affine chart diagram over `p`
(`AlgebraicGeometry.Space.HasAffineChartDiagram`) whose chart of `A'` is moreover placed over
the atlas and carries a principal defining equation for `E`. -/
def HasPrincipalChartDiagram (p : Y ⟶ A') (E : ClosedSubspaces B S hS A'.1)
    (W : SmallEtale B S hS Y.1) : Prop :=
  IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) ∧
    ∃ (V : SmallEtale B S hS A'.1) (q : W.1.left ⟶ V.1.left),
      yoneda.map q ≫ V.1.hom = W.1.hom ≫ p.hom ∧
      IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) ∧
      Nonempty (V ⟶ (⟨CostructuredArrow.mk (atlasHom B S hS A'),
        atlasHom_etale B S hS A'⟩ : SmallEtale B S hS A'.1)) ∧
      ∃ a : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤),
        definingIdealAt B S hS A' E (op V) = Ideal.span {a}

/-- **The charts of `Y` carrying a principal chart diagram over `p` for `E` are cover-dense.**
Assume the closed subspace `E` of `A'` pulls back to an effective Cartier divisor on every
étale scheme chart of `A'`.  Then a sieve of an étale scheme chart `U` of `Y` which contains
every morphism to `U` whose source carries a principal chart diagram over `p` for `E` is a
covering sieve of the small étale site of `Y`.

A covering sieve of the small étale site is one whose arrows are jointly surjective on the
scheme points of the chart (`AlgebraicGeometry.Space.smallEtale_sieve_of_pointwise_covering`),
and the three stages described in the implementation notes of this file supply, above each
point, an arrow of the sieve. -/
theorem mem_topology_of_hasPrincipalChartDiagram (p : Y ⟶ A')
    (E : ClosedSubspaces B S hS A'.1)
    (hE : HasEffectiveCartierEtalePullbacks B S hS A' E)
    (U : SmallEtale B S hS Y.1) (R : Sieve U)
    (hR : ∀ ⦃W : SmallEtale B S hS Y.1⦄ (α : W ⟶ U),
      HasPrincipalChartDiagram B S hS p E W → R α) :
    R ∈ SmallEtale.topology B S hS Y.1 U := by
  refine smallEtale_sieve_of_pointwise_covering B S hS Y.1 U R fun z => ?_
  obtain ⟨W₀, a₀, ⟨-, V₀, q₀, hq₀, -⟩, z₀, hz₀⟩ := exists_hasAffineChartDiagram B S hS p U z
  obtain ⟨V₁, πV, qa, hqa, y₁, hy₁⟩ :=
    exists_chart_over B S hS (𝟙 A') V₀
      (⟨CostructuredArrow.mk (atlasHom B S hS A'), atlasHom_etale B S hS A'⟩ :
        SmallEtale B S hS A'.1)
      (atlasHom_surjective B S hS A') ((BigFppfOver.toScheme B S hS).map q₀ z₀)
  have hatlas : yoneda.map qa ≫ (⟨CostructuredArrow.mk (atlasHom B S hS A'),
      atlasHom_etale B S hS A'⟩ : SmallEtale B S hS A'.1).1.hom = V₁.1.hom := by
    rw [hqa]; simp
  obtain ⟨V₃, mV, a, hV₃aff, -, hspan, y₃, hy₃⟩ :=
    exists_openChart_isRegular_span_definingIdealAt_of_etalePullbacks B S hS A' E hE V₁ y₁
  have hwy : ((BigFppfOver.toScheme B S hS).map q₀) z₀ =
      ((BigFppfOver.toScheme B S hS).map
        ((SmallEtale.toOver B S hS A'.1).map (mV ≫ πV))) y₃ := by
    simp only [Functor.map_comp, Scheme.Hom.comp_apply]
    rw [hy₃, hy₁]
  obtain ⟨W₁, πW, q₁, hq₁, -, w₁, hw₁, -⟩ :=
    exists_chart_pullback B S hS p W₀ q₀ hq₀ (mV ≫ πV) z₀ y₃ hwy
  obtain ⟨W₂, πW₂, hW₂aff, w₂, hw₂⟩ := exists_affine_chart_at B S hS Y.1 W₁ w₁
  have hprin : HasPrincipalChartDiagram B S hS p E W₂ :=
    ⟨hW₂aff, V₃, (SmallEtale.toOver B S hS Y.1).map πW₂ ≫ q₁, by
      rw [Functor.map_comp, Category.assoc, hq₁, ← Category.assoc]
      exact congrArg (fun φ => φ ≫ p.hom) (CostructuredArrow.w (πW₂.hom)),
      hV₃aff, ⟨mV ≫ ObjectProperty.homMk (CostructuredArrow.homMk qa hatlas)⟩, a, hspan⟩
  refine ⟨W₂, πW₂ ≫ πW ≫ a₀, hR _ hprin, w₂, ?_⟩
  rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply,
    Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hw₂, hw₁, hz₀]

end AlgebraicGeometry.Space

end
