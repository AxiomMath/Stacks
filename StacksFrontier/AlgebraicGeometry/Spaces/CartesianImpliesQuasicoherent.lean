open CategoryTheory CategoryTheory.Limits Opposite SheafOfModules

namespace Stacks.PresheafOfModules

/-- **A morphism of presheaves of modules which is surjective on the sections over the objects
in the image of a cover-dense functor is locally surjective.**

Being cover-dense means that for every object `Z` of the target site the arrows that factor
through an object of the image generate a covering sieve; over each such arrow the section is in
the image by hypothesis, and `CategoryTheory.Presheaf.imageSieve` is downward closed, so the
whole covering sieve lies in the image sieve.  No sheaf condition and no concrete structure on
the coefficients is used. -/
theorem isLocallySurjective_of_surjective_of_isCoverDense.{m, r, v₁, u₁, v₂, u₂}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (K : GrothendieckTopology D) (Φ : C ⥤ D) (hΦ : Φ.IsCoverDense K)
    {O : Dᵒᵖ ⥤ RingCat.{r}} {M N : _root_.PresheafOfModules.{m} O} (f : M ⟶ N)
    (h : ∀ X : C, Function.Surjective (f.app (op (Φ.obj X)))) :
    Presheaf.IsLocallySurjective K ((_root_.PresheafOfModules.toPresheaf O).map f) := by
  refine ⟨fun {Z} y => K.superset_covering ?_ (hΦ.is_cover Z)⟩
  rintro T _ ⟨⟨A, lift, map, rfl⟩⟩
  exact (Presheaf.imageSieve ((_root_.PresheafOfModules.toPresheaf O).map f) y).downward_closed
    (h A (N.map map.op y)) lift

end Stacks.PresheafOfModules

namespace SheafOfModules

universe u v r m

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{r}}

/-- **The assembly lemma for a global presentation.**  Let `b` be an epimorphism onto the
universe lift of a module `M`, out of a coproduct `P` of copies of the structure sheaf, and let
`a : Q ⟶ P` with `a ≫ b = 0` be such that the induced morphism to the kernel of `b` is an
epimorphism, with `Q` again a coproduct of copies of the structure sheaf.  Then `M` has a global
presentation.

Given that `b` is an epimorphism, the hypothesis on `a` says exactly that the two-term complex
`Q ⟶ P ⟶ M` is exact at `P` (`CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift`), and an
exact complex with epimorphic second map exhibits that map as a cokernel of the first
(`CategoryTheory.ShortComplex.Exact.gIsCokernel`).  The two sheafification hypotheses are the
ones under which Mathlib's category of sheaves of modules is abelian; they are stated at the
universe `max u v r m` in which the presentation lives. -/
theorem hasGlobalPresentation_of_epi_kernelLift
    [HasSheafify J AddCommGrpCat.{max u v r m}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{max u v r m}] {M : SheafOfModules.{m} R}
    {I K : Type (max u v r m)} {P Q : SheafOfModules.{max u v r m} R}
    {ι : ∀ _ : I, uliftForPresentation.{u, v, r, r, max u v m} (unit R) ⟶ P}
    {κ : ∀ _ : K, uliftForPresentation.{u, v, r, r, max u v m} (unit R) ⟶ Q}
    (hP : IsColimit (Cofan.mk P ι)) (hQ : IsColimit (Cofan.mk Q κ))
    (a : Q ⟶ P) (b : P ⟶ uliftForPresentation.{u, v, r, m, max u v r} M)
    (hab : a ≫ b = 0) [Epi b] (hq : Epi (kernel.lift b a hab)) :
    HasGlobalPresentation M := by
  refine ⟨I, K, P, Q, ι, κ, ⟨hP⟩, ⟨hQ⟩, a, b, hab, ⟨?_⟩⟩
  exact ((ShortComplex.exact_iff_epi_kernel_lift (ShortComplex.mk a b hab)).2 hq).gIsCokernel

/-- The structure sheaf with its sections raised to the universe `max u v r m` in which a global
presentation of a sheaf of modules with sections in `m` takes its coproducts: the free module of
rank one whose copies `SheafOfModules.HasGlobalPresentation` takes the coproducts of.  For
`m = r` it is `SheafOfModules.liftUnit`. -/
noncomputable abbrev liftUnitPresentation (R : Sheaf J RingCat.{r}) :
    SheafOfModules.{max u v r m} R :=
  uliftForPresentation.{u, v, r, r, max u v m} (unit R)

/-- **The morphism out of the lifted structure sheaf determined by a global section.**  For a
sheaf of modules `N` with sections in an arbitrary universe `m` and a global section `σ` of `N`,
the morphism from the structure sheaf raised to the universe of a global presentation of `N`
(further raised by `t`) to the universe lift of `N` sending a section `a` of the structure sheaf
to `a` acting on `σ`.  For `m = r` and `t = r` it is `SheafOfModules.liftSectionHom`; for `N`
the structure sheaf itself it is multiplication by a global function on the lifted structure
sheaf `SheafOfModules.liftUnitPresentation`. -/
noncomputable def liftSectionHomPresentation.{t} {N : SheafOfModules.{m} R} (σ : N.sections) :
    uliftForPresentation.{u, v, r, r, max u v m t} (unit R) ⟶
      uliftForPresentation.{u, v, r, m, max u v r t} N where
  val := (Stacks.SheafOfModules.uliftUnitHomEquiv.{u, v, r, max u v m t}
    (uliftForPresentation.{u, v, r, m, max u v r t} N)).symm
      (PresheafOfModules.sectionsMk (fun X => ULift.up (σ.eval X))
        (fun _ _ f => congrArg ULift.up (σ.property f)))

/-- `SheafOfModules.liftSectionHomPresentation` sends a lifted section `a` of the structure sheaf
to the lift of `a` acting on the global section. -/
theorem liftSectionHomPresentation_val_app_apply.{t} {N : SheafOfModules.{m} R}
    (σ : N.sections) (X : Cᵒᵖ)
    (a : (uliftForPresentation.{u, v, r, r, max u v m t} (unit R)).val.obj X) :
    (liftSectionHomPresentation.{u, v, r, m, t} σ).val.app X a =
      (ULift.up ((ULift.down a : R.obj.obj X) • σ.eval X) :
        (uliftForPresentation.{u, v, r, m, max u v r t} N).val.obj X) := rfl

/-- Raising the universe of the sections of a sheaf of modules is additive.  For the universe of
a global presentation and `m = r` this is `SheafOfModules.liftMod_up_sum`. -/
theorem uliftForPresentation_up_sum.{t} (N : SheafOfModules.{m} R) (X : Cᵒᵖ) {ι : Type*}
    (s : Finset ι) (y : ι → N.val.obj X) :
    (ULift.up (∑ i ∈ s, y i) : (uliftForPresentation.{u, v, r, m, t} N).val.obj X) =
      ∑ i ∈ s, (ULift.up (y i) : (uliftForPresentation.{u, v, r, m, t} N).val.obj X) := by
  classical
  induction s using Finset.induction with
  | empty => rfl
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi, ← ih]
    rfl

end SheafOfModules

namespace AlgebraicGeometry.Space

