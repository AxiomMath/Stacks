/-! ### Sheafification on a slice at the presentation universe -/

/-- Presheaves of abelian groups with sections in the universe `max (u + 1) m` in which a global
presentation of a module with sections in `m` lives have sheafifications on every slice of the
small étale ringed site: the slice has its objects in `Type (u + 1)` and its morphisms in
`Type u`.

This is not declared as an instance; see the implementation notes. -/
theorem hasSheafify_over_presentationUniverse (V : (smallEtaleRingedSite B S hS F hF).C) :
    HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m} :=
  GrothendieckTopology.hasSheafify_addCommGrpCat.{max (u + 1) m}
    ((smallEtaleRingedSite B S hS F hF).J.over V)

/-- On every slice of the small étale ringed site, the local equivalences of presheaves of
abelian groups with sections in the universe `max (u + 1) m` are exactly the locally bijective
morphisms.

This is not declared as an instance; see the implementation notes. -/
theorem wEqualsLocallyBijective_over_presentationUniverse
    (V : (smallEtaleRingedSite B S hS F hF).C) :
    ((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
      AddCommGrpCat.{max (u + 1) m} :=
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijective_addCommGrpCat.{max (u + 1) m, u + 1, u}
    ((smallEtaleRingedSite B S hS F hF).J.over V)

/-! ### Cover density of the affine charts in a slice -/

/-- **The affine étale charts over a chart `V` are cover-dense in the slice of the small étale
site of `F` at `V`.**

This is the slice form of the dense-subsite statement
`AlgebraicGeometry.Space.AffineEtale.inclusion_isSpecialCocontinuous` (Stacks 03CG): a covering
of the underlying chart of an object `Z` of the slice by affine charts is pulled back to a
covering of `Z` in the slice, each member being an affine chart equipped with its composite
morphism to `V`. -/
theorem isCoverDense_affineChartsOver (hF' : IsAlgebraicSpace B S hS F)
    (V : (smallEtaleRingedSite B S hS F hF).C) :
    (ObjectProperty.ι (fun Z : Over V => IsAffineChart B S hS F Z.left)).IsCoverDense
      ((smallEtaleRingedSite B S hS F hF).J.over V) := by
  refine ⟨fun Z => ?_⟩
  rw [GrothendieckTopology.mem_over_iff]
  refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_
    ((AffineEtale.inclusion_isSpecialCocontinuous B S hS F hF').2.isCoverDense'.is_cover Z.left)
  rintro T g ⟨⟨A, lift, map, fac⟩⟩
  rw [Sieve.overEquiv_iff]
  exact ⟨⟨⟨Over.mk (map ≫ Z.hom), A.property⟩,
    Over.homMk lift ((Category.assoc lift map Z.hom).symm.trans
      (congrArg (fun k => k ≫ Z.hom) fac)),
    Over.homMk map rfl, Over.OverMorphism.ext fac⟩⟩

/-! ### Quasi-compactness of the affine objects of a slice -/

/-- **An object of a slice of the small étale site whose underlying chart is affine is a
quasi-compact object of that slice.**

The covering sieves of an object `Z` of the slice at `V` are, by
`CategoryTheory.GrothendieckTopology.mem_over_iff`, exactly the ones whose image under
`CategoryTheory.Sieve.overEquiv` covers the underlying chart `Z.left`, and a family of arrows to
`Z` in the slice has the family of their left components as that image
(`CategoryTheory.Sieve.overEquiv_ofArrows`).  So a covering of `Z` in the slice is refined
through finitely many of its members as soon as the corresponding covering of `Z.left` is, which
is `AlgebraicGeometry.Space.isQuasiCompactObject_of_isAffine`; the refinement is carried back to
the slice by composing each of its members with the structure morphism of `Z`.

Nothing in the tree transfers quasi-compactness of an object along
`CategoryTheory.GrothendieckTopology.over`, and this is the input the sections of a coproduct
over an affine object of a slice need: `Stacks.Sites.sheafOfModules_sections_preserves_coproducts`
(Stacks 0935) is stated at a quasi-compact object of whatever site it is applied to. -/
theorem isQuasiCompactObject_over_of_isAffine
    (V : (smallEtaleRingedSite B S hS F hF).C) (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left)) :
    ((smallEtaleRingedSite B S hS F hF).J.over V).IsQuasiCompactObject Z := by
  intro 𝒰 h𝒰
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows] at h𝒰
  obtain ⟨𝒱, φ, h𝒱, hfin⟩ := isQuasiCompactObject_of_isAffine B S hS F Z.left hZ
    ⟨𝒰.I₀, fun i => (𝒰.X i).left, fun i => (𝒰.f i).left⟩ h𝒰
  refine ⟨⟨𝒱.I₀, fun j => Over.mk (𝒱.f j ≫ Z.hom), fun j => Over.homMk (𝒱.f j) rfl⟩,
    ⟨φ.s₀, fun j => Over.homMk (φ.h₀ j) ?_, fun j => ?_⟩, ?_, hfin⟩
  · refine (congrArg (fun k => φ.h₀ j ≫ k) (Over.w (𝒰.f (φ.s₀ j))).symm).trans ?_
    exact (Category.assoc (φ.h₀ j) (𝒰.f (φ.s₀ j)).left Z.hom).symm.trans
      (congrArg (fun k => k ≫ Z.hom) (φ.w₀ j))
  · exact Over.OverMorphism.ext (φ.w₀ j)
  · rwa [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]

/-- A morphism of sheaves of modules on a slice at `V` which is surjective on the sections over
every affine chart of the slice is an epimorphism. -/
private theorem epi_of_surjective_app_affineChartsOver.{w} (hF' : IsAlgebraicSpace B S hS F)
    (V : (smallEtaleRingedSite B S hS F hF).C)
    {M N : SheafOfModules.{w}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O).over V)}
    (f : M ⟶ N)
    (h : ∀ Z : Over V, IsAffineChart B S hS F Z.left → Function.Surjective (f.val.app (op Z))) :
    Epi f := by
  have hls := Stacks.PresheafOfModules.isLocallySurjective_of_surjective_of_isCoverDense
    ((smallEtaleRingedSite B S hS F hF).J.over V)
    (ObjectProperty.ι (fun Z : Over V => IsAffineChart B S hS F Z.left))
    (isCoverDense_affineChartsOver hF' V) f.val fun A => h A.obj A.property
  have hsls : Sheaf.IsLocallySurjective
      ((_root_.SheafOfModules.toSheaf.{w}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V)).map f) := hls
  exact (_root_.SheafOfModules.toSheaf.{w}
    (((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)).over V)).epi_of_epi_map inferInstance

/-! ### The canonical presentation at the presentation universe -/

section Presentation

variable (V : (smallEtaleRingedSite B S hS F hF).C)

variable
  [HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over V) AddCommGrpCat.{max (u + 1) m}]
  [((smallEtaleRingedSite B S hS F hF).J.over V).WEqualsLocallyBijective
    AddCommGrpCat.{max (u + 1) m}]

/-- The index type of the canonical generating family of `G` over the chart `V`: the sections of
`G` over `V`, raised to the universe in which a global presentation indexes its coproducts. -/
abbrev chartGeneratorsIndex (G : Modules.{u, m} B S hS F hF) : Type (max (u + 1) m) :=
  ULift.{u + 1} (G.val.obj (op V))

/-- The source of the canonical generating family of `G` over the chart `V`: the coproduct,
indexed by the sections of `G` over `V`, of copies of the universe-lifted structure sheaf
`SheafOfModules.liftUnitPresentation` of the slice at `V`. -/
noncomputable abbrev chartGeneratorsSource (G : Modules.{u, m} B S hS F hF) :
    SheafOfModules.{max (u + 1) m}
      (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V) :=
  ∐ (fun _ : chartGeneratorsIndex V G => _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
    (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))

/-- **The canonical generating family of `G` over the chart `V`**: the morphism out of the
coproduct of copies of the structure sheaf indexed by the sections of `G` over `V` whose leg at a
section is `SheafOfModules.liftSectionHomPresentation` of the corresponding global section
`Stacks.SheafOfModules.sectionsOverEquivFreeUniverse` of the restriction of `G` to the slice.

It is called a generating family and not a presentation on purpose: it is the *generators* half
of a global presentation, and its being a cokernel of anything is not proved here. -/
noncomputable def chartGenerators (G : Modules.{u, m} B S hS F hF) :
    chartGeneratorsSource V G ⟶
      _root_.SheafOfModules.uliftForPresentation.{u + 1, u, u, m, u + 1} (G.over V) :=
  Cofan.IsColimit.desc
    (coproductIsCoproduct (fun _ : chartGeneratorsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V)))
    (fun i => _root_.SheafOfModules.liftSectionHomPresentation.{u + 1, u, u, m, u}
      ((Stacks.SheafOfModules.sectionsOverEquivFreeUniverse G V).symm i.down))

/-- The leg of `AlgebraicGeometry.Space.chartGenerators` at a section of `G` over `V` is the
morphism of that section. -/
theorem iota_comp_chartGenerators (G : Modules.{u, m} B S hS F hF)
    (x : G.val.obj (op V)) :
    Sigma.ι (fun _ : chartGeneratorsIndex V G =>
        _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V)) (ULift.up x) ≫
        chartGenerators V G =
      _root_.SheafOfModules.liftSectionHomPresentation.{u + 1, u, u, m, u}
        ((Stacks.SheafOfModules.sectionsOverEquivFreeUniverse G V).symm x) :=
  Cofan.IsColimit.fac
    (coproductIsCoproduct (fun _ : chartGeneratorsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V))) _ (ULift.up x)

/-- The restriction to an object `Z` of the slice of a section of `G` over `V` is in the image
of `AlgebraicGeometry.Space.chartGenerators` on the sections over `Z`: it is the image of the
lift of `1` under the corresponding coproduct injection. -/
theorem mem_range_chartGenerators_app (G : Modules.{u, m} B S hS F hF) (Z : Over V)
    (x : G.val.obj (op V)) :
    ULift.up (G.val.map (Z.hom.op) x) ∈
      LinearMap.range ((chartGenerators V G).val.app (op Z)).hom := by
  have h : (Sigma.ι (fun _ : chartGeneratorsIndex V G =>
        _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))
        (ULift.up x)).val.app (op Z) ≫ (chartGenerators V G).val.app (op Z) =
      (_root_.SheafOfModules.liftSectionHomPresentation.{u + 1, u, u, m, u}
        ((Stacks.SheafOfModules.sectionsOverEquivFreeUniverse G V).symm x)).val.app (op Z) := by
    rw [← _root_.PresheafOfModules.comp_app, ← _root_.SheafOfModules.comp_val,
      iota_comp_chartGenerators]
  refine ⟨(Sigma.ι (fun _ : chartGeneratorsIndex V G =>
      _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over V))
    (ULift.up x)).val.app (op Z)
    (ULift.up (1 : chartRing B S hS F hF Z.left) :
      (_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
        (((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z)), ?_⟩
  refine (congrArg (fun k : _ ⟶ (_root_.SheafOfModules.uliftForPresentation.{u + 1, u, u, m, u + 1}
      (G.over V)).val.obj (op Z) =>
    ConcreteCategory.hom k
      (ULift.up (1 : chartRing B S hS F hF Z.left) :
        (_root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over V)).val.obj (op Z)))
    h).trans ?_
  exact ULift.ext _ _ (one_smul (chartRing B S hS F hF Z.left)
    (G.val.map (Z.hom.op) x))

/-- **A module cartesian on affine charts is generated by its sections over an affine chart, on
the sections over every affine object of the slice.**

Over a morphism `Z ⟶ V` of affine étale charts the base change comparison of `G` is bijective,
so the restrictions of the sections over `V` span the sections over `Z`
(`AlgebraicGeometry.Space.chartBaseChange_surjective_iff_span_eq_top`); each of those
restrictions is in the image of `AlgebraicGeometry.Space.chartGenerators` by
`AlgebraicGeometry.Space.mem_range_chartGenerators_app`, and an image is a submodule. -/
theorem surjective_chartGenerators_app (G : Modules.{u, m} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left)) :
    Function.Surjective ((chartGenerators V G).val.app (op Z)) := by
  have hspan := (chartBaseChange_surjective_iff_span_eq_top G Z.hom).1
    (hG V Z.left hV hZ Z.hom).2
  set rg := LinearMap.range ((chartGenerators V G).val.app (op Z)).hom
  set T : Submodule (chartRing B S hS F hF Z.left) (G.val.obj (op Z.left)) :=
    { carrier := {w : (G.val.obj (op Z.left) : Type m) |
        (ULift.up w : (_root_.SheafOfModules.uliftForPresentation.{u + 1, u, u, m, u + 1}
          (G.over V)).val.obj (op Z)) ∈ rg}
      zero_mem' := Submodule.zero_mem rg
      add_mem' := fun ha hb => Submodule.add_mem rg ha hb
      smul_mem' := fun c _ hw => Submodule.smul_mem rg c hw }
  have htop : T = ⊤ := by
    refine eq_top_iff.2 (le_trans hspan.ge (Submodule.span_le.2 ?_))
    rintro w ⟨x, rfl⟩
    exact mem_range_chartGenerators_app V G Z x
  intro y
  have hy : (ULift.down y : (G.val.obj (op Z.left) : Type m)) ∈ T :=
    htop ▸ Submodule.mem_top
  exact ⟨_, hy.choose_spec⟩

/-- **A module cartesian on affine charts is generated by its sections over an affine chart.**
The canonical morphism `AlgebraicGeometry.Space.chartGenerators` from the coproduct of copies
of the structure sheaf indexed by the sections of `G` over an affine chart `V` to the lifted
restriction of `G` to the slice at `V` is an epimorphism.

It is surjective on the sections over every affine object of the slice by
`AlgebraicGeometry.Space.surjective_chartGenerators_app`, those objects are cover-dense by
`AlgebraicGeometry.Space.isCoverDense_affineChartsOver`, hence it is locally surjective by
`Stacks.PresheafOfModules.isLocallySurjective_of_surjective_of_isCoverDense`, and a locally
surjective morphism of sheaves is an epimorphism. -/
theorem epi_chartGenerators (G : Modules.{u, m} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    Epi (chartGenerators V G) := by
  exact epi_of_surjective_app_affineChartsOver.{u, max (u + 1) m} hF V _ fun A hA =>
    surjective_chartGenerators_app V G hG hV A hA

/-- **The cartesian-implies-quasi-coherent direction of Descent, Proposition 03DX(2), reduced to
the relations half.**

An `𝒪_F`-module cartesian on affine charts is quasi-coherent on the small étale site of `F` as
soon as, over every affine étale chart, the relations among its sections over that chart are
generated by a family of global relations — precisely: as soon as the kernel of the canonical
generating family `AlgebraicGeometry.Space.chartGenerators` receives an epimorphism from a
coproduct of copies of the structure sheaf.

The generators half is not a hypothesis: it is
`AlgebraicGeometry.Space.epi_chartGenerators`, proved from
`AlgebraicGeometry.Space.IsCartesianOnAffineCharts` alone.  The covering reducing
quasi-coherence to the affine charts is
`AlgebraicGeometry.Space.SmallEtale.coversTop_affineCharts` together with Stacks 03DN in the
form `Stacks.SheafOfModules.isQuasicoherentOnSite_iff_exists_cover_hasGlobalPresentation`, and
the passage from the two coproducts to a presentation is
`SheafOfModules.hasGlobalPresentation_of_epi_kernelLift`.

No `@[stacks]` attribute is claimed: this is one direction of a result of Descent, Chapter 35,
and it is conditional.  See the implementation notes for what discharging `hrel` needs. -/
theorem isQuasicoherentOnSite_of_isCartesianOnAffineCharts_of_rel
    (G : Modules.{u, m} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (hsh : ∀ W : (smallEtaleRingedSite B S hS F hF).C,
      HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over W) AddCommGrpCat.{max (u + 1) m})
    (hwe : ∀ W : (smallEtaleRingedSite B S hS F hF).C,
      ((smallEtaleRingedSite B S hS F hF).J.over W).WEqualsLocallyBijective
        AddCommGrpCat.{max (u + 1) m})
    (hrel : ∀ W : (smallEtaleRingedSite B S hS F hF).C,
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
      letI := hsh W
      letI := hwe W
      ∃ (K : Type (max (u + 1) m))
        (Q : SheafOfModules.{max (u + 1) m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over W))
        (κ : ∀ _ : K, _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over W) ⟶ Q)
        (_ : IsColimit (Cofan.mk Q κ))
        (a : Q ⟶ chartGeneratorsSource W G) (hab : a ≫ chartGenerators W G = 0),
        Epi (kernel.lift (chartGenerators W G) a hab)) :
    G.IsQuasicoherentOnSite := by
  have hpres : ∀ W : (smallEtaleRingedSite B S hS F hF).C,
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
      (G.over W).HasGlobalPresentation := by
    intro W hW
    have := hsh W
    have := hwe W
    obtain ⟨K, Q, κ, hQ, a, hab, hq⟩ := hrel W hW
    have := epi_chartGenerators W G hG hW
    exact _root_.SheafOfModules.hasGlobalPresentation_of_epi_kernelLift
      (coproductIsCoproduct (fun _ : chartGeneratorsIndex W G =>
        _root_.SheafOfModules.liftUnitPresentation.{u + 1, u, u, m}
          (((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).over W)))
      hQ a (chartGenerators W G) hab hq
  exact Stacks.SheafOfModules.isQuasicoherentOnSite_of_coversTop_hasGlobalPresentation G
    (W := fun W : {W : SmallEtale B S hS F //
        IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj W))} => W.1)
    (SmallEtale.coversTop_affineCharts B S hS F) fun W => hpres W.1 W.2

end Presentation

/-! ### The same generation statement in Mathlib's free-module vocabulary -/

/-- The canonical morphism from the free module on the sections of `G` over a chart `V` to the
restriction of `G` to the slice at `V`, at the module universe of the schemes.  Its family of
sections is `Stacks.SheafOfModules.mkOver`, and it is Mathlib's `SheafOfModules.free` form of
`AlgebraicGeometry.Space.chartGenerators`. -/
noncomputable def freeChartCover (G : Modules.{u, u} B S hS F hF)
    (V : (smallEtaleRingedSite B S hS F hF).C) :
    free (R := ((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)).over V)
      (G.val.obj (op V)) ⟶ G.over V :=
  (G.over V).freeHomEquiv.symm (fun x => Stacks.SheafOfModules.mkOver x)

/-- The restriction to an object `Z` of the slice of a section of `G` over `V` is in the image
of `AlgebraicGeometry.Space.freeChartCover` on the sections over `Z`. -/
theorem mem_range_freeChartCover_app (G : Modules.{u, u} B S hS F hF)
    (V : (smallEtaleRingedSite B S hS F hF).C) (Z : Over V) (x : G.val.obj (op V)) :
    (Stacks.SheafOfModules.mkOver (M := G) (V := V) x).val (op Z) ∈
      Set.range ((freeChartCover G V).val.app (op Z)) := by
  set R' := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O).over V
  set e : (unit R').val.obj (op Z) := ((1 : R'.obj.obj (op Z)) : (unit R').val.obj (op Z))
  refine ⟨(ιFree (R := R') x).val.app (op Z) e, ?_⟩
  have h := _root_.SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply
    (M := G.over V) (I := G.val.obj (op V))
    ((G.over V).freeHomEquiv.symm (fun y => Stacks.SheafOfModules.mkOver y)) x
  rw [Equiv.apply_symm_apply] at h
  have h2 : ((G.over V).unitHomEquiv ((G.over V).unitHomEquiv.symm
      (Stacks.SheafOfModules.mkOver (M := G) (V := V) x))).val (op Z) =
      (((G.over V).unitHomEquiv.symm
        (Stacks.SheafOfModules.mkOver (M := G) (V := V) x)).val.app (op Z)) e :=
    _root_.SheafOfModules.unitHomEquiv_apply_coe _ _ _
  rw [Equiv.apply_symm_apply] at h2
  rw [h2, h]
  rfl

/-- **A module cartesian on affine charts is generated by its sections over an affine chart,
in the free-module vocabulary**, on the sections over every affine object of the slice. -/
theorem surjective_freeChartCover_app (G : Modules.{u, u} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G) (V : (smallEtaleRingedSite B S hS F hF).C)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (Z : Over V)
    (hZ : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj Z.left)) :
    Function.Surjective ((freeChartCover G V).val.app (op Z)) := by
  have hspan := (chartBaseChange_surjective_iff_span_eq_top G Z.hom).1
    (hG V Z.left hV hZ Z.hom).2
  rw [← LinearMap.range_eq_top]
  refine top_le_iff.1 (hspan.ge.trans (Submodule.span_le.2 ?_))
  rintro y ⟨x, rfl⟩
  exact mem_range_freeChartCover_app G V Z x

/-- **A module cartesian on affine charts is generated by its sections over an affine chart, in
the free-module vocabulary**: the canonical morphism from
`SheafOfModules.free (G(V))` to the restriction of `G` to the slice at an affine chart `V` is an
epimorphism.

This is `AlgebraicGeometry.Space.epi_chartGenerators` at the module universe of the schemes,
where Mathlib's `SheafOfModules.free` is available.  It is *not* in the universe in which a
global presentation lives; see the implementation notes. -/
theorem epi_freeChartCover (G : Modules.{u, u} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G) (V : (smallEtaleRingedSite B S hS F hF).C)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    Epi (freeChartCover G V) := by
  exact epi_of_surjective_app_affineChartsOver.{u, u} hF V _ fun A hA =>
    surjective_freeChartCover_app G hG V hV A hA

/-- **A module cartesian on affine charts is generated by its sections over an affine chart**, in
the shape of Mathlib's `SheafOfModules.GeneratingSections`: the index type is the module of
sections over the chart, the family is `Stacks.SheafOfModules.mkOver`, and the epimorphism is
`AlgebraicGeometry.Space.epi_freeChartCover`.

This is the form the finite-type and local-generation machinery of this tree consumes. -/
noncomputable def chartGeneratingSections (G : Modules.{u, u} B S hS F hF)
    (hG : IsCartesianOnAffineCharts G) (V : (smallEtaleRingedSite B S hS F hF).C)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    (G.over V).GeneratingSections where
  I := G.val.obj (op V)
  s x := Stacks.SheafOfModules.mkOver x
  epi := epi_freeChartCover G hG V hV

end AlgebraicGeometry.Space

end
