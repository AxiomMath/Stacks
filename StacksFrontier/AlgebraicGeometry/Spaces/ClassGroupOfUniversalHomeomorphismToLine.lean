/-!
# The class group of a space over the affine line which is the line away from the origin

Let `k` be a field and let `X` be a locally Noetherian integral algebraic space over `k` together
with a universal homeomorphism `π : X → 𝔸¹_k = Spec k[t]` which is an isomorphism over the
punctured line `𝔸¹_k ∖ {0}`. Then `|X|` is homeomorphic to the affine line, its prime divisors
are its closed points, and, if the pullback `π^* t` of the coordinate vanishes to order two along
some prime divisor `x`, then `x` lies over the origin, `div(π^* t) = 2 [x]`, the classes of all
other prime divisors vanish, and the Weil divisor class group of `X` is `ℤ/2ℤ`, generated by the
class of `x`.

This is the computation of Stacks 0ENT, and of Stacks 0ENU, which refers to it.

The proof follows the source. Over the punctured line `π` has an inverse, which is an open chart
of `X` by the punctured line; every point of `X` other than the one over the origin lies on it.
Along a prime divisor met by that chart the order of vanishing of a function pulled back from the
affine line is read on the punctured line, a principal ideal domain, so each such prime divisor is
cut out by a polynomial up to a multiple of `x`. A rational function of `X` is, on the chart,
`t^m a / b` with `a` and `b` prime to `t`; so it is `(π^* t)^m π^* a / π^* b`, and its order of
vanishing along `x` is `2m`, the images of `π^* a` and `π^* b` in the henselian local ring at `x`
being units there because `π^* t` is not one. Hence the principal divisors are exactly the Weil
divisors with even coefficient along `x`.

## Main definitions

* `AlgebraicGeometry.Space.puncturedChart`: the inverse of `π` over the punctured line, an open
  immersion from the punctured line into `X`.
* `AlgebraicGeometry.Space.linePullbackFunction` and
  `AlgebraicGeometry.Space.coordinatePullbackUnit`: the rational function `π^* a`, and the unit
  `π^* t`.
* `AlgebraicGeometry.Space.primeDivisorClass`: the Weil divisor `[Z]` of a prime divisor.
* `AlgebraicGeometry.Space.weilDivisorClassGroupEquivZModTwo`: `Cl(X) ≃+ ℤ/2ℤ`.
* `AlgebraicGeometry.Space.primeDivisorEquivClosedPointsOfUniversalHomeomorphism`: the prime
  divisors of `X` are its closed points.

## Main results

* `AlgebraicGeometry.Space.ordRationalFunction_coordinatePullbackUnit` and
  `AlgebraicGeometry.Space.divRationalFunction_coordinatePullbackUnit`: `div(π^* t) = 2 [x]`.
* `AlgebraicGeometry.Space.even_ordRationalFunction`: every rational function vanishes to even
  order along `x`.
* `AlgebraicGeometry.Space.principalWeilDivisors_eq_ker_coefficientModTwo`: the principal Weil
  divisors are those with even coefficient along `x`.
* `AlgebraicGeometry.Space.weilDivisorClassGroup_primeDivisorClass_eq_zero`: the classes of the
  prime divisors other than `x` vanish.
* `AlgebraicGeometry.Space.nonempty_weilDivisorClassGroup_addEquiv_zmod_two`: `Cl(X) ≅ ℤ/2ℤ`.
* `AlgebraicGeometry.Space.exists_primeDivisor_genericPoint_eq_iff_isClosed`,
  `AlgebraicGeometry.Space.topologicalKrullDim_points` and
  `AlgebraicGeometry.Space.pointsHomeomorphAffineLine_eq_origin_iff`: the prime divisors are the
  closed points, `dim |X| = 1`, and `x` is the unique point of `X` over the origin.

## References

* [Stacks Project, Tag 0ENT](https://stacks.math.columbia.edu/tag/0ENT)
* [Stacks Project, Tag 0ENU](https://stacks.math.columbia.edu/tag/0ENU)
* [Stacks Project, Tag 0ENR](https://stacks.math.columbia.edu/tag/0ENR)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

namespace AffineLineInvolution

variable (k : Type u) [Field k] (B : BigFppfSite.{u}) (hk : B.Contains (Spec (.of k)))

/-! ### The punctured affine line as an object of the site -/

/-- The morphism of schemes underlying `puncturedChartInclusion` is the open immersion of the
punctured affine line into the affine line. -/
theorem toScheme_map_puncturedChartInclusion :
    (BigFppfOver.toScheme B (Spec (.of k)) hk).map (puncturedChartInclusion k B hk) =
      (puncturedAffineLineOpen k).ι :=
  congrArg CommaMorphism.left
    ((Over.post (X := B.obj hk) B.inclusion).map_preimage (X := puncturedAffineLineChart k B hk)
      (Y := affineLineChart k B hk) (puncturedAffineLineInclusion k))

/-- The scheme underlying `puncturedAffineLineChart` is affine. -/
instance isAffine_puncturedAffineLineChart :
    IsAffine (puncturedAffineLineChart k B hk).left.1 :=
  isAffine_puncturedAffineLine k

/-- The scheme over `Spec k` associated to `puncturedAffineLineChart` is affine. -/
instance isAffine_toScheme_puncturedAffineLineChart :
    IsAffine ((BigFppfOver.toScheme B (Spec (.of k)) hk).obj (puncturedAffineLineChart k B hk)) :=
  isAffine_puncturedAffineLine k

/-- The scheme underlying `puncturedAffineLineChart` is integral. -/
instance isIntegral_puncturedAffineLineChart :
    IsIntegral (puncturedAffineLineChart k B hk).left.1 :=
  isIntegral_puncturedAffineLine k

/-- The scheme underlying `puncturedAffineLineChart` is locally Noetherian. -/
instance isLocallyNoetherian_puncturedAffineLineChart :
    IsLocallyNoetherian (puncturedAffineLineChart k B hk).left.1 :=
  have := isLocallyNoetherian_affineLine k
  inferInstanceAs (IsLocallyNoetherian (puncturedAffineLineOpen k).toScheme)

/-- The ring of global sections of the scheme underlying `puncturedAffineLineChart` is a principal
ideal ring. -/
instance isPrincipalIdealRing_puncturedAffineLineChart :
    IsPrincipalIdealRing Γ((puncturedAffineLineChart k B hk).left.1, ⊤) :=
  isPrincipalIdealRing_puncturedAffineLine k

end AffineLineInvolution

namespace Space

open AffineLineInvolution

variable (k : Type u) [Field k] (B : BigFppfSite.{u}) (hk : B.Contains (Spec (.of k)))

/-- The restricted functor of points of the affine line over `k`, the target of `π`. -/
abbrev lineTarget : (BigFppfOver B (Spec (.of k)) hk)ᵒᵖ ⥤ Type u :=
  Stacks.Groupoids.points (Over.post (X := B.obj hk) B.inclusion) (affineLine k)

/-- The inclusion of the punctured affine line, on restricted functors of points. -/
abbrev puncturedLineInclusion :
    Stacks.Groupoids.points (Over.post (X := B.obj hk) B.inclusion) (puncturedAffineLine k) ⟶
      lineTarget k B hk :=
  (Over.post (X := B.obj hk) B.inclusion).op.whiskerLeft
    (yoneda.map (puncturedAffineLineInclusion k))

/-! ### The open chart over the punctured line -/

/-- The inclusion of the punctured line, read on represented presheaves. -/
theorem puncturedPointsIso_inv_comp :
    (puncturedPointsIso k B hk).inv ≫ puncturedLineInclusion k B hk =
      yoneda.map (puncturedChartInclusion k B hk) ≫ (affineLinePointsIso k B hk).inv :=
  pointsYonedaIso_inv_comp_whiskerLeft (Over.post (X := B.obj hk) B.inclusion)
    (V := puncturedAffineLineChart k B hk) (W := affineLineChart k B hk)
    (puncturedAffineLineInclusion k)

variable {k B hk} {X : (BigFppfOver B (Spec (.of k)) hk)ᵒᵖ ⥤ Type u}
    (π : X ⟶ lineTarget k B hk)

/-- The open chart of `X` over the punctured line: the inverse of `π` over `𝔸¹_k ∖ {0}`, read on
the presheaf represented by the punctured line. -/
def puncturedChart (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    yoneda.obj (puncturedAffineLineChart k B hk) ⟶ X :=
  haveI := hiso;
  (puncturedPointsIso k B hk).inv ≫ inv (pullback.snd π (puncturedLineInclusion k B hk)) ≫
    pullback.fst π (puncturedLineInclusion k B hk)

/-- Over the punctured line, the open chart followed by `π` is the inclusion of the punctured
line. -/
theorem puncturedChart_comp (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    puncturedChart π hiso ≫ π =
      yoneda.map (puncturedChartInclusion k B hk) ≫ (affineLinePointsIso k B hk).inv := by
  have := hiso
  rw [puncturedChart, Category.assoc, Category.assoc, pullback.condition, IsIso.inv_hom_id_assoc,
    puncturedPointsIso_inv_comp]

/-- The open chart is a base change of the inclusion of the punctured line along `π`. -/
theorem isPullback_puncturedChart (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    IsPullback (puncturedChart π hiso) (yoneda.map (𝟙 _)) (π ≫ (affineLinePointsIso k B hk).hom)
      (yoneda.map (puncturedChartInclusion k B hk)) := by
  have := hiso
  refine (IsPullback.of_hasPullback π (puncturedLineInclusion k B hk)).of_iso
    (asIso (pullback.snd π (puncturedLineInclusion k B hk)) ≪≫ puncturedPointsIso k B hk)
    (Iso.refl _) (puncturedPointsIso k B hk) (affineLinePointsIso k B hk) ?_ ?_ ?_ ?_
  · simp [puncturedChart]
  · simp
  · simp
  · rw [← Iso.inv_comp_eq, ← Category.assoc, puncturedPointsIso_inv_comp, Category.assoc,
      Iso.inv_hom_id, Category.comp_id]

/-- The open chart is an open immersion. -/
theorem isOpenImmersion_puncturedChart
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    IsOpenImmersion B (Spec (.of k)) hk (puncturedChart π hiso) :=
  isOpenImmersion_of_isPullback_yoneda_map B (Spec (.of k)) hk
    (by
      have : _root_.AlgebraicGeometry.IsOpenImmersion (puncturedAffineLineOpen k).ι :=
        inferInstance
      rw [toScheme_map_puncturedChartInclusion]
      exact this)
    (isPullback_puncturedChart π hiso)

/-- The chart `puncturedChart` is a monomorphism. -/
theorem mono_puncturedChart (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    Mono (puncturedChart π hiso) :=
  mono_of_isOpenImmersion B (Spec (.of k)) hk _ (isOpenImmersion_puncturedChart π hiso)

/-- The chart `puncturedChart` is étale. -/
theorem isEtale_puncturedChart (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    IsEtale B (Spec (.of k)) hk (puncturedChart π hiso) :=
  isEtale_of_isOpenImmersion B (Spec (.of k)) hk (isOpenImmersion_puncturedChart π hiso)

/-- The chart `puncturedChart` is representable by étale morphisms of schemes. -/
theorem presheaf_etale_puncturedChart
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of k)) hk)).presheaf (puncturedChart π hiso) :=
  presheaf_etale_of_isOpenImmersion B (Spec (.of k)) hk (isOpenImmersion_puncturedChart π hiso)

/-! ### Points -/

section Points

attribute [local instance] pointTopology

/-- A universal homeomorphism to the affine line is a homeomorphism on points. -/
theorem isHomeomorph_pointsMap_of_universalHomeomorphism
    (hπ : UniversalHomeomorphism B (Spec (.of k)) hk π) :
    IsHomeomorph (pointsMap B (Spec (.of k)) hk X π) := by
  have h := hπ (lineTarget k B hk) (isAlgebraicSpace_points_affineLine B k hk) (𝟙 _)
  refine isHomeomorph_pointsMap_of_comp_isIso B (Spec (.of k)) hk
    (inv (pullback.snd (𝟙 (lineTarget k B hk)) π)) ?_ h
  rw [IsIso.inv_comp_eq, ← pullback.condition, Category.comp_id]

/-- A point of `X` outside the open chart lies over the origin of the affine line: its image in
the affine line lies outside the puncture. -/
theorem pointsToScheme_notMem_puncturedAffineLineOpen
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    {ξ : points B (Spec (.of k)) hk X}
    (hξ : ξ ∉ Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso))) :
    pointsToScheme B (Spec (.of k)) hk (affineLineChart k B hk)
        (pointsMap B (Spec (.of k)) hk X (π ≫ (affineLinePointsIso k B hk).hom) ξ) ∉
      puncturedAffineLineOpen k := by
  intro h
  obtain ⟨b, hb⟩ := surjective_pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk)
    (⟨_, h⟩ : (puncturedAffineLineOpen k : Set (affineLine k).left))
  have hab : pointsMap B (Spec (.of k)) hk X (π ≫ (affineLinePointsIso k B hk).hom) ξ =
      pointsMap B (Spec (.of k)) hk _ (yoneda.map (puncturedChartInclusion k B hk)) b := by
    refine injective_pointsToScheme B (Spec (.of k)) hk (affineLineChart k B hk) ?_
    rw [pointsToScheme_pointsMap_yoneda, hb, toScheme_map_puncturedChartInclusion]
    rfl
  obtain ⟨w, hw, -⟩ := exists_points_of_isPullback B (Spec (.of k)) hk
    (isPullback_puncturedChart π hiso) ξ b hab
  exact hξ ⟨w, hw⟩

/-- At most one point of `X` lies outside the open chart over the punctured line. -/
theorem eq_of_notMem_range_puncturedChart
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    (hinj : Function.Injective (pointsMap B (Spec (.of k)) hk X π))
    {ξ ξ' : points B (Spec (.of k)) hk X}
    (hξ : ξ ∉ Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso)))
    (hξ' : ξ' ∉ Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso))) :
    ξ = ξ' := by
  have h := eq_of_notMem_puncturedAffineLineOpen k
    (pointsToScheme_notMem_puncturedAffineLineOpen π hiso hξ)
    (pointsToScheme_notMem_puncturedAffineLineOpen π hiso hξ')
  have h' := injective_pointsToScheme B (Spec (.of k)) hk (affineLineChart k B hk) h
  rw [pointsMap_comp_apply, pointsMap_comp_apply] at h'
  exact hinj ((pointsHomeomorphOfIso B (Spec (.of k)) hk (affineLinePointsIso k B hk)).injective h')

/-- The point set of the open chart over the punctured line is compact, being the image of an
affine scheme. -/
theorem isCompact_range_puncturedChart
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    IsCompact (Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso))) := by
  have : CompactSpace (points B (Spec (.of k)) hk (yoneda.obj (puncturedAffineLineChart k B hk))) :=
    (schemePointsHomeomorph B (Spec (.of k)) hk (puncturedAffineLineChart k B hk)).symm.compactSpace
  exact isCompact_range (continuous_pointsMap B (Spec (.of k)) hk _)

/-- The space of points of `X` is compact: it is the point set of the open chart together with at
most one further point. -/
theorem compactSpace_points (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    (hinj : Function.Injective (pointsMap B (Spec (.of k)) hk X π)) :
    CompactSpace (points B (Spec (.of k)) hk X) := by
  refine ⟨?_⟩
  by_cases h : ∃ ξ, ξ ∉ Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso))
  · obtain ⟨ξ₀, hξ₀⟩ := h
    convert (isCompact_range_puncturedChart π hiso).union (isCompact_singleton (x := ξ₀))
    exact (Set.eq_univ_of_forall fun ξ => (em _).imp_right fun hξ =>
      eq_of_notMem_range_puncturedChart π hiso hinj hξ hξ₀).symm
  · convert isCompact_range_puncturedChart π hiso
    exact (Set.eq_univ_of_forall fun ξ => not_not.1 (not_exists.1 h ξ)).symm

/-- A point of the punctured line lying over the generic point of a prime divisor of `X` has
coheight one there: the codimension of the prime divisor is the dimension of the local ring of `X`
at its generic point, which is that of the punctured line at any chart point above it. -/
theorem coheight_eq_one_of_pointsMap_eq_genericPoint (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hdec : IsDecentSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    (W : PrimeDivisor B (Spec (.of k)) hk X)
    (p : points B (Spec (.of k)) hk (yoneda.obj (puncturedAffineLineChart k B hk)))
    (hp : pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso) p =
      W.genericPoint B (Spec (.of k)) hk X) :
    Order.coheight (pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk) p :
      (puncturedAffineLine k).left) = 1 := by
  have hcod := W.codimension_genericPoint B (Spec (.of k)) hk X
  rw [codimension_eq_localRingDimension B (Spec (.of k)) hk hX hdec _
    (W.genericPoint B (Spec (.of k)) hk X) (by exact rfl)] at hcod
  have hdim := localRingDimension_eq_of_chartPoint B (Spec (.of k)) hk hX
    (puncturedAffineLineChart k B hk) (puncturedChart π hiso) (presheaf_etale_puncturedChart π hiso)
    _ (W.genericPoint B (Spec (.of k)) hk X)
    (hp ▸ chartPoint_pointsToScheme B (Spec (.of k)) hk _ _ p)
  rw [hcod, ringKrullDim_stalk_eq_coheight] at hdim
  exact_mod_cast hdim.symm

end Points

/-! ### Functions pulled back from the affine line -/

section Functions

variable (k) in
/-- The morphism from the affine line to the relative affine line over `Spec k` with coordinate
`a`: the function `a` on `𝔸¹_k`. -/
def lineFunction (a : Γ((affineLine k).left, ⊤)) : affineLine k ⟶ affineLineOver (Spec (.of k)) :=
  Over.homMk (AffineSpace.homOfVector (affineLine k).hom (fun _ => a))
    (AffineSpace.homOfVector_over _ _)

/-- The rational function `π^* a` of `X`, for a function `a` on the affine line: it is defined on
all of `X`. -/
def linePullbackFunction (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (a : Γ((affineLine k).left, ⊤)) : rationalFunctions B (Spec (.of k)) hk hX :=
  PartialMap.toRationalMap B (Spec (.of k)) hk
    ⟨⊤, isDenseOpenSubspace_top B (Spec (.of k)) hk hX,
      (⊤ : Subfunctor X).ι ≫ π ≫
        (Over.post (X := B.obj hk) B.inclusion).op.whiskerLeft (yoneda.map (lineFunction k a))⟩

/-- On an étale affine chart `c : W → X`, the rational function `π^* a` is the pullback of `a`
along the morphism `W → 𝔸¹_k` that `c ≫ π` is. -/
theorem rationalFunctionsToTotalFractionRing_linePullbackFunction
    (hX : IsAlgebraicSpace B (Spec (.of k)) hk X) (W : BigFppfOver B (Spec (.of k)) hk)
    [IsAffine W.left.1] [IsReduced W.left.1] [IsLocallyNoetherian W.left.1]
    (c : yoneda.obj W ⟶ X) (hc : IsEtale B (Spec (.of k)) hk c) (a : Γ((affineLine k).left, ⊤)) :
    rationalFunctionsToTotalFractionRing B (Spec (.of k)) hk hX W c hc
        (linePullbackFunction π hX a) =
      algebraMap Γ(W.left.1, ⊤) (FractionRing Γ(W.left.1, ⊤))
        ((yonedaEquiv (c ≫ π)).left.appTop a) := by
  rw [linePullbackFunction, rationalFunctionsToTotalFractionRing_toRationalMap_of_factors B
    (Spec (.of k)) hk hX W c hc _ (Subfunctor.lift (G := (⊤ : Subfunctor X)) c
      le_top) (Subfunctor.lift_ι _ _)]
  congr 1
  have h : yonedaEquiv (Subfunctor.lift (G := (⊤ : Subfunctor X)) c le_top ≫
      (⊤ : Subfunctor X).ι ≫ π ≫
        (Over.post (X := B.obj hk) B.inclusion).op.whiskerLeft (yoneda.map (lineFunction k a))) =
      yonedaEquiv (c ≫ π) ≫ lineFunction k a := by
    rw [← Category.assoc, Subfunctor.lift_ι, ← Category.assoc, yonedaEquiv_comp]
    rfl
  rw [h, affineLineCoordinate, Over.comp_left, Scheme.Hom.comp_appTop, lineFunction,
    CommRingCat.comp_apply]
  exact congrArg _ (AffineSpace.homOfVector_appTop_coord _ _ _)

/-- The open chart over the punctured line, followed by `π`, is the inclusion of the punctured
line, read as a point of the affine line. -/
theorem yonedaEquiv_puncturedChart_comp
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    yonedaEquiv (puncturedChart π hiso ≫ π) = puncturedAffineLineInclusion k := by
  rw [puncturedChart_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map]
  exact (Over.post (X := B.obj hk) B.inclusion).map_preimage (X := puncturedAffineLineChart k B hk)
    (Y := affineLineChart k B hk) (puncturedAffineLineInclusion k)

/-- On the open chart over the punctured line, `π^* a` is the restriction of `a`. -/
theorem rationalFunctionsToTotalFractionRing_puncturedChart_linePullbackFunction
    (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    (a : Γ((affineLine k).left, ⊤)) :
    rationalFunctionsToTotalFractionRing B (Spec (.of k)) hk hX (puncturedAffineLineChart k B hk)
        (puncturedChart π hiso) (isEtale_puncturedChart π hiso) (linePullbackFunction π hX a) =
      (algebraMap Γ((puncturedAffineLine k).left, ⊤)
        (FractionRing Γ((puncturedAffineLine k).left, ⊤)) (puncturedRestriction k a) :
        FractionRing Γ((puncturedAffineLine k).left, ⊤)) := by
  rw [rationalFunctionsToTotalFractionRing_linePullbackFunction, yonedaEquiv_puncturedChart_comp]
  rfl

/-- Pulling rational functions back to the open chart over the punctured line is injective, the
rational functions of an integral algebraic space forming a field. -/
theorem injective_rationalFunctionsToTotalFractionRing_puncturedChart
    (hX : IsAlgebraicSpace B (Spec (.of k)) hk X) (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    Function.Injective (rationalFunctionsToTotalFractionRing B (Spec (.of k)) hk hX
      (puncturedAffineLineChart k B hk) (puncturedChart π hiso)
      (isEtale_puncturedChart π hiso)) := by
  let := (isField_rationalFunctions B (Spec (.of k)) hk hX hInt).toField
  exact RingHom.injective _

/-- The rational function `π^* a` is invertible for `a ≠ 0`. -/
theorem isUnit_linePullbackFunction (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0) : IsUnit (linePullbackFunction π hX a) := by
  have hfield := isField_rationalFunctions B (Spec (.of k)) hk hX hInt
  have hne : linePullbackFunction π hX a ≠ 0 := by
    intro h
    have h' := rationalFunctionsToTotalFractionRing_puncturedChart_linePullbackFunction π hX hiso a
    rw [h, map_zero] at h'
    have h0 : (algebraMap Γ((puncturedAffineLine k).left, ⊤)
        (FractionRing Γ((puncturedAffineLine k).left, ⊤))) (puncturedRestriction k a) =
          algebraMap Γ((puncturedAffineLine k).left, ⊤)
            (FractionRing Γ((puncturedAffineLine k).left, ⊤)) 0 :=
      h'.symm.trans (map_zero _).symm
    exact ha (puncturedRestriction_injective k
      ((IsFractionRing.injective _ _ h0).trans (map_zero _).symm))
  obtain ⟨b, hb⟩ := hfield.mul_inv_cancel hne
  exact IsUnit.of_mul_eq_one b hb

/-- The unit `π^* a` of the rational functions of `X`, for `a ≠ 0`. -/
def linePullbackFunctionUnit (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0) : (rationalFunctions B (Spec (.of k)) hk hX)ˣ :=
  (isUnit_linePullbackFunction π hX hInt hiso ha).unit

/-- The unit `linePullbackFunctionUnit` is the rational function `π^* a`. -/
@[simp]
theorem coe_linePullbackFunctionUnit (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0) :
    (linePullbackFunctionUnit π hX hInt hiso ha : rationalFunctions B (Spec (.of k)) hk hX) =
      linePullbackFunction π hX a :=
  rfl

/-- **The pullback `π^* t` of the coordinate of the affine line**, as a unit of the rational
functions of `X`. -/
def coordinatePullbackUnit (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk))) :
    (rationalFunctions B (Spec (.of k)) hk hX)ˣ :=
  linePullbackFunctionUnit π hX hInt hiso (coordinate_ne_zero k)

end Functions

/-! ### Orders of vanishing -/

section Orders

variable (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hN : HasEtaleLocalProperty B (Spec (.of k)) hk X (fun Y : Scheme.{u} => IsLocallyNoetherian Y))
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))

/-- The order of vanishing along a prime divisor, as a homomorphism on the units of the rational
functions written additively. -/
def ordAt (Z : PrimeDivisor B (Spec (.of k)) hk X) :
    Additive (rationalFunctions B (Spec (.of k)) hk hX)ˣ →+ ℤ :=
  (Pi.evalAddMonoidHom (fun _ : PrimeDivisor B (Spec (.of k)) hk X => ℤ) Z).comp
    ((WeilDivisor B (Spec (.of k)) hk X).subtype.comp
      (divRationalFunctionHom B (Spec (.of k)) hk hX hInt hN))

/-- `ordAt Z` sends a unit `f` to the order of vanishing of `f` along `Z`. -/
theorem ordAt_ofMul (Z : PrimeDivisor B (Spec (.of k)) hk X)
    (f : (rationalFunctions B (Spec (.of k)) hk hX)ˣ) :
    ordAt hX hInt hN Z (Additive.ofMul f) =
      ordRationalFunction B (Spec (.of k)) hk hX hInt hN f Z :=
  rfl

include hiso in
/-- **The order of vanishing of `π^* a` at a prime divisor met by the open chart** is the order of
vanishing of `a` at the corresponding point of the punctured line. -/
theorem ordRationalFunction_linePullbackFunctionUnit_of_pointsMap_eq
    (W : PrimeDivisor B (Spec (.of k)) hk X)
    (p : points B (Spec (.of k)) hk (yoneda.obj (puncturedAffineLineChart k B hk)))
    (hp : pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso) p =
      W.genericPoint B (Spec (.of k)) hk X)
    {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0) :
    ordRationalFunction B (Spec (.of k)) hk hX hInt hN
        (linePullbackFunctionUnit π hX hInt hiso ha) W =
      ((Ring.ord ((puncturedAffineLine k).left.presheaf.stalk
          (pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk) p))
        ((puncturedAffineLine k).left.presheaf.germ ⊤ _ trivial
          (puncturedRestriction k a))).toNat : ℤ) := by
  let U := elementaryEtaleNeighborhoodOfMonoChart B (Spec (.of k)) hk
    (puncturedAffineLineChart k B hk) hX (puncturedChart π hiso) (isEtale_puncturedChart π hiso)
    (mono_puncturedChart π hiso) p _ hp
  have : IsAffine U.scheme.left.1 := isAffine_puncturedAffineLine k
  have : IsReduced U.scheme.left.1 :=
    inferInstanceAs (IsReduced (puncturedAffineLineChart k B hk).left.1)
  have : IsLocallyNoetherian U.scheme.left.1 :=
    inferInstanceAs (IsLocallyNoetherian (puncturedAffineLineChart k B hk).left.1)
  exact W.ordRationalFunction_eq_ord_germ B (Spec (.of k)) hk hX hInt hN U _ _
    (rationalFunctionsToTotalFractionRing_puncturedChart_linePullbackFunction π hX hiso a)

include hiso in
/-- `π^* t` has order of vanishing zero at every prime divisor met by the open chart: `t` is a unit
on the punctured line. -/
theorem ordRationalFunction_coordinatePullbackUnit_of_pointsMap_eq
    (W : PrimeDivisor B (Spec (.of k)) hk X)
    (p : points B (Spec (.of k)) hk (yoneda.obj (puncturedAffineLineChart k B hk)))
    (hp : pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso) p =
      W.genericPoint B (Spec (.of k)) hk X) :
    ordRationalFunction B (Spec (.of k)) hk hX hInt hN (coordinatePullbackUnit π hX hInt hiso) W =
      0 := by
  rw [coordinatePullbackUnit,
    ordRationalFunction_linePullbackFunctionUnit_of_pointsMap_eq π hX hInt hN hiso W p hp,
    Ring.ord_of_isUnit]
  · rfl
  · exact (isUnit_puncturedRestriction_coordinate k).map _

/-- The map from the functions on the affine line to the henselian local ring of `X` at the
generic point of a prime divisor, through its chosen chart and `π`. -/
def henselianLineMap (Z : PrimeDivisor B (Spec (.of k)) hk X) :
    Γ((affineLine k).left, ⊤) →+*
      ↥(Z.genericHenselianLocalRing B (Spec (.of k)) hk hX
        (hInt.isDecentSpace B (Spec (.of k)) hk X)) :=
  (Z.neighborhoodSectionsToGenericHenselianLocalRing B (Spec (.of k)) hk hX
      (hInt.isDecentSpace B (Spec (.of k)) hk X)
      (Z.genericChart B (Spec (.of k)) hk hX (hInt.isDecentSpace B (Spec (.of k)) hk X))).comp
    (yonedaEquiv ((Z.genericChart B (Spec (.of k)) hk hX
      (hInt.isDecentSpace B (Spec (.of k)) hk X)).toSpace ≫ π)).left.appTop.hom

include hiso in
/-- **The order of vanishing of `π^* a` along any prime divisor**, read in the henselian local
ring at its generic point. -/
theorem ordRationalFunction_linePullbackFunctionUnit_eq_ord_henselianLineMap
    (Z : PrimeDivisor B (Spec (.of k)) hk X) {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0) :
    ordRationalFunction B (Spec (.of k)) hk hX hInt hN
        (linePullbackFunctionUnit π hX hInt hiso ha) Z =
      ((Ring.ord _ (henselianLineMap π hX hInt Z a)).toNat : ℤ) := by
  have := Z.isLocallyNoetherian_genericChart B (Spec (.of k)) hk hX
    (hInt.isDecentSpace B (Spec (.of k)) hk X) hN
  have := Z.isReduced_genericChart B (Spec (.of k)) hk hX
    (hInt.isDecentSpace B (Spec (.of k)) hk X) hInt
  exact Z.ordRationalFunction_eq_ord_henselian B (Spec (.of k)) hk hX hInt hN _ _ _
    (rationalFunctionsToTotalFractionRing_linePullbackFunction π hX _ _ _ a)

/-- In a local ring, the image of an element generating together with `t` the unit ideal is a
unit, when the image of `t` is not. -/
theorem isUnit_map_of_notMem_span {A R : Type*} [CommRing A] [CommRing R] [IsLocalRing R]
    (ρ : A →+* R) {t a : A} (ht : (Ideal.span {t}).IsMaximal) (ha : a ∉ Ideal.span {t})
    (hρt : ¬ IsUnit (ρ t)) : IsUnit (ρ a) := by
  obtain ⟨y, i, hi, h⟩ := ht.exists_inv ha
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hi
  have h' := congrArg ρ h
  rw [map_add, map_mul, map_mul, map_one] at h'
  rcases IsLocalRing.isUnit_or_isUnit_of_add_one h' with h1 | h1
  · exact isUnit_of_mul_isUnit_right h1
  · exact absurd (isUnit_of_mul_isUnit_right h1) hρt

include hiso in
/-- **A function prime to `t` does not vanish along a prime divisor along which `π^* t` does.** -/
theorem ordRationalFunction_linePullbackFunctionUnit_eq_zero_of_notMem_span
    (Z : PrimeDivisor B (Spec (.of k)) hk X)
    (ht : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z ≠ 0)
    {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0) (hat : a ∉ Ideal.span {coordinate k}) :
    ordRationalFunction B (Spec (.of k)) hk hX hInt hN
        (linePullbackFunctionUnit π hX hInt hiso ha) Z =
      0 := by
  have : IsLocalRing ↥(Z.genericHenselianLocalRing B (Spec (.of k)) hk hX
      (hInt.isDecentSpace B (Spec (.of k)) hk X)) :=
    henselianLocalRing_isLocalRing B (Spec (.of k)) hk X hX (Z.genericPoint B (Spec (.of k)) hk X)
      (hInt.isDecentSpace B (Spec (.of k)) hk X)
  rw [coordinatePullbackUnit,
    ordRationalFunction_linePullbackFunctionUnit_eq_ord_henselianLineMap π hX hInt hN hiso] at ht
  rw [ordRationalFunction_linePullbackFunctionUnit_eq_ord_henselianLineMap π hX hInt hN hiso,
    Ring.ord_of_isUnit (isUnit_map_of_notMem_span _ (isMaximal_span_coordinate k) hat
      fun hu => ht (by rw [Ring.ord_of_isUnit hu]; rfl))]
  rfl

include hiso in
/-- **Every rational function vanishes to even order along a prime divisor along which `π^* t`
vanishes to order two.** On the open chart a rational function is `t^m a / b` with `a` and `b`
prime to `t`, so it is `(π^* t)^m π^* a / π^* b` on `X`, and only the first factor contributes
along such a prime divisor. -/
theorem even_ordRationalFunction (Z : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z = 2)
    (f : (rationalFunctions B (Spec (.of k)) hk hX)ˣ) :
    Even (ordRationalFunction B (Spec (.of k)) hk hX hInt hN f Z) := by
  set ψ : rationalFunctions B (Spec (.of k)) hk hX →+*
      FractionRing Γ((puncturedAffineLine k).left, ⊤) :=
    rationalFunctionsToTotalFractionRing B (Spec (.of k)) hk hX
      (puncturedAffineLineChart k B hk) (puncturedChart π hiso) (isEtale_puncturedChart π hiso)
  set ι : Γ((affineLine k).left, ⊤) →+* FractionRing Γ((puncturedAffineLine k).left, ⊤) :=
    (algebraMap Γ((puncturedAffineLine k).left, ⊤)
      (FractionRing Γ((puncturedAffineLine k).left, ⊤))).comp (puncturedRestriction k)
  have hψ : ∀ {a : Γ((affineLine k).left, ⊤)} (ha : a ≠ 0),
      ψ (linePullbackFunctionUnit π hX hInt hiso ha : rationalFunctions B (Spec (.of k)) hk hX) =
        ι a := fun {a} _ =>
    rationalFunctionsToTotalFractionRing_puncturedChart_linePullbackFunction π hX hiso a
  have hψinv : ∀ u : (rationalFunctions B (Spec (.of k)) hk hX)ˣ,
      ψ ((u⁻¹ : (rationalFunctions B (Spec (.of k)) hk hX)ˣ) :
        rationalFunctions B (Spec (.of k)) hk hX) = (ψ u)⁻¹ := fun u =>
    eq_inv_of_mul_eq_one_right (by rw [← map_mul, Units.mul_inv, map_one])
  -- write the pullback of `f` to the punctured line as a quotient
  obtain ⟨a, b, hb, hF⟩ := exists_eq_div_puncturedRestriction k
    (ψ (f : rationalFunctions B (Spec (.of k)) hk hX))
  have hfne : ψ (f : rationalFunctions B (Spec (.of k)) hk hX) ≠ 0 := (f.isUnit.map ψ).ne_zero
  have ha : a ≠ 0 := by
    rintro rfl
    exact hfne (by simp [hF])
  obtain ⟨m, a', hta', rfl⟩ := WfDvdMonoid.max_power_factor ha (irreducible_coordinate k)
  obtain ⟨n, b', htb', rfl⟩ := WfDvdMonoid.max_power_factor hb (irreducible_coordinate k)
  have ha' : a' ≠ 0 := right_ne_zero_of_mul ha
  have hb' : b' ≠ 0 := right_ne_zero_of_mul hb
  set g : (rationalFunctions B (Spec (.of k)) hk hX)ˣ :=
    coordinatePullbackUnit π hX hInt hiso ^ m * linePullbackFunctionUnit π hX hInt hiso ha' *
      (coordinatePullbackUnit π hX hInt hiso ^ n * linePullbackFunctionUnit π hX hInt hiso hb')⁻¹
  have hg : ψ (g : rationalFunctions B (Spec (.of k)) hk hX) =
      ι (coordinate k ^ m * a') / ι (coordinate k ^ n * b') := by
    rw [Units.val_mul, map_mul, hψinv, Units.val_mul, Units.val_mul, map_mul, map_mul,
      Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, map_pow, map_pow, coordinatePullbackUnit,
      hψ, hψ, hψ, map_mul, map_mul, map_pow, map_pow, div_eq_mul_inv]
  have hfg : f = g :=
    Units.ext (injective_rationalFunctionsToTotalFractionRing_puncturedChart π hX hInt hiso
      (hF.trans hg.symm))
  have hord : ∀ c : Γ((affineLine k).left, ⊤), ¬ coordinate k ∣ c → (hc : c ≠ 0) →
      ordRationalFunction B (Spec (.of k)) hk hX hInt hN
        (linePullbackFunctionUnit π hX hInt hiso hc) Z = 0 := fun c hct hc =>
    ordRationalFunction_linePullbackFunctionUnit_eq_zero_of_notMem_span π hX hInt hN hiso Z
      (by rw [hZ]; exact two_ne_zero) hc (fun hmem => hct (Ideal.mem_span_singleton.1 hmem))
  rw [hfg, ← ordAt_ofMul, ofMul_mul, ofMul_mul, ofMul_inv,
    ofMul_mul, ofMul_pow, ofMul_pow, map_add, map_add, map_neg, map_add, map_nsmul, map_nsmul,
    ordAt_ofMul, ordAt_ofMul, ordAt_ofMul, hZ, hord a' hta' ha', hord b' htb' hb']
  exact ⟨(m : ℤ) - n, by simp only [nsmul_eq_mul]; ring⟩

end Orders

/-! ### The prime divisors and the class group -/

section ClassGroup

attribute [local instance] pointTopology

variable (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hN : HasEtaleLocalProperty B (Spec (.of k)) hk X (fun Y : Scheme.{u} => IsLocallyNoetherian Y))
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    (hinj : Function.Injective (pointsMap B (Spec (.of k)) hk X π))
    (Z₀ : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ₀ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2)

include hZ₀ in
/-- The generic point of a prime divisor along which `π^* t` vanishes lies outside the open
chart. -/
theorem genericPoint_notMem_range_puncturedChart :
    Z₀.genericPoint B (Spec (.of k)) hk X ∉
      Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso)) := by
  rintro ⟨p, hp⟩
  rw [ordRationalFunction_coordinatePullbackUnit_of_pointsMap_eq π hX hInt hN hiso Z₀ p hp] at hZ₀
  exact absurd hZ₀ (by norm_num)

include hinj hZ₀ in
/-- Every prime divisor other than the one along which `π^* t` vanishes meets the open chart. -/
theorem genericPoint_mem_range_puncturedChart {W : PrimeDivisor B (Spec (.of k)) hk X}
    (hW : W ≠ Z₀) :
    W.genericPoint B (Spec (.of k)) hk X ∈
      Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso)) := by
  by_contra h
  exact hW (PrimeDivisor.eq_of_genericPoint_eq B (Spec (.of k)) hk hX
    (eq_of_notMem_range_puncturedChart π hiso hinj h
      (genericPoint_notMem_range_puncturedChart π hX hInt hN hiso Z₀ hZ₀)))

open scoped Classical in
include hinj hZ₀ in
/-- **The divisor of `t` is `2 [x]`.** The function `π^* t` vanishes to order two along the
prime divisor over the origin and to order zero along every other prime divisor. -/
theorem ordRationalFunction_coordinatePullbackUnit (W : PrimeDivisor B (Spec (.of k)) hk X) :
    ordRationalFunction B (Spec (.of k)) hk hX hInt hN (coordinatePullbackUnit π hX hInt hiso) W =
      if W = Z₀ then 2 else 0 := by
  split_ifs with hW
  · rw [hW, hZ₀]
  · obtain ⟨p, hp⟩ := genericPoint_mem_range_puncturedChart π hX hInt hN hiso hinj Z₀ hZ₀ hW
    exact ordRationalFunction_coordinatePullbackUnit_of_pointsMap_eq π hX hInt hN hiso W p hp

open scoped Classical in
include hinj hZ₀ in
/-- **Every prime divisor other than the one over the origin is principal up to a multiple of the
one over the origin**: for such a prime divisor `Z` there is a function `a` on the affine line
whose pullback vanishes to order one along `Z` and to order zero along every other prime divisor
not over the origin. It is a generator of the prime ideal of the point of the punctured line
lying under the generic point of `Z`, the punctured line being a principal ideal domain. -/
theorem exists_linePullbackFunction_ord_eq {Z : PrimeDivisor B (Spec (.of k)) hk X} (hZ : Z ≠ Z₀) :
    ∃ (a : Γ((affineLine k).left, ⊤)) (ha : a ≠ 0), ∀ W : PrimeDivisor B (Spec (.of k)) hk X,
      W ≠ Z₀ → ordRationalFunction B (Spec (.of k)) hk hX hInt hN
        (linePullbackFunctionUnit π hX hInt hiso ha) W = if W = Z then 1 else 0 := by
  have hY := isAffineOpen_top (puncturedAffineLine k).left
  obtain ⟨p, hp⟩ := genericPoint_mem_range_puncturedChart π hX hInt hN hiso hinj Z₀ hZ₀ hZ
  set q : (puncturedAffineLine k).left :=
    pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk) p
  have hq := coheight_eq_one_of_pointsMap_eq_genericPoint π hX (hInt.isDecentSpace B _ hk X) hiso
    Z p hp
  obtain ⟨g, hg⟩ :=
    (IsPrincipalIdealRing.principal (hY.primeIdealOf ⟨q, trivial⟩).asIdeal).principal
  let := (puncturedRestriction k).toAlgebra
  have := isLocalization_puncturedRestriction k
  obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, hga⟩ := IsLocalization.surj (Submonoid.powers (coordinate k)) g
  have hspan : (hY.primeIdealOf ⟨q, trivial⟩).asIdeal = Ideal.span {puncturedRestriction k a} := by
    have hga' : g * puncturedRestriction k (coordinate k ^ n) = puncturedRestriction k a := hga
    have hu : IsUnit (puncturedRestriction k (coordinate k ^ n)) := by
      rw [map_pow]
      exact (isUnit_puncturedRestriction_coordinate k).pow n
    rw [hg, ← hga']
    exact (Ideal.span_singleton_mul_right_unit hu g).symm
  have ha : a ≠ 0 := by
    rintro rfl
    have h := height_primeIdealOf_eq_one (Y := (puncturedAffineLine k).left) (q := q) hq
    rw [hspan, map_zero, Ideal.span_singleton_eq_bot.2 rfl, Ideal.height_bot] at h
    exact zero_ne_one h
  refine ⟨a, ha, fun W hW => ?_⟩
  obtain ⟨pW, hpW⟩ := genericPoint_mem_range_puncturedChart π hX hInt hN hiso hinj Z₀ hZ₀ hW
  rw [ordRationalFunction_linePullbackFunctionUnit_of_pointsMap_eq π hX hInt hN hiso W pW hpW]
  split_ifs with hWZ
  · subst hWZ
    have := mono_puncturedChart π hiso
    have hpp : pW = p :=
      pointsMap_injective_of_mono B (Spec (.of k)) hk _ (hpW.trans hp.symm)
    subst hpp
    rw [ord_germ_eq_one_of_primeIdealOf_eq_span (Y := (puncturedAffineLine k).left) (q := q) hspan]
    rfl
  · have hnot : puncturedRestriction k a ∉ (hY.primeIdealOf
        ⟨(pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk) pW :
          (puncturedAffineLine k).left), trivial⟩).asIdeal := by
      intro hmem
      have hqq := eq_of_mem_primeIdealOf (Y := (puncturedAffineLine k).left) (q := q) hq hspan
        hmem
      have hpp := injective_pointsToScheme B (Spec (.of k)) hk _ hqq
      exact hWZ (PrimeDivisor.eq_of_genericPoint_eq B (Spec (.of k)) hk hX
        (hpW.symm.trans (hpp ▸ hp)))
    have hunit : IsUnit ((puncturedAffineLine k).left.presheaf.germ ⊤
        (pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk) pW) trivial
        (puncturedRestriction k a)) :=
      (Scheme.mem_basicOpen_top _ _ _).1
        ((hY.mem_basicOpen_iff_notMem_primeIdealOf _ trivial).2 hnot)
    rw [Ring.ord_of_isUnit hunit]
    rfl

include hiso hinj in
/-- A Weil divisor of `X` has finitely many prime divisors with nonzero coefficient, the space of
points of `X` being compact. -/
theorem finite_support_weilDivisor (D : ↥(WeilDivisor B (Spec (.of k)) hk X)) :
    {Z : PrimeDivisor B (Spec (.of k)) hk X |
      (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z ≠ 0}.Finite := by
  have := compactSpace_points π hiso hinj
  refine ((mem_weilDivisor_iff B (Spec (.of k)) hk X _).1 D.2).finite_nonempty_of_compact.subset ?_
  intro Z hZ
  rw [Set.mem_setOf_eq] at hZ
  refine ⟨Z.genericPoint B (Spec (.of k)) hk X, ?_⟩
  rw [if_neg hZ]
  have h := (Z.isGenericPoint_genericPoint B (Spec (.of k)) hk X).def
  rw [← h]
  exact subset_closure rfl

/-- The class modulo two of the coefficient of a Weil divisor along `Z₀`. -/
def coefficientModTwo : ↥(WeilDivisor B (Spec (.of k)) hk X) →+ ZMod 2 :=
  (Int.castAddHom (ZMod 2)).comp ((Pi.evalAddMonoidHom
    (fun _ : PrimeDivisor B (Spec (.of k)) hk X => ℤ) Z₀).comp
      (WeilDivisor B (Spec (.of k)) hk X).subtype)

/-- `coefficientModTwo Z₀ D` is the coefficient of `D` along `Z₀`, reduced modulo two. -/
theorem coefficientModTwo_apply (D : ↥(WeilDivisor B (Spec (.of k)) hk X)) :
    coefficientModTwo Z₀ D = ((D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z₀ : ZMod 2) :=
  rfl

open scoped Classical in
/-- The Weil divisor `[Z]` of a single prime divisor. -/
def primeDivisorClass (Z : PrimeDivisor B (Spec (.of k)) hk X) :
    ↥(WeilDivisor B (Spec (.of k)) hk X) :=
  ⟨Pi.single Z 1, by
    let := pointTopology B (Spec (.of k)) hk X
    intro x
    refine ⟨Set.univ, Filter.univ_mem, (Set.finite_singleton Z).subset ?_⟩
    intro W hW
    by_contra hWZ
    simp [Pi.single_eq_of_ne hWZ] at hW⟩

open scoped Classical in
/-- The Weil divisor `[Z]` has coefficient `1` along `Z` and `0` elsewhere. -/
theorem coe_primeDivisorClass (Z : PrimeDivisor B (Spec (.of k)) hk X) :
    (primeDivisorClass Z : PrimeDivisor B (Spec (.of k)) hk X → ℤ) = Pi.single Z 1 :=
  rfl

open scoped Classical in
/-- The coefficient of `[Z₀]` along `Z₀` is `1` modulo two. -/
theorem coefficientModTwo_primeDivisorClass : coefficientModTwo Z₀ (primeDivisorClass Z₀) = 1 := by
  simp [coefficientModTwo_apply, coe_primeDivisorClass]

open scoped Classical in
/-- The coefficient modulo two along `Z₀` is surjective onto `ℤ/2ℤ`. -/
theorem surjective_coefficientModTwo : Function.Surjective (coefficientModTwo Z₀) := by
  intro r
  refine ⟨r.val • primeDivisorClass Z₀, ?_⟩
  rw [map_nsmul, coefficientModTwo_primeDivisorClass, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

include hinj hZ₀ in
/-- A Weil divisor with even coefficient along the prime divisor over the origin is principal. -/
private theorem mem_principalWeilDivisors_of_two_dvd_coefficient
    (D : ↥(WeilDivisor B (Spec (.of k)) hk X))
    (hD : (2 : ℤ) ∣ (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z₀) :
    D ∈ principalWeilDivisors B (Spec (.of k)) hk hX hInt hN := by
  classical
  -- the prime divisors other than `Z₀` along which `D` does not vanish
  set T := ((finite_support_weilDivisor π hiso hinj D).toFinset).erase Z₀
  have hT : ∀ Z ∈ T, Z ≠ Z₀ := fun Z hZ => Finset.ne_of_mem_erase hZ
  -- for each of them a function cutting it out away from `Z₀`
  choose a ha hord using fun Z : PrimeDivisor B (Spec (.of k)) hk X =>
    fun hZ : Z ≠ Z₀ => exists_linePullbackFunction_ord_eq π hX hInt hN hiso hinj Z₀ hZ₀ hZ
  let u : (Z : PrimeDivisor B (Spec (.of k)) hk X) → Z ≠ Z₀ →
      (rationalFunctions B (Spec (.of k)) hk hX)ˣ :=
    fun Z hZ => linePullbackFunctionUnit π hX hInt hiso (ha Z hZ)
  let c : ℤ := (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z₀ -
    ∑ Z ∈ T.attach, (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z *
      ordRationalFunction B (Spec (.of k)) hk hX hInt hN (u Z (hT Z Z.2)) Z₀
  have hc : (2 : ℤ) ∣ c := by
    refine dvd_sub hD (Finset.dvd_sum fun Z _ => dvd_mul_of_dvd_right ?_ _)
    exact even_iff_two_dvd.1 (even_ordRationalFunction π hX hInt hN hiso Z₀ hZ₀ _)
  have hDeq : D = ∑ Z ∈ T.attach, (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z •
        divRationalFunction B (Spec (.of k)) hk hX hInt hN (u Z (hT Z Z.2)) +
      (c / 2) • divRationalFunction B (Spec (.of k)) hk hX hInt hN
        (coordinatePullbackUnit π hX hInt hiso) := by
    refine Subtype.ext (funext fun W => ?_)
    simp only [AddSubgroup.coe_add, AddSubgroup.coe_zsmul, AddSubgroup.val_finset_sum,
      Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, divRationalFunction_apply,
      ordRationalFunction_coordinatePullbackUnit π hX hInt hN hiso hinj Z₀ hZ₀ W]
    by_cases hW : W = Z₀
    · subst hW
      rw [if_pos rfl, Int.ediv_mul_cancel hc]
      ring
    · rw [if_neg hW, mul_zero, add_zero]
      have hsum : ∀ Z ∈ T.attach, (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z *
          ordRationalFunction B (Spec (.of k)) hk hX hInt hN (u Z (hT Z Z.2)) W =
            if (Z : PrimeDivisor B (Spec (.of k)) hk X) = W then
              (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) W else 0 := by
        intro Z _
        rw [hord Z (hT Z Z.2) W hW]
        by_cases hZW : (Z : PrimeDivisor B (Spec (.of k)) hk X) = W
        · rw [if_pos hZW.symm, if_pos hZW, hZW, mul_one]
        · rw [if_neg (Ne.symm hZW), if_neg hZW, mul_zero]
      rw [Finset.sum_congr rfl hsum, Finset.sum_attach T
        (fun Z => if Z = W then (D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) W else 0),
        Finset.sum_ite_eq']
      split_ifs with hWT
      · rfl
      · by_contra hDW
        exact hWT (Finset.mem_erase.2 ⟨hW, (Set.Finite.mem_toFinset _).2 hDW⟩)
  have hmem := divRationalFunction_mem_principalWeilDivisors B (Spec (.of k)) hk hX hInt hN
  rw [hDeq]
  exact AddSubgroup.add_mem _ (AddSubgroup.sum_mem _ fun Z _ => AddSubgroup.zsmul_mem _ (hmem _) _)
    (AddSubgroup.zsmul_mem _ (hmem _) _)

include hinj hZ₀ in
/-- **The principal Weil divisors are exactly those with even coefficient along the prime divisor
over the origin.** -/
theorem principalWeilDivisors_eq_ker_coefficientModTwo :
    principalWeilDivisors B (Spec (.of k)) hk hX hInt hN = (coefficientModTwo Z₀).ker := by
  classical
  ext D
  rw [AddMonoidHom.mem_ker, coefficientModTwo_apply, ZMod.intCast_zmod_eq_zero_iff_dvd]
  refine ⟨?_, mem_principalWeilDivisors_of_two_dvd_coefficient π hX hInt hN hiso hinj Z₀ hZ₀ D⟩
  rintro ⟨f, rfl⟩
  exact even_iff_two_dvd.1 (even_ordRationalFunction π hX hInt hN hiso Z₀ hZ₀ f.toMul)

include hinj hZ₀ in
/-- **The Weil divisor class group of `X` is `ℤ/2ℤ`**, the isomorphism sending the class of a Weil
divisor to the parity of its coefficient along the prime divisor over the origin. -/
def weilDivisorClassGroupEquivZModTwoOfOrd :
    weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN ≃+ ZMod 2 :=
  (QuotientAddGroup.quotientAddEquivOfEq
      (principalWeilDivisors_eq_ker_coefficientModTwo π hX hInt hN hiso hinj Z₀ hZ₀)).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective _ (surjective_coefficientModTwo Z₀))

/-- The isomorphism `weilDivisorClassGroupEquivZModTwoOfOrd` sends the class of a Weil divisor
`D` to its coefficient along `Z₀` modulo two. -/
theorem weilDivisorClassGroupEquivZModTwoOfOrd_mk (D : ↥(WeilDivisor B (Spec (.of k)) hk X)) :
    weilDivisorClassGroupEquivZModTwoOfOrd π hX hInt hN hiso hinj Z₀ hZ₀
        (D : weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN) =
      ((D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z₀ : ZMod 2) :=
  rfl

include hinj hZ₀ in
/-- **The divisor of `t` on `X` is `2 [x]`**, for `x` the prime divisor over the origin. -/
theorem divRationalFunction_coordinatePullbackUnit :
    divRationalFunction B (Spec (.of k)) hk hX hInt hN (coordinatePullbackUnit π hX hInt hiso) =
      2 • primeDivisorClass Z₀ := by
  classical
  refine Subtype.ext (funext fun W => ?_)
  rw [divRationalFunction_apply, ordRationalFunction_coordinatePullbackUnit π hX hInt hN hiso hinj
    Z₀ hZ₀ W]
  split_ifs with hW
  · subst hW
    simp [coe_primeDivisorClass]
  · simp [coe_primeDivisorClass, hW]

include hinj hZ₀ in
/-- The prime divisor along which `π^* t` vanishes to order two is the only prime divisor along
which `π^* t` vanishes at all. -/
theorem eq_of_ordRationalFunction_coordinatePullbackUnit_ne_zero
    {W : PrimeDivisor B (Spec (.of k)) hk X}
    (hW : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) W ≠ 0) : W = Z₀ := by
  classical
  by_contra h
  rw [ordRationalFunction_coordinatePullbackUnit π hX hInt hN hiso hinj Z₀ hZ₀ W, if_neg h] at hW
  exact hW rfl

include hiso hinj hZ₀ in
/-- **The generic point of the prime divisor over the origin is the unique point of `X` lying over
the origin of the affine line**: a point of `X` maps outside the punctured line exactly when it is
that generic point. -/
theorem pointsToScheme_notMem_puncturedAffineLineOpen_iff (ξ : points B (Spec (.of k)) hk X) :
    pointsToScheme B (Spec (.of k)) hk (affineLineChart k B hk)
        (pointsMap B (Spec (.of k)) hk X (π ≫ (affineLinePointsIso k B hk).hom) ξ) ∉
      puncturedAffineLineOpen k ↔ ξ = Z₀.genericPoint B (Spec (.of k)) hk X := by
  constructor
  · intro h
    by_contra hne
    by_cases hξ : ξ ∈ Set.range (pointsMap B (Spec (.of k)) hk _ (puncturedChart π hiso))
    · obtain ⟨p, rfl⟩ := hξ
      apply h
      rw [← pointsMap_comp_apply, ← Category.assoc, puncturedChart_comp, Category.assoc,
        Iso.inv_hom_id, Category.comp_id, pointsToScheme_pointsMap_yoneda,
        toScheme_map_puncturedChartInclusion]
      exact (pointsToScheme B (Spec (.of k)) hk (puncturedAffineLineChart k B hk) p).2
    · exact hne (eq_of_notMem_range_puncturedChart π hiso hinj hξ
        (genericPoint_notMem_range_puncturedChart π hX hInt hN hiso Z₀ hZ₀))
  · rintro rfl
    exact pointsToScheme_notMem_puncturedAffineLineOpen π hiso
      (genericPoint_notMem_range_puncturedChart π hX hInt hN hiso Z₀ hZ₀)

end ClassGroup

/-! ### The class group, from a universal homeomorphism -/

section Main

attribute [local instance] pointTopology

variable (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hN : HasEtaleLocalProperty B (Spec (.of k)) hk X (fun Y : Scheme.{u} => IsLocallyNoetherian Y))
    (hπ : UniversalHomeomorphism B (Spec (.of k)) hk π)
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))

include hπ

/-- **The Weil divisor class group of a space over the affine line which is the line away from the
origin.** Let `X` be a locally Noetherian integral algebraic space over a field `k` and let
`π : X → 𝔸¹_k` be a universal homeomorphism which is an isomorphism over `𝔸¹_k ∖ {0}`. If `π^* t`
vanishes to order two along the prime divisor `Z₀`, then `Cl(X) ≅ ℤ/2ℤ`, a Weil divisor being sent
to the parity of its coefficient along `Z₀`. -/
def weilDivisorClassGroupEquivZModTwo (Z₀ : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ₀ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2) :
    weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN ≃+ ZMod 2 :=
  weilDivisorClassGroupEquivZModTwoOfOrd π hX hInt hN hiso
    (isHomeomorph_pointsMap_of_universalHomeomorphism π hπ).injective Z₀ hZ₀

/-- The isomorphism `weilDivisorClassGroupEquivZModTwo` sends the class of a Weil divisor `D` to
its coefficient along `Z₀` modulo two. -/
theorem weilDivisorClassGroupEquivZModTwo_mk (Z₀ : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ₀ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2) (D : ↥(WeilDivisor B (Spec (.of k)) hk X)) :
    weilDivisorClassGroupEquivZModTwo π hX hInt hN hπ hiso Z₀ hZ₀
        (D : weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN) =
      ((D : PrimeDivisor B (Spec (.of k)) hk X → ℤ) Z₀ : ZMod 2) :=
  rfl

/-- The isomorphism `Cl(X) ≅ ℤ/2ℤ` sends the class of the prime divisor over the origin to the
generator. -/
theorem weilDivisorClassGroupEquivZModTwo_primeDivisorClass
    (Z₀ : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ₀ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2) :
    weilDivisorClassGroupEquivZModTwo π hX hInt hN hπ hiso Z₀ hZ₀
        (primeDivisorClass Z₀ : weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN) = 1 :=
  coefficientModTwo_primeDivisorClass Z₀

/-- **`Cl(X) ≅ ℤ/2ℤ`**, as soon as `π^* t` vanishes to order two along some prime divisor. -/
theorem nonempty_weilDivisorClassGroup_addEquiv_zmod_two
    (hord : ∃ Z₀ : PrimeDivisor B (Spec (.of k)) hk X, ordRationalFunction B (Spec (.of k)) hk hX
      hInt hN (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2) :
    Nonempty (weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN ≃+ ZMod 2) :=
  let ⟨Z₀, hZ₀⟩ := hord
  ⟨weilDivisorClassGroupEquivZModTwo π hX hInt hN hπ hiso Z₀ hZ₀⟩

/-- **The classes of the prime divisors other than the one over the origin vanish** in `Cl(X)`. -/
theorem weilDivisorClassGroup_primeDivisorClass_eq_zero (Z₀ : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ₀ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2) {Z : PrimeDivisor B (Spec (.of k)) hk X}
    (hZ : Z ≠ Z₀) :
    (primeDivisorClass Z : weilDivisorClassGroup B (Spec (.of k)) hk hX hInt hN) = 0 := by
  classical
  refine (weilDivisorClassGroupEquivZModTwo π hX hInt hN hπ hiso Z₀ hZ₀).injective ?_
  rw [weilDivisorClassGroupEquivZModTwo_mk, coe_primeDivisorClass, Pi.single_eq_of_ne hZ.symm,
    map_zero]
  rfl

end Main

/-! ### The prime divisors are the closed points -/

section ClosedPoints

open TopologicalSpace

attribute [local instance] pointTopology

variable (hπ : UniversalHomeomorphism B (Spec (.of k)) hk π)

include hπ

/-- The space of points of `X` is homeomorphic to the affine line, through `π`. -/
def pointsHomeomorphAffineLine : points B (Spec (.of k)) hk X ≃ₜ (affineLine k).left :=
  (isHomeomorph_pointsMap_of_universalHomeomorphism π hπ).homeomorph.trans
    ((pointsHomeomorphOfIso B (Spec (.of k)) hk (affineLinePointsIso k B hk)).trans
      (schemePointsHomeomorph B (Spec (.of k)) hk (affineLineChart k B hk)))

/-- The codimension in `|X|` of the closure of a point is the coheight of its image in the affine
line. -/
theorem codimension_closureSingleton_eq_coheight (ξ : points B (Spec (.of k)) hk X) :
    codimension (IrreducibleCloseds.closureSingleton ξ) =
      Order.coheight (pointsHomeomorphAffineLine π hπ ξ) := by
  set h := pointsHomeomorphAffineLine π hπ
  have hmap : IrreducibleCloseds.map h h.continuous (IrreducibleCloseds.closureSingleton ξ) =
      IrreducibleCloseds.closureSingleton (h ξ) := by
    refine IrreducibleCloseds.ext ?_
    rw [IrreducibleCloseds.coe_map, IrreducibleCloseds.coe_closureSingleton,
      IrreducibleCloseds.coe_closureSingleton, h.image_closure, Set.image_singleton,
      closure_closure]
  have hEq : (irreducibleSetEquivPoints (α := (affineLine k).left)).symm (h ξ) =
      IrreducibleCloseds.closureSingleton (h ξ) :=
    IrreducibleCloseds.ext rfl
  rw [codimension_eq_coheight, ← h.isOpenEmbedding.coheight_map, hmap, ← hEq,
    Order.coheight_orderIso (irreducibleSetEquivPoints (α := (affineLine k).left)).symm]

/-- **The prime divisors of `X` are its closed points**: a point of `X` is the generic point of a
prime divisor exactly when it is closed. Through `π` the space of points of `X` is the affine
line, whose closed points are its points of coheight one. -/
theorem exists_primeDivisor_genericPoint_eq_iff_isClosed
    (hX : IsAlgebraicSpace B (Spec (.of k)) hk X) (hdec : IsDecentSpace B (Spec (.of k)) hk X)
    (ξ : points B (Spec (.of k)) hk X) :
    (∃ Z : PrimeDivisor B (Spec (.of k)) hk X, Z.genericPoint B (Spec (.of k)) hk X = ξ) ↔
      IsClosed ({ξ} : Set (points B (Spec (.of k)) hk X)) := by
  have hcod : codimension (IrreducibleCloseds.closureSingleton ξ) = 1 ↔
      IsClosed ({ξ} : Set (points B (Spec (.of k)) hk X)) := by
    rw [codimension_closureSingleton_eq_coheight π hπ, ← isClosed_singleton_iff_coheight_eq_one,
      ← (pointsHomeomorphAffineLine π hπ).isClosed_image, Set.image_singleton]
  rw [← hcod]
  constructor
  · rintro ⟨Z, rfl⟩
    exact Z.codimension_genericPoint B (Spec (.of k)) hk X
  · intro h
    refine exists_primeDivisor_genericPoint_eq_of_localRingDimension_eq_one B (Spec (.of k)) hk hX
      hdec ξ ?_
    rwa [← codimension_eq_localRingDimension B (Spec (.of k)) hk hX hdec _ ξ
      (IrreducibleCloseds.coe_closureSingleton ξ).symm]

/-- **The prime divisors of `X` are the closed points of `X`**, a prime divisor corresponding to
its generic point. -/
def primeDivisorEquivClosedPointsOfUniversalHomeomorphism
    (hX : IsAlgebraicSpace B (Spec (.of k)) hk X) (hdec : IsDecentSpace B (Spec (.of k)) hk X) :
    PrimeDivisor B (Spec (.of k)) hk X ≃
      {ξ : points B (Spec (.of k)) hk X // IsClosed ({ξ} : Set (points B (Spec (.of k)) hk X))} :=
  Equiv.ofBijective
    (fun Z => ⟨Z.genericPoint B (Spec (.of k)) hk X,
      (exists_primeDivisor_genericPoint_eq_iff_isClosed π hπ hX hdec _).1 ⟨Z, rfl⟩⟩)
    ⟨fun _ _ h =>
        PrimeDivisor.eq_of_genericPoint_eq B (Spec (.of k)) hk hX (congrArg Subtype.val h),
      fun ξ => (((exists_primeDivisor_genericPoint_eq_iff_isClosed π hπ hX hdec ξ.1).2 ξ.2).imp
        fun _ hZ => Subtype.ext hZ)⟩

/-- The closed point attached to a prime divisor is its generic point. -/
@[simp]
theorem coe_primeDivisorEquivClosedPointsOfUniversalHomeomorphism_apply
    (hX : IsAlgebraicSpace B (Spec (.of k)) hk X) (hdec : IsDecentSpace B (Spec (.of k)) hk X)
    (Z : PrimeDivisor B (Spec (.of k)) hk X) :
    (primeDivisorEquivClosedPointsOfUniversalHomeomorphism π hπ hX hdec Z : points _ _ hk X) =
      Z.genericPoint B (Spec (.of k)) hk X :=
  rfl

/-- The homeomorphism `pointsHomeomorphAffineLine` sends a point `ξ` of `X` to the point of the
affine line given by the image of `ξ` under `π`. -/
theorem pointsHomeomorphAffineLine_apply (ξ : points B (Spec (.of k)) hk X) :
    pointsHomeomorphAffineLine π hπ ξ = pointsToScheme B (Spec (.of k)) hk (affineLineChart k B hk)
      (pointsMap B (Spec (.of k)) hk X (π ≫ (affineLinePointsIso k B hk).hom) ξ) := by
  rw [pointsMap_comp_apply]
  rfl

/-- **The point of `X` over the origin.** If `π^* t` vanishes to order two along the prime divisor
`Z₀`, the generic point of `Z₀` is the unique point of `X` lying over the origin of the affine
line. -/
theorem pointsHomeomorphAffineLine_eq_origin_iff (hX : IsAlgebraicSpace B (Spec (.of k)) hk X)
    (hInt : IsIntegralSpace B (Spec (.of k)) hk X)
    (hN : HasEtaleLocalProperty B (Spec (.of k)) hk X (fun Y : Scheme.{u} => IsLocallyNoetherian Y))
    (hiso : IsIso (pullback.snd π (puncturedLineInclusion k B hk)))
    (Z₀ : PrimeDivisor B (Spec (.of k)) hk X)
    (hZ₀ : ordRationalFunction B (Spec (.of k)) hk hX hInt hN
      (coordinatePullbackUnit π hX hInt hiso) Z₀ = 2) (ξ : points B (Spec (.of k)) hk X) :
    pointsHomeomorphAffineLine π hπ ξ = origin k ↔ ξ = Z₀.genericPoint B (Spec (.of k)) hk X := by
  have hinj := (isHomeomorph_pointsMap_of_universalHomeomorphism π hπ).injective
  rw [← pointsToScheme_notMem_puncturedAffineLineOpen_iff π hX hInt hN hiso hinj Z₀ hZ₀,
    ← pointsHomeomorphAffineLine_apply π hπ ξ]
  exact ⟨fun h => h ▸ origin_notMem_puncturedAffineLineOpen k,
    fun h => eq_of_notMem_puncturedAffineLineOpen k h (origin_notMem_puncturedAffineLineOpen k)⟩

/-- The space of points of `X` has dimension one, being homeomorphic to the affine line. -/
theorem topologicalKrullDim_points :
    topologicalKrullDim (points B (Spec (.of k)) hk X) = 1 := by
  rw [IsHomeomorph.topologicalKrullDim_eq _ (pointsHomeomorphAffineLine π hπ).isHomeomorph,
    topologicalKrullDim_affineLine]

end ClosedPoints

end Space

end AlgebraicGeometry

end
