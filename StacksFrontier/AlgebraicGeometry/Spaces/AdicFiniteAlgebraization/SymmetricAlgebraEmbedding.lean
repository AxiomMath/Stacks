/-!
# Embedding a finite tower over the adic fibres into `\underline{Spec}_X(Sym ℱ)`

Let `X` be an algebraic space of finite type over a Noetherian ring `A`, `y_n : Y_n ⟶ X_n` a
cartesian tower of finite morphisms over its adic fibres, and `ℱ` a coherent `𝒪_X`-module with an
isomorphism of systems `(ι_n^* ℱ)_n ≅ ((y_n)_* 𝒪_{Y_n})_n`.  The source's proof of Stacks 0A01
embeds the `Y_n` into the adic fibres of `P = \underline{Spec}_X(Sym ℱ)`: a morphism `Y_n ⟶ P`
over `X` is a module map `ℱ ⟶ (Y_n ⟶ X)_* 𝒪`, the adjoint of the `n`-th component, and it is a
closed immersion because that map is surjective.  This file proves the steps of that argument.

## Main definitions

* `AlgebraicGeometry.Space.finiteTowerSystem`: the coherent system `((y_n)_* 𝒪_{Y_n})_n`.
* `AlgebraicGeometry.Space.towerModuleHom`: the module maps `ℱ ⟶ (Y_n ⟶ X)_* 𝒪`.
* `AlgebraicGeometry.Space.IsPushforwardTransposeCompatible`: the transposition identity of a
  cartesian affine square.

## Main results

* `AlgebraicGeometry.Space.SymAlgSheaf.hom_ext_of_gen`: morphisms out of `Sym 𝒢` are determined
  on the degree-one generators.
* `AlgebraicGeometry.Space.isClosedImmersion_of_pushforwardAlgebraMap_eq_algebraLift` and
  `AlgebraicGeometry.Space.comp_eq_of_pushforwardAlgebraMap_eq_algebraLift`: closed immersions
  into `\underline{Spec}_X(Sym 𝒢)` and their compatibility.
* `AlgebraicGeometry.Space.adjunct_comp_pushforwardAlgebraMap_of_isPullback`: the adjoint module
  maps are compatible along a cartesian affine square satisfying the transposition identity.
* `AlgebraicGeometry.Space.epi_towerModuleHom`: the adjoint module maps are epimorphisms.
* `AlgebraicGeometry.Space.exists_adicFibre_isClosedImmersion_of_comp_eq`: compatible closed
  immersions `Y_n ⟶ P` give a cartesian tower of closed immersions into the adic fibres of `P`.

## References

* [Stacks Project, Tag 0A01](https://stacks.math.columbia.edu/tag/0A01)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Sheaves.ToposPullback Stacks.Sheaves.ToposPushforward

universe u

namespace AlgebraicGeometry.Space


/-! ### Morphisms out of a symmetric algebra -/

section SymmetricAlgebra

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) {W : AlgebraicSpaces B S hS}
  {G : SheafOfModules.{u} (structureRingSheaf B S hS W)}

/-- **A morphism of algebra sheaves out of `Sym(𝒢)` is determined by its values on the
degree-one generators**, for `𝒢` quasi-coherent: over an affine étale chart the sections of
`Sym(𝒢)` are the symmetric algebra of the sections of `𝒢`, generated by those generators over
the structure ring, and the affine charts cover. -/
theorem SymAlgSheaf.hom_ext_of_gen (hG : G.IsQuasicoherentOnSite)
    {𝒜 : AlgebraSheaf.{u, u} B S hS W.1 W.2} {ψ χ : symmetricAlgebraSheaf B S hS W G ⟶ 𝒜}
    (h : ∀ (V : (SmallEtale B S hS W.1)ᵒᵖ) (m : G.val.obj V),
      (ψ.right.hom.app V).hom ((symmetricAlgebra B S hS W G).ungradedIncl 1
          ((symmetricAlgebraGen B S hS W G).val.app V m)) =
        (χ.right.hom.app V).hom ((symmetricAlgebra B S hS W G).ungradedIncl 1
          ((symmetricAlgebraGen B S hS W G).val.app V m))) :
    ψ = χ := by
  refine AlgebraSheaf.Hom.ext (sheafHom_eq_of_affineChart B S hS fun V hV => ?_)
  let e := symmetricAlgebraSheafSectionsRingEquiv B S hS W G hG V hV
  let f₁ := (ψ.right.hom.app (op V)).hom.comp e.toRingHom
  let f₂ := (χ.right.hom.app (op V)).hom.comp e.toRingHom
  have hf : f₁ = f₂ := by
    refine RingHom.ext fun y => ?_
    induction y using SymmetricAlgebra.induction with
    | algebraMap r =>
      show (ψ.right.hom.app (op V)).hom (e _) = (χ.right.hom.app (op V)).hom (e _)
      rw [symmetricAlgebraSheafSectionsRingEquiv_algebraMap]
      exact (ψ.comm (op V) r).trans (χ.comm (op V) r).symm
    | ι m =>
      show (ψ.right.hom.app (op V)).hom (e _) = (χ.right.hom.app (op V)).hom (e _)
      rw [symmetricAlgebraSheafSectionsRingEquiv_ι]
      exact h (op V) m
    | mul a b ha hb => rw [map_mul f₁, map_mul f₂, ha, hb]
    | add a b ha hb => rw [map_add f₁, map_add f₂, ha, hb]
  refine ConcreteCategory.hom_ext _ _ fun x => ?_
  obtain ⟨y, rfl⟩ := e.surjective x
  exact RingHom.congr_fun hf y

/-- **A morphism into `\underline{Spec}_X(Sym 𝒢)` given by an epimorphism of modules is a closed
immersion.**  Let `P` be affine over a quasi-compact `X` with `P_* 𝒪_P ≅ Sym(𝒢)`, `𝒢`
quasi-coherent, and let `g : Q ⟶ P` be a morphism over `X` from an algebraic space affine over
`X` whose direct-image map is the extension `Sym(𝒢) ⟶ Q_* 𝒪_Q` of an epimorphism of modules
`φ : 𝒢 ⟶ Q_* 𝒪_Q`. Then `g` is a closed immersion: over every affine chart the extension is
surjective, because the generators already map onto the sections of `Q_* 𝒪_Q`. -/
theorem isClosedImmersion_of_pushforwardAlgebraMap_eq_algebraLift
    (hXqc : IsQuasiCompactSpace B S hS W.1) (hG : G.IsQuasicoherentOnSite)
    (P Q : AffineOver B S hS W)
    (eP : pushforwardAlgebra B S hS P.obj ≅ symmetricAlgebraSheaf B S hS W G)
    (φ : G ⟶ (pushforwardAlgebra B S hS Q.obj).underlyingModule) (hφ : Epi φ)
    (g : Q.obj ⟶ P.obj)
    (hg : pushforwardAlgebraMap B S hS g =
      eP.hom ≫ SymAlgSheaf.algebraLift B S hS W (pushforwardAlgebra B S hS Q.obj) G φ) :
    IsClosedImmersion B S hS g.left.hom := by
  have hQqc := isQuasicoherent_pushforwardAlgebra_of_isAffineHom' B S hS Q.obj Q.property
  refine isClosedImmersion_of_surjective_pushforwardRingMap_app B S hS hXqc Q P g
    fun U hU x => ?_
  obtain ⟨m, hm⟩ := surjective_val_app_of_epi_of_isQuasicoherentOnSite φ hφ hG hQqc U hU x
  have hgen := SymAlgSheaf.algebraLift_ungradedIncl_gen B S hS W _ G φ (op U) m
  refine ⟨eP.inv.right.hom.app (op U) ((symmetricAlgebra B S hS W G).ungradedIncl 1
    ((symmetricAlgebraGen B S hS W G).val.app (op U) m)), ?_⟩
  have hinv := congrArg (fun k => (AlgebraSheaf.Hom.right k).hom.app (op U)
    ((symmetricAlgebra B S hS W G).ungradedIncl 1
      ((symmetricAlgebraGen B S hS W G).val.app (op U) m))) eP.inv_hom_id
  rw [← pushforwardAlgebraMap_right, hg]
  exact (congrArg (fun z => (SymAlgSheaf.algebraLift B S hS W _ G φ).right.hom.app (op U) z)
    hinv).trans (hgen.trans hm)

/-- **Morphisms into `\underline{Spec}_X(Sym 𝒢)` given by compatible module maps are
compatible.**  If `g : Q ⟶ P` and `g' : Q' ⟶ P` over `X` have direct-image maps the extensions
of `φ : 𝒢 ⟶ Q_* 𝒪_Q` and `φ' : 𝒢 ⟶ Q'_* 𝒪_{Q'}`, and `k : Q ⟶ Q'` over `X` restricts `φ'` to
`φ`, then `k ≫ g' = g`. -/
theorem comp_eq_of_pushforwardAlgebraMap_eq_algebraLift (hG : G.IsQuasicoherentOnSite)
    (P : AffineOver B S hS W)
    (eP : pushforwardAlgebra B S hS P.obj ≅ symmetricAlgebraSheaf B S hS W G) {Q Q' : Over W}
    (φ : G ⟶ (pushforwardAlgebra B S hS Q).underlyingModule)
    (φ' : G ⟶ (pushforwardAlgebra B S hS Q').underlyingModule)
    (g : Q ⟶ P.obj) (g' : Q' ⟶ P.obj)
    (hg : pushforwardAlgebraMap B S hS g =
      eP.hom ≫ SymAlgSheaf.algebraLift B S hS W (pushforwardAlgebra B S hS Q) G φ)
    (hg' : pushforwardAlgebraMap B S hS g' =
      eP.hom ≫ SymAlgSheaf.algebraLift B S hS W (pushforwardAlgebra B S hS Q') G φ')
    (k : Q ⟶ Q')
    (hk : φ = φ' ≫ AlgebraSheaf.underlyingModuleMap (pushforwardAlgebraMap B S hS k)) :
    k ≫ g' = g := by
  have hlift : SymAlgSheaf.algebraLift B S hS W _ G φ' ≫ pushforwardAlgebraMap B S hS k =
      SymAlgSheaf.algebraLift B S hS W _ G φ := by
    refine SymAlgSheaf.hom_ext_of_gen B S hS hG fun V m => ?_
    have h1 := SymAlgSheaf.algebraLift_ungradedIncl_gen B S hS W _ G φ' V m
    have h2 := SymAlgSheaf.algebraLift_ungradedIncl_gen B S hS W _ G φ V m
    have h3 : φ.val.app V m = (pushforwardAlgebraMap B S hS k).right.hom.app V (φ'.val.app V m) :=
      by rw [hk]; rfl
    exact (congrArg (fun z => (pushforwardAlgebraMap B S hS k).right.hom.app V z) h1).trans
      (h3.symm.trans h2.symm)
  refine eq_of_pushforwardAlgebraMap_eq B S hS P ?_
  rw [pushforwardAlgebraMap_comp, hg', hg, Category.assoc, hlift]

end SymmetricAlgebra


/-! ### The direct image of a cartesian affine square -/

section Transition

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The cartesian square identifying `W` with the base change of `W'` has top edge `s`. -/
theorem affineOverIsoBaseChangeOfIsPullback_hom_left_comp {X Y : AlgebraicSpaces B S hS}
    (g : Y ⟶ X) (W : AffineOver B S hS Y) (W' : AffineOver B S hS X)
    (s : W.obj.left ⟶ W'.obj.left) (h : IsPullback s W.obj.hom W'.obj.hom g) :
    (affineOverIsoBaseChangeOfIsPullback B S hS g W W' s h).hom.hom.left ≫
        affineOverBaseChangeProjection B S hS g W' = s :=
  h.isoIsPullback_hom_fst _ _ (affineOverBaseChange_isPullback B S hS g W')

/-- **The ring-level transpose of the transition of a cartesian affine square is the direct-image
comparison of the square.**  The base-change comparison `g^* (W'_* 𝒪) ⟶ (Y ×_X W')_* 𝒪`,
restricted to the inverse image `g⁻¹ (W'_* 𝒪)` and followed by the identification of the base
change with `W`, is adjoint to the map `W'_* 𝒪 ⟶ g_* (W_* 𝒪)` induced by the top edge `s`. -/
theorem commRingImageAdjunction_homEquiv_affineCartesianTransition {X Y : AlgebraicSpaces B S hS}
    (g : Y ⟶ X) (W : AffineOver B S hS Y) (W' : AffineOver B S hS X)
    (s : W.obj.left ⟶ W'.obj.left) (h : IsPullback s W.obj.hom W'.obj.hom g) :
    (Stacks.Sheaves.ToposPushforward.commRingImageAdjunction
        (smallEtaleRingedToposHom B S hS g).toToposHom).homEquiv _ _
      ((algebraPullbackMap B S hS g).app (pushforwardAlgebra B S hS W'.obj) ≫
        (haveI := isIso_affineOverBaseChangeAlgebraHom B S hS g W'
        asIso (affineOverBaseChangeAlgebraHom B S hS g W') ≪≫
          pushforwardAlgebraIsoOfIso B S hS
            (affineOverIsoBaseChangeOfIsPullback B S hS g W W' s h)).hom.right) =
      pushforwardSquareMap B S hS g W'.obj W.obj s h.w := by
  have e1 : ((algebraPullbackMap B S hS g).app (pushforwardAlgebra B S hS W'.obj) ≫
        (have := isIso_affineOverBaseChangeAlgebraHom B S hS g W'
        asIso (affineOverBaseChangeAlgebraHom B S hS g W') ≪≫
          pushforwardAlgebraIsoOfIso B S hS
            (affineOverIsoBaseChangeOfIsPullback B S hS g W W' s h)).hom.right) =
      pushforwardSquareBaseChangeMap B S hS g W'.obj (affineOverBaseChange B S hS g W').obj
          (affineOverBaseChangeProjection B S hS g W')
          (affineOverBaseChange_isPullback B S hS g W').w ≫
        pushforwardRingMap B S hS
          (affineOverIsoBaseChangeOfIsPullback B S hS g W W' s h).hom.hom := by
    rw [← algebraPullbackMap_comp_baseChangeAlgebraHom]
    exact (Category.assoc _ _ _).symm
  refine (congrArg ((Stacks.Sheaves.ToposPushforward.commRingImageAdjunction
    (smallEtaleRingedToposHom B S hS g).toToposHom).homEquiv _ _) e1).trans ?_
  refine (Adjunction.homEquiv_naturality_right _ _ _).trans ?_
  refine (congrArg (fun k => k ≫ (pushforwardCommRingFunctor
      (smallEtaleRingedToposHom B S hS g).toToposHom).map (pushforwardRingMap B S hS
        (affineOverIsoBaseChangeOfIsPullback B S hS g W W' s h).hom.hom))
    (pushforwardSquareBaseChangeMap_canonical B S hS g W'.obj
      (affineOverBaseChange B S hS g W').obj (affineOverBaseChangeProjection B S hS g W')
      (affineOverBaseChange_isPullback B S hS g W').w)).trans ?_
  refine (pushforwardSquareMap_comp_map_pushforwardRingMap B S hS g _ _ _ _).trans ?_
  exact pushforwardSquareMap_congr B S hS g _ _
    (affineOverIsoBaseChangeOfIsPullback_hom_left_comp B S hS g W W' s h) _ _

/-- The direct image along `ι : Z ⟶ X` of the direct-image algebra of an algebraic space `W`
over `Z`, identified with the direct-image algebra of `W` read over `X`. -/
def modulePushforwardPushforwardAlgebraIso {X Z : AlgebraicSpaces B S hS} (ι : Z ⟶ X)
    (W : Over Z) :
    (modulePushforward B S hS ι).obj (pushforwardAlgebra B S hS W).underlyingModule ≅
      (pushforwardAlgebra B S hS (Over.mk (W.hom ≫ ι))).underlyingModule :=
  eqToIso (congrArg (modulePushforward B S hS ι).obj
      (underlyingModule_pushforwardAlgebra B S hS W.hom)) ≪≫
    (modulePushforwardCompIso B S hS W.hom ι).app _ ≪≫
    eqToIso (underlyingModule_pushforwardAlgebra B S hS (W.hom ≫ ι)).symm

/-- The adjoint along a composite of adjunctions, read through a natural isomorphism of right
adjoints, of a morphism compatible through the comparison of left adjoints. -/
theorem _root_.CategoryTheory.Adjunction.homEquiv_eq_homEquiv_comp_map_homEquiv
    {C D E : Type*} [Category C] [Category D] [Category E]
    {F₁ : C ⥤ D} {G₁ : D ⥤ C} {F₂ : D ⥤ E} {G₂ : E ⥤ D} {L : C ⥤ E} {R : E ⥤ C}
    (adj₁ : F₁ ⊣ G₁) (adj₂ : F₂ ⊣ G₂) (adj : L ⊣ R) (e : G₂ ⋙ G₁ ≅ R) (ρ : F₁ ⋙ F₂ ≅ L)
    (hρ : ρ = Adjunction.leftAdjointUniq ((adj₁.comp adj₂).ofNatIsoRight e) adj)
    {X : C} {M : E} {M' : D} (ρX : F₂.obj (F₁.obj X) ≅ L.obj X) (hρX : ρX = ρ.app X)
    (a : L.obj X ⟶ M) (a' : F₁.obj X ⟶ M') (T : F₂.obj M' ⟶ M)
    (hcomm : F₂.map a' ≫ T = ρX.hom ≫ a) :
    adj.homEquiv _ _ a =
      adj₁.homEquiv _ _ a' ≫ G₁.map (adj₂.homEquiv _ _ T) ≫ e.hom.app M := by
  subst hρ hρX
  have h1 : adj₁.homEquiv _ _ a' ≫ G₁.map (adj₂.homEquiv _ _ T) =
      adj₁.homEquiv _ _ (adj₂.homEquiv _ _ (F₂.map a' ≫ T)) := by
    rw [← Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_left]
  rw [← Category.assoc, h1, hcomm]
  have h2 := Adjunction.homEquiv_ofNatIsoRight_apply (adj₁.comp adj₂) e
    ((Adjunction.leftAdjointUniq ((adj₁.comp adj₂).ofNatIsoRight e) adj).hom.app X ≫ a)
  rw [Adjunction.comp_homEquiv, Equiv.trans_apply] at h2
  rw [Iso.app_hom, ← h2, Adjunction.homEquiv_naturality_right,
    Adjunction.homEquiv_leftAdjointUniq_hom_app, Adjunction.homEquiv_unit]

/-- With the transport along `t ≫ ι' = t ≫ ι'` trivial, the comparison of inverse images of the
factorization is the comparison of inverse images of the composite. -/
theorem modulePullbackCompIsoOfEq_rfl {X Y W : AlgebraicSpaces B S hS} (f : X ⟶ Y) (g : Y ⟶ W) :
    modulePullbackCompIsoOfEq B S hS f g (rfl : f ≫ g = f ≫ g) =
      modulePullbackCompIso B S hS f g := by
  simp only [modulePullbackCompIsoOfEq, eqToIso_refl, Iso.trans_refl]

section RingLevel

variable {A₁ A₂ A₃ X : AlgebraicSpaces B S hS}

/-- The comparison `y_* (b_* R) ≅ (b ≫ y)_* R` of iterated direct images of a sheaf of
commutative rings. -/
noncomputable def pushforwardCommRingCompIsoOfSpaces (b : A₂ ⟶ A₃) (y : A₃ ⟶ X)
    (R : Sheaf (SmallEtale.topology B S hS A₂.1) CommRingCat.{u}) :
    (pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS y).toToposHom).obj
        ((pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS b).toToposHom).obj R) ≅
      (pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS (b ≫ y)).toToposHom).obj R :=
  pushforwardCommRingCompIso (smallEtaleRingedToposHom B S hS b).toToposHom
      (smallEtaleRingedToposHom B S hS y).toToposHom R ≪≫
    (smallEtaleRingedToposHom_compRingIso B S hS b y).app R

/-- On sheaves of sets the comparison of iterated direct images of a sheaf of rings is the
comparison of Stacks 03G2, part (3). -/
theorem forgetRing_map_pushforwardCommRingCompIsoOfSpaces_hom (b : A₂ ⟶ A₃) (y : A₃ ⟶ X)
    (R : Sheaf (SmallEtale.topology B S hS A₂.1) CommRingCat.{u}) :
    (smallEtaleRingedTopos B S hS X).forgetRing.map
        (pushforwardCommRingCompIsoOfSpaces B S hS b y R).hom =
      (smallToposMorphismTypeU_comp B S hS b y).hom.app
        ((sheafCompose (SmallEtale.topology B S hS A₂.1) (forget CommRingCat.{u})).obj R) := by
  have hcomp : (smallEtaleRingedTopos B S hS X).forgetRing.map
      (pushforwardCommRingCompIso (smallEtaleRingedToposHom B S hS b).toToposHom
        (smallEtaleRingedToposHom B S hS y).toToposHom R).hom = 𝟙 _ :=
    pushforwardCommRingCompIso_hom_forget
      (smallEtaleRingedToposHom B S hS b).toToposHom
      (smallEtaleRingedToposHom B S hS y).toToposHom R
  have hiso : (smallEtaleRingedTopos B S hS X).forgetRing.map
        ((smallEtaleRingedToposHom_compRingIso B S hS b y).hom.app R) =
      (smallToposMorphismTypeU_comp B S hS b y).hom.app
        ((sheafCompose (SmallEtale.topology B S hS A₂.1) (forget CommRingCat.{u})).obj R) :=
    underlyingRingSheaf_map_pullbackCommRingSheafFunctorIsoOfNatIso_hom
      (SmallEtale.topology B S hS X.1) _ (smallToposMorphismTypeU_comp B S hS b y)
  refine ((smallEtaleRingedTopos B S hS X).forgetRing.map_comp _ _).trans ?_
  refine (congrArg₂ (fun p q => p ≫ q) hcomp hiso).trans ?_
  exact Category.id_comp _

/-- The left-hand side of
`AlgebraicGeometry.Space.map_pushforwardCompIso_hom_comp_pushforwardCompIso_hom`, on sheaves of
sets. -/
theorem forgetRing_map_map_pushforwardCompIso_hom_comp (a : A₁ ⟶ A₂) (b : A₂ ⟶ A₃)
    (y : A₃ ⟶ X) :
    (smallEtaleRingedTopos B S hS X).forgetRing.map
      ((pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS y).toToposHom).map
        (pushforwardCompIso B S hS a b).hom ≫ (pushforwardCompIso B S hS (a ≫ b) y).hom) =
      (smallToposMorphismTypeU B S hS y).pushforward.map
          ((smallToposMorphismTypeU_comp B S hS a b).hom.app (structureSetSheaf B S hS A₁)) ≫
        (smallToposMorphismTypeU_comp B S hS (a ≫ b) y).hom.app (structureSetSheaf B S hS A₁) := by
  have e1 : (smallEtaleRingedTopos B S hS X).forgetRing.map
      ((pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS y).toToposHom).map
        (pushforwardCompIso B S hS a b).hom) =
      (smallToposMorphismTypeU B S hS y).pushforward.map
        ((smallToposMorphismTypeU_comp B S hS a b).hom.app (structureSetSheaf B S hS A₁)) :=
    (underlyingRingSheaf_map_pullbackCommRingSheafMap (SmallEtale.topology B S hS X.1)
      (Φ := (smallEtaleRingedToposHom B S hS y).toToposHom.pushforward)
      (pushforwardCompIso B S hS a b).hom).trans
      (congrArg (smallToposMorphismTypeU B S hS y).pushforward.map
        (forgetRing_map_pushforwardCompIso_hom B S hS a b))
  exact ((smallEtaleRingedTopos B S hS X).forgetRing.map_comp _ _).trans
    (congrArg₂ (fun p q => p ≫ q) e1 (forgetRing_map_pushforwardCompIso_hom B S hS (a ≫ b) y))

/-- The right-hand side of
`AlgebraicGeometry.Space.map_pushforwardCompIso_hom_comp_pushforwardCompIso_hom`, on sheaves of
sets. -/
theorem forgetRing_map_pushforwardCommRingCompIsoOfSpaces_hom_comp (a : A₁ ⟶ A₂) (b : A₂ ⟶ A₃)
    (y : A₃ ⟶ X) :
    (smallEtaleRingedTopos B S hS X).forgetRing.map
      ((pushforwardCommRingCompIsoOfSpaces B S hS b y
          ((pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS a).toToposHom).obj
            (smallEtaleRingedTopos B S hS A₁).O)).hom ≫
        (pushforwardCompIso B S hS a (b ≫ y)).hom) =
      (smallToposMorphismTypeU_comp B S hS b y).hom.app
          ((smallToposMorphismTypeU B S hS a).pushforward.obj (structureSetSheaf B S hS A₁)) ≫
        (smallToposMorphismTypeU_comp B S hS a (b ≫ y)).hom.app (structureSetSheaf B S hS A₁) :=
  ((smallEtaleRingedTopos B S hS X).forgetRing.map_comp _ _).trans
    (congrArg₂ (fun p q => p ≫ q)
      (forgetRing_map_pushforwardCommRingCompIsoOfSpaces_hom B S hS b y _)
      (forgetRing_map_pushforwardCompIso_hom B S hS a (b ≫ y)))

/-- **The associativity cocycle of the comparison of iterated direct images of structure
sheaves**, at the level of sheaves of rings. -/
theorem map_pushforwardCompIso_hom_comp_pushforwardCompIso_hom (a : A₁ ⟶ A₂) (b : A₂ ⟶ A₃)
    (y : A₃ ⟶ X) :
    (pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS y).toToposHom).map
        (pushforwardCompIso B S hS a b).hom ≫ (pushforwardCompIso B S hS (a ≫ b) y).hom =
      (pushforwardCommRingCompIsoOfSpaces B S hS b y
          ((pushforwardCommRingFunctor (smallEtaleRingedToposHom B S hS a).toToposHom).obj
            (smallEtaleRingedTopos B S hS A₁).O)).hom ≫
        (pushforwardCompIso B S hS a (b ≫ y)).hom :=
  (smallEtaleRingedTopos B S hS X).forgetRing.map_injective
    ((forgetRing_map_map_pushforwardCompIso_hom_comp B S hS a b y).trans
      ((smallToposMorphismTypeU_comp_assoc B S hS a b y (structureSetSheaf B S hS A₁)).trans
        (forgetRing_map_pushforwardCommRingCompIsoOfSpaces_hom_comp B S hS a b y).symm))

end RingLevel

/-- **The transposition identity for a cartesian affine square.**  For a cartesian square
`W ⟶ W'` of algebraic spaces affine over `Z ⟶ Z'` and `ι' : Z' ⟶ X`, the transpose
`W'_* 𝒪 ⟶ t_* (W_* 𝒪)` of the base-change transition `t^* (W'_* 𝒪) ≅ W_* 𝒪`, pushed forward along
`ι'` and read through the comparisons of iterated direct images, is the direct-image map over `X`
of the top edge `s : W ⟶ W'`.  The transition is the argument `T`; the identity is asserted for
`T` the transition `AlgebraicGeometry.Space.affineTowerModuleTransition` of the square. -/
def IsPushforwardTransposeCompatible {X Z Z' : AlgebraicSpaces B S hS} (t : Z ⟶ Z') (ι' : Z' ⟶ X)
    (W : AffineOver B S hS Z) (W' : AffineOver B S hS Z') (s : W.obj.left ⟶ W'.obj.left)
    (hs : IsPullback s W.obj.hom W'.obj.hom t)
    (T : (modulePullback B S hS t).obj (pushforwardAlgebra B S hS W'.obj).underlyingModule ≅
      (pushforwardAlgebra B S hS W.obj).underlyingModule) : Prop :=
  (modulePushforward B S hS ι').map ((modulePullbackAdjunction B S hS t).homEquiv
      (pushforwardAlgebra B S hS W'.obj).underlyingModule
      (pushforwardAlgebra B S hS W.obj).underlyingModule T.hom) ≫
      (modulePushforwardCompIso B S hS t ι').hom.app
        (pushforwardAlgebra B S hS W.obj).underlyingModule ≫
        (modulePushforwardPushforwardAlgebraIso B S hS (t ≫ ι') W.obj).hom =
    (modulePushforwardPushforwardAlgebraIso B S hS ι' W'.obj).hom ≫
      AlgebraSheaf.underlyingModuleMap (pushforwardAlgebraMap B S hS
        (Over.homMk s (by
          change s ≫ W'.obj.hom ≫ ι' = W.obj.hom ≫ t ≫ ι'
          rw [← Category.assoc, hs.w, Category.assoc]) :
          Over.mk (W.obj.hom ≫ t ≫ ι') ⟶ Over.mk (W'.obj.hom ≫ ι')))

/-- **The adjoints of compatible module maps into the direct images of a cartesian affine
square are compatible with the restriction of functions**, given the transposition identity
`AlgebraicGeometry.Space.IsPushforwardTransposeCompatible` of the square. -/
theorem adjunct_comp_pushforwardAlgebraMap_of_isPullback {X Z Z' : AlgebraicSpaces B S hS}
    (t : Z ⟶ Z') (ι' : Z' ⟶ X) (ι : Z ⟶ X) (hι : t ≫ ι' = ι)
    (W : AffineOver B S hS Z) (W' : AffineOver B S hS Z') (s : W.obj.left ⟶ W'.obj.left)
    (hs : IsPullback s W.obj.hom W'.obj.hom t)
    (F : Modules.{u, u} B S hS X.1 X.2)
    (ρF : (modulePullback B S hS t).obj ((modulePullback B S hS ι').obj F) ≅
      (modulePullback B S hS ι).obj F)
    (hρF : ρF = (modulePullbackCompIsoOfEq B S hS t ι' hι).app F)
    (T : (modulePullback B S hS t).obj (pushforwardAlgebra B S hS W'.obj).underlyingModule ≅
      (pushforwardAlgebra B S hS W.obj).underlyingModule)
    (hG :
  (modulePushforward B S hS ι').map ((modulePullbackAdjunction B S hS t).homEquiv
      (pushforwardAlgebra B S hS W'.obj).underlyingModule
      (pushforwardAlgebra B S hS W.obj).underlyingModule T.hom) ≫
      (modulePushforwardCompIso B S hS t ι').hom.app
        (pushforwardAlgebra B S hS W.obj).underlyingModule ≫
        (modulePushforwardPushforwardAlgebraIso B S hS (t ≫ ι') W.obj).hom =
    (modulePushforwardPushforwardAlgebraIso B S hS ι' W'.obj).hom ≫
      AlgebraSheaf.underlyingModuleMap (pushforwardAlgebraMap B S hS
        (Over.homMk s (by
          change s ≫ W'.obj.hom ≫ ι' = W.obj.hom ≫ t ≫ ι'
          rw [← Category.assoc, hs.w, Category.assoc]) :
          Over.mk (W.obj.hom ≫ t ≫ ι') ⟶ Over.mk (W'.obj.hom ≫ ι'))))
    (a : (modulePullback B S hS ι).obj F ⟶ (pushforwardAlgebra B S hS W.obj).underlyingModule)
    (a' : (modulePullback B S hS ι').obj F ⟶
      (pushforwardAlgebra B S hS W'.obj).underlyingModule)
    (hcomm : (modulePullback B S hS t).map a' ≫ T.hom = ρF.hom ≫ a) :
    (modulePullbackAdjunction B S hS ι).homEquiv _ _ a ≫
        (modulePushforwardPushforwardAlgebraIso B S hS ι W.obj).hom =
      ((modulePullbackAdjunction B S hS ι').homEquiv _ _ a' ≫
        (modulePushforwardPushforwardAlgebraIso B S hS ι' W'.obj).hom) ≫
        AlgebraSheaf.underlyingModuleMap (pushforwardAlgebraMap B S hS
          (Over.homMk s (by
            change s ≫ W'.obj.hom ≫ ι' = W.obj.hom ≫ ι
            rw [← Category.assoc, hs.w, Category.assoc, hι]) :
            Over.mk (W.obj.hom ≫ ι) ⟶ Over.mk (W'.obj.hom ≫ ι'))) := by
  subst hι
  have hS1 := Adjunction.homEquiv_eq_homEquiv_comp_map_homEquiv (modulePullbackAdjunction B S hS ι')
    (modulePullbackAdjunction B S hS t) (modulePullbackAdjunction B S hS (t ≫ ι'))
    (modulePushforwardCompIso B S hS t ι') (modulePullbackCompIso B S hS t ι')
    (by rw [modulePullbackCompIso, moduleCompAdjunction]) ρF
    (hρF.trans (congrArg (fun k => Iso.app k F) (modulePullbackCompIsoOfEq_rfl B S hS t ι')))
    a a' T.hom hcomm
  refine (congrArg (fun k => k ≫ (modulePushforwardPushforwardAlgebraIso B S hS (t ≫ ι') W.obj).hom)
    hS1).trans ?_
  simp only [Category.assoc]
  exact congrArg (fun k => (modulePullbackAdjunction B S hS ι').homEquiv _ _ a' ≫ k) hG


end Transition

/-! ### The module maps of an isomorphism of systems -/

section Tower

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X : AlgebraicSpaces B S hS} {Z : ℕ → AlgebraicSpaces B S hS} (ι : ∀ n, Z n ⟶ X)
  (t : ∀ n, Z n ⟶ Z (n + 1)) (hι : ∀ n, t n ≫ ι (n + 1) = ι n)
  (hZ : ∀ n, HasEtaleLocalProperty B S hS (Z n).1 (fun V : Scheme.{u} => IsLocallyNoetherian V))
  (W : ∀ n, AffineOver B S hS (Z n)) (s : ∀ n, (W n).obj.left ⟶ (W (n + 1)).obj.left)
  (hcart : ∀ n, IsPullback (s n) (W n).obj.hom (W (n + 1)).obj.hom (t n))
  (hcoh : ∀ n, IsCoherent B S hS (Z n).1 (Z n).2
    (pushforwardAlgebra B S hS (W n).obj).underlyingModule)

/-- `W n` read over `X` through `ι n`. -/
abbrev towerOver (n : ℕ) : Over X := Over.mk ((W n).obj.hom ≫ ι n)

include hι hcart in
/-- The transition `s n` commutes with the structure morphisms of `towerOver` to `X`. -/
theorem towerOver_w (n : ℕ) :
    s n ≫ (towerOver B S hS ι W (n + 1)).hom = (towerOver B S hS ι W n).hom := by
  show s n ≫ (W (n + 1)).obj.hom ≫ ι (n + 1) = (W n).obj.hom ≫ ι n
  rw [← Category.assoc, (hcart n).w, Category.assoc, hι]

/-- The transition `W n ⟶ W (n + 1)`, as a morphism over `X`. -/
abbrev towerOverHom (n : ℕ) : towerOver B S hS ι W n ⟶ towerOver B S hS ι W (n + 1) :=
  Over.homMk (s n) (towerOver_w B S hS ι t hι W s hcart n)

/-- The module map `F ⟶ (W n ⟶ X)_* 𝒪` adjoint to the `n`-th component of a morphism from the
restriction of `F` to the system of direct images of a cartesian affine tower. -/
def towerModuleHom (F : CoherentModules.{u, u} B S hS X.1 X.2)
    (e : (thickeningRestriction B S hS ι t hι hZ).obj F ⟶
      affineTowerSystem B S hS t W s hcart hcoh) (n : ℕ) :
    F.obj ⟶ (pushforwardAlgebra B S hS (towerOver B S hS ι W n)).underlyingModule :=
  (modulePullbackAdjunction B S hS (ι n)).homEquiv _ _
      (show (modulePullback B S hS (ι n)).obj F.obj ⟶
        (pushforwardAlgebra B S hS (W n).obj).underlyingModule from e.app n) ≫
    (modulePushforwardPushforwardAlgebraIso B S hS (ι n) (W n).obj).hom

/-- **The module maps adjoint to an isomorphism of systems are epimorphisms** when the `ι n` are
closed immersions: the unit `F ⟶ (ι n)_* (ι n)^* F` is then an epimorphism. -/
theorem epi_towerModuleHom (hi : ∀ n, IsClosedImmersion B S hS (ι n).hom)
    (F : CoherentModules.{u, u} B S hS X.1 X.2)
    (e : (thickeningRestriction B S hS ι t hι hZ).obj F ≅
      affineTowerSystem B S hS t W s hcart hcoh) (n : ℕ) :
    Epi (towerModuleHom B S hS ι t hι hZ W s hcart hcoh F e.hom n) := by
  have : IsIso (e.hom.app n) :=
    ⟨e.inv.app n, congrArg (fun k => k.app n) e.hom_inv_id,
      congrArg (fun k => k.app n) e.inv_hom_id⟩
  have h1 : Epi ((modulePullbackAdjunction B S hS (ι n)).unit.app F.obj) :=
    epi_modulePullbackAdjunction_unit_of_essImage_of_annihilated B S hS (ι n) (hi n)
      (fun M hM => essImage_modulePushforward_of_annihilatedByKerIdeal B S hS (ι n) (hi n) M hM)
      F.obj
  have h2 : Epi ((modulePushforward B S hS (ι n)).map (e.hom.app n)) := IsIso.epi_of_iso _
  have h3 : Epi (modulePushforwardPushforwardAlgebraIso B S hS (ι n) (W n).obj).hom :=
    IsIso.epi_of_iso _
  rw [towerModuleHom, Adjunction.homEquiv_unit]
  refine @epi_comp _ _ _ _ _ _ ?_ _ h3
  refine @epi_comp _ _ _ _ _ _ h1 _ ?_
  exact h2

end Tower

/-! ### The embedding -/

section Embedding

variable (A : Type u) [CommRing A] (I : Ideal A) (B : BigFppfSite.{u})
  (hA : B.Contains (Spec (.of A)))
  {X : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u}
  (hX : IsAlgebraicSpace B (Spec (.of A)) hA X) (f : X ⟶ yoneda.obj (baseObject A B hA))
  {Y : ℕ → AlgebraicSpaces B (Spec (.of A)) hA} (y : ∀ n, Y n ⟶ adicFibreSpace A I B hA hX f n)
  (tY : ∀ n, Y n ⟶ Y (n + 1))
  (hcart : ∀ n, IsPullback (tY n) (y n) (y (n + 1)) (adicFibreSuccHom A I B hA hX f n))
  (hfin : ∀ n, IsFinite B (Spec (.of A)) hA (y n).hom)

/-- `Y_n`, as an algebraic space affine over the adic fibre `X_n`: a finite morphism is
affine. -/
def finiteTowerAffine (n : ℕ) : AffineOver B (Spec (.of A)) hA (adicFibreSpace A I B hA hX f n) :=
  ⟨Over.mk (y n), IsFinite.isAffineHom (hfin n)⟩

/-- The direct images `(y_n)_* 𝒪_{Y_n}` are coherent. -/
theorem isCoherent_finiteTowerAffine [IsNoetherianRing A]
    (hft : IsLocallyOfFiniteType B (Spec (.of A)) hA f) (n : ℕ) :
    IsCoherent B (Spec (.of A)) hA (adicFibreSpace A I B hA hX f n).1
      (adicFibreSpace A I B hA hX f n).2
      (pushforwardAlgebra B (Spec (.of A)) hA
        (finiteTowerAffine A I B hA hX f y hfin n).obj).underlyingModule := by
  have : Fact (HasEtaleLocalProperty B (Spec (.of A)) hA (adicFibreSpace A I B hA hX f n).1
      (fun V : Scheme.{u} => IsLocallyNoetherian V)) :=
    ⟨hasEtaleLocalProperty_isLocallyNoetherian_adicFibre A I B hA hX f hft n⟩
  exact isCoherent_underlyingModule_pushforwardAlgebra_of_isFinite B (Spec (.of A)) hA (y n)
    (hfin n)

/-- **The coherent system `((y_n)_* 𝒪_{Y_n})_n`** of a cartesian tower of finite morphisms over the
adic fibres, an object of the category of Stacks 08BF. -/
def finiteTowerSystem [IsNoetherianRing A] (hft : IsLocallyOfFiniteType B (Spec (.of A)) hA f) :
    ThickeningCoherentSystem B (Spec (.of A)) hA (adicFibreSpace A I B hA hX f)
      (adicFibreSuccHom A I B hA hX f) :=
  affineTowerSystem B (Spec (.of A)) hA (adicFibreSuccHom A I B hA hX f)
    (finiteTowerAffine A I B hA hX f y hfin) tY hcart
    (isCoherent_finiteTowerAffine A I B hA hX f y hfin hft)

/-- The adic fibres of a morphism `g : P ⟶ X` over the base form cartesian squares with the
transitions: `P_n = P_{n + 1} ×_{X_{n + 1}} X_n`. -/
theorem isPullback_adicFibreSucc_adicFibreMap {P : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u}
    (g : P ⟶ X) (n : ℕ) :
    IsPullback (adicFibreSucc A I B hA (contains_adicThickening A I B hA) (g ≫ f) n)
      (adicFibreMap A I B hA (contains_adicThickening A I B hA) g rfl n)
      (adicFibreMap A I B hA (contains_adicThickening A I B hA) g rfl (n + 1))
      (adicFibreSucc A I B hA (contains_adicThickening A I B hA) f n) := by
  refine IsPullback.of_bot ?_ (adicFibreSucc_adicFibreMap A I B hA _ g rfl n)
    (isPullback_adicFibreSucc A I B hA (contains_adicThickening A I B hA) f n)
  rw [adicFibreMap_snd, adicFibreMap_snd]
  exact isPullback_adicFibreSucc A I B hA (contains_adicThickening A I B hA) (g ≫ f) n

include hcart in
/-- **A compatible family of closed immersions `Y_n ⟶ P` over the `y_n` is a cartesian tower of
closed immersions into the adic fibres of `P`.**  Let `p : P ⟶ X` and let `g_n : Y_n ⟶ P` be
closed immersions with `g_n ≫ p = y_n ≫ ι_n` and `t_n ≫ g_{n + 1} = g_n`. The induced
`c_n : Y_n ⟶ P_n = P ×_{Spec A} Spec (A / I ^ (n + 1))` are closed immersions lying over the
`y_n`, and the squares `Y_n ⟶ Y_{n + 1}` over `P_n ⟶ P_{n + 1}` are cartesian, by pasting
`Y_n = Y_{n + 1} ×_{X_{n + 1}} X_n` with `P_n = P_{n + 1} ×_{X_{n + 1}} X_n`. -/
theorem exists_adicFibre_isClosedImmersion_of_comp_eq {P : AlgebraicSpaces B (Spec (.of A)) hA}
    (p : P ⟶ (⟨X, hX⟩ : AlgebraicSpaces B (Spec (.of A)) hA)) (g : ∀ n, Y n ⟶ P)
    (hg : ∀ n, g n ≫ p = y n ≫ adicFibreFstHom A I B hA hX f n)
    (hgcl : ∀ n, IsClosedImmersion B (Spec (.of A)) hA (g n).hom)
    (hcomp : ∀ n, tY n ≫ g (n + 1) = g n) :
    ∃ c : ∀ n, Y n ⟶ adicFibreSpace A I B hA P.2 (p.hom ≫ f) n,
      (∀ n, IsClosedImmersion B (Spec (.of A)) hA (c n).hom) ∧
      (∀ n, IsPullback (tY n) (c n) (c (n + 1)) (adicFibreSuccHom A I B hA P.2 (p.hom ≫ f) n)) ∧
      (∀ n, (c n).hom ≫ adicFibreMap A I B hA (contains_adicThickening A I B hA) p.hom rfl n =
        (y n).hom) := by
  have hg' : ∀ n, (g n).hom ≫ p.hom =
      (y n).hom ≫ (adicFibreFstHom A I B hA hX f n).hom := fun n => congrArg (fun k => k.hom) (hg n)
  have hw : ∀ n, (g n).hom ≫ p.hom ≫ f =
      ((y n).hom ≫ adicFibreSnd A I B hA f n) ≫
        yoneda.map (adicThickeningMap A I B hA (contains_adicThickening A I B hA) n) := by
    intro n
    rw [← Category.assoc, hg', Category.assoc, Category.assoc]
    exact congrArg (fun k => (y n).hom ≫ k) pullback.condition
  let c : ∀ n, Y n ⟶ adicFibreSpace A I B hA P.2 (p.hom ≫ f) n := fun n =>
    ObjectProperty.homMk (pullback.lift (g n).hom ((y n).hom ≫ adicFibreSnd A I B hA f n) (hw n))
  have hc₁ : ∀ n, (c n).hom ≫ pullback.fst (p.hom ≫ f)
      (yoneda.map (adicThickeningMap A I B hA (contains_adicThickening A I B hA) n)) =
        (g n).hom := fun n => pullback.lift_fst _ _ _
  have hc₂ : ∀ n, (c n).hom ≫ pullback.snd (p.hom ≫ f)
      (yoneda.map (adicThickeningMap A I B hA (contains_adicThickening A I B hA) n)) =
      (y n).hom ≫ pullback.snd f
        (yoneda.map (adicThickeningMap A I B hA (contains_adicThickening A I B hA) n)) :=
    fun n => pullback.lift_snd _ _ _
  have hover : ∀ n, (c n).hom ≫
      adicFibreMap A I B hA (contains_adicThickening A I B hA) p.hom rfl n = (y n).hom := by
    intro n
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, adicFibreMap_fst, ← Category.assoc, hc₁, hg']
      rfl
    · rw [Category.assoc, adicFibreMap_snd]
      exact hc₂ n
  refine ⟨c, fun n => ?_, fun n => ?_, hover⟩
  · have := mono_of_isClosedImmersion B (Spec (.of A)) hA _
      (isClosedImmersion_yoneda_map_adicThickeningMap A I B hA n)
    refine isClosedImmersion_of_comp_mono B (Spec (.of A)) hA (c n).hom
      (pullback.fst (p.hom ≫ f)
        (yoneda.map (adicThickeningMap A I B hA (contains_adicThickening A I B hA) n))) ?_
    rw [hc₁]
    exact hgcl n
  · have hsq : IsPullback (tY n).hom (c n).hom (c (n + 1)).hom
        (adicFibreSucc A I B hA (contains_adicThickening A I B hA) (p.hom ≫ f) n) := by
      refine IsPullback.of_bot ?_ ?_ (isPullback_adicFibreSucc_adicFibreMap A I B hA f p.hom n)
      · rw [hover, hover]
        exact AlgebraicSpaces.isPullback_hom B (Spec (.of A)) hA (hcart n)
      · refine pullback.hom_ext ?_ ?_
        · rw [Category.assoc, Category.assoc, hc₁, adicFibreSucc_fst, hc₁]
          exact congrArg (fun k => k.hom) (hcomp n)
        · have hw2 : (tY n).hom ≫ (y (n + 1)).hom =
              (y n).hom ≫ adicFibreSucc A I B hA (contains_adicThickening A I B hA) f n :=
            congrArg (fun k => k.hom) (hcart n).w
          rw [Category.assoc, Category.assoc, hc₂, adicFibreSucc_snd, ← Category.assoc (c n).hom,
            hc₂, ← Category.assoc (tY n).hom, hw2, Category.assoc, Category.assoc,
            adicFibreSucc_snd]
    exact IsPullback.of_map_of_faithful
      (F := ObjectProperty.ι
        (fun F : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u =>
          IsAlgebraicSpace B (Spec (.of A)) hA F)) hsq

end Embedding

end AlgebraicGeometry.Space

end
