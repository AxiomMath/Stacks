module

public import StacksFrontier.AlgebraicGeometry.Spaces.AdicFiniteAlgebraization.FiniteTower
public import StacksFrontier.AlgebraicGeometry.Spaces.AdicFibreSubspace
public import StacksFrontier.AlgebraicGeometry.Spaces.KernelIdealSheafCartesianSquare
public import StacksFrontier.AlgebraicGeometry.Spaces.LocallyPrincipalPullback
public import StacksFrontier.AlgebraicGeometry.Spaces.MorphismKernelIdeal
public import StacksFrontier.AlgebraicGeometry.Spaces.ProperClosedImmersion
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedZariskiRestriction
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.AffineOfAffineThickening
public import StacksFrontier.AlgebraicGeometry.Smooth.FormallySmoothScheme

/-!
# The ideal of an adic fibre on the affine étale charts

Let `A` be a ring, `I ⊆ A` an ideal, `X` an algebraic space over `Spec A` and
`ι_n : X_n ⟶ X` the inclusion of its `n`-th adic fibre `X_n = X ×_{Spec A} Spec (A / I ^ (n + 1))`.
This file computes the kernel ideal sheaf of `ι_n` on every affine étale chart `V` of `X`: its
sections there are the ideal generated by the image of `I ^ (n + 1)` under the ring map
`φ_V : Γ(Spec A) ⟶ Γ(V)` of the structure morphism.

This is the chart-level input of the identification of the ideal of `X_n ⊂ X` with
`(I 𝒪_X) ^ (n + 1)`, through which the systems of coherent modules on the adic fibres of Stacks
08BF are compared with the coherent adic systems of Stacks 08BE.

## Main definitions

* `AlgebraicGeometry.Space.adicFibreFstHom`: the inclusion `ι_n : X_n ⟶ X`.

## Main results

* `AlgebraicGeometry.Space.definingIdealAt_adicThickeningSubspace_selfChart`: on `Spec A` itself
  the defining ideal of `Spec (A / I ^ (n + 1))` is `I ^ (n + 1)`.
* `AlgebraicGeometry.Space.kernelIdealSheaf_adicFibreFstHom_obj_of_isAffine`: on an affine étale
  chart `V` of `X`, the kernel ideal of `ι_n` is `Ideal.map φ_V (I ^ (n + 1))`.

## References

* [Stacks Project, Tag 08BF](https://stacks.math.columbia.edu/tag/08BF)
* [Stacks Project, Tag 08B7](https://stacks.math.columbia.edu/tag/08B7)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (A : Type u) [CommRing A] (I : Ideal A) (B : BigFppfSite.{u})
  (hA : B.Contains (Spec (.of A)))

/-- The adic thickenings of the base are objects of the site. -/
local notation "𝒜" => contains_adicThickening A I B hA

/-- The represented closed immersion `Spec (A / I ^ (n + 1)) ⟶ Spec A` is a closed immersion of
algebraic spaces. -/
theorem isClosedImmersion_yoneda_map_adicThickeningMap (n : ℕ) :
    IsClosedImmersion B (Spec (.of A)) hA
      (yoneda.map (adicThickeningMap A I B hA 𝒜 n)) :=
  (BigFppfOver.presheaf_inverseImage_yoneda_map_iff B (Spec (.of A)) hA
    (@AlgebraicGeometry.IsClosedImmersion.{u}) _).2
    (isClosedImmersion_toScheme_map_adicThickeningMap A I B hA 𝒜 n)

/-- **On `Spec A` itself the defining ideal of `Spec (A / I ^ (n + 1))` is `I ^ (n + 1)`**, read
in the ring `Γ(Spec A)` of the base object through `Γ(Spec A) ≅ A`. -/
theorem definingIdealAt_adicThickeningSubspace_selfChart (n : ℕ) :
    definingIdealAt B (Spec (.of A)) hA
        (yonedaSpace B (Spec (.of A)) hA (baseObject A B hA))
        (adicThickeningSubspace A I B hA 𝒜 n)
        (op (selfChart B (Spec (.of A)) hA (baseObject A B hA))) =
      Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom I ^ (n + 1) := by
  have h := definingIdealAt_range_eq_ker B (Spec (.of A)) hA
    (yonedaSpace B (Spec (.of A)) hA (baseObject A B hA))
    (yoneda.map (adicThickeningMap A I B hA 𝒜 n))
    (isAlgebraicSpace_yoneda B (Spec (.of A)) hA _)
    (isClosedImmersion_yoneda_map_adicThickeningMap A I B hA n)
    (selfChart B (Spec (.of A)) hA (baseObject A B hA))
    (adicThickeningMap A I B hA 𝒜 n) (𝟙 _)
    (by
      have : IsIso (selfChart B (Spec (.of A)) hA (baseObject A B hA)).1.hom :=
        inferInstanceAs (IsIso (𝟙 (yoneda.obj (baseObject A B hA))))
      exact IsPullback.of_horiz_isIso ⟨by simp [selfChart]⟩)
  refine h.trans ?_
  show RingHom.ker (adicThickeningι A I n).appTop.hom = _
  rw [adicThickeningι, Stacks.Smooth.ker_specMap_appTop]
  simp only [CommRingCat.hom_ofHom, Ideal.mk_ker]
  let e := (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv
  show Ideal.comap e (I ^ (n + 1)) = Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom I ^ (n + 1)
  rw [← Ideal.map_pow, ← Ideal.map_symm e]
  rfl

variable {X : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u}
  (hX : IsAlgebraicSpace B (Spec (.of A)) hA X) (f : X ⟶ yoneda.obj (baseObject A B hA))

/-- The inclusion `ι_n : X_n ⟶ X` of the `n`-th adic fibre, as a morphism of algebraic spaces. -/
abbrev adicFibreFstHom (n : ℕ) :
    adicFibreSpace A I B hA hX f n ⟶ (⟨X, hX⟩ : AlgebraicSpaces B (Spec (.of A)) hA) :=
  adicFibreFst A I B hA hX f n

/-- `ι_n` is a monomorphism, being a base change of the closed immersion of the adic
thickening. -/
theorem mono_adicFibreFst (n : ℕ) :
    Mono (pullback.fst f
      (yoneda.map (adicThickeningMap A I B hA 𝒜 n))) := by
  have := mono_of_isClosedImmersion B (Spec (.of A)) hA _
    (isClosedImmersion_yoneda_map_adicThickeningMap A I B hA n)
  exact (IsPullback.of_hasPullback f _).mono_fst_of_mono

/-- **The kernel ideal sheaf of `ι_n` is the defining ideal sheaf of the inverse image of the
adic thickening.** -/
theorem kernelIdealSheaf_adicFibreFstHom (n : ℕ) :
    kernelIdealSheaf B (Spec (.of A)) hA (adicFibreFstHom A I B hA hX f n) =
      definingIdealSheaf B (Spec (.of A)) hA ⟨X, hX⟩
        (adicFibreSubspace A I B hA 𝒜 ⟨X, hX⟩ f n) := by
  have := mono_adicFibreFst A I B hA f n
  let R := Subfunctor.range (pullback.fst f
    (yoneda.map (adicThickeningMap A I B hA 𝒜 n)))
  have hR : R = (adicFibreSubspace A I B hA 𝒜 ⟨X, hX⟩ f n).1 :=
    range_adicFibre_fst A I B hA 𝒜 f n
  have hRsp : IsAlgebraicSpace B (Spec (.of A)) hA R.toFunctor := by
    rw [hR]; exact (adicFibreSubspace A I B hA 𝒜 ⟨X, hX⟩ f n).2.1
  let e : adicFibreSpace A I B hA hX f n ⟶ (⟨R.toFunctor, hRsp⟩ : AlgebraicSpaces B _ hA) :=
    ObjectProperty.homMk (Subfunctor.toRange _)
  have : IsIso e := by
    have : IsIso (Subfunctor.toRange (pullback.fst f
      (yoneda.map (adicThickeningMap A I B hA 𝒜 n)))) :=
      inferInstance
    have : IsIso ((ObjectProperty.ι
        (fun F : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u =>
          IsAlgebraicSpace B (Spec (.of A)) hA F)).map e) :=
      inferInstanceAs (IsIso (Subfunctor.toRange _))
    exact (ObjectProperty.fullyFaithfulι _).isIso_of_isIso_map e
  have hfac : adicFibreFstHom A I B hA hX f n =
      e ≫ (ObjectProperty.homMk R.ι : (⟨R.toFunctor, hRsp⟩ : AlgebraicSpaces B _ hA) ⟶ ⟨X, hX⟩) :=
    ObjectProperty.hom_ext _ (Subfunctor.toRange_ι _).symm
  rw [hfac, kernelIdealSheaf_comp_of_isIso]
  have key : ∀ (Z : ClosedSubspaces B (Spec (.of A)) hA X)
      (hZ : Z = adicFibreSubspace A I B hA 𝒜 ⟨X, hX⟩ f n),
      kernelIdealSheaf B (Spec (.of A)) hA
          (ObjectProperty.homMk Z.1.ι :
            (⟨Z.1.toFunctor, Z.2.1⟩ : AlgebraicSpaces B _ hA) ⟶ ⟨X, hX⟩) =
        definingIdealSheaf B (Spec (.of A)) hA ⟨X, hX⟩
          (adicFibreSubspace A I B hA 𝒜 ⟨X, hX⟩ f n) := by
    rintro Z rfl
    exact kernelIdealSheaf_eq_definingIdealSheaf B (Spec (.of A)) hA ⟨X, hX⟩ _
  exact key ⟨R, hR ▸ (adicFibreSubspace A I B hA 𝒜 ⟨X, hX⟩ f n).2⟩
    (Subtype.ext hR)

/-- The morphism of the site from the scheme of an étale chart of `X` to `Spec A`. -/
abbrev chartToBaseObject (V : SmallEtale B (Spec (.of A)) hA X) :
    V.1.left ⟶ (selfChart B (Spec (.of A)) hA (baseObject A B hA)).1.left :=
  Over.homMk V.1.left.hom

/-- **The kernel ideal of `ι_n` on an affine étale chart.** On an affine étale chart `V` of `X`,
the sections of the kernel ideal sheaf of `ι_n : X_n ⟶ X` are the ideal generated by the image
of `I ^ (n + 1)` under pullback of functions along `V ⟶ Spec A`. -/
theorem kernelIdealSheaf_adicFibreFstHom_obj_of_isAffine (n : ℕ)
    (V : SmallEtale B (Spec (.of A)) hA X)
    [IsAffine ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj V.1.left)] :
    (kernelIdealSheaf B (Spec (.of A)) hA (adicFibreFstHom A I B hA hX f n)).obj (op V) =
      Ideal.map ((BigFppfOver.toScheme B (Spec (.of A)) hA).map
          (chartToBaseObject A B hA V)).appTop.hom
        (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom I ^ (n + 1)) := by
  rw [kernelIdealSheaf_adicFibreFstHom, definingIdealSheaf_obj]
  have : IsAffine ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj
      (selfChart B (Spec (.of A)) hA (baseObject A B hA)).1.left) :=
    inferInstanceAs (IsAffine (Spec (.of A)))
  have h := definingIdealAt_preimage_eq_map B (Spec (.of A)) hA
    (Y := ⟨X, hX⟩) (X := yonedaSpace B (Spec (.of A)) hA (baseObject A B hA))
    (ObjectProperty.homMk f) (adicThickeningSubspace A I B hA 𝒜 n)
    (selfChart B (Spec (.of A)) hA (baseObject A B hA)) V (chartToBaseObject A B hA V)
    (by ext W s; exact Limits.IsTerminal.hom_ext Over.mkIdTerminal _ _)
  refine h.trans ?_
  rw [definingIdealAt_adicThickeningSubspace_selfChart]
  rfl

end AlgebraicGeometry.Space

end
