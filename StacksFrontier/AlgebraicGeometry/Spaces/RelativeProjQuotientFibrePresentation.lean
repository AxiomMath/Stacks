module

public import StacksFrontier.AlgebraicGeometry.QuasicoherentBasicOpen.LocalSections
public import StacksFrontier.AlgebraicGeometry.RelativeProjGradedIdeal.DegreeQuotientKernel
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjDegreeIdealQuotientProj

/-!
# The fibre of `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` over a scheme point, as a presentation of Tag 0802

In Situation 0849 let `ℐ ⊆ 𝒜` be a graded ideal with quasi-coherent pieces and let `f : T ⟶ X`
be a scheme point of the base.  By
`AlgebraicGeometry.Space.RelativeProjSituation.isPullback_quotientFibreMap` the fibre of the
closed immersion `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` over `f` is the scheme-level morphism `r_ψ` of
Stacks 07ZG for the restriction `ψ : f^*𝒜 ⟶ f^*(𝒜/ℐ)` of the quotient homomorphism.  This file
identifies it with the closed subscheme of any presentation `Z_T = Proj_T(f^*𝒜/𝒢(f^*𝒜))` of
Tag 0802 (`…RelativeProjGradedIdeal.DegreeQuotientPresentation`), as soon as the kernel of `ψ` is
the graded ideal `𝒢(f^*𝒜)` generated by `𝒢 ⊆ (f^*𝒜)_d`.

This is the form in which the chart case of Stacks 0803 and the sandwich
`…RelativeProjGradedIdeal.degreeQuotientPresentation_of_le_twistKer` feed the descent
`AlgebraicGeometry.Space.RelativeProjSituation.range_eq_range_quotientProjHom_of_fibre` in the
proof of clause (a) of Stacks 085N: the left-hand side of the hypothesis of that descent is the
range of the base change of the closed subspace `Z` to the fibre over `w`, and the conclusion
below is its right-hand side.

## Main results

* `…RelativeProjGradedIdeal.surjectiveOnAffineSections_of_epi`: a degreewise epimorphism of
  sheaf-level graded algebras is surjective on homogeneous sections over the affine opens.
* `AlgebraicGeometry.Space.range_yoneda_map_eq_of_ker_eq`: two morphisms of the big fppf
  category over `S` whose underlying morphisms of schemes become closed immersions with one ideal
  sheaf after an isomorphism of the common target have the same range as subfunctors.
* `AlgebraicGeometry.Space.RelativeProjSituation.range_eq_range_quotientFibreMap`: **the fibre
  of `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` over `f` is the closed subscheme of every presentation of Tag 0802
  by a submodule `𝒢` generating the kernel of `f^*𝒜 ⟶ f^*(𝒜/ℐ)`.**

## References

* [Stacks Project, Tag 085N](https://stacks.math.columbia.edu/tag/085N)
* [Stacks Project, Tag 0802](https://stacks.math.columbia.edu/tag/0802)
* [Stacks Project, Tag 07ZG](https://stacks.math.columbia.edu/tag/07ZG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AlgebraicGeometry.RelativeProjMapDomain
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.Tag07ZGMorphism

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

/-- **A degreewise epimorphism of sheaf-level graded algebras is surjective on the homogeneous
sections over every affine open**, the pieces being quasi-coherent. -/
theorem surjectiveOnAffineSections_of_epi {S : _root_.AlgebraicGeometry.Scheme.{u}}
    {A B : SheafGradedAlgebra S} (ψ : SheafGradedAlgebraHom A B)
    (h : ∀ n : ℕ, Epi (ψ.app (n : ℤ))) :
    ProjBundleSurjection.SurjectiveOnAffineSections ψ := fun _ hU n =>
  have := h n
  _root_.AlgebraicGeometry.surjective_app_of_epi_of_isAffineOpen (ψ.app (n : ℤ)) hU

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **Two closed subschemes of an object of the big fppf category with one ideal sheaf have the
same range as subfunctors.**  Let `j₁ : Y₁ ⟶ P` and `j₂ : Y₂ ⟶ P` be morphisms over `S` and
`e : P ⟶ E` an isomorphism of schemes with `j₁ ≫ e`, `j₂ ≫ e` closed immersions of the same ideal
sheaf.  The isomorphism `Y₁ ≅ Y₂` over `E` of `…KerChart.isoOfKerEq` lies over `S`, so it is an
isomorphism of the big fppf category over `P`, and the two ranges agree. -/
theorem range_yoneda_map_eq_of_ker_eq {Y₁ Y₂ P : BigFppfOver B S hS} (j₁ : Y₁ ⟶ P)
    (j₂ : Y₂ ⟶ P) {E : Scheme.{u}} (e : (BigFppfOver.toScheme B S hS).obj P ⟶ E) [IsIso e]
    [_root_.AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map j₁ ≫ e)]
    [_root_.AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map j₂ ≫ e)]
    (h : ((BigFppfOver.toScheme B S hS).map j₁ ≫ e).ker =
      ((BigFppfOver.toScheme B S hS).map j₂ ≫ e).ker) :
    Subfunctor.range (yoneda.map j₁) = Subfunctor.range (yoneda.map j₂) := by
  let I := Stacks.AlgebraicGeometry.KerChart.isoOfKerEq _ _ h
  have hI : I.hom ≫ (BigFppfOver.toScheme B S hS).map j₁ =
      (BigFppfOver.toScheme B S hS).map j₂ :=
    (cancel_mono e).1 ((Category.assoc _ _ _).trans
      (Stacks.AlgebraicGeometry.KerChart.isoOfKerEq_hom_comp _ _ h))
  have hI' : I.inv ≫ (BigFppfOver.toScheme B S hS).map j₂ =
      (BigFppfOver.toScheme B S hS).map j₁ := by
    rw [← hI, Iso.inv_hom_id_assoc]
  -- a scheme morphism over `P` lifts to the big fppf category over `S`, giving a range inclusion
  have key : ∀ {Z₁ Z₂ : BigFppfOver B S hS} (k₁ : Z₁ ⟶ P) (k₂ : Z₂ ⟶ P)
      (a : (BigFppfOver.toScheme B S hS).obj Z₂ ⟶ (BigFppfOver.toScheme B S hS).obj Z₁),
      a ≫ (BigFppfOver.toScheme B S hS).map k₁ = (BigFppfOver.toScheme B S hS).map k₂ →
      Subfunctor.range (yoneda.map k₂) ≤ Subfunctor.range (yoneda.map k₁) := by
    intro Z₁ Z₂ k₁ k₂ a ha
    have hw : (ObjectProperty.homMk a : Z₂.left ⟶ Z₁.left) ≫ Z₁.hom = Z₂.hom := by
      apply ObjectProperty.hom_ext
      have h1 := congrArg (fun φ => φ.hom) (Over.w k₁)
      have h2 := congrArg (fun φ => φ.hom) (Over.w k₂)
      change a ≫ Z₁.hom.hom = Z₂.hom.hom
      rw [← h1, ← h2]
      change a ≫ k₁.left.hom ≫ P.hom.hom = k₂.left.hom ≫ P.hom.hom
      rw [← Category.assoc]
      exact congrArg (· ≫ P.hom.hom) ha
    obtain ⟨b, hb⟩ : ∃ b : Z₂ ⟶ Z₁, b ≫ k₁ = k₂ :=
      ⟨Over.homMk (ObjectProperty.homMk a) hw,
        Over.OverMorphism.ext (ObjectProperty.hom_ext _ ha)⟩
    rintro V x ⟨g, rfl⟩
    exact ⟨g ≫ b, by
      change (g ≫ b) ≫ k₁ = g ≫ k₂
      rw [Category.assoc, hb]⟩
  exact le_antisymm (key j₂ j₁ I.inv hI') (key j₁ j₂ I.hom hI)

namespace RelativeProjSituation

variable (s : RelativeProjSituation.{u, u}) (ℐ : s.MulStableGradedSubmodule)
  (hℐ : ∀ n : ℤ, (ℐ.piece n).toSheafOfModules.IsQuasicoherentOnSite)

/-- The restriction `f^*𝒜 ⟶ f^*(𝒜/ℐ)` of the quotient homomorphism is surjective on homogeneous
sections over the affine opens of `T`. -/
theorem surjectiveOnAffineSections_quotientHomPoints_hom
    (T : BigFppfOver s.site s.base s.containsBase) (f : yoneda.obj T ⟶ s.space.1) :
    Stacks.AlgebraicGeometry.ProjBundleSurjection.SurjectiveOnAffineSections
      ((s.quotientHomPoints ℐ hℐ).hom T f) :=
  Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.surjectiveOnAffineSections_of_epi _
    fun n => s.epi_quotientHomPoints_hom_app ℐ hℐ T f n

/-- **The fibre of `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` over a scheme point `f : T ⟶ X` is the closed
subscheme of every presentation of Tag 0802 by a submodule generating the kernel of the
restricted quotient homomorphism.**

Let `j : Y ⟶ T ×_X Proj_X(𝒜)` be a morphism of the site whose reading `Y ⟶ Proj_T(f^*𝒜)` through
Stacks 084B (2) is presented, by `p`, as `Proj_T(f^*𝒜/𝒢(f^*𝒜))` for a quasi-coherent
`𝒢 ⊆ (f^*𝒜)_d`, and suppose the kernel of `f^*𝒜 ⟶ f^*(𝒜/ℐ)` is the graded ideal generated by
`𝒢`.  Then `j` and the fibre `T ×_X Proj_X(𝒜/ℐ) ⟶ T ×_X Proj_X(𝒜)` of the closed immersion
`Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` have the same range.

Both readings in `Proj_T(f^*𝒜)` are closed immersions with the ideal sheaf of `r_ψ`
(`…RelativeProjGradedIdeal.DegreeQuotientPresentation.ker_eq_ker_relativeMapHom`), the fibre by
`AlgebraicGeometry.Space.RelativeProjSituation.isPullback_quotientFibreMap`. -/
theorem range_eq_range_quotientFibreMap (T : BigFppfOver s.site s.base s.containsBase)
    (f : yoneda.obj T ⟶ s.space.1) {Y : BigFppfOver s.site s.base s.containsBase}
    (j : Y ⟶ s.relativeProjPoints.fibre T f)
    [_root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme s.site s.base s.containsBase).map j ≫
        (s.relativeProjPoints.fibreIso T f).hom)]
    {d : ℕ} {𝒢 : ((s.shrink.pointAlgebra T f).piece (d : ℤ)).Submodule}
    (h𝒢 : ((𝒢.toSheafOfModules : ((BigFppfOver.toScheme s.site s.base s.containsBase).obj
      T).Modules)).IsQuasicoherent)
    (p : Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.DegreeQuotientPresentation
      (s.shrink.pointAlgebra T f)
      ((BigFppfOver.toScheme s.site s.base s.containsBase).map j ≫
        (s.relativeProjPoints.fibreIso T f).hom) 𝒢)
    (hk : Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.IsQuotientByDegreeSubmodule
      (s.shrink.pointAlgebra T f) 𝒢 ((s.quotientHomPoints ℐ hℐ).hom T f)) :
    Subfunctor.range (yoneda.map j) =
      Subfunctor.range (yoneda.map (s.quotientFibreMap ℐ hℐ T f)) := by
  obtain ⟨-, -, hdom, hrel, hci⟩ := s.isPullback_quotientFibreMap ℐ hℐ T f
  have hψ := s.surjectiveOnAffineSections_quotientHomPoints_hom ℐ hℐ T f
  have : IsIso ((s.quotientHomPoints ℐ hℐ).hom T f).relativeMapDomain.ι := by
    rw [hdom, ← Scheme.topIso_hom]
    infer_instance
  have : _root_.AlgebraicGeometry.IsClosedImmersion
      (relativeMapHom ((s.quotientHomPoints ℐ hℐ).hom T f)) := hci
  have hq : (BigFppfOver.toScheme s.site s.base s.containsBase).map
        (s.quotientFibreMap ℐ hℐ T f) ≫ (s.relativeProjPoints.fibreIso T f).hom =
      inv (((s.quotientHomPoints ℐ hℐ).hom T f).relativeMapDomain.ι ≫
          ((s.quotient ℐ hℐ).relativeProjPoints.fibreIso T f).inv) ≫
        relativeMapHom ((s.quotientHomPoints ℐ hℐ).hom T f) := by
    rw [IsIso.eq_inv_comp]
    exact (Category.assoc _ _ _).trans hrel
  have : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme s.site s.base s.containsBase).map
        (s.quotientFibreMap ℐ hℐ T f) ≫ (s.relativeProjPoints.fibreIso T f).hom) := by
    rw [hq]
    infer_instance
  refine range_yoneda_map_eq_of_ker_eq j (s.quotientFibreMap ℐ hℐ T f)
    (s.relativeProjPoints.fibreIso T f).hom ?_
  have h1 : ((BigFppfOver.toScheme s.site s.base s.containsBase).map
        (s.quotientFibreMap ℐ hℐ T f) ≫ (s.relativeProjPoints.fibreIso T f).hom).ker =
      (relativeMapHom ((s.quotientHomPoints ℐ hℐ).hom T f)).ker := by
    rw [hq]
    exact Scheme.Hom.ker_comp_of_isIso _ _
  have : _root_.AlgebraicGeometry.QuasiCompact
      (relativeMapHom ((s.quotientHomPoints ℐ hℐ).hom T f)) := inferInstance
  exact (p.ker_eq_ker_relativeMapHom _ h𝒢 hk hψ (hqcψ := this)).trans h1.symm

end RelativeProjSituation

end AlgebraicGeometry.Space

end
