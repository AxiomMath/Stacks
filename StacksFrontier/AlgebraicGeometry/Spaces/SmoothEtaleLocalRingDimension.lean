module

public import Mathlib.RingTheory.Jacobson.Ideal
public import StacksFrontier.AlgebraicGeometry.Spaces.CohenMacaulay.Source
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleLocalRingNoetherian
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeProperties
public import StacksFrontier.AlgebraicGeometry.Spaces.LocallyNoetherianFiniteType
public import StacksFrontier.AlgebraicGeometry.Spaces.SmoothFlat
public import StacksFrontier.RingTheory.RegularLocalRing.FlatLocalHom

/-!
# The dimension formula along a flat or smooth morphism of algebraic spaces

Let `f : X ⟶ Y` be a morphism of algebraic spaces over `S` and let `x` be a geometric point of
`X`. The induced homomorphism of étale local rings
`𝒪_{Y, f(x̄)} ⟶ 𝒪_{X, x̄}` of Stacks 04NG is a local homomorphism; when `f` is flat it is flat,
and when both local rings are Noetherian the dimension formula of Stacks 00ON reads

`dim(𝒪_{X, x̄}) = dim(𝒪_{Y, f(x̄)}) + dim(𝒪_{X_{f(x̄)}, x̄})`,

the last term being the dimension of the closed fibre of that homomorphism.

This is the same computation that
`AlgebraicGeometry.Stack.ringKrullDim_relation_eq_add_ringKrullDim_sourceFibre` performs for the
source projection of a presented self-intersection, stated for an arbitrary morphism of
algebraic spaces instead. It is the first of the three dimension identities that the comparison
of two smooth charts in **Stacks 0DS9** runs on: with `h : U' ⟶ U` a smooth morphism of
neighbourhoods over an algebraic stack it is

`dim(𝒪_{U', ū'}) = dim(𝒪_{U, ū}) + dim(𝒪_{U'_u, ū'})`.

## Main definitions

* `AlgebraicGeometry.Space.closedFibreEtaleLocalRing`: the local ring `𝒪_{X_{f(x̄)}, x̄}` of the
  fibre of `f` through `x`, presented as the closed fibre of `𝒪_{Y, f(x̄)} ⟶ 𝒪_{X, x̄}`.

## Main results

* `AlgebraicGeometry.Space.ringKrullDim_etaleLocalRing_eq_add_closedFibre_of_isFlat`: the
  dimension formula for a flat morphism between algebraic spaces whose étale local rings at the
  two points are Noetherian.
* `AlgebraicGeometry.Space.ringKrullDim_etaleLocalRing_eq_add_closedFibre_of_isSmooth`: the
  dimension formula for a smooth morphism with locally Noetherian target, where Noetherianity of
  the source is automatic by Stacks 04ZK.

## Implementation notes

The local rings are the étale local rings `AlgebraicGeometry.Space.etaleLocalRing` at geometric
points, the strictly henselian rings of Stacks 04KG, which is what `𝒪_{X, x̄}` means in the
source.

No hypothesis of closedness is made on the points, and none is needed: the input is flatness of
`f`, which holds at every point. The closedness that **Stacks 0DS9** does need enters only at its
third dimension identity, not here.

The fibre's local ring is presented as the quotient of `𝒪_{X, x̄}` by the ideal generated by the
image of the maximal ideal of `𝒪_{Y, f(x̄)}`, written with `Ideal.jacobson` of `⊥` so that no
`IsLocalRing` instance is needed to state it; the two agree by
`IsLocalRing.jacobson_eq_maximalIdeal`. This is the same presentation as
`AlgebraicGeometry.Stack.sourceFibreEtaleLocalRing`.

## References

* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON)
* [Stacks Project, Tag 04NG](https://stacks.math.columbia.edu/tag/04NG)
* [Stacks Project, Tag 04TA](https://stacks.math.columbia.edu/tag/04TA)
* [Stacks Project, Tag 04ZK](https://stacks.math.columbia.edu/tag/04ZK)
* [Stacks Project, Tag 06MH](https://stacks.math.columbia.edu/tag/06MH)
* [Stacks Project, Tag 0DS9](https://stacks.math.columbia.edu/tag/0DS9)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- The étale local ring `𝒪_{X_{f(x̄)}, x̄}` of the fibre of `f : X ⟶ Y` through a geometric
point `x̄` of `X`, as the closed fibre of `𝒪_{Y, f(x̄)} ⟶ 𝒪_{X, x̄}`: the quotient of `𝒪_{X, x̄}`
by the ideal generated by the image of the maximal ideal of `𝒪_{Y, f(x̄)}`. -/
noncomputable abbrev closedFibreEtaleLocalRing (hX : IsAlgebraicSpace B S hS X) (f : X ⟶ Y)
    (x : GeometricPoint B S hS X) : Type (u + 1) :=
  etaleLocalRing B S hS X x ⧸
    Ideal.map (etaleLocalRingMap hX f x)
      (⊥ : Ideal (etaleLocalRing B S hS Y (geometricPointMap f x))).jacobson

/-- **The dimension formula along a flat morphism of algebraic spaces.** If `f : X ⟶ Y` is flat
and the étale local rings of `Y` at `f(x̄)` and of `X` at `x̄` are Noetherian, then

`dim(𝒪_{X, x̄}) = dim(𝒪_{Y, f(x̄)}) + dim(𝒪_{X_{f(x̄)}, x̄})`.

The homomorphism `𝒪_{Y, f(x̄)} ⟶ 𝒪_{X, x̄}` of Stacks 04NG is a flat local homomorphism of
Noetherian local rings, so Stacks 00ON applies. -/
theorem ringKrullDim_etaleLocalRing_eq_add_closedFibre_of_isFlat
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (hf : IsFlat B S hS f) (x : GeometricPoint B S hS X)
    (hNX : IsNoetherianRing (etaleLocalRing B S hS X x))
    (hNY : IsNoetherianRing (etaleLocalRing B S hS Y (geometricPointMap f x))) :
    ringKrullDim (etaleLocalRing B S hS X x) =
      ringKrullDim (etaleLocalRing B S hS Y (geometricPointMap f x)) +
        ringKrullDim (closedFibreEtaleLocalRing B S hS hX f x) := by
  let : IsLocalRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    isLocalRing_etaleLocalRing B S hS Y hY _
  let : IsLocalRing (etaleLocalRing B S hS X x) := isLocalRing_etaleLocalRing B S hS X hX x
  let : IsNoetherianRing (etaleLocalRing B S hS Y (geometricPointMap f x)) := hNY
  let : IsNoetherianRing (etaleLocalRing B S hS X x) := hNX
  let : Algebra (etaleLocalRing B S hS Y (geometricPointMap f x))
      (etaleLocalRing B S hS X x) := (etaleLocalRingMap hX f x).toAlgebra
  let : IsLocalHom (algebraMap (etaleLocalRing B S hS Y (geometricPointMap f x))
      (etaleLocalRing B S hS X x)) := isLocalHom_etaleLocalRingMap B S hS hX hY f x
  have hflat : Module.Flat (etaleLocalRing B S hS Y (geometricPointMap f x))
      (etaleLocalRing B S hS X x) :=
    flat_etaleLocalRingMap B S hS hX hY f hf x
  have hjac : (⊥ : Ideal (etaleLocalRing B S hS Y (geometricPointMap f x))).jacobson =
      IsLocalRing.maximalIdeal (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top
  change ringKrullDim (etaleLocalRing B S hS X x) =
    ringKrullDim (etaleLocalRing B S hS Y (geometricPointMap f x)) +
      ringKrullDim (etaleLocalRing B S hS X x ⧸
        Ideal.map (etaleLocalRingMap hX f x)
          (⊥ : Ideal (etaleLocalRing B S hS Y (geometricPointMap f x))).jacobson)
  rw [hjac]
  exact ringKrullDim_eq_add_ringKrullDim_closedFibre _ _ hflat

/-- **The dimension formula along a smooth morphism of algebraic spaces.** If `f : X ⟶ Y` is
smooth and `Y` is locally Noetherian, then

`dim(𝒪_{X, x̄}) = dim(𝒪_{Y, f(x̄)}) + dim(𝒪_{X_{f(x̄)}, x̄})`.

A smooth morphism is flat (Stacks 04TA) and locally of finite type (Stacks 06MH), so `X` is
locally Noetherian too by Stacks 04ZK and
`AlgebraicGeometry.Space.ringKrullDim_etaleLocalRing_eq_add_closedFibre_of_isFlat` applies.

This is the first of the three dimension identities comparing two smooth charts in
**Stacks 0DS9**; it needs no closedness of either point. -/
theorem ringKrullDim_etaleLocalRing_eq_add_closedFibre_of_isSmooth
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (hf : IsSmooth B S hS f)
    (hN : HasEtaleLocalProperty B S hS Y (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (x : GeometricPoint B S hS X) :
    ringKrullDim (etaleLocalRing B S hS X x) =
      ringKrullDim (etaleLocalRing B S hS Y (geometricPointMap f x)) +
        ringKrullDim (closedFibreEtaleLocalRing B S hS hX f x) := by
  have hNX : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T) :=
    isLocallyNoetherian_of_isLocallyOfFiniteType B S hS hX hY f
      (isLocallyOfFiniteType_of_isSmooth B S hS hf) hN
  exact ringKrullDim_etaleLocalRing_eq_add_closedFibre_of_isFlat B S hS hX hY f
    (isFlat_of_isSmooth B S hS f hf) x
    (isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian B S hS X hX hNX x)
    (isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian B S hS Y hY hN _)

end AlgebraicGeometry.Space

end
