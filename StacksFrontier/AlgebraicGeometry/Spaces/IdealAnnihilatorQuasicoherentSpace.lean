/-!
# Quasi-coherence of the annihilator subsheaf on an algebraic space

Let `F` be an algebraic space, `I ⊆ 𝒪_F` a quasi-coherent sheaf of ideals *of finite type* and
`G` a quasi-coherent `𝒪_F`-module.  Then the subsheaf of sections annihilated by `I` is again
quasi-coherent.

This is part (1) of [Stacks, Tag 0856].

## Main results

* `AlgebraicGeometry.Space.isQuasicoherentOnSite_annihilatorSubmodule`: the annihilator
  subsheaf is quasi-coherent.
* `AlgebraicGeometry.Space.isCartesianOnAffineCharts_annihilatorSubmodule`: its sections over a
  smaller affine chart are the base change of its sections over a larger one.

## Implementation notes

The criterion used is Stacks 03DX(2),
`AlgebraicGeometry.Space.isQuasicoherentOnSite_of_isCartesianOnAffineCharts`: it suffices that
for affine étale charts `V → U` the comparison `𝒪_F(V) ⊗_{𝒪_F(U)} G'(U) → G'(V)` is bijective.

Fix such a pair.  Over the affine chart `U` the ideal `I(U)` is a *finitely generated* ideal of
`𝒪_F(U)`, by `AlgebraicGeometry.Space.module_finite_sections_of_isFiniteTypeOnSite`; this is the
only place the finite-type hypothesis is used.  Choosing generators `g 0, …, g (n-1)`, part (2) of
the tag (`AlgebraicGeometry.Space.mem_annihilatorSubmodule_obj_of_isAffine`) identifies `G'(U)`
with the kernel of the single map `G(U) → (Fin n → G(U))`, `m ↦ (g i • m)`.  Since `I` is cartesian
on affine charts the restrictions of the `g i` generate `I(V)`, so the same description holds over
`V` with the restricted generators.  The restriction map `𝒪_F(U) → 𝒪_F(V)` is flat
(`AlgebraicGeometry.Space.moduleFlat_chartRing_of_isAffine`, étale morphisms being flat), and flat
base change carries a kernel of a map into a finite product to the corresponding kernel. That last
step is `AlgebraicGeometry.Space.bijective_baseChange_of_exact` (the kernel clause of Stacks
03M1(3)) together with the identification of the base change of a finite product.

## References

* [Stacks Project, Tag 0856](https://stacks.math.columbia.edu/tag/0856)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

open scoped TensorProduct

universe u

namespace AlgebraicGeometry.Space

/-! ### The commutative-algebra step -/

/-- **The annihilator of a finitely generated ideal is a kernel.**  If `N ⊆ M` is the submodule
of elements annihilated by an ideal `J` generated by `g 0, …, g (n-1)`, then `N → M` is exact at
`M` against the single map `m ↦ (g i • m)` into the `n`-fold product. -/
theorem exact_subtype_pi_lsmul {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {n : ℕ} {g : Fin n → R} {J : Ideal R} (hJ : Submodule.span R (Set.range g) = J)
    (N : Submodule R M) (hN : ∀ m : M, m ∈ N ↔ ∀ a ∈ J, a • m = 0) :
    Function.Exact N.subtype (LinearMap.pi fun i => LinearMap.lsmul R M (g i)) := by
  refine fun m => ⟨fun hm => ⟨⟨m, (hN m).2 fun a ha => ?_⟩, rfl⟩, ?_⟩
  · have hle : J ≤ LinearMap.ker (LinearMap.toSpanSingleton R M m) := by
      rw [← hJ]
      refine Submodule.span_le.2 ?_
      rintro _ ⟨i, rfl⟩
      exact (by simpa using congrFun hm i : g i • m = 0)
    exact hle ha
  · rintro ⟨⟨x, hx⟩, rfl⟩
    funext i
    simpa using (hN x).1 hx (g i) (hJ ▸ Submodule.subset_span ⟨i, rfl⟩)

/-- **Flat base change of the annihilator of a finitely generated ideal.**  The shape of
`AlgebraicGeometry.Space.bijective_baseChange_of_exact` in which the right-hand term of the
exact sequence is the `n`-fold product of the middle one and the two maps are multiplication by
a finite family and by its image: the base change of a finite product is identified with the
product of the base changes. -/
theorem bijective_baseChange_pi
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] [Module.Flat R A]
    {K G : Type*} [AddCommGroup K] [Module R K] [AddCommGroup G] [Module R G]
    {K' G₁ : Type*} [AddCommGroup K'] [Module A K'] [AddCommGroup G₁] [Module A G₁]
    {n : ℕ} {g : Fin n → R}
    {ιU : K →ₗ[R] G} {ιV : K' →ₗ[A] G₁}
    {cK : TensorProduct R A K →ₗ[A] K'} {cG : TensorProduct R A G →ₗ[A] G₁}
    (hιU : Function.Injective ιU)
    (hexU : Function.Exact ιU (LinearMap.pi fun i => LinearMap.lsmul R G (g i)))
    (hιV : Function.Injective ιV)
    (hexV : Function.Exact ιV
      (LinearMap.pi fun i => LinearMap.lsmul A G₁ (algebraMap R A (g i))))
    (hsqK : ∀ z, ιV (cK z) = cG (LinearMap.lTensor A ιU z))
    (hcG : Function.Bijective cG) :
    Function.Bijective cK := by
  classical
  let eG : TensorProduct R A G ≃ₗ[A] G₁ := LinearEquiv.ofBijective cG hcG
  let e : TensorProduct R A (Fin n → G) ≃ₗ[A] (Fin n → G₁) :=
    (TensorProduct.piRight R A A (fun _ : Fin n => G)).trans
      (LinearEquiv.piCongrRight fun _ => eG)
  refine bijective_baseChange_of_exact (cG' := e.toLinearMap) hιU hexU hιV hexV hsqK ?_ hcG
    e.bijective
  intro z
  induction z with
  | zero => simp
  | tmul b m =>
      ext i
      show algebraMap R A (g i) • cG (b ⊗ₜ[R] m) = eG (b ⊗ₜ[R] (g i • m))
      rw [TensorProduct.tmul_smul, ← algebraMap_smul A (g i)]
      exact (map_smul cG _ _).symm
  | add x y hx hy => simp only [map_add, hx, hy]

/-! ### The geometric step -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

variable {B S hS F hF}
  {I : (SheafOfModules.unit
    (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS F hF).O)).Submodule}
  {G : Modules.{u, u} B S hS F hF}

/-- **The restrictions of a generating family of `I(U)` generate `I(V)`.**  For affine étale
charts `V → U` and `I` cartesian on affine charts, the sections of `I` over `V` are the ideal
generated by the restrictions of any generating family of the sections over `U`. -/
theorem span_range_algebraMap_eq_chartSectionIdeal
    (hI : IsCartesianOnAffineCharts I.toSheafOfModules) {U V : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (f : V ⟶ U) {n : ℕ} {g : Fin n → chartRing B S hS F hF U}
    (hg : Submodule.span (chartRing B S hS F hF U) (Set.range g) =
      chartSectionIdeal B S hS F hF I U) :
    letI := chartAlgebra (hF := hF) f
    Submodule.span (chartRing B S hS F hF V)
        (Set.range fun i => algebraMap (chartRing B S hS F hF U)
          (chartRing B S hS F hF V) (g i)) =
      chartSectionIdeal B S hS F hF I V := by
  let _ := chartAlgebra (hF := hF) f
  have h2 : Ideal.map (chartRestrict (hF := hF) f) (chartSectionIdeal B S hS F hF I U) =
      Submodule.span (chartRing B S hS F hF V)
        (Set.range fun i => chartRestrict (hF := hF) f (g i)) := by
    rw [← hg, Ideal.map_span, ← Set.range_comp]
    rfl
  exact h2.symm.trans (span_image_chartRestrictLinear_eq B S hS F hF _ I f (hI U V hU hV f).2)

/-- **The annihilator subsheaf is cartesian on affine charts.**  For `I` a quasi-coherent sheaf
of ideals of finite type and `G` a quasi-coherent `𝒪_F`-module, the sections of the subsheaf
annihilated by `I` over a smaller affine étale chart are the base change of its sections over a
larger one. -/
theorem isCartesianOnAffineCharts_annihilatorSubmodule
    (hI : I.toSheafOfModules.IsQuasicoherentOnSite)
    (hIft : SheafOfModules.IsFiniteTypeOnSite I.toSheafOfModules)
    (hG : G.IsQuasicoherentOnSite) :
    IsCartesianOnAffineCharts (annihilatorSubmodule B S hS F hF I G).toSheafOfModules := by
  classical
  intro U V hU hV f
  let _ := chartAlgebra (hF := hF) f
  have _ : Module.Flat (chartRing B S hS F hF U) (chartRing B S hS F hF V) :=
    moduleFlat_chartRing_of_isAffine f hU hV
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (Module.Finite.iff_fg.mp
      (module_finite_sections_of_isFiniteTypeOnSite I.toSheafOfModules hI hIft U hU) :
      (chartSectionIdeal B S hS F hF I U).FG)
  exact bijective_baseChange_pi (g := g) (Submodule.injective_subtype _)
    (exact_subtype_pi_lsmul hg _ (mem_annihilatorSubmodule_obj_of_isAffine hI (op U) hU))
    (Submodule.injective_subtype _)
    (exact_subtype_pi_lsmul (span_range_algebraMap_eq_chartSectionIdeal
        (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hI) hU hV f hg) _
      (mem_annihilatorSubmodule_obj_of_isAffine hI (op V) hV))
    (app_sectionsBaseChange (annihilatorSubmodule B S hS F hF I G).ι f)
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hG U V hU hV f)

/-- **The annihilator subsheaf is quasi-coherent.**  Let `F` be an algebraic space, `I ⊆ 𝒪_F` a
quasi-coherent sheaf of ideals of finite type and `G` a quasi-coherent `𝒪_F`-module.  The subsheaf
of sections of `G` annihilated by `I` is quasi-coherent. -/
@[stacks 0856 "part (1)"]
theorem isQuasicoherentOnSite_annihilatorSubmodule
    (hI : I.toSheafOfModules.IsQuasicoherentOnSite)
    (hIft : SheafOfModules.IsFiniteTypeOnSite I.toSheafOfModules)
    (hG : G.IsQuasicoherentOnSite) :
    (annihilatorSubmodule B S hS F hF I G).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_annihilatorSubmodule hI hIft hG)

end AlgebraicGeometry.Space

end
