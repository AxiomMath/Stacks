-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The primary component of a principal ideal -/

/-- Membership in the primary component of a principal ideal is annihilation by a power of its
generator. -/
private theorem mem_primaryComponent_span_singleton_iff {R : Type*} [CommRing R] (a s : R) :
    s ∈ Ideal.primaryComponent R (Ideal.span {a}) ↔ ∃ n : ℕ, a ^ n * s = 0 := by
  rw [Ideal.primaryComponent_mem]
  refine ⟨fun ⟨n, hn⟩ => ⟨n, ?_⟩, fun ⟨n, hn⟩ => ⟨n, ?_⟩⟩
  · rw [Submodule.mem_torsionBySet_iff] at hn
    have h := hn ⟨a ^ n, by
      rw [SetLike.mem_coe, Ideal.span_singleton_pow]
      exact Ideal.mem_span_singleton_self _⟩
    rwa [smul_eq_mul] at h
  · rw [Submodule.mem_torsionBySet_iff]
    intro c
    have hc : (c : R) ∈ Ideal.span {a ^ n} := by
      rw [← Ideal.span_singleton_pow]
      exact c.2
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp hc
    rw [smul_eq_mul, hd, mul_comm (a ^ n) d, mul_assoc, hn, mul_zero]

/-- The image of `a` under a surjective ring map whose kernel is the `a`-power torsion is a
nonzerodivisor. -/
theorem isRegular_map_of_ker_eq_torsion {R R' : Type*} [CommRing R] [CommRing R']
    (φ : R →+* R') (hφ : Function.Surjective φ) (a : R)
    (h : ∀ s, s ∈ RingHom.ker φ ↔ ∃ n : ℕ, a ^ n * s = 0) : IsRegular (φ a) := by
  have hcancel : ∀ t, φ a * t = 0 → t = 0 := by
    intro t ht
    obtain ⟨s, rfl⟩ := hφ t
    obtain ⟨n, hn⟩ := (h (a * s)).1 (by rwa [RingHom.mem_ker, map_mul])
    exact RingHom.mem_ker.mp ((h s).2 ⟨n + 1, by rwa [pow_succ, mul_assoc]⟩)
  refine (Commute.isRegular_iff fun b => Commute.all _ b).2 fun t₁ t₂ h => ?_
  exact sub_eq_zero.mp (hcancel (t₁ - t₂) (by rw [mul_sub, show φ a * t₁ = φ a * t₂ from h,
    sub_self]))

/-! ### The general statement -/

/-- On an affine étale chart carrying a generator `a` of the defining ideal of `T`, the defining
ideal of a closed subspace cut out by the sections supported on `|T|` is the `a`-power torsion. -/
theorem mem_definingIdealAt_iff_exists_pow_mul_eq_zero
    (W : AlgebraicSpaces B S hS) (T W' : ClosedSubspaces B S hS W.1)
    (hW' : definingIdealSheaf B S hS W W' =
      supportedSectionsSubmodule B S hS W.1 W.2
        (Set.range (pointsMap B S hS T.1.toFunctor T.1.ι))
        (SheafOfModules.unit (structureRingSheaf B S hS W)))
    (V : SmallEtale B S hS W.1) (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left))
    (a : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤))
    (ha : definingIdealAt B S hS W T (op V) = Ideal.span {a})
    (s : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤)) :
    s ∈ definingIdealAt B S hS W W' (op V) ↔ ∃ n : ℕ, a ^ n * s = 0 := by
  have h : definingIdealAt B S hS W W' (op V) =
      (supportedSectionsSubmodule B S hS W.1 W.2
        (Set.range (pointsMap B S hS T.1.toFunctor T.1.ι))
        (SheafOfModules.unit (structureRingSheaf B S hS W))).toSubmodule.obj (op V) :=
    congrArg (fun N : (SheafOfModules.unit (structureRingSheaf B S hS W)).Submodule =>
      N.toSubmodule.obj (op V)) hW'
  rw [h]
  exact (mem_supportedSectionsSubmodule_iff_mem_primaryComponent B S hS W T
    (SheafOfModules.unit (structureRingSheaf B S hS W))
    (SheafOfModules.isQuasicoherentOnSite_unit _) V hV a ha s).trans
    (mem_primaryComponent_span_singleton_iff a s)

/-- **The inverse image of a locally principal closed subspace on the closed subspace cut out by
its supported sections is an effective Cartier divisor.**  Let `T ⊆ W` be a locally principal
closed subspace of an algebraic space `W` and let `W' ⊆ W` be a closed subspace whose defining
ideal sheaf is the ideal of those sections of `𝒪_W` that are supported on `|T|`.  Then the
inverse image of `T` along the closed immersion `W' ⟶ W` is an effective Cartier divisor on `W'`.

The assertion is checked on étale charts by Stacks 083C.  On an affine étale chart `V` of `W`
carrying a generator `a` of the defining ideal of `T`, the defining ideal of `W'` is the
`a`-power torsion of the regular functions on `V`, by Stacks 0859 (2); the base change of `V`
along `W' ⟶ W` is an affine étale chart of `W'` whose regular functions are the quotient by that
torsion ideal, on which the defining ideal of the inverse image of `T` is generated by the image
of `a`; and that image is a nonzerodivisor, since an element killed by it is killed by one more
power of `a`. -/
theorem isPullbackDefined_ι_of_definingIdealSheaf_eq_supportedSections
    (W : AlgebraicSpaces B S hS) (T W' : ClosedSubspaces B S hS W.1)
    (hT : IsLocallyPrincipal B S hS W T)
    (hW' : definingIdealSheaf B S hS W W' =
      supportedSectionsSubmodule B S hS W.1 W.2
        (Set.range (pointsMap B S hS T.1.toFunctor T.1.ι))
        (SheafOfModules.unit (structureRingSheaf B S hS W))) :
    IsPullbackDefined B S hS
      (ObjectProperty.homMk W'.1.ι :
        (⟨W'.1.toFunctor, W'.2.1⟩ : AlgebraicSpaces B S hS) ⟶ W) T := by
  set Y : AlgebraicSpaces B S hS := ⟨W'.1.toFunctor, W'.2.1⟩
  set i : Y ⟶ W := ObjectProperty.homMk W'.1.ι
  set D : ClosedSubspaces B S hS Y.1 :=
    ⟨T.1.preimage i.hom, isClosedSubspace_preimage B S hS i.hom T.1 W.2 Y.2 T.2⟩
  refine isEffectiveCartierDivisor_of_hasEffectiveCartierEtalePullbacks B S hS Y D
    (hasEffectiveCartierEtalePullbacks_of_pointwise_charts B S hS Y D fun x => ?_)
  obtain ⟨A₀, g₀, hsurj₀, het₀⟩ := W.2.exists_atlas
  obtain ⟨p, hp⟩ := (presheafSurjective_iff_isSurjective_yoneda B S hS W.1 W.2 A₀ g₀).1 hsurj₀
    (pointsMap B S hS Y.1 i.hom x)
  set T₀ : SmallEtale B S hS W.1 := ⟨CostructuredArrow.mk g₀, het₀⟩
  obtain ⟨V, m, hVaff, y, hy, a, ha⟩ := exists_affine_chart_definingIdealAt_eq_span B S hS W T hT
    T₀ ((schemePointsHomeomorph B S hS A₀) p)
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) := hVaff
  obtain ⟨a, ha⟩ : ∃ a : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤),
      definingIdealAt B S hS W T (op V) = Ideal.span {a} := ⟨a, ha⟩
  have hyx : chartPointsMap V y = pointsMap B S hS Y.1 i.hom x := by
    rw [chartPointsMap_comp B S hS m y, hy]
    show pointsMap B S hS (yoneda.obj A₀) g₀
      ((schemePointsHomeomorph B S hS A₀).symm ((schemePointsHomeomorph B S hS A₀) p)) = _
    rwa [Homeomorph.symm_apply_apply]
  set R : BigFppfOver B S hS := W'.2.2.rep.pullback V.1.hom
  set gR : yoneda.obj R ⟶ Y.1 := W'.2.2.rep.fst V.1.hom
  set pR : R ⟶ V.1.left := W'.2.2.rep.snd V.1.hom
  have hsq : IsPullback gR (yoneda.map pR) W'.1.ι V.1.hom := W'.2.2.rep.isPullback V.1.hom
  have hgRet : IsEtale B S hS gR :=
    isEtale_of_isPullback_yoneda B S hS hsq.flip (isEtale_of_presheaf_etale B S hS V.2)
  set chartR : SmallEtale B S hS Y.1 :=
    ⟨CostructuredArrow.mk gR, presheaf_etale_of_isEtale B S hS hgRet⟩
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map pR) := W'.2.2.property_snd V.1.hom
  obtain ⟨hRaff, hφsurj⟩ :=
    _root_.AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine
      ((BigFppfOver.toScheme B S hS).map pR)
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj R) := hRaff
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj chartR.1.left) := hRaff
  obtain ⟨v, hv, -⟩ := exists_points_of_isPullback B S hS hsq x
    ((schemePointsHomeomorph B S hS V.1.left).symm y) hyx.symm
  refine ⟨R, gR, v, hgRet, hv, ?_⟩
  set φ : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤) →+*
      Γ((BigFppfOver.toScheme B S hS).obj R, ⊤) :=
    ((BigFppfOver.toScheme B S hS).map pR).appTop.hom
  have hgen : definingIdealAt B S hS Y D (op chartR) = Ideal.span {φ a} := by
    rw [definingIdealAt_preimage_eq_map B S hS i T V chartR pR hsq.w.symm, ha]
    exact (Ideal.map_span _ _).trans (congrArg Ideal.span Set.image_singleton)
  have hker : RingHom.ker φ = definingIdealAt B S hS W W' (op V) :=
    (definingIdealAt_eq_ker B S hS W W' V).symm
  exact isSchemeEffectiveCartierPullback_of_isRegular_span B S hS Y D chartR hRaff (φ a)
    (isRegular_map_of_ker_eq_torsion φ hφsurj a fun s => by
      rw [hker]
      exact mem_definingIdealAt_iff_exists_pow_mul_eq_zero B S hS W T W' hW' V hVaff a ha s) hgen

/-! ### The strict transform -/

section StrictTransform

variable {A X A' : AlgebraicSpaces B S hS} (f : X ⟶ A) (b : A' ⟶ A)
  (Z : ClosedSubspaces B S hS A.1)

/-- **The inverse image of the centre on the strict transform is an effective Cartier
divisor.**  For `b : A' ⟶ A` the blowup of `A` in a closed subspace `Z ⊆ A` and `f : X ⟶ A` an
algebraic space over `A`, the pullback of `f⁻¹Z` along `X' ⟶ X ×_A A' ⟶ X` is defined in the
sense of Stacks 083Y: it is an effective Cartier divisor on the strict transform `X'`.

The strict transform is cut out by the ideal of sections supported on the exceptional preimage
`pr_{A'}^{-1}(b⁻¹Z)`
(`AlgebraicGeometry.Space.definingIdealSheaf_strictTransform_of_isBlowupAlong`), and that
preimage is locally principal because the exceptional divisor of a blowup is an effective Cartier
divisor; so
`AlgebraicGeometry.Space.isPullbackDefined_ι_of_definingIdealSheaf_eq_supportedSections` applies.
The inverse image of the exceptional preimage and the inverse image of `f⁻¹Z` along the
projection are the same closed subspace of `X'`, the square defining `X ×_A A'` being cartesian.

This is the space-level counterpart of the scheme-level
`AlgebraicGeometry.isCartierOver_strictTransform` of Stacks 080E. -/
theorem isPullbackDefined_strictTransform_of_isBlowupAlong (hb : IsBlowupAlong B S hS Z b) :
    IsPullbackDefined B S hS
      (strictTransformSpaceι B S hS f b (preimageClosedSubspace b Z).1 ≫
        strictTransformPullbackToSource B S hS f b)
      (preimageClosedSubspace f Z) := by
  have hTlp : IsLocallyPrincipal B S hS (strictTransformPullback B S hS f b)
      (exceptionalPreimageClosedSubspace B S hS f b Z) :=
    isLocallyPrincipal_preimage B S hS (strictTransformPullbackToBlowUp B S hS f b)
      (preimageClosedSubspace b Z)
      (isLocallyPrincipal_definingIdealSheaf_of_isEffectiveCartierDivisor B S hS A'
        (preimageClosedSubspace b Z) hb.isPullbackDefined)
  have hmain := isPullbackDefined_ι_of_definingIdealSheaf_eq_supportedSections B S hS
    (strictTransformPullback B S hS f b) (exceptionalPreimageClosedSubspace B S hS f b Z)
    (strictTransform B S hS f b (preimageClosedSubspace b Z).1) hTlp
    (definingIdealSheaf_strictTransform_of_isBlowupAlong B S hS f b Z hb)
  refine isEffectiveCartierDivisor_of_subfunctor_eq ?_ hmain
  show (preimageClosedSubspace f Z).1.preimage
      (strictTransformSpaceι B S hS f b (preimageClosedSubspace b Z).1 ≫
        strictTransformPullbackToSource B S hS f b).hom =
    (exceptionalPreimageClosedSubspace B S hS f b Z).1.preimage
      (strictTransform B S hS f b (preimageClosedSubspace b Z).1).1.ι
  rw [show (strictTransformSpaceι B S hS f b (preimageClosedSubspace b Z).1 ≫
        strictTransformPullbackToSource B S hS f b).hom =
      (strictTransform B S hS f b (preimageClosedSubspace b Z).1).1.ι ≫
        (strictTransformPullbackToSource B S hS f b).hom from rfl,
    preimage_preimageClosedSubspace_comp_toSource B S hS f b Z
      (Y := strictTransformSpace B S hS f b (preimageClosedSubspace b Z).1)
      (strictTransform B S hS f b (preimageClosedSubspace b Z).1).1.ι,
    preimage_exceptionalPreimage_eq_preimage_centre B S hS f b Z
      (Y := strictTransformSpace B S hS f b (preimageClosedSubspace b Z).1)
      (strictTransform B S hS f b (preimageClosedSubspace b Z).1).1.ι]

/-- **The strict transform is an object of the category `𝒞` of Stacks 085U for the centre
`f⁻¹Z`.**  This is
`AlgebraicGeometry.Space.isPullbackDefined_strictTransform_of_isBlowupAlong` read as membership in
the category that the blowup of `X` in `f⁻¹Z` is a final object of. -/
theorem isCartierOver_strictTransform_of_isBlowupAlong (hb : IsBlowupAlong B S hS Z b) :
    IsCartierOver B S hS (preimageClosedSubspace f Z)
      (Over.mk (strictTransformSpaceι B S hS f b (preimageClosedSubspace b Z).1 ≫
        strictTransformPullbackToSource B S hS f b)) :=
  isPullbackDefined_strictTransform_of_isBlowupAlong B S hS f b Z hb

end StrictTransform

end AlgebraicGeometry.Space

