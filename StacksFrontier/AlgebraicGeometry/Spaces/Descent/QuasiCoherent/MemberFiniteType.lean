module

public import StacksFrontier.AlgebraicGeometry.Spaces.Descent.QuasiCoherent.MemberQuasicoherence
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedFiniteTypeOnCharts

/-!
# Finite type descends along the charts of the members of an étale family

Let `X` be an algebraic space over a scheme `S` and let `(f i : Y i ⟶ X)` be a family of
algebraic spaces étale over `X` whose charts are cover dense in the small étale site of `X`, for
instance an étale covering. An `𝒪_X`-module all of whose étale restrictions to the members of the
family are of finite type is of finite type.

Generation by finitely many global sections over a chart of a member is carried to the composite
chart of `X` across the slice equivalence
`AlgebraicGeometry.Space.SmallEtale.postcompOverEquivalence`.

## Main results

* `AlgebraicGeometry.Space.hasFiniteGlobalGenerators_over_postcomp`: finitely many global
  generators of the étale pullback over a chart of `Y` give finitely many global generators of
  the module over the composite chart of `X`.
* `AlgebraicGeometry.Space.QuasiCoherentDescent.isFiniteTypeOnSite_of_forall_etaleModulePullback`:
  **an `𝒪_X`-module whose étale restriction to every member of the family is of finite type is
  of finite type.**

## References

* [Stacks Project, Tag 03DN](https://stacks.math.columbia.edu/tag/03DN)
* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Stacks.SheafOfModules.FiniteTypeTransport

universe u v

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- **Finitely many global generators pass from an étale pullback to the composite chart.** If
the restriction of the étale pullback of `M` along an étale `f : Y ⟶ X` to a chart `V` of `Y`
is generated by finitely many global sections, so is the restriction of `M` to the composite
chart of `X`: the two are identified across the slice equivalence of the two small étale sites
at `V`, along which finite global generation is transported by
`Stacks.SheafOfModules.FiniteTypeTransport.hasFiniteGlobalGenerators_of_functor`. -/
theorem hasFiniteGlobalGenerators_over_postcomp (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (V : (smallEtaleRingedSite B S hS Y.1 Y.2).C)
    (h : (((etaleModulePullback B S hS f hf).obj M).over V).HasFiniteGlobalGenerators) :
    (M.over ((ringedSitePostcomp B S hS f hf).obj V)).HasFiniteGlobalGenerators := by
  let E : Over V ≌ Over ((ringedSitePostcomp B S hS f hf).obj V) :=
    SmallEtale.postcompOverEquivalence B S hS f hf V
  have hc1 : E.functor.IsContinuous ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V)) :=
    SmallEtale.isContinuous_overPostcomp B S hS f hf V
  have hc2 : E.inverse.IsContinuous
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V))
      ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V) :=
    SmallEtale.isContinuous_postcompOverInverse B S hS f hf V
  let RY := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)
  let RX := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)
  let φ : RY.over V ⟶ (E.functor.sheafPushforwardContinuous RingCat.{u}
      ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V))).obj
      (RX.over ((ringedSitePostcomp B S hS f hf).obj V)) := 𝟙 _
  let ψ : RX.over ((ringedSitePostcomp B S hS f hf).obj V) ⟶
      (E.inverse.sheafPushforwardContinuous RingCat.{u}
        ((smallEtaleRingedSite B S hS X.1 X.2).J.over
          ((ringedSitePostcomp B S hS f hf).obj V))
        ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)).obj (RY.over V) := 𝟙 _
  have H₁ : Functor.whiskerRight (NatTrans.op E.counit)
      (RX.over ((ringedSitePostcomp B S hS f hf).obj V)).obj =
      ψ.hom ≫ E.inverse.op.whiskerLeft φ.hom := by
    ext : 2
    exact rfl
  have H₂ : φ.hom ≫ E.functor.op.whiskerLeft ψ.hom ≫
      Functor.whiskerRight (NatTrans.op E.unit) (RY.over V).obj = 𝟙 (RY.over V).obj := by
    ext : 2
    exact rfl
  let e₀ := SheafOfModules.pushforwardPushforwardEquivalence.{u} E φ ψ H₁ H₂
  let eHi := SheafOfModules.pushforwardPushforwardEquivalence.{u + 1} E φ ψ H₁ H₂
  let F₀ := SheafOfModules.pushforward.{u} φ
  let G₀ := SheafOfModules.pushforward.{u} ψ
  let G := SheafOfModules.pushforward.{u + 1} ψ
  have hGadj : G.IsLeftAdjoint := eHi.symm.isLeftAdjoint_functor
  have key : F₀.obj (M.over ((ringedSitePostcomp B S hS f hf).obj V)) ≅
      ((etaleModulePullback B S hS f hf).obj M).over V :=
    (SheafOfModules.fullyFaithfulForget _).preimageIso
      (PresheafOfModules.isoMk (fun _ => Iso.refl _) (by intro A A' a; ext x; rfl))
  have h₀ : (F₀.obj (M.over ((ringedSitePostcomp B S hS f hf).obj V))).HasFiniteGlobalGenerators :=
    hasFiniteGlobalGenerators_of_iso key.symm h
  have h' := hasFiniteGlobalGenerators_of_functor (F₀ := G₀) (F := G) _
    (Stacks.SheafOfModules.pushforwardUliftIso.{u + 1, u, u, u, u + 1} ψ
      (SheafOfModules.unit (RY.over V)))
    (Stacks.SheafOfModules.pushforwardUliftIso.{u + 1, u, u, u, u + 1} ψ
      (F₀.obj (M.over ((ringedSitePostcomp B S hS f hf).obj V)))) h₀
  exact hasFiniteGlobalGenerators_of_iso
    (e₀.unitIso.app (M.over ((ringedSitePostcomp B S hS f hf).obj V))).symm h'

namespace QuasiCoherentDescent

variable {I : Type v} (Yi : I → AlgebraicSpaces B S hS)
  (f : ∀ i, Yi i ⟶ X) (hf : ∀ i, IsEtale B S hS (f i).hom)

variable [(memberFunctor B S hS Yi f hf).IsCoverDense (SmallEtale.topology B S hS X.1)]

/-- **An `𝒪_X`-module whose étale restriction to every member of the family is of finite type is
of finite type.** Over a chart of `X` the sieve of the morphisms factoring through a chart of a
member is covering, and over such a morphism finite type of the étale restriction supplies a
covering of the chart of the member on whose members finitely many global generators exist,
which `AlgebraicGeometry.Space.hasFiniteGlobalGenerators_over_postcomp` carries back to the
composite charts of `X`. -/
theorem isFiniteTypeOnSite_of_forall_etaleModulePullback
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : ∀ i, ((etaleModulePullback.{u, u} B S hS (f i) (hf i)).obj M).IsFiniteTypeOnSite) :
    M.IsFiniteTypeOnSite := by
  have hT : ∀ W : (smallEtaleRingedSite B S hS X.1 X.2).C,
      Sieve.ofObjects (fun z : {Z : (smallEtaleRingedSite B S hS X.1 X.2).C //
        (M.over Z).HasFiniteGlobalGenerators} => z.1) W ∈
        (smallEtaleRingedSite B S hS X.1 X.2).J W := by
    intro W
    refine (smallEtaleRingedSite B S hS X.1 X.2).J.transitive
      ((memberFunctor B S hS Yi f hf).is_cover_of_isCoverDense
        (SmallEtale.topology B S hS X.1) W) _ ?_
    intro W' g hg
    obtain ⟨⟨p, a, -, -⟩⟩ := hg
    obtain ⟨I₁, W₁, g₁, hcov₁, hgen₁⟩ := (h p.1).locally_finitelyGenerated
      ((SmallEtale.postcompOverInverse B S hS (f p.1) (hf p.1) p.2).obj (Over.mk a)).left
    have hpush := (SmallEtale.coverPreserving_smallEtalePostcomp B S hS (f p.1)
      (hf p.1)).cover_preserve hcov₁
    have hle : Sieve.functorPushforward (ringedSitePostcomp B S hS (f p.1) (hf p.1))
        (Sieve.ofArrows W₁ g₁) ≤
        Sieve.ofObjects (fun z : {Z : (smallEtaleRingedSite B S hS X.1 X.2).C //
          (M.over Z).HasFiniteGlobalGenerators} => z.1)
          ((ringedSitePostcomp B S hS (f p.1) (hf p.1)).obj
            ((SmallEtale.postcompOverInverse B S hS (f p.1) (hf p.1) p.2).obj
              (Over.mk a)).left) := by
      rintro T r ⟨Z₀, r₀, q, hr₀, rfl⟩
      obtain ⟨i₁, b, -⟩ := (Sieve.mem_ofArrows_iff _ _ _).mp hr₀
      exact ⟨⟨_, hasFiniteGlobalGenerators_over_postcomp B S hS (f p.1) (hf p.1) M (W₁ i₁)
        (hgen₁ i₁)⟩, ⟨q ≫ (ringedSitePostcomp B S hS (f p.1) (hf p.1)).map b⟩⟩
    have hobj := (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering hle hpush
    have hα := (smallEtaleRingedSite B S hS X.1 X.2).J.pullback_stable
      ((Over.forget ((smallEtalePostcomp B S hS (f p.1) (hf p.1)).obj p.2)).mapIso
        ((SmallEtale.postcompOverCounitIso B S hS (f p.1) (hf p.1) p.2).app
          (Over.mk a))).inv hobj
    exact (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering (fun _ _ hb => hb) hα
  refine ⟨fun W => ⟨{q : (Σ Z : (smallEtaleRingedSite B S hS X.1 X.2).C, Z ⟶ W) //
      (M.over q.1).HasFiniteGlobalGenerators}, fun q => q.1.1, fun q => q.1.2, ?_,
      fun q => q.2⟩⟩
  refine (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering ?_ (hT W)
  intro Z g hg
  obtain ⟨z, ⟨a⟩⟩ := (Sieve.mem_ofObjects_iff _ g).mp hg
  exact (Sieve.mem_ofArrows_iff _ _ _).2
    ⟨⟨⟨Z, g⟩, hasFiniteGlobalGenerators_overMap M a z.2⟩, 𝟙 Z, (Category.id_comp _).symm⟩

end QuasiCoherentDescent

end AlgebraicGeometry.Space

end
