module

public import StacksFrontier.AlgebraicGeometry.Spaces.Descent.QuasiCoherent.SingleMemberSite
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtalePostcompSlice

/-!
# The sheaf condition on the site of the charts of one étale morphism

Let `g : Y ⟶ X` be an étale morphism of algebraic spaces over a scheme `S` contained in a big
fppf site `B`. The site `AlgebraicGeometry.Space.QuasiCoherentDescent.SingleSite` has as objects
the étale charts of `Y`, but as morphisms the morphisms of the *induced* charts of `X`; it carries
more morphisms than the small étale site of `Y`, and its topology is restricted from the small
étale topology of `X` rather than generated by charts of `Y`.

A presheaf on the site of the charts of `g` is a sheaf as soon as its restriction along the
honest charts of `Y` is a sheaf on the small étale site of `Y`. No surjectivity of `g` is needed.

## Main definitions

* `AlgebraicGeometry.Space.QuasiCoherentDescent.singleInclusion`: the small étale site of `Y`
  inside the site of the charts of `g`, the identity on objects.
* `AlgebraicGeometry.Space.QuasiCoherentDescent.twistChart`,
  `AlgebraicGeometry.Space.QuasiCoherentDescent.twistHonest` and
  `AlgebraicGeometry.Space.QuasiCoherentDescent.twistIso`: the chart of `Y` attached to a chart
  of `X` over an induced chart, the honest morphism of charts of `Y` it carries, and the
  comparison of the two charts of `X`.

## Main results

* `AlgebraicGeometry.Space.QuasiCoherentDescent.twist_factorization`: every morphism of charts of
  `X` into an induced chart factors as an isomorphism followed by the image of an honest morphism
  of charts of `Y`.
* `AlgebraicGeometry.Space.QuasiCoherentDescent.functorPullback_mem_topology`: a covering sieve of
  the site of the charts of `g` restricts to a covering sieve of the small étale site of `Y`.
* `AlgebraicGeometry.Space.QuasiCoherentDescent.isSheaf_of_isSheaf_singleInclusion` and
  `AlgebraicGeometry.Space.QuasiCoherentDescent.isSheaf_of_isSheaf_singleInclusion'`: a presheaf
  on the site of the charts of `g` whose restriction to the charts of `Y` is a sheaf is a sheaf,
  for coefficients in types and in abelian groups.

## Implementation notes

`AlgebraicGeometry.Space.QuasiCoherentDescent.twistChart` and
`AlgebraicGeometry.Space.QuasiCoherentDescent.twistIso` are the inverse functor, read on
objects, and the counit of the slice comparison
`AlgebraicGeometry.Space.SmallEtale.postcompOverEquivalence` of Stacks 04M0.

`CategoryTheory.Functor.restrictedTopology` is a generated topology, so
`CategoryTheory.Functor.mem_restrictedTopology_iff` needs the local cover density
`AlgebraicGeometry.Space.QuasiCoherentDescent.locallyCoverDense_singleFunctor`.

## References

* [Stacks Project, Tag 03M3](https://stacks.math.columbia.edu/tag/03M3)
* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
* [Stacks Project, Tag 03LP](https://stacks.math.columbia.edu/tag/03LP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe w u

namespace AlgebraicGeometry.Space.QuasiCoherentDescent

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : AlgebraicSpaces B S hS} (g : Y ⟶ X) (hg : IsEtale B S hS g.hom)

/-! ### The honest charts of `Y` inside the site of the charts of `g` -/

/-- The small étale site of `Y` inside the site of the charts of `g`: a chart of `Y` is read as
an object of that site, and an honest morphism of charts of `Y` as the morphism of the induced
charts of `X` it gives. -/
def singleInclusion : SmallEtale B S hS Y.1 ⥤ SingleSite B S hS g hg where
  obj V := singleObj B S hS g hg V
  map h := singleHom B S hS g hg ((smallEtalePostcomp B S hS g hg).map h)
  map_id _ := rfl
  map_comp _ _ := rfl

/-- Reading an honest morphism of charts of `Y` in the site of the charts of `g` and then in the
small étale site of `X` is postcomposition. -/
theorem singleFunctor_map_singleInclusion_map {V W : SmallEtale B S hS Y.1} (h : V ⟶ W) :
    (singleFunctor B S hS g hg).map ((singleInclusion B S hS g hg).map h) =
      (smallEtalePostcomp B S hS g hg).map h := rfl

/-! ### The twist of a chart of `X` over an induced chart -/

section Twist

variable {W : SmallEtale B S hS Y.1} {Z : SmallEtale B S hS X.1}

/-- A chart of `X` over the chart of `X` induced by a chart `W` of `Y`, read as a chart of `Y`
over `W`.  This is the slice comparison of Stacks 04M0. -/
abbrev twistOver (q : Z ⟶ (smallEtalePostcomp B S hS g hg).obj W) : Over W :=
  (SmallEtale.postcompOverInverse B S hS g hg W).obj (Over.mk q)

/-- The twist of a chart of `X` over an induced chart: the chart of `Y` with the same source
scheme, whose structure morphism is the given morphism followed by the structure morphism of the
chart of `Y` it lies over. -/
abbrev twistChart (q : Z ⟶ (smallEtalePostcomp B S hS g hg).obj W) : SmallEtale B S hS Y.1 :=
  (twistOver B S hS g hg q).left

/-- The honest morphism of charts of `Y` carried by the twist. -/
abbrev twistHonest (q : Z ⟶ (smallEtalePostcomp B S hS g hg).obj W) :
    twistChart B S hS g hg q ⟶ W :=
  (twistOver B S hS g hg q).hom

/-- The chart of `X` induced by the twist is the given chart again, by the identity on the
underlying scheme. -/
abbrev twistIso (q : Z ⟶ (smallEtalePostcomp B S hS g hg).obj W) :
    Z ≅ (smallEtalePostcomp B S hS g hg).obj (twistChart B S hS g hg q) :=
  ((Over.forget ((smallEtalePostcomp B S hS g hg).obj W)).mapIso
    ((SmallEtale.postcompOverCounitIso B S hS g hg W).app (Over.mk q))).symm

/-- The comparison of the two charts of `X` carries the given morphism to the image of the honest
morphism of charts of `Y`. -/
theorem twistIso_inv_comp (q : Z ⟶ (smallEtalePostcomp B S hS g hg).obj W) :
    (twistIso B S hS g hg q).inv ≫ q =
      (smallEtalePostcomp B S hS g hg).map (twistHonest B S hS g hg q) :=
  Over.w _

/-- Every morphism of charts of `X` into an induced chart factors as an isomorphism followed by
the image of an honest morphism of charts of `Y`. -/
theorem twist_factorization (q : Z ⟶ (smallEtalePostcomp B S hS g hg).obj W) :
    q = (twistIso B S hS g hg q).hom ≫
      (smallEtalePostcomp B S hS g hg).map (twistHonest B S hS g hg q) :=
  (Iso.inv_comp_eq _).1 (twistIso_inv_comp B S hS g hg q)

end Twist

/-! ### Covering sieves of the two sites -/

/-- Every sieve on an induced chart of `X` is the image of its restriction to the site of the
charts of `g`. -/
theorem functorPushforward_functorPullback_singleFunctor (A : SingleSite B S hS g hg)
    (T : Sieve ((singleFunctor B S hS g hg).obj A)) :
    (T.functorPullback (singleFunctor B S hS g hg)).functorPushforward
        (singleFunctor B S hS g hg) = T := by
  refine le_antisymm (Sieve.functorPullback_pushforward_le _ T) ?_
  intro Z q hq
  refine ⟨singleObj B S hS g hg (twistChart B S hS g hg (W := A.2) q),
    InducedCategory.homMk
      ((smallEtalePostcomp B S hS g hg).map (twistHonest B S hS g hg (W := A.2) q)),
    (twistIso B S hS g hg (W := A.2) q).hom, ?_,
    twist_factorization B S hS g hg (W := A.2) q⟩
  show T.arrows ((smallEtalePostcomp B S hS g hg).map (twistHonest B S hS g hg (W := A.2) q))
  rw [← twistIso_inv_comp B S hS g hg (W := A.2) q]
  exact T.downward_closed hq _

/-- The projection from the site of the charts of `g` to the small étale site of `X` is locally
cover dense. -/
instance locallyCoverDense_singleFunctor :
    (singleFunctor B S hS g hg).LocallyCoverDense (SmallEtale.topology B S hS X.1) where
  functorPushforward_functorPullback_mem A T := by
    rw [functorPushforward_functorPullback_singleFunctor B S hS g hg A T.1]
    exact T.2

/-- A covering sieve of the site of the charts of `g` has a covering image in the small étale
site of `X`. -/
theorem functorPushforward_mem_topology {W : SmallEtale B S hS Y.1}
    (T : Sieve (singleObj B S hS g hg W))
    (hT : T ∈ singleTopology B S hS g hg (singleObj B S hS g hg W)) :
    T.functorPushforward (singleFunctor B S hS g hg) ∈
      SmallEtale.topology B S hS X.1 ((smallEtalePostcomp B S hS g hg).obj W) :=
  Functor.mem_restrictedTopology_iff.1 hT

/-- A covering sieve of the site of the charts of `g` restricts to a covering sieve of the small
étale site of `Y`. -/
theorem functorPullback_mem_topology {W : SmallEtale B S hS Y.1}
    (T : Sieve (singleObj B S hS g hg W))
    (hT : T ∈ singleTopology B S hS g hg (singleObj B S hS g hg W)) :
    T.functorPullback (singleInclusion B S hS g hg) ∈ SmallEtale.topology B S hS Y.1 W := by
  refine (SmallEtale.topology B S hS Y.1).superset_covering ?_
    (SmallEtale.smallEtalePostcomp_cover_lift B S hS g hg W _
      (functorPushforward_mem_topology B S hS g hg T hT))
  rintro V h ⟨A, t, a, ht, hfac⟩
  show T.arrows ((singleInclusion B S hS g hg).map h)
  rw [show (singleInclusion B S hS g hg).map h =
      (InducedCategory.homMk a : singleObj B S hS g hg V ⟶ A) ≫ t from
    InducedCategory.hom_ext hfac]
  exact T.downward_closed ht _

/-! ### The sheaf condition -/

/-- A presheaf of types on the site of the charts of `g` is a sheaf as soon as its restriction
along the honest charts of `Y` is a sheaf on the small étale site of `Y`. -/
theorem isSheaf_of_isSheaf_singleInclusion (Q : (SingleSite B S hS g hg)ᵒᵖ ⥤ Type w)
    (hQ : Presieve.IsSheaf (SmallEtale.topology B S hS Y.1)
      ((singleInclusion B S hS g hg).op ⋙ Q)) :
    Presieve.IsSheaf (singleTopology B S hS g hg) Q := by
  intro A T hT x hx
  obtain ⟨W, rfl⟩ : ∃ W, A = singleObj B S hS g hg W := ⟨A.2, rfl⟩
  have hxs := hx.to_sieveCompatible
  obtain ⟨t, ht, htuniq⟩ :=
    hQ _ (functorPullback_mem_topology B S hS g hg T hT)
      (fun V h hh => x ((singleInclusion B S hS g hg).map h) hh)
      (fun _ _ _ f₁ f₂ _ _ hh₁ hh₂ hcomm => hx _ _ hh₁ hh₂ (by
        have hmap := congrArg (singleInclusion B S hS g hg).map hcomm
        rwa [Functor.map_comp, Functor.map_comp] at hmap))
  refine ⟨t, fun A k hk => ?_, fun t' ht' => htuniq t' fun V h hh =>
    ht' ((singleInclusion B S hS g hg).map h) hh⟩
  obtain ⟨V, i, h, rfl⟩ :
      ∃ (V : SmallEtale B S hS Y.1) (i : A ≅ (singleInclusion B S hS g hg).obj V)
        (h : V ⟶ W), k = i.hom ≫ (singleInclusion B S hS g hg).map h :=
    ⟨twistChart B S hS g hg k.hom, InducedCategory.isoMk (twistIso B S hS g hg k.hom),
      twistHonest B S hS g hg k.hom,
      InducedCategory.hom_ext (twist_factorization B S hS g hg k.hom)⟩
  have hj : T.arrows ((singleInclusion B S hS g hg).map h) := by
    simpa using T.downward_closed hk i.inv
  exact (Q.map_comp_apply _ i.hom.op t).trans <|
    (congrArg (Q.map i.hom.op) (ht h hj)).trans
    (hxs ((singleInclusion B S hS g hg).map h) i.hom hj).symm

/-- A presheaf of abelian groups on the site of the charts of `g` is a sheaf as soon as its
restriction along the honest charts of `Y` is a sheaf on the small étale site of `Y`. -/
theorem isSheaf_of_isSheaf_singleInclusion' (Q : (SingleSite B S hS g hg)ᵒᵖ ⥤ AddCommGrpCat.{w})
    (hQ : Presheaf.IsSheaf (SmallEtale.topology B S hS Y.1)
      ((singleInclusion B S hS g hg).op ⋙ Q)) :
    Presheaf.IsSheaf (singleTopology B S hS g hg) Q :=
  fun E => isSheaf_of_isSheaf_singleInclusion B S hS g hg _ (hQ E)

end AlgebraicGeometry.Space.QuasiCoherentDescent

end
