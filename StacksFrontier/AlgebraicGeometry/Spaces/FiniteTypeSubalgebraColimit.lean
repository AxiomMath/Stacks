module

public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeQuasicoherentExtension
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AlgebraSheafColimits
public import StacksFrontier.AlgebraicGeometry.Spaces.SubalgebraJoinFiniteType

/-!
# A quasi-coherent algebra on a qcqs algebraic space is the colimit of its finite type subalgebras

Let `S` be a scheme, `X` a quasi-compact and quasi-separated algebraic space over `S` and `𝒜` a
quasi-coherent `𝒪_X`-algebra.  Stacks 082B asserts that `𝒜` is the directed colimit of its finite
type quasi-coherent `𝒪_X`-subalgebras.  This file proves it.

## The argument

The source's hint is to compare with Stacks 0829, the analogous statement for modules.  The
module statement is available here on charts: every section of a quasi-coherent module over an
affine étale chart of a qcqs algebraic space lies in a finite type quasi-coherent submodule,
`AlgebraicGeometry.Space.chartExtensionProperty_id`, whose submodules are
`AlgebraicGeometry.Space.ChartSubmodule`s.  The passage from modules to algebras is the
subalgebra *generated* by such a submodule `𝒟` of the module underlying `𝒜`:

* over an affine étale chart `W` its sections are the `𝒪_X(W)`-span of the monomials in the
  sections of `𝒟` over `W`
  (`AlgebraicGeometry.Space.AlgebraSheaf.mem_adjoinSubpresheaf_iff_mem_span`), so no
  sheafification is visible there;
* hence it is cartesian on affine charts, so quasi-coherent
  (`AlgebraicGeometry.Space.AlgebraSheaf.isQuasicoherent_adjoin`), and of finite type, since the
  sections of `𝒟` over an affine chart are finitely generated
  (`AlgebraicGeometry.Space.AlgebraSheaf.isFiniteType_adjoin`).

So every section of `𝒜` over an affine étale chart lies in a finite type quasi-coherent
subalgebra (`AlgebraicGeometry.Space.exists_finiteTypeSubalgebra_section`).  The finite type
quasi-coherent subalgebras are directed
(`AlgebraicGeometry.Space.isFiltered_finiteTypeSubalgebra`), their inclusions are injective on
sections, and a filtered cocone of algebra sheaves with sectionwise injective legs which are
jointly surjective on the sections over affine charts is a colimit
(`AlgebraicGeometry.Space.AlgebraSheaf.nonempty_isColimit_of_affineChartSections_of_injective`).

## Main results

* `AlgebraicGeometry.Space.AlgebraSheaf.adjoin`: the subalgebra of `𝒜` generated by a chart
  submodule of its underlying module, with its inclusion
  `AlgebraicGeometry.Space.AlgebraSheaf.adjoinι`.
* `AlgebraicGeometry.Space.exists_finiteTypeSubalgebra_section`: on a qcqs algebraic space every
  section of a quasi-coherent algebra over an affine étale chart is a section of a finite type
  quasi-coherent subalgebra.
* `AlgebraicGeometry.Space.isFiltered_and_isColimit_finiteTypeSubalgebraCocone`: **Stacks 082B**.

## References

* [Stacks Project, Tag 082B](https://stacks.math.columbia.edu/tag/082B)
* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace RingHom

/-- **A subring generated over a ring by finitely many elements is of finite type.**

Let `T` be a subring of `Aa`, `ρ : R →+* T`, and `s` a finite set of elements of `T`.  If every
element of `T` lies in the subring of `Aa` generated by the image of `ρ` and by `s`, then `T` is
of finite type over `R`. -/
theorem finiteType_of_forall_mem_closure {R Aa : Type*} [CommRing R] [CommRing Aa]
    (T : Subring Aa) (ρ : R →+* T) (s : Finset Aa) (hs : ∀ x ∈ s, x ∈ T)
    (hT : ∀ y : T, (y : Aa) ∈ Subring.closure (Set.range (fun r => (ρ r : Aa)) ∪ ↑s)) :
    ρ.FiniteType := by
  classical
  let _ : Algebra R T := ρ.toAlgebra
  let s' : Finset T := s.attach.image fun x => ⟨x.1, hs x.1 x.2⟩
  refine ⟨⟨s', le_antisymm le_top fun y _ => ?_⟩⟩
  have hgen : Subring.closure (Set.range (fun r => (ρ r : Aa)) ∪ ↑s) ≤
      Subring.map T.subtype (Algebra.adjoin R (↑s' : Set T)).toSubring := by
    refine Subring.closure_le.2 ?_
    rintro v (⟨r, rfl⟩ | hv)
    · exact Subring.mem_map.2 ⟨ρ r, Subalgebra.algebraMap_mem _ r, rfl⟩
    · refine Subring.mem_map.2 ⟨⟨v, hs v hv⟩, Algebra.subset_adjoin ?_, rfl⟩
      exact Finset.mem_coe.2 (Finset.mem_image.2 ⟨⟨v, hv⟩, Finset.mem_attach _ _, rfl⟩)
  obtain ⟨w, hw, hwy⟩ := Subring.mem_map.1 (hgen (hT y))
  obtain rfl : w = y := Subtype.ext hwy
  exact hw

end RingHom

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

namespace AlgebraSheaf

variable {A : AlgebraSheaf.{u, u} B S hS F hF} (D : ChartSubmodule A.underlyingModule (𝟙 F))

/-! ### The sections of a chart submodule as sections of the algebra -/

/-- The sections over an étale chart of a chart submodule of the module underlying `A`, read as
a set of sections of `A`. -/
def chartSubmoduleSet (V : SmallEtale B S hS F) : Set (A.right.obj.obj (op V)) :=
  {y | y ∈ D.obj V V.1.hom (Category.comp_id _)}

/-- A section of `A` over `V` lies in `chartSubmoduleSet D V` if and only if it lies in the
sections of `D` over `V`. -/
theorem mem_chartSubmoduleSet {V : SmallEtale B S hS F} {y : A.right.obj.obj (op V)} :
    y ∈ chartSubmoduleSet D V ↔ y ∈ D.obj V V.1.hom (Category.comp_id _) :=
  Iff.rfl

/-- The sections of a chart submodule are stable under restriction. -/
theorem map_mem_chartSubmoduleSet {V W : SmallEtale B S hS F} (g : V ⟶ W)
    {y : A.right.obj.obj (op W)} (hy : y ∈ chartSubmoduleSet D W) :
    A.right.obj.map g.op y ∈ chartSubmoduleSet D V :=
  D.obj.mem_congr _ (CostructuredArrow.w g.hom) _ _ (D.map g W.1.hom (Category.comp_id _) hy)

/-- Over a morphism of affine étale charts the sections of a chart submodule over the smaller
chart lie in the span of the restrictions of its sections over the larger one. -/
theorem chartSubmoduleSet_subset_span (hA : IsCartesianOnAffineCharts A.underlyingModule)
    {W V : SmallEtale B S hS F}
    (hW : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W))
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (g : V ⟶ W) :
    chartSubmoduleSet D V ⊆ Submodule.span (chartRing B S hS F hF V)
      ((fun y => A.right.obj.map g.op y) '' chartSubmoduleSet D W) := by
  intro y hy
  have hw : V.1.hom = yoneda.map g.hom.left ≫ W.1.hom := (CostructuredArrow.w g.hom).symm
  have hy' := D.obj.mem_congr V hw _ (chartOver_comp g (Category.comp_id W.1.hom)) hy
  rwa [D.obj_eq_span hA hW hV g W.1.hom (Category.comp_id _)] at hy'

/-- The sections of a chart submodule over an affine chart are spanned by finitely many of
them. -/
theorem exists_finset_span_eq (hA : IsCartesianOnAffineCharts A.underlyingModule)
    {W : SmallEtale B S hS F}
    (hW : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W)) :
    ∃ t : Finset (A.right.obj.obj (op W)),
      (↑t : Set (A.right.obj.obj (op W))) ⊆ chartSubmoduleSet D W ∧
        chartSubmoduleSet D W ⊆
          (Submodule.span (chartRing B S hS F hF W) (↑t : Set (A.right.obj.obj (op W))) :
            Set (A.right.obj.obj (op W))) := by
  obtain ⟨t, ht⟩ := D.fg_obj hA hW W.1.hom (Category.comp_id _)
  refine ⟨t, fun x hx => ?_, fun x hx => ?_⟩
  · rw [mem_chartSubmoduleSet, ← ht]
    exact Submodule.subset_span hx
  · rwa [mem_chartSubmoduleSet, ← ht] at hx

/-! ### Monomials in the sections of a chart submodule -/

/-- The monomials in the sections of a chart submodule over an étale chart: the submonoid of the
sections of `A` they generate. -/
def monomials (V : SmallEtale B S hS F) : Submonoid (A.right.obj.obj (op V)) :=
  Submonoid.closure (chartSubmoduleSet D V)

/-- The `𝒪_F(V)`-span of a set of sections of `A` closed under multiplication is closed under
multiplication. -/
private theorem mul_mem_span_of_mul_mem {V : SmallEtale B S hS F} {s : Set (A.right.obj.obj (op V))}
    (hs : ∀ p ∈ s, ∀ q ∈ s, p * q ∈ s) {y₁ y₂ : A.right.obj.obj (op V)}
    (h₁ : y₁ ∈ Submodule.span (chartRing B S hS F hF V) s)
    (h₂ : y₂ ∈ Submodule.span (chartRing B S hS F hF V) s) :
    y₁ * y₂ ∈ Submodule.span (chartRing B S hS F hF V) s := by
  have h := Submodule.apply_mem_map₂ (sectionsMulBilin A V) h₁ h₂
  rw [Submodule.map₂_span_span] at h
  refine Submodule.span_le.2 ?_ h
  rintro v ⟨p, hp, q, hq, rfl⟩
  exact Submodule.subset_span (hs p hp q hq)

/-- The `𝒪_F(V)`-span of a set of sections lying in a subring of `A(V)` that contains the image of
the structure-algebra map lies in that subring. -/
private theorem span_subset_subring {V : SmallEtale B S hS F}
    (R : Subring (A.right.obj.obj (op V))) (hR : Set.range (A.algebraMap (op V)) ⊆ R)
    {s : Set (A.right.obj.obj (op V))} (hs : s ⊆ R) :
    (Submodule.span (chartRing B S hS F hF V) s : Set (A.right.obj.obj (op V))) ⊆ R := by
  intro y hy
  rw [SetLike.mem_coe] at hy
  induction hy using Submodule.span_induction with
  | mem w hw => exact hs hw
  | zero => exact zero_mem _
  | add w₁ w₂ _ _ h₁ h₂ => exact add_mem h₁ h₂
  | smul r w _ h => exact mul_mem (hR ⟨r, rfl⟩) h

/-- The `𝒪_F(V)`-span of the monomials is closed under multiplication. -/
theorem mul_mem_span_monomials {V : SmallEtale B S hS F} {y₁ y₂ : A.right.obj.obj (op V)}
    (h₁ : y₁ ∈ Submodule.span (chartRing B S hS F hF V) (monomials D V : Set _))
    (h₂ : y₂ ∈ Submodule.span (chartRing B S hS F hF V) (monomials D V : Set _)) :
    y₁ * y₂ ∈ Submodule.span (chartRing B S hS F hF V) (monomials D V : Set _) :=
  mul_mem_span_of_mul_mem (fun _ hp _ hq => mul_mem hp hq) h₁ h₂

/-- **Every monomial over the smaller of two affine étale charts lies in the span of the
restrictions of the monomials over the larger one**, provided the module underlying `A` is
cartesian on affine charts. -/
theorem monomials_subset_span (hA : IsCartesianOnAffineCharts A.underlyingModule)
    {W V : SmallEtale B S hS F}
    (hW : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W))
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (g : V ⟶ W) :
    (monomials D V : Set (A.right.obj.obj (op V))) ⊆
      (Submodule.span (chartRing B S hS F hF V)
        ((fun y => A.right.obj.map g.op y) '' (monomials D W : Set (A.right.obj.obj (op W)))) :
          Set (A.right.obj.obj (op V))) := by
  intro y hy
  induction hy using Submonoid.closure_induction with
  | mem x hx =>
      exact Submodule.span_mono (Set.image_mono Submonoid.subset_closure)
        (chartSubmoduleSet_subset_span D hA hW hV g hx)
  | one => exact Submodule.subset_span ⟨1, one_mem _, map_one _⟩
  | mul x y _ _ hx hy =>
      refine mul_mem_span_of_mul_mem ?_ hx hy
      rintro _ ⟨p', hp', rfl⟩ _ ⟨q', hq', rfl⟩
      exact ⟨p' * q', mul_mem hp' hq', map_mul _ _ _⟩

/-- **The `𝒪_F(V)`-span of the monomials is the subring of `A(V)` generated by the image of the
structure-algebra map and the sections of the chart submodule.** -/
theorem span_monomials_eq_closure (V : SmallEtale B S hS F) :
    (Submodule.span (chartRing B S hS F hF V) (monomials D V : Set (A.right.obj.obj (op V))) :
        Set (A.right.obj.obj (op V))) =
      (Subring.closure (Set.range (A.algebraMap (op V)) ∪ chartSubmoduleSet D V) :
        Set (A.right.obj.obj (op V))) := by
  refine Set.Subset.antisymm (fun y hy => ?_) (fun y hy => ?_)
  · exact span_subset_subring _ (fun x hx => Subring.subset_closure (Or.inl hx))
      ((Submonoid.closure_le (S := (Subring.closure _).toSubmonoid)).2
        (fun x hx => Subring.subset_closure (Or.inr hx))) hy
  · rw [SetLike.mem_coe] at hy ⊢
    induction hy using Subring.closure_induction with
    | mem w hw =>
        rcases hw with ⟨r, rfl⟩ | hw
        · let r' : chartRing B S hS F hF V := r
          have h : A.algebraMap (op V) r = r' • (1 : A.right.obj.obj (op V)) := by
            rw [smul_sections, mul_one]
          rw [h]
          exact Submodule.smul_mem _ r' (Submodule.subset_span (one_mem _))
        · exact Submodule.subset_span (Submonoid.subset_closure hw)
    | zero => exact Submodule.zero_mem _
    | one => exact Submodule.subset_span (one_mem _)
    | add w₁ w₂ _ _ h₁ h₂ => exact Submodule.add_mem _ h₁ h₂
    | neg w _ h => exact Submodule.neg_mem _ h
    | mul w₁ w₂ _ _ h₁ h₂ => exact mul_mem_span_monomials D h₁ h₂

/-! ### Descent of membership in a span -/

/-- **A section of `A` over an affine étale chart lies in the span of a family of sets of
sections as soon as its restriction to each member of a finite jointly faithfully flat family
of affine charts does**, provided the family over each member is spanned by the restrictions of
the family over the large chart.

Each member contributes a finite family by `Submodule.mem_span_finite_of_mem_span`; the sigma
type of those finitely many finite families is one finite family, which is descended by
`AlgebraicGeometry.Space.AlgebraSheaf.mem_span_range_of_forall_restrict`. -/
theorem mem_span_of_forall_restrict_of_subset_span
    (hA : IsCartesianOnAffineCharts A.underlyingModule)
    (P : ∀ V : SmallEtale B S hS F, Set (A.right.obj.obj (op V))) {W : SmallEtale B S hS F}
    (hW : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W))
    {n : ℕ} {z : Fin n → SmallEtale B S hS F} (φ : ∀ i, z i ⟶ W)
    (hz : ∀ i, IsAffine
      ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj (z i)))
    (hff : (RingHom.pi fun i => chartRestrict (hF := hF) (φ i)).FaithfullyFlat)
    (hP : ∀ i, P (z i) ⊆ Submodule.span (chartRing B S hS F hF (z i))
      ((fun y => A.right.obj.map (φ i).op y) '' P W))
    {a : A.right.obj.obj (op W)}
    (ha : ∀ i, A.right.obj.map (φ i).op a ∈
      Submodule.span (chartRing B S hS F hF (z i)) (P (z i))) :
    a ∈ Submodule.span (chartRing B S hS F hF W) (P W) := by
  have ha' : ∀ i, A.right.obj.map (φ i).op a ∈
      Submodule.span (chartRing B S hS F hF (z i))
        ((fun y => A.right.obj.map (φ i).op y) '' P W) := fun i =>
    Submodule.span_le.2 (hP i) (ha i)
  choose T hTsub hTmem using fun i => Submodule.mem_span_finite_of_mem_span (ha' i)
  have hpre : ∀ (i : Fin n) (l : {y // y ∈ T i}), ∃ v ∈ P W,
      A.right.obj.map (φ i).op v = (l : A.right.obj.obj (op (z i))) := fun i l => hTsub i l.2
  choose v hv hvl using hpre
  refine Submodule.span_mono ?_
    (mem_span_range_of_forall_restrict A hA hW φ hz hff
      (κ := Σ j : Fin n, {y // y ∈ T j}) (fun l => v l.1 l.2) fun i => ?_)
  · rintro y ⟨l, rfl⟩
    exact hv l.1 l.2
  · refine Submodule.span_mono ?_ (hTmem i)
    intro y hy
    exact ⟨⟨i, ⟨y, hy⟩⟩, hvl i ⟨y, hy⟩⟩

/-! ### The subpresheaf of rings generated by a chart submodule -/

/-- The subpresheaf of rings of `A` whose sections over an étale chart are the subring generated
by the image of the structure-algebra map and the sections of the chart submodule `D` there. -/
def adjoinRingSubpresheaf : Stacks.CategoryTheory.RingSubpresheaf A.right.obj where
  obj V := Subring.closure (Set.range (A.algebraMap V) ∪ chartSubmoduleSet D V.unop)
  map {U V} i x hx := by
    have h : (A.right.obj.map i).hom x ∈ Subring.closure ((A.right.obj.map i).hom ''
        (Set.range (A.algebraMap U) ∪ chartSubmoduleSet D U.unop)) := by
      rw [← RingHom.map_closure]
      exact Subring.mem_map.2 ⟨x, hx, rfl⟩
    refine Subring.closure_le.2 ?_ h
    rintro y ⟨w, (⟨r, rfl⟩ | hw), rfl⟩
    · exact Subring.subset_closure
        (Or.inl ⟨(structureSheaf B S hS F hF).obj.map i r, (A.algebraMap_natural i r).symm⟩)
    · exact Subring.subset_closure (Or.inr (map_mem_chartSubmoduleSet D i.unop hw))

/-- The subsheaf of rings of `A` generated by the chart submodule `D`: the sheafification of the
subpresheaf of rings it generates. -/
def adjoinSubpresheaf : Stacks.CategoryTheory.RingSubpresheaf A.right.obj :=
  (adjoinRingSubpresheaf D).sheafify (SmallEtale.topology B S hS F)

/-- A section of `A` lying in the subring generated by the structure-algebra map and the sections
of `D` lies in the generated subsheaf of rings. -/
theorem mem_adjoinSubpresheaf_of_mem_closure {V : (SmallEtale B S hS F)ᵒᵖ}
    {y : A.right.obj.obj V}
    (hy : y ∈ Subring.closure (Set.range (A.algebraMap V) ∪ chartSubmoduleSet D V.unop)) :
    y ∈ (adjoinSubpresheaf D).obj V :=
  Stacks.CategoryTheory.RingSubpresheaf.le_sheafify _ _ V hy

/-- The sections of `D` lie in the generated subsheaf of rings. -/
theorem mem_adjoinSubpresheaf_of_mem (V : SmallEtale B S hS F) {y : A.right.obj.obj (op V)}
    (hy : y ∈ D.obj V V.1.hom (Category.comp_id _)) : y ∈ (adjoinSubpresheaf D).obj (op V) :=
  mem_adjoinSubpresheaf_of_mem_closure D (Subring.subset_closure (Or.inr hy))

/-- The presheaf of rings of sections of the subsheaf generated by `D` is a sheaf. -/
theorem isSheaf_adjoinSubpresheaf_toPresheaf :
    Presheaf.IsSheaf (SmallEtale.topology B S hS F) (adjoinSubpresheaf D).toPresheaf := by
  refine Stacks.Sites.isSheaf_commRingCat_of_isSheaf_forget' _ _ ?_
  refine Presieve.isSheaf_iso _ (adjoinSubpresheaf D).forgetIso.symm ?_
  exact Stacks.CategoryTheory.RingSubpresheaf.sheafify_isSheaf
    (G := adjoinRingSubpresheaf D) (isSheaf_sectionsPresheaf A)

/-- **The subalgebra of `A` generated by a chart submodule `D` of its underlying module.**  Its
sections over a chart are the sections of `A` which locally lie in the subring generated by the
image of the structure-algebra map and the sections of `D`. -/
def adjoin : AlgebraSheaf.{u, u} B S hS F hF where
  right := ⟨(adjoinSubpresheaf D).toPresheaf, isSheaf_adjoinSubpresheaf_toPresheaf D⟩
  algebraMap V :=
    (A.algebraMap V).codRestrict ((adjoinSubpresheaf D).obj V) fun r =>
      mem_adjoinSubpresheaf_of_mem_closure D (Subring.subset_closure (Or.inl ⟨r, rfl⟩))
  algebraMap_natural f r := Subtype.ext (A.algebraMap_natural f r)

/-- The inclusion of the subalgebra generated by `D` into `A`. -/
def adjoinι : adjoin D ⟶ A where
  right := ObjectProperty.homMk (adjoinSubpresheaf D).ι
  comm _ _ := rfl

/-- The inclusion of the generated subalgebra is a monomorphism of the underlying sheaves of
commutative rings. -/
instance mono_adjoinι_right : Mono (adjoinι D).right := by
  have : ∀ V : (SmallEtale B S hS F)ᵒᵖ, Mono ((adjoinι D).right.hom.app V) := fun V =>
    ConcreteCategory.mono_of_injective _ Subtype.val_injective
  exact (sheafToPresheaf (SmallEtale.topology B S hS F) CommRingCat.{u}).mono_of_mono_map
    (NatTrans.mono_of_mono_app (adjoinι D).right.hom)

/-- The inclusion of the generated subalgebra is a monomorphism of algebra sheaves. -/
instance mono_adjoinι : Mono (adjoinι D) :=
  Functor.mono_of_mono_map (forget (B := B) (S := S) (hS := hS) (F := F) (hF := hF))
    (mono_adjoinι_right D)

/-! ### The sections of the generated subalgebra over an affine chart -/

/-- **Over an affine étale chart the sections of the subalgebra generated by `D` are exactly the
`𝒪_F`-span of the monomials in the sections of `D`**, so the sheafification is invisible there.

One inclusion is that the span is the generated subring.  The other is faithfully flat descent:
a covering sieve of an affine chart contains a finite jointly faithfully flat family of affine
charts, and membership in the span of the monomials descends along such a family. -/
theorem mem_adjoinSubpresheaf_iff_mem_span (hA : IsCartesianOnAffineCharts A.underlyingModule)
    {W : SmallEtale B S hS F}
    (hW : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W))
    (y : A.right.obj.obj (op W)) :
    y ∈ (adjoinSubpresheaf D).obj (op W) ↔
      y ∈ Submodule.span (chartRing B S hS F hF W) (monomials D W : Set _) := by
  refine ⟨fun hy => ?_, fun hy => ?_⟩
  · rw [adjoinSubpresheaf, Stacks.CategoryTheory.RingSubpresheaf.mem_sheafify_iff] at hy
    obtain ⟨n, z, φ, hzaff, hzT, hff⟩ :=
      exists_finite_affine_faithfullyFlat_pi_le B S hS F hF hW hy
    refine mem_span_of_forall_restrict_of_subset_span hA
      (fun V => (monomials D V : Set (A.right.obj.obj (op V)))) hW φ hzaff hff
      (fun i => monomials_subset_span D hA hW (hzaff i) (φ i)) fun i => ?_
    rw [← SetLike.mem_coe, span_monomials_eq_closure D (z i)]
    exact hzT i
  · refine mem_adjoinSubpresheaf_of_mem_closure D ?_
    rwa [← SetLike.mem_coe, ← span_monomials_eq_closure D W]

/-! ### Quasi-coherence and finite type of the generated subalgebra -/

/-- **The subalgebra generated by a chart submodule of the module underlying a quasi-coherent
algebra is cartesian on affine charts.** -/
theorem isCartesianOnAffineCharts_adjoin (hA : A.IsQuasicoherent) :
    IsCartesianOnAffineCharts (adjoin D).underlyingModule := by
  have hAcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hA
  intro U V hU hV f
  refine ⟨?_, ?_⟩
  · refine injective_sectionsBaseChange_of_injective_app (underlyingModuleMap (adjoinι D)) f
      (flat_chartRestrict_of_isAffine f hU hV) (fun _ _ h => Subtype.ext h) (hAcart U V hU hV f)
  · intro y
    let _ := chartAlgebra (hF := hF) f
    let incl : (adjoin D).underlyingModule.val.obj (op V) →ₗ[chartRing B S hS F hF V]
        A.right.obj.obj (op V) := ((underlyingModuleMap (adjoinι D)).val.app (op V)).hom
    have key : Submodule.span (chartRing B S hS F hF V) (monomials D V : Set _) ≤
        Submodule.map incl
          (LinearMap.range (sectionsBaseChange (adjoin D).underlyingModule f)) := by
      refine Submodule.span_le.2 fun w hw => ?_
      refine Submodule.span_le.2 ?_ (monomials_subset_span D hAcart hU hV f hw)
      rintro v ⟨t, ht, rfl⟩
      have htmem : t ∈ (adjoinSubpresheaf D).obj (op U) :=
        (mem_adjoinSubpresheaf_iff_mem_span D hAcart hU t).2 (Submodule.subset_span ht)
      refine Submodule.mem_map.2 ⟨sectionsBaseChange (adjoin D).underlyingModule f
        (TensorProduct.tmul _ (1 : chartRing B S hS F hF V) ⟨t, htmem⟩),
        LinearMap.mem_range_self _ _, ?_⟩
      exact congrArg (fun z => incl z)
        (chartBaseChange_one_tmul (adjoin D).underlyingModule f ⟨t, htmem⟩)
    obtain ⟨w, ⟨p, hp⟩, hwy⟩ := Submodule.mem_map.1
      (key ((mem_adjoinSubpresheaf_iff_mem_span D hAcart hV y.1).1 y.2))
    exact ⟨p, hp.trans (Subtype.ext hwy)⟩

/-- **The subalgebra generated by a chart submodule of the module underlying a quasi-coherent
algebra is quasi-coherent.** -/
theorem isQuasicoherent_adjoin (hA : A.IsQuasicoherent) : (adjoin D).IsQuasicoherent :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _ (isCartesianOnAffineCharts_adjoin D hA)

/-- **The subalgebra generated by a chart submodule of the module underlying a quasi-coherent
algebra is of finite type.**  Over an affine étale chart its sections are the subring generated
by the image of the structure-algebra map and the sections of the chart submodule there, and
those are spanned by finitely many of them. -/
theorem isFiniteType_adjoin (hA : A.IsQuasicoherent) : (adjoin D).IsFiniteType := fun W hW => by
  have hAcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hA
  obtain ⟨t, hts, hst⟩ := exists_finset_span_eq D hAcart hW
  refine RingHom.finiteType_of_forall_mem_closure ((adjoinSubpresheaf D).obj (op W))
    ((adjoin D).algebraMap (op W)) t
    (fun x hx => mem_adjoinSubpresheaf_of_mem_closure D (Subring.subset_closure (Or.inr (hts hx))))
    fun y => ?_
  have hy : (y : A.right.obj.obj (op W)) ∈
      Subring.closure (Set.range (A.algebraMap (op W)) ∪ chartSubmoduleSet D W) := by
    rw [← SetLike.mem_coe, ← span_monomials_eq_closure D W, SetLike.mem_coe]
    exact (mem_adjoinSubpresheaf_iff_mem_span D hAcart hW y.1).1 y.2
  refine Subring.closure_le.2 ?_ hy
  rintro v (⟨r, rfl⟩ | hv)
  · exact Subring.subset_closure (Or.inl ⟨r, rfl⟩)
  · exact span_subset_subring (Subring.closure _)
      (fun x hx => Subring.subset_closure (Or.inl hx))
      (fun x hx => Subring.subset_closure (Or.inr hx)) (hst hv)

end AlgebraSheaf

/-! ### Sections of a quasi-coherent algebra on a qcqs space lie in finite type subalgebras -/

/-- **On a quasi-compact and quasi-separated algebraic space every section of a quasi-coherent
algebra over an affine étale chart is a section of a finite type quasi-coherent subalgebra.**

The section lies in a finite type quasi-coherent submodule of the underlying module, by the
chart form of Stacks 0829 (`AlgebraicGeometry.Space.chartExtensionProperty_id`), and the
subalgebra that submodule generates is quasi-coherent and of finite type. -/
theorem exists_finiteTypeSubalgebra_section (hZ : B.Contains (⊤_ Scheme.{u}))
    (hqc : IsQuasiCompactSpace B S hS F) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ F)
    (A : AlgebraSheaf.{u, u} B S hS F hF) (hA : A.IsQuasicoherent) (U : SmallEtale B S hS F)
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    (x : A.right.obj.obj (op U)) :
    ∃ (E : FiniteTypeSubalgebra B S hS F hF A)
      (y : (E.obj : AlgebraSheaf.{u, u} B S hS F hF).right.obj.obj (op U)),
        (E.obj.arrow.right.hom.app (op U)) y = x := by
  have hAcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hA
  obtain ⟨D, hD⟩ := chartExtensionProperty_id hZ hqc hqs hAcart U U.1.hom
    (Category.comp_id _) hU x
  let f := AlgebraSheaf.adjoinι D
  refine ⟨⟨Subobject.mk f,
    AlgebraSheaf.IsQuasicoherent.of_iso (Subobject.underlyingIso f).symm
      (AlgebraSheaf.isQuasicoherent_adjoin D hA),
    AlgebraSheaf.IsFiniteType.of_iso (Subobject.underlyingIso f).symm
      (AlgebraSheaf.isFiniteType_adjoin D hA)⟩,
    ((Subobject.underlyingIso f).inv.right.hom.app (op U))
      ⟨x, AlgebraSheaf.mem_adjoinSubpresheaf_of_mem D U hD⟩, ?_⟩
  exact congrArg (fun φ => (φ.right.hom.app (op U))
    ⟨x, AlgebraSheaf.mem_adjoinSubpresheaf_of_mem D U hD⟩) (Subobject.underlyingIso_arrow f)

/-! ### Stacks 082B -/

/-- **Stacks 082B.** Let `S` be a scheme, `X` a quasi-compact and quasi-separated algebraic
space over `S` and `𝒜` a quasi-coherent `𝒪_X`-algebra.  Then `𝒜` is the directed colimit of its
finite type quasi-coherent `𝒪_X`-subalgebras: they form a filtered category, and the cocone of
their inclusions into `𝒜` is a colimit cocone.

Directedness is `AlgebraicGeometry.Space.isFiltered_finiteTypeSubalgebra`.  The cocone is a
colimit because its legs are injective on sections and, by
`AlgebraicGeometry.Space.exists_finiteTypeSubalgebra_section`, jointly surjective on the
sections over affine étale charts. -/
@[stacks 082B]
theorem isFiltered_and_isColimit_finiteTypeSubalgebraCocone (hZ : B.Contains (⊤_ Scheme.{u}))
    (X : AlgebraicSpaces B S hS) (hqc : IsQuasiCompactSpace B S hS X.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1) (A : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (hA : A.IsQuasicoherent) :
    IsFiltered (FiniteTypeSubalgebra B S hS X.1 X.2 A) ∧
      Nonempty (IsColimit (finiteTypeSubalgebraCocone B S hS X.1 X.2 A)) := by
  have := isFiltered_finiteTypeSubalgebra X A hA
  refine ⟨inferInstance, ?_⟩
  refine AlgebraSheaf.nonempty_isColimit_of_affineChartSections_of_injective _
    (fun U _ E => AlgebraSheaf.injective_subobject_arrow_app E.obj (op U))
    fun U hU x => exists_finiteTypeSubalgebra_section hZ hqc hqs A hA U hU x

end AlgebraicGeometry.Space

