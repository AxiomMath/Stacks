/-!
# The canonical map `Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` is surjective, and bijective in degrees 0 and 1

Let `i : Z ⟶ X` be an immersion of algebraic spaces over a scheme `S`, with conormal algebra
`𝒞_{Z/X,*}` of Stacks 09RN and conormal sheaf `𝒞_{Z/X} = 𝒞_{Z/X,1}`.  Equation 76.6.1.2 of
**Stacks 09RQ** is the canonical map

`Φ : Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}`

of quasi-coherent graded `𝒪_Z`-algebras, and the source asserts that it is **surjective** and an
**isomorphism in degrees `0` and `1`**.  The map itself is
`AlgebraicGeometry.Space.symmetricAlgebraToConormalAlgebra`; this file proves the assertions.

## The argument

The conormal algebra is the inverse image `i^*G` of the graded algebra `G = ⨁_{n ≥ 0} 𝓘ⁿ` of the
powers of the kernel ideal sheaf `𝓘` on `X`.  Let `Ψ : Sym(𝓘) ⟶ G` be the unital homomorphism
extending the identity of `𝓘 = G_1`.  It is surjective in every nonnegative degree: it is split
surjective in degree one, invertible in degree zero (both degree-zero pieces are `𝒪_X`, see
`SheafOfModules.GradedAlgebra.isIso_unitalHom_app_zero`), and `𝓘^{n+1}` is locally generated by
products of sections of `𝓘ⁿ` and `𝓘` (`SheafOfModules.epi_unitalHom_app_of_nonneg`).  Inverse
image is a left adjoint, so `i^*Ψ` is still surjective in every nonnegative degree and invertible
in degree zero; and `i^*Sym(𝓘) ≅ Sym(i^*𝓘) = Sym(𝒞_{Z/X})` by
`Stacks.Sheaves.GradedAlgebraEssentiallySmall.isIso_symmetricPullbackHom_app` (Stacks 0FQX).
The composite `Sym(𝒞_{Z/X}) ⟶ i^*Sym(𝓘) ⟶ i^*G = 𝒞_{Z/X,*}` is the identity on the generator,
so it is `Φ`, by the uniqueness clause of the universal property.  In negative degrees the target
is zero.  In degree one, `Φ` is a left inverse of the generator, which is an isomorphism
(`PresheafOfModules.isIso_symmetricAlgebraSheafifyGen`).

## Main results

* `AlgebraicGeometry.Space.epi_symmetricAlgebraToConormalAlgebra_app`: `Φ` is surjective in
  every degree.
* `AlgebraicGeometry.Space.isIso_symmetricAlgebraToConormalAlgebra_app_zero` and
  `isIso_symmetricAlgebraToConormalAlgebra_app_one`: `Φ` is an isomorphism in degrees `0` and `1`.
* `AlgebraicGeometry.Space.symmetricAlgebraToConormalAlgebra_surjective_isIso_zero_one` and
  `symmetricAlgebraToConormalAlgebraOfImmersion_surjective_isIso_zero_one`: **Stacks 09RQ**, for
  any morphism and for an immersion; the immersion form also records that the two graded algebras
  are quasi-coherent.

## Supporting results

* `SheafOfModules.reesPieceZeroIso`: degree zero of `⨁_{n ≥ 0} 𝓘ⁿ` is the structure sheaf.
* `AlgebraicGeometry.Space.symmetricAlgebraPieceZeroIso` and
  `AlgebraicGeometry.Space.isIso_symmetricAlgebraGen`: degree zero of `Sym(F)` on an algebraic space
  is the structure sheaf, and the degree-one generator `F ⟶ Sym¹(F)` is an isomorphism.

## References

* [Stacks Project, Tag 09RQ](https://stacks.math.columbia.edu/tag/09RQ)
* [Stacks Project, Tag 09RN](https://stacks.math.columbia.edu/tag/09RN)
* [Stacks Project, Tag 0FQX](https://stacks.math.columbia.edu/tag/0FQX)
* [Stacks Project, Section 17.21](https://stacks.math.columbia.edu/tag/01CF)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

/-! ### Degree zero of the graded algebra of the powers of a sheaf of ideals -/

namespace SheafOfModules

universe t v u

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}
  (I : (unit R).Submodule)

/-- Every section of the structure sheaf lies in the zeroth power of a sheaf of ideals. -/
theorem mem_idealAt_idealSheafZPow_zero {X : Cᵒᵖ} (x : ToType (R.obj.obj X)) :
    x ∈ idealAt (idealSheafZPow I 0) X := by
  rw [show (0 : ℤ) = ((0 : ℕ) : ℤ) from rfl, idealSheafZPow_natCast]
  exact mem_idealSheafPow_zero I x

/-- The inverse of the inclusion of the zeroth power of a sheaf of ideals into the structure
sheaf. -/
def reesPieceZeroInv : unit R ⟶ reesPiece I 0 where
  val :=
    { app _ := ModuleCat.ofHom
        { toFun x := reesMk I (n := 0) x (mem_idealAt_idealSheafZPow_zero I x)
          map_add' _ _ := rfl
          map_smul' _ _ := rfl }
      naturality _ := rfl }

/-- **Degree zero of `⨁_{n ≥ 0} 𝓘ⁿ` is the structure sheaf**: the zeroth power of a sheaf of
ideals is the whole structure sheaf, by the inclusion. -/
def reesPieceZeroIso : reesPiece I 0 ≅ unit R where
  hom := (idealSheafZPow I 0).ι
  inv := reesPieceZeroInv I
  hom_inv_id := rfl
  inv_hom_id := rfl

/-- The identification of degree zero carries the unit to `1`. -/
theorem reesPieceZeroIso_hom_one (X : Cᵒᵖ) :
    (reesPieceZeroIso I).hom.val.app X ((reesOne I).eval X) = (1 : R.obj.obj X) :=
  rfl

end SheafOfModules

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Degrees zero and one of the symmetric algebra on an algebraic space -/

section SymmetricAlgebra

variable (W : AlgebraicSpaces B S hS) (F : SheafOfModules.{u} (structureRingSheaf B S hS W))

/-- **Degree zero of `Sym(F)` is the structure sheaf.** -/
def symmetricAlgebraPieceZeroIso :
    (symmetricAlgebra B S hS W F).piece 0 ≅ SheafOfModules.unit (structureRingSheaf B S hS W) :=
  @PresheafOfModules.symmetricAlgebraSheafifyPieceZeroIso _ _
    (SmallEtale.topology B S hS W.1) (structureSheaf B S hS W.1 W.2).obj
    (structureRingSheaf B S hS W) (𝟙 _) (isLocallyInjective_id_structureRingSheaf B S hS W)
    (isLocallySurjective_id_structureRingSheaf B S hS W)
    (wEqualsLocallyBijective_smallEtale B S hS W) (hasWeakSheafify_smallEtale B S hS W) F.val

/-- The identification of degree zero of `Sym(F)` carries the unit to `1`. -/
theorem symmetricAlgebraPieceZeroIso_hom_one (V : (SmallEtale B S hS W.1)ᵒᵖ) :
    (symmetricAlgebraPieceZeroIso B S hS W F).hom.val.app V
        ((symmetricAlgebra B S hS W F).one.eval V) =
      (1 : (structureRingSheaf B S hS W).obj.obj V) :=
  @PresheafOfModules.symmetricAlgebraSheafifyPieceZeroIso_hom_one _ _
    (SmallEtale.topology B S hS W.1) (structureSheaf B S hS W.1 W.2).obj
    (structureRingSheaf B S hS W) (𝟙 _) (isLocallyInjective_id_structureRingSheaf B S hS W)
    (isLocallySurjective_id_structureRingSheaf B S hS W)
    (wEqualsLocallyBijective_smallEtale B S hS W) (hasWeakSheafify_smallEtale B S hS W) F.val V

/-- **The degree-one generator `F ⟶ Sym¹(F)` of the symmetric algebra on an algebraic space is
an isomorphism.** -/
theorem isIso_symmetricAlgebraGen : IsIso (symmetricAlgebraGen B S hS W F) := by
  have := @PresheafOfModules.isIso_symmetricAlgebraSheafifyGen _ _
    (SmallEtale.topology B S hS W.1) (structureSheaf B S hS W.1 W.2).obj
    (structureRingSheaf B S hS W) (𝟙 _) (isLocallyInjective_id_structureRingSheaf B S hS W)
    (isLocallySurjective_id_structureRingSheaf B S hS W)
    (wEqualsLocallyBijective_smallEtale B S hS W) (hasWeakSheafify_smallEtale B S hS W) F.val
  unfold symmetricAlgebraGen
  exact IsIso.comp_isIso' (Iso.isIso_inv _) this

end SymmetricAlgebra

/-! ### The comparison through the symmetric algebra of the ideal sheaf -/

section Comparison

open Stacks.Sheaves.GradedAlgebraEssentiallySmall
open SheafOfModules.GradedAlgebra

variable {X Z : AlgebraicSpaces B S hS} (i : Z ⟶ X)

/-- The ideal sheaf `𝓘 = G_1` of `i`, the degree-one piece of `G = ⨁_{n ≥ 0} 𝓘ⁿ`. -/
abbrev kernelIdealPieceOne : SheafOfModules.{u} (structureRingSheaf B S hS X) :=
  (kernelIdealGradedAlgebra B S hS i).piece 1

/-- The identity of `𝓘 = G_1` has pairwise commuting image in `G`. -/
theorem pairwiseCommutes_id_kernelIdealGradedAlgebra :
    PairwiseCommutes (A := kernelIdealGradedAlgebra B S hS i)
      (𝟙 (kernelIdealPieceOne B S hS i)) :=
  fun V s u ↦ kernelIdealGradedAlgebra_mul_comm B S hS i 1 V s u

/-- **The homomorphism `Ψ : Sym(𝓘) ⟶ ⨁_{n ≥ 0} 𝓘ⁿ` extending the identity of `𝓘`.** -/
def kernelIdealSymmetricAlgebraHom :
    UnitalHom (symmetricAlgebra B S hS X (kernelIdealPieceOne B S hS i))
      (kernelIdealGradedAlgebra B S hS i) :=
  (isSymmetricAlgebra_symmetricAlgebra B S hS X (kernelIdealPieceOne B S hS i)).isUniversal.desc
    _ (𝟙 _) (pairwiseCommutes_id_kernelIdealGradedAlgebra B S hS i)

/-- `Ψ` is the identity on the generator of `Sym(𝓘)`. -/
theorem symmetricAlgebraGen_comp_kernelIdealSymmetricAlgebraHom_app_one :
    symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i) ≫
        (kernelIdealSymmetricAlgebraHom B S hS i).app 1 = 𝟙 _ :=
  (isSymmetricAlgebra_symmetricAlgebra B S hS X
    (kernelIdealPieceOne B S hS i)).isUniversal.desc_extends _ _ _

/-- `Ψ` is an isomorphism in degree one: it is a left inverse of the generator, which is an
isomorphism. -/
theorem isIso_kernelIdealSymmetricAlgebraHom_app_one :
    IsIso ((kernelIdealSymmetricAlgebraHom B S hS i).app 1) := by
  have := isIso_symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i)
  have h := symmetricAlgebraGen_comp_kernelIdealSymmetricAlgebraHom_app_one B S hS i
  have : IsIso (symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i) ≫
      (kernelIdealSymmetricAlgebraHom B S hS i).app 1) := by
    rw [h]; infer_instance
  exact IsIso.of_isIso_comp_left (symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i)) _

/-- `Ψ` is an isomorphism in degree zero: both degree-zero pieces are the structure sheaf. -/
theorem isIso_kernelIdealSymmetricAlgebraHom_app_zero :
    IsIso ((kernelIdealSymmetricAlgebraHom B S hS i).app 0) :=
  isIso_unitalHom_app_zero (symmetricAlgebraPieceZeroIso B S hS X (kernelIdealPieceOne B S hS i))
    (symmetricAlgebraPieceZeroIso_hom_one B S hS X (kernelIdealPieceOne B S hS i))
    (SheafOfModules.reesPieceZeroIso (kernelIdealSheaf B S hS i))
    (SheafOfModules.reesPieceZeroIso_hom_one (kernelIdealSheaf B S hS i))
    (kernelIdealSymmetricAlgebraHom B S hS i)

/-- **`Ψ` is surjective in every nonnegative degree**, `𝓘^{n+1}` being locally generated by
products of sections of `𝓘ⁿ` and of `𝓘`. -/
theorem epi_kernelIdealSymmetricAlgebraHom_app (n : ℤ) (hn : 0 ≤ n) :
    Epi ((kernelIdealSymmetricAlgebraHom B S hS i).app n) := by
  have h0 := isIso_kernelIdealSymmetricAlgebraHom_app_zero B S hS i
  have h1 := isIso_kernelIdealSymmetricAlgebraHom_app_one B S hS i
  exact SheafOfModules.epi_unitalHom_app_of_nonneg (structureRingSheaf B S hS X).property
    (kernelIdealSheaf B S hS i) (kernelIdealSymmetricAlgebraHom B S hS i)
    (@IsIso.epi_of_iso _ _ _ _ _ h0) (@IsIso.epi_of_iso _ _ _ _ _ h1) n hn

/-- The symmetric algebra of the conormal module `𝒞_{Z/X} = i^*𝓘`. -/
abbrev conormalSymmetricAlgebra :
    SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z) :=
  symmetricAlgebra B S hS Z ((conormalAlgebra B S hS i).piece 1)

/-- The comparison `Sym(𝒞_{Z/X}) ⟶ i^*Sym(𝓘)` of Stacks 0FQX. -/
def conormalSymmetricAlgebraPullbackHom :
    UnitalHom (conormalSymmetricAlgebra B S hS i)
      ((gradedPull (X := smallEtaleRingedTopos B S hS Z) (Y := smallEtaleRingedTopos B S hS X)
        (smallEtaleRingedToposHom B S hS i)).obj
          (symmetricAlgebra B S hS X (kernelIdealPieceOne B S hS i))) :=
  symmetricPullbackHom (X := smallEtaleRingedTopos B S hS Z) (Y := smallEtaleRingedTopos B S hS X)
    (smallEtaleRingedToposHom B S hS i)
    (symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i))
    (fun V x y => eq_of_heq (symmetricAlgebra_mul_comm B S hS X _ 1 1 V x y))
    (symmetricAlgebraGen B S hS Z ((conormalAlgebra B S hS i).piece 1))
    (isSymmetricAlgebra_symmetricAlgebra B S hS Z ((conormalAlgebra B S hS i).piece 1))

/-- The comparison `Sym(𝒞_{Z/X}) ⟶ i^*Sym(𝓘)` is an isomorphism in every degree. -/
instance isIso_conormalSymmetricAlgebraPullbackHom_app (n : ℤ) :
    IsIso ((conormalSymmetricAlgebraPullbackHom B S hS i).app n) :=
  isIso_symmetricPullbackHom_app (X := smallEtaleRingedTopos B S hS Z)
    (Y := smallEtaleRingedTopos B S hS X)
    (smallEtaleRingedToposHom B S hS i)
    (symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i))
    (isSymmetricAlgebra_symmetricAlgebra B S hS X (kernelIdealPieceOne B S hS i))
    (fun V x y => eq_of_heq (symmetricAlgebra_mul_comm B S hS X _ 1 1 V x y))
    (symmetricAlgebraGen B S hS Z ((conormalAlgebra B S hS i).piece 1))
    (isSymmetricAlgebra_symmetricAlgebra B S hS Z ((conormalAlgebra B S hS i).piece 1))
    (fun V x y => eq_of_heq (symmetricAlgebra_mul_comm B S hS Z _ 1 1 V x y)) n

/-- **The canonical map `Sym(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}`, factored** as the comparison
`Sym(𝒞_{Z/X}) ⟶ i^*Sym(𝓘)` followed by the inverse image of `Ψ`. -/
def conormalSymmetricAlgebraFactorization :
    UnitalHom (conormalSymmetricAlgebra B S hS i) (conormalAlgebra B S hS i) :=
  (conormalSymmetricAlgebraPullbackHom B S hS i).comp
    (unitalGradedPull (X := smallEtaleRingedTopos B S hS Z) (Y := smallEtaleRingedTopos B S hS X)
      (smallEtaleRingedToposHom B S hS i) (kernelIdealSymmetricAlgebraHom B S hS i))

/-- In each degree the factored map is the comparison followed by the inverse image of `Ψ`. -/
theorem conormalSymmetricAlgebraFactorization_app (n : ℤ) :
    (conormalSymmetricAlgebraFactorization B S hS i).app n =
      (conormalSymmetricAlgebraPullbackHom B S hS i).app n ≫
        (modulePullback B S hS i).map ((kernelIdealSymmetricAlgebraHom B S hS i).app n) :=
  rfl

/-- The factored map is the identity on the generator. -/
theorem symmetricAlgebraGen_comp_conormalSymmetricAlgebraFactorization_app_one :
    symmetricAlgebraGen B S hS Z ((conormalAlgebra B S hS i).piece 1) ≫
        (conormalSymmetricAlgebraFactorization B S hS i).app 1 = 𝟙 _ := by
  have h : symmetricAlgebraGen B S hS Z ((conormalAlgebra B S hS i).piece 1) ≫
      (conormalSymmetricAlgebraPullbackHom B S hS i).app 1 =
        (modulePullback B S hS i).map
          (symmetricAlgebraGen B S hS X (kernelIdealPieceOne B S hS i)) :=
    gen_comp_symmetricPullbackHom_app_one (X := smallEtaleRingedTopos B S hS Z)
      (Y := smallEtaleRingedTopos B S hS X) _ _ _ _ _
  have h2 := congrArg (fun φ => φ ≫
    (modulePullback B S hS i).map ((kernelIdealSymmetricAlgebraHom B S hS i).app 1)) h
  refine (Category.assoc _ _ _).symm.trans (h2.trans ?_)
  refine ((modulePullback B S hS i).map_comp _ _).symm.trans ?_
  refine (congrArg (modulePullback B S hS i).map
    (symmetricAlgebraGen_comp_kernelIdealSymmetricAlgebraHom_app_one B S hS i)).trans ?_
  exact (modulePullback B S hS i).map_id _

end Comparison

/-! ### Stacks 09RQ -/

section Main

open SheafOfModules.GradedAlgebra

variable {X Z : AlgebraicSpaces B S hS} (i : Z ⟶ X)
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : (conormalAlgebra B S hS i).piece 1 ⟶ A.piece 1)
    (hA : IsSymmetricAlgebra A ι)

/-- The comparison from the given symmetric algebra `A` to the constructed one. -/
def symmetricAlgebraComparison : UnitalHom A (conormalSymmetricAlgebra B S hS i) :=
  hA.isUniversal.desc _ (symmetricAlgebraGen B S hS Z ((conormalAlgebra B S hS i).piece 1))
    (isSymmetricAlgebra_symmetricAlgebra B S hS Z ((conormalAlgebra B S hS i).piece 1)).1

/-- The comparison of `A` with the constructed symmetric algebra is an isomorphism in every
degree. -/
instance isIso_symmetricAlgebraComparison_app (n : ℤ) :
    IsIso ((symmetricAlgebraComparison B S hS i A ι hA).app n) :=
  (hA.isUniversal.pieceIso
    (isSymmetricAlgebra_symmetricAlgebra B S hS Z
      ((conormalAlgebra B S hS i).piece 1)).isUniversal n).isIso_hom

/-- **The canonical map of Equation 76.6.1.2 factors** through the comparison of `A` with the
constructed symmetric algebra, the comparison of Stacks 0FQX, and the inverse image of `Ψ`. -/
theorem symmetricAlgebraToConormalAlgebra_eq_comp :
    symmetricAlgebraToConormalAlgebra B S hS i A ι hA =
      (symmetricAlgebraComparison B S hS i A ι hA).comp
        (conormalSymmetricAlgebraFactorization B S hS i) := by
  refine (symmetricAlgebraToConormalAlgebra_unique B S hS i A ι hA _ ?_).symm
  have h : ι ≫ (symmetricAlgebraComparison B S hS i A ι hA).app 1 =
      symmetricAlgebraGen B S hS Z ((conormalAlgebra B S hS i).piece 1) :=
    hA.isUniversal.desc_extends _ _ _
  rw [UnitalHom.comp_app, ← Category.assoc, h]
  exact symmetricAlgebraGen_comp_conormalSymmetricAlgebraFactorization_app_one B S hS i

/-- **The canonical map `Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` is surjective in every degree.** -/
theorem epi_symmetricAlgebraToConormalAlgebra_app (n : ℤ) :
    Epi ((symmetricAlgebraToConormalAlgebra B S hS i A ι hA).app n) := by
  rcases lt_or_ge n 0 with hn | hn
  · exact (isZero_conormalAlgebra_piece_of_neg B S hS i hn).epi _
  · have h := epi_kernelIdealSymmetricAlgebraHom_app B S hS i n hn
    rw [symmetricAlgebraToConormalAlgebra_eq_comp, UnitalHom.comp_app,
      conormalSymmetricAlgebraFactorization_app]
    exact epi_comp' (@IsIso.epi_of_iso _ _ _ _ _ (isIso_symmetricAlgebraComparison_app B S hS i
      A ι hA n)) (epi_comp' (@IsIso.epi_of_iso _ _ _ _ _
        (isIso_conormalSymmetricAlgebraPullbackHom_app B S hS i n))
      (@Functor.map_epi _ _ _ _ (modulePullback B S hS i)
        (preservesEpimorphisms_modulePullback B S hS i) _ _ _ h))

/-- **The canonical map `Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` is an isomorphism in degree zero.** -/
theorem isIso_symmetricAlgebraToConormalAlgebra_app_zero :
    IsIso ((symmetricAlgebraToConormalAlgebra B S hS i A ι hA).app 0) := by
  have h := isIso_kernelIdealSymmetricAlgebraHom_app_zero B S hS i
  rw [symmetricAlgebraToConormalAlgebra_eq_comp, UnitalHom.comp_app,
    conormalSymmetricAlgebraFactorization_app]
  exact IsIso.comp_isIso' (isIso_symmetricAlgebraComparison_app B S hS i A ι hA 0)
    (IsIso.comp_isIso' (isIso_conormalSymmetricAlgebraPullbackHom_app B S hS i 0)
      ((modulePullback B S hS i).mapIso (@asIso _ _ _ _ _ h)).isIso_hom)

/-- **The canonical map `Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` is an isomorphism in degree one.** -/
theorem isIso_symmetricAlgebraToConormalAlgebra_app_one :
    IsIso ((symmetricAlgebraToConormalAlgebra B S hS i A ι hA).app 1) := by
  have h := isIso_kernelIdealSymmetricAlgebraHom_app_one B S hS i
  rw [symmetricAlgebraToConormalAlgebra_eq_comp, UnitalHom.comp_app,
    conormalSymmetricAlgebraFactorization_app]
  exact IsIso.comp_isIso' (isIso_symmetricAlgebraComparison_app B S hS i A ι hA 1)
    (IsIso.comp_isIso' (isIso_conormalSymmetricAlgebraPullbackHom_app B S hS i 1)
      ((modulePullback B S hS i).mapIso (@asIso _ _ _ _ _ h)).isIso_hom)

/-- **Stacks Project, Tag 09RQ.**  Let `i : Z ⟶ X` be a morphism of algebraic spaces (for
instance a closed immersion), with conormal algebra `𝒞_{Z/X,*}` and conormal module
`𝒞_{Z/X} = 𝒞_{Z/X,1}`, and let `A` be the symmetric algebra `Sym^*(𝒞_{Z/X})`, given by its
universal property.  The canonical map `Φ : Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` of graded
`𝒪_Z`-algebras (`AlgebraicGeometry.Space.symmetricAlgebraToConormalAlgebra`, the unique unital
homomorphism extending the identity of `𝒞_{Z/X}`) is surjective in every degree and an
isomorphism in degrees `0` and `1`. -/
@[stacks 09RQ "the canonical map Sym^*(C_{Z/X}) → C_{Z/X,*} is surjective in every degree and an \
isomorphism in degrees 0 and 1; stated for any morphism of algebraic spaces, a closed immersion in \
particular; the map is symmetricAlgebraToConormalAlgebra, unique by \
symmetricAlgebraToConormalAlgebra_unique"]
theorem symmetricAlgebraToConormalAlgebra_surjective_isIso_zero_one :
    (∀ n : ℤ, Epi ((symmetricAlgebraToConormalAlgebra B S hS i A ι hA).app n)) ∧
      IsIso ((symmetricAlgebraToConormalAlgebra B S hS i A ι hA).app 0) ∧
      IsIso ((symmetricAlgebraToConormalAlgebra B S hS i A ι hA).app 1) :=
  ⟨epi_symmetricAlgebraToConormalAlgebra_app B S hS i A ι hA,
    isIso_symmetricAlgebraToConormalAlgebra_app_zero B S hS i A ι hA,
    isIso_symmetricAlgebraToConormalAlgebra_app_one B S hS i A ι hA⟩

end Main

/-! ### The case of an immersion -/

section Immersion

attribute [local instance] pointTopology

variable {Z₀ X₀ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- **Stacks Project, Tag 09RQ, for an immersion.**  Let `i : Z ⟶ X` be an immersion of
algebraic spaces over `S`, with conormal algebra `𝒞_{Z/X,*}` (Stacks 09RN, through the closed
factorisation of Stacks 04CE) and conormal sheaf `𝒞_{Z/X} = 𝒞_{Z/X,1}`, and let `A` be the
symmetric algebra `Sym^*(𝒞_{Z/X})`, given by its universal property.  Then:

* `𝒞_{Z/X,*}` and `Sym^*(𝒞_{Z/X})` are quasi-coherent graded `𝒪_Z`-algebras: every homogeneous
  piece of nonnegative degree is quasi-coherent, and the pieces of negative degree vanish;
