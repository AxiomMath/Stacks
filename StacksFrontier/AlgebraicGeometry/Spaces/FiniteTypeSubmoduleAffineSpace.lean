/-!
# Finitely many sections of a quasi-coherent module on an affine algebraic space

Let `F` be an affine algebraic space and `M` a quasi-coherent `𝒪_F`-module on the small étale
site. Finitely many sections of `M` over affine étale charts of `F` lie in a quasi-coherent
submodule of finite type of `M`. This is the affine case of the module form of [Stacks, Tag 0829]
(every quasi-coherent module on a quasi-compact quasi-separated algebraic space is the directed
union of its quasi-coherent submodules of finite type), the base of the induction
[Stacks, Tag 08GP] proving it.

The submodule is generated by finitely many sections over a terminal affine chart: an affine
algebraic space `F ≅ h_T` has the terminal chart `h_T ≅ F`
(`AlgebraicGeometry.Space.affineSpaceChart`), and a section `s` of `M` over an affine chart
`V` is a finite sum `∑ b • a|_V` of restrictions of sections `a` over the terminal chart, because
the base change comparison `𝒪(V) ⊗ M(T) ⟶ M(V)` is bijective (Stacks 03DX(2),
`AlgebraicGeometry.Space.bijective_sectionsBaseChange_of_isQuasicoherentOnSite`). The submodule
generated by the `a` is the image of the morphism `𝒪ⁿ ⟶ M` they define.

## Main definitions

* `AlgebraicGeometry.Space.terminalSectionsHom`: the morphism `𝒪^I ⟶ M` defined by a family of
  sections of `M` over a terminal chart.
* `AlgebraicGeometry.Space.affineSpaceChart`: the chart of an affine algebraic space given by an
  identification with a represented presheaf; it is terminal
  (`AlgebraicGeometry.Space.isTerminalAffineSpaceChart`).

## Main results

* `AlgebraicGeometry.Space.isFiniteTypeOnSite_imageSubmodule_terminalSectionsHom`: the image of
  `𝒪^I ⟶ M` is of finite type for `I` finite.
* `AlgebraicGeometry.Space.exists_isFiniteType_submodule_mem_of_isTerminal`: **finitely many
  sections of a quasi-coherent module over affine charts lie in a quasi-coherent submodule of
  finite type**, when the site has a terminal affine chart.
* `AlgebraicGeometry.Space.exists_isFiniteType_submodule_mem_of_isAffineSpace`: the same for an
  affine algebraic space.

## References

* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.SheafOfModules.ImageSubsheaf

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-! ### The submodule generated by sections over a terminal chart -/

/-- The morphism `𝒪^I ⟶ M` defined by a family of sections of `M` over a terminal chart. -/
noncomputable def terminalSectionsHom (M : Modules.{u, u} B S hS F hF)
    {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀) {I : Type u}
    (a : I → M.val.obj (op T₀)) : SheafOfModules.free I ⟶ M :=
  M.freeHomEquiv.symm fun i =>
    (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT₀).symm (a i)

/-- The morphism `𝒪^I ⟶ M` sends the `i`-th free section over the terminal chart to `a i`. -/
theorem terminalSectionsHom_app_freeSection (M : Modules.{u, u} B S hS F hF)
    {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀) {I : Type u}
    (a : I → M.val.obj (op T₀)) (i : I) :
    (terminalSectionsHom M hT₀ a).val.app (op T₀)
      ((SheafOfModules.freeSection (R := (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)) i).val (op T₀)) = a i := by
  have h := congrArg (fun s => s.val (op T₀))
    (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection (M := M)
      (fun i => (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT₀).symm
        (a i)) i)
  exact h.trans
    ((Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M hT₀).apply_symm_apply
      (a i))

/-- The sections defining `𝒪^I ⟶ M` lie in its image submodule. -/
theorem mem_imageSubmodule_terminalSectionsHom (M : Modules.{u, u} B S hS F hF)
    {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀) {I : Type u}
    (a : I → M.val.obj (op T₀)) (i : I) :
    a i ∈ (imageSubmodule (terminalSectionsHom M hT₀ a)).obj (op T₀) :=
  terminalSectionsHom_app_freeSection M hT₀ a i ▸
    apply_mem_imageSubmodule (terminalSectionsHom M hT₀ a) _

/-- The image of `𝒪^I ⟶ M` is quasi-coherent when `M` is. -/
theorem isQuasicoherentOnSite_imageSubmodule_terminalSectionsHom
    (M : Modules.{u, u} B S hS F hF) (hM : M.IsQuasicoherentOnSite)
    {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀) {I : Type u}
    (a : I → M.val.obj (op T₀)) :
    (imageSubmodule (terminalSectionsHom M hT₀ a)).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_imageSubmodule _
    (isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
      (isCartesianOnAffineCharts_free (hF := hF) I)) hM

/-- **The image of `𝒪^I ⟶ M` is of finite type for `I` finite**: it is generated by the images
of the `I` free sections. -/
theorem isFiniteTypeOnSite_imageSubmodule_terminalSectionsHom
    (M : Modules.{u, u} B S hS F hF) {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀)
    {I : Type u} [Finite I] (a : I → M.val.obj (op T₀)) :
    (imageSubmodule (terminalSectionsHom M hT₀ a)).toSheafOfModules.IsFiniteTypeOnSite := by
  let ψ := toImageSubmodule (terminalSectionsHom M hT₀ a)
  let σ : (imageSubmodule (terminalSectionsHom M hT₀ a)).toSheafOfModules.GeneratingSections :=
    { I := I
      s := (imageSubmodule (terminalSectionsHom M hT₀ a)).toSheafOfModules.freeHomEquiv ψ
      epi := by
        rw [Equiv.symm_apply_apply]
        exact epi_toImageSubmodule _ }
  have : σ.IsFiniteType := ⟨inferInstanceAs (Finite I)⟩
  exact Stacks.SheafOfModules.isFiniteTypeOnSite_of_isFiniteType _
    ⟨⟨σ.localGeneratorsData, ⟨fun _ => ⟨inferInstanceAs (Finite I)⟩⟩⟩⟩

/-! ### Finitely many sections over affine charts -/

/-- **Finitely many sections of a quasi-coherent module over affine charts lie in a
quasi-coherent submodule of finite type**, when the small étale site has a terminal affine
chart `T₀`. Each section is a finite sum `∑ b • a|_V` with `a` a section over `T₀`
(Stacks 03DX(2)); the submodule is the image of the morphism `𝒪ⁿ ⟶ M` defined by the
finitely many sections `a` so obtained. -/
theorem exists_isFiniteType_submodule_mem_of_isTerminal (M : Modules.{u, u} B S hS F hF)
    (hM : M.IsQuasicoherentOnSite) {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀)
    (hT₀a : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj T₀))
    {ι : Type*} [Finite ι] (T : ι → SmallEtale B S hS F)
    (hT : ∀ i, IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj (T i)))
    (s : ∀ i, M.val.obj (op (T i))) :
    ∃ N : M.Submodule, N.toSheafOfModules.IsQuasicoherentOnSite ∧
      N.toSheafOfModules.IsFiniteTypeOnSite ∧ ∀ i, s i ∈ N.obj (op (T i)) := by
  classical
  have hz : ∀ i, ∃ z, sectionsBaseChange M (hT₀.from (T i)) z = s i := fun i =>
    (bijective_sectionsBaseChange_of_isQuasicoherentOnSite B S hS F hF M hM hT₀a (hT i)
      (hT₀.from (T i))).2 (s i)
  choose z hz using hz
  have hS : ∀ i, ∃ P : Finset (chartRing B S hS F hF (T i) × M.val.obj (op T₀)),
      let := chartAlgebra (hF := hF) (hT₀.from (T i))
      z i = P.sum fun p => p.1 ⊗ₜ[chartRing B S hS F hF T₀] p.2 := fun i => by
    let := chartAlgebra (hF := hF) (hT₀.from (T i))
    exact TensorProduct.exists_finset (z i)
  choose P hP using hS
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  let I : Type u := ULift.{u} (Σ k : Fin n, ↥(P (e.symm k)))
  have : Finite I := inferInstance
  let a : I → M.val.obj (op T₀) := fun k => k.down.2.1.2
  refine ⟨imageSubmodule (terminalSectionsHom M hT₀ a),
    isQuasicoherentOnSite_imageSubmodule_terminalSectionsHom M hM hT₀ a,
    isFiniteTypeOnSite_imageSubmodule_terminalSectionsHom M hT₀ a, fun i => ?_⟩
  obtain ⟨k, rfl⟩ := e.symm.surjective i
  rw [← hz, hP, map_sum]
  refine Submodule.sum_mem _ fun p hp => ?_
  rw [chartBaseChange_tmul]
  refine Submodule.smul_mem _ _ ?_
  exact (imageSubmodule (terminalSectionsHom M hT₀ a)).map_mem (hT₀.from (T (e.symm k))).op
    (mem_imageSubmodule_terminalSectionsHom M hT₀ a ⟨⟨k, ⟨p, hp⟩⟩⟩)

/-! ### The terminal chart of an affine algebraic space -/

/-- The chart of an algebraic space `F` given by an identification `F ≅ h_T` with a represented
presheaf: the inverse isomorphism, an étale chart. -/
noncomputable def affineSpaceChart {T : BigFppfOver B S hS} (e : F ≅ yoneda.obj T) :
    SmallEtale B S hS F :=
  ⟨CostructuredArrow.mk e.inv,
    (isEtale_iff_presheaf_of_yoneda B S hS e.inv).1 (isEtale_of_isIso B S hS e.inv)⟩

/-- The chart scheme of `AlgebraicGeometry.Space.affineSpaceChart` is the representing scheme. -/
theorem affineSpaceChart_scheme {T : BigFppfOver B S hS} (e : F ≅ yoneda.obj T) :
    (SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj (affineSpaceChart e) =
      (BigFppfOver.toScheme B S hS).obj T :=
  rfl

/-- **The chart `h_T ≅ F` is terminal** among the étale charts of `F`: every chart factors
uniquely through it, `yoneda` being fully faithful. -/
noncomputable def isTerminalAffineSpaceChart {T : BigFppfOver B S hS} (e : F ≅ yoneda.obj T) :
    IsTerminal (affineSpaceChart e) := by
  have key : ∀ (X : BigFppfOver B S hS) (g : yoneda.obj X ⟶ F),
      yoneda.map (yoneda.preimage (g ≫ e.hom)) ≫ e.inv = g := fun X g => by
    rw [Functor.map_preimage, Category.assoc, e.hom_inv_id, Category.comp_id]
  have key₂ : ∀ (X : BigFppfOver B S hS) (g : yoneda.obj X ⟶ F) (k : X ⟶ T),
      yoneda.map k ≫ e.inv = g → k = yoneda.preimage (g ≫ e.hom) := fun X g k h => by
    apply yoneda.map_injective
    rw [Functor.map_preimage, ← h, Category.assoc, e.inv_hom_id, Category.comp_id]
  exact IsTerminal.ofUniqueHom
    (fun A => ObjectProperty.homMk (CostructuredArrow.homMk
      (yoneda.preimage (A.1.hom ≫ e.hom)) (key _ A.1.hom)))
    (fun A m => ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _
      (key₂ _ A.1.hom m.hom.left (CostructuredArrow.w m.hom))))

/-- **The affine case of the module form of Stacks 0829: finitely many sections of a
quasi-coherent module on an affine algebraic space over affine étale charts lie in a
quasi-coherent submodule of finite type.** -/
theorem exists_isFiniteType_submodule_mem_of_isAffineSpace (hFa : IsAffineSpace B S hS F)
    (M : Modules.{u, u} B S hS F hF) (hM : M.IsQuasicoherentOnSite)
    {ι : Type*} [Finite ι] (T : ι → SmallEtale B S hS F)
    (hT : ∀ i, IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj (T i)))
    (s : ∀ i, M.val.obj (op (T i))) :
    ∃ N : M.Submodule, N.toSheafOfModules.IsQuasicoherentOnSite ∧
      N.toSheafOfModules.IsFiniteTypeOnSite ∧ ∀ i, s i ∈ N.obj (op (T i)) := by
  obtain ⟨T₀, hT₀, ⟨e⟩⟩ := hFa
  exact exists_isFiniteType_submodule_mem_of_isTerminal M hM (isTerminalAffineSpaceChart e)
    hT₀ T hT s

end AlgebraicGeometry.Space

end
