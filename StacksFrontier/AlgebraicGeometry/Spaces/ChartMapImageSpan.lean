module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSections

/-!
# The image of a map of modules over a chart, along a morphism of affine charts

Let `F` be an algebraic space over a scheme `S` of a big fppf site `B`, let `u : M ⟶ N` be a map
of `𝒪_F`-modules and let `φ : V ⟶ U` be a morphism of étale scheme charts of `F` with `U` and
`V` affine.  If the source module is cartesian on affine charts — which quasi-coherence gives by
Stacks 03DX(2) — then the sections of `M` over `V` are generated by the restrictions of the
sections over `U`, and therefore the image `u(V)(M(V))` is generated over `𝒪_F(V)` by the
restrictions of `u(U)(M(U))`.

## Main results

* `AlgebraicGeometry.Space.chartRestrictLinear_val_app`: restriction of sections commutes with a
  map of modules.
* `AlgebraicGeometry.Space.val_app_mem_span_range_chartRestrictLinear`: **every value of `u` over
  the smaller affine chart lies in the `𝒪_F(V)`-submodule generated by the restrictions of the
  values of `u` over the larger one.**
* `AlgebraicGeometry.Space.range_val_app_eq_span_range_chartRestrictLinear`: the same as an
  equality of submodules — the image of `u(V)` *is* the `𝒪_F(V)`-span of the restrictions of the
  image of `u(U)`.

## Implementation notes

Cartesian-ness of the *source* module is all that is used, and only its surjectivity half:
`AlgebraicGeometry.Space.chartBaseChange_surjective_iff_span_eq_top` turns surjectivity of the
base change comparison of `M` at `φ` into the statement that the restrictions of `M(U)` span
`M(V)` over `𝒪_F(V)`, and `u(V)` is `𝒪_F(V)`-linear, so it carries that span into the span of
the images.  Nothing is assumed of `N`.

The naturality used is `CategoryTheory.PresheafOfModules.naturality_apply` on the underlying map
of presheaves of modules; `AlgebraicGeometry.Space.chartRestrictLinear` is by definition the
restriction map of the presheaf, so no comparison intervenes.

This is the second of the two ingredients that let a single ideal obtained at one affine chart of
an algebraic space serve at every chart over it, in the finite-presentation clause of
Stacks 083K: the values of `u` over any affine chart over a fixed one are combinations of
restrictions of the values over the fixed chart, hence are annihilated by the same ideal.

## References

* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 083K](https://stacks.math.columbia.edu/tag/083K)
-/

@[expose] public section

open CategoryTheory Opposite

universe u m

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-- **Restriction of sections along a morphism of étale charts commutes with a map of
modules.**  This is the naturality of the underlying map of presheaves of modules. -/
theorem chartRestrictLinear_val_app {M N : Modules.{u, m} B S hS F hF} (u : M ⟶ N)
    {U V : SmallEtale B S hS F} (φ : V ⟶ U) (z : M.val.obj (op U)) :
    u.val.app (op V) (chartRestrictLinear M φ z) =
      chartRestrictLinear N φ (u.val.app (op U) z) :=
  PresheafOfModules.naturality_apply u.val φ.op z

/-- **Every value of a map of modules over the smaller of two affine étale charts lies in the
submodule generated by the restrictions of the values over the larger one.**

The source module being cartesian on affine charts makes the restrictions of its sections over
`U` span its sections over `V` over the ring `𝒪_F(V)`, and `u(V)` is `𝒪_F(V)`-linear, so it
carries that span into the span of the restricted values. -/
theorem val_app_mem_span_range_chartRestrictLinear {M N : Modules.{u, m} B S hS F hF}
    (hM : IsCartesianOnAffineCharts M) (u : M ⟶ N) {U V : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (φ : V ⟶ U) (x : M.val.obj (op V)) :
    u.val.app (op V) x ∈ Submodule.span (chartRing B S hS F hF V)
      (Set.range fun z : M.val.obj (op U) =>
        chartRestrictLinear N φ (u.val.app (op U) z)) := by
  let := chartAlgebra (hF := hF) φ
  have hspan : Submodule.span (chartRing B S hS F hF V)
      (Set.range fun z : M.val.obj (op U) => chartRestrictLinear M φ z) = ⊤ :=
    (chartBaseChange_surjective_iff_span_eq_top M φ).1 (hM U V hU hV φ).2
  have hx : x ∈ Submodule.span (chartRing B S hS F hF V)
      (Set.range fun z : M.val.obj (op U) => chartRestrictLinear M φ z) := by
    rw [hspan]; exact Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨z, rfl⟩ := hy
    rw [chartRestrictLinear_val_app u φ z]
    exact Submodule.subset_span ⟨z, rfl⟩
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ _ ha

/-- **The image of a map of modules over the smaller of two affine étale charts is the submodule
generated by the restrictions of the image over the larger one.**

One inclusion is `AlgebraicGeometry.Space.val_app_mem_span_range_chartRestrictLinear`; the other
is naturality, which exhibits each restricted value as a value. -/
theorem range_val_app_eq_span_range_chartRestrictLinear {M N : Modules.{u, m} B S hS F hF}
    (hM : IsCartesianOnAffineCharts M) (u : M ⟶ N) {U V : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V))
    (φ : V ⟶ U) :
    LinearMap.range (u.val.app (op V)).hom =
      Submodule.span (chartRing B S hS F hF V)
        (Set.range fun z : M.val.obj (op U) =>
          chartRestrictLinear N φ (u.val.app (op U) z)) := by
  refine le_antisymm ?_ (Submodule.span_le.2 ?_)
  · rintro y ⟨x, rfl⟩
    exact val_app_mem_span_range_chartRestrictLinear hM u hU hV φ x
  · rintro y ⟨z, rfl⟩
    refine ⟨chartRestrictLinear M φ z, ?_⟩
    show u.val.app (op V) (chartRestrictLinear M φ z) =
      chartRestrictLinear N φ (u.val.app (op U) z)
    exact chartRestrictLinear_val_app u φ z

end AlgebraicGeometry.Space

end
