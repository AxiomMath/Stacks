-/

@[expose] public section

open TensorProduct

section Quotient

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- **The quotient of an algebra by an extended ideal is a pushout.**  For a ring homomorphism
`R → A` and an ideal `I` of `R`, the quotient `A/IA` is the pushout of `A` along `R → R/I`. -/
theorem Algebra.IsPushout.quotIdealMap {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (I : Ideal R) : Algebra.IsPushout R (R ⧸ I) A (A ⧸ I.map (algebraMap R A)) := by
  refine Algebra.IsPushout.of_equiv (h := TensorProduct.isPushout)
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I).symm ?_
  ext a
  change (Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I).symm (1 ⊗ₜ a) = _
  rw [AlgEquiv.symm_apply_eq, Ideal.Quotient.algebraMap_eq,
    Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk]

end Quotient

/-- **Cancellation of pushout squares.**  Given ring homomorphisms `R → R₀ → R'` and `R → A`, if
`A₀` is the pushout of `A` along `R → R₀` and `T` is the pushout of `A` along `R → R'`, then `T`
is the pushout of `A₀` along `R₀ → R'`. -/
theorem Algebra.IsPushout.cancel
    {R R₀ A A₀ R' T : Type*} [CommRing R] [CommRing R₀] [CommRing A] [CommRing A₀]
    [CommRing R'] [CommRing T]
    [Algebra R R₀] [Algebra R A] [Algebra R A₀] [Algebra R R'] [Algebra R T]
    [Algebra R₀ A₀] [Algebra R₀ R'] [Algebra R₀ T] [Algebra A A₀] [Algebra A T]
    [Algebra R' T] [Algebra A₀ T]
    [IsScalarTower R R₀ A₀] [IsScalarTower R A A₀] [IsScalarTower R R₀ R']
    [IsScalarTower R A T] [IsScalarTower R R' T] [IsScalarTower R R₀ T]
    [IsScalarTower R₀ R' T] [IsScalarTower A A₀ T] [IsScalarTower R₀ A₀ T]
    [IsScalarTower R A₀ T]
    [Algebra.IsPushout R R₀ A A₀] [Algebra.IsPushout R R' A T] :
    Algebra.IsPushout R₀ R' A₀ T := by
  refine ⟨IsBaseChange.of_comp (S := R₀) (T := R')
    (Algebra.IsPushout.out (R := R) (S := R₀) (R' := A) (S' := A₀)) ?_⟩
  have h : (LinearMap.restrictScalars R
        (IsScalarTower.toAlgHom R₀ A₀ T).toLinearMap).comp
        (IsScalarTower.toAlgHom R A A₀).toLinearMap =
      (IsScalarTower.toAlgHom R A T).toLinearMap := by
    ext a
    simp [IsScalarTower.algebraMap_apply A A₀ T]
  rw [h]
  exact Algebra.IsPushout.out (R := R) (S := R') (R' := A) (S' := T)

/-- **Flatness of a pushout over the quotient side of a cancelled pushout square.**  In the
situation of `Algebra.IsPushout.cancel`, if `R'` is flat over `R₀` then `T` is flat over `A₀`. -/
theorem Module.Flat.quotient_of_isPushout
    {R R₀ A A₀ R' T : Type*} [CommRing R] [CommRing R₀] [CommRing A] [CommRing A₀]
    [CommRing R'] [CommRing T]
    [Algebra R R₀] [Algebra R A] [Algebra R A₀] [Algebra R R'] [Algebra R T]
    [Algebra R₀ A₀] [Algebra R₀ R'] [Algebra R₀ T] [Algebra A A₀] [Algebra A T]
    [Algebra R' T] [Algebra A₀ T]
    [IsScalarTower R R₀ A₀] [IsScalarTower R A A₀] [IsScalarTower R R₀ R']
    [IsScalarTower R A T] [IsScalarTower R R' T] [IsScalarTower R R₀ T]
    [IsScalarTower R₀ R' T] [IsScalarTower A A₀ T] [IsScalarTower R₀ A₀ T]
    [IsScalarTower R A₀ T]
    [Algebra.IsPushout R R₀ A A₀] [Algebra.IsPushout R R' A T] [Module.Flat R₀ R'] :
    Module.Flat A₀ T :=
  let := Algebra.IsPushout.cancel (R := R) (R₀ := R₀) (A := A) (A₀ := A₀) (R' := R') (T := T)
  Module.Flat.isBaseChange R₀ A₀ R' T
    (Algebra.IsPushout.symm (inferInstance : Algebra.IsPushout R₀ R' A₀ T)).out

/-- **The fibre of a base change is the base change of the fibre.**  For a ring homomorphism
`A → A'` and an ideal `J` of `A` acting as zero on `A'`, so that `A'` is an `A/J`-algebra, the
base change along `A → A'` of the fibre `M/JM` of an `A`-module `M` is the base change of `M`
itself. -/
noncomputable def TensorProduct.quotSMulTensorEquiv {A A' M : Type*} [CommRing A] [CommRing A']
    [Algebra A A'] (J : Ideal A) [Algebra (A ⧸ J) A'] [IsScalarTower A (A ⧸ J) A']
    [AddCommGroup M] [Module A M] :
    (A' ⊗[A ⧸ J] (M ⧸ J • (⊤ : Submodule A M))) ≃ₗ[A'] A' ⊗[A] M :=
  (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl A' A')
      (TensorProduct.quotTensorEquivQuotSMulOverQuotient J M)).symm.trans
    (TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ J) A' A' M)

/-- **Conditions (1) and (2) of Stacks 05WY over a pushout of rings.**  Let `R → A` and `R → R'`
be ring homomorphisms, let `T` be the pushout `A ⊗_R R'` and let `A'` be a flat `T`-algebra.  Let
`I` be an ideal of `R` whose extensions to `R'` and to `A'` are zero, so that `R'` is an
`R/I`-algebra and `A'` an `A/IA`-algebra, and assume `R'` is flat over `R/I` and `A/IA → A'` is a
local homomorphism of local rings.  Then for an `A`-module `M` the fibre `M/IA·M` is flat over
`R/I` exactly when the base change `A' ⊗_A M` is flat over `R'`. -/
theorem Module.Flat.quotSMul_iff_tensor_of_isPushout
    {R A R' T A' M : Type*}
    [CommRing R] [CommRing A] [CommRing R'] [CommRing T] [CommRing A']
    [Algebra R A] [Algebra R R'] [Algebra R T] [Algebra A T] [Algebra R' T] [Algebra T A']
    [Algebra A A'] [Algebra R' A'] [Algebra R A']
    [IsScalarTower R A T] [IsScalarTower R R' T] [IsScalarTower A T A'] [IsScalarTower R' T A']
    [Algebra.IsPushout R R' A T] [Module.Flat T A']
    (I : Ideal R)
    [Algebra (R ⧸ I) R'] [IsScalarTower R (R ⧸ I) R'] [Module.Flat (R ⧸ I) R']
    [Algebra (R ⧸ I) T] [IsScalarTower R (R ⧸ I) T] [IsScalarTower (R ⧸ I) R' T]
    [Algebra (R ⧸ I) A'] [IsScalarTower (R ⧸ I) R' A']
    [Algebra (A ⧸ I.map (algebraMap R A)) T]
    [IsScalarTower A (A ⧸ I.map (algebraMap R A)) T]
    [IsScalarTower (R ⧸ I) (A ⧸ I.map (algebraMap R A)) T]
    [IsScalarTower R (A ⧸ I.map (algebraMap R A)) T]
    [Algebra (A ⧸ I.map (algebraMap R A)) A']
    [IsScalarTower A (A ⧸ I.map (algebraMap R A)) A']
    [IsScalarTower (A ⧸ I.map (algebraMap R A)) T A']
    [IsScalarTower (R ⧸ I) (A ⧸ I.map (algebraMap R A)) A']
    [AddCommGroup M] [Module A M]
    [IsLocalRing (A ⧸ I.map (algebraMap R A))] [IsLocalRing A']
    [IsLocalHom (algebraMap (A ⧸ I.map (algebraMap R A)) A')] :
    letI : Module (R ⧸ I) (M ⧸ (I.map (algebraMap R A) • (⊤ : Submodule A M))) :=
      Module.compHom _ (algebraMap (R ⧸ I) (A ⧸ I.map (algebraMap R A)))
    (Module.Flat (R ⧸ I) (M ⧸ (I.map (algebraMap R A) • (⊤ : Submodule A M))) ↔
      Module.Flat R' (A' ⊗[A] M)) := by
  let J := I.map (algebraMap R A)
  let : Module (R ⧸ I) (M ⧸ (J • (⊤ : Submodule A M))) :=
    Module.compHom _ (algebraMap (R ⧸ I) (A ⧸ J))
  have : IsScalarTower (R ⧸ I) (A ⧸ J) (M ⧸ (J • (⊤ : Submodule A M))) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have : Algebra.IsPushout R (R ⧸ I) A (A ⧸ J) := Algebra.IsPushout.quotIdealMap I
  have : Algebra.IsPushout (R ⧸ I) R' (A ⧸ J) T :=
    Algebra.IsPushout.cancel (R := R) (R₀ := R ⧸ I) (A := A) (A₀ := A ⧸ J) (R' := R') (T := T)
  have hTA₀ : Module.Flat (A ⧸ J) T :=
    Module.Flat.quotient_of_isPushout (R := R) (R₀ := R ⧸ I) (A := A) (A₀ := A ⧸ J)
      (R' := R') (T := T)
  have hA₀A' : Module.Flat (A ⧸ J) A' := Module.Flat.trans (A ⧸ J) T A'
  have : Module.FaithfullyFlat (A ⧸ J) A' := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hequiv : Module.Flat R' (A' ⊗[A ⧸ J] (M ⧸ (J • (⊤ : Submodule A M)))) ↔
      Module.Flat R' (A' ⊗[A] M) :=
    Module.Flat.equiv_iff ((TensorProduct.quotSMulTensorEquiv J).restrictScalars R')
  refine Iff.trans ⟨fun _ => Module.Flat.tensorProduct_of_isPushout (R ⧸ I) (A ⧸ J) R' T A'
    (M ⧸ (J • (⊤ : Submodule A M))), fun _ => ?_⟩ hequiv
  exact (Module.Flat.tensorProduct_iff_of_faithfullyFlat (R := R ⧸ I) (S := A ⧸ J) (S' := A')
    (M := M ⧸ (J • (⊤ : Submodule A M)))).mp (Module.Flat.trans (R ⧸ I) R' _)

end
