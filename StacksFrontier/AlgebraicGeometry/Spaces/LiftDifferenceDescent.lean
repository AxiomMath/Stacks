  which is still taken as given.
* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU), the two module
  functors.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v₁ u₁

namespace Stacks.Sites

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}

/-! ### Descent along an epimorphism of sheaves of abelian groups -/

section Abelian

variable [HasSheafify J AddCommGrpCat.{u}]

/-- A morphism of sheaves of abelian groups which kills every section killed by `q` kills the
kernel of `q`. -/
theorem kernelι_comp_eq_zero {R R' F : Sheaf J AddCommGrpCat.{u}} (q : R ⟶ R') (D : R ⟶ F)
    (hD : ∀ (X : Cᵒᵖ) (a : R.obj.obj X), q.hom.app X a = 0 → D.hom.app X a = 0) :
    kernel.ι q ≫ D = 0 := by
  ext X x
  refine hD X _ ?_
  exact congrArg (fun m : kernel q ⟶ R' => m.hom.app X x) (kernel.condition q)

variable {R R' F : Sheaf J AddCommGrpCat.{u}}

/-- **The descent of an additive map of sheaves along an epimorphism.** -/
noncomputable def descendAlongEpi (q : R ⟶ R') [Epi q] (D : R ⟶ F)
    (hD : ∀ (X : Cᵒᵖ) (a : R.obj.obj X), q.hom.app X a = 0 → D.hom.app X a = 0) : R' ⟶ F :=
  Abelian.epiDesc q D (kernelι_comp_eq_zero q D hD)

/-- Precomposing the descent of `D` along `q` with `q` gives back `D`. -/
@[simp]
theorem comp_descendAlongEpi (q : R ⟶ R') [Epi q] (D : R ⟶ F)
    (hD : ∀ (X : Cᵒᵖ) (a : R.obj.obj X), q.hom.app X a = 0 → D.hom.app X a = 0) :
    q ≫ descendAlongEpi q D hD = D :=
  Abelian.comp_epiDesc q D _

/-- **The descent is the unique factorization.** -/
theorem existsUnique_descendAlongEpi (q : R ⟶ R') [Epi q] (D : R ⟶ F)
    (hD : ∀ (X : Cᵒᵖ) (a : R.obj.obj X), q.hom.app X a = 0 → D.hom.app X a = 0) :
    ∃! D' : R' ⟶ F, q ≫ D' = D :=
  ⟨descendAlongEpi q D hD, comp_descendAlongEpi q D hD, fun _ h =>
    (cancel_epi q).1 (h.trans (comp_descendAlongEpi q D hD).symm)⟩

end Abelian

/-! ### Derivations through a quotient of sheaves of rings -/

section Rings

variable {A O : Sheaf J RingCat.{u}}

/-- The sheaf of abelian groups underlying a sheaf of rings. -/
noncomputable abbrev addGroupSheaf (A : Sheaf J RingCat.{u}) : Sheaf J AddCommGrpCat.{u} :=
  (sheafCompose J (forget₂ RingCat.{u} AddCommGrpCat.{u})).obj A

/-- The sheaf of abelian groups underlying a morphism of sheaves of rings. -/
noncomputable abbrev addGroupSheafMap (q : A ⟶ O) : addGroupSheaf A ⟶ addGroupSheaf O :=
  (sheafCompose J (forget₂ RingCat.{u} AddCommGrpCat.{u})).map q

/-- A locally surjective morphism of sheaves of rings is locally surjective on the underlying
sheaves of abelian groups: the two morphisms have the same components, hence the same image
sieves. -/
theorem isLocallySurjective_addGroupSheafMap (q : A ⟶ O) [Sheaf.IsLocallySurjective q] :
    Sheaf.IsLocallySurjective (addGroupSheafMap q) where
  imageSieve_mem {_X} y := Presheaf.imageSieve_mem J q.hom y

/-- **Sectionwise derivation data through a morphism of sheaves of rings.**  For a morphism
`q : A ⟶ O` of sheaves of rings and an `O`-module `M`, this is a family of additive maps
`A(X) → M(X)` satisfying the Leibniz rule for the `O`-action *through* `q`, and commuting with
restriction.  The last field is the hypothesis which makes the family descend: it vanishes on
every section killed by `q`. -/
structure QuotientDerivation (q : A ⟶ O) (M : SheafOfModules.{u} O) where
  /-- The additive map on sections. -/
  d {X : Cᵒᵖ} : A.obj.obj X →+ M.val.obj X
  /-- The Leibniz rule, for the `O`-action through `q`. -/
  d_mul {X : Cᵒᵖ} (a b : A.obj.obj X) :
    d (a * b) = q.hom.app X a • d b + q.hom.app X b • d a
  /-- Compatibility with restriction. -/
  d_map {X Y : Cᵒᵖ} (f : X ⟶ Y) (x : A.obj.obj X) :
    d (A.obj.map f x) = M.val.map f (d x)
  /-- The family vanishes on the sections killed by `q`. -/
  d_eq_zero_of_app_eq_zero {X : Cᵒᵖ} (a : A.obj.obj X) (ha : q.hom.app X a = 0) : d a = 0

namespace QuotientDerivation

variable {q : A ⟶ O} {M : SheafOfModules.{u} O} (Δ : QuotientDerivation q M)

/-- The derivation data as a morphism of sheaves of abelian groups. -/
noncomputable def homAdd : addGroupSheaf A ⟶ (SheafOfModules.toSheaf O).obj M :=
  ⟨{ app := fun X => AddCommGrpCat.ofHom Δ.d
     naturality := fun _ _ f => by ext x; exact Δ.d_map f x }⟩

/-- The components of `homAdd` are the maps `d` on sections. -/
@[simp]
theorem homAdd_app_apply {X : Cᵒᵖ} (a : A.obj.obj X) : Δ.homAdd.hom.app X a = Δ.d a := rfl

variable [HasSheafify J AddCommGrpCat.{u}] [Sheaf.IsLocallySurjective q]

/-- The descended derivation, as a morphism of the underlying sheaves of abelian groups. -/
noncomputable def descendHom : addGroupSheaf O ⟶ (SheafOfModules.toSheaf O).obj M :=
  haveI := isLocallySurjective_addGroupSheafMap q
  descendAlongEpi (addGroupSheafMap q) Δ.homAdd fun _ a ha => Δ.d_eq_zero_of_app_eq_zero a ha

/-- **The descended derivation on sections.** -/
noncomputable def descend {X : Cᵒᵖ} : O.obj.obj X →+ M.val.obj X :=
  (Δ.descendHom.hom.app X).hom

/-- **The descended derivation computes the given one.** -/
@[simp]
theorem descend_app {X : Cᵒᵖ} (a : A.obj.obj X) : Δ.descend (q.hom.app X a) = Δ.d a :=
  have := isLocallySurjective_addGroupSheafMap q
  congrArg (fun m : addGroupSheaf A ⟶ (SheafOfModules.toSheaf O).obj M => m.hom.app X a)
    (comp_descendAlongEpi (addGroupSheafMap q) Δ.homAdd
      fun _ a ha => Δ.d_eq_zero_of_app_eq_zero a ha)

/-- The descended derivation commutes with restriction. -/
theorem descend_map {X Y : Cᵒᵖ} (f : X ⟶ Y) (x : O.obj.obj X) :
    Δ.descend (O.obj.map f x) = M.val.map f (Δ.descend x) :=
  ConcreteCategory.congr_hom (Δ.descendHom.hom.naturality f) x

/-- **The Leibniz rule for the descended derivation.**  Both sides restrict to the same section
on the covering sieve on which the two given sections lift, and the target is a sheaf. -/
theorem descend_mul {X : Cᵒᵖ} (x y : O.obj.obj X) :
    Δ.descend (x * y) = x • Δ.descend y + y • Δ.descend x := by
  have hsep : Presheaf.IsSeparated J M.val.presheaf := M.isSheaf.isSeparated
  refine hsep X.unop (Presheaf.imageSieve q.hom x ⊓ Presheaf.imageSieve q.hom y)
    (J.intersection_covering (Presheaf.imageSieve_mem J q.hom x)
      (Presheaf.imageSieve_mem J q.hom y)) _ _ ?_
  intro Y f hf
  obtain ⟨a, ha⟩ := hf.1
  obtain ⟨b, hb⟩ := hf.2
  have hxy : O.obj.map f.op (x * y) = q.hom.app (Opposite.op Y) (a * b) := by
    rw [map_mul, map_mul, ha, hb]
  have key : M.val.map f.op (Δ.descend (x * y)) = Δ.d (a * b) := by
    rw [← Δ.descend_map f.op (x * y), hxy, Δ.descend_app]
  have key2 : M.val.map f.op (x • Δ.descend y + y • Δ.descend x) =
      q.hom.app (Opposite.op Y) a • Δ.d b + q.hom.app (Opposite.op Y) b • Δ.d a := by
    rw [map_add, M.val.map_smul, M.val.map_smul, ← Δ.descend_map f.op y,
      ← Δ.descend_map f.op x, ← ha, ← hb, Δ.descend_app, Δ.descend_app]
    rfl
  change M.val.map f.op (Δ.descend (x * y)) =
    M.val.map f.op (x • Δ.descend y + y • Δ.descend x)
  rw [key, key2, Δ.d_mul a b]

/-- Precomposing the descended morphism with `q` gives back `homAdd`. -/
@[simp]
theorem comp_descendHom : addGroupSheafMap q ≫ Δ.descendHom = Δ.homAdd :=
  have := isLocallySurjective_addGroupSheafMap q
  comp_descendAlongEpi _ _ _

/-- **The descent is additive in the derivation.** -/
theorem descendHom_add (Δ₁ Δ₂ Δ₃ : QuotientDerivation q M)
    (h : ∀ (V : Cᵒᵖ) (x : A.obj.obj V), Δ₃.d x = Δ₁.d x + Δ₂.d x) :
    Δ₃.descendHom = Δ₁.descendHom + Δ₂.descendHom := by
  have := isLocallySurjective_addGroupSheafMap q
  refine (cancel_epi (addGroupSheafMap q)).1 ?_
  rw [comp_descendHom, Preadditive.comp_add, comp_descendHom, comp_descendHom]
  ext V x
  exact h V x

/-- **The descent is additive in the derivation**, on sections. -/
theorem descend_add (Δ₁ Δ₂ Δ₃ : QuotientDerivation q M)
    (h : ∀ (V : Cᵒᵖ) (x : A.obj.obj V), Δ₃.d x = Δ₁.d x + Δ₂.d x)
    {V : Cᵒᵖ} (t : O.obj.obj V) : Δ₃.descend t = Δ₁.descend t + Δ₂.descend t :=
  congrArg (fun m : addGroupSheaf O ⟶ (SheafOfModules.toSheaf O).obj M => m.hom.app V t)
    (descendHom_add Δ₁ Δ₂ Δ₃ h)

/-- **The descent of the zero derivation is zero.** -/
theorem descendHom_eq_zero (Δ' : QuotientDerivation q M)
    (h : ∀ (V : Cᵒᵖ) (x : A.obj.obj V), Δ'.d x = 0) : Δ'.descendHom = 0 := by
  have := isLocallySurjective_addGroupSheafMap q
  refine (cancel_epi (addGroupSheafMap q)).1 ?_
  rw [comp_descendHom, Limits.comp_zero]
  ext V x
  exact h V x

/-- **The descent of the zero derivation is zero**, on sections. -/
theorem descend_eq_zero_of_d_eq_zero (Δ' : QuotientDerivation q M)
    (h : ∀ (V : Cᵒᵖ) (x : A.obj.obj V), Δ'.d x = 0) {V : Cᵒᵖ} (t : O.obj.obj V) :
    Δ'.descend t = 0 :=
  congrArg (fun m : addGroupSheaf O ⟶ (SheafOfModules.toSheaf O).obj M => m.hom.app V t)
    (descendHom_eq_zero Δ' h)

/-- **The descended derivation vanishes wherever a local lift of the section does.**  A section
of `O` which is the image of a section of `A` killed by the derivation is killed by the
descended one. -/
theorem descend_eq_zero_of_exists {X : Cᵒᵖ} (t : O.obj.obj X)
    (h : ∃ x : A.obj.obj X, q.hom.app X x = t ∧ Δ.d x = 0) : Δ.descend t = 0 := by
  obtain ⟨x, hx, hdx⟩ := h
  rw [← hx, Δ.descend_app, hdx]

/-- **The descended derivation vanishes at a section which lifts, over a covering sieve, to
sections the given derivation kills.**  The descent commutes with restriction and computes the
given derivation on the sections in the image of `q`, so it vanishes on every member of the
sieve; the module of values is a sheaf, hence separated.

This is the form in which the vanishing of the descended derivation on the functions read from
a base is proved when the lifts only exist locally — which is the case in Equation
[Stacks Project, Tag 0CKE], where a function pulled back from the base of the restricted
groupoid lifts to a function on the arrows only over a covering sieve. -/
theorem descend_eq_zero_of_locally_exists {X : Cᵒᵖ} (t : O.obj.obj X) (T : Sieve X.unop)
    (hT : T ∈ J X.unop)
    (h : ∀ ⦃W : C⦄ (p : W ⟶ X.unop), T p →
      ∃ x : A.obj.obj (Opposite.op W), q.hom.app (Opposite.op W) x = O.obj.map p.op t ∧
        Δ.d x = 0) :
    Δ.descend t = 0 := by
  have hsep : Presheaf.IsSeparated J M.val.presheaf := M.isSheaf.isSeparated
  refine hsep X.unop T hT (Δ.descend t) 0 fun {W} p hp => ?_
  obtain ⟨x, hx, hdx⟩ := h p hp
  have hmap : Δ.descend (O.obj.map p.op t) = M.val.map p.op (Δ.descend t) :=
    Δ.descend_map p.op t
  have hres : Δ.descend (O.obj.map p.op t) = 0 := by rw [← hx, Δ.descend_app, hdx]
  rw [map_zero]
  exact hmap.symm.trans hres

/-- The descended derivation vanishes on the sections coming from a sheaf of rings on which the
given derivation vanishes. -/
theorem descend_eq_zero {A' : Sheaf J RingCat.{u}} (ψ : A' ⟶ A) (φ : A' ⟶ O) (hψ : ψ ≫ q = φ)
    (hd : ∀ (X : Cᵒᵖ) (s : A'.obj.obj X), Δ.d (ψ.hom.app X s) = 0)
    {X : Cᵒᵖ} (s : A'.obj.obj X) : Δ.descend (φ.hom.app X s) = 0 := by
  have h : φ.hom.app X s = q.hom.app X (ψ.hom.app X s) :=
    (ConcreteCategory.congr_hom (congrArg (fun t : A' ⟶ O => t.hom.app X) hψ) s).symm
  rw [h, Δ.descend_app, hd]

end QuotientDerivation

/-! ### The difference of two lifts as derivation data -/

/-- The ring-theoretic identity behind the Leibniz rule, for a ring whose elements commute: if
the product of the two differences `a - c` and `b - d` vanishes, then
`a * b - c * d = a * (b - d) + b * (a - c)`. -/
private theorem mul_sub_mul_eq_of_mul_sub_eq_zero' {R : Type*} [Ring R]
    (hcomm : ∀ u v : R, u * v = v * u) {a b c d : R}
    (h : (a - c) * (b - d) = 0) : a * b - c * d = a * (b - d) + b * (a - c) := by
  have e1 : (a - c) * (b - d) = a * b - a * d - c * b + c * d := by noncomm_ring
  have e2 : a * (b - d) + b * (a - c) = a * b - a * d + b * a - b * c := by noncomm_ring
  have h0 : a * b - a * d - c * b + c * d = 0 := e1 ▸ h
  have e3 : a * b - c * d - (a * b - a * d + a * b - c * b) =
      -(a * b - a * d - c * b + c * d) := by abel
  rw [h0, neg_zero, sub_eq_zero] at e3
  rw [e2, hcomm b a, hcomm b c]
  exact e3

/-- **The square-zero ideal in which the difference of two lifts takes its values.**  An
`O`-module `M` included into a sheaf of rings `𝒜` with commuting sections, as an ideal of
square zero.  In the situation of [Stacks Project, Tag 0618] `𝒜` is the structure sheaf of the
ambient space of the source thickening, pushed forward, and `M` is its conormal module. -/
structure SquareZeroValues (M : SheafOfModules.{u} O) where
  /-- The ambient sheaf of rings in which the two maps take their values. -/
  ambient : Sheaf J RingCat.{u}
  /-- The sections of the ambient sheaf of rings commute. -/
  ambient_mul_comm {V : Cᵒᵖ} (s t : ambient.obj.obj V) : s * t = t * s
  /-- The inclusion of the module of values into the ambient sheaf of rings. -/
  ι {V : Cᵒᵖ} : M.val.obj V →+ ambient.obj.obj V
  /-- The inclusion is injective on sections. -/
  ι_injective {V : Cᵒᵖ} : Function.Injective (ι (V := V))
  /-- The inclusion commutes with restriction. -/
  ι_map {V W : Cᵒᵖ} (h : V ⟶ W) (m : M.val.obj V) :
    ι (V := W) (M.val.map h m) = ambient.obj.map h (ι m)
  /-- The ideal of values has square zero. -/
  mul_ι_eq_zero {V : Cᵒᵖ} (m m' : M.val.obj V) : ι m * ι m' = 0

/-- Additivity of a sectionwise difference read in a module. -/
private theorem add_of_ι_diff_aux {M : SheafOfModules.{u} O} (E : SquareZeroValues M)
    (f g : A ⟶ E.ambient) (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    {V : Cᵒᵖ} (x y : A.obj.obj V) : d (x + y) = d x + d y :=
  E.ι_injective (by rw [ι_d, map_add, map_add, map_add, ι_d, ι_d]; abel)

/-- Compatibility with restriction of a sectionwise difference read in a module. -/
private theorem map_of_ι_diff_aux {M : SheafOfModules.{u} O} (E : SquareZeroValues M)
    (f g : A ⟶ E.ambient) (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    {V W : Cᵒᵖ} (k : V ⟶ W) (x : A.obj.obj V) :
    d (A.obj.map k x) = M.val.map k (d x) :=
  E.ι_injective (by
    rw [ι_d, E.ι_map, ι_d, map_sub]
    exact congrArg₂ (· - ·) (ConcreteCategory.congr_hom (f.hom.naturality k) x)
      (ConcreteCategory.congr_hom (g.hom.naturality k) x))

/-- The Leibniz rule for a sectionwise difference with values in a square-zero ideal. -/
private theorem mul_of_ι_diff_aux {q : A ⟶ O} {M : SheafOfModules.{u} O}
    (E : SquareZeroValues M) (f g : A ⟶ E.ambient) (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    (ι_smul : ∀ {V : Cᵒᵖ} (x : A.obj.obj V) (m : M.val.obj V),
      E.ι (q.hom.app V x • m) = f.hom.app V x * E.ι m)
    {V : Cᵒᵖ} (x y : A.obj.obj V) :
    d (x * y) = q.hom.app V x • d y + q.hom.app V y • d x :=
  E.ι_injective (by
    have hz : E.ι (d x) * E.ι (d y) = 0 := E.mul_ι_eq_zero _ _
    rw [ι_d, ι_d] at hz
    rw [ι_d, map_add, ι_smul, ι_smul, ι_d, ι_d, map_mul, map_mul]
    exact mul_sub_mul_eq_of_mul_sub_eq_zero' E.ambient_mul_comm hz)

/-- A sectionwise difference vanishes exactly where the two morphisms agree. -/
private theorem eq_zero_iff_of_ι_diff_aux {M : SheafOfModules.{u} O} (E : SquareZeroValues M)
    (f g : A ⟶ E.ambient) (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    {V : Cᵒᵖ} (x : A.obj.obj V) : d x = 0 ↔ f.hom.app V x = g.hom.app V x := by
  refine ⟨fun hx => ?_, fun hx => E.ι_injective ?_⟩
  · have hi := ι_d x
    rw [hx, map_zero] at hi
    exact sub_eq_zero.1 hi.symm
  · rw [ι_d, hx, sub_self, map_zero]

/-- A sectionwise derivation through `q` vanishes on the sections killed by `q'`, if `q'` kills
a locally generating family of its kernel on which the derivation vanishes, and its kernel acts
by zero through `q`. -/
private theorem eq_zero_of_mem_span_aux {q : A ⟶ O} {O' : Sheaf J RingCat.{u}} {q' : A ⟶ O'}
    {M : SheafOfModules.{u} O} (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (hadd : ∀ {V : Cᵒᵖ} (x y : A.obj.obj V), d (x + y) = d x + d y)
    (hmul : ∀ {V : Cᵒᵖ} (x y : A.obj.obj V),
      d (x * y) = q.hom.app V x • d y + q.hom.app V y • d x)
    (hmap : ∀ {V W : Cᵒᵖ} (k : V ⟶ W) (x : A.obj.obj V),
      d (A.obj.map k x) = M.val.map k (d x))
    (hsmul : ∀ {V : Cᵒᵖ} (z : A.obj.obj V), q'.hom.app V z = 0 →
      ∀ m : M.val.obj V, q.hom.app V z • m = 0)
    (hgen : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), q'.hom.app V x = 0 →
      ∃ T : Sieve V.unop, T ∈ J V.unop ∧ ∀ ⦃Y : C⦄ (p : Y ⟶ V.unop), T p →
        A.obj.map p.op x ∈
          Ideal.span {y : A.obj.obj (Opposite.op Y) |
            q'.hom.app (Opposite.op Y) y = 0 ∧ d y = 0})
    {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q'.hom.app V x = 0) : d x = 0 := by
  have hzero : ∀ {W : Cᵒᵖ}, d (0 : A.obj.obj W) = 0 := by
    intro W
    have h := hadd (0 : A.obj.obj W) 0
    rw [add_zero] at h
    exact (add_eq_left.mp h.symm)
  have key : ∀ {Y : C} (y : A.obj.obj (Opposite.op Y)),
      y ∈ Ideal.span {z : A.obj.obj (Opposite.op Y) |
          q'.hom.app (Opposite.op Y) z = 0 ∧ d z = 0} →
      d y = 0 ∧ q'.hom.app (Opposite.op Y) y = 0 := by
    intro Y y hy
    induction hy using Submodule.span_induction with
    | mem z hz => exact ⟨hz.2, hz.1⟩
    | zero => exact ⟨hzero, map_zero _⟩
    | add z w _ _ hz hw =>
        exact ⟨(hadd z w).trans (by rw [hz.1, hw.1, add_zero]),
          (map_add _ z w).trans (by rw [hz.2, hw.2, add_zero])⟩
    | smul a z _ hz =>
        refine ⟨?_, ?_⟩
        · rw [smul_eq_mul, hmul a z, hz.1, smul_zero, hsmul z hz.2 (d a), add_zero]
        · rw [smul_eq_mul, map_mul, hz.2, mul_zero]
  obtain ⟨T, hT, hTspan⟩ := hgen x hx
  refine M.isSheaf.isSeparated V.unop T hT (d x) 0 ?_
  intro Y p hp
  have h1 : (M.val.presheaf.map p.op) (d x) = d ((A.obj.map p.op) x) := (hmap p.op x).symm
  rw [h1, (key _ (hTspan p hp)).1, map_zero]
  rfl

/-- **The two lifts agree on the sections killed by a second morphism `q'`**, if its kernel is
locally generated by sections on which they agree and acts by zero on the module of values. -/
private theorem app_eq_of_app_eq_zero_aux {q : A ⟶ O}
    {O' : Sheaf J RingCat.{u}} {q' : A ⟶ O'} {M : SheafOfModules.{u} O}
    (E : SquareZeroValues M) (f g : A ⟶ E.ambient)
    (ι_smul : ∀ {V : Cᵒᵖ} (x : A.obj.obj V) (m : M.val.obj V),
      E.ι (q.hom.app V x • m) = f.hom.app V x * E.ι m)
    (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    (hsmul : ∀ {V : Cᵒᵖ} (z : A.obj.obj V), q'.hom.app V z = 0 →
      ∀ m : M.val.obj V, q.hom.app V z • m = 0)
    (hgen : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), q'.hom.app V x = 0 →
      ∃ T : Sieve V.unop, T ∈ J V.unop ∧ ∀ ⦃Y : C⦄ (p : Y ⟶ V.unop), T p →
        A.obj.map p.op x ∈
          Ideal.span {y : A.obj.obj (Opposite.op Y) | q'.hom.app (Opposite.op Y) y = 0 ∧
            f.hom.app (Opposite.op Y) y = g.hom.app (Opposite.op Y) y})
    {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q'.hom.app V x = 0) :
    f.hom.app V x = g.hom.app V x := by
  refine (eq_zero_iff_of_ι_diff_aux E f g d ι_d x).1
    (eq_zero_of_mem_span_aux d (add_of_ι_diff_aux E f g d ι_d)
      (mul_of_ι_diff_aux E f g d ι_d ι_smul) (map_of_ι_diff_aux E f g d ι_d) hsmul
      (fun {V} x hx => ?_) x hx)
  obtain ⟨T, hT, hTspan⟩ := hgen x hx
  refine ⟨T, hT, fun Y p hp => Ideal.span_mono (fun y hy => ?_) (hTspan p hp)⟩
  exact ⟨hy.1, (eq_zero_iff_of_ι_diff_aux E f g d ι_d y).2 hy.2⟩

/-- **The two lifts agree on the sections killed by `q` as soon as the kernel of `q` is locally
generated by sections on which they agree.**  This is hypothesis (2) of
[Stacks Project, Tag 0618] reduced to a statement about generators: the difference of two lifts
into a square-zero ideal is a derivation for the action through the first of them, so on a
product `a * y` with `y` killed by `q` it is `q(a)` times the difference at `y`; if that
vanishes on a family generating the kernel of `q` over a covering sieve, it vanishes on the
whole kernel, the module of values being a sheaf and hence separated.

The hypotheses `ι_smul`, `d` and `ι_d` are the three fields of
`Stacks.Sites.LiftDifferenceData` other than the conclusion, so this is what builds that datum
out of a generating family. -/
theorem app_eq_of_app_eq_zero_of_mem_span {q : A ⟶ O} {M : SheafOfModules.{u} O}
    (E : SquareZeroValues M) (f g : A ⟶ E.ambient)
    (ι_smul : ∀ {V : Cᵒᵖ} (x : A.obj.obj V) (m : M.val.obj V),
      E.ι (q.hom.app V x • m) = f.hom.app V x * E.ι m)
    (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    (hgen : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), q.hom.app V x = 0 →
      ∃ T : Sieve V.unop, T ∈ J V.unop ∧ ∀ ⦃Y : C⦄ (p : Y ⟶ V.unop), T p →
        A.obj.map p.op x ∈
          Ideal.span {y : A.obj.obj (Opposite.op Y) | q.hom.app (Opposite.op Y) y = 0 ∧
            f.hom.app (Opposite.op Y) y = g.hom.app (Opposite.op Y) y})
    {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q.hom.app V x = 0) :
    f.hom.app V x = g.hom.app V x :=
  app_eq_of_app_eq_zero_aux E f g ι_smul d ι_d (fun z hz m => by rw [hz, zero_smul]) hgen x hx

/-! ### A derivation vanishing on a local generating family of the kernel -/

section SpanVanishing

/-- **A sectionwise derivation through `q` which kills a locally generating family of the
kernel of `q` kills the whole kernel.**  The family of sections it kills and which `q` kills is
closed under addition and under multiplication by an arbitrary section — on a product `a * y`
with `y` in the family the Leibniz rule leaves only `q(a)` times the value at `y` — so it
contains the ideal those sections generate; and the module of values is a sheaf, hence
separated, so a section killed over a covering sieve is killed.

This is the engine of `Stacks.Sites.app_eq_of_app_eq_zero_of_mem_span`, stated for a bare
sectionwise derivation so that it applies to a difference transported to another site, where
the ideal of values is not available in the same shape. -/
theorem eq_zero_of_mem_span_of_derivation {q : A ⟶ O} {M : SheafOfModules.{u} O}
    (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (hadd : ∀ {V : Cᵒᵖ} (x y : A.obj.obj V), d (x + y) = d x + d y)
    (hmul : ∀ {V : Cᵒᵖ} (x y : A.obj.obj V),
      d (x * y) = q.hom.app V x • d y + q.hom.app V y • d x)
    (hmap : ∀ {V W : Cᵒᵖ} (k : V ⟶ W) (x : A.obj.obj V),
      d (A.obj.map k x) = M.val.map k (d x))
    (hgen : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), q.hom.app V x = 0 →
      ∃ T : Sieve V.unop, T ∈ J V.unop ∧ ∀ ⦃Y : C⦄ (p : Y ⟶ V.unop), T p →
        A.obj.map p.op x ∈
          Ideal.span {y : A.obj.obj (Opposite.op Y) |
            q.hom.app (Opposite.op Y) y = 0 ∧ d y = 0})
    {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q.hom.app V x = 0) : d x = 0 :=
  eq_zero_of_mem_span_aux d hadd hmul hmap (fun z hz m => by rw [hz, zero_smul]) hgen x hx

end SpanVanishing

/-! ### The derivation laws of a sectionwise difference -/

section Difference

variable {q : A ⟶ O} {M : SheafOfModules.{u} O} (E : SquareZeroValues M) (f g : A ⟶ E.ambient)
  (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
  (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)

include ι_d

/-- **A sectionwise difference of two morphisms of sheaves of rings, read in a module, is
additive.**  The inclusion of the module of values is injective and additive, and the two
morphisms are. -/
theorem diff_add_of_ι_diff {V : Cᵒᵖ} (x y : A.obj.obj V) : d (x + y) = d x + d y :=
  add_of_ι_diff_aux E f g d ι_d x y

/-- **A sectionwise difference of two morphisms of sheaves of rings, read in a module, commutes
with restriction.** -/
theorem diff_map_of_ι_diff {V W : Cᵒᵖ} (k : V ⟶ W) (x : A.obj.obj V) :
    d (A.obj.map k x) = M.val.map k (d x) :=
  map_of_ι_diff_aux E f g d ι_d k x

/-- **The Leibniz rule for a sectionwise difference taking its values in a square-zero
ideal**, for the action through `q` and the first of the two morphisms.  This is where the
square-zero property is spent: the correction term is the product of the two differences. -/
theorem diff_mul_of_ι_diff
    (ι_smul : ∀ {V : Cᵒᵖ} (x : A.obj.obj V) (m : M.val.obj V),
      E.ι (q.hom.app V x • m) = f.hom.app V x * E.ι m)
    {V : Cᵒᵖ} (x y : A.obj.obj V) :
    d (x * y) = q.hom.app V x • d y + q.hom.app V y • d x :=
  mul_of_ι_diff_aux E f g d ι_d ι_smul x y

/-- **A sectionwise difference vanishes exactly where the two morphisms agree.** -/
theorem diff_eq_zero_iff_of_ι_diff {V : Cᵒᵖ} (x : A.obj.obj V) :
    d x = 0 ↔ f.hom.app V x = g.hom.app V x :=
  eq_zero_iff_of_ι_diff_aux E f g d ι_d x

end Difference

/-! ### Generation against a second quotient map -/

/-- **The two lifts agree on the sections killed by a *second* morphism `q'`, as soon as the
kernel of `q'` is locally generated by sections on which they agree and acts by zero on the
module of values.**

This is `Stacks.Sites.app_eq_of_app_eq_zero_of_mem_span` with the morphism whose kernel is
being generated decoupled from the morphism whose values are the scalars.  The two coincide in
the situation of [Stacks Project, Tag 0618] itself, where `q` is the quotient map of the
thickening the two lifts live over; they do *not* coincide in the situation of Equation
[Stacks Project, Tag 0CKE], where the two comorphisms of two sections of a groupoid have to be
compared on the defining ideal of `R₀ = s^{-1}(U₀)` in `R` while their difference takes its
values in a module over `𝒪_R` itself.  The only thing the proof needs of the smaller kernel is
that its sections kill the module of values, which is the hypothesis `hsmul`; that is automatic
when `q' = q`, and in the situation of (0CKE) it holds because the defining ideal of `R₀` is
contained in the defining ideal of `e(U₀)`. -/
theorem app_eq_of_app_eq_zero_of_mem_span_of_smul_eq_zero {q : A ⟶ O}
    {O' : Sheaf J RingCat.{u}} {q' : A ⟶ O'} {M : SheafOfModules.{u} O}
    (E : SquareZeroValues M) (f g : A ⟶ E.ambient)
    (ι_smul : ∀ {V : Cᵒᵖ} (x : A.obj.obj V) (m : M.val.obj V),
      E.ι (q.hom.app V x • m) = f.hom.app V x * E.ι m)
    (d : ∀ {V : Cᵒᵖ}, A.obj.obj V → M.val.obj V)
    (ι_d : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), E.ι (d x) = f.hom.app V x - g.hom.app V x)
    (hsmul : ∀ {V : Cᵒᵖ} (z : A.obj.obj V), q'.hom.app V z = 0 →
      ∀ m : M.val.obj V, q.hom.app V z • m = 0)
    (hgen : ∀ {V : Cᵒᵖ} (x : A.obj.obj V), q'.hom.app V x = 0 →
      ∃ T : Sieve V.unop, T ∈ J V.unop ∧ ∀ ⦃Y : C⦄ (p : Y ⟶ V.unop), T p →
        A.obj.map p.op x ∈
          Ideal.span {y : A.obj.obj (Opposite.op Y) | q'.hom.app (Opposite.op Y) y = 0 ∧
            f.hom.app (Opposite.op Y) y = g.hom.app (Opposite.op Y) y})
    {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q'.hom.app V x = 0) :
    f.hom.app V x = g.hom.app V x :=
  app_eq_of_app_eq_zero_aux E f g ι_smul d ι_d hsmul hgen x hx

/-- **The difference of two lifts.**  Two morphisms `f, g : A ⟶ 𝒜` of sheaves of rings on the
same site whose sectionwise difference takes its values in the square-zero ideal `M`, on which
the `O`-action is the `A`-action through `f`, and which agree on the sections killed by `q`.

The last clause is hypothesis (2) of [Stacks Project, Tag 0618], the agreement of the two maps
on the defining ideal of the target thickening; it is exactly what makes the difference descend
along `q`. -/
structure LiftDifferenceData (q : A ⟶ O) {M : SheafOfModules.{u} O} (E : SquareZeroValues M) where
  /-- The first of the two maps. -/
  f : A ⟶ E.ambient
  /-- The second of the two maps. -/
  g : A ⟶ E.ambient
  /-- The `O`-action on the module is the `A`-action through `f`. -/
  ι_smul {V : Cᵒᵖ} (x : A.obj.obj V) (m : M.val.obj V) :
    E.ι (q.hom.app V x • m) = f.hom.app V x * E.ι m
  /-- The difference of the two maps, as a section of the module. -/
  diff {V : Cᵒᵖ} (x : A.obj.obj V) : M.val.obj V
  /-- The difference really is the difference of the two maps. -/
  ι_diff {V : Cᵒᵖ} (x : A.obj.obj V) : E.ι (diff x) = f.hom.app V x - g.hom.app V x
  /-- The two maps agree on the sections killed by `q`. -/
  app_eq_of_app_eq_zero {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q.hom.app V x = 0) :
    f.hom.app V x = g.hom.app V x

namespace LiftDifferenceData

variable {q : A ⟶ O} {M : SheafOfModules.{u} O} {E : SquareZeroValues M}
  (L : LiftDifferenceData q E)

/-- **The difference of two lifts is additive.** -/
theorem diff_add {V : Cᵒᵖ} (x y : A.obj.obj V) :
    L.diff (x + y) = L.diff x + L.diff y :=
  add_of_ι_diff_aux E L.f L.g L.diff L.ι_diff x y

/-- **The Leibniz rule for the difference of two lifts.**  This is where the square-zero
hypothesis is used: the correction term is the product of the two differences. -/
theorem diff_mul {V : Cᵒᵖ} (x y : A.obj.obj V) :
    L.diff (x * y) = q.hom.app V x • L.diff y + q.hom.app V y • L.diff x :=
  mul_of_ι_diff_aux E L.f L.g L.diff L.ι_diff L.ι_smul x y

/-- **The difference of two lifts commutes with restriction.** -/
theorem diff_map {V W : Cᵒᵖ} (h : V ⟶ W) (x : A.obj.obj V) :
    L.diff (A.obj.map h x) = M.val.map h (L.diff x) :=
  map_of_ι_diff_aux E L.f L.g L.diff L.ι_diff h x

/-- **The difference of two lifts vanishes on the sections killed by `q`.** -/
theorem diff_eq_zero_of_app_eq_zero {V : Cᵒᵖ} (x : A.obj.obj V) (hx : q.hom.app V x = 0) :
    L.diff x = 0 :=
  E.ι_injective (by rw [L.ι_diff, L.app_eq_of_app_eq_zero x hx, sub_self, map_zero])

/-- **The difference of two lifts vanishes at a section where the two maps agree.**  This is one
direction of `Stacks.Sites.diff_eq_zero_iff_of_ι_diff`, read at the fields of the datum. -/
theorem diff_eq_zero_of_app_eq {V : Cᵒᵖ} (x : A.obj.obj V)
    (hx : L.f.hom.app V x = L.g.hom.app V x) : L.diff x = 0 :=
  E.ι_injective (by rw [L.ι_diff, hx, sub_self, map_zero])

/-- **The difference of two lifts is derivation data through `q`**, so it descends. -/
def toQuotientDerivation : QuotientDerivation q M where
  d := AddMonoidHom.mk' L.diff fun x y => L.diff_add x y
  d_mul := L.diff_mul
  d_map := L.diff_map
  d_eq_zero_of_app_eq_zero := L.diff_eq_zero_of_app_eq_zero

/-- The map `d` of `toQuotientDerivation` is the difference `L.diff` of the two lifts. -/
@[simp]
theorem toQuotientDerivation_d {V : Cᵒᵖ} (x : A.obj.obj V) :
    L.toQuotientDerivation.d x = L.diff x := rfl

/-- **A lift does not differ from itself.** -/
theorem diff_eq_zero_of_eq (L' : LiftDifferenceData q E) (h : L'.f = L'.g)
    {V : Cᵒᵖ} (x : A.obj.obj V) : L'.diff x = 0 :=
  E.ι_injective (by
    rw [L'.ι_diff, map_zero, h, sub_self])

/-- **The differences along a chain of three lifts add up.**  For three pairs of lifts into the
same square-zero ideal whose maps are `(f₁, f₂)`, `(f₂, f₃)` and `(f₁, f₃)`, the first two
differences add up to the third. -/
theorem diff_add_diff (L₁ L₂ L₃ : LiftDifferenceData q E)
    (h₁₂ : L₁.g = L₂.f) (h₁₃ : L₁.f = L₃.f) (h₂₃ : L₂.g = L₃.g)
    {V : Cᵒᵖ} (x : A.obj.obj V) : L₁.diff x + L₂.diff x = L₃.diff x :=
  E.ι_injective (by
    rw [map_add, L₁.ι_diff, L₂.ι_diff, L₃.ι_diff, ← h₁₃, ← h₂₃, ← h₁₂]
    abel)

variable [HasSheafify J AddCommGrpCat.{u}] [Sheaf.IsLocallySurjective q]

/-- **The descended difference vanishes on the base.**  If the two maps agree after a morphism
`ψ : A' ⟶ A` lifting `φ : A' ⟶ O`, then the descended difference kills every section coming
from `A'`.  For the two comorphisms of morphisms of thickenings over a base this is the
statement that both are maps of `𝒪_B`-algebras. -/
theorem descend_eq_zero_of_comp_eq {A' : Sheaf J RingCat.{u}} (ψ : A' ⟶ A) (φ : A' ⟶ O)
    (hψ : ψ ≫ q = φ) (hfg : ψ ≫ L.f = ψ ≫ L.g) {V : Cᵒᵖ} (s : A'.obj.obj V) :
    L.toQuotientDerivation.descend (φ.hom.app V s) = 0 := by
  refine QuotientDerivation.descend_eq_zero L.toQuotientDerivation ψ φ hψ (fun W t => ?_) s
  refine E.ι_injective ?_
  rw [toQuotientDerivation_d, L.ι_diff, map_zero, sub_eq_zero]
  exact ConcreteCategory.congr_hom (congrArg (fun m : A' ⟶ E.ambient => m.hom.app W) hfg) t

end LiftDifferenceData

end Rings

end Stacks.Sites

/-! ### The descended derivation of an algebraic space, and the map on differentials -/

namespace AlgebraicGeometry.Space

open Stacks.Sites

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {Y T : AlgebraicSpaces B S hS} (b : Y ⟶ T)
  {A : Sheaf (SmallEtale.topology B S hS Y.1) RingCat.{u}}
  {q : A ⟶ structureRingSheaf B S hS Y} [Sheaf.IsLocallySurjective q]
  {M : Modules B S hS Y.1 Y.2} (Δ : QuotientDerivation q M)

/-- **The descended `T`-derivation of `𝒪_Y`.**  A sectionwise derivation of a sheaf of rings
`A` through a locally surjective `q : A ⟶ 𝒪_Y`, with values in an `𝒪_Y`-module `M`, which kills
the sections killed by `q` and the sections coming from `b^{-1}𝒪_T`, descends to a
`T`-derivation of `𝒪_Y` with values in `M`. -/
noncomputable def descendedDerivation
    (hzero : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
      (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
      Δ.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0) :
    PresheafOfModulesOfCommRing.Derivation' M.val (structureSharpInverseImage B S hS b).hom where
  d := Δ.descend
  d_mul := Δ.descend_mul
  d_map := Δ.descend_map
  d_app := hzero _

/-- The descended `T`-derivation of `𝒪_Y` is `QuotientDerivation.descend` on sections. -/
@[simp]
theorem descendedDerivation_d
    (hzero : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
      (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
      Δ.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)
    {V : (SmallEtale B S hS Y.1)ᵒᵖ} (t : (structureRingSheaf B S hS Y).obj.obj V) :
    (descendedDerivation B S hS b Δ hzero).d t = Δ.descend t :=
  rfl

section Differentials

variable {X : AlgebraicSpaces B S hS} (a : X ⟶ Y) (C : Modules B S hS X.1 X.2)
  (Δ : QuotientDerivation q ((modulePushforward B S hS a).obj C))
  (hzero : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    Δ.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)

/-- **The descent of the difference to an `𝒪_X`-linear map out of the pulled back
differentials.**  The descended `T`-derivation of `𝒪_Y` with values in `a_*C` is, by Equation
(0619), an `𝒪_X`-linear map `a^*Ω_{Y/T} ⟶ C`. -/
noncomputable def descendedDifferentialsHom :
    (modulePullback B S hS a).obj (sheafOfDifferentials B S hS b) ⟶ C :=
  (derivationDirectImageEquiv B S hS a b C).symm (descendedDerivation B S hS b Δ hzero)

/-- Equation (0619) at the descended derivation: the derivation attached to
`AlgebraicGeometry.Space.descendedDifferentialsHom` is the descended derivation itself. -/
@[simp]
theorem derivationDirectImageEquiv_descendedDifferentialsHom :
    derivationDirectImageEquiv B S hS a b C (descendedDifferentialsHom B S hS b a C Δ hzero) =
      descendedDerivation B S hS b Δ hzero :=
  (derivationDirectImageEquiv B S hS a b C).apply_symm_apply _

/-- **The characterizing equation of the descended linear map**, read on sections: the transpose
of `θ` along `a^* ⊣ a_*` carries the universal differential `d_{Y/T}(t)` of a local section `t`
of `𝒪_Y` to the value of the descended derivation at `t`. -/
theorem descendedDifferentialsHom_spec {V : (SmallEtale B S hS Y.1)ᵒᵖ}
    (t : (structureRingSheaf B S hS Y).obj.obj V) :
    (((modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C
          (descendedDifferentialsHom B S hS b a C Δ hzero)).val.app V).hom
        ((universalDerivation B S hS b).d t) =
      Δ.descend t :=
  PresheafOfModulesOfCommRing.Derivation.congr_d
    (derivationDirectImageEquiv_descendedDifferentialsHom B S hS b a C Δ hzero) t

/-- **The descended linear map is the only one with that property.**  Equation (0619) is a
bijection, so a morphism whose attached derivation is the descended derivation is the descended
linear map. -/
theorem eq_descendedDifferentialsHom
    (θ : (modulePullback B S hS a).obj (sheafOfDifferentials B S hS b) ⟶ C)
    (hθ : derivationDirectImageEquiv B S hS a b C θ = descendedDerivation B S hS b Δ hzero) :
    θ = descendedDifferentialsHom B S hS b a C Δ hzero :=
  (derivationDirectImageEquiv B S hS a b C).injective
    (hθ.trans (derivationDirectImageEquiv_descendedDifferentialsHom B S hS b a C Δ hzero).symm)

/-- The sectionwise characterization determines the descended linear map. -/
theorem eq_descendedDifferentialsHom_of_spec
    (θ : (modulePullback B S hS a).obj (sheafOfDifferentials B S hS b) ⟶ C)
    (hθ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ) (t : (structureRingSheaf B S hS Y).obj.obj V),
      (((modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C
          θ).val.app V).hom ((universalDerivation B S hS b).d t) = Δ.descend t) :
    θ = descendedDifferentialsHom B S hS b a C Δ hzero := by
  refine eq_descendedDifferentialsHom B S hS b a C Δ hzero θ ?_
  apply PresheafOfModulesOfCommRing.Derivation.ext
  ext V t
  exact hθ V t

/-- **Existence and uniqueness of the descended linear map.** -/
theorem existsUnique_descendedDifferentialsHom :
    ∃! θ : (modulePullback B S hS a).obj (sheafOfDifferentials B S hS b) ⟶ C,
      derivationDirectImageEquiv B S hS a b C θ = descendedDerivation B S hS b Δ hzero :=
  ⟨descendedDifferentialsHom B S hS b a C Δ hzero,
    derivationDirectImageEquiv_descendedDifferentialsHom B S hS b a C Δ hzero,
    fun _ h => eq_descendedDifferentialsHom B S hS b a C Δ hzero _ h⟩

/-- **The direct image of modules along a morphism of algebraic spaces is additive.**  It is a
right adjoint, hence preserves binary products and the zero morphisms. -/
instance additive_modulePushforward : (modulePushforward B S hS a).Additive :=
  haveI : (modulePushforward B S hS a).IsRightAdjoint :=
    ⟨_, ⟨modulePullbackAdjunction B S hS a⟩⟩
  Functor.additive_of_preserves_binary_products _

/-- **The inverse image of modules along a morphism of algebraic spaces is additive**, being the
left adjoint of an additive functor. -/
instance additive_modulePullback : (modulePullback B S hS a).Additive :=
  Adjunction.left_adjoint_additive (modulePullbackAdjunction B S hS a)

section Additivity

variable {X : AlgebraicSpaces B S hS} (a : X ⟶ Y) (C : Modules B S hS X.1 X.2)
  (Δ₁ Δ₂ Δ₃ : QuotientDerivation q ((modulePushforward B S hS a).obj C))
  (hz₁ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    Δ₁.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)
  (hz₂ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    Δ₂.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)
  (hz₃ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    Δ₃.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)

/-- **The descended linear maps add.**  If the derivation of the third datum is the sum of the
other two on every section, then the three linear maps on differentials add up.  This is what
makes the differences along a chain of three lifts add. -/
theorem descendedDifferentialsHom_add
    (hd : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ) (x : A.obj.obj V), Δ₃.d x = Δ₁.d x + Δ₂.d x) :
    descendedDifferentialsHom B S hS b a C Δ₁ hz₁ +
        descendedDifferentialsHom B S hS b a C Δ₂ hz₂ =
      descendedDifferentialsHom B S hS b a C Δ₃ hz₃ := by
  refine eq_descendedDifferentialsHom_of_spec B S hS b a C Δ₃ hz₃ _ ?_
  intro V t
  have hadd : (modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C
        (descendedDifferentialsHom B S hS b a C Δ₁ hz₁ +
          descendedDifferentialsHom B S hS b a C Δ₂ hz₂) =
      (modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C
          (descendedDifferentialsHom B S hS b a C Δ₁ hz₁) +
        (modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C
          (descendedDifferentialsHom B S hS b a C Δ₂ hz₂) :=
    map_add ((modulePullbackAdjunction B S hS a).homAddEquiv
      (sheafOfDifferentials B S hS b) C) _ _
  rw [congrArg (fun m : sheafOfDifferentials B S hS b ⟶
      (modulePushforward B S hS a).obj C =>
    (m.val.app V).hom ((universalDerivation B S hS b).d t)) hadd]
  exact (congrArg₂ (· + ·) (descendedDifferentialsHom_spec B S hS b a C Δ₁ hz₁ t)
    (descendedDifferentialsHom_spec B S hS b a C Δ₂ hz₂ t)).trans
      (QuotientDerivation.descend_add Δ₁ Δ₂ Δ₃ hd t).symm

/-- **The descended linear map of the zero derivation is zero.**  This is what makes a lift
differ from itself by the zero map. -/
theorem descendedDifferentialsHom_eq_zero
    (hd : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ) (x : A.obj.obj V), Δ₁.d x = 0) :
    descendedDifferentialsHom B S hS b a C Δ₁ hz₁ = 0 := by
  refine (eq_descendedDifferentialsHom_of_spec B S hS b a C Δ₁ hz₁ 0 ?_).symm
  intro V t
  have hz : (modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C 0 = 0 :=
    map_zero ((modulePullbackAdjunction B S hS a).homAddEquiv
      (sheafOfDifferentials B S hS b) C)
  rw [congrArg (fun m : sheafOfDifferentials B S hS b ⟶
      (modulePushforward B S hS a).obj C =>
    (m.val.app V).hom ((universalDerivation B S hS b).d t)) hz]
  exact (QuotientDerivation.descend_eq_zero_of_d_eq_zero Δ₁ hd t).symm

end Additivity

section Lifts

variable {X : AlgebraicSpaces B S hS} (a : X ⟶ Y) (C : Modules B S hS X.1 X.2)
  {E : SquareZeroValues ((modulePushforward B S hS a).obj C)}
  (L L₁ L₂ L₃ : LiftDifferenceData q E)
  (hz : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    L.toQuotientDerivation.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)
  (hz₁ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    L₁.toQuotientDerivation.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)
  (hz₂ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    L₂.toQuotientDerivation.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)
  (hz₃ : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
    (s : (inverseImageStructureSheaf B S hS b).obj.obj V),
    L₃.toQuotientDerivation.descend ((structureSharpInverseImage B S hS b).hom.app V s) = 0)

/-- **The difference of two lifts, descended to an `𝒪_X`-linear map out of the pulled back
differentials.**  For two morphisms of sheaves of rings `f, g : A ⟶ 𝒜` on the small étale site
of `Y` whose difference takes its values in a square-zero ideal identified with `a_*C`, which
agree on the sections killed by a locally surjective `q : A ⟶ 𝒪_Y` and on the sections coming
from `b^{-1}𝒪_T`, the difference `f - g` is an `𝒪_X`-linear map

`θ : a^*Ω_{Y/T} ⟶ C`.

This is the descent that [Stacks Project, Tag 0618] asserts and Equation (0619) transposes: the
difference is not merely a sectionwise derivation of `A`, but an honest `𝒪_X`-linear morphism
out of the sheaf of relative differentials of `Y` over `T`. -/
noncomputable def liftDifferenceDifferentialsHom :
    (modulePullback B S hS a).obj (sheafOfDifferentials B S hS b) ⟶ C :=
  descendedDifferentialsHom B S hS b a C L.toQuotientDerivation hz

/-- **The characterizing equation of the descended difference**, on sections of `𝒪_Y` in the
image of `q`: the transpose of `θ` carries the universal differential `d_{Y/T}(q x)` to the
difference `f x - g x`, read in the module. -/
theorem liftDifferenceDifferentialsHom_spec {V : (SmallEtale B S hS Y.1)ᵒᵖ}
    (x : A.obj.obj V) :
    (((modulePullbackAdjunction B S hS a).homEquiv (sheafOfDifferentials B S hS b) C
          (liftDifferenceDifferentialsHom B S hS b a C L hz)).val.app V).hom
        ((universalDerivation B S hS b).d (q.hom.app V x)) =
      L.diff x :=
  (descendedDifferentialsHom_spec B S hS b a C L.toQuotientDerivation hz _).trans
    (QuotientDerivation.descend_app L.toQuotientDerivation x)

/-- **The descended differences add along a chain of three lifts.**  For three pairs of lifts
into the same square-zero ideal whose maps are `(f₁, f₂)`, `(f₂, f₃)` and `(f₁, f₃)`, the first
two linear maps add up to the third. -/
theorem liftDifferenceDifferentialsHom_add
    (h₁₂ : L₁.g = L₂.f) (h₁₃ : L₁.f = L₃.f) (h₂₃ : L₂.g = L₃.g) :
    liftDifferenceDifferentialsHom B S hS b a C L₁ hz₁ +
        liftDifferenceDifferentialsHom B S hS b a C L₂ hz₂ =
      liftDifferenceDifferentialsHom B S hS b a C L₃ hz₃ :=
  descendedDifferentialsHom_add B S hS b a C L₁.toQuotientDerivation
    L₂.toQuotientDerivation L₃.toQuotientDerivation hz₁ hz₂ hz₃
    fun _ x => (LiftDifferenceData.diff_add_diff L₁ L₂ L₃ h₁₂ h₁₃ h₂₃ x).symm

/-- **A lift does not differ from itself.**  If the two maps are equal, the descended linear
map is zero. -/
theorem liftDifferenceDifferentialsHom_eq_zero (h : L.f = L.g) :
    liftDifferenceDifferentialsHom B S hS b a C L hz = 0 :=
  descendedDifferentialsHom_eq_zero B S hS b a C L.toQuotientDerivation hz
    fun _ x => LiftDifferenceData.diff_eq_zero_of_eq L h x

end Lifts

end Differentials

end AlgebraicGeometry.Space

end

