universe u

/-! ### The local algebra -/

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {W : Scheme.{u}}

/-- **Two closed subschemes meeting in an effective Cartier divisor are locally contained in
it, one at a time.**  Let `K₁, K₂` be sheaves of ideals on a scheme `W` whose sum is an effective
Cartier divisor.  Then every point of `W` has an open neighbourhood `N` on which the support of
one of `K₁, K₂` is contained in the support of the other.

On an affine open `A` around the point where `K₁ + K₂` is generated by a nonzerodivisor `f`,
write `f = g₁ + g₂` with `gᵢ ∈ Kᵢ(A)`; since `Kᵢ(A) ⊆ (f)` we have `gᵢ = aᵢ f`, and `f` being a
nonzerodivisor `a₁ + a₂ = 1`, so one of `a₁, a₂`, say `aᵢ`, does not vanish at the point.  On
`N = D(aᵢ)` the element `f = aᵢ⁻¹ gᵢ` vanishes wherever `Kᵢ` does, so the support of `Kᵢ` lies
in that of `K₁ + K₂` there. -/
theorem exists_isOpen_inter_support_subset_of_isEffectiveCartierDivisor_sup
    (K₁ K₂ : W.IdealSheafData) (h : Stacks.Divisors.IsEffectiveCartierDivisor (K₁ ⊔ K₂))
    (w : W) :
    ∃ N : W.Opens, w ∈ N ∧
      ((N : Set W) ∩ K₁.support ⊆ K₂.support ∨ (N : Set W) ∩ K₂.support ⊆ K₁.support) := by
  obtain ⟨A, hA, hwA, -, f, hf, hgen⟩ :=
    Stacks.Divisors.exists_basicOpen_isRegular_span_of_isEffectiveCartierDivisor (K₁ ⊔ K₂) h w
      ⊤ trivial
  have hfmem : f ∈ (K₁ ⊔ K₂).ideal ⟨A, hA⟩ := hgen ▸ Ideal.subset_span rfl
  obtain ⟨g₁, hg₁, g₂, hg₂, hsum⟩ := Submodule.mem_sup.1 hfmem
  have hle₁ : K₁.ideal ⟨A, hA⟩ ≤ (K₁ ⊔ K₂).ideal ⟨A, hA⟩ := le_sup_left
  have hle₂ : K₂.ideal ⟨A, hA⟩ ≤ (K₁ ⊔ K₂).ideal ⟨A, hA⟩ := le_sup_right
  obtain ⟨a₁, ha₁⟩ := Ideal.mem_span_singleton'.1 (hgen ▸ hle₁ hg₁)
  obtain ⟨a₂, ha₂⟩ := Ideal.mem_span_singleton'.1 (hgen ▸ hle₂ hg₂)
  have hone : a₁ + a₂ = 1 := by
    refine hf.2 ?_
    change (a₁ + a₂) * f = 1 * f
    rw [add_mul, ha₁, ha₂, hsum, one_mul]
  -- On the basic open of `aᵢ`, the support of `Kᵢ` lies in the support of the sum.
  have key : ∀ (a g : Γ(W, A)) (K : W.IdealSheafData), K ≤ K₁ ⊔ K₂ →
      g ∈ K.ideal ⟨A, hA⟩ → a * f = g →
        (W.basicOpen a : Set W) ∩ K.support ⊆ (K₁ ⊔ K₂).support := by
    rintro a g K - hg hag q ⟨hqa, hqK⟩
    have hqA : q ∈ A := W.basicOpen_le a hqa
    rw [SetLike.mem_coe, mem_support_iff_of_mem (U := ⟨A, hA⟩) hqA, Scheme.mem_zeroLocus_iff]
      at hqK ⊢
    intro c hc
    rw [hgen] at hc
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.1 hc
    intro hqdf
    rw [Scheme.basicOpen_mul] at hqdf
    refine hqK g hg ?_
    rw [← hag, Scheme.basicOpen_mul]
    exact ⟨hqa, hqdf.2⟩
  have hwone : w ∈ W.basicOpen (a₁ + a₂) := by
    rw [hone, Scheme.basicOpen_one]
    exact hwA
  rcases (TopologicalSpace.Opens.mem_sup.1 (W.basicOpen_add_le a₁ a₂ hwone)) with hw | hw
  · refine ⟨W.basicOpen a₁, hw, Or.inl fun q hq => ?_⟩
    have := key a₁ g₁ K₁ le_sup_left hg₁ ha₁ hq
    rw [support_sup] at this
    exact this.2
  · refine ⟨W.basicOpen a₂, hw, Or.inr fun q hq => ?_⟩
    have := key a₂ g₂ K₂ le_sup_right hg₂ ha₂ hq
    rw [support_sup] at this
    exact this.1

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-! ### Two closed subspaces meeting in an effective Cartier divisor -/

/-- **Two closed subspaces meeting in an effective Cartier divisor are locally contained in it,
one at a time.**  Let `Z₁, Z₂ ⊆ X` be closed subspaces of an algebraic space whose intersection
`Z₁ ∩ Z₂` is an effective Cartier divisor on `X`.  Then every point of `|X|` has an open
neighbourhood `N` such that `N ∩ |Z₁| ⊆ |Z₂|` or `N ∩ |Z₂| ⊆ |Z₁|`.

Choose an étale scheme chart through the point.  The inverse image of `Z₁ ∩ Z₂` on it is an
effective Cartier divisor (Stacks 083C), and it is cut out by the sum of the sheaves of ideals
of `Z₁` and `Z₂` (`AlgebraicGeometry.Space.ker_rep_snd_inf`), so the scheme case
`Scheme.IdealSheafData.exists_isOpen_inter_support_subset_of_isEffectiveCartierDivisor_sup`
gives such a neighbourhood on the chart; its image in `|X|` is open because the chart is étale
(Stacks 03IR), and the supports of the two sheaves of ideals are the inverse images of `|Z₁|`
and `|Z₂|` (`AlgebraicGeometry.Space.mem_support_ker_rep_snd_iff`). -/
theorem exists_isOpen_inter_subspacePointSet_subset_of_isEffectiveCartierDivisor_inf
    (X : AlgebraicSpaces B S hS) (Z₁ Z₂ : ClosedSubspaces B S hS X.1)
    (h : IsEffectiveCartierDivisor B S hS X
      ⟨Z₁.1 ⊓ Z₂.1, inf_isClosedSubspace B S hS X.1 X.2 Z₁ Z₂⟩)
    (x : points B S hS X.1) :
    ∃ N : Set (points B S hS X.1), IsOpen N ∧ x ∈ N ∧
      (N ∩ subspacePointSet B S hS X.1 Z₁.1 ⊆ subspacePointSet B S hS X.1 Z₂.1 ∨
        N ∩ subspacePointSet B S hS X.1 Z₂.1 ⊆ subspacePointSet B S hS X.1 Z₁.1) := by
  obtain ⟨W, c, -, hcE, w, hw⟩ := exists_affine_etale_chart_at_point B S hS X.1 X.2 x
  have hc : IsEtale B S hS c := isEtale_of_presheaf_etale B S hS hcE
  have hD := (isSchemeEffectiveCartierPullback_iff B S hS X _ W c).1
    (hasEffectiveCartierEtalePullbacks_of_isEffectiveCartier B S hS X _ h W c hc)
  rw [ker_rep_snd_inf B S hS Z₁.1 Z₂.1 Z₁.2.2 Z₂.2.2
    (inf_isClosedSubspace B S hS X.1 X.2 Z₁ Z₂).2 c] at hD
  obtain ⟨N₀, hwN₀, hN₀⟩ :=
    Scheme.IdealSheafData.exists_isOpen_inter_support_subset_of_isEffectiveCartierDivisor_sup
      _ _ hD (pointsToScheme B S hS W w)
  set N₁ : Set (points B S hS (yoneda.obj W)) := pointsToScheme B S hS W ⁻¹' N₀ with hN₁
  have hN₁open : IsOpen N₁ :=
    N₀.isOpen.preimage (schemePointsHomeomorph B S hS W).continuous
  refine ⟨pointsMap B S hS _ c '' N₁,
    isOpenMap_pointsMap_of_isEtale B S hS c (isAlgebraicSpace_yoneda B S hS W) X.2 hc _ hN₁open,
    ⟨w, hwN₀, hw⟩, ?_⟩
  have hsupp : ∀ (Z : ClosedSubspaces B S hS X.1) (v : points B S hS (yoneda.obj W)),
      pointsToScheme B S hS W v ∈
          ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd c)).ker.support ↔
        pointsMap B S hS _ c v ∈ subspacePointSet B S hS X.1 Z.1 := fun Z v =>
    mem_support_ker_rep_snd_iff B S hS Z.1 Z.2.2 c v
  rcases hN₀ with hN₀ | hN₀
  · refine Or.inl ?_
    rintro _ ⟨⟨v, hvN, rfl⟩, hv⟩
    exact (hsupp Z₂ v).1 (hN₀ ⟨hvN, (hsupp Z₁ v).2 hv⟩)
  · refine Or.inr ?_
    rintro _ ⟨⟨v, hvN, rfl⟩, hv⟩
    exact (hsupp Z₁ v).1 (hN₀ ⟨hvN, (hsupp Z₂ v).2 hv⟩)

/-! ### A closed subspace cut out by the sections supported on a set -/

/-- **A closed subspace cut out by the sections supported on `T` has no points in an open set
contained in `T`.**  Let `H ⊆ P` be a closed subspace of an algebraic space whose defining ideal
sheaf of Stacks 03MB is the ideal of sections of `𝒪_P` supported on a set of points `T`
(Stacks 0859), and let `N ⊆ |P|` be an open set contained in `T`.  Then `N` does not meet `|H|`.

Given a point of `N`, choose an étale scheme chart through it and restrict it to the Zariski open
lying over `N`.  Every point of the restricted chart lies over `T`, so the unit section is
supported on `T` there, hence lies in the defining ideal of `H`: the base change of `H` to the
chart has the zero ring as its ring of global functions, so it has no points, and the point of
`N` is not a point of `H`. -/
theorem disjoint_subspacePointSet_of_definingIdealSheaf_eq_supportedSections
    {P : AlgebraicSpaces B S hS} (T : Set (points B S hS P.1))
    (H : ClosedSubspaces B S hS P.1)
    (hH : definingIdealSheaf B S hS P H =
      supportedSectionsSubmodule B S hS P.1 P.2 T
        (SheafOfModules.unit (structureRingSheaf B S hS P)))
    {N : Set (points B S hS P.1)} (hN : IsOpen N) (hNT : N ⊆ T) :
    Disjoint N (subspacePointSet B S hS P.1 H.1) := by
  refine Set.disjoint_left.2 fun x hxN ⟨c₀, hc₀⟩ => ?_
  obtain ⟨W, c, -, hcE, w, hw⟩ := exists_affine_etale_chart_at_point B S hS P.1 P.2 x
  let A : SmallEtale B S hS P.1 := ⟨CostructuredArrow.mk c, hcE⟩
  set O : ((BigFppfOver.toScheme B S hS).obj W).Opens :=
    ⟨schemePointsHomeomorph B S hS W '' (pointsMap B S hS _ c ⁻¹' N),
      (schemePointsHomeomorph B S hS W).isOpen_image.2
        (hN.preimage (continuous_pointsMap B S hS c))⟩ with hO
  let A' : SmallEtale B S hS P.1 := openChart B S hS P.1 A O
  -- every point of the restricted chart lies over `N`
  have hA'N : ∀ z : points B S hS (yoneda.obj (openSub W O)),
      pointsMap B S hS _ (yoneda.map (openSubHom W O)) z ∈ pointsMap B S hS _ c ⁻¹' N := by
    intro z
    have hz : pointsToScheme B S hS W
        (pointsMap B S hS _ (yoneda.map (openSubHom W O)) z) ∈ O := by
      rw [pointsToScheme_pointsMap_yoneda, toScheme_map_openSubHom]
      exact (pointsToScheme B S hS (openSub W O) z).2
    obtain ⟨v, hv, hveq⟩ := hz
    rwa [← injective_pointsToScheme B S hS W hveq]
  -- the point `w` lies on the restricted chart
  obtain ⟨z, hz⟩ : ∃ z : points B S hS (yoneda.obj (openSub W O)),
      pointsMap B S hS _ (yoneda.map (openSubHom W O)) z = w := by
    have hwO : pointsToScheme B S hS W w ∈ O :=
      ⟨w, show pointsMap B S hS _ c w ∈ N from hw ▸ hxN, rfl⟩
    obtain ⟨z, hz⟩ := surjective_pointsToScheme B S hS (openSub W O)
      (⟨pointsToScheme B S hS W w, hwO⟩ : (O : Scheme))
    refine ⟨z, injective_pointsToScheme B S hS W ?_⟩
    rw [pointsToScheme_pointsMap_yoneda, toScheme_map_openSubHom, hz]
    rfl
  -- the unit section is supported on `T` over the restricted chart
  have h1 : (1 : (structureRingSheaf B S hS P).obj.obj (op A')) ∈
      definingIdealAt B S hS P H (op A') := by
    rw [← definingIdealSheaf_obj, hH]
    exact (mem_supportedSectionsSubmodule_iff B S hS P.1 P.2 T _ A' _).2 fun y _ =>
      hNT (pointsMap_comp_apply B S hS (yoneda.map (openSubHom W O)) c y ▸ hA'N y)
  rw [definingIdealAt_eq_ker] at h1
  have h0 : (1 : Γ((BigFppfOver.toScheme B S hS).obj (H.2.2.rep.pullback A'.obj.hom), ⊤)) =
      0 := by
    have h2 : (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
        (H.2.2.rep.snd A'.obj.hom)).op).hom 1 = 0 := h1
    rwa [map_one] at h2
  have := Scheme.isEmpty_of_one_eq_zero h0
  -- but `x` is a point of `H` over the restricted chart
  have hxz : pointsMap B S hS H.1.toFunctor H.1.ι c₀ =
      pointsMap B S hS _ A'.obj.hom z := by
    rw [hc₀, ← hw, ← hz]
    exact (pointsMap_comp_apply B S hS (yoneda.map (openSubHom W O)) c z).symm
  obtain ⟨p, -, -⟩ := exists_points_of_isPullback B S hS (H.2.2.rep.isPullback A'.obj.hom) c₀ z
    hxz
  exact IsEmpty.false (pointsToScheme B S hS _ p)

/-! ### Strict transforms of closed subspaces -/

/-- The inclusion of a closed subspace `Z ⊆ W`, as a morphism of algebraic spaces over `S`. -/
abbrev closedSubspaceSpaceι (W : AlgebraicSpaces B S hS) (Z : ClosedSubspaces B S hS W.1) :
    closedSubspaceSpace B S hS W Z ⟶ W :=
  ObjectProperty.homMk Z.1.ι

/-- The set of points of the strict transform of `f : T ⟶ A` along `b : A' ⟶ A` relative to
`E ⊆ A'` (Stacks 0862), read in `|A'|`: the image of the points of the strict transform, a closed
subspace of `T ×_A A'`, under the projection to `A'`.  For a closed subspace `T ⊆ A` this is the
point set of the strict transform of `T`, viewed as a closed subspace of `A'`. -/
abbrev strictTransformPointSet {A T A' : AlgebraicSpaces B S hS} (f : T ⟶ A) (b : A' ⟶ A)
    (E : Subfunctor A'.1) : Set (points B S hS A'.1) :=
  Set.range (pointsMap B S hS _ ((strictTransform B S hS f b E).1.ι ≫
    (strictTransformPullbackToBlowUp B S hS f b).hom))

/-- **The strict transform of a closed subspace misses every open set over which the subspace
lies in the exceptional divisor.**  Let `b : X' ⟶ X` be the blowup of `X` in a closed subspace
`Zc`, let `Z ⊆ X` be a closed subspace and let `N ⊆ |X'|` be an open set such that every point
of `N` lying over `Z` lies over `Zc`.  Then no point of the strict transform of `Z` lies in `N`.

The strict transform of `Z` is cut out of `Z ×_X X'` by the sections supported on the
exceptional preimage (`Space.definingIdealSheaf_strictTransform_of_isBlowupAlong`),
and the inverse image of `N` in `Z ×_X X'` is an open set contained in the exceptional preimage,
so `AlgebraicGeometry.Space.disjoint_subspacePointSet_of_definingIdealSheaf_eq_supportedSections`
applies. -/
theorem disjoint_strictTransformPointSet_of_inter_subset {X X' : AlgebraicSpaces B S hS}
    (Zc : ClosedSubspaces B S hS X.1) {b : X' ⟶ X} (hb : IsBlowupAlong B S hS Zc b)
    (Z : ClosedSubspaces B S hS X.1) {N : Set (points B S hS X'.1)} (hN : IsOpen N)
    (hNZ : N ∩ subspacePointSet B S hS X'.1 (preimageClosedSubspace b Z).1 ⊆
      subspacePointSet B S hS X'.1 (preimageClosedSubspace b Zc).1) :
    Disjoint N (strictTransformPointSet (closedSubspaceSpaceι X Z) b
      (preimageClosedSubspace b Zc).1) := by
  set f := closedSubspaceSpaceι X Z with hf
  set pr := (strictTransformPullbackToBlowUp B S hS f b).hom with hpr
  have hN' : IsOpen (pointsMap B S hS _ pr ⁻¹' N) := hN.preimage (continuous_pointsMap B S hS pr)
  have hN'T : pointsMap B S hS _ pr ⁻¹' N ⊆
      exceptionalPreimageSet B S hS f b (preimageClosedSubspace b Zc).1 := by
    intro y hy
    rw [exceptionalPreimageSet_eq_preimage]
    refine hNZ ⟨hy, ?_⟩
    change pointsMap B S hS _ pr y ∈ Set.range (pointsMap B S hS _ (Z.1.preimage b.hom).ι)
    rw [range_pointsMap_preimage_ι, Set.mem_preimage, ← pointsMap_comp_apply]
    have hcond : pr ≫ b.hom = pullback.fst f.hom b.hom ≫ Z.1.ι := pullback.condition.symm
    rw [hcond]
    exact ⟨pointsMap B S hS _ (pullback.fst f.hom b.hom) y,
      (pointsMap_comp_apply B S hS (pullback.fst f.hom b.hom) Z.1.ι y).symm⟩
  have hdisj := disjoint_subspacePointSet_of_definingIdealSheaf_eq_supportedSections _
    (strictTransform B S hS f b (preimageClosedSubspace b Zc).1)
    (definingIdealSheaf_strictTransform_of_isBlowupAlong B S hS f b Zc hb) hN' hN'T
  refine Set.disjoint_left.2 fun x hxN ⟨q, hq⟩ => ?_
  have hqN : pointsMap B S hS _
      (strictTransform B S hS f b (preimageClosedSubspace b Zc).1).1.ι q ∈
        pointsMap B S hS _ pr ⁻¹' N := by
    rw [Set.mem_preimage, ← pointsMap_comp_apply, hq]
    exact hxN
  exact Set.disjoint_left.1 hdisj hqN (Set.mem_range_self q)

/-- **Stacks 0F46, part (1).** Let `S` be a scheme, let `X` be an algebraic space over `S` and
let `U ⊆ X` be an open subspace.  If `Z₁, Z₂ ⊆ X` are closed subspaces of finite presentation
with `Z₁ ∩ Z₂ ∩ U = ∅`, then there is a `U`-admissible blowup `b : X' ⟶ X` such that the strict
transforms of `Z₁` and `Z₂` are disjoint.

The centre `Y` of the blowup is recorded together with the blowup, since the strict transform is
taken with respect to the blowup in a given centre (Stacks 0862): `Y` is a closed subspace of
finite presentation whose points miss those of `U`, `b` is the blowup of `X` in `Y`, and the
strict transforms of `Zᵢ`, relative to the exceptional divisor `b⁻¹Y`, have disjoint images in
`|X'|`.  The first conjunct is the admissibility of `b`, which is the existence of such a `Y`.

The centre is `Y = Z₁ ∩ Z₂`, which is of finite presentation and misses `U`.  Its inverse image
`b⁻¹Z₁ ∩ b⁻¹Z₂` is an effective Cartier divisor on `X'`, so every point of `X'` has an open
neighbourhood over which one of `b⁻¹Z₁, b⁻¹Z₂` lies in the exceptional divisor
(`Space.exists_isOpen_inter_subspacePointSet_subset_of_isEffectiveCartierDivisor_inf`),
and over such a neighbourhood the corresponding strict transform is empty
(`AlgebraicGeometry.Space.disjoint_strictTransformPointSet_of_inter_subset`).

This is [Stacks, Tag 0F46], part (1). -/
theorem exists_isAdmissibleBlowup_disjoint_strictTransformPointSet
    {X : AlgebraicSpaces B S hS} (U : OpenSubspaces B S hS X.1)
    (Z₁ Z₂ : ClosedSubspaces B S hS X.1)
    (h₁ : IsFinitePresentation B S hS Z₁.1.ι) (h₂ : IsFinitePresentation B S hS Z₂.1.ι)
    (hdisj : Disjoint (subspacePointSet B S hS X.1 U.1 ∩ subspacePointSet B S hS X.1 Z₁.1)
      (subspacePointSet B S hS X.1 Z₂.1)) :
    ∃ (X' : AlgebraicSpaces B S hS) (b : X' ⟶ X) (Y : ClosedSubspaces B S hS X.1),
      IsAdmissibleBlowup B S hS U b ∧ IsFinitePresentation B S hS Y.1.ι ∧
        Disjoint (subspacePointSet B S hS X.1 U.1) (subspacePointSet B S hS X.1 Y.1) ∧
          IsBlowupAlong B S hS Y b ∧
            Disjoint (strictTransformPointSet (closedSubspaceSpaceι X Z₁) b
                (preimageClosedSubspace b Y).1)
              (strictTransformPointSet (closedSubspaceSpaceι X Z₂) b
                (preimageClosedSubspace b Y).1) := by
  set Y : ClosedSubspaces B S hS X.1 :=
    ⟨Z₁.1 ⊓ Z₂.1, inf_isClosedSubspace B S hS X.1 X.2 Z₁ Z₂⟩ with hY
  have hYfp : IsFinitePresentation B S hS Y.1.ι :=
    isFinitePresentation_inf B S hS X.2 Z₁.1 Z₂.1 Z₁.2 Z₂.2 Y.2 h₁ h₂
  have hYU : Disjoint (subspacePointSet B S hS X.1 U.1) (subspacePointSet B S hS X.1 Y.1) := by
    rw [show Y.1 = Z₁.1 ⊓ Z₂.1 from rfl, subspacePointSet_inf]
    exact Set.disjoint_left.2 fun x hxU hxZ =>
      Set.disjoint_left.1 hdisj ⟨hxU, hxZ.1⟩ hxZ.2
  obtain ⟨X', b, hb⟩ := exists_isBlowupAlong_of_isFinitePresentation Y hYfp
  refine ⟨X', b, Y, ⟨Y, hYfp, hYU, hb⟩, hYfp, hYU, hb, Set.disjoint_left.2 fun x hx₁ hx₂ => ?_⟩
  set D₁ := preimageClosedSubspace b Z₁
  set D₂ := preimageClosedSubspace b Z₂
  have hDY : (preimageClosedSubspace b Y).1 = D₁.1 ⊓ D₂.1 := rfl
  have hE : IsEffectiveCartierDivisor B S hS X'
      ⟨D₁.1 ⊓ D₂.1, inf_isClosedSubspace B S hS X'.1 X'.2 D₁ D₂⟩ :=
    isEffectiveCartierDivisor_of_subfunctor_eq hDY.symm hb.isPullbackDefined
  obtain ⟨N, hN, hxN, hN'⟩ :=
    exists_isOpen_inter_subspacePointSet_subset_of_isEffectiveCartierDivisor_inf X' D₁ D₂ hE x
  rcases hN' with h | h
  · refine Set.disjoint_left.1 (disjoint_strictTransformPointSet_of_inter_subset Y hb Z₁ hN
      fun y hy => ?_) hxN hx₁
    rw [hDY, subspacePointSet_inf]
    exact ⟨hy.2, h hy⟩
  · refine Set.disjoint_left.1 (disjoint_strictTransformPointSet_of_inter_subset Y hb Z₂ hN
      fun y hy => ?_) hxN hx₂
    rw [hDY, subspacePointSet_inf]
    exact ⟨h hy, hy.2⟩

/-! ### Closures of constructible closed subsets -/

/-- **An open subspace with compact point set is quasi-compact.**  The open subspace of an
algebraic space cut out by an open and compact set of points is quasi-compact: its points are
that set, through the open embedding of its points. -/
theorem isQuasiCompactSpace_openSubspaceOfPoints {X : AlgebraicSpaces B S hS}
    {G : Set (points B S hS X.1)} (hGo : IsOpen G) (hGc : IsCompact G) :
    IsQuasiCompactSpace B S hS (openSubspaceOfPoints B S hS X.1 G).toFunctor := by
  have hO := isOpenSubspace_openSubspaceOfPoints B S hS X.2 G hGo
  refine (isQuasiCompactSpace_iff_compactSpace_points B S hS _ hO.1).2 ⟨?_⟩
  refine (isOpenEmbedding_pointsMap_ι B S hS hO).isEmbedding.isCompact_iff.2 ?_
  rw [Set.image_univ, range_pointsMap_ι_openSubspaceOfPoints]
  exact hGc

/-- **The points of a blowup lying over a closed subspace away from the centre lie on its strict
transform.**  Let `b : X' ⟶ X` be the blowup of `X` in a closed subspace `Zc` and let `Z ⊆ X` be
a closed subspace.  A point of `X'` whose image in `X` lies on `Z` but not on `Zc` is a point of
the strict transform of `Z`.

The point lifts to a point of `Z ×_X X'` lying over `X ∖ Zc`, and that part of `Z ×_X X'` is
contained in the strict transform by
`AlgebraicGeometry.Space.preimage_openComplement_le_strictTransform_of_isBlowupAlong`. -/
theorem mem_strictTransformPointSet_of_notMem {X X' : AlgebraicSpaces B S hS}
    (Zc : ClosedSubspaces B S hS X.1) {b : X' ⟶ X} (hb : IsBlowupAlong B S hS Zc b)
    (Z : ClosedSubspaces B S hS X.1) {x' : points B S hS X'.1}
    (hZ : pointsMap B S hS _ b.hom x' ∈ subspacePointSet B S hS X.1 Z.1)
    (hZc : pointsMap B S hS _ b.hom x' ∉ subspacePointSet B S hS X.1 Zc.1) :
    x' ∈ strictTransformPointSet (closedSubspaceSpaceι X Z) b
      (preimageClosedSubspace b Zc).1 := by
  set f := closedSubspaceSpaceι X Z with hf
  obtain ⟨z, hz⟩ := hZ
  obtain ⟨y, hy₁, hy₂⟩ := exists_points_of_isPullback B S hS
    (IsPullback.of_hasPullback f.hom b.hom) z x' hz
  have hle := preimage_openComplement_le_strictTransform_of_isBlowupAlong B S hS f b Zc hb
  have hyCo : y ∈ subspacePointSet B S hS _
      (((openComplementOfClosedSubspace B S hS X Zc).1.preimage f.hom).preimage
        (strictTransformPullbackToSource B S hS f b).hom) := by
    rw [subspacePointSet, range_pointsMap_preimage_ι]
    refine Set.mem_preimage.2 ?_
    rw [range_pointsMap_preimage_ι]
    refine Set.mem_preimage.2 ?_
    rw [← subspacePointSet, subspacePointSet_openComplement]
    have h1 : pointsMap B S hS _ (strictTransformPullbackToSource B S hS f b).hom y = z := hy₁
    rw [h1]
    exact hz ▸ hZc
  obtain ⟨q, hq⟩ := range_pointsMap_ι_le B S hS hle hyCo
  refine ⟨q, ?_⟩
  have hc := pointsMap_comp_apply B S hS
    (strictTransform B S hS f b (preimageClosedSubspace b Zc).1).1.ι
    (strictTransformPullbackToBlowUp B S hS f b).hom q
  exact hc.trans ((congrArg (pointsMap B S hS _ (strictTransformPullbackToBlowUp B S hS f b).hom)
    hq).trans hy₂)

/-- The point set of the strict transform of a closed subspace is closed: the strict transform
is a closed subspace of `Z ×_X X'`, which is a closed subspace of `X'`. -/
theorem isClosed_strictTransformPointSet {X X' : AlgebraicSpaces B S hS} (b : X' ⟶ X)
    (Z : ClosedSubspaces B S hS X.1) (E : Subfunctor X'.1) :
    IsClosed (strictTransformPointSet (closedSubspaceSpaceι X Z) b E) := by
  have := isClosedImmersion_isStableUnderBaseChange B S hS
  have hpr : IsClosedImmersion B S hS (pullback.snd (closedSubspaceSpaceι X Z).hom b.hom) :=
    MorphismProperty.of_isPullback
      (IsPullback.of_hasPullback (closedSubspaceSpaceι X Z).hom b.hom) Z.2.2
  exact isClosed_range_pointsMap_of_isClosedImmersion B S hS X'.2 _
    (isClosedImmersion_comp B S hS _ _
      (strictTransform B S hS (closedSubspaceSpaceι X Z) b E).2.2 hpr)

/-- **Stacks 0F46, part (2).** Let `S` be a scheme, let `X` be a quasi-compact and
quasi-separated algebraic space over `S` and let `U ⊆ X` be a quasi-compact open subspace.  If
`T₁, T₂ ⊆ |U|` are disjoint constructible closed subsets, then there is a `U`-admissible blowup
`b : X' ⟶ X` such that the closures of `T₁` and `T₂` in `|X'|` are disjoint.

Here `Tᵢ` is viewed in `|X'|` as the set of points mapping into its image in `|X|`; since `b` is
an isomorphism over `U` this is a copy of `Tᵢ` inside `b⁻¹(U)`.

The complement of `Tᵢ` in `|U|` is constructible, hence quasi-compact, and open in `|X|`; so it
is the complement of a closed subspace `Zᵢ ⊆ X` of finite presentation
(by Stacks 0855, 03MB and 084Q),
with `|Zᵢ| ∩ |U| = Tᵢ`.  Part (1) gives a `U`-admissible blowup in which the strict transforms of
`Z₁, Z₂` are disjoint; they are closed, and contain the points over `Tᵢ`
(`AlgebraicGeometry.Space.mem_strictTransformPointSet_of_notMem`), hence their closures.

This is [Stacks, Tag 0F46], part (2). -/
theorem exists_isAdmissibleBlowup_disjoint_closure
    (hZ : B.Contains (⊤_ Scheme.{u})) {X : AlgebraicSpaces B S hS}
    (hXqc : IsQuasiCompactSpace B S hS X.1) (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (U : OpenSubspaces B S hS X.1) (hUqc : IsQuasiCompactSpace B S hS U.1.toFunctor)
    (T₁ T₂ : Set (points B S hS U.1.toFunctor)) (hT₁ : IsClosed T₁) (hT₂ : IsClosed T₂)
    (hc₁ : Topology.IsConstructible T₁) (hc₂ : Topology.IsConstructible T₂)
    (hdisj : Disjoint T₁ T₂) :
    ∃ (X' : AlgebraicSpaces B S hS) (b : X' ⟶ X), IsAdmissibleBlowup B S hS U b ∧
      Disjoint (closure (pointsMap B S hS _ b.hom ⁻¹' (pointsMap B S hS _ U.1.ι '' T₁)))
        (closure (pointsMap B S hS _ b.hom ⁻¹' (pointsMap B S hS _ U.1.ι '' T₂))) := by
  have : CompactSpace (points B S hS U.1.toFunctor) :=
    (isQuasiCompactSpace_iff_compactSpace_points B S hS _ U.2.1).1 hUqc
  have hemb : Topology.IsOpenEmbedding (pointsMap B S hS _ U.1.ι) :=
    isOpenEmbedding_pointsMap_ι B S hS U.2
  -- each `Tᵢ` is the trace on `U` of a finitely presented closed subspace of `X`
  have hclosed : ∀ T : Set (points B S hS U.1.toFunctor), IsClosed T →
      Topology.IsConstructible T → ∃ Z : ClosedSubspaces B S hS X.1,
        IsFinitePresentation B S hS Z.1.ι ∧
          subspacePointSet B S hS X.1 Z.1 = (pointsMap B S hS _ U.1.ι '' Tᶜ)ᶜ := by
    intro T hT hc
    set W := pointsMap B S hS _ U.1.ι '' Tᶜ with hW
    have hWopen : IsOpen W := hemb.isOpenMap _ hT.isOpen_compl
    have hWcpt : IsCompact W := hc.compl.isCompact.image (continuous_pointsMap B S hS _)
    have hO := isOpenSubspace_openSubspaceOfPoints B S hS X.2 W hWopen
    have hOpts := range_pointsMap_ι_openSubspaceOfPoints B S hS W (F := X.1)
    have hOqc := isQuasiCompactSpace_openSubspaceOfPoints hWopen hWcpt
    obtain ⟨Z, hZfp, hZpts⟩ : ∃ Z : ClosedSubspaces B S hS X.1,
        IsFinitePresentation B S hS Z.1.ι ∧ subspacePointSet B S hS X.1 Z.1 =
          (subspacePointSet B S hS X.1 (openSubspaceOfPoints B S hS X.1 W))ᶜ := by
      obtain ⟨I, ⟨hIqc, hIft⟩, hIzero⟩ :=
        hasFiniteTypeQuasicoherentIdealZeroLocus_of_isQuasiCompactSpace B S hS hZ X hXqc hXqs hO
          hOqc
      obtain ⟨Z, hZI⟩ := exists_definingIdealSheaf_eq_of_isCartesianOnAffineCharts B S hS X I
        (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hIqc)
      refine ⟨Z, (isFinitePresentation_iff_isFiniteTypeOnSite_kernelIdealSheaf B S hS
        (ObjectProperty.homMk Z.1.ι : (⟨Z.1.toFunctor, Z.2.1⟩ : AlgebraicSpaces B S hS) ⟶ X)
        Z.2.2).2 ?_, ?_⟩
      · rw [kernelIdealSheaf_eq_definingIdealSheaf, hZI]
        exact hIft
      · rw [subspacePointSet, range_pointsMap_ι_eq_idealZeroLocus B S hS X Z, hZI, ← hIzero]
    exact ⟨Z, hZfp, by rw [hZpts, subspacePointSet, hOpts]⟩
  have hmem : ∀ (T : Set (points B S hS U.1.toFunctor)) (Z : ClosedSubspaces B S hS X.1),
      subspacePointSet B S hS X.1 Z.1 = (pointsMap B S hS _ U.1.ι '' Tᶜ)ᶜ →
        ∀ u, pointsMap B S hS _ U.1.ι u ∈ subspacePointSet B S hS X.1 Z.1 ↔ u ∈ T := by
    intro T Z hZpts u
    rw [hZpts, Set.mem_compl_iff, hemb.injective.mem_set_image, Set.mem_compl_iff, not_not]
  obtain ⟨Z₁, hZ₁fp, hZ₁⟩ := hclosed T₁ hT₁ hc₁
  obtain ⟨Z₂, hZ₂fp, hZ₂⟩ := hclosed T₂ hT₂ hc₂
  obtain ⟨X', b, Y, hadm, -, hYU, hb, hST⟩ :=
    exists_isAdmissibleBlowup_disjoint_strictTransformPointSet U Z₁ Z₂ hZ₁fp hZ₂fp
      (Set.disjoint_left.2 fun x ⟨⟨u, hu⟩, hx₁⟩ hx₂ => by
        subst hu
        exact Set.disjoint_left.1 hdisj ((hmem T₁ Z₁ hZ₁ u).1 hx₁) ((hmem T₂ Z₂ hZ₂ u).1 hx₂))
  have hsub : ∀ (T : Set (points B S hS U.1.toFunctor)) (Z : ClosedSubspaces B S hS X.1),
      subspacePointSet B S hS X.1 Z.1 = (pointsMap B S hS _ U.1.ι '' Tᶜ)ᶜ →
        closure (pointsMap B S hS _ b.hom ⁻¹' (pointsMap B S hS _ U.1.ι '' T)) ⊆
          strictTransformPointSet (closedSubspaceSpaceι X Z) b (preimageClosedSubspace b Y).1 := by
    intro T Z hZpts
    refine closure_minimal ?_ (isClosed_strictTransformPointSet b Z _)
    rintro x' ⟨u, hu, hux⟩
    refine mem_strictTransformPointSet_of_notMem Y hb Z ?_ ?_
    · rw [← hux]
      exact (hmem T Z hZpts u).2 hu
    · rw [← hux]
      exact Set.disjoint_left.1 hYU (Set.mem_range_self u)
  exact ⟨X', b, hadm, hST.mono (hsub T₁ Z₁ hZ₁) (hsub T₂ Z₂ hZ₂)⟩

end AlgebraicGeometry.Space
