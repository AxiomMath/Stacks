module

public import Mathlib.CategoryTheory.Limits.Shapes.Products
public import Mathlib.CategoryTheory.Sites.Subsheaf
public import Mathlib.CategoryTheory.Subfunctor.Image

/-!
# The complement of one summand of a coproduct of sheaves of sets

A coproduct of sheaves of sets on a site, presented as a colimit cofan, can be split as a
binary coproduct at any one index: the chosen summand on one side, and the subsheaf
generated by all the other summands on the other. The second construction is the content of
this file, together with the fact that every section of the coproduct is, locally on the
site, in the image of one summand.

## Main definitions

* `AlgebraicGeometry.Space.otherSubfunctor` is the subfunctor of the target generated by all
  but one member of a family of maps into it.
* `AlgebraicGeometry.Space.otherSheaf` is its sheafification, viewed as a sheaf, with
  `AlgebraicGeometry.Space.otherInclusion` the inclusion into the target and
  `AlgebraicGeometry.Space.otherMap` the factorization of each remaining member through it.

## Main results

* `AlgebraicGeometry.Space.splitColimit` exhibits a coproduct cofan of sheaves as a binary
  coproduct of one summand and the sheaf generated by the others.
* `AlgebraicGeometry.Space.coproduct_locally_factors`: a section of a coproduct of sheaves
  factors through one of the summands after restriction along a covering sieve.

## Implementation notes

The union of the ranges of the remaining maps is only a subpresheaf, so it has to be
sheafified before it can serve as the second summand. Sheafification of a subfunctor of a
sheaf of sets stays inside that sheaf, which is why
`CategoryTheory.Subfunctor.sheafify_isSheaf` suffices and no general sheafification functor
is needed.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace AlgebraicGeometry.Space

/-- The subfunctor of `F` generated by all members of the family `f` other than the one at
index `i`. -/
noncomputable def otherSubfunctor
    {C : Type (u + 1)} [Category.{u} C] {I : Type v}
    {G : I → Cᵒᵖ ⥤ Type u} {F : Cᵒᵖ ⥤ Type u}
    (f : ∀ j, G j ⟶ F) (i : I) : Subfunctor F :=
  ⨆ j : {j : I // j ≠ i}, Subfunctor.range (f j.1)

/-- The sheaf of sets cut out of `F` by the summands of `f` other than the one at index `i`,
obtained by sheafifying `AlgebraicGeometry.Space.otherSubfunctor` inside `F`. -/
noncomputable def otherSheaf
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    {I : Type v} {G : I → Cᵒᵖ ⥤ Type u} {F : Sheaf J (Type u)}
    (f : ∀ j, G j ⟶ F.obj) (i : I) : Sheaf J (Type u) :=
  let T := otherSubfunctor f i
  ⟨(T.sheafify J).toFunctor,
    (isSheaf_iff_isSheaf_of_type J _).mpr
      (T.sheafify_isSheaf ((isSheaf_iff_isSheaf_of_type J _).mp F.property))⟩

/-- The inclusion of `AlgebraicGeometry.Space.otherSheaf` into the ambient sheaf. -/
noncomputable def otherInclusion
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    {I : Type v} {G : I → Cᵒᵖ ⥤ Type u} {F : Sheaf J (Type u)}
    (f : ∀ j, G j ⟶ F.obj) (i : I) : otherSheaf f i ⟶ F :=
  ⟨Subfunctor.ι ((otherSubfunctor f i).sheafify J)⟩

/-- The factorization of the summand at an index `j ≠ i` through
`AlgebraicGeometry.Space.otherSheaf` at index `i`. -/
noncomputable def otherMap
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    {I : Type v} {G : Sheaf J (Type u)}
    {Fi : I → Sheaf J (Type u)} (f : ∀ j, Fi j ⟶ G) (i j : I) (hji : j ≠ i) :
    Fi j ⟶ otherSheaf (J := J) (fun k => (f k).hom) i :=
  let T := otherSubfunctor (fun k => (f k).hom) i
  ⟨Subfunctor.toRange (f j).hom ≫
    Subfunctor.homOfLe (show Subfunctor.range (f j).hom ≤ T from
      le_iSup (fun k : {k : I // k ≠ i} => Subfunctor.range (f k.1).hom) ⟨j, hji⟩) ≫
    Subfunctor.homOfLe (T.le_sheafify J)⟩

/-- The factorization of `AlgebraicGeometry.Space.otherMap` is compatible with the
inclusion of `AlgebraicGeometry.Space.otherSheaf`. -/
lemma otherMap_comp_inclusion
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    {I : Type v} {G : Sheaf J (Type u)}
    {Fi : I → Sheaf J (Type u)} (f : ∀ j, Fi j ⟶ G) (i j : I) (hji : j ≠ i) :
    otherMap f i j hji ≫ otherInclusion (J := J) (fun k => (f k).hom) i = f j := by
  apply Sheaf.hom_ext
  ext X x
  rfl

/-- A coproduct of sheaves of sets is, at every index, the binary coproduct of the summand
at that index and the sheaf generated by the remaining summands. -/
noncomputable def splitColimit
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    {I : Type v} {Fi : I → Sheaf J (Type u)} {F : Sheaf J (Type u)}
    (f : ∀ i, Fi i ⟶ F) (hc : IsColimit (Cofan.mk F f)) (i : I) :
    IsColimit (BinaryCofan.mk (f i) (otherInclusion (J := J) (fun j => (f j).hom) i)) := by
  classical
  let d (X : Sheaf J (Type u)) (a : Fi i ⟶ X)
      (b : otherSheaf (J := J) (fun j => (f j).hom) i ⟶ X) : F ⟶ X :=
    Cofan.IsColimit.desc hc (fun j =>
      if hj : j = i then (eqToHom (congrArg Fi hj)) ≫ a else otherMap f i j hj ≫ b)
  have hd (X : Sheaf J (Type u)) (a : Fi i ⟶ X)
      (b : otherSheaf (J := J) (fun j => (f j).hom) i ⟶ X) (j : I) : f j ≫ d X a b =
        if hj : j = i then (eqToHom (congrArg Fi hj)) ≫ a else otherMap f i j hj ≫ b :=
    Cofan.IsColimit.fac hc _ j
  refine BinaryCofan.isColimitMk (fun s => d s.pt s.inl s.inr) ?_ ?_ ?_
  · intro s
    simpa using hd s.pt s.inl s.inr i
  · intro s
    let T := otherSubfunctor (fun j => (f j).hom) i
    let k := otherInclusion (J := J) (fun j => (f j).hom) i
    change k ≫ d s.pt s.inl s.inr = s.inr
    have h (j : I) (hj : j ≠ i) :
        otherMap f i j hj ≫ k ≫ d s.pt s.inl s.inr = otherMap f i j hj ≫ s.inr := by
      rw [← Category.assoc, otherMap_comp_inclusion, hd, dite_eq_right hj]
    apply Sheaf.hom_ext
    apply Subfunctor.to_sheafify_lift_unique T
      ((isSheaf_iff_isSheaf_of_type J s.pt.obj).mp s.pt.property)
    ext U x
    have hx : x.1 ∈ (⨆ j : {j : I // j ≠ i}, Subfunctor.range (f j.1).hom).obj U := x.2
    rw [Subfunctor.iSup_obj] at hx
    simp only [Set.mem_iUnion, Subfunctor.range_obj, Set.mem_range] at hx
    obtain ⟨⟨j, hj⟩, y, hy⟩ := hx
    have hinner : (Subfunctor.homOfLe (T.le_sheafify J)).app U x =
        (otherMap f i j hj).hom.app U y := Subtype.ext hy.symm
    change (k ≫ d s.pt s.inl s.inr).hom.app U ((Subfunctor.homOfLe (T.le_sheafify J)).app U x) =
      s.inr.hom.app U ((Subfunctor.homOfLe (T.le_sheafify J)).app U x)
    rw [hinner]
    exact congrArg (fun η => η.hom.app U y) (h j hj)
  · intro s m h1 h2
    apply Cofan.IsColimit.hom_ext hc
    intro j
    change f j ≫ m = f j ≫ d s.pt s.inl s.inr
    by_cases hj : j = i
    · subst hj
      simpa [hd] using h1
    · rw [hd, dite_eq_right hj, ← otherMap_comp_inclusion f i j hj, Category.assoc]
      exact congrArg (otherMap f i j hj ≫ ·) h2

/-- Every section of a coproduct of sheaves of sets lies, locally on a covering sieve, in
the image of one of the summands. -/
lemma coproduct_locally_factors
    {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
    {I : Type v} (Fi : I → Sheaf J (Type u)) (G : Sheaf J (Type u))
    (ι : ∀ i, Fi i ⟶ G) (hc : IsColimit (Cofan.mk G ι))
    {T : C} (x : G.obj.obj (Opposite.op T)) :
    ∃ (R : Sieve T), R ∈ J T ∧ ∀ ⦃V : C⦄ (f : V ⟶ T), R f →
      ∃ (i : I) (y : (Fi i).obj.obj (Opposite.op V)),
        (ι i).hom.app (Opposite.op V) y = G.obj.map f.op x := by
  classical
  let A : Subfunctor G.obj := ⨆ i, Subfunctor.range (ι i).hom
  let Ash := A.sheafify J
  let Z : Sheaf J (Type u) := ⟨Ash.toFunctor,
    (isSheaf_iff_isSheaf_of_type J _).mpr
      (A.sheafify_isSheaf ((isSheaf_iff_isSheaf_of_type J _).mp G.property))⟩
  let inc : Z ⟶ G := ⟨Ash.ι⟩
  have hle (i : I) : Subfunctor.range (ι i).hom ≤ Ash :=
    le_trans (le_iSup (fun j => Subfunctor.range (ι j).hom) i) (A.le_sheafify J)
  let f (i : I) : Fi i ⟶ Z :=
    ⟨Subfunctor.lift (ι i).hom (hle i)⟩
  have hfac (i : I) : f i ≫ inc = ι i := by
    apply Sheaf.hom_ext
    ext V y
    rfl
  let d : G ⟶ Z := Cofan.IsColimit.desc hc (Cofan.mk Z f).inj
  have hdinc : d ≫ inc = 𝟙 G := by
    apply Cofan.IsColimit.hom_ext hc
    intro i
    have hd : (Cofan.mk G ι).inj i ≫ d = f i := Cofan.IsColimit.fac hc (Cofan.mk Z f).inj i
    rw [← Category.assoc, hd, hfac]
    simp
  have hx : x ∈ Ash.obj (Opposite.op T) := by
    have hval : inc.hom.app (Opposite.op T) (d.hom.app (Opposite.op T) x) = x := by
      simpa using congrArg (fun φ : G ⟶ G => φ.hom.app (Opposite.op T) x) hdinc
    rw [← hval]
    exact (d.hom.app (Opposite.op T) x).property
  change A.sieveOfSection x ∈ J T at hx
  refine ⟨A.sieveOfSection x, hx, ?_⟩
  intro V f hf
  change G.obj.map f.op x ∈ A.obj (Opposite.op V) at hf
  rw [Subfunctor.iSup_obj] at hf
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hf
  simp only [Subfunctor.range_obj, Set.mem_range] at hi
  exact ⟨i, hi⟩

end AlgebraicGeometry.Space

end
