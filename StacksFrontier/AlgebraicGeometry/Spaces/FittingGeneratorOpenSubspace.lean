module

public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedImmersionPoints
public import StacksFrontier.AlgebraicGeometry.Spaces.FittingClosedSubspaces
public import StacksFrontier.AlgebraicGeometry.Spaces.FittingIdealGeometricStalk
public import StacksFrontier.AlgebraicGeometry.Spaces.OpenComplement
public import StacksFrontier.AlgebraicGeometry.Spaces.SheafSupportSections

/-!
# The open complement of a Fitting closed subspace

Let `X` be an algebraic space over a scheme `S` contained in a big fppf site `B` and let `Z ⊆ X`
be a closed subspace. The point set of `Z` is exactly the zero locus
`AlgebraicGeometry.Space.idealZeroLocus` of its defining ideal sheaf, so the open complement
`X \ Z` is the open subspace cut out by the unit locus of that ideal. For the Fitting closed
subspace `Z_r` of a module `G` this identifies `X \ Z_r` with the locus of points near which `G`
is generated by `r` sections.

## Main results

* `AlgebraicGeometry.Space.definingIdealAt_eq_top_of_isEmpty`: the defining ideal of a closed
  subspace is the unit ideal on a chart whose base change is an empty scheme.
* `AlgebraicGeometry.Space.exists_affine_chart_obj_eq_top_of_mem_idealUnitLocus`: the chart
  witnessing membership in the unit locus of a sheaf of ideals may be taken affine.
* `AlgebraicGeometry.Space.range_pointsMap_ι_eq_idealZeroLocus`: the point set of a closed
  subspace is the zero locus of its defining ideal sheaf.
* `AlgebraicGeometry.Space.openComplement_eq_openSubspaceOfPoints_idealUnitLocus`: the open
  complement of a closed subspace is the open subspace cut out by the unit locus of its defining
  ideal sheaf.
* `AlgebraicGeometry.Space.mem_idealUnitLocus_fittingIdeal_iff`: a point lies in the unit locus
  of `Fit_r(G)` exactly when `G` is generated by `r` sections on an affine étale chart whose
  image contains it.
* `AlgebraicGeometry.Space.openComplement_fittingClosedSubspace_eq`: the open complement of the
  Fitting closed subspace `Z_r` is the open subspace cut out by the locus of points near which
  `G` is generated by `r` sections.

## References

* [Stacks Project, Tag 0CZ9](https://stacks.math.columbia.edu/tag/0CZ9)
* [Stacks Project, Tag 0CZ3](https://stacks.math.columbia.edu/tag/0CZ3)
* [Stacks Project, Tag 03MB](https://stacks.math.columbia.edu/tag/03MB)
* [Stacks Project, Tag 03H4](https://stacks.math.columbia.edu/tag/03H4)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (X : AlgebraicSpaces B S hS)

/-! ### Charts on which the defining ideal is the unit ideal -/

/-- The defining ideal of a closed subspace `Z` is the unit ideal on a chart `U` for which the
base change `Z ×_X U` is an empty scheme. -/
theorem definingIdealAt_eq_top_of_isEmpty (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1)
    (h : IsEmpty ((BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback U.1.hom))) :
    definingIdealAt B S hS X Z (op U) = ⊤ := by
  rw [definingIdealAt_eq_ker]
  refine eq_top_iff.2 fun a _ ↦ RingHom.mem_ker.2 ?_
  exact Subsingleton.elim
    (α := Γ((BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback U.1.hom), ⊤)) _ _

/-- The base change of a closed subspace `Z` to a chart none of whose points lands in `Z` is an
empty scheme. -/
theorem isEmpty_pullback_of_forall_notMem_range (Z : ClosedSubspaces B S hS X.1)
    {A : BigFppfOver B S hS} (g : yoneda.obj A ⟶ X.1)
    (h : ∀ p : points B S hS (yoneda.obj A), pointsMap B S hS (yoneda.obj A) g p ∉
      Set.range (pointsMap B S hS Z.1.toFunctor Z.1.ι)) :
    IsEmpty ((BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback g)) := by
  rw [← not_nonempty_iff]
  rintro ⟨v⟩
  obtain ⟨p, -⟩ := surjective_pointsToScheme B S hS (Z.2.2.rep.pullback g) v
  refine h (pointsMap B S hS (yoneda.obj (Z.2.2.rep.pullback g))
    (yoneda.map (Z.2.2.rep.snd g)) p) ?_
  have hmem : pointsMap B S hS (yoneda.obj (Z.2.2.rep.pullback g))
      (yoneda.map (Z.2.2.rep.snd g)) p ∈ Set.range (pointsMap B S hS
        (yoneda.obj (Z.2.2.rep.pullback g)) (yoneda.map (Z.2.2.rep.snd g))) := ⟨p, rfl⟩
  rwa [← preimage_range_pointsMap_eq_range_pointsMap_snd B S hS Z.2.2.rep g] at hmem

/-! ### Affine charts for the unit locus -/

/-- A point of a chart `V` lying in an open subscheme `A` of the chart comes from a point of the
open sub-chart `openChart V A`. -/
private theorem exists_pointsMap_openChart_eq (V : SmallEtale B S hS X.1)
    (A : ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V)).Opens)
    (w : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)))
    (hmemA : pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) w ∈ A) :
    ∃ p, pointsMap B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj (openChart B S hS X.1 V A)))
        (openChart B S hS X.1 V A).1.hom p =
      pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)) V.1.hom w := by
  obtain ⟨a, ha⟩ : ∃ a, A.ι.base a = pointsToScheme B S hS
      ((SmallEtale.toOver B S hS X.1).obj V) w := ⟨⟨_, hmemA⟩, rfl⟩
  obtain ⟨p, hp⟩ := surjective_pointsToScheme B S hS
    ((SmallEtale.toOver B S hS X.1).obj (openChart B S hS X.1 V A)) a
  refine ⟨p, ?_⟩
  have hkey : pointsMap B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj (openChart B S hS X.1 V A)))
      (yoneda.map ((SmallEtale.toOver B S hS X.1).map
        (openChartInclusion B S hS X.1 V A))) p = w := by
    refine injective_pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) ?_
    rw [pointsToScheme_pointsMap_yoneda, hp,
      toScheme_map_toOver_map_openChartInclusion B S hS X.1 V A]
    exact ha
  rw [← hkey, ← pointsMap_comp_apply]
  exact congrArg (fun α ↦ pointsMap B S hS (yoneda.obj
    ((SmallEtale.toOver B S hS X.1).obj (openChart B S hS X.1 V A))) α p)
    (CostructuredArrow.w (openChartInclusion B S hS X.1 V A).hom)

/-- The chart witnessing membership in the unit locus of a sheaf of ideals may be taken
affine. -/
theorem exists_affine_chart_obj_eq_top_of_mem_idealUnitLocus
    (I : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)
    {x : points B S hS X.1} (hx : x ∈ idealUnitLocus B S hS X I) :
    ∃ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) ∧
        I.obj (op U) = ⊤ ∧
        x ∈ Set.range (pointsMap B S hS
          (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.1.hom) := by
  obtain ⟨V, hV, w, hw⟩ := hx
  obtain ⟨A, hAaff, hmemA, -⟩ := exists_isAffineOpen_mem_and_subset
    (X := (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V))
    (x := pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) w)
    (U := ⊤) trivial
  refine ⟨openChart B S hS X.1 V A, hAaff,
    SheafOfModules.Submodule.unit_obj_eq_top_of_map I
      (openChartInclusion B S hS X.1 V A).op hV, ?_⟩
  rw [← hw]
  exact exists_pointsMap_openChart_eq B S hS X V A w hmemA

/-! ### The point set of a closed subspace -/

/-- A point of an étale chart whose image is off a closed subspace maps into the unit locus of
the defining ideal sheaf of that subspace. -/
theorem mem_idealUnitLocus_of_chart_point (Z : ClosedSubspaces B S hS X.1)
    (V : SmallEtale B S hS X.1)
    (w : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)))
    (hw : pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)) V.1.hom w ∉
      Set.range (pointsMap B S hS Z.1.toFunctor Z.1.ι)) :
    pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)) V.1.hom w ∈
      idealUnitLocus B S hS X (definingIdealSheaf B S hS X Z) := by
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom)) :=
    Z.2.2.property_snd V.1.hom
  have hpre : ∀ p : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)),
      pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)) V.1.hom p ∈
          Set.range (pointsMap B S hS Z.1.toFunctor Z.1.ι) ↔
      pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) p ∈
        Set.range ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom)).base := by
    intro p
    constructor
    · intro hp
      have hp' : p ∈ Set.range (pointsMap B S hS (yoneda.obj (Z.2.2.rep.pullback V.1.hom))
          (yoneda.map (Z.2.2.rep.snd V.1.hom))) := by
        rwa [← preimage_range_pointsMap_eq_range_pointsMap_snd B S hS Z.2.2.rep V.1.hom]
      obtain ⟨t, ht⟩ := hp'
      refine ⟨pointsToScheme B S hS (Z.2.2.rep.pullback V.1.hom) t, ?_⟩
      rw [← pointsToScheme_pointsMap_yoneda, ht]
      rfl
    · rintro ⟨t, ht⟩
      obtain ⟨t', ht'⟩ := surjective_pointsToScheme B S hS (Z.2.2.rep.pullback V.1.hom) t
      have hpt : pointsMap B S hS (yoneda.obj (Z.2.2.rep.pullback V.1.hom))
          (yoneda.map (Z.2.2.rep.snd V.1.hom)) t' = p := by
        refine injective_pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) ?_
        rw [pointsToScheme_pointsMap_yoneda, ht', ht]
      have hmem : p ∈ Set.range (pointsMap B S hS (yoneda.obj (Z.2.2.rep.pullback V.1.hom))
          (yoneda.map (Z.2.2.rep.snd V.1.hom))) := ⟨t', hpt⟩
      rwa [← preimage_range_pointsMap_eq_range_pointsMap_snd B S hS Z.2.2.rep V.1.hom] at hmem
  obtain ⟨A, hAdef⟩ : ∃ A : ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS X.1).obj V)).Opens,
      (A : Set ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS X.1).obj V))) =
        (Set.range ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom)).base)ᶜ :=
    ⟨⟨_, ((BigFppfOver.toScheme B S hS).map
      (Z.2.2.rep.snd V.1.hom)).isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  have hoff : ∀ c, A.ι.base c ∉
      Set.range ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom)).base := by
    intro c
    have hc : A.ι.base c ∈ (A : Set ((BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS X.1).obj V))) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨c, rfl⟩
    rwa [hAdef] at hc
  have hmemA : pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) w ∈ A := by
    rw [← SetLike.mem_coe, hAdef]
    exact fun hmem ↦ hw ((hpre w).2 hmem)
  refine ⟨openChart B S hS X.1 V A, ?_, ?_⟩
  · rw [definingIdealSheaf_obj B S hS X Z]
    refine definingIdealAt_eq_top_of_isEmpty B S hS X Z _
      (isEmpty_pullback_of_forall_notMem_range B S hS X Z _ fun p hp ↦ ?_)
    have hfac : (openChart B S hS X.1 V A).1.hom =
        yoneda.map ((SmallEtale.toOver B S hS X.1).map
          (openChartInclusion B S hS X.1 V A)) ≫ V.1.hom :=
      (CostructuredArrow.w (openChartInclusion B S hS X.1 V A).hom).symm
    rw [hfac, pointsMap_comp_apply] at hp
    have h2 := (hpre _).1 hp
    rw [pointsToScheme_pointsMap_yoneda,
      toScheme_map_toOver_map_openChartInclusion B S hS X.1 V A] at h2
    exact hoff _ h2
  · exact exists_pointsMap_openChart_eq B S hS X V A w hmemA

/-- A point off a closed subspace lies in the unit locus of its defining ideal sheaf. -/
theorem mem_idealUnitLocus_of_notMem_range_pointsMap_ι (Z : ClosedSubspaces B S hS X.1)
    {x : points B S hS X.1}
    (hx : x ∉ Set.range (pointsMap B S hS Z.1.toFunctor Z.1.ι)) :
    x ∈ idealUnitLocus B S hS X (definingIdealSheaf B S hS X Z) := by
  obtain ⟨W, b, -, hbe, w, hw⟩ := exists_affine_etale_chart_at_point B S hS X.1 X.2 x
  have hx' : pointsMap B S hS (yoneda.obj W) b w ∉
      Set.range (pointsMap B S hS Z.1.toFunctor Z.1.ι) := by rwa [hw]
  have key : pointsMap B S hS (yoneda.obj W) b w ∈
      idealUnitLocus B S hS X (definingIdealSheaf B S hS X Z) :=
    mem_idealUnitLocus_of_chart_point B S hS X Z ⟨CostructuredArrow.mk b, hbe⟩ w hx'
  rwa [hw] at key

/-- The point set of a closed subspace is the zero locus of its defining ideal sheaf. -/
theorem range_pointsMap_ι_eq_idealZeroLocus (Z : ClosedSubspaces B S hS X.1) :
    Set.range (pointsMap B S hS Z.1.toFunctor Z.1.ι) =
      idealZeroLocus B S hS X (definingIdealSheaf B S hS X Z) := by
  refine Set.eq_of_subset_of_subset (fun x hx hxu ↦ ?_) fun x hx ↦ ?_
  · obtain ⟨U, hUaff, hU, hxU⟩ :=
      exists_affine_chart_obj_eq_top_of_mem_idealUnitLocus B S hS X _ hxu
    exact notMem_range_pointsMap_ι_of_definingIdealSheaf_obj_eq_top B S hS X Z _ rfl U hUaff hU
      hxU hx
  · by_contra hxZ
    exact hx (mem_idealUnitLocus_of_notMem_range_pointsMap_ι B S hS X Z hxZ)

/-- The open complement of a closed subspace is the open subspace cut out by the unit locus of
its defining ideal sheaf. -/
theorem openComplement_eq_openSubspaceOfPoints_idealUnitLocus
    (Z : ClosedSubspaces B S hS X.1) :
    openComplement B S hS Z.1 =
      openSubspaceOfPoints B S hS X.1
        (idealUnitLocus B S hS X (definingIdealSheaf B S hS X Z)) := by
  rw [openComplement_eq_openSubspaceOfPoints_compl,
    range_pointsMap_ι_eq_idealZeroLocus B S hS X Z, idealZeroLocus, compl_compl]

/-- The image of a geometric point lies in the image of each of its small étale
neighbourhoods. -/
theorem image_mem_range_pointsMap_chart {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {x : GeometricPoint B S hS F} (U : SmallEtaleNeighborhood x) :
    x.image ∈ Set.range (pointsMap B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS F).obj U.chart)) U.chart.1.hom) := by
  refine ⟨FieldValuedPoint.class B S hS _
    { carrier := x.val.carrier, contained := x.val.contained, toBase := x.val.toBase,
      value := U.point }, ?_⟩
  rw [pointsMap_class]
  exact congrArg (fun v ↦ FieldValuedPoint.class B S hS F
    { carrier := x.val.carrier, contained := x.val.contained, toBase := x.val.toBase,
      value := v }) U.point_comp

/-! ### The Fitting generator locus -/

/-- A point lies in the unit locus of the `r`-th Fitting ideal sheaf exactly when `G` is
generated by `r` sections on an affine étale chart whose image contains it. -/
theorem mem_idealUnitLocus_fittingIdeal_iff (G : Modules.{u, u} B S hS X.1 X.2)
    (hG : IsCartesianOnAffineCharts G)
    (hfin : ∀ W : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS X.1 X.2 W) (G.val.obj (op W)))
    (r : ℕ) (x : points B S hS X.1) :
    x ∈ idealUnitLocus B S hS X (fittingIdeal B S hS X.1 X.2 G r) ↔
      ∃ (U : SmallEtale B S hS X.1) (s : Fin r → G.val.obj (op U)),
        IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) ∧
          Submodule.span (chartRing B S hS X.1 X.2 U) (Set.range s) = ⊤ ∧
          x ∈ Set.range (pointsMap B S hS
            (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.1.hom) := by
  classical
  refine ⟨fun hx ↦ ?_, ?_⟩
  · obtain ⟨U, hUaff, hU, hxU⟩ :=
      exists_affine_chart_obj_eq_top_of_mem_idealUnitLocus B S hS X _ hx
    obtain ⟨y, hy⟩ := hxU
    obtain ⟨p, hp⟩ := exists_geometricRepresentative B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) y
    have htop : fittingIdealGeometricStalk G r (geometricPointMap U.1.hom p) = ⊤ :=
      (fittingIdealGeometricStalk_eq_top_iff G r _).2
        ⟨{ chart := U, point := p.val.value, point_comp := rfl },
          (Ideal.eq_top_iff_one _).2 (hU.ge Submodule.mem_top)⟩
    obtain ⟨N, hNaff, s, hs⟩ :=
      (exists_fin_span_iff_fittingIdealGeometricStalk_eq_top G hG hfin r _).2 htop
    refine ⟨N.chart, s, hNaff, hs, ?_⟩
    have himg : (geometricPointMap U.1.hom p).image = x := by
      have h1 : (geometricPointMap U.1.hom p).image =
          pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.1.hom
            p.image := rfl
      rw [h1, hp, hy]
    rw [← himg]
    exact image_mem_range_pointsMap_chart B S hS N
  · rintro ⟨U, s, hUaff, hs, hxU⟩
    exact ⟨U, fittingIdeal_obj_eq_top_of_span_eq_top G U hUaff s hs, hxU⟩

/-- The open complement of the Fitting closed subspace `Z_r` is the open subspace cut out by the
locus of points near which `G` is generated by `r` sections. -/
theorem openComplement_fittingClosedSubspace_eq (G : Modules.{u, u} B S hS X.1 X.2)
    (hG : IsCartesianOnAffineCharts G)
    (hfin : ∀ W : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS X.1 X.2 W) (G.val.obj (op W)))
    (Z : ℕ → ClosedSubspaces B S hS X.1)
    (hZ : ∀ r, definingIdealSheaf B S hS X (Z r) = fittingIdeal B S hS X.1 X.2 G r) (r : ℕ) :
    openComplement B S hS (Z r).1 =
      openSubspaceOfPoints B S hS X.1
        {x | ∃ (U : SmallEtale B S hS X.1) (s : Fin r → G.val.obj (op U)),
          IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) ∧
            Submodule.span (chartRing B S hS X.1 X.2 U) (Set.range s) = ⊤ ∧
            x ∈ Set.range (pointsMap B S hS
              (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.1.hom)} := by
  rw [openComplement_eq_openSubspaceOfPoints_idealUnitLocus B S hS X (Z r), hZ r]
  congr 1
  ext x
  exact mem_idealUnitLocus_fittingIdeal_iff B S hS X G hG hfin r x

end AlgebraicGeometry.Space

end
