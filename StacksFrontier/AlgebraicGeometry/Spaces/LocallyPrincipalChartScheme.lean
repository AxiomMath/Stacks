-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

universe u

namespace AlgebraicGeometry

/-- The ideal of global sections of the ideal sheaf attached to an ideal of global sections of an
affine scheme is that ideal. -/
theorem ideal_top_ofIdealTop {Y : Scheme.{u}} [IsAffine Y] (K : Ideal Γ(Y, ⊤)) :
    (Scheme.IdealSheafData.ofIdealTop K).ideal ⟨⊤, isAffineOpen_top Y⟩ = K := by
  simp

end AlgebraicGeometry

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (X : AlgebraicSpaces B S hS) (Z : ClosedSubspaces B S hS X.1)

/-- **Every point of an affine étale chart has an affine étale chart over it on which the
defining ideal of `Z` is principal.**  The covering sieve which Stacks 083B(1) provides at the
chart is jointly surjective on its scheme points; a member through which the point lifts is
shrunk to an affine open, which is again a chart and still carries a singleton family of
generating sections; and on an affine chart such a family generates the defining ideal on the
nose. -/
theorem exists_affine_chart_definingIdealAt_eq_span (hZ : IsLocallyPrincipal B S hS X Z)
    (T : SmallEtale B S hS X.1) (x : (BigFppfOver.toScheme B S hS).obj T.1.left) :
    ∃ (W : SmallEtale B S hS X.1) (m : W ⟶ T),
      IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) ∧
      ∃ y : (BigFppfOver.toScheme B S hS).obj W.1.left,
        ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map m)) y = x ∧
        ∃ a, definingIdealAt B S hS X Z (op W) = Ideal.span {a} := by
  obtain ⟨SU, hSU⟩ := hZ T
  obtain ⟨W₁, m₁, hm₁, x₁, hx₁⟩ := exists_mem_sieve_scheme_point B S hS X.1 T SU.2 x
  obtain ⟨W, ι, hWaff, y, hy⟩ := exists_affine_chart_at B S hS X.1 W₁ x₁
  obtain ⟨σ, ⟨e⟩⟩ := hSU W₁ m₁ hm₁
  obtain ⟨a, -, ha⟩ :=
    exists_eq_span_definingIdealAt_of_generatingSections B S hS X Z W hWaff
      (Stacks.SheafOfModules.generatingSectionsOverMap _ ι σ) e
  refine ⟨W, ι ≫ m₁, hWaff, y, ?_, a, ha⟩
  rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hy, hx₁]

/-- **Stacks 083B(1) implies local principality on every affine étale chart.**  If the defining
ideal sheaf of a closed subspace `Z` of an algebraic space `X` is generated by one section
locally on the small étale site of `X`, then the closed subscheme which `Z` cuts out on an
affine étale scheme chart of `X` is locally principal in the sense of Stacks 01WR. -/
theorem isLocallyPrincipal_ker_rep_snd_of_isLocallyPrincipal
    (hZ : IsLocallyPrincipal B S hS X Z) (V : BigFppfOver B S hS)
    (g : yoneda.obj V ⟶ X.1) (hg : IsEtale B S hS g)
    (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V)) :
    Stacks.Divisors.IsLocallyPrincipal
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd g)).ker := by
  classical
  have _ := hV
  let T : SmallEtale B S hS X.1 :=
    ⟨CostructuredArrow.mk g, presheaf_etale_of_isEtale B S hS hg⟩
  let J := ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd g)).ker
  let Mod := J.unitSubmodule.toSheafOfModules
  choose W m hWaff y hy a ha using
    exists_affine_chart_definingIdealAt_eq_span B S hS X Z hZ T
  -- the chart morphisms on the underlying schemes
  let q : ∀ x : (BigFppfOver.toScheme B S hS).obj V,
      (BigFppfOver.toScheme B S hS).obj (W x).1.left ⟶
        (BigFppfOver.toScheme B S hS).obj V :=
    fun x => (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map (m x))
  have hEt : ∀ x, Etale (q x) := fun x => etale_toScheme_toOver_map B S hS X.1 (m x)
  -- the inverse-image ideal sheaf on a chart is cut out by a principal ideal
  have hspan : ∀ x, (J.comap (q x)).ideal
      ⟨⊤, isAffineOpen_top ((BigFppfOver.toScheme B S hS).obj (W x).1.left)⟩ =
      Ideal.span {a x} := by
    intro x
    have _ := hWaff x
    have hw : yoneda.map ((SmallEtale.toOver B S hS X.1).map (m x)) ≫ g = (W x).1.hom :=
      CostructuredArrow.w (m x).hom
    have hker : J.comap (q x) =
        Scheme.IdealSheafData.ofIdealTop (definingIdealAt B S hS X Z (op (W x))) := by
      rw [show J = ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd g)).ker from rfl,
        ← schemeKer_snd_comp B S hS Z g ((SmallEtale.toOver B S hS X.1).map (m x)), hw]
      exact ker_rep_snd_eq_ofIdealTop_definingIdealAt B S hS X Z (W x)
    rw [hker, ← ha x]
    exact ideal_top_ofIdealTop _
  -- generation by one section on the charts
  have hgen : ∀ (x : (BigFppfOver.toScheme B S hS).obj V)
      (w : (BigFppfOver.toScheme B S hS).obj (W x).1.left),
      IsGeneratedByNear ((Scheme.Modules.pullback (q x)).obj Mod) 1 w := by
    intro x w
    have _ := hWaff x
    have _ : Etale (q x) := hEt x
    have _ : Flat (q x) := inferInstance
    exact AlgebraicGeometry.isGeneratedByNear_of_iso
      (Stacks.ClosedSubscheme.pullbackIdealFlatIso (q x) J) 1 w
      (Stacks.Divisors.isGeneratedByNear_unitSubmodule_of_ideal_top_eq_span
        (J.comap (q x)) (hspan x) w)
  have hqc : Mod.IsQuasicoherent :=
    AlgebraicGeometry.Scheme.IdealSheafData.unitSubmodule_isQuasicoherent J
  have _ : Mod.IsQuasicoherent := hqc
  -- the charts form an fpqc covering family of the chart scheme
  have hetale : Presieve.ofArrows
      (fun x : (BigFppfOver.toScheme B S hS).obj V =>
        (BigFppfOver.toScheme B S hS).obj (W x).1.left) q ∈
      Scheme.etalePrecoverage ((BigFppfOver.toScheme B S hS).obj V) :=
    (Scheme.ofArrows_mem_precoverage_iff (P := @Etale)).2 ⟨fun x => ⟨x, y x, hy x⟩, hEt⟩
  have hfpqc := Scheme.fppfPrecoverage_le_fpqcPrecoverage _
    (Scheme.etalePrecoverage_le_fppfPrecoverage _ hetale)
  have _ : Mod.IsFiniteType :=
    isFiniteType_of_pullback_fpqc Mod hqc _ q hfpqc fun x =>
      Stacks.StrictTransformFittingRank.isFiniteType_of_isGeneratedByNear _ 1 (hgen x)
  refine Stacks.Divisors.isLocallyPrincipal_of_forall_isGeneratedByNear J fun x => ?_
  have hnear := AlgebraicGeometry.isGeneratedByNear_of_pullback (q x) Mod 1 (y x)
    (hgen x (y x))
  rwa [hy x] at hnear

end AlgebraicGeometry.Space

end
