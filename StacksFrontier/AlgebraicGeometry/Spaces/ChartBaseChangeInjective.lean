* [Stacks Project, Tag 080W](https://stacks.math.columbia.edu/tag/080W)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Over a diagram of affine charts, injectivity of the base change of a map of modules on
sections gives injectivity of the extension of scalars of its sections**, for a source module
carrying a presentation which is right exact on the sections over the chart of the target.

The comparison is natural in the module, so the extension of scalars of `u(e.V)` followed by the
comparison at `M'` is the comparison at `M` followed by the map on sections of `g^*u` over `e.U`.
The latter is injective by hypothesis and the comparison at `M` is injective by
`AlgebraicGeometry.Space.bijective_modulePullbackChartBaseChange`, so the composite is injective
and hence so is the extension of scalars.  Nothing is assumed of `M'`: only the comparison at the
source module enters. -/
theorem injective_lTensor_of_injective_val_app
    {X' Y' : AlgebraicSpaces B S hS} (g : X' ⟶ Y')
    {M M' : Modules.{u, u} B S hS Y'.1 Y'.2}
    (hM : M.IsQuasicoherentOnSite) (P : M.Presentation) (u : M ⟶ M')
    (e : ChartDiagram B S hS X'.1 Y'.1 g.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X'.1 ⋙ BigFppfOver.toScheme B S hS).obj e.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y'.1 ⋙ BigFppfOver.toScheme B S hS).obj e.V))
    (hgen : Function.Surjective (P.generators.π.val.app (op e.V)))
    (hex : Function.Exact ((P.relations.π ≫ kernel.ι P.generators.π).val.app (op e.V))
      (P.generators.π.val.app (op e.V)))
    (hinj : Function.Injective (((modulePullback B S hS g).map u).val.app (op e.U))) :
    letI := chartDiagramAlgebra B S hS g e
    Function.Injective (LinearMap.lTensor (chartRing B S hS X'.1 X'.2 e.U)
      (u.val.app (op e.V)).hom) := by
  let _ := chartDiagramAlgebra B S hS g e
  have key := modulePullbackChartBaseChange_map B S hS g u e
  intro z₁ z₂ h
  refine (bijective_modulePullbackChartBaseChange B S hS g M hM P e hU hV hgen hex).1 (hinj ?_)
  rw [key z₁, key z₂, h]

/-- Two functors of modules related by a natural isomorphism have the same injectivity on the
sections of the image of a morphism over a chart: the two images are conjugate by the components
of the isomorphism, which are bijective on sections over every chart. -/
private theorem injective_val_app_iff_of_natIso {Z W : AlgebraicSpaces B S hS}
    {Phi Psi : Modules.{u, u} B S hS Z.1 Z.2 ⥤ Modules.{u, u} B S hS W.1 W.2} (α : Phi ≅ Psi)
    {M M' : Modules.{u, u} B S hS Z.1 Z.2} (u : M ⟶ M') (V : SmallEtale B S hS W.1) :
    Function.Injective ((Phi.map u).val.app (op V)) ↔
      Function.Injective ((Psi.map u).val.app (op V)) := by
  have hM := SheafOfModules.bijective_iso_hom_val_app (α.app M) (op V)
  have hM' := SheafOfModules.bijective_iso_hom_val_app (α.app M') (op V)
  have hpt : ∀ x, (α.app M').hom.val.app (op V) ((Phi.map u).val.app (op V) x) =
      (Psi.map u).val.app (op V) ((α.app M).hom.val.app (op V) x) := fun x ↦
    congrArg (fun m : Phi.obj M ⟶ Psi.obj M' ↦ m.val.app (op V) x) (α.hom.naturality u)
  refine ⟨fun h a b hab ↦ ?_, fun h x y hxy ↦ hM.1 (h ?_)⟩
  · obtain ⟨x, rfl⟩ := hM.2 a
    obtain ⟨y, rfl⟩ := hM.2 b
    have hxy : x = y := h (hM'.1 (by rwa [hpt x, hpt y]))
    rw [hxy]
  · rw [← hpt x, ← hpt y, hxy]

variable {X Y : AlgebraicSpaces B S hS}

/-- **The base change along the morphism of chart spaces is injective on the sections over the
identity chart exactly when the base change along `f` is injective on the sections over `d.U`.**
This is the injectivity counterpart of
`AlgebraicGeometry.Space.val_app_eq_zero_iff_chartSpace`: the identification of the two modules
is `AlgebraicGeometry.Space.etaleChartSpaceBaseChangeNatIso`, and the identification of the
sections over the identity chart of a chart space with the sections over the chart is
definitional. -/
theorem injective_val_app_iff_chartSpace (f : X ⟶ Y)
    {F G : Modules.{u, u} B S hS Y.1 Y.2} (u : F ⟶ G)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom) :
    Function.Injective (((modulePullback B S hS (chartSpaceMapOver B S hS d.g)).map
          ((etaleModulePullback B S hS (chartToSpace B S hS Y d.V)
            (isEtale_chartToSpace B S hS Y d.V)).map u)).val.app
          (op (chartSpaceIdChartDiagram B S hS f d).U)) ↔
      Function.Injective (((modulePullback B S hS f).map u).val.app (op d.U)) :=
  injective_val_app_iff_of_natIso B S hS (etaleChartSpaceBaseChangeNatIso B S hS f d) u
    (chartSpaceIdChartDiagram B S hS f d).U

/-- **Over a diagram of affine étale charts, injectivity of the base change of a map of
quasi-coherent modules on the sections over the chart of `X` gives injectivity of an extension of
scalars of its sections over the chart of `Y`.**

No presentation is assumed: the restriction of `F` to the chart space of `d.V` carries a
presentation which is right exact on the sections over its identity chart, so
`AlgebraicGeometry.Space.injective_lTensor_of_injective_val_app` applies to the morphism of chart
spaces, and `AlgebraicGeometry.Space.injective_val_app_iff_chartSpace` carries the hypothesis
over from `f` and `d`.

The extension of scalars on the right is the one attached to the chart-space diagram of identity
charts.  It is definitionally the extension of scalars `𝒪_X(d.U) ⊗_{𝒪_Y(d.V)} u(d.V)`, but that
conversion exceeds the heartbeat limit; see the implementation notes of this file, and
`AlgebraicGeometry.Space.exists_eq_smul_of_injective_of_ker_eq_span` for the consequence stated
with no tensor product in it. -/
theorem injective_lTensor_val_app_of_injective (f : X ⟶ Y)
    {F G : Modules.{u, u} B S hS Y.1 Y.2} (hF : F.IsQuasicoherentOnSite)
    (_hG : G.IsQuasicoherentOnSite) (u : F ⟶ G)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V))
    (hinj : Function.Injective (((modulePullback B S hS f).map u).val.app (op d.U))) :
    letI := chartDiagramAlgebra B S hS (chartSpaceMapOver B S hS d.g)
      (chartSpaceIdChartDiagram B S hS f d)
    Function.Injective (LinearMap.lTensor
      (chartRing B S hS (chartSpace B S hS X d.U).1 (chartSpace B S hS X d.U).2
        (chartSpaceIdChartDiagram B S hS f d).U)
      (((etaleModulePullback B S hS (chartToSpace B S hS Y d.V)
          (isEtale_chartToSpace B S hS Y d.V)).map u).val.app
        (op (chartSpaceIdChartDiagram B S hS f d).V)).hom) := by
  obtain ⟨P, hgenF, -, hexF⟩ :=
    exists_presentation_rightExact_app_idEtaleChart B S hS Y F hF d.V hV
  exact injective_lTensor_of_injective_val_app B S hS (chartSpaceMapOver B S hS d.g)
    (isQuasicoherentOnSite_etaleModulePullback B S hS (chartToSpace B S hS Y d.V)
      (isEtale_chartToSpace B S hS Y d.V) F hF)
    P ((etaleModulePullback B S hS (chartToSpace B S hS Y d.V)
      (isEtale_chartToSpace B S hS Y d.V)).map u)
    (chartSpaceIdChartDiagram B S hS f d) hU hV hgenF hexF
    ((injective_val_app_iff_chartSpace B S hS f u d).2 hinj)

/-- **Divisibility of sections descends along an injective base change.**  Let `d` be a diagram
of affine étale charts over `f` along which the pullback of regular functions
`𝒪_Y(d.V) → 𝒪_X(d.U)` is surjective with kernel the ideal generated by `c`, let `u : F ⟶ G` be a
map of quasi-coherent modules whose base change is injective on the sections over `d.U`, and let
`x` be a section of `F` over `d.V` whose image under `u` is `c` times a section of `G`.  Then `x`
is itself `c` times a section of `F`.

This is `Stacks.SupportedSectionsLift.divisibility_of_injective_lTensor` fed with
`AlgebraicGeometry.Space.injective_lTensor_val_app_of_injective`.  Both are read in the
chart-space spelling, in which the extension of scalars is available; since the statement here
mentions no tensor product, only plain module and ring structures have to be identified with
their spellings at `f` and `d`, and each of those identifications is definitional and cheap. -/
theorem exists_eq_smul_of_injective_of_ker_eq_span (f : X ⟶ Y)
    {F G : Modules.{u, u} B S hS Y.1 Y.2} (hF : F.IsQuasicoherentOnSite)
    (hG : G.IsQuasicoherentOnSite) (u : F ⟶ G)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V))
    (hinj : Function.Injective (((modulePullback B S hS f).map u).val.app (op d.U)))
    (hsurj : Function.Surjective (chartDiagramRestrict B S hS f d))
    (c : chartRing B S hS Y.1 Y.2 d.V)
    (hker : RingHom.ker (chartDiagramRestrict B S hS f d) = Ideal.span {c})
    (x : F.val.obj (op d.V)) (y : G.val.obj (op d.V))
    (hxy : u.val.app (op d.V) x = c • y) :
    ∃ z : F.val.obj (op d.V), x = c • z := by
  let := chartDiagramAlgebra B S hS (chartSpaceMapOver B S hS d.g)
    (chartSpaceIdChartDiagram B S hS f d)
  exact Stacks.SupportedSectionsLift.divisibility_of_injective_lTensor
    (R := chartRing B S hS (chartSpace B S hS Y d.V).1 (chartSpace B S hS Y d.V).2
      (chartSpaceIdChartDiagram B S hS f d).V)
    (R' := chartRing B S hS (chartSpace B S hS X d.U).1 (chartSpace B S hS X d.U).2
      (chartSpaceIdChartDiagram B S hS f d).U)
    hsurj
    (((etaleModulePullback B S hS (chartToSpace B S hS Y d.V)
        (isEtale_chartToSpace B S hS Y d.V)).map u).val.app
      (op (chartSpaceIdChartDiagram B S hS f d).V)).hom
    (injective_lTensor_val_app_of_injective B S hS f hF hG u d hU hV hinj) c hker x y hxy

end AlgebraicGeometry.Space

end
