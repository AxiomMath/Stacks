module

public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.FlatSource
public import StacksFrontier.AlgebraicGeometry.Spaces.CohenMacaulay.EtaleCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.Morphisms.FlatEtaleLocalRing
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Flat morphisms of algebraic spaces with Cohen–Macaulay source

A flat morphism `f : X ⟶ Y` of locally Noetherian algebraic spaces over a scheme `S` whose
source is Cohen–Macaulay is a Cohen–Macaulay morphism, and the étale local ring of `Y` at the
image of any geometric point of `X` is Cohen–Macaulay.

## Main results

* `AlgebraicGeometry.Space.isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian`: the étale
  local ring of a locally Noetherian algebraic space is Noetherian.
* `AlgebraicGeometry.Space.isCohenMacaulayLocalRing_etaleLocalRing`: the étale local ring of a
  Cohen–Macaulay algebraic space is Cohen–Macaulay.
* `AlgebraicGeometry.Space.flat_etaleLocalRingMap`: the canonical homomorphism of étale local
  rings of a flat morphism is flat.
* `AlgebraicGeometry.Space.isLocalHom_etaleLocalRingMap`: the canonical homomorphism of étale
  local rings is a local homomorphism.
* `AlgebraicGeometry.Space.isCohenMacaulay_of_isCohenMacaulay_source`: **Stacks 0E0Y**, the
  morphism is Cohen–Macaulay.
* `AlgebraicGeometry.Space.isCohenMacaulayLocalRing_etaleLocalRing_target`: **Stacks 0E0Y**, the
  étale local rings of the target at image points are Cohen–Macaulay.

## Implementation notes

Both halves of Tag 0E0Y are read off a commuting square of étale scheme charts and reduced to
the corresponding statement for morphisms of schemes, Tag 0C0X.

For the morphism this is the chart criterion of Tag 0E0W: over an étale scheme chart
`g : h_V ⟶ Y` of the target there is a surjective étale scheme chart `a` of the base change,
presented by a morphism `h : U ⟶ V` of the site, and the fibre conditions on `f` over the
residue-field points of `V` are the corresponding conditions on the scheme-theoretic fibres of
`h` by `AlgebraicGeometry.Space.hasEtaleLocalProperty_fiberAt_iff`. The source chart
`a ≫ pullback.fst f g` of `X` is étale, so `U` is a locally Noetherian Cohen–Macaulay scheme
by Tag 03E8, and `h` is flat because `f` is; hence the fibres of `h` are locally Noetherian and
Cohen–Macaulay by Tag 0C0X together with Tag 045S.

For the target local ring the square is a *pointed* one: a surjective étale atlas of `Y` is
lifted to a surjective étale atlas of `X` over it (Tag 02X1) and the geometric point is lifted
to the latter (Tag 05VN), which gives small étale neighbourhoods of the point and of its image
together with a morphism of charts over `f`. The étale local rings are the strict
henselizations of the ordinary local rings of the two chart schemes at the selected points
(Tag 04KF), Cohen–Macaulayness of a Noetherian local ring is insensitive to strict
henselization (Tag 06LM), and the local ring of the target chart at the selected point is
Cohen–Macaulay by Tag 0C0X.

Localness of the canonical homomorphism of étale local rings of Tag 04NG is read off the same
pointed square after the target chart is cut down to an affine open through which the lift of
the image point factors: the germs of global sections of an affine chart generate its local
ring, so the compatibility of the homomorphism with germs identifies it with the map on strict
henselizations induced by the stalk map of the chart morphism, and the maximal ideal of a
strict henselization is generated by the maximal ideal of its base.

The locally Noetherian hypotheses are the étale-local property of Tag 03E6 for local
Noetherianity of schemes, which is weaker than Noetherianity of the algebraic space; this is
why `isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian` is stated here rather than used
from `AlgebraicGeometry.Space.isNoetherianRing_etaleLocalRing`.

## References

* [Stacks Project, Tag 0E0Y](https://stacks.math.columbia.edu/tag/0E0Y)
* [Stacks Project, Tag 0C0X](https://stacks.math.columbia.edu/tag/0C0X)
* [Stacks Project, Tag 0E0W](https://stacks.math.columbia.edu/tag/0E0W)
* [Stacks Project, Tag 04KF](https://stacks.math.columbia.edu/tag/04KF)
* [Stacks Project, Tag 06LM](https://stacks.math.columbia.edu/tag/06LM)
* [Stacks Project, Tag 04NG](https://stacks.math.columbia.edu/tag/04NG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Pullbacks of presheaves on `BigFppfOver B S hS`, given directly: instance search for them
times out under Lean v4.35.0. -/
local instance (priority := high) hasPullbacks_presheaf_CohenMacaulaySource :
    HasPullbacks ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) :=
  Limits.functorCategoryHasLimitsOfShape

local instance (priority := high) hasPullback_presheaf_CohenMacaulaySource
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  (hasPullbacks_presheaf_CohenMacaulaySource B S hS).has_limit _

/-! ### Noetherian and Cohen–Macaulay étale local rings -/

/-- The étale local ring of a locally Noetherian algebraic space at a geometric point is a
Noetherian ring.

This is the statement for the étale-local property of Tag 03E6 attached to local Noetherianity
of schemes; `AlgebraicGeometry.Space.isNoetherianRing_etaleLocalRing` carries Tag 08AH and is
the statement for a Noetherian algebraic space. -/
theorem isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)
    (hN : HasEtaleLocalProperty B S hS F (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (x : GeometricPoint B S hS F) :
    IsNoetherianRing (etaleLocalRing B S hS F x) := by
  obtain ⟨V⟩ := nonempty_smallEtaleNeighborhood hF x
  have hVnoeth : IsLocallyNoetherian (chartScheme V.chart) :=
    (exists_atlas_iff_forall_etale B S hS F
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hF).mp hN
      V.chart.obj.left V.chart.obj.hom V.chart.property
  let R := (chartScheme V.chart).presheaf.stalk
    ((chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField))
  let T := henselizationTower R
    (separableClosure (ResidueField R) (chartGeometricPoint V).residueField)
  have : IsNoetherianRing T.strictHenselization :=
    (isNoetherianRing_iff_henselizations R T.henselization T.strictHenselization
      (separableClosure (ResidueField R) (chartGeometricPoint V).residueField)).2.mp inferInstance
  exact isNoetherianRing_of_ringEquiv T.strictHenselization
    (strictHenselizationEquivEtaleLocalRing hF V (bigEtaleSiteOfFppfSite B)
      V.chart.obj.left.left.property T)

/-- Cohen–Macaulayness of a Noetherian local ring passes to the strict henselization in a
henselization tower, Stacks 06LM. -/
@[ega "IV 18.8.13" "(a)"]
private theorem isCohenMacaulayLocalRing_strictHenselization {R : Type u} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] {K : Type u} [Field K] [Algebra (ResidueField R) K]
    [IsSepClosure (ResidueField R) K] (T : HenselizationTower R K)
    (hT : IsNoetherianRing T.strictHenselization) (hR : IsCohenMacaulayLocalRing R) :
    IsCohenMacaulayLocalRing T.strictHenselization :=
  (isCohenMacaulayLocalRing_iff_isMaximalCohenMacaulay T.strictHenselization).mpr
    ((isMaximalCohenMacaulay_iff_henselizations R T.henselization T.strictHenselization K).2.mp
      ((isCohenMacaulayLocalRing_iff_isMaximalCohenMacaulay R).mp hR))

/-- The étale local ring of a locally Noetherian Cohen–Macaulay algebraic space at a geometric
point is a Cohen–Macaulay local ring. -/
theorem isCohenMacaulayLocalRing_etaleLocalRing
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)
    (hN : HasEtaleLocalProperty B S hS F (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hCM : HasEtaleLocalProperty B S hS F
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T))
    (x : GeometricPoint B S hS F) :
    letI : IsLocalRing (etaleLocalRing B S hS F x) := isLocalRing_etaleLocalRing B S hS F hF x
    letI : IsNoetherianRing (etaleLocalRing B S hS F x) :=
      isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian B S hS F hF hN x
    IsCohenMacaulayLocalRing (etaleLocalRing B S hS F x) := by
  have : IsLocalRing (etaleLocalRing B S hS F x) := isLocalRing_etaleLocalRing B S hS F hF x
  have : IsNoetherianRing (etaleLocalRing B S hS F x) :=
    isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian B S hS F hF hN x
  obtain ⟨V⟩ := nonempty_smallEtaleNeighborhood hF x
  have hVnoeth : IsLocallyNoetherian (chartScheme V.chart) :=
    (exists_atlas_iff_forall_etale B S hS F
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hF).mp hN
      V.chart.obj.left V.chart.obj.hom V.chart.property
  have hVcm : _root_.AlgebraicGeometry.IsCohenMacaulay (chartScheme V.chart) :=
    (exists_atlas_iff_forall_etale B S hS F
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T) hF).mp hCM
      V.chart.obj.left V.chart.obj.hom V.chart.property
  let R := (chartScheme V.chart).presheaf.stalk
    ((chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField))
  have hRcm : IsCohenMacaulayLocalRing R :=
    isCohenMacaulayLocalRing_stalk (chartScheme V.chart) hVcm _
  let T := henselizationTower R
    (separableClosure (ResidueField R) (chartGeometricPoint V).residueField)
  have hT : IsNoetherianRing T.strictHenselization :=
    (isNoetherianRing_iff_henselizations R T.henselization T.strictHenselization
      (separableClosure (ResidueField R) (chartGeometricPoint V).residueField)).2.mp inferInstance
  exact (isCohenMacaulayLocalRing_iff_of_ringEquiv
    (strictHenselizationEquivEtaleLocalRing hF V (bigEtaleSiteOfFppfSite B)
      V.chart.obj.left.left.property T)).mp
    (isCohenMacaulayLocalRing_strictHenselization T hT hRcm)

/-- The canonical homomorphism of étale local rings induced by a flat morphism of algebraic
spaces at a geometric point of its source is flat. -/
theorem flat_etaleLocalRingMap {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : IsAlgebraicSpace B S hS F) (hG : IsAlgebraicSpace B S hS G) (f : F ⟶ G)
    (hf : IsFlat B S hS f) (x : GeometricPoint B S hS F) :
    (etaleLocalRingMap hF f x).Flat :=
  (isFlatAt_iff_etaleLocalRingMap_flat hF hG f x).mp
    ((isFlat_iff_forall_isFlatAt B S hS f).mp hf x.image)

/-! ### The morphism -/

variable {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- A morphism of algebraic spaces whose source is locally Noetherian has locally Noetherian
fibres, in the every-chart reading of Tag 0E0W. -/
theorem hasLocallyNoetherianFibers_of_source (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (hNX : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T)) :
    HasLocallyNoetherianFibers B S hS f := by
  intro V g hg v hv
  obtain ⟨U, a, h, comm, haSurjective, haEtale⟩ :=
    exists_surjective_etale_atlas_over_chart B S hS hX hY f V g
  have hgEtale := (isEtale_iff_presheaf_of_yoneda B S hS g).mp hg
  have hpEtale := chartSource_property B S hS (@Etale.{u})
    Etale.etale_isStableUnderBaseChange.{u} etale_isStableUnderComposition.{u} f V g hgEtale
    U a haEtale
  have hUnoeth : IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj U) :=
    (exists_atlas_iff_forall_etale B S hS X
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hX).mp hNX U
      (a ≫ pullback.fst f g) hpEtale
  exact (hasEtaleLocalProperty_fiberAt_iff B S hS hX hY f V g U a h comm haSurjective haEtale
    (fun T : Scheme.{u} => IsLocallyNoetherian T) v hv).mpr
    (isLocallyNoetherian_fiber ((BigFppfOver.toScheme B S hS).map h) v)

/-- **Stacks 0E0Y.** A flat morphism of locally Noetherian algebraic spaces over `S` whose
source is a Cohen–Macaulay algebraic space is a Cohen–Macaulay morphism. -/
@[stacks 0E0Y "the morphism is Cohen-Macaulay"]
theorem isCohenMacaulay_of_isCohenMacaulay_source (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y)
    (hNX : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hNY : HasEtaleLocalProperty B S hS Y (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hCM : HasEtaleLocalProperty B S hS X
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T))
    (f : X ⟶ Y) (hf : IsFlat B S hS f) :
    IsCohenMacaulay B S hS f := by
  have key := (isCohenMacaulay_tfae_etaleCharts B S hS hX hY f
    (hasLocallyNoetherianFibers_of_source B S hS hX hY f hNX)).out 3 1
  refine key.mp ⟨hf, fun V g hg v hv ↦ ?_⟩
  obtain ⟨U, a, h, comm, haSurjective, haEtale⟩ :=
    exists_surjective_etale_atlas_over_chart B S hS hX hY f V g
  have hgEtale := (isEtale_iff_presheaf_of_yoneda B S hS g).mp hg
  have hpEtale := chartSource_property B S hS (@Etale.{u})
    Etale.etale_isStableUnderBaseChange.{u} etale_isStableUnderComposition.{u} f V g hgEtale
    U a haEtale
  have hUnoeth : IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj U) :=
    (exists_atlas_iff_forall_etale B S hS X
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hX).mp hNX U
      (a ≫ pullback.fst f g) hpEtale
  have hVnoeth : IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V) :=
    (exists_atlas_iff_forall_etale B S hS Y
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hY).mp hNY V g hgEtale
  have hUcm : _root_.AlgebraicGeometry.IsCohenMacaulay
      ((BigFppfOver.toScheme B S hS).obj U) :=
    (exists_atlas_iff_forall_etale B S hS X
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T) hX).mp hCM U
      (a ≫ pullback.fst f g) hpEtale
  have hpcomm : (a ≫ pullback.fst f g) ≫ f = yoneda.map h ≫ g := by
    rw [Category.assoc, pullback.condition, ← Category.assoc, comm]
  have hflat : Flat ((BigFppfOver.toScheme B S hS).map h) :=
    hf U V (a ≫ pullback.fst f g) g h hpEtale hgEtale hpcomm.symm
  have hfibSch : ∀ w : (BigFppfOver.toScheme B S hS).obj V,
      IsLocallyNoetherian (((BigFppfOver.toScheme B S hS).map h).fiber w) :=
    fun _ ↦ isLocallyNoetherian_fiber _ _
  exact (hasEtaleLocalProperty_fiberAt_iff B S hS hX hY f V g U a h comm haSurjective haEtale
    (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T) v hv).mpr
    (((_root_.AlgebraicGeometry.isCohenMacaulay_iff_flat_and_fibers
      ((BigFppfOver.toScheme B S hS).map h) hfibSch).mp
      (_root_.AlgebraicGeometry.isCohenMacaulay_of_isCohenMacaulay_source
        ((BigFppfOver.toScheme B S hS).map h) hUcm)).2 v)

/-! ### Localness of the canonical homomorphism of étale local rings -/

/-- The map on strict henselizations induced by a local homomorphism of local rings compatible
with the chosen henselization towers is local: the maximal ideal of a strict henselization is
generated by the maximal ideal of its base. -/
private theorem isLocalHom_of_henselizationTower_square {R A : Type u} [CommRing R]
    [IsLocalRing R] [CommRing A] [IsLocalRing A] {K L : Type u} [Field K]
    [Algebra (ResidueField R) K] [IsSepClosure (ResidueField R) K] [Field L]
    [Algebra (ResidueField A) L] [IsSepClosure (ResidueField A) L]
    (T : HenselizationTower R K) (N : HenselizationTower A L) (s : R →+* A) [IsLocalHom s]
    (ψ : T.strictHenselization →+* N.strictHenselization)
    (hψ : ψ.comp (algebraMap R T.strictHenselization) =
      (algebraMap A N.strictHenselization).comp s) :
    IsLocalHom ψ := by
  apply ((IsLocalRing.local_hom_TFAE ψ).out 3 1).mp
  calc (maximalIdeal T.strictHenselization).map ψ
      = ((maximalIdeal R).map (algebraMap R T.strictHenselization)).map ψ := by
        rw [IsHenselization.map_maximalIdeal (R := R) (L := K) (Rh := T.strictHenselization)]
    _ = (maximalIdeal R).map ((algebraMap A N.strictHenselization).comp s) := by
        rw [Ideal.map_map, hψ]
    _ = ((maximalIdeal R).map s).map (algebraMap A N.strictHenselization) := by
        rw [Ideal.map_map]
    _ ≤ (maximalIdeal A).map (algebraMap A N.strictHenselization) :=
        Ideal.map_mono (map_maximalIdeal_le s)
    _ = maximalIdeal N.strictHenselization :=
        IsHenselization.map_maximalIdeal (R := A) (L := L) (Rh := N.strictHenselization)

/-- A ring equivalence is a local homomorphism. -/
theorem isLocalHom_ringEquiv {A₁ A₂ : Type*} [CommRing A₁] [CommRing A₂]
    (e : A₁ ≃+* A₂) : IsLocalHom e.toRingHom :=
  ⟨fun a h ↦ by simpa using h.map e.symm.toRingHom⟩

/-- A homomorphism between strict henselizations of the local rings of a morphism of schemes at
a point and its image which agrees with the stalk map on germs of global sections of an affine
target is local. -/
private theorem isLocalHom_of_strictHenselization_germs {Z W : Scheme.{u}} [IsAffine W]
    (q : Z ⟶ W) (z : Z) (w : W) (hzw : q z = w) {K L : Type u} [Field K]
    [Algebra (ResidueField (W.presheaf.stalk w)) K]
    [IsSepClosure (ResidueField (W.presheaf.stalk w)) K] [Field L]
    [Algebra (ResidueField (Z.presheaf.stalk z)) L]
    [IsSepClosure (ResidueField (Z.presheaf.stalk z)) L]
    (T : HenselizationTower (W.presheaf.stalk w) K)
    (N : HenselizationTower (Z.presheaf.stalk z) L) {C D : Type*} [CommRing C] [CommRing D]
    (eW : T.strictHenselization ≃+* C) (eZ : N.strictHenselization ≃+* D) (φ : C →+* D)
    (hc : ∀ a : Γ(W, ⊤),
      φ (eW (algebraMap _ T.strictHenselization (W.presheaf.germ ⊤ w trivial a))) =
        eZ (algebraMap _ N.strictHenselization
          (Z.presheaf.germ ⊤ z trivial ((Scheme.Γ.map q.op).hom a)))) :
    IsLocalHom φ := by
  subst hzw
  set ψ := eZ.symm.toRingHom.comp (φ.comp eW.toRingHom)
  have hs : ψ.comp (algebraMap _ T.strictHenselization) =
      (algebraMap _ N.strictHenselization).comp (q.stalkMap z).hom := by
    let _ : Algebra Γ(W, ⊤) (W.presheaf.stalk (q z)) :=
      TopCat.Presheaf.algebra_section_stalk W.presheaf (⟨q z, trivial⟩ : (⊤ : W.Opens))
    have := (isAffineOpen_top W).isLocalization_stalk (⟨q z, trivial⟩ : (⊤ : W.Opens))
    apply IsLocalization.ringHom_ext
      ((isAffineOpen_top W).primeIdealOf ⟨q z, trivial⟩).asIdeal.primeCompl
    ext a
    show eZ.symm (φ (eW (algebraMap _ T.strictHenselization
      (W.presheaf.germ ⊤ (q z) trivial a)))) = _
    rw [hc, RingEquiv.symm_apply_apply]
    exact congrArg (algebraMap _ N.strictHenselization)
      (q.germ_stalkMap_apply ⊤ z trivial a).symm
  have hψ : IsLocalHom ψ :=
    isLocalHom_of_henselizationTower_square T N (q.stalkMap z).hom ψ hs
  have h1 : IsLocalHom eW.symm.toRingHom := isLocalHom_ringEquiv eW.symm
  have h2 : IsLocalHom eZ.toRingHom := isLocalHom_ringEquiv eZ
  have h3 : IsLocalHom (ψ.comp eW.symm.toRingHom) := RingHom.isLocalHom_comp _ _
  have hfac : φ = eZ.toRingHom.comp (ψ.comp eW.symm.toRingHom) := by
    ext a
    show φ a = eZ (eZ.symm (φ (eW (eW.symm a))))
    rw [RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
  rw [hfac]
  exact RingHom.isLocalHom_comp _ _

/-- The canonical homomorphism of étale local rings induced by a morphism of algebraic spaces
at a geometric point of its source is a local homomorphism. -/
theorem isLocalHom_etaleLocalRingMap (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y) (x : GeometricPoint B S hS X) :
    IsLocalHom (etaleLocalRingMap hX f x) := by
  obtain ⟨U, V, g, hcomm, hpoint, hAffine⟩ :=
    exists_compatible_affine_chart_square B S hS hX hY f x
  have : IsAffine (chartScheme V.chart) := hAffine
  set q : chartScheme U.chart ⟶ chartScheme V.chart :=
    (BigFppfOver.toScheme B S hS).map g
  set u := (chartGeometricPoint U).hom (closedPoint (chartGeometricPoint U).residueField)
  set v := (chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField)
  have huv : q u = v :=
    congrArg (fun k ↦ ((BigFppfOver.toScheme B S hS).map k)
      (show (BigFppfOver.toScheme B S hS).obj x.val.siteObject from
        closedPoint x.val.carrier)) hpoint
  set TV := henselizationTower ((chartScheme V.chart).presheaf.stalk v)
    (separableClosure (ResidueField ((chartScheme V.chart).presheaf.stalk v))
      (chartGeometricPoint V).residueField)
  set TU := henselizationTower ((chartScheme U.chart).presheaf.stalk u)
    (separableClosure (ResidueField ((chartScheme U.chart).presheaf.stalk u))
      (chartGeometricPoint U).residueField)
  refine isLocalHom_of_strictHenselization_germs q u v huv TV TU
    (strictHenselizationEquivEtaleLocalRing hY V (bigEtaleSiteOfFppfSite B)
      V.chart.obj.left.left.property TV)
    (strictHenselizationEquivEtaleLocalRing hX U (bigEtaleSiteOfFppfSite B)
      U.chart.obj.left.left.property TU)
    (etaleLocalRingMap hX f x) fun a ↦ ?_
  calc
    _ = (etaleLocalRingMap hX f x)
          (etaleLocalRingGerm B S hS Y (geometricPointMap f x) (Opposite.op V) a) :=
      congrArg _ (strictHenselizationEquivEtaleLocalRing_germ hY V
        (bigEtaleSiteOfFppfSite B) V.chart.obj.left.left.property TV a)
    _ = etaleLocalRingGerm B S hS X x (Opposite.op U) ((Scheme.Γ.map q.op).hom a) :=
      (congrArg (fun k ↦ k a)
        (etaleLocalRingMap_isEtaleLocalRingMap hX f x U V g hcomm hpoint)).symm
    _ = _ := (strictHenselizationEquivEtaleLocalRing_germ hX U
      (bigEtaleSiteOfFppfSite B) U.chart.obj.left.left.property TU
      ((Scheme.Γ.map q.op).hom a)).symm

/-! ### The target local rings -/

/-- Tag 0C0X for the local ring of the target at a prescribed image point. -/
private theorem isCohenMacaulayLocalRing_stalk_of_map_eq {Z W : Scheme.{u}} (q : Z ⟶ W)
    [IsLocallyNoetherian Z] [IsLocallyNoetherian W] [Flat q]
    (hZ : _root_.AlgebraicGeometry.IsCohenMacaulay Z) (z : Z) (w : W) (hzw : q z = w) :
    IsCohenMacaulayLocalRing (W.presheaf.stalk w) := by
  subst hzw
  exact isCohenMacaulayLocalRing_targetStalk_of_isCohenMacaulay_source q hZ z

/-- **Stacks 0E0Y.** For a flat morphism of locally Noetherian algebraic spaces over `S` whose
source is a Cohen–Macaulay algebraic space, the étale local ring of the target at the image of
any geometric point of the source is Cohen–Macaulay. -/
@[stacks 0E0Y "the target étale local rings are Cohen-Macaulay"]
theorem isCohenMacaulayLocalRing_etaleLocalRing_target (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y)
    (hNX : HasEtaleLocalProperty B S hS X (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hNY : HasEtaleLocalProperty B S hS Y (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hCM : HasEtaleLocalProperty B S hS X
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T))
    (f : X ⟶ Y) (hf : IsFlat B S hS f) (x : GeometricPoint B S hS X) :
    letI : IsLocalRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
      isLocalRing_etaleLocalRing B S hS Y hY (geometricPointMap f x)
    letI : IsNoetherianRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
      isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian B S hS Y hY hNY
        (geometricPointMap f x)
    IsCohenMacaulayLocalRing (etaleLocalRing B S hS Y (geometricPointMap f x)) := by
  have : IsLocalRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    isLocalRing_etaleLocalRing B S hS Y hY (geometricPointMap f x)
  have : IsNoetherianRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    isNoetherianRing_etaleLocalRing_of_isLocallyNoetherian B S hS Y hY hNY
      (geometricPointMap f x)
  obtain ⟨U, V, g, hcomm, hpoint⟩ :=
    exists_compatible_chart_square B S hS hX hY f x
  have hUnoeth' : IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj U.chart.obj.left) :=
    (exists_atlas_iff_forall_etale B S hS X
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hX).mp hNX
      U.chart.obj.left U.chart.obj.hom U.chart.property
  have hVnoeth' : IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V.chart.obj.left) :=
    (exists_atlas_iff_forall_etale B S hS Y
      (fun T : Scheme.{u} => IsLocallyNoetherian T) hY).mp hNY
      V.chart.obj.left V.chart.obj.hom V.chart.property
  have hUcm : _root_.AlgebraicGeometry.IsCohenMacaulay (chartScheme U.chart) :=
    (exists_atlas_iff_forall_etale B S hS X
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsCohenMacaulay T) hX).mp hCM
      U.chart.obj.left U.chart.obj.hom U.chart.property
  have hUnoeth : IsLocallyNoetherian (chartScheme U.chart) := hUnoeth'
  have hVnoeth : IsLocallyNoetherian (chartScheme V.chart) := hVnoeth'
  have hflat : Flat ((BigFppfOver.toScheme B S hS).map g) :=
    hf U.chart.obj.left V.chart.obj.left U.chart.obj.hom V.chart.obj.hom g
      U.chart.property V.chart.property hcomm.symm
  have huv : ((BigFppfOver.toScheme B S hS).map g)
        ((chartGeometricPoint U).hom (closedPoint (chartGeometricPoint U).residueField)) =
      (chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField) :=
    congrArg (fun k ↦ ((BigFppfOver.toScheme B S hS).map k)
      (show (BigFppfOver.toScheme B S hS).obj x.val.siteObject from
        closedPoint x.val.carrier)) hpoint
  let R := (chartScheme V.chart).presheaf.stalk
    ((chartGeometricPoint V).hom (closedPoint (chartGeometricPoint V).residueField))
  have hRcm : IsCohenMacaulayLocalRing R :=
    isCohenMacaulayLocalRing_stalk_of_map_eq ((BigFppfOver.toScheme B S hS).map g) hUcm _ _ huv
  let T := henselizationTower R
    (separableClosure (ResidueField R) (chartGeometricPoint V).residueField)
  have hT : IsNoetherianRing T.strictHenselization :=
    (isNoetherianRing_iff_henselizations R T.henselization T.strictHenselization
      (separableClosure (ResidueField R) (chartGeometricPoint V).residueField)).2.mp inferInstance
  exact (isCohenMacaulayLocalRing_iff_of_ringEquiv
    (strictHenselizationEquivEtaleLocalRing hY V (bigEtaleSiteOfFppfSite B)
      V.chart.obj.left.left.property T)).mp
    (isCohenMacaulayLocalRing_strictHenselization T hT hRcm)

end AlgebraicGeometry.Space

end
