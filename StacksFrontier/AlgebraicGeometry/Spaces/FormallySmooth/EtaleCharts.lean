-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

/-! ### Replacing a square-zero extension by one of bounded cardinality -/

/-- The subring of `A'` generated by the image of `p : S →+* A'` together with one chosen
element `liftg x` of `A'` for each `x : R`. It is the range of the evaluation of integer
polynomials in those elements. -/
private noncomputable def boundedImageSubring {R S A' : Type u}
    [CommRing S] [CommRing A'] (p : S →+* A') (liftg : R → A') : Subring A' :=
  RingHom.range (MvPolynomial.eval₂Hom (Int.castRingHom A')
    (fun x : Sum.{u, u} R S => Sum.elim liftg p x))

private lemma mk_boundedImageSubring_lt {R S A' : Type u}
    [CommRing S] [CommRing A'] (p : S →+* A') (liftg : R → A')
    {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 < κ)
    (hR : Cardinal.mk R < κ) (hS : Cardinal.mk S < κ) :
    Cardinal.mk (boundedImageSubring p liftg) < κ := by
  have hsum : Cardinal.mk (Sum.{u, u} R S) < κ :=
    ((by simpa only [Cardinal.mk_sum, Cardinal.lift_id] using
      Cardinal.add_le_max (Cardinal.mk R) (Cardinal.mk S) :
        Cardinal.mk (Sum.{u, u} R S) ≤
          max (max (Cardinal.mk R) (Cardinal.mk S)) Cardinal.aleph0)).trans_lt
      (max_lt (max_lt hR hS) hκ)
  refine (Cardinal.mk_le_of_surjective (RingHom.rangeRestrict_surjective
    (MvPolynomial.eval₂Hom (Int.castRingHom A')
      (fun x : Sum.{u, u} R S => Sum.elim liftg p x)))).trans_lt ?_
  refine MvPolynomial.cardinalMk_le_max_lift.trans_lt ?_
  simp only [Cardinal.mk_int, Cardinal.lift_aleph0, Cardinal.lift_uzero, sup_lt_iff]
  exact ⟨⟨hκ, hsum⟩, hκ⟩

private lemma ker_comp_subtype_sq_eq_bot {A A' : Type u} [CommRing A] [CommRing A']
    (q : A' →+* A) (A₀ : Subring A') (hker : RingHom.ker q ^ 2 = ⊥) :
    RingHom.ker (q.comp A₀.subtype) ^ 2 = ⊥ := by
  rw [← RingHom.comap_ker]
  refine le_antisymm ?_ bot_le
  refine (Ideal.le_comap_pow (f := A₀.subtype) (K := RingHom.ker q) 2).trans ?_
  rw [hker]
  refine le_of_eq ?_
  ext x
  simp

/-- A square-zero surjection `q : A' ⟶ A` of rings, together with maps `g : R ⟶ A` and
`p : S ⟶ A'` into it, factored through a square-zero surjection between rings of bounded
cardinality. -/
private structure BoundedSquareZeroPresentation {R S A A' : Type u}
    [CommRing R] [CommRing S] [CommRing A] [CommRing A']
    (q : A' →+* A) (g : R →+* A) (p : S →+* A')
    {κ : Cardinal.{u}} where
  /-- The small replacement for `A'`. -/
  source : Subring A'
  /-- The small replacement for `A`. -/
  quotient : Subring A
  /-- The small replacement for `q`. -/
  sourceToQuotient : source →+* quotient
  /-- The factorization of `g`. -/
  gSmall : R →+* quotient
  /-- The factorization of `p`. -/
  pSmall : S →+* source
  /-- The small source is below the bound. -/
  sourceSmall : Cardinal.mk source < κ
  /-- The small quotient is below the bound. -/
  quotientSmall : Cardinal.mk quotient < κ
  /-- The small replacement for `q` is still surjective. -/
  sourceToQuotientSurjective : Function.Surjective sourceToQuotient
  /-- The small replacement for `q` still has square-zero kernel. -/
  sourceToQuotientKernelSq : RingHom.ker sourceToQuotient ^ 2 = ⊥
  /-- `q` restricts to `sourceToQuotient`. -/
  quotientFactor : ∀ x, q (source.subtype x) = quotient.subtype (sourceToQuotient x)
  /-- `g` factors through `gSmall`. -/
  gFactor : ∀ x, g x = quotient.subtype (gSmall x)
  /-- `p` factors through `pSmall`. -/
  pFactor : ∀ x, p x = source.subtype (pSmall x)

/-- **Every square of rings around a square-zero surjection factors through one of bounded
cardinality.** Take for `source` the subring of `A'` generated by the image of `p` together
with one chosen preimage under `q` of each element of `R`, and for `quotient` its image
under `q`. -/
private noncomputable def boundedSquareZeroPresentation
    {R S A A' : Type u} [CommRing R] [CommRing S] [CommRing A] [CommRing A']
    {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 < κ)
    (q : A' →+* A) (hq : Function.Surjective q)
    (g : R →+* A) (p : S →+* A')
    (hR : Cardinal.mk R < κ) (hS : Cardinal.mk S < κ)
    (hker : RingHom.ker q ^ 2 = ⊥) :
    BoundedSquareZeroPresentation q g p (κ := κ) := by
  classical
  let liftg : R → A' := fun x => Classical.choose (hq (g x))
  have hliftg : ∀ x, q (liftg x) = g x := fun x => Classical.choose_spec (hq (g x))
  let A₀ := boundedImageSubring p liftg
  let q₀ : A₀ →+* A := q.comp A₀.subtype
  let qC : A₀ →+* RingHom.range q₀ := q₀.rangeRestrict
  have hgC : ∀ x, g x ∈ RingHom.range q₀ := fun x =>
    ⟨⟨liftg x, ⟨MvPolynomial.X (Sum.inl x), by simp⟩⟩, hliftg x⟩
  have hpA₀ : ∀ x, p x ∈ A₀ := fun x => ⟨MvPolynomial.X (Sum.inr x), by simp⟩
  have hsource : Cardinal.mk A₀ < κ := mk_boundedImageSubring_lt p liftg hκ hR hS
  have hqC : Function.Surjective qC := RingHom.rangeRestrict_surjective q₀
  exact
    { source := A₀
      quotient := RingHom.range q₀
      sourceToQuotient := qC
      gSmall := g.codRestrict _ hgC
      pSmall := p.codRestrict A₀ hpA₀
      sourceSmall := hsource
      quotientSmall := (Cardinal.mk_le_of_surjective (f := qC) hqC).trans_lt hsource
      sourceToQuotientSurjective := hqC
      sourceToQuotientKernelSq := by
        rw [RingHom.ker_rangeRestrict]
        exact ker_comp_subtype_sq_eq_bot q A₀ hker
      quotientFactor := fun _ => rfl
      gFactor := fun x => (RingHom.codRestrict_apply g _ hgC x).symm
      pFactor := fun x => (RingHom.codRestrict_apply p A₀ hpA₀ x).symm }

private lemma spec_size_lt_cutoff_of_mk (B : BigFppfSite.{u}) {A : Type u} [CommRing A]
    (hA : Cardinal.mk A < B.cutoff) : (Spec (CommRingCat.of A)).size < B.cutoff := by
  rw [Scheme.size_Spec]
  exact max_lt B.aleph0_lt_cutoff hA

/-! ### From the site to schemes -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A formally étale transformation of presheaves is formally unramified: uniqueness of lifts is
part of the `∃!`. -/
private theorem formallyUnramified_of_formallyEtale' {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {a : F ⟶ G} (ha : FormallyEtale a) : FormallyUnramified a :=
  fun T T' hT hT' i hi x y hxy _ _ hz₁ hz₂ => (ha T T' hT hT' i hi x y hxy).unique hz₁ hz₂

/-- A morphism `ψ` of the big fppf site over `S` whose induced transformation of representable
presheaves is formally étale has formally unramified underlying morphism of schemes: a formally
étale transformation is formally unramified, and Tag 04G8 reads that off the identity charts. -/
theorem schemeFormallyUnramified_of_formallyEtale_yonedaMap
    {U V : BigFppfOver B S hS} (ψ : U ⟶ V) (hψ : FormallyEtale (yoneda.map ψ)) :
    _root_.AlgebraicGeometry.FormallyUnramified ((BigFppfOver.toScheme B S hS).map ψ) :=
  formallyUnramified_map_of_formallyUnramified B S hS ψ
    (formallyUnramified_of_formallyEtale' B S hS hψ)

/-- **The lifting property of `yoneda.map ψ` over a thickening the site contains.** If the two
affine schemes of a first-order thickening `i : T ⟶ T'` are small enough to be objects of the
big fppf site, then a lifting problem of schemes for `ψ` is a lifting problem of the site, so
formal étaleness of `yoneda.map ψ` solves it. -/
theorem exists_lift_of_formallyEtale_yonedaMap_of_contains
    {U V : BigFppfOver B S hS} (ψ : U ⟶ V) (hψ : FormallyEtale (yoneda.map ψ))
    {T T' : Scheme.{u}} [IsAffine T] [IsAffine T']
    (hT : B.Contains T) (hT' : B.Contains T')
    (i : T ⟶ T') (hi : Stacks.Thickenings.IsFirstOrderThickening i)
    (g : T ⟶ (BigFppfOver.toScheme B S hS).obj U)
    (p : T' ⟶ (BigFppfOver.toScheme B S hS).obj V)
    (hc : g ≫ (BigFppfOver.toScheme B S hS).map ψ = i ≫ p) :
    ∃ h : T' ⟶ (BigFppfOver.toScheme B S hS).obj U,
      i ≫ h = g ∧ h ≫ (BigFppfOver.toScheme B S hS).map ψ = p := by
  let g₀ : B.obj hT ⟶ U.left := B.inclusion.preimage g
  let p₀ : B.obj hT' ⟶ V.left := B.inclusion.preimage p
  let i₀ : B.obj hT ⟶ B.obj hT' := B.inclusion.preimage i
  have hg₀ : B.inclusion.map g₀ = g := B.inclusion.map_preimage _
  have hp₀ : B.inclusion.map p₀ = p := B.inclusion.map_preimage _
  have hi₀ : B.inclusion.map i₀ = i := B.inclusion.map_preimage _
  have hc₀ : g₀ ≫ ψ.left = i₀ ≫ p₀ := by
    apply B.inclusion.map_injective
    rw [Functor.map_comp, Functor.map_comp, hg₀, hp₀, hi₀]
    exact hc
  let A : BigFppfOver B S hS := Over.mk (g₀ ≫ U.hom)
  let A' : BigFppfOver B S hS := Over.mk (p₀ ≫ V.hom)
  let g₁ : A ⟶ U := Over.homMk g₀
  let p₁ : A' ⟶ V := Over.homMk p₀
  let i₁ : A ⟶ A' := Over.homMk i₀ (by
    show i₀ ≫ (p₀ ≫ V.hom) = g₀ ≫ U.hom
    rw [← Category.assoc, ← hc₀, Category.assoc, ψ.w])
  have hAi : IsAffine ((BigFppfOver.toScheme B S hS).obj A) := inferInstanceAs (IsAffine T)
  have hA'i : IsAffine ((BigFppfOver.toScheme B S hS).obj A') := inferInstanceAs (IsAffine T')
  have hi₁ : IsSquareZeroClosedImmersion B S hS i₁ := by
    show _root_.AlgebraicGeometry.IsClosedImmersion (B.inclusion.map i₀) ∧
      (B.inclusion.map i₀).ker ^ 2 = ⊥
    rw [hi₀]
    exact ⟨hi.1, hi.2⟩
  obtain ⟨h, hh, -⟩ := hψ A A' hAi hA'i i₁ hi₁ g₁ p₁ (Over.OverMorphism.ext hc₀)
  refine ⟨(BigFppfOver.toScheme B S hS).map h, ?_, ?_⟩
  · have he := congrArg (BigFppfOver.toScheme B S hS).map hh.1
    change B.inclusion.map i₀ ≫ B.inclusion.map h.left = B.inclusion.map g₀ at he
    rwa [hi₀, hg₀] at he
  · have he := congrArg (BigFppfOver.toScheme B S hS).map hh.2
    change B.inclusion.map h.left ≫ B.inclusion.map ψ.left = B.inclusion.map p₀ at he
    rwa [hp₀] at he

private lemma isoSpec_hom_comp_spec_map_eq_of_appTop_eq_subtype {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (D : Subring Γ(X, ⊤)) (φ : Γ(Y, ⊤) →+* D)
    (hφ : ∀ x, f.appTop.hom x = D.subtype (φ x)) :
    (X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom D.subtype)) ≫
      Spec.map (CommRingCat.ofHom φ) ≫ Y.isoSpec.inv = f := by
  simp only [Category.assoc, ← Spec.map_comp_assoc]
  rw [show CommRingCat.ofHom φ ≫ CommRingCat.ofHom D.subtype = f.appTop from
      CommRingCat.hom_ext (RingHom.ext fun x => (hφ x).symm),
    Scheme.isoSpec_hom_naturality_assoc, Iso.hom_inv_id, Category.comp_id]

/-- **The lifting property of `yoneda.map ψ` for an affine `ψ`, over an arbitrary thickening of
affine schemes.** The square of rings presented by the lifting problem factors through one
between rings of cardinality below the cutoff of the site, and the spectra of those are objects
of the site, so `AlgebraicGeometry.Space.exists_lift_of_formallyEtale_yonedaMap_of_contains`
applies. -/
theorem exists_lift_of_formallyEtale_yonedaMap_of_isAffine
    {U V : BigFppfOver B S hS} (ψ : U ⟶ V) (hψ : FormallyEtale (yoneda.map ψ))
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
    {T T' : Scheme.{u}} [IsAffine T] [IsAffine T']
    (i : T ⟶ T') (hi : Stacks.Thickenings.IsFirstOrderThickening i)
    (g : T ⟶ (BigFppfOver.toScheme B S hS).obj U)
    (p : T' ⟶ (BigFppfOver.toScheme B S hS).obj V)
    (hc : g ≫ (BigFppfOver.toScheme B S hS).map ψ = i ≫ p) :
    ∃ h : T' ⟶ (BigFppfOver.toScheme B S hS).obj U,
      i ≫ h = g ∧ h ≫ (BigFppfOver.toScheme B S hS).map ψ = p := by
  classical
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion i := hi.1
  have hsurj := (IsClosedImmersion.isAffine_surjective_of_isAffine i).2
  have hcard (W : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj W)] :
      Cardinal.mk Γ(((BigFppfOver.toScheme B S hS).obj W), ⊤) < B.cutoff :=
    (Scheme.mk_sections_le_size _ ⟨⊤, isAffineOpen_top _⟩).trans_lt W.left.property
  let D := boundedSquareZeroPresentation B.aleph0_lt_cutoff i.appTop.hom hsurj
    g.appTop.hom p.appTop.hom (hcard U) (hcard V) (Stacks.Smooth.ker_appTop_sq_eq_bot hi)
  have hring : i.appTop.hom.comp p.appTop.hom =
      g.appTop.hom.comp ((BigFppfOver.toScheme B S hS).map ψ).appTop.hom := by
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp] using
      congrArg (fun k => k.appTop.hom) hc.symm
  have hD : D.sourceToQuotient.comp D.pSmall =
      D.gSmall.comp ((BigFppfOver.toScheme B S hS).map ψ).appTop.hom := by
    refine RingHom.ext fun x => Subtype.val_injective ?_
    show D.quotient.subtype (D.sourceToQuotient (D.pSmall x)) =
      D.quotient.subtype (D.gSmall (((BigFppfOver.toScheme B S hS).map ψ).appTop.hom x))
    rw [← D.quotientFactor, ← D.pFactor, ← D.gFactor]
    exact DFunLike.congr_fun hring x
  have hc₀ : (Spec.map (CommRingCat.ofHom D.gSmall) ≫
        ((BigFppfOver.toScheme B S hS).obj U).isoSpec.inv) ≫
      (BigFppfOver.toScheme B S hS).map ψ =
    Spec.map (CommRingCat.ofHom D.sourceToQuotient) ≫
      Spec.map (CommRingCat.ofHom D.pSmall) ≫
        ((BigFppfOver.toScheme B S hS).obj V).isoSpec.inv := by
    rw [Category.assoc, ← Scheme.isoSpec_inv_naturality
      (f := (BigFppfOver.toScheme B S hS).map ψ)]
    simp only [← Category.assoc, ← Spec.map_comp]
    congr 2
    exact CommRingCat.hom_ext hD.symm
  obtain ⟨h, hh, hfh⟩ := exists_lift_of_formallyEtale_yonedaMap_of_contains B S hS ψ hψ
    (spec_size_lt_cutoff_of_mk B D.quotientSmall) (spec_size_lt_cutoff_of_mk B D.sourceSmall)
    (Spec.map (CommRingCat.ofHom D.sourceToQuotient))
    (specMap_isFirstOrderThickening _ D.sourceToQuotientSurjective
      D.sourceToQuotientKernelSq) _ _ hc₀
  have hab : i ≫ T'.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom D.source.subtype) =
      (T.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom D.quotient.subtype)) ≫
        Spec.map (CommRingCat.ofHom D.sourceToQuotient) := by
    rw [← Scheme.isoSpec_hom_naturality_assoc]
    simp only [Category.assoc, ← Spec.map_comp]
    congr 2
  refine ⟨(T'.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom D.source.subtype)) ≫ h, ?_, ?_⟩
  · rw [← Category.assoc, hab, Category.assoc, hh,
      isoSpec_hom_comp_spec_map_eq_of_appTop_eq_subtype g D.quotient D.gSmall D.gFactor]
  · rw [Category.assoc, hfh,
      isoSpec_hom_comp_spec_map_eq_of_appTop_eq_subtype p D.source D.pSmall D.pFactor]

/-- **The affine case of `schemeFormallyEtale_of_formallyEtale_yonedaMap`.** For a morphism
`ψ` of affine objects of the site with formally étale `yoneda.map ψ`, the underlying morphism of
schemes is formally étale. -/
private theorem schemeFormallyEtale_of_formallyEtale_yonedaMap_of_isAffine
    {U V : BigFppfOver B S hS} (ψ : U ⟶ V) (hψ : FormallyEtale (yoneda.map ψ))
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V)] :
    _root_.AlgebraicGeometry.FormallyEtale ((BigFppfOver.toScheme B S hS).map ψ) := by
  have := schemeFormallyUnramified_of_formallyEtale_yonedaMap B S hS ψ hψ
  intro Z Z' _ _ i hi p g hc
  obtain ⟨h, hh⟩ := exists_lift_of_formallyEtale_yonedaMap_of_isAffine B S hS ψ hψ i hi g p hc
  exact ⟨h, hh, fun k hk => Stacks.Smooth.lift_unique ((BigFppfOver.toScheme B S hS).map ψ)
    hi hk.2 hh.2 hk.1 hh.1⟩

/-- **Formal étaleness of `yoneda.map` transported along étale charts.** If `ψ' ≫ b = a ≫ ψ`
with `a` and `b` étale and `yoneda.map ψ` formally étale, then `yoneda.map ψ'` is formally
étale: Tag 04AL makes the charts formally étale, Tag 049T composes and Tag 04G5 cancels `b`. -/
private theorem formallyEtale_yonedaMap_of_comp_eq_comp_of_etale
    {P Q P' Q' : BigFppfOver B S hS} (ψ : P ⟶ Q) (hψ : FormallyEtale (yoneda.map ψ))
    (ψ' : P' ⟶ Q') (a : P' ⟶ P) (b : Q' ⟶ Q)
    (ha : AlgebraicGeometry.Etale ((BigFppfOver.toScheme B S hS).map a))
    (hb : AlgebraicGeometry.Etale ((BigFppfOver.toScheme B S hS).map b))
    (hdiag : ψ' ≫ b = a ≫ ψ) : FormallyEtale (yoneda.map ψ') := by
  let E := MorphismProperty.inverseImage
    (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS)
  have := B.hasPullbacks_schemes
  have : HasPullbacks (BigFppfOver B S hS) := inferInstance
  have : PreservesLimitsOfShape WalkingCospan (BigFppfOver.toScheme B S hS) :=
    preservesLimitsOfShape_walkingCospan_toScheme B S hS
  have : E.IsStableUnderBaseChange :=
    inverseImage_isStableUnderBaseChange B S hS
      (inferInstance : MorphismProperty.IsStableUnderBaseChange
        (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u}))
  have haF := formallyEtale_of_etale B S hS (yoneda.map a)
    ((MorphismProperty.relative_map_iff (F := yoneda) (P := E)).2 ha)
  have hbF := formallyEtale_of_etale B S hS (yoneda.map b)
    ((MorphismProperty.relative_map_iff (F := yoneda) (P := E)).2 hb)
  refine formallyEtale_of_comp_of_formallyUnramified (yoneda.map ψ') (yoneda.map b)
    (formallyUnramified_of_formallyEtale' B S hS hbF) ?_
  rw [← Functor.map_comp, hdiag, Functor.map_comp]
  exact formallyEtale_comp haF hψ

/-- **A formally étale morphism of representable presheaves is formally étale on affine
charts.** For affine opens `U` of the target and `V` of the source with `V` over `U`, the
restriction of the morphism of schemes underlying `ψ` to `V ⟶ U` is formally étale.

Both opens are objects of the site, since an open immersion is a monomorphism locally of
finite presentation and hence does not increase size. The two inclusions are étale charts, so
Tag 04AL makes them formally étale, Tag 049T composes and Tag 04G5 cancels the chart of the
target; the resulting restricted morphism of the site has formally étale `yoneda.map` and
affine source and target, so
`AlgebraicGeometry.Space.exists_lift_of_formallyEtale_yonedaMap_of_isAffine` supplies the
lifts and formal unramifiedness their uniqueness. -/
theorem formallyEtale_resLE_of_formallyEtale_yonedaMap
    {P Q : BigFppfOver B S hS} (ψ : P ⟶ Q) (hψ : FormallyEtale (yoneda.map ψ))
    (U : ((BigFppfOver.toScheme B S hS).obj Q).Opens)
    (V : ((BigFppfOver.toScheme B S hS).obj P).Opens)
    (hU : IsAffineOpen U) (hV : IsAffineOpen V)
    (hVU : V ≤ ((BigFppfOver.toScheme B S hS).map ψ) ⁻¹ᵁ U) :
    _root_.AlgebraicGeometry.FormallyEtale
      (((BigFppfOver.toScheme B S hS).map ψ).resLE U V hVU) := by
  classical
  let f := (BigFppfOver.toScheme B S hS).map ψ
  let Vobj : B.Schemes := B.obj (lt_of_le_of_lt
    (Scheme.size_le_of_mono_locallyOfFinitePresentation V.ι) P.left.property)
  let Uobj : B.Schemes := B.obj (lt_of_le_of_lt
    (Scheme.size_le_of_mono_locallyOfFinitePresentation U.ι) Q.left.property)
  let vBase : Vobj ⟶ P.left := B.inclusion.preimage V.ι
  let uBase : Uobj ⟶ Q.left := B.inclusion.preimage U.ι
  have hMapV : B.inclusion.map vBase = V.ι := B.inclusion.map_preimage _
  have hMapU : B.inclusion.map uBase = U.ι := B.inclusion.map_preimage _
  let P' : BigFppfOver B S hS := Over.mk (vBase ≫ P.hom)
  let Q' : BigFppfOver B S hS := Over.mk (uBase ≫ Q.hom)
  let a : P' ⟶ P := Over.homMk vBase rfl
  let b : Q' ⟶ Q := Over.homMk uBase rfl
  let fOpen : V.toScheme ⟶ U.toScheme := f.resLE U V hVU
  let fOpenBase : P'.left ⟶ Q'.left := B.inclusion.preimage fOpen
  have hMapFOpen : B.inclusion.map fOpenBase = fOpen := B.inclusion.map_preimage _
  have hres : fOpen ≫ U.ι = V.ι ≫ f := Scheme.Hom.resLE_comp_ι f hVU
  let ψOpen : P' ⟶ Q' := Over.homMk fOpenBase (by
    apply B.inclusion.map_injective
    show B.inclusion.map fOpenBase ≫ B.inclusion.map uBase ≫
      B.inclusion.map Q.hom = B.inclusion.map vBase ≫ B.inclusion.map P.hom
    rw [hMapFOpen, hMapU, hMapV, reassoc_of% hres]
    exact V.ι ≫= (B.inclusion.map_comp _ _).symm.trans (congrArg B.inclusion.map (Over.w ψ)))
  have hMapψOpen : B.inclusion.map (Over.Hom.left ψOpen) = fOpen := hMapFOpen
  have hMapa : B.inclusion.map (Over.Hom.left a) = V.ι := hMapV
  have hMapb : B.inclusion.map (Over.Hom.left b) = U.ι := hMapU
  have hMapψ : B.inclusion.map (Over.Hom.left ψ) = f := rfl
  have hdiag : ψOpen ≫ b = a ≫ ψ := by
    refine Over.OverMorphism.ext (B.inclusion.map_injective ?_)
    calc B.inclusion.map (Over.Hom.left ψOpen ≫ Over.Hom.left b)
        = fOpen ≫ U.ι := by rw [Functor.map_comp, hMapψOpen, hMapb]
      _ = V.ι ≫ f := hres
      _ = B.inclusion.map (Over.Hom.left a ≫ Over.Hom.left ψ) := by
          rw [Functor.map_comp, hMapa, hMapψ]
  have ha : AlgebraicGeometry.Etale ((BigFppfOver.toScheme B S hS).map a) := by
    show AlgebraicGeometry.Etale (B.inclusion.map vBase)
    rw [hMapV]
    infer_instance
  have hb : AlgebraicGeometry.Etale ((BigFppfOver.toScheme B S hS).map b) := by
    show AlgebraicGeometry.Etale (B.inclusion.map uBase)
    rw [hMapU]
    infer_instance
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj P') := hV
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj Q') := hU
  have hGmap : (BigFppfOver.toScheme B S hS).map ψOpen =
      ((BigFppfOver.toScheme B S hS).map ψ).resLE U V hVU := hMapψOpen
  rw [← hGmap]
  exact schemeFormallyEtale_of_formallyEtale_yonedaMap_of_isAffine B S hS ψOpen
    (formallyEtale_yonedaMap_of_comp_eq_comp_of_etale B S hS ψ hψ ψOpen a b ha hb hdiag)

/-- **Shrinking a neighbourhood along a first-order thickening.** If `i : T ⟶ T'` is a
first-order thickening and `a t₀ ∈ W`, then `i t₀` has an affine open neighbourhood `V'` with
`i ⁻¹ᵁ V' ≤ a ⁻¹ᵁ W`, since `i` is a homeomorphism on points. -/
private theorem exists_isAffineOpen_preimage_le_of_isFirstOrderThickening
    {T T' X : Scheme.{u}} {i : T ⟶ T'} (hi : Stacks.Thickenings.IsFirstOrderThickening i)
    (a : T ⟶ X) (W : X.Opens) {t₀ : T} (ht₀ : a.base t₀ ∈ W) :
    ∃ V' : T'.Opens, IsAffineOpen V' ∧ i.base t₀ ∈ V' ∧ i ⁻¹ᵁ V' ≤ a ⁻¹ᵁ W := by
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion i := hi.1
  have homeo : IsHomeomorph i.base :=
    isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨i.isClosedEmbedding.isEmbedding, hi.isThickening.2⟩
  let Ω : T'.Opens := ⟨i.base '' (a ⁻¹ᵁ W : Set T), homeo.isOpenMap _ (a ⁻¹ᵁ W).isOpen⟩
  obtain ⟨V', hV', htV', hV'le⟩ :
      ∃ V' : T'.Opens, IsAffineOpen V' ∧ i.base t₀ ∈ V' ∧ V' ≤ Ω :=
    exists_isAffineOpen_mem_and_subset (show i.base t₀ ∈ Ω from ⟨t₀, ht₀, rfl⟩)
  refine ⟨V', hV', htV', fun x hx => ?_⟩
  obtain ⟨y, hy, hxy⟩ := hV'le hx
  exact homeo.injective hxy ▸ hy

/-- **A lifting problem for a formally étale `yoneda.map ψ` is solvable locally on the
thickening.** Every point of `T'` has an affine open neighbourhood `V'` over which the
restricted lifting problem for the morphism of schemes underlying `ψ` has a solution.

The affine chart around the image of the point is chosen from the bases of affine opens of the
source and the target, and `V'` is shrunk so that `i ⁻¹ᵁ V'` maps into the chart of the source,
which is possible because a thickening is a homeomorphism on points. -/
theorem exists_isAffineOpen_lift_of_formallyEtale_yonedaMap
    {P Q : BigFppfOver B S hS} (ψ : P ⟶ Q) (hψ : FormallyEtale (yoneda.map ψ))
    {T T' : Scheme.{u}} {i : T ⟶ T'} (hi : Stacks.Thickenings.IsFirstOrderThickening i)
    (a : T ⟶ (BigFppfOver.toScheme B S hS).obj P)
    (h : T' ⟶ (BigFppfOver.toScheme B S hS).obj Q)
    (hcomm : a ≫ (BigFppfOver.toScheme B S hS).map ψ = i ≫ h) (t : T') :
    ∃ V' : T'.Opens, IsAffineOpen V' ∧ t ∈ V' ∧
      ∃ b : (V' : Scheme.{u}) ⟶ (BigFppfOver.toScheme B S hS).obj P,
        b ≫ (BigFppfOver.toScheme B S hS).map ψ = V'.ι ≫ h ∧
          (i ∣_ V') ≫ b = (i ⁻¹ᵁ V').ι ≫ a := by
  classical
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion i := hi.1
  obtain ⟨t₀, rfl⟩ := hi.isThickening.2 t
  obtain ⟨U, hU, htU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤)
    (Set.mem_univ (((BigFppfOver.toScheme B S hS).map ψ).base (a.base t₀)))
  obtain ⟨W, hW, htW, hWU⟩ : ∃ W : ((BigFppfOver.toScheme B S hS).obj P).Opens,
      IsAffineOpen W ∧ a.base t₀ ∈ W ∧
        W ≤ ((BigFppfOver.toScheme B S hS).map ψ) ⁻¹ᵁ U :=
    exists_isAffineOpen_mem_and_subset
      (show a.base t₀ ∈ ((BigFppfOver.toScheme B S hS).map ψ) ⁻¹ᵁ U from htU)
  obtain ⟨V', hV', htV', hpre⟩ :=
    exists_isAffineOpen_preimage_le_of_isFirstOrderThickening hi a W htW
  have hV'a : IsAffine (V' : Scheme.{u}) := hV'
  have hthick : Stacks.Thickenings.IsFirstOrderThickening (i ∣_ V') :=
    Stacks.Smooth.isFirstOrderThickening_morphismRestrict hi V'
  have hciV' : _root_.AlgebraicGeometry.IsClosedImmersion (i ∣_ V') := hthick.1
  have : IsAffine ((i ⁻¹ᵁ V' : T.Opens) : Scheme.{u}) :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine (i ∣_ V')).1
  have hsolid : ((i ⁻¹ᵁ V').ι ≫ a) ≫ (BigFppfOver.toScheme B S hS).map ψ =
      (i ∣_ V') ≫ V'.ι ≫ h := by
    rw [Category.assoc, hcomm, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  have hranW : Set.range ((i ⁻¹ᵁ V').ι ≫ a).base ⊆
      (W : Set ((BigFppfOver.toScheme B S hS).obj P)) := by
    rintro y ⟨x, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact hpre x.2
  have hranW' : Set.range ((i ⁻¹ᵁ V').ι ≫ a).base ⊆ Set.range W.ι.base := by
    rwa [Scheme.Opens.range_ι]
  have hranU : Set.range (V'.ι ≫ h).base ⊆ Set.range U.ι.base := by
    rintro y ⟨x, rfl⟩
    obtain ⟨x₀, rfl⟩ := hthick.isThickening.2 x
    rw [Scheme.Opens.range_ι, ← Scheme.Hom.comp_apply, ← hsolid, Scheme.Hom.comp_apply]
    exact hWU (hranW ⟨x₀, rfl⟩)
  obtain ⟨b₀, hb₀, -⟩ := formallyEtale_resLE_of_formallyEtale_yonedaMap B S hS ψ hψ U W hU hW
    hWU (i ∣_ V') hthick (IsOpenImmersion.lift U.ι _ hranU)
    (IsOpenImmersion.lift W.ι _ hranW')
    (by rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc,
      IsOpenImmersion.lift_fac, ← Category.assoc, IsOpenImmersion.lift_fac, hsolid])
  refine ⟨V', hV', htV', b₀ ≫ W.ι, ?_, ?_⟩
  · rw [Category.assoc, ← Scheme.Hom.resLE_comp_ι ((BigFppfOver.toScheme B S hS).map ψ) hWU,
      ← Category.assoc, hb₀.2, IsOpenImmersion.lift_fac]
  · rw [← Category.assoc, hb₀.1, IsOpenImmersion.lift_fac]

/-- **The morphism of schemes underlying a morphism of the site with formally étale
`yoneda.map` is formally étale.** Uniqueness of fillers is formal unramifiedness; existence is
local on the thickening by
`AlgebraicGeometry.Space.exists_isAffineOpen_lift_of_formallyEtale_yonedaMap`, the local
fillers agree on overlaps by `Stacks.Smooth.lift_unique` applied to the restricted thickening,
and so they glue by `Stacks.Smooth.exists_lift_of_isOpenCover`. -/
theorem schemeFormallyEtale_of_formallyEtale_yonedaMap
    {P Q : BigFppfOver B S hS} (ψ : P ⟶ Q) (hψ : FormallyEtale (yoneda.map ψ)) :
    _root_.AlgebraicGeometry.FormallyEtale ((BigFppfOver.toScheme B S hS).map ψ) := by
  classical
  have hfu : _root_.AlgebraicGeometry.FormallyUnramified
      ((BigFppfOver.toScheme B S hS).map ψ) :=
    schemeFormallyUnramified_of_formallyEtale_yonedaMap B S hS ψ hψ
  intro T T' _ _ i hi p g hcomm
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion i := hi.1
  choose V' hV'affine htV' b hbf hba using
    exists_isAffineOpen_lift_of_formallyEtale_yonedaMap B S hS ψ hψ hi g p hcomm
  have hcover : TopologicalSpace.IsOpenCover V' :=
    top_le_iff.mp fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, htV' x⟩
  have hbb : ∀ j k : T', T'.homOfLE (inf_le_left : V' j ⊓ V' k ≤ V' j) ≫ b j =
      T'.homOfLE (inf_le_right : V' j ⊓ V' k ≤ V' k) ≫ b k := by
    intro j k
    have hres : ∀ (l : T') (e : V' j ⊓ V' k ≤ V' l),
        (i ∣_ (V' j ⊓ V' k)) ≫ T'.homOfLE e ≫ b l = (i ⁻¹ᵁ (V' j ⊓ V' k)).ι ≫ g := by
      intro l e
      rw [← Category.assoc, Stacks.Smooth.morphismRestrict_comp_homOfLE, Category.assoc, hba l,
        ← Category.assoc, Scheme.homOfLE_ι]
    have hresf : ∀ (l : T') (e : V' j ⊓ V' k ≤ V' l),
        (T'.homOfLE e ≫ b l) ≫ (BigFppfOver.toScheme B S hS).map ψ =
          (V' j ⊓ V' k).ι ≫ p := by
      intro l e
      rw [Category.assoc, hbf l, ← Category.assoc, Scheme.homOfLE_ι]
    have hthick := Stacks.Smooth.isFirstOrderThickening_morphismRestrict hi (V' j ⊓ V' k)
    have hci' : _root_.AlgebraicGeometry.IsClosedImmersion (i ∣_ (V' j ⊓ V' k)) := hthick.1
    exact _root_.AlgebraicGeometry.FormallyUnramified.hom_ext (i ∣_ (V' j ⊓ V' k))
      ⟨2, hthick.2⟩ ((BigFppfOver.toScheme B S hS).map ψ)
      (by rw [hres j inf_le_left, hres k inf_le_right])
      (by rw [hresf j inf_le_left, hresf k inf_le_right])
  obtain ⟨c, hc₁, hc₂⟩ := Stacks.Smooth.exists_lift_of_isOpenCover
    ((BigFppfOver.toScheme B S hS).map ψ) i g p V' hcover b hbf hba hbb
  exact ⟨c, ⟨hc₂, hc₁⟩, fun d hd =>
    Stacks.Smooth.lift_unique ((BigFppfOver.toScheme B S hS).map ψ) hi hd.2 hc₁ hd.1 hc₂⟩

/-- **A morphism of the site with formally étale underlying morphism of schemes induces a
formally étale transformation of representable presheaves.** A lifting problem for
`yoneda.map ψ` against a square-zero closed immersion of objects of the site is a lifting
problem of schemes, and its unique filler is a morphism of the site over `S`: the inclusion of
the site is full and faithful, and the filler lies over `S` because composing it with `ψ` gives
the structure morphism. -/
theorem formallyEtale_yonedaMap_of_schemeFormallyEtale
    {U V : BigFppfOver B S hS} (ψ : U ⟶ V)
    (hψ : _root_.AlgebraicGeometry.FormallyEtale ((BigFppfOver.toScheme B S hS).map ψ)) :
    FormallyEtale (yoneda.map ψ) := by
  intro T T' hT hT' i hi x y hxy
  let t : T ⟶ U := x
  let p : T' ⟶ V := y
  have hsquare : t ≫ ψ = i ≫ p := hxy
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj T) := hT
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj T') := hT'
  have hi' : Stacks.Thickenings.IsFirstOrderThickening
      ((BigFppfOver.toScheme B S hS).map i) := ⟨hi.1, hi.2⟩
  obtain ⟨k, hk, hku⟩ := hψ ((BigFppfOver.toScheme B S hS).map i) hi'
    ((BigFppfOver.toScheme B S hS).map p) ((BigFppfOver.toScheme B S hS).map t)
    (congrArg (BigFppfOver.toScheme B S hS).map hsquare)
  have hkψ : B.inclusion.preimage k ≫ (BigFppfOver.forget B S hS).map ψ =
      (BigFppfOver.forget B S hS).map p := by
    apply B.inclusion.map_injective
    rw [B.inclusion.map_comp, B.inclusion.map_preimage]
    exact hk.2
  let s : T' ⟶ U := Over.homMk (B.inclusion.preimage k) (by
    rw [← Over.w ψ, ← Category.assoc]
    show (B.inclusion.preimage k ≫ (BigFppfOver.forget B S hS).map ψ) ≫ V.hom = T'.hom
    rw [hkψ]
    exact p.w)
  have hsmap : (BigFppfOver.toScheme B S hS).map s = k := B.inclusion.map_preimage k
  refine ⟨s, ⟨?_, (BigFppfOver.forget B S hS).map_injective hkψ⟩, fun z hz => ?_⟩
  · refine (BigFppfOver.toScheme B S hS).map_injective ?_
    show (BigFppfOver.toScheme B S hS).map i ≫ (BigFppfOver.toScheme B S hS).map s =
      (BigFppfOver.toScheme B S hS).map t
    rw [hsmap]
    exact hk.1
  · refine (BigFppfOver.toScheme B S hS).map_injective ?_
    rw [hsmap]
    exact hku _ ⟨by rw [← Functor.map_comp, show i ≫ z = t from hz.1],
      by rw [← Functor.map_comp, show z ≫ ψ = p from hz.2]⟩

end AlgebraicGeometry.Space

