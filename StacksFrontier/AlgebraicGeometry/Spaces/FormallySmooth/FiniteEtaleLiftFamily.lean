module

public import StacksFrontier.AlgebraicGeometry.Spaces.FormallySmooth.UnramifiedChartCriterion
public import StacksFrontier.AlgebraicGeometry.Spaces.FormallySmooth.UnramifiedEtaleDescent
public import StacksFrontier.AlgebraicGeometry.Spaces.FormallySmoothChartBiconditional
public import StacksFrontier.AlgebraicGeometry.Spaces.SmoothAtlasFormallySmooth
public import StacksFrontier.AlgebraicGeometry.Spaces.SmoothEtaleLocallyFormallySmooth
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.ChartLiftFactorization
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.EtaleTopos

/-!
# Finite families of chart-adapted local lifts, and étale descent of points

Let `f : X ⟶ Y` be a morphism of algebraic spaces over `S`, let `i : T ⟶ T'` be a square-zero
closed immersion of objects of the big fppf site with `T'` affine, and let `x ∈ X(T)`,
`y ∈ Y(T')` be a lifting problem for `f` along `i`. This file supplies the two pieces of
bookkeeping that the glueing step of [Stacks Project, Tag 04AM] uses around the infinitesimal
lifts themselves.

## Main results

* `AlgebraicGeometry.Space.exists_chartLift_of_formallySmoothEtaleLocally`: over an affine étale
  neighbourhood `U ⟶ T'` of every point of `T'` there is an affine étale chart square
  `W ⟶ V` of `f` and a morphism `U ⟶ W` which lifts `x` over `U ×_{T'} T` and lies over `y`.
* `AlgebraicGeometry.Space.exists_finite_chartLift_of_formallySmoothEtaleLocally` and
  `AlgebraicGeometry.Space.exists_finite_chartLift_of_isSmooth`: **a finite, jointly
  surjective family of such neighbourhoods**, by quasi-compactness of the affine scheme `T'`.
* `AlgebraicGeometry.Space.existsUnique_map_eq_of_etale_of_jointlySurjective`: **étale descent
  of points of an algebraic space**: sections over a jointly surjective family of étale
  morphisms `U k ⟶ T'` which agree on the pairwise fibre products are the restrictions of a
  unique section over `T'`.

## Implementation notes

The chart-adapted lift is the local lift of
`AlgebraicGeometry.Space.exists_etale_affine_local_lift` (through the étale-local form
`AlgebraicGeometry.Space.FormallySmoothEtaleLocally`) refined by
`AlgebraicGeometry.Space.exists_affine_chartSquare_hom_ofArrows`, applied to the neighbourhood
as an étale chart of the representable presheaf of `T'`. The member of the refining covering
family containing a preimage of the point is located by
`AlgebraicGeometry.Space.SmallEtale.mem_topology_iff_exists_mem_range`.

The lifting condition is stated for every commutative square over `i` and `U ⟶ T'`, not for a
chosen fibre product, exactly as in `AlgebraicGeometry.Space.exists_etale_affine_local_lift`;
the condition over `y` is stated through the chart of `Y`, so that `ℓ ≫ κ` is a factorization of
`y` through it.

The descent statement is the sheaf condition of an algebraic space for the étale topology on the
slice (`AlgebraicGeometry.Space.isSheaf_etaleTopology_over_of_isAlgebraicSpace`) at the covering
sieve generated by the family
(`AlgebraicGeometry.Space.mem_etaleTopology_over_of_etale_of_jointlySurjective`); neither
finiteness of the family nor affineness of `T'` is needed for it.

## References

* [Stacks Project, Tag 04AM](https://stacks.math.columbia.edu/tag/04AM)
* [Stacks Project, Tag 04CY](https://stacks.math.columbia.edu/tag/04CY)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Étale descent of points -/

/-- **Étale descent of points of an algebraic space.** Let `U k ⟶ T'` be a jointly surjective
family of étale morphisms of the big fppf site over `S`, and let `z k ∈ X(U k)` be sections of
an algebraic space which agree on the pairwise fibre products `U k ×_{T'} U l`. Then there is a
unique section of `X` over `T'` restricting to each `z k`. -/
theorem existsUnique_map_eq_of_etale_of_jointlySurjective
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    {T' : BigFppfOver B S hS} {ι : Type u} (U : ι → BigFppfOver B S hS) (j : ∀ k, U k ⟶ T')
    (hjet : ∀ k, Etale ((BigFppfOver.toScheme B S hS).map (j k)))
    (hjsurj : ∀ t' : (BigFppfOver.toScheme B S hS).obj T',
      ∃ (k : ι) (u : (BigFppfOver.toScheme B S hS).obj (U k)),
        ((BigFppfOver.toScheme B S hS).map (j k)).base u = t')
    (z : ∀ k, X.obj (op (U k)))
    (hz : ∀ k l, X.map (pullback.fst (j k) (j l)).op (z k) =
      X.map (pullback.snd (j k) (j l)).op (z l)) :
    ∃! w : X.obj (op T'), ∀ k, X.map (j k).op w = z k := by
  have hcover := mem_etaleTopology_over_of_etale_of_jointlySurjective B S hS
    (fun k : ULift.{u + 1} ι ↦ U k.down) (fun k ↦ j k.down) (fun k ↦ hjet k.down)
    (fun t' ↦ let ⟨k, u, hu⟩ := hjsurj t'; ⟨⟨k⟩, u, hu⟩)
  have hXs : Presieve.IsSheaf ((etaleTopology B).over (B.obj hS)) X :=
    (isSheaf_iff_isSheaf_of_type _ X).mp
      (isSheaf_etaleTopology_over_of_isAlgebraicSpace B S hS hX)
  obtain ⟨w, hw, huniq⟩ := (Presieve.isSheafFor_arrows_iff_pullbacks (P := X)
      (π := fun k : ULift.{u + 1} ι ↦ j k.down)).mp
    ((Presieve.isSheafFor_iff_generate _).2 (hXs _ hcover)) (fun k ↦ z k.down)
    (fun k l ↦ hz k.down l.down)
  exact ⟨w, fun k ↦ hw ⟨k⟩, fun w' hw' ↦ huniq w' fun k ↦ hw' k.down⟩

/-! ### Chart-adapted local lifts -/

/-- **A chart-adapted local lift at a point.** Let `f : X ⟶ Y` be an étale-locally formally
smooth morphism of algebraic spaces, `i : T ⟶ T'` a square-zero closed immersion with `T'`
affine, and `x ∈ X(T)`, `y ∈ Y(T')` with `f x = y|_T`. Every point `t'` of `T'` lies in the
image of an affine étale `j : U ⟶ T'` for which there are affine étale charts `w : W ⟶ X`,
`v : V ⟶ Y`, a morphism `κ : W ⟶ V` with `κ ≫ v = w ≫ f`, and a morphism `ℓ : U ⟶ W` such that
`ℓ ≫ κ` is `y` restricted to `U` and `ℓ` restricts to `x` over every commutative square over `i`
and `j`. -/
theorem exists_chartLift_of_formallySmoothEtaleLocally
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) {f : X ⟶ Y} (hf : FormallySmoothEtaleLocally B S hS f)
    {T T' : BigFppfOver B S hS} (hT' : IsAffine ((BigFppfOver.toScheme B S hS).obj T'))
    (i : T ⟶ T') (hi : IsSquareZeroClosedImmersion B S hS i) (x : X.obj (op T))
    (y : Y.obj (op T')) (hxy : f.app (op T) x = Y.map i.op y)
    (t' : (BigFppfOver.toScheme B S hS).obj T') :
    ∃ (U : BigFppfOver B S hS) (j : U ⟶ T') (W V : BigFppfOver B S hS)
      (w : yoneda.obj W ⟶ X) (v : yoneda.obj V ⟶ Y) (κ : W ⟶ V) (ℓ : U ⟶ W),
      IsAffine ((BigFppfOver.toScheme B S hS).obj U) ∧
      Etale ((BigFppfOver.toScheme B S hS).map j) ∧
      t' ∈ Set.range ((BigFppfOver.toScheme B S hS).map j).base ∧
      IsAffine ((BigFppfOver.toScheme B S hS).obj W) ∧
      IsAffine ((BigFppfOver.toScheme B S hS).obj V) ∧
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf w ∧
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf v ∧
      yoneda.map κ ≫ v = w ≫ f ∧
      v.app (op U) (ℓ ≫ κ) = Y.map j.op y ∧
      ∀ (Z : BigFppfOver B S hS) (p : Z ⟶ T) (q : Z ⟶ U),
        p ≫ i = q ≫ j → X.map p.op x = w.app (op Z) (q ≫ ℓ) := by
  classical
  have hiClosed : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map i) := hi.1
  have hT : IsAffine ((BigFppfOver.toScheme B S hS).obj T) :=
    isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map i)
  obtain ⟨t, rfl⟩ := (Stacks.Thickenings.IsFirstOrderThickening.isThickening
    (i := (BigFppfOver.toScheme B S hS).map i) hi).2 t'
  obtain ⟨U₀, j₀, z, hU₀, hj₀, ⟨u, hu⟩, hzy, hagree⟩ := hf T T' hT hT' i hi x y hxy t
  -- the neighbourhood, as an étale chart of the representable presheaf of `T'`
  let U₀c : SmallEtale B S hS (yoneda.obj T') :=
    ⟨CostructuredArrow.mk (yoneda.map j₀), (presheaf_yoneda_map_etale_iff B S hS j₀).2 hj₀⟩
  obtain ⟨I, Z, r, Wc, Vc, ψ, c, hZaff, hWaff, hVaff, hψ, hc, hcov⟩ :=
    exists_affine_chartSquare_hom_ofArrows B S hS
      (ObjectProperty.homMk f : (⟨X, hX⟩ : AlgebraicSpaces B S hS) ⟶ ⟨Y, hY⟩) U₀c
      (yonedaEquiv.symm z)
  -- the member of the refinement containing a preimage of `u`
  obtain ⟨V₁, g, ⟨_, h, _, ⟨k⟩, rfl⟩, ⟨p, hp⟩⟩ :=
    (SmallEtale.mem_topology_iff_exists_mem_range B S hS _ _).1 hcov u
  let rk : (SmallEtale.toOver B S hS _).obj (Z k) ⟶ U₀ := (SmallEtale.toOver B S hS _).map (r k)
  have hrk : Etale ((BigFppfOver.toScheme B S hS).map rk) :=
    etale_of_etale_charts B S hS (Z k).obj.hom U₀c.obj.hom (Z k).property U₀c.property rk
      (CostructuredArrow.w (r k).hom)
  -- the restriction of `z` to the member is the chart of `X` applied to `c k`
  have hzc : X.map rk.op z = (Wc k).obj.hom.app (op _) (c k) := by
    have := congrArg (fun α ↦ α.app (op ((SmallEtale.toOver B S hS _).obj (Z k))) (𝟙 _)) (hc k)
    simpa [rk] using this
  refine ⟨(SmallEtale.toOver B S hS _).obj (Z k), rk ≫ j₀,
    (SmallEtale.toOver B S hS _).obj (Wc k), (SmallEtale.toOver B S hS _).obj (Vc k),
    (Wc k).obj.hom, (Vc k).obj.hom, ψ k, c k, hZaff k, ?_, ?_, hWaff k, hVaff k,
    (Wc k).property, (Vc k).property, hψ k, ?_, ?_⟩
  · rw [Functor.map_comp]
    infer_instance
  · refine ⟨(BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS _).map h) p, ?_⟩
    rw [← hu, ← hp, Functor.map_comp, Functor.map_comp, Functor.map_comp]
    rfl
  · have e := congrFun (congrArg (fun α ↦ α.app (op ((SmallEtale.toOver B S hS _).obj (Z k))))
      (hψ k)) (c k)
    change (Vc k).obj.hom.app _ (c k ≫ ψ k) = f.app _ ((Wc k).obj.hom.app _ (c k)) at e
    rw [e, ← hzc, NatTrans.naturality_apply, hzy, op_comp, Functor.map_comp_apply]
  · intro Z₀ p₀ q₀ hpq
    rw [hagree Z₀ p₀ (q₀ ≫ rk) (by rw [hpq, Category.assoc]), op_comp,
      Functor.map_comp_apply, hzc]
    exact (NatTrans.naturality_apply (Wc k).obj.hom q₀.op (c k)).symm

/-- **A finite jointly surjective family of chart-adapted local lifts.** Let `f : X ⟶ Y` be an
étale-locally formally smooth morphism of algebraic spaces, `i : T ⟶ T'` a square-zero closed
immersion with `T'` affine, and `x ∈ X(T)`, `y ∈ Y(T')` with `f x = y|_T`. There is a finite,
jointly surjective family of affine étale `j k : U k ⟶ T'`, each with affine étale charts
`w k : W k ⟶ X`, `v k : V k ⟶ Y`, a morphism `κ k : W k ⟶ V k` with `κ k ≫ v k = w k ≫ f`, and a
morphism `ℓ k : U k ⟶ W k` such that `ℓ k ≫ κ k` is `y` restricted to `U k` and `ℓ k`
restricts to `x` over every commutative square over `i` and `j k`.

The family of `AlgebraicGeometry.Space.exists_chartLift_of_formallySmoothEtaleLocally`
indexed by all points of `T'` has open images, because étale morphisms are open, and the affine
scheme `T'` is quasi-compact. -/
theorem exists_finite_chartLift_of_formallySmoothEtaleLocally
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) {f : X ⟶ Y} (hf : FormallySmoothEtaleLocally B S hS f)
    {T T' : BigFppfOver B S hS} (hT' : IsAffine ((BigFppfOver.toScheme B S hS).obj T'))
    (i : T ⟶ T') (hi : IsSquareZeroClosedImmersion B S hS i) (x : X.obj (op T))
    (y : Y.obj (op T')) (hxy : f.app (op T) x = Y.map i.op y) :
    ∃ (ι : Type u) (_ : Finite ι) (U : ι → BigFppfOver B S hS) (j : ∀ k, U k ⟶ T')
      (W V : ι → BigFppfOver B S hS) (w : ∀ k, yoneda.obj (W k) ⟶ X)
      (v : ∀ k, yoneda.obj (V k) ⟶ Y) (κ : ∀ k, W k ⟶ V k) (ℓ : ∀ k, U k ⟶ W k),
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (U k))) ∧
      (∀ k, Etale ((BigFppfOver.toScheme B S hS).map (j k))) ∧
      (∀ t' : (BigFppfOver.toScheme B S hS).obj T',
        ∃ (k : ι) (u : (BigFppfOver.toScheme B S hS).obj (U k)),
          ((BigFppfOver.toScheme B S hS).map (j k)).base u = t') ∧
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (W k))) ∧
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (V k))) ∧
      (∀ k, (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (w k)) ∧
      (∀ k, (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (v k)) ∧
      (∀ k, yoneda.map (κ k) ≫ v k = w k ≫ f) ∧
      (∀ k, (v k).app (op (U k)) (ℓ k ≫ κ k) = Y.map (j k).op y) ∧
      ∀ (k : ι) (Z : BigFppfOver B S hS) (p : Z ⟶ T) (q : Z ⟶ U k),
        p ≫ i = q ≫ j k → X.map p.op x = (w k).app (op Z) (q ≫ ℓ k) := by
  classical
  choose U j W V w v κ ℓ hU hj hpt hW hV hw hv hκ hy hl using
    exists_chartLift_of_formallySmoothEtaleLocally B S hS hX hY hf hT' i hi x y hxy
  have hopen : ∀ t' : (BigFppfOver.toScheme B S hS).obj T',
      IsOpen (Set.range ((BigFppfOver.toScheme B S hS).map (j t')).base) := fun t' ↦ by
    have := hj t'
    exact ((BigFppfOver.toScheme B S hS).map (j t')).isOpenMap.isOpen_range
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover
    (fun t' ↦ Set.range ((BigFppfOver.toScheme B S hS).map (j t')).base) hopen
    (fun t' _ ↦ Set.mem_iUnion.2 ⟨t', hpt t'⟩)
  refine ⟨s, inferInstance, fun k ↦ U k, fun k ↦ j k, fun k ↦ W k, fun k ↦ V k, fun k ↦ w k,
    fun k ↦ v k, fun k ↦ κ k, fun k ↦ ℓ k, fun k ↦ hU k, fun k ↦ hj k, fun t' ↦ ?_,
    fun k ↦ hW k, fun k ↦ hV k, fun k ↦ hw k, fun k ↦ hv k, fun k ↦ hκ k, fun k ↦ hy k,
    fun k ↦ hl k⟩
  obtain ⟨t'', ht'', u, hu⟩ := Set.mem_iUnion₂.1 (hs (Set.mem_univ t'))
  exact ⟨⟨t'', ht''⟩, u, hu⟩

/-- **A finite jointly surjective family of chart-adapted local lifts for a smooth morphism.**
This is `AlgebraicGeometry.Space.exists_finite_chartLift_of_formallySmoothEtaleLocally` for a
smooth morphism of algebraic spaces, which is étale-locally formally smooth by
`AlgebraicGeometry.Space.formallySmoothEtaleLocally_of_isSmooth`. -/
theorem exists_finite_chartLift_of_isSmooth
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) {f : X ⟶ Y} (hf : IsSmooth B S hS f)
    {T T' : BigFppfOver B S hS} (hT' : IsAffine ((BigFppfOver.toScheme B S hS).obj T'))
    (i : T ⟶ T') (hi : IsSquareZeroClosedImmersion B S hS i) (x : X.obj (op T))
    (y : Y.obj (op T')) (hxy : f.app (op T) x = Y.map i.op y) :
    ∃ (ι : Type u) (_ : Finite ι) (U : ι → BigFppfOver B S hS) (j : ∀ k, U k ⟶ T')
      (W V : ι → BigFppfOver B S hS) (w : ∀ k, yoneda.obj (W k) ⟶ X)
      (v : ∀ k, yoneda.obj (V k) ⟶ Y) (κ : ∀ k, W k ⟶ V k) (ℓ : ∀ k, U k ⟶ W k),
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (U k))) ∧
      (∀ k, Etale ((BigFppfOver.toScheme B S hS).map (j k))) ∧
      (∀ t' : (BigFppfOver.toScheme B S hS).obj T',
        ∃ (k : ι) (u : (BigFppfOver.toScheme B S hS).obj (U k)),
          ((BigFppfOver.toScheme B S hS).map (j k)).base u = t') ∧
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (W k))) ∧
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (V k))) ∧
      (∀ k, (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (w k)) ∧
      (∀ k, (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (v k)) ∧
      (∀ k, yoneda.map (κ k) ≫ v k = w k ≫ f) ∧
      (∀ k, (v k).app (op (U k)) (ℓ k ≫ κ k) = Y.map (j k).op y) ∧
      ∀ (k : ι) (Z : BigFppfOver B S hS) (p : Z ⟶ T) (q : Z ⟶ U k),
        p ≫ i = q ≫ j k → X.map p.op x = (w k).app (op Z) (q ≫ ℓ k) :=
  exists_finite_chartLift_of_formallySmoothEtaleLocally B S hS hX hY
    (formallySmoothEtaleLocally_of_isSmooth B S hS hX hY hf) hT' i hi x y hxy

end AlgebraicGeometry.Space

end
