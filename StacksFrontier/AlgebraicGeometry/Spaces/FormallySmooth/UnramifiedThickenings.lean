module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.AffineAtlas
public import StacksFrontier.AlgebraicGeometry.Spaces.FormallySmooth.Defs
public import StacksFrontier.AlgebraicGeometry.Spaces.Glueing.FppfCovering
public import StacksFrontier.AlgebraicGeometry.Spaces.Representability
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.Order

/-!
# Formal unramifiedness tested on thickenings of algebraic spaces

Formal unramifiedness of a morphism of algebraic spaces over `S` is defined by uniqueness of
lifts across square-zero closed immersions of *affine* objects of the big fppf site of `S`
(Stacks 049S, part (3)). The affineness is no restriction: a formally unramified morphism has
at most one lift across an arbitrary first-order thickening `T ⊂ T'` of algebraic spaces over
`S`. This is **Stacks 05ZY**.

The proof is the one of the source. The ambient algebraic space `T'` has a surjective étale
chart whose source is a disjoint union of affine schemes (Stacks 03FX), so `T'` is covered by
affine objects of the site which are étale over it. Over each of them the thickening pulls
back to a square-zero closed immersion of affine objects
(`AlgebraicGeometry.Space.exists_nthOrderThickening_chart_pullback`), where the defining
property applies; the affine pieces form a Zariski covering of the chart, over which the two
lifts therefore agree; and the chart is a locally surjective morphism onto `T'`, hence an
epimorphism of fppf sheaves, so the two lifts agree.

## Main results

* `AlgebraicGeometry.Space.hom_ext_of_openCover_of_isSheaf`: two transformations from a
  representable presheaf to an fppf sheaf which agree on a jointly surjective family of open
  subobjects of the representing object are equal.
* `AlgebraicGeometry.Space.FormallyUnramified.lifts_unique_of_firstOrderThickening`:
  **Stacks 05ZY**.

## Implementation notes

The thickening is presented as a subfunctor `T` of the functor of points of `T'` which is a
first-order thickening in the sense of Stacks 05ZK, part (2), matching
`AlgebraicGeometry.Space.IsFirstOrderThickening`. A dotted arrow is a transformation of
functors of points, which is the same datum as a morphism of algebraic spaces because the
category of algebraic spaces over `S` is full in presheaves; the statement is therefore about
two such transformations and needs no uniqueness clause of its own.

The two reduction steps use the fppf sheaf condition of the target in two different forms: the
Zariski step uses separatedness for the covering sieve generated by the affine pieces of the
chart, and the chart step uses that a locally surjective morphism of sheaves of types is an
epimorphism.

## References

* [Stacks Project, Tag 05ZY](https://stacks.math.columbia.edu/tag/05ZY)
* [Stacks Project, Tag 049S](https://stacks.math.columbia.edu/tag/049S)
* [Stacks Project, Tag 03FX](https://stacks.math.columbia.edu/tag/03FX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Two transformations from a representable presheaf on the big fppf category over `S` to an
fppf sheaf which agree after restriction along the members of a jointly surjective family of
open immersions into the representing object are equal: the family generates a covering sieve
open Stacks.Thickenings
by `AlgebraicGeometry.BigFppfOver.ofArrows_mem_topology_of_isOpenImmersion`, and a sheaf is
separated for a covering sieve. -/
theorem hom_ext_of_openCover_of_isSheaf {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : Presheaf.IsSheaf (BigFppfOver.topology B S hS) F)
    {Z : BigFppfOver B S hS} {K : Type v} {W : K → BigFppfOver B S hS} (p : ∀ k, W k ⟶ Z)
    (hoi : ∀ k, _root_.AlgebraicGeometry.IsOpenImmersion
      ((BigFppfOver.toScheme B S hS).map (p k)))
    (hcov : ∀ x : (BigFppfOver.toScheme B S hS).obj Z,
      ∃ k, x ∈ Set.range ((BigFppfOver.toScheme B S hS).map (p k)))
    {α β : yoneda.obj Z ⟶ F} (h : ∀ k, yoneda.map (p k) ≫ α = yoneda.map (p k) ≫ β) :
    α = β := by
  have hF' : Presieve.IsSheaf (BigFppfOver.topology B S hS) F :=
    (isSheaf_iff_isSheaf_of_type _ _).1 hF
  refine yonedaEquiv.injective
    ((hF' _ (BigFppfOver.ofArrows_mem_topology_of_isOpenImmersion B S hS p hoi
      hcov)).isSeparatedFor.ext ?_)
  rintro T' e ⟨Z', l, e', ⟨k⟩, hcomp⟩
  rw [← hcomp, yonedaEquiv_naturality, yonedaEquiv_naturality, Functor.map_comp,
    Category.assoc, Category.assoc, h k]

/-- A formally unramified morphism of algebraic spaces over `S` has at most one lift of a
solid square over an affine object of the site which is étale over the ambient space of the
thickening: the thickening pulls back to a square-zero closed immersion of affine objects of
the site, where formal unramifiedness applies directly. -/
private theorem comp_eq_of_affine_etale_chart
    {X Y T' : AlgebraicSpaces B S hS} {f : X ⟶ Y} (hf : FormallyUnramified f.hom)
    {T : Subfunctor T'.obj} (hT : IsFirstOrderThickening B S hS T' T)
    {a : T.toFunctor ⟶ X.obj} {b : T'.obj ⟶ Y.obj} (hsq : a ≫ f.hom = T.ι ≫ b)
    {z₁ z₂ : T'.obj ⟶ X.obj}
    (hz₁a : T.ι ≫ z₁ = a) (hz₁b : z₁ ≫ f.hom = b)
    (hz₂a : T.ι ≫ z₂ = a) (hz₂b : z₂ ≫ f.hom = b)
    (V : BigFppfOver B S hS) (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (q : yoneda.obj V ⟶ T'.obj)
    (hq : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf q) :
    q ≫ z₁ = q ≫ z₂ := by
  obtain ⟨V₀, i, p, hpb, hci, hker⟩ :=
    exists_nthOrderThickening_chart_pullback B S hS hT V q hq
  have hV₀ : IsAffine ((BigFppfOver.toScheme B S hS).obj V₀) := by
    have := hci
    have := hV
    exact isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map i)
  have hw : yoneda.map i ≫ q = p ≫ T.ι := hpb.w.symm
  have hrestrict (z : T'.obj ⟶ X.obj) (hza : T.ι ≫ z = a) :
      X.obj.map i.op (yonedaEquiv (q ≫ z)) = yonedaEquiv (p ≫ a) := by
    rw [yonedaEquiv_naturality, ← Category.assoc, hw, Category.assoc, hza]
  have hover (z : T'.obj ⟶ X.obj) (hzb : z ≫ f.hom = b) :
      f.hom.app (op V) (yonedaEquiv (q ≫ z)) = yonedaEquiv (q ≫ b) := by
    rw [← yonedaEquiv_comp, Category.assoc, hzb]
  refine yonedaEquiv.injective
    (hf V₀ V hV₀ hV i ⟨hci, hker⟩ (yonedaEquiv (p ≫ a)) (yonedaEquiv (q ≫ b)) ?_
      (yonedaEquiv (q ≫ z₁)) (yonedaEquiv (q ≫ z₂))
      ⟨hrestrict z₁ hz₁a, hover z₁ hz₁b⟩ ⟨hrestrict z₂ hz₂a, hover z₂ hz₂b⟩)
  rw [← yonedaEquiv_comp, yonedaEquiv_naturality, Category.assoc, hsq, ← Category.assoc,
    ← hw, Category.assoc]

/-- **Stacks 05ZY.** A formally unramified morphism `f : X ⟶ Y` of algebraic spaces over `S`
admits at most one dotted arrow in a solid square over a first-order thickening `T ⊂ T'` of
algebraic spaces over `S`. In other words the affineness of the test objects in the definition
of formal unramifiedness, Stacks 049S part (3), may be dropped. -/
@[stacks 05ZY]
theorem FormallyUnramified.lifts_unique_of_firstOrderThickening
    {X Y T' : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hf : FormallyUnramified f.hom)
    (T : Subfunctor T'.obj) (hT : IsFirstOrderThickening B S hS T' T)
    (a : T.toFunctor ⟶ X.obj) (b : T'.obj ⟶ Y.obj) (hsq : a ≫ f.hom = T.ι ≫ b)
    (z₁ z₂ : T'.obj ⟶ X.obj)
    (hz₁a : T.ι ≫ z₁ = a) (hz₁b : z₁ ≫ f.hom = b)
    (hz₂a : T.ι ≫ z₂ = a) (hz₂b : z₂ ≫ f.hom = b) :
    z₁ = z₂ := by
  classical
  obtain ⟨U, q, I, W, j, e, hqS, hqE, hWaff, hje, hjoi, hjetale, -⟩ :=
    IsAlgebraicSpace.exists_affine_coproduct_atlas B S hS T'.obj T'.property
  -- Over each affine piece of the chart the two lifts agree.
  have haffine (i : I) : yoneda.map (j i) ≫ q ≫ z₁ = yoneda.map (j i) ≫ q ≫ z₂ := by
    simpa [Category.assoc] using comp_eq_of_affine_etale_chart B S hS hf hT hsq hz₁a hz₁b
      hz₂a hz₂b (W i) (hWaff i) (yoneda.map (j i) ≫ q) (hjetale i)
  -- The affine pieces cover the chart, so the two lifts agree over it.
  have hcov (x : (BigFppfOver.toScheme B S hS).obj U) :
      ∃ i, x ∈ Set.range ((BigFppfOver.toScheme B S hS).map (j i)) := by
    obtain ⟨⟨i, y⟩, hy⟩ := (AlgebraicGeometry.sigmaMk
      (fun i ↦ (BigFppfOver.toScheme B S hS).obj (W i))).surjective (e.inv.base x)
    refine ⟨i, y, ?_⟩
    rw [← hje i, Scheme.Hom.comp_apply]
    have : (Sigma.ι (fun i ↦ (BigFppfOver.toScheme B S hS).obj (W i)) i).base y =
        e.inv.base x := by
      rw [← hy]
      simp
    rw [this, ← Scheme.Hom.comp_apply, e.inv_hom_id]
    simp
  -- The chart is an epimorphism of fppf sheaves.
  let Usheaf : Sheaf (BigFppfOver.topology B S hS) (Type u) :=
    ⟨yoneda.obj U, BigFppfOver.isSheaf_yoneda_obj B S hS U⟩
  let T'sheaf : Sheaf (BigFppfOver.topology B S hS) (Type u) := ⟨T'.obj, T'.property.isSheaf⟩
  let Xsheaf : Sheaf (BigFppfOver.topology B S hS) (Type u) := ⟨X.obj, X.property.isSheaf⟩
  let φ : Usheaf ⟶ T'sheaf := ObjectProperty.homMk q
  have hφls : Sheaf.IsLocallySurjective φ :=
    isLocallySurjective_of_surjective_etale B S hS q hqS hqE
  have : Epi φ := inferInstance
  exact Sheaf.hom_ext_iff.1 ((cancel_epi φ).1
    (Sheaf.hom_ext
      (hom_ext_of_openCover_of_isSheaf B S hS X.property.isSheaf j hjoi hcov haffine) :
      φ ≫ (ObjectProperty.homMk z₁ : T'sheaf ⟶ Xsheaf) = φ ≫ ObjectProperty.homMk z₂))

end AlgebraicGeometry.Space

end
