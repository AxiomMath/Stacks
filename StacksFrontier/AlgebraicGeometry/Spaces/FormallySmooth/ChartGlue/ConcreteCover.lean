module

public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import StacksFrontier.AlgebraicGeometry.Spaces.FormallySmooth.ChartGlue.FrameDescentCocycle

/-!
# The Čech cover of a square-zero thickening of rings by an algebra

Let `A' → A` be a surjection of commutative rings with square-zero kernel and let `B'` be an
`A'`-algebra. Put `B = A ⊗[A'] B'`. This file constructs the maps of the Čech diagram

```
B' ⇉ B' ⊗[A'] B' ⇶ B' ⊗[A'] (B' ⊗[A'] B')
↓        ↓                 ↓
B  ⇉ B ⊗[A] B   ⇶ B ⊗[A] (B ⊗[A] B)
```

and proves that the vertical maps are surjective with square-zero kernels, and that the squares
commute. Square-zero kernels are obtained by factoring each vertical map back through the base
change `N → A ⊗[A'] N`, whose kernel is generated by the kernel of `A' → A`
(`Algebra.TensorProduct.rTensor_ker`).

## Main results

* `Stacks.ChartGlue.Concrete.ker_bc_sq`: the kernel of `N → A ⊗[A'] N` has square
  zero.
* `Stacks.ChartGlue.Concrete.π₂_surjective`, `Stacks.ChartGlue.Concrete.ker_π₂_sq` and the same
  for `π₃`.
-/

@[expose] public noncomputable section

open TensorProduct

universe u

namespace Stacks.ChartGlue

namespace Concrete

variable (A' A : Type u) [CommRing A'] [CommRing A] [Algebra A' A]
  (hA : Function.Surjective (algebraMap A' A))
  (hI : RingHom.ker (algebraMap A' A) ^ 2 = ⊥)

section BaseChange

variable (N : Type u) [CommRing N] [Algebra A' N]

/-- The base change `N → A ⊗[A'] N`. -/
abbrev bc : N →ₐ[A'] A ⊗[A'] N := Algebra.TensorProduct.includeRight

include hA in
/-- `N → A ⊗[A'] N` is surjective. -/
lemma bc_surjective : Function.Surjective (bc A' A N) := by
  intro x
  rw [← AlgHom.mem_range]
  induction x using TensorProduct.inductionOn with
  | tmul a n =>
    obtain ⟨a', rfl⟩ := hA a
    refine ⟨a' • n, ?_⟩
    change (1 : A) ⊗ₜ[A'] (a' • n) = _
    rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
  | add x y hx hy => exact add_mem hx hy

include hA hI in
/-- **The kernel of `N → A ⊗[A'] N` has square zero.** -/
lemma ker_bc_sq : RingHom.ker (bc A' A N) ^ 2 = ⊥ := by
  let f : A' →ₐ[A'] A := Algebra.ofId A' A
  have hk : RingHom.ker (Algebra.TensorProduct.map f (AlgHom.id A' N)) =
      (RingHom.ker f).map (Algebra.TensorProduct.includeLeft : A' →ₐ[A'] A' ⊗[A'] N) :=
    Algebra.TensorProduct.rTensor_ker f hA
  let e := Algebra.TensorProduct.lid A' N
  have hfac : ∀ n : N, bc A' A N n = Algebra.TensorProduct.map f (AlgHom.id A' N) (e.symm n) := by
    intro n
    simp [e, f]
  have hsq : RingHom.ker (Algebra.TensorProduct.map f (AlgHom.id A' N)) ^ 2 = ⊥ := by
    rw [hk, ← Ideal.map_pow, show RingHom.ker f = RingHom.ker (algebraMap A' A) from rfl, hI,
      Ideal.map_bot]
  rw [pow_two, eq_bot_iff, Ideal.mul_le]
  intro x hx y hy
  rw [Ideal.mem_bot]
  have hmem : ∀ z ∈ RingHom.ker (bc A' A N),
      e.symm z ∈ RingHom.ker (Algebra.TensorProduct.map f (AlgHom.id A' N)) := fun z hz ↦ by
    rwa [RingHom.mem_ker, ← hfac]
  have : e.symm x * e.symm y = 0 := by
    rw [← Ideal.mem_bot, ← hsq, pow_two]
    exact Ideal.mul_mem_mul (hmem x hx) (hmem y hy)
  rw [← map_mul] at this
  exact e.symm.injective (this.trans (map_zero _).symm)

end BaseChange

include hA hI in
/-- A map out of `N` which `N → A ⊗[A'] N` factors through has square-zero kernel. -/
lemma ker_sq_of_factor {N C : Type u} [CommRing N] [Algebra A' N] [CommRing C] [Algebra A' C]
    (π : N →ₐ[A'] C) (φ : C →ₐ[A'] A ⊗[A'] N) (h : φ.comp π = bc A' A N) :
    RingHom.ker π ^ 2 = ⊥ := by
  refine eq_bot_iff.2 ((Ideal.pow_right_mono (fun x hx ↦ ?_) 2).trans (ker_bc_sq A' A hA hI N).le)
  rw [RingHom.mem_ker] at hx ⊢
  rw [← h, AlgHom.comp_apply, show (π : N → C) x = 0 from hx, map_zero]

variable (B' : Type u) [CommRing B'] [Algebra A' B']

/-- The reduction `B = A ⊗[A'] B'`. -/
abbrev Bb := A ⊗[A'] B'

/-- `π₁ : B' → B`. -/
abbrev π₁ : B' →ₐ[A'] Bb A' A B' := bc A' A B'

/-- The first inclusion `B → B ⊗[A] B`, as an `A'`-algebra map. -/
abbrev i₁ : Bb A' A B' →ₐ[A'] Bb A' A B' ⊗[A] Bb A' A B' :=
  FrameDescent.q₁ (A' := A') A (Bb A' A B')

/-- The second inclusion `B → B ⊗[A] B`, as an `A'`-algebra map. -/
abbrev i₂ : Bb A' A B' →ₐ[A'] Bb A' A B' ⊗[A] Bb A' A B' :=
  FrameDescent.q₂ (A' := A') A (Bb A' A B')

/-- `π₂ : B' ⊗[A'] B' → B ⊗[A] B`. -/
def π₂ : B' ⊗[A'] B' →ₐ[A'] Bb A' A B' ⊗[A] Bb A' A B' :=
  Algebra.TensorProduct.lift ((i₁ A' A B').comp (π₁ A' A B')) ((i₂ A' A B').comp (π₁ A' A B'))
    (fun _ _ ↦ Commute.all _ _)

/-- `π₂` sends `b ⊗ c` to `π₁ b ⊗ π₁ c`. -/
@[simp] lemma π₂_tmul (b c : B') :
    π₂ A' A B' (b ⊗ₜ c) = (π₁ A' A B' b) ⊗ₜ[A] (π₁ A' A B' c) := by
  simp [π₂, Algebra.TensorProduct.tmul_mul_tmul]

/-- The factorization of `π₂` back to the base change of `B' ⊗[A'] B'`. -/
def φ₂ : Bb A' A B' ⊗[A] Bb A' A B' →ₐ[A'] A ⊗[A'] (B' ⊗[A'] B') :=
  (Algebra.TensorProduct.lift
    (Algebra.TensorProduct.map (AlgHom.id A A) Algebra.TensorProduct.includeLeft)
    (Algebra.TensorProduct.map (AlgHom.id A A) Algebra.TensorProduct.includeRight)
    (fun _ _ ↦ Commute.all _ _)).restrictScalars A'

/-- `π₂` followed by `φ₂` is the base change `B' ⊗[A'] B' → A ⊗[A'] (B' ⊗[A'] B')`. -/
lemma φ₂_comp_π₂ : (φ₂ A' A B').comp (π₂ A' A B') = bc A' A (B' ⊗[A'] B') := by
  ext b <;> simp [φ₂, π₂_tmul]

include hA in
/-- `π₂` is surjective. -/
lemma π₂_surjective : Function.Surjective (π₂ A' A B') := by
  intro x
  rw [← AlgHom.mem_range]
  induction x using TensorProduct.inductionOn with
  | tmul b c =>
    obtain ⟨b', rfl⟩ := bc_surjective A' A hA B' b
    obtain ⟨c', rfl⟩ := bc_surjective A' A hA B' c
    exact ⟨b' ⊗ₜ c', π₂_tmul A' A B' b' c'⟩
  | add x y hx hy => exact add_mem hx hy

include hA hI in
/-- The kernel of `π₂` has square zero. -/
lemma ker_π₂_sq : RingHom.ker (π₂ A' A B') ^ 2 = ⊥ :=
  ker_sq_of_factor A' A hA hI _ _ (φ₂_comp_π₂ A' A B')

/-- `π₃ : B' ⊗[A'] (B' ⊗[A'] B') → B ⊗[A] (B ⊗[A] B)`. -/
def π₃ : B' ⊗[A'] (B' ⊗[A'] B') →ₐ[A']
    Bb A' A B' ⊗[A] (Bb A' A B' ⊗[A] Bb A' A B') :=
  Algebra.TensorProduct.lift
    (((Algebra.TensorProduct.includeLeft : Bb A' A B' →ₐ[A]
      Bb A' A B' ⊗[A] (Bb A' A B' ⊗[A] Bb A' A B')).restrictScalars A').comp (π₁ A' A B'))
    ((FrameDescent.e₂₃ₐ (A' := A') A (Bb A' A B')).comp (π₂ A' A B'))
    (fun _ _ ↦ Commute.all _ _)

/-- `π₃` sends `b ⊗ y` to `π₁ b ⊗ π₂ y`. -/
private lemma π₃_tmul_π₂ (b : B') (y : B' ⊗[A'] B') :
    π₃ A' A B' (b ⊗ₜ y) = (π₁ A' A B' b) ⊗ₜ[A] (π₂ A' A B' y) := by
  simp [π₃, Algebra.TensorProduct.tmul_mul_tmul]

/-- `π₃` sends `b ⊗ (c ⊗ d)` to `π₁ b ⊗ (π₁ c ⊗ π₁ d)`. -/
@[simp] lemma π₃_tmul (b c d : B') :
    π₃ A' A B' (b ⊗ₜ (c ⊗ₜ d)) = (π₁ A' A B' b) ⊗ₜ[A] ((π₁ A' A B' c) ⊗ₜ[A] (π₁ A' A B' d)) := by
  simp [π₃, Algebra.TensorProduct.tmul_mul_tmul]

/-- The factorization of `π₃` back to the base change. -/
def φ₃ : Bb A' A B' ⊗[A] (Bb A' A B' ⊗[A] Bb A' A B') →ₐ[A']
    A ⊗[A'] (B' ⊗[A'] (B' ⊗[A'] B')) :=
  (Algebra.TensorProduct.lift
    (Algebra.TensorProduct.map (AlgHom.id A A) Algebra.TensorProduct.includeLeft)
    (Algebra.TensorProduct.lift
      (Algebra.TensorProduct.map (AlgHom.id A A)
        ((Algebra.TensorProduct.includeRight : B' ⊗[A'] B' →ₐ[A'] B' ⊗[A'] (B' ⊗[A'] B')).comp
          Algebra.TensorProduct.includeLeft))
      (Algebra.TensorProduct.map (AlgHom.id A A)
        ((Algebra.TensorProduct.includeRight : B' ⊗[A'] B' →ₐ[A'] B' ⊗[A'] (B' ⊗[A'] B')).comp
          Algebra.TensorProduct.includeRight))
      (fun _ _ ↦ Commute.all _ _))
    (fun _ _ ↦ Commute.all _ _)).restrictScalars A'

/-- `π₃` followed by `φ₃` is the base change of `B' ⊗[A'] (B' ⊗[A'] B')`. -/
lemma φ₃_comp_π₃ : (φ₃ A' A B').comp (π₃ A' A B') = bc A' A (B' ⊗[A'] (B' ⊗[A'] B')) := by
  ext b
  · simp [φ₃, π₃, ← Algebra.TensorProduct.one_def]
  · simp [φ₃, π₃, π₂, ← Algebra.TensorProduct.one_def]
  · simp [φ₃, π₃, π₂, ← Algebra.TensorProduct.one_def]

include hA in
/-- `π₃` is surjective. -/
lemma π₃_surjective : Function.Surjective (π₃ A' A B') := by
  intro x
  rw [← AlgHom.mem_range]
  induction x using TensorProduct.inductionOn with
  | tmul b y =>
    obtain ⟨b', rfl⟩ := bc_surjective A' A hA B' b
    obtain ⟨y', rfl⟩ := π₂_surjective A' A hA B' y
    exact ⟨b' ⊗ₜ y', π₃_tmul_π₂ A' A B' b' y'⟩
  | add x y hx hy => exact add_mem hx hy

include hA hI in
/-- The kernel of `π₃` has square zero. -/
lemma ker_π₃_sq : RingHom.ker (π₃ A' A B') ^ 2 = ⊥ :=
  ker_sq_of_factor A' A hA hI _ _ (φ₃_comp_π₃ A' A B')

/-! ### The face maps and the commuting squares -/

/-- `p₁ : B' → B' ⊗ B'`. -/
abbrev p₁ : B' →ₐ[A'] B' ⊗[A'] B' := Algebra.TensorProduct.includeLeft
/-- `p₂ : B' → B' ⊗ B'`. -/
abbrev p₂ : B' →ₐ[A'] B' ⊗[A'] B' := Algebra.TensorProduct.includeRight
/-- `q₁₂ : B' ⊗ B' → B' ⊗ (B' ⊗ B')`, `x ⊗ y ↦ x ⊗ (y ⊗ 1)`. -/
abbrev q₁₂ : B' ⊗[A'] B' →ₐ[A'] B' ⊗[A'] (B' ⊗[A'] B') :=
  Algebra.TensorProduct.map (AlgHom.id A' B') Algebra.TensorProduct.includeLeft
/-- `q₂₃ : B' ⊗ B' → B' ⊗ (B' ⊗ B')`, `x ⊗ y ↦ 1 ⊗ (x ⊗ y)`. -/
abbrev q₂₃ : B' ⊗[A'] B' →ₐ[A'] B' ⊗[A'] (B' ⊗[A'] B') := Algebra.TensorProduct.includeRight
/-- `q₁₃ : B' ⊗ B' → B' ⊗ (B' ⊗ B')`, `x ⊗ y ↦ x ⊗ (1 ⊗ y)`. -/
abbrev q₁₃ : B' ⊗[A'] B' →ₐ[A'] B' ⊗[A'] (B' ⊗[A'] B') :=
  Algebra.TensorProduct.map (AlgHom.id A' B') Algebra.TensorProduct.includeRight

/-- The square formed by `p₁`, `π₁`, `π₂` and `i₁` commutes. -/
lemma p₁_π : (π₂ A' A B').comp (p₁ A' B') = (i₁ A' A B').comp (π₁ A' A B') := by
  ext b; simp [π₂_tmul, ← Algebra.TensorProduct.one_def]
/-- The square formed by `p₂`, `π₁`, `π₂` and `i₂` commutes. -/
lemma p₂_π : (π₂ A' A B').comp (p₂ A' B') = (i₂ A' A B').comp (π₁ A' A B') := by
  ext b; simp [π₂_tmul, ← Algebra.TensorProduct.one_def]
/-- The square formed by `q₁₂`, `π₂`, `π₃` and `e₁₂` commutes. -/
lemma q₁₂_π : (π₃ A' A B').comp (q₁₂ A' B') =
    (FrameDescent.e₁₂ₐ (A' := A') A (Bb A' A B')).comp (π₂ A' A B') := by
  ext b
  · simp [π₃, π₂_tmul, ← Algebra.TensorProduct.one_def]
  · simp [π₃_tmul, π₂_tmul, ← Algebra.TensorProduct.one_def]
/-- The square formed by `q₂₃`, `π₂`, `π₃` and `e₂₃` commutes. -/
lemma q₂₃_π : (π₃ A' A B').comp (q₂₃ A' B') =
    (FrameDescent.e₂₃ₐ (A' := A') A (Bb A' A B')).comp (π₂ A' A B') := by
  ext b <;> simp [π₃_tmul, π₂_tmul, ← Algebra.TensorProduct.one_def]
/-- The square formed by `q₁₃`, `π₂`, `π₃` and `e₁₃` commutes. -/
lemma q₁₃_π : (π₃ A' A B').comp (q₁₃ A' B') =
    (FrameDescent.e₁₃ₐ (A' := A') A (Bb A' A B')).comp (π₂ A' A B') := by
  ext b
  · simp [π₃, π₂_tmul, ← Algebra.TensorProduct.one_def]
  · simp [π₃_tmul, π₂_tmul, ← Algebra.TensorProduct.one_def]
/-- The cosimplicial identity `q₁₂ ∘ p₁ = q₁₃ ∘ p₁`. -/
lemma p₁_q₁₂ : (q₁₂ A' B').comp (p₁ A' B') = (q₁₃ A' B').comp (p₁ A' B') := by
  ext b; simp
/-- The cosimplicial identity `q₁₂ ∘ p₂ = q₂₃ ∘ p₁`. -/
lemma p₂_q₁₂ : (q₁₂ A' B').comp (p₂ A' B') = (q₂₃ A' B').comp (p₁ A' B') := by
  ext b; simp
/-- The cosimplicial identity `q₂₃ ∘ p₂ = q₁₃ ∘ p₂`. -/
lemma p₂_q₂₃ : (q₂₃ A' B').comp (p₂ A' B') = (q₁₃ A' B').comp (p₂ A' B') := by
  ext b; simp

end Concrete

end Stacks.ChartGlue

end
