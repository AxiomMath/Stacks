/-!
# Formal unramifiedness of a morphism of affine objects of the site

Let `ψ : P ⟶ Q` be a morphism of the big fppf site over `S` between affine objects whose
transformation `yoneda.map ψ` of representable presheaves is formally unramified. Then the ring
map `Γ(Q, ⊤) ⟶ Γ(P, ⊤)` underlying `ψ` is formally unramified, which is the affine case of the
morphism of schemes underlying `ψ` being formally unramified in the sense of Tag 02H8. This file
proves that step, together with the lemmas it is built from.

## Main results

* `AlgebraicGeometry.Space.eq_of_formallyUnramified_yonedaMap`: the scheme-level uniqueness of
  lifts against a first-order thickening between affine objects of the site, when `yoneda.map ψ`
  is formally unramified.
* `AlgebraicGeometry.Space.specMap_isFirstOrderThickening`: the spectrum of a surjective ring
  map with square-zero kernel is a first-order thickening of affine schemes.
* `AlgebraicGeometry.Space.cotangentSquareQuotient_cardinal_le`: the cardinality estimate that
  puts the first-order neighbourhood of the diagonal inside the chosen site.
* `AlgebraicGeometry.Space.algHom_eq_of_specMap_comp_eq`: faithfulness of `Spec` on algebra
  maps, in the form the uniqueness argument uses.

## Implementation notes

The step from the site to schemes is the whole content. Formal unramifiedness of a morphism of
schemes is tested on affine charts of source and target, so it suffices to treat a morphism of
*affine* objects of the site, where it becomes the vanishing of the module of relative
differentials of the corresponding ring map. Vanishing is detected by uniqueness of a section
of the first-order neighbourhood `(A ⊗_R A)/J²` of the diagonal, through
`KaehlerDifferential.endEquiv`: a section of that quotient is the same datum as an
endomorphism of `Ω_{A/R}`, so uniqueness of sections forces the identity endomorphism to
vanish and hence the module to vanish.

The lifting problem exhibiting such a section lives in the chosen big fppf site, so the two
affine schemes `Spec A` and `Spec ((A ⊗_R A)/J²)` must belong to it. That is a cardinality
estimate: `A` and `R` are section rings of objects of the site, so their cardinalities are
below the cutoff, and `(A ⊗_R A)/J²` is a quotient of a tensor product generated by the pure
tensors, hence a quotient of a free module on `A × A`, which keeps it below the cutoff too.
`AlgebraicGeometry.Space.cotangentSquareQuotient_cardinal_le` records that estimate. The two
spectra are then objects of the site, the diagonal square-zero immersion is a morphism of the
site, and the hypothesis applies to it.

No chart-level statement of Tag 04G8 is proved here, so the tag is not attached to anything
in this file. The implication from the algebraic-space side to the chart side is
`AlgebraicGeometry.Space.holdsOnEveryEtaleChart_of_formallyUnramified`; the converse needs the
descent half of Tag 04CY, that a formally unramified composite `a ≫ b` with `a` representable,
surjective and étale has `b` formally unramified, which is
`AlgebraicGeometry.Space.formallyUnramified_of_comp_of_isSeparated`. The equivalences of
Tag 04G8 are `AlgebraicGeometry.Space.formallyUnramified_iff_etaleCharts` and
`AlgebraicGeometry.Space.formallyUnramified_iff_surjectiveEtaleChart`.

## References

* [Stacks Project, Tag 04G8](https://stacks.math.columbia.edu/tag/04G8)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open Algebra
open scoped TensorProduct

universe u

namespace AlgebraicGeometry.Space


private abbrev CotangentSections (R A : Type u) [CommRing R] [CommRing A]
    [Algebra R A] :=
  {g : A →ₐ[R] (A ⊗[R] A) ⧸ (KaehlerDifferential.ideal R A) ^ 2 //
    (Algebra.TensorProduct.lmul' R (S := A)).kerSquareLift.comp g = AlgHom.id R A}


private theorem algebraFormallyUnramified_of_uniqueCotangentSection
    (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]
    (c : CotangentSections R A)
    (hunique : ∀ s : CotangentSections R A, s.val = c.val) :
    Algebra.FormallyUnramified R A := by
  let E := KaehlerDifferential.endEquiv R A
  let : Subsingleton (Module.End A Ω[A⁄R]) := ⟨fun f g =>
    E.injective (Subtype.ext ((hunique (E f)).trans (hunique (E g)).symm))⟩
  have hid : (LinearMap.id : Ω[A⁄R] →ₗ[A] Ω[A⁄R]) = 0 := Subsingleton.elim _ _
  have hzero : ∀ x : Ω[A⁄R], x = 0 := by
    intro x
    simpa using congrArg (fun f : Ω[A⁄R] →ₗ[A] Ω[A⁄R] => f x) hid
  exact ⟨⟨fun x y => (hzero x).trans (hzero y).symm⟩⟩




private noncomputable def canonicalCotangentSection
    (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] : CotangentSections R A :=
  KaehlerDifferential.endEquiv R A LinearMap.id


/-- The first-order neighbourhood `(A ⊗[R] A)/J²` of the diagonal of an `R`-algebra `A` has
cardinality at most that of `A`, `R` and `ℵ₀`: the tensor product is spanned by the pure
tensors, so it is a quotient of the free `R`-module on `A × A`. -/
theorem cotangentSquareQuotient_cardinal_le
    (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] :
    Cardinal.mk (A ⊗[R] A ⧸ (KaehlerDifferential.ideal R A) ^ 2) ≤
      max (max (Cardinal.mk A) (Cardinal.mk R)) Cardinal.aleph0 := by
  classical
  let I := A × A
  let g : I → A ⊗[R] A := fun p => p.1 ⊗ₜ[R] p.2
  have hset : Set.range g = {t | ∃ a b, a ⊗ₜ[R] b = t} := by
    ext t
    simp only [Set.mem_range, Set.mem_ofPred_eq, Prod.exists, I, g]
  have hspan : Submodule.span R (Set.range g) = ⊤ := by
    rw [hset, TensorProduct.span_tmul_eq_top]
  have hsurj : Function.Surjective (Finsupp.linearCombination R g) := by
    rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination, hspan]
  let K := max (max (Cardinal.mk A) (Cardinal.mk R)) Cardinal.aleph0
  have hR : Cardinal.mk R ≤ K := (le_max_right _ _).trans (le_max_left _ _)
  have hAleph : Cardinal.aleph0 ≤ K := le_max_right _ _
  have hI : Cardinal.mk I ≤ K := by
    dsimp [I, K]
    rw [Cardinal.mk_prod]
    simpa only [Cardinal.lift_id] using
      (Cardinal.mul_le_max (Cardinal.mk A) (Cardinal.mk A)).trans <| by
        apply max_le
        · apply max_le
          · exact (le_max_left _ _).trans (le_max_left _ _)
          · exact (le_max_left _ _).trans (le_max_left _ _)
        · exact le_max_right _ _
  have hfs : Cardinal.mk (I →₀ R) ≤ K := by
    calc
      Cardinal.mk (I →₀ R) ≤ Cardinal.mk (Finset (I × R)) :=
        Cardinal.mk_le_of_injective (Finsupp.graph_injective I R)
      _ ≤ K := by
        by_cases hInf : Infinite (I × R)
        · rw [Cardinal.mk_finset_of_infinite, Cardinal.mk_prod]
          simpa only [Cardinal.lift_id] using
            (Cardinal.mul_le_max (Cardinal.mk I) (Cardinal.mk R)).trans <| by
              apply max_le
              · exact max_le hI hR
              · exact hAleph
        · have : Finite (I × R) := Finite.of_not_infinite hInf
          exact (Cardinal.mk_le_aleph0 (α := Finset (I × R))).trans (le_max_right _ _)
  exact Cardinal.mk_quotient_le.trans ((Cardinal.mk_le_of_surjective hsurj).trans hfs)


/-- The spectrum of a surjective ring map with square-zero kernel is a first-order thickening
of schemes: the kernel ideal sheaf of the induced closed immersion of affine schemes is the
comap of the kernel ideal along the canonical isomorphism of global sections. -/
lemma specMap_isFirstOrderThickening {R T : CommRingCat.{u}} (φ : R ⟶ T)
    (hsurj : Function.Surjective φ) (hker : RingHom.ker φ.hom ^ 2 = ⊥) :
    Stacks.Thickenings.IsFirstOrderThickening (Spec.map φ) := by
  refine ⟨IsClosedImmersion.spec_of_surjective φ hsurj, ?_⟩
  apply Scheme.IdealSheafData.ext_of_isAffine
  have hkerApp : RingHom.ker (Spec.map φ).appTop.hom =
      (RingHom.ker φ.hom).comap (Scheme.ΓSpecIso R).hom.hom := by
    ext x
    simp only [RingHom.mem_ker, Ideal.mem_comap]
    have hn := congrArg (fun k : CommRingCat.Hom _ _ => k.hom x)
      (AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ)
    change (Scheme.ΓSpecIso T).hom.hom ((Spec.map φ).appTop.hom x) =
      φ.hom ((Scheme.ΓSpecIso R).hom.hom x) at hn
    refine ⟨fun hx => by rw [← hn, hx]; simp, fun hx => ?_⟩
    apply (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso T).hom).1
    rw [hn, hx]
    simp
  have hcomapBot : (⊥ : Ideal R).comap (Scheme.ΓSpecIso R).hom.hom = ⊥ := by
    show RingHom.ker (Scheme.ΓSpecIso R).hom.hom = ⊥
    rw [← RingHom.injective_iff_ker_eq_bot]
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).hom).1
  have htop : RingHom.ker (Spec.map φ).appTop.hom ^ 2 = ⊥ := by
    rw [hkerApp]
    refine le_antisymm ?_ bot_le
    have hle := Ideal.le_comap_pow (K := RingHom.ker φ.hom)
      (f := (Scheme.ΓSpecIso R).hom.hom) 2
    rw [hker, hcomapBot] at hle
    exact hle
  simpa [AlgebraicGeometry.Scheme.ker_of_isAffine] using htop

/-- Two algebra maps out of `A` agree as soon as the two morphisms they induce on `Spec A`
agree after composition with a fixed monomorphism: `Spec` is faithful. -/
lemma algHom_eq_of_specMap_comp_eq {R A C : Type u} [CommRing R] [CommRing A]
    [CommRing C] [Algebra R A] [Algebra R C] {P₀ : Scheme.{u}}
    (eP : Spec (CommRingCat.of A) ≅ P₀) {g₁ g₂ : A →ₐ[R] C}
    (h : Spec.map (CommRingCat.ofHom g₁.toRingHom) ≫ eP.hom =
      Spec.map (CommRingCat.ofHom g₂.toRingHom) ≫ eP.hom) :
    g₁ = g₂ := by
  have hRing : CommRingCat.ofHom g₁.toRingHom = CommRingCat.ofHom g₂.toRingHom :=
    congrArg Opposite.unop (Scheme.Spec.map_injective ((cancel_mono eP.hom).1 h))
  exact AlgHom.ext fun a =>
    congrArg (fun f : A →+* C => f a) (congrArg CommRingCat.Hom.hom hRing)

/-- A morphism `ψ` of the big fppf site over `S` whose induced transformation of representable
presheaves is formally unramified admits at most one lift of schemes against a first-order
thickening between affine objects of the site: the two candidate lifts are morphisms of the
site over `S`, so the uniqueness clause applies to them. -/
lemma eq_of_formallyUnramified_yonedaMap
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {P Q : BigFppfOver B S hS} (ψ : P ⟶ Q)
    (hψ : FormallyUnramified (yoneda.map ψ))
    {A₀ C₀ : B.Schemes}
    (hA₀ : IsAffine (B.inclusion.obj A₀)) (hC₀ : IsAffine (B.inclusion.obj C₀))
    (x₀ : B.inclusion.obj A₀ ⟶ B.inclusion.obj P.left)
    (y₀ : B.inclusion.obj C₀ ⟶ B.inclusion.obj Q.left)
    (i₀ : B.inclusion.obj A₀ ⟶ B.inclusion.obj C₀)
    (hi₀ : Stacks.Thickenings.IsFirstOrderThickening i₀)
    (z₁ z₂ : B.inclusion.obj C₀ ⟶ B.inclusion.obj P.left)
    (hiy : i₀ ≫ y₀ = x₀ ≫ B.inclusion.map ψ.left)
    (hz₁i : i₀ ≫ z₁ = x₀) (hz₁ψ : z₁ ≫ B.inclusion.map ψ.left = y₀)
    (hz₂i : i₀ ≫ z₂ = x₀) (hz₂ψ : z₂ ≫ B.inclusion.map ψ.left = y₀) :
    z₁ = z₂ := by
  have htop : B.inclusion.map ψ.left ≫ B.inclusion.map Q.hom = B.inclusion.map P.hom := by
    rw [← Functor.map_comp]
    exact congrArg B.inclusion.map (Over.w ψ)
  let xLeft : A₀ ⟶ P.left := B.inclusion.preimage x₀
  let yLeft : C₀ ⟶ Q.left := B.inclusion.preimage y₀
  let iLeft : A₀ ⟶ C₀ := B.inclusion.preimage i₀
  have hMapX : B.inclusion.map xLeft = x₀ := B.inclusion.map_preimage _
  have hMapY : B.inclusion.map yLeft = y₀ := B.inclusion.map_preimage _
  have hMapI : B.inclusion.map iLeft = i₀ := B.inclusion.map_preimage _
  let aBase : A₀ ⟶ B.obj hS := xLeft ≫ P.hom
  let cBase : C₀ ⟶ B.obj hS := yLeft ≫ Q.hom
  have hMapABase : B.inclusion.map aBase = x₀ ≫ B.inclusion.map P.hom := by
    rw [Functor.map_comp, hMapX]
  have hMapCBase : B.inclusion.map cBase = y₀ ≫ B.inclusion.map Q.hom := by
    rw [Functor.map_comp, hMapY]
  let T : BigFppfOver B S hS := Over.mk aBase
  let T' : BigFppfOver B S hS := Over.mk cBase
  let xB : T ⟶ P := Over.homMk xLeft rfl
  let yB : T' ⟶ Q := Over.homMk yLeft rfl
  let iB : T ⟶ T' := Over.homMk iLeft (by
    apply B.inclusion.map_injective
    show B.inclusion.map iLeft ≫ B.inclusion.map cBase = B.inclusion.map aBase
    rw [hMapI, hMapCBase, hMapABase, ← htop, ← Category.assoc, hiy]
    exact Category.assoc _ _ _)
  let zB (z : B.inclusion.obj C₀ ⟶ B.inclusion.obj P.left)
      (hz : z ≫ B.inclusion.map ψ.left = y₀) : T' ⟶ P :=
    Over.homMk (B.inclusion.preimage z) (by
      apply B.inclusion.map_injective
      show B.inclusion.map (B.inclusion.preimage z) ≫ B.inclusion.map P.hom =
        B.inclusion.map cBase
      rw [B.inclusion.map_preimage, hMapCBase, ← htop, ← Category.assoc, hz])
  have hxBleft : Over.Hom.left xB = xLeft := rfl
  have hyBleft : Over.Hom.left yB = yLeft := rfl
  have hiBleft : Over.Hom.left iB = iLeft := rfl
  have hzBleft (z : B.inclusion.obj C₀ ⟶ B.inclusion.obj P.left)
      (hz : z ≫ B.inclusion.map ψ.left = y₀) :
      B.inclusion.map (Over.Hom.left (zB z hz)) = z := B.inclusion.map_preimage _
  have hSq : IsSquareZeroClosedImmersion B S hS iB := by
    show _root_.AlgebraicGeometry.IsClosedImmersion (B.inclusion.map (Over.Hom.left iB)) ∧
      (B.inclusion.map (Over.Hom.left iB)).ker ^ 2 = ⊥
    rw [hiBleft, hMapI]
    exact hi₀
  have hcomm : xB ≫ ψ = iB ≫ yB := by
    apply Over.OverMorphism.ext
    apply B.inclusion.map_injective
    calc
      B.inclusion.map (Over.Hom.left xB ≫ Over.Hom.left ψ) =
          x₀ ≫ B.inclusion.map ψ.left := by rw [Functor.map_comp, hxBleft, hMapX]
      _ = i₀ ≫ y₀ := hiy.symm
      _ = B.inclusion.map (Over.Hom.left iB ≫ Over.Hom.left yB) := by
        rw [Functor.map_comp, hiBleft, hMapI, hyBleft, hMapY]
  have hLift (z : B.inclusion.obj C₀ ⟶ B.inclusion.obj P.left)
      (hz : z ≫ B.inclusion.map ψ.left = y₀) (hzi : i₀ ≫ z = x₀) :
      IsLift (yoneda.map ψ) iB xB yB (zB z hz) := by
    constructor
    · apply Over.OverMorphism.ext
      apply B.inclusion.map_injective
      calc
        B.inclusion.map (Over.Hom.left iB ≫ Over.Hom.left (zB z hz)) = i₀ ≫ z := by
          rw [Functor.map_comp, hiBleft, hMapI, hzBleft z hz]
        _ = x₀ := hzi
        _ = B.inclusion.map (Over.Hom.left xB) := by rw [hxBleft, hMapX]
    · apply Over.OverMorphism.ext
      apply B.inclusion.map_injective
      calc
        B.inclusion.map (Over.Hom.left (zB z hz) ≫ Over.Hom.left ψ) =
            z ≫ B.inclusion.map ψ.left := by rw [Functor.map_comp, hzBleft z hz]
        _ = y₀ := hz
        _ = B.inclusion.map (Over.Hom.left yB) := by rw [hyBleft, hMapY]
  have hu := hψ T T' hA₀ hC₀ iB hSq xB yB hcomm (zB z₁ hz₁ψ) (zB z₂ hz₂ψ)
    (hLift z₁ hz₁ψ hz₁i) (hLift z₂ hz₂ψ hz₂i)
  calc
    z₁ = B.inclusion.map (Over.Hom.left (zB z₁ hz₁ψ)) := (hzBleft z₁ hz₁ψ).symm
    _ = B.inclusion.map (Over.Hom.left (zB z₂ hz₂ψ)) :=
      congrArg B.inclusion.map (congrArg Over.Hom.left hu)
    _ = z₂ := hzBleft z₂ hz₂ψ

private theorem uniqueCotangentSection_of_affineSiteMap
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (P Q : BigFppfOver B S hS)
    (hP : IsAffine ((BigFppfOver.toScheme B S hS).obj P))
    (hQ : IsAffine ((BigFppfOver.toScheme B S hS).obj Q))
    (ψ : P ⟶ Q)
    [Algebra Γ(((BigFppfOver.toScheme B S hS).obj Q), ⊤)
      Γ(((BigFppfOver.toScheme B S hS).obj P), ⊤)]
    (hAlg : algebraMap Γ(((BigFppfOver.toScheme B S hS).obj Q), ⊤)
      Γ(((BigFppfOver.toScheme B S hS).obj P), ⊤) =
      ((BigFppfOver.toScheme B S hS).map ψ).appTop.hom)
    (hψ : FormallyUnramified (yoneda.map ψ)) :
    ∀ s : CotangentSections
      Γ(((BigFppfOver.toScheme B S hS).obj Q), ⊤)
      Γ(((BigFppfOver.toScheme B S hS).obj P), ⊤),
      s.val = canonicalCotangentSection
        Γ(((BigFppfOver.toScheme B S hS).obj Q), ⊤)
        Γ(((BigFppfOver.toScheme B S hS).obj P), ⊤) := by
  intro s
  classical
  let G := BigFppfOver.toScheme B S hS
  let P₀ := G.obj P
  let Q₀ := G.obj Q
  let R : Type u := Γ(Q₀, ⊤)
  let A : Type u := Γ(P₀, ⊤)
  let J : Ideal (A ⊗[R] A) := KaehlerDifferential.ideal R A
  let C : Type u := (A ⊗[R] A) ⧸ J ^ 2
  let m : C →ₐ[R] A := (TensorProduct.lmul' R (S := A)).kerSquareLift
  let c : CotangentSections R A := canonicalCotangentSection R A
  have hPsize : P₀.size < B.cutoff := P.left.property
  have hQsize : Q₀.size < B.cutoff := Q.left.property
  have hAcard : Cardinal.mk A ≤ P₀.size := Scheme.mk_sections_le_size _ ⟨⊤, isAffineOpen_top _⟩
  have hRcard : Cardinal.mk R ≤ Q₀.size := Scheme.mk_sections_le_size _ ⟨⊤, isAffineOpen_top _⟩
  have hSpecSize (T : Type u) [CommRing T] (h : Cardinal.mk T < B.cutoff) :
      (Spec (.of T)).size < B.cutoff := by
    rw [Scheme.size_Spec]
    exact max_lt B.aleph0_lt_cutoff h
  have hASpec : (Spec (.of A)).size < B.cutoff := hSpecSize A (hAcard.trans_lt hPsize)
  let K := max (max (Cardinal.mk A) (Cardinal.mk R)) Cardinal.aleph0
  have hKlt : K < B.cutoff :=
    max_lt (max_lt (hAcard.trans_lt hPsize) (hRcard.trans_lt hQsize)) B.aleph0_lt_cutoff
  have hCcard : Cardinal.mk C ≤ K := by
    simpa [C, J, K] using cotangentSquareQuotient_cardinal_le R A
  have hCsize : (Spec (.of C)).size < B.cutoff := hSpecSize C (hCcard.trans_lt hKlt)
  let A₀ : B.Schemes := B.obj hASpec
  let C₀ : B.Schemes := B.obj hCsize
  let : IsAffine P₀ := hP
  let : IsAffine Q₀ := hQ
  let eP : Spec (.of A) ≅ P₀ := P₀.isoSpec.symm
  let eQ : Spec (.of R) ≅ Q₀ := Q₀.isoSpec.symm
  let x₀ : Spec (.of A) ⟶ P₀ := eP.hom
  let f₀ : P₀ ⟶ Q₀ := G.map ψ
  let y₀ : Spec (.of C) ⟶ Q₀ :=
    Spec.map (CommRingCat.ofHom (algebraMap R C)) ≫ eQ.hom
  let i₀ : Spec (.of A) ⟶ Spec (.of C) := Spec.map (CommRingCat.ofHom m.toRingHom)
  let z₀ (g : A →ₐ[R] C) : Spec (.of C) ⟶ P₀ :=
    Spec.map (CommRingCat.ofHom g.toRingHom) ≫ eP.hom
  have htop : f₀ ≫ B.inclusion.map Q.hom = B.inclusion.map P.hom := by
    show B.inclusion.map (Over.Hom.left ψ) ≫ B.inclusion.map Q.hom = _
    rw [← Functor.map_comp, Over.w ψ]
  have hRingMap (g : A →ₐ[R] C) :
      g.toRingHom.comp f₀.appTop.hom = algebraMap R C := by
    ext r
    rw [← hAlg]
    exact g.commutes r
  have hnat : x₀ ≫ f₀ ≫ Q₀.isoSpec.hom =
      Spec.map (CommRingCat.ofHom f₀.appTop.hom) := by
    rw [← Scheme.isoSpec_hom_naturality f₀]
    simp [x₀, eP]
  have hIsoMap : x₀ ≫ f₀ =
      Spec.map (CommRingCat.ofHom f₀.appTop.hom) ≫ eQ.hom := by
    calc
      x₀ ≫ f₀ = x₀ ≫ f₀ ≫ Q₀.isoSpec.hom ≫ eQ.hom := by simp [eQ]
      _ = Spec.map (CommRingCat.ofHom f₀.appTop.hom) ≫ eQ.hom := by
        simpa only [Category.assoc] using congrArg (fun k => k ≫ eQ.hom) hnat
  have hzψ (g : A →ₐ[R] C) : z₀ g ≫ f₀ = y₀ := by
    calc
      z₀ g ≫ f₀ = Spec.map (CommRingCat.ofHom g.toRingHom) ≫ (x₀ ≫ f₀) := by
        simp [z₀, x₀]
      _ = Spec.map (CommRingCat.ofHom (g.toRingHom.comp f₀.appTop.hom)) ≫ eQ.hom := by
        rw [hIsoMap, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
      _ = y₀ := by rw [hRingMap g]
  have hiz (t : CotangentSections R A) : i₀ ≫ z₀ t.val = x₀ := by
    have hcomp : CommRingCat.ofHom t.val.toRingHom ≫
        CommRingCat.ofHom m.toRingHom = 𝟙 (CommRingCat.of A) :=
      CommRingCat.hom_ext (congrArg AlgHom.toRingHom t.property)
    show Spec.map (CommRingCat.ofHom m.toRingHom) ≫
        Spec.map (CommRingCat.ofHom t.val.toRingHom) ≫ eP.hom = eP.hom
    rw [← Category.assoc, ← Spec.map_comp, hcomp, Spec.map_id, Category.id_comp]
  have hiy : i₀ ≫ y₀ = x₀ ≫ f₀ := by rw [← hzψ c.val, ← Category.assoc, hiz c]
  have hA₀ : IsAffine (B.inclusion.obj A₀) := by
    show IsAffine (Spec (.of A)); infer_instance
  have hC₀ : IsAffine (B.inclusion.obj C₀) := by
    show IsAffine (Spec (.of C)); infer_instance
  have hi₀ : Stacks.Thickenings.IsFirstOrderThickening i₀ := by
    have hmsurj : Function.Surjective (CommRingCat.ofHom m.toRingHom) := by
      intro a
      refine ⟨Ideal.Quotient.mk _ (a ⊗ₜ[R] (1 : A)), ?_⟩
      show (TensorProduct.lmul' R (S := A)).kerSquareLift
        (Ideal.Quotient.mk _ (a ⊗ₜ[R] (1 : A))) = a
      rw [AlgHom.kerSquareLift_mk]
      simp
    have hmker : RingHom.ker (CommRingCat.ofHom m.toRingHom).hom ^ 2 = ⊥ := by
      show RingHom.ker ((TensorProduct.lmul' R (S := A)).kerSquareLift.toRingHom) ^ 2 = ⊥
      rw [AlgHom.ker_kerSquareLift]
      exact Ideal.cotangentIdeal_square _
    exact specMap_isFirstOrderThickening (CommRingCat.ofHom m.toRingHom) hmsurj hmker
  have hScheme : z₀ s.val = z₀ c.val :=
    eq_of_formallyUnramified_yonedaMap B S hS ψ hψ hA₀ hC₀ x₀ y₀ i₀ hi₀
      (z₀ s.val) (z₀ c.val) hiy (hiz s) (hzψ s.val) (hiz c) (hzψ c.val)
  exact algHom_eq_of_specMap_comp_eq eP (by simpa only [z₀] using hScheme)


@[ega "IV 17.1.2" "(i)"]
private theorem ringFormallyUnramified_of_affineSiteMap
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (P Q : BigFppfOver B S hS)
    (hP : IsAffine ((BigFppfOver.toScheme B S hS).obj P))
    (hQ : IsAffine ((BigFppfOver.toScheme B S hS).obj Q))
    (ψ : P ⟶ Q)
    [Algebra Γ(((BigFppfOver.toScheme B S hS).obj Q), ⊤)
      Γ(((BigFppfOver.toScheme B S hS).obj P), ⊤)]
    (hAlg : algebraMap Γ(((BigFppfOver.toScheme B S hS).obj Q), ⊤)
      Γ(((BigFppfOver.toScheme B S hS).obj P), ⊤) =
      ((BigFppfOver.toScheme B S hS).map ψ).appTop.hom)
    (hψ : FormallyUnramified (yoneda.map ψ)) :
    ((BigFppfOver.toScheme B S hS).map ψ).appTop.hom.FormallyUnramified := by
  let G := BigFppfOver.toScheme B S hS
  let R : Type u := Γ((G.obj Q), ⊤)
  let A : Type u := Γ((G.obj P), ⊤)
  let c : CotangentSections R A := canonicalCotangentSection R A
  have huniq : ∀ t : CotangentSections R A, t.val = c.val :=
    uniqueCotangentSection_of_affineSiteMap B S hS P Q hP hQ ψ hAlg hψ
  rw [← hAlg, RingHom.formallyUnramified_algebraMap]
  exact algebraFormallyUnramified_of_uniqueCotangentSection R A c huniq





