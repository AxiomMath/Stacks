* [Stacks Project, Tag 07UK](https://stacks.math.columbia.edu/tag/07UK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe w v₁ u₁ u

namespace Stacks.Sites

/-! ### A purely algebraic identity -/

/-- **The products of the terms of two linear combinations are a linear combination of the
products**, for a commutative ring of scalars. -/
theorem sum_comb_mul {Rr : Type*} [Semiring Rr] (hcomm : ∀ a b : Rr, a * b = b * a)
    {Mm : Type*} [AddCommMonoid Mm] [Module Rr Mm] {r q : ℕ}
    (c : Fin r → Rr) (d : Fin q → Rr) {A : Fin r → Rr} {Zz : Fin q → Mm}
    {rr : Rr} {w : Mm} (hc : ∑ l, c l * A l = rr) (hd : ∑ j, d j • Zz j = w)
    (Gg : Fin (r * q) → Mm)
    (hG : ∀ x, Gg x =
      A (finProdFinEquiv.symm x).1 • Zz (finProdFinEquiv.symm x).2) :
    ∑ x, (c (finProdFinEquiv.symm x).1 * d (finProdFinEquiv.symm x).2) • Gg x = rr • w := by
  classical
  have step : ∑ x, (c (finProdFinEquiv.symm x).1 * d (finProdFinEquiv.symm x).2) • Gg x
      = (∑ l, c l * A l) • ∑ j, d j • Zz j := by
    calc ∑ x, (c (finProdFinEquiv.symm x).1 * d (finProdFinEquiv.symm x).2) • Gg x
        = ∑ p : Fin r × Fin q, (c p.1 * d p.2) • (A p.1 • Zz p.2) :=
          Fintype.sum_equiv finProdFinEquiv.symm _ _ (fun x => by rw [hG x])
      _ = ∑ l, ∑ j, (c l * d j) • (A l • Zz j) := Fintype.sum_prod_type _
      _ = (∑ l, c l * A l) • ∑ j, d j • Zz j := by
          rw [Finset.sum_smul]
          refine Finset.sum_congr rfl fun l _ => ?_
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [smul_smul, smul_smul, mul_assoc, hcomm (d j) (A l), ← mul_assoc]
  rw [step, hc, hd]

section General

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}
  {O : Sheaf J CommRingCat.{u}}

/-! ### Sections of a submodule -/

/-- The sections of a submodule of a presheaf of modules, as sections of the ambient presheaf.
This is the inclusion, bundled additively so that it may be applied to a finite sum. -/
def submoduleVal {Sp : Cᵒᵖ ⥤ RingCat.{u}} {A : PresheafOfModules.{w} Sp}
    (N : A.Submodule) (X : Cᵒᵖ) : N.toPresheafOfModules.obj X →+ A.obj X where
  toFun x := x.val
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The sections of a sheaf of ideals, as sections of the sheaf of rings.  The two types are
definitionally equal; the ring structure is only found on the second spelling. -/
def idealVal (I : IdealSubsheaf O) (X : Cᵒᵖ) :
    I.toPresheafOfModules.obj X →+ (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X where
  toFun x := x.val
  map_zero' := rfl
  map_add' _ _ := rfl

variable {M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)}

/-! ### The largest submodule -/

/-- **The largest submodule of a module of finite type is of finite type.** -/
theorem isFiniteType_top (h : PresheafOfModules.IsFiniteType J M.val) :
    PresheafOfModules.IsFiniteType J (⊤ : M.Submodule).toPresheafOfModules := by
  obtain ⟨Ix, U, hU, gen⟩ := h.exists_generators
  refine ⟨Ix, U, hU, fun i => ?_⟩
  obtain ⟨q, s, hs⟩ := gen i
  refine ⟨q, fun j => ⟨s j, Stacks.SheafOfModules.mem_top_obj _⟩, ?_⟩
  exact Stacks.SheafOfModules.generates_submodule _ _ fun V f t => hs V f t.val

/-! ### The product of a sheaf of ideals with a submodule -/

/-- **A section of the objectwise product `I(Y) · K(Y)` is, locally, a combination of the
products of a generating family of `I` with a generating family of `K`.** -/
theorem exists_comb_of_mem_ringSectionIdeal_smul (I : IdealSubsheaf O) (K : M.Submodule)
    {W : C} {r q : ℕ}
    (aW : Fin r → I.toPresheafOfModules.obj (op W))
    (zW : Fin q → K.toPresheafOfModules.obj (op W))
    (ha : PresheafOfModules.Generates J I.toPresheafOfModules aW)
    (hz : PresheafOfModules.Generates J K.toPresheafOfModules zW)
    (gen : Fin (r * q) → M.val.obj (op W))
    (hgen : ∀ x, gen x = idealVal I (op W) (aW (finProdFinEquiv.symm x).1) •
      submoduleVal K.toSubmodule (op W) (zW (finProdFinEquiv.symm x).2))
    {Y : C} (h : Y ⟶ W) {y : M.val.obj (op Y)}
    (hy : y ∈ ringSectionIdeal I (op Y) • K.obj (op Y)) :
    ∃ T : Sieve Y, T ∈ J Y ∧ ∀ (Z : C) (k : Z ⟶ Y), T.arrows k →
      ∃ c : Fin (r * q) → (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj (op Z),
        ∑ x, c x • M.val.restrictₛₗ (k ≫ h).op (gen x) = M.val.restrictₛₗ k.op y := by
  classical
  refine Submodule.smul_induction_on hy ?_ ?_
  · intro rr hrr w hw
    obtain ⟨T₁, hT₁, hc₁⟩ := ha Y h ⟨rr, hrr⟩
    obtain ⟨T₂, hT₂, hc₂⟩ := hz Y h ⟨w, hw⟩
    refine ⟨T₁ ⊓ T₂, J.intersection_covering hT₁ hT₂, fun Z k hk => ?_⟩
    obtain ⟨c, hc⟩ := hc₁ Z k hk.1
    obtain ⟨d, hd⟩ := hc₂ Z k hk.2
    refine ⟨fun x => c (finProdFinEquiv.symm x).1 * d (finProdFinEquiv.symm x).2, ?_⟩
    have hcr : ∑ l, c l * (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map (k ≫ h).op
          (idealVal I (op W) (aW l))
        = (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map k.op rr := by
      exact (map_sum (idealVal I (op Z)) _ _).symm.trans (congrArg _ hc)
    have hdr : ∑ j, d j • M.val.restrictₛₗ (k ≫ h).op
          (submoduleVal K.toSubmodule (op W) (zW j))
        = M.val.restrictₛₗ k.op w := by
      exact (map_sum (submoduleVal K.toSubmodule (op Z)) _ _).symm.trans (congrArg _ hd)
    have hcomm : ∀ a b : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj (op Z),
        a * b = b * a := by
      let _ : CommRing ((Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj (op Z)) :=
        inferInstanceAs (CommRing (O.obj.obj (op Z)))
      exact fun a b => mul_comm a b
    refine Eq.trans (sum_comb_mul hcomm c d hcr hdr _ (fun x => ?_)) ?_
    · rw [hgen x]
      exact map_smulₛₗ _ _ _
    · exact (map_smulₛₗ (M.val.restrictₛₗ k.op) rr w).symm
  · rintro y₁ y₂ ⟨T₁, hT₁, hy₁⟩ ⟨T₂, hT₂, hy₂⟩
    refine ⟨T₁ ⊓ T₂, J.intersection_covering hT₁ hT₂, fun Z k hk => ?_⟩
    obtain ⟨c₁, e₁⟩ := hy₁ Z k hk.1
    obtain ⟨c₂, e₂⟩ := hy₂ Z k hk.2
    refine ⟨c₁ + c₂, ?_⟩
    rw [map_add, ← e₁, ← e₂, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun x _ => add_smul _ _ _

/-- **The product `I · K` of a sheaf of ideals of finite type with a submodule of finite type is
of finite type.** -/
theorem isFiniteType_idealSmul (I : IdealSubsheaf O) (K : M.Submodule)
    (hI : PresheafOfModules.IsFiniteType J I.toPresheafOfModules)
    (hK : PresheafOfModules.IsFiniteType J K.toPresheafOfModules) :
    PresheafOfModules.IsFiniteType J (idealSmul I K).toPresheafOfModules := by
  classical
  obtain ⟨I₁, U₁, hU₁, gen₁⟩ := hI.exists_generators
  obtain ⟨I₂, U₂, hU₂, gen₂⟩ := hK.exists_generators
  refine Stacks.SheafOfModules.isFiniteType_presheaf_of_coversTop
    (fun j : Σ (i : I₁) (k : I₂) (W : C), (W ⟶ U₁ i) × (W ⟶ U₂ k) => j.2.2.1) ?_ ?_
  · intro Z
    refine J.superset_covering ?_ (J.intersection_covering (hU₁ Z) (hU₂ Z))
    rintro Y f ⟨h₁, h₂⟩
    obtain ⟨i, ⟨a⟩⟩ := h₁
    obtain ⟨k, ⟨b⟩⟩ := h₂
    exact ⟨⟨i, k, Y, (a, b)⟩, ⟨𝟙 Y⟩⟩
  · rintro ⟨i, k, W, α, β⟩
    obtain ⟨r, a₀, ha₀⟩ := gen₁ i
    obtain ⟨q, z₀, hz₀⟩ := gen₂ k
    have ha := Stacks.SheafOfModules.generates_restrict (J := J) α a₀ ha₀
    have hz := Stacks.SheafOfModules.generates_restrict (J := J) β z₀ hz₀
    refine ⟨r * q, fun x =>
      ⟨idealVal I (op W) (I.toPresheafOfModules.restrictₛₗ α.op
            (a₀ (finProdFinEquiv.symm x).1)) •
        submoduleVal K.toSubmodule (op W) (K.toPresheafOfModules.restrictₛₗ β.op
            (z₀ (finProdFinEquiv.symm x).2)),
        smul_mem_idealSmul I
          (I.toPresheafOfModules.restrictₛₗ α.op (a₀ (finProdFinEquiv.symm x).1)).2
          (K.toPresheafOfModules.restrictₛₗ β.op (z₀ (finProdFinEquiv.symm x).2)).2⟩, ?_⟩
    refine Stacks.SheafOfModules.generates_submodule _ _ fun V f t => ?_
    obtain ⟨S₀, hS₀, ht⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule t.2
    refine Stacks.SheafOfModules.exists_cover_comb_of_bind _ f t.val hS₀ ?_
    intro Y g hg
    have hy : M.val.map g.op t.val ∈ ringSectionIdeal I (op Y) • K.obj (op Y) :=
      (presheafIdealSmul_obj I K.toSubmodule (op Y)).le (ht g hg)
    obtain ⟨T, hT, hcomb⟩ := exists_comb_of_mem_ringSectionIdeal_smul I K
      (fun l => I.toPresheafOfModules.restrictₛₗ α.op (a₀ l))
      (fun j => K.toPresheafOfModules.restrictₛₗ β.op (z₀ j)) ha hz _ (fun x => rfl) (g ≫ f) hy
    refine ⟨T, hT, fun Z kk hkk => (hcomb Z kk hkk).imp fun c hc => ?_⟩
    rwa [Category.assoc, ← Stacks.SheafOfModules.restrict_restrict]

/-- **The product `Iⁿ · K` of a power of a sheaf of ideals of finite type with a submodule of
finite type is of finite type.** -/
theorem isFiniteType_idealPowSmul (I : IdealSubsheaf O)
    (hI : PresheafOfModules.IsFiniteType J I.toPresheafOfModules) (n : ℕ) :
    ∀ K : M.Submodule, PresheafOfModules.IsFiniteType J K.toPresheafOfModules →
      PresheafOfModules.IsFiniteType J (idealPowSmul I n K).toPresheafOfModules := by
  induction n with
  | zero =>
      intro K hK
      rw [idealPowSmul_zero]
      exact hK
  | succ n ih =>
      intro K hK
      rw [idealPowSmul_succ]
      exact ih _ (isFiniteType_idealSmul I K hI hK)

end General

end Stacks.Sites

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-- **The submodule `Iⁿ G` of a module of finite type is of finite type**, for a sheaf of ideals
`I` of finite type. -/
theorem isFiniteType_idealPowSubmodule
    (I : IdealSheaves B S hS F hF) (n : ℕ) (G : Modules.{u, u} B S hS F hF)
    (hI : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J
            I.toSheafOfModules.val)
    (hG : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J G.val) :
    PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J
      (idealPowModule I n G).val :=
  Stacks.Sites.isFiniteType_idealPowSmul I hI n ⊤
    (Stacks.Sites.isFiniteType_top (M := G) hG)

/-- **`Iⁿ G` is coherent when `G` is coherent and `I` is of finite type.** -/
theorem isCoherent_idealPowModule
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (I : IdealSheaves B S hS F hF) (n : ℕ) (G : Modules.{u, u} B S hS F hF)
    (hG : IsCoherent B S hS F hF G)
    (hI : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J
            I.toSheafOfModules.val) :
    IsCoherent B S hS F hF (idealPowModule I n G) := by
  have : SheafOfModules.IsCoherentOnSite (idealPowModule I n G) :=
    isCoherentOnSite_of_mono_of_isFiniteType B S hS F hF (idealPowModuleι I n G)
      (isFiniteType_idealPowSubmodule B S hS F hF I n G hI
        hG.toIsCoherentOnSite.isFiniteType) hG.toIsCoherentOnSite
  exact isCoherent_of_isCoherentOnSite B S hS F hF _

/-- **On a locally Noetherian algebraic space a quasi-coherent sheaf of ideals is coherent.**
It is a quasi-coherent submodule of the structure sheaf, which is coherent by the structure-sheaf
assertion of Stacks 07UB, so the submodule assertion of Stacks 07UD applies. -/
theorem isCoherent_idealSheaf
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (I : IdealSheaves B S hS F hF) (hI : I.toSheafOfModules.IsQuasicoherentOnSite) :
    IsCoherent B S hS F hF I.toSheafOfModules :=
  isCoherent_of_mono_of_isQuasicoherentOnSite B S hS F hF I.ι hI
    (isCoherent_structureSheaf B S hS F hF)

/-- A quasi-coherent sheaf of ideals on a locally Noetherian algebraic space is of finite
type. -/
theorem isFiniteType_idealSheaf
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (I : IdealSheaves B S hS F hF) (hI : I.toSheafOfModules.IsQuasicoherentOnSite) :
    PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J
      I.toSheafOfModules.val :=
  (isCoherent_idealSheaf B S hS F hF I hI).toIsCoherentOnSite.isFiniteType

/-- **`Iⁿ G` is coherent when `G` is coherent and `I` is quasi-coherent.**  This is the shape a
consumer wants: on a locally Noetherian space quasi-coherence of the sheaf of ideals already
implies the finite type that `AlgebraicGeometry.Space.isCoherent_idealPowModule` asks for. -/
theorem isCoherent_idealPowModule_of_isQuasicoherentOnSite
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (I : IdealSheaves B S hS F hF) (n : ℕ) (G : Modules.{u, u} B S hS F hF)
    (hG : IsCoherent B S hS F hF G) (hI : I.toSheafOfModules.IsQuasicoherentOnSite) :
    IsCoherent B S hS F hF (idealPowModule I n G) :=
  isCoherent_idealPowModule B S hS F hF I n G hG
    (isFiniteType_idealSheaf B S hS F hF I hI)

end AlgebraicGeometry.Space

end
