module

public import Mathlib.RingTheory.AdicCompletion.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteType
public import StacksFrontier.AlgebraicGeometry.Spaces.StructureSheaf

/-!
# The setting of Grothendieck's existence theorem for algebraic spaces

Grothendieck's existence theorem is stated for a Noetherian ring `A` which is complete with
respect to an ideal `I`, a separated algebraic space `X` of finite type over `Spec A`, and
the ideal `I 𝒪_X` cut out on `X` by `I`. This file packages that standing data and
constructs the ideal `I 𝒪_X` on each étale chart of `X`.

## Main definitions

* `AlgebraicGeometry.Space.ExistenceSituation` is the standing data and hypotheses:
  **Stacks 08B7**.
* `AlgebraicGeometry.Space.ExistenceSituation.generatedIdealOnChart` is the ideal generated
  by `I` in the global functions on a single étale chart.
* `AlgebraicGeometry.Space.ExistenceSituation.idealOnChart` is the ideal of sections of
  `I 𝒪_X` on an étale chart.

## Main results

There are no propositional results; this file fixes the setting in which the existence
theorem is stated.

## Implementation notes

The base scheme of the chosen big fppf site is `Spec A` itself, so the structure morphism
of `X` is a morphism of presheaves to the Yoneda image of the terminal object
`Over.mk (𝟙 (B.obj containsBase))` of the site. The ring, its Noetherian hypothesis and its
completeness are instance-implicit fields, re-exported as instances on the projections so
that `A` can be used as a ring without unpacking the situation by hand.

The ideal `I 𝒪_X` is a sheaf of ideals, not a presheaf of ideals: its sections on an étale
chart `U` are the sections which, after passing to some covering sieve of `U`, lie in the
ideal generated by the image of `I` on each covering chart. That is
`idealOnChart`, formed as the supremum over covering sieves of the infimum over the charts
in the sieve of the pullbacks of `generatedIdealOnChart`. In particular it is in general
strictly larger than `generatedIdealOnChart U`, which is only the presheaf of ideals
generated by `I`, and it agrees with it after restriction to a suitable covering.

## References

* [Stacks Project, Tag 08B7](https://stacks.math.columbia.edu/tag/08B7)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Space

/-- **Stacks 08B7.** The standing data of Grothendieck's existence theorem: a Noetherian
ring `A` complete with respect to an ideal `I`, together with a separated algebraic space
`X` of finite type over `Spec A`. -/
@[stacks 08B7]
structure ExistenceSituation where
  /-- The base ring. -/
  A : Type u
  [commRing : CommRing A]
  [noetherian : IsNoetherianRing A]
  /-- The ideal with respect to which the base ring is complete. -/
  I : Ideal A
  [complete : IsAdicComplete I A]
  /-- The big fppf site on which the algebraic space lives. -/
  B : BigFppfSite.{u}
  /-- The spectrum of the base ring is an object of the site. -/
  containsBase : B.Contains (Spec (.of A))
  /-- The presheaf underlying the algebraic space. -/
  X : (BigFppfOver B (Spec (.of A)) containsBase)ᵒᵖ ⥤ Type u
  /-- It is an algebraic space. -/
  isAlgebraicSpace : IsAlgebraicSpace B (Spec (.of A)) containsBase X
  /-- Its structure morphism to the base. -/
  f : X ⟶ yoneda.obj (Over.mk (𝟙 (B.obj containsBase)))
  /-- The structure morphism is of finite type. -/
  finiteType : IsFiniteType B (Spec (.of A)) containsBase f
  /-- The structure morphism is separated. -/
  separated : IsSeparated B (Spec (.of A)) containsBase f

namespace ExistenceSituation

/-- The base ring of the situation is a commutative ring. -/
instance (s : ExistenceSituation.{u}) : CommRing s.A := s.commRing

/-- The base ring of the situation is Noetherian. -/
instance (s : ExistenceSituation.{u}) : IsNoetherianRing s.A := s.noetherian

/-- The base ring of the situation is complete with respect to the ideal `I`. -/
instance (s : ExistenceSituation.{u}) : IsAdicComplete s.I s.A := s.complete

/-- The ideal generated by `I` in the global functions on a single étale chart of `X`. This
is a presheaf of ideals, whose sheafification is `idealOnChart`. -/
noncomputable def generatedIdealOnChart (s : ExistenceSituation.{u})
    (U : SmallEtale s.B (Spec (.of s.A)) s.containsBase s.X) :
    Ideal ((structurePresheaf s.B (Spec (.of s.A)) s.containsBase s.X).obj
      (Opposite.op U)) :=
  let V := (SmallEtale.toOver s.B (Spec (.of s.A)) s.containsBase s.X).obj U
  Ideal.map ((Scheme.ΓSpecIso (.of s.A)).inv ≫ (s.B.inclusion.map V.hom).appTop).hom s.I

/-- The sections of the sheaf of ideals `I 𝒪_X` on an étale chart of `X`: a section lies in
the ideal exactly when, on some covering sieve of the chart, it is generated by the image
of `I`. -/
noncomputable def idealOnChart (s : ExistenceSituation.{u})
    (U : SmallEtale s.B (Spec (.of s.A)) s.containsBase s.X) :
    Ideal ((structurePresheaf s.B (Spec (.of s.A)) s.containsBase s.X).obj
      (Opposite.op U)) :=
  let J := SmallEtale.topology s.B (Spec (.of s.A)) s.containsBase s.X
  let O := structurePresheaf s.B (Spec (.of s.A)) s.containsBase s.X
  ⨆ (R : Sieve U) (_ : R ∈ J U),
    ⨅ (V : SmallEtale s.B (Spec (.of s.A)) s.containsBase s.X) (g : V ⟶ U) (_ : R g),
      Ideal.comap (O.map g.op).hom (generatedIdealOnChart s V)

end ExistenceSituation

end AlgebraicGeometry.Space

end
