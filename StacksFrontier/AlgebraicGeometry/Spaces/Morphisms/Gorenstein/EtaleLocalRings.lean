-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u v w

namespace AlgebraicGeometry.Space

/-! ### Gorensteinness across a ring isomorphism and a strict henselization -/

private theorem exists_isGorensteinLocalRing_of_ringEquiv {A C : Type*}
    [CommRing A] [CommRing C] (e : A ≃+* C) :
    (∃ (hN : IsNoetherianRing A) (hL : IsLocalRing A),
      @Dualizing.IsGorensteinLocalRing A _ hN hL) →
      ∃ (hN : IsNoetherianRing C) (hL : IsLocalRing C),
        @Dualizing.IsGorensteinLocalRing C _ hN hL := by
  rintro ⟨hN, hL, hG⟩
  have := hN
  have := hL
  have := isNoetherianRing_of_ringEquiv A e
  have := e.isLocalRing
  exact ⟨inferInstance, inferInstance, Dualizing.isGorensteinLocalRing_of_ringEquiv e.symm hG⟩

/-- Being Noetherian, local and Gorenstein transports along a ring isomorphism. -/
private theorem exists_isGorensteinLocalRing_iff_of_ringEquiv {A C : Type*}
    [CommRing A] [CommRing C] (e : A ≃+* C) :
    (∃ (hN : IsNoetherianRing A) (hL : IsLocalRing A),
      @Dualizing.IsGorensteinLocalRing A _ hN hL) ↔
      (∃ (hN : IsNoetherianRing C) (hL : IsLocalRing C),
        @Dualizing.IsGorensteinLocalRing C _ hN hL) :=
  ⟨exists_isGorensteinLocalRing_of_ringEquiv e, exists_isGorensteinLocalRing_of_ringEquiv e.symm⟩

/-- Being Noetherian, local and Gorenstein is unchanged on passing to a strict henselization:
the structure map is flat and local, and the closed fibre of that map is the residue field of
the strict henselization, which is regular and hence Gorenstein, so the criterion of Tag 0BJL
identifies Gorensteinness of the strict henselization with Gorensteinness of the ring.
Noetherianity passes both ways by Tag 06LJ. -/
@[sga "4 VIII 4.4" "special case"]
private theorem exists_isGorensteinLocalRing_iff_of_isHenselization
    {R Rsh : Type u} [CommRing R] [IsLocalRing R] [CommRing Rsh] [IsLocalRing Rsh]
    [Algebra R Rsh] (Rh : Type u) [CommRing Rh] [IsLocalRing Rh] [Algebra R Rh]
    (κ : Type v) [Field κ] [Algebra (ResidueField R) κ] [IsSepClosure (ResidueField R) κ]
    [IsHenselization R (ResidueField R) Rh] [IsHenselization R κ Rsh] :
    (∃ (hN : IsNoetherianRing R) (hL : IsLocalRing R),
      @Dualizing.IsGorensteinLocalRing R _ hN hL) ↔
      (∃ (hN : IsNoetherianRing Rsh) (hL : IsLocalRing Rsh),
        @Dualizing.IsGorensteinLocalRing Rsh _ hN hL) := by
  have : IsLocalHom (algebraMap R Rsh) := IsHenselization.isLocalHom (L := κ)
  have : Module.Flat R Rsh := IsHenselization.flat (R := R) (L := κ) (Rh := Rsh)
  have hnoeth := (isNoetherianRing_iff_henselizations R Rh Rsh κ).2
  have key : ∀ (hNR : IsNoetherianRing R) (_ : IsNoetherianRing Rsh),
      @Dualizing.IsGorensteinLocalRing R _ hNR _ ↔ Dualizing.IsGorensteinLocalRing Rsh := by
    intro hNR hNS
    have := hNR
    have := hNS
    have hI : (maximalIdeal R).map (algebraMap R Rsh) = maximalIdeal Rsh :=
      IsHenselization.map_maximalIdeal (R := R) (L := κ) (Rh := Rsh)
    set I : Ideal Rsh := (maximalIdeal R).map (algebraMap R Rsh)
    have hNq : IsNoetherianRing (Rsh ⧸ I) := inferInstance
    have hLq : IsLocalRing (Rsh ⧸ I) :=
      IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
    have hGq : @Dualizing.IsGorensteinLocalRing (Rsh ⧸ I) _ hNq hLq := by
      have e : (Rsh ⧸ I) ≃+* ResidueField Rsh := Ideal.quotEquivOfEq hI
      exact Dualizing.isGorensteinLocalRing_of_ringEquiv e
        (Dualizing.IsRegularLocalRing.isGorensteinLocalRing _)
    have hcrit' : Dualizing.IsGorensteinLocalRing Rsh ↔
        (Dualizing.IsGorensteinLocalRing R ∧
          @Dualizing.IsGorensteinLocalRing (Rsh ⧸ I) _ hNq hLq) := by
      simpa [I] using Dualizing.isGorensteinLocalRing_iff_of_flat R Rsh
    exact ⟨fun h => hcrit'.mpr ⟨h, hGq⟩, fun h => (hcrit'.mp h).1⟩
  exact ⟨fun ⟨hN, _, hG⟩ => ⟨hnoeth.mp hN, inferInstance, (key _ _).mp hG⟩,
    fun ⟨hN, _, hG⟩ => ⟨hnoeth.mpr hN, inferInstance, (key _ _).mpr hG⟩⟩

/-- Being Noetherian, local and Gorenstein for the quotient of a local ring by an ideal inside
its maximal ideal is unchanged on passing to a strict henselization: by Stacks 05WS the
quotient of the strict henselization is a strict henselization of the quotient. -/
private theorem exists_isGorensteinLocalRing_quotient_strictHenselization_iff
    {R : Type u} [CommRing R] [IsLocalRing R] (L : Type u) [Field L]
    [Algebra (ResidueField R) L] [IsSepClosure (ResidueField R) L]
    (T : HenselizationTower R L) (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    (∃ (hN : IsNoetherianRing (R ⧸ I)) (hL : IsLocalRing (R ⧸ I)),
      @Dualizing.IsGorensteinLocalRing (R ⧸ I) _ hN hL) ↔
    (∃ (hN : IsNoetherianRing
          (T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization)))
        (hL : IsLocalRing (T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization))),
      @Dualizing.IsGorensteinLocalRing
        (T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization)) _ hN hL) := by
  have : IsLocalHom (algebraMap R T.strictHenselization) := IsHenselization.isLocalHom (L := L)
  have : HenselianLocalRing T.strictHenselization := IsHenselization.henselian (R := R) (L := L)
  obtain ⟨a, _, hsep, hres⟩ :=
    IsHenselization.exists_residueFieldAlgebra (R := R) (L := L) (Rh := T.strictHenselization)
  have halg : a = ResidueField.instAlgebra (R := R) (S := T.strictHenselization) :=
    Algebra.algebra_ext _ _ fun z => by
      obtain ⟨r, rfl⟩ := residue_surjective z
      exact (hres r).trans (ResidueField.algebraMap_residue (S := T.strictHenselization) r).symm
  subst halg
  have : IsSepClosure (ResidueField R) (ResidueField T.strictHenselization) := hsep inferInstance
  obtain ⟨hQ, hAQ, _, hhens, hind, _, hsepQ⟩ :=
    IsLocalRing.strictHenselization_quotient (R := R) (Rsh := T.strictHenselization)
      (IsHenselization.ind_etale_of_universe_le.{u, u, u} L)
      (IsHenselization.map_maximalIdeal (R := R) (L := L) (Rh := T.strictHenselization)) I hI
  have := hQ
  have := hAQ
  have := hhens
  have := hsepQ
  have hH : IsHenselization (R ⧸ I)
      (ResidueField (T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization)))
      (T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization)) :=
    IsHenselization.of_ind_etale hhens hind
      ⟨RingEquiv.refl _, fun z => ResidueField.algebraMap_residue z⟩
  exact exists_isGorensteinLocalRing_iff_of_isHenselization
    (R := R ⧸ I)
    (Rsh := T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization))
    (henselizationTower (R ⧸ I)
      (ResidueField (T.strictHenselization ⧸
        I.map (algebraMap R T.strictHenselization)))).henselization
    (ResidueField (T.strictHenselization ⧸ I.map (algebraMap R T.strictHenselization)))

/-- Gorensteinness of the fibre local ring of a morphism of schemes with affine target at a
point of its source, read through chosen strict henselizations of the two local rings and
chosen identifications of those: it is Gorensteinness of the quotient of the right-hand
identification of the source by the extended maximal ideal of the target. -/
private theorem exists_isGorensteinLocalRing_fiberStalk_iff {Z W : Scheme.{u}} [IsAffine W]
    (q : Z ⟶ W) (z : Z) (w : W) (hzw : q z = w) {K L : Type u} [Field K]
    [Algebra (ResidueField (W.presheaf.stalk w)) K]
    [IsSepClosure (ResidueField (W.presheaf.stalk w)) K] [Field L]
    [Algebra (ResidueField (Z.presheaf.stalk z)) L]
    [IsSepClosure (ResidueField (Z.presheaf.stalk z)) L]
    (T : HenselizationTower (W.presheaf.stalk w) K)
    (U : HenselizationTower (Z.presheaf.stalk z) L) {C D : Type*} [CommRing C] [IsLocalRing C]
    [CommRing D] (eW : T.strictHenselization ≃+* C) (eZ : U.strictHenselization ≃+* D)
    (φ : C →+* D)
    (hc : ∀ a : Γ(W, ⊤),
      φ (eW (algebraMap _ T.strictHenselization (W.presheaf.germ ⊤ w trivial a))) =
        eZ (algebraMap _ U.strictHenselization
          (Z.presheaf.germ ⊤ z trivial ((Scheme.Γ.map q.op).hom a)))) :
    (∃ hN : IsNoetherianRing ((q.fiber (q z)).presheaf.stalk (q.asFiber z)),
      @Dualizing.IsGorensteinLocalRing
        ((q.fiber (q z)).presheaf.stalk (q.asFiber z)) _ hN _) ↔
    (∃ (hN : IsNoetherianRing (D ⧸ (maximalIdeal C).map φ))
        (hL : IsLocalRing (D ⧸ (maximalIdeal C).map φ)),
      @Dualizing.IsGorensteinLocalRing (D ⧸ (maximalIdeal C).map φ) _ hN hL) := by
  subst hzw
  obtain ⟨e⟩ := nonempty_quotient_maximalIdeal_map_ringEquiv K L T U eW eZ
    (q.stalkMap z).hom φ
    (RingHom.ext (apply_algebraMap_strictHenselization_eq q z T U eW eZ φ hc))
  have hlocal : IsLocalHom (q.stalkMap z).hom := q.toLRSHom.prop z
  have hI : (maximalIdeal (W.presheaf.stalk (q z))).map (q.stalkMap z).hom ≤
      maximalIdeal (Z.presheaf.stalk z) := map_maximalIdeal_le (q.stalkMap z).hom
  refine Iff.trans ?_
    ((exists_isGorensteinLocalRing_iff_of_ringEquiv
      (quotientStalkEquivFiberStalk q z)).symm.trans
      ((exists_isGorensteinLocalRing_quotient_strictHenselization_iff L U _ hI).trans
        (exists_isGorensteinLocalRing_iff_of_ringEquiv e)))
  exact ⟨fun h => ⟨h.1, inferInstance, h.2⟩, fun h => ⟨h.1, h.2.2⟩⟩

/-! ### The criterion on étale local rings -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- **Stacks 0E15.** A morphism of algebraic spaces over `S` is Gorenstein at the image of a
geometric point `x` of its source exactly when the canonical homomorphism of étale local rings
at `x` is flat and its local fibre ring is Noetherian, local and Gorenstein. -/
@[stacks 0E15 "etale_local_ring_criterion"]
theorem isGorensteinAt_iff_etaleLocalRingMap (hX : IsAlgebraicSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (f : X ⟶ Y) (x : GeometricPoint B S hS X) :
    IsGorensteinAt B S hS f x.image ↔
      ((etaleLocalRingMap hX f x).Flat ∧
        ∃ (hN : IsNoetherianRing
            (etaleLocalRing B S hS X x ⧸ etaleLocalFiberIdeal B S hS hX hY f x))
          (hL : IsLocalRing
            (etaleLocalRing B S hS X x ⧸ etaleLocalFiberIdeal B S hS hX hY f x)),
          @Dualizing.IsGorensteinLocalRing
            (etaleLocalRing B S hS X x ⧸ etaleLocalFiberIdeal B S hS hX hY f x) _ hN hL) := by
  refine and_congr (isFlatAt_iff_etaleLocalRingMap_flat hX hY f x) ?_
  obtain ⟨U, V, g, hcomm, hpoint, hVaffine⟩ :=
    exists_compatible_affine_chart_square B S hS hX hY f x
  have : IsAffine (chartScheme V.chart) := hVaffine
  set q : chartScheme U.chart ⟶ chartScheme V.chart := (BigFppfOver.toScheme B S hS).map g
  set u := (chartGeometricPoint U).hom (IsLocalRing.closedPoint
    (chartGeometricPoint U).residueField)
  set v := (chartGeometricPoint V).hom (IsLocalRing.closedPoint
    (chartGeometricPoint V).residueField)
  have huv : q u = v := congrArg
    (fun k => ((BigFppfOver.toScheme B S hS).map k)
      (show (BigFppfOver.toScheme B S hS).obj x.val.siteObject from
        IsLocalRing.closedPoint x.val.carrier)) hpoint
  set p : FieldValuedPoint B S hS (yoneda.obj U.chart.obj.left) :=
    { carrier := x.val.carrier
      contained := x.val.contained
      toBase := x.val.toBase
      value := U.point }
  have hmap : FieldValuedPoint.map B S hS _ U.chart.obj.hom p = x.val :=
    congrArg (fun z : X.obj (Opposite.op x.val.siteObject) => { x.val with value := z })
      U.point_comp
  set c : EtaleChartAtPoint B S hS f x.image :=
    { U := U.chart.obj.left
      V := V.chart.obj.left
      a := U.chart.obj.hom
      b := V.chart.obj.hom
      h := g
      a_etale := U.chart.property
      b_etale := V.chart.property
      comm := hcomm.symm
      representative := p
      point := IsLocalRing.closedPoint p.carrier
      maps_to := congrArg (FieldValuedPoint.class B S hS X) hmap }
  have hchart : HoldsOnEveryEtaleChartAtPoint B S hS
      (@_root_.AlgebraicGeometry.HasGorensteinFiberLocalRing.{u}) f x.image ↔
      _root_.AlgebraicGeometry.HasGorensteinFiberLocalRing
        (MorphismOfGerms.ofSchemeHom q u) :=
    ⟨fun h => h c, fun h => (holdsOnEveryEtaleChartAtPoint_iff_some B S hS
      (@_root_.AlgebraicGeometry.HasGorensteinFiberLocalRing.{u})
      _root_.AlgebraicGeometry.hasGorensteinFiberLocalRing_isEtaleLocalOnSourceAndTarget
      hX hY f x.image).mpr ⟨c, h⟩⟩
  rw [hchart, _root_.AlgebraicGeometry.hasGorensteinFiberLocalRing_ofSchemeHom_iff]
  have : IsLocalRing (etaleLocalRing B S hS Y (geometricPointMap f x)) :=
    isLocalRing_etaleLocalRing B S hS Y hY (geometricPointMap f x)
  set E := bigEtaleSiteOfFppfSite B
  set TU := henselizationTower ((chartScheme U.chart).presheaf.stalk u)
    (separableClosure (ResidueField ((chartScheme U.chart).presheaf.stalk u))
      (chartGeometricPoint U).residueField)
  set TV := henselizationTower ((chartScheme V.chart).presheaf.stalk v)
    (separableClosure (ResidueField ((chartScheme V.chart).presheaf.stalk v))
      (chartGeometricPoint V).residueField)
  refine exists_isGorensteinLocalRing_fiberStalk_iff q u v huv TV TU
    (strictHenselizationEquivEtaleLocalRing hY V E V.chart.obj.left.left.property TV)
    (strictHenselizationEquivEtaleLocalRing hX U E U.chart.obj.left.left.property TU)
    (etaleLocalRingMap hX f x) fun a => ?_
  calc
    _ = (etaleLocalRingMap hX f x)
        (etaleLocalRingGerm B S hS Y (geometricPointMap f x) (Opposite.op V) a) :=
      congrArg _ (strictHenselizationEquivEtaleLocalRing_germ hY V E
        V.chart.obj.left.left.property TV a)
    _ = etaleLocalRingGerm B S hS X x (Opposite.op U) ((Scheme.Γ.map q.op).hom a) :=
      (congrArg (fun k => k a)
        (etaleLocalRingMap_isEtaleLocalRingMap hX f x U V g hcomm hpoint)).symm
    _ = _ := (strictHenselizationEquivEtaleLocalRing_germ hX U E
      U.chart.obj.left.left.property TU ((Scheme.Γ.map q.op).hom a)).symm

end AlgebraicGeometry.Space

end
