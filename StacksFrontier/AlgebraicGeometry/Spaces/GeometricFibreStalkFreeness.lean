@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u m

/-- Flatness of the fibre of a module over the fibre of the base depends only on the ring
homomorphism along which the fibre is formed, not on the name of that homomorphism: equal
homomorphisms give the same condition. -/
theorem Module.flatQuotSMul_congr_hom {T U : Type*} [CommRing T] [CommRing U]
    {ψ ψ' : T →+* U} (hψ : ψ = ψ') (I : Ideal T) (M : Type*) [AddCommGroup M] [Module U M] :
    Module.FlatQuotSMul ψ I (I.map ψ) rfl M ↔
      Module.FlatQuotSMul ψ' I (I.map ψ') rfl M := by
  subst hψ
  exact Iff.rfl

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The canonical homomorphism of étale local rings at an identity -/

/-- The canonical homomorphism of étale local rings of Stacks 04NG induced by the identity of an
algebraic space at a geometric point is the identity of its étale local ring. -/
theorem etaleLocalRingMap_id {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : IsAlgebraicSpace B S hS F) (x : GeometricPoint B S hS F) :
    etaleLocalRingMap hF (𝟙 F) x = RingHom.id (etaleLocalRing B S hS F x) := by
  refine (eq_etaleLocalRingMap hF (𝟙 F) x ?_).symm
  intro U V g hcomm hpoint
  have hw : yoneda.map g ≫ V.chart.obj.hom = U.chart.obj.hom := by
    rw [← hcomm, Category.comp_id]
  let m : U ⟶ V :=
    { hom := ObjectProperty.homMk (CostructuredArrow.homMk g hw)
      point_comp := hpoint }
  have h := colimit.w (SmallEtaleNeighborhood.sections (liftedStructurePresheaf B S hS F)) m.op
  ext a
  exact congrArg (fun q => q.hom (ULift.up a)) h

/-- Flatness of an `𝒪_X`-module over `X` itself at a geometric point is flatness of its
geometric stalk over the étale local ring there. -/
theorem isFlatOverAtGeometricPoint_id_iff {X : AlgebraicSpaces B S hS}
    (F : Modules.{u, m} B S hS X.1 X.2) (xbar : GeometricPoint B S hS X.1) :
    IsFlatOverAtGeometricPoint B S hS (𝟙 X) F xbar ↔
      Module.Flat (etaleLocalRing B S hS X.1 xbar) (geometricModuleStalk B S hS X xbar F) := by
  have hpsi : etaleLocalRingMap X.2 (𝟙 X : X ⟶ X).hom xbar =
      RingHom.id (etaleLocalRing B S hS X.1 xbar) :=
    etaleLocalRingMap_id B S hS X.2 xbar
  unfold IsFlatOverAtGeometricPoint
  rw [hpsi]
  exact Iff.rfl

/-! ### The geometric fibre stalk and its base ring -/

/-- The ideal `𝔪_{ȳ} 𝒪_{X, x̄}` of the étale local ring of `X` at a geometric point `x̄`: the
image, along the canonical map of étale local rings of Stacks 04NG, of the maximal ideal of the
étale local ring of `Y` at `ȳ = f ∘ x̄`. -/
def geometricFibreIdeal {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) : Ideal (etaleLocalRing B S hS X.1 xbar) :=
  letI : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
  (IsLocalRing.maximalIdeal
      (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))).map
    (etaleLocalRingMap X.2 f.hom xbar)

/-- The local ring `𝒪_{X_{ȳ}, x̄}` of the geometric fibre of `f` through `x̄`, in the quotient
form `𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`. -/
abbrev geometricFibreLocalRing {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) : Type (u + 1) :=
  etaleLocalRing B S hS X.1 xbar ⧸ geometricFibreIdeal B S hS f xbar

/-- The stalk `(F_{ȳ})_{x̄}` at `x̄` of the restriction of `F` to the geometric fibre of `f`
through `x̄`, in the quotient form `F_{x̄} / 𝔪_{ȳ} F_{x̄}`, a module over
`AlgebraicGeometry.Space.geometricFibreLocalRing`. -/
abbrev geometricFibreModuleStalk {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (F : Modules.{u, m} B S hS X.1 X.2) (xbar : GeometricPoint B S hS X.1) :
    Type (max (u + 1) m) :=
  geometricModuleStalk B S hS X xbar F ⧸
    geometricFibreIdeal B S hS f xbar • (⊤ : Submodule (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F))

/-! ### The fibre local ring is a local ring -/

/-- The ideal `𝔪_{ȳ} 𝒪_{X, x̄}` is contained in the maximal ideal of `𝒪_{X, x̄}`, because the
canonical map of étale local rings of Stacks 04NG is a local homomorphism. -/
theorem geometricFibreIdeal_le_maximalIdeal {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) :
    letI : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
      isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
    geometricFibreIdeal B S hS f xbar ≤
      IsLocalRing.maximalIdeal (etaleLocalRing B S hS X.1 xbar) := by
  let : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  let : IsLocalHom (etaleLocalRingMap X.2 f.hom xbar) :=
    isLocalHom_etaleLocalRingMap B S hS X.2 Y.2 f.hom xbar
  exact IsLocalRing.map_maximalIdeal_le _

/-- The ideal `𝔪_{ȳ} 𝒪_{X, x̄}` is a proper ideal, being contained in the maximal ideal of the
local ring `𝒪_{X, x̄}`. -/
theorem geometricFibreIdeal_ne_top {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) : geometricFibreIdeal B S hS f xbar ≠ ⊤ := by
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  exact ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    (geometricFibreIdeal_le_maximalIdeal B S hS f xbar)

/-- The local ring of the geometric fibre is nontrivial, the ideal defining it being proper. -/
theorem nontrivial_geometricFibreLocalRing {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) :
    Nontrivial (geometricFibreLocalRing B S hS f xbar) :=
  Ideal.Quotient.nontrivial_iff.mpr (geometricFibreIdeal_ne_top B S hS f xbar)

/-- The local ring `𝒪_{X_{ȳ}, x̄}` of the geometric fibre is a local ring: it is a nontrivial
quotient of the local ring `𝒪_{X, x̄}`. -/
theorem isLocalRing_geometricFibreLocalRing {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) :
    IsLocalRing (geometricFibreLocalRing B S hS f xbar) := by
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  let : Nontrivial (geometricFibreLocalRing B S hS f xbar) :=
    nontrivial_geometricFibreLocalRing B S hS f xbar
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-! ### Flatness and freeness of the fibre stalk -/

/-- **Stacks 0CZS, (2) implies (1).** A free fibre stalk `(F_{ȳ})_{x̄}` is a flat
`𝒪_{X_{ȳ}, x̄}`-module.

The fibre stalk and its base ring are taken in the quotient form `F_{x̄} / 𝔪_{ȳ} F_{x̄}` over
`𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`, which is condition (1) of Stacks 05WY for `X ⟶ X ⟶ Y` and is how
the source's own proof reads clause (1); their identification with the étale local ring and the
geometric stalk on a geometric fibre `X_{ȳ}` is not available, the fibre of a morphism of
algebraic spaces over a point of the target not being constructed in this library.  Neither
flatness of `F` at `x` over `Y`, nor local finite presentation of `f`, nor finite presentation
of `F` is assumed, which generalises the source. -/
@[stacks 0CZS "(2) implies (1), with the fibre stalk and its base ring in the QUOTIENT FORM \
F_xbar / m_ybar F_xbar over O_{X, xbar} / m_ybar O_{X, xbar} (the geometric fibre X_ybar is not \
constructed in this library); flatness of F over Y and finite presentation are not assumed"]
theorem flat_geometricFibreModuleStalk_of_free {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (F : Modules.{u, m} B S hS X.1 X.2) (xbar : GeometricPoint B S hS X.1)
    (hfree : Module.Free (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar)) :
    Module.Flat (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar) :=
  have := hfree
  Module.Flat.of_free

/-- For a fibre stalk which is a finite module over the local ring of the geometric fibre,
flatness and freeness of `(F_{ȳ})_{x̄}` over `𝒪_{X_{ȳ}, x̄}` agree: the fibre local ring is local,
so Stacks 00NZ applies. This is the general form from which
`AlgebraicGeometry.Space.flat_geometricFibreModuleStalk_iff_free_of_isFinitePresentation`
obtains the equivalence of clauses (1) and (2) of Stacks 0CZS.

The fibre stalk and its base ring are taken in the quotient form `F_{x̄} / 𝔪_{ȳ} F_{x̄}` over
`𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`, which is condition (1) of Stacks 05WY for `X ⟶ X ⟶ Y` and is how
the source's own proof reads clause (1); the geometric fibre `X_{ȳ}` itself is not constructed
in this library.  Finiteness of the fibre stalk is a hypothesis here rather than a consequence of
finite presentation of `F` as in the source, so that the statement applies to any module with a
finite fibre stalk and in any module universe;
`AlgebraicGeometry.Space.flat_geometricFibreModuleStalk_iff_free_of_isFinitePresentation`
discharges it for a finitely presented module.  Neither flatness of `F` at `x` over `Y` nor
local finite presentation of `f` is assumed, which generalises the source. -/
theorem flat_geometricFibreModuleStalk_iff_free {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (F : Modules.{u, m} B S hS X.1 X.2) (xbar : GeometricPoint B S hS X.1)
    (hfin : Module.Finite (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar)) :
    Module.Flat (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) ↔
      Module.Free (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) := by
  let : IsLocalRing (geometricFibreLocalRing B S hS f xbar) :=
    isLocalRing_geometricFibreLocalRing B S hS f xbar
  let : Module.Finite (geometricFibreLocalRing B S hS f xbar)
    (geometricFibreModuleStalk B S hS f F xbar) := hfin
  exact ⟨fun h => have := h; Module.free_of_flat_of_isLocalRing,
    fun h => flat_geometricFibreModuleStalk_of_free B S hS f F xbar h⟩

/-- The fibre stalk `(F_{ȳ})_{x̄}` of a quasi-coherent module of finite type is a finite module
over the local ring `𝒪_{X_{ȳ}, x̄}` of the geometric fibre: the geometric stalk `F_{x̄}` is a
finite `𝒪_{X, x̄}`-module, so its quotient by `𝔪_{ȳ} F_{x̄}` is a finite `𝒪_{X, x̄}`-module, and
the scalars descend along the surjection `𝒪_{X, x̄} → 𝒪_{X_{ȳ}, x̄}`. -/
theorem module_finite_geometricFibreModuleStalk {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (F : Modules.{u, u} B S hS X.1 X.2) (hqc : F.IsQuasicoherentOnSite)
    (hft : SheafOfModules.IsFiniteTypeOnSite F) (xbar : GeometricPoint B S hS X.1) :
    Module.Finite (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar) :=
  have : Module.Finite (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F) :=
    module_finite_geometricModuleStalk B S hS X F hqc hft xbar
  Module.Finite.of_restrictScalars_finite (etaleLocalRing B S hS X.1 xbar) _ _

/-- **Stacks 0CZS, (1) is equivalent to (2).** For a finitely presented `𝒪_X`-module `F`,
flatness and freeness of the fibre stalk `(F_{ȳ})_{x̄}` over the local ring `𝒪_{X_{ȳ}, x̄}` of the
geometric fibre agree.

The fibre stalk and its base ring are taken in the quotient form `F_{x̄} / 𝔪_{ȳ} F_{x̄}` over
`𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`, which is condition (1) of Stacks 05WY for `X ⟶ X ⟶ Y` and is how
the source's own proof reads clause (1); the geometric fibre `X_{ȳ}` itself is not constructed in
this library.  Neither flatness of `F` at `x` over `Y` nor local finite presentation of `f` is
assumed, which generalises the source: both clauses are conditions on the fibre stalk alone. -/
@[stacks 0CZS "(1) iff (2) under the source's own hypotheses, with the fibre stalk and base \
ring in the QUOTIENT FORM F_xbar / m_ybar F_xbar over O_{X, xbar} / m_ybar O_{X, xbar} (the \
geometric fibre X_ybar is not constructed in this library)"]
theorem flat_geometricFibreModuleStalk_iff_free_of_isFinitePresentation
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsFinitePresentationOnSite] (xbar : GeometricPoint B S hS X.1) :
    Module.Flat (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) ↔
      Module.Free (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) :=
  flat_geometricFibreModuleStalk_iff_free B S hS f F xbar
    (module_finite_geometricFibreModuleStalk B S hS f F inferInstance inferInstance xbar)

/-! ### Clause (1) as condition (1) of Stacks 05WY at the identity -/

/-- Clause (1) of Stacks 0CZS, in the quotient form `F_{x̄} / 𝔪_{ȳ} F_{x̄}` over
`𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`, is condition (1) of Stacks 05WY for `X ⟶ X ⟶ Y`, which is how the
source's proof reads it: the canonical homomorphism of étale local rings at `𝟙 X` is the
identity, so the two ideals that condition carries are both `𝔪_{ȳ} 𝒪_{X, x̄}`. -/
theorem isFibreFlatOverAtGeometricPoint_id_iff {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (F : Modules.{u, m} B S hS X.1 X.2) (xbar : GeometricPoint B S hS X.1) :
    IsFibreFlatOverAtGeometricPoint B S hS (𝟙 X) f F xbar ↔
      Module.Flat (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) := by
  let : Algebra (etaleLocalRing B S hS X.1 xbar) (etaleLocalRing B S hS X.1 xbar) :=
    Algebra.id _
  refine Iff.trans (Module.flatQuotSMul_congr
    (etaleLocalRingMap X.2 (𝟙 X : X ⟶ X).hom xbar) rfl (Ideal.map_map _ _).symm
    (Ideal.map_map _ _).symm rfl (geometricModuleStalk B S hS X xbar F)) ?_
  refine Iff.trans (Module.flatQuotSMul_congr_hom
    (etaleLocalRingMap_id B S hS X.2 xbar) (geometricFibreIdeal B S hS f xbar)
    (geometricModuleStalk B S hS X xbar F)) ?_
  exact Stacks.Flatness.flatQuotSMul_iff_flat_quotient_smul_top
    (geometricFibreIdeal B S hS f xbar)
    ((geometricFibreIdeal B S hS f xbar).map (RingHom.id _)) rfl

/-! ### Freeness of the geometric stalk from clause (1) -/

/-- **Stacks 0CZS, the first step of (1) implies (4).** Let `f : X ⟶ Y` be locally of finite
presentation, let `F` be a quasi-coherent `𝒪_X`-module of finite presentation on charts and let
`x̄` be a geometric point of `X`.  If `F` is flat at `x` over `Y` and the fibre stalk
`(F_{ȳ})_{x̄}` is a flat `𝒪_{X_{ȳ}, x̄}`-module, then the geometric stalk `F_{x̄}` is a free
`𝒪_{X, x̄}`-module.

This is Stacks 05X0 at `𝟙 X` over `f`, whose condition (1) is the standing flatness together
with clause (1) and whose condition (2) gives flatness of `F_{x̄}` over `𝒪_{X, x̄}`; the stalk is
a finite module over a local ring, so flatness is freeness (Stacks 00NZ).  Stacks 05X0 assumes
the stalk nonzero, and a zero stalk is free, so the two cases are treated separately. -/
theorem free_geometricModuleStalk_of_flat_geometricFibreModuleStalk
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite] (hf : IsLocallyOfFinitePresentation B S hS f.hom)
    (hfp : IsFinitePresentationOnCharts B S hS X.2 F)
    (xbar : GeometricPoint B S hS X.1)
    (hflat : IsFlatOverAtGeometricPoint B S hS f F xbar)
    (hfibre : Module.Flat (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar)) :
    Module.Free (etaleLocalRing B S hS X.1 xbar) (geometricModuleStalk B S hS X xbar F) := by
  obtain ⟨N⟩ := nonempty_smallEtaleNeighborhood X.2 xbar
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  have : Module.Finite (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F) := finite_geometricModuleStalk B S hS N F hfp
  by_cases hsub : Subsingleton (geometricModuleStalk B S hS X xbar F)
  · have := hsub
    exact Module.Free.of_subsingleton _ _
  · have hne : Nontrivial (geometricModuleStalk B S hS X xbar F) :=
      not_subsingleton_iff_nontrivial.mp hsub
    have hfib : IsFibreFlatOverAtGeometricPoint B S hS (𝟙 X) f F xbar :=
      (isFibreFlatOverAtGeometricPoint_id_iff B S hS f F xbar).2 hfibre
    have hcomp : IsFlatOverAtGeometricPoint B S hS (𝟙 X ≫ f) F xbar := by
      rw [Category.id_comp]
      exact hflat
    have hp : IsLocallyOfFinitePresentation B S hS (𝟙 X ≫ f).hom := by
      rw [Category.id_comp]
      exact hf
    have hq : IsLocallyOfFiniteType B S hS f.hom :=
      isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B S hS hf
    have key := (isFlatOverAtGeometricPoint_and_isFibreFlat_iff B S hS (𝟙 X) f F hp hq hfp
      xbar hne).1 ⟨hcomp, hfib⟩
    have : Module.Flat (etaleLocalRing B S hS X.1 xbar)
        (geometricModuleStalk B S hS X xbar F) :=
      (isFlatOverAtGeometricPoint_id_iff B S hS F xbar).1 key.2
    exact Module.free_of_flat_of_isLocalRing

/-! ### Clause (1) from freeness of the geometric stalk -/

/-- **A free geometric stalk has a free fibre stalk.**  If `F_{x̄}` is a free `𝒪_{X, x̄}`-module
then `(F_{ȳ})_{x̄} = F_{x̄} / 𝔪_{ȳ} F_{x̄}` is a free `𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`-module.

The fibre stalk is the base change of `F_{x̄}` along `𝒪_{X, x̄} → 𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}`
(`TensorProduct.quotTensorEquivQuotSMul`), and a base change of a free module is free. -/
theorem free_geometricFibreModuleStalk_of_free_geometricModuleStalk
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, m} B S hS X.1 X.2)
    (xbar : GeometricPoint B S hS X.1)
    (hfree : Module.Free (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F)) :
    Module.Free (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar) := by
  have : Module.Free (etaleLocalRing B S hS X.1 xbar)
    (geometricModuleStalk B S hS X xbar F) := hfree
  exact Module.Free.of_equiv
    ((TensorProduct.quotTensorEquivQuotSMul
        ↥(geometricModuleStalk B S hS X xbar F)
        (geometricFibreIdeal B S hS f xbar)).extendScalarsOfSurjective
      (Ideal.Quotient.mk_surjective (I := geometricFibreIdeal B S hS f xbar)))

/-- **Clause (1) of Stacks 0CZS holds as soon as the geometric stalk `F_{x̄}` is free**, with no
hypothesis on `f` or on `F`: the fibre stalk is then free, hence flat.

This is the converse of
`AlgebraicGeometry.Space.free_geometricModuleStalk_of_flat_geometricFibreModuleStalk`, and
unlike it needs neither local finite presentation of `f`, nor finite presentation of `F`, nor
flatness of `F` over `Y`. -/
theorem flat_geometricFibreModuleStalk_of_free_geometricModuleStalk
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, m} B S hS X.1 X.2)
    (xbar : GeometricPoint B S hS X.1)
    (hfree : Module.Free (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F)) :
    Module.Flat (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar) :=
  flat_geometricFibreModuleStalk_of_free B S hS f F xbar
    (free_geometricFibreModuleStalk_of_free_geometricModuleStalk B S hS f F xbar hfree)

/-- **Clause (1) of Stacks 0CZS is freeness of the geometric stalk `F_{x̄}`**, under the source's
own hypotheses.  The forward direction is Stacks 05X0 at `𝟙 X` over `f`; the converse is base
change along `𝒪_{X, x̄} → 𝒪_{X, x̄} / 𝔪_{ȳ} 𝒪_{X, x̄}` and uses none of the hypotheses. -/
theorem flat_geometricFibreModuleStalk_iff_free_geometricModuleStalk
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite] (hf : IsLocallyOfFinitePresentation B S hS f.hom)
    (hfp : IsFinitePresentationOnCharts B S hS X.2 F)
    (xbar : GeometricPoint B S hS X.1)
    (hflat : IsFlatOverAtGeometricPoint B S hS f F xbar) :
    Module.Flat (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) ↔
      Module.Free (etaleLocalRing B S hS X.1 xbar) (geometricModuleStalk B S hS X xbar F) :=
  ⟨free_geometricModuleStalk_of_flat_geometricFibreModuleStalk B S hS f F hf hfp xbar hflat,
    flat_geometricFibreModuleStalk_of_free_geometricModuleStalk B S hS f F xbar⟩

/-! ### Freeness of the chart stalk from freeness of the geometric stalk -/

/-- **Freeness of the geometric stalk descends to the Zariski stalk of an étale scheme chart.**
Let `F` be a quasi-coherent `𝒪_X`-module of finite presentation on charts, let `x̄` be a
geometric point of `X` and let `φ : (U, u) → (X, x̄)` be an étale neighbourhood whose chart `U` is
a scheme.  If the geometric stalk `F_{x̄}` is a free `𝒪_{X, x̄}`-module, then the Zariski stalk
`(φ^* F)_u` is a free `𝒪_{U, u}`-module.

This is the first step of the source's `(1) ⟹ (4)` for Stacks 0CZS, which reads clause (4) on an
étale scheme chart.  Stacks 05VP presents `F_{x̄}` as `(φ^* F)_u ⊗_{𝒪_{U, u}} 𝒪_{X, x̄}` and the
base-change map is faithfully flat, so flatness descends by
`Module.Flat.of_flat_tensorProduct`; the chart stalk is finitely presented over the local ring
`𝒪_{U, u}`, so flatness is freeness (Stacks 00NZ).  No rank is fixed:
`AlgebraicGeometry.Space.nonempty_linearEquiv_chartZariskiModuleStalk_of_geometricModuleStalk`
is the rank-one form of the same descent. -/
theorem free_chartZariskiModuleStalk_of_free_geometricModuleStalk {X : AlgebraicSpaces B S hS}
    {xbar : GeometricPoint B S hS X.1} (N : SmallEtaleNeighborhood xbar)
    (F : Modules.{u, u} B S hS X.1 X.2) [F.IsQuasicoherentOnSite]
    (hfp : IsFinitePresentationOnCharts B S hS X.2 F)
    (hfree : Module.Free (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F)) :
    Module.Free ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F) := by
  let : Algebra ↥(chartLocalRing B S hS X.1 N) ↥(etaleLocalRing B S hS X.1 xbar) :=
    (chartLocalRingToEtaleLocalRing B S hS X.1 X.2 N).toAlgebra
  have : Module.FaithfullyFlat ↥(chartLocalRing B S hS X.1 N)
      ↥(etaleLocalRing B S hS X.1 xbar) :=
    faithfullyFlat_chartLocalRingToEtaleLocalRing B S hS X.1 X.2 N
  have := isIso_chartStalkTensorComparison B S hS X.2 N F
  have : Module.Flat ↥(etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F) :=
    have := hfree
    Module.Flat.of_free
  have : Module.Flat ↥(etaleLocalRing B S hS X.1 xbar)
      (TensorProduct ↥(chartLocalRing B S hS X.1 N) ↥(etaleLocalRing B S hS X.1 xbar)
        ↥(chartZariskiModuleStalk B S hS X.1 X.2 N F)) :=
    Module.Flat.of_linearEquiv
      (asIso (chartStalkTensorComparison B S hS X.2 N F)).toLinearEquiv
  have : Module.Flat ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F) :=
    Module.Flat.of_flat_tensorProduct _ _ ↥(etaleLocalRing B S hS X.1 xbar)
  have : Module.FinitePresentation ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F) :=
    finitePresentation_chartZariskiModuleStalk B S hS N F hfp
  exact Module.free_of_flat_of_isLocalRing

/-- **Freeness of the Zariski stalk of an étale scheme chart lifts to the geometric stalk**, the
converse of `AlgebraicGeometry.Space.free_chartZariskiModuleStalk_of_free_geometricModuleStalk`
and the first step of the source's `(4) ⟹ (1)` for Stacks 0CZS.

Stacks 05VP presents `F_{x̄}` as the base change `(φ^* F)_u ⊗_{𝒪_{U, u}} 𝒪_{X, x̄}`
(`AlgebraicGeometry.Space.isIso_chartStalkTensorComparison`), and a base change of a free module
is free.  Faithful flatness of the base-change map, which the descending direction needs, plays
no part here, and neither does finite presentation of `F` on charts. -/
theorem free_geometricModuleStalk_of_free_chartZariskiModuleStalk {X : AlgebraicSpaces B S hS}
    {xbar : GeometricPoint B S hS X.1} (N : SmallEtaleNeighborhood xbar)
    (F : Modules.{u, u} B S hS X.1 X.2) [F.IsQuasicoherentOnSite]
    (hfree : Module.Free ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F)) :
    Module.Free (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F) := by
  let : Algebra ↥(chartLocalRing B S hS X.1 N) ↥(etaleLocalRing B S hS X.1 xbar) :=
    (chartLocalRingToEtaleLocalRing B S hS X.1 X.2 N).toAlgebra
  have := isIso_chartStalkTensorComparison B S hS X.2 N F
  have : Module.Free ↥(chartLocalRing B S hS X.1 N)
    (chartZariskiModuleStalk B S hS X.1 X.2 N F) := hfree
  have : Module.Free (etaleLocalRing B S hS X.1 xbar)
      (chartStalkTensorEtaleLocalRing B S hS X.1 X.2 N F) :=
    Algebra.TensorProduct.instFree ↥(chartLocalRing B S hS X.1 N)
      ↥(etaleLocalRing B S hS X.1 xbar) ↥(chartZariskiModuleStalk B S hS X.1 X.2 N F)
  exact Module.Free.of_equiv (asIso (chartStalkTensorComparison B S hS X.2 N F)).toLinearEquiv

/-- **Freeness of the geometric stalk and freeness of the Zariski stalk of an étale scheme chart
are the same condition**, for a quasi-coherent module of finite presentation on charts: Stacks
05VP makes each the base change of the other's module along a faithfully flat map. -/
theorem free_geometricModuleStalk_iff_free_chartZariskiModuleStalk {X : AlgebraicSpaces B S hS}
    {xbar : GeometricPoint B S hS X.1} (N : SmallEtaleNeighborhood xbar)
    (F : Modules.{u, u} B S hS X.1 X.2) [F.IsQuasicoherentOnSite]
    (hfp : IsFinitePresentationOnCharts B S hS X.2 F) :
    Module.Free (etaleLocalRing B S hS X.1 xbar) (geometricModuleStalk B S hS X xbar F) ↔
      Module.Free ↥(chartLocalRing B S hS X.1 N)
        (chartZariskiModuleStalk B S hS X.1 X.2 N F) :=
  ⟨free_chartZariskiModuleStalk_of_free_geometricModuleStalk B S hS N F hfp,
    free_geometricModuleStalk_of_free_chartZariskiModuleStalk B S hS N F⟩

/-! ### Clause (4): finite freeness on a Zariski open of an étale scheme chart -/

/-- **Stacks 0CZS, clause (4).**  Let `f : X ⟶ Y` be locally of finite presentation, let `F` be
a quasi-coherent `𝒪_X`-module of finite presentation on charts and let `x̄` be a geometric point
of `X`.  If `F` is flat at `x` over `Y` and the fibre stalk `(F_{ȳ})_{x̄}` is a flat
`𝒪_{X_{ȳ}, x̄}`-module — clause (1) — then `F` is finite free in an étale neighbourhood of `x` in
`X`: there are an étale scheme chart `φ : (U, u) → (X, x̄)`, a Zariski open `W ⊆ U` containing
`u` and a rank `r` such that `(φ^* F)|_W` is free on `r` generators.

This is the source's own `(1) ⟹ (4)`, in the reading its proof produces.  Clause (1) makes the
geometric stalk `F_{x̄}` free over `𝒪_{X, x̄}`
(`AlgebraicGeometry.Space.free_geometricModuleStalk_of_flat_geometricFibreModuleStalk`, which is
Stacks 05X0 at `𝟙 X` over `f`); that descends along the faithfully flat comparison of
Stacks 05VP to freeness of the Zariski stalk `(φ^* F)_u` over `𝒪_{U, u}`
(`AlgebraicGeometry.Space.free_chartZariskiModuleStalk_of_free_geometricModuleStalk`); and the
chart restriction is of finite presentation on the Zariski site of `U`, which is what
`AlgebraicGeometry.Space.IsFinitePresentationOnCharts` says, so Stacks 0B8J spreads a basis of
that stalk to a trivialization on a Zariski open neighbourhood of `u`.  0B8J is used through
`Stacks.StalkFiniteType.exists_over_iso_free_of_stalk_basis`, which takes the basis over the
local ring `𝒪_{U, u}` rather than over the `RingCat`-valued stalk.  The open `W` is itself an
étale neighbourhood of `x̄` in `X`, by
`AlgebraicGeometry.Space.chartOpenNeighborhood`. -/
@[stacks 0CZS "(1) implies (4) under the source's own hypotheses, with clause (1) in the \
QUOTIENT FORM F_xbar / m_ybar F_xbar over O_{X, xbar} / m_ybar O_{X, xbar} (the geometric fibre \
X_ybar is not constructed in this library) and clause (4) in the reading the source's proof \
produces: an etale SCHEME chart (U, u) over (X, xbar) together with a Zariski open W of U \
containing u on which the chart restriction phi^* F becomes free on finitely many generators. \
That W is an etale neighbourhood of xbar in X by chartOpenNeighborhood. The finite freeness is \
read as freeness of (phi^* F)|_W on the slice of the Zariski site of U at W; identifying that \
with the chart restriction of F to W read on the Zariski site of W itself is an equivalence of \
sites and is NOT claimed. Clause (3) is not statable: it needs the geometric fibre X_ybar as an \
algebraic space."]
theorem exists_chartOpen_over_iso_free_of_flat_geometricFibreModuleStalk
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite] (hf : IsLocallyOfFinitePresentation B S hS f.hom)
    (hfp : IsFinitePresentationOnCharts B S hS X.2 F)
    (xbar : GeometricPoint B S hS X.1)
    (hflat : IsFlatOverAtGeometricPoint B S hS f F xbar)
    (hfibre : Module.Flat (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar)) :
    ∃ (N : SmallEtaleNeighborhood xbar) (W : (chartScheme N.chart).Opens)
        (_ : chartPoint B S hS X.1 N ∈ W) (r : ℕ),
      Nonempty ((restrictToChart B S hS X.2 F N.chart).over W ≅
        SheafOfModules.free (ULift.{u} (Fin r))) := by
  obtain ⟨N⟩ := nonempty_smallEtaleNeighborhood X.2 xbar
  have hfree : Module.Free (etaleLocalRing B S hS X.1 xbar)
      (geometricModuleStalk B S hS X xbar F) :=
    free_geometricModuleStalk_of_flat_geometricFibreModuleStalk B S hS f F hf hfp xbar hflat
      hfibre
  have : Module.Free ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F) :=
    free_chartZariskiModuleStalk_of_free_geometricModuleStalk B S hS N F hfp hfree
  have : Module.FinitePresentation ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F) :=
    finitePresentation_chartZariskiModuleStalk B S hS N F hfp
  have : (restrictToChart B S hS X.2 F N.chart).IsFinitePresentation := hfp N.chart
  let b := Module.Free.chooseBasis ↥(chartLocalRing B S hS X.1 N)
    ↥(chartZariskiModuleStalk B S hS X.1 X.2 N F)
  let e : Module.Free.ChooseBasisIndex ↥(chartLocalRing B S hS X.1 N)
      ↥(chartZariskiModuleStalk B S hS X.1 X.2 N F) ≃
      ULift.{u} (Fin (Nat.card (Module.Free.ChooseBasisIndex ↥(chartLocalRing B S hS X.1 N)
        ↥(chartZariskiModuleStalk B S hS X.1 X.2 N F)))) :=
    (Finite.equivFin _).trans Equiv.ulift.symm
  obtain ⟨W, hw, he⟩ := Stacks.StalkFiniteType.exists_over_iso_free_of_stalk_basis
    (restrictToChart B S hS X.2 F N.chart) (chartPoint B S hS X.1 N)
    ((b.map (chartZariskiModuleStalkStalkEquiv B S hS X.2 N F)).reindex e)
  exact ⟨N, W, hw, _, he⟩

/-! ### Clause (4) implies clause (1) -/

/-- **A trivialization of the chart restriction on a Zariski open makes the Zariski stalk at a
point of that open a free module**, the inverse of the Stacks 0B8J step used in clause (4).

The isomorphism is given on the slice of the Zariski site of the chart at `W`; the genuine
restriction to the open subspace `W` is the same sheaf of modules, by
`LocallyFreeRank.restrictModIsoOver`, and `SheafOfModules.mapFreeIso` carries the free
module across the comparison, so the data is a `LocallyFreeRank.Trivialization` on `W`.
Its effect on the stalk is
`LocallyFreeRank.Trivialization.stalk_linearEquiv_finsupp`, and
`AlgebraicGeometry.Space.chartZariskiModuleStalkStalkEquiv` identifies the stalk it computes
with the Zariski stalk of Stacks 05VP.  No hypothesis on `F` or on the rank is used. -/
theorem free_chartZariskiModuleStalk_of_over_iso_free {X : AlgebraicSpaces B S hS}
    {xbar : GeometricPoint B S hS X.1} (N : SmallEtaleNeighborhood xbar)
    (F : Modules.{u, u} B S hS X.1 X.2) (W : (chartScheme N.chart).Opens)
    (hw : chartPoint B S hS X.1 N ∈ W) {r : ℕ}
    (e : (restrictToChart B S hS X.2 F N.chart).over W ≅
      SheafOfModules.free (ULift.{u} (Fin r))) :
    Module.Free ↥(chartLocalRing B S hS X.1 N)
      (chartZariskiModuleStalk B S hS X.1 X.2 N F) := by
  let t : _root_.LocallyFreeRank.Trivialization
      (TopCat.of ↥(etaleChartScheme B S hS N.chart))
      (etaleChartScheme B S hS N.chart).ringCatSheaf
      (restrictToChart B S hS X.2 F N.chart) W :=
    { ι := ULift.{u} (Fin r)
      iso := (_root_.LocallyFreeRank.restrictModIsoOver _ W _ _).symm ≪≫
        (W.sheafOfModulesEquivOver
            (etaleChartScheme B S hS N.chart).ringCatSheaf).functor.mapIso e ≪≫
          (SheafOfModules.mapFreeIso (W.sheafOfModulesEquivOver
            (etaleChartScheme B S hS N.chart).ringCatSheaf).functor
            (ULift.{u} (Fin r)) (Iso.refl _)).symm }
  obtain ⟨g⟩ := _root_.LocallyFreeRank.Trivialization.stalk_linearEquiv_finsupp
    (TopCat.of ↥(etaleChartScheme B S hS N.chart))
    (etaleChartScheme B S hS N.chart).sheaf
    (restrictToChart B S hS X.2 F N.chart) (chartPoint B S hS X.1 N) hw t
  have g' : ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (chartRestrictionPresheafOfModules B S hS X.2 N F).presheaf
        (chartPoint B S hS X.1 N))
      ≃ₗ[↥(chartLocalRing B S hS X.1 N)] (t.ι →₀ ↥(chartLocalRing B S hS X.1 N)) := g
  exact Module.Free.of_equiv
    ((chartZariskiModuleStalkStalkEquiv B S hS X.2 N F).trans g').symm

/-- **Stacks 0CZS, clause (4) implies clause (1)**, with clause (4) in the reading the source's
proof produces and clause (1) in the quotient form.  For a quasi-coherent `F`: if there are an
étale scheme chart `φ : (U, u) → (X, x̄)`, a Zariski open `W ∋ u` and a rank `r` with
`(φ^* F)|_W` free on `r` generators, then the fibre stalk `(F_{ȳ})_{x̄}` is a flat
`𝒪_{X_{ȳ}, x̄}`-module.

The three steps are
`AlgebraicGeometry.Space.free_chartZariskiModuleStalk_of_over_iso_free`,
`AlgebraicGeometry.Space.free_geometricModuleStalk_of_free_chartZariskiModuleStalk` and
`AlgebraicGeometry.Space.flat_geometricFibreModuleStalk_of_free_geometricModuleStalk`.  Of the
source's hypotheses only quasi-coherence of `F` is used, and that only for the comparison of
Stacks 05VP: neither local finite presentation of `f`, nor finite presentation of `F` on charts,
nor flatness of `F` over `Y` is needed in this direction. -/
theorem flat_geometricFibreModuleStalk_of_exists_chartOpen_over_iso_free
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite] (xbar : GeometricPoint B S hS X.1)
    (h : ∃ (N : SmallEtaleNeighborhood xbar) (W : (chartScheme N.chart).Opens)
        (_ : chartPoint B S hS X.1 N ∈ W) (r : ℕ),
      Nonempty ((restrictToChart B S hS X.2 F N.chart).over W ≅
        SheafOfModules.free (ULift.{u} (Fin r)))) :
    Module.Flat (geometricFibreLocalRing B S hS f xbar)
      (geometricFibreModuleStalk B S hS f F xbar) := by
  obtain ⟨N, W, hw, r, ⟨e⟩⟩ := h
  exact flat_geometricFibreModuleStalk_of_free_geometricModuleStalk B S hS f F xbar
    (free_geometricModuleStalk_of_free_chartZariskiModuleStalk B S hS N F
      (free_chartZariskiModuleStalk_of_over_iso_free B S hS N F W hw e))

/-- **Stacks 0CZS, clause (1) if and only if clause (4).**  For `f : X ⟶ Y` locally of finite
presentation, `F` a quasi-coherent `𝒪_X`-module of finite presentation on charts flat at `x`
over `Y`, and `x̄` a geometric point of `X`: the fibre stalk `(F_{ȳ})_{x̄}` is a flat
`𝒪_{X_{ȳ}, x̄}`-module exactly when `F` becomes free on finitely many generators on a Zariski
open neighbourhood of `u` in some étale scheme chart `(U, u)` of `x̄`.

Clause (4) is read as the source's own proof produces it, on the slice of the Zariski site of
the chart at the open; identifying that with the chart restriction of `F` read on the Zariski
site of the open itself is an equivalence of sites and is not claimed.  The reverse implication
uses only quasi-coherence of `F`. -/
@[stacks 0CZS "(1) iff (4), clause (1) in the QUOTIENT FORM F_xbar / m_ybar F_xbar over \
O_{X, xbar} / m_ybar O_{X, xbar} (the geometric fibre X_ybar is not constructed in this \
library) and clause (4) in the reading the source's proof produces: an etale SCHEME chart \
(U, u) over (X, xbar) with a Zariski open W of U containing u on which phi^* F becomes free on \
finitely many generators, the finite freeness read on the slice of the Zariski site of U at W. \
Identifying that slice reading with the chart restriction of F to W read on the Zariski site of \
W itself is an equivalence of sites and is NOT claimed; neither is the identification of clause \
(4) with the small-etale reading of the locus of Tag 0CZT. The (4) => (1) direction needs NONE \
of the source's hypotheses except quasi-coherence of F. Clause (3) is not statable: it needs \
the geometric fibre X_ybar as an algebraic space."]
theorem exists_chartOpen_over_iso_free_iff_flat_geometricFibreModuleStalk
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite] (hf : IsLocallyOfFinitePresentation B S hS f.hom)
    (hfp : IsFinitePresentationOnCharts B S hS X.2 F)
    (xbar : GeometricPoint B S hS X.1)
    (hflat : IsFlatOverAtGeometricPoint B S hS f F xbar) :
    (∃ (N : SmallEtaleNeighborhood xbar) (W : (chartScheme N.chart).Opens)
        (_ : chartPoint B S hS X.1 N ∈ W) (r : ℕ),
      Nonempty ((restrictToChart B S hS X.2 F N.chart).over W ≅
        SheafOfModules.free (ULift.{u} (Fin r)))) ↔
      Module.Flat (geometricFibreLocalRing B S hS f xbar)
        (geometricFibreModuleStalk B S hS f F xbar) :=
  ⟨flat_geometricFibreModuleStalk_of_exists_chartOpen_over_iso_free B S hS f F xbar,
    exists_chartOpen_over_iso_free_of_flat_geometricFibreModuleStalk B S hS f F hf hfp xbar
      hflat⟩

end AlgebraicGeometry.Space

end
