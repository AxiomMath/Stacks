namespace AlgebraicGeometry.Space

/- As in `StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjClosedSubspaceSupport`: the abelian
structure of the `𝒪_X`-modules at the universe of the schemes is Mathlib's
`SheafOfModules.instAbelian`, and the two global instances below, at an enlarged module universe,
would otherwise be selected first and block the elaboration of cokernels. -/
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-! ### Epimorphisms of quasi-coherent modules, read on a scheme point -/

/-- **The global sections of a sheaf of modules on a scheme are bounded in terms of its sections
over the affine opens**: if those are at most `c`, the global sections are at most
`max c (size Y) ^ size Y`, by the sheaf property for the cover by all affine opens. -/
theorem _root_.AlgebraicGeometry.Scheme.Modules.mk_sections_top_le_of_forall_affineOpens
    {Y : Scheme.{u}} (P : Y.Modules) {c : Cardinal.{u}}
    (hc : ∀ O : Y.affineOpens, #Γ(P, O.1) ≤ c) :
    #Γ(P, ⊤) ≤ max c Y.size ^ Y.size := by
  let F : TopCat.Sheaf AddCommGrpCat.{u} Y := ⟨P.presheaf, P.isSheaf⟩
  have hinj : Function.Injective
      (fun s : Γ(P, ⊤) => fun O : Y.affineOpens =>
        P.presheaf.map (homOfLE (le_top : O.1 ≤ ⊤)).op s) := fun s t hst =>
    TopCat.Sheaf.eq_of_locally_eq' F (fun O : Y.affineOpens => O.1) ⊤ (fun O => homOfLE le_top)
      (AlgebraicGeometry.iSup_affineOpens_eq_top Y).ge s t (congrFun hst)
  have hD : max c Y.size ≠ 0 :=
    ((aleph0_pos.trans_le Y.aleph0_le_size).trans_le (le_max_right _ _)).ne'
  calc #Γ(P, ⊤) ≤ #(∀ O : Y.affineOpens, Γ(P, O.1)) := Cardinal.mk_le_of_injective hinj
    _ = Cardinal.prod fun O : Y.affineOpens => #Γ(P, O.1) := Cardinal.mk_pi _
    _ ≤ Cardinal.prod fun _ : Y.affineOpens => max c Y.size :=
        Cardinal.prod_le_prod _ _ fun O => (hc O).trans (le_max_left _ _)
    _ = max c Y.size ^ #Y.affineOpens := by rw [Cardinal.prod_const, lift_id, lift_id]
    _ ≤ max c Y.size ^ Y.size := Cardinal.power_le_power_left hD Y.mk_affineOpens_le_size

section Epi

/-- **An epimorphism of quasi-coherent modules on a represented algebraic space is surjective on
the sections over the chart of an affine open of the scheme.** -/
theorem surjective_val_app_selfOpensFunctor_of_epi (T : BigFppfOver B S hS)
    {M N : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (q : M ⟶ N) [Epi q] (hM : M.IsQuasicoherentOnSite) (hN : N.IsQuasicoherentOnSite)
    (O : (chartScheme (idEtaleChart B S hS T)).affineOpens) :
    Function.Surjective (q.val.app (op ((selfOpensFunctor B S hS T).obj O.1))) := by
  refine surjective_val_app_of_epi_of_isQuasicoherentOnSite q inferInstance hM hN _ ?_
  rw [selfOpensFunctor_obj]
  exact isAffine_chartScheme_openChart B S hS (yoneda.obj T) (idEtaleChart B S hS T) O

/-- **The Zariski reading of an epimorphism of quasi-coherent modules on a represented algebraic
space is an epimorphism.**  It is surjective on the sections over every affine open. -/
theorem epi_pushforward_selfOpens_map (T : BigFppfOver B S hS)
    {M N : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (q : M ⟶ N) [hq : Epi q] (hM : M.IsQuasicoherentOnSite) (hN : N.IsQuasicoherentOnSite) :
    haveI := isContinuous_selfOpensFunctor B S hS T
    Epi ((SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T)).map q) := by
  have := isContinuous_selfOpensFunctor B S hS T
  exact Scheme.epi_of_surjective_of_isAffineOpen _ fun O hO =>
    surjective_val_app_selfOpensFunctor_of_epi T q hM hN ⟨O, hO⟩

end Epi

/-! ### Maps of graded algebras surjective on affine charts, read at the scheme points -/

namespace RelativeProjSituation

section HomPointsEpi

variable {X : AlgebraicSpaces B S hS}
  {𝒜₁ 𝒜₂ : SheafOfModules.GradedAlgebra.{u, u, u, u + 1} (structureRingSheaf B S hS X)}
  (h₁c : ∀ (i j : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ) (a : (𝒜₁.piece i).val.obj U)
    (b : (𝒜₁.piece j).val.obj U), HEq ((𝒜₁.mul i j).app U a b) ((𝒜₁.mul j i).app U b a))
  (h₁n : ∀ n : ℤ, n < 0 → Limits.IsZero (𝒜₁.piece n))
  (h₁q : ∀ n : ℤ, (𝒜₁.piece n).IsQuasicoherentOnSite)
  (h₁k : ∀ (n : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ),
    HasCardinalLT ↥((𝒜₁.piece n).val.obj U) B.cutoff)
  (h₂c : ∀ (i j : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ) (a : (𝒜₂.piece i).val.obj U)
    (b : (𝒜₂.piece j).val.obj U), HEq ((𝒜₂.mul i j).app U a b) ((𝒜₂.mul j i).app U b a))
  (h₂n : ∀ n : ℤ, n < 0 → Limits.IsZero (𝒜₂.piece n))
  (h₂q : ∀ n : ℤ, (𝒜₂.piece n).IsQuasicoherentOnSite)
  (h₂k : ∀ (n : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ),
    HasCardinalLT ↥((𝒜₂.piece n).val.obj U) B.cutoff)
  (ψ : SheafOfModules.GradedAlgebra.UnitalHom 𝒜₁ 𝒜₂)
  (hsurj : ∀ (n : ℤ) (W : SmallEtale B S hS X.1),
    IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
      Function.Surjective ((ψ.app n).val.app (op W)))

local notation "𝔰₁" => RelativeProjSituation.mk B S hS X 𝒜₁ h₁c h₁n h₁q h₁k
local notation "𝔰₂" => RelativeProjSituation.mk B S hS X 𝒜₂ h₂c h₂n h₂q h₂k

include hsurj in
/-- A map of graded algebras surjective on the sections over the affine étale charts stays so
after re-presenting its sections in the universe of the schemes, and is then an epimorphism. -/
theorem epi_shrinkMap_app_of_surjective (n : ℤ) :
    @Epi (Modules.{u, u} B S hS X.1 X.2) _ _ _
      ((shrinkMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).app n) := by
  refine epi_of_surjective_val_app_of_isAffine B S hS _ fun W hW y => ?_
  obtain ⟨z, hz⟩ := hsurj n W hW (SheafOfModules.GradedAlgebra.smallPieceEquiv 𝒜₂ n (op W) y)
  refine ⟨(SheafOfModules.GradedAlgebra.smallPieceEquiv 𝒜₁ n (op W)).symm z, ?_⟩
  show (SheafOfModules.GradedAlgebra.smallPieceEquiv 𝒜₂ n (op W)).symm
      ((ψ.app n).val.app (op W)
        (SheafOfModules.GradedAlgebra.smallPieceEquiv 𝒜₁ n (op W)
          ((SheafOfModules.GradedAlgebra.smallPieceEquiv 𝒜₁ n (op W)).symm z))) = y
  rw [LinearEquiv.apply_symm_apply, hz]
  exact LinearEquiv.symm_apply_apply _ y

include hsurj in
/-- **A map of quasi-coherent graded algebras surjective on the sections over the affine étale
charts restricts, at every scheme point of the base, to an epimorphism in every degree.**
Pullback of modules is right exact, and the Zariski reading of an epimorphism of quasi-coherent
modules on a represented algebraic space is an epimorphism. -/
theorem epi_homPoints_hom_app_of_surjective (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X.1)
    (n : ℤ) :
    Epi (((homPoints h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).hom T f).app n) := by
  rw [homPoints_hom]
  refine (epi_restrictHom_app_iff h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ T f n).2 ?_
  show Epi ((SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T)).map
    ((etalePullHom (pointHom f) (shrinkMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).toHom).app n))
  have h2 : (etalePullHom (pointHom f) (shrinkMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).toHom).app n =
      (modulePullback B S hS (pointHom f)).map
        ((shrinkMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).app n) := rfl
  rw [h2]
  have := epi_shrinkMap_app_of_surjective h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ hsurj n
  have := (modulePullbackAdjunction B S hS (pointHom f)).isLeftAdjoint
  have hE2 := Functor.map_epi (modulePullback B S hS (pointHom f))
    ((shrinkMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).app n)
  exact epi_pushforward_selfOpens_map T _ (hq := hE2)
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
      (pointHom f) _ ((𝔰₁).isQuasicoherent_smallAlgebra n))
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
      (pointHom f) _ ((𝔰₂).isQuasicoherent_smallAlgebra n))

end HomPointsEpi

