namespace RelativeProjSituation

variable (s : RelativeProjSituation.{u, u})

/-! ### Graded ideals -/

/-- **A graded ideal of the graded algebra of Situation 0849**: an `𝒪_X`-submodule of each
homogeneous piece, stable under multiplication by an arbitrary homogeneous local section.

Quasi-coherence of the pieces is not part of the data, because the ideal `ℱ𝒜` generated by a
submodule in one degree is not shown to be quasi-coherent here; the constructions below that need
it take it as the hypothesis `hℐ`.  `AlgebraicGeometry.Space.RelativeProjSituation.GradedIdeal` of
`StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjQuotientSituation` is the notion that bundles
quasi-coherence with the ideal. -/
structure MulStableGradedSubmodule where
  /-- The submodule of the degree-`n` homogeneous piece. -/
  piece (n : ℤ) : (s.algebra.piece n).Submodule
  /-- Multiplying a local section of the ideal by a homogeneous local section of the algebra
  stays in the ideal. -/
  mul_mem (i j : ℤ) (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {x : (s.algebra.piece i).val.obj U} (hx : x ∈ (piece i).obj U)
    (b : (s.algebra.piece j).val.obj U) :
    (s.algebra.mul i j).app U x b ∈ (piece (i + j)).obj U

namespace MulStableGradedSubmodule

variable {s} (ℐ : s.MulStableGradedSubmodule)

/-- Membership in a graded ideal transported along an equality of degrees. -/
theorem mem_piece_congr {m n : ℤ} (h : m = n)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {x : (s.algebra.piece m).val.obj U} {y : (s.algebra.piece n).val.obj U} (hxy : HEq x y)
    (hx : x ∈ (ℐ.piece m).obj U) : y ∈ (ℐ.piece n).obj U := by
  subst h
  rw [← eq_of_heq hxy]
  exact hx

/-- **A graded ideal absorbs multiplication on the left too**, by commutativity of `𝒜`. -/
theorem mul_mem_left (i j : ℤ) (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (a : (s.algebra.piece i).val.obj U) {x : (s.algebra.piece j).val.obj U}
    (hx : x ∈ (ℐ.piece j).obj U) :
    (s.algebra.mul i j).app U a x ∈ (ℐ.piece (i + j)).obj U :=
  ℐ.mem_piece_congr (add_comm j i) U (s.mul_comm j i U x a) (ℐ.mul_mem j i U hx a)

end MulStableGradedSubmodule



/-! ### The graded ideal generated by a submodule of one homogeneous piece -/

/-- The property, of a submodule `N ⊆ 𝒜_n`, of containing every product `f · a` of a local
section `f` of `ℱ ⊆ 𝒜_d` with a local section `a` of `𝒜_m`, for `d + m = n`. -/
def IsGeneratedInDegree {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (n : ℤ)
    (N : (s.algebra.piece n).Submodule) : Prop :=
  ∀ (m : ℤ), d + m = n → ∀ (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (f : (s.algebra.piece d).val.obj U), f ∈ ℱ.obj U → ∀ (a : (s.algebra.piece m).val.obj U)
      (x : (s.algebra.piece n).val.obj U), HEq x ((s.algebra.mul d m).app U f a) → x ∈ N.obj U

/-- The degree-`n` piece `(ℱ𝒜)_n` of the graded ideal generated by `ℱ ⊆ 𝒜_d`: the smallest
submodule of `𝒜_n` with local membership containing every product of a local section of `ℱ` with
a homogeneous local section of `𝒜` of complementary degree,
`SheafOfModules.GradedAlgebra.generatedInDegree`. -/
abbrev generatedByDegree {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (n : ℤ) :
    (s.algebra.piece n).Submodule :=
  SheafOfModules.GradedAlgebra.generatedInDegree ℱ n

/-- `(ℱ𝒜)_n` is below every submodule containing the generators. -/
theorem generatedByDegree_le {d : ℤ} {ℱ : (s.algebra.piece d).Submodule} {n : ℤ}
    {N : (s.algebra.piece n).Submodule} (hN : s.IsGeneratedInDegree ℱ n N) :
    s.generatedByDegree ℱ n ≤ N :=
  SheafOfModules.GradedAlgebra.generatedInDegree_le ℱ hN

/-- **`(ℱ𝒜)_n` contains the generators.** -/
theorem isGeneratedInDegree_generatedByDegree {d : ℤ} (ℱ : (s.algebra.piece d).Submodule)
    (n : ℤ) : s.IsGeneratedInDegree ℱ n (s.generatedByDegree ℱ n) :=
  fun _ hm _ _ hf a _ hx => SheafOfModules.GradedAlgebra.mem_generatedInDegree ℱ hm hf a hx

/-- The product of a local section of `ℱ ⊆ 𝒜_d` with a local section of `𝒜_m` is a local section
of `ℱ𝒜` in degree `d + m`. -/
theorem mul_mem_generatedByDegree_of_mem {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (m : ℤ)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {f : (s.algebra.piece d).val.obj U} (hf : f ∈ ℱ.obj U) (a : (s.algebra.piece m).val.obj U) :
    (s.algebra.mul d m).app U f a ∈ (s.generatedByDegree ℱ (d + m)).obj U :=
  s.isGeneratedInDegree_generatedByDegree ℱ (d + m) m rfl U f hf a _ HEq.rfl


/-- **In degree `d + e` the graded ideal `ℱ𝒜` is the ideal of Stacks 085M**,
`AlgebraicGeometry.Space.closedSubspaceDegreeProducts`, which indexes the same ideal by the
complementary degree `e`: both are the smallest submodule of `𝒜_{d+e}` with local membership
containing the products of local sections of `ℱ` with local sections of `𝒜_e`. -/
theorem generatedByDegree_add_eq_closedSubspaceDegreeProducts {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (e : ℤ) :
    s.generatedByDegree ℱ (d + e) = closedSubspaceDegreeProducts s d e ℱ := by
  refine le_antisymm (s.generatedByDegree_le ?_) (closedSubspaceDegreeProducts_le ?_)
  · intro m hm U f hf a x hx
    obtain rfl : m = e := by omega
    obtain rfl := eq_of_heq hx
    exact mul_mem_closedSubspaceDegreeProducts hf a
  · intro U a ha b
    exact s.mul_mem_generatedByDegree_of_mem ℱ e U ha b

/-- `ℱ` lies in the degree-`d` piece of the ideal it generates: `f = f · 1`. -/
theorem le_generatedByDegree_self {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) :
    ℱ ≤ s.generatedByDegree ℱ d := by
  intro X f hf
  exact s.isGeneratedInDegree_generatedByDegree ℱ d 0 (add_zero d) X f hf (s.algebra.one.eval X)
    f (s.algebra.mul_one d X f).symm

/-- The local sections of `𝒜_i` all of whose restrictions multiply every homogeneous local
section of `𝒜` into `ℱ𝒜`: the auxiliary submodule through which `ℱ𝒜` is shown to be an ideal. -/
def mulStabilizer {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (i : ℤ) :
    (s.algebra.piece i).Submodule where
  obj X :=
    { carrier := {x | ∀ ⦃V⦄ (g : X ⟶ V) (j : ℤ) (b : (s.algebra.piece j).val.obj V),
        (s.algebra.mul i j).app V ((s.algebra.piece i).val.map g x) b ∈
          (s.generatedByDegree ℱ (i + j)).obj V}
      add_mem' := by
        intro x y hx hy V g j b
        refine (congrArg (fun z => z ∈ (s.generatedByDegree ℱ (i + j)).obj V) ?_).mpr
          (_root_.Submodule.add_mem _ (hx g j b) (hy g j b))
        exact (congrArg (fun z => (s.algebra.mul i j).app V z b) (map_add _ x y)).trans
          ((s.algebra.mul i j).map_add_left V _ _ b)
      zero_mem' := by
        intro V g j b
        refine (congrArg (fun z => z ∈ (s.generatedByDegree ℱ (i + j)).obj V) ?_).mpr
          (_root_.Submodule.zero_mem _)
        exact (congrArg (fun z => (s.algebra.mul i j).app V z b) (map_zero _)).trans
          ((DFunLike.congr_fun (map_zero ((s.algebra.mul i j).app V)) b).trans
            (AddMonoidHom.zero_apply _))
      smul_mem' := by
        intro r x hx V g j b
        refine (congrArg (fun z => z ∈ (s.generatedByDegree ℱ (i + j)).obj V)
          ((congrArg (fun z => (s.algebra.mul i j).app V z b)
            (PresheafOfModules.map_smul _ g r x)).trans
            ((s.algebra.mul i j).map_smul_left V _ _ b))).mpr ?_
        exact _root_.Submodule.smul_mem _ _ (hx g j b) }
  map {X Y} f := by
    intro x hx V g j b
    change (s.algebra.mul i j).app V ((s.algebra.piece i).val.map g
      ((s.algebra.piece i).val.map f x)) b ∈ _
    rw [← PresheafOfModules.map_comp_apply]
    exact hx (f ≫ g) j b
  isSheaf := by
    intro X x hx
    refine fun V g j b => (s.generatedByDegree ℱ (i + j)).isSheaf _ ?_
    refine (SmallEtale.topology s.site s.base s.containsBase s.space.1).superset_covering ?_
      ((SmallEtale.topology s.site s.base s.containsBase s.space.1).pullback_stable g.unop hx)
    intro W k hk
    have hk' : ∀ ⦃V'⦄ (g' : op W ⟶ V') (j' : ℤ) (b' : (s.algebra.piece j').val.obj V'),
        (s.algebra.mul i j').app V' ((s.algebra.piece i).val.map g'
          ((s.algebra.piece i).val.map (k ≫ g.unop).op x)) b' ∈
          (s.generatedByDegree ℱ (i + j')).obj V' := hk
    have h1 := hk' (𝟙 _) j ((s.algebra.piece j).val.map k.op b)
    have hid : (s.algebra.piece i).val.map (𝟙 (op W))
        ((s.algebra.piece i).val.map (k ≫ g.unop).op x) =
        (s.algebra.piece i).val.map (k ≫ g.unop).op x := by
      change (s.algebra.piece i).val.presheaf.map (𝟙 (op W)) _ = _
      rw [CategoryTheory.Functor.map_id]
      rfl
    rw [hid] at h1
    change (s.algebra.piece (i + j)).val.map k.op
      ((s.algebra.mul i j).app V ((s.algebra.piece i).val.map g x) b) ∈ _
    refine (congrArg (fun z => z ∈ (s.generatedByDegree ℱ (i + j)).obj (op W))
      (((s.algebra.mul i j).naturality k.op _ b).trans
        (congrArg (fun z => (s.algebra.mul i j).app (op W) z ((s.algebra.piece j).val.map k.op b))
          (PresheafOfModules.map_comp_apply _ g k.op x).symm))).mpr ?_
    exact h1

/-- A local section `x` of `𝒜_i` lies in `mulStabilizer ℱ i` exactly when, for every
restriction of `x` and every homogeneous local section `b` of `𝒜_j` there, the product lies in
`(ℱ𝒜)_{i+j}`. -/
theorem mem_mulStabilizer_iff {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (i : ℤ)
    {X : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ}
    (x : (s.algebra.piece i).val.obj X) :
    x ∈ (s.mulStabilizer ℱ i).obj X ↔ ∀ ⦃V⦄ (g : X ⟶ V) (j : ℤ)
      (b : (s.algebra.piece j).val.obj V),
      (s.algebra.mul i j).app V ((s.algebra.piece i).val.map g x) b ∈
        (s.generatedByDegree ℱ (i + j)).obj V :=
  Iff.rfl

/-- `(ℱ𝒜)_i` lies in the auxiliary submodule: a product `(f · a) · b` is regrouped as
`f · (a · b)` by associativity, so it is again a generator. -/
theorem generatedByDegree_le_mulStabilizer {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (i : ℤ) :
    s.generatedByDegree ℱ i ≤ s.mulStabilizer ℱ i := by
  refine s.generatedByDegree_le ?_
  rintro m rfl U f hf a x hx
  obtain rfl := eq_of_heq hx
  refine (s.mem_mulStabilizer_iff ℱ (d + m) _).2 fun V g j b => ?_
  refine s.isGeneratedInDegree_generatedByDegree ℱ (d + m + j) (m + j) (add_assoc d m j).symm V
    ((s.algebra.piece d).val.map g f) (ℱ.toSubmodule.map g hf)
    ((s.algebra.mul m j).app V ((s.algebra.piece m).val.map g a) b) _ ?_
  rw [(s.algebra.mul d m).naturality g]
  exact s.algebra.mul_assoc d m j V _ _ b

/-- **`ℱ𝒜` is an ideal**: the product of a local section of `(ℱ𝒜)_i` with a homogeneous local
section of `𝒜` of degree `j` lies in `(ℱ𝒜)_{i+j}`. -/
theorem mul_mem_generatedByDegree {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) (i j : ℤ)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {x : (s.algebra.piece i).val.obj U} (hx : x ∈ (s.generatedByDegree ℱ i).obj U)
    (b : (s.algebra.piece j).val.obj U) :
    (s.algebra.mul i j).app U x b ∈ (s.generatedByDegree ℱ (i + j)).obj U := by
  have h := (s.mem_mulStabilizer_iff ℱ i x).1 (s.generatedByDegree_le_mulStabilizer ℱ i U hx)
    (𝟙 U) j b
  have hid : (s.algebra.piece i).val.map (𝟙 U) x = x := by
    show (s.algebra.piece i).val.presheaf.map (𝟙 U) x = x
    rw [CategoryTheory.Functor.map_id]
    rfl
  rwa [hid] at h

/-- **The graded ideal `ℱ𝒜` generated by a submodule `ℱ ⊆ 𝒜_d`**: in degree `n` the smallest
submodule of `𝒜_n` with local membership containing the products of local sections of `ℱ` with
homogeneous local sections of `𝒜_{n-d}`.  This is the ideal of the conclusion
`Z = Proj_X(𝒜/ℱ𝒜)` of Stacks 085M and 085N. -/
def degreeIdeal {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) : s.MulStableGradedSubmodule where
  piece n := s.generatedByDegree ℱ n
  mul_mem i j U _ hx b := s.mul_mem_generatedByDegree ℱ i j U hx b

/-! ### The sectionwise quotient -/

variable (ℐ : s.MulStableGradedSubmodule)

/-- The range of the inclusion of a submodule, over an object of the site, is the submodule. -/
theorem range_submodule_ι_app {M : SheafOfModules.{u}
      (structureRingSheaf s.site s.base s.containsBase s.space)} (N : M.Submodule)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ) :
    LinearMap.range (N.ι.val.app U).hom = N.obj U :=
  _root_.Submodule.range_subtype _

/-- A local section of a submodule, read in the ambient module, lies in the submodule. -/
theorem ι_app_mem {M : SheafOfModules.{u}
      (structureRingSheaf s.site s.base s.containsBase s.space)} (N : M.Submodule)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (x : N.toSheafOfModules.val.obj U) : N.ι.val.app U x ∈ N.obj U := by
  rw [← s.range_submodule_ι_app N U]
  exact ⟨x, rfl⟩

/-- **A graded ideal of the situation is a two-sided graded ideal of `𝒜`**: stability under left
multiplication follows from commutativity of `𝒜`
(`AlgebraicGeometry.Space.RelativeProjSituation.MulStableGradedSubmodule.mul_mem_left`). -/
def MulStableGradedSubmodule.toIdeal : SheafOfModules.GradedAlgebra.Ideal s.algebra where
  piece := ℐ.piece
  mul_mem_left i j U a _ hx := ℐ.mul_mem_left i j U a hx
  mul_mem_right i j U _ b hx := ℐ.mul_mem i j U hx b

/-- The pieces of the two-sided graded ideal are the pieces of `ℐ`. -/
@[simp]
theorem MulStableGradedSubmodule.toIdeal_piece (n : ℤ) : ℐ.toIdeal.piece n = ℐ.piece n := rfl

/-- The graded ideal `ℱ𝒜` is `SheafOfModules.GradedAlgebra.Ideal.ofDegree`. -/
theorem degreeIdeal_toIdeal {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) :
    (s.degreeIdeal ℱ).toIdeal = SheafOfModules.GradedAlgebra.Ideal.ofDegree ℱ s.mul_comm :=
  rfl

/-- The degree-`n` piece of the sectionwise quotient: `U ↦ Γ(U, 𝒜_n)/ℐ_n(U)`. -/
abbrev preQuotPiece (n : ℤ) :
    PresheafOfModules.{u} (structureRingSheaf s.site s.base s.containsBase s.space).obj :=
  ℐ.toIdeal.presheafPiece n

/-- The projection of `𝒜_n` onto the sectionwise quotient. -/
abbrev preQuotProj (n : ℤ) : (s.algebra.piece n).val ⟶ s.preQuotPiece ℐ n :=
  ℐ.toIdeal.presheafMkQ n

/-- The projection of `𝒜_n` onto the sectionwise quotient is surjective on sections. -/
theorem preQuotProj_surjective (n : ℤ) (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ) :
    Function.Surjective ((s.preQuotProj ℐ n).app U) :=
  (ℐ.piece n).toSubmodule.mkQ_app_surjective U

/-- A local section of `𝒜_n` dies in the sectionwise quotient exactly when it lies in `ℐ_n`. -/
theorem preQuotProj_app_eq_zero_iff (n : ℤ)
    (U : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (a : (s.algebra.piece n).val.obj U) :
    (s.preQuotProj ℐ n).app U a = 0 ↔ a ∈ (ℐ.piece n).obj U :=
  Submodule.Quotient.mk_eq_zero ((ℐ.piece n).toSubmodule.obj U) (x := a)

/-! ### The quotient as a sheaf of graded algebras -/

/-- **The quotient `𝒜/ℐ`**, the quotient of `𝒜` by the two-sided graded ideal `ℐ`: the degreewise
sheafification of the sectionwise quotient. -/
abbrev quotientAlgebra : SheafOfModules.GradedAlgebra.{u, u}
    (structureRingSheaf s.site s.base s.containsBase s.space) :=
  ℐ.toIdeal.quotient

/-- The degree-`n` component of the quotient homomorphism `𝒜 ⟶ 𝒜/ℐ`. -/
abbrev quotientMkApp (n : ℤ) : s.algebra.piece n ⟶ (s.quotientAlgebra ℐ).piece n :=
  ℐ.toIdeal.quotientMapApp n

/-- **The quotient homomorphism `𝒜 ⟶ 𝒜/ℐ`**, a unital homomorphism of sheaves of graded
algebras. -/
abbrev quotientHom : SheafOfModules.GradedAlgebra.UnitalHom s.algebra (s.quotientAlgebra ℐ) :=
  ℐ.toIdeal.quotientMap

/-- **Morphisms out of `(𝒜/ℐ)_n` are morphisms of presheaves of modules out of the sectionwise
quotient.** -/
def quotientHomEquiv (n : ℤ) (T : SheafOfModules.{u}
      (structureRingSheaf s.site s.base s.containsBase s.space)) :
    ((s.quotientAlgebra ℐ).piece n ⟶ T) ≃ (s.preQuotPiece ℐ n ⟶ T.val) :=
  (SheafOfModules.fullyFaithfulForget _).homEquiv.trans
    (PresheafOfModules.homEquivOfIsLocallyBijective
      (f := PresheafOfModules.sheafifyUnit
        (𝟙 (structureRingSheaf s.site s.base s.containsBase s.space).obj) (s.preQuotPiece ℐ n))
      T.isSheaf)

/-- The bijection `quotientHomEquiv` sends `φ` to its composite with the sheafification unit
of the sectionwise quotient. -/
theorem quotientHomEquiv_apply (n : ℤ) (T : SheafOfModules.{u}
      (structureRingSheaf s.site s.base s.containsBase s.space))
    (φ : (s.quotientAlgebra ℐ).piece n ⟶ T) :
    s.quotientHomEquiv ℐ n T φ =
      PresheafOfModules.sheafifyUnit
        (𝟙 (structureRingSheaf s.site s.base s.containsBase s.space).obj)
        (s.preQuotPiece ℐ n) ≫ φ.val := rfl

/-- The quotient homomorphism kills the inclusion of the ideal. -/
theorem ι_comp_quotientMkApp (n : ℤ) : (ℐ.piece n).ι ≫ s.quotientMkApp ℐ n = 0 := by
  ext U x
  exact (ℐ.toIdeal.quotientMapApp_eq_zero_iff n U _).2 (s.ι_app_mem (ℐ.piece n) U x)

section Cokernel

variable (n : ℤ) (c : CokernelCofork ((ℐ.piece n).ι))

/-- The underlying presheaf morphism of a cokernel cofork of `ℐ_n ⟶ 𝒜_n` vanishes on `ℐ_n`. -/
theorem coforkCondition : (ℐ.piece n).ι.val ≫ (Cofork.π c).val = 0 :=
  congrArg (fun φ : (ℐ.piece n).toSheafOfModules ⟶ c.pt => φ.val) (CokernelCofork.condition c)

end Cokernel

/-- The inclusion of a submodule equal to the kernel submodule of `φ` is a kernel of `φ`. -/
theorem nonempty_isLimit_kernelFork_ι_of_eq {M N : SheafOfModules.{u}
      (structureRingSheaf s.site s.base s.containsBase s.space)} (φ : M ⟶ N) {K : M.Submodule}
    (hK : Stacks.SheafOfModules.kerSubmodule φ = K) (w : K.ι ≫ φ = 0) :
    Nonempty (IsLimit (KernelFork.ofι K.ι w)) := by
  subst hK
  exact ⟨Stacks.SheafOfModules.isLimitKernelForkKerSubmodule φ⟩

/-- **`(𝒜/ℐ)_n` is a cokernel of the inclusion `ℐ_n ⟶ 𝒜_n`**, with the degree-`n` component of
the quotient homomorphism as the projection: the quotient homomorphism is an epimorphism whose
kernel is `ℐ_n`. -/
def quotientMkIsColimit (n : ℤ) :
    IsColimit (CokernelCofork.ofπ (s.quotientMkApp ℐ n) (s.ι_comp_quotientMkApp ℐ n)) :=
  Abelian.epiIsCokernelOfKernel _
    (s.nonempty_isLimit_kernelFork_ι_of_eq (ℐ.toIdeal.quotientMapApp n)
      (ℐ.toIdeal.kerSubmodule_quotientMapApp n) (s.ι_comp_quotientMkApp ℐ n)).some

/-- The degree-`n` component of the quotient homomorphism is an epimorphism. -/
instance epi_quotientMkApp (n : ℤ) : Epi (s.quotientMkApp ℐ n) :=
  ℐ.toIdeal.epi_quotientMapApp n

/-- **The pieces of `𝒜/ℐ` are quasi-coherent** when those of `ℐ` are: each is a cokernel of a
morphism of quasi-coherent modules. -/
theorem isQuasicoherent_quotientAlgebra_piece
    (hℐ : ∀ n : ℤ, (ℐ.piece n).toSheafOfModules.IsQuasicoherentOnSite) (n : ℤ) :
    ((s.quotientAlgebra ℐ).piece n).IsQuasicoherentOnSite :=
  (SheafOfModules.isQuasicoherentOnSite
      (structureRingSheaf s.site s.base s.containsBase s.space)).prop_of_iso
    (IsColimit.coconePointUniqueUpToIso (cokernelIsCokernel (ℐ.piece n).ι)
      (s.quotientMkIsColimit ℐ n))
    (@isQuasicoherentOnSite_cokernel_unconditional s.site s.base s.containsBase s.space.1
      s.space.2 _ _ (hℐ n) (s.isQuasicoherent n) (ℐ.piece n).ι)

/-! ### Situation 0849 for the quotient -/

/-- A graded ideal of the situation with quasi-coherent pieces, as a quasi-coherent graded ideal
`AlgebraicGeometry.Space.RelativeProjSituation.GradedIdeal`. -/
def MulStableGradedSubmodule.toGradedIdeal
    (hℐ : ∀ n : ℤ, (ℐ.piece n).toSheafOfModules.IsQuasicoherentOnSite) : s.GradedIdeal where
  toIdeal := ℐ.toIdeal
  isQuasicoherent := hℐ

/-- **Situation 0849 for the quotient `𝒜/ℐ`** by a graded ideal with quasi-coherent pieces: the
quotient situation `AlgebraicGeometry.Space.RelativeProjSituation.GradedIdeal.quotientSituation` of
`ℐ`, with the same site, base and algebraic space, and the graded algebra `𝒜/ℐ`. -/
def quotient (hℐ : ∀ n : ℤ, (ℐ.piece n).toSheafOfModules.IsQuasicoherentOnSite) :
    RelativeProjSituation.{u, u} :=
  (MulStableGradedSubmodule.toGradedIdeal (s := s) ℐ hℐ).quotientSituation

variable (hℐ : ∀ n : ℤ, (ℐ.piece n).toSheafOfModules.IsQuasicoherentOnSite)

/-- The quotient situation has the same site. -/
@[simp] theorem quotient_site : (s.quotient ℐ hℐ).site = s.site := rfl
/-- The quotient situation has the same algebraic space. -/
@[simp] theorem quotient_space : (s.quotient ℐ hℐ).space = s.space := rfl
/-- The graded algebra of the quotient situation is `𝒜/ℐ`. -/
theorem quotient_algebra : (s.quotient ℐ hℐ).algebra = s.quotientAlgebra ℐ := rfl


/-! ### The morphism `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` -/

/-- **The quotient homomorphism `𝒜 ⟶ 𝒜/ℐ`, read over the scheme points of the base**: at a scheme
point `f : T ⟶ X` its restriction `f^*𝒜 ⟶ f^*(𝒜/ℐ)`, between the presentations of Stacks 084B (2)
of `Proj_X(𝒜)` and `Proj_X(𝒜/ℐ)`; this is `AlgebraicGeometry.Space.RelativeProjSituation.homPoints`
for the quotient homomorphism. -/
def quotientHomPoints :
    RelativeProjHomPoints s.relativeProjPoints (s.quotient ℐ hℐ).relativeProjPoints :=
  homPoints s.mul_comm s.negative_isZero s.isQuasicoherent s.sections_hasCardinalLT
    (s.quotient ℐ hℐ).mul_comm (s.quotient ℐ hℐ).negative_isZero
    (s.quotient ℐ hℐ).isQuasicoherent (s.quotient ℐ hℐ).sections_hasCardinalLT
    (s.quotientHom ℐ)

include hℐ in
/-- The quotient homomorphism is surjective on the sections over every affine étale chart. -/
theorem surjective_quotientMkApp_app (n : ℤ) (W : SmallEtale s.site s.base s.containsBase s.space.1)
    (hW : IsAffine ((SmallEtale.toOver s.site s.base s.containsBase s.space.1 ⋙
      BigFppfOver.toScheme s.site s.base s.containsBase).obj W)) :
    Function.Surjective ((s.quotientMkApp ℐ n).val.app (op W)) :=
  surjective_val_app_of_epi_of_isQuasicoherentOnSite (F := s.space.1) (hF := s.space.2)
    (s.quotientMkApp ℐ n) (s.epi_quotientMkApp ℐ n) (s.isQuasicoherent n)
    (s.isQuasicoherent_quotientAlgebra_piece ℐ hℐ n) W hW

/-- **The restriction `f^*𝒜 ⟶ f^*(𝒜/ℐ)` of the quotient homomorphism to a scheme point is an
epimorphism in every degree**: pullback of modules is right exact, and the Zariski reading of an
epimorphism of quasi-coherent modules on a represented algebraic space is an epimorphism. -/
theorem epi_quotientHomPoints_hom_app (T : BigFppfOver s.site s.base s.containsBase)
    (f : yoneda.obj T ⟶ s.space.1) (n : ℤ) :
    Epi (((s.quotientHomPoints ℐ hℐ).hom T f).app n) := by
  rw [quotientHomPoints]
  exact epi_homPoints_hom_app_of_surjective s.mul_comm s.negative_isZero s.isQuasicoherent
    s.sections_hasCardinalLT (s.quotient ℐ hℐ).mul_comm (s.quotient ℐ hℐ).negative_isZero
    (s.quotient ℐ hℐ).isQuasicoherent (s.quotient ℐ hℐ).sections_hasCardinalLT
    (s.quotientHom ℐ) (fun m W hW => s.surjective_quotientMkApp_app ℐ hℐ m W hW) T f n

/-- The restrictions of the quotient homomorphism are epimorphisms in all large degrees: the
hypothesis of Stacks 085H. -/
theorem eventually_epi_quotientHomPoints_hom_app (T : BigFppfOver s.site s.base s.containsBase)
    (f : yoneda.obj T ⟶ s.space.1) :
    ∀ᶠ d : ℕ in atTop, Epi (((s.quotientHomPoints ℐ hℐ).hom T f).app (d : ℤ)) :=
  Eventually.of_forall fun d => s.epi_quotientHomPoints_hom_app ℐ hℐ T f d

/-- **The morphism `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` induced by `𝒜 ⟶ 𝒜/ℐ`**: the morphism `r_ψ` of
Stacks 085F for the quotient homomorphism, defined on all of `Proj_X(𝒜/ℐ)` by Stacks 085H (1)
(`AlgebraicGeometry.Space.RelativeProjHomPoints.relativeMapSubfunctor_eq_top_of_eventually_epi`).
-/
def quotientProjHom : (s.quotient ℐ hℐ).relativeProjFunctor ⟶ s.relativeProjFunctor :=
  (s.quotientHomPoints ℐ hℐ).totalHom
    ((s.quotientHomPoints ℐ hℐ).relativeMapSubfunctor_eq_top_of_eventually_epi
      (s.eventually_epi_quotientHomPoints_hom_app ℐ hℐ))

/-- The morphism `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` is a morphism over `X`. -/
@[reassoc]
theorem quotientProjHom_comp_relativeProjπ :
    s.quotientProjHom ℐ hℐ ≫ s.relativeProjπ = (s.quotient ℐ hℐ).relativeProjπ :=
  (s.quotientHomPoints ℐ hℐ).totalHom_comp _

/-- **`Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` is a closed immersion of algebraic spaces**, by
Stacks 085H (2): the quotient homomorphism is surjective in every degree. -/
theorem isClosedImmersion_quotientProjHom :
    IsClosedImmersion s.site s.base s.containsBase (s.quotientProjHom ℐ hℐ) :=
  (s.quotientHomPoints ℐ hℐ).isClosedImmersion_totalHom_of_eventually_epi
    (s.eventually_epi_quotientHomPoints_hom_app ℐ hℐ)

/-- The fibre of `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` over a scheme point `f : T ⟶ X`: the morphism
`T ×_X Proj_X(𝒜/ℐ) ⟶ T ×_X Proj_X(𝒜)` of the representing objects of Stacks 084B (2). -/
def quotientFibreMap (T : BigFppfOver s.site s.base s.containsBase)
    (f : yoneda.obj T ⟶ s.space.1) :
    (s.quotient ℐ hℐ).relativeProjPoints.fibre T f ⟶ s.relativeProjPoints.fibre T f :=
  (s.quotientHomPoints ℐ hℐ).totalHomFibreMap
    ((s.quotientHomPoints ℐ hℐ).relativeMapSubfunctor_eq_top_of_eventually_epi
      (s.eventually_epi_quotientHomPoints_hom_app ℐ hℐ)) T f


/-- **The base change of `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` to a scheme point `f : T ⟶ X` is the
scheme-level closed immersion `Proj_T(f^*(𝒜/ℐ)) ⟶ Proj_T(f^*𝒜)`.**  The fibre square over `f` is
cartesian, the fibre morphism lies over `T`, and on schemes, through the identifications
`T ×_X Proj_X(𝒜/ℐ) ≅ Proj_T(f^*(𝒜/ℐ))` and `T ×_X Proj_X(𝒜) ≅ Proj_T(f^*𝒜)` of Stacks 084B (2), it
is the morphism `r` of Stacks 07ZG for the restriction `f^*𝒜 ⟶ f^*(𝒜/ℐ)` of the quotient
homomorphism, which is defined on all of `Proj_T(f^*(𝒜/ℐ))` and is a closed immersion
(Stacks 07ZI). -/
theorem isPullback_quotientFibreMap (T : BigFppfOver s.site s.base s.containsBase)
    (f : yoneda.obj T ⟶ s.space.1) :
    IsPullback ((s.quotient ℐ hℐ).relativeProjPoints.fibreToSpace T f)
        (yoneda.map (s.quotientFibreMap ℐ hℐ T f)) (s.quotientProjHom ℐ hℐ)
        (s.relativeProjPoints.fibreToSpace T f) ∧
      s.quotientFibreMap ℐ hℐ T f ≫ s.relativeProjPoints.fibreHom T f =
        (s.quotient ℐ hℐ).relativeProjPoints.fibreHom T f ∧
      ((s.quotientHomPoints ℐ hℐ).hom T f).relativeMapDomain = ⊤ ∧
      ((s.quotientHomPoints ℐ hℐ).hom T f).relativeMapDomain.ι ≫
          ((s.quotient ℐ hℐ).relativeProjPoints.fibreIso T f).inv ≫
          (BigFppfOver.toScheme s.site s.base s.containsBase).map (s.quotientFibreMap ℐ hℐ T f) ≫
          (s.relativeProjPoints.fibreIso T f).hom =
        relativeMapHom ((s.quotientHomPoints ℐ hℐ).hom T f) ∧
      _root_.AlgebraicGeometry.IsClosedImmersion
        (relativeMapHom ((s.quotientHomPoints ℐ hℐ).hom T f)) := by
  have htop := (s.quotientHomPoints ℐ hℐ).relativeMapSubfunctor_eq_top_of_eventually_epi
    (s.eventually_epi_quotientHomPoints_hom_app ℐ hℐ)
  have h1 := (s.quotientHomPoints ℐ hℐ).isPullback_totalHomFibreMap htop T f
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact h1
  · exact (s.quotientHomPoints ℐ hℐ).totalHomFibreMap_comp_fibreHom htop T f
  · exact (s.quotientHomPoints ℐ hℐ).relativeMapDomain_eq_top htop T f
  · exact (s.quotientHomPoints ℐ hℐ).ι_comp_toScheme_map_totalHomFibreMap htop T f
  · exact isClosedImmersion_pointRelativeMapHom_of_eventually_epi (s.quotientHomPoints ℐ hℐ).hom
      (s.eventually_epi_quotientHomPoints_hom_app ℐ hℐ) T f


/-- **The pullback of the closed subspace `Proj_X(𝒜/ℐ) ⊆ Proj_X(𝒜)` to the fibre over a scheme
point `f : T ⟶ X`** is the range of the closed immersion `Proj_T(f^*(𝒜/ℐ)) ⟶ Proj_T(f^*𝒜)` of the
representing objects. -/
theorem preimage_range_quotientProjHom (T : BigFppfOver s.site s.base s.containsBase)
    (f : yoneda.obj T ⟶ s.space.1) :
    (Subfunctor.range (s.quotientProjHom ℐ hℐ)).preimage (s.relativeProjPoints.fibreToSpace T f) =
      Subfunctor.range (yoneda.map (s.quotientFibreMap ℐ hℐ T f)) :=
  Subfunctor.preimage_range_of_isPullback (s.isPullback_quotientFibreMap ℐ hℐ T f).1

/-- `Proj_X(𝒜/ℐ) ⟶ Proj_X(𝒜)` is a monomorphism: it is a closed immersion. -/
theorem mono_quotientProjHom : Mono (s.quotientProjHom ℐ hℐ) := by
  have hPmono : (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme s.site s.base s.containsBase)) ≤
      MorphismProperty.monomorphisms (BigFppfOver s.site s.base s.containsBase) := by
    intro A A' g hg
    have : _root_.AlgebraicGeometry.IsClosedImmersion
        ((BigFppfOver.toScheme s.site s.base s.containsBase).map g) := hg
    refine ⟨fun {T} g₁ g₂ hgg => ?_⟩
    refine Functor.map_injective (BigFppfOver.toScheme s.site s.base s.containsBase) ?_
    refine (cancel_mono ((BigFppfOver.toScheme s.site s.base s.containsBase).map g)).1 ?_
    exact congrArg (fun k => (BigFppfOver.toScheme s.site s.base s.containsBase).map k) hgg
  exact MorphismProperty.presheaf_monomorphisms_le_monomorphisms _
    (MorphismProperty.relative_monotone hPmono _ (s.isClosedImmersion_quotientProjHom ℐ hℐ))

/-- The range of a monomorphism out of an fppf sheaf is an fppf sheaf. -/
theorem _root_.AlgebraicGeometry.Space.isSheaf_range_of_mono
    {Z P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (i : Z ⟶ P) [hi : Mono i]
    (hZ : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Z) :
    Presheaf.IsSheaf (BigFppfOver.topology B S hS) (Subfunctor.range i).toFunctor :=
  (Presheaf.isSheaf_of_iso_iff (asIso (Subfunctor.toRange i))).1 hZ

/-- **Descent of the identification of a closed subspace with `Proj_X(𝒜/ℐ)` from one surjective
étale scheme point of the base.**  Let `i : Z ⟶ Proj_X(𝒜)` be a monomorphism out of an fppf sheaf
(for instance a closed subspace) and `w : W ⟶ X` a surjective étale scheme point.  If the
pullback of `Z` to the fibre `W ×_X Proj_X(𝒜) = Proj_W(w^*𝒜)` is the closed subscheme
`Proj_W(w^*(𝒜/ℐ))`, then `Z = Proj_X(𝒜/ℐ)` as subobjects of `Proj_X(𝒜)`. -/
theorem range_eq_range_quotientProjHom_of_fibre {Z : (BigFppfOver s.site s.base s.containsBase)ᵒᵖ ⥤
      Type u} (i : Z ⟶ s.relativeProjFunctor) [Mono i]
    (hZ : Presheaf.IsSheaf (BigFppfOver.topology s.site s.base s.containsBase) Z)
    {W : BigFppfOver s.site s.base s.containsBase} (w : yoneda.obj W ⟶ s.space.1)
    (hwe : (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme s.site s.base s.containsBase)).presheaf w)
    (hws : (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme s.site s.base s.containsBase)).presheaf w)
    (h : (Subfunctor.range i).preimage (s.relativeProjPoints.fibreToSpace W w) =
      Subfunctor.range (yoneda.map (s.quotientFibreMap ℐ hℐ W w))) :
    Subfunctor.range i = Subfunctor.range (s.quotientProjHom ℐ hℐ) := by
  refine s.relativeProjPoints.eq_of_preimage_fibreToSpace_eq
    s.isAlgebraicSpace_relativeProjFunctor.isSheaf w hwe hws _ _
    (isSheaf_range_of_mono i hZ)
    (isSheaf_range_of_mono _ (hi := s.mono_quotientProjHom ℐ hℐ)
      (s.quotient ℐ hℐ).isAlgebraicSpace_relativeProjFunctor.isSheaf) ?_
  rw [h]
  exact (s.preimage_range_quotientProjHom ℐ hℐ W w).symm

end RelativeProjSituation

end AlgebraicGeometry.Space

