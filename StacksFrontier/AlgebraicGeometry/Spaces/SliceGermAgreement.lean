module

public import Mathlib.AlgebraicGeometry.Scheme

/-!
# Families of sections with equal germs agree near the point

Two sections of the structure sheaf of a scheme over an open `U` with the same germ at a point
`x ∈ U` have the same restriction to some smaller open neighbourhood of `x`. For a finite family
of pairs of sections one neighbourhood works for all of them: the finitely many neighbourhoods
produced one pair at a time may be intersected. Consequently the ideals of sections generated by
two such families coincide after restriction, so the closed subschemes they cut out agree near
`x`.

## Main results

* `AlgebraicGeometry.exists_le_restrict_eq_of_germ_eq`: a finite family of pairs of sections
  with equal germs at `x` has a common open neighbourhood of `x` on which the restrictions
  agree.
* `AlgebraicGeometry.exists_le_span_range_restrict_eq_of_germ_eq`: on such a neighbourhood the
  two families generate the same ideal of sections.

## Implementation notes

The index type is `Fin r`, which is what a regular sequence of length `r` is indexed by; only
finiteness of the index type is used, and the statement is phrased over `Fin r` to match the
shape in which the slicing argument consumes it. The common neighbourhood is
`U ⊓ ⨅ i, W i`, with the meet against `U` present so that the neighbourhood is contained in `U`
also when the family is empty.

The restriction maps are compared by noting that any two morphisms with the same source and
target in the lattice of opens are equal, so restricting the one-pair identity further along
`U ⊓ ⨅ i, W i ≤ W i` produces exactly the restriction along `U ⊓ ⨅ i, W i ≤ U`.
-/

@[expose] public section

open CategoryTheory TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}} {U : X.Opens} (x : X) (hx : x ∈ U) {r : ℕ}

/-- **A finite family of pairs of sections with equal germs agrees on a neighbourhood.** If the
sections `a i` and `b i` over an open `U` have the same germ at `x ∈ U` for each of the finitely
many indices `i`, then there is an open `W` with `x ∈ W ≤ U` on which `a i` and `b i` restrict
to the same section for every `i`. -/
theorem exists_le_restrict_eq_of_germ_eq (a b : Fin r → Γ(X, U))
    (h : ∀ i, X.presheaf.germ U x hx (a i) = X.presheaf.germ U x hx (b i)) :
    ∃ (W : X.Opens) (_ : x ∈ W) (hWU : W ≤ U), ∀ i,
      TopCat.Presheaf.restrictOpen (a i) W hWU =
        TopCat.Presheaf.restrictOpen (b i) W hWU := by
  choose W hxW iU iV hab using fun i => X.presheaf.germ_eq x hx hx (a i) (b i) (h i)
  have hmem : x ∈ (⨅ i, W i : X.Opens) := by
    simp only [← SetLike.mem_coe, Opens.coe_iInf, Set.mem_iInter]
    exact fun i => hxW i
  refine ⟨U ⊓ ⨅ i, W i, ⟨hx, hmem⟩, inf_le_left, fun i => ?_⟩
  have hle : U ⊓ ⨅ j, W j ≤ W i := le_trans inf_le_right (iInf_le _ i)
  rw [← TopCat.Presheaf.restrict_restrict hle (leOfHom (iU i)) (a i),
    ← TopCat.Presheaf.restrict_restrict hle (leOfHom (iV i)) (b i)]
  exact congrArg (fun s => TopCat.Presheaf.restrictOpen s _ hle) (hab i)

/-- **Two families of sections with equal germs generate the same ideal near the point.**  On a
neighbourhood on which the two families agree they generate the same ideal of sections, hence
cut out the same closed subscheme there. -/
theorem exists_le_span_range_restrict_eq_of_germ_eq (a b : Fin r → Γ(X, U))
    (h : ∀ i, X.presheaf.germ U x hx (a i) = X.presheaf.germ U x hx (b i)) :
    ∃ (W : X.Opens) (_ : x ∈ W) (hWU : W ≤ U),
      Ideal.span (Set.range fun i => TopCat.Presheaf.restrictOpen (a i) W hWU) =
        Ideal.span (Set.range fun i => TopCat.Presheaf.restrictOpen (b i) W hWU) := by
  obtain ⟨W, hxW, hWU, heq⟩ := exists_le_restrict_eq_of_germ_eq x hx a b h
  exact ⟨W, hxW, hWU, congrArg (fun c => Ideal.span (Set.range c)) (funext heq)⟩

end AlgebraicGeometry

end
