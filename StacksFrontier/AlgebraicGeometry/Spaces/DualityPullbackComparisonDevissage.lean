/-!
# The map of Stacks 0E5P is invertible once it is on perfect objects

Let `f : X ⟶ Y` be a morphism of quasi-compact and quasi-separated algebraic spaces and `a` the
right adjoint of `Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)`. If `a` commutes with direct sums and the map
`Lf^*K ⊗^L a(𝒪_Y) ⟶ a(K)` of Stacks 0E5P is invertible for every perfect `K`, then it is
invertible for every `K ∈ D_QCoh(𝒪_Y)`: both sides are exact functors of `K` commuting with
direct sums, and `D_QCoh(𝒪_Y)` is generated by a single perfect, hence compact, object
(Stacks 09IY, 09M8). This is the argument of the proof of Stacks 0E5U, whose two inputs are
Stacks 0E5T and Stacks 0E5Q.

## Main results

* `AlgebraicGeometry.Space.isIso_quasicoherentDerivedCompareWithPullback_app_of_preservesCoproducts`
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated.K0

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u

namespace AlgebraicGeometry.Space

attribute [local instance 10000] HasDerivedCategory.standard

attribute [local instance] isGrothendieckAbelian_modules_ringUniverse
  Stacks.SmallDerivedCategory.hasColimitsOfShape_discrete_derivedCategory

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  (hZ : B.Contains (⊤_ Scheme.{u}))

/-- **The map of Stacks 0E5P is invertible as soon as it is on perfect objects and `a` commutes
with direct sums** (the argument of Stacks 0E5U). Let `f : X ⟶ Y` be a morphism of quasi-compact
and quasi-separated algebraic spaces such that the right adjoint `a` of `Rf_*` on `D_QCoh`
commutes with direct sums, and such that `Lf^*K ⊗^L a(𝒪_Y) ⟶ a(K)` is invertible for every
perfect `K`. Then it is invertible for every `K ∈ D_QCoh(𝒪_Y)`. -/
theorem isIso_quasicoherentDerivedCompareWithPullback_app_of_preservesCoproducts
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hXqc : IsQuasiCompactSpace B S hS X.1)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1) (hYqc : IsQuasiCompactSpace B S hS Y.1)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1)
    (hsum : ∀ I : Type u, PreservesColimitsOfShape (Discrete I)
      (quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs))
    (hperf : ∀ K : QuasicoherentDerivedCategory.{u, u} B S hS Y.1 Y.2,
      (smallEtaleRingedSite B S hS Y.1 Y.2).IsPerfect K.obj →
        IsIso ((quasicoherentDerivedCompareWithPullback hZ f hXqc hXqs hYqs).app K))
    (K : QuasicoherentDerivedCategory.{u, u} B S hS Y.1 Y.2) :
    IsIso ((quasicoherentDerivedCompareWithPullback hZ f hXqc hXqs hYqs).app K) := by
  have := hasCoproducts_quasicoherentDerivedCategory_ringUniverse B S hS Y.1 Y.2
  have hcl := isClosedUnderColimitsOfShape_qcohDerived (B := B) (S := S) (hS := hS) Y
  have hclX := isClosedUnderColimitsOfShape_qcohDerived (B := B) (S := S) (hS := hS) X
  let : ((smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj).CommShift ℤ :=
          (smallEtaleDerivedTensorProduct B S hS X).commShift_left _
  let : ((smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj).IsTriangulated :=
          (smallEtaleDerivedTensorProduct B S hS X).exact_left _
  let hG : Functor.CommShift ((smallEtaleDerivedModulePullback B S hS f ⋙
      (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) :
      DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
        DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) ℤ :=
            (inferInstance : Functor.CommShift (smallEtaleDerivedModulePullback B S hS f ⋙
            (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) ℤ)
  have : Functor.IsTriangulated ((smallEtaleDerivedModulePullback B S hS f ⋙
      (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) :
      DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
        DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) :=
            (inferInstance : Functor.IsTriangulated (smallEtaleDerivedModulePullback B S hS f ⋙
            (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj))
  have : ∀ I : Type u, PreservesColimitsOfShape (Discrete I)
      ((smallEtaleDerivedModulePullback B S hS f ⋙ (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) :
      DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
        DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) := fun I => by
    have : PreservesColimitsOfSize.{u, u} (smallEtaleDerivedModulePullback B S hS f) :=
      (smallEtaleDerivedModuleAdjunction B S hS f).leftAdjoint_preservesColimits
    have : PreservesColimitsOfShape (Discrete I) ((smallEtaleDerivedTensor B S hS X).flip.obj
        ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) :=
      Stacks.SheafOfModules.DerivedTensorProduct.preservesColimitsOfShape_tensor_flip_obj _ _ I
    exact (inferInstance : PreservesColimitsOfShape (Discrete I)
      (smallEtaleDerivedModulePullback B S hS f ⋙ (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj))
  have e : (quasicoherentDerivedModulePullback f ⋙ (quasicoherentDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2))) ⋙ (QcohDerived B S hS X).ι ≅
      (QcohDerived B S hS Y).ι ⋙ ((smallEtaleDerivedModulePullback B S hS f ⋙
          (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) :
      DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
        DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) :=
    Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (liftBifunctorFlipObjCompιIso (QcohDerived B S hS X)
        (smallEtaleDerivedTensor B S hS X)
        (fun K L hK hL => qcohDerived_smallEtaleDerivedTensor X K L hK hL) _) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (quasicoherentDerivedModulePullbackCompιIso f) _ ≪≫
      Functor.associator _ _ _
  have : ∀ I : Type u, PreservesColimitsOfShape (Discrete I)
      ((QcohDerived B S hS Y).ι ⋙ ((smallEtaleDerivedModulePullback B S hS f ⋙
          (smallEtaleDerivedTensor B S hS X).flip.obj
      ((quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).obj
        (derivedStructureSheaf B S hS Y.1 Y.2)).obj) :
      DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
        DerivedCategory (Modules.{u, u} B S hS X.1 X.2))) := fun I => by
    have := hcl I
    infer_instance
  have : ∀ I : Type u, PreservesColimitsOfShape (Discrete I)
      (quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs ⋙
          (QcohDerived B S hS X).ι) := fun I => by
    have := hclX I
    have := hsum I
    infer_instance
  have : (quasicoherentDerivedRightAdjoint hZ f hXqc hXqs hYqs).IsTriangulated :=
    (quasicoherentDualityAdjunction hZ f hXqc hXqs hYqs).isTriangulated_rightAdjoint
  obtain ⟨G, hGc, hG⟩ := exists_isCompactObject_isWeakTriangulatedGenerator_of_qcqs B S hS hZ Y
    hYqc hYqs
  have hGp := (isCompactObject_iff_isPerfect Y hYqc hYqs G).1 hGc
  have key :=
    StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift_of_locallySmall
    (e.inv ≫ Functor.whiskerRight (quasicoherentDerivedCompareWithPullback hZ f hXqc hXqs hYqs)
      (QcohDerived B S hS X).ι) (fun _ : PUnit.{u + 1} => G) (fun _ => hGc)
    (fun Z hZ' => hG Z (by
      have : ObjectProperty.ofObj (fun _ : PUnit.{u + 1} => G) = ObjectProperty.singleton G := by
        ext Z
        rw [ObjectProperty.ofObj_iff, ObjectProperty.singleton_iff]
        exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨PUnit.unit, h⟩⟩
      rwa [← this]))
    (fun _ n => by
      have hn : (smallEtaleRingedSite B S hS Y.1 Y.2).IsPerfect (G⟦n⟧).obj :=
        isPerfect_of_iso (hE := RingedSite.isPerfect_shift_general _ hGp n)
          (e := (((QcohDerived B S hS Y).ι.commShiftIso n).app G).symm)
      have := hperf _ hn
      rw [NatTrans.comp_app]
      exact IsIso.comp_isIso' inferInstance
        (Functor.map_isIso (QcohDerived B S hS X).ι
          ((quasicoherentDerivedCompareWithPullback hZ f hXqc hXqs
          hYqs).app (G⟦n⟧)))) K
  have h := IsIso.comp_isIso' (inferInstance : IsIso (e.hom.app K)) key
  rw [NatTrans.comp_app, e.hom_inv_id_app_assoc] at h
  exact (isIso_iff_of_reflects_iso _ (QcohDerived B S hS X).ι).1 h

end AlgebraicGeometry.Space

end
