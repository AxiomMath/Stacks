open CategoryTheory CategoryTheory.Limits Opposite TensorProduct

universe u

/-- **Dual base change for a finitely presented module.**  Let `M` be a finitely presented
`A`-module, let `C` be a flat `A`-algebra and let `x` be an element of `M`.  Every `C`-linear
functional on `C ⊗[A] M` takes `1 ⊗ x` into the ideal of `C` generated by the values at `x` of
the `A`-linear functionals on `M`.

Finite presentation of `M` and flatness of `C` make `Hom_A(M, A) ⊗_A C` the `C`-functionals on
`C ⊗[A] M`, so the functional is a `C`-combination of base changed `A`-functionals. -/
theorem Ideal.mem_map_span_range_dual {A C M : Type*} [CommRing A] [CommRing C]
    [Algebra A C] [AddCommGroup M] [Module A M] [Module.Flat A C]
    [Module.FinitePresentation A M] (x : M) (lam : (C ⊗[A] M) →ₗ[C] C) :
    lam (1 ⊗ₜ[A] x) ∈
      Ideal.map (algebraMap A C) (Ideal.span (Set.range fun l : Module.Dual A M => l x)) := by
  classical
  set I : Ideal A := Ideal.span (Set.range fun l : Module.Dual A M => l x)
  have hbc := Module.FinitePresentation.isBaseChange_map A M A C
  have key := hbc.inductionOn
    (motive := fun ψ => (TensorProduct.AlgebraTensorModule.rid A C C) (ψ (1 ⊗ₜ[A] x)) ∈
      Ideal.map (algebraMap A C) I)
    ((TensorProduct.AlgebraTensorModule.rid A C C).symm.toLinearMap ∘ₗ lam)
    (fun l => by
      have hl : l x ∈ I := Ideal.subset_span (Set.mem_range_self l)
      have h2 := Ideal.mem_map_of_mem (algebraMap A C) hl
      simpa [LinearMap.baseChangeHom_apply, Algebra.smul_def] using h2)
    (fun b ψ hψ => by
      simp only [LinearMap.smul_apply, map_smul]
      exact Ideal.mul_mem_left _ _ hψ)
    (fun ψ₁ ψ₂ h₁ h₂ => by
      simp only [LinearMap.add_apply, map_add]
      exact Ideal.add_mem _ h₁ h₂)
  simpa using key

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)

/-! ### Base change of the evaluation ideal between affine charts -/

/-- `AlgebraicGeometry.Space.sectionEvaluationIdealAt` spelled through
`AlgebraicGeometry.Space.chartRing`, exactly as `AlgebraicGeometry.Space.chartIdeal` spells the
sections of a sheaf of ideals.  The two rings are definitionally equal but instance search is
syntactic, so without this spelling `Ideal.span` and `Ideal.map` in the chart ring do not
elaborate against the evaluation ideal. -/
noncomputable abbrev sectionEvaluationChartIdeal (U : SmallEtale B S hS X.1) :
    Ideal (chartRing B S hS X.1 X.2 U) :=
  sectionEvaluationIdealAt B S hS X L s U

/-- **The evaluation ideal over the smaller of two affine étale charts is generated by the
restrictions of the evaluation ideal over the larger one.**

The sections of `L` over the smaller chart are the base change of the sections over the larger
one, so a functional there is, by `Ideal.mem_map_span_range_dual`, a combination of base changed
functionals; finite presentation of the sections over the larger chart and flatness of the
restriction map are what that needs. -/
theorem sectionEvaluationIdealAt_le_map {U V : SmallEtale B S hS X.1} (f : V ⟶ U)
    (hbc : Function.Bijective (sectionsBaseChange L f))
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U))
    (hV : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    (hfp : Module.FinitePresentation (chartRing B S hS X.1 X.2 U) (L.val.obj (op U))) :
    sectionEvaluationChartIdeal B S hS X L s V ≤
      Ideal.map (chartRestrict (hF := X.2) f) (sectionEvaluationChartIdeal B S hS X L s U) := by
  let _ := chartAlgebra (hF := X.2) f
  let _ := chartSectionsModule L f
  have _ := chartSections_isScalarTower L f
  have _ : Module.Flat (chartRing B S hS X.1 X.2 U) (chartRing B S hS X.1 X.2 V) :=
    moduleFlat_chartRing_of_isAffine f hU hV
  have _ := hfp
  let e := LinearEquiv.ofBijective (sectionsBaseChange L f) hbc
  have hs : chartRestrictLinear L f (s.eval (op U)) = s.eval (op V) :=
    PresheafOfModules.sections_property s f.op
  have hone : e (TensorProduct.tmul (chartRing B S hS X.1 X.2 U)
      (1 : chartRing B S hS X.1 X.2 V) (s.eval (op U))) = s.eval (op V) :=
    (chartBaseChange_one_tmul L f (s.eval (op U))).trans hs
  refine Ideal.span_le.2 (Set.range_subset_iff.2 fun l => ?_)
  have hmem := Ideal.mem_map_span_range_dual (A := chartRing B S hS X.1 X.2 U)
    (C := chartRing B S hS X.1 X.2 V) (M := L.val.obj (op U)) (s.eval (op U))
    (l ∘ₗ e.toLinearMap)
  rw [show ((l ∘ₗ e.toLinearMap) (TensorProduct.tmul (chartRing B S hS X.1 X.2 U)
      (1 : chartRing B S hS X.1 X.2 V) (s.eval (op U)))) = l (s.eval (op V)) from
    congrArg l hone] at hmem
  exact SetLike.mem_coe.2 hmem

/-! ### Locality of membership in the evaluation ideal over an affine chart -/

/-- **Membership in the evaluation ideal over an affine étale chart is local.**  A regular
function on an affine chart whose restriction to each member of a covering lies in the evaluation
ideal there already lies in the evaluation ideal.

A covering sieve of an affine chart contains a finite family of affine charts whose restriction
maps are jointly faithfully flat, and over each of them the evaluation ideal is the extension of
the evaluation ideal over the chart by
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_le_map`; so the ideal generated by the function
and the evaluation ideal has the same extension as the evaluation ideal in every member, and
`Ideal.eq_of_le_of_forall_map_le` identifies the two. -/
theorem mem_sectionEvaluationIdealAt_of_sieve (hL : IsCartesianOnAffineCharts L)
    (hfp : ∀ W : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
      Module.FinitePresentation (chartRing B S hS X.1 X.2 W) (L.val.obj (op W)))
    {V : SmallEtale B S hS X.1}
    (hV : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    {T : Sieve V} (hT : T ∈ SmallEtale.topology B S hS X.1 V)
    (a : chartRing B S hS X.1 X.2 V)
    (h : ∀ (W : SmallEtale B S hS X.1) (g : W ⟶ V), T g →
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
      chartRestrict (hF := X.2) g a ∈ sectionEvaluationChartIdeal B S hS X L s W) :
    a ∈ sectionEvaluationChartIdeal B S hS X L s V := by
  classical
  obtain ⟨n, z, φ, hzaff, hzT, hff⟩ :=
    exists_finite_affine_faithfullyFlat_pi_le B S hS X.1 X.2 hV hT
  let _ : ∀ i, Algebra (chartRing B S hS X.1 X.2 V) (chartRing B S hS X.1 X.2 (z i)) :=
    fun i => chartAlgebra (hF := X.2) (φ i)
  have _ : Module.FaithfullyFlat (chartRing B S hS X.1 X.2 V)
      (∀ i, chartRing B S hS X.1 X.2 (z i)) := hff
  have hstep : ∀ i, Ideal.map (algebraMap (chartRing B S hS X.1 X.2 V)
        (chartRing B S hS X.1 X.2 (z i)))
        (sectionEvaluationChartIdeal B S hS X L s V ⊔ Ideal.span {a}) ≤
      Ideal.map (algebraMap (chartRing B S hS X.1 X.2 V) (chartRing B S hS X.1 X.2 (z i)))
        (sectionEvaluationChartIdeal B S hS X L s V) := by
    intro i
    rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton]
    refine sup_le le_rfl (Ideal.span_le.2 (Set.singleton_subset_iff.2 ?_))
    exact SetLike.mem_coe.2 (sectionEvaluationIdealAt_le_map B S hS X L s (φ i)
      (hL V (z i) hV (hzaff i) (φ i)) hV (hzaff i) (hfp V hV) (h (z i) (φ i) (hzT i) (hzaff i)))
  have heq := Ideal.eq_of_le_of_forall_map_le
    (le_sup_left : sectionEvaluationChartIdeal B S hS X L s V ≤
      sectionEvaluationChartIdeal B S hS X L s V ⊔ Ideal.span {a}) hstep
  rw [heq]
  exact Ideal.mem_sup_right (Ideal.subset_span rfl)

/-! ### The sheaf of ideals of Stacks 0845 -/

/-- The ideal of regular functions on an étale chart `U` of `X` whose restriction to every affine
étale chart over `U` lies in the evaluation ideal of the section there. -/
def zeroSchemeIdealAt (U : (SmallEtale B S hS X.1)ᵒᵖ) :
    Ideal (ToType ((structureRingSheaf B S hS X).obj.obj U)) where
  carrier := {a | ∀ (V : SmallEtale B S hS X.1)
    (_ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    (g : U ⟶ op V),
    ((structureRingSheaf B S hS X).obj.map g).hom a ∈ sectionEvaluationIdealAt B S hS X L s V}
  add_mem' {a b} ha hb := fun V hV g => by
    rw [map_add]
    exact Ideal.add_mem _ (ha V hV g) (hb V hV g)
  zero_mem' := fun V hV g => by
    rw [map_zero]
    exact Ideal.zero_mem _
  smul_mem' c a ha := fun V hV g => by
    rw [smul_eq_mul, map_mul]
    exact Ideal.mul_mem_left _ _ (ha V hV g)

/-- Membership in the chartwise ideal of
`AlgebraicGeometry.Space.zeroSchemeIdealAt`, unfolded. -/
theorem mem_zeroSchemeIdealAt_iff (U : (SmallEtale B S hS X.1)ᵒᵖ)
    (a : ToType ((structureRingSheaf B S hS X).obj.obj U)) :
    a ∈ zeroSchemeIdealAt B S hS X L s U ↔
      ∀ (V : SmallEtale B S hS X.1)
        (_ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
        (g : U ⟶ op V),
        ((structureRingSheaf B S hS X).obj.map g).hom a ∈
          sectionEvaluationIdealAt B S hS X L s V :=
  Iff.rfl

/-- The chartwise ideals of `AlgebraicGeometry.Space.zeroSchemeIdealAt` are stable under étale
restriction. -/
theorem zeroSchemeIdealAt_map {U V : (SmallEtale B S hS X.1)ᵒᵖ} (f : U ⟶ V)
    (a : ToType ((structureRingSheaf B S hS X).obj.obj U))
    (ha : a ∈ zeroSchemeIdealAt B S hS X L s U) :
    ((structureRingSheaf B S hS X).obj.map f).hom a ∈ zeroSchemeIdealAt B S hS X L s V := by
  intro W hW g
  have h := ha W hW (f ≫ g)
  rw [(structureRingSheaf B S hS X).obj.map_comp] at h
  simpa using h

/-- On an affine étale chart the chartwise ideal of
`AlgebraicGeometry.Space.zeroSchemeIdealAt` is contained in the evaluation ideal: this is its
defining condition read at the identity of the chart. -/
theorem zeroSchemeIdealAt_le_sectionEvaluationIdealAt (W : SmallEtale B S hS X.1)
    (hW : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W)) :
    zeroSchemeIdealAt B S hS X L s (op W) ≤ sectionEvaluationChartIdeal B S hS X L s W := by
  intro a ha
  have h := ha W hW (𝟙 (op W))
  rw [(structureRingSheaf B S hS X).obj.map_id] at h
  exact h

variable (hL : IsCartesianOnAffineCharts L)
    (hfp : ∀ W : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
      Module.FinitePresentation (chartRing B S hS X.1 X.2 W) (L.val.obj (op W)))

include hL hfp in
/-- **Membership in the chartwise ideal of `AlgebraicGeometry.Space.zeroSchemeIdealAt` is local
on the small étale site.**  Over an affine chart below the given one the covering sieve pulls
back to a covering sieve, and
`AlgebraicGeometry.Space.mem_sectionEvaluationIdealAt_of_sieve` descends membership in the
evaluation ideal there. -/
theorem mem_zeroSchemeIdealAt_of_sieve (U : (SmallEtale B S hS X.1)ᵒᵖ)
    (a : ToType ((structureRingSheaf B S hS X).obj.obj U))
    (T : Sieve U.unop) (hT : T ∈ SmallEtale.topology B S hS X.1 U.unop)
    (h : ∀ (W : (SmallEtale B S hS X.1)ᵒᵖ) (m : U ⟶ W), T m.unop →
      ((structureRingSheaf B S hS X).obj.map m).hom a ∈ zeroSchemeIdealAt B S hS X L s W) :
    a ∈ zeroSchemeIdealAt B S hS X L s U := by
  intro V hV g
  refine mem_sectionEvaluationIdealAt_of_sieve B S hS X L s hL hfp hV
    (T := Sieve.pullback g.unop T)
    ((SmallEtale.topology B S hS X.1).pullback_stable g.unop hT) _ ?_
  intro W k hk hWaff
  change chartRestrict (hF := X.2) k (((structureRingSheaf B S hS X).obj.map g).hom a) ∈
    sectionEvaluationIdealAt B S hS X L s W
  have hcomp : chartRestrict (hF := X.2) k (((structureRingSheaf B S hS X).obj.map g).hom a) =
      ((structureRingSheaf B S hS X).obj.map (g ≫ k.op)).hom a :=
    (DFunLike.congr_fun (chartRestrict_comp (hF := X.2) g.unop k) a).symm
  rw [hcomp]
  exact zeroSchemeIdealAt_le_sectionEvaluationIdealAt B S hS X L s W hWaff
    (h (op W) (g ≫ k.op) hk)

include hL in
/-- **On an affine étale chart the chartwise ideal of
`AlgebraicGeometry.Space.zeroSchemeIdealAt` is the evaluation ideal of the section.**  One
containment is the condition at the identity of the chart, and the other is that the evaluation
ideal restricts into the evaluation ideal between affine charts. -/
theorem zeroSchemeIdealAt_eq_sectionEvaluationIdealAt (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    zeroSchemeIdealAt B S hS X L s (op U) = sectionEvaluationChartIdeal B S hS X L s U := by
  refine le_antisymm (zeroSchemeIdealAt_le_sectionEvaluationIdealAt B S hS X L s U hU)
    fun a ha V hV g => ?_
  exact sectionEvaluationIdealAt_map_le_of_bijective_sectionsBaseChange B S hS X L s g.unop
    (hL U V hU hV g.unop) (Ideal.mem_map_of_mem _ ha)

include hL hfp in
/-- **The sheaf of ideals of Stacks 0845**: the regular functions on an étale chart whose
restriction to every affine étale chart below lies in the evaluation ideal of the section there.
On an affine chart it is the evaluation ideal itself. -/
def zeroSchemeIdealSheaf : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule where
  obj U := zeroSchemeIdealAt B S hS X L s U
  map f a ha := zeroSchemeIdealAt_map B S hS X L s f a ha
  isSheaf {U} a ha :=
    mem_zeroSchemeIdealAt_of_sieve B S hS X L s hL hfp U a _ ha fun _ _ hm => hm

include hL hfp in
/-- The sections of the sheaf of ideals over an affine étale chart are the evaluation ideal. -/
theorem chartIdeal_zeroSchemeIdealSheaf (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    chartIdeal B S hS X (zeroSchemeIdealSheaf B S hS X L s hL hfp) U =
      sectionEvaluationChartIdeal B S hS X L s U :=
  zeroSchemeIdealAt_eq_sectionEvaluationIdealAt B S hS X L s hL U hU

include hL hfp in
/-- **The sheaf of ideals of Stacks 0845 is cartesian on affine charts.**  For a sheaf of ideals
the cartesian condition is surjectivity of the base change comparison, which here is exactly
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_le_map`. -/
theorem isCartesianOnAffineCharts_zeroSchemeIdealSheaf :
    IsCartesianOnAffineCharts
      (zeroSchemeIdealSheaf B S hS X L s hL hfp).toSheafOfModules := by
  refine isCartesianOnAffineCharts_submodule_unit_of_surjective B S hS X _
    fun U V hU hV f => surjective_sectionsBaseChange_of_chartIdeal_le_map B S hS X _ f ?_
  rw [chartIdeal_zeroSchemeIdealSheaf B S hS X L s hL hfp V hV,
    chartIdeal_zeroSchemeIdealSheaf B S hS X L s hL hfp U hU]
  exact sectionEvaluationIdealAt_le_map B S hS X L s f (hL U V hU hV f) hU hV (hfp U hU)

include hL hfp in
/-- **The sheaf of ideals of Stacks 0845 is quasi-coherent**, by the converse implication of
Descent, Proposition 03DX(2). -/
theorem isQuasicoherentOnSite_zeroSchemeIdealSheaf :
    (zeroSchemeIdealSheaf B S hS X L s hL hfp).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_zeroSchemeIdealSheaf B S hS X L s hL hfp)

include hL hfp in
/-- **A closed subspace of `X` has the evaluation ideal of the section as its defining ideal on
every affine étale chart.**  The sheaf of ideals of Stacks 0845 is quasi-coherent, so the
surjectivity half of Stacks 03MB cuts out a closed subspace by it. -/
theorem exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isCartesian :
    ∃ Z : ClosedSubspaces B S hS X.1, ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U := by
  obtain ⟨Z, hZ⟩ := exists_definingIdealAt_eq_of_isQuasicoherentOnSite B S hS X _
    (isQuasicoherentOnSite_zeroSchemeIdealSheaf B S hS X L s hL hfp)
  exact ⟨Z, fun U hU => (hZ (op U)).trans
    (zeroSchemeIdealAt_eq_sectionEvaluationIdealAt B S hS X L s hL U hU)⟩

/-! ### The case of an invertible module -/

/-- **Stacks 0846: the zero scheme of a section of an invertible module is cut out by the
evaluation ideal.**  Some closed subspace of `X` has the evaluation ideal of the section as its
defining ideal on every affine étale chart.

This is the hypothesis `hZ` carried by every assertion of
`StacksFrontier/AlgebraicGeometry/Spaces/ZeroSchemeProperties.lean`, discharged.  An invertible
module on the small étale site of an algebraic space is finite locally free of rank one, hence
quasi-coherent — so cartesian on affine charts by Descent, Proposition 03DX(2) — and of finite
presentation, so its sections over an affine chart are a finitely presented module. -/
theorem exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L) :
    ∃ Z : ClosedSubspaces B S hS X.1, ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
