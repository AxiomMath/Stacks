module

public import StacksFrontier.AlgebraicGeometry.Spaces.Perfect.PerfectDirectSummandExtension

/-!
# A single perfect generator of `D_QCoh(𝒪_X)` for a qcqs algebraic space

Let `X` be a quasi-compact and quasi-separated algebraic space over a scheme `S`. There is a
perfect object `P` of `D(𝒪_X)` such that an object `E` of `D_QCoh(𝒪_X)` is zero exactly when
`Hom(P[n], E) = 0` for every integer `n` (Stacks 09IY).

The proof is the induction principle of Stacks 08GP (`qcqs_induction_on_self`): the affine case
is `AlgebraicGeometry.Space.exists_perfect_generator_of_isAffineSpace`; for an elementary
distinguished square `(U ⊆ W, f : V ⟶ W)` with `V` affine and a perfect generator `P_U` on `U`,
Stacks 09IX (`AlgebraicGeometry.Space.exists_isPerfect_retract_restrict`) makes `P_U` a summand of
`Q|_U` for a perfect `Q` on `W`, and
`AlgebraicGeometry.Space.exists_perfect_generator_of_eds_of_isRetract` produces the generator on
`W`.

## Main results

* `AlgebraicGeometry.Space.exists_isPerfect_isZero_iff_forall_hom_shift_eq_zero`: Stacks 09IY.

## References

* [Stacks Project, Tag 09IY](https://stacks.math.columbia.edu/tag/09IY)
* [Stacks Project, Tag 08GP](https://stacks.math.columbia.edu/tag/08GP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian

attribute [local instance 10000] HasDerivedCategory.standard

attribute [-instance] CategoryTheory.Limits.Types.instHasPushoutsType in
/-- **Stacks 09IY.** Let `S` be a scheme and `X` a quasi-compact and quasi-separated algebraic
space over `S`. The category `D_QCoh(𝒪_X)` is generated by a single perfect object: there is a
perfect object `P` of `D(𝒪_X)` such that for `E` in `D_QCoh(𝒪_X)` the following are equivalent:
(1) `E = 0`, (2) `Hom(P[n], E) = 0` for all `n ∈ ℤ`. -/
@[stacks 09IY]
theorem exists_isPerfect_isZero_iff_forall_hom_shift_eq_zero (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) (hZ : B.Contains (⊤_ Scheme.{u})) (X : AlgebraicSpaces B S hS)
    (hXqc : IsQuasiCompactSpace B S hS X.1) (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1) :
    ∃ P : DerivedCategory (Modules.{u, u} B S hS X.1 X.2),
      (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect P ∧
      ∀ E, qcohDerivedProp B S hS X E → (IsZero E ↔ ∀ (n : ℤ) (g : P⟦n⟧ ⟶ E), g = 0) := by
  have key := qcqs_induction_on_self B S hS hZ X hXqc hXqs
    (fun Y _ => ∀ hY : IsAlgebraicSpace B S hS Y,
      ∃ G : DerivedCategory (Modules.{u, u} B S hS Y hY),
        (smallEtaleRingedSite B S hS Y hY).IsPerfect G ∧
        ∀ E, qcohDerivedProp B S hS ⟨Y, hY⟩ E → (∀ (n : ℤ) (g : G⟦n⟧ ⟶ E), g = 0) → IsZero E)
    (fun V hV hY => exists_perfect_generator_of_isAffineSpace B S hS (V := ⟨V.1.left.1, hY⟩) hV)
    (fun W V U f _ hsq hWqc hWqs hUqc hV hPU _ _ hY => by
      let W' : AlgebraicSpaces B S hS := ⟨W.1.left.1, hY⟩
      have hsq' : IsElementaryDistinguishedSquare B S hS W'.2 U f := hsq
      obtain ⟨G, hG, hGgen⟩ := hPU hsq'.isOpenSubspace.1
      obtain ⟨Q, hQ, s, r, hsr⟩ := exists_isPerfect_retract_restrict hZ W' hWqc hWqs U
        hsq'.isOpenSubspace hUqc G hG
      exact exists_perfect_generator_of_eds_of_isRetract B S hS hsq' hZ hWqs hUqc hV G hGgen Q hQ
        s r hsr)
  obtain ⟨P, hP, hgen⟩ := key X.2
  exact ⟨P, hP, fun E hE => ⟨fun h n g => h.eq_of_tgt _ _, hgen E hE⟩⟩

end AlgebraicGeometry.Space

end
