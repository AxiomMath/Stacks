-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **A finite locally free module is quasi-coherent.** -/
theorem isQuasicoherentOnSite_of_isFiniteLocallyFreeOnSite {X : AlgebraicSpaces B S hS}
    (E : Modules.{u, u} B S hS X.1 X.2) (hE : SheafOfModules.IsFiniteLocallyFreeOnSite E) :
    E.IsQuasicoherentOnSite :=
  have := SheafOfModules.isFinitePresentationOnSite_of_isFiniteLocallyFreeOnSite hE
  SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentationOnSite E

/-- **Finitely many sections of a direct image over an affine chart are covered by a finite
locally free module on the target.**  Let `f : X ⟶ Y` be a quasi-compact and quasi-separated
morphism of algebraic spaces over `S`, let `Y` be quasi-compact, quasi-separated and have the
resolution property, let `ℱ` be a quasi-coherent `𝒪_X`-module, let `V` be an affine étale chart
of `Y`, and let `σ x`, for `x` in a finite set, be sections of `f_*ℱ` over `V`.  Then there are
a submodule `𝒢` of `f_*ℱ` containing every `σ x` over `V`, a finite locally free `𝒪_Y`-module
`ℰ` and an epimorphism `ℰ ⟶ 𝒢`.  See Stacks 03M9 and Stacks 0829. -/
theorem exists_finiteLocallyFree_epi_submodule_modulePushforward
    (hZ : B.Contains (⊤_ Scheme.{u})) {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (hfqc : IsQuasiCompact B S hS f.hom) (hfqs : IsQuasiSeparated B S hS f.hom)
    (hYqc : IsQuasiCompactSpace B S hS Y.1)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1)
    (hYres : HasResolutionProperty.{u, u} B S hS Y.1 Y.2)
    (F : Modules.{u, u} B S hS X.1 X.2) (hF : F.IsQuasicoherentOnSite)
    {α : Type*} (s : Finset α) (V : SmallEtale B S hS Y.1) (hV : IsAffine (chartScheme V))
    (σ : α → ((modulePushforward B S hS f).obj F).val.obj (op V)) :
    ∃ (G : ((modulePushforward B S hS f).obj F).Submodule)
      (E : Modules.{u, u} B S hS Y.1 Y.2)
      (_ : SheafOfModules.IsFiniteLocallyFreeOnSite E)
      (φ : E ⟶ G.toSheafOfModules), Epi φ ∧ ∀ x ∈ s, σ x ∈ G.obj (op V) := by
  have hpush : ((modulePushforward B S hS f).obj F).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePushforward_of_qcqs B S hS f hfqc hfqs F hF
  have hcart : IsCartesianOnAffineCharts ((modulePushforward B S hS f).obj F) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2 _ hpush
  obtain ⟨D, hD⟩ := (chartExtensionProperty_id hZ hYqc hYqs hcart).exists_forall_mem hcart s
    (fun _ => V) (fun _ => V.1.hom) (fun _ => Category.comp_id _) (fun _ => hV) σ
  have hqc : (D.toSubmodule _).toSheafOfModules.IsQuasicoherentOnSite :=
    (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS Y.1 Y.2 _).2
      (D.isCartesianOnAffineCharts_toSubmodule hcart)
  have : SheafOfModules.IsFiniteTypeOnSite (D.toSubmodule _).toSheafOfModules :=
    D.isFiniteTypeOnSite_toSubmodule hcart
  obtain ⟨E, hE, φ, hφ⟩ := hYres.exists_finiteLocallyFree_quotient
    (⟨(D.toSubmodule _).toSheafOfModules, hqc⟩ : QuasicoherentSheaves.{u, u} B S hS Y.1 Y.2)
  exact ⟨D.toSubmodule _, E, hE, φ, hφ, hD⟩

/-- **The step of the proof of Stacks 0GUU which produces the finite locally free module on the
source.**  In the situation of
`AlgebraicGeometry.Space.exists_finiteLocallyFree_epi_submodule_modulePushforward` the pullback
`f^*ℰ` is again finite locally free, and the map `ℰ ⟶ f_*ℱ` — the epimorphism onto the submodule
`𝒢` followed by its inclusion — transposes along `f^* ⊣ f_*` to a map `ψ : f^*ℰ ⟶ ℱ`.

This is the source's sentence *"Then the corresponding maps `f^*ℰ_i ⊗ ℒ^{⊗ n_i} → ℱ` are going to
be jointly surjective"* at `ℒ = 𝒪_X`, up to that surjectivity: the module and the map exist, and
`ψ` is characterized by its transpose being `φ ≫ 𝒢.ι`.  Finite local freeness of `f^*ℰ` is
Stacks 03DL under pullback. -/
@[stacks 0GUU "the step of the proof producing the finite locally free module on the target and
its transpose on the source, for a quasi-compact quasi-separated morphism: the sections of the
direct image over an affine chart of the target lie in the image submodule"]
theorem exists_finiteLocallyFree_modulePullback_hom_of_hasResolutionProperty
    (hZ : B.Contains (⊤_ Scheme.{u})) {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (hfqc : IsQuasiCompact B S hS f.hom) (hfqs : IsQuasiSeparated B S hS f.hom)
    (hYqc : IsQuasiCompactSpace B S hS Y.1)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1)
    (hYres : HasResolutionProperty.{u, u} B S hS Y.1 Y.2)
    (F : Modules.{u, u} B S hS X.1 X.2) (hF : F.IsQuasicoherentOnSite)
    {α : Type*} (s : Finset α) (V : SmallEtale B S hS Y.1) (hV : IsAffine (chartScheme V))
    (σ : α → ((modulePushforward B S hS f).obj F).val.obj (op V)) :
    ∃ (G : ((modulePushforward B S hS f).obj F).Submodule)
      (E : Modules.{u, u} B S hS Y.1 Y.2)
      (_ : SheafOfModules.IsFiniteLocallyFreeOnSite E)
      (φ : E ⟶ G.toSheafOfModules), Epi φ ∧ (∀ x ∈ s, σ x ∈ G.obj (op V)) ∧
        SheafOfModules.IsFiniteLocallyFreeOnSite ((modulePullback B S hS f).obj E) ∧
        ∃ ψ : (modulePullback B S hS f).obj E ⟶ F,
          (modulePullbackAdjunction B S hS f).homEquiv E F ψ = φ ≫ G.ι := by
  obtain ⟨G, E, hE, φ, hφ, hmem⟩ :=
    exists_finiteLocallyFree_epi_submodule_modulePushforward hZ f hfqc hfqs hYqc hYqs hYres F hF
      s V hV σ
  exact ⟨G, E, hE, φ, hφ, hmem,
    isFiniteLocallyFreeOnSite_modulePullback B S hS f E
      (isQuasicoherentOnSite_of_isFiniteLocallyFreeOnSite E hE) hE,
    ((modulePullbackAdjunction B S hS f).homEquiv E F).symm (φ ≫ G.ι), Equiv.apply_symm_apply _ _⟩

end AlgebraicGeometry.Space

end
