module

public import StacksFrontier.AlgebraicGeometry.Spaces.Perfect.AffinePerfectSections
public import StacksFrontier.AlgebraicGeometry.Spaces.Perfect.RepresentedAffineUnitObject
public import StacksFrontier.Homology.Perfect.Characterizing

/-!
# Perfect objects on an affine representable are generated by the structure sheaf

Let `U` be an object of the big fppf site over `S` with affine underlying scheme `Spec R`.  A
perfect object `E` of `D(𝒪_{h_U})` lies in `D_QCoh`, so it is `Φ(RΓ(E))` for the associated module
`Φ : D(R) ⥤ D(𝒪_{h_U})` (Stacks 08H1), and `RΓ(E)` is a perfect object of `D(R)`.  The perfect
objects of `D(R)` are the triangulated envelope of `R` (Stacks 0ATH), and `Φ` is triangulated, so
`E` lies in the triangulated envelope of `Φ(R) = 𝒪`: it is reached from the structure sheaf by
shifts, finite direct sums, extensions and direct summands.

## Main results

* `AlgebraicGeometry.Space.triangEnvelope_representedAffineUnitObj_of_isPerfect`: every perfect
  object of `D(𝒪_{h_U})` lies in the triangulated envelope of the structure sheaf.

## References

* [Stacks Project, Lemma 75.13.6 (Tag 08H1)](https://stacks.math.columbia.edu/tag/08H1)
* [Stacks Project, Lemma 15.74.? (Tag 0ATH)](https://stacks.math.columbia.edu/tag/0ATH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

namespace AlgebraicGeometry.Space

attribute [local instance 5000] SheafOfModules.instAbelian


attribute [local instance] hasProductsOfShape_nat_modules_ringUniverse
  enoughInjectives_modules_ringUniverse isGrothendieckAbelian_modules_ringUniverse

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (V : BigFppfOver B S hS)
  [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]

/-- The triangulated envelope of an object is stable under the passage to an isomorphic object. -/
theorem _root_.CategoryTheory.ObjectProperty.triangEnvelope_of_iso {C : Type*} [Category C]
    [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] (P : ObjectProperty C) {X Y : C} (e : X ≅ Y) (hX : P.triangEnvelope X) :
    P.triangEnvelope Y :=
  P.triangEnvelope.prop_of_retract ⟨e.inv, e.hom, e.inv_hom_id⟩ hX

/-- **Every perfect object of `D(𝒪_{h_U})` lies in the triangulated envelope of the structure
sheaf**, in the spelling of the derived category of `𝒪`-modules of the small étale ringed site. -/
theorem triangEnvelope_representedAffineDerivedAssociated_of_isPerfect
    (E : @DerivedCategory (Modules.{u, u} B S hS (yoneda.obj V) (isAlgebraicSpace_yoneda B S hS V))
      _ _ (HasDerivedCategory.standard _))
    (hE : letI := HasDerivedCategory.standard (Modules.{u, u} B S hS (yoneda.obj V)
        (isAlgebraicSpace_yoneda B S hS V))
      (smallEtaleRingedSite B S hS (yoneda.obj V)
        (isAlgebraicSpace_yoneda B S hS V)).IsPerfect E) :
    letI := HasDerivedCategory.standard (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
    (ObjectProperty.singleton ((representedAffineDerivedAssociated B S hS V).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
        0).obj (ModuleCat.of Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
          Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))))).triangEnvelope E := by
  let := HasDerivedCategory.standard (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
  let := HasDerivedCategory.standard (Modules.{u, u} B S hS (yoneda.obj V)
    (isAlgebraicSpace_yoneda B S hS V))
  set X := (DerivedCategory.singleFunctor (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj V,
    ⊤)) 0).obj (ModuleCat.of Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
  set G := (representedAffineDerivedAssociated B S hS V).obj X
  let Q : ObjectProperty (DerivedCategory (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj V,
      ⊤))) :=
    (ObjectProperty.singleton G).triangEnvelope.inverseImage
      (representedAffineDerivedAssociated B S hS V)
  have hQr : Q.IsStableUnderRetracts :=
    ⟨fun r hY => (ObjectProperty.singleton G).triangEnvelope.prop_of_retract
      (r.map (representedAffineDerivedAssociated B S hS V)) hY⟩
  have hG : Q X :=
    ObjectProperty.le_triangEnvelope _ _ ((ObjectProperty.singleton_iff _ _).2 rfl)
  have hle := ((ObjectProperty.singleton X).triangEnvelope_le_iff (Q := Q)).2
    (ObjectProperty.singleton_le_iff.2 hG)
  have hM := isPerfect_representedAffineDerivedSections_obj B S hS V E hE
  rw [StacksDraft.Perfect.isPerfect_eq_triangEnvelope_singleton_regularModule] at hM
  have hQ := qcohDerived_of_isPerfect B S hS
    ⟨yoneda.obj V, isAlgebraicSpace_yoneda B S hS V⟩ E hE
  have hcounit := isIso_representedAffineDerivedAdjunction_counit_app B S hS V E hQ
  exact ObjectProperty.triangEnvelope_of_iso _
    (asIso ((representedAffineDerivedAdjunction B S hS V).counit.app E)) (hle _ hM)

/-- **Every perfect object of `D(𝒪_{h_U})` lies in the triangulated envelope of the structure
sheaf**, read in the derived category of `𝒪`-modules of the small étale ringed topos. -/
theorem triangEnvelope_representedAffineUnitObj_of_isPerfect
    (E : @DerivedCategory (Modules.{u, u} B S hS (yoneda.obj V) (isAlgebraicSpace_yoneda B S hS V))
      _ _ (HasDerivedCategory.standard _))
    (hE : letI := HasDerivedCategory.standard (Modules.{u, u} B S hS (yoneda.obj V)
        (isAlgebraicSpace_yoneda B S hS V))
      (smallEtaleRingedSite B S hS (yoneda.obj V)
        (isAlgebraicSpace_yoneda B S hS V)).IsPerfect E) :
    (ObjectProperty.singleton (representedAffineUnitObj B S hS V 0)).triangEnvelope E :=
  triangEnvelope_representedAffineDerivedAssociated_of_isPerfect B S hS V E hE

end AlgebraicGeometry.Space

end
