module

public import StacksFrontier.Algebra.Homology.DerivedCategory.MapDerivedCategoryComparisons
public import StacksFrontier.Algebra.Homology.HomotopyCategory.ExactFunctorHomology
public import StacksFrontier.AlgebraicGeometry.Spaces.AffineMorphismCohomologyIso
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleModulePullbackChartInjectives
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleModulePullbackUnitComp
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePushforwardEtaleBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.Perfect.PerfectnessLocalOnSmallEtale
public import StacksFrontier.AlgebraicGeometry.Spaces.Perfect.PushforwardOfSupportedPerfect
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Perfect.RestrictionGeneral
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Perfect.SiteEquivalenceTransport

/-!
# Perfectness of an object of `D(𝒪_X)` read on the affine étale charts

Let `X` be an algebraic space over a scheme `S`.  For an étale chart `W` of `X` the slice of the
small étale site of `X` at `W` is equivalent to the small étale site of the algebraic space
represented by `W` (Stacks 04M0), compatibly with the structure sheaves, and the induced
equivalence of module categories carries the restriction of an `𝒪_X`-module to the slice to its
pullback to the chart.  This file records the two consequences for perfect objects (Stacks 08G5)
that a proof by reduction to affine charts needs: perfectness of the reading on the chart gives
perfectness on the slice, and perfectness on every affine chart gives perfectness on `X`.

## Main results

* `AlgebraicGeometry.Space.isPerfect_over_of_isPerfect_etaleModulePullback`: if the transport to
  the chart of the restriction of `K` to the slice at `W` is perfect, then that restriction is
  perfect on the slice.
* `AlgebraicGeometry.Space.isPerfect_of_forall_isAffineChart`: an object of `D(𝒪_X)` whose
  transports to all affine étale charts are perfect is perfect.
* `AlgebraicGeometry.Space.etaleModulePullbackChartToSpaceNatIso`: the pullback to a chart is the
  slice restriction followed by the comparison equivalence, as functors.
* `AlgebraicGeometry.Space.isPerfect_etaleModulePullback_chartToSpace`: the pullback of a perfect
  object to an étale chart is perfect.
* `AlgebraicGeometry.Space.isPerfect_etaleModulePullback`: the pullback of a perfect object along
  an étale morphism of algebraic spaces is perfect.

## Implementation notes

The transport along the comparison equivalence is
`AlgebraicGeometry.RingedSite.isPerfect_pushforward_of_siteEquivalence`, with the structure maps
the identities that `AlgebraicGeometry.Space.chartLocalizationModuleEquivalence` is built from;
locality on `X` is `AlgebraicGeometry.Space.isPerfect_of_locally`, along the covering sieve
generated by the affine charts (Stacks 04JS).

## References

* [Stacks Project, Tag 08G5](https://stacks.math.columbia.edu/tag/08G5)
* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u d

namespace AlgebraicGeometry.Space

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

attribute [local instance] RingedSite.sliceHasSheafify RingedSite.sliceWEqualsLocallyBijective
  RingedSite.iterHasSheafifyAll RingedSite.iterWEqAll
  RingedSite.sliceRestrictionPreservesFiniteLimits
  RingedSite.sliceRestrictionPreservesFiniteColimits

attribute [local instance] etaleModulePullback_additive preservesFiniteLimits_etaleModulePullback
  preservesFiniteColimits_etaleModulePullback

attribute [local instance] CategoryTheory.Limits.comp_preservesFiniteLimits
  CategoryTheory.Limits.comp_preservesFiniteColimits

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (X : AlgebraicSpaces B S hS)

/-- The derived category of the modules on a slice, at the spelling of the structure sheaf of the
localized ringed site. -/
abbrev overRingedSiteHasDerivedCategory (W : (smallEtaleRingedSite B S hS X.1 X.2).C)
    [hW : HasDerivedCategory.{d} (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over W))] :
    HasDerivedCategory.{d} (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf ((smallEtaleRingedSite B S hS X.1 X.2).over W).O)) :=
  hW

attribute [local instance] overRingedSiteHasDerivedCategory

/-- The comparison equivalence of Stacks 04M0 on modules is additive. -/
instance additive_chartLocalizationModuleEquivalence_functor
    (W : (smallEtaleRingedSite B S hS X.1 X.2).C) :
    (chartLocalizationModuleEquivalence B S hS X W).functor.Additive where
  map_add := by
    intros
    ext
    rfl

/-- The inverse of the comparison equivalence of Stacks 04M0 on modules is additive. -/
instance additive_chartLocalizationModuleEquivalence_inverse
    (W : (smallEtaleRingedSite B S hS X.1 X.2).C) :
    (chartLocalizationModuleEquivalence B S hS X W).inverse.Additive where
  map_add := by
    intros
    ext
    rfl

/-- **Perfectness on a chart gives perfectness on the slice.**  If the transport to the small étale
site of the chart `W` of the restriction of `K` to the slice of `X_étale` at `W` is perfect, then
that restriction is a perfect object on the localized ringed site. -/
theorem isPerfect_over_of_isPerfect_etaleModulePullback
    (W : (smallEtaleRingedSite B S hS X.1 X.2).C)
    [HasDerivedCategory.{d} (Modules.{u, u} B S hS X.1 X.2)]
    [HasDerivedCategory.{d}
      (Modules.{u, u} B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)]
    [hW : HasDerivedCategory.{d} (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over W))]
    (K : DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (hK : (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1
        (chartSpace B S hS X W).2).IsPerfect
      ((chartLocalizationModuleEquivalence B S hS X W).functor.mapDerivedCategory.obj
        ((SheafOfModules.overFunctor.{u}
          (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)
            W).mapDerivedCategory.obj K))) :
    ((smallEtaleRingedSite B S hS X.1 X.2).over W).IsPerfect
      ((SheafOfModules.overFunctor.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)
          W).mapDerivedCategory.obj K) := by
  let E : SmallEtale B S hS (chartSpace B S hS X W).1 ≌ Over W :=
    SmallEtale.chartLocalizationEquivalence B S hS X.1 W
  have hc1 : E.functor.IsContinuous
      (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2).J
      ((smallEtaleRingedSite B S hS X.1 X.2).over W).J := by
    change E.functor.IsContinuous _ ((smallEtaleRingedSite B S hS X.1 X.2).J.over W)
    exact isContinuous_chartLocalization_chartSpace B S hS X W
  have hc2 : E.inverse.IsContinuous
      ((smallEtaleRingedSite B S hS X.1 X.2).over W).J
      (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2).J := by
    change E.inverse.IsContinuous ((smallEtaleRingedSite B S hS X.1 X.2).J.over W) _
    exact isContinuous_chartLocalizationInverse_chartSpace B S hS X W
  have hT := RingedSite.isPerfect_pushforward_of_siteEquivalence
    (Y := smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)
    (X := (smallEtaleRingedSite B S hS X.1 X.2).over W) E (hFc := hc1) (hIc := hc2) (𝟙 _) (𝟙 _)
    (hψ := IsIso.id _)
    (by ext : 2; exact rfl) (by ext : 2; exact rfl) _ hK
  let F := (chartLocalizationModuleEquivalence B S hS X W).functor
  let Q := (chartLocalizationModuleEquivalence B S hS X W).inverse
  have := RingedSite.pushforward_additive_of_siteEquivalence
    (Y := smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)
    (X := (smallEtaleRingedSite B S hS X.1 X.2).over W) E (hIc := hc2) (𝟙 _)
  have := RingedSite.preservesFiniteLimits_pushforward_of_siteEquivalence
    (Y := smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)
    (X := (smallEtaleRingedSite B S hS X.1 X.2).over W) E (hFc := hc1) (hIc := hc2) (𝟙 _) (𝟙 _)
    (by ext : 2; exact rfl) (by ext : 2; exact rfl)
  have := RingedSite.preservesFiniteColimits_pushforward_of_siteEquivalence
    (Y := smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)
    (X := (smallEtaleRingedSite B S hS X.1 X.2).over W) E (hFc := hc1) (hIc := hc2) (𝟙 _) (𝟙 _)
    (by ext : 2; exact rfl) (by ext : 2; exact rfl)
  exact RingedSite.IsPerfect.of_iso _ hT
    (((Stacks.DerivedCategoryComparisons.mapDerivedCategoryCompIso F Q).app _).symm ≪≫
      (Stacks.DerivedCategoryComparisons.mapDerivedCategoryIsoOfNatIso (F ⋙ Q) (𝟭 _)
        (chartLocalizationModuleEquivalence B S hS X W).unitIso.symm).app _ ≪≫
      (Stacks.Homology.mapDerivedCategoryIdIso).app _)

/-- **Perfectness is detected on the affine étale charts.**  An object `K` of `D(𝒪_X)` is
perfect as soon as, at every étale chart `W` of `X` with affine underlying scheme, its restriction
to the slice at `W`, read on the small étale site of the chart through the comparison equivalence
of Stacks 04M0, is perfect. -/
theorem isPerfect_of_forall_isAffineChart
    [HasDerivedCategory.{d} (Modules.{u, u} B S hS X.1 X.2)]
    [∀ W : (smallEtaleRingedSite B S hS X.1 X.2).C,
      HasDerivedCategory.{d}
        (Modules.{u, u} B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)]
    [hW : ∀ W : (smallEtaleRingedSite B S hS X.1 X.2).C, HasDerivedCategory.{d} (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over W))]
    (K : DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (h : ∀ W : (smallEtaleRingedSite B S hS X.1 X.2).C, IsAffineChart B S hS X.1 W →
      (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2).IsPerfect
        ((chartLocalizationModuleEquivalence B S hS X W).functor.mapDerivedCategory.obj
          ((SheafOfModules.overFunctor.{u}
            (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)
              W).mapDerivedCategory.obj K))) :
    (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect K := by
  refine isPerfect_of_locally B S hS X.1 X.2 K fun U => ⟨fun W (_ : W ⟶ U) =>
    IsAffineChart B S hS X.1 W, generate_isAffineChart_mem_topology B S hS X U,
    fun W _ hW' => ?_⟩
  exact isPerfect_over_of_isPerfect_etaleModulePullback B S hS X W K (h W hW')

/-- **The étale pullback to an étale chart is the 04M0 reading of the restriction to the slice**,
as functors: `M|_W` on the chart space is the transport of `M|_{X_étale/W}` along the comparison
equivalence of Stacks 04M0.  Both are restrictions of sections along the same functor of sites, so
the components are identities. -/
def etaleModulePullbackChartToSpaceNatIso (W : (smallEtaleRingedSite B S hS X.1 X.2).C) :
    etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X W) (isEtale_chartToSpace B S hS X W) ≅
      SheafOfModules.overFunctor.{u}
          (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O) W ⋙
        (chartLocalizationModuleEquivalence B S hS X W).functor :=
  NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)

/-- **The pullback of a perfect object to an étale chart is perfect.**  If `K` is a perfect object
of `D(𝒪_X)` then its pullback to the algebraic space represented by an étale chart `W` of `X` is
perfect: the restriction of `K` to the slice at `W` is perfect, and the comparison equivalence of
Stacks 04M0 carries it to the pullback. -/
theorem isPerfect_etaleModulePullback_chartToSpace (W : (smallEtaleRingedSite B S hS X.1 X.2).C)
    [HasDerivedCategory.{d} (Modules.{u, u} B S hS X.1 X.2)]
    [HasDerivedCategory.{d}
      (Modules.{u, u} B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)]
    [hW : ∀ W : (smallEtaleRingedSite B S hS X.1 X.2).C, HasDerivedCategory.{d} (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over W))]
    (K : DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (hK : (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect K) :
    (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2).IsPerfect
      ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X W)
        (isEtale_chartToSpace B S hS X W)).mapDerivedCategory.obj K) := by
  have hslice := RingedSite.isPerfect_derivedRestriction_general
    (smallEtaleRingedSite B S hS X.1 X.2) K hK W
  let E : SmallEtale B S hS (chartSpace B S hS X W).1 ≌ Over W :=
    SmallEtale.chartLocalizationEquivalence B S hS X.1 W
  have hc1 : E.functor.IsContinuous
      (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2).J
      ((smallEtaleRingedSite B S hS X.1 X.2).over W).J := by
    change E.functor.IsContinuous _ ((smallEtaleRingedSite B S hS X.1 X.2).J.over W)
    exact isContinuous_chartLocalization_chartSpace B S hS X W
  have hc2 : E.inverse.IsContinuous
      ((smallEtaleRingedSite B S hS X.1 X.2).over W).J
      (smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2).J := by
    change E.inverse.IsContinuous ((smallEtaleRingedSite B S hS X.1 X.2).J.over W) _
    exact isContinuous_chartLocalizationInverse_chartSpace B S hS X W
  have hT := RingedSite.isPerfect_pushforward_of_siteEquivalence
    (X := smallEtaleRingedSite B S hS (chartSpace B S hS X W).1 (chartSpace B S hS X W).2)
    (Y := (smallEtaleRingedSite B S hS X.1 X.2).over W) E.symm (hFc := hc2) (hIc := hc1) (𝟙 _)
    (𝟙 _) (by ext : 2; exact rfl) (by ext : 2; exact rfl) (hψ := IsIso.id _) _ hslice
  refine RingedSite.IsPerfect.of_iso _ hT ?_
  exact ((Stacks.DerivedCategoryComparisons.mapDerivedCategoryCompIso
      (SheafOfModules.overFunctor.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O) W)
      (chartLocalizationModuleEquivalence B S hS X W).functor).app K).symm ≪≫
    (Stacks.DerivedCategoryComparisons.mapDerivedCategoryIsoOfNatIso _ _
      (etaleModulePullbackChartToSpaceNatIso B S hS X W).symm).app K

/-- **The pullback of a perfect object along an étale morphism of algebraic spaces is perfect.**
An affine étale chart `W` of the source `X'` of `j : X' ⟶ X`, composed with `j`, is an étale
chart of `X` with the same chart space, so the pullback of `j^*K` to `W` is the pullback of `K` to
that chart, which is perfect; perfectness on the affine charts gives perfectness on `X'`. -/
theorem isPerfect_etaleModulePullback {X' : AlgebraicSpaces B S hS} (j : X' ⟶ X)
    (hj : IsEtale B S hS j.hom)
    [hD : ∀ Z : AlgebraicSpaces B S hS, HasDerivedCategory.{d} (Modules.{u, u} B S hS Z.1 Z.2)]
    [hDs : ∀ (Z : AlgebraicSpaces B S hS) (W : (smallEtaleRingedSite B S hS Z.1 Z.2).C),
      HasDerivedCategory.{d} (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Z.1 Z.2).O).over W))]
    (K : DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (hK : (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect K) :
    (smallEtaleRingedSite B S hS X'.1 X'.2).IsPerfect
      ((etaleModulePullback.{u, u} B S hS j hj).mapDerivedCategory.obj K) := by
  refine isPerfect_of_forall_isAffineChart B S hS X' _ fun W _ => ?_
  let W' : (smallEtaleRingedSite B S hS X.1 X.2).C := (smallEtalePostcomp B S hS j hj).obj W
  have h := isPerfect_etaleModulePullback_chartToSpace B S hS X W' K hK
  refine RingedSite.IsPerfect.of_iso _ h ?_
  let Pj := etaleModulePullback.{u, u} B S hS j hj
  let PW := etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X' W)
    (isEtale_chartToSpace B S hS X' W)
  let Ov := SheafOfModules.overFunctor.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X'.1 X'.2).O) W
  let Eq := (chartLocalizationModuleEquivalence B S hS X' W).functor
  have := etaleModulePullback_additive B S hS (chartToSpace B S hS X' W ≫ j)
    (isEtale_chartToSpace B S hS X W')
  have := preservesFiniteLimits_etaleModulePullback B S hS (chartToSpace B S hS X' W ≫ j)
    (isEtale_chartToSpace B S hS X W')
  have := preservesFiniteColimits_etaleModulePullback B S hS (chartToSpace B S hS X' W ≫ j)
    (isEtale_chartToSpace B S hS X W')
  exact (Stacks.DerivedCategoryComparisons.mapDerivedCategoryIsoOfNatIso _ (Pj ⋙ PW)
      (etaleModulePullbackCompIso.{u, u} B S hS (chartToSpace B S hS X' W) j
        (isEtale_chartToSpace B S hS X' W) hj (isEtale_chartToSpace B S hS X W')).symm).app K ≪≫
    (Stacks.DerivedCategoryComparisons.mapDerivedCategoryCompIso Pj PW).app K ≪≫
    (Stacks.DerivedCategoryComparisons.mapDerivedCategoryIsoOfNatIso PW (Ov ⋙ Eq)
      (etaleModulePullbackChartToSpaceNatIso B S hS X' W)).app _ ≪≫
    (Stacks.DerivedCategoryComparisons.mapDerivedCategoryCompIso Ov Eq).app _

end AlgebraicGeometry.Space
