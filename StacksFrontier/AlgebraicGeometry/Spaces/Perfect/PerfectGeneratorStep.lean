/-!
# The inductive step for a single perfect generator of `D_QCoh`

Let `(U ⊆ X, j : V ⟶ X)` be an elementary distinguished square of algebraic spaces over a scheme
`S` with `X` quasi-separated, `U` quasi-compact and `V` affine. If `D_QCoh(𝒪_U)` is generated by a
perfect object `P`, and `P` is a direct summand of the restriction `Q|_U` of a perfect object `Q`
of `D(𝒪_X)`, then `D_QCoh(𝒪_X)` is generated by a single perfect object.

## Main results

* `AlgebraicGeometry.Space.exists_perfect_generator_of_isAffineSpace`: on an affine algebraic
  space, `D_QCoh` is generated by a single perfect object.
* `AlgebraicGeometry.Space.exists_perfect_generator_of_eds_of_isRetract`: the statement above.
* `AlgebraicGeometry.Space.exists_isPerfect_glue_of_eds`: perfect objects on `U` and `V` agreeing
  on `U ×_X V` glue to a perfect object of `D(𝒪_X)`.

## References

* [Stacks Project, Tag 09IY](https://stacks.math.columbia.edu/tag/09IY)
* [Stacks Project, Tag 09IR](https://stacks.math.columbia.edu/tag/09IR)
* [Stacks Project, Tag 08FA](https://stacks.math.columbia.edu/tag/08FA)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- In a pretriangulated category, if every morphism from a shift of `Z` to `E` vanishes, so does
every morphism from a shift of `Z` to a shift of `E`. -/
theorem eq_zero_of_forall_shift_hom_eq_zero {C : Type*} [Category* C] [Preadditive C]
    [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] {Z E : C}
    (h : ∀ (m : ℤ) (g : Z⟦m⟧ ⟶ E), g = 0) (m k : ℤ) (g : Z⟦m⟧ ⟶ E⟦k⟧) : g = 0 := by
  apply (shiftFunctor C (-k)).map_injective
  rw [Functor.map_zero,
    ← cancel_mono ((shiftFunctorCompIsoId C k (-k) (add_neg_cancel k)).hom.app E),
    zero_comp, ← cancel_epi ((shiftFunctorAdd' C m (-k) (m + -k) rfl).hom.app Z), comp_zero]
  exact h _ _

/-- If the counit of an adjunction `L ⊣ R` is invertible, then `L` carries every component of the
unit to an isomorphism. -/
theorem isIso_map_unit_app_of_isIso_counit {C D : Type*} [Category* C] [Category* D]
    {L : C ⥤ D} {R : D ⥤ C} (adj : L ⊣ R) [IsIso adj.counit] (E : C) :
    IsIso (L.map (adj.unit.app E)) := by
  have h : L.map (adj.unit.app E) = inv (adj.counit.app (L.obj E)) := by
    rw [← cancel_mono (adj.counit.app (L.obj E)), adj.left_triangle_components E,
      IsIso.inv_hom_id]
    rfl
  rw [h]
  infer_instance

/-- If `X` is a retract of `Z` and every morphism from a shift of `Z` to `E` vanishes, so does
every morphism from a shift of `X` to `E`. -/
private theorem eq_zero_of_retract_of_forall_shift_hom_eq_zero {C : Type*} [Category* C]
    [Preadditive C] [HasShift C ℤ] {X Z E : C} (i : X ⟶ Z) (p : Z ⟶ X) (hip : i ≫ p = 𝟙 X)
    (h : ∀ (n : ℤ) (g : Z⟦n⟧ ⟶ E), g = 0) (n : ℤ) (g : X⟦n⟧ ⟶ E) : g = 0 := by
  have hg : g = i⟦n⟧' ≫ p⟦n⟧' ≫ g := by
    rw [← Functor.map_comp_assoc, hip, CategoryTheory.Functor.map_id, Category.id_comp]
  rw [hg, h n (p⟦n⟧' ≫ g), comp_zero]

/-- In a pretriangulated category, a morphism into the third object of a distinguished triangle
vanishes if its composite with the third morphism does and every morphism from its source to the
second object vanishes. -/
private theorem eq_zero_of_comp_mor₃_eq_zero {C : Type*} [Category* C] [Preadditive C]
    [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {T : Triangle C} (hT : T ∈ distTriang C) {A : C} (f : A ⟶ T.obj₃) (h₂ : ∀ g : A ⟶ T.obj₂, g = 0)
    (h₃ : f ≫ T.mor₃ = 0) : f = 0 := by
  obtain ⟨g, rfl⟩ := Triangle.coyoneda_exact₃ T hT f h₃
  rw [h₂ g, zero_comp]

/-- Let `L ⊣ R` with `L` commuting with shifts, and let `P` be a retract of `L Q`. If the unit at
`E` is invertible, every morphism from a shift of `Q` to `E` vanishes, and `L E` is zero once every
morphism from a shift of `P` to it vanishes, then `E` is zero. -/
private theorem isZero_of_isIso_unit_app_of_retract {C D : Type*} [Category* C] [Category* D]
    [Preadditive C] [Preadditive D] [HasShift C ℤ] [HasShift D ℤ] {L : C ⥤ D} {R : D ⥤ C}
    (adj : L ⊣ R) [L.CommShift ℤ] [L.PreservesZeroMorphisms] {P : D} {Q E : C}
    (s : P ⟶ L.obj Q) (r : L.obj Q ⟶ P) (hsr : s ≫ r = 𝟙 P) [IsIso (adj.unit.app E)]
    (hQ : ∀ (n : ℤ) (g : Q⟦n⟧ ⟶ E), g = 0)
    (hP : (∀ (n : ℤ) (g : P⟦n⟧ ⟶ L.obj E), g = 0) → IsZero (L.obj E)) : IsZero E := by
  have hE0 : IsZero (L.obj E) := hP <|
    eq_zero_of_retract_of_forall_shift_hom_eq_zero s r hsr fun n g => by
      have h1 : adj.homEquiv (Q⟦n⟧) (L.obj E) ((L.commShiftIso n).hom.app Q ≫ g) = 0 :=
        (cancel_mono (inv (adj.unit.app E))).1 ((hQ n _).trans zero_comp.symm)
      have hx : (L.commShiftIso n).hom.app Q ≫ g = 0 := by
        rw [← (adj.homEquiv (Q⟦n⟧) (L.obj E)).symm_apply_apply ((L.commShiftIso n).hom.app Q ≫ g),
          h1, Adjunction.homEquiv_counit, Functor.map_zero, zero_comp]
      rw [← Iso.inv_hom_id_app_assoc (L.commShiftIso n) Q g, hx, comp_zero]
  exact IsZero.of_mono_eq_zero _ (eq_zero_of_isZero_leftAdjoint_obj adj hE0 (adj.unit.app E))

attribute [local instance] HasDerivedCategory.standard etaleModulePullback_additive
  preservesFiniteLimits_etaleModulePullback preservesFiniteColimits_etaleModulePullback
  smallEtaleRingedSite_hasSheafify_addCommGrpCat
  smallEtaleRingedSite_wEqualsLocallyBijective_addCommGrpCat

/-- An object of `D(𝒪_Y)` on an algebraic space without points is zero. -/
theorem isZero_of_isEmpty_points {Y : AlgebraicSpaces B S hS} (hY : IsEmpty (points B S hS Y.1))
    (E : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2)) : IsZero E :=
  (DerivedCategory.isZero_iff_forall_isZero_homology _).2 fun _ =>
    (supportOfSheaf_eq_empty_iff_isZero B S hS Y _).1 (Set.eq_empty_of_isEmpty _)

/-- On an affine algebraic space `V` there is a perfect object `G` of `D(𝒪_V)` such that an
object of `D_QCoh(𝒪_V)` receiving only zero maps from the shifts of `G` is zero. -/
theorem exists_perfect_generator_of_isAffineSpace {V : AlgebraicSpaces B S hS}
    (hV : IsAffineSpace B S hS V.1) :
    ∃ G : DerivedCategory (Modules.{u, u} B S hS V.1 V.2),
      (smallEtaleRingedSite B S hS V.1 V.2).IsPerfect G ∧
      ∀ E, qcohDerivedProp B S hS V E → (∀ (n : ℤ) (g : G⟦n⟧ ⟶ E), g = 0) → IsZero E := by
  let Yf := (⊥ : Subfunctor V.1).sheafify (BigFppfOver.topology B S hS)
  have hYo : IsOpenSubspace B S hS Yf := isOpenSubspace_sheafify_bot B S hS V.1 V.2
  let Y : AlgebraicSpaces B S hS := ⟨Yf.toFunctor, hYo.1⟩
  have hYe : IsEmpty (points B S hS Y.1) := isEmpty_points_sheafify_bot B S hS V.1
  have hYqc : IsQuasiCompactSpace B S hS Y.1 :=
    isQuasiCompactSpace_of_finite_jointly_surjective B S hS (I := PEmpty.{1})
      (Fi := fun i => i.elim) (fun i => i.elim) hYo.1 (fun i => i.elim)
      (by
        change (⋃ i : PEmpty.{1}, _) = Set.univ
        rw [Set.iUnion_of_empty]
        exact (Set.univ_eq_empty_iff.2 hYe).symm)
      (fun i => i.elim)
  obtain ⟨K, hK, -, hgen⟩ := exists_isPerfect_isZero_restrict_generator_of_isAffineSpace hV
    (ObjectProperty.homMk Yf.ι : Y ⟶ V) hYo.2 hYqc
  exact ⟨K, hK, fun E hE hKE => hgen E hE (isZero_of_isEmpty_points B S hS hYe _) hKE⟩

section Square

variable {W : AlgebraicSpaces B S hS} {V : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
  {Uo : Subfunctor W.1} {fV : V ⟶ W.1}
  (hsq : IsElementaryDistinguishedSquare B S hS W.2 Uo fV)

/-- On the étale chart `V` of an elementary distinguished square, with `X` quasi-separated and
`U` quasi-compact, there is a perfect object `K` of `D(𝒪_V)` whose extension by zero `j_!K` is
perfect and vanishes on `U`, and which generates the objects of `D_QCoh(𝒪_V)` vanishing on
`U ×_X V`. -/
private theorem exists_isPerfect_lowerShriek_generator_of_eds (hZ : B.Contains (⊤_ Scheme.{u}))
    (hWqs : IsAbsolutelyQuasiSeparated B S hS hZ W.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor) (hV : IsAffineSpace B S hS V) :
    ∃ K : DerivedCategory (Modules.{u, u} B S hS (edsEtale B S hS hsq).1 (edsEtale B S hS hsq).2),
      (smallEtaleRingedSite B S hS W.1 W.2).IsPerfect
        ((etaleModuleLowerShriek B S hS (edsEtaleHom B S hS hsq)
          (isEtale_edsEtaleHom B S hS hsq)).mapDerivedCategory.obj K) ∧
      IsZero ((edsDerivedRestrictOpen B S hS hsq).obj ((etaleModuleLowerShriek B S hS
        (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)).mapDerivedCategory.obj K)) ∧
      ∀ E, qcohDerivedProp B S hS (edsEtale B S hS hsq) E →
        IsZero ((etaleModulePullback.{u, u} B S hS (edsSnd B S hS hsq)
          (isEtale_edsSnd B S hS hsq)).mapDerivedCategory.obj E) →
        (∀ (n : ℤ) (g : K⟦n⟧ ⟶ E), g = 0) → IsZero E := by
  have hPqc : IsQuasiCompactSpace B S hS (edsInter B S hS hsq).1 :=
    isQuasiCompactSpace_pullback B S hS hZ Uo.ι fV hsq.isOpenSubspace.1 W.2 hUqc
      hV.isQuasiCompactSpace hWqs
  obtain ⟨K, hKperf, hKP, hKgen⟩ := exists_isPerfect_isZero_restrict_generator_of_isAffineSpace
    (V := edsEtale B S hS hsq) hV (edsSnd B S hS hsq)
    (by
      have := MorphismProperty.relative_isStableUnderBaseChange
        (P := MorphismProperty.inverseImage (@_root_.AlgebraicGeometry.IsOpenImmersion.{u})
          (BigFppfOver.toScheme B S hS)) (F := yoneda)
      exact MorphismProperty.pullback_snd (P := MorphismProperty.presheaf _) _ _
        hsq.isOpenSubspace.2) hPqc
  have hKs := cohomologySupportedOn_of_isZero_edsDerivedRestrictSnd B S hS hsq K hKP
  exact ⟨K, isPerfect_edsEtale_shriek_of_cohomologySupportedOn B S hS hsq K hKperf hKs,
    isZero_etaleModulePullback_mapDerivedCategory_of_range_subset B S hS
      (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq) _
      (cohomologySupportedOn_lowerShriek_of_cohomologySupportedOn B S hS hsq K hKs) le_rfl,
    hKgen⟩

/-- For `X` quasi-separated and `U` quasi-compact, the derived direct image along `U ⊆ X` of the
restriction to `U` of an object of `D_QCoh(𝒪_X)` lies in `D_QCoh(𝒪_X)`. -/
private theorem qcohDerivedProp_etaleDerivedPushforward_edsOpen (hZ : B.Contains (⊤_ Scheme.{u}))
    (hWqs : IsAbsolutelyQuasiSeparated B S hS hZ W.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor)
    {E : DerivedCategory (Modules.{u, u} B S hS W.1 W.2)} (hE : qcohDerivedProp B S hS W E) :
    qcohDerivedProp B S hS W ((etaleDerivedPushforward B S hS (edsOpenHom B S hS hsq)).obj
      ((edsDerivedRestrictOpen B S hS hsq).obj E)) := by
  have := hasRightDerivedFunctor_modulePushforward B S hS (edsOpenHom B S hS hsq)
  have hUqs : IsAbsolutelyQuasiSeparated B S hS hZ (edsOpen B S hS hsq).1 :=
    isAbsolutelyQuasiSeparated_of_isOpenSubspace B S hS hZ hWqs Uo hsq.isOpenSubspace
  have hEU : qcohDerivedProp B S hS (edsOpen B S hS hsq)
      ((edsDerivedRestrictOpen B S hS hsq).obj E) :=
    derivedQuasicoherent_etaleModulePullback B S hS _ _ E hE
  exact qcohDerivedProp_derivedPushforward_of_qcqs B S hS hZ hUqc hUqs hWqs
    (edsOpenHom B S hS hsq) (etaleDerivedPushforward B S hS (edsOpenHom B S hS hsq))
    (((modulePushforward B S hS (edsOpenHom B S hS hsq)).mapHomotopyCategory
      (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh).totalRightDerivedUnit DerivedCategory.Qh
        (HomotopyCategory.quasiIso _ (ComplexShape.up ℤ)))
    ((edsDerivedRestrictOpen B S hS hsq).obj E) hEU

/-- Let `(U ⊆ X, j : V ⟶ X)` be an elementary distinguished square of algebraic spaces with `X`
quasi-separated, `U` quasi-compact and `V` affine. Let `P` be a perfect generator of
`D_QCoh(𝒪_U)` — an object of `D_QCoh(𝒪_U)` receiving only zero maps from the shifts of `P` is
zero — and let `Q` be a perfect object of `D(𝒪_X)` of whose restriction to `U` the object `P` is a
retract. Then `D_QCoh(𝒪_X)` is generated by a single perfect object. -/
theorem exists_perfect_generator_of_eds_of_isRetract (hZ : B.Contains (⊤_ Scheme.{u}))
    (hWqs : IsAbsolutelyQuasiSeparated B S hS hZ W.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor) (hV : IsAffineSpace B S hS V)
    (P : DerivedCategory (Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2))
    (hP : ∀ E, qcohDerivedProp B S hS (edsOpen B S hS hsq) E →
      (∀ (n : ℤ) (g : P⟦n⟧ ⟶ E), g = 0) → IsZero E)
    (Q : DerivedCategory (Modules.{u, u} B S hS W.1 W.2))
    (hQ : (smallEtaleRingedSite B S hS W.1 W.2).IsPerfect Q)
    (s : P ⟶ (edsDerivedRestrictOpen B S hS hsq).obj Q)
    (r : (edsDerivedRestrictOpen B S hS hsq).obj Q ⟶ P) (hsr : s ≫ r = 𝟙 P) :
    ∃ G : DerivedCategory (Modules.{u, u} B S hS W.1 W.2),
      (smallEtaleRingedSite B S hS W.1 W.2).IsPerfect G ∧
      ∀ E, qcohDerivedProp B S hS W E → (∀ (n : ℤ) (g : G⟦n⟧ ⟶ E), g = 0) → IsZero E := by
  let rU := edsDerivedRestrictOpen B S hS hsq
  let rV := edsDerivedRestrictEtale B S hS hsq
  let adjU := etaleDerivedPushforwardAdjunction B S hS (edsOpenHom B S hS hsq)
    (isEtale_edsOpenHom B S hS hsq)
  have : IsIso adjU.counit :=
    isIso_counit_mapDerivedCategory_of_isOpenImmersion B S hS (edsOpenHom B S hS hsq)
      hsq.isOpenSubspace.2 adjU
  obtain ⟨K, hK', hUK, hKgen⟩ :=
    exists_isPerfect_lowerShriek_generator_of_eds B S hS hsq hZ hWqs hUqc hV
  let shV := (etaleModuleLowerShriek B S hS (edsEtaleHom B S hS hsq)
    (isEtale_edsEtaleHom B S hS hsq)).mapDerivedCategory
  let adjV : shV ⊣ rV := Adjunction.mapDerivedCategory (edsEtaleShriekAdjunction B S hS hsq)
  refine ⟨Q ⊞ shV.obj K, RingedSite.isPerfect_biprod (smallEtaleRingedSite B S hS W.1 W.2) _ _
    hQ hK', fun E hE hG => ?_⟩
  have hGQ := eq_zero_of_retract_of_forall_shift_hom_eq_zero _ _ biprod.inl_fst hG
  have hGK := eq_zero_of_retract_of_forall_shift_hom_eq_zero _ _ biprod.inr_snd hG
  obtain ⟨C, w, δ, hT⟩ := distinguished_cocone_triangle (adjU.unit.app E)
  have hη : IsIso (rU.map (adjU.unit.app E)) := isIso_map_unit_app_of_isIso_counit adjU E
  have hCU : IsZero (rU.obj C) := Triangle.isZero₃_of_isIso₁ _ (rU.map_distinguished _ hT) hη
  have hC : qcohDerivedProp B S hS W C :=
    (qcohDerivedProp B S hS W).ext_of_isTriangulatedClosed₃ _ hT hE
      (qcohDerivedProp_etaleDerivedPushforward_edsOpen B S hS hsq hZ hWqs hUqc hE)
  have hCP : IsZero ((etaleModulePullback.{u, u} B S hS (edsSnd B S hS hsq)
      (isEtale_edsSnd B S hS hsq)).mapDerivedCategory.obj (rV.obj C)) := by
    refine IsZero.of_iso ?_ ((edsDerivedRestrictCompEtale B S hS hsq).app C)
    exact ((edsRestrictFst B S hS hsq).mapDerivedCategory.map_isZero hCU).of_iso
      ((edsDerivedRestrictCompOpen B S hS hsq).app C).symm
  have hKC : ∀ (n : ℤ) (g : K⟦n⟧ ⟶ rV.obj C), g = 0 := fun n g => by
    have hz : IsZero (rU.obj (shV.obj (K⟦n⟧))) :=
      ((shiftFunctor _ n).map_isZero hUK).of_iso
        (rU.mapIso ((shV.commShiftIso n).app K) ≪≫ (rU.commShiftIso n).app _)
    have hĝ : (adjV.homEquiv _ _).symm g = 0 :=
      eq_zero_of_comp_mor₃_eq_zero hT _ (eq_zero_of_isZero_leftAdjoint_obj adjU hz) (by
        rw [← cancel_epi ((shV.commShiftIso n).inv.app K), comp_zero]
        exact eq_zero_of_forall_shift_hom_eq_zero hGK n 1 _)
    rw [← (adjV.homEquiv _ _).apply_symm_apply g, hĝ, Adjunction.homEquiv_unit, Functor.map_zero,
      comp_zero]
  have hCV : IsZero (rV.obj C) :=
    hKgen _ (derivedQuasicoherent_etaleModulePullback B S hS _ _ C hC) hCP hKC
  have : IsIso (adjU.unit.app E) := (Triangle.isZero₃_iff_isIso₁ _ hT).1
    (isZero_of_isZero_edsDerivedRestrict B S hS hsq C hCU hCV)
  exact isZero_of_isIso_unit_app_of_retract adjU s r hsr hGQ
    (hP _ (derivedQuasicoherent_etaleModulePullback B S hS _ _ E hE))

/-- **Glueing perfect objects on an elementary distinguished square.** Perfect objects `A` of
`D(𝒪_U)` and `Bo` of `D(𝒪_V)` with `A|_{U ×_X V} ≅ Bo|_{U ×_X V}` are the restrictions of a
perfect object of `D(𝒪_X)`. -/
theorem exists_isPerfect_glue_of_eds
    (A : DerivedCategory (Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2))
    (Bo : DerivedCategory (Modules.{u, u} B S hS (edsEtale B S hS hsq).1 (edsEtale B S hS hsq).2))
    (hA : (smallEtaleRingedSite B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2).IsPerfect A)
    (hB : (smallEtaleRingedSite B S hS (edsEtale B S hS hsq).1
      (edsEtale B S hS hsq).2).IsPerfect Bo)
    (c : (edsRestrictFst B S hS hsq).mapDerivedCategory.obj A ≅
      (edsRestrictSnd B S hS hsq).mapDerivedCategory.obj Bo) :
    ∃ F : DerivedCategory (Modules.{u, u} B S hS W.1 W.2),
      (smallEtaleRingedSite B S hS W.1 W.2).IsPerfect F ∧
      Nonempty ((edsDerivedRestrictOpen B S hS hsq).obj F ≅ A) ∧
      Nonempty ((edsDerivedRestrictEtale B S hS hsq).obj F ≅ Bo) := by
  obtain ⟨F, f, g, -⟩ := exists_glued_object B S hS hsq A Bo c
  exact ⟨F, isPerfect_of_isPerfect_eds B S hS hsq F
    (RingedSite.IsPerfect.of_iso (smallEtaleRingedSite B S hS (edsOpen B S hS hsq).1
      (edsOpen B S hS hsq).2) hA f.symm)
    (RingedSite.IsPerfect.of_iso (smallEtaleRingedSite B S hS (edsEtale B S hS hsq).1
      (edsEtale B S hS hsq).2) hB g.symm), ⟨f⟩, ⟨g⟩⟩

end Square

