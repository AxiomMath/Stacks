/-- **Support on `T` is stable under every shift.** -/
theorem cohomologySupportedOn_shift (Y : AlgebraicSpaces B S hS) (T : Set (points B S hS Y.1))
    (E : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2))
    (hE : CohomologySupportedOn B S hS Y.1 Y.2 T E) (a : ℤ) :
    CohomologySupportedOn B S hS Y.1 Y.2 T (E⟦a⟧) := fun i =>
  (supportOfSheaf_eq_of_iso B S hS Y
    (((DerivedCategory.homologyFunctor (Modules.{u, u} B S hS Y.1 Y.2) 0).shiftIso a i (a + i)
      rfl).app E)).le.trans (hE (a + i))

/-- **Quasi-coherent cohomology is stable under every shift.** -/
theorem derivedCategoryB_quasicoherent_shift (Y : AlgebraicSpaces B S hS)
    (E : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2))
    (hE : DerivedCategoryB.derivedCategoryB
      (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O))) E)
    (a : ℤ) :
    DerivedCategoryB.derivedCategoryB
      (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)))
      (E⟦a⟧) := by
  have := DerivedCategoryB.derivedCategoryB_isTriangulated _
    (isWeakSerre_quasicoherentSheaves_smallEtaleRingedSite B S hS Y.1 Y.2)
  exact ObjectProperty.le_shift _ a E hE

/-- **The extension by zero of an object supported over a closed `T` is supported on `T`.** For
étale `j : U ⟶ X`, a closed `T ⊆ |X|` and `K` on `U` supported on `j⁻¹(T)`, the restriction of
`j_!K` to `X ∖ T` is the extension by zero of the restriction of `K` (Stacks 08HA), which vanishes;
so `j_!K` is supported on `T`. -/
theorem cohomologySupportedOn_lowerShriek_of_preimage {X U : AlgebraicSpaces B S hS} (j : U ⟶ X)
    (hj : IsEtale B S hS j.hom) (T : Set (points B S hS X.1)) (hT : IsClosed T)
    (K : DerivedCategory (Modules.{u, u} B S hS U.1 U.2))
    (hK : CohomologySupportedOn B S hS U.1 U.2 (pointsMap B S hS U.1 j.hom ⁻¹' T) K) :
    CohomologySupportedOn B S hS X.1 X.2 T
      ((etaleModuleLowerShriek B S hS j hj).mapDerivedCategory.obj K) := by
  let G := (openSubspacesOrderIso B S hS X.1 X.2).symm ⟨Tᶜ, hT.isOpen_compl⟩
  let Vs := openSubspaceSpace B S hS G.1 G.2
  let jV := openSubspaceHom B S hS G.1 G.2
  have hjV : IsEtale B S hS jV.hom := isEtale_openSubspaceHom B S hS G.1 G.2
  let Wp := AlgebraicSpaces.fiberProduct B S hS jV j
  have sq := AlgebraicSpaces.isPullback_fiberProduct B S hS jV j
  let jW : Wp ⟶ Vs := ObjectProperty.homMk (pullback.fst jV.hom j.hom)
  let p : Wp ⟶ U := ObjectProperty.homMk (pullback.snd jV.hom j.hom)
  have hjW : IsEtale B S hS jW.hom := isEtale_of_isPullback B S hS p jW j jV sq.flip hj
  have hp : IsEtale B S hS p.hom := isEtale_of_isPullback B S hS jW p jV j sq hjV
  have hbc := isIso_derivedRestrictExtensionByZeroMap B S hS sq hj hjV
    (etaleModuleLowerShriekAdjunction B S hS j hj)
    (etaleModuleLowerShriekAdjunction B S hS jW hjW)
  have hp0 : IsZero ((etaleModulePullback.{u, u} B S hS p hp).mapDerivedCategory.obj K) := by
    refine isZero_etaleModulePullback_mapDerivedCategory_of_disjoint B S hS p hp _ K hK
      (Set.disjoint_left.mpr ?_)
    rintro _ ⟨w, rfl⟩ hw
    have hc : pointsMap B S hS U.1 j.hom (pointsMap B S hS Wp.1 p.hom w) =
        pointsMap B S hS Vs.1 jV.hom (pointsMap B S hS Wp.1 jW.hom w) := by
      rw [← pointsMap_comp_apply, ← pointsMap_comp_apply]
      exact congrArg (fun φ => pointsMap B S hS Wp.1 φ w)
        (congrArg (fun ψ => ψ.hom) sq.w).symm
    have hmem : pointsMap B S hS Vs.1 jV.hom (pointsMap B S hS Wp.1 jW.hom w) ∈ Tᶜ := by
      rw [← range_openSubspacesOrderIso_symm B S hS X.1 X.2 T hT]
      exact ⟨_, rfl⟩
    exact hmem (hc ▸ hw)
  have hzero : IsZero ((etaleModulePullback.{u, u} B S hS jV hjV).mapDerivedCategory.obj
      ((etaleModuleLowerShriek B S hS j hj).mapDerivedCategory.obj K)) :=
    ((etaleModuleLowerShriek B S hS jW hjW).mapDerivedCategory.map_isZero hp0).of_iso
      ((asIso (derivedRestrictExtensionByZeroMap B S hS sq hj hjV
        (etaleModuleLowerShriekAdjunction B S hS j hj)
        (etaleModuleLowerShriekAdjunction B S hS jW hjW))).app K).symm
  have h := cohomologySupportedOn_compl_range_of_isZero_etaleModulePullback B S hS jV hjV _ hzero
  have hrange : Set.range (pointsMap B S hS Vs.1 jV.hom) = Tᶜ :=
    range_openSubspacesOrderIso_symm B S hS X.1 X.2 T hT
  rwa [hrange, compl_compl] at h

/-! ### The inductive step -/

section Step

variable {W : AlgebraicSpaces B S hS} {Ve : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
  {Uo : Subfunctor W.1} {fV : Ve ⟶ W.1}
  (hsq : IsElementaryDistinguishedSquare B S hS W.2 Uo fV)

/-- **The extension by zero of an object supported over `T`, and the objects orthogonal to it.**
For étale `j : V ⟶ W`, closed `T ⊆ |W|` and `K` on `V` supported on `j⁻¹(T)`, the extension by zero
`K' = j_!K` is supported on `T`, and for every `E` in `D_QCoh(𝒪_W)` supported on `T` with
`Hom(K', E[m]) = 0` for all `m`, the restriction `E|_V` has quasi-coherent cohomology, is supported
on `j⁻¹(T)`, and `Hom(K[n], E|_V) = 0` for all `n`. -/
theorem exists_lowerShriek_orthogonal {V W : AlgebraicSpaces B S hS} (j : V ⟶ W)
    (hj : IsEtale B S hS j.hom) (T : Set (points B S hS W.1)) (hT : IsClosed T)
    (K : DerivedCategory (Modules.{u, u} B S hS V.1 V.2))
    (hKs : CohomologySupportedOn B S hS V.1 V.2 (pointsMap B S hS V.1 j.hom ⁻¹' T) K) :
    ∃ K' : DerivedCategory (Modules.{u, u} B S hS W.1 W.2),
      K' = (etaleModuleLowerShriek B S hS j hj).mapDerivedCategory.obj K ∧
      CohomologySupportedOn B S hS W.1 W.2 T K' ∧
      ∀ E : DerivedCategory (Modules.{u, u} B S hS W.1 W.2),
        DerivedCategoryB.derivedCategoryB
          (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
            ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS W.1 W.2).O))) E →
        CohomologySupportedOn B S hS W.1 W.2 T E →
        (∀ (m : ℤ) (g : K' ⟶ E⟦m⟧), g = 0) →
        DerivedCategoryB.derivedCategoryB
          (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
            ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS V.1 V.2).O)))
            ((etaleModulePullback.{u, u} B S hS j hj).mapDerivedCategory.obj E) ∧
        CohomologySupportedOn B S hS V.1 V.2 (pointsMap B S hS V.1 j.hom ⁻¹' T)
          ((etaleModulePullback.{u, u} B S hS j hj).mapDerivedCategory.obj E) ∧
        ∀ (n : ℤ) (g : K⟦n⟧ ⟶ (etaleModulePullback.{u, u} B S hS j hj).mapDerivedCategory.obj E),
          g = 0 := by
  refine ⟨_, rfl, cohomologySupportedOn_lowerShriek_of_preimage B S hS j hj T hT K hKs,
    fun E hEq hEs hEK => ⟨derivedQuasicoherent_etaleModulePullback B S hS j hj E hEq,
      cohomologySupportedOn_etaleModulePullback B S hS j hj T E hEs, ?_⟩⟩
  let RV := (etaleModulePullback.{u, u} B S hS j hj).mapDerivedCategory
  let adjf := (etaleModuleLowerShriekAdjunction B S hS j hj).mapDerivedCategory
  have hKV : ∀ (m : ℤ) (g : K ⟶ RV.obj (E⟦m⟧)), g = 0 := fun m g => by
    rw [← (adjf.homEquiv _ _).apply_symm_apply g, hEK m ((adjf.homEquiv _ _).symm g),
      Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]
  suffices H : ∀ (k : ℤ) (g : K ⟶ (RV.obj E)⟦k⟧), g = 0 from
    (CategoryTheory.forall_hom_shift_eq_zero_iff K (RV.obj E)).2 H
  intro k g
  rw [← cancel_mono ((RV.commShiftIso k).inv.app E), zero_comp]
  exact hKV k _

/-- **The inductive step of Stacks 0AEC.** Let `(U ⊆ W, f : V ⟶ W)` be an elementary distinguished
square of algebraic spaces with `W` quasi-compact and quasi-separated, `U` quasi-compact and `V`
affine, and let `T ⊆ |W|` be closed with `W ∖ T ⟶ W` quasi-compact. If `D_{QCoh,T∩U}(𝒪_U)` is
generated by a single perfect object, so is `D_{QCoh,T}(𝒪_W)`. -/
theorem exists_isSupportedPerfectGenerator_of_eds
    (hWqc : IsQuasiCompactSpace B S hS W.1)
    (hWqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal W.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor) (hVaff : IsAffineSpace B S hS Ve)
    (T : Set (points B S hS W.1)) (hT : IsClosed T)
    (hTqc : IsQuasiCompact B S hS
      ((openSubspacesOrderIso B S hS W.1 W.2).symm ⟨Tᶜ, hT.isOpen_compl⟩).1.ι)
    (P : DerivedCategory (Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2))
    (hP : IsSupportedPerfectGenerator B S hS (edsOpen B S hS hsq)
      (pointsMap B S hS Uo.toFunctor Uo.ι ⁻¹' T) P) :
    ∃ R, IsSupportedPerfectGenerator B S hS W T R := by
  have hZ := B.contains_terminal
  obtain ⟨hPp, hPs, hPdet⟩ := hP
  let E0 : QuasicoherentDerivedCategory.{u, u} B S hS W.1 W.2 :=
    ⟨0, fun n => DerivedCategoryB.zero_mem_of_isWeakSerre _
      (isWeakSerre_quasicoherentSheaves_smallEtaleRingedSite B S hS W.1 W.2) _
      ((DerivedCategory.homologyFunctor _ n).map_isZero (isZero_zero _))⟩
  obtain ⟨Q, -, hQ, hQs, s₀, r₀, hsr₀, -⟩ :=
    exists_isPerfect_retract_restrict_of_supported hZ W hWqc
    hWqs Uo hsq.isOpenSubspace hUqc T hT hTqc E0 P hPp hPs
    (((etaleModulePullback.{u, u} B S hS (openSubspaceHom B S hS Uo hsq.isOpenSubspace)
      (isEtale_openSubspaceHom B S hS Uo hsq.isOpenSubspace)).mapDerivedCategory.map_isZero
        (isZero_zero _)).from_ P)
  let RU := (edsRestrictOpen B S hS hsq).mapDerivedCategory
  let s : P ⟶ RU.obj Q := s₀
  let r : RU.obj Q ⟶ P := r₀
  have hsr : s ≫ r = 𝟙 P := hsr₀
  have hUVqc : IsQuasiCompactSpace B S hS (edsInter B S hS hsq).1 :=
    isQuasiCompactSpace_pullback B S hS hZ Uo.ι fV hsq.isOpenSubspace.1 W.2 hUqc
      (IsAffineSpace.isQuasiCompactSpace hVaff) hWqs
  obtain ⟨K, hK, hKs, hbij⟩ := restrictBijectiveAgainst_edsSnd B S hS hsq hVaff hUVqc T hT hTqc
  obtain ⟨K', hK'def, hK's, hK'orth⟩ := exists_lowerShriek_orthogonal B S hS
    (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq) T hT K
    (hKs.mono B S hS _ _ Set.inter_subset_left)
  have hK' : (smallEtaleRingedSite B S hS W.1 W.2).IsPerfect K' := by
    rw [hK'def]
    exact isPerfect_lowerShriek_of_cohomologySupportedOn B S hS hsq K hK
      (hKs.mono B S hS _ _ Set.inter_subset_right)
  refine ⟨Q ⊞ K', RingedSite.isPerfect_obj₂_of_distinguished_general _
      (binaryBiproductTriangle Q K') (binaryBiproductTriangle_distinguished _ _) hQ hK',
    cohomologySupportedOn_obj₂_of_distinguished B S hS W.1 W.2 T (binaryBiproductTriangle Q K')
      (binaryBiproductTriangle_distinguished _ _) hQs hK's, ?_⟩
  intro E hEq hEs hE
  have hE2 := (CategoryTheory.forall_hom_shift_eq_zero_iff _ E).1 hE
  have hsplit : ∀ {A : _} (i : A ⟶ Q ⊞ K') (p : Q ⊞ K' ⟶ A), i ≫ p = 𝟙 A →
      ∀ (m : ℤ) (g : A ⟶ E⟦m⟧), g = 0 := fun i p hip m g => by
    rw [← Category.id_comp g, ← hip, Category.assoc, hE2 m (p ≫ g), comp_zero]
  have hQE := hsplit biprod.inl biprod.fst biprod.inl_fst
  have hK'E := hsplit biprod.inr biprod.snd biprod.inr_snd
  -- the hypotheses of the restriction statement on `V`, at every shift of `E`
  have hEm : ∀ m : ℤ, ∀ (k : ℤ) (g : K' ⟶ (E⟦m⟧)⟦k⟧), g = 0 := fun m k g => by
    rw [← cancel_mono ((shiftFunctorAdd' _ m k (m + k) rfl).inv.app E), zero_comp]
    exact hK'E (m + k) _
  let RV := (edsRestrictEtale B S hS hsq).mapDerivedCategory
  let RFst := (edsRestrictFst B S hS hsq).mapDerivedCategory
  let RSnd := (edsRestrictSnd B S hS hsq).mapDerivedCategory
  let cO := edsDerivedRestrictCompOpen B S hS hsq
  let cE := edsDerivedRestrictCompEtale B S hS hsq
  have hQq : DerivedCategoryB.derivedCategoryB
      (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS W.1 W.2).O))) Q :=
    derivedCategoryB_of_isPseudoCoherent_unconditional B S hS W.1 W.2 Q
      (RingedSite.isPseudoCoherent_of_isPerfect_general (X := smallEtaleRingedSite B S hS W.1 W.2)
        (E := Q) hQ)
  -- `E|_U = 0`
  have hU0 : IsZero (RU.obj E) := by
    refine hPdet (RU.obj E) (derivedQuasicoherent_etaleModulePullback B S hS
      (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq) E hEq)
      (cohomologySupportedOn_etaleModulePullback B S hS (edsOpenHom B S hS hsq)
        (isEtale_edsOpenHom B S hS hsq) T E hEs) ?_
    rw [CategoryTheory.forall_hom_shift_eq_zero_iff]
    intro m c
    let E' := E⟦m⟧
    obtain ⟨hGq, hGs, hGK⟩ := hK'orth E'
      (derivedCategoryB_quasicoherent_shift B S hS W E hEq m)
      (cohomologySupportedOn_shift B S hS W T E hEs m) (hEm m)
    let a : RU.obj Q ⟶ RU.obj E' := r ≫ c ≫ (RU.commShiftIso m).inv.app E
    let y : RSnd.obj (RV.obj Q) ⟶ RSnd.obj (RV.obj E') :=
      cE.hom.app Q ≫ cO.inv.app Q ≫ RFst.map a ≫ cO.hom.app E' ≫ cE.inv.app E'
    obtain ⟨b, hb⟩ := (hbij (RV.obj E') hGq hGs hGK (RV.obj Q)
      (derivedQuasicoherent_etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
        (isEtale_edsEtaleHom B S hS hsq) Q hQq)).2 y
    obtain ⟨φ, hφU, -⟩ := exists_hom_of_glueData_of_isElementaryDistinguishedSquare B S hS hsq
      (etaleModuleLowerShriekAdjunction B S hS (edsOpenHom B S hS hsq)
        (isEtale_edsOpenHom B S hS hsq))
      (etaleModuleLowerShriekAdjunction B S hS (edsEtaleHom B S hS hsq)
        (isEtale_edsEtaleHom B S hS hsq))
      (etaleModuleLowerShriekAdjunction B S hS (edsInterHom B S hS hsq)
        (isEtale_edsInterHom B S hS hsq))
      Q E' (Iso.refl _) (Iso.refl _) (cO.app Q ≪≫ cE.symm.app Q) (by simp [cO, cE]) a b (by
        have hb' : RSnd.map b = y := hb
        change RFst.map a ≫ cO.hom.app E' =
          (cO.hom.app Q ≫ cE.inv.app Q) ≫ RSnd.map b ≫ cE.hom.app E'
        rw [hb']
        simp [y])
    have ha : a = 0 := by
      rw [← show RU.map φ = a by simpa using hφU, hQE m φ, Functor.map_zero]
    have hrc : r ≫ c = 0 := by
      calc r ≫ c = a ≫ (RU.commShiftIso m).hom.app E := by
            simp only [a, Category.assoc, Iso.inv_hom_id_app]
            exact congrArg (r ≫ ·) (Category.comp_id c).symm
        _ = 0 := by rw [ha, zero_comp]
    calc c = (s ≫ r) ≫ c := by rw [hsr, Category.id_comp]
      _ = 0 := by rw [Category.assoc, hrc, comp_zero]
  -- `E|_{U ×_W V} = 0`
  have hP0 : IsZero ((edsRestrictInter B S hS hsq).mapDerivedCategory.obj E) :=
    (RFst.map_isZero hU0).of_iso (cO.app E).symm
  -- `E|_V = 0`
  have hV0 : IsZero (RV.obj E) := by
    obtain ⟨hGq, hGs, hGK⟩ := hK'orth E hEq hEs hK'E
    have hinj := (hbij (RV.obj E) hGq hGs hGK (RV.obj E) hGq).1
    have hz : IsZero (RSnd.obj (RV.obj E)) := hP0.of_iso (cE.app E)
    rw [IsZero.iff_id_eq_zero]
    exact hinj (hz.eq_of_src _ _)
  rw [IsZero.iff_id_eq_zero]
  exact (bijective_map_edsEtale_of_isZero_target B S hS hsq E E hU0 hP0).1 (hV0.eq_of_src _ _)

end Step

/-! ### The induction, and Stacks 0AEC -/

attribute [-instance] CategoryTheory.Limits.Types.instHasPushoutsType in
/-- **`D_{QCoh,T}(𝒪_X)` is generated by a single perfect object**, in the form of
`AlgebraicGeometry.Space.IsSupportedPerfectGenerator`, for `X` quasi-compact and quasi-separated
and `T ⊆ |X|` closed with `X ∖ T ⟶ X` quasi-compact. The induction principle of Stacks 08GP, with
the affine case `AlgebraicGeometry.Space.exists_isSupportedPerfectGenerator_of_isAffineSpace` and
the step `AlgebraicGeometry.Space.exists_isSupportedPerfectGenerator_of_eds`. -/
theorem exists_isSupportedPerfectGenerator (X : AlgebraicSpaces B S hS)
    (hXqc : IsQuasiCompactSpace B S hS X.1)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.1)
    (T : Set (points B S hS X.1)) (hT : IsClosed T)
    (hTqc : IsQuasiCompact B S hS
      ((openSubspacesOrderIso B S hS X.1 X.2).symm ⟨Tᶜ, hT.isOpen_compl⟩).1.ι) :
    ∃ P, IsSupportedPerfectGenerator B S hS X T P := by
  have h := qcqs_induction_on_self B S hS B.contains_terminal X hXqc hXqs
    (fun Y g => ∀ hY : IsAlgebraicSpace B S hS Y,
      ∃ P, IsSupportedPerfectGenerator B S hS ⟨Y, hY⟩ (pointsMap B S hS Y g ⁻¹' T) P)
    (fun V hV hY => exists_isSupportedPerfectGenerator_of_isAffineSpace B S hS
      (X := X) (V := ⟨V.1.left.1, hY⟩) (ObjectProperty.homMk V.1.hom.hom) hV T hT hTqc)
    (fun W V U f _ hsq hWqc hWqs hUqc hVaff hPU _ _ hY => by
      let g := W.1.hom.hom
      have hTW : IsClosed (pointsMap B S hS W.1.left.1 g ⁻¹' T) :=
        hT.preimage (continuous_pointsMap B S hS _)
      have hTWqc := isQuasiCompact_openSubspacesOrderIso_symm_preimage B S hS X.2 hY g T hT hTqc
        hTW
      obtain ⟨P, hP⟩ := hPU hsq.isOpenSubspace.1
      have hset : pointsMap B S hS U.toFunctor (U.ι ≫ g) ⁻¹' T =
          pointsMap B S hS U.toFunctor U.ι ⁻¹' (pointsMap B S hS W.1.left.1 g ⁻¹' T) := by
        rw [pointsMap_comp, Set.preimage_comp]
      rw [hset] at hP
      exact exists_isSupportedPerfectGenerator_of_eds B S hS hsq hWqc hWqs hUqc hVaff _ hTW hTWqc
        P hP)
  obtain ⟨P, hP⟩ := h X.2
  exact ⟨P, by rwa [pointsMap_id, Set.preimage_id] at hP⟩

/-- **Stacks 0AEC.** Let `S` be a scheme, `X` a quasi-compact and quasi-separated algebraic space
over `S`, and `T ⊆ |X|` a closed subset such that `|X| ∖ T` is quasi-compact. Then
`D_{QCoh,T}(𝒪_X)` is generated by a single perfect object: there is a perfect object `P` of
`D(𝒪_X)` with quasi-coherent cohomology supported on `T` (an object of `D_{QCoh,T}(𝒪_X)`) such that
an object `E` of `D_QCoh(𝒪_X)` supported on `T` is zero if and only if `Hom(P[n], E) = 0` for all
`n ∈ ℤ`.

`D_{QCoh,T}(𝒪_X)` is the full subcategory of `D_QCoh(𝒪_X)` of the objects whose cohomology
sheaves are supported on `T` (`AlgebraicGeometry.Space.CohomologySupportedOn`, Stacks 08GF);
`|X| ∖ T` carries the topology of `|X|`. -/
@[stacks 0AEC]
theorem exists_isPerfect_generator_of_supported (X : AlgebraicSpaces B S hS)
    (hXqc : IsQuasiCompactSpace B S hS X.1)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.1)
    (T : Set (points B S hS X.1)) (hT : IsClosed T) (hTc : IsCompact Tᶜ) :
    ∃ P : DerivedCategory (Modules.{u, u} B S hS X.1 X.2),
      (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect P ∧
      DerivedCategoryB.derivedCategoryB
        (SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O))) P ∧
      CohomologySupportedOn B S hS X.1 X.2 T P ∧
      ∀ E : QuasicoherentDerivedCategory.{u, u} B S hS X.1 X.2,
        CohomologySupportedOn B S hS X.1 X.2 T E.obj →
          (IsZero E.obj ↔ ∀ (n : ℤ) (g : P⟦n⟧ ⟶ E.obj), g = 0) := by
  let G := (openSubspacesOrderIso B S hS X.1 X.2).symm ⟨Tᶜ, hT.isOpen_compl⟩
  have hGqc : IsQuasiCompactSpace B S hS G.1.toFunctor :=
    isQuasiCompactSpace_of_isCompact_range B S hS X.2 G.2 (by
      rw [range_openSubspacesOrderIso_symm B S hS X.1 X.2 T hT]
      exact hTc)
  have hTqc : IsQuasiCompact B S hS G.1.ι :=
    isQuasiCompact_of_isQuasiCompactSpace B S hS B.contains_terminal X.2 hXqs hGqc G.1.ι
  obtain ⟨P, hP, hPs, hdet⟩ := exists_isSupportedPerfectGenerator B S hS X hXqc hXqs T hT hTqc
  exact ⟨P, hP, derivedCategoryB_of_isPseudoCoherent_unconditional B S hS X.1 X.2 P
      (RingedSite.isPseudoCoherent_of_isPerfect_general (X := smallEtaleRingedSite B S hS X.1 X.2)
        (E := P) hP),
    hPs, fun E hEs => ⟨fun hE n g => hE.eq_of_tgt _ _, hdet E.obj E.property hEs⟩⟩

end AlgebraicGeometry.Space

end
