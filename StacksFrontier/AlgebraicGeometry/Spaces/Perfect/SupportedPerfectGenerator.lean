namespace CategoryTheory

variable {C : Type*} [Category C] [Preadditive C] [HasShift C ℤ]

/-- **Vanishing of all maps out of the shifts of `P` is vanishing of all maps into the shifts of
`E`.** -/
theorem forall_hom_shift_eq_zero_iff (P E : C) :
    (∀ (n : ℤ) (g : P⟦n⟧ ⟶ E), g = 0) ↔ ∀ (n : ℤ) (g : P ⟶ E⟦n⟧), g = 0 := by
  constructor
  · intro h n g
    apply (shiftFunctor C (-n)).map_injective
    rw [Functor.map_zero, ← cancel_mono ((shiftFunctorCompIsoId C n (-n)
      (add_neg_cancel n)).hom.app E), zero_comp]
    exact h (-n) _
  · intro h n g
    apply (shiftFunctor C (-n)).map_injective
    rw [Functor.map_zero, ← cancel_epi ((shiftFunctorCompIsoId C n (-n)
      (add_neg_cancel n)).inv.app P), comp_zero]
    exact h (-n) _

end CategoryTheory

namespace AlgebraicGeometry.Space

