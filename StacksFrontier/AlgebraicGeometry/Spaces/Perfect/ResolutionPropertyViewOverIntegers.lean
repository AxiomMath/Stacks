/-!
# The resolution property and the situation of Stacks 0GUY viewed over `Spec ℤ`

Let `X` be an algebraic space over a scheme `S` of a big fppf site `B`, and let
`X' = AlgebraicGeometry.Space.viewOverIntegers B S hS hZ X` be `X` viewed as an algebraic space
over `Spec ℤ`, the terminal scheme (Stacks 03I5 (2), 03BS).  The proof of the reverse implication
of Stacks 0GV1 begins with "we may view `X` as an algebraic space over `Spec ℤ`": the Noetherian
approximation of Stacks 07SU takes place over `Spec ℤ`, so the resolution property and the data
of the situation of Stacks 0GUY have to be read over that base.  This file proves that the change
of base changes nothing that the argument uses; the resolution property itself transfers by
`AlgebraicGeometry.Space.hasResolutionProperty_viewOverIntegers_iff`.

## Main results

* `ResolutionPropertyDescentSituation.exists_viewOverIntegers_of_exists_epi_idealDirectImage`
  (in `AlgebraicGeometry.Space`): a situation of Stacks 0GUY for `X` whose `π_*ℐ` is a quotient
  of a finite locally free module gives one for `X'` with the same property.

## Implementation notes

The small étale sites of `X` and `X'` are equivalent by a pair of explicit functors which leave
the underlying schemes of the charts unchanged on the nose, objects and morphisms: a chart
`a : h_U ⟶ X` goes to its lower-shriek extension, and a chart of `X'`, which is a section of
`X'`, that is a factorization through `S` together with a section of `X`, goes to that section.
Both small étale topologies are generated by the families whose underlying schemes form an étale
covering, so both functors are cover preserving and the two structure sheaves are each other's
restriction **by definition**.  Modules are then compared by
`Stacks.SheafOfModules.reindexEquivalence` with no change of rings, and quasi-coherence, finite
type and finite local freeness are transported by the reindexing lemmas of Stacks 03DM.
`AlgebraicGeometry.Space.SmallEtale.relocalizeEquivalence` is the same equivalence for an
arbitrary change of base, but its inverse is built by choice and identifies morphisms of
schemes only propositionally, so the structure sheaf of `X'` is not by definition a restriction
of that of `X` along it; the explicit inverse is kept private here for that reason.

The situation is carried over by extending every chart and every morphism along the change of
base.  The sheaf of ideals `ℐ` of `Y` goes to the sheaf of ideals of `Y'` whose sections over a
chart are the sections of `ℐ` over the corresponding chart of `Y`; its associated module is the
reindexing of that of `ℐ`.  Points are compared by `AlgebraicGeometry.Space.pointsRelocalize`,
which is a bijection, and the zero locus of the new ideal is the image of the old one.  The
direct image `π'_*ℐ'` is the reindexing of `π_*ℐ`, because the two base changes of charts along
`π` and `π'` are fibre products of the same square of schemes.

## References

* [Stacks Project, Tag 03I5](https://stacks.math.columbia.edu/tag/03I5)
* [Stacks Project, Tag 03BS](https://stacks.math.columbia.edu/tag/03BS)
* [Stacks Project, Tag 0GUY](https://stacks.math.columbia.edu/tag/0GUY)
* [Stacks Project, Tag 0GV1](https://stacks.math.columbia.edu/tag/0GV1)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

/-! ### The small étale sites of `X` and of its view over `Spec ℤ` -/

section Sites

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u})) (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-- The functor of the reversed equivalence is continuous. -/
private instance isContinuous_etaleIntegersEquiv_symm_functor :
    (smallEtaleIntegersEquivalence B S hS hZ X).symm.functor.IsContinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) :=
  isContinuous_smallEtaleFromIntegers B S hS hZ X

/-- The inverse of the reversed equivalence is continuous. -/
private instance isContinuous_etaleIntegersEquiv_symm_inverse :
    (smallEtaleIntegersEquivalence B S hS hZ X).symm.inverse.IsContinuous
      (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  isContinuous_smallEtaleToIntegers B S hS hZ X

/-- The functor of the reversed equivalence is a dense subsite inclusion. -/
private instance isDenseSubsite_etaleIntegersEquiv_symm_functor :
    (smallEtaleIntegersEquivalence B S hS hZ X).symm.functor.IsDenseSubsite
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X))
      (SmallEtale.topology B S hS X) :=
  isDenseSubsite_smallEtaleIntegersEquivalence_inverse B S hS hZ X

/-- The inverse of the reversed equivalence is a dense subsite inclusion. -/
private instance isDenseSubsite_etaleIntegersEquiv_symm_inverse :
    (smallEtaleIntegersEquivalence B S hS hZ X).symm.inverse.IsDenseSubsite
      (SmallEtale.topology B S hS X)
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X)) :=
  isDenseSubsite_smallEtaleIntegersEquivalence_functor B S hS hZ X

end Sites

/-! ### Morphisms and points along the change of base -/

section Morphisms

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})}

/-- The image of the points of a chart, extended to `Spec ℤ`, is the image of the points of the
chart, read over `Spec ℤ`. -/
private theorem range_pointsMap_relocalizeChart {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U : BigFppfOver B S hS} (a : yoneda.obj U ⟶ F) :
    Set.range (pointsMap B (⊤_ Scheme.{u}) hZ _
        (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a)) =
      pointsRelocalize B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) F ''
        Set.range (pointsMap B S hS _ a) := by
  let Λ := OverShriek.relocalizePresheafFunctor (integersMap B S hS hZ)
  let ρ := relocalizedYonedaIso B (B.obj hS) (B.obj hZ) (integersMap B S hS hZ) U
  have h1 : pointsMap B (⊤_ Scheme.{u}) hZ _
      (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a) =
        pointsMap B (⊤_ Scheme.{u}) hZ _ (Λ.map a) ∘
          pointsMap B (⊤_ Scheme.{u}) hZ _ ρ.inv :=
    pointsMap_comp B (⊤_ Scheme.{u}) hZ _ ρ.inv (Λ.map a)
  have h2 : pointsMap B (⊤_ Scheme.{u}) hZ _ (Λ.map a) ∘
      pointsRelocalize B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) (yoneda.obj U) =
        pointsRelocalize B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) F ∘
          pointsMap B S hS _ a :=
    funext fun x =>
      (pointsRelocalize_naturality B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a x).symm
  rw [h1, (pointsMap_surjective_of_isIso B (⊤_ Scheme.{u}) hZ ρ.inv).range_comp,
    ← (pointsRelocalize_surjective B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
      (yoneda.obj U)).range_comp, h2, Set.range_comp]

/-- A surjective chart stays surjective when extended to `Spec ℤ`. -/
private theorem isSurjective_relocalizeChart {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U : BigFppfOver B S hS} (a : yoneda.obj U ⟶ F) (ha : IsSurjective B S hS a) :
    IsSurjective B (⊤_ Scheme.{u}) hZ
      (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a) := by
  rw [IsSurjective, ← Set.range_eq_univ, range_pointsMap_relocalizeChart,
    Set.range_eq_univ.2 ha, Set.image_univ, Set.range_eq_univ]
  exact pointsRelocalize_surjective B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) F

/-- An étale chart stays étale when extended to `Spec ℤ`. -/
private theorem isEtale_relocalizeChart {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U : BigFppfOver B S hS} (a : yoneda.obj U ⟶ F) (ha : IsEtale B S hS a) :
    IsEtale B (⊤_ Scheme.{u}) hZ
      (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a) := by
  have _ : MorphismProperty.RespectsIso (@AlgebraicGeometry.Etale.{u}) :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  rw [isEtale_iff_presheaf_of_yoneda]
  exact (presheaf_relocalizeChart_iff B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) _ a).2
    ((isEtale_iff_presheaf_of_yoneda B S hS a).1 ha)

/-- An open immersion from a representable stays one when extended to `Spec ℤ`. -/
private theorem isOpenImmersion_relocalizeChart {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U : BigFppfOver B S hS} (a : yoneda.obj U ⟶ F) (ha : IsOpenImmersion B S hS a) :
    IsOpenImmersion B (⊤_ Scheme.{u}) hZ
      (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a) :=
  (presheaf_relocalizeChart_iff B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) _ a).2 ha

/-- The inverse of the comparison `AlgebraicGeometry.relocalizeBaseHom`: it is the identity on
the underlying scheme. -/
private noncomputable def relocalizeBaseInv {U' : BigFppfOver B (⊤_ Scheme.{u}) hZ}
    {ψ : U'.left ⟶ B.obj hS}
    (hψ : ψ ≫ integersMap B S hS hZ = U'.hom) :
    (Over.map (integersMap B S hS hZ)).obj (Over.mk ψ) ⟶ U' :=
  Over.homMk (𝟙 U'.left) ((Category.id_comp _).trans hψ.symm)

/-- The comparison `AlgebraicGeometry.relocalizeBaseHom`, as an isomorphism. -/
private noncomputable def relocalizeBaseIso {U' : BigFppfOver B (⊤_ Scheme.{u}) hZ}
    {ψ : U'.left ⟶ B.obj hS}
    (hψ : ψ ≫ integersMap B S hS hZ = U'.hom) :
    (Over.map (integersMap B S hS hZ)).obj (Over.mk ψ) ≅ U' where
  hom := relocalizeBaseInv hψ
  inv := relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) hψ
  hom_inv_id := Over.OverMorphism.ext (Category.comp_id _)
  inv_hom_id := Over.OverMorphism.ext (Category.comp_id _)

/-- **A representable base change of a chart, extended to `Spec ℤ`, is a representable base
change of the extended chart**, read through the comparison
`AlgebraicGeometry.relocalizeBaseHom`, which is the identity on the underlying scheme. -/
private theorem isPullback_relocalizeChart_baseHom {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {f : F ⟶ G} {U' : BigFppfOver B (⊤_ Scheme.{u}) hZ} {ψ : U'.left ⟶ B.obj hS}
    (hψ : ψ ≫ integersMap B S hS hZ = U'.hom) {a : yoneda.obj (Over.mk ψ) ⟶ G}
    {V : BigFppfOver B S hS} {p : V ⟶ Over.mk ψ} {i : yoneda.obj V ⟶ F}
    (hpb : IsPullback i (yoneda.map p) f a) :
    IsPullback (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) i)
      (yoneda.map ((Over.map (integersMap B S hS hZ)).map p ≫ relocalizeBaseInv hψ))
      ((OverShriek.relocalizePresheafFunctor (integersMap B S hS hZ)).map f)
      (yoneda.map (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) hψ) ≫
        relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) a) := by
  let h := integersMap B S hS hZ
  let Λ := OverShriek.relocalizePresheafFunctor h
  have _ : PreservesLimitsOfShape WalkingCospan Λ := relocalizePresheaf_preservesConnectedLimits h
  let ρU := relocalizedYonedaIso B (B.obj hS) (B.obj hZ) h (Over.mk ψ)
  let ρV := relocalizedYonedaIso B (B.obj hS) (B.obj hZ) h V
  refine (hpb.map Λ).of_iso ρV (Iso.refl _) (ρU ≪≫ yoneda.mapIso (relocalizeBaseIso hψ))
    (Iso.refl _) ?_ ?_ ?_ ?_
  · change Λ.map i = ρV.hom ≫ ρV.inv ≫ Λ.map i
    rw [Iso.hom_inv_id_assoc]
  · change Λ.map (yoneda.map p) ≫ ρU.hom ≫ yoneda.map (relocalizeBaseInv hψ) =
      ρV.hom ≫ yoneda.map ((Over.map h).map p ≫ relocalizeBaseInv hψ)
    rw [Functor.map_comp, ← Category.assoc, ← Category.assoc]
    exact congrArg (· ≫ yoneda.map (relocalizeBaseInv hψ))
      (relocalizedYonedaIso_naturality B (B.obj hS) (B.obj hZ) h p)
  · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
    rfl
  · simp only [relocalizeChart, Iso.trans_hom, Functor.mapIso_hom, Iso.refl_hom,
      Category.comp_id]
    change Λ.map a = (ρU.hom ≫ yoneda.map (relocalizeBaseIso hψ).hom) ≫
      yoneda.map (relocalizeBaseIso hψ).inv ≫ ρU.inv ≫ Λ.map a
    rw [Category.assoc, ← Functor.map_comp_assoc yoneda, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id, Category.id_comp, Iso.hom_inv_id_assoc]

/-- **A finite morphism stays finite when viewed over `Spec ℤ`.**  A morphism from an affine
scheme to the view of the target is, up to an isomorphism which is the identity on the
underlying scheme, the extension of a morphism to the target; the extension preserves fibre
products and carries representable presheaves to representable presheaves. -/
private theorem isFinite_relocalizeMap {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : F ⟶ G)
    (hf : IsFinite B S hS f) :
    IsFinite B (⊤_ Scheme.{u}) hZ
      ((OverShriek.relocalizePresheafFunctor (integersMap B S hS hZ)).map f) := by
  let h := integersMap B S hS hZ
  intro U' hU' ξ'
  obtain ⟨ψ, hψ, a, rfl⟩ := exists_relocalizeChart B S (⊤_ Scheme.{u}) hS hZ h U' ξ'
  obtain ⟨V, p, i, hV, hp, hpb⟩ := hf (Over.mk ψ) hU' a
  refine ⟨(Over.map h).obj V, (Over.map h).map p ≫ relocalizeBaseInv hψ,
    relocalizeChart B S (⊤_ Scheme.{u}) hS hZ h i, hV, ?_,
    isPullback_relocalizeChart_baseHom hψ hpb⟩
  have hid : (BigFppfOver.toScheme B (⊤_ Scheme.{u}) hZ).map (relocalizeBaseInv hψ) = 𝟙 _ :=
    B.inclusion.map_id _
  rwa [Functor.map_comp, hid, Category.comp_id]

end Morphisms

/-! ### Sheaves of ideals along the change of base -/

section Ideals

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))

/-- An algebraic space over `S`, viewed as an algebraic space over `Spec ℤ`. -/
private noncomputable abbrev viewSpace (Y : AlgebraicSpaces B S hS) :
    AlgebraicSpaces B (⊤_ Scheme.{u}) hZ :=
  ⟨viewOverIntegers B S hS hZ Y.1,
    isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) Y.1 Y.2⟩

/-- The restriction maps of the structure sheaf of the view are those of the structure sheaf of
`Y`, read on the corresponding charts: the two charts have the same underlying schemes. -/
private theorem unit_map_view (Y : AlgebraicSpaces B S hS)
    {V' W' : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1)} (k : W' ⟶ V')
    (s : (SheafOfModules.unit (structureRingSheaf B (⊤_ Scheme.{u}) hZ
      (viewSpace B S hS hZ Y))).val.obj (op V')) :
    (SheafOfModules.unit (structureRingSheaf B (⊤_ Scheme.{u}) hZ
      (viewSpace B S hS hZ Y))).val.map k.op s =
    (SheafOfModules.unit (structureRingSheaf B S hS Y)).val.map
      ((smallEtaleFromIntegers B S hS hZ Y.1).map k).op s := rfl

/-- The sheaf of ideals of the view over `Spec ℤ` attached to a sheaf of ideals `ℐ ⊆ 𝒪_Y`: its
sections over a chart of the view are the sections of `ℐ` over the corresponding chart of `Y`,
which has the same underlying scheme. -/
private noncomputable def viewIdeal (Y : AlgebraicSpaces B S hS)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule) :
    (SheafOfModules.unit (structureRingSheaf B (⊤_ Scheme.{u}) hZ
      (viewSpace B S hS hZ Y))).Submodule where
  obj V' := I.obj (op ((smallEtaleFromIntegers B S hS hZ Y.1).obj V'.unop))
  map g _ hx := I.map_mem ((smallEtaleFromIntegers B S hS hZ Y.1).map g.unop).op hx
  isSheaf V' s hs := by
    refine I.isSheaf (X := op ((smallEtaleFromIntegers B S hS hZ Y.1).obj V'.unop)) s ?_
    refine (SmallEtale.topology B S hS Y.1).superset_covering ?_
      ((coverPreserving_smallEtaleFromIntegers B S hS hZ Y.1).cover_preserve hs)
    intro W g hg
    obtain ⟨Z, k, l, hk, hgl⟩ := hg
    subst hgl
    have hk' : (SheafOfModules.unit (structureRingSheaf B S hS Y)).val.map
        ((smallEtaleFromIntegers B S hS hZ Y.1).map k).op s ∈
          I.obj (op ((smallEtaleFromIntegers B S hS hZ Y.1).obj Z)) := by
      rw [← unit_map_view]
      exact hk
    exact (I.toSubmodule.toSubfunctor.sieveOfSection
      (U := op ((smallEtaleFromIntegers B S hS hZ Y.1).obj V'.unop)) s).downward_closed hk' l

/-- The module of the transported sheaf of ideals is the reindexing of the module of `ℐ`. -/
private noncomputable def viewIdealIso (Y : AlgebraicSpaces B S hS)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule) :
    (viewIdeal B S hS hZ Y I).toSheafOfModules ≅
      (SheafOfModules.pushforward.{u} (𝟙 (Stacks.SheafOfModules.reindexRing
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1))
        (smallEtaleIntegersEquivalence B S hS hZ Y.1).symm (structureRingSheaf B S hS Y)))).obj
        I.toSheafOfModules :=
  Iso.refl _

/-- The transported sheaf of ideals is quasi-coherent of finite type when `ℐ` is. -/
private theorem isFiniteTypeQuasicoherentIdeal_viewIdeal (Y : AlgebraicSpaces B S hS)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule)
    (hI : IsFiniteTypeQuasicoherentIdeal B S hS Y I) :
    IsFiniteTypeQuasicoherentIdeal B (⊤_ Scheme.{u}) hZ (viewSpace B S hS hZ Y)
      (viewIdeal B S hS hZ Y I) :=
  ⟨SheafOfModules.IsQuasicoherentOnSite.of_iso (viewIdealIso B S hS hZ Y I).symm
      ((Stacks.SheafOfModules.isQuasicoherentOnSite_reindex_iff
        (smallEtaleIntegersEquivalence B S hS hZ Y.1).symm (structureRingSheaf B S hS Y)
        I.toSheafOfModules).2 hI.1),
    Stacks.SheafOfModules.FiniteTypeTransport.isFiniteTypeOnSite_of_iso
      (viewIdealIso B S hS hZ Y I).symm
      ((Stacks.SheafOfModules.FiniteTypeTransport.isFiniteTypeOnSite_reindex_iff
        (smallEtaleIntegersEquivalence B S hS hZ Y.1).symm (structureRingSheaf B S hS Y)
        I.toSheafOfModules).1 hI.2)⟩

/-- **The unit locus of the transported sheaf of ideals is the image of the unit locus of
`ℐ`.** -/
private theorem idealUnitLocus_viewIdeal (Y : AlgebraicSpaces B S hS)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule) :
    idealUnitLocus B (⊤_ Scheme.{u}) hZ (viewSpace B S hS hZ Y) (viewIdeal B S hS hZ Y I) =
      pointsRelocalize B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) Y.1 ''
        idealUnitLocus B S hS Y I := by
  ext x'
  constructor
  · rintro ⟨V', hV', y, rfl⟩
    have hmem : pointsMap B (⊤_ Scheme.{u}) hZ _ V'.obj.hom y ∈ Set.range
        (pointsMap B (⊤_ Scheme.{u}) hZ _ (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) ((smallEtaleFromIntegers B S hS hZ Y.1).obj V').obj.hom)) := by
      refine ⟨pointsMap B (⊤_ Scheme.{u}) hZ _ (yoneda.map (relocalizeBaseHom B S
        (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) (yonedaEquiv V'.obj.hom).2)) y, ?_⟩
      rw [← pointsMap_comp_apply]
      exact congrArg (fun α => pointsMap B (⊤_ Scheme.{u}) hZ _ α y)
        (eq_relocalizeBaseHom_comp_relocalizeChart V'.obj.hom).symm
    rw [range_pointsMap_relocalizeChart] at hmem
    obtain ⟨x, hx, hxx⟩ := hmem
    exact ⟨x, ⟨(smallEtaleFromIntegers B S hS hZ Y.1).obj V', hV', hx⟩, hxx⟩
  · rintro ⟨x, ⟨V, hV, y, rfl⟩, rfl⟩
    refine ⟨(smallEtaleToIntegers B S hS hZ Y.1).obj V,
      SheafOfModules.Submodule.unit_obj_eq_top_of_map I
        ((smallEtaleIntegersUnitIso B S hS hZ Y.1).inv.app V).op hV, ?_⟩
    change _ ∈ Set.range (pointsMap B (⊤_ Scheme.{u}) hZ _ (relocalizeChart B S (⊤_ Scheme.{u})
      hS hZ (integersMap B S hS hZ) V.obj.hom))
    rw [range_pointsMap_relocalizeChart]
    exact ⟨_, ⟨y, rfl⟩, rfl⟩

/-- **The zero locus of the transported sheaf of ideals is the image of the zero locus of
`ℐ`.** -/
private theorem idealZeroLocus_viewIdeal (Y : AlgebraicSpaces B S hS)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule) :
    idealZeroLocus B (⊤_ Scheme.{u}) hZ (viewSpace B S hS hZ Y) (viewIdeal B S hS hZ Y I) =
      pointsRelocalize B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) Y.1 ''
        idealZeroLocus B S hS Y I := by
  rw [idealZeroLocus, idealZeroLocus, idealUnitLocus_viewIdeal,
    Set.image_compl_eq (pointsRelocalize_bijective B S (⊤_ Scheme.{u}) hS hZ
      (integersMap B S hS hZ) Y.1)]

end Ideals

/-! ### Base change of charts along the change of base -/

section BaseChange

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))

/-- A morphism of algebraic spaces over `S`, viewed over `Spec ℤ`. -/
private noncomputable abbrev viewHom {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X) :
    viewSpace B S hS hZ Y ⟶ viewSpace B S hS hZ X :=
  ObjectProperty.homMk ((OverShriek.relocalizePresheafFunctor (integersMap B S hS hZ)).map f.hom)

variable {B S hS hZ}

/-- The factorization through `S` carried by a chart of the view of a presheaf. -/
private theorem yonedaEquiv_fst_comp_integersMap {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U' : BigFppfOver B (⊤_ Scheme.{u}) hZ} (c' : yoneda.obj U' ⟶ viewOverIntegers B S hS hZ F) :
    (yonedaEquiv c').1.1 ≫ integersMap B S hS hZ = U'.hom :=
  (yonedaEquiv c').2

/-- The base change along `f` of the chart of `X` named by a chart of the view, extended back to
`Spec ℤ`, is a base change along the view of `f` of that chart of the view. -/
private theorem isPullback_view_baseChange {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (U' : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1)) :
    IsPullback
      (relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
        (hf.fst ((smallEtaleFromIntegers B S hS hZ X.1).obj U').obj.hom))
      (yoneda.map ((Over.map (integersMap B S hS hZ)).map
          (hf.snd ((smallEtaleFromIntegers B S hS hZ X.1).obj U').obj.hom) ≫
        relocalizeBaseInv (yonedaEquiv_fst_comp_integersMap U'.obj.hom)))
      (viewHom B S hS hZ f).hom U'.obj.hom := by
  have sq := isPullback_relocalizeChart_baseHom (yonedaEquiv_fst_comp_integersMap U'.obj.hom)
    (hf.isPullback ((smallEtaleFromIntegers B S hS hZ X.1).obj U').obj.hom)
  have hc : yoneda.map (relocalizeBaseHom B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
        (yonedaEquiv_fst_comp_integersMap U'.obj.hom)) ≫
      relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
        ((smallEtaleFromIntegers B S hS hZ X.1).obj U').obj.hom = U'.obj.hom :=
    (eq_relocalizeBaseHom_comp_relocalizeChart U'.obj.hom).symm
  rwa [hc] at sq

/-- The two base changes of a chart of the view of `X`: along the view of `f`, and along `f`
followed by the extension to `Spec ℤ`.  Both are fibre products of the same square. -/
private noncomputable def baseChangeViewIso {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom)
    (U' : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1)) :
    (smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf').obj U' ≅
      (smallEtaleToIntegers B S hS hZ Y.1).obj
        ((smallBaseChange B S hS f hf).obj ((smallEtaleFromIntegers B S hS hZ X.1).obj U')) :=
  ObjectProperty.isoMk _ (CostructuredArrow.isoMk
    (Yoneda.fullyFaithful.preimageIso ((hf'.isPullback U'.obj.hom).isoIsPullback _ _
      (isPullback_view_baseChange f hf U')))
    (by
      have h1 := (hf'.isPullback U'.obj.hom).isoIsPullback_hom_fst _ _
        (isPullback_view_baseChange f hf U')
      exact (congrArg (· ≫ _) (Yoneda.fullyFaithful.map_preimage _)).trans h1))

/-- The comparison of the two base changes commutes with the projections to the chart, on
underlying schemes. -/
private theorem baseChangeViewIso_hom_left_snd {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom)
    (U' : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1)) :
    (baseChangeViewIso f hf hf' U').hom.hom.left.left ≫
        (hf.snd ((smallEtaleFromIntegers B S hS hZ X.1).obj U').obj.hom).left =
      (hf'.snd U'.obj.hom).left := by
  have h1 := (hf'.isPullback U'.obj.hom).isoIsPullback_hom_snd _ _
    (isPullback_view_baseChange f hf U')
  rw [← Yoneda.fullyFaithful.map_preimage
    ((hf'.isPullback U'.obj.hom).isoIsPullback _ _ (isPullback_view_baseChange f hf U')).hom,
    ← Functor.map_comp] at h1
  have h2 := congrArg (fun k => k.left) (yoneda.map_injective h1)
  simp only [Over.comp_left, relocalizeBaseInv] at h2
  exact h2

/-- The component at a chart of the view of the comparison of base changes, as charts of
`Y`. -/
private noncomputable def baseChangeViewComponent {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom)
    (U' : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1)) :
    (smallEtaleFromIntegers B S hS hZ Y.1).obj
        ((smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf').obj U') ≅
      (smallBaseChange B S hS f hf).obj ((smallEtaleFromIntegers B S hS hZ X.1).obj U') :=
  (smallEtaleFromIntegers B S hS hZ Y.1).mapIso (baseChangeViewIso f hf hf' U') ≪≫
    ((smallEtaleIntegersUnitIso B S hS hZ Y.1).app _).symm

/-- The component of the comparison commutes with the projections to the chart, on underlying
schemes. -/
private theorem baseChangeViewComponent_hom_left_snd {X Y : AlgebraicSpaces B S hS}
    (f : Y ⟶ X) (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom)
    (U' : SmallEtale B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1)) :
    (baseChangeViewComponent f hf hf' U').hom.hom.left.left ≫
        (hf.snd ((smallEtaleFromIntegers B S hS hZ X.1).obj U').obj.hom).left =
      (hf'.snd U'.obj.hom).left := by
  have e : (baseChangeViewComponent f hf hf' U').hom.hom.left.left =
      (baseChangeViewIso f hf hf' U').hom.hom.left.left ≫ 𝟙 _ := rfl
  rw [e, Category.comp_id]
  exact baseChangeViewIso_hom_left_snd f hf hf' U'

/-- **Base change of charts commutes with the change of base**: base change along the view of
`f` followed by reading charts over `S` is base change along `f` of the charts read over `S`. -/
private noncomputable def baseChangeViewComparison {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom) :
    smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf' ⋙
        smallEtaleFromIntegers B S hS hZ Y.1 ≅
      smallEtaleFromIntegers B S hS hZ X.1 ⋙ smallBaseChange B S hS f hf :=
  NatIso.ofComponents (baseChangeViewComponent f hf hf')
    (fun {U' U''} k => by
      apply ObjectProperty.hom_ext
      apply CostructuredArrow.hom_ext
      apply hf.hom_ext
      · exact (CostructuredArrow.w _).trans (CostructuredArrow.w _).symm
      · apply Over.OverMorphism.ext
        have h1 := congrArg Over.Hom.left
          (smallBaseChange_map_snd B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf' k)
        have h2 := congrArg Over.Hom.left
          (smallBaseChange_map_snd B S hS f hf ((smallEtaleFromIntegers B S hS hZ X.1).map k))
        change (((smallEtaleFromIntegers B S hS hZ Y.1).map ((smallBaseChange B (⊤_ Scheme.{u}) hZ
            (viewHom B S hS hZ f) hf').map k)).hom.left.left ≫
              (baseChangeViewComponent f hf hf' U'').hom.hom.left.left) ≫ _ =
          ((baseChangeViewComponent f hf hf' U').hom.hom.left.left ≫
            ((smallBaseChange B S hS f hf).map
              ((smallEtaleFromIntegers B S hS hZ X.1).map k)).hom.left.left) ≫ _
        refine ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·)
          (baseChangeViewComponent_hom_left_snd f hf hf' U'')).trans h1)).trans ?_
        refine Eq.symm ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) h2).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) ?_))))
        exact baseChangeViewComponent_hom_left_snd f hf hf' U')

attribute [local instance] isContinuous_smallBaseChange

/-- Continuity of base change along the view of `f`. -/
private instance isContinuous_smallBaseChange_view {X Y : AlgebraicSpaces B S hS} {f : Y ⟶ X}
    {hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom} :
    (smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf').IsContinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1)) :=
  isContinuous_smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf'

/-- Continuity of the extension of a chart of the view followed by base change along `f`. -/
private instance isContinuous_fromIntegers_comp_smallBaseChange {X Y : AlgebraicSpaces B S hS}
    {f : Y ⟶ X} {hf : yoneda.relativelyRepresentable f.hom} :
    (smallEtaleFromIntegers B S hS hZ X.1 ⋙ smallBaseChange B S hS f hf).IsContinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
      (SmallEtale.topology B S hS Y.1) :=
  Functor.isContinuous_comp _ _ _ (SmallEtale.topology B S hS X.1) _

/-- Continuity of base change along the view of `f` followed by the extension of a chart. -/
private instance isContinuous_smallBaseChange_comp_fromIntegers {X Y : AlgebraicSpaces B S hS}
    {f : Y ⟶ X} {hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom} :
    (smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf' ⋙
        smallEtaleFromIntegers B S hS hZ Y.1).IsContinuous
      (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
      (SmallEtale.topology B S hS Y.1) :=
  Functor.isContinuous_comp _ _ _
    (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1)) _

/-- Pulling back regular functions along a composite `g₁ ≫ g₂ = g₃`, as maps of rings: the
composite of the pullbacks along `g₂` and `g₁` is the pullback along `g₃` followed by the
identity. -/
private theorem gamma_map_comp_aux {T₁ T₂ T₃ : Scheme.{u}} (g₁ : T₁ ⟶ T₂) (g₂ : T₂ ⟶ T₃)
    (g₃ : T₁ ⟶ T₃) (h : g₁ ≫ g₂ = g₃) :
    (forget₂ CommRingCat.{u} RingCat.{u}).map (Scheme.Γ.map g₂.op) ≫
        (forget₂ CommRingCat.{u} RingCat.{u}).map (Scheme.Γ.map g₁.op) =
      (forget₂ CommRingCat.{u} RingCat.{u}).map (Scheme.Γ.map g₃.op) ≫ 𝟙 _ := by
  subst h
  rw [op_comp, Functor.map_comp, Functor.map_comp, Category.comp_id]

/-- **The structure maps of the two base changes agree**: pulling back regular functions along
the projection of either base change of a chart gives the same map, by
`AlgebraicGeometry.Space.baseChangeViewComponent_hom_left_snd`. -/
private theorem smallBaseChangeSharp_view {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom) :
    (𝟙 (Stacks.SheafOfModules.reindexRing
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
        (smallEtaleIntegersEquivalence B S hS hZ X.1).symm (smallEtaleRingSheaf B S hS X.1 X.2)) ≫
      ((smallEtaleFromIntegers B S hS hZ X.1).sheafPushforwardContinuous RingCat.{u}
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
        (SmallEtale.topology B S hS X.1)).map (smallBaseChangeSharp B S hS f hf)) ≫
      (Functor.sheafPushforwardContinuousNatTrans (baseChangeViewComparison f hf hf').hom
        RingCat.{u} _ _).app (smallEtaleRingSheaf B S hS Y.1 Y.2) =
    smallBaseChangeSharp B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf' ≫
      ((smallBaseChange B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf').sheafPushforwardContinuous
        RingCat.{u} (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1))).map
        (𝟙 (Stacks.SheafOfModules.reindexRing
          (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1))
          (smallEtaleIntegersEquivalence B S hS hZ Y.1).symm
          (smallEtaleRingSheaf B S hS Y.1 Y.2))) := by
  ext U' : 3
  have key : (BigFppfOver.toScheme B S hS).map
        ((baseChangeViewComparison f hf hf').hom.app U'.unop).hom.left ≫
      (BigFppfOver.toScheme B S hS).map
        (hf.snd ((smallEtaleFromIntegers B S hS hZ X.1).obj U'.unop).obj.hom) =
      (BigFppfOver.toScheme B (⊤_ Scheme.{u}) hZ).map (hf'.snd U'.unop.obj.hom) :=
    ((BigFppfOver.toScheme B S hS).map_comp _ _).symm.trans
      (congrArg B.inclusion.map (baseChangeViewComponent_hom_left_snd f hf hf' U'.unop))
  change (forget₂ CommRingCat.{u} RingCat.{u}).map (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (hf.snd ((smallEtaleFromIntegers B S hS hZ X.1).obj U'.unop).obj.hom)).op) ≫
    (forget₂ CommRingCat.{u} RingCat.{u}).map (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      ((baseChangeViewComparison f hf hf').hom.app U'.unop).hom.left).op) =
    (forget₂ CommRingCat.{u} RingCat.{u}).map (Scheme.Γ.map
      ((BigFppfOver.toScheme B (⊤_ Scheme.{u}) hZ).map (hf'.snd U'.unop.obj.hom)).op) ≫ 𝟙 _
  exact gamma_map_comp_aux _ _ _ key

/-- **Direct image along `f` commutes with the change of base**: reindexing the direct image
of an `𝒪_Y`-module along `f` is the direct image along the view of `f` of its reindexing. -/
private noncomputable def viewPushforwardIso {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : yoneda.relativelyRepresentable f.hom)
    (hf' : yoneda.relativelyRepresentable (viewHom B S hS hZ f).hom)
    (M : SheafOfModules.{u} (smallEtaleRingSheaf B S hS Y.1 Y.2)) :
    (SheafOfModules.pushforward.{u} (𝟙 (Stacks.SheafOfModules.reindexRing
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
        (smallEtaleIntegersEquivalence B S hS hZ X.1).symm
        (smallEtaleRingSheaf B S hS X.1 X.2)))).obj
        ((smallBaseChangeModulePushforward B S hS f hf).obj M) ≅
      (smallBaseChangeModulePushforward B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf').obj
        ((SheafOfModules.pushforward.{u} (𝟙 (Stacks.SheafOfModules.reindexRing
          (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1))
          (smallEtaleIntegersEquivalence B S hS hZ Y.1).symm
          (smallEtaleRingSheaf B S hS Y.1 Y.2)))).obj M) :=
  (SheafOfModules.pushforwardComp.{u} (F := smallEtaleFromIntegers B S hS hZ X.1)
      (𝟙 (Stacks.SheafOfModules.reindexRing
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
        (smallEtaleIntegersEquivalence B S hS hZ X.1).symm (smallEtaleRingSheaf B S hS X.1 X.2)))
      (smallBaseChangeSharp B S hS f hf)).app M ≪≫
    (SheafOfModules.pushforwardCongr₂ _ (baseChangeViewComparison f hf hf')
      (smallBaseChangeSharp_view f hf hf')).app M ≪≫
    ((SheafOfModules.pushforwardComp.{u}
      (smallBaseChangeSharp B (⊤_ Scheme.{u}) hZ (viewHom B S hS hZ f) hf')
      (G := smallEtaleFromIntegers B S hS hZ Y.1)
      (𝟙 (Stacks.SheafOfModules.reindexRing
        (SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ Y.1))
        (smallEtaleIntegersEquivalence B S hS hZ Y.1).symm
        (smallEtaleRingSheaf B S hS Y.1 Y.2)))).app M).symm

end BaseChange

/-! ### The situation of Stacks 0GUY over `Spec ℤ` -/

section Situation

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))

/-- **The situation of Stacks 0GUY, and the hypothesis of the converse of Stacks 0GV1, carried
over to `Spec ℤ`.**  Given the situation of Stacks 0GUY for a quasi-compact and quasi-separated
algebraic space `X` over `S` — an affine scheme `V` with a surjective étale `φ : V ⟶ X`, an open
immersion `j : V ⟶ Y`, a finite `π : Y ⟶ X` with `π ∘ j = φ`, and a finite type quasi-coherent
sheaf of ideals `ℐ ⊆ 𝒪_Y` with `|V(ℐ)| = |Y| ∖ |j(V)|` — in which `π_*ℐ` is the quotient of a
finite locally free `𝒪_X`-module, the view `X'` of `X` over `Spec ℤ` carries a situation of
Stacks 0GUY in which `π'_*ℐ'` is again the quotient of a finite locally free `𝒪_{X'}`-module.

Every datum is carried over by the change of base: `V`, `φ`, `j` and `π` are extended along
`S ⟶ Spec ℤ`, `Y` is viewed over `Spec ℤ`, and `ℐ` becomes the sheaf of ideals with the same
sections over the same schemes.  The direct image `π'_*ℐ'` is the reindexing of `π_*ℐ` along the
equivalence of the small étale sites of `X` and `X'`, which carries the surjection from a finite
locally free module to one. -/
theorem ResolutionPropertyDescentSituation.exists_viewOverIntegers_of_exists_epi_idealDirectImage
    (X : AlgebraicSpaces B S hS) (hqc : IsQuasiCompactSpace B S hS X.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (D : ResolutionPropertyDescentSituation B S hS hZ X hqc hqs)
    (hqc' : IsQuasiCompactSpace B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
    (hqs' : IsAbsolutelyQuasiSeparated B (⊤_ Scheme.{u}) hZ hZ (viewOverIntegers B S hS hZ X.1))
    (h : ∃ (E : Modules.{u, u} B S hS X.1 X.2) (_ : SheafOfModules.IsFiniteLocallyFreeOnSite E)
      (p : E ⟶ ResolutionPropertyDescentSituation.idealDirectImage B S hS hZ D), Epi p) :
    ∃ (D' : ResolutionPropertyDescentSituation B (⊤_ Scheme.{u}) hZ hZ
        ⟨viewOverIntegers B S hS hZ X.1, isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ
          (integersMap B S hS hZ) X.1 X.2⟩ hqc' hqs')
      (E' : Modules.{u, u} B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1)
        (isAlgebraicSpace_viewOver B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) X.1 X.2))
      (_ : SheafOfModules.IsFiniteLocallyFreeOnSite E')
      (p' : E' ⟶ ResolutionPropertyDescentSituation.idealDirectImage B (⊤_ Scheme.{u}) hZ hZ D'),
      Epi p' := by
  obtain ⟨E, hE, p, hp⟩ := h
  let D' : ResolutionPropertyDescentSituation B (⊤_ Scheme.{u}) hZ hZ
      (viewSpace B S hS hZ X) hqc' hqs' :=
    { V := (Over.map (integersMap B S hS hZ)).obj D.V
      isAffine_V := D.isAffine_V
      φ := relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) D.φ
      isSurjective_φ := isSurjective_relocalizeChart D.φ D.isSurjective_φ
      isEtale_φ := isEtale_relocalizeChart D.φ D.isEtale_φ
      Y := viewSpace B S hS hZ D.Y
      j := relocalizeChart B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ) D.j
      π := (OverShriek.relocalizePresheafFunctor (integersMap B S hS hZ)).map D.π
      isOpenImmersion_j := isOpenImmersion_relocalizeChart D.j D.isOpenImmersion_j
      isFinite_π := isFinite_relocalizeMap D.π D.isFinite_π
      comp_eq := (relocalizeChart_comp B S (⊤_ Scheme.{u}) hS hZ (integersMap B S hS hZ)
        D.j D.π).trans (congrArg _ D.comp_eq)
      I := viewIdeal B S hS hZ D.Y D.I
      isFiniteTypeQuasicoherent_I :=
        isFiniteTypeQuasicoherentIdeal_viewIdeal B S hS hZ D.Y D.I D.isFiniteTypeQuasicoherent_I
      idealZeroLocus_I := by
        rw [idealZeroLocus_viewIdeal, D.idealZeroLocus_I, range_pointsMap_relocalizeChart,
          Set.image_compl_eq (pointsRelocalize_bijective B S (⊤_ Scheme.{u}) hS hZ
            (integersMap B S hS hZ) D.Y.1)] }
  let Ψ := Stacks.SheafOfModules.reindexEquivalence
    (J' := SmallEtale.topology B (⊤_ Scheme.{u}) hZ (viewOverIntegers B S hS hZ X.1))
    (smallEtaleIntegersEquivalence B S hS hZ X.1).symm (smallEtaleRingSheaf B S hS X.1 X.2)
  have hf := relativelyRepresentable_hom_of_isFinite B S hS
    (ResolutionPropertyDescentSituation.πHom B S hS hZ D) D.isFinite_π
  have hf' := relativelyRepresentable_hom_of_isFinite B (⊤_ Scheme.{u}) hZ
