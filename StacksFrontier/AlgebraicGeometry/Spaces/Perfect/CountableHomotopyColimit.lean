variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **A colimit over `ℕ` of countable modules is countable**: every element comes from some
term. -/
theorem countable_colimit_nat {R : Type u} [Ring R] (D : ℕ ⥤ ModuleCat.{u} R)
    (h : ∀ n, Countable (D.obj n)) : Countable ((colimit D : ModuleCat.{u} R) : Type u) := by
  have : PreservesFilteredColimitsOfSize.{0, 0} (forget (ModuleCat.{u} R)) :=
    preservesFilteredColimitsOfSize_shrink.{0, u, 0, u} _
  have hs : Function.Surjective (fun p : Σ n, D.obj n => colimit.ι D p.1 p.2) := fun x => by
    obtain ⟨n, y, rfl⟩ := Concrete.colimit_exists_rep D x
    exact ⟨⟨n, y⟩, rfl⟩
  exact hs.countable

/-- **A countable direct sum of objects of `D_QCoh` lies in `D_QCoh`.** -/
theorem qcohDerived_sigma_nat (Y : AlgebraicSpaces B S hS)
    (Z : ℕ → DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2))
    (hZ : ∀ n, QcohDerived B S hS Y (Z n)) :
    QcohDerived B S hS Y (∐ Z) := by
  have := isClosedUnderColimitsOfShape_qcohDerived B S hS Y (ULift.{u} ℕ)
  exact (QcohDerived B S hS Y).prop_of_iso
    (Sigma.whiskerEquiv Equiv.ulift (fun _ => Iso.refl _))
    (ObjectProperty.prop_colimit _ _ fun j => hZ j.as.down)

section Represented

variable (T : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]

/-- **The sections of the cohomology sheaves of an object of `D_QCoh` over an affine
represented space** are the cohomology of its derived sections. -/
def homologySectionsEquiv
    (L : DerivedCategory (Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)))
    (hL : QcohDerived B S hS (schemeSpace T) L) (i : ℤ) :
    (DerivedCategory.homologyFunctor
        (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) i).obj
        ((representedAffineDerivedSections B S hS T).obj L) ≃
      ((DerivedCategory.homologyFunctor _ i).obj L).val.obj (op (idEtaleChart B S hS T)) :=
  (representedAffineDerivedSectionsHomologyIso B S hS T L hL i).toLinearEquiv.toEquiv.trans
    (representedAffineSectionsEquiv T _)

/-- **The derived sections over an affine represented space commute with direct sums of objects
of `D_QCoh`**: the associated-module functor `Φ` preserves direct sums, is fully faithful, and its
counit is invertible on `D_QCoh`, which is closed under direct sums. -/
theorem preservesColimit_representedAffineDerivedSections {I : Type*}
    (Z : I → DerivedCategory (Modules.{u, u} B S hS (yoneda.obj T)
      (isAlgebraicSpace_yoneda B S hS T))) [HasCoproduct Z]
    [HasCoproduct fun i => (representedAffineDerivedSections B S hS T).obj (Z i)]
    [HasCoproduct fun i => (representedAffineDerivedAssociated B S hS T).obj
      ((representedAffineDerivedSections B S hS T).obj (Z i))]
    (hZ : ∀ i, QcohDerived B S hS (schemeSpace T) (Z i))
    (hSum : QcohDerived B S hS (schemeSpace T) (∐ Z :)) :
    PreservesColimit (Discrete.functor Z) (representedAffineDerivedSections B S hS T) := by
  let RΓ := representedAffineDerivedSections B S hS T
  let Φ := representedAffineDerivedAssociated B S hS T
  let adj := representedAffineDerivedAdjunction B S hS T
  suffices IsIso (sigmaComparison RΓ Z) from PreservesCoproduct.of_iso_comparison RΓ Z
  have : ∀ i, IsIso (adj.counit.app (Z i)) := fun i =>
    isIso_representedAffineDerivedAdjunction_counit_app B S hS T _ (hZ i)
  have : IsIso (adj.counit.app (∐ Z)) :=
    isIso_representedAffineDerivedAdjunction_counit_app B S hS T _ hSum
  have : PreservesColimitsOfShape (Discrete I) Φ :=
    adj.leftAdjoint_preservesColimits.preservesColimitsOfShape
  let p : ∀ i, Φ.obj (RΓ.obj (Z i)) ≅ Z i := fun i => asIso (adj.counit.app (Z i))
  have hcomp : sigmaComparison Φ (fun i => RΓ.obj (Z i)) ≫ Φ.map (sigmaComparison RΓ Z) ≫
      adj.counit.app (∐ Z) = Sigma.desc fun i => (p i).hom ≫ Sigma.ι Z i := by
    refine Sigma.hom_ext _ _ fun i => ?_
    rw [ι_comp_sigmaComparison_assoc, ← Φ.map_comp_assoc, ι_comp_sigmaComparison, Sigma.ι_desc]
    exact adj.counit.naturality (Sigma.ι Z i)
  have hdesc : IsIso (Sigma.desc fun i => (p i).hom ≫ Sigma.ι Z i) :=
    ⟨Sigma.desc fun i => (p i).inv ≫ Sigma.ι (fun i => Φ.obj (RΓ.obj (Z i))) i,
      Sigma.hom_ext _ _ fun i => by simp, Sigma.hom_ext _ _ fun i => by simp⟩
  have : IsIso (Φ.map (sigmaComparison RΓ Z)) := by
    have : IsIso (sigmaComparison Φ (fun i => RΓ.obj (Z i)) ≫ Φ.map (sigmaComparison RΓ Z) ≫
        adj.counit.app (∐ Z)) := hcomp ▸ hdesc
    have : IsIso (Φ.map (sigmaComparison RΓ Z) ≫ adj.counit.app (∐ Z)) :=
      IsIso.of_isIso_comp_left (sigmaComparison Φ fun i => RΓ.obj (Z i)) _
    exact IsIso.of_isIso_comp_right _ (adj.counit.app (∐ Z))
  exact (representedAffineDerivedAssociatedFullyFaithful B S hS T).isIso_of_isIso_map _

end Represented

variable (X : AlgebraicSpaces B S hS)

/-- The ring of functions of an affine étale chart of `X` is the ring of sections of `𝒪_X` over
the chart. -/
theorem countable_chartRing_of_countable (V : SmallEtale B S hS X.1)
    (h : Countable (((Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj (op V))) :
    Countable Γ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V), ⊤) :=
  h

/-- **Sections of cohomology sheaves over an affine étale chart.** For `K ∈ D_QCoh(𝒪_X)` and an
affine étale chart `V = Spec(A)` of `X`, the sections over `V` of `H^i(K)` are countable as soon
as the cohomology of `RΓ(V, K|_V)` in `D(A)` is. -/
theorem countable_homology_sections_of_countable (V : SmallEtale B S hS X.1)
    (hV : IsAffineChart B S hS X.1 V) (K : DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (hK : QcohDerived B S hS X K) (i : ℤ)
    (h : haveI : IsAffine ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS X.1).obj V)) := hV
      Countable ((DerivedCategory.homologyFunctor (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS X.1).obj V), ⊤)) i).obj
        ((representedAffineDerivedSections B S hS ((SmallEtale.toOver B S hS X.1).obj V)).obj
          ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
            (isEtale_chartToSpace B S hS X V)).mapDerivedCategory.obj K)))) :
    Countable (((DerivedCategory.homologyFunctor _ i).obj K).val.obj (op V)) := by
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V)) := hV
  let g := chartToSpace B S hS X V
  have hg := isEtale_chartToSpace B S hS X V
  have hK' := derivedQuasicoherent_etaleModulePullback B S hS g hg K hK
  have h₁ := (homologySectionsEquiv _ _ hK' i).symm.injective.countable
  let e := ((etaleModulePullback.{u, u} B S hS g hg).mapDerivedCategoryHomologyIso i).app K
  exact @Function.Injective.countable _ _ h₁ _
    ((PresheafOfModules.evaluation _ (op (idEtaleChart B S hS
      ((SmallEtale.toOver B S hS X.1).obj V)))).mapIso
        ((SheafOfModules.forget _).mapIso e)).symm.toLinearEquiv.injective

/-- **The cohomology sheaves of a perfect object have countable sections over the affine étale
charts**, when the structure sheaf does: on an affine chart `V = Spec(A)` with `A` countable, a
perfect object restricts to a perfect complex of `A`-modules. -/
theorem countable_homology_sections_of_isPerfect
    (hO : ∀ V : SmallEtale B S hS X.1, IsAffineChart B S hS X.1 V →
      Countable (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj (op V)))
    (E : DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (hE : (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect E) (i : ℤ) (V : SmallEtale B S hS X.1)
    (hV : IsAffineChart B S hS X.1 V) :
    Countable (((DerivedCategory.homologyFunctor _ i).obj E).val.obj (op V)) := by
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V)) := hV
  have := countable_chartRing_of_countable X V (hO V hV)
  refine countable_homology_sections_of_countable X V hV E
    (qcohDerived_of_isPerfect _ _ _ X E hE) i ?_
  exact Stacks.Homology.hasCountableHomology_of_isPerfect
    (isPerfect_representedAffineDerivedSections_obj B S hS _ _
      (isPerfect_etaleRestrict B S hS _ (isEtale_chartToSpace B S hS X V) E hE)) i

/-- `Hom(A[m], B)` is countable as soon as `Hom(A, B[-m])` is. -/
theorem countable_hom_shift_left {C : Type*} [Category C] [Preadditive C] [HasShift C ℤ]
    (A B : C) (m : ℤ) (h : Countable (A ⟶ B⟦-m⟧)) : Countable (A⟦m⟧ ⟶ B) :=
  @Function.Injective.countable _ _ h
    (fun k => (shiftFunctorCompIsoId C m (-m) (add_neg_cancel m)).inv.app A ≫
      (shiftFunctor C (-m)).map k) fun _ _ hk =>
    (shiftFunctor C (-m)).map_injective ((cancel_epi _).1 hk)

/-- **Stacks 0CRU on `X` itself**: for `K ∈ D_QCoh(𝒪_X)` with countable sections of its
cohomology sheaves over affine étale charts and `E` perfect, every `Hom(E[m], K)` is
countable. -/
theorem countable_hom_shift_of_countable_sections
    (hXqc : IsQuasiCompactSpace B S hS X.obj)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.obj)
    (K : QuasicoherentDerivedCategory.{u, u} B S hS X.obj X.property)
    (hK : ∀ V : SmallEtale B S hS X.obj, IsAffineChart B S hS X.obj V → ∀ i : ℤ,
      Countable (((DerivedCategory.homologyFunctor _ i).obj K.obj).val.obj (op V)))
    (E : DerivedCategory (Modules.{u, u} B S hS X.obj X.property))
    (hE : RingedSite.IsPerfect (smallEtaleRingedSite B S hS X.obj X.property) E) (m : ℤ) :
    Countable (E⟦m⟧ ⟶ K.obj) := by
  let U : SpacesEtale B S hS X := ⟨Over.mk (𝟙 X), isEtale_of_isIso B S hS (𝟙 X.1)⟩
  have hc :=
    countable_ext_of_qcqs_etale_of_countable_sections X hXqc hXqs K hK E hE U hXqc hXqs (-m)
  have hid : IsEtale B S hS (𝟙 X : X ⟶ X).hom := isEtale_of_isIso B S hS (𝟙 X.1)
  let e : (etaleModulePullback.{u, u} B S hS (𝟙 X) hid).mapDerivedCategory ≅ 𝟭 _ :=
    Stacks.DerivedCategoryComparisons.mapDerivedCategoryIsoOfNatIso _ _
      (etaleModulePullbackIdIso B S hS hid) ≪≫ Functor.mapDerivedCategoryIdIso
  exact countable_hom_shift_left _ _ m
    (countable_hom_shift_of_iso (e.app E) (e.app K.obj) (-m) hc)

/-- **The cell tower over a perfect compact generator.** If the structure sheaf of `X` has
countable sections over the affine étale charts and `K ∈ D_QCoh(𝒪_X)` receives only countably
many morphisms from every shift of every perfect object, then `K` is a homotopy colimit of
perfect objects of `D(𝒪_X)`: the cell tower of Stacks 0CRM over a perfect compact generator of
`D_QCoh(𝒪_X)`, all of whose cells are countable by Stacks 0CRU. -/
theorem exists_isHomotopyColimit_isPerfect_of_countable_hom
    (hXqc : IsQuasiCompactSpace B S hS X.obj)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.obj)
    (hO : ∀ V : SmallEtale B S hS X.1, IsAffineChart B S hS X.1 V →
      Countable (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj (op V)))
    (K : QuasicoherentDerivedCategory.{u, u} B S hS X.obj X.property)
    (hK : ∀ E : DerivedCategory (Modules.{u, u} B S hS X.obj X.property),
      RingedSite.IsPerfect (smallEtaleRingedSite B S hS X.obj X.property) E →
        ∀ m : ℤ, Countable (E⟦m⟧ ⟶ K.obj)) :
    ∃ F : ℕ ⥤ DerivedCategory (Modules.{u, u} B S hS X.1 X.2),
      (∀ n, (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect (F.obj n)) ∧
        IsHomotopyColimit F K.obj := by
  let D := QuasicoherentDerivedCategory.{u, u} B S hS X.obj X.property
  have : (QcohDerived B S hS X).IsTriangulated :=
    isTriangulated_quasicoherentDerivedCategory B S hS X.1 X.2
  have : HasCoproducts.{u} D :=
    hasCoproducts_quasicoherentDerivedCategory_ringUniverse B S hS X.1 X.2
  obtain ⟨G, hGc, hGgen⟩ := exists_isCompactObject_isWeakTriangulatedGenerator_of_qcqs B S hS
    B.contains_terminal X hXqc hXqs
  let ι := (QcohDerived B S hS X).ι
  have hcell : ∀ Y : D, (∀ E : DerivedCategory (Modules.{u, u} B S hS X.obj X.property),
      RingedSite.IsPerfect (smallEtaleRingedSite B S hS X.obj X.property) E →
        ∀ m : ℤ, Countable (E⟦m⟧ ⟶ Y.obj)) →
      ∀ m : ℤ, Countable (G⟦m⟧ ⟶ Y) := fun Y hY m => by
    have h := hY G.obj (isPerfect_of_isCompactObject X hXqs G hGc) m
    have h' : Countable (ι.obj (G⟦m⟧) ⟶ ι.obj Y) :=
      @Function.Injective.countable _ _ h (fun k => (ι.commShiftIso m).inv.app G ≫ k)
        fun _ _ hk => (cancel_epi _).1 hk
    exact Function.Injective.countable ι.map_injective
  have hperf : ∀ Y : D, IsCompactObject.{u} Y → ∀ (E : DerivedCategory
      (Modules.{u, u} B S hS X.obj X.property)),
      RingedSite.IsPerfect (smallEtaleRingedSite B S hS X.obj X.property) E →
        ∀ m : ℤ, Countable (E⟦m⟧ ⟶ Y.obj) :=
    fun Y hY E hE m => countable_hom_shift_of_countable_sections X hXqc hXqs Y
      (fun V hV i => countable_homology_sections_of_isPerfect X hO Y.obj
        (isPerfect_of_isCompactObject X hXqs Y hY) i V hV) E hE m
  have hgen : ∀ Y : D,
      ((ObjectProperty.ofObj (fun _ : PUnit.{u + 1} => G)).shiftClosure ℤ).rightOrthogonal Y →
        IsZero Y := fun Y hY => by
    have h : ObjectProperty.ofObj (fun _ : PUnit.{u + 1} => G) = ObjectProperty.singleton G := by
      ext Z
      simp [ObjectProperty.ofObj_iff]
    exact hGgen Y (h ▸ hY)
  obtain ⟨F, hFc, hF⟩ :=
    @Pretriangulated.CountableCells.exists_isHomotopyColimit_isCompactObject_of_countable_hom
      D (inferInstanceAs (Category D)) (inferInstanceAs (Preadditive D))
      (inferInstanceAs (HasZeroObject D)) (inferInstanceAs (HasShift D ℤ))
      (fun n => inferInstanceAs ((CategoryTheory.shiftFunctor D n).Additive))
      (inferInstanceAs (Pretriangulated D)) (inferInstanceAs (HasCoproducts.{u} D)) G
      ⟨hGc, fun Y hY m => hcell Y (hperf Y hY) m⟩ hgen K (hcell K hK)
  have := isClosedUnderColimitsOfShape_qcohDerived B S hS X (ULift.{u} ℕ)
  have : PreservesColimitsOfShape (Discrete (ULift.{u} ℕ)) ι := ⟨fun {_} => inferInstance⟩
  have : PreservesColimitsOfShape (Discrete ℕ) ι :=
    preservesColimitsOfShape_of_equiv (Discrete.equivalence Equiv.ulift) _
  exact ⟨F ⋙ ι, fun n => isPerfect_of_isCompactObject X hXqs (F.obj n) (hFc n),
    hF.map ι⟩

/-- **Stacks 0CRV, (2) ⇒ (1).** If the structure sheaf of `X` and the cohomology sheaves of
`K ∈ D_QCoh(𝒪_X)` have countable sections over the affine étale charts, then `K` is a homotopy
colimit of perfect objects of `D(𝒪_X)`: the cell tower over a perfect compact generator of
`D_QCoh(𝒪_X)`, all of whose cells are countable by Stacks 0CRU. -/
theorem exists_isHomotopyColimit_isPerfect_of_countable
    (hXqc : IsQuasiCompactSpace B S hS X.obj)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.obj)
    (hO : ∀ V : SmallEtale B S hS X.1, IsAffineChart B S hS X.1 V →
      Countable (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj (op V)))
    (K : QuasicoherentDerivedCategory.{u, u} B S hS X.obj X.property)
    (hK : ∀ V : SmallEtale B S hS X.obj, IsAffineChart B S hS X.obj V → ∀ i : ℤ,
      Countable (((DerivedCategory.homologyFunctor _ i).obj K.obj).val.obj (op V))) :
    ∃ F : ℕ ⥤ DerivedCategory (Modules.{u, u} B S hS X.1 X.2),
      (∀ n, (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect (F.obj n)) ∧
        IsHomotopyColimit F K.obj :=
  exists_isHomotopyColimit_isPerfect_of_countable_hom X hXqc hXqs hO K fun E hE m =>
    countable_hom_shift_of_countable_sections X hXqc hXqs K hK E hE m

/-- **On an affine represented space over a countable ring, the derived sections of a homotopy
colimit of perfect objects have countable cohomology.** -/
theorem countable_homology_representedAffineDerivedSections_of_isHomotopyColimit
    (T : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    [Countable Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)]
    (F : ℕ ⥤ DerivedCategory (Modules.{u, u} B S hS (yoneda.obj T)
      (isAlgebraicSpace_yoneda B S hS T))) [HasCoproduct F.obj]
    (hF : ∀ n, (smallEtaleRingedSite B S hS (yoneda.obj T)
      (isAlgebraicSpace_yoneda B S hS T)).IsPerfect (F.obj n))
    (L : DerivedCategory (Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)))
    (hL : IsHomotopyColimit F L) (i : ℤ) :
    Countable ((DerivedCategory.homologyFunctor
      (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) i).obj
        ((representedAffineDerivedSections B S hS T).obj L)) := by
  have : HasColimitsOfShape (Discrete (ULift.{u} ℕ))
      (DerivedCategory (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))) :=
    Stacks.SmallDerivedCategory.hasColimitsOfShape_discrete_derivedCategory
      (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) (ULift.{u} ℕ)
  have : HasColimitsOfShape (Discrete ℕ)
      (DerivedCategory (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))) :=
    hasColimitsOfShape_of_equivalence (Discrete.equivalence Equiv.ulift)
  have hFq : ∀ n, QcohDerived B S hS ⟨yoneda.obj T, isAlgebraicSpace_yoneda B S hS T⟩ (F.obj n) :=
    fun n => qcohDerived_of_isPerfect _ _ _ _ _ (hF n)
  have : PreservesColimit (Discrete.functor F.obj) (representedAffineDerivedSections B S hS T) :=
    preservesColimit_representedAffineDerivedSections T _ hFq
      (qcohDerived_sigma_nat ⟨yoneda.obj T, isAlgebraicSpace_yoneda B S hS T⟩ _ hFq)
  obtain ⟨p, q, hT⟩ := hL.map (representedAffineDerivedSections B S hS T)
  have : AB5OfSize.{0, 0} AddCommGrpCat.{u} := AB5OfSize_shrink AddCommGrpCat.{u}
  have : HasExactColimitsOfShape ℕ (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) :=
    HasExactColimitsOfShape.domain_of_functor ℕ
      (forget₂ (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) AddCommGrpCat.{u})
  have := Stacks.ShiftedSum.derivedHomology_preservesCoproducts
    (A := ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) ℕ i
  obtain ⟨e, -⟩ := exists_iso_colimit_of_isHomotopyColimit
    (F ⋙ representedAffineDerivedSections B S hS T)
    (DerivedCategory.homologyFunctor (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) i)
    p q hT
  have hc := countable_colimit_nat ((F ⋙ representedAffineDerivedSections B S hS T) ⋙
    DerivedCategory.homologyFunctor (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) i)
    fun n => Stacks.Homology.hasCountableHomology_of_isPerfect
      (isPerfect_representedAffineDerivedSections_obj B S hS T _ (hF n)) i
  exact @Function.Injective.countable _ _ hc _ e.symm.toLinearEquiv.injective

/-- **Stacks 0CRV, (1) ⇒ (2).** If the structure sheaf of `X` has countable sections over the
affine étale charts and `K ∈ D_QCoh(𝒪_X)` is a homotopy colimit of perfect objects, then the
cohomology sheaves of `K` have countable sections over the affine étale charts. -/
theorem countable_homology_sections_of_isHomotopyColimit
    (hO : ∀ V : SmallEtale B S hS X.1, IsAffineChart B S hS X.1 V →
      Countable (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj (op V)))
    (K : DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) (hKq : QcohDerived B S hS X K)
    (F : ℕ ⥤ DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) [HasCoproduct F.obj]
    (hF : ∀ n, (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect (F.obj n))
    (hFK : IsHomotopyColimit F K) (V : SmallEtale B S hS X.obj) (hV : IsAffineChart B S hS X.obj V)
    (i : ℤ) : Countable (((DerivedCategory.homologyFunctor _ i).obj K).val.obj (op V)) := by
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V)) := hV
  have := countable_chartRing_of_countable X V (hO V hV)
  refine countable_homology_sections_of_countable X V hV K hKq i ?_
  let g := chartToSpace B S hS X V
  have hg := isEtale_chartToSpace B S hS X V
  let Gg := (etaleModulePullback.{u, u} B S hS g hg).mapDerivedCategory
  have : PreservesColimitsOfShape (Discrete ℕ) Gg :=
    (etaleDerivedModuleAdjunction B S hS g hg).leftAdjoint_preservesColimits
      |>.preservesColimitsOfShape
  exact countable_homology_representedAffineDerivedSections_of_isHomotopyColimit _ (F ⋙ Gg)
    (fun n => isPerfect_etaleRestrict B S hS g hg _ (hF n)) _ (hFK.map Gg) i

/-- **Stacks 0CRV.** Let `X` be a quasi-compact and quasi-separated algebraic space over `S` such
that the sets of sections of `𝒪_X` over the affine schemes étale over `X` are countable, and let
`K` be an object of `D_QCoh(𝒪_X)`. Then `K = hocolim Eₙ` with every `Eₙ` a perfect object of
`D(𝒪_X)` if and only if the cohomology sheaves `H^i(K)` have countable sets of sections over the
affine schemes étale over `X`. -/
theorem exists_isHomotopyColimit_isPerfect_iff_countable
    (hXqc : IsQuasiCompactSpace B S hS X.obj)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.obj)
    (hO : ∀ V : SmallEtale B S hS X.1, IsAffineChart B S hS X.1 V →
      Countable (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj (op V)))
    (K : QuasicoherentDerivedCategory.{u, u} B S hS X.obj X.property) :
    (∃ F : ℕ ⥤ DerivedCategory (Modules.{u, u} B S hS X.1 X.2),
      (∀ n, (smallEtaleRingedSite B S hS X.1 X.2).IsPerfect (F.obj n)) ∧
        IsHomotopyColimit F K.obj) ↔
      ∀ V : SmallEtale B S hS X.obj, IsAffineChart B S hS X.obj V → ∀ i : ℤ,
        Countable (((DerivedCategory.homologyFunctor _ i).obj K.obj).val.obj (op V)) :=
  ⟨fun ⟨F, hF, hFK⟩ V hV i =>
      countable_homology_sections_of_isHomotopyColimit X hO K.obj K.property F hF hFK V hV i,
    exists_isHomotopyColimit_isPerfect_of_countable X hXqc hXqs hO K⟩

end AlgebraicGeometry.Space

