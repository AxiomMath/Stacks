module

public import Mathlib.RingTheory.Polynomial.Ideal
public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.FibrePrincipalDictionary
public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierDivisor
public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierEtaleEquiv
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleChartRespectsIso
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleMorphisms
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleSmoothLocalCriterion
public import StacksFrontier.AlgebraicGeometry.Spaces.PointsOfPullback
public import StacksFrontier.AlgebraicGeometry.Spaces.VectorBundle.ZeroLocusChart

/-!
# The zero section of a line bundle is a relative effective Cartier divisor

Let `W` be an algebraic space over a scheme `S` in a big fppf site and `ℰ` a finite locally free
`𝒪_W`-module, with vector bundle `p : E = \underline{Spec}_W(Sym(ℰ)) ⟶ W` and zero section
`o : W ⟶ E`. Over an affine chart `V` of `W` the zero section of `E ×_W V = Spec Γ(V, Sym(ℰ))` is
the closed subscheme cut out by the kernel of the augmentation `Γ(V, Sym(ℰ)) ⟶ Γ(V, 𝒪)`. When `ℰ`
has rank one and `V` trivializes it, the sections of `Sym(ℰ)` are a polynomial ring `Γ(V, 𝒪)[T]`
and the kernel is generated by the nonzerodivisor `T - c` for some `c`. So `o(W) ⊆ E` is an
effective Cartier divisor (Stacks 083C), and since `o(W) ⟶ W` is an isomorphism it is a relative
effective Cartier divisor on `E/W` (Stacks 0EPP), which is what Stacks 0ERH uses.

## Main results

* `AlgebraicGeometry.Space.ker_toScheme_map_vectorBundleChartZeroSection`: over an affine chart
  the kernel of the chart zero section is the kernel of the augmentation.
* `AlgebraicGeometry.Space.exists_isRegular_ker_chartAugmentation_eq_span`: in rank one the
  kernel of the augmentation is generated by a nonzerodivisor.
* `AlgebraicGeometry.Space.isEffectiveCartierDivisor_vectorBundleZeroLocus`: in rank one the
  zero locus is an effective Cartier divisor.
* `AlgebraicGeometry.Space.isFlat_vectorBundleZeroLocus_ι_comp`: the zero locus is flat over `W`,
  being isomorphic to it.
* `AlgebraicGeometry.Space.isRelativeEffectiveCartierDivisor_vectorBundleZeroLocus`: in rank one
  the zero locus is a relative effective Cartier divisor on `E/W`.

## References

* [Stacks Project, Tag 0ERH](https://stacks.math.columbia.edu/tag/0ERH)
* [Stacks Project, Tag 083C](https://stacks.math.columbia.edu/tag/083C)
* [Stacks Project, Tag 0EPP](https://stacks.math.columbia.edu/tag/0EPP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (W : AlgebraicSpaces B S hS)
  (F : SheafOfModules.{u} (structureRingSheaf B S hS W))
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree F]

section Chart

variable (V : SmallEtale B S hS W.1) [IsAffine (chartScheme V)]

/-- The chart `E ×_W V = Spec Γ(V, Sym(ℰ))` of the vector bundle over an affine chart `V` of `W`
is affine. -/
instance isAffine_vectorBundleChart :
    IsAffine ((BigFppfOver.toScheme B S hS).obj (vectorBundleChart B S hS W F V)) :=
  inferInstanceAs (IsAffine (Spec ((symmetricAlgebraSheaf B S hS W F).right.obj.obj (op V))))

/-- The augmentation `Γ(V, Sym(ℰ)) ⟶ Γ(V, 𝒪)` is surjective. -/
theorem surjective_chartAugmentation :
    Function.Surjective (chartAugmentation B S hS W F V) := fun r =>
  ⟨chartAlgebraMap B S hS (symmetricAlgebraSheaf B S hS W F) V r,
    ConcreteCategory.congr_hom (chartAlgebraMap_comp_chartAugmentation B S hS W F V) r⟩

/-- The zero section of the chart `E ×_W V` over an affine chart `V` of `W` is a closed
immersion. -/
instance isClosedImmersion_toScheme_map_vectorBundleChartZeroSection :
    _root_.AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map
      (vectorBundleChartZeroSection B S hS W F V)) := by
  rw [toScheme_map_vectorBundleChartZeroSection]
  have := _root_.AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
    (chartAugmentation B S hS W F V) (surjective_chartAugmentation B S hS W F V)
  infer_instance

/-- **The kernel of the chart zero section** is the ideal sheaf of the kernel of the
augmentation `Γ(V, Sym(ℰ)) ⟶ Γ(V, 𝒪)`. -/
theorem ker_toScheme_map_vectorBundleChartZeroSection :
    ((BigFppfOver.toScheme B S hS).map (vectorBundleChartZeroSection B S hS W F V)).ker =
      Scheme.IdealSheafData.ofIdealTop (Ideal.map
        (Scheme.ΓSpecIso ((symmetricAlgebraSheaf B S hS W F).right.obj.obj (op V))).inv.hom
        (RingHom.ker (chartAugmentation B S hS W F V).hom)) := by
  rw [Scheme.ker_of_isAffine]
  congr 1
  set e := (Scheme.ΓSpecIso ((symmetricAlgebraSheaf B S hS W F).right.obj.obj (op V)))
  have h : ((BigFppfOver.toScheme B S hS).map (vectorBundleChartZeroSection B S hS W F V)).appTop =
      e.hom ≫ chartAugmentation B S hS W F V := by
    rw [← ΓSpecIso_inv_comp_appTop_vectorBundleChartZeroSection, Iso.hom_inv_id_assoc]
  rw [h, CommRingCat.hom_comp, ← RingHom.comap_ker]
  exact (Ideal.map_comap_of_equiv e.commRingCatIsoToRingEquiv.symm).symm.trans rfl

variable {ι : Type u} [Finite ι]

/-- **In rank one the kernel of the augmentation is principal on a nonzerodivisor.** Over an
affine chart on which `ℰ` is free of rank one, `Γ(V, Sym(ℰ)) ≅ Γ(V, 𝒪)[T]` and the augmentation
is evaluation at some `c ∈ Γ(V, 𝒪)`, whose kernel is generated by the monic `T - c`. -/
theorem exists_isRegular_ker_chartAugmentation_eq_span
    (e : F.over V ≅ SheafOfModules.free (R := (structureRingSheaf B S hS W).over V) ι)
    (ε : ι ≃ Fin 1) :
    ∃ f : (symmetricAlgebraSheaf B S hS W F).right.obj.obj (op V), _root_.IsRegular f ∧
      RingHom.ker (chartAugmentation B S hS W F V).hom = Ideal.span {f} := by
  classical
  let R : CommRingCat.{u} := Γ(chartScheme V, ⊤)
  let ε' : ι ≃ PUnit.{u + 1} := ε.trans (Equiv.equivPUnit (Fin 1))
  let Φ : Polynomial R ≃+* (symmetricAlgebraSheaf B S hS W F).right.obj.obj (op V) :=
    (MvPolynomial.uniqueAlgEquiv R PUnit).symm.toRingEquiv.trans
      ((MvPolynomial.renameEquiv R ε'.symm).toRingEquiv.trans
        (polynomialChartRingEquiv B S hS W F V e))
  have hΦC : ∀ r, Φ (Polynomial.C r) =
      (symmetricAlgebraSheaf B S hS W F).algebraMap (op V) r := by
    intro r
    have h1 :
        (MvPolynomial.uniqueAlgEquiv R PUnit).symm (Polynomial.C r) = MvPolynomial.C r :=
      (MvPolynomial.uniqueAlgEquiv R PUnit).symm.commutes r
    show polynomialChartRingEquiv B S hS W F V e
      (MvPolynomial.rename ε'.symm
        ((MvPolynomial.uniqueAlgEquiv R PUnit).symm (Polynomial.C r))) = _
    rw [h1, MvPolynomial.rename_C]
    exact polynomialChartRingEquiv_C B S hS W F V e r
  let ψ : Polynomial R →+* R := (chartAugmentation B S hS W F V).hom.comp Φ.toRingHom
  have hψC : ∀ r, ψ (Polynomial.C r) = r := by
    intro r
    show (chartAugmentation B S hS W F V).hom (Φ (Polynomial.C r)) = r
    rw [hΦC]
    exact ConcreteCategory.congr_hom (chartAlgebraMap_comp_chartAugmentation B S hS W F V) r
  set c := ψ Polynomial.X
  have hψ : ψ = Polynomial.evalRingHom c := by
    refine Polynomial.ringHom_ext (fun r => ?_) ?_
    · rw [hψC, Polynomial.coe_evalRingHom, Polynomial.eval_C]
    · rw [Polynomial.coe_evalRingHom, Polynomial.eval_X]
  refine ⟨Φ (Polynomial.X - Polynomial.C c),
    Stacks.Divisors.isRegular_ringEquiv Φ (Polynomial.monic_X_sub_C c).isRegular, ?_⟩
  have hker : RingHom.ker ψ = Ideal.span {Polynomial.X - Polynomial.C c} := by
    rw [hψ, Polynomial.ker_evalRingHom]
  have hε : (chartAugmentation B S hS W F V).hom = ψ.comp Φ.symm.toRingHom := by
    ext a
    show _ = (chartAugmentation B S hS W F V).hom (Φ (Φ.symm a))
    rw [RingEquiv.apply_symm_apply]
  rw [hε, ← RingHom.comap_ker, hker]
  show Ideal.comap Φ.symm _ = _
  rw [Ideal.comap_symm, Ideal.map_span, Set.image_singleton]

/-- **In rank one the zero section of a trivialized chart is an effective Cartier divisor.** -/
theorem isEffectiveCartierDivisor_ker_toScheme_map_vectorBundleChartZeroSection
    (e : F.over V ≅ SheafOfModules.free (R := (structureRingSheaf B S hS W).over V) ι)
    (ε : ι ≃ Fin 1) :
    Stacks.Divisors.IsEffectiveCartierDivisor
      ((BigFppfOver.toScheme B S hS).map (vectorBundleChartZeroSection B S hS W F V)).ker := by
  obtain ⟨f, hf, hker⟩ := exists_isRegular_ker_chartAugmentation_eq_span B S hS W F V e ε
  rw [ker_toScheme_map_vectorBundleChartZeroSection, hker, Ideal.map_span, Set.image_singleton]
  exact Stacks.Divisors.isEffectiveCartierDivisor_ofIdealTop_span _
    (Stacks.Divisors.isRegular_ringEquiv
      (Scheme.ΓSpecIso ((symmetricAlgebraSheaf B S hS W F).right.obj.obj
        (op V))).symm.commRingCatIsoToRingEquiv hf)

end Chart

/-- **The zero section of a line bundle is an effective Cartier divisor.** When `ℰ` is finite
locally free of rank one, the zero locus `o(W) ⊆ E` is an effective Cartier divisor: on the
fibre product with an affine chart trivializing `ℰ` it is cut out by a nonzerodivisor
(Stacks 083C). -/
theorem isEffectiveCartierDivisor_vectorBundleZeroLocus
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank F 1] :
    IsEffectiveCartierDivisor B S hS (vectorBundle B S hS W F).obj.left
      (vectorBundleZeroLocus B S hS W F) := by
  classical
  refine isEffectiveCartierDivisor_of_hasEffectiveCartierEtalePullbacks B S hS _ _
    (hasEffectiveCartierEtalePullbacks_of_pointwise_charts B S hS _ _ fun x => ?_)
  obtain ⟨V, ι, hι, e, ε, z, hV, hz⟩ := exists_trivializing_affine_chart_of_rank B S hS W F 1
    (pointsMap B S hS _ (vectorBundleProjection B S hS W F).hom x)
  have : IsAffine (chartScheme V) := hV
  have sq := (isPullback_vectorBundleChart B S hS W F V).flip
  rw [chartSchemeToPoints_eq_pointsMap_pointsEquivScheme_symm] at hz
  have := Fintype.ofFinite ι
  obtain ⟨w, -, hw⟩ := exists_point_of_isPullback_presheaf B S hS sq _ x hz
  refine ⟨vectorBundleChart B S hS W F V, vectorBundleChartToTotal B S hS W F V, w,
    isEtale_of_isPullback_yoneda B S hS sq (isEtale_of_presheaf_etale B S hS V.property), hw, ?_⟩
  exact ⟨_, V.obj.left, vectorBundleChartZeroSection B S hS W F V,
    Stacks.Divisors.closedImmersionKerIso _,
    isEffectiveCartierDivisor_ker_toScheme_map_vectorBundleChartZeroSection B S hS W F V e ε,
    Stacks.Divisors.closedImmersion_eq_kerIso_comp _, preimage_vectorBundleZeroLocus B S hS W F V⟩

/-- **The zero locus is isomorphic to `W`**, through the zero section corestricted to its image,
with inverse the restriction of the projection. -/
def vectorBundleZeroLocusIso :
    W.1 ≅ (Subfunctor.range (vectorBundleZeroSection B S hS W F).hom).toFunctor where
  hom := Subfunctor.toRange (vectorBundleZeroSection B S hS W F).hom
  inv := (Subfunctor.range (vectorBundleZeroSection B S hS W F).hom).ι ≫
    (vectorBundleProjection B S hS W F).hom
  hom_inv_id := by
    rw [← Category.assoc, Subfunctor.toRange_ι]
    exact congrArg (fun f => f.hom) (vectorBundleZeroSection_comp_projection B S hS W F)
  inv_hom_id := by
    ext U ⟨x, w, rfl⟩
    refine Subtype.ext ?_
    change (vectorBundleZeroSection B S hS W F).hom.app U
        ((vectorBundleProjection B S hS W F).hom.app U
          ((vectorBundleZeroSection B S hS W F).hom.app U w)) =
      (vectorBundleZeroSection B S hS W F).hom.app U w
    have h := congrArg (fun f => f.hom.app U w)
      (vectorBundleZeroSection_comp_projection B S hS W F)
    exact congrArg ((vectorBundleZeroSection B S hS W F).hom.app U) h

/-- **The zero locus is flat over `W`**: its structure morphism `o(W) ⟶ W` is an isomorphism. -/
theorem isFlat_vectorBundleZeroLocus_ι_comp :
    IsFlat B S hS ((vectorBundleZeroLocus B S hS W F).1.ι ≫
      (vectorBundleProjection B S hS W F).hom) := by
  have _ := holdsOnEveryEtaleChart_respectsIso_presheaf B S hS (@Flat)
  have h := MorphismProperty.RespectsIso.precomp
    (fun ⦃F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u⦄ (f : F ⟶ G) =>
      HoldsOnEveryEtaleChart B S hS (@Flat) f) (vectorBundleZeroLocusIso B S hS W F).inv (𝟙 W.1)
    (holdsOnEveryEtaleChart_id_presheaf B S hS (@Flat) (fun _ _ _ _ => inferInstance) W.1)
  rw [Category.comp_id] at h
  exact h

/-- **The zero section of a line bundle is a relative effective Cartier divisor on `E/W`**
(Stacks 0EPP): an effective Cartier divisor flat over `W`. This is the divisor `o(X) ⊆ L` of the
proof of Stacks 0ERH. -/
theorem isRelativeEffectiveCartierDivisor_vectorBundleZeroLocus
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank F 1] :
    IsRelativeEffectiveCartierDivisor B S hS (vectorBundleProjection B S hS W F)
      (vectorBundleZeroLocus B S hS W F) :=
  ⟨isEffectiveCartierDivisor_vectorBundleZeroLocus B S hS W F,
    isFlat_vectorBundleZeroLocus_ι_comp B S hS W F⟩

end AlgebraicGeometry.Space

end
