module

public import StacksFrontier.AlgebraicGeometry.Spaces.RingedSite
public import StacksFrontier.CategoryTheory.Sites.Modules.IdealSubsheafLocal

/-!
# The module `Iⁿ F` on an algebraic space

Let `I` be a sheaf of ideals and `F` a module on the small étale ringed site of an algebraic
space.  The product `Iⁿ F` is the submodule of `F` generated by the products of a section of the
`n`-th power of `I` with a section of `F`; it is a module on the same site, included in `F` by a
monomorphism, and the products decrease as the exponent grows.

## Main definitions

* `Stacks.Sites.idealPowSmul`: the product `Iⁿ · N` of a power of a sheaf of ideals with a
  submodule of a sheaf of modules on an arbitrary site.
* `AlgebraicGeometry.Space.idealPowSubmodule`: the submodule `Iⁿ F` of an `𝒪_F`-module `F`.
* `AlgebraicGeometry.Space.idealPowModule`: the same, as an `𝒪_F`-module in its own right.
* `AlgebraicGeometry.Space.idealPowModuleι`: its monomorphism into `F`.
* `AlgebraicGeometry.Space.idealPowModuleHomOfLE`: the inclusion `Iⁿ F ⟶ Iᵏ F` for `k ≤ n`.

## Main results

* `Stacks.Sites.idealPowSmul_zero` and `Stacks.Sites.idealPowSmul_one`: `I⁰ · N = N` and
  `I¹ · N = I · N`.
* `Stacks.Sites.idealPowSmul_antitone` and
  `AlgebraicGeometry.Space.idealPowSubmodule_antitone`: the products decrease as the exponent
  grows, so in particular `Iⁿ⁺¹ F ⊆ Iⁿ F`.
* `Stacks.Sites.idealSmul_idealPow_idealPow_le`: `Iᵏ · Iⁿ ⊆ Iᵏ⁺ⁿ`.
* `Stacks.Sites.idealPowSmul_idealPowSmul_le` and
  `AlgebraicGeometry.Space.idealPowSmul_idealPowSubmodule_le`: `Iᵏ · (Iⁿ · N) ⊆ Iᵏ⁺ⁿ · N`, the
  easy inclusion of the Artin–Rees identity.
* `Stacks.Sites.idealPowSmul_succ`: `Iⁿ⁺¹ · N = Iⁿ · (I · N)`.
* `Stacks.Sites.idealPowSmul_le_iff` and
  `AlgebraicGeometry.Space.idealPowSubmodule_le_iff`: the universal property of `Iⁿ · N`, as the
  smallest submodule with local membership whose sections over every object `X` contain
  `I(X)ⁿ · N(X)`.

## Implementation notes

The product is the composite of `Stacks.Sites.idealPow` and `Stacks.Sites.idealSmul`, both of
which are closures of an objectwise operation under local membership: a section of `Iⁿ F` is one
which is locally a combination of products of a section of `Iⁿ` with a section of `F`, and a
section of `Iⁿ` is one which is locally an `n`-fold product of sections of `I`.  Taking closures
rather than objectwise images means the construction applies to a module which is not
quasi-coherent.

`AlgebraicGeometry.Space.idealPowModule` and `AlgebraicGeometry.Space.idealPowModuleι` are
abbreviations, so that the submodule API of `SheafOfModules.Submodule` — in particular the
monomorphy of the inclusion — reaches them without unfolding, while
`AlgebraicGeometry.Space.idealPowSubmodule` is a definition because it is the object the
lattice-level lemmas are stated about.

## References

* [Stacks Project, Tag 0942](https://stacks.math.columbia.edu/tag/0942)
* [Stacks Project, Tag 07UK](https://stacks.math.columbia.edu/tag/07UK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe w v₁ u₁ u m

namespace Stacks.SheafOfModules

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{u}} {M : _root_.SheafOfModules.{w} R}

/-- Every section of a sheaf of modules lies in its largest submodule. -/
theorem mem_top_obj {X : Cᵒᵖ} (z : M.val.obj X) : z ∈ (⊤ : M.Submodule).obj X := by
  have h : (⊤ : M.Submodule).toSubmodule = ⊤ := toSubmodule_top
  have hz : z ∈ ((⊤ : M.Submodule).toSubmodule).obj X := by
    rw [h]
    exact Submodule.mem_top
  exact hz

end Stacks.SheafOfModules

namespace Stacks.Sites


variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}
  {O : Sheaf J CommRingCat.{u}}

/-- The ideal of sections of a sheaf of ideals over an object of the site, as an ideal of the
ring of sections of the sheaf of rings over which the modules are taken.

This is `Stacks.Sites.sectionIdeal` with the commutativity of the ring of sections forgotten,
which is the form in which it multiplies submodules of a sheaf of modules. -/
def ringSectionIdeal (I : IdealSubsheaf O) (X : Cᵒᵖ) :
    Ideal ((Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X) :=
  I.obj X

/-- Membership in the ideal of sections is membership in the sheaf of ideals. -/
theorem mem_ringSectionIdeal {I : IdealSubsheaf O} {X : Cᵒᵖ}
    {a : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X} :
    a ∈ ringSectionIdeal I X ↔ a ∈ I.obj X :=
  Iff.rfl

/-- **`Iᵏ · Iⁿ ⊆ Iᵏ⁺ⁿ`.**  A section of `Iᵏ` is only locally a `k`-fold product of sections of
`I`, so the inclusion is not objectwise and the local description of the closure is what gives
it. -/
theorem idealSmul_idealPow_idealPow_le (I : IdealSubsheaf O) (k n : ℕ) :
    idealSmul (idealPow I k) (idealPow I n) ≤ idealPow I (k + n) := by
  refine Stacks.SheafOfModules.sheafifySubmodule_le (presheafIdealSmul_le (idealPow I k) ?_)
  intro X a ha z hz
  obtain ⟨S₁, hS₁, ha⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule ha
  obtain ⟨S₂, hS₂, hz⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule hz
  refine Stacks.SheafOfModules.mem_sheafifySubmodule_of_mem
    (J.intersection_covering hS₁ hS₂) fun Y f hf => ?_
  have h1 : (ConcreteCategory.hom
        ((SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O)).val.map f.op)) (a • z)
      = (ConcreteCategory.hom (O.obj.map f.op)) a * (ConcreteCategory.hom (O.obj.map f.op)) z :=
    map_mul (ConcreteCategory.hom (O.obj.map f.op)) a z
  have h2 : sectionIdeal I (op Y) ^ (k + n)
      = sectionIdeal I (op Y) ^ k * sectionIdeal I (op Y) ^ n := pow_add _ _ _
  rw [h1]
  exact h2.ge (Ideal.mul_mem_mul (ha f hf.1) (hz f hf.2))

variable {M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)}

/-- The product `Iⁿ · N` of a power of a sheaf of ideals with a submodule of a sheaf of modules:
the smallest submodule with local membership containing every product of a section of `Iⁿ` with
a section of `N`. -/
noncomputable def idealPowSmul (I : IdealSubsheaf O) (n : ℕ) (N : M.Submodule) : M.Submodule :=
  idealSmul (idealPow I n) N

/-- The product `Iⁿ · N` is the product of the `n`-th power of `I` with `N`. -/
theorem idealPowSmul_eq_idealSmul (I : IdealSubsheaf O) (n : ℕ) (N : M.Submodule) :
    idealPowSmul I n N = idealSmul (idealPow I n) N :=
  rfl

/-- A product of a section of `Iⁿ` with a section of `N` is a section of `Iⁿ · N`. -/
theorem smul_mem_idealPowSmul (I : IdealSubsheaf O) {n : ℕ} {N : M.Submodule} {X : Cᵒᵖ}
    {a : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X} (ha : a ∈ (idealPow I n).obj X)
    {z : M.val.obj X} (hz : z ∈ N.obj X) : a • z ∈ (idealPowSmul I n N).obj X :=
  smul_mem_idealSmul (idealPow I n) ha hz

/-- A product of an `n`-fold product of sections of `I` with a section of `N` is a section of
`Iⁿ · N`. -/
theorem smul_mem_idealPowSmul_of_mem_pow (I : IdealSubsheaf O) (n : ℕ) {N : M.Submodule}
    {X : Cᵒᵖ} {a : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X}
    (ha : a ∈ sectionIdeal I X ^ n)
    {z : M.val.obj X} (hz : z ∈ N.obj X) : a • z ∈ (idealPowSmul I n N).obj X :=
  smul_mem_idealPowSmul I (mem_idealPow_of_mem_pow I n ha) hz

/-- **The universal property of `Iⁿ · N`.**  It is the smallest submodule with local membership
containing every product of a section of `Iⁿ` with a section of `N`. -/
theorem idealPowSmul_le (I : IdealSubsheaf O) (n : ℕ) {N P : M.Submodule}
    (h : ∀ (X : Cᵒᵖ) (a : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X),
      a ∈ (idealPow I n).obj X → ∀ z ∈ N.obj X, a • z ∈ P.obj X) :
    idealPowSmul I n N ≤ P :=
  Stacks.SheafOfModules.sheafifySubmodule_le (presheafIdealSmul_le (idealPow I n) h)

/-- `Iⁿ · N` is contained in `N`. -/
theorem idealPowSmul_le_self (I : IdealSubsheaf O) (n : ℕ) (N : M.Submodule) :
    idealPowSmul I n N ≤ N :=
  idealSmul_le (idealPow I n) N

/-- The sections of the objectwise product are the product of the ideals of sections. -/
theorem presheafIdealSmul_obj (I : IdealSubsheaf O) (N : M.val.Submodule) (X : Cᵒᵖ) :
    (presheafIdealSmul I N).obj X = ringSectionIdeal I X • N.obj X :=
  le_antisymm
    (Submodule.span_le.2 (by
      rintro z ⟨a, ha, w, hw, rfl⟩
      exact Submodule.smul_mem_smul ha hw))
    (Submodule.smul_le.2 fun _ ha _ hw => smul_mem_presheafIdealSmul I ha hw)

/-- The sections of `Iⁿ · N` over an object contain the product of the `n`-th power of the ideal
of sections of `I` with the sections of `N`. -/
theorem pow_smul_le_idealPowSmul (I : IdealSubsheaf O) (n : ℕ) (N : M.Submodule) (X : Cᵒᵖ) :
    ringSectionIdeal I X ^ n • N.obj X ≤ (idealPowSmul I n N).obj X :=
  Submodule.smul_le.2 fun _ ha _ hz => smul_mem_idealPowSmul_of_mem_pow I n ha hz

/-- A section is a section of a submodule with local membership if its product with a section of
`Iⁿ` has restrictions in it whenever the restricted factor lies in the `n`-th power of the ideal
of sections. -/
private theorem smul_mem_of_forall_map_smul_mem (I : IdealSubsheaf O) (n : ℕ) {P : M.Submodule}
    {X : Cᵒᵖ} {a : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X}
    (ha : a ∈ (idealPow I n).obj X) {z : M.val.obj X}
    (h : ∀ {Y : C} (f : Y ⟶ X.unop),
      (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map f.op a ∈ sectionIdeal I (op Y) ^ n →
      (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map f.op a • M.val.map f.op z ∈
        P.obj (op Y)) :
    a • z ∈ P.obj X := by
  obtain ⟨S, hS, ha⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule ha
  refine P.isSheaf _ (J.superset_covering (fun Y f hf => ?_) hS)
  change M.val.map f.op (a • z) ∈ P.obj (op Y)
  rw [M.val.map_smul]
  exact h f (ha f hf)

/-- **`Iⁿ · N` is the smallest submodule with local membership whose sections over every object
`X` contain `I(X)ⁿ · N(X)`.**

This is the form in which the Artin–Rees statements use the product: a section lies in `Iⁿ · N`
exactly when it does so locally, so testing against an objectwise condition suffices. -/
theorem idealPowSmul_le_iff (I : IdealSubsheaf O) (n : ℕ) (N P : M.Submodule) :
    idealPowSmul I n N ≤ P ↔ ∀ X : Cᵒᵖ, ringSectionIdeal I X ^ n • N.obj X ≤ P.obj X := by
  refine ⟨fun h X => (pow_smul_le_idealPowSmul I n N X).trans
    (_root_.SheafOfModules.Submodule.le_iff.1 h X), fun h => ?_⟩
  exact idealPowSmul_le I n fun X a ha z hz =>
    smul_mem_of_forall_map_smul_mem I n ha fun f hf =>
      h (op _) (Submodule.smul_mem_smul hf (N.map_mem f.op hz))

/-- The product of a sheaf of ideals with the closure of an objectwise submodule lands in the
closure of the objectwise product.

A section of the closure restricts into the objectwise submodule along a covering sieve, and
multiplying by a section of the sheaf of ideals preserves that. -/
theorem idealSmul_sheafifySubmodule_le (K : IdealSubsheaf O) (L : M.val.Submodule) :
    idealSmul K (Stacks.SheafOfModules.sheafifySubmodule L) ≤
      Stacks.SheafOfModules.sheafifySubmodule (presheafIdealSmul K L) := by
  refine Stacks.SheafOfModules.sheafifySubmodule_le (presheafIdealSmul_le K ?_)
  intro X a ha z hz
  obtain ⟨S, hS, hz⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule hz
  refine Stacks.SheafOfModules.mem_sheafifySubmodule_of_mem hS fun Y f hf => ?_
  rw [M.val.map_smul]
  exact smul_mem_presheafIdealSmul K (K.map_mem f.op ha) (hz f hf)

/-- The ideal of sections of `Iᵏ` times the ideal of sections of `Iⁿ` lands in the ideal of
sections of `Iᵏ⁺ⁿ`. -/
theorem ringSectionIdeal_idealPow_smul_le (I : IdealSubsheaf O) (k n : ℕ) (X : Cᵒᵖ) :
    ringSectionIdeal (idealPow I k) X • ringSectionIdeal (idealPow I n) X ≤
      ringSectionIdeal (idealPow I (k + n)) X :=
  Submodule.smul_le.2 fun _ ha _ hz =>
    _root_.SheafOfModules.Submodule.le_iff.1 (idealSmul_idealPow_idealPow_le I k n) X
      (smul_mem_idealSmul (idealPow I k) ha hz)

/-- **`Iᵏ · (Iⁿ · N) ⊆ Iᵏ⁺ⁿ · N`**, the easy inclusion of the Artin–Rees identity.

A section of `Iⁿ · N` is locally a combination of products of a section of `Iⁿ` with a section
of `N`, so multiplying by a section of `Iᵏ` gives, locally, a combination of products of a
section of `Iᵏ · Iⁿ` with a section of `N`; the first factor lies in `Iᵏ⁺ⁿ`. -/
theorem idealPowSmul_idealPowSmul_le (I : IdealSubsheaf O) (k n : ℕ) (N : M.Submodule) :
    idealPowSmul I k (idealPowSmul I n N) ≤ idealPowSmul I (k + n) N := by
  refine (idealSmul_sheafifySubmodule_le (idealPow I k)
    (presheafIdealSmul (idealPow I n) N.toSubmodule)).trans
    (Stacks.SheafOfModules.sheafifySubmodule_le fun X => ?_)
  rw [presheafIdealSmul_obj, presheafIdealSmul_obj, ← Submodule.smul_assoc]
  exact (Submodule.smul_mono_left (ringSectionIdeal_idealPow_smul_le I k n X)).trans
    ((presheafIdealSmul_obj (idealPow I (k + n)) N.toSubmodule X).ge.trans
      (Stacks.SheafOfModules.le_sheafifySubmodule _ X))

/-- `I⁰ · N` is `N`. -/
@[simp]
theorem idealPowSmul_zero (I : IdealSubsheaf O) (N : M.Submodule) : idealPowSmul I 0 N = N := by
  refine le_antisymm (idealPowSmul_le_self I 0 N)
    (_root_.SheafOfModules.Submodule.le_iff.2 fun X z hz => ?_)
  have h1 : (1 : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X) ∈ (idealPow I 0).obj X := by
    refine mem_idealPow_of_mem_pow I 0 ?_
    rw [pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  simpa only [one_smul] using smul_mem_idealPowSmul I h1 hz

/-- `I¹ · N` is `I · N`. -/
@[simp]
theorem idealPowSmul_one (I : IdealSubsheaf O) (N : M.Submodule) :
    idealPowSmul I 1 N = idealSmul I N := by
  rw [idealPowSmul_eq_idealSmul, idealPow_one]

/-- **`Iⁿ⁺¹ · N = Iⁿ · (I · N)`.**  Splitting off one factor of the ideal gives the same
submodule as multiplying by `Iⁿ⁺¹` at once.

A section of `Iⁿ⁺¹` is locally a sum of products of a section of `Iⁿ` with a section of `I`,
which is what splits the factor off; the reverse inclusion is the composition law. -/
theorem idealPowSmul_succ (I : IdealSubsheaf O) (n : ℕ) (N : M.Submodule) :
    idealPowSmul I (n + 1) N = idealPowSmul I n (idealSmul I N) := by
  refine le_antisymm (idealPowSmul_le I (n + 1) fun X a ha z hz => ?_) ?_
  · refine smul_mem_of_forall_map_smul_mem I (n + 1) ha fun f hf => ?_
    have hmem : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map f.op a
        ∈ ringSectionIdeal I _ ^ n * ringSectionIdeal I _ :=
      le_of_eq (Submodule.pow_succ (ringSectionIdeal I _)) hf
    refine Submodule.mul_induction_on hmem (fun d hd c hc => ?_) (fun x y hx hy => ?_)
    · rw [mul_smul]
      exact smul_mem_idealPowSmul_of_mem_pow I n hd
        (smul_mem_idealSmul I hc (N.map_mem f.op hz))
    · rw [add_smul]
      exact add_mem hx hy
  · have h := idealPowSmul_idealPowSmul_le I n 1 N
    rw [idealPowSmul_one] at h
    exact h

/-- **The products `Iⁿ · N` decrease as the exponent grows.** -/
theorem idealPowSmul_antitone (I : IdealSubsheaf O) (N : M.Submodule) {k n : ℕ} (h : k ≤ n) :
    idealPowSmul I n N ≤ idealPowSmul I k N :=
  idealSmul_mono_left (idealPow_antitone I h) N

/-- `Iⁿ⁺¹ · N` is contained in `Iⁿ · N`. -/
theorem idealPowSmul_succ_le (I : IdealSubsheaf O) (n : ℕ) (N : M.Submodule) :
    idealPowSmul I (n + 1) N ≤ idealPowSmul I n N :=
  idealPowSmul_antitone I N n.le_succ

/-- The product is monotone in the submodule. -/
theorem idealPowSmul_mono_right (I : IdealSubsheaf O) (n : ℕ) {N N' : M.Submodule} (h : N ≤ N') :
    idealPowSmul I n N ≤ idealPowSmul I n N' :=
  idealSmul_mono_right (idealPow I n) h

/-- The powers of a sheaf of ideals are monotone in the ideal. -/
theorem idealPow_mono_left {I I' : IdealSubsheaf O} (h : I ≤ I') (n : ℕ) :
    idealPow I n ≤ idealPow I' n := by
  refine Stacks.SheafOfModules.sheafifySubmodule_mono fun X => ?_
  have hX : sectionIdeal I X ≤ sectionIdeal I' X := _root_.SheafOfModules.Submodule.le_iff.1 h X
  have hpow : sectionIdeal I X ^ n ≤ sectionIdeal I' X ^ n := pow_le_pow_left' hX n
  exact hpow

/-- The product is monotone in the sheaf of ideals. -/
theorem idealPowSmul_mono_left {I I' : IdealSubsheaf O} (h : I ≤ I') (n : ℕ) (N : M.Submodule) :
    idealPowSmul I n N ≤ idealPowSmul I' n N :=
  idealSmul_mono_left (idealPow_mono_left h n) N

/-- The product with an intersection of submodules lands in the intersection of the
products. -/
theorem idealPowSmul_inf_le (I : IdealSubsheaf O) (n : ℕ) (N P : M.Submodule) :
    idealPowSmul I n (N ⊓ P) ≤ idealPowSmul I n N ⊓ idealPowSmul I n P :=
  le_inf (idealPowSmul_mono_right I n inf_le_left) (idealPowSmul_mono_right I n inf_le_right)

/-- The product `Iⁿ · N` meets a submodule of `N` inside that submodule. -/
theorem idealPowSmul_le_inf (I : IdealSubsheaf O) (n : ℕ) {N P : M.Submodule} (h : P ≤ N) :
    idealPowSmul I n P ≤ idealPowSmul I n N ⊓ P :=
  le_inf (idealPowSmul_mono_right I n h) (idealPowSmul_le_self I n P)

end Stacks.Sites

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-- The small étale ringed site of an algebraic space composes the sheaf condition with the
forgetful functor from commutative rings to rings, as every ringed site does. -/
instance hasSheafCompose_forget₂_ringCat_smallEtaleRingedSite :
    (smallEtaleRingedSite B S hS F hF).J.HasSheafCompose
      (forget₂ CommRingCat.{u} RingCat.{u}) :=
  (smallEtaleRingedSite B S hS F hF).hasSheafCompose_forget₂_ringCat

/-- Sheaves of ideals `I ⊆ 𝒪_F` on an algebraic space: submodules with local membership of the
structure sheaf read as a module over itself. -/
abbrev IdealSheaves :=
  Stacks.Sites.IdealSubsheaf.{u, u + 1, u} (smallEtaleRingedSite B S hS F hF).O

variable {B S hS F hF}

/-- **The submodule `Iⁿ F` of an `𝒪_F`-module `F`**: the smallest submodule with local membership
containing every product of a section of `Iⁿ` with a section of `F`. -/
noncomputable def idealPowSubmodule (I : IdealSheaves B S hS F hF) (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) : M.Submodule :=
  Stacks.Sites.idealPowSmul (M := M) I n ⊤

/-- `Iⁿ F` is the product of the `n`-th power of `I` with all of `F`. -/
theorem idealPowSubmodule_eq_idealPowSmul (I : IdealSheaves B S hS F hF) (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) :
    idealPowSubmodule I n M = Stacks.Sites.idealPowSmul (M := M) I n ⊤ :=
  rfl

/-- A product of a section of `Iⁿ` with a section of `F` is a section of `Iⁿ F`. -/
theorem smul_mem_idealPowSubmodule (I : IdealSheaves B S hS F hF) {n : ℕ}
    {M : Modules.{u, m} B S hS F hF} {X : (smallEtaleRingedSite B S hS F hF).Cᵒᵖ}
    {a : ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).obj.obj X}
    (ha : a ∈ (Stacks.Sites.idealPow I n).obj X) (z : M.val.obj X) :
    a • z ∈ (idealPowSubmodule I n M).obj X :=
  Stacks.Sites.smul_mem_idealPowSmul I ha (Stacks.SheafOfModules.mem_top_obj z)

/-- A product of an `n`-fold product of sections of `I` with a section of `F` is a section of
`Iⁿ F`. -/
theorem smul_mem_idealPowSubmodule_of_mem_pow (I : IdealSheaves B S hS F hF) (n : ℕ)
    {M : Modules.{u, m} B S hS F hF} {X : (smallEtaleRingedSite B S hS F hF).Cᵒᵖ}
    {a : ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).obj.obj X}
    (ha : a ∈ Stacks.Sites.sectionIdeal I X ^ n) (z : M.val.obj X) :
    a • z ∈ (idealPowSubmodule I n M).obj X :=
  smul_mem_idealPowSubmodule I (Stacks.Sites.mem_idealPow_of_mem_pow I n ha) z

/-- **The universal property of `Iⁿ F`.**  It is the smallest submodule with local membership
containing every product of a section of `Iⁿ` with a section of `F`. -/
theorem idealPowSubmodule_le (I : IdealSheaves B S hS F hF) (n : ℕ)
    {M : Modules.{u, m} B S hS F hF} {P : M.Submodule}
    (h : ∀ (X : (smallEtaleRingedSite B S hS F hF).Cᵒᵖ)
      (a : ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).obj.obj X),
      a ∈ (Stacks.Sites.idealPow I n).obj X → ∀ z : M.val.obj X, a • z ∈ P.obj X) :
    idealPowSubmodule I n M ≤ P :=
  Stacks.Sites.idealPowSmul_le (N := (⊤ : M.Submodule)) I n fun X a ha z _ => h X a ha z

/-- `I⁰ F` is all of `F`. -/
@[simp]
theorem idealPowSubmodule_zero (I : IdealSheaves B S hS F hF)
    (M : Modules.{u, m} B S hS F hF) : idealPowSubmodule I 0 M = ⊤ :=
  Stacks.Sites.idealPowSmul_zero I (⊤ : M.Submodule)

/-- `I¹ F` is `I F`. -/
@[simp]
theorem idealPowSubmodule_one (I : IdealSheaves B S hS F hF)
    (M : Modules.{u, m} B S hS F hF) :
    idealPowSubmodule I 1 M = Stacks.Sites.idealSmul I ⊤ :=
  Stacks.Sites.idealPowSmul_one I (⊤ : M.Submodule)

/-- **`Iⁿ F` decreases as the exponent grows.** -/
theorem idealPowSubmodule_antitone (I : IdealSheaves B S hS F hF)
    (M : Modules.{u, m} B S hS F hF) {k n : ℕ} (h : k ≤ n) :
    idealPowSubmodule I n M ≤ idealPowSubmodule I k M :=
  Stacks.Sites.idealPowSmul_antitone I (⊤ : M.Submodule) h

/-- **`Iⁿ⁺¹ F ⊆ Iⁿ F`.** -/
theorem idealPowSubmodule_succ_le (I : IdealSheaves B S hS F hF) (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) :
    idealPowSubmodule I (n + 1) M ≤ idealPowSubmodule I n M :=
  idealPowSubmodule_antitone I M n.le_succ

/-- **`Iⁿ F` is the smallest submodule with local membership whose sections over every étale
chart `X` contain `I(X)ⁿ · F(X)`.** -/
theorem idealPowSubmodule_le_iff (I : IdealSheaves B S hS F hF) (n : ℕ)
    {M : Modules.{u, m} B S hS F hF} (P : M.Submodule) :
    idealPowSubmodule I n M ≤ P ↔
      ∀ X : (smallEtaleRingedSite B S hS F hF).Cᵒᵖ,
        Stacks.Sites.ringSectionIdeal I X ^ n • (⊤ : Submodule _ (M.val.obj X)) ≤ P.obj X := by
  refine (Stacks.Sites.idealPowSmul_le_iff I n (⊤ : M.Submodule) P).trans
    (forall_congr' fun X => ?_)
  rw [show ((⊤ : M.Submodule).obj X) = (⊤ : Submodule _ (M.val.obj X)) from
    SetLike.ext fun z => ⟨fun _ => Submodule.mem_top,
      fun _ => Stacks.SheafOfModules.mem_top_obj z⟩]

/-- `Iⁿ F` is monotone in the sheaf of ideals. -/
theorem idealPowSubmodule_mono_left {I I' : IdealSheaves B S hS F hF} (h : I ≤ I') (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) :
    idealPowSubmodule I n M ≤ idealPowSubmodule I' n M :=
  Stacks.Sites.idealPowSmul_mono_left h n (⊤ : M.Submodule)

/-- `Iⁿ F` meets a submodule of `F` inside that submodule. -/
theorem idealPowSubmodule_inf_le (I : IdealSheaves B S hS F hF) (n : ℕ)
    {M : Modules.{u, m} B S hS F hF} (P : M.Submodule) :
    Stacks.Sites.idealPowSmul I n P ≤ idealPowSubmodule I n M ⊓ P :=
  le_inf (Stacks.Sites.idealPowSmul_mono_right I n le_top)
    (Stacks.Sites.idealPowSmul_le_self I n P)

/-- **`Iᵏ · (Iⁿ F) ⊆ Iᵏ⁺ⁿ F`**, the easy inclusion of the Artin–Rees identity. -/
theorem idealPowSmul_idealPowSubmodule_le (I : IdealSheaves B S hS F hF) (k n : ℕ)
    (M : Modules.{u, m} B S hS F hF) :
    Stacks.Sites.idealPowSmul I k (idealPowSubmodule I n M) ≤ idealPowSubmodule I (k + n) M :=
  Stacks.Sites.idealPowSmul_idealPowSmul_le I k n (⊤ : M.Submodule)

/-- **The module `Iⁿ F`**, as an `𝒪_F`-module in its own right. -/
noncomputable abbrev idealPowModule (I : IdealSheaves B S hS F hF) (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) : Modules.{u, m} B S hS F hF :=
  (idealPowSubmodule I n M).toSheafOfModules

/-- **The inclusion `Iⁿ F ⟶ F`**, a monomorphism of `𝒪_F`-modules. -/
noncomputable abbrev idealPowModuleι (I : IdealSheaves B S hS F hF) (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) : idealPowModule I n M ⟶ M :=
  (idealPowSubmodule I n M).ι

/-- **The inclusion `Iⁿ F ⟶ Iᵏ F` for `k ≤ n`.** -/
noncomputable abbrev idealPowModuleHomOfLE (I : IdealSheaves B S hS F hF)
    (M : Modules.{u, m} B S hS F hF) {k n : ℕ} (h : k ≤ n) :
    idealPowModule I n M ⟶ idealPowModule I k M :=
  Stacks.SheafOfModules.Submodule.homOfLE (idealPowSubmodule_antitone I M h)

/-- **The inclusion `Iⁿ⁺¹ F ⟶ Iⁿ F`.** -/
noncomputable abbrev idealPowModuleSuccHom (I : IdealSheaves B S hS F hF) (n : ℕ)
    (M : Modules.{u, m} B S hS F hF) :
    idealPowModule I (n + 1) M ⟶ idealPowModule I n M :=
  idealPowModuleHomOfLE I M n.le_succ

/-- The inclusion of `Iⁿ F` into `Iᵏ F`, followed by the inclusion of `Iᵏ F` into `F`, is the
inclusion of `Iⁿ F` into `F`. -/
theorem idealPowModuleHomOfLE_comp_ι (I : IdealSheaves B S hS F hF)
    (M : Modules.{u, m} B S hS F hF) {k n : ℕ} (h : k ≤ n) :
    idealPowModuleHomOfLE I M h ≫ idealPowModuleι I k M = idealPowModuleι I n M :=
  Stacks.SheafOfModules.Submodule.homOfLE_comp_ι (idealPowSubmodule_antitone I M h)

end AlgebraicGeometry.Space

