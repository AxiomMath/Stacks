module

public import StacksFrontier.AlgebraicGeometry.Quot.RelativeHomLimitPreserving
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentation.Sheafify

/-!
# Limit preservation from a jointly locally surjective family

Let `G` be an fppf sheaf of sets on the big fppf site of a scheme `S`, and let `fᵢ : Fᵢ ⟶ G` be a
family of morphisms of presheaves which is jointly locally surjective: every section of `G` is,
locally on its domain, in the image of one of the `fᵢ`. If every `Fᵢ` and every fibre product
`Fᵢ ×_G Fⱼ` is limit preserving, then so is `G`.

## Main results

* `AlgebraicGeometry.limitPreserving_jointRange`: the subpresheaf of `G` generated by the images
  of a family of limit preserving presheaves along which lifts descend is limit preserving.
* `AlgebraicGeometry.exists_lift_of_isPullback`: lifts descend when the fibre products are
  limit preserving.
* `AlgebraicGeometry.limitPreserving_of_jointlyLocallySurjective` and
  `AlgebraicGeometry.limitPreserving_of_jointlyLocallySurjective_of_isPullback`: an fppf sheaf
  receiving a jointly locally surjective such family is limit preserving.

## References

* [Stacks Project, Tag 049J](https://stacks.math.columbia.edu/tag/049J)
* [Stacks Project, Tag 049O](https://stacks.math.columbia.edu/tag/049O)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w w' z z'

namespace AlgebraicGeometry

section General

variable {C : Type z} [Category.{z'} C] (toScheme : C ⥤ Scheme.{u})

/-- Let `fᵢ : Fᵢ ⟶ G` be morphisms of presheaves of sets with every `Fᵢ` limit preserving.
Suppose that whenever `V = lim Vₖ` is a cofiltered limit of affines and the restriction to `V`
of the image of a section `x' ∈ Fⱼ(Vₖ)` lifts to a section `x` of `Fᵢ` over `V`, the lift is the
restriction of a lift of `x'` defined over some later stage `Vₗ`. Then the subpresheaf of `G` of
sections in the image of one of the `fᵢ` is limit preserving. -/
theorem limitPreserving_jointRange {ι : Type*} {G : Cᵒᵖ ⥤ Type v} {F : ι → Cᵒᵖ ⥤ Type v}
    (f : ∀ i, F i ⟶ G) (hF : ∀ i, LimitPreserving.{u, v, w, w', z, z'} toScheme (F i))
    (hlift : ∀ (i j : ι) (I : Type (max w w')) [Category.{w'} I] [IsCofiltered I] (D : I ⥤ C)
      (c : Cone D), IsLimit (toScheme.mapCone c) → (∀ k, IsAffine (toScheme.obj (D.obj k))) →
      IsAffine (toScheme.obj c.pt) → ∀ (k : I) (x : (F i).obj (op c.pt))
      (x' : (F j).obj (op (D.obj k))),
      (f i).app _ x = G.map (c.π.app k).op ((f j).app _ x') →
      ∃ (l : I) (g : l ⟶ k) (y : (F i).obj (op (D.obj l))),
        (F i).map (c.π.app l).op y = x ∧ (f i).app _ y = G.map (D.map g).op ((f j).app _ x')) :
    LimitPreserving.{u, v, w, w', z, z'} toScheme
      (⨆ i, Subfunctor.range (f i)).toFunctor := by
  intro I _ _ D c hc hD hC
  have hmem : ∀ {U : Cᵒᵖ} (s : G.obj U),
      s ∈ (⨆ i, Subfunctor.range (f i)).obj U ↔ ∃ (i : ι) (x : (F i).obj U), (f i).app U x = s :=
    fun s => by simp [Subfunctor.iSup_obj]
  have hFc : ∀ i, IsColimit ((F i).mapCocone c.op) := fun i => (hF i I D c hc hD hC).some
  refine nonempty_isColimit_mapCocone_of_exists_of_eventually_eq _ D c ?_ ?_
  · intro s
    obtain ⟨i, x, hx⟩ := (hmem s.1).1 s.2
    obtain ⟨j, y, rfl⟩ := exists_eq_map_of_isColimit_mapCocone (F i) D c (hFc i) x
    refine ⟨j, ⟨(f i).app _ y, (hmem _).2 ⟨i, y, rfl⟩⟩, Subtype.ext ?_⟩
    change G.map (c.π.app j).op ((f i).app _ y) = s.1
    rw [← hx]
    exact (NatTrans.naturality_apply (f i) _ y).symm
  · intro k a b hab
    obtain ⟨i, x, hx⟩ := (hmem a.1).1 a.2
    obtain ⟨j, x', hx'⟩ := (hmem b.1).1 b.2
    have hab' : G.map (c.π.app k).op a.1 = G.map (c.π.app k).op b.1 := congrArg Subtype.val hab
    obtain ⟨l, g, y, hy, hfy⟩ := hlift i j I D c hc hD hC k ((F i).map (c.π.app k).op x) x'
      (by rw [NatTrans.naturality_apply, hx, hx', hab'])
    obtain ⟨m, gm, hm⟩ := eventually_eq_of_isColimit_mapCocone (F i) D c (hFc i) l
      y ((F i).map (D.map g).op x) (by
        rw [hy, ← Functor.map_comp_apply, ← op_comp, c.w])
    refine ⟨m, gm ≫ g, Subtype.ext ?_⟩
    change G.map (D.map (gm ≫ g)).op a.1 = G.map (D.map (gm ≫ g)).op b.1
    rw [← hx, ← hx', D.map_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply,
      ← NatTrans.naturality_apply, ← NatTrans.naturality_apply, ← hm, NatTrans.naturality_apply,
      hfy]

/-- Let `fᵢ : Fᵢ ⟶ G` and `fⱼ : Fⱼ ⟶ G` be morphisms of presheaves of sets with `Fⱼ` limit
preserving, and let `P = Fᵢ ×_G Fⱼ` be a fibre product which is limit preserving. If
`V = lim Vₖ` is a cofiltered limit of affines and the image of a section `x' ∈ Fⱼ(Vₖ)`,
restricted to `V`, lifts to `x ∈ Fᵢ(V)`, then `x` is the restriction of a lift of `x'` over a
later stage. -/
theorem exists_lift_of_isPullback {G Fi Fj P : Cᵒᵖ ⥤ Type v} {fi : Fi ⟶ G} {fj : Fj ⟶ G}
    {p₁ : P ⟶ Fi} {p₂ : P ⟶ Fj} (hP : IsPullback p₁ p₂ fi fj)
    (hFj : LimitPreserving.{u, v, w, w', z, z'} toScheme Fj)
    (hPl : LimitPreserving.{u, v, w, w', z, z'} toScheme P)
    {I : Type (max w w')} [Category.{w'} I] [IsCofiltered I] (D : I ⥤ C) (c : Cone D)
    (hc : IsLimit (toScheme.mapCone c)) (hD : ∀ k, IsAffine (toScheme.obj (D.obj k)))
    (hC : IsAffine (toScheme.obj c.pt)) (k : I) (x : Fi.obj (op c.pt))
    (x' : Fj.obj (op (D.obj k))) (hx : fi.app _ x = G.map (c.π.app k).op (fj.app _ x')) :
    ∃ (l : I) (g : l ⟶ k) (y : Fi.obj (op (D.obj l))),
      Fi.map (c.π.app l).op y = x ∧ fi.app _ y = G.map (D.map g).op (fj.app _ x') := by
  have hPV := hP.map ((evaluation _ _).obj (op c.pt))
  obtain ⟨r, hr₁, hr₂⟩ := Types.exists_of_isPullback hPV x (Fj.map (c.π.app k).op x') (by
    change fi.app (op c.pt) x = fj.app (op c.pt) (Fj.map (c.π.app k).op x')
    rw [NatTrans.naturality_apply, hx])
  obtain ⟨l₀, r', rfl⟩ := exists_eq_map_of_isColimit_mapCocone P D c (hPl I D c hc hD hC).some r
  let l₁ := IsCofiltered.min k l₀
  let gk : l₁ ⟶ k := IsCofiltered.minToLeft k l₀
  let g₀ : l₁ ⟶ l₀ := IsCofiltered.minToRight k l₀
  obtain ⟨l, gl, hl⟩ := eventually_eq_of_isColimit_mapCocone Fj D c (hFj I D c hc hD hC).some l₁
    (Fj.map (D.map g₀).op (p₂.app _ r')) (Fj.map (D.map gk).op x') (by
      rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, c.w, c.w,
        ← NatTrans.naturality_apply]
      exact hr₂)
  refine ⟨l, gl ≫ gk, Fi.map (D.map (gl ≫ g₀)).op (p₁.app _ r'), ?_, ?_⟩
  · rw [← Functor.map_comp_apply, ← op_comp, c.w, ← NatTrans.naturality_apply]
    exact hr₁
  · have hw := congrArg (fun φ => φ.app (op (D.obj l₀)) r') hP.w
    simp only [NatTrans.comp_app_apply] at hw
    rw [NatTrans.naturality_apply, hw, ← NatTrans.naturality_apply, D.map_comp, op_comp,
      Functor.map_comp_apply, hl, ← Functor.map_comp_apply, ← op_comp, ← D.map_comp,
      NatTrans.naturality_apply]

end General

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Let `G` be an fppf sheaf of sets on the big fppf site of `S` and let `fᵢ : Fᵢ ⟶ G` be a
family of morphisms of presheaves such that every section of `G` lies, after restriction along
the arrows of some fppf covering sieve, in the image of one of the `fᵢ`. Suppose every `Fᵢ` is
limit preserving and that lifts along the family descend: if `V = lim Vₖ` is a cofiltered limit
of affines and the image of `x' ∈ Fⱼ(Vₖ)` restricted to `V` lifts to `x ∈ Fᵢ(V)`, then `x` is the
restriction of a lift of `x'` over a later stage. Then `G` is limit preserving. -/
theorem limitPreserving_of_jointlyLocallySurjective [UnivLE.{max w w', u}] {ι : Type*}
    {G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type v} {F : ι → (BigFppfOver B S hS)ᵒᵖ ⥤ Type v}
    (hG : Presheaf.IsSheaf (BigFppfOver.topology B S hS) G) (f : ∀ i, F i ⟶ G)
    (hsurj : ∀ (U : BigFppfOver B S hS) (s : G.obj (op U)),
      ∃ T : Sieve U, T ∈ BigFppfOver.topology B S hS U ∧ ∀ ⦃V : BigFppfOver B S hS⦄ (g : V ⟶ U),
        T g → ∃ (i : ι) (t : (F i).obj (op V)), (f i).app (op V) t = G.map g.op s)
    (hF : ∀ i, LimitPreserving.{u, v, w, w', u + 1} (BigFppfOver.toScheme B S hS) (F i))
    (hlift : ∀ (i j : ι) (I : Type (max w w')) [Category.{w'} I] [IsCofiltered I]
      (D : I ⥤ BigFppfOver B S hS) (c : Cone D),
      IsLimit ((BigFppfOver.toScheme B S hS).mapCone c) →
      (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (D.obj k))) →
      IsAffine ((BigFppfOver.toScheme B S hS).obj c.pt) → ∀ (k : I) (x : (F i).obj (op c.pt))
      (x' : (F j).obj (op (D.obj k))),
      (f i).app _ x = G.map (c.π.app k).op ((f j).app _ x') →
      ∃ (l : I) (g : l ⟶ k) (y : (F i).obj (op (D.obj l))),
        (F i).map (c.π.app l).op y = x ∧ (f i).app _ y = G.map (D.map g).op ((f j).app _ x')) :
    LimitPreserving.{u, v, w, w', u + 1} (BigFppfOver.toScheme B S hS) G := by
  let R : Subfunctor G := ⨆ i, Subfunctor.range (f i)
  have : Presheaf.IsLocallyInjective (BigFppfOver.topology B S hS) R.ι :=
    Presheaf.isLocallyInjective_of_injective _ _ (fun _ => Subtype.val_injective)
  have : Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS) R.ι := by
    refine ⟨fun {U} s => ?_⟩
    obtain ⟨T, hT, hTs⟩ := hsurj U s
    refine (BigFppfOver.topology B S hS).superset_covering ?_ hT
    intro V g hg
    obtain ⟨i, t, ht⟩ := hTs g hg
    exact ⟨⟨G.map g.op s, by
      simp only [R, Subfunctor.iSup_obj, Set.mem_iUnion]
      exact ⟨i, t, ht⟩⟩, rfl⟩
  exact limitPreserving_of_isLocallyBijective.{u, v, w, w'} B S hS R.ι hG
    (limitPreserving_jointRange _ f hF hlift)

/-- An fppf sheaf with a jointly locally surjective family of limit preserving presheaves whose
fibre products are limit preserving is limit preserving. -/
theorem limitPreserving_of_jointlyLocallySurjective_of_isPullback [UnivLE.{max w w', u}]
    {ι : Type*} {G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type v} {F : ι → (BigFppfOver B S hS)ᵒᵖ ⥤ Type v}
    (hG : Presheaf.IsSheaf (BigFppfOver.topology B S hS) G) (f : ∀ i, F i ⟶ G)
    (hsurj : ∀ (U : BigFppfOver B S hS) (s : G.obj (op U)),
      ∃ T : Sieve U, T ∈ BigFppfOver.topology B S hS U ∧ ∀ ⦃V : BigFppfOver B S hS⦄ (g : V ⟶ U),
        T g → ∃ (i : ι) (t : (F i).obj (op V)), (f i).app (op V) t = G.map g.op s)
    (hF : ∀ i, LimitPreserving.{u, v, w, w', u + 1} (BigFppfOver.toScheme B S hS) (F i))
    (hpb : ∀ i j, ∃ (P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type v) (p₁ : P ⟶ F i) (p₂ : P ⟶ F j),
      IsPullback p₁ p₂ (f i) (f j) ∧
        LimitPreserving.{u, v, w, w', u + 1} (BigFppfOver.toScheme B S hS) P) :
    LimitPreserving.{u, v, w, w', u + 1} (BigFppfOver.toScheme B S hS) G :=
  limitPreserving_of_jointlyLocallySurjective B S hS hG f hsurj hF
    fun i j _ _ _ D c hc hD hC k x x' hx =>
      have ⟨_, _, _, hP, hPl⟩ := hpb i j
      exists_lift_of_isPullback _ hP (hF j) hPl D c hc hD hC k x x' hx

end AlgebraicGeometry

end
