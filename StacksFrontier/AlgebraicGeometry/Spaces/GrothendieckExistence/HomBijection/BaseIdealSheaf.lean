module

public import StacksFrontier.AlgebraicGeometry.Spaces.IdealMultipleModule
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleCohomology
public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentAdicInternalHom
public import StacksFrontier.AlgebraicGeometry.Spaces.GrothendieckExistence.HomBijection.AdicSectionsAffineDescent
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiImageSubsheaf
public import StacksFrontier.AlgebraicGeometry.Topologies.QuasicoherentCokernels

/-!
# The sheaf of ideals `I 𝒪_X` generated by an ideal of the base ring

Let `X` be an algebraic space over `Spec A` and `I ⊆ A` an ideal. The sheaf of ideals
`I 𝒪_X ⊆ 𝒪_X` is the image of multiplication by the elements of `I`. Over an affine étale chart
`U` its sections are the extended ideal `I 𝒪(U)`, it is quasi-coherent, and for every
`𝒪_X`-module `M` the quotient `M / (I 𝒪_X)^k M` is the quotient `M / I^k M` of multiplication by
the elements of `I^k`. This identifies the completion along `I 𝒪_X` of Stacks 08B4 with the
completion along `I` of the theorem on formal functions, Stacks 08B0.

## Main definitions

* `AlgebraicGeometry.Space.C1573.baseIdealSubmodule`: the sheaf of ideals `I 𝒪_X`.
* `AlgebraicGeometry.Space.C1573.baseIdealQuotientIso`: `M / (I 𝒪_X)^k M ≅ M / I^k M`.

## Main results

* `AlgebraicGeometry.Space.C1573.chartIdeal_baseIdealSubmodule_of_isAffine`: the sections of
  `I 𝒪_X` over an affine chart are `I 𝒪(U)`.
* `AlgebraicGeometry.Space.C1573.isQuasicoherentOnSite_baseIdealSubmodule`: `I 𝒪_X` is
  quasi-coherent.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe v u u' t

namespace Stacks.SheafOfModules.ImageSubsheaf.C1573

variable {C : Type u'} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  {M N : _root_.SheafOfModules.{t} R}

/-- **The local image of a monomorphism of sheaves of modules is its range.** -/
theorem mem_imageSubmodule_iff_of_mono [Abelian (_root_.SheafOfModules.{t} R)] (f : M ⟶ N) [Mono f]
    {X₀ : Cᵒᵖ} (s : N.val.obj X₀) :
    s ∈ (imageSubmodule f).obj X₀ ↔ ∃ m, f.val.app X₀ m = s := by
  obtain ⟨X⟩ := X₀
  refine ⟨fun hs => ?_, fun ⟨m, hm⟩ => hm ▸ apply_mem_imageSubmodule f m⟩
  have hinj : ∀ (Y : Cᵒᵖ), Function.Injective (f.val.app Y) := fun Y =>
    (ModuleCat.mono_iff_injective _).mp
      (inferInstanceAs (Mono ((_root_.SheafOfModules.evaluation R Y).map f)))
  set T : Sieve X := (rangeSubmodule f).toSubfunctor.sieveOfSection s with hT
  have hpre (V : C) (g : V ⟶ X) (hg : T g) : ∃ y, f.val.app (op V) y = N.val.map g.op s :=
    hg
  let fam : Presieve.FamilyOfElements (M.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{t})
      T.arrows := fun V g hg => Classical.choose (hpre V g hg)
  have hspec (V : C) (g : V ⟶ X) (hg : T.arrows g) :
      f.val.app (op V) (fam g hg) = N.val.map g.op s :=
    Classical.choose_spec (hpre V g hg)
  have hcomp : fam.Compatible := by
    intro V₁ V₂ W g₁ g₂ f₁ f₂ h₁ h₂ hc
    apply hinj (op W)
    show f.val.app (op W) (M.val.map g₁.op (fam f₁ h₁)) =
      f.val.app (op W) (M.val.map g₂.op (fam f₂ h₂))
    rw [PresheafOfModules.naturality_apply f.val g₁.op (fam f₁ h₁),
      PresheafOfModules.naturality_apply f.val g₂.op (fam f₂ h₂),
      hspec V₁ f₁ h₁, hspec V₂ f₂ h₂,
      ← PresheafOfModules.map_comp_apply, ← PresheafOfModules.map_comp_apply,
      ← op_comp, hc, ← op_comp]
  have hsh := isSheaf_forget M T hs
  let y : M.val.obj (op X) := hsh.amalgamate fam hcomp
  have hy : ∀ (V : C) (g : V ⟶ X) (hg : T.arrows g), M.val.map g.op y = fam g hg :=
    fun V g hg => hsh.valid_glue hcomp g hg
  refine ⟨y, ?_⟩
  refine (isSheaf_forget N T hs).isSeparatedFor.ext fun V g hg => ?_
  show N.val.map g.op (f.val.app (op X) y) = N.val.map g.op s
  refine (PresheafOfModules.naturality_apply f.val g.op y).symm.trans ?_
  rw [hy V g hg, hspec V g hg]

/-- **A monomorphism of sheaves of modules is an isomorphism onto its local image.** -/
def isoImageSubmoduleOfMono [Abelian (_root_.SheafOfModules.{t} R)] (f : M ⟶ N) [Mono f] :
    M ≅ (imageSubmodule f).toSheafOfModules :=
  have hinj : ∀ (Y : Cᵒᵖ), Function.Injective (f.val.app Y) := fun Y =>
    (ModuleCat.mono_iff_injective _).mp
      (inferInstanceAs (Mono ((_root_.SheafOfModules.evaluation R Y).map f)))
  (_root_.SheafOfModules.fullyFaithfulForget R).preimageIso <|
    PresheafOfModules.isoMk
      (fun U => (LinearEquiv.ofBijective
        ((f.val.app U).hom.codRestrict ((imageSubmodule f).obj U)
          fun m => apply_mem_imageSubmodule f m)
        ⟨fun _ _ h => hinj U (congrArg Subtype.val h),
          fun y => by
            obtain ⟨m, hm⟩ := (mem_imageSubmodule_iff_of_mono f y.1).1 y.2
            exact ⟨m, Subtype.ext hm⟩⟩).toModuleIso)
      (by intro U V g; ext x; exact Subtype.ext (PresheafOfModules.naturality_apply f.val g x))

end Stacks.SheafOfModules.ImageSubsheaf.C1573

namespace AlgebraicGeometry.Space.C1573

variable {B : BigFppfSite.{u}} {A : Type u} [CommRing A] {hA : B.Contains (Spec (.of A))}
  (X : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u) (hX : IsAlgebraicSpace B (Spec (.of A)) hA X)

/-- The image of a scalar of the base ring in the ring of an étale chart. -/
def specBaseChartHom (U : SmallEtale B (Spec (.of A)) hA X) :
    A →+* chartRing B (Spec (.of A)) hA X hX U where
  toFun a := (baseRingHom A B hA X hX a).1 (op U)
  map_one' := congrFun (congrArg Subtype.val (map_one (baseRingHom A B hA X hX))) (op U)
  map_mul' a b := congrFun (congrArg Subtype.val (map_mul (baseRingHom A B hA X hX) a b)) (op U)
  map_zero' := congrFun (congrArg Subtype.val (map_zero (baseRingHom A B hA X hX))) (op U)
  map_add' a b := congrFun (congrArg Subtype.val (map_add (baseRingHom A B hA X hX) a b)) (op U)

/-- `specBaseChartHom X hX U a` is the section over `U` of the image of `a` in `𝒪_X`. -/
theorem baseChartHom_apply (U : SmallEtale B (Spec (.of A)) hA X) (a : A) :
    specBaseChartHom X hX U a = (baseRingHom A B hA X hX a).1 (op U) := rfl

/-- **The sheaf of ideals `I 𝒪_X`** generated by an ideal `I` of the base ring: the image of
multiplication by the elements of `I` on `𝒪_X`. -/
def baseIdealSubmodule (I : Ideal A) :
    (SheafOfModules.unit
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B (Spec (.of A)) hA X hX).O)).Submodule :=
  Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule
    (idealMultipleι (baseRingHom A B hA X hX) (SheafOfModules.unit _) I)

variable {X hX}

/-- Multiplication by `a ∈ J` followed by the inclusion of `J M` is multiplication by the image
of `a` on the sections over a chart. -/
theorem idealMultipleFactor_ι_app (M : Modules.{u, u} B (Spec (.of A)) hA X hX) (J : Ideal A)
    {a : A} (ha : a ∈ J) (U : SmallEtale B (Spec (.of A)) hA X) (s : M.val.obj (op U)) :
    (idealMultipleι (baseRingHom A B hA X hX) M J).val.app (op U)
        ((idealMultipleFactor (baseRingHom A B hA X hX) M J ha).val.app (op U) s) =
      specBaseChartHom X hX U a • s := by
  have h := congrArg (fun k => k.val.app (op U) s)
    (idealMultipleFactor_ι (baseRingHom A B hA X hX) M J ha)
  exact h

/-- If `a • y ∈ N` for all generators `a` of an ideal, then `c • y ∈ N` for every `c` in it. -/
private theorem smul_mem_of_mem_span {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) (T : Set R) (y : M) (h : ∀ a ∈ T, a • y ∈ N) {c : R}
    (hc : c ∈ Ideal.span T) : c • y ∈ N :=
  (Ideal.span_le (I := N.comap (LinearMap.toSpanSingleton R M y))).2 h hc

/-- **The sections of `J M` over an affine chart are `J 𝒪(U) · M(U)`**, for quasi-coherent `M`,
read inside `M` as the local image of the inclusion of `J M`. -/
theorem imageSubmodule_idealMultipleι_obj_of_isAffine (M : Modules.{u, u} B (Spec (.of A)) hA X hX)
    (hM : M.IsQuasicoherentOnSite) (J : Ideal A) (U : SmallEtale B (Spec (.of A)) hA X)
    (hU : IsAffine ((SmallEtale.toOver B (Spec (.of A)) hA X ⋙
      BigFppfOver.toScheme B (Spec (.of A)) hA).obj U)) :
    (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule
        (idealMultipleι (baseRingHom A B hA X hX) M J)).obj (op U) =
      Ideal.map (specBaseChartHom X hX U) J •
        (⊤ : Submodule (chartRing B (Spec (.of A)) hA X hX U) (M.val.obj (op U))) := by
  set ι := idealMultipleι (baseRingHom A B hA X hX) M J
  have hrange : (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule ι).obj (op U) =
      LinearMap.range (ι.val.app (op U)).hom := by
    ext x
    exact Stacks.SheafOfModules.ImageSubsheaf.C1573.mem_imageSubmodule_iff_of_mono ι x
  rw [hrange, LinearMap.range_eq_map, ← span_idealMultipleFactor_sections _ M J hM U hU,
    Submodule.map_span]
  refine le_antisymm (Submodule.span_le.2 ?_) ?_
  · rintro _ ⟨_, ⟨a, ha, s, rfl⟩, rfl⟩
    show (ι.val.app (op U)) ((idealMultipleFactor _ M J ha).val.app (op U) s) ∈ _
    rw [idealMultipleFactor_ι_app]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ha) Submodule.mem_top
  · refine Submodule.smul_le.2 fun b hb s _ => ?_
    refine smul_mem_of_mem_span _ _ s ?_ hb
    rintro _ ⟨a, ha, rfl⟩
    exact Submodule.subset_span ⟨_, ⟨a, ha, s, rfl⟩, idealMultipleFactor_ι_app M J ha U s⟩

/-- **The extended ideal lies in the sections of `I 𝒪_X` over every chart.** -/
theorem map_le_baseIdealSheaf_obj (I : Ideal A) (U : SmallEtale B (Spec (.of A)) hA X) :
    Ideal.map (specBaseChartHom X hX U) I ≤
      chartIdeal B (Spec (.of A)) hA ⟨X, hX⟩ (baseIdealSubmodule X hX I) U := by
  refine Ideal.map_le_iff_le_comap.2 fun a ha => ?_
  have h := Stacks.SheafOfModules.ImageSubsheaf.apply_mem_imageSubmodule
    (idealMultipleι (baseRingHom A B hA X hX) (SheafOfModules.unit _) I)
    ((idealMultipleFactor (baseRingHom A B hA X hX) (SheafOfModules.unit _) I ha).val.app (op U)
      (1 : chartRing B (Spec (.of A)) hA X hX U))
  have h2 := idealMultipleFactor_ι_app (hX := hX)
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B (Spec (.of A)) hA X hX).O)) I ha U
    (1 : chartRing B (Spec (.of A)) hA X hX U)
  show specBaseChartHom X hX U a ∈ (baseIdealSubmodule X hX I).obj (op U)
  have h1 : specBaseChartHom X hX U a • (1 : chartRing B (Spec (.of A)) hA X hX U) =
      specBaseChartHom X hX U a := mul_one _
  exact (h2.trans h1) ▸ h

/-- **The sections of `I 𝒪_X` over an affine chart are the extended ideal `I 𝒪(U)`.** -/
theorem chartIdeal_baseIdealSubmodule_of_isAffine (I : Ideal A)
    (U : SmallEtale B (Spec (.of A)) hA X)
    (hU : IsAffine ((SmallEtale.toOver B (Spec (.of A)) hA X ⋙
      BigFppfOver.toScheme B (Spec (.of A)) hA).obj U)) :
    chartIdeal B (Spec (.of A)) hA ⟨X, hX⟩ (baseIdealSubmodule X hX I) U =
      Ideal.map (specBaseChartHom X hX U) I := by
  have h := imageSubmodule_idealMultipleι_obj_of_isAffine (hX := hX)
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B (Spec (.of A)) hA X hX).O))
    (SheafOfModules.isQuasicoherentOnSite_unit _) I U hU
  show (baseIdealSubmodule X hX I).obj (op U) = _
  refine h.trans ?_
  exact (Ideal.smul_eq_mul _ _).trans (Ideal.mul_top _)

/-- **`I 𝒪_X` is quasi-coherent.** -/
theorem isQuasicoherentOnSite_baseIdealSubmodule (I : Ideal A) :
    (baseIdealSubmodule X hX I).toSheafOfModules.IsQuasicoherentOnSite :=
  SheafOfModules.IsQuasicoherentOnSite.of_iso
    (Stacks.SheafOfModules.ImageSubsheaf.C1573.isoImageSubmoduleOfMono
      (idealMultipleι (baseRingHom A B hA X hX) (SheafOfModules.unit _) I))
    (isQuasicoherentOnSite_idealMultiple _ _ I (SheafOfModules.isQuasicoherentOnSite_unit _))

/-- The image of an element of `I ^ k` in the ring of any chart lies in the `k`-th power of the
sections of `I 𝒪_X`. -/
theorem baseChartHom_mem_pow (I : Ideal A) (k : ℕ) {a : A} (ha : a ∈ I ^ k)
    (U : SmallEtale B (Spec (.of A)) hA X) :
    specBaseChartHom X hX U a ∈
      chartIdeal B (Spec (.of A)) hA ⟨X, hX⟩ (baseIdealSubmodule X hX I) U ^ k := by
  have h1 : specBaseChartHom X hX U a ∈ Ideal.map (specBaseChartHom X hX U) (I ^ k) :=
    Ideal.mem_map_of_mem _ ha
  rw [Ideal.map_pow] at h1
  exact Ideal.pow_right_mono (map_le_baseIdealSheaf_obj I U) k h1

/-- **`(I 𝒪_X)^k` annihilates `M / I^k M`.** -/
theorem smul_idealQuotient_eq_zero (M : Modules.{u, u} B (Spec (.of A)) hA X hX) (I : Ideal A)
    (k : ℕ) (U : (smallEtaleRingedSite B (Spec (.of A)) hA X hX).C)
    (r : chartRing B (Spec (.of A)) hA X hX U)
    (hr : r ∈ chartIdeal B (Spec (.of A)) hA ⟨X, hX⟩ (baseIdealSubmodule X hX I) U ^ k)
    (y : (idealQuotient (baseRingHom A B hA X hX) M (I ^ k)).val.obj (op U)) : r • y = 0 := by
  have key : ∀ (W : (smallEtaleRingedSite B (Spec (.of A)) hA X hX).C) (g : W ⟶ U),
      IsAffine (chartScheme W) →
        (idealQuotient (baseRingHom A B hA X hX) M (I ^ k)).val.map g.op (r • y) =
          (idealQuotient (baseRingHom A B hA X hX) M (I ^ k)).val.map g.op 0 := by
    intro W g hW
    rw [map_zero, PresheafOfModules.map_smul]
    have hle : Ideal.map ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B (Spec (.of A)) hA X hX).O).obj.map g.op).hom
          (chartIdeal B (Spec (.of A)) hA ⟨X, hX⟩ (baseIdealSubmodule X hX I) U) ≤
        chartIdeal B (Spec (.of A)) hA ⟨X, hX⟩ (baseIdealSubmodule X hX I) W :=
      Ideal.map_le_iff_le_comap.2 fun c hc => (baseIdealSubmodule X hX I).map g.op hc
    have h2 := Ideal.mem_map_of_mem ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B (Spec (.of A)) hA X hX).O).obj.map g.op).hom hr
    rw [Ideal.map_pow] at h2
    have h3 := Ideal.pow_right_mono hle k h2
    rw [chartIdeal_baseIdealSubmodule_of_isAffine I W hW, ← Ideal.map_pow] at h3
    refine smul_mem_of_mem_span ⊥ _ _ ?_ h3
    rintro _ ⟨a, ha, rfl⟩
    exact congrArg (fun e => e.val.app (op W)
        ((idealQuotient (baseRingHom A B hA X hX) M (I ^ k)).val.map g.op y))
      (globalSmul_idealQuotient_eq_zero (baseRingHom A B hA X hX) M (I ^ k) ha)
  exact SmallEtale.C1573.eq_of_forall_isAffine B (Spec (.of A)) hA X hX
    (Stacks.SheafOfModules.ImageSubsheaf.isSheaf_forget
      (idealQuotient (baseRingHom A B hA X hX) M (I ^ k))) fun W g hW => key W g hW

/-- `(I 𝒪_X)^k M` is killed by the projection onto `M / I^k M`. -/
theorem idealPowerSubsheaf_ι_idealQuotientπ (M : Modules.{u, u} B (Spec (.of A)) hA X hX)
    (I : Ideal A) (k : ℕ) :
    (idealPowerSubsheaf B (Spec (.of A)) hA X hX (baseIdealSubmodule X hX I) k M).ι ≫
      idealQuotientπ (baseRingHom A B hA X hX) M (I ^ k) = 0 :=
  (idealPowerSubsheaf_ι_comp_zero_iff B (Spec (.of A)) hA X hX _ k _).2 fun U r hr x =>
    (map_smul ((idealQuotientπ (baseRingHom A B hA X hX) M (I ^ k)).val.app (op U)).hom r x).trans
      (smul_idealQuotient_eq_zero M I k U r hr _)

/-- `I^k M` is killed by the projection onto `M / (I 𝒪_X)^k M`. -/
theorem idealMultipleι_smallEtaleAdicQuotientProjection
    (M : Modules.{u, u} B (Spec (.of A)) hA X hX) (I : Ideal A) (k : ℕ) :
    idealMultipleι (baseRingHom A B hA X hX) M (I ^ k) ≫
      smallEtaleAdicQuotientProjection B (Spec (.of A)) hA X hX
        (baseIdealSubmodule X hX I) k M = 0 := by
  refine idealMultiple_hom_ext _ M _ fun a ha => ?_
  rw [comp_zero, ← Category.assoc, idealMultipleFactor_ι,
    ← Stacks.Cohomology.SiteModules.comp_globalSmul]
  have hz : Stacks.Cohomology.SiteModules.globalSmul _ (baseRingHom A B hA X hX a)
      (smallEtaleAdicQuotient B (Spec (.of A)) hA X hX (baseIdealSubmodule X hX I) k M) = 0 := by
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    exact isPowAnnihilated_smallEtaleAdicQuotient B (Spec (.of A)) hA X hX _ k M U.unop _
      (baseChartHom_mem_pow I k ha U.unop) x
  rw [hz, comp_zero]

/-- **`M / (I 𝒪_X)^k M ≅ M / I^k M`**, under `M`: the completion along the sheaf of ideals
`I 𝒪_X` of Stacks 08B4 is the completion along `I` of the theorem on formal functions. -/
def baseIdealQuotientIso (M : Modules.{u, u} B (Spec (.of A)) hA X hX) (I : Ideal A) (k : ℕ) :
    smallEtaleAdicQuotient B (Spec (.of A)) hA X hX (baseIdealSubmodule X hX I) k M ≅
      idealQuotient (baseRingHom A B hA X hX) M (I ^ k) where
  hom := cokernel.desc _ _ (idealPowerSubsheaf_ι_idealQuotientπ M I k)
  inv := cokernel.desc _ _ (idealMultipleι_smallEtaleAdicQuotientProjection M I k)
  hom_inv_id := by
    refine (cancel_epi (smallEtaleAdicQuotientProjection B (Spec (.of A)) hA X hX _ k M)).1 ?_
    rw [Category.comp_id, ← Category.assoc, cokernel.π_desc, cokernel.π_desc]
  inv_hom_id := by
    refine (cancel_epi (idealQuotientπ (baseRingHom A B hA X hX) M (I ^ k))).1 ?_
    rw [Category.comp_id, ← Category.assoc, cokernel.π_desc, cokernel.π_desc]

/-- The projection `M → M / (I 𝒪_X)^k M` followed by `baseIdealQuotientIso` is the projection
`M → M / I^k M`. -/
@[reassoc (attr := simp)]
theorem smallEtaleAdicQuotientProjection_baseIdealQuotientIso_hom
    (M : Modules.{u, u} B (Spec (.of A)) hA X hX) (I : Ideal A) (k : ℕ) :
    smallEtaleAdicQuotientProjection B (Spec (.of A)) hA X hX (baseIdealSubmodule X hX I) k M ≫
      (baseIdealQuotientIso M I k).hom = idealQuotientπ (baseRingHom A B hA X hX) M (I ^ k) :=
  cokernel.π_desc _ _ _

end AlgebraicGeometry.Space.C1573

end
