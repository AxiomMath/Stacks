module

public import StacksFrontier.AlgebraicGeometry.Spaces.IdealMultipleModule
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePushforwardBaseScalars
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedImmersionModulePushforwardRightExact
public import StacksFrontier.AlgebraicGeometry.Spaces.AffineMorphismCohomologyCollapseUnconditional

/-!
# The direct image of `M / J M` along a closed immersion

Let `i : Z ⟶ X` be a closed immersion of algebraic spaces over `Spec A` and let `J ⊆ A` be a
finitely generated ideal.  For an `𝒪_Z`-module `M`, the direct image of `M / J M` is
`i_*M / J i_*M` (`AlgebraicGeometry.Space.C1573.pushforwardIdealQuotientIso`).

## Main definitions

* `AlgebraicGeometry.Space.C1573.idealGeneratorsHom`: multiplication by a finite family of
  scalars, out of a finite direct sum of copies of a module.
* `AlgebraicGeometry.Space.C1573.idealQuotientIsoCokernelGenerators`: for `J` generated by a
  finite family `g`, `M / J M` is the cokernel of multiplication by `g`.
* `AlgebraicGeometry.Space.C1573.pushforwardIdealQuotientIso`: `i_*(M / J M) ≅ i_*M / J i_*M`.

## Main results

* `AlgebraicGeometry.Space.C1573.epi_pushforward_map_idealQuotientπ`: the direct image of the
  projection `M ⟶ M / J M` is an epimorphism.
* `AlgebraicGeometry.Space.C1573.pushforwardIdealQuotientIso_naturality`: the identification
  `i_*(M / J M) ≅ i_*M / J i_*M` is compatible with the transition maps.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.Cohomology.SiteModules

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u

namespace AlgebraicGeometry.Space.C1573

section Generators

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hX : IsAlgebraicSpace B S hS X}
  {A : Type u} [CommRing A]
  (φ : A →+* ↥(GlobalSectionRing
    ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O))))
  (F : Modules.{u, u} B S hS X hX) {r : ℕ} (g : Fin r → A)

/-- Multiplication by a finite family of scalars, out of a finite direct sum of copies of `F`. -/
def idealGeneratorsHom : (⨁ fun _ : Fin r => F) ⟶ F :=
  biproduct.desc fun k => globalSmul _ (φ (g k)) F

/-- Multiplication by a finite sum of global scalars is the sum of the multiplications. -/
theorem globalSmul_sum {ι : Type*} (s : Finset ι)
    (a : ι → ↥(GlobalSectionRing
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O)))) :
    globalSmul _ (∑ k ∈ s, a k) F = ∑ k ∈ s, globalSmul _ (a k) F := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, Finset.sum_empty, globalSmul_zero]
  | insert k s hk ih => rw [Finset.sum_insert hk, Finset.sum_insert hk, globalSmul_add, ih]

variable {J : Ideal A}

/-- For `J` generated by `g`, the inclusion of `J F` into `F` vanishes on the cokernel of
multiplication by `g`. -/
theorem idealMultipleι_comp_cokernel_π_idealGeneratorsHom (hJ : Ideal.span (Set.range g) = J) :
    idealMultipleι φ F J ≫ cokernel.π (idealGeneratorsHom φ F g) = 0 := by
  refine idealMultiple_hom_ext φ F J fun a ha => ?_
  rw [comp_zero, ← Category.assoc, idealMultipleFactor_ι]
  rw [← hJ] at ha
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 ha
  rw [map_sum, globalSmul_sum, Preadditive.sum_comp]
  refine Finset.sum_eq_zero fun k _ => ?_
  rw [smul_eq_mul, map_mul, globalSmul_mul]
  have hk : globalSmul _ (φ (g k)) F =
      biproduct.ι (fun _ : Fin r => F) k ≫ idealGeneratorsHom φ F g :=
    (biproduct.ι_desc (fun k => globalSmul _ (φ (g k)) F) k).symm
  rw [hk, Category.assoc, Category.assoc, cokernel.condition, comp_zero, comp_zero]

/-- For `J` generated by `g`, multiplication by `g` vanishes on `F / J F`. -/
theorem idealGeneratorsHom_comp_idealQuotientπ (hJ : Ideal.span (Set.range g) = J) :
    idealGeneratorsHom φ F g ≫ idealQuotientπ φ F J = 0 := by
  refine biproduct.hom_ext' _ _ fun k => ?_
  rw [comp_zero, idealGeneratorsHom, biproduct.ι_desc_assoc, ← comp_globalSmul,
    globalSmul_idealQuotient_eq_zero φ F J (hJ ▸ Ideal.subset_span ⟨k, rfl⟩), comp_zero]

/-- **`M / J M` is the cokernel of multiplication by the generators of `J`.** -/
def idealQuotientIsoCokernelGenerators (hJ : Ideal.span (Set.range g) = J) :
    idealQuotient φ F J ≅ cokernel (idealGeneratorsHom φ F g) where
  hom := cokernel.desc _ _ (idealMultipleι_comp_cokernel_π_idealGeneratorsHom φ F g hJ)
  inv := cokernel.desc _ _ (idealGeneratorsHom_comp_idealQuotientπ φ F g hJ)
  hom_inv_id := by
    refine (cancel_epi (idealQuotientπ φ F J)).1 ?_
    rw [Category.comp_id, ← Category.assoc, cokernel.π_desc, cokernel.π_desc]
  inv_hom_id := by
    refine (cancel_epi (cokernel.π (idealGeneratorsHom φ F g))).1 ?_
    rw [Category.comp_id, ← Category.assoc, cokernel.π_desc, cokernel.π_desc]

/-- The projection `F ⟶ F / J F` followed by `idealQuotientIsoCokernelGenerators` is the cokernel
projection. -/
@[reassoc (attr := simp)]
theorem idealQuotientπ_idealQuotientIsoCokernelGenerators_hom
    (hJ : Ideal.span (Set.range g) = J) :
    idealQuotientπ φ F J ≫ (idealQuotientIsoCokernelGenerators φ F g hJ).hom =
      cokernel.π (idealGeneratorsHom φ F g) :=
  cokernel.π_desc _ _ _

end Generators

section Pushforward

variable {B : BigFppfSite.{u}} {A : Type u} [CommRing A] {hA : B.Contains (Spec (.of A))}
  {Z X : AlgebraicSpaces B (Spec (.of A)) hA} (i : Z ⟶ X)
  (hi : IsClosedImmersion B (Spec (.of A)) hA i.hom)
  (H : Modules.{u, u} B (Spec (.of A)) hA Z.1 Z.2) {r : ℕ} (g : Fin r → A) {J : Ideal A}
  (hJ : Ideal.span (Set.range g) = J)

/-- The direct image of multiplication by the generators is multiplication by the generators on
the direct image. -/
theorem modulePushforward_map_idealGeneratorsHom :
    haveI := modulePushforward_additive B (Spec (.of A)) hA i
    (modulePushforward B (Spec (.of A)) hA i).map
        (idealGeneratorsHom (baseRingHom A B hA Z.1 Z.2) H g) =
      ((modulePushforward B (Spec (.of A)) hA i).mapBiproduct _).hom ≫
        idealGeneratorsHom (baseRingHom A B hA X.1 X.2)
          ((modulePushforward B (Spec (.of A)) hA i).obj H) g := by
  have := modulePushforward_additive B (Spec (.of A)) hA i
  rw [idealGeneratorsHom, ← biproduct.mapBiproduct_hom_desc]
  congr 1
  congr 1
  funext k
  exact modulePushforward_map_globalSmul_baseRingHom A B hA i H (g k)

include hi hJ in
/-- **`i_*(M / J M) ≅ i_*M / J i_*M`** for a closed immersion `i` and a finitely generated
ideal `J` of the base ring. -/
def pushforwardIdealQuotientIso :
    (modulePushforward B (Spec (.of A)) hA i).obj (idealQuotient (baseRingHom A B hA Z.1 Z.2) H J) ≅
      idealQuotient (baseRingHom A B hA X.1 X.2)
        ((modulePushforward B (Spec (.of A)) hA i).obj H) J :=
  haveI := modulePushforward_additive B (Spec (.of A)) hA i
  haveI := preservesFiniteColimits_modulePushforward_of_isClosedImmersion B (Spec (.of A)) hA i hi
  (modulePushforward B (Spec (.of A)) hA i).mapIso
      (idealQuotientIsoCokernelGenerators (baseRingHom A B hA Z.1 Z.2) H g hJ) ≪≫
    PreservesCokernel.iso _ _ ≪≫
    cokernelIsoOfEq (modulePushforward_map_idealGeneratorsHom i H g) ≪≫
    cokernelEpiComp _ _ ≪≫
    (idealQuotientIsoCokernelGenerators (baseRingHom A B hA X.1 X.2) _ g hJ).symm

/-- The direct image of the projection `M ⟶ M / J M` followed by `pushforwardIdealQuotientIso` is
the projection `i_*M ⟶ i_*M / J i_*M`. -/
theorem pushforward_map_idealQuotientπ_pushforwardIdealQuotientIso_hom :
    (modulePushforward B (Spec (.of A)) hA i).map
          (idealQuotientπ (baseRingHom A B hA Z.1 Z.2) H J) ≫
        (pushforwardIdealQuotientIso i hi H g hJ).hom =
      idealQuotientπ (baseRingHom A B hA X.1 X.2)
        ((modulePushforward B (Spec (.of A)) hA i).obj H) J := by
  have := modulePushforward_additive B (Spec (.of A)) hA i
  have := preservesFiniteColimits_modulePushforward_of_isClosedImmersion B (Spec (.of A)) hA i hi
  simp only [pushforwardIdealQuotientIso, Iso.trans_hom, Functor.mapIso_hom, Iso.symm_hom,
    ← Category.assoc, ← Functor.map_comp, idealQuotientπ_idealQuotientIsoCokernelGenerators_hom]
  rw [PreservesCokernel.π_iso_hom, π_comp_cokernelIsoOfEq_hom, cokernelEpiComp_hom, cokernel.π_desc]
  exact cokernel.π_desc _ _ _

include hi hJ in
/-- The direct image of the projection `M ⟶ M / J M` along a closed immersion is an
epimorphism. -/
theorem epi_pushforward_map_idealQuotientπ :
    Epi ((modulePushforward B (Spec (.of A)) hA i).map
      (idealQuotientπ (baseRingHom A B hA Z.1 Z.2) H J)) := by
  rw [(Iso.eq_comp_inv _).2
    (pushforward_map_idealQuotientπ_pushforwardIdealQuotientIso_hom i hi H g hJ)]
  exact epi_comp _ _

/-- The identification `i_*(M / J M) ≅ i_*M / J i_*M` is compatible with the transition maps. -/
theorem pushforwardIdealQuotientIso_naturality {r' : ℕ} (g' : Fin r' → A) {J' : Ideal A}
    (hJ' : Ideal.span (Set.range g') = J') (hJJ' : J ≤ J') :
    (modulePushforward B (Spec (.of A)) hA i).map
        (idealQuotientMap (baseRingHom A B hA Z.1 Z.2) H hJJ') ≫
      (pushforwardIdealQuotientIso i hi H g' hJ').hom =
    (pushforwardIdealQuotientIso i hi H g hJ).hom ≫
      idealQuotientMap (baseRingHom A B hA X.1 X.2)
        ((modulePushforward B (Spec (.of A)) hA i).obj H) hJJ' := by
  have := epi_pushforward_map_idealQuotientπ i hi H g hJ
  refine (cancel_epi ((modulePushforward B (Spec (.of A)) hA i).map
    (idealQuotientπ (baseRingHom A B hA Z.1 Z.2) H J))).1 ?_
  rw [← Category.assoc, ← Functor.map_comp, idealQuotientπ_idealQuotientMap,
    pushforward_map_idealQuotientπ_pushforwardIdealQuotientIso_hom, ← Category.assoc,
    pushforward_map_idealQuotientπ_pushforwardIdealQuotientIso_hom,
    idealQuotientπ_idealQuotientMap]

end Pushforward

end AlgebraicGeometry.Space.C1573

end
