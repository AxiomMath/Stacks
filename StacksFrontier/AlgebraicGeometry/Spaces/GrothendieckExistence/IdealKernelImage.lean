module

public import StacksFrontier.AlgebraicGeometry.Spaces.ProperGlobalSections.FibreThickening
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiImageSubsheaf

/-!
# The sheaf of ideals `J 𝒪_X` as an image

Two spellings of the sheaf of ideals `J 𝒪_X` generated by an ideal `J` of a ring mapping to the
global functions of an algebraic space `X` are in use: the kernel of `𝒪_X ⟶ 𝒪_X / J 𝒪_X`
(`AlgebraicGeometry.Space.idealKernel`) and the sheaf image of the inclusion of `J 𝒪_X`
(`Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule` of `AlgebraicGeometry.Space.idealMultipleι`).
This file identifies them, so that statements about the completion functor along either spelling
can be transported to the other.

## Main results

* `AlgebraicGeometry.Space.imageSubmodule_idealMultipleι_eq_idealKernel`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.SiteModules

universe u

namespace AlgebraicGeometry.Space

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : AlgebraicSpaces B S hS} {A : Type u} [CommRing A]
  (φ : A →+* ↥(GlobalSectionRing ((Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedSite B S hS X.1 X.2).O)))) (J : Ideal A)

/-- **`J 𝒪_X` is the sheaf image of the inclusion of `J 𝒪_X`.** -/
theorem imageSubmodule_idealMultipleι_eq_idealKernel :
    Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule
        (idealMultipleι φ (structureSheafModule B S hS X) J) = idealKernel φ J := by
  refine le_antisymm (fun U x hx => ?_) (fun U x hx => ?_)
  · refine (idealKernel φ J).isSheaf x ?_
    refine (SmallEtale.topology B S hS X.1).superset_covering (fun W g hg => ?_) hx
    obtain ⟨m, hm⟩ := hg
    change _ ∈ (idealKernel φ J).obj (op W)
    refine (SheafOfModules.Submodule.mem_ker _ (op W) _).2 ?_
    have h0 : ((idealMultipleι φ (structureSheafModule B S hS X) J) ≫
        idealQuotientπ φ (structureSheafModule B S hS X) J).val.app (op W) m = 0 := by
      rw [idealMultipleι_idealQuotientπ]
      rfl
    exact (congrArg _ hm.symm).trans h0
  · have h := congrArg (fun ψ => ψ.val.app U ⟨x, hx⟩) (kernelToIdealMultiple_ι φ J)
    change (idealMultipleι φ (structureSheafModule B S hS X) J).val.app U
      ((kernelToIdealMultiple φ J).val.app U ⟨x, hx⟩) = x at h
    rw [← h]
    exact Stacks.SheafOfModules.ImageSubsheaf.apply_mem_imageSubmodule _ _

end AlgebraicGeometry.Space

end
