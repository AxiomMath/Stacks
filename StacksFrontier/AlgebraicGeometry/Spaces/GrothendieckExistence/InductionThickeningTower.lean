module

public import StacksFrontier.AlgebraicGeometry.Spaces.GrothendieckExistence.InductionClosedImmersionTower
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedImmersionInfinitesimalBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.AlgebraizationMorphismGraph
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceFinitePresentationOverBase
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealFinitePresentation

/-!
# Stacks 08BG from a closed immersion of the first fibres, given Grothendieck's existence theorem

The source's statement of Stacks 08BG is about an abstract commutative diagram
`Z_1 ⟶ Z_2 ⟶ ⋯` over `X_1 ⟶ X_2 ⟶ ⋯`, `X_n = X ×_V Spec (A / Iⁿ)`, with cartesian squares, in
which only `Z_1 ⟶ X_1` is assumed to be a closed immersion.  Its proof first makes every
`Z_n ⟶ X_n` a closed immersion by Stacks 08B2: `X_n ⟶ X_{n+1}` is a closed immersion, bijective
on points and of finite presentation (its ideal is generated by `Iⁿ`, finitely generated because
`A` is Noetherian), and the base change of `Z_{n+1} ⟶ X_{n+1}` along it is `Z_n ⟶ X_n`.  The
rest of the proof is `AlgebraicGeometry.Space.exists_closedSubspace_of_closedImmersion_tower`.

## Main results

* `AlgebraicGeometry.Space.isClosedImmersion_of_isClosedImmersion_one`: every `Z_n ⟶ X_n` is a
  closed immersion once `Z_1 ⟶ X_1` is.
* `AlgebraicGeometry.Space.exists_closedSubspace_of_isClosedImmersion_one`: Stacks 08BG at the
  source's diagram form, from Stacks 08BE and 08B9.

Nothing is registered: the result is conditional on Stacks 08BE and 08B9 (as the propositions of
`StacksFrontier/AlgebraicGeometry/Spaces/GrothendieckExistence/Statements.lean`).
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  (V : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)]
  (I : Ideal Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) {X : AlgebraicSpaces B S hS}
  (f : X ⟶ schemeSpace V)

/-- The transition between fibres commutes with their inclusions into `X`, on underlying maps. -/
private theorem fibreTransition_hom_comp_fibreInclusion_hom {V₁ : BigFppfOver B S hS}
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V₁)]
    (I₁ : Ideal Γ((BigFppfOver.toScheme B S hS).obj V₁, ⊤)) {X₁ : AlgebraicSpaces B S hS}
    (f₁ : X₁ ⟶ schemeSpace V₁) {m n : ℕ} (h : m ≤ n) :
    (fibreTransition V₁ I₁ f₁ h).hom ≫ (fibreInclusion V₁ I₁ f₁ n).hom =
      (fibreInclusion V₁ I₁ f₁ m).hom :=
  congrArg (fun k => k.hom) (fibreTransition_comp V₁ I₁ f₁ h)

/-- The inclusions of the fibres into `X` are compatible with the transitions on points. -/
private theorem pointsMap_fibreThickening_ι_pointsMap_fibreTransition {V₁ : BigFppfOver B S hS}
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V₁)]
    (I₁ : Ideal Γ((BigFppfOver.toScheme B S hS).obj V₁, ⊤)) {X₁ : AlgebraicSpaces B S hS}
    (f₁ : X₁ ⟶ schemeSpace V₁) {m n : ℕ} (h : m ≤ n) (x) :
    pointsMap B S hS _ (fibreThickening V₁ I₁ f₁ n).1.ι
        (pointsMap B S hS _ (fibreTransition V₁ I₁ f₁ h).hom x) =
      pointsMap B S hS _ (fibreThickening V₁ I₁ f₁ m).1.ι x := by
  rw [← pointsMap_comp_apply]
  exact congrArg (fun k => pointsMap B S hS _ k x)
    (fibreTransition_hom_comp_fibreInclusion_hom I₁ f₁ h)

omit [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- **The positive-order fibres have the same points.** For `0 < m`, every point of
`X ×_V Spec (A / Iⁿ)` lies, in `|X|`, in the image of `X ×_V Spec (A / Iᵐ)`: the closed
subschemes `Spec (A / Iⁿ)` and `Spec (A / Iᵐ)` of `V` have the same points when `0 < n`. -/
theorem range_pointsMap_fibreThickening_ι_subset_of_pos {m : ℕ} (hm : 0 < m) (n : ℕ) :
    Set.range (pointsMap B S hS _ (fibreThickening V I f n).1.ι) ⊆
      Set.range (pointsMap B S hS _ (fibreThickening V I f m).1.ι) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rintro _ ⟨x, rfl⟩
    exact ⟨_, pointsMap_fibreThickening_ι_pointsMap_fibreTransition I f (Nat.zero_le m) x⟩
  · have : ∀ m, Mono (adicCompletionQuotientObjHom B S hS V I m) := fun m =>
      (BigFppfOver.toScheme B S hS).mono_of_mono_map inferInstance
    rw [range_pointsMap_preimage_ι, range_pointsMap_preimage_ι]
    refine Set.preimage_mono ?_
    change Set.range (pointsMap B S hS
        (Subfunctor.range (yoneda.map (adicCompletionQuotientObjHom B S hS V I n))).toFunctor
        (Subfunctor.range (yoneda.map (adicCompletionQuotientObjHom B S hS V I n))).ι) ⊆
      Set.range (pointsMap B S hS
        (Subfunctor.range (yoneda.map (adicCompletionQuotientObjHom B S hS V I m))).toFunctor
        (Subfunctor.range (yoneda.map (adicCompletionQuotientObjHom B S hS V I m))).ι)
    rw [range_pointsMap_ι_range, range_pointsMap_ι_range, range_pointsMap_yoneda_eq_preimage,
      range_pointsMap_yoneda_eq_preimage]
    refine Set.preimage_mono ?_
    rw [range_eq_zeroLocus_ker_appTop _ (isAffineOpen_top _),
      range_eq_zeroLocus_ker_appTop _ (isAffineOpen_top _),
      ker_appTop_adicCompletionQuotientObjHom, ker_appTop_adicCompletionQuotientObjHom,
      ← Scheme.zeroLocus_radical _ (I ^ n), Ideal.radical_pow I hn.ne',
      ← Scheme.zeroLocus_radical _ (I ^ m), Ideal.radical_pow I hm.ne']

omit [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- **The transitions between positive-order fibres are surjective on points.** -/
theorem surjective_pointsMap_fibreTransition {m n : ℕ} (hm : 0 < m) (h : m ≤ n) :
    Function.Surjective (pointsMap B S hS _ (fibreTransition V I f h).hom) := by
  intro x
  obtain ⟨y, hy⟩ := range_pointsMap_fibreThickening_ι_subset_of_pos V I f hm n ⟨x, rfl⟩
  refine ⟨y, pointsMap_injective_of_mono B S hS (fibreThickening V I f n).1.ι ?_⟩
  rw [← hy]
  exact pointsMap_fibreThickening_ι_pointsMap_fibreTransition I f h y

omit [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- The transitions between the fibres are closed immersions. -/
theorem isClosedImmersion_fibreTransition {m n : ℕ} (h : m ≤ n) :
    IsClosedImmersion B S hS (fibreTransition V I f h).hom :=
  isClosedImmersion_homOfLe B S hS (fibreThickening V I f m) (fibreThickening_le V I f h)

/-- **The inclusion of `X ×_V Spec (A / Iⁿ)` into `X` is of finite presentation**: on an affine
étale chart its ideal is generated by `Iⁿ`, finitely generated because `A` is Noetherian. -/
theorem isFinitePresentation_fibreInclusion (n : ℕ) :
    IsFinitePresentation B S hS (fibreInclusion V I f n).hom := by
  have : IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top _⟩
  refine isFinitePresentation_subspaceInclusion_of_forall_fg_definingIdealAt B S hS X
    (fibreThickening V I f n) fun U hU => ?_
  rw [definingIdealAt_fibreThickening V I f n U]
  exact ((I ^ n).fg_of_isNoetherianRing).map _

/-- **The transitions between the fibres are of finite presentation.** -/
theorem isFinitePresentation_fibreTransition {m n : ℕ} (h : m ≤ n) :
    IsFinitePresentation B S hS (fibreTransition V I f h).hom := by
  refine isFinitePresentation_of_comp_of_isClosedImmersion B S hS (fibreSpace V I f m).2
    (fibreSpace V I f n).2 X.2 _ (fibreInclusion V I f n).hom
    (isClosedImmersion_fibreTransition V I f h)
    (isLocallyOfFiniteType_of_isClosedImmersion B S hS _ (fibreThickening V I f n).2.2) ?_
  rw [fibreTransition_hom_comp_fibreInclusion_hom I f]
  exact isFinitePresentation_fibreInclusion V I f m

/-- **Every `Z_n ⟶ X_n` is a closed immersion once `Z_1 ⟶ X_1` is** (the Stacks 08B2 step of
Stacks 08BG).  Let `j_n : Z_n ⟶ X_n = X ×_V Spec (A / Iⁿ)` be morphisms of algebraic spaces
with maps `Z_n ⟶ Z_{n+1}` making the squares over `X_n ⟶ X_{n+1}` cartesian for `n ≥ 1`.  If
`j_1` is a closed immersion, so is every `j_n`, `n ≥ 1`. -/
theorem isClosedImmersion_of_isClosedImmersion_one
    (Z : ℕ → AlgebraicSpaces B S hS) (j : ∀ n, Z n ⟶ fibreSpace V I f n)
    (k : ∀ n, Z n ⟶ Z (n + 1))
    (hsq : ∀ n, 1 ≤ n → IsPullback (k n).hom (j n).hom (j (n + 1)).hom
      (fibreTransition V I f (Nat.le_succ n)).hom)
    (hj : IsClosedImmersion B S hS (j 1).hom) :
    ∀ n, 1 ≤ n → IsClosedImmersion B S hS (j n).hom := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => exact hj
  | succ n hn ih =>
    have hm : 0 < n := hn
    have hbc : IsClosedImmersion B S hS
        (pullback.snd (j (n + 1)).hom (fibreTransition V I f (Nat.le_succ n)).hom) := by
      have sq : IsPullback (hsq n hn).isoPullback.inv
          (pullback.snd (j (n + 1)).hom (fibreTransition V I f (Nat.le_succ n)).hom)
          (j n).hom (𝟙 _) := IsPullback.of_horiz_isIso ⟨by simp⟩
      exact (isClosedImmersion_isStableUnderBaseChange B S hS).of_isPullback sq ih
    exact isClosedImmersion_of_isClosedImmersion_pullback_snd_of_bijective B S hS (Z (n + 1)).2
      (fibreSpace V I f (n + 1)).2 _ _ (isClosedImmersion_fibreTransition V I f _)
      ⟨@pointsMap_injective_of_mono B S hS _ _ _
        (mono_of_isClosedImmersion B S hS _ (isClosedImmersion_fibreTransition V I f _)),
        surjective_pointsMap_fibreTransition V I f hm _⟩ hbc
      (Or.inr (isFinitePresentation_fibreTransition V I f _))

/-- **Stacks 08BG, from Stacks 08BE and 08B9.**  Let `A = Γ(V)` be Noetherian and `I`-adically
complete, let `X` be separated and of finite type over `V`, and let `X_n = X ×_V Spec (A / Iⁿ)`.
Let `j_n : Z_n ⟶ X_n` be morphisms of algebraic spaces with maps `Z_n ⟶ Z_{n+1}` making the
squares over `X_n ⟶ X_{n+1}` cartesian, with `Z_1` proper over `V` and `Z_1 ⟶ X_1` a closed
immersion.  Then every `j_n` is a closed immersion and there is a closed subspace `Z ⊆ X`,
proper over `V`, whose intersection with every `X_n` is the image of `Z_n`, that is
`Z_n = Z ×_X X_n`. -/
theorem exists_closedSubspace_of_isClosedImmersion_one (h08B9 : CompletionBijectiveOnHoms V I f)
    (h08BE : CompletionProperOverIsEquivalence V I f)
    (hcomp : IsAdicComplete I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
    (hsep : IsSeparated B S hS f.hom) (hft : IsFiniteType B S hS f.hom)
    (Z : ℕ → AlgebraicSpaces B S hS) (j : ∀ n, Z n ⟶ fibreSpace V I f n)
    (k : ∀ n, Z n ⟶ Z (n + 1))
    (hsq : ∀ n, 1 ≤ n → IsPullback (k n).hom (j n).hom (j (n + 1)).hom
      (fibreTransition V I f (Nat.le_succ n)).hom)
    (hj : IsClosedImmersion B S hS (j 1).hom)
    (hp : IsProper B S hS ((j 1).hom ≫ (fibreInclusion V I f 1).hom ≫ f.hom)) :
    (∀ n, 1 ≤ n → IsClosedImmersion B S hS (j n).hom) ∧
    ∃ W : ClosedSubspaces B S hS X.1, IsProper B S hS (subspaceInclusion B S hS X W ≫ f).hom ∧
      ∀ n, 1 ≤ n → W.1 ⊓ (thickeningSubspace V I f n).1 =
        Subfunctor.range ((j n).hom ≫ (fibreInclusion V I f n).hom) := by
  have hjn := isClosedImmersion_of_isClosedImmersion_one V I f Z j k hsq hj
  obtain ⟨W, hW, hWn⟩ := exists_closedSubspace_of_closedImmersion_tower V I f h08B9 h08BE hcomp
    hsep hft Z j k hsq hjn hp
  exact ⟨hjn, W, hW, hWn⟩

end AlgebraicGeometry.Space

end
