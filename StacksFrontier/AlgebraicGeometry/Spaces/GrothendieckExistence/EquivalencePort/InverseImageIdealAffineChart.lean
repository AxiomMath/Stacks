module

public import StacksFrontier.AlgebraicGeometry.Spaces.PullbackIdealChartGeneration

namespace AlgebraicGeometry.Space.C1573
end AlgebraicGeometry.Space.C1573

/-!
# The inverse-image ideal over an affine chart lying over one affine chart of the target

Let `f : Y ⟶ X` be a representable morphism of algebraic spaces over a scheme `S` contained in a
big fppf site `B`, let `I ⊆ 𝒪_X` be a sheaf of ideals cartesian on affine charts and let `Q` be
an affine étale chart of `X`.  Over an affine étale chart `V` of `Y` carrying a morphism
`v : V ⟶ Q ×_X Y`, the sections of the inverse-image ideal `f⁻¹I · 𝒪_Y` are exactly the
extension of the ideal `I(Q)` along `𝒪_X(Q) ⟶ 𝒪_Y(Q ×_X Y) ⟶ 𝒪_Y(V)`.

The inclusion `⊇` holds because the pulled-back sections of `I(Q)` lie in the inverse-image
ideal.  For `⊆`, a section of the inverse-image ideal lies, over the members of a covering sieve,
in the objectwise ideal generated by restricted pullbacks
(`AlgebraicGeometry.Space.mem_pullbackIdealSubsheaf_iff`); over the affine members that ideal is
generated from the one chart `Q` (`AlgebraicGeometry.Space.pullbackChartIdeal_le_map`), and
membership in an ideal of regular functions on an affine chart descends along an étale covering
(`AlgebraicGeometry.Space.mem_of_forall_restrict_mem_map`).

## Main results

* `AlgebraicGeometry.Space.C1573.pullbackIdealSubsheaf_obj_of_isAffine`: the description.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

open _root_.AlgebraicGeometry.Space.C1573
variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X) (hf : yoneda.relativelyRepresentable f.hom)
  (I : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule)

/-- The extension of the sections of `I` over a chart `Q` of `X` to a chart `V` of `Y` lying over
`Q ×_X Y` lies in the inverse-image ideal. -/
theorem C1573.map_le_pullbackIdealSubsheaf_obj (Q : SmallEtale B S hS X.1)
    (V : SmallEtale B S hS Y.1)
    (v : V ⟶ (smallBaseChange B S hS f hf).obj Q) :
    Ideal.map (chartSectionsRestrict B S hS Y v)
        (Ideal.map (chartIdealPullbackHom B S hS f hf Q) (chartSectionsIdeal B S hS X I Q)) ≤
      chartSectionsIdeal B S hS Y (pullbackIdealSubsheaf B S hS f hf I) V := by
  refine Ideal.map_le_iff_le_comap.2 (Ideal.map_le_iff_le_comap.2 fun a ha => ?_)
  have h := chartIdealPullbackHom_mem_pullbackIdealSubsheaf B S hS f hf I Q ha
  exact (pullbackIdealSubsheaf B S hS f hf I).map v.op h

/-- **The inverse-image ideal over an affine chart lying over one affine chart of the target.**
For an ideal `I ⊆ 𝒪_X` cartesian on affine charts, an affine chart `Q` of `X` and an affine chart
`V` of `Y` with a morphism `v : V ⟶ Q ×_X Y`, the sections of `f⁻¹I · 𝒪_Y` over `V` are the
extension of `I(Q)` along `𝒪_X(Q) ⟶ 𝒪_Y(Q ×_X Y) ⟶ 𝒪_Y(V)`. -/
theorem C1573.pullbackIdealSubsheaf_obj_of_isAffine
    (hI : IsCartesianOnAffineCharts (hF := X.2) I.toSheafOfModules)
    (Q : SmallEtale B S hS X.1)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    (V : SmallEtale B S hS Y.1) (v : V ⟶ (smallBaseChange B S hS f hf).obj Q)
    (hV : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    chartSectionsIdeal B S hS Y (pullbackIdealSubsheaf B S hS f hf I) V =
      Ideal.map (chartSectionsRestrict B S hS Y v)
        (Ideal.map (chartIdealPullbackHom B S hS f hf Q) (chartSectionsIdeal B S hS X I Q)) := by
  refine le_antisymm (fun s hs => ?_) (map_le_pullbackIdealSubsheaf_obj B S hS f hf I Q V v)
  obtain ⟨T, hT, hTs⟩ := (mem_pullbackIdealSubsheaf_iff B S hS f hf I).1 hs
  refine mem_of_forall_restrict_mem_map B S hS Y hV hT _ fun W g hg hW => ?_
  have h1 := pullbackChartIdeal_le_map B S hS f hf I hI Q hQ W (g ≫ v) hW (hTs g hg)
  rw [map_chartSectionsRestrict_comp] at h1
  exact h1

end AlgebraicGeometry.Space

end
