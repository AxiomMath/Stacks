/-!
# The sheaf of ideals `I 𝒪_X` read on an étale chart

For an algebraic space `X` over `Spec A` and an ideal `I ⊆ A`, the sheaf of ideals `I 𝒪_X`
induces on the scheme of every étale chart `C` of `X` the sheaf of ideals `I 𝒪_C` generated by
the image of `I` along the structure morphism `C ⟶ Spec A`.

## Main results

* `AlgebraicGeometry.Space.C1573.idealSheafDataOfChart_baseIdealSheaf`: `I 𝒪_X` read on an étale
  chart `C` is `I 𝒪_C`.
* `AlgebraicGeometry.Space.C1573.map_chartSectionsRingHom_baseIdealSheaf`: the chart comparison
  of scalars carries `I 𝒪_C` onto `I 𝒪_X` over every affine Zariski open of the chart scheme.
-/

namespace AlgebraicGeometry.Scheme.Opens.C1573
end AlgebraicGeometry.Scheme.Opens.C1573
namespace AlgebraicGeometry.Space.C1573
end AlgebraicGeometry.Space.C1573

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry

/-- Global functions pulled back along `U.ι ≫ g` and read on `U` through `U.topIso` are the
restrictions to `U` of the global functions pulled back along `g`. -/
theorem Scheme.Opens.C1573.comp_appTop_topIso_hom {Y Z : Scheme.{u}} (U : Y.Opens) (g : Y ⟶ Z) :
    (U.ι ≫ g).appTop ≫ U.topIso.hom = g.appTop ≫ Y.presheaf.map (homOfLE le_top).op := by
  rw [Scheme.Hom.comp_appTop, Category.assoc, Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
  congr 1
  exact (Y.presheaf.map_comp _ _).symm

namespace Space

open _root_.AlgebraicGeometry.Space.C1573
variable {B : BigFppfSite.{u}} {A : Type u} [CommRing A] {hA : B.Contains (Spec (.of A))}

/-- **`I 𝒪_X` read on an étale chart is `I 𝒪_C`.** -/
theorem C1573.idealSheafDataOfChart_baseIdealSheaf (X : AlgebraicSpaces B (Spec (.of A)) hA)
    (I : Ideal A) (C : SmallEtale B (Spec (.of A)) hA X.1) :
    idealSheafDataOfChart B (Spec (.of A)) hA X (baseIdealSubmodule X.1 X.2 I)
        (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B (Spec (.of A)) hA X.1 X.2 _
          (isQuasicoherentOnSite_baseIdealSubmodule (X := X.1) (hX := X.2) I)) C =
      Stacks.Cohomology.FormalFunctions.baseIdealSheaf A I
        (B.inclusion.map ((SmallEtale.toOver B (Spec (.of A)) hA X.1).obj C).hom) := by
  refine Scheme.IdealSheafData.ext (funext fun W => ?_)
  have h1 : (idealSheafDataOfChart B (Spec (.of A)) hA X (baseIdealSubmodule X.1 X.2 I)
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B (Spec (.of A)) hA X.1 X.2 _
        (isQuasicoherentOnSite_baseIdealSubmodule (X := X.1) (hX := X.2) I)) C).ideal W =
      Ideal.map ((openChartTopRingHom B (Spec (.of A)) hA X C W.1).comp
        (specBaseChartHom X.1 X.2 (openChart B (Spec (.of A)) hA X.1 C W.1))) I :=
    (congrArg (Ideal.map (openChartTopRingHom B (Spec (.of A)) hA X C W.1))
      (chartIdeal_baseIdealSubmodule_of_isAffine I _ W.2)).trans (Ideal.map_map _ _)
  refine h1.trans
    (Eq.trans ?_ (Stacks.Cohomology.FormalFunctions.baseIdealSheaf_ideal A I _ W).symm)
  refine Eq.trans ?_ (Ideal.map_map _ _).symm
  congr 1
  refine RingHom.ext fun a => ?_
  have h2 := inclusion_map_openSub_hom B (Spec (.of A)) hA
    ((SmallEtale.toOver B (Spec (.of A)) hA X.1).obj C) W.1
  have h3 := Scheme.Opens.C1573.comp_appTop_topIso_hom W.1
    (B.inclusion.map ((SmallEtale.toOver B (Spec (.of A)) hA X.1).obj C).hom)
  have h4 := congrArg (fun k => k.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) h3
  refine Eq.trans ?_ h4
  change W.1.topIso.hom.hom ((B.inclusion.map ((SmallEtale.toOver B (Spec (.of A)) hA X.1).obj
    (openChart B (Spec (.of A)) hA X.1 C W.1)).hom).appTop.hom
      ((Scheme.ΓSpecIso (.of A)).inv.hom a)) = _
  exact congrArg (fun k => W.1.topIso.hom.hom (k.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)))
    h2

/-- **The chart comparison of scalars carries `I 𝒪_C` onto `I 𝒪_X`** over the comparison chart
of every affine Zariski open of the chart scheme. -/
theorem C1573.map_chartSectionsRingHom_baseIdealSheaf (X : AlgebraicSpaces B (Spec (.of A)) hA)
    (I : Ideal A) (C : SmallEtale B (Spec (.of A)) hA X.1) (W : (chartScheme C).Opens)
    (hW : IsAffineOpen W) :
    Ideal.map (chartSectionsRingHom B (Spec (.of A)) hA X C W)
        ((Stacks.Cohomology.FormalFunctions.baseIdealSheaf A I
          (B.inclusion.map ((SmallEtale.toOver B (Spec (.of A)) hA X.1).obj C).hom)).ideal
            ⟨W, hW⟩) =
      chartSectionIdeal B (Spec (.of A)) hA X.1 X.2 (baseIdealSubmodule X.1 X.2 I)
        (openChartOfComparison B (Spec (.of A)) hA X C W) := by
  rw [← idealSheafDataOfChart_baseIdealSheaf X I C]
  exact map_chartSectionsRingHom_openChartIdeal B (Spec (.of A)) hA X _ C W

end Space

end AlgebraicGeometry

end
