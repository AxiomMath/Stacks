/-!
# A thickening of an affine algebraic space is affine

Let `G ⊂ X` be a thickening of algebraic spaces over a scheme `S`, of arbitrary order. If `G` is
affine, then so is `X`.

## Main results

* `AlgebraicGeometry.Space.C1573.isInvariantSubscheme_ofIdealTop`: an ideal of an affine chart
  whose two extensions to the relation of the chart agree cuts out an invariant subscheme.
* `AlgebraicGeometry.Space.C1573.exists_fg_invariant_ideal`: on an affine surjective étale chart of
  a quasi-compact quasi-separated algebraic space, every element of the defining ideal of a closed
  subspace lies in a finitely generated invariant ideal contained in it (Stacks 0829 read on the
  chart).
* `AlgebraicGeometry.Space.C1573.isAffineSpace_of_isThickening`: the statement above.

## Implementation notes

The ideal `J` cutting out `G` on an affine surjective étale chart `U'` of `X` consists of
nilpotent elements but need not be nilpotent, so the finite-order argument
(`AlgebraicGeometry.Space.C1573.isAffineSpace_of_isThickeningHom_of_isNilpotent_chart`) does not
apply directly. Instead `J` is the directed union of its finitely generated invariant subideals
(Stacks 0829, through `AlgebraicGeometry.Space.chartExtensionProperty_id`); each cuts out a closed
subspace `V_K ⊂ X` containing `G`, with nilpotent ideal on the chart; `G` is the inverse limit of
the `V_K` (the geometric half of Stacks 0A0U), so by Stacks 07SQ for a system of closed
immersions one of them is affine, and then `X` is affine by the finite-order case applied to
`V_K ⊂ X`.

## References

* [Stacks Project, Tag 05ZR](https://stacks.math.columbia.edu/tag/05ZR)
* [Stacks Project, Tag 07SQ](https://stacks.math.columbia.edu/tag/07SQ)
* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 0A0U](https://stacks.math.columbia.edu/tag/0A0U)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

open _root_.AlgebraicGeometry.C1573 _root_.AlgebraicGeometry.Space.C1573
variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Invariant ideals of an affine chart -/

section Invariant

variable {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {U : BigFppfOver B S hS}
  [IsAffine ((BigFppfOver.toScheme B S hS).obj U)] {φ : yoneda.obj U ⟶ X}
  (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
    (@Surjective.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS))) φ)

/-- The extension of an ideal of an affine scheme along a morphism, as an ideal sheaf: the
inverse image of the ideal sheaf it generates. Its ideal on an affine open `V` is generated by the
restrictions of the pullbacks of the elements of the ideal. -/
@[ega "II 1.4.11" "special case"]
theorem C1573.ideal_comap_ofIdealTop {Y Y₀ : Scheme.{u}} [IsAffine Y₀] (p : Y ⟶ Y₀)
    (K : Ideal Γ(Y₀, ⊤)) (V : Y.Opens) (hV : IsAffineOpen V) :
    ((Scheme.IdealSheafData.ofIdealTop K).comap p).ideal ⟨V, hV⟩ =
      (K.map p.appTop.hom).map (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom := by
  rw [Stacks.Divisors.ideal_comap_appLE _ p ⊤ (isAffineOpen_top Y₀) V hV le_top,
    Stacks.Divisors.ideal_ofIdealTop_top, Ideal.map_map]
  rfl

include hs in
/-- **An ideal of an affine chart whose two extensions to the relation agree cuts out an
invariant subscheme.** -/
theorem C1573.isInvariantSubscheme_ofIdealTop
    (K : Ideal Γ((BigFppfOver.toScheme B S hS).obj U, ⊤))
    (h : K.map ((BigFppfOver.toScheme B S hS).map (atlasRelationTarget B S hS hs)).appTop.hom =
      K.map ((BigFppfOver.toScheme B S hS).map (atlasRelationSource B S hS hs)).appTop.hom) :
    IsInvariantSubscheme B S hS hs
      (Subobject.mk (Scheme.IdealSheafData.ofIdealTop K).subschemeι) := by
  have hc : (Scheme.IdealSheafData.ofIdealTop K).comap
        ((BigFppfOver.toScheme B S hS).map (atlasRelationTarget B S hS hs)) =
      (Scheme.IdealSheafData.ofIdealTop K).comap
        ((BigFppfOver.toScheme B S hS).map (atlasRelationSource B S hS hs)) := by
    refine Scheme.IdealSheafData.ext (funext fun V => ?_)
    obtain ⟨V, hV⟩ := V
    refine (ideal_comap_ofIdealTop _ K V hV).trans ?_
    rw [h]
    exact (ideal_comap_ofIdealTop _ K V hV).symm
  unfold IsInvariantSubscheme
  rw [Scheme.IdealSheafData.pullback_subobject_mk_subschemeι,
    Scheme.IdealSheafData.pullback_subobject_mk_subschemeι, hc]

end Invariant

/-! ### Finitely generated invariant subideals of the defining ideal (Stacks 0829) -/

section Exhaustion

variable (X : AlgebraicSpaces B S hS) {U : BigFppfOver B S hS}
  [IsAffine ((BigFppfOver.toScheme B S hS).obj U)] {φ : yoneda.obj U ⟶ X.1}
  (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
    (@Surjective.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS))) φ)
  (he : (MorphismProperty.presheaf (MorphismProperty.inverseImage
    (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)

/-- The relation `R = U ×_X U` of a surjective étale chart, as an étale chart of `X`. -/
noncomputable abbrev C1573.atlasRelationChart : SmallEtale B S hS X.1 :=
  ⟨CostructuredArrow.mk (yoneda.map (atlasRelationSource B S hS hs) ≫ φ),
    etale_comp_of_scheme B S hS _ φ (he.2 φ (hs.rep.fst φ) (hs.rep.snd φ) (hs.rep.isPullback φ))
      he⟩

/-- The two projections of the relation of a surjective étale chart, as morphisms of the small
étale site. -/
noncomputable def C1573.atlasRelationChartHom (b : Bool) :
    atlasRelationChart B S hS X hs he ⟶ chartOfSurjectiveEtale B S hS X he :=
  ObjectProperty.homMk (CostructuredArrow.homMk
    (if b then atlasRelationTarget B S hS hs else atlasRelationSource B S hS hs) (by
      cases b
      · rfl
      · change yoneda.map (yoneda.preimage (hs.rep.fst φ)) ≫ φ = _
        rw [Functor.map_preimage]
        exact (hs.rep.isPullback φ).w))

include he in
/-- **Stacks 0829 on a chart.** On an affine surjective étale chart `U` of a quasi-compact
quasi-separated algebraic space `X`, every element of the defining ideal of a closed subspace
`Z` lies in a finitely generated ideal contained in that defining ideal, whose two extensions to
the relation `R = U ×_X U` agree. -/
theorem C1573.exists_fg_invariant_ideal (hZ : B.Contains (⊤_ Scheme.{u}))
    (hqc : IsQuasiCompactSpace B S hS X.1) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (Z : ClosedSubspaces B S hS X.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj (atlasRelation B S hS hs))]
    (σ : Γ((BigFppfOver.toScheme B S hS).obj U, ⊤))
    (hσ : σ ∈ RingHom.ker ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd φ)).appTop.hom) :
    ∃ K : Ideal Γ((BigFppfOver.toScheme B S hS).obj U, ⊤), K.FG ∧ σ ∈ K ∧
      K ≤ RingHom.ker ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd φ)).appTop.hom ∧
      K.map ((BigFppfOver.toScheme B S hS).map (atlasRelationTarget B S hS hs)).appTop.hom =
        K.map ((BigFppfOver.toScheme B S hS).map (atlasRelationSource B S hS hs)).appTop.hom := by
  classical
  let Fm : Modules.{u, u} B S hS X.1 X.2 := (definingIdealSheaf B S hS X Z).toSheafOfModules
  have hF : IsCartesianOnAffineCharts Fm := definingIdealSheaf_isCartesianOnAffineCharts B S hS X Z
  have hP := chartExtensionProperty_id (hX := X.2) (F := Fm) hZ hqc hqs hF
  let T := chartOfSurjectiveEtale B S hS X he
  have hT : IsAffine (chartScheme T) := ‹_›
  have hmem : ∀ x : Γ((BigFppfOver.toScheme B S hS).obj U, ⊤),
      x ∈ definingIdealAt B S hS X Z (op T) ↔
        x ∈ RingHom.ker ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd φ)).appTop.hom := by
    intro x
    rw [definingIdealAt_eq_ker B S hS X Z T]
    rfl
  obtain ⟨D, hD⟩ := hP T T.1.hom (Category.comp_id _) hT ⟨σ, (hmem σ).2 hσ⟩
  let D₀ := D.obj T T.1.hom (Category.comp_id _)
  have hspan : ∀ (T' : (smallEtaleRingedSite B S hS X.1 X.2).C) [IsAffine (chartScheme T')]
      (t : Set (Fm.val.obj (op T'))),
      (Ideal.span (Subtype.val '' {y | y ∈ Submodule.span (chartRing B S hS X.1 X.2 T') t}) :
          Ideal Γ(chartScheme T', ⊤)) =
        (Ideal.span (Subtype.val '' t) : Ideal Γ(chartScheme T', ⊤)) := by
    intro T' _ t
    refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_mono (Set.image_mono
      (Submodule.subset_span (R := chartRing B S hS X.1 X.2 T'))))
    rintro _ ⟨y, hy, rfl⟩
    change y ∈ Submodule.span _ t at hy
    induction hy using Submodule.span_induction with
    | mem y hy => exact Ideal.subset_span ⟨y, hy, rfl⟩
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz
    | smul r y _ hy => exact Ideal.mul_mem_left _ r hy
  let K : Ideal Γ((BigFppfOver.toScheme B S hS).obj U, ⊤) :=
    Ideal.span (Subtype.val '' {y | y ∈ D₀})
  have hKle : K ≤ RingHom.ker ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd φ)).appTop.hom := by
    refine Ideal.span_le.2 ?_
    rintro _ ⟨y, -, rfl⟩
    exact (hmem y.1).1 y.2
  refine ⟨K, ?_, Ideal.subset_span ⟨⟨σ, (hmem σ).2 hσ⟩, hD, rfl⟩, hKle, ?_⟩
  · obtain ⟨t, htf, ht⟩ := Submodule.fg_def.1 (D.fg_obj hF hT T.1.hom (Category.comp_id _))
    rw [show K = _ from (congrArg (fun N ↦ Ideal.span (Subtype.val '' {y | y ∈ N})) ht.symm).trans
      (hspan T t)]
    exact ⟨(htf.image (Subtype.val : Fm.val.obj (op T) →
      Γ((BigFppfOver.toScheme B S hS).obj U, ⊤))).toFinset, Set.Finite.coe_toFinset _ ▸ rfl⟩
  · -- The invariance, read on the relation chart.
    let TR := atlasRelationChart B S hS X hs he
    have hTR : IsAffine (chartScheme TR) :=
      inferInstanceAs (IsAffine ((BigFppfOver.toScheme B S hS).obj (atlasRelation B S hS hs)))
    have hside : ∀ b : Bool,
        K.map ((BigFppfOver.toScheme B S hS).map
          (if b then atlasRelationTarget B S hS hs else atlasRelationSource B S hS hs)).appTop.hom =
        (Ideal.span (Subtype.val '' {y | y ∈ D.obj TR
          (yoneda.map (atlasRelationChartHom B S hS X hs he b).hom.left ≫ T.1.hom)
          (chartOver_comp _ (Category.comp_id _))}) :
          Ideal Γ((BigFppfOver.toScheme B S hS).obj (atlasRelation B S hS hs), ⊤)) := by
      intro b
      rw [D.obj_eq_span hF hT hTR (atlasRelationChartHom B S hS X hs he b) T.1.hom
        (Category.comp_id _), hspan TR, Ideal.map_span]
      simp only [Set.image_image]
      erw [Set.image_image]
      rfl
    have h₁ := hside true
    have h₂ := hside false
    simp only [if_true, Bool.false_eq_true, if_false] at h₁ h₂
    rw [h₁, h₂]
    have heq : yoneda.map (atlasRelationChartHom B S hS X hs he true).hom.left ≫ T.1.hom =
        yoneda.map (atlasRelationChartHom B S hS X hs he false).hom.left ≫ T.1.hom := by
      show yoneda.map (atlasRelationTarget B S hS hs) ≫ φ =
        yoneda.map (atlasRelationSource B S hS hs) ≫ φ
      rw [Functor.map_preimage]
      exact (hs.rep.isPullback φ).w
    rw [D.obj.congr TR heq _ (chartOver_comp _ (Category.comp_id _))]

end Exhaustion

/-! ### The theorem -/

section Main

/-- On an affine object of the site, an ideal sheaf generated by a global ideal is contained in
an ideal sheaf exactly when the ideal is contained in its global sections. -/
theorem C1573.ofIdealTop_le_iff {Y : Scheme.{u}} [IsAffine Y] (K : Ideal Γ(Y, ⊤))
    (I : Y.IdealSheafData) :
    Scheme.IdealSheafData.ofIdealTop K ≤ I ↔ K ≤ I.ideal ⟨⊤, isAffineOpen_top Y⟩ := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · simpa only [Stacks.Divisors.ideal_ofIdealTop_top] using h ⟨⊤, isAffineOpen_top Y⟩
  · rw [← (Scheme.IdealSheafData.equivOfIsAffine (X := Y)).symm_apply_apply I]
    exact (Scheme.IdealSheafData.equivOfIsAffine (X := Y)).symm.toOrderIso.monotone h

/-- **Stacks 05ZR, the affine case: a thickening of an affine algebraic space is affine.** Let
`G ⊂ X` be a thickening of algebraic spaces over `S`, of arbitrary order. If `G` is affine, then
`X` is affine. -/
theorem C1573.isAffineSpace_of_isThickening {X : AlgebraicSpaces B S hS} {G : Subfunctor X.1}
    (hG : IsThickening B S hS X G) (hGa : IsAffineSpace B S hS G.toFunctor) :
    IsAffineSpace B S hS X.1 := by
  classical
  have hZ := B.contains_terminal
  have hci : IsClosedImmersion B S hS G.ι := hG.1.2
  have hqc : IsQuasiCompactSpace B S hS X.1 :=
    IsQuasiCompactSpace.of_isSurjective B S hS hG.1.1 X.property hG.2 hGa.isQuasiCompactSpace
  have hsep : IsAbsolutelySeparated B S hS hZ X.1 :=
    isAbsolutelySeparated_of_isSurjective_of_universallyClosed B S hS hZ hG.1.1 X.property
      G.ι hG.2 (universallyClosed_of_isClosedImmersion B S hS hG.1.1 X.property G.ι hci)
      (isAbsolutelySeparated_of_isAffineSpace B S hS hZ hGa)
  have hqs := isAbsolutelyQuasiSeparated_of_isAbsolutelySeparated B S hS hZ _ hsep
  obtain ⟨W', w', hW'a, hw's, hw'e⟩ :=
    (isQuasiCompactSpace_iff_exists_affine_etale_surjective_cover B S hS X.1 X.property).1 hqc
  have := hW'a
  have hw'e' := (isEtale_iff_presheaf_of_yoneda B S hS w').1 hw'e
  -- The relation of the chart is affine.
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj (atlasRelation B S hS hw's)) := by
    obtain ⟨R'a, pa, q₂, hR'a⟩ := isAffineHom_of_affine_source_of_isAbsolutelySeparated B S hS
      hZ ⟨W', inferInstance⟩ w' hsep ⟨W', inferInstance⟩ w'
    let e := (hw's.rep.isPullback w').isoIsPullback _ _ hR'a
    have : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((BigAffineFppf.inclusion B S hS).obj R'a)) := R'a.property
    exact IsAffine.of_isIso ((BigFppfOver.toScheme B S hS).map
      (Yoneda.fullyFaithful.preimageIso e).hom)
  -- The chart ideal `J` of `G`, a nil ideal.
  let ZG : ClosedSubspaces B S hS X.1 := ⟨G, hG.1⟩
  let jG := (BigFppfOver.toScheme B S hS).map (hci.rep.snd w')
  have hjci : _root_.AlgebraicGeometry.IsClosedImmersion jG :=
    hci.property w' _ _ (hci.rep.isPullback w')
  have hjsurj : Surjective jG := by
    have hpbSp : IsPullback
        (ObjectProperty.homMk (hci.rep.fst w') :
          (⟨_, isAlgebraicSpace_yoneda B S hS (hci.rep.pullback w')⟩ : AlgebraicSpaces B S hS) ⟶
            ⟨_, hG.1.1⟩)
        (ObjectProperty.homMk (yoneda.map (hci.rep.snd w')) :
          (⟨_, isAlgebraicSpace_yoneda B S hS (hci.rep.pullback w')⟩ : AlgebraicSpaces B S hS) ⟶
            ⟨_, isAlgebraicSpace_yoneda B S hS W'⟩)
        (ObjectProperty.homMk G.ι : (⟨_, hG.1.1⟩ : AlgebraicSpaces B S hS) ⟶ X)
        (ObjectProperty.homMk w' :
          (⟨_, isAlgebraicSpace_yoneda B S hS W'⟩ : AlgebraicSpaces B S hS) ⟶ X) :=
      IsPullback.of_map_of_faithful (ObjectProperty.ι _) (hci.rep.isPullback w')
    exact (BigFppfOver.presheaf_inverseImage_yoneda_map_iff B S hS _ _).1
      ((surjective_yonedaMap_iff_surjective_pointsMap B S hS _).2
        (isSurjective_of_isPullback B S hS hpbSp hG.2))
  have hJnil : ∀ x ∈ RingHom.ker jG.appTop.hom, IsNilpotent x := fun x hx ↦
    Stacks.Thickenings.IsThickening.isNilpotent_of_mem_ker_appTop ⟨hjci, hjsurj.surj⟩ hx
  have hJker : jG.ker.ideal ⟨⊤, isAffineOpen_top _⟩ = RingHom.ker jG.appTop.hom :=
    Scheme.Hom.ker_apply jG _
  -- The finitely generated invariant subideals of `J`.
  let tgt := (BigFppfOver.toScheme B S hS).map (atlasRelationTarget B S hS hw's)
  let src := (BigFppfOver.toScheme B S hS).map (atlasRelationSource B S hS hw's)
  let I := {K : Ideal Γ((BigFppfOver.toScheme B S hS).obj W', ⊤) //
    K.FG ∧ K ≤ RingHom.ker jG.appTop.hom ∧ K.map tgt.appTop.hom = K.map src.appTop.hom}
  have : IsDirected I (· ≤ ·) := ⟨fun a b ↦ ⟨⟨a.1 ⊔ b.1, Submodule.FG.sup a.2.1 b.2.1,
    sup_le a.2.2.1 b.2.2.1, by rw [Ideal.map_sup, Ideal.map_sup, a.2.2.2, b.2.2.2]⟩,
    le_sup_left (a := a.1), le_sup_right (b := b.1)⟩⟩
  let i₀ : I := ⟨⊥, Submodule.fg_bot, bot_le, by rw [Ideal.map_bot, Ideal.map_bot]⟩
  let K : I → ((BigFppfOver.toScheme B S hS).obj W').IdealSheafData :=
    fun i ↦ Scheme.IdealSheafData.ofIdealTop i.1
  have hKinv : ∀ i, IsInvariantSubscheme B S hS hw's (Subobject.mk (K i).subschemeι) :=
    fun i ↦ isInvariantSubscheme_ofIdealTop B S hS hw's i.1 i.2.2.2
  have hKmono : Monotone K := fun _ _ hab ↦ (Scheme.IdealSheafData.equivOfIsAffine
    (X := (BigFppfOver.toScheme B S hS).obj W')).symm.toOrderIso.monotone hab
  let Zs : I → ClosedSubspaces B S hS X.1 := invariantStage B S hS X hw's hw'e' K hKinv
  let Uc := chartOfSurjectiveEtale B S hS X hw'e'
  have hZsK : ∀ i, etaleChartKer B S hS X (Zs i) Uc = K i :=
    etaleChartKer_invariantStage B S hS X hw's hw'e' K hKinv
  have hanti : ∀ ⦃i j : I⦄, i ≤ j → (Zs j).1 ≤ (Zs i).1 := fun _ _ h ↦
    invariantStage_antitone B S hS X hw's hw'e' K hKinv hKmono h
  have hle : ∀ i, G ≤ (Zs i).1 := fun i ↦
    le_of_etaleChartKer_le_of_chart B S hS X ZG (Zs i) Uc hw's (by
      rw [hZsK]
      refine (ofIdealTop_le_iff _ _).2 ?_
      show i.1 ≤ jG.ker.ideal ⟨⊤, isAffineOpen_top _⟩
      rw [hJker]
      exact i.2.2.1)
  have hge : (⨅ i, (Zs i).1) ≤ G := by
    refine iInf_le_of_etaleChartKer_le_iSup_of_chart B S hS X Zs ZG Uc hw's ?_
    simp_rw [hZsK]
    show jG.ker ≤ _
    rw [← (Scheme.IdealSheafData.equivOfIsAffine
        (X := (BigFppfOver.toScheme B S hS).obj W')).symm_apply_apply jG.ker,
      Scheme.IdealSheafData.equivOfIsAffine_symm_apply, Scheme.IdealSheafData.equivOfIsAffine_apply,
      ofIdealTop_le_iff, hJker]
    intro x hx
    obtain ⟨K₀, hK₀fg, hxK₀, hK₀le, hK₀inv⟩ := exists_fg_invariant_ideal B S hS X hw's hw'e' hZ
      hqc hqs ZG x hx
    have h₁ : (K ⟨K₀, hK₀fg, hK₀le, hK₀inv⟩).ideal ⟨⊤, isAffineOpen_top _⟩ = K₀ :=
      Stacks.Divisors.ideal_ofIdealTop_top _ K₀
    have h₂ := le_iSup K (⟨K₀, hK₀fg, hK₀le, hK₀inv⟩ : I)
    exact h₂ ⟨⊤, isAffineOpen_top _⟩ (h₁.symm ▸ hxK₀ :
      x ∈ (K ⟨K₀, hK₀fg, hK₀le, hK₀inv⟩).ideal ⟨⊤, isAffineOpen_top _⟩)
  -- The stages are thickenings of `X` containing `G`.
  have hcomp : ∀ (i : I) g, pointsMap B S hS _ (Zs i).1.ι
      (pointsMap B S hS _ (Subfunctor.homOfLe (hle i)) g) = pointsMap B S hS _ G.ι g := by
    intro i g
    rw [← Function.comp_apply (f := pointsMap B S hS _ (Zs i).1.ι), ← pointsMap_comp,
      Subfunctor.homOfLe_ι]
  have hsurjStage : ∀ i, IsSurjective B S hS (Subfunctor.homOfLe (hle i)) := by
    intro i z
    obtain ⟨g, hg⟩ := hG.2 (pointsMap B S hS _ (Zs i).1.ι z)
    exact ⟨g, pointsMap_injective_of_mono B S hS (Zs i).1.ι ((hcomp i g).trans hg)⟩
  have hciStage : ∀ i, IsClosedImmersion B S hS (Subfunctor.homOfLe (hle i)) := fun i ↦
    isClosedImmersion_homOfLe B S hS ZG (hle i)
  -- The descent situation of the stages, with limit `G`.
  let E : DescentSituation B S hS hZ I :=
    { system := closedSubspaceDiagram B S hS (fun i ↦ (Zs i).1) hanti
      algebraicSpace := fun i ↦ (Zs i).2.1
      transition_affine := fun f ↦ isAffineHom_of_isClosedImmersion B S hS _
        (isClosedImmersion_closedSubspaceDiagram_map B S hS Zs hanti f)
      quasiCompact := fun i ↦ IsQuasiCompactSpace.of_isSurjective B S hS hG.1.1 (Zs i).2.1
        (hsurjStage i) hGa.isQuasiCompactSpace
      quasiSeparated := fun i ↦ isAbsolutelyQuasiSeparated_of_isAbsolutelySeparated B S hS hZ _
        (isAbsolutelySeparated_of_isSurjective_of_universallyClosed B S hS hZ hG.1.1 (Zs i).2.1
          _ (hsurjStage i) (universallyClosed_of_isClosedImmersion B S hS hG.1.1 (Zs i).2.1 _
            (hciStage i)) (isAbsolutelySeparated_of_isAffineSpace B S hS hZ hGa))
      limitCone := closedSubspaceCone B S hS (fun i ↦ (Zs i).1) hanti G hle
      isLimit := isLimitClosedSubspaceCone B S hS i₀ _ hanti G hle hge
      limitAlgebraicSpace := hG.1.1
      base := i₀ }
  -- Stacks 07SQ: some stage is affine.
  have hcard : Cardinal.mk I < B.cutoff := by
    have hΓ : Cardinal.mk Γ((BigFppfOver.toScheme B S hS).obj W', ⊤) < B.cutoff :=
      lt_of_le_of_lt (Scheme.mk_sections_le_two_pow_size _ ⊤)
        (B.cutoff_isStrongPrelimit W'.left.property)
    refine lt_of_le_of_lt ?_ (B.cutoff_isStrongPrelimit hΓ)
    rw [← Cardinal.mk_set]
    exact Cardinal.mk_le_of_injective (f := fun i : I ↦ (i.1 : Set _))
      (fun a b hab ↦ Subtype.ext (SetLike.coe_injective hab))
  have htr : ∀ {i j : Iᵒᵖ} (f : i ⟶ j),
      (MorphismProperty.inverseImage (@LocallyOfFiniteType.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (E.system.map f) := fun f ↦
    have hle' : (@_root_.AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u}) ≤
        (@LocallyOfFiniteType.{u} : MorphismProperty Scheme.{u}) := fun _ _ g hg ↦ by
      have : _root_.AlgebraicGeometry.IsClosedImmersion g := hg
      infer_instance
    MorphismProperty.relative_monotone
      (MorphismProperty.monotone_inverseImage (BigFppfOver.toScheme B S hS) hle') _
      (isClosedImmersion_closedSubspaceDiagram_map B S hS Zs hanti f)
  obtain ⟨i, -, hiaff⟩ :=
    (DescentSituation.exists_isAffineSpace_system_obj_of_locallyOfFiniteType (E := E)) hcard htr hGa
  -- The finite-order case for the affine stage.
  have hTi : IsThickening B S hS X (Zs i).1 := ⟨(Zs i).2, fun x ↦ by
    obtain ⟨g, hg⟩ := hG.2 x
    exact ⟨pointsMap B S hS _ (Subfunctor.homOfLe (hle i)) g, (hcomp i g).trans hg⟩⟩
  have hnil : IsNilpotent (RingHom.ker ((BigFppfOver.toScheme B S hS).map
      ((Zs i).2.2.rep.snd w')).appTop.hom) := by
    have h₁ : RingHom.ker ((BigFppfOver.toScheme B S hS).map
        ((Zs i).2.2.rep.snd w')).appTop.hom = i.1 := by
      have hci' : _root_.AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map
          ((Zs i).2.2.rep.snd w')) := (Zs i).2.2.property w' _ _ ((Zs i).2.2.rep.isPullback w')
      have h₂ := Scheme.Hom.ker_apply ((BigFppfOver.toScheme B S hS).map
        ((Zs i).2.2.rep.snd w')) ⟨⊤, isAffineOpen_top _⟩
      refine h₂.symm.trans ?_
      show (etaleChartKer B S hS X (Zs i) Uc).ideal
        ⟨⊤, isAffineOpen_top ((BigFppfOver.toScheme B S hS).obj W')⟩ = _
      rw [hZsK]
      exact Stacks.Divisors.ideal_ofIdealTop_top _ i.1
    rw [h₁]
    exact (Ideal.FG.isNilpotent_iff_le_nilradical i.2.1).2 fun x hx ↦
      mem_nilradical.2 (hJnil x (i.2.2.1 hx))
  exact isAffineSpace_of_isThickeningHom_of_isNilpotent_chart B S hS
    (IsThickening.inclusion B S hS hTi) (isThickeningHom_inclusion B S hS hTi) hiaff w' hw'e'
    hw's ((Zs i).2.2.rep.snd w') ((Zs i).2.2.rep.fst w') ((Zs i).2.2.rep.isPullback w') hnil

