module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.ClassGroupOfUniversalHomeomorphismToLine
public import StacksFrontier.AlgebraicGeometry.Spaces.CoordinateAxesOriginStalk
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.HenselianLocalRingStalk
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.PrimeDivisorOfCodimensionOnePoint
public import StacksFrontier.AlgebraicGeometry.Spaces.OrderOfVanishingElementaryChart

/-!
# The coordinate-axes quotient: its class group and its henselian local ring at the node

Let `k` be a field, `U = Spec (k[x, y]/(xy))`, `R = Δ(U) ⨿ Δ'(U ∖ {0_U})` and `X = U/R`. This
file proves the last two assertions of **Stacks 0ENU**: `Cl(X) = ℤ/2ℤ`, generated by the class
of the unique closed point `x ∈ |X|` over `0 ∈ 𝔸¹_k`, exactly as in Stacks 0ENT; and the
henselian local ring of `X` at `x` is not a domain, being the henselization of `𝒪_{U, 0_U}`.
It then assembles the whole of Stacks 0ENU.

## Main results

* `AlgebraicGeometry.CoordinateAxesQuotient.originDivisor`: the prime divisor of `X` whose
  generic point is the image `x` of the origin of `U`.
* `CoordinateAxesQuotient.ordRationalFunction_coordinatePullbackUnit_originDivisor`:
  the pullback of the coordinate `t` of `𝔸¹_k` vanishes to order two along it, because on the
  chart `U` it is `x + y`, whose order at the origin is `2`.
* `AlgebraicGeometry.CoordinateAxesQuotient.isHenselization_henselianLocalRing_originPoint` and
  `AlgebraicGeometry.CoordinateAxesQuotient.not_isDomain_henselianLocalRing_originPoint`: the
  henselian local ring `𝒪^h_{X, x}` is a henselization of `𝒪_{U, 0_U}` and is not a domain.
* `AlgebraicGeometry.CoordinateAxesQuotient.coordinateAxesQuotient_properties`: **Stacks 0ENU**.

## Implementation notes

The chart `U ⟶ X` is an elementary étale neighbourhood of `x` at the origin, the origin being a
`k`-rational point of `U`. The class group is computed by
`AlgebraicGeometry.Space.weilDivisorClassGroupEquivZModTwo`, the general form of the argument of
Stacks 0ENT, from the universal homeomorphism `X ⟶ 𝔸¹_k`, the isomorphism over `𝔸¹_k ∖ {0}` and
the order of vanishing of `t` along the divisor over the origin. The henselian local ring
contains `𝒪_{U, 0_U}`, the map being faithfully flat, and the germs of `x` and `y` are nonzero
with product zero there.

## References

* [Stacks Project, Tag 0ENU](https://stacks.math.columbia.edu/tag/0ENU)
* [Stacks Project, Tag 0ENT](https://stacks.math.columbia.edu/tag/0ENT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing CochainComplex.DerivedChangeOfRings

universe u

namespace AlgebraicGeometry.CoordinateAxesQuotient

attribute [local instance] Space.pointTopology

variable (S : Setup.{u})

/-- The origin, as a `k`-point of the coordinate axes. -/
def originSection : Spec (.of S.k) ⟶ coordinateAxes S :=
  Spec.map (CommRingCat.ofHom (originRingMap S))

/-- The origin is a section of the structure morphism of the coordinate axes. -/
theorem originSection_comp_baseMap : originSection S ≫ baseMap S = 𝟙 _ := by
  rw [originSection, baseMap, ← Spec.map_comp, ← Spec.map_id]
  congr 1
  ext r
  show originRingMap S (algebraMap S.k (NodalRing S.k) r) = r
  rw [← Ideal.Quotient.mk_algebraMap, originRingMap, Ideal.Quotient.lift_mk,
    MvPolynomial.algebraMap_eq]
  simp [originPolynomialMap]

/-- The origin section sends the closed point of `Spec k` to the origin. -/
theorem originSection_closedPoint : originSection S (closedPoint S.k) = origin S :=
  congrArg (originSection S) (Subsingleton.elim _ _)

/-- The origin is a point of coheight one of the coordinate axes. -/
theorem coheight_origin : Order.coheight (origin S) = 1 := by
  have : IsNoetherianRing (originStalk S) :=
    IsLocalization.isNoetherianRing (origin S).asIdeal.primeCompl _ inferInstance
  have hdim := Ring.ringKrullDim_eq_one_of_mul_eq_zero (originGerm_xSection_mul_ySection S)
    (maximalIdeal_originStalk S) (originGerm_xSection_ne_zero S) (originGerm_ySection_ne_zero S)
  rw [ringKrullDim_stalk_eq_coheight] at hdim
  exact_mod_cast hdim

variable (B : BigFppfSite.{u}) (hS : B.Contains (Spec (.of S.k)))
    [HasSheafify (BigFppfOver.topology B (Spec (.of S.k)) hS) (Type u)]

/-- The chart `U ⟶ X` is étale. -/
theorem isEtale_chart : Space.IsEtale B (Spec (.of S.k)) hS (chart S B hS) :=
  (Space.isEtale_iff_presheaf_of_yoneda B (Spec (.of S.k)) hS _).2 (presheafEtale_chart S B hS)

/-- The point `x` of `X` over the origin: the image of the origin of the chart. -/
def originPoint : Space.points B (Spec (.of S.k)) hS (quotientSpace S B hS).obj :=
  Space.pointsMap B (Spec (.of S.k)) hS _ (chart S B hS)
    (Space.presheafPoint B (Spec (.of S.k)) hS (axesChart S B hS) (origin S)
      (B.residueField_spec_contains (axesChart S B hS).left.property (origin S)))

omit [HasSheafify (BigFppfOver.topology B (Spec (.of S.k)) hS) (Type u)] in
/-- The residue field of the coordinate axes at the origin is the ground field. -/
theorem mono_fromSpecResidueField_origin :
    Mono ((axesChart S B hS).left.1.fromSpecResidueField (origin S) ≫
      (axesChart S B hS).hom.1) := by
  have h := Space.mono_fromSpecResidueField_comp_of_section (baseMap S) (originSection S)
    (originSection_comp_baseMap S)
  rwa [originSection_closedPoint] at h

/-- The chart `U ⟶ X` is an elementary étale neighbourhood of any point `ξ` that the origin maps
to, the origin being a rational point. -/
def originNeighborhood (ξ : Space.points B (Spec (.of S.k)) hS (quotientSpace S B hS).obj)
    (hξ : originPoint S B hS = ξ) :
    Space.ElementaryEtaleNeighborhood B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
      (isAlgebraicSpace_quotientSpace S B hS) ξ :=
  Space.elementaryEtaleNeighborhoodOfMonoStructure B (Spec (.of S.k)) hS (axesChart S B hS)
    (isAlgebraicSpace_quotientSpace S B hS) (chart S B hS) (isEtale_chart S B hS) (origin S)
    (mono_fromSpecResidueField_origin S B hS) ξ hξ

/-- The point over the origin is the generic point of a prime divisor: the origin of the chart
has coheight one. -/
theorem exists_primeDivisor_genericPoint_eq_originPoint (hZ : B.Contains (⊤_ Scheme.{u})) :
    ∃ Z : Space.PrimeDivisor B (Spec (.of S.k)) hS (quotientSpace S B hS).obj,
      Z.genericPoint B (Spec (.of S.k)) hS _ = originPoint S B hS := by
  have h := Space.chartPoint_pointsToScheme B (Spec (.of S.k)) hS (axesChart S B hS)
    (chart S B hS) (Space.presheafPoint B (Spec (.of S.k)) hS (axesChart S B hS) (origin S)
      (B.residueField_spec_contains (axesChart S B hS).left.property (origin S)))
  refine Space.exists_primeDivisor_genericPoint_eq_of_coheight_chartPoint_eq_one B
    (Spec (.of S.k)) hS (isAlgebraicSpace_quotientSpace S B hS)
    (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace (axesChart S B hS) (chart S B hS)
    (presheafEtale_chart S B hS) _ _ h ?_
  exact (Space.pointsToScheme_presheafPoint B (Spec (.of S.k)) hS (axesChart S B hS) (origin S)
    _).symm ▸ coheight_origin S

/-- The prime divisor of `X` over the origin. -/
def originDivisor (hZ : B.Contains (⊤_ Scheme.{u})) :
    Space.PrimeDivisor B (Spec (.of S.k)) hS (quotientSpace S B hS).obj :=
  (exists_primeDivisor_genericPoint_eq_originPoint S B hS hZ).choose

/-- The generic point of `originDivisor` is the point `originPoint` over the origin. -/
theorem genericPoint_originDivisor (hZ : B.Contains (⊤_ Scheme.{u})) :
    (originDivisor S B hS hZ).genericPoint B (Spec (.of S.k)) hS _ = originPoint S B hS :=
  (exists_primeDivisor_genericPoint_eq_originPoint S B hS hZ).choose_spec

/-- The chart followed by the sum map is the sum of the coordinates. -/
theorem yonedaEquiv_chart_comp_sumMap :
    yonedaEquiv (chart S B hS ≫ sumMap S B hS) = coordinateSumMap S := by
  have h1 : yonedaEquiv (chart S B hS ≫ sumMap S B hS) = (sumMap S B hS).app _
      ((quotientMap S B hS).app _
        ((Over.post (X := B.obj hS) B.inclusion).map (𝟙 (axesChart S B hS)))) := rfl
  rw [h1, CategoryTheory.Functor.map_id]
  exact (sumMap_app_quotientMap S B hS (axesChart S B hS) (𝟙 _)).trans (Category.id_comp _)

/-- The pullback of the coordinate of the affine line along the sum map is `x + y`. -/
theorem coordinateSumMap_appTop_coordinate :
    (coordinateSumMap S).left.appTop (AffineLineInvolution.coordinate S.k) =
      xSection S + ySection S :=
  AffineSpace.homOfVector_appTop_coord _ _ _

/-- **The divisor of `t` at the node.** The pullback of the coordinate `t` of the affine line
vanishes to order two along the prime divisor over the origin: on the chart `U` it is `x + y`,
and the order of vanishing of `x + y` at the origin of the coordinate axes is `2`. -/
theorem ordRationalFunction_coordinatePullbackUnit_originDivisor
    (hZ : B.Contains (⊤_ Scheme.{u})) :
    Space.ordRationalFunction B (Spec (.of S.k)) hS (isAlgebraicSpace_quotientSpace S B hS)
        (isIntegralSpace_quotientSpace S B hS hZ)
        (hasEtaleLocalProperty_isLocallyNoetherian S B hS)
        (Space.coordinatePullbackUnit (sumMap S B hS) (isAlgebraicSpace_quotientSpace S B hS)
          (isIntegralSpace_quotientSpace S B hS hZ)
          (isIso_sumMap_pullback_puncturedAffineLine B S hS))
        (originDivisor S B hS hZ) = 2 := by
  have : IsAffine (axesChart S B hS).left.1 := inferInstanceAs (IsAffine (Spec _))
  have : IsReduced (axesChart S B hS).left.1 := isReduced_axesChart S B hS
  have : IsLocallyNoetherian (axesChart S B hS).left.1 := isLocallyNoetherian_axesChart S B hS
  let U := originNeighborhood S B hS _ (genericPoint_originDivisor S B hS hZ).symm
  have : IsAffine U.scheme.left.1 := inferInstanceAs (IsAffine (Spec _))
  have : IsReduced U.scheme.left.1 := isReduced_axesChart S B hS
  have : IsLocallyNoetherian U.scheme.left.1 := isLocallyNoetherian_axesChart S B hS
  have ha : Space.rationalFunctionsToTotalFractionRing B (Spec (.of S.k)) hS
      (isAlgebraicSpace_quotientSpace S B hS) U.scheme U.toSpace U.etale_toSpace
      ((Space.coordinatePullbackUnit (sumMap S B hS) (isAlgebraicSpace_quotientSpace S B hS)
          (isIntegralSpace_quotientSpace S B hS hZ)
          (isIso_sumMap_pullback_puncturedAffineLine B S hS) :
        Space.rationalFunctions B (Spec (.of S.k)) hS (isAlgebraicSpace_quotientSpace S B hS))) =
      algebraMap Γ(U.scheme.left.1, ⊤) (FractionRing Γ(U.scheme.left.1, ⊤))
        (xSection S + ySection S) := by
    have h1 := Space.rationalFunctionsToTotalFractionRing_linePullbackFunction (sumMap S B hS)
      (isAlgebraicSpace_quotientSpace S B hS) (axesChart S B hS) (chart S B hS)
      (isEtale_chart S B hS) (AffineLineInvolution.coordinate S.k)
    rw [yonedaEquiv_chart_comp_sumMap] at h1
    exact h1.trans (congrArg _ (coordinateSumMap_appTop_coordinate S))
  rw [(originDivisor S B hS hZ).ordRationalFunction_eq_ord_germ
    B (Spec (.of S.k)) hS _ _ _ U _ _ ha]
  exact (congrArg (fun n : ℕ∞ => ((n.toNat : ℕ) : ℤ)) (ord_originGerm_sum S)).trans rfl

/-! ### The henselian local ring at the node -/

/-- **The henselian local ring of `X` at `x` is the henselization of `𝒪_{U, 0_U}`.** -/
theorem isHenselization_henselianLocalRing_originPoint (hZ : B.Contains (⊤_ Scheme.{u})) :
    letI := Space.henselianLocalRing_isLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
      (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
      (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace
    letI := Space.stalkAlgebra B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
      (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
      (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace (originNeighborhood S B hS _ rfl)
    IsLocalRing.IsHenselization
      ((originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
        (originNeighborhood S B hS _ rfl).point)
      (ResidueField ((originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
        (originNeighborhood S B hS _ rfl).point))
      (Space.henselianLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
        (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
        (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace : Type (u + 1)) :=
  Space.henselianLocalRing_isHenselization B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
    (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
    (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace (originNeighborhood S B hS _ rfl)

/-- **The henselian local ring of `X` at `x` is not a domain.** It contains the local ring
`𝒪_{U, 0_U}`, the henselization being faithfully flat, and there the germs of `x` and `y` are
nonzero with product zero. -/
theorem not_isDomain_henselianLocalRing_originPoint (hZ : B.Contains (⊤_ Scheme.{u})) :
    ¬ IsDomain (Space.henselianLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
      (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
      (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace) := by
  let := Space.henselianLocalRing_isLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
    (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
    (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace
  let := Space.stalkAlgebra B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
    (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
    (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace (originNeighborhood S B hS _ rfl)
  have := isHenselization_henselianLocalRing_originPoint S B hS hZ
  have := IsLocalRing.IsHenselization.faithfullyFlat
    (R := (originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
      (originNeighborhood S B hS _ rfl).point)
    (L := ResidueField ((originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
      (originNeighborhood S B hS _ rfl).point))
    (Rh := (Space.henselianLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
      (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
      (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace : Type (u + 1)))
  have hinj := FaithfulSMul.algebraMap_injective
    ((originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
      (originNeighborhood S B hS _ rfl).point)
    (Space.henselianLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
      (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
      (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace : Type (u + 1))
  have key : ∀ {R : Type u} {Rh : Type (u + 1)} [CommRing R] [CommRing Rh] (φ : R →+* Rh),
      Function.Injective φ → ∀ a b : R, a * b = 0 → a ≠ 0 → b ≠ 0 → ¬ IsDomain Rh := by
    intro R Rh _ _ φ hφ a b hab ha hb _
    exact mul_ne_zero ((map_ne_zero_iff φ hφ).2 ha) ((map_ne_zero_iff φ hφ).2 hb)
      (by rw [← map_mul, hab, map_zero])
  exact key _ hinj _ _ (originGerm_xSection_mul_ySection S) (originGerm_xSection_ne_zero S)
    (originGerm_ySection_ne_zero S)

/-! ### Stacks 0ENU -/

/-- **Stacks 0ENU.** Let `k` be a field, `U = Spec (k[x, y]/(xy))` the union of the coordinate
axes, `σ` the automorphism exchanging them, and `R = Δ(U) ⨿ Δ'(U ∖ {0_U})` where `Δ'` is the graph
`u ↦ (u, σ(u))`. Then:
1. `R` is an étale equivalence relation on `U`, and `X = U/R` is an algebraic space;
2. the morphism `U → 𝔸¹_k`, `(x, y) ↦ x + y`, is `R`-invariant and defines `π : X → 𝔸¹_k`;
3. `π` is a universal homeomorphism and an isomorphism over `𝔸¹_k ∖ {0}`;
4. `X` is integral and Noetherian;
5. as in Stacks 0ENT, the prime divisors of `X` are its closed points, the point `x` of `X` over
   `0 ∈ 𝔸¹_k` is closed and is the only point over `0`, the divisor of `t` is `2 [x]`, the class of
   every other prime divisor is zero, and `Cl(X) ≅ ℤ/2ℤ` by an isomorphism sending `[x]` to `1`;
6. the henselian local ring of `X` at `x` is a henselization of `𝒪_{U, 0_U}`, and it is not a
   domain.
No hypothesis is put on the field. The hypothesis `hZ` that the big fppf site contains the
final scheme is the one under which `AlgebraicGeometry.Space.IsNoetherian` is formulated; the
integrality, the class group and the henselian local ring, which is defined for decent spaces,
use it through the decency of a Noetherian space. -/
@[stacks 0ENU]
theorem coordinateAxesQuotient_properties (hZ : B.Contains (⊤_ Scheme.{u})) :
    Stacks.Groupoids.IsEtaleEquivalenceRelation (relationPreRelation S) ∧
      IsAlgebraicSpace B (Spec (.of S.k)) hS (quotientSpace S B hS).obj ∧
      quotientMap S B hS ≫ sumMap S B hS =
        (Over.post (X := B.obj hS) B.inclusion).op.whiskerLeft
          (yoneda.map (coordinateSumMap S)) ∧
      Space.UniversalHomeomorphism B (Spec (.of S.k)) hS (sumMap S B hS) ∧
      IsIso (pullback.snd (sumMap S B hS) (Space.puncturedLineInclusion S.k B hS)) ∧
      Space.IsIntegralSpace B (Spec (.of S.k)) hS (quotientSpace S B hS).obj ∧
      Space.IsNoetherian B (Spec (.of S.k)) hS hZ (quotientSpace S B hS).obj ∧
      (∀ ξ : Space.points B (Spec (.of S.k)) hS (quotientSpace S B hS).obj,
        (∃ Z : Space.PrimeDivisor B (Spec (.of S.k)) hS (quotientSpace S B hS).obj,
          Z.genericPoint B (Spec (.of S.k)) hS _ = ξ) ↔ IsClosed {ξ}) ∧
      (originDivisor S B hS hZ).genericPoint B (Spec (.of S.k)) hS _ = originPoint S B hS ∧
      IsClosed {originPoint S B hS} ∧
      (∀ ξ : Space.points B (Spec (.of S.k)) hS (quotientSpace S B hS).obj,
        Space.pointsHomeomorphAffineLine (sumMap S B hS) (universalHomeomorphism_sumMap B S hS) ξ =
            AffineLineInvolution.origin S.k ↔ ξ = originPoint S B hS) ∧
      Space.divRationalFunction B (Spec (.of S.k)) hS (isAlgebraicSpace_quotientSpace S B hS)
          (isIntegralSpace_quotientSpace S B hS hZ)
          (hasEtaleLocalProperty_isLocallyNoetherian S B hS)
          (Space.coordinatePullbackUnit (sumMap S B hS) (isAlgebraicSpace_quotientSpace S B hS)
            (isIntegralSpace_quotientSpace S B hS hZ)
            (isIso_sumMap_pullback_puncturedAffineLine B S hS)) =
        2 • Space.primeDivisorClass (originDivisor S B hS hZ) ∧
      (∀ Z : Space.PrimeDivisor B (Spec (.of S.k)) hS (quotientSpace S B hS).obj,
        Z ≠ originDivisor S B hS hZ →
        (Space.primeDivisorClass Z : Space.weilDivisorClassGroup B (Spec (.of S.k)) hS
            (isAlgebraicSpace_quotientSpace S B hS)
            (isIntegralSpace_quotientSpace S B hS hZ)
            (hasEtaleLocalProperty_isLocallyNoetherian S B hS)) = 0) ∧
      (∃ e : Space.weilDivisorClassGroup B (Spec (.of S.k)) hS
            (isAlgebraicSpace_quotientSpace S B hS)
            (isIntegralSpace_quotientSpace S B hS hZ)
            (hasEtaleLocalProperty_isLocallyNoetherian S B hS) ≃+ ZMod 2,
        e (Space.primeDivisorClass (originDivisor S B hS hZ)) = 1) ∧
      (letI := Space.henselianLocalRing_isLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
          (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
            (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace;
        letI := Space.stalkAlgebra B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
          (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
            (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace
          (originNeighborhood S B hS _ rfl);
        IsLocalRing.IsHenselization
          ((originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
            (originNeighborhood S B hS _ rfl).point)
          (ResidueField ((originNeighborhood S B hS _ rfl).scheme.left.1.presheaf.stalk
            (originNeighborhood S B hS _ rfl).point))
          (Space.henselianLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
            (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
              (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace : Type (u + 1))) ∧
      ¬ IsDomain (Space.henselianLocalRing B (Spec (.of S.k)) hS (quotientSpace S B hS).obj
        (isAlgebraicSpace_quotientSpace S B hS) (originPoint S B hS)
          (isIntegralSpace_quotientSpace S B hS hZ).isDecentSpace) := by
  have hX := isAlgebraicSpace_quotientSpace S B hS
  have hInt := isIntegralSpace_quotientSpace S B hS hZ
  have hN := hasEtaleLocalProperty_isLocallyNoetherian S B hS
  have hπ := universalHomeomorphism_sumMap B S hS
  have hiso := isIso_sumMap_pullback_puncturedAffineLine B S hS
  have hord := ordRationalFunction_coordinatePullbackUnit_originDivisor S B hS hZ
  have hgen := genericPoint_originDivisor S B hS hZ
  refine ⟨isEtaleEquivalenceRelation S, hX, quotientMap_comp_sumMap S B hS, hπ, hiso, hInt,
    isNoetherian_quotientSpace S B hS hZ,
    Space.exists_primeDivisor_genericPoint_eq_iff_isClosed _ hπ hX hInt.isDecentSpace, hgen, ?_,
    fun ξ => hgen ▸ Space.pointsHomeomorphAffineLine_eq_origin_iff _ hπ hX hInt hN hiso _ hord ξ,
    Space.divRationalFunction_coordinatePullbackUnit _ hX hInt hN hiso
      (Space.isHomeomorph_pointsMap_of_universalHomeomorphism _ hπ).injective _ hord,
    fun _ hZ' => Space.weilDivisorClassGroup_primeDivisorClass_eq_zero _ hX hInt hN hπ hiso _ hord
      hZ',
    ⟨Space.weilDivisorClassGroupEquivZModTwo _ hX hInt hN hπ hiso _ hord,
      Space.weilDivisorClassGroupEquivZModTwo_primeDivisorClass _ hX hInt hN hπ hiso _ hord⟩,
    isHenselization_henselianLocalRing_originPoint S B hS hZ,
    not_isDomain_henselianLocalRing_originPoint S B hS hZ⟩
  rw [← hgen]
  exact (Space.exists_primeDivisor_genericPoint_eq_iff_isClosed _ hπ hX hInt.isDecentSpace _).1
    ⟨_, rfl⟩

end AlgebraicGeometry.CoordinateAxesQuotient

end
