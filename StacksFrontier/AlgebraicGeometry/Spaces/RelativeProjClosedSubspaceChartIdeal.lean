namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

open _root_.AlgebraicGeometry Stacks.AlgebraicGeometry.RelativeProjBridge

variable {T : Scheme.{u}} (A : SheafGradedAlgebra T) {Z : Scheme.{u}}
  (i : Z ⟶ (relativeProj A).scheme)

/-- The equation section is additive. -/
theorem twistEquationSection_add (n : ℕ) (a b : Γ(A.piece (n : ℤ), ⊤)) :
    twistEquationSection A i n (a + b) =
      twistEquationSection A i n a + twistEquationSection A i n b :=
  ((twistRestrictMapNat_app A _ i n ⊤ (a + b)).symm.trans (map_add _ a b)).trans
    (congrArg₂ (· + ·) (twistRestrictMapNat_app A _ i n ⊤ a)
      (twistRestrictMapNat_app A _ i n ⊤ b))

/-- The equation section of zero vanishes. -/
theorem twistEquationSection_zero (n : ℕ) : twistEquationSection A i n 0 = 0 :=
  (twistRestrictMapNat_app A _ i n ⊤ 0).symm.trans (map_zero _)

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

namespace PresheafOfModules

variable {C : Type*} [Category C] {R : Cᵒᵖ ⥤ RingCat.{u}} (M : PresheafOfModules.{u} R)

/-- The restriction of a multiple of a restriction lies in the submodule generated by the
restriction along the composite. -/
theorem restrictₛₗ_smul_restrictₛₗ_mem_span {X Y Z : Cᵒᵖ} (f : X ⟶ Y) (g : Y ⟶ Z) (c : R.obj Y)
    (a : M.obj X) :
    M.restrictₛₗ g (c • M.restrictₛₗ f a) ∈
      Submodule.span (R.obj Z) {M.restrictₛₗ (𝟙 Z) (M.restrictₛₗ (f ≫ g) a)} := by
  have e : M.restrictₛₗ g (M.restrictₛₗ f a) = M.restrictₛₗ (𝟙 Z) (M.restrictₛₗ (f ≫ g) a) :=
    (M.map_comp_apply f g a).symm.trans (M.map_id_apply _ _).symm
  rw [map_smulₛₗ, e]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

end PresheafOfModules

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {X : AlgebraicSpaces B S hS}

/-- The chart reading is additive. -/
theorem chartOpenReading_add
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS X))
    (V : SmallEtale B S hS X.1) (O : (chartScheme (idEtaleChart B S hS V.1.left)).Opens) (n : ℤ)
    (a b : (A.piece n).val.obj (op V)) :
    chartOpenReading A V O n (a + b) = chartOpenReading A V O n a + chartOpenReading A V O n b :=
  (modulePushforwardHomFMap B S hS (pointHom V.1.hom) _ (A.piece n)
    ((modulePullbackAdjunction B S hS (pointHom V.1.hom)).unit.app (A.piece n))).map_add
      (selfOpensChartDiagram V O) a b

/-- The chart reading of zero is zero. -/
theorem chartOpenReading_zero
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS X))
    (V : SmallEtale B S hS X.1) (O : (chartScheme (idEtaleChart B S hS V.1.left)).Opens)
    (n : ℤ) : chartOpenReading A V O n 0 = 0 := by
  have h := chartOpenReading_add A V O n 0 0
  rw [add_zero] at h
  exact add_left_cancel (h.symm.trans (add_zero _).symm)

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space.RelativeProjSituation

variable (s : RelativeProjSituation.{u, u})
    {Z : (BigFppfOver s.site s.base s.containsBase)ᵒᵖ ⥤ Type u} {i : Z ⟶ s.relativeProjFunctor}
    (hi : IsClosedImmersion s.site s.base s.containsBase i)

/-- **The fibres of `Z` over `f` and `f' = f ∘ τ` form the base-change square of Stacks 084B (3)**,
for any morphism `f'` equal to `f ∘ τ`: the comparison morphism is the identification of the two
restrictions by the restriction datum followed by the base-change morphism of Tag 01O3. -/
theorem exists_isPullback_fibreClosedImmersion_of_eq
    {T T' : BigFppfOver s.site s.base s.containsBase} (f : yoneda.obj T ⟶ s.space.1) (τ : T' ⟶ T)
    (f' : yoneda.obj T' ⟶ s.space.1) (hf : yoneda.map τ ≫ f = f') :
    ∃ z : (BigFppfOver.toScheme s.site s.base s.containsBase).obj (s.fibreClosedSubspace hi T' f') ⟶
        (BigFppfOver.toScheme s.site s.base s.containsBase).obj (s.fibreClosedSubspace hi T f),
      IsPullback z (s.fibreClosedImmersion hi T' f') (s.fibreClosedImmersion hi T f)
        ((relativeProjCongr (A₁ := s.shrink.pointAlgebra T' f')
            (A₂ := (s.shrink.pointAlgebra T f).pullback
              ((BigFppfOver.toScheme s.site s.base s.containsBase).map τ))
            (s.quadrupleRestriction.restrict τ f f' hf)
            (s.quadrupleRestriction.isIso_restrict_app τ f f' hf)).hom ≫
          baseChangeHom (s.shrink.pointAlgebra T f)
            ((BigFppfOver.toScheme s.site s.base s.containsBase).map τ)) := by
  subst hf
  obtain ⟨z, hz⟩ := s.exists_isPullback_fibreClosedImmersion hi f τ
  rw [s.toScheme_map_projComparison f τ] at hz
  exact ⟨z, hz⟩

/-- **Equations restrict to equations along the restriction datum**: if `a` is an equation of
the fibre `Z_T` over `f` and the restriction datum carries `x` to the pullback of `a` along `τ`,
then `x` is an equation of the fibre over `f' = f ∘ τ`. -/
theorem twistEquationSection_eq_zero_of_pointRestrict
    {T T' : BigFppfOver s.site s.base s.containsBase} (f : yoneda.obj T ⟶ s.space.1) (τ : T' ⟶ T)
    (f' : yoneda.obj T' ⟶ s.space.1) (hf : yoneda.map τ ≫ f = f') (d : ℕ)
    (a : Γ((s.shrink.pointAlgebra T f).piece (d : ℤ), ⊤))
    (x : Γ((s.shrink.pointAlgebra T' f').piece (d : ℤ), ⊤))
    (hx : Scheme.Modules.sectionsLinearMap (M := (s.shrink.pointAlgebra T' f').piece (d : ℤ))
      (N := (Scheme.Modules.pullback
        ((BigFppfOver.toScheme s.site s.base s.containsBase).map τ)).obj
        ((s.shrink.pointAlgebra T f).piece (d : ℤ)))
      ((s.quadrupleRestriction.restrict τ f f' hf).app (d : ℤ)) ⊤ x =
      Stacks.AlgebraicGeometry.SectionsBaseChange.pullbackSectionsHom
        ((BigFppfOver.toScheme s.site s.base s.containsBase).map τ)
        ((s.shrink.pointAlgebra T f).piece (d : ℤ)) ⊤ ⊤
        (Stacks.AlgebraicGeometry.SectionsBaseChange.le_preimage_top _ ⊤) a)
    (ha : twistEquationSection (s.shrink.pointAlgebra T f) (s.fibreClosedImmersion hi T f) d a =
      0) :
    twistEquationSection (s.shrink.pointAlgebra T' f') (s.fibreClosedImmersion hi T' f') d x =
      0 := by
  obtain ⟨z, hz⟩ := s.exists_isPullback_fibreClosedImmersion_of_eq hi f τ f' hf
  exact twistEquationSection_eq_zero_of_restrict
    ((BigFppfOver.toScheme s.site s.base s.containsBase).map τ)
    (s.shrink.pointAlgebra T f) (A₁ := s.shrink.pointAlgebra T' f')
    (s.quadrupleRestriction.restrict τ f f' hf)
    (s.quadrupleRestriction.isIso_restrict_app τ f f' hf) _ rfl
    (s.fibreClosedImmersion hi T f) (s.fibreClosedImmersion hi T' f') z hz.w d a x hx ha

/-- **Equations restrict to equations along morphisms of étale charts.**  If the reading over the
chart `V` of a section `a` of `𝒜_d` is an equation of the fibre `Z_V`, then the reading over `V'`
of its restriction along `k : V' ⟶ V` is an equation of `Z_{V'}`. -/
theorem twistEquationSection_chartOpenReading_restrict
    {V V' : SmallEtale s.site s.base s.containsBase s.space.1} (k : V' ⟶ V) (d : ℕ)
    (a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V))
    (ha : twistEquationSection (s.shrink.pointAlgebra V.1.left V.1.hom)
      (s.fibreClosedImmersion hi V.1.left V.1.hom) d
      (chartOpenReading s.shrink.algebra V ⊤ (d : ℤ) a) = 0) :
    twistEquationSection (s.shrink.pointAlgebra V'.1.left V'.1.hom)
      (s.fibreClosedImmersion hi V'.1.left V'.1.hom) d
      (chartOpenReading s.shrink.algebra V' ⊤ (d : ℤ)
        ((s.shrink.algebra.piece (d : ℤ)).val.map k.op a)) = 0 := by
  have hx := s.shrink.pointRestrict_app_val_app_chartOpenReading k (d : ℤ) a
  exact s.twistEquationSection_eq_zero_of_pointRestrict hi V.1.hom k.hom.left V'.1.hom
    (CostructuredArrow.w k.hom) d _ _ hx ha

/-- **Being an equation descends along a jointly surjective family of flat affine test
objects**, read through the restriction datum: if for every member `τ_j : T_j ⟶ T` of such a
family the section `x_j` carried by the restriction datum to the pullback of `a` is an equation of
the fibre over `f ∘ τ_j`, then `a` is an equation of the fibre over `f`. -/
theorem twistEquationSection_eq_zero_of_pointRestrict_cover
    {T : BigFppfOver s.site s.base s.containsBase} (f : yoneda.obj T ⟶ s.space.1)
    [_root_.AlgebraicGeometry.IsAffine ((BigFppfOver.toScheme s.site s.base s.containsBase).obj T)]
    [_root_.AlgebraicGeometry.QuasiCompact (relativeProj (s.shrink.pointAlgebra T f)).toBase]
    {ι : Type*} {Tj : ι → BigFppfOver s.site s.base s.containsBase} (τj : ∀ j, Tj j ⟶ T)
    [∀ j, _root_.AlgebraicGeometry.IsAffine
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj (Tj j))]
    [∀ j, _root_.AlgebraicGeometry.Flat
      ((BigFppfOver.toScheme s.site s.base s.containsBase).map (τj j))]
    (hsurj : ∀ t : (BigFppfOver.toScheme s.site s.base s.containsBase).obj T, ∃ j,
      ∃ t' : (BigFppfOver.toScheme s.site s.base s.containsBase).obj (Tj j),
        ((BigFppfOver.toScheme s.site s.base s.containsBase).map (τj j)).base t' = t)
    (fj : ∀ j, yoneda.obj (Tj j) ⟶ s.space.1) (hfj : ∀ j, yoneda.map (τj j) ≫ f = fj j) (d : ℕ)
    (a : Γ((s.shrink.pointAlgebra T f).piece (d : ℤ), ⊤))
    (xj : ∀ j, Γ((s.shrink.pointAlgebra (Tj j) (fj j)).piece (d : ℤ), ⊤))
    (hxj : ∀ j, Scheme.Modules.sectionsLinearMap
      (M := (s.shrink.pointAlgebra (Tj j) (fj j)).piece (d : ℤ))
      (N := (Scheme.Modules.pullback
        ((BigFppfOver.toScheme s.site s.base s.containsBase).map (τj j))).obj
        ((s.shrink.pointAlgebra T f).piece (d : ℤ)))
      ((s.quadrupleRestriction.restrict (τj j) f (fj j) (hfj j)).app (d : ℤ)) ⊤ (xj j) =
      Stacks.AlgebraicGeometry.SectionsBaseChange.pullbackSectionsHom
        ((BigFppfOver.toScheme s.site s.base s.containsBase).map (τj j))
        ((s.shrink.pointAlgebra T f).piece (d : ℤ)) ⊤ ⊤
        (Stacks.AlgebraicGeometry.SectionsBaseChange.le_preimage_top _ ⊤) a)
    (h0 : ∀ j, twistEquationSection (s.shrink.pointAlgebra (Tj j) (fj j))
      (s.fibreClosedImmersion hi (Tj j) (fj j)) d (xj j) = 0) :
    twistEquationSection (s.shrink.pointAlgebra T f) (s.fibreClosedImmersion hi T f) d a = 0 := by
  choose zj hzj using fun j => s.exists_isPullback_fibreClosedImmersion_of_eq hi f (τj j) (fj j)
    (hfj j)
  exact twistEquationSection_eq_zero_of_cover (s.shrink.pointAlgebra T f)
    (s.fibreClosedImmersion hi T f)
    (fun j => (BigFppfOver.toScheme s.site s.base s.containsBase).map (τj j)) hsurj
    (Aj := fun j => s.shrink.pointAlgebra (Tj j) (fj j))
    (fun j => s.quadrupleRestriction.restrict (τj j) f (fj j) (hfj j))
    (fun j => s.quadrupleRestriction.isIso_restrict_app (τj j) f (fj j) (hfj j)) _
    (fun _ => rfl) (fun j => s.fibreClosedImmersion hi (Tj j) (fj j)) zj hzj d a xj hxj h0

/-- **Being an equation is local on the small étale site**: over an affine étale chart `V` of
`X`, if the readings of the restrictions of `a` to the affine members of a covering sieve are
equations of the fibres of `Z` there, then the reading of `a` is an equation of `Z_V`. -/
theorem twistEquationSection_chartOpenReading_of_mem_topology
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.relativeProjπ)
    {V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    (hV : _root_.AlgebraicGeometry.IsAffine
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj V.1.left))
    (d : ℕ) (a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)) {R : Sieve V}
    (hR : R ∈ SmallEtale.topology s.shrink.site s.shrink.base s.shrink.containsBase
      s.shrink.space.1 V)
    (h : ∀ {V' : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
      (k : V' ⟶ V), R k →
      _root_.AlgebraicGeometry.IsAffine
        ((BigFppfOver.toScheme s.site s.base s.containsBase).obj V'.1.left) →
      twistEquationSection (s.shrink.pointAlgebra V'.1.left V'.1.hom)
        (s.fibreClosedImmersion hi V'.1.left V'.1.hom) d
        (chartOpenReading s.shrink.algebra V' ⊤ (d : ℤ)
          ((s.shrink.algebra.piece (d : ℤ)).val.map k.op a)) = 0) :
    twistEquationSection (s.shrink.pointAlgebra V.1.left V.1.hom)
      (s.fibreClosedImmersion hi V.1.left V.1.hom) d
      (chartOpenReading s.shrink.algebra V ⊤ (d : ℤ) a) = 0 := by
  obtain ⟨n, z, φ, hzaff, hzR, -, hpre⟩ :=
    SmallEtale.exists_finite_affine_etale_ofArrows_le s.shrink.site s.shrink.base
      s.shrink.containsBase s.shrink.space.1 hV hR
  obtain ⟨hcov, het⟩ := Scheme.ofArrows_mem_etalePrecoverage_iff.1 hpre
  have : _root_.AlgebraicGeometry.IsAffine
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj V.1.left) := hV
  have : _root_.AlgebraicGeometry.QuasiCompact
      (relativeProj (s.shrink.pointAlgebra V.1.left V.1.hom)).toBase :=
    s.quasiCompact_fibre_toBase V.1.left V.1.hom hπ hV
  have : ∀ i, _root_.AlgebraicGeometry.IsAffine
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj (z i).1.left) := hzaff
  have : ∀ i, _root_.AlgebraicGeometry.Flat
      ((BigFppfOver.toScheme s.site s.base s.containsBase).map (φ i).hom.left) := fun i =>
    (Etale.iff_flat_and_formallyUnramified.1 (het i)).1
  refine s.twistEquationSection_eq_zero_of_pointRestrict_cover hi V.1.hom
    (fun i => (φ i).hom.left) (fun t => ?_) (fun i => (z i).1.hom)
    (fun i => CostructuredArrow.w (φ i).hom) d _ _
    (fun i => s.shrink.pointRestrict_app_val_app_chartOpenReading (φ i) (d : ℤ) a)
    (fun i => h (φ i) (hzR i) (hzaff i))
  obtain ⟨i, t', ht'⟩ := hcov t
  exact ⟨i, t', ht'⟩

/-- The reading over an étale chart `E`, followed by the equation section of the fibre of `Z`
over `E`, is additive. -/
theorem twistEquationSection_chartOpenReading_add (d : ℕ)
    (E : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1)
    (y₁ y₂ : (s.shrink.algebra.piece (d : ℤ)).val.obj (op E)) :
    twistEquationSection (s.shrink.pointAlgebra E.1.left E.1.hom)
        (s.fibreClosedImmersion hi E.1.left E.1.hom) d
        (chartOpenReading s.shrink.algebra E ⊤ (d : ℤ) (y₁ + y₂)) =
      twistEquationSection (s.shrink.pointAlgebra E.1.left E.1.hom)
          (s.fibreClosedImmersion hi E.1.left E.1.hom) d
          (chartOpenReading s.shrink.algebra E ⊤ (d : ℤ) y₁) +
        twistEquationSection (s.shrink.pointAlgebra E.1.left E.1.hom)
          (s.fibreClosedImmersion hi E.1.left E.1.hom) d
          (chartOpenReading s.shrink.algebra E ⊤ (d : ℤ) y₂) := by
  rw [chartOpenReading_add]
  exact twistEquationSection_add _ _ _ _ _

/-- The reading over an étale chart `E` of zero is an equation. -/
theorem twistEquationSection_chartOpenReading_zero (d : ℕ)
    (E : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1) :
    twistEquationSection (s.shrink.pointAlgebra E.1.left E.1.hom)
        (s.fibreClosedImmersion hi E.1.left E.1.hom) d
        (chartOpenReading s.shrink.algebra E ⊤ (d : ℤ) 0) = 0 := by
  rw [chartOpenReading_zero]
  exact twistEquationSection_zero _ _ _

/-- **A section of `𝒜_d` over an étale chart `V` is a chart equation of `Z`** when, over every
affine étale chart `E ⟶ V`, the reading of every section of the submodule generated by `a|_E` is
an equation of the fibre `Z_E` of `Z` over `E`. -/
def IsChartEquation (d : ℕ)
    (V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1)
    (a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)) : Prop :=
  ∀ {E : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    (k : E ⟶ V), _root_.AlgebraicGeometry.IsAffine
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj E.1.left) →
    ∀ y ∈ Submodule.span ((structureRingSheaf s.shrink.site s.shrink.base s.shrink.containsBase
        s.shrink.space).obj.obj (op E))
        {(s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ k.op a},
      twistEquationSection (s.shrink.pointAlgebra E.1.left E.1.hom)
        (s.fibreClosedImmersion hi E.1.left E.1.hom) d
        (chartOpenReading s.shrink.algebra E ⊤ (d : ℤ) y) = 0

omit s hi in
/-- The span of the image of a sum lies in the sum of the spans of the images. -/
theorem _root_.Submodule.span_singleton_map_add_le {R₁ R₂ M₁ M₂ : Type*} [Semiring R₁]
    [Semiring R₂] [AddCommMonoid M₁] [AddCommMonoid M₂] [Module R₁ M₁] [Module R₂ M₂]
    {σ : R₁ →+* R₂} (g : M₁ →ₛₗ[σ] M₂) (a b : M₁) :
    Submodule.span R₂ {g (a + b)} ≤ Submodule.span R₂ {g a} ⊔ Submodule.span R₂ {g b} := by
  rw [Submodule.span_le, Set.singleton_subset_iff, map_add]
  exact Submodule.add_mem_sup (Submodule.mem_span_singleton_self _)
    (Submodule.mem_span_singleton_self _)

/-- The sum of two chart equations of `Z` of degree `d` over `V` is a chart equation. -/
theorem IsChartEquation.add {d : ℕ}
    {V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    {a b : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)} (ha : s.IsChartEquation hi d V a)
    (hb : s.IsChartEquation hi d V b) : s.IsChartEquation hi d V (a + b) := by
  intro E k hE y hy
  obtain ⟨y₁, hy₁, y₂, hy₂, rfl⟩ := Submodule.mem_sup.1
    (Submodule.span_singleton_map_add_le ((s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ k.op)
      a b hy)
  exact (s.twistEquationSection_chartOpenReading_add hi d E y₁ y₂).trans
    ((congrArg₂ (· + ·) (ha k hE y₁ hy₁) (hb k hE y₂ hy₂)).trans (add_zero 0))

/-- The zero section of `𝒜_d` over `V` is a chart equation of `Z`. -/
theorem IsChartEquation.zero (d : ℕ)
    (V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1) :
    s.IsChartEquation hi d V 0 := by
  intro E k hE y hy
  rw [map_zero, Submodule.span_singleton_eq_bot.2 rfl, Submodule.mem_bot] at hy
  subst hy
  exact s.twistEquationSection_chartOpenReading_zero hi d E

/-- A multiple of a chart equation of `Z` by a section of the structure sheaf over `V` is a chart
equation. -/
theorem IsChartEquation.smul {d : ℕ}
    {V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    (c : (structureRingSheaf s.shrink.site s.shrink.base s.shrink.containsBase
      s.shrink.space).obj.obj (op V))
    {a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)} (ha : s.IsChartEquation hi d V a) :
    s.IsChartEquation hi d V (c • a) := by
  intro E k hE y hy
  refine ha k hE y (Submodule.span_le.2 (Set.singleton_subset_iff.2 ?_) hy)
  rw [map_smulₛₗ]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- **The sections of `ℐ_d` over an étale chart** `V` of `X`: the chart equations of `Z` of
degree `d` (`AlgebraicGeometry.Space.RelativeProjSituation.IsChartEquation`). -/
def chartEquationSubmodule (d : ℕ)
    (V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1) :
    Submodule ((structureRingSheaf s.shrink.site s.shrink.base s.shrink.containsBase
        s.shrink.space).obj.obj (op V))
      ((s.shrink.algebra.piece (d : ℤ)).val.obj (op V)) where
  carrier := {a | s.IsChartEquation hi d V a}
  add_mem' ha hb := IsChartEquation.add s hi ha hb
  zero_mem' := IsChartEquation.zero s hi d V
  smul_mem' c _ ha := IsChartEquation.smul s hi c ha

/-- **Chart equations restrict to chart equations** along morphisms of étale charts. -/
theorem IsChartEquation.restrict {d : ℕ}
    {V V' : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    (g : V' ⟶ V) {a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)}
    (ha : s.IsChartEquation hi d V a) :
    s.IsChartEquation hi d V' ((s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ g.op a) := by
  intro E k hE y hy
  refine ha (k ≫ g) hE y ?_
  have e : (s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ k.op
      ((s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ g.op a) =
      (s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ (k ≫ g).op a :=
    ((s.shrink.algebra.piece (d : ℤ)).val.map_comp_apply g.op k.op a).symm
  rwa [e] at hy

/-- **Being a chart equation is local on the small étale site** of `X`: if the restrictions of
`a` to the members of a covering sieve are chart equations, then so is `a`. -/
theorem IsChartEquation.of_mem_topology
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.relativeProjπ) {d : ℕ}
    {V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    (a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)) {R : Sieve V}
    (hR : R ∈ SmallEtale.topology s.shrink.site s.shrink.base s.shrink.containsBase
      s.shrink.space.1 V)
    (h : ∀ {V' : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
      (g : V' ⟶ V), R g →
        s.IsChartEquation hi d V' ((s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ g.op a)) :
    s.IsChartEquation hi d V a := by
  intro E k hE y hy
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hy
  refine s.twistEquationSection_chartOpenReading_of_mem_topology hi hπ hE d _
    ((SmallEtale.topology s.shrink.site s.shrink.base s.shrink.containsBase
      s.shrink.space.1).pullback_stable k hR) fun {E'} k' hk' hE' => ?_
  exact h (k' ≫ k) hk' (𝟙 E') hE' _
    ((s.shrink.algebra.piece (d : ℤ)).val.restrictₛₗ_smul_restrictₛₗ_mem_span k.op k'.op c a)

/-- **The degree `d` part `ℐ_d ⊆ 𝒜_d` of the graded ideal of `Z`** (Stacks 085L), as a submodule
of `𝒜_d` on the small étale site of `X`: over an étale chart `V` its sections are the chart
equations of `Z` (`AlgebraicGeometry.Space.RelativeProjSituation.IsChartEquation`), whose readings
over the affine étale charts above `V` are equations of the fibres of `Z` there.  It is a sheaf
because chart equations restrict and are local on the small étale site, which uses that `π` is
quasi-compact. -/
def chartIdeal (hπ : IsQuasiCompact s.site s.base s.containsBase s.relativeProjπ) (d : ℕ) :
    (s.shrink.algebra.piece (d : ℤ)).Submodule where
  obj U := s.chartEquationSubmodule hi d U.unop
  map f a ha := IsChartEquation.restrict s hi f.unop ha
  isSheaf := by
    intro U a ha
    exact IsChartEquation.of_mem_topology s hi hπ a ha fun _ hg => hg

/-- The sections of `chartIdeal` over an étale chart `V` are exactly the chart equations of `Z`
of degree `d` over `V`. -/
theorem mem_chartIdeal_iff (hπ : IsQuasiCompact s.site s.base s.containsBase s.relativeProjπ)
    (d : ℕ) (V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1)
    (a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)) :
    a ∈ (s.chartIdeal hi hπ d).obj (op V) ↔ s.IsChartEquation hi d V a :=
  Iff.rfl

/-- **Over an affine étale chart the sections of `ℐ_d` are equations of the fibre of `Z`**: the
reading of a section of `ℐ_d` over an affine chart `V` is an equation of `Z_V`. -/
theorem IsChartEquation.twistEquationSection_eq_zero {d : ℕ}
    {V : SmallEtale s.shrink.site s.shrink.base s.shrink.containsBase s.shrink.space.1}
    (hV : _root_.AlgebraicGeometry.IsAffine
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj V.1.left))
    {a : (s.shrink.algebra.piece (d : ℤ)).val.obj (op V)} (ha : s.IsChartEquation hi d V a) :
    twistEquationSection (s.shrink.pointAlgebra V.1.left V.1.hom)
      (s.fibreClosedImmersion hi V.1.left V.1.hom) d
      (chartOpenReading s.shrink.algebra V ⊤ (d : ℤ) a) = 0 :=
  (congrArg (fun y => twistEquationSection (s.shrink.pointAlgebra V.1.left V.1.hom)
      (s.fibreClosedImmersion hi V.1.left V.1.hom) d
      (chartOpenReading s.shrink.algebra V ⊤ (d : ℤ) y))
    ((s.shrink.algebra.piece (d : ℤ)).val.map_id_apply _ a)).symm.trans
    (ha (𝟙 V) hV _ (Submodule.mem_span_singleton_self _))

end AlgebraicGeometry.Space.RelativeProjSituation

