-/

@[expose] public section

open CategoryTheory Opposite

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Thickenings of a given order -/

/-- **Stacks 05ZK, part (4).** An algebraic space `X` is an *`n`th order thickening* of a
subfunctor `G` of it when `G` is a closed subspace of `X` and the defining quasi-coherent sheaf
of ideals `𝓘 ⊆ 𝒪_X` of `G` satisfies `𝓘 ^ (n + 1) = 0`, read on the sections over every object
of the small étale site of `X`.  As with `AlgebraicGeometry.Space.IsThickening` for
part (1), the ambient space is the first argument and the closed subspace the second.

Only closedness of `G` is asked for here, not the surjectivity on points of part (1); see the
implementation notes. -/
abbrev IsNthOrderThickening' (n : ℕ) (X : AlgebraicSpaces B S hS)
    (G : Subfunctor X.1) : Prop :=
  ∃ hG : IsClosedSubspace B S hS G,
    ∀ U : (SmallEtale B S hS X.1)ᵒᵖ,
      definingIdealAt B S hS X ⟨G, hG⟩ U ^ (n + 1) = ⊥

/-- **Stacks 05ZK, part (2).** An algebraic space `X` is a *first order thickening* of a
subfunctor `G` of it when `G` is a closed subspace of `X` whose defining quasi-coherent sheaf
of ideals has square zero: the case `n = 1` of
`AlgebraicGeometry.Space.IsNthOrderThickening'`. -/
abbrev IsFirstOrderThickening' (X : AlgebraicSpaces B S hS)
    (G : Subfunctor X.1) : Prop :=
  IsNthOrderThickening' B S hS 1 X G

/-! ### An algebraic space is a thickening of itself of every order -/

/-- The whole of an algebraic space is a closed subspace of itself: it is the intersection of
the empty family of closed subspaces. -/
theorem isClosedSubspace_top (X : AlgebraicSpaces B S hS) :
    IsClosedSubspace B S hS (⊤ : Subfunctor X.1) := by
  have h := isClosedSubspace_sInf B S hS X.2 (∅ : Set (Subfunctor X.1))
    fun _ hZ => hZ.elim
  rwa [sInf_empty] at h

/-- **A retracted closed subspace has zero defining ideal.** If the identity of `X` factors
through a closed subspace `Z ⊆ X`, then the defining ideal of `Z` vanishes on every object of
the small étale site of `X`: by Stacks 03MB the defining ideal is killed by pullback along any
point of `X` factoring through `Z`, and the identity chart is such a point.

The hypothesis is no weaker than it looks: a retraction of the monomorphism `Z.ι` makes it an
isomorphism, so `Z` is forced to be `⊤`.  It is phrased as a retraction because that is the
form `AlgebraicGeometry.Space.definingIdealAt_le_ker_of_comp_eq` consumes, and it is inhabited
— see `AlgebraicGeometry.Space.isNthOrderThickening'_top`. -/
theorem definingIdealAt_eq_bot_of_retraction (X : AlgebraicSpaces B S hS)
    (Z : ClosedSubspaces B S hS X.1)
    (g : X ⟶ (⟨Z.1.toFunctor, Z.2.1⟩ : AlgebraicSpaces B S hS))
    (hg : g ≫ ObjectProperty.homMk Z.1.ι = 𝟙 X)
    (U : (SmallEtale B S hS X.1)ᵒᵖ) :
    definingIdealAt B S hS X Z U = ⊥ := by
  have key := definingIdealAt_le_ker_of_comp_eq B S hS X X Z (𝟙 X) g hg U.unop
    (𝟙 U.unop.1.left) U.unop.1.hom (by simp)
  exact le_bot_iff.1 (key.trans_eq ((RingHom.ker_eq_bot_iff_eq_zero _).2 fun _ hx => hx))

/-- **An algebraic space is a thickening of itself of every order.** The whole space is a
closed subspace whose defining ideal is zero, so every power of it vanishes.  This exhibits an
inhabitant of `AlgebraicGeometry.Space.IsNthOrderThickening'` and, at `n = 1`, of
`AlgebraicGeometry.Space.IsFirstOrderThickening'`. -/
theorem isNthOrderThickening'_top (n : ℕ) (X : AlgebraicSpaces B S hS) :
    IsNthOrderThickening' B S hS n X ⊤ := by
  refine ⟨isClosedSubspace_top B S hS X, fun U => ?_⟩
  have hret : (ObjectProperty.homMk (inv (⊤ : Subfunctor X.1).ι) :
      X ⟶ (⟨(⊤ : Subfunctor X.1).toFunctor, (isClosedSubspace_top B S hS X).1⟩ :
        AlgebraicSpaces B S hS)) ≫ ObjectProperty.homMk (⊤ : Subfunctor X.1).ι = 𝟙 X :=
    ObjectProperty.hom_ext _ (IsIso.inv_hom_id _)
  rw [definingIdealAt_eq_bot_of_retraction B S hS X
    ⟨⊤, isClosedSubspace_top B S hS X⟩ _ hret U]
  exact Ideal.bot_pow (Nat.succ_ne_zero n)

/-- At `n = 1`: an algebraic space is a first-order thickening of itself. -/
theorem isFirstOrderThickening'_top (X : AlgebraicSpaces B S hS) :
    IsFirstOrderThickening' B S hS X ⊤ :=
  isNthOrderThickening'_top B S hS 1 X

/-! ### Universal first-order thickenings -/

/-- **Stacks 0602.** A first-order thickening `Z ⊆ Z'` over `X`, with structure morphism
`p : Z' ⟶ X`, is *universal* when for every solid diagram of Stacks 0602 — a first-order
thickening `T ⊆ T'` of algebraic spaces, a morphism `a : T ⟶ Z` and a morphism `b : T' ⟶ X`
such that `T ⟶ T' ⟶ X` agrees with `T ⟶ Z ⊆ Z' ⟶ X` — there is a unique dotted arrow
`T' ⟶ Z'` whose restriction to `T` is `a` and which lies over `X`. -/
@[stacks 0602 "the universal first-order thickening property of diagram (0602)"]
structure IsUniversalFirstOrderThickening' {X Z' : AlgebraicSpaces B S hS}
    (Z : Subfunctor Z'.1) (p : Z' ⟶ X) : Prop where
  /-- The inclusion `Z ⊆ Z'` is a first-order thickening. -/
  firstOrder : IsFirstOrderThickening' B S hS Z' Z
  /-- Every solid diagram of Stacks 0602 has a unique dotted arrow. -/
  existsUnique_lift :
    ∀ {T' : AlgebraicSpaces B S hS} (T : Subfunctor T'.1),
      IsFirstOrderThickening' B S hS T' T →
      ∀ (a : T.toFunctor ⟶ Z.toFunctor) (b : T'.1 ⟶ X.1),
        T.ι ≫ b = a ≫ Z.ι ≫ p.hom →
        ∃! c : T'.1 ⟶ Z'.1, (T.ι ≫ c = a ≫ Z.ι) ∧ (c ≫ p.hom = b)

/-- **An algebraic space is its own universal first-order thickening over itself.** The
identity thickening `X ⊆ X` over `X` is universal: the solid-diagram hypothesis says exactly
that `b` restricts to `a` along `T ⊆ T'`, and lying over the identity of `X` forces the dotted
arrow to be `b`.  This exhibits an inhabitant of
`AlgebraicGeometry.Space.IsUniversalFirstOrderThickening'`, and it is the case of Stacks 0604 in
which the morphism `Z ⟶ X` is an isomorphism. -/
theorem isUniversalFirstOrderThickening'_top (X : AlgebraicSpaces B S hS) :
    IsUniversalFirstOrderThickening' B S hS (⊤ : Subfunctor X.1) (𝟙 X) where
  firstOrder := isFirstOrderThickening'_top B S hS X
  existsUnique_lift := fun T _ a b hab => by
    refine ⟨b, ⟨?_, ?_⟩, fun c hc => ?_⟩
    · simpa using hab
    · simp
    · simpa using hc.2

end AlgebraicGeometry.Space

end
