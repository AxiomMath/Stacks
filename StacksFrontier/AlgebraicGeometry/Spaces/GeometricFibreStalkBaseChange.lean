module

public import Mathlib.Algebra.Module.Torsion.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.FlatModuleBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.GeometricFibreStalkFreeness

/-!
# Base change of clause (1) of Stacks 0CZS

Let

```
X' --g'--> X
|f'        |f
v          v
Y' --g---> Y
```

be a cartesian square of algebraic spaces over a scheme `S` of a big fppf site, let `F` be a
quasi-coherent `𝒪_X`-module, let `F' = (g')^* F` and let `x̄'` be a geometric point of `X'` with
image `x̄` in `X`.  This file proves that clause (1) of Stacks 0CZS — flatness of the geometric
fibre stalk — holds at `x̄'` for `F'` exactly when it holds at `x̄` for `F`.

## Main results

* `Module.Flat.quotient_of_tensorProduct_flat`: if `T` is flat over a pushout `A ⊗_R S`, `I` is a
  maximal ideal of `R` and `I'` is an ideal of `S` containing `I S`, then `T / I' T` is flat over
  `A / I A`.
* `Module.Flat.quotSMul_baseChange_iff_of_le`: Stacks 0584 (2) at an ideal of the target lying
  above an ideal of the base.
* `AlgebraicGeometry.Space.flat_geometricFibreModuleStalk_modulePullback_iff`: clause (1) of
  Stacks 0CZS is invariant under base change.

## References

* [Stacks Project, Tag 0CZS](https://stacks.math.columbia.edu/tag/0CZS)
* [Stacks Project, Tag 0CZT](https://stacks.math.columbia.edu/tag/0CZT)
* [Stacks Project, Tag 05VQ](https://stacks.math.columbia.edu/tag/05VQ)
* [Stacks Project, Tag 05VW](https://stacks.math.columbia.edu/tag/05VW)
* [Stacks Project, Tag 0584](https://stacks.math.columbia.edu/tag/0584)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

open scoped TensorProduct

universe u

/-! ### Flatness of the fibre of a flat algebra over a pushout -/

/-- An `R`-linear equivalence between modules over a quotient `R₀` of `R` is `R₀`-linear, the
structure map being surjective. -/
def LinearEquiv.ofQuotientSurjective {R R₀ : Type*} [CommRing R] [CommRing R₀]
    [Algebra R R₀] (hsurj : Function.Surjective (algebraMap R R₀))
    {X Y : Type*} [AddCommGroup X] [AddCommGroup Y] [Module R X] [Module R Y]
    [Module R₀ X] [Module R₀ Y] [IsScalarTower R R₀ X] [IsScalarTower R R₀ Y]
    (e : X ≃ₗ[R] Y) : X ≃ₗ[R₀] Y where
  toFun := e
  map_add' := e.map_add
  map_smul' c x := by
    obtain ⟨a, rfl⟩ := hsurj c
    simp only [RingHom.id_apply, IsScalarTower.algebraMap_smul]
    exact e.map_smul a x
  invFun := e.symm
  left_inv := e.left_inv
  right_inv := e.right_inv

/-- Flatness passes to the quotient by an ideal of the base: if `D` is flat over `C` and
`K = J D` for an ideal `J` of `C`, then `D / K` is flat over `C / J`. -/
theorem Module.Flat.quotient_map_of_idealSMul {C D : Type*} [CommRing C] [CommRing D]
    [Algebra C D] [Module.Flat C D] (J : Ideal C) (K : Ideal D)
    (hK : K = J.map (algebraMap C D)) :
    letI : Algebra (C ⧸ J) (D ⧸ K) :=
      Ideal.Quotient.algebraQuotientOfLEComap
        (Ideal.map_le_iff_le_comap.1 (le_of_eq hK.symm))
    Module.Flat (C ⧸ J) (D ⧸ K) := by
  subst hK
  have : Module.Flat (C ⧸ J) ((C ⧸ J) ⊗[C] D) := Module.Flat.baseChange C (C ⧸ J) D
  exact Module.Flat.of_linearEquiv
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor D J).toLinearEquiv

/-- The quotient algebra `R ⧸ I → S ⧸ I'` induced by `I ≤ I'.comap (algebraMap R S)` is
compatible with the maps from `R`. -/
private theorem isScalarTower_quotient_of_le {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (I : Ideal R) (I' : Ideal S) (h : I ≤ I'.comap (algebraMap R S)) :
    let : Algebra (R ⧸ I) (S ⧸ I') := Ideal.Quotient.algebraQuotientOfLEComap h
    IsScalarTower R (R ⧸ I) (S ⧸ I') := by
  let : Algebra (R ⧸ I) (S ⧸ I') := Ideal.Quotient.algebraQuotientOfLEComap h
  exact IsScalarTower.of_algebraMap_eq fun x => by
    rw [← Ideal.Quotient.mk_algebraMap]; exact Ideal.quotientMap_mk.symm

section Pushout

variable (R A S : Type*) [CommRing R] [CommRing A] [CommRing S] [Algebra R A] [Algebra R S]
  (I : Ideal R) (I' : Ideal S)

/-- In `A ⊗_R S`, the ideal generated by an ideal `I` of `R` through `A` is contained in the one
generated through `S` by any ideal of `S` containing `I S`. -/
theorem Ideal.map_algebraMap_tensorProduct_le_map_includeRight
    (hI' : I.map (algebraMap R S) ≤ I') :
    (I.map (algebraMap R A)).map (algebraMap A (A ⊗[R] S)) ≤
      I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S) := by
  rw [Ideal.map_map]
  refine Ideal.map_le_iff_le_comap.2 fun r hr => Ideal.mem_comap.2 ?_
  have h1 : ((algebraMap A (A ⊗[R] S)).comp (algebraMap R A)) r =
      Algebra.TensorProduct.includeRight.toRingHom (algebraMap R S r) := by
    exact Algebra.TensorProduct.tmul_one_eq_one_tmul r
  rw [h1]
  exact Ideal.mem_map_of_mem _ (hI' (Ideal.mem_map_of_mem _ hr))

/-- The fibre of `A ⊗_R S` over an ideal of `S` lying above a maximal ideal `I` of `R` is flat
over the fibre `A / I A`. -/
theorem Module.Flat.quotient_includeRight_of_isMaximal [I.IsMaximal]
    (hI' : I.map (algebraMap R S) ≤ I') :
    letI : Algebra (A ⧸ I.map (algebraMap R A))
        ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1
        (Ideal.map_algebraMap_tensorProduct_le_map_includeRight R A S I I' hI'))
    Module.Flat (A ⧸ I.map (algebraMap R A))
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) := by
  let : Algebra (A ⧸ I.map (algebraMap R A))
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1
      (Ideal.map_algebraMap_tensorProduct_le_map_includeRight R A S I I' hI'))
  let : IsScalarTower A (A ⧸ I.map (algebraMap R A))
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) :=
    isScalarTower_quotient_of_le _ _ (Ideal.map_le_iff_le_comap.1
      (Ideal.map_algebraMap_tensorProduct_le_map_includeRight R A S I I' hI'))
  let : Algebra (R ⧸ I) (S ⧸ I') :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1 hI')
  let : IsScalarTower R (R ⧸ I) (S ⧸ I') :=
    isScalarTower_quotient_of_le _ _ (Ideal.map_le_iff_le_comap.1 hI')
  let : Field (R ⧸ I) := Ideal.Quotient.field I
  have : Module.Flat (R ⧸ I) ((R ⧸ I) ⊗[R] (S ⧸ I')) := Module.Flat.of_free
  have : Module.Flat (A ⧸ I.map (algebraMap R A))
      ((A ⧸ I.map (algebraMap R A)) ⊗[R ⧸ I] ((R ⧸ I) ⊗[R] (S ⧸ I'))) :=
    Module.Flat.baseChange (R ⧸ I) (A ⧸ I.map (algebraMap R A)) _
  have : Module.Flat (A ⧸ I.map (algebraMap R A))
      ((A ⧸ I.map (algebraMap R A)) ⊗[R] (S ⧸ I')) :=
    Module.Flat.of_linearEquiv (Algebra.TensorProduct.cancelBaseChange R (R ⧸ I)
      (A ⧸ I.map (algebraMap R A)) (A ⧸ I.map (algebraMap R A)) (S ⧸ I')).symm.toLinearEquiv
  have hbot : (I.map (algebraMap R A)).map (algebraMap A (A ⊗[R] (S ⧸ I'))) = ⊥ := by
    rw [Ideal.map_map]
    refine (Ideal.map_eq_bot_iff_le_ker _).2 fun r hr => ?_
    have h0 : algebraMap R (S ⧸ I') r = 0 := by
      rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]
      exact hI' (Ideal.mem_map_of_mem _ hr)
    have h1 : ((algebraMap A (A ⊗[R] (S ⧸ I'))).comp (algebraMap R A)) r =
        (1 : A) ⊗ₜ[R] algebraMap R (S ⧸ I') r := by
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul r
    rw [RingHom.mem_ker, h1, h0, TensorProduct.tmul_zero]
  have E : ((A ⧸ I.map (algebraMap R A)) ⊗[R] (S ⧸ I')) ≃ₐ[A]
      ((A ⊗[R] S) ⧸
        I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) :=
    (Algebra.TensorProduct.quotientTensorEquiv (R := R) A (S ⧸ I') A
        (I.map (algebraMap R A))).trans
      ((Ideal.quotientEquivAlgOfEq A hbot).trans
        ((AlgEquiv.quotientBot A (A ⊗[R] (S ⧸ I'))).trans
          (Algebra.TensorProduct.tensorQuotientEquiv (R := R) A S A I')))
  exact Module.Flat.of_linearEquiv
    (LinearEquiv.ofQuotientSurjective (R := A) Ideal.Quotient.mk_surjective
      E.symm.toLinearEquiv)

variable (T : Type*) [CommRing T] [Algebra A T] [Algebra S T]

/-- For `T` an algebra over the pushout `A ⊗_R S`, the ideal generated in `T` by an ideal `I` of
`R` through `A` is contained in the one generated by any ideal of `S` containing `I S`. -/
theorem Ideal.map_algebraMap_le_map_of_tensorProduct
    (hI' : I.map (algebraMap R S) ≤ I')
    (φ : (A ⊗[R] S) →+* T)
    (hleft : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap A T)
    (hright : φ.comp (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S) =
      algebraMap S T)
    (J : Ideal A) (hJ : J = I.map (algebraMap R A))
    (K : Ideal T) (hK : K = I'.map (algebraMap S T)) :
    J.map (algebraMap A T) ≤ K := by
  subst hJ
  subst hK
  rw [← hleft, ← hright, ← Ideal.map_map, ← Ideal.map_map]
  exact Ideal.map_mono
    (Ideal.map_algebraMap_tensorProduct_le_map_includeRight R A S I I' hI')

/-- **The fibre of a flat algebra over a pushout is flat over the fibre of the left factor.**
Let `R → A` and `R → S` be ring homomorphisms, let `I` be a maximal ideal of `R` and let `I'` be
an ideal of `S` containing `I S`.  If `T` carries a homomorphism from `A ⊗_R S` restricting on
the two factors to its structure maps, and `T` is flat along it, then `T / I' T` is flat over
`A / I A`. -/
theorem Module.Flat.quotient_of_tensorProduct_flat [I.IsMaximal]
    (hI' : I.map (algebraMap R S) ≤ I')
    (φ : (A ⊗[R] S) →+* T)
    (hleft : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap A T)
    (hright : φ.comp (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S) =
      algebraMap S T)
    (hflat : φ.Flat)
    (J : Ideal A) (hJ : J = I.map (algebraMap R A))
    (K : Ideal T) (hK : K = I'.map (algebraMap S T)) :
    letI : Algebra (A ⧸ J) (T ⧸ K) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1
        (Ideal.map_algebraMap_le_map_of_tensorProduct R A S I I' T hI' φ hleft hright J hJ K hK))
    Module.Flat (A ⧸ J) (T ⧸ K) := by
  subst hJ
  subst hK
  let : Algebra (A ⧸ I.map (algebraMap R A)) (T ⧸ I'.map (algebraMap S T)) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1
      (Ideal.map_algebraMap_le_map_of_tensorProduct R A S I I' T hI' φ hleft hright _ rfl _ rfl))
  let : Algebra (A ⊗[R] S) T := φ.toAlgebra
  have : Module.Flat (A ⊗[R] S) T := hflat
  have hT : I'.map (algebraMap S T) =
      (I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)).map
        (algebraMap (A ⊗[R] S) T) := by
    rw [Ideal.map_map]
    exact (congrArg (Ideal.map · I') hright).symm
  let : Algebra (A ⧸ I.map (algebraMap R A))
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1
      (Ideal.map_algebraMap_tensorProduct_le_map_includeRight R A S I I' hI'))
  let : Algebra
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S))
      (T ⧸ I'.map (algebraMap S T)) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1 (le_of_eq hT.symm))
  have : Module.Flat
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S))
      (T ⧸ I'.map (algebraMap S T)) :=
    Module.Flat.quotient_map_of_idealSMul (C := A ⊗[R] S) (D := T) _ _ hT
  have : Module.Flat (A ⧸ I.map (algebraMap R A))
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) :=
    Module.Flat.quotient_includeRight_of_isMaximal R A S I I' hI'
  let : IsScalarTower (A ⧸ I.map (algebraMap R A))
      ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S))
      (T ⧸ I'.map (algebraMap S T)) :=
    IsScalarTower.of_algebraMap_eq fun x => by
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      change Ideal.Quotient.mk _ (algebraMap A T a) =
        Ideal.Quotient.mk _ (algebraMap (A ⊗[R] S) T (algebraMap A (A ⊗[R] S) a))
      exact congrArg (Ideal.Quotient.mk _) (RingHom.congr_fun hleft a).symm
  exact Module.Flat.trans (A ⧸ I.map (algebraMap R A))
    ((A ⊗[R] S) ⧸ I'.map (Algebra.TensorProduct.includeRight.toRingHom : S →+* A ⊗[R] S)) _

end Pushout

/-! ### Stacks 0584 (2) at an ideal of the target above an ideal of the base -/

section ModIff

variable {C : Type*} (D : Type*) [CommRing C] [CommRing D] [Algebra C D]
  (J : Ideal C) (J' : Ideal D) (hJ : J.map (algebraMap C D) ≤ J')
  (M : Type*) [AddCommGroup M] [Module C M]

/-- **Stacks 0584 (2) at an ideal of the target above an ideal of the base.** Let `C → D` be a
ring homomorphism, `J` an ideal of `C` and `J'` an ideal of `D` containing `J D`, and suppose
`D/J'` is faithfully flat over `C/J`.  For a `C`-module `M` and a `D`-module `G` isomorphic to
the base change `D ⊗_C M`, the fibre `M / JM` is flat over `C/J` if and only if the fibre
`G / J'G` is flat over `D/J'`. -/
theorem Module.Flat.quotSMul_baseChange_iff_of_le
    {G : Type*} [AddCommGroup G] [Module D G] (e : D ⊗[C] M ≃ₗ[D] G)
    (hff : letI : Algebra (C ⧸ J) (D ⧸ J') :=
        Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1 hJ)
      Module.FaithfullyFlat (C ⧸ J) (D ⧸ J')) :
    (Module.Flat (C ⧸ J) (M ⧸ J • (⊤ : Submodule C M)) ↔
      Module.Flat (D ⧸ J') (G ⧸ J' • (⊤ : Submodule D G))) := by
  let : Algebra (C ⧸ J) (D ⧸ J') :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1 hJ)
  let : IsScalarTower C (C ⧸ J) (D ⧸ J') :=
    isScalarTower_quotient_of_le _ _ (Ideal.map_le_iff_le_comap.1 hJ)
  have : Module.FaithfullyFlat (C ⧸ J) (D ⧸ J') := hff
  have eD : ((D ⊗[C] M) ⧸ (J' • (⊤ : Submodule D (D ⊗[C] M)))) ≃ₗ[D]
      (G ⧸ (J' • (⊤ : Submodule D G))) :=
    Submodule.Quotient.equiv _ _ e (by
      rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range])
  have eG : ((D ⊗[C] M) ⧸ (J' • (⊤ : Submodule D (D ⊗[C] M)))) ≃ₗ[D ⧸ J']
      (G ⧸ (J' • (⊤ : Submodule D G))) :=
    LinearEquiv.ofQuotientSurjective (R := D) Ideal.Quotient.mk_surjective eD
  have eq1 := (TensorProduct.quotSMulBaseChangeEquivOfLE D J J' hJ M).trans eG
  refine ⟨fun _ => ?_, fun _ => ?_⟩
  · have : Module.Flat (D ⧸ J') ((D ⧸ J') ⊗[C ⧸ J] (M ⧸ J • (⊤ : Submodule C M))) :=
      Module.Flat.baseChange (C ⧸ J) (D ⧸ J') _
    exact Module.Flat.of_linearEquiv eq1.symm
  · have : Module.Flat (D ⧸ J') ((D ⧸ J') ⊗[C ⧸ J] (M ⧸ J • (⊤ : Submodule C M))) :=
      Module.Flat.of_linearEquiv eq1
    have : Module.Flat (C ⧸ J) ((D ⧸ J') ⊗[C ⧸ J] (M ⧸ J • (⊤ : Submodule C M))) :=
      Module.Flat.trans (C ⧸ J) (D ⧸ J') _
    exact (Module.Flat.tensorProduct_iff_of_faithfullyFlat (R := C ⧸ J) (S := C ⧸ J)
      (S' := D ⧸ J') (M := M ⧸ J • (⊤ : Submodule C M))).1 inferInstance

end ModIff

/-! ### Base change of clause (1) of Stacks 0CZS -/

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Clause (1) of Stacks 0CZS is invariant under base change.**  In a cartesian square of
algebraic spaces

```
X' --g'--> X
|f'        |f
v          v
Y' --g---> Y
```

let `F` be a quasi-coherent `𝒪_X`-module and let `x̄'` be a geometric point of `X'` with image
`x̄` in `X`.  Then the fibre stalk `(F_{ȳ})_{x̄}` is a flat `𝒪_{X_{ȳ}, x̄}`-module if and only if
the fibre stalk of the pullback `(g')^* F` at `x̄'` is a flat `𝒪_{X'_{ȳ'}, x̄'}`-module. -/
theorem flat_geometricFibreModuleStalk_modulePullback_iff
    {X Y X' Y' : AlgebraicSpaces B S hS} {g' : X' ⟶ X} {f' : X' ⟶ Y'} {f : X ⟶ Y} {g : Y' ⟶ Y}
    (hpb : IsPullback g' f' f g) (F : Modules.{u, u} B S hS X.1 X.2)
    (x' : GeometricPoint B S hS X'.1) :
    Module.Flat (geometricFibreLocalRing B S hS f (geometricPointMap g'.hom x'))
        (geometricFibreModuleStalk B S hS f F (geometricPointMap g'.hom x')) ↔
      Module.Flat (geometricFibreLocalRing B S hS f' x')
        (geometricFibreModuleStalk B S hS f' ((modulePullback B S hS g').obj F) x') := by
  have h : geometricPointMap f.hom (geometricPointMap g'.hom x') =
      geometricPointMap g.hom (geometricPointMap f'.hom x') :=
    congrArg (fun k : X' ⟶ Y => geometricPointMap k.hom x') hpb.w
  let : Algebra
      ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
      ↥(etaleLocalRing B S hS X.1 (geometricPointMap g'.hom x')) :=
    (etaleLocalRingMap X.2 f.hom (geometricPointMap g'.hom x')).toAlgebra
  let : Algebra
      ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
      ↥(etaleLocalRing B S hS Y'.1 (geometricPointMap f'.hom x')) :=
    ((eqToHom (congrArg (etaleLocalRing B S hS Y.1) h) ≫ CommRingCat.ofHom
      (etaleLocalRingMap Y'.2 g.hom (geometricPointMap f'.hom x'))).hom).toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS X.1 (geometricPointMap g'.hom x'))
      ↥(etaleLocalRing B S hS X'.1 x') := (etaleLocalRingMap X'.2 g'.hom x').toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS Y'.1 (geometricPointMap f'.hom x'))
      ↥(etaleLocalRing B S hS X'.1 x') := (etaleLocalRingMap X'.2 f'.hom x').toAlgebra
  obtain ⟨φ, hleft, hright, hflat⟩ := cartesian_etaleStalk_tensor_flat B S hS g' f' f g hpb x'
  let : IsLocalRing
      ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom (geometricPointMap g'.hom x'))) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS Y'.1 (geometricPointMap f'.hom x')) :=
    isLocalRing_etaleLocalRing B S hS Y'.1 Y'.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS X.1 (geometricPointMap g'.hom x')) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS X'.1 x') :=
    isLocalRing_etaleLocalRing B S hS X'.1 X'.2 _
  have hIso : ∀ {R₂ : CommRingCat.{u + 1}}
      (hR : etaleLocalRing B S hS Y.1 (geometricPointMap f.hom (geometricPointMap g'.hom x'))
        = R₂), IsLocalHom ((eqToHom hR).hom) := by
    intro R₂ hR
    cases hR
    exact ⟨fun a ha => by simpa using ha⟩
  have : IsLocalHom (algebraMap
      ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
      ↥(etaleLocalRing B S hS Y'.1 (geometricPointMap f'.hom x'))) := by
    rw [RingHom.algebraMap_toAlgebra]
    have := hIso (congrArg (etaleLocalRing B S hS Y.1) h)
    have : IsLocalHom (CommRingCat.ofHom
        (etaleLocalRingMap Y'.2 g.hom (geometricPointMap f'.hom x'))).hom :=
      isLocalHom_etaleLocalRingMap B S hS Y'.2 Y.2 g.hom (geometricPointMap f'.hom x')
    exact CommRingCat.isLocalHom_comp _ _
