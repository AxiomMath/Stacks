module

public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierDivisorSum

/-!
# Iterated sums of a closed subspace of an algebraic space

Let `X` be an algebraic space over a scheme `S` contained in a big fppf site `B` and let
`D ⊆ X` be a closed subspace.  Iterating the sum of Stacks 083U with `D` itself produces the
closed subspaces `D`, `D + D`, `D + D + D`, ...; on an affine étale chart of `X` lying over the
chart on which the sums are formed, the defining ideal of the `n`-th iterate is the `(n+1)`-st
power of the defining ideal of `D`.

## Main definitions

* `AlgebraicGeometry.Space.iterSumClosedSubspaces`: the `n`-fold iterated sum of a closed
  subspace with itself, so `iterSumClosedSubspaces D n` is `(n+1) • D`.

## Main results

* `AlgebraicGeometry.Space.definingIdealAt_iterSumClosedSubspaces`: on an affine étale chart
  lying over the chart carrying the sum, the defining ideal of the `n`-th iterate is the
  `(n+1)`-st power of the defining ideal of `D`.
* `AlgebraicGeometry.Space.definingIdealAt_iterSumClosedSubspaces_eq_span_pow`: the same
  computation when the defining ideal of `D` on the chart is principal, generated by a global
  section `a`: the iterate is then cut out by `a ^ (n + 1)`.

## Implementation notes

The induction is immediate from `AlgebraicGeometry.Space.sumClosedSubspaces` and the chartwise
product formula `AlgebraicGeometry.Space.definingIdealAt_sumClosedSubspaces_of_isAffine`; the
only point to watch is the order of the two factors, which `pow_succ` matches because the new
summand `D` is placed on the right.

Every statement needs the affineness of the chart (so that the defining ideals multiply) and a
morphism to the chart on which `AlgebraicGeometry.Space.sumClosedSubspaces` is formed, exactly
as the one-step formula does.

## References

* [Stacks Project, Tag 083U](https://stacks.math.columbia.edu/tag/083U)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (X : AlgebraicSpaces B S hS)

/-- The iterated sum of a closed subspace of an algebraic space with itself:
`iterSumClosedSubspaces D n` is the `(n+1)`-fold sum `D + ⋯ + D` of Stacks 083U, so the index
`0` gives `D` itself and each step adds one more copy of `D` on the right. -/
noncomputable def iterSumClosedSubspaces (D : ClosedSubspaces B S hS X.1) :
    ℕ → ClosedSubspaces B S hS X.1
  | 0 => D
  | (n + 1) => sumClosedSubspaces B S hS X (iterSumClosedSubspaces D n) D

/-- **The defining ideal of an iterated sum is a power.** On an affine étale chart of `X` lying
over the chart on which the sums are formed, the defining ideal of the `n`-th iterated sum of a
closed subspace `D` with itself is the `(n+1)`-st power of the defining ideal of `D`. -/
theorem definingIdealAt_iterSumClosedSubspaces (D : ClosedSubspaces B S hS X.1) (n : ℕ)
    (A : SmallEtale B S hS X.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj A.1.left)]
    (m : A ⟶ (⟨CostructuredArrow.mk (atlasHom B S hS X), atlasHom_etale B S hS X⟩ :
      SmallEtale B S hS X.1)) :
    definingIdealAt B S hS X (iterSumClosedSubspaces B S hS X D n) (op A) =
      definingIdealAt B S hS X D (op A) ^ (n + 1) := by
  induction n with
  | zero => exact (Submodule.pow_one _).symm
  | succ n ih =>
    rw [iterSumClosedSubspaces, definingIdealAt_sumClosedSubspaces_of_isAffine B S hS X _ D A m, ih]
    exact (Submodule.pow_succ _).symm

/-- **A principal defining ideal powers up.** If the defining ideal of a closed subspace `D` of
`X` on an affine étale chart lying over the chart carrying the sums is generated by a global
section `a` of that chart, then the defining ideal of the `n`-th iterated sum of `D` with itself
is generated by `a ^ (n + 1)`. -/
theorem definingIdealAt_iterSumClosedSubspaces_eq_span_pow (D : ClosedSubspaces B S hS X.1)
    (n : ℕ) (A : SmallEtale B S hS X.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj A.1.left)]
    (m : A ⟶ (⟨CostructuredArrow.mk (atlasHom B S hS X), atlasHom_etale B S hS X⟩ :
      SmallEtale B S hS X.1))
    (a : Γ((BigFppfOver.toScheme B S hS).obj A.1.left, ⊤))
    (ha : definingIdealAt B S hS X D (op A) = Ideal.span {a}) :
    definingIdealAt B S hS X (iterSumClosedSubspaces B S hS X D n) (op A) =
      Ideal.span {a ^ (n + 1)} := by
  rw [definingIdealAt_iterSumClosedSubspaces B S hS X D n A m, ha]
  exact Ideal.span_singleton_pow a (n + 1)

end AlgebraicGeometry.Space

end
