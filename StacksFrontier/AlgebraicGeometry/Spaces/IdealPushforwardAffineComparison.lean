* [Stacks Project, Tag 03WF](https://stacks.math.columbia.edu/tag/03WF)
-/

@[expose] public section

noncomputable section

open CategoryTheory Opposite

universe m u

attribute [local instance] AlgebraicGeometry.Space.isContinuous_smallBaseChange

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable {X Y : AlgebraicSpaces B S hS}

section

variable (f : Y ⟶ X) (hf : yoneda.relativelyRepresentable f.hom)
  (F : SheafOfModules.{m} (smallEtaleRingSheaf B S hS Y.1 Y.2))

/-- **The direct image of a submodule of `F`, as a submodule of `f_*F`.**  Its sections over an
étale chart `Q` of `X` are the sections of the submodule over the base-changed chart `Q ×_X Y`,
with the `𝒪_X(Q)`-action restricted along the structure map `f♯`.

Membership is local because small-chart base change is cover preserving. -/
def pushforwardSubmodule (P : F.Submodule) :
    ((smallBaseChangeModulePushforward B S hS f hf).obj F).Submodule where
  obj Q :=
    { carrier := {x | x ∈ P.obj (op ((smallBaseChange B S hS f hf).obj Q.unop))}
      zero_mem' := Submodule.zero_mem _
      add_mem' := fun h₁ h₂ => Submodule.add_mem _ h₁ h₂
      smul_mem' := fun c _ h =>
        Submodule.smul_mem _ (chartIdealPullbackHom B S hS f hf Q.unop c) h }
  map {Q Q'} h := fun _ hx => P.map_mem ((smallBaseChange B S hS f hf).map h.unop).op hx
  isSheaf := by
    rintro ⟨Q⟩ s hs
    refine P.isSheaf (X := op ((smallBaseChange B S hS f hf).obj Q)) s ?_
    refine (SmallEtale.topology B S hS Y.1).superset_covering ?_
      ((coverPreserving_smallBaseChange B S hS f hf).cover_preserve hs)
    rintro W w ⟨Q', g, w', hg, rfl⟩
    have hg' : (P.toSubfunctor.sieveOfSection s).arrows
        ((smallBaseChange B S hS f hf).map g) := hg
    exact (P.toSubfunctor.sieveOfSection s).downward_closed hg' w'

/-- The sections of the direct image of a submodule over an étale chart of `X` are its sections
over the base-changed chart. -/
theorem mem_pushforwardSubmodule_iff (P : F.Submodule) (Q : SmallEtale B S hS X.1)
    {x : F.val.obj (op ((smallBaseChange B S hS f hf).obj Q))} :
    x ∈ (pushforwardSubmodule B S hS f hf F P).obj (op Q) ↔
      x ∈ P.obj (op ((smallBaseChange B S hS f hf).obj Q)) :=
  Iff.rfl

variable (I : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule)

/-- **One inclusion of Stacks 0GF8, as subsheaves of `f_*F`**: for a representable morphism
`f : Y ⟶ X` of algebraic spaces, a sheaf of modules `F` on `Y` and a sheaf of ideals
`I ⊆ 𝒪_X`,

`I · f_*F ⊆ f_*((f⁻¹I) · F)`.

Neither affineness of `f` nor quasi-coherence is used. -/
theorem idealSmul_le_pushforwardSubmodule :
    LE.le (α := ((smallBaseChangeModulePushforward B S hS f hf).obj F).Submodule)
      (Stacks.Sites.idealSmul (O := structureSheaf B S hS X.1 X.2)
        I (⊤ : ((smallBaseChangeModulePushforward B S hS f hf).obj F).Submodule))
      (pushforwardSubmodule B S hS f hf F
        (Stacks.Sites.idealSmul (O := structureSheaf B S hS Y.1 Y.2)
          (pullbackIdealSubsheaf B S hS f hf I) (⊤ : F.Submodule))) := by
  rintro ⟨Q⟩ x hx
  exact mem_idealSmul_pullback_of_mem_pushforward B S hS f hf I F Q hx

/-- **Chart generation of the inverse-image ideal.**  Over an affine chart `V` of `Y` carrying a
morphism to the base change of an affine chart `Q` of `X`, the objectwise inverse-image ideal is
generated by the sections of `I` pulled back from that one chart `Q`.

This is what the opposite inclusion of Stacks 0GF8 needs beyond affineness of `f`; the
implementation notes of `StacksFrontier.AlgebraicGeometry.Spaces.IdealPullbackGenerators` describe
the comparison of generators coming from two charts of `X` which proves it. -/
def IsChartGeneratedPullbackIdeal : Prop :=
  ∀ Q : SmallEtale B S hS X.1,
    IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q) →
      ∀ (V : SmallEtale B S hS Y.1) (v : V ⟶ (smallBaseChange B S hS f hf).obj Q),
      IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj V) →
        pullbackChartIdeal B S hS f hf I V ≤
          Ideal.map (chartSectionsRestrict B S hS Y v)
            (Ideal.map (chartIdealPullbackHom B S hS f hf Q)
              (chartSectionsIdeal B S hS X I Q))

/-- **The inverse-image ideal of a quasi-coherent sheaf of ideals is generated on affine charts
from one chart of the target.**  This is
`AlgebraicGeometry.Space.pullbackChartIdeal_le_map`. -/
theorem isChartGeneratedPullbackIdeal_of_isCartesianOnAffineCharts
    (hI : IsCartesianOnAffineCharts (hF := X.2) I.toSheafOfModules) :
    IsChartGeneratedPullbackIdeal B S hS f hf I :=
  fun Q hQ V v hV => pullbackChartIdeal_le_map B S hS f hf I hI Q hQ V v hV

end

section

variable (f : Y ⟶ X) (haff : IsAffineHom B S hS f.hom)
  (I : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule)
  (F : SheafOfModules.{u} (smallEtaleRingSheaf B S hS Y.1 Y.2))

/-- **The opposite inclusion of Stacks 0GF8, as subsheaves of `f_*F`**, granted that over an
affine chart `V` of `Y` lying over the base change of an affine chart `Q'` of `X` the objectwise
inverse-image ideal is generated by the sections pulled back from `Q'`:

`f_*((f⁻¹I) · F) ⊆ I · f_*F`.

Affineness of `f` makes the base change of an affine chart of `X` an affine chart of `Y`, by
`AlgebraicGeometry.Space.isAffine_smallBaseChange_obj`, which is the other thing the descent
argument of
`AlgebraicGeometry.Space.mem_idealSmul_pushforward_of_mem_idealSmul_pullbackIdealSubsheaf`
needs. -/
theorem pushforwardSubmodule_le_idealSmul
    (hF : IsCartesianOnAffineCharts (hF := Y.2) F)
    (hA : IsChartGeneratedPullbackIdeal B S hS f
      (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) I) :
    pushforwardSubmodule B S hS f
        (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) F
        (Stacks.Sites.idealSmul (O := structureSheaf B S hS Y.1 Y.2)
          (pullbackIdealSubsheaf B S hS f
            (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) I) (⊤ : F.Submodule)) ≤
      Stacks.Sites.idealSmul (O := structureSheaf B S hS X.1 X.2)
        I (⊤ : ((smallBaseChangeModulePushforward B S hS f
          (relativelyRepresentable_hom_of_isAffineHom B S hS f haff)).obj F).Submodule) := by
  rintro ⟨Q⟩ x hx
  exact mem_idealSmul_pushforward_of_mem_idealSmul_pullbackIdealSubsheaf B S hS f _ I F hF
    (fun Q' hQ' => isAffine_smallBaseChange_obj B S hS f _ haff Q' hQ') (hA) Q hx

/-- **Stacks 0GF8.**  Let `S` be a scheme, let `f : Y ⟶ X` be a morphism of algebraic spaces
over `S`, let `F` be a quasi-coherent sheaf on `Y` and let `I` be a quasi-coherent sheaf of
ideals on `X`.  If `f` is affine then

`I · f_*F = f_*((f⁻¹I) · F)`

as subsheaves of `f_*F`.

The notation is the source's.  The inverse-image ideal `f⁻¹I` is a sheaf of ideals of
`f⁻¹𝒪_X`; it acts on `F` through the structure map `f♯ : f⁻¹𝒪_X ⟶ 𝒪_Y` of Stacks 03G8, and
its image in `𝒪_Y` is `AlgebraicGeometry.Space.pullbackIdealSubsheaf`.  Both products are
`Stacks.Sites.idealSmul`, the smallest submodule with local membership containing the local
products `a · s`, and `f_*` of a submodule is
`AlgebraicGeometry.Space.pushforwardSubmodule`.

Quasi-coherence of `F` and of `I` enters as `IsCartesianOnAffineCharts`, which it is equivalent
to by Descent, Proposition 03DX(2)
(`isQuasicoherentOnSite_iff_isCartesianOnAffineCharts`); the form with quasi-coherence as the
hypothesis is
`AlgebraicGeometry.Space.idealSmul_pushforward_eq_of_isQuasicoherentOnSite`. -/
theorem idealSmul_pushforward_eq
    (hI : IsCartesianOnAffineCharts (hF := X.2) I.toSheafOfModules)
    (hF : IsCartesianOnAffineCharts (hF := Y.2) F) :
    Stacks.Sites.idealSmul (O := structureSheaf B S hS X.1 X.2)
        I (⊤ : ((smallBaseChangeModulePushforward B S hS f
          (relativelyRepresentable_hom_of_isAffineHom B S hS f haff)).obj F).Submodule) =
      pushforwardSubmodule B S hS f
        (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) F
        (Stacks.Sites.idealSmul (O := structureSheaf B S hS Y.1 Y.2)
          (pullbackIdealSubsheaf B S hS f
            (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) I) (⊤ : F.Submodule)) :=
  le_antisymm (α := ((smallBaseChangeModulePushforward B S hS f
      (relativelyRepresentable_hom_of_isAffineHom B S hS f haff)).obj F).Submodule)
    (idealSmul_le_pushforwardSubmodule B S hS f _ F I)
    (pushforwardSubmodule_le_idealSmul B S hS f haff I F hF
      (isChartGeneratedPullbackIdeal_of_isCartesianOnAffineCharts B S hS f _ I hI))

/-- **Stacks 0GF8.**  Let `S` be a scheme, let `f : Y ⟶ X` be a morphism of algebraic spaces
over `S`, let `F` be a quasi-coherent sheaf on `Y` and let `I` be a quasi-coherent sheaf of
ideals on `X`.  If `f` is affine then

`I · f_*F = f_*((f⁻¹I) · F)`

as subsheaves of `f_*F`.

This is `AlgebraicGeometry.Space.idealSmul_pushforward_eq` with quasi-coherence, rather than
the equivalent cartesian condition on affine charts, as the hypothesis of the source. -/
@[stacks 0GF8]
theorem idealSmul_pushforward_eq_of_isQuasicoherentOnSite
    (hI : I.toSheafOfModules.IsQuasicoherentOnSite) (hF : F.IsQuasicoherentOnSite) :
    Stacks.Sites.idealSmul (O := structureSheaf B S hS X.1 X.2)
        I (⊤ : ((smallBaseChangeModulePushforward B S hS f
          (relativelyRepresentable_hom_of_isAffineHom B S hS f haff)).obj F).Submodule) =
      pushforwardSubmodule B S hS f
        (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) F
        (Stacks.Sites.idealSmul (O := structureSheaf B S hS Y.1 Y.2)
          (pullbackIdealSubsheaf B S hS f
            (relativelyRepresentable_hom_of_isAffineHom B S hS f haff) I) (⊤ : F.Submodule)) :=
  idealSmul_pushforward_eq B S hS f haff I F
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 I.toSheafOfModules hI)
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2 F hF)

end

end AlgebraicGeometry.Space

end

end
