module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSpacePresentedSections
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleAffineRefinement
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleBaseChangeAdjunction
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjTwistDescent.PsiDescended
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjTwistDescent.PsiKernelGradedIdeal

/-!
# The graded ideal `ℐ = ker(𝒜 ⟶ ⨁_d π_*i_*i^*𝒪_P(d))` of a closed subspace (Stacks 085L)

In Situation 0849 let `π : P = Proj_X(𝒜) ⟶ X` be the relative Proj, `X = U/R` a presentation
and `i : Z ⟶ P` a closed subspace.  The pieces `ℐ_n` of the kernel of the canonical map
`𝒜 ⟶ ⨁_d π_*i_*i^*𝒪_P(d)` attached to `ψ_d : π^*𝒜_d ⟶ 𝒪_P(d)` of Stacks 084D are stable under
multiplication by homogeneous sections of `𝒜`: membership is local on the small étale site of
`X`, every chart of `X` is covered by affine charts mapping to affine charts `W ⟶ U ⟶ X` of the
atlas, on which `ℐ` is an ideal by the chart dictionary, and along a morphism of affine charts
products are generated by restrictions of products.  For `π` quasi-compact this makes `ℐ` a
quasi-coherent graded ideal of Situation 0849.

## Main results

* `AlgebraicGeometry.Space.C1359Bridge.mem_topology_of_atlasAffineCharts`: a sieve on an étale
  chart `V` of `X` containing the affine opens of `V ×_X U` lying over affine opens of `U` covers.
* `AlgebraicGeometry.Space.C1359Bridge.psiKernelPiece_mul_mem_right` and `…_mul_mem_left`: `ℐ`
  is stable under multiplication by homogeneous sections of `𝒜`.
* `AlgebraicGeometry.Space.C1359Bridge.psiKernelGradedIdeal`: `ℐ` as a quasi-coherent graded
  ideal of `𝒜`, for `ψ` the map `AlgebraicGeometry.Space.RelativeProjSituation.psiTwistHom`.
* `AlgebraicGeometry.Space.C1359Bridge.mem_twistKerGradedIdeal_iff_mem_psiKernelGradedIdeal`: on
  the charts `W ⟶ U ⟶ X` of the atlas, `ℐ` has the sections of the graded ideal of Stacks 0801 of
  `Z ×_X U ⊆ Proj_U(𝒜|_U)`.

## References

* [Stacks Project, Tag 085L](https://stacks.math.columbia.edu/tag/085L)
* [Stacks Project, Tag 084D](https://stacks.math.columbia.edu/tag/084D)
-/

@[expose] public noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AlgebraicGeometry.RelativeProj (relativeProj)

namespace AlgebraicGeometry.Space.C1359Bridge

section Cover

variable (s : RelativeProjSituation.{u, u})
  (Px : Presentation s.site s.base s.containsBase s.space.obj s.space.property)
  (hf : IsEtale s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace).hom)
  (hrep : yoneda.relativelyRepresentable (pointHom (X := s.space) Px.toSpace).hom)

/-- The chart `O ⟶ V ×_X U ⟶ V` of `X` cut out by an open `O` of the scheme of `V ×_X U`. -/
abbrev atlasOpenChartHom (V : SmallEtale s.site s.base s.containsBase s.space.1)
    (O : (chartScheme ((smallBaseChange s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hrep).obj V)).Opens) :
    (smallEtalePostcomp s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace) hf).obj
        (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O) ⟶ V :=
  (smallEtalePostcomp s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace) hf).map
      (openChartInclusion s.site s.base s.containsBase (yoneda.obj Px.U)
        ((smallBaseChange s.site s.base s.containsBase
          (pointHom (X := s.space) Px.toSpace) hrep).obj V) O) ≫
    (smallEtalePostcompBaseChangeAdjunction s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hf hrep).counit.app V

/-- The projection `V ×_X U ⟶ U` on schemes, as the morphism of étale charts of `U` to the
identity chart. -/
abbrev atlasChartToId (V : SmallEtale s.site s.base s.containsBase s.space.1) :
    (smallBaseChange s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace) hrep).obj V ⟶
      idEtaleChart s.site s.base s.containsBase Px.U :=
  (isTerminalIdEtaleChart s.site s.base s.containsBase Px.U).from _

/-- The morphism of schemes underlying the chart `O ⟶ V ×_X U ⟶ V` is the inclusion of `O`
followed by the projection `V ×_X U ⟶ V`. -/
theorem toScheme_map_atlasOpenChartHom (V : SmallEtale s.site s.base s.containsBase s.space.1)
    (O : (chartScheme ((smallBaseChange s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hrep).obj V)).Opens) :
    (BigFppfOver.toScheme s.site s.base s.containsBase).map
      ((SmallEtale.toOver s.site s.base s.containsBase s.space.1).map
        (atlasOpenChartHom s Px hf hrep V O)) =
      O.ι ≫ (BigFppfOver.toScheme s.site s.base s.containsBase).map (hrep.snd V.1.hom) := by
  rw [Functor.map_comp, Functor.map_comp]
  congr 1
  exact toScheme_map_toOver_map_openChartInclusion s.site s.base s.containsBase
    (yoneda.obj Px.U) _ O

/-- Every point of the scheme of an étale chart `V` of `X` lies in the image of a chart
`O ⟶ V ×_X U ⟶ V` cut out by an affine open `O` of `V ×_X U` lying over an affine open of `U`. -/
theorem exists_mem_range_atlasOpenChartHom
    (V : SmallEtale s.site s.base s.containsBase s.space.1) (y : chartScheme V) :
    ∃ (W : (chartScheme (idEtaleChart s.site s.base s.containsBase Px.U)).affineOpens)
      (O : (chartScheme ((smallBaseChange s.site s.base s.containsBase
        (pointHom (X := s.space) Px.toSpace) hrep).obj V)).affineOpens),
      O.1 ≤ chartSchemeMap (atlasChartToId s Px hrep V) ⁻¹ᵁ W.1 ∧
        y ∈ Set.range ((BigFppfOver.toScheme s.site s.base s.containsBase).map
          ((SmallEtale.toOver s.site s.base s.containsBase s.space.1).map
            (atlasOpenChartHom s Px hf hrep V O.1))) := by
  have hs : Surjective ((BigFppfOver.toScheme s.site s.base s.containsBase).map
      (hrep.snd V.1.hom)) := Px.surjective.property_snd V.1.hom
  obtain ⟨z, rfl⟩ := hs.surj y
  obtain ⟨W, hW⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((iSup_affineOpens_eq_top (chartScheme (idEtaleChart s.site s.base s.containsBase Px.U))).ge
      (show (chartSchemeMap (atlasChartToId s Px hrep V)) z ∈ ⊤ from trivial))
  obtain ⟨O, hO, hzO, hOW⟩ := exists_isAffineOpen_mem_and_subset
    (show z ∈ chartSchemeMap (atlasChartToId s Px hrep V) ⁻¹ᵁ W.1 from hW)
  obtain ⟨z', hz'⟩ := (Scheme.Opens.range_ι O).ge hzO
  refine ⟨W, ⟨O, show O ∈ _ from hO⟩, hOW, z', ?_⟩
  rw [toScheme_map_atlasOpenChartHom s Px hf hrep V O]
  exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg _ hz')

/-- **Every étale chart of `X` is covered by affine charts mapping to affine charts of the
atlas**: a sieve on an étale chart `V` of `X` which contains the charts `O ⟶ V ×_X U ⟶ V` cut out
by the affine opens `O` of the scheme of `V ×_X U` lying over an affine open of `U` is a covering
sieve. -/
theorem mem_topology_of_atlasAffineCharts
    (V : SmallEtale s.site s.base s.containsBase s.space.1) (R : Sieve V)
    (hR : ∀ (W : (chartScheme (idEtaleChart s.site s.base s.containsBase Px.U)).affineOpens)
      (O : (chartScheme ((smallBaseChange s.site s.base s.containsBase
        (pointHom (X := s.space) Px.toSpace) hrep).obj V)).affineOpens),
      O.1 ≤ chartSchemeMap (atlasChartToId s Px hrep V) ⁻¹ᵁ W.1 →
        R.arrows (atlasOpenChartHom s Px hf hrep V O.1)) :
    R ∈ SmallEtale.topology s.site s.base s.containsBase s.space.1 V := by
  refine (SmallEtale.topology s.site s.base s.containsBase s.space.1).superset_covering ?_
    (SmallEtale.ofArrows_mem_topology s.site s.base s.containsBase s.space.1
      (fun k : Σ W : (chartScheme (idEtaleChart s.site s.base s.containsBase Px.U)).affineOpens,
          {O : (chartScheme ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V)).affineOpens //
              O.1 ≤ chartSchemeMap (atlasChartToId s Px hrep V) ⁻¹ᵁ W.1} =>
        (smallEtalePostcomp s.site s.base s.containsBase
          (pointHom (X := s.space) Px.toSpace) hf).obj
          (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
            ((smallBaseChange s.site s.base s.containsBase
              (pointHom (X := s.space) Px.toSpace) hrep).obj V) k.2.1.1))
      (fun k => atlasOpenChartHom s Px hf hrep V k.2.1.1) ?_)
  · rintro V' g ⟨_, h, _, ⟨k⟩, rfl⟩
    exact R.downward_closed (hR k.1 k.2.1 k.2.2) h
  rw [Scheme.ofArrows_mem_etalePrecoverage_iff]
  refine ⟨fun y => ?_, fun k => etale_toScheme_toOver_map s.site s.base s.containsBase _ _⟩
  obtain ⟨W, O, hOW, hy⟩ := exists_mem_range_atlasOpenChartHom s Px hf hrep V y
  exact ⟨⟨W, O, hOW⟩, hy⟩

end Cover

section Mul

variable (s : RelativeProjSituation.{u, u})
  (Px : Presentation s.site s.base s.containsBase s.space.obj s.space.property)
  {Z : AlgebraicSpaces s.site s.base s.containsBase} (i : Z ⟶ s.Proj)
  (ψ : ∀ d : ℕ, (s.psiSourceQcoh (d : ℤ)).obj ⟶ (s.twistModule Px (d : ℤ)).obj)
  (hψ : ∀ d : ℕ, (modulePullback s.site s.base s.containsBase (presentationAtlas
      (s.relativeProjPoints.spacePresentation Px s.isAlgebraicSpace_relativeProjFunctor))).map
      (ψ d) ≫ (s.twistModuleChartIso Px (d : ℤ)).hom = s.psiChartHomOfAdjoint Px d)

include hψ in
/-- **`ℐ` is stable under right multiplication on the charts `O ⟶ V ×_X U ⟶ V`** cut out by an
affine open `O` of `V ×_X U` lying over an affine open `W` of the atlas: along the morphism to the
affine chart `W ⟶ U ⟶ X`, where `ℐ` is an ideal by the chart dictionary, the products are
generated by restrictions of products, `ℐ` and `𝒜` being quasi-coherent. -/
theorem psiKernelPiece_mul_mem_right_atlasOpenChart
    (hi : IsClosedImmersion s.site s.base s.containsBase i.hom)
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.π.hom)
    (hf : IsEtale s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace).hom)
    (hrep : yoneda.relativelyRepresentable (pointHom (X := s.space) Px.toSpace).hom)
    (V : SmallEtale s.site s.base s.containsBase s.space.1)
    (W : (chartScheme (idEtaleChart s.site s.base s.containsBase Px.U)).affineOpens)
    (O : (chartScheme ((smallBaseChange s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hrep).obj V)).affineOpens)
    (hOW : O.1 ≤ chartSchemeMap (atlasChartToId s Px hrep V) ⁻¹ᵁ W.1) (p q : ℤ)
    {x : (s.algebra.piece p).val.obj (op ((smallEtalePostcomp s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hf).obj
        (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O.1)))}
    (hx : x ∈ (psiKernelPiece s Px i ψ p).obj (op ((smallEtalePostcomp s.site s.base
      s.containsBase (pointHom (X := s.space) Px.toSpace) hf).obj
        (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O.1))))
    (b : (s.algebra.piece q).val.obj (op ((smallEtalePostcomp s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hf).obj
        (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O.1)))) :
    (s.algebra.mul p q).app _ x b ∈ (psiKernelPiece s Px i ψ (p + q)).obj (op
      ((smallEtalePostcomp s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace)
        hf).obj (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O.1))) := by
  have := RelativeProjSituation.quasiCompact_relativeProj_toBase hπ Px.U Px.toSpace
  have hC : IsAffine (chartScheme (s.etalePointChart Px.toSpace hf W.1)) :=
    RelativeProjSituation.isAffine_etalePointChart s Px.toSpace hf W.2
  have hO : IsAffine (chartScheme ((smallEtalePostcomp s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hf).obj
        (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O.1))) := O.2
  have toC : (smallEtalePostcomp s.site s.base s.containsBase
      (pointHom (X := s.space) Px.toSpace) hf).obj
        (openChart s.site s.base s.containsBase (yoneda.obj Px.U)
          ((smallBaseChange s.site s.base s.containsBase
            (pointHom (X := s.space) Px.toSpace) hrep).obj V) O.1) ⟶
      s.etalePointChart Px.toSpace hf W.1 :=
    (smallEtalePostcomp s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace) hf).map
      (openChartHomOfLE s.site s.base s.containsBase (yoneda.obj Px.U) _ hOW ≫
        openChartRestrict s.site s.base s.containsBase (yoneda.obj Px.U)
          (atlasChartToId s Px hrep V) W.1 ≫
        eqToHom (selfOpensFunctor_obj s.site s.base s.containsBase Px.U W.1).symm)
  refine Submodule.span_le.2 ?_ (bilinear_mem_span_image (s.algebra.mul p q)
    (psiKernelPiece s Px i ψ p)
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
      s.space.2 _ (isQuasicoherentOnSite_psiKernelPiece s Px i ψ hπ hi p))
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
      s.space.2 _ (s.isQuasicoherent q)) hC hO toC
    ((psiKernelPiece s Px i ψ (p + q)).obj (op (s.etalePointChart Px.toSpace hf W.1)))
    (fun y hy z => psiKernelPiece_mul_mem_right_chart s Px i ψ hψ hi hf hrep W.1 p q hy z) hx b)
  rintro _ ⟨y, hy, rfl⟩
  exact (psiKernelPiece s Px i ψ (p + q)).map toC.op hy

include hψ in
/-- **`ℐ` is stable under right multiplication** (Stacks 085L), for `π` quasi-compact and `i` a
closed immersion: membership is local, and every chart of `X` is covered by the charts
`O ⟶ V ×_X U ⟶ V` of `AlgebraicGeometry.Space.C1359Bridge.mem_topology_of_atlasAffineCharts`,
where it holds by `…psiKernelPiece_mul_mem_right_atlasOpenChart`. -/
theorem psiKernelPiece_mul_mem_right
    (hi : IsClosedImmersion s.site s.base s.containsBase i.hom)
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.π.hom) (p q : ℤ)
    (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {x : (s.algebra.piece p).val.obj V} (hx : x ∈ (psiKernelPiece s Px i ψ p).obj V)
    (b : (s.algebra.piece q).val.obj V) :
    (s.algebra.mul p q).app V x b ∈ (psiKernelPiece s Px i ψ (p + q)).obj V := by
  have hf : IsEtale s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace).hom :=
    isEtale_of_presheaf_etale s.site s.base s.containsBase Px.etale
  have hrep : yoneda.relativelyRepresentable (pointHom (X := s.space) Px.toSpace).hom :=
    Px.etale.rep
  refine (psiKernelPiece s Px i ψ (p + q)).isSheaf _
    (mem_topology_of_atlasAffineCharts s Px hf hrep V.unop _ fun W O hOW => ?_)
  have h := psiKernelPiece_mul_mem_right_atlasOpenChart s Px i ψ hψ hi hπ hf hrep V.unop W O hOW
    p q (x := (s.algebra.piece p).val.map (atlasOpenChartHom s Px hf hrep V.unop O.1).op x)
    ((psiKernelPiece s Px i ψ p).map (atlasOpenChartHom s Px hf hrep V.unop O.1).op hx)
    ((s.algebra.piece q).val.map (atlasOpenChartHom s Px hf hrep V.unop O.1).op b)
  change (s.algebra.piece (p + q)).val.map (atlasOpenChartHom s Px hf hrep V.unop O.1).op
    ((s.algebra.mul p q).app V x b) ∈ _
  rw [(s.algebra.mul p q).naturality]
  exact h

/-- Membership in a family of submodules indexed by the degree is transported along an equality
of degrees and a heterogeneous equality of sections. -/
private theorem mem_of_heq (P : ∀ n : ℤ, (s.algebra.piece n).Submodule) {n m : ℤ} (h : n = m)
    (X : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    {a : (s.algebra.piece n).val.obj X} {b : (s.algebra.piece m).val.obj X} (hab : HEq a b)
    (ha : a ∈ (P n).obj X) : b ∈ (P m).obj X := by
  subst h
  cases hab
  exact ha

include hψ in
/-- **`ℐ` is stable under left multiplication** (Stacks 085L): `𝒜` is commutative. -/
theorem psiKernelPiece_mul_mem_left
    (hi : IsClosedImmersion s.site s.base s.containsBase i.hom)
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.π.hom) (p q : ℤ)
    (V : (SmallEtale s.site s.base s.containsBase s.space.1)ᵒᵖ)
    (a : (s.algebra.piece p).val.obj V) {x : (s.algebra.piece q).val.obj V}
    (hx : x ∈ (psiKernelPiece s Px i ψ q).obj V) :
    (s.algebra.mul p q).app V a x ∈ (psiKernelPiece s Px i ψ (p + q)).obj V :=
  mem_of_heq s (psiKernelPiece s Px i ψ) (add_comm q p) V (s.mul_comm q p V x a)
    (psiKernelPiece_mul_mem_right s Px i ψ hψ hi hπ q p V hx a)

end Mul

section Ideal

variable (s : RelativeProjSituation.{u, u})
  (Px : Presentation s.site s.base s.containsBase s.space.obj s.space.property)
  {Z : AlgebraicSpaces s.site s.base s.containsBase} (i : Z ⟶ s.Proj)

/-- **The graded ideal `ℐ ⊆ 𝒜` of Stacks 085L cut out by a closed subspace `i : Z ⟶ P`**, for
`π` quasi-compact and `i` a closed immersion: in degree `d ≥ 0` the kernel of the canonical map
`𝒜_d ⟶ π_*i_*i^*𝒪_P(d)` attached to `ψ_d : π^*𝒜_d ⟶ 𝒪_P(d)` of Stacks 084D, and `ℐ_n = 𝒜_n = 0`
for `n < 0`; a quasi-coherent graded ideal of `𝒜`. -/
def psiKernelGradedIdeal (hi : IsClosedImmersion s.site s.base s.containsBase i.hom)
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.π.hom) : s.GradedIdeal where
  piece := psiKernelPiece s Px i (fun d => s.psiTwistHom Px d)
  mul_mem_left p q V a _ hx := psiKernelPiece_mul_mem_left s Px i (fun d => s.psiTwistHom Px d)
    (fun d => s.modulePullback_map_psiTwistHom_comp_twistModuleChartIso_hom Px d) hi hπ p q V a hx
  mul_mem_right p q V _ b hx := psiKernelPiece_mul_mem_right s Px i (fun d => s.psiTwistHom Px d)
    (fun d => s.modulePullback_map_psiTwistHom_comp_twistModuleChartIso_hom Px d) hi hπ p q V hx b
  isQuasicoherent := isQuasicoherentOnSite_psiKernelPiece s Px i _ hπ hi

/-- The pieces of `ℐ`. -/
theorem psiKernelGradedIdeal_piece (hi : IsClosedImmersion s.site s.base s.containsBase i.hom)
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.π.hom) (n : ℤ) :
    (psiKernelGradedIdeal s Px i hi hπ).piece n =
      psiKernelPiece s Px i (fun d => s.psiTwistHom Px d) n :=
  rfl

/-- **The chart property of `ℐ` at the atlas** (Stacks 085L): at the atlas `u : U ⟶ X`, a local
section `a` of `(u^*𝒜)_n` over a Zariski open `W` lies in the graded ideal of Stacks 0801 of
`Z ×_X U ⊆ Proj_U(u^*𝒜)` exactly when its reading on the chart `W ⟶ U ⟶ X` lies in `ℐ_n`. -/
theorem mem_twistKerGradedIdeal_iff_mem_psiKernelGradedIdeal
    (hi : IsClosedImmersion s.site s.base s.containsBase i.hom)
    (hπ : IsQuasiCompact s.site s.base s.containsBase s.π.hom)
    [AlgebraicGeometry.QuasiCompact (relativeProj
      (s.relativeProjPoints.algebra Px.U Px.toSpace)).toBase] (n : ℤ)
    (hf : IsEtale s.site s.base s.containsBase (pointHom (X := s.space) Px.toSpace).hom)
    (W : ((BigFppfOver.toScheme s.site s.base s.containsBase).obj Px.U).Opens)
    (a : Γ((s.relativeProjPoints.algebra Px.U Px.toSpace).piece n, W)) :
    a ∈ ((Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.twistKerGradedIdeal
        (s.relativeProjPoints.algebra Px.U Px.toSpace)
        (Stacks.AlgebraicGeometry.GluedTwistAlgebra.twistDataOfGradedAlgebra _)
        (RelativeProjSituation.chartClosedSubscheme i hi Px.U Px.toSpace)).piece
          n).toSubmodule.obj (op W) ↔
      s.etalePointReading Px.toSpace hf n W a ∈
        ((psiKernelGradedIdeal s Px i hi hπ).piece n).obj
          (op (s.etalePointChart Px.toSpace hf W)) :=
  mem_twistKerGradedIdeal_iff_mem_psiKernelPiece_int s Px i (fun d => s.psiTwistHom Px d)
    (fun d => s.modulePullback_map_psiTwistHom_comp_twistModuleChartIso_hom Px d) hi n hf W a

end Ideal

end AlgebraicGeometry.Space.C1359Bridge

