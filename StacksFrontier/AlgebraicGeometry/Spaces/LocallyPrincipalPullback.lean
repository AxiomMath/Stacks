@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Two morphisms of the site with the same range -/

/-- A morphism of the big fppf category over `S` factors through another one as soon as the
two have the same range as morphisms of presheaves. -/
private theorem exists_comp_eq_of_range_eq {a b c : BigFppfOver B S hS} (m : a ⟶ c) (n : b ⟶ c)
    (h : Subfunctor.range (yoneda.map m) = Subfunctor.range (yoneda.map n)) :
    ∃ u : a ⟶ b, u ≫ n = m := by
  have hm : m ∈ (Subfunctor.range (yoneda.map n)).obj (op a) := by
    rw [← h]; exact ⟨𝟙 a, by simp⟩
  obtain ⟨u, hu⟩ := hm
  exact ⟨u, hu⟩

/-- Two morphisms of the big fppf category over `S` with the same range as morphisms of
presheaves have the same kernel on global sections of the underlying schemes. -/
private theorem ker_eq_of_range_eq {a b c : BigFppfOver B S hS} (m : a ⟶ c) (n : b ⟶ c)
    (h : Subfunctor.range (yoneda.map m) = Subfunctor.range (yoneda.map n)) :
    RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map m).op).hom =
      RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map n).op).hom := by
  obtain ⟨u, hu⟩ := exists_comp_eq_of_range_eq B S hS m n h
  obtain ⟨v, hv⟩ := exists_comp_eq_of_range_eq B S hS n m h.symm
  refine le_antisymm ?_ ?_
  · rw [← hv]; exact ker_le_ker_comp B S hS v m
  · rw [← hu]; exact ker_le_ker_comp B S hS u n

/-- Two morphisms of the big fppf category over `S` with the same range as morphisms of
presheaves have the same kernel as ideal sheaves of the underlying schemes. -/
private theorem schemeKer_eq_of_range_eq {a b c : BigFppfOver B S hS} (m : a ⟶ c) (n : b ⟶ c)
    (h : Subfunctor.range (yoneda.map m) = Subfunctor.range (yoneda.map n)) :
    ((BigFppfOver.toScheme B S hS).map m).ker = ((BigFppfOver.toScheme B S hS).map n).ker := by
  obtain ⟨u, hu⟩ := exists_comp_eq_of_range_eq B S hS m n h
  obtain ⟨v, hv⟩ := exists_comp_eq_of_range_eq B S hS n m h.symm
  refine le_antisymm ?_ ?_
  · rw [← hv, Functor.map_comp]; exact Scheme.Hom.le_ker_comp _ _
  · rw [← hu, Functor.map_comp]; exact Scheme.Hom.le_ker_comp _ _

/-! ### The inverse image of a closed subspace on a chart of the source -/

variable {X Y : AlgebraicSpaces B S hS}

/-- **The base change of a closed subspace to a chart of the source computes the inverse
image.** For a morphism `f : Y ⟶ X` of algebraic spaces, a closed subspace `Z ⊆ X` and an
étale scheme chart `V` of `Y`, the canonical base change of `f⁻¹(Z)` to `V` and the canonical
base change of `Z` along the composite `V ⟶ Y ⟶ X` have the same range in `V`, hence cut out
the same closed subscheme of `V`. -/
private theorem range_snd_preimage_eq (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1)
    (V : SmallEtale B S hS Y.1) :
    Subfunctor.range (yoneda.map ((⟨Z.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
        ClosedSubspaces B S hS Y.1).2.2.rep.snd V.1.hom)) =
      Subfunctor.range (yoneda.map (Z.2.2.rep.snd (V.1.hom ≫ f.hom))) := by
  rw [range_yoneda_snd_eq_preimage B S hS V.1.hom
      (⟨Z.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
        ClosedSubspaces B S hS Y.1).2.2.rep,
    range_yoneda_snd_eq_preimage B S hS (V.1.hom ≫ f.hom) Z.2.2.rep,
    Subfunctor.preimage_comp]

/-- **The defining ideal of an inverse image, on a chart of the source.** On an étale scheme
chart `V` of `Y` the defining ideal of `f⁻¹(Z)` is the kernel of pullback of regular functions
along the canonical base change `Z ×_X V ⟶ V` formed along the composite `V ⟶ Y ⟶ X`. -/
theorem definingIdealAt_preimage (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1)
    (V : SmallEtale B S hS Y.1) :
    definingIdealAt B S hS Y (⟨Z.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
        ClosedSubspaces B S hS Y.1) (op V) =
      RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
        (Z.2.2.rep.snd (V.1.hom ≫ f.hom))).op).hom := by
  rw [definingIdealAt_eq_ker]
  exact ker_eq_of_range_eq B S hS _ _ (range_snd_preimage_eq B S hS f Z V)

/-- **The ideal sheaf of an inverse image, on a chart of the source.** On an étale scheme chart
`V` of `Y` the ideal sheaf of the canonical base change of `f⁻¹(Z)` is the ideal sheaf of the
canonical base change of `Z` along the composite `V ⟶ Y ⟶ X`. -/
theorem schemeKer_snd_preimage (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1)
    (V : SmallEtale B S hS Y.1) :
    ((BigFppfOver.toScheme B S hS).map
        ((⟨Z.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
        ClosedSubspaces B S hS Y.1).2.2.rep.snd V.1.hom)).ker =
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd (V.1.hom ≫ f.hom))).ker :=
  schemeKer_eq_of_range_eq B S hS _ _ (range_snd_preimage_eq B S hS f Z V)

/-! ### The defining ideal of an inverse image on an affine chart -/

/-- **The base change of a closed subspace along a composite.** The ideal sheaf of the
canonical base change of `Z` along `yoneda.map r ≫ p` is the inverse image, along `r`, of the
ideal sheaf of its canonical base change along `p`. -/
theorem schemeKer_snd_comp (Z : ClosedSubspaces B S hS X.1)
    {A A' : BigFppfOver B S hS} (p : yoneda.obj A ⟶ X.1) (r : A' ⟶ A) :
    ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd (yoneda.map r ≫ p))).ker =
      (((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd p)).ker).comap
        ((BigFppfOver.toScheme B S hS).map r) := by
  obtain ⟨l, hsq⟩ := exists_isPullback_snd_comp B S hS Z.2.2.rep p r _ rfl
  have : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd p)) := Z.2.2.property_snd p
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd p))
      ((BigFppfOver.toScheme B S hS).map r),
    ← Scheme.Hom.ker_comp_of_isIso hsq.flip.isoPullback.hom,
    hsq.flip.isoPullback_hom_fst]

/-- **The defining ideal of an inverse image is the ideal generated by the pullback of the
defining ideal.** Let `f : Y ⟶ X` be a morphism of algebraic spaces, `Z ⊆ X` a closed
subspace, `U` an affine étale scheme chart of `X`, `V` an affine étale scheme chart of `Y`,
and `p : V ⟶ U` a morphism of the site lying over `f`.  Then the defining ideal of `f⁻¹(Z)` on
`V` is generated by the image of the defining ideal of `Z` on `U` under pullback of regular
functions along `p`.

This is the whole content of the inverse image of a closed subspace read on charts: the
closed subscheme `Z ×_X V` of `V` is the base change of the closed subscheme `Z ×_X U` of `U`,
and the ideal of a base change is the extension of the ideal. -/
@[ega "IV 11.3.4" "more general"]
theorem definingIdealAt_preimage_eq_map (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1) (V : SmallEtale B S hS Y.1) (p : V.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = V.1.hom ≫ f.hom)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)] :
    definingIdealAt B S hS Y (⟨Z.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
        ClosedSubspaces B S hS Y.1) (op V) =
      Ideal.map ((BigFppfOver.toScheme B S hS).map p).appTop.hom
        (definingIdealAt B S hS X Z (op U)) := by
  have hker : Scheme.IdealSheafData.ofIdealTop
      (definingIdealAt B S hS Y (⟨Z.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
        ClosedSubspaces B S hS Y.1) (op V)) =
      (Scheme.IdealSheafData.ofIdealTop (definingIdealAt B S hS X Z (op U))).comap
        ((BigFppfOver.toScheme B S hS).map p) := by
    rw [← ker_rep_snd_eq_ofIdealTop_definingIdealAt B S hS Y _ V,
      ← ker_rep_snd_eq_ofIdealTop_definingIdealAt B S hS X Z U,
      schemeKer_snd_preimage B S hS f Z V, ← hp,
      schemeKer_snd_comp B S hS Z U.1.hom p]
  have hsec := congrArg (fun J ↦ Scheme.IdealSheafData.ideal J
    ⟨⊤, isAffineOpen_top ((BigFppfOver.toScheme B S hS).obj V.1.left)⟩) hker
  -- The canonical form of this fact, `Stacks.Divisors.ideal_ofIdealTop_top`, lives in a module
  -- which imports this one, so the one proof that needs it reproves it locally.
  have key : ∀ {W : Scheme.{u}} (hW : IsAffineOpen (⊤ : W.Opens)) (I : Ideal Γ(W, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop I).ideal ⟨⊤, hW⟩ = I := by
    intro W hW I
    rw [Scheme.IdealSheafData.ofIdealTop_ideal,
      show (homOfLE (le_top (a := (⊤ : W.Opens)))) = 𝟙 _ from rfl]
    simp
  have e1 := key
    (isAffineOpen_top ((BigFppfOver.toScheme B S hS).obj V.1.left))
    (definingIdealAt B S hS Y (⟨Z.1.preimage f.hom,
      isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ :
      ClosedSubspaces B S hS Y.1) (op V))
  have e2 := key
    (isAffineOpen_top ((BigFppfOver.toScheme B S hS).obj U.1.left))
    (definingIdealAt B S hS X Z (op U))
  have e3 := Stacks.IdealSheaf.ideal_comap_top_of_isAffine
    (Scheme.IdealSheafData.ofIdealTop (X := (BigFppfOver.toScheme B S hS).obj U.1.left)
      (definingIdealAt B S hS X Z (op U)))
    ((BigFppfOver.toScheme B S hS).map p)
  exact e1.symm.trans (hsec.trans (e3.trans
    (congrArg (Ideal.map ((BigFppfOver.toScheme B S hS).map p).appTop.hom) e2)))

/-! ### Charts around a point -/

section Charts

variable (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-- Pullback of regular functions along a morphism of the big fppf category over `S`. -/
private abbrev siteRestrict {A A' : BigFppfOver B S hS} (r : A' ⟶ A) :
    Γ((BigFppfOver.toScheme B S hS).obj A, ⊤) →+*
      Γ((BigFppfOver.toScheme B S hS).obj A', ⊤) :=
  (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map r).op).hom

/-- **An affine étale chart around a point of a chart.** Every point of the scheme underlying
an étale chart lies in an affine open of it, and that affine open is again an étale chart. -/
theorem exists_affine_chart_at (T : SmallEtale B S hS F)
    (w : (BigFppfOver.toScheme B S hS).obj T.1.left) :
    ∃ (T₀ : SmallEtale B S hS F) (ι : T₀ ⟶ T),
      IsAffine ((BigFppfOver.toScheme B S hS).obj T₀.1.left) ∧
      ∃ w₀ : (BigFppfOver.toScheme B S hS).obj T₀.1.left,
        ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS F).map ι)) w₀ = w := by
  obtain ⟨_, ⟨O, hO, rfl⟩, hwO, -⟩ :=
    ((BigFppfOver.toScheme B S hS).obj T.1.left).isBasis_affineOpens.exists_subset_of_mem_open
      (show w ∈ (⊤ : Set _) from trivial) isOpen_univ
  refine ⟨openChart B S hS F T O, openChartInclusion B S hS F T O, hO, ⟨w, hwO⟩, ?_⟩
  rw [toScheme_map_toOver_map_openChartInclusion]
  rfl

/-- Pullback of a global regular function along a morphism of étale charts of an algebraic
space. -/
abbrev etaleChartRestrict {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V : SmallEtale B S hS F} (m : V ⟶ U) :
    Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤) →+*
      Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤) :=
  ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map m)).appTop.hom

/-- `AlgebraicGeometry.Space.etaleChartRestrict` is pullback along the underlying morphism of
the big fppf category over `S`. -/
private theorem etaleChartRestrict_eq_siteRestrict {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V : SmallEtale B S hS F} (m : V ⟶ U) :
    etaleChartRestrict B S hS m = siteRestrict B S hS ((SmallEtale.toOver B S hS F).map m) :=
  rfl

/-- Pullback of regular functions along a composite of morphisms of the site. -/
private theorem siteRestrict_comp {A A' A'' : BigFppfOver B S hS} (r : A' ⟶ A) (r' : A'' ⟶ A')
    (x : Γ((BigFppfOver.toScheme B S hS).obj A, ⊤)) :
    siteRestrict B S hS r' (siteRestrict B S hS r x) = siteRestrict B S hS (r' ≫ r) x := by
  simp only [siteRestrict, Functor.map_comp, op_comp, CommRingCat.hom_comp]
  rfl

/-- Pullback along a morphism of charts after pullback along a morphism of the site. -/
private theorem etaleChartRestrict_siteRestrict_comp {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V : SmallEtale B S hS F} (m : V ⟶ U) {A : BigFppfOver B S hS} (r : U.1.left ⟶ A)
    (x : Γ((BigFppfOver.toScheme B S hS).obj A, ⊤)) :
    etaleChartRestrict B S hS m (siteRestrict B S hS r x) =
      siteRestrict B S hS ((SmallEtale.toOver B S hS F).map m ≫ r) x :=
  siteRestrict_comp B S hS r _ x

/-- Pullback of regular functions along a composite of morphisms of étale charts. -/
private theorem etaleChartRestrict_comp {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V W : SmallEtale B S hS F} (m : V ⟶ U) (m' : W ⟶ V)
    (x : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤)) :
    etaleChartRestrict B S hS m' (etaleChartRestrict B S hS m x) =
      etaleChartRestrict B S hS (m' ≫ m) x := by
  rw [etaleChartRestrict_eq_siteRestrict, etaleChartRestrict_eq_siteRestrict,
    etaleChartRestrict_eq_siteRestrict, siteRestrict_comp, Functor.map_comp]

/-- **A covering sieve of the small étale site is jointly surjective on scheme points.** -/
theorem exists_mem_sieve_scheme_point (U : SmallEtale B S hS F) {R : Sieve U}
    (hR : R ∈ SmallEtale.topology B S hS F U)
    (z : (BigFppfOver.toScheme B S hS).obj U.1.left) :
    ∃ (V : SmallEtale B S hS F) (g : V ⟶ U), R.arrows g ∧
      ∃ z' : (BigFppfOver.toScheme B S hS).obj V.1.left,
        ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map g)) z' = z := by
  obtain ⟨x, hx⟩ := surjective_pointsToScheme B S hS ((SmallEtale.toOver B S hS F).obj U) z
  obtain ⟨V, g, hg, y, hy⟩ := SmallEtale.exists_mem_arrows_pointsMap_eq B S hS F hR x
  refine ⟨V, g, hg, pointsToScheme B S hS ((SmallEtale.toOver B S hS F).obj V) y, ?_⟩
  rw [← pointsToScheme_pointsMap_yoneda B S hS ((SmallEtale.toOver B S hS F).map g) y, hy, hx]

end Charts

/-! ### Two multiplicative identities for pullback of regular functions -/

/-- A factorisation of a ring element is preserved by a ring homomorphism. -/
private theorem map_mul_eq_of_mul_eq {R₀ R₁ : Type*} [CommRing R₀] [CommRing R₁]
    (φ : R₀ →+* R₁) {c x y : R₀} (h : c * x = y) : φ c * φ x = φ y := by
  rw [← map_mul, h]

/-- **A combination whose summands all become multiples of one element.** If the image of
each `x l` is `d l` times `y`, then the image of the combination `∑ l, cc l * x l` is the
combination of the images of the `cc l` with coefficients `d l`, times `y`. -/
private theorem sum_mul_eq_map_sum {R₀ R₁ : Type*} [CommRing R₀] [CommRing R₁]
    (φ : R₀ →+* R₁) {n : ℕ} (cc x : Fin n → R₀) (d : Fin n → R₁) (y : R₁)
    (h : ∀ l, φ (x l) = d l * y) :
    (∑ l, φ (cc l) * d l) * y = φ (∑ l, cc l * x l) := by
  rw [map_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [map_mul, h l, mul_assoc]

/-! ### Sections of the defining ideal sheaf as regular functions -/

section Sections

variable (X' : AlgebraicSpaces B S hS) (W : ClosedSubspaces B S hS X'.1)

/-- The sections of the defining ideal sheaf of a closed subspace `W ⊆ X'` over an étale chart
`V` of `X'`. -/
private abbrev idealSections (V : SmallEtale B S hS X'.1) :=
  ToType (((definingIdealSheaf B S hS X' W).toSheafOfModules).val.obj (op V))

/-- **The regular function underlying a section of the defining ideal sheaf.** This is the
identification of the sections of the structure sheaf of `X'` over an étale chart with the
global functions of the chart scheme; it is stated once here, so that the proofs below never
ask the elaborator to rediscover it. -/
private def sectionFun {V : SmallEtale B S hS X'.1} (t : idealSections B S hS X' W V) :
    Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤) :=
  t.1

/-- The regular function underlying a section of the defining ideal sheaf lies in the defining
ideal at that chart. -/
private theorem sectionFun_mem {V : SmallEtale B S hS X'.1}
    (t : idealSections B S hS X' W V) :
    sectionFun B S hS X' W t ∈ definingIdealAt B S hS X' W (op V) :=
  t.2

/-- A regular function lying in the defining ideal at a chart, as a section of the defining
ideal sheaf there. -/
private def sectionOfMem {V : SmallEtale B S hS X'.1}
    (x : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤))
    (hx : x ∈ definingIdealAt B S hS X' W (op V)) :
    idealSections B S hS X' W V :=
  ⟨x, hx⟩

/-- The regular function underlying `AlgebraicGeometry.Space.sectionOfMem` is the given one. -/
private theorem sectionFun_sectionOfMem {V : SmallEtale B S hS X'.1}
    (x : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤))
    (hx : x ∈ definingIdealAt B S hS X' W (op V)) :
    sectionFun B S hS X' W (sectionOfMem B S hS X' W x hx) = x :=
  rfl

/-- A section of the defining ideal sheaf is determined by its underlying regular function. -/
private theorem sectionFun_injective {V : SmallEtale B S hS X'.1}
    {t t' : idealSections B S hS X' W V}
    (h : sectionFun B S hS X' W t = sectionFun B S hS X' W t') : t = t' :=
  Subtype.ext h

/-- Restriction of a section of the defining ideal sheaf along a morphism of charts is pullback
of its underlying regular function. -/
private theorem sectionFun_restrict {V V' : SmallEtale B S hS X'.1} (g : V' ⟶ V)
    (t : idealSections B S hS X' W V) :
    sectionFun B S hS X' W
        (((definingIdealSheaf B S hS X' W).toSheafOfModules.val.restrictₛₗ g.op) t) =
      etaleChartRestrict B S hS g (sectionFun B S hS X' W t) :=
  rfl

/-- A global regular function on a chart scheme, as a section of the structure sheaf of `X'`
over that chart. -/
private def structureSection {V : SmallEtale B S hS X'.1}
    (c : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤)) :
    ToType ((structureRingSheaf B S hS X').obj.obj (op V)) :=
  c

/-- The regular function underlying a multiple of a section of the defining ideal sheaf. -/
private theorem sectionFun_smul {V : SmallEtale B S hS X'.1}
    (c : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤))
    (t : idealSections B S hS X' W V) :
    sectionFun B S hS X' W (structureSection B S hS X' c • t) =
      c * sectionFun B S hS X' W t :=
  rfl

/-- **Pullback of regular functions preserves the defining ideal.** This is
`AlgebraicGeometry.Space.definingIdealAt_map` with the restriction maps of the structure sheaf
identified with pullback of global functions along the morphism of chart schemes. -/
private theorem etaleChartRestrict_mem_definingIdealAt {U V : SmallEtale B S hS X'.1} (m : V ⟶ U)
    (x : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (hx : x ∈ definingIdealAt B S hS X' W (op U)) :
    etaleChartRestrict B S hS m x ∈ definingIdealAt B S hS X' W (op V) :=
  definingIdealAt_map B S hS X' W m.op x hx

/-- **The sieve of charts on which a section is a multiple of a prescribed function.** For a
chart `V` of `X'` lying over a chart `T` by `h`, a regular function `b` on `T` and a section
`t` of the defining ideal sheaf over `V`, this is the sieve of morphisms `g` of charts to `V`
on which the pullback of `t` is a multiple of the pullback of `b`.  It is downward closed
because pullback of regular functions is multiplicative. -/
private def multipleSieve {T V : SmallEtale B S hS X'.1} (h : V ⟶ T)
    (b : Γ((BigFppfOver.toScheme B S hS).obj T.1.left, ⊤))
    (t : idealSections B S hS X' W V) : Sieve V where
  arrows := fun T₂ g => ∃ c : Γ((BigFppfOver.toScheme B S hS).obj T₂.1.left, ⊤),
    c * etaleChartRestrict B S hS (g ≫ h) b = etaleChartRestrict B S hS g (sectionFun B S hS X' W t)
  downward_closed := by
    rintro T₂ T₃ g ⟨c, hc⟩ k
    refine ⟨etaleChartRestrict B S hS k c, ?_⟩
    have h1 : etaleChartRestrict B S hS ((k ≫ g) ≫ h) b =
        etaleChartRestrict B S hS k (etaleChartRestrict B S hS (g ≫ h) b) := by
      rw [etaleChartRestrict_comp, Category.assoc]
    have h2 : etaleChartRestrict B S hS (k ≫ g) (sectionFun B S hS X' W t) =
        etaleChartRestrict B S hS k
          (etaleChartRestrict B S hS g (sectionFun B S hS X' W t)) :=
      (etaleChartRestrict_comp B S hS g k (sectionFun B S hS X' W t)).symm
    rw [h1, h2]
    exact map_mul_eq_of_mul_eq (etaleChartRestrict B S hS k) hc

/-- Membership in `AlgebraicGeometry.Space.multipleSieve`, unfolded. -/
private theorem multipleSieve_arrows {T V T₂ : SmallEtale B S hS X'.1} (h : V ⟶ T)
    (b : Γ((BigFppfOver.toScheme B S hS).obj T.1.left, ⊤))
    (t : idealSections B S hS X' W V) (g : T₂ ⟶ V) :
    (multipleSieve B S hS X' W h b t).arrows g ↔
      ∃ c : Γ((BigFppfOver.toScheme B S hS).obj T₂.1.left, ⊤),
        c * etaleChartRestrict B S hS (g ≫ h) b =
          etaleChartRestrict B S hS g (sectionFun B S hS X' W t) :=
  Iff.rfl

end Sections

/-- A member of the image of an ideal is a finite combination of images of its elements. -/
private theorem exists_sum_of_mem_ideal_map {R₀ R₁ : Type*} [Semiring R₀] [Semiring R₁]
    (φ : R₀ →+* R₁) (I : Ideal R₀) {x : R₁} (hx : x ∈ Ideal.map φ I) :
    ∃ (n : ℕ) (c : Fin n → R₁) (k : Fin n → R₀), (∀ l, k l ∈ I) ∧
      ∑ l, c l * φ (k l) = x := by
  have hspan : x ∈ Ideal.span (φ '' (I : Set R₀)) := hx
  rw [Submodule.mem_span_set'] at hspan
  obtain ⟨n, c, gg, hsum⟩ := hspan
  choose k hkI hkv using fun l => (gg l).2
  refine ⟨n, c, k, hkI, ?_⟩
  rw [← hsum]
  exact Finset.sum_congr rfl fun l _ => by rw [hkv l, smul_eq_mul]

/-- The image of a member of a principal ideal under a ring homomorphism lies in the
principal ideal generated by the image of the generator. -/
private theorem map_mem_span_singleton {R₀ R₁ : Type*} [CommRing R₀] [CommRing R₁]
    (φ : R₀ →+* R₁) {x y : R₀} (h : y ∈ Ideal.span {x}) :
    φ y ∈ Ideal.span {φ x} := by
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp h
  exact Ideal.mem_span_singleton'.mpr ⟨φ c, by rw [map_mul]⟩

/-! ### Charts of the source lying over charts of the target -/

/-- **Base change of a chart of `Y` lying over a chart of `X`.** Let `T` be an étale chart of
`Y` with a morphism `p` to an étale chart `U₀` of `X` lying over `f`, and let `m : U' ⟶ U₀` be
a morphism of étale charts of `X`.  The fibre product `T ×_{U₀} U'` is again an étale chart of
`Y`, lies over `U'`, and carries any pair of compatible points. -/
theorem exists_chart_pullback (f : Y ⟶ X)
    (T : SmallEtale B S hS Y.1) {U₀ U' : SmallEtale B S hS X.1}
    (p : T.1.left ⟶ U₀.1.left) (hp : yoneda.map p ≫ U₀.1.hom = T.1.hom ≫ f.hom)
    (m : U' ⟶ U₀)
    (w : (BigFppfOver.toScheme B S hS).obj T.1.left)
    (y : (BigFppfOver.toScheme B S hS).obj U'.1.left)
    (hwy : ((BigFppfOver.toScheme B S hS).map p) w =
      ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map m)) y) :
    ∃ (T' : SmallEtale B S hS Y.1) (π : T' ⟶ T) (p' : T'.1.left ⟶ U'.1.left),
      yoneda.map p' ≫ U'.1.hom = T'.1.hom ≫ f.hom ∧
      p' ≫ (SmallEtale.toOver B S hS X.1).map m =
        (SmallEtale.toOver B S hS Y.1).map π ≫ p ∧
      ∃ w' : (BigFppfOver.toScheme B S hS).obj T'.1.left,
        ((BigFppfOver.toScheme B S hS).map
            ((SmallEtale.toOver B S hS Y.1).map π)) w' = w ∧
          ((BigFppfOver.toScheme B S hS).map p') w' = y := by
  set m' := (SmallEtale.toOver B S hS X.1).map m with hm'
  have hsq : CategoryTheory.IsPullback (Limits.pullback.fst p m') (Limits.pullback.snd p m')
      p m' := CategoryTheory.IsPullback.of_hasPullback p m'
  have hsch := (BigFppfOver.toScheme B S hS).map_isPullback hsq
  have hetm : Etale ((BigFppfOver.toScheme B S hS).map m') :=
    etale_toScheme_toOver_map B S hS X.1 m
  have hetfst : Etale ((BigFppfOver.toScheme B S hS).map (Limits.pullback.fst p m')) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback hsch.flip hetm
  have hcond : Limits.pullback.fst p m' ≫ p = Limits.pullback.snd p m' ≫ m' :=
    Limits.pullback.condition
  have hmw : yoneda.map m' ≫ U₀.1.hom = U'.1.hom := CategoryTheory.CostructuredArrow.w _
  refine ⟨⟨CostructuredArrow.mk (yoneda.map (Limits.pullback.fst p m') ≫ T.1.hom),
      etale_comp_of_scheme B S hS _ T.1.hom hetfst T.property⟩,
    ObjectProperty.homMk (CostructuredArrow.homMk (Limits.pullback.fst p m') rfl),
    Limits.pullback.snd p m', ?_, hcond.symm, ?_⟩
  · rw [← hmw, ← Category.assoc, ← Functor.map_comp, ← hcond, Functor.map_comp,
      Category.assoc, hp]
    rfl
  · obtain ⟨z, hz1, hz2⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
      (f := (BigFppfOver.toScheme B S hS).map p)
      (g := (BigFppfOver.toScheme B S hS).map m') w y hwy
    refine ⟨hsch.isoPullback.inv z, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply]
      rw [show (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS Y.1).map
        (ObjectProperty.homMk (CostructuredArrow.homMk (Limits.pullback.fst p m') rfl) :
          (⟨CostructuredArrow.mk (yoneda.map (Limits.pullback.fst p m') ≫ T.1.hom),
            etale_comp_of_scheme B S hS _ T.1.hom hetfst T.property⟩ :
            SmallEtale B S hS Y.1) ⟶ T)) =
          (BigFppfOver.toScheme B S hS).map (Limits.pullback.fst p m') from rfl,
        hsch.isoPullback_inv_fst, hz1]
    · rw [← Scheme.Hom.comp_apply, hsch.isoPullback_inv_snd, hz2]

/-- **Base change of a chart of `X` to a chart of `Y`.** For a chart `U₀` of `X` and a chart
`V` of `Y`, the fibre product `V ×_X U₀` is a chart of `Y` lying over `U₀`; when `U₀` is a
surjective chart of `X` the projection to `V` is surjective, so every point of `V` lifts. -/
theorem exists_chart_over (f : Y ⟶ X) (V : SmallEtale B S hS Y.1)
    (U₀ : SmallEtale B S hS X.1)
    (hU₀S : (MorphismProperty.inverseImage (@Surjective)
      (BigFppfOver.toScheme B S hS)).presheaf U₀.1.hom)
    (z : (BigFppfOver.toScheme B S hS).obj V.1.left) :
    ∃ (V₁ : SmallEtale B S hS Y.1) (π : V₁ ⟶ V) (q : V₁.1.left ⟶ U₀.1.left),
      yoneda.map q ≫ U₀.1.hom = V₁.1.hom ≫ f.hom ∧
      ∃ z₁ : (BigFppfOver.toScheme B S hS).obj V₁.1.left,
        ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS Y.1).map π)) z₁ = z := by
  have hetsn : Etale ((BigFppfOver.toScheme B S hS).map
      (U₀.2.rep.snd (V.1.hom ≫ f.hom))) := U₀.2.property_snd (V.1.hom ≫ f.hom)
  have hsurjsn : Surjective ((BigFppfOver.toScheme B S hS).map
      (U₀.2.rep.snd (V.1.hom ≫ f.hom))) := hU₀S.property_snd (V.1.hom ≫ f.hom)
  obtain ⟨z₁, hz₁⟩ := hsurjsn.surj z
  refine ⟨⟨CostructuredArrow.mk (yoneda.map (U₀.2.rep.snd (V.1.hom ≫ f.hom)) ≫ V.1.hom),
      etale_comp_of_scheme B S hS _ V.1.hom hetsn V.property⟩,
    ObjectProperty.homMk (CostructuredArrow.homMk
      (U₀.2.rep.snd (V.1.hom ≫ f.hom)) rfl),
    U₀.2.rep.fst' (V.1.hom ≫ f.hom), ?_, z₁, hz₁⟩
  rw [U₀.2.rep.map_fst' (V.1.hom ≫ f.hom), U₀.2.rep.w (V.1.hom ≫ f.hom), ← Category.assoc]
  rfl

/-! ### Local generation of the defining ideal by one section -/

/-- **Generation of the defining ideal by one section, pointwise.** On every étale chart over
`U`, every section of the defining ideal of `Z` becomes a multiple of the restriction of `a`
on some further chart, through which a prescribed point of the first chart lifts. -/
private def PointwiseGeneratedBy (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1)
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤)) : Prop :=
  ∀ (V : SmallEtale B S hS X.1) (m : V ⟶ U)
      (k : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤)),
      k ∈ definingIdealAt B S hS X Z (op V) →
      ∀ y : (BigFppfOver.toScheme B S hS).obj V.1.left,
        ∃ (W : SmallEtale B S hS X.1) (g : W ⟶ V)
          (y' : (BigFppfOver.toScheme B S hS).obj W.1.left),
          ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map g)) y' = y ∧
          etaleChartRestrict B S hS g k ∈ Ideal.span {etaleChartRestrict B S hS (g ≫ m) a}

/-- A finite family of sections of the defining ideal becomes a family of multiples of `a` on
a single chart, through which a prescribed point lifts. -/
private theorem exists_chart_forall_mem_span (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1)
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (hgen : PointwiseGeneratedBy B S hS Z U a) (n : ℕ) :
    ∀ (V : SmallEtale B S hS X.1) (m : V ⟶ U)
      (k : Fin n → Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤)),
      (∀ l, k l ∈ definingIdealAt B S hS X Z (op V)) →
      ∀ y : (BigFppfOver.toScheme B S hS).obj V.1.left,
        ∃ (W : SmallEtale B S hS X.1) (g : W ⟶ V)
          (y' : (BigFppfOver.toScheme B S hS).obj W.1.left),
          ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map g)) y' = y ∧
          ∀ l, etaleChartRestrict B S hS g (k l) ∈
            Ideal.span {etaleChartRestrict B S hS (g ≫ m) a} := by
  induction n with
  | zero =>
      intro V m k _ y
      refine ⟨V, 𝟙 V, y, ?_, fun l => l.elim0⟩
      simp
  | succ n ih =>
      intro V m k hk y
      obtain ⟨W₁, g₁, y₁, hy₁, h₁⟩ := hgen V m (k 0) (hk 0) y
      obtain ⟨W₂, g₂, y₂, hy₂, h₂⟩ := ih W₁ (g₁ ≫ m)
        (fun l => etaleChartRestrict B S hS g₁ (k l.succ))
        (fun l => definingIdealAt_map B S hS X Z g₁.op _ (hk l.succ)) y₁
      refine ⟨W₂, g₂ ≫ g₁, y₂, ?_, ?_⟩
      · rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hy₂, hy₁]
      · refine Fin.cases ?_ ?_
        · have hmem := map_mem_span_singleton
            (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
              ((SmallEtale.toOver B S hS X.1).map g₂)).op).hom h₁
          rw [Category.assoc, ← etaleChartRestrict_comp B S hS (g₁ ≫ m) g₂ a,
            ← etaleChartRestrict_comp B S hS g₁ g₂ (k 0)]
          exact hmem
        · intro j
          rw [Category.assoc, ← etaleChartRestrict_comp B S hS g₁ g₂ (k j.succ)]
          exact h₂ j

/-- **A single generating section generates pointwise.** A one-element family of sections of
the defining ideal which generates it locally on the charts over `U` generates it in the
pointwise sense, because a covering sieve is jointly surjective on the scheme points. -/
private theorem pointwiseGeneratedBy_of_generatesLocally (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1) {I : Type u} [Fintype I] [Unique I]
    (s : I → ToType (((definingIdealSheaf B S hS X Z).toSheafOfModules).val.obj (op U)))
    (hGL : Stacks.SheafOfModules.GeneratesLocally (SmallEtale.topology B S hS X.1)
      ((definingIdealSheaf B S hS X Z).toSheafOfModules).val s) :
    PointwiseGeneratedBy B S hS Z U (s default).val := by
  intro V m k hk y
  obtain ⟨R, hR, hmem⟩ := hGL V m ⟨k, hk⟩
  obtain ⟨W, g, hg, y', hy'⟩ := exists_mem_sieve_scheme_point B S hS X.1 V hR y
  obtain ⟨c, hc⟩ := hmem W g hg
  rw [Fintype.sum_unique] at hc
  exact ⟨W, g, y', hy', Ideal.mem_span_singleton'.mpr
    ⟨c default, congrArg Subtype.val hc⟩⟩

/-- **Generating sections give the pointwise form of generation.** A family of generating
sections of the defining ideal on a chart, indexed by a singleton, is a single section of the
defining ideal generating it pointwise. -/
private theorem exists_pointwiseGeneratedBy (Z : ClosedSubspaces B S hS X.1)
    (U : SmallEtale B S hS X.1)
    (σ : (((definingIdealSheaf B S hS X Z).toSheafOfModules).over U).GeneratingSections)
    (e : σ.I ≃ Fin 1) :
    ∃ a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤),
      a ∈ definingIdealAt B S hS X Z (op U) ∧ PointwiseGeneratedBy B S hS Z U a := by
  let _ : Unique σ.I := Equiv.unique e
  let _ : Fintype σ.I := Fintype.ofEquiv _ e.symm
  refine ⟨_, ?_, pointwiseGeneratedBy_of_generatesLocally B S hS Z U _
    (Stacks.SheafOfModules.generatesLocally_of_epi U σ.π)⟩
  exact Subtype.property _

/-! ### The zero locus of the defining ideal on a chart -/

/-- The preimage of a basic open of global regular functions along a morphism of schemes is the
basic open of the pullback of that function. -/
private theorem preimage_basicOpen_appTop {T T' : Scheme.{u}} (φ : T' ⟶ T) (k : Γ(T, ⊤)) :
    φ ⁻¹ᵁ T.basicOpen k = T'.basicOpen (φ.appTop.hom k) := by
  rw [Scheme.preimage_basicOpen]
  rfl

/-- A regular function whose pullback along `φ` is a multiple of the pullback of `a` is
invertible at a point of the image of `φ` only where `a` is: the basic open of a product is
contained in the basic open of each factor. -/
private theorem mem_basicOpen_of_appTop_eq_mul {T T' : Scheme.{u}} (φ : T' ⟶ T)
    {k a : Γ(T, ⊤)} {c : Γ(T', ⊤)} (hc : φ.appTop.hom k = c * φ.appTop.hom a)
    {x' : T'} {x : T} (hx' : φ x' = x) (hxk : x ∈ T.basicOpen k) :
    x ∈ T.basicOpen a := by
  have h0 : φ x' ∈ T.basicOpen k := hx' ▸ hxk
  have h1 : x' ∈ φ ⁻¹ᵁ T.basicOpen k := h0
  rw [preimage_basicOpen_appTop, hc, Scheme.basicOpen_mul] at h1
  have h2 : x' ∈ φ ⁻¹ᵁ T.basicOpen a := by
    rw [preimage_basicOpen_appTop]
    exact h1.2
  exact hx' ▸ (h2 : φ x' ∈ T.basicOpen a)

/-- **The defining ideal and its generator cut out the same closed set.** On a chart `U` on
which the defining ideal of `Z` is generated by `a` in the pointwise sense, the zero locus of
the defining ideal is the zero locus of `a` alone.

One inclusion is `a` lying in the defining ideal.  For the other, a section `k` of the
defining ideal becomes a multiple of the pullback of `a` on a chart through which a prescribed
point lifts, so `k` is not invertible at that point unless `a` is.  Only the zero loci agree:
the two ideals need not, since generation holds after an étale covering. -/
private theorem zeroLocus_definingIdealAt_eq_zeroLocus_singleton
    (Z : ClosedSubspaces B S hS X.1) (U : SmallEtale B S hS X.1)
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (ha : a ∈ definingIdealAt B S hS X Z (op U))
    (hgen : PointwiseGeneratedBy B S hS Z U a) :
    ((BigFppfOver.toScheme B S hS).obj U.1.left).zeroLocus
        {k : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤) |
          k ∈ definingIdealAt B S hS X Z (op U)} =
      ((BigFppfOver.toScheme B S hS).obj U.1.left).zeroLocus {a} := by
  refine Set.Subset.antisymm
    (Scheme.zeroLocus_mono _ (Set.singleton_subset_iff.mpr ha)) fun x hx => ?_
  rw [Scheme.mem_zeroLocus_iff] at hx ⊢
  intro k hk hxk
  obtain ⟨W, g, x', hx', hspan⟩ := hgen U (𝟙 U) k hk x
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hspan
  rw [Category.comp_id] at hc
  obtain ⟨c', he⟩ : ∃ c' : Γ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS X.1).obj W), ⊤),
      ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map g)).appTop.hom k =
        c' * ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map g)).appTop.hom a := ⟨c, hc.symm⟩
  exact hx a rfl (mem_basicOpen_of_appTop_eq_mul _ he hx' hxk)

/-- **An affine chart over a chart of `X` on which the defining ideal is pointwise generated.**
For a locally principal `Z`, every point of a chart `U` lifts to an affine chart `W` over `U`
carrying a section `a` of the defining ideal which generates it pointwise. -/
private theorem exists_affine_chart_pointwiseGeneratedBy
    {X : AlgebraicSpaces B S hS} (Z : ClosedSubspaces B S hS X.1)
    (hZ : IsLocallyPrincipal B S hS X Z) (U : SmallEtale B S hS X.1)
    (x : (BigFppfOver.toScheme B S hS).obj U.1.left) :
    ∃ (W : SmallEtale B S hS X.1) (g : W ⟶ U),
      IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) ∧
      (∃ x' : (BigFppfOver.toScheme B S hS).obj W.1.left,
        ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map g)) x' = x) ∧
      ∃ a : Γ((BigFppfOver.toScheme B S hS).obj W.1.left, ⊤),
        a ∈ definingIdealAt B S hS X Z (op W) ∧ PointwiseGeneratedBy B S hS Z W a := by
  obtain ⟨SU, hSU⟩ := hZ U
  obtain ⟨U', m, hm, y', hy'⟩ := exists_mem_sieve_scheme_point B S hS X.1 U SU.2 x
  obtain ⟨σ, ⟨e⟩⟩ := hSU U' m hm
  obtain ⟨U'', ι', hU''aff, y'', hy''⟩ := exists_affine_chart_at B S hS X.1 U' y'
  obtain ⟨a, ha, hgen⟩ := exists_pointwiseGeneratedBy B S hS Z U''
    (Stacks.SheafOfModules.generatingSectionsOverMap _ ι' σ) e
  refine ⟨U'', ι' ≫ m, hU''aff, ⟨y'', ?_⟩, a, ha, hgen⟩
  rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hy'', hy']

/-- **An affine chart on which a single section cuts out the defining ideal.** Let `Z` be a
locally principal closed subspace of an algebraic space `X` over `S`.  Every point of an étale
scheme chart `U` of `X` lifts to an affine étale chart `W` over `U` on which the zero locus of
the defining ideal of `Z` is the zero locus of one global regular function.

Local principality produces the generator only after a covering of `U` and only on a chart
which need not be affine, so the generator is transported to an affine open of a member of
that covering by `AlgebraicGeometry.Space.exists_affine_chart_at`; the point is carried along
because a covering sieve of the small étale site is jointly surjective on scheme points. -/
theorem exists_affine_chart_zeroLocus_definingIdealAt_eq
    (X : AlgebraicSpaces B S hS) (Z : ClosedSubspaces B S hS X.1)
    (hZ : IsLocallyPrincipal B S hS X Z) (U : SmallEtale B S hS X.1)
    (x : (BigFppfOver.toScheme B S hS).obj U.1.left) :
    ∃ (W : SmallEtale B S hS X.1) (g : W ⟶ U),
      IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) ∧
      (∃ x' : (BigFppfOver.toScheme B S hS).obj W.1.left,
        ((BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map g)) x' = x) ∧
      ∃ a : Γ((BigFppfOver.toScheme B S hS).obj W.1.left, ⊤),
        ((BigFppfOver.toScheme B S hS).obj W.1.left).zeroLocus
            {k : Γ((BigFppfOver.toScheme B S hS).obj W.1.left, ⊤) |
              k ∈ definingIdealAt B S hS X Z (op W)} =
          ((BigFppfOver.toScheme B S hS).obj W.1.left).zeroLocus {a} := by
  obtain ⟨W, g, hW, hx, a, ha, hgen⟩ :=
    exists_affine_chart_pointwiseGeneratedBy B S hS Z hZ U x
  exact ⟨W, g, hW, hx, a,
    zeroLocus_definingIdealAt_eq_zeroLocus_singleton B S hS Z W a ha hgen⟩

/-! ### Generation of the inverse-image ideal on a chart -/

/-- **The combination, read on a chart over which the generator divides every summand.** Let
`V ⟶ T` be a morphism of charts of `Y₁`, let `p` carry `T` to a chart `U` of `X₁`, and write
`q` for the composite `T₀ ⟶ V ⟶ T ⟶ U`.  Suppose the pullback to a chart `T₀` of a section `t`
of the defining ideal sheaf is the combination `∑ l, cc l · q^♯(k l)`, and that on a chart `W'`
of `X₁` over `U` each `k l` becomes `d l` times `a`.  Then on a chart `T'` of `Y₁` lying over
both — a morphism `π : T' ⟶ T₀` and a morphism `p' : T' ⟶ W'` compatible with `q` — the
pullback of `t` is the combination of the pullbacks of the `cc l` and the `d l` times the
pullback of `a`.

This is the algebra of the inverse image on charts, separated from the chart constructions of
`AlgebraicGeometry.Space.exists_chart_mul_eq`. -/
private theorem sum_mul_pullback_eq (X₁ Y₁ : AlgebraicSpaces B S hS)
    (W : ClosedSubspaces B S hS Y₁.1)
    {T V T₀ T' : SmallEtale B S hS Y₁.1} {U W' : SmallEtale B S hS X₁.1}
    (h : V ⟶ T) (ι : T₀ ⟶ V) (π : T' ⟶ T₀) (g' : W' ⟶ U)
    (p : T.1.left ⟶ U.1.left) (p' : T'.1.left ⟶ W'.1.left)
    (q : T₀.1.left ⟶ U.1.left)
    (hq : q = (SmallEtale.toOver B S hS Y₁.1).map (ι ≫ h) ≫ p)
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (t : idealSections B S hS Y₁ W V) {n : ℕ}
    (cc : Fin n → Γ((BigFppfOver.toScheme B S hS).obj T₀.1.left, ⊤))
    (k : Fin n → Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (d : Fin n → Γ((BigFppfOver.toScheme B S hS).obj W'.1.left, ⊤))
    (hsum : ∑ l, cc l * siteRestrict B S hS q (k l) =
      etaleChartRestrict B S hS ι (sectionFun B S hS Y₁ W t))
    (hcompat : p' ≫ (SmallEtale.toOver B S hS X₁.1).map g' =
      (SmallEtale.toOver B S hS Y₁.1).map π ≫ q)
    (hd : ∀ l, d l * etaleChartRestrict B S hS g' a = etaleChartRestrict B S hS g' (k l)) :
    (∑ l, etaleChartRestrict B S hS π (cc l) * siteRestrict B S hS p' (d l)) *
        etaleChartRestrict B S hS ((π ≫ ι) ≫ h) (siteRestrict B S hS p a) =
      etaleChartRestrict B S hS (π ≫ ι) (sectionFun B S hS Y₁ W t) := by
  have hmor1 : (SmallEtale.toOver B S hS Y₁.1).map ((π ≫ ι) ≫ h) ≫ p =
      (SmallEtale.toOver B S hS Y₁.1).map π ≫ q := by
    rw [hq, ← Category.assoc ((SmallEtale.toOver B S hS Y₁.1).map π), ← Functor.map_comp,
      Category.assoc π ι h]
  have e1 : etaleChartRestrict B S hS ((π ≫ ι) ≫ h) (siteRestrict B S hS p a) =
      etaleChartRestrict B S hS π (siteRestrict B S hS q a) := by
    rw [etaleChartRestrict_siteRestrict_comp, etaleChartRestrict_siteRestrict_comp, hmor1]
  have e2 : ∀ l, etaleChartRestrict B S hS π (siteRestrict B S hS q (k l)) =
      siteRestrict B S hS p' (d l) * etaleChartRestrict B S hS π (siteRestrict B S hS q a) := by
    intro l
    rw [etaleChartRestrict_siteRestrict_comp B S hS π q (k l),
      etaleChartRestrict_siteRestrict_comp B S hS π q a, ← hcompat,
      ← siteRestrict_comp, ← siteRestrict_comp]
    exact (map_mul_eq_of_mul_eq (siteRestrict B S hS p') (hd l)).symm
  rw [e1, ← etaleChartRestrict_comp B S hS ι π (sectionFun B S hS Y₁ W t), ← hsum]
  exact sum_mul_eq_map_sum (etaleChartRestrict B S hS π) cc (fun l => siteRestrict B S hS q (k l))
    (fun l => siteRestrict B S hS p' (d l)) _ e2

/-- A morphism of charts of `Y` precomposed with a morphism `p` of the site lying over `f`
again lies over `f`. -/
private theorem yoneda_map_comp_hom_eq (f : Y ⟶ X) {T T' : SmallEtale B S hS Y.1}
    {U : SmallEtale B S hS X.1} (g : T' ⟶ T) (p : T.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = T.1.hom ≫ f.hom) :
    yoneda.map ((SmallEtale.toOver B S hS Y.1).map g ≫ p) ≫ U.1.hom = T'.1.hom ≫ f.hom := by
  rw [Functor.map_comp, Category.assoc, hp, ← Category.assoc]
  exact congrArg (fun φ => φ ≫ f.hom) (CostructuredArrow.w g.hom)

/-- **Every point of a chart of `Y` has a chart over it on which a given section of the
inverse-image ideal is a multiple of the pullback of `a`.** -/
private theorem exists_chart_mul_eq
    (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1) (W : ClosedSubspaces B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (hformula : ∀ (T₀ : SmallEtale B S hS Y.1) (q : T₀.1.left ⟶ U.1.left),
      yoneda.map q ≫ U.1.hom = T₀.1.hom ≫ f.hom →
      IsAffine ((BigFppfOver.toScheme B S hS).obj T₀.1.left) →
      definingIdealAt B S hS Y W (op T₀) =
        Ideal.map (siteRestrict B S hS q) (definingIdealAt B S hS X Z (op U)))
    (T : SmallEtale B S hS Y.1) (p : T.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = T.1.hom ≫ f.hom)
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (hgen : PointwiseGeneratedBy B S hS Z U a)
    (V : SmallEtale B S hS Y.1) (h : V ⟶ T)
    (t : idealSections B S hS Y W V)
    (z : (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS Y.1).obj V)) :
    ∃ (T' : SmallEtale B S hS Y.1) (g : T' ⟶ V)
      (c : Γ((BigFppfOver.toScheme B S hS).obj T'.1.left, ⊤)),
      c * etaleChartRestrict B S hS (g ≫ h) (siteRestrict B S hS p a) =
        etaleChartRestrict B S hS g (sectionFun B S hS Y W t) ∧
      ∃ w' : (BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS Y.1).obj T'),
        ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS Y.1).map g)) w' = z := by
  obtain ⟨T₀, ι, hT₀aff, z₀, hz₀⟩ := exists_affine_chart_at B S hS Y.1 V z
  obtain ⟨q, hq⟩ : ∃ q : T₀.1.left ⟶ U.1.left,
      q = (SmallEtale.toOver B S hS Y.1).map (ι ≫ h) ≫ p := ⟨_, rfl⟩
  have hp₀ : yoneda.map q ≫ U.1.hom = T₀.1.hom ≫ f.hom := by
    rw [hq]
    exact yoneda_map_comp_hom_eq B S hS f (ι ≫ h) p hp
  have ht₀ : etaleChartRestrict B S hS ι (sectionFun B S hS Y W t) ∈
      definingIdealAt B S hS Y W (op T₀) :=
    etaleChartRestrict_mem_definingIdealAt B S hS Y W ι _ (sectionFun_mem B S hS Y W t)
  rw [hformula T₀ q hp₀ hT₀aff] at ht₀
  obtain ⟨n, cc, k, hkI, hsum⟩ := exists_sum_of_mem_ideal_map
    (R₀ := Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (R₁ := Γ((BigFppfOver.toScheme B S hS).obj T₀.1.left, ⊤))
    (siteRestrict B S hS q) (definingIdealAt B S hS X Z (op U)) ht₀
  obtain ⟨W', g', y', hy', hspan⟩ := exists_chart_forall_mem_span B S hS Z U a hgen n
    U (𝟙 U) k hkI (((BigFppfOver.toScheme B S hS).map q) z₀)
  choose d hd using fun l => Ideal.mem_span_singleton'.mp (hspan l)
  simp only [Category.comp_id] at hd
  obtain ⟨T', π, p', hp'X, hcompat, w', hw', -⟩ :=
    exists_chart_pullback B S hS f T₀ q hp₀ g' z₀ y' hy'.symm
  refine ⟨T', π ≫ ι, ∑ l, etaleChartRestrict B S hS π (cc l) *
    siteRestrict B S hS p' (d l),
    sum_mul_pullback_eq B S hS X Y W h ι π g' p p' q hq a t cc k d hsum hcompat hd, w', ?_⟩
  rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hw', hz₀]

/-- **A closed subspace whose defining ideal on the affine charts over `U` is the extension of
the defining ideal of `Z` on `U` is generated by one section on a chart over `U`.** The
hypothesis `hformula` is the chart computation
`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`; this lemma is the sheaf-theoretic
half, and holds for any closed subspace satisfying that formula. -/
private theorem generatesLocally_of_definingIdealAt_eq_map
    (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1) (W : ClosedSubspaces B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (hformula : ∀ (T₀ : SmallEtale B S hS Y.1) (q : T₀.1.left ⟶ U.1.left),
      yoneda.map q ≫ U.1.hom = T₀.1.hom ≫ f.hom →
      IsAffine ((BigFppfOver.toScheme B S hS).obj T₀.1.left) →
      definingIdealAt B S hS Y W (op T₀) =
        Ideal.map (siteRestrict B S hS q) (definingIdealAt B S hS X Z (op U)))
    (T : SmallEtale B S hS Y.1) (p : T.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = T.1.hom ≫ f.hom)
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (haT : siteRestrict B S hS p a ∈ definingIdealAt B S hS Y W (op T))
    (hgen : PointwiseGeneratedBy B S hS Z U a) :
    Stacks.SheafOfModules.GeneratesLocally (SmallEtale.topology B S hS Y.1)
      ((definingIdealSheaf B S hS Y W).toSheafOfModules).val
      (fun _ : Fin 1 => sectionOfMem B S hS Y W (siteRestrict B S hS p a) haT) := by
  intro V h t
  refine ⟨multipleSieve B S hS Y W h (siteRestrict B S hS p a) t, ?_, ?_⟩
  · refine smallEtale_sieve_of_pointwise_covering B S hS Y.1 V _ ?_
    intro z
    obtain ⟨T', g, c, hc, w', hw'⟩ :=
      exists_chart_mul_eq B S hS f Z W U hformula T p hp a hgen V h t z
    exact ⟨T', g, (multipleSieve_arrows B S hS Y W h _ t g).2 ⟨c, hc⟩, w', hw'⟩
  · intro T₂ g hg
    obtain ⟨c, hc⟩ := (multipleSieve_arrows B S hS Y W h _ t g).1 hg
    refine ⟨fun _ => structureSection B S hS Y c, sectionFun_injective B S hS Y W ?_⟩
    rw [Fintype.sum_unique, sectionFun_smul, sectionFun_restrict, sectionFun_restrict,
      sectionFun_sectionOfMem]
    exact hc

/-- **The inverse-image ideal is generated by one section on a good chart.** Let `U` be an
affine étale chart of `X` on which the defining ideal of `Z` is generated by a single section
`a`, and let `T` be an affine étale chart of `Y` with a morphism `p : T ⟶ U` of the site lying
over `f`.  Then the defining ideal of a closed subspace `W` of `Y` satisfying the chart
formula is generated on `T` by the pullback of `a`. -/
private theorem exists_generatingSections_of_formula (f : Y ⟶ X)
    (Z : ClosedSubspaces B S hS X.1) (W : ClosedSubspaces B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (hformula : ∀ (T₀ : SmallEtale B S hS Y.1) (q : T₀.1.left ⟶ U.1.left),
      yoneda.map q ≫ U.1.hom = T₀.1.hom ≫ f.hom →
      IsAffine ((BigFppfOver.toScheme B S hS).obj T₀.1.left) →
      definingIdealAt B S hS Y W (op T₀) =
        Ideal.map (siteRestrict B S hS q) (definingIdealAt B S hS X Z (op U)))
    (T : SmallEtale B S hS Y.1) (p : T.1.left ⟶ U.1.left)
    (hp : yoneda.map p ≫ U.1.hom = T.1.hom ≫ f.hom)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T.1.left)]
    (a : Γ((BigFppfOver.toScheme B S hS).obj U.1.left, ⊤))
    (ha : a ∈ definingIdealAt B S hS X Z (op U))
    (hgen : PointwiseGeneratedBy B S hS Z U a) :
    ∃ σ : ((definingIdealSheaf B S hS Y W).toSheafOfModules.over T).GeneratingSections,
      Nonempty (σ.I ≃ Fin 1) := by
  have haT := (hformula T p hp inferInstance).ge (Ideal.mem_map_of_mem _ ha)
  refine ⟨Stacks.SheafOfModules.generatorsOfGeneratesLocally
    ((definingIdealSheaf B S hS Y W).toSheafOfModules)
    (fun _ : Fin 1 => sectionOfMem B S hS Y W (siteRestrict B S hS p a) haT)
    (generatesLocally_of_definingIdealAt_eq_map B S hS f Z W U hformula T p hp a haT hgen),
    ?_⟩
  exact ⟨Equiv.ulift⟩

/-- **Stacks 083X.** The inverse image of a locally principal closed subspace along a morphism
of algebraic spaces is a locally principal closed subspace of the source.

The defining ideal of `f⁻¹(Z)` on an affine chart `T` of `Y` lying over an affine chart `U` of
`X` is the ideal generated by the image of the defining ideal of `Z` on `U`
(`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`), because the closed subscheme
`Z ×_X T` of `T` is the base change of the closed subscheme `Z ×_X U` of `U`.  Local principality
is then inherited chart by chart: every point of a chart of `Y` has such a pair `(T, U)` above
it with the defining ideal of `Z` on `U` generated by a single section, and the pullback of that
section generates the defining ideal of `f⁻¹(Z)` on `T`. -/
@[stacks 083X]
theorem isLocallyPrincipal_preimage (f : Y ⟶ X) (Z : ClosedSubspaces B S hS X.1)
    (hZ : IsLocallyPrincipal B S hS X Z) :
    IsLocallyPrincipal B S hS Y ⟨Z.1.preimage f.hom,
      isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩ := by
  set W : ClosedSubspaces B S hS Y.1 := ⟨Z.1.preimage f.hom,
    isClosedSubspace_preimage B S hS f.hom Z.1 X.2 Y.2 Z.2⟩
  have hformula : ∀ (U : SmallEtale B S hS X.1)
      (_ : IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left))
      (T₀ : SmallEtale B S hS Y.1) (q : T₀.1.left ⟶ U.1.left),
      yoneda.map q ≫ U.1.hom = T₀.1.hom ≫ f.hom →
      IsAffine ((BigFppfOver.toScheme B S hS).obj T₀.1.left) →
      definingIdealAt B S hS Y W (op T₀) =
        Ideal.map (siteRestrict B S hS q) (definingIdealAt B S hS X Z (op U)) := by
    intro U hU T₀ q hq hT₀
    have := hU
    have := hT₀
    exact definingIdealAt_preimage_eq_map B S hS f Z U T₀ q hq
  intro V
  refine ⟨⟨⟨fun T _ => ∃ σ : ((definingIdealSheaf B S hS Y W).toSheafOfModules.over
      T).GeneratingSections, Nonempty (σ.I ≃ Fin 1), ?_⟩, ?_⟩, fun T g hg => hg⟩
  · rintro T T' g ⟨σ, ⟨e⟩⟩ k
    exact ⟨Stacks.SheafOfModules.generatingSectionsOverMap _ k σ, ⟨e⟩⟩
  · refine smallEtale_sieve_of_pointwise_covering B S hS Y.1 V _ ?_
    intro z
    obtain ⟨A₀, g₀, hg₀S, hg₀E⟩ := X.2.exists_atlas
    obtain ⟨V₁, π₁, q₁, hq₁, z₁, hz₁⟩ :=
      exists_chart_over B S hS f V ⟨CostructuredArrow.mk g₀, hg₀E⟩ hg₀S z
    obtain ⟨U'', ι, hU''aff, ⟨y'', hy''⟩, a, ha, hgen⟩ :=
      exists_affine_chart_pointwiseGeneratedBy B S hS Z hZ ⟨CostructuredArrow.mk g₀, hg₀E⟩
        (((BigFppfOver.toScheme B S hS).map q₁) z₁)
    obtain ⟨T₂, π₂, p₂, hp₂, hcompat₂, w₂, hw₂, -⟩ :=
      exists_chart_pullback B S hS f V₁ q₁ hq₁ ι z₁ y'' hy''.symm
    obtain ⟨T₃, π₃, hT₃aff, w₃, hw₃⟩ := exists_affine_chart_at B S hS Y.1 T₂ w₂
    have := hT₃aff
    have hp₃ := yoneda_map_comp_hom_eq B S hS f π₃ p₂ hp₂
    refine ⟨T₃, π₃ ≫ π₂ ≫ π₁, ?_, w₃, ?_⟩
    · exact exists_generatingSections_of_formula B S hS f Z W U''
        (hformula U'' hU''aff) T₃ _ hp₃ a ha hgen
    · rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply,
        Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hw₃, hw₂, hz₁]

end AlgebraicGeometry.Space

