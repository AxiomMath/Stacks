/-!
# Extending a finite type submodule across the étale member of an elementary distinguished square

Let `(U ⊂ W, f : V ⟶ W)` be an elementary distinguished square [Stacks, Tag 08GM] with `W`
quasi-separated, `U` quasi-compact and `V` with a terminal affine chart `T_V` (for instance `V`
affine). Let `M` be a quasi-coherent `𝒪_W`-module and `N₀ ⊆ M|_U` a quasi-coherent submodule of
finite type. Write `G ⊆ M|_V` for the étale pullback to `V` of the étale pushforward of `N₀`:
its sections over a chart of `V` are those whose restriction to every chart of `U` mapping to it
lies in `N₀`. Over the charts of `V` lying over `U` it is `N₀`.

This file proves that `G` is quasi-coherent and that, given finitely many sections `a` of `G`
over `T_V`, there is a quasi-coherent submodule `N ⊆ G` of finite type containing the `a` which
agrees with `G`, hence with `N₀`, over `U`. This is the step on `V` of the induction
[Stacks, Tag 08GP] proving the module form of [Stacks, Tag 0829]; with
`AlgebraicGeometry.Space.etaleSubmoduleGlue` it glues to a submodule on `W`.

The proof is the argument of [Stacks, Tag 07TU] run on `V`. The part `V₀ = U ×_W V` of the
terminal chart is quasi-compact, so it is covered by finitely many affine charts `O j`, and
`N₀(O j)` is generated by finitely many sections. For each `j` the submodule
`AlgebraicGeometry.Space.chartSpanSubmodule` of the sections which locally lie in the span of
the restrictions of those generators along every morphism to `O j` is quasi-coherent
(`AlgebraicGeometry.Space.isCartesianOnAffineCharts_chartSpanSubmodule`), and `G` is the meet of
these finitely many submodules. Being quasi-coherent, `G` is cartesian on affine charts, so the
generators over `O j` are combinations of restrictions of finitely many sections of `G` over
`T_V`; the submodule `N` generated by those and by the `a` is the one sought.

## Main results

* `mem_etaleSubmoduleRestrict_etaleSubmodulePushforward_iff_of_factor`: over a chart of `V`
  lying over `U`, `G` is `N₀`.
* `exists_isFiniteType_le_etaleSubmoduleRestrict_etaleSubmodulePushforward`: the submodule `N`.

## References

* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 07TU](https://stacks.math.columbia.edu/tag/07TU)
* [Stacks Project, Tag 08GP](https://stacks.math.columbia.edu/tag/08GP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.SheafOfModules.ImageSubsheaf

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

set_option synthInstance.maxHeartbeats 400000 in
/-- Pullbacks of presheaves on the big fppf site (instance search times out without this
shortcut). -/
local instance hasPullbacks_presheaf_FiniteTypeSubmoduleSquareExtension :
    HasPullbacks ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) := inferInstance

local instance (priority := high) hasPullback_presheaf_FiniteTypeSubmoduleSquareExtension
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

/-! ### Sections of a submodule over a smaller affine chart -/

section Cartesian

variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-- **The sections of a submodule cartesian on affine charts over a smaller affine chart are
spanned by the restrictions of its sections over a larger one.** -/
theorem obj_le_span_chartRes_of_isCartesianOnAffineCharts (G : Modules.{u, u} B S hS F hF)
    (K : G.Submodule) (hK : IsCartesianOnAffineCharts K.toSheafOfModules)
    {Y Z : SmallEtale B S hS F} (hZ : IsAffine (chartScheme Z)) (hY : IsAffine (chartScheme Y))
    (φ : Y ⟶ Z) :
    K.obj (op Y) ≤ Submodule.span (chartRing B S hS F hF Y)
      ((fun x => chartRes G φ x) '' (K.obj (op Z) : Set (G.val.obj (op Z)))) := by
  let := chartAlgebra (hF := hF) φ
  intro g hg
  obtain ⟨u, hu0⟩ := (hK Z Y hZ hY φ).2 ⟨g, hg⟩
  have hgu : g = (K.obj (op Y)).subtype (sectionsBaseChange K.toSheafOfModules φ u) := by
    rw [hu0]
    rfl
  rw [hgu]
  clear hgu hu0
  induction u using TensorProduct.induction_on with
  | zero =>
    exact mem_of_eq_of_mem ((congrArg _ (map_zero _)).trans (map_zero _)) (zero_mem _)
  | tmul r k =>
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k.1, k.2, rfl⟩)
  | add u v hu hv =>
    exact mem_of_eq_of_mem ((congrArg _ (map_add _ u v)).trans (map_add _ _ _)) (add_mem hu hv)

/-- **The meet of finitely many quasi-coherent submodules of a quasi-coherent module is
quasi-coherent**, for a nonempty finite family. -/
theorem isQuasicoherentOnSite_finset_inf {G : Modules.{u, u} B S hS F hF}
    (hG : G.IsQuasicoherentOnSite) {κ : Type*} (K : κ → G.Submodule)
    (hK : ∀ j, (K j).toSheafOfModules.IsQuasicoherentOnSite) (s : Finset κ) (hs : s.Nonempty) :
    (s.inf K).toSheafOfModules.IsQuasicoherentOnSite := by
  induction hs using Finset.Nonempty.cons_induction with
  | singleton j =>
    rw [Finset.inf_singleton]
    exact hK j
  | cons j s hj _ ih =>
    rw [Finset.inf_cons]
    exact isQuasicoherentOnSite_inf B S hS F hF hG _ _ (hK j) ih

/-- A section lies in a submodule if its restrictions to all affine open charts do. -/
private theorem mem_obj_of_forall_openChartInclusion {G : Modules.{u, u} B S hS F hF}
    (K : G.Submodule) (Q : SmallEtale B S hS F) (x : G.val.obj (op Q))
    (h : ∀ O : (chartScheme Q).affineOpens,
      G.val.map (openChartInclusion B S hS F Q O.1).op x ∈ K.obj (op (openChart B S hS F Q O.1))) :
    x ∈ K.obj (op Q) := by
  refine K.isSheaf x ((SmallEtale.topology B S hS F).superset_covering ?_
    (SmallEtale.ofArrows_openChart_affineOpens_mem B S hS F Q))
  rintro _ _ ⟨O', q, _, ⟨O''⟩, rfl⟩
  refine Sieve.downward_closed _ ?_ q
  exact h O''.down

/-- **A submodule generated by sections over a terminal chart lies in a submodule containing
those sections.** -/
theorem imageSubmodule_terminalSectionsHom_le (G : Modules.{u, u} B S hS F hF)
    (hG : G.IsQuasicoherentOnSite) {T₀ : SmallEtale B S hS F} (hT₀ : IsTerminal T₀)
    {I : Type u} (a : I → G.val.obj (op T₀)) (K : G.Submodule)
    (ha : ∀ i, a i ∈ K.obj (op T₀)) : imageSubmodule (terminalSectionsHom G hT₀ a) ≤ K := by
  intro T x hx
  obtain ⟨T⟩ := T
  refine mem_obj_of_forall_openChartInclusion K T x fun O => ?_
  have hO := (imageSubmodule (terminalSectionsHom G hT₀ a)).map_mem
    (openChartInclusion B S hS F T O.1).op hx
  replace hO := (imageSubmodule_terminalSectionsHom_obj_eq_span G hG hT₀ a _
    (isAffine_chartScheme_openChart B S hS F T O)).le hO
  have hspan : Submodule.span (chartRing B S hS F hF (openChart B S hS F T O.1))
      (Set.range fun i => chartRestrictLinear G (hT₀.from (openChart B S hS F T O.1))
        (a i)) ≤ K.obj (op (openChart B S hS F T O.1)) :=
    Submodule.span_le.2 (by
      rintro _ ⟨i, rfl⟩
      exact K.map_mem _ (ha i))
  exact hspan hO

/-- The span of the restrictions along `d` of a submodule of the sections over `O` lies in a
sheaf submodule containing it. -/
theorem chartSpan_le_obj (G : Modules.{u, u} B S hS F hF) (K : G.Submodule)
    {O Y : SmallEtale B S hS F} (d : Y ⟶ O)
    {M' : Submodule (chartRing B S hS F hF O) (G.val.obj (op O))} (h : M' ≤ K.obj (op O)) :
    chartSpan G d M' ≤ K.obj (op Y) :=
  Submodule.span_le.2 (by
    rintro _ ⟨m, hm, rfl⟩
    exact K.map_mem d.op (h hm))

end Cartesian

/-- An element of the span of an image under a map lies in the span of the image of a finite
subset. -/
theorem exists_finset_subset_mem_span_image {R A P : Type*} [Semiring R] [AddCommMonoid P]
    [Module R P] (f : A → P) (s : Set A) {x : P} (hx : x ∈ Submodule.span R (f '' s)) :
    ∃ F : Finset A, (F : Set A) ⊆ s ∧ x ∈ Submodule.span R (f '' (F : Set A)) := by
  classical
  obtain ⟨T, hT, hxT⟩ := Submodule.mem_span_finite_of_mem_span hx
  choose g hgs hgf using fun t (ht : t ∈ T) => hT ht
  refine ⟨T.attach.image (fun t => g t.1 t.2), ?_, Submodule.span_mono ?_ hxT⟩
  · intro m hm
    obtain ⟨t, -, rfl⟩ := Finset.mem_image.1 hm
    exact hgs t.1 t.2
  · intro t ht
    exact ⟨g t ht, Finset.mem_image_of_mem _ (Finset.mem_attach T ⟨t, ht⟩), hgf t ht⟩

/-- Restricting along a morphism and back along a section of it is the identity. -/
theorem presheafOfModules_map_map_of_comp_eq_id {C : Type*} [Category C]
    {R : Cᵒᵖ ⥤ RingCat.{u}} (P : PresheafOfModules.{u} R) {a b : C} (f : a ⟶ b) (g : b ⟶ a)
    (h : f ≫ g = 𝟙 a) (x : P.obj (op a)) : P.map f.op (P.map g.op x) = x := by
  rw [← PresheafOfModules.map_comp_apply, ← op_comp, h, op_id, PresheafOfModules.map_id]
  rfl

/-- Three composable restrictions of a presheaf of modules are the restriction along the
composite. -/
theorem presheafOfModules_map_map_map_eq {C : Type*} [Category C]
    {R : Cᵒᵖ ⥤ RingCat.{u}} (P : PresheafOfModules.{u} R) {a b c d : C} (k₁ : b ⟶ a)
    (k₂ : c ⟶ b) (k₃ : d ⟶ c) (l : d ⟶ a) (h : k₃ ≫ k₂ ≫ k₁ = l) (y : P.obj (op a)) :
    P.map k₃.op (P.map k₂.op (P.map k₁.op y)) = P.map l.op y := by
  rw [← h, op_comp, op_comp, PresheafOfModules.map_comp_apply,
    PresheafOfModules.map_comp_apply]

/-! ### Charts of the étale member lying over the open member -/

section Square

variable {W : AlgebraicSpaces B S hS} {Ve : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
  {Uo : Subfunctor W.1} {fV : Ve ⟶ W.1}

/-- A chart of `V` whose composite to `W` factors through the open subspace `U` gives an étale
morphism to `U`. -/
theorem isEtale_of_comp_ι_eq (hfV : IsEtale B S hS fV) (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    IsEtale B S hS c :=
  isEtale_of_comp_mono B S hS c Uo.ι (by
    rw [hc]
    exact isEtale_comp B S hS ((isEtale_iff_presheaf_of_yoneda B S hS _).2 Y.property) hfV)

/-- A factorization through `U` of the composite to `W` of a chart of `V` lifts to any chart
mapping to it. -/
theorem comp_ι_eq_of_hom {Y Z : SmallEtale B S hS Ve} (q : Y ⟶ Z)
    {c : yoneda.obj Z.1.left ⟶ Uo.toFunctor} (hc : c ≫ Uo.ι = Z.1.hom ≫ fV) :
    (yoneda.map q.hom.left ≫ c) ≫ Uo.ι = Y.1.hom ≫ fV := by
  rw [Category.assoc, hc, ← Category.assoc, CostructuredArrow.w q.hom]

variable (hsq : IsElementaryDistinguishedSquare B S hS W.2 Uo fV)

/-- **A chart of the étale member lying over the open member, read as a chart of the open
member.** -/
def edsOpenChartOfFactor (Y : SmallEtale B S hS Ve) (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor)
    (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    (smallEtaleRingedSite B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2).C :=
  ⟨CostructuredArrow.mk c, (isEtale_iff_presheaf_of_yoneda B S hS c).1
    (isEtale_of_comp_ι_eq hsq.isEtale Y c hc)⟩

/-- The identification of the composite chart of `W` of a chart of `V` lying over `U` with the
composite chart of its reading as a chart of `U`. -/
def edsToOpenChart (Y : SmallEtale B S hS Ve) (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor)
    (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    (ringedSitePostcomp B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)).obj Y ⟶
      (ringedSitePostcomp B S hS (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).obj
        (edsOpenChartOfFactor hsq Y c hc) :=
  ObjectProperty.homMk (CostructuredArrow.homMk (𝟙 _)
    ((congrArg (· ≫ c ≫ Uo.ι) (yoneda.map_id _)).trans ((Category.id_comp _).trans hc)))

/-- The inverse of `AlgebraicGeometry.Space.edsToOpenChart`. -/
def edsFromOpenChart (Y : SmallEtale B S hS Ve) (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor)
    (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    (ringedSitePostcomp B S hS (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).obj
        (edsOpenChartOfFactor hsq Y c hc) ⟶
      (ringedSitePostcomp B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)).obj
        Y :=
  ObjectProperty.homMk (CostructuredArrow.homMk (𝟙 _)
    ((congrArg (· ≫ Y.1.hom ≫ fV) (yoneda.map_id _)).trans
      ((Category.id_comp _).trans hc.symm)))

/-- `AlgebraicGeometry.Space.edsToOpenChart` followed by
`AlgebraicGeometry.Space.edsFromOpenChart` is the identity. -/
theorem edsToOpenChart_comp_edsFromOpenChart (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    edsToOpenChart hsq Y c hc ≫ edsFromOpenChart hsq Y c hc = 𝟙 _ :=
  ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (Category.comp_id _))

/-- `AlgebraicGeometry.Space.edsFromOpenChart` followed by
`AlgebraicGeometry.Space.edsToOpenChart` is the identity. -/
theorem edsFromOpenChart_comp_edsToOpenChart (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    edsFromOpenChart hsq Y c hc ≫ edsToOpenChart hsq Y c hc = 𝟙 _ :=
  ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (Category.comp_id _))

variable {M : Modules.{u, u} B S hS W.1 W.2}
  (N₀ : ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
    (isEtale_edsOpenHom B S hS hsq)).obj M).Submodule)

/-- **Over a chart of `V` lying over `U`, the pullback to `V` of the pushforward of `N₀` is
`N₀`.** -/
theorem mem_etaleSubmoduleRestrict_etaleSubmodulePushforward_iff_of_factor
    (Y : SmallEtale B S hS Ve) (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor)
    (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (y : M.val.obj (op ((ringedSitePostcomp B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj Y))) :
    y ∈ (etaleSubmoduleRestrict B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)
        (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
          (isEtale_edsOpenHom B S hS hsq) N₀)).obj (op Y) ↔
      M.val.map (edsFromOpenChart hsq Y c hc).op y ∈
        N₀.obj (op (edsOpenChartOfFactor hsq Y c hc)) := by
  refine (mem_etaleSubmoduleRestrict_obj B S hS (edsEtaleHom B S hS hsq)
    (isEtale_edsEtaleHom B S hS hsq) (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq) N₀) Y y).trans ?_
  refine (mem_etaleSubmodulePushforward_iff (edsOpenHom B S hS hsq)
    (isEtale_edsOpenHom B S hS hsq) N₀ _ y).trans ⟨fun h => h _ _, fun h T g => ?_⟩
  have : Mono (edsOpenHom B S hS hsq).hom := mono_edsOpenHom_hom hsq
  let g₁ : (ringedSitePostcomp B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj T ⟶ (ringedSitePostcomp B S hS
        (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).obj
          (edsOpenChartOfFactor hsq Y c hc) := g ≫ edsToOpenChart hsq Y c hc
  obtain ⟨g', hg'⟩ := exists_smallEtalePostcomp_map_eq B S hS (edsOpenHom B S hS hsq)
    (isEtale_edsOpenHom B S hS hsq) inferInstance g₁
  refine mem_etaleSubmodule_of_map_eq _ _ N₀ g' h ?_
  have e := presheafOfModules_map_map_eq M.val (edsFromOpenChart hsq Y c hc).op
    ((ringedSitePostcomp B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).map g').op (𝟙 _) g.op (Quiver.Hom.unop_inj (by
        change (smallEtalePostcomp B S hS (edsOpenHom B S hS hsq)
          (isEtale_edsOpenHom B S hS hsq)).map g' ≫ edsFromOpenChart hsq Y c hc = g ≫ 𝟙 _
        rw [hg']
        exact (Category.assoc _ _ _).trans (congrArg (g ≫ ·)
          (edsToOpenChart_comp_edsFromOpenChart hsq Y c hc)))) y
  rwa [moduleMap_id_apply] at e

/-- A section of `N₀` restricted along a morphism to its composite chart from the composite
chart of a chart of `V` lies in the pullback to `V` of the pushforward of `N₀`. -/
theorem map_mem_etaleSubmoduleRestrict_etaleSubmodulePushforward
    (T : (smallEtaleRingedSite B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2).C)
    (T' : SmallEtale B S hS Ve)
    (g : (ringedSitePostcomp B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj T' ⟶ (ringedSitePostcomp B S hS
        (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).obj T)
    {x : M.val.obj (op ((ringedSitePostcomp B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj T))} (hx : x ∈ N₀.obj (op T)) :
    M.val.map g.op x ∈ (etaleSubmoduleRestrict B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq) (etaleSubmodulePushforward B S hS
        (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq) N₀)).obj (op T') := by
  have : Mono (edsOpenHom B S hS hsq).hom := mono_edsOpenHom_hom hsq
  refine (mem_etaleSubmoduleRestrict_obj B S hS (edsEtaleHom B S hS hsq)
    (isEtale_edsEtaleHom B S hS hsq) (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq) N₀) T' _).2 ?_
  have hx' := (mem_etaleSubmoduleRestrict_obj B S hS (edsOpenHom B S hS hsq)
    (isEtale_edsOpenHom B S hS hsq) (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq) N₀) T x).1
    (le_etaleSubmoduleRestrict_etaleSubmodulePushforward_of_mono (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq) N₀ (op T) hx)
  exact (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
    (isEtale_edsOpenHom B S hS hsq) N₀).map_mem g.op hx'

/-! ### The part of a chart of `V` over `U` -/

/-- **The part over `U` of a chart `Z` of `V`**: the open subscheme of the chart scheme cut out
by the open subspace `U`, as a chart of `V`. -/
def edsOverPart (Z : SmallEtale B S hS Ve) : SmallEtale B S hS Ve :=
  ⟨CostructuredArrow.mk (yoneda.map (hsq.isOpenSubspace.2.rep.snd (Z.1.hom ≫ fV)) ≫ Z.1.hom),
    etale_comp_of_scheme B S hS _ Z.1.hom (by
      have : _root_.AlgebraicGeometry.IsOpenImmersion ((BigFppfOver.toScheme B S hS).map
          (hsq.isOpenSubspace.2.rep.snd (Z.1.hom ≫ fV))) :=
        hsq.isOpenSubspace.2.property_snd (Z.1.hom ≫ fV)
      infer_instance) Z.property⟩

/-- The part over `U` of a chart lies over `U`. -/
theorem edsOverPart_comp_ι_eq (Z : SmallEtale B S hS Ve) :
    hsq.isOpenSubspace.2.rep.fst (Z.1.hom ≫ fV) ≫ Uo.ι = (edsOverPart hsq Z).1.hom ≫ fV := by
  rw [hsq.isOpenSubspace.2.rep.w]
  change _ = (yoneda.map _ ≫ Z.1.hom) ≫ fV
  rw [Category.assoc]

/-- The morphism of schemes underlying `AlgebraicGeometry.Space.edsToOverPart`. -/
def edsLiftOverPart {Y Z : SmallEtale B S hS Ve} (q : Y ⟶ Z)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    Y.1.left ⟶ hsq.isOpenSubspace.2.rep.pullback (Z.1.hom ≫ fV) :=
  hsq.isOpenSubspace.2.rep.lift c q.hom.left (by
    rw [hc, ← CostructuredArrow.w q.hom, Category.assoc])

/-- A chart of `V` mapping to `Z` and lying over `U` maps to the part of `Z` over `U`. -/
def edsToOverPart {Y Z : SmallEtale B S hS Ve} (q : Y ⟶ Z)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) :
    Y ⟶ edsOverPart hsq Z :=
  ObjectProperty.homMk (CostructuredArrow.homMk (edsLiftOverPart hsq q c hc)
    ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ Z.1.hom)
      ((yoneda.map_comp _ _).symm.trans (congrArg yoneda.map
        (Functor.relativelyRepresentable.lift_snd _ _ _ _)))).trans
          (CostructuredArrow.w q.hom))))

/-- A section over a chart `Y` of `V` lying over `U` lies in a submodule if its restrictions to
all charts mapping to a member of a covering of the part of the terminal chart over `U` do. -/
private theorem mem_obj_of_forall_map_mem_of_cover {hV : IsAlgebraicSpace B S hS Ve}
    {G : Modules.{u, u} B S hS Ve hV} (K : G.Submodule) {TV : SmallEtale B S hS Ve}
    (hTV : IsTerminal TV) {κ : Type*} (O : κ → SmallEtale B S hS Ve)
    (ι : ∀ j, O j ⟶ edsOverPart hsq TV)
    (hcov : Sieve.ofArrows O ι ∈ SmallEtale.topology B S hS Ve (edsOverPart hsq TV))
    {Y : SmallEtale B S hS Ve} (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor)
    (hc : c ≫ Uo.ι = Y.1.hom ≫ fV) (y : G.val.obj (op Y))
    (h : ∀ (j : κ) (Q : SmallEtale B S hS Ve) (p : Q ⟶ Y), (Q ⟶ O j) →
      G.val.map p.op y ∈ K.obj (op Q)) : y ∈ K.obj (op Y) := by
  refine K.isSheaf y ((SmallEtale.topology B S hS Ve).superset_covering
    (fun Q p hp => ?_) ((SmallEtale.topology B S hS Ve).pullback_stable
      (edsToOverPart hsq (hTV.from Y) c hc) hcov))
  obtain ⟨j, q, -⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hp
  exact h j Q p q

/-- **The part over `U` of an affine chart of `V` is quasi-compact**, `W` being
quasi-separated and `U` quasi-compact. -/
theorem compactSpace_edsOverPart (hZ : B.Contains (⊤_ Scheme.{u}))
    (hWqs : IsAbsolutelyQuasiSeparated B S hS hZ W.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor) (Z : SmallEtale B S hS Ve)
    (hZa : IsAffine (chartScheme Z)) : CompactSpace (chartScheme (edsOverPart hsq Z)) :=
  compactSpace_of_isQuasiCompactSpace_yoneda_obj B S hS
    (isQuasiCompactSpace_of_iso B S hS
      (hsq.isOpenSubspace.2.rep.isPullback (Z.1.hom ≫ fV)).flip.isoPullback.symm
      (isQuasiCompact_of_isQuasiCompactSpace B S hS hZ W.2 hWqs hUqc Uo.ι
        (yoneda.obj Z.1.left) (isAlgebraicSpace_yoneda B S hS _)
        (isQuasiCompact_yoneda_of_compact B S hS _ (inferInstanceAs (CompactSpace (chartScheme Z))))
        (Z.1.hom ≫ fV)))

/-- **The part over `U` of an affine chart of `V` is covered by finitely many affine charts.** -/
theorem exists_finite_affine_cover_edsOverPart (hZ : B.Contains (⊤_ Scheme.{u}))
    (hWqs : IsAbsolutelyQuasiSeparated B S hS hZ W.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor) (Z : SmallEtale B S hS Ve)
    (hZa : IsAffine (chartScheme Z)) :
    ∃ (κ : Type u) (_ : Finite κ) (O : κ → SmallEtale B S hS Ve)
      (ι : ∀ j, O j ⟶ edsOverPart hsq Z), (∀ j, IsAffine (chartScheme (O j))) ∧
        Sieve.ofArrows O ι ∈ SmallEtale.topology B S hS Ve (edsOverPart hsq Z) := by
  have := compactSpace_edsOverPart hsq hZ hWqs hUqc Z hZa
  have hcomp : IsCompact ((⊤ : (chartScheme (edsOverPart hsq Z)).Opens) :
      Set (chartScheme (edsOverPart hsq Z))) := by
    rw [TopologicalSpace.Opens.coe_top]
    exact isCompact_univ
  obtain ⟨s, hs, hsU⟩ := (isCompact_iff_finite_and_eq_biUnion_affineOpens
    (X := chartScheme (edsOverPart hsq Z)) (U := ⊤)).1 hcomp
  refine ⟨s, hs.to_subtype, fun i => openChart B S hS Ve (edsOverPart hsq Z) i.1.1,
    fun i => openChartInclusion B S hS Ve (edsOverPart hsq Z) i.1.1, fun i => i.1.2, ?_⟩
  apply ofArrows_openChartInclusion_mem_topology
  rw [hsU, iSup_subtype']

/-! ### Transport between a chart of `V` over `U` and its reading on `U` -/

/-- Restricting a section of `M` along `AlgebraicGeometry.Space.edsToOpenChart` and then along
`AlgebraicGeometry.Space.edsFromOpenChart` returns it. -/
theorem map_edsFromOpenChart_map_edsToOpenChart (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (x : M.val.obj (op ((ringedSitePostcomp B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj (edsOpenChartOfFactor hsq Y c hc)))) :
    M.val.map (edsFromOpenChart hsq Y c hc).op (M.val.map (edsToOpenChart hsq Y c hc).op x) =
      x :=
  presheafOfModules_map_map_of_comp_eq_id M.val _ _
    (edsFromOpenChart_comp_edsToOpenChart hsq Y c hc) x

/-- Restricting a section of `M` along `AlgebraicGeometry.Space.edsFromOpenChart` and then along
`AlgebraicGeometry.Space.edsToOpenChart` returns it. -/
theorem map_edsToOpenChart_map_edsFromOpenChart (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (y : M.val.obj (op ((ringedSitePostcomp B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj Y))) :
    M.val.map (edsToOpenChart hsq Y c hc).op (M.val.map (edsFromOpenChart hsq Y c hc).op y) =
      y :=
  presheafOfModules_map_map_of_comp_eq_id M.val _ _
    (edsToOpenChart_comp_edsFromOpenChart hsq Y c hc) y

/-- The sections of `M|_U` over the reading on `U` of a chart of `V` lying over `U`, read as
sections of `M|_V`. -/
def edsReadOnEtale (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (z : ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj M).val.obj (op (edsOpenChartOfFactor hsq Y c hc))) :
    ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.obj (op Y) :=
  M.val.map (edsToOpenChart hsq Y c hc).op z

/-- The sections of `M|_V` over a chart of `V` lying over `U`, read as sections of `M|_U` over
its reading on `U`; the inverse of `AlgebraicGeometry.Space.edsReadOnEtale`. -/
def edsReadOnOpen (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (y : ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.obj (op Y)) :
    ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj M).val.obj (op (edsOpenChartOfFactor hsq Y c hc)) :=
  M.val.map (edsFromOpenChart hsq Y c hc).op y

/-- `AlgebraicGeometry.Space.edsReadOnEtale` is a left inverse of
`AlgebraicGeometry.Space.edsReadOnOpen`. -/
theorem edsReadOnEtale_edsReadOnOpen (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (y : ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.obj (op Y)) :
    edsReadOnEtale hsq Y c hc (edsReadOnOpen hsq Y c hc y) = y :=
  map_edsToOpenChart_map_edsFromOpenChart hsq Y c hc y

/-- `AlgebraicGeometry.Space.edsReadOnOpen` is a left inverse of
`AlgebraicGeometry.Space.edsReadOnEtale`. -/
theorem edsReadOnOpen_edsReadOnEtale (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    (z : ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj M).val.obj (op (edsOpenChartOfFactor hsq Y c hc))) :
    edsReadOnOpen hsq Y c hc (edsReadOnEtale hsq Y c hc z) = z :=
  map_edsFromOpenChart_map_edsToOpenChart hsq Y c hc z

/-- Reading a span over a chart of `U` on the corresponding chart of `V`. -/
theorem edsReadOnEtale_mem_span (Y : SmallEtale B S hS Ve)
    (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
    {s : Set (((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj M).val.obj (op (edsOpenChartOfFactor hsq Y c hc)))}
    {z : ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj M).val.obj (op (edsOpenChartOfFactor hsq Y c hc))}
    (hz : z ∈ Submodule.span (chartRing B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2
      (edsOpenChartOfFactor hsq Y c hc)) s) :
    edsReadOnEtale hsq Y c hc z ∈
      Submodule.span (chartRing B S hS (edsEtale B S hS hsq).1 (edsEtale B S hS hsq).2 Y)
        (edsReadOnEtale hsq Y c hc '' s) := by
  induction hz using Submodule.span_induction with
  | mem w hw => exact Submodule.subset_span ⟨w, hw, rfl⟩
  | zero => exact mem_of_eq_of_mem (map_zero _) (zero_mem _)
  | add w w' _ _ hw hw' => exact mem_of_eq_of_mem (map_add _ w w') (add_mem hw hw')
  | smul r w _ hw =>
    obtain ⟨r', hr'⟩ : ∃ r' : chartRing B S hS (edsEtale B S hS hsq).1 (edsEtale B S hS hsq).2 Y,
        edsReadOnEtale hsq Y c hc (r • w) = r' • edsReadOnEtale hsq Y c hc w :=
      ⟨_, M.val.map_smul (edsToOpenChart hsq Y c hc).op r w⟩
    exact mem_of_eq_of_mem hr' (Submodule.smul_mem _ _ hw)

/-! ### Local criteria for the pullback of the pushforward -/

/-- **Membership in the pullback to `V` of the pushforward of `N₀` is tested over the part of
the terminal chart lying over `U`**: on charts mapping to the members of a covering of that part.
-/
theorem mem_etaleSubmoduleRestrict_etaleSubmodulePushforward_of_forall
    {TV : SmallEtale B S hS Ve} (hTV : IsTerminal TV) {κ : Type*}
    (O : κ → SmallEtale B S hS Ve) (ι : ∀ j, O j ⟶ edsOverPart hsq TV)
    (hcov : Sieve.ofArrows O ι ∈ SmallEtale.topology B S hS Ve (edsOverPart hsq TV))
    {Z : SmallEtale B S hS Ve}
    (y : ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.obj (op Z))
    (hy : ∀ (j : κ) (Q : SmallEtale B S hS Ve) (p : Q ⟶ Z) (_ : Q ⟶ O j),
      ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
        (isEtale_edsEtaleHom B S hS hsq)).obj M).val.map p.op y ∈
        (etaleSubmoduleRestrict B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)
          (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
            (isEtale_edsOpenHom B S hS hsq) N₀)).obj (op Q)) :
    y ∈ (etaleSubmoduleRestrict B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)
      (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
        (isEtale_edsOpenHom B S hS hsq) N₀)).obj (op Z) := by
  refine (mem_etaleSubmoduleRestrict_obj B S hS (edsEtaleHom B S hS hsq)
    (isEtale_edsEtaleHom B S hS hsq) (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq) N₀) Z y).2
    ((mem_etaleSubmodulePushforward_iff (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)
      N₀ ((smallEtalePostcomp B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS
        hsq)).obj Z) y).2 fun T g => ?_)
  obtain ⟨Y, q, c, hc, k, hk⟩ : ∃ (Y : SmallEtale B S hS Ve) (q : Y ⟶ Z)
      (c : yoneda.obj Y.1.left ⟶ Uo.toFunctor) (hc : c ≫ Uo.ι = Y.1.hom ≫ fV)
      (k : T ⟶ edsOpenChartOfFactor hsq Y c hc),
      (smallEtalePostcomp B S hS (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).map k ≫
        edsFromOpenChart hsq Y c hc ≫ (smallEtalePostcomp B S hS (edsEtaleHom B S hS hsq)
          (isEtale_edsEtaleHom B S hS hsq)).map q = g :=
    ⟨⟨CostructuredArrow.mk (yoneda.map g.hom.left ≫ Z.1.hom),
        etale_comp_of_scheme B S hS g.hom.left Z.1.hom
          (etale_toScheme_toOver_map B S hS W.1 g) Z.property⟩,
      ObjectProperty.homMk (CostructuredArrow.homMk g.hom.left rfl), T.1.hom,
      (CostructuredArrow.w g.hom).symm.trans (Category.assoc _ _ _).symm,
      ObjectProperty.homMk (CostructuredArrow.homMk (𝟙 _)
        ((congrArg (· ≫ T.1.hom) (yoneda.map_id _)).trans (Category.id_comp _))),
      ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (by
        change 𝟙 _ ≫ 𝟙 _ ≫ g.hom.left = g.hom.left
        rw [Category.id_comp, Category.id_comp]))⟩
  have hYG : ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.map q.op y ∈
      (etaleSubmoduleRestrict B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)
        (etaleSubmodulePushforward B S hS (edsOpenHom B S hS hsq)
          (isEtale_edsOpenHom B S hS hsq) N₀)).obj (op Y) := by
    refine mem_obj_of_forall_map_mem_of_cover hsq _ hTV O ι hcov c hc _ fun j Q p h => ?_
    have hQ := hy j Q (p ≫ q) h
    change ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.map p.op
        (((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
          (isEtale_edsEtaleHom B S hS hsq)).obj M).val.map q.op y) ∈ _
    exact (congrArg (· ∈ _) (ConcreteCategory.congr_hom
      (((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
        (isEtale_edsEtaleHom B S hS hsq)).obj M).val.map_comp q.op p.op) y)).mp hQ
  have hYU := (mem_etaleSubmoduleRestrict_etaleSubmodulePushforward_iff_of_factor hsq N₀ Y c hc
    _).1 hYG
  exact mem_etaleSubmodule_of_map_eq _ _ N₀ k hYU
    (presheafOfModules_map_map_map_eq M.val ((smallEtalePostcomp B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).map q) (edsFromOpenChart hsq Y c hc)
      ((smallEtalePostcomp B S hS (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).map k)
      g hk y)

/-- **Over an affine chart of `V` mapping to a chart `O` over `U`, a section of the pullback to `V`
of the pushforward of `N₀` lies in the span of the restrictions of generators of `N₀(O)`**, `N₀`
being cartesian on affine charts. -/
theorem mem_chartSpan_of_mem_etaleSubmoduleRestrict_etaleSubmodulePushforward
    (hN₀c : IsCartesianOnAffineCharts N₀.toSheafOfModules) (O : SmallEtale B S hS Ve)
    (cO : yoneda.obj O.1.left ⟶ Uo.toFunctor) (hcO : cO ≫ Uo.ι = O.1.hom ≫ fV)
    (hOa : IsAffine (chartScheme O)) {r : ℕ}
    (n : Fin r → ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
      (isEtale_edsOpenHom B S hS hsq)).obj M).val.obj (op (edsOpenChartOfFactor hsq O cO hcO)))
    (hn : N₀.obj (op (edsOpenChartOfFactor hsq O cO hcO)) ≤
      Submodule.span (chartRing B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2
        (edsOpenChartOfFactor hsq O cO hcO)) (Set.range n))
    {Y : SmallEtale B S hS Ve} (hYa : IsAffine (chartScheme Y)) (d : Y ⟶ O)
    {y : ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M).val.obj (op Y)}
    (hy : y ∈ (etaleSubmoduleRestrict B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq) (etaleSubmodulePushforward B S hS
        (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq) N₀)).obj (op Y)) :
    y ∈ chartSpan ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
      (isEtale_edsEtaleHom B S hS hsq)).obj M) d
        (Submodule.span (chartRing B S hS (edsEtale B S hS hsq).1 (edsEtale B S hS hsq).2 O)
          (Set.range fun l => edsReadOnEtale hsq O cO hcO (n l))) := by
  obtain ⟨cY, hcY, hcYd⟩ : ∃ (cY : yoneda.obj Y.1.left ⟶ Uo.toFunctor)
      (_ : cY ≫ Uo.ι = Y.1.hom ≫ fV), cY = yoneda.map d.hom.left ≫ cO :=
    ⟨_, comp_ι_eq_of_hom d hcO, rfl⟩
  obtain ⟨dU, hdU⟩ : ∃ dU : edsOpenChartOfFactor hsq Y cY hcY ⟶ edsOpenChartOfFactor hsq O cO hcO,
      dU.hom.left = d.hom.left :=
    ⟨ObjectProperty.homMk (CostructuredArrow.homMk d.hom.left hcYd.symm), rfl⟩
  have hy' := (mem_etaleSubmoduleRestrict_etaleSubmodulePushforward_iff_of_factor hsq N₀ Y cY hcY
    y).1 hy
  have h1 := obj_le_span_chartRes_of_isCartesianOnAffineCharts _ N₀ hN₀c hOa hYa dU hy'
  have h2 : edsReadOnOpen hsq Y cY hcY y ∈
      Submodule.span (chartRing B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2
        (edsOpenChartOfFactor hsq Y cY hcY))
        ((fun x => chartRes ((etaleModulePullback B S hS (edsOpenHom B S hS hsq)
          (isEtale_edsOpenHom B S hS hsq)).obj M) dU x) '' Set.range n) := by
    refine Submodule.span_le.2 ?_ h1
    rintro _ ⟨m, hm, rfl⟩
    exact (chartSpan_span _ dU (Set.range n)).le (map_mem_chartSpan_of_mem _ dU _ (hn hm))
  have h3 := edsReadOnEtale_mem_span hsq Y cY hcY h2
  rw [edsReadOnEtale_edsReadOnOpen] at h3
  refine Submodule.span_le.2 ?_ h3
  rintro _ ⟨_, ⟨_, ⟨l, rfl⟩, rfl⟩, rfl⟩
  have e : edsReadOnEtale hsq Y cY hcY (chartRes ((etaleModulePullback B S hS
      (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).obj M) dU (n l)) =
      chartRes ((etaleModulePullback B S hS (edsEtaleHom B S hS hsq)
        (isEtale_edsEtaleHom B S hS hsq)).obj M) d (edsReadOnEtale hsq O cO hcO (n l)) :=
    presheafOfModules_map_map_eq M.val
      ((ringedSitePostcomp B S hS (edsOpenHom B S hS hsq) (isEtale_edsOpenHom B S hS hsq)).map
        dU).op (edsToOpenChart hsq Y cY hcY).op (edsToOpenChart hsq O cO hcO).op
      ((ringedSitePostcomp B S hS (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)).map
        d).op (Quiver.Hom.unop_inj
      (ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (by
        change 𝟙 _ ≫ dU.hom.left = d.hom.left ≫ 𝟙 _
        rw [hdU]
        exact (Category.id_comp _).trans (Category.comp_id _).symm)))) (n l)
  exact mem_of_eq_of_mem e (map_mem_chartSpan_of_mem ((etaleModulePullback B S hS
    (edsEtaleHom B S hS hsq) (isEtale_edsEtaleHom B S hS hsq)).obj M) d _
      (Submodule.subset_span ⟨l, rfl⟩))

/-- **The extension of a finite type submodule across the étale member of an elementary
distinguished square.** Let `V` be quasi-separated with a terminal affine chart `T_V`, let
finitely many affine charts `O j` cover the part of `T_V` over `U`, `M` a quasi-coherent
`𝒪_W`-module and `N₀ ⊆ M|_U` a quasi-coherent submodule of finite type, and let `G ⊆ M|_V` be
the étale pullback to `V` of the étale pushforward of `N₀`. Given finitely many sections `a` of
`G` over `T_V`, there is a quasi-coherent submodule `N ⊆ G` of finite type containing them which
agrees with `G` over every chart of `V` lying over `U`.

`N` is generated by the `a` and by finitely many sections of `G` over `T_V` whose restrictions to
the finitely many affine charts `O j` covering the part of `T_V` over `U` generate `N₀(O j)`. Those
exist because `G` is quasi-coherent: it is the meet over `j` of the submodules
`AlgebraicGeometry.Space.chartSpanSubmodule` of the sections lying locally in the span of the
restrictions of generators of `N₀(O j)`, each of which is quasi-coherent by
`AlgebraicGeometry.Space.isCartesianOnAffineCharts_chartSpanSubmodule` ([Stacks, Tag 07TU]). -/
theorem exists_isFiniteType_le_etaleSubmoduleRestrict_etaleSubmodulePushforward
    (hZ : B.Contains (⊤_ Scheme.{u})) (hVqs : IsAbsolutelyQuasiSeparated B S hS hZ Ve) (hM :
        M.IsQuasicoherentOnSite)
    (hN₀q : N₀.toSheafOfModules.IsQuasicoherentOnSite)
    (hN₀f : N₀.toSheafOfModules.IsFiniteTypeOnSite)
    {TV : SmallEtale B S hS Ve} (hTV : IsTerminal TV) (hTVa : IsAffine (chartScheme TV))
    {κ : Type u} [Finite κ] (O : κ → SmallEtale B S hS Ve) (ι : ∀ j, O j ⟶ edsOverPart hsq TV)
    (hOa : ∀ j, IsAffine (chartScheme (O j)))
