/-!
# Site-theoretic properties of a big fppf site

A big fppf site in the sense of `AlgebraicGeometry.BigFppfSite` is assembled from a size
cutoff and a bounded system of covering families. Its underlying category is essentially small
and contains the empty scheme and binary coproducts; its inclusion into all schemes is
continuous; the sieve generated by any fppf covering family is a covering sieve; and the empty
sieve covers an object with no points. The same facts hold for the big fppf site over a
scheme, whose topology is moreover subcanonical.

## Main definitions

* `AlgebraicGeometry.BigFppfOver.empty` is the empty scheme as an object of the big fppf
  site over `S`, and `AlgebraicGeometry.BigFppfOver.isInitialEmpty` is its initiality.

## Main results

* `AlgebraicGeometry.BigFppfSite.essentiallySmall_schemes` and
  `AlgebraicGeometry.BigFppfOver.essentiallySmall`: the underlying categories are
  essentially small.
* `AlgebraicGeometry.BigFppfOver.subcanonical`: the topology of the big fppf site over `S` is
  subcanonical, so representable presheaves are sheaves.
* `AlgebraicGeometry.BigFppfSite.inclusion_isContinuous`: the inclusion into all schemes is
  continuous for the fppf topology.
* `AlgebraicGeometry.BigFppfSite.generate_mem_topology`: the sieve generated by an fppf
  covering family is a covering sieve, even though the family itself need not have been
  chosen.
* `AlgebraicGeometry.BigFppfSite.bot_mem_topology` and
  `AlgebraicGeometry.BigFppfOver.bot_mem_topology`: the empty sieve covers an object whose
  underlying scheme has no points, with
  `AlgebraicGeometry.BigFppfSite.bot_mem_topology_obj_contains_empty`,
  `AlgebraicGeometry.BigFppfOver.bot_mem_topology_of_left_eq_empty` and
  `AlgebraicGeometry.BigFppfOver.bot_mem_topology_of_isInitial` as the special cases for the
  empty scheme and for an initial object.
* `AlgebraicGeometry.BigFppfSite.contains_empty` and
  `AlgebraicGeometry.BigFppfSite.contains_coprod`: the size cutoff is closed under the
  empty scheme and under binary coproducts.

## References

* [Stacks Project, Tag 021R](https://stacks.math.columbia.edu/tag/021R)
* [Stacks Project, Tag 021S](https://stacks.math.columbia.edu/tag/021S)
-/

@[expose] public section

open Cardinal CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-! ### Size bounds -/

/-- The empty scheme has countable size. -/
theorem Scheme.size_empty_le_aleph0 : (∅ : Scheme.{u}).size ≤ ℵ₀ := by
  unfold Scheme.size
  refine max_le le_rfl (max_le ?_ (ciSup_le' fun U => ?_))
  · have : Subsingleton (∅ : Scheme.{u}).affineOpens :=
      ⟨fun U V => Subtype.ext (SetLike.ext fun x => isEmptyElim x)⟩
    exact (Cardinal.le_one_iff_subsingleton.mpr this).trans Cardinal.one_le_aleph0
  · have : Subsingleton Γ((∅ : Scheme.{u}), U.1) := inferInstance
    exact (Cardinal.le_one_iff_subsingleton.mpr this).trans Cardinal.one_le_aleph0

namespace BigFppfSite

variable (B : BigFppfSite.{u})

/-- The empty scheme is contained in every big fppf site. -/
theorem contains_empty : B.Contains (∅ : Scheme.{u}) :=
  lt_of_le_of_lt Scheme.size_empty_le_aleph0 B.aleph0_lt_cutoff

/-- A big fppf site is closed under binary coproducts of schemes. -/
theorem contains_coprod {X Y : Scheme.{u}} (hX : B.Contains X) (hY : B.Contains Y) :
    B.Contains (X ⨿ Y) := by
  let Z : ULift.{u} WalkingPair → Scheme.{u} := fun i => i.1.casesOn X Y
  have hZ : ∀ i, (Z i).size < B.cutoff := by
    intro i
    cases i with
    | up j => cases j <;> simpa [Z] using ‹_›
  have hsum : (∐ Z).size < B.cutoff :=
    Scheme.size_sigmaObj_lt B.aleph0_lt_cutoff B.aleph0_lt_cutoff_cof
      Cardinal.mk_le_aleph0 Z hZ
  simpa [Scheme.size_congr (coprodIsoSigma X Y)] using hsum

/-- The underlying category of a big fppf site is essentially small. -/
theorem essentiallySmall_schemes : EssentiallySmall.{u} B.Schemes :=
  let : ObjectProperty.EssentiallySmall.{u} (schemeSizeBelow B.cutoff) :=
    essentiallySmall_schemeSizeBelow B.cutoff B.aleph0_lt_cutoff.le
  inferInstance

/-! ### Subcanonicity and continuity -/

/-- The chosen covering families of a big fppf site are fppf coverings, so its topology is
contained in the one induced from Mathlib's fppf precoverage. -/
theorem topology_le_comap :
    B.topology ≤ (Scheme.fppfPrecoverage.comap B.inclusion).toGrothendieck := by
  apply Precoverage.toGrothendieck_mono
  rintro X R ⟨E, rfl, hE⟩
  exact B.isFppfCovering_of_isCovering hE

/-- The inclusion of a big fppf site into all schemes is continuous for the fppf topology. -/
theorem inclusion_isContinuous :
    B.inclusion.IsContinuous B.topology Scheme.fppfTopology := by
  let Q := Scheme.fppfPrecoverage.comap B.inclusion
  let hQ : B.inclusion.IsContinuous Q.toGrothendieck Scheme.fppfTopology :=
    Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
      (F := B.inclusion) (J := Q) (K := Scheme.fppfPrecoverage) (fun _ _ hR => hR)
  let hId : (𝟭 B.Schemes).IsContinuous B.topology Q.toGrothendieck := by
    constructor
    intro G
    show Presieve.IsSheaf B.topology G.obj
    exact Presieve.isSheaf_of_le G.obj B.topology_le_comap
      ((isSheaf_iff_isSheaf_of_type _ _).mp G.property)
  exact Functor.isContinuous_comp (𝟭 B.Schemes) B.inclusion B.topology
    Q.toGrothendieck Scheme.fppfTopology

/-! ### Covering sieves -/

/-- The sieve generated by an fppf covering family is a covering sieve, even when the family
itself is not one of the site's chosen families. -/
theorem generate_mem_topology {X : B.Schemes} (E : PreZeroHypercover X)
    (hE : IsFppfCovering ⟨X, E⟩) : Sieve.generate E.presieve₀ ∈ B.topology X := by
  obtain ⟨E', hE', hEquiv⟩ := B.fppf_has_representative ⟨X, E⟩ hE
  have hpre : E.presieve₀ ∈ B.precoverage X := by
    obtain ⟨hX, hComb⟩ := hEquiv
    cases hX
    rw [PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hComb]
    exact ⟨E'.2, rfl, hE'⟩
  exact Precoverage.generate_mem_toGrothendieck hpre

/-- The empty sieve is a covering sieve of an object of a big fppf site whose underlying
scheme has no points. -/
theorem bot_mem_topology (Y : B.Schemes) (hY : IsEmpty (B.inclusion.obj Y)) :
    (⊥ : Sieve Y) ∈ B.topology Y := by
  have hEfp : IsFppfCovering (⟨Y, PreZeroHypercover.empty Y⟩ : Covering B.Schemes) := by
    show (PreZeroHypercover.empty Y).presieve₀.map B.inclusion ∈
      Scheme.fppfPrecoverage (B.inclusion.obj Y)
    rw [PreZeroHypercover.presieve₀_empty]
    simp only [Presieve.map_bot]
    have := hY
    simpa [Scheme.fppfPrecoverage] using
      (Scheme.bot_mem_precoverage (@Flat ⊓ @LocallyOfFinitePresentation) (B.inclusion.obj Y))
  simpa [PreZeroHypercover.presieve₀_empty] using
    B.generate_mem_topology (PreZeroHypercover.empty Y) hEfp

/-- The empty sieve covers the empty scheme in a big fppf site. -/
theorem bot_mem_topology_obj_contains_empty (hE : B.Contains (∅ : Scheme.{u})) :
    (⊥ : Sieve (B.obj hE)) ∈ B.topology (B.obj hE) :=
  B.bot_mem_topology (B.obj hE) (inferInstanceAs (IsEmpty (∅ : Scheme.{u})))

end BigFppfSite

namespace BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The big fppf site over `S` is essentially small. -/
instance essentiallySmall : EssentiallySmall.{u} (BigFppfOver B S hS) := by
  let : ObjectProperty.EssentiallySmall.{u} (schemeSizeBelow B.cutoff) :=
    essentiallySmall_schemeSizeBelow B.cutoff B.aleph0_lt_cutoff.le
  let : EssentiallySmall.{u} B.Schemes := inferInstance
  change EssentiallySmall.{u} (CostructuredArrow (𝟭 B.Schemes) (B.obj hS))
  infer_instance

/-- The topology of the big fppf site over `S` is subcanonical. -/
theorem subcanonical : (topology B S hS).Subcanonical :=
  let := BigFppfSite.subcanonical_topology B
  GrothendieckTopology.subcanonical_over B.topology (B.obj hS)

/-- The empty scheme, as an object of the big fppf site over `S`. -/
noncomputable def empty : BigFppfOver B S hS :=
  Over.mk (B.inclusion.preimage (X := B.obj B.contains_empty) (Y := B.obj hS)
    (Scheme.emptyTo (B.inclusion.obj (B.obj hS))))

/-- The empty scheme is an initial object of the big fppf site over `S`. -/
noncomputable def isInitialEmpty : IsInitial (empty B S hS) :=
  Over.isInitialOfIsInitialLeft (Y := empty B S hS)
    (isInitial_schemeBelow B (by
      change IsInitial (∅ : Scheme.{u})
      exact AlgebraicGeometry.emptyIsInitial))

/-- The empty sieve is a covering sieve of an object of the big fppf site over `S` whose
underlying scheme has no points. -/
theorem bot_mem_topology {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    (Z : BigFppfOver B S hS) (hZ : IsEmpty ((toScheme B S hS).obj Z)) :
    (⊥ : Sieve Z) ∈ topology B S hS Z := by
  rw [GrothendieckTopology.mem_over_iff, OrderIso.map_bot]
  exact B.bot_mem_topology Z.left hZ

/-- The empty sieve covers an object of the big fppf site over `S` whose underlying scheme is
the empty scheme. -/
theorem bot_mem_topology_of_left_eq_empty (T : BigFppfOver B S hS)
    (hT : T.left = B.obj B.contains_empty) : (⊥ : Sieve T) ∈ topology B S hS T :=
  bot_mem_topology T (by
    show IsEmpty (B.inclusion.obj T.left)
    rw [hT]
    show IsEmpty (∅ : Scheme.{u})
    exact (inferInstance : IsEmpty (∅ : Scheme.{u})))

/-- The empty sieve covers every initial object of the big fppf site over `S`. -/
theorem bot_mem_topology_of_isInitial (T : BigFppfOver B S hS) (hT : IsInitial T) :
    (⊥ : Sieve T) ∈ topology B S hS T := by
  simpa using (topology B S hS).pullback_stable
    ((isInitialEmpty B S hS).uniqueUpToIso hT).inv
    (bot_mem_topology_of_left_eq_empty B S hS (empty B S hS) rfl)

/-- The inclusion of the big fppf site over `S` into all schemes is continuous for the fppf
topology. -/
theorem toScheme_isContinuous :
    (toScheme B S hS).IsContinuous (topology B S hS) Scheme.fppfTopology := by
  let := B.inclusion_isContinuous
  let : (Over.forget (B.obj hS)).IsContinuous (topology B S hS) B.topology := inferInstance
  exact Functor.isContinuous_comp (Over.forget (B.obj hS)) B.inclusion (topology B S hS)
    B.topology Scheme.fppfTopology

end BigFppfOver

end AlgebraicGeometry

end
