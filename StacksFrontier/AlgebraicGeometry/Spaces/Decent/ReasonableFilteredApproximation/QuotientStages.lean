/-!
# Stacks 03K0: the quotient stages and bounded chains

Properties of the quotient of a scheme by a kernel pair (quasi-compactness and
quasi-separatedness), the description of the equivalence relation generated by a relation with
bounded fibres through chains of bounded length, directed systems of open envelopes of compact
subsets, and the identification of a cocone over a filtered diagram of quotients as a colimit.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] ReasonableApproximation.schemeCutoff_isClosedUnderIsomorphisms
  ReasonableApproximation.schemeCutoff_isClosedUnderLimitsOfShape_walkingCospan
  ReasonableApproximation.schemeCutoff_hasTerminal
  ReasonableApproximation.schemeCutoff_hasPullbacks

namespace ReasonableApproximation

open Cardinal in
/-- If a base-change-stable property of schemes holds relatively for the canonical projection
`pullback.fst f f`, then it holds for the scheme morphism underlying a kernel pair projection
`s : R ⟶ U` of `f`. -/
private theorem schemeProperty_of_kernelPair_projection
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U R : AlgebraicGeometry.BigFppfOver B S hS} (f : yoneda.obj U ⟶ F)
    (s t : R ⟶ U)
    (hR : IsPullback (yoneda.map s) (yoneda.map t) f f)
    (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange]
    (hP : (MorphismProperty.inverseImage P
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf (pullback.fst f f)) :
    P ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map s) := by
  let hcan : IsPullback (pullback.fst f f) (pullback.snd f f) f f :=
    IsPullback.of_hasPullback f f
  let e := hR.isoIsPullback _ _ hcan
  have hefst : e.hom ≫ pullback.fst f f = yoneda.map s :=
    IsPullback.isoIsPullback_hom_fst _ _ hR hcan
  let hbase : IsPullback e.hom (yoneda.map s) (pullback.fst f f)
      (𝟙 (yoneda.obj U)) := IsPullback.of_horiz_isIso ⟨by rw [hefst]; simp⟩
  exact hP.property (𝟙 (yoneda.obj U)) e.hom s hbase

/-- If a base-change-stable property of schemes holds relatively for `pullback.fst f f`, then its
relative form holds for `yoneda.map s`, for `s` a kernel pair projection of `f`. -/
private theorem presheafProperty_of_kernelPair_projection
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U R : AlgebraicGeometry.BigFppfOver B S hS} (f : yoneda.obj U ⟶ F)
    (s t : R ⟶ U)
    (hR : IsPullback (yoneda.map s) (yoneda.map t) f f)
    (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange]
    (hP : (MorphismProperty.inverseImage P
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf (pullback.fst f f)) :
    (MorphismProperty.inverseImage P
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf (yoneda.map s) := by
  let Q := MorphismProperty.inverseImage P
    (AlgebraicGeometry.BigFppfOver.toScheme B S hS)
  have hsScheme : P ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map s) :=
    schemeProperty_of_kernelPair_projection B S hS f s t hR P hP
  have hs : Q s := hsScheme
  let : HasPullbacks (AlgebraicGeometry.BigFppfOver B S hS) := inferInstance
  have : PreservesLimitsOfShape WalkingCospan
      (yoneda : AlgebraicGeometry.BigFppfOver B S hS ⥤
        (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u) := by infer_instance
  have : Q.IsStableUnderBaseChange :=
    MorphismProperty.inverseImage_isStableUnderBaseChange
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS) P
  exact (MorphismProperty.relative_map_iff (F := yoneda) (P := Q)).2 hs

/-- A property of presheaf morphisms respecting isomorphisms passes from `yoneda.map s` to
`pullback.fst q q`, when `s` is a projection of a kernel pair of `q`. -/
private theorem presheafProperty_fst_of_kernelPair
    {C : Type (u + 1)} [Category.{u} C] {G : Cᵒᵖ ⥤ Type u} {U R : C} (q : yoneda.obj U ⟶ G)
    (s t : R ⟶ U) (hQ : IsPullback (yoneda.map s) (yoneda.map t) q q)
    (P : MorphismProperty (Cᵒᵖ ⥤ Type u)) [P.RespectsIso] (hs : P (yoneda.map s)) :
    P (pullback.fst q q) := by
  have hcan := IsPullback.of_hasPullback q q
  have he := IsPullback.isoIsPullback_hom_fst _ _ hQ hcan
  exact (MorphismProperty.arrow_mk_iso_iff P
    (Arrow.isoMk (hQ.isoIsPullback _ _ hcan) (Iso.refl _) (by simp [he]))).mp hs

/-- Two morphisms out of `U` with the same kernel pair `(R, s, t)` have the same relative
base-change-stable properties of their kernel pair projection: the property passes from
`pullback.fst f f` to `pullback.fst q q`. -/
private theorem quotientProjectionProperty_of_kernelPair
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F G : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U R : AlgebraicGeometry.BigFppfOver B S hS}
    (f : yoneda.obj U ⟶ F) (q : yoneda.obj U ⟶ G) (s t : R ⟶ U)
    (hR : IsPullback (yoneda.map s) (yoneda.map t) f f)
    (hQ : IsPullback (yoneda.map s) (yoneda.map t) q q)
    (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange]
    (hP : (MorphismProperty.inverseImage P
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf (pullback.fst f f)) :
    (MorphismProperty.inverseImage P
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf (pullback.fst q q) := by
  let Q := MorphismProperty.inverseImage P
    (AlgebraicGeometry.BigFppfOver.toScheme B S hS)
  have hs : Q.presheaf (yoneda.map s) :=
    presheafProperty_of_kernelPair_projection B S hS f s t hR P hP
  have : Q.IsStableUnderBaseChange :=
    MorphismProperty.inverseImage_isStableUnderBaseChange
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS) P
  have : Q.presheaf.RespectsIso := MorphismProperty.relative_respectsIso Q
  exact presheafProperty_fst_of_kernelPair (P := Q.presheaf) q s t hQ hs

/-- **The stages of the system are quasi-compact and quasi-separated.** For an étale equivalence
relation `(source, target)` on an affine `U` with `R` quasi-compact, the quotient sheaf `U / R`
is a quasi-compact algebraic space (because `U` is affine and the quotient map is a surjective
étale atlas) and is absolutely quasi-separated by Stacks 07S4 (because the kernel pair
projection of the quotient map is quasi-compact). -/
theorem quotient_is_quasiCompact_quasiSeparated
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))
    [HasSheafify (AlgebraicGeometry.BigFppfOver.topology B S hS) (Type u)]
    (U R : AlgebraicGeometry.BigFppfOver B S hS)
    (target source : R ⟶ U)
    (hU : IsAffine ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).obj U))
    (hR : CompactSpace ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).obj R))
    (hEq : IsEquivalenceRelation ((Over.post B.inclusion).map target)
      ((Over.post B.inclusion).map source))
    (ht : AlgebraicGeometry.Space.IsEtale B S hS (yoneda.map target))
    (hs : AlgebraicGeometry.Space.IsEtale B S hS (yoneda.map source)) :
    AlgebraicGeometry.Space.IsQuasiCompactSpace B S hS
      (Stacks.Groupoids.quotientSheaf (AlgebraicGeometry.BigFppfOver.topology B S hS)
        (Over.post B.inclusion) (relation B S hS source target)).obj ∧
    AlgebraicGeometry.Space.IsAbsolutelyQuasiSeparated B S hS hZ
      (Stacks.Groupoids.quotientSheaf (AlgebraicGeometry.BigFppfOver.topology B S hS)
        (Over.post B.inclusion) (relation B S hS source target)).obj := by
  let G := AlgebraicGeometry.BigFppfOver.toScheme B S hS
  let P := MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u}) G
  let : Functor.Full
      (CategoryTheory.yoneda : AlgebraicGeometry.BigFppfOver B S hS ⥤ _) := inferInstance
  let : Functor.Faithful
      (CategoryTheory.yoneda : AlgebraicGeometry.BigFppfOver B S hS ⥤ _) := inferInstance
  let : PreservesLimitsOfShape WalkingCospan
      (CategoryTheory.yoneda : AlgebraicGeometry.BigFppfOver B S hS ⥤ _) := inferInstance
  let : PreservesLimitsOfShape WalkingCospan G := by
    apply comp_preservesLimitsOfShape
  let : MorphismProperty.IsStableUnderBaseChange
      (@Etale.{u} : MorphismProperty Scheme.{u}) := inferInstance
  let : P.IsStableUnderBaseChange := ⟨by
    intro X₁ X₂ X₃ Y₁ f₁ f₂ g₁ g₂ hs hg
    exact MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @Etale) (hs.map G) hg⟩
  have hId : P.presheaf (𝟙 (yoneda.obj R)) := by
    refine ⟨Functor.relativelyRepresentable.of_isIso yoneda _, ?_⟩
    intro A D g fst snd hpb
    have : IsIso (yoneda.map snd) := hpb.isIso_snd_of_isIso
    have : IsIso snd := Yoneda.fullyFaithful.isIso_of_isIso_map snd
    have : IsIso (G.map snd) := Functor.map_isIso G snd
    exact (show Etale (G.map snd) from inferInstance)
  have htScheme : Etale (G.map target) :=
    (MorphismProperty.relative_map_iff (F := yoneda) (P := P)).1 (ht R (𝟙 (yoneda.obj R)) hId)
  have hsScheme : Etale (G.map source) :=
    (MorphismProperty.relative_map_iff (F := yoneda) (P := P)).1 (hs R (𝟙 (yoneda.obj R)) hId)
  have hRelTarget : (relation B S hS source target).target =
      (Over.post B.inclusion).map target := by
    show prod.lift _ _ ≫ prod.fst = _
    exact prod.lift_fst _ _
  have hRelSource : (relation B S hS source target).source =
      (Over.post B.inclusion).map source := by
    show prod.lift _ _ ≫ prod.snd = _
    exact prod.lift_snd _ _
  let : Stacks.Groupoids.IsEtaleEquivalenceRelation
      (relation B S hS source target) := {
    isEquivalenceRelation := by
      rwa [hRelTarget, hRelSource]
    etale_source := by
      rw [hRelSource]
      simpa [Over.post, G, AlgebraicGeometry.BigFppfOver.toScheme,
        AlgebraicGeometry.BigFppfOver.forget] using hsScheme
    etale_target := by
      rw [hRelTarget]
      simpa [Over.post, G, AlgebraicGeometry.BigFppfOver.toScheme,
        AlgebraicGeometry.BigFppfOver.forget] using htScheme
  }
  let : HasSheafify (AlgebraicGeometry.BigFppfOver.topology B S hS) (Type u) :=
    BigFppfOver.hasSheafify_type B S hS
  let Q := (Stacks.Groupoids.quotientSheaf (AlgebraicGeometry.BigFppfOver.topology B S hS)
    (Over.post B.inclusion) (relation B S hS source target)).obj
  let q := quotientMap B S hS source target
  have hqSurj := quotientMap_surjective_unconditional B S hS source target
  have hqEtale := quotientMap_etale_unconditional B S hS source target
  let : CompactSpace (G.obj R) := hR
  let : IsAffine (G.obj U) := hU
  let : CompactSpace (G.obj U) := Scheme.compactSpace_of_isAffine _
  have htQC : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@QuasiCompact.{u} : MorphismProperty Scheme.{u}) G)) (yoneda.map target) := by
    let : MorphismProperty.IsStableUnderBaseChange
        (@QuasiCompact.{u} : MorphismProperty Scheme.{u}) := inferInstance
    let : (MorphismProperty.inverseImage
        (@QuasiCompact.{u} : MorphismProperty Scheme.{u}) G).IsStableUnderBaseChange :=
      MorphismProperty.inverseImage_isStableUnderBaseChange G _
    apply (MorphismProperty.relative_map_iff (F := yoneda) (P :=
      MorphismProperty.inverseImage (@QuasiCompact.{u} : MorphismProperty Scheme.{u}) G)).2
    show QuasiCompact (G.map target)
    infer_instance
  have hqKernel := quotientMap_isPullback B S hS source target
  have hKernelQC : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@QuasiCompact.{u} : MorphismProperty Scheme.{u}) G)) (pullback.fst q q) := by
    let Pqc := MorphismProperty.inverseImage
      (@QuasiCompact.{u} : MorphismProperty Scheme.{u}) G
    let : Pqc.IsStableUnderBaseChange :=
      MorphismProperty.inverseImage_isStableUnderBaseChange G _
    let : Pqc.presheaf.RespectsIso := MorphismProperty.relative_respectsIso Pqc
    exact presheafProperty_fst_of_kernelPair q target source hqKernel Pqc.presheaf htQC
  have hqEtale' : AlgebraicGeometry.Space.IsEtale B S hS q := by
    let : MorphismProperty.IsStableUnderComposition
        (@Etale.{u} : MorphismProperty Scheme.{u}) :=
      (inferInstance : MorphismProperty.IsMultiplicative
        (@Etale.{u} : MorphismProperty Scheme.{u})).toIsStableUnderComposition
    let : P.IsStableUnderComposition :=
      MorphismProperty.IsStableUnderComposition.inverseImage G
    let : P.presheaf.IsStableUnderComposition :=
      MorphismProperty.relative_isStableUnderComposition P
    intro V ψ hψ
    exact MorphismProperty.comp_mem P.presheaf ψ q hψ hqEtale
  refine ⟨⟨U, q, inferInstance, hqSurj, hqEtale'⟩, ?_⟩
  exact AlgebraicGeometry.Space.isQuasiSeparated_of_etaleAtlas_quasiCompact_projection
    B S hS hZ Q (isAlgebraicSpace_quotient_unconditional B S hS source target)
    ⟨U, q, inferInstance, hqSurj, hqEtale, Or.inl hKernelQC⟩

/-- In a finite type with a symmetric relation, two points joined by a reflexive-transitive chain
are joined by a chain of length less than the cardinality of the type: take a walk in the
associated simple graph and bypass it to a path. -/
private theorem exists_bounded_chain_of_reflTransGen
    {α : Type*} [Fintype α] (r : α → α → Prop) (hs : ∀ ⦃a b⦄, r a b → r b a)
    {x y : α} (hxy : Relation.ReflTransGen r x y) :
    ∃ (n : ℕ), n < Fintype.card α ∧ ∃ a : Fin (n + 1) → α,
      a 0 = x ∧ a (Fin.last n) = y ∧
        ∀ i : Fin n, r (a i.castSucc) (a i.succ) := by
  classical
  let G : SimpleGraph α := {
    Adj a b := r a b ∧ a ≠ b
    symm := ⟨fun _ _ h => ⟨hs h.1, h.2.symm⟩⟩
    loopless := ⟨fun a h => h.2 rfl⟩ }
  have hw : Nonempty (G.Walk x y) := by
    induction hxy with
    | refl => exact ⟨.nil⟩
    | @tail b c hbc h ih =>
      obtain ⟨p⟩ := ih
      by_cases heq : b = c
      · subst c
        exact ⟨p⟩
      · exact ⟨p.concat ⟨h, heq⟩⟩
  obtain ⟨p⟩ := hw
  let q := p.bypass
  refine ⟨q.length, p.bypass_isPath.length_lt, fun i => q.getVert i, ?_, ?_, ?_⟩
  · exact q.getVert_zero
  · exact q.getVert_length
  · intro i
    exact (q.adj_getVert_succ i.isLt).1

/-- If a symmetric relation `r` is constant on the fibres of `f` and the fibre through `x` has at
most `N` elements, two `r`-connected points are joined by a chain of fewer than `N` steps. This
is the shortening argument: a long chain repeats a point of the fibre. -/
private theorem exists_bounded_chain_in_fiber
    {α β : Type*} (f : α → β) (r : α → α → Prop)
    (hs : ∀ ⦃a b⦄, r a b → r b a)
    (hf : ∀ ⦃a b⦄, r a b → f a = f b)
    {x y : α} [hfinite : Finite {a // f a = f x}] {N : ℕ}
    (hN : Nat.card {a // f a = f x} ≤ N)
    (hxy : Relation.ReflTransGen r x y) :
    ∃ n < N, ∃ a : Fin (n + 1) → α,
      a 0 = x ∧ a (Fin.last n) = y ∧
        ∀ i : Fin n, r (a i.castSucc) (a i.succ) := by
  classical
  let V := {a // f a = f x}
  let r' : V → V → Prop := fun a b => r a.val b.val
  have lift : ∃ hy : f y = f x,
      Relation.ReflTransGen r' ⟨x, rfl⟩ ⟨y, hy⟩ := by
    induction hxy with
    | refl => exact ⟨rfl, .refl⟩
    | @tail b c hbc h ih =>
      obtain ⟨hb, ih⟩ := ih
      exact ⟨(hf h).symm.trans hb, .tail ih h⟩
  obtain ⟨hy, hxy'⟩ := lift
  let : Fintype V := Fintype.ofFinite V
  obtain ⟨n, hn, a, ha, hb, hr⟩ :=
    exists_bounded_chain_of_reflTransGen r' (fun {_ _} h => hs h) hxy'
  refine ⟨n, hn.trans_le ?_, fun i => (a i).val,
    congrArg Subtype.val ha, congrArg Subtype.val hb, hr⟩
  simpa only [Nat.card_eq_fintype_card] using hN

/-- A chain of `n ≤ N` steps for a reflexive relation can be padded to a chain of exactly `N` steps
with the same endpoints, by repeating the last point. -/
private theorem exists_padded_chain
    {α : Type*} (r : α → α → Prop) (hr : ∀ a, r a a)
    {n N : ℕ} (hn : n ≤ N) (a : Fin (n + 1) → α)
    (ha : ∀ i : Fin n, r (a i.castSucc) (a i.succ)) :
    ∃ b : Fin (N + 1) → α, b 0 = a 0 ∧ b (Fin.last N) = a (Fin.last n) ∧
      ∀ i : Fin N, r (b i.castSucc) (b i.succ) := by
  let t : Fin (N + 1) → Fin (n + 1) := fun i => ⟨min i.val n, by omega⟩
  refine ⟨a ∘ t, ?_, ?_, ?_⟩
  · have : t 0 = 0 := by ext; simp [t]
    exact congrArg a this
  · have : t (Fin.last N) = Fin.last n := by ext; simp [t, Nat.min_eq_right hn]
    exact congrArg a this
  · intro i
    by_cases hi : i.val < n
    · let j : Fin n := ⟨i.val, hi⟩
      have h₀ : t i.castSucc = j.castSucc := by ext; simp [t, j, Nat.min_eq_left hi.le]
      have h₁ : t i.succ = j.succ := by ext; simp [t, j, Nat.min_eq_left hi]
      simpa only [Function.comp_apply, h₀, h₁] using ha j
    · have h₀ : t i.castSucc = Fin.last n := by
        ext; simp [t, Nat.min_eq_right (by omega : n ≤ i.val)]
      have h₁ : t i.succ = Fin.last n := by
        ext; simp [t, Nat.min_eq_right (by omega : n ≤ i.val + 1)]
      simpa only [Function.comp_apply, h₀, h₁] using hr (a (Fin.last n))

/-- A chain of `r`-steps joins its endpoints by `Relation.ReflTransGen r`. -/
private theorem reflTransGen_of_chain
    {α : Type*} {r : α → α → Prop} {n : ℕ} (a : Fin (n + 1) → α)
    (ha : ∀ i : Fin n, r (a i.castSucc) (a i.succ)) :
    Relation.ReflTransGen r (a 0) (a (Fin.last n)) := by
  have h : ∀ i : Fin (n + 1), Relation.ReflTransGen r (a 0) (a i) := by
    intro i
    induction i using Fin.induction with
    | zero => exact .refl
    | succ i ih => exact .tail ih (ha i)
  exact h _

/-- If `r` is reflexive, symmetric and constant on the fibres of `f`, and those fibres have at most
`N` elements, then the equivalence relation generated by `r` is exactly "joined by a chain of
`N` steps in `r`". This is what makes the iterates of an open relation stabilise. -/
theorem eqvGen_iff_bounded_chain
    {α β : Type*} (f : α → β) (r : α → α → Prop)
    (hr : ∀ a, r a a) (hs : ∀ ⦃a b⦄, r a b → r b a)
    (hf : ∀ ⦃a b⦄, r a b → f a = f b)
    {x y : α} [hfinite : Finite {a // f a = f x}] {N : ℕ}
    (hN : Nat.card {a // f a = f x} ≤ N) :
    Relation.EqvGen r x y ↔ ∃ a : Fin (N + 1) → α,
      a 0 = x ∧ a (Fin.last N) = y ∧
        ∀ i : Fin N, r (a i.castSucc) (a i.succ) := by
  let : Std.Symm r := ⟨fun _ _ h => hs h⟩
  constructor
  · intro h
    have h' : Relation.ReflTransGen r x y := by
      clear hN hf hr hfinite f N
      induction h with
      | rel a b h => exact .single h
      | refl a => exact .refl
      | symm a b h ih => exact symm ih
      | trans a b c hab hbc ih₁ ih₂ => exact ih₁.trans ih₂
    obtain ⟨n, hn, a, hx, hy, ha⟩ := exists_bounded_chain_in_fiber f r hs hf hN h'
    obtain ⟨b, hb₀, hb₁, hb⟩ := exists_padded_chain r hr hn.le a ha
    exact ⟨b, hb₀.trans hx, hb₁.trans hy, hb⟩
  · rintro ⟨a, hx, hy, ha⟩
    have h : Relation.ReflTransGen r x y := by
      rw [← hx, ← hy]
      exact reflTransGen_of_chain a ha
    clear hN a hx hy ha hr hf hfinite f N
    induction h with
    | refl => exact .refl _
    | tail hab h ih => exact .trans _ _ _ ih (.rel _ _ h)

/-- Under the hypotheses of `eqvGen_iff_bounded_chain`, "joined by a chain of `N` steps in `r`" is
itself an equivalence relation, being the equivalence generated by `r`. -/
theorem equivalence_bounded_chains
    {α β : Type*} (f : α → β) (r : α → α → Prop)
    (hr : ∀ a, r a a) (hs : ∀ ⦃a b⦄, r a b → r b a)
    (hf : ∀ ⦃a b⦄, r a b → f a = f b)
    [∀ x, Finite {a // f a = f x}] {N : ℕ}
    (hN : ∀ x, Nat.card {a // f a = f x} ≤ N) :
    Equivalence (fun x y => ∃ a : Fin (N + 1) → α,
      a 0 = x ∧ a (Fin.last N) = y ∧
        ∀ i : Fin N, r (a i.castSucc) (a i.succ)) := by
  have heq : (fun x y => ∃ a : Fin (N + 1) → α,
      a 0 = x ∧ a (Fin.last N) = y ∧
        ∀ i : Fin N, r (a i.castSucc) (a i.succ)) = Relation.EqvGen r := by
    funext x y
    exact propext (eqvGen_iff_bounded_chain f r hr hs hf (hN x)).symm
  rw [heq]
  exact Relation.EqvGen.is_equivalence r

/-- In a prespectral space, if every quasi-compact open is contained in an open satisfying `P`,
then so is every compact set. -/
private theorem exists_open_envelope_of_isCompact
    {X : Type*} [TopologicalSpace X] [PrespectralSpace X]
    (P : TopologicalSpace.Opens X → Prop)
    (hP : ∀ U : TopologicalSpace.Opens X, IsCompact (U : Set X) → ∃ V, P V ∧ U ≤ V)
    {K : Set X} (hK : IsCompact K) :
    ∃ V : TopologicalSpace.Opens X, P V ∧ K ⊆ V := by
  obtain ⟨U, hUc, hUo, hKU, _⟩ :=
    PrespectralSpace.exists_isCompact_and_isOpen_between hK isOpen_univ (Set.subset_univ _)
  obtain ⟨V, hV, hUV⟩ := hP ⟨U, hUo⟩ hUc
  exact ⟨V, hV, hKU.trans hUV⟩

/-- The opens satisfying `P` are directed by inclusion, when each of them is quasi-compact and
every quasi-compact open is contained in one of them. -/
theorem open_envelopes_directed
    {X : Type*} [TopologicalSpace X] (P : TopologicalSpace.Opens X → Prop)
    (hqc : ∀ U, P U → IsCompact (U : Set X))
    (hP : ∀ U : TopologicalSpace.Opens X, IsCompact (U : Set X) → ∃ V, P V ∧ U ≤ V) :
    Directed (· ≤ ·) (fun U : {U : TopologicalSpace.Opens X // P U} => U.val) := by
  intro U V
  obtain ⟨W, hW, hle⟩ := hP (U.val ⊔ V.val) ((hqc _ U.property).union (hqc _ V.property))
  exact ⟨⟨W, hW⟩, le_sup_left.trans hle, le_sup_right.trans hle⟩

/-- The opens satisfying `P` cover the whole prespectral space, when every quasi-compact open is
contained in one of them. -/
theorem open_envelopes_iSup_eq_top
    {X : Type*} [TopologicalSpace X] [PrespectralSpace X]
    (P : TopologicalSpace.Opens X → Prop)
    (hP : ∀ U : TopologicalSpace.Opens X, IsCompact (U : Set X) → ∃ V, P V ∧ U ≤ V) :
    (⨆ U : {U : TopologicalSpace.Opens X // P U}, U.val) = ⊤ := by
  apply top_le_iff.mp
  intro x _
  obtain ⟨V, hV, hx⟩ := exists_open_envelope_of_isCompact P hP (isCompact_singleton (x := x))
  exact (le_iSup (fun U : {U : TopologicalSpace.Opens X // P U} => U.val) ⟨V, hV⟩)
    (hx (Set.mem_singleton x))

/-- The `Category.{0}` structure on a preorder `I`, with `PLift (i ≤ j)` as the morphisms from `i`
to `j`. This is what makes the index set of the system an object of `Cat.{0, u}`. -/
@[instance_reducible,
  sga "4 I 8.1.5"]
noncomputable def smallPreorderCategory (I : Type*) [Preorder I] :
    Category.{0} I where
  Hom i j := PLift (i ≤ j)
  id i := ⟨le_refl i⟩
  comp f g := ⟨f.down.trans g.down⟩

/-- A nonempty directed preorder, regarded as a category by `smallPreorderCategory`, is
filtered. -/
theorem smallPreorderCategory_isFiltered
    (I : Type*) [Preorder I] [Nonempty I]
    (hd : ∀ i j : I, ∃ k, i ≤ k ∧ j ≤ k) :
    @IsFiltered I (smallPreorderCategory I) := by
  let := smallPreorderCategory I
  refine {
    cocone_objs := ?_
    cocone_maps := ?_ }
  · intro i j
    obtain ⟨k, hi, hj⟩ := hd i j
    exact ⟨k, ⟨hi⟩, ⟨hj⟩, trivial⟩
  · intro i j f g
    exact ⟨j, 𝟙 j, rfl⟩

/-- A morphism out of a quasi-compact scheme factors through some open subscheme satisfying `P`,
when every quasi-compact open is contained in one satisfying `P`. -/
theorem exists_factorization_through_open_envelope
    {T R : Scheme.{u}} [CompactSpace T] (f : T ⟶ R) (P : R.Opens → Prop)
    (hP : ∀ U : R.Opens, IsCompact (U : Set R) → ∃ V, P V ∧ U ≤ V) :
    ∃ V : R.Opens, P V ∧ ∃ g : T ⟶ V, g ≫ V.ι = f := by
  obtain ⟨V, hV, hfV⟩ := exists_open_envelope_of_isCompact P hP
    (isCompact_range f.continuous)
  let W : R.Opens := V
  have h : Set.range f ⊆ Set.range W.ι := by simpa [W] using hfV
  exact ⟨W, hV, IsOpenImmersion.lift W.ι f h, IsOpenImmersion.lift_fac _ _ _⟩

universe u₁ u₂ v₁ v₂

/-- **The colimit identification.** A cocone `c` on a filtered diagram `D` is a colimit as soon as
its vertex is the coequalizer of `s, t : R ⟶ U` with projection `q`, each `D.obj i` is the
coequalizer of `sᵢ, tᵢ : Rᵢ ⟶ U` with projection `qᵢ`, these projections are compatible with
the transition maps and with `q`, and the relations `sᵢ, tᵢ` jointly generate `s, t`. Applied to
`X = U / R` and the stages `U / R'`. -/
noncomputable def isColimit_of_common_quotient
    {C : Type u₁} [Category.{v₁} C] {I : Type u₂} [Category.{v₂} I] [IsFiltered I]
    {U R : C} (s t : R ⟶ U) (D : I ⥤ C) (c : Cocone D)
    (Ri : I → C) (si ti : ∀ i, Ri i ⟶ U)
    (q : U ⟶ c.pt) (qi : ∀ i, U ⟶ D.obj i)
    (hw : s ≫ q = t ≫ q) (hwi : ∀ i, si i ≫ qi i = ti i ≫ qi i)
    (hq : IsColimit (Cofork.ofπ q hw))
    (hqi : ∀ i, IsColimit (Cofork.ofπ (qi i) (hwi i)))
    (hqι : ∀ i, qi i ≫ c.ι.app i = q)
    (hqi_map : ∀ {i j} (f : i ⟶ j), qi i ≫ D.map f = qi j)
    (hgen : ∀ (Y : C) (a : U ⟶ Y),
      (∀ i, si i ≫ a = ti i ≫ a) → s ≫ a = t ≫ a) : IsColimit c := by
  classical
  let i₀ : I := Classical.choice IsFiltered.nonempty
  have hcommon (b : Cocone D) (i j : I) :
      qi i ≫ b.ι.app i = qi j ≫ b.ι.app j := by
    obtain ⟨k, f, g, _⟩ := IsFilteredOrEmpty.cocone_objs i j
    calc
      qi i ≫ b.ι.app i = qi i ≫ D.map f ≫ b.ι.app k := by rw [b.w f]
      _ = qi k ≫ b.ι.app k := by rw [← Category.assoc, hqi_map]
      _ = qi j ≫ D.map g ≫ b.ι.app k := by rw [← Category.assoc, hqi_map]
      _ = qi j ≫ b.ι.app j := by rw [b.w g]
  let a (b : Cocone D) := qi i₀ ≫ b.ι.app i₀
  have ha (b : Cocone D) : s ≫ a b = t ≫ a b := by
    apply hgen
    intro i
    rw [show a b = qi i ≫ b.ι.app i from hcommon b i₀ i]
    simp only [← Category.assoc, hwi]
  refine {
    desc := fun b => hq.desc (Cofork.ofπ (a b) (ha b))
    fac := ?_
    uniq := ?_ }
  · intro b i
    apply Cofork.IsColimit.hom_ext (hqi i)
    change qi i ≫ (c.ι.app i ≫ hq.desc (Cofork.ofπ (a b) (ha b))) = qi i ≫ b.ι.app i
    have hd : q ≫ hq.desc (Cofork.ofπ (a b) (ha b)) = a b :=
      Cofork.IsColimit.π_desc hq
    rw [← Category.assoc, hqι, hd]
    exact hcommon b i₀ i
  · intro b m hm
    apply Cofork.IsColimit.hom_ext hq
    change q ≫ m = q ≫ hq.desc (Cofork.ofπ (a b) (ha b))
    have hd : q ≫ hq.desc (Cofork.ofπ (a b) (ha b)) = a b :=
      Cofork.IsColimit.π_desc hq
    rw [hd, ← hqι i₀, Category.assoc, hm]

end ReasonableApproximation

