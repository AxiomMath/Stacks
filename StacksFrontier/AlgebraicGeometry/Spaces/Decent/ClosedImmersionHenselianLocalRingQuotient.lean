module

public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.ClosedImmersionElementaryEtaleChart
public import StacksFrontier.RingTheory.Henselian.HenselizationQuotientIndependentUniverses

/-!
# The henselian local ring of a closed subspace is a quotient of the ambient one

Let `f : X' ⟶ X` be a closed immersion of decent algebraic spaces over `S` and let `ξ` be a
point of `X'`. Then

  `𝒪^h_{X', ξ} ≅ 𝒪^h_{X, f(ξ)} / I`

for `I` the ideal generated by the kernel of a surjective Zariski stalk map of étale charts.
Concretely, for any elementary étale neighborhood `V` of `f(ξ)` in `X` there are an elementary
étale neighborhood `U` of `ξ` in `X'` and a morphism `j : U.scheme ⟶ V.scheme` over `f` whose
stalk map `α : 𝒪_{V, V.point} ⟶ 𝒪_{U, U.point}` is surjective
(`AlgebraicGeometry.Space.exists_elementaryEtaleNeighborhood_surjective_stalkMap`), and `I` is
the image of `ker α` in `𝒪^h_{X, f(ξ)}`.

The ring-theoretic half is Stacks 05WQ followed by the uniqueness of Lemma 08HT, in the form
`IsLocalRing.IsHenselization.exists_ringEquiv_quotient_of_isHenselization`: `𝒪^h_{X, f(ξ)}` is a
henselization of `𝒪_{V, V.point}` and `𝒪^h_{X', ξ}` is a henselization of `𝒪_{U, U.point}`, both
by Stacks 0EMY in the form `AlgebraicGeometry.Space.henselianLocalRing_isHenselization`, and a
henselization of a quotient of a local ring is the corresponding quotient of a henselization of
that ring.

## Main results

* `AlgebraicGeometry.Space.exists_ringEquiv_henselianLocalRing_quotient_stalkToHenselianLocalRing`:
  the isomorphism for *given* charts `U`, `V` and a given morphism `j` between them surjective on
  stalks, asking nothing of the two spaces beyond that, **together with its behaviour on the
  image of the chart stalk**: the class of the image of a germ `a` goes to the image of its
  restriction `α a`.
* `AlgebraicGeometry.Space`
  `.exists_ringEquiv_henselianLocalRing_quotient_stalkToHenselianLocalRing_rep_snd`: the same at
  the base-change chart.
* `AlgebraicGeometry.Space.ringEquiv_henselianLocalRing_quotient_of_surjective_stalkMap`: the
  first of these with that behaviour forgotten.
* `AlgebraicGeometry.Space.ringEquiv_henselianLocalRing_quotient_ker_stalkMap_rep_snd`: the same
  at the base-change chart `V ×_X X'` of
  `AlgebraicGeometry.Space.closedImmersionBaseChangeNeighborhood` and its projection, so that
  the ideal is the one cutting the closed subspace out of the chart.
* `AlgebraicGeometry.Space.exists_ringEquiv_henselianLocalRing_quotient_of_isClosedImmersion`:
  the isomorphism above, together with the chart square and the surjection it comes from, with
  the chart and the morphism quantified existentially.

## References

* [Stacks Project, Tag 05WQ](https://stacks.math.columbia.edu/tag/05WQ)
* [Stacks Project, Tag 08HT](https://stacks.math.columbia.edu/tag/08HT)
* [Stacks Project, Tag 0EMY](https://stacks.math.columbia.edu/tag/0EMY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The Zariski stalk map of the projection `V ×_X X' ⟶ V` at a point over `V.point`, read from
the stalk at `V.point`, is surjective. -/
private theorem surjective_stalkCongr_comp_stalkMap_rep_snd
    {X X' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hX : IsAlgebraicSpace B S hS X} {f : X' ⟶ X}
    (hf : IsClosedImmersion B S hS f) {x : points B S hS X}
    (V : ElementaryEtaleNeighborhood B S hS X hX x) (w : (hf.rep.pullback V.toSpace).left.1)
    (hpw : (hf.rep.snd V.toSpace).left.1 w = V.point) :
    Function.Surjective ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hpw.symm)).hom ≫
      (hf.rep.snd V.toSpace).left.1.stalkMap w).hom := by
  have hb : Function.Bijective
      ((V.scheme.left.1.presheaf.stalkCongr (Inseparable.of_eq hpw.symm)).hom : _ ⟶ _).hom :=
    ConcreteCategory.bijective_of_isIso _
  rw [CommRingCat.hom_comp]
  exact (surjective_stalkMap_rep_snd B S hS hf V w).comp hb.2

/-- **A surjective stalk map of elementary étale charts presents one henselian local ring as a
quotient of the other, compatibly with the chart sections.** Let `V` be an elementary étale
neighborhood of a point `x` of `X`, let `U` be an elementary étale neighborhood of a point `ξ`
of `X'`, and let `j : U.scheme ⟶ V.scheme` carry the distinguished point to the distinguished
point with surjective Zariski stalk map `α`. Then there is a ring isomorphism

  `𝒪^h_{X, x} / (ker α) · 𝒪^h_{X, x} ≅ 𝒪^h_{X', ξ}`

which carries the class of the image in `𝒪^h_{X, x}` of a germ `a` at `V.point` to the image in
`𝒪^h_{X', ξ}` of its restriction `α a` to the chart `U`. -/
theorem exists_ringEquiv_henselianLocalRing_quotient_stalkToHenselianLocalRing
    {X X' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hX' : IsAlgebraicSpace B S hS X') (hX'd : IsDecentSpace B S hS X')
    {ξ : points B S hS X'} {x : points B S hS X}
    (V : ElementaryEtaleNeighborhood B S hS X hX x)
    (U : ElementaryEtaleNeighborhood B S hS X' hX' ξ) (j : U.scheme ⟶ V.scheme)
    (hj : j.left.1 U.point = V.point)
    (hsurj : Function.Surjective ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
      j.left.1.stalkMap U.point).hom) :
    ∃ e : ((henselianLocalRing B S hS X hX x hXd : Type (u + 1)) ⧸
          (RingHom.ker ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
            j.left.1.stalkMap U.point).hom).map
            (stalkToHenselianLocalRing B S hS X hX x hXd V)) ≃+*
        (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1)),
      ∀ a : V.scheme.left.1.presheaf.stalk V.point,
        e (Ideal.Quotient.mk _ (stalkToHenselianLocalRing B S hS X hX x hXd V a)) =
          stalkToHenselianLocalRing B S hS X' hX' ξ hX'd U
            (((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
              j.left.1.stalkMap U.point).hom a) := by
  let : IsLocalRing (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    henselianLocalRing_isLocalRing B S hS X hX x hXd
  let : IsLocalRing (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1)) :=
    henselianLocalRing_isLocalRing B S hS X' hX' ξ hX'd
  let : Algebra (V.scheme.left.1.presheaf.stalk V.point)
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    stalkAlgebra B S hS X hX x hXd V
  let : Algebra (U.scheme.left.1.presheaf.stalk U.point)
      (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1)) :=
    stalkAlgebra B S hS X' hX' ξ hX'd U
  let : IsHenselization (V.scheme.left.1.presheaf.stalk V.point)
      (ResidueField (V.scheme.left.1.presheaf.stalk V.point))
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    henselianLocalRing_isHenselization B S hS X hX x hXd V
  let : IsHenselization (U.scheme.left.1.presheaf.stalk U.point)
      (ResidueField (U.scheme.left.1.presheaf.stalk U.point))
      (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1)) :=
    henselianLocalRing_isHenselization B S hS X' hX' ξ hX'd U
  let : Algebra (V.scheme.left.1.presheaf.stalk V.point)
      (U.scheme.left.1.presheaf.stalk U.point) :=
    ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
      j.left.1.stalkMap U.point).hom.toAlgebra
  exact IsHenselization.exists_ringEquiv_quotient_algebraMap_of_isHenselization
    (R := V.scheme.left.1.presheaf.stalk V.point) hsurj
    (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1))

/-- **A surjective stalk map of elementary étale charts presents one henselian local ring as a
quotient of the other.** Let `V` be an elementary étale neighborhood of a point `x` of `X`, let
`U` be an elementary étale neighborhood of a point `ξ` of `X'`, and let `j : U.scheme ⟶ V.scheme`
carry the distinguished point to the distinguished point with surjective Zariski stalk map `α`.
Then

  `𝒪^h_{X', ξ} ≅ 𝒪^h_{X, x} / (ker α) · 𝒪^h_{X, x}`. -/
theorem ringEquiv_henselianLocalRing_quotient_of_surjective_stalkMap
    {X X' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hX' : IsAlgebraicSpace B S hS X') (hX'd : IsDecentSpace B S hS X')
    {ξ : points B S hS X'} {x : points B S hS X}
    (V : ElementaryEtaleNeighborhood B S hS X hX x)
    (U : ElementaryEtaleNeighborhood B S hS X' hX' ξ) (j : U.scheme ⟶ V.scheme)
    (hj : j.left.1 U.point = V.point)
    (hsurj : Function.Surjective ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
      j.left.1.stalkMap U.point).hom) :
    Nonempty (((henselianLocalRing B S hS X hX x hXd : Type (u + 1)) ⧸
          (RingHom.ker ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
            j.left.1.stalkMap U.point).hom).map
            (stalkToHenselianLocalRing B S hS X hX x hXd V)) ≃+*
      (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1))) :=
  let ⟨e, _⟩ := exists_ringEquiv_henselianLocalRing_quotient_stalkToHenselianLocalRing B S hS hX
    hXd hX' hX'd V U j hj hsurj
  ⟨e⟩

/-- **The henselian local ring of a closed subspace is the quotient of the ambient one by the
ideal of the base-change chart.** Let `f : X' ⟶ X` be a closed immersion of decent algebraic
spaces over `S`, let `V` be an elementary étale neighborhood of a point `x` of `X`, and let `w`
be a point of the base change `V ×_X X'` lying over the distinguished point of `V` and over a
point `ξ` of `X'`. Then

  `𝒪^h_{X', ξ} ≅ 𝒪^h_{X, x} / I`,  `I = (ker 𝒪_{V, V.point} ⟶ 𝒪_{V ×_X X', w}) · 𝒪^h_{X, x}`. -/
theorem ringEquiv_henselianLocalRing_quotient_ker_stalkMap_rep_snd
    {X X' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hX' : IsAlgebraicSpace B S hS X') (hX'd : IsDecentSpace B S hS X')
    {f : X' ⟶ X} (hf : IsClosedImmersion B S hS f) {ξ : points B S hS X'}
    {x : points B S hS X} (V : ElementaryEtaleNeighborhood B S hS X hX x)
    (w : (hf.rep.pullback V.toSpace).left.1)
    (hw : pointsMap B S hS (yoneda.obj (hf.rep.pullback V.toSpace)) (hf.rep.fst V.toSpace)
      (presheafPoint B S hS (hf.rep.pullback V.toSpace) w
        (B.residueField_spec_contains (hf.rep.pullback V.toSpace).left.property w)) = ξ)
    (hpw : (hf.rep.snd V.toSpace).left.1 w = V.point) :
    Nonempty (((henselianLocalRing B S hS X hX x hXd : Type (u + 1)) ⧸
          (RingHom.ker ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hpw.symm)).hom ≫
            (hf.rep.snd V.toSpace).left.1.stalkMap w).hom).map
            (stalkToHenselianLocalRing B S hS X hX x hXd V)) ≃+*
      (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1))) :=
  ringEquiv_henselianLocalRing_quotient_of_surjective_stalkMap B S hS hX hXd hX' hX'd V
    (closedImmersionBaseChangeNeighborhood B S hS hX' hf V w hw hpw) (hf.rep.snd V.toSpace) hpw
    (surjective_stalkCongr_comp_stalkMap_rep_snd B S hS hf V w hpw)

/-- **The henselian local ring of a closed subspace is the quotient of the ambient one by the
ideal of the base-change chart, compatibly with the chart sections.** This is
`AlgebraicGeometry.Space.ringEquiv_henselianLocalRing_quotient_ker_stalkMap_rep_snd` with the
behaviour of the isomorphism recorded: the class of the image in `𝒪^h_{X, x}` of a germ `a` at
`V.point` goes to the image in `𝒪^h_{X', ξ}` of the restriction of `a` to the base-change chart
`V ×_X X'`. -/
theorem exists_ringEquiv_henselianLocalRing_quotient_stalkToHenselianLocalRing_rep_snd
    {X X' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hX' : IsAlgebraicSpace B S hS X') (hX'd : IsDecentSpace B S hS X')
    {f : X' ⟶ X} (hf : IsClosedImmersion B S hS f) {ξ : points B S hS X'}
    {x : points B S hS X} (V : ElementaryEtaleNeighborhood B S hS X hX x)
    (w : (hf.rep.pullback V.toSpace).left.1)
    (hw : pointsMap B S hS (yoneda.obj (hf.rep.pullback V.toSpace)) (hf.rep.fst V.toSpace)
      (presheafPoint B S hS (hf.rep.pullback V.toSpace) w
        (B.residueField_spec_contains (hf.rep.pullback V.toSpace).left.property w)) = ξ)
    (hpw : (hf.rep.snd V.toSpace).left.1 w = V.point) :
    ∃ e : ((henselianLocalRing B S hS X hX x hXd : Type (u + 1)) ⧸
          (RingHom.ker ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hpw.symm)).hom ≫
            (hf.rep.snd V.toSpace).left.1.stalkMap w).hom).map
            (stalkToHenselianLocalRing B S hS X hX x hXd V)) ≃+*
        (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1)),
      ∀ a : V.scheme.left.1.presheaf.stalk V.point,
        e (Ideal.Quotient.mk _ (stalkToHenselianLocalRing B S hS X hX x hXd V a)) =
          stalkToHenselianLocalRing B S hS X' hX' ξ hX'd
            (closedImmersionBaseChangeNeighborhood B S hS hX' hf V w hw hpw)
            (((V.scheme.left.1.presheaf.stalkCongr (.of_eq hpw.symm)).hom ≫
              (hf.rep.snd V.toSpace).left.1.stalkMap w).hom a) :=
  exists_ringEquiv_henselianLocalRing_quotient_stalkToHenselianLocalRing B S hS hX hXd hX' hX'd V
    (closedImmersionBaseChangeNeighborhood B S hS hX' hf V w hw hpw) (hf.rep.snd V.toSpace) hpw
    (surjective_stalkCongr_comp_stalkMap_rep_snd B S hS hf V w hpw)

/-- **The henselian local ring of a closed subspace is a quotient of the ambient one.** Let
`f : X' ⟶ X` be a closed immersion of decent algebraic spaces over `S`, let `ξ` be a point of
`X'` and let `V` be an elementary étale neighborhood of `f(ξ)` in `X`. There are an elementary
étale neighborhood `U` of `ξ` in `X'` and a morphism of schemes `j : U.scheme ⟶ V.scheme` over
`f` carrying the distinguished point to the distinguished point, whose Zariski stalk map `α` is
surjective, such that `𝒪^h_{X', ξ}` is the quotient of `𝒪^h_{X, f(ξ)}` by the ideal generated by
the image of `ker α`.

This is the existential reading of
`AlgebraicGeometry.Space.ringEquiv_henselianLocalRing_quotient_ker_stalkMap_rep_snd`, which
names `U` and `j` as the base-change chart and its projection. -/
theorem exists_ringEquiv_henselianLocalRing_quotient_of_isClosedImmersion
    {X X' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hX' : IsAlgebraicSpace B S hS X') (hX'd : IsDecentSpace B S hS X')
    (f : X' ⟶ X) (hf : IsClosedImmersion B S hS f) (ξ : points B S hS X')
    (V : ElementaryEtaleNeighborhood B S hS X hX (pointsMap B S hS X' f ξ)) :
    ∃ (U : ElementaryEtaleNeighborhood B S hS X' hX' ξ) (j : U.scheme ⟶ V.scheme)
      (hj : j.left.1 U.point = V.point),
      yoneda.map j ≫ V.toSpace = U.toSpace ≫ f ∧
        Function.Surjective ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
          j.left.1.stalkMap U.point).hom ∧
        Nonempty (((henselianLocalRing B S hS X hX (pointsMap B S hS X' f ξ) hXd :
              Type (u + 1)) ⧸
            (RingHom.ker ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
              j.left.1.stalkMap U.point).hom).map
              (stalkToHenselianLocalRing B S hS X hX (pointsMap B S hS X' f ξ) hXd V)) ≃+*
          (henselianLocalRing B S hS X' hX' ξ hX'd : Type (u + 1))) := by
  obtain ⟨w, hw, hpw⟩ := exists_point_closedImmersionBaseChangeNeighborhood B S hS hX hX' hX'd
    f hf ξ _ rfl V
  exact ⟨closedImmersionBaseChangeNeighborhood B S hS hX' hf V w hw hpw,
    hf.rep.snd V.toSpace, hpw, (hf.rep.w V.toSpace).symm,
    surjective_stalkCongr_comp_stalkMap_rep_snd B S hS hf V w hpw,
    ringEquiv_henselianLocalRing_quotient_ker_stalkMap_rep_snd B S hS hX hXd hX' hX'd hf V w hw hpw⟩

end AlgebraicGeometry.Space

end
