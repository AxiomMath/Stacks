variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hdec : IsDecentSpace B S hS X) (Z : PrimeDivisor B S hS X)
    (L : Modules.{u, u} B S hS X hX) (hL : IsInvertibleModule (B := B) ⟨X, hX⟩ L)

/-! ### The coefficient of a global section against `s_ξ` -/

/-- **The coefficient of a global section against the generator `s_ξ`.** The chart section over
`Spec(𝒪_{U, u})` of the pullback of `s|_U` is `a • s_ξ` for exactly one regular function `a` on
`Spec(𝒪_{U, u})`, the generator being free. -/
def PrimeDivisor.globalSectionStalkCoefficient (s : L.sections) :
    chartRing B S hS (Z.genericStalkSpace B S hS hX hdec).1
      (Z.genericStalkSpace B S hS hX hdec).2 (Z.genericStalkChart B S hS hX hdec) :=
  (Equiv.ofBijective _ (Z.bijective_smul_genericStalkGenerator B S hS hX hdec L hL
    (Z.genericStalkChart B S hS hX hdec) (𝟙 (Z.genericStalkChart B S hS hX hdec)))).symm
    (modulePullbackChartSection B S hS (Z.genericStalkMorphism B S hS hX hdec) L
      (Z.genericStalkChartDiagram B S hS hX hdec)
      (s.eval (op (Z.genericEtaleChart B S hS hX hdec))))

/-- The defining property of the coefficient of a global section. -/
theorem PrimeDivisor.globalSectionStalkCoefficient_spec (s : L.sections) :
    modulePullbackChartSection B S hS (Z.genericStalkMorphism B S hS hX hdec) L
        (Z.genericStalkChartDiagram B S hS hX hdec)
        (s.eval (op (Z.genericEtaleChart B S hS hX hdec))) =
      Z.globalSectionStalkCoefficient B S hS hX hdec L hL s •
        Z.genericStalkGenerator B S hS hX hdec L hL (Z.genericStalkChart B S hS hX hdec)
          (𝟙 (Z.genericStalkChart B S hS hX hdec)) :=
  ((Equiv.ofBijective _ (Z.bijective_smul_genericStalkGenerator B S hS hX hdec L hL
    (Z.genericStalkChart B S hS hX hdec)
    (𝟙 (Z.genericStalkChart B S hS hX hdec)))).apply_symm_apply _).symm

/-- **The coefficient of Stacks 0EPR of the meromorphic section of a global section is the image
of the coefficient of the global section.** The pullback of `1 ⊗ s|_U` over `Spec(𝒪_{U, u})` is
`1 ⊗ (a • s_ξ) = a ⊗ s_ξ`. -/
theorem PrimeDivisor.genericStalkCoefficient_globalSectionMeromorphic (s : L.sections) :
    Z.genericStalkCoefficient B S hS hX hdec L hL (globalSectionMeromorphic B S hS hX L s) =
      algebraMap (chartRing B S hS (Z.genericStalkSpace B S hS hX hdec).1
          (Z.genericStalkSpace B S hS hX hdec).2 (Z.genericStalkChart B S hS hX hdec))
        ((meromorphicChartSheaf B S hS (Z.genericStalkSpace B S hS hX hdec).1
          (Z.genericStalkSpace B S hS hX hdec).2).obj.obj
            (op (Z.genericStalkChart B S hS hX hdec)))
        (Z.globalSectionStalkCoefficient B S hS hX hdec L hL s) := by
  refine (Equiv.symm_apply_eq _).2 ?_
  refine (pullbackMeromorphicSection_eval_chartDiagram B S hS
    (Z.genericStalkMorphism B S hS hX hdec) L
    (Z.pullbacksMeromorphicSections_genericStalkMorphism B S hS hX hdec)
    (globalSectionMeromorphic B S hS hX L s) (Z.genericStalkChartDiagram B S hS hX hdec) _
    (globalSectionMeromorphic_eval B S hS hX L s _)).trans ?_
  refine congrArg (toMeromorphicSectionSheaf B S hS (Z.genericStalkSpace B S hS hX hdec).1
    (Z.genericStalkSpace B S hS hX hdec).2
    ((modulePullback B S hS (Z.genericStalkMorphism B S hS hX hdec)).obj L)
    (Z.genericStalkChart B S hS hX hdec)) ?_
  rw [chartPullbackMeromorphicSectionsSheaf_tmul, map_one, modulePullbackChartFMap_app]
  refine (congrArg (fun m => ((1 : (meromorphicChartSheaf B S hS
      (Z.genericStalkSpace B S hS hX hdec).1 (Z.genericStalkSpace B S hS hX hdec).2).obj.obj
        (op (Z.genericStalkChart B S hS hX hdec))) ⊗ₜ[chartRing B S hS
      (Z.genericStalkSpace B S hS hX hdec).1 (Z.genericStalkSpace B S hS hX hdec).2
      (Z.genericStalkChart B S hS hX hdec)] m :
        (meromorphicSectionModule B S hS (Z.genericStalkSpace B S hS hX hdec).1
          (Z.genericStalkSpace B S hS hX hdec).2
          ((modulePullback B S hS (Z.genericStalkMorphism B S hS hX hdec)).obj L)).obj
            (op (Z.genericStalkChart B S hS hX hdec))))
    (Z.globalSectionStalkCoefficient_spec B S hS hX hdec L hL s)).trans ?_
  refine (meromorphicSectionModule_tmul_smul B S hS (Z.genericStalkSpace B S hS hX hdec).1
    (Z.genericStalkSpace B S hS hX hdec).2 _ (Z.genericStalkChart B S hS hX hdec) _ 1 _).trans ?_
  exact congrArg (fun z => (z ⊗ₜ[chartRing B S hS
      (Z.genericStalkSpace B S hS hX hdec).1 (Z.genericStalkSpace B S hS hX hdec).2
      (Z.genericStalkChart B S hS hX hdec)] Z.genericStalkGenerator B S hS hX hdec L hL
        (Z.genericStalkChart B S hS hX hdec) (𝟙 (Z.genericStalkChart B S hS hX hdec)) :
        (meromorphicSectionModule B S hS (Z.genericStalkSpace B S hS hX hdec).1
          (Z.genericStalkSpace B S hS hX hdec).2
          ((modulePullback B S hS (Z.genericStalkMorphism B S hS hX hdec)).obj L)).obj
            (op (Z.genericStalkChart B S hS hX hdec)))) (mul_one _)

/-! ### The principal ideal of the coefficient is the extended evaluation ideal -/

/-- The source chart `Spec(𝒪_{U, u})` of the chart diagram of `Spec(𝒪_{U, u})` over `U` is
affine. -/
theorem PrimeDivisor.isAffine_genericStalkChartDiagram_U :
    IsAffine ((SmallEtale.toOver B S hS (Z.genericStalkSpace B S hS hX hdec).1 ⋙
      BigFppfOver.toScheme B S hS).obj (Z.genericStalkChartDiagram B S hS hX hdec).U) :=
  Z.isAffine_genericStalkChart B S hS hX hdec

/-- The target chart `U` of the chart diagram of `Spec(𝒪_{U, u})` over `U` is affine. -/
theorem PrimeDivisor.isAffine_genericStalkChartDiagram_V :
    IsAffine ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).obj
      (Z.genericStalkChartDiagram B S hS hX hdec).V) :=
  Z.isAffine_genericChart B S hS hX hdec

/-- **The regular functions on `Spec(𝒪_{U, u})` are flat over those on `U`**, the morphism
`Spec(𝒪_{U, u}) → U` being flat and both schemes affine. -/
theorem PrimeDivisor.flat_genericStalkChartDiagram :
    RingHom.Flat (chartDiagramRestrict B S hS (Z.genericStalkMorphism B S hS hX hdec)
      (Z.genericStalkChartDiagram B S hS hX hdec)) := by
  have hfl : Flat ((BigFppfOver.toScheme B S hS).map
      (Z.genericStalkSpecToChart B S hS hX hdec)) := by
    rw [Z.toScheme_map_genericStalkSpecToChart B S hS hX hdec]
    exact flat_fromSpecStalk _ _
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj (Z.genericStalkSpec B S hS hX hdec)) :=
    Z.isAffine_genericStalkChart B S hS hX hdec
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj (Z.genericChart B S hS hX hdec).scheme) :=
    Z.isAffine_genericChart B S hS hX hdec
  exact HasRingHomProperty.appTop (P := @Flat)
    ((BigFppfOver.toScheme B S hS).map (Z.genericStalkSpecToChart B S hS hX hdec)) hfl

include hL in
/-- **The principal ideal of the coefficient of a global section is the extension of its
evaluation ideal over `U`.** -/
theorem PrimeDivisor.span_globalSectionStalkCoefficient_eq_map (s : L.sections) :
    Ideal.span {Z.globalSectionStalkCoefficient B S hS hX hdec L hL s} =
      Ideal.map (chartDiagramRestrict B S hS (Z.genericStalkMorphism B S hS hX hdec)
          (Z.genericStalkChartDiagram B S hS hX hdec))
        (sectionEvaluationIdealAt B S hS ⟨X, hX⟩ L s (Z.genericEtaleChart B S hS hX hdec)) := by
  let := chartDiagramAlgebra B S hS (Z.genericStalkMorphism B S hS hX hdec)
    (Z.genericStalkChartDiagram B S hS hX hdec)
  have : Module.Flat (chartRing B S hS X hX (Z.genericStalkChartDiagram B S hS hX hdec).V)
      (chartRing B S hS (Z.genericStalkSpace B S hS hX hdec).1
        (Z.genericStalkSpace B S hS hX hdec).2 (Z.genericStalkChartDiagram B S hS hX hdec).U) :=
    Z.flat_genericStalkChartDiagram B S hS hX hdec
  have : Module.FinitePresentation
      (chartRing B S hS X hX (Z.genericStalkChartDiagram B S hS hX hdec).V)
      (L.val.obj (op (Z.genericStalkChartDiagram B S hS hX hdec).V)) :=
    module_finitePresentation_sections_of_isInvertible B S hS ⟨X, hX⟩ L
      (Stacks.SheafOfModules.IsInvertible.toAlgebraicGeometry _ _ _ hL) _
      (Z.isAffine_genericStalkChartDiagram_V B S hS hX hdec)
  have hβbij := bijective_modulePullbackChartBaseChange_of_isQuasicoherentOnSite B S hS
    (Z.genericStalkMorphism B S hS hX hdec) L
    (isQuasicoherentOnSite_of_isInvertibleModule ⟨X, hX⟩ L hL)
    (Z.genericStalkChartDiagram B S hS hX hdec)
    (Z.isAffine_genericStalkChartDiagram_U B S hS hX hdec)
    (Z.isAffine_genericStalkChartDiagram_V B S hS hX hdec)
  exact (Module.FinitePresentation.ideal_map_dualValueIdeal_eq_span_singleton
    (LinearEquiv.ofBijective _ hβbij)
    (Z.genericStalkGenerator B S hS hX hdec L hL (Z.genericStalkChart B S hS hX hdec)
      (𝟙 (Z.genericStalkChart B S hS hX hdec)))
    (Z.bijective_smul_genericStalkGenerator B S hS hX hdec L hL
      (Z.genericStalkChart B S hS hX hdec) (𝟙 (Z.genericStalkChart B S hS hX hdec)))
    (s.eval (op (Z.genericEtaleChart B S hS hX hdec)))
    (Z.globalSectionStalkCoefficient B S hS hX hdec L hL s)
    ((modulePullbackChartBaseChange_tmul B S hS (Z.genericStalkMorphism B S hS hX hdec) L
      (Z.genericStalkChartDiagram B S hS hX hdec) 1 _).trans
      ((one_smul _ _).trans (Z.globalSectionStalkCoefficient_spec B S hS hX hdec L hL s)))).symm

/-! ### Read in the local ring `𝒪_{U, u}` -/

/-- **The coefficient of a global section, read in `𝒪_{U, u}`**: the regular functions on
`Spec(𝒪_{U, u})` are `𝒪_{U, u}`. -/
def PrimeDivisor.globalSectionGerm (s : L.sections) :
    ↥((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.stalk
      (Z.genericChart B S hS hX hdec).point) :=
  (Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).hom.hom
    (Z.globalSectionStalkCoefficient B S hS hX hdec L hL s)

/-- **Pulling a regular function on `U` back to `Spec(𝒪_{U, u})` is taking its germ at `u`.** -/
theorem PrimeDivisor.ΓSpecIso_chartDiagramRestrict
    (a : chartRing B S hS X hX (Z.genericEtaleChart B S hS hX hdec)) :
    (Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).hom.hom
        (chartDiagramRestrict B S hS (Z.genericStalkMorphism B S hS hX hdec)
          (Z.genericStalkChartDiagram B S hS hX hdec) a) =
      (((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.germ ⊤
        (Z.genericChart B S hS hX hdec).point trivial).hom a) := by
  change (Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).hom.hom
      ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
        (Z.genericStalkSpecToChart B S hS hX hdec)).op).hom a) = _
  rw [Scheme.Γ_map_op, Z.toScheme_map_genericStalkSpecToChart B S hS hX hdec,
    Scheme.fromSpecStalk_appTop]
  change (Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).hom.hom
      (((Spec (Z.genericStalkRing B S hS hX hdec)).presheaf.map
          (homOfLE le_top).op).hom
        ((Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).inv.hom
          ((((BigFppfOver.toScheme B S hS).obj
            (Z.genericChart B S hS hX hdec).scheme).presheaf.germ ⊤
              (Z.genericChart B S hS hX hdec).point trivial).hom a))) = _
  simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id, CommRingCat.id_apply]
  exact (Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).inv_hom_id_apply _

include hL in
/-- **The principal ideal of the germ of a global section is the extension to `𝒪_{U, u}` of its
evaluation ideal over `U`.** -/
theorem PrimeDivisor.span_globalSectionGerm_eq_map (s : L.sections) :
    Ideal.span {Z.globalSectionGerm B S hS hX hdec L hL s} =
      Ideal.map ((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.germ ⊤
          (Z.genericChart B S hS hX hdec).point trivial).hom
        (sectionEvaluationIdealAt B S hS ⟨X, hX⟩ L s (Z.genericEtaleChart B S hS hX hdec)) := by
  have h := congrArg (Ideal.map (Scheme.ΓSpecIso (Z.genericStalkRing B S hS hX hdec)).hom.hom)
    (Z.span_globalSectionStalkCoefficient_eq_map B S hS hX hdec L hL s)
  refine ((Ideal.map_span _ _).trans (congrArg Ideal.span Set.image_singleton)).symm.trans
    (h.trans ((Ideal.map_map _ _).trans ?_))
  congr 1
  exact RingHom.ext fun a => Z.ΓSpecIso_chartDiagramRestrict B S hS hX hdec a

variable (hInt : IsIntegralSpace B S hS X)
    (hN : HasEtaleLocalProperty B S hS X (fun Y : Scheme.{u} ↦ IsLocallyNoetherian Y))

include hInt hN in
/-- **The canonical ratio of the meromorphic section of a global section is the image of its
germ** under `𝒪_{U, u} → 𝒪^h_{X, ξ} → Q(𝒪^h_{X, ξ})`. -/
theorem PrimeDivisor.canonicalGenericRatio_globalSectionMeromorphic (s : L.sections) :
    Z.canonicalGenericRatio B S hS hX hdec L hL hInt hN (globalSectionMeromorphic B S hS hX L s) =
      algebraMap ↥(Z.genericHenselianLocalRing B S hS hX hdec)
        (Z.genericTotalFractionRing B S hS hX hdec)
        (stalkToHenselianLocalRing B S hS X hX (Z.genericPoint B S hS X) hdec
          (Z.genericChart B S hS hX hdec) (Z.globalSectionGerm B S hS hX hdec L hL s)) :=
  (congrArg (Z.genericStalkMeromorphicToGeneric B S hS hX hdec hInt hN)
    (Z.genericStalkCoefficient_globalSectionMeromorphic B S hS hX hdec L hL s)).trans
    (Z.genericStalkMeromorphicToGeneric_algebraMap B S hS hX hdec hInt hN _)

include hInt hN in
/-- **Stacks 0EQF at a prime divisor, the order of vanishing.** For a nonzero global section `s`
of an invertible module, `ord_{Z,ℒ}(s)` — read at the canonical ratio `s / s_ξ` of Stacks 0EPR —
is the order of vanishing in `𝒪_{U, u}` of the germ `a` of `s` against the generator `s_ξ`, that
is `length_{𝒪_{U, u}}(𝒪_{U, u} / a 𝒪_{U, u})`. -/
theorem PrimeDivisor.orderOfVanishingSection_globalSectionMeromorphic {s : L.sections}
    (hs : s ≠ 0) :
    haveI : ∀ W : PrimeDivisor B S hS X,
        Nontrivial ↥(W.genericHenselianLocalRing B S hS hX hdec) := fun W =>
      W.nontrivial_genericHenselianLocalRing B S hS hX hdec hInt hN
    haveI : ∀ W : PrimeDivisor B S hS X,
        IsNoetherianRing ↥(W.genericHenselianLocalRing B S hS hX hdec) := fun W =>
      W.isNoetherianRing_genericHenselianLocalRing B S hS hX hdec hInt hN
    haveI : ∀ W : PrimeDivisor B S hS X,
        Ring.KrullDimLE 1 ↥(W.genericHenselianLocalRing B S hS hX hdec) := fun W =>
      W.krullDimLE_genericHenselianLocalRing B S hS hX hdec hInt hN
    orderOfVanishingSection.{u, u} B S hS hX hdec Z L (globalSectionMeromorphic B S hS hX L s)
        (Z.canonicalLocalRatio B S hS hX hdec L hL hInt hN) =
      ((Ring.ord ↥((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.stalk
          (Z.genericChart B S hS hX hdec).point)
        (Z.globalSectionGerm B S hS hX hdec L hL s)).toNat : ℤ) := by
  have : ∀ W : PrimeDivisor B S hS X,
      Nontrivial ↥(W.genericHenselianLocalRing B S hS hX hdec) := fun W =>
    W.nontrivial_genericHenselianLocalRing B S hS hX hdec hInt hN
  have : ∀ W : PrimeDivisor B S hS X,
      IsNoetherianRing ↥(W.genericHenselianLocalRing B S hS hX hdec) := fun W =>
    W.isNoetherianRing_genericHenselianLocalRing B S hS hX hdec hInt hN
  have : ∀ W : PrimeDivisor B S hS X,
      Ring.KrullDimLE 1 ↥(W.genericHenselianLocalRing B S hS hX hdec) := fun W =>
    W.krullDimLE_genericHenselianLocalRing B S hS hX hdec hInt hN
  have : IsLocalRing ↥(Z.genericHenselianLocalRing B S hS hX hdec) :=
    henselianLocalRing_isLocalRing B S hS X hX (Z.genericPoint B S hS X) hdec
  have hreg := (isRegularMeromorphicSection_iff_ne_zero B S hS hX hInt hN L hL _).2
    (globalSectionMeromorphic_ne_zero B S hS hX L hL hs)
  exact orderOfVanishingSection_eq_ord_of_eq_stalkToHenselianLocalRing B S hS hX hdec Z
    (Z.genericChart B S hS hX hdec) L (globalSectionMeromorphic B S hS hX L s)
    (Z.canonicalLocalRatio B S hS hX hdec L hL hInt hN)
    (Z.globalSectionGerm B S hS hX hdec L hL s)
    ((Z.coe_canonicalLocalRatio B S hS hX hdec L hL hInt hN _ hreg).trans
      (Z.canonicalGenericRatio_globalSectionMeromorphic B S hS hX hdec L hL hInt hN s))

end AlgebraicGeometry.Space

