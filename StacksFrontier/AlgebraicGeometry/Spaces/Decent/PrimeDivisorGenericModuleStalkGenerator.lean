module

public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.PrimeDivisorGenericModuleFibre
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePullbackInvertible
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedInvertibleTrivial

/-!
# A generator of `ℒ_ξ`

Let `X` be a decent algebraic space over `S`, let `Z ⊆ X` be a prime divisor with generic point
`ξ`, write `B = 𝒪^h_{X, ξ}` for the henselian local ring there and let `ℒ` be an *invertible*
`𝒪_X`-module.  Then the `B`-module `ℒ_ξ` of
`AlgebraicGeometry.Space.PrimeDivisor.genericModuleStalk` is free of rank one: it has a
generator `t_ξ`, and it generates *freely* — `r ↦ r · t_ξ` is a bijection of `B` onto `ℒ_ξ`.

## Main results

* `AlgebraicGeometry.Space.PrimeDivisor.nonempty_iso_unit_genericHenselianPullback`: `c_ξ^*ℒ` is
  isomorphic to the structure sheaf of `Spec(𝒪^h_{X, ξ})`.
* `AlgebraicGeometry.Space.PrimeDivisor.exists_ne_zero_span_genericModuleStalk_eq_top`:
  **`ℒ_ξ` has a nonzero free generator.**
* `AlgebraicGeometry.Space.PrimeDivisor.exists_span_genericModuleStalk_eq_top`: its generating
  half alone.

## Implementation notes

The sheaf-level input is `AlgebraicGeometry.Space.isInvertible_modulePullback_obj`, Stacks 0B8P
on the small étale sites — `c_ξ^*ℒ` is again invertible — followed by
`AlgebraicGeometry.Space.nonempty_iso_unit_of_isInvertibleModule_of_forall_eq_top`, the
triviality of an invertible module on the small étale site of the spectrum of a local ring.  The
local ring is the henselization `R` carried as a parameter, whose spectrum *is* the scheme
underlying the object `AlgebraicGeometry.Space.ElementaryEtaleNeighborhood.henselianObj` of the
site, and its closed point lies in no proper open
(`AlgebraicGeometry.forall_eq_top_of_mem_of_isLocalRing`).

Reading the resulting isomorphism of sheaves of modules over the identity étale chart turns it
into the statement that the sections there are free of rank one, the generator being the image
of `1`: the sections of `AlgebraicGeometry.SheafOfModules.unit` over any object are the ring of
that object acting on itself.  Injectivity of `r ↦ r · t_ξ` is read off the same isomorphism,
which carries `r · t_ξ` to `r` itself.  The scalars are then restricted from `Γ(Spec(R))` to `R`
along `Scheme.ΓSpecIso`, which is an isomorphism, so both the generating property and the
nonvanishing of the generator survive — the latter because `R`, being a local ring, is not the
zero ring.

## References

* [Stacks Project, Tag 0EPR](https://stacks.math.columbia.edu/tag/0EPR)
* [Stacks Project, Tag 0EQU](https://stacks.math.columbia.edu/tag/0EQU)
* [Stacks Project, Tag 0B8P](https://stacks.math.columbia.edu/tag/0B8P)
* [Stacks Project, Tag 0ENK](https://stacks.math.columbia.edu/tag/0ENK)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

/-- A module isomorphic to its own ring of scalars is *freely* generated by one nonzero element,
and stays so after restriction of scalars along a *bijective* ring map. -/
private theorem exists_ne_zero_span_eq_top_restrictScalars_of_iso_self {R₀ : Type u} {A : Type u}
    [Ring R₀] [Nontrivial R₀] [Ring A] (f : R₀ →+* A) (hf : Function.Surjective f)
    (hfi : Function.Injective f) {M : ModuleCat.{u} A} (φ : M ≅ ModuleCat.of A A) :
    ∃ t : (ModuleCat.restrictScalars f).obj M, t ≠ 0 ∧ Submodule.span R₀ {t} = ⊤ ∧
      Function.Bijective fun r : R₀ ↦ r • t := by
  set e := φ.toLinearEquiv
  have : Nontrivial A := hfi.nontrivial
  have hgen : ∀ m : M, ∃ r : R₀, f r • e.symm (1 : A) = m := fun m ↦ by
    obtain ⟨r, hr⟩ := hf (e m)
    exact ⟨r, by rw [hr, ← e.symm.map_smul, smul_eq_mul, mul_one, e.symm_apply_apply]⟩
  have hinj : ∀ r r' : R₀, f r • e.symm (1 : A) = f r' • e.symm (1 : A) → r = r' :=
    fun r r' h ↦ hfi (by simpa using congrArg e h)
  exact ⟨e.symm 1, e.symm.map_ne_zero_iff.mpr one_ne_zero,
    Submodule.eq_top_iff'.mpr fun m ↦ Submodule.mem_span_singleton.mpr (hgen m), hinj, hgen⟩

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hdec : IsDecentSpace B S hS X) (Z : PrimeDivisor B S hS X)

section Generic

variable (R : Type u) [CommRing R] [IsLocalRing R]
  [Algebra ((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.stalk
    (Z.genericChart B S hS hX hdec).point) R]
  (hR : B.Contains (Spec (.of R)))

/-- **`c_ξ^*ℒ` is trivial.**  The pullback of an invertible `𝒪_X`-module along the canonical
morphism `c_ξ : Spec(𝒪^h_{X, ξ}) ⟶ X` of Stacks 0ENK is isomorphic to the structure sheaf of
`Spec(𝒪^h_{X, ξ})`. -/
theorem PrimeDivisor.nonempty_iso_unit_genericHenselianPullback
    (L : Modules.{u, u} B S hS X hX)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureCommRings B S hS (⟨X, hX⟩ : AlgebraicSpaces B S hS))
      (structureRingSheaf B S hS (⟨X, hX⟩ : AlgebraicSpaces B S hS)).property L) :
    Nonempty (Z.genericHenselianPullback B S hS hX hdec R hR L ≅
      SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS
          (Z.genericHenselianSpace B S hS hX hdec R hR).obj
          (Z.genericHenselianSpace B S hS hX hdec R hR).property).O)) :=
  nonempty_iso_unit_of_isInvertibleModule_of_forall_eq_top B S hS
    ((Z.genericChart B S hS hX hdec).henselianObj R hR) rfl (IsLocalRing.closedPoint R)
    (AlgebraicGeometry.forall_eq_top_of_mem_of_isLocalRing (CommRingCat.of R))
    (Z.genericHenselianSpace B S hS hX hdec R hR).property
    (Z.genericHenselianPullback B S hS hX hdec R hR L)
    (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
      (isInvertible_modulePullback_obj B S hS
        (Z.genericHenselianMorphism B S hS hX hdec R hR) L hL))

/-- **`ℒ_ξ` has a nonzero free generator.**  For an invertible `𝒪_X`-module `ℒ`, the
`𝒪^h_{X, ξ}`-module `ℒ_ξ` of `AlgebraicGeometry.Space.PrimeDivisor.genericModuleStalk` is freely
generated by a single nonzero element `t`: `r ↦ r • t` is a bijection of `𝒪^h_{X, ξ}` onto
`ℒ_ξ`. -/
theorem PrimeDivisor.exists_ne_zero_span_genericModuleStalk_eq_top
    (L : Modules.{u, u} B S hS X hX)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureCommRings B S hS (⟨X, hX⟩ : AlgebraicSpaces B S hS))
      (structureRingSheaf B S hS (⟨X, hX⟩ : AlgebraicSpaces B S hS)).property L) :
    ∃ t : Z.genericModuleStalk B S hS hX hdec R hR L, t ≠ 0 ∧ Submodule.span R {t} = ⊤ ∧
      Function.Bijective fun r : R ↦ r • t := by
  obtain ⟨φ⟩ := Z.nonempty_iso_unit_genericHenselianPullback B S hS hX hdec R hR L hL
  refine exists_ne_zero_span_eq_top_restrictScalars_of_iso_self _
    (fun a => ⟨(Scheme.ΓSpecIso (CommRingCat.of R)).hom.hom a,
      ConcreteCategory.congr_hom (Scheme.ΓSpecIso (CommRingCat.of R)).hom_inv_id a⟩)
    (fun a b hab => ?_)
    ((SheafOfModules.evaluation _ (op (Z.genericHenselianChart B S hS hX hdec R hR))).mapIso φ)
  have hsec : ∀ x, (Scheme.ΓSpecIso (CommRingCat.of R)).hom.hom
      ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom x) = x :=
    (Scheme.ΓSpecIso (CommRingCat.of R)).inv_hom_id_apply
  exact (hsec a).symm.trans
    ((congrArg (Scheme.ΓSpecIso (CommRingCat.of R)).hom.hom hab).trans (hsec b))

/-- **`ℒ_ξ` has a generator.**  For an invertible `𝒪_X`-module `ℒ`, the `𝒪^h_{X, ξ}`-module
`ℒ_ξ` is generated by a single element. -/
theorem PrimeDivisor.exists_span_genericModuleStalk_eq_top (L : Modules.{u, u} B S hS X hX)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureCommRings B S hS (⟨X, hX⟩ : AlgebraicSpaces B S hS))
      (structureRingSheaf B S hS (⟨X, hX⟩ : AlgebraicSpaces B S hS)).property L) :
    ∃ t : Z.genericModuleStalk B S hS hX hdec R hR L, Submodule.span R {t} = ⊤ :=
  let ⟨t, _, ht, _⟩ := Z.exists_ne_zero_span_genericModuleStalk_eq_top B S hS hX hdec R hR L hL
  ⟨t, ht⟩

end Generic

end AlgebraicGeometry.Space

end
