module

public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.GenericMeromorphicFractionRing
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.PrimeDivisorGenericModuleStalkGenerator
public import StacksFrontier.AlgebraicGeometry.Spaces.MeromorphicSectionValueDescent
public import StacksFrontier.AlgebraicGeometry.Spaces.MeromorphicSectionsTrivialization
public import StacksFrontier.AlgebraicGeometry.Spaces.RegularMeromorphicSectionExistence

/-!
# `𝒦_X(ℒ)_ξ` is freely generated by the image of a generator of `ℒ_ξ`

Let `X` be a decent, locally Noetherian, integral algebraic space over `S`, let `Z ⊆ X` be a
prime divisor with generic point `ξ` and let `ℒ` be an *invertible* `𝒪_X`-module.  Write
`K = 𝒦(Spec(𝒪^h_{X, ξ}))` for the ring of meromorphic functions of `Spec(𝒪^h_{X, ξ})` over its
identity étale chart, which is the total ring of fractions `Q(𝒪^h_{X, ξ})` by
`AlgebraicGeometry.Space.PrimeDivisor.isFractionRing_genericMeromorphicChartRing`.

This file proves that `𝒦_X(ℒ)_ξ` is **free of rank one over `K`**, generated by the image of a
free generator `t_ξ` of `ℒ_ξ`: the map `k ↦ k · t_ξ` is a bijection of `K` onto `𝒦_X(ℒ)_ξ`.  It
is step (i) of the construction of the canonical ratio `s / s_ξ` of Stacks 0EPR recorded in the
implementation notes of `StacksFrontier.AlgebraicGeometry.Spaces.DivisorOfMeromorphicSection`.

## Main results

* `AlgebraicGeometry.Space.PrimeDivisor.nonempty_uliftUnit_iso_genericMeromorphicSectionSheaf`:
  **`𝒦_Y ≅ 𝒦_Y(ℒ_ξ)` for `Y = Spec(𝒪^h_{X, ξ})`.**  This is
`AlgebraicGeometry.Space.CodimensionZeroPresentation.nonempty_uliftUnit_iso_meromorphicSectionSheaf`
  with its hypotheses discharged from the standing hypotheses on `X`.
* `AlgebraicGeometry.Space.PrimeDivisor.exists_bijective_smul_genericMeromorphicSections`:
  `𝒦_X(ℒ)_ξ` is free of rank one over `K`, with *some* generator.
* `AlgebraicGeometry.Space.PrimeDivisor.bijective_smul_toMeromorphicSectionValue`: **step (i).**
  The image of a *free generator of `ℒ_ξ`* is such a generator.

## Implementation notes

The sheaf-level input is `𝒦_Y ≅ 𝒦_Y(M)` for an invertible `M`, in the form
`AlgebraicGeometry.Space.CodimensionZeroPresentation.nonempty_uliftUnit_iso_meromorphicSectionSheaf`
, which produces the composite of `𝒦_Y(M) ≅ 𝒦_Y(𝒪)` and `𝒦_Y(𝒪) ≅ 𝒦_Y` in one step; the second
of those is not in the library, so the one-step form is the only route.  Its hypotheses (a), (b)
and (c) of Stacks 0ENA for `Y = Spec(𝒪^h_{X, ξ})` are the theorems of
`StacksFrontier.AlgebraicGeometry.Spaces.Decent.GenericHenselianSpaceCodimensionZero`, and the
trivialisation of `ℒ_ξ` at the codimension-zero points of `Y` is
`AlgebraicGeometry.Space.CodimensionZeroPresentation.nonempty_iso_unit_of_isInvertibleModule`,
exactly as in the proof of Stacks 0EPQ.

That the image `w` of a free generator `t_ξ` is again a *free* generator is the step the two
spellings of the sections of `𝒦_Y` used to block, and
`AlgebraicGeometry.Space.meromorphicChartRing_commRing` is what unblocks it: the scalar action
on `𝒦_Y(ℒ_ξ)` and the fraction-ring structure of `𝒦_Y` can now be named in one statement.  With
that in hand the argument is the one the source makes.  Writing `g` for the generator the
isomorphism produces, `w = c · g` for a unique `c ∈ K`, and `c` is a nonzerodivisor: if
`x · c = 0` then `x · w = 0`, and clearing the denominator of `x = a / b` turns this into
`a · w = 0`, that is `toMeromorphicSectionValue (a · t_ξ) = 0`; the canonical map
`ℒ_ξ ⟶ 𝒦_Y(ℒ_ξ)` is injective for an invertible module
(`AlgebraicGeometry.Space.injective_toMeromorphicSectionValue`) and `r ↦ r · t_ξ` is injective
by hypothesis, so `a = 0` and hence `x = 0`.  In a total ring of fractions a nonzerodivisor is a
unit, by `IsFractionRing.nonZeroDivisors_eq_isUnit`, so `k ↦ k · w` is `k ↦ (k · c) · g` with
`c` invertible, a bijection.

## References

* [Stacks Project, Tag 0EN5](https://stacks.math.columbia.edu/tag/0EN5)
* [Stacks Project, Tag 0EN6](https://stacks.math.columbia.edu/tag/0EN6)
* [Stacks Project, Tag 0ENA](https://stacks.math.columbia.edu/tag/0ENA)
* [Stacks Project, Tag 0EPQ](https://stacks.math.columbia.edu/tag/0EPQ)
* [Stacks Project, Tag 0EPR](https://stacks.math.columbia.edu/tag/0EPR)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hdec : IsDecentSpace B S hS X) (hInt : IsIntegralSpace B S hS X)
    (hN : HasEtaleLocalProperty B S hS X (fun Y : Scheme.{u} => IsLocallyNoetherian Y))
    (Z : PrimeDivisor B S hS X)

section Generic

variable (R : Type u) [CommRing R] [IsLocalRing R]
  [Algebra ((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.stalk
    (Z.genericChart B S hS hX hdec).point) R]
  [IsLocalRing.IsHenselization
    ((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.stalk
      (Z.genericChart B S hS hX hdec).point)
    (IsLocalRing.ResidueField
      ((Z.genericChart B S hS hX hdec).scheme.left.1.presheaf.stalk
        (Z.genericChart B S hS hX hdec).point)) R]
  (hR : B.Contains (Spec (.of R)))

/-! ### `𝒦_Y ≅ 𝒦_Y(ℒ_ξ)` at `Y = Spec(𝒪^h_{X, ξ})` -/

include hX hdec hInt hN Z in
/-- **`𝒦_Y ≅ 𝒦_Y(ℒ_ξ)` for `Y = Spec(𝒪^h_{X, ξ})`.**  The pullback `ℒ_ξ = c_ξ^*ℒ` of an
invertible `𝒪_X`-module is invertible by Stacks 0B8P, and `Y` satisfies hypotheses (a), (b) and
(c) of Stacks 0ENA and is trivialised at its codimension-zero points, so
`AlgebraicGeometry.Space.CodimensionZeroPresentation.nonempty_uliftUnit_iso_meromorphicSectionSheaf`
applies. -/
theorem PrimeDivisor.nonempty_uliftUnit_iso_genericMeromorphicSectionSheaf
    (L : Modules.{u, u} B S hS X hX)
    (hL : IsInvertibleModule (⟨X, hX⟩ : AlgebraicSpaces B S hS) L) :
    Nonempty (SheafOfModules.uliftObj.{_, _, _, _, u + 1}
        (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
          (meromorphicRingedSite B S hS
            (Z.genericHenselianSpace B S hS hX hdec R hR).obj
            (Z.genericHenselianSpace B S hS hX hdec R hR).property).O)) ≅
      meromorphicSectionSheaf.{u, u} B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianPullback B S hS hX hdec R hR L)) := by
  have hred : _root_.IsReduced R := Z.isReduced_genericHenselization B S hS hX hdec hInt hN R
  have hnoeth : IsNoetherianRing R :=
    Z.isNoetherianRing_genericHenselization B S hS hX hdec hInt hN R
  obtain ⟨P⟩ :=
    Z.nonempty_codimensionZeroPresentation_genericHenselianSpace B S hS hX hdec R hR hnoeth
  have hM : IsInvertibleModule (Z.genericHenselianSpace B S hS hX hdec R hR)
      (Z.genericHenselianPullback B S hS hX hdec R hR L) :=
    modulePullbackInvertible (Z.genericHenselianMorphism B S hS hX hdec R hR) L hL
  have hτ : (η : CodimensionZeroPresentation.CodimensionZeroPoints B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).1) →
      P.genericPointPullback (X := Z.genericHenselianSpace B S hS hX hdec R hR) η.2
          (Z.genericHenselianPullback B S hS hX hdec R hR L) ≅
        SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS (P.specStalkSpace η.2).1
            (P.specStalkSpace η.2).2).O) :=
    fun η => (P.nonempty_iso_unit_of_isInvertibleModule η.1 η.2 _
      (modulePullbackInvertible (P.genericMorphism η.2
        (Z.genericHenselianSpace B S hS hX hdec R hR).2) _ hM)).some
  exact P.nonempty_uliftUnit_iso_meromorphicSectionSheaf
    (X := Z.genericHenselianSpace B S hS hX hdec R hR) _ hτ
    (Z.forall_localRingDimension_genericHenselianSpace_eq_zero B S hS hX hdec R hR hred)
    (Z.hasLocallyFiniteIrreducibleComponents_genericHenselianSpace B S hS hX hdec R hR hnoeth)
    (Stacks.SheafOfModules.IsInvertible.toAlgebraicGeometry _ _ _ hM)

/-! ### `𝒦_X(ℒ)_ξ` is free of rank one -/

include hX hdec hInt hN Z in
/-- **`𝒦_X(ℒ)_ξ` is free of rank one over `𝒦(Spec(𝒪^h_{X, ξ}))`.**  The isomorphism
`𝒦_Y ≅ 𝒦_Y(ℒ_ξ)` carries the unit meromorphic function to a free generator. -/
theorem PrimeDivisor.exists_bijective_smul_genericMeromorphicSections
    (L : Modules.{u, u} B S hS X hX)
    (hL : IsInvertibleModule (⟨X, hX⟩ : AlgebraicSpaces B S hS) L) :
    ∃ g : (meromorphicSectionSheaf.{u, u} B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianPullback B S hS hX hdec R hR L)).val.obj
        (op (Z.genericHenselianChart B S hS hX hdec R hR)),
      Function.Bijective fun k : meromorphicChartRing B S hS
          (Z.genericHenselianSpace B S hS hX hdec R hR).obj
          (Z.genericHenselianSpace B S hS hX hdec R hR).property
          (Z.genericHenselianChart B S hS hX hdec R hR) => k • g := by
  obtain ⟨ι⟩ := Z.nonempty_uliftUnit_iso_genericMeromorphicSectionSheaf B S hS hX hdec hInt hN
    R hR L hL
  have hev : ULift.{u + 1} (meromorphicChartRing B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianChart B S hS hX hdec R hR)) ≃ₗ[meromorphicChartRing B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianChart B S hS hX hdec R hR)]
      (meromorphicSectionSheaf.{u, u} B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianPullback B S hS hX hdec R hR L)).val.obj
        (op (Z.genericHenselianChart B S hS hX hdec R hR)) :=
    ((SheafOfModules.evaluation _
      (op (Z.genericHenselianChart B S hS hX hdec R hR))).mapIso ι).toLinearEquiv
  set Φ := ULift.moduleEquiv.symm.trans hev with hΦ
  refine ⟨Φ 1, ?_⟩
  have hk : ∀ k : meromorphicChartRing B S hS
      (Z.genericHenselianSpace B S hS hX hdec R hR).obj
      (Z.genericHenselianSpace B S hS hX hdec R hR).property
      (Z.genericHenselianChart B S hS hX hdec R hR), k • Φ 1 = Φ k := by
    intro k
    rw [← Φ.map_smul, smul_eq_mul, mul_one]
  exact (funext hk : (fun k => k • Φ 1) = fun k => Φ k) ▸ Φ.bijective

include hX hdec hInt hN Z in
/-- **Step (i) of the canonical ratio of Stacks 0EPR: `𝒦_X(ℒ)_ξ` is freely generated over
`Q(𝒪^h_{X, ξ})` by the image of a free generator `t_ξ` of `ℒ_ξ`.**  Every germ at `ξ` of a
meromorphic section of `ℒ` is therefore `k · t_ξ` for exactly one meromorphic function `k` on
`Spec(𝒪^h_{X, ξ})`, which is the ratio `s / s_ξ` the source takes.

The isomorphism `𝒦_Y ≅ 𝒦_Y(ℒ_ξ)` gives *some* free generator `g`, and `t_ξ` differs from it by
the factor `c` with `t_ξ = c · g`.  That factor is a nonzerodivisor: if `x · c = 0` then
`x · t_ξ = 0` in `𝒦_Y(ℒ_ξ)`, and clearing the denominator of `x` turns this into
`a · t_ξ = 0` for `a ∈ 𝒪^h_{X, ξ}`, whence `a = 0` because `ℒ ⟶ 𝒦_X(ℒ)` is injective on
sections and `t_ξ` generates freely.  In the total ring of fractions a nonzerodivisor is a unit,
so multiplication by `c` is a bijection. -/
theorem PrimeDivisor.bijective_smul_toMeromorphicSectionValue
    (L : Modules.{u, u} B S hS X hX)
    (hL : IsInvertibleModule (⟨X, hX⟩ : AlgebraicSpaces B S hS) L)
    (t : Z.genericModuleStalk B S hS hX hdec R hR L)
    (ht : Function.Bijective fun r : R => r • t) :
    Function.Bijective fun k : meromorphicChartRing B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianChart B S hS hX hdec R hR) =>
      k • toMeromorphicSectionValue B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianPullback B S hS hX hdec R hR L)
        (Z.genericHenselianChart B S hS hX hdec R hR) t := by
  set K := meromorphicChartRing B S hS
      (Z.genericHenselianSpace B S hS hX hdec R hR).obj
      (Z.genericHenselianSpace B S hS hX hdec R hR).property
      (Z.genericHenselianChart B S hS hX hdec R hR) with hK
  set w := toMeromorphicSectionValue B S hS
      (Z.genericHenselianSpace B S hS hX hdec R hR).obj
      (Z.genericHenselianSpace B S hS hX hdec R hR).property
      (Z.genericHenselianPullback B S hS hX hdec R hR L)
      (Z.genericHenselianChart B S hS hX hdec R hR) t with hw
  let : Algebra R K := (Z.genericToMeromorphicFunctions B S hS hX hdec R hR).toAlgebra
  have : IsFractionRing R K :=
    Z.isFractionRing_genericMeromorphicChartRing B S hS hX hdec R hR
      (Z.isReduced_genericHenselization B S hS hX hdec hInt hN R)
      (Z.isNoetherianRing_genericHenselization B S hS hX hdec hInt hN R)
  have hMinv : AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureCommRings B S hS (Z.genericHenselianSpace B S hS hX hdec R hR))
      (structureRingSheaf B S hS (Z.genericHenselianSpace B S hS hX hdec R hR)).property
      (Z.genericHenselianPullback B S hS hX hdec R hR L) :=
    Stacks.SheafOfModules.IsInvertible.toAlgebraicGeometry _ _ _
      (modulePullbackInvertible (Z.genericHenselianMorphism B S hS hX hdec R hR) L hL)
  obtain ⟨g, hg⟩ := Z.exists_bijective_smul_genericMeromorphicSections B S hS hX hdec hInt hN
    R hR L hL
  obtain ⟨c, hc⟩ := hg.surjective w
  have hsl : ∀ a : R, algebraMap R K a • w =
      toMeromorphicSectionValue B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR).obj
        (Z.genericHenselianSpace B S hS hX hdec R hR).property
        (Z.genericHenselianPullback B S hS hX hdec R hR L)
        (Z.genericHenselianChart B S hS hX hdec R hR) (a • t) :=
    fun a => ((Z.genericModuleStalkToMeromorphic B S hS hX hdec R hR L).map_smul a t).symm
  have hcnz : c ∈ nonZeroDivisors K := by
    refine mem_nonZeroDivisors_iff_right.mpr fun x hx => ?_
    have hxw : x • w = 0 := by rw [← hc, smul_smul, hx, zero_smul]
    obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors R) x
    have hae : a = 0 := by
      refine ht.injective ?_
      show a • t = (0 : R) • t
      refine injective_toMeromorphicSectionValue B S hS
        (Z.genericHenselianSpace B S hS hX hdec R hR)
        (Z.genericHenselianPullback B S hS hX hdec R hR L) hMinv
        (Z.genericHenselianChart B S hS hX hdec R hR) ?_
      rw [← hsl a, ← hsl (0 : R), map_zero, zero_smul, ← hab, mul_comm, ← smul_smul,
        hxw, smul_zero]
    rw [hae, map_zero] at hab
    exact (IsLocalization.map_units K b).mul_left_eq_zero.mp hab
  rw [IsFractionRing.nonZeroDivisors_eq_isUnit R K] at hcnz
  obtain ⟨cu, hcu⟩ := hcnz
  have hcomp : (fun k : K => k • w) = (fun y => y • g) ∘ fun k => k * c := by
    funext k
    rw [← hc, smul_smul]
    rfl
  rw [hcomp]
  exact hg.comp (hcu ▸ Units.mulRight_bijective cu)

end Generic

end AlgebraicGeometry.Space

end
