module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealPushforwardAffine
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealPushforwardAffineSheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleBaseChangeAdjunction

/-!
# The inverse-image ideal along an étale morphism is the restricted ideal

Let `φ : W ⟶ X` be an étale representable morphism of algebraic spaces over a scheme `S` and
let `𝓙 ⊆ 𝒪_X` be a sheaf of ideals on the small étale site of `X`.  An étale chart `V` of `W` is
by composition an étale chart `φ ∘ V` of `X`, with the same underlying scheme, so that
`𝒪_W(V) = 𝒪_X(φ ∘ V)`.  This file proves that the inverse-image ideal `φ⁻¹𝓙 · 𝒪_W` has, over
every étale chart `V` of `W`, exactly the sections of `𝓙` over `φ ∘ V`.

## Main definitions

* `AlgebraicGeometry.Space.etaleIdealRestrict`: the sheaf of ideals of `𝒪_W` whose sections
  over a chart `V` are the sections of `𝓙` over `φ ∘ V`.

## Main results

* `AlgebraicGeometry.Space.pullbackIdealSubsheaf_eq_etaleIdealRestrict`: for `φ` étale and
  representable, `φ⁻¹𝓙 · 𝒪_W` is the restricted ideal.

## Implementation notes

The inverse-image ideal `AlgebraicGeometry.Space.pullbackIdealSubsheaf` is generated by the
pullbacks `φ♯(a)` of the sections `a` of `𝓙` over the charts `Q` of `X`, which live over the
base-changed charts `Q ×_X W`.  Both inclusions come from the adjunction between postcomposition
with `φ` and base change of charts: the counit `φ ∘ (Q ×_X W) ⟶ Q` shows that `φ♯(a)` is a
restriction of `a`, and the unit `V ⟶ (φ ∘ V) ×_X W`, a section of the cartesian projection,
recovers a section of `𝓙` over `φ ∘ V` from its pullback.

## References

* [Stacks Project, Tag 03G8](https://stacks.math.columbia.edu/tag/03G8)
* [Stacks Project, Tag 03LP](https://stacks.math.columbia.edu/tag/03LP)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X W : AlgebraicSpaces B S hS} (φ : W ⟶ X) (hφ : IsEtale B S hS φ.hom)

/-- **The restriction of a sheaf of ideals along an étale morphism.**  For an étale
`φ : W ⟶ X` and a sheaf of ideals `𝓙 ⊆ 𝒪_X`, the sheaf of ideals of `𝒪_W` whose sections over a
chart `V` of `W` are the sections of `𝓙` over the composite chart `φ ∘ V`. -/
def etaleIdealRestrict
    (J : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule) :
    (SheafOfModules.unit (smallEtaleRingSheaf B S hS W.1 W.2)).Submodule where
  obj V :=
    { carrier := {x | x ∈ J.obj (op ((smallEtalePostcomp B S hS φ hφ).obj V.unop))}
      zero_mem' := Submodule.zero_mem _
      add_mem' := fun h₁ h₂ => Submodule.add_mem _ h₁ h₂
      smul_mem' := fun c _ h => Submodule.smul_mem _ c h }
  map {V V'} f := fun _ hx => J.map_mem ((smallEtalePostcomp B S hS φ hφ).map f.unop).op hx
  isSheaf := by
    rintro ⟨V⟩ s hs
    refine J.isSheaf (X := op ((smallEtalePostcomp B S hS φ hφ).obj V)) s ?_
    refine (SmallEtale.topology B S hS X.1).superset_covering ?_
      ((SmallEtale.coverPreserving_smallEtalePostcomp B S hS φ hφ).cover_preserve hs)
    rintro T w ⟨V', h, w', hh, rfl⟩
    have h' := J.map_mem w'.op hh
    change (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).val.map
      (w' ≫ (smallEtalePostcomp B S hS φ hφ).map h).op s ∈ J.obj (op T)
    have e := PresheafOfModules.map_comp_apply
      (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).val
      ((smallEtalePostcomp B S hS φ hφ).map h).op w'.op s
    rw [op_comp]
    exact e ▸ h'

/-- The sections of the restricted ideal over a chart `V` are the sections of `𝓙` over `φ ∘ V`. -/
@[simp]
theorem mem_etaleIdealRestrict_obj
    (J : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule)
    (V : SmallEtale B S hS W.1)
    (s : (smallEtaleRingSheaf B S hS X.1 X.2).obj.obj
      (op ((smallEtalePostcomp B S hS φ hφ).obj V))) :
    s ∈ (etaleIdealRestrict B S hS φ hφ J).obj (op V) ↔
      s ∈ J.obj (op ((smallEtalePostcomp B S hS φ hφ).obj V)) := Iff.rfl

/-- The ideal of sections of the restricted ideal over a chart `V` is the ideal of sections of
`𝓙` over `φ ∘ V`. -/
theorem chartSectionsIdeal_etaleIdealRestrict
    (J : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule)
    (V : SmallEtale B S hS W.1) :
    chartSectionsIdeal B S hS W (etaleIdealRestrict B S hS φ hφ J) V =
      chartSectionsIdeal B S hS X J ((smallEtalePostcomp B S hS φ hφ).obj V) := rfl

variable (hrep : yoneda.relativelyRepresentable φ.hom)

/-- **The inverse-image ideal along an étale representable morphism is the restricted ideal**:
`φ⁻¹𝓙 · 𝒪_W` has, over every étale chart `V` of `W`, the sections of `𝓙` over `φ ∘ V`. -/
theorem pullbackIdealSubsheaf_eq_etaleIdealRestrict
    (J : (SheafOfModules.unit (smallEtaleRingSheaf B S hS X.1 X.2)).Submodule) :
    pullbackIdealSubsheaf B S hS φ hrep J = etaleIdealRestrict B S hS φ hφ J := by
  set adj := smallEtalePostcompBaseChangeAdjunction B S hS φ hφ hrep
  refine le_antisymm (pullbackIdealSubsheaf_le B S hS φ hrep J fun Q a ha => ?_) ?_
  · -- `φ♯(a)` is the restriction of `a` along the counit `φ ∘ (Q ×_X W) ⟶ Q`.
    have hc := congrArg (fun t => t.app (op Q))
      (smallBaseChangeSharp_counit B S hS φ hφ hrep)
    have hca : chartIdealPullbackHom B S hS φ hrep Q a =
        (smallEtaleRingSheaf B S hS X.1 X.2).obj.map (adj.counit.app Q).op a := by
      have := congrArg (fun t => t.hom a) hc
      exact this.symm
    show chartIdealPullbackHom B S hS φ hrep Q a ∈
      J.obj (op ((smallEtalePostcomp B S hS φ hφ).obj ((smallBaseChange B S hS φ hrep).obj Q)))
    rw [hca]
    exact J.map_mem (adj.counit.app Q).op ha
  · -- A section of `𝓙` over `φ ∘ V` is recovered from its pullback along the unit.
    intro V x hx
    obtain ⟨V⟩ := V
    have hmem := chartIdealPullbackHom_mem_pullbackIdealSubsheaf B S hS φ hrep J
      ((smallEtalePostcomp B S hS φ hφ).obj V) hx
    have hres := (pullbackIdealSubsheaf B S hS φ hrep J).map_mem (adj.unit.app V).op hmem
    have hu := congrArg (fun t => t.app (op V)) (smallBaseChangeSharp_unit B S hS φ hφ hrep)
    have hux := congrArg (fun t => t.hom x) hu
    have key : (SheafOfModules.unit (smallEtaleRingSheaf B S hS W.1 W.2)).val.map
        (adj.unit.app V).op (chartIdealPullbackHom B S hS φ hrep
          ((smallEtalePostcomp B S hS φ hφ).obj V) x) = x := by
      have h2 := hux.symm
      simp only [NatTrans.comp_app, RingCat.hom_comp, RingHom.coe_comp, NatTrans.id_app,
        RingCat.hom_id] at h2
      exact h2.symm.trans (RingHom.id_apply x)
    rw [key] at hres
    exact hres

end AlgebraicGeometry.Space

end
