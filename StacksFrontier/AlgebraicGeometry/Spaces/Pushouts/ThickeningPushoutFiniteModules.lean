module

public import StacksFrontier.AlgebraicGeometry.Quot.CoherentStackPullbackStability
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationOnSiteAffineCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeOnSiteAffineCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.FlatFiniteTypeModuleLocus
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePullbackSupport
public import StacksFrontier.AlgebraicGeometry.Spaces.Pushouts.ThickeningPushoutFlatModules
public import StacksFrontier.AlgebraicGeometry.Topologies.FiniteTypeFromGlobalGenerators
public import StacksFrontier.AlgebraicGeometry.Topologies.FiniteTypeOnSiteKernel

/-!
# Stacks 08KV (a) and (b): finite type and finite presentation under the gluing along a thickening

In the situation of Stacks 08KV
(`StacksFrontier/AlgebraicGeometry/Spaces/Pushouts/ThickeningPushoutFlatModules.lean`),
a quasi-coherent `𝒪_{V'}`-module `𝒢'` flat over `Y'` is of finite type exactly when the two
components `𝒢 = (V ⟶ V')^*𝒢'` and `ℱ' = (U' ⟶ V')^*𝒢'` of its triple are of finite type.

One direction is Stacks 03DO (pullback preserves finite type).  For the other, over an affine
étale chart `W` of `V'` mapping to an affine étale chart of `Y'` the rings of functions form a
Milnor cube (`AlgebraicGeometry.Space.PushoutModules.isMilnorCube_chart`), the sections of `𝒢'`
over `W` are the compatible pairs of the sections of `𝒢` and `ℱ'` (the unit of the gluing
adjunction is bijective there), and the module of compatible pairs of two finite modules is
finite (More on Algebra, Lemma 08IH: `Stacks.Pushout.cube_finite`).  Such charts cover `V'`, and
a module cartesian on affine charts is generated by finitely many sections over each of them.

Part (b) is the same argument with finite presentation: when `g : V' ⟶ Y'` is locally of finite
presentation, the ring maps `Γ(W') ⟶ Γ(W)` of the affine chart diagrams of `g` are of finite
presentation, and the module of compatible pairs of two relatively flat modules of finite
presentation is then of finite presentation (More on Algebra, Lemma 08KP:
`Stacks.Pushout.cube_finitePresentation`); a module cartesian on affine charts with finitely
presented sections over an affine chart has a finite global presentation on the slice there
(`AlgebraicGeometry.Space.hasFiniteGlobalPresentation_over_of_moduleFinitePresentation`).
Finite presentation is Stacks 03DL (7), `SheafOfModules.IsFinitePresentationOnSite`.

## Main results

* `AlgebraicGeometry.Space.PushoutModules.isFiniteType_iff_restrict`: **Stacks 08KV (a).**
* `AlgebraicGeometry.Space.PushoutModules.isFinitePresentationOnSite_iff_restrict`:
  **Stacks 08KV (b).**
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

attribute [local instance] AlgebraicGeometry.Space.isContinuous_smallBaseChange

universe u

namespace AlgebraicGeometry.Space.PushoutModules

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X X' Y : AlgebraicSpaces B S hS} (i : X ⟶ X') (f : X ⟶ Y) [HasPushout i f]
    {V' : AlgebraicSpaces B S hS} (g : V' ⟶ pushout i f)
    (hi : IsThickeningHom B S hS i) (hf : IsAffineHom B S hS f.hom)

/-- **Finite type is preserved by the pullback of modules of algebraic spaces** (Stacks 03DO),
for Mathlib's `SheafOfModules.IsFiniteType`. -/
theorem isFiniteType_modulePullback {Z Z' : AlgebraicSpaces B S hS} (k : Z' ⟶ Z)
    (M : Modules.{u, u} B S hS Z.1 Z.2) (hM : M.IsFiniteType) :
    ((modulePullback B S hS k).obj M).IsFiniteType :=
  Stacks.SheafOfModules.isFiniteType_of_isFiniteTypeOnSite _
    (isFiniteTypeOnSite_modulePullback B S hS k M
      (Stacks.SheafOfModules.isFiniteTypeOnSite_of_isFiniteType M hM))

/-- The sections of a quasi-coherent module of finite type over an affine étale chart are a
finite module. -/
theorem module_finite_sections_of_isFiniteType {Z : AlgebraicSpaces B S hS}
    (M : Modules.{u, u} B S hS Z.1 Z.2) (hq : M.IsQuasicoherentOnSite) (hM : M.IsFiniteType)
    (W : SmallEtale B S hS Z.1) (hW : IsAffine (chartScheme W)) :
    Module.Finite (chartRing B S hS Z.1 Z.2 W) (M.val.obj (op W)) :=
  module_finite_sections_of_isCartesianOnAffineCharts_of_isFiniteTypeOnSite M
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Z.1 Z.2 M hq)
    (Stacks.SheafOfModules.isFiniteTypeOnSite_of_isFiniteType M hM) W hW

include hi hf in
/-- **Over an affine chart of `V'` carrying a Milnor cube, the sections of a quasi-coherent module
flat over `Y'` whose two restrictions are of finite type form a finite module.** -/
theorem module_finite_sections_of_restrict (M : Modules.{u, u} B S hS V'.1 V'.2)
    (hM : FlatQuasicoherentOver g M)
    (hG : ((modulePullback B S hS (targetRestriction i f g)).obj M).IsFiniteType)
    (hF : ((modulePullback B S hS (ambientRestriction i f g)).obj M).IsFiniteType)
    (d : ChartDiagram B S hS V'.1 (pushout i f).1 g.hom) (hU : IsAffine (chartScheme d.U))
    (hV : IsAffine (chartScheme d.V)) :
    Module.Finite (chartRing B S hS V'.1 V'.2 d.U) (M.val.obj (op d.U)) := by
  have hWV := isAffine_smallBaseChange_obj B S hS _ (rep_targetRestriction i f g hi hf)
    (isAffineHom_targetRestriction i f g hi hf) d.U hU
  have hWU' := isAffine_smallBaseChange_obj B S hS _ (rep_ambientRestriction i f g hi hf)
    (isAffineHom_ambientRestriction i f g hi hf) d.U hU
  have hWU := isAffine_smallBaseChange_obj B S hS _ (rep_commonTargetComp i f g hi hf)
    (isAffineHom_commonTargetComp i f g hi hf) d.U hU
  have hqG := isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
    (targetRestriction i f g) M hM.1
  have hqF := isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
    (ambientRestriction i f g) M hM.1
  have hflat := (isFlatOverOnChartDiagram_iff_flat_sections B S hS g M hM.1 d hU hV).1 (hM.2 d)
  have hcube := isMilnorCube_chart i f g hi hf d hU hV
  have hbij := bijective_squareUnit_app_of_isMilnorCube (commonToTarget i f g)
    (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
    (commonToAmbient_comp_eq i f g) (rep_commonToTarget i f g hi hf)
    (rep_targetRestriction i f g hi hf) (rep_commonToAmbient i f g hi hf)
    (rep_ambientRestriction i f g hi hf) (rep_commonTargetComp i f g hi hf)
    (rep_commonAmbientComp i f g hi hf) d.U hWV hWU' hWU M hM.1 hU hcube hflat
  have hfin := finite_glue_of_isMilnorCube (commonToTarget i f g) (targetRestriction i f g)
    (commonToAmbient i f g) (ambientRestriction i f g) (commonToAmbient_comp_eq i f g)
    (rep_commonToTarget i f g hi hf) (rep_targetRestriction i f g hi hf)
    (rep_commonToAmbient i f g hi hf) (rep_ambientRestriction i f g hi hf)
    (rep_commonTargetComp i f g hi hf) (rep_commonAmbientComp i f g hi hf) d.U
    ((TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
      (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
      (commonToAmbient_comp_eq i f g))).obj M) hqG hqF hWV hWU' hWU hcube
    (module_finite_sections_of_isFiniteType _ hqG hG _ hWV)
    (module_finite_sections_of_isFiniteType _ hqF hF _ hWU')
  exact (Module.Finite.equiv_iff (LinearEquiv.ofBijective _ hbij)).2 hfin

/-- Every object of the small étale site of `V'` is covered by affine charts `d.U` of chart
diagrams of `g` with `d.V` affine, so a property holding on all of these holds on a cover. -/
private theorem exists_cover_of_forall_affine_chartDiagram
    (U : (smallEtaleRingedSite B S hS V'.1 V'.2).C)
    (P : (smallEtaleRingedSite B S hS V'.1 V'.2).C → Prop)
    (hP : ∀ d : ChartDiagram B S hS V'.1 (pushout i f).1 g.hom,
      IsAffine (chartScheme d.U) → IsAffine (chartScheme d.V) → P d.U) :
    ∃ (I : Type (u + 1)) (V : I → (smallEtaleRingedSite B S hS V'.1 V'.2).C) (k : ∀ i, V i ⟶ U),
      Sieve.ofArrows V k ∈ (smallEtaleRingedSite B S hS V'.1 V'.2).J U ∧ ∀ i, P (V i) := by
  refine ⟨Σ Z : SmallEtale B S hS V'.1, {k : Z ⟶ U //
      IsAffine ((SmallEtale.toOver B S hS V'.1 ⋙ BigFppfOver.toScheme B S hS).obj Z) ∧
      ∃ d : ChartDiagram B S hS V'.1 (pushout i f).1 g.hom, ∃ _ : d.U = Z,
        IsAffine ((SmallEtale.toOver B S hS (pushout i f).1 ⋙
          BigFppfOver.toScheme B S hS).obj d.V) ∧ True},
    fun x => x.1, fun x => x.2.1, ?_, fun x => ?_⟩
  · refine GrothendieckTopology.superset_covering _ ?_
      (generate_affineChartDiagram_mem_topology B S hS g (fun _ => True) (fun _ _ => trivial) U)
    rintro Z k ⟨Z', a, b, hb, rfl⟩
    exact (Sieve.mem_ofArrows_iff _ _ _).2 ⟨⟨Z', b, hb⟩, a, rfl⟩
  · obtain ⟨Z, k, hZ, d, rfl, hV, -⟩ := x
    exact hP d hZ hV

include hi hf in
/-- **The converse half of Stacks 08KV (a)**: a quasi-coherent module flat over `Y'` whose two
restrictions are of finite type is of finite type. -/
theorem isFiniteType_of_restrict (M : Modules.{u, u} B S hS V'.1 V'.2)
    (hM : FlatQuasicoherentOver g M)
    (hG : ((modulePullback B S hS (targetRestriction i f g)).obj M).IsFiniteType)
    (hF : ((modulePullback B S hS (ambientRestriction i f g)).obj M).IsFiniteType) :
    M.IsFiniteType := by
  have hcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS V'.1 V'.2 M hM.1
  exact Stacks.SheafOfModules.isFiniteType_of_isFiniteTypeOnSite M ⟨fun U =>
    exists_cover_of_forall_affine_chartDiagram i f g U
      (fun Z => SheafOfModules.HasFiniteGlobalGenerators (M.over Z)) fun d hZ hV =>
      hasFiniteGlobalGenerators_over_of_moduleFinite B S hS V'.1 V'.2 M hcart d.U hZ
        (module_finite_sections_of_restrict i f g hi hf M hM hG hF d hZ hV)⟩

include hi hf in
/-- **Stacks 08KV (a), with the pushout given.** -/
theorem isFiniteType_iff_restrict_of_hasPushout (M : Modules.{u, u} B S hS V'.1 V'.2)
    (hM : FlatQuasicoherentOver g M) :
    M.IsFiniteType ↔
      ((TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
        (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
        (commonToAmbient_comp_eq i f g))).obj M).target.IsFiniteType ∧
      ((TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
        (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
        (commonToAmbient_comp_eq i f g))).obj M).ambient.IsFiniteType :=
  ⟨fun h => ⟨isFiniteType_modulePullback _ M h, isFiniteType_modulePullback _ M h⟩,
    fun h => isFiniteType_of_restrict i f g hi hf M hM h.1 h.2⟩

omit [HasPushout i f] in
include hi hf in
/-- **Stacks Project, Tag 08KV (a).**  Let `i : X ⟶ X'` be a thickening and `f : X ⟶ Y` an affine
morphism of algebraic spaces over `S`, let `Y' = Y ⨿_X X'` be their pushout (Stacks 07VX) and
`g : V' ⟶ Y'` a morphism, with `V = Y ×_{Y'} V'` and `U' = X' ×_{Y'} V'`.  If a quasi-coherent
`𝒪_{V'}`-module `𝒢'` flat over `Y'` corresponds to the triple `(𝒢, ℱ', φ)` under the equivalence
`AlgebraicGeometry.Space.PushoutModules.isEquivalence_flatRestrictionFunctor`, so that
`𝒢 = (V ⟶ V')^*𝒢'` and `ℱ' = (U' ⟶ V')^*𝒢'`, then `𝒢'` is of finite type if and only if `𝒢` and
`ℱ'` are of finite type. -/
@[stacks 08KV "(a)"]
theorem isFiniteType_iff_restrict :
    letI := hasPushout_of_isThickeningHom_of_isAffineHom B S hS i f hi hf
    ∀ {V' : AlgebraicSpaces B S hS} (g : V' ⟶ pushout i f)
      (M : (FlatQuasicoherentOver g).FullSubcategory),
      M.obj.IsFiniteType ↔
        (((FlatQuasicoherentTriple i f g).lift ((FlatQuasicoherentOver g).ι ⋙
          (TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
            (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
            (commonToAmbient_comp_eq i f g))))
          fun M => flatQuasicoherentTriple_restrict i f g M.obj
            M.property).obj M).obj.target.IsFiniteType ∧
        (((FlatQuasicoherentTriple i f g).lift ((FlatQuasicoherentOver g).ι ⋙
          (TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
            (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
            (commonToAmbient_comp_eq i f g))))
          fun M => flatQuasicoherentTriple_restrict i f g M.obj
            M.property).obj M).obj.ambient.IsFiniteType := by
  let := hasPushout_of_isThickeningHom_of_isAffineHom B S hS i f hi hf
  intro V' g M
  exact isFiniteType_iff_restrict_of_hasPushout i f g hi hf M.obj M.property

/-! ### Part (b): finite presentation -/

include hi hf in
/-- **Over an affine chart of `V'` carrying a Milnor cube, for `g` locally of finite
presentation, the sections of a quasi-coherent module flat over `Y'` whose two restrictions are of
finite presentation form a finitely presented module.** -/
theorem module_finitePresentation_sections_of_restrict
    (hg : IsLocallyOfFinitePresentation B S hS g.hom) (M : Modules.{u, u} B S hS V'.1 V'.2)
    (hM : FlatQuasicoherentOver g M)
    (hG : SheafOfModules.IsFinitePresentationOnSite
      ((modulePullback B S hS (targetRestriction i f g)).obj M))
    (hF : SheafOfModules.IsFinitePresentationOnSite
      ((modulePullback B S hS (ambientRestriction i f g)).obj M))
    (d : ChartDiagram B S hS V'.1 (pushout i f).1 g.hom) (hU : IsAffine (chartScheme d.U))
    (hV : IsAffine (chartScheme d.V)) :
    Module.FinitePresentation (chartRing B S hS V'.1 V'.2 d.U) (M.val.obj (op d.U)) := by
  have hWV := isAffine_smallBaseChange_obj B S hS _ (rep_targetRestriction i f g hi hf)
    (isAffineHom_targetRestriction i f g hi hf) d.U hU
  have hWU' := isAffine_smallBaseChange_obj B S hS _ (rep_ambientRestriction i f g hi hf)
    (isAffineHom_ambientRestriction i f g hi hf) d.U hU
  have hWU := isAffine_smallBaseChange_obj B S hS _ (rep_commonTargetComp i f g hi hf)
    (isAffineHom_commonTargetComp i f g hi hf) d.U hU
  have hYV := isAffine_smallBaseChange_obj B S hS _ (rep_inr i f hi hf)
    (isAffineHom_pushout_inr i f hi hf) d.V hV
  have hXV := isAffine_smallBaseChange_obj B S hS _ (rep_inl i f hi hf)
    (isAffineHom_pushout_inl i f hi hf) d.V hV
  have hT := flatQuasicoherentTriple_restrict i f g M hM
  have hGflat := (isFlatOverOnChartDiagram_iff_flat_sections B S hS _ _ hT.1
    (cubeTargetDiagram i f g hi hf d) hWV hYV).1 (hT.2.1 _)
  have hFflat := (isFlatOverOnChartDiagram_iff_flat_sections B S hS _ _ hT.2.2.1
    (cubeAmbientDiagram i f g hi hf d) hWU' hXV).1 (hT.2.2.2 _)
  have hflat := (isFlatOverOnChartDiagram_iff_flat_sections B S hS g M hM.1 d hU hV).1 (hM.2 d)
  have hσ : (chartDiagramRestrict B S hS g d).FinitePresentation := by
    have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS V'.1).obj d.U)) := hU
    have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS (pushout i f).1).obj d.V)) := hV
    show ((BigFppfOver.toScheme B S hS).map d.g).appTop.hom.FinitePresentation
    exact HasRingHomProperty.appTop (P := @LocallyOfFinitePresentation) _
      (locallyOfFinitePresentation_chartDiagram B S hS hg d)
  have hcube := isMilnorCube_chart i f g hi hf d hU hV
  have hbij := bijective_squareUnit_app_of_isMilnorCube (commonToTarget i f g)
    (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
    (commonToAmbient_comp_eq i f g) (rep_commonToTarget i f g hi hf)
    (rep_targetRestriction i f g hi hf) (rep_commonToAmbient i f g hi hf)
    (rep_ambientRestriction i f g hi hf) (rep_commonTargetComp i f g hi hf)
    (rep_commonAmbientComp i f g hi hf) d.U hWV hWU' hWU M hM.1 hU hcube hflat
  have hfp := finitePresentation_glue_of_isMilnorCube (commonToTarget i f g)
    (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
    (commonToAmbient_comp_eq i f g) (rep_commonToTarget i f g hi hf)
    (rep_targetRestriction i f g hi hf) (rep_commonToAmbient i f g hi hf)
    (rep_ambientRestriction i f g hi hf) (rep_commonTargetComp i f g hi hf)
    (rep_commonAmbientComp i f g hi hf) d.U
    ((TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
      (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
      (commonToAmbient_comp_eq i f g))).obj M) hT.1 hT.2.2.1 hWV hWU' hWU hcube
    (module_finitePresentation_sections_of_isFinitePresentationOnSite _ hT.1 hG _ hWV)
    (module_finitePresentation_sections_of_isFinitePresentationOnSite _ hT.2.2.1 hF _ hWU')
    hGflat hFflat hσ
  exact (LinearEquiv.finitePresentation_iff (LinearEquiv.ofBijective _ hbij)).2 hfp

include hi hf in
/-- **The converse half of Stacks 08KV (b)**: for `g` locally of finite presentation, a
quasi-coherent module flat over `Y'` whose two restrictions are of finite presentation is of
finite presentation. -/
theorem isFinitePresentationOnSite_of_restrict
    (hg : IsLocallyOfFinitePresentation B S hS g.hom) (M : Modules.{u, u} B S hS V'.1 V'.2)
    (hM : FlatQuasicoherentOver g M)
    (hG : SheafOfModules.IsFinitePresentationOnSite
      ((modulePullback B S hS (targetRestriction i f g)).obj M))
    (hF : SheafOfModules.IsFinitePresentationOnSite
      ((modulePullback B S hS (ambientRestriction i f g)).obj M)) :
    SheafOfModules.IsFinitePresentationOnSite M := by
  have hcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS V'.1 V'.2 M hM.1
  exact ⟨fun U => exists_cover_of_forall_affine_chartDiagram i f g U
    (fun Z => SheafOfModules.HasFiniteGlobalPresentation (M.over Z)) fun d hZ hV =>
    hasFiniteGlobalPresentation_over_of_moduleFinitePresentation B S hS V'.1 V'.2 M hcart
      d.U hZ (module_finitePresentation_sections_of_restrict i f g hi hf hg M hM hG hF d hZ hV)⟩

include hi hf in
/-- **Stacks 08KV (b), with the pushout given.** -/
theorem isFinitePresentationOnSite_iff_restrict_of_hasPushout
    (hg : IsLocallyOfFinitePresentation B S hS g.hom) (M : Modules.{u, u} B S hS V'.1 V'.2)
    (hM : FlatQuasicoherentOver g M) :
    SheafOfModules.IsFinitePresentationOnSite M ↔
      SheafOfModules.IsFinitePresentationOnSite
        ((TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
          (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
          (commonToAmbient_comp_eq i f g))).obj M).target ∧
      SheafOfModules.IsFinitePresentationOnSite
        ((TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
          (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
          (commonToAmbient_comp_eq i f g))).obj M).ambient :=
  ⟨fun h => ⟨isFinitePresentationOnSite_modulePullback B S hS _ M h,
      isFinitePresentationOnSite_modulePullback B S hS _ M h⟩,
    fun h => isFinitePresentationOnSite_of_restrict i f g hi hf hg M hM h.1 h.2⟩

omit [HasPushout i f] in
include hi hf in
/-- **Stacks Project, Tag 08KV (b).**  Let `i : X ⟶ X'` be a thickening and `f : X ⟶ Y` an affine
morphism of algebraic spaces over `S`, let `Y' = Y ⨿_X X'` be their pushout (Stacks 07VX) and
`g : V' ⟶ Y'` a morphism **locally of finite presentation**, with `V = Y ×_{Y'} V'` and
`U' = X' ×_{Y'} V'`.  If a quasi-coherent `𝒪_{V'}`-module `𝒢'` flat over `Y'` corresponds to the
triple `(𝒢, ℱ', φ)` under the equivalence
`AlgebraicGeometry.Space.PushoutModules.isEquivalence_flatRestrictionFunctor`, so that
`𝒢 = (V ⟶ V')^*𝒢'` and `ℱ' = (U' ⟶ V')^*𝒢'`, then `𝒢'` is of finite presentation if and only if
`𝒢` and `ℱ'` are of finite presentation
(Stacks 03DL (7), `SheafOfModules.IsFinitePresentationOnSite`). -/
@[stacks 08KV "(b)"]
theorem isFinitePresentationOnSite_iff_restrict :
    letI := hasPushout_of_isThickeningHom_of_isAffineHom B S hS i f hi hf
    ∀ {V' : AlgebraicSpaces B S hS} (g : V' ⟶ pushout i f),
      IsLocallyOfFinitePresentation B S hS g.hom →
      ∀ M : (FlatQuasicoherentOver g).FullSubcategory,
      (SheafOfModules.IsFinitePresentationOnSite M.obj ↔
        SheafOfModules.IsFinitePresentationOnSite
          (((FlatQuasicoherentTriple i f g).lift ((FlatQuasicoherentOver g).ι ⋙
            (TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
              (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
              (commonToAmbient_comp_eq i f g))))
            fun M => flatQuasicoherentTriple_restrict i f g M.obj M.property).obj M).obj.target ∧
        SheafOfModules.IsFinitePresentationOnSite
          (((FlatQuasicoherentTriple i f g).lift ((FlatQuasicoherentOver g).ι ⋙
            (TripleGluing.restrictFunctor (squareOverlap (commonToTarget i f g)
              (targetRestriction i f g) (commonToAmbient i f g) (ambientRestriction i f g)
              (commonToAmbient_comp_eq i f g))))
            fun M => flatQuasicoherentTriple_restrict i f g M.obj
              M.property).obj M).obj.ambient) := by
  let := hasPushout_of_isThickeningHom_of_isAffineHom B S hS i f hi hf
  intro V' g hg M
  exact isFinitePresentationOnSite_iff_restrict_of_hasPushout i f g hi hf hg M.obj M.property

end AlgebraicGeometry.Space.PushoutModules

end
