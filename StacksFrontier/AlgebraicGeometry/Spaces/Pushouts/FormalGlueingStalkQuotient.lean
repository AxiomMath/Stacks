/-! ### Algebra -/

namespace FormalGlueing

/-- For a flat ring map `R → S`, bijectivity of `R / I → S / IS` passes to every ideal `J`
containing a power of `I`: a `J`-power torsion module is `I`-power torsion. -/
theorem bijective_quotientMap_of_pow_le {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] {I J : Ideal R} {n : ℕ} (hIJ : I ^ n ≤ J)
    (hI : Function.Bijective
      (Ideal.quotientMap (I.map (algebraMap R S)) (algebraMap R S) Ideal.le_comap_map)) :
    Function.Bijective
      (Ideal.quotientMap (J.map (algebraMap R S)) (algebraMap R S) Ideal.le_comap_map) := by
  refine (IPowerTorsion.baseChange_bijective_iff_quotientMap_bijective.{u, v, 0} R S J
    inferInstance).1 fun M _ _ hM => ?_
  refine (IPowerTorsion.baseChange_bijective_iff_quotientMap_bijective.{u, v, 0} R S I
    inferInstance).2 hI M fun m => ?_
  obtain ⟨k, hk, hkm⟩ := hM m
  refine ⟨(n + 1) * k, by positivity, fun a ha => hkm a ?_⟩
  rw [pow_mul] at ha
  exact Ideal.pow_right_mono (le_trans (Ideal.pow_le_pow_right n.le_succ) hIJ) k ha

/-- **A flat algebra over a local target kills nothing that a unit-image element does not.**
If `P` is a flat `A`-algebra which is a local ring and `u ∈ A` maps to zero in `P`, then some
`a ∈ A` with `a u = 0` maps to a unit of `P`. This is the equational criterion of flatness
applied to the relation `u · 1 = 0`. -/
theorem exists_mul_eq_zero_isUnit_algebraMap {A P : Type*} [CommRing A] [CommRing P]
    [IsLocalRing P] [Algebra A P] [Module.Flat A P] (u : A) (hu : algebraMap A P u = 0) :
    ∃ a : A, a * u = 0 ∧ IsUnit (algebraMap A P a) := by
  have hrel : ∑ _i : Fin 1, u • (1 : P) = 0 := by
    rw [Fin.sum_univ_one, Algebra.smul_def, mul_one, hu]
  obtain ⟨k, a, y, hx, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
    (f := fun _ : Fin 1 => u) (x := fun _ : Fin 1 => (1 : P)) hrel
  have h1 : (1 : P) = ∑ j, algebraMap A P (a 0 j) * y j := by
    refine (hx 0).trans (Finset.sum_congr rfl fun j _ => ?_)
    rw [Algebra.smul_def]
  obtain ⟨j, hj⟩ : ∃ j, IsUnit (algebraMap A P (a 0 j)) := by
    by_contra! hcon
    have hmem : (∑ j, algebraMap A P (a 0 j) * y j) ∈ IsLocalRing.maximalIdeal P :=
      Ideal.sum_mem _ fun j _ =>
        Ideal.mul_mem_right _ _ ((IsLocalRing.mem_maximalIdeal _).2 (hcon j))
    rw [← h1] at hmem
    exact (IsLocalRing.mem_maximalIdeal _).1 hmem isUnit_one
  refine ⟨a 0 j, ?_, hj⟩
  rw [mul_comm]
  simpa only [Fin.sum_univ_one] using ha j

/-- **The algebra of a cartesian square of local rings.** Let `R → S'` and `R → T` be ring maps
with `R → T` surjective, let `γ : S' → P` be a local homomorphism into a local ring and
`δ : T → P` a bijection, and let `φ : S' ⊗_R T → P` be a flat ring map restricting to `γ` and
`δ` on the two factors. Then `R / K₀ → S' / K₀S'` is bijective, where `K₀ = ker(R → T)`.

The heart is that `γ s = 0` forces `s ∈ K₀S'`: by the equational criterion of flatness the
relation `(s ⊗ 1) · 1 = 0` in `P` is trivial, which produces an element of `S' ⊗_R T` killing
`s ⊗ 1` whose image in `P` is a unit; every element of `S' ⊗_R T` has the form `s' ⊗ 1`, and
`γ` is local, so that element is a unit and `s ⊗ 1 = 0`, i.e. `s ∈ K₀S'`. -/
theorem bijective_quotientMap_ker_of_tensor_flat {R S' T P : Type*} [CommRing R] [CommRing S']
    [CommRing T] [CommRing P] [Algebra R S'] [Algebra R T] [IsLocalRing P]
    (hβ : Function.Surjective (algebraMap R T))
    (γ : S' →+* P) [IsLocalHom γ] (δ : T →+* P) (hδ : Function.Bijective δ)
    (φ : TensorProduct R S' T →+* P)
    (hl : φ.comp Algebra.TensorProduct.includeLeftRingHom = γ)
    (hr : φ.comp Algebra.TensorProduct.includeRight.toRingHom = δ) (hφ : φ.Flat) :
    Function.Bijective
      (Ideal.quotientMap ((RingHom.ker (algebraMap R T)).map (algebraMap R S'))
        (algebraMap R S') Ideal.le_comap_map) := by
  set K₀ := RingHom.ker (algebraMap R T)
  set I' := K₀.map (algebraMap R S') with hI'
  have hγ (s : S') : φ (s ⊗ₜ[R] (1 : T)) = γ s := RingHom.congr_fun hl s
  have hδ' (t : T) : φ ((1 : S') ⊗ₜ[R] t) = δ t := RingHom.congr_fun hr t
  have hcomm (a : R) : γ (algebraMap R S' a) = δ (algebraMap R T a) := by
    rw [← hγ, ← hδ', Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one (A := T),
      TensorProduct.smul_tmul]
  have hsurjπ (u : TensorProduct R S' T) : ∃ s : S', s ⊗ₜ[R] (1 : T) = u := by
    induction u using TensorProduct.inductionOn with
    | tmul s t =>
      obtain ⟨a, rfl⟩ := hβ t
      refine ⟨a • s, ?_⟩
      rw [TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]
    | add u v hu hv =>
      obtain ⟨s, rfl⟩ := hu
      obtain ⟨s', rfl⟩ := hv
      exact ⟨s + s', TensorProduct.add_tmul _ _ _⟩
  have hker (s : S') (hs : γ s = 0) : s ⊗ₜ[R] (1 : T) = 0 := by
    let := φ.toAlgebra
    have : Module.Flat (TensorProduct R S' T) P := hφ
    obtain ⟨a, ha, hu⟩ := exists_mul_eq_zero_isUnit_algebraMap (s ⊗ₜ[R] (1 : T))
      ((hγ s).trans hs)
    obtain ⟨s', hs'⟩ := hsurjπ a
    have hu' : IsUnit a := by
      rw [← hs', RingHom.algebraMap_toAlgebra, hγ] at hu
      rw [← hs']
      exact (isUnit_of_map_unit γ s' hu).map Algebra.TensorProduct.includeLeftRingHom
    exact hu'.mul_right_eq_zero.1 ha
  have hle : RingHom.ker (Algebra.ofId R T) ≤ I'.comap (Algebra.ofId R S') := fun a ha =>
    Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr (RingHom.mem_ker.mp ha))
  let gT : T →ₐ[R] S' ⧸ I' :=
    (Ideal.quotientMapₐ I' (Algebra.ofId R S') hle).comp
      (Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R T) hβ).symm.toAlgHom
  let ρ : TensorProduct R S' T →ₐ[R] S' ⧸ I' :=
    Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ R I') gT (fun _ _ => Commute.all _ _)
  have hρ (s : S') : ρ (s ⊗ₜ[R] (1 : T)) = Ideal.Quotient.mk I' s := by
    simp [ρ]
  have hmemI (s : S') (hs : γ s = 0) : s ∈ I' :=
    Ideal.Quotient.eq_zero_iff_mem.mp (by rw [← hρ, hker s hs, map_zero])
  have hγI : I' ≤ RingHom.ker γ := by
    rw [hI', Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, hcomm, RingHom.mem_ker.mp ha, map_zero]
  constructor
  · rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact RingHom.mem_ker.mpr
      (hδ.1 (((hcomm a).symm.trans (RingHom.mem_ker.mp (hγI hx))).trans (map_zero δ).symm))
  · intro x
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨t, ht⟩ := hδ.2 (γ s)
    obtain ⟨a, rfl⟩ := hβ t
    refine ⟨Ideal.Quotient.mk K₀ a, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq]
    exact hmemI _ (by rw [map_sub, hcomm, ht, sub_self])

end FormalGlueing

namespace AlgebraicGeometry.Space

/-! ### Zero loci on an affine scheme -/

/-- On an affine scheme, an ideal of global sections with the same zero locus as a set of
global sections lies in the radical of the ideal that set generates. -/
theorem le_radical_span_of_zeroLocus_eq {X : Scheme.{u}} [IsAffine X] (I : Ideal Γ(X, ⊤))
    (s : Set Γ(X, ⊤))
    (h : X.zeroLocus (U := ⊤) (I : Set Γ(X, ⊤)) = X.zeroLocus (U := ⊤) s) :
    I ≤ (Ideal.span s).radical := by
  have h' := congrArg (fun t => X.isoSpec.hom '' t) h
  simp only [X.isoSpec_image_zeroLocus] at h'
  rw [← PrimeSpectrum.zeroLocus_subset_zeroLocus_iff, PrimeSpectrum.zeroLocus_span, h']

/-! ### Étale local rings -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The canonical homomorphism of étale local rings induced by an isomorphism of algebraic
spaces is bijective. -/
theorem bijective_etaleLocalRingMap_of_isIso {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : IsAlgebraicSpace B S hS F) (hG : IsAlgebraicSpace B S hS G) (f : F ⟶ G) [IsIso f]
    (x : GeometricPoint B S hS F) :
    Function.Bijective (etaleLocalRingMap hF f x) := by
  have hid {H : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hH : IsAlgebraicSpace B S hS H)
      (k : H ⟶ H) (hk : k = 𝟙 H) (p : GeometricPoint B S hS H) :
      Function.Bijective (etaleLocalRingMap hH k p) := by
    subst hk
    rw [etaleLocalRingMap_id B S hS hH p]
    exact Function.bijective_id
  have hb1 : Function.Bijective
      (etaleLocalRingMap hF f x ∘ etaleLocalRingMap hG (inv f) (geometricPointMap f x)) := by
    rw [← RingHom.coe_comp, etaleLocalRingMap_comp]
    exact hid hF _ (IsIso.hom_inv_id f) x
  have hb2 : Function.Bijective
      (etaleLocalRingMap hG (inv f) (geometricPointMap f x) ∘
        etaleLocalRingMap hF f (geometricPointMap (inv f) (geometricPointMap f x))) := by
    rw [← RingHom.coe_comp, etaleLocalRingMap_comp]
    exact hid hG _ (IsIso.inv_hom_id f) (geometricPointMap f x)
  have hinv : Function.Bijective (etaleLocalRingMap hG (inv f) (geometricPointMap f x)) :=
    ⟨hb1.1.of_comp, hb2.2.of_comp⟩
  exact (Function.Bijective.of_comp_iff _ hinv).1 hb1

/-- **The kernel of the surjection onto the étale local ring of a closed subspace lies in the
stalk of its defining ideal.** For a closed subspace `Z` of `X` and a geometric point `z̄` of
`Z`, an element of `𝒪_{X, z̄}` killed by `𝒪_{X, z̄} → 𝒪_{Z, z̄}` lies in `I_z̄`.

Such an element is the germ of a regular function on a pointed chart; transported to the
stalk rings of the small étale ringed topoi it is killed by the stalk homomorphism of Stacks
05V5, so by `AlgebraicGeometry.Space.exists_pointed_refinement_mem_kerIdeal` it lies in the
defining ideal after restriction to a smaller pointed chart. -/
theorem ker_etaleLocalRingMap_le_closedSubspaceStalkIdeal (X : AlgebraicSpaces B S hS)
    (Zc : ClosedSubspaces B S hS X.1) (w : GeometricPoint B S hS Zc.1.toFunctor) :
    RingHom.ker (etaleLocalRingMap Zc.2.1 Zc.1.ι w) ≤
      closedSubspaceStalkIdeal B S hS X Zc (geometricPointMap Zc.1.ι w) := by
  intro r hr
  let W : AlgebraicSpaces B S hS := ⟨Zc.1.toFunctor, Zc.2.1⟩
  let i : W ⟶ X := ObjectProperty.homMk Zc.1.ι
  obtain ⟨N, a, rfl⟩ :=
    (spaceGerms_isColimit (x := geometricPointMap Zc.1.ι w) X.2).ι_jointly_surjective r
  have h2 : (pointStalkRingEquiv B S hS X (geometricPointMap i.hom w)).symm
      (etaleLocalRingGerm B S hS X.1 (geometricPointMap Zc.1.ι w) N a) =
      (etaleSitePoint B S hS X.1 (geometricPointMap i.hom w) X.2).toPresheafFiber N.unop.chart
        ⟨N.unop.point, N.unop.point_comp⟩ (smallEtaleRingedTopos B S hS X).O.obj a := by
    rw [← pointStalkRingEquiv_germ_neighborhood B S hS X _ N.unop a]
    exact (pointStalkRingEquiv B S hS X _).symm_apply_apply _
  have hs : smallEtaleStalkPullbackRingMap B S hS i w
      ((etaleSitePoint B S hS X.1 (geometricPointMap i.hom w) X.2).toPresheafFiber N.unop.chart
        ⟨N.unop.point, N.unop.point_comp⟩ (smallEtaleRingedTopos B S hS X).O.obj a) = 0 := by
    apply (pointStalkRingEquiv B S hS W w).injective
    rw [map_zero, ← h2]
    exact (DFunLike.congr_fun (smallEtaleStalkPullbackEtaleLocalRingMap_eq B S hS i w)
      (etaleLocalRingGerm B S hS X.1 (geometricPointMap Zc.1.ι w) N a)).trans hr
  obtain ⟨V', c, q', hq', hmem⟩ := exists_pointed_refinement_mem_kerIdeal B S hS i Zc.2.2 w
    N.unop.chart ⟨N.unop.point, N.unop.point_comp⟩ a hs
  let N' : SmallEtaleNeighborhood (geometricPointMap Zc.1.ι w) := ⟨V', q'.1, q'.2⟩
  let m : N' ⟶ N.unop := ⟨c, congrArg Subtype.val hq'⟩
  exact Ideal.subset_span ⟨N', (smallEtaleRingedTopos B S hS X).O.obj.map c.op a,
    (SheafOfModules.mem_kerIdeal _ _ _).1 hmem,
    DFunLike.congr_fun (spaceGerm_naturality (x := geometricPointMap Zc.1.ι w) m.op) a⟩

/-- The kernel of the surjection onto the étale local ring of a closed subspace lies in the
stalk of its defining ideal, read at a geometric point of `X` equal to the image of the given
one. -/
theorem ker_etaleLocalRingMap_le_closedSubspaceStalkIdeal_of_eq (X : AlgebraicSpaces B S hS)
    (Zc : ClosedSubspaces B S hS X.1) (w : GeometricPoint B S hS Zc.1.toFunctor)
    (x : GeometricPoint B S hS X.1) (h : x = geometricPointMap Zc.1.ι w) :
    RingHom.ker ((eqToHom (congrArg (etaleLocalRing B S hS X.1) h) ≫
        CommRingCat.ofHom (etaleLocalRingMap Zc.2.1 Zc.1.ι w)).hom) ≤
      closedSubspaceStalkIdeal B S hS X Zc x := by
  subst h
  simpa using ker_etaleLocalRingMap_le_closedSubspaceStalkIdeal B S hS X Zc w

/-- **A power of the stalk of the defining ideal lies in the ideal of germs of functions with
the same zero locus.** On an affine pointed chart `N₀` at `x̄`, if regular functions `gᵢ` cut out
the part of the chart lying over a closed subspace `Z` of finite presentation, then some power
of `I_x̄` lies in the ideal generated by the germs of the `gᵢ`. -/
theorem exists_pow_closedSubspaceStalkIdeal_le (X : AlgebraicSpaces B S hS)
    (Zc : ClosedSubspaces B S hS X.1) (hZ : IsFinitePresentation B S hS Zc.1.ι)
    (x : GeometricPoint B S hS X.1) (N₀ : SmallEtaleNeighborhood x)
    (hN₀ : IsAffine (chartScheme N₀.chart)) {r : ℕ} (g : Fin r → chartRing B S hS X.1 X.2 N₀.chart)
    (hg : chartPointsMap N₀.chart ⁻¹' Set.range (pointsMap B S hS Zc.1.toFunctor Zc.1.ι) =
      (chartScheme N₀.chart).zeroLocus (U := ⊤) (Set.range g)) :
    ∃ n : ℕ, closedSubspaceStalkIdeal B S hS X Zc x ^ n ≤
      Ideal.span (Set.range fun i => etaleLocalRingGerm B S hS X.1 x (op N₀) (g i)) := by
  have hrad : chartDefiningIdeal B S hS X Zc N₀.chart ≤ (Ideal.span (Set.range g)).radical :=
    le_radical_span_of_zeroLocus_eq (X := chartScheme N₀.chart)
      (definingIdealAt B S hS X Zc (op N₀.chart)) (Set.range g)
      ((preimage_chartPointsMap_range_eq_zeroLocus_definingIdealAt B S hS X Zc N₀.chart
        hN₀).symm.trans hg)
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad
    (chartDefiningIdeal_fg B S hS X Zc hZ N₀.chart hN₀)
  refine ⟨n, ?_⟩
  rw [closedSubspaceStalkIdeal_eq_map B S hS X Zc x N₀ hN₀, ← Ideal.map_pow]
  calc (chartDefiningIdeal B S hS X Zc N₀.chart ^ n).map (chartGerm B S hS X x N₀)
      ≤ (Ideal.span (Set.range g)).map (chartGerm B S hS X x N₀) := Ideal.map_mono hn
    _ = Ideal.span (Set.range fun i => etaleLocalRingGerm B S hS X.1 x (op N₀) (g i)) := by
      rw [Ideal.map_span, ← Set.range_comp]
      rfl

namespace FormalGlueingSituation

variable {B S hS}

/-- **The étale local ring of `Y` is flat over that of `X` along `f⁻¹(Z)`.** In the formal
glueing situation, at a geometric point `ȳ` of `Y` lying on `f⁻¹(Z)` the canonical homomorphism
`𝒪_{X, f ∘ ȳ} → 𝒪_{Y, ȳ}` is flat: this is the flatness of `f` at the points of `f⁻¹(Z)` read
through the criterion of Stacks 04NG. -/
theorem flat_etaleLocalRingMap_of_mem_preimage (D : FormalGlueingSituation B S hS)
    (y : GeometricPoint B S hS D.Y)
    (hy : y.image ∈
      Set.range (pointsMap B S hS (D.Z.preimage D.f).toFunctor (D.Z.preimage D.f).ι)) :
    letI := (etaleLocalRingMap D.algebraicSpace_Y D.f y).toAlgebra
    Module.Flat ↥(etaleLocalRing B S hS D.X (geometricPointMap D.f y))
      ↥(etaleLocalRing B S hS D.Y y) := by
  obtain ⟨p, hp⟩ := hy
  have h := D.flat_at_preimage_Z p
  rw [hp] at h
  exact (isFlatAt_iff_etaleLocalRingMap_flat D.algebraicSpace_Y D.algebraicSpace_X D.f y).mp h

/-- **Stacks 05ER's quotient hypothesis at the étale local rings of the formal glueing
situation.** Let `ȳ` be a geometric point of `Y` lying on `f⁻¹(Z)`, with image `x̄ = f ∘ ȳ`, let
`N₀` be an affine pointed étale chart of `X` at `x̄` and let `g₁, …, g_r` be regular functions on
it whose common zero locus is the part of the chart lying over `Z`. With `J ⊆ 𝒪_{X, x̄}` the ideal
generated by the germs of the `gᵢ`, the canonical map `𝒪_{X, x̄} / J → 𝒪_{Y, ȳ} / J𝒪_{Y, ȳ}` is
bijective. -/
theorem bijective_quotientMap_etaleLocalRingMap (D : FormalGlueingSituation B S hS)
    (y : GeometricPoint B S hS D.Y)
    (hy : y.image ∈
      Set.range (pointsMap B S hS (D.Z.preimage D.f).toFunctor (D.Z.preimage D.f).ι))
    (N₀ : SmallEtaleNeighborhood (geometricPointMap D.f y))
    (hN₀ : IsAffine (chartScheme N₀.chart)) {r : ℕ}
    (g : Fin r → chartRing B S hS D.X D.algebraicSpace_X N₀.chart)
    (hg : chartPointsMap N₀.chart ⁻¹' Set.range (pointsMap B S hS D.Z.toFunctor D.Z.ι) =
      (chartScheme N₀.chart).zeroLocus (U := ⊤) (Set.range g)) :
    letI := (etaleLocalRingMap D.algebraicSpace_Y D.f y).toAlgebra
    Function.Bijective
      (Ideal.quotientMap
        ((Ideal.span (Set.range fun i =>
          etaleLocalRingGerm B S hS D.X (geometricPointMap D.f y) (op N₀) (g i))).map
          (algebraMap ↥(etaleLocalRing B S hS D.X (geometricPointMap D.f y))
            ↥(etaleLocalRing B S hS D.Y y)))
        (algebraMap ↥(etaleLocalRing B S hS D.X (geometricPointMap D.f y))
          ↥(etaleLocalRing B S hS D.Y y)) Ideal.le_comap_map) := by
  have hflat := D.flat_etaleLocalRingMap_of_mem_preimage y hy
  have hX := D.algebraicSpace_X
  have hY := D.algebraicSpace_Y
  have hZ := D.closed_Z
  have hP := isClosedSubspace_preimage B S hS D.f D.Z hX hY hZ
  obtain ⟨z, rfl⟩ := exists_geometricPoint_map_eq_of_mem_range B S hS
    (ObjectProperty.homMk (D.Z.preimage D.f).ι :
      (⟨(D.Z.preimage D.f).toFunctor, hP.1⟩ : AlgebraicSpaces B S hS) ⟶ ⟨D.Y, hY⟩) hP.2 y hy
  have hpb0 : IsPullback
      (ObjectProperty.homMk (D.Z.fromPreimage D.f) :
        (⟨(D.Z.preimage D.f).toFunctor, hP.1⟩ : AlgebraicSpaces B S hS) ⟶ ⟨D.Z.toFunctor, hZ.1⟩)
      (ObjectProperty.homMk (D.Z.preimage D.f).ι :
        (⟨(D.Z.preimage D.f).toFunctor, hP.1⟩ : AlgebraicSpaces B S hS) ⟶ ⟨D.Y, hY⟩)
      (ObjectProperty.homMk D.Z.ι :
        (⟨D.Z.toFunctor, hZ.1⟩ : AlgebraicSpaces B S hS) ⟶ ⟨D.X, hX⟩)
      (ObjectProperty.homMk D.f : (⟨D.Y, hY⟩ : AlgebraicSpaces B S hS) ⟶ ⟨D.X, hX⟩) :=
    IsPullback.of_map_of_faithful
      (F := ObjectProperty.ι (fun T : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u =>
        IsAlgebraicSpace B S hS T)) (Subfunctor.isPullback_preimage D.f D.Z)
  have hcart := cartesian_etaleStalk_tensor_flat B S hS _ _ _ _ hpb0.flip z
  dsimp only [IsEtaleStalkTensorFlat] at hcart
  obtain ⟨φ, hφl, hφr, hφflat⟩ := hcart
  have hw : geometricPointMap D.f (geometricPointMap (D.Z.preimage D.f).ι z) =
      geometricPointMap D.Z.ι (geometricPointMap (D.Z.fromPreimage D.f) z) :=
    congrArg (fun k => geometricPointMap k z) (Subfunctor.isPullback_preimage D.f D.Z).w.symm
  have : IsLocalRing ↥(etaleLocalRing B S hS (D.Z.preimage D.f).toFunctor z) :=
    isLocalRing_etaleLocalRing B S hS _ hP.1 z
  let : Algebra
      ↥(etaleLocalRing B S hS D.X
        (geometricPointMap D.f (geometricPointMap (D.Z.preimage D.f).ι z)))
      ↥(etaleLocalRing B S hS D.Y (geometricPointMap (D.Z.preimage D.f).ι z)) :=
    (etaleLocalRingMap hY D.f (geometricPointMap (D.Z.preimage D.f).ι z)).toAlgebra
  let : Algebra
      ↥(etaleLocalRing B S hS D.X
        (geometricPointMap D.f (geometricPointMap (D.Z.preimage D.f).ι z)))
      ↥(etaleLocalRing B S hS D.Z.toFunctor (geometricPointMap (D.Z.fromPreimage D.f) z)) :=
    ((eqToHom (congrArg (etaleLocalRing B S hS D.X) hw) ≫
      CommRingCat.ofHom
        (etaleLocalRingMap hZ.1 D.Z.ι (geometricPointMap (D.Z.fromPreimage D.f) z))).hom).toAlgebra
  have : IsLocalHom (etaleLocalRingMap hP.1 (D.Z.preimage D.f).ι z) :=
    isLocalHom_etaleLocalRingMap B S hS hP.1 hY _ z
  have hβsurj : Function.Surjective (algebraMap
      ↥(etaleLocalRing B S hS D.X
        (geometricPointMap D.f (geometricPointMap (D.Z.preimage D.f).ι z)))
      ↥(etaleLocalRing B S hS D.Z.toFunctor (geometricPointMap (D.Z.fromPreimage D.f) z))) :=
    (surjective_etaleLocalRingMap_of_isClosedImmersion B S hS
      (ObjectProperty.homMk D.Z.ι :
        (⟨D.Z.toFunctor, hZ.1⟩ : AlgebraicSpaces B S hS) ⟶ ⟨D.X, hX⟩) hZ.2
      (geometricPointMap (D.Z.fromPreimage D.f) z)).comp
      (ConcreteCategory.bijective_of_isIso (eqToHom (congrArg (etaleLocalRing B S hS D.X) hw))).2
  have : IsIso (D.Z.fromPreimage D.f) := D.iso_over_Z
  have hδ := bijective_etaleLocalRingMap_of_isIso B S hS hP.1 hZ.1 (D.Z.fromPreimage D.f) z
  have hK := FormalGlueing.bijective_quotientMap_ker_of_tensor_flat hβsurj
    (etaleLocalRingMap hP.1 (D.Z.preimage D.f).ι z)
    (etaleLocalRingMap hP.1 (D.Z.fromPreimage D.f) z) hδ φ hφl hφr hφflat
  have hK₀ := ker_etaleLocalRingMap_le_closedSubspaceStalkIdeal_of_eq B S hS ⟨D.X, hX⟩
    ⟨D.Z, hZ⟩ (geometricPointMap (D.Z.fromPreimage D.f) z) _ hw
  obtain ⟨n, hn⟩ := exists_pow_closedSubspaceStalkIdeal_le B S hS ⟨D.X, hX⟩ ⟨D.Z, hZ⟩
    D.finitePresentation_Z _ N₀ hN₀ g hg
  exact FormalGlueing.bijective_quotientMap_of_pow_le ((Ideal.pow_right_mono hK₀ n).trans hn) hK

/-- **Charts on which the closed part is cut out by finitely many functions.** At every
geometric point `x̄` of `X` there are an affine pointed étale chart `N₀` and finitely many
regular functions `g₁, …, g_r` on it whose common zero locus is exactly the part of the chart
lying over `Z`: the defining ideal of `Z` on an affine chart is finitely generated, because `Z`
is of finite presentation, and its zero locus is the part over `Z` (Stacks 0859, part (1)). -/
theorem exists_chart_zeroLocus_eq (D : FormalGlueingSituation B S hS)
    (x : GeometricPoint B S hS D.X) :
    ∃ (N₀ : SmallEtaleNeighborhood x) (_ : IsAffine (chartScheme N₀.chart)) (r : ℕ)
      (g : Fin r → chartRing B S hS D.X D.algebraicSpace_X N₀.chart),
      chartPointsMap N₀.chart ⁻¹' Set.range (pointsMap B S hS D.Z.toFunctor D.Z.ι) =
        (chartScheme N₀.chart).zeroLocus (U := ⊤) (Set.range g) := by
  obtain ⟨N⟩ := nonempty_smallEtaleNeighborhood D.algebraicSpace_X x
  obtain ⟨N₀, -, hN₀⟩ := exists_smallEtaleNeighborhoodHom_isAffine B S hS
    ⟨D.X, D.algebraicSpace_X⟩ x N
  obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (chartDefiningIdeal_fg B S hS ⟨D.X, D.algebraicSpace_X⟩ ⟨D.Z, D.closed_Z⟩
      D.finitePresentation_Z N₀.chart hN₀)
  exact ⟨N₀, hN₀, r, g, (preimage_chartPointsMap_range_eq_zeroLocus_definingIdealAt B S hS
    ⟨D.X, D.algebraicSpace_X⟩ ⟨D.Z, D.closed_Z⟩ N₀.chart hN₀).trans
    ((congrArg (fun I : Ideal Γ(chartScheme N₀.chart, ⊤) =>
      (chartScheme N₀.chart).zeroLocus (U := ⊤) (I : Set Γ(chartScheme N₀.chart, ⊤)))
        hg.symm).trans (Scheme.zeroLocus_span (X := chartScheme N₀.chart) (U := ⊤) _))⟩

end FormalGlueingSituation

end AlgebraicGeometry.Space

