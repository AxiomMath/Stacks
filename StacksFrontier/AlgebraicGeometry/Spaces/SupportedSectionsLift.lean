module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.Exact.Basic

/-!
# The algebra of lifting a supported section

This file is pure commutative algebra: the two module-theoretic steps of the proof that, for a
short exact sequence of modules which stays short exact after a base change killing one element,
the elements annihilated by that element form a right exact sequence.

## Main results

* `Stacks.SupportedSectionsLift.exists_smul_eq_zero_of_divisibility` is the lifting step: in an
  exact sequence `M₁ → M₂ → M₃ → 0`, an element of `M₃` annihilated by `c` lifts to an element
  of `M₂` annihilated by `c`, as soon as `c` divides back along `M₁`: whenever the image of an
  `x : M₁` is `c` times an element of `M₂`, already `x` is `c` times an element of `M₁`.
* `Stacks.SupportedSectionsLift.tmul_one_eq_zero_iff` identifies the kernel of
  `M → R' ⊗_R M, x ↦ 1 ⊗ x` for a surjective ring map `R ⟶ R'` as `I • M`, `I` the kernel.
* `Stacks.SupportedSectionsLift.divisibility_of_injective_lTensor` combines the two: injectivity
  of the base change of `φ : M₁ ⟶ M₂` along a surjection `R ⟶ R'` with kernel `(c)` is exactly
  the divisibility hypothesis of the first result.
-/

@[expose] public section

open TensorProduct

namespace Stacks.SupportedSectionsLift

universe u

variable {R : Type u} [CommRing R]

/-- **The lifting step.**  Let `M₁ → M₂ → M₃` be exact at `M₂` with `M₂ → M₃` surjective, and
let `c : R`.  Suppose that `c` *divides back*: an element of `M₁` whose image in `M₂` is `c`
times something is itself `c` times something.  Then every element of `M₃` annihilated by `c`
is the image of an element of `M₂` annihilated by `c`.

This is the argument of the scheme-level Stacks 080W: lift `s` to `y`, write `c • y = φ x`,
divide `x` by `c` and correct `y` by the image of the quotient. -/
theorem exists_smul_eq_zero_of_divisibility {M₁ M₂ M₃ : Type*}
    [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
    [AddCommGroup M₃] [Module R M₃]
    (φ : M₁ →ₗ[R] M₂) (ψ : M₂ →ₗ[R] M₃)
    (hex : Function.Exact φ ψ) (hψ : Function.Surjective ψ) (c : R)
    (hdvd : ∀ (x : M₁) (y : M₂), φ x = c • y → ∃ z : M₁, x = c • z)
    (s : M₃) (hs : c • s = 0) :
    ∃ y : M₂, c • y = 0 ∧ ψ y = s := by
  obtain ⟨y, rfl⟩ := hψ s
  obtain ⟨x, hx⟩ : c • y ∈ Set.range φ := (hex (c • y)).1 (by rw [map_smul, hs])
  obtain ⟨z, hz⟩ := hdvd x y hx
  refine ⟨y - φ z, ?_, ?_⟩
  · rw [smul_sub, ← hx, hz, map_smul, sub_self]
  · rw [map_sub, (hex (φ z)).2 ⟨z, rfl⟩, sub_zero]

section Quotient

variable {R' : Type u} [CommRing R'] [Algebra R R']
    (hsurj : Function.Surjective (algebraMap R R'))

include hsurj

/-- The target of a surjective algebra map, read as the quotient of the source by the kernel. -/
noncomputable def quotKerEquiv :
    (R ⧸ (RingHom.ker (algebraMap R R') : Ideal R)) ≃ₗ[R] R' :=
  LinearEquiv.ofBijective
    (Submodule.liftQ _ (Algebra.linearMap R R') le_rfl)
    ⟨LinearMap.ker_eq_bot.1 (Submodule.ker_liftQ_eq_bot _ _ _ le_rfl),
      fun y => by
        obtain ⟨r, rfl⟩ := hsurj y
        exact ⟨Ideal.Quotient.mk _ r, rfl⟩⟩

/-- `quotKerEquiv` sends the class of `r` to `algebraMap R R' r`. -/
theorem quotKerEquiv_mk (r : R) :
    quotKerEquiv (R := R) (R' := R') hsurj (Ideal.Quotient.mk _ r) = algebraMap R R' r := rfl

/-- The kernel of `M → R' ⊗_R M`, `x ↦ 1 ⊗ x`, for a surjective ring map `R ⟶ R'`: an element
dies exactly when it lies in `I • M`, where `I` is the kernel of the ring map. -/
theorem tmul_one_eq_zero_iff
    {M : Type u} [AddCommGroup M] [Module R M] (x : M) :
    (1 : R') ⊗ₜ[R] x = 0 ↔
      x ∈ (RingHom.ker (algebraMap R R') : Ideal R) • (⊤ : Submodule R M) := by
  set I : Ideal R := RingHom.ker (algebraMap R R')
  have hEmk : TensorProduct.congr (quotKerEquiv hsurj) (LinearEquiv.refl R M)
      (Ideal.Quotient.mk I 1 ⊗ₜ[R] x) = (1 : R') ⊗ₜ[R] x := by
    rw [TensorProduct.congr_tmul, quotKerEquiv_mk, map_one]
    rfl
  rw [← hEmk, LinearEquiv.map_eq_zero_iff, ← Submodule.Quotient.mk_eq_zero,
    ← TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul I x, LinearEquiv.map_eq_zero_iff, map_one]

end Quotient

/-- Membership in `Ideal.span {c} • ⊤` is divisibility by `c`. -/
theorem mem_span_singleton_smul_top_iff {M : Type*} [AddCommGroup M] [Module R M]
    (c : R) (x : M) :
    x ∈ (Ideal.span {c} : Ideal R) • (⊤ : Submodule R M) ↔ ∃ z : M, x = c • z := by
  rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists]
  exact ⟨fun ⟨z, _, hz⟩ => ⟨z, hz.symm⟩, fun ⟨z, hz⟩ => ⟨z, trivial, hz.symm⟩⟩

/-- **The divisibility hypothesis from a base change.**  Let `R ⟶ R'` be surjective with kernel
the ideal generated by `c`, and let `φ : M₁ →ₗ[R] M₂` have injective base change to `R'`.  Then
`c` divides back along `φ`. -/
theorem divisibility_of_injective_lTensor {R' : Type u} [CommRing R'] [Algebra R R']
    (hsurj : Function.Surjective (algebraMap R R'))
    {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
    (φ : M₁ →ₗ[R] M₂)
    (hinj : Function.Injective (φ.lTensor R'))
    (c : R) (hker : RingHom.ker (algebraMap R R') = Ideal.span {c})
    (x : M₁) (y : M₂) (hxy : φ x = c • y) :
    ∃ z : M₁, x = c • z := by
  have hc : algebraMap R R' c = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self c
  have h1 : (1 : R') ⊗ₜ[R] x = 0 := hinj (by
    rw [map_zero, LinearMap.lTensor_tmul, hxy, ← TensorProduct.smul_tmul, Algebra.smul_def,
      mul_one, hc, TensorProduct.zero_tmul])
  rwa [tmul_one_eq_zero_iff hsurj, hker, mem_span_singleton_smul_top_iff] at h1

end Stacks.SupportedSectionsLift

end
