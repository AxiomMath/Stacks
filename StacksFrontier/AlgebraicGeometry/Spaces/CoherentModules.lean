-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct

universe u v w m

namespace CategoryTheory.ObjectProperty

variable {C : Type*} [Category* C]

/-- In a preadditive category with finite products, a property of objects closed under finite
coproducts is closed under finite products: the limit of a finite discrete diagram is
isomorphic to the biproduct of its values, which is also their coproduct.

Closure under isomorphisms, which is what makes that transport possible, is not a hypothesis:
closure under finite coproducts gives closure under binary coproducts and under the empty
colimit, and those imply it. -/
lemma IsClosedUnderFiniteProducts.of_isClosedUnderFiniteCoproducts [Preadditive C]
    [HasFiniteProducts C] (P : ObjectProperty C) [P.IsClosedUnderFiniteCoproducts] :
    P.IsClosedUnderFiniteProducts := by
  have : HasFiniteBiproducts C := HasFiniteBiproducts.of_hasFiniteProducts
  have : P.IsClosedUnderIsomorphisms :=
    IsClosedUnderBinaryCoproducts.closedUnderIsomorphisms P
  refine ⟨fun J _ => ⟨?_⟩⟩
  rintro X ⟨p⟩
  exact P.prop_of_iso (IsLimit.conePointUniqueUpToIso (biproduct.isLimit _)
      ((IsLimit.postcomposeHomEquiv Discrete.natIsoFunctor _).2 p.isLimit))
    (P.prop_of_isColimit_cofan (biproduct.isColimit _)
      (fun j => p.prop_diag_obj (Discrete.mk j)))

end CategoryTheory.ObjectProperty

namespace Stacks.SheafOfModules

variable {X : Type u} [TopologicalSpace X]
  (R : Sheaf (Opens.grothendieckTopology X) RingCat.{u})

/-- Coherent sheaves of modules on a ringed space are closed under finite products: they are
closed under finite coproducts by Stacks 01BY (4) and under isomorphisms, and the two closure
conditions agree in an additive category. -/
instance coherentModules_isClosedUnderFiniteProducts :
    (coherentModules R).IsClosedUnderFiniteProducts :=
  ObjectProperty.IsClosedUnderFiniteProducts.of_isClosedUnderFiniteCoproducts _

end Stacks.SheafOfModules

namespace CategoryTheory.GrothendieckTopology

/-- Every object of a site covers the final object, taken as a family indexed by the objects
themselves: the identity of an object lies in the sieve of that family. -/
lemma coversTop_self {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) :
    J.CoversTop (fun Y : C => Y) := fun Y =>
  Sieve.id_mem_iff_eq_top.1
    ((Sieve.mem_ofObjects_iff (fun Y : C => Y) (𝟙 Y)).2 ⟨Y, ⟨𝟙 Y⟩⟩) ▸ J.top_mem Y

/-- If every object of a site carries a covering sieve each of whose members factors through an
object with the property `Good`, then the objects of a slice site whose underlying object is
`Good` cover that slice. -/
lemma coversTop_over_subtype {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    (Good : C → Prop) (U : C)
    (hcov : ∀ W : C, ∃ Sv : Sieve W, Sv ∈ J W ∧
      ∀ ⦃Y : C⦄ (h : Y ⟶ W), Sv h →
        ∃ (A : C) (l : Y ⟶ A) (m : A ⟶ W), Good A ∧ h = l ≫ m) :
    (J.over U).CoversTop (Subtype.val : {V : Over U // Good V.left} → Over U) := by
  intro Z
  obtain ⟨Sv, hSv, hfac⟩ := hcov Z.left
  refine (J.over U).superset_covering ?_ (J.overEquiv_symm_mem_over Z Sv hSv)
  intro Y q hq
  rw [Sieve.overEquiv_symm_iff] at hq
  obtain ⟨A, l, mm, hA, hql⟩ := hfac q.left hq
  rw [Sieve.mem_ofObjects_iff]
  refine ⟨⟨Over.mk (mm ≫ Z.hom), hA⟩, ⟨Over.homMk l ?_⟩⟩
  show l ≫ mm ≫ Z.hom = Y.hom
  rw [← Category.assoc, ← hql]
  exact Over.w q

end CategoryTheory.GrothendieckTopology

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}

/-- A zero sheaf of modules is of finite type in the sectionwise sense: the empty family of
sections generates it on every object, since all of its sections vanish. -/
theorem _root_.PresheafOfModules.isFiniteType_of_isZero {M : SheafOfModules.{m} R}
    (hM : IsZero M) : PresheafOfModules.IsFiniteType J M.val := by
  refine ⟨C, fun Y => Y, J.coversTop_self, fun _ => ⟨0, fun j => j.elim0, ?_⟩⟩
  intro V f t
  refine ⟨⊤, J.top_mem V, fun W g _ => ⟨fun j => j.elim0, ?_⟩⟩
  rw [Fin.sum_univ_zero, eq_zero_of_isZero hM _ t, map_zero]

/-- **Stacks Project, Tag 03DL(8) for a zero module.**  A zero sheaf of modules on a site is
coherent: it is of finite type because all of its sections vanish, and the relations among a
family of `n` of its sections are all of `R ^ n`, which the `n` standard basis sections
generate on every object of every slice site. -/
theorem IsCoherentOnSite.of_isZero {M : SheafOfModules.{m} R} (hM : IsZero M) :
    IsCoherentOnSite M where
  isFiniteType := PresheafOfModules.isFiniteType_of_isZero hM
  kernel_isFiniteType U n s := by
    have hsum : ∀ {A : Type w} [Ring A] {p : _root_.Submodule A (Fin n → A)} (c : Fin n → A)
        (y : Fin n → p) (j : Fin n), ((∑ i, c i • y i) : p).val j = ∑ i, c i * (y i).val j := by
      intro A _ p c y j
      simp
    have hres : ∀ {V' W' : Over U} (h : W' ⟶ V')
        (y : (PresheafOfModules.relations M.val s).obj (op V')) (k : Fin n),
        (((PresheafOfModules.relations M.val s).restrictₛₗ h.op) y).val k
          = R.obj.map h.left.op (y.val k) := fun _ _ _ => rfl
    refine ⟨Over U, fun Z => Z, (J.over U).coversTop_self, fun Z => ⟨n, fun j =>
      ⟨Pi.single j 1, LinearMap.mem_ker.2 (eq_zero_of_isZero hM _ _)⟩, ?_⟩⟩
    intro V f t
    refine ⟨⊤, (J.over U).top_mem V, fun W g _ =>
      ⟨fun j => R.obj.map g.left.op (t.val j), ?_⟩⟩
    refine Subtype.ext (funext fun j => ?_)
    refine (hsum (p := LinearMap.ker (Fintype.linearCombination
      (R.obj.obj (op W.left)) (fun i => M.val.restrictₛₗ W.hom.op (s i))))
      (fun i => R.obj.map g.left.op (t.val i)) _ j).trans ?_
    rw [hres g t j]
    have hδ : ∀ i : Fin n,
        (((PresheafOfModules.relations M.val s).restrictₛₗ (g ≫ f).op)
          ⟨Pi.single i 1, LinearMap.mem_ker.2 (eq_zero_of_isZero hM _ _)⟩).val j
          = if i = j then (1 : R.obj.obj (op W.left)) else 0 := by
      intro i
      refine Eq.trans (hres (g ≫ f) _ j) ?_
      by_cases h : i = j
      · subst h; simp
      · simp [Ne.symm h, h]
    simp only [hδ, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

end SheafOfModules

/-! ### Syzygies over a Noetherian ring, and their flat base change -/

/-- Over a Noetherian commutative ring the relations among a finite family of elements of an
arbitrary module are generated by finitely many relations, with the generation written out as
linear combinations.

No finiteness hypothesis on the module is needed: it is the free module `A ^ n` of coefficient
tuples which is Noetherian, and the relations are a submodule of it. -/
theorem IsNoetherianRing.exists_fin_generating_relations {A : Type*} [CommRing A]
    [IsNoetherianRing A] {M : Type*} [AddCommGroup M] [Module A M] {n : ℕ} (s : Fin n → M) :
    ∃ (k : ℕ) (g : Fin k → Fin n → A),
      (∀ j, ∑ i, g j i • s i = 0) ∧
        ∀ x : Fin n → A, ∑ i, x i • s i = 0 →
          ∃ b : Fin k → A, ∀ i, x i = ∑ j, b j * g j i := by
  classical
  set L : (Fin n → A) →ₗ[A] M := Fintype.linearCombination A s with hL
  have hmem : ∀ x : Fin n → A, x ∈ LinearMap.ker L ↔ ∑ i, x i • s i = 0 := by
    intro x
    rw [LinearMap.mem_ker, hL, Fintype.linearCombination_apply]
  obtain ⟨k, g₀, hg₀⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.1 (IsNoetherian.noetherian (LinearMap.ker L))
  refine ⟨k, fun j => (g₀ j : Fin n → A), fun j => ?_, fun x hx => ?_⟩
  · exact (hmem _).1 (hg₀ ▸ Submodule.subset_span ⟨j, rfl⟩)
  · have hx' : x ∈ Submodule.span A (Set.range g₀) := by rw [hg₀]; exact (hmem x).2 hx
    obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hx'
    exact ⟨b, fun i => by simpa [Finset.sum_apply, smul_eq_mul] using (congrFun hb i).symm⟩

namespace Module.Flat

/-- **Flat base change of syzygies.**  Let `A'` be a flat `A`-algebra, let `M` be an
`A`-module, and let the relations among `s₁, …, sₙ` in `M` be generated by `g₁, …, g_k`.  Then
the coefficient tuple of any vanishing expression `∑ᵢ tᵢ ⊗ sᵢ` in `A' ⊗[A] M` is an
`A'`-combination of the images of the `g_j`.

The relations among the images of the `sᵢ` in a module `M'` with `M' ≅ A' ⊗[A] M` are exactly
the vanishing expressions of this shape, so this is the statement that flat base change carries
a generating family of relations onto a generating family of relations.  The proof is the
equational criterion for vanishing,
`TensorProduct.vanishesTrivially_of_sum_tmul_eq_zero_of_rTensor_injective`, read after
`TensorProduct.comm`; its injectivity hypothesis is what flatness of `A'` over `A` supplies. -/
theorem exists_coeffs_of_sum_tmul_eq_zero {A A' : Type*} [CommRing A] [CommRing A']
    [Algebra A A'] [Module.Flat A A'] {M : Type*} [AddCommGroup M] [Module A M]
    {n k : ℕ} (s : Fin n → M) (g : Fin k → Fin n → A)
    (hspan : ∀ x : Fin n → A, ∑ i, x i • s i = 0 →
      ∃ b : Fin k → A, ∀ i, x i = ∑ j, b j * g j i)
    (t : Fin n → A') (ht : ∑ i, t i ⊗ₜ[A] s i = (0 : A' ⊗[A] M)) :
    ∃ c : Fin k → A', ∀ i, t i = ∑ j, c j * algebraMap A A' (g j i) := by
  have ht' : ∑ i, s i ⊗ₜ[A] t i = (0 : M ⊗[A] A') := by
    have h := congrArg (TensorProduct.comm A A' M) ht
    rw [map_sum, map_zero] at h
    simpa only [TensorProduct.comm_tmul] using h
  obtain ⟨l, a, y, hay, has⟩ :=
    TensorProduct.vanishesTrivially_of_sum_tmul_eq_zero_of_rTensor_injective A
      (Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective) ht'
  choose b hb using fun j : Fin l => hspan (fun i => a i j) (has j)
  refine ⟨fun r => ∑ j, algebraMap A A' (b j r) * y j, fun i => ?_⟩
  rw [hay i]
  have h1 : ∀ j : Fin l, a i j • y j
      = ∑ r, algebraMap A A' (b j r) * algebraMap A A' (g r i) * y j := by
    intro j
    rw [Algebra.smul_def, hb j i, map_sum]
    simp only [map_mul, Finset.sum_mul]
  rw [Finset.sum_congr rfl fun j _ => h1 j, Finset.sum_comm]
  exact Finset.sum_congr rfl fun r _ => by
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun j _ => by ring

end Module.Flat

/-! ### The presheaf of relations, componentwise -/

namespace PresheafOfModules

variable {C : Type u} [Category.{v} C] {R : Cᵒᵖ ⥤ RingCat.{w}} {M : PresheafOfModules.{m} R}
  {U : C} {n : ℕ} (s : Fin n → M.obj (op U))

/-- Restriction in the presheaf of relations among a finite family of sections is componentwise
restriction of the coefficients. -/
theorem relations_restrictₛₗ_val {V W : Over U} (h : W ⟶ V)
    (y : (relations M s).obj (op V)) (i : Fin n) :
    (((relations M s).restrictₛₗ h.op) y).val i = R.map h.left.op (y.val i) := rfl

end PresheafOfModules

namespace LinearMap

/-- A tuple of coefficients lies in the kernel of the linear-combination map of a finite family
exactly when the corresponding linear combination vanishes. -/
theorem mem_ker_fintypeLinearCombination {R : Type*} [Semiring R] {M : Type*}
    [AddCommMonoid M] [Module R M] {α : Type*} [Fintype α] (v : α → M) (y : α → R) :
    y ∈ LinearMap.ker (Fintype.linearCombination R v) ↔ ∑ i, y i • v i = 0 := by
  rw [LinearMap.mem_ker, Fintype.linearCombination_apply]

end LinearMap

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-- A coherent module on an algebraic space is a quasi-coherent module which is coherent on its
small étale ringed site.

The predicate is on all modules rather than only on the quasi-coherent ones, so that it
applies directly to kernels, cokernels and extensions formed in the ambient category of
modules.  It does not need the locally Noetherian assumption; that assumption enters the
characterizations of Stacks 07UB and the closure results of Stacks 07UC. -/
@[stacks 07UA]
class IsCoherent (M : Modules.{u, m} B S hS F hF) : Prop
    extends SheafOfModules.IsQuasicoherentOnSite M, SheafOfModules.IsCoherentOnSite M

/-- Coherence as a property of objects of the category of modules on an algebraic space. -/
abbrev isCoherent : ObjectProperty (Modules.{u, m} B S hS F hF) :=
  fun M => IsCoherent B S hS F hF M

/-- The category of coherent modules on an algebraic space: the full subcategory of the
modules on its small étale ringed site cut out by coherence.  This is the category `Coh(𝒪_X)`
of Stacks 07UC. -/
abbrev CoherentModules := (isCoherent.{u, m} B S hS F hF).FullSubcategory

/-- An object of the category of coherent modules on an algebraic space is coherent. -/
instance instIsCoherentCoherentModulesObj (M : CoherentModules.{u, m} B S hS F hF) :
    IsCoherent B S hS F hF M.obj := M.property

/-- A zero module on an algebraic space is coherent: it is quasi-coherent by
`SheafOfModules.IsQuasicoherentOnSite.of_isZero` and coherent on the site by
`SheafOfModules.IsCoherentOnSite.of_isZero`. -/
theorem IsCoherent.of_isZero {M : Modules.{u, m} B S hS F hF} (hM : IsZero M) :
    IsCoherent B S hS F hF M :=
  { __ := SheafOfModules.IsQuasicoherentOnSite.of_isZero hM
    __ := SheafOfModules.IsCoherentOnSite.of_isZero hM }

/-- The coherent modules on an algebraic space contain a zero object. -/
instance isCoherent_containsZero : (isCoherent.{u, u} B S hS F hF).ContainsZero where
  exists_zero := by
    obtain ⟨Z, hZ⟩ := HasZeroObject.zero (C := Modules.{u, u} B S hS F hF)
    exact ⟨Z, hZ, IsCoherent.of_isZero B S hS F hF hZ⟩

section Closure

variable [(isCoherent.{u, u} B S hS F hF).IsClosedUnderKernels]
  [(isCoherent.{u, u} B S hS F hF).IsClosedUnderCokernels]
  [(isCoherent.{u, u} B S hS F hF).IsClosedUnderFiniteCoproducts]

/-- **Stacks 07UC, abelian structure, reduced to the closure properties.**  The coherent
modules on an algebraic space form an abelian category as soon as coherence is closed under
kernels, cokernels and finite coproducts.  Containing the zero object is
`AlgebraicGeometry.Space.isCoherent_containsZero` and closure under isomorphisms follows from
closure under finite coproducts, so neither is a hypothesis.

The module universe is the universe `u` of the schemes, the one in which the ambient category
of all modules on the small étale ringed site is abelian.  Each of the three hypotheses contains
the corresponding closure property of quasi-coherence, which is Stacks 03M1, together with the
corresponding closure property of coherence on a ringed site, which is Stacks 01BY generalized
from a ringed space to a ringed site. -/
@[instance_reducible] noncomputable def coherentModules_abelian_of_closure :
    Abelian (CoherentModules.{u, u} B S hS F hF) :=
  have := ObjectProperty.IsClosedUnderFiniteProducts.of_isClosedUnderFiniteCoproducts
    (isCoherent.{u, u} B S hS F hF)
  inferInstance

end Closure

/-! ### The relations clause of coherence, for a module cartesian on affine charts -/

/-- Generation of the relations among a finite family of sections of a module `M` on an
algebraic space, over a `Good` chart `V` of a slice site: the Noetherian hypothesis at `V`
gives finitely many generating relations over `V`, because the relations are a submodule of
`𝒪_F(V) ^ n`, and flat base change carries them to the `Good` charts covering any chart over
`V`.

Flatness of the restriction map between two `Good` charts is automatic, since both are affine;
the base change of the sections is the hypothesis `hcart`.

`hcart` asks for the base change property of `AlgebraicGeometry.Space.IsCartesianOnAffineCharts`
only *between `Good` charts*, which is all this proof uses and is strictly weaker than the
property itself: the comparison appears once, over the restriction map from a `Good` chart `A`
to the `Good` chart `V`.  Between affine charts in general it is Stacks 03DX(2); between two
charts over one chart trivializing `M` it needs no cohomological input.  Only *injectivity* of
the comparison is used, so the weakest sufficient hypothesis is
`Function.Injective (sectionsBaseChange M f)`. -/
theorem exists_generators_relations_of_isCartesian (M : Modules.{u, m} B S hS F hF)
    (Good : (smallEtaleRingedSite B S hS F hF).C → Prop)
    (hcov : ∀ W : (smallEtaleRingedSite B S hS F hF).C, ∃ Sv : Sieve W,
      Sv ∈ (smallEtaleRingedSite B S hS F hF).J W ∧
      ∀ ⦃Y : (smallEtaleRingedSite B S hS F hF).C⦄ (h : Y ⟶ W), Sv h →
        ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A) (m : A ⟶ W),
          Good A ∧ h = l ≫ m)
    (haff : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A))
    (hnoeth : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsNoetherianRing (chartRing B S hS F hF A))
    (hcart : ∀ A A' : (smallEtaleRingedSite B S hS F hF).C, Good A → Good A' →
      ∀ f : A' ⟶ A, Function.Bijective (sectionsBaseChange M f))
    {U : (smallEtaleRingedSite B S hS F hF).C} {n : ℕ} (s : Fin n → M.val.obj (op U))
    (V : Over U) (hV : Good V.left) :
    ∃ (k : ℕ) (σ : Fin k → (PresheafOfModules.relations M.val s).obj (op V)),
      PresheafOfModules.Generates ((smallEtaleRingedSite B S hS F hF).J.over U)
        (PresheafOfModules.relations M.val s) σ := by
  classical
  let _ := chartRing_commRing B S hS F hF V.left
  have hVaff := haff _ hV
  have hVn : IsNoetherianRing (chartRing B S hS F hF V.left) := hnoeth _ hV
  obtain ⟨k, g, hg0, hgspan⟩ := IsNoetherianRing.exists_fin_generating_relations
    (A := chartRing B S hS F hF V.left) (M := M.val.obj (op V.left))
    (fun i => M.val.restrictₛₗ V.hom.op (s i))
  obtain ⟨σ, hσ⟩ : ∃ σ : Fin k → (PresheafOfModules.relations M.val s).obj (op V),
      ∀ j i, (σ j).val i = g j i :=
    ⟨fun j => ⟨g j, (LinearMap.mem_ker_fintypeLinearCombination _ (g j)).2 (hg0 j)⟩, fun _ _ => rfl⟩
  refine ⟨k, σ, ?_⟩
  intro W f t
  obtain ⟨Sv, hSv, hfac⟩ := hcov W.left
  refine ⟨(Sieve.overEquiv W).symm Sv,
    (smallEtaleRingedSite B S hS F hF).J.overEquiv_symm_mem_over W Sv hSv, ?_⟩
  intro Z q hq
  rw [Sieve.overEquiv_symm_iff] at hq
  obtain ⟨A, l, mm, hA, hleft⟩ := hfac q.left hq
  let A' : Over U := Over.mk (mm ≫ W.hom)
  let mA : A' ⟶ W := Over.homMk mm
  let lA : Z ⟶ A' := Over.homMk l (by
    show l ≫ mm ≫ W.hom = Z.hom
    rw [← Category.assoc, ← hleft]
    exact Over.w q)
  let _ := chartRing_commRing B S hS F hF A'.left
  have hAaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A) :=
    haff _ hA
  have hq2 : q = lA ≫ mA := Over.OverMorphism.ext hleft
  have hleft' : q.left = lA.left ≫ mA.left := hleft
  set φ : A'.left ⟶ V.left := (mA ≫ f).left with hφ
  let _ := chartAlgebra (hF := hF) φ
  have hflat : Module.Flat (chartRing B S hS F hF V.left) (chartRing B S hS F hF A'.left) :=
    flat_chartRestrict_of_isAffine (hF := hF) φ hVaff hAaff
  have hbij : Function.Bijective (sectionsBaseChange M φ) := hcart _ _ hV hA φ
  have hres : ∀ i : Fin n, M.val.restrictₛₗ A'.hom.op (s i)
      = chartRestrictLinear M φ (M.val.restrictₛₗ V.hom.op (s i)) := by
    intro i
    refine Eq.trans ?_ (M.val.map_comp_apply V.hom.op φ.op (s i))
    exact (M.val.congr_map_apply (congrArg Quiver.Hom.op (Over.w (mA ≫ f))) (s i)).symm
  have hrel : ∑ i, chartRestrict (hF := hF) mA.left (t.val i) •
      chartRestrictLinear M φ (M.val.restrictₛₗ V.hom.op (s i)) = 0 := by
    have ht := (LinearMap.mem_ker_fintypeLinearCombination _
      (fun i => chartRestrict (hF := hF) mA.left (t.val i))).1
        (((PresheafOfModules.relations M.val s).restrictₛₗ mA.op) t).2
    simpa only [hres] using ht
  have htens : (∑ i, (chartRestrict (hF := hF) mA.left (t.val i)) ⊗ₜ
      (M.val.restrictₛₗ V.hom.op (s i)) :
      TensorProduct (chartRing B S hS F hF V.left) (chartRing B S hS F hF A'.left)
        (M.val.obj (op V.left))) = 0 := by
    refine hbij.1 ?_
    rw [map_sum, map_zero]
    refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) hrel
    exact chartBaseChange_tmul M φ _ _
  obtain ⟨c, hc⟩ := Module.Flat.exists_coeffs_of_sum_tmul_eq_zero
    (A := chartRing B S hS F hF V.left) (A' := chartRing B S hS F hF A'.left)
    (fun i => M.val.restrictₛₗ V.hom.op (s i)) g hgspan
    (fun i => chartRestrict (hF := hF) mA.left (t.val i)) htens
  refine ⟨fun j => chartRestrict (hF := hF) lA.left (c j), ?_⟩
  refine Subtype.ext (funext fun i => ?_)
  refine Eq.trans (SheafOfModules.relations_sum_val Finset.univ _ _ i) ?_
  simp only [PresheafOfModules.relations_restrictₛₗ_val, hσ]
  have hop : (q ≫ f).left = lA.left ≫ φ := by
    rw [hq2, hφ]
    exact Category.assoc _ _ _
  have hc' : chartRestrict (hF := hF) mA.left (t.val i)
      = ∑ j, c j * chartRestrict (hF := hF) φ (g j i) := hc i
  show ∑ j, chartRestrict (hF := hF) lA.left (c j) *
    chartRestrict (hF := hF) (q ≫ f).left (g j i) = chartRestrict (hF := hF) q.left (t.val i)
  have hcomp : ∀ {X Y Z : (smallEtaleRingedSite B S hS F hF).C} {a : Y ⟶ X} {b : Z ⟶ Y}
      {e : Z ⟶ X} (h : e = b ≫ a) (x : chartRing B S hS F hF X), chartRestrict (hF := hF) e x
        = chartRestrict (hF := hF) b (chartRestrict (hF := hF) a x) := fun h x =>
    h ▸ DFunLike.congr_fun (chartRestrict_comp (hF := hF) _ _) x
  rw [hcomp hleft', hc', map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_mul, hcomp hop]

/-- **The relations clause of coherence on the small étale ringed site.**  Suppose that every
étale chart of `F` is covered by morphisms factoring through `Good` charts, that a `Good` chart
is affine with Noetherian ring of sections, and that `M` is cartesian on affine charts.  Then
the relations among a finite family of sections of `M` over any chart `U` are of finite type on
the slice site at `U`.

The covering family of the slice is all of the objects of the slice whose underlying chart is
`Good`; generation on such an object is
`AlgebraicGeometry.Space.exists_generators_relations_of_isCartesian`. -/
theorem isFiniteType_relations_of_isCartesian (M : Modules.{u, m} B S hS F hF)
    (Good : (smallEtaleRingedSite B S hS F hF).C → Prop)
    (hcov : ∀ W : (smallEtaleRingedSite B S hS F hF).C, ∃ Sv : Sieve W,
      Sv ∈ (smallEtaleRingedSite B S hS F hF).J W ∧
      ∀ ⦃Y : (smallEtaleRingedSite B S hS F hF).C⦄ (h : Y ⟶ W), Sv h →
        ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A) (m : A ⟶ W),
          Good A ∧ h = l ≫ m)
    (haff : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A))
    (hnoeth : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsNoetherianRing (chartRing B S hS F hF A))
    (hcart : ∀ A A' : (smallEtaleRingedSite B S hS F hF).C, Good A → Good A' →
      ∀ f : A' ⟶ A, Function.Bijective (sectionsBaseChange M f))
    (U : (smallEtaleRingedSite B S hS F hF).C) (n : ℕ) (s : Fin n → M.val.obj (op U)) :
    PresheafOfModules.IsFiniteType ((smallEtaleRingedSite B S hS F hF).J.over U)
      (PresheafOfModules.relations M.val s) :=
  ⟨{V : Over U // Good V.left}, Subtype.val,
    (smallEtaleRingedSite B S hS F hF).J.coversTop_over_subtype Good U hcov,
    fun Vs => exists_generators_relations_of_isCartesian B S hS F hF M Good hcov haff hnoeth
      hcart s Vs.1 Vs.2⟩

/-- A module of finite type on an algebraic space which is cartesian on affine charts is
coherent on the small étale ringed site, as soon as every chart is covered by affine charts
with Noetherian rings of sections.

This is the reverse implication of Stacks 07UB(1) ⇔ 07UB(2) with its two inputs carried as
hypotheses.  Quasi-coherence of `M` is not used: it is the base change criterion `hcart` which
replaces it, and over an affine chart that criterion is what quasi-coherence gives by Stacks
03DX(2). -/
theorem isCoherentOnSite_of_isCartesian (M : Modules.{u, m} B S hS F hF)
    (Good : (smallEtaleRingedSite B S hS F hF).C → Prop)
    (hcov : ∀ W : (smallEtaleRingedSite B S hS F hF).C, ∃ Sv : Sieve W,
      Sv ∈ (smallEtaleRingedSite B S hS F hF).J W ∧
      ∀ ⦃Y : (smallEtaleRingedSite B S hS F hF).C⦄ (h : Y ⟶ W), Sv h →
        ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A) (m : A ⟶ W),
          Good A ∧ h = l ≫ m)
    (haff : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A))
    (hnoeth : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsNoetherianRing (chartRing B S hS F hF A))
    (hcart : ∀ A A' : (smallEtaleRingedSite B S hS F hF).C, Good A → Good A' →
      ∀ f : A' ⟶ A, Function.Bijective (sectionsBaseChange M f))
    (hft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J M.val) :
    SheafOfModules.IsCoherentOnSite M where
  isFiniteType := hft
  kernel_isFiniteType U n s :=
    isFiniteType_relations_of_isCartesian B S hS F hF M Good hcov haff hnoeth hcart U n s

/-- **Stacks 07UB(1) ⇔ 07UB(2), reduced to a covering by Noetherian affine charts and to
Stacks 03DX(2).**  A module on an algebraic space whose charts are covered by affine charts with
Noetherian rings of sections, and which is cartesian on affine charts, is coherent exactly when
it is quasi-coherent and of finite type.

The forward direction is the two parent projections of
`AlgebraicGeometry.Space.IsCoherent`; the reverse is
`AlgebraicGeometry.Space.isCoherentOnSite_of_isCartesian`.  The module universe is free, as it
is in Stacks 07UB(2): neither clause needs the module sections to live in the universe of the
structure sheaf.

Two hypotheses stand between this and Stacks 07UB(2) itself.  The covering is what local
Noetherianity of the space gives, by
`AlgebraicGeometry.Space.exists_covering_through_noetherianAffine`, and `hcart` is Stacks
03DX(2). -/
theorem isCoherent_iff_isQuasicoherent_and_isFiniteType_of_isCartesian
    (M : Modules.{u, m} B S hS F hF)
    (Good : (smallEtaleRingedSite B S hS F hF).C → Prop)
    (hcov : ∀ W : (smallEtaleRingedSite B S hS F hF).C, ∃ Sv : Sieve W,
      Sv ∈ (smallEtaleRingedSite B S hS F hF).J W ∧
      ∀ ⦃Y : (smallEtaleRingedSite B S hS F hF).C⦄ (h : Y ⟶ W), Sv h →
        ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A) (m : A ⟶ W),
          Good A ∧ h = l ≫ m)
    (haff : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A))
    (hnoeth : ∀ A : (smallEtaleRingedSite B S hS F hF).C, Good A →
      IsNoetherianRing (chartRing B S hS F hF A))
    (hcart : ∀ A A' : (smallEtaleRingedSite B S hS F hF).C, Good A → Good A' →
      ∀ f : A' ⟶ A, Function.Bijective (sectionsBaseChange M f)) :
    IsCoherent B S hS F hF M ↔
      (M.IsQuasicoherentOnSite ∧
        PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J M.val) :=
  ⟨fun h => ⟨h.toIsQuasicoherentOnSite,
      SheafOfModules.IsCoherentOnSite.isFiniteType (F := M) (self := h.toIsCoherentOnSite)⟩,
    fun h =>
      { __ := h.1
        __ := isCoherentOnSite_of_isCartesian B S hS F hF M Good hcov haff hnoeth hcart h.2 }⟩

end AlgebraicGeometry.Space

end
