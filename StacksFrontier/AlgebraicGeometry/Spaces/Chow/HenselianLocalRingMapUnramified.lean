* [Stacks Project, Tag 04GS](https://stacks.math.columbia.edu/tag/04GS)
* [Stacks Project, Tag 0EMY](https://stacks.math.columbia.edu/tag/0EMY)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The chart stalk map -/

/-- **The stalk map of a pointed morphism of schemes which is étale extends the maximal ideal to
the maximal ideal**, in the spelling the chart square of
`AlgebraicGeometry.Space.exists_henselianLocalRingHom_chartSquare` uses: the stalk of the target
is taken at the distinguished point `v`, and compared with the stalk at the image of `u` by the
isomorphism of stalks at two equal points.

This is Stacks 00UW for the stalk map, `AlgebraicGeometry.map_maximalIdeal_stalkMap_of_etale`,
together with the fact that an isomorphism of local rings carries the maximal ideal onto the
maximal ideal. -/
theorem map_maximalIdeal_chartStalkMap_of_etale {P Q : Scheme.{u}} (j : Q ⟶ P)
    [AlgebraicGeometry.Etale j] {u : Q} {v : P} (hj : j.base u = v) :
    Ideal.map ((P.presheaf.stalkCongr (Inseparable.of_eq hj.symm)).hom ≫
        j.stalkMap u).hom (maximalIdeal (P.presheaf.stalk v)) =
      maximalIdeal (Q.presheaf.stalk u) := by
  have hcongr : Ideal.map (P.presheaf.stalkCongr (Inseparable.of_eq hj.symm)).hom.hom
      (maximalIdeal (P.presheaf.stalk v)) = maximalIdeal (P.presheaf.stalk (j.base u)) :=
    IsLocalRing.map_maximalIdeal_of_surjective _
      (ConcreteCategory.bijective_of_isIso
        (P.presheaf.stalkCongr (Inseparable.of_eq hj.symm)).hom).2
  rw [CommRingCat.hom_comp, ← Ideal.map_map, hcongr]
  exact map_maximalIdeal_stalkMap_of_etale j u

/-! ### The morphism of charts over an étale morphism of spaces is étale -/

/-- **The morphism of charts over an étale morphism of algebraic spaces is étale.** Let
`f : X ⟶ Y` be an étale morphism of algebraic spaces over `S`, let `U` be an elementary étale
neighbourhood of a point of `X`, let `V` be one of a point of `Y` and let `j : U ⟶ V` be a
morphism of the site with `j` over `f`. Then the morphism of schemes underlying `j` is étale.

The composite `U ⟶ X ⟶ Y` is étale by Stacks 03FT, and the square identifies it with
`j ≫ (V ⟶ Y)`; étaleness of `V ⟶ Y` then cancels, by Stacks 03FV in the form
`AlgebraicGeometry.Space.etale_of_etaleChart_square`. No surjectivity of `j` is used. -/
theorem etale_chartSquare_of_isEtale {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y)
    {x : points B S hS X} {y : points B S hS Y} (f : X ⟶ Y) (hf : IsEtale B S hS f)
    (U : ElementaryEtaleNeighborhood B S hS X hX x)
    (V : ElementaryEtaleNeighborhood B S hS Y hY y)
    (j : U.scheme ⟶ V.scheme) (hsq : yoneda.map j ≫ V.toSpace = U.toSpace ≫ f) :
    AlgebraicGeometry.Etale j.left.1 := by
  have hUY : IsEtale B S hS (U.toSpace ≫ f) := isEtale_comp B S hS U.etale_toSpace hf
  have hetV : (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf V.toSpace :=
    (isEtale_iff_presheaf_of_yoneda B S hS V.toSpace).1 V.etale_toSpace
  exact etale_of_etaleChart_square B S hS hY hUY (a' := 𝟙 (yoneda.obj U.scheme))
    (presheaf_etale_id B S hS U.scheme) hetV (by rw [hsq, Category.id_comp])

/-! ### Unramifiedness of the induced homomorphism of henselian local rings -/

/-- **Unramifiedness of the homomorphism of henselian local rings from the chart square.** Let
`U` be an elementary étale neighbourhood of `x` in `X`, let `V` be one of `y` in `Y`, let
`j : U ⟶ V` be a morphism of the site carrying the distinguished point to the distinguished
point whose underlying morphism of schemes is étale, and let
`φ : 𝒪^h_{Y, y} ⟶ 𝒪^h_{X, x}` agree with the stalk map of the square on the image of
`𝒪_{V, v}`. Then

  `𝔪_{𝒪^h_{Y, y}} · 𝒪^h_{X, x} = 𝔪_{𝒪^h_{X, x}}`.

Both maximal ideals are generated by the image of the maximal ideal of the chart stalk, by
Stacks 0EMY (`AlgebraicGeometry.Space.map_maximalIdeal_stalkToHenselianLocalRing`), and the two
composites out of `𝒪_{V, v}` agree, so the identity follows from the one for the chart stalk
map, which is Stacks 00UW. -/
theorem map_maximalIdeal_of_chartSquare {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (hYd : IsDecentSpace B S hS Y)
    {x : points B S hS X} {y : points B S hS Y}
    (U : ElementaryEtaleNeighborhood B S hS X hX x)
    (V : ElementaryEtaleNeighborhood B S hS Y hY y)
    (j : U.scheme ⟶ V.scheme) [AlgebraicGeometry.Etale j.left.1]
    (hj : j.left.1 U.point = V.point)
    (φ : (henselianLocalRing B S hS Y hY y hYd : Type (u + 1)) →+*
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)))
    (hcompat : ∀ a, φ (stalkToHenselianLocalRing B S hS Y hY y hYd V a) =
      stalkToHenselianLocalRing B S hS X hX x hXd U
        (((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
          j.left.1.stalkMap U.point).hom a)) :
    letI := henselianLocalRing_isLocalRing B S hS Y hY y hYd
    letI := henselianLocalRing_isLocalRing B S hS X hX x hXd
    Ideal.map φ (maximalIdeal (henselianLocalRing B S hS Y hY y hYd : Type (u + 1))) =
      maximalIdeal (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) := by
  let := henselianLocalRing_isLocalRing B S hS Y hY y hYd
  let := henselianLocalRing_isLocalRing B S hS X hX x hXd
  have hcomp : φ.comp (stalkToHenselianLocalRing B S hS Y hY y hYd V) =
      (stalkToHenselianLocalRing B S hS X hX x hXd U).comp
        ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
          j.left.1.stalkMap U.point).hom :=
    RingHom.ext hcompat
  rw [← map_maximalIdeal_stalkToHenselianLocalRing B S hS Y hY y hYd V, Ideal.map_map, hcomp,
    ← Ideal.map_map, map_maximalIdeal_chartStalkMap_of_etale j.left.1 hj,
    map_maximalIdeal_stalkToHenselianLocalRing B S hS X hX x hXd U]

/-- **The map of henselian local rings induced by an étale morphism of decent algebraic spaces
is unramified.** This is
`AlgebraicGeometry.Space.exists_henselianLocalRingHom_affineChartSquare` for an étale morphism
`f`, with the identity

  `𝔪_{𝒪^h_{Y, f(x)}} · 𝒪^h_{X, x} = 𝔪_{𝒪^h_{X, x}}`

added to its conclusions. Flatness of `f`, hence of `φ`, is a consequence of étaleness and is
stated outright rather than as an implication.

The chart square is the one that statement produces, taken in the form
`AlgebraicGeometry.Space.exists_henselianLocalRingHom_affineChartSquare` which also records
that the chart of `Y` is affine; the morphism of charts in it is étale because `f` is, by
`AlgebraicGeometry.Space.etale_chartSquare_of_isEtale`, and the identity then comes from
`AlgebraicGeometry.Space.map_maximalIdeal_of_chartSquare`. -/
theorem exists_henselianLocalRingHom_chartSquare_map_maximalIdeal_of_isEtale
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (hYd : IsDecentSpace B S hS Y)
    (f : X ⟶ Y) (hf : IsEtale B S hS f) (x : points B S hS X) :
    letI := henselianLocalRing_isLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd
    letI := henselianLocalRing_isLocalRing B S hS X hX x hXd
    ∃ (V : ElementaryEtaleNeighborhood B S hS Y hY (pointsMap B S hS X f x))
      (U : ElementaryEtaleNeighborhood B S hS X hX x) (j : U.scheme ⟶ V.scheme)
      (hj : j.left.1 U.point = V.point)
      (φ : (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1)) →+*
        (henselianLocalRing B S hS X hX x hXd : Type (u + 1))),
      yoneda.map j ≫ V.toSpace = U.toSpace ≫ f ∧
        IsAffine V.scheme.left.1 ∧
        IsLocalHom φ ∧
        (∀ a, φ (stalkToHenselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd V a) =
          stalkToHenselianLocalRing B S hS X hX x hXd U
            (((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
              j.left.1.stalkMap U.point).hom a)) ∧
        φ.Flat ∧
        AlgebraicGeometry.Etale j.left.1 ∧
        Ideal.map φ
            (maximalIdeal
              (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1))) =
          maximalIdeal (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) := by
  let := henselianLocalRing_isLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd
  let := henselianLocalRing_isLocalRing B S hS X hX x hXd
  obtain ⟨V, U, j, hj, φ, hsq, hVaff, hφloc, hcompat, hφflat⟩ :=
    exists_henselianLocalRingHom_affineChartSquare B S hS hX hXd hY hYd f x
  have : AlgebraicGeometry.Etale j.left.1 :=
    etale_chartSquare_of_isEtale B S hS hX hY f hf U V j hsq
  exact ⟨V, U, j, hj, φ, hsq, hVaff, hφloc, hcompat, hφflat (isFlat_of_isEtale B S hS hf),
    inferInstance,
    map_maximalIdeal_of_chartSquare B S hS hX hXd hY hYd U V j hj φ hcompat⟩

/-- **The map of henselian local rings induced by an étale morphism of decent algebraic spaces
is a flat, local, unramified homomorphism**, the chart square that produces it forgotten. This
is `AlgebraicGeometry.Space.exists_henselianLocalRingHom` for an étale morphism with the
identity `𝔪_{𝒪^h_{Y, f(x)}} · 𝒪^h_{X, x} = 𝔪_{𝒪^h_{X, x}}` added. -/
theorem exists_henselianLocalRingHom_map_maximalIdeal_of_isEtale
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (hYd : IsDecentSpace B S hS Y)
    (f : X ⟶ Y) (hf : IsEtale B S hS f) (x : points B S hS X) :
    letI := henselianLocalRing_isLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd
    letI := henselianLocalRing_isLocalRing B S hS X hX x hXd
    ∃ φ : (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1)) →+*
        (henselianLocalRing B S hS X hX x hXd : Type (u + 1)),
      IsLocalHom φ ∧ φ.Flat ∧
        Ideal.map φ
            (maximalIdeal
              (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1))) =
          maximalIdeal (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) := by
  let := henselianLocalRing_isLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd
  let := henselianLocalRing_isLocalRing B S hS X hX x hXd
  obtain ⟨V, U, j, hj, φ, -, -, hφloc, -, hφflat, -, hmax⟩ :=
    exists_henselianLocalRingHom_chartSquare_map_maximalIdeal_of_isEtale B S hS hX hXd hY hYd f
      hf x
  exact ⟨φ, hφloc, hφflat, hmax⟩

/-! ### At the generic points of prime divisors -/

section PrimeDivisor

variable {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
variable (hX : IsAlgebraicSpace B S hS X) (hdecX : IsDecentSpace B S hS X)
variable (hY : IsAlgebraicSpace B S hS Y) (hdecY : IsDecentSpace B S hS Y)
variable [∀ W : PrimeDivisor B S hS X,
  IsLocalRing ↥(W.genericHenselianLocalRing B S hS hX hdecX)]
variable [∀ W : PrimeDivisor B S hS Y,
  IsLocalRing ↥(W.genericHenselianLocalRing B S hS hY hdecY)]

/-- **The map of henselian local rings at the generic points of prime divisors along an étale
morphism is unramified.** Let `f : X ⟶ Y` be an étale morphism of decent algebraic spaces over
`S`, let `Z ⊆ X` and `Z' ⊆ Y` be prime divisors with generic points `ξ` and `ξ'`, and suppose
`ξ` lies over `ξ'`. There is a flat local homomorphism `φ : 𝒪^h_{Y, ξ'} ⟶ 𝒪^h_{X, ξ}` with

  `𝔪_{𝒪^h_{Y, ξ'}} · 𝒪^h_{X, ξ} = 𝔪_{𝒪^h_{X, ξ}}`.

This is `AlgebraicGeometry.Space.exists_henselianLocalRingHom_map_maximalIdeal_of_isEtale` at
the generic point of `Z`, which is how
`AlgebraicGeometry.Space.PrimeDivisor.exists_genericHenselianLocalRingHom` reads the
homomorphism itself. -/
theorem PrimeDivisor.exists_genericHenselianLocalRingHom_map_maximalIdeal_of_isEtale
    (f : X ⟶ Y) (hf : IsEtale B S hS f)
    (ZX : PrimeDivisor B S hS X) (ZY : PrimeDivisor B S hS Y)
    (hZ : pointsMap B S hS X f (ZX.genericPoint B S hS X) = ZY.genericPoint B S hS Y) :
    ∃ φ : ↥(ZY.genericHenselianLocalRing B S hS hY hdecY) →+*
        ↥(ZX.genericHenselianLocalRing B S hS hX hdecX),
      IsLocalHom φ ∧ φ.Flat ∧
        Ideal.map φ (maximalIdeal ↥(ZY.genericHenselianLocalRing B S hS hY hdecY)) =
          maximalIdeal ↥(ZX.genericHenselianLocalRing B S hS hX hdecX) := by
  have key := exists_henselianLocalRingHom_map_maximalIdeal_of_isEtale B S hS hX hdecX hY hdecY f
    hf (ZX.genericPoint B S hS X)
  rw [hZ] at key
  exact key

/-- **A prime divisor occurs with multiplicity one in the inverse image of its image under an
étale morphism.** With the notation above, the multiplicity
`AlgebraicGeometry.Space.primeDivisorFlatMultiplicity` of `Z` over `Z'` along the induced
homomorphism is one.

Unramifiedness makes the quotient `𝒪^h_{X, ξ} / 𝔪_{𝒪^h_{Y, ξ'}} 𝒪^h_{X, ξ}` the residue field
of `𝒪^h_{X, ξ}`, a simple module, whose length is one. This is the fact that turns the identity
`ord_Z(g ∘ f) = m · ord_{Z'}(g)` of Stacks 0EQA into an equality of orders of vanishing. -/
theorem PrimeDivisor.exists_genericHenselianLocalRingHom_primeDivisorFlatMultiplicity_eq_one
    (f : X ⟶ Y) (hf : IsEtale B S hS f)
    (ZX : PrimeDivisor B S hS X) (ZY : PrimeDivisor B S hS Y)
    (hZ : pointsMap B S hS X f (ZX.genericPoint B S hS X) = ZY.genericPoint B S hS Y) :
    ∃ φ : ↥(ZY.genericHenselianLocalRing B S hS hY hdecY) →+*
        ↥(ZX.genericHenselianLocalRing B S hS hX hdecX),
      IsLocalHom φ ∧ φ.Flat ∧
        Ideal.map φ (maximalIdeal ↥(ZY.genericHenselianLocalRing B S hS hY hdecY)) =
          maximalIdeal ↥(ZX.genericHenselianLocalRing B S hS hX hdecX) ∧
        primeDivisorFlatMultiplicity B S hS hX hdecX ZX hY hdecY ZY φ = ((1 : ℕ) : ℕ∞) := by
  obtain ⟨φ, hφloc, hφflat, hmax⟩ :=
    PrimeDivisor.exists_genericHenselianLocalRingHom_map_maximalIdeal_of_isEtale B S hS hX hdecX
      hY hdecY f hf ZX ZY hZ
  refine ⟨φ, hφloc, hφflat, hmax, ?_⟩
  rw [primeDivisorFlatMultiplicity, hmax, Nat.cast_one]
  have : IsSimpleModule ↥(ZX.genericHenselianLocalRing B S hS hX hdecX)
      (↥(ZX.genericHenselianLocalRing B S hS hX hdecX) ⧸
        maximalIdeal ↥(ZX.genericHenselianLocalRing B S hS hX hdecX)) :=
    isSimpleModule_iff_isCoatom.2
      (maximalIdeal.isMaximal ↥(ZX.genericHenselianLocalRing B S hS hX hdecX)).out
  exact Module.length_eq_one _ _

end PrimeDivisor

end AlgebraicGeometry.Space

end
