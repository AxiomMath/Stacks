/-! ### The pointed chart of `T` at the generic point of a fibre -/

section GenericChart

attribute [local instance] pointTopology

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (p : X ⟶ D.space) (hp : D.IsGood p)
    (L : Modules.{u, u} D.site D.base D.base_mem X hp.1)
    (hL : IsInvertibleSheaf D p hp L)

include hL in
/-- **The pointed étale chart of `T` at the generic point `ξ'` of a fibre.**  Let `V` be an affine
elementary étale neighborhood of `ξ = q(ξ')` trivializing `ℒ`.  The base change
`Spec 𝒜(V) ⟶ V` of `q`, pointed at the generic point of the fibre over the distinguished point of
`V`, is an elementary étale neighborhood `U` of `ξ'` in `T`, and the stalk map of
`Spec 𝒜(V) ⟶ V` at that point carries the maximal ideal onto the maximal ideal and has a residue
field extension generated by one transcendental element. -/
theorem exists_elementaryEtaleNeighborhood_torsorOfInvertible_generic
    (ξ' : points D.site D.base D.base_mem (torsorOfInvertibleSpace D p hp L hL).obj)
    (hξ' : ∀ t, pointsMap D.site D.base D.base_mem _
      (torsorOfInvertibleProjection D p hp L hL).hom t =
      pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ' →
        ξ' ⤳ t) :
    ∃ (V : ElementaryEtaleNeighborhood D.site D.base D.base_mem X hp.1
        (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ'))
      (U : ElementaryEtaleNeighborhood D.site D.base D.base_mem
        (torsorOfInvertibleSpace D p hp L hL).obj (torsorOfInvertibleSpace D p hp L hL).property ξ')
      (j : U.scheme ⟶ V.scheme) (hj : j.left.1 U.point = V.point),
      yoneda.map j ≫ V.toSpace = U.toSpace ≫ (torsorOfInvertibleProjection D p hp L hL).hom ∧
        IsTranscendentalOneLocalHom
          ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
            j.left.1.stalkMap U.point).hom := by
  obtain ⟨V, hVaff, ⟨e⟩⟩ := exists_trivializing_elementaryEtaleNeighborhood D p hp L hL
    (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ')
  have : IsAffine (chartScheme V.chart) := hVaff
  have hqc := isQuasiCompactObject_of_isAffine D.site D.base D.base_mem X V.chart hVaff
  have hjmap := toScheme_map_affineChartSpecHom D.site D.base D.base_mem (X := ⟨X, hp.1⟩)
    (laurentAlgebraSheaf D p hp L hL) (sectionsBelowCutoff_laurentAlgebraSheaf D p hp L hL) V.chart
  have hj : (BigFppfOver.toScheme D.site D.base D.base_mem).map
      (torsorOfInvertibleChartHom D p hp L hL V.chart)
      (torsorChartGenericPoint D p hp L hL e hqc V.point) = V.point := by
    rw [hjmap]
    exact specChartMap_torsorChartGenericPoint D p hp L hL e hqc V.point
  have sq := isPullback_torsorOfInvertible_chart D p hp L hL V.chart
  have sqA := isPullback_torsorOfInvertible_chart_algebraicSpaces D p hp L hL V.chart
  have hη := D.site.residueField_spec_contains (affineChartSpec D.site D.base D.base_mem
    (X := ⟨X, hp.1⟩) (laurentAlgebraSheaf D p hp L hL)
    (sectionsBelowCutoff_laurentAlgebraSheaf D p hp L hL) V.chart).left.property
    (torsorChartGenericPoint D p hp L hL e hqc V.point)
  have hpp : ∀ (v' : V.scheme.left.1) (hv' : D.site.Contains (Spec (.of
      (V.scheme.left.1.residueField v')))), v' = V.point →
      presheafPoint D.site D.base D.base_mem V.scheme v' hv' =
        presheafPoint D.site D.base D.base_mem V.scheme V.point V.residueField_contained := by
    rintro _ _ rfl
    rfl
  have hq0 : pointsMap D.site D.base D.base_mem _
      (yoneda.map (torsorOfInvertibleChartHom D p hp L hL V.chart))
      (presheafPoint D.site D.base D.base_mem _ (torsorChartGenericPoint D p hp L hL e hqc V.point)
        hη) = presheafPoint D.site D.base D.base_mem V.scheme V.point V.residueField_contained :=
    (pointsMap_presheafPoint D.site D.base D.base_mem _ _
      (torsorOfInvertibleChartHom D p hp L hL V.chart) _ hη
      (D.site.residueField_spec_contains V.scheme.left.property _)).trans (hpp _ _ hj)
  have hq : pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom
      (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleChartToSpace D p hp L hL V.chart)
        (presheafPoint D.site D.base D.base_mem _
          (torsorChartGenericPoint D p hp L hL e hqc V.point)
          hη)) =
      pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ' := by
    rw [← pointsMap_comp_apply, sq.w, pointsMap_comp_apply, hq0]
    exact V.map_point
  obtain ⟨w, hw1, hw2⟩ := exists_point_of_isPullback D.site D.base D.base_mem sqA ξ'
    (presheafPoint D.site D.base D.base_mem V.scheme V.point V.residueField_contained)
    V.map_point.symm
  change pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleChartToSpace D p hp L hL V.chart)
    w = ξ' at hw1
  change pointsMap D.site D.base D.base_mem _
    (yoneda.map (torsorOfInvertibleChartHom D p hp L hL V.chart)) w =
      presheafPoint D.site D.base D.base_mem V.scheme V.point V.residueField_contained at hw2
  have hws : (BigFppfOver.toScheme D.site D.base D.base_mem).map
      (torsorOfInvertibleChartHom D p hp L hL V.chart)
        (pointsToScheme D.site D.base D.base_mem _ w) =
        V.point :=
    (pointsToScheme_pointsMap_yoneda D.site D.base D.base_mem
      (torsorOfInvertibleChartHom D p hp L hL V.chart) w).symm.trans
      ((congrArg (pointsToScheme D.site D.base D.base_mem V.scheme) hw2).trans
        (pointsToScheme_presheafPoint D.site D.base D.base_mem V.scheme V.point _))
  have hsp : torsorChartGenericPoint D p hp L hL e hqc V.point ⤳
      pointsToScheme D.site D.base D.base_mem _ w := by
    refine torsorChartGenericPoint_specializes D p hp L hL e hqc V.point _ ?_
    rwa [← hjmap]
  have hsp' : @Specializes (points D.site D.base D.base_mem (yoneda.obj (affineChartSpec D.site
      D.base D.base_mem (X := ⟨X, hp.1⟩) (laurentAlgebraSheaf D p hp L hL)
      (sectionsBelowCutoff_laurentAlgebraSheaf D p hp L hL) V.chart)))
      (pointTopology D.site D.base D.base_mem _)
      (presheafPoint D.site D.base D.base_mem _
      (torsorChartGenericPoint D p hp L hL e hqc V.point) hη) w := by
    rwa [← (schemePointsHomeomorph D.site D.base D.base_mem _).isInducing.specializes_iff,
      schemePointsHomeomorph_apply, schemePointsHomeomorph_apply,
      pointsToScheme_presheafPoint]
  have hmap : pointsMap D.site D.base D.base_mem _
    (torsorOfInvertibleChartToSpace D p hp L hL V.chart)
      (presheafPoint D.site D.base D.base_mem _
        (torsorChartGenericPoint D p hp L hL e hqc V.point) hη) = ξ' := by
    have h1 : @Specializes _ (pointTopology D.site D.base D.base_mem _)
        (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleChartToSpace D p hp L hL V.chart)
          (presheafPoint D.site D.base D.base_mem _
            (torsorChartGenericPoint D p hp L hL e hqc V.point) hη)) ξ' := by
      have h := hsp'.map (continuous_pointsMap D.site D.base D.base_mem
        (torsorOfInvertibleChartToSpace D p hp L hL V.chart))
      rwa [hw1] at h
    have := t0Space_points_of_isDecentSpace D.site D.base D.base_mem
      (torsorOfInvertibleSpace D p hp L hL).property
      (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL))
    exact (h1.antisymm (hξ' _ hq)).eq
  have hmV : ∀ (v' : V.scheme.left.1) (hv' : D.site.Contains (Spec (.of
      (V.scheme.left.1.residueField v')))), v' = V.point →
      Mono (yoneda.map (residueFieldMap D.site D.base D.base_mem V.scheme v' hv') ≫
        V.toSpace) := by
    rintro _ _ rfl
    exact V.mono_residueField
  have hmono := mono_residueFieldMap_comp_of_isPullback D.site D.base D.base_mem sq
    (torsorChartGenericPoint D p hp L hL e hqc V.point) hη (hmV _ _ hj)
  let U : ElementaryEtaleNeighborhood D.site D.base D.base_mem
      (torsorOfInvertibleSpace D p hp L hL).obj (torsorOfInvertibleSpace D p hp L hL).property ξ' :=
    { scheme := affineChartSpec D.site D.base D.base_mem (X := ⟨X, hp.1⟩)
        (laurentAlgebraSheaf D p hp L hL) (sectionsBelowCutoff_laurentAlgebraSheaf D p hp L hL)
        V.chart
      point := torsorChartGenericPoint D p hp L hL e hqc V.point
      residueField_contained := hη
      toSpace := torsorOfInvertibleChartToSpace D p hp L hL V.chart
      etale_toSpace := isEtale_of_isPullback_yoneda D.site D.base D.base_mem sq.flip
        V.etale_toSpace
      map_point := hmap
      mono_residueField := hmono }
  refine ⟨V, U, torsorOfInvertibleChartHom D p hp L hL V.chart, hj, sq.w.symm, ?_⟩
  exact IsTranscendentalOneLocalHom.comp_bijective _ _ (ConcreteCategory.bijective_of_isIso _)
    (isTranscendentalOneLocalHom_stalkMap_congr hjmap _
      (isTranscendentalOneLocalHom_stalkMap_specChartMap D p hp L hL e hqc V.point))

/-! ### Clause (7) -/

include hL in
/-- **Stacks 0EQG, clause (7).**  In Situation 0EDT let `X/B` be good, let `ℒ` be an invertible
`𝒪_X`-module and `q : T = \underline{Spec}(⨁_{n ∈ ℤ} ℒ^{⊗ n}) ⟶ X`.  If `ξ' ∈ |T|` is the
generic point of the fibre of `|T| → |X|` over `ξ = q(ξ')` — every point of that fibre is a
specialization of `ξ'` — then the ring map `φ : 𝒪^h_{X, ξ} ⟶ 𝒪^h_{T, ξ'}` induced by `q` is flat,
`𝔪^h_{ξ'} = 𝔪^h_ξ 𝒪^h_{T, ξ'}`, and the residue field extension is purely transcendental of
transcendence degree `1`: it is generated by a single element transcendental over `κ(ξ)`.

The map `φ` is the one induced by `q`: it is the local homomorphism agreeing on the image of
`𝒪_{V, v}` with the stalk map of a commuting square of elementary étale neighborhoods
`U ⟶ V` over `q`, which determines it by the universal property of the henselization. -/
@[stacks 0EQG "clause (7): if ξ' ∈ |T| is the generic point of the fibre of |T| → |X| over ξ,
then the ring map O^h_{X,ξ} → O^h_{T,ξ'} induced by q (the local homomorphism compatible with the
stalk map of a commuting square of elementary etale neighbourhoods over q) is flat, the maximal
ideal of O^h_{T,ξ'} is m^h_ξ O^h_{T,ξ'}, and the residue field extension is purely transcendental
of transcendence degree 1 (generated by one element transcendental over the residue field of
O^h_{X,ξ})"]
theorem torsorOfInvertible_clause_seven
    (ξ' : points D.site D.base D.base_mem (torsorOfInvertibleSpace D p hp L hL).obj)
    (hξ' : ∀ t, pointsMap D.site D.base D.base_mem _
      (torsorOfInvertibleProjection D p hp L hL).hom t =
      pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ' →
        ξ' ⤳ t) :
    letI := henselianLocalRing_isLocalRing D.site D.base D.base_mem X hp.1
      (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ')
      (D.isDecentSpace_of_isGood p hp)
    letI := henselianLocalRing_isLocalRing D.site D.base D.base_mem
      (torsorOfInvertibleSpace D p hp L hL).obj (torsorOfInvertibleSpace D p hp L hL).property ξ'
      (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL))
    ∃ (V : ElementaryEtaleNeighborhood D.site D.base D.base_mem X hp.1
        (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ'))
      (U : ElementaryEtaleNeighborhood D.site D.base D.base_mem
        (torsorOfInvertibleSpace D p hp L hL).obj (torsorOfInvertibleSpace D p hp L hL).property ξ')
      (j : U.scheme ⟶ V.scheme) (hj : j.left.1 U.point = V.point)
      (φ : (henselianLocalRing D.site D.base D.base_mem X hp.1
          (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ')
          (D.isDecentSpace_of_isGood p hp) : Type (u + 1)) →+*
        (henselianLocalRing D.site D.base D.base_mem (torsorOfInvertibleSpace D p hp L hL).obj
          (torsorOfInvertibleSpace D p hp L hL).property ξ'
          (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL)) : Type (u + 1))),
      yoneda.map j ≫ V.toSpace = U.toSpace ≫ (torsorOfInvertibleProjection D p hp L hL).hom ∧
        (∀ a, φ (stalkToHenselianLocalRing D.site D.base D.base_mem X hp.1 _
            (D.isDecentSpace_of_isGood p hp) V a) =
          stalkToHenselianLocalRing D.site D.base D.base_mem _ _ ξ'
            (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL)) U
            (((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
              j.left.1.stalkMap U.point).hom a)) ∧
        ∃ _ : IsLocalHom φ,
          φ.Flat ∧
          Ideal.map φ (maximalIdeal _) = maximalIdeal _ ∧
          letI := (ResidueField.map φ).toAlgebra
          ∃ t : ResidueField (henselianLocalRing D.site D.base D.base_mem
              (torsorOfInvertibleSpace D p hp L hL).obj
                (torsorOfInvertibleSpace D p hp L hL).property
              ξ' (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL)) :
                Type (u + 1)),
            Transcendental (ResidueField (henselianLocalRing D.site D.base D.base_mem X hp.1
              (pointsMap D.site D.base D.base_mem _
                (torsorOfInvertibleProjection D p hp L hL).hom ξ')
              (D.isDecentSpace_of_isGood p hp) : Type (u + 1))) t ∧
            IntermediateField.adjoin (ResidueField
              (henselianLocalRing D.site D.base D.base_mem X hp.1
              (pointsMap D.site D.base D.base_mem _
                (torsorOfInvertibleProjection D p hp L hL).hom ξ')
              (D.isDecentSpace_of_isGood p hp) : Type (u + 1))) {t} = ⊤ := by
  let := henselianLocalRing_isLocalRing D.site D.base D.base_mem X hp.1
    (pointsMap D.site D.base D.base_mem _ (torsorOfInvertibleProjection D p hp L hL).hom ξ')
    (D.isDecentSpace_of_isGood p hp)
  let := henselianLocalRing_isLocalRing D.site D.base D.base_mem
    (torsorOfInvertibleSpace D p hp L hL).obj (torsorOfInvertibleSpace D p hp L hL).property ξ'
    (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL))
  obtain ⟨V, U, j, hj, hsq, hα⟩ :=
    exists_elementaryEtaleNeighborhood_torsorOfInvertible_generic D p hp L hL ξ' hξ'
  obtain ⟨φ, hφloc, hφ, hflat, htr⟩ := exists_henselianLocalRingHom_of_chartSquare D.site D.base
    D.base_mem (torsorOfInvertibleSpace D p hp L hL).property
    (D.isDecentSpace_of_isGood _ (isGood_torsorOfInvertible D p hp L hL)) hp.1
    (D.isDecentSpace_of_isGood p hp) (torsorOfInvertibleProjection D p hp L hL).hom ξ' V U j hj hsq
  exact ⟨V, U, j, hj, φ, hsq, hφ, hφloc, hflat (isFlat_torsorOfInvertibleProjection D p hp L hL),
    (htr hα).map_maximalIdeal, (htr hα).exists_transcendental⟩

end GenericChart

end Space

end AlgebraicGeometry

