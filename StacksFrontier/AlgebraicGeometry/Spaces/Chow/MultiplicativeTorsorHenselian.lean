module

public import StacksFrontier.Algebra.Polynomial.LaurentExtendedPrime
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.MultiplicativeTorsorIntegral
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.MultiplicativeTorsorTrivialization
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.ElementaryEtaleNeighborhoodGeometricPoint
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.HenselianLocalRingMapAffine
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.PresheafPointTransport
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.Sober

/-!
# The henselian local rings of the multiplicative torsor at the generic point of a fibre

In Situation 0EDT let `X/B` be good, let `ℒ` be an invertible `𝒪_X`-module and let
`q : T ⟶ X` be its multiplicative torsor.  This file proves clause (7) of Stacks 0EQG: if `ξ'` is
the generic point of the fibre of `|T| → |X|` over `ξ`, then `𝒪^h_{X, ξ} ⟶ 𝒪^h_{T, ξ'}` is flat,
`𝔪^h_{ξ'} = 𝔪^h_ξ 𝒪^h_{T, ξ'}`, and the residue field extension is purely transcendental of
transcendence degree one.

## Main results

* `AlgebraicGeometry.Space.exists_trivializing_elementaryEtaleNeighborhood`: an affine elementary
  étale neighborhood trivializing `ℒ`.
* `AlgebraicGeometry.Space.exists_elementaryEtaleNeighborhood_torsorOfInvertible_generic`: the
  pointed chart of `T` at the generic point of a fibre.
* `AlgebraicGeometry.Space.exists_henselianLocalRingHom_of_chartSquare`: the map of henselian
  local rings on a given square of charts.
* `AlgebraicGeometry.Space.torsorOfInvertible_clause_seven`: **Stacks 0EQG, clause (7).**

## References

* [Stacks Project, Tag 0EQG](https://stacks.math.columbia.edu/tag/0EQG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite IsLocalRing

universe u

namespace AlgebraicGeometry

/-! ### The generic point of a fibre of `Spec R[T, T⁻¹] ⟶ Spec R` -/

section LaurentSpec

variable (R : CommRingCat.{u}) (p : Spec R)

/-- The generic point `𝔭 R[T, T⁻¹]` of the fibre of `Spec R[T, T⁻¹] ⟶ Spec R` over `𝔭`. -/
def laurentExtendedPrimePoint : Spec (CommRingCat.of (LaurentPolynomial R)) :=
  ⟨LaurentPolynomial.extendedPrime p.asIdeal, inferInstance⟩

/-- The constant embedding `LaurentPolynomial.C : R → R[T, T⁻¹]` is the algebra map. -/
theorem laurentC_eq_algebraMap :
    (LaurentPolynomial.C : R →+* LaurentPolynomial R) = algebraMap R (LaurentPolynomial R) :=
  RingHom.ext LaurentPolynomial.C_eq_algebraMap

/-- The point `𝔭 R[T, T⁻¹]` lies over `𝔭` under `Spec R[T, T⁻¹] ⟶ Spec R`. -/
theorem spec_map_laurentC_laurentExtendedPrimePoint :
    (Spec.map (CommRingCat.ofHom (LaurentPolynomial.C : R →+* LaurentPolynomial R))).base
      (laurentExtendedPrimePoint R p) = p := by
  refine PrimeSpectrum.ext ?_
  change Ideal.comap (LaurentPolynomial.C : R →+* LaurentPolynomial R)
    (LaurentPolynomial.extendedPrime p.asIdeal) = p.asIdeal
  rw [laurentC_eq_algebraMap]
  exact LaurentPolynomial.comap_extendedPrime p.asIdeal

/-- **The point `𝔭 R[T, T⁻¹]` specializes to every point of the fibre over `𝔭`.** -/
theorem laurentExtendedPrimePoint_specializes (y : Spec (CommRingCat.of (LaurentPolynomial R)))
    (hy : (Spec.map (CommRingCat.ofHom (LaurentPolynomial.C : R →+* LaurentPolynomial R))).base y =
      p) :
    laurentExtendedPrimePoint R p ⤳ y := by
  refine (PrimeSpectrum.le_iff_specializes _ _).1 ?_
  refine LaurentPolynomial.extendedPrime_le p.asIdeal y.asIdeal ?_
  have := congrArg PrimeSpectrum.asIdeal hy
  change Ideal.comap (LaurentPolynomial.C : R →+* LaurentPolynomial R) y.asIdeal = p.asIdeal at this
  rwa [laurentC_eq_algebraMap] at this

/-- **The stalk map of `Spec R[T, T⁻¹] ⟶ Spec R` at the generic point of the fibre over `𝔭`**
carries the maximal ideal onto the maximal ideal, and its residue field extension is generated by
one transcendental element. -/
theorem isTranscendentalOneLocalHom_stalkMap_laurentC :
    IsTranscendentalOneLocalHom
      ((Spec.map (CommRingCat.ofHom (LaurentPolynomial.C : R →+* LaurentPolynomial R))).stalkMap
        (laurentExtendedPrimePoint R p)).hom := by
  rw [← Scheme.localRingHom_comp_stalkIso
    (CommRingCat.ofHom (LaurentPolynomial.C : R →+* LaurentPolynomial R))
    (laurentExtendedPrimePoint R p)]
  let x : Spec R := PrimeSpectrum.comap (CommRingCat.ofHom
    (LaurentPolynomial.C : R →+* LaurentPolynomial R)).hom (laurentExtendedPrimePoint R p)
  have h1 : Function.Bijective (Spec.stalkIso (CommRingCat.of (LaurentPolynomial R))
      (laurentExtendedPrimePoint R p)).inv.hom :=
    ConcreteCategory.bijective_of_isIso _
  have h2 : Function.Bijective (Spec.stalkIso R x).hom.hom := ConcreteCategory.bijective_of_isIso _
  exact IsTranscendentalOneLocalHom.comp_bijective _ _ h2
    (IsTranscendentalOneLocalHom.bijective_comp _ _ h1
      (LaurentPolynomial.isTranscendentalOneLocalHom_localRingHom p.asIdeal _
        (laurentC_eq_algebraMap R) _ rfl))

end LaurentSpec

/-! ### Stalk maps along isomorphisms -/

section StalkMap

/-- `IsTranscendentalOneLocalHom` of the stalk map at `y` is invariant under replacing the
morphism of schemes by an equal one. -/
theorem isTranscendentalOneLocalHom_stalkMap_congr {Y Z : Scheme.{u}} {f g : Y ⟶ Z} (h : f = g)
    (y : Y) (hg : IsTranscendentalOneLocalHom (g.stalkMap y).hom) :
    IsTranscendentalOneLocalHom (f.stalkMap y).hom :=
  h ▸ hg

/-- If the stalk map of `g` at `e y` is `IsTranscendentalOneLocalHom`, then so is the stalk map
of `e ≫ g` at `y`, for an isomorphism `e`. -/
theorem isTranscendentalOneLocalHom_stalkMap_iso_comp {Y' Y Z : Scheme.{u}} (e : Y' ⟶ Y) [IsIso e]
    (g : Y ⟶ Z) (y : Y') (hg : IsTranscendentalOneLocalHom (g.stalkMap (e y)).hom) :
    IsTranscendentalOneLocalHom ((e ≫ g).stalkMap y).hom := by
  rw [Scheme.Hom.stalkMap_comp]
  exact hg.bijective_comp _ _ (ConcreteCategory.bijective_of_isIso (e.stalkMap y))

/-- If the stalk map of `g` at `y` is `IsTranscendentalOneLocalHom`, then so is the stalk map of
`g ≫ e` at `y`, for an isomorphism `e`. -/
theorem isTranscendentalOneLocalHom_stalkMap_comp_iso {Y Z Z' : Scheme.{u}} (g : Y ⟶ Z)
    (e : Z ⟶ Z') [IsIso e] (y : Y) (hg : IsTranscendentalOneLocalHom (g.stalkMap y).hom) :
    IsTranscendentalOneLocalHom ((g ≫ e).stalkMap y).hom := by
  rw [Scheme.Hom.stalkMap_comp]
  exact hg.comp_bijective _ _ (ConcreteCategory.bijective_of_isIso (e.stalkMap (g y)))

end StalkMap

namespace Space

/-! ### The generic point of a fibre over a trivializing affine chart -/

section Chart

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (p : X ⟶ D.space) (hp : D.IsGood p)
    (L : Modules.{u, u} D.site D.base D.base_mem X hp.1)
    (hL : IsInvertibleSheaf D p hp L)
    {V : SmallEtale D.site D.base D.base_mem X}
    (e : L.over V ≅ SheafOfModules.unit ((tensorStructureSheaf D p hp).over V))
    (hV : (SmallEtale.topology D.site D.base D.base_mem X).IsQuasiCompactObject V)
    [IsAffine (chartScheme V)]

/-- The isomorphism `Spec 𝒜(V) ≅ Spec 𝒪(V)[T, T⁻¹]` over a trivializing chart. -/
abbrev torsorChartSpecIso :
    Spec ((laurentAlgebraSheaf D p hp L hL).right.obj.obj (op V)) ⟶
      Spec (CommRingCat.of (LaurentPolynomial Γ(chartScheme V, ⊤))) :=
  Spec.map (CommRingCat.ofHom (laurentChartRingEquiv D p hp L hL e hV).toRingHom :
    CommRingCat.of (LaurentPolynomial Γ(chartScheme V, ⊤)) ⟶
      (laurentAlgebraSheaf D p hp L hL).right.obj.obj (op V))

/-- **The generic point of the fibre of `Spec 𝒜(V) ⟶ V` over `v`**, for a chart `V` trivializing
`ℒ`: under `Spec 𝒜(V) ≅ Spec 𝒪(V)[T, T⁻¹]` it is the extension `𝔭_v 𝒪(V)[T, T⁻¹]` of the prime
of `v`. -/
def torsorChartGenericPoint (v : chartScheme V) :
    Spec ((laurentAlgebraSheaf D p hp L hL).right.obj.obj (op V)) :=
  (torsorChartSpecIso D p hp L hL e hV).homeomorph.symm
    (laurentExtendedPrimePoint Γ(chartScheme V, ⊤) ((chartScheme V).isoSpec.hom v))

/-- Under `Spec 𝒜(V) ≅ Spec 𝒪(V)[T, T⁻¹]`, the point `torsorChartGenericPoint v` is the extension
`𝔭_v 𝒪(V)[T, T⁻¹]` of the prime of `v`. -/
theorem torsorChartSpecIso_torsorChartGenericPoint (v : chartScheme V) :
    torsorChartSpecIso D p hp L hL e hV (torsorChartGenericPoint D p hp L hL e hV v) =
      laurentExtendedPrimePoint Γ(chartScheme V, ⊤) ((chartScheme V).isoSpec.hom v) :=
  (torsorChartSpecIso D p hp L hL e hV).homeomorph.apply_symm_apply _

/-- The point `torsorChartGenericPoint v` of `Spec 𝒜(V)` lies over `v`. -/
theorem specChartMap_torsorChartGenericPoint (v : chartScheme V) :
    specChartMap D.site D.base D.base_mem (X := ⟨X, hp.1⟩) (laurentAlgebraSheaf D p hp L hL) V
      (torsorChartGenericPoint D p hp L hL e hV v) = v := by
  rw [specChartMap_laurentAlgebraSheaf_eq D p hp L hL e hV]
  change (chartScheme V).isoSpec.inv (Spec.map (CommRingCat.ofHom LaurentPolynomial.C)
    (torsorChartSpecIso D p hp L hL e hV (torsorChartGenericPoint D p hp L hL e hV v))) = v
  rw [torsorChartSpecIso_torsorChartGenericPoint, spec_map_laurentC_laurentExtendedPrimePoint,
    Scheme.hom_inv_apply]

/-- **The point `torsorChartGenericPoint v` specializes to every point of the fibre over `v`.** -/
theorem torsorChartGenericPoint_specializes (v : chartScheme V)
    (y : Spec ((laurentAlgebraSheaf D p hp L hL).right.obj.obj (op V)))
    (hy : specChartMap D.site D.base D.base_mem (X := ⟨X, hp.1⟩)
      (laurentAlgebraSheaf D p hp L hL) V y = v) :
    torsorChartGenericPoint D p hp L hL e hV v ⤳ y := by
  rw [specChartMap_laurentAlgebraSheaf_eq D p hp L hL e hV] at hy
  change (chartScheme V).isoSpec.inv (Spec.map (CommRingCat.ofHom LaurentPolynomial.C)
    (torsorChartSpecIso D p hp L hL e hV y)) = v at hy
  have hy' : Spec.map (CommRingCat.ofHom (LaurentPolynomial.C :
      Γ(chartScheme V, ⊤) →+* LaurentPolynomial Γ(chartScheme V, ⊤)))
      (torsorChartSpecIso D p hp L hL e hV y) = (chartScheme V).isoSpec.hom v := by
    rw [← hy, Scheme.inv_hom_apply]
  have h := (laurentExtendedPrimePoint_specializes _ _ _ hy').map
    (torsorChartSpecIso D p hp L hL e hV).homeomorph.symm.continuous
  rw [← torsorChartSpecIso_torsorChartGenericPoint D p hp L hL e hV v] at h
  have e1 : ∀ z, (torsorChartSpecIso D p hp L hL e hV).homeomorph.symm
      (torsorChartSpecIso D p hp L hL e hV z) = z :=
    fun z => (torsorChartSpecIso D p hp L hL e hV).homeomorph.symm_apply_apply z
  rwa [e1, e1] at h

/-- **The stalk map of `Spec 𝒜(V) ⟶ V` at the generic point of the fibre over `v`** carries the
maximal ideal onto the maximal ideal, and its residue field extension is generated by one
transcendental element. -/
theorem isTranscendentalOneLocalHom_stalkMap_specChartMap (v : chartScheme V) :
    IsTranscendentalOneLocalHom ((specChartMap D.site D.base D.base_mem (X := ⟨X, hp.1⟩)
      (laurentAlgebraSheaf D p hp L hL) V).stalkMap
        (torsorChartGenericPoint D p hp L hL e hV v)).hom := by
  refine isTranscendentalOneLocalHom_stalkMap_congr
    (specChartMap_laurentAlgebraSheaf_eq D p hp L hL e hV) _ ?_
  refine isTranscendentalOneLocalHom_stalkMap_iso_comp _ _ _ ?_
  have key : ∀ y, y = laurentExtendedPrimePoint Γ(chartScheme V, ⊤)
      ((chartScheme V).isoSpec.hom v) →
      IsTranscendentalOneLocalHom ((Spec.map (CommRingCat.ofHom (LaurentPolynomial.C :
        Γ(chartScheme V, ⊤) →+* LaurentPolynomial Γ(chartScheme V, ⊤))) ≫
          (chartScheme V).isoSpec.inv).stalkMap y).hom := by
    rintro _ rfl
    exact isTranscendentalOneLocalHom_stalkMap_comp_iso _ _ _
      (isTranscendentalOneLocalHom_stalkMap_laurentC _ _)
  exact key _ (torsorChartSpecIso_torsorChartGenericPoint D p hp L hL e hV v)

end Chart

/-! ### An affine elementary étale neighborhood trivializing `ℒ` -/

section Neighborhood

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (p : X ⟶ D.space) (hp : D.IsGood p)
    (L : Modules.{u, u} D.site D.base D.base_mem X hp.1)
    (hL : IsInvertibleSheaf D p hp L)

include hL in
/-- **Every point of `X` has an affine elementary étale neighborhood over which `ℒ` is
trivial.** -/
theorem exists_trivializing_elementaryEtaleNeighborhood (x : points D.site D.base D.base_mem X) :
    ∃ V : ElementaryEtaleNeighborhood D.site D.base D.base_mem X hp.1 x,
      IsAffine V.scheme.left.1 ∧
        Nonempty (L.over V.chart ≅ SheafOfModules.unit
          ((tensorStructureSheaf D p hp).over V.chart)) := by
  obtain ⟨V₀, hV₀, -⟩ := exists_affine_elementaryEtaleNeighborhood' D.site D.base D.base_mem hp.1
    (D.isDecentSpace_of_isGood p hp) x
  have hL' : IsInvertibleModule (B := D.site) ⟨X, hp.1⟩ L :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL
  obtain ⟨g, hvg, ee, hcompat, hbij⟩ := exists_basicOpen_freeGenerator D.site D.base D.base_mem
    ⟨X, hp.1⟩ L hL' V₀.chart hV₀ V₀.point
  let V := openRestrictionNeighborhood D.site D.base D.base_mem X hp.1 x V₀
    (V₀.scheme.left.1.basicOpen g) hvg
  let O : (chartScheme V₀.chart).Opens := (chartScheme V₀.chart).basicOpen g
  have hO : (Over.hom (openChart D.site D.base D.base_mem X V₀.chart O).obj.left).hom =
      O.ι ≫ V₀.scheme.hom.hom := by
    change D.site.inclusion.map (D.site.inclusion.preimage _ ≫ _) = _
    rw [Functor.map_comp, Functor.map_preimage]
    rfl
  let h₀ : V.chart.obj.left ⟶ (openChart D.site D.base D.base_mem X V₀.chart O).obj.left :=
    Over.homMk (ObjectProperty.homMk (𝟙 O.toScheme)) (by
      apply ObjectProperty.hom_ext
      rw [ObjectProperty.FullSubcategory.comp_hom, hO]
      exact Category.id_comp _)
  have hh₀ : h₀ ≫ openSubHom _ O = openRestrictionMap D.site D.base D.base_mem X hp.1 x V₀ O := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    change (ObjectProperty.homMk (𝟙 O.toScheme) ≫ (openSubHom _ O).left).hom =
      (openRestrictionMap D.site D.base D.base_mem X hp.1 x V₀ O).left.hom
    rw [ObjectProperty.FullSubcategory.comp_hom]
    exact (Category.id_comp _).trans (toScheme_map_openSubHom D.site D.base D.base_mem _ O)
  let m : V.chart ⟶ openChart D.site D.base D.base_mem X V₀.chart O :=
    ObjectProperty.homMk (CostructuredArrow.homMk h₀ (by
      refine Eq.trans ?_ (congrArg (fun k => yoneda.map k ≫ V₀.toSpace) hh₀)
      refine Eq.trans ?_ (congrArg (fun k => k ≫ V₀.toSpace) (yoneda.map_comp h₀ _).symm)
      exact (Category.assoc _ _ _).symm))
  exact ⟨V, (isAffineOpen_top V₀.scheme.left.1).basicOpen g,
    nonempty_iso_unit_of_freeFamily D p hp L V.chart (fun W k => ee W (k ≫ m))
      (fun W W' k h => (hcompat W W' (k ≫ m) h).trans (by rw [Category.assoc]))
      (fun W k => hbij W (k ≫ m))⟩

end Neighborhood

/-! ### Residue-field points along a cartesian square -/

section MonoResidueField

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The residue-field point of a point of a base change is a monomorphism** as soon as the
residue-field point of its image is: if `W = V ×_X T` and `Spec κ(v) ⟶ X` is a monomorphism for
`v = j(η)`, then `Spec κ(η) ⟶ T` is a monomorphism. -/
theorem mono_residueFieldMap_comp_of_isPullback {W V : BigFppfOver B S hS}
    {T Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {c : yoneda.obj W ⟶ T} {j : W ⟶ V} {q : T ⟶ Y}
    {g : yoneda.obj V ⟶ Y} (sq : IsPullback c (yoneda.map j) q g) (η : W.left.1)
    (hη : B.Contains (Spec (.of (W.left.1.residueField η))))
    (hmV : Mono (yoneda.map (residueFieldMap B S hS V (j.left.1 η)
      (B.residueField_spec_contains V.left.property (j.left.1 η))) ≫ g)) :
    Mono (yoneda.map (residueFieldMap B S hS W η hη) ≫ c) := by
  have := mono_yoneda_map_residueFieldMap B S hS W η hη
  refine ⟨fun {P} a b hab => ?_⟩
  have hrj : yoneda.map (residueFieldMap B S hS W η hη) ≫ yoneda.map j =
      yoneda.map (residueFieldObjectMap B S hS W V j η) ≫
        yoneda.map (residueFieldMap B S hS V (j.left.1 η)
          (B.residueField_spec_contains V.left.property (j.left.1 η))) := by
    rw [← yoneda.map_comp, ← yoneda.map_comp, residueFieldObjectMap_comp B S hS W V j η]
  have h3 : (a ≫ yoneda.map (residueFieldObjectMap B S hS W V j η)) ≫
      (yoneda.map (residueFieldMap B S hS V (j.left.1 η)
        (B.residueField_spec_contains V.left.property (j.left.1 η))) ≫ g) =
      (b ≫ yoneda.map (residueFieldObjectMap B S hS W V j η)) ≫
      (yoneda.map (residueFieldMap B S hS V (j.left.1 η)
        (B.residueField_spec_contains V.left.property (j.left.1 η))) ≫ g) := by
    have := congrArg (· ≫ q) hab
    simp only [Category.assoc] at this
    rw [sq.w, ← Category.assoc (yoneda.map (residueFieldMap B S hS W η hη)), hrj] at this
    simpa only [Category.assoc] using this
  have hab' : a ≫ yoneda.map (residueFieldMap B S hS W η hη) ≫ yoneda.map j =
      b ≫ yoneda.map (residueFieldMap B S hS W η hη) ≫ yoneda.map j := by
    rw [hrj, ← Category.assoc, (cancel_mono _).1 h3, Category.assoc]
  have hab'' : a ≫ yoneda.map (residueFieldMap B S hS W η hη) =
      b ≫ yoneda.map (residueFieldMap B S hS W η hη) :=
    sq.hom_ext (by simpa only [Category.assoc] using hab)
      (by simpa only [Category.assoc] using hab')
  exact (cancel_mono _).1 hab''

end MonoResidueField

/-! ### The map of henselian local rings on a given square of charts -/

section HenselianSquare

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The map of henselian local rings on a given commuting square of pointed étale charts.**
Let `f : X ⟶ Y` be a morphism of decent algebraic spaces, `x` a point of `X`, `V` an elementary
étale neighborhood of `f(x)` and `U` one of `x` with a morphism `j : U ⟶ V` over `f` carrying the
distinguished point to the distinguished point.  There is a local homomorphism
`φ : 𝒪^h_{Y, f(x)} ⟶ 𝒪^h_{X, x}` extending the stalk map `α : 𝒪_{V, v} ⟶ 𝒪_{U, u}` (Stacks 04GS);
it is flat when `f` is, and it carries the maximal ideal onto the maximal ideal with a residue
field extension generated by one transcendental element when `α` does. -/
theorem exists_henselianLocalRingHom_of_chartSquare
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    (hY : IsAlgebraicSpace B S hS Y) (hYd : IsDecentSpace B S hS Y)
    (f : X ⟶ Y) (x : points B S hS X)
    (V : ElementaryEtaleNeighborhood B S hS Y hY (pointsMap B S hS X f x))
    (U : ElementaryEtaleNeighborhood B S hS X hX x) (j : U.scheme ⟶ V.scheme)
    (hj : j.left.1 U.point = V.point) (hsq : yoneda.map j ≫ V.toSpace = U.toSpace ≫ f) :
    letI := henselianLocalRing_isLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd
    letI := henselianLocalRing_isLocalRing B S hS X hX x hXd
    ∃ φ : (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1)) →+*
        (henselianLocalRing B S hS X hX x hXd : Type (u + 1)),
      IsLocalHom φ ∧
        (∀ a, φ (stalkToHenselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd V a) =
          stalkToHenselianLocalRing B S hS X hX x hXd U
            (((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
              j.left.1.stalkMap U.point).hom a)) ∧
        (IsFlat B S hS f → φ.Flat) ∧
        (IsTranscendentalOneLocalHom ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
            j.left.1.stalkMap U.point).hom → IsTranscendentalOneLocalHom φ) := by
  classical
  set α : V.scheme.left.1.presheaf.stalk V.point →+*
      U.scheme.left.1.presheaf.stalk U.point :=
    ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
      j.left.1.stalkMap U.point).hom with hαdef
  let : IsLocalRing (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd :
      Type (u + 1)) :=
    henselianLocalRing_isLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd
  let : IsLocalRing (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    henselianLocalRing_isLocalRing B S hS X hX x hXd
  let : Algebra (V.scheme.left.1.presheaf.stalk V.point)
      (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1)) :=
    stalkAlgebra B S hS Y hY (pointsMap B S hS X f x) hYd V
  let : Algebra (U.scheme.left.1.presheaf.stalk U.point)
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    stalkAlgebra B S hS X hX x hXd U
  let : IsHenselization (V.scheme.left.1.presheaf.stalk V.point)
      (ResidueField (V.scheme.left.1.presheaf.stalk V.point))
      (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1)) :=
    henselianLocalRing_isHenselization B S hS Y hY (pointsMap B S hS X f x) hYd V
  let : IsHenselization (U.scheme.left.1.presheaf.stalk U.point)
      (ResidueField (U.scheme.left.1.presheaf.stalk U.point))
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    henselianLocalRing_isHenselization B S hS X hX x hXd U
  let : Algebra (V.scheme.left.1.presheaf.stalk V.point)
      (U.scheme.left.1.presheaf.stalk U.point) := α.toAlgebra
  let : Algebra (V.scheme.left.1.presheaf.stalk V.point)
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    ((stalkToHenselianLocalRing B S hS X hX x hXd U).comp α).toAlgebra
  have : IsScalarTower (V.scheme.left.1.presheaf.stalk V.point)
      (U.scheme.left.1.presheaf.stalk U.point)
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have : IsLocalHom α := by
    rw [hαdef]
    infer_instance
  have : IsLocalHom (stalkToHenselianLocalRing B S hS X hX x hXd U) :=
    isLocalHom_stalkToHenselianLocalRing B S hS X hX x hXd U
  have : IsLocalHom (algebraMap (V.scheme.left.1.presheaf.stalk V.point)
      (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1))) :=
    isLocalHom_stalkToHenselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd V
  have : IsLocalHom (algebraMap (V.scheme.left.1.presheaf.stalk V.point)
      (henselianLocalRing B S hS X hX x hXd : Type (u + 1))) :=
    RingHom.isLocalHom_comp _ _
  have : HenselianLocalRing (henselianLocalRing B S hS X hX x hXd : Type (u + 1)) :=
    IsHenselization.henselian (U.scheme.left.1.presheaf.stalk U.point)
      (ResidueField (U.scheme.left.1.presheaf.stalk U.point))
  obtain ⟨g, hg, -⟩ := HenselianLocalRing.existsUnique_isLocalHom_of_ind_etale
    (R := V.scheme.left.1.presheaf.stalk V.point)
    (Rh := (henselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd : Type (u + 1)))
    (Sh := (henselianLocalRing B S hS X hX x hXd : Type (u + 1)))
    (IsHenselization.ind_etale
      (R := V.scheme.left.1.presheaf.stalk V.point)
      (L := ResidueField (V.scheme.left.1.presheaf.stalk V.point)))
    (IsHenselization.residueField_map_bijective
      (R := V.scheme.left.1.presheaf.stalk V.point)).surjective
  have : IsLocalHom g.toRingHom := ⟨fun a ha ↦ hg.map_nonunit a ha⟩
  refine ⟨(g : _ →+* _), inferInstance, fun a ↦ g.commutes a, fun hf ↦ ?_, fun hα ↦ ?_⟩
  swap
  · exact hα.of_comm α g.toRingHom
      (stalkToHenselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd V)
      (stalkToHenselianLocalRing B S hS X hX x hXd U)
      (RingHom.ext fun a ↦ (g.commutes a).symm)
      (map_maximalIdeal_stalkToHenselianLocalRing B S hS Y hY (pointsMap B S hS X f x) hYd V)
      (map_maximalIdeal_stalkToHenselianLocalRing B S hS X hX x hXd U)
