-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TensorProduct

universe u

/-- **Dual base change for a module free of rank one.**  Let `M` be an `A`-module generated
freely by `t`, with coordinate functional `l₀`, let `C` be an `A`-algebra and let `x` be an
element of `M`.  Every `C`-linear functional on `C ⊗[A] M` takes `1 ⊗ x` into the ideal of `C`
generated by the values at `x` of the `A`-linear functionals on `M`.

This is `Ideal.mem_map_span_range_dual` without its flatness and finite presentation
hypotheses. -/
theorem Ideal.mem_map_span_range_dual_of_free {A C M : Type*} [CommRing A] [CommRing C]
    [Algebra A C] [AddCommGroup M] [Module A M] (t : M) (l₀ : Module.Dual A M)
    (hb : ∀ y, l₀ y • t = y) (x : M) (lam : (C ⊗[A] M) →ₗ[C] C) :
    lam (1 ⊗ₜ[A] x) ∈
      Ideal.map (algebraMap A C) (Ideal.span (Set.range fun l : Module.Dual A M => l x)) := by
  have hx : (1 : C) ⊗ₜ[A] x = algebraMap A C (l₀ x) • ((1 : C) ⊗ₜ[A] t) := by
    rw [algebraMap_smul, ← TensorProduct.tmul_smul, hb x]
  rw [hx, map_smul, smul_eq_mul]
  exact Ideal.mul_mem_right _ _
    (Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_range_self l₀)))

/-- **The ideal generated by the values of the functionals at an element depends only on the
module up to isomorphism.**  A linear equivalence carries the ideal generated by the values at
`x` of the functionals onto the ideal generated by the values at the image of `x`. -/
theorem Ideal.span_range_dual_congr {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) (x : M) :
    Ideal.span (Set.range fun l : Module.Dual R M => l x) =
      Ideal.span (Set.range fun l : Module.Dual R N => l (e x)) := by
  refine le_antisymm (Ideal.span_le.2 (Set.range_subset_iff.2 fun l => ?_))
    (Ideal.span_le.2 (Set.range_subset_iff.2 fun l => ?_))
  · exact Ideal.subset_span ⟨l ∘ₗ e.symm.toLinearMap, by simp⟩
  · exact Ideal.subset_span ⟨l ∘ₗ e.toLinearMap, rfl⟩

namespace Stacks.Divisors

/-- **On an affine scheme the zero scheme of a section of an invertible module is the ideal
sheaf induced by the ideal of global sections generated by the values of the functionals at the
section.** -/
theorem zeroScheme_eq_ofIdealTop (Y : Scheme.{u}) [IsAffine Y] (M : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property M]
    (σ : Γ(M, ⊤)) :
    zeroScheme Y M σ =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span {a : Γ(Y, ⊤) | ∃ φ : Γ(M, ⊤) →ₗ[Γ(Y, ⊤)] Γ(Y, ⊤),
          a = φ (M.presheaf.map (CategoryTheory.homOfLE le_top).op σ)}) := by
  have htop : (Scheme.IdealSheafData.ofIdealTop
        (Ideal.span {a : Γ(Y, ⊤) | ∃ φ : Γ(M, ⊤) →ₗ[Γ(Y, ⊤)] Γ(Y, ⊤),
          a = φ (M.presheaf.map (CategoryTheory.homOfLE le_top).op σ)})).ideal
      ⟨⊤, isAffineOpen_top Y⟩ =
      Ideal.span {a : Γ(Y, ⊤) | ∃ φ : Γ(M, ⊤) →ₗ[Γ(Y, ⊤)] Γ(Y, ⊤),
        a = φ (M.presheaf.map (CategoryTheory.homOfLE le_top).op σ)} := by
    simp [Scheme.IdealSheafData.ofIdealTop]
  exact Scheme.IdealSheafData.ext_of_isAffine
    ((zeroScheme_ideal Y M σ ⟨⊤, isAffineOpen_top Y⟩).trans htop.symm)

end Stacks.Divisors

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The chart base change of a zero scheme -/

/-- **The chart base change of the zero scheme of a section of an invertible module is cut out
by the evaluation ideal of the section at the chart.**  For an affine étale chart `V` of `X` the
kernel of the projection `V ×_X Z(s) ⟶ V`, which is a closed immersion of schemes, is the ideal
sheaf induced by the ideal `AlgebraicGeometry.Space.sectionEvaluationIdealAt` of regular
functions on the chart.

This is the compatibility of Stacks 0845 with étale chart base change, read on ideal sheaves: the
ideal appearing here is the one the scheme-level zero scheme of a section of an invertible module
is cut out by on an affine open. -/
theorem ker_closedSubspaceBaseChangeChartProj_zeroScheme (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) [IsAffine (chartScheme V)] :
    (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
        (zeroScheme B S hS X L s).2 V).ker =
      Scheme.IdealSheafData.ofIdealTop (sectionEvaluationIdealAt B S hS X L s V) := by
  have hV : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V) :=
    inferInstanceAs (IsAffine (chartScheme V))
  have hV' : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj V).1 :=
    inferInstanceAs (IsAffine (chartScheme V))
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hinv
  rw [ker_closedSubspaceBaseChangeChartProj B S hS X (zeroScheme B S hS X L s) V]
  exact (ker_chartBaseChangeHom B S hS X (zeroScheme B S hS X L s) V hV).trans
    (congrArg Scheme.IdealSheafData.ofIdealTop
      (definingIdealAt_zeroScheme_eq B S hS X L s Z hZ V hV'))

/-- The kernel of the inclusion of the closed subscheme of the chart cut out by the evaluation
ideal of `s` is the kernel of the projection `V ×_X Z(s) ⟶ V`. -/
theorem ker_subschemeι_sectionEvaluationIdealAt_eq (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) [IsAffine (chartScheme V)] :
    (Scheme.IdealSheafData.ofIdealTop
          (sectionEvaluationIdealAt B S hS X L s V)).subschemeι.ker =
      (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
        (zeroScheme B S hS X L s).2 V).ker :=
  (Scheme.IdealSheafData.ker_subschemeι _).trans
    (ker_closedSubspaceBaseChangeChartProj_zeroScheme B S hS X L hinv s V).symm

/-- **The chart base change `V ×_X Z(s)` of the zero scheme is the closed subscheme cut out by
the evaluation ideal of `s` at the chart**, as a closed subscheme of the chart scheme: the two
closed immersions into the chart scheme have the same kernel, and a closed immersion with a
prescribed kernel identifies their sources. -/
def closedSubspaceBaseChangeChartIsoZeroSchemeSubscheme (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) [IsAffine (chartScheme V)] :
    chartScheme (closedSubspaceBaseChangeChart B S hS X.2 (zeroScheme B S hS X L s).1
        (zeroScheme B S hS X L s).2 V) ≅
      (Scheme.IdealSheafData.ofIdealTop (sectionEvaluationIdealAt B S hS X L s V)).subscheme :=
  haveI := isClosedImmersion_closedSubspaceBaseChangeChartProj B S hS X.2
    (zeroScheme B S hS X L s).1 (zeroScheme B S hS X L s).2 V
  haveI := IsClosedImmersion.isIso_lift
    (Scheme.IdealSheafData.ofIdealTop (sectionEvaluationIdealAt B S hS X L s V)).subschemeι
    (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
      (zeroScheme B S hS X L s).2 V)
    (ker_subschemeι_sectionEvaluationIdealAt_eq B S hS X L hinv s V)
  asIso (IsClosedImmersion.lift
    (Scheme.IdealSheafData.ofIdealTop (sectionEvaluationIdealAt B S hS X L s V)).subschemeι
    (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
      (zeroScheme B S hS X L s).2 V)
    (ker_subschemeι_sectionEvaluationIdealAt_eq B S hS X L hinv s V).le)

/-- The identification of the chart base change of the zero scheme with the closed subscheme of
the evaluation ideal is an identification *over the chart*. -/
theorem closedSubspaceBaseChangeChartIsoZeroSchemeSubscheme_hom_subschemeι
    (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) [IsAffine (chartScheme V)] :
    (closedSubspaceBaseChangeChartIsoZeroSchemeSubscheme B S hS X L hinv s V).hom ≫
        (Scheme.IdealSheafData.ofIdealTop
          (sectionEvaluationIdealAt B S hS X L s V)).subschemeι =
      closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
        (zeroScheme B S hS X L s).2 V :=
  have := isClosedImmersion_closedSubspaceBaseChangeChartProj B S hS X.2
    (zeroScheme B S hS X L s).1 (zeroScheme B S hS X L s).2 V
  IsClosedImmersion.lift_fac _ _ _

/-- **The cycle of Stacks 02QU is the same on the two presentations of the chart base change of
a zero scheme.**  The `k`-cycle of the chart base change `V ×_X Z(s)`, read through its
projection to the chart, is the `k`-cycle of the closed subscheme of the chart cut out by the
evaluation ideal of `s`. -/
theorem cycleAssociatedToClosedSubscheme_closedSubspaceBaseChangeChartProj_zeroScheme
    (C : Stacks.Chow.ChowSituation.{u}) (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) [IsAffine (chartScheme V)]
    (g : chartScheme V ⟶ C.S) [LocallyOfFiniteType g] (k : ℤ) :
    haveI := isClosedImmersion_closedSubspaceBaseChangeChartProj B S hS X.2
      (zeroScheme B S hS X L s).1 (zeroScheme B S hS X L s).2 V
    Stacks.Chow.cycleAssociatedToClosedSubscheme C g
        (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
          (zeroScheme B S hS X L s).2 V) k =
      Stacks.Chow.cycleAssociatedToClosedSubscheme C g
        (Scheme.IdealSheafData.ofIdealTop
          (sectionEvaluationIdealAt B S hS X L s V)).subschemeι k := by
  have := isClosedImmersion_closedSubspaceBaseChangeChartProj B S hS X.2
    (zeroScheme B S hS X L s).1 (zeroScheme B S hS X L s).2 V
  exact Stacks.Chow.cycleAssociatedToClosedSubscheme_eq_of_iso C g _ _
    (closedSubspaceBaseChangeChartIsoZeroSchemeSubscheme B S hS X L hinv s V)
    (closedSubspaceBaseChangeChartIsoZeroSchemeSubscheme_hom_subschemeι B S hS X L hinv s V) k

/-- **The left-hand side of Stacks 0EQL, read on the ideal-sheaf presentation of the zero
scheme.**  Let `X/B` be a good algebraic space in Situation 0EDT, let `L` be an invertible
`𝒪_X`-module with a global section `s`, and let `V` be a surjective affine étale scheme chart of
`X`.  Then at a point `v` of the chart over the generic point of an integral closed subspace
`Z ⊆ X`, the coefficient of `Z` in the `k`-cycle `[Z(s)]_k` of Stacks 0EE9 is the coefficient of
`v` in the `k`-cycle of Stacks 02QU of the closed subscheme of `V` cut out by the evaluation
ideal of `s` at the chart. -/
theorem cycleCoeffOfClosedSubspace_zeroScheme_eq_cycleAssociatedToClosedSubscheme_chart
    (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (sX : X ⟶ D.space) (hX : D.IsGood sX)
    (L : Modules.{u, u} D.site D.base D.base_mem X hX.1)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureCommRings D.site D.base D.base_mem ⟨X, hX.1⟩)
      (structureRingSheaf D.site D.base D.base_mem ⟨X, hX.1⟩).property L)
    (s : L.sections)
    (hEgood : D.IsGood
      ((zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).1.ι ≫ sX))
    (V : SmallEtale D.site D.base D.base_mem X) [IsAffine (chartScheme V)]
    (hsurj : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme D.site D.base D.base_mem))) V.obj.hom)
    (k : ℤ)
    (γ : points D.site D.base D.base_mem
        (zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).1.toFunctor →
      GeometricPoint D.site D.base D.base_mem
        (zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).1.toFunctor)
    (hγ : ∀ y, (γ y).image = y)
    (Z : IntegralClosedSubspace D.site D.base D.base_mem X) (v : chartScheme V)
    (hv : chartSchemeToPoints D.site D.base D.base_mem X V v =
      Z.ambientGenericPoint D.site D.base D.base_mem) :
    haveI := locallyOfFiniteType_id_chartChowSituation D sX hX V hsurj
    cycleCoeffOfClosedSubspace D sX hX
        (zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).1
        (zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).2 k γ Z =
      (Stacks.Chow.cycleAssociatedToClosedSubscheme (chartChowSituation D sX hX V hsurj)
        (𝟙 (chartScheme V))
        (Scheme.IdealSheafData.ofIdealTop (sectionEvaluationIdealAt D.site D.base D.base_mem
          ⟨X, hX.1⟩ L s V)).subschemeι k).1 v := by
  have hft := locallyOfFiniteType_id_chartChowSituation D sX hX V hsurj
  rw [cycleCoeffOfClosedSubspace_eq_cycleAssociatedToClosedSubscheme_chart D sX hX
    (zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).1
    (zeroScheme D.site D.base D.base_mem ⟨X, hX.1⟩ L s).2 hEgood V hsurj k γ hγ Z v hv,
    cycleAssociatedToClosedSubscheme_closedSubspaceBaseChangeChartProj_zeroScheme
      D.site D.base D.base_mem (chartChowSituation D sX hX V hsurj) ⟨X, hX.1⟩ L hinv s V
      (𝟙 (chartScheme V)) k]

/-! ### The evaluation ideal of an inverse image section -/

variable {X Y : AlgebraicSpaces B S hS}

/-- **The value over a chart of the inverse image of a global section is its unit section**: the
value of `f^*s` over the chart `U` is the image under the unit of the Stacks 03D7 adjunction of
the value of `s` over the chart `V`. -/
theorem modulePullbackSections_eval_eq_modulePullbackUnitSection (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (s : G.sections)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom) :
    (modulePullbackSections B S hS f G s).eval (op d.U) =
      modulePullbackUnitSection B S hS f G d (s.eval (op d.V)) :=
  (modulePullbackSections_val B S hS f G s d).trans
    (modulePullbackUnitSection_eq_modulePullbackChartSection B S hS f G d
      (s.eval (op d.V))).symm

/-- **The evaluation ideal of an inverse image section is contained in the extension of the
evaluation ideal of the section.**  Let `f : X ⟶ Y` be a morphism of algebraic spaces, let `G`
be an `𝒪_Y`-module with a global section `s`, and let `d` be a commutative diagram of étale
scheme charts, with chart `U` of `X` over chart `V` of `Y`.  If `G` is free of rank one over `V`,
with generator `t` and coordinate functional `l₀`, then the evaluation ideal of Stacks 0845 of
the inverse image section `f^*s` at `U` is contained in the ideal of `𝒪_X(U)` generated by the
restrictions of the evaluation ideal of `s` at `V`.

This is the comparison across a morphism of algebraic spaces of which
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_le_map` is the comparison between two charts of
one algebraic space.  Neither chart is assumed affine, and there is no quasi-coherence or flatness
hypothesis. -/
theorem sectionEvaluationIdealAt_modulePullback_le_map (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (s : G.sections)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom)
    (t : G.val.obj (op d.V))
    (l₀ : Module.Dual (chartRing B S hS Y.1 Y.2 d.V) (G.val.obj (op d.V)))
    (hb : ∀ y, l₀ y • t = y) :
    sectionEvaluationChartIdeal B S hS X ((modulePullback B S hS f).obj G)
        (modulePullbackSections B S hS f G s) d.U ≤
      Ideal.map (chartDiagramRestrict B S hS f d)
        (sectionEvaluationChartIdeal B S hS Y G s d.V) := by
  let := chartDiagramAlgebra B S hS f d
  refine Ideal.span_le.2 (Set.range_subset_iff.2 fun l => ?_)
  have hval : (modulePullbackSections B S hS f G s).eval (op d.U) =
      modulePullbackSectionsBaseChange B S hS f G d
        (TensorProduct.tmul (chartRing B S hS Y.1 Y.2 d.V)
          (1 : chartRing B S hS X.1 X.2 d.U) (s.eval (op d.V))) :=
    (modulePullbackSections_eval_eq_modulePullbackUnitSection B S hS f G s d).trans
      (modulePullbackSectionsBaseChange_one_tmul B S hS f G d (s.eval (op d.V))).symm
  rw [hval]
  exact SetLike.mem_coe.2 (Ideal.mem_map_span_range_dual_of_free t l₀ hb (s.eval (op d.V))
    (l ∘ₗ modulePullbackSectionsBaseChange B S hS f G d))

end AlgebraicGeometry.Space

