module

public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.ComponentGenericFractionRestriction
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.FlatChartRationalFunctionReading

/-!
# The pullback of a rational function along a flat morphism, read on a component

Let `f : X ⟶ Y` be a flat morphism of algebraic spaces over `S` with `Y` integral, let
`i : X' ⟶ X` present an integral algebraic space `X'` over `X`, and let `Z'` be a prime divisor
of `X'` with generic point `ξ'`. Let `V` be an elementary étale neighborhood of a point `x` of `X`
with affine, reduced, locally Noetherian scheme, let `U` be an elementary étale neighborhood of
`ξ'` and let `j : U.scheme ⟶ V.scheme` be a morphism over `i` carrying the distinguished point to
the distinguished point, with surjective Zariski stalk map and carrying nonzerodivisors of global
sections to nonzerodivisors.

This file proves that the image of the pullback `g ∘ (i ≫ f)` of a rational function `g` of `Y`
under the embedding of Stacks 0ENK

  `R(X') ⟶ Q(𝒪^h_{X', ξ'})`

is the fraction of the classes, modulo the ideal generated by the kernel of the stalk map of
`j`, of two global sections of `𝒪_V`.

## Main results

* In the namespace `AlgebraicGeometry.Space.PrimeDivisor`,
  `exists_rationalFunctionsToGenericTotalFractionRing_rationalFunctionMap_eq_mk'_of_isFlat`: the
  fraction of the classes, for the pullback of a rational function along a flat morphism.

## References

* [Stacks Project, Tag 0EMY](https://stacks.math.columbia.edu/tag/0EMY)
* [Stacks Project, Tag 0ENK](https://stacks.math.columbia.edu/tag/0ENK)
* [Stacks Project, Tag 0EQA](https://stacks.math.columbia.edu/tag/0EQA)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace
open scoped nonZeroDivisors

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X X' Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : IsAlgebraicSpace B S hS X) (hXd : IsDecentSpace B S hS X)
    {x : points B S hS X} (V : ElementaryEtaleNeighborhood B S hS X hX x)
    (hX' : IsAlgebraicSpace B S hS X') (hX'int : IsIntegralSpace B S hS X')
    (hX'N : HasEtaleLocalProperty B S hS X' (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (Z' : PrimeDivisor B S hS X')
    (hY : IsAlgebraicSpace B S hS Y) (hintY : IsIntegralSpace B S hS Y)

include hX hXd hX'int hX'N hintY in
/-- **The image of the pullback of a rational function along a flat morphism is the fraction of
the classes of two global sections of a chart of the ambient space.** Let `f : X ⟶ Y` be flat
with `Y` integral, let `i : X' ⟶ X` with `X'` decent, locally Noetherian and integral and
suppose `i ≫ f` carries the generic point of `X'` to the generic point of `Y`. Let `V` be an
elementary étale neighborhood of a point `x` of `X` whose scheme is affine, reduced and locally
Noetherian, let `U` be an *affine* elementary étale neighborhood of the generic point `ξ'` of a
prime divisor `Z'` of `X'` and let `j : U.scheme ⟶ V.scheme` be a morphism over `i` carrying the
distinguished point to the distinguished point, with surjective Zariski stalk map and carrying
nonzerodivisors of global sections to nonzerodivisors. Then for every rational function `g` of
`Y` there are global sections `s`, `t` of `𝒪_V` with

  `emb_{X'}(g ∘ (i ≫ f)) = e [σ_V s] / e [σ_V t]`   in `Q(𝒪^h_{X', ξ'})`,

where `σ_V : 𝒪_{V, V.point} ⟶ 𝒪^h_{X, x}` is the map of Stacks 0EMY, `[·]` is the class modulo
the ideal `(ker α) · 𝒪^h_{X, x}` generated by the kernel of the stalk map of `j`, and
`e : 𝒪^h_{X, x} ⧸ (ker α) · 𝒪^h_{X, x} ≅ 𝒪^h_{X', ξ'}` is a ring isomorphism. -/
theorem
PrimeDivisor.exists_rationalFunctionsToGenericTotalFractionRing_rationalFunctionMap_eq_mk'_of_isFlat
    [IsAffine V.scheme.left.1] [IsLocallyNoetherian V.scheme.left.1]
    (i : X' ⟶ X) (f : X ⟶ Y) (hf : IsFlat B S hS f)
    (hgen : pointsMap B S hS X' (i ≫ f)
        (_root_.AlgebraicGeometry.Space.genericPoint B S hS hX' hX'int) =
      _root_.AlgebraicGeometry.Space.genericPoint B S hS hY hintY)
    (U : ElementaryEtaleNeighborhood B S hS X' hX' (Z'.genericPoint B S hS X'))
    [IsAffine U.scheme.left.1] (j : U.scheme ⟶ V.scheme) (hj : j.left.1 U.point = V.point)
    (hsurj : Function.Surjective ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
      j.left.1.stalkMap U.point).hom)
    (hsq : yoneda.map j ≫ V.toSpace = U.toSpace ≫ i)
    (hnzd : (Γ(V.scheme.left.1, ⊤))⁰ ≤
      ((Γ(U.scheme.left.1, ⊤))⁰).comap (chartGlobalSectionsRestrict B S hS j))
    (g : rationalFunctions B S hS hY) :
    ∃ (s t : Γ(V.scheme.left.1, ⊤))
      (e : ((henselianLocalRing B S hS X hX x hXd : Type (u + 1)) ⧸
          (RingHom.ker ((V.scheme.left.1.presheaf.stalkCongr (.of_eq hj.symm)).hom ≫
            j.left.1.stalkMap U.point).hom).map
            (stalkToHenselianLocalRing B S hS X hX x hXd V)) ≃+*
        ↥(Z'.genericHenselianLocalRing B S hS hX' hX'int.isDecentSpace))
      (hb : e (Ideal.Quotient.mk _ (stalkToHenselianLocalRing B S hS X hX x hXd V
            ((V.scheme.left.1.presheaf.germ ⊤ V.point trivial).hom t))) ∈
          (↥(Z'.genericHenselianLocalRing B S hS hX' hX'int.isDecentSpace))⁰),
      Z'.rationalFunctionsToGenericTotalFractionRing B S hS hX' hX'int.isDecentSpace hX'int
          hX'N (rationalFunctionMap B S hS hX' hY hX'int hintY (i ≫ f) hgen g) =
        IsLocalization.mk' (Z'.genericTotalFractionRing B S hS hX' hX'int.isDecentSpace)
          (e (Ideal.Quotient.mk _ (stalkToHenselianLocalRing B S hS X hX x hXd V
            ((V.scheme.left.1.presheaf.germ ⊤ V.point trivial).hom s))))
          ⟨_, hb⟩ := by
  let := Z'.isReduced_chart B S hS hX' hX'int U
  let := Z'.isLocallyNoetherian_chart B S hS hX' hX'N U
  obtain ⟨s, t, ht, hr⟩ :=
    exists_rationalFunctionsToTotalFractionRing_rationalFunctionMap_eq_mk'_of_isFlat_comp B S hS
      hX' hX hY hX'int hintY i f hf hgen U.toSpace U.etale_toSpace V.toSpace V.etale_toSpace j
      hsq hnzd g
  obtain ⟨e, hb, he⟩ := Z'.rationalFunctionsToGenericTotalFractionRing_eq_mk'_ringEquiv_quotient
    B S hS hX hXd V hX' hX'int hX'N U j hj hsurj s t ht _ hr
  exact ⟨s, t, e, hb, he⟩

end AlgebraicGeometry.Space

end
