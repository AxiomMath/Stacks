module

public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.KeyFormula.GenericFieldPointReading
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.KeyFormula.MinimalPrimeResidueField
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.KeyFormulaHub.EtaleLocalRingHub
public import StacksFrontier.AlgebraicGeometry.Spaces.GeometricEvaluationSections

/-!
# The residue field at the generic point of a prime divisor inside the étale local ring

Let `X` be a decent algebraic space, `Z ⊂ X` a prime divisor with generic point `ξ`, `(U, u)` the
chosen elementary étale neighbourhood of `ξ` (so `κ(u) = R(Z)` through `θ_Z`), `V` an étale chart
of `X`, `q'` a point of the base-change chart `W' = V ×_X Z` over `ξ` with image `q ∈ V`, and
`x̄` the geometric point of `X` over `q` chosen in
`StacksFrontier/AlgebraicGeometry/Spaces/Chow/KeyFormulaHub/EtaleLocalRingHub.lean`, with étale local
ring `R = 𝒪_{X, x̄}` and residue field `κR`.

The proof of the key formula of Stacks 0EQV compares readings in `κ(q')` (on the chart of `Z`)
with readings in `κ(𝒪^h_{X, ξ})` (through `θ_Z`).  Both land in `κR`, and this file shows that the
two embeddings of `κ(u)` into `κR`,

* `κ(u) → κ(q') ≅ κ(q) → κR`, through the factorization of the field point at `q'` through
  `ρ_Z : Spec κ(u) → Z` and the chart leg `𝒪_{V, q} → R`, and
* `κ(u) ≅ κ(𝒪^h_{X, ξ}) → κR`, through the map `𝒪^h_{X, ξ} → R` of Stacks 0EMZ,

agree (statement (K)).  The proof evaluates both in the field of `x̄`, which is injective on
`κR`: geometric evaluation kills the maximal ideal of `R` (it is generated by that of a chart), and
both composites are the field homomorphism of a morphism `Spec Ω → Spec κ(u)` over `X`; the
residue-field point of `(U, u)` is a monomorphism into `X`, so such a morphism is unique.

## Main definitions

* `AlgebraicGeometry.Space.etaleResidueFieldEval`: geometric evaluation `κR → Ω`.
* `AlgebraicGeometry.Space.chartResidueFieldToEtale`: the residue map `κ(q) → κR`.
* `AlgebraicGeometry.Space.PrimeDivisor.henselianResidueFieldToEtale`: the residue map
  `κ(𝒪^h_{X, ξ}) → κR`.
* `AlgebraicGeometry.Space.PrimeDivisor.genericResidueFieldToGeometric`: the field homomorphism
  `κ(u) → Ω` of the factorization of `x̄` through the residue-field point of `(U, u)`.

## Main results

* `AlgebraicGeometry.Space.geometricEval_chartStalkToEtaleLocalRing`: geometric evaluation on the
  image of the stalk of a chart is the residue map followed by the field map of the lift.
* `AlgebraicGeometry.Space.PrimeDivisor.chartResidueFieldToEtale_genericResidueFieldToFieldPoint`:
  **(K)**, the two maps `κ(u) → κR` agree.
* `AlgebraicGeometry.Space.PrimeDivisor.chartResidueFieldToEtale_baseChangeChartRationalReading`:
  **(G1')**, the value at `q'` of a rational function `f` of `Z`, transported to `κR`, is the
  residue of `θ⁻¹ f`.

## References

* [Stacks Project, Tag 0EQV](https://stacks.math.columbia.edu/tag/0EQV)
* [Stacks Project, Tag 0EMZ](https://stacks.math.columbia.edu/tag/0EMZ)
* [Stacks Project, Tag 0H2X](https://stacks.math.columbia.edu/tag/0H2X)
* [Stacks Project, Tag 04HX](https://stacks.math.columbia.edu/tag/04HX)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite IsLocalRing

universe u

namespace AlgebraicGeometry.Scheme

/-- The value in `K` of a section pulled back along `Spec K → T` is the image of its germ under
`AlgebraicGeometry.Scheme.stalkClosedPointTo`. -/
theorem ΓSpecIso_appLE_eq_stalkClosedPointTo {T : Scheme.{u}} {K : Type u} [Field K]
    (f : Spec (.of K) ⟶ T) (W : T.Opens) (hW : f (closedPoint K) ∈ W)
    (hle : (⊤ : (Spec (.of K)).Opens) ≤ f ⁻¹ᵁ W) (a : Γ(T, W)) :
    (ΓSpecIso (.of K)).hom (f.appLE W ⊤ hle a) =
      stalkClosedPointTo f (T.presheaf.germ W (f (closedPoint K)) hW a) := by
  have h := ConcreteCategory.congr_hom (germ_stalkClosedPointTo f W hW) a
  refine Eq.trans ?_ h.symm
  simp [Scheme.Hom.appLE]
  rfl

/-- **Pulling back along a morphism `Spec K → T` through `Spec κ(x)` is evaluation at `x`**: for
`f = Spec ψ ≫ (Spec κ(x) → T)`, the value in `K` of the pullback of a section is `ψ` of its residue
at `x`. -/
theorem ΓSpecIso_appLE_eq_residue {T : Scheme.{u}} {K : Type u} [Field K]
    (f : Spec (.of K) ⟶ T) (x : T) (ψ : T.residueField x ⟶ .of K)
    (hf : f = Spec.map ψ ≫ T.fromSpecResidueField x) (W : T.Opens) (hx : x ∈ W)
    (hle : (⊤ : (Spec (.of K)).Opens) ≤ f ⁻¹ᵁ W) (a : Γ(T, W)) :
    (ΓSpecIso (.of K)).hom (f.appLE W ⊤ hle a) = ψ (T.residue x (T.presheaf.germ W x hx a)) := by
  subst hf
  have hW : (Spec.map ψ ≫ T.fromSpecResidueField x) (closedPoint K) ∈ W := hle trivial
  rw [ΓSpecIso_appLE_eq_stalkClosedPointTo _ W hW]
  have he : Spec.map ψ ≫ T.fromSpecResidueField x =
      Spec.map (T.residue x ≫ ψ) ≫ T.fromSpecStalk x := by
    rw [Spec.map_comp, Category.assoc]
    rfl
  have : IsLocalHom ψ.hom :=
    ⟨fun b hb ↦ isUnit_iff_ne_zero.mpr fun h0 ↦ by simp [h0] at hb⟩
  have : IsLocalHom (T.residue x ≫ ψ).hom := by
    have : IsLocalHom (T.residue x).hom :=
      inferInstanceAs (IsLocalHom (IsLocalRing.residue (T.presheaf.stalk x)))
    rw [CommRingCat.hom_comp]
    exact RingHom.isLocalHom_comp _ _
  have key : ∀ (g : Spec (.of K) ⟶ T)
      (_ : g = Spec.map (T.residue x ≫ ψ) ≫ T.fromSpecStalk x) (hg : g (closedPoint K) ∈ W),
      stalkClosedPointTo g (T.presheaf.germ W (g (closedPoint K)) hg a) =
        ψ (T.residue x (T.presheaf.germ W x hx a)) := by
    rintro g rfl hg
    exact ConcreteCategory.congr_hom
      (germ_stalkClosedPointTo_Spec_fromSpecStalk (T.residue x ≫ ψ) W hg) a
  exact key _ he hW

/-- A morphism `Spec K → T` sending the closed point to `x` factors through `Spec κ(x) → T`. -/
theorem exists_eq_SpecMap_comp_fromSpecResidueField {T : Scheme.{u}} {K : Type u} [Field K]
    (f : Spec (.of K) ⟶ T) {x : T} (hx : f (closedPoint K) = x) :
    ∃ ψ : T.residueField x ⟶ .of K, f = Spec.map ψ ≫ T.fromSpecResidueField x := by
  subst hx
  exact ⟨_, (descResidueField_stalkClosedPointTo_fromSpecResidueField K T f).symm⟩

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)

/-- **Geometric evaluation on the chart leg.**  For a small étale neighbourhood `N` of `x̄` whose
lift `Spec Ω → N` factors as `Spec ψ` followed by `Spec κ(p) → N`, evaluating at `x̄` the image
in `𝒪_{X, x̄}` of an element of `𝒪_{N, p}` is `ψ` of its residue. -/
theorem geometricEval_chartStalkToEtaleLocalRing {x : GeometricPoint B S hS X}
    (N : SmallEtaleNeighborhood x) {p : chartScheme N.chart} (hp : chartPoint B S hS X N = p)
    (ψ : (chartScheme N.chart).residueField p ⟶ .of x.val.carrier)
    (hψ : (BigFppfOver.toScheme B S hS).map N.point =
      Spec.map ψ ≫ (chartScheme N.chart).fromSpecResidueField p)
    (r : (chartScheme N.chart).presheaf.stalk p) :
    geometricEval B S hS X x (chartStalkToEtaleLocalRing B S hS hX N hp r) =
      ψ ((chartScheme N.chart).residue p r) := by
  obtain ⟨W, hpW, a, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ r
  subst hp
  rw [chartStalkToEtaleLocalRing_rfl]
  have hle : (⊤ : ((BigFppfOver.toScheme B S hS).obj x.val.siteObject).Opens) ≤
      (BigFppfOver.toScheme B S hS).map N.point ⁻¹ᵁ W :=
    (Scheme.preimage_eq_top_of_closedPoint_mem _ hpW).ge
  rw [geometricEval_chartLocalRingToEtaleLocalRing_germ B S hS hX N W hpW hle a]
  exact Scheme.ΓSpecIso_appLE_eq_residue _ _ ψ hψ W hpW hle a

/-- **Geometric evaluation kills the maximal ideal of the étale local ring**: that ideal is
generated by the maximal ideal of the stalk of any chart, which evaluation kills. -/
theorem geometricEval_eq_zero_of_mem_maximalIdeal (x : GeometricPoint B S hS X)
    (r : (etaleLocalRing B S hS X x : Type (u + 1)))
    (hr : letI := isLocalRing_etaleLocalRing B S hS X hX x
      r ∈ maximalIdeal (etaleLocalRing B S hS X x : Type (u + 1))) :
    geometricEval B S hS X x r = 0 := by
  let := isLocalRing_etaleLocalRing B S hS X hX x
  obtain ⟨N⟩ := nonempty_smallEtaleNeighborhood hX x
  obtain ⟨ψ, hψ⟩ := Scheme.exists_eq_SpecMap_comp_fromSpecResidueField
    ((BigFppfOver.toScheme B S hS).map N.point) (x := chartPoint B S hS X N) rfl
  rw [← map_maximalIdeal_chartStalkToEtaleLocalRing B S hS hX N rfl] at hr
  have hle : (maximalIdeal ((chartScheme N.chart).presheaf.stalk (chartPoint B S hS X N))) ≤
      (RingHom.ker (geometricEval B S hS X x)).comap
        (chartStalkToEtaleLocalRing B S hS hX N rfl) := by
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker,
      geometricEval_chartStalkToEtaleLocalRing B S hS hX N rfl ψ hψ a]
    have h0 : (chartScheme N.chart).residue (chartPoint B S hS X N) a = 0 :=
      (IsLocalRing.residue_eq_zero_iff a).2 ha
    exact (congrArg ψ h0).trans (map_zero _)
  exact (RingHom.mem_ker).1 (Ideal.map_le_iff_le_comap.2 hle hr)

/-- **Evaluation at a geometric point on the residue field of the étale local ring.** -/
def etaleResidueFieldEval (x : GeometricPoint B S hS X) :
    letI := isLocalRing_etaleLocalRing B S hS X hX x
    ResidueField (etaleLocalRing B S hS X x : Type (u + 1)) →+* x.val.carrier :=
  letI := isLocalRing_etaleLocalRing B S hS X hX x
  Ideal.Quotient.lift _ (geometricEval B S hS X x)
    (geometricEval_eq_zero_of_mem_maximalIdeal B S hS hX x)

/-- Geometric evaluation on the residue field, on a residue. -/
theorem etaleResidueFieldEval_residue (x : GeometricPoint B S hS X)
    (r : (etaleLocalRing B S hS X x : Type (u + 1))) :
    letI := isLocalRing_etaleLocalRing B S hS X hX x
    etaleResidueFieldEval B S hS hX x (IsLocalRing.residue _ r) = geometricEval B S hS X x r :=
  rfl

/-- Geometric evaluation on `κR` after the residue map of the chart leg is the field map of the
lift of the geometric point. -/
theorem etaleResidueFieldEval_map_chartStalkToEtaleLocalRing {x : GeometricPoint B S hS X}
    (N : SmallEtaleNeighborhood x) {p : chartScheme N.chart} (hp : chartPoint B S hS X N = p)
    (ψ : (chartScheme N.chart).residueField p ⟶ .of x.val.carrier)
    (hψ : (BigFppfOver.toScheme B S hS).map N.point =
      Spec.map ψ ≫ (chartScheme N.chart).fromSpecResidueField p)
    (c : (chartScheme N.chart).residueField p) :
    letI := isLocalRing_etaleLocalRing B S hS X hX x
    haveI := isLocalHom_chartStalkToEtaleLocalRing B S hS hX N hp
    etaleResidueFieldEval B S hS hX x
        (ResidueField.map (chartStalkToEtaleLocalRing B S hS hX N hp) c) = ψ c := by
  let := isLocalRing_etaleLocalRing B S hS X hX x
  have := isLocalHom_chartStalkToEtaleLocalRing B S hS hX N hp
  obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective c
  rw [ResidueField.map_residue]
  exact geometricEval_chartStalkToEtaleLocalRing B S hS hX N hp ψ hψ r

variable (hdec : IsDecentSpace B S hS X) (Z : PrimeDivisor B S hS X)
  {xbar : GeometricPoint B S hS X} (hxbar : xbar.LiesOver (Z.genericPoint B S hS X))

/-- The field homomorphism `κ(u) → Ω` of the factorization of a geometric point over the generic
point of `Z` through the residue-field point of the chosen chart. -/
def PrimeDivisor.genericResidueFieldToGeometric :
    Z.genericResidueField B S hS hX hdec →+* xbar.val.carrier :=
  fieldValuedPointHom B S hS X xbar.val
    (neighborhoodFieldPoint B S hS X hX (Z.genericPoint B S hS X) (Z.genericChart B S hS hX hdec))
    ((Z.genericChart B S hS hX hdec).liftResidueField xbar hxbar)

/-- The lift of `x̄` to the chosen chart `(U, u)` is `Spec` of
`AlgebraicGeometry.Space.PrimeDivisor.genericResidueFieldToGeometric` followed by
`Spec κ(u) → U`. -/
theorem PrimeDivisor.toScheme_map_genericChartNeighborhood_point :
    (BigFppfOver.toScheme B S hS).map (Z.genericChartNeighborhood B S hS hX hdec hxbar).point =
      Spec.map (CommRingCat.ofHom (Z.genericResidueFieldToGeometric B S hS hX hdec hxbar)) ≫
        (chartScheme (Z.genericChartNeighborhood B S hS hX hdec hxbar).chart).fromSpecResidueField
          (Z.genericChart B S hS hX hdec).point := by
  refine ((BigFppfOver.toScheme B S hS).map_comp
    ((Z.genericChart B S hS hX hdec).liftResidueField xbar hxbar)
    (Z.genericChart B S hS hX hdec).fromResidueField).trans ?_
  exact congrArg₂ (· ≫ ·) (spec_fieldValuedPointHom B S hS X _ _ _).symm rfl

/-- **The henselian side of (K) in the field of `x̄`**: `κ(u) ≅ κ(𝒪^h_{X, ξ}) → κR → Ω` is the
field homomorphism of the factorization of `x̄` through the residue-field point of `(U, u)`. -/
theorem PrimeDivisor.etaleResidueFieldEval_henselianToEtaleLocalRing
    (c : Z.genericResidueField B S hS hX hdec) :
    letI := henselianLocalRing_isLocalRing B S hS X hX (Z.genericPoint B S hS X) hdec
    letI := isLocalRing_etaleLocalRing B S hS X hX xbar
    haveI := Z.isLocalHom_henselianToEtaleLocalRing B S hS hX hdec hxbar
    etaleResidueFieldEval B S hS hX xbar
        (ResidueField.map (Z.henselianToEtaleLocalRing B S hS hX hdec hxbar)
          (Z.genericResidueFieldEquivHenselian B S hS hX hdec c)) =
      Z.genericResidueFieldToGeometric B S hS hX hdec hxbar c := by
  let := henselianLocalRing_isLocalRing B S hS X hX (Z.genericPoint B S hS X) hdec
  let := isLocalRing_etaleLocalRing B S hS X hX xbar
  have := Z.isLocalHom_henselianToEtaleLocalRing B S hS hX hdec hxbar
  obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective c
  rw [Z.genericResidueFieldEquivHenselian_residue B S hS hX hdec r, ResidueField.map_residue,
    Z.henselianToEtaleLocalRing_stalkToHenselianLocalRing B S hS hX hdec hxbar r,
    etaleResidueFieldEval_residue]
  exact geometricEval_chartStalkToEtaleLocalRing B S hS hX _ _ _
    (Z.toScheme_map_genericChartNeighborhood_point B S hS hX hdec hxbar) r

/-- A morphism of the underlying schemes of two objects of the big fppf site over `S` which is
compatible with the structure morphisms is a morphism of the site. -/
theorem exists_siteHom_toScheme_map_eq {A A' : BigFppfOver B S hS}
    (h : (BigFppfOver.toScheme B S hS).obj A ⟶ (BigFppfOver.toScheme B S hS).obj A')
    (hw : h ≫ B.inclusion.map A'.hom = B.inclusion.map A.hom) :
    ∃ c : A ⟶ A', (BigFppfOver.toScheme B S hS).map c = h := by
  refine ⟨Over.homMk (B.inclusion.preimage h) (B.inclusion.map_injective ?_), ?_⟩
  · rw [Functor.map_comp, Functor.map_preimage]
    exact hw
  · exact B.inclusion.map_preimage h

/-- The field homomorphism of a morphism of field spectra is characterized by its `Spec`. -/
theorem fieldValuedPointHom_eq_of_SpecMap {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (p q : FieldValuedPoint B S hS F) (g : p.siteObject B S hS F ⟶ q.siteObject B S hS F)
    (φ : q.carrier →+* p.carrier)
    (h : Spec.map (CommRingCat.ofHom φ) = (BigFppfOver.toScheme B S hS).map g) :
    fieldValuedPointHom B S hS F p q g = φ :=
  congrArg CommRingCat.Hom.hom
    (Spec.map_injective ((spec_fieldValuedPointHom B S hS F p q g).trans h.symm))

/-- `Spec` of `κ(q') ≅ κ(q)` followed by `Spec κ(q') → W' → V` is `Spec κ(q) → V`. -/
theorem PrimeDivisor.SpecMap_baseChangeChartResidueFieldEquiv_symm (V : SmallEtale B S hS X)
    (q' : chartScheme (Z.baseChangeChart B S hS hX V)) {K : Type u} [Field K]
    (ψ : (chartScheme V).residueField (Z.baseChangeChartProj B S hS hX V q') ⟶ .of K) :
    Spec.map (CommRingCat.ofHom (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom ≫
        ψ) ≫ (chartScheme (Z.baseChangeChart B S hS hX V)).fromSpecResidueField q' ≫
          Z.baseChangeChartProj B S hS hX V =
      Spec.map ψ ≫ (chartScheme V).fromSpecResidueField (Z.baseChangeChartProj B S hS hX V q') := by
  have := Z.isClosedImmersion_baseChangeChartProj B S hS hX V
  have := residueFieldMap_isIso_of_isClosedImmersion (Z.baseChangeChartProj B S hS hX V) q'
  have h : (Z.baseChangeChartProj B S hS hX V).residueFieldMap q' ≫
      CommRingCat.ofHom (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom = 𝟙 _ :=
    (asIso ((Z.baseChangeChartProj B S hS hX V).residueFieldMap q')).hom_inv_id
  have e := Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField
    (Z.baseChangeChartProj B S hS hX V) q'
  have step : Spec.map (CommRingCat.ofHom
        (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom) ≫
        (chartScheme (Z.baseChangeChart B S hS hX V)).fromSpecResidueField q' ≫
          Z.baseChangeChartProj B S hS hX V =
      (chartScheme V).fromSpecResidueField (Z.baseChangeChartProj B S hS hX V q') := by
    refine (congrArg (Spec.map (CommRingCat.ofHom
        (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom) ≫ ·) e.symm).trans ?_
    rw [← Category.assoc, ← Spec.map_comp]
    refine (congrArg (fun t ↦ Spec.map t ≫ (chartScheme V).fromSpecResidueField
      (Z.baseChangeChartProj B S hS hX V q')) h).trans ?_
    rw [Spec.map_id]
    exact Category.id_comp _
  rw [Spec.map_comp, Category.assoc, step]

/-! ### The two maps `κ(u) → κ(𝒪_{X, x̄})` -/

/-- The residue map `κ(q) → κ(𝒪_{X, x̄})` of the chart leg at a point `q` of an étale chart. -/
def chartResidueFieldToEtale (V : SmallEtale B S hS X) (q : chartScheme V) :
    letI := isLocalRing_etaleLocalRing B S hS X hX (chartGeometricPointAt B S hS hX V q)
    (chartScheme V).residueField q →+*
      ResidueField (etaleLocalRing B S hS X (chartGeometricPointAt B S hS hX V q) : Type (u + 1)) :=
  letI := isLocalRing_etaleLocalRing B S hS X hX (chartGeometricPointAt B S hS hX V q)
  haveI : IsLocalHom (chartStalkAtToEtaleLocalRing B S hS hX V q) :=
    isLocalHom_chartStalkToEtaleLocalRing B S hS hX (chartNeighborhoodAt B S hS hX V q)
      (chartPoint_chartNeighborhoodAt B S hS hX V q)
  ResidueField.map (chartStalkAtToEtaleLocalRing B S hS hX V q)

/-- The residue map `κ(𝒪^h_{X, ξ}) → κ(𝒪_{X, x̄})` of the map of Stacks 0EMZ. -/
def PrimeDivisor.henselianResidueFieldToEtale :
    letI := henselianLocalRing_isLocalRing B S hS X hX (Z.genericPoint B S hS X) hdec
    letI := isLocalRing_etaleLocalRing B S hS X hX xbar
    ResidueField ↥(Z.genericHenselianLocalRing B S hS hX hdec) →+*
      ResidueField (etaleLocalRing B S hS X xbar : Type (u + 1)) :=
  letI := henselianLocalRing_isLocalRing B S hS X hX (Z.genericPoint B S hS X) hdec
  letI := isLocalRing_etaleLocalRing B S hS X hX xbar
  haveI := Z.isLocalHom_henselianToEtaleLocalRing B S hS hX hdec hxbar
  ResidueField.map (Z.henselianToEtaleLocalRing B S hS hX hdec hxbar)

variable (V : SmallEtale B S hS X) (q' : chartScheme (Z.baseChangeChart B S hS hX V))
    (hq' : chartSchemeToPoints B S hS X V (Z.baseChangeChartProj B S hS hX V q') =
      Z.genericPoint B S hS X)

include hq' in
/-- The geometric point over a point of `V` under a point of `V ×_X Z` over the generic point of
`Z` lies over that generic point. -/
theorem PrimeDivisor.liesOver_chartGeometricPointAt_baseChangeChartProj :
    (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).LiesOver
      (Z.genericPoint B S hS X) :=
  (chartGeometricPointAt_liesOver B S hS hX V _).trans hq'

/-- If the lift of `x̄` to `V` is `Spec ψ` followed by `Spec κ(q) → V`, then `Spec` of
`κ(q') ≅ κ(q) → Ω` is compatible with the structure morphisms of the field point of `V ×_X Z` at
`q'` and of the geometric point under `q'`. -/
private theorem PrimeDivisor.SpecMap_comp_baseChangeChartFieldPoint_hom
    (ψ : (chartScheme V).residueField (Z.baseChangeChartProj B S hS hX V q') ⟶
      .of (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).val.carrier)
    (hψ : (BigFppfOver.toScheme B S hS).map
        (chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).point =
      Spec.map ψ ≫ (chartScheme V).fromSpecResidueField (Z.baseChangeChartProj B S hS hX V q')) :
    Spec.map (CommRingCat.ofHom
        (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom ≫ ψ) ≫
      B.inclusion.map ((Z.baseChangeChartFieldPoint B S hS hX V q').siteObject B S hS
        Z.subspace.toFunctor).hom =
      B.inclusion.map ((chartGeometricPointAt B S hS hX V
        (Z.baseChangeChartProj B S hS hX V q')).val.siteObject B S hS X).hom := by
  have h1 := congrArg B.inclusion.map
    (Over.w (chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).point)
  have h2 := congrArg B.inclusion.map (Over.w (Z.baseChangeChartDiagram B S hS hX V).g)
  rw [Functor.map_comp] at h1 h2
  have e3 : B.inclusion.map ((Z.baseChangeChartFieldPoint B S hS hX V q').siteObject B S hS
      Z.subspace.toFunctor).hom =
      (chartScheme (Z.baseChangeChart B S hS hX V)).fromSpecResidueField q' ≫
        B.inclusion.map ((SmallEtale.toOver B S hS Z.subspace.toFunctor).obj
          (Z.baseChangeChartDiagram B S hS hX V).U).hom :=
    (Functor.map_comp _ _ _).trans (congrArg (· ≫ _) (map_siteMapOfSchemeMap B S hS _ _ _))
  rw [e3]
  refine (congrArg (fun t ↦ Spec.map (CommRingCat.ofHom
      (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom ≫ ψ) ≫
    (chartScheme (Z.baseChangeChart B S hS hX V)).fromSpecResidueField q' ≫ t) h2.symm).trans ?_
  refine Eq.trans ?_ h1
  refine Eq.trans ?_ (congrArg (· ≫ _)
    ((Z.SpecMap_baseChangeChartResidueFieldEquiv_symm B S hS hX V q' ψ).trans hψ.symm))
  simp only
  rfl

/-- A site map from the geometric point under `q'` to the field point of `V ×_X Z` at `q'` whose
composite to `V` is the lift of `x̄` factors the lift of `x̄` through the residue-field point of
`(U, u)`, since `Spec κ(u) → X` is a monomorphism (Stacks 0H2X). -/
private theorem PrimeDivisor.comp_genericFieldPointFactor_eq_liftResidueField
    (c : (chartGeometricPointAt B S hS hX V
        (Z.baseChangeChartProj B S hS hX V q')).val.siteObject B S hS X ⟶
      (Z.baseChangeChartFieldPoint B S hS hX V q').siteObject B S hS Z.subspace.toFunctor)
    (hpt : c ≫ (canonicalSiteFieldPoint B S hS _ q').siteHom ≫
      (Z.baseChangeChartDiagram B S hS hX V).g =
        (chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).point) :
    c ≫ Z.genericFieldPointFactor B S hS hX hdec (Z.baseChangeChartFieldPoint B S hS hX V q')
        (Z.class_baseChangeChartFieldPoint B S hS hX V q' hq') =
      (Z.genericChart B S hS hX hdec).liftResidueField
        (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q'))
        (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq') := by
  set F := Z.genericFieldPointFactor B S hS hX hdec (Z.baseChangeChartFieldPoint B S hS hX V q')
    (Z.class_baseChangeChartFieldPoint B S hS hX V q' hq')
  set g := (Z.genericChart B S hS hX hdec).liftResidueField
    (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q'))
    (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq')
  set N := chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')
  have : Mono (fieldMorphism B S hS X (neighborhoodFieldPoint B S hS X hX
      (Z.genericPoint B S hS X) (Z.genericChart B S hS hX hdec))) :=
    ElementaryEtaleNeighborhood.mono_neighborhoodFieldPoint B S hS X hX _ _
  apply yoneda.map_injective
  apply (cancel_mono (fieldMorphism B S hS X (neighborhoodFieldPoint B S hS X hX
    (Z.genericPoint B S hS X) (Z.genericChart B S hS hX hdec)))).1
  have hR : yoneda.map g ≫ fieldMorphism B S hS X (neighborhoodFieldPoint B S hS X hX
      (Z.genericPoint B S hS X) (Z.genericChart B S hS hX hdec)) =
      fieldMorphism B S hS X (chartGeometricPointAt B S hS hX V
        (Z.baseChangeChartProj B S hS hX V q')).val :=
    (yonedaEquiv_symm_naturality_left _ _ _).trans
      (congrArg yonedaEquiv.symm ((Z.genericChart B S hS hX hdec).map_liftResidueField _ _))
  refine Eq.trans ?_ hR.symm
  have h3 : yoneda.map F ≫ fieldMorphism B S hS Z.subspace.toFunctor
      (Z.genericFieldPoint B S hS hX hdec) ≫ Z.subspace.ι =
      fieldMorphism B S hS Z.subspace.toFunctor (Z.baseChangeChartFieldPoint B S hS hX V q') ≫
        Z.subspace.ι := by
    rw [← Category.assoc, Z.yoneda_map_genericFieldPointFactor_comp B S hS hX hdec]
  have h4 : fieldMorphism B S hS Z.subspace.toFunctor
      (Z.baseChangeChartFieldPoint B S hS hX V q') ≫ Z.subspace.ι =
      yoneda.map ((canonicalSiteFieldPoint B S hS _ q').siteHom ≫
        (Z.baseChangeChartDiagram B S hS hX V).g) ≫ V.obj.hom := by
    have h4a : fieldMorphism B S hS Z.subspace.toFunctor
        (Z.baseChangeChartFieldPoint B S hS hX V q') =
        yoneda.map (canonicalSiteFieldPoint B S hS _ q').siteHom ≫
          (Z.baseChangeChart B S hS hX V).obj.hom :=
      fieldMorphism_map_yoneda B S hS _ _ _
    refine (congrArg (· ≫ Z.subspace.ι) h4a).trans ((Category.assoc _ _ _).trans ?_)
    refine (congrArg (yoneda.map (canonicalSiteFieldPoint B S hS _ q').siteHom ≫ ·)
      (Z.baseChangeChartDiagram B S hS hX V).comm).trans ?_
    exact (Category.assoc _ _ _).symm.trans
      (congrArg (· ≫ V.obj.hom) (yoneda.map_comp _ _).symm)
  have h5 : yoneda.map N.point ≫ V.obj.hom = fieldMorphism B S hS X
      (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).val :=
    yonedaEquiv.injective ((yonedaEquiv_comp _ _).trans ((congrArg (V.obj.hom.app _)
      (yonedaEquiv_yoneda_map N.point)).trans
        (N.point_comp.trans (yonedaEquiv.apply_symm_apply _).symm)))
  refine ((congrArg₂ (· ≫ ·) (yoneda.map_comp c F)
    (Z.fieldMorphism_genericFieldPoint_comp_ι B S hS hX hdec).symm).trans
      (Category.assoc _ _ _)).trans ?_
  refine (congrArg (yoneda.map c ≫ ·) (h3.trans h4)).trans ?_
  exact ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ V.obj.hom)
    ((yoneda.map_comp _ _).symm.trans (congrArg yoneda.map hpt)))).trans h5

/-- **The chart side of (K) in the field of `x̄`**: if the lift of `x̄` to `V` is `Spec ψ`
followed by `Spec κ(q) → V`, then the field homomorphism `κ(u) → Ω` of the factorization of `x̄`
through the residue-field point of `(U, u)` is `κ(u) → κ(q') ≅ κ(q) → Ω`.  Both are field
homomorphisms of morphisms `Spec Ω → Spec κ(u)` lying over `x̄ : Spec Ω → X`, and `Spec κ(u) → X`
is a monomorphism (Stacks 0H2X). -/
theorem PrimeDivisor.genericResidueFieldToGeometric_eq_comp
    (ψ : (chartScheme V).residueField (Z.baseChangeChartProj B S hS hX V q') ⟶
      .of (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).val.carrier)
    (hψ : (BigFppfOver.toScheme B S hS).map
        (chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).point =
      Spec.map ψ ≫ (chartScheme V).fromSpecResidueField (Z.baseChangeChartProj B S hS hX V q')) :
    Z.genericResidueFieldToGeometric B S hS hX hdec
        (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq') =
      ψ.hom.comp ((Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom.comp
        (Z.genericResidueFieldToFieldPoint B S hS hX hdec
          (Z.baseChangeChartFieldPoint B S hS hX V q')
          (Z.class_baseChangeChartFieldPoint B S hS hX V q' hq'))) := by
  have key : Spec.map (CommRingCat.ofHom
        (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom ≫ ψ) ≫
      (chartScheme (Z.baseChangeChart B S hS hX V)).fromSpecResidueField q' ≫
      Z.baseChangeChartProj B S hS hX V = (BigFppfOver.toScheme B S hS).map
        (chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).point :=
    (Z.SpecMap_baseChangeChartResidueFieldEquiv_symm B S hS hX V q' ψ).trans hψ.symm
  obtain ⟨c, hc⟩ := exists_siteHom_toScheme_map_eq B S hS
    (A := (chartGeometricPointAt B S hS hX V
      (Z.baseChangeChartProj B S hS hX V q')).val.siteObject B S hS X)
    (A' := (Z.baseChangeChartFieldPoint B S hS hX V q').siteObject B S hS Z.subspace.toFunctor)
    (Spec.map (CommRingCat.ofHom
      (Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm.toRingHom ≫ ψ))
    (Z.SpecMap_comp_baseChangeChartFieldPoint_hom B S hS hX V q' ψ hψ)
  set F := Z.genericFieldPointFactor B S hS hX hdec (Z.baseChangeChartFieldPoint B S hS hX V q')
    (Z.class_baseChangeChartFieldPoint B S hS hX V q' hq') with hF
  set g := (Z.genericChart B S hS hX hdec).liftResidueField
    (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q'))
    (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq') with hg
  set N := chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q') with hN
  -- the scheme square
  have hpt : c ≫ (canonicalSiteFieldPoint B S hS _ q').siteHom ≫
      (Z.baseChangeChartDiagram B S hS hX V).g = N.point := by
    apply (BigFppfOver.toScheme B S hS).map_injective
    refine ((BigFppfOver.toScheme B S hS).map_comp _ _).trans ?_
    refine (congrArg₂ (· ≫ ·) hc ((BigFppfOver.toScheme B S hS).map_comp _ _)).trans
      (Eq.trans ?_ key)
    exact congrArg (fun t ↦ _ ≫ t ≫ _)
      (map_siteFieldPointOfSchemeMap_value_left B S hS _ _ _)
  have hcF : c ≫ F = g :=
    Z.comp_genericFieldPointFactor_eq_liftResidueField B S hS hX hdec V q' hq' c hpt
  refine fieldValuedPointHom_eq_of_SpecMap B S hS _ _ _ _ ?_
  refine Eq.trans ?_ (congrArg (BigFppfOver.toScheme B S hS).map hcF)
  rw [Functor.map_comp, hc]
  erw [← spec_fieldValuedPointHom B S hS Z.subspace.toFunctor _ _ F, ← Spec.map_comp]
  rfl

/-- **(K): the two maps `κ(u) → κ(𝒪_{X, x̄})` agree.** -/
theorem PrimeDivisor.chartResidueFieldToEtale_genericResidueFieldToFieldPoint
    (c : Z.genericResidueField B S hS hX hdec) :
    chartResidueFieldToEtale B S hS hX V (Z.baseChangeChartProj B S hS hX V q')
        ((Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm
          (Z.genericResidueFieldToFieldPoint B S hS hX hdec
            (Z.baseChangeChartFieldPoint B S hS hX V q')
            (Z.class_baseChangeChartFieldPoint B S hS hX V q' hq') c)) =
      Z.henselianResidueFieldToEtale B S hS hX hdec
        (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq')
        (Z.genericResidueFieldEquivHenselian B S hS hX hdec c) := by
  let := isLocalRing_etaleLocalRing B S hS X hX
    (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q'))
  obtain ⟨ψ, hψ⟩ := Scheme.exists_eq_SpecMap_comp_fromSpecResidueField
    ((BigFppfOver.toScheme B S hS).map
      (chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')).point)
    (chartPoint_chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q'))
  apply (etaleResidueFieldEval B S hS hX
    (chartGeometricPointAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q'))).injective
  refine (etaleResidueFieldEval_map_chartStalkToEtaleLocalRing B S hS hX _
    (chartPoint_chartNeighborhoodAt B S hS hX V (Z.baseChangeChartProj B S hS hX V q')) ψ hψ
    _).trans ?_
  refine Eq.trans ?_ (Z.etaleResidueFieldEval_henselianToEtaleLocalRing B S hS hX hdec
    (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq') c).symm
  exact (RingHom.congr_fun
    (Z.genericResidueFieldToGeometric_eq_comp B S hS hX hdec V q' hq' ψ hψ) c).symm

/-- **(G1'): the value at `q'` of a rational function of `Z`, transported to `κ(𝒪_{X, x̄})`, is the
residue of `θ⁻¹` of it.** -/
theorem PrimeDivisor.chartResidueFieldToEtale_baseChangeChartRationalReading
    (f : rationalFunctions B S hS Z.closed.1) :
    chartResidueFieldToEtale B S hS hX V (Z.baseChangeChartProj B S hS hX V q')
        ((Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm
          (Z.baseChangeChartRationalReading B S hS hX V q' hq' f)) =
      Z.henselianResidueFieldToEtale B S hS hX hdec
        (Z.liesOver_chartGeometricPointAt_baseChangeChartProj B S hS hX V q' hq')
        ((Z.henselianResidueFieldEquivFunctionField B S hS hX hdec).symm f) := by
  have h := Z.evalRingHom_eq_genericResidueFieldToFieldPoint B S hS hX hdec
    (Z.baseChangeChartFieldPoint B S hS hX V q')
    (Z.class_baseChangeChartFieldPoint B S hS hX V q' hq') f
  refine (congrArg (fun t ↦ chartResidueFieldToEtale B S hS hX V
    (Z.baseChangeChartProj B S hS hX V q')
    ((Z.baseChangeChartResidueFieldEquiv B S hS hX V q').symm t)) h).trans ?_
  exact Z.chartResidueFieldToEtale_genericResidueFieldToFieldPoint B S hS hX hdec V q' hq' _

end AlgebraicGeometry.Space
