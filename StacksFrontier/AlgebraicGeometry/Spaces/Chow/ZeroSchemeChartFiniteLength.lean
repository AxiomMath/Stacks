/-!
# Finiteness of the colength of the local equation of a divisor

At a point `x` of a scheme `Y` locally of finite type over the base of chapter 42, of relative
dimension `k` where `dim_δ(Y) ≤ k + 1`, let `a` be a function on an affine open around `x` whose
germ is a nonzerodivisor lying in the maximal ideal of `𝒪_{Y,x}`.  Then

  `length_{𝒪_{Y,x}} 𝒪_{Y,x}/(a) < ∞`.

This is the hypothesis `hfinite` of `Stacks.Chow.length_quotient_eq_sum_components` and of the
chart form of Stacks 0EQL, and it is a *consequence* of the hypotheses standing beside it: the
dimension bound `dim_δ(Y) ≤ k + 1` at a point of relative dimension `k` forces
`dim 𝒪_{Y,x} ≤ 1` (`Stacks.Chow.ringKrullDim_stalk_le_one`), a nonzerodivisor in the maximal
ideal makes the quotient by it a nontrivial ring of Krull dimension `0`, and a Noetherian ring of
Krull dimension `0` is Artinian, hence of finite length over itself.

## Main results

* `Module.length_quotient_span_ne_top_of_ringKrullDim_le_one`: over a Noetherian ring of Krull
  dimension at most one the quotient by a principal ideal generated by a nonzerodivisor has
  finite length.
* `Stacks.Chow.length_quotient_span_germ_stalk_ne_top`: **`hfinite` is not an extra input.**  The
  colength of the germ of a local equation at a point of relative dimension `k` of a scheme of
  δ-dimension at most `k + 1` is finite, given only that the germ is a nonzerodivisor in the
  maximal ideal.

## Implementation notes

Finiteness does not follow from regularity of the local equation *alone*; it does follow from
regularity together with the two δ-dimension inputs, which are present at every use site.  The
only ingredient regularity contributes is that `(a)` is not contained in any minimal prime, which
is `notMem_nonZeroDivisors_of_mem_mem_minimalPrimes`; the dimension bound does the rest.

Only an upper bound `dim 𝒪_{Y,x} ≤ 1` is used, so the statement does not go through
`natCard_minimalPrimes_le_length_quotient_span_singleton`, which asks for `dim = 1`: the
quotient of a Noetherian ring of dimension at most one by a nonzerodivisor has dimension at most
zero whether or not the ring itself has dimension exactly one, and that is all finiteness needs.

## References

* [Stacks Project, Tag 02QS](https://stacks.math.columbia.edu/tag/02QS)
* [Stacks Project, Tag 0EPI](https://stacks.math.columbia.edu/tag/0EPI)
* [Stacks Project, Tag 0EQL](https://stacks.math.columbia.edu/tag/0EQL)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

/-- **Over a Noetherian ring of Krull dimension at most one, the quotient by a nonzerodivisor has
finite length.**  Killing a nonzerodivisor drops the Krull dimension
(`ringKrullDim_quotient_succ_le_of_nonZeroDivisor`), so the quotient is a Noetherian ring of Krull
dimension at most zero, hence Artinian
(`isArtinianRing_iff_isNoetherianRing_krullDimLE_zero`) and therefore of finite length over
itself; length over the base ring is the same, the module structures agreeing through the
quotient map. -/
@[ega "IV 21.10.13" "(i) for M = A", sga "3 VIA 1.1.2" "special case"]
theorem Module.length_quotient_span_ne_top_of_ringKrullDim_le_one
    {R : Type*} [CommRing R] [IsNoetherianRing R] {z : R}
    (hz : z ∈ nonZeroDivisors R) (hdim : ringKrullDim R ≤ 1) :
    Module.length R (R ⧸ Ideal.span {z}) ≠ ⊤ := by
  rw [Module.length_ne_top_iff, isFiniteLength_iff_isNoetherian_isArtinian]
  have hfin : Module.Finite R (R ⧸ Ideal.span {z}) := Module.Finite.quotient R _
  have hnoeth : IsNoetherian R (R ⧸ Ideal.span {z}) :=
    isNoetherian_of_isNoetherianRing_of_finite R _
  refine ⟨hnoeth, ?_⟩
  have hdimq : ringKrullDim (R ⧸ Ideal.span {z}) ≤ (0 : ℕ) := by
    have h : ringKrullDim (R ⧸ Ideal.span {z}) + 1 ≤ 1 :=
      (ringKrullDim_quotient_succ_le_of_nonZeroDivisor hz).trans hdim
    exact ENat.WithBot.add_le_add_natCast_right_iff.mp h
  have hartRing : IsArtinianRing (R ⧸ Ideal.span {z}) := by
    rw [isArtinianRing_iff_isNoetherianRing_krullDimLE_zero]
    exact ⟨Ideal.Quotient.isNoetherianRing _,
      (Ring.krullDimLE_iff).mpr (by exact_mod_cast hdimq)⟩
  have : IsArtinian (R ⧸ Ideal.span {z}) (R ⧸ Ideal.span {z}) := inferInstance
  set I := Ideal.span {z}
  have : IsScalarTower R (R ⧸ I) (R ⧸ I) := IsScalarTower.right
  exact isArtinian_of_surjective_algebraMap (R := R ⧸ I) Ideal.Quotient.mk_surjective

namespace Stacks.Chow

open _root_.AlgebraicGeometry

/-- **The colength of a local equation at a point of relative dimension `k` is finite.**  Let `Y`
be locally of finite type over the base of chapter 42 with `dim_δ(Y) ≤ k + 1`, let `x` be a point
of relative dimension `k`, and let `a` be a section over an affine open around `x` whose germ at
`x` is a regular element of `𝒪_{Y,x}` lying in the maximal ideal.  Then
`length_{𝒪_{Y,x}} 𝒪_{Y,x}/(a_x)` is finite.

This is the hypothesis `hfinite` of `Stacks.Chow.length_quotient_eq_sum_components`, derived from
the hypotheses that accompany it there: `Stacks.Chow.ringKrullDim_stalk_le_one` bounds
`dim 𝒪_{Y,x}` by one, and `Module.length_quotient_span_ne_top_of_ringKrullDim_le_one` concludes.
Local finite-type-ness supplies the Noetherian hypothesis through
`AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian`. -/
theorem length_quotient_span_germ_stalk_ne_top (C : ChowSituation.{u}) {Y : Scheme.{u}}
    (f : Y ⟶ C.S) [LocallyOfFiniteType f] {k : ℤ}
    (hY : schemeDeltaDimension C f ≤ ((k + 1 : ℤ) : EInt))
    (x : Y) (hxdim : relativeDimension C.dimensionFunction f x = k)
    (U : Y.affineOpens) (hxU : x ∈ U.1) (a : Γ(Y, U.1))
    (ha : IsSMulRegular (Y.presheaf.stalk x) ((Y.presheaf.germ U.1 x hxU).hom a)) :
    Module.length (Y.presheaf.stalk x)
        (Y.presheaf.stalk x ⧸
          Ideal.span {((Y.presheaf.germ U.1 x hxU).hom a)}) ≠ ⊤ := by
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  have hb : (Y.presheaf.germ U.1 x hxU).hom a ∈ nonZeroDivisors (Y.presheaf.stalk x) :=
    mem_nonZeroDivisors_iff_left.mpr fun r hr =>
      ha (by simpa only [smul_eq_mul, mul_zero] using hr)
  exact Module.length_quotient_span_ne_top_of_ringKrullDim_le_one hb
    (ringKrullDim_stalk_le_one C f hY x hxdim)

end Stacks.Chow

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (sX : X ⟶ D.space) (hX : D.IsGood sX)
    (L : Modules.{u, u} D.site D.base D.base_mem X hX.1) (s : L.sections)

/-- **The identity of Stacks 0EQL on an algebraic space carrying a surjective affine étale chart
which trivialises `ℒ`.**  In Situation 0EDT let `X/B` be good, let `ℒ` be an invertible
`𝒪_X`-module, let `s ∈ Γ(X, ℒ)` be a **regular** section and assume `dim_δ(X) ≤ k + 1`.  Write
`[X]_{k+1} = ∑ n_i [X_i]` over the irreducible components `X_i ⊆ X` of δ-dimension `k + 1` and
set `s_i = s|_{X_i}`.  If `X` has a surjective affine étale scheme chart `V` carrying a
compatible family `e` of free generators of `ℒ` over the charts above it, then

`[Z(s)]_k = ∑ n_i [Z(s_i)]_k`

as `k`-cycles on `X`, that is, as coefficient families on the integral closed subspaces of `X`.

Beyond the hypotheses of the source this carries only the chart `V` with its trivialising family
and the choices `γ`, `γW`, `γZ` of geometric representatives of generic points, which are the
data every cycle in this development is written at.  Every *result* the earlier reductions
carried is discharged here:

* `hfinite`, the finiteness of `length 𝒪_{V,v}/(a)`, by
  `Stacks.Chow.length_quotient_span_germ_stalk_ne_top`;
* `hDdim`, the bound `dim_δ(Z(s)) ≤ k` on the chart, by
  `AlgebraicGeometry.Space.schemeDeltaDimension_subschemeι_sectionEvaluationIdealAt_le`;
* the local equation `U = ⊤`, `a`, `haD`, `ha`, `ham`, by
  `AlgebraicGeometry.Space.exists_germ_generates_stalk_sectionEvaluationIdealAt_of_free_generator`;
* `hvD`, that the chart point lies on the chart of `Z(s)`, by
  `AlgebraicGeometry.Space.ker_closedSubspaceBaseChangeChartProj_zeroScheme` together with
  `AlgebraicGeometry.Space.range_closedSubspaceBaseChangeChartProj`: the support of the ideal
  sheaf the evaluation ideal induces on the chart is the preimage of `|Z(s)|`;
* `hEgood` and `hVLgood`, the goodness over the base of `Z(s)` and of each `Z(s_i)`, by
  `AlgebraicGeometry.Space.isGood_closedSubspace` — a closed subspace of a good space is good, so
  these were never inputs;
* `hover`, the hypothesis of
  `AlgebraicGeometry.Space.cycleCoeffOfClosedSubspace_vanishingLocus_eq_componentZeroCycleSumCoeff`
  that a point of `Z(s_i)` lies over a point of `Z(s)`, which is **not used at all** here: that
  hypothesis exists only to make the right-hand side vanish away from `Z(s)`, and on the chart
  the same vanishing is read off the ideal sheaves —
  `AlgebraicGeometry.Space.ker_componentVanishingLocusChartImmersion` presents the chart of
  `Z(s_i)` as cut out by the equations of `X_i` *together with* the evaluation ideal of `s`, so a
  chart point off the support of the evaluation ideal is off the chart of every `Z(s_i)`.

**This carries no `@[stacks 0EQL]` attribute, and must not.**  The chart hypothesis is an extra
hypothesis of the statement, not of the source: Stacks 0EQL proceeds through a surjective étale
`φ : V → X` with `V` a *scheme*, and an arbitrary good `X/B` has one, whereas a surjective étale
chart with `V` **affine** exists only when `X` is quasi-compact — a disjoint union of infinitely
many affine schemes is a scheme and is not affine — and `IsGood` is quasi-separatedness together
with local finite-type-ness, neither of which implies quasi-compactness.  So this is Stacks 0EQL
for quasi-compact `X` with `ℒ` trivialised on one chart, and registering the tag on it would
report a special case as the source.

What the general case needs is therefore not a missing piece of local algebra but the chart
chain over a non-affine chart: `AlgebraicGeometry.Space.sectionEvaluationIdealAt` is an ideal of
`Γ(V, ⊤)` and enters every step through
`AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop`, which determines an ideal sheaf by its
global sections only over an affine scheme. -/
theorem cycleCoeffOfClosedSubspace_vanishingLocus_eq_componentZeroCycleSumCoeff_of_trivialisingChart
    (k : ℤ) (hL : IsInvertibleSheaf D sX hX L)
    (hsreg : AlgebraicGeometry.IsRegularSection
      (structureCommRings D.site D.base D.base_mem ⟨X, hX.1⟩)
      (structureRingSheaf D.site D.base D.base_mem ⟨X, hX.1⟩).property s)
    (hdim : deltaDimensionClosed D sX hX Set.univ isClosed_univ ≤ ((k + 1 : ℤ) : EInt))
    (V : SmallEtale D.site D.base D.base_mem X) [IsAffine (chartScheme V)]
    (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme D.site D.base D.base_mem))) V.obj.hom)
    (e : (T : SmallEtale D.site D.base D.base_mem X) → (T ⟶ V) → L.val.obj (op T))
    (hcompat : ∀ (T T' : SmallEtale D.site D.base D.base_mem X) (j : T ⟶ V) (g : T' ⟶ T),
      (L.val.map g.op).hom (e T j) = e T' (g ≫ j))
    (hfree : ∀ (T : SmallEtale D.site D.base D.base_mem X) (j : T ⟶ V),
      Function.Bijective fun r : chartRing D.site D.base D.base_mem X hX.1 T ↦ r • e T j)
    (γ : points D.site D.base D.base_mem X → GeometricPoint D.site D.base D.base_mem X)
    (hγ : ∀ x, (γ x).image = x)
    (γW : ComponentGeometricRepresentatives D sX hX L s k)
    (hγW : ∀ (W : ComponentsOfDeltaDimension D sX hX (k + 1)) y, (γW W y).image = y)
    (γZ : points D.site D.base D.base_mem (vanishingLocus D sX hX L s).1.toFunctor →
      GeometricPoint D.site D.base D.base_mem (vanishingLocus D sX hX L s).1.toFunctor)
    (hγZ : ∀ y, (γZ y).image = y) :
    cycleCoeffOfClosedSubspace D sX hX (vanishingLocus D sX hX L s).1
        (vanishingLocus D sX hX L s).2 k γZ =
      componentZeroCycleSumCoeff D sX hX L s k γ γW := by
  classical
  have hft := locallyOfFiniteType_id_chartChowSituation D sX hX V hs
  have hEgood : D.IsGood ((vanishingLocus D sX hX L s).1.ι ≫ sX) :=
    isGood_closedSubspace D sX hX (vanishingLocus D sX hX L s)
  have hVLgood : ∀ W : ComponentsOfDeltaDimension D sX hX (k + 1),
      D.IsGood ((componentVanishingLocus D sX hX L s W.1).1.ι ≫ W.1.subspace.ι ≫ sX) :=
    fun W => isGood_closedSubspace D (W.1.subspace.ι ≫ sX)
      (isGood_integralClosedSubspace D sX hX W.1) (componentVanishingLocus D sX hX L s W.1)
  have hsurjpt : Function.Surjective (chartSchemeToPoints D.site D.base D.base_mem X V) :=
    surjective_chartSchemeToPoints D.site D.base D.base_mem X V
      ((surjective_iff_surjective_pointsMap D.site D.base D.base_mem X hX.1 V.obj.left
        V.obj.hom).mp hs)
  have hYdim : Stacks.Chow.schemeDeltaDimension (chartChowSituation D sX hX V hs)
      (𝟙 (chartScheme V)) ≤ (((k + 1 : ℤ) : ℤ) : EInt) :=
    schemeDeltaDimension_id_chartChowSituation_le D sX hX V hs (k + 1) hdim
  have hDdim := schemeDeltaDimension_subschemeι_sectionEvaluationIdealAt_le D sX hX L s hsreg
    V hs (e V (𝟙 V)) (hfree V (𝟙 V)) k hdim
  funext Z
  by_cases hZk : deltaDimension D sX Z = k
  · obtain ⟨v, hv⟩ := hsurjpt (Z.ambientGenericPoint D.site D.base D.base_mem)
    have hvdim : Stacks.Chow.relativeDimension (chartChowSituation D sX hX V hs).dimensionFunction
        (𝟙 (chartScheme V)) v = k :=
      (deltaDimension_eq_relativeDimension_id_chartChowSituation D sX hX V hs Z v hv).symm.trans
        hZk
    by_cases hvD : v ∈ (Scheme.IdealSheafData.ofIdealTop
        (sectionEvaluationIdealAt D.site D.base D.base_mem ⟨X, hX.1⟩ L s V)).support
    · obtain ⟨a, haD, ha, ham⟩ :=
        exists_germ_generates_stalk_sectionEvaluationIdealAt_of_free_generator D sX hX L s hsreg
          V (e V (𝟙 V)) (hfree V (𝟙 V)) v hvD
      exact cycleCoeffOfClosedSubspace_eq_componentZeroCycleSumCoeff_chart_of_trivialisingChart
        D sX hX L s k hL hEgood hVLgood V hs e hcompat hfree γ hγ γW hγW γZ hγZ Z v hv hvD
        ⟨⊤, isAffineOpen_top (chartScheme V)⟩ trivial a haD ha ham
        (Stacks.Chow.length_quotient_span_germ_stalk_ne_top (chartChowSituation D sX hX V hs)
          (𝟙 (chartScheme V)) hYdim v hvdim ⟨⊤, isAffineOpen_top (chartScheme V)⟩ trivial a ha)
        hdim hZk hDdim
    · -- `v` lies off the chart of `Z(s)`: both sides vanish at `Z`
      have hLHS : cycleCoeffOfClosedSubspace D sX hX (vanishingLocus D sX hX L s).1
          (vanishingLocus D sX hX L s).2 k γZ Z = 0 := by
        rw [cycleCoeffOfClosedSubspace_zeroScheme_eq_cycleAssociatedToClosedSubscheme_chart
          D sX hX L hL s hEgood V hs k γZ hγZ Z v hv]
        refine Stacks.Chow.cycleAssociatedToClosedSubscheme_apply_eq_zero_of_notMem_range _ _ _
          k ?_
        rw [Scheme.IdealSheafData.range_subschemeι]
        exact hvD
      have hRHS : componentZeroCycleSumCoeff D sX hX L s k γ γW Z = 0 := by
        choose wpt hwpt using fun Xi : ComponentsOfDeltaDimension D sX hX (k + 1) =>
          hsurjpt (Xi.1.ambientGenericPoint D.site D.base D.base_mem)
        rw [componentZeroCycleSumCoeff_eq_finsum_cycleAssociatedToClosedSubscheme_chart
          D sX hX L s k γ hγ γW hγW hVLgood V hs wpt hwpt Z v hv]
        refine finsum_eq_zero_of_forall_eq_zero fun W => mul_eq_zero_of_right _ ?_
        have hci := isClosedImmersion_componentVanishingLocusChartImmersion D sX hX L s W.1 V
        refine Stacks.Chow.cycleAssociatedToClosedSubscheme_apply_eq_zero_of_notMem_range _ _ _
          k fun hmem => ?_
        have h1 : v ∈ (componentVanishingLocusChartImmersion D sX hX L s W.1 V).ker.support := by
          change v ∈ (((componentVanishingLocusChartImmersion D sX hX L s W.1 V).ker.support :
            _) : Set (chartScheme V))
          rw [Scheme.Hom.support_ker]
          exact subset_closure hmem
        rw [ker_componentVanishingLocusChartImmersion D sX hX L s hL W.1 V e hcompat hfree,
          Scheme.IdealSheafData.support_sup] at h1
        exact hvD h1.2
      rw [hLHS, hRHS]
  · rw [cycleCoeffOfClosedSubspace, ite_eq_right hZk,
      componentZeroCycleSumCoeff_eq_zero_of_deltaDimension_ne D sX hX L s k γ γW hZk]

end AlgebraicGeometry.Space

