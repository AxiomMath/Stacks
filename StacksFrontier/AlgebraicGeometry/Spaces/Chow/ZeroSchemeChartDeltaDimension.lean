-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Scheme

/-- **A point whose local ring has a nonzerodivisor in its maximal ideal is not a minimal point.**
If the local ring of a scheme at `y` contains a nonzerodivisor lying in the maximal ideal, then
some point of the scheme other than `y` specializes to `y`. -/
theorem exists_specializes_ne_of_mem_nonZeroDivisors_maximalIdeal {Y : Scheme.{u}} (y : Y)
    {x : Y.presheaf.stalk y} (hx : x ∈ nonZeroDivisors (Y.presheaf.stalk y))
    (hm : x ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) :
    ∃ z : Y, z ⤳ y ∧ z ≠ y := by
  have : (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal (Y.presheaf.stalk y)).isPrime
  obtain ⟨q, hq, -⟩ := Ideal.exists_minimalPrimes_le
    (I := (⊥ : Ideal (Y.presheaf.stalk y)))
    (J := IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) bot_le
  have hqp : q.IsPrime := hq.1.1
  have hxq : x ∉ q := fun h => notMem_nonZeroDivisors_of_mem_mem_minimalPrimes h hq hx
  refine ⟨Y.fromSpecStalk y ⟨q, hqp⟩, ?_, ?_⟩
  · have hmem : Y.fromSpecStalk y ⟨q, hqp⟩ ∈ Set.range (Y.fromSpecStalk y) := ⟨_, rfl⟩
    rwa [Scheme.range_fromSpecStalk] at hmem
  · refine fun hzy => hxq ?_
    have hpt : (⟨q, hqp⟩ : PrimeSpectrum (Y.presheaf.stalk y)) =
        IsLocalRing.closedPoint (Y.presheaf.stalk y) :=
      (Y.fromSpecStalk y).isEmbedding.injective
        (hzy.trans (Scheme.fromSpecStalk_closedPoint (x := y)).symm)
    have hq' : q = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
      congrArg PrimeSpectrum.asIdeal hpt
    rwa [hq']

/-- **A nonzerodivisor on an affine scheme has nonzerodivisor germs.**  The germ at any point of
a nonzerodivisor of the ring of global sections of an affine scheme is a nonzerodivisor of the
local ring. -/
@[ega "IV 20.1.3" "special case"]
theorem germ_top_mem_nonZeroDivisors_stalk {Y : Scheme.{u}} [IsAffine Y] {g : Γ(Y, ⊤)}
    (hg : g ∈ nonZeroDivisors Γ(Y, ⊤)) (y : Y) :
    (Y.presheaf.germ ⊤ y trivial).hom g ∈ nonZeroDivisors (Y.presheaf.stalk y) := by
  let : Algebra Γ(Y, ⊤) (Y.presheaf.stalk y) :=
    (Y.presheaf.germ ⊤ y trivial).hom.toAlgebra
  have := (isAffineOpen_top Y).isLocalization_stalk ⟨y, trivial⟩
  have : Module.Flat Γ(Y, ⊤) (Y.presheaf.stalk y) :=
    IsLocalization.flat (Y.presheaf.stalk y)
      ((isAffineOpen_top Y).primeIdealOf ⟨y, trivial⟩).asIdeal.primeCompl
  have hstalk : IsLeftRegular ((Y.presheaf.germ ⊤ y trivial).hom g) :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Y.presheaf.stalk y) hg
  exact isRegular_iff_mem_nonZeroDivisors.1 (isLeftRegular_iff_isRegular.1 hstalk)

/-- **A point of the closed subscheme cut out by an ideal has non-unit germs of its elements.**
On an affine scheme, the germ at a point of the support of the ideal sheaf induced by an ideal `I`
of global sections of an element of `I` lies in the maximal ideal of the local ring. -/
theorem germ_mem_maximalIdeal_of_mem_support_ofIdealTop {Y : Scheme.{u}} [IsAffine Y]
    (I : Ideal Γ(Y, ⊤)) {g : Γ(Y, ⊤)} (hgI : g ∈ I) (y : Y)
    (hy : y ∈ (Scheme.IdealSheafData.ofIdealTop I).support) :
    (Y.presheaf.germ ⊤ y trivial).hom g ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
  have htop : (Scheme.IdealSheafData.ofIdealTop I).ideal ⟨⊤, isAffineOpen_top Y⟩ = I := by
    simp
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨⊤, isAffineOpen_top Y⟩) trivial,
    Scheme.mem_zeroLocus_iff] at hy
  exact (IsLocalRing.mem_maximalIdeal _).2 fun h =>
    hy g (by rwa [htop]) ((Y.mem_basicOpen g y trivial).2 h)

/-- The germ of a nonzerodivisor on an affine scheme is a regular element of the local ring. -/
theorem germ_top_isSMulRegular_stalk {Y : Scheme.{u}} [IsAffine Y] {g : Γ(Y, ⊤)}
    (hg : g ∈ nonZeroDivisors Γ(Y, ⊤)) (y : Y) :
    IsSMulRegular (Y.presheaf.stalk y) ((Y.presheaf.germ ⊤ y trivial).hom g) :=
  (isRegular_iff_mem_nonZeroDivisors.2 (germ_top_mem_nonZeroDivisors_stalk hg y)).left

/-- **The stalk of the ideal sheaf induced by a principal ideal is generated by the germ of its
generator.**  On an affine scheme the ideal sheaf induced by `(g) ⊆ Γ(Y, ⊤)` has, at every point,
the principal stalk `(g_y)`. -/
theorem stalk_ofIdealTop_span_singleton {Y : Scheme.{u}} [IsAffine Y] (g : Γ(Y, ⊤)) (y : Y) :
    AlgebraicGeometry.IdealSheafData.stalk
        (Scheme.IdealSheafData.ofIdealTop (Ideal.span {g})) y =
      Ideal.span {(Y.presheaf.germ ⊤ y trivial).hom g} := by
  have htop : (Scheme.IdealSheafData.ofIdealTop (Ideal.span {g})).ideal
      ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span {g} := by
    simp
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ _ ⟨⊤, isAffineOpen_top Y⟩ trivial,
    htop]
  exact (Ideal.map_span (Y.presheaf.germ ⊤ y trivial).hom {g}).trans
    (by rw [Set.image_singleton])

end AlgebraicGeometry.Scheme

namespace Stacks.Chow

open _root_.AlgebraicGeometry

/-- **The δ-dimension drop at a closed subscheme that is nowhere a component.**  If the ambient
scheme has δ-dimension at most `k + 1` and at every point of the closed subscheme the ambient
local ring carries a nonzerodivisor in its maximal ideal, then the closed subscheme has
δ-dimension at most `k`. -/
@[ega "IV 4.1.2.1" "partial"]
theorem schemeDeltaDimension_comp_le_of_forall_exists_nonZeroDivisors_stalk
    (C : ChowSituation.{u}) {Y W : Scheme.{u}} (f : Y ⟶ C.S) [LocallyOfFiniteType f]
    (j : W ⟶ Y) [IsClosedImmersion j] {k : ℤ}
    (hY : schemeDeltaDimension C f ≤ ((k + 1 : ℤ) : EInt))
    (hreg : ∀ w : W, ∃ x ∈ nonZeroDivisors (Y.presheaf.stalk (j w)),
      x ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (j w))) :
    schemeDeltaDimension C (j ≫ f) ≤ (k : EInt) := by
  refine schemeDeltaDimension_le_of_forall_relativeDimension_le C f j fun w => ?_
  obtain ⟨x, hx, hm⟩ := hreg w
  obtain ⟨z, hz, hzne⟩ :=
    AlgebraicGeometry.Scheme.exists_specializes_ne_of_mem_nonZeroDivisors_maximalIdeal
      (j w) hx hm
  have hlt := (deltaDimensionFunction C f).strictAnti_specializes hz hzne
  rw [deltaDimensionFunction_apply, deltaDimensionFunction_apply] at hlt
  have hle := relativeDimension_le_of_schemeDeltaDimension_le' C f hY z
  omega

/-- **The δ-dimension drop at a closed subscheme of an affine scheme cut out by an ideal
containing a nonzerodivisor.**  If the affine scheme has δ-dimension at most `k + 1` and the
ideal `I` contains a nonzerodivisor `g`, then the closed subscheme cut out by `I` has
δ-dimension at most `k`. -/
theorem schemeDeltaDimension_subschemeι_ofIdealTop_le_of_mem_nonZeroDivisors
    (C : ChowSituation.{u}) {Y : Scheme.{u}} [IsAffine Y] (f : Y ⟶ C.S) [LocallyOfFiniteType f]
    (I : Ideal Γ(Y, ⊤)) {g : Γ(Y, ⊤)} (hgI : g ∈ I) (hg : g ∈ nonZeroDivisors Γ(Y, ⊤)) {k : ℤ}
    (hY : schemeDeltaDimension C f ≤ ((k + 1 : ℤ) : EInt)) :
    schemeDeltaDimension C ((Scheme.IdealSheafData.ofIdealTop I).subschemeι ≫ f) ≤ (k : EInt) := by
  refine schemeDeltaDimension_comp_le_of_forall_exists_nonZeroDivisors_stalk C f _ hY fun w => ?_
  refine ⟨_, AlgebraicGeometry.Scheme.germ_top_mem_nonZeroDivisors_stalk hg _,
    AlgebraicGeometry.Scheme.germ_mem_maximalIdeal_of_mem_support_ofIdealTop I hgI _ ?_⟩
  have hmem : (Scheme.IdealSheafData.ofIdealTop I).subschemeι w ∈
      Set.range (Scheme.IdealSheafData.ofIdealTop I).subschemeι := ⟨w, rfl⟩
  rwa [Scheme.IdealSheafData.range_subschemeι] at hmem

end Stacks.Chow

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

/-- **On a chart carrying a free generator of `ℒ`, the evaluation ideal of a regular section is
generated by a single nonzerodivisor.**  If `t` freely generates `ℒ(V)` and `s` is a regular
section, the evaluation ideal of Stacks 0845 at `V` is generated by a regular function on `V`,
namely the coordinate `l₀(s)` of `s` with respect to `t`. -/
theorem exists_isRegular_sectionEvaluationIdealAt_eq_span_of_free_generator
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hs : AlgebraicGeometry.IsRegularSection (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property s)
    (V : SmallEtale B S hS X.1) (t : ToType (L.val.obj (op V)))
    (hfree : Function.Bijective fun r : chartRing B S hS X.1 X.2 V => r • t) :
    ∃ g : Γ(chartScheme V, ⊤), _root_.IsRegular g ∧
      sectionEvaluationIdealAt B S hS X L s V = Ideal.span {g} := by
  let R := chartRing B S hS X.1 X.2 V
  let φ : R ≃ₗ[R] ToType (L.val.obj (op V)) :=
    LinearEquiv.ofBijective (LinearMap.toSpanSingleton R (ToType (L.val.obj (op V))) t) hfree
  let l₀ : Module.Dual R (L.val.obj (op V)) := φ.symm.toLinearMap
  have hb : ∀ x, l₀ x • t = x := fun x => φ.apply_symm_apply x
  have hinj : Function.Injective (fun r : R => r • s.eval (op V)) :=
    (isRegularSection_iff_forall_injective_smul B S hS X L s).1 hs (op V)
  have hmul : Function.Injective (fun r : R => r * l₀ (s.eval (op V))) :=
    (injective_smul_eval_iff_injective_mul_generator B S hS X L s V t l₀ hb).1 hinj
  exact ⟨l₀ (s.eval (op V)), isRegular_of_injective_mul_right hmul,
    sectionEvaluationIdealAt_eq_span_singleton B S hS X L s V t l₀ hb⟩

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (sX : X ⟶ D.space) (hX : D.IsGood sX)
    (L : Modules.{u, u} D.site D.base D.base_mem X hX.1) (s : L.sections)

/-- A regular section has, on a chart with a free generator of `ℒ`, an evaluation ideal generated
by a nonzerodivisor of the ring of global sections. -/
private theorem exists_mem_nonZeroDivisors_sectionEvaluationIdealAt_eq_span
    (hsreg : AlgebraicGeometry.IsRegularSection
      (structureCommRings D.site D.base D.base_mem ⟨X, hX.1⟩)
      (structureRingSheaf D.site D.base D.base_mem ⟨X, hX.1⟩).property s)
    (V : SmallEtale D.site D.base D.base_mem X) [IsAffine (chartScheme V)]
    (t : ToType (L.val.obj (op V)))
    (hfree : Function.Bijective
      fun r : chartRing D.site D.base D.base_mem X hX.1 V => r • t) :
    ∃ g ∈ nonZeroDivisors Γ(chartScheme V, ⊤),
      sectionEvaluationIdealAt D.site D.base D.base_mem ⟨X, hX.1⟩ L s V = Ideal.span {g} := by
  obtain ⟨g, hgreg, hgspan⟩ :=
    exists_isRegular_sectionEvaluationIdealAt_eq_span_of_free_generator D.site D.base D.base_mem
      ⟨X, hX.1⟩ L s hsreg V t hfree
  exact ⟨g, isRegular_iff_mem_nonZeroDivisors.1 hgreg, hgspan⟩

/-- **The δ-dimension bound `dim_δ(Z(s)) ≤ k` of Stacks 0EQL, read on an affine étale chart.**
Let `X/B` be good with `dim_δ(X) ≤ k + 1`, let `ℒ` be an `𝒪_X`-module with a **regular** global
section `s`, and let `V` be an affine étale chart of `X` carrying a free generator `t` of `ℒ(V)`.
Then the closed subscheme of the chart cut out by the evaluation ideal of `s` — the chart of the
zero scheme `Z(s)` of Stacks 0845 — has δ-dimension at most `k` for the situation on the
chart. -/
theorem schemeDeltaDimension_subschemeι_sectionEvaluationIdealAt_le
    (hsreg : AlgebraicGeometry.IsRegularSection
      (structureCommRings D.site D.base D.base_mem ⟨X, hX.1⟩)
      (structureRingSheaf D.site D.base D.base_mem ⟨X, hX.1⟩).property s)
    (V : SmallEtale D.site D.base D.base_mem X) [IsAffine (chartScheme V)]
    (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme D.site D.base D.base_mem))) V.obj.hom)
    (t : ToType (L.val.obj (op V)))
    (hfree : Function.Bijective
      fun r : chartRing D.site D.base D.base_mem X hX.1 V => r • t)
    (k : ℤ)
    (hdim : deltaDimensionClosed D sX hX Set.univ isClosed_univ ≤ ((k + 1 : ℤ) : EInt)) :
    haveI hft := locallyOfFiniteType_id_chartChowSituation D sX hX V hs
    haveI hftD := locallyOfFiniteType_subschemeι_comp_id_chartChowSituation D sX hX V hs
      (Scheme.IdealSheafData.ofIdealTop
        (sectionEvaluationIdealAt D.site D.base D.base_mem ⟨X, hX.1⟩ L s V))
    Stacks.Chow.schemeDeltaDimension (chartChowSituation D sX hX V hs)
        ((Scheme.IdealSheafData.ofIdealTop (sectionEvaluationIdealAt D.site D.base D.base_mem
          ⟨X, hX.1⟩ L s V)).subschemeι ≫ 𝟙 (chartScheme V)) ≤ (k : EInt) := by
  have hft := locallyOfFiniteType_id_chartChowSituation D sX hX V hs
  obtain ⟨g, hg, hgspan⟩ :=
    exists_mem_nonZeroDivisors_sectionEvaluationIdealAt_eq_span D sX hX L s hsreg V t hfree
  have hYdim : Stacks.Chow.schemeDeltaDimension (chartChowSituation D sX hX V hs)
      (𝟙 (chartScheme V)) ≤ (((k + 1 : ℤ) : ℤ) : EInt) :=
    schemeDeltaDimension_id_chartChowSituation_le D sX hX V hs (k + 1) hdim
  rw [hgspan]
  exact Stacks.Chow.schemeDeltaDimension_subschemeι_ofIdealTop_le_of_mem_nonZeroDivisors
    (chartChowSituation D sX hX V hs) (𝟙 (chartScheme V)) _
    (Ideal.mem_span_singleton_self g) hg hYdim

/-- **The local equation of `Z(s)` at a chart point, with its regularity and its
non-invertibility.**
On an affine étale chart `V` carrying a free generator `t` of `ℒ(V)`, a **regular** section `s`
has, at every point `v` of the chart lying on `Z(s)`, a single global regular function `a` on `V`
whose germ generates the stalk of the chart ideal sheaf of `Z(s)` at `v`, is a nonzerodivisor of
`𝒪_{V,v}`, and lies in the maximal ideal of `𝒪_{V,v}`. -/
theorem exists_germ_generates_stalk_sectionEvaluationIdealAt_of_free_generator
    (hsreg : AlgebraicGeometry.IsRegularSection
      (structureCommRings D.site D.base D.base_mem ⟨X, hX.1⟩)
      (structureRingSheaf D.site D.base D.base_mem ⟨X, hX.1⟩).property s)
    (V : SmallEtale D.site D.base D.base_mem X) [IsAffine (chartScheme V)]
    (t : ToType (L.val.obj (op V)))
    (hfree : Function.Bijective
      fun r : chartRing D.site D.base D.base_mem X hX.1 V => r • t)
    (v : chartScheme V)
    (hvD : v ∈ (Scheme.IdealSheafData.ofIdealTop (X := chartScheme V)
      (sectionEvaluationIdealAt D.site D.base D.base_mem ⟨X, hX.1⟩ L s V)).support) :
    ∃ a : Γ(chartScheme V, (⟨⊤, isAffineOpen_top (chartScheme V)⟩ :
        (chartScheme V).affineOpens).1),
      AlgebraicGeometry.IdealSheafData.stalk (Scheme.IdealSheafData.ofIdealTop
          (X := chartScheme V)
          (sectionEvaluationIdealAt D.site D.base D.base_mem ⟨X, hX.1⟩ L s V)) v =
        Ideal.span {((chartScheme V).presheaf.germ
          (⟨⊤, isAffineOpen_top (chartScheme V)⟩ : (chartScheme V).affineOpens).1 v
          trivial).hom a} ∧
      IsSMulRegular ((chartScheme V).presheaf.stalk v)
        (((chartScheme V).presheaf.germ
          (⟨⊤, isAffineOpen_top (chartScheme V)⟩ : (chartScheme V).affineOpens).1 v
          trivial).hom a) ∧
      ((chartScheme V).presheaf.germ
          (⟨⊤, isAffineOpen_top (chartScheme V)⟩ : (chartScheme V).affineOpens).1 v
          trivial).hom a ∈
        IsLocalRing.maximalIdeal ((chartScheme V).presheaf.stalk v) := by
  obtain ⟨g, hg, hgspan⟩ :=
    exists_mem_nonZeroDivisors_sectionEvaluationIdealAt_eq_span D sX hX L s hsreg V t hfree
  refine ⟨g, ?_, AlgebraicGeometry.Scheme.germ_top_isSMulRegular_stalk hg v, ?_⟩
  · rw [hgspan]
    exact AlgebraicGeometry.Scheme.stalk_ofIdealTop_span_singleton g v
  · refine AlgebraicGeometry.Scheme.germ_mem_maximalIdeal_of_mem_support_ofIdealTop
      (Y := chartScheme V)
      (sectionEvaluationIdealAt D.site D.base D.base_mem ⟨X, hX.1⟩ L s V) ?_ v hvD
    rw [hgspan]
    exact Ideal.mem_span_singleton_self g

end AlgebraicGeometry.Space

end
