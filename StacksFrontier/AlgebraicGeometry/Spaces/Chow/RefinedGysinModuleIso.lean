public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.CycleMapsOfKernels
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.GysinPushforwardFirstChernCapCycle
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.RefinedGysinPushforwardCap
public import StacksFrontier.AlgebraicGeometry.Spaces.ZeroSchemePullback

/-!
# The refined Gysin map along an isomorphism of invertible sheaves

In Situation 0EDT let `X/B` be good and let `(ℒ, s, i : E → X)` be a triple as in Stacks 0ER1.
The refined Gysin homomorphism `i^*` of Stacks 0ER1 is built from `ℒ` and `s`: clause (1)(a) from
the vanishing locus `E = Z(s)` of Stacks 0845, clause (1)(b) from the Weil divisor
`c₁(ℒ|_W) ∩ [W]` of a regular meromorphic section of `ℒ|_W` chosen by Stacks 0EPQ. This file
shows that both are invariant under an isomorphism `e : ℒ ≅ ℳ` of invertible modules:

* `Z(e(s)) = Z(s)`, since on every affine chart the ideals generated by the evaluations of `s` and
  of `e(s)` agree;
* for `W ⊆ E`, the cycles `c₁(ℒ|_W) ∩ [W]` and `c₁(ℳ|_W) ∩ [W]` differ by a canonical principal
  divisor on `W` (Stacks 0EPT), so the refined Gysin cycles of `(ℒ, s)` and of `(ℳ, e(s))` differ
  by a cycle canonically rationally equivalent to zero on `E` (Stacks 0EQ8).

The main application is to a section pulled back in two steps: for `a : X'' ⟶ X'` and
`b : X' ⟶ X`, the comparison `a^*(b^*ℒ) ≅ (a ≫ b)^*ℒ` carries `a^*(b^*s)` to `(a ≫ b)^*s`, so the
two triples on `X''` have the same vanishing locus and, up to canonical rational equivalence, the
same refined Gysin homomorphism.

## Main results

* `zeroScheme_sectionsMap_of_iso`: `Z(e(s)) = Z(s)` for an isomorphism `e` of modules.
* `zeroScheme_modulePullbackSections_modulePullbackSections`: `Z(a^*(b^*s)) = Z((a ≫ b)^*s)`.
* `restrictedDivisorCycle_sub_mem_canonicalPrincipalDivisors`: the cycles `c₁(ℒ|_W) ∩ [W]` and
  `c₁(ℳ|_W) ∩ [W]` differ by a canonical principal divisor.
* `isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sub_of_iso`: the refined Gysin
  cycles on a closed subspace `E` for `ℒ` and for `ℳ` differ by a cycle canonically rationally
  equivalent to zero on `E`.
* `isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_sub_of_iso`:
  the same for the refined Gysin homomorphisms of `(ℒ, s)` and of `(ℳ, e(s))`, read on `X`; a
  companion statement reads it on the vanishing locus `Z(s)` itself.
* `isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_comp_sub`: the
  same for `((a ≫ b)^*ℒ, (a ≫ b)^*s)` and `(a^*(b^*ℒ), a^*(b^*s))`, read on `X''`; a companion
  statement reads it on `Z(a^*(b^*s))`.

All of these lie in the namespace `AlgebraicGeometry.Space`.

## Implementation notes

Rational equivalence is the relation of
`AlgebraicGeometry.Space.IsCanonicallyRationallyEquivalentToZeroWithin`: locally finite sums of
principal divisors computed through the canonical embeddings of Stacks 0ENK, with the witnessing
subspaces inside a prescribed set of points.

The two vanishing loci `Z(e(s))` and `Z(s)` are equal closed subspaces of `X`, but the cycle
groups of equal closed subspaces are different types; the comparison of the two refined Gysin
homomorphisms of sections is therefore stated after pushing forward to `X`, or on `Z(s)` after
pushing the cycle on `Z(e(s))` forward along the isomorphism `Z(e(s)) → Z(s)`. On a fixed closed
subspace `E` the comparison of the two component rules is stated on `E` itself.

## References

* [Stacks Project, Tag 0ER1](https://stacks.math.columbia.edu/tag/0ER1)
* [Stacks Project, Tag 0ER3](https://stacks.math.columbia.edu/tag/0ER3)
* [Stacks Project, Tag 0845](https://stacks.math.columbia.edu/tag/0845)
* [Stacks Project, Tag 0EPQ](https://stacks.math.columbia.edu/tag/0EPQ)
* [Stacks Project, Tag 0EPT](https://stacks.math.columbia.edu/tag/0EPT)
* [Stacks Project, Tag 0EQ6](https://stacks.math.columbia.edu/tag/0EQ6)
* [Stacks Project, Tag 0EQ8](https://stacks.math.columbia.edu/tag/0EQ8)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

universe v u

namespace AlgebraicGeometry.Space

/-! ### The zero scheme along an isomorphism of modules -/

section ZeroScheme

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The zero scheme is invariant under an isomorphism of modules.** For an isomorphism
`e : L ≅ M` of `𝒪_X`-modules and a global section `s` of `L`, the subfunctor cut out by `e(s)` is
the one cut out by `s`: on every affine chart the ideals generated by the evaluations of the two
sections agree, a linear form on `M(U)` being a linear form on `L(U)` composed with `e⁻¹`. -/
theorem zeroSchemeSubfunctor_sectionsMap_of_iso (X : AlgebraicSpaces B S hS)
    {L M : Modules.{u, u} B S hS X.1 X.2} (e : L ≅ M) (s : L.sections) :
    zeroSchemeSubfunctor B S hS X M (SheafOfModules.sectionsMap e.hom s) =
      zeroSchemeSubfunctor B S hS X L s := by
  unfold zeroSchemeSubfunctor
  congr 1
  ext Z
  refine exists_congr fun _ => forall_congr' fun U => imp_congr_right fun _ => ?_
  have hrange : Set.range (fun l : Module.Dual
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj
        (op U)) (M.val.obj (op U)) =>
      l ((SheafOfModules.sectionsMap e.hom s).eval (op U))) =
      Set.range (fun l : Module.Dual
        ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj
          (op U)) (L.val.obj (op U)) => l (s.eval (op U))) := by
    ext x
    constructor
    · rintro ⟨l, rfl⟩
      exact ⟨l ∘ₗ (e.hom.val.app (op U)).hom, rfl⟩
    · rintro ⟨l, rfl⟩
      refine ⟨l ∘ₗ (e.inv.val.app (op U)).hom, ?_⟩
      have h := congr_arg (fun φ : L ⟶ L => (φ.val.app (op U)).hom (s.eval (op U)))
        e.hom_inv_id
      simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
        LinearMap.comp_apply, SheafOfModules.id_val, PresheafOfModules.id_app, ModuleCat.hom_id,
        LinearMap.id_apply] at h
      exact congr_arg l h
  rw [hrange]

/-- **The zero scheme is invariant under an isomorphism of modules**, as closed subspaces:
`Z(e(s)) = Z(s)` for `e : L ≅ M`. -/
theorem zeroScheme_sectionsMap_of_iso (X : AlgebraicSpaces B S hS)
    {L M : Modules.{u, u} B S hS X.1 X.2} (e : L ≅ M) (s : L.sections) :
    zeroScheme B S hS X M (SheafOfModules.sectionsMap e.hom s) = zeroScheme B S hS X L s :=
  Subtype.ext (zeroSchemeSubfunctor_sectionsMap_of_iso B S hS X e s)

/-- **The zero scheme of a section pulled back in two steps.** For `a : X'' ⟶ X'`,
`b : X' ⟶ X`, a module `M` on `X` and a global section `σ`, the zero scheme of
`a^*(b^*σ)` on `X''` is the zero scheme of `(a ≫ b)^*σ`: the comparison `a^*(b^*M) ≅ (a ≫ b)^*M`
carries the first section to the second. -/
theorem zeroScheme_modulePullbackSections_modulePullbackSections
    {X'' X' X : AlgebraicSpaces B S hS} (a : X'' ⟶ X') (b : X' ⟶ X)
    (M : Modules.{u, u} B S hS X.1 X.2) (σ : M.sections) :
    zeroScheme B S hS X'' ((modulePullback B S hS a).obj ((modulePullback B S hS b).obj M))
        (modulePullbackSections B S hS a ((modulePullback B S hS b).obj M)
          (modulePullbackSections B S hS b M σ)) =
      zeroScheme B S hS X'' ((modulePullback B S hS (a ≫ b)).obj M)
        (modulePullbackSections B S hS (a ≫ b) M σ) := by
  rw [← sectionsMap_modulePullbackCompIso_modulePullbackSections B S hS a b M σ]
  exact (zeroScheme_sectionsMap_of_iso B S hS X'' ((modulePullbackCompIso B S hS a b).app M)
    _).symm

/-- The comparison `a^*(b^*M) ≅ (a ≫ b)^*M`, as the component of the isomorphism of functors at
`M`, carries `a^*(b^*σ)` to `(a ≫ b)^*σ`. -/
theorem sectionsMap_modulePullbackCompIso_app_hom {X'' X' X : AlgebraicSpaces B S hS}
    (a : X'' ⟶ X') (b : X' ⟶ X) (M : Modules.{u, u} B S hS X.1 X.2) (σ : M.sections) :
    SheafOfModules.sectionsMap ((modulePullbackCompIso B S hS a b).app M).hom
        (modulePullbackSections B S hS a ((modulePullback B S hS b).obj M)
          (modulePullbackSections B S hS b M σ)) =
      modulePullbackSections B S hS (a ≫ b) M σ :=
  sectionsMap_modulePullbackCompIso_modulePullbackSections B S hS a b M σ

end ZeroScheme

attribute [local instance] pointTopology

/-! ### The refined Gysin map along an isomorphism of invertible sheaves -/

section Gysin

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (p : X ⟶ D.space) (hp : D.IsGood p) (k : ℤ)

/-- **A canonical principal divisor on a subspace of `E`, read on `E`.** For an integral closed
subspace `W ⊆ X` contained in a closed subspace `E ⊆ X` and a canonical principal divisor `c` on
`W`, the pushforward of `c` along `W → E` is canonically rationally equivalent to zero on `E`,
within the inverse image of `|W|`. -/
theorem isCanonicallyRationallyEquivalentToZeroWithin_containedPushforward
    (E : ClosedSubspaces D.site D.base D.base_mem X) (hE : D.IsGood (E.1.ι ≫ p))
    {W : IntegralClosedSubspace D.site D.base D.base_mem X} (hWE : W.subspace ≤ E.1)
    {c : CycleGroup D (W.subspace.ι ≫ p) k} (hc : c ∈ canonicalPrincipalDivisors D p hp k W) :
    IsCanonicallyRationallyEquivalentToZeroWithin.{u, v} D (E.1.ι ≫ p) hE k
      (containedPushforward D p E hE k hWE c)
      (pointsMap D.site D.base D.base_mem E.1.toFunctor E.1.ι ⁻¹'
        subspacePointSet D.site D.base D.base_mem X W.subspace) := by
  have h := isCycleFamilySumWithin_integralClosedSubspacePushforward.{u, v} D p hp k W
    (P := canonicalPrincipalDivisors D p hp k) hc
  rw [← closedSubspaceCyclePushforward_containedPushforward D p hp E k hE hWE c] at h
  refine IsCanonicallyRationallyEquivalentToZeroWithin.of_closedPushforward (hX := hp)
    (E.1.ι ≫ p) hE E.2.2 rfl ?_ h
  rintro _ ⟨w, rfl⟩
  refine ⟨pointsMap D.site D.base D.base_mem _ (Subfunctor.homOfLe hWE) w, ?_⟩
  rw [← pointsMap_comp_apply, Subfunctor.homOfLe_ι]

/-- **The cap product `c₁(ℒ|_W) ∩ [W]` of clause (1)(b) of Stacks 0ER1 along an isomorphism.**
For an isomorphism `e : ℒ ≅ ℳ` of invertible `𝒪_X`-modules and an integral closed subspace
`W ⊆ X` of δ-dimension `k + 1`, the cycles `c₁(ℒ|_W) ∩ [W]` and `c₁(ℳ|_W) ∩ [W]` of
`AlgebraicGeometry.Space.restrictedDivisorCycle` differ by a canonical principal divisor on `W`.

Both are Weil divisors of regular meromorphic sections chosen independently by Stacks 0EPQ;
`e|_W` carries the section of `ℒ|_W` to a regular meromorphic section of `ℳ|_W` with the same
Weil divisor (`AlgebraicGeometry.Space.canonicalDivisorCycle_sectionsMap_of_iso`), and two
regular meromorphic sections of `ℳ|_W` have Weil divisors differing by a canonical principal
divisor, by Stacks 0EPT. -/
theorem restrictedDivisorCycle_sub_mem_canonicalPrincipalDivisors
    {L M : Modules.{u, u} D.site D.base D.base_mem X hp.1} (e : L ≅ M)
    (hL : IsInvertibleSheaf D p hp L) (hM : IsInvertibleSheaf D p hp M)
    {W : IntegralClosedSubspace D.site D.base D.base_mem X} (hW : deltaDimension D p W = k + 1) :
    restrictedDivisorCycle D p hp L k hL W hW - restrictedDivisorCycle D p hp M k hM W hW ∈
      canonicalPrincipalDivisors D p hp k W := by
  have hWg := isGood_integralClosedSubspace D p hp W
  have hN := hasEtaleLocalProperty_isLocallyNoetherian_of_isGood D (W.subspace.ι ≫ p) hWg
  have hk : deltaDimensionClosed D (W.subspace.ι ≫ p) hWg Set.univ isClosed_univ =
      ((k + 1 : ℤ) : EInt) := by
    rw [deltaDimensionClosed_univ_integralClosedSubspace D p hp W, hW]
  have hLW := isInvertibleModule_integralClosedSubspaceRestrict_of_isInvertibleSheaf D p hp L hL W
  have hMW := isInvertibleModule_integralClosedSubspaceRestrict_of_isInvertibleSheaf D p hp M hM W
  let eW : integralClosedSubspaceRestrict D p hp L W ≅ integralClosedSubspaceRestrict D p hp M W :=
    (modulePullback D.site D.base D.base_mem
      (closedSubspaceHom D.site D.base D.base_mem hp.1 W.subspace W.isClosedSubspace)).mapIso e
  have htL := isRegularMeromorphicSection_regularMeromorphicSection D.site D.base D.base_mem
    hWg.1 W.isIntegralSpace hN _ hLW
  have htM := isRegularMeromorphicSection_regularMeromorphicSection D.site D.base D.base_mem
    hWg.1 W.isIntegralSpace hN _ hMW
  have hσ := isRegularMeromorphicSection_sectionsMap_of_iso D.site D.base D.base_mem
    W.subspace.toFunctor hWg.1 eW (restrictedSectionOfIntegralClosedSubspace D p hp L hL W) htL
  have htrans : canonicalDivisorCycleAt D (W.subspace.ι ≫ p) hWg W.isIntegralSpace
      (integralClosedSubspaceRestrict D p hp M W) hMW
      (SheafOfModules.sectionsMap (meromorphicSectionSheafMapIso D.site D.base D.base_mem
        W.subspace.toFunctor hWg.1 eW).hom
        (restrictedSectionOfIntegralClosedSubspace D p hp L hL W))
      hσ hk = restrictedDivisorCycle D p hp L k hL W hW := by
    rw [restrictedDivisorCycle_eq_canonicalDivisorCycleAt]
    refine Subtype.ext ?_
    rw [canonicalDivisorCycleAt_coe, canonicalDivisorCycleAt_coe]
    exact congrArg Subtype.val (canonicalDivisorCycle_sectionsMap_of_iso D (W.subspace.ι ≫ p) hWg
      W.isIntegralSpace _ _ hLW hMW eW _ htL hk)
  obtain ⟨g, hg⟩ := exists_zsmul_sub_canonicalDivisorCycleAt_eq D (W.subspace.ι ≫ p) hWg
    W.isIntegralSpace (integralClosedSubspaceRestrict D p hp M W) hMW _
    (restrictedSectionOfIntegralClosedSubspace D p hp M hM W) hσ htM hk 1
  rw [one_smul, htrans, ← restrictedDivisorCycle_eq_canonicalDivisorCycleAt (hW := hW)] at hg
  exact ⟨hk, g, hg⟩

/-- **The refined Gysin map along an isomorphism of invertible sheaves.** Let `E ⊆ X` be a closed
subspace and `e : ℒ ≅ ℳ` an isomorphism of invertible `𝒪_X`-modules. The component rules of
Stacks 0ER1 on `E` with clause (1)(b) taken for `ℒ` and for `ℳ`
(`AlgebraicGeometry.Space.canonicalGysinComponentRule` of
`AlgebraicGeometry.Space.restrictedDivisorCycle`) give, on every `(k+1)`-cycle `α`, Gysin cycles
whose difference is canonically rationally equivalent to zero on `E`.

Clause (1)(a) is the same cycle `[E ∩ W]_k` for both. For `W ⊆ E` the two components differ by
the pushforward of a canonical principal divisor on `W`
(`AlgebraicGeometry.Space.restrictedDivisorCycle_sub_mem_canonicalPrincipalDivisors`), and these
differences lie over the `W`, so they sum by Stacks 0EQ8. -/
theorem isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sub_of_iso
    (E : ClosedSubspaces D.site D.base D.base_mem X) (hE : D.IsGood (E.1.ι ≫ p))
    {L M : Modules.{u, u} D.site D.base D.base_mem X hp.1} (e : L ≅ M)
    (hL : IsInvertibleSheaf D p hp L) (hM : IsInvertibleSheaf D p hp M)
    (α : CycleGroup D p (k + 1)) :
    IsCanonicallyRationallyEquivalentToZeroWithin.{u, max (u + 1) v} D (E.1.ι ≫ p) hE k
      (gysinCycleMap D p E hE k
          (canonicalGysinComponentRule D p hp E hE k (restrictedDivisorCycle D p hp L k hL)) α -
        gysinCycleMap D p E hE k
          (canonicalGysinComponentRule D p hp E hE k (restrictedDivisorCycle D p hp M k hM)) α)
      Set.univ := by
  refine (isCycleFamilySumWithin_sub_of_isCycleMapOfKernel.{u, v} (E.1.ι ≫ p) hE
    (P := canonicalPrincipalDivisors D (E.1.ι ≫ p) hE k)
    (fun hc => neg_mem_canonicalPrincipalDivisors hc)
    (continuous_pointsMap D.site D.base D.base_mem E.1.ι)
    (isCycleMapOfKernel_gysinCycleMap D p E hE k _)
    (isCycleMapOfKernel_gysinCycleMap D p E hE k _) (fun W => ?_) α).mono (Set.subset_univ _)
  by_cases hW : deltaDimension D p W = k + 1
  · by_cases hWE : W.subspace ≤ E.1
    · simp only [gysinComponentCycle_of_le D p E hE k _ hW hWE, ← map_sub]
      exact isCanonicallyRationallyEquivalentToZeroWithin_containedPushforward D p hp k E hE hWE
        (restrictedDivisorCycle_sub_mem_canonicalPrincipalDivisors D p hp k e hL hM hW)
    · simp only [gysinComponentCycle_of_not_le D p E hE k _ hW hWE,
        canonicalGysinComponentRule_intersectionCycle, sub_self,
        isCycleFamilySumWithin_zero D (E.1.ι ≫ p) hE k]
  · simp only [gysinComponentCycle_of_deltaDimension_ne D p E hE k _ hW, sub_self,
      isCycleFamilySumWithin_zero D (E.1.ι ≫ p) hE k]

/-- **The vanishing locus is invariant under an isomorphism of modules**: `Z(e(s)) = Z(s)` for
`e : ℒ ≅ ℳ`. -/
theorem vanishingLocus_sectionsMap_of_iso {L M : Modules.{u, u} D.site D.base D.base_mem X hp.1}
    (e : L ≅ M) (s : L.sections) :
    vanishingLocus D p hp M (SheafOfModules.sectionsMap e.hom s) = vanishingLocus D p hp L s :=
  zeroScheme_sectionsMap_of_iso D.site D.base D.base_mem ⟨X, hp.1⟩ e s

/-- The refined Gysin map of a component rule of Stacks 0ER1 at the canonical choices depends on
the closed subspace `E` only through `E` itself: two equal closed subspaces give, pushed forward to
`X`, the same cycle. -/
theorem closedSubspaceCyclePushforward_gysinCycleMap_canonicalGysinComponentRule_congr
    {E₁ E₂ : ClosedSubspaces D.site D.base D.base_mem X} (h : E₁ = E₂)
    (hE₁ : D.IsGood (E₁.1.ι ≫ p)) (hE₂ : D.IsGood (E₂.1.ι ≫ p))
    (chern : FirstChernComponentCycleRule D p k) (α : CycleGroup D p (k + 1)) :
    closedSubspaceCyclePushforward D p hp E₁ k
        (gysinCycleMap D p E₁ hE₁ k (canonicalGysinComponentRule D p hp E₁ hE₁ k chern) α) =
      closedSubspaceCyclePushforward D p hp E₂ k
        (gysinCycleMap D p E₂ hE₂ k (canonicalGysinComponentRule D p hp E₂ hE₂ k chern) α) := by
  subst h
  rfl

/-- **The refined Gysin homomorphism of Stacks 0ER1 along an isomorphism of invertible sheaves.**
Let `e : ℒ ≅ ℳ` be an isomorphism of invertible `𝒪_X`-modules and `s` a global section of `ℒ`.
Then `Z(e(s)) = Z(s)` (`AlgebraicGeometry.Space.vanishingLocus_sectionsMap_of_iso`), and for
every `(k+1)`-cycle `α` the refined Gysin cycles of `(ℳ, e(s))` and of `(ℒ, s)`, pushed forward to
`X`, differ by a cycle canonically rationally equivalent to zero within `|Z(s)|`. -/
theorem isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_sub_of_iso
    {L M : Modules.{u, u} D.site D.base D.base_mem X hp.1} (e : L ≅ M) (s : L.sections)
    (hL : IsInvertibleSheaf D p hp L) (hM : IsInvertibleSheaf D p hp M)
    (α : CycleGroup D p (k + 1)) :
    IsCanonicallyRationallyEquivalentToZeroWithin.{u, max (u + 1) v} D p hp k
      (closedSubspaceCyclePushforward D p hp
          (vanishingLocus D p hp M (SheafOfModules.sectionsMap e.hom s)) k
          (gysinCycleMap D p (vanishingLocus D p hp M (SheafOfModules.sectionsMap e.hom s))
            (isGood_vanishingLocus D p hp M _) k
            (sectionGysinRule D p hp M (SheafOfModules.sectionsMap e.hom s) k hM) α) -
        closedSubspaceCyclePushforward D p hp (vanishingLocus D p hp L s) k
          (gysinCycleMap D p (vanishingLocus D p hp L s) (isGood_vanishingLocus D p hp L s) k
            (sectionGysinRule D p hp L s k hL) α))
      (subspacePointSet D.site D.base D.base_mem X (vanishingLocus D p hp L s).1) := by
  have hE := isGood_vanishingLocus D p hp L s
  rw [sectionGysinRule, sectionGysinRule,
    closedSubspaceCyclePushforward_gysinCycleMap_canonicalGysinComponentRule_congr D p hp k
      (vanishingLocus_sectionsMap_of_iso D p hp e s) _ hE, ← map_sub]
  have h := (isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sub_of_iso.{v} D p hp k
    (vanishingLocus D p hp L s) hE e.symm hM hL α).closedPushforward (hX := hp)
    ((vanishingLocus D p hp L s).1.ι ≫ p) hE (vanishingLocus D p hp L s).2.2 rfl
  rwa [Set.image_univ] at h

/-- **The vanishing locus along an isomorphism of modules**, for any section `t` of `ℳ` which is
the image `e(s)` of a section of `ℒ`: `Z(t) = Z(s)`. -/
theorem vanishingLocus_eq_of_sectionsMap_eq {L M : Modules.{u, u} D.site D.base D.base_mem X hp.1}
    (e : L ≅ M) {s : L.sections} {t : M.sections} (ht : SheafOfModules.sectionsMap e.hom s = t) :
    vanishingLocus D p hp M t = vanishingLocus D p hp L s := by
  subst ht
  exact vanishingLocus_sectionsMap_of_iso D p hp e s

/-- **The refined Gysin homomorphism of Stacks 0ER1 along an isomorphism of invertible sheaves,
on the vanishing locus.** Let `e : ℒ ≅ ℳ` carry the global section `s` of `ℒ` to the global
section `t` of `ℳ`, and read the refined Gysin cycle of `(ℳ, t)` on `Z(s)` through the
identification `Z(t) = Z(s)` (`AlgebraicGeometry.Space.vanishingLocus_eq_of_sectionsMap_eq`). For
every `(k+1)`-cycle `α` it differs from the refined Gysin cycle of `(ℒ, s)` by a cycle
canonically rationally equivalent to zero on `Z(s)`. -/
theorem isCanonicallyRationallyEquivalentToZeroWithin_closedPushforward_sectionGysinRule_sub_of_iso
    {L M : Modules.{u, u} D.site D.base D.base_mem X hp.1} (e : L ≅ M) {s : L.sections}
    {t : M.sections} (ht : SheafOfModules.sectionsMap e.hom s = t)
    (hL : IsInvertibleSheaf D p hp L) (hM : IsInvertibleSheaf D p hp M)
    (α : CycleGroup D p (k + 1)) :
    IsCanonicallyRationallyEquivalentToZeroWithin.{u, max (u + 1) v} D
      ((vanishingLocus D p hp L s).1.ι ≫ p) (isGood_vanishingLocus D p hp L s) k
      (cycleGroupClosedPushforward D (vanishingLocus D p hp L s).2.1
          (vanishingLocus D p hp M t).2.1
          (D.isDecentSpace_of_isGood _ (isGood_vanishingLocus D p hp L s))
          (isClosedImmersion_homOfLe' D.site D.base D.base_mem (vanishingLocus D p hp M t).2.2
            (congrArg Subtype.val (vanishingLocus_eq_of_sectionsMap_eq D p hp e ht)).le)
          ((vanishingLocus D p hp L s).1.ι ≫ p) (isGood_vanishingLocus D p hp L s).2.2
          ((vanishingLocus D p hp M t).1.ι ≫ p)
          (by rw [← Category.assoc, Subfunctor.homOfLe_ι]) k
          (gysinCycleMap D p (vanishingLocus D p hp M t) (isGood_vanishingLocus D p hp M t) k
            (sectionGysinRule D p hp M t k hM) α) -
        gysinCycleMap D p (vanishingLocus D p hp L s) (isGood_vanishingLocus D p hp L s) k
          (sectionGysinRule D p hp L s k hL) α)
      Set.univ := by
  subst ht
  set EL := vanishingLocus D p hp L s
  set EM := vanishingLocus D p hp M (SheafOfModules.sectionsMap e.hom s)
  have hEL' := isGood_vanishingLocus D p hp L s
  have hle : EM.1 ≤ EL.1 :=
    (congrArg Subtype.val (vanishingLocus_eq_of_sectionsMap_eq D p hp e rfl)).le
  have h :=
    isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_sub_of_iso.{v}
      D p hp k e s hL hM α
  rw [← cycleGroupClosedPushforward_cycleGroupClosedPushforward D hp.1 EL.2.1 EM.2.1
    (D.isDecentSpace_of_isGood p hp) (D.isDecentSpace_of_isGood _ hEL')
    (Subfunctor.homOfLe_ι hle) (isClosedImmersion_homOfLe' D.site D.base D.base_mem EM.2.2 hle)
    EL.2.2 EM.2.2 p hp.2.2 (EL.1.ι ≫ p) hEL'.2.2 (EM.1.ι ≫ p) rfl
    (by rw [← Category.assoc, Subfunctor.homOfLe_ι]) rfl k, ← map_sub] at h
  have h' := IsCanonicallyRationallyEquivalentToZeroWithin.of_closedPushforward (hX := hp)
    (EL.1.ι ≫ p) hEL' EL.2.2 rfl subset_rfl h
  rwa [Set.preimage_range] at h'

end Gysin

/-! ### Pulling back in two steps -/

section Composite

variable (D : BaseSpaceDimensionSituation.{u})
    {X X' X'' : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (p : X ⟶ D.space) (hp : D.IsGood p) (p' : X' ⟶ D.space) (hp' : D.IsGood p')
    (p'' : X'' ⟶ D.space) (hp'' : D.IsGood p'')
    (a : (⟨X'', hp''.1⟩ : AlgebraicSpaces D.site D.base D.base_mem) ⟶ ⟨X', hp'.1⟩)
    (b : (⟨X', hp'.1⟩ : AlgebraicSpaces D.site D.base D.base_mem) ⟶ ⟨X, hp.1⟩)
    (L : Modules.{u, u} D.site D.base D.base_mem X hp.1) (s : L.sections) (k : ℤ)

/-- **The vanishing locus of a section pulled back in two steps.** For `a : X'' ⟶ X'`,
`b : X' ⟶ X` and a global section `s` of `ℒ` on `X`, the vanishing locus of `a^*(b^*s)` is that
of `(a ≫ b)^*s`, the comparison `a^*(b^*ℒ) ≅ (a ≫ b)^*ℒ` carrying the one section to the other. -/
theorem vanishingLocus_pullbackGlobalSection_pullbackGlobalSection :
    vanishingLocus D p'' hp'' (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
        (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
          (pullbackGlobalSection D p hp p' hp' b L s)) =
      vanishingLocus D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
        (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s) :=
  zeroScheme_modulePullbackSections_modulePullbackSections D.site D.base D.base_mem a b L s

/-- **The refined Gysin homomorphism of a section pulled back in two steps.** For
`a : X'' ⟶ X'`, `b : X' ⟶ X`, an invertible `ℒ` on `X` and a global section `s`, the triples
`((a ≫ b)^*ℒ, (a ≫ b)^*s)` and `(a^*(b^*ℒ), a^*(b^*s))` on `X''` have the same vanishing locus
(`AlgebraicGeometry.Space.vanishingLocus_pullbackGlobalSection_pullbackGlobalSection`), and for
every `(k+1)`-cycle `α` on `X''` their refined Gysin cycles of Stacks 0ER1, pushed forward to
`X''`, differ by a cycle canonically rationally equivalent to zero within that vanishing locus.

The comparison `a^*(b^*ℒ) ≅ (a ≫ b)^*ℒ` is an isomorphism of invertible modules carrying
`a^*(b^*s)` to `(a ≫ b)^*s`
(`AlgebraicGeometry.Space.sectionsMap_modulePullbackCompIso_modulePullbackSections`), so this is
`isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_sub_of_iso`. -/
theorem isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_comp_sub
    (hL : IsInvertibleSheaf D p hp L) (α : CycleGroup D p'' (k + 1)) :
    IsCanonicallyRationallyEquivalentToZeroWithin.{u, max (u + 1) v} D p'' hp'' k
      (closedSubspaceCyclePushforward D p'' hp''
          (vanishingLocus D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
            (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s)) k
          (gysinCycleMap D p''
            (vanishingLocus D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
              (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s))
            (isGood_vanishingLocus D p'' hp'' _ _) k
            (sectionGysinRule D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
              (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s) k
              (isInvertibleSheaf_pullbackSheaf D p hp p'' hp'' (a ≫ b) L hL)) α) -
        closedSubspaceCyclePushforward D p'' hp''
          (vanishingLocus D p'' hp''
            (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
            (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
              (pullbackGlobalSection D p hp p' hp' b L s))) k
          (gysinCycleMap D p''
            (vanishingLocus D p'' hp''
              (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
              (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
                (pullbackGlobalSection D p hp p' hp' b L s)))
            (isGood_vanishingLocus D p'' hp'' _ _) k
            (sectionGysinRule D p'' hp''
              (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
              (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
                (pullbackGlobalSection D p hp p' hp' b L s)) k
              (isInvertibleSheaf_pullbackSheaf D p' hp' p'' hp'' a _
                (isInvertibleSheaf_pullbackSheaf D p hp p' hp' b L hL))) α))
      (subspacePointSet D.site D.base D.base_mem X''
        (vanishingLocus D p'' hp''
          (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
          (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
            (pullbackGlobalSection D p hp p' hp' b L s))).1) := by
  have h :=
    isCanonicallyRationallyEquivalentToZeroWithin_gysinCycleMap_sectionGysinRule_sub_of_iso.{v}
      D p'' hp'' k ((modulePullbackCompIso D.site D.base D.base_mem a b).app L)
      (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
        (pullbackGlobalSection D p hp p' hp' b L s))
      (isInvertibleSheaf_pullbackSheaf D p' hp' p'' hp'' a _
        (isInvertibleSheaf_pullbackSheaf D p hp p' hp' b L hL))
      (isInvertibleSheaf_pullbackSheaf D p hp p'' hp'' (a ≫ b) L hL) α
  rwa [Iso.app_hom, sectionsMap_modulePullbackCompIso_modulePullbackSections] at h

/-- **The refined Gysin homomorphism of a section pulled back in two steps, on the vanishing
locus.** For `a : X'' ⟶ X'`, `b : X' ⟶ X`, an invertible `ℒ` on `X` and a global section `s`,
read the refined Gysin cycle of `((a ≫ b)^*ℒ, (a ≫ b)^*s)` on `Z(a^*(b^*s))` through
`Z((a ≫ b)^*s) = Z(a^*(b^*s))`. For every `(k+1)`-cycle `α` on `X''` it differs from the refined
Gysin cycle of `(a^*(b^*ℒ), a^*(b^*s))` by a cycle canonically rationally equivalent to zero on
`Z(a^*(b^*s))`. -/
theorem isCanonicallyRationallyEquivalentToZeroWithin_closedPushforward_sectionGysinRule_comp_sub
    (hL : IsInvertibleSheaf D p hp L) (α : CycleGroup D p'' (k + 1)) :
    IsCanonicallyRationallyEquivalentToZeroWithin.{u, max (u + 1) v} D
      ((vanishingLocus D p'' hp''
          (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
          (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
            (pullbackGlobalSection D p hp p' hp' b L s))).1.ι ≫ p'')
      (isGood_vanishingLocus D p'' hp'' _ _) k
      (cycleGroupClosedPushforward D
          (vanishingLocus D p'' hp''
            (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
            (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
              (pullbackGlobalSection D p hp p' hp' b L s))).2.1
          (vanishingLocus D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
            (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s)).2.1
          (D.isDecentSpace_of_isGood _ (isGood_vanishingLocus D p'' hp'' _ _))
          (isClosedImmersion_homOfLe' D.site D.base D.base_mem
            (vanishingLocus D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
              (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s)).2.2
            (congrArg Subtype.val (vanishingLocus_pullbackGlobalSection_pullbackGlobalSection D p hp
              p' hp' p'' hp'' a b L s)).ge)
          _ (isGood_vanishingLocus D p'' hp'' _ _).2.2 _
          (by rw [← Category.assoc, Subfunctor.homOfLe_ι]) k
          (gysinCycleMap D p''
            (vanishingLocus D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
              (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s))
            (isGood_vanishingLocus D p'' hp'' _ _) k
            (sectionGysinRule D p'' hp'' (pullbackSheaf D p hp p'' hp'' (a ≫ b) L)
              (pullbackGlobalSection D p hp p'' hp'' (a ≫ b) L s) k
              (isInvertibleSheaf_pullbackSheaf D p hp p'' hp'' (a ≫ b) L hL)) α) -
        gysinCycleMap D p''
          (vanishingLocus D p'' hp''
            (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
            (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
              (pullbackGlobalSection D p hp p' hp' b L s)))
          (isGood_vanishingLocus D p'' hp'' _ _) k
          (sectionGysinRule D p'' hp''
            (pullbackSheaf D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L))
            (pullbackGlobalSection D p' hp' p'' hp'' a (pullbackSheaf D p hp p' hp' b L)
              (pullbackGlobalSection D p hp p' hp' b L s)) k
            (isInvertibleSheaf_pullbackSheaf D p' hp' p'' hp'' a _
              (isInvertibleSheaf_pullbackSheaf D p hp p' hp' b L hL))) α)
      Set.univ :=
  isCanonicallyRationallyEquivalentToZeroWithin_closedPushforward_sectionGysinRule_sub_of_iso.{v}
    D p'' hp'' k ((modulePullbackCompIso D.site D.base D.base_mem a b).app L)
    (sectionsMap_modulePullbackCompIso_app_hom D.site D.base D.base_mem a b L s)
    (isInvertibleSheaf_pullbackSheaf D p' hp' p'' hp'' a _
      (isInvertibleSheaf_pullbackSheaf D p hp p' hp' b L hL))
    (isInvertibleSheaf_pullbackSheaf D p hp p'' hp'' (a ≫ b) L hL) α

end Composite

end AlgebraicGeometry.Space

