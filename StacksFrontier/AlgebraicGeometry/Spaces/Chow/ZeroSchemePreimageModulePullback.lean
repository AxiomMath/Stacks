-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-! ### Charts trivialising a module -/

/-- **An étale chart of `Y` trivialising an `𝒪_Y`-module `G`:** one carrying a family of free
generators of the sections of `G` over the charts above it, compatible with restriction.  This
is the form in which `AlgebraicGeometry.Space.exists_generator_cover_smul_of_isInvertible`
produces the local triviality of an invertible module, and the form in which
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_modulePullback_eq_map` consumes it. -/
def IsTrivialisingChart (G : Modules.{u, u} B S hS Y.1 Y.2) (V : SmallEtale B S hS Y.1) : Prop :=
  ∃ e : (W : SmallEtale B S hS Y.1) → (W ⟶ V) → G.val.obj (op W),
    (∀ (W W' : SmallEtale B S hS Y.1) (k : W ⟶ V) (g : W' ⟶ W),
        (G.val.map g.op).hom (e W k) = e W' (g ≫ k)) ∧
      ∀ (W : SmallEtale B S hS Y.1) (k : W ⟶ V),
        Function.Bijective fun r : chartRing B S hS Y.1 Y.2 W ↦ r • e W k

/-- **Trivialising a module passes to charts over one:** compose the family of free generators
with the morphism of charts. -/
theorem isTrivialisingChart_of_hom (G : Modules.{u, u} B S hS Y.1 Y.2)
    {V V' : SmallEtale B S hS Y.1} (φ : V' ⟶ V) (h : IsTrivialisingChart B S hS G V) :
    IsTrivialisingChart B S hS G V' := by
  obtain ⟨e, hcompat, hfree⟩ := h
  exact ⟨fun W k ↦ e W (k ≫ φ), fun W W' k g ↦
    (hcompat W W' (k ≫ φ) g).trans (congrArg (e W') (Category.assoc g k φ).symm),
    fun W k ↦ hfree W (k ≫ φ)⟩

/-- **An invertible module is trivialised by a chart around every point of `|Y|`.**  This is
`AlgebraicGeometry.Space.exists_affine_chart_free_of_chart`, which is Stacks 0B8Q on the small
étale site, read at a chart carrying a point above the prescribed one. -/
theorem exists_isTrivialisingChart_mem_range (G : Modules.{u, u} B S hS Y.1 Y.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS Y)
      (structureRingSheaf B S hS Y).property G)
    (x : points B S hS Y.1) :
    ∃ V : SmallEtale B S hS Y.1, IsTrivialisingChart B S hS G V ∧
      x ∈ Set.range (pointsMap B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS Y.1).obj V)) V.1.hom) := by
  obtain ⟨C, u, hCu⟩ := exists_chartSchemeToPoints_eq B S hS Y x
  obtain ⟨W, κ, -, w, e, hcompat, hfree, hw⟩ :=
    exists_affine_chart_free_of_chart B S hS Y G
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ hinv) C u
  refine ⟨W, ⟨e, hcompat, hfree⟩, ?_⟩
  have hx : chartSchemeToPoints B S hS Y.1 W w = x := by
    rw [← hCu, ← hw, chartSchemeToPoints_map]
  exact hx ▸ chartSchemeToPoints_mem_range B S hS W w

/-! ### The defining ideal of the inverse image over a chart diagram -/

/-- **Over a diagram of affine étale charts whose chart of `Y` trivialises `G`, the defining
ideal of `f^{-1}(Z(s))` is the evaluation ideal of `f^*s`.**

The defining ideal of the inverse image is generated by the pullback of the defining ideal of
`Z(s)`, which over an affine chart is the evaluation ideal of `s` by the surjectivity half of
Stacks 03MB; and the evaluation ideal of `f^*s` is generated by the pullback of that same ideal
when the chart of `Y` trivialises `G`. -/
theorem definingIdealAt_preimage_zeroScheme_eq (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (s : G.sections)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS Y)
      (structureRingSheaf B S hS Y).property G)
    (W : SmallEtale B S hS X.1) (V : SmallEtale B S hS Y.1)
    (q : (SmallEtale.toOver B S hS X.1).obj W ⟶ (SmallEtale.toOver B S hS Y.1).obj V)
    (hq : W.1.hom ≫ f.hom = yoneda.map q ≫ V.1.hom)
    (hW : IsAffine (chartScheme W)) (hV : IsAffine (chartScheme V))
    (hVtriv : IsTrivialisingChart B S hS G V) :
    definingIdealAt B S hS X (preimageSubspace B S hS f (zeroScheme B S hS Y G s)) (op W) =
      sectionEvaluationIdealAt B S hS X ((modulePullback B S hS f).obj G)
        (modulePullbackSections B S hS f G s) W := by
  obtain ⟨e, hcompat, hfree⟩ := hVtriv
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS Y G s hinv
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) := hW
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) := hV
  let d : ChartDiagram B S hS X.1 Y.1 f.hom := ⟨W, V, q, hq⟩
  refine Eq.trans
    (definingIdealAt_preimage_eq_map_chartDiagram B S hS f (zeroScheme B S hS Y G s) d) ?_
  refine Eq.trans (congrArg (Ideal.map (chartDiagramRestrict B S hS f d))
    (definingIdealAt_zeroScheme_eq B S hS Y G s Z hZ V hV)) ?_
  exact (sectionEvaluationIdealAt_modulePullback_eq_map B S hS f G d e s hinv hW
    hcompat hfree).symm

/-! ### The inverse image of the zero scheme -/

/-- **The defining ideal of `f^{-1}(Z(s))` is the evaluation ideal of `f^*s` over every affine
étale chart of `X`.**

The charts carrying an affine chart diagram over `f` whose chart of `Y` trivialises `G` are
cover-dense, the equality holds over each of them, and membership in each of the two ideals is
local on the small étale site of `X`. -/
theorem definingIdealAt_preimage_zeroScheme_eq_of_isAffine (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (s : G.sections)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS Y)
      (structureRingSheaf B S hS Y).property G)
    (U : SmallEtale B S hS X.1) (hU : IsAffine (chartScheme U)) :
    definingIdealAt B S hS X (preimageSubspace B S hS f (zeroScheme B S hS Y G s)) (op U) =
      sectionEvaluationIdealAt B S hS X ((modulePullback B S hS f).obj G)
        (modulePullbackSections B S hS f G s) U := by
  have hinv' := isInvertible_modulePullback_obj B S hS f G hinv
  have hqc' := isQuasicoherentOnSite_of_isInvertible B S hS X _ hinv'
  have hcart' := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hqc'
  have hfp' := module_finitePresentation_sections_of_isFinitePresentationOnSite
    ((modulePullback B S hS f).obj G) hqc'
    (SheafOfModules.isFinitePresentationOnSite_of_isFiniteLocallyFreeOnSite
      (isFiniteLocallyFreeOfRank_one_of_isInvertible B S hS X _ hinv').isFiniteLocallyFreeOnSite)
  have hUaff : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) := hU
  -- the cover-density input: the condition on the charts of `Y`
  have hcov := mem_topology_of_hasAffineChartDiagramWith B S hS (IsTrivialisingChart B S hS G) f
    (fun φ h ↦ isTrivialisingChart_of_hom B S hS G φ h)
    (exists_isTrivialisingChart_mem_range B S hS G hinv) U
  -- the equality over a chart carrying such a diagram
  have hgood : ∀ Wg : SmallEtale B S hS X.1,
      HasAffineChartDiagramWith B S hS f (IsTrivialisingChart B S hS G) Wg →
      definingIdealAt B S hS X (preimageSubspace B S hS f (zeroScheme B S hS Y G s)) (op Wg) =
        sectionEvaluationIdealAt B S hS X ((modulePullback B S hS f).obj G)
          (modulePullbackSections B S hS f G s) Wg := by
    rintro Wg ⟨hWgaff, V, q, hcomm, hVaff, hVtriv⟩
    exact definingIdealAt_preimage_zeroScheme_eq B S hS f G s hinv Wg V q hcomm.symm
      hWgaff hVaff hVtriv
  refine le_antisymm ?_ ?_
  · -- the defining ideal is contained in the evaluation ideal
    intro a ha
    refine mem_sectionEvaluationIdealAt_of_sieve B S hS X _ _ hcart' hfp' hUaff
      (T := Sieve.generate fun {Wg : SmallEtale B S hS X.1} (_ : Wg ⟶ U) ↦
        HasAffineChartDiagramWith B S hS f (IsTrivialisingChart B S hS G) Wg)
      (hcov _ fun {Wg} m hWg ↦ ⟨Wg, 𝟙 Wg, m, hWg, Category.id_comp m⟩) a ?_
    rintro Wa m ⟨Wg, h, m₀, hWg, rfl⟩ hWaaff
    -- `Wa` lies over a good chart and is affine, hence is itself a good chart
    have hWa : HasAffineChartDiagramWith B S hS f (IsTrivialisingChart B S hS G) Wa := by
      obtain ⟨-, V, q, hcomm, hVaff, hVtriv⟩ := hWg
      refine ⟨hWaaff, V, (SmallEtale.toOver B S hS X.1).map h ≫ q, ?_, hVaff, hVtriv⟩
      have htri : yoneda.map ((SmallEtale.toOver B S hS X.1).map h) ≫ Wg.1.hom = Wa.1.hom :=
        ((SmallEtale.inclusion B S hS X.1).map h).w
      rw [Functor.map_comp, Category.assoc, hcomm, ← Category.assoc, htri]
    have hmem := definingIdealAt_map B S hS X _ (h ≫ m₀).op a ha
    rw [hgood Wa hWa] at hmem
    exact hmem
  · -- the evaluation ideal is contained in the defining ideal
    intro a ha
    refine mem_definingIdealAt_of_sieve B S hS X _ (op U) a
      { arrows := fun Wa m ↦ chartRestrict (hF := X.2) m a ∈
          definingIdealAt B S hS X (preimageSubspace B S hS f (zeroScheme B S hS Y G s)) (op Wa)
        downward_closed := by
          intro Wa Wa' m hm h
          rw [chartRestrict_comp]
          exact definingIdealAt_map B S hS X _ h.op _ hm }
      (hcov _ ?_) fun Wa m hm ↦ hm
    intro Wa m hWa
    have hWaaff : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Wa) :=
      hWa.1
    change chartRestrict (hF := X.2) m a ∈ _
    rw [hgood Wa hWa]
    exact sectionEvaluationIdealAt_map_le_of_bijective_sectionsBaseChange B S hS X _ _ m
      (hcart' U Wa hUaff hWaaff m) (Ideal.mem_map_of_mem _ ha)

/-- **The zero scheme of the inverse image of a section is the inverse image of its zero
scheme.**  For a morphism `f : X ⟶ Y` of algebraic spaces, an invertible `𝒪_Y`-module `G` and a
global section `s` of `G`, the zero scheme of Stacks 0845 of `f^*s` is the inverse image along
`f` of the zero scheme of `s`, which by `CategoryTheory.Subfunctor.isPullback_preimage` is the
fibre product `X ×_Y Z(s)`.

The left-hand side is an intersection of closed subspaces, and its two unconditional bounds are
both applied to the closed subspace `f^{-1}(Z(s))`: each asks for one containment between the
defining ideal of that subspace and the evaluation ideal of `f^*s`, and the two ideals are equal
on every affine étale chart of `X` by
`AlgebraicGeometry.Space.definingIdealAt_preimage_zeroScheme_eq_of_isAffine`. -/
theorem zeroSchemeSubfunctor_modulePullback_eq_preimage (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (s : G.sections)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS Y)
      (structureRingSheaf B S hS Y).property G) :
    zeroSchemeSubfunctor B S hS X ((modulePullback B S hS f).obj G)
        (modulePullbackSections B S hS f G s) =
      (zeroSchemeSubfunctor B S hS Y G s).preimage f.hom := by
  exact le_antisymm
    (zeroSchemeSubfunctor_le B S hS X _ _ (preimageSubspace B S hS f (zeroScheme B S hS Y G s))
      fun U hU ↦ (definingIdealAt_preimage_zeroScheme_eq_of_isAffine B S hS f G s hinv U hU).le)
    (le_zeroSchemeSubfunctor B S hS X _ _ (preimageSubspace B S hS f (zeroScheme B S hS Y G s))
      fun U hU ↦ (definingIdealAt_preimage_zeroScheme_eq_of_isAffine B S hS f G s hinv U hU).ge)

/-- **The zero scheme of the inverse image of a section is the inverse image of its zero
scheme**, as bundled closed subspaces. -/
theorem zeroScheme_modulePullback_eq_preimage (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (s : G.sections)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS Y)
      (structureRingSheaf B S hS Y).property G) :
    zeroScheme B S hS X ((modulePullback B S hS f).obj G)
        (modulePullbackSections B S hS f G s) =
      preimageSubspace B S hS f (zeroScheme B S hS Y G s) :=
  Subtype.ext (zeroSchemeSubfunctor_modulePullback_eq_preimage B S hS f G s hinv)

end AlgebraicGeometry.Space

end
