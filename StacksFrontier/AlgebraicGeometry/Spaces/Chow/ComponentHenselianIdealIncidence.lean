-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hXd : IsDecentSpace B S hS X) (x : points B S hS X)
    (V : ElementaryEtaleNeighborhood B S hS X hX x)

/-! ### The henselian local ring as a flat algebra over the chart stalk, at the chart spelling -/

/-- The local ring of an elementary étale neighborhood at its distinguished point is a local
ring, read as the stalk of `AlgebraicGeometry.Space.chartScheme` of the underlying étale
chart. -/
abbrev isLocalRing_elementaryEtaleChartStalk :
    IsLocalRing ↥((chartScheme V.chart).presheaf.stalk V.point) :=
  inferInstanceAs (IsLocalRing ↥(V.scheme.left.1.presheaf.stalk V.point))

/-- `𝒪^h_{X, x}` is an algebra over the local ring of an elementary étale neighborhood at its
distinguished point, read as the stalk of `AlgebraicGeometry.Space.chartScheme` of the
underlying étale chart. This is `AlgebraicGeometry.Space.stalkAlgebra`. -/
abbrev elementaryEtaleChartStalkAlgebra :
    Algebra ↥((chartScheme V.chart).presheaf.stalk V.point)
      ↥(henselianLocalRing B S hS X hX x hXd) :=
  stalkAlgebra B S hS X hX x hXd V

/-- `𝒪^h_{X, x}` is a henselization of the local ring of an elementary étale neighborhood at its
distinguished point, at the chart spelling. This is Stacks 0EMY in the form
`AlgebraicGeometry.Space.henselianLocalRing_isHenselization`. -/
@[sga "3 X 4.4" "Case 2°"]
abbrev isHenselization_elementaryEtaleChartStalk :
    letI := isLocalRing_elementaryEtaleChartStalk B S hS hX x V
    letI := henselianLocalRing_isLocalRing B S hS X hX x hXd
    letI := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
    IsLocalRing.IsHenselization ↥((chartScheme V.chart).presheaf.stalk V.point)
      (IsLocalRing.ResidueField ↥((chartScheme V.chart).presheaf.stalk V.point))
      ↥(henselianLocalRing B S hS X hX x hXd) :=
  henselianLocalRing_isHenselization B S hS X hX x hXd V

/-- `𝒪^h_{X, x}` is flat over the local ring of an elementary étale neighborhood at its
distinguished point, at the chart spelling: a henselization is flat. -/
abbrev flat_elementaryEtaleChartStalk :
    letI := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
    Module.Flat ↥((chartScheme V.chart).presheaf.stalk V.point)
      ↥(henselianLocalRing B S hS X hX x hXd) :=
  letI := isLocalRing_elementaryEtaleChartStalk B S hS hX x V
  letI := henselianLocalRing_isLocalRing B S hS X hX x hXd
  letI := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
  letI := isHenselization_elementaryEtaleChartStalk B S hS hX hXd x V
  IsLocalRing.IsHenselization.flat
    (L := IsLocalRing.ResidueField ↥((chartScheme V.chart).presheaf.stalk V.point))

/-! ### The one family -/

include hX hXd in
/-- **One family of component ideals, carrying both the quotient presentation and the
incidence.** Let `X` be a decent algebraic space over `S`, let `x` be a point of it and let `V`
be an elementary étale neighborhood of `x`. Let `X_i ⊆ X` be closed subspaces whose point sets
are irreducible components of `|X|`, with points `ξ i` of `X_i` lying over `x`. Then there is a
family of ideals `I i` of `A = 𝒪^h_{X, x}` such that for every `i`

* `A ⧸ I i ≅ 𝒪^h_{X_i, ξ i}`, and
* a branch `𝔮` of `A` contains `I i` exactly when the irreducible component of `|X|` on which
  `𝔮` lies is `|X_i|`. -/
theorem exists_componentIdealFamily_ringEquiv_le_iff {ι : Type*} (Y : ι → Subfunctor X)
    (hY : ∀ i, IsClosedSubspace B S hS (Y i))
    (hYd : ∀ i, IsDecentSpace B S hS (Y i).toFunctor)
    (hYcomp : ∀ i, subspacePointSet B S hS X (Y i) ∈
      irreducibleComponents (points B S hS X))
    (ξ : ∀ i, points B S hS (Y i).toFunctor)
    (hx : ∀ i, pointsMap B S hS (Y i).toFunctor (Y i).ι (ξ i) = x) :
    letI := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
    letI := flat_elementaryEtaleChartStalk B S hS hX hXd x V
    ∃ I : ι → Ideal ↥(henselianLocalRing B S hS X hX x hXd),
      (∀ i, Nonempty ((↥(henselianLocalRing B S hS X hX x hXd) ⧸ I i) ≃+*
        ↥(henselianLocalRing B S hS (Y i).toFunctor (hY i).1 (ξ i) (hYd i)))) ∧
      ∀ (i : ι) (q : {q : PrimeSpectrum ↥(henselianLocalRing B S hS X hX x hXd) //
          q.asIdeal ∈ minimalPrimes ↥(henselianLocalRing B S hS X hX x hXd)}),
        I i ≤ q.1.asIdeal ↔
          ((componentOfFlatBranch B S hS hX hXd V.chart V.point
              ↥(henselianLocalRing B S hS X hX x hXd) q).1 :
            irreducibleComponents (points B S hS X)).1 = subspacePointSet B S hS X (Y i) := by
  let := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
  let := flat_elementaryEtaleChartStalk B S hS hX hXd x V
  choose w hw hpw using fun i => exists_point_closedImmersionBaseChangeNeighborhood B S hS hX
    (hY i).1 (hYd i) (Y i).ι (hY i).2 (ξ i) x (hx i) V
  refine ⟨fun i => (RingHom.ker
      ((V.scheme.left.1.presheaf.stalkCongr (.of_eq (hpw i).symm)).hom ≫
        ((hY i).2.rep.snd V.toSpace).left.1.stalkMap (w i)).hom).map
      (stalkToHenselianLocalRing B S hS X hX x hXd V), fun i => ?_, fun i q => ?_⟩
  · exact ringEquiv_henselianLocalRing_quotient_ker_stalkMap_rep_snd B S hS hX hXd (hY i).1
      (hYd i) (hY i).2 V (w i) (hw i) (hpw i)
  · exact componentIdeal_le_iff_componentOfFlatBranch_of_proj_eq B S hS hX hXd (Y i) (hY i)
      (hYcomp i) V.chart (w i) V.point (hpw i) _ q

include hX hXd in
/-- **The one family, with the two ring-theoretic hypotheses of the additivity read off.** Let
`X_i ⊆ X` be closed subspaces whose point sets are irreducible components of `|X|`, each
integral and locally Noetherian, and let `Z i` be a prime divisor of `X_i` whose generic point
lies over `x`. Then there is a family of ideals `I i` of `A = 𝒪^h_{X, x}` with

* `I i ≠ ⊤`, `A ⧸ I i` reduced, `ringKrullDim (A ⧸ I i) = 1`,
* a branch `𝔮` of `A` contains `I i` exactly when the component it lies on is `|X_i|`, and
* `A ⧸ I i ≅ 𝒪^h_{X_i, ξ_i}` for `ξ_i` the generic point of `Z i`. -/
theorem exists_componentIdealFamily_isReduced_ringKrullDim_eq_one_le_iff {ι : Type*}
    (Y : ι → Subfunctor X) (hY : ∀ i, IsClosedSubspace B S hS (Y i))
    (hYint : ∀ i, IsIntegralSpace B S hS (Y i).toFunctor)
    (hYN : ∀ i, HasEtaleLocalProperty B S hS (Y i).toFunctor
      (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (hYcomp : ∀ i, subspacePointSet B S hS X (Y i) ∈
      irreducibleComponents (points B S hS X))
    (Z : ∀ i, PrimeDivisor B S hS (Y i).toFunctor)
    (hx : ∀ i, pointsMap B S hS (Y i).toFunctor (Y i).ι
      ((Z i).genericPoint B S hS (Y i).toFunctor) = x) :
    letI := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
    letI := flat_elementaryEtaleChartStalk B S hS hX hXd x V
    ∃ I : ι → Ideal ↥(henselianLocalRing B S hS X hX x hXd),
      (∀ i, I i ≠ ⊤) ∧
      (∀ i, _root_.IsReduced (↥(henselianLocalRing B S hS X hX x hXd) ⧸ I i)) ∧
      (∀ i, ringKrullDim (↥(henselianLocalRing B S hS X hX x hXd) ⧸ I i) = 1) ∧
      (∀ (i : ι) (q : {q : PrimeSpectrum ↥(henselianLocalRing B S hS X hX x hXd) //
          q.asIdeal ∈ minimalPrimes ↥(henselianLocalRing B S hS X hX x hXd)}),
        I i ≤ q.1.asIdeal ↔
          ((componentOfFlatBranch B S hS hX hXd V.chart V.point
              ↥(henselianLocalRing B S hS X hX x hXd) q).1 :
            irreducibleComponents (points B S hS X)).1 = subspacePointSet B S hS X (Y i)) ∧
      ∀ i, Nonempty ((↥(henselianLocalRing B S hS X hX x hXd) ⧸ I i) ≃+*
        ↥((Z i).genericHenselianLocalRing B S hS (hY i).1 ((hYint i).isDecentSpace))) := by
  let := elementaryEtaleChartStalkAlgebra B S hS hX hXd x V
  let := flat_elementaryEtaleChartStalk B S hS hX hXd x V
  obtain ⟨I, he, hinc⟩ := exists_componentIdealFamily_ringEquiv_le_iff B S hS hX hXd x V Y hY
    (fun i => (hYint i).isDecentSpace) hYcomp
    (fun i => (Z i).genericPoint B S hS (Y i).toFunctor) hx
  refine ⟨I, ?_, ?_, ?_, hinc, he⟩ <;> intro i <;> obtain ⟨e⟩ := he i
  · have := PrimeDivisor.nontrivial_genericHenselianLocalRing B S hS (hY i).1
      ((hYint i).isDecentSpace) (hYint i) (hYN i) (Z i)
    exact Ideal.Quotient.nontrivial_iff.mp e.toEquiv.nontrivial
  · have := PrimeDivisor.isReduced_genericHenselianLocalRing B S hS (hY i).1
      ((hYint i).isDecentSpace) (hYint i) (hYN i) (Z i)
    exact isReduced_of_injective e.toRingHom e.injective
  · exact (ringKrullDim_eq_of_ringEquiv e).trans
      (PrimeDivisor.ringKrullDim_genericHenselianLocalRing_eq_one B S hS (hY i).1
        ((hYint i).isDecentSpace) (hYint i) (hYN i) (Z i))

/-! ### The additivity formula at the henselian local ring of a prime divisor -/

section Additivity

variable (D : BaseSpaceDimensionSituation.{u})
    {X : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u}
    (Y : (BigFppfOver D.site D.base D.base_mem)ᵒᵖ ⥤ Type u)
    (hY : IsAlgebraicSpace D.site D.base D.base_mem Y)
    (hYdec : IsDecentSpace D.site D.base D.base_mem Y)
    (hYN : HasEtaleLocalProperty D.site D.base D.base_mem Y
      (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (Z : PrimeDivisor D.site D.base D.base_mem Y)

/-- The irreducible components of `|Y|` through the generic point of a prime divisor `Z` of `Y`,
in the indexing in which the branch-to-component map
`AlgebraicGeometry.Space.componentOfFlatBranch` of the additivity formula takes its values: a
component of `|Y|` together with the fact that the distinguished point of the generic chart of
`Z` maps into it. -/
abbrev PrimeDivisor.genericComponentIndex :=
  {W : irreducibleComponents (points D.site D.base D.base_mem Y) //
    chartSchemeToPoints D.site D.base D.base_mem Y
        (Z.genericEtaleChart D.site D.base D.base_mem hY hYdec)
        (Z.genericChart D.site D.base D.base_mem hY hYdec).point ∈
      (W : Set (points D.site D.base D.base_mem Y))}

/-- The reduced induced closed subspace of `Y` on one of the components through the generic
point of `Z`, which is the integral closed subspace that cuts the component out. -/
abbrev PrimeDivisor.genericComponentSubspace
    (i : Z.genericComponentIndex D Y hY hYdec) :
    IntegralClosedSubspace D.site D.base D.base_mem Y :=
  integralClosedSubspaceOfComponent D.site D.base D.base_mem hY hYdec i.1

include hY hYdec hYN in
/-- **The additivity of the order of vanishing over the irreducible components, at
`A = 𝒪^h_{Y, ξ}`.** Let `Y` be an algebraic space which is decent and locally Noetherian, and let
`Z` be a prime divisor of `Y` with generic point `ξ`. Write `A = 𝒪^h_{Y, ξ}` for the henselian
local ring of Stacks 0ENK there, and let the irreducible components of `|Y|` through `ξ` be
indexed by `i`, each cut out by the reduced induced closed subspace `Y_i` on it and carrying a
prime divisor `Z_i` whose generic point lies over `ξ`. Then for nonzerodivisors `a`, `b` of `A`
of finite colength there are ideals `I i` of `A` with `A ⧸ I i ≅ 𝒪^h_{Y_i, ξ_i}` and

  `ord_A(a) - ord_A(b) = ∑_i m_{Y_i, Y} · (ord_{A ⧸ I i}(a) - ord_{A ⧸ I i}(b))`,

`m_{Y_i, Y}` being the multiplicity of Stacks 0EE9 of the `i`-th component. -/
theorem exists_natCast_ord_sub_eq_finsum_components_mul
    (hNc : ∀ i : Z.genericComponentIndex D Y hY hYdec,
      HasEtaleLocalProperty D.site D.base D.base_mem
        (Z.genericComponentSubspace D Y hY hYdec i).subspace.toFunctor
        (fun T : Scheme.{u} => IsLocallyNoetherian T))
    (Zc : ∀ i : Z.genericComponentIndex D Y hY hYdec,
      PrimeDivisor D.site D.base D.base_mem
        (Z.genericComponentSubspace D Y hY hYdec i).subspace.toFunctor)
    (hZc : ∀ i : Z.genericComponentIndex D Y hY hYdec,
      pointsMap D.site D.base D.base_mem
          (Z.genericComponentSubspace D Y hY hYdec i).subspace.toFunctor
          (Z.genericComponentSubspace D Y hY hYdec i).subspace.ι
          ((Zc i).genericPoint D.site D.base D.base_mem
            (Z.genericComponentSubspace D Y hY hYdec i).subspace.toFunctor) =
        Z.genericPoint D.site D.base D.base_mem Y)
    (a b : ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec))
    (ha : IsSMulRegular ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) a)
    (hb : IsSMulRegular ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) b)
    (hfa : Module.length ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec)
      (↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) ⧸
        Ideal.span {a}) ≠ ⊤)
    (hfb : Module.length ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec)
      (↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) ⧸
        Ideal.span {b}) ≠ ⊤) :
    ∃ I : Z.genericComponentIndex D Y hY hYdec →
        Ideal ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec),
      (∀ i, Nonempty
        ((↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) ⧸ I i) ≃+*
          ↥((Zc i).genericHenselianLocalRing D.site D.base D.base_mem
            (Z.genericComponentSubspace D Y hY hYdec i).isClosedSubspace.1
            ((Z.genericComponentSubspace D Y hY hYdec i).isIntegralSpace.isDecentSpace))) ) ∧
      ((Ring.ord ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec)
            a).toNat : ℤ) -
          ((Ring.ord ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec)
            b).toNat : ℤ) =
        ∑ᶠ i : Z.genericComponentIndex D Y hY hYdec,
          irreducibleComponentMultiplicity D Y hY hYdec i.1 *
            (((Ring.ord
                (↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) ⧸ I i)
                (Ideal.Quotient.mk (I i) a)).toNat : ℤ) -
              ((Ring.ord
                (↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) ⧸ I i)
                (Ideal.Quotient.mk (I i) b)).toNat : ℤ)) := by
  let : IsLocalRing ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec) :=
    henselianLocalRing_isLocalRing D.site D.base D.base_mem Y hY
      (Z.genericPoint D.site D.base D.base_mem Y) hYdec
  obtain ⟨hdimA, hnoethA⟩ :=
    PrimeDivisor.ringKrullDim_eq_one_and_isNoetherianRing_genericHenselianLocalRing D.site D.base
      D.base_mem hY hYdec hYN Z
  let := hnoethA
  let := Z.isLocalRing_genericEtaleChartStalk D Y hY hYdec
  let := Z.genericEtaleChartStalkAlgebra D Y hY hYdec
  let := Z.flat_genericEtaleChartStalk D Y hY hYdec
  obtain ⟨I, hItop, hred, hdimI, hinc, he⟩ :=
    exists_componentIdealFamily_isReduced_ringKrullDim_eq_one_le_iff D.site D.base D.base_mem
      hY hYdec (Z.genericPoint D.site D.base D.base_mem Y)
      (Z.genericChart D.site D.base D.base_mem hY hYdec)
      (fun i => (Z.genericComponentSubspace D Y hY hYdec i).subspace)
      (fun i => (Z.genericComponentSubspace D Y hY hYdec i).isClosedSubspace)
      (fun i => (Z.genericComponentSubspace D Y hY hYdec i).isIntegralSpace) hNc
      (fun i => by
        rw [subspacePointSet_integralClosedSubspaceOfComponent]
        exact i.1.2)
      Zc hZc
  refine ⟨I, he, ?_⟩
  refine natCast_ord_sub_eq_finsum_components_mul_of_le_iff a b ha hb hdimA hfa hfb I hred hdimI
    (componentOfFlatBranch D.site D.base D.base_mem hY hYdec
      (Z.genericEtaleChart D.site D.base D.base_mem hY hYdec)
      (Z.genericChart D.site D.base D.base_mem hY hYdec).point
      ↥(Z.genericHenselianLocalRing D.site D.base D.base_mem hY hYdec))
    (fun i q => (hinc i q).trans ?_)
    (fun i => irreducibleComponentMultiplicity D Y hY hYdec i.1)
    (fun q => PrimeDivisor.natCast_length_localizationAtPrime_eq_multiplicity D Y hY hYdec Z q)
  rw [subspacePointSet_integralClosedSubspaceOfComponent]
  exact ⟨fun h => Subtype.ext (Subtype.ext h), fun h => congrArg (fun W => (W.1 :
    irreducibleComponents (points D.site D.base D.base_mem Y)).1) h⟩

end Additivity

end AlgebraicGeometry.Space

end
