module

public import StacksFrontier.AlgebraicGeometry.Spaces.ChartIdealSheafPreimage
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.ChartZeroSchemeSubschemeComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.ZeroSchemeChartDeltaDimension
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeOnSiteAffineCharts

/-!
# The ideal sheaf of a zero scheme on an arbitrary étale chart

Let `X` be an algebraic space over a scheme `S` of a big fppf site, let `ℒ` be an invertible
`𝒪_X`-module and let `s ∈ Γ(X, ℒ)`.  The chart base change `V ×_X Z(s)` of the zero scheme of
Stacks 0845 is a closed subscheme of the scheme of every étale chart `V`.  On an affine open `O`
of `chartScheme V`, which is itself an affine étale chart of `X`
(`AlgebraicGeometry.Space.openChart`), the ideal that the chart ideal sheaf of `Z(s)` attaches to
`O` is the evaluation ideal `AlgebraicGeometry.Space.sectionEvaluationIdealAt` of `s` at that
chart, transported along the comparison `Γ(O, ⊤) ≅ Γ(V, O)`.  The chart `V` itself need not be
affine.

## Main results

* `AlgebraicGeometry.Space.ideal_ker_closedSubspaceBaseChangeChartProj_zeroScheme`: the ideal
  of the chart ideal sheaf of `Z(s)` over an affine open of an arbitrary chart is the evaluation
  ideal of `s` at the affine chart that open cuts out.
* `AlgebraicGeometry.Space.comap_ker_closedSubspaceBaseChangeChartProj_zeroScheme`: the same
  statement as an equality of ideal sheaves on the open subscheme.
* `exists_isRegular_ideal_ker_closedSubspaceBaseChangeChartProj_zeroScheme_eq_span`:
  over an affine open of a chart on which `ℒ` has a free generator, the ideal sheaf of `Z(s)` is
  generated by a single regular function.

## Implementation notes

The proof combines `AlgebraicGeometry.Space.ker_rep_snd_eq_idealSheafDataOfChart`, which identifies
the kernel of the chart base change of a closed subspace with
`AlgebraicGeometry.Space.idealSheafDataOfChart`, with the computation of the defining ideal of a
zero scheme on an affine chart (`AlgebraicGeometry.Space.definingIdealAt_zeroScheme_eq`, whose
hypothesis holds for an invertible module by
`AlgebraicGeometry.Space.exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible`,
that is Stacks 0846), applied to the affine chart cut out by an affine open
(`AlgebraicGeometry.Space.isAffine_chartScheme_openChart`).

## References

* [Stacks Project, Tag 0845](https://stacks.math.columbia.edu/tag/0845)
* [Stacks Project, Tag 0846](https://stacks.math.columbia.edu/tag/0846)
* [Stacks Project, Tag 03MB](https://stacks.math.columbia.edu/tag/03MB)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The evaluation ideal `AlgebraicGeometry.Space.sectionEvaluationIdealAt` of a global section at
an étale chart, read as an ideal of `AlgebraicGeometry.Space.chartRing`. -/
noncomputable abbrev chartSectionEvaluationIdeal (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (U : SmallEtale B S hS X.1) :
    Ideal (chartRing B S hS X.1 X.2 U) :=
  sectionEvaluationIdealAt B S hS X L s U

/-- The ideal of the chart ideal sheaf of a zero scheme over an affine open of an arbitrary
chart.  Let `ℒ` be an invertible `𝒪_X`-module with a global section `s`, let `V` be an étale
scheme chart of `X`, not assumed affine, and let `O` be an affine open of `chartScheme V`.
Then the ideal which the kernel of the closed immersion `V ×_X Z(s) ⟶ V` attaches to `O` is the
evaluation ideal `AlgebraicGeometry.Space.sectionEvaluationIdealAt` of `s` at the affine étale
chart `O` cuts out, transported along the comparison `Γ(O, ⊤) ≅ Γ(V, O)`. -/
theorem ideal_ker_closedSubspaceBaseChangeChartProj_zeroScheme (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) (O : (chartScheme V).affineOpens) :
    (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
          (zeroScheme B S hS X L s).2 V).ker.ideal O =
      Ideal.map (openChartTopRingHom B S hS X V O.1)
        (chartSectionEvaluationIdeal B S hS X L s (openChart B S hS X.1 V O.1)) := by
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hinv
  rw [ker_closedSubspaceBaseChangeChartProj B S hS X (zeroScheme B S hS X L s) V, chartKer_eq,
    ker_rep_snd_eq_idealSheafDataOfChart B S hS X (zeroScheme B S hS X L s) V,
    ideal_idealSheafDataOfChart]
  exact congrArg (Ideal.map (openChartTopRingHom B S hS X V O.1))
    (definingIdealAt_zeroScheme_eq B S hS X L s Z hZ (openChart B S hS X.1 V O.1)
      (isAffine_chartScheme_openChart B S hS X.1 V O))

/-- The ideal sheaf of a zero scheme, restricted to an affine open of an arbitrary chart, is
induced by the evaluation ideal: on the affine open subscheme `O`, the inverse image of the chart
ideal sheaf of `Z(s)` is `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop` of the evaluation
ideal of `s` at the chart `O` cuts out. -/
theorem comap_ker_closedSubspaceBaseChangeChartProj_zeroScheme (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (V : SmallEtale B S hS X.1) (O : (chartScheme V).affineOpens) :
    (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
          (zeroScheme B S hS X L s).2 V).ker.comap O.1.ι =
      Scheme.IdealSheafData.ofIdealTop
        (sectionEvaluationIdealAt B S hS X L s (openChart B S hS X.1 V O.1)) := by
  have : IsAffine O.1.toScheme := O.2
  have hι : O.1.ι.appLE O.1 ⊤ O.1.ι_preimage_self.ge = O.1.topIso.inv := by
    rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
    exact congrArg (chartScheme V).presheaf.map (Subsingleton.elim _ _)
  have key : ∀ hT : (⊤ : O.1.toScheme.Opens) ∈ O.1.toScheme.affineOpens,
      ((closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
            (zeroScheme B S hS X L s).2 V).ker.comap O.1.ι).ideal ⟨⊤, hT⟩ =
        (Scheme.IdealSheafData.ofIdealTop
          (sectionEvaluationIdealAt B S hS X L s
            (openChart B S hS X.1 V O.1))).ideal ⟨⊤, hT⟩ := by
    intro hT
    rw [Stacks.IdealSheaf.ideal_comap_appLE _ O.1.ι O ⟨⊤, hT⟩ O.1.ι_preimage_self.ge,
      ideal_ker_closedSubspaceBaseChangeChartProj_zeroScheme B S hS X L hinv s V O, hι,
      Ideal.map_map,
      show (O.1.topIso.inv.hom).comp (openChartTopRingHom B S hS X V O.1) =
        RingHom.id _ from congrArg CommRingCat.Hom.hom O.1.topIso.hom_inv_id]
    exact (Ideal.map_id _).trans (Stacks.Divisors.ideal_ofIdealTop_top hT _).symm
  exact Scheme.IdealSheafData.ext_of_isAffine (key _)

/-- The local equation of the zero scheme of a regular section on an affine open of an arbitrary
chart.  Let `ℒ` be an invertible `𝒪_X`-module with a **regular** global section `s`,
let `V` be an étale scheme chart of `X` and let `O` be an affine open of `chartScheme V` such
that `ℒ` has a free generator over the affine étale chart `O` cuts out.  Then the ideal sheaf of
`Z(s)` on `chartScheme V` is generated over `O` by a single regular function on `O`.

For an invertible module such a free generator exists over a covering family of every chart
(`AlgebraicGeometry.Space.exists_generator_cover_smul_of_isInvertible`). -/
theorem exists_isRegular_ideal_ker_closedSubspaceBaseChangeChartProj_zeroScheme_eq_span
    (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections)
    (hsreg : AlgebraicGeometry.IsRegularSection (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property s)
    (V : SmallEtale B S hS X.1) (O : (chartScheme V).affineOpens)
    (t : ToType (L.val.obj (op (openChart B S hS X.1 V O.1))))
    (hfree : Function.Bijective
      fun r : chartRing B S hS X.1 X.2 (openChart B S hS X.1 V O.1) => r • t) :
    ∃ a : Γ(chartScheme V, O.1), _root_.IsRegular a ∧
      (closedSubspaceBaseChangeChartProj B S hS X.2 (zeroScheme B S hS X L s).1
          (zeroScheme B S hS X L s).2 V).ker.ideal O = Ideal.span {a} := by
  obtain ⟨g, hgreg, hgspan⟩ :=
    exists_isRegular_sectionEvaluationIdealAt_eq_span_of_free_generator B S hS X L s hsreg
      (openChart B S hS X.1 V O.1) t hfree
  set e := O.1.topIso.commRingCatIsoToRingEquiv
  refine ⟨openChartTopRingHom B S hS X V O.1 g, ?_, ?_⟩
  · refine isRegular_of_injective_mul_right fun x y hxy => e.symm.injective (hgreg.right ?_)
    have h := congrArg e.symm hxy
    rwa [map_mul, map_mul, show e.symm (openChartTopRingHom B S hS X V O.1 g) = g from
      e.symm_apply_apply g] at h
  · rw [ideal_ker_closedSubspaceBaseChangeChartProj_zeroScheme B S hS X L hinv s V O,
      show chartSectionEvaluationIdeal B S hS X L s (openChart B S hS X.1 V O.1) =
        Ideal.span {g} from hgspan]
    exact (Ideal.map_span _ _).trans (congrArg Ideal.span Set.image_singleton)

end AlgebraicGeometry.Space

end
