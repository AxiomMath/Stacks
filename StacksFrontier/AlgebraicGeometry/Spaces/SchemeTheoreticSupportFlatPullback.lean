* [Stacks Project, Tag 03ML](https://stacks.math.columbia.edu/tag/03ML)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TensorProduct

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-! ### Flatness along a diagram of affine charts -/

/-- Restriction of regular functions along a diagram of étale charts is the map on global
functions of the vertical morphism of schemes.

The structure sheaf of the small étale site of an algebraic space is global regular functions on
the underlying schemes, so this holds by definition. -/
theorem chartDiagramRestrict_eq_appTop (f : Y ⟶ X) (d : ChartDiagram B S hS Y.1 X.1 f.hom) :
    chartDiagramRestrict B S hS f d =
      ((BigFppfOver.toScheme B S hS).map d.g).appTop.hom := rfl

/-- **For a flat morphism of algebraic spaces the restriction map of regular functions along a
diagram of affine étale charts is flat.**

`AlgebraicGeometry.Space.IsFlat` is flatness of the scheme morphism underlying every commuting
square of étale charts; a chart diagram is such a square, and for a flat morphism of affine
schemes the induced map of global functions is a flat ring map. -/
theorem flat_chartDiagramRestrict_of_isFlat {f : Y ⟶ X} (hf : IsFlat B S hS f.hom)
    (d : ChartDiagram B S hS Y.1 X.1 f.hom)
    (hU : IsAffine (chartScheme d.U)) (hV : IsAffine (chartScheme d.V)) :
    RingHom.Flat (chartDiagramRestrict B S hS f d) := by
  have hfl : Flat ((BigFppfOver.toScheme B S hS).map d.g) :=
    hf d.U.1.left d.V.1.left d.U.1.hom d.V.1.hom d.g d.U.property d.V.property d.comm.symm
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj
    ((SmallEtale.toOver B S hS Y.1).obj d.U)) := hU
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj
    ((SmallEtale.toOver B S hS X.1).obj d.V)) := hV
  rw [chartDiagramRestrict_eq_appTop]
  exact HasRingHomProperty.appTop (P := @Flat) _ hfl

/-- The sections of `𝒪_Y` over the chart of `Y` form a flat algebra over the sections of `𝒪_X`
over the chart of `X`, for a diagram of affine étale charts over a flat morphism. -/
theorem moduleFlat_chartDiagram_of_isFlat {f : Y ⟶ X} (hf : IsFlat B S hS f.hom)
    (d : ChartDiagram B S hS Y.1 X.1 f.hom)
    (hU : IsAffine (chartScheme d.U)) (hV : IsAffine (chartScheme d.V)) :
    letI := chartDiagramAlgebra B S hS f d
    Module.Flat (chartRing B S hS X.1 X.2 d.V) (chartRing B S hS Y.1 Y.2 d.U) :=
  flat_chartDiagramRestrict_of_isFlat B S hS hf d hU hV

/-! ### The annihilator ideal over a diagram of affine charts -/

/-- **Over a diagram of affine étale charts above a flat morphism the annihilator ideal of
`f^*F` is generated by the image of the annihilator ideal of `F`.**

On an affine chart the annihilator ideal of a quasi-coherent module is the annihilator of its
module of sections, by
`AlgebraicGeometry.Space.chartIdeal_annihilatorIdealSheaf_eq_annihilator`; the sections of `F`
over the chart of `X` are a finite module because `F` is of finite type; the sections of `f^*F`
over the chart of `Y` are their base change along the restriction map, by
`AlgebraicGeometry.Space.isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite`, and
flatness of `f` makes that restriction map a flat ring map; and the annihilator of a finite
module extends to the annihilator of its base change along a flat map, which is Stacks 07T8. -/
theorem annihilatorIdealAt_modulePullback_eq_map {f : Y ⟶ X} (hf : IsFlat B S hS f.hom)
    {F : Modules.{u, u} B S hS X.1 X.2} (hF : F.IsQuasicoherentOnSite)
    (hft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS X.1 X.2).J F.val)
    (d : ChartDiagram B S hS Y.1 X.1 f.hom)
    (hU : IsAffine (chartScheme d.U)) (hV : IsAffine (chartScheme d.V)) :
    chartIdeal B S hS Y
        (annihilatorIdealSheaf B S hS Y ((modulePullback B S hS f).obj F)) d.U =
      Ideal.map (chartDiagramRestrict B S hS f d)
        (chartIdeal B S hS X (annihilatorIdealSheaf B S hS X F) d.V) := by
  let _ := chartDiagramAlgebra B S hS f d
  obtain ⟨e⟩ :=
    isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite B S hS f F hF d hU hV
  have hG : ((modulePullback B S hS f).obj F).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS f F hF
  have _ : Module.Flat (chartRing B S hS X.1 X.2 d.V) (chartRing B S hS Y.1 Y.2 d.U) :=
    moduleFlat_chartDiagram_of_isFlat B S hS hf d hU hV
  have _ : Module.Finite (chartRing B S hS X.1 X.2 d.V) (F.val.obj (op d.V)) :=
    moduleFinite_sections_of_isFiniteType B S hS X.1 X.2
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 F hF) hft hV
  rw [chartIdeal_annihilatorIdealSheaf_eq_annihilator B S hS Y _ hG d.U hU,
    chartIdeal_annihilatorIdealSheaf_eq_annihilator B S hS X F hF d.V hV,
    ← chartDiagramAlgebra_algebraMap B S hS f d,
    ann_extension_eq_ann_baseChange_module (R := chartRing B S hS X.1 X.2 d.V)
      (S := chartRing B S hS Y.1 Y.2 d.U) (M := F.val.obj (op d.V))]
  exact e.annihilator_eq.symm

/-! ### The two ideal sheaves on the source -/

/-- **The defining ideal sheaf of the inverse image of the scheme-theoretic support is the
annihilator ideal sheaf of the pullback.**

The two agree over the source chart of every diagram of affine étale charts above `f`: there the
defining ideal of the inverse image is generated by the image of the defining ideal downstairs
(`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map_chartDiagram`), the defining ideal
downstairs is the annihilator ideal of `F`
(`AlgebraicGeometry.Space.exists_isClosedSubspace_schemeTheoreticSupport`), and
`AlgebraicGeometry.Space.annihilatorIdealAt_modulePullback_eq_map` identifies the image of the
latter with the annihilator ideal of `f^*F`.  Those charts cover every chart of `Y` by the
cofinality of the affine chart diagrams, Stacks 03G2, and membership in either ideal sheaf is
local, so the agreement propagates. -/
theorem definingIdealSheaf_preimage_eq_annihilatorIdealSheaf {f : Y ⟶ X}
    (hf : IsFlat B S hS f.hom)
    {F : Modules.{u, u} B S hS X.1 X.2} (hF : F.IsQuasicoherentOnSite)
    (hft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS X.1 X.2).J F.val)
    (Z : ClosedSubspaces B S hS X.1)
    (hZ : definingIdealSheaf B S hS X Z = annihilatorIdealSheaf B S hS X F) :
    definingIdealSheaf B S hS Y (preimageSubspace B S hS f Z) =
      annihilatorIdealSheaf B S hS Y ((modulePullback B S hS f).obj F) := by
  have hcov : ∀ W : SmallEtale B S hS Y.1,
      Sieve.generate (affineChartDiagramPresieve B S hS f F W) ∈
        SmallEtale.topology B S hS Y.1 W := fun W =>
    generate_affineChartDiagram_mem_topology B S hS f
      (fun V => Module.Finite (chartRing B S hS X.1 X.2 V) (F.val.obj (op V)))
      (fun _ hVaff => moduleFinite_sections_of_isFiniteType B S hS X.1 X.2
        (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 F hF) hft hVaff) W
  have key : ∀ d : ChartDiagram B S hS Y.1 X.1 f.hom, IsAffine (chartScheme d.U) →
      IsAffine (chartScheme d.V) →
      chartIdeal B S hS Y (definingIdealSheaf B S hS Y (preimageSubspace B S hS f Z)) d.U =
        chartIdeal B S hS Y
          (annihilatorIdealSheaf B S hS Y ((modulePullback B S hS f).obj F)) d.U := by
    intro d hU hV
    have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj d.U.1.left) := hU
    have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.1.left) := hV
    rw [annihilatorIdealAt_modulePullback_eq_map B S hS hf hF hft d hU hV]
    refine (definingIdealAt_preimage_eq_map_chartDiagram B S hS f Z d).trans ?_
    exact congrArg (Ideal.map (chartDiagramRestrict B S hS f d)) (congrArg
      (fun N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule ↦ N.obj (op d.V)) hZ)
  have dir : ∀ A C : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule,
      (∀ d : ChartDiagram B S hS Y.1 X.1 f.hom, IsAffine (chartScheme d.U) →
        IsAffine (chartScheme d.V) → chartIdeal B S hS Y A d.U ≤ chartIdeal B S hS Y C d.U) →
      A ≤ C := fun A C h ↦ fun W b hb ↦ by
    refine C.isSheaf b (GrothendieckTopology.superset_covering _ ?_ (hcov W.unop))
    rintro Q g ⟨W', g', a, ⟨hW'aff, d, hdU, hdV, -⟩, rfl⟩
    subst hdU
    have hres : chartRestrict (hF := Y.2) a b ∈ chartIdeal B S hS Y A d.U := A.map_mem a.op hb
    change chartRestrict (hF := Y.2) (g' ≫ a) b ∈ _
    rw [chartRestrict_comp]
    exact C.map_mem g'.op (h d hW'aff hdV hres)
  exact le_antisymm (dir _ _ fun d hU hV ↦ (key d hU hV).le)
    (dir _ _ fun d hU hV ↦ (key d hU hV).ge)

/-! ### Stacks 089C -/

/-- **[Stacks, Tag 089C].**  Let `f : Y ⟶ X` be a flat morphism of algebraic spaces over `S` and
let `F` be a quasi-coherent `𝒪_X`-module of finite type with scheme-theoretic support `Z ⊆ X`.
Then the inverse image `f⁻¹(Z)` is the scheme-theoretic support of `f^*F`. -/
@[stacks 089C "flatness of the morphism, quasi-coherence of the module and finiteness of its \
type are the hypotheses of the tag and are all consumed; the affine-chart description of the \
pullback of modules, Descent Proposition 03DX(2) read across the morphism, is proved, not \
carried"]
theorem schemeTheoreticSupport_modulePullback {f : Y ⟶ X} (hf : IsFlat B S hS f.hom)
    (F : Modules.{u, u} B S hS X.1 X.2) (hF : F.IsQuasicoherentOnSite)
    (hft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS X.1 X.2).J F.val) :
    schemeTheoreticSupport B S hS Y ((modulePullback B S hS f).obj F) =
      (schemeTheoreticSupport B S hS X F).preimage f.hom := by
  obtain ⟨hZ, hZeq⟩ := exists_isClosedSubspace_schemeTheoreticSupport B S hS X F hF hft
  exact schemeTheoreticSupport_eq_of_definingIdealSheaf_eq B S hS Y _
    (preimageSubspace B S hS f ⟨schemeTheoreticSupport B S hS X F, hZ⟩)
    (definingIdealSheaf_preimage_eq_annihilatorIdealSheaf B S hS hf hF hft
      ⟨schemeTheoreticSupport B S hS X F, hZ⟩ hZeq)

end AlgebraicGeometry.Space

end
