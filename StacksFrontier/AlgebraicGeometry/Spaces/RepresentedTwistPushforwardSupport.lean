module

public import StacksFrontier.AlgebraicGeometry.Modules.FiniteBiproducts
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedModuleOfUnit
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePreimageStructureSheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentDevissageFiltration
public import StacksFrontier.AlgebraicGeometry.Spaces.PushforwardPresentationExact
public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.SmallEtaleExactAssociatedModule
public import StacksFrontier.AlgebraicGeometry.GeneratingSections.InvertibleUnitMono

/-!
# Full support of the direct image of a globally generated invertible module

Let `p : h_V ⟶ Y` be a surjective morphism from the algebraic space represented by an object `V`
of the site, and let `G` be an invertible module on the scheme `V₀` underlying `V`, generated by
finitely many global sections `s_i`, `i ∈ I`.  Then the direct image along `p` of the associated
module of `G^{⊕ I}` has support all of `|Y|`.

The sections give a monomorphism `𝒪_{V₀} ⟶ G^{⊕ I}`
(`Stacks.SheafOfModules.mono_biproductLift_unitHomEquiv_symm`); the associated module functor is
left exact ([Stacks, Tag 08H8]) and carries `𝒪_{V₀}` to `𝒪_{h_V}`
(`AlgebraicGeometry.Space.representedModuleOfUnitIso`); the direct image is a right adjoint, so
`p_* 𝒪_{h_V} ⟶ p_*((G^{⊕ I})ᵃ)` is a monomorphism, and the support of the source is `|Y|`
because `p` is surjective
(`AlgebraicGeometry.Space.supportOfSheaf_modulePushforward_structureSheaf_eq_univ`).

## Main results

* `AlgebraicGeometry.Space.exists_mono_representedModuleOf_biproduct`: the existence of the
  monomorphism `𝒪_{h_V} ⟶ (G^{⊕ I})ᵃ`.
* `AlgebraicGeometry.Space.moduleSupportSet_modulePushforward_representedModuleOf_eq_univ`: the
  support statement.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite


universe u

namespace AlgebraicGeometry.Space

/-- The same, at the spelling `SheafOfModules X.ringCatSheaf`. -/
local instance hasFiniteBiproducts_sheafOfModules_ringCatSheaf (X : Scheme.{u}) :
    HasFiniteBiproducts (SheafOfModules.{u} X.ringCatSheaf) :=
  HasFiniteBiproducts.of_hasFiniteProducts

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

section

attribute [local instance 5000] SheafOfModules.instAbelian

/-- The associated-module functor of a represented algebraic space preserves monomorphisms: it
is the étale associated-module functor, left exact by [Stacks, Tag 08H8], followed by an
equivalence. -/
theorem mono_representedModuleOf_map (V : BigFppfOver B S hS)
    {G H : ((BigFppfOver.toScheme B S hS).obj V).Modules} (m : G ⟶ H) [Mono m] :
    Mono ((representedSmallEtaleModuleEquivalence B S hS V).functor.map
      ((_root_.AlgebraicGeometry.SmallEtale.associatedModule (associatedBigEtaleSite B)
        ((BigFppfOver.toScheme B S hS).obj V) V.left.property).map m)) := by
  have := _root_.AlgebraicGeometry.SmallEtale.preservesFiniteLimits_associatedModule
    (associatedBigEtaleSite B) ((BigFppfOver.toScheme B S hS).obj V) V.left.property
  have h1 : Mono ((_root_.AlgebraicGeometry.SmallEtale.associatedModule (associatedBigEtaleSite B)
      ((BigFppfOver.toScheme B S hS).obj V) V.left.property).map m) :=
    preserves_mono_of_preservesLimit _ m
  exact (representedSmallEtaleModuleEquivalence B S hS V).functor.map_mono _

end

/-- **Generating sections of an invertible module embed the structure sheaf, on the small étale
site.**  For an invertible `G` on `V₀` generated by finitely many global sections, indexed by
`Fin n`, the structure sheaf of `h_V` embeds into the associated module of `G^{⊕ n}`. -/
theorem exists_mono_representedModuleOf_biproduct (V : BigFppfOver B S hS)
    (G : ((BigFppfOver.toScheme B S hS).obj V).Modules)
    [Stacks.Ample.IsInvertibleModule ((BigFppfOver.toScheme B S hS).obj V) G]
    (σ : G.GeneratingSections) [Fintype σ.I] :
    ∃ m : SheafOfModules.unit (structureRingSheaf B S hS (schemeSpace V)) ⟶
      representedModuleOf B S hS V (⨁ fun _ : Fin (Fintype.card σ.I) => G), Mono m := by
  have hloc : ∀ z : ((BigFppfOver.toScheme B S hS).obj V).toRingedSpace.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk
        ((BigFppfOver.toScheme B S hS).obj V).toRingedSpace z) :=
    fun z => ((BigFppfOver.toScheme B S hS).obj V).isLocalRing z
  set e := Fintype.equivFin σ.I
  have hs : ∀ x : ((BigFppfOver.toScheme B S hS).obj V).toRingedSpace.carrier,
      ∃ j, x ∈ Stacks.SheafOfModules.nonvanishingOpen G (σ.s (e.symm j)) := by
    intro x
    obtain ⟨i, hi⟩ := @Stacks.SheafOfModules.exists_mem_nonvanishingOpen_of_generatingSections
      _ hloc G _ σ x
    exact ⟨e i, by rw [Equiv.symm_apply_apply]; exact hi⟩
  set f := biproduct.lift (C := ((BigFppfOver.toScheme B S hS).obj V).Modules)
      (f := fun _ : Fin (Fintype.card σ.I) => G)
      fun j => G.unitHomEquiv.symm (σ.s (e.symm j))
  have hm : Mono f :=
    @Stacks.SheafOfModules.mono_biproductLift_unitHomEquiv_symm
      ((BigFppfOver.toScheme B S hS).obj V).toRingedSpace hloc G _ _ _ _ hs
      (Scheme.Modules.schemeModulesHasFiniteBiproducts _)
  have := mono_representedModuleOf_map B S hS V f
  exact ⟨(representedModuleOfUnitIso B S hS V).inv ≫ _,
    @mono_comp _ _ _ _ _ _ (@IsIso.mono_of_iso _ _ _ _ _ (Iso.isIso_inv _)) _ this⟩

/-- **The direct image of a globally generated invertible module along a surjection has full
support.** -/
theorem moduleSupportSet_modulePushforward_representedModuleOf_eq_univ
    {Y : AlgebraicSpaces B S hS} (V : BigFppfOver B S hS) (p : schemeSpace V ⟶ Y)
    (hp : IsSurjective B S hS p.hom) (G : ((BigFppfOver.toScheme B S hS).obj V).Modules)
    [Stacks.Ample.IsInvertibleModule ((BigFppfOver.toScheme B S hS).obj V) G]
    (σ : G.GeneratingSections) [Fintype σ.I] :
    moduleSupportSet.{u, u} B S hS Y ((modulePushforward B S hS p).obj
      (representedModuleOf B S hS V (⨁ fun _ : Fin (Fintype.card σ.I) => G))) = Set.univ := by
  obtain ⟨m, hm⟩ := exists_mono_representedModuleOf_biproduct B S hS V G σ
  refine Set.eq_univ_of_univ_subset ?_
  rw [← supportOfSheaf_modulePushforward_structureSheaf_eq_univ B S hS p hp]
  have hpl : PreservesLimitsOfSize.{0, 0} (modulePushforward B S hS p) :=
    (modulePullbackAdjunction B S hS p).rightAdjoint_preservesLimits
  have : PreservesLimitsOfShape WalkingCospan (modulePushforward B S hS p) :=
    hpl.preservesLimitsOfShape
  exact moduleSupportSet_subset_of_mono B S hS Y ((modulePushforward B S hS p).map m)
    (@Functor.map_mono _ _ _ _ (modulePushforward B S hS p)
      (preservesMonomorphisms_of_preservesLimitsOfShape _) _ _ m hm)

end AlgebraicGeometry.Space

end
