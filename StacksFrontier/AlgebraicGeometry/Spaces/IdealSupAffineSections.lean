module

public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealCartesian
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealLattice
public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentChartSectionsFinite
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealPowerSupport

/-!
# Sections of a sum of quasi-coherent sheaves of ideals over an affine chart

Let `X` be an algebraic space and let `ℐ, 𝒥 ⊆ 𝒪_X` be quasi-coherent sheaves of ideals. The
sum `ℐ + 𝒥` is the smallest sheaf of ideals containing both, so its sections are only locally
sums of sections. Over an étale chart `A` with affine underlying scheme they are sums on the
nose: `(ℐ + 𝒥)(A) = ℐ(A) + 𝒥(A)`. Consequently the ideal of the scheme-theoretic intersection of
two closed subspaces is, over such a chart, the sum of their ideals.

## Main results

* `AlgebraicGeometry.Space.chartSectionIdeal_sup_of_isAffine`: `(ℐ + 𝒥)(A) = ℐ(A) + 𝒥(A)`.
* `AlgebraicGeometry.Space.definingIdealAt_inf_of_isAffine`: the defining ideal of `Y ∩ Z` over an
  affine étale chart is the sum of the defining ideals of `Y` and `Z`.

## Implementation notes

A section of `ℐ + 𝒥` restricts along a covering sieve into the objectwise sums, because the
sheaf closure of the objectwise sum is a sheaf of ideals containing `ℐ` and `𝒥`. Over an affine
member of that sieve each summand is generated by restrictions from `A`, by quasi-coherence, and
faithfully flat descent (`AlgebraicGeometry.Space.mem_of_locally_mem_span_restrict`) brings the
section back into `ℐ(A) + 𝒥(A)`.

## References

* [Stacks Project, Tag 0CYZ](https://stacks.math.columbia.edu/tag/0CYZ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Over affine charts, sections of a quasi-coherent ideal sheaf over `w` lie in the ideal
generated by the restrictions of any ideal containing its sections over `A`. -/
private theorem chartSectionIdeal_le_map_chartRestrict_of_le
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)
    (K : IdealSheaves B S hS F hF) (hK : K.toSheafOfModules.IsQuasicoherentOnSite)
    {A w : SmallEtale B S hS F} (hA : IsAffine (chartScheme A)) (hw : IsAffine (chartScheme w))
    (ρ : w ⟶ A) {T : Ideal (chartRing B S hS F hF A)} (h : chartSectionIdeal B S hS F hF K A ≤ T) :
    chartSectionIdeal B S hS F hF K w ≤ Ideal.map (chartRestrict (hF := hF) ρ) T :=
  (chartIdeal_le_map_chartRestrict B S hS F hF K ρ
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF K.toSheafOfModules hK
      A w hA hw ρ).2).trans (Ideal.map_mono h)

/-- **The sections of a sum of quasi-coherent sheaves of ideals over an affine chart are the sum
of the sections.** -/
theorem chartSectionIdeal_sup_of_isAffine (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : IsAlgebraicSpace B S hS F) (I J : IdealSheaves B S hS F hF)
    (hI : I.toSheafOfModules.IsQuasicoherentOnSite)
    (hJ : J.toSheafOfModules.IsQuasicoherentOnSite) {A : SmallEtale B S hS F}
    (hA : IsAffine (chartScheme A)) :
    chartSectionIdeal B S hS F hF (I ⊔ J) A =
      chartSectionIdeal B S hS F hF I A ⊔ chartSectionIdeal B S hS F hF J A := by
  refine le_antisymm (fun x hx => ?_)
    (sup_le (SheafOfModules.Submodule.le_iff.1 (le_sup_left : I ≤ I ⊔ J) (op A))
      (SheafOfModules.Submodule.le_iff.1 (le_sup_right : J ≤ I ⊔ J) (op A)))
  -- the sheaf closure of the objectwise sum contains `I ⊔ J`
  have hP : I ⊔ J ≤ Stacks.SheafOfModules.sheafifySubmodule (I.toSubmodule ⊔ J.toSubmodule) :=
    sup_le
      (SheafOfModules.Submodule.le_iff.2 (le_sup_left.trans
        (Stacks.SheafOfModules.le_sheafifySubmodule _)))
      (SheafOfModules.Submodule.le_iff.2 (le_sup_right.trans
        (Stacks.SheafOfModules.le_sheafifySubmodule _)))
  obtain ⟨Sv, hSv, hloc⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule
    (SheafOfModules.Submodule.le_iff.1 hP (op A) hx)
  refine mem_of_locally_mem_span_restrict B S hS F hF (M := SheafOfModules.unit _)
    isCartesianOnAffineCharts_unit hA
    (chartSectionIdeal B S hS F hF I A ⊔ chartSectionIdeal B S hS F hF J A) x hSv
    fun w ρ hw hρ => ?_
  have hmem : chartRestrict (hF := hF) ρ x ∈
      chartSectionIdeal B S hS F hF I w ⊔ chartSectionIdeal B S hS F hF J w := hloc ρ hρ
  exact sup_le (chartSectionIdeal_le_map_chartRestrict_of_le B S hS F hF I hI hA hw ρ le_sup_left)
    (chartSectionIdeal_le_map_chartRestrict_of_le B S hS F hF J hJ hA hw ρ le_sup_right) hmem

/-- **The defining ideal of an intersection over an affine chart.** Over an étale chart with
affine underlying scheme, the defining ideal of the scheme-theoretic intersection `Y ∩ Z` of two
closed subspaces is the sum of the defining ideals of `Y` and `Z`. -/
theorem definingIdealAt_inf_of_isAffine (X : AlgebraicSpaces B S hS)
    (Y Z : ClosedSubspaces B S hS X.1) {A : SmallEtale B S hS X.1}
    (hA : IsAffine (chartScheme A)) :
    definingIdealAt B S hS X (schemeTheoreticIntersection B S hS X.1 X.2 Y Z) (op A) =
      definingIdealAt B S hS X Y (op A) ⊔ definingIdealAt B S hS X Z (op A) := by
  rw [← definingIdealSheaf_obj B S hS X, definingIdealSheaf_schemeTheoreticIntersection]
  exact chartSectionIdeal_sup_of_isAffine B S hS X.1 X.2 _ _
    (isQuasicoherentOnSite_definingIdealSheaf B S hS X Y)
    (isQuasicoherentOnSite_definingIdealSheaf B S hS X Z) hA

end AlgebraicGeometry.Space

end
