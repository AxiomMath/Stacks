module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleCoverAlgebraic
public import StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.GroupSpaces.TorsorsWithEquivariantMap

/-!
# The étale glueing criterion against a `familyImage` covering

`StacksFrontier.AlgebraicGeometry.Spaces.EtaleCoverAlgebraic` states its criterion with the
covering hypothesis `CategoryTheory.Presheaf.IsLocallySurjective` on the desc map. The
covering hypothesis actually available in this development is the one
`AlgebraicGeometry.Space.glueHom` consumes: that the subfunctor
`AlgebraicGeometry.Space.familyImage` generated by the images of the family has a covering
sieve of sections at every object. This file converts the second into the first and restates
the criterion accordingly.

The two are not interchangeable in general — `familyImage` is about an arbitrary family,
whereas local surjectivity is about one morphism — but a family that factors through a single
morphism has its `familyImage` sieve contained in that morphism's image sieve, which is all
the implication needs.

## Main results

* `AlgebraicGeometry.Space.isLocallySurjective_of_familyImage_sieveOfSection`: a morphism
  through which a `familyImage`-covering family factors is locally surjective.
* `AlgebraicGeometry.isAlgebraicSpace_of_etale_familyImage_cover`: the criterion of
  `AlgebraicGeometry.isAlgebraicSpace_of_etale_cover` with the covering hypothesis in
  `familyImage` form.

## References

* [Stacks Project, Tag 0BGR](https://stacks.math.columbia.edu/tag/0BGR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe v u

namespace AlgebraicGeometry

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

namespace Space

variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {I : Type v}

/-- **A morphism through which a `familyImage`-covering family factors is locally
surjective.**

If the images of a family `pf i : Pi i ⟶ F` cover every section of `F` for the fppf topology,
in the sense that the sieve cut out by `AlgebraicGeometry.Space.familyImage` at every section
is a covering sieve, and if each `pf i` factors through `g : K ⟶ F`, then `g` is locally
surjective.

A section in the image of `pf i` over some `W` is in the image of `g` over `W`, by the
factorization; so the `familyImage` sieve is contained in the image sieve of `g`, which is
therefore covering too. -/
theorem isLocallySurjective_of_familyImage_sieveOfSection
    {K : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (g : K ⟶ F)
    {Pi : I → (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (pf : ∀ i, Pi i ⟶ F)
    (r : ∀ i, Pi i ⟶ K) (hfac : ∀ i, r i ≫ g = pf i)
    (hcover : ∀ (Z : BigFppfOver B S hS) (x : F.obj (op Z)),
      (familyImage pf).sieveOfSection x ∈ BigFppfOver.topology B S hS Z) :
    Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS) g := by
  refine ⟨fun {Z} x => ?_⟩
  refine (BigFppfOver.topology B S hS).superset_covering ?_ (hcover Z x)
  rintro W f ⟨i, y, hy⟩
  refine ⟨(r i).app (op W) y, ?_⟩
  rw [← hy, ← hfac i]
  simp

end Space

/-- **The étale glueing criterion, against a `familyImage` covering.**

Let `F` be an fppf sheaf on the big fppf site over `S`, let `Fᵢ` be a family of algebraic
spaces over `S` indexed by an admissible `u`-small type and let `G` be their coproduct as fppf
sheaves. If each composite `Fᵢ ⟶ G ⟶ F` is
representable and étale, and the images of those composites cover every section of `F` for
the fppf topology, then `F` is an algebraic space over `S`.

This is `AlgebraicGeometry.isAlgebraicSpace_of_etale_cover` with the covering hypothesis
restated in the form this development produces it. -/
theorem isAlgebraicSpace_of_etale_familyImage_cover
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : Presheaf.IsSheaf (BigFppfOver.topology B S hS) F)
    {I : Type v} [Small.{u} I] [B.AdmitsCoproductIndex I]
    {Fi : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (hFi : ∀ i, IsAlgebraicSpace B S hS (Fi i).obj)
    {G : Sheaf (BigFppfOver.topology B S hS) (Type u)}
    (ι : ∀ i, Fi i ⟶ G) (hcoprod : IsColimit (Cofan.mk G ι)) (g : G.obj ⟶ F)
    (hetale : ∀ i, (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS)))
      ((ι i).hom ≫ g))
    (hcover : ∀ (Z : BigFppfOver B S hS) (x : F.obj (op Z)),
      (Space.familyImage fun i => (ι i).hom ≫ g).sieveOfSection x
        ∈ BigFppfOver.topology B S hS Z) :
    IsAlgebraicSpace B S hS F :=
  isAlgebraicSpace_of_etale_cover B S hS hF hFi ι hcoprod g hetale
    (Space.isLocallySurjective_of_familyImage_sieveOfSection B S hS g _
      (fun i => (ι i).hom) (fun _ => rfl) hcover)

end AlgebraicGeometry

end
