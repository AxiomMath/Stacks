/-!
# A finite surjection from an affine algebraic space has affine target (Stacks 07VS)

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` which is finite and
surjective, with `X` affine. Then `Y` is affine. This is Stacks 07VS.

The proof is the source's. `Y` is separated (Stacks 05Z2) and quasi-compact; by Stacks 07VR the
morphism is a directed limit of finite morphisms `X_a ⟶ Y` of finite presentation, with closed
immersions as transition morphisms, and by Stacks 07SQ some `X_a` is affine, so that one may assume
`f` of finite presentation. Viewing everything over `Spec ℤ` (Stacks 03I5), Stacks 07SU writes
`Y = lim Y_i` with `Y_i` of finite type over `ℤ`; by Stacks 07SK the morphism `f` descends to a
morphism `X_0 ⟶ Y_0` of finite presentation, whose base changes `X_i ⟶ Y_i` are finite for large
`i` (Stacks 084Z), surjective for large `i` (Stacks 07SN), and have affine source for large `i`
(Stacks 07SQ). For such an `i` the Noetherian space `Y_i` is affine by Stacks 07VP, and then so is
`Y`, affine over `Y_i`.

## Main results

* `AlgebraicGeometry.Space.isFinite_relocalize`: finiteness of a morphism survives the
  lower-shriek extension along a morphism of bases.
* `AlgebraicGeometry.Space.isAffineSpace_of_isFinite_of_isFinitePresentation_of_isTerminal`: the
  case of a morphism of finite presentation over `Spec ℤ`.
* `AlgebraicGeometry.Space.isAffineSpace_of_isFinite_of_isFinitePresentation_of_isSurjective`:
  the case of a morphism of finite presentation over an arbitrary base.
* `AlgebraicGeometry.Space.isAffineSpace_target_of_isFinite_of_isSurjective`: **Stacks 07VS.**

## Implementation notes

The inverse systems of Stacks 07SU, 07SK, 084Z, 07SN and 07SQ are the chapter's: they satisfy its
standing convention of Section 70.2 (tag 07SD),
`AlgebraicGeometry.Space.SiteContainsBaseChangeLimits`, which the absolute Noetherian approximation
provides (`AlgebraicGeometry.Space.hasConventionalNoetherianApproximation_of_etaleAtlas`) and which
the system of Stacks 07VR satisfies because its transition morphisms are closed immersions, hence
monomorphisms. Nothing here is a hypothesis of the main theorem.

## References

* [Stacks Project, Tag 07VS](https://stacks.math.columbia.edu/tag/07VS)
* [Stacks Project, Tag 07VR](https://stacks.math.columbia.edu/tag/07VR)
* [Stacks Project, Tag 07SU](https://stacks.math.columbia.edu/tag/07SU)
* [Stacks Project, Tag 07SK](https://stacks.math.columbia.edu/tag/07SK)
* [Stacks Project, Tag 084Z](https://stacks.math.columbia.edu/tag/084Z)
* [Stacks Project, Tag 07SN](https://stacks.math.columbia.edu/tag/07SN)
* [Stacks Project, Tag 07SQ](https://stacks.math.columbia.edu/tag/07SQ)
* [Stacks Project, Tag 07VP](https://stacks.math.columbia.edu/tag/07VP)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

/-- The first projection of a fibre product along an identity is an isomorphism. -/
theorem _root_.CategoryTheory.Limits.isIso_pullback_fst_id {C : Type*} [Category* C] {X Z : C}
    (f : X ⟶ Z) [HasPullback f (𝟙 Z)] : IsIso (pullback.fst f (𝟙 Z)) :=
  ⟨⟨pullback.lift (𝟙 _) f (by rw [Category.id_comp, Category.comp_id]), by
    apply pullback.hom_ext
    · rw [Category.assoc, pullback.lift_fst, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, pullback.lift_snd, Category.id_comp, pullback.condition,
        Category.comp_id], pullback.lift_fst _ _ _⟩⟩

/-! ### Finiteness and the lower-shriek extension -/

section Relocalize

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {S' : Scheme.{u}} (hS' : B.Contains S') (k : B.obj hS ⟶ B.obj hS')

/-- **Finiteness of a morphism survives the lower-shriek extension** along a morphism of bases.
A morphism is finite exactly when it is affine and proper (Stacks 04NZ), and both survive the
extension. -/
theorem isFinite_relocalize {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : IsAlgebraicSpace B S hS F) (hG : IsAlgebraicSpace B S hS G) {p : F ⟶ G}
    (h : IsFinite B S hS p) :
    IsFinite B S' hS' ((OverShriek.relocalizePresheafFunctor k).map p) := by
  obtain ⟨haff, hprop⟩ := (isFinite_iff_isAffineHom_and_isProper B S hS hF hG p).1 h
  exact (isFinite_iff_isAffineHom_and_isProper B S' hS'
    (isAlgebraicSpace_relocalize B (B.obj hS) (B.obj hS') k F hF)
    (isAlgebraicSpace_relocalize B (B.obj hS) (B.obj hS') k G hG) _).2
    ⟨isAffineHom_relocalize B S hS hS' k haff,
      (isProper_relocalize_iff B S hS S' hS' k hF hG p).2 hprop⟩

end Relocalize

/-! ### The case of a morphism of finite presentation over `Spec ℤ` -/

section Terminal

variable (B : BigFppfSite.{u}) (hZ : B.Contains (⊤_ Scheme.{u}))

/-- The representable presheaf of the identity of the base is terminal. -/
private noncomputable def yonedaMkIdIsoTerminal :
    yoneda.obj (Over.mk (𝟙 (B.obj hZ))) ≅
      ⊤_ ((BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u) :=
  ((Over.mkIdTerminal (X := B.obj hZ)).isTerminalObj yoneda _).uniqueUpToIso terminalIsTerminal

section QuasiCompactStages

variable {B hZ}

/-- **Every stage of a Noetherian approximation is quasi-compact.** A space of finite type over
`Spec ℤ` is quasi-compact: the base change of its structure morphism along the identity of the
terminal presheaf, which is quasi-compact (it is represented by the affine scheme `Spec ℤ`), is
the space itself. -/
private theorem NoetherianApproximation.isQuasiCompactSpace_obj
    {X : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u}
    (A : NoetherianApproximation B (⊤_ Scheme.{u}) hZ hZ X) :
    letI := A.preorder
    ∀ j, IsQuasiCompactSpace B (⊤_ Scheme.{u}) hZ (A.diagram.obj j) := by
  let := A.preorder
  intro j
  have hT : IsAffine (⊤_ Scheme.{u}) :=
    IsAffine.of_isIso (specULiftZIsTerminal.{u}.uniqueUpToIso terminalIsTerminal).inv
  have hqc : IsQuasiCompactSpace B (⊤_ Scheme.{u}) hZ
      (⊤_ ((BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u)) :=
    isQuasiCompactSpace_of_iso B _ hZ (yonedaMkIdIsoTerminal B hZ)
      (isQuasiCompactSpace_yoneda_of_isAffine B _ hZ (Over.mk (𝟙 (B.obj hZ))) hT)
  exact isQuasiCompactSpace_of_iso B _ hZ (viewOverIntegersIsoOfTerminal B hZ _)
    (isQuasiCompactSpace_of_iso B _ hZ (asIso (pullback.snd (𝟙 _) _))
      ((A.isFiniteTypeOverIntegers j).2 _ (isAlgebraicSpace_terminal B (⊤_ Scheme.{u}) hZ) hqc
        (𝟙 _)))

end QuasiCompactStages

/-- **A stage of a Noetherian approximation is Noetherian**: it is quasi-compact,
quasi-separated, and locally of finite type over the locally Noetherian `Spec ℤ`
(Stacks 04ZK). -/
theorem NoetherianApproximation.isNoetherian_obj {Y : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u}
    (A : NoetherianApproximation B (⊤_ Scheme.{u}) hZ hZ Y) (j : A.Iᵒᵖ) :
    letI := A.preorder
    IsNoetherian B (⊤_ Scheme.{u}) hZ hZ (A.diagram.obj j) := by
  let := A.preorder
  let V : BigFppfOver B (⊤_ Scheme.{u}) hZ := Over.mk (𝟙 (B.obj hZ))
  have : IsLocallyNoetherian ((BigFppfOver.toScheme B (⊤_ Scheme.{u}) hZ).obj V) := by
    let e : (⊤_ Scheme.{u}) ≅ Spec (CommRingCat.of (ULift.{u} ℤ)) :=
      specULiftZIsTerminal.uniqueUpToIso terminalIsTerminal |>.symm
    have : IsNoetherianRing (ULift.{u} ℤ) :=
      isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
    exact LocallyOfFiniteType.isLocallyNoetherian e.hom
  exact ⟨A.isQuasiCompactSpace_obj j, A.isAbsolutelyQuasiSeparated j,
    isLocallyNoetherian_of_isLocallyOfFiniteType B (⊤_ Scheme.{u}) hZ (A.isAlgebraicSpace j)
      (isAlgebraicSpace_terminal B (⊤_ Scheme.{u}) hZ) _
      (isLocallyOfFiniteType_terminal_of_isFiniteTypeOverIntegers (A.isFiniteTypeOverIntegers j))
      (hasEtaleLocalProperty_of_representable B (⊤_ Scheme.{u}) hZ _ _ V
        (yonedaMkIdIsoTerminal B hZ).symm inferInstance)⟩

/-- **The target of a finite surjection with affine source is quasi-compact and separated**: the
source is quasi-compact and separated (Stacks 08GR), quasi-compactness passes to the target along
a surjection (Stacks 040W) and separatedness along a surjective universally closed morphism
(Stacks 05Z2), a finite morphism being universally closed (Stacks 0415). -/
theorem isQuasiCompactSpace_and_isAbsolutelySeparated_of_isFinite_of_isSurjective
    (S : Scheme.{u}) (hS : B.Contains S) {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Y)
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y)
    (hsurj : IsSurjective B S hS f) (hfin : IsFinite B S hS f)
    (haff : IsAffineSpace B S hS X) :
    IsQuasiCompactSpace B S hS Y ∧ IsAbsolutelySeparated B S hS hZ Y := by
  let Xs : AlgebraicSpaces B S hS := ⟨X, hX⟩
  let V : SpacesEtale B S hS Xs := ⟨Over.mk (𝟙 Xs), fun U φ hφ ↦ hφ⟩
  have h := isQuasiCompactSeparated_of_isAffineSpace B S hS hZ Xs V haff
  exact ⟨IsQuasiCompactSpace.of_isSurjective B S hS hX hY hsurj h.1,
    isAbsolutelySeparated_of_isSurjective_of_universallyClosed B S hS hZ hX hY f hsurj
      (universallyClosed_of_isFinite B S hS hX hY hfin) h.2⟩

/-- **Stacks 07VS for a morphism of finite presentation over `Spec ℤ`.** Let `f : X ⟶ Y` be a
finite surjective morphism of finite presentation of algebraic spaces over `Spec ℤ`, with `X`
affine. Then `Y` is affine.

This is the third paragraph of the source's proof. `Y` is quasi-compact and separated, so Stacks
07SU writes it as the limit of a directed system `Y_i` of quasi-separated algebraic spaces of
finite type over `ℤ` with affine transition morphisms, satisfying the chapter's convention. By
Stacks 07SK, `f` is the base change of a morphism `X_0 ⟶ Y_0` of finite presentation; its base
changes `X_i ⟶ Y_i` are finite for large `i` by Stacks 084Z and surjective for large `i` by
Stacks 07SN, and `X_i` is affine for large `i` by Stacks 07SQ. For such an `i` the Noetherian
space `Y_i` is affine by Stacks 07VP, and `Y`, which is affine over `Y_i`, is affine. -/
theorem isAffineSpace_of_isFinite_of_isFinitePresentation_of_isTerminal
    {X Y : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u} (f : X ⟶ Y)
    (hX : IsAlgebraicSpace B (⊤_ Scheme.{u}) hZ X) (hY : IsAlgebraicSpace B (⊤_ Scheme.{u}) hZ Y)
    (hfin : IsFinite B (⊤_ Scheme.{u}) hZ f)
    (hfp : IsFinitePresentation B (⊤_ Scheme.{u}) hZ f)
    (hsurj : IsSurjective B (⊤_ Scheme.{u}) hZ f)
    (haff : IsAffineSpace B (⊤_ Scheme.{u}) hZ X) :
    IsAffineSpace B (⊤_ Scheme.{u}) hZ Y := by
  obtain ⟨hYqc, hYsep⟩ := isQuasiCompactSpace_and_isAbsolutelySeparated_of_isFinite_of_isSurjective
    B hZ (⊤_ Scheme.{u}) hZ f hX hY hsurj hfin haff
  -- Stacks 07SU, with the chapter's convention on the system.
  obtain ⟨A₀, a₀, -, ha₀s, ha₀e⟩ :=
    (isQuasiCompactSpace_iff_exists_affine_etale_surjective_cover B (⊤_ Scheme.{u}) hZ Y hY).mp hYqc
  obtain ⟨A, hconv⟩ := hasConventionalNoetherianApproximation_of_etaleAtlas hY hYqc
    (isAbsolutelyQuasiSeparated_of_isAbsolutelySeparated B (⊤_ Scheme.{u}) hZ hZ Y hYsep)
    A₀ a₀ ha₀s ha₀e
  let := A.preorder
  let := A.nonempty
  let := A.isDirected
  have hD : ∀ j, IsAlgebraicSpace B (⊤_ Scheme.{u}) hZ (A.diagram.obj j) := A.isAlgebraicSpace
  have hQc := A.isQuasiCompactSpace_obj
  have hQs : ∀ j, IsAbsolutelyQuasiSeparated B (⊤_ Scheme.{u}) hZ hZ (A.diagram.obj j) :=
    A.isAbsolutelyQuasiSeparated
  have hAff : ∀ {j j' : A.Iᵒᵖ} (g : j ⟶ j'), IsAffineHom B (⊤_ Scheme.{u}) hZ (A.diagram.map g) :=
    fun g => A.isAffineHom_map g
  let e : Y ≅ limit A.diagram := A.isLimit.conePointUniqueUpToIso (limit.isLimit A.diagram)
  have hlim : IsAlgebraicSpace B (⊤_ Scheme.{u}) hZ (limit A.diagram) :=
    IsAlgebraicSpace.of_iso hY e
  have hfp' : IsFinitePresentation B (⊤_ Scheme.{u}) hZ (f ≫ e.hom) :=
    isFinitePresentation_of_arrowIso B _ hZ f (f ≫ e.hom) (𝟙 X) e.hom (by simp) hfp
  -- Stacks 07SK: `f` descends to a stage.
  obtain ⟨i, X₀, hX₀, hX₀fp, ⟨eX⟩⟩ :=
    exists_model_of_finitePresentation_of_siteContainsBaseChangeLimits B (⊤_ Scheme.{u}) hZ hZ
      A.diagram hD hAff hQc hQs hconv hlim (Over.mk (f ≫ e.hom)) hX hfp'
  -- The situation of Stacks 084W for `X₀ ⟶ Y_i`.
  let M : MorphismDescentSituation B (⊤_ Scheme.{u}) hZ hZ A.I :=
    { base := A.diagram
      base_isAlgebraicSpace := fun k => hD (op k)
      transition_affine := fun g => hAff g
      limit_isAlgebraicSpace := hlim
      initial := i.unop
      source₀ := X₀.left
      target₀ := A.diagram.obj i
      sourceToBase := X₀.hom
      targetToBase := 𝟙 _
      map₀ := X₀.hom
      map₀_over := Category.comp_id _
      source₀_isAlgebraicSpace := hX₀
      target₀_isAlgebraicSpace := hD i
      base₀_quasiCompact := hQc i
      base₀_quasiSeparated := hQs i
      source₀_quasiCompact :=
        isQuasiCompactSpace_of_isFinitePresentation B (⊤_ Scheme.{u}) hZ X₀.hom (hD i) (hQc i)
          hX₀fp
      source₀_quasiSeparated :=
        isAbsolutelyQuasiSeparated_of_isQuasiSeparated B (⊤_ Scheme.{u}) hZ hZ hX₀ (hQs i)
          hX₀fp.2.2
      target₀_quasiCompact := hQc i
      target₀_quasiSeparated := hQs i }
  -- The base change of `X₀ ⟶ Y_i` to the limit is `f`, up to isomorphism.
  let α : M.sourceLimit ≅ X :=
    pullbackSymmetry (limit.π A.diagram i) X₀.hom ≪≫ (Over.forget _).mapIso eX.symm
  have hfst := isIso_pullback_fst_id (limit.π M.base (op M.initial))
  let β : M.targetLimit ≅ Y :=
    @asIso _ _ _ _ (pullback.fst (limit.π M.base (op M.initial)) (𝟙 _)) hfst ≪≫ e.symm
  have hsq : M.mapLimit = α.hom ≫ f ≫ β.inv := by
    rw [← cancel_mono β.hom]
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [← cancel_mono e.hom]
    have h1 : M.mapLimit ≫ β.hom ≫ e.hom = pullback.fst (limit.π A.diagram i) X₀.hom := by
      simp only [β, Iso.trans_hom, Iso.symm_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]
      exact M.mapLimit_fst
    have h2 : eX.inv.left ≫ f ≫ e.hom = pullback.snd X₀.hom (limit.π A.diagram i) := Over.w eX.inv
    simp only [Category.assoc] at h1 ⊢
    rw [h1]
    show _ = (pullbackSymmetry (limit.π A.diagram i) X₀.hom).hom ≫ eX.inv.left ≫ f ≫ e.hom
    rw [h2, pullbackSymmetry_hom_comp_snd]
  have hfinLim : IsFinite B (⊤_ Scheme.{u}) hZ M.mapLimit := by
    rw [hsq]
    exact isFinite_comp B _ hZ (isFinite_of_isIso B _ hZ α.hom)
      (isFinite_comp B _ hZ hfin (isFinite_of_isIso B _ hZ β.inv))
  have hsurjLim : IsSurjective B (⊤_ Scheme.{u}) hZ M.mapLimit := by
    rw [hsq]
    exact isSurjective_comp B _ hZ (isSurjective_of_isIso B _ hZ α.hom)
      (isSurjective_comp B _ hZ hsurj (isSurjective_of_isIso B _ hZ β.inv))
  have hlft : IsLocallyOfFiniteType B (⊤_ Scheme.{u}) hZ M.map₀ :=
    isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B _ hZ hX₀fp.1
  -- Stacks 084Z, 07SN and 07SQ.
  obtain ⟨i₁, hi₁, hfin₁⟩ :=
    M.exists_isFinite_mapAt_of_siteContainsBaseChangeLimits hconv hfinLim hlft
  obtain ⟨i₂, hi₂, hsurj₂⟩ :=
    MorphismDescentSituation.exists_isSurjective_mapAt_of_siteContainsBaseChangeLimits M hconv
      hsurjLim hX₀fp.1
  have hconvS : SiteContainsBaseChangeLimits B (⊤_ Scheme.{u}) hZ
      (M.stagesSourceDescentSituation).system :=
    (hconv.comp_subtypeGe i.unop).baseChangeOverSystem _ _
  obtain ⟨k, -, hkaff⟩ :=
    (M.stagesSourceDescentSituation).exists_isAffineSpace_system_obj_of_siteContainsBaseChangeLimits
      hconvS (IsAffineSpace.of_iso haff α.symm)
  obtain ⟨m₁, h₁, h₂⟩ := exists_ge_ge i₁ i₂
  obtain ⟨m, h₃, h₄⟩ := exists_ge_ge m₁ k.1
  have hm : M.initial ≤ m := hi₁.trans (h₁.trans h₃)
  have hfinm : IsFinite B (⊤_ Scheme.{u}) hZ (M.mapAt m hm) :=
    M.isFinite_mapAt_of_le hi₁ (h₁.trans h₃) hfin₁
  have hsurjm : IsSurjective B (⊤_ Scheme.{u}) hZ (M.mapAt m hm) :=
    M.isSurjective_mapAt_of_le hi₂ (h₂.trans h₃) hsurj₂
  have hsrcm : IsAffineSpace B (⊤_ Scheme.{u}) hZ (M.sourceAt m hm) :=
    ((M.stagesSourceDescentSituation).transition_affine
      (homOfLE (show k ≤ ⟨m, hm⟩ from h₄)).op).isAffineSpace_source hkaff
  -- Stacks 07VP for the stage `Y_m`.
  have hfstm := isIso_pullback_fst_id (M.baseAtToInitial m hm)
  let g := M.mapAt m hm ≫ pullback.fst (M.baseAtToInitial m hm) (𝟙 M.target₀)
  have hstage : IsAffineSpace B (⊤_ Scheme.{u}) hZ (A.diagram.obj (op m)) :=
    isAffineSpace_of_isFinite_of_isSurjective B (⊤_ Scheme.{u}) hZ hZ
      ⟨A.diagram.obj (op m), hD _⟩ ⟨M.sourceAt m hm, M.sourceAt_isAlgebraicSpace m hm⟩
      (ObjectProperty.homMk g)
      (isFinite_comp B _ hZ hfinm (@isFinite_of_isIso B _ hZ _ _ _ hfstm))
      (isSurjective_comp B _ hZ hsurjm (@isSurjective_of_isIso B _ hZ _ _ _ hfstm))
      hsrcm (A.isNoetherian_obj B hZ (op m))
  -- `Y` is affine over the stage `Y_m`.
  have hπ : IsAffineHom B (⊤_ Scheme.{u}) hZ (limit.π A.diagram (op m)) :=
    isAffineHom_limitπ_of_siteContainsBaseChangeLimits B (⊤_ Scheme.{u}) hZ A.diagram hconv hAff
      (op m)
  exact IsAffineSpace.of_iso (hπ.isAffineSpace_source hstage) e.symm

end Terminal

/-! ### Arbitrary base, and Stacks 07VS -/

section Base

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Stacks 07VS for a morphism of finite presentation.** Let `f : X ⟶ Y` be a finite surjective
morphism of finite presentation of algebraic spaces over `S`, with `X` affine. Then `Y` is affine.

Viewed over `Spec ℤ` (Stacks 03I5), the morphism keeps all of its properties, and affineness is
unchanged, so this is
`AlgebraicGeometry.Space.isAffineSpace_of_isFinite_of_isFinitePresentation_of_isTerminal`. -/
theorem isAffineSpace_of_isFinite_of_isFinitePresentation_of_isSurjective
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Y)
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y)
    (hfin : IsFinite B S hS f) (hfp : IsFinitePresentation B S hS f)
    (hsurj : IsSurjective B S hS f) (haff : IsAffineSpace B S hS X) :
    IsAffineSpace B S hS Y := by
  have hZ : B.Contains (⊤_ Scheme.{u}) := B.contains_terminal
  let k := integersMap B S hS hZ
  have hX' := isAlgebraicSpace_relocalize B (B.obj hS) (B.obj hZ) k X hX
  have hY' := isAlgebraicSpace_relocalize B (B.obj hS) (B.obj hZ) k Y hY
  exact (isAffineSpace_viewOverIntegers_iff B S hS hZ (F := Y)).1 <|
    isAffineSpace_of_isFinite_of_isFinitePresentation_of_isTerminal B hZ
    ((OverShriek.relocalizePresheafFunctor k).map f) hX' hY'
    (isFinite_relocalize B S hS hZ k hX hY hfin)
    ⟨(Space.holdsOnEveryEtaleChart_relocalizeMap_iff B S (⊤_ Scheme.{u}) hS hZ k _ f).2 hfp.1,
      (isQuasiCompact_relocalize_iff B S hS (⊤_ Scheme.{u}) hZ k f).2 hfp.2.1,
      Space.isQuasiSeparated_relocalizeMap B S (⊤_ Scheme.{u}) hS hZ k hX hY f hfp.2.2⟩
    (isSurjective_relocalize B S hS (⊤_ Scheme.{u}) hZ k f hsurj)
    ((isAffineSpace_viewOverIntegers_iff B S hS hZ (F := X)).2 haff)

/-- **Stacks 07VS.** Let `S` be a scheme and let `f : X ⟶ Y` be a morphism of algebraic spaces
over `S`. Assume that `f` is surjective and finite, and that `X` is affine. Then `Y` is affine.

The proof is the source's. `Y` is separated by Stacks 05Z2 and quasi-compact, `X` being so. By
Stacks 07VR, `X` is the limit of a directed system of algebraic spaces `X_a`, finite and of finite
presentation over `Y`, with closed immersions as transition morphisms; such a system satisfies the
chapter's convention (tag 07SD), its transition morphisms being monomorphisms, so by Stacks 07SQ
some `X_a` is affine. As `f` factors through `X_a ⟶ Y`, the latter is surjective, and the case of a
morphism of finite presentation,
`AlgebraicGeometry.Space.isAffineSpace_of_isFinite_of_isFinitePresentation_of_isSurjective`, which
runs through Stacks 07SU, 07SK, 084Z, 07SN, 07SQ and 07VP, concludes. -/
theorem isAffineSpace_target_of_isFinite_of_isSurjective
    {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Y)
    (hX : IsAlgebraicSpace B S hS X) (hY : IsAlgebraicSpace B S hS Y)
    (hsurj : IsSurjective B S hS f) (hfin : IsFinite B S hS f)
    (haff : IsAffineSpace B S hS X) :
    IsAffineSpace B S hS Y := by
  have hZ : B.Contains (⊤_ Scheme.{u}) := B.contains_terminal
  obtain ⟨hYqc, hYsep⟩ := isQuasiCompactSpace_and_isAbsolutelySeparated_of_isFinite_of_isSurjective
    B hZ S hS f hX hY hsurj hfin haff
  have hYqs := isAbsolutelyQuasiSeparated_of_isAbsolutelySeparated B S hS hZ Y hYsep
  -- Stacks 07VR.
  obtain ⟨p, hp⟩ := exists_integralFiniteSystem_of_isFinite B S hS f hX hY hfin hYqc hYqs
  let : Preorder p.indexType := p.indexPreorder
  let : Nonempty p.indexType := p.indexNonempty
  let : IsDirected p.indexType (· ≤ ·) := p.indexDirected
  have htransition : ∀ {i j : p.indexTypeᵒᵖ} (g : i ⟶ j),
      IsAffineHom B S hS (p.diagram.map g) := by
    intro i j g
    have hsep : IsSeparated B S hS (p.structureMap.app j) :=
      isSeparated_of_isFinite B S hS (p.structureMap.app j) (p.stageAlgebraicSpace j) hY
        (p.stageFinite j)
    have hfin' : IsFinite B S hS (p.diagram.map g ≫ p.structureMap.app j) := by
      rw [p.structureMap.naturality g]
      simpa using p.stageFinite i
    exact IsFinite.isAffineHom
      (isFinite_of_comp_of_isSeparated B S hS (p.diagram.map g) (p.structureMap.app j) hfin' hsep)
  let D : DescentSituation B S hS hZ p.indexType :=
    { system := p.diagram
      algebraicSpace := fun i ↦ p.stageAlgebraicSpace (op i)
      transition_affine := htransition
      quasiCompact := fun i ↦
        isQuasiCompactSpace_of_isFinitePresentation B S hS
          (p.structureMap.app (op i)) hY hYqc (p.stageFinitePresentation (op i))
      quasiSeparated := fun i ↦
        isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ
          (p.stageAlgebraicSpace (op i)) hYqs (p.stageFinitePresentation (op i)).2.2
      limitCone := Cone.mk X p.limitCone
      isLimit := p.isLimit
      limitAlgebraicSpace := hX
      base := Classical.choice p.indexNonempty }
  -- The system of Stacks 07VR has monomorphic transition morphisms, so it satisfies the
  -- chapter's convention, and Stacks 07SQ gives an affine stage.
  have hmono : ∀ ⦃i j : p.indexTypeᵒᵖ⦄ (g : i ⟶ j), Mono (D.system.map g) := fun i j g ↦ by
    rw [Subsingleton.elim g (homOfLE (leOfHom g.unop)).op]
    exact mono_of_isClosedImmersion B S hS _ (hp _ _ _)
  obtain ⟨i, -, hstageAffine⟩ := D.exists_isAffineSpace_system_obj_of_siteContainsBaseChangeLimits
    (IsSiteSmall.siteContainsBaseChangeLimits B S hS D.system (IsSiteSmall.of_mono hmono)) haff
  have hstageSurj : IsSurjective B S hS (p.structureMap.app (op i)) := by
    intro y
    obtain ⟨x, hx⟩ := hsurj y
    refine ⟨pointsMap B S hS X (p.limitCone.app (op i)) x, ?_⟩
    rwa [← Function.comp_apply (f := pointsMap B S hS _ (p.structureMap.app (op i))),
      ← pointsMap_comp, ← p.compatible (op i)]
  exact isAffineSpace_of_isFinite_of_isFinitePresentation_of_isSurjective B S hS
    (p.structureMap.app (op i)) (p.stageAlgebraicSpace (op i)) hY (p.stageFinite (op i))
    (p.stageFinitePresentation (op i)) hstageSurj hstageAffine

end Base

end AlgebraicGeometry.Space

