-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace Stacks.SheafOfModules

/-- A sheaf of modules which is a coproduct of one copy of the structure sheaf is generated by
one global section. -/
theorem exists_generatingSections_equiv_fin_one_of_isColimit {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    {M : _root_.SheafOfModules.{w} R} (ι : ∀ _ : Fin 1, _root_.SheafOfModules.unit R ⟶ M)
    (hι : IsColimit (Cofan.mk M ι)) :
    ∃ σ : M.GeneratingSections, Nonempty (σ.I ≃ Fin 1) := by
  let φ : _root_.SheafOfModules.free (R := R) (ULift.{w} (Fin 1)) ⟶ M :=
    M.freeHomEquiv.symm (fun j => M.unitHomEquiv (ι j.down))
  have hfac (j : ULift.{w} (Fin 1)) :
      (_root_.SheafOfModules.freeCofan (R := R) (ULift.{w} (Fin 1))).inj j ≫ φ = ι j.down := by
    apply M.unitHomEquiv.injective
    change M.freeHomEquiv φ j = M.unitHomEquiv (ι j.down)
    simp [φ]
  have hEpi : Epi φ := by
    constructor
    intro N g₁ g₂ h
    refine hι.hom_ext fun j => ?_
    have hh := congrArg (fun k =>
      (_root_.SheafOfModules.freeCofan (R := R) (ULift.{w} (Fin 1))).inj
        (ULift.up j.as) ≫ k) h
    change ((_root_.SheafOfModules.freeCofan (R := R) (ULift.{w} (Fin 1))).inj
      (ULift.up j.as) ≫ φ) ≫ g₁ =
      ((_root_.SheafOfModules.freeCofan (R := R) (ULift.{w} (Fin 1))).inj
        (ULift.up j.as) ≫ φ) ≫ g₂ at hh
    rwa [hfac (ULift.up j.as)] at hh
  exact ⟨(_root_.SheafOfModules.free.generatingSections (R := R)
    (ULift.{w} (Fin 1))).ofEpi φ, ⟨Equiv.ulift⟩⟩

end Stacks.SheafOfModules

namespace AlgebraicGeometry.RingedSite

/-- A sheaf of modules of rank one on a ringed site is locally generated by one section. -/
theorem IsFiniteLocallyFreeOfRank.isLocallyGeneratedByOnSite_one
    {X : RingedSite.{u, v, w}} {F : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)}
    [∀ U : X.C, HasWeakSheafify (X.J.over U) AddCommGrpCat.{w}]
    [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (hF : IsFiniteLocallyFreeOfRank X F 1) :
    SheafOfModules.IsLocallyGeneratedByOnSite F 1 := by
  intro U
  obtain ⟨I, V, f, hf, hfree⟩ := hF U
  refine ⟨⟨Sieve.ofArrows V f, hf⟩, fun W g hg => ?_⟩
  obtain ⟨i, a, rfl⟩ := (Sieve.mem_ofArrows_iff V f g).mp hg
  obtain ⟨ι, hι⟩ := hfree i
  obtain ⟨σ, hσ⟩ :=
    Stacks.SheafOfModules.exists_generatingSections_equiv_fin_one_of_isColimit ι hι.some
  exact ⟨Stacks.SheafOfModules.generatingSectionsOverMap F a σ, hσ⟩

end AlgebraicGeometry.RingedSite

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- An effective Cartier divisor is a locally principal closed subspace. -/
theorem isLocallyPrincipal_of_isEffectiveCartierDivisor (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (hD : IsEffectiveCartierDivisor B S hS X D) :
    IsLocallyPrincipal B S hS X D :=
  RingedSite.IsFiniteLocallyFreeOfRank.isLocallyGeneratedByOnSite_one
    (isFiniteLocallyFreeOfRank_one_definingIdealSheaf B S hS X D hD)

/-- Let `D ⊆ X` be an effective Cartier divisor on an algebraic space `X` over a scheme `S`. Then
the inclusion of the open complement `X ∖ D` into `X` is an affine morphism. -/
@[stacks 083S "the complement is affine over the ambient algebraic space"]
theorem isAffineHom_ι_openComplement_of_isEffectiveCartierDivisor (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (hD : IsEffectiveCartierDivisor B S hS X D) :
    IsAffineHom B S hS (openComplement B S hS D.1).ι :=
  isAffineHom_ι_openComplement B S hS X D
    (isLocallyPrincipal_of_isEffectiveCartierDivisor B S hS X D hD)

/-- On a scheme chart `q` of `X` the image of the morphism of schemes representing
`(X ∖ D) ×_X A` is the set-theoretic complement of the image of the base change
`D ×_X A ⟶ A`. -/
theorem range_snd_openComplement (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1)
    (hU : IsOpenImmersion B S hS (openComplement B S hS D.1).ι)
    {A : BigFppfOver B S hS} (q : yoneda.obj A ⟶ X.1) :
    Set.range ((BigFppfOver.toScheme B S hS).map (hU.rep.snd q)) =
      (Set.range ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd q)))ᶜ := by
  rw [range_snd_eq_image_preimage_range_pointsMap B S hS
    (openComplement B S hS D.1).ι hU q, range_pointsMap_ι_openComplement B S hS D.1]
  refine Set.ext fun y => ⟨?_, fun hy => ?_⟩
  · rintro ⟨w, hw, rfl⟩
    exact fun hy => hw ((mem_range_pointsMap_ι_iff B S hS X D q w).2 hy)
  · obtain ⟨w, rfl⟩ := surjective_pointsToScheme B S hS A y
    exact ⟨w, fun hw => hy ((mem_range_pointsMap_ι_iff B S hS X D q w).1 hw), rfl⟩

/-- Let `D ⊆ X` be an effective Cartier divisor on an algebraic space `X` over a scheme `S`. Then
the open complement `X ∖ D` is scheme-theoretically dense in `X`. -/
@[stacks 083S "the complement is scheme theoretically dense in the ambient algebraic space"]
theorem isSchemeTheoreticallyDense_openComplement_of_isEffectiveCartierDivisor
    (X : AlgebraicSpaces B S hS) (D : ClosedSubspaces B S hS X.1)
    (hD : IsEffectiveCartierDivisor B S hS X D) :
    IsSchemeTheoreticallyDense B S hS (openComplement B S hS D.1) := by
  have hU : IsOpenImmersion B S hS (openComplement B S hS D.1).ι :=
    (isOpenSubspace_openComplement B S hS X.2 D.1 D.2).2
  rw [isSchemeTheoreticallyDense_iff_forall_chart_mono_c B S hS _ hU]
  intro V
  have hclosed : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)) :=
    D.2.2.property_snd V.1.hom
  have hopen : _root_.AlgebraicGeometry.IsOpenImmersion
      ((BigFppfOver.toScheme B S hS).map (hU.rep.snd V.1.hom)) :=
    hU.property_snd V.1.hom
  have hI : Stacks.Divisors.IsEffectiveCartierDivisor
      ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)).ker :=
    (isSchemeEffectiveCartierPullback_iff B S hS X D V.1.left V.1.hom).1
      (hasEffectiveCartierEtalePullbacks_of_isEffectiveCartier B S hS X D hD V.1.left
        V.1.hom (isEtale_of_presheaf_etale B S hS V.2))
  have hsupport : (((BigFppfOver.toScheme B S hS).map
      (D.2.2.rep.snd V.1.hom)).ker.support : Set _) =
      Set.range ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)) := by
    have hcl : IsClosed (Set.range ((BigFppfOver.toScheme B S hS).map
        (D.2.2.rep.snd V.1.hom))) :=
      (_root_.AlgebraicGeometry.IsClosedImmersion.iff_isPreimmersion.mp hclosed).2
    rw [Scheme.Hom.support_ker, hcl.closure_eq]
  have hrange : ((BigFppfOver.toScheme B S hS).map (hU.rep.snd V.1.hom)).opensRange =
      ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)).ker.support.compl := by
    refine TopologicalSpace.Opens.ext ?_
    rw [Scheme.Hom.coe_opensRange, range_snd_openComplement B S hS X D hU V.1.hom,
      TopologicalSpace.Closeds.coe_compl, hsupport]
  exact (_root_.AlgebraicGeometry.isSchemeTheoreticallyDense_opensRange_iff_mono
    ((BigFppfOver.toScheme B S hS).map (hU.rep.snd V.1.hom))).1
    (hrange ▸ Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor _ hI)

end AlgebraicGeometry.Space

end
