universe u

/-- If an injective `ι : P →ₗ[R] R` has range `J` and stays injective after `lTensor T`, then
`J.subtype` stays injective after `rTensor T`. -/
private theorem Submodule.injective_rTensor_subtype_of_range_eq {R T P : Type*}
    [CommRing R] [AddCommGroup T] [Module R T] [AddCommGroup P] [Module R P] {J : Ideal R}
    (ι : P →ₗ[R] R)
    (hι : Function.Injective ι) (hrange : LinearMap.range ι = J)
    (hinj : Function.Injective (LinearMap.lTensor T ι)) :
    Function.Injective (LinearMap.rTensor T J.subtype) := by
  let e : P ≃ₗ[R] J := (LinearEquiv.ofInjective ι hι).trans (LinearEquiv.ofEq _ _ hrange)
  have he : J.subtype ∘ₗ e.toLinearMap = ι := LinearMap.ext fun _ => rfl
  have h2 : LinearMap.lTensor T J.subtype =
      LinearMap.lTensor T ι ∘ₗ LinearMap.lTensor T e.symm.toLinearMap := by
    rw [← LinearMap.lTensor_comp, ← he, LinearMap.comp_assoc, LinearEquiv.comp_coe,
      LinearEquiv.symm_trans_self, LinearEquiv.refl_toLinearMap, LinearMap.comp_id]
  refine (LinearMap.lTensor_inj_iff_rTensor_inj _ _).1 ?_
  rw [h2]
  exact hinj.comp (LinearEquiv.lTensor T e.symm).injective

/-- **The commutative algebra of (2) ⟹ (1) of Stacks 063Y, with the conormal module given
abstractly.**  In the commuting square of ring maps `α : R ⟶ T`, `qR : R ⟶ A`, `qT : T ⟶ B`,
`dd : A ⟶ B`, let `qR` and `qT` be surjective, the kernel `J` of `qR` square zero, the kernel of
`qT` generated by `α(J)` and `dd` flat.  If an injective `R`-linear `ι : P ⟶ R` with image `J`
stays injective after base change to `T`, then `α` is flat. -/
theorem RingHom.flat_of_injective_lTensor_of_flat_reduction
    {R T A B P : Type u} [CommRing R] [CommRing T] [CommRing A] [CommRing B]
    [AddCommGroup P] [Module R P]
    (α : R →+* T) (qR : R →+* A) (qT : T →+* B) (dd : A →+* B) (hsq : qT.comp α = dd.comp qR)
    (hR : Function.Surjective qR) (hT : Function.Surjective qT) (hflat : dd.Flat)
    (hJ2 : ∀ x y : R, qR x = 0 → qR y = 0 → x * y = 0)
    (hker : ∀ t : T, qT t = 0 → t ∈ Ideal.map α (RingHom.ker qR))
    (ι : P →ₗ[R] R) (hι : Function.Injective ι) (hι0 : ∀ p, qR (ι p) = 0)
    (hιs : ∀ x, qR x = 0 → ∃ p, ι p = x)
    (hinj : letI := α.toAlgebra; Function.Injective (LinearMap.lTensor T ι)) :
    α.Flat := by
  have hJ2' : RingHom.ker qR ^ 2 = ⊥ := by
    rw [pow_two, eq_bot_iff, Ideal.mul_le]
    exact fun x hx y hy => Ideal.mem_bot.2 (hJ2 x y hx hy)
  have hrange : LinearMap.range ι = RingHom.ker qR := by
    ext x
    refine ⟨?_, fun hx => hιs x hx⟩
    rintro ⟨p, rfl⟩
    exact hι0 p
  let : Algebra R T := α.toAlgebra
  let : Algebra R A := qR.toAlgebra
  let : Algebra T B := qT.toAlgebra
  let : Algebra A B := dd.toAlgebra
  let : Algebra R B := (qT.comp α).toAlgebra
  let : IsScalarTower R T B := .of_algebraMap_eq' rfl
  let : IsScalarTower R A B := .of_algebraMap_eq' hsq
  let J : Ideal R := RingHom.ker qR
  have hJA : ∀ x ∈ J, algebraMap R A x = 0 := fun _ hx => RingHom.mem_ker.mp hx
  have hJB : ∀ x ∈ J, algebraMap R B x = 0 := fun x hx => by
    rw [IsScalarTower.algebraMap_apply R A B, hJA x hx, map_zero]
  let : Algebra (R ⧸ J) B := (Ideal.Quotient.lift _ (algebraMap R B) hJB).toAlgebra
  let : Algebra (R ⧸ J) A := (Ideal.Quotient.lift _ (algebraMap R A) hJA).toAlgebra
  let : IsScalarTower R (R ⧸ J) B := .of_algebraMap_eq' rfl
  let : IsScalarTower R (R ⧸ J) A := .of_algebraMap_eq' rfl
  let : IsScalarTower (R ⧸ J) A B := .of_algebraMap_eq' (by
    refine Ideal.Quotient.ringHom_ext ?_
    ext x
    change algebraMap R B x = algebraMap A B (algebraMap R A x)
    exact IsScalarTower.algebraMap_apply R A B x)
  have : Module.Flat (R ⧸ J) A := by
    have e : (R ⧸ J) ≃ₗ[R ⧸ J] A :=
      { RingHom.quotientKerEquivOfSurjective hR with
        map_smul' := fun q p => by
          change RingHom.quotientKerEquivOfSurjective hR (q * p) =
            algebraMap (R ⧸ J) A q * RingHom.quotientKerEquivOfSurjective hR p
          rw [map_mul]
          rfl }
    exact Module.Flat.of_linearEquiv e.symm
  have : Module.Flat A B := hflat
  have hflatQ : Module.Flat (R ⧸ J) B := Module.Flat.trans (R ⧸ J) A B
  have hrt := Submodule.injective_rTensor_subtype_of_range_eq (J := J) ι hι hrange hinj
  have hbij : Function.Bijective (J.tensorSMulHomToKer T B) := by
    refine ⟨fun z w h => (J.injective_tensorSMulHom_iff T).2 hrt (congrArg Subtype.val h), ?_⟩
    rintro ⟨y, hy⟩
    have hy' : y ∈ J • (⊤ : Submodule R T) := by
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
      exact hker y hy
    rw [← J.range_tensorSMulHom T] at hy'
    obtain ⟨z, rfl⟩ := hy'
    exact ⟨z, rfl⟩
  exact ((J.bijective_tensorSMulHomToKer_iff T B hJ2' hT hflatQ).1 hbij).1

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X' Y' : AlgebraicSpaces B S hS} (g : X' ⟶ Y') (Y : ClosedSubspaces B S hS Y'.1)

private theorem mul_eq_zero_of_mem_definingIdealAt_of_thickening
    (hY : IsFirstOrderThickening B S hS Y' Y.1) {U : (SmallEtale B S hS Y'.1)ᵒᵖ}
    {u v : (structureRingSheaf B S hS Y').obj.obj U} (hu : u ∈ definingIdealAt B S hS Y' Y U)
    (hv : v ∈ definingIdealAt B S hS Y' Y U) : u * v = 0 := by
  have h := hY.2 U.unop
  rw [Submodule.pow_succ, Submodule.pow_one] at h
  exact (Submodule.eq_bot_iff _).mp h _ (Ideal.mul_mem_mul hu hv)

/-- Over an affine étale chart `V` of `W`, the base change of a closed subspace `Z` is affine, its
chart restriction is surjective, and its kernel is the defining ideal of `Z`. -/
private theorem isAffine_surjective_mem_ker_iff_definingIdealAt
    {W : AlgebraicSpaces B S hS} (Z : ClosedSubspaces B S hS W.1) (V : SmallEtale B S hS W.1)
    (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)) :
    IsAffine ((BigFppfOver.toScheme B S hS).obj (Z.2.2.rep.pullback V.1.hom)) ∧
      Function.Surjective (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
        (Z.2.2.rep.snd V.1.hom)).op).hom ∧
      ∀ x, (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom)).op).hom x = 0 ↔
        x ∈ definingIdealAt B S hS W Z (op V) := by
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom)) := Z.2.2.property_snd _
  refine ⟨isAffine_representablePullback B S hS (subspaceInclusion B S hS W Z) Z.2.2.rep V hci hV,
    (_root_.AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine
      ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd V.1.hom))).2, fun x => ?_⟩
  rw [definingIdealAt_eq_ker B S hS W Z V]
  rfl

/-- **On an affine chart diagram the image of a square-zero ideal kills the pullback of that
ideal.**  For a diagram `d` of affine étale charts over `g` and a first-order thickening
`Y ⊆ Y'`, every element of the ideal of `Γ(d.U)` generated by the image of `J = 𝓘_Y(d.V)`
annihilates the sections of `g^*𝓘_Y` over `d.U`.

Those sections are `Γ(d.U) ⊗_{Γ(d.V)} J` by the chart bijectivity of Stacks 083K, and
`g^♯(j) · (b ⊗ s) = b ⊗ j s = 0` because `J² = 0`. -/
theorem smul_modulePullback_definingIdealSheaf_eq_zero_of_chartDiagram
    (hY : IsFirstOrderThickening B S hS Y' Y.1) (d : ChartDiagram B S hS X'.1 Y'.1 g.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V))
    (a : chartRing B S hS X'.1 X'.2 d.U)
    (ha : a ∈ Ideal.map (chartDiagramRestrict B S hS g d) (definingIdealAt B S hS Y' Y (op d.V)))
    (m : ((modulePullback B S hS g).obj (definingIdealSheaf B S hS Y' Y).toSheafOfModules).val.obj
      (op d.U)) :
    a • m = 0 := by
  let M := (definingIdealSheaf B S hS Y' Y).toSheafOfModules
  let := chartDiagramAlgebra B S hS g d
  have hb := bijective_modulePullbackChartBaseChange_of_isQuasicoherentOnSite B S hS g M
    (isQuasicoherentOnSite_definingIdealSheaf B S hS Y' Y) d hU hV
  obtain ⟨z, rfl⟩ := hb.2 m
  have key : ∀ j : chartRing B S hS Y'.1 Y'.2 d.V, j ∈ definingIdealAt B S hS Y' Y (op d.V) →
      chartDiagramRestrict B S hS g d j • z = 0 := by
    intro j hj
    induction z using TensorProduct.inductionOn with
    | tmul b s =>
      have hjb : chartDiagramRestrict B S hS g d j • b = j • b := rfl
      rw [TensorProduct.smul_tmul', hjb, TensorProduct.smul_tmul]
      have hs : j • s = 0 :=
        Subtype.ext (mul_eq_zero_of_mem_definingIdealAt_of_thickening B S hS Y hY hj s.2)
      rw [hs, TensorProduct.tmul_zero]
    | add x y hx hy => rw [smul_add, hx, hy, add_zero]
  rw [← LinearMap.map_smul]
  suffices h0 : a • z = 0 by rw [h0, map_zero]
  refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
  · rintro _ ⟨j, hj, rfl⟩
    exact key j hj
  · exact zero_smul _ _
  · intro x y _ _ hx hy
    rw [add_smul, hx, hy, add_zero]
  · intro c x _ hx
    rw [smul_eq_mul, mul_smul, hx, smul_zero]

/-- **The defining ideal of `g⁻¹(Y)` annihilates `g^*𝓘_Y`** when `Y ⊆ Y'` is a first-order
thickening.  The affine chart diagrams over `g` cover the small étale site of `X'`
(`AlgebraicGeometry.Space.mem_topology_of_hasAffineChartDiagram`); on each of them the defining
ideal of `g⁻¹(Y)` is generated by the image of `𝓘_Y`
(`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map_chartDiagram`) and
`AlgebraicGeometry.Space.smul_modulePullback_definingIdealSheaf_eq_zero_of_chartDiagram` applies;
`g^*𝓘_Y` is a sheaf, hence separated. -/
theorem annihilatedByKerIdeal_modulePullback_definingIdealSheaf
    (hY : IsFirstOrderThickening B S hS Y' Y.1) :
    AnnihilatedByKerIdeal B S hS (subspaceInclusion B S hS X' (preimageSubspace B S hS g Y))
      ((modulePullback B S hS g).obj (definingIdealSheaf B S hS Y' Y).toSheafOfModules) := by
  intro U a ha m
  have ha' : a ∈ definingIdealAt B S hS X' (preimageSubspace B S hS g Y) U :=
    (SheafOfModules.mem_kerIdeal _ U a).1 ha
  let N := (modulePullback B S hS g).obj (definingIdealSheaf B S hS Y' Y).toSheafOfModules
  let R : Presieve U.unop := fun W _ => HasAffineChartDiagram B S hS g W
  have hmem : Sieve.generate R ∈ SmallEtale.topology B S hS X'.1 U.unop :=
    mem_topology_of_hasAffineChartDiagram B S hS g U.unop (Sieve.generate R)
      (fun W k hW => Sieve.le_generate R W k hW)
  refine N.isSheaf.isSeparated U.unop (Sieve.generate R) hmem _ 0 ?_
  rintro W' k ⟨W, h, k', hk', rfl⟩
  obtain ⟨hWaff, V, q, hq, hVaff⟩ := hk'
  let d : ChartDiagram B S hS X'.1 Y'.1 g.hom := ⟨W, V, q, hq.symm⟩
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.1.left) := hVaff
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj d.U.1.left) := hWaff
  have hres : (structureRingSheaf B S hS X').obj.map k'.op a ∈
      Ideal.map (chartDiagramRestrict B S hS g d) (definingIdealAt B S hS Y' Y (op d.V)) := by
    have h1 : (structureRingSheaf B S hS X').obj.map k'.op a ∈
        definingIdealAt B S hS X' (preimageSubspace B S hS g Y) (op d.U) :=
      definingIdealAt_map B S hS X' _ k'.op a ha'
    rwa [definingIdealAt_preimage_eq_map_chartDiagram B S hS g Y d] at h1
  have hz := smul_modulePullback_definingIdealSheaf_eq_zero_of_chartDiagram B S hS g Y hY d
    hWaff hVaff _ hres (N.val.map k'.op m)
  have e' := (PresheafOfModules.map_smul N.val k'.op a m).trans hz
  change N.val.map (h ≫ k').op _ = N.val.map (h ≫ k').op 0
  rw [map_zero]
  have hc : ∀ x, N.val.map (h ≫ k').op x = N.val.map h.op (N.val.map k'.op x) :=
    fun x => PresheafOfModules.map_comp_apply N.val k'.op h.op x
  refine (hc _).trans ?_
  exact (congrArg (N.val.map h.op) e').trans (map_zero _)

/-- **A monomorphism `g^*a` is injective on chart sections before pullback, after base change.**
For a morphism `a : M ⟶ M'` of `𝒪_{Y'}`-modules with `M` quasi-coherent and `g^*a` a
monomorphism, the base change `Γ(d.U) ⊗_{Γ(d.V)} M(d.V) ⟶ Γ(d.U) ⊗_{Γ(d.V)} M'(d.V)` of `a` on
sections is injective over every diagram `d` of affine étale charts over `g`.

The chart comparison of Stacks 083K is natural in the module
(`AlgebraicGeometry.Space.modulePullbackChartBaseChange_map`) and bijective at `M`
(`AlgebraicGeometry.Space.bijective_modulePullbackChartBaseChange_of_isQuasicoherentOnSite`), and
`g^*a` is injective on sections. -/
theorem injective_lTensor_of_mono_modulePullback_map
    {M M' : Modules.{u, u} B S hS Y'.1 Y'.2} (a : M ⟶ M') (hM : M.IsQuasicoherentOnSite)
    (hmono : Mono ((modulePullback B S hS g).map a))
    (d : ChartDiagram B S hS X'.1 Y'.1 g.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V)) :
    letI := chartDiagramAlgebra B S hS g d
    Function.Injective (LinearMap.lTensor (chartRing B S hS X'.1 X'.2 d.U)
      (a.val.app (op d.V)).hom) := by
  let := chartDiagramAlgebra B S hS g d
  have hc := bijective_modulePullbackChartBaseChange_of_isQuasicoherentOnSite B S hS g M hM d hU hV
  have hψ := injective_val_app_of_mono B S hS ((modulePullback B S hS g).map a) (op d.U)
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro z hz
  have hn := modulePullbackChartBaseChange_map B S hS g a d z
  rw [hz, map_zero] at hn
  have h1 : modulePullbackChartBaseChange B S hS g M d z = 0 :=
    hψ (hn.trans (map_zero _).symm)
  exact hc.1 (h1.trans (map_zero _).symm)

/-- **Flatness of a morphism of algebraic spaces from its affine chart diagrams.**  If pullback
of regular functions is flat along every diagram of étale scheme charts over `g` whose two charts
are affine, then `g` is flat. -/
theorem isFlat_of_flat_chartDiagramRestrict
    (h : ∀ d : ChartDiagram B S hS X'.1 Y'.1 g.hom,
      IsAffine ((SmallEtale.toOver B S hS X'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U) →
      IsAffine ((SmallEtale.toOver B S hS Y'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V) →
        RingHom.Flat (chartDiagramRestrict B S hS g d)) :
    IsFlat B S hS g.hom := by
  intro U V a b k ha hb hcomm
  let d0 : ChartDiagram B S hS X'.1 Y'.1 g.hom :=
    ⟨⟨CostructuredArrow.mk a, ha⟩, ⟨CostructuredArrow.mk b, hb⟩, k, hcomm.symm⟩
  rw [HasRingHomProperty.iff_appLE (P := @_root_.AlgebraicGeometry.Flat.{u})]
  intro P O e
  let d1 := d0.restrictOpens O.1 P.1 e
  have h1 := h d1 O.2 P.2
  rw [chartDiagramRestrict_eq_appTop] at h1
  change RingHom.Flat ((BigFppfOver.toScheme B S hS).map (openSubMap k O.1 P.1 e)).appTop.hom at h1
  rw [toScheme_map_openSubMap] at h1
  exact (RingHom.Flat.respectsIso.arrow_mk_iso_iff
    (arrowResLEAppIso ((BigFppfOver.toScheme B S hS).map k) P.1 O.1 e)).mp h1

/-- **Flatness of `g` on an affine chart diagram.**  Let `Y ⊆ Y'` be a first-order thickening,
let the projection `g⁻¹(Y) ⟶ Y` be flat and let the inverse image along `g` of the inclusion
`𝓘_Y ⟶ 𝒪_{Y'}` be a monomorphism.  Then pullback of regular functions is flat along every
diagram of affine étale scheme charts over `g`. -/
theorem flat_chartDiagramRestrict_of_mono
    (hY : IsFirstOrderThickening B S hS Y' Y.1)
    (hf : IsFlat B S hS (preimageProjection B S hS g Y).hom)
    (hmono : Mono ((modulePullback B S hS g).map (definingIdealSheaf B S hS Y' Y).ι))
    (d : ChartDiagram B S hS X'.1 Y'.1 g.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y'.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V)) :
    RingHom.Flat (chartDiagramRestrict B S hS g d) := by
  let T := BigFppfOver.toScheme B S hS
  let P := preimageSubspace B S hS g Y
  let iY := subspaceInclusion B S hS Y' Y
  let iP := subspaceInclusion B S hS X' P
  let hrY : yoneda.relativelyRepresentable iY.hom := Y.2.2.rep
  let hrP : yoneda.relativelyRepresentable iP.hom := P.2.2.rep
  let VY := (smallBaseChange B S hS iY hrY).obj d.V
  let UP := (smallBaseChange B S hS iP hrP).obj d.U
  let dY : ChartDiagram B S hS (⟨Y.1.toFunctor, Y.2.1⟩ : AlgebraicSpaces B S hS).1 Y'.1 iY.hom :=
    ⟨VY, d.V, hrY.snd d.V.1.hom, hrY.w d.V.1.hom⟩
  let dP : ChartDiagram B S hS (⟨P.1.toFunctor, P.2.1⟩ : AlgebraicSpaces B S hS).1 X'.1 iP.hom :=
    ⟨UP, d.U, hrP.snd d.U.1.hom, hrP.w d.U.1.hom⟩
  have hw : (hrP.fst d.U.1.hom ≫ (preimageProjection B S hS g Y).hom) ≫ iY.hom =
      yoneda.map (hrP.snd d.U.1.hom ≫ d.g) ≫ d.V.1.hom := by
    have e1 : iP.hom ≫ g.hom = (preimageProjection B S hS g Y).hom ≫ iY.hom :=
      congrArg (fun m => m.hom) (conormalEtaleRestrictionSquare B S hS g Y)
    rw [Category.assoc, ← e1, ← Category.assoc, hrP.w d.U.1.hom, Category.assoc,
      d.comm, Functor.map_comp, Category.assoc]
  let q := hrY.lift (hrP.fst d.U.1.hom ≫ (preimageProjection B S hS g Y).hom)
    (hrP.snd d.U.1.hom ≫ d.g) hw
  let df : ChartDiagram B S hS (⟨P.1.toFunctor, P.2.1⟩ : AlgebraicSpaces B S hS).1
      (⟨Y.1.toFunctor, Y.2.1⟩ : AlgebraicSpaces B S hS).1 (preimageProjection B S hS g Y).hom :=
    ⟨UP, VY, q, (hrY.lift_fst _ _ hw).symm⟩
  have : IsAffine (T.obj d.V.1.left) := hV
  have : IsAffine (T.obj d.U.1.left) := hU
  let α := chartDiagramRestrict B S hS g d
  let qR := chartDiagramRestrict B S hS iY dY
  let qT := chartDiagramRestrict B S hS iP dP
  let dd := chartDiagramRestrict B S hS (preimageProjection B S hS g Y) df
  obtain ⟨hVY, hR, hmemY⟩ := isAffine_surjective_mem_ker_iff_definingIdealAt B S hS Y d.V hV
  obtain ⟨hUP, hT, hmemP⟩ := isAffine_surjective_mem_ker_iff_definingIdealAt B S hS P d.U hU
  have hmemP' : ∀ t : chartRing B S hS X'.1 X'.2 d.U,
      qT t = 0 ↔ t ∈ definingIdealAt B S hS X' P (op d.U) := hmemP
  have key : hrP.snd d.U.1.hom ≫ d.g = q ≫ hrY.snd d.V.1.hom := (hrY.lift_snd _ _ hw).symm
  have hsq : qT.comp α = dd.comp qR := by
    ext x
    have hc : Scheme.Γ.map (T.map d.g).op ≫ Scheme.Γ.map (T.map (hrP.snd d.U.1.hom)).op =
        Scheme.Γ.map (T.map (hrY.snd d.V.1.hom)).op ≫ Scheme.Γ.map (T.map q).op := by
      rw [← Scheme.Γ.map_comp, ← Scheme.Γ.map_comp, ← op_comp, ← op_comp, ← T.map_comp,
        ← T.map_comp, key]
    exact ConcreteCategory.congr_hom hc x
  have hflat : dd.Flat := flat_chartDiagramRestrict_of_isFlat B S hS hf df hUP hVY
  have hJ2 : ∀ x y : chartRing B S hS Y'.1 Y'.2 d.V, qR x = 0 → qR y = 0 → x * y = 0 :=
    fun x y hx hy => mul_eq_zero_of_mem_definingIdealAt_of_thickening B S hS Y hY
      ((hmemY x).1 hx) ((hmemY y).1 hy)
  have hker : ∀ t, qT t = 0 → t ∈ Ideal.map α (RingHom.ker qR) := by
    intro t ht
    have h1 := (hmemP' t).1 ht
    rw [definingIdealAt_preimage_eq_map_chartDiagram B S hS g Y d] at h1
    exact Ideal.map_mono (fun j hj => RingHom.mem_ker.2 ((hmemY j).2 hj)) h1
  let ιM : ((definingIdealSheaf B S hS Y' Y).toSheafOfModules : Modules.{u, u} B S hS Y'.1 Y'.2) ⟶
      SheafOfModules.unit (structureRingSheaf B S hS Y') := (definingIdealSheaf B S hS Y' Y).ι
  have hinj := injective_lTensor_of_mono_modulePullback_map B S hS g ιM
    (isQuasicoherentOnSite_definingIdealSheaf B S hS Y' Y) hmono d hU hV
  let : Module (chartRing B S hS Y'.1 Y'.2 d.V)
      ((definingIdealSheaf B S hS Y' Y).toSheafOfModules.val.obj (op d.V)) :=
    ((definingIdealSheaf B S hS Y' Y).toSheafOfModules.val.obj (op d.V)).isModule
  exact RingHom.flat_of_injective_lTensor_of_flat_reduction α qR qT dd hsq hR hT hflat hJ2 hker
    (ιM.val.app (op d.V)).hom
    (@injective_val_app_of_mono B S hS _ _ _ _ ιM
      (inferInstanceAs (Mono (definingIdealSheaf B S hS Y' Y).ι)) (op d.V))
    (fun p => (hmemY _).2 p.2) (fun x hx => ⟨⟨x, (hmemY x).1 hx⟩, rfl⟩) hinj

end AlgebraicGeometry.Space

