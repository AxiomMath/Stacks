module

public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleDescentIdealMembership
public import StacksFrontier.AlgebraicGeometry.Spaces.InvertibleChartSections
public import StacksFrontier.AlgebraicGeometry.Spaces.ZeroSchemeIdealSheaf
public import StacksFrontier.AlgebraicGeometry.Topologies.BaseIdealMultiple

/-!
# Étale descent of membership in the evaluation ideal of a section of an invertible module

Let `X` be an algebraic space, `ℒ` an invertible `𝒪_X`-module and `s` a global section of `ℒ`.
A regular function on an *affine* étale chart `U` which lies in the family of ideals generated
by the evaluation ideals after restriction along the members of some étale covering of `U`
already lies in the evaluation ideal `sectionEvaluationIdealAt … U` itself.

This is the analogue, for the evaluation ideal of Stacks 0845, of
`AlgebraicGeometry.Space.mem_vanishingIdealAt_of_mem_topology`, which says the same for the
ideal generated by finitely many *global* regular functions.

## Main results

* `AlgebraicGeometry.Space.mem_sectionEvaluationIdealAt_of_mem_topology`: the descent statement.

## Implementation notes

The descent itself is `AlgebraicGeometry.Space.mem_span_of_forall_restrict_mem_span`, whose only
geometric input is the injectivity half of `IsCartesianOnAffineCharts` for the structure sheaf,
the unconditional `AlgebraicGeometry.Space.isCartesianOnAffineCharts_unit`.

That lemma requires a **finite** generating family, and the evaluation ideal is generated by the
values `l(s|_U)` of *all* the functionals on `ℒ(U)`, an index type with no finiteness.  Rather
than prove the ideal finitely generated — which would need `ℒ(U)` projective, hence a flatness
descent — the finite family is extracted from the memberships themselves: the covering sieve is
first refined to a *finite* jointly faithfully flat family of affine charts by
`AlgebraicGeometry.Space.exists_finite_affine_faithfullyFlat_pi_le`, over each member the
restriction lies in the extension of the evaluation ideal of `U` by
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_le_map_of_isInvertible`, and each such
membership is witnessed by a finite linear combination.  The functionals occurring in those
finitely many combinations form the finite family, and the span of their values at `s|_U` is
contained in the evaluation ideal of `U` term by term.

It is the containment `sectionEvaluationIdealAt … V ≤ Ideal.map (chartRestrict f)
(sectionEvaluationIdealAt … U)` that makes this work: without it the restriction is only known
to land in the evaluation ideal of the smaller chart, which is not an extension of anything over
`U` and so descends nothing.

No declaration here carries `@[stacks 0845]` or `@[stacks 0846]`, and no part of either tag is
claimed.

## References

* [Stacks Project, Tag 0845](https://stacks.math.columbia.edu/tag/0845)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Étale descent of membership in the evaluation ideal of a section of an invertible
module.** -/
theorem mem_sectionEvaluationIdealAt_of_mem_topology (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    {U : SmallEtale B S hS X.1}
    (hU : IsAffine
      ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U))
    {Tv : Sieve U} (hTv : Tv ∈ SmallEtale.topology B S hS X.1 U)
    {x : ToType ((structureRingSheaf B S hS X).obj.obj (op U))}
    (hx : ∀ ⦃V : SmallEtale B S hS X.1⦄ (h : V ⟶ U), Tv h →
      (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map h.op x ∈
        (sectionEvaluationSubmodule B S hS X L s).obj (op V)) :
    x ∈ sectionEvaluationIdealAt B S hS X L s U := by
  classical
  obtain ⟨n, z, φ, hzaff, hzT, hff⟩ :=
    exists_finite_affine_faithfullyFlat_pi_le B S hS X.1 X.2 hU hTv
  -- Over each member of the refinement, the restriction lies in the extension from `U`.
  have hstep : ∀ i, (SheafOfModules.unit (structureRingSheaf B S hS X)).val.map (φ i).op x ∈
      Ideal.map (chartRestrict (hF := X.2) (φ i)) (sectionEvaluationIdealAt B S hS X L s U) := by
    intro i
    have h1 := hx (φ i) (hzT i)
    rw [sectionEvaluationSubmodule_obj_eq_of_isInvertible B S hS X L s hL (z i) (hzaff i)] at h1
    exact sectionEvaluationIdealAt_le_map_of_isInvertible B S hS X L s hL (φ i) hU (hzaff i) h1
  -- Each membership is a finite combination of images of members of the evaluation ideal.
  choose m c a ha hsum using fun i =>
    Ideal.exists_sum_of_mem_map (A := chartRing B S hS X.1 X.2 U)
      (T := chartRing B S hS X.1 X.2 (z i)) (chartRestrict (hF := X.2) (φ i))
      (sectionEvaluationIdealAt B S hS X L s U) (hstep i)
  let τ : (Σ i : Fin n, Fin (m i)) → chartRing B S hS X.1 X.2 U := fun k => a k.1 k.2
  have hmem : ∀ i, chartRestrictLinear (SheafOfModules.unit (structureRingSheaf B S hS X))
      (φ i) x ∈ Submodule.span (chartRing B S hS X.1 X.2 (z i))
        (Set.range fun k : Σ i : Fin n, Fin (m i) => chartRestrictLinear
          (SheafOfModules.unit (structureRingSheaf B S hS X)) (φ i) (τ k)) := by
    intro i
    have hgoal : chartRestrictLinear (SheafOfModules.unit (structureRingSheaf B S hS X)) (φ i) x
        = ∑ j, c i j * chartRestrict (hF := X.2) (φ i) (a i j) := (hsum i).symm
    rw [hgoal]
    refine Submodule.sum_mem _ fun j _ => ?_
    have hj : c i j * chartRestrict (hF := X.2) (φ i) (a i j) =
        c i j • chartRestrictLinear (SheafOfModules.unit (structureRingSheaf B S hS X))
          (φ i) (τ ⟨i, j⟩) := rfl
    rw [hj]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨i, j⟩, rfl⟩)
  have hspan := mem_span_of_forall_restrict_mem_span
    (SheafOfModules.unit (structureRingSheaf B S hS X)) isCartesianOnAffineCharts_unit hU φ
    hzaff hff τ hmem
  refine Submodule.span_le.2 ?_ hspan
  rintro _ ⟨k, rfl⟩
  exact ha k.1 k.2

/-! ### The sheaf of ideals, and the closed subspace it cuts out -/

/-- **The sheaf of ideals of Stacks 0845 IS the local closure of the evaluation family.**

`AlgebraicGeometry.Space.sectionEvaluationIdeal` of
`StacksFrontier/AlgebraicGeometry/Spaces/ZeroSchemeQuasicoherentIdeal.lean` is defined as the `sInf`
of the sheaf submodules lying above the evaluation family, and the local closure is the least such
submodule, so the two agree.  Both inclusions are the Galois pair
`Stacks.SheafOfModules.le_localClosure` and `Stacks.SheafOfModules.localClosure_le`.

Everything below is therefore stated about `sectionEvaluationIdeal`, with no second definition
of the same object. -/
theorem sectionEvaluationIdeal_eq_localClosure (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) :
    sectionEvaluationIdeal B S hS X L s =
      Stacks.SheafOfModules.localClosure _ (sectionEvaluationSubmodule B S hS X L s) :=
  le_antisymm (sInf_le (Stacks.SheafOfModules.le_localClosure _))
    (le_sInf fun _ hN => Stacks.SheafOfModules.localClosure_le hN)

/-- **Over an affine étale chart the sections of that sheaf of ideals are the evaluation
ideal.**  One containment is the étale descent above; the other is unconditional. -/
theorem sectionEvaluationIdealSheaf_obj_of_isAffine (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine
      ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (sectionEvaluationIdeal B S hS X L s).obj (op U) =
      sectionEvaluationIdealAt B S hS X L s U := by
  rw [sectionEvaluationIdeal_eq_localClosure]
  exact le_antisymm
    (fun _ hy => mem_sectionEvaluationIdealAt_of_mem_topology B S hS X L s hL hU hy
      fun _ _ => id)
    (fun _ hy => (sectionEvaluationSubmodule B S hS X L s).toSubfunctor.le_sheafify
      (SmallEtale.topology B S hS X.1) (op U)
      (sectionEvaluationIdealAt_le_sectionEvaluationSubmodule_obj B S hS X L s U hU hy))

/-- **The base change comparison of that sheaf of ideals is surjective over every morphism of
étale charts whose source is affine.**

Over the smaller chart its sections are the evaluation ideal there, and that ideal is *generated*
by the restrictions of the evaluation ideal of the larger chart — which is
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_le_map_of_isInvertible`, and is exactly what the
analogous statement for finitely many global functions gets for free from the sections being
global.  So the comparison hits a generating family. -/
theorem surjective_sectionsBaseChange_sectionEvaluationIdealSheaf (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    {U V : SmallEtale B S hS X.1}
    (hU : IsAffine
      ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U))
    (hV : IsAffine
      ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    (φ : V ⟶ U) :
    Function.Surjective
      (sectionsBaseChange (sectionEvaluationIdeal B S hS X L s).toSheafOfModules φ) := by
  classical
  let _ := chartAlgebra (hF := X.2) φ
  set I := sectionEvaluationIdeal B S hS X L s with hI
  have hmemU : ∀ b ∈ sectionEvaluationIdealAt B S hS X L s U, b ∈ I.obj (op U) := fun b hb => by
    rwa [hI, sectionEvaluationIdealSheaf_obj_of_isAffine B S hS X L s hL U hU]
  let Q : Ideal (chartRing B S hS X.1 X.2 V) :=
    { carrier := {b | ∃ w, ((sectionsBaseChange I.toSheafOfModules φ w).1 :
        chartRing B S hS X.1 X.2 V) = b}
      zero_mem' := ⟨0, by rw [map_zero]; rfl⟩
      add_mem' := fun {x y} hx hy => by
        obtain ⟨wx, hwx⟩ := hx
        obtain ⟨wy, hwy⟩ := hy
        refine ⟨wx + wy, ?_⟩
        rw [map_add]
        exact congrArg₂ (· + ·) hwx hwy
      smul_mem' := fun cc x hx => by
        obtain ⟨w, hw⟩ := hx
        refine ⟨cc • w, ?_⟩
        rw [map_smul]
        exact congrArg (fun b => cc * b) hw }
  have hgen : ∀ b : chartRing B S hS X.1 X.2 V, b ∈ I.obj (op V) → b ∈ Q := by
    intro b hb
    rw [hI, sectionEvaluationIdealSheaf_obj_of_isAffine B S hS X L s hL V hV] at hb
    obtain ⟨mm, cc, aa, haa, hsum⟩ :=
      Ideal.exists_sum_of_mem_map (A := chartRing B S hS X.1 X.2 U)
        (T := chartRing B S hS X.1 X.2 V) (chartRestrict (hF := X.2) φ)
        (sectionEvaluationIdealAt B S hS X L s U)
        (sectionEvaluationIdealAt_le_map_of_isInvertible B S hS X L s hL φ hU hV hb)
    rw [← hsum]
    refine Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ ?_
    refine ⟨TensorProduct.tmul _ (1 : chartRing B S hS X.1 X.2 V)
      (⟨aa j, hmemU (aa j) (haa j)⟩ : I.toSheafOfModules.val.obj (op U)), ?_⟩
    exact congrArg (fun w : I.toSheafOfModules.val.obj (op V) =>
      (w.1 : chartRing B S hS X.1 X.2 V))
      (chartBaseChange_one_tmul I.toSheafOfModules φ _)
  intro y
  obtain ⟨w, hw⟩ := hgen (y.1 : chartRing B S hS X.1 X.2 V) y.2
  exact ⟨w, Subtype.ext hw⟩

/-- **That sheaf of ideals is cartesian on affine charts.**  For a sheaf of ideals of `𝒪_X` the
injectivity half of the comparison is unconditional, so the surjectivity above suffices. -/
theorem isCartesianOnAffineCharts_sectionEvaluationIdealSheaf (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L) :
    IsCartesianOnAffineCharts
      (sectionEvaluationIdeal B S hS X L s).toSheafOfModules :=
  isCartesianOnAffineCharts_submodule_unit_of_surjective B S hS X _
    fun _ _ hU hV φ =>
      surjective_sectionsBaseChange_sectionEvaluationIdealSheaf B S hS X L s hL hU hV φ

/-- **That sheaf of ideals is quasi-coherent**, by Descent, Proposition 03DX(2). -/
theorem isQuasicoherentOnSite_sectionEvaluationIdealSheaf (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L) :
    (sectionEvaluationIdeal B S hS X L s).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_sectionEvaluationIdealSheaf B S hS X L s hL)

/-! ### The étale-local description of the zero scheme -/

/-- **The defining ideal of the zero scheme of a global section of an invertible module is the
evaluation ideal, on every affine étale chart**, with no hypothesis.

This is the identification that `StacksFrontier/AlgebraicGeometry/Spaces/ZeroSchemeProperties.lean`
carries as the hypothesis `h` of every one of its assertions, and
`StacksFrontier/AlgebraicGeometry/Spaces/ZeroSchemeQuasicoherentIdeal.lean` reduced to two
statements about one named object.  Both are now discharged, so each of those assertions holds
for an invertible `ℒ` with `h` supplied rather than assumed. -/
theorem definingIdealAt_zeroScheme_eq_of_isInvertible (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1) :
    definingIdealAt B S hS X (zeroScheme B S hS X L s) (op U) =
      sectionEvaluationIdealAt B S hS X L s U := by
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hL
  exact definingIdealAt_zeroScheme_eq B S hS X L s Z hZ U hU

/-- **The zero scheme of a global section of an invertible module is the closed subspace cut out
by the evaluation ideal.**  Unconditional form of
`AlgebraicGeometry.Space.exists_zeroSchemeSubfunctor_eq_sectionEvaluationIdeal`. -/
theorem exists_zeroSchemeSubfunctor_eq_of_isInvertible (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L) :
    ∃ Z : ClosedSubspaces B S hS X.1, zeroSchemeSubfunctor B S hS X L s = Z.1 ∧
      ∀ U : SmallEtale B S hS X.1,
        IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
        definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U := by
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hL
  exact ⟨Z, zeroSchemeSubfunctor_eq B S hS X L s Z hZ, hZ⟩

end AlgebraicGeometry.Space

end
