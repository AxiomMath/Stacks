module

public import StacksFrontier.AlgebraicGeometry.Spaces.Coverings
public import StacksFrontier.AlgebraicGeometry.Spaces.SurjectiveOnPoints
public import StacksFrontier.AlgebraicGeometry.Spaces.TestSchemeFpqcSite

/-!
# Covering sieves of test schemes contain surjective families

Let `Y` be an algebraic space over a scheme `S` of a big fppf site.  The test schemes over `Y`
carry the fpqc topology `AlgebraicGeometry.Space.fpqcTopology`, the topology generated by the
families of test schemes whose underlying families of morphisms of schemes cover for the fpqc
topology on schemes.  This file extracts from an arbitrary covering sieve of that topology an
indexed family of its own arrows which is already surjective, both on the points of the
underlying schemes and on the points of Stacks 03BU of the algebraic spaces the test schemes
represent.

## Main results

* `AlgebraicGeometry.Space.exists_mem_arrows_of_mem_fpqcTopology`: every point of the scheme
  underlying a test scheme `T` over `Y` is the image of a point of the source of some arrow of
  a covering sieve of `T`.
* `AlgebraicGeometry.Space.exists_jointlySurjective_family_of_mem_fpqcTopology`: a covering
  sieve of a test scheme `T` over `Y` contains an indexed family of arrows whose images under
  `AlgebraicGeometry.schemeSpaceFunctor` are jointly surjective on points.

## Implementation notes

The fpqc topology on the test schemes is generated by a precoverage, so the proof is an
induction over `CategoryTheory.Precoverage.Saturate`, the inductive description of the sieves
of the generated topology.  Surjectivity onto the points of the underlying scheme is the
convenient form for that induction, for the following reasons.

*Generators.*  A family of test schemes covers when its underlying family of schemes lies in
`AlgebraicGeometry.Scheme.fpqcPrecoverage`, and such a family is jointly surjective by
definition.

*Pullback stability.*  Given an arrow `g : A ⟶ T` of the sieve through a point and a morphism
`f : T' ⟶ T` of test schemes, the fibre product of `g` and `f` in the big fppf site, equipped
with the structure morphism inherited from `T'`, is again a test scheme over `Y`, its two
projections are morphisms of test schemes, and the one to `T'` lies in the pulled back sieve
because the other factors `g`.  A point of `T'` and a point of `A` with the same image in `T`
are the images of a point of the fibre product, because the forgetful functor to schemes
preserves fibre products and a fibre product of schemes surjects onto the pairs of points with
a common image.

*Local character.*  Arrows through a point compose.

Joint surjectivity on the points of the represented algebraic spaces is then
`AlgebraicGeometry.Space.jointlySurjective_yoneda_of_scheme`, which is clause (1) of
Stacks 03BX in family form, applied to the family indexed by the points of the underlying
scheme of `T` obtained by choice.

## References

* [Stacks Project, Tag 03BU](https://stacks.math.columbia.edu/tag/03BU)
* [Stacks Project, Tag 03BX](https://stacks.math.columbia.edu/tag/03BX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A point of the target of a cartesian square of schemes and a point of its source with the
same image in the common base are the images of a point of the fibre product. -/
private theorem exists_preimage_snd_of_isPullback {P A A' X : Scheme.{u}} {p₁ : P ⟶ A}
    {p₂ : P ⟶ A'} {f : A ⟶ X} {f' : A' ⟶ X} (sq : IsPullback p₁ p₂ f f')
    (a : A) (a' : A') (h : f a = f' a') : ∃ p : P, p₂ p = a' := by
  obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback a a' h
  refine ⟨sq.isoPullback.inv z, ?_⟩
  rwa [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_snd]

/-- Every point of the scheme underlying a test scheme over `Y` is the image of a point of the
source of some arrow of a sieve saturated for the fpqc precoverage on the test schemes.

This is the inductive step-by-step form of
`AlgebraicGeometry.Space.exists_mem_arrows_of_mem_fpqcTopology`. -/
private theorem exists_mem_arrows_of_saturate {Y : AlgebraicSpaces B S hS}
    {T : SchemesOver Y} {R : Sieve T}
    (hR : (Scheme.fpqcPrecoverage.comap (testSchemeFunctor Y)).Saturate T R) :
    ∀ x : (testSchemeFunctor Y).obj T,
      ∃ (T' : SchemesOver Y) (g : T' ⟶ T), R.arrows g ∧
        ∃ t : (testSchemeFunctor Y).obj T', (testSchemeFunctor Y).map g t = x := by
  induction hR with
  | of X P hP =>
    intro x
    obtain ⟨ι, C, c, rfl⟩ := P.exists_eq_ofArrows
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hP
    obtain ⟨i, t, ht⟩ := ((Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).mp
      (Scheme.propQCPrecoverage_le_precoverage (P := @Flat) _ hP)).1 x
    exact ⟨C i, c i, Sieve.le_generate _ _ _ (Presieve.ofArrows.mk i), t, ht⟩
  | top X => exact fun x ↦ ⟨X, 𝟙 X, trivial, x, by simp⟩
  | pullback X V _ T' f ih =>
    intro x
    obtain ⟨A, g, hg, t, ht⟩ := ih ((testSchemeFunctor Y).map f x)
    have _ : PreservesLimitsOfShape WalkingCospan (BigFppfOver.toScheme B S hS) := by
      apply comp_preservesLimitsOfShape
    have hcond : pullback.fst g.left f.left ≫ g.left =
        pullback.snd g.left f.left ≫ f.left := pullback.condition
    let P : SchemesOver Y := CostructuredArrow.mk
      ((schemeSpaceFunctor B S hS).map (pullback.snd g.left f.left) ≫ T'.hom)
    let q₂ : P ⟶ T' := CostructuredArrow.homMk (pullback.snd g.left f.left) rfl
    let q₁ : P ⟶ A := CostructuredArrow.homMk (pullback.fst g.left f.left) (by
      change (schemeSpaceFunctor B S hS).map (pullback.fst g.left f.left) ≫ A.hom =
        (schemeSpaceFunctor B S hS).map (pullback.snd g.left f.left) ≫ T'.hom
      rw [← CostructuredArrow.w g, ← CostructuredArrow.w f, ← Category.assoc,
        ← Category.assoc, ← Functor.map_comp, ← Functor.map_comp, hcond])
    have hfac : q₂ ≫ f = q₁ ≫ g := CostructuredArrow.hom_ext _ _ hcond.symm
    refine ⟨P, q₂, ?_, exists_preimage_snd_of_isPullback
      ((IsPullback.of_hasPullback g.left f.left).map (BigFppfOver.toScheme B S hS)) t x ht⟩
    change V.arrows (q₂ ≫ f)
    rw [hfac]
    exact V.downward_closed hg q₁
  | transitive X V W _ _ ihV ihW =>
    intro x
    obtain ⟨A, g, hg, t, ht⟩ := ihV x
    obtain ⟨A', h, hh, s, hs⟩ := ihW hg t
    refine ⟨A', h ≫ g, hh, s, ?_⟩
    rw [Functor.map_comp, Scheme.Hom.comp_apply, hs, ht]

/-- **Every point of a test scheme is covered by an arrow of a covering sieve.** If `R` is a
covering sieve of a test scheme `T` over an algebraic space `Y` for the fpqc topology on the
test schemes, then every point of the scheme underlying `T` is the image of a point of the
scheme underlying the source of some arrow of `R`. -/
theorem exists_mem_arrows_of_mem_fpqcTopology {Y : AlgebraicSpaces B S hS}
    {T : SchemesOver Y} {R : Sieve T} (hR : R ∈ fpqcTopology Y T)
    (x : (testSchemeFunctor Y).obj T) :
    ∃ (T' : SchemesOver Y) (g : T' ⟶ T), R.arrows g ∧
      ∃ t : (testSchemeFunctor Y).obj T', (testSchemeFunctor Y).map g t = x :=
  exists_mem_arrows_of_saturate B S hS (Precoverage.mem_toGrothendieck_iff.mp hR) x

/-- **A covering sieve of test schemes contains a family which is jointly surjective on
points.** If `R` is a covering sieve of a test scheme `T` over an algebraic space `Y` for the
fpqc topology on the test schemes, then there is a family of arrows of `R` whose images under
`AlgebraicGeometry.schemeSpaceFunctor` are jointly surjective on the points of
Stacks 03BU: every point of the algebraic space represented by `T` is the image of a point of
the algebraic space represented by one of the sources.

The family is indexed by the points of the scheme underlying `T`, one arrow being chosen
through each of them. -/
theorem exists_jointlySurjective_family_of_mem_fpqcTopology {Y : AlgebraicSpaces B S hS}
    {T : SchemesOver Y} {R : Sieve T} (hR : R ∈ fpqcTopology Y T) :
    ∃ (I : Type u) (T' : I → SchemesOver Y) (g : ∀ i, T' i ⟶ T), (∀ i, R.arrows (g i)) ∧
      IsJointlySurjective B S hS (fun i ↦ (schemeSpace (T' i).left).1)
        (fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom) := by
  choose T' g hg t ht using exists_mem_arrows_of_mem_fpqcTopology B S hS hR
  exact ⟨(testSchemeFunctor Y).obj T, T', g, hg,
    jointlySurjective_yoneda_of_scheme B S hS (fun i ↦ (T' i).left) (fun i ↦ (g i).left)
      fun x ↦ ⟨x, t x, ht x⟩⟩

end AlgebraicGeometry.Space

end
