module

public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.AffineExtension
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.Geometry
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.Glue
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.LiftSections
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasicoherentDerivedEtaleLocal
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.SurjectiveFinitePresentationSystem
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ModuleTypesUnderEquivalence

/-!
# The square step of the dévissage for Stacks 07V9

Let `(U ⊆ W, f : V ⟶ W)` be an elementary distinguished square of algebraic spaces with `V`
affine, `U` quasi-compact and `W` quasi-separated.  If every quasi-coherent module on `U` is
locally generated by modules of finite presentation, then so is every quasi-coherent module on
`W`.  This is the inductive step of the proof of Stacks 07V9 by the induction principle of
Stacks 08GP, along the route that Stacks itself indicates before Lemma 07V9 (deduce it from the
filtration of Decent Spaces, Lemma 07ST, without absolute Noetherian approximation).

## The argument

A section `s` of `F` over a chart `T` of `W` is treated locally on `T`, over the charts mapping
to `U` and over the charts mapping to `V` (`AlgebraicGeometry.Space.edsSieve_mem`).

* Over a chart of `U`, the hypothesis on `U` produces a module of finite presentation `G_U` on
  `U` mapping to `F|_U` through which `s` lifts locally.  It is extended to `W`: its restriction
  to the intersection `P = U ×_W V`, an open subspace of the affine `V`, extends to a module `H`
  of finite presentation on `V` mapping to `F|_V`
  (`AlgebraicGeometry.Space.exists_isFinitePresentation_extension_of_isAffineSpace`), and `G_U`
  and `H` are glued across the square
  (`AlgebraicGeometry.Space.exists_glue_hom_of_isElementaryDistinguishedSquare`).  The glued
  module is of finite presentation because its two restrictions are
  (`AlgebraicGeometry.Space.isFinitePresentation_of_eds`).
* Over a chart of `V`, since `V` is affine, `s` is locally a combination of restrictions of
  global sections of `F|_V` (`AlgebraicGeometry.Space.generatedByGlobalSections_of_isAffineSpace`),
  so it suffices to treat a global section `m` of `F|_V`.  Its restriction to `P` lifts globally
  to a module `G_U` of finite presentation on `U`
  (`AlgebraicGeometry.Space.exists_isFinitePresentation_lift_sections`, on a finite affine
  covering of `P` with affine overlaps), and the same extension and glueing as before, now
  carrying `m` along, produce a module of finite presentation on `W` through which `m` lifts.

## Main results

* `AlgebraicGeometry.Space.exists_extension_of_edsOpen`: extension of a module of finite
  presentation from the open subspace of the square, through a map to `F`.
* `AlgebraicGeometry.Space.exists_lift_of_edsEtale_sections`: a global section of `F|_V` lifts
  to a module of finite presentation on `W` mapping to `F`.
* `AlgebraicGeometry.Space.isLocallyFpGenerated_of_isElementaryDistinguishedSquare`: the square
  step.

## References

* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
* [Stacks Project, Tag 07ST](https://stacks.math.columbia.edu/tag/07ST)
* [Stacks Project, Tag 08GP](https://stacks.math.columbia.edu/tag/08GP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))

section Generic

variable {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hX : IsAlgebraicSpace B S hS X}

/-- The restriction of a section of an `𝒪_X`-module along a morphism of charts, with its type
ascribed as a section over the source chart. -/
abbrev sectRestr (F : Modules.{u, u} B S hS X hX) {T T' : SmallEtale B S hS X} (g : T' ⟶ T)
    (s : F.val.obj (op T)) : F.val.obj (op T') :=
  F.val.map g.op s

/-- Restriction of sections is functorial. -/
theorem sectRestr_comp (F : Modules.{u, u} B S hS X hX) {T T' T'' : SmallEtale B S hS X}
    (g : T' ⟶ T) (g' : T'' ⟶ T') (s : F.val.obj (op T)) :
    sectRestr B S hS F g' (sectRestr B S hS F g s) = sectRestr B S hS F (g' ≫ g) s :=
  (PresheafOfModules.map_comp_apply F.val g.op g'.op s).symm

/-- Restriction along an identity is the identity. -/
theorem sectRestr_id (F : Modules.{u, u} B S hS X hX) {T : SmallEtale B S hS X}
    (s : F.val.obj (op T)) : sectRestr B S hS F (𝟙 T) s = s :=
  PresheafOfModules.map_id_apply F.val _ s

/-- Evaluation of a composite of morphisms of sheaves of modules on a section. -/
theorem fpGen_comp_val_app_apply {M N P : Modules.{u, u} B S hS X hX} (f : M ⟶ N) (g : N ⟶ P)
    (T : SmallEtale B S hS X) (x : M.val.obj (op T)) :
    (f ≫ g).val.app (op T) x = g.val.app (op T) (f.val.app (op T) x) := rfl

/-- A morphism of sheaves of modules sends the zero section to zero. -/
theorem fpGen_val_app_zero {M N : Modules.{u, u} B S hS X hX} (f : M ⟶ N)
    (T : SmallEtale B S hS X) :
    f.val.app (op T) 0 = 0 := map_zero _

/-- An isomorphism carries back the transported global section. -/
theorem hom_app_sectionsMap_inv {M N : Modules.{u, u} B S hS X hX} (e : M ≅ N)
    (s : N.val.sections) (T : SmallEtale B S hS X) :
    e.hom.val.app (op T) ((PresheafOfModules.sectionsMap e.inv.val s).1 (op T)) = s.1 (op T) := by
  change (e.inv ≫ e.hom).val.app (op T) (s.1 (op T)) = s.1 (op T)
  rw [Iso.inv_hom_id]
  rfl

/-- The fp-image sieve of a restricted section is the pullback of the fp-image sieve. -/
theorem fpImageSieve_pullback (F : Modules.{u, u} B S hS X hX) {T T' : SmallEtale B S hS X}
    (g : T' ⟶ T) (s : F.val.obj (op T)) :
    (fpImageSieve B S hS hX F s).pullback g =
      fpImageSieve B S hS hX F (sectRestr B S hS F g s) := by
  ext T'' h
  simp only [Sieve.pullback_apply, fpImageSieve]
  constructor <;> rintro ⟨G, hG, ψ, t, ht⟩ <;> refine ⟨G, hG, ψ, t, ?_⟩
  · rw [ht]
    exact PresheafOfModules.map_comp_apply F.val g.op h.op s
  · rw [ht]
    exact (PresheafOfModules.map_comp_apply F.val g.op h.op s).symm

/-- A section lies in the image of a module of finite presentation mapping to `F`. -/
def InFpImage (F : Modules.{u, u} B S hS X hX) (T : SmallEtale B S hS X)
    (x : F.val.obj (op T)) : Prop :=
  ∃ (G : Modules.{u, u} B S hS X hX) (_ : G.IsFinitePresentation) (ψ : G ⟶ F)
    (t : G.val.obj (op T)), ψ.val.app (op T) t = x

/-- Sections in the image of modules of finite presentation are closed under scalars. -/
theorem inFpImage_smul (F : Modules.{u, u} B S hS X hX) (T : SmallEtale B S hS X)
    (a : (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O).obj.obj
      (op T)) {x : F.val.obj (op T)} (hx : InFpImage B S hS F T x) :
    InFpImage B S hS F T (a • x) := by
  obtain ⟨G, hG, ψ, t, rfl⟩ := hx
  exact ⟨G, hG, ψ, a • t, (ψ.val.app (op T)).hom.map_smul a t⟩

attribute [local instance] abelian_modules_of_algebraicSpace

/-- Sections in the image of modules of finite presentation are closed under addition: use
the direct sum of the two modules. -/
theorem inFpImage_add (F : Modules.{u, u} B S hS X hX) (T : SmallEtale B S hS X)
    {x y : F.val.obj (op T)} (hx : InFpImage B S hS F T x) (hy : InFpImage B S hS F T y) :
    InFpImage B S hS F T (x + y) := by
  obtain ⟨G, hG, ψ, t, rfl⟩ := hx
  obtain ⟨G', hG', ψ', t', rfl⟩ := hy
  refine ⟨G ⊞ G', isFinitePresentation_biprod B S hS hX G G' hG hG', biprod.desc ψ ψ',
    (biprod.inl : G ⟶ G ⊞ G').val.app (op T) t + (biprod.inr : G' ⟶ G ⊞ G').val.app (op T) t',
    ?_⟩
  rw [map_add, ← fpGen_comp_val_app_apply, ← fpGen_comp_val_app_apply, biprod.inl_desc,
    biprod.inr_desc]

/-- Sections in the image of modules of finite presentation are closed under finite sums. -/
theorem inFpImage_sum (F : Modules.{u, u} B S hS X hX) (T : SmallEtale B S hS X) {n : ℕ}
    (x : Fin n → F.val.obj (op T)) (h0 : InFpImage B S hS F T 0)
    (hx : ∀ i, InFpImage B S hS F T (x i)) :
    InFpImage B S hS F T (∑ i, x i) := by
  induction n with
  | zero => simpa using h0
  | succ n ih =>
    rw [Fin.sum_univ_succ]
    exact inFpImage_add B S hS F T (hx 0) (ih (fun i => x i.succ) (fun i => hx i.succ))

/-- A chart over which the restricted section lies in the image of a module of finite
presentation belongs to the fp-image sieve. -/
theorem mem_fpImageSieve_of_inFpImage (F : Modules.{u, u} B S hS X hX)
    {T T' : SmallEtale B S hS X} (s : F.val.obj (op T)) (g : T' ⟶ T)
    (h : InFpImage B S hS F T' (sectRestr B S hS F g s)) : fpImageSieve B S hS hX F s g := h

end Generic

/-- Restriction of a section of an étale pullback along a chart morphism is restriction along the
postcomposed chart morphism. -/
theorem sectRestr_etaleModulePullback {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (M : Modules.{u, u} B S hS X.1 X.2)
    {T T' : SmallEtale B S hS Y.1} (k : T' ⟶ T)
    (x : ((etaleModulePullback.{u, u} B S hS f hf).obj M).val.obj (op T)) :
    sectRestr B S hS ((etaleModulePullback.{u, u} B S hS f hf).obj M) k x =
      sectRestr B S hS M ((smallEtalePostcomp B S hS f hf).map k) x := rfl

section Square

variable {W : AlgebraicSpaces B S hS} {V : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
  {Uo : Subfunctor W.1} {fV : V ⟶ W.1}
  (hsq : IsElementaryDistinguishedSquare B S hS W.2 Uo fV)

/-- Restriction to the open subspace of the square. -/
abbrev rU := etaleModulePullback.{u, u} B S hS (edsOpenHom B S hS hsq)
  (isEtale_edsOpenHom B S hS hsq)

/-- Restriction to the étale member of the square. -/
abbrev rV := etaleModulePullback.{u, u} B S hS (edsEtaleHom B S hS hsq)
  (isEtale_edsEtaleHom B S hS hsq)

/-- Restriction from the open subspace to the intersection. -/
abbrev rFst := etaleModulePullback.{u, u} B S hS (edsFst B S hS hsq) (isEtale_edsFst B S hS hsq)

/-- Restriction from the étale member to the intersection. -/
abbrev rSnd := etaleModulePullback.{u, u} B S hS (edsSnd B S hS hsq) (isEtale_edsSnd B S hS hsq)

/-- The comparison `(F|_U)|_P ≅ (F|_V)|_P` of the two iterated restrictions to the
intersection. -/
abbrev edsInterIso (F : Modules.{u, u} B S hS W.1 W.2) :
    (rFst B S hS hsq).obj ((rU B S hS hsq).obj F) ≅ (rSnd B S hS hsq).obj ((rV B S hS hsq).obj F) :=
  (edsFactorIsoOpen B S hS hsq).app F ≪≫ ((edsFactorIsoEtale B S hS hsq).app F).symm

/-- The zero global section. -/
def zeroSections {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hY : IsAlgebraicSpace B S hS Y}
    (M : Modules.{u, u} B S hS Y hY) : M.val.sections :=
  ⟨fun _ => 0, fun f => map_zero (M.val.map f).hom⟩

/-- A morphism carries the zero global section to the zero global section. -/
theorem sectionsMap_zeroSections {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {hY : IsAlgebraicSpace B S hS Y} {M N : Modules.{u, u} B S hS Y hY} (φ : M ⟶ N) :
    PresheafOfModules.sectionsMap φ.val (zeroSections B S hS M) = zeroSections B S hS N :=
  Subtype.ext (funext fun _ => map_zero _)

/-- The value of the zero global section. -/
theorem zeroSections_apply {Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {hY : IsAlgebraicSpace B S hS Y} (M : Modules.{u, u} B S hS Y hY) (T : SmallEtale B S hS Y) :
    (zeroSections B S hS M).1 (op T) = 0 := rfl

variable (hV : IsAffineSpace B S hS V) (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor)
  (hWqs : IsAbsolutelyQuasiSeparated B S hS hZ W.1)

include hV hUqc hWqs in
/-- The extension, glueing and finite presentation part common to both cases: a module of finite
presentation `G_U` on `U` mapping to `F|_U`, and a global section `m` of `F|_V` whose restriction
to the intersection lifts to a global section `g` of `G_U|_P`, give a module of finite
presentation on `W` mapping to `F`, receiving `G_U` over `U`, through which `m` lifts. -/
theorem exists_glued_of_edsOpen_sections (F : Modules.{u, u} B S hS W.1 W.2)
    (hF : F.IsQuasicoherentOnSite)
    (GU : Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2)
    (hGU : GU.IsFinitePresentation) (ψU : GU ⟶ (rU B S hS hsq).obj F)
    (m : ((rV B S hS hsq).obj F).val.sections)
    (g : ((rFst B S hS hsq).obj GU).val.sections)
    (hg : PresheafOfModules.sectionsMap
      ((rFst B S hS hsq).map ψU ≫ (edsInterIso B S hS hsq F).hom).val g =
        restrictSections B S hS (edsSnd B S hS hsq) (isEtale_edsSnd B S hS hsq) m) :
    ∃ (G : Modules.{u, u} B S hS W.1 W.2) (_ : G.IsFinitePresentation) (ψ : G ⟶ F)
      (αU : GU ⟶ (rU B S hS hsq).obj G) (h : ((rV B S hS hsq).obj G).val.sections),
      αU ≫ (rU B S hS hsq).map ψ = ψU ∧
        PresheafOfModules.sectionsMap ((rV B S hS hsq).map ψ).val h = m := by
  obtain ⟨H, hH, ψV, θ, h, hθ, hh⟩ :=
    exists_isFinitePresentation_extension_of_isAffineSpace B S hS (V := edsEtale B S hS hsq)
      (P := edsInter B S hS hsq) hV (edsSnd B S hS hsq) (isOpenImmersion_edsSnd B S hS hsq)
      (isQuasiCompactSpace_edsInter B S hS hZ hsq hUqc (IsAffineSpace.isQuasiCompactSpace hV)
        hWqs)
      ((rV B S hS hsq).obj F)
      (isQuasicoherentOnSite_etaleModulePullback B S hS _ _ F hF)
      ((rFst B S hS hsq).obj GU)
      (isFinitePresentation_etaleModulePullback B S hS _ _ GU hGU)
      ((rFst B S hS hsq).map ψU ≫ (edsInterIso B S hS hsq F).hom) m g hg
  obtain ⟨G, ψ, αU, αV, hαU, hαV, hU, hV'⟩ :=
    exists_glue_hom_of_isElementaryDistinguishedSquare B S hS hsq F GU H ψU ψV θ (by
      simpa only [Category.assoc, Iso.trans_hom, Iso.symm_hom, Iso.app_inv, Iso.app_hom,
        Iso.inv_hom_id_app, Category.comp_id] using
        congrArg (fun k => k ≫ (edsFactorIsoEtale B S hS hsq).hom.app F) hθ)
  refine ⟨G, ?_, ψ, αU, PresheafOfModules.sectionsMap αV.val h, hU, ?_⟩
  · have := hαU
    have := hαV
    exact isFinitePresentation_of_eds B S hS hsq G
      (Stacks.SheafOfModules.Intrinsic.isFinitePresentation_of_iso (asIso αU) hGU)
      (Stacks.SheafOfModules.Intrinsic.isFinitePresentation_of_iso (asIso αV) hH)
  · rw [← hh, ← hV']
    rfl

include hV hUqc hWqs in
/-- **Extension from the open subspace.**  A module of finite presentation on the open subspace
of the square mapping to `F|_U` is the restriction of a module of finite presentation on `W`
mapping to `F`. -/
theorem exists_extension_of_edsOpen (F : Modules.{u, u} B S hS W.1 W.2)
    (hF : F.IsQuasicoherentOnSite)
    (GU : Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2)
    (hGU : GU.IsFinitePresentation) (ψU : GU ⟶ (rU B S hS hsq).obj F) :
    ∃ (G : Modules.{u, u} B S hS W.1 W.2) (_ : G.IsFinitePresentation) (ψ : G ⟶ F)
      (αU : GU ⟶ (rU B S hS hsq).obj G), αU ≫ (rU B S hS hsq).map ψ = ψU := by
  obtain ⟨G, hG, ψ, αU, -, hU, -⟩ := exists_glued_of_edsOpen_sections B S hS hZ hsq hV hUqc hWqs
    F hF GU hGU ψU (zeroSections B S hS ((rV B S hS hsq).obj F))
    (zeroSections B S hS ((rFst B S hS hsq).obj GU)) (sectionsMap_zeroSections B S hS _)
  exact ⟨G, hG, ψ, αU, hU⟩

include hV hUqc hWqs in
/-- **Lifting a global section of the étale member.**  If every quasi-coherent module on `U` is
locally generated by modules of finite presentation, then every global section of `F|_V` is the
image of a global section of `G|_V` for a module `G` of finite presentation on `W` mapping to
`F`. -/
theorem exists_lift_of_edsEtale_sections
    (hgen : ∀ K : Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2,
      K.IsQuasicoherentOnSite → IsLocallyFpGenerated B S hS (edsOpen B S hS hsq).2 K)
    (F : Modules.{u, u} B S hS W.1 W.2) (hF : F.IsQuasicoherentOnSite)
    (m : ((rV B S hS hsq).obj F).val.sections) :
    ∃ (G : Modules.{u, u} B S hS W.1 W.2) (_ : G.IsFinitePresentation) (ψ : G ⟶ F)
      (h : ((rV B S hS hsq).obj G).val.sections),
      PresheafOfModules.sectionsMap ((rV B S hS hsq).map ψ).val h = m := by
  obtain ⟨C⟩ := nonempty_finiteAffineChartCover_edsInter B S hS hZ hsq hV hUqc hWqs
  let m' := PresheafOfModules.sectionsMap (edsInterIso B S hS hsq F).inv.val
    (restrictSections B S hS (edsSnd B S hS hsq) (isEtale_edsSnd B S hS hsq) m)
  obtain ⟨GU, hGU, ψU, g, hg⟩ :=
    exists_isFinitePresentation_lift_sections B S hS (edsFst B S hS hsq)
      (isEtale_edsFst B S hS hsq) hgen C ((rU B S hS hsq).obj F)
      (isQuasicoherentOnSite_etaleModulePullback B S hS _ _ F hF) m'
  obtain ⟨G, hG, ψ, -, h, -, hh⟩ :=
    exists_glued_of_edsOpen_sections B S hS hZ hsq hV hUqc hWqs F hF GU hGU ψU m g (by
      rw [SheafOfModules.comp_val, PresheafOfModules.sectionsMap_comp, hg,
        ← PresheafOfModules.sectionsMap_comp, ← SheafOfModules.comp_val, Iso.inv_hom_id]
      rfl)
  exact ⟨G, hG, ψ, h, hh⟩

include hV hUqc hWqs in
/-- **The square step of the dévissage for Stacks 07V9.**  Let `(U ⊆ W, f : V ⟶ W)` be an
elementary distinguished square with `V` affine, `U` quasi-compact and `W` quasi-separated.  If
every quasi-coherent module on `U` is locally generated by modules of finite presentation, then
so is every quasi-coherent module on `W`. -/
theorem isLocallyFpGenerated_of_isElementaryDistinguishedSquare
    (hgen : ∀ K : Modules.{u, u} B S hS (edsOpen B S hS hsq).1 (edsOpen B S hS hsq).2,
      K.IsQuasicoherentOnSite → IsLocallyFpGenerated B S hS (edsOpen B S hS hsq).2 K)
    (F : Modules.{u, u} B S hS W.1 W.2) (hF : F.IsQuasicoherentOnSite) :
    IsLocallyFpGenerated B S hS W.2 F := by
  intro T s
  refine GrothendieckTopology.transitive _ (edsSieve_mem B S hS hsq T) _ ?_
  intro T' g hg
  rw [fpImageSieve_pullback]
  -- reduce to a chart postcomposed from `U` or from `V`
  suffices key : ∀ (T₀ : SmallEtale B S hS W.1) (s₀ : F.val.obj (op T₀)),
      ((∃ T₁ : SmallEtale B S hS (edsOpen B S hS hsq).1,
          Nonempty ((smallEtalePostcomp B S hS (edsOpenHom B S hS hsq)
            (isEtale_edsOpenHom B S hS hsq)).obj T₁ ≅ T₀)) ∨
        (∃ T₁ : SmallEtale B S hS (edsEtale B S hS hsq).1,
          Nonempty ((smallEtalePostcomp B S hS (edsEtaleHom B S hS hsq)
            (isEtale_edsEtaleHom B S hS hsq)).obj T₁ ≅ T₀))) →
      fpImageSieve B S hS W.2 F s₀ ∈ SmallEtale.topology B S hS W.1 T₀ by
    apply key
    rcases hg with ⟨T₁, ⟨a⟩⟩ | ⟨T₁, ⟨a⟩⟩
    · exact Or.inl (exists_smallEtalePostcomp_iso B S hS _ _ a)
    · exact Or.inr (exists_smallEtalePostcomp_iso B S hS _ _ a)
  intro T₀ s₀ hT₀
  -- transport along an isomorphism of charts
  have htransport : ∀ {T₂ : SmallEtale B S hS W.1} (e : T₂ ≅ T₀),
      fpImageSieve B S hS W.2 F (sectRestr B S hS F e.hom s₀) ∈
          SmallEtale.topology B S hS W.1 T₂ →
        fpImageSieve B S hS W.2 F s₀ ∈ SmallEtale.topology B S hS W.1 T₀ := by
    intro T₂ e he
    have := GrothendieckTopology.pullback_stable _ e.inv he
    rwa [fpImageSieve_pullback, sectRestr_comp, e.inv_hom_id, sectRestr_id] at this
  rcases hT₀ with ⟨T₁, ⟨e⟩⟩ | ⟨T₁, ⟨e⟩⟩
  · refine htransport e ?_
    set s₂ := sectRestr B S hS F e.hom s₀
    have hR := hgen ((rU B S hS hsq).obj F)
      (isQuasicoherentOnSite_etaleModulePullback B S hS _ _ F hF) T₁ s₂
    refine GrothendieckTopology.superset_covering _ ?_
      (functorPushforward_smallEtalePostcomp_mem B S hS _ _ hR)
    rintro Y _ ⟨Z, k, l, ⟨GU, hGU, ψU, t, ht⟩, rfl⟩
    refine (fpImageSieve B S hS W.2 F s₂).downward_closed ?_ l
    obtain ⟨G, hG, ψ, αU, rfl⟩ :=
      exists_extension_of_edsOpen B S hS hZ hsq hV hUqc hWqs F hF GU hGU ψU
    exact ⟨G, hG, ψ, αU.val.app (op Z) t, ht⟩
  · refine htransport e ?_
    set s₂ := sectRestr B S hS F e.hom s₀
    have hR := generatedByGlobalSections_of_isAffineSpace B S hS (V := edsEtale B S hS hsq) hV
      ((rV B S hS hsq).obj F) (isQuasicoherentOnSite_etaleModulePullback B S hS _ _ F hF) T₁ s₂
    refine GrothendieckTopology.superset_covering _ ?_
      (functorPushforward_smallEtalePostcomp_mem B S hS _ _ hR)
    rintro Y _ ⟨Z, k, l, ⟨n, m, a, hs⟩, rfl⟩
    refine (fpImageSieve B S hS W.2 F s₂).downward_closed ?_ l
    refine mem_fpImageSieve_of_inFpImage B S hS F s₂ _ ?_
    have hs' : sectRestr B S hS F ((smallEtalePostcomp B S hS (edsEtaleHom B S hS hsq)
        (isEtale_edsEtaleHom B S hS hsq)).map k) s₂ = _ :=
      (sectRestr_etaleModulePullback B S hS _ _ F k s₂).symm.trans hs
    rw [hs']
    have hfp : ∀ m' : ((rV B S hS hsq).obj F).val.sections, InFpImage B S hS F
        ((smallEtalePostcomp B S hS (edsEtaleHom B S hS hsq)
          (isEtale_edsEtaleHom B S hS hsq)).obj Z) (m'.1 (op Z)) := fun m' => by
      obtain ⟨G, hG, ψ, h, hh⟩ :=
        exists_lift_of_edsEtale_sections B S hS hZ hsq hV hUqc hWqs hgen F hF m'
      exact ⟨G, hG, ψ, h.1 (op Z), congrArg (fun x => x.1 (op Z)) hh⟩
    exact inFpImage_sum B S hS F _ _ (hfp (zeroSections B S hS _))
      fun i => inFpImage_smul B S hS F _ _ (hfp (m i))

end Square

