module

public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.Basic
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.AssemblyFiniteType
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.AssemblyGenerators
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.SurjectiveFinitePresentationSystem
public import StacksFrontier.AlgebraicGeometry.Spaces.Separated
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasiCompactTopology

/-!
# Filtered colimit presentations from local generation by modules of finite presentation

Let `X` be a quasi-compact and quasi-separated algebraic space over a scheme `S`, all of whose
quasi-coherent modules are locally generated by modules of finite presentation
(`AlgebraicGeometry.Space.IsLocallyFpGenerated`).  This file draws the conclusions of
Stacks 07V9 and Stacks 086Y from that hypothesis.

* `AlgebraicGeometry.Space.exists_isFilteredColimit_isFinitePresentation_of_isLocallyFpGenerated`:
  every quasi-coherent `𝒪_X`-module is a filtered colimit of modules of finite presentation.
  This is `AlgebraicGeometry.Space.exists_isFilteredColimit_isFinitePresentation_essentiallySmall`
  (in `...FinitePresentationGeneration.AssemblyGenerators`): the module is a quotient of the
  direct sum of a small family of modules of finite presentation, written as the filtered colimit
  of its finite partial sums; doing the same for the kernel exhibits the module as the cokernel
  of a map between two such filtered colimits, and the formal half of the proof of Stacks 07UW,
  with Stacks 07U7 for compactness and Stacks 0H98 for the cokernels, concludes.
* `exists_small_isFilteredColimit_isFinitePresentationOnSite_of_isLocallyFpGenerated`:
  the same over a small index category and in the on-site rendering of finite presentation.  The
  index category above is essentially small, the module category being locally small, so it is
  replaced by its small model; Mathlib's finite presentation gives the on-site one by restricting
  presentations (`FpAssembly.isFinitePresentationOnSite_of_isFinitePresentation`).
* `AlgebraicGeometry.Space.exists_directed_isFinitePresentation_epi_of_isLocallyFpGenerated`:
  Stacks 086Y's conclusion.  A finite type quasi-coherent module `M` is a quotient of one module
  `G` of finite presentation (`exists_isFinitePresentation_epi_of_isFiniteTypeOnSite`, in
  `...FinitePresentationGeneration.AssemblyFiniteType`); the kernel of `G ⟶ M` is quasi-coherent,
  hence a filtered colimit of modules `K_a` of finite presentation, and `M` is the directed
  colimit of the cokernels of the maps `K_a ⟶ G`, which are of finite presentation by Stacks 0H98
  and have surjective transition maps
  (`Stacks.DirectedCokernelSystem.exists_directed_colimit_of_cokernel`).

## References

* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
* [Stacks Project, Tag 086Y](https://stacks.math.columbia.edu/tag/086Y)
* [Stacks Project, Tag 07UW](https://stacks.math.columbia.edu/tag/07UW)
* [Stacks Project, Tag 07U7](https://stacks.math.columbia.edu/tag/07U7)
* [Stacks Project, Tag 0H98](https://stacks.math.columbia.edu/tag/0H98)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))

/-- On a quasi-compact quasi-separated algebraic space all of whose quasi-coherent modules are
locally generated by modules of finite presentation, every quasi-coherent module is a filtered
colimit of modules of finite presentation (the conclusion shape of Stacks 07V9 in this tree). -/
theorem exists_isFilteredColimit_isFinitePresentation_of_isLocallyFpGenerated
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hqc : IsQuasiCompactSpace B S hS X) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X)
    (hgen : ∀ K : Modules.{u, u} B S hS X hX, K.IsQuasicoherentOnSite →
      IsLocallyFpGenerated B S hS hX K)
    (F : Modules.{u, u} B S hS X hX) (hF : F.IsQuasicoherentOnSite) :
    ∃ (K : Type (u + 1)) (inst : Category.{u} K),
      let _ := inst
      ∃ (_ : IsFiltered K) (D : K ⥤ Modules.{u, u} B S hS X hX)
        (φ : D ⟶ (Functor.const K).obj F),
        (∀ k, (D.obj k).IsFinitePresentation) ∧ Nonempty (IsColimit (Cocone.mk F φ)) := by
  obtain ⟨K, inst, hfil, -, D, φ, hfp, hcol⟩ :=
    exists_isFilteredColimit_isFinitePresentation_essentiallySmall B S hS hZ hX hqc hqs hgen F hF
  exact ⟨K, inst, hfil, D, φ, hfp, hcol⟩

/-- The same with a small index category and finite presentation in the on-site rendering
`SheafOfModules.IsFinitePresentationOnSite` (the spelling of the hypothesis `h07V9` of the
existing statements of Stacks 0829 and Stacks 086Y in this tree). -/
theorem exists_small_isFilteredColimit_isFinitePresentationOnSite_of_isLocallyFpGenerated
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hqc : IsQuasiCompactSpace B S hS X) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X)
    (hgen : ∀ K : Modules.{u, u} B S hS X hX, K.IsQuasicoherentOnSite →
      IsLocallyFpGenerated B S hS hX K)
    (F : Modules.{u, u} B S hS X hX) (hF : F.IsQuasicoherentOnSite) :
    ∃ (I : Type u) (inst : SmallCategory I),
      let _ := inst
      ∃ (_ : IsFiltered I) (D : I ⥤ Modules.{u, u} B S hS X hX)
        (φ : D ⟶ (Functor.const I).obj F),
        (∀ i, (D.obj i).IsFinitePresentationOnSite) ∧ Nonempty (IsColimit (Cocone.mk F φ)) := by
  obtain ⟨K, inst, hfil, hsmall, D, φ, hfp, ⟨hcol⟩⟩ :=
    exists_isFilteredColimit_isFinitePresentation_essentiallySmall B S hS hZ hX hqc hqs hgen F hF
  let _ := inst
  let e := equivSmallModel.{u} K
  have : IsFiltered (SmallModel.{u} K) := IsFiltered.of_equivalence e
  refine ⟨SmallModel.{u} K, inferInstance, this, e.inverse ⋙ D,
    Functor.whiskerLeft e.inverse φ, fun i => ?_, ⟨IsColimit.whiskerEquivalence hcol e.symm⟩⟩
  have : ((e.inverse ⋙ D).obj i).IsFinitePresentation := hfp (e.inverse.obj i)
  exact FpAssembly.isFinitePresentationOnSite_of_isFinitePresentation _

/-- Stacks 086Y's conclusion from local generation: a finite type quasi-coherent module on a
quasi-compact quasi-separated algebraic space all of whose quasi-coherent modules are locally
generated by modules of finite presentation is a colimit, over a directed poset, of modules of
finite presentation with surjective transition maps. -/
theorem exists_directed_isFinitePresentation_epi_of_isLocallyFpGenerated
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hqc : IsQuasiCompactSpace B S hS X) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X)
    (hgen : ∀ K : Modules.{u, u} B S hS X hX, K.IsQuasicoherentOnSite →
      IsLocallyFpGenerated B S hS hX K)
    (M : Modules.{u, u} B S hS X hX) [M.IsQuasicoherentOnSite] [M.IsFiniteTypeOnSite] :
    ∃ (I : Type (u + 1)) (_ : PartialOrder I) (_ : Nonempty I) (_ : IsDirected I (· ≤ ·))
      (D : I ⥤ Modules.{u, u} B S hS X hX) (φ : D ⟶ (Functor.const I).obj M)
      (_ : IsColimit (Cocone.mk M φ)),
      (∀ i, (D.obj i).IsFinitePresentationOnSite) ∧
        ∀ (i j : I) (h : i ≤ j), Epi (D.map (homOfLE h)) := by
  classical
  obtain ⟨G, hGfp, p, hp⟩ :=
    exists_isFinitePresentation_epi_of_isFiniteTypeOnSite B S hS hX hqc M (hgen M ‹_›)
  have : G.IsQuasicoherentOnSite :=
    Stacks.SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentation G
  have hker : (kernel p).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_kernel_of_isCartesian B S hS X hX p
      (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS X hX)
  obtain ⟨K, inst, hfil, -, A, a, hAfp, ⟨ha⟩⟩ :=
    exists_isFilteredColimit_isFinitePresentation_essentiallySmall B S hS hZ hX hqc hqs hgen
      (kernel p) hker
  let _ := inst
  have : LocallySmall.{u + 1} K := ⟨fun X Y => small_lift.{u, u, u + 1} (X ⟶ Y)⟩
  have : EssentiallySmall.{u + 1} K := essentiallySmall_of_small_of_locallySmall _
  have : FinallySmall.{u + 1} K := finallySmall_of_essentiallySmall K
  refine Stacks.DirectedCokernelSystem.exists_directed_colimit_of_cokernel p
    (fun G : Modules.{u, u} B S hS X hX => G.IsFinitePresentationOnSite)
    (fun e h => SheafOfModules.IsFinitePresentationOnSite.of_iso e h) a ha fun k => ?_
  have := hAfp k
  have : (cokernel (a.app k ≫ kernel.ι p)).IsFinitePresentation := inferInstance
  exact FpAssembly.isFinitePresentationOnSite_of_isFinitePresentation _

end AlgebraicGeometry.Space

end
