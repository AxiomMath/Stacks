module

public import StacksFrontier.AlgebraicGeometry.Spaces.RingedSite
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleModulePullback
public import StacksFrontier.AlgebraicGeometry.Topologies.ModuleTypesOnSite

/-!
# Local generation of a module by modules of finite presentation

Let `X` be an algebraic space over a scheme `S` and let `F` be an `𝒪_X`-module on the small
étale site of `X`.  A section `s` of `F` over an étale chart `T` is *locally in the image of
modules of finite presentation* when `T` has an étale covering on whose members the restriction
of `s` is the image of a section of some `𝒪_X`-module of finite presentation mapping to `F`.
This is the local form of the statement, at the heart of the proof of Stacks 07V9, that the
modules of finite presentation generate the quasi-coherent ones.

## Main definitions

* `AlgebraicGeometry.Space.fpImageSieve`: the sieve on `T` of the charts over which the
  restriction of `s` lifts to a module of finite presentation mapping to `F`.
* `AlgebraicGeometry.Space.IsLocallyFpGenerated`: every section of `F` over every chart is
  locally in the image of modules of finite presentation.

## Implementation notes

Finite presentation is Mathlib's `SheafOfModules.IsFinitePresentation`, the predicate in which
Stacks 0H98 (cokernels), Stacks 060V (fpqc descent), Stacks 07U7 (compactness) and the base
statement of Stacks 07V9 are written in this tree.

## References

* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)

/-- The sieve on an étale chart `T` of the charts `T' ⟶ T` over which the restriction of a
section `s` of `F` over `T` is the image of a section of an `𝒪_X`-module of finite presentation
mapping to `F`. -/
def fpImageSieve (F : Modules.{u, u} B S hS X hX) {T : SmallEtale B S hS X}
    (s : F.val.obj (op T)) : Sieve T where
  arrows T' g := ∃ (G : Modules.{u, u} B S hS X hX) (_ : G.IsFinitePresentation) (ψ : G ⟶ F)
    (t : G.val.obj (op T')), ψ.val.app (op T') t = F.val.map g.op s
  downward_closed := by
    rintro T' T'' g ⟨G, hG, ψ, t, ht⟩ h
    refine ⟨G, hG, ψ, G.val.map h.op t, ?_⟩
    have hnat : ψ.val.app (op T'') (G.val.map h.op t) = F.val.map h.op (ψ.val.app (op T') t) :=
      PresheafOfModules.naturality_apply ψ.val h.op t
    rw [hnat, ht]
    exact (PresheafOfModules.map_comp_apply F.val g.op h.op s).symm

/-- An `𝒪_X`-module is *locally generated by modules of finite presentation* when every section
over every étale chart is, locally on the chart, the image of a section of an `𝒪_X`-module of
finite presentation mapping to it. -/
def IsLocallyFpGenerated (F : Modules.{u, u} B S hS X hX) : Prop :=
  ∀ (T : SmallEtale B S hS X) (s : F.val.obj (op T)),
    fpImageSieve B S hS hX F s ∈ SmallEtale.topology B S hS X T

/-- The restriction of a global section of an `𝒪_X`-module along an étale morphism `f : Y ⟶ X`:
its value at a chart of `Y` is the value at the postcomposed chart of `X`. -/
def restrictSections {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
    {M : Modules.{u, u} B S hS X.1 X.2} (m : M.val.sections) :
    ((etaleModulePullback.{u, u} B S hS f hf).obj M).val.sections :=
  ⟨fun T => m.1 (op ((smallEtalePostcomp B S hS f hf).obj T.unop)),
    fun g => m.2 ((smallEtalePostcomp B S hS f hf).map g.unop).op⟩

/-- The value of a restricted global section at a chart. -/
theorem restrictSections_apply {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) {M : Modules.{u, u} B S hS X.1 X.2} (m : M.val.sections)
    (T : SmallEtale B S hS Y.1) :
    (restrictSections B S hS f hf m).1 (op T) =
      m.1 (op ((smallEtalePostcomp B S hS f hf).obj T)) := rfl

/-- Restriction of global sections commutes with morphisms of modules. -/
theorem restrictSections_sectionsMap {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) {M N : Modules.{u, u} B S hS X.1 X.2} (φ : M ⟶ N)
    (m : M.val.sections) :
    restrictSections B S hS f hf (PresheafOfModules.sectionsMap φ.val m) =
      PresheafOfModules.sectionsMap ((etaleModulePullback.{u, u} B S hS f hf).map φ).val
        (restrictSections B S hS f hf m) := rfl

/-- A finite covering of an algebraic space `P` by affine étale charts whose pairwise overlaps
are represented by affine étale charts: every chart mapping to `T k` and to `T l` factors through
`T₂ k l`.  This is what a quasi-compact open subspace of an affine algebraic space has, its
pairwise overlaps of basic opens being basic opens. -/
structure FiniteAffineChartCover (P : AlgebraicSpaces B S hS) where
  /-- The index type of the covering. -/
  ι : Type
  /-- The index type is finite. -/
  finite : Finite ι
  /-- The charts of the covering. -/
  T : ι → SmallEtale B S hS P.1
  /-- The charts of the covering are affine. -/
  isAffine : ∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj
    ((SmallEtale.toOver B S hS P.1).obj (T k)))
  /-- The charts cover `P`. -/
  coversTop : (SmallEtale.topology B S hS P.1).CoversTop T
  /-- The charts representing the pairwise overlaps. -/
  T₂ : ι → ι → SmallEtale B S hS P.1
  /-- The first projection of an overlap. -/
  p₁ : ∀ k l, T₂ k l ⟶ T k
  /-- The second projection of an overlap. -/
  p₂ : ∀ k l, T₂ k l ⟶ T l
  /-- The overlaps are affine. -/
  isAffine₂ : ∀ k l, IsAffine ((BigFppfOver.toScheme B S hS).obj
    ((SmallEtale.toOver B S hS P.1).obj (T₂ k l)))
  /-- Every chart mapping to two members of the covering factors through their overlap. -/
  factor : ∀ k l {Y : SmallEtale B S hS P.1} (a : Y ⟶ T k) (b : Y ⟶ T l),
    ∃ c : Y ⟶ T₂ k l, c ≫ p₁ k l = a ∧ c ≫ p₂ k l = b

end AlgebraicGeometry.Space

end
