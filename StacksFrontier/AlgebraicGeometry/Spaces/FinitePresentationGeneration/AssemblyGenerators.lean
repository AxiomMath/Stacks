/-!
# Quasi-coherent modules as filtered colimits of modules of finite presentation

Let `X` be an algebraic space all of whose quasi-coherent modules are locally generated by
modules of finite presentation (`AlgebraicGeometry.Space.IsLocallyFpGenerated`).  This file
proves that every quasi-coherent `𝒪_X`-module `F` on such an `X`, quasi-compact and
quasi-separated, is a filtered colimit, over a small index category, of modules of finite
presentation.

The proof follows the source's proof of Stacks 07V9 and the formal half of the proof of
Stacks 07UW (`AlgebraicGeometry.Space.isFilteredColimit_isFinitePresentation_of_isAffineHom`).

1. *A quotient of a filtered colimit of modules of finite presentation.*  The étale site of `X`
   is essentially small, so the pairs `(T, x)` of a chart of a small model of the site and a
   section `x` over it which is the image of a section of some module of finite presentation
   mapping to `F` form a small set `A`.  Choosing such a module `G a` for every `a ∈ A`, the
   direct sum `⊕_a G a` maps onto `F`: its image contains every section which is locally the
   image of a module of finite presentation, which is every section by hypothesis
   (`AlgebraicGeometry.Space.epi_of_forall_lift`).  The direct sum is the filtered colimit of
   its finite partial sums, which are of finite presentation, and is quasi-coherent (Stacks
   03M1(1), with Descent 03DX(2) proved for the small étale site).
2. *Cokernels.*  Applied to `F` and to the kernel of the surjection, which is again
   quasi-coherent, this exhibits `F` as the cokernel of a map between two filtered colimits of
   modules of finite presentation; by Stacks 07U7 the source diagram is compact, and the formal
   statement
   `Stacks.CategoryTheory.FilteredColimitCokernelPresentation.isColimitIndexCokernelCocone`
   writes `F` as the filtered colimit of the cokernels of the representing maps, which are of
   finite presentation by Stacks 0H98.  The category of representing maps is essentially small
   (`AlgebraicGeometry.Space.essentiallySmall_index`), the category of `𝒪_X`-modules being
   locally small.

The epimorphism criterion of step 1 is local surjectivity on sections
(`AlgebraicGeometry.Space.FpAssembly.epi_of_forall_rangeSieve_mem`).

## References

* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
* [Stacks Project, Tag 07U7](https://stacks.math.columbia.edu/tag/07U7)
* [Stacks Project, Tag 0H98](https://stacks.math.columbia.edu/tag/0H98)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.CategoryTheory.FilteredColimitCokernelPresentation (IsCompactDiagram
  exists_isColimit_cokernel)

universe u v₁ u₁

namespace AlgebraicGeometry.Space.FpAssembly

section Site

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}

/-- The sieve of the arrows along which the restriction of a section `y` of `M` lies in the
image of a morphism `φ : P ⟶ M` of sheaves of modules.  It is the image sieve of the underlying
morphism of presheaves of abelian groups. -/
def rangeSieve {P M : SheafOfModules.{u} R} (φ : P ⟶ M) {W : C} (y : M.val.obj (op W)) :
    Sieve W where
  arrows W' g := ∃ x : P.val.obj (op W'), φ.val.app (op W') x = M.val.map g.op y
  downward_closed := by
    rintro W' W'' g ⟨x, hx⟩ k
    refine ⟨P.val.map k.op x, ?_⟩
    rw [PresheafOfModules.naturality_apply, hx, op_comp, PresheafOfModules.map_comp_apply]

/-- Membership in the range sieve. -/
theorem mem_rangeSieve_iff {P M : SheafOfModules.{u} R} (φ : P ⟶ M) {W W' : C}
    (y : M.val.obj (op W)) (g : W' ⟶ W) :
    rangeSieve φ y g ↔ ∃ x : P.val.obj (op W'), φ.val.app (op W') x = M.val.map g.op y :=
  Iff.rfl

/-- The range sieve is the image sieve of the underlying morphism of presheaves of abelian
groups. -/
theorem rangeSieve_eq_imageSieve {P M : SheafOfModules.{u} R} (φ : P ⟶ M) {W : C}
    (y : M.val.obj (op W)) :
    rangeSieve φ y = Presheaf.imageSieve ((PresheafOfModules.toPresheaf R.obj).map φ.val) y :=
  rfl

/-- Restricting along the inverse of an isomorphism and then along the isomorphism itself is the
identity. -/
theorem map_hom_map_inv_apply (M : PresheafOfModules.{u} R.obj) {T T' : C} (i : T ≅ T')
    (x : M.obj (op T)) : M.map i.hom.op (M.map i.inv.op x : M.obj (op T')) = x := by
  rw [← PresheafOfModules.map_comp_apply, ← op_comp, i.hom_inv_id, op_id,
    PresheafOfModules.map_id]
  rfl

/-- A morphism of sheaves of modules sends the restriction of a section to the restriction of its
image. -/
private theorem app_map_eq_map_of_app_eq {P M : SheafOfModules.{u} R} (φ : P ⟶ M) {W W' : C}
    (g : W' ⟶ W) {t : P.val.obj (op W)} {x : M.val.obj (op W)} (h : φ.val.app (op W) t = x) :
    φ.val.app (op W') (P.val.map g.op t) = M.val.map g.op x :=
  (PresheafOfModules.naturality_apply φ.val g.op t).trans (congrArg _ h)

/-- **A morphism of sheaves of modules all of whose target sections lie locally in its image is
an epimorphism.** -/
theorem epi_of_forall_rangeSieve_mem {P M : SheafOfModules.{u} R} (φ : P ⟶ M)
    (h : ∀ (W : C) (y : M.val.obj (op W)), rangeSieve φ y ∈ J W) : Epi φ :=
  Stacks.SheafOfModules.EpiMono.epi_of_isLocallySurjective φ
    ⟨fun {W} y => (rangeSieve_eq_imageSieve φ y) ▸ h W y⟩

end Site

end AlgebraicGeometry.Space.FpAssembly

namespace AlgebraicGeometry.Space

open FpAssembly

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))

section Generators

variable {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)

/-- A section of an `𝒪_X`-module over a chart *lifts to finite presentation* when it is the
image of a section of some `𝒪_X`-module of finite presentation mapping to the module. -/
def LiftsToFinitePresentation (M : Modules.{u, u} B S hS X hX) {T : SmallEtale B S hS X}
    (x : M.val.obj (op T)) : Prop :=
  ∃ (G : Modules.{u, u} B S hS X hX) (_ : G.IsFinitePresentation) (ψ : G ⟶ M)
    (t : G.val.obj (op T)), ψ.val.app (op T) t = x

/-- Lifting to finite presentation is stable under restriction. -/
theorem LiftsToFinitePresentation.map {M : Modules.{u, u} B S hS X hX}
    {T T' : SmallEtale B S hS X} {x : M.val.obj (op T)}
    (hx : LiftsToFinitePresentation B S hS hX M x) (g : T' ⟶ T) :
    LiftsToFinitePresentation B S hS hX M (T := T') (M.val.map g.op x) := by
  obtain ⟨G, hG, ψ, t, ht⟩ := hx
  exact ⟨G, hG, ψ, _, app_map_eq_map_of_app_eq ψ g ht⟩

/-- **A small family of modules of finite presentation through which every section lifting to
finite presentation lifts.**  The étale site of `X` is essentially small, and the family is
indexed by the pairs of a chart of its small model and a section over it lifting to finite
presentation. -/
theorem exists_family_isFinitePresentation (M : Modules.{u, u} B S hS X hX) :
    ∃ (A : Type u) (G : A → Modules.{u, u} B S hS X hX) (_ : ∀ a, (G a).IsFinitePresentation)
      (ψ : ∀ a, G a ⟶ M),
      ∀ (T : SmallEtale B S hS X) (x : M.val.obj (op T)),
        LiftsToFinitePresentation B S hS hX M x →
          ∃ (a : A) (t : (G a).val.obj (op T)), (ψ a).val.app (op T) t = x := by
  classical
  let E := equivSmallModel.{u} (SmallEtale B S hS X)
  let A := Σ T₀ : SmallModel.{u} (SmallEtale B S hS X),
    {x : M.val.obj (op (E.inverse.obj T₀)) // LiftsToFinitePresentation B S hS hX M x}
  choose G hG ψ t ht using fun a : A => a.2.2
  refine ⟨A, G, hG, ψ, fun T x hx => ?_⟩
  let i : T ≅ E.inverse.obj (E.functor.obj T) := E.unitIso.app T
  let a : A := ⟨E.functor.obj T, ⟨M.val.map i.inv.op x, hx.map B S hS hX i.inv⟩⟩
  exact ⟨a, _, (app_map_eq_map_of_app_eq (ψ a) i.hom (ht a)).trans
    (map_hom_map_inv_apply M.val i x)⟩

/-- **The epimorphism criterion.**  On an `𝒪_X`-module all of whose sections are locally the
image of modules of finite presentation, a morphism `φ : P ⟶ M` is an epimorphism as soon as
every section lifting to finite presentation lies in its image. -/
theorem epi_of_forall_lift {M P : Modules.{u, u} B S hS X hX}
    (hM : IsLocallyFpGenerated B S hS hX M) (φ : P ⟶ M)
    (hφ : ∀ (T : SmallEtale B S hS X) (x : M.val.obj (op T)),
      LiftsToFinitePresentation B S hS hX M x → ∃ y, φ.val.app (op T) y = x) :
    Epi φ := by
  refine epi_of_forall_rangeSieve_mem φ fun T y => ?_
  refine (SmallEtale.topology B S hS X).superset_covering ?_ (hM T y)
  exact fun T' g hg => (mem_rangeSieve_iff φ y g).2 (hφ T' _ hg)

/-- **Every quasi-coherent module all of whose sections are locally the image of modules of
finite presentation is a quotient of a filtered colimit of modules of finite presentation**,
over a small index category, with quasi-coherent colimit.  The colimit is the direct sum of a
small family of modules of finite presentation, written as the filtered colimit of its finite
partial sums. -/
theorem exists_isColimit_epi_of_isLocallyFpGenerated (M : Modules.{u, u} B S hS X hX)
    (hM : IsLocallyFpGenerated B S hS hX M) :
    ∃ (I : Type u) (inst : SmallCategory I),
      let _ := inst
      ∃ (_ : IsFiltered I) (H : I ⥤ Modules.{u, u} B S hS X hX) (c : Cocone H) (e : c.pt ⟶ M),
        (∀ i, (H.obj i).IsFinitePresentation) ∧ Nonempty (IsColimit c) ∧ Epi e ∧
          c.pt.IsQuasicoherentOnSite := by
  classical
  obtain ⟨A, G, hG, ψ, hlift⟩ := exists_family_isFinitePresentation B S hS hX M
  let F : Discrete A ⥤ Modules.{u, u} B S hS X hX := Discrete.functor G
  let H := CoproductsFromFiniteFiltered.liftToFinsetObj F
  let L := CoproductsFromFiniteFiltered.liftToFinsetColimitCocone F
  let e : colimit H ⟶ M := L.isColimit.desc (Cofan.mk M ψ)
  have hj : ∀ a : A, ∃ j : G a ⟶ colimit H, j ≫ e = ψ a := fun a =>
    ⟨L.cocone.ι.app ⟨a⟩, L.isColimit.fac (Cofan.mk M ψ) ⟨a⟩⟩
  refine ⟨Finset (Discrete A), inferInstance, inferInstance, H, colimit.cocone H, e,
    fun s => ?_, ⟨colimit.isColimit H⟩, ?_, ?_⟩
  · exact isFinitePresentation_sigma _ fun x => hG x.1.as
  · refine epi_of_forall_lift B S hS hX hM e fun T x hx => ?_
    obtain ⟨a, t, ht⟩ := hlift T x hx
    obtain ⟨j, hje⟩ := hj a
    refine ⟨j.val.app (op T) t, ?_⟩
    rw [← ht, ← hje]
    rfl
  · exact isQuasicoherentOnSite_of_isColimit_cofan_of_h03DX B S hS X hX
      (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS X hX) L.cocone L.isColimit
      fun a => Stacks.SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentation (G a)

end Generators

/-- The category of triples of
`Stacks.CategoryTheory.FilteredColimitCokernelPresentation.Index` is essentially small at `u`
when the two index categories are small and the ambient category is locally small at `u`: its
objects are triples of an object of each index category and a morphism between their values. -/
theorem essentiallySmall_index {E : Type (u + 1)} [Category.{u + 1} E] [LocallySmall.{u} E]
    {I J : Type u} [SmallCategory I] [SmallCategory J] {H : I ⥤ E} {G : J ⥤ E}
    (cH : Cocone H) (cG : Cocone G) (w : cG.pt ⟶ cH.pt) :
    EssentiallySmall.{u}
      (Stacks.CategoryTheory.FilteredColimitCokernelPresentation.Index cH cG w) := by
  have : Small.{u}
      (Stacks.CategoryTheory.FilteredColimitCokernelPresentation.Index cH cG w) :=
    small_map (β := Σ (i : I) (j : J), {α : G.obj j ⟶ H.obj i //
        α ≫ cH.ι.app i = cG.ι.app j ≫ w})
      { toFun := fun x => ⟨x.i, x.j, x.α, x.compat⟩
        invFun := fun y => ⟨y.1, y.2.1, y.2.2.1, y.2.2.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
  exact essentiallySmall_of_small_of_locallySmall _

/-- **Every quasi-coherent module is a filtered colimit of modules of finite presentation**, on
a quasi-compact quasi-separated algebraic space all of whose quasi-coherent modules are locally
generated by modules of finite presentation; the index category is moreover essentially small.

The module is the cokernel of a map from one filtered colimit of modules of finite presentation
to another (`AlgebraicGeometry.Space.exists_isColimit_epi_of_isLocallyFpGenerated`, applied to
the module and to the kernel of the surjection it produces), and the formal statement
`Stacks.CategoryTheory.FilteredColimitCokernelPresentation.isColimitIndexCokernelCocone`, with
Stacks 07U7 for the compactness and Stacks 0H98 for the cokernels, concludes. -/
theorem exists_isFilteredColimit_isFinitePresentation_essentiallySmall
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hqc : IsQuasiCompactSpace B S hS X) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X)
    (hgen : ∀ K : Modules.{u, u} B S hS X hX, K.IsQuasicoherentOnSite →
      IsLocallyFpGenerated B S hS hX K)
    (F : Modules.{u, u} B S hS X hX) (hF : F.IsQuasicoherentOnSite) :
    ∃ (K : Type (u + 1)) (inst : Category.{u} K),
      let _ := inst
      ∃ (_ : IsFiltered K) (_ : EssentiallySmall.{u} K) (D : K ⥤ Modules.{u, u} B S hS X hX)
        (φ : D ⟶ (Functor.const K).obj F),
        (∀ k, (D.obj k).IsFinitePresentation) ∧ Nonempty (IsColimit (Cocone.mk F φ)) := by
  classical
  have hes : EssentiallySmall.{u} (smallEtaleRingedSite B S hS X hX).C :=
    inferInstanceAs (EssentiallySmall.{u} (SmallEtale B S hS X))
  have hgr : IsGrothendieckAbelian.{u} (Modules.{u, u} B S hS X hX) :=
    SheafOfModules.isGrothendieckAbelian_of_essentiallySmall _
  have : LocallySmall.{u} (Modules.{u, u} B S hS X hX) := hgr.locallySmall
  obtain ⟨I, instI, hfilI, H, cH, e, hHfp, ⟨hcolH⟩, hepie, hqcH⟩ :=
    exists_isColimit_epi_of_isLocallyFpGenerated B S hS hX F (hgen F hF)
  have hkerqc : (kernel e).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_kernel_of_isCartesian B S hS X hX e
      (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS X hX)
  obtain ⟨J, instJ, hfilJ, G, cG, e', hGfp, ⟨hcolG⟩, hepie', -⟩ :=
    exists_isColimit_epi_of_isLocallyFpGenerated B S hS hX (kernel e) (hgen _ hkerqc)
  have hcompact : IsCompactDiagram I G := by
    intro j
    have := hGfp j
    exact preservesColimitsOfShape_coyoneda_of_isFinitePresentation B S hS X hX hZ
      hqc hqs (G.obj j) I
  let w := e' ≫ kernel.ι e
  let c := Stacks.CategoryTheory.FilteredColimitCokernelPresentation.indexCokernelCocone cH cG w
  have hcok := Abelian.epiIsCokernelOfKernel
    (KernelFork.ofι (kernel.ι e) (kernel.condition e)) (kernelIsKernel e)
  have hiso : c.pt ≅ F :=
    cokernelEpiComp e' (kernel.ι e) ≪≫
      IsColimit.coconePointUniqueUpToIso (cokernelIsCokernel (kernel.ι e)) hcok
  refine ⟨_, inferInstance,
    Stacks.CategoryTheory.FilteredColimitCokernelPresentation.isFiltered_index cH cG w hcolH
      hcompact, essentiallySmall_index cH cG w, _, c.ι ≫ (Functor.const _).map hiso.hom, ?_,
    ⟨IsColimit.ofIsoColimit
      (Stacks.CategoryTheory.FilteredColimitCokernelPresentation.isColimitIndexCokernelCocone
        cH cG w hcolH hcolG hcompact) (Cocone.ext hiso fun k => rfl)⟩⟩
  intro k
  have := hHfp k.i
  have := hGfp k.j
  change (cokernel k.α).IsFinitePresentation
  infer_instance

end AlgebraicGeometry.Space

end
