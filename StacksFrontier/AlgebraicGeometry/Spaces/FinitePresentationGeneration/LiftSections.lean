module

public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.Basic
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleModulePullback
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.GeometryBiprod
public import StacksFrontier.AlgebraicGeometry.Spaces.AffineChartSurjectivityFromDescent
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleBinaryProducts
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasicoherentSheavesProperties
public import StacksFrontier.AlgebraicGeometry.Topologies.FinitePresentationQuasicoherentOnSite
public import StacksFrontier.AlgebraicGeometry.Topologies.QuasicoherentFromCoherence
public import StacksFrontier.AlgebraicGeometry.FiniteColimits.Basic

/-!
# Global lifts of sections over a finite affine étale cover with affine overlaps

Let `U` be an algebraic space all of whose quasi-coherent modules are locally generated by
modules of finite presentation, let `q : P ⟶ U` be étale and let `C` be a finite covering of `P`
by affine étale charts `T k` whose pairwise overlaps are affine charts `T₂ k l`.  Every global
section `m` of `F|_P`, for `F` quasi-coherent on `U`, lifts to a global section of `G|_P` for a
module `G` of finite presentation mapping to `F`.

## The argument

1. *Affine charts.*  A section `s` of a quasi-coherent, locally fp-generated `M` over an affine
   chart `W` lifts to one module of finite presentation
   (`AlgebraicGeometry.Space.exists_isFinitePresentation_lift_of_isAffine`): the covering sieve
   of `W` over whose members `s` lifts contains a finite jointly faithfully flat family of affine
   charts (`AlgebraicGeometry.Space.exists_finite_affine_faithfullyFlat_pi_le`); the finitely many
   modules of finite presentation obtained are summed
   (`AlgebraicGeometry.Space.exists_isFinitePresentation_factor`, by binary biproducts), and the
   sum is quasi-coherent, so the faithfully flat family detects the image
   (`AlgebraicGeometry.Space.jointlyDetectsRange_of_isCartesianOnAffineCharts`).
2. *Lifting over the cover.*  This gives `ψ : G ⟶ F` of finite presentation and sections `g k`
   of `G` over the charts `T k` lifting `m`.
3. *Correcting on the overlaps.*  The discrepancies `g k|T₂ - g l|T₂` lie in the kernel `K` of
   `ψ`, which is quasi-coherent (Stacks 03M1(3)); by step 1 for `K` they come from a module `H` of
   finite presentation mapping to `K`.  The cokernel `G'` of `H ⟶ G` is of finite presentation
   (Stacks 0H98), `ψ` factors through it, and the images of the `g k` in `G'` agree on overlaps.
4. *Gluing.*  They glue to a global section of `G'|_P`, because every chart mapping to `T k` and
   to `T l` factors through `T₂ k l`, and its image in `F|_P` is `m` because both agree on the
   covering charts.

## Implementation notes

The instance `Stacks.Cohomology.SiteModules.moduleSheavesAbelian`, imported transitively, has
module universe `max u v r w`; on `Modules.{u, u}` its unification gets stuck, which breaks every
instance search for biproducts and zero morphisms.  It is removed for this file.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

section Helpers

variable {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)

/-- The free `𝒪_X`-module on the empty type is of finite presentation. -/
theorem isFinitePresentation_free_pempty :
    (SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X hX).O) PEmpty.{u + 1}).IsFinitePresentation :=
  Stacks.Tag01PJFiniteColimits.isFinitePresentation_free _

/-- A finite family of modules of finite presentation mapping to `M` factors through a single
module of finite presentation mapping to `M`. -/
theorem exists_isFinitePresentation_factor {I : Type*} [Finite I]
    (M : Modules.{u, u} B S hS X hX) (G : I → Modules.{u, u} B S hS X hX)
    (hG : ∀ i, (G i).IsFinitePresentation) (ψ : ∀ i, G i ⟶ M) :
    ∃ (G' : Modules.{u, u} B S hS X hX) (_ : G'.IsFinitePresentation) (ψ' : G' ⟶ M)
      (j : ∀ i, G i ⟶ G'), ∀ i, j i ≫ ψ' = ψ i := by
  classical
  have := Fintype.ofFinite I
  suffices h : ∀ s : Finset I, ∃ (G' : Modules.{u, u} B S hS X hX) (_ : G'.IsFinitePresentation)
      (ψ' : G' ⟶ M), ∀ i ∈ s, ∃ j : G i ⟶ G', j ≫ ψ' = ψ i by
    obtain ⟨G', hG', ψ', hj⟩ := h Finset.univ
    choose j hj using fun i => hj i (Finset.mem_univ i)
    exact ⟨G', hG', ψ', j, hj⟩
  intro s
  induction s using Finset.induction_on with
  | empty => exact ⟨_, isFinitePresentation_free_pempty B S hS hX, 0, by simp⟩
  | insert a s _ ih =>
    obtain ⟨G', hG', ψ', hj⟩ := ih
    have : HasWeakSheafify (smallEtaleRingedSite B S hS X hX).J AddCommGrpCat.{u} :=
      inferInstanceAs (HasWeakSheafify (SmallEtale.topology B S hS X) AddCommGrpCat.{u})
    have : (smallEtaleRingedSite B S hS X hX).J.WEqualsLocallyBijective AddCommGrpCat.{u} :=
      inferInstanceAs ((SmallEtale.topology B S hS X).WEqualsLocallyBijective AddCommGrpCat.{u})
    refine ⟨G' ⊞ G a, Stacks.SheafOfModules.isFinitePresentation_biprod _ _ hG' (hG a),
      biprod.desc ψ' (ψ a), fun i hi => ?_⟩
    rcases Finset.mem_insert.1 hi with rfl | hi
    · exact ⟨biprod.inr, by simp⟩
    · obtain ⟨j, hj⟩ := hj i hi
      exact ⟨j ≫ biprod.inl, by simp [hj]⟩

/-- A morphism of `𝒪_X`-modules is additive on the sections over a chart. -/
theorem val_app_sub {M N : Modules.{u, u} B S hS X hX} (f : M ⟶ N) (Y : (SmallEtale B S hS X)ᵒᵖ)
    (a b : M.val.obj Y) : f.val.app Y (a - b) = f.val.app Y a - f.val.app Y b :=
  (f.val.app Y).hom.map_sub a b

/-- A morphism of `𝒪_X`-modules commutes with the restriction maps of sections. -/
theorem val_app_restrictₛₗ {M N : Modules.{u, u} B S hS X hX} (f : M ⟶ N)
    {Y Y' : (SmallEtale B S hS X)ᵒᵖ} (h : Y ⟶ Y') (a : M.val.obj Y) :
    f.val.app Y' (M.val.restrictₛₗ h a) = N.val.restrictₛₗ h (f.val.app Y a) :=
  PresheafOfModules.naturality_apply f.val h a

/-- The kernel of a morphism of quasi-coherent `𝒪_X`-modules, in the form used below: a
quasi-coherent module with a map to the source, killed by the morphism, through which every
section killed by the morphism lifts. -/
theorem exists_kernel_data {G F : Modules.{u, u} B S hS X hX} (ψ : G ⟶ F)
    (hG : G.IsQuasicoherentOnSite) (hF : F.IsQuasicoherentOnSite) :
    ∃ (K : Modules.{u, u} B S hS X hX) (_ : K.IsQuasicoherentOnSite) (ι : K ⟶ G),
      ι ≫ ψ = 0 ∧ ∀ (Y : (SmallEtale B S hS X)ᵒᵖ) (x : G.val.obj Y), ψ.val.app Y x = 0 →
        ∃ y : K.val.obj Y, ι.val.app Y y = x := by
  refine ⟨kernel ψ, (isQuasicoherentOnSite_kernel_and_cokernel B S hS X hX ψ hG hF).1,
    kernel.ι ψ, kernel.condition ψ, fun Y x hx => ?_⟩
  exact SheafOfModules.exists_kernel_val_app ψ Y x hx

/-- The zero morphism of `𝒪_X`-modules vanishes on sections. -/
theorem val_app_eq_zero_of_eq_zero {M N : Modules.{u, u} B S hS X hX} {f : M ⟶ N} (hf : f = 0)
    (Y : (SmallEtale B S hS X)ᵒᵖ) (a : M.val.obj Y) : f.val.app Y a = 0 := by
  subst hf
  rfl

/-- The cokernel of a morphism between modules of finite presentation, in the form used below: a
module of finite presentation receiving the target, killing the morphism, through which every
morphism killing it factors. -/
theorem exists_cokernel_data {H G F : Modules.{u, u} B S hS X hX} (Θ : H ⟶ G) (ψ : G ⟶ F)
    (hΘ : Θ ≫ ψ = 0) (hH : H.IsFinitePresentation) (hG : G.IsFinitePresentation) :
    ∃ (G' : Modules.{u, u} B S hS X hX) (_ : G'.IsFinitePresentation) (π : G ⟶ G')
      (ψ' : G' ⟶ F), Θ ≫ π = 0 ∧ π ≫ ψ' = ψ := by
  have := hH
  have := hG
  exact ⟨cokernel Θ, Stacks.SheafOfModules.LocalCokernel.isFinitePresentation_cokernel
      (smallEtaleRingedSite B S hS X hX) Θ, cokernel.π Θ, cokernel.desc Θ ψ hΘ,
    cokernel.condition Θ, cokernel.π_desc Θ ψ hΘ⟩

/-- If `f ≫ g = h`, then `g` of `f` of a section is `h` of that section. -/
private theorem val_app_comp_apply_of_comp_eq {M₁ M₂ M₃ : Modules.{u, u} B S hS X hX}
    {f : M₁ ⟶ M₂} {g : M₂ ⟶ M₃} {h : M₁ ⟶ M₃} (hfg : f ≫ g = h) (Y : (SmallEtale B S hS X)ᵒᵖ)
    (a : M₁.val.obj Y) :
    g.val.app Y (f.val.app Y a) = h.val.app Y a := by
  subst hfg
  rfl

/-- **Lifting a section over an affine chart.**  If `M` is quasi-coherent and locally generated
by modules of finite presentation, every section of `M` over an affine étale chart `W` is the
image of a section over `W` of a single module of finite presentation mapping to `M`. -/
theorem exists_isFinitePresentation_lift_of_isAffine (M : Modules.{u, u} B S hS X hX)
    (hM : M.IsQuasicoherentOnSite) (hgen : IsLocallyFpGenerated B S hS hX M)
    {W : SmallEtale B S hS X}
    (hW : IsAffine ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).obj W))
    (s : M.val.obj (op W)) :
    ∃ (G : Modules.{u, u} B S hS X hX) (_ : G.IsFinitePresentation) (ψ : G ⟶ M)
      (t : G.val.obj (op W)), ψ.val.app (op W) t = s := by
  obtain ⟨n, z, φ, hzaff, hzS, hff⟩ :=
    exists_finite_affine_faithfullyFlat_pi_le B S hS X hX hW (hgen W s)
  choose G hG ψ t ht using hzS
  obtain ⟨G', hG', ψ', j, hj⟩ := exists_isFinitePresentation_factor B S hS hX M G hG ψ
  have hdet := jointlyDetectsRange_of_isCartesianOnAffineCharts ψ'
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X hX G'
      (have := hG'; Stacks.SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentation G'))
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X hX M hM) hW φ hzaff hff
  obtain ⟨t', ht'⟩ := hdet s fun i => ⟨(j i).val.app (op (z i)) (t i),
    (val_app_comp_apply_of_comp_eq B S hS hX (hj i) _ _).trans (ht i)⟩
  exact ⟨G', hG', ψ', t', ht'⟩

end Helpers

section Gluing

variable {P : AlgebraicSpaces B S hS}

/-- The underlying presheaf of sets of an `𝒪_P`-module is a sheaf. -/
theorem isSheaf_val_presheaf_forget (N : Modules.{u, u} B S hS P.1 P.2) :
    Presheaf.IsSheaf (SmallEtale.topology B S hS P.1) (N.val.presheaf ⋙ forget AddCommGrpCat) :=
  GrothendieckTopology.HasSheafCompose.isSheaf (J := (smallEtaleRingedSite B S hS P.1 P.2).J)
    _ N.isSheaf

/-- **Gluing over a finite affine chart cover.**  Sections of an `𝒪_P`-module over the charts of
`C` which agree on the overlap charts are the values of a global section. -/
theorem exists_sections_of_agree (C : FiniteAffineChartCover B S hS P)
    (N : Modules.{u, u} B S hS P.1 P.2) (x : ∀ k, N.val.obj (op (C.T k)))
    (hx : ∀ k l, N.val.map (C.p₁ k l).op (x k) = N.val.map (C.p₂ k l).op (x l)) :
    ∃ σ : N.val.sections, ∀ k, σ.1 (op (C.T k)) = x k := by
  let fam : Presheaf.FamilyOfElementsOnObjects (N.val.presheaf ⋙ forget AddCommGrpCat) C.T := x
  have hcompat : fam.IsCompatible := by
    intro Z k l a b
    obtain ⟨c, rfl, rfl⟩ := C.factor k l a b
    exact (PresheafOfModules.map_comp_apply N.val (C.p₁ k l).op c.op (x k)).trans
      ((congrArg (N.val.map c.op) (hx k l)).trans
        (PresheafOfModules.map_comp_apply N.val (C.p₂ k l).op c.op (x l)).symm)
  exact ⟨hcompat.section_ C.coversTop (isSheaf_val_presheaf_forget B S hS N),
    fun k => hcompat.section_apply _ _ k⟩

/-- Two global sections of an `𝒪_P`-module agreeing on the charts of a finite affine chart cover
are equal. -/
theorem sections_ext_of_agree (C : FiniteAffineChartCover B S hS P)
    (N : Modules.{u, u} B S hS P.1 P.2) {σ τ : N.val.sections}
    (h : ∀ k, σ.1 (op (C.T k)) = τ.1 (op (C.T k))) : σ = τ :=
  C.coversTop.sections_ext ⟨_, isSheaf_val_presheaf_forget B S hS N⟩ h

/-- Reading the restriction of a factored morphism on a chart: if `π ≫ ψ' = ψ` and a section
`σ` of `G'|_P` is `π` of `y` over a chart `T`, then the image of `σ` under `ψ'|_P` is `ψ` of `y`
over `T`. -/
theorem sectionsMap_etaleModulePullback_apply {U : AlgebraicSpaces B S hS} (q : P ⟶ U)
    (hq : IsEtale B S hS q.hom) {G G' F : Modules.{u, u} B S hS U.1 U.2} {π : G ⟶ G'}
    {ψ' : G' ⟶ F} {ψ : G ⟶ F} (hψ' : π ≫ ψ' = ψ)
    (σ : ((etaleModulePullback.{u, u} B S hS q hq).obj G').val.sections)
    (T : SmallEtale B S hS P.1)
    (y : G.val.obj (op ((smallEtalePostcomp B S hS q hq).obj T)))
    (hσ : σ.1 (op T) = π.val.app _ y) :
    (PresheafOfModules.sectionsMap ((etaleModulePullback.{u, u} B S hS q hq).map ψ').val σ).1
      (op T) = ψ.val.app _ y := by
  rw [PresheafOfModules.sectionsMap_coe, hσ, ← hψ']
  rfl

end Gluing

/-- **From local to global lifts.** Let `U` be an algebraic space all of whose quasi-coherent
modules are locally generated by modules of finite presentation, let `q : P ⟶ U` be étale, and
suppose `P` has a finite covering `C` by affine étale charts with affine overlaps. Then every
global section of `F|_P`, for `F` quasi-coherent on `U`, is the image of a global section of `G|_P`
for some `𝒪_U`-module `G` of finite presentation mapping to `F`. -/
theorem exists_isFinitePresentation_lift_sections
    {U P : AlgebraicSpaces B S hS} (q : P ⟶ U) (hq : IsEtale B S hS q.hom)
    (hgen : ∀ K : Modules.{u, u} B S hS U.1 U.2, K.IsQuasicoherentOnSite →
      IsLocallyFpGenerated B S hS U.2 K)
    (C : FiniteAffineChartCover B S hS P)
    (F : Modules.{u, u} B S hS U.1 U.2) (hF : F.IsQuasicoherentOnSite)
    (m : ((etaleModulePullback.{u, u} B S hS q hq).obj F).val.sections) :
    ∃ (G : Modules.{u, u} B S hS U.1 U.2) (_ : G.IsFinitePresentation) (ψ : G ⟶ F)
      (g : ((etaleModulePullback.{u, u} B S hS q hq).obj G).val.sections),
      PresheafOfModules.sectionsMap ((etaleModulePullback.{u, u} B S hS q hq).map ψ).val g = m := by
  classical
  have := C.finite
  let Φ := smallEtalePostcomp B S hS q hq
  -- Step 1: lift `m` over each affine chart of the covering.
  have hstep₁ : ∀ k, ∃ (G : Modules.{u, u} B S hS U.1 U.2) (_ : G.IsFinitePresentation)
      (ψ : G ⟶ F) (t : G.val.obj (op (Φ.obj (C.T k)))),
      ψ.val.app _ t = m.1 (op (C.T k)) := fun k =>
    exists_isFinitePresentation_lift_of_isAffine B S hS U.2 F hF (hgen F hF)
      (W := Φ.obj (C.T k)) (C.isAffine k) _
  choose G₁ hG₁ ψ₁ t₁ ht₁ using hstep₁
  obtain ⟨G, hG, ψ, j, hj⟩ := exists_isFinitePresentation_factor B S hS U.2 F G₁ hG₁ ψ₁
  let g : ∀ k, G.val.obj (op (Φ.obj (C.T k))) := fun k => (j k).val.app _ (t₁ k)
  have hg : ∀ k, ψ.val.app _ (g k) = m.1 (op (C.T k)) := fun k =>
    (val_app_comp_apply_of_comp_eq B S hS U.2 (hj k) _ _).trans (ht₁ k)
  have hm : ∀ {Y Y' : SmallEtale B S hS P.1} (f : Y ⟶ Y'),
      F.val.restrictₛₗ (Φ.map f).op (m.1 (op Y')) = m.1 (op Y) :=
    fun f => m.2 f.op
  -- Step 2: the discrepancies on the overlaps lie in the kernel of `ψ`.
  let d : ∀ k l, G.val.obj (op (Φ.obj (C.T₂ k l))) := fun k l =>
    G.val.restrictₛₗ (Φ.map (C.p₁ k l)).op (g k) - G.val.restrictₛₗ (Φ.map (C.p₂ k l)).op (g l)
  have hmap : ∀ {N : Modules.{u, u} B S hS U.1 U.2} (f : G ⟶ N) (k l : C.ι),
      f.val.app _ (d k l) = N.val.restrictₛₗ (Φ.map (C.p₁ k l)).op (f.val.app _ (g k)) -
        N.val.restrictₛₗ (Φ.map (C.p₂ k l)).op (f.val.app _ (g l)) := fun f k l =>
    (val_app_sub B S hS U.2 f _ _ _).trans (congrArg₂ (· - ·)
      (val_app_restrictₛₗ B S hS U.2 f _ (g k)) (val_app_restrictₛₗ B S hS U.2 f _ (g l)))
  have hd : ∀ k l, ψ.val.app _ (d k l) = 0 := fun k l => by
    refine (hmap ψ k l).trans (sub_eq_zero.2 ?_)
    exact ((congrArg (F.val.restrictₛₗ (Φ.map (C.p₁ k l)).op) (hg k)).trans (hm _)).trans
      ((congrArg (F.val.restrictₛₗ (Φ.map (C.p₂ k l)).op) (hg l)).trans (hm _)).symm
  have hGqc : G.IsQuasicoherentOnSite :=
    (have := hG; Stacks.SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentation G)
  obtain ⟨K, hK, ι, hι, hlift⟩ := exists_kernel_data B S hS U.2 ψ hGqc hF
  choose e he using fun k l => hlift _ (d k l) (hd k l)
  have hstep₂ : ∀ k l, ∃ (H : Modules.{u, u} B S hS U.1 U.2)
      (_ : H.IsFinitePresentation) (φ : H ⟶ K)
      (h : H.val.obj (op (Φ.obj (C.T₂ k l)))), φ.val.app _ h = e k l := fun k l =>
    exists_isFinitePresentation_lift_of_isAffine B S hS U.2 _ hK (hgen _ hK)
      (W := Φ.obj (C.T₂ k l)) (C.isAffine₂ k l) _
  choose H₁ hH₁ φ₁ h₁ hh₁ using hstep₂
  obtain ⟨H, hH, φ, i, hi⟩ := exists_isFinitePresentation_factor B S hS U.2 _
    (fun kl : C.ι × C.ι => H₁ kl.1 kl.2) (fun kl => hH₁ kl.1 kl.2) (fun kl => φ₁ kl.1 kl.2)
  have hΘ : (φ ≫ ι) ≫ ψ = 0 := by rw [Category.assoc, hι, comp_zero]
  -- Step 3: kill the discrepancies.
  obtain ⟨G', hG', π, ψ', hπ, hψ'⟩ := exists_cokernel_data B S hS U.2 (φ ≫ ι) ψ hΘ hH hG
  let M' := (etaleModulePullback.{u, u} B S hS q hq).obj G'
  let x : ∀ k, M'.val.obj (op (C.T k)) := fun k => π.val.app _ (g k)
  have hx : ∀ k l, M'.val.map (C.p₁ k l).op (x k) = M'.val.map (C.p₂ k l).op (x l) := by
    intro k l
    have hdk : d k l = ((i (k, l) ≫ φ ≫ ι).val.app _) (h₁ k l) := by
      refine (he k l).symm.trans ((congrArg (ι.val.app _) (hh₁ k l).symm).trans ?_)
      rw [← hi (k, l)]
      rfl
    have key : π.val.app _ (d k l) = 0 := by
      rw [hdk]
      refine val_app_eq_zero_of_eq_zero B S hS U.2 (f := (i (k, l) ≫ φ ≫ ι) ≫ π) ?_ _ _
      rw [Category.assoc, Category.assoc, ← Category.assoc φ ι π, hπ, comp_zero]
    rw [hmap π k l] at key
    exact sub_eq_zero.1 key
  -- Step 4: glue.
  obtain ⟨σ, hσ⟩ := exists_sections_of_agree B S hS C M' x hx
  refine ⟨G', hG', ψ', σ, sections_ext_of_agree B S hS C _ fun k => ?_⟩
  exact (sectionsMap_etaleModulePullback_apply B S hS q hq hψ' σ (C.T k) (g k) (hσ k)).trans
    (hg k)

end AlgebraicGeometry.Space

end
