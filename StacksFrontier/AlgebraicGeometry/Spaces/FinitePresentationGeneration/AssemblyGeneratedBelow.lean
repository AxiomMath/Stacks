module

public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleLocalGenerationBound
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationGeneration.AssemblyFiniteType

/-!
# Modules étale-locally generated by fewer than `κ` sections

Let `X` be a quasi-compact algebraic space and `M` an `𝒪_X`-module all of whose sections are
locally the image of modules of finite presentation. If `M` is étale-locally generated by fewer
than `κ` sections, then there is a family of at most `max κ ℵ₀` modules of finite presentation
mapping to `M`, jointly epimorphic.

## Main results

* `AlgebraicGeometry.Space.mk_sigma_sigma_le_max`: a finite union of families of finite sets
  indexed by sets of size at most `ν` has size at most `max ν ℵ₀`.
* `AlgebraicGeometry.Space.exists_isFinitePresentation_family_of_isEtaleLocallyGeneratedBelow`:
  such a module `M` is generated by a family of at most `max κ ℵ₀` modules of finite
  presentation.

## References

* [Stacks Project, Tag 086Y](https://stacks.math.columbia.edu/tag/086Y)
* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Cardinal

universe u

namespace AlgebraicGeometry.Space

open FpAssembly

/-- A finite union of families of finite sets indexed by sets of size at most `ν` has size at most
`max ν ℵ₀`. -/
theorem mk_sigma_sigma_le_max {K : Type} [Finite K] {I : K → Type u} {μ : ∀ k, I k → Type}
    [∀ k l, Finite (μ k l)] {ν : Cardinal.{u}} (hI : ∀ k, #(I k) ≤ ν) :
    #(Σ k, Σ l : I k, μ k l) ≤ max ν ℵ₀ := by
  classical
  have he : ∀ k l, ∃ e : μ k l → ℕ, Function.Injective e := fun k l => exists_injective_nat _
  choose e he using he
  let f : (Σ k, Σ l : I k, μ k l) → Σ k, I k × ULift.{u} ℕ :=
    fun x => ⟨x.1, x.2.1, ⟨e x.1 x.2.1 x.2.2⟩⟩
  have hf : Function.Injective f := by
    rintro ⟨k, l, m⟩ ⟨k', l', m'⟩ h
    simp only [f, Sigma.mk.injEq] at h
    obtain ⟨rfl, h⟩ := h
    simp only [heq_eq_eq, Prod.mk.injEq, ULift.up.injEq] at h
    obtain ⟨rfl, h⟩ := h
    rw [he k l h]
  refine (mk_le_of_injective hf).trans ?_
  rw [mk_sigma]
  refine (sum_le_lift_mk_mul_iSup _).trans <| (mul_le_mul'
    ((lift_le_aleph0.2 mk_le_aleph0).trans (le_max_right _ _)) (ciSup_le' fun k => ?_)).trans
      (mul_eq_self (le_max_right _ _)).le
  rw [mk_prod, lift_id, lift_id, mk_uLift, mk_nat, lift_aleph0]
  exact (mul_le_mul' ((hI k).trans (le_max_left _ _)) (le_max_right _ _)).trans
    (mul_eq_self (le_max_right _ _)).le

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- On a quasi-compact algebraic space, a module étale-locally generated by fewer than `ν`
sections, all of whose sections are locally the image of modules of finite presentation, is
generated by a family of at most `max ν ℵ₀` modules of finite presentation: a morphism out of it
killing all of them is zero. -/
theorem exists_isFinitePresentation_family_of_isEtaleLocallyGeneratedBelow
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hX : IsAlgebraicSpace B S hS X)
    (hqc : IsQuasiCompactSpace B S hS X) (M : Modules.{u, u} B S hS X hX)
    (hM : IsLocallyFpGenerated B S hS hX M) {ν : Cardinal.{u}}
    (hgen : IsEtaleLocallyGeneratedBelow B S hS ν (X := ⟨X, hX⟩) M) :
    ∃ (A : Type u) (G : A → Modules.{u, u} B S hS X hX) (_ : ∀ a, (G a).IsFinitePresentation)
      (p : ∀ a, G a ⟶ M), #A ≤ max ν ℵ₀ ∧
        ∀ {Z : Modules.{u, u} B S hS X hX} (g : M ⟶ Z), (∀ a, p a ≫ g = 0) → g = 0 := by
  classical
  let : HasSheafify (smallEtaleRingedSite B S hS X hX).J AddCommGrpCat.{u} :=
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  let : ∀ U : (smallEtaleRingedSite B S hS X hX).C,
      HasSheafify ((smallEtaleRingedSite B S hS X hX).J.over U) AddCommGrpCat.{u} :=
    fun _ => AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  let : ∀ (V W : (smallEtaleRingedSite B S hS X hX).C) (f : W ⟶ V),
      PreservesColimitsOfSize.{u, u} (SheafOfModules.overMap.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O) f) :=
    fun _ _ f => Stacks.SheafOfModules.overMap_preservesColimits _ f
  obtain ⟨K, qX, hqcov, hqgen⟩ :=
    exists_coversTop_generatingSections_of_isEtaleLocallyGeneratedBelow (B := B) (S := S)
      (hS := hS) ⟨X, hX⟩ M hgen
  choose qgen hqgen using hqgen
  obtain ⟨U, hUaff, hUcov⟩ := SmallEtale.exists_affineObject_coversTop B S hS X hX hqc
  obtain ⟨κ, hκ, V, f, hVaff, hle, hcov⟩ :=
    SmallEtale.exists_finite_affine_refinement B S hS X U hUaff (Sieve.ofObjects qX U)
      (hqcov U)
  have hVcov := coversTop_of_coversTop_of_ofArrows_mem B S hS hUcov hcov
  have hmem : ∀ k, ∃ i, Nonempty (V k ⟶ qX i) := fun k =>
    (Sieve.mem_ofObjects_iff _ _).1 (hle _ (Sieve.ofArrows_mk V f k))
  choose i a using hmem
  let V' : κ → (smallEtaleRingedSite B S hS X hX).C := V
  let a' : ∀ k, V' k ⟶ qX (i k) := fun k => (a k).some
  let σ : ∀ k, (M.over (V' k)).GeneratingSections := fun k =>
    Stacks.SheafOfModules.LocalKernel.generatingSectionsOver (a' k) (qgen (i k))
  let x : ∀ k, (σ k).I → M.val.obj (op (V' k)) := fun k l =>
    ((σ k).s l).val (op (Over.mk (𝟙 (V' k))))
  have hlift : ∀ k (l : (σ k).I), ∃ (μ : Type) (_ : Finite μ) (W : μ → SmallEtale B S hS X)
      (w : ∀ m, W m ⟶ V k), Sieve.ofArrows W w ∈ SmallEtale.topology B S hS X (V k) ∧
        ∀ m, LiftsToFinitePresentation B S hS hX M (T := W m) (M.val.map (w m).op (x k l)) := by
    intro k l
    obtain ⟨μ, hμ, W, w, -, hle', hcov'⟩ :=
      SmallEtale.exists_finite_affine_refinement B S hS X (V k) (hVaff k) _ (hM (V k) (x k l))
    exact ⟨μ, hμ, W, w, hcov', fun m => hle' _ (Sieve.ofArrows_mk W w m)⟩
  choose μ hμ W w hcovW hL using hlift
  choose G hG ψ t ht using hL
  let GG : (Σ k : κ, Σ l : (σ k).I, μ k l) → Modules.{u, u} B S hS X hX :=
    fun j => G j.1 j.2.1 j.2.2
  refine ⟨_, GG, fun j => hG _ _ _, fun j => ψ j.1 j.2.1 j.2.2,
    mk_sigma_sigma_le_max (fun k => (hqgen (i k)).le), fun {Z} g hg => ?_⟩
  have h2 : ∀ k l, g.val.app (op (V' k)) (x k l) = 0 := by
    intro k l
    refine eq_zero_of_forall_mem_sieve Z _ (hcovW k l) ?_
    intro W' e he
    obtain ⟨m, h, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 he
    have hm : Z.val.map (w k l m).op (g.val.app (op (V' k)) (x k l)) = 0 := by
      refine (PresheafOfModules.naturality_apply g.val (w k l m).op (x k l)).symm.trans ?_
      refine (congrArg (g.val.app _) (ht k l m)).symm.trans ?_
      show (ψ k l m ≫ g).val.app _ (t k l m) = 0
      rw [hg ⟨k, l, m⟩]
      rfl
    refine (PresheafOfModules.map_comp_apply Z.val (w k l m).op h.op _).trans ?_
    exact (congrArg (Z.val.map h.op) hm).trans (map_zero _)
  have h3 : ∀ k, g.over (V' k) = 0 := fun k =>
    eq_zero_of_generatingSections (σ k) _ fun l => by
      apply Subtype.ext
      funext Y
      have hs := ((σ k).s l).property
        (Over.homMk Y.unop.hom (Category.comp_id _) : Y.unop ⟶ Over.mk (𝟙 (V' k))).op
      show g.val.app (op Y.unop.left) (((σ k).s l).val Y) = 0
      rw [← hs]
      show g.val.app (op Y.unop.left) (M.val.map Y.unop.hom.op (x k l)) = 0
      refine (PresheafOfModules.naturality_apply g.val Y.unop.hom.op (x k l)).trans ?_
      exact (congrArg (Z.val.map Y.unop.hom.op) (h2 k l)).trans (map_zero _)
  exact hom_eq_zero_of_coversTop (Y := V') g hVcov fun k W b =>
    congrArg (fun φ => φ.val.app (op (Over.mk b))) (h3 k)

end AlgebraicGeometry.Space

end
