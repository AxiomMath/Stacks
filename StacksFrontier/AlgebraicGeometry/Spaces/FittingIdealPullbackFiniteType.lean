module

public import StacksFrontier.AlgebraicGeometry.Spaces.AffineChartDiagramCofinal
public import StacksFrontier.AlgebraicGeometry.Spaces.CartesianChartDiagramsOfModulePullback
public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentChartSectionsFinite
public import StacksFrontier.AlgebraicGeometry.Spaces.FittingIdealPullback

/-!
# The Fitting ideal sheaves of a pullback of a finite type quasi-coherent module

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` of a big fppf site `B` and
let `G` be a finite type quasi-coherent `𝒪_Y`-module.  Stacks 0CZ4 asserts that the ideal sheaf
on `X` generated by the inverse image of the `r`-th Fitting ideal sheaf of `G` is the `r`-th
Fitting ideal sheaf of `f^*G`.

## Main results

* `AlgebraicGeometry.Space.fittingIdealPullback_eq_fittingIdeal`: **Stacks 0CZ4**,
  `f^{-1}Fit_r(G) · 𝒪_X = Fit_r(f^*G)`.

## Implementation notes

Finite type is taken in the presheaf form `PresheafOfModules.IsFiniteType`, which is the weaker
of the two readings of Stacks 03DL(5) available here: the sheaf form
`SheafOfModules.IsFiniteTypeOnSite` implies it by
`Stacks.SheafOfModules.isFiniteType_of_isFiniteTypeOnSite`.

## References

* [Stacks Project, Tag 0CZ4](https://stacks.math.columbia.edu/tag/0CZ4)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 03G2](https://stacks.math.columbia.edu/tag/03G2)
* [Stacks Project, Tag 03GA](https://stacks.math.columbia.edu/tag/03GA)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X Y : AlgebraicSpaces B S hS}

/-- **The affine chart diagrams over `f` whose target chart carries finite sections of `G` are
cofinal**, for a finite type quasi-coherent `𝒪_Y`-module `G`. -/
theorem generate_affineChartDiagramPresieve_mem_topology (f : X ⟶ Y)
    {G : Modules.{u, u} B S hS Y.1 Y.2} (hqc : G.IsQuasicoherentOnSite)
    (hft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS Y.1 Y.2).J G.val)
    (U : SmallEtale B S hS X.1) :
    Sieve.generate (affineChartDiagramPresieve B S hS f G U) ∈
      SmallEtale.topology B S hS X.1 U :=
  generate_affineChartDiagram_mem_topology B S hS f
    (fun V => Module.Finite (chartRing B S hS Y.1 Y.2 V) (G.val.obj (op V)))
    (fun _ hV => moduleFinite_sections_of_isFiniteType B S hS Y.1 Y.2
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2 G hqc) hft hV) U

/-- Let `f : X ⟶ Y` be a morphism of algebraic spaces and let `G` be a finite type
quasi-coherent `𝒪_Y`-module.  Then the ideal sheaf on `X` generated by the inverse image of the
`r`-th Fitting ideal sheaf of `G` is the `r`-th Fitting ideal sheaf of `f^*G`:
`f^{-1}Fit_r(G) · 𝒪_X = Fit_r(f^*G)`. -/
@[stacks 0CZ4]
theorem fittingIdealPullback_eq_fittingIdeal {f : X ⟶ Y} {G : Modules.{u, u} B S hS Y.1 Y.2}
    (hqc : G.IsQuasicoherentOnSite)
    (hft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS Y.1 Y.2).J G.val)
    (r : ℕ) :
    fittingIdealPullback B S hS f G r =
      fittingIdeal B S hS X.1 X.2 ((modulePullback B S hS f).obj G) r :=
  fittingIdealPullback_eq_fittingIdeal_of_isCartesianOnAffineChartDiagrams
    (isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite B S hS f G hqc)
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS f G hqc)
    (generate_affineChartDiagramPresieve_mem_topology f hqc hft) r

end AlgebraicGeometry.Space

end
