-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u m

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (X : AlgebraicSpaces B S hS)

/-! ### Charts on which a sheaf of ideals is the whole structure sheaf -/

/-- The sieve on an étale chart `W` of `X` consisting of the arrows out of the charts on which
the sheaf of ideals `ℐ` is the whole structure sheaf. -/
def unitIdealSieve (I : IdealSheaves B S hS X.1 X.2) (W : SmallEtale B S hS X.1) : Sieve W where
  arrows Y _ := I.obj (op Y) = ⊤
  downward_closed := fun {_ Z} {_} h g =>
    SheafOfModules.Submodule.unit_obj_eq_top_of_map I (Y := op Z) g.op h

/-- The charts on which a sheaf of ideals is the whole structure sheaf cover every chart all of
whose points lie in the unit locus.

For each point of the chart `AlgebraicGeometry.Space.mem_idealUnitLocus_iff_exists_over` supplies
a chart over it on which the sheaf of ideals is the whole structure sheaf and whose image
contains that point; the resulting family is jointly surjective on the points of the underlying
scheme of the chart, hence an étale covering family of schemes. -/
theorem unitIdealSieve_mem_topology (I : IdealSheaves B S hS X.1 X.2)
    (W : SmallEtale B S hS X.1)
    (hW : Set.range (pointsMap B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj W)) W.1.hom) ⊆
      idealUnitLocus B S hS X I) :
    unitIdealSieve B S hS X I W ∈ SmallEtale.topology B S hS X.1 W := by
  classical
  have hex : ∀ w : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj W)),
      ∃ (V : SmallEtale B S hS X.1) (g : V ⟶ W), I.obj (op V) = ⊤ ∧
        w ∈ Set.range (pointsMap B S hS
          (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V))
          (yoneda.map ((SmallEtale.toOver B S hS X.1).map g))) := fun w =>
    (mem_idealUnitLocus_iff_exists_over B S hS X I W w).1 (hW ⟨w, rfl⟩)
  choose V g hVtop hVsurj using hex
  have hpre : Presieve.ofArrows
      (fun w ↦ (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj (V w)))
      (fun w ↦ (BigFppfOver.toScheme B S hS).map
        ((SmallEtale.toOver B S hS X.1).map (g w))) ∈
      Scheme.etalePrecoverage.coverings
        ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj W)) := by
    refine Scheme.ofArrows_mem_etalePrecoverage_iff.2
      ⟨fun x ↦ ?_, fun w ↦ etale_toScheme_toOver_map B S hS X.1 (g w)⟩
    obtain ⟨w, hw⟩ := surjective_pointsToScheme B S hS
      ((SmallEtale.toOver B S hS X.1).obj W) x
    obtain ⟨p, hp⟩ := hVsurj w
    refine ⟨w, pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj (V w)) p, ?_⟩
    rw [← pointsToScheme_pointsMap_yoneda, hp, hw]
  refine (SmallEtale.topology B S hS X.1).superset_covering ?_
    (SmallEtale.ofArrows_mem_topology B S hS X.1 V g hpre)
  rintro Z k ⟨C, t, p, ⟨w⟩, -⟩
  exact SheafOfModules.Submodule.unit_obj_eq_top_of_map I t.op (hVtop w)

/-- **A sheaf of ideals is the whole structure sheaf on a chart all of whose points lie in its
unit locus.**  Membership in a sheaf of ideals is local, and the charts carrying the unit ideal
cover such a chart. -/
theorem idealSheaf_obj_eq_top_of_range_subset_idealUnitLocus
    (I : IdealSheaves B S hS X.1 X.2) (W : SmallEtale B S hS X.1)
    (hW : Set.range (pointsMap B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj W)) W.1.hom) ⊆
      idealUnitLocus B S hS X I) :
    I.obj (op W) = ⊤ := by
  refine eq_top_iff.2 fun z _ ↦ I.isSheaf z ?_
  refine (SmallEtale.topology B S hS X.1).superset_covering ?_
    (unitIdealSieve_mem_topology B S hS X I W hW)
  intro Y k hk
  have hk' : I.obj (op Y) = ⊤ := hk
  change _ ∈ I.obj (op Y)
  rw [hk']
  exact Submodule.mem_top

/-- The `n`-th power of the ideal of sections times all the sections of `M` lies in the sections
of the ideal-power multiple `ℐⁿ M`. -/
private theorem pow_ringSectionIdeal_smul_top_le
    (I : IdealSheaves B S hS X.1 X.2) (n : ℕ) (M : Modules.{u, m} B S hS X.1 X.2)
    (W : (smallEtaleRingedSite B S hS X.1 X.2).Cᵒᵖ) :
    Stacks.Sites.ringSectionIdeal I W ^ n • (⊤ : Submodule _ (M.val.obj W)) ≤
      (idealPowSubmodule I n M).obj W := by
  have h := Stacks.Sites.pow_smul_le_idealPowSmul I n (⊤ : M.Submodule) W
  rwa [show ((⊤ : M.Submodule).obj W) = (⊤ : Submodule _ (M.val.obj W)) from
    SetLike.ext fun z => ⟨fun _ => Submodule.mem_top,
      fun _ => Stacks.SheafOfModules.mem_top_obj z⟩] at h

/-- **The ideal-power multiple `ℐⁿ M` is all of `M` on a chart all of whose points lie in the
unit locus of `ℐ`.**  The unit section lies in `ℐ(W)ⁿ` there. -/
theorem idealPowSubmodule_obj_eq_top_of_range_subset_idealUnitLocus
    (I : IdealSheaves B S hS X.1 X.2) (n : ℕ) (M : Modules.{u, m} B S hS X.1 X.2)
    (W : SmallEtale B S hS X.1)
    (hW : Set.range (pointsMap B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj W)) W.1.hom) ⊆
      idealUnitLocus B S hS X I) :
    (idealPowSubmodule I n M).obj (op W) = ⊤ := by
  have h1 : Stacks.Sites.ringSectionIdeal I (op W) = ⊤ :=
    idealSheaf_obj_eq_top_of_range_subset_idealUnitLocus B S hS X I W hW
  have h2 := pow_ringSectionIdeal_smul_top_le B S hS X I n M (op W)
  rw [h1, Ideal.top_pow, Submodule.top_smul] at h2
  exact eq_top_iff.2 h2

/-! ### The inclusion of an ideal-power multiple over the complement of the ideal -/

/-- A morphism of `𝒪_Y`-modules bijective on the sections over every étale chart is an
isomorphism.  Bijectivity makes the underlying morphism of presheaves of modules both a
monomorphism and an epimorphism, hence an isomorphism in the abelian category of presheaves of
modules, and the forgetful functor from sheaves of modules reflects isomorphisms. -/
private theorem isIso_of_bijective_val_app {Y : AlgebraicSpaces B S hS}
    {P Q : Modules.{u, m} B S hS Y.1 Y.2} (φ : P ⟶ Q)
    (hinj : ∀ V, Function.Injective (φ.val.app V))
    (hsurj : ∀ V, Function.Surjective (φ.val.app V)) :
    IsIso φ := by
  have _ : Mono φ.val := PresheafOfModules.mono_of_injective (f := φ.val) fun {V} ↦ hinj V
  have _ : Epi φ.val := PresheafOfModules.epi_of_surjective (f := φ.val) fun {V} ↦ hsurj V
  have _ : IsIso ((SheafOfModules.forget
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O))).map φ) :=
    isIso_of_mono_of_epi φ.val
  exact isIso_of_reflects_iso φ (SheafOfModules.forget _)

/-- **Over an étale morphism landing in the unit locus of `ℐ` the inclusion `ℐⁿ M ⟶ M` becomes
an isomorphism.**

Restriction along an étale morphism is reindexing of sections, so over a chart of `Y` this
inclusion is the inclusion of the sections of `ℐⁿ M` over the composite chart of `X`, and those
are all of the sections of `M` there. -/
theorem isIso_etaleModulePullback_idealPowModuleι {Y : AlgebraicSpaces B S hS} (j : Y ⟶ X)
    (hj : IsEtale B S hS j.hom) (I : IdealSheaves B S hS X.1 X.2) (n : ℕ)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (hjU : Set.range (pointsMap B S hS Y.1 j.hom) ⊆ idealUnitLocus B S hS X I) :
    IsIso ((etaleModulePullback B S hS j hj).map (idealPowModuleι I n M)) := by
  have htop : ∀ W : SmallEtale B S hS Y.1, (idealPowSubmodule I n M).obj
      (op ((smallEtalePostcomp B S hS j hj).obj W)) = ⊤ := by
    intro W
    refine idealPowSubmodule_obj_eq_top_of_range_subset_idealUnitLocus B S hS X I n M _ ?_
    rintro x ⟨w, rfl⟩
    exact hjU ⟨_, (congrFun (pointsMap_comp B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS Y.1).obj W)) W.1.hom j.hom) w).symm⟩
  refine isIso_of_bijective_val_app B S hS _ (fun _ a b hab ↦ Subtype.ext hab) fun V z ↦ ?_
  obtain ⟨W⟩ := V
  exact ⟨⟨z, (htop W).ge Submodule.mem_top⟩, rfl⟩

/-- **The open complement of a closed subspace lands in the unit locus of its defining ideal
sheaf.**  The point set of a closed subspace is the zero locus of its defining ideal sheaf, and
the unit locus is the complement of that zero locus. -/
theorem range_pointsMap_openComplement_subset_idealUnitLocus
    (Z : ClosedSubspaces B S hS X.1) :
    Set.range (pointsMap B S hS (openComplement B S hS Z.1).toFunctor
        (openComplement B S hS Z.1).ι) ⊆
      idealUnitLocus B S hS X (definingIdealSheaf B S hS X Z) := by
  rw [range_pointsMap_ι_openComplement, range_pointsMap_ι_eq_idealZeroLocus, idealZeroLocus,
    compl_compl]

/-! ### The canonical map of the first display of Tag 07UM -/

/-- **The canonical map of the first display of [Stacks, Tag 07UM], term by term.**  A morphism
`φ : ℐⁿ G ⟶ F` restricts along an étale morphism `j : Y ⟶ X` whose image misses `V(ℐ)` to a
morphism `G|_Y ⟶ F|_Y`, the source being read through the isomorphism `ℐⁿ G|_Y ≅ G|_Y` of
`AlgebraicGeometry.Space.isIso_etaleModulePullback_idealPowModuleι`.

These maps agree along the transition maps of the direct system, which is
`AlgebraicGeometry.Space.idealPowHomRestrict_homOfLE`, so together they are a single map out of
`colim_n Hom_{𝒪_X}(ℐⁿ G, F)`.  The bijectivity asserted by the tag is not proved; see the
section "What is not proved" of the module documentation. -/
@[stacks 07UM "the canonical map of the first display, term by term"]
noncomputable def idealPowHomRestrict {Y : AlgebraicSpaces B S hS} (j : Y ⟶ X)
    (hj : IsEtale B S hS j.hom) (I : IdealSheaves B S hS X.1 X.2)
    (hjU : Set.range (pointsMap B S hS Y.1 j.hom) ⊆ idealUnitLocus B S hS X I)
    (n : ℕ) {M N : Modules.{u, u} B S hS X.1 X.2} (φ : idealPowModule I n M ⟶ N) :
    (etaleModulePullback B S hS j hj).obj M ⟶ (etaleModulePullback B S hS j hj).obj N :=
  have := isIso_etaleModulePullback_idealPowModuleι B S hS X j hj I n M hjU
  inv ((etaleModulePullback B S hS j hj).map (idealPowModuleι I n M)) ≫
    (etaleModulePullback B S hS j hj).map φ

/-- The canonical map of the first display is restriction along `j`: precomposed with the
restriction of the inclusion `ℐⁿ M ⟶ M` it is the restriction of `φ` itself. -/
theorem idealPowModuleι_comp_idealPowHomRestrict {Y : AlgebraicSpaces B S hS} (j : Y ⟶ X)
    (hj : IsEtale B S hS j.hom) (I : IdealSheaves B S hS X.1 X.2)
    (hjU : Set.range (pointsMap B S hS Y.1 j.hom) ⊆ idealUnitLocus B S hS X I)
    (n : ℕ) {M N : Modules.{u, u} B S hS X.1 X.2} (φ : idealPowModule I n M ⟶ N) :
    (etaleModulePullback B S hS j hj).map (idealPowModuleι I n M) ≫
        idealPowHomRestrict B S hS X j hj I hjU n φ =
      (etaleModulePullback B S hS j hj).map φ := by
  have := isIso_etaleModulePullback_idealPowModuleι B S hS X j hj I n M hjU
  simp [idealPowHomRestrict]

/-- **The canonical map of the first display agrees along the transition maps of the direct
system.**  Precomposing `φ : ℐⁿ M ⟶ N` with the inclusion `ℐᵏ M ⟶ ℐⁿ M` of a higher power does
not change its restriction to the complement of `V(ℐ)`; this is what makes the family of maps
`AlgebraicGeometry.Space.idealPowHomRestrict` a single map out of the colimit. -/
theorem idealPowHomRestrict_homOfLE {Y : AlgebraicSpaces B S hS} (j : Y ⟶ X)
    (hj : IsEtale B S hS j.hom) (I : IdealSheaves B S hS X.1 X.2)
    (hjU : Set.range (pointsMap B S hS Y.1 j.hom) ⊆ idealUnitLocus B S hS X I)
    {n k : ℕ} (h : n ≤ k) {M N : Modules.{u, u} B S hS X.1 X.2}
    (φ : idealPowModule I n M ⟶ N) :
    idealPowHomRestrict B S hS X j hj I hjU k (idealPowModuleHomOfLE I M h ≫ φ) =
      idealPowHomRestrict B S hS X j hj I hjU n φ := by
  have := isIso_etaleModulePullback_idealPowModuleι B S hS X j hj I n M hjU
  have := isIso_etaleModulePullback_idealPowModuleι B S hS X j hj I k M hjU
  have hcomp : (etaleModulePullback B S hS j hj).map (idealPowModuleHomOfLE I M h) ≫
      (etaleModulePullback B S hS j hj).map (idealPowModuleι I n M) =
      (etaleModulePullback B S hS j hj).map (idealPowModuleι I k M) := by
    rw [← Functor.map_comp, idealPowModuleHomOfLE_comp_ι]
  have h1 : inv ((etaleModulePullback B S hS j hj).map (idealPowModuleι I k M)) ≫
      (etaleModulePullback B S hS j hj).map (idealPowModuleHomOfLE I M h) =
      inv ((etaleModulePullback B S hS j hj).map (idealPowModuleι I n M)) := by
    rw [IsIso.inv_comp_eq, IsIso.eq_comp_inv]
    exact hcomp
  simp only [idealPowHomRestrict, Functor.map_comp, ← Category.assoc, h1]

/-! ### The sectionwise kernel of a morphism of modules -/

/-- **The sectionwise kernel of a morphism of `𝒪_X`-modules, as a submodule of the source.**
Membership is local because the target is a sheaf. -/
noncomputable def homKernelSubmodule {P Q : Modules.{u, m} B S hS X.1 X.2} (φ : P ⟶ Q) :
    P.Submodule where
  toSubmodule :=
    { obj V := LinearMap.ker (φ.val.app V).hom
      map {U V} g := by
        intro t ht
        change φ.val.app V (P.val.map g t) = 0
        rw [PresheafOfModules.naturality_apply, show φ.val.app U t = 0 from ht]
        exact map_zero _ }
  isSheaf := by
    intro U t ht
    change φ.val.app U t = 0
    have hQ : Presieve.IsSheaf (smallEtaleRingedSite B S hS X.1 X.2).J
        (Q.val.presheaf ⋙ forget AddCommGrpCat.{m}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        (GrothendieckTopology.HasSheafCompose.isSheaf _ Q.isSheaf)
    refine (hQ _ ht).isSeparatedFor.ext fun V g hg => ?_
    change Q.val.map g.op (φ.val.app U t) = Q.val.map g.op 0
    rw [← PresheafOfModules.naturality_apply, map_zero]
    exact hg

/-- The inclusion of the sectionwise kernel followed by the morphism is zero. -/
theorem homKernelSubmodule_ι_comp {P Q : Modules.{u, m} B S hS X.1 X.2} (φ : P ⟶ Q) :
    (homKernelSubmodule B S hS X φ).ι ≫ φ = 0 := by
  ext U t
  change (φ.val.app U).hom (((homKernelSubmodule B S hS X φ).ι.val.app U).hom t) = 0
  exact LinearMap.mem_ker.mp t.property

/-- A morphism killed by `φ` factors through the sectionwise kernel of `φ`. -/
noncomputable def homKernelSubmoduleLift {P Q L : Modules.{u, m} B S hS X.1 X.2} (φ : P ⟶ Q)
    (g : L ⟶ P) (hg : g ≫ φ = 0) :
    L ⟶ (homKernelSubmodule B S hS X φ).toSheafOfModules where
  val :=
    { app := fun U => ModuleCat.ofHom ((g.val.app U).hom.codRestrict _ (fun x =>
        congrArg (fun k : L ⟶ Q => k.val.app U x) hg))
      naturality := fun {U V} h => by
        ext x
        exact Subtype.ext (PresheafOfModules.naturality_apply g.val h x) }

/-- The factorisation through the sectionwise kernel is compatible with its inclusion. -/
theorem homKernelSubmoduleLift_ι {P Q L : Modules.{u, m} B S hS X.1 X.2} (φ : P ⟶ Q)
    (g : L ⟶ P) (hg : g ≫ φ = 0) :
    homKernelSubmoduleLift B S hS X φ g hg ≫ (homKernelSubmodule B S hS X φ).ι = g := rfl

/-- **The sectionwise kernel of a morphism of `𝒪_X`-modules is its categorical kernel.** -/
noncomputable def homKernelSubmoduleIso {P Q : Modules.{u, u} B S hS X.1 X.2} (φ : P ⟶ Q) :
    (homKernelSubmodule B S hS X φ).toSheafOfModules ≅ kernel φ where
  hom := kernel.lift φ (homKernelSubmodule B S hS X φ).ι (homKernelSubmodule_ι_comp B S hS X φ)
  inv := homKernelSubmoduleLift B S hS X φ (kernel.ι φ) (kernel.condition φ)
  hom_inv_id := by
    apply (cancel_mono (homKernelSubmodule B S hS X φ).ι).mp
    simp only [Category.assoc, homKernelSubmoduleLift_ι, kernel.lift_ι, Category.id_comp]
  inv_hom_id := by
    apply (cancel_mono (kernel.ι φ)).mp
    simp only [Category.assoc, kernel.lift_ι, homKernelSubmoduleLift_ι, Category.id_comp]

/-- A morphism of `𝒪_X`-modules vanishing on every section over every chart is zero. -/
private theorem eq_zero_of_forall_val_app_apply {P Q : Modules.{u, m} B S hS X.1 X.2}
    (ψ : P ⟶ Q) (h : ∀ V t, ψ.val.app V t = 0) : ψ = 0 := by
  ext V t
  exact h V t

/-! ### Injectivity of the canonical map of the first display -/

/-- A module annihilated by `ℐᵏ` has every product of a section of `ℐᵏ` with one of its
sections equal to zero, chart by chart. -/
private theorem smul_eq_zero_of_idealSmul_idealPow_eq_bot
    (I : IdealSheaves B S hS X.1 X.2) (k : ℕ) (P : Modules.{u, u} B S hS X.1 X.2)
    (hk : Stacks.Sites.idealSmul (M := P)
      (Stacks.Sites.idealPow (O := (smallEtaleRingedSite B S hS X.1 X.2).O) I k) ⊤ = ⊥)
    {Y : (smallEtaleRingedSite B S hS X.1 X.2).Cᵒᵖ}
    {b : ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj Y}
    (hb : b ∈ Stacks.Sites.sectionIdeal I Y ^ k) (t : P.val.obj Y) : b • t = 0 := by
  have hmem := Stacks.Sites.smul_mem_idealSmul (M := P)
    (Stacks.Sites.idealPow (O := (smallEtaleRingedSite B S hS X.1 X.2).O) I k)
    (N := ⊤) (Stacks.Sites.mem_idealPow_of_mem_pow I k hb)
    (Stacks.SheafOfModules.mem_top_obj t)
  have hz := SheafOfModules.Submodule.le_iff.1 hk.le Y hmem
  rw [SheafOfModules.Submodule.bot_obj] at hz
  exact (Submodule.mem_bot _).1 hz

/-- Over a chart, the honest `(k + n)`-th power of the ideal of sections times the sections of
`G` lands in the sections of `ℐⁿ G` killed by a morphism `π` whose target is annihilated by
`ℐᵏ`. -/
private theorem pow_ringSectionIdeal_smul_le_map_ker
    (I : IdealSheaves B S hS X.1 X.2) (n k : ℕ) (M Q : Modules.{u, u} B S hS X.1 X.2)
    (π : idealPowModule I n M ⟶ Q)
    (hann : ∀ {Y : (smallEtaleRingedSite B S hS X.1 X.2).Cᵒᵖ}
      {b : ((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj Y},
      b ∈ Stacks.Sites.sectionIdeal I Y ^ k → ∀ t : Q.val.obj Y, b • t = 0)
    (Z : SmallEtale B S hS X.1) :
    Stacks.Sites.ringSectionIdeal I (op Z) ^ (k + n) •
        (⊤ : Submodule _ (M.val.obj (op Z))) ≤
      Submodule.map ((idealPowSubmodule I n M).obj (op Z)).subtype
        (LinearMap.ker (π.val.app (op Z)).hom) := by
  rw [pow_add, Submodule.mul_smul]
  refine Submodule.smul_le.2 fun b hb y hy => ?_
  have hy' := pow_ringSectionIdeal_smul_top_le B S hS X I n M (op Z) hy
  refine ⟨b • (⟨y, hy'⟩ : (idealPowModule I n M).val.obj (op Z)), ?_, rfl⟩
  exact (map_smul _ _ _).trans (hann hb _)

/-- Composition of morphisms of modules, read on a section over a chart. -/
private theorem modulesComp_val_app_apply {P P' Q : Modules.{u, m} B S hS X.1 X.2}
    (f : P ⟶ P') (g : P' ⟶ Q) (V : (smallEtaleRingedSite B S hS X.1 X.2).Cᵒᵖ)
    (t : P.val.obj V) : (f ≫ g).val.app V t = g.val.app V (f.val.app V t) := rfl

/-- The inclusion of one submodule of a sheaf of modules into a larger one does not change the
underlying section. -/
private theorem val_submodule_homOfLE_app {P : Modules.{u, m} B S hS X.1 X.2}
    {N₁ N₂ : P.Submodule} (h : N₁ ≤ N₂)
    (V : (smallEtaleRingedSite B S hS X.1 X.2).Cᵒᵖ) (t : N₁.toSheafOfModules.val.obj V) :
    ((Stacks.SheafOfModules.Submodule.homOfLE h).val.app V t).1 = t.1 := rfl

/-- The composite `ℐᵏ⁺ⁿ G ⟶ ℐⁿ G ⟶ Q` kills a section of `ℐᵏ⁺ⁿ G` whose underlying section of
`G` lies in the sections of `ℐⁿ G` killed by `π`. -/
private theorem idealPowModuleHomOfLE_val_app_eq_zero
    (I : IdealSheaves B S hS X.1 X.2) (n k : ℕ) (M Q : Modules.{u, u} B S hS X.1 X.2)
    (π : idealPowModule I n M ⟶ Q)
    (Z : SmallEtale B S hS X.1) (z : (idealPowModule I (k + n) M).val.obj (op Z))
    (hz : z.1 ∈ Submodule.map ((idealPowSubmodule I n M).obj (op Z)).subtype
      (LinearMap.ker (π.val.app (op Z)).hom)) :
    π.val.app (op Z)
      ((idealPowModuleHomOfLE I M (Nat.le_add_left n k)).val.app (op Z) z) = 0 := by
  obtain ⟨x, hx, hxv⟩ := hz
  have he : (idealPowModuleHomOfLE I M (Nat.le_add_left n k)).val.app (op Z) z = x :=
    Subtype.ext ((val_submodule_homOfLE_app B S hS X
      (idealPowSubmodule_antitone I M (Nat.le_add_left n k)) (op Z) z).trans hxv.symm)
  exact (congrArg (fun t => π.val.app (op Z) t) he).trans hx

/-- The composite `ℐᵏ⁺ⁿ G ⟶ ℐⁿ G ⟶ Q` is zero when `ℐᵏ` annihilates `Q`: a section of
`ℐᵏ⁺ⁿ G` is an honest `(k + n)`-fold product on a covering sieve, and `Q` is a sheaf. -/
private theorem idealPowModuleHomOfLE_comp_eq_zero_of_annihilated
    (I : IdealSheaves B S hS X.1 X.2) (n k : ℕ) (M Q : Modules.{u, u} B S hS X.1 X.2)
    (π : idealPowModule I n M ⟶ Q)
    (hann : ∀ {Y : (smallEtaleRingedSite B S hS X.1 X.2).Cᵒᵖ}
      {b : ((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS X.1 X.2).O)).obj.obj Y},
      b ∈ Stacks.Sites.sectionIdeal I Y ^ k → ∀ t : Q.val.obj Y, b • t = 0) :
    idealPowModuleHomOfLE I M (Nat.le_add_left n k) ≫ π = 0 := by
  refine eq_zero_of_forall_val_app_apply B S hS X _ ?_
  intro V s
  obtain ⟨Y⟩ := V
  have hQsep : Presieve.IsSheaf (smallEtaleRingedSite B S hS X.1 X.2).J
      (Q.val.presheaf ⋙ forget AddCommGrpCat.{u}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (GrothendieckTopology.HasSheafCompose.isSheaf _ Q.isSheaf)
  obtain ⟨Sv, hSv, hres⟩ :=
    exists_sieve_mem_pow_chartSectionIdeal_smul_top_of_mem_idealPowSubmodule
      B S hS X.1 X.2 I M (k + n) (U := Y) (t := s.1) s.2
  refine (hQsep _ hSv).isSeparatedFor.ext fun Z g hg => ?_
  change Q.val.map g.op
      ((idealPowModuleHomOfLE I M (Nat.le_add_left n k) ≫ π).val.app (op Y) s) =
    Q.val.map g.op 0
  rw [← PresheafOfModules.naturality_apply, map_zero]
  exact (modulesComp_val_app_apply B S hS X (idealPowModuleHomOfLE I M (Nat.le_add_left n k)) π
      (op Z) _).trans
    (idealPowModuleHomOfLE_val_app_eq_zero B S hS X I n k M Q π Z _
      (pow_ringSectionIdeal_smul_le_map_ker B S hS X I n k M Q π hann Z (hres g hg)))

/-- The quotient of `ℐⁿ G` by the sectionwise kernel of `φ` has no sections over a chart on
which `ℐ` is the whole structure sheaf, so its support lies in the zero locus of `ℐ`. -/
private theorem supportOfSheaf_cokernel_homKernelSubmodule_subset
    (I : IdealSheaves B S hS X.1 X.2) (n : ℕ) (M N : Modules.{u, u} B S hS X.1 X.2)
    (φ : idealPowModule I n M ⟶ N)
    (hφ : ∀ W : SmallEtale B S hS X.1, I.obj (op W) = ⊤ → φ.val.app (op W) = 0) :
    supportOfSheaf B S hS X.1 ((SheafOfModules.toSheaf _).obj
        (cokernel (C := Modules.{u, u} B S hS X.1 X.2)
          (homKernelSubmodule B S hS X φ).ι)) ⊆ idealZeroLocus B S hS X I := by
  refine supportOfSheaf_subset_idealZeroLocus_of_forall_subsingleton B S hS X _ I ?_
  intro V hV W g
  refine subsingleton_cokernel_val_obj_of_forall_mem B S hS X _
    (homKernelSubmodule B S hS X φ) W ?_
  intro W' b t
  have hW' : I.obj (op W') = ⊤ :=
    SheafOfModules.Submodule.unit_obj_eq_top_of_map I (b ≫ g).op hV
  change φ.val.app (op W') t = 0
  rw [hφ W' hW']
  rfl

/-- **Injectivity of the canonical map of the first display of [Stacks, Tag 07UM].**

Let `X` be a Noetherian algebraic space, let `ℐ ⊆ 𝒪_X` be a quasi-coherent sheaf of ideals, let
`G` and `F` be coherent `𝒪_X`-modules and let `φ : ℐⁿ G ⟶ F`.  Suppose `φ` vanishes on the
sections over every étale chart on which `ℐ` is the whole structure sheaf — by
`AlgebraicGeometry.Space.idealSheaf_obj_eq_top_of_range_subset_idealUnitLocus` those are exactly
the charts lying over `U = X \ V(ℐ)`, so this is the chartwise reading of the vanishing of the
restriction of `φ` to `U`.  Then `φ` is already killed by the transition map
`ℐᵏ⁺ⁿ G ⟶ ℐⁿ G` of the direct system, for some `k`.  That is the injectivity of the canonical
map out of `colim_n Hom_{𝒪_X}(ℐⁿ G, F)`, whose terms are
`AlgebraicGeometry.Space.idealPowHomRestrict`.

The argument needs no étale descent.  Write `φ` as `ℐⁿ G ⟶ Q ⟶ F`, where `Q` is the quotient of
`ℐⁿ G` by the sectionwise kernel of `φ`.  That kernel is the categorical one, so `Q` is the
cokernel of a map of coherent modules and hence coherent; and `Q` has no sections over a chart
carrying the unit ideal, since there every section of `ℐⁿ G` is killed by `φ`.  So the support
of `Q` lies in `V(ℐ)` and [Stacks, Tag 07UK] produces a `k` with `ℐᵏ Q = 0`.  Over a chart a
section of `ℐᵏ⁺ⁿ G` becomes, on a covering sieve, a sum of products of a `k`-fold product of
sections of `ℐ` with a section of `ℐⁿ G`; each such product dies on the way to `Q`, so the
composite into `Q` vanishes on that sieve, hence vanishes, hence so does the composite with
`φ`.

**No `@[stacks 07UM]` attribute is placed here.**  The tag asks only that `F` be *quasi-coherent*,
and this statement asks `N` — the tag's `F` — to be *coherent*, so registering the tag here would
register the injectivity clause under a hypothesis the tag does not make.  The clause at the tag's
own hypotheses is `AlgebraicGeometry.Space.canonicalMapToHomRestrict_injective` of
`StacksFrontier/AlgebraicGeometry/Spaces/CoherentHomColimitInjective.lean`, which runs this argument
on the image of `φ` instead of on the quotient and so needs nothing of `F` beyond
quasi-coherence; it is folded into the tagged
`AlgebraicGeometry.Space.canonicalMapToHomRestrict_bijective` of
`StacksFrontier/AlgebraicGeometry/Spaces/CoherentHomColimitBijective.lean`. -/
theorem exists_idealPowModuleHomOfLE_comp_eq_zero
    (hTop : B.Contains (⊤_ Scheme.{u})) (hN : IsNoetherian B S hS hTop X.1)
    (I : IdealSheaves B S hS X.1 X.2) (hI : I.toSheafOfModules.IsQuasicoherentOnSite)
    (n : ℕ) (M N : Modules.{u, u} B S hS X.1 X.2)
    (hM : IsCoherent B S hS X.1 X.2 M) (hNc : IsCoherent B S hS X.1 X.2 N)
    (φ : idealPowModule I n M ⟶ N)
    (hφ : ∀ W : SmallEtale B S hS X.1, I.obj (op W) = ⊤ → φ.val.app (op W) = 0) :
    ∃ k : ℕ, idealPowModuleHomOfLE I M (Nat.le_add_left n k) ≫ φ = 0 := by
  have _ : Fact (HasEtaleLocalProperty B S hS X.1
    (fun V : Scheme.{u} => IsLocallyNoetherian V)) := ⟨hN.2.2⟩
  have hAc : IsCoherent B S hS X.1 X.2 (idealPowModule I n M) := by
    have h := isCoherent_idealPowerMultiple B S hS X.1 X.2 I hI M hM n
    rwa [idealPowerMultiple_eq_idealPowSubmodule] at h
  have _ : SheafOfModules.IsCoherentOnSite
      (homKernelSubmodule B S hS X φ).toSheafOfModules :=
    Stacks.SheafOfModules.isCoherentOnSite_of_iso (homKernelSubmoduleIso B S hS X φ).symm
      (isCoherent_kernel B S hS X.1 X.2 hAc hNc φ).toIsCoherentOnSite
  have hKc : IsCoherent B S hS X.1 X.2 (homKernelSubmodule B S hS X φ).toSheafOfModules :=
    isCoherent_of_isCoherentOnSite B S hS X.1 X.2 _
  have hQc : IsCoherent B S hS X.1 X.2 (cokernel (C := Modules.{u, u} B S hS X.1 X.2)
      (homKernelSubmodule B S hS X φ).ι) :=
    isCoherent_cokernel B S hS X.1 X.2 hKc hAc _
  obtain ⟨k, hk⟩ := (exists_idealPowSmul_eq_bot_iff_supportOfSheaf_subset_idealZeroLocus
    B S hS hTop X hN _ hQc I hI).2
    (supportOfSheaf_cokernel_homKernelSubmodule_subset B S hS X I n M N φ hφ)
  refine ⟨k, ?_⟩
  have hkey := idealPowModuleHomOfLE_comp_eq_zero_of_annihilated B S hS X I n k M
    (cokernel (C := Modules.{u, u} B S hS X.1 X.2) (homKernelSubmodule B S hS X φ).ι)
    (cokernel.π (C := Modules.{u, u} B S hS X.1 X.2) (homKernelSubmodule B S hS X φ).ι)
    (fun {Y b} hb t => smul_eq_zero_of_idealSmul_idealPow_eq_bot B S hS X I k _ hk hb t)
  rw [← cokernel.π_desc (C := Modules.{u, u} B S hS X.1 X.2)
    (homKernelSubmodule B S hS X φ).ι φ (homKernelSubmodule_ι_comp B S hS X φ),
    ← Category.assoc, hkey, zero_comp]

