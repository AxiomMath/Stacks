/-! ### Clearing the denominators -/

/-- A submodule containing a unit multiple of an element contains the element. -/
theorem mem_of_isUnit_smul_mem {R₀ M₀ : Type*} [CommRing R₀] [AddCommGroup M₀]
    [Module R₀ M₀] {N : Submodule R₀ M₀} {c : R₀} (hc : IsUnit c) {x : M₀}
    (hx : c • x ∈ N) : x ∈ N :=
  (Submodule.smul_mem_iff_of_isUnit N hc).1 hx

/-- If the elements `g i` of a localized module span it and each `g i` is the fraction with
numerator `q i` and denominator in the submonoid, then the images of the `q i` under the
localization map already span. -/
private lemma span_image_eq_top_of_span_range_eq_top {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] (p : Submonoid R) (A : Type*) [CommRing A] [Algebra R A]
    [IsLocalization p A] {L : Type*} [AddCommGroup L] [Module R L] [Module A L]
    [IsScalarTower R A L] (mk : M →ₗ[R] L) [IsLocalizedModule p mk] {ι : Type*} (g : ι → L)
    (hg : Submodule.span A (Set.range g) = ⊤) (q : ι → M) (s : ι → p)
    (hq : ∀ i, IsLocalizedModule.mk' mk (q i) (s i) = g i) :
    Submodule.span A (mk '' Set.range q) = ⊤ := by
  refine top_le_iff.1 (hg.ge.trans (Submodule.span_le.2 ?_))
  rintro _ ⟨i, rfl⟩
  have hspec : (s i : R) • g i = mk (q i) := by
    rw [← hq i]
    exact IsLocalizedModule.mk'_cancel' mk (q i) (s i)
  have hmem : (s i : R) • g i ∈ Submodule.span A (mk '' Set.range q) := by
    rw [hspec]
    exact Submodule.subset_span ⟨q i, ⟨i, rfl⟩, rfl⟩
  obtain ⟨w, hw⟩ := IsLocalization.map_units A (s i)
  rw [← IsScalarTower.algebraMap_smul A (s i : R) (g i), ← hw] at hmem
  have hsm := Submodule.smul_mem _ (↑w⁻¹ : A) hmem
  rwa [smul_smul, Units.inv_mul, one_smul] at hsm

/-- **Local generators of a strict transform, in commutative algebra.**  Let `M` be a finite
module over a commutative ring `R` whose `k`-th Fitting ideal is generated by one element `f`,
and let `p` be a prime ideal of `R`.  Then there is an element `h` of `R` outside `p` and a
family of `k` elements of `M` such that some power of `h` carries every element of `M` into the
submodule generated by that family together with the `f`-power torsion of `M`. -/
theorem exists_notMem_and_fin_span_sup_primaryComponent {R : Type u} {M : Type v}
    [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R)
    (hfit : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (p : Ideal R) (hp : p.IsPrime) :
    ∃ h : R, h ∉ p ∧ ∃ t : Fin k → M, ∀ y : M, ∃ j : ℕ,
      h ^ j • y ∈ Submodule.span R (Set.range t) ⊔
        Ideal.primaryComponent M (Ideal.span {f}) := by
  classical
  have := hp
  set T : Submodule R M := Ideal.primaryComponent M (Ideal.span {f}) with hT
  obtain ⟨g, hg⟩ := exists_fin_span_atPrime_quotient_primaryComponent k f hfit p
  choose y hy using fun i : Fin k =>
    IsLocalizedModule.mk'_surjective p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl (M ⧸ T)) (g i)
  have hspan : Submodule.span (Localization.AtPrime p)
      (LocalizedModule.mkLinearMap p.primeCompl (M ⧸ T) ''
        Set.range fun i => (y i).1) = ⊤ :=
    span_image_eq_top_of_span_range_eq_top p.primeCompl (Localization.AtPrime p)
      (LocalizedModule.mkLinearMap p.primeCompl (M ⧸ T)) g hg
      (fun i => (y i).1) (fun i => (y i).2) hy
  choose t ht using fun i : Fin k => Submodule.Quotient.mk_surjective T (y i).1
  set N : Submodule R M := Submodule.span R (Set.range t) ⊔ T with hN
  have hptQ : ∀ m : M ⧸ T, ∃ x : p.primeCompl,
      (x : R) • m ∈ Submodule.span R (Set.range fun i => (y i).1) :=
    (Submodule.span_image_eq_top_iff (Localization.AtPrime p) p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl (M ⧸ T)) _).1 hspan
  have hmapspan : Submodule.span R (Set.range fun i => (y i).1) =
      (Submodule.span R (Set.range t)).map (Submodule.mkQ T) := by
    rw [Submodule.map_span]
    congr 1
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i => (ht i).symm)
  have hptM : ∀ z : M, ∃ x : p.primeCompl, (x : R) • z ∈ N := by
    intro z
    obtain ⟨x, hx⟩ := hptQ (Submodule.Quotient.mk z)
    rw [hmapspan] at hx
    obtain ⟨w, hw, hwz⟩ := hx
    refine ⟨x, ?_⟩
    have hdiff : (x : R) • z - w ∈ T := by
      rw [← Submodule.Quotient.mk_eq_zero T, ← Submodule.mkQ_apply, map_sub, hwz,
        Submodule.mkQ_apply, Submodule.Quotient.mk_smul, sub_self]
    have hsum := Submodule.add_mem (Submodule.span R (Set.range t) ⊔ T)
      (Submodule.mem_sup_left hw) (Submodule.mem_sup_right hdiff)
    rw [hN]
    simpa using hsum
  have hsub : Subsingleton (LocalizedModule p.primeCompl (M ⧸ N)) :=
    (Submodule.subsingleton_iff_forall_exists_smul_mem p.primeCompl N
      (LocalizedModule.mkLinearMap p.primeCompl (M ⧸ N))).2 hptM
  obtain ⟨h, hhp, hh⟩ := LocalizedModule.exists_mem_subsingleton_away p.primeCompl hsub
  refine ⟨h, hhp, t, fun z => ?_⟩
  obtain ⟨x, hx⟩ := (Submodule.subsingleton_iff_forall_exists_smul_mem
    (Submonoid.powers h) N
    (LocalizedModule.mkLinearMap (Submonoid.powers h) (M ⧸ N))).1 hh z
  obtain ⟨j, hj⟩ := x.2
  exact ⟨j, by rw [show h ^ j = (x : R) from hj]; exact hx⟩

end Stacks.Fitting

namespace AlgebraicGeometry.Space

open CategoryTheory CategoryTheory.Limits Opposite

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-! ### Affine charts over a chart -/

/-- **The affine étale charts over an étale chart generate a covering sieve of it.** -/
theorem generate_isAffine_mem_topology (W : SmallEtale B S hS F) :
    Sieve.generate (fun (Z : SmallEtale B S hS F) (_ : Z ⟶ W) => IsAffine (chartScheme Z)) ∈
      SmallEtale.topology B S hS F W := by
  refine smallEtale_sieve_of_pointwise_covering B S hS F W _ fun z => ?_
  obtain ⟨T₀, m, hT₀, w₀, hw₀⟩ := exists_affine_chart_at B S hS F W z
  exact ⟨T₀, m, ⟨T₀, 𝟙 _, m, hT₀, Category.id_comp _⟩, w₀, hw₀⟩

/-- Functoriality of the underlying map of schemes of a composite of chart morphisms, on
points. -/
private theorem toScheme_map_comp_apply {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {A₁ A₂ A₃ : SmallEtale B S hS F} (u : A₁ ⟶ A₂) (v : A₂ ⟶ A₃) (w : chartScheme A₁) :
    (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map (u ≫ v)) w =
      (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map v)
        ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map u) w) := by
  simp only [Functor.map_comp]
  rfl

/-! ### The point set of a closed subspace on an affine chart -/

section ZeroLocus

attribute [local instance] pointTopology

/-- **The range of a closed immersion into an affine scheme is the zero locus of the ideal of
global sections cutting it out.** -/
private theorem range_eq_zeroLocus_of_ker_eq_ofIdealTop {W Y : Scheme.{u}} [IsAffine Y]
    (φ : W ⟶ Y) [_root_.AlgebraicGeometry.IsClosedImmersion φ] {J : Ideal Γ(Y, ⊤)}
    (hker : φ.ker = Scheme.IdealSheafData.ofIdealTop J) :
    Set.range ⇑φ = Y.zeroLocus (U := ⊤) (J : Set Γ(Y, ⊤)) := by
  have hcl : closure (Set.range ⇑φ) = Set.range ⇑φ :=
    (_root_.AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
      φ).isClosed_range.closure_eq
  rw [← hcl, ← Scheme.Hom.support_ker φ, hker]
  exact Scheme.IdealSheafData.coe_support_ofIdealTop J

/-- **On an affine étale chart the preimage of the point set of a closed subspace is the zero
locus of its defining ideal there.** -/
theorem preimage_chartPointsMap_range_ι_eq_zeroLocus (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (V : SmallEtale B S hS X.1)
    (hV : IsAffine (chartScheme V)) (I : Ideal (chartRing B S hS X.1 X.2 V))
    (hI : definingIdealAt B S hS X D (op V) = I) :
    chartPointsMap V ⁻¹' Set.range (pointsMap B S hS D.1.toFunctor D.1.ι) =
      (chartScheme V).zeroLocus (U := ⊤) (I : Set (chartRing B S hS X.1 X.2 V)) := by
  subst hI
  have hVa : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) := hV
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)) :=
    D.2.2.property_snd V.1.hom
  have hrange := range_eq_zeroLocus_of_ker_eq_ofIdealTop
    ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom))
    (ker_rep_snd_eq_ofIdealTop_definingIdealAt B S hS X D V)
  have h1 : pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj V)) V.1.hom ⁻¹'
        Set.range (pointsMap B S hS D.1.toFunctor D.1.ι) =
      pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) ⁻¹'
        Set.range ⇑((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)) :=
    (preimage_range_pointsMap_eq_range_pointsMap_snd B S hS D.2.2.rep V.1.hom).trans
      (range_pointsMap_yoneda_eq_preimage B S hS (D.2.2.rep.snd V.1.hom))
  have h2 : ⇑(schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS X.1).obj V)).symm ⁻¹'
        (pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V) ⁻¹'
          Set.range ⇑((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom))) =
      Set.range ⇑((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd V.1.hom)) := by
    ext x
    simp only [Set.mem_preimage]
    rw [show pointsToScheme B S hS ((SmallEtale.toOver B S hS X.1).obj V)
        ((schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS X.1).obj V)).symm x) = x from
      (schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS X.1).obj V)).apply_symm_apply x]
  rwa [preimage_chartPointsMap, h1, h2]

/-- **The sections supported on a closed subspace over an affine chart are exactly the
ideal-power torsion of a generator of its defining ideal there.**  This is Stacks 0859 (2) at the
point set of a closed subspace. -/
theorem mem_supportedSectionsSubmodule_iff_mem_primaryComponent (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (G : Modules.{u, u} B S hS X.1 X.2)
    (hG : G.IsQuasicoherentOnSite) (V : SmallEtale B S hS X.1)
    (hV : IsAffine (chartScheme V)) (g : chartRing B S hS X.1 X.2 V)
    (hgen : definingIdealAt B S hS X D (op V) = Ideal.span {g})
    (s : G.val.obj (op V)) :
    s ∈ (supportedSectionsSubmodule B S hS X.1 X.2
        (Set.range (pointsMap B S hS D.1.toFunctor D.1.ι)) G).toSubmodule.obj (op V) ↔
      s ∈ Ideal.primaryComponent (G.val.obj (op V)) (Ideal.span {g}) := by
  rw [mem_supportedSectionsSubmodule_iff,
    sectionSupportedIn_iff_exists_pow_le_annihilator B S hS X.2 G hG _ V hV
      (Submodule.fg_span_singleton g)
      (preimage_chartPointsMap_range_ι_eq_zeroLocus B S hS X D V hV (Ideal.span {g}) hgen) s,
    Ideal.primaryComponent_mem]
  refine ⟨fun ⟨n, hn⟩ ↦ ⟨n, ?_⟩, fun ⟨n, hn⟩ ↦ ⟨n, fun a ha ↦ ?_⟩⟩
  · rw [Submodule.mem_torsionBySet_iff]
    exact fun a ↦ hn a a.2
  · rw [Submodule.mem_torsionBySet_iff] at hn
    exact hn ⟨a, ha⟩

end ZeroLocus

/-! ### Generators of a cokernel on a chart -/

section Cokernel

variable {B S hS F hF}

/-- Restriction of a finite family of sections of an `𝒪_F`-module along a morphism of étale
charts. -/
noncomputable abbrev chartRestrictFamily (M : Modules.{u, u} B S hS F hF)
    {U V : SmallEtale B S hS F} (q : V ⟶ U) {r : ℕ} (t : Fin r → M.val.obj (op U)) :
    Fin r → M.val.obj (op V) := fun i => M.val.restrictₛₗ q.op (t i)

/-- Restricting a section twice is restricting it along the composite. -/
private theorem restrictₛₗ_comp_apply (N : Modules.{u, u} B S hS F hF)
    {U V W : SmallEtale B S hS F} (q : V ⟶ U) (k : W ⟶ V) (z : N.val.obj (op U)) :
    N.val.restrictₛₗ k.op (N.val.restrictₛₗ q.op z) = N.val.restrictₛₗ (k ≫ q).op z :=
  (PresheafOfModules.map_comp_apply N.val q.op k.op z).symm

/-- Restricting a family of sections twice is restricting it along the composite. -/
theorem chartRestrictFamily_comp (N : Modules.{u, u} B S hS F hF)
    {U V W : SmallEtale B S hS F} (q : V ⟶ U) (k : W ⟶ V) {r : ℕ}
    (v : Fin r → N.val.obj (op U)) :
    chartRestrictFamily N k (chartRestrictFamily N q v) = chartRestrictFamily N (k ≫ q) v :=
  funext fun i => restrictₛₗ_comp_apply N q k (v i)

/-- Restriction of a linear combination of a family of sections. -/
theorem restrictₛₗ_sum_smul (N : Modules.{u, u} B S hS F hF)
    {W W' : SmallEtale B S hS F} (k : W' ⟶ W) {r : ℕ}
    (a : Fin r → chartRing B S hS F hF W) (v : Fin r → N.val.obj (op W)) :
    N.val.restrictₛₗ k.op (∑ i, a i • v i) =
      ∑ i, chartRestrict (hF := hF) k (a i) • chartRestrictFamily N k v i :=
  (map_sum (N.val.restrictₛₗ k.op) (fun i => a i • v i) Finset.univ).trans
    (Finset.sum_congr rfl fun i _ => map_smulₛₗ (N.val.restrictₛₗ k.op) (a i) (v i))

/-- Restricting a linear-combination identity along a morphism of charts. -/
private theorem restrict_family_sum_smul_eq (N : Modules.{u, u} B S hS F hF)
    {U Y W W' : SmallEtale B S hS F} (p : W ⟶ U) (g : W ⟶ Y) (k : W' ⟶ W) {p' : W' ⟶ U}
    {g' : W' ⟶ Y} (hp : p' = k ≫ p) (hg : g' = k ≫ g) {r : ℕ}
    (v : Fin r → N.val.obj (op U)) (y : N.val.obj (op Y))
    (a : Fin r → chartRing B S hS F hF W)
    (ha : ∑ i, a i • chartRestrictFamily N p v i = N.val.restrictₛₗ g.op y) :
    ∑ i, chartRestrict (hF := hF) k (a i) • chartRestrictFamily N p' v i =
      N.val.restrictₛₗ g'.op y := by
  subst hp hg
  rw [← chartRestrictFamily_comp, ← restrictₛₗ_comp_apply N g k y, ← ha]
  exact (restrictₛₗ_sum_smul N k a (chartRestrictFamily N p v)).symm

/-- Extracting a linear combination from membership in a span joined with a submodule. -/
private theorem exists_fun_add_mem_of_le_span_sup {R₀ : Type*} [CommRing R₀] {M₀ : Type*}
    [AddCommGroup M₀] [Module R₀ M₀] {r : ℕ} {v : Fin r → M₀} {N : Submodule R₀ M₀}
    (h : (⊤ : Submodule R₀ M₀) ≤ Submodule.span R₀ (Set.range v) ⊔ N) (x : M₀) :
    ∃ (a : Fin r → R₀) (w : M₀), w ∈ N ∧ x = (∑ i, a i • v i) + w := by
  obtain ⟨y, hy, z, hz, hxyz⟩ := Submodule.mem_sup.1 (h (Submodule.mem_top (x := x)))
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun R₀).1 hy
  exact ⟨a, z, hz, by rw [ha, hxyz]⟩

/-- The projection onto the cokernel of a sheaf submodule kills the sections of the
submodule. -/
theorem cokernel_π_app_eq_zero_of_mem {M : Modules.{u, u} B S hS F hF} (K : M.Submodule)
    (X : SmallEtale B S hS F) (z : M.val.obj (op X)) (hz : z ∈ K.toSubmodule.obj (op X)) :
    (cokernel.π K.ι).val.app (op X) z = 0 := by
  show (K.ι ≫ cokernel.π K.ι).val.app (op X) ⟨z, hz⟩ = 0
  rw [cokernel.condition]
  rfl

/-- The images in the cokernel of a sheaf submodule of a finite family of sections of the
ambient module over a chart. -/
noncomputable abbrev cokernelSections {M : Modules.{u, u} B S hS F hF} (K : M.Submodule)
    (V : SmallEtale B S hS F) {r : ℕ} (t : Fin r → M.val.obj (op V)) :
    Fin r → (cokernel K.ι).val.obj (op V) :=
  fun i => (cokernel.π K.ι).val.app (op V) (t i)

/-- **The cokernel of a sheaf submodule is locally generated by the images of `r` sections.**
Let `K ⊆ M` be a sheaf submodule of an `𝒪_F`-module, let `V` be an étale chart of `F` and let
`t` be a family of `r` sections of `M` over `V` such that over every *affine* chart over `V` the
restrictions of `t` and the sections of `K` together generate the sections of `M`.  Then the
images of `t` in the cokernel of `K` generate it locally in the sense of
`Stacks.SheafOfModules.GeneratesLocally`. -/
theorem generatesLocally_cokernel_π_of_le_span_sup {M : Modules.{u, u} B S hS F hF}
    (K : M.Submodule) (V : SmallEtale B S hS F) (r : ℕ) (t : Fin r → M.val.obj (op V))
    (hgen : ∀ (Z : SmallEtale B S hS F) (q : Z ⟶ V), IsAffine (chartScheme Z) →
      (⊤ : Submodule (chartRing B S hS F hF Z) (M.val.obj (op Z))) ≤
        Submodule.span (chartRing B S hS F hF Z)
            (Set.range (chartRestrictFamily M q t)) ⊔ K.toSubmodule.obj (op Z)) :
    Stacks.SheafOfModules.GeneratesLocally (SmallEtale.topology B S hS F)
      (cokernel K.ι).val (cokernelSections K V t) := by
  classical
  have : Epi (cokernel.π K.ι) :=
    Cofork.IsColimit.epi (colimit.isColimit (parallelPair K.ι 0))
  intro V' f y
  refine ⟨{ arrows := fun W g => ∃ a : Fin r → chartRing B S hS F hF W,
              ∑ i, a i • chartRestrictFamily (cokernel K.ι) (g ≫ f) (cokernelSections K V t) i =
                (cokernel K.ι).val.restrictₛₗ g.op y
            downward_closed := ?_ }, ?_, fun W g hg => hg⟩
  · rintro W W' g ⟨a, ha⟩ k
    refine ⟨fun i => chartRestrict (hF := hF) k (a i), ?_⟩
    exact restrict_family_sum_smul_eq (cokernel K.ι) (g ≫ f) g k (Category.assoc ..) rfl _ y a
      ha
  · have hsh : HasSheafify (smallEtaleRingedSite B S hS F hF).J AddCommGrpCat.{u} := by
      show HasSheafify (SmallEtale.topology B S hS F) AddCommGrpCat.{u}
      infer_instance
    have _hwe : (smallEtaleRingedSite B S hS F hF).J.WEqualsLocallyBijective
        AddCommGrpCat.{u} := by
      show (SmallEtale.topology B S hS F).WEqualsLocallyBijective AddCommGrpCat.{u}
      infer_instance
    obtain ⟨S₁, hS₁, hsec⟩ :=
      Stacks.SheafOfModules.EpiMono.exists_covering_of_epi (cokernel.π K.ι) y
    refine (SmallEtale.topology B S hS F).transitive hS₁ _ fun W₁ g₁ hg₁ => ?_
    obtain ⟨x, hx⟩ := hsec g₁ hg₁
    refine (SmallEtale.topology B S hS F).superset_covering ?_
      (generate_isAffine_mem_topology B S hS F W₁)
    rintro W g ⟨A, h, pA, hA, rfl⟩
    obtain ⟨a, w, hwK, hxw⟩ := exists_fun_add_mem_of_le_span_sup
      (hgen A (pA ≫ g₁ ≫ f) hA) (M.val.restrictₛₗ pA.op x)
    have hsub : (cokernel.π K.ι).val.app (op A) (M.val.restrictₛₗ pA.op x) =
        (cokernel.π K.ι).val.app (op A)
          (∑ i, a i • chartRestrictFamily M (pA ≫ g₁ ≫ f) t i) := by
      rw [hxw, map_add, cokernel_π_app_eq_zero_of_mem K A w hwK, add_zero]
    have hleft : (cokernel.π K.ι).val.app (op A) (M.val.restrictₛₗ pA.op x) =
        (cokernel K.ι).val.restrictₛₗ (pA ≫ g₁).op y :=
      ((PresheafOfModules.naturality_apply (cokernel.π K.ι).val pA.op x).trans
        (congrArg ((cokernel K.ι).val.restrictₛₗ pA.op) hx)).trans
        (restrictₛₗ_comp_apply (cokernel K.ι) g₁ pA y)
    have hright : (cokernel.π K.ι).val.app (op A)
          (∑ i, a i • chartRestrictFamily M (pA ≫ g₁ ≫ f) t i) =
        ∑ i, a i • chartRestrictFamily (cokernel K.ι) (pA ≫ g₁ ≫ f)
          (cokernelSections K V t) i := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_smul]
      exact congrArg (fun z => a i • z)
        (PresheafOfModules.naturality_apply (cokernel.π K.ι).val (pA ≫ g₁ ≫ f).op (t i))
    refine ⟨fun i => chartRestrict (hF := hF) h (a i), ?_⟩
    have hA' : (cokernel K.ι).val.restrictₛₗ (pA ≫ g₁).op y =
        ∑ i, a i • chartRestrictFamily (cokernel K.ι) (pA ≫ g₁ ≫ f)
          (cokernelSections K V t) i := hleft.symm.trans (hsub.trans hright)
    exact restrict_family_sum_smul_eq (cokernel K.ι) (pA ≫ g₁ ≫ f) (pA ≫ g₁) h
      (Category.assoc ..) (Category.assoc ..) (cokernelSections K V t) y a hA'.symm

/-- **Generating sections of a cokernel on a chart, indexed by `Fin r`.**  The
`SheafOfModules.GeneratingSections` datum that
`AlgebraicGeometry.Space.generatesLocally_cokernel_π_of_le_span_sup` produces, with index type a
universe lift of `Fin r`. -/
noncomputable def cokernelGeneratingSectionsOfLeSpanSup {M : Modules.{u, u} B S hS F hF}
    (K : M.Submodule) (V : (smallEtaleRingedSite B S hS F hF).C) (r : ℕ)
    (t : Fin r → M.val.obj (op V))
    (hgen : ∀ (Z : SmallEtale B S hS F) (q : Z ⟶ V), IsAffine (chartScheme Z) →
      (⊤ : Submodule (chartRing B S hS F hF Z) (M.val.obj (op Z))) ≤
        Submodule.span (chartRing B S hS F hF Z)
            (Set.range (chartRestrictFamily M q t)) ⊔ K.toSubmodule.obj (op Z)) :
    ((cokernel K.ι).over V).GeneratingSections :=
  haveI _hsh : ∀ X : (smallEtaleRingedSite B S hS F hF).C,
      HasSheafify ((smallEtaleRingedSite B S hS F hF).J.over X) AddCommGrpCat.{u} :=
    fun X => SmallEtale.instHasSheafifyOver B S hS F _ X
  haveI _hwe : ∀ X : (smallEtaleRingedSite B S hS F hF).C,
      ((smallEtaleRingedSite B S hS F hF).J.over X).WEqualsLocallyBijective
        AddCommGrpCat.{u} :=
    fun X => SmallEtale.instWEqualsLocallyBijectiveOver B S hS F _ X
  { I := ULift.{u} (Fin r)
    s := fun j => Stacks.SheafOfModules.mkOver (cokernelSections K V t j.down)
    epi := Stacks.SheafOfModules.epi_freeHomEquiv_symm_mkOver
      (cokernelSections K V t ∘ (Equiv.ulift : ULift.{u} (Fin r) ≃ Fin r))
      (Stacks.SheafOfModules.generatesLocally_comp_equiv
        (Equiv.ulift : ULift.{u} (Fin r) ≃ Fin r) (cokernelSections K V t)
        (generatesLocally_cokernel_π_of_le_span_sup K V r t hgen)) }

end Cokernel

/-! ### Propagating a chartwise generating family to the charts above -/

section Propagate

/-- **A point of an affine scheme lies in the basic open of a function outside the
corresponding prime.** -/
private theorem mem_basicOpen_of_notMem_primeIdealOf (Y : Scheme.{u}) [IsAffine Y] (x : Y)
    (a : Γ(Y, ⊤)) (ha : a ∉ ((isAffineOpen_top Y).primeIdealOf ⟨x, trivial⟩).asIdeal) :
    x ∈ Y.basicOpen a := by
  have h1 : (isAffineOpen_top Y).primeIdealOf ⟨x, trivial⟩ ∈
      (isAffineOpen_top Y).fromSpec ⁻¹ᵁ Y.basicOpen a := by
    rw [IsAffineOpen.fromSpec_preimage_basicOpen]
    exact PrimeSpectrum.mem_basicOpen a _ |>.2 ha
  have h3 : (isAffineOpen_top Y).fromSpec ((isAffineOpen_top Y).primeIdealOf
      (⟨x, trivial⟩ : (⊤ : Y.Opens))) ∈ Y.basicOpen a := h1
  rwa [(isAffineOpen_top Y).fromSpec_primeIdealOf (⟨x, trivial⟩ : (⊤ : Y.Opens))] at h3

/-- **A chartwise generating family modulo a subsheaf, valid after inverting one function,
propagates to every affine chart above on which that function is invertible.**

Let `M` be an `𝒪_X`-module cartesian on affine charts, `K ⊆ M` a sheaf submodule, `V` an affine
chart and `t` a finite family of sections of `M` over `V` such that some power of `h` carries
every section over `V` into the submodule generated by `t` and `K`.  Then over every affine
chart `Z` over `V` on which the restriction of `h` is invertible the restrictions of `t`
generate `M` modulo `K` outright. -/
theorem le_span_sup_of_isUnit_chartRestrict (X : AlgebraicSpaces B S hS)
    (M : Modules.{u, u} B S hS X.1 X.2) (hM : IsCartesianOnAffineCharts M)
    (K : M.Submodule) (V : SmallEtale B S hS X.1) (hV : IsAffine (chartScheme V))
    {r : ℕ} (t : Fin r → M.val.obj (op V)) (h : chartRing B S hS X.1 X.2 V)
    (hgen : ∀ y : M.val.obj (op V), ∃ j : ℕ,
      h ^ j • y ∈ Submodule.span (chartRing B S hS X.1 X.2 V) (Set.range t) ⊔
        K.toSubmodule.obj (op V))
    (Z : SmallEtale B S hS X.1) (hZ : IsAffine (chartScheme Z)) (q : Z ⟶ V)
    (hunit : IsUnit (chartRestrict (hF := X.2) q h)) :
    (⊤ : Submodule (chartRing B S hS X.1 X.2 Z) (M.val.obj (op Z))) ≤
      Submodule.span (chartRing B S hS X.1 X.2 Z)
        (Set.range (chartRestrictFamily M q t)) ⊔ K.toSubmodule.obj (op Z) := by
  classical
  let _ := chartAlgebra (hF := X.2) q
  let _ := chartSectionsModule M q
  have _ := chartSections_isScalarTower M q
  set NZ : Submodule (chartRing B S hS X.1 X.2 Z) (M.val.obj (op Z)) :=
    Submodule.span (chartRing B S hS X.1 X.2 Z) (Set.range (chartRestrictFamily M q t)) ⊔
      K.toSubmodule.obj (op Z) with hNZ
  have hsub : Submodule.span (chartRing B S hS X.1 X.2 V) (Set.range t) ⊔
        K.toSubmodule.obj (op V) ≤
      Submodule.comap (chartRestrictLinear M q)
        (Submodule.restrictScalars (chartRing B S hS X.1 X.2 V) NZ) := by
    refine sup_le ?_ ?_
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact Submodule.mem_sup_left (Submodule.subset_span ⟨i, rfl⟩)
    · intro v hv
      exact Submodule.mem_sup_right (K.toSubmodule.map_mem q.op hv)
  have hres : ∀ y : M.val.obj (op V), chartRestrictLinear M q y ∈ NZ := by
    intro y
    obtain ⟨j, hj⟩ := hgen y
    have h1 : chartRestrictLinear M q (h ^ j • y) ∈ NZ := hsub hj
    rw [map_smul] at h1
    have hcu : IsUnit (chartRestrict (hF := X.2) q (h ^ j)) := by
      rw [map_pow]
      exact hunit.pow j
    exact Stacks.Fitting.mem_of_isUnit_smul_mem hcu h1
  exact ((chartBaseChange_surjective_iff_span_eq_top M q).1 (hM V Z hV hZ q).2).ge.trans
    (Submodule.span_le.2 (Set.range_subset_iff.2 hres))

end Propagate

/-! ### The chartwise Fitting ideal of a pullback -/

section FittingChart

/-- **The chartwise `k`-th Fitting ideal of the pullback of a module is the defining ideal of
the inverse image of its `k`-th Fitting closed subspace.**

Let `f : X ⟶ Y` be a morphism of algebraic spaces, let `G` be a quasi-coherent `𝒪_Y`-module
whose sections over every affine étale chart are a finite module, and let `Z ⊆ Y` be a closed
subspace whose defining ideal sheaf is the `k`-th Fitting ideal sheaf of `G`.  Then over the
source chart of every diagram of affine étale charts over `f` the `k`-th Fitting ideal of the
sections of `f^*G` is the defining ideal of `f^{-1}Z`.  The hypothesis `hdiag` is the
comparison of Stacks 03DX (2) read across `f`. -/
theorem fittingIdealOnChart_modulePullback_eq_definingIdealAt {X Y : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (G : Modules.{u, u} B S hS Y.1 Y.2) (hGqc : G.IsQuasicoherentOnSite)
    (hfin : ∀ W : SmallEtale B S hS Y.1,
      IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS Y.1 Y.2 W) (G.val.obj (op W)))
    (hdiag : IsCartesianOnAffineChartDiagrams B S hS f G) (k : ℕ)
    (Z : ClosedSubspaces B S hS Y.1)
    (hZ : definingIdealSheaf B S hS Y Z = fittingIdeal B S hS Y.1 Y.2 G k)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U))
    (hV : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V)) :
    letI := hfin d.V hV
    letI := module_finite_sections_modulePullback (f := f) (G := G) (d := d)
      (hdiag d hU hV).some
    fittingIdealOnChart B S hS X.1 X.2 ((modulePullback B S hS f).obj G) k d.U =
      definingIdealAt B S hS X (preimageClosedSubspace f Z) (op d.U) := by
  have := hfin d.V hV
  have := module_finite_sections_modulePullback (f := f) (G := G) (d := d) (hdiag d hU hV).some
  have hVaff : IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.1.left) := hV
  have hUaff : IsAffine ((BigFppfOver.toScheme B S hS).obj d.U.1.left) := hU
  have hGcart : IsCartesianOnAffineCharts G :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2 G hGqc
  have hchart : fittingIdealOnChart B S hS Y.1 Y.2 G k d.V =
      definingIdealAt B S hS Y Z (op d.V) := by
    rw [← fittingIdeal_obj_eq_fittingIdealOnChart G hGcart hfin k hV, ← hZ]
    rfl
  rw [fittingIdealOnChart_modulePullback k (hdiag d hU hV).some, hchart]
  exact (definingIdealAt_preimage_eq_map B S hS f Z d.V d.U d.g d.comm.symm).symm

end FittingChart

/-! ### Local generation from pointwise chartwise generation -/

section Assembly

/-- **A cokernel is locally generated by `k` sections as soon as, through every point of every
chart, some affine chart carries `k` sections of the ambient module which generate it modulo the
submodule after one function is inverted.** -/
theorem isLocallyGeneratedByOnSite_cokernel_of_pointwise_span (X : AlgebraicSpaces B S hS)
    (M : Modules.{u, u} B S hS X.1 X.2) (hMcart : IsCartesianOnAffineCharts M)
    (K : M.Submodule) (k : ℕ)
    (hpt : ∀ (W : SmallEtale B S hS X.1) (z : chartScheme W),
      ∃ (V : SmallEtale B S hS X.1) (m : V ⟶ W) (t : Fin k → M.val.obj (op V))
        (h : chartRing B S hS X.1 X.2 V) (z' : chartScheme V),
        IsAffine (chartScheme V) ∧
        (∀ y : M.val.obj (op V), ∃ j : ℕ, h ^ j • y ∈
          Submodule.span (chartRing B S hS X.1 X.2 V) (Set.range t) ⊔
            K.toSubmodule.obj (op V)) ∧
        z' ∈ (chartScheme V).basicOpen h ∧
        (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map m) z' = z) :
    SheafOfModules.IsLocallyGeneratedByOnSite (cokernel K.ι) k := by
  classical
  intro W
  refine ⟨⟨{ arrows := fun V _ => (∃ σ : ((cokernel K.ι).over V).GeneratingSections,
                 Nonempty (σ.I ≃ Fin k))
             downward_closed := ?_ }, ?_⟩, fun V m hm => hm⟩
  · rintro V V' m ⟨σ, ⟨e⟩⟩ n
    exact ⟨Stacks.SheafOfModules.generatingSectionsOverMap (cokernel K.ι) n σ, ⟨e⟩⟩
  · refine smallEtale_sieve_of_pointwise_covering B S hS X.1 W _ fun z => ?_
    obtain ⟨V, m, t, h, z₂, hVaff, hgen, hzmem, hz₂⟩ := hpt W z
    have hVa : IsAffine (chartScheme V) := hVaff
    have hunit0 : IsUnit (chartRestrict (hF := X.2)
        (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)) h) :=
      isUnit_chartRestrict_openChartInclusion_basicOpen B S hS X.2 V hVaff h
    refine ⟨openChart B S hS X.1 V ((chartScheme V).basicOpen h),
      openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h) ≫ m,
      ⟨cokernelGeneratingSectionsOfLeSpanSup K _ k
        (chartRestrictFamily M
          (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)) t) ?_,
        ⟨Equiv.ulift⟩⟩, ⟨z₂, hzmem⟩, ?_⟩
    · intro Y q hY
      have hcomp : chartRestrictFamily M q (chartRestrictFamily M
            (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)) t) =
          chartRestrictFamily M
            (q ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)) t :=
        chartRestrictFamily_comp M _ q t
      rw [hcomp]
      refine le_span_sup_of_isUnit_chartRestrict B S hS X M hMcart K V hVaff t h hgen Y hY
        (q ≫ openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)) ?_
      rw [chartRestrict_comp]
      exact hunit0.map (chartRestrict (hF := X.2) q)
    · have e2 : (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map
          (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)))
          (⟨z₂, hzmem⟩ :
            chartScheme (openChart B S hS X.1 V ((chartScheme V).basicOpen h))) = z₂ := by
        rw [toScheme_map_toOver_map_openChartInclusion B S hS X.1 V
          ((chartScheme V).basicOpen h)]
        rfl
      exact (toScheme_map_comp_apply B S hS
        (openChartInclusion B S hS X.1 V ((chartScheme V).basicOpen h)) m
        ⟨z₂, hzmem⟩).trans (by rw [e2]; exact hz₂)

end Assembly

/-! ### An affine chart diagram with a principal divisor through a point -/

section ChartProducer

/-- **An affine chart over a given chart and through a given point, on which the defining ideal
of `D` is generated by a nonzerodivisor and which is the source chart of a diagram of affine
charts over `f`.** -/
theorem exists_chartDiagram_isRegular_span_definingIdealAt {X Y : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (D : ClosedSubspaces B S hS X.1)
    (hD : HasEffectiveCartierEtalePullbacks B S hS X D)
    (W : SmallEtale B S hS X.1) (z : chartScheme W) :
    ∃ (d : ChartDiagram B S hS X.1 Y.1 f.hom) (m : d.U ⟶ W) (g : Γ(chartScheme d.U, ⊤)),
      IsAffine (chartScheme d.U) ∧ IsAffine (chartScheme d.V) ∧ IsRegular g ∧
        definingIdealAt B S hS X D (op d.U) = Ideal.span {g} ∧
        ∃ z' : chartScheme d.U, (BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map m) z' = z := by
  obtain ⟨V₁, m₁, g₁, hV₁aff, hreg₁, hgen₁, z₁, hz₁⟩ :=
    exists_openChart_isRegular_span_definingIdealAt_of_etalePullbacks B S hS X D hD W z
  have hcov := generate_affineChartDiagram_mem_topology B S hS f (fun _ => True)
    (fun _ _ => trivial) V₁
  obtain ⟨V', m', hmem, hz'⟩ :=
    (SmallEtale.mem_topology_iff_exists_mem_range B S hS X.1 _).1 hcov z₁
  obtain ⟨A, a, pA, ⟨hAaff, d, hdU, hdVaff, -⟩, rfl⟩ := hmem
  subst hdU
  obtain ⟨hregA, hgenA⟩ := isRegular_and_definingIdealAt_eq_span_etaleChartRestrict B S hS X D
    pA hV₁aff g₁ hreg₁ hgen₁
  obtain ⟨w', hw'⟩ := hz'
  refine ⟨d, pA ≫ m₁, etaleChartRestrict B S hS pA g₁, hAaff, hdVaff, hregA, hgenA,
    (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map a) w', ?_⟩
  have e1 : (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map pA)
      ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map a) w') = z₁ := by
    rwa [← toScheme_map_comp_apply]
  rwa [toScheme_map_comp_apply, e1]

end ChartProducer

/-! ### From the Fitting ideal to local generation -/

section FittingToPointwise

/-- **The strict transform is locally generated by `k` sections, from pointwise chart data
about the `k`-th Fitting ideal.**

Let `M` be a quasi-coherent `𝒪_X`-module and `D ⊆ X` a closed subspace, and suppose that
through every point of every étale chart there is an affine chart on which the defining ideal of
`D` is generated by one element `g`, the sections of `M` are a finite module, and their `k`-th
Fitting ideal is that same ideal `(g)`.  Then the quotient of `M` by the sections supported on
the points of `D` is locally generated by `k` sections. -/
theorem isLocallyGeneratedByOnSite_cokernel_supportedSections_of_pointwise
    (X : AlgebraicSpaces B S hS) (M : Modules.{u, u} B S hS X.1 X.2)
    (hMqc : M.IsQuasicoherentOnSite) (D : ClosedSubspaces B S hS X.1) (k : ℕ)
    (hpt : ∀ (W : SmallEtale B S hS X.1) (z : chartScheme W),
      ∃ (V : SmallEtale B S hS X.1) (m : V ⟶ W) (g : chartRing B S hS X.1 X.2 V)
        (hfinV : Module.Finite (chartRing B S hS X.1 X.2 V) (M.val.obj (op V))),
        IsAffine (chartScheme V) ∧
        definingIdealAt B S hS X D (op V) = Ideal.span {g} ∧
        @_root_.fittingIdeal (chartRing B S hS X.1 X.2 V) _ (M.val.obj (op V)) _ _ hfinV
            (k : ℤ) = Ideal.span {g} ∧
        ∃ z' : chartScheme V, (BigFppfOver.toScheme B S hS).map
          ((SmallEtale.toOver B S hS X.1).map m) z' = z) :
    SheafOfModules.IsLocallyGeneratedByOnSite
      (cokernel (supportedSectionsSubmodule B S hS X.1 X.2
        (Set.range (pointsMap B S hS D.1.toFunctor D.1.ι)) M).ι) k := by
  classical
  refine isLocallyGeneratedByOnSite_cokernel_of_pointwise_span B S hS X M
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 M hMqc) _ k
    fun W z => ?_
  obtain ⟨V, m, g, hfinV, hVaff, hgen, hfit, z₂, hz₂⟩ := hpt W z
  have := hfinV
  have hVa : IsAffine (chartScheme V) := hVaff
  obtain ⟨h, hhp, t, ht⟩ :=
    Stacks.Fitting.exists_notMem_and_fin_span_sup_primaryComponent k g hfit
      (((isAffineOpen_top (chartScheme V)).primeIdealOf
        (⟨z₂, trivial⟩ : (⊤ : (chartScheme V).Opens))).asIdeal)
      ((isAffineOpen_top (chartScheme V)).primeIdealOf
        (⟨z₂, trivial⟩ : (⊤ : (chartScheme V).Opens))).isPrime
  have htors : Ideal.primaryComponent (M.val.obj (op V)) (Ideal.span {g}) ≤
      (supportedSectionsSubmodule B S hS X.1 X.2
        (Set.range (pointsMap B S hS D.1.toFunctor D.1.ι)) M).toSubmodule.obj (op V) :=
    fun s hs => (mem_supportedSectionsSubmodule_iff_mem_primaryComponent B S hS X D M hMqc
      V hVaff g hgen s).2 hs
  refine ⟨V, m, t, h, z₂, hVaff, fun y => ?_,
    mem_basicOpen_of_notMem_primeIdealOf (chartScheme V) z₂ h hhp, hz₂⟩
  obtain ⟨j, hj⟩ := ht y
  exact ⟨j, sup_le_sup_left htors _ hj⟩

end FittingToPointwise

/-! ### Local principality -/

/-- The single section of the defining ideal sheaf over a chart determined by a generator of the
defining ideal there. -/
noncomputable abbrev definingIdealGenerator (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (V : SmallEtale B S hS X.1)
    (g : Γ(chartScheme V, ⊤))
    (hgen : definingIdealAt B S hS X D (op V) = Ideal.span {g}) :
    Fin 1 → ((definingIdealSheaf B S hS X D).toSheafOfModules).val.obj (op V) :=
  fun _ => ⟨g, hgen.ge (Ideal.mem_span_singleton_self g)⟩

/-- **A nonzerodivisor generating the defining ideal at an affine chart generates the restricted
defining ideal sheaf.** -/
theorem generatesLocally_definingIdealGenerator (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (V : SmallEtale B S hS X.1)
    (hV : IsAffine (chartScheme V)) (g : Γ(chartScheme V, ⊤)) (hreg : IsRegular g)
    (hgen : definingIdealAt B S hS X D (op V) = Ideal.span {g}) :
    Stacks.SheafOfModules.GeneratesLocally (SmallEtale.topology B S hS X.1)
      ((definingIdealSheaf B S hS X D).toSheafOfModules).val
      (definingIdealGenerator B S hS X D V g hgen) := by
  intro V' f t
  refine ⟨⊤, (SmallEtale.topology B S hS X.1).top_mem V', fun W m _ => ?_⟩
  have hW := (isRegular_and_definingIdealAt_eq_span_etaleChartRestrict B S hS X D
    (m ≫ f) hV g hreg hgen).2
  obtain ⟨c, hc⟩ : ∃ c : Γ((BigFppfOver.toScheme B S hS).obj W.1.left, ⊤),
      c * etaleChartRestrict B S hS (m ≫ f) g =
        (((definingIdealSheaf B S hS X D).toSheafOfModules).val.restrictₛₗ m.op t).val := by
    refine Ideal.mem_span_singleton'.1 ?_
    rw [← hW]
    exact (((definingIdealSheaf B S hS X D).toSheafOfModules).val.restrictₛₗ m.op t).property
  refine ⟨fun _ => c, ?_⟩
  rw [Finset.univ_unique, Finset.sum_singleton]
  refine Subtype.ext ?_
  rw [← hc]
  rfl

/-- **Generating sections of the defining ideal sheaf on an affine chart on which it is
generated by a nonzerodivisor**, indexed by a universe lift of `Fin 1`. -/
noncomputable def definingIdealGeneratingSectionsOfSpan (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (V : SmallEtale B S hS X.1)
    (hV : IsAffine (chartScheme V)) (g : Γ(chartScheme V, ⊤)) (hreg : IsRegular g)
    (hgen : definingIdealAt B S hS X D (op V) = Ideal.span {g}) :
    (((definingIdealSheaf B S hS X D).toSheafOfModules).over V).GeneratingSections :=
  haveI _hsh : ∀ Y : (smallEtaleRingedSite B S hS X.1 X.2).C,
      HasSheafify ((smallEtaleRingedSite B S hS X.1 X.2).J.over Y) AddCommGrpCat.{u} :=
    fun Y => SmallEtale.instHasSheafifyOver B S hS X.1 _ Y
  haveI _hwe : ∀ Y : (smallEtaleRingedSite B S hS X.1 X.2).C,
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over Y).WEqualsLocallyBijective
        AddCommGrpCat.{u} :=
    fun Y => SmallEtale.instWEqualsLocallyBijectiveOver B S hS X.1 _ Y
  { I := ULift.{u} (Fin 1)
    s := fun j => Stacks.SheafOfModules.mkOver
      (definingIdealGenerator B S hS X D V g hgen j.down)
    epi := Stacks.SheafOfModules.epi_freeHomEquiv_symm_mkOver
      (definingIdealGenerator B S hS X D V g hgen ∘
        (Equiv.ulift : ULift.{u} (Fin 1) ≃ Fin 1))
      (Stacks.SheafOfModules.generatesLocally_comp_equiv
        (Equiv.ulift : ULift.{u} (Fin 1) ≃ Fin 1)
        (definingIdealGenerator B S hS X D V g hgen)
        (generatesLocally_definingIdealGenerator B S hS X D V hV g hreg hgen)) }

/-- **A closed subspace whose inverse image is an effective Cartier divisor on every étale
scheme chart is locally principal.** -/
@[stacks 083C "part (3) implies the local principality of part (1) of 083B"]
theorem isLocallyPrincipal_of_hasEffectiveCartierEtalePullbacks (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (hD : HasEffectiveCartierEtalePullbacks B S hS X D) :
    IsLocallyPrincipal B S hS X D := by
  intro U
  refine ⟨⟨{ arrows := fun W _ => (∃ σ : (((definingIdealSheaf B S hS X D).toSheafOfModules).over
                 W).GeneratingSections, Nonempty (σ.I ≃ Fin 1))
             downward_closed := ?_ }, ?_⟩, fun W m hm => hm⟩
  · rintro W W' m ⟨σ, ⟨e⟩⟩ k
    exact ⟨Stacks.SheafOfModules.generatingSectionsOverMap
      ((definingIdealSheaf B S hS X D).toSheafOfModules) k σ, ⟨e⟩⟩
  · refine smallEtale_sieve_of_pointwise_covering B S hS X.1 U _ fun z => ?_
    obtain ⟨V, m, g, hVaff, hreg, hgen, z', hz'⟩ :=
      exists_openChart_isRegular_span_definingIdealAt_of_etalePullbacks B S hS X D hD U z
    exact ⟨V, m, ⟨definingIdealGeneratingSectionsOfSpan B S hS X D V hVaff g hreg hgen,
      ⟨Equiv.ulift⟩⟩, z', hz'⟩

/-! ### The exceptional divisor on the strict-transform fibre product -/

section Exceptional

variable {B S hS}

/-- **The exceptional divisor of a blowup is an effective Cartier divisor on the fibre product
in which the strict transform lives.**

Let `b : X' ⟶ X` be the blowup of an algebraic space `X` in a closed subspace `Z`, and let
`E = b^{-1}Z ⊆ X'` be its exceptional divisor.  Then the preimage of `E` along the projection
`X ×_X X' ⟶ X'` — the subspace the strict transform of an `𝒪_X`-module divides out the sections
supported on — is an effective Cartier divisor on `X ×_X X'`. -/
@[stacks 083Z "part (2), at the exceptional divisor of a blowup"]
theorem isEffectiveCartierDivisor_exceptionalPreimage_id {X X' : AlgebraicSpaces B S hS}
    {Z : ClosedSubspaces B S hS X.1} {b : X' ⟶ X} (hb : IsBlowupAlong B S hS Z b) :
    IsEffectiveCartierDivisor B S hS (strictTransformPullback B S hS (𝟙 X) b)
      ⟨exceptionalPreimage B S hS (𝟙 X) b (preimageClosedSubspace b Z).1,
        exceptionalPreimage_isClosedSubspace B S hS (𝟙 X) b
          (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ :=
  isPullbackDefined_of_isFlat B S hS (strictTransformPullbackToBlowUp B S hS (𝟙 X) b)
    (preimageClosedSubspace b Z) hb.isPullbackDefined
    ((isFlat_isStableUnderBaseChange B S hS).of_isPullback
      (AlgebraicSpaces.isPullback_fiberProduct B S hS (𝟙 X) b) (isFlat_id B S hS X.2))

/-- **The inverse image of the exceptional divisor is an effective Cartier divisor on every
étale scheme chart of the fibre product.**  This is condition (3) of Stacks 083C for the
subspace of `AlgebraicGeometry.Space.isEffectiveCartierDivisor_exceptionalPreimage_id`. -/
theorem hasEffectiveCartierEtalePullbacks_exceptionalPreimage_id
    {X X' : AlgebraicSpaces B S hS} {Z : ClosedSubspaces B S hS X.1} {b : X' ⟶ X}
    (hb : IsBlowupAlong B S hS Z b) :
    HasEffectiveCartierEtalePullbacks B S hS (strictTransformPullback B S hS (𝟙 X) b)
      ⟨exceptionalPreimage B S hS (𝟙 X) b (preimageClosedSubspace b Z).1,
        exceptionalPreimage_isClosedSubspace B S hS (𝟙 X) b
          (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ :=
  hasEffectiveCartierEtalePullbacks_of_isEffectiveCartier B S hS _ _
    (isEffectiveCartierDivisor_exceptionalPreimage_id hb)

/-- **An affine chart through any point of any chart on which the inverse image of the
exceptional divisor is cut out by a nonzerodivisor.**

This is the chartwise form of local principality of the subspace the strict transform divides
by: through every point of every étale chart of `X ×_X X'` there is an affine étale chart over
it on which the defining ideal of the inverse image of the exceptional divisor is generated by
a single regular element. -/
theorem exists_openChart_isRegular_span_exceptionalPreimage_id
    {X X' : AlgebraicSpaces B S hS} {Z : ClosedSubspaces B S hS X.1} {b : X' ⟶ X}
    (hb : IsBlowupAlong B S hS Z b)
    (U : SmallEtale B S hS (strictTransformPullback B S hS (𝟙 X) b).1)
    (z : chartScheme U) :
    ∃ (V : SmallEtale B S hS (strictTransformPullback B S hS (𝟙 X) b).1) (m : V ⟶ U)
      (g : Γ(chartScheme V, ⊤)),
      IsAffine (chartScheme V) ∧ IsRegular g ∧
        definingIdealAt B S hS (strictTransformPullback B S hS (𝟙 X) b)
            ⟨exceptionalPreimage B S hS (𝟙 X) b (preimageClosedSubspace b Z).1,
              exceptionalPreimage_isClosedSubspace B S hS (𝟙 X) b
                (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ (op V) =
          Ideal.span {g} ∧
        ∃ z' : chartScheme V,
          (BigFppfOver.toScheme B S hS).map
            ((SmallEtale.toOver B S hS
              (strictTransformPullback B S hS (𝟙 X) b).1).map m) z' = z :=
  exists_openChart_isRegular_span_definingIdealAt_of_etalePullbacks B S hS _ _
    (hasEffectiveCartierEtalePullbacks_exceptionalPreimage_id hb) U z

/-- **The inverse image of the exceptional divisor of a blowup is locally principal on the
fibre product carrying the strict transform.** -/
theorem isLocallyPrincipal_exceptionalPreimage_id {X X' : AlgebraicSpaces B S hS}
    {Z : ClosedSubspaces B S hS X.1} {b : X' ⟶ X} (hb : IsBlowupAlong B S hS Z b) :
    IsLocallyPrincipal B S hS (strictTransformPullback B S hS (𝟙 X) b)
      ⟨exceptionalPreimage B S hS (𝟙 X) b (preimageClosedSubspace b Z).1,
        exceptionalPreimage_isClosedSubspace B S hS (𝟙 X) b
          (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ :=
  isLocallyPrincipal_of_hasEffectiveCartierEtalePullbacks B S hS _ _
    (hasEffectiveCartierEtalePullbacks_exceptionalPreimage_id hb)

end Exceptional

/-! ### Local generators of the strict transform -/

section Main

variable {B S hS}

/-- Let `F` be a finite type quasi-coherent module on an algebraic space `Bsp`, let `Z ⊆ Bsp` be
the closed subspace cut out by the `k`-th Fitting ideal sheaf of `F`, and let `b : Bsp' ⟶ Bsp` be
the blowup of `Bsp` in `Z`.  Then the strict transform of `F` can locally be generated by `k`
sections. -/
@[stacks 0D0P]
theorem strictTransformSheaf_isLocallyGeneratedByOnSite
    {Bsp Bsp' : AlgebraicSpaces B S hS} (F : Modules.{u, u} B S hS Bsp.1 Bsp.2) (k : ℕ)
    (Z : ClosedSubspaces B S hS Bsp.1)
    (hZ : definingIdealSheaf B S hS Bsp Z = fittingIdeal B S hS Bsp.1 Bsp.2 F k)
    {b : Bsp' ⟶ Bsp} (hb : IsBlowupAlong B S hS Z b) (hFqc : F.IsQuasicoherentOnSite)
    (hFfin : ∀ W : SmallEtale B S hS Bsp.1,
      IsAffine ((SmallEtale.toOver B S hS Bsp.1 ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS Bsp.1 Bsp.2 W) (F.val.obj (op W))) :
    SheafOfModules.IsLocallyGeneratedByOnSite
      (strictTransformSheaf B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1 F) k := by
  classical
  have hdiag : IsCartesianOnAffineChartDiagrams B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F :=
    isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F hFqc
  have hpb : ((modulePullback B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F hFqc
  have hcomm : (strictTransformPullbackToBlowUp B S hS (𝟙 Bsp) b).hom ≫ b.hom =
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b).hom := by
    have hw := (AlgebraicSpaces.isPullback_fiberProduct B S hS (𝟙 Bsp) b).w
    have h1 : strictTransformPullbackToBlowUp B S hS (𝟙 Bsp) b ≫ b =
        strictTransformPullbackToSource B S hS (𝟙 Bsp) b := by
      rw [← hw, Category.comp_id]
    exact congrArg
      (fun φ : strictTransformPullback B S hS (𝟙 Bsp) b ⟶ Bsp => φ.hom) h1
  have hDZ : (⟨exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1,
        exceptionalPreimage_isClosedSubspace B S hS (𝟙 Bsp) b
          (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ :
        ClosedSubspaces B S hS (strictTransformPullback B S hS (𝟙 Bsp) b).1) =
      preimageClosedSubspace (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) Z :=
    Subtype.ext ((Subfunctor.preimage_comp Z.1
      (strictTransformPullbackToBlowUp B S hS (𝟙 Bsp) b).hom b.hom).symm.trans
      (congrArg (fun φ => Z.1.preimage φ) hcomm))
  refine isLocallyGeneratedByOnSite_cokernel_supportedSections_of_pointwise
    B S hS (strictTransformPullback B S hS (𝟙 Bsp) b)
    ((modulePullback B S hS (strictTransformPullbackToSource B S hS (𝟙 Bsp) b)).obj F) hpb
    ⟨exceptionalPreimage B S hS (𝟙 Bsp) b (preimageClosedSubspace b Z).1,
      exceptionalPreimage_isClosedSubspace B S hS (𝟙 Bsp) b
        (preimageClosedSubspace b Z).1 (preimageClosedSubspace b Z).2⟩ k fun W z => ?_
  obtain ⟨d, m, g, hUaff, hVaff, hreg, hgen, z₂, hz₂⟩ :=
    exists_chartDiagram_isRegular_span_definingIdealAt B S hS
      (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) _
      (hasEffectiveCartierEtalePullbacks_exceptionalPreimage_id hb) W z
  have := hFfin d.V hVaff
  have hfinU := module_finite_sections_modulePullback
    (f := strictTransformPullbackToSource B S hS (𝟙 Bsp) b) (G := F) (d := d)
    (hdiag d hUaff hVaff).some
  refine ⟨d.U, m, g, hfinU, hUaff, hgen, ?_, z₂, hz₂⟩
  refine Eq.trans (fittingIdealOnChart_modulePullback_eq_definingIdealAt B S hS
    (strictTransformPullbackToSource B S hS (𝟙 Bsp) b) F hFqc hFfin hdiag k Z hZ d hUaff
    hVaff) ?_
  rwa [← hDZ]

end Main

end AlgebraicGeometry.Space

