@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Factoring through the subspace cut out by a set of points -/

/-- A morphism factors through the subspace cut out by a set of points exactly when its image on
points lies in that set, and the factorization is then unique. -/
theorem existsUnique_lift_openSubspaceOfPoints_iff
    {A F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : A ⟶ F) (W : Set (points B S hS F)) :
    (∃! g : A ⟶ (openSubspaceOfPoints B S hS F W).toFunctor,
        g ≫ (openSubspaceOfPoints B S hS F W).ι = f) ↔
      Set.range (pointsMap B S hS A f) ⊆ W := by
  constructor
  · rintro ⟨g, hg, -⟩
    rw [← hg, pointsMap_comp]
    refine (Set.range_comp_subset_range _ _).trans ?_
    exact (range_pointsMap_ι_openSubspaceOfPoints B S hS W).le
  · intro h
    have hle : Subfunctor.range f ≤ openSubspaceOfPoints B S hS F W :=
      (range_le_openSubspaceOfPoints_range_pointsMap f).trans
        (openSubspaceOfPoints_mono B S hS h)
    refine ⟨Subfunctor.lift f hle, Subfunctor.lift_ι _ _, fun g hg ↦ ?_⟩
    exact (cancel_mono (openSubspaceOfPoints B S hS F W).ι).1
      (hg.trans (Subfunctor.lift_ι f hle).symm)

/-! ### Points of the two charts of a chart diagram -/

variable {X Y : AlgebraicSpaces B S hS}

/-- The point of `Y` carried by a point of the chart of `Y` of a diagram of étale charts over
`f : X ⟶ Y` is the image under `f` of the point of `X` carried by the point of the chart of
`X` above it. -/
theorem pointsMap_chartSchemeToPoints_chartDiagram (f : X ⟶ Y)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom) (z : chartScheme d.U) :
    pointsMap B S hS X.1 f.hom (chartSchemeToPoints B S hS X.1 d.U z) =
      chartSchemeToPoints B S hS Y.1 d.V ((BigFppfOver.toScheme B S hS).map d.g z) := by
  rw [chartSchemeToPoints_eq_pointsMap, chartSchemeToPoints_eq_pointsMap,
    ← pointsMap_comp_apply, d.comm, pointsMap_comp_apply,
    pointsMap_yoneda_map_class_canonicalSiteFieldPoint]

/-- **An ideal of the chart ring of `Y` which generates the unit ideal of the chart ring of `X`
over a diagram of étale charts escapes the prime at every point.**  Concretely, above every
point `z` of the chart of `X` the ideal has a member not vanishing at the image of `z` in the
chart of `Y`.

Were every member of the ideal to vanish at that image, its pullback would vanish at `z`, so the
generated ideal would be contained in the prime of the chart ring of `X` at `z` — the contraction
of the maximal ideal of the Zariski local ring there — and a prime ideal is not the unit
ideal. -/
theorem exists_mem_mem_basicOpen_of_map_eq_top (f : X ⟶ Y)
    (d : ChartDiagram B S hS X.1 Y.1 f.hom) (K : Ideal (chartRing B S hS Y.1 Y.2 d.V))
    (htop : Ideal.map (chartDiagramRestrict B S hS f d) K = ⊤) (z : chartScheme d.U) :
    ∃ a ∈ K, (BigFppfOver.toScheme B S hS).map d.g z ∈ (chartScheme d.V).basicOpen a := by
  by_contra hcon
  simp only [not_exists, not_and] at hcon
  obtain ⟨q, hqprime, hqmem⟩ : ∃ q : Ideal (chartRing B S hS X.1 X.2 d.U), q.IsPrime ∧
      ∀ t : chartRing B S hS X.1 X.2 d.U,
        z ∉ (chartScheme d.U).basicOpen t → t ∈ q := by
    refine ⟨Ideal.comap ((chartScheme d.U).presheaf.germ ⊤ z trivial).hom
      (IsLocalRing.maximalIdeal ((chartScheme d.U).presheaf.stalk z)),
      Ideal.IsPrime.comap _, fun t ht ↦ ?_⟩
    exact (IsLocalRing.mem_maximalIdeal _).2
      (mem_nonunits_iff.2 fun hu ↦ ht ((Scheme.mem_basicOpen_top _ _ z).2 hu))
  have hKq : K ≤ Ideal.comap (chartDiagramRestrict B S hS f d) q := by
    intro a ha
    refine hqmem _ ?_
    have hpre : (chartScheme d.U).basicOpen (chartDiagramRestrict B S hS f d a) =
        (BigFppfOver.toScheme B S hS).map d.g ⁻¹ᵁ (chartScheme d.V).basicOpen a :=
      (Scheme.preimage_basicOpen_top ((BigFppfOver.toScheme B S hS).map d.g) a).symm
    rw [hpre]
    exact hcon a ha
  have hone : (1 : chartRing B S hS X.1 X.2 d.U) ∈
      Ideal.map (chartDiagramRestrict B S hS f d) K := by
    simp [htop]
  exact hqprime.ne_top
    ((Ideal.eq_top_iff_one _).2 (Ideal.map_le_iff_le_comap.2 hKq hone))

/-! ### Points of a chart and points of the ambient space -/

section ChartPoints

variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-- The point of `F` carried by a point of the scheme of an étale chart lies in the image of
that chart. -/
theorem chartSchemeToPoints_mem_range (U : SmallEtale B S hS F) (z : chartScheme U) :
    chartSchemeToPoints B S hS F U z ∈ Set.range (pointsMap B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.obj.hom) :=
  ⟨_, (chartSchemeToPoints_eq_pointsMap_pointsEquivScheme_symm B S hS F U z).symm⟩

/-- A point in the image of an étale chart is carried by a point of that chart's scheme. -/
theorem exists_chartSchemeToPoints_eq_of_mem_range (U : SmallEtale B S hS F)
    {x : points B S hS F}
    (hx : x ∈ Set.range (pointsMap B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.obj.hom)) :
    ∃ z : chartScheme U, chartSchemeToPoints B S hS F U z = x := by
  obtain ⟨w, rfl⟩ := hx
  refine ⟨pointsToScheme B S hS ((SmallEtale.toOver B S hS F).obj U) w, ?_⟩
  rw [chartSchemeToPoints_eq_pointsMap_pointsEquivScheme_symm]
  exact congrArg _ ((Equiv.symm_apply_eq _).2 rfl)

/-- A point of a chart's scheme lying in a Zariski open `O` is carried to a point in the image of
the étale chart `openChart U O`. -/
private theorem chartSchemeToPoints_mem_range_openChart (U : SmallEtale B S hS F)
    (O : ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj U)).Opens)
    (z : chartScheme U) (hz : z ∈ O) :
    chartSchemeToPoints B S hS F U z ∈ Set.range (pointsMap B S hS
      (yoneda.obj ((SmallEtale.toOver B S hS F).obj (openChart B S hS F U O)))
      (openChart B S hS F U O).obj.hom) := by
  obtain ⟨w, hw⟩ := (Scheme.Opens.range_ι O).ge hz
  have hmem := chartSchemeToPoints_mem_range B S hS (openChart B S hS F U O) w
  rw [← chartSchemeToPoints_map B S hS F (openChartInclusion B S hS F U O) w,
    toScheme_map_toOver_map_openChartInclusion] at hmem
  rwa [← hw]

end ChartPoints

/-! ### Affine chart diagrams through a prescribed point -/

/-- **Through every point of an étale chart of `X` there is a diagram of affine étale charts
over `f`.**  This is the cofinality of Stacks 03G2 in the sieve form
`AlgebraicGeometry.Space.generate_affineChartDiagram_mem_topology`, read at one point: a
covering sieve of the small étale site is jointly surjective on the points of the chart's
scheme. -/
theorem exists_affine_chartDiagram_at_chartPoint (f : X ⟶ Y) (U₀ : SmallEtale B S hS X.1)
    (z₀ : chartScheme U₀) :
    ∃ (d : ChartDiagram B S hS X.1 Y.1 f.hom) (k : d.U ⟶ U₀) (z : chartScheme d.U),
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj d.U) ∧
        IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V) ∧
          (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map k) z = z₀ := by
  obtain ⟨W, g, hgarr, hz₀⟩ :=
    (SmallEtale.mem_topology_iff_exists_mem_range B S hS X.1 _).1
      (generate_affineChartDiagram_mem_topology B S hS f (fun _ ↦ True)
        (fun _ _ ↦ trivial) U₀) z₀
  obtain ⟨T, h, k, ⟨hTaff, d, rfl, hdVaff, -⟩, rfl⟩ := hgarr
  obtain ⟨w, hw⟩ := hz₀
  refine ⟨d, k, (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map h) w,
    hTaff, hdVaff, ?_⟩
  rw [← hw, Functor.map_comp, Functor.map_comp]
  rfl

/-! ### The unit locus of the Fitting ideal sheaf under base change -/

section BaseChange

variable (G : Modules.{u, u} B S hS Y.1 Y.2) (hGqc : G.IsQuasicoherentOnSite)
    (hGft : SheafOfModules.IsFiniteTypeOnSite G)

include hGqc hGft

/-- **A point of `X` at which `f^*G` is generated by `r` sections lies over a point of `Y` at
which `G` is generated by `r` sections.**

Over a diagram of affine étale charts through the point, the chartwise Fitting ideal of `f^*G`
is the ideal generated by the image of the chartwise Fitting ideal of `G`
(`AlgebraicGeometry.Space.fittingIdealOnChart_modulePullback`).  That generated ideal being the
unit ideal, the chartwise Fitting ideal of `G` has a member not vanishing at the image of the
point in the chart of `Y`, and on the nonvanishing locus of that member — again an étale chart
of `Y`, and one whose image contains the image of the point — the Fitting ideal sheaf of `G` is
the whole structure sheaf. -/
theorem mem_idealUnitLocus_fittingIdeal_of_mem_idealUnitLocus_modulePullback (f : X ⟶ Y)
    (r : ℕ) {x : points B S hS X.1}
    (hx : x ∈ idealUnitLocus B S hS X
      (fittingIdeal B S hS X.1 X.2 ((modulePullback B S hS f).obj G) r)) :
    pointsMap B S hS X.1 f.hom x ∈
      idealUnitLocus B S hS Y (fittingIdeal B S hS Y.1 Y.2 G r) := by
  have hfinG := module_finite_sections_of_isFiniteTypeOnSite G hGqc hGft
  have hpbqc : ((modulePullback B S hS f).obj G).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS f G hGqc
  have hfinP := module_finite_sections_of_isFiniteTypeOnSite _ hpbqc
    (isFiniteTypeOnSite_modulePullback B S hS f G hGft)
  have hcartP : IsCartesianOnAffineCharts ((modulePullback B S hS f).obj G) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hpbqc
  have hcd : IsCartesianOnAffineChartDiagrams B S hS f G :=
    isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite B S hS f G hGqc
  obtain ⟨U₀, hU₀top, hxU₀⟩ := hx
  obtain ⟨z₀, hz₀⟩ := exists_chartSchemeToPoints_eq_of_mem_range B S hS U₀ hxU₀
  obtain ⟨d, k, z, hdUaff, hdVaff, hkz⟩ :=
    exists_affine_chartDiagram_at_chartPoint B S hS f U₀ z₀
  let := hfinG d.V hdVaff
  let := hfinP d.U hdUaff
  -- the point of `X` is carried by the point `z` of the chart of `X`
  have hxz : chartSchemeToPoints B S hS X.1 d.U z = x := by
    rw [← hz₀, ← hkz, chartSchemeToPoints_map]
  -- the chartwise Fitting ideal of `f^*G` over the chart of `X` is the unit ideal
  have hchart : fittingIdealOnChart B S hS X.1 X.2
      ((modulePullback B S hS f).obj G) r d.U = ⊤ := by
    refine Eq.trans ?_ (SheafOfModules.Submodule.unit_obj_eq_top_of_map _ k.op hU₀top)
    exact (fittingIdeal_obj_eq_fittingIdealOnChart _ hcartP hfinP r hdUaff).symm
  -- hence so is the ideal generated by the image of the chartwise Fitting ideal of `G`
  obtain ⟨e⟩ := hcd d hdUaff hdVaff
  have hmaptop : Ideal.map (chartDiagramRestrict B S hS f d)
      (fittingIdealOnChart B S hS Y.1 Y.2 G r d.V) = ⊤ := by
    refine Eq.trans ?_ hchart
    exact (fittingIdealOnChart_modulePullback (f := f) (G := G) r e).symm
  obtain ⟨a, haK, hav⟩ := exists_mem_mem_basicOpen_of_map_eq_top B S hS f d _ hmaptop z
  have haI : a ∈ (fittingIdeal B S hS Y.1 Y.2 G r).toSubmodule.obj (op d.V) :=
    mem_fittingIdeal_of_mem_fittingIdealOnChart G r d.V hdVaff a haK
  -- the étale chart of `Y` cut out by the nonvanishing locus of that member
  refine ⟨openChart B S hS Y.1 d.V ((chartScheme d.V).basicOpen a), ?_, ?_⟩
  · have hmem : chartRestrict (hF := Y.2)
        (openChartInclusion B S hS Y.1 d.V ((chartScheme d.V).basicOpen a)) a ∈
          (fittingIdeal B S hS Y.1 Y.2 G r).toSubmodule.obj
            (op (openChart B S hS Y.1 d.V ((chartScheme d.V).basicOpen a))) :=
      (fittingIdeal B S hS Y.1 Y.2 G r).toSubmodule.map_mem
        (openChartInclusion B S hS Y.1 d.V ((chartScheme d.V).basicOpen a)).op haI
    exact Ideal.eq_top_of_isUnit_mem _ hmem
      (isUnit_chartRestrict_openChartInclusion_basicOpen B S hS Y.2 d.V hdVaff a)
  · have hmem := chartSchemeToPoints_mem_range_openChart B S hS d.V _ _ hav
    rwa [← pointsMap_chartSchemeToPoints_chartDiagram B S hS f d z, hxz] at hmem

/-- **A point of `X` lying over a point of `Y` at which `G` is generated by `r` sections is a
point at which `f^*G` is generated by `r` sections.**

A diagram of affine étale charts through the point is restricted to an affine Zariski open of
its chart of `Y` on which the Fitting ideal sheaf of `G` is the whole structure sheaf
(`AlgebraicGeometry.Space.exists_affineOpen_obj_openChart_eq_top`) and to an affine Zariski open
of its chart of `X` inside the preimage; over the restricted diagram the chartwise Fitting ideal
of `f^*G` is generated by the image of the unit ideal. -/
theorem mem_idealUnitLocus_fittingIdeal_modulePullback_of_mem_idealUnitLocus (f : X ⟶ Y)
    (r : ℕ) {x : points B S hS X.1}
    (hx : pointsMap B S hS X.1 f.hom x ∈
      idealUnitLocus B S hS Y (fittingIdeal B S hS Y.1 Y.2 G r)) :
    x ∈ idealUnitLocus B S hS X
      (fittingIdeal B S hS X.1 X.2 ((modulePullback B S hS f).obj G) r) := by
  have hfinG := module_finite_sections_of_isFiniteTypeOnSite G hGqc hGft
  have hcartG : IsCartesianOnAffineCharts G :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2 G hGqc
  have hpbqc : ((modulePullback B S hS f).obj G).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS f G hGqc
  have hfinP := module_finite_sections_of_isFiniteTypeOnSite _ hpbqc
    (isFiniteTypeOnSite_modulePullback B S hS f G hGft)
  have hcartP : IsCartesianOnAffineCharts ((modulePullback B S hS f).obj G) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hpbqc
  have hcd : IsCartesianOnAffineChartDiagrams B S hS f G :=
    isCartesianOnAffineChartDiagrams_of_isQuasicoherentOnSite B S hS f G hGqc
  obtain ⟨W₀, b, -, hbe, w₀, hw₀⟩ := exists_affine_etale_chart_at_point B S hS X.1 X.2 x
  obtain ⟨z₀, hz₀⟩ := exists_chartSchemeToPoints_eq_of_mem_range B S hS
    (⟨CostructuredArrow.mk b, hbe⟩ : SmallEtale B S hS X.1) ⟨w₀, hw₀⟩
  obtain ⟨d, k, z, hdUaff, hdVaff, hkz⟩ :=
    exists_affine_chartDiagram_at_chartPoint B S hS f
      (⟨CostructuredArrow.mk b, hbe⟩ : SmallEtale B S hS X.1) z₀
  have hxz : chartSchemeToPoints B S hS X.1 d.U z = x := by
    rw [← hz₀, ← hkz, chartSchemeToPoints_map]
  -- the image of the point in the chart of `Y` lies over the unit locus
  have hv : (BigFppfOver.toScheme B S hS).map d.g z ∈
      chartUnitLocusPreimage B S hS Y (fittingIdeal B S hS Y.1 Y.2 G r) d.V := by
    show chartSchemeToPoints B S hS Y.1 d.V ((BigFppfOver.toScheme B S hS).map d.g z) ∈
      idealUnitLocus B S hS Y (fittingIdeal B S hS Y.1 Y.2 G r)
    rw [← pointsMap_chartSchemeToPoints_chartDiagram, hxz]
    exact hx
  obtain ⟨P, hvP, hPtop⟩ := exists_affineOpen_obj_openChart_eq_top B S hS Y
    (fittingIdeal B S hS Y.1 Y.2 G r) d.V _ hv
  -- an affine open of the chart of `X` through the point and inside the preimage of `P`
  obtain ⟨O, hOaff, hzO, hOle⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp (chartScheme d.U).isBasis_affineOpens
      (show z ∈ (BigFppfOver.toScheme B S hS).map d.g ⁻¹ᵁ P.1 from hvP)
  set d' := d.restrictOpens O P.1 hOle
  have hd'Uaff : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙
      BigFppfOver.toScheme B S hS).obj d'.U) := hOaff
  have hd'Vaff : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙
      BigFppfOver.toScheme B S hS).obj d'.V) := P.2
  let := hfinG d'.V hd'Vaff
  let := hfinP d'.U hd'Uaff
  obtain ⟨e⟩ := hcd d' hd'Uaff hd'Vaff
  have hVtop : fittingIdealOnChart B S hS Y.1 Y.2 G r d'.V = ⊤ := by
    refine Eq.trans ?_ hPtop
    exact (fittingIdeal_obj_eq_fittingIdealOnChart G hcartG hfinG r hd'Vaff).symm
  have hUtop : fittingIdealOnChart B S hS X.1 X.2
      ((modulePullback B S hS f).obj G) r d'.U = ⊤ := by
    refine Eq.trans (fittingIdealOnChart_modulePullback (f := f) (G := G) r e) ?_
    rw [hVtop, Ideal.map_top]
  refine ⟨d'.U, ?_, ?_⟩
  · refine Eq.trans ?_ hUtop
    exact fittingIdeal_obj_eq_fittingIdealOnChart _ hcartP hfinP r hd'Uaff
  · have hmem := chartSchemeToPoints_mem_range_openChart B S hS d.U O z hzO
    rwa [hxz] at hmem

/-- **The locus of `X` where `f^*G` is generated by `r` sections is the inverse image of the
locus of `Y` where `G` is generated by `r` sections**, in the form of the unit loci of the two
Fitting ideal sheaves.  This is the point-set content of the base change of Fitting ideals,
Stacks 0CZ4. -/
theorem idealUnitLocus_fittingIdeal_modulePullback (f : X ⟶ Y) (r : ℕ) :
    idealUnitLocus B S hS X
        (fittingIdeal B S hS X.1 X.2 ((modulePullback B S hS f).obj G) r) =
      pointsMap B S hS X.1 f.hom ⁻¹'
        idealUnitLocus B S hS Y (fittingIdeal B S hS Y.1 Y.2 G r) :=
  Set.eq_of_subset_of_subset
    (fun _ hx ↦ mem_idealUnitLocus_fittingIdeal_of_mem_idealUnitLocus_modulePullback
      B S hS G hGqc hGft f r hx)
    (fun _ hx ↦ mem_idealUnitLocus_fittingIdeal_modulePullback_of_mem_idealUnitLocus
      B S hS G hGqc hGft f r hx)

end BaseChange

/-! ### Clause (2) of Stacks 0CZ9 -/

/-- **Clause (2) of Stacks 0CZ9, from the tag's own hypotheses.**  Let `Y` be an algebraic space
over `S`, let `G` be a quasi-coherent `𝒪_Y`-module of finite type and let
`Y ⊇ Z_0 ⊇ Z_1 ⊇ …` be the chain of closed subspaces cut out by the Fitting ideals of `G`.
Then the open subspace `Y \ Z_r` represents the functor sending a space over `Y` to a one-point
set when the pullback of `G` to it is locally generated by at most `r` sections and to the empty
set otherwise: a morphism `f : X ⟶ Y` factors through `Y \ Z_r`, necessarily uniquely, exactly
when `f^*G` is generated by `r` sections on an affine étale chart around every point of `X`.

Being generated by at most `r` sections is read here, as everywhere in this development, as
being generated by a family indexed by `Fin r`; padding a shorter family with zeros turns one
reading into the other.  The test object is an arbitrary algebraic space over `S`, which
contains the schemes over `Y` of the tag's `(\Sch/Y)`.

Nothing beyond quasi-coherence and finite type is asked for: the two sides are compared through
the unit locus of the Fitting ideal sheaf, by
`AlgebraicGeometry.Space.mem_idealUnitLocus_fittingIdeal_iff` on `X` and by
`AlgebraicGeometry.Space.openComplement_eq_openSubspaceOfPoints_idealUnitLocus` on `Y`, and the
base change of that locus is
`AlgebraicGeometry.Space.idealUnitLocus_fittingIdeal_modulePullback`. -/
theorem existsUnique_lift_openComplement_iff_forall_exists_fin_span
    (G : Modules.{u, u} B S hS Y.1 Y.2) (hGqc : G.IsQuasicoherentOnSite)
    (hGft : SheafOfModules.IsFiniteTypeOnSite G) (Z : ℕ → ClosedSubspaces B S hS Y.1)
    (hZ : ∀ r, definingIdealSheaf B S hS Y (Z r) = fittingIdeal B S hS Y.1 Y.2 G r)
    (r : ℕ) (f : X ⟶ Y) :
    (∀ x : points B S hS X.1, ∃ (U : SmallEtale B S hS X.1)
        (s : Fin r → ((modulePullback B S hS f).obj G).val.obj (op U)),
        IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) ∧
          Submodule.span (chartRing B S hS X.1 X.2 U) (Set.range s) = ⊤ ∧
          x ∈ Set.range (pointsMap B S hS
            (yoneda.obj ((SmallEtale.toOver B S hS X.1).obj U)) U.1.hom)) ↔
      ∃! g : X.1 ⟶ (openComplement B S hS (Z r).1).toFunctor,
        g ≫ (openComplement B S hS (Z r).1).ι = f.hom := by
  have hpbqc : ((modulePullback B S hS f).obj G).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS f G hGqc
  have hfinP := module_finite_sections_of_isFiniteTypeOnSite _ hpbqc
    (isFiniteTypeOnSite_modulePullback B S hS f G hGft)
  have hcartP : IsCartesianOnAffineCharts ((modulePullback B S hS f).obj G) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hpbqc
  have hcompl : openComplement B S hS (Z r).1 =
      openSubspaceOfPoints B S hS Y.1
        (idealUnitLocus B S hS Y (fittingIdeal B S hS Y.1 Y.2 G r)) := by
    rw [openComplement_eq_openSubspaceOfPoints_idealUnitLocus B S hS Y (Z r), hZ r]
  rw [hcompl, existsUnique_lift_openSubspaceOfPoints_iff, Set.range_subset_iff]
  exact forall_congr' fun x ↦
    (mem_idealUnitLocus_fittingIdeal_iff B S hS X _ hcartP hfinP r x).symm.trans
      (Set.ext_iff.1 (idealUnitLocus_fittingIdeal_modulePullback B S hS G hGqc hGft f r) x)

end AlgebraicGeometry.Space

