module

public import StacksFrontier.AlgebraicGeometry.Spaces.DualityPullbackComparisonDevissage
public import StacksFrontier.AlgebraicGeometry.Spaces.DualityPullbackComparisonPerfectDual
public import StacksFrontier.AlgebraicGeometry.Spaces.DualityRightAdjointDirectSums
import StacksCore.Tactic.StacksAttribute

/-!
# Stacks 0E5U: the map of Stacks 0E5P for a proper flat morphism of finite presentation

Let `Y` be a quasi-compact and quasi-separated algebraic space and `f : X ⟶ Y` a proper, flat
morphism of finite presentation, with right adjoint `a` of `Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)`.
Then `Lf^*K ⊗^L a(𝒪_Y) ⟶ a(K)` is an isomorphism for every `K ∈ D_QCoh(𝒪_Y)`: `a` commutes with
direct sums (Stacks 0E5T), the map is invertible on perfect objects (Stacks 0E5Q), and
`D_QCoh(𝒪_Y)` is generated by a single perfect object
(`Space.isIso_quasicoherentDerivedCompareWithPullback_app_of_preservesCoproducts`).

## Main results

* `AlgebraicGeometry.Space.isIso_quasicoherentDerivedCompareWithPullback_app_of_isProper`

## References

* [Stacks Project, Tag 0E5U](https://stacks.math.columbia.edu/tag/0E5U)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  (hZ : B.Contains (⊤_ Scheme.{u}))

/-- Let `Y` be a quasi-compact and quasi-separated algebraic space and `f : X ⟶ Y` a proper,
flat morphism of finite presentation, with right adjoint `a` of
`Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)` (Stacks 0E55). The map `Lf^*K ⊗^L a(𝒪_Y) ⟶ a(K)` of
Stacks 0E5P is an isomorphism for every `K ∈ D_QCoh(𝒪_Y)`. -/
@[stacks 0E5U]
theorem isIso_quasicoherentDerivedCompareWithPullback_app_of_isProper
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hYqc : IsQuasiCompactSpace B S hS Y.1)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1) (hf : IsProper B S hS f.hom)
    (hfl : IsFlat B S hS f.hom) (hfp : IsFinitePresentation B S hS f.hom)
    (K : QuasicoherentDerivedCategory.{u, u} B S hS Y.1 Y.2) :
    IsIso ((quasicoherentDerivedCompareWithPullback hZ f
      (isQuasiCompactSpace_of_isQuasiCompact B S hS Y.2 hYqc f.hom hfp.2.1)
      (isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ X.2 hYqs hfp.2.2) hYqs).app K) := by
  refine isIso_quasicoherentDerivedCompareWithPullback_app_of_preservesCoproducts hZ f _ _ hYqc hYqs
    (fun I => ?_) (fun K hK => isIso_quasicoherentDerivedCompareWithPullback_app_of_isPerfect hZ f
      _ _ hYqs K hK) K
  unfold quasicoherentDerivedRightAdjoint
  exact preservesCoproducts_rightAdjoint_quasicoherentDerivedPushforward_of_isProper hZ f hYqc hYqs
    hf hfl hfp I

end AlgebraicGeometry.Space

end
