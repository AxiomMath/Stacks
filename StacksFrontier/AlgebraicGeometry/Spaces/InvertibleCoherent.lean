@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite SheafOfModules

universe u v w m

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}

/-- A sheaf of modules is a **finite free retract** when its sections are, naturally in the
object of the site, a split direct summand of the finitely supported families of sections of the
structure sheaf: there are a rank `n`, a section map `σ` and a retraction `ρ`, both commuting
with restriction, with `ρ ∘ σ` the identity.

This is the sectionwise reading of "a split subobject of a finite free module", and it is what
Stacks 0B8N (b) delivers for an invertible module on a covering.  It is weaker than
`SheafOfModules.IsFiniteFree`, which asks in addition that `σ` be bijective; the implication is
`Stacks.SheafOfModules.isRetractOfFiniteFree_of_isFiniteFree`.  Whether it is *strictly* weaker
is not asserted here: that would need a separating example, and this file produces none. -/
def IsRetractOfFiniteFree (R : Sheaf J RingCat.{w}) (M : SheafOfModules.{m} R) : Prop :=
  ∃ (n : ℕ)
    (σ : ∀ X : Cᵒᵖ, (M.val.obj X) →ₗ[R.obj.obj X] (Fin n →₀ R.obj.obj X))
    (ρ : ∀ X : Cᵒᵖ, (Fin n →₀ R.obj.obj X) →ₗ[R.obj.obj X] (M.val.obj X)),
    (∀ (X : Cᵒᵖ) (x : M.val.obj X), ρ X (σ X x) = x) ∧
    (∀ ⦃X Y : Cᵒᵖ⦄ (g : X ⟶ Y) (x : M.val.obj X) (i : Fin n),
      σ Y (M.val.map g x) i = R.obj.map g (σ X x i)) ∧
    (∀ ⦃X Y : Cᵒᵖ⦄ (g : X ⟶ Y) (y : Fin n →₀ R.obj.obj X),
      ρ Y (Finsupp.mapRange (R.obj.map g) (map_zero _) y) = M.val.map g (ρ X y))

/-- **Being a finite free retract on a slice site is inherited by every smaller slice site**, at
an arbitrary module universe.

Both the section map and the retraction are reindexed along `CategoryTheory.Over.map`: the
sections of a module restricted to a slice are the sections over the underlying object, so
nothing has to be transported.  This is why the predicate is recorded on sections; the
sheaf-level statement would have to be pushed along `SheafOfModules.overMap`. -/
theorem isRetractOfFiniteFree_over_of_le {M : SheafOfModules.{m} R} {Z Y : C} (h : Z ⟶ Y)
    (hM : IsRetractOfFiniteFree (R.over Y) (M.over Y)) :
    IsRetractOfFiniteFree (R.over Z) (M.over Z) := by
  obtain ⟨n, σ, ρ, hsr, hσ, hρ⟩ := hM
  exact ⟨n, fun X => σ (op ((Over.map h).obj X.unop)),
    fun X => ρ (op ((Over.map h).obj X.unop)),
    fun X x => hsr (op ((Over.map h).obj X.unop)) x,
    fun _ _ g x i => hσ ((Over.map h).op.map g) x i,
    fun _ _ g y => hρ ((Over.map h).op.map g) y⟩

/-- The inverse of a natural family of finsupp equivalences commutes with restriction. -/
private theorem finsuppEquiv_symm_mapRange {M : SheafOfModules.{m} R} {n : ℕ}
    (ψ : ∀ X : Cᵒᵖ, (M.val.obj X) ≃ₗ[R.obj.obj X] (Fin n →₀ R.obj.obj X))
    (hψ : ∀ ⦃X Y : Cᵒᵖ⦄ (g : X ⟶ Y) (x : M.val.obj X) (i : Fin n),
      ψ Y (M.val.map g x) i = R.obj.map g (ψ X x i))
    ⦃X Y : Cᵒᵖ⦄ (g : X ⟶ Y) (y : Fin n →₀ R.obj.obj X) :
    (ψ Y).symm (Finsupp.mapRange (R.obj.map g) (map_zero _) y) = M.val.map g ((ψ X).symm y) := by
  refine (LinearEquiv.symm_apply_eq _).2 (Finsupp.ext fun i => ?_)
  simp [hψ]

/-- **A split subobject of a finite free sheaf of modules is a finite free retract.**  The
sections of the finite free module are computed by
`Stacks.SheafOfModules.exists_finsuppEquiv_of_isColimit_cofan`, and the section map and the
retraction are the given split monomorphism and its retraction read through that
identification. -/
theorem isRetractOfFiniteFree_of_isSplitMono_cofan {M N : SheafOfModules.{w} R} {n : ℕ}
    (ι : ∀ _ : Fin n, SheafOfModules.unit R ⟶ N) (hN : IsColimit (Cofan.mk N ι))
    (s : M ⟶ N) (r : N ⟶ M) (hsr : s ≫ r = 𝟙 M) :
    IsRetractOfFiniteFree R M := by
  obtain ⟨ψ, hψ⟩ := exists_finsuppEquiv_of_isColimit_cofan ι hN
  refine ⟨n, fun X => (ψ X).toLinearMap ∘ₗ (s.val.app X).hom,
    fun X => (r.val.app X).hom ∘ₗ (ψ X).symm.toLinearMap, ?_, ?_, ?_⟩
  · intro X x
    have h1 : (r.val.app X) ((s.val.app X) x) = x := by
      have h2 := congrArg (fun φ : M ⟶ M => (φ.val.app X) x) hsr
      simpa using h2
    simpa using h1
  · intro X Y g x i
    have hnat := PresheafOfModules.naturality_apply s.val g x
    change (ψ Y) ((s.val.app Y) (M.val.map g x)) i = _
    rw [hnat]
    exact hψ g ((s.val.app X) x) i
  · intro X Y g y
    change (r.val.app Y) ((ψ Y).symm (Finsupp.mapRange (R.obj.map g) (map_zero _) y)) = _
    rw [finsuppEquiv_symm_mapRange ψ hψ]
    exact PresheafOfModules.naturality_apply r.val g ((ψ X).symm y)

/-- **A split subobject of a finite product of copies of the structure sheaf is a finite free
retract.**  This is the spelling in which Stacks 0B8N (b) states its conclusion.  A finite
product in a preadditive category is a biproduct, hence also a coproduct, so the product is a
finite free module and `Stacks.SheafOfModules.isRetractOfFiniteFree_of_isSplitMono_cofan`
applies. -/
theorem isRetractOfFiniteFree_of_isSplitMono_pi [HasFiniteProducts (SheafOfModules.{w} R)]
    {M : SheafOfModules.{w} R} {n : ℕ}
    (s : M ⟶ ∏ᶜ (fun _ : Fin n => SheafOfModules.unit R)) (hs : IsSplitMono s) :
    IsRetractOfFiniteFree R M := by
  have hbp : HasFiniteBiproducts (SheafOfModules.{w} R) :=
    HasFiniteBiproducts.of_hasFiniteProducts
  have := hs
  let e : (∏ᶜ fun _ : Fin n => SheafOfModules.unit R) ≅
      (∐ fun _ : Fin n => SheafOfModules.unit R) :=
    (biproduct.isoProduct _).symm ≪≫ biproduct.isoCoproduct _
  refine isRetractOfFiniteFree_of_isSplitMono_cofan
    (Sigma.ι (fun _ : Fin n => SheafOfModules.unit R))
    (coproductIsCoproduct (fun _ : Fin n => SheafOfModules.unit R))
    (s ≫ e.hom) (e.inv ≫ retraction s) ?_
  rw [Category.assoc, ← Category.assoc e.hom, e.hom_inv_id, Category.id_comp]
  exact IsSplitMono.id s

/-- **A retract of a finite product of copies of the structure sheaf is a finite free retract.**

This is the bridge from the datum `CategoryTheory.Retract M (∏ᶜ fun _ : Fin n => unit R)` that
`AlgebraicGeometry.RingedSite.IsDirectSummandOfFiniteFree` of
`StacksDraft.Ch21.Sec49.FiniteFreeSummands` carries, so that predicate converts into this one in
one step and no second development grows off it. -/
theorem isRetractOfFiniteFree_of_retract_pi [HasFiniteProducts (SheafOfModules.{w} R)]
    {M : SheafOfModules.{w} R} {n : ℕ}
    (h : Retract M (∏ᶜ (fun _ : Fin n => SheafOfModules.unit R))) :
    IsRetractOfFiniteFree R M :=
  isRetractOfFiniteFree_of_isSplitMono_pi h.i ⟨⟨h.r, h.retract⟩⟩

/-- **A finite free sheaf of modules is a finite free retract**, at an arbitrary module universe:
the section map is the natural identification of
`Stacks.SheafOfModules.exists_finsuppEquiv_of_isFiniteFree` and the retraction is its inverse.

This is the bridge from the tree's primary finite-freeness predicate
`SheafOfModules.IsFiniteFree`, and it is what backs the claim that
`Stacks.SheafOfModules.IsRetractOfFiniteFree` is the weaker of the two. -/
theorem isRetractOfFiniteFree_of_isFiniteFree {M : SheafOfModules.{m} R}
    (h : SheafOfModules.IsFiniteFree R M) : IsRetractOfFiniteFree R M := by
  obtain ⟨n, ψ, hψ⟩ := exists_finsuppEquiv_of_isFiniteFree h
  refine ⟨n, fun X => (ψ X).toLinearMap, fun X => (ψ X).symm.toLinearMap, ?_, hψ, ?_⟩
  · exact fun X x => (ψ X).symm_apply_apply x
  · intro X Y g y
    exact finsuppEquiv_symm_mapRange ψ hψ g y

/-- **A finite free retract over a chart is generated by finitely many of its sections over that
chart**, in the sectionwise sense of Stacks 03DL(5).

The generators are the images under the retraction of the tautological finitely supported
families, and the covering sieve witnessing generation over any chart is the maximal one: the
coefficients of a section are the coefficients of its image under the section map. -/
theorem exists_generates_of_isRetractOfFiniteFree_over {M : SheafOfModules.{m} R} {A : C}
    (hA : IsRetractOfFiniteFree (R.over A) (M.over A)) :
    ∃ (n : ℕ) (s : Fin n → M.val.obj (op A)),
      PresheafOfModules.Generates J M.val s := by
  classical
  obtain ⟨n, σ, ρ, hsr, hσ, hρ⟩ := hA
  refine ⟨n, fun i => ρ (op (Over.mk (𝟙 A))) (Finsupp.single i 1), ?_⟩
  intro V f t
  refine ⟨⊤, J.top_mem V, fun W g _ => ?_⟩
  set A' : (Over A)ᵒᵖ := op (Over.mk (𝟙 A)) with hA'
  set W' : (Over A)ᵒᵖ := op (Over.mk (g ≫ f)) with hW'
  set u₁ : A' ⟶ W' :=
    (Over.homMk (g ≫ f) (Category.comp_id (g ≫ f)) :
      Over.mk (g ≫ f) ⟶ Over.mk (𝟙 A)).op with hu₁
  set u₂ : (op (Over.mk f) : (Over A)ᵒᵖ) ⟶ W' :=
    (Over.homMk g rfl : Over.mk (g ≫ f) ⟶ Over.mk f).op with hu₂
  have hgen : ∀ i : Fin n, (M.over A).val.map u₁ (ρ A' (Finsupp.single i 1))
      = ρ W' (Finsupp.single i 1) := by
    intro i
    refine (hρ u₁ (Finsupp.single i 1)).symm.trans (congrArg (ρ W') ?_)
    rw [Finsupp.mapRange_single, map_one]
  have key : ∑ i, (σ W' ((M.over A).val.map u₂ t) i) •
        (M.over A).val.map u₁ (ρ A' (Finsupp.single i 1))
      = (M.over A).val.map u₂ t := by
    have h1 : ∑ i, (σ W' ((M.over A).val.map u₂ t) i) •
          (M.over A).val.map u₁ (ρ A' (Finsupp.single i 1))
        = ∑ i, (σ W' ((M.over A).val.map u₂ t) i) • ρ W' (Finsupp.single i 1) :=
      Finset.sum_congr rfl (fun i _ =>
        congrArg (fun y => (σ W' ((M.over A).val.map u₂ t) i) • y) (hgen i))
    have h2 : ρ W' (∑ i, (σ W' ((M.over A).val.map u₂ t) i) • Finsupp.single i 1)
        = ∑ i, (σ W' ((M.over A).val.map u₂ t) i) • ρ W' (Finsupp.single i 1) :=
      Eq.trans (map_sum (ρ W') (fun i => (σ W' ((M.over A).val.map u₂ t) i) •
          (Finsupp.single i 1 : Fin n →₀ (R.over A).obj.obj W')) Finset.univ)
        (Finset.sum_congr rfl (fun i _ => (ρ W').map_smul _ _))
    have h3 : (∑ i, (σ W' ((M.over A).val.map u₂ t) i) •
        (Finsupp.single i 1 : Fin n →₀ (R.over A).obj.obj W'))
        = σ W' ((M.over A).val.map u₂ t) := by simp
    exact ((h1.trans h2.symm).trans (congrArg (ρ W') h3)).trans
      (hsr W' ((M.over A).val.map u₂ t))
  exact ⟨fun i => σ W' ((M.over A).val.map u₂ t) i, key⟩

/-- **A sheaf of modules which is locally a finite free retract is of finite type**, in the
sectionwise sense of Stacks 03DL(5).  The covering family is the family of all objects over
whose slice the module is a finite free retract, which covers because the hypothesis provides a
covering of every object by such objects. -/
theorem isFiniteType_of_cover_isRetractOfFiniteFree (M : SheafOfModules.{m} R)
    (h : ∀ U : C, ∃ (I : Type (max u v)) (V : I → C) (f : ∀ i, V i ⟶ U),
      Sieve.ofArrows V f ∈ J U ∧
        ∀ i : I, IsRetractOfFiniteFree (R.over (V i)) (M.over (V i))) :
    PresheafOfModules.IsFiniteType J M.val := by
  refine ⟨{A : C // IsRetractOfFiniteFree (R.over A) (M.over A)}, Subtype.val, ?_,
    fun A => exists_generates_of_isRetractOfFiniteFree_over A.2⟩
  intro Z
  obtain ⟨I, V, f, hcov, hret⟩ := h Z
  refine J.superset_covering ?_ hcov
  refine le_trans (Sieve.ofArrows_le_ofObjects V f) (Sieve.ofObjects_mono ?_)
  rintro X ⟨i, rfl⟩
  exact ⟨⟨V i, hret i⟩, rfl⟩

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

/-! ### The base change comparison of a module which is a retract on a slice -/

/-- **A module whose sections over two charts are a split direct summand of the finitely
supported families of regular functions, compatibly with restriction, has bijective base change
comparison between them.**

This is the retract form of
`AlgebraicGeometry.Space.bijective_sectionsBaseChange_of_finsuppEquiv`.  The comparison of the
free model is Mathlib's `TensorProduct.finsuppScalarRight`, and the two commuting squares — one
for the section map, one for the retraction — exhibit the comparison of `M` as a retract of it in
the category of `𝒪_F(V)`-linear maps, whence bijectivity. -/
theorem bijective_sectionsBaseChange_of_finsuppRetract {M : Modules.{u, m} B S hS F hF}
    {n : ℕ} {U V : SmallEtale B S hS F} (f : V ⟶ U)
    (σU : (M.val.obj (op U)) →ₗ[chartRing B S hS F hF U] (Fin n →₀ chartRing B S hS F hF U))
    (ρU : (Fin n →₀ chartRing B S hS F hF U) →ₗ[chartRing B S hS F hF U] (M.val.obj (op U)))
    (σV : (M.val.obj (op V)) →ₗ[chartRing B S hS F hF V] (Fin n →₀ chartRing B S hS F hF V))
    (ρV : (Fin n →₀ chartRing B S hS F hF V) →ₗ[chartRing B S hS F hF V] (M.val.obj (op V)))
    (hU : ∀ x, ρU (σU x) = x) (hV : ∀ x, ρV (σV x) = x)
    (hσ : ∀ (x : M.val.obj (op U)) (i : Fin n),
      σV (chartRestrictLinear M f x) i = chartRestrict (hF := hF) f (σU x i))
    (hρ : ∀ y : Fin n →₀ chartRing B S hS F hF U,
      ρV (Finsupp.mapRange (chartRestrict (hF := hF) f) (map_zero _) y)
        = chartRestrictLinear M f (ρU y)) :
    Function.Bijective (sectionsBaseChange M f) := by
  classical
  let _ := chartAlgebra (hF := hF) f
  let _ := chartSectionsModule M f
  have _ := chartSections_isScalarTower M f
  have hrestrict : ∀ x : M.val.obj (op U),
      σV (chartRestrictLinear M f x)
        = Finsupp.mapRange (chartRestrict (hF := hF) f) (map_zero _) (σU x) :=
    fun x => Finsupp.ext fun i => (hσ x i).trans (Finsupp.mapRange_apply ..).symm
  have hsq1 : ∀ z : TensorProduct (chartRing B S hS F hF U) (chartRing B S hS F hF V)
        (M.val.obj (op U)),
      σV (sectionsBaseChange M f z)
        = TensorProduct.finsuppScalarRight (chartRing B S hS F hF U)
            (chartRing B S hS F hF V) (chartRing B S hS F hF V) (Fin n)
            (LinearMap.lTensor (chartRing B S hS F hF V) σU z) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul b y =>
        rw [chartBaseChange_tmul M f b y, map_smul, hrestrict y, LinearMap.lTensor_tmul]
        exact smul_mapRange_eq_finsuppScalarRight (chartRestrict (hF := hF) f) (Fin n) b (σU y)
    | add z w hz hw => simp only [map_add]; rw [hz, hw]
  have hsq2 : ∀ w : TensorProduct (chartRing B S hS F hF U) (chartRing B S hS F hF V)
        (Fin n →₀ chartRing B S hS F hF U),
      sectionsBaseChange M f (LinearMap.lTensor (chartRing B S hS F hF V) ρU w)
        = ρV (TensorProduct.finsuppScalarRight (chartRing B S hS F hF U)
            (chartRing B S hS F hF V) (chartRing B S hS F hF V) (Fin n) w) := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul b p =>
        rw [LinearMap.lTensor_tmul, chartBaseChange_tmul M f b (ρU p), ← hρ p, ← map_smul]
        exact congrArg ρV
          (smul_mapRange_eq_finsuppScalarRight (chartRestrict (hF := hF) f) (Fin n) b p)
    | add z w hz hw => simp only [map_add]; rw [hz, hw]
  have hΦ : Function.Bijective (TensorProduct.finsuppScalarRight (chartRing B S hS F hF U)
      (chartRing B S hS F hF V) (chartRing B S hS F hF V) (Fin n)) :=
    (TensorProduct.finsuppScalarRight (chartRing B S hS F hF U) (chartRing B S hS F hF V)
      (chartRing B S hS F hF V) (Fin n)).bijective
  have hlt : ∀ z, LinearMap.lTensor (chartRing B S hS F hF V) ρU
      (LinearMap.lTensor (chartRing B S hS F hF V) σU z) = z := by
    have hcomp : ρU.comp σU = LinearMap.id := LinearMap.ext hU
    have hid : (LinearMap.lTensor (chartRing B S hS F hF V) ρU).comp
        (LinearMap.lTensor (chartRing B S hS F hF V) σU) = LinearMap.id := by
      rw [← LinearMap.lTensor_comp, hcomp, LinearMap.lTensor_id]
    exact fun z => congrArg (fun l => l z) hid
  refine ⟨(injective_iff_map_eq_zero (sectionsBaseChange M f)).2 ?_, ?_⟩
  · intro z hz
    have h1 : TensorProduct.finsuppScalarRight (chartRing B S hS F hF U)
        (chartRing B S hS F hF V) (chartRing B S hS F hF V) (Fin n)
        (LinearMap.lTensor (chartRing B S hS F hF V) σU z) = 0 := by
      rw [← hsq1 z, hz, map_zero]
    have h2 : LinearMap.lTensor (chartRing B S hS F hF V) σU z = 0 :=
      hΦ.injective (h1.trans (map_zero _).symm)
    have h3 := hlt z
    rw [h2, map_zero] at h3
    exact h3.symm
  · intro y
    obtain ⟨w, hw⟩ := hΦ.surjective (σV y)
    exact ⟨LinearMap.lTensor (chartRing B S hS F hF V) ρU w,
      (hsq2 w).trans ((congrArg ρV hw).trans (hV y))⟩

/-- **The base change comparison of a module is bijective over every morphism of charts lying
over a chart on which the module is a finite free retract.**

This is the transport to the slice site at `A` of
`AlgebraicGeometry.Space.bijective_sectionsBaseChange_of_finsuppRetract`: the two objects of the
slice are `Over.mk (𝟙 A)` and `Over.mk f`, and the restriction between them is the opposite of
`CategoryTheory.Over.homMk f`. -/
theorem bijective_sectionsBaseChange_of_isRetractOfFiniteFree_over
    {M : Modules.{u, m} B S hS F hF} {A A' : (smallEtaleRingedSite B S hS F hF).C}
    (hA : Stacks.SheafOfModules.IsRetractOfFiniteFree
      (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over A) (M.over A))
    (f : A' ⟶ A) :
    Function.Bijective (sectionsBaseChange M f) := by
  obtain ⟨n, σ, ρ, hsr, hσ, hρ⟩ := hA
  refine bijective_sectionsBaseChange_of_finsuppRetract f
    (σ (op (Over.mk (𝟙 A)))) (ρ (op (Over.mk (𝟙 A))))
    (σ (op (Over.mk f))) (ρ (op (Over.mk f)))
    (fun x => hsr (op (Over.mk (𝟙 A))) x) (fun x => hsr (op (Over.mk f)) x)
    (fun x i => ?_) (fun y => ?_)
  · exact hσ ((Over.homMk f (Category.comp_id f) :
      Over.mk f ⟶ Over.mk (𝟙 A)).op) x i
  · exact hρ ((Over.homMk f (Category.comp_id f) :
      Over.mk f ⟶ Over.mk (𝟙 A)).op) y

/-! ### Coherence of an invertible module -/

/-- An étale chart of `F` is a *Noetherian affine retract chart* for `M` when the scheme
underlying it is affine with Noetherian ring of global sections and the restriction of `M` to the
slice at it is a finite free retract.

This is the `Good` predicate with which the general coherence results of
`StacksFrontier.AlgebraicGeometry.Spaces.CoherentModules` are instantiated below.  Its affine and
Noetherian components are `AlgebraicGeometry.Space.IsNoetherianAffineChart`, so the covering
produced by `AlgebraicGeometry.Space.exists_covering_through_noetherianAffine` is accepted with
no transport. -/
abbrev IsNoetherianAffineRetractChart (M : Modules.{u, m} B S hS F hF)
    (A : (smallEtaleRingedSite B S hS F hF).C) : Prop :=
  IsNoetherianAffineChart B S hS F A ∧
    Stacks.SheafOfModules.IsRetractOfFiniteFree
      (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).over A) (M.over A)

/-- **Stacks 0B8N (b) on the small étale site of an algebraic space.**  Every étale chart of `F`
has a covering family on whose members an invertible `𝒪_F`-module is a finite free retract.

`Stacks.SheafOfModules.exists_cover_isDirectSummand_finiteFree` provides the split monomorphism
into a finite product of copies of the structure sheaf; the three sheafification hypotheses it
needs are instances on the small étale ringed site and on each of its slices, by
`AlgebraicGeometry.Space.smallEtaleRingedSite_hasSheafify`,
`AlgebraicGeometry.Space.smallEtaleRingedSite_wEqualsLocallyBijective` and
`AlgebraicGeometry.Space.smallEtaleRingedSite_wEqualsLocallyBijective_over`. -/
theorem exists_cover_isRetractOfFiniteFree_of_isInvertible (M : Modules.{u, u} B S hS F hF)
    (hinv : Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS F)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).property M)
    (U : (smallEtaleRingedSite B S hS F hF).C) :
    ∃ (I : Type (u + 1)) (V : I → (smallEtaleRingedSite B S hS F hF).C)
      (f : ∀ i, V i ⟶ U),
      Sieve.ofArrows V f ∈ (smallEtaleRingedSite B S hS F hF).J U ∧
        ∀ i : I, Stacks.SheafOfModules.IsRetractOfFiniteFree
          (((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS F hF).O)).over (V i))
          (M.over (V i)) := by
  obtain ⟨I, V, f, hcov, hsum⟩ :=
    @Stacks.SheafOfModules.exists_cover_isDirectSummand_finiteFree.{u, u + 1, u}
      ((smallEtaleRingedSite B S hS F hF).C) _ ((smallEtaleRingedSite B S hS F hF).J)
      (structurePresheaf B S hS F) _ _
      (((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS F hF).O)).property) M hinv U
  refine ⟨I, V, f, hcov, fun i => ?_⟩
  obtain ⟨n, s, hs⟩ := hsum i
  exact Stacks.SheafOfModules.isRetractOfFiniteFree_of_isSplitMono_pi s hs

/-- **Every étale chart of a locally Noetherian algebraic space is covered by charts which are
affine, have Noetherian ring of sections, and over which an invertible module is a finite free
retract.**

The chart is first covered by charts over which `M` is a finite free retract, which is Stacks
0B8N (b), and each of those is then covered by Noetherian affine charts, which is
`AlgebraicGeometry.Space.exists_covering_through_noetherianAffine`; a Noetherian affine chart
over a retract chart is itself a retract chart, by
`Stacks.SheafOfModules.isRetractOfFiniteFree_over_of_le`.  The two steps are combined by
transitivity of the topology. -/
theorem exists_covering_through_noetherianAffineRetract
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (M : Modules.{u, u} B S hS F hF)
    (hinv : Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS F)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).property M)
    (W : (smallEtaleRingedSite B S hS F hF).C) :
    ∃ Sv : Sieve W, Sv ∈ (smallEtaleRingedSite B S hS F hF).J W ∧
      ∀ ⦃Y : (smallEtaleRingedSite B S hS F hF).C⦄ (h : Y ⟶ W), Sv h →
        ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A) (mm : A ⟶ W),
          IsNoetherianAffineRetractChart M A ∧ h = l ≫ mm := by
  classical
  let Sv : Sieve W :=
    { arrows := fun Y h => ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A) (mm : A ⟶ W),
        IsNoetherianAffineRetractChart M A ∧ h = l ≫ mm
      downward_closed := by
        rintro Y Z h ⟨A, l, mm, hA, rfl⟩ gg
        exact ⟨A, gg ≫ l, mm, hA, by simp⟩ }
  refine ⟨Sv, ?_, fun Y h hh => hh⟩
  obtain ⟨I, V, f, hcov, hret⟩ := exists_cover_isRetractOfFiniteFree_of_isInvertible M hinv W
  refine (smallEtaleRingedSite B S hS F hF).J.transitive hcov Sv ?_
  intro Z gz hgz
  obtain ⟨i, az, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hgz
  obtain ⟨Sz, hSz, hfac⟩ := exists_covering_through_noetherianAffine B S hS F hF Fact.out Z
  refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_ hSz
  intro Y k hk
  obtain ⟨A, l, mm, hA, hleft⟩ := hfac k hk
  refine ⟨A, l, mm ≫ (az ≫ f i),
    ⟨hA, Stacks.SheafOfModules.isRetractOfFiniteFree_over_of_le (mm ≫ az) (hret i)⟩, ?_⟩
  rw [hleft]
  exact Category.assoc _ _ _

/-- **An invertible module on a locally Noetherian algebraic space is coherent on the small
étale ringed site.**  This is the coherence-on-the-site half of the invertibility conclusion of
Stacks 07UB.

Descent, Proposition 03DX(2) is *not* used: the relations clause
`AlgebraicGeometry.Space.isCoherentOnSite_of_isCartesian` needs the base change property of the
sections only between the charts of the covering, and the covering produced by
`AlgebraicGeometry.Space.exists_covering_through_noetherianAffineRetract` consists of charts over
which `M` is a finite free retract, where
`AlgebraicGeometry.Space.bijective_sectionsBaseChange_of_isRetractOfFiniteFree_over` supplies
it. -/
theorem isCoherentOnSite_of_isInvertible
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (M : Modules.{u, u} B S hS F hF)
    (hinv : Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS F)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).property M) :
    SheafOfModules.IsCoherentOnSite M :=
  isCoherentOnSite_of_isCartesian B S hS F hF M (IsNoetherianAffineRetractChart M)
    (exists_covering_through_noetherianAffineRetract M hinv)
    (fun _ hA => hA.1.1) (fun _ hA => hA.1.2)
    (fun _ _ hA _ ff => bijective_sectionsBaseChange_of_isRetractOfFiniteFree_over hA.2 ff)
    (Stacks.SheafOfModules.isFiniteType_of_cover_isRetractOfFiniteFree M
      (exists_cover_isRetractOfFiniteFree_of_isInvertible M hinv))

/-- **An invertible module on a locally Noetherian algebraic space is coherent.**  This is the
invertibility conclusion of Stacks 07UB.

`AlgebraicGeometry.Space.IsCoherent` is quasi-coherence together with coherence on the site, and
at this module universe the first follows from the second by
`AlgebraicGeometry.Space.isCoherent_of_isCoherentOnSite`. -/
theorem isCoherent_of_isInvertible
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (M : Modules.{u, u} B S hS F hF)
    (hinv : Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS F)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).property M) :
    IsCoherent B S hS F hF M :=
  have : SheafOfModules.IsCoherentOnSite M := isCoherentOnSite_of_isInvertible M hinv
  isCoherent_of_isCoherentOnSite B S hS F hF M

/-- **Stacks 07UB, invertible modules.**  An invertible module on a locally Noetherian algebraic
space is coherent, as an instance.

This is `AlgebraicGeometry.Space.isCoherent_of_isInvertible` with invertibility taken as an
instance-implicit binder, discharged from the local context.
`Stacks.SheafOfModules.IsInvertible` is a class, which is what lets the hypothesis be written
that way; it does not mean instance search *finds* invertibility, and on this site it finds it
for nothing at all, the structure sheaf included —
`Stacks.SheafOfModules.isInvertible_unit` does not apply here, its
`CategoryTheory.GrothendieckTopology.WEqualsLocallyBijective` hypothesis not being synthesized
for the topology as the small étale ringed site spells it.  That is also what makes the instance
free: the branch it adds to the search for `AlgebraicGeometry.Space.IsCoherent` closes on the
invertibility subgoal unless the caller has already put invertibility in its context, which is
the only situation the instance is for. -/
@[stacks 07UB "invertible modules"]
instance isCoherent_of_isInvertible_instance
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (M : Modules.{u, u} B S hS F hF)
    [Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS F)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O)).property M] :
    IsCoherent B S hS F hF M :=
  isCoherent_of_isInvertible M inferInstance

end AlgebraicGeometry.Space

end
