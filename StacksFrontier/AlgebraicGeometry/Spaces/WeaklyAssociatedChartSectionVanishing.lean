-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **A quasi-coherent submodule whose stalks vanish above the weakly associated points of the
ambient module is zero.**

A weakly associated point of the submodule is weakly associated to the ambient module
(Stacks 0CTZ), hence lies in `T`, so the stalk of the submodule vanishes at some geometric point
above it; but a weakly associated point lies in the support (Stacks 0CTY), where for a
quasi-coherent module the stalk at *every* geometric point above it is nonzero (Stacks 07TZ,
part (2)).  So the submodule has no weakly associated point and vanishes by Stacks 0CU0. -/
theorem isZero_of_forall_exists_subsingleton_geometricModuleStalk
    (W : AlgebraicSpaces B S hS) {G Q : Modules.{u, u} B S hS W.1 W.2}
    [Q.IsQuasicoherentOnSite] (ιQ : Q ⟶ G) [Mono ιQ] (T : Set (points B S hS W.1))
    (hwa : weaklyAssociatedPoints B S hS W G ⊆ T)
    (hstalk : ∀ x ∈ T, ∃ xbar : GeometricPoint B S hS W.1, xbar.LiesOver x ∧
      Subsingleton (geometricModuleStalk B S hS W xbar Q)) :
    IsZero Q := by
  refine isZero_of_weaklyAssociatedPoints_eq_empty B S hS W Q
    (Set.eq_empty_of_forall_notMem fun x hx => ?_)
  obtain ⟨xbar, hlies, hsub⟩ :=
    hstalk x (hwa (weaklyAssociatedPoints_subset_of_mono B S hS ιQ hx))
  exact (not_subsingleton_iff_nontrivial.mpr
    ((mem_supportOfSheaf_iff_nontrivial_geometricModuleStalk_of_liesOver B S hS W Q xbar x
      hlies).1 (weaklyAssociatedPoints_subset_supportOfSheaf B S hS W Q hx))) hsub

variable {X : AlgebraicSpaces B S hS}

/-! ### A section over a chart as a global section on the chart space -/

/-- The morphism from the structure sheaf of the chart space of `V` to the restriction of `K`
there, attached to a section of `K` over `V`: the identity chart is a terminal object of the
small étale site of the chart space, so the section is a global section there. -/
private noncomputable def chartSectionHom (V : SmallEtale B S hS X.1)
    (K : Modules.{u, u} B S hS X.1 X.2) (a : K.val.obj (op V)) :
    (SheafOfModules.unit _ : Modules.{u, u} B S hS (chartSpace B S hS X V).1
        (chartSpace B S hS X V).2) ⟶
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).obj K :=
  (SheafOfModules.unitHomEquiv _).symm
    ((Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal _
      (isTerminalIdEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V))).symm a)

/-- The morphism attached to a section over the chart takes the unit function of the identity
chart to that section. -/
private theorem chartSectionHom_val_app_one (V : SmallEtale B S hS X.1)
    (K : Modules.{u, u} B S hS X.1 X.2) (a : K.val.obj (op V)) :
    (chartSectionHom B S hS V K a).val.app
        (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V)))
      (1 : (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS
        (chartSpace B S hS X V).1 (chartSpace B S hS X V).2).O).obj.obj
          (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V)))) = a :=
  (congrArg (fun σ : ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).obj K).sections =>
      σ.val (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V))))
    (Equiv.apply_symm_apply (SheafOfModules.unitHomEquiv _) _)).trans
    (Equiv.apply_symm_apply (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal
      ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).obj K)
      (isTerminalIdEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V))) a)

/-! ### The localisation -/

/-- **A section over an étale chart of a submodule of a quasi-coherent module whose stalks
vanish above the weakly associated points of the ambient module is zero.**

`K` is *not* assumed quasi-coherent.  On the chart space of `V` the section becomes a global
section, so it determines a morphism `𝒪 ⟶ K|_V` out of the structure sheaf; composed with the
inclusion of `K` its image is a quasi-coherent submodule `Q` of `F|_V`, by Stacks 03GA for `F|_V`
and the image clause of Stacks 03M1, and `Q` sits inside `K|_V` because the morphism factors
through it.  The weakly associated points of `F|_V` are the preimage of those of `F`
(Stacks 0CUU), hence lie in the preimage of `T`; above a point of that preimage the stalk of
`K|_V` vanishes, by Stacks 05VN for the geometric point `T` provides and Stacks 0CUU again, hence
so does the stalk of `Q`.  Therefore `Q = 0`, the morphism out of the structure sheaf is zero,
and the section, which is its value on the unit function, vanishes. -/
theorem eq_zero_of_forall_exists_subsingleton_geometricModuleStalk
    {K F : Modules.{u, u} B S hS X.1 X.2} [F.IsQuasicoherentOnSite] (ι : K ⟶ F) [Mono ι]
    (T : Set (points B S hS X.1)) (hwa : weaklyAssociatedPoints B S hS X F ⊆ T)
    (hstalk : ∀ x ∈ T, ∃ xbar : GeometricPoint B S hS X.1, xbar.LiesOver x ∧
      Subsingleton (geometricModuleStalk B S hS X xbar K))
    (V : SmallEtale B S hS X.1) (a : K.val.obj (op V)) : a = 0 := by
  have hm : Mono ((SheafOfModules.forget _).map ι) := inferInstance
  have hEmono : Mono ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
      (isEtale_chartToSpace B S hS X V)).map ι) := by
    refine (SheafOfModules.forget _).mono_of_mono_map
      (PresheafOfModules.mono_of_injective
        (f := ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
          (isEtale_chartToSpace B S hS X V)).map ι).val) fun {A} => ?_)
    exact PresheafOfModules.injective_of_mono ((SheafOfModules.forget _).map ι)
      (op ((smallEtalePostcomp B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).obj A.unop))
  have hEFqc : ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
      (isEtale_chartToSpace B S hS X V)).obj F).IsQuasicoherentOnSite :=
    ObjectProperty.prop_of_iso _ ((modulePullbackIsoEtaleModulePullback B S hS
        (chartToSpace B S hS X V) (isEtale_chartToSpace B S hS X V)).app F)
      (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
        (chartToSpace B S hS X V) F inferInstance)
  have hQqc : (image (chartSectionHom B S hS V K a ≫
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).map ι)).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_image_unconditional B S hS (chartSpace B S hS X V).1
      (chartSpace B S hS X V).2 _ (SheafOfModules.isQuasicoherentOnSite_unit _) hEFqc
  obtain ⟨g, hmono⟩ : ∃ g : image (chartSectionHom B S hS V K a ≫
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).map ι) ⟶
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).obj K, Mono g :=
    ⟨image.lift { I := _, m := _, e := chartSectionHom B S hS V K a, fac := rfl },
      mono_of_mono_fac (image.lift_fac _)⟩
  have hzero : IsZero (image (chartSectionHom B S hS V K a ≫
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).map ι)) := by
    refine isZero_of_forall_exists_subsingleton_geometricModuleStalk B S hS
      (chartSpace B S hS X V) (image.ι _)
      (pointsMap B S hS (chartSpace B S hS X V).1 (chartToSpace B S hS X V).hom ⁻¹' T) ?_ ?_
    · intro x hx
      exact hwa ((isWeaklyAssociatedPoint_etaleModulePullback_iff B S hS
        (chartToSpace B S hS X V) (isEtale_chartToSpace B S hS X V) F x).1 hx)
    · intro x hxT
      obtain ⟨xbar, hlies, hKstalk⟩ := hstalk _ hxT
      obtain ⟨ybar, hylies, hymap⟩ := exists_geometricPoint_lift_of_isEtale B S hS
        (chartSpace B S hS X V).2 X.2 (chartToSpace B S hS X V).hom
        (isEtale_chartToSpace B S hS X V) xbar x hlies.symm
      have hgp : geometricPointMap (chartToSpace B S hS X V).hom ybar = xbar :=
        Subtype.ext hymap
      have hEK : Subsingleton (geometricModuleStalk B S hS (chartSpace B S hS X V) ybar
          ((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
            (isEtale_chartToSpace B S hS X V)).obj K)) := by
        rw [← not_nontrivial_iff_subsingleton,
          nontrivial_geometricModuleStalk_etaleModulePullback_iff B S hS
            (chartToSpace B S hS X V) (isEtale_chartToSpace B S hS X V) ybar K,
          hgp, not_nontrivial_iff_subsingleton]
        exact hKstalk
      exact ⟨ybar, hylies, ⟨fun p q => injective_geometricModuleStalkMap_of_mono B S hS
        (chartSpace B S hS X V) ybar g (hEK.elim _ _)⟩⟩
  have ht : chartSectionHom B S hS V K a ≫
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).map ι = 0 := by
    rw [← image.fac (chartSectionHom B S hS V K a ≫
      (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).map ι),
      hzero.eq_of_src (image.ι _) 0, comp_zero]
  have hval : ι.val.app (op V) a = 0 := by
    have h1 := congrArg (fun ψ : (SheafOfModules.unit _ :
          Modules.{u, u} B S hS (chartSpace B S hS X V).1 (chartSpace B S hS X V).2) ⟶
        (etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
          (isEtale_chartToSpace B S hS X V)).obj F =>
      ψ.val.app (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V)))
        (1 : (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS
          (chartSpace B S hS X V).1 (chartSpace B S hS X V).2).O).obj.obj
            (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V))))) ht
    refine Eq.trans ?_ (h1.trans (by rfl))
    change (ConcreteCategory.hom (ι.val.app (op V))) a =
      (ConcreteCategory.hom (((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
          (isEtale_chartToSpace B S hS X V)).map ι).val.app
        (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V)))))
        ((ConcreteCategory.hom ((chartSectionHom B S hS V K a).val.app
          (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V)))))
          (1 : (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS
            (chartSpace B S hS X V).1 (chartSpace B S hS X V).2).O).obj.obj
              (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V)))))
    refine Eq.trans ?_ (congrArg (fun z => (ConcreteCategory.hom
      (((etaleModulePullback.{u, u} B S hS (chartToSpace B S hS X V)
        (isEtale_chartToSpace B S hS X V)).map ι).val.app
        (op (idEtaleChart B S hS ((SmallEtale.toOver B S hS X.1).obj V))))) z)
      (chartSectionHom_val_app_one B S hS V K a).symm)
    exact (DFunLike.congr_fun (congrArg ConcreteCategory.hom
      (etaleModulePullback_chartToSpace_map_val_app_idEtaleChart B S hS ι V)) a).symm
  exact PresheafOfModules.injective_of_mono ((SheafOfModules.forget _).map ι) (op V)
    (hval.trans (map_zero _).symm)

end AlgebraicGeometry.Space

end
