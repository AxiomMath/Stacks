/-!
# The small Zariski site of an algebraic space (Stacks 02YZ)

The objects of the small Zariski site of an algebraic space `F` over `S` are the open
subspaces of `F`, with the inclusions as morphisms. A family of open subspaces covers an
open subspace when it is a Zariski covering of it in the sense of Tag 02YY.

## Main definitions

* `AlgebraicGeometry.Space.OpenSubspaces` is the category of open subspaces.
* `AlgebraicGeometry.Space.OpenSubspaces.IsCovering` is its Zariski covering predicate.
* `AlgebraicGeometry.Space.OpenSubspaces.precoverage` and
  `AlgebraicGeometry.Space.OpenSubspaces.topology` give the associated topology.

## Main results

* `AlgebraicGeometry.Space.OpenSubspaces.isSite`: **Stacks 02YZ**, Zariski coverings satisfy
  the three site axioms.

## Implementation notes

The subfunctors of a fixed presheaf form a type in the ambient universe, so the open
subspaces form a genuine category; its order-category structure gives exactly the inclusion
morphisms, and a morphism of the site carries no data beyond the inequality. A covering
family of an open subspace `U` is tested by pulling each member back to `U`, so the predicate
is Tag 02YY applied to the inverse images `Xᵢ.preimage U.ι`. The topology is generated by
those families, so clients can use the usual presheaf and sheaf API without unfolding the
category.

Each axiom is reduced to local surjectivity of the single map
`∐ Xᵢ ⟶ U` built from the inclusions, which is `isCovering_iff_directMap`: the inverse image
`Xᵢ.preimage U.ι` is canonically isomorphic to `Xᵢ` over `U`, so testing the covering
condition on the inverse images is the same as testing it on the members. With that, the
isomorphism axiom is the identity on `U`, the composition axiom is local surjectivity of a
composite of two locally surjective maps of coproducts (`locallySurjective_sigmaFamily`), and
the base change axiom takes `Xᵢ ×_U V` to be the *range* of the fibre product of algebraic
spaces inside `F`, which is an open subspace by Tags 02YW and 02YX and is a pullback in the
category of open subspaces because that category is thin.

## References

* [Stacks Project, Tag 02YZ](https://stacks.math.columbia.edu/tag/02YZ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace AlgebraicGeometry.Space

/-- The inverse image of a subfunctor `U` along the inclusion of a larger subfunctor `V` is
the range of the inclusion `U ⟶ V`: a section of `V` lies in `U` exactly when it is the image
of a section of `U`. -/
public theorem preimage_eq_range_homOfLe
    {C : Type v} [Category.{w} C] {F : Cᵒᵖ ⥤ Type u}
    {U V : Subfunctor F} (h : U ≤ V) :
    U.preimage V.ι = Subfunctor.range (Subfunctor.homOfLe h) := by
  ext X x
  simp only [Subfunctor.preimage, Subfunctor.range, Set.mem_preimage,
    Set.mem_range, Subfunctor.homOfLe]
  constructor
  · exact fun hx => ⟨⟨x.1, hx⟩, rfl⟩
  · rintro ⟨y, hy⟩
    have hv : y.1 = x.1 := congrArg Subtype.val hy
    simpa [hv] using y.2

/-- The inverse image along the inclusion of a larger subfunctor `V` of an open subspace `U`
of an algebraic space over `S` is again an open subspace: that inverse image is the range of
the inclusion `U ⟶ V`, which is an open subspace by Tag 02YX. -/
public theorem isOpenSubspace_preimage_of_le
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V : Subfunctor F} (h : U ≤ V)
    (hU : IsOpenSubspace B S hS U) :
    IsOpenSubspace B S hS (U.preimage V.ι) :=
  (preimage_eq_range_homOfLe (C := BigFppfOver B S hS)
    (F := F) (U := U) (V := V) h).symm ▸
    isOpenSubspace_of_le B S hS U V hU h

/-- The inverse image of a subfunctor `U` along the inclusion of a larger subfunctor `V` is
canonically isomorphic to `U`: the canonical map out of the inverse image is bijective on
every object, because a section of `U` is already a section of `V`. -/
public noncomputable def preimageIso_of_le
    {C : Type v} [Category.{w} C] {F : Cᵒᵖ ⥤ Type u}
    {U V : Subfunctor F} (h : U ≤ V) : (U.preimage V.ι).toFunctor ≅ U.toFunctor := by
  let f := U.fromPreimage V.ι
  have hbij (X : Cᵒᵖ) : Function.Bijective (f.app X) := by
    constructor
    · intro x y hxy
      apply Subtype.ext
      apply Subtype.ext
      have hx : (f.app X x).1 = x.1.1 := rfl
      have hy : (f.app X y).1 = y.1.1 := rfl
      simpa only [hx, hy] using congrArg Subtype.val hxy
    · intro x
      let z : V.toFunctor.obj X := ⟨x.1, h X x.2⟩
      refine ⟨⟨z, ?_⟩, ?_⟩
      · change V.ι.app X z ∈ U.obj X
        simpa [z] using x.2
      · rfl
  have (X : Cᵒᵖ) : IsIso (f.app X) := (isIso_iff_bijective _).2 (hbij X)
  have : IsIso f := NatIso.isIso_of_isIso_app f
  exact asIso f

private theorem preimageIso_homOfLe
    {C : Type v} [Category.{w} C] {F : Cᵒᵖ ⥤ Type u}
    {U V : Subfunctor F} (h : U ≤ V) :
    (preimageIso_of_le h).hom ≫ Subfunctor.homOfLe h =
      Subfunctor.ι (U.preimage V.ι) := by
  apply (cancel_mono V.ι).1
  rw [Category.assoc, Subfunctor.homOfLe_ι]
  exact Subfunctor.fromPreimage_ι U V.ι

private theorem exists_sigma_section
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {I : Type u} (A : I → (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (T : BigFppfOver B S hS) (s : (∐ A).obj (op T)) :
    ∃ i t, (Sigma.ι A i).app (op T) t = s := by
  classical
  let e := sigmaObjIso A (op T) ≪≫ Types.coproductIso (fun i => (A i).obj (op T))
  rcases h : e.hom s with ⟨i, t⟩
  refine ⟨i, t, ?_⟩
  have hinj : Function.Injective e.hom := by
    intro x y hxy
    simpa using congrArg e.inv hxy
  apply hinj
  rw [h]
  show (((Sigma.ι A i).app (op T) ≫ e.hom) t) = _
  simp [e]

private theorem locallySurjective_sigmaFamily
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {I : Type u} {K : I → Type u}
    {A : (Σ i, K i) → (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {D : I → (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (f : ∀ ij, A ij ⟶ D ij.1)
    (hf : ∀ i, Presheaf.IsLocallySurjective
      (BigFppfOver.topology B S hS)
      (Sigma.desc fun j => f ⟨i, j⟩)) :
    Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS)
      (Limits.Sigma.map' Sigma.fst f) := by
  let J := BigFppfOver.topology B S hS
  let G (i : I) := Sigma.desc fun j => f ⟨i, j⟩
  refine ⟨?_⟩
  intro T s
  obtain ⟨i, t, ht⟩ := exists_sigma_section B S hS D T s
  have : Presheaf.IsLocallySurjective J (G i) := hf i
  apply J.superset_covering ?_ (Presheaf.imageSieve_mem J (G i) t)
  intro T' g hg
  rcases hg with ⟨a, ha⟩
  obtain ⟨j, b, hb⟩ := exists_sigma_section B S hS (fun j => A ⟨i, j⟩) T' a
  refine ⟨(Sigma.ι A ⟨i, j⟩).app (op T') b, ?_⟩
  show ((Sigma.ι A ⟨i, j⟩ ≫ Limits.Sigma.map' Sigma.fst f).app (op T')) b = _
  rw [Limits.Sigma.ι_comp_map']
  show ((Sigma.ι D i).app (op T') ((f ⟨i, j⟩).app (op T') b)) = _
  calc
    ((Sigma.ι D i).app (op T')) ((f ⟨i, j⟩).app (op T') b) =
        (Sigma.ι D i).app (op T')
          ((G i).app (op T') ((Sigma.ι (fun j => A ⟨i, j⟩) j).app (op T') b)) := by
            congr 1
            show (f ⟨i, j⟩).app (op T') b =
              ((Sigma.ι (fun j => A ⟨i, j⟩) j ≫ G i).app (op T')) b
            rw [Sigma.ι_desc]
    _ = (Sigma.ι D i).app (op T') ((G i).app (op T') a) := by rw [hb]
    _ = (Sigma.ι D i).app (op T') ((D i).map g.op t) := by rw [ha]
    _ = (∐ D).map g.op ((Sigma.ι D i).app (op T) t) :=
      NatTrans.naturality_apply (Sigma.ι D i) g.op t
    _ = (∐ D).map g.op s := by rw [ht]

/-- The image of a monomorphism `p : A ⟶ G` from an algebraic space `A` which is an open
immersion is an open subspace of `G`. -/
public theorem isOpenSubspace_range_of_open
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {A G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (p : A ⟶ G) [Mono p]
    (hA : IsAlgebraicSpace B S hS A)
    (hp : IsOpenImmersion B S hS p) :
    IsOpenSubspace B S hS (Subfunctor.range p) := by
  let e := asIso (Subfunctor.toRange p)
  refine ⟨AlgebraicGeometry.isAlgebraicSpace_of_iso B S hS e.symm hA, ?_⟩
  let Q := MorphismProperty.presheaf
    (MorphismProperty.inverseImage (@AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS))
  let : Q.RespectsIso := inferInstance
  exact (Q.cancel_left_of_respectsIso e.hom _).1 (by simpa [e] using hp)

private theorem isOpenImmersion_homOfLe
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U V : Subfunctor F} (hV : IsOpenSubspace B S hS V)
    (hVU : V ≤ U) :
    IsOpenImmersion B S hS (Subfunctor.homOfLe hVU) := by
  have R := isOpenSubspace_of_le B S hS V U hV hVU
  let Q := MorphismProperty.presheaf
    (MorphismProperty.inverseImage (@AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS))
  let : Q.RespectsIso := inferInstance
  have := (Q.cancel_left_of_respectsIso
    (asIso (Subfunctor.toRange (Subfunctor.homOfLe hVU))).hom _).2 R.2
  simpa using this

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-- The category of open subspaces of an algebraic space, with inclusions as morphisms. -/
@[stacks 02YZ "underlying category"]
public abbrev OpenSubspaces :=
  {U : Subfunctor F // IsOpenSubspace B S hS U}

namespace OpenSubspaces

/-- A family of open subspaces covers an open subspace if it is a Zariski cover
of that subspace in the sense of Stacks 02YY. -/
@[stacks 02YZ "covering families"]
public abbrev IsCovering
    (E : Covering.{u + 1, u + 1, u} (OpenSubspaces B S hS F)) : Prop :=
  IsZariskiCover B S hS E.2.I₀
    (fun i => (E.2.X i).1.preimage E.1.1.ι)

private noncomputable def directMap (E : Covering (OpenSubspaces B S hS F)) :
    (∐ fun i => (E.2.X i).1.toFunctor) ⟶ E.1.1.toFunctor :=
  Sigma.desc fun i => Subfunctor.homOfLe (E.2.f i).le

private theorem ι_comp_directMap (E : Covering (OpenSubspaces B S hS F)) (i : E.2.I₀) :
    Sigma.ι (fun k => (E.2.X k).1.toFunctor) i ≫ directMap B S hS F E =
      Subfunctor.homOfLe (E.2.f i).le :=
  Sigma.ι_desc _ _

set_option synthInstance.maxHeartbeats 200000 in
private theorem isCovering_iff_directMap (E : Covering (OpenSubspaces B S hS F)) :
    IsCovering B S hS F E ↔
      Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS)
        (directMap B S hS F E) := by
  let J := BigFppfOver.topology B S hS
  let A (i : E.2.I₀) := (E.2.X i).1.preimage E.1.1.ι
  let α : (∐ fun i => (A i).toFunctor) ⟶ (∐ fun i => (E.2.X i).1.toFunctor) :=
    Limits.Sigma.map fun i =>
      (preimageIso_of_le (C := BigFppfOver B S hS)
        (F := F) (U := (E.2.X i).1) (V := E.1.1) (E.2.f i).le).hom
  have hα : α ≫ directMap B S hS F E =
      Sigma.desc fun i => (A i).ι := by
    apply Limits.Sigma.hom_ext
    intro i
    dsimp [α, directMap]
    rw [← Category.assoc, Limits.Sigma.ι_map, Category.assoc, Sigma.ι_desc,
      preimageIso_homOfLe, Sigma.ι_desc]
  constructor
  · intro h
    have hlocal := h.2
    have : Presheaf.IsLocallySurjective J α := by
      dsimp [α]
      infer_instance
    rw [← hα] at hlocal
    exact Presheaf.isLocallySurjective_of_isLocallySurjective J α (directMap B S hS F E)
  · intro h
    have hopen : ∀ i, IsOpenSubspace B S hS (A i) := fun i =>
      isOpenSubspace_preimage_of_le B S hS (E.2.f i).le (E.2.X i).property
    have : Presheaf.IsLocallySurjective J α := by
      dsimp [α]
      infer_instance
    have hlocal : Presheaf.IsLocallySurjective J
        (Sigma.desc fun i => (A i).ι) := by
      rw [← hα]
      infer_instance
    exact ⟨hopen, hlocal⟩

/-- The precoverage given by Zariski covering families. -/
public def precoverage : Precoverage (OpenSubspaces B S hS F) where
  coverings U := {R | ∃ E : PreZeroHypercover.{u} U,
    R = E.presieve₀ ∧ IsCovering B S hS F ⟨U, E⟩}

/-- The Grothendieck topology of the small Zariski site. -/
public abbrev topology : GrothendieckTopology (OpenSubspaces B S hS F) :=
  (precoverage B S hS F).toGrothendieck

/-- Zariski covering families satisfy the axioms of a site. -/
@[stacks 02YZ "site axioms"]
public theorem isSite : IsSite (IsCovering B S hS F) := by
  refine ⟨?_, ?_, ?_⟩
  · intro U V f hf
    have hVU : V = U := by
      apply Subtype.ext
      exact le_antisymm f.le (inv f).le
    subst V
    show IsZariskiCover B S hS PUnit
      (fun _ : PUnit => U.1.preimage U.1.ι)
    constructor
    · intro i
      exact isOpenSubspace_preimage_of_le B S hS le_rfl U.2
    · show Presheaf.IsLocallySurjective
        (BigFppfOver.topology B S hS)
        (Sigma.desc fun _ : PUnit => (U.1.preimage U.1.ι).ι)
      have hpre : U.1.preimage U.1.ι = ⊤ := by
        apply (Subfunctor.preimage_eq_top_iff _ _).2
        simp
      rw [hpre]
      apply Presheaf.isLocallySurjective_of_surjective
      intro T x
      refine ⟨(Sigma.ι (fun _ : PUnit => (⊤ : Subfunctor U.1.toFunctor).toFunctor)
        PUnit.unit).app T ⟨x, trivial⟩, ?_⟩
      show ((Sigma.ι (fun _ : PUnit => (⊤ : Subfunctor U.1.toFunctor).toFunctor)
        PUnit.unit ≫ Sigma.desc (fun _ : PUnit => (⊤ : Subfunctor U.1.toFunctor).ι)).app T)
        ⟨x, trivial⟩ = x
      rw [Sigma.ι_desc]
      rfl
  · intro E hE F' hF htargets
    let e (i : E.2.I₀) : (F' i).1 ⟶ E.2.X i := by
      exact homOfLE (le_of_eq (htargets i))
    let eInv (i : E.2.I₀) : E.2.X i ⟶ (F' i).1 := by
      exact homOfLE (le_of_eq (htargets i).symm)
    let eNat (i : E.2.I₀) :
        (F' i).1.1.toFunctor ≅ (E.2.X i).1.toFunctor := {
      hom := Subfunctor.homOfLe (e i).le
      inv := Subfunctor.homOfLe (eInv i).le
      hom_inv_id := by
        ext
        rfl
      inv_hom_id := by
        ext
        rfl
    }
    have heNat (i : E.2.I₀) :
        (eNat i).hom = Subfunctor.homOfLe (e i).le := by
      rfl
    let Hfam : PreZeroHypercover E.1 := {
      I₀ := Σ i, (F' i).2.I₀
      X ij := (F' ij.1).2.X ij.2
      f ij := (F' ij.1).2.f ij.2 ≫ e ij.1 ≫ E.2.f ij.1
    }
    have hEqFam : Hfam = E.2.bind fun i =>
        (F' i).2.pushforward (eqToHom (htargets i)) := by
      ext <;> rfl
    let H : Covering (OpenSubspaces B S hS F) := ⟨E.1, Hfam⟩
    let f (ij : Σ i, (F' i).2.I₀) :
        ((F' ij.1).2.X ij.2).1.toFunctor ⟶ (E.2.X ij.1).1.toFunctor :=
      Subfunctor.homOfLe ((F' ij.1).2.f ij.2 ≫ e ij.1).le
    have hf : ∀ i, Presheaf.IsLocallySurjective
        (BigFppfOver.topology B S hS)
        (Sigma.desc (f := fun j => ((F' i).2.X j).1.toFunctor)
          (P := (E.2.X i).1.toFunctor) (fun j => f ⟨i, j⟩)) := by
      intro i
      let E' : Covering (OpenSubspaces B S hS F) := ⟨(F' i).1, (F' i).2⟩
      have hlocal : Presheaf.IsLocallySurjective
          (BigFppfOver.topology B S hS)
          (directMap B S hS F E') :=
        (isCovering_iff_directMap B S hS F E').1 (hF i)
      have hpost : Presheaf.IsLocallySurjective
          (BigFppfOver.topology B S hS)
          (directMap B S hS F E' ≫ (eNat i).hom) := by
        let : Presheaf.IsLocallySurjective
            (BigFppfOver.topology B S hS) (directMap B S hS F E') := hlocal
        let : IsIso (eNat i).hom := (eNat i).isIso_hom
        infer_instance
      convert hpost using 1
      apply Limits.Sigma.hom_ext
      intro j
      show (Sigma.ι (fun j => ((F' i).2.X j).1.toFunctor) j ≫
          Sigma.desc (fun j => f ⟨i, j⟩)) =
        (Sigma.ι (fun j => ((F' i).2.X j).1.toFunctor) j ≫
          Sigma.desc (fun j => Subfunctor.homOfLe ((F' i).2.f j).le)) ≫
            (eNat i).hom
      rw [Sigma.ι_desc, Sigma.ι_desc, heNat]
      ext
      rfl
    have hfirst := locallySurjective_sigmaFamily (B := B) (S := S) (hS := hS)
      (I := E.2.I₀) (K := fun i => (F' i).2.I₀)
      (A := fun ij => ((F' ij.1).2.X ij.2).1.toFunctor)
      (D := fun i => (E.2.X i).1.toFunctor) (f := f) hf
    have hsecond : Presheaf.IsLocallySurjective
        (BigFppfOver.topology B S hS)
        (directMap B S hS F E) :=
      (isCovering_iff_directMap B S hS F E).1 hE
    have hcomp : Presheaf.IsLocallySurjective
        (BigFppfOver.topology B S hS)
        (Limits.Sigma.map' Sigma.fst f ≫ directMap B S hS F E) := by
      infer_instance
    have hmap : directMap B S hS F H =
        Limits.Sigma.map' Sigma.fst f ≫ directMap B S hS F E := by
      apply Limits.Sigma.hom_ext
      intro ij
      change (Σ i, (F' i).2.I₀) at ij
      have hleft := ι_comp_directMap B S hS F H ij
      have hright : Sigma.ι (fun ij => ((F' ij.1).2.X ij.2).1.toFunctor) ij ≫
          (Limits.Sigma.map' Sigma.fst f ≫ directMap B S hS F E) =
          f ij ≫ Subfunctor.homOfLe (E.2.f ij.1).le := by
        dsimp [directMap, Limits.Sigma.map']
        have h₁ : Sigma.ι (fun ij => ((F' ij.1).2.X ij.2).1.toFunctor) ij ≫
            Sigma.desc (fun a => f a ≫ Sigma.ι (fun i => (E.2.X i).1.toFunctor) a.1) =
              f ij ≫ Sigma.ι (fun i => (E.2.X i).1.toFunctor) ij.1 :=
          Sigma.ι_desc _ _
        show (Sigma.ι (fun ij => ((F' ij.1).2.X ij.2).1.toFunctor) ij ≫
            Sigma.desc (fun a => f a ≫
              Sigma.ι (fun i => (E.2.X i).1.toFunctor) a.1)) ≫
              Sigma.desc (fun i => Subfunctor.homOfLe (E.2.f i).le) = _
        rw [h₁, Category.assoc, Sigma.ι_desc]
      rw [hleft, hright]
      ext
      rfl
    have hcover : IsCovering B S hS F H := by
      apply (isCovering_iff_directMap B S hS F H).2
      rw [hmap]
      exact hcomp
    exact hEqFam ▸ hcover
  · intro E hE V g
    classical
    let U := E.1.1
    let J := BigFppfOver.topology B S hS
    let Ualg : AlgebraicSpaces B S hS := ⟨U.toFunctor, E.1.2.1⟩
    let Valg : AlgebraicSpaces B S hS := ⟨V.1.toFunctor, V.2.1⟩
    let Xalg (i : E.2.I₀) : AlgebraicSpaces B S hS :=
      ⟨(E.2.X i).1.toFunctor, (E.2.X i).2.1⟩
    let gAlg : Valg ⟶ Ualg := ObjectProperty.homMk (Subfunctor.homOfLe g.le)
    let fAlg (i : E.2.I₀) : Xalg i ⟶ Ualg :=
      ObjectProperty.homMk (Subfunctor.homOfLe (E.2.f i).le)
    let gFun := Subfunctor.homOfLe g.le
    let fFun (i : E.2.I₀) := Subfunctor.homOfLe (E.2.f i).le
    let P (i : E.2.I₀) := AlgebraicSpaces.fiberProduct B S hS (fAlg i) gAlg
    let p1 (i : E.2.I₀) : P i ⟶ Xalg i :=
      ObjectProperty.homMk (pullback.fst (fAlg i).hom gAlg.hom)
    let p2 (i : E.2.I₀) : P i ⟶ Valg :=
      ObjectProperty.homMk (pullback.snd (fAlg i).hom gAlg.hom)
    let sq (i : E.2.I₀) := AlgebraicSpaces.isPullback_fiberProduct B S hS (fAlg i) gAlg
    let q (i : E.2.I₀) : (P i).obj ⟶ F := (p2 i).hom ≫ V.1.ι
    let Q := MorphismProperty.presheaf
      (MorphismProperty.inverseImage (@AlgebraicGeometry.IsOpenImmersion.{u})
        (BigFppfOver.toScheme B S hS))
    have hQmono :
        MorphismProperty.inverseImage (@AlgebraicGeometry.IsOpenImmersion.{u})
          (BigFppfOver.toScheme B S hS) ≤
          MorphismProperty.monomorphisms (BigFppfOver B S hS) := by
      intro A A' a ha
      have hmono : Mono ((BigFppfOver.toScheme B S hS).map a) :=
        AlgebraicGeometry.IsOpenImmersion.le_monomorphisms _ ha
      refine ⟨fun {T'} b c hbc => ?_⟩
      apply Functor.map_injective (BigFppfOver.toScheme B S hS)
      apply (cancel_mono ((BigFppfOver.toScheme B S hS).map a)).1
      exact congrArg (fun k => (BigFppfOver.toScheme B S hS).map k) hbc
    have hfι (i : E.2.I₀) : fFun i ≫ U.ι = (E.2.X i).1.ι :=
      Subfunctor.homOfLe_ι (E.2.f i).le
    have hgι : gFun ≫ U.ι = V.1.ι := Subfunctor.homOfLe_ι g.le
    have hfiOpen (i : E.2.I₀) :
        IsOpenImmersion B S hS (fFun i) :=
      isOpenImmersion_homOfLe B S hS (E.2.X i).2 (E.2.f i).le
    have hgOpen : IsOpenImmersion B S hS gFun :=
      isOpenImmersion_homOfLe B S hS V.2 g.le
    have hqOpen (i : E.2.I₀) : IsOpenImmersion B S hS (q i) := by
      have hp2 : IsOpenImmersion B S hS (p2 i).hom :=
        isOpenImmersion_of_isPullback B S hS (sq i) (hfiOpen i)
      let : Q.IsStableUnderComposition := inferInstance
      exact Q.comp_mem (p2 i).hom V.1.ι hp2 V.2.2
    have hqMono (i : E.2.I₀) : Mono (q i) :=
      MorphismProperty.presheaf_monomorphisms_le_monomorphisms _
        (MorphismProperty.relative_monotone hQmono _ (hqOpen i))
    let R (i : E.2.I₀) : Subfunctor F := Subfunctor.range (q i)
    have hcomm (i : E.2.I₀) :
        (p1 i).hom ≫ (E.2.X i).1.ι = q i := by
      have hpb : (p1 i).hom ≫ fFun i = (p2 i).hom ≫ gFun := by
        simpa [p1, p2, P, Ualg, Valg, Xalg, fAlg, gAlg, fFun, gFun] using
          congrArg (fun k => k.hom) (sq i).w
      calc
        (p1 i).hom ≫ (E.2.X i).1.ι = (p1 i).hom ≫ (fFun i ≫ U.ι) := by rw [hfι]
        _ = ((p1 i).hom ≫ fFun i) ≫ U.ι := by simp [Category.assoc]
        _ = ((p2 i).hom ≫ gFun) ≫ U.ι := by rw [hpb]
        _ = (p2 i).hom ≫ (gFun ≫ U.ι) := by simp [Category.assoc]
        _ = (p2 i).hom ≫ V.1.ι := by rw [hgι]
        _ = q i := rfl
    have hRleX (i : E.2.I₀) : R i ≤ (E.2.X i).1 := by
      calc
        R i = Subfunctor.range ((p1 i).hom ≫ (E.2.X i).1.ι) :=
          congrArg Subfunctor.range (hcomm i).symm
        _ ≤ Subfunctor.range (E.2.X i).1.ι := Subfunctor.range_comp_le _ _
        _ = (E.2.X i).1 := Subfunctor.range_ι _
    have hRleV (i : E.2.I₀) : R i ≤ V.1 := by
      calc
        R i = Subfunctor.range ((p2 i).hom ≫ V.1.ι) := rfl
        _ ≤ Subfunctor.range V.1.ι := Subfunctor.range_comp_le _ _
        _ = V.1 := Subfunctor.range_ι _
    have hRopen (i : E.2.I₀) : IsOpenSubspace B S hS (R i) := by
      let : Mono (q i) := hqMono i
      exact isOpenSubspace_range_of_open B S hS (q i) (P i).property (hqOpen i)
    let W (i : E.2.I₀) : OpenSubspaces B S hS F := ⟨R i, hRopen i⟩
    let r1 (i : E.2.I₀) : W i ⟶ E.2.X i := homOfLE (hRleX i)
    let r2 (i : E.2.I₀) : W i ⟶ V := homOfLE (hRleV i)
    have sqOpen (i : E.2.I₀) : IsPullback (r1 i) (r2 i) (E.2.f i) g := by
      apply IsPullback.mk'
      · exact Subsingleton.elim _ _
      · intro T' a b hab hba
        exact Subsingleton.elim _ _
      · intro T' a b hab
        let aFun := Subfunctor.homOfLe a.le
        let bFun := Subfunctor.homOfLe b.le
        have hcompat : aFun ≫ fFun i = bFun ≫ gFun := by
          apply (cancel_mono U.ι).1
          have ha : aFun ≫ (E.2.X i).1.ι = T'.1.ι := Subfunctor.homOfLe_ι a.le
          have hb : bFun ≫ V.1.ι = T'.1.ι := Subfunctor.homOfLe_ι b.le
          calc
            aFun ≫ fFun i ≫ U.ι = aFun ≫ (fFun i ≫ U.ι) := by simp
            _ = aFun ≫ (E.2.X i).1.ι := by rw [hfι]
            _ = T'.1.ι := ha
            _ = bFun ≫ V.1.ι := hb.symm
            _ = bFun ≫ (gFun ≫ U.ι) := by rw [hgι]
            _ = bFun ≫ gFun ≫ U.ι := by simp
        let Talg : AlgebraicSpaces B S hS :=
          ⟨T'.1.toFunctor, T'.2.1⟩
        let aAlg : Talg ⟶ Xalg i := ObjectProperty.homMk aFun
        let bAlg : Talg ⟶ Valg := ObjectProperty.homMk bFun
        have habAlg : aAlg ≫ fAlg i = bAlg ≫ gAlg := by
          apply ObjectProperty.hom_ext
          exact hcompat
        let l := (sq i).lift aAlg bAlg habAlg
        have hl : l.hom ≫ (p2 i).hom = bFun := by
          exact congrArg (fun k => k.hom) ((sq i).lift_snd aAlg bAlg habAlg)
        have hfactor : l.hom ≫ q i = T'.1.ι := by
          calc
            l.hom ≫ q i = (l.hom ≫ (p2 i).hom) ≫ V.1.ι := by simp [q, Category.assoc]
            _ = bFun ≫ V.1.ι := by rw [hl]
            _ = T'.1.ι := Subfunctor.homOfLe_ι b.le
        have hle : T'.1 ≤ R i := by
          have hrange : Subfunctor.range T'.1.ι ≤ R i := by
            rw [← hfactor]
            exact Subfunctor.range_comp_le l.hom (q i)
          simpa using hrange
        refine ⟨homOfLE hle, ?_, ?_⟩ <;> exact Subsingleton.elim _ _
    refine ⟨W, r1, r2, sqOpen, ?_⟩
    let H : Covering (OpenSubspaces B S hS F) := ⟨V, ⟨E.2.I₀, W, r2⟩⟩
    have hlocalE : Presheaf.IsLocallySurjective J (directMap B S hS F E) :=
      (isCovering_iff_directMap B S hS F E).1 hE
    apply (isCovering_iff_directMap B S hS F H).2
    refine ⟨?_⟩
    intro T s
    change V.1.toFunctor.obj (op T) at s
    let : Presheaf.IsLocallySurjective J (directMap B S hS F E) := hlocalE
    refine J.superset_covering ?_
      (Presheaf.imageSieve_mem J (directMap B S hS F E) (gFun.app (op T) s))
    intro T' i hi
    rcases hi with ⟨x, hx⟩
    obtain ⟨j, xj, hxSigma⟩ := exists_sigma_section B S hS
      (fun j => (E.2.X j).1.toFunctor) T' x
    have hcompat : (fFun j).app (op T') xj =
        gFun.app (op T') ((V.1.toFunctor).map i.op s) := by
      have hsumE := ι_comp_directMap B S hS F E j
      have hcomponent : (fFun j).app (op T') xj =
          (U.toFunctor).map i.op (gFun.app (op T) s) := by
        calc
          (fFun j).app (op T') xj =
              (directMap B S hS F E).app (op T')
                ((Sigma.ι (fun k => (E.2.X k).1.toFunctor) j).app (op T') xj) := by
            have h := congrArg (fun k => (k.app (op T')) xj) hsumE
            simpa only [NatTrans.comp_app, types_comp_apply, fFun] using h.symm
          _ = (directMap B S hS F E).app (op T') x := by rw [hxSigma]
          _ = (U.toFunctor).map i.op (gFun.app (op T) s) := hx
      calc
        (fFun j).app (op T') xj = (U.toFunctor).map i.op (gFun.app (op T) s) := hcomponent
        _ = gFun.app (op T') ((V.1.toFunctor).map i.op s) := by
          symm
          exact NatTrans.naturality_apply gFun i.op s
    let Talg : AlgebraicSpaces B S hS :=
      ⟨yoneda.obj T', isAlgebraicSpace_yoneda B S hS T'⟩
    let xmap : Talg ⟶ Xalg j :=
      ObjectProperty.homMk (yonedaEquiv.symm xj)
    let ymap : Talg ⟶ Valg :=
      ObjectProperty.homMk (yonedaEquiv.symm ((V.1.toFunctor).map i.op s))
    have hxy : xmap ≫ fAlg j = ymap ≫ gAlg := by
      apply ObjectProperty.hom_ext
      apply yonedaEquiv.injective
      show yonedaEquiv (xmap.hom ≫ (fAlg j).hom) =
        yonedaEquiv (ymap.hom ≫ gAlg.hom)
      rw [yonedaEquiv_comp, yonedaEquiv_comp]
      simp [xmap, ymap, fAlg, gAlg, fFun, gFun,
        ← NatTrans.naturality_apply] at hcompat ⊢
      exact Subtype.ext hcompat
    let zmap := (sq j).lift xmap ymap hxy
    let z : (P j).obj.obj (op T') := yonedaEquiv zmap.hom
    have hzmap : zmap.hom ≫ (p2 j).hom = ymap.hom :=
      congrArg (fun k => k.hom) ((sq j).lift_snd xmap ymap hxy)
    have hz : (p2 j).hom.app (op T') z = (V.1.toFunctor).map i.op s := by
      rw [← yonedaEquiv_comp]
      rw [hzmap]
      simp [ymap]
    let zR := (Subfunctor.toRange (q j)).app (op T') z
    have hrange : (R j).ι.app (op T') zR = (q j).app (op T') z := by
      show ((Subfunctor.toRange (q j)).app (op T') z).val = (q j).app (op T') z
      exact Subfunctor.toRange_app_val (p := q j) z
    have hmap : (Subfunctor.homOfLe (hRleV j)).app (op T') zR =
        (V.1.toFunctor).map i.op s := by
      apply Subtype.ext
      show (R j).ι.app (op T') zR = (V.1.ι).app (op T') ((V.1.toFunctor).map i.op s)
      rw [hrange]
      simp [q, NatTrans.comp_app, hz]
    refine ⟨(Sigma.ι (fun k => (W k).1.toFunctor) j).app (op T') zR, ?_⟩
    show ((directMap B S hS F H).app (op T'))
      ((Sigma.ι (fun k => (W k).1.toFunctor) j).app (op T') zR) =
        (V.1.toFunctor).map i.op s
    have hsum := ι_comp_directMap B S hS F H j
    calc
      _ = (Subfunctor.homOfLe (r2 j).le).app (op T') zR := by
        have h := congrArg (fun f => (f.app (op T')) zR) hsum
        simpa only [NatTrans.comp_app, types_comp_apply, H] using h
      _ = (V.1.toFunctor).map i.op s := by simpa [r2] using hmap

end OpenSubspaces
end AlgebraicGeometry.Space

