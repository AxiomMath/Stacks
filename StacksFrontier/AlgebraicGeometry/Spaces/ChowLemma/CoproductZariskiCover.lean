module

public import StacksFrontier.AlgebraicGeometry.Spaces.Coproduct
public import StacksFrontier.AlgebraicGeometry.Spaces.CoproductClopenSubspaces
public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationSliceGlueing

/-!
# Zariski coverings produced by a coproduct

`AlgebraicGeometry.Space.IsZariskiCover` is the covering hypothesis of the glueing lemma
`AlgebraicGeometry.Space.glueHom_of_isZariskiCover`, whose target may be an arbitrary sheaf and
in particular an algebraic space. This file produces Zariski coverings out of coproducts.

The general statement is that the ranges of the legs of a coproduct cofan of fppf sheaves form
a Zariski covering of the vertex. Its two-member, representable case reads: the images of the
two coproduct inclusions `yoneda.map coprod.inl` and `yoneda.map coprod.inr` form a Zariski
covering of `yoneda.obj (U ⨿ W)` for a binary coproduct `U ⨿ W` taken in the big fppf category
over `S`.

## Main definitions

There are no new definitions; the covering family is
`AlgebraicGeometry.Space.rangePair` applied to the two coproduct inclusions.

## Main results

* `AlgebraicGeometry.Space.isZariskiCover_range_cofan_inj`: the ranges of the legs of a
  coproduct cofan of fppf sheaves, each of whose summands is an algebraic space over `S`, are a
  Zariski covering of the vertex.
* `AlgebraicGeometry.Space.isOpenImmersion_toScheme_map_coprodInl` and
  `AlgebraicGeometry.Space.isOpenImmersion_toScheme_map_coprodInr`: the underlying scheme
  morphisms of the two coproduct inclusions of the big fppf category over `S` are open
  immersions.
* `AlgebraicGeometry.Space.ofTwoArrows_coprod_mem_topology`: the sieve generated by the two
  coproduct inclusions is a covering sieve of the fppf topology.
* `AlgebraicGeometry.Space.isZariskiCover_rangePair_coprod`: the two images of
  `yoneda.map coprod.inl` and `yoneda.map coprod.inr` are a Zariski covering of
  `yoneda.obj (U ⨿ W)`.

## Implementation notes

The geometric content is supplied by results already in the library: the pieces of a coproduct
of algebraic spaces are open subspaces
(`AlgebraicGeometry.Space.isOpenSubspace_range_cofan_inj`), the legs of a coproduct cofan of
sheaves are jointly locally surjective
(`CategoryTheory.Sheaf.isLocallySurjective_sigmaDesc_of_range_le`), and two jointly surjective
open immersions onto an object of the site generate a covering sieve
(`AlgebraicGeometry.FinitePresentationSpacesOver.ofTwoArrows_mem_topology`). What is new is
their assembly, and the representable two-member case.

## References

* [Stacks Project, Tag 02YY](https://stacks.math.columbia.edu/tag/02YY)
* [Stacks Project, Tag 040T](https://stacks.math.columbia.edu/tag/040T)
* [Stacks Project, Tag 089J](https://stacks.math.columbia.edu/tag/089J)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

section Cofan

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {I : Type u} {F : I → Sheaf (BigFppfOver.topology B S hS) (Type u)}
  {P : Sheaf (BigFppfOver.topology B S hS) (Type u)}

/-- **The ranges of the legs of a coproduct cofan of fppf sheaves are a Zariski covering of the
vertex.** Each range is an open subspace by
`AlgebraicGeometry.Space.isOpenSubspace_range_cofan_inj`, and the map out of the presheaf
coproduct of the ranges is locally surjective by
`CategoryTheory.Sheaf.isLocallySurjective_sigmaDesc_of_range_le`, every range containing the
range of the corresponding leg by definition. -/
theorem isZariskiCover_range_cofan_inj (ι : ∀ i, F i ⟶ P) (hP : IsColimit (Cofan.mk P ι))
    (hF : ∀ i, IsAlgebraicSpace B S hS (F i).obj) :
    IsZariskiCover B S hS I fun i ↦ Subfunctor.range (ι i).hom :=
  ⟨fun i ↦ isOpenSubspace_range_cofan_inj ι hP i (hF i),
    CategoryTheory.Sheaf.isLocallySurjective_sigmaDesc_of_range_le _ ι hP
      (fun i ↦ (Subfunctor.range (ι i).hom).ι) fun i ↦ by rw [Subfunctor.range_ι]⟩

end Cofan

section Coprod

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (U W : BigFppfOver B S hS)

/-- The underlying scheme morphism of the first inclusion into a binary coproduct of the big
fppf category over `S` is an open immersion: the functor to schemes preserves binary
coproducts, and the left leg of a binary coproduct cocone of schemes is an open immersion. -/
theorem isOpenImmersion_toScheme_map_coprodInl :
    _root_.AlgebraicGeometry.IsOpenImmersion
      ((BigFppfOver.toScheme B S hS).map (coprod.inl : U ⟶ U ⨿ W)) :=
  isOpenImmersion_left_of_isColimit_binaryCofan (isColimitBinaryCofanToSchemeMap U W)

/-- The underlying scheme morphism of the second inclusion into a binary coproduct of the big
fppf category over `S` is an open immersion. -/
theorem isOpenImmersion_toScheme_map_coprodInr :
    _root_.AlgebraicGeometry.IsOpenImmersion
      ((BigFppfOver.toScheme B S hS).map (coprod.inr : W ⟶ U ⨿ W)) :=
  isOpenImmersion_right_of_isColimit_binaryCofan (isColimitBinaryCofanToSchemeMap U W)

/-- **The two inclusions into a binary coproduct of the big fppf category over `S` generate a
covering sieve.** They are open immersions whose images cover the underlying scheme of the
coproduct, so this is
`AlgebraicGeometry.FinitePresentationSpacesOver.ofTwoArrows_mem_topology`. -/
theorem ofTwoArrows_coprod_mem_topology :
    Sieve.ofTwoArrows (coprod.inl : U ⟶ U ⨿ W) (coprod.inr : W ⟶ U ⨿ W) ∈
      BigFppfOver.topology B S hS (U ⨿ W) :=
  FinitePresentationSpacesOver.ofTwoArrows_mem_topology B S hS _ _
    (isOpenImmersion_toScheme_map_coprodInl B S hS U W)
    (isOpenImmersion_toScheme_map_coprodInr B S hS U W)
    fun x ↦ exists_eq_or_exists_eq_of_isColimit_binaryCofan
      (isColimitBinaryCofanToSchemeMap U W) x

/-- **The two coproduct inclusions form a Zariski covering of the representable presheaf of a
binary coproduct of the site.** So a morphism out of `yoneda.obj (U ⨿ W)` can be glued from its
two restrictions by `AlgebraicGeometry.Space.glueHom_of_isZariskiCover`. -/
theorem isZariskiCover_rangePair_coprod :
    IsZariskiCover B S hS (ULift.{u} Bool)
      (rangePair B S hS (coprod.inl : U ⟶ U ⨿ W) (coprod.inr : W ⟶ U ⨿ W)) :=
  isZariskiCover_rangePair B S hS
    (isOpenImmersion_toScheme_map_coprodInl B S hS U W)
    (isOpenImmersion_toScheme_map_coprodInr B S hS U W)
    (ofTwoArrows_coprod_mem_topology B S hS U W)

end Coprod

end AlgebraicGeometry.Space

end
