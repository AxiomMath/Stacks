module

public import StacksFrontier.AlgebraicGeometry.Descent.SectionsPullbackComparison.Comparison
public import StacksFrontier.AlgebraicGeometry.Spaces.ChowLemma.FibrePowerValuativeLift
public import StacksFrontier.AlgebraicGeometry.Spaces.ChowLemma.SchemeImageSite

/-!
# The union of the preimages of the chart, as an object of the big fppf site

For a finite family of morphisms `gᵢ : Z ⟶ Y` and an open `W ⊆ Y`, the open subscheme
`X' = ⋃ᵢ gᵢ⁻¹(W)` of `Z` as an object of the big fppf category over `S`, together with its
covering by the `d` opens `gᵢ⁻¹(W)`; and properness of the projections of the scheme-theoretic
image of a morphism into a finite fibre power of proper morphisms.

## Main definitions

* `AlgebraicGeometry.Space.unionPreimageOpens`: the open `⨆ᵢ gᵢ⁻¹(W)` of the underlying scheme
  of an object of the site.
* `AlgebraicGeometry.Space.unionPreimageObj`: `X'`, that open as an object of the big fppf
  category over `S`.
* `AlgebraicGeometry.Space.unionPreimageIncl`: the `d` open immersions `gᵢ⁻¹(W) ⟶ X'`.

## Main results

* `AlgebraicGeometry.Space.mem_unionPreimageOpens`: a point of `Z` lies in `X'` exactly when
  some coordinate of it lies in `W`.
* `AlgebraicGeometry.Space.ofArrows_unionPreimageIncl_mem_topology`: the sieve generated by the
  `d` opens `gᵢ⁻¹(W)` is a covering sieve of `X'` in the big fppf category over `S`.
* `AlgebraicGeometry.isProper_imageι_comp_overProdπ`: each projection of the scheme-theoretic
  image of a morphism into a finite fibre power of proper morphisms is proper.

## References

* [Stacks Project, Tag 089J](https://stacks.math.columbia.edu/tag/089J)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- Each projection of the scheme-theoretic image of a morphism into a finite fibre power of
proper morphisms is proper. -/
theorem isProper_imageι_comp_overProdπ {T : Scheme.{u}} {n : ℕ} {Y : Fin n → Scheme.{u}}
    (g : ∀ i, Y i ⟶ T) [∀ i, IsProper (g i)] {V : Scheme.{u}}
    (h : V ⟶ (Stacks.Chow.overProd g).left) (i : Fin n) :
    IsProper (h.imageι ≫ Stacks.Chow.overProdπ g i) :=
  have _ := isProper_overProdπ g i
  inferInstance

namespace Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (Z : BigFppfOver B S hS) {Y : Scheme.{u}} {n : ℕ}
    (g : Fin n → (Z.left.obj ⟶ Y)) (W : Y.Opens)

/-- The open `⨆ᵢ gᵢ⁻¹(W)` of the underlying scheme of an object of the big fppf category over
`S`, cut out by a finite family of morphisms to a scheme and an open of that scheme. -/
def unionPreimageOpens : Z.left.obj.Opens := ⨆ i, g i ⁻¹ᵁ W

/-- A point lies in `AlgebraicGeometry.Space.unionPreimageOpens` exactly when its image under
some `gᵢ` lies in `W`. -/
theorem mem_unionPreimageOpens (x : Z.left.obj) :
    x ∈ unionPreimageOpens B S hS Z g W ↔ ∃ i, (g i).base x ∈ W :=
  Opens.mem_iSup

/-- Each preimage `gᵢ⁻¹(W)` is contained in `AlgebraicGeometry.Space.unionPreimageOpens`. -/
theorem preimage_le_unionPreimageOpens (i : Fin n) :
    g i ⁻¹ᵁ W ≤ unionPreimageOpens B S hS Z g W :=
  le_iSup (fun i ↦ g i ⁻¹ᵁ W) i

/-- The open subscheme `AlgebraicGeometry.Space.unionPreimageOpens` of the underlying scheme of
`Z`, as an object of the big fppf category over `S`. -/
def unionPreimageObj : BigFppfOver B S hS :=
  BigFppfOver.openSubObj B S hS Z (unionPreimageOpens B S hS Z g W)

/-- The `i`-th member of the covering of `AlgebraicGeometry.Space.unionPreimageObj`, as an
object of the big fppf category over `S`. -/
def preimageObj (i : Fin n) : BigFppfOver B S hS :=
  BigFppfOver.openSubObj B S hS Z (g i ⁻¹ᵁ W)

/-- The `i`-th open immersion `gᵢ⁻¹(W) ⟶ X'`, as a morphism of the big fppf category over
`S`. -/
def unionPreimageIncl (i : Fin n) : preimageObj B S hS Z g W i ⟶ unionPreimageObj B S hS Z g W :=
  Over.homMk
    (ObjectProperty.homMk
      (X := B.obj (BigFppfOver.contains_opens B Z.left.property (g i ⁻¹ᵁ W)))
      (Y := B.obj (BigFppfOver.contains_opens B Z.left.property
        (unionPreimageOpens B S hS Z g W)))
      (Z.left.obj.homOfLE (preimage_le_unionPreimageOpens B S hS Z g W i)))
    (by
      apply ObjectProperty.hom_ext
      change Z.left.obj.homOfLE (preimage_le_unionPreimageOpens B S hS Z g W i) ≫
        (unionPreimageOpens B S hS Z g W).ι ≫ Z.hom.hom = (g i ⁻¹ᵁ W).ι ≫ Z.hom.hom
      rw [← Category.assoc, Scheme.homOfLE_ι])

/-- The underlying morphism of schemes of `AlgebraicGeometry.Space.unionPreimageIncl` is the
inclusion of opens `gᵢ⁻¹(W) ≤ ⨆ᵢ gᵢ⁻¹(W)`. -/
theorem unionPreimageIncl_toScheme (i : Fin n) :
    (BigFppfOver.toScheme B S hS).map (unionPreimageIncl B S hS Z g W i) =
      Z.left.obj.homOfLE (preimage_le_unionPreimageOpens B S hS Z g W i) :=
  rfl

/-- The underlying morphism of schemes of `AlgebraicGeometry.Space.unionPreimageIncl` is an open
immersion. -/
theorem isOpenImmersion_unionPreimageIncl (i : Fin n) :
    _root_.AlgebraicGeometry.IsOpenImmersion
      ((BigFppfOver.toScheme B S hS).map (unionPreimageIncl B S hS Z g W i)) :=
  inferInstanceAs (_root_.AlgebraicGeometry.IsOpenImmersion
    (Z.left.obj.homOfLE (preimage_le_unionPreimageOpens B S hS Z g W i)))

/-- The `d` opens `gᵢ⁻¹(W)` generate a covering sieve of
`AlgebraicGeometry.Space.unionPreimageObj` in the big fppf category over `S`. -/
theorem ofArrows_unionPreimageIncl_mem_topology :
    Sieve.ofArrows (preimageObj B S hS Z g W) (unionPreimageIncl B S hS Z g W) ∈
      BigFppfOver.topology B S hS (unionPreimageObj B S hS Z g W) := by
  refine BigFppfOver.ofArrows_mem_topology_of_isOpenImmersion B S hS _
    (isOpenImmersion_unionPreimageIncl B S hS Z g W) fun x ↦ ?_
  obtain ⟨i, hi⟩ := (mem_unionPreimageOpens B S hS Z g W x.1).1 x.2
  refine ⟨i, ⟨⟨x.1, hi⟩, ?_⟩⟩
  rw [unionPreimageIncl_toScheme]
  exact Subtype.ext (congrArg Subtype.val
    (Scheme.homOfLE_apply' (preimage_le_unionPreimageOpens B S hS Z g W i) x.1 hi))

end Space

end AlgebraicGeometry

end
