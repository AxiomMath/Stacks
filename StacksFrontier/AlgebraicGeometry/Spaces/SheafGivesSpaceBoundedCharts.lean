/-!
# Charts of bounded size on the étale sites of an algebraic space

Let `Y` be an algebraic space over `S` and fix a scheme atlas `Y₀ ⟶ Y`. The set-theoretic
condition in the proof of Stacks 0GF6 is that a sheaf of sets `𝓕` on the étale site of `Y`
receives a surjection from the representable sheaf of a *single* étale chart `V ⟶ Y`, obtained
as the disjoint union of a family of charts. This file supplies the two size estimates which
make such a disjoint union an object of the big fppf site:

* every étale chart `V` of `Y` is covered by étale charts of size at most `size Y₀`, namely the
  affine opens of the scheme `V ×_Y Y₀`: such an affine open is quasi-compact and étale over
  `Y₀`, so Stacks 04T7 bounds its size by the size of `Y₀`;
* a family of étale charts indexed by a set of size at most `μ`, each of size at most `μ`, for
  one cardinal `μ` below the cutoff, has a disjoint union which is again an étale chart of `Y`,
  covered by the members of the family through pairwise disjoint monomorphisms.

A uniform bound is what makes the second point work: the cutoff of the site need not be a
regular cardinal, so a disjoint union of fewer than `cutoff` charts of sizes merely below the
cutoff need not lie in the site.

## Main definitions

* `AlgebraicGeometry.Space.SpacesEtale.boundedSieve`: the sieve of an object of the
  spaces-étale site of `Y` generated by the morphisms out of étale charts of size at most `κ`.

## Main results

* `AlgebraicGeometry.Space.SmallEtale.exists_ofArrows_size_le_mem_topology`: an étale chart of
  `Y` is covered by étale charts of size at most the size of a fixed atlas.
* `AlgebraicGeometry.Space.SmallEtale.exists_sigma_of_size_le`: the disjoint union of a
  uniformly bounded family of étale charts, as an étale chart.
* `AlgebraicGeometry.Space.SpacesEtale.exists_boundedSieve_mem`: for some cardinal `κ` below the
  cutoff, the charts of size at most `κ` cover every object of the spaces-étale site of `Y`.
* `AlgebraicGeometry.Space.SpacesEtale.sheaf_hom_ext_of_boundedSieve`: consequently two
  morphisms of sheaves of sets on the spaces-étale site of `Y` agreeing on the sections over
  every chart of size at most `κ` are equal.

## References

* [Stacks Project, Tag 0GF6](https://stacks.math.columbia.edu/tag/0GF6)
* [Stacks Project, Tag 04T7](https://stacks.math.columbia.edu/tag/04T7)
* [Stacks Project, Tag 03G1](https://stacks.math.columbia.edu/tag/03G1)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Cardinal Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

namespace SmallEtale

/-- The size of the scheme underlying an étale chart. -/
noncomputable abbrev chartSize {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (A : SmallEtale B S hS F) : Cardinal.{u} :=
  ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS F).obj A)).size

variable {B S hS}

/-- **An étale chart is covered by charts of size at most the size of an atlas.** Let
`a₀ : Y₀ ⟶ F` be a surjective étale scheme atlas and `V` an étale chart of `F`. The affine
opens of the scheme `V ×_F Y₀`, read as charts over `V`, cover `V`: the projection
`V ×_F Y₀ ⟶ V` is surjective and étale, being a base change of `a₀`. Each of them is
quasi-compact and étale over `Y₀`, the other projection being a base change of the étale chart
`V`, so Stacks 04T7 bounds its size by `size Y₀`. -/
theorem exists_ofArrows_size_le_mem_topology {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {Y₀ : BigFppfOver B S hS} (a₀ : yoneda.obj Y₀ ⟶ F)
    (hsurj : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf a₀)
    (het : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf a₀)
    (V : SmallEtale B S hS F) :
    ∃ (ι : Type u) (A : ι → SmallEtale B S hS F) (π : ∀ i, A i ⟶ V),
      (∀ i, chartSize B S hS (A i) ≤ ((BigFppfOver.toScheme B S hS).obj Y₀).size) ∧
        Sieve.ofArrows A π ∈ SmallEtale.topology B S hS F V := by
  have hV := V.property
  let p₁ : hV.rep.pullback a₀ ⟶ V.obj.left := hV.rep.fst' a₀
  let p₂ : hV.rep.pullback a₀ ⟶ Y₀ := hV.rep.snd a₀
  have hpb : IsPullback (yoneda.map p₂) (yoneda.map p₁) a₀ V.obj.hom :=
    (hV.rep.isPullback' a₀).flip
  have hp₂ : Etale ((BigFppfOver.toScheme B S hS).map p₂) := hV.property_snd a₀
  have hp₁e : Etale ((BigFppfOver.toScheme B S hS).map p₁) :=
    het.property V.obj.hom (yoneda.map p₂) p₁ hpb
  have hp₁s : Surjective ((BigFppfOver.toScheme B S hS).map p₁) :=
    hsurj.property V.obj.hom (yoneda.map p₂) p₁ hpb
  let Pc : SmallEtale B S hS F := ⟨CostructuredArrow.mk (yoneda.map p₁ ≫ V.obj.hom),
    etale_comp_of_scheme B S hS p₁ V.obj.hom hp₁e V.property⟩
  let π : Pc ⟶ V := ObjectProperty.homMk (CostructuredArrow.homMk p₁ rfl)
  let P := (BigFppfOver.toScheme B S hS).obj (hV.rep.pullback a₀)
  refine ⟨P.affineOpens, fun O ↦ openChart B S hS F Pc O.1,
    fun O ↦ openChartInclusion B S hS F Pc O.1 ≫ π, fun O ↦ ?_, ?_⟩
  · have : IsAffine (O.1 : Scheme.{u}) := O.2
    have : _root_.AlgebraicGeometry.Smooth (O.1.ι ≫ (BigFppfOver.toScheme B S hS).map p₂) :=
      inferInstance
    have : _root_.AlgebraicGeometry.LocallyOfFinitePresentation
      (O.1.ι ≫ (BigFppfOver.toScheme B S hS).map p₂) := inferInstance
    have hlft : _root_.AlgebraicGeometry.LocallyOfFiniteType
      (O.1.ι ≫ (BigFppfOver.toScheme B S hS).map p₂) := inferInstance
    have hc : CompactSpace (O.1 : Scheme.{u}) := inferInstance
    exact @Scheme.size_le_of_locallyOfFiniteType (O.1 : Scheme.{u}) _
      (O.1.ι ≫ (BigFppfOver.toScheme B S hS).map p₂) hlft hc
  · refine ofArrows_mem_topology B S hS F _ _ ?_
    rw [Scheme.ofArrows_mem_etalePrecoverage_iff]
    refine ⟨fun x ↦ ?_, fun O ↦ etale_toScheme_toOver_map B S hS F _⟩
    obtain ⟨p, rfl⟩ := hp₁s.surj x
    have hp : p ∈ (⊤ : P.Opens) := trivial
    rw [← iSup_affineOpens_eq_top] at hp
    obtain ⟨O, hO⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
    refine ⟨O, ⟨p, hO⟩, ?_⟩
    rw [Functor.map_comp, Functor.map_comp, toScheme_map_toOver_map_openChartInclusion]
    rfl

/-- **The disjoint union of a uniformly bounded family of étale charts is an étale chart.**
Given étale charts `A i` of the algebraic space `X`, with the index type and every `A i` of
size at most one cardinal `μ` below the cutoff, their coproduct in the big fppf site carries
the étale chart glued from the charts `A i`, and the coprojections are monomorphisms of the
small étale site which generate a covering sieve and are pairwise disjoint: an object mapping
to two of them with different indices, compatibly, is covered by the empty sieve. -/
theorem exists_sigma_of_size_le {X : AlgebraicSpaces B S hS} {I : Type u}
    (A : I → SmallEtale B S hS X.1) {μ : Cardinal.{u}} (hμ : μ < B.cutoff) (hI : #I ≤ μ)
    (hA : ∀ i, chartSize B S hS (A i) ≤ μ) :
    ∃ (V : SmallEtale B S hS X.1) (j : ∀ i, A i ⟶ V),
      (∀ i, Mono (j i)) ∧ Sieve.ofArrows A j ∈ SmallEtale.topology B S hS X.1 V ∧
      (∀ i i', i ≠ i' → ∀ {Z : SmallEtale B S hS X.1} (a : Z ⟶ A i) (b : Z ⟶ A i'),
        a ≫ j i = b ≫ j i' → (⊥ : Sieve Z) ∈ SmallEtale.topology B S hS X.1 Z) := by
  classical
  obtain ⟨V₀, jj, hjjoi, hjjcov, ⟨hsch⟩, ⟨hsite⟩, -⟩ :=
    BigFppfOver.exists_isColimitUliftYoneda_of_size_le B S hS
      (fun i ↦ (SmallEtale.toOver B S hS X.1).obj (A i)) hμ hI hA
  let Xs : Sheaf (BigFppfOver.topology B S hS) (Type u) := ⟨X.1, X.2.isSheaf⟩
  obtain ⟨v, hv⟩ := exists_hom_yoneda_of_isColimit_cofan (F := fun _ : I ↦ Xs) (P := Xs)
    (fun _ ↦ 𝟙 Xs) (f := fun i ↦ (A i).obj.hom) hsite
  have hv' : ∀ i, yoneda.map (jj i) ≫ v = (A i).obj.hom :=
    fun i ↦ (hv i).trans (Category.comp_id _)
  have hloc : IsZariskiLocalAtSource
      (@_root_.AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u}) :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @_root_.AlgebraicGeometry.Etale.{u})
  have hvet : IsEtaleChart B S hS X.1 (CostructuredArrow.mk v) :=
    presheaf_inverseImage_of_openCover_source hloc
      (X.2.diagonal_representable.of_diag v) jj hjjoi hjjcov
      (fun i ↦ (hv' i).symm ▸ (A i).property)
  refine ⟨⟨CostructuredArrow.mk v, hvet⟩,
    fun i ↦ ObjectProperty.homMk (CostructuredArrow.homMk (jj i) (hv' i)), fun i ↦ ?_, ?_, ?_⟩
  · exact SmallEtale.mono_of_mono_toOver_map B S hS
      (mono_of_isColimit_toScheme B S hS _ V₀ jj hsch i)
  · refine ofArrows_mem_topology B S hS X.1 _ _ ?_
    refine Scheme.ofArrows_mem_etalePrecoverage_iff.2 ⟨hjjcov, fun i ↦ ?_⟩
    have := hjjoi i
    exact inferInstanceAs
      (_root_.AlgebraicGeometry.Etale ((BigFppfOver.toScheme B S hS).map (jj i)))
  · intro i i' hii' Z a b hab
    refine SmallEtale.bot_mem_topology B S hS X.1 Z ?_
    have hab' : (SmallEtale.toOver B S hS X.1).map a ≫ jj i =
        (SmallEtale.toOver B S hS X.1).map b ≫ jj i' := by
      have h := congrArg (SmallEtale.toOver B S hS X.1).map hab
      rw [Functor.map_comp, Functor.map_comp] at h
      exact h
    exact isEmpty_of_commSq_of_isColimit_cofanMk hsch hii'
      (a := (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map a))
      (b := (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map b))
      (by rw [← Functor.map_comp, ← Functor.map_comp, hab'])

end SmallEtale

namespace SpacesEtale

variable {B S hS} {Y : AlgebraicSpaces B S hS}

/-- The sieve of an object `Z` of the spaces-étale site of `Y` generated by the morphisms into
`Z` out of étale charts of `Y` whose scheme has size at most `κ`. -/
def boundedSieve (κ : Cardinal.{u}) (Z : SpacesEtale B S hS Y) : Sieve Z where
  arrows W g := ∃ (A : SmallEtale B S hS Y.1) (_ : SmallEtale.chartSize B S hS A ≤ κ)
    (h : W ⟶ (comparisonFunctor B S hS Y).obj A) (k : (comparisonFunctor B S hS Y).obj A ⟶ Z),
    h ≫ k = g
  downward_closed := by
    rintro W W' g ⟨A, hA, h, k, rfl⟩ e
    exact ⟨A, hA, e ≫ h, k, Category.assoc _ _ _⟩

/-- **Charts of bounded size cover the spaces-étale site.** For some cardinal `κ` below the
cutoff — the size of a scheme atlas of `Y` — every object of the spaces-étale site of `Y` is
covered by the étale charts of `Y` of size at most `κ`. Over a chart this is
`AlgebraicGeometry.Space.SmallEtale.exists_ofArrows_size_le_mem_topology`, carried into the
spaces-étale site by the dense subsite inclusion of Stacks 03G1; an arbitrary object is covered
by charts, again by Stacks 03G1. -/
theorem exists_boundedSieve_mem (Y : AlgebraicSpaces B S hS) :
    ∃ κ : Cardinal.{u}, κ < B.cutoff ∧
      ∀ Z : SpacesEtale B S hS Y, boundedSieve κ Z ∈ SpacesEtale.topology B S hS Y Z := by
  obtain ⟨Y₀, a₀, hsurj, het⟩ := Y.property.exists_atlas
  let JY := SpacesEtale.topology B S hS Y
  let Φ := comparisonFunctor B S hS Y
  have := Functor.IsDenseSubsite.isCoverDense (SmallEtale.topology B S hS Y.1) JY Φ
  refine ⟨((BigFppfOver.toScheme B S hS).obj Y₀).size, Y₀.left.property, ?_⟩
  have hchart : ∀ V : SmallEtale B S hS Y.1,
      boundedSieve ((BigFppfOver.toScheme B S hS).obj Y₀).size (Φ.obj V) ∈ JY _ := by
    intro V
    obtain ⟨ι, A, π, hA, hmem⟩ :=
      SmallEtale.exists_ofArrows_size_le_mem_topology a₀ hsurj het V
    refine JY.superset_covering ?_ ((Functor.functorPushforward_mem_iff
      (SmallEtale.topology B S hS Y.1) JY (G := Φ)).2 hmem)
    rintro W f ⟨Z', g, h, hg, rfl⟩
    obtain ⟨W', e, g', ⟨i⟩, rfl⟩ := hg
    exact ⟨A i, hA i, h ≫ Φ.map e, Φ.map (π i), by simp⟩
  intro Z
  refine JY.transitive (Functor.is_cover_of_isCoverDense Φ JY Z) _ ?_
  rintro W f ⟨hf⟩
  refine JY.superset_covering ?_ (JY.pullback_stable hf.lift (hchart hf.obj))
  rintro W' g ⟨A, hA, h, k, hk⟩
  refine ⟨A, hA, h, k ≫ hf.map, ?_⟩
  rw [← Category.assoc, hk, Category.assoc, hf.fac]

/-- **Morphisms of sheaves are determined on bounded charts.** If the charts of size at most
`κ` cover every object of the spaces-étale site of `Y`, then two morphisms of sheaves of sets
which agree on the sections over every such chart are equal. -/
theorem sheaf_hom_ext_of_boundedSieve {κ : Cardinal.{u}}
    (hκ : ∀ Z : SpacesEtale B S hS Y, boundedSieve κ Z ∈ SpacesEtale.topology B S hS Y Z)
    {M N : Sheaf (SpacesEtale.topology B S hS Y) (Type (u + 1))} {c₁ c₂ : M ⟶ N}
    (h : ∀ (A : SmallEtale B S hS Y.1), SmallEtale.chartSize B S hS A ≤ κ →
      ∀ t : M.obj.obj (op ((comparisonFunctor B S hS Y).obj A)),
        (SpacesEtale.topology B S hS Y).yonedaEquiv.symm t ≫ c₁ =
          (SpacesEtale.topology B S hS Y).yonedaEquiv.symm t ≫ c₂) :
    c₁ = c₂ := by
  have hN := (isSheaf_iff_isSheaf_of_type _ _).1 N.property
  have h' : ∀ (A : SmallEtale B S hS Y.1), SmallEtale.chartSize B S hS A ≤ κ →
      ∀ t : M.obj.obj (op ((comparisonFunctor B S hS Y).obj A)),
        c₁.hom.app _ t = c₂.hom.app _ t := by
    intro A hA t
    have := congrArg (SpacesEtale.topology B S hS Y).yonedaEquiv (h A hA t)
    rwa [GrothendieckTopology.yonedaEquiv_comp, GrothendieckTopology.yonedaEquiv_comp,
      Equiv.apply_symm_apply] at this
  have key : ∀ (Z : SpacesEtale B S hS Y) (m : M.obj.obj (op Z)),
      c₁.hom.app (op Z) m = c₂.hom.app (op Z) m := by
    intro Z m
    refine (hN.isSeparated _ (hκ Z)).ext ?_
    rintro W g ⟨A, hA, e, k, rfl⟩
    rw [op_comp, Functor.map_comp_apply, Functor.map_comp_apply,
      ← NatTrans.naturality_apply c₁.hom k.op m, ← NatTrans.naturality_apply c₂.hom k.op m,
      h' A hA]
  ext Z m
  exact key Z.unop m

end SpacesEtale

end AlgebraicGeometry.Space

end
