/-!
# Representability of the base change of a morphism with fpqc locally ample module

Let `f : X ⟶ Y` be a quasi-compact separated morphism of algebraic spaces over a scheme `S` of a
big fppf site, let `𝓛` be an invertible `𝒪_X`-module, let `T` be an affine scheme over `Y` and
let `{Tⱼ ⟶ T}` be a finite fpqc covering of `T` by affine schemes such that the clause of
Stacks 0D36 holds for `(f, 𝓛)` at each `Tⱼ`: the base change `X ×_Y Tⱼ` is a scheme `Uⱼ` on which
the pullback of `𝓛` is ample over `Tⱼ`. Then `Z = X ×_Y T` is a scheme.

This is the step of Stacks 0D3C in which `X` is shown to be a scheme. The proof follows the
source's strategy without the relative Proj: for a global section `σ` of a tensor power of the
pullback of `𝓛` to `Z`, the open subspace `V_σ ⊆ Z` on which `σ` generates is quasi-affine over `T`
by fpqc descent of quasi-affine morphisms (Stacks 0423), its base change to `Tⱼ` being the
nonvanishing locus of the pullback of `σ` in the ample `Uⱼ`; and the `V_σ` cover `Z`, because the
sections over `Uⱼ` are generated by pullbacks of sections over `Z` (flat base change, Stacks
073K) and `𝓛` is ample on `Uⱼ`. A quasi-affine algebraic space over an affine scheme is a scheme,
so `Z` is covered by open subschemes, and its schematic locus (Stacks 03JH) is everything.

## Main results

* `AlgebraicGeometry.Space.isRepresentable_surjectivityLocus_of_fpqcFamily`: each `V_σ` is a
  scheme.
* `AlgebraicGeometry.Space.exists_isPullback_of_affineFpqcFamily`: **`X ×_Y T` is a scheme.**

## References

* [Stacks Project, Tag 0D3C](https://stacks.math.columbia.edu/tag/0D3C)
* [Stacks Project, Tag 0423](https://stacks.math.columbia.edu/tag/0423)
* [Stacks Project, Tag 03JH](https://stacks.math.columbia.edu/tag/03JH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.TensorPowers (natTensorPow)

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

attribute [local instance] Stacks.SheafInternalHom.monoidalCategory

/-- The members of a finite affine fpqc covering are flat and jointly surjective. -/
theorem surjective_and_flat_of_mem_fpqcPrecoverage (T : BigAffineFppf B S hS)
    (𝒰 : PreZeroHypercover.{u + 1} T)
    (hmem : Presieve.map (BigAffineFppf.toScheme B S hS) 𝒰.presieve₀ ∈
      Scheme.fpqcPrecoverage ((BigAffineFppf.toScheme B S hS).obj T)) :
    (∀ x : (BigAffineFppf.toScheme B S hS).obj T, ∃ j,
        x ∈ Set.range ((BigAffineFppf.toScheme B S hS).map (𝒰.f j))) ∧
      ∀ j, Flat ((BigAffineFppf.toScheme B S hS).map (𝒰.f j)) := by
  have hmap : Presieve.map (BigAffineFppf.toScheme B S hS) 𝒰.presieve₀ =
      Presieve.ofArrows (fun j => (BigAffineFppf.toScheme B S hS).obj (𝒰.X j))
        (fun j => (BigAffineFppf.toScheme B S hS).map (𝒰.f j)) := by
    simp [PreZeroHypercover.presieve₀]
  rw [hmap] at hmem
  exact (Scheme.ofArrows_mem_precoverage_iff @Flat).mp
    (Scheme.propQCPrecoverage_le_precoverage _ hmem)

/-- **The surjectivity locus of a section of a tensor power is a scheme.** In the situation of
the module docstring, for a global section `σ` of `𝓛_Z^{⊗ n}` with `n ≥ 1`, the open subspace
`V_σ` of `Z` on which `σ` generates is represented by a scheme: its base change to each `Tⱼ` is a
quasi-affine scheme, so by Stacks 0423 its base change along `𝟙_T` is, and that is `V_σ`. -/
theorem isRepresentable_surjectivityLocus_of_fpqcFamily {Z : AlgebraicSpaces B S hS}
    (L : SheafOfModules.{u} (Stacks.SheafOfModules.TensorSheafification.structureSheaf
      (structureSheaf B S hS Z.1 Z.2).obj (structureRingPresheaf_isSheaf B S hS Z.1 Z.2)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible (structureSheaf B S hS Z.1 Z.2).obj
      (structureRingPresheaf_isSheaf B S hS Z.1 Z.2) L]
    (T : BigAffineFppf B S hS)
    (π : Z ⟶ (schemeSpace ((BigAffineFppf.inclusion B S hS).obj T) : AlgebraicSpaces B S hS))
    (𝒰 : PreZeroHypercover.{u + 1} T) (hfin : Finite 𝒰.I₀)
    (hmem : Presieve.map (BigAffineFppf.toScheme B S hS) 𝒰.presieve₀ ∈
      Scheme.fpqcPrecoverage ((BigAffineFppf.toScheme B S hS).obj T))
    (U : 𝒰.I₀ → BigFppfOver B S hS)
    (q : ∀ j, U j ⟶ (BigAffineFppf.inclusion B S hS).obj (𝒰.X j))
    (w : ∀ j, yoneda.obj (U j) ⟶ Z.1)
    (hw : ∀ j, IsPullback (w j) (yoneda.map (q j)) π.hom
      (yoneda.map ((BigAffineFppf.inclusion B S hS).map (𝒰.f j))))
    [∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureSheaf B S hS (yoneda.obj (U j)) (isAlgebraicSpace_yoneda B S hS (U j))).obj
      (structureRingPresheaf_isSheaf B S hS (yoneda.obj (U j))
        (isAlgebraicSpace_yoneda B S hS (U j)))
      ((modulePullback B S hS (chartSpaceMap (w j))).obj L)]
    [∀ j, Stacks.Ample.IsInvertibleModule ((BigFppfOver.toScheme B S hS).obj (U j))
      (baseChangeModule B S hS L (U j) (w j))]
    (hamp : ∀ j, Stacks.Ample.IsAmple ((BigFppfOver.toScheme B S hS).obj (U j))
      (baseChangeModule B S hS L (U j) (w j)))
    {n : ℕ} (hn : 1 ≤ n)
    (σ : (natTensorPow (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.TensorSheafification.structureSheaf
        (structureSheaf B S hS Z.1 Z.2).obj (structureRingPresheaf_isSheaf B S hS Z.1 Z.2))) L
            n).sections)
    (hV : IsOpenSubspace B S hS (surjectivityLocus (𝓖 := SheafOfModules.unit _)
      (𝓕 := natTensorPow (C := SheafOfModules.{u}
        (Stacks.SheafOfModules.TensorSheafification.structureSheaf
          (structureSheaf B S hS Z.1 Z.2).obj (structureRingPresheaf_isSheaf B S hS Z.1 Z.2))) L n)
      ((SheafOfModules.unitHomEquiv _).symm σ))) :
    (surjectivityLocus (𝓖 := SheafOfModules.unit _)
      (𝓕 := natTensorPow (C := SheafOfModules.{u}
        (Stacks.SheafOfModules.TensorSheafification.structureSheaf
          (structureSheaf B S hS Z.1 Z.2).obj (structureRingPresheaf_isSheaf B S hS Z.1 Z.2))) L n)
      ((SheafOfModules.unitHomEquiv _).symm σ)).toFunctor.IsRepresentable := by
  obtain ⟨W, p, q₀, -, hsq⟩ := isEffectiveQuasiAffineDescentAlongFpqc_of_isSheaf_fpqc B S hS
    (fun hF ↦ hF.isSheaf_fpqc) T 𝒰 hfin hmem hV.1 (isAlgebraicSpace_yoneda B S hS _)
    (_ ≫ π.hom) (𝟙 _) (fun j => by
      refine ⟨hV.2.rep.pullback (w j), hV.2.rep.fst (w j), hV.2.rep.snd (w j) ≫ q j,
        (range_eq_and_isQuasiAffine_pullback_surjectivityLocus L (w j) (hamp j) hn σ hV).2, ?_⟩
      rw [Category.comp_id, Functor.map_comp]
      exact (hV.2.rep.isPullback (w j)).paste_vert (hw j))
  have : IsIso p := hsq.isIso_fst_of_isIso
  exact isRepresentable_of_natIso (yoneda.obj W) (asIso p)

/-- **The base change of `f` along a family covering an affine fpqc-locally is a scheme.** In the
situation of the module docstring, with `Z` quasi-compact and quasi-separated over `T` and the base
change of `𝓛_Z` ample on each `Uⱼ`, the algebraic space `Z` is representable: every point lies in
a scheme `V_σ`, so the schematic locus of `Z` is everything. -/
theorem isRepresentable_of_affineFpqcFamily {Z : AlgebraicSpaces B S hS}
    (L : SheafOfModules.{u} (Stacks.SheafOfModules.TensorSheafification.structureSheaf
      (structureSheaf B S hS Z.1 Z.2).obj (structureRingPresheaf_isSheaf B S hS Z.1 Z.2)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible (structureSheaf B S hS Z.1 Z.2).obj
      (structureRingPresheaf_isSheaf B S hS Z.1 Z.2) L]
    (T : BigAffineFppf B S hS)
    (π : Z ⟶ (⟨yoneda.obj ((BigAffineFppf.inclusion B S hS).obj T),
      isAlgebraicSpace_yoneda B S hS _⟩ : AlgebraicSpaces B S hS))
    (hπqc : IsQuasiCompact B S hS π.hom) (hπqs : IsQuasiSeparated B S hS π.hom)
    (𝒰 : PreZeroHypercover.{u + 1} T) (hfin : Finite 𝒰.I₀)
    (hmem : Presieve.map (BigAffineFppf.toScheme B S hS) 𝒰.presieve₀ ∈
      Scheme.fpqcPrecoverage ((BigAffineFppf.toScheme B S hS).obj T))
    (U : 𝒰.I₀ → BigFppfOver B S hS)
    (q : ∀ j, U j ⟶ (BigAffineFppf.inclusion B S hS).obj (𝒰.X j))
    (w : ∀ j, yoneda.obj (U j) ⟶ Z.1)
    (hw : ∀ j, IsPullback (w j) (yoneda.map (q j)) π.hom
      (yoneda.map ((BigAffineFppf.inclusion B S hS).map (𝒰.f j))))
    [∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureSheaf B S hS (yoneda.obj (U j)) (isAlgebraicSpace_yoneda B S hS (U j))).obj
      (structureRingPresheaf_isSheaf B S hS (yoneda.obj (U j))
        (isAlgebraicSpace_yoneda B S hS (U j)))
      ((modulePullback B S hS (chartSpaceMap (w j))).obj L)]
    [∀ j, Stacks.Ample.IsInvertibleModule ((BigFppfOver.toScheme B S hS).obj (U j))
      (baseChangeModule B S hS L (U j) (w j))]
    (hamp : ∀ j, Stacks.Ample.IsAmple ((BigFppfOver.toScheme B S hS).obj (U j))
      (baseChangeModule B S hS L (U j) (w j))) :
    Z.1.IsRepresentable := by
  obtain ⟨hjs, hflat⟩ := surjective_and_flat_of_mem_fpqcPrecoverage T 𝒰 hmem
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj ((BigAffineFppf.inclusion B S hS).obj T)) :=
    T.property
  have : ∀ j, IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((BigAffineFppf.inclusion B S hS).obj (𝒰.X j))) := fun j => (𝒰.X j).property
  -- every point of `Z` lies in the image of a representable surjectivity locus
  refine isRepresentable_of_surjective_pointsMap_schematicLocus B S hS Z.2 fun z => ?_
  have hU := jointlySurjective_yoneda_of_scheme B S hS
    (fun j => (BigAffineFppf.inclusion B S hS).obj (𝒰.X j))
    (fun j => (BigAffineFppf.inclusion B S hS).map (𝒰.f j)) (fun x => by
      obtain ⟨j, y, hy⟩ := hjs x
      exact ⟨j, y, hy⟩)
  obtain ⟨j, t, ht⟩ := Set.mem_iUnion.mp (hU ▸ Set.mem_univ (pointsMap B S hS Z.1 π.hom z))
  have hwA : IsPullback (chartSpaceMap (w j)) (representedSpaceMap B S hS (q j)) π
      (representedSpaceMap B S hS ((BigAffineFppf.inclusion B S hS).map (𝒰.f j))) :=
    IsPullback.of_map (ObjectProperty.ι _) (ObjectProperty.hom_ext _ (hw j).w) (hw j)
  obtain ⟨v, hvz, -⟩ := exists_point_of_isPullback B S hS hwA z t ht.symm
  obtain ⟨n, hn, σ, hx⟩ := exists_notMem_supp_cokernel_chartPullbackSchemeMap π hπqc hπqs
    ((BigAffineFppf.inclusion B S hS).map (𝒰.f j)) (hflat j) (q j) (w j) (hw j) L (hamp j)
    (pointsToScheme B S hS (U j) v)
  have hV := isOpenSubspace_surjectivityLocus
    (𝓖 := SheafOfModules.unit _) (𝓕 := natTensorPow (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.TensorSheafification.structureSheaf
        (structureSheaf B S hS Z.1 Z.2).obj (structureRingPresheaf_isSheaf B S hS Z.1 Z.2))) L n)
    ((SheafOfModules.unitHomEquiv _).symm σ) (isFiniteTypeOnSite_natTensorPow L n)
  obtain ⟨hrange, -⟩ :=
    range_eq_and_isQuasiAffine_pullback_surjectivityLocus L (w j) (hamp j) hn σ hV
  obtain ⟨x', hx'⟩ : pointsToScheme B S hS (U j) v ∈
      Set.range ((BigFppfOver.toScheme B S hS).map (hV.2.rep.snd (w j))) := by
    rwa [hrange]
  obtain ⟨v', hv'⟩ := surjective_pointsToScheme B S hS (hV.2.rep.pullback (w j)) x'
  have hvv : pointsMap B S hS (yoneda.obj (hV.2.rep.pullback (w j)))
      (yoneda.map (hV.2.rep.snd (w j))) v' = v :=
    injective_pointsToScheme B S hS (U j)
      ((pointsToScheme_pointsMap B S hS (hV.2.rep.snd (w j)) v').trans
        ((congrArg ((BigFppfOver.toScheme B S hS).map (hV.2.rep.snd (w j))) hv').trans hx'))
  refine range_pointsMap_ι_le_schematicLocus B S hS _ hV
    (isRepresentable_surjectivityLocus_of_fpqcFamily L T π 𝒰 hfin hmem U q w hw hamp hn σ hV)
    ⟨pointsMap B S hS _ (hV.2.rep.fst (w j)) v', ?_⟩
  rw [← pointsMap_comp_apply, (hV.2.rep.isPullback (w j)).w, pointsMap_comp_apply, hvv]
  exact hvz

/-- If the clause of Stacks 0D36 holds for `(f, 𝓛)` at an affine `T'`, realised by a cartesian
square `p, q`, and `w` lifts `p` along `pZ : Z ⟶ X`, then the base change of `pZ^* 𝓛` along `w` is
ample. -/
theorem isAmple_baseChangeModule_of_isAmpleOnBaseChange {X Y Z : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (L : Modules.{u, u} B S hS X.1 X.2) {T' U : BigFppfOver B S hS}
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T')] {g : yoneda.obj T' ⟶ Y.1}
    (h : IsAmpleOnBaseChange B S hS f L T' g) (p : yoneda.obj U ⟶ X.1) (q : U ⟶ T')
    (hsq : IsPullback p (yoneda.map q) f.hom g) (pZ : Z ⟶ X) (w : yoneda.obj U ⟶ Z.1)
    (hw : w ≫ pZ.hom = p)
    [Stacks.Ample.IsInvertibleModule ((BigFppfOver.toScheme B S hS).obj U)
      (baseChangeModule B S hS ((modulePullback B S hS pZ).obj L) U w)] :
    Stacks.Ample.IsAmple ((BigFppfOver.toScheme B S hS).obj U)
      (baseChangeModule B S hS ((modulePullback B S hS pZ).obj L) U w) := by
  subst hw
  obtain ⟨hInv, hrel⟩ := h.2 U _ q hsq
  exact (Stacks.RelativeAmpleAffineBase.isRelativelyAmple_iff_isAmple
    ((BigFppfOver.toScheme B S hS).map q) _).mp
      ((Stacks.RelativeVeryAmple.isRelativelyAmple_congr _ _ _
        (baseChangeModuleCompIso B S hS pZ L U w).symm).mpr hrel)

/-- If the fibre product of `f : X ⟶ Y` with a point `g : h_T ⟶ Y` is representable, then there
is a scheme `U` over `T` with a cartesian square `h_U ⟶ X` over `h_T ⟶ Y`. -/
theorem exists_isPullback_of_isRepresentable_pullback {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    {T : BigFppfOver B S hS} (g : yoneda.obj T ⟶ Y.1) [(pullback f.hom g).IsRepresentable] :
    ∃ (U : BigFppfOver B S hS) (q : U ⟶ T) (p : yoneda.obj U ⟶ X.1),
      IsPullback p (yoneda.map q) f.hom g := by
  refine ⟨(pullback f.hom g).reprX,
    yoneda.preimage ((pullback f.hom g).reprW.hom ≫ pullback.snd f.hom g),
    (pullback f.hom g).reprW.hom ≫ pullback.fst f.hom g, ?_⟩
  rw [Functor.map_preimage]
  exact IsPullback.of_iso_pullback ⟨by rw [Category.assoc, pullback.condition, Category.assoc]⟩
    (pullback f.hom g).reprW rfl rfl

/-- **The base change of `f` to an affine scheme with an fpqc covering on whose members the
clause of Stacks 0D36 holds is a scheme.** Let `f : X ⟶ Y` be quasi-compact and separated, `𝓛`
invertible on `X`, `T` an affine scheme over `Y` and `{Tⱼ ⟶ T}` a finite fpqc covering of `T` by
affine schemes at each of which the clause of Stacks 0D36 holds for `(f, 𝓛)`. Then there is a
scheme `U` over `T` with a cartesian square `h_U ⟶ X` over `h_T ⟶ Y`. See the module docstring. -/
theorem exists_isPullback_of_affineFpqcFamily {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hL : Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS X.1)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)).property L)
    (hqc : IsQuasiCompact B S hS f.hom) (hsep : IsSeparated B S hS f.hom)
    (T : BigAffineFppf B S hS) (g : yoneda.obj ((BigAffineFppf.inclusion B S hS).obj T) ⟶ Y.1)
    (𝒰 : PreZeroHypercover.{u + 1} T) (hfin : Finite 𝒰.I₀)
    (hmem : Presieve.map (BigAffineFppf.toScheme B S hS) 𝒰.presieve₀ ∈
      Scheme.fpqcPrecoverage ((BigAffineFppf.toScheme B S hS).obj T))
    (h : ∀ j : 𝒰.I₀, IsAmpleOnBaseChange B S hS f L
      ((BigAffineFppf.inclusion B S hS).obj (𝒰.X j))
      (yoneda.map ((BigAffineFppf.inclusion B S hS).map (𝒰.f j)) ≫ g)) :
    ∃ (U : BigFppfOver B S hS) (q : U ⟶ (BigAffineFppf.inclusion B S hS).obj T)
      (p : yoneda.obj U ⟶ X.1), IsPullback p (yoneda.map q) f.hom g := by
  -- the base change `Z = X ×_Y T` and its two projections
  let gA : (⟨yoneda.obj ((BigAffineFppf.inclusion B S hS).obj T),
      isAlgebraicSpace_yoneda B S hS _⟩ :
      AlgebraicSpaces B S hS) ⟶ Y := ObjectProperty.homMk g
  let Z := AlgebraicSpaces.fiberProduct B S hS f gA
  let π : Z ⟶ (⟨yoneda.obj ((BigAffineFppf.inclusion B S hS).obj T),
      isAlgebraicSpace_yoneda B S hS _⟩ : AlgebraicSpaces B S hS) :=
    ObjectProperty.homMk (pullback.snd f.hom g)
  let pZ : Z ⟶ X := ObjectProperty.homMk (pullback.fst f.hom g)
  have hZsq : IsPullback pZ π f gA := AlgebraicSpaces.isPullback_fiberProduct B S hS f gA
  -- the schemes `Uⱼ = X ×_Y Tⱼ` and their points `wⱼ : h_{Uⱼ} ⟶ Z`
  choose U q p hsq using fun j => (h j).1
  let w : ∀ j, yoneda.obj (U j) ⟶ Z.1 := fun j =>
    pullback.lift (p j) (yoneda.map (q j) ≫ yoneda.map
      ((BigAffineFppf.inclusion B S hS).map (𝒰.f j)))
        ((hsq j).w.trans (Category.assoc _ _ _).symm)
  have hw : ∀ j, IsPullback (w j) (yoneda.map (q j)) π.hom
      (yoneda.map ((BigAffineFppf.inclusion B S hS).map (𝒰.f j))) := fun j =>
    IsPullback.of_right (by
        rw [show w j ≫ pullback.fst f.hom g = p j from pullback.lift_fst _ _ _]
        exact hsq j) (pullback.lift_snd _ _ _) (IsPullback.of_hasPullback f.hom g)
  -- the pullback of `𝓛` to `Z` and its invertibility
  let LZ := (modulePullback B S hS pZ).obj L
  have hLZ : Stacks.SheafOfModules.IsInvertible (structurePresheaf B S hS Z.1)
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Z.1 Z.2).O)).property
      LZ :=
    Stacks.SheafOfModules.isInvertible_pullbackModules_obj
      (f := smallEtaleRingedToposModulesHom B S hS pZ) (L := L) (hL := hL)
  have : AlgebraicGeometry.SheafOfModules.IsInvertible (structureSheaf B S hS Z.1 Z.2).obj
      (structureRingPresheaf_isSheaf B S hS Z.1 Z.2) LZ := hLZ.toAlgebraicGeometry
  have : ∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible
      (structureSheaf B S hS (yoneda.obj (U j)) (isAlgebraicSpace_yoneda B S hS (U j))).obj
      (structureRingPresheaf_isSheaf B S hS (yoneda.obj (U j))
        (isAlgebraicSpace_yoneda B S hS (U j)))
      ((modulePullback B S hS (chartSpaceMap (w j))).obj LZ) := fun j =>
    (Stacks.SheafOfModules.isInvertible_pullbackModules_obj
      (f := smallEtaleRingedToposModulesHom B S hS (chartSpaceMap (w j))) (L := LZ)
      (hL := hLZ)).toAlgebraicGeometry
  have : ∀ j, Stacks.Ample.IsInvertibleModule ((BigFppfOver.toScheme B S hS).obj (U j))
      (baseChangeModule B S hS LZ (U j) (w j)) := fun j =>
    isInvertibleModule_baseChangeModule LZ hLZ (U j) (w j)
  have : ∀ j, IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((BigAffineFppf.inclusion B S hS).obj (𝒰.X j))) := fun j => (𝒰.X j).property
  -- the base change of `𝓛_Z` to each `Uⱼ` is ample, so `Z` is a scheme, and `X ×_Y T` is
  -- represented
  have : (pullback f.hom g).IsRepresentable := isRepresentable_of_affineFpqcFamily LZ T π
    (MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := quasiCompactProperty B S hS)
      hZsq hqc)
    (isQuasiSeparated_of_isSeparated B S hS
      (MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := separatedProperty B S hS)
        hZsq hsep))
    𝒰 hfin hmem U q w hw fun j => isAmple_baseChangeModule_of_isAmpleOnBaseChange f L (h j)
      (p j) (q j) (hsq j) pZ (w j) (pullback.lift_fst _ _ _)
  exact exists_isPullback_of_isRepresentable_pullback f g

end AlgebraicGeometry.Space

