-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X X' : AlgebraicSpaces B S hS}

/-! ### Sections hit by the map of defining ideal sheaves -/

/-- **The canonical map of defining ideal sheaves hits the pullbacks of regular functions.**  Let
the square of `AlgebraicGeometry.Space.subspaceInclusion`s commute, let `d` be a commutative
diagram of étale scheme charts over `g`, and let `s` be a section of the defining ideal sheaf of
`Z'` over the chart of `X'`.  Then the section of the defining ideal sheaf of `Z` over the chart
of `X` obtained from `s` by pullback of regular functions along the vertical morphism of `d` is
in the image of the map `g^*𝓘' ⟶ 𝓘` of [Stacks Project, Tag 04CP] on sections over that chart.

The two transposes defining `AlgebraicGeometry.Space.idealSheafMap` are undone by hand; see the
implementation notes of this file.  The witness is the counit of the chartwise universal property
of the direct image, applied to the unit of the Stacks 03D7 adjunction at `s`. -/
theorem mem_range_idealSheafMap (Z : ClosedSubspaces B S hS X.1)
    (Z' : ClosedSubspaces B S hS X'.1) (g : X ⟶ X')
    (f : (⟨Z.1.toFunctor, Z.2.1⟩ : AlgebraicSpaces B S hS) ⟶
      (⟨Z'.1.toFunctor, Z'.2.1⟩ : AlgebraicSpaces B S hS))
    (hsq : subspaceInclusion B S hS X Z ≫ g = f ≫ subspaceInclusion B S hS X' Z')
    (d : ChartDiagram B S hS X.1 X'.1 g.hom)
    (s : (definingIdealSheaf B S hS X' Z').toSheafOfModules.val.obj (op d.V)) :
    (idealSheafFMap B S hS Z Z' g f hsq).app d s ∈
      LinearMap.range ((idealSheafMap B S hS Z Z' g f hsq).val.app (op d.U)).hom := by
  refine LinearMap.mem_range.mpr ⟨((modulePushforwardPresentation B S hS g).counit
    ((modulePullback B S hS g).obj
      (definingIdealSheaf B S hS X' Z').toSheafOfModules)).app d
      (((modulePullbackAdjunction B S hS g).unit.app
        (definingIdealSheaf B S hS X' Z').toSheafOfModules).val.app (op d.V) s), ?_⟩
  have hnat := (modulePushforwardPresentation B S hS g).naturality
    (idealSheafMap B S hS Z Z' g f hsq) d
    (((modulePullbackAdjunction B S hS g).unit.app
      (definingIdealSheaf B S hS X' Z').toSheafOfModules).val.app (op d.V) s)
  have h2 := (modulePushforwardPresentation B S hS g).homEquiv_apply
    (definingIdealSheaf B S hS X Z).toSheafOfModules
    (definingIdealSheaf B S hS X' Z').toSheafOfModules
    ((modulePullbackAdjunction B S hS g).homEquiv _ _
      (idealSheafMap B S hS Z Z' g f hsq)) d s
  have h1 : ((modulePullbackAdjunction B S hS g).homEquiv _ _
        (idealSheafMap B S hS Z Z' g f hsq)).val.app (op d.V) s =
      ((modulePushforward B S hS g).map
        (idealSheafMap B S hS Z Z' g f hsq)).val.app (op d.V)
        (((modulePullbackAdjunction B S hS g).unit.app
          (definingIdealSheaf B S hS X' Z').toSheafOfModules).val.app (op d.V) s) :=
    congrArg
      (fun m : (definingIdealSheaf B S hS X' Z').toSheafOfModules ⟶
          (modulePushforward B S hS g).obj
            (definingIdealSheaf B S hS X Z).toSheafOfModules ↦ m.val.app (op d.V) s)
      ((modulePullbackAdjunction B S hS g).homEquiv_unit _ _
        (idealSheafMap B S hS Z Z' g f hsq))
  refine Eq.symm (Eq.trans ?_ hnat)
  refine Eq.trans ?_ (congrArg (fun t ↦ ((modulePushforwardPresentation B S hS g).counit
    (definingIdealSheaf B S hS X Z).toSheafOfModules).app d t) h1)
  refine Eq.trans ?_ h2
  exact congrArg (fun ξ ↦ ξ.app d s) (idealSheafMap_transpose B S hS Z Z' g f hsq).symm

/-! ### The fibre product configuration -/

/-- **The fibre product `Z' ×_{X'} X` as a closed subspace of `X`.**  The inverse image
`g⁻¹(Z')` of a closed subspace `Z'` of `X'` along `g : X ⟶ X'`, which is a closed subspace of `X`
by [Stacks Project, Tag 083Q]. -/
noncomputable abbrev preimageSubspace (g : X ⟶ X') (Z' : ClosedSubspaces B S hS X'.1) :
    ClosedSubspaces B S hS X.1 :=
  ⟨Z'.1.preimage g.hom, isClosedSubspace_preimage B S hS g.hom Z'.1 X'.2 X.2 Z'.2⟩

/-- **The projection `g⁻¹(Z') ⟶ Z'`**, the vertical morphism of the fibre product square whose
horizontal morphisms are the two inclusions. -/
noncomputable abbrev preimageProjection (g : X ⟶ X') (Z' : ClosedSubspaces B S hS X'.1) :
    (⟨(Z'.1.preimage g.hom).toFunctor,
        (isClosedSubspace_preimage B S hS g.hom Z'.1 X'.2 X.2 Z'.2).1⟩ :
      AlgebraicSpaces B S hS) ⟶ (⟨Z'.1.toFunctor, Z'.2.1⟩ : AlgebraicSpaces B S hS) :=
  ObjectProperty.homMk (Z'.1.fromPreimage g.hom)

/-- **Over an affine chart diagram the defining ideal of the fibre product is generated by the
pullback of the defining ideal downstairs.**  For a commutative diagram `d` of étale scheme
charts over `g` whose two charts have affine underlying schemes, the defining ideal of
`g⁻¹(Z')` at the chart of `X` is the ideal generated by the image of the defining ideal of `Z'`
at the chart of `X'` under pullback of regular functions along the vertical morphism of `d`.

This is `AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map` read on a chart diagram: the
closed subscheme cut out upstairs is the base change of the one cut out downstairs, and the
ideal of a base change is the extension of the ideal. -/
@[ega "IV 11.3.4" "more general"]
theorem definingIdealAt_preimage_eq_map_chartDiagram (g : X ⟶ X')
    (Z' : ClosedSubspaces B S hS X'.1) (d : ChartDiagram B S hS X.1 X'.1 g.hom)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj d.U.1.left)] :
    definingIdealAt B S hS X (preimageSubspace B S hS g Z') (op d.U) =
      Ideal.map (chartDiagramPullback B S hS g d).hom
        (definingIdealAt B S hS X' Z' (op d.V)) :=
  definingIdealAt_preimage_eq_map B S hS g Z' d.V d.U d.g d.comm.symm

/-- **The canonical map of defining ideal sheaves of a fibre product square is surjective on the
sections over an affine chart diagram.**  Let `Z' ⊆ X'` be a closed subspace, `g : X ⟶ X'` a
morphism of algebraic spaces, and let the square be the fibre product one, with `g⁻¹(Z') ⊆ X`
upstairs and the projection as its vertical morphism.  Then for every commutative diagram of
étale scheme charts over `g` whose two charts have affine underlying schemes, the map
`g^*𝓘' ⟶ 𝓘` of [Stacks Project, Tag 04CP] is surjective on the sections over the chart of `X`.

The sections upstairs are the defining ideal of `g⁻¹(Z')` there, which by
`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map_chartDiagram` is generated by the
pullbacks of the sections downstairs, and each of those is hit by
`AlgebraicGeometry.Space.mem_range_idealSheafMap`; the image of a linear map is a submodule, so
it contains the ideal they generate.

This is the affine-chart content of the surjectivity clause of [Stacks Project, Tag 04CQ]; the
clause itself is `AlgebraicGeometry.Space.epi_conormalMap` of
`StacksFrontier/AlgebraicGeometry/Spaces/ConormalModuleBaseChangeEpi.lean`, which is why no
`@[stacks 04CQ]` attribute is claimed here. -/
theorem surjective_idealSheafMap_val_app (g : X ⟶ X')
    (Z' : ClosedSubspaces B S hS X'.1) (d : ChartDiagram B S hS X.1 X'.1 g.hom)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj d.U.1.left)] :
    Function.Surjective
      ((idealSheafMap B S hS (preimageSubspace B S hS g Z') Z' g
        (preimageProjection B S hS g Z')
        (conormalEtaleRestrictionSquare B S hS g Z')).val.app (op d.U)).hom := by
  have hmap := definingIdealAt_preimage_eq_map_chartDiagram B S hS g Z' d
  have hle : Ideal.map (chartDiagramPullback B S hS g d).hom
        (definingIdealAt B S hS X' Z' (op d.V)) ≤
      definingIdealAt B S hS X (preimageSubspace B S hS g Z') (op d.U) := hmap.ge
  have aux : ∀ b, b ∈ Ideal.map (chartDiagramPullback B S hS g d).hom
        (definingIdealAt B S hS X' Z' (op d.V)) →
      ∀ hb : b ∈ definingIdealAt B S hS X (preimageSubspace B S hS g Z') (op d.U),
        (⟨b, hb⟩ : ToType ((definingIdealSheaf B S hS X
            (preimageSubspace B S hS g Z')).toSheafOfModules.val.obj (op d.U))) ∈
          LinearMap.range ((idealSheafMap B S hS (preimageSubspace B S hS g Z') Z' g
            (preimageProjection B S hS g Z')
            (conormalEtaleRestrictionSquare B S hS g Z')).val.app (op d.U)).hom := by
    intro b hb
    induction hb using Submodule.span_induction with
    | mem b hb =>
        obtain ⟨a, ha, rfl⟩ := hb
        intro hbI
        exact mem_range_idealSheafMap B S hS (preimageSubspace B S hS g Z') Z' g
          (preimageProjection B S hS g Z')
          (conormalEtaleRestrictionSquare B S hS g Z') d ⟨a, ha⟩
    | zero =>
        intro hbI
        exact Submodule.zero_mem _
    | add b c hb hc ihb ihc =>
        intro hbI
        exact Submodule.add_mem _ (ihb (hle hb)) (ihc (hle hc))
    | smul r b hb ih =>
        intro hbI
        exact Submodule.smul_mem _ r (ih (hle hb))
  intro y
  obtain ⟨x, hx⟩ := aux y.1 (hmap.le y.2) y.2
  exact ⟨x, hx.trans (Subtype.ext rfl)⟩

end AlgebraicGeometry.Space

end
