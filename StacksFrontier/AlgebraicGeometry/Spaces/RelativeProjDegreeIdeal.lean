module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GradedIdealGeneratedInDegree
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSubmodules
public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentChartSectionsFinite
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjQuotientSituation

/-!
# The quasi-coherent graded ideal generated in one degree, on an algebraic space

In Situation 0849 let `ℱ ⊆ 𝒜_d` be a quasi-coherent submodule of one homogeneous piece.  This
file proves that the graded ideal `ℱ𝒜` generated by `ℱ`
(`SheafOfModules.GradedAlgebra.Ideal.ofDegree`) has quasi-coherent homogeneous pieces, so that it
is a quasi-coherent graded ideal of Situation 0849 and `Proj_X(𝒜/ℱ𝒜)` is defined: this is the
graded ideal in the conclusion of Stacks 085M.

## Main results

* `AlgebraicGeometry.Space.sheafifySubmodule_obj_eq_of_isAffine` and
  `AlgebraicGeometry.Space.isCartesianOnAffineCharts_sheafifySubmodule`: the closure of an
  objectwise submodule of a quasi-coherent module which is generated, along every morphism of
  affine charts, by the restrictions of its sections, has those sections over affine charts and
  is cartesian on affine charts.
* `AlgebraicGeometry.Space.isQuasicoherentOnSite_generatedInDegree`: `(ℱ𝒜)_n` is quasi-coherent.
* `AlgebraicGeometry.Space.RelativeProjSituation.GradedIdeal.ofDegree`: `ℱ𝒜` as a quasi-coherent
  graded ideal of Situation 0849.

## Implementation notes

Over an affine chart the sections of `(ℱ𝒜)_n` are the span of the products `f · a` of sections
over that chart; this is descent along a finite affine étale covering family,
`AlgebraicGeometry.Space.mem_of_locally_mem_span_restrict`.  Along a morphism `V ⟶ U` of affine
charts the sections of `ℱ` and of `𝒜_m` over `V` are generated by restrictions of sections over
`U`, both being cartesian, and the multiplication is bilinear and compatible with restriction, so
the products over `V` are generated by restrictions of products over `U`.

## References

* [Stacks Project, Tag 085M](https://stacks.math.columbia.edu/tag/085M)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite SheafOfModules.GradedAlgebra

universe u

namespace AlgebraicGeometry.Space

section Closure

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hX : IsAlgebraicSpace B S hS X}
  {M : Modules.{u, u} B S hS X hX}

/-- **The sections over an affine chart of the closure of a chartwise generated submodule.**  Let
`P` be an objectwise submodule of a module `M` cartesian on affine charts, such that along every
morphism of affine charts `V ⟶ U` the sections of `P` over `V` are generated by restrictions of
sections over `U`.  Then over an affine chart the closure of `P` has the sections of `P`. -/
theorem sheafifySubmodule_obj_eq_of_isAffine (hM : IsCartesianOnAffineCharts M)
    (P : M.val.Submodule)
    (hP : ∀ {U V : SmallEtale B S hS X}, IsAffine (chartScheme U) → IsAffine (chartScheme V) →
      ∀ φ : V ⟶ U, P.obj (op V) ≤ Submodule.span (chartRing B S hS X hX V)
        (chartRestrictLinear M φ '' (P.obj (op U) : Set (M.val.obj (op U)))))
    {U : SmallEtale B S hS X} (hU : IsAffine (chartScheme U)) :
    (Stacks.SheafOfModules.sheafifySubmodule P).obj (op U) = P.obj (op U) := by
  refine le_antisymm (fun t ht => ?_) (Stacks.SheafOfModules.le_sheafifySubmodule P (op U))
  obtain ⟨Sv, hSv, hSv'⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule ht
  exact mem_of_locally_mem_span_restrict B S hS X hX hM hU (P.obj (op U)) t hSv
    fun w ρ hw hρ => hP hU hw ρ (hSv' ρ hρ)

/-- **The closure of a chartwise generated submodule is cartesian on affine charts**, the ambient
module being so. -/
theorem isCartesianOnAffineCharts_sheafifySubmodule (hM : IsCartesianOnAffineCharts M)
    (P : M.val.Submodule)
    (hP : ∀ {U V : SmallEtale B S hS X}, IsAffine (chartScheme U) → IsAffine (chartScheme V) →
      ∀ φ : V ⟶ U, P.obj (op V) ≤ Submodule.span (chartRing B S hS X hX V)
        (chartRestrictLinear M φ '' (P.obj (op U) : Set (M.val.obj (op U))))) :
    IsCartesianOnAffineCharts (Stacks.SheafOfModules.sheafifySubmodule P).toSheafOfModules := by
  refine isCartesianOnAffineCharts_toSheafOfModules_of_le_span hM _ fun {T T'} hT hT' g => ?_
  rw [sheafifySubmodule_obj_eq_of_isAffine hM P hP hT,
    sheafifySubmodule_obj_eq_of_isAffine hM P hP hT']
  exact hP hT hT' g

/-- **Products along a morphism of affine charts are generated by restrictions of products.**
Let `μ : M₁ × M₂ ⟶ M₃` be bilinear, `N₁ ⊆ M₁` and `M₂` cartesian on affine charts, and `P` a
submodule of the sections of `M₃` over an affine chart `U` containing the products of sections of
`N₁` and `M₂` over `U`.  Then along a morphism of affine charts `V ⟶ U` the products of sections
of `N₁` and `M₂` over `V` lie in the span of the restrictions of `P`. -/
theorem bilinear_mem_span_image {M₁ M₂ M₃ : Modules.{u, u} B S hS X hX}
    (μ : Stacks.BilinearMap M₁.val M₂.val M₃.val) (N₁ : M₁.Submodule)
    (hN₁ : IsCartesianOnAffineCharts N₁.toSheafOfModules) (hM₂ : IsCartesianOnAffineCharts M₂)
    {U V : SmallEtale B S hS X} (hU : IsAffine (chartScheme U)) (hV : IsAffine (chartScheme V))
    (φ : V ⟶ U) (P : Submodule (chartRing B S hS X hX U) (M₃.val.obj (op U)))
    (hP : ∀ y ∈ N₁.obj (op U), ∀ z : M₂.val.obj (op U), μ.app (op U) y z ∈ P)
    {f : M₁.val.obj (op V)} (hf : f ∈ N₁.obj (op V)) (b : M₂.val.obj (op V)) :
    μ.app (op V) f b ∈ Submodule.span (chartRing B S hS X hX V)
      (chartRestrictLinear M₃ φ '' (P : Set (M₃.val.obj (op U)))) := by
  set Q := Submodule.span (chartRing B S hS X hX V)
    (chartRestrictLinear M₃ φ '' (P : Set (M₃.val.obj (op U)))) with hQ
  -- the sections of a module cartesian on affine charts over `V` are spanned by restrictions
  have hspan : ∀ {N : Modules.{u, u} B S hS X hX}, IsCartesianOnAffineCharts N →
      ∀ z : N.val.obj (op V), z ∈ Submodule.span (chartRing B S hS X hX V)
        (Set.range fun y : N.val.obj (op U) => chartRestrictLinear N φ y) := fun hN z =>
    ((chartBaseChange_surjective_iff_span_eq_top _ φ).1 (hN U V hU hV φ).2).ge
      Submodule.mem_top
  -- the sections of `N₁` over `V` are combinations of restrictions of sections over `U`
  have hcoe : ∀ z : N₁.toSheafOfModules.val.obj (op V),
      z ∈ Submodule.span (chartRing B S hS X hX V)
        (Set.range fun y : N₁.toSheafOfModules.val.obj (op U) =>
          chartRestrictLinear N₁.toSheafOfModules φ y) →
      (N₁.ι.val.app (op V)).hom z ∈ Submodule.span (chartRing B S hS X hX V)
        (chartRestrictLinear M₁ φ '' (N₁.obj (op U) : Set (M₁.val.obj (op U)))) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨y, rfl⟩ := hz
        exact Submodule.subset_span ⟨(N₁.ι.val.app (op U)).hom y, y.2, rfl⟩
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add z w _ _ hz hw => rw [map_add]; exact Submodule.add_mem _ hz hw
    | smul c z _ hz => rw [map_smul]; exact Submodule.smul_mem _ c hz
  have hfV : f ∈ Submodule.span (chartRing B S hS X hX V)
      (chartRestrictLinear M₁ φ '' (N₁.obj (op U) : Set (M₁.val.obj (op U)))) :=
    hcoe ⟨f, hf⟩ (hspan hN₁ ⟨f, hf⟩)
  -- restrictions of sections of `N₁` multiply every section of `M₂` over `V` into `Q`
  have hrestr : ∀ y ∈ N₁.obj (op U), ∀ b : M₂.val.obj (op V),
      μ.app (op V) (chartRestrictLinear M₁ φ y) b ∈ Q := by
    intro y hy b
    induction hspan hM₂ b using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨z, rfl⟩ := hz
        refine Submodule.subset_span ⟨μ.app (op U) y z, hP y hy z, ?_⟩
        exact μ.naturality φ.op y z
    | zero => rw [map_zero]; exact Q.zero_mem
    | add z w _ _ hz hw => rw [map_add]; exact Q.add_mem hz hw
    | smul c z _ hz => rw [μ.map_smul_right]; exact Q.smul_mem c hz
  clear hf
  revert b
  induction hfV using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨y, hy, rfl⟩ := hg
      exact hrestr y hy
  | zero =>
      intro b
      rw [map_zero, AddMonoidHom.zero_apply]
      exact Q.zero_mem
  | add g g' _ _ hg hg' =>
      intro b
      rw [map_add, AddMonoidHom.add_apply]
      exact Q.add_mem (hg b) (hg' b)
  | smul c g _ hg =>
      intro b
      rw [μ.map_smul_left]
      exact Q.smul_mem c (hg b)

end Closure

section DegreeIdeal

variable (s : RelativeProjSituation.{u, u}) {d : ℤ} (ℱ : (s.algebra.piece d).Submodule)

/-- **Along a morphism of affine charts the products are generated by restrictions of products.**
The sections of `ℱ` and of `𝒜_m` over the smaller chart are generated by restrictions of
sections over the larger one, and the multiplication is bilinear and compatible with
restriction. -/
theorem generatorSpan_le_span_image (hℱ : ℱ.toSheafOfModules.IsQuasicoherentOnSite) (n : ℤ)
    {U V : SmallEtale s.site s.base s.containsBase s.space.1}
    (hU : IsAffine (chartScheme U)) (hV : IsAffine (chartScheme V)) (φ : V ⟶ U) :
    (generatorSpan ℱ n).obj (op V) ≤
      Submodule.span (chartRing s.site s.base s.containsBase s.space.1 s.space.2 V)
        (chartRestrictLinear (s.algebra.piece n) φ ''
          ((generatorSpan ℱ n).obj (op U) : Set ((s.algebra.piece n).val.obj (op U)))) := by
  refine Submodule.span_le.2 ?_
  rintro x ⟨m, rfl, f, hf, a, hx⟩
  obtain rfl := eq_of_heq hx
  exact bilinear_mem_span_image (s.algebra.mul d m) ℱ
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
      s.space.2 _ hℱ)
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
      s.space.2 _ (s.isQuasicoherent m)) hU hV φ _
    (fun y hy z => mem_generatorSpan ℱ rfl hy z HEq.rfl) hf a

/-- **The homogeneous pieces of the graded ideal generated by a quasi-coherent `ℱ ⊆ 𝒜_d` are
quasi-coherent.** -/
theorem isQuasicoherentOnSite_generatedInDegree
    (hℱ : ℱ.toSheafOfModules.IsQuasicoherentOnSite) (n : ℤ) :
    (generatedInDegree ℱ n).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_sheafifySubmodule
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite s.site s.base s.containsBase s.space.1
        s.space.2 _ (s.isQuasicoherent n))
      (generatorSpan ℱ n) fun hU hV φ => generatorSpan_le_span_image s ℱ hℱ n hU hV φ)

/-- **The quasi-coherent graded ideal `ℱ𝒜` generated by a quasi-coherent submodule `ℱ` of one
homogeneous piece**, as a graded ideal of Situation 0849; `Proj_X(𝒜/ℱ𝒜)` is its quotient
situation. -/
def RelativeProjSituation.GradedIdeal.ofDegree
    (hℱ : ℱ.toSheafOfModules.IsQuasicoherentOnSite) : s.GradedIdeal where
  toIdeal := Ideal.ofDegree ℱ s.mul_comm
  isQuasicoherent n := isQuasicoherentOnSite_generatedInDegree s ℱ hℱ n

/-- The homogeneous pieces of `ℱ𝒜`. -/
theorem RelativeProjSituation.GradedIdeal.ofDegree_piece
    (hℱ : ℱ.toSheafOfModules.IsQuasicoherentOnSite) (n : ℤ) :
    (RelativeProjSituation.GradedIdeal.ofDegree s ℱ hℱ).piece n = generatedInDegree ℱ n :=
  rfl

end DegreeIdeal

end AlgebraicGeometry.Space

end
