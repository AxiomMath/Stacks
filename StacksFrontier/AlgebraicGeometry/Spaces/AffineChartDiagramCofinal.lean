module

public import StacksFrontier.AlgebraicGeometry.Spaces.Category
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleChartCriterion
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.SheafSupport
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleAffineRefinement
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleRingedToposHom

/-!
# Affine chart diagrams are cofinal over every étale chart of the source

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` of a big fppf site.  A
commuting square of étale scheme charts over `f` (`AlgebraicGeometry.Space.ChartDiagram`) sends
a chart of `X` to a chart of `Y`, and the squares whose two charts are both *affine* are the ones
on which a module on `X` is compared with a module on `Y` over the ring of global functions.  An
affine étale chart of `X` need not map into a single affine étale chart of `Y`, so those squares
are not indexed by the affine charts of `X`; this file shows that their source charts are
nevertheless cofinal, that is, they cover every étale chart of `X`.

An atlas `V ⟶ Y` lifts along `f` to an étale surjective chart `W ⟶ U` of the given chart `U` of
`X` together with a morphism of schemes `W ⟶ V` over `f`
(`AlgebraicGeometry.Space.exists_surjective_etale_presentation_lift` applied to the representable
algebraic space of `U`).  Restricting that square to an affine open of `V` and to an affine open
of `W` inside its preimage gives a square of affine charts, and the affine opens of a scheme form
a basis, so these squares cover `W`, hence cover `U`.

## Main definitions

* `AlgebraicGeometry.Space.openSubMap` restricts a morphism of the big fppf site of `S` to open
  subschemes of its source and target.
* `AlgebraicGeometry.Space.ChartDiagram.restrictOpens` restricts a commuting square of étale
  scheme charts to an open subscheme of each of its two charts.

## Main results

* `AlgebraicGeometry.Space.exists_affine_chartDiagram_ofArrows`: every étale scheme chart of `X`
  carries a covering family of affine étale charts, each of which is the source chart of a
  commuting square over `f` whose chart of `Y` is affine.
* `AlgebraicGeometry.Space.generate_affineChartDiagram_mem_topology`: the same statement as the
  covering sieve generated by the presieve of those source charts, with an arbitrary condition on
  the chart of `Y` which holds on all affine charts.

## References

* [Stacks Project, Tag 03G2](https://stacks.math.columbia.edu/tag/03G2)
* [Stacks Project, Tag 03G3](https://stacks.math.columbia.edu/tag/03G3)
* [Stacks Project, Tag 03ED](https://stacks.math.columbia.edu/tag/03ED)
* [Stacks Project, Tag 03EC](https://stacks.math.columbia.edu/tag/03EC)
* [Stacks Project, Tag 025Z](https://stacks.math.columbia.edu/tag/025Z)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

/-! ### Restricting a morphism of the site to open subschemes -/

section OpenSubMap

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {A A' : BigFppfOver B S hS} (g : A ⟶ A')
    (O : ((BigFppfOver.toScheme B S hS).obj A).Opens)
    (O' : ((BigFppfOver.toScheme B S hS).obj A').Opens)
    (h : O ≤ (BigFppfOver.toScheme B S hS).map g ⁻¹ᵁ O')

/-- The morphism of `Sch_κ` underlying `AlgebraicGeometry.Space.openSubMap`: the restriction of
the morphism of schemes underlying `g` to the two opens. -/
noncomputable def openSubLeft : (openSub A O).left ⟶ (openSub A' O').left :=
  B.inclusion.preimage
    (show B.inclusion.obj ⟨(O : Scheme),
        lt_of_le_of_lt (Scheme.size_coe_opens_le _ O) A.left.property⟩ ⟶
      B.inclusion.obj ⟨(O' : Scheme),
        lt_of_le_of_lt (Scheme.size_coe_opens_le _ O') A'.left.property⟩ from
      ((BigFppfOver.toScheme B S hS).map g).resLE O' O h)

/-- `AlgebraicGeometry.Space.openSubLeft` is the restriction of the morphism of schemes
underlying `g`. -/
theorem inclusion_map_openSubLeft :
    B.inclusion.map (openSubLeft g O O' h) =
      ((BigFppfOver.toScheme B S hS).map g).resLE O' O h :=
  B.inclusion.map_preimage _

/-- `AlgebraicGeometry.Space.openSubLeft` is compatible with the two inclusions of open
subschemes. -/
theorem openSubLeft_comp_left :
    openSubLeft g O O' h ≫ (openSubHom A' O').left = (openSubHom A O).left ≫ g.left := by
  refine B.inclusion.map_injective ?_
  rw [Functor.map_comp, Functor.map_comp, inclusion_map_openSubLeft,
    show B.inclusion.map (openSubHom A' O').left = Scheme.Opens.ι O' from
      B.inclusion.map_preimage _,
    show B.inclusion.map (openSubHom A O).left = Scheme.Opens.ι O from
      B.inclusion.map_preimage _]
  exact Scheme.Hom.resLE_comp_ι _ h

/-- The restriction of a morphism of the big fppf site of `S` to an open subscheme of its source
and an open subscheme of its target containing the image. -/
noncomputable def openSubMap : openSub A O ⟶ openSub A' O' :=
  Over.homMk (openSubLeft g O O' h) (by
    have h1 : (openSubHom A' O').left ≫ A'.hom = (openSub A' O').hom := Over.w _
    have h2 : (openSubHom A O).left ≫ A.hom = (openSub A O).hom := Over.w _
    rw [← h1, ← h2, ← Category.assoc, openSubLeft_comp_left, Category.assoc, Over.w g])

/-- The morphism of schemes underlying `AlgebraicGeometry.Space.openSubMap` is the restriction of
the morphism of schemes underlying `g`. -/
theorem toScheme_map_openSubMap :
    (BigFppfOver.toScheme B S hS).map (openSubMap g O O' h) =
      ((BigFppfOver.toScheme B S hS).map g).resLE O' O h :=
  inclusion_map_openSubLeft g O O' h

/-- `AlgebraicGeometry.Space.openSubMap` is compatible with the two inclusions of open
subschemes. -/
theorem openSubMap_comp_openSubHom :
    openSubMap g O O' h ≫ openSubHom A' O' = openSubHom A O ≫ g :=
  Over.OverMorphism.ext (openSubLeft_comp_left g O O' h)

end OpenSubMap

/-! ### Restricting a chart diagram to open subschemes of its charts -/

section RestrictOpens

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X Y : AlgebraicSpaces B S hS} {f : X ⟶ Y} (d : ChartDiagram B S hS X.1 Y.1 f.hom)
    (O : ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS X.1).obj d.U)).Opens)
    (P : ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS Y.1).obj d.V)).Opens)
    (h : O ≤ (BigFppfOver.toScheme B S hS).map d.g ⁻¹ᵁ P)

/-- The commuting square of étale scheme charts obtained from a commuting square over `f` by
passing to an open subscheme of its chart of `X` and an open subscheme of its chart of `Y`
containing the image. -/
noncomputable def ChartDiagram.restrictOpens : ChartDiagram B S hS X.1 Y.1 f.hom where
  U := openChart B S hS X.1 d.U O
  V := openChart B S hS Y.1 d.V P
  g := openSubMap d.g O P h
  comm := by
    have key : openSubMap d.g O P h ≫ openSubHom _ P = openSubHom _ O ≫ d.g :=
      openSubMap_comp_openSubHom d.g O P h
    have hlhs : (yoneda.map (openSubHom _ O) ≫ d.U.1.hom) ≫ f.hom =
        yoneda.map (openSubHom _ O ≫ d.g) ≫ d.V.1.hom := by
      rw [Functor.map_comp]
      simp only [Category.assoc, d.comm]
    have hrhs : yoneda.map (openSubMap d.g O P h) ≫
          yoneda.map (openSubHom _ P) ≫ d.V.1.hom =
        yoneda.map (openSubHom _ O ≫ d.g) ≫ d.V.1.hom := by
      rw [← Category.assoc, ← Functor.map_comp, key]
    exact hlhs.trans hrhs.symm

/-- The chart of `X` of a restricted commuting square is the given open of the original one. -/
theorem ChartDiagram.restrictOpens_U : (d.restrictOpens O P h).U = openChart B S hS X.1 d.U O :=
  rfl

/-- The chart of `Y` of a restricted commuting square is the given open of the original one. -/
theorem ChartDiagram.restrictOpens_V : (d.restrictOpens O P h).V = openChart B S hS Y.1 d.V P :=
  rfl

end RestrictOpens

/-! ### Cofinality of the affine chart diagrams -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- **Stacks 03G2: the affine chart diagrams over `f` are cofinal.**  Every étale scheme chart
`U` of `X` carries a covering family of affine étale charts of `X`, each of which is the chart of
`X` of a commuting square of étale scheme charts over `f` whose chart of `Y` is affine. -/
@[stacks 03G2 "affine chart diagrams are cofinal: covering family"]
theorem exists_affine_chartDiagram_ofArrows (f : X ⟶ Y) (U : SmallEtale B S hS X.1) :
    ∃ (I : Type u) (W : I → SmallEtale B S hS X.1) (a : ∀ i, W i ⟶ U)
      (d : I → ChartDiagram B S hS X.1 Y.1 f.hom),
      (∀ i, (d i).U = W i) ∧
      (∀ i, IsAffine ((SmallEtale.toOver B S hS X.1 ⋙
        BigFppfOver.toScheme B S hS).obj (W i))) ∧
      (∀ i, IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙
        BigFppfOver.toScheme B S hS).obj (d i).V)) ∧
      Sieve.ofArrows W a ∈ SmallEtale.topology B S hS X.1 U := by
  classical
  obtain ⟨V, b, hbS, hbE⟩ := Y.2.exists_atlas
  obtain ⟨W₀, p, α, hcomm, hpS, hpE⟩ :=
    exists_surjective_etale_presentation_lift B S hS
      (isAlgebraicSpace_yoneda B S hS ((SmallEtale.toOver B S hS X.1).obj U)) Y.2
      (U.1.hom ≫ f.hom) V b hbS hbE
  -- the morphism of the site underlying the lifted chart
  have hp₀ : yoneda.map (Yoneda.fullyFaithful.preimage p) = p :=
    Yoneda.fullyFaithful.map_preimage p
  have hpMap : ∀ Q : MorphismProperty Scheme.{u},
      (MorphismProperty.inverseImage Q (BigFppfOver.toScheme B S hS)).presheaf p →
        Q ((BigFppfOver.toScheme B S hS).map (Yoneda.fullyFaithful.preimage p)) :=
    fun Q hp => MorphismProperty.of_relative_map
      (P := MorphismProperty.inverseImage Q (BigFppfOver.toScheme B S hS)) (F := yoneda)
      (by rw [hp₀]; exact hp)
  -- the lifted chart of `X` over `U`, and the global commuting square it sits in
  set dglob : ChartDiagram B S hS X.1 Y.1 f.hom :=
    { U := ⟨CostructuredArrow.mk
          (yoneda.map (Yoneda.fullyFaithful.preimage p) ≫ U.1.hom),
        etale_comp_of_scheme B S hS _ U.1.hom (hpMap _ hpE) U.property⟩
      V := ⟨CostructuredArrow.mk b, hbE⟩
      g := α
      comm := by
        have hsq : (yoneda.map (Yoneda.fullyFaithful.preimage p) ≫ U.1.hom) ≫ f.hom =
            yoneda.map α ≫ b := by rw [Category.assoc, hp₀]; exact hcomm
        exact hsq }
  set WtoU : dglob.U ⟶ U :=
    ObjectProperty.homMk
      (CostructuredArrow.homMk (Yoneda.fullyFaithful.preimage p) rfl)
  refine ⟨Σ P : ((BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS Y.1).obj dglob.V)).affineOpens,
      { O : ((BigFppfOver.toScheme B S hS).obj
          ((SmallEtale.toOver B S hS X.1).obj dglob.U)).affineOpens //
        (O : _) ≤ (BigFppfOver.toScheme B S hS).map dglob.g ⁻¹ᵁ (P : _) },
    fun i => openChart B S hS X.1 dglob.U (i.2.1 : _),
    fun i => openChartInclusion B S hS X.1 dglob.U (i.2.1 : _) ≫ WtoU,
    fun i => dglob.restrictOpens (i.2.1 : _) (i.1 : _) i.2.2,
    fun _ => rfl, fun i => inferInstanceAs (IsAffine ((i.2.1 : _) : Scheme)),
    fun i => inferInstanceAs (IsAffine ((i.1 : _) : Scheme)), ?_⟩
  refine SmallEtale.ofArrows_mem_topology B S hS X.1 _ _ ?_
  rw [Scheme.ofArrows_mem_etalePrecoverage_iff]
  refine ⟨fun x => ?_, fun i => etale_toScheme_toOver_map B S hS X.1 _⟩
  obtain ⟨w, hw⟩ := (hpMap _ hpS).surj x
  obtain ⟨P, hP, hvP, -⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens ((BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS Y.1).obj dglob.V)))
      (show (BigFppfOver.toScheme B S hS).map dglob.g w ∈ (⊤ : _) from trivial)
  obtain ⟨O, hO, hwO, hsub⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens ((BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS X.1).obj dglob.U)))
      (show w ∈ (BigFppfOver.toScheme B S hS).map dglob.g ⁻¹ᵁ P from hvP)
  refine ⟨⟨⟨P, hP⟩, ⟨⟨O, hO⟩, hsub⟩⟩, ?_⟩
  obtain ⟨y, hy⟩ := (Scheme.Opens.range_ι (X := (BigFppfOver.toScheme B S hS).obj
    ((SmallEtale.toOver B S hS X.1).obj dglob.U)) O).ge hwO
  refine ⟨y, ?_⟩
  have hmap : (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map
        (openChartInclusion B S hS X.1 dglob.U O ≫ WtoU)) =
      Scheme.Opens.ι O ≫
        (BigFppfOver.toScheme B S hS).map (Yoneda.fullyFaithful.preimage p) := by
    rw [Functor.map_comp, Functor.map_comp,
      toScheme_map_toOver_map_openChartInclusion B S hS X.1 dglob.U O]
    rfl
  rw [hmap]
  show ((BigFppfOver.toScheme B S hS).map (Yoneda.fullyFaithful.preimage p))
    ((Scheme.Opens.ι O) y) = x
  rwa [hy]

/-- **Stacks 03G2: the affine chart diagrams over `f` are cofinal, in sieve form.**  The affine
étale charts of `X` which are the chart of `X` of a commuting square of étale scheme charts over
`f` whose chart of `Y` is affine and satisfies a condition `Q` holding on all affine charts
generate a covering sieve of every étale chart of `X`. -/
@[stacks 03G2 "affine chart diagrams are cofinal: covering sieve"]
theorem generate_affineChartDiagram_mem_topology (f : X ⟶ Y)
    (Q : SmallEtale B S hS Y.1 → Prop)
    (hQ : ∀ V : SmallEtale B S hS Y.1,
      IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj V) → Q V)
    (U : SmallEtale B S hS X.1) :
    Sieve.generate (fun (Z : SmallEtale B S hS X.1) (_ : Z ⟶ U) =>
      IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Z) ∧
      ∃ d : ChartDiagram B S hS X.1 Y.1 f.hom, ∃ _ : d.U = Z,
        IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj d.V) ∧
          Q d.V) ∈ SmallEtale.topology B S hS X.1 U := by
  obtain ⟨I, W, a, d, hdU, haff, haffV, hcov⟩ :=
    exists_affine_chartDiagram_ofArrows B S hS f U
  refine GrothendieckTopology.superset_covering _ ?_ hcov
  rintro Z g ⟨T, k, l, ⟨i⟩, rfl⟩
  exact ⟨_, k, a i, ⟨haff i, d i, hdU i, haffV i, hQ _ (haffV i)⟩, rfl⟩

end AlgebraicGeometry.Space

end
