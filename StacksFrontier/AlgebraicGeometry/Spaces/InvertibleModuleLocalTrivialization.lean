module

public import StacksFrontier.AlgebraicGeometry.Spaces.InvertibleDenseAffineTrivialization
public import StacksFrontier.AlgebraicGeometry.Spaces.FreeGeneratorSieveDescent
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartwiseRankCartesian
public import StacksFrontier.AlgebraicGeometry.Quot.PicardFunctor
public import StacksFrontier.AlgebraicGeometry.Spaces.MeromorphicSectionValueDescent

/-!
# An invertible module is free on a Zariski neighbourhood of every point of an affine chart

Let `X` be an algebraic space over a scheme `S`, `ℒ` an invertible `𝒪_X`-module, `C` an étale
chart of `X` whose scheme is affine, and `x` a point of that scheme. Then there is a function
`g` on `C` with `x ∈ D(g)` and a section of `ℒ` over the Zariski-open chart `D(g)` which freely
generates `ℒ` over every étale chart above `D(g)`, compatibly with restriction.

The sections `M = ℒ(C)` form a finite locally free module of rank one over `A = 𝒪(C)`
(`AlgebraicGeometry.Space.isFiniteLocallyFreeOfRank_one_sections`), so at the prime of `x` some
`m ∈ M` generates `M` freely away from some `g` not in that prime
(`Module.IsFiniteLocallyFreeOfRank.exists_isFreeGeneratorAway`); the sections over `D(g)` are
`M_g`, freely generated by `m`; over an affine chart above `D(g)` the restriction of `m` is a
free generator because `ℒ` is cartesian on affine charts
(`AlgebraicGeometry.Space.bijective_smul_map_of_bijective_smul`), and over an arbitrary chart
because free generation descends along the covering sieve of its affine charts
(`AlgebraicGeometry.Space.bijective_smul_of_sieve`).

This is the scheme-theoretic fact that an invertible module on a scheme is Zariski-locally
trivial, read on one affine chart of `X`. In particular it makes the chart `D(g)` an
*elementary* étale neighbourhood whenever `C` was one at `x`: the residue field at `x` does not
change under passing to an open subscheme.
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **A free generator over an affine chart of a module cartesian on affine charts restricts to a
free generator over every chart above it**, affine or not.

Over an affine chart above the given one this is
`AlgebraicGeometry.Space.bijective_smul_map_of_bijective_smul`. Over an arbitrary chart `W`, the
affine charts over `W` generate a covering sieve
(`AlgebraicGeometry.Space.affineChartSieve_mem_topology`). Injectivity: two coefficients giving the
same section agree over every affine chart over `W`, hence over every member of that sieve, hence
over `W` because `𝒪` is separated. Surjectivity: a
section `m` over `W` is, over each member of the sieve, the multiple of the restricted
generator by the restriction of a coefficient read on an affine chart through which the member
factors; these local coefficients are unique by injectivity over the members, so they are
compatible and glue, and the glued coefficient multiplies the generator to `m` because `ℳ` is
separated. -/
theorem bijective_smul_chartRestrictLinear_of_isAffine (X : AlgebraicSpaces B S hS)
    (M : Modules.{u, u} B S hS X.1 X.2) (hM : IsCartesianOnAffineCharts M)
    {D : SmallEtale B S hS X.1} (hD : IsAffine (chartScheme D)) {s : M.val.obj (op D)}
    (hs : Function.Bijective fun b : chartRing B S hS X.1 X.2 D => b • s)
    (W : SmallEtale B S hS X.1) (k : W ⟶ D) :
    Function.Bijective fun r : chartRing B S hS X.1 X.2 W ↦ r • chartRestrictLinear M k s := by
  classical
  have haff : ∀ (V : SmallEtale B S hS X.1) (hV : IsAffine (chartScheme V)) (k' : V ⟶ D),
      Function.Bijective fun b : chartRing B S hS X.1 X.2 V => b • chartRestrictLinear M k' s :=
    fun V hV k' => bijective_smul_map_of_bijective_smul M hM hD hV k' hs
  have hinj : ∀ (W : SmallEtale B S hS X.1) (k : W ⟶ D),
      Function.Injective fun r : chartRing B S hS X.1 X.2 W ↦ r • chartRestrictLinear M k s := by
    intro W k r r' hrr
    have key : ∀ ⦃W' : SmallEtale B S hS X.1⦄ (a : W' ⟶ W),
        (Sieve.generate (fun (V : SmallEtale B S hS X.1) (_ : V ⟶ W) =>
          IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))).arrows a →
        chartRestrict (hF := X.2) a r = chartRestrict (hF := X.2) a r' := by
      rintro W' a ⟨V, t, k'', hV, rfl⟩
      have hV' : chartRestrict (hF := X.2) k'' r = chartRestrict (hF := X.2) k'' r' := by
        apply (haff V hV (k'' ≫ k)).1
        show chartRestrict (hF := X.2) k'' r • chartRestrictLinear M (k'' ≫ k) s =
          chartRestrict (hF := X.2) k'' r' • chartRestrictLinear M (k'' ≫ k) s
        rw [chartRestrictLinear_comp M k k'' s, ← chartRestrictLinear_smul M k'' r,
          ← chartRestrictLinear_smul M k'' r']
        exact congrArg (chartRestrictLinear M k'') hrr
      rw [chartRestrict_comp, RingHom.comp_apply, RingHom.comp_apply, hV']
    exact (isSheaf_globalSections B S hS X.1 _
      (affineChartSieve_mem_topology B S hS X.1 W)).isSeparatedFor.ext fun _ a ha ↦ key a ha
  refine ⟨hinj W k, fun m ↦ ?_⟩
  let T : Sieve W := Sieve.generate (fun (V : SmallEtale B S hS X.1) (_ : V ⟶ W) =>
    IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
  have hT : T ∈ SmallEtale.topology B S hS X.1 W := affineChartSieve_mem_topology B S hS X.1 W
  have hex : ∀ ⦃W' : SmallEtale B S hS X.1⦄ (a : W' ⟶ W), T.arrows a →
      ∃ c : chartRing B S hS X.1 X.2 W',
        c • chartRestrictLinear M (a ≫ k) s = chartRestrictLinear M a m := by
    rintro W' a ⟨V, t, k'', hV, rfl⟩
    obtain ⟨c, hc⟩ := (haff V hV (k'' ≫ k)).2 (chartRestrictLinear M k'' m)
    refine ⟨chartRestrict (hF := X.2) t c, ?_⟩
    rw [Category.assoc, chartRestrictLinear_comp M (k'' ≫ k) t s, ← chartRestrictLinear_smul M t c,
      chartRestrictLinear_comp M k'' t m]
    exact congrArg (chartRestrictLinear M t) hc
  choose c hcspec using hex
  have hc : ∀ ⦃W₁ W₂ : SmallEtale B S hS X.1⦄ (a : W₁ ⟶ W) (g : W₂ ⟶ W₁) (ha : T.arrows a),
      c (g ≫ a) (T.downward_closed ha g) = chartRestrict (hF := X.2) g (c a ha) := by
    intro W₁ W₂ a g ha
    apply hinj W₂ (g ≫ a ≫ k)
    show c (g ≫ a) (T.downward_closed ha g) • chartRestrictLinear M (g ≫ a ≫ k) s =
      chartRestrict (hF := X.2) g (c a ha) • chartRestrictLinear M (g ≫ a ≫ k) s
    rw [← Category.assoc, hcspec (g ≫ a) (T.downward_closed ha g), Category.assoc,
      chartRestrictLinear_comp M (a ≫ k) g s, ← chartRestrictLinear_smul M g (c a ha),
      hcspec a ha, chartRestrictLinear_comp M a g m]
  obtain ⟨r, hr⟩ := exists_chartRestrict_eq_of_sieve B S hS X W T hT c hc
  refine ⟨r, eq_of_modules_map_eq_of_sieve B S hS X M W T hT _ m fun {W'} a ha ↦ ?_⟩
  show chartRestrictLinear M a (r • chartRestrictLinear M k s) = chartRestrictLinear M a m
  rw [chartRestrictLinear_smul M a r, hr a ha, ← chartRestrictLinear_comp M k a s, hcspec a ha]

/-- **An invertible module is free on a basic open neighbourhood of every point of an affine
chart.** -/
theorem exists_basicOpen_freeGenerator (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (hL : IsInvertibleModule (B := B) X L)
    (C : SmallEtale B S hS X.1) (hC : IsAffine (chartScheme C)) (x : chartScheme C) :
    ∃ g : Γ(chartScheme C, ⊤), x ∈ (chartScheme C).basicOpen g ∧
      ∃ e : (W : SmallEtale B S hS X.1) →
          (W ⟶ openChart B S hS X.1 C ((chartScheme C).basicOpen g)) → L.val.obj (op W),
        (∀ (W W' : SmallEtale B S hS X.1)
            (k : W ⟶ openChart B S hS X.1 C ((chartScheme C).basicOpen g)) (h : W' ⟶ W),
          (L.val.map h.op).hom (e W k) = e W' (h ≫ k)) ∧
        ∀ (W : SmallEtale B S hS X.1)
          (k : W ⟶ openChart B S hS X.1 C ((chartScheme C).basicOpen g)),
          Function.Bijective fun r : chartRing B S hS X.1 X.2 W ↦ r • e W k := by
  have hL' := Stacks.SheafOfModules.IsInvertible.toAlgebraicGeometry _ _ _ hL
  have hLc := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 L
    (isQuasicoherentOnSite_of_isInvertible B S hS X L hL')
  have hflf := isFiniteLocallyFreeOfRank_one_sections X.2 L hLc
    (isFiniteLocallyFreeOfRank_one_of_isInvertible B S hS X L hL') C hC
  let p : Ideal (chartRing B S hS X.1 X.2 C) :=
    Ideal.comap ((chartScheme C).presheaf.germ ⊤ x trivial).hom
      (IsLocalRing.maximalIdeal ((chartScheme C).presheaf.stalk x))
  have : p.IsPrime := Ideal.comap_isPrime _ _
  obtain ⟨g, hg, m, hm⟩ := hflf.exists_isFreeGeneratorAway p
  have hxg : x ∈ (chartScheme C).basicOpen (g : Γ(chartScheme C, ⊤)) :=
    (Scheme.mem_basicOpen (chartScheme C) (g : Γ(chartScheme C, ⊤)) x trivial).mpr (by
      by_contra h
      exact hg ((IsLocalRing.mem_maximalIdeal _).mpr h))
  refine ⟨g, hxg, ?_⟩
  let D := openChart B S hS X.1 C ((chartScheme C).basicOpen g)
  let ι := openChartInclusion B S hS X.1 C ((chartScheme C).basicOpen g)
  have hDaff : IsAffine (chartScheme D) :=
    isAffine_chartScheme_openChart_basicOpen B S hS X.1 C hC g
  let s : L.val.obj (op D) := L.val.map ι.op m
  have hs : Function.Bijective fun b : chartRing B S hS X.1 X.2 D => b • s := by
    let _ := chartAlgebra (hF := X.2) ι
    let _ := chartSectionsModule L ι
    have := chartSections_isScalarTower L ι
    have := isLocalization_away_chartRing_openChart_basicOpen B S hS X.2 C hC g
    have := isLocalizedModule_chartRestrictLinear_openChart_basicOpen B S hS X.2 L hLc C hC g
    exact Module.isFreeGeneratorAway_bijective_smul (chartRestrictLinear L ι) hm
  exact ⟨fun W k => (L.val.map k.op).hom s,
    fun W W' k h => (PresheafOfModules.map_comp_apply L.val k.op h.op s).symm,
    fun W k => bijective_smul_chartRestrictLinear_of_isAffine B S hS X L hLc hDaff hs W k⟩

end AlgebraicGeometry.Space

end
