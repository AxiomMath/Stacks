section Restriction

variable (A : SheafOfModules.GradedAlgebra.{u, u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedTopos B S hS X).O))
    {P : AlgebraicSpaces B S hS} (f : P ⟶ X) (hf : IsEtale B S hS f.hom)
    (hrep : yoneda.relativelyRepresentable f.hom)

/-- **Étale restriction undoes the chart reading of the unit.** For an étale representable
`f : P ⟶ X`, a module `M` on `X` and a chart `W` of `P`, a section `x` of `M` over the composite
chart `f W` goes, by the unit of Stacks 03LU, to a section of `f_*(f^*M)` over `f W`; its chart
projection to `f W ×_X P`, restricted along the unit `W ⟶ f W ×_X P` of postcomposition against
base change, and read in the étale restriction of `M` (Stacks 03LW), is `x` again. -/
theorem modulePullbackIso_hom_unit_chartSetProj
    (M : SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedTopos B S hS X).O))
    (W : SmallEtale B S hS P.1)
    (x : M.val.obj (op ((smallEtalePostcomp B S hS f hf).obj W))) :
    ((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app M).val.app (op W)
      (((modulePullback B S hS f).obj M).val.map
        ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W).op
        (chartSetProj B S hS f hrep (moduleSetSheaf B S hS P ((modulePullback B S hS f).obj M))
          ((smallEtalePostcomp B S hS f hf).obj W)
          (((modulePullbackAdjunction B S hS f).unit.app M).val.app
            (op ((smallEtalePostcomp B S hS f hf).obj W)) x))) = x := by
  refine (PresheafOfModules.naturality_apply
    ((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app M).val
    ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W).op _).trans ?_
  have h2 := (chartSetProj_etaleModulePullbackAdjunction_unit_eq B S hS f hf hrep
      M ((smallEtalePostcomp B S hS f hf).obj W) x).symm.trans
    (chartSetProj_etaleModulePullbackAdjunction_unit B S hS f hf hrep M
      ((smallEtalePostcomp B S hS f hf).obj W) x)
  refine (congrArg (((etaleModulePullback B S hS f hf).obj M).val.map
    ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W).op) h2).trans ?_
  have h3 : ∀ y : M.val.obj (op ((smallEtalePostcomp B S hS f hf).obj
      ((smallBaseChange B S hS f hrep).obj ((smallEtalePostcomp B S hS f hf).obj W)))),
      ((etaleModulePullback B S hS f hf).obj M).val.map
        ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W).op y =
      M.val.map ((smallEtalePostcomp B S hS f hf).map
        ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W)).op y :=
    fun _ => rfl
  refine (h3 _).trans ?_
  refine (M.val.map_comp_apply
    ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).counit.app
      ((smallEtalePostcomp B S hS f hf).obj W)).op
    ((smallEtalePostcomp B S hS f hf).map
      ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W)).op x).symm.trans ?_
  refine (M.val.congr_map_apply (congrArg Quiver.Hom.op
    ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).left_triangle_components W))
      x).trans ?_
  exact congrArg (fun g => g x) (M.val.map_id _)

variable (W : SmallEtale B S hS P.1)

/-- **A section over `W` read off a section of a direct image over the composite chart `f W`.**
The chart projection of `AlgebraicGeometry.Space.chartSetProj` takes a section of `f_* Q` over
`f W` to a section of `Q` over the base-changed chart `f W ×_X P`, which is restricted along the
unit `W ⟶ f W ×_X P` of `AlgebraicGeometry.Space.smallEtalePostcompBaseChangeAdjunction`. -/
def postcompChartSection (Q : Sheaf (SmallEtale.topology B S hS P.1) (Type u))
    (z : ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj Q).obj.obj
      (op ((smallEtalePostcomp B S hS f hf).obj W))) : Q.obj.obj (op W) :=
  Q.obj.map ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W).op
    (chartSetProj B S hS f hrep Q ((smallEtalePostcomp B S hS f hf).obj W) z)

/-- The reading of sections of a direct image at `W` is natural in the sheaf of sets. -/
theorem postcompChartSection_naturality {Q Q' : Sheaf (SmallEtale.topology B S hS P.1) (Type u)}
    (g : Q ⟶ Q')
    (z : ((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.obj Q).obj.obj
      (op ((smallEtalePostcomp B S hS f hf).obj W))) :
    postcompChartSection f hf hrep W Q'
        (((smallEtaleRingedToposHom B S hS f).toToposHom.pushforward.map g).hom.app _ z) =
      g.hom.app (op W) (postcompChartSection f hf hrep W Q z) :=
  (congrArg (Q'.obj.map ((smallEtalePostcompBaseChangeAdjunction B S hS f hf
      hrep).unit.app W).op) (chartSetProj_naturality B S hS f hrep g
        ((smallEtalePostcomp B S hS f hf).obj W) z)).trans
    (NatTrans.naturality_apply g.hom _ _).symm

/-- **The comparison of sections of `𝒜` over `f W` with sections of `f^*𝒜` over `W`**, in one
degree: the unit of the graded adjunction of Stacks 0FQX followed by
`AlgebraicGeometry.Space.postcompChartSection`. -/
def gradedPullPostcompSection (k : ℤ)
    (x : (A.piece k).val.obj (op ((smallEtalePostcomp B S hS f hf).obj W))) :
    (((gradedPull (X := smallEtaleRingedTopos B S hS P)
        (Y := smallEtaleRingedTopos B S hS X) (smallEtaleRingedToposHom B S hS f)).obj A).piece
          k).val.obj (op W) :=
  postcompChartSection f hf hrep W (Stacks.Sheaves.GradedAlgebraEssentiallySmall.underlyingPiece
      (X := smallEtaleRingedTopos B S hS P) ((gradedPull (X := smallEtaleRingedTopos B S hS P)
        (Y := smallEtaleRingedTopos B S hS X) (smallEtaleRingedToposHom B S hS f)).obj A) k)
    ((((gradedAdj (X := smallEtaleRingedTopos B S hS P) (Y := smallEtaleRingedTopos B S hS X)
      (smallEtaleRingedToposHom B S hS f)).unit.app A).app k).val.app _ x)

/-- The comparison is multiplicative: the unit is a homomorphism of graded algebras and the reading
of sections at `W` is natural in the sheaf of sets. -/
theorem gradedPullPostcompSection_mul (i j : ℤ)
    (x : (A.piece i).val.obj (op ((smallEtalePostcomp B S hS f hf).obj W)))
    (y : (A.piece j).val.obj (op ((smallEtalePostcomp B S hS f hf).obj W))) :
    gradedPullPostcompSection A f hf hrep W (i + j) ((A.mul i j).app _ x y) =
      (((gradedPull (X := smallEtaleRingedTopos B S hS P)
        (Y := smallEtaleRingedTopos B S hS X) (smallEtaleRingedToposHom B S hS f)).obj A).mul
          i j).app (op W) (gradedPullPostcompSection A f hf hrep W i x)
        (gradedPullPostcompSection A f hf hrep W j y) := by
  have h := Stacks.Sheaves.GradedAlgebraEssentiallySmall.natural_family_gradedAdj_unit_mul
    (X := smallEtaleRingedTopos B S hS P) (Y := smallEtaleRingedTopos B S hS X)
    (smallEtaleRingedToposHom B S hS f) (op ((smallEtalePostcomp B S hS f hf).obj W)) (op W)
    (postcompChartSection f hf hrep W) (postcompChartSection_naturality f hf hrep W) A i j x y
  unfold gradedPullPostcompSection
  convert h using 4

/-- The identification of Stacks 03LW is a left inverse of the comparison. -/
theorem modulePullbackIso_hom_gradedPullPostcompSection (k : ℤ)
    (x : (A.piece k).val.obj (op ((smallEtalePostcomp B S hS f hf).obj W))) :
    ((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app (A.piece k)).val.app (op W)
      (gradedPullPostcompSection A f hf hrep W k x) = x := by
  have e : gradedPullPostcompSection A f hf hrep W k x =
      ((modulePullback B S hS f).obj (A.piece k)).val.map
        ((smallEtalePostcompBaseChangeAdjunction B S hS f hf hrep).unit.app W).op
        (chartSetProj B S hS f hrep
          (moduleSetSheaf B S hS P ((modulePullback B S hS f).obj (A.piece k)))
          ((smallEtalePostcomp B S hS f hf).obj W)
          (((modulePullbackAdjunction B S hS f).unit.app (A.piece k)).val.app
            (op ((smallEtalePostcomp B S hS f hf).obj W)) x)) := rfl
  exact (congrArg (((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app
    (A.piece k)).val.app (op W)) e).trans
    (modulePullbackIso_hom_unit_chartSetProj f hf hrep (A.piece k) W x)

/-- The comparison is a left inverse of the identification of Stacks 03LW, which is injective on
sections, being an isomorphism. -/
theorem gradedPullPostcompSection_modulePullbackIso_hom (k : ℤ)
    (y : (((gradedPull (X := smallEtaleRingedTopos B S hS P)
        (Y := smallEtaleRingedTopos B S hS X) (smallEtaleRingedToposHom B S hS f)).obj A).piece
          k).val.obj (op W)) :
    gradedPullPostcompSection A f hf hrep W k
      (((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app (A.piece k)).val.app (op W) y) =
      y := by
  let e := (modulePullbackIsoEtaleModulePullback B S hS f hf).app (A.piece k)
  have hinj : Function.Injective (e.hom.val.app (op W)) := fun a b hab => by
    have ha := congrArg (fun g => g.val.app (op W) a) e.hom_inv_id
    have hb := congrArg (fun g => g.val.app (op W) b) e.hom_inv_id
    exact ha.symm.trans ((congrArg (e.inv.val.app (op W)) hab).trans hb)
  exact hinj (modulePullbackIso_hom_gradedPullPostcompSection A f hf hrep W k _)

