/-- **A natural family read after the unit of the graded adjunction is multiplicative.** -/
theorem natural_family_gradedAdj_unit_mul (f : AlgebraicGeometry.RingedToposHom X Y) (U : Y.Cᵒᵖ)
    (Q : X.Cᵒᵖ)
    (θ : ∀ F : Sheaf X.J (Type t), (f.toToposHom.pushforward.obj F).obj.obj U → F.obj.obj Q)
    (hθ : ∀ {F F' : Sheaf X.J (Type t)} (g : F ⟶ F')
      (x : (f.toToposHom.pushforward.obj F).obj.obj U),
      θ F' ((f.toToposHom.pushforward.map g).hom.app U x) = g.hom.app Q (θ F x))
    (A : SheafOfModules.GradedAlgebra (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) (i j : ℤ)
    (x : (A.piece i).val.obj U) (y : (A.piece j).val.obj U) :
    @Eq ((((gradedPull f).obj A).piece (i + j)).val.obj Q)
      (θ (underlyingPiece ((gradedPull f).obj A) (i + j))
        ((((gradedAdj f).unit.app A).app (i + j)).val.app U ((A.mul i j).app U x y)))
      ((((gradedPull f).obj A).mul i j).app Q
        (θ (underlyingPiece ((gradedPull f).obj A) i)
          ((((gradedAdj f).unit.app A).app i).val.app U x))
        (θ (underlyingPiece ((gradedPull f).obj A) j)
          ((((gradedAdj f).unit.app A).app j).val.app U y))) :=
  (congrArg (θ (underlyingPiece ((gradedPull f).obj A) (i + j)))
      (((gradedAdj f).unit.app A).map_mul i j U x y)).trans
    (natural_family_mul f U Q θ hθ ((gradedPull f).obj A) i j _ _)

end Stacks.Sheaves.GradedAlgebraEssentiallySmall

