theorem modulePullbackIso_hom_gradedPull_mul (i j : ℤ)
    (x : (((gradedPull (X := smallEtaleRingedTopos B S hS P)
        (Y := smallEtaleRingedTopos B S hS X) (smallEtaleRingedToposHom B S hS f)).obj A).piece
