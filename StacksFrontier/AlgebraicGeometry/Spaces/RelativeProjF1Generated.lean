/-- **Generation in degree one passes to the pullback along an étale representable morphism.** If
`𝒜` is generated in degree one over the composite chart `f W`, its pullback `f^*𝒜` (Stacks 0FQX)
is generated in degree one over `W`: the sections over `W` are a copy of those over `f W`,
degreewise and multiplicatively. -/
theorem isGeneratedInDegreeOne_gradedPull
    (hA : SheafOfModules.GradedAlgebra.IsGeneratedInDegreeOne A
      (op ((smallEtalePostcomp B S hS f hf).obj W))) :
    SheafOfModules.GradedAlgebra.IsGeneratedInDegreeOne
      ((gradedPull (X := smallEtaleRingedTopos B S hS P)
        (Y := smallEtaleRingedTopos B S hS X) (smallEtaleRingedToposHom B S hS f)).obj A)
      (op W) :=
  SheafOfModules.GradedAlgebra.isGeneratedInDegreeOne_of_bijective (A := A)
    (W := op ((smallEtalePostcomp B S hS f hf).obj W))
    (fun k y => ((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app (A.piece k)).val.app
      (op W) y)
    (fun k a b => map_add (((modulePullbackIsoEtaleModulePullback B S hS f hf).hom.app
      (A.piece k)).val.app (op W)).hom a b)
    (fun k => ⟨Function.LeftInverse.injective
        (gradedPullPostcompSection_modulePullbackIso_hom A f hf hrep W k),
      fun x => ⟨_, modulePullbackIso_hom_gradedPullPostcompSection A f hf hrep W k x⟩⟩)
    (fun n x y => modulePullbackIso_hom_gradedPull_mul A f hf hrep W 1 n x y) hA

end Restriction

namespace RelativeProjSituation

variable (s : RelativeProjSituation.{u, m})

/-- **`𝒜` is generated as an `𝒜₀`-algebra by `𝒜₁`.** Over every affine object `V` of the
small étale site of `X`, every section of `𝒜_{1+n}` over `V` is a sum of products of a section of
`𝒜₁` and a section of `𝒜ₙ` over `V`: precisely, every additive subgroup of `𝒜_{1+n}(V)`
containing these products is everything
(`SheafOfModules.GradedAlgebra.IsGeneratedInDegreeOne`). Equivalently, the ring `⨁ₙ 𝒜ₙ(V)` is
generated by `𝒜₁(V)` as an `𝒜₀(V)`-algebra; for a quasi-coherent graded algebra this is
surjectivity of `Sym_{𝒜₀}(𝒜₁) ⟶ 𝒜`, read on the affine étale charts. -/
def IsGeneratedInDegreeOne : Prop :=
  ∀ V : SmallEtale s.site s.base s.containsBase s.space.1,
    V ∈ SmallEtale.affineObjects s.site s.base s.containsBase s.space.1 →
      SheafOfModules.GradedAlgebra.IsGeneratedInDegreeOne s.algebra (op V)

variable {s}

/-- Generation in degree one passes to the re-presentation of `𝒜` with sections in the universe
of the site, along the multiplicative identification `smallAlgebraEquiv`. -/
theorem IsGeneratedInDegreeOne.smallAlgebra (h : s.IsGeneratedInDegreeOne)
    (V : SmallEtale s.site s.base s.containsBase s.space.1)
    (hV : V ∈ SmallEtale.affineObjects s.site s.base s.containsBase s.space.1) :
    SheafOfModules.GradedAlgebra.IsGeneratedInDegreeOne s.smallAlgebra (op V) :=
  SheafOfModules.GradedAlgebra.isGeneratedInDegreeOne_of_bijective
    (fun k x => s.smallAlgebraEquiv.equiv k (op V) x)
    (fun k a b => map_add (s.smallAlgebraEquiv.equiv k (op V)) a b)
    (fun k => (s.smallAlgebraEquiv.equiv k (op V)).bijective)
    (fun n x y => s.smallAlgebraEquiv_mul_app 1 n (op V) x y) (h V hV)

/-- **The hypothesis on `𝒜` gives the hypothesis on its restrictions to the étale charts.** For
an étale chart `u : U ⟶ X` and an affine open `O` of `U`, the sections of `u^*𝒜` over `O` are
those of the pullback of `𝒜` to the represented space `U` over the chart `O`, which are a copy,
multiplicatively, of the sections of `𝒜` over the affine étale chart `O ⟶ U ⟶ X`
(`AlgebraicGeometry.Space.isGeneratedInDegreeOne_gradedPull`). -/
theorem IsGeneratedInDegreeOne.isGeneratedInDegreeOneOnCharts (h : s.IsGeneratedInDegreeOne) :
    s.IsGeneratedInDegreeOneOnCharts := by
  intro V U hU
  have hf : IsEtale s.site s.base s.containsBase (pointHom V.obj.hom).hom :=
    isEtale_of_presheaf_etale s.site s.base s.containsBase V.2
  have hrep : yoneda.relativelyRepresentable (pointHom V.obj.hom).hom := V.2.rep
  let W := (selfOpensFunctor s.site s.base s.containsBase V.obj.left).obj U
  have hW : IsAffine (chartScheme W) :=
    (congrArg (fun Q => IsAffine (chartScheme Q))
      (selfOpensFunctor_obj s.site s.base s.containsBase V.obj.left U)).mpr hU
  have hgen := isGeneratedInDegreeOne_gradedPull s.smallAlgebra (pointHom V.obj.hom) hf hrep W
    (h.smallAlgebra _ hW)
  have hZ := have := isContinuous_selfOpensFunctor s.site s.base s.containsBase V.obj.left
    SheafOfModules.GradedAlgebra.isGeneratedInDegreeOne_pushforward
      (selfOpensStructureMap s.site s.base s.containsBase V.obj.left)
      (etalePointAlgebra s.smallAlgebra V.obj.left V.obj.hom) (op U) hgen
  exact Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra.adjoin_grading_one_eq_top
    _ _ (Stacks.SymGraded.isGeneratedInDegreeOneAt_toSheafGradedAlgebra _ _ _ _ U hZ)

/-! ### Stacks 085D (1) -/

variable (s) (TA : Stacks.AlgebraicGeometry.ProjRepresentsF1.TensorAlgebras.{u})

/-- **Stacks 085D, part (1), on the constructed relative Proj.** For a quasi-coherent graded
`𝒪_X`-algebra `𝒜` on an algebraic space `X` generated as an `𝒜₀`-algebra by `𝒜₁`
(`RelativeProjSituation.IsGeneratedInDegreeOne`: over every affine étale chart `V` of `X` the
sections `⨁ₙ 𝒜ₙ(V)` are generated by `𝒜₁(V)` over `𝒜₀(V)`), the relative homogeneous spectrum
`P = Proj_X(𝒜)` constructed in Stacks 084A–084B represents the functor `F₁` which sends `T` to
the isomorphism classes of triples `(f, ℒ, ψ)`: `f : T → X`, `ℒ` an invertible `𝒪_T`-module, and
`ψ : f^*𝒜 ⟶ ⨁_{n ≥ 0} ℒ^{⊗ n}` a map of graded `𝒪_T`-algebras inducing a surjection
`f^*𝒜₁ ⟶ ℒ`.

`F₁` is `relativeProjF1Functor`, functorial by pullback of triples; the isomorphism is inverse to
the natural map `f1ToRelativeProj` sending a triple to the point of `P` it classifies (`P` is
lifted to the universe of `F₁`). `TA` is the choice of tensor algebras needed to write
`⨁_{n ≥ 0} ℒ^{⊗ n}`. It is `relativeProjIsoF1`, whose hypothesis on the restrictions of `𝒜` to
the étale charts follows from generation of `𝒜` itself
(`IsGeneratedInDegreeOne.isGeneratedInDegreeOneOnCharts`). -/
@[stacks 085D "part (1), on the constructed relative Proj: for a quasi-coherent graded \
O_X-algebra A on an algebraic space X generated as an A_0-algebra by A_1 (over every affine \
object V of the small etale site of X, the ring of sections of A over V is generated by its \
degree-one part over its degree-zero part), the relative Proj P = relativeProjFunctor of Tags \
084A-084B represents the functor F_1 of isomorphism classes of triples (f : T -> X, L \
invertible on T, psi : f^*A -> ⨁_{n >= 0} L^{tensor n} a map of graded O_T-algebras \
surjective in degree one), as a natural isomorphism of functors on the big fppf site; F_1 is \
functorial by pullback of triples (relativeProjF1Functor)"]
def relativeProjIsoF1OfGenerated (hgen : s.IsGeneratedInDegreeOne) :
    s.relativeProjFunctor ⋙ uliftFunctor.{u + 1} ≅ s.relativeProjF1Functor TA :=
  s.relativeProjIsoF1 TA hgen.isGeneratedInDegreeOneOnCharts

/-- The inverse of the isomorphism sends a triple to the point of `P` it classifies. -/
theorem relativeProjIsoF1OfGenerated_inv_app (hgen : s.IsGeneratedInDegreeOne)
    (T : (BigFppfOver s.site s.base s.containsBase)ᵒᵖ) (x : s.F1Triples TA T.unop) :
    (s.relativeProjIsoF1OfGenerated TA hgen).inv.app T x =
      ULift.up (yonedaEquiv (s.f1ToPoint TA x)) :=
  rfl

end RelativeProjSituation

