namespace SheafOfModules.GradedAlgebra

/-- **Generation in degree one is transported along a multiplicative additive bijection of
sections.** -/
theorem isGeneratedInDegreeOne_of_bijective
    {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}
    {C' : Type u₂} [Category.{v₂} C'] {J' : GrothendieckTopology C'} {R' : Sheaf J' RingCat.{t'}}
    {A : GradedAlgebra.{t, a} R} {A' : GradedAlgebra.{t', a'} R'} {W : Cᵒᵖ} {W' : C'ᵒᵖ}
    (e : ∀ k : ℤ, (A'.piece k).val.obj W' → (A.piece k).val.obj W)
    (hadd : ∀ k a b, e k (a + b) = e k a + e k b)
    (he : ∀ k, Function.Bijective (e k))
    (hmul : ∀ (n : ℕ) (x : (A'.piece 1).val.obj W') (y : (A'.piece (n : ℤ)).val.obj W'),
      e (1 + (n : ℤ)) ((A'.mul 1 n).app W' x y) = (A.mul 1 n).app W (e 1 x) (e n y))
    (hA : IsGeneratedInDegreeOne A W) : IsGeneratedInDegreeOne A' W' := by
  intro n P hP
  let e' : (A'.piece (1 + (n : ℤ))).val.obj W' →+ (A.piece (1 + (n : ℤ))).val.obj W :=
    AddMonoidHom.mk' (e (1 + (n : ℤ))) (hadd _)
  have hQ := hA n (P.map e') (fun x y => by
    obtain ⟨x', rfl⟩ := (he 1).2 x
    obtain ⟨y', rfl⟩ := (he n).2 y
    rw [← hmul]
    exact AddSubgroup.mem_map_of_mem e' (hP x' y'))
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨p, hp, hpz⟩ := AddSubgroup.mem_map.1 (hQ ▸ AddSubgroup.mem_top (e' z))
  exact (he (1 + (n : ℤ))).1 hpz ▸ hp

/-- **Generation in degree one is read on the image object under a pushforward.** -/
theorem isGeneratedInDegreeOne_pushforward
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D} {G : C ⥤ D}
    [G.IsContinuous J K] {S : Sheaf J RingCat.{t}} {R : Sheaf K RingCat.{t}}
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{t} J K).obj R)
    (A : GradedAlgebra.{t, a} R) (U : Cᵒᵖ) (h : IsGeneratedInDegreeOne A (G.op.obj U)) :
    IsGeneratedInDegreeOne (pushforward φ A) U :=
  h

end SheafOfModules.GradedAlgebra

