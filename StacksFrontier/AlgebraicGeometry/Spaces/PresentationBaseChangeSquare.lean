module

public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleChartStandardPresentation
public import StacksFrontier.AlgebraicGeometry.Spaces.SchemePointsAffineHom

/-!
# Base change of a polynomial presentation

Let `φ : R →+* A` be a homomorphism of `u`-rings, let `g₁, …, gₙ` be polynomials in `n` variables
over `R` and let `g'_λ = φ(g_λ)` be their images in the polynomial ring over `A`. Write

`C = R[x₁, …, xₙ]/(g₁, …, gₙ)` and `C' = A[x₁, …, xₙ]/(g'₁, …, g'ₙ)`.

Sending `x_ν` to `x_ν` and acting by `φ` on coefficients gives a homomorphism `C →+* C'`, and the
square

```
R  ⟶  A
↓      ↓
C  ⟶  C'
```

is a pushout of commutative rings: `C'` is the base change of `C` along `φ`. Equivalently, the
square of spectra

```
Spec C' ⟶ Spec C
   ↓         ↓
Spec A  ⟶ Spec R
```

is Cartesian, and so is its image on functors of points over the big fppf site of a scheme.

This is the base-change statement needed for the square of Stacks 084U inside the proof of
Stacks 07SQ: the presentation displayed there is built over the ring of global functions of an
algebraic space, and increasing the index replaces that ring by a larger one, which changes the
presentation exactly by the base change treated here.

## Main definitions

* `AlgebraicGeometry.Space.presentationBaseChangeHom`: the homomorphism `C →+* C'` induced by
  `φ` on the two presentations.
* `AlgebraicGeometry.Space.presentationBaseChangeDesc`: the homomorphism out of `C'` determined
  by a homomorphism out of `A` and a compatible homomorphism out of `C`.

## Main results

* `AlgebraicGeometry.Space.isPushout_presentationBaseChange`: the square of rings is a pushout.
* `AlgebraicGeometry.Space.isPullback_specMap_presentationBaseChange`: the square of spectra is
  Cartesian.
* `AlgebraicGeometry.Space.isPullback_schemePointsMap_presentationBaseChange`: the square of
  functors of points over the big fppf site is Cartesian.

## Implementation notes

*No tensor products.* The pushout is produced directly, by exhibiting the universal property of
`C'` rather than by identifying `C'` with `C ⊗_R A`. A homomorphism out of `C'` is a
homomorphism out of `A` together with `n` elements killing the `g'_λ`
(`AlgebraicGeometry.Space.coordinateHom`), and the data of a cocone on the square is exactly
that: the homomorphism out of `A` is one leg, and the images of the classes of the variables
under the other leg are the `n` elements. The relations are killed because `g'_λ` is `φ` applied
to `g_λ`, so evaluating it is evaluating `g_λ` along the composite with `φ`, and that vanishes by
`AlgebraicGeometry.Space.eval₂_eq_zero_of_comp_eq`.

*Uniqueness.* A homomorphism out of `C'` is determined by its composite with the quotient map,
which is surjective, and a homomorphism out of a polynomial ring is determined on constants and
on variables (`MvPolynomial.ringHom_ext`). The first leg of the cocone pins the constants and the
second pins the variables, because the base-change homomorphism carries the class of `x_ν` to the
class of `x_ν`.

Nothing here raises a compiler limit or disables a linter.

## References

* [Stacks Project, Tag 07SQ](https://stacks.math.columbia.edu/tag/07SQ)
* [Stacks Project, Tag 084U](https://stacks.math.columbia.edu/tag/084U)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

/-! ### The base-change homomorphism of presentations -/

section BaseChange

variable {R A : Type u} [CommRing R] [CommRing A] {n : ℕ}

/-- **The base change of a polynomial presentation.** The homomorphism
`R[x]/(g) →+* A[x]/(φ(g))` induced by acting by `φ` on coefficients: the ideal generated by the
`g_λ` is carried into the ideal generated by their images. -/
def presentationBaseChangeHom (φ : R →+* A) (g : Fin n → MvPolynomial (Fin n) R) :
    presentationAlgebra g →+* presentationAlgebra (fun k => MvPolynomial.map φ (g k)) :=
  Ideal.Quotient.lift (Ideal.span (Set.range g))
    ((Ideal.Quotient.mk (Ideal.span (Set.range fun k => MvPolynomial.map φ (g k)))).comp
      (MvPolynomial.map φ)) (by
    have hle : Ideal.span (Set.range g) ≤
        RingHom.ker ((Ideal.Quotient.mk
          (Ideal.span (Set.range fun k => MvPolynomial.map φ (g k)))).comp
            (MvPolynomial.map φ)) := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨l, rfl⟩
      exact RingHom.mem_ker.mpr
        (Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨l, rfl⟩))
    exact fun a ha => RingHom.mem_ker.1 (hle ha))

/-- The base-change homomorphism carries the class of a polynomial to the class of its image
under the coefficientwise action of `φ`. -/
@[simp]
theorem presentationBaseChangeHom_mk (φ : R →+* A) (g : Fin n → MvPolynomial (Fin n) R)
    (p : MvPolynomial (Fin n) R) :
    presentationBaseChangeHom φ g (Ideal.Quotient.mk (Ideal.span (Set.range g)) p)
      = Ideal.Quotient.mk (Ideal.span (Set.range fun k => MvPolynomial.map φ (g k)))
          (MvPolynomial.map φ p) :=
  rfl

/-- **The base-change square of rings commutes.** Restricting the base-change homomorphism along
the structure homomorphism of the presentation over `R` is `φ` followed by the structure
homomorphism of the presentation over `A`. -/
@[simp]
theorem presentationBaseChangeHom_comp_presentationStructureHom (φ : R →+* A)
    (g : Fin n → MvPolynomial (Fin n) R) :
    (presentationBaseChangeHom φ g).comp (presentationStructureHom g)
      = (presentationStructureHom (fun k => MvPolynomial.map φ (g k))).comp φ := by
  refine RingHom.ext fun a => ?_
  show Ideal.Quotient.mk (Ideal.span (Set.range fun k => MvPolynomial.map φ (g k)))
      (MvPolynomial.map φ (MvPolynomial.C a)) = _
  rw [MvPolynomial.map_C]
  rfl

end BaseChange

/-! ### The universal property of the base-changed presentation -/

section Desc

variable {R A D : Type u} [CommRing R] [CommRing A] [CommRing D] {n : ℕ}
  (φ : R →+* A) (g : Fin n → MvPolynomial (Fin n) R) (α : A →+* D)
  (β : presentationAlgebra g →+* D) (hβ : β.comp (presentationStructureHom g) = α.comp φ)

/-- A homomorphism out of a presentation, evaluated on the class of a polynomial, is evaluation
of the polynomial at the images of the classes of the variables. -/
private theorem apply_quotientMk_eq_eval₂Hom {D : Type u} [CommRing D]
    (g : Fin n → MvPolynomial (Fin n) R) (ψ : R →+* D) (k : presentationAlgebra g →+* D)
    (hk : k.comp (presentationStructureHom g) = ψ) (p : MvPolynomial (Fin n) R) :
    k (Ideal.Quotient.mk (Ideal.span (Set.range g)) p) = MvPolynomial.eval₂Hom ψ
      (fun ν => k (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X ν))) p :=
  RingHom.congr_fun (ringHom_comp_quotientMk_eq_eval₂Hom g ψ k hk) p

include hβ

/-- **The relations of the base-changed presentation are killed by the images of the variables.**
Evaluating `φ(g_λ)` at a family of elements of `D` along `α` is evaluating `g_λ` at that family
along `α ∘ φ`, which vanishes for the family of images of the classes of the variables under a
homomorphism restricting to `α ∘ φ`. -/
theorem eval₂_map_eq_zero_of_comp_eq (l : Fin n) :
    MvPolynomial.eval₂ α
        (fun ν => β (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X ν)))
        (MvPolynomial.map φ (g l)) = 0 := by
  rw [MvPolynomial.eval₂_map]
  exact eval₂_eq_zero_of_comp_eq g (α.comp φ) β hβ l

/-- **The homomorphism out of the base-changed presentation determined by a cocone.** Given
`α : A →+* D` and `β : R[x]/(g) →+* D` agreeing on `R`, the homomorphism `A[x]/(φ(g)) →+* D`
which is `α` on constants and sends the class of `x_ν` to the image under `β` of the class of
`x_ν`. -/
def presentationBaseChangeDesc :
    presentationAlgebra (fun k => MvPolynomial.map φ (g k)) →+* D :=
  coordinateHom (fun k => MvPolynomial.map φ (g k)) α
    (fun ν => β (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X ν)))
    (eval₂_map_eq_zero_of_comp_eq φ g α β hβ)

/-- The homomorphism out of the base-changed presentation restricts along the structure
homomorphism to `α`. -/
theorem presentationBaseChangeDesc_comp_presentationStructureHom :
    (presentationBaseChangeDesc φ g α β hβ).comp
        (presentationStructureHom (fun k => MvPolynomial.map φ (g k))) = α :=
  coordinateHom_comp_presentationStructureHom _ α _ _

/-- The homomorphism out of the base-changed presentation restricts along the base-change
homomorphism to `β`. Both sides are determined by their values on the classes of polynomials, and
there they are evaluation at the images of the variables along `α ∘ φ`. -/
theorem presentationBaseChangeDesc_comp_presentationBaseChangeHom :
    (presentationBaseChangeDesc φ g α β hβ).comp (presentationBaseChangeHom φ g) = β := by
  refine RingHom.ext fun x => ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [RingHom.comp_apply, presentationBaseChangeHom_mk,
    apply_quotientMk_eq_eval₂Hom g (α.comp φ) β hβ]
  show MvPolynomial.eval₂Hom α
      (fun ν => β (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X ν)))
      (MvPolynomial.map φ p) = _
  rw [MvPolynomial.eval₂Hom_map_hom]

/-- The homomorphism out of the base-changed presentation carries the class of the variable `x_ν`
to the image under `β` of the class of `x_ν`. -/
@[simp]
theorem presentationBaseChangeDesc_mk_X (ν : Fin n) :
    presentationBaseChangeDesc φ g α β hβ
        (Ideal.Quotient.mk (Ideal.span (Set.range fun k => MvPolynomial.map φ (g k)))
          (MvPolynomial.X ν))
      = β (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X ν)) :=
  coordinateHom_mk_X (fun k => MvPolynomial.map φ (g k)) α _
    (eval₂_map_eq_zero_of_comp_eq φ g α β hβ) ν

/-- **The homomorphism out of the base-changed presentation is the only one compatible with the
cocone.** A homomorphism out of `A[x]/(φ(g))` restricting to `α` on `A` and to `β` along the
base-change homomorphism agrees with `presentationBaseChangeDesc`: both composites with the
quotient map are evaluation along `α` at the images of the classes of the variables, and those
images agree because the base-change homomorphism fixes the class of `x_ν`. -/
theorem eq_presentationBaseChangeDesc
    (m : presentationAlgebra (fun k => MvPolynomial.map φ (g k)) →+* D)
    (hm₁ : m.comp (presentationStructureHom (fun k => MvPolynomial.map φ (g k))) = α)
    (hm₂ : m.comp (presentationBaseChangeHom φ g) = β) :
    m = presentationBaseChangeDesc φ g α β hβ := by
  have hd : (fun ν => β (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X ν)))
      = fun ν => m (Ideal.Quotient.mk
          (Ideal.span (Set.range fun k => MvPolynomial.map φ (g k))) (MvPolynomial.X ν)) := by
    funext ν
    rw [← hm₂, RingHom.comp_apply, presentationBaseChangeHom_mk, MvPolynomial.map_X]
  refine RingHom.ext fun x => ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [apply_quotientMk_eq_eval₂Hom _ α m hm₁, apply_quotientMk_eq_eval₂Hom _ α
    (presentationBaseChangeDesc φ g α β hβ)
    (presentationBaseChangeDesc_comp_presentationStructureHom φ g α β hβ)]
  simp only [presentationBaseChangeDesc_mk_X]
  rw [hd]

end Desc

/-! ### The base-change square is a pushout -/

section Pushout

variable {R A : Type u} [CommRing R] [CommRing A] {n : ℕ}

/-- **The base-change square of a polynomial presentation is a pushout of commutative rings.**
For `φ : R →+* A` and polynomials `g₁, …, gₙ` over `R`, the square whose top is `φ`, whose
verticals are the structure homomorphisms of `R[x]/(g)` over `R` and of `A[x]/(φ(g))` over `A`,
and whose bottom is the base-change homomorphism, is a pushout: `A[x]/(φ(g))` is the base change
of `R[x]/(g)` along `φ`.

The colimit is exhibited directly, through `AlgebraicGeometry.Space.coordinateHom`: a cocone on
the square is a homomorphism out of `A` together with `n` elements killing the base-changed
relations, which is exactly the data a homomorphism out of `A[x]/(φ(g))` is made of. -/
theorem isPushout_presentationBaseChange (φ : R →+* A) (g : Fin n → MvPolynomial (Fin n) R) :
    IsPushout (CommRingCat.ofHom φ) (CommRingCat.ofHom (presentationStructureHom g))
      (CommRingCat.ofHom (presentationStructureHom (fun k => MvPolynomial.map φ (g k))))
      (CommRingCat.ofHom (presentationBaseChangeHom φ g)) := by
  have hw : CommRingCat.ofHom φ ≫
      CommRingCat.ofHom (presentationStructureHom (fun k => MvPolynomial.map φ (g k))) =
      CommRingCat.ofHom (presentationStructureHom g) ≫
        CommRingCat.ofHom (presentationBaseChangeHom φ g) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      presentationBaseChangeHom_comp_presentationStructureHom]
  have hcond : ∀ s : PushoutCocone (CommRingCat.ofHom φ)
      (CommRingCat.ofHom (presentationStructureHom g)),
      s.inr.hom.comp (presentationStructureHom g) = s.inl.hom.comp φ := fun s => by
    have h := congrArg CommRingCat.Hom.hom s.condition
    simpa using h.symm
  refine ⟨⟨hw⟩, ⟨PushoutCocone.IsColimit.mk hw
    (fun s => CommRingCat.ofHom (presentationBaseChangeDesc φ g s.inl.hom s.inr.hom (hcond s)))
    (fun s => ?_) (fun s => ?_) (fun s m h₁ h₂ => ?_)⟩⟩
  · rw [← CommRingCat.ofHom_comp,
      presentationBaseChangeDesc_comp_presentationStructureHom φ g s.inl.hom s.inr.hom (hcond s)]
    exact CommRingCat.ofHom_hom s.inl
  · rw [← CommRingCat.ofHom_comp,
      presentationBaseChangeDesc_comp_presentationBaseChangeHom φ g s.inl.hom s.inr.hom
        (hcond s)]
    exact CommRingCat.ofHom_hom s.inr
  · refine CommRingCat.hom_ext (eq_presentationBaseChangeDesc φ g s.inl.hom s.inr.hom (hcond s)
      m.hom ?_ ?_)
    · simpa using congrArg CommRingCat.Hom.hom h₁
    · simpa using congrArg CommRingCat.Hom.hom h₂

/-- **The square of spectra of a base-changed polynomial presentation is Cartesian.** The
spectrum functor carries the pushout square of
`AlgebraicGeometry.Space.isPushout_presentationBaseChange` to a Cartesian square of affine
schemes. -/
theorem isPullback_specMap_presentationBaseChange (φ : R →+* A)
    (g : Fin n → MvPolynomial (Fin n) R) :
    IsPullback
      (Spec.map (CommRingCat.ofHom
        (presentationStructureHom (fun k => MvPolynomial.map φ (g k)))))
      (Spec.map (CommRingCat.ofHom (presentationBaseChangeHom φ g)))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (presentationStructureHom g))) :=
  isPullback_SpecMap_of_isPushout _ _ _ _ (isPushout_presentationBaseChange φ g)

/-- **The square of a base-changed polynomial presentation is Cartesian on functors of points.**
The Cartesian square of spectra of
`AlgebraicGeometry.Space.isPullback_specMap_presentationBaseChange`, read on the functors of
points over the big fppf site of a scheme `S`, is again Cartesian: the functor of points of a
scheme preserves Cartesian squares. -/
theorem isPullback_schemePointsMap_presentationBaseChange (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) (φ : R →+* A) (g : Fin n → MvPolynomial (Fin n) R) :
    IsPullback
      (schemePointsMap B S hS (Spec.map (CommRingCat.ofHom
        (presentationStructureHom (fun k => MvPolynomial.map φ (g k))))))
      (schemePointsMap B S hS (Spec.map (CommRingCat.ofHom (presentationBaseChangeHom φ g))))
      (schemePointsMap B S hS (Spec.map (CommRingCat.ofHom φ)))
      (schemePointsMap B S hS
        (Spec.map (CommRingCat.ofHom (presentationStructureHom g)))) :=
  isPullback_schemePointsMap B S hS (isPullback_specMap_presentationBaseChange φ g)

end Pushout

end AlgebraicGeometry.Space

end
