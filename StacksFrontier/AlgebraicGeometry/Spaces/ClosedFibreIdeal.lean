/-!
# The ideal sheaf of a closed fibre

Let `ι : P ⟶ T` be a morphism of the big fppf site over `S` which is a closed immersion of
affine schemes, `f : X ⟶ T` a morphism from an algebraic space, and `p : U ⟶ X` the base change
of `ι` along `f`, so that `U = X ×_T P` is the closed subspace of `X` cut out by the ideal `J` of
`P` in `T`.  This file builds the ideal sheaf of that closed subspace, identifies it with the
kernel of `p♯ : 𝒪_X ⟶ p_*𝒪_U`, and reads `J` into it: every element of `J`, read as a global
function on `X`, lies in the ideal of the fibre over every chart, and over an affine chart those
readings generate it.

This is the commutative algebra behind the identification, used in the proof of Stacks 0D39 with
`T = Spec 𝒪_{Y,y}` and `P` its closed point, of the modules killed by `𝔪` with the modules on the
fibre `X_y`: the source cites Cohomology of Spaces, Lemma 08AM for "we may think of
`𝔪ⁿℱ/𝔪ⁿ⁺¹ℱ` as a coherent `𝒪_{X_y}`-module".  The passage from the ideal sheaf to the modules
it annihilates is not carried out here.

## Main definitions

* `AlgebraicGeometry.Space.fibreSubspace` and `AlgebraicGeometry.Space.fibreIdeal`: the fibre
  `X ×_T P` as a closed subspace of `X`, and its defining ideal sheaf.
* `AlgebraicGeometry.Space.baseScalar`: a regular function on `T`, read as a global function on
  `X` through `f`.

## Main results

* `AlgebraicGeometry.Space.range_eq_preimage_range_of_isPullback`: the range of the base change
  of a morphism is the preimage of its range.
* `AlgebraicGeometry.Space.kerIdeal_structureSharp_eq_fibreIdeal`: **the ideal sheaf of a base
  change of `ι` is the ideal of the fibre.**
* `AlgebraicGeometry.Space.baseScalar_val_mem_fibreIdeal`: **every element of `J`, read as a
  global function on `X`, lies in the ideal of the fibre over every chart.**
* `AlgebraicGeometry.Space.fibreIdeal_obj_of_isAffine` and
  `AlgebraicGeometry.Space.fibreIdeal_obj_eq_span`: over an affine chart the ideal of the fibre
  is generated by `J`, and by the readings of any family of generators of `J`.

## The argument

The range of `p` is the inverse image of the closed subspace `ι(P) ⊆ T`, whose defining ideal on
an affine chart `V` of `X` is the extension of `J` along `Γ(T) ⟶ Γ(V)`
(`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map_chartDiagram`).  The ideal sheaf of `p`
is that of its range, since `p` is a monomorphism onto its range.

## References

* [Stacks Project, Tag 08AM](https://stacks.math.columbia.edu/tag/08AM)
* [Stacks Project, Tag 04CJ](https://stacks.math.columbia.edu/tag/04CJ)
* [Stacks Project, Tag 0D39](https://stacks.math.columbia.edu/tag/0D39)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.SheafOfModules.Tensor (ringSheaf)

universe w u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **The range of a base change is the preimage of the range.**  For a cartesian square of
presheaves of sets, a section of the corner of the base lies in the range of the base change
exactly when its image lies in the range of the original morphism. -/
theorem range_eq_preimage_range_of_isPullback {C : Type*} [Category* C]
    {A₁ A₂ A₃ A₄ : Cᵒᵖ ⥤ Type w} {p : A₁ ⟶ A₂} {q : A₁ ⟶ A₃} {f : A₂ ⟶ A₄} {ι : A₃ ⟶ A₄}
    (hsq : IsPullback p q f ι) : Subfunctor.range p = (Subfunctor.range ι).preimage f := by
  ext W x
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨q.app W y, (congrFun (congrArg (fun φ => φ.app W) hsq.w) y).symm⟩
  · rintro ⟨z, hz⟩
    have hW := hsq.map ((evaluation Cᵒᵖ _).obj W)
    obtain ⟨y, hy, -⟩ := ((Types.isPullback_iff _ _ _ _).1 hW).2.2 x z hz.symm
    exact ⟨y, hy⟩

/-- **Isomorphic representing objects have the same kernel on global functions.**  If two
morphisms `s₁ : Q₁ ⟶ W` and `s₂ : Q₂ ⟶ W` of the site become isomorphic over `W` after the
Yoneda embedding, pullback of global regular functions along them has the same kernel. -/
theorem ker_gamma_eq_of_yoneda_iso {Q₁ Q₂ W : BigFppfOver B S hS} (s₁ : Q₁ ⟶ W) (s₂ : Q₂ ⟶ W)
    (e : yoneda.obj Q₁ ≅ yoneda.obj Q₂) (he : e.hom ≫ yoneda.map s₂ = yoneda.map s₁) :
    RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map s₁).op).hom =
      RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map s₂).op).hom := by
  let e' : Q₁ ≅ Q₂ := Yoneda.fullyFaithful.preimageIso e
  have h : e'.hom ≫ s₂ = s₁ := Yoneda.fullyFaithful.map_injective (by
    rw [Functor.map_comp]
    exact (congrArg (· ≫ yoneda.map s₂) (Yoneda.fullyFaithful.map_preimage e.hom)).trans he)
  have hinj : Function.Injective
      (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map e'.hom).op).hom := fun a b hab => by
    have key : ∀ c, (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map e'.inv).op).hom
        ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map e'.hom).op).hom c) = c := fun c => by
      rw [gamma_toScheme_comp B S hS e'.inv e'.hom c, e'.inv_hom_id, CategoryTheory.Functor.map_id,
        op_id, CategoryTheory.Functor.map_id]
      rfl
    rw [← key a, ← key b, hab]
  ext a
  rw [RingHom.mem_ker, RingHom.mem_ker, ← h, ← gamma_toScheme_comp B S hS e'.hom s₂ a]
  exact ⟨fun h0 => hinj (h0.trans (map_zero _).symm), fun h0 => by rw [h0, map_zero]⟩

/-- **Two cartesian squares over isomorphic morphisms have kernel-equal projections.**  Let
`iₐ : Pₐ ⟶ X` and `i_b : P_b ⟶ X` be morphisms of presheaves identified by an isomorphism
`Pₐ ≅ P_b` over `X`, and let `s₁ : Q₁ ⟶ W`, `s₂ : Q₂ ⟶ W` be morphisms of the site whose Yoneda
images are base changes of `iₐ` and `i_b` along one `w : h_W ⟶ X`.  Then pullback of global
regular functions along `s₁` and along `s₂` has the same kernel. -/
theorem ker_gamma_eq_of_isPullback {Pa Pb X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {ia : Pa ⟶ X} {ib : Pb ⟶ X} (φ : Pa ≅ Pb) (hφ : φ.hom ≫ ib = ia)
    {W Q₁ Q₂ : BigFppfOver B S hS} {w : yoneda.obj W ⟶ X} {s₁ : Q₁ ⟶ W} {s₂ : Q₂ ⟶ W}
    {f₁ : yoneda.obj Q₁ ⟶ Pa} {f₂ : yoneda.obj Q₂ ⟶ Pb}
    (h₁ : IsPullback f₁ (yoneda.map s₁) ia w) (h₂ : IsPullback f₂ (yoneda.map s₂) ib w) :
    RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map s₁).op).hom =
      RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map s₂).op).hom := by
  have hsq : IsPullback ia φ.hom (𝟙 X) ib :=
    IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, hφ]⟩
  have h₁' : IsPullback (f₁ ≫ φ.hom) (yoneda.map s₁) ib w := by
    have := (h₁.flip.paste_vert hsq).flip
    rwa [Category.comp_id] at this
  exact ker_gamma_eq_of_yoneda_iso s₁ s₂ (h₁'.isoIsPullback _ _ h₂)
    (IsPullback.isoIsPullback_hom_snd _ _ _ _)

/-! ### The closed fibre as a closed subspace -/

section Fibre

variable {P T : BigFppfOver B S hS} (ι : P ⟶ T)
  (hι : AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map ι))

include hι in
/-- A morphism of the site which is a closed immersion of schemes is a monomorphism. -/
theorem mono_of_isClosedImmersion_toScheme : Mono ι := by
  have : Mono ((BigFppfOver.toScheme B S hS).map ι) := inferInstance
  refine ⟨fun {Q} g₁ g₂ hgg => ?_⟩
  refine Functor.map_injective (BigFppfOver.toScheme B S hS) ?_
  refine (cancel_mono ((BigFppfOver.toScheme B S hS).map ι)).1 ?_
  rw [← Functor.map_comp, ← Functor.map_comp, hgg]

/-- **The closed subspace `ι(P)` of `h_T`** cut out by a morphism of the site which is a closed
immersion of schemes. -/
noncomputable abbrev rangeYonedaClosedSubspace : ClosedSubspaces B S hS (yoneda.obj T) :=
  ⟨Subfunctor.range (yoneda.map ι), isClosedSubspace_range_yoneda_map B S hS ι hι⟩

variable {X : AlgebraicSpaces B S hS} (f : X ⟶ representedAlgebraicSpace B S hS T)

/-- **The fibre `X ×_T P` as a closed subspace of `X`**: the inverse image of `ι(P)` along
`f : X ⟶ h_T`. -/
noncomputable abbrev fibreSubspace : ClosedSubspaces B S hS X.1 :=
  preimageSubspace B S hS f (rangeYonedaClosedSubspace ι hι)

/-- **The ideal sheaf `J 𝒪_X` of the fibre `X ×_T P`**: the defining ideal sheaf of
`AlgebraicGeometry.Space.fibreSubspace`.  When `T = Spec A` and `P = Spec A/J` it is the ideal
sheaf generated by `J`, which is what the source writes `J 𝒪_X`
(`AlgebraicGeometry.Space.fibreIdeal_obj_of_isAffine`). -/
noncomputable def fibreIdeal : IdealSheaves B S hS X.1 X.2 :=
  definingIdealSheaf B S hS X (fibreSubspace ι hι f)

/-- The sections of `AlgebraicGeometry.Space.fibreIdeal` over an étale scheme chart `W` are the
defining ideal of the fibre `X ×_T P` at `W`. -/
theorem fibreIdeal_obj (W : (SmallEtale B S hS X.1)ᵒᵖ) :
    (fibreIdeal ι hι f).obj W = definingIdealAt B S hS X (fibreSubspace ι hι f) W :=
  rfl

/-- **The ideal sheaf of a base change of `ι` is the ideal of the fibre.**  For a cartesian square
exhibiting `h_U ⟶ X` as the base change of `ι` along `f`, the kernel of
`p♯ : 𝒪_X ⟶ p_*𝒪_U` is `AlgebraicGeometry.Space.fibreIdeal`.

On an étale scheme chart `W` of `X` both are the kernel of pullback of regular functions along a
closed immersion into `W` — the base change of `p` and that of the inclusion of the fibre — and
the two base changes are isomorphic over `W`, since `p` is an isomorphism onto the fibre
(`AlgebraicGeometry.Space.range_eq_preimage_range_of_isPullback`). -/
theorem kerIdeal_structureSharp_eq_fibreIdeal {U : BigFppfOver B S hS} (p : yoneda.obj U ⟶ X.1)
    (q : U ⟶ P) (hsq : IsPullback p (yoneda.map q) f.hom (yoneda.map ι)) :
    SheafOfModules.kerIdeal (structureSharp B S hS
      (ObjectProperty.homMk p : representedAlgebraicSpace B S hS U ⟶ X)) =
      fibreIdeal ι hι f := by
  have hιc : IsClosedImmersion B S hS (yoneda.map ι) :=
    (BigFppfOver.presheaf_inverseImage_yoneda_map_iff B S hS
      (@AlgebraicGeometry.IsClosedImmersion.{u}) ι).2 hι
  have hpc : IsClosedImmersion B S hS p :=
    (MorphismProperty.relative_isStableUnderBaseChange
      (MorphismProperty.inverseImage
        (@AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS))).of_isPullback hsq.flip hιc
  have : Mono ι := mono_of_isClosedImmersion_toScheme ι hι
  have : Mono p := hsq.mono_fst_of_mono
  have hrange : Subfunctor.range p = (fibreSubspace ι hι f).1 :=
    range_eq_preimage_range_of_isPullback hsq
  have key : ∀ (G G' : Subfunctor X.1) (h : G = G'),
      (eqToIso (congrArg Subfunctor.toFunctor h)).hom ≫ G'.ι = G.ι := by
    rintro G _ rfl
    simp
  let φ : yoneda.obj U ≅ (fibreSubspace ι hι f).1.toFunctor :=
    asIso (Subfunctor.toRange p) ≪≫ eqToIso (congrArg Subfunctor.toFunctor hrange)
  have hφ : φ.hom ≫ (fibreSubspace ι hι f).1.ι = p := by
    simp only [φ, Iso.trans_hom, asIso_hom, Category.assoc, key _ _ hrange,
      Subfunctor.toRange_ι]
  refine _root_.SheafOfModules.Submodule.ext (PresheafOfModules.Submodule.ext fun W => ?_)
  obtain ⟨W⟩ := W
  ext a
  refine (mem_kerIdeal_structureSharp_iff B S hS _ hpc.rep W a).trans ?_
  change _ ↔ a ∈ definingIdealAt B S hS X (fibreSubspace ι hι f) (op W)
  rw [definingIdealAt_eq_ker, ← ker_gamma_eq_of_isPullback φ hφ (hpc.rep.isPullback W.1.hom)
    ((fibreSubspace ι hι f).2.2.rep.isPullback W.1.hom)]
  exact RingHom.mem_ker.symm

include hι in
/-- **The defining ideal of `ι(P)` on the identity chart of `h_T` is the kernel of `ι♯`** on
global regular functions. -/
theorem definingIdealAt_rangeYonedaClosedSubspace_idEtaleChart :
    definingIdealAt B S hS (representedAlgebraicSpace B S hS T) (rangeYonedaClosedSubspace ι hι)
        (op (idEtaleChart B S hS T)) =
      RingHom.ker ((BigFppfOver.toScheme B S hS).map ι).appTop.hom := by
  have : Mono ι := mono_of_isClosedImmersion_toScheme ι hι
  rw [definingIdealAt_eq_ker]
  have h₀ : IsPullback (𝟙 (yoneda.obj P)) (yoneda.map ι) (yoneda.map ι) (𝟙 (yoneda.obj T)) :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩
  have h₁ : IsPullback (𝟙 (yoneda.obj P)) (yoneda.map ι) (yoneda.map ι)
      (idEtaleChart B S hS T).1.hom := h₀
  exact (ker_gamma_eq_of_isPullback (asIso (Subfunctor.toRange (yoneda.map ι)))
    (Subfunctor.toRange_ι _) h₁
    ((rangeYonedaClosedSubspace ι hι).2.2.rep.isPullback (idEtaleChart B S hS T).1.hom)).symm

/-- **On an affine chart the ideal of the fibre is generated by `J = ker(ι♯)`.**  Let `T` be
affine and `W` an étale scheme chart of `X` with affine underlying scheme, with `g : W ⟶ T` the
morphism of the site underlying `W ⟶ X ⟶ h_T`.  Then the sections of
`AlgebraicGeometry.Space.fibreIdeal` over `W` are the ideal of `Γ(W)` generated by the image of
`J` under `g♯`: the fibre `W ×_T P` is cut out of `W` by `J Γ(W)`. -/
theorem fibreIdeal_obj_of_isAffine [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (W : SmallEtale B S hS X.1) [IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left)]
    (g : W.1.left ⟶ T) (hg : yoneda.map g = W.1.hom ≫ f.hom) :
    (fibreIdeal ι hι f).obj (op W) =
      Ideal.map ((BigFppfOver.toScheme B S hS).map g).appTop.hom
        (RingHom.ker ((BigFppfOver.toScheme B S hS).map ι).appTop.hom) := by
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj (idEtaleChart B S hS T).1.left) :=
    inferInstanceAs (IsAffine ((BigFppfOver.toScheme B S hS).obj T))
  change definingIdealAt B S hS X (fibreSubspace ι hι f) (op W) = _
  rw [← definingIdealAt_rangeYonedaClosedSubspace_idEtaleChart ι hι]
  exact definingIdealAt_preimage_eq_map B S hS f (rangeYonedaClosedSubspace ι hι)
    (idEtaleChart B S hS T) W g ((Category.comp_id _).trans hg)

end Fibre

/-! ### Functions on the base as global functions on `X` -/

section BaseScalar

variable {P T : BigFppfOver B S hS} {X : AlgebraicSpaces B S hS}
  (f : X ⟶ representedAlgebraicSpace B S hS T)

/-- The morphism `W ⟶ T` of the site underlying `W ⟶ X ⟶ h_T`, for an étale scheme chart `W`
of `X`. -/
noncomputable def chartBaseHom (W : SmallEtale B S hS X.1) : W.1.left ⟶ T :=
  Yoneda.fullyFaithful.preimage (W.1.hom ≫ f.hom)

/-- The image of `AlgebraicGeometry.Space.chartBaseHom f W` under the Yoneda embedding is the
composite `W ⟶ X ⟶ h_T`. -/
theorem yoneda_map_chartBaseHom (W : SmallEtale B S hS X.1) :
    yoneda.map (chartBaseHom f W) = W.1.hom ≫ f.hom :=
  Yoneda.fullyFaithful.map_preimage _

/-- **A regular function on `T`, read as a global function on `X` through `f`.** -/
noncomputable def baseScalar (a : Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) :
    RingCat.sectionsSubring (ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).obj :=
  globalSectionsRingHomSite B S hS f
    ((sectionsSubringEvalEquiv (ringSheaf (smallEtaleRingedSite B S hS
      (representedAlgebraicSpace B S hS T).1 (representedAlgebraicSpace B S hS T).2).O).obj
      (isTerminalIdEtaleChart B S hS T)).symm a)

/-- **The value of `AlgebraicGeometry.Space.baseScalar` on an étale scheme chart `W`** is the
pullback of the function along `W ⟶ T`. -/
theorem baseScalar_val (a : Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))
    (W : SmallEtale B S hS X.1) :
    (baseScalar f a).1 (op W) =
      ((BigFppfOver.toScheme B S hS).map (chartBaseHom f W)).appTop.hom a := by
  refine (globalSectionsRingHomSite_val_chartDiagram B S hS f _
    ⟨W, idEtaleChart B S hS T, chartBaseHom f W,
      ((yoneda_map_chartBaseHom f W).trans (Category.comp_id _).symm).symm⟩).trans ?_
  have h : ((sectionsSubringEvalEquiv (ringSheaf (smallEtaleRingedSite B S hS
      (representedAlgebraicSpace B S hS T).1 (representedAlgebraicSpace B S hS T).2).O).obj
      (isTerminalIdEtaleChart B S hS T)).symm a).1 (op (idEtaleChart B S hS T)) = a := by
    exact (sectionsSubringEvalEquiv_apply _ _ _).symm.trans (RingEquiv.apply_symm_apply _ _)
  exact (congrArg _ h).trans rfl

variable (ι : P ⟶ T)
  (hι : AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map ι))

/-- **A function in `J = ker(ι♯)` lies in the ideal of the fibre on every chart.**  On an étale
scheme chart `W` of `X` the ideal of the fibre is the kernel of pullback along
`(X ×_T P) ×_X W ⟶ W`, and the composite of that morphism with `W ⟶ T` factors through `ι`. -/
theorem baseScalar_val_mem_fibreIdeal (a : Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))
    (ha : a ∈ RingHom.ker ((BigFppfOver.toScheme B S hS).map ι).appTop.hom)
    (W : SmallEtale B S hS X.1) :
    (baseScalar f a).1 (op W) ∈ (fibreIdeal ι hι f).obj (op W) := by
  have : Mono ι := mono_of_isClosedImmersion_toScheme ι hι
  rw [baseScalar_val]
  change _ ∈ definingIdealAt B S hS X (fibreSubspace ι hι f) (op W)
  rw [definingIdealAt_eq_ker]
  apply RingHom.mem_ker.mpr
  set Z := fibreSubspace ι hι f
  have hpb := Z.2.2.rep.isPullback W.1.hom
  let k : Z.2.2.rep.pullback W.1.hom ⟶ P := Yoneda.fullyFaithful.preimage
    (Z.2.2.rep.fst W.1.hom ≫ (rangeYonedaClosedSubspace ι hι).1.fromPreimage f.hom ≫
      inv (Subfunctor.toRange (yoneda.map ι)))
  have hk : Z.2.2.rep.snd W.1.hom ≫ chartBaseHom f W = k ≫ ι := by
    refine Yoneda.fullyFaithful.map_injective ?_
    have h1 : inv (Subfunctor.toRange (yoneda.map ι)) ≫ yoneda.map ι =
        (Subfunctor.range (yoneda.map ι)).ι := by
      rw [IsIso.inv_comp_eq, Subfunctor.toRange_ι]
    rw [Functor.map_comp, Functor.map_comp, yoneda_map_chartBaseHom,
      Yoneda.fullyFaithful.map_preimage, Category.assoc, Category.assoc, h1,
      Subfunctor.fromPreimage_ι, ← Category.assoc (yoneda.map _), ← hpb.w, Category.assoc]
  change (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd W.1.hom)).op).hom
    ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map (chartBaseHom f W)).op).hom a) = 0
  refine (gamma_toScheme_comp B S hS _ _ a).trans ?_
  refine (congrArg (fun m => (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map m).op).hom a)
    hk).trans ?_
  refine (gamma_toScheme_comp B S hS k ι a).symm.trans ?_
  have ha' : (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map ι).op).hom a = 0 := ha
  exact (congrArg _ ha').trans (map_zero _)

/-- **On an affine chart the ideal of the fibre is generated by the pulled-back generators of
`J`.**  If `x : Fin r → Γ(T)` generates `J = ker(ι♯)` and `T` and the chart `W` are affine, the
sections of the ideal of the fibre over `W` are the ideal generated by the values of the global
functions `AlgebraicGeometry.Space.baseScalar f (x i)` on `W`. -/
theorem fibreIdeal_obj_eq_span [IsAffine ((BigFppfOver.toScheme B S hS).obj T)] {r : ℕ}
    (x : Fin r → Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))
    (hx : Ideal.span (Set.range x) = RingHom.ker ((BigFppfOver.toScheme B S hS).map ι).appTop.hom)
    (W : SmallEtale B S hS X.1) [IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left)] :
    (fibreIdeal ι hι f).obj (op W) =
      Ideal.span (Set.range fun i => (baseScalar f (x i)).1 (op W)) := by
  rw [fibreIdeal_obj_of_isAffine ι hι f W (chartBaseHom f W) (yoneda_map_chartBaseHom f W),
    ← hx, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  exact (baseScalar_val f (x i) W).symm

end BaseScalar

end AlgebraicGeometry.Space

end
