/-!
# Generators over the open complement, extended across the sheaf of ideals

In the situation of [Stacks, Tag 0GUY] let `𝒢` be a coherent `𝒪_Y`-module.  The proof of
[Stacks, Tag 0GUZ] chooses sections `s_1, …, s_r` of `𝒢` over the affine scheme `V` generating
`𝒢|_V`, and extends each of them by [Stacks, Tag 07UM] to a map `s'_i : ℐ^{n_i} ⟶ 𝒢`.

Here `V` is read as the open complement `U = Y ∖ V(ℐ)` of 07UM: the factorization of `j` through
`U` is an isomorphism `V ≅ U`, since `j` is an open immersion with image `U`
(`AlgebraicGeometry.Space.exists_iso_idealComplement_comp_eq`).  So `U` has a terminal affine
étale chart, and a coherent module on it is generated by finitely many global sections.  The
output, `AlgebraicGeometry.Space.exists_idealPowModule_homs_eq_zero_of_restrict`, records the
generation as joint epimorphicity of the restrictions `s'_i|_U`: a map out of `𝒢|_U` killing every
`s'_i|_U` vanishes.

## Main results

* `Stacks.SheafOfModules.eq_zero_of_generates`: on a site with a terminal object `T`, a map of
  sheaves of modules killing a generating family of sections over `T` vanishes.
* `Stacks.SheafOfModules.exists_unit_homs_of_generates`: the corresponding maps `𝒪 ⟶ ℳ`.
* `AlgebraicGeometry.Space.exists_unit_homs_of_isTerminal_of_isCoherent`: a coherent module on an
  algebraic space with a terminal affine étale chart is jointly hit by finitely many `𝒪 ⟶ ℳ`.
* `AlgebraicGeometry.Space.exists_iso_idealComplement_comp_eq`: `V ≅ Y ∖ V(ℐ)` over `Y`.
* `AlgebraicGeometry.Space.exists_idealPowModule_homs_eq_zero_of_restrict`.

## References

* [Stacks Project, Tag 0GUZ](https://stacks.math.columbia.edu/tag/0GUZ)
* [Stacks Project, Tag 07UM](https://stacks.math.columbia.edu/tag/07UM)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v₁ u₁

namespace Stacks.SheafOfModules

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}

/-- **A map of sheaves of modules killing a generating family of sections over a terminal object
vanishes.**  Every section is locally a linear combination of restrictions of the family, which
the map kills, and the target is separated. -/
theorem eq_zero_of_generates {M Z : _root_.SheafOfModules.{u} R} {T : C} (hT : IsTerminal T)
    {n : ℕ} (s : Fin n → M.val.obj (op T)) (hs : PresheafOfModules.Generates J M.val s)
    (d : M ⟶ Z) (hd : ∀ i, (d.val.app (op T)).hom (s i) = 0) : d = 0 := by
  refine hom_ext_val_app_apply fun W z => ?_
  obtain ⟨T', hT', h⟩ := hs W.unop (hT.from W.unop) z
  refine val_app_eq_of_isSeparated d 0 z hT' fun Y g hg => ?_
  obtain ⟨a, ha⟩ := h Y g hg
  have hz : (M.val.map g.op).hom z =
      ∑ i, a i • M.val.restrictₛₗ (g ≫ hT.from W.unop).op (s i) := ha.symm
  have hi : ∀ i, (d.val.app (op Y)).hom (M.val.restrictₛₗ (g ≫ hT.from W.unop).op (s i)) = 0 :=
    fun i => by
      change (d.val.app (op Y)).hom ((M.val.map (g ≫ hT.from W.unop).op).hom (s i)) = 0
      rw [PresheafOfModules.naturality_apply, hd i]
      exact map_zero _
  rw [hz, map_sum]
  refine (Finset.sum_eq_zero fun i _ => ?_).trans rfl
  rw [map_smul, hi i, smul_zero]

/-- **A generating family of sections over a terminal object is the family of values at `1` of
maps `𝒪 ⟶ ℳ` which are jointly epimorphic.** -/
theorem exists_unit_homs_of_generates {M : _root_.SheafOfModules.{u} R} {T : C}
    (hT : IsTerminal T) {n : ℕ} (s : Fin n → M.val.obj (op T))
    (hs : PresheafOfModules.Generates J M.val s) :
    ∃ θ : Fin n → (_root_.SheafOfModules.unit R ⟶ M),
      ∀ ⦃Z : _root_.SheafOfModules.{u} R⦄ (d : M ⟶ Z), (∀ i, θ i ≫ d = 0) → d = 0 := by
  let θ : Fin n → (_root_.SheafOfModules.unit R ⟶ M) := fun i =>
    M.unitHomEquiv.symm ((FiniteTypeKernel.sectionsEquivOfTerminal M hT).symm (s i))
  have h1 : ∀ i, (M.unitHomEquiv (θ i)).val (op T) = s i := fun i =>
    (congrArg (fun σ : M.sections => σ.val (op T)) (M.unitHomEquiv.apply_symm_apply _)).trans
      ((FiniteTypeKernel.sectionsEquivOfTerminal M hT).apply_symm_apply (s i))
  refine ⟨θ, fun Z d hd => eq_zero_of_generates hT s hs d fun i => ?_⟩
  have h3 : (Z.unitHomEquiv (θ i ≫ d)).val (op T) =
      (d.val.app (op T)).hom ((M.unitHomEquiv (θ i)).val (op T)) := rfl
  rw [← h1 i, ← h3, hd i]
  rfl

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **A coherent module on an algebraic space with a terminal affine étale chart is jointly hit
by finitely many maps out of the structure sheaf**: its sections over the chart are finite
(`AlgebraicGeometry.Space.moduleFinite_sections_of_isCoherent`), hence generate it
(`AlgebraicGeometry.Space.generates_of_module_finite_sections`), and the chart is terminal. -/
theorem exists_unit_homs_of_isTerminal_of_isCoherent (U : AlgebraicSpaces B S hS)
    {T : SmallEtale B S hS U.1} (hT : IsTerminal T) (hTa : IsAffine (chartScheme T))
    (M : Modules.{u, u} B S hS U.1 U.2) (hM : IsCoherent B S hS U.1 U.2 M) :
    ∃ (n : ℕ) (θ : Fin n → (SheafOfModules.unit
        (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS U.1 U.2).O) ⟶ M)),
      ∀ ⦃Z : Modules.{u, u} B S hS U.1 U.2⦄ (d : M ⟶ Z), (∀ i, θ i ≫ d = 0) → d = 0 := by
  obtain ⟨n, s, hs⟩ := generates_of_module_finite_sections M
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS U.1 U.2 M
      hM.toIsQuasicoherentOnSite) hTa
    (moduleFinite_sections_of_isCoherent B S hS U.1 U.2 M hM hTa)
  obtain ⟨θ, hθ⟩ := Stacks.SheafOfModules.exists_unit_homs_of_generates hT s hs
  exact ⟨n, θ, hθ⟩

variable (hZ : B.Contains (⊤_ Scheme.{u}))

attribute [local instance] pointTopology

variable (X : AlgebraicSpaces B S hS) (hqc : IsQuasiCompactSpace B S hS X.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (D : ResolutionPropertyDescentSituation B S hS hZ X hqc hqs)

/-- **In the situation of Stacks 0GUY the chart `V` is the open complement `Y ∖ V(ℐ)`**: `j`
factors through the complement, its image being the unit locus of `ℐ`, and the factorization is
an open immersion (a monomorphism cancels) surjective on points, hence an isomorphism. -/
theorem exists_iso_idealComplement_comp_eq :
    ∃ e : yoneda.obj D.V ≅ (idealComplement B S hS D.Y D.I).1,
      e.hom ≫ (idealComplementι B S hS D.Y D.I).hom = D.j := by
  have hU : idealUnitLocus B S hS D.Y D.I = Set.range (pointsMap B S hS (yoneda.obj D.V) D.j) :=
    compl_injective D.idealZeroLocus_I
  have hR := (range_pointsMap_idealComplementι B S hS D.Y D.I).trans hU
  obtain ⟨k, hk⟩ := (factorsThrough_openSubspace_iff_points B S hS D.Y.2
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS _)
    (idealComplementSubfunctor B S hS D.Y D.I)
    (isOpenSubspace_idealComplementSubfunctor B S hS D.Y D.I) D.j).2 (fun y hy => hR.ge hy)
  have hk' : k ≫ (idealComplementSubfunctor B S hS D.Y D.I).ι = D.j := hk
  have hopen : IsOpenImmersion B S hS k :=
    isOpenImmersion_of_comp_mono B S hS k (idealComplementSubfunctor B S hS D.Y D.I).ι
      (hk' ▸ D.isOpenImmersion_j)
  have hsurj : Function.Surjective (pointsMap B S hS (yoneda.obj D.V) k) := by
    intro x
    obtain ⟨v, hv⟩ := hR.le ⟨x, rfl⟩
    refine ⟨v, pointsMap_injective_of_mono B S hS (idealComplementSubfunctor B S hS D.Y D.I).ι ?_⟩
    rw [← pointsMap_comp_apply, hk']
    exact hv
  have hiso : IsIso k := isIso_of_isOpenImmersion_of_surjective_pointsMap B S hS k hopen hsurj
  exact ⟨@asIso _ _ _ _ k hiso, hk'⟩

/-- **The generators of Stacks 0GUZ, extended by Stacks 07UM.**  For a coherent `𝒪_Y`-module `𝒢`
in the situation of Stacks 0GUY with `X` Noetherian, there are finitely many maps
`s'_i : ℐ^{n_i}𝒪_Y ⟶ 𝒢` whose restrictions to `U = Y ∖ V(ℐ)` are jointly epimorphic: a map out
of `𝒢|_U` killing every `s'_i|_U` vanishes.

`U` is the affine scheme `V` (`AlgebraicGeometry.Space.exists_iso_idealComplement_comp_eq`), so
`𝒢|_U` is jointly hit by finitely many `θ_i : 𝒪_U ⟶ 𝒢|_U`
(`AlgebraicGeometry.Space.exists_unit_homs_of_isTerminal_of_isCoherent`), and each `θ_i` is the
restriction of some `s'_i` by the surjectivity clause of Stacks 07UM,
`AlgebraicGeometry.Space.exists_homRestrict_eq`.

The exponents can be taken `≥ N` for any prescribed `N`: precomposing `s'_i` with the inclusion
`ℐ^{n_i + N} ⊆ ℐ^{n_i}` does not change its restriction to `U`
(`AlgebraicGeometry.Space.homRestrict_idealPowModuleHomOfLE`). -/
theorem exists_idealPowModule_homs_eq_zero_of_restrict_of_le (hX : IsNoetherian B S hS hZ X.1)
    (G : Modules.{u, u} B S hS D.Y.1 D.Y.2) (hG : IsCoherent B S hS D.Y.1 D.Y.2 G) (N : ℕ) :
    ∃ (r : ℕ) (n : Fin r → ℕ) (Ψ : ∀ i, idealPowModule D.I (n i)
        (SheafOfModules.unit (structureRingSheaf B S hS D.Y)) ⟶ G), (∀ i, N ≤ n i) ∧
      ∀ ⦃Z : Modules.{u, u} B S hS (idealComplement B S hS D.Y D.I).1
          (idealComplement B S hS D.Y D.I).2⦄
        (d : (restrictToIdealComplement B S hS D.Y D.I).obj G ⟶ Z),
        (∀ i, (restrictToIdealComplement B S hS D.Y D.I).map (Ψ i) ≫ d = 0) → d = 0 := by
  obtain ⟨e, -⟩ := exists_iso_idealComplement_comp_eq B S hS hZ X hqc hqs D
  have hNo := isNoetherian_Y_of_resolutionSituation B S hS hZ X hqc hqs D hX
  have hι := isEtale_idealComplementι B S hS D.Y D.I
  have hUN : HasEtaleLocalProperty B S hS (idealComplement B S hS D.Y D.I).1
      (fun T : Scheme.{u} => IsLocallyNoetherian T) :=
    isLocallyNoetherian_of_isLocallyOfFiniteType B S hS (idealComplement B S hS D.Y D.I).2
      D.Y.2 (idealComplementι B S hS D.Y D.I).hom
      (isLocallyOfFiniteType_of_isEtale B S hS D.Y.2 hι) hNo.2.2
  have hGU : IsCoherent B S hS (idealComplement B S hS D.Y D.I).1
      (idealComplement B S hS D.Y D.I).2 ((restrictToIdealComplement B S hS D.Y D.I).obj G) :=
    (isCoherent.{u, u} B S hS _ _).prop_of_iso
      ((modulePullbackIsoEtaleModulePullback B S hS (idealComplementι B S hS D.Y D.I) hι).app G)
      (isCoherent_modulePullback_of_hasEtaleLocalProperty B S hS
        (idealComplementι B S hS D.Y D.I) hUN G hG)
  obtain ⟨r, θ, hθ⟩ := exists_unit_homs_of_isTerminal_of_isCoherent B S hS
    (idealComplement B S hS D.Y D.I) (isTerminal_isoChart B S hS e) D.isAffine_V _ hGU
  let uI : (restrictToIdealComplement B S hS D.Y D.I).obj
      (SheafOfModules.unit (structureRingSheaf B S hS D.Y)) ≅
      SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS (idealComplement B S hS D.Y D.I).1
          (idealComplement B S hS D.Y D.I).2).O) :=
    ((modulePullbackIsoEtaleModulePullback B S hS (idealComplementι B S hS D.Y D.I) hι).app
      _).symm ≪≫ modulePullbackUnitIso B S hS (idealComplementι B S hS D.Y D.I)
  have hI := D.isFiniteTypeQuasicoherent_I
  have : Fact (HasEtaleLocalProperty B S hS D.Y.1
      (fun T : Scheme.{u} => IsLocallyNoetherian T)) := ⟨hNo.2.2⟩
  choose n Ψ hΨ using fun i => exists_homRestrict_eq B S hS D.Y D.I
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS D.Y.1 D.Y.2 _ hI.1)
    (SheafOfModules.unit (structureRingSheaf B S hS D.Y)) G (uI.hom ≫ θ i) hZ hNo hI.1
    hG.toIsQuasicoherentOnSite (isCoherent_structureSheaf B S hS D.Y.1 D.Y.2)
  -- precomposing with `ℐ^(n_i + N) ⊆ ℐ^(n_i)` raises the exponents and keeps the restrictions
  let Ψ' : ∀ i, idealPowModule D.I (n i + N)
      (SheafOfModules.unit (structureRingSheaf B S hS D.Y)) ⟶ G := fun i =>
    idealPowModuleHomOfLE D.I _ (Nat.le_add_right (n i) N) ≫ Ψ i
  refine ⟨r, fun i => n i + N, Ψ', fun i => Nat.le_add_left N (n i),
    fun Z d hd => hθ d fun i => ?_⟩
  calc θ i ≫ d = uI.inv ≫ (uI.hom ≫ θ i) ≫ d := by simp
    _ = uI.inv ≫ homRestrict B S hS D.Y D.I (Ψ i) ≫ d := by rw [hΨ i]
    _ = uI.inv ≫ homRestrict B S hS D.Y D.I (Ψ' i) ≫ d := by
      rw [show homRestrict B S hS D.Y D.I (Ψ' i) = homRestrict B S hS D.Y D.I (Ψ i) from
        homRestrict_idealPowModuleHomOfLE B S hS D.Y D.I (Nat.le_add_right (n i) N) (Ψ i)]
    _ = 0 := by
      have h : homRestrict B S hS D.Y D.I (Ψ' i) ≫ d =
          (idealPowRestrictIso B S hS D.Y D.I (n i + N) _).inv ≫
            ((restrictToIdealComplement B S hS D.Y D.I).map (Ψ' i) ≫ d) :=
        Category.assoc _ _ _
      rw [h, hd i, comp_zero, comp_zero]

/-- **The generators of Stacks 0GUZ, extended by Stacks 07UM.**  For a coherent `𝒪_Y`-module `𝒢`
in the situation of Stacks 0GUY with `X` Noetherian, there are finitely many maps
`s'_i : ℐ^{n_i}𝒪_Y ⟶ 𝒢` whose restrictions to `U = Y ∖ V(ℐ)` are jointly epimorphic: a map out
of `𝒢|_U` killing every `s'_i|_U` vanishes.  This is
`AlgebraicGeometry.Space.exists_idealPowModule_homs_eq_zero_of_restrict_of_le` with no lower bound
on the exponents. -/
theorem exists_idealPowModule_homs_eq_zero_of_restrict (hX : IsNoetherian B S hS hZ X.1)
    (G : Modules.{u, u} B S hS D.Y.1 D.Y.2) (hG : IsCoherent B S hS D.Y.1 D.Y.2 G) :
    ∃ (r : ℕ) (n : Fin r → ℕ) (Ψ : ∀ i, idealPowModule D.I (n i)
        (SheafOfModules.unit (structureRingSheaf B S hS D.Y)) ⟶ G),
      ∀ ⦃Z : Modules.{u, u} B S hS (idealComplement B S hS D.Y D.I).1
          (idealComplement B S hS D.Y D.I).2⦄
        (d : (restrictToIdealComplement B S hS D.Y D.I).obj G ⟶ Z),
        (∀ i, (restrictToIdealComplement B S hS D.Y D.I).map (Ψ i) ≫ d = 0) → d = 0 := by
  obtain ⟨r, n, Ψ, -, hΨ⟩ :=
    exists_idealPowModule_homs_eq_zero_of_restrict_of_le B S hS hZ X hqc hqs D hX G hG 0
  exact ⟨r, n, Ψ, hΨ⟩

end AlgebraicGeometry.Space

end
