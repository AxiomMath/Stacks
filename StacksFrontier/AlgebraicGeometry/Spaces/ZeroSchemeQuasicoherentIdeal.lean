-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Restriction of the evaluation ideal -/

/-- **Where the sections of `L` base change, the evaluation ideal of a section restricts into
the evaluation ideal.**  If the base change comparison of `L` over a morphism `f : V ⟶ U` of
étale charts is bijective, then the restrictions to `V` of the values `l(s|_U)` are again values
of linear functionals at `s|_V`.

A functional `l` on `L(U)` extends to the base change `𝒪_X(V) ⊗ L(U)` and is transported along
the comparison to a functional on `L(V)`; since the comparison takes `1 ⊗ s|_U` to `s|_V`, the
transported functional takes `s|_V` to the restriction of `l(s|_U)`. -/
theorem sectionEvaluationIdealAt_map_le_of_bijective_sectionsBaseChange
    (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    {U V : SmallEtale B S hS X.1} (f : V ⟶ U)
    (hbc : Function.Bijective (sectionsBaseChange L f)) :
    Ideal.map (chartRestrict (hF := X.2) f) (sectionEvaluationIdealAt B S hS X L s U) ≤
      sectionEvaluationIdealAt B S hS X L s V := by
  let _ := chartAlgebra (hF := X.2) f
  let _ := chartSectionsModule L f
  have _ := chartSections_isScalarTower L f
  let e := LinearEquiv.ofBijective (sectionsBaseChange L f) hbc
  refine Ideal.map_le_iff_le_comap.2 (Ideal.span_le.2 (Set.range_subset_iff.2 fun l => ?_))
  let lV := LinearMap.liftBaseChange (chartRing B S hS X.1 X.2 V)
    ((Algebra.linearMap (chartRing B S hS X.1 X.2 U)
      (chartRing B S hS X.1 X.2 V)).comp l)
  have hsymm : e.symm (s.eval (op V)) =
      TensorProduct.tmul (chartRing B S hS X.1 X.2 U) (1 : chartRing B S hS X.1 X.2 V)
        (s.eval (op U)) :=
    e.symm_apply_eq.2 ((chartBaseChange_one_tmul L f (s.eval (op U))).trans
      (PresheafOfModules.sections_property s f.op)).symm
  let l' : Module.Dual
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj
        (op V))
      (L.val.obj (op V)) := lV ∘ₗ e.symm.toLinearMap
  have hval : l' (s.eval (op V)) = chartRestrict (hF := X.2) f (l (s.eval (op U))) := by
    change lV (e.symm (s.eval (op V))) = _
    rw [hsymm, LinearMap.liftBaseChange_one_tmul]
    rfl
  refine SetLike.mem_coe.2 (Ideal.mem_comap.2 ?_)
  have hmem : l' (s.eval (op V)) ∈ sectionEvaluationIdealAt B S hS X L s V :=
    Ideal.subset_span (Set.mem_range_self l')
  rwa [hval] at hmem

/-! ### The family of ideals generated by the evaluation ideals -/

/-- **The family of ideals of `𝒪_X` generated by the evaluation ideals of the affine charts.**
Over an étale chart `W` of `X` it is the ideal generated by the restrictions to `W` of the
evaluation ideals of the section over the affine étale charts that `W` maps to.  It is stable
under restriction, so it is a submodule of the structure sheaf as a presheaf of modules. -/
noncomputable def sectionEvaluationSubmodule (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) :
    (SheafOfModules.unit (structureRingSheaf B S hS X)).val.Submodule where
  obj W := ⨆ (U : SmallEtale B S hS X.1)
      (_ : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1) (f : W.unop ⟶ U),
    Ideal.map (chartRestrict (hF := X.2) f) (sectionEvaluationIdealAt B S hS X L s U)
  map {W W'} g := by
    refine iSup_le fun U => iSup_le fun hU => iSup_le fun f => ?_
    refine Ideal.map_le_iff_le_comap.2 fun y hy => ?_
    have hle : Ideal.map (chartRestrict (hF := X.2) (g.unop ≫ f))
          (sectionEvaluationIdealAt B S hS X L s U) ≤
        ⨆ (U' : SmallEtale B S hS X.1)
          (_ : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U').1) (f' : W'.unop ⟶ U'),
          Ideal.map (chartRestrict (hF := X.2) f')
            (sectionEvaluationIdealAt B S hS X L s U') :=
      le_iSup_of_le U (le_iSup_of_le hU (le_iSup_of_le (g.unop ≫ f) le_rfl))
    have hmem := hle (Ideal.mem_map_of_mem
      (chartRestrict (hF := X.2) (g.unop ≫ f)) hy)
    rwa [chartRestrict_comp] at hmem

/-- The evaluation ideal of the section over an affine étale chart is contained in the family of
ideals it generates, taken over that chart. -/
theorem sectionEvaluationIdealAt_le_sectionEvaluationSubmodule_obj (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1) :
    sectionEvaluationIdealAt B S hS X L s U ≤
      (sectionEvaluationSubmodule B S hS X L s).obj (op U) := by
  have hid : sectionEvaluationIdealAt B S hS X L s U ≤
      Ideal.map (chartRestrict (hF := X.2) (𝟙 U))
        (sectionEvaluationIdealAt B S hS X L s U) := by
    intro x hx
    have hidx : chartRestrict (hF := X.2) (𝟙 U) x = x :=
      congrArg (fun φ : chartRing B S hS X.1 X.2 U →+* chartRing B S hS X.1 X.2 U => φ x)
        (chartRestrict_id (hF := X.2) U)
    have h := Ideal.mem_map_of_mem (chartRestrict (hF := X.2) (𝟙 U)) hx
    rwa [hidx] at h
  exact le_iSup_of_le U (le_iSup_of_le hU (le_iSup_of_le (𝟙 U) hid))

/-- **For a module cartesian on affine charts the generated family is the evaluation ideal on
every affine chart.**  The containment in one direction is the generation itself, and in the
other it is
`AlgebraicGeometry.Space.sectionEvaluationIdealAt_map_le_of_bijective_sectionsBaseChange`
applied to each morphism of affine charts. -/
theorem sectionEvaluationSubmodule_obj_eq_of_isCartesianOnAffineCharts
    (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hL : IsCartesianOnAffineCharts L) (V : SmallEtale B S hS X.1)
    (hV : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj V).1) :
    (sectionEvaluationSubmodule B S hS X L s).obj (op V) =
      sectionEvaluationIdealAt B S hS X L s V := by
  refine le_antisymm (iSup_le fun U => iSup_le fun hU => iSup_le fun f => ?_)
    (sectionEvaluationIdealAt_le_sectionEvaluationSubmodule_obj B S hS X L s V hV)
  exact sectionEvaluationIdealAt_map_le_of_bijective_sectionsBaseChange B S hS X L s f
    (hL U V hU hV f)

/-! ### The sheaf of ideals generated by the evaluation ideals -/

/-- **The sheaf of ideals of `𝒪_X` generated by the evaluation ideals of the affine charts**: the
smallest sheaf submodule of the structure sheaf lying above
`AlgebraicGeometry.Space.sectionEvaluationSubmodule`.  This is the sheaf of ideals which
Stacks 0845 uses to cut out the zero scheme of the section. -/
noncomputable def sectionEvaluationIdeal (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) :
    (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule :=
  sInf {N | sectionEvaluationSubmodule B S hS X L s ≤ N.toSubmodule}

/-- The generated family of ideals lies below the sheaf of ideals it generates. -/
theorem sectionEvaluationSubmodule_le_sectionEvaluationIdeal (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) :
    sectionEvaluationSubmodule B S hS X L s ≤
      (sectionEvaluationIdeal B S hS X L s).toSubmodule := by
  rw [sectionEvaluationIdeal, SheafOfModules.Submodule.toSubmodule_sInf]
  refine le_sInf ?_
  rintro P ⟨N, hN, rfl⟩
  exact hN

/-- The sheaf of ideals generated by the evaluation ideals contains the evaluation ideal of the
section over every affine étale chart. -/
theorem sectionEvaluationIdealAt_le_sectionEvaluationIdeal_obj (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1) :
    sectionEvaluationIdealAt B S hS X L s U ≤
      (sectionEvaluationIdeal B S hS X L s).obj (op U) :=
  (sectionEvaluationIdealAt_le_sectionEvaluationSubmodule_obj B S hS X L s U hU).trans
    (sectionEvaluationSubmodule_le_sectionEvaluationIdeal B S hS X L s (op U))

/-- **Minimality.**  Every sheaf of ideals of `𝒪_X` containing the evaluation ideal of the
section over each affine étale chart contains the sheaf of ideals those generate. -/
theorem sectionEvaluationIdeal_le (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)
    (hN : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      sectionEvaluationIdealAt B S hS X L s U ≤ N.obj (op U)) :
    sectionEvaluationIdeal B S hS X L s ≤ N := by
  refine sInf_le (show sectionEvaluationSubmodule B S hS X L s ≤ N.toSubmodule from
    fun W => iSup_le fun U => iSup_le fun hU => iSup_le fun f => ?_)
  exact Ideal.map_le_iff_le_comap.2 fun x hx => N.map_mem f.op (hN U hU hx)

/-- **The sheaf of ideals of Stacks 0845 is the only candidate.**  A sheaf of ideals of `𝒪_X`
whose sections over every affine étale chart are the evaluation ideal of the section is
`AlgebraicGeometry.Space.sectionEvaluationIdeal`.

So nothing is lost by working with that one object: the affine charts determine a sheaf of
ideals, and a sheaf of ideals with the prescribed affine sections is unique. -/
theorem eq_sectionEvaluationIdeal_of_forall_isAffine (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)
    (hN : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      N.obj (op U) = sectionEvaluationIdealAt B S hS X L s U) :
    N = sectionEvaluationIdeal B S hS X L s :=
  le_antisymm
    (structureSubmodule_le_of_forall_isAffine B S hS X N _ fun A hA =>
      (hN A hA).le.trans (sectionEvaluationIdealAt_le_sectionEvaluationIdeal_obj
        B S hS X L s A hA))
    (sectionEvaluationIdeal_le B S hS X L s N fun U hU => (hN U hU).ge)

/-! ### Stacks 0846 reduced to the sheaf of ideals -/

/-- **Stacks 0846 reduced to two statements about the sheaf of ideals of Stacks 0845.**  If the
sheaf of ideals generated by the evaluation ideals is quasi-coherent and its sections over every
affine étale chart are the evaluation ideals, then some closed subspace of `X` has the evaluation
ideal of the section as its defining ideal on every affine étale chart.

That conclusion is the hypothesis carried by every assertion of
`StacksFrontier/AlgebraicGeometry/Spaces/ZeroSchemeProperties.lean`, so the two hypotheses here are
all that separates those assertions from Stacks 0846.  Neither is available; see the
implementation notes. -/
theorem exists_definingIdealAt_eq_sectionEvaluationIdealAt (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hqc : (sectionEvaluationIdeal B S hS X L s).toSheafOfModules.IsQuasicoherentOnSite)
    (haff : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      (sectionEvaluationIdeal B S hS X L s).obj (op U) =
        sectionEvaluationIdealAt B S hS X L s U) :
    ∃ Z : ClosedSubspaces B S hS X.1, ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U := by
  obtain ⟨Z, hZ⟩ := exists_definingIdealAt_eq_of_isQuasicoherentOnSite B S hS X
    (sectionEvaluationIdeal B S hS X L s) hqc
  exact ⟨Z, fun U hU => (hZ (op U)).trans (haff U hU)⟩

/-- **The zero scheme is cut out by the evaluation ideal, granted the two statements about the
sheaf of ideals of Stacks 0845.**  Under the hypotheses of
`AlgebraicGeometry.Space.exists_definingIdealAt_eq_sectionEvaluationIdealAt` the zero scheme of
the section is the closed subspace that sheaf of ideals defines. -/
theorem exists_zeroSchemeSubfunctor_eq_sectionEvaluationIdeal (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (hqc : (sectionEvaluationIdeal B S hS X L s).toSheafOfModules.IsQuasicoherentOnSite)
    (haff : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      (sectionEvaluationIdeal B S hS X L s).obj (op U) =
        sectionEvaluationIdealAt B S hS X L s U) :
    ∃ Z : ClosedSubspaces B S hS X.1, zeroSchemeSubfunctor B S hS X L s = Z.1 ∧
      ∀ U : SmallEtale B S hS X.1,
        IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
        definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U := by
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt B S hS X L s hqc haff
  exact ⟨Z, zeroSchemeSubfunctor_eq B S hS X L s Z hZ, hZ⟩

end AlgebraicGeometry.Space

end
