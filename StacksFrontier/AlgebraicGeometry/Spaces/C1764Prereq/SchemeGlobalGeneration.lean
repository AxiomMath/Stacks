module

public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.GlobalGenerationComparison
public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.GlobalTypesComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSchemeRestrictionQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSchemeModuleSections
public import StacksFrontier.AlgebraicGeometry.Spaces.Perfect.DerivedFibreEulerLocallyConstant
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeAmple
public import StacksFrontier.AlgebraicGeometry.Spaces.StructureSheafChartRestriction
public import StacksFrontier.AlgebraicGeometry.Spaces.Decent.ElementaryEtaleNeighborhood
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ModuleTypesUnderIso
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GlobalTypesUnderComparison
public import StacksFrontier.AlgebraicGeometry.CoherentTFAE.Affine

/-!
# Global generation of modules on schemes of the site, read on the small étale site

Let `V` be a scheme of the big fppf site and `M` a quasi-coherent module on the small étale site
of the algebraic space `V` represents. Then `M` is generated by global sections exactly when its
reading `M|_V` on the Zariski site of `V` (the chart restriction at the identity chart) is.

Moreover, a quasi-coherent module on an affine spectrum, hence on the spectrum of a residue field,
is generated by global sections; pullback preserves global generation (Stacks 03DF); and the
counit `g^*g_*M ⟶ M` is surjective when `M` is generated by global sections.

## Main results

* `C1764Prereq.isGeneratedByGlobalSections_iff_restrictToChartScheme`: global generation of `M`
  is that of `M|_V`.
* `C1764Prereq.isGeneratedByGlobalSections_of_isQuasicoherent_spec`: a quasi-coherent module on
  an affine spectrum is generated by global sections.
* `C1764Prereq.isGeneratedByGlobalSections_of_isQuasicoherentOnSite_residueFieldObject`: the
  same on the spectrum of a residue field, read on the small étale site.
* `C1764Prereq.isGeneratedByGlobalSections_modulePullback`: pullback preserves global
  generation.
* `C1764Prereq.epi_counit_of_isGeneratedByGlobalSections`: the counit `g^*g_*M ⟶ M` is an
  epimorphism when `M` is generated by global sections.

## References

* [Stacks Project, Tag 05VG](https://stacks.math.columbia.edu/tag/05VG)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 03DF](https://stacks.math.columbia.edu/tag/03DF)
* [Stacks Project, Tag 0E6Y](https://stacks.math.columbia.edu/tag/0E6Y)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.C1764Prereq

open Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- Global generation is invariant under isomorphism of sheaves of modules. -/
theorem isGeneratedByGlobalSections_iff_of_iso {C : Type*} [Category C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}} [HasWeakSheafify J AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}] {F G : SheafOfModules.{u} R} (e : F ≅ G) :
    F.IsGeneratedByGlobalSections ↔ G.IsGeneratedByGlobalSections :=
  ⟨Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso e,
    Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso e.symm⟩

/-- Global generation is carried both ways by the equivalence between modules on the small étale
site of a scheme `V` and modules on the small étale site of the algebraic space `V` represents. -/
theorem isGeneratedByGlobalSections_representedSmallEtaleModuleEquivalence_iff
    (V : BigFppfOver B S hS)
    (G : SheafOfModules.{u} (representedSchemeStructureSheaf B S hS V)) :
    ((representedSmallEtaleModuleEquivalence B S hS V).functor.obj G).IsGeneratedByGlobalSections ↔
      G.IsGeneratedByGlobalSections := by
  have : PreservesColimitsOfSize.{u, u}
      (representedSmallEtaleModuleEquivalence B S hS V).functor :=
    (representedSmallEtaleModuleEquivalence B S hS V).toAdjunction.leftAdjoint_preservesColimits
  exact (Stacks.Sheaves.GlobalTypeComparison.isGeneratedByGlobalSections_iff _
    (representedSmallEtaleModuleEquivalenceFunctorUnitIso B S hS V) G).symm

/-- The reading of a quasi-coherent module on the algebraic space represented by `V` on the
small étale site of the scheme `V`, carried back by the equivalence of small étale sites, is the
module itself. -/
def representedChartSchemeEtaleModuleIso (V : BigFppfOver B S hS)
    (M : Space.Modules.{u, u} B S hS (yoneda.obj V) (isAlgebraicSpace_yoneda B S hS V))
    (hM : M.IsQuasicoherentOnSite) :
    (representedSmallEtaleModuleEquivalence B S hS V).functor.obj
        (chartSchemeEtaleModule B S hS (schemeSpace V) M hM (idEtaleChart B S hS V)) ≅ M := by
  refine (ObjectProperty.ι _).mapIso ((representedQuasicoherentEquivalence B S hS V).counitIso.app
      (chartSmallEtaleQcoh B S hS (schemeSpace V) M hM (idEtaleChart B S hS V))) ≪≫
    (chartModuleRestrictionIsoChartSmallEtaleRestriction B S hS (schemeSpace V) M
      (idEtaleChart B S hS V)).symm ≪≫ ?_
  change (modulePullback B S hS (chartToSpace B S hS (schemeSpace V)
      (idEtaleChart B S hS V))).obj M ≅ M
  rw [show chartToSpace B S hS (schemeSpace V) (idEtaleChart B S hS V) = 𝟙 (schemeSpace V) from
    ObjectProperty.hom_ext _ rfl]
  exact (modulePullbackIdIso B S hS (schemeSpace V)).app M

/-- **Global generation of a quasi-coherent module on a scheme, on the small étale site and on
the Zariski site.** A quasi-coherent module `M` on the small étale site of the algebraic space
represented by a scheme `V` is generated by global sections exactly when its reading on the
Zariski site of `V` is (Stacks 05VG, through Stacks 03DX). -/
theorem isGeneratedByGlobalSections_iff_restrictToChartScheme (V : BigFppfOver B S hS)
    (M : Space.Modules.{u, u} B S hS (yoneda.obj V) (isAlgebraicSpace_yoneda B S hS V))
    (hM : M.IsQuasicoherentOnSite) :
    M.IsGeneratedByGlobalSections ↔
      (restrictToChartScheme B S hS (yoneda.obj V) (isAlgebraicSpace_yoneda B S hS V) M
        (idEtaleChart B S hS V)).IsGeneratedByGlobalSections := by
  have e₁ := restrictToChartSchemeIsoRestrictModule B S hS (schemeSpace V) M hM
      (idEtaleChart B S hS V) ≪≫
    (chartSchemeModuleIsoRestrictModule B S hS (schemeSpace V) M hM (idEtaleChart B S hS V)).symm
  have h₂ := _root_.AlgebraicGeometry.SmallEtale.isGeneratedByGlobalSections_iff_associatedModule
    (associatedBigEtaleSite B) (chartScheme (idEtaleChart B S hS V)) V.left.property
    (chartSchemeQcoh B S hS (schemeSpace V) M hM (idEtaleChart B S hS V))
  have e₃ := associatedModuleChartSchemeModuleIso B S hS (schemeSpace V) M hM
    (idEtaleChart B S hS V)
  have h₄ := isGeneratedByGlobalSections_representedSmallEtaleModuleEquivalence_iff V
    (chartSchemeEtaleModule B S hS (schemeSpace V) M hM (idEtaleChart B S hS V))
  have e₅ := representedChartSchemeEtaleModuleIso V M hM
  exact (isGeneratedByGlobalSections_iff_of_iso e₅).symm.trans (h₄.trans
    ((isGeneratedByGlobalSections_iff_of_iso e₃).symm.trans
      (h₂.symm.trans (isGeneratedByGlobalSections_iff_of_iso e₁).symm)))

/-- **A quasi-coherent module on an affine spectrum is generated by global sections.** -/
theorem isGeneratedByGlobalSections_of_isQuasicoherent_spec {R : CommRingCat.{u}}
    (M : (Spec R).Modules) [M.IsQuasicoherent] : M.IsGeneratedByGlobalSections :=
  Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso
    (@asIso _ _ _ _ M.fromTildeΓ (Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent M))
    ⟨Stacks.AlgebraicGeometry.CoherentTFAE.tildeGeneratingSections _ id (by simp)⟩

/-- **A quasi-coherent module on the spectrum of a residue field is generated by global
sections**, on the small étale site of the algebraic space it represents. -/
theorem isGeneratedByGlobalSections_of_isQuasicoherentOnSite_residueFieldObject
    (T : BigFppfOver B S hS) (t : (BigFppfOver.toScheme B S hS).obj T)
    (N : Space.Modules.{u, u} B S hS (yoneda.obj (residueFieldObject B S hS T t
      (B.residueField_spec_contains T.left.property t))) (isAlgebraicSpace_yoneda B S hS _))
    (hN : N.IsQuasicoherentOnSite) : N.IsGeneratedByGlobalSections :=
  (isGeneratedByGlobalSections_iff_restrictToChartScheme _ N hN).2
    (@isGeneratedByGlobalSections_of_isQuasicoherent_spec
      (.of (((BigFppfOver.toScheme B S hS).obj T).residueField t)) _
      (isQuasicoherent_restrictToChartScheme B S hS (schemeSpace _) N hN
        (idEtaleChart B S hS (residueFieldObject B S hS T t
          (B.residueField_spec_contains T.left.property t)))))

/-- **The pullback of a module generated by global sections is generated by global sections**
(Stacks 03DF), along a morphism of algebraic spaces. -/
theorem isGeneratedByGlobalSections_modulePullback {X Y : AlgebraicSpaces B S hS} (g : X ⟶ Y)
    {F : Space.Modules.{u, u} B S hS Y.1 Y.2} (hF : F.IsGeneratedByGlobalSections) :
    ((modulePullback B S hS g).obj F).IsGeneratedByGlobalSections := by
  have : PreservesColimitsOfSize.{u, u} (modulePullback B S hS g) :=
    (modulePullbackAdjunction B S hS g).leftAdjoint_preservesColimits
  exact ⟨Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap (modulePullback B S hS g)
    (modulePullbackUnitIso B S hS g) hF.some⟩

/-- The counit of an adjunction is an epimorphism at an object which receives an epimorphism from
an object in the image of the left adjoint. -/
theorem epi_counit_app_of_epi {C D : Type*} [Category* C] [Category* D] {F : C ⥤ D} {G : D ⥤ C}
    (adj : F ⊣ G) {A : C} {M : D} (p : F.obj A ⟶ M) [Epi p] : Epi (adj.counit.app M) := by
  have hfac : F.map (adj.homEquiv _ _ p) ≫ adj.counit.app M = p := by
    simp [Adjunction.homEquiv_unit]
  exact epi_of_epi_fac hfac

/-- **The counit `g^*g_*M ⟶ M` is surjective when `M` is generated by global sections.** -/
theorem epi_counit_of_isGeneratedByGlobalSections {X Y : AlgebraicSpaces B S hS} (g : X ⟶ Y)
    {M : Space.Modules.{u, u} B S hS X.1 X.2} (hM : M.IsGeneratedByGlobalSections) :
    Epi ((modulePullbackAdjunction B S hS g).counit.app M) := by
  have : PreservesColimitsOfSize.{u, u} (modulePullback B S hS g) :=
    (modulePullbackAdjunction B S hS g).leftAdjoint_preservesColimits
  let σ := hM.some
  let e := Stacks.Sheaves.QcohTypeComparison.mapFreeIso.{u} (modulePullback B S hS g)
      (modulePullbackUnitIso B S hS g) σ.I
  exact @epi_counit_app_of_epi _ _ _ _ _ _ (modulePullbackAdjunction B S hS g) _ _ _
    (@epi_comp _ _ _ _ _ e.hom (IsIso.epi_of_iso _) σ.π σ.epi)

end AlgebraicGeometry.C1764Prereq
