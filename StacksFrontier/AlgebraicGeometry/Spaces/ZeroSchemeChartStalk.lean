module

public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartZeroSchemeComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.EffectiveCartierDivisorSum
public import StacksFrontier.AlgebraicGeometry.Spaces.ZeroSchemeAssertionsInvertible

/-!
# The local equation of a zero scheme in a local ring of an étale chart

Let `X` be an algebraic space over a scheme `S` contained in a big fppf site `B`, let `L` be an
invertible `𝒪_X`-module and let `s` be a global section of `L`.  Stacks 0846, part (4), read
chartwise, says that on an affine étale chart `U` over which `L` is free of rank one with
generator `t` and coordinate functional `l₀`, the *defining ideal* of the zero scheme `Z(s)` at
`U` is generated by the single regular function `l₀(s|_U)`
(`AlgebraicGeometry.Space.definingIdealAt_zeroScheme_eq_span_generator_of_isInvertible`).

That is a statement about an ideal of `Γ(U, ⊤)`.  The multiplicity theory of chapter 42 instead
consumes a local equation in the form of a generator of the stalk of a *quasi-coherent ideal
sheaf* — this is the hypothesis `hZt` of `Stacks.Chow.ord_eq_componentMultiplicity`.  This file
converts between the two: the quasi-coherent ideal sheaf on the chart scheme cut out by `Z(s)`
is `AlgebraicGeometry.Space.chartKer`, and its stalk at a point `v` of the chart is generated by
the germ of `l₀(s|_U)` at `v`.

## Main results

* `AlgebraicGeometry.Space.stalk_chartKer_zeroScheme_eq_span_germ`: the stalk at `v` of the
  chart ideal sheaf of `Z(s)` is generated by the germ at `v` of `l₀(s|_U)`.

## Implementation notes

The chart data `t`, `l₀`, `hb` is local freeness of rank one of `L` on `U`, carried exactly as
`AlgebraicGeometry.Space.definingIdealAt_zeroScheme_eq_span_generator_of_isInvertible` carries
it; it is what makes the conclusion a statement about one regular function.  Affineness of the
chart is needed twice: once so that the chart ideal sheaf is determined by its ideal of global
sections (`AlgebraicGeometry.Space.ker_chartBaseChangeHom`), and once so that `⊤` is an affine
open on which `AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ` may be read.

## References

* [Stacks Project, Tag 0845](https://stacks.math.columbia.edu/tag/0845)
* [Stacks Project, Tag 0846](https://stacks.math.columbia.edu/tag/0846)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The local equation of a zero scheme in a local ring of an étale chart.**  Let `L` be an
invertible `𝒪_X`-module, `s` a global section of `L`, and `U` an affine étale chart of `X` on
which `L` is free of rank one with generator `t` and coordinate functional `l₀`.  Then at every
point `v` of the chart scheme the stalk of the quasi-coherent ideal sheaf cutting out the base
change of the zero scheme `Z(s)` to `U` is the principal ideal generated by the germ of the
regular function `l₀(s|_U)` at `v`.

This is Stacks 0846, part (4), read chartwise
(`AlgebraicGeometry.Space.definingIdealAt_zeroScheme_eq_span_generator_of_isInvertible`), carried
from the ideal of global sections of the chart to the local rings: on an affine chart the chart
ideal sheaf is the one induced by the defining ideal at that chart
(`AlgebraicGeometry.Space.ker_chartBaseChangeHom`), and the stalk of an induced ideal sheaf is
the image of the ideal under the germ map
(`AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ`).

It is the form in which `Stacks.Chow.ord_eq_componentMultiplicity` consumes a local equation. -/
theorem stalk_chartKer_zeroScheme_eq_span_germ (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (s : L.sections) (U : SmallEtale B S hS X.1) [IsAffine (chartScheme U)]
    (t : ToType (L.val.obj (op U)))
    (l₀ : Module.Dual ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U))
      (L.val.obj (op U)))
    (hb : ∀ x, l₀ x • t = x) (v : chartScheme U) :
    AlgebraicGeometry.IdealSheafData.stalk
        (chartKer B S hS X (zeroScheme B S hS X L s) U.obj.hom) v =
      Ideal.span {((chartScheme U).presheaf.germ ⊤ v trivial).hom (l₀ (s.eval (op U)))} := by
  have hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U) :=
    inferInstanceAs (IsAffine (chartScheme U))
  have hker : chartKer B S hS X (zeroScheme B S hS X L s) U.obj.hom =
      Scheme.IdealSheafData.ofIdealTop
        (definingIdealAt B S hS X (zeroScheme B S hS X L s) (op U)) :=
    ker_chartBaseChangeHom B S hS X (zeroScheme B S hS X L s) U hU
  have htop : (Scheme.IdealSheafData.ofIdealTop
        (definingIdealAt B S hS X (zeroScheme B S hS X L s) (op U))).ideal
      ⟨⊤, isAffineOpen_top (chartScheme U)⟩ =
      definingIdealAt B S hS X (zeroScheme B S hS X L s) (op U) := by
    simp only [Functor.op_obj, Functor.comp_obj, ObjectProperty.ι_obj, CostructuredArrow.proj_obj,
      Over.forget_obj, Scheme.IdealSheafData.ofIdealTop, homOfLE_leOfHom,
      Scheme.IdealSheafData.mkOfMemSupportIff_ideal, homOfLE_refl, op_id,
      CategoryTheory.Functor.map_id, CommRingCat.hom_id]
    exact Ideal.map_id _
  rw [hker, AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ _
      ⟨⊤, isAffineOpen_top (chartScheme U)⟩ trivial, htop,
    definingIdealAt_zeroScheme_eq_span_generator_of_isInvertible B S hS X L hinv s U hU t l₀ hb]
  exact (Ideal.map_span ((chartScheme U).presheaf.germ ⊤ v trivial).hom
    {l₀ (s.eval (op U))}).trans (by rw [Set.image_singleton]; rfl)

end AlgebraicGeometry.Space

end
