module

public import StacksFrontier.AlgebraicGeometry.Spaces.SubspacePreimage
public import StacksFrontier.CategoryTheory.Sites.Stackification.ExtensionFullyFaithful
public import StacksFrontier.CategoryTheory.Sites.SubfunctorSheafifyPreimage

/-!
# When the image subsheaf of a composite is a fibre product

Let `q : A ⟶ F'` and `p : F' ⟶ F` be morphisms of sheaves of types on a site, with `q` a
monomorphism, and let `Im(q ≫ p) ⊆ F` be the image subsheaf of the composite — the subsheaf
generated by the image presheaf, `CategoryTheory.Sheaf.image`. The square

```
A  --- q --->  F'
|              |
|              p
v              v
Im(q ≫ p) -->  F
```

commutes by construction. It is *cartesian* exactly when `q` detects the local membership
which defines the image subsheaf: whenever a section `y` of `F'` has `p y` locally in the image
of `q ≫ p`, the section `y` must itself be locally in the image of `q`. That is the hypothesis
`hloc` below, stated as an inclusion of the two sieves of local membership.

## Main results

* `CategoryTheory.Sheaf.isPullback_toImage_of_sieveOfSection_le`: the criterion described above.
-/

@[expose] public section

open Opposite CategoryTheory CategoryTheory.Limits

universe w v u

namespace CategoryTheory.Sheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

/-- Let `q : A ⟶ F'` be a monomorphism of sheaves of types and `p : F' ⟶ F` any morphism of
sheaves. If every section of `F'` whose image under `p` lies locally in the image of `q ≫ p` lies
itself locally in the image of `q`, then the canonical square relating `q`, `p` and the image
subsheaf of `q ≫ p` is cartesian. -/
theorem isPullback_toImage_of_sieveOfSection_le {A F' F : Sheaf J (Type w)}
    (q : A ⟶ F') (p : F' ⟶ F) (hq : Mono q.hom)
    (hloc : ∀ (U : C) (y : F'.obj.obj (op U)),
      (Subfunctor.range (q ≫ p).hom).sieveOfSection (p.hom.app (op U) y) ≤
        (Subfunctor.range q.hom).sieveOfSection y) :
    IsPullback q.hom (Sheaf.toImage (q ≫ p)).hom p.hom (Sheaf.imageι (q ≫ p)).hom := by
  classical
  have hFs : Presieve.IsSheaf J F.obj := (isSheaf_iff_isSheaf_of_type J F.obj).mp F.property
  have hF's : Presieve.IsSheaf J F'.obj := (isSheaf_iff_isSheaf_of_type J F'.obj).mp F'.property
  have hGs : Presieve.IsSheaf J ((Subfunctor.range (q ≫ p).hom).sheafify J).toFunctor :=
    (Subfunctor.range (q ≫ p).hom).sheafify_isSheaf hFs
  have hPs : Presheaf.IsSheaf J
      (((Subfunctor.range (q ≫ p).hom).sheafify J).preimage p.hom).toFunctor :=
    (isSheaf_iff_isSheaf_of_type J _).2
      (Subfunctor.isSheaf_preimage _ p.hom hFs hF's hGs)
  have hsq : IsPullback (((Subfunctor.range (q ≫ p).hom).sheafify J).preimage p.hom).ι
      (((Subfunctor.range (q ≫ p).hom).sheafify J).fromPreimage p.hom) p.hom
      ((Subfunctor.range (q ≫ p).hom).sheafify J).ι :=
    (Subfunctor.isPullback_preimage p.hom _).flip
  have hle : Subfunctor.range q.hom ≤
      ((Subfunctor.range (q ≫ p).hom).sheafify J).preimage p.hom := by
    rintro U _ ⟨x, rfl⟩
    exact Subfunctor.le_sheafify (J := J) (G := Subfunctor.range (q ≫ p).hom) U ⟨x, by simp⟩
  have hkmono : Mono (Subfunctor.lift q.hom hle) := by
    have : Mono (Subfunctor.lift q.hom hle ≫
        (((Subfunctor.range (q ≫ p).hom).sheafify J).preimage p.hom).ι) := by
      rwa [Subfunctor.lift_ι]
    exact mono_of_mono (Subfunctor.lift q.hom hle)
      (((Subfunctor.range (q ≫ p).hom).sheafify J).preimage p.hom).ι
  have hkinj : Presheaf.IsLocallyInjective J (Subfunctor.lift q.hom hle) :=
    Presheaf.isLocallyInjective_of_injective J _
      (fun U ↦ (mono_iff_injective _).1 ((NatTrans.mono_iff_mono_app _).1 hkmono U))
  have hksurj : Presheaf.IsLocallySurjective J (Subfunctor.lift q.hom hle) :=
    ⟨fun {U} s ↦ J.superset_covering (by rintro _ _ ⟨x, hx⟩; exact ⟨x, Subtype.ext hx⟩)
      (J.superset_covering (hloc U s.1) s.2)⟩
  have hkiso : IsIso (Subfunctor.lift q.hom hle) :=
    Presheaf.isIso_of_isLocallyBijective J _ A.property hPs
  have hleg : (Sheaf.toImage (q ≫ p)).hom = Subfunctor.lift q.hom hle ≫
      ((Subfunctor.range (q ≫ p).hom).sheafify J).fromPreimage p.hom := by
    refine (cancel_mono ((Subfunctor.range (q ≫ p).hom).sheafify J).ι).1 ?_
    have h1 : (Sheaf.toImage (q ≫ p)).hom ≫
        ((Subfunctor.range (q ≫ p).hom).sheafify J).ι = (q ≫ p).hom :=
      congrArg (fun k : A ⟶ F => k.hom) (Sheaf.toImage_ι (q ≫ p))
    refine h1.trans ?_
    rw [Category.assoc, Subfunctor.fromPreimage_ι, ← Category.assoc, Subfunctor.lift_ι]
    rfl
  rw [hleg]
  refine hsq.of_iso' (asIso (Subfunctor.lift q.hom hle)) (Iso.refl _) (Iso.refl _) (Iso.refl _)
    ?_ ?_ ?_ ?_
  · rw [asIso_hom, Subfunctor.lift_ι, Iso.refl_hom, Category.comp_id]
  · exact (Category.comp_id _).symm
  all_goals exact (Category.id_comp _).trans (Category.comp_id _).symm

end CategoryTheory.Sheaf

end
