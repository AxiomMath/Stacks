module

public import Mathlib.CategoryTheory.Sites.Over
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.SpacesEtaleSite
public import StacksFrontier.CategoryTheory.Sites.Glueing.GlueingSheaves

/-!
# Étale localization of the spaces-étale site

If `f : X ⟶ Y` is an étale morphism of algebraic spaces, the spaces-étale site of `X` is
canonically the localization of the spaces-étale site of `Y` at the object `f`: an algebraic
space étale over `X` is the same thing as an algebraic space étale over `Y` together with a
morphism to `X` over `Y`, and the two topologies correspond.

## Main definitions

* `AlgebraicGeometry.Space.etaleObject` regards an étale morphism to `Y` as an object of the
  spaces-étale site of `Y`.
* `AlgebraicGeometry.Space.localizationForward` and
  `AlgebraicGeometry.Space.localizationBackward` are the two functors of the comparison.
* `AlgebraicGeometry.Space.spacesEtaleLocalization` is the resulting equivalence of
  categories.
* `AlgebraicGeometry.Space.SpacesEtale.SievePointwiseCover` is pointwise surjectivity of a
  sieve of the spaces-étale site.
* `AlgebraicGeometry.Space.SpacesEtale.toFinal` is the structure morphism of an object of the
  spaces-étale site, read as a morphism to the final object, and
  `AlgebraicGeometry.Space.SpacesEtale.finalHypercover` the zero-hypercover of the final object
  presented by a family of such objects.
* `AlgebraicGeometry.Space.SpacesEtale.sliceToSmall` and
  `AlgebraicGeometry.Space.SpacesEtale.smallToSlice` are the two functors comparing the slice
  of the spaces-étale site of `X` at an object `U` with the spaces-étale site of `U`, and
  `AlgebraicGeometry.Space.SpacesEtale.sliceEquivSmall` is the resulting equivalence. They
  move the structure morphism between two slots and so are strictly compatible with the
  underlying algebraic spaces, which is what the comparison of the two topologies needs.

## Main results

* `AlgebraicGeometry.Space.spacesEtaleLocalization_forget` identifies the equivalence with
  composition of morphisms to `Y`, and
  `AlgebraicGeometry.Space.spacesEtaleLocalization_slice` identifies the slice arrow over
  `X`, which together pin the equivalence down.
* `AlgebraicGeometry.Space.spacesEtaleLocalization_isContinuous` and
  `AlgebraicGeometry.Space.spacesEtaleLocalization_inverse_isContinuous` identify the
  Grothendieck topologies of the two sides.
* `AlgebraicGeometry.Space.SpacesEtale.mem_topology_iff_sievePointwiseCover` characterizes
  the covering sieves of the spaces-étale site as the pointwise surjective ones; it is what
  transports the topology across the equivalence.
* `AlgebraicGeometry.Space.SpacesEtale.ofArrows_toFinal_mem_topology`: a family of objects of
  the spaces-étale site of `X` whose structure morphisms are jointly surjective on points
  generates a covering sieve of the final object, and
  `AlgebraicGeometry.Space.SpacesEtale.isEquivalence_toDescentData_spacesEtale` is **Stacks
  04TS** at that covering: sheaves on the slice at the final object are descent data for the
  family.

## Implementation notes

The equality of sites of the source is rendered as an equivalence of categories together
with its compatibility with both slice projections and with the induced topology on the
slice; the slice topology is Mathlib's `CategoryTheory.GrothendieckTopology.over`.

Covering sieves are compared pointwise rather than through covering families, because the
covering predicate of the spaces-étale site is joint surjectivity on points and a sieve
generated by such a family is again pointwise surjective. The saturation of the presented
precoverage is therefore already a sieve-level condition, which is the content of
`AlgebraicGeometry.Space.SpacesEtale.mem_topology_iff_sievePointwiseCover`.

## References

* [Stacks Project, Tag 04LY](https://stacks.math.columbia.edu/tag/04LY)
* [Stacks Project, Tag 04TS](https://stacks.math.columbia.edu/tag/04TS)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

namespace SpacesEtale

/-- A sieve of the spaces-étale site of `X` is *pointwise surjective* when every point of its
target is the image of a point of some object in the sieve. -/
def SievePointwiseCover (X : AlgebraicSpaces B S hS) {U : SpacesEtale B S hS X}
    (R : Sieve U) : Prop :=
  ∀ x : points B S hS ((toSpaces B S hS X).obj U).1,
    ∃ (V : SpacesEtale B S hS X) (f : V ⟶ U), R f ∧
      ∃ y : points B S hS ((toSpaces B S hS X).obj V).1,
        pointsMap B S hS ((toSpaces B S hS X).obj V).1
          ((toSpaces B S hS X).map f).hom y = x

/-- The covering family presented by all the arrows of a sieve. -/
noncomputable def sieveCoverFamily (X : AlgebraicSpaces B S hS)
    {U : SpacesEtale B S hS X} (R : Sieve U) : PreZeroHypercover.{u + 1} U :=
  R.arrows.preZeroHypercover

/-- A pointwise surjective sieve presents a covering family of the spaces-étale site. -/
theorem isCovering_of_sievePointwiseCover (X : AlgebraicSpaces B S hS)
    {U : SpacesEtale B S hS X} (R : Sieve U)
    (hR : SievePointwiseCover B S hS X R) :
    IsCovering B S hS X ⟨U, sieveCoverFamily B S hS X R⟩ := by
  intro x
  obtain ⟨V, f, hf, y, hy⟩ := hR x
  refine ⟨⟨⟨V, f⟩, hf⟩, y, ?_⟩
  simpa [sieveCoverFamily, toSpaces, inclusion, Presieve.preZeroHypercover] using hy

/-- A sieve of the spaces-étale site of `X` is a covering sieve exactly when it is pointwise
surjective. -/
theorem mem_topology_iff_sievePointwiseCover (X : AlgebraicSpaces B S hS)
    {U : SpacesEtale B S hS X} (R : Sieve U) :
    R ∈ topology B S hS X U ↔ SievePointwiseCover B S hS X R := by
  rw [topology, Precoverage.mem_toGrothendieck_iff]
  constructor
  · intro hR
    induction hR with
    | of U T hT =>
      rcases (mem_precoverage_iff (B := B) (S := S) (hS := hS) (X := X)).1 hT with ⟨E, rfl, hE⟩
      intro x
      obtain ⟨i, y, hy⟩ := hE x
      refine ⟨E.X i, E.f i,
        Sieve.le_generate E.presieve₀ (E.X i) (E.f i) (PreZeroHypercover.presieve₀_f E i),
        y, ?_⟩
      simpa using hy
    | top U =>
      intro x
      exact ⟨U, 𝟙 U, by simp, x, congrFun (pointsMap_id B S hS ((toSpaces B S hS X).obj U).1) x⟩
    | @pullback U T hT V f hTpoint =>
      intro x
      obtain ⟨P, p₁, p₂, hpb, hcov⟩ := (isSite B S hS X).2.2 ⟨U, sieveCoverFamily B S hS X T⟩
        (isCovering_of_sievePointwiseCover B S hS X T hTpoint) V f
      obtain ⟨i, y, hy⟩ := hcov x
      refine ⟨P i, p₂ i, ?_, y, ?_⟩
      · change T (p₂ i ≫ f)
        rw [← (hpb i).w]
        exact T.downward_closed
          (by change T.arrows ((T.arrows.preZeroHypercover).f i); exact i.2) (p₁ i)
      · simpa [toSpaces] using hy
    | @transitive U T R hT hTR hTpoint hRpoint =>
      intro x
      obtain ⟨V, f, hf, y, hy⟩ := hTpoint x
      obtain ⟨W, g, hg, z, hz⟩ := hRpoint hf y
      change R (g ≫ f) at hg
      refine ⟨W, g ≫ f, hg, z, ?_⟩
      change pointsMap B S hS ((toSpaces B S hS X).obj W).1
          (((toSpaces B S hS X).map g).hom ≫ ((toSpaces B S hS X).map f).hom) z = x
      rw [pointsMap_comp, Function.comp_apply, hz, hy]
  · intro hR
    have hmem : R.arrows ∈ precoverage B S hS X U := by
      simpa [sieveCoverFamily] using
        (mem_precoverage_iff (B := B) (S := S) (hS := hS) (X := X)).2
          ⟨sieveCoverFamily B S hS X R, rfl, isCovering_of_sievePointwiseCover B S hS X R hR⟩
    rw [← Sieve.generate_sieve R]
    exact Precoverage.Saturate.of _ _ hmem

/-! ### Covering families of the final object -/

/-- The structure morphism of an object of the spaces-étale site of `X`, read as a morphism to
the final object. -/
noncomputable def toFinal {X : AlgebraicSpaces B S hS} (U : SpacesEtale B S hS X) :
    U ⟶ final B S hS X :=
  ObjectProperty.homMk (Over.homMk (V := (final B S hS X).obj) U.obj.hom
    (Category.comp_id _))

/-- The image of `toFinal U` under the forgetful functor to algebraic spaces is the structure
morphism of `U`. -/
@[simp]
theorem toSpaces_map_toFinal {X : AlgebraicSpaces B S hS} (U : SpacesEtale B S hS X) :
    (toSpaces B S hS X).map (toFinal B S hS U) = U.obj.hom := rfl

/-- The zero-hypercover of the final object presented by a family of objects of the
spaces-étale site of `X`. -/
noncomputable def finalHypercover {X : AlgebraicSpaces B S hS} {I : Type (u + 1)}
    (U : I → SpacesEtale B S hS X) : PreZeroHypercover.{u + 1} (final B S hS X) where
  I₀ := I
  X := U
  f := fun i ↦ toFinal B S hS (U i)

/-- A family of objects of the spaces-étale site of `X` whose structure morphisms are jointly
surjective on points generates a covering sieve of the final object. -/
theorem ofArrows_toFinal_mem_topology {X : AlgebraicSpaces B S hS} {I : Type (u + 1)}
    (U : I → SpacesEtale B S hS X)
    (hsurj : (⋃ i, Set.range (pointsMap B S hS ((U i).obj.left).1 ((U i).obj.hom).hom))
      = Set.univ) :
    Sieve.ofArrows U (fun i ↦ toFinal B S hS (U i))
      ∈ topology B S hS X (final B S hS X) := by
  have hE : IsCovering B S hS X ⟨final B S hS X, finalHypercover B S hS U⟩ := by
    intro x
    obtain ⟨i, y, hy⟩ := Set.mem_iUnion.1 (Set.eq_univ_iff_forall.1 hsurj x)
    exact ⟨i, y, hy⟩
  exact Precoverage.generate_mem_toGrothendieck
    ((mem_precoverage_iff (B := B) (S := S) (hS := hS) (X := X)).2
      ⟨finalHypercover B S hS U, rfl, hE⟩)

/-- **Stacks 04TS at the spaces-étale site of `X`, at its final object.** For a family of
objects of the site whose structure morphisms are jointly surjective on points, sheaves of sets
on the slice at the final object are equivalent to descent data for the family.

This is *not* Stacks 0GFS, which asserts the corresponding statement for sheaves on the small
étale sites of the members; converting it needs the equivalence of sites of
`AlgebraicGeometry.Space.spacesEtaleLocalization` together with a transport of
`CategoryTheory.Pseudofunctor.DescentData` along a fibrewise equivalence of pseudofunctors,
which is not available. -/
theorem isEquivalence_toDescentData_spacesEtale {X : AlgebraicSpaces B S hS}
    {I : Type (u + 1)} (U : I → SpacesEtale B S hS X)
    (hsurj : (⋃ i, Set.range (pointsMap B S hS ((U i).obj.left).1 ((U i).obj.hom).hom))
      = Set.univ) :
    (((topology B S hS X).pseudofunctorOver (Type (u + 1))).toDescentData
      (fun i ↦ toFinal B S hS (U i))).IsEquivalence :=
  GrothendieckTopology.isEquivalence_toDescentData_pseudofunctorOver
    (topology B S hS X) (Type (u + 1)) _
    (ofArrows_toFinal_mem_topology B S hS U hsurj)

section Slice

variable {X : AlgebraicSpaces B S hS}

/-! ### The slice of the spaces-étale site is the spaces-étale site of the slicing object -/

/-- The morphism to `U` carried by an object of the slice of the spaces-étale site of `X` at
`U` is itself étale: it is a factor of the étale structure morphism to `X` through the étale
structure morphism of `U`, so Tag 03FV applies. -/
theorem etale_sliceHom (U : SpacesEtale B S hS X) (W : Over U) :
    etaleMorphisms B S hS (Over.Hom.left W.hom.hom) := by
  refine MorphismProperty.of_postcomp (etaleMorphisms B S hS)
    (W' := etaleMorphisms B S hS) (Over.Hom.left W.hom.hom) U.obj.hom U.property ?_
  rw [Over.w W.hom.hom]
  exact W.left.property

/-- An object of the slice of the spaces-étale site of `X` at `U`, read as an object of the
spaces-étale site of `U`: the same algebraic space, with its morphism to `U` as structure
morphism. -/
noncomputable def sliceToSmallObj (U : SpacesEtale B S hS X) (W : Over U) :
    SpacesEtale B S hS U.obj.left :=
  ⟨Over.mk (Over.Hom.left W.hom.hom), etale_sliceHom B S hS U W⟩

/-- A morphism in the slice of the spaces-étale site of `X` at `U` commutes with the morphisms
to `U`. -/
theorem sliceToSmall_map_w (U : SpacesEtale B S hS X) {W W' : Over U} (k : W ⟶ W') :
    Over.Hom.left (CommaMorphism.left k).hom ≫ Over.Hom.left W'.hom.hom
      = Over.Hom.left W.hom.hom := by
  rw [← Over.comp_left]
  have hk : (CommaMorphism.left k) ≫ W'.hom = W.hom := by simp
  rw [← hk]
  rfl

/-- A morphism in the slice of the spaces-étale site of `X` at `U`, read as a morphism of the
spaces-étale site of `U`. -/
noncomputable def sliceToSmallMap (U : SpacesEtale B S hS X) {W W' : Over U} (k : W ⟶ W') :
    sliceToSmallObj B S hS U W ⟶ sliceToSmallObj B S hS U W' := by
  refine ObjectProperty.homMk ?_
  refine Over.homMk ?_ ?_
  · exact (Over.Hom.left (CommaMorphism.left k).hom :
      W.left.obj.left ⟶ W'.left.obj.left)
  · exact sliceToSmall_map_w B S hS U k

/-- The slice of the spaces-étale site of `X` at `U` maps to the spaces-étale site of `U` by
replacing the structure morphism to `X` with the morphism to `U`. -/
noncomputable def sliceToSmall (U : SpacesEtale B S hS X) :
    Over U ⥤ SpacesEtale B S hS U.obj.left where
  obj W := sliceToSmallObj B S hS U W
  map {W W'} k := sliceToSmallMap B S hS U k
  map_id W := by
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    rfl
  map_comp {W W' W''} k k' := by
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    rfl

/-- The structure morphism of an object of the spaces-étale site of `U` composed with that of
`U` is étale, by Tag 03FT. -/
theorem etale_compHom (U : SpacesEtale B S hS X)
    (V : SpacesEtale B S hS U.obj.left) :
    etaleMorphisms B S hS (V.obj.hom ≫ U.obj.hom) :=
  MorphismProperty.comp_mem _ _ _ V.property U.property

/-- An object of the spaces-étale site of `U`, read as an object of the spaces-étale site of
`X`. -/
noncomputable def smallToSliceSrc (U : SpacesEtale B S hS X)
    (V : SpacesEtale B S hS U.obj.left) : SpacesEtale B S hS X :=
  ⟨Over.mk (V.obj.hom ≫ U.obj.hom), etale_compHom B S hS U V⟩

/-- The structure morphism of an object of the spaces-étale site of `U`, read as a morphism of
the spaces-étale site of `X`. -/
noncomputable def smallToSliceHom (U : SpacesEtale B S hS X)
    (V : SpacesEtale B S hS U.obj.left) : smallToSliceSrc B S hS U V ⟶ U :=
  ObjectProperty.homMk (Over.homMk (U := (smallToSliceSrc B S hS U V).obj) (V := U.obj)
    V.obj.hom rfl)

/-- An object of the spaces-étale site of `U`, read as an object of the slice of the
spaces-étale site of `X` at `U`. -/
noncomputable def smallToSliceObj (U : SpacesEtale B S hS X)
    (V : SpacesEtale B S hS U.obj.left) : Over U :=
  Over.mk (smallToSliceHom B S hS U V)

/-- A morphism of the spaces-étale site of `U`, read as a morphism of the spaces-étale site of
`X`. -/
noncomputable def smallToSliceMap (U : SpacesEtale B S hS X)
    {V V' : SpacesEtale B S hS U.obj.left} (m : V ⟶ V') :
    smallToSliceSrc B S hS U V ⟶ smallToSliceSrc B S hS U V' := by
  refine ObjectProperty.homMk (Over.homMk
    (U := (smallToSliceSrc B S hS U V).obj) (V := (smallToSliceSrc B S hS U V').obj) ?_ ?_)
  · exact (Over.Hom.left m.hom : V.obj.left ⟶ V'.obj.left)
  · change (Over.Hom.left m.hom : V.obj.left ⟶ V'.obj.left) ≫ (V'.obj.hom ≫ U.obj.hom)
        = V.obj.hom ≫ U.obj.hom
    rw [← Category.assoc, Over.w m.hom]

/-- The spaces-étale site of `U` maps to the slice of the spaces-étale site of `X` at `U` by
composing the structure morphism with that of `U`. -/
noncomputable def smallToSlice (U : SpacesEtale B S hS X) :
    SpacesEtale B S hS U.obj.left ⥤ Over U where
  obj V := smallToSliceObj B S hS U V
  map {V V'} m := Over.homMk (U := smallToSliceObj B S hS U V)
      (V := smallToSliceObj B S hS U V') (smallToSliceMap B S hS U m)
      (by
        apply ObjectProperty.hom_ext
        apply Over.OverMorphism.ext
        change Over.Hom.left m.hom ≫ V'.obj.hom = V.obj.hom
        exact Over.w m.hom)
  map_id V := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    rfl
  map_comp {V V' V''} m m' := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    rfl

/-- Passing from the spaces-étale site of `U` to the slice at `U` and back is the identity
functor on the nose: the two functors only move the structure morphism between two slots, and
this round trip returns it to the slot it came from. -/
theorem smallToSlice_comp_sliceToSmall (U : SpacesEtale B S hS X) :
    smallToSlice B S hS U ⋙ sliceToSmall B S hS U = 𝟭 _ := rfl

/-- The component at `W` of the unit of `sliceEquivSmall`: the identity on the underlying
algebraic space, the triangle being `Over.w` of the morphism to `U`. -/
noncomputable def sliceUnitIsoApp (U : SpacesEtale B S hS X) (W : Over U) :
    W ≅ (sliceToSmall B S hS U ⋙ smallToSlice B S hS U).obj W := by
  refine Over.isoMk (ObjectProperty.isoMk (IsEtaleOver B S hS X)
    (Over.isoMk (Iso.refl W.left.obj.left) ?_)) ?_
  · change (Iso.refl W.left.obj.left).hom ≫ (Over.Hom.left W.hom.hom ≫ U.obj.hom)
        = W.left.obj.hom
    rw [Iso.refl_hom, Category.id_comp, Over.w W.hom.hom]
  · apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    change (Iso.refl W.left.obj.left).hom ≫ Over.Hom.left W.hom.hom
        = Over.Hom.left W.hom.hom
    rw [Iso.refl_hom, Category.id_comp]

/-- **The slice of the spaces-étale site of `X` at `U` is the spaces-étale site of `U`.** An
algebraic space étale over `X` together with a morphism to `U` is the same thing as an
algebraic space étale over `U`. -/
noncomputable def sliceEquivSmall (U : SpacesEtale B S hS X) :
    Over U ≌ SpacesEtale B S hS U.obj.left :=
  CategoryTheory.Equivalence.mk (sliceToSmall B S hS U) (smallToSlice B S hS U)
    (NatIso.ofComponents (sliceUnitIsoApp B S hS U) (by
      intro W W2 k
      apply Over.OverMorphism.ext
      apply ObjectProperty.hom_ext
      apply Over.OverMorphism.ext
      change Over.Hom.left (CommaMorphism.left k).hom ≫ 𝟙 _
          = 𝟙 _ ≫ Over.Hom.left (CommaMorphism.left k).hom
      rw [Category.comp_id, Category.id_comp]))
    (Iso.refl _)

end Slice

end SpacesEtale

variable {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hf : IsEtale B S hS f.hom)

/-- An étale morphism `f : X ⟶ Y` of algebraic spaces, regarded as an object of the
spaces-étale site of `Y`. -/
def etaleObject : SpacesEtale B S hS Y := ⟨Over.mk f, hf⟩

/-- An object of the spaces-étale site of `Y` over `etaleObject f`, read as an algebraic
space over `X` by the iterated-slice comparison. -/
noncomputable def localizationBackwardBase :
    Over (etaleObject B S hS f hf) ⥤ Over X :=
  Over.post (IsEtaleOver B S hS Y).ι ⋙ Over.iteratedSliceForward (Over.mk f)

/-- An object of the spaces-étale site of `Y` over `etaleObject f` is étale over `X`, by Tag
03FV applied to the two étale structure morphisms to `Y`. -/
theorem localizationBackwardProperty (Z : Over (etaleObject B S hS f hf)) :
    IsEtaleOver B S hS X ((localizationBackwardBase B S hS f hf).obj Z) := by
  change IsEtale B S hS (((localizationBackwardBase B S hS f hf).obj Z).hom.hom)
  exact isEtale_of_isEtale_over B S hS
    Z.left.obj.left.property X.property Y.property
    Z.hom.hom.left.hom Z.left.obj.hom.hom f.hom
    Z.left.property hf (congrArg (fun k ↦ k.hom) (Over.w Z.hom.hom))

/-- The inverse functor of the localization comparison: an object of the spaces-étale site of
`Y` over `etaleObject f` is an object of the spaces-étale site of `X`. -/
noncomputable def localizationBackward :
    Over (etaleObject B S hS f hf) ⥤ SpacesEtale B S hS X :=
  (IsEtaleOver B S hS X).lift (localizationBackwardBase B S hS f hf)
    (localizationBackwardProperty B S hS f hf)

/-- An algebraic space étale over `X`, read as an object over `Over.mk f` by the
iterated-slice comparison. -/
noncomputable def localizationForwardBase :
    SpacesEtale B S hS X ⥤ Over (Over.mk f) :=
  (IsEtaleOver B S hS X).ι ⋙ Over.iteratedSliceBackward (Over.mk f)

/-- An algebraic space étale over `X` is étale over `Y`, by Tag 03FT. -/
noncomputable def localizationForwardObjects :
    SpacesEtale B S hS X ⥤ SpacesEtale B S hS Y :=
  (IsEtaleOver B S hS Y).lift
    (localizationForwardBase B S hS f ⋙ Over.forget (Over.mk f))
    (fun U ↦ by
      change IsEtale B S hS (((localizationForwardBase B S hS f).obj U).left.hom.hom)
      exact isEtale_comp B S hS U.property hf)

/-- The structure morphism to `etaleObject f` of an algebraic space étale over `X`, natural
in that space. -/
noncomputable def localizationForwardArrow :
    localizationForwardObjects B S hS f hf ⟶
      (Functor.const (SpacesEtale B S hS X)).obj (etaleObject B S hS f hf) where
  app U := (IsEtaleOver B S hS Y).homMk ((localizationForwardBase B S hS f).obj U).hom
  naturality _ _ g :=
    (IsEtaleOver B S hS Y).hom_ext (Over.w ((localizationForwardBase B S hS f).map g))

/-- The forward functor of the localization comparison: an algebraic space étale over `X` is
an object of the spaces-étale site of `Y` over `etaleObject f`. -/
noncomputable def localizationForward :
    SpacesEtale B S hS X ⥤ Over (etaleObject B S hS f hf) where
  obj U := Over.mk ((localizationForwardArrow B S hS f hf).app U)
  map g := Over.homMk ((localizationForwardObjects B S hS f hf).map g) (by
    apply (IsEtaleOver B S hS Y).hom_ext
    simp)
  map_id U := by
    ext
    simp
  map_comp g h := by
    ext
    simp

/-- **Stacks 04LY.** For an étale morphism `f : X ⟶ Y` of algebraic spaces, the spaces-étale
site of `X` is equivalent to the localization of the spaces-étale site of `Y` at the object
`f`. -/
@[stacks 04LY "equivalence of categories"]
noncomputable def spacesEtaleLocalization :
    SpacesEtale B S hS X ≌ Over (etaleObject B S hS f hf) := by
  let e := Over.iteratedSliceEquiv (Over.mk f)
  refine
    { functor := localizationForward B S hS f hf
      inverse := localizationBackward B S hS f hf
      unitIso := ?_
      counitIso := ?_
      functor_unitIso_comp := ?_ }
  · exact ((IsEtaleOver B S hS X).fullyFaithfulι.whiskeringRight _).preimageIso
      ((IsEtaleOver B S hS X).ι.isoWhiskerLeft e.counitIso.symm)
  · let hpost := Functor.FullyFaithful.over (etaleObject B S hS f hf)
      (IsEtaleOver B S hS Y).ι (IsEtaleOver B S hS Y).fullyFaithfulι
    let q := Over.post (X := etaleObject B S hS f hf) (IsEtaleOver B S hS Y).ι
    have hproj : localizationBackward B S hS f hf ⋙ localizationForward B S hS f hf ⋙ q ≅
        q ⋙ e.functor ⋙ e.inverse := by
      refine NatIso.ofComponents (fun Z ↦ ?_) ?_
      · cases Z
        exact Iso.refl _
      · intro Z W g
        cat_disch
    exact (Functor.FullyFaithful.whiskeringRight hpost _).preimageIso
      (hproj.trans (Functor.isoWhiskerLeft q e.unitIso.symm) ≪≫
        Functor.rightUnitor q ≪≫ (Functor.leftUnitor q).symm)
  · intro U
    cat_disch

/-- **Stacks 04LY.** Under the localization equivalence an algebraic space étale over `X` is
unchanged, and its structure morphism to `Y` is the composite with `f`. -/
@[stacks 04LY "canonical identification"]
theorem spacesEtaleLocalization_forget :
    (spacesEtaleLocalization B S hS f hf).functor ⋙
        Over.forget (etaleObject B S hS f hf) ⋙ SpacesEtale.inclusion B S hS Y =
      SpacesEtale.inclusion B S hS X ⋙ Over.map f := by
  change localizationForward B S hS f hf ⋙
      Over.forget (etaleObject B S hS f hf) ⋙ SpacesEtale.inclusion B S hS Y = _
  apply CategoryTheory.Functor.ext
  · intro U V g
    apply Over.OverMorphism.ext
    simp [localizationForward, localizationForwardArrow, localizationForwardObjects,
      localizationForwardBase, SpacesEtale.inclusion, Over.iteratedSliceBackward]
    rfl
  · intro U
    cases U
    rfl

/-- **Stacks 04LY.** The localization equivalence preserves the whole arrow to `X`, not only
its composite with `f`; this is what makes it canonical. -/
@[stacks 04LY "slice arrows"]
theorem spacesEtaleLocalization_slice :
    (spacesEtaleLocalization B S hS f hf).functor ⋙
        Over.post (SpacesEtale.toSpaces B S hS Y) =
      SpacesEtale.inclusion B S hS X := by
  change localizationForward B S hS f hf ⋙ Over.post (SpacesEtale.toSpaces B S hS Y) = _
  apply CategoryTheory.Functor.ext
  · intro U V g
    apply Over.OverMorphism.ext
    simp [localizationForward, localizationForwardArrow, localizationForwardObjects,
      localizationForwardBase, SpacesEtale.toSpaces, SpacesEtale.inclusion,
      Over.iteratedSliceBackward]
    rfl
  · intro U
    cases U
    rfl

/-- A cover-preserving equivalence is continuous. -/
private theorem isContinuous_of_coverPreserving_of_isEquivalence {C D : Type*} [Category C]
    [Category D] {J : GrothendieckTopology C} {K : GrothendieckTopology D} (F : C ⥤ D)
    [F.IsEquivalence] (h : CoverPreserving J K F) : F.IsContinuous J K :=
  Functor.isContinuous_iff_coverPreserving.2 h

/-- **Stacks 04LY.** The localization equivalence carries covering sieves of the spaces-étale
site of `X` to covering sieves of the slice topology. -/
@[stacks 04LY "forward topology"]
theorem spacesEtaleLocalization_isContinuous :
    (spacesEtaleLocalization B S hS f hf).functor.IsContinuous
      (SpacesEtale.topology B S hS X)
      ((SpacesEtale.topology B S hS Y).over (etaleObject B S hS f hf)) := by
  let e := spacesEtaleLocalization B S hS f hf
  let D := Over.forget (etaleObject B S hS f hf)
  have hcover : CoverPreserving (SpacesEtale.topology B S hS X)
      ((SpacesEtale.topology B S hS Y).over (etaleObject B S hS f hf)) e.functor := by
    refine ⟨?_⟩
    intro U R hR
    rw [GrothendieckTopology.mem_over_iff]
    apply (SpacesEtale.mem_topology_iff_sievePointwiseCover B S hS Y
      (U := D.obj (e.functor.obj U))
      (Sieve.overEquiv (e.functor.obj U) (R.functorPushforward e.functor))).2
    intro x
    obtain ⟨V, g, hg, y, hy⟩ :=
      (SpacesEtale.mem_topology_iff_sievePointwiseCover B S hS X R).1 hR x
    refine ⟨D.obj (e.functor.obj V), D.map (e.functor.map g), ?_, y, ?_⟩
    · simpa [Sieve.overEquiv] using Sieve.image_mem_functorPushforward D _
        (Sieve.image_mem_functorPushforward e.functor R hg)
    · exact hy
  exact isContinuous_of_coverPreserving_of_isEquivalence e.functor hcover

/-- **Stacks 04LY.** The inverse of the localization equivalence carries covering sieves of
the slice topology to covering sieves of the spaces-étale site of `X`. -/
@[stacks 04LY "inverse topology"]
theorem spacesEtaleLocalization_inverse_isContinuous :
    (spacesEtaleLocalization B S hS f hf).inverse.IsContinuous
      ((SpacesEtale.topology B S hS Y).over (etaleObject B S hS f hf))
      (SpacesEtale.topology B S hS X) := by
  let e := spacesEtaleLocalization B S hS f hf
  have hcover : CoverPreserving
      ((SpacesEtale.topology B S hS Y).over (etaleObject B S hS f hf))
      (SpacesEtale.topology B S hS X) e.inverse := by
    refine ⟨?_⟩
    intro Z R hR
    rw [GrothendieckTopology.mem_over_iff] at hR
    apply (SpacesEtale.mem_topology_iff_sievePointwiseCover B S hS X
      (U := e.inverse.obj Z) (R.functorPushforward e.inverse)).2
    intro x
    obtain ⟨V, g, hg, y, hy⟩ := (SpacesEtale.mem_topology_iff_sievePointwiseCover B S hS Y
      (U := Z.left) (Sieve.overEquiv Z R)).1 hR
      (x : points B S hS ((SpacesEtale.toSpaces B S hS Y).obj Z.left).obj)
    let W : Over (etaleObject B S hS f hf) := Over.mk (g ≫ Z.hom)
    let k : W ⟶ Z := Over.homMk g rfl
    have hk : R k := (Sieve.overEquiv_iff R g).1 hg
    refine ⟨e.inverse.obj W, e.inverse.map k,
      Sieve.image_mem_functorPushforward e.inverse R hk, y, hy⟩
  exact isContinuous_of_coverPreserving_of_isEquivalence e.inverse hcover

end AlgebraicGeometry.Space

