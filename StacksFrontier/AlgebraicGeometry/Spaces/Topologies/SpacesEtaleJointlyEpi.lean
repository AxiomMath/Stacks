module

public import StacksFrontier.AlgebraicGeometry.Spaces.SheafGivesSpaceRepresentable
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Jointly epimorphic families of representable sheaves on the spaces-étale site

On a subcanonical site, a family of morphisms `a k : P k ⟶ Q` whose represented morphisms of
sheaves are jointly epimorphic generates a covering sieve of `Q`. On the spaces-étale site of an
algebraic space `X` the covering sieves are exactly those which, through every point of their
target, contain a morphism passing through that point; so a jointly epimorphic family of
representable sheaves over `h_Q` is jointly surjective on the points of `Q`. Conversely a single
morphism surjective on points induces an epimorphism of representable sheaves.

## Main results

* `CategoryTheory.GrothendieckTopology.ofArrows_mem_of_jointlyEpi`: on a subcanonical site, a
  family whose represented morphisms are jointly epimorphic generates a covering sieve.
* `AlgebraicGeometry.Space.SpacesEtale.exists_isCovering_le_of_mem_topology`: a covering sieve
  of the spaces-étale site contains a jointly point-surjective family.
* `AlgebraicGeometry.Space.SpacesEtale.exists_points_of_mem_topology`: through every point of
  the target of a covering sieve passes a member of the sieve.
* `AlgebraicGeometry.Space.SpacesEtale.exists_points_of_jointlyEpi`: a jointly epimorphic
  family of representable sheaves over `h_Q` is jointly surjective on the points of `Q`.
* `AlgebraicGeometry.Space.SpacesEtale.epi_yoneda_map_of_surjective`: a morphism surjective on
  points induces an epimorphism of representable sheaves.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) [J.Subcanonical]
  [HasSheafify J (Type v)]

/-- **A jointly epimorphic family of representable sheaves generates a covering sieve.** If the
morphisms of sheaves `h_{P k} ⟶ h_Q` represented by a family `a k : P k ⟶ Q` are jointly
epimorphic, then the sieve generated by the family covers `Q`. -/
@[sga "3 IV 4.4.3" "special case",
  sga "3 IV 4.4.8" "(i)",
  sga "3 IV 6.7.3" "Clause (i)(2)",
  sga "3 VIB 10.15" "partial",
  sga "3 VIIA 8.1.4" "special case",
  sga "4 II 4.4" "Implication i) ⇒ ii)",
  sga "4 III 4.1.2" "Final step of 4.1.2"]
theorem ofArrows_mem_of_jointlyEpi {Q : C} {K : Type w} {P : K → C} (a : ∀ k, P k ⟶ Q)
    (h : ∀ (H : Sheaf J (Type v)) (α β : J.yoneda.obj Q ⟶ H),
      (∀ k, J.yoneda.map (a k) ≫ α = J.yoneda.map (a k) ≫ β) → α = β) :
    Sieve.ofArrows P a ∈ J Q := by
  let R := Sieve.ofArrows P a
  let Sub : Subfunctor (CategoryTheory.yoneda.obj Q) :=
    { obj := fun T => {t | R.arrows t}
      map := fun {T T'} g t ht => R.downward_closed ht g.unop }
  have hQ : Presieve.IsSheaf J (CategoryTheory.yoneda.obj Q) :=
    (isSheaf_iff_isSheaf_of_type _ _).1 (J.yoneda.obj Q).cond
  let M : Sheaf J (Type v) :=
    ⟨(Sub.sheafify J).toFunctor, (isSheaf_iff_isSheaf_of_type _ _).2
      (Sub.sheafify_isSheaf hQ)⟩
  let m : M ⟶ J.yoneda.obj Q := ⟨(Sub.sheafify J).ι⟩
  have hfac : ∀ k, ∃ ℓ : J.yoneda.obj (P k) ⟶ M, ℓ ≫ m = J.yoneda.map (a k) := fun k => by
    have hle : Subfunctor.range (CategoryTheory.yoneda.map (a k)) ≤ Sub.sheafify J := by
      rintro T _ ⟨t, rfl⟩
      exact Sub.le_sheafify J _ (R.downward_closed (Sieve.ofArrows_mk P a k) t)
    refine ⟨⟨Subfunctor.lift _ hle⟩, ?_⟩
    ext1
    exact Subfunctor.lift_ι (CategoryTheory.yoneda.map (a k)) hle
  have hepi : Epi m := ⟨fun {H} α β hαβ => h H α β fun k => by
    obtain ⟨ℓ, hℓ⟩ := hfac k
    rw [← hℓ, Category.assoc, Category.assoc, hαβ]⟩
  have hls := (Sheaf.isLocallySurjective_iff_epi m).2 hepi
  have hsieve := Presheaf.imageSieve_mem J m.hom (𝟙 Q : (CategoryTheory.yoneda.obj Q).obj (op Q))
  refine J.transitive hsieve R fun T t ht => ?_
  obtain ⟨y, hy⟩ := ht
  obtain rfl : m.hom.app (op T) y = t := by simpa using hy
  exact y.2

end CategoryTheory.GrothendieckTopology

namespace AlgebraicGeometry.Space.SpacesEtale

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) {X : AlgebraicSpaces B S hS}

/-- **A covering sieve of the spaces-étale site contains a covering family**: a jointly
point-surjective family of the spaces-étale site all of whose members lie in the sieve. -/
theorem exists_isCovering_le_of_mem_topology {U : SpacesEtale B S hS X} {R : Sieve U}
    (hR : R ∈ topology B S hS X U) :
    ∃ E : PreZeroHypercover.{u + 1} U, IsCovering B S hS X ⟨U, E⟩ ∧ E.presieve₀ ≤ R := by
  rw [topology, Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of U P hP =>
      obtain ⟨E, rfl, hE⟩ := hP
      exact ⟨E, hE, Sieve.le_generate _⟩
  | top U =>
      exact ⟨PreZeroHypercover.singleton (𝟙 U), (isSite B S hS X).1 (𝟙 U), fun _ _ _ ↦ trivial⟩
  | pullback U R hR Y f ih =>
      obtain ⟨E, hE, hle⟩ := ih
      obtain ⟨P, p₁, p₂, hpb, hP⟩ := (isSite B S hS X).2.2 ⟨U, E⟩ hE Y f
      let F : PreZeroHypercover Y := ⟨E.I₀, P, p₂⟩
      refine ⟨F, hP, ?_⟩
      rw [Presieve.ofArrows_le_iff]
      intro i
      rw [Sieve.pullback_apply, ← (hpb i).w]
      exact R.downward_closed (hle _ _ ⟨i⟩) (p₁ i)
  | transitive U R Q hR hRQ ihR ihRQ =>
      obtain ⟨E, hE, hle⟩ := ihR
      choose G hG hGle using fun i : E.I₀ ↦ ihRQ (hle _ _ ⟨i⟩)
      refine ⟨E.bind G, (isSite B S hS X).2.1 ⟨U, E⟩ hE (fun i ↦ ⟨E.X i, G i⟩) hG (fun _ ↦ rfl),
        ?_⟩
      rw [Presieve.ofArrows_le_iff]
      rintro ⟨i, j⟩
      show Q ((G i).f j ≫ E.f i)
      exact hGle i _ _ ⟨j⟩

/-- **Through every point of the target of a covering sieve of the spaces-étale site passes a
member of the sieve.** -/
theorem exists_points_of_mem_topology {U : SpacesEtale B S hS X} {R : Sieve U}
    (hR : R ∈ topology B S hS X U) (x : points B S hS ((toSpaces B S hS X).obj U).1) :
    ∃ (V : SpacesEtale B S hS X) (h : V ⟶ U), R h ∧
      ∃ y : points B S hS ((toSpaces B S hS X).obj V).1,
        pointsMap B S hS _ ((toSpaces B S hS X).map h).hom y = x := by
  obtain ⟨E, hE, hle⟩ := exists_isCovering_le_of_mem_topology B S hS hR
  obtain ⟨i, y, hy⟩ := hE x
  exact ⟨E.X i, E.f i, hle _ _ ⟨i⟩, y, hy⟩

/-- **A jointly epimorphic family of representable sheaves is jointly surjective on points.** If
the morphisms of sheaves represented by a family `a k : P k ⟶ Q` of the spaces-étale site of `X`
are jointly epimorphic, then every point of `Q` lies in the image of some `a k`. -/
theorem exists_points_of_jointlyEpi {Q : SpacesEtale B S hS X} {K : Type w}
    {P : K → SpacesEtale B S hS X} (a : ∀ k, P k ⟶ Q)
    (h : ∀ (H : Sheaf (topology B S hS X) (Type (u + 1)))
      (α β : (topology B S hS X).yoneda.obj Q ⟶ H),
      (∀ k, (topology B S hS X).yoneda.map (a k) ≫ α =
        (topology B S hS X).yoneda.map (a k) ≫ β) → α = β)
    (x : points B S hS ((toSpaces B S hS X).obj Q).1) :
    ∃ (k : K) (y : points B S hS ((toSpaces B S hS X).obj (P k)).1),
      pointsMap B S hS _ ((toSpaces B S hS X).map (a k)).hom y = x := by
  obtain ⟨V, g, ⟨W, b, c, ⟨k⟩, rfl⟩, y, hy⟩ := exists_points_of_mem_topology B S hS
    ((topology B S hS X).ofArrows_mem_of_jointlyEpi a h) x
  refine ⟨k, pointsMap B S hS _ ((toSpaces B S hS X).map b).hom y, ?_⟩
  simp [← hy]

/-- **A morphism of the spaces-étale site surjective on points induces an epimorphism of
representable sheaves.** -/
theorem epi_yoneda_map_of_surjective {P Q : SpacesEtale B S hS X} (a : P ⟶ Q)
    (ha : Function.Surjective (pointsMap B S hS _ ((toSpaces B S hS X).map a).hom)) :
    Epi ((topology B S hS X).yoneda.map a) := by
  let J := topology B S hS X
  have hcov : Sieve.ofArrows (fun _ : PUnit.{u + 2} => P) (fun _ => a) ∈ J Q :=
    Precoverage.generate_mem_toGrothendieck ⟨⟨PUnit.{u + 2}, _, fun _ => a⟩, rfl,
      fun x => ⟨PUnit.unit, (ha x).choose, (ha x).choose_spec⟩⟩
  have : Sheaf.IsLocallySurjective (J.yoneda.map a) := ⟨fun {U} x => by
    refine J.superset_covering ?_ (J.pullback_stable x hcov)
    rintro V g ⟨W, b, c, ⟨_⟩, hbc⟩
    exact ⟨b, hbc⟩⟩
  infer_instance

end AlgebraicGeometry.Space.SpacesEtale
