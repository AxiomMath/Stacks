/-!
# Full faithfulness of descent along a proper surjection of algebraic spaces

Let `f : Y ⟶ X` be a proper surjective morphism of algebraic spaces over a scheme `S`. The
second assertion of Stacks 0DFX — that a sheaf `F` on `X_étale` is the equalizer of the two maps
`f_*f⁻¹F ⇉ g_*g⁻¹F`, `g : Y ×_X Y ⟶ X` — says, after the adjunction `f⁻¹ ⊣ f_*`, that the
functor sending a sheaf on `X` to its canonical descent datum along `{f}` is fully faithful:
the pseudofunctor of spaces-étale inverse images is a *prestack* for the sieve generated by `f`.
In the form of the sheaf condition (`CategoryTheory.Pseudofunctor.isPrestackFor_iff_isSheafFor`)
it states that `U ↦ Hom(M|_U, N|_U)` satisfies descent along every base change of `f`; taking
for `M` the final sheaf, that `Γ(U, N|_U)` is the equalizer of `Γ(V, N|_V) ⇉ Γ(V ×_U V, ·)`
for every base change `V ⟶ U` of `f`.

This file proves that statement for every proper surjective morphism of algebraic spaces,
granted it for proper surjective morphisms *of schemes* of the site.

## Main definitions

* `CategoryTheory.Pseudofunctor.IsHomSeparatedFor`: the separatedness half of being a prestack,
  i.e. faithfulness of the descent functor, in the form of the sheaf condition.
* `AlgebraicGeometry.Space.ProperSurjectivePrestackOverSchemes`: the scheme case, as a
  statement about the big fppf site.

## Main results

* `CategoryTheory.Presieve.isSeparatedFor_of_cover`,
  `CategoryTheory.Pseudofunctor.isHomSeparatedFor_of_cover` and
  `CategoryTheory.Pseudofunctor.isPrestackFor_of_cover_of_isHomSeparatedFor`: separatedness is
  local on the base, and being a prestack is local on the base with only separatedness asked of
  the pairwise overlaps.
* `CategoryTheory.Pseudofunctor.isPrestackFor_of_le`: being a prestack passes from a sieve to a
  larger one along which the smaller sieve is separated.
* `AlgebraicGeometry.Space.isPrestackFor_of_isProper_isSurjective`: **the full faithfulness
  half of descent along a proper surjection of algebraic spaces** (Stacks 0DFX, second
  assertion, in prestack form), granted the scheme case.

## References

* [Stacks Project, Tag 0DFX](https://stacks.math.columbia.edu/tag/0DFX)
* [Stacks Project, Tag 089J](https://stacks.math.columbia.edu/tag/089J)
* [Stacks Project, Tag 0GFT](https://stacks.math.columbia.edu/tag/0GFT)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe t w v v' u u'

namespace CategoryTheory

/-- **Separatedness for a sieve is local on the base.** A presheaf is separated for a sieve `R`
on `Y` as soon as it is separated for a family `g` and separated for the restriction of `R` to
each member of that family. -/
theorem Presieve.isSeparatedFor_of_cover {C : Type u} [Category.{v} C] (P : Cᵒᵖ ⥤ Type w)
    {Y : C} {I : Type t} {Z : I → C} (g : ∀ i, Z i ⟶ Y) (R : Sieve Y)
    (hg : Presieve.IsSeparatedFor P (.ofArrows Z g))
    (hloc : ∀ i, Presieve.IsSeparatedFor P (R.pullback (g i)).arrows) :
    Presieve.IsSeparatedFor P R.arrows := by
  intro a t₁ t₂ h₁ h₂
  apply hg.ext
  rintro _ _ ⟨i⟩
  apply (hloc i).ext
  intro W b hb
  rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, h₁ _ hb,
    h₂ _ hb]

namespace Pseudofunctor

variable {C : Type u} [Category.{v} C]
  (F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'})

/-- The separatedness half of being a prestack for a sieve `R` on `S`: for every pair of objects
over a further base `S₀` the presheaf of morphisms is separated for `R`. This is faithfulness of
the descent functor, in the form of the sheaf condition of
`CategoryTheory.Pseudofunctor.isPrestackFor_iff_isSheafFor'`. -/
def IsHomSeparatedFor {S : C} (R : Sieve S) : Prop :=
  ∀ ⦃S₀ : C⦄ (M N : F.obj (.mk (op S₀))) (a : S ⟶ S₀),
    Presieve.IsSeparatedFor (F.presheafHom M N) ((Sieve.overEquiv (Over.mk a)).symm R).arrows

variable {F} in
/-- A prestack for a sieve is separated for it. -/
theorem IsPrestackFor.isHomSeparatedFor {S : C} {R : Sieve S} (h : F.IsPrestackFor R.arrows) :
    F.IsHomSeparatedFor R :=
  fun _ M N a ↦ ((F.isPrestackFor_iff_isSheafFor' R).mp h M N a).isSeparatedFor

/-- **Separatedness for a sieve is local on the base.** -/
theorem isHomSeparatedFor_of_cover {Y : C} {I : Type t} {Z : I → C} (g : ∀ i, Z i ⟶ Y)
    (R : Sieve Y) (hg : F.IsPrestackFor (Sieve.ofArrows Z g).arrows)
    (hloc : ∀ i, F.IsHomSeparatedFor (R.pullback (g i))) :
    F.IsHomSeparatedFor R := by
  intro S₀ M N a
  have h := (F.isPrestackFor_iff_isSheafFor' _).mp hg M N a
  refine Presieve.isSeparatedFor_of_cover (F.presheafHom M N)
    (fun i ↦ (Over.homMk (g i) : Over.mk (g i ≫ a) ⟶ Over.mk a)) _ ?_ ?_
  · rw [Presieve.isSeparatedFor_iff_generate]
    convert h.isSeparatedFor using 1
    congr 1
    apply (Sieve.overEquiv _).injective
    simp only [Sieve.ofArrows, Sieve.overEquiv_ofArrows, OrderIso.apply_symm_apply]
    rfl
  · intro i
    rw [← Sieve.overEquiv_symm_pullback]
    exact hloc i M N (g i ≫ a)

/-- **Being a prestack for a sieve is local on the base**, with only separatedness asked of the
restrictions of the sieve to the pairwise overlaps of the cover. -/
theorem isPrestackFor_of_cover_of_isHomSeparatedFor {Y : C} {I : Type t} {Z : I → C}
    (g : ∀ i, Z i ⟶ Y) (sq : ∀ i j, ChosenPullback (g i) (g j)) (R : Sieve Y)
    (hg : F.IsPrestackFor (Sieve.ofArrows Z g).arrows)
    (hg' : ∀ {T : C} (t : T ⟶ Y), F.IsPrestackFor
      ((Sieve.ofArrows Z g).pullback t).arrows)
    (hloc : ∀ i, F.IsPrestackFor (R.pullback (g i)).arrows)
    (hpair : ∀ i j, F.IsHomSeparatedFor (R.pullback (sq i j).p)) :
    F.IsPrestackFor R.arrows := by
  rw [F.isPrestackFor_iff_isSheafFor]
  intro M N
  apply Presieve.isSheafFor_of_cover (F.presheafHom M N)
    (fun i ↦ (Over.homMk (g i) : Over.mk (g i) ⟶ Over.mk (𝟙 Y)))
    (fun i j ↦ (sq i j).over)
  · rw [Presieve.isSheafFor_iff_generate]
    have h := (F.isPrestackFor_iff_isSheafFor' _).mp hg M N (𝟙 Y)
    convert h using 1
    congr 1
    apply (Sieve.overEquiv _).injective
    simp only [Sieve.ofArrows, Sieve.overEquiv_ofArrows, OrderIso.apply_symm_apply]
    rfl
  · intro T t
    obtain ⟨T, a, rfl⟩ := T.mk_surjective
    have h := (F.isPrestackFor_iff_isSheafFor' _).mp (hg' t.left) M N a
    apply Presieve.IsSheafFor.isSeparatedFor
    convert h using 1
    congr 1
    apply (Sieve.overEquiv _).injective
    simp only [Sieve.overEquiv_pullback, Sieve.overEquiv_ofArrows,
      OrderIso.apply_symm_apply]
    rfl
  · intro i
    rw [← Sieve.overEquiv_symm_pullback]
    exact (F.isPrestackFor_iff_isSheafFor' _).mp (hloc i) M N (g i)
  · intro i j
    change Presieve.IsSeparatedFor (F.presheafHom M N)
      (((Sieve.overEquiv (Over.mk (𝟙 Y))).symm R).pullback
        (Over.homMk ((sq i j).p₁ ≫ g i) : Over.mk (sq i j).p ⟶ _)).arrows
    rw [← Sieve.overEquiv_symm_pullback]
    simpa using hpair i j M N (sq i j).p

/-- **Being a prestack passes to a larger sieve.** If `F` is a prestack for a sieve `R₁` on `Y`
contained in `R`, and `R₁` restricted along every arrow of `R` is a sieve for which `F` is
separated, then `F` is a prestack for `R`. -/
theorem isPrestackFor_of_le {Y : C} {R₁ R : Sieve Y} (hle : R₁ ≤ R)
    (h₁ : F.IsPrestackFor R₁.arrows)
    (hsep : ∀ ⦃T : C⦄ (t : T ⟶ Y), R t → F.IsHomSeparatedFor (R₁.pullback t)) :
    F.IsPrestackFor R.arrows := by
  rw [F.isPrestackFor_iff_isSheafFor]
  intro M N
  have h := (F.isPrestackFor_iff_isSheafFor R₁).mp h₁ M N
  refine Presieve.isSheafFor_subsieve_aux (F.presheafHom M N) (S := (Sieve.overEquiv _).symm R₁)
    (fun Z u (hu : R₁ u.left) ↦ hle _ hu) h ?_
  intro T t ht
  obtain ⟨T, a, rfl⟩ := T.mk_surjective
  have hs := hsep t.left ht M N a
  rwa [Sieve.overEquiv_symm_pullback t] at hs

end Pseudofunctor

end CategoryTheory

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The scheme case of full faithfulness of descent along a proper surjection.** For every
morphism `m : W ⟶ V` of the big fppf site of `S` whose underlying morphism of schemes is proper
and surjective, the pseudofunctor of spaces-étale inverse images is a prestack for the sieve
generated by the represented morphism of algebraic spaces. -/
abbrev ProperSurjectivePrestackOverSchemes : Prop :=
  ∀ ⦃V W : BigFppfOver B S hS⦄ (m : W ⟶ V),
    _root_.AlgebraicGeometry.IsProper ((BigFppfOver.toScheme B S hS).map m) →
    _root_.AlgebraicGeometry.Surjective ((BigFppfOver.toScheme B S hS).map m) →
    (spacesEtalePseudofunctor B S hS).IsPrestackFor
      (Sieve.ofArrows (fun _ : Unit ↦ schemeSpace W)
        (fun _ ↦ (schemeSpaceMap m :
          schemeSpace W ⟶ schemeSpace V))).arrows

/-- The representable morphisms of presheaves on the big fppf site of `S` all of whose
represented base changes are surjective and proper. -/
abbrev RepresentablyProperSurjective : MorphismProperty ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) :=
  (MorphismProperty.inverseImage
    (@_root_.AlgebraicGeometry.Surjective.{u} ⊓ @_root_.AlgebraicGeometry.IsProper.{u})
    (BigFppfOver.toScheme B S hS)).presheaf

variable {B S hS}

section Cover

variable {X : AlgebraicSpaces B S hS} {I : Type t} {Ycov : I → AlgebraicSpaces B S hS}
  (g : ∀ i, Ycov i ⟶ X) (hg : IsEtaleCovering B S hS (fun i ↦ (Ycov i).1) (fun i ↦ (g i).hom))

include hg in
/-- The pseudofunctor of spaces-étale inverse images is a prestack for the sieve generated by an
étale covering. -/
theorem isPrestackFor_ofArrows_of_isEtaleCovering :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor (Sieve.ofArrows Ycov g).arrows :=
  Pseudofunctor.isPrestackFor_of_equivalence _ g
    (SpacesEtale.isEquivalence_toDescentData_spacesEtalePseudofunctor_of_isEtaleCovering
      B S hS Ycov g hg)

include hg in
/-- The pseudofunctor of spaces-étale inverse images is a prestack for every pullback of the sieve
generated by an étale covering. -/
theorem isPrestackFor_ofArrows_pullback_of_isEtaleCovering
    {T : AlgebraicSpaces B S hS} (t : T ⟶ X) :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor
      ((Sieve.ofArrows Ycov g).pullback t).arrows :=
  Pseudofunctor.isPrestackFor_pullback_of_equivalence _ g t
    (fun i ↦ (spacesChosenPullback B S hS t (g i)).pullback)
    (fun i ↦ (spacesChosenPullback B S hS t (g i)).p₁)
    (fun i ↦ (spacesChosenPullback B S hS t (g i)).p₂)
    (fun i ↦ (spacesChosenPullback B S hS t (g i)).isPullback)
    (isEquivalence_toDescentData_spacesChosenPullback_p₁ B S hS Ycov g hg t)

end Cover

/-- **Being a prestack is local on affine charts.** A sieve on an algebraic space `X` for which
the pseudofunctor of spaces-étale inverse images is a prestack after restriction along every
morphism from an affine scheme of the site is a sieve for which it is a prestack. -/
theorem isPrestackFor_of_forall_affine {X : AlgebraicSpaces B S hS} (R : Sieve X)
    (h : ∀ (U : BigFppfOver B S hS), IsAffine ((BigFppfOver.toScheme B S hS).obj U) →
      ∀ b : schemeSpace U ⟶ X,
        (spacesEtalePseudofunctor B S hS).IsPrestackFor (R.pullback b).arrows) :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor R.arrows := by
  have hsep : ∀ {T : AlgebraicSpaces B S hS} (p : T ⟶ X),
      (spacesEtalePseudofunctor B S hS).IsHomSeparatedFor (R.pullback p) := by
    intro T p
    obtain ⟨W, c, hWaff, -, -, hcov⟩ := exists_isEtaleCovering_affine B S hS T.1 T.2
    refine Pseudofunctor.isHomSeparatedFor_of_cover _
      (fun x ↦ (ObjectProperty.homMk (c x) : schemeSpace (W x) ⟶ T)) _
      (isPrestackFor_ofArrows_of_isEtaleCovering _ hcov) fun x ↦ ?_
    rw [← Sieve.pullback_comp]
    exact (h (W x) (hWaff x) _).isHomSeparatedFor
  obtain ⟨W, b, hWaff, -, -, hcov⟩ := exists_isEtaleCovering_affine B S hS X.1 X.2
  let g : ∀ x, schemeSpace (W x) ⟶ X := fun x ↦ ObjectProperty.homMk (b x)
  exact Pseudofunctor.isPrestackFor_of_cover_of_isHomSeparatedFor _ g
    (fun i j ↦ spacesChosenPullback B S hS (g i) (g j)) R
    (isPrestackFor_ofArrows_of_isEtaleCovering g hcov)
    (fun t ↦ isPrestackFor_ofArrows_pullback_of_isEtaleCovering g hcov t)
    (fun x ↦ h (W x) (hWaff x) (g x)) (fun i j ↦ hsep _)

/-- The sieve generated by a single morphism `f`, pulled back along `b`, is generated by the
base change of `f` along `b`. -/
theorem ofArrows_pullback_eq {X Y U : AlgebraicSpaces B S hS} (f : Y ⟶ X) (b : U ⟶ X) :
    (Sieve.ofArrows (fun _ : Unit ↦ Y) (fun _ ↦ f)).pullback b =
      Sieve.ofArrows (fun _ : Unit ↦ (spacesChosenPullback B S hS f b).pullback)
        (fun _ ↦ (spacesChosenPullback B S hS f b).p₂) :=
  (Sieve.ofArrows_eq_pullback_of_isPullback (fun _ : Unit ↦ f)
    (fun _ ↦ (spacesChosenPullback B S hS f b).isPullback.flip)).symm

variable (B S hS)

/-- The represented base changes of a morphism of the site with proper surjective underlying
morphism of schemes are proper and surjective. -/
theorem representablyProperSurjective_yoneda_map {V W : BigFppfOver B S hS} (m : W ⟶ V)
    (hp : _root_.AlgebraicGeometry.IsProper ((BigFppfOver.toScheme B S hS).map m))
    (hs : _root_.AlgebraicGeometry.Surjective ((BigFppfOver.toScheme B S hS).map m)) :
    RepresentablyProperSurjective B S hS (yoneda.map m) := by
  have : MorphismProperty.IsStableUnderBaseChange
      (@_root_.AlgebraicGeometry.Surjective.{u} ⊓ @_root_.AlgebraicGeometry.IsProper.{u}) :=
    ⟨fun hpb hg ↦ ⟨MorphismProperty.of_isPullback hpb hg.1,
      MorphismProperty.of_isPullback hpb hg.2⟩⟩
  have := BigFppfOver.isStableUnderBaseChange_inverseImage B S hS
    (@_root_.AlgebraicGeometry.Surjective.{u} ⊓ @_root_.AlgebraicGeometry.IsProper.{u})
  exact MorphismProperty.relative_map (P := MorphismProperty.inverseImage
    (@_root_.AlgebraicGeometry.Surjective.{u} ⊓ @_root_.AlgebraicGeometry.IsProper.{u})
    (BigFppfOver.toScheme B S hS)) ⟨hs, hp⟩

variable {B S hS}

/-- **The case of a representable morphism, after restriction to a scheme.** For a morphism
`φ` of algebraic spaces all of whose represented base changes are proper and surjective, and a
morphism `b` from a scheme of the site, the restriction along `b` of the sieve generated by `φ`
is a prestack sieve, granted the scheme case. -/
theorem isPrestackFor_ofArrows_pullback_of_representablyProperSurjective
    (H : ProperSurjectivePrestackOverSchemes B S hS)
    {X' T : AlgebraicSpaces B S hS} (φ : X' ⟶ T)
    (hφ : RepresentablyProperSurjective B S hS φ.hom)
    (U : BigFppfOver B S hS) (b : schemeSpace U ⟶ T) :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor
      ((Sieve.ofArrows (fun _ : Unit ↦ X') (fun _ ↦ φ)).pullback b).arrows := by
  let W := hφ.rep.pullback b.hom
  let snd : W ⟶ U := hφ.rep.snd b.hom
  let fst : yoneda.obj W ⟶ X'.1 := hφ.rep.fst b.hom
  have hsq : IsPullback fst (yoneda.map snd) φ.hom b.hom := hφ.rep.isPullback b.hom
  have hsq' : IsPullback (schemeSpaceMap snd :
      schemeSpace W ⟶ schemeSpace U)
      (ObjectProperty.homMk fst : schemeSpace W ⟶ X') b φ :=
    isPullback_of_isPullback_hom B S hS hsq.flip
  rw [← Sieve.ofArrows_eq_pullback_of_isPullback (fun _ : Unit ↦ φ) (fun _ ↦ hsq')]
  have hP := hφ.property b.hom fst snd hsq
  exact H snd hP.2 hP.1

/-- **The case of a representable morphism.** For a morphism `φ` of algebraic spaces all of
whose represented base changes are proper and surjective, the pseudofunctor of spaces-étale
inverse images is a prestack for the sieve generated by `φ`, granted the scheme case. -/
theorem isPrestackFor_ofArrows_of_representablyProperSurjective
    (H : ProperSurjectivePrestackOverSchemes B S hS)
    {X' T : AlgebraicSpaces B S hS} (φ : X' ⟶ T)
    (hφ : RepresentablyProperSurjective B S hS φ.hom) :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor
      (Sieve.ofArrows (fun _ : Unit ↦ X') (fun _ ↦ φ)).arrows :=
  isPrestackFor_of_forall_affine _ fun U _ b ↦
    isPrestackFor_ofArrows_pullback_of_representablyProperSurjective H φ hφ U b

/-- **The case of an affine target, by Chow's lemma.** For a proper surjective morphism `f` of
algebraic spaces and a morphism `b` from an affine scheme of the site, the restriction along `b`
of the sieve generated by `f` is a prestack sieve, granted the scheme case. -/
theorem isPrestackFor_ofArrows_pullback_of_isProper_of_isAffine
    (H : ProperSurjectivePrestackOverSchemes B S hS)
    {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hp : IsProper B S hS f.hom) (hs : IsSurjective B S hS f.hom)
    (U : BigFppfOver B S hS) (hU : IsAffine ((BigFppfOver.toScheme B S hS).obj U))
    (b : schemeSpace U ⟶ X) :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor
      ((Sieve.ofArrows (fun _ : Unit ↦ Y) (fun _ ↦ f)).pullback b).arrows := by
  rw [ofArrows_pullback_eq]
  let PB := spacesChosenPullback B S hS f b
  let Qs := PB.pullback
  let q : Qs ⟶ schemeSpace U := PB.p₂
  have hsq : IsPullback PB.p₁ q f b := PB.isPullback
  have hqProper : IsProper B S hS q.hom :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := fun ⦃V W : AlgebraicSpaces B S hS⦄ (m : V ⟶ W) => IsProper B S hS m.hom)
      hsq hp
  have hqSurj : IsSurjective B S hS q.hom := isSurjective_of_isPullback B S hS hsq hs
  obtain ⟨V, ρ, hρProper, hρSurj⟩ :=
    exists_properSurjective_schemeCover_of_isProper_toAffine B S hS U hU Qs.property
      q.hom hqProper
  let m : V ⟶ U := yoneda.preimage (ρ ≫ q.hom)
  have hm : yoneda.map m = ρ ≫ q.hom := yoneda.map_preimage _
  have hcompProper : IsProper B S hS (ρ ≫ q.hom) :=
    isProper_comp B S hS (isAlgebraicSpace_yoneda B S hS V) Qs.property
      (isAlgebraicSpace_yoneda B S hS U) ρ q.hom hρProper hqProper
  have hcompSurj : IsSurjective B S hS (ρ ≫ q.hom) := isSurjective_comp B S hS hρSurj hqSurj
  have hmProper : _root_.AlgebraicGeometry.IsProper
      ((BigFppfOver.toScheme B S hS).map m) := by
    have hpre : (MorphismProperty.inverseImage
        (@_root_.AlgebraicGeometry.IsProper.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (yoneda.map m) := by
      rw [hm]
      exact (presheaf_isProper_iff B S hS (ρ ≫ q.hom)
        (isAlgebraicSpace_yoneda B S hS V) (isAlgebraicSpace_yoneda B S hS U)
        (by rw [← hm]; exact Functor.relativelyRepresentable.map yoneda m)).mp hcompProper
    exact MorphismProperty.of_relative_map (F := yoneda) (P := MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsProper.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)) hpre
  have hmSurj : _root_.AlgebraicGeometry.Surjective
      ((BigFppfOver.toScheme B S hS).map m) := by
    have hpre : (MorphismProperty.inverseImage
        (@_root_.AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf (yoneda.map m) := by
      rw [hm]
      exact (presheafSurjective_iff_isSurjective_yoneda B S hS (yoneda.obj U)
        (isAlgebraicSpace_yoneda B S hS U) V (ρ ≫ q.hom)).mpr hcompSurj
    exact MorphismProperty.of_relative_map (F := yoneda) (P := MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)) hpre
  let φ : schemeSpace V ⟶ schemeSpace U := schemeSpaceMap m
  have hφ : φ = (ObjectProperty.homMk ρ : schemeSpace V ⟶ Qs) ≫ q :=
    ObjectProperty.hom_ext _ hm
  have hrep : RepresentablyProperSurjective B S hS φ.hom :=
    representablyProperSurjective_yoneda_map B S hS m hmProper hmSurj
  refine Pseudofunctor.isPrestackFor_of_le _ (R₁ := Sieve.ofArrows (fun _ : Unit ↦ _)
    (fun _ ↦ φ)) ?_ (H m hmProper hmSurj) ?_
  · rw [Sieve.ofArrows, Sieve.generate_le_iff]
    rintro _ _ ⟨⟩
    have hmem : (Sieve.ofArrows (fun _ : Unit ↦ Qs) (fun _ ↦ q)).arrows
        ((ObjectProperty.homMk ρ : schemeSpace V ⟶ Qs) ≫ q) :=
      Sieve.downward_closed _ (Sieve.ofArrows_mk _ _ ()) _
    rwa [← hφ] at hmem
  · intro T t _
    refine Pseudofunctor.IsPrestackFor.isHomSeparatedFor
      (isPrestackFor_of_forall_affine _ fun U' _ b' ↦ ?_)
    rw [← Sieve.pullback_comp]
    exact isPrestackFor_ofArrows_pullback_of_representablyProperSurjective H φ hrep U' (b' ≫ t)

/-- **Full faithfulness of descent along a proper surjection of algebraic spaces**, the second
assertion of Stacks 0DFX in prestack form, granted the scheme case. For a proper surjective
morphism `f : Y ⟶ X` of algebraic spaces over `S`, the pseudofunctor of spaces-étale inverse
images is a prestack for the sieve generated by `f`: the functor sending a sheaf on `X_étale`
to its canonical descent datum along `{f}` is fully faithful.

Equivalently (`CategoryTheory.Pseudofunctor.isPrestackFor_iff_isSheafFor`), for any two sheaves
`M`, `N` on `X_étale` the rule `U ↦ Hom(M|_U, N|_U)` satisfies descent along `f` and along each
of its base changes; for `M` final this is the equalizer
`Γ(U, N|_U) → Γ(Y_U, ·) ⇉ Γ(Y_U ×_U Y_U, ·)`. -/
theorem isPrestackFor_of_isProper_isSurjective
    (H : ProperSurjectivePrestackOverSchemes B S hS)
    {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
    (hp : IsProper B S hS f.hom) (hs : IsSurjective B S hS f.hom) :
    (spacesEtalePseudofunctor B S hS).IsPrestackFor
      (Sieve.ofArrows (fun _ : Unit ↦ Y) (fun _ ↦ f)).arrows :=
  isPrestackFor_of_forall_affine _ fun U hU b ↦
    isPrestackFor_ofArrows_pullback_of_isProper_of_isAffine H f hp hs U hU b

end AlgebraicGeometry.Space

