module

public import Mathlib.CategoryTheory.Sites.Over
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.Presentation.BigFppfSite
public import StacksFrontier.AlgebraicGeometry.Spaces.SchemeAsSpace
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.BigFppfSite
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.PhCoverings
public import StacksFrontier.AlgebraicGeometry.Topologies.Ph.BigSite

/-!
# Big ph sites of algebraic spaces

A *big ph site of algebraic spaces* over a scheme `S` is the same kind of datum as a big ph
site of schemes, one level up: a chosen big ph site of schemes containing `S`, the category of
algebraic spaces over `S`, and a set-sized system of ph covering families of algebraic spaces
which satisfies the site axioms and represents every ph covering up to combinatorial
equivalence. Localizing that site at an object `X` gives the big ph site of the algebraic
space `X`.

## Main definitions

* `AlgebraicGeometry.Space.IsPHCoveringFamily` applies the ph-covering condition of Tag 0DFG
  to a covering family in the category of algebraic spaces.
* `AlgebraicGeometry.BigPHSpaceSite` packages the choices defining a big ph site of algebraic
  spaces: **Stacks 0DFK**.
* `AlgebraicGeometry.BigPHSpaceSite.schemeToSpace` is the canonical inclusion of the chosen
  big ph site of schemes into the algebraic spaces over `S`.
* `AlgebraicGeometry.BigPHSpaceSite.topology` is the Grothendieck topology generated by the
  chosen covering families.
* `AlgebraicGeometry.BigPHSpaceOver`, `AlgebraicGeometry.BigPHSpaceOver.IsCovering` and
  `AlgebraicGeometry.BigPHSpaceOver.topology` are the big ph site of one algebraic space `X`
  of the site: the slice at `X`, its covering families and its localized topology,
  **Stacks 0DFL**.

## Main results

The projection fields of `AlgebraicGeometry.BigPHSpaceSite` record that the initial families
are ph and bounded, that the bounded ph families satisfy the site axioms, and that every ph
covering family has a chosen representative. The lemmas in the
`AlgebraicGeometry.BigPHSpaceSite.IsCovering` namespace expose the two components of a chosen
covering, and `AlgebraicGeometry.BigPHSpaceSite.schemeToSpace_obj_val` and
`.schemeToSpace_map_hom` compute the canonical inclusion.

## Implementation notes

The category of algebraic spaces is the existing `AlgebraicGeometry.AlgebraicSpaces`. Its
construction in Lean needs a chosen big fppf site, because an algebraic space over `S` is a
presheaf on the big fppf site of `S`; that auxiliary choice is therefore retained alongside
the source's chosen big ph scheme site, with the two sites required to have the same cutoff
cardinal so that they share an underlying category of bounded schemes. That shared category is
what makes the Yoneda embedding a functor from the chosen big ph scheme site to the algebraic
spaces over `S`.

As for schemes, the selected families are `CovBounded IsPHCoveringFamily coveringBound`,
following the formalization of Stacks 000X, and the precoverage they present is kept distinct
from the Grothendieck topology it generates: the site axioms are statements about the families
themselves.

`StacksFrontier.AlgebraicGeometry.Spaces.Topologies.BigFppfSite` is imported for the two facts
about the slices of the category of algebraic spaces — that they have equalizers and that
composition preserves connected limits — which are stated there for an arbitrary algebraic
space and are what the morphisms of big ph topoi of Tag 0DFN need.

The family-level predicate is named `IsPHCoveringFamily` rather than `IsPHCovering`, which is
the covering condition of Tag 0DFG on a family of natural transformations; the family-level
predicate is that condition read on a `CategoryTheory.Covering` of the category of algebraic
spaces, as `AlgebraicGeometry.Space.IsEtaleCoveringFamily` is for the étale case.

## References

* [Stacks Project, Tag 0DFK](https://stacks.math.columbia.edu/tag/0DFK)
* [Stacks Project, Tag 0DFL](https://stacks.math.columbia.edu/tag/0DFL)
-/

@[expose] public section

open CategoryTheory Cardinal

universe u

namespace AlgebraicGeometry

namespace Space

/-- A covering family in the category of algebraic spaces over `S` is a *ph covering family*
when the corresponding family of natural transformations is a ph covering in the sense of
Stacks 0DFG. -/
abbrev IsPHCoveringFamily (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (E : Covering (AlgebraicSpaces B S hS)) : Prop :=
  IsPHCovering B S hS (fun i => (E.2.X i).1) (fun i => (E.2.f i).hom)

end Space

/-- **Stacks 0DFK.** A big ph site of algebraic spaces over `S`: the chosen big ph site of
schemes containing `S`, the category of algebraic spaces over `S`, and the set-sized system of
ph covering families supplied by Stacks 000X. -/
@[stacks 0DFK]
structure BigPHSpaceSite (S : Scheme.{u}) where
  /-- The chosen big ph site of schemes. -/
  schemeSite : BigPHSite.{u}
  /-- The base scheme belongs to the chosen big ph scheme site. -/
  scheme_mem : schemeSite.Contains S
  /-- The auxiliary big fppf site used to present algebraic spaces as functors. -/
  fppfSite : BigFppfSite.{u}
  /-- The base scheme belongs to the auxiliary big fppf site. -/
  fppf_mem : fppfSite.Contains S
  /-- Both sites use the same underlying category of bounded schemes. -/
  cutoff_eq : schemeSite.cutoff = fppfSite.cutoff
  /-- Initially prescribed ph covering families of algebraic spaces. -/
  initialCoverings : Set (Covering (AlgebraicSpaces fppfSite S fppf_mem))
  /-- The initial families form a set in the covering-index universe. -/
  initialCoverings_small : Small.{u + 2} initialCoverings
  /-- The initial families are ph coverings. -/
  initialCoverings_ph : ∀ E ∈ initialCoverings,
    Space.IsPHCoveringFamily fppfSite S fppf_mem E
  /-- The cardinal bounding the chosen families' index sets. -/
  coveringBound : Cardinal.{u + 2}
  /-- The ordinal chosen in the set-sized covering construction. -/
  coveringOrdinal : Ordinal.{u + 2}
  /-- The chosen ordinal is a successor limit. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every initial family belongs to the bounded collection. -/
  initialCoverings_bounded : ∀ E ∈ initialCoverings,
    CovBounded (Space.IsPHCoveringFamily fppfSite S fppf_mem) coveringBound E
  /-- The bounded ph coverings satisfy the site axioms. -/
  coverings_isSite :
    IsSite (CovBounded (Space.IsPHCoveringFamily fppfSite S fppf_mem) coveringBound)
  /-- Every ph covering has a combinatorially equivalent chosen representative. -/
  covering_representative :
    ∀ E : Covering (AlgebraicSpaces fppfSite S fppf_mem),
      Space.IsPHCoveringFamily fppfSite S fppf_mem E →
        ∃ E' : Covering (AlgebraicSpaces fppfSite S fppf_mem),
          CovBounded (Space.IsPHCoveringFamily fppfSite S fppf_mem) coveringBound E' ∧
            Covering.CombEquiv E E'

namespace BigPHSpaceSite

variable {S : Scheme.{u}}

/-- The chosen big ph category of schemes over the base scheme. -/
abbrev Schemes (T : BigPHSpaceSite S) :=
  BigPHOver T.schemeSite S T.scheme_mem

/-- The stored smallness proof for the initial set of coverings is available to typeclass
inference. -/
instance (T : BigPHSpaceSite S) : Small.{u + 2} T.initialCoverings :=
  T.initialCoverings_small

/-- The category of algebraic spaces underlying a big ph space site. -/
abbrev Spaces (T : BigPHSpaceSite S) :=
  AlgebraicSpaces T.fppfSite S T.fppf_mem

/-- The identity-on-schemes functor between the two sites' common cutoff categories. -/
def schemesToFppf (T : BigPHSpaceSite S) : T.schemeSite.Schemes ⥤ T.fppfSite.Schemes where
  obj X := ⟨X.1, by rw [← T.cutoff_eq]; exact X.2⟩
  map f := ObjectProperty.homMk f.hom
  map_id X := by ext; rfl
  map_comp f g := by ext; rfl

/-- The canonical inclusion of the chosen big ph site of schemes into the big ph site of
algebraic spaces. -/
def schemeToSpace (T : BigPHSpaceSite S) : T.Schemes ⥤ T.Spaces :=
  Over.post (schemesToFppf T) ⋙ schemeSpaceFunctor T.fppfSite S T.fppf_mem

/-- On objects, the canonical inclusion is the algebraic space represented by the scheme. -/
@[simp]
theorem schemeToSpace_obj_val (T : BigPHSpaceSite S) (X : T.Schemes) :
    ((T.schemeToSpace).obj X).1 = yoneda.obj ((Over.post (schemesToFppf T)).obj X) := rfl

/-- On morphisms, the canonical inclusion is the Yoneda image of the morphism. -/
@[simp]
theorem schemeToSpace_map_hom (T : BigPHSpaceSite S) {X Y : T.Schemes} (f : X ⟶ Y) :
    ((T.schemeToSpace).map f).hom = yoneda.map ((Over.post (schemesToFppf T)).map f) := rfl

/-- The chosen ph covering families of a big ph space site. -/
abbrev IsCovering (T : BigPHSpaceSite S) : Covering T.Spaces → Prop :=
  CovBounded (Space.IsPHCoveringFamily T.fppfSite S T.fppf_mem) T.coveringBound

/-- The precoverage presented by the chosen ph covering families. -/
def precoverage (T : BigPHSpaceSite S) : Precoverage T.Spaces where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 2} X,
    R = E.presieve₀ ∧ T.IsCovering ⟨X, E⟩}

/-- A presieve belongs to the precoverage exactly when it comes from a chosen covering. -/
theorem mem_precoverage_iff (T : BigPHSpaceSite S) {X : T.Spaces} {R : Presieve X} :
    R ∈ T.precoverage X ↔
      ∃ E : PreZeroHypercover.{u + 2} X, R = E.presieve₀ ∧ T.IsCovering ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the chosen ph covering families. -/
abbrev topology (T : BigPHSpaceSite S) : GrothendieckTopology T.Spaces :=
  T.precoverage.toGrothendieck

namespace IsCovering

/-- Every chosen covering family is ph. -/
theorem ph {T : BigPHSpaceSite S} {E : Covering T.Spaces} (hE : T.IsCovering E) :
    Space.IsPHCoveringFamily T.fppfSite S T.fppf_mem E :=
  hE.1

/-- The index set of a chosen covering lies below the site's bound. -/
theorem mk_le {T : BigPHSpaceSite S} {E : Covering T.Spaces} (hE : T.IsCovering E) :
    #E.2.I₀ ≤ T.coveringBound :=
  hE.2

end IsCovering

/-- The chosen covering families satisfy the site axioms. -/
theorem isSite (T : BigPHSpaceSite S) : IsSite T.IsCovering :=
  T.coverings_isSite

end BigPHSpaceSite

variable {S : Scheme.{u}} (T : BigPHSpaceSite S) (X : T.Spaces)

/-- **Stacks 0DFL.** The category underlying the big ph site of an algebraic space `X` of the
site is the slice of the big ph category of algebraic spaces at `X`. -/
@[stacks 0DFL "underlying category"]
abbrev BigPHSpaceOver := Over X

/-- A family over `X` covers when its underlying family covers in the big ph site of
algebraic spaces. -/
@[stacks 0DFL "covering families"]
abbrev BigPHSpaceOver.IsCovering (E : Covering (BigPHSpaceOver T X)) : Prop :=
  T.IsCovering ⟨(Over.forget X).obj E.1, E.2.map (Over.forget X)⟩

/-- **Stacks 0DFL.** The big ph topology of `X` is the localization at `X` of the big ph
topology of algebraic spaces over the base scheme. -/
@[stacks 0DFL "localized topology"]
abbrev BigPHSpaceOver.topology : GrothendieckTopology (BigPHSpaceOver T X) :=
  T.topology.over X

end AlgebraicGeometry

end
