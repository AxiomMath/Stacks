module

public import Mathlib.CategoryTheory.Sites.Over
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.Coverings

/-!
# Big fppf sites of algebraic spaces

A *big fppf site of algebraic spaces* over a scheme `S` is the same kind of datum as a big
fppf site of schemes, one level up: a chosen big fppf site of schemes containing `S`, the
category of algebraic spaces over `S`, and a set-sized system of fppf covering families of
algebraic spaces which satisfies the site axioms and represents every fppf covering up to
combinatorial equivalence. Localizing that site at an object `X` gives the big fppf site of
the algebraic space `X`.

## Main definitions

* `AlgebraicGeometry.Space.IsFppfCoveringFamily` applies the fppf-covering condition of
  Tag 03Y8 to a covering family in the category of algebraic spaces.
* `AlgebraicGeometry.BigFppfSpaceSite` packages the choices defining a big fppf site of
  algebraic spaces: **Stacks 0DBV**.
* `AlgebraicGeometry.BigFppfSpaceSite.topology` is the Grothendieck topology generated by the
  chosen covering families.
* `AlgebraicGeometry.BigFppfSpaceOver`, `AlgebraicGeometry.BigFppfSpaceOver.IsCovering` and
  `AlgebraicGeometry.BigFppfSpaceOver.topology` are the big fppf site of one algebraic space
  `X` of the site: the slice at `X`, its covering families and its localized topology,
  **Stacks 0DBW**.

## Main results

* `AlgebraicGeometry.BigFppfSpaceSite.isSite`: the chosen covering families satisfy the site
  axioms.
* `AlgebraicGeometry.BigFppfSpaceSite.IsCovering.fppf` and
  `AlgebraicGeometry.BigFppfSpaceSite.IsCovering.mk_le`: a chosen covering family is fppf, and
  its index set lies below the site's bound.

## Implementation notes

The category of algebraic spaces is the existing `AlgebraicGeometry.AlgebraicSpaces`. Unlike
the big étale site of algebraic spaces of Tag 0DBX, no auxiliary choice is needed here: an
algebraic space over `S` is already a presheaf on the big fppf site of `S`, so the chosen
scheme site is the one presenting the objects.

As for schemes, the selected families are `CovBounded IsFppfCoveringFamily coveringBound`,
following the formalization of Stacks 000X, and the precoverage they present is kept distinct
from the Grothendieck topology it generates: the site axioms are statements about the families
themselves.

The family-level predicate is named `IsFppfCoveringFamily` rather than `IsFppfCovering`,
which is the covering condition of Tag 03Y8 on a family of natural transformations; the
family-level predicate is that condition read on a `CategoryTheory.Covering` of the category
of algebraic spaces, exactly as `AlgebraicGeometry.Space.IsEtaleCoveringFamily` is for the
étale case.

The fppf covering families of algebraic spaces are indexed in `Type (u + 2)`, one universe
above the index universe `Type (u + 1)` used for coverings of schemes, because an algebraic
space over `S` lives one universe above a scheme.

`BigFppfSpaceOver.topology` is an abbreviation for `T.topology.over X`, so it is definitionally
equal to Mathlib's localized topology and the covering-sieve characterization and the
continuity and cocontinuity of the forgetful functor apply to it directly.

## References

* [Stacks Project, Tag 0DBV](https://stacks.math.columbia.edu/tag/0DBV)
* [Stacks Project, Tag 0DBW](https://stacks.math.columbia.edu/tag/0DBW)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Cardinal

universe u

namespace AlgebraicGeometry

namespace Space

/-- A covering family in the category of algebraic spaces over `S` is an *fppf covering
family* when the corresponding family of natural transformations is an fppf covering in the
sense of Stacks 03Y8. -/
abbrev IsFppfCoveringFamily (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (E : Covering (AlgebraicSpaces B S hS)) : Prop :=
  IsFppfCovering B S hS (fun i => (E.2.X i).1) (fun i => (E.2.f i).hom)

/-! ### Finite limits in the slices of the algebraic spaces over a scheme -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The slice of the category of algebraic spaces over `S` at an algebraic space has
equalizers: it has fibre products by Tag 043C, hence binary products, and those give
equalizers. -/
noncomputable instance algebraicSpacesOver_hasEqualizers (X : AlgebraicSpaces B S hS) :
    HasEqualizers (Over X) :=
  have _ : HasBinaryProducts (Over X) := Over.ConstructProducts.over_binaryProduct_of_pullback
  hasEqualizers_of_hasPullbacks_and_binary_products

/-- Composition with a morphism of algebraic spaces over `S` preserves limits of any connected
shape. -/
noncomputable instance overMap_preservesLimitsOfShape_of_isConnected
    {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X) {I : Type*} [SmallCategory I] [IsConnected I]
    [HasLimitsOfShape I (Over Y)] [HasLimitsOfShape I (Over X)] :
    PreservesLimitsOfShape I (Over.map f) :=
  have : PreservesLimitsOfShape I (Over.map f ⋙ Over.forget X) := by
    rw [Over.mapForget_eq]; infer_instance
  preservesLimitsOfShape_of_reflects_of_preserves _ (Over.forget X)

end Space

/-- **Stacks 0DBV.** A big fppf site of algebraic spaces over `S`: the chosen big fppf site of
schemes containing `S`, the category of algebraic spaces over `S`, and the set-sized system of
fppf covering families supplied by Stacks 000X. -/
@[stacks 0DBV]
structure BigFppfSpaceSite (S : Scheme.{u}) where
  /-- The chosen big fppf site of schemes. -/
  schemeSite : BigFppfSite.{u}
  /-- The base scheme belongs to the chosen big fppf scheme site. -/
  scheme_mem : schemeSite.Contains S
  /-- Initially prescribed fppf covering families of algebraic spaces. -/
  initialCoverings : Set (Covering (AlgebraicSpaces schemeSite S scheme_mem))
  /-- The initial families form a set in the covering-index universe. -/
  initialCoverings_small : Small.{u + 2} initialCoverings
  /-- The initial families are fppf coverings. -/
  initialCoverings_fppf : ∀ E ∈ initialCoverings,
    Space.IsFppfCoveringFamily schemeSite S scheme_mem E
  /-- The cardinal bounding the chosen families' index sets. -/
  coveringBound : Cardinal.{u + 2}
  /-- The ordinal chosen in the set-sized covering construction. -/
  coveringOrdinal : Ordinal.{u + 2}
  /-- The chosen ordinal is a successor limit. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every initial family belongs to the bounded collection. -/
  initialCoverings_bounded : ∀ E ∈ initialCoverings,
    CovBounded (Space.IsFppfCoveringFamily schemeSite S scheme_mem) coveringBound E
  /-- The bounded fppf coverings satisfy the site axioms. -/
  coverings_isSite :
    IsSite (CovBounded (Space.IsFppfCoveringFamily schemeSite S scheme_mem) coveringBound)
  /-- Every fppf covering has a combinatorially equivalent chosen representative. -/
  covering_representative :
    ∀ E : Covering (AlgebraicSpaces schemeSite S scheme_mem),
      Space.IsFppfCoveringFamily schemeSite S scheme_mem E →
        ∃ E' : Covering (AlgebraicSpaces schemeSite S scheme_mem),
          CovBounded (Space.IsFppfCoveringFamily schemeSite S scheme_mem) coveringBound E' ∧
            Covering.CombEquiv E E'

namespace BigFppfSpaceSite

variable {S : Scheme.{u}}

/-- The chosen big fppf category of schemes over the base scheme. -/
abbrev Schemes (T : BigFppfSpaceSite S) :=
  BigFppfOver T.schemeSite S T.scheme_mem

/-- The stored smallness proof for the initial set of coverings is available to typeclass
inference. -/
instance (T : BigFppfSpaceSite S) : Small.{u + 2} T.initialCoverings :=
  T.initialCoverings_small

/-- The category of algebraic spaces underlying a big fppf space site. -/
abbrev Spaces (T : BigFppfSpaceSite S) :=
  AlgebraicSpaces T.schemeSite S T.scheme_mem

/-- The chosen covering families of a big fppf space site. -/
abbrev IsCovering (T : BigFppfSpaceSite S) : Covering T.Spaces → Prop :=
  CovBounded (Space.IsFppfCoveringFamily T.schemeSite S T.scheme_mem) T.coveringBound

/-- The precoverage presented by the chosen fppf covering families. -/
def precoverage (T : BigFppfSpaceSite S) : Precoverage T.Spaces where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 2} X,
    R = E.presieve₀ ∧ T.IsCovering ⟨X, E⟩}

/-- A presieve belongs to the precoverage exactly when it comes from a chosen covering. -/
theorem mem_precoverage_iff (T : BigFppfSpaceSite S)
    {X : T.Spaces} {R : Presieve X} :
    R ∈ T.precoverage X ↔
      ∃ E : PreZeroHypercover.{u + 2} X,
        R = E.presieve₀ ∧ T.IsCovering ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the chosen fppf covering families. -/
abbrev topology (T : BigFppfSpaceSite S) : GrothendieckTopology T.Spaces :=
  T.precoverage.toGrothendieck

namespace IsCovering

/-- Every chosen covering family is fppf. -/
theorem fppf {T : BigFppfSpaceSite S} {E : Covering T.Spaces}
    (hE : T.IsCovering E) : Space.IsFppfCoveringFamily T.schemeSite S T.scheme_mem E :=
  hE.1

/-- The index set of a chosen covering lies below the site's bound. -/
theorem mk_le {T : BigFppfSpaceSite S} {E : Covering T.Spaces}
    (hE : T.IsCovering E) : #E.2.I₀ ≤ T.coveringBound :=
  hE.2

end IsCovering

/-- The chosen covering families satisfy the site axioms. -/
theorem isSite (T : BigFppfSpaceSite S) : IsSite T.IsCovering :=
  T.coverings_isSite

end BigFppfSpaceSite

variable {S : Scheme.{u}} (T : BigFppfSpaceSite S) (X : T.Spaces)

/-- **Stacks 0DBW.** The category underlying the big fppf site of an algebraic space `X` of
the site is the slice of the big fppf category of algebraic spaces at `X`. -/
@[stacks 0DBW "underlying category"]
abbrev BigFppfSpaceOver := Over X

/-- A family over `X` covers when its underlying family covers in the big fppf site of
algebraic spaces. -/
@[stacks 0DBW "covering families"]
abbrev BigFppfSpaceOver.IsCovering (E : Covering (BigFppfSpaceOver T X)) : Prop :=
  T.IsCovering ⟨(Over.forget X).obj E.1, E.2.map (Over.forget X)⟩

/-- **Stacks 0DBW.** The big fppf topology of `X` is the localization at `X` of the big fppf
topology of algebraic spaces over the base scheme. -/
@[stacks 0DBW "localized topology"]
abbrev BigFppfSpaceOver.topology : GrothendieckTopology (BigFppfSpaceOver T X) :=
  T.topology.over X

end AlgebraicGeometry

end
