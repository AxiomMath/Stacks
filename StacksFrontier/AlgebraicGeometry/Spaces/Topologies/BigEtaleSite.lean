module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.Coverings
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Sites

/-!
# Big étale sites of algebraic spaces

A *big étale site of algebraic spaces* over a scheme `S` is the same kind of datum as a big
étale site of schemes, one level up: a chosen big étale site of schemes containing `S`, the
category of algebraic spaces over `S`, and a set-sized system of étale covering families of
algebraic spaces which satisfies the site axioms and represents every étale covering up to
combinatorial equivalence. Localizing that site at an object `X` gives the big étale site of
the algebraic space `X`.

## Main definitions

* `AlgebraicGeometry.Space.IsEtaleCoveringFamily` applies the étale-covering condition of
  Tag 041E to a covering family in the category of algebraic spaces.
* `AlgebraicGeometry.BigEtaleSpaceSite` packages the choices defining a big étale site of
  algebraic spaces: **Stacks 0DBX**.
* `AlgebraicGeometry.BigEtaleSpaceSite.topology` is the Grothendieck topology generated by
  the chosen covering families.
* `AlgebraicGeometry.BigEtaleSpaceSite.bigEtaleTopology` is the big étale topology of one
  algebraic space `X` of the site, namely the localization of that topology at `X`:
  **Stacks 0DBY**.

## Main results

The projection fields of `AlgebraicGeometry.BigEtaleSpaceSite` record that the initial
families are étale and bounded, that the bounded étale families satisfy the site axioms, and
that every étale covering family has a chosen representative. The lemmas in the
`AlgebraicGeometry.BigEtaleSpaceSite.IsCovering` namespace expose the two components of a
chosen covering.

## Implementation notes

The category of algebraic spaces is the existing `AlgebraicGeometry.AlgebraicSpaces`. Its
construction in Lean needs a chosen big fppf site, because an algebraic space over `S` is a
presheaf on the big fppf site of `S`; that auxiliary choice is therefore retained alongside
the source's chosen big étale scheme site, and the two are independent data.

As for schemes, the selected families are `CovBounded IsEtaleCoveringFamily coveringBound`,
following the formalization of Stacks 000X, and the precoverage they present is kept
distinct from the Grothendieck topology it generates: the site axioms are statements about
the families themselves. Clients can use the site's category, its family-level covering
predicate, and its topology directly.

The étale covering families of algebraic spaces are indexed in `Type (u + 2)`, one universe
above the index universe `Type (u + 1)` used for coverings of schemes, because an algebraic
space over `S` lives one universe above a scheme: the category
`AlgebraicGeometry.AlgebraicSpaces` is a full subcategory of presheaves on the big fppf site
of `S`.

`bigEtaleTopology` is an abbreviation for `T.topology.over X`, so it is definitionally equal
to Mathlib's localized topology and the covering-sieve characterization and the continuity
and cocontinuity of the forgetful functor apply to it directly.

## References

* [Stacks Project, Tag 0DBX](https://stacks.math.columbia.edu/tag/0DBX)
* [Stacks Project, Tag 0DBY](https://stacks.math.columbia.edu/tag/0DBY)
-/

@[expose] public section

open CategoryTheory Cardinal

universe u

namespace AlgebraicGeometry

namespace Space

/-- A covering family in the category of algebraic spaces over `S` is an *étale covering
family* when the corresponding family of natural transformations is an étale covering in the
sense of Stacks 041E. -/
abbrev IsEtaleCoveringFamily (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (E : Covering (AlgebraicSpaces B S hS)) : Prop :=
  IsEtaleCovering B S hS (fun i => (E.2.X i).1) (fun i => (E.2.f i).hom)

end Space

/-- **Stacks 0DBX.** A big étale site of algebraic spaces over `S`: the chosen big étale site
of schemes containing `S`, the category of algebraic spaces over `S`, and the set-sized
system of étale covering families supplied by Stacks 000X. -/
@[stacks 0DBX]
structure BigEtaleSpaceSite (S : Scheme.{u}) where
  /-- The chosen big étale site of schemes. -/
  schemeSite : BigEtaleSite.{u}
  /-- The base scheme belongs to the chosen big étale scheme site. -/
  scheme_mem : schemeSite.Contains S
  /-- The auxiliary big fppf site used to present algebraic spaces as functors. -/
  fppfSite : BigFppfSite.{u}
  /-- The base scheme belongs to the auxiliary big fppf site. -/
  fppf_mem : fppfSite.Contains S
  /-- Initially prescribed étale covering families of algebraic spaces. -/
  initialCoverings : Set (Covering (AlgebraicSpaces fppfSite S fppf_mem))
  /-- The initial families form a set in the covering-index universe. -/
  initialCoverings_small : Small.{u + 2} initialCoverings
  /-- The initial families are étale coverings. -/
  initialCoverings_etale : ∀ E ∈ initialCoverings,
    Space.IsEtaleCoveringFamily fppfSite S fppf_mem E
  /-- The cardinal bounding the chosen families' index sets. -/
  coveringBound : Cardinal.{u + 2}
  /-- The ordinal chosen in the set-sized covering construction. -/
  coveringOrdinal : Ordinal.{u + 2}
  /-- The chosen ordinal is a successor limit. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every initial family belongs to the bounded collection. -/
  initialCoverings_bounded : ∀ E ∈ initialCoverings,
    CovBounded (Space.IsEtaleCoveringFamily fppfSite S fppf_mem) coveringBound E
  /-- The bounded étale coverings satisfy the site axioms. -/
  coverings_isSite :
    IsSite (CovBounded (Space.IsEtaleCoveringFamily fppfSite S fppf_mem) coveringBound)
  /-- Every étale covering has a combinatorially equivalent chosen representative. -/
  covering_representative :
    ∀ E : Covering (AlgebraicSpaces fppfSite S fppf_mem),
      Space.IsEtaleCoveringFamily fppfSite S fppf_mem E →
        ∃ E' : Covering (AlgebraicSpaces fppfSite S fppf_mem),
          CovBounded (Space.IsEtaleCoveringFamily fppfSite S fppf_mem) coveringBound E' ∧
            Covering.CombEquiv E E'

namespace BigEtaleSpaceSite

variable {S : Scheme.{u}}

/-- The chosen big étale category of schemes over the base scheme. -/
abbrev Schemes (T : BigEtaleSpaceSite S) :=
  BigEtaleOver T.schemeSite S T.scheme_mem

/-- The stored smallness proof for the initial set of coverings is available to typeclass
inference. -/
instance (T : BigEtaleSpaceSite S) : Small.{u + 2} T.initialCoverings :=
  T.initialCoverings_small

/-- The category of algebraic spaces underlying a big étale space site. -/
abbrev Spaces (T : BigEtaleSpaceSite S) :=
  AlgebraicSpaces T.fppfSite S T.fppf_mem

/-- The chosen covering families of a big étale space site. -/
abbrev IsCovering (T : BigEtaleSpaceSite S) : Covering T.Spaces → Prop :=
  CovBounded (Space.IsEtaleCoveringFamily T.fppfSite S T.fppf_mem) T.coveringBound

/-- The precoverage presented by the chosen étale covering families. -/
def precoverage (T : BigEtaleSpaceSite S) : Precoverage T.Spaces where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 2} X,
    R = E.presieve₀ ∧ T.IsCovering ⟨X, E⟩}

/-- A presieve belongs to the precoverage exactly when it comes from a chosen covering. -/
theorem mem_precoverage_iff (T : BigEtaleSpaceSite S)
    {X : T.Spaces} {R : Presieve X} :
    R ∈ T.precoverage X ↔
      ∃ E : PreZeroHypercover.{u + 2} X,
        R = E.presieve₀ ∧ T.IsCovering ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the chosen étale covering families. -/
abbrev topology (T : BigEtaleSpaceSite S) : GrothendieckTopology T.Spaces :=
  T.precoverage.toGrothendieck

namespace IsCovering

/-- Every chosen covering family is étale. -/
theorem etale {T : BigEtaleSpaceSite S} {E : Covering T.Spaces}
    (hE : T.IsCovering E) : Space.IsEtaleCoveringFamily T.fppfSite S T.fppf_mem E :=
  hE.1

/-- The index set of a chosen covering lies below the site's bound. -/
theorem mk_le {T : BigEtaleSpaceSite S} {E : Covering T.Spaces}
    (hE : T.IsCovering E) : #E.2.I₀ ≤ T.coveringBound :=
  hE.2

end IsCovering

/-- The chosen covering families satisfy the site axioms. -/
theorem isSite (T : BigEtaleSpaceSite S) : IsSite T.IsCovering :=
  T.coverings_isSite

/-- **Stacks 0DBY.** The big étale topology of an algebraic space `X` of the site: the
localization at `X` of the big étale topology of algebraic spaces over the base scheme. -/
@[stacks 0DBY]
abbrev bigEtaleTopology (T : BigEtaleSpaceSite S) (X : T.Spaces) :
    GrothendieckTopology (Over X) :=
  T.topology.over X

end BigEtaleSpaceSite

end AlgebraicGeometry

end
