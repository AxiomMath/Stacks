-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The evaluation ideal on a chart where the module is free of rank one -/

/-- **The evaluation ideal of a section is principal where the module is free of rank one.** If
`t` generates `L(U)` over the regular functions of the étale chart `U` and `l₀` is the
corresponding coordinate functional, then the ideal of Stacks 0845 at `U` is generated by the
coordinate `l₀(s|_U)` of the section. -/
theorem sectionEvaluationIdealAt_eq_span_singleton (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (U : SmallEtale B S hS X.1)
    (t : ToType (L.val.obj (op U)))
    (l₀ : Module.Dual ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U))
      (L.val.obj (op U)))
    (hb : ∀ x, l₀ x • t = x) :
    sectionEvaluationIdealAt B S hS X L s U = Ideal.span {l₀ (s.eval (op U))} := by
  have key : ∀ l : Module.Dual
      ((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U)) (L.val.obj (op U)),
      l (s.eval (op U)) = l₀ (s.eval (op U)) * l t := by
    intro l
    conv_lhs => rw [← hb (s.eval (op U))]
    rw [map_smul, smul_eq_mul]
  refine le_antisymm (Ideal.span_le.2 (Set.range_subset_iff.2 fun l => ?_))
    (Ideal.span_le.2 (Set.singleton_subset_iff.2 (Ideal.subset_span ⟨l₀, rfl⟩)))
  exact (Ideal.mem_span_singleton (α :=
    ToType ((smallEtaleRingedSite B S hS X.1 X.2).O.obj.obj (op U)))).2 ⟨l t, key l⟩

/-- The evaluation ideal of a section is a principal ideal on an étale chart where the module is
free of rank one. -/
theorem sectionEvaluationIdealAt_isPrincipal (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (U : SmallEtale B S hS X.1)
    (t : ToType (L.val.obj (op U)))
    (l₀ : Module.Dual ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U))
      (L.val.obj (op U)))
    (hb : ∀ x, l₀ x • t = x) :
    (sectionEvaluationIdealAt B S hS X L s U).IsPrincipal :=
  ⟨l₀ (s.eval (op U)), sectionEvaluationIdealAt_eq_span_singleton B S hS X L s U t l₀ hb⟩

/-! ### Regular sections of a module on an algebraic space, read on the charts -/

/-- **A global section of an `𝒪_X`-module is regular exactly when multiplication by it is
injective on every étale chart.**  Regularity in the sense of Stacks 0843 is monicity of
multiplication by the section, and a morphism of sheaves of modules is monic exactly when it is
injective on sections over every object of the site. -/
theorem isRegularSection_iff_forall_injective_smul (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) :
    AlgebraicGeometry.IsRegularSection (structurePresheaf B S hS X.1)
        (Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS X.1 X.2).O).property s ↔
      ∀ U : (SmallEtale B S hS X.1)ᵒᵖ,
        Function.Injective fun r : ToType ((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj U) =>
          r • s.eval U := by
  show Mono (L.unitHomEquiv.symm s) ↔ _
  rw [← (SheafOfModules.toSheaf _).mono_map_iff_mono,
    ← (sheafToPresheaf _ AddCommGrpCat.{u}).mono_map_iff_mono,
    CategoryTheory.NatTrans.mono_iff_mono_app]
  exact forall_congr' fun U => AddCommGrpCat.mono_iff_injective _

/-- **On a chart where the module is free of rank one, multiplication by the section is injective
exactly when multiplication by the generator of its evaluation ideal is.**  This is the chartwise
form of the equivalence between regularity of `s` and the generator of the zero scheme being a
nonzerodivisor. -/
theorem injective_smul_eval_iff_injective_mul_generator (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections) (U : SmallEtale B S hS X.1)
    (t : ToType (L.val.obj (op U)))
    (l₀ : Module.Dual ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U))
      (L.val.obj (op U)))
    (hb : ∀ x, l₀ x • t = x) :
    Function.Injective
        (fun r : ToType ((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U)) =>
          r • s.eval (op U)) ↔
      Function.Injective
        (fun r : ToType ((Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U)) =>
          r * l₀ (s.eval (op U))) := by
  have hsa : ∀ a : ToType ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U)),
      a • s.eval (op U) = (a * l₀ (s.eval (op U))) • t := by
    intro a
    conv_lhs => rw [← hb (s.eval (op U))]
    rw [smul_smul]
  constructor
  · intro hinj a b hab
    have hab' : a * l₀ (s.eval (op U)) = b * l₀ (s.eval (op U)) := hab
    exact hinj (show a • s.eval (op U) = b • s.eval (op U) by rw [hsa a, hsa b, hab'])
  · intro hinj a b hab
    exact hinj (by simpa only [map_smul, smul_eq_mul] using congrArg l₀ hab)

/-- **A global section of a module free of rank one on every étale chart is regular exactly when
the generators of its evaluation ideals are nonzerodivisors.**  This is the chartwise content of
Stacks 0846 (4): the zero scheme is cut out on each chart by the single element
`l₀(s|_U)`, and regularity of `s` is injectivity of multiplication by each of them. -/
@[stacks 0846 "part (4) read chartwise: the section is regular exactly when the functions \
cutting out the zero scheme are nonzerodivisors, with L carried as free of rank one on every \
chart"]
theorem isRegularSection_iff_forall_injective_mul_generator (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (t : ∀ U : SmallEtale B S hS X.1, ToType (L.val.obj (op U)))
    (l₀ : ∀ U : SmallEtale B S hS X.1,
      Module.Dual ((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U))
        (L.val.obj (op U)))
    (hb : ∀ (U : SmallEtale B S hS X.1) (x), l₀ U x • t U = x) :
    AlgebraicGeometry.IsRegularSection (structurePresheaf B S hS X.1)
        (Stacks.SheafOfModules.Tensor.ringSheaf
            (smallEtaleRingedSite B S hS X.1 X.2).O).property s ↔
      ∀ U : SmallEtale B S hS X.1,
        Function.Injective
          (fun r : ToType ((Stacks.SheafOfModules.Tensor.ringSheaf
              (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U)) =>
            r * l₀ U (s.eval (op U))) :=
  (isRegularSection_iff_forall_injective_smul B S hS X L s).trans
    ⟨fun h U => (injective_smul_eval_iff_injective_mul_generator B S hS X L s U (t U) (l₀ U)
        (hb U)).1 (h (op U)),
      fun h U => (injective_smul_eval_iff_injective_mul_generator B S hS X L s U.unop
        (t U.unop) (l₀ U.unop) (hb U.unop)).2 (h U.unop)⟩

/-! ### The four assertions of Stacks 0846 -/

/-- The zero scheme of the section is any closed subspace whose defining ideal is the evaluation
ideal of the section on every affine étale chart. -/
private theorem zeroScheme_eq_of_definingIdealAt_eq (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U) :
    zeroScheme B S hS X L s = Z :=
  Subtype.ext (zeroSchemeSubfunctor_eq B S hS X L s Z h)

/-- **Stacks 0846 (1), with the vanishing of the pulled-back section read chartwise.**  Among the
closed subspaces of `X` whose defining ideal contains the evaluation ideal of the section on
every affine étale chart, the zero scheme of the section is the greatest.

The upper-bound half is `AlgebraicGeometry.Space.le_zeroSchemeSubfunctor` and is unconditional;
the hypothesis is used only to see that the zero scheme is itself a member. -/
theorem zeroScheme_isGreatest (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U) :
    IsGreatest {W : ClosedSubspaces B S hS X.1 |
      ∀ U : SmallEtale B S hS X.1,
        IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
        sectionEvaluationIdealAt B S hS X L s U ≤ definingIdealAt B S hS X W (op U)}
      (zeroScheme B S hS X L s) := by
  refine ⟨?_, fun W hW => Subtype.coe_le_coe.1 (le_zeroSchemeSubfunctor B S hS X L s W hW)⟩
  rw [zeroScheme_eq_of_definingIdealAt_eq B S hS X L s Z h]
  exact fun U hU => (h U hU).ge

/-- **Stacks 0846 (2), with the vanishing of the pulled-back section read chartwise.**  A
morphism `f : Y ⟶ X` of algebraic spaces factors through the zero scheme of the section exactly
when, on every affine étale chart `U` of `X`, the evaluation ideal of the section is killed by
pullback of regular functions along every point of `Y` lying over `U`.

The direction from the chartwise vanishing is
`AlgebraicGeometry.Space.exists_comp_eq_zeroScheme_of_sectionEvaluationIdealAt_le` and is
unconditional; the hypothesis is used only for the converse. -/
theorem exists_comp_eq_zeroScheme_iff (X Y : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U)
    (f : Y ⟶ X) :
    (∃ g : Y ⟶ (⟨(zeroScheme B S hS X L s).1.toFunctor,
        (zeroScheme B S hS X L s).2.1⟩ : AlgebraicSpaces B S hS),
      g ≫ ObjectProperty.homMk (zeroScheme B S hS X L s).1.ι = f) ↔
      ∀ U : SmallEtale B S hS X.1,
        IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left) →
        ∀ (a : BigFppfOver B S hS) (k : a ⟶ U.1.left) (y : yoneda.obj a ⟶ Y.1),
          yoneda.map k ≫ U.1.hom = y ≫ f.hom →
            sectionEvaluationIdealAt B S hS X L s U ≤
              RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map k).op).hom := by
  rw [zeroScheme_eq_of_definingIdealAt_eq B S hS X L s Z h,
    exists_comp_eq_iff_forall_isAffine_definingIdealAt_le]
  exact forall_congr' fun U => imp_congr_right fun hU => by rw [h U hU]

/-- The defining ideal of the zero scheme of the section is the evaluation ideal of the section
on every affine étale chart. -/
theorem definingIdealAt_zeroScheme_eq (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1) :
    definingIdealAt B S hS X (zeroScheme B S hS X L s) (op U) =
      sectionEvaluationIdealAt B S hS X L s U := by
  rw [zeroScheme_eq_of_definingIdealAt_eq B S hS X L s Z h]
  exact h U hU

/-- **Stacks 0846 (3), read on the charts.**  On an affine étale chart where the module is free
of rank one, the defining ideal of the zero scheme of the section is principal, generated by the
coordinate of the section. -/
theorem definingIdealAt_zeroScheme_isPrincipal (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U)
    (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1)
    (t : ToType (L.val.obj (op U)))
    (l₀ : Module.Dual ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).obj.obj (op U))
      (L.val.obj (op U)))
    (hb : ∀ x, l₀ x • t = x) :
    (definingIdealAt B S hS X (zeroScheme B S hS X L s) (op U)).IsPrincipal := by
  rw [definingIdealAt_zeroScheme_eq B S hS X L s Z h U hU]
  exact sectionEvaluationIdealAt_isPrincipal B S hS X L s U t l₀ hb

/-- **Stacks 0846 (3), reduced to a closed subspace with a prescribed defining ideal.**  The zero
scheme of the section is a locally principal closed subspace exactly when the closed subspace
cut out by the evaluation ideal of the section is. -/
theorem isLocallyPrincipal_zeroScheme_iff (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U) :
    IsLocallyPrincipal B S hS X (zeroScheme B S hS X L s) ↔ IsLocallyPrincipal B S hS X Z := by
  rw [zeroScheme_eq_of_definingIdealAt_eq B S hS X L s Z h]

/-- **Stacks 0846 (4), reduced to a closed subspace with a prescribed defining ideal.**  The zero
scheme of the section is an effective Cartier divisor exactly when the closed subspace cut out
by the evaluation ideal of the section is. -/
theorem isEffectiveCartierDivisor_zeroScheme_iff (X : AlgebraicSpaces B S hS)
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (Z : ClosedSubspaces B S hS X.1)
    (h : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      definingIdealAt B S hS X Z (op U) = sectionEvaluationIdealAt B S hS X L s U) :
    IsEffectiveCartierDivisor B S hS X (zeroScheme B S hS X L s) ↔
      IsEffectiveCartierDivisor B S hS X Z := by
  rw [zeroScheme_eq_of_definingIdealAt_eq B S hS X L s Z h]

end AlgebraicGeometry.Space

end
