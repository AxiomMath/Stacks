module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocalOnCover.Quasicoherence
public import StacksFrontier.AlgebraicGeometry.Spaces.Descent.QuasiCoherent.MemberQuasicoherence
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleModulePullbackRestriction
public import StacksFrontier.AlgebraicGeometry.Stacks.CoherentLocallyNoetherian

/-!
# Finite presentation descends along an étale covering of algebraic spaces

Let `X` be an algebraic space over a scheme `S` and let `(f i : Y i ⟶ X)` be a family of
algebraic spaces étale over `X` whose charts are cover dense in the small étale site of `X`, for
instance an étale covering.  An `𝒪_X`-module whose étale restrictions to the members of the family
are of finite presentation, in the sense `SheafOfModules.IsFinitePresentationOnSite` of
Stacks 03DL(7), is of finite presentation.  This is the étale case of Stacks 060V, in the
rendering of finite presentation on the small étale site.

## Main results

* `Stacks.SheafOfModules.hasFiniteGlobalPresentation_map`: a finite global presentation is carried
  by a functor preserving colimits and zero morphisms and the structure sheaf.
* `AlgebraicGeometry.Space.hasFiniteGlobalPresentation_over_postcomp`: a finite global presentation
  of the étale restriction of a module over a chart of `Y` is one of the module over the
  composite chart of `X`.
* `Space.QuasiCoherentDescent.isFinitePresentationOnSite_of_forall_etaleModulePullback`:
  **finite presentation descends along a cover dense family of étale morphisms.**
* `AlgebraicGeometry.Space.isFinitePresentationOnSite_of_modulePullback_of_isEtaleCovering`: the
  same for a module whose inverse images along an étale covering are of finite presentation.

## Implementation notes

The descent is the one of
`AlgebraicGeometry.Space.QuasiCoherentDescent.isQuasicoherentOnSite_of_forall_etaleModulePullback`,
with the sieve of the objects carrying a global presentation replaced by the sieve generated by
the arrows whose *source* carries a finite global presentation.  That sieve is the one the
definition of `SheafOfModules.IsFinitePresentationOnSite` asks to be covering, and it is stable
under pullback without any restriction of presentations along arrows of the site: an arrow into
the pulled-back object whose source carries a finite global presentation composes to an arrow of
the original sieve.

## References

* [Stacks Project, Tag 060V](https://stacks.math.columbia.edu/tag/060V)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace Stacks.SheafOfModules

universe u v w t

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{w}}

/-- **A finite global presentation is carried along any functor of sheaves of modules that
preserves colimits and zero morphisms and carries the structure sheaf to the structure sheaf.**
This is `Stacks.SheafOfModules.hasGlobalPresentation_map` for the finite presentations of
Stacks 03DE(7). -/
theorem hasFiniteGlobalPresentation_map (M : SheafOfModules.{t} R)
    {C' : Type u} [Category.{v} C'] {J' : GrothendieckTopology C'}
    {R' : Sheaf J' RingCat.{w}}
    {F₀ : SheafOfModules.{t} R ⥤ SheafOfModules.{t} R'}
    {F : SheafOfModules.{max u v w t} R ⥤ SheafOfModules.{max u v w t} R'}
    [PreservesColimitsOfSize.{max u v w t, max u v w t} F]
    [Functor.PreservesZeroMorphisms F]
    (η₁ : F.obj (SheafOfModules.uliftForPresentation.{u, v, w, w, max u v t}
      (SheafOfModules.unit R)) ≅
      SheafOfModules.uliftForPresentation.{u, v, w, w, max u v t}
        (SheafOfModules.unit R'))
    (ηM : F.obj (SheafOfModules.uliftForPresentation.{u, v, w, t, max u v w} M) ≅
      SheafOfModules.uliftForPresentation.{u, v, w, t, max u v w} (F₀.obj M)) :
    M.HasFiniteGlobalPresentation → (F₀.obj M).HasFiniteGlobalPresentation := by
  classical
  have : PreservesColimitsOfSize.{0, 0} F := preservesColimitsOfSize_shrink F
  rintro ⟨n, k, P, Q, ι, κ, hP, hQ, a, b, hab, hc⟩
  let U : SheafOfModules.{max u v w t} R :=
    SheafOfModules.uliftForPresentation.{u, v, w, w, max u v t} (SheafOfModules.unit R)
  have hcof : ∀ {m : ℕ} (P : SheafOfModules.{max u v w t} R) (ι : ∀ _ : Fin m, U ⟶ P),
      Nonempty (IsColimit (Cofan.mk P ι)) →
      Nonempty (IsColimit (Cofan.mk (F.obj P) fun i => η₁.inv ≫ F.map (ι i))) := fun P ι hP =>
    ⟨isColimitCofan_precomposeIso η₁.symm _
      ((Cofan.isColimitMapCoconeEquiv F _ (Cofan.mk P ι)).toFun (isColimitOfPreserves F hP.some))⟩
  let b' : F.obj P ⟶ SheafOfModules.uliftForPresentation.{u, v, w, t, max u v w}
      (F₀.obj M) := F.map b ≫ ηM.hom
  have hmap : F.map a ≫ F.map b = 0 := by simpa using congrArg F.map hab
  have hab' : F.map a ≫ b' = 0 := by simp [b', reassoc_of% hmap]
  let c' := CokernelCofork.ofπ b' hab'
  have hc' : IsColimit c' := by
    let d := (parallelPair a 0) ⋙ F
    let i₁ : d ≅ parallelPair (F.map a) (F.map 0) := by
      refine NatIso.ofComponents (fun j => ?_) ?_
      · cases j <;> exact Iso.refl _
      rintro _ _ (_ | _ | _) <;> simp [d]
    let i₂ : parallelPair (F.map a) (F.map 0) ≅ parallelPair (F.map a) 0 :=
      parallelPairIsoMk (Iso.refl (F.obj Q)) (Iso.refl (F.obj P))
    let i := i₁ ≪≫ i₂
    exact (IsColimit.equivOfNatIsoOfIso i (F.mapCocone (CokernelCofork.ofπ b hab)) c'
      (Cocone.ext ηM (by
        rintro (_ | _) <;>
          simp [c', b', d, i, i₁, i₂, parallelPairIsoMk, NatIso.ofComponents_inv_app]))).toFun
      (isColimitOfPreserves F hc.some)
  exact ⟨n, k, F.obj P, F.obj Q, fun i => η₁.inv ≫ F.map (ι i), fun i => η₁.inv ≫ F.map (κ i),
    hcof P ι hP, hcof Q κ hQ, F.map a, b', hab', ⟨hc'⟩⟩

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- **The ringed form of Stacks 04M0, for finite presentations.**  A finite global presentation
of the restriction of the étale pullback of an `𝒪_X`-module along an étale `f : Y ⟶ X` to an
étale chart `V` of `Y` gives one of the restriction of the module to the composite chart of `X`:
it is transported across the slice equivalence
`AlgebraicGeometry.Space.SmallEtale.postcompOverEquivalence`, as in
`AlgebraicGeometry.Space.hasGlobalPresentation_over_postcomp_iff`. -/
theorem hasFiniteGlobalPresentation_over_postcomp (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (V : (smallEtaleRingedSite B S hS Y.1 Y.2).C)
    (h : (((etaleModulePullback B S hS f hf).obj M).over V).HasFiniteGlobalPresentation) :
      (M.over ((ringedSitePostcomp B S hS f hf).obj V)).HasFiniteGlobalPresentation := by
  let E : Over V ≌ Over ((ringedSitePostcomp B S hS f hf).obj V) :=
    SmallEtale.postcompOverEquivalence B S hS f hf V
  have hc1 : E.functor.IsContinuous ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V)) :=
    SmallEtale.isContinuous_overPostcomp B S hS f hf V
  have hc2 : E.inverse.IsContinuous
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V))
      ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V) :=
    SmallEtale.isContinuous_postcompOverInverse B S hS f hf V
  let RY := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O)
  let RX := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O)
  let φ : RY.over V ⟶ (E.functor.sheafPushforwardContinuous RingCat.{u}
      ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V))).obj
      (RX.over ((ringedSitePostcomp B S hS f hf).obj V)) := 𝟙 _
  let ψ : RX.over ((ringedSitePostcomp B S hS f hf).obj V) ⟶
      (E.inverse.sheafPushforwardContinuous RingCat.{u}
        ((smallEtaleRingedSite B S hS X.1 X.2).J.over
          ((ringedSitePostcomp B S hS f hf).obj V))
        ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)).obj (RY.over V) := 𝟙 _
  have H₁ : Functor.whiskerRight (NatTrans.op E.counit)
      (RX.over ((ringedSitePostcomp B S hS f hf).obj V)).obj =
      ψ.hom ≫ E.inverse.op.whiskerLeft φ.hom := by
    ext : 2
    rfl
  have H₂ : φ.hom ≫ E.functor.op.whiskerLeft ψ.hom ≫
      Functor.whiskerRight (NatTrans.op E.unit) (RY.over V).obj = 𝟙 (RY.over V).obj := by
    ext : 2
    rfl
  let e₀ := SheafOfModules.pushforwardPushforwardEquivalence.{u} E φ ψ H₁ H₂
  let F₀ := SheafOfModules.pushforward.{u} φ
  let G₀ := SheafOfModules.pushforward.{u} ψ
  let G := SheafOfModules.pushforward.{u + 1} ψ
  have hGadj : G.IsLeftAdjoint :=
    Equivalence.isLeftAdjoint_functor
      (SheafOfModules.pushforwardPushforwardEquivalence.{u + 1} E φ ψ H₁ H₂).symm
  have hGzero : G.PreservesZeroMorphisms := ⟨fun _ _ => rfl⟩
  have key : F₀.obj (M.over ((ringedSitePostcomp B S hS f hf).obj V)) ≅
      ((etaleModulePullback B S hS f hf).obj M).over V :=
    (SheafOfModules.fullyFaithfulForget _).preimageIso
      (PresheafOfModules.isoMk (fun _ => Iso.refl _) (fun _ _ _ => by ext; rfl))
  have h' := Stacks.SheafOfModules.hasFiniteGlobalPresentation_map (F₀ := G₀) (F := G) _
    (Stacks.SheafOfModules.pushforwardUliftIso.{u + 1, u, u, u, u + 1} ψ
      (SheafOfModules.unit (RY.over V)))
    (Stacks.SheafOfModules.pushforwardUliftIso.{u + 1, u, u, u, u + 1} ψ
      (F₀.obj (M.over ((ringedSitePostcomp B S hS f hf).obj V))))
    (SheafOfModules.HasFiniteGlobalPresentation.of_iso key.symm h)
  exact SheafOfModules.HasFiniteGlobalPresentation.of_iso
    (e₀.unitIso.app (M.over ((ringedSitePostcomp B S hS f hf).obj V))).symm h'

namespace QuasiCoherentDescent

variable {I : Type*} (Yi : I → AlgebraicSpaces B S hS) (f : ∀ i, Yi i ⟶ X)
  (hf : ∀ i, IsEtale B S hS (f i).hom)

/-- The arrows into a chart of `X` whose source carries a finite global presentation of the
restriction of a module. -/
def finitePresentedArrows (M : Modules.{u, u} B S hS X.1 X.2)
    (W : (smallEtaleRingedSite B S hS X.1 X.2).C) : Presieve W :=
  fun Z _ => (M.over Z).HasFiniteGlobalPresentation

/-- **Finite presentation descends along a family of étale morphisms whose charts are cover
dense.**  An `𝒪_X`-module whose étale restriction to every member of the family is of finite
presentation is of finite presentation (Stacks 060V, étale case). -/
theorem isFinitePresentationOnSite_of_forall_etaleModulePullback
    [(memberFunctor B S hS Yi f hf).IsCoverDense (SmallEtale.topology B S hS X.1)]
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : ∀ i, ((etaleModulePullback.{u, u} B S hS (f i) (hf i)).obj M).IsFinitePresentationOnSite) :
    M.IsFinitePresentationOnSite := by
  have key : ∀ W : (smallEtaleRingedSite B S hS X.1 X.2).C,
      Sieve.generate (finitePresentedArrows B S hS M W) ∈
        (smallEtaleRingedSite B S hS X.1 X.2).J W := by
    intro W
    refine (smallEtaleRingedSite B S hS X.1 X.2).J.transitive
      ((memberFunctor B S hS Yi f hf).is_cover_of_isCoverDense
        (SmallEtale.topology B S hS X.1) W) _ ?_
    intro W' g hg
    obtain ⟨⟨p, a, -, -⟩⟩ := hg
    obtain ⟨I₁, W₁, g₁, hcov₁, hpres₁⟩ := (h p.1).locally_hasFiniteGlobalPresentation
      ((SmallEtale.postcompOverInverse B S hS (f p.1) (hf p.1) p.2).obj (Over.mk a)).left
    have hpush := (SmallEtale.coverPreserving_smallEtalePostcomp B S hS (f p.1)
      (hf p.1)).cover_preserve hcov₁
    have hle : Sieve.functorPushforward (ringedSitePostcomp B S hS (f p.1) (hf p.1))
        (Sieve.ofArrows W₁ g₁) ≤
        Sieve.generate (finitePresentedArrows B S hS M
          ((ringedSitePostcomp B S hS (f p.1) (hf p.1)).obj
            ((SmallEtale.postcompOverInverse B S hS (f p.1) (hf p.1) p.2).obj
              (Over.mk a)).left)) := by
      rintro T r ⟨Z₀, r₀, q, hr₀, rfl⟩
      obtain ⟨i₁, b, hb⟩ := (Sieve.mem_ofArrows_iff _ _ _).mp hr₀
      exact ⟨_, q ≫ (ringedSitePostcomp B S hS (f p.1) (hf p.1)).map b,
        (ringedSitePostcomp B S hS (f p.1) (hf p.1)).map (g₁ i₁),
        hasFiniteGlobalPresentation_over_postcomp B S hS (f p.1) (hf p.1) M (W₁ i₁)
          (hpres₁ i₁), (Category.assoc _ _ _).trans (congrArg (q ≫ ·)
          (((ringedSitePostcomp B S hS (f p.1) (hf p.1)).map_comp b (g₁ i₁)).symm.trans
            (congrArg _ hb.symm)))⟩
    have hobj := (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering hle hpush
    have hα := (smallEtaleRingedSite B S hS X.1 X.2).J.pullback_stable
      ((Over.forget ((smallEtalePostcomp B S hS (f p.1) (hf p.1)).obj p.2)).mapIso
        ((SmallEtale.postcompOverCounitIso B S hS (f p.1) (hf p.1) p.2).app (Over.mk a))).inv
      hobj
    refine (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering ?_ hα
    rintro T b ⟨Z, c, d, hd, hcd⟩
    exact ⟨Z, c, d ≫ ((Over.forget ((smallEtalePostcomp B S hS (f p.1) (hf p.1)).obj p.2)).mapIso
        ((SmallEtale.postcompOverCounitIso B S hS (f p.1) (hf p.1) p.2).app (Over.mk a))).hom ≫ g,
      hd, by
        rw [reassoc_of% hcd]
        have e1 := congrArg CommaMorphism.left
          ((SmallEtale.postcompOverCounitIso B S hS (f p.1) (hf p.1) p.2).inv_hom_id_app
            (Over.mk a))
        exact (Category.assoc _ _ _).trans (congrArg (b ≫ ·) ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ g) e1).trans (Category.id_comp g))))⟩
  refine ⟨fun W => ⟨{q : Σ Z : (smallEtaleRingedSite B S hS X.1 X.2).C, Z ⟶ W //
      (M.over q.1).HasFiniteGlobalPresentation}, fun q => q.1.1, fun q => q.1.2, ?_,
      fun q => q.2⟩⟩
  refine (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering ?_ (key W)
  rintro T b ⟨Z, c, d, hd, rfl⟩
  exact (Sieve.mem_ofArrows_iff _ _ _).2 ⟨⟨⟨Z, d⟩, hd⟩, c, rfl⟩

end QuasiCoherentDescent

/-- **Stacks 060V for an étale covering, on the small étale site.**  An `𝒪_X`-module whose
inverse images along the members of an étale covering of `X` are of finite presentation is of
finite presentation.  Along an étale morphism the inverse image is étale restriction
(Stacks 03LW), and the charts of the members of an étale covering are cover dense. -/
theorem isFinitePresentationOnSite_of_modulePullback_of_isEtaleCovering {I : Type*}
    (Yi : I → AlgebraicSpaces B S hS) (f : ∀ i, Yi i ⟶ X) (hf : ∀ i, IsEtale B S hS (f i).hom)
    (hcov : IsEtaleCovering B S hS (fun i => (Yi i).1) (fun i => (f i).hom))
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : ∀ i, ((modulePullback B S hS (f i)).obj M).IsFinitePresentationOnSite) :
    M.IsFinitePresentationOnSite := by
  have := QuasiCoherentDescent.isCoverDense_memberFunctor B S hS Yi f hf hcov
  exact QuasiCoherentDescent.isFinitePresentationOnSite_of_forall_etaleModulePullback B S hS Yi f
    hf M fun i => SheafOfModules.IsFinitePresentationOnSite.of_iso
      ((modulePullbackIsoEtaleModulePullback B S hS (f i) (hf i)).app M) (h i)

end AlgebraicGeometry.Space

end
