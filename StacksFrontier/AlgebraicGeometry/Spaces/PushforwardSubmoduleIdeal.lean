module

public import StacksFrontier.AlgebraicGeometry.Spaces.AffineBaseChangeChart
public import StacksFrontier.AlgebraicGeometry.Spaces.IdealPushforwardAffineComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.ModuleFiniteTypeQuotient
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePullbackSupport
public import StacksFrontier.AlgebraicGeometry.Spaces.PullbackIdealChartGeneration
public import StacksFrontier.AlgebraicGeometry.Spaces.PullbackIdealQuasicoherent

/-!
# Sheaves of ideals from submodules of the direct image of the structure sheaf

Let `f : Y ⟶ X` be an affine morphism of algebraic spaces over a scheme `S`.  A quasi-coherent
`𝒪_X`-submodule `ℳ ⊆ f_*𝒪_Y` which is moreover an `f_*𝒪_Y`-submodule — closed under
multiplication by the sections of `f_*𝒪_Y` — is the direct image `f_*ℐ` of a quasi-coherent sheaf
of ideals `ℐ ⊆ 𝒪_Y`; and `ℐ` is of finite type when `ℳ` is.  This is the step of the proof of
Stacks 0GV1 that reads off a sheaf of ideals of `Y_i` from the image of a map
`ℰ_i ⟶ π_{i,*}𝒪_{Y_i}` whose image is a `π_{i,*}𝒪_{Y_i}`-submodule.

## Main definitions

* `AlgebraicGeometry.Space.submoduleIdeal`: the sheaf of ideals `ℳ · 𝒪_Y` generated by the
  sections of `ℳ`, read on `Y`: the smallest sheaf of ideals `ℐ` of `𝒪_Y` with `ℳ ⊆ f_*ℐ`.

## Main results

* `AlgebraicGeometry.Space.le_pushforwardSubmodule_submoduleIdeal`: `ℳ ⊆ f_*(ℳ · 𝒪_Y)`, for any
  representable `f`.
* `AlgebraicGeometry.Space.pushforwardSubmodule_submoduleIdeal_le`: `f_*(ℳ · 𝒪_Y) ⊆ ℳ` for an
  affine `f`, a quasi-coherent `ℳ` and `ℳ` closed under multiplication by `f_*𝒪_Y`.
* `AlgebraicGeometry.Space.isQuasicoherentOnSite_submoduleIdeal` and
  `AlgebraicGeometry.Space.isFiniteTypeOnSite_submoduleIdeal`: `ℳ · 𝒪_Y` is quasi-coherent, and of
  finite type when `ℳ` is.
* `AlgebraicGeometry.Space.exists_ideal_pushforwardSubmodule_eq`: the correspondence, in the form
  the proof of Stacks 0GV1 uses it.

## Implementation notes

The ideal `ℳ · 𝒪_Y` is built as the closure of the objectwise ideal spanned by the restrictions,
along morphisms `W ⟶ Q ×_X Y` of étale charts of `Y`, of the sections of `ℳ` over the charts `Q`
of `X`; this is the construction of `AlgebraicGeometry.Space.pullbackIdealPresheaf` with the
sections of `ℳ ⊆ f_*𝒪_Y` in place of the pulled-back sections of an ideal of `𝒪_X`.

Quasi-coherence is the argument of
`AlgebraicGeometry.Space.isQuasicoherentOnSite_pullbackIdealSubsheaf`: the ideal is the image of
the adjoint `f^*ℳ ⟶ 𝒪_Y` of the inclusion `ℳ ⟶ f_*𝒪_Y`, and the source is quasi-coherent by
Stacks 03GA.  Finite type follows from the same description, the image being a quotient of `f^*ℳ`.

The inclusion `f_*(ℳ · 𝒪_Y) ⊆ ℳ` is faithfully flat descent of ideal membership over an affine
chart (`AlgebraicGeometry.Space.mem_of_forall_restrict_mem_map`): over an affine chart `Q` of `X`
the base change `Q ×_X Y` is affine because `f` is, the sections of `ℳ` over `Q` form an ideal
of the ring of `Q ×_X Y` because `ℳ` is an `f_*𝒪_Y`-submodule, and a generator coming from
another chart `Q'` is compared with that ideal over the product chart `Q ×_X Q'` and an affine
covering of it, where `ℳ` is cartesian on affine charts.

## References

* [Stacks Project, Tag 0GV1](https://stacks.math.columbia.edu/tag/0GV1)
* [Stacks Project, Tag 03GA](https://stacks.math.columbia.edu/tag/03GA)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

attribute [local instance] AlgebraicGeometry.Space.isContinuous_smallBaseChange

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)
  (hf : yoneda.relativelyRepresentable f.hom)
  (M : ((smallBaseChangeModulePushforward.{u, u} B S hS f hf).obj
    (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2))).Submodule)

/-! ### The direct image of a submodule as a module -/

section PushforwardSubmoduleIso

variable (F : SheafOfModules.{u} (smallEtaleRingSheaf B S hS Y.1 Y.2)) (P : F.Submodule)

/-- The direct image of the inclusion of a submodule is a monomorphism, the direct image being a
right adjoint. -/
theorem mono_map_ι_smallBaseChangeModulePushforward :
    Mono ((smallBaseChangeModulePushforward.{u, u} B S hS f hf).map P.ι) :=
  have := (SheafOfModules.pullbackPushforwardAdjunction.{u}
    (smallBaseChangeSharp B S hS f hf)).isRightAdjoint
  inferInstanceAs (Mono ((SheafOfModules.pushforward.{u} (smallBaseChangeSharp B S hS f hf)).map
    P.ι))

/-- The range of the direct image of the inclusion of a submodule `P ⊆ F` is the direct image
`f_*P` of `P` as a submodule of `f_*F`. -/
theorem monoRangeSubmodule_map_ι_eq :
    haveI := mono_map_ι_smallBaseChangeModulePushforward B S hS f hf F P
    Stacks.SheafOfModules.ImageSubsheaf.monoRangeSubmodule
        ((smallBaseChangeModulePushforward.{u, u} B S hS f hf).map P.ι) =
      pushforwardSubmodule B S hS f hf F P := by
  refine SheafOfModules.Submodule.ext ?_
  ext ⟨Q⟩ x
  refine ⟨?_, fun hx => ⟨⟨x, hx⟩, rfl⟩⟩
  rintro ⟨y, rfl⟩
  exact y.2

/-- **The direct image of a submodule `P ⊆ F`, as a module, is the direct image `f_*P` of the
module `P`.** -/
def pushforwardSubmoduleIso :
    (pushforwardSubmodule B S hS f hf F P).toSheafOfModules ≅
      (smallBaseChangeModulePushforward.{u, u} B S hS f hf).obj P.toSheafOfModules :=
  haveI := mono_map_ι_smallBaseChangeModulePushforward B S hS f hf F P
  eqToIso (congrArg SheafOfModules.Submodule.toSheafOfModules
      (monoRangeSubmodule_map_ι_eq B S hS f hf F P).symm) ≪≫
    (Stacks.SheafOfModules.ImageSubsheaf.monoRangeSubmoduleIso _).symm

end PushforwardSubmoduleIso

/-! ### The ideal generated by a submodule of the direct image -/

/-- **The generators of `ℳ · 𝒪_Y` over an étale chart `W` of `Y`**: the restrictions along a
morphism `W ⟶ Q ×_X Y` of the sections of `ℳ ⊆ f_*𝒪_Y` over an étale chart `Q` of `X`. -/
def submoduleIdealGenerators (W : SmallEtale B S hS Y.1) :
    Set ((SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).val.obj (op W)) :=
  {z | ∃ (Q : SmallEtale B S hS X.1) (w : W ⟶ (smallBaseChange B S hS f hf).obj Q)
    (m : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)),
      m ∈ M.obj (op Q) ∧
      z = (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).val.map w.op m}

/-- **The objectwise ideal `ℳ · 𝒪_Y`**: over every étale chart of `Y`, the ideal spanned by the
restricted sections of `ℳ`. -/
def submoduleIdealPresheaf :
    (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).val.Submodule where
  obj W := Submodule.span (chartSectionsRing B S hS Y W.unop)
    (submoduleIdealGenerators B S hS f hf M W.unop)
  map {W V} g := by
    refine Submodule.span_le.2 ?_
    rintro z ⟨Q, w, m, hm, rfl⟩
    exact Submodule.mem_comap.2 (Submodule.subset_span ⟨Q, g.unop ≫ w, m, hm,
      ((SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).val.map_comp_apply
        w.op g _).symm⟩)

/-- **The sheaf of ideals `ℳ · 𝒪_Y` generated by a submodule `ℳ ⊆ f_*𝒪_Y`**, the closure of the
objectwise ideal spanned by the restricted sections of `ℳ`.  It is the smallest sheaf of ideals
`ℐ ⊆ 𝒪_Y` with `ℳ ⊆ f_*ℐ` (`AlgebraicGeometry.Space.le_pushforwardSubmodule_submoduleIdeal` and
`AlgebraicGeometry.Space.submoduleIdeal_le`). -/
def submoduleIdeal : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).Submodule :=
  Stacks.SheafOfModules.sheafifySubmodule (submoduleIdealPresheaf B S hS f hf M)

/-- `ℳ ⊆ f_*(ℳ · 𝒪_Y)`. -/
theorem le_pushforwardSubmodule_submoduleIdeal :
    M ≤ pushforwardSubmodule B S hS f hf _ (submoduleIdeal B S hS f hf M) := by
  rintro ⟨Q⟩ m hm
  exact Stacks.SheafOfModules.mem_sheafifySubmodule_of_mem
    ((SmallEtale.topology B S hS Y.1).top_mem _) fun W w _ =>
      Submodule.subset_span ⟨Q, w, m, hm, rfl⟩

/-- `ℳ · 𝒪_Y` is the smallest sheaf of ideals `ℐ ⊆ 𝒪_Y` with `ℳ ⊆ f_*ℐ`. -/
theorem submoduleIdeal_le
    {P : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).Submodule}
    (hP : M ≤ pushforwardSubmodule B S hS f hf _ P) :
    submoduleIdeal B S hS f hf M ≤ P := by
  refine Stacks.SheafOfModules.sheafifySubmodule_le fun W => Submodule.span_le.2 ?_
  rintro z ⟨Q, w, m, hm, rfl⟩
  exact P.toSubmodule.map_mem w.op (hP (op Q) hm)

/-! ### Quasi-coherence and finite type -/

section KernelCokernel

attribute [local instance 5000] SheafOfModules.instAbelian

/-- The adjoint `f^*ℳ ⟶ 𝒪_Y` of the inclusion `ℳ ⟶ f_*𝒪_Y`. -/
def submoduleToUnit :
    (SheafOfModules.pullback.{u} (smallBaseChangeSharp B S hS f hf)).obj M.toSheafOfModules ⟶
      SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2) :=
  ((SheafOfModules.pullbackPushforwardAdjunction.{u}
    (smallBaseChangeSharp B S hS f hf)).homEquiv _ _).symm M.ι

/-- The inclusion `ℳ ⟶ f_*𝒪_Y` is the unit of the adjunction followed by the direct image of its
adjoint. -/
theorem submodule_ι_eq :
    M.ι = (SheafOfModules.pullbackPushforwardAdjunction.{u}
        (smallBaseChangeSharp B S hS f hf)).unit.app M.toSheafOfModules ≫
      (SheafOfModules.pushforward.{u} (smallBaseChangeSharp B S hS f hf)).map
        (submoduleToUnit B S hS f hf M) := by
  rw [submoduleToUnit]
  exact (((SheafOfModules.pullbackPushforwardAdjunction.{u}
    (smallBaseChangeSharp B S hS f hf)).homEquiv_unit _ _ _).symm.trans
      (Equiv.apply_symm_apply _ _)).symm

/-- **`ℳ · 𝒪_Y` is the image of `f^*ℳ ⟶ 𝒪_Y`**, the kernel of the cokernel of the adjoint of the
inclusion `ℳ ⟶ f_*𝒪_Y`. -/
theorem submoduleIdeal_eq_ker_cokernel :
    submoduleIdeal B S hS f hf M =
      SheafOfModules.Submodule.ker (cokernel.π (submoduleToUnit B S hS f hf M)) := by
  set θ := submoduleToUnit B S hS f hf M with hθ
  set P := submoduleIdeal B S hS f hf M
  set adj := SheafOfModules.pullbackPushforwardAdjunction.{u} (smallBaseChangeSharp B S hS f hf)
  refine le_antisymm (submoduleIdeal_le B S hS f hf M fun Q a ha => ?_) ?_
  · show _ = (0 : (cokernel θ).val.obj _)
    have h : M.ι.val.app Q ⟨a, ha⟩ = a := rfl
    rw [submodule_ι_eq] at h
    rw [← h]
    show (θ ≫ cokernel.π θ).val.app _ _ = 0
    rw [cokernel.condition]
    rfl
  · have hc : θ ≫ cokernel.π P.ι = 0 := by
      have h0 : M.ι ≫ (SheafOfModules.pushforward.{u} (smallBaseChangeSharp B S hS f hf)).map
            (cokernel.π P.ι) = 0 := by
        ext Q a
        show (cokernel.π P.ι).val.app _ (P.ι.val.app _
          ⟨a.1, le_pushforwardSubmodule_submoduleIdeal B S hS f hf M Q a.2⟩) = 0
        show (P.ι ≫ cokernel.π P.ι).val.app _ _ = 0
        rw [cokernel.condition]
        rfl
      have h1 := Adjunction.homEquiv_naturality_right_symm adj M.ι (cokernel.π P.ι)
      rw [hθ, submoduleToUnit, ← h1]
      refine (congrArg (adj.homEquiv _ _).symm h0).trans ?_
      rw [Adjunction.homEquiv_counit, Functor.map_zero, zero_comp]
    intro W x hx
    have hx' : (cokernel.π P.ι).val.app W x = 0 := by
      have e : cokernel.π P.ι = cokernel.π θ ≫ cokernel.desc θ (cokernel.π P.ι) hc :=
        (cokernel.π_desc _ _ _).symm
      rw [e]
      show (cokernel.desc θ (cokernel.π P.ι) hc).val.app W
        ((cokernel.π θ).val.app W x) = 0
      rw [(SheafOfModules.Submodule.mem_ker _ W x).1 hx]
      exact map_zero _
    let k := SheafOfModules.Submodule.ker (cokernel.π P.ι)
    obtain ⟨l, hl⟩ := KernelFork.IsLimit.lift' (Abelian.monoIsKernelOfCokernel
      (CokernelCofork.ofπ (cokernel.π P.ι) (cokernel.condition P.ι)) (cokernelIsCokernel P.ι))
      k.ι (SheafOfModules.Submodule.ker_ι_comp _)
    have hxk : x ∈ k.obj W := hx'
    have hxl : P.ι.val.app W (l.val.app W ⟨x, hxk⟩) = x := by
      show (l ≫ P.ι).val.app W ⟨x, hxk⟩ = x
      rw [show l ≫ P.ι = k.ι from hl]
      rfl
    rw [← hxl]
    exact (l.val.app W ⟨x, hxk⟩).2

/-- The source `f^*ℳ` of `f^*ℳ ⟶ 𝒪_Y` is quasi-coherent when `ℳ` is, by Stacks 03GA. -/
private theorem isQuasicoherentOnSite_pullback_submodule
    (hM : M.toSheafOfModules.IsQuasicoherentOnSite) :
    ((SheafOfModules.pullback.{u} (smallBaseChangeSharp B S hS f hf)).obj
      M.toSheafOfModules).IsQuasicoherentOnSite :=
  SheafOfModules.IsQuasicoherentOnSite.of_iso
    ((modulePullbackChartIso B S hS f hf).app M.toSheafOfModules)
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS f _ hM)

/-- **`ℳ · 𝒪_Y` is quasi-coherent** when `ℳ` is: it is the image of `f^*ℳ ⟶ 𝒪_Y`, whose source is
quasi-coherent by Stacks 03GA. -/
theorem isQuasicoherentOnSite_submoduleIdeal
    (hM : M.toSheafOfModules.IsQuasicoherentOnSite) :
    (submoduleIdeal B S hS f hf M).toSheafOfModules.IsQuasicoherentOnSite := by
  set Qc := SheafOfModules.isQuasicoherentOnSite.{u + 1, u, u, u}
    (smallEtaleRingSheaf B S hS Y.1 Y.2)
  have : Qc.IsClosedUnderKernels :=
    isClosedUnderKernels_quasicoherentSheaves_smallEtale B S hS Y.1 Y.2
  have : Qc.IsClosedUnderCokernels := isClosedUnderCokernels_quasicoherentSheaves B S hS Y.1 Y.2
  have hunit : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).IsQuasicoherentOnSite :=
    SheafOfModules.isQuasicoherentOnSite_unit _
  have hcok := Qc.prop_cokernel (submoduleToUnit B S hS f hf M)
    (isQuasicoherentOnSite_pullback_submodule B S hS f hf M hM) hunit
  rw [submoduleIdeal_eq_ker_cokernel]
  exact SheafOfModules.IsQuasicoherentOnSite.of_iso
    (SheafOfModules.Submodule.kerIsoKernel _).symm (Qc.prop_kernel _ hunit hcok)

end KernelCokernel

/-- `ℳ · 𝒪_Y` is the image of `f^*ℳ ⟶ 𝒪_Y`, as an isomorphism of `𝒪_Y`-modules. -/
def submoduleIdealIsoImage :
    ((submoduleIdeal B S hS f hf M).toSheafOfModules : Modules.{u, u} B S hS Y.1 Y.2) ≅
      Abelian.image (C := Modules.{u, u} B S hS Y.1 Y.2) (submoduleToUnit B S hS f hf M) :=
  eqToIso (by rw [submoduleIdeal_eq_ker_cokernel]; rfl) ≪≫
    SheafOfModules.Submodule.kerIsoKernel _

/-- **`ℳ · 𝒪_Y` is of finite type** when `ℳ` is: it is a quotient of `f^*ℳ`, which is of finite
type by Stacks 03DO. -/
theorem isFiniteTypeOnSite_submoduleIdeal
    (hM : SheafOfModules.IsFiniteTypeOnSite (M.toSheafOfModules : Modules.{u, u} B S hS X.1 X.2)) :
    SheafOfModules.IsFiniteTypeOnSite
      ((submoduleIdeal B S hS f hf M).toSheafOfModules : Modules.{u, u} B S hS Y.1 Y.2) := by
  have h1 : SheafOfModules.IsFiniteTypeOnSite
      ((SheafOfModules.pullback.{u} (smallBaseChangeSharp B S hS f hf)).obj M.toSheafOfModules :
        Modules.{u, u} B S hS Y.1 Y.2) :=
    @isFiniteTypeOnSite_of_epi B S hS Y.1 Y.2 _ _
      ((modulePullbackChartIso B S hS f hf).app M.toSheafOfModules).hom
      (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _))
      (isFiniteTypeOnSite_modulePullback B S hS f _ hM)
  exact @isFiniteTypeOnSite_of_epi B S hS Y.1 Y.2 _ _
    (submoduleIdealIsoImage B S hS f hf M).inv
    (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom (submoduleIdealIsoImage B S hS f hf M).symm))
    (isFiniteTypeOnSite_image B S hS Y.1 Y.2 (submoduleToUnit B S hS f hf M) h1)

/-! ### The direct image of `ℳ · 𝒪_Y` over an affine morphism -/

section Descent

variable {M}

/-- The sections of `ℳ` over an étale chart `Q` of `X`, as an ideal of the ring of the base
change `Q ×_X Y`, when `ℳ` is closed under multiplication by `f_*𝒪_Y`. -/
def submoduleChartIdeal
    (hmul : ∀ (Q : SmallEtale B S hS X.1)
      (b m : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)),
        m ∈ M.obj (op Q) → b * m ∈ M.obj (op Q))
    (Q : SmallEtale B S hS X.1) :
    Ideal (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)) where
  carrier := {m | m ∈ M.obj (op Q)}
  zero_mem' := Submodule.zero_mem _
  add_mem' := fun h₁ h₂ => Submodule.add_mem _ h₁ h₂
  smul_mem' := fun b m hm => hmul Q b m hm

variable (M) in
/-- The ideal of the ring of the base change `Q ×_X Y` generated by the sections of `ℳ` over an
étale chart `Q` of `X`.  It is the ideal of those sections, `submoduleChartIdeal`, when `ℳ` is
closed under multiplication by `f_*𝒪_Y`. -/
def submoduleChartSpan (Q : SmallEtale B S hS X.1) :
    Ideal (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)) :=
  Ideal.span {m | m ∈ M.obj (op Q)}

variable (hmul : ∀ (Q : SmallEtale B S hS X.1)
      (b m : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)),
        m ∈ M.obj (op Q) → b * m ∈ M.obj (op Q))
  (hMc : IsCartesianOnAffineCharts (hF := X.2) M.toSheafOfModules)

/-- A section of `ℳ` over an étale chart `Q` of `X`, read as a regular function on `Q ×_X Y`. -/
private def secVal {Q : SmallEtale B S hS X.1} (y : M.toSheafOfModules.val.obj (op Q)) :
    chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q) :=
  (M.ι.val.app (op Q) y :
    (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).val.obj
      (op ((smallBaseChange B S hS f hf).obj Q)))

private theorem secVal_mem {Q : SmallEtale B S hS X.1} (y : M.toSheafOfModules.val.obj (op Q)) :
    secVal B S hS f hf y ∈ M.obj (op Q) :=
  y.2


private theorem secVal_restrict {Q Z : SmallEtale B S hS X.1} (p : Z ⟶ Q)
    (y : M.toSheafOfModules.val.obj (op Q)) :
    secVal B S hS f hf (M.toSheafOfModules.val.map p.op y) =
      chartSectionsRestrict B S hS Y ((smallBaseChange B S hS f hf).map p)
        (secVal B S hS f hf y) :=
  rfl

private theorem secVal_add {Q : SmallEtale B S hS X.1} (y z : M.toSheafOfModules.val.obj (op Q)) :
    secVal B S hS f hf (y + z) = secVal B S hS f hf y + secVal B S hS f hf z :=
  rfl

private theorem secVal_zero {Q : SmallEtale B S hS X.1} :
    secVal B S hS f hf (0 : M.toSheafOfModules.val.obj (op Q)) = 0 :=
  rfl

private theorem secVal_smul {Q : SmallEtale B S hS X.1} (a : chartSectionsRing B S hS X Q)
    (y : M.toSheafOfModules.val.obj (op Q)) :
    secVal B S hS f hf (a • y) = chartIdealPullbackHom B S hS f hf Q a * secVal B S hS f hf y :=
  rfl

include hMc in
/-- **Over a morphism `p : Z ⟶ Q` of affine charts of `X`, the restricted sections of `ℳ` over `Z`
lie in the ideal generated by the sections over `Q`.**  The sections of `ℳ` over `Z` are an
`𝒪_X(Z)`-combination of restrictions of sections over `Q`, because `ℳ` is cartesian on affine
charts, and `𝒪_X(Z)` acts on `f_*𝒪_Y` through `f♯`. -/
private theorem restrict_mem_map_of_isAffine
    {Q Z : SmallEtale B S hS X.1} (p : Z ⟶ Q)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    (hZ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Z))
    {W : SmallEtale B S hS Y.1} (n : W ⟶ (smallBaseChange B S hS f hf).obj Z)
    {m : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Z)}
    (hm : m ∈ M.obj (op Z)) :
    chartSectionsRestrict B S hS Y n m ∈
      Ideal.map (chartSectionsRestrict B S hS Y (n ≫ (smallBaseChange B S hS f hf).map p))
        (submoduleChartSpan B S hS f hf M Q) := by
  have hspan := mem_span_range_restrict_of_isCartesianOnAffineCharts B S hS X
    M.toSheafOfModules hMc hQ hZ p ⟨m, hm⟩
  let J' : Ideal (chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Z)) :=
    Ideal.comap (chartSectionsRestrict B S hS Y n)
      (Ideal.map (chartSectionsRestrict B S hS Y (n ≫ (smallBaseChange B S hS f hf).map p))
        (submoduleChartSpan B S hS f hf M Q))
  have key : secVal B S hS f hf (M := M) ⟨m, hm⟩ ∈ J' := by
    refine Submodule.span_induction (p := fun (y : M.toSheafOfModules.val.obj (op Z)) _ =>
        secVal B S hS f hf y ∈ J') ?_ ?_ ?_ ?_ hspan
    · rintro _ ⟨y', rfl⟩
      refine Ideal.mem_comap.2 ?_
      rw [secVal_restrict, ← chartSectionsRestrict_comp_apply]
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span (secVal_mem B S hS f hf y'))
    · rw [secVal_zero]
      exact J'.zero_mem
    · intro y z _ _ hy hz
      rw [secVal_add]
      exact J'.add_mem hy hz
    · intro a y _ hy
      rw [secVal_smul]
      exact J'.mul_mem_left _ hy
  exact Ideal.mem_comap.1 key

include hMc in
/-- **A restricted section of `ℳ` over any chart `P` lying over an affine chart `Q` lies in the
ideal generated by the sections over `Q`**, read over an affine chart of `Y`.  The chart `P` is
covered by affine charts, and `AlgebraicGeometry.Space.mem_of_forall_restrict_mem_map` descends
the affine case. -/
private theorem restrict_mem_map
    {Q P : SmallEtale B S hS X.1} (p : P ⟶ Q)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    {V : SmallEtale B S hS Y.1} (n : V ⟶ (smallBaseChange B S hS f hf).obj P)
    (hV : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    {m : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj P)}
    (hm : m ∈ M.obj (op P)) :
    chartSectionsRestrict B S hS Y n m ∈
      Ideal.map (chartSectionsRestrict B S hS Y (n ≫ (smallBaseChange B S hS f hf).map p))
        (submoduleChartSpan B S hS f hf M Q) := by
  obtain ⟨ι, Zc, c, hZaff, -, hZet⟩ := SmallEtale.exists_affine_etale_ofArrows B S hS X.1 P
  have hbccov := SmallEtale.ofArrows_mem_topology B S hS Y.1
    (fun i ↦ (smallBaseChange B S hS f hf).obj (Zc i))
    (fun i ↦ (smallBaseChange B S hS f hf).map (c i))
    (etalePrecoverage_smallBaseChange_ofArrows B S hS f hf Zc c hZet)
  refine mem_of_forall_restrict_mem_map B S hS Y hV
    ((SmallEtale.topology B S hS Y.1).pullback_stable n hbccov) _ ?_
  intro W g hg hWaff
  obtain ⟨i, w', heq⟩ : ∃ (i : ι) (w' : W ⟶ (smallBaseChange B S hS f hf).obj (Zc i)),
      w' ≫ (smallBaseChange B S hS f hf).map (c i) = g ≫ n := by
    obtain ⟨-, u, -, ⟨j⟩, he⟩ := hg
    exact ⟨j, u, he⟩
  have hrestr : chartSectionsRestrict B S hS Y g (chartSectionsRestrict B S hS Y n m) =
      chartSectionsRestrict B S hS Y w'
        (chartSectionsRestrict B S hS Y ((smallBaseChange B S hS f hf).map (c i)) m) := by
    rw [← chartSectionsRestrict_comp_apply, ← chartSectionsRestrict_comp_apply, heq]
  rw [hrestr]
  have hmem := restrict_mem_map_of_isAffine B S hS f hf hMc (c i ≫ p) hQ (hZaff i) w'
    (M.map_mem (c i).op hm)
  have hcomp : w' ≫ (smallBaseChange B S hS f hf).map (c i ≫ p) =
      g ≫ (n ≫ (smallBaseChange B S hS f hf).map p) := by
    rw [Functor.map_comp, ← Category.assoc, heq, Category.assoc]
  rwa [hcomp, map_chartSectionsRestrict_comp] at hmem

include hMc in
/-- **Over an affine chart `W` of `Y` above the base change of an affine chart `Q` of `X`, the
objectwise ideal `ℳ · 𝒪_Y` is generated by the sections of `ℳ` over the single chart `Q`.**  A
generator from another chart `Q'` is compared with them over the product chart `Q ×_X Q'`. -/
private theorem submoduleIdealPresheaf_le_map
    (Q : SmallEtale B S hS X.1)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    (W : SmallEtale B S hS Y.1) (v : W ⟶ (smallBaseChange B S hS f hf).obj Q)
    (hW : IsAffine ((SmallEtale.toOver B S hS Y.1 ⋙ BigFppfOver.toScheme B S hS).obj W)) :
    (submoduleIdealPresheaf B S hS f hf M).obj (op W) ≤
      Ideal.map (chartSectionsRestrict B S hS Y v) (submoduleChartSpan B S hS f hf M Q) := by
  refine Submodule.span_le.2 ?_
  rintro zz ⟨Q', w, m, hm, rfl⟩
  have hgen : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).val.map w.op m =
      chartSectionsRestrict B S hS Y (smallBaseChangeProdLift B S hS f hf v w)
        (chartSectionsRestrict B S hS Y
          ((smallBaseChange B S hS f hf).map (SmallEtale.prodSnd B S hS X.1 Q Q')) m) := by
    show chartSectionsRestrict B S hS Y w m = _
    rw [← chartSectionsRestrict_comp_apply, smallBaseChangeProdLift_snd]
  rw [hgen]
  have hmem := restrict_mem_map B S hS f hf hMc
    (SmallEtale.prodFst B S hS X.1 Q Q') hQ (smallBaseChangeProdLift B S hS f hf v w) hW
    (M.map_mem (SmallEtale.prodSnd B S hS X.1 Q Q').op hm)
  rwa [smallBaseChangeProdLift_fst] at hmem

include hMc in
/-- **Over an affine chart `Q` of `X`, a section of `f_*(ℳ · 𝒪_Y)` lies in the ideal of the ring of
`Q ×_X Y` generated by the sections of `ℳ` over `Q`**, for an affine morphism `f` and a submodule
`ℳ ⊆ f_*𝒪_Y` cartesian on affine charts.  No closure of `ℳ` under multiplication is needed. -/
theorem mem_submoduleChartSpan_of_mem_submoduleIdeal_of_isAffine
    (haff : IsAffineHom B S hS f.hom) (Q : SmallEtale B S hS X.1)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    {x : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)}
    (hx : x ∈ (submoduleIdeal B S hS f hf M).obj (op ((smallBaseChange B S hS f hf).obj Q))) :
    x ∈ submoduleChartSpan B S hS f hf M Q := by
  obtain ⟨T, hT, hTx⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule hx
  have hV := isAffine_smallBaseChange_obj B S hS f hf haff Q hQ
  refine mem_of_forall_restrict_mem_map B S hS Y hV hT _ fun W g hg hW => ?_
  exact submoduleIdealPresheaf_le_map B S hS f hf hMc Q hQ W g hW (hTx g hg)

include hmul hMc in
/-- The inclusion `f_*(ℳ · 𝒪_Y) ⊆ ℳ` over an affine chart of `X`. -/
private theorem mem_of_mem_submoduleIdeal_of_isAffine (haff : IsAffineHom B S hS f.hom)
    (Q : SmallEtale B S hS X.1)
    (hQ : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj Q))
    {x : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)}
    (hx : x ∈ (submoduleIdeal B S hS f hf M).obj (op ((smallBaseChange B S hS f hf).obj Q))) :
    x ∈ M.obj (op Q) := by
  have h := mem_submoduleChartSpan_of_mem_submoduleIdeal_of_isAffine B S hS f hf hMc haff Q hQ hx
  have hspan : submoduleChartSpan B S hS f hf M Q = submoduleChartIdeal B S hS f hf hmul Q :=
    Ideal.span_eq (submoduleChartIdeal B S hS f hf hmul Q)
  rwa [hspan] at h

include hmul hMc in
/-- **`f_*(ℳ · 𝒪_Y) ⊆ ℳ`** for an affine morphism `f`, a submodule `ℳ ⊆ f_*𝒪_Y` cartesian on
affine charts and closed under multiplication by `f_*𝒪_Y`.  Membership in `ℳ` is local, which
reduces to an affine chart `Q` of `X`; there `Q ×_X Y` is affine and the sections of `ℳ` over `Q`
form an ideal of its ring, and faithfully flat descent of ideal membership concludes. -/
theorem pushforwardSubmodule_submoduleIdeal_le (haff : IsAffineHom B S hS f.hom) :
    pushforwardSubmodule B S hS f hf _ (submoduleIdeal B S hS f hf M) ≤ M := by
  rintro ⟨Q⟩ x hx
  obtain ⟨ι, Zc, c, hZaff, hcov, -⟩ := SmallEtale.exists_affine_etale_ofArrows B S hS X.1 Q
  refine M.isSheaf x ((SmallEtale.topology B S hS X.1).superset_covering ?_ hcov)
  intro Z g hg
  obtain ⟨j, h, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
  have hj : ((smallBaseChangeModulePushforward.{u, u} B S hS f hf).obj
      (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2))).val.map (c j).op x ∈
        M.obj (op (Zc j)) :=
    mem_of_mem_submoduleIdeal_of_isAffine B S hS f hf hmul hMc haff (Zc j) (hZaff j)
      ((submoduleIdeal B S hS f hf M).map_mem ((smallBaseChange B S hS f hf).map (c j)).op hx)
  show ((smallBaseChangeModulePushforward.{u, u} B S hS f hf).obj
      (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2))).val.map
        ((c j).op ≫ h.op) x ∈ M.obj (op Z)
  rw [PresheafOfModules.map_comp_apply]
  exact M.map_mem h.op hj

include hmul hMc in
/-- **`f_*(ℳ · 𝒪_Y) = ℳ`** for an affine morphism `f` and a submodule `ℳ ⊆ f_*𝒪_Y` cartesian on
affine charts and closed under multiplication by `f_*𝒪_Y`. -/
theorem pushforwardSubmodule_submoduleIdeal_eq (haff : IsAffineHom B S hS f.hom) :
    pushforwardSubmodule B S hS f hf _ (submoduleIdeal B S hS f hf M) = M :=
  le_antisymm (pushforwardSubmodule_submoduleIdeal_le B S hS f hf hmul hMc haff)
    (le_pushforwardSubmodule_submoduleIdeal B S hS f hf M)

end Descent

/-- **Quasi-coherent `f_*𝒪_Y`-submodules of `f_*𝒪_Y` are direct images of quasi-coherent sheaves
of ideals.**  Let `f : Y ⟶ X` be an affine morphism of algebraic spaces and let `ℳ ⊆ f_*𝒪_Y` be a
quasi-coherent `𝒪_X`-submodule closed under multiplication by the sections of `f_*𝒪_Y`.  Then
`ℳ = f_*ℐ` for a quasi-coherent sheaf of ideals `ℐ ⊆ 𝒪_Y`, which is of finite type when `ℳ` is.

This is the step of the proof of Stacks 0GV1 that turns the image of `ℰ_i ⟶ π_{i,*}𝒪_{Y_i}`
into the direct image of a sheaf of ideals of `Y_i`. -/
theorem exists_ideal_pushforwardSubmodule_eq (haff : IsAffineHom B S hS f.hom)
    (hmul : ∀ (Q : SmallEtale B S hS X.1)
      (b m : chartSectionsRing B S hS Y ((smallBaseChange B S hS f hf).obj Q)),
        m ∈ M.obj (op Q) → b * m ∈ M.obj (op Q))
    (hM : M.toSheafOfModules.IsQuasicoherentOnSite) :
    ∃ I : (SheafOfModules.unit (smallEtaleRingSheaf B S hS Y.1 Y.2)).Submodule,
      I.toSheafOfModules.IsQuasicoherentOnSite ∧
      (SheafOfModules.IsFiniteTypeOnSite
          (M.toSheafOfModules : Modules.{u, u} B S hS X.1 X.2) →
        SheafOfModules.IsFiniteTypeOnSite
          (I.toSheafOfModules : Modules.{u, u} B S hS Y.1 Y.2)) ∧
      pushforwardSubmodule B S hS f hf _ I = M :=
  ⟨submoduleIdeal B S hS f hf M, isQuasicoherentOnSite_submoduleIdeal B S hS f hf M hM,
    isFiniteTypeOnSite_submoduleIdeal B S hS f hf M,
    pushforwardSubmodule_submoduleIdeal_eq B S hS f hf hmul
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hM) haff⟩

end AlgebraicGeometry.Space

