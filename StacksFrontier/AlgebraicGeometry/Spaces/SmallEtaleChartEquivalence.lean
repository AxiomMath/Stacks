module

public import Mathlib.CategoryTheory.Sites.Equivalence
public import Mathlib.CategoryTheory.Sites.InducedTopology
public import Mathlib.CategoryTheory.Sites.Over
public import StacksFrontier.AlgebraicGeometry.Spaces.Representable
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleComparison
public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.CoverPreserving
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Precoverage

/-!
# Étale localization at a scheme chart

Let `F` be an algebraic space over a scheme `S` contained in a big fppf site `B`, and let `X` be
an étale scheme chart of `F`, with underlying object `U` of the big fppf site of `S`. This file
identifies the small étale site of the representable presheaf `h_U` with the localization of the
small étale site of `F` at the chart `X`.

## Main definitions

* `AlgebraicGeometry.Space.SmallEtale.chartLocalization` and
  `AlgebraicGeometry.Space.SmallEtale.chartLocalizationInverse` are the two functors between the
  small étale site of `h_U` and the slice of the small étale site of `F` at `X`, and
  `AlgebraicGeometry.Space.SmallEtale.chartLocalizationEquivalence` is the equivalence they form.

## Main results

* `AlgebraicGeometry.Space.smallEtaleEquivalenceOverChart` is Stacks 04M0: the small étale site
  of `h_U` is the localization of the small étale site of `F` at `X`, by an equivalence
  compatible with the topologies and with the whole structure arrow to the chart.
* `AlgebraicGeometry.BigFppfSite.etalePrecoverage_isStableUnderBaseChange`: the chosen étale
  covering families of a big fppf site are stable under base change.
* `AlgebraicGeometry.Space.SmallEtale.precoverage_eq_comap` identifies the small étale
  precoverage of `F` with a restriction of the chosen étale precoverage of `Sch_κ`, whence
  `AlgebraicGeometry.Space.SmallEtale.precoverage_isStableUnderBaseChange` and
  `AlgebraicGeometry.Space.SmallEtale.over_topology_eq`, the generating precoverage of the
  localized topology.

## Implementation notes

An étale chart of `F` with underlying object `U` is a representable étale morphism
`φ : h_U ⟶ F`, so by the Yoneda lemma an étale chart of `h_U` is a morphism `f : V ⟶ U` of the
big fppf site of `S` whose represented morphism is étale, and its composite with `φ` is an étale
chart of `F` by part (1) of Stacks 03EC. That assignment, remembering `f` as the structure map to
`X`, is `chartLocalization`; its inverse reads a chart over `X` as a morphism of the site by part
(2) of Stacks 03EC, which is what makes the two mutually inverse rather than merely adjoint.

The comparison of topologies is the substance. The small étale precoverage of `F` is the
restriction along `AlgebraicGeometry.Space.SmallEtale.toSchemes` of the chosen étale covering
families of `B` — `precoverage_eq_comap` — and the chosen families are stable under
base change because an arbitrary étale covering has a combinatorially equivalent chosen
representative (`AlgebraicGeometry.Space.exists_chosen_etaleCovering`). That makes Mathlib's
`CategoryTheory.over_toGrothendieck_eq_toGrothendieck_comap_forget` applicable, so the localized
topology is generated by a precoverage and both halves of cover preservation can be checked on
generating families with `CategoryTheory.coverPreserving_of_generators`. Cocontinuity of the two
functors then exhibits the equivalence as a dense subsite, and the restricted topology of a
continuous functor is its induced topology.

## References

* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-! ### Base change of the chosen étale covering families -/

/-- The chosen étale covering families of a big fppf site are stable under base change: the
family of base changes is an étale covering because the étale precoverage of all schemes is
stable under base change, and it is combinatorially equivalent to a *chosen* étale covering
family by `AlgebraicGeometry.Space.exists_chosen_etaleCovering`. -/
instance BigFppfSite.etalePrecoverage_isStableUnderBaseChange (B : BigFppfSite.{u}) :
    B.etalePrecoverage.IsStableUnderBaseChange := by
  constructor
  intro ι Z X f hR W g P p₁ p₂ h
  obtain ⟨E, hEq, hE⟩ := hR
  let E₀ : PreZeroHypercover.{u + 1} Z := ⟨ι, X, f⟩
  let E₁ : PreZeroHypercover.{u + 1} W := ⟨ι, P, p₁⟩
  have hX : IsEtaleCovering (⟨Z, E₀⟩ : Covering B.Schemes) := by
    change (E₀.map B.inclusion).presieve₀ ∈ Scheme.etalePrecoverage (B.inclusion.obj Z)
    rw [PreZeroHypercover.presieve₀_map,
      show E₀.presieve₀ = E.presieve₀ from hEq,
      ← PreZeroHypercover.presieve₀_map]
    exact hE.2
  have hP : IsEtaleCovering (⟨W, E₁⟩ : Covering B.Schemes) := by
    change (E₁.map B.inclusion).presieve₀ ∈ Scheme.etalePrecoverage (B.inclusion.obj W)
    exact Precoverage.mem_coverings_of_isPullback (fun i => B.inclusion.map (f i)) hX
      (B.inclusion.map g) (P := fun i => B.inclusion.obj (P i))
      (fun i => B.inclusion.map (p₁ i)) (fun i => B.inclusion.map (p₂ i))
      (fun i => (h i).map B.inclusion)
  obtain ⟨G, hG, hbase, hcomb⟩ := Space.exists_chosen_etaleCovering B ⟨W, E₁⟩ hP
  cases hbase
  exact ⟨G.2, PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hcomb, hG⟩

namespace Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

namespace SmallEtale

/-! ### The small étale precoverage as a restriction -/

/-- A presieve on an étale chart of `F` is determined by its family of underlying morphisms of
`Sch_κ`: the chart structure of the source of an arrow of the presieve is recovered from that
arrow, so the projection is injective on arrows with a fixed target. -/
theorem toSchemes_presieve_map_injective {A : SmallEtale B S hS F} {R Q : Presieve A}
    (h : R.map (toSchemes B S hS F) = Q.map (toSchemes B S hS F)) : R = Q := by
  have key : ∀ ⦃W V : SmallEtale B S hS F⦄ (a : W ⟶ A) (b : V ⟶ A)
      (hWV : (toSchemes B S hS F).obj W = (toSchemes B S hS F).obj V),
      (toSchemes B S hS F).map a = eqToHom hWV ≫ (toSchemes B S hS F).map b →
        ∀ {P : Presieve A}, P a → P b := by
    intro W V a b hWV hfac P ha
    have hbase : a.hom.left.left = eqToHom hWV ≫ b.hom.left.left := hfac
    have hover : W.obj.left = V.obj.left := by
      refine CostructuredArrow.obj_ext W.obj.left V.obj.left hWV ?_
      calc eqToHom hWV ≫ V.obj.left.hom
            = eqToHom hWV ≫ b.hom.left.left ≫ A.obj.left.hom := by rw [← Over.w b.hom.left]
        _ = a.hom.left.left ≫ A.obj.left.hom := by rw [← Category.assoc, ← hbase]
        _ = W.obj.left.hom := Over.w a.hom.left
    have hoverFac : a.hom.left = eqToHom hover ≫ b.hom.left :=
      CostructuredArrow.hom_ext _ _ (by simpa using hbase)
    have hobj : W.obj = V.obj := by
      refine CostructuredArrow.obj_ext W.obj V.obj hover ?_
      calc yoneda.map (eqToHom hover) ≫ V.obj.hom
            = yoneda.map (eqToHom hover) ≫ yoneda.map b.hom.left ≫ A.obj.hom := by
              rw [← CostructuredArrow.w b.hom]
        _ = yoneda.map (eqToHom hover ≫ b.hom.left) ≫ A.obj.hom := by simp
        _ = yoneda.map a.hom.left ≫ A.obj.hom := by rw [← hoverFac]
        _ = W.obj.hom := CostructuredArrow.w a.hom
    obtain rfl : W = V := by
      obtain ⟨w, hw⟩ := W
      obtain ⟨v, hv⟩ := V
      simp only at hobj
      cases hobj
      rfl
    obtain rfl : a = b :=
      ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ (by simpa using hoverFac))
    exact ha
  have aux : ∀ {R Q : Presieve A}, R.map (toSchemes B S hS F) = Q.map (toSchemes B S hS F) →
      ∀ {V : SmallEtale B S hS F} (g : V ⟶ A), R g → Q g := by
    intro R Q h V g hg
    have hm : R.map (toSchemes B S hS F) ((toSchemes B S hS F).map g) := Presieve.map_map hg
    rw [h, Presieve.map_iff] at hm
    obtain ⟨W, hW, a, ha, hfac⟩ := hm
    exact key a g hW hfac ha
  funext V g
  exact propext ⟨aux h g, aux h.symm g⟩

/-- The small étale precoverage of `F` is the chosen étale precoverage of `Sch_κ` restricted
along the projection taking an étale chart to its underlying scheme.

A covering family of charts is by definition one whose underlying family of schemes is chosen
étale, which is the easy inclusion. Conversely a chosen étale covering family of the scheme
underlying a chart lifts to a family of charts — each member is étale over the chart by the
definition of an étale covering, hence an étale chart of `F` by part (1) of Stacks 03EC — and
`AlgebraicGeometry.Space.SmallEtale.toSchemes_presieve_map_injective` identifies the lifted
family's presieve with the given one. -/
theorem precoverage_eq_comap :
    precoverage B S hS F = B.etalePrecoverage.comap (toSchemes B S hS F) := by
  ext A R
  rw [mem_precoverage_iff, Precoverage.mem_comap_iff]
  constructor
  · rintro ⟨E, rfl, hE⟩
    exact ⟨E.map (toSchemes B S hS F), (PreZeroHypercover.presieve₀_map _).symm, hE⟩
  · rintro ⟨G, hRG, hG⟩
    have hEtale (i : G.I₀) : Etale (B.inclusion.map (G.f i)) := by
      simpa [PreZeroHypercover.map] using
        ((Scheme.presieve₀_mem_precoverage_iff (P := @Etale) (G.map B.inclusion)).mp hG.2).2 i
    let E : PreZeroHypercover.{u + 1} A :=
      { I₀ := G.I₀
        X i := ⟨CostructuredArrow.mk (yoneda.map
            (Over.homMk (G.f i) (by simp) : Over.mk (G.f i ≫ A.obj.left.hom) ⟶ A.obj.left) ≫
            A.obj.hom),
          etale_comp_of_scheme B S hS _ A.obj.hom (hEtale i) A.property⟩
        f i := ObjectProperty.homMk (CostructuredArrow.homMk
          (Over.homMk (G.f i) (by simp) : Over.mk (G.f i ≫ A.obj.left.hom) ⟶ A.obj.left) rfl) }
    have hEmap : E.map (toSchemes B S hS F) = G := by
      obtain ⟨I₀, X, f⟩ := G
      rfl
    refine ⟨E, ?_, ?_⟩
    · refine toSchemes_presieve_map_injective B S hS F ?_
      rw [hRG, ← hEmap, PreZeroHypercover.presieve₀_map]
    · change B.etaleCovering ⟨(toSchemes B S hS F).obj A, E.map (toSchemes B S hS F)⟩
      rw [hEmap]
      exact hG

/-- The small étale precoverage of `F` is stable under base change, being a restriction of the
chosen étale precoverage of `Sch_κ` along a functor preserving fibre products. -/
instance precoverage_isStableUnderBaseChange :
    (precoverage B S hS F).IsStableUnderBaseChange := by
  rw [precoverage_eq_comap]
  infer_instance

/-- The localization of the small étale topology of `F` at a chart is generated by the
restriction of the small étale precoverage along the slice projection. -/
theorem over_topology_eq (X : SmallEtale B S hS F) :
    (topology B S hS F).over X = ((precoverage B S hS F).comap (Over.forget X)).toGrothendieck :=
  over_toGrothendieck_eq_toGrothendieck_comap_forget (precoverage B S hS F) X

/-! ### The two functors -/

variable (X : SmallEtale B S hS F)

/-- A morphism of the big fppf site of `S` between the sources of two étale charts of a presheaf
whose triangle commutes is itself an étale chart, by part (2) of Stacks 03EC together with
stability of étaleness under base change. -/
theorem presheaf_etale_yoneda_map {G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {V U : BigFppfOver B S hS} {a : yoneda.obj V ⟶ G} {c : yoneda.obj U ⟶ G} (l : V ⟶ U)
    (ha : (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf a)
    (hc : (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf c)
    (hl : yoneda.map l ≫ c = a) :
    (MorphismProperty.inverseImage (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf (yoneda.map l) :=
  presheaf_yoneda_map_of_inverseImage B S hS (P := @AlgebraicGeometry.Etale.{u}) inferInstance l
    (etale_of_comp_etale_chart B S hS ha hc hl)

/-- An étale chart of the presheaf represented by the source of `X`, read as an étale chart of
`F` over `X`: the chart is `yoneda.map f` for a unique morphism `f` of the big fppf site of `S`
by the Yoneda lemma, and its composite with `X` is an étale chart of `F` by part (1) of
Stacks 03EC. -/
noncomputable def chartLocalizationObj
    (A : SmallEtale B S hS (yoneda.obj ((toOver B S hS F).obj X))) : Over X := by
  let φ := X.obj.hom
  let α := A.obj.hom
  let f := yonedaEquiv α
  have hα : yoneda.map f = α := yonedaEquiv.injective rfl
  have hA : (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf α := A.property
  rw [← hα] at hA
  have hf : Etale ((BigFppfOver.toScheme B S hS).map f) :=
    MorphismProperty.of_relative_map (P := MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)) (F := yoneda) hA
  have hcomp : (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf (α ≫ φ) := by
    simpa [hα] using etale_comp_of_scheme B S hS f φ hf X.property
  exact Over.mk (Y := ⟨CostructuredArrow.mk (α ≫ φ), hcomp⟩)
    (ObjectProperty.homMk (CostructuredArrow.homMk f (by rw [hα]; rfl)))

/-- The comparison from the small étale site of the presheaf represented by the source of an
étale chart `X` of `F` to the localization of the small étale site of `F` at `X`. -/
noncomputable def chartLocalization :
    SmallEtale B S hS (yoneda.obj ((toOver B S hS F).obj X)) ⥤ Over X where
  obj A := chartLocalizationObj B S hS F X A
  map {A A'} m := by
    dsimp only [chartLocalizationObj]
    refine Over.homMk (ObjectProperty.homMk
      (CostructuredArrow.homMk m.hom.left ?_)) ?_
    · change (yoneda.map m.hom.left ≫ A'.obj.hom) ≫ X.obj.hom = A.obj.hom ≫ X.obj.hom
      rw [CostructuredArrow.w m.hom]
    · apply InducedCategory.hom_ext
      apply CostructuredArrow.ext
      simp only [Over.mk_hom, ObjectProperty.homMk_hom, CostructuredArrow.homMk_left]
      change m.hom.left ≫ yonedaEquiv A'.obj.hom = yonedaEquiv A.obj.hom
      calc
        m.hom.left ≫ yonedaEquiv A'.obj.hom =
            (yoneda.obj ((toOver B S hS F).obj X)).map m.hom.left.op
              (yonedaEquiv A'.obj.hom) := by simp
        _ = yonedaEquiv (yoneda.map m.hom.left ≫ A'.obj.hom) :=
          yonedaEquiv_naturality A'.obj.hom m.hom.left
        _ = yonedaEquiv A.obj.hom := congrArg yonedaEquiv (CostructuredArrow.w m.hom)
  map_id A := by ext; rfl
  map_comp f g := by ext; rfl

/-- An étale chart of `F` over `X`, read as an étale chart of the presheaf represented by the
source of `X`: its structure morphism to `X` is a morphism of the site whose represented
morphism is étale, by part (2) of Stacks 03EC. -/
noncomputable def chartLocalizationInverseObj (Z : Over X) :
    SmallEtale B S hS (yoneda.obj ((toOver B S hS F).obj X)) :=
  ⟨CostructuredArrow.mk (yoneda.map Z.hom.hom.left),
    presheaf_etale_yoneda_map B S hS Z.hom.hom.left Z.left.property X.property
      (CostructuredArrow.w Z.hom.hom)⟩

/-- The inverse of `AlgebraicGeometry.Space.SmallEtale.chartLocalization`. -/
noncomputable def chartLocalizationInverse :
    Over X ⥤ SmallEtale B S hS (yoneda.obj ((toOver B S hS F).obj X)) where
  obj Z := chartLocalizationInverseObj B S hS F X Z
  map {Z Z'} f := by
    dsimp only [chartLocalizationInverseObj]
    refine ObjectProperty.homMk (CostructuredArrow.homMk f.left.hom.left ?_)
    have hw : f.left.hom.left ≫ Z'.hom.hom.left = Z.hom.hom.left :=
      congrArg (fun g => g.hom.left) (Over.w f)
    change yoneda.map f.left.hom.left ≫ yoneda.map Z'.hom.hom.left =
      yoneda.map Z.hom.hom.left
    rw [← Functor.map_comp, hw]
  map_id Z := by ext; rfl
  map_comp f g := by ext; rfl

/-- The comparison leaves the underlying object of the big fppf site of `S` unchanged. -/
theorem chartLocalization_comp_forget_comp_toOver :
    chartLocalization B S hS F X ⋙ Over.forget X ⋙ toOver B S hS F =
      toOver B S hS (yoneda.obj ((toOver B S hS F).obj X)) :=
  Functor.hext (fun _ => rfl) (fun A A' f => by dsimp [chartLocalization]; rfl)

/-- The inverse comparison leaves the underlying object of the big fppf site of `S` unchanged. -/
theorem chartLocalizationInverse_comp_toOver :
    chartLocalizationInverse B S hS F X ⋙
        toOver B S hS (yoneda.obj ((toOver B S hS F).obj X)) =
      Over.forget X ⋙ toOver B S hS F :=
  Functor.hext (fun _ => rfl) (fun Z Z' f => by dsimp [chartLocalizationInverse]; rfl)

/-- The unit of the comparison: an étale chart of the representable presheaf is recovered from
the morphism of the site it is the image of under Yoneda. -/
noncomputable def chartLocalizationUnitIso :
    𝟭 (SmallEtale B S hS (yoneda.obj ((toOver B S hS F).obj X))) ≅
      chartLocalization B S hS F X ⋙ chartLocalizationInverse B S hS F X := by
  refine NatIso.ofComponents (fun A => ?_) ?_
  · refine ObjectProperty.isoMk
      (P := IsEtaleChart B S hS (yoneda.obj ((toOver B S hS F).obj X)))
      (CostructuredArrow.isoMk (Iso.refl A.obj.left) ?_)
    change yoneda.map (𝟙 A.obj.left) ≫ yoneda.map (yonedaEquiv A.obj.hom) = A.obj.hom
    have hα : yoneda.map (yonedaEquiv A.obj.hom) = A.obj.hom := yonedaEquiv.injective rfl
    simp [hα]
  · intro A A' f
    ext
    rfl

/-- The counit of the comparison: an étale chart of `F` over `X` is recovered from its structure
morphism to `X`. -/
noncomputable def chartLocalizationCounitIso :
    chartLocalizationInverse B S hS F X ⋙ chartLocalization B S hS F X ≅ 𝟭 (Over X) := by
  refine NatIso.ofComponents (fun Z => ?_) ?_
  · refine Over.isoMk (ObjectProperty.isoMk (P := IsEtaleChart B S hS F)
      (CostructuredArrow.isoMk (Iso.refl _) ?_)) ?_
    · exact (CostructuredArrow.w Z.hom.hom).symm
    · apply InducedCategory.hom_ext
      apply CostructuredArrow.ext
      exact (yonedaEquiv_yoneda_map Z.hom.hom.left).symm
  · intro Z Z' f
    ext
    rfl

/-- **Stacks 04M0.** The small étale site of the presheaf represented by the source of an étale
chart `X` of `F` is the slice of the small étale site of `F` at `X`. -/
noncomputable def chartLocalizationEquivalence :
    SmallEtale B S hS (yoneda.obj ((toOver B S hS F).obj X)) ≌ Over X :=
  CategoryTheory.Equivalence.mk (chartLocalization B S hS F X) (chartLocalizationInverse B S hS F X)
    (chartLocalizationUnitIso B S hS F X) (chartLocalizationCounitIso B S hS F X)

end SmallEtale

/-! ### Stacks 04M0 -/

/-- A chosen étale covering family is transported along a functor to the small étale site that
commutes with the projections to schemes. -/
private theorem etaleCovering_map_of_comp_eq (B : BigFppfSite.{u}) {C D : Type*}
    [Category C] [Category D] {G : C ⥤ D} {T : C ⥤ B.Schemes} (T' : D ⥤ B.Schemes)
    (h : G ⋙ T' = T) {A : C} (E : PreZeroHypercover.{u + 1} A)
    (hE : B.etaleCovering ⟨T.obj A, E.map T⟩) :
    B.etaleCovering ⟨T'.obj (G.obj A), (E.map G).map T'⟩ := by
  subst h
  exact hE

/-- **Stacks 04M0.** The small étale site of an étale scheme chart `X → F` is canonically the
localization of the small étale site of `F` at that chart. The equivalence preserves the entire
arrow to `X`, not just the underlying scheme over `S`. -/
@[stacks 04M0]
theorem smallEtaleEquivalenceOverChart
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (_hF : IsAlgebraicSpace B S hS F)
    (X : SmallEtale B S hS F) :
    ∃ e : SmallEtale B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ≌ Over X,
      e.functor.inducedTopology ((SmallEtale.topology B S hS F).over X) =
        SmallEtale.topology B S hS
          (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ∧
      e.functor ⋙ Over.forget X ⋙ SmallEtale.toOver B S hS F =
        SmallEtale.toOver B S hS
          (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ∧
      e.functor ⋙ Over.post (SmallEtale.toOver B S hS F ⋙ yoneda) =
        SmallEtale.inclusion B S hS
            (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ⋙
          CostructuredArrow.toOver yoneda
            (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) := by
  refine ⟨SmallEtale.chartLocalizationEquivalence B S hS F X, ?_, ?_, ?_⟩
  · let U := (SmallEtale.toOver B S hS F).obj X
    let e := SmallEtale.chartLocalizationEquivalence B S hS F X
    let Φ := e.functor
    let Ψ := e.inverse
    let PF := SmallEtale.precoverage B S hS F
    let Psrc := SmallEtale.precoverage B S hS (yoneda.obj U)
    let Q := PF.comap (Over.forget X)
    let K := Psrc.toGrothendieck
    let L := Q.toGrothendieck
    have hΦscheme : (Φ ⋙ Over.forget X) ⋙ SmallEtale.toSchemes B S hS F =
        SmallEtale.toSchemes B S hS (yoneda.obj U) :=
      Functor.hext (fun _ => rfl) (fun _ _ _ => HEq.rfl)
    have hΨscheme : Ψ ⋙ SmallEtale.toSchemes B S hS (yoneda.obj U) =
        Over.forget X ⋙ SmallEtale.toSchemes B S hS F :=
      Functor.hext (fun _ => rfl) (fun _ _ _ => HEq.rfl)
    have hΦcov : CoverPreserving K L Φ := by
      refine coverPreserving_of_generators Φ Psrc L ?_
      intro A R hR
      obtain ⟨E, rfl, hE⟩ := (SmallEtale.mem_precoverage_iff B S hS (yoneda.obj U)).mp hR
      rw [← Sieve.generate_map_eq_functorPushforward]
      refine Precoverage.generate_mem_toGrothendieck ?_
      change Presieve.map (Over.forget X) (Presieve.map Φ E.presieve₀) ∈
        PF ((Over.forget X).obj (Φ.obj A))
      refine (SmallEtale.mem_precoverage_iff B S hS F).2
        ⟨E.map (Φ ⋙ Over.forget X), ?_, ?_⟩
      · simp [PreZeroHypercover.presieve₀_map]
      · exact etaleCovering_map_of_comp_eq B _ hΦscheme E hE
    have hΨcov : CoverPreserving L K Ψ := by
      refine coverPreserving_of_generators Ψ Q K ?_
      intro A R hR
      change R.map (Over.forget X) ∈ PF ((Over.forget X).obj A) at hR
      obtain ⟨E, hEeq, hE⟩ := (SmallEtale.mem_precoverage_iff B S hS F
        (X := (Over.forget X).obj A) (R := R.map (Over.forget X))).mp hR
      let E' : PreZeroHypercover.{u + 1} A :=
        { I₀ := E.I₀
          X i := Over.mk (E.f i ≫ A.hom)
          f i := Over.homMk (E.f i) (by simp) }
      have hsub : E'.presieve₀ ≤ R := by
        intro Z f hf
        obtain ⟨i⟩ := hf
        have hi : (R.map (Over.forget X)) (E.f i) := hEeq ▸ E.presieve₀_f i
        obtain ⟨T, hT, g, hg, hfac⟩ := Presieve.map_iff.mp hi
        obtain ⟨T₀, tHom, rfl⟩ := T.mk_surjective
        obtain rfl : T₀ = E.X i := by simpa using hT
        have hglef : g.left = E.f i := by simpa using hfac
        obtain rfl : tHom = E.f i ≫ A.hom := by simpa [hglef] using (Over.w g).symm
        have hgf : g = E'.f i := Over.OverMorphism.ext hglef
        simpa [hgf] using hg
      have hE' : (E'.map Ψ).presieve₀ ∈ Psrc (Ψ.obj A) := by
        refine (SmallEtale.mem_precoverage_iff B S hS (yoneda.obj U)
          (X := Ψ.obj A) (R := (E'.map Ψ).presieve₀)).2 ⟨E'.map Ψ, rfl, ?_⟩
        exact etaleCovering_map_of_comp_eq B _ hΨscheme E' hE
      have hle : Sieve.generate (E'.presieve₀.map Ψ) ≤ Sieve.generate (R.map Ψ) := by
        rw [Sieve.generate_map_eq_functorPushforward, Sieve.generate_map_eq_functorPushforward]
        exact Sieve.functorPushforward_monotone Ψ A (Sieve.generate_mono hsub)
      rw [← Sieve.generate_map_eq_functorPushforward]
      refine K.superset_covering hle ?_
      simpa [PreZeroHypercover.presieve₀_map] using
        (Precoverage.generate_mem_toGrothendieck hE')
    have hΨcocont : Ψ.IsCocontinuous L K :=
      (e.symm.toAdjunction.isCocontinuous_iff_coverPreserving L K).2 hΦcov
    have hΦcocont : Φ.IsCocontinuous K L :=
      (e.toAdjunction.isCocontinuous_iff_coverPreserving K L).2 hΨcov
    have hΦcont : Φ.IsContinuous K L := Functor.isContinuous_iff_coverPreserving.2 hΦcov
    have hDense : Φ.IsDenseSubsite K L :=
      Equivalence.isDenseSubsite_functor_of_isCocontinuous K L e
    have hrestricted : Φ.restrictedTopology L = K := by
      ext A R
      rw [Functor.mem_restrictedTopology_iff]
      exact hDense.functorPushforward_mem_iff
    rw [SmallEtale.over_topology_eq B S hS F X]
    exact Φ.restrictedTopology_eq_inducedTopology_of_isContinuous hrestricted
  · exact SmallEtale.chartLocalization_comp_forget_comp_toOver B S hS F X
  · change SmallEtale.chartLocalization B S hS F X ⋙
      Over.post (SmallEtale.toOver B S hS F ⋙ yoneda) =
        SmallEtale.inclusion B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ⋙
          CostructuredArrow.toOver yoneda
            (yoneda.obj ((SmallEtale.toOver B S hS F).obj X))
    have hobj (A : SmallEtale B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj X))) :
        (SmallEtale.chartLocalization B S hS F X ⋙
            Over.post (SmallEtale.toOver B S hS F ⋙ yoneda)).obj A =
          (SmallEtale.inclusion B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ⋙
            CostructuredArrow.toOver yoneda
              (yoneda.obj ((SmallEtale.toOver B S hS F).obj X))).obj A :=
      congrArg Over.mk (yonedaEquiv.injective (yonedaEquiv_yoneda_map _))
    refine Functor.hext hobj fun A A' f => ?_
    let f₀ := f
    obtain ⟨⟨m, r, w⟩⟩ := f
    have hA := hobj A
    have hA' := hobj A'
    have hMap : (SmallEtale.chartLocalization B S hS F X ⋙
          Over.post (SmallEtale.toOver B S hS F ⋙ yoneda)).map f₀ =
        eqToHom hA ≫
          (SmallEtale.inclusion B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj X)) ⋙
            CostructuredArrow.toOver yoneda
              (yoneda.obj ((SmallEtale.toOver B S hS F).obj X))).map f₀ ≫
          eqToHom hA'.symm := by
      refine CostructuredArrow.hom_ext _ _ ?_
      have hAL := congrArg Comma.left hA
      have hAL' := congrArg Comma.left hA'
      cases hAL
      cases hAL'
      have hleftA : Over.Hom.left (eqToHom hA) = 𝟙 _ := by rw [Over.eqToHom_left]; rfl
      have hleftA' : Over.Hom.left (eqToHom hA'.symm) = 𝟙 _ := by rw [Over.eqToHom_left]; rfl
      simp only [Over.comp_left, hleftA, hleftA']
      ext Z x
      simp only [Functor.comp_obj, ObjectProperty.ι_obj, CostructuredArrow.proj_obj,
        Functor.comp_map, Over.post_map, ObjectProperty.ι_map, CostructuredArrow.proj_map,
        Over.homMk_left, yoneda_map_app, TypeCat.Fun.toFun_apply,
        CostructuredArrow.toOver_map_left]
      change x ≫ m = (yoneda.map m).app Z x
      rfl
    exact (conj_eqToHom_iff_heq _ _ hA hA').mp hMap

end Space

