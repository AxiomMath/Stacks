/-!
# The zero locus of an ideal whose direct image is an image

Let `ι : Y ⟶ Y'` be a morphism of algebraic spaces over an algebraic space `X`, with structure
morphisms `π : Y ⟶ X` and `π' : Y' ⟶ X` affine and `X` quasi-compact, and let
`t : π'_*𝒪_{Y'} ⟶ π_*𝒪_Y` be pullback of regular functions along `ι` on the charts
`Y ×_X Q ⟶ Y' ×_X Q`.  Let `ℐ' ⊆ 𝒪_{Y'}` and `ℐ ⊆ 𝒪_Y` be quasi-coherent sheaves of ideals with
`π_*ℐ` the image of `π'_*ℐ'` under `t`.  Then the zero loci are compatible with base change:
`V(ℐ) = V(ℐ') ×_{Y'} Y` as closed subspaces of `Y`, and hence `|V(ℐ)|` is the inverse image of
`|V(ℐ')|` in `|Y|`.

In the proof of Stacks 0GV1 this is applied to the system `Y = lim Y_k` of Stacks 07VR, whose
morphisms `Y ⟶ Y_k` are closed immersions, with the ideals `ℐ_k` produced by
`Space.exists_ideal_pushforwardSubmodule_eq_imageSubmodule_of_isLocallySurjective`:
the zero locus `V(ℐ)` of the situation of Stacks 0GUY is the inverse image of `V(ℐ_k)`, so its
open complement is the inverse image of `Y_k ∖ V(ℐ_k)`.

## Main results

* `AlgebraicGeometry.Space.preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule`: the closed
  subspaces agree, for closed subspaces given with their defining ideal sheaves.
* `Space.exists_closedSubspace_preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule`: the
  same for finite type quasi-coherent ideals, with the closed subspaces of finite presentation of
  `Space.exists_closedSubspace_isFinitePresentation_ι_of_isFiniteTypeQuasicoherentIdeal`.
* `AlgebraicGeometry.Space.idealZeroLocus_eq_preimage_of_pushforwardSubmodule_eq_imageSubmodule`:
  `|V(ℐ)|` is the inverse image of `|V(ℐ')|`.

## Implementation notes

Both closed subspaces are compared at a single chart `U = Y ×_X Q` of `Y`, for `Q` an affine
surjective étale chart of the quasi-compact `X`: a point of `Y` is pulled back along the surjective
étale `Q ⟶ X`, after which it factors through `U`, and on the affine `U` membership in a closed
subspace is read off its defining ideal (`AlgebraicGeometry.Space.mem_obj_iff_definingIdealAt_le`).
On `U` the defining ideal of `V(ℐ') ×_{Y'} Y` is generated by the pullback of `ℐ'(Y' ×_X Q)`
(`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`).  That ideal lies in `ℐ(U)`, which is
an ideal containing the values of `t` on `π'_*ℐ'`; conversely the image of `π'_*ℐ'` lies in the
direct image of the defining ideal of `V(ℐ') ×_{Y'} Y`, which is a sheaf, so its sections `ℐ(U)`
do too.

## References

* [Stacks Project, Tag 0GV1](https://stacks.math.columbia.edu/tag/0GV1)
* [Stacks Project, Tag 0GUY](https://stacks.math.columbia.edu/tag/0GUY)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.SheafOfModules.ImageSubsheaf

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- Pullback of a regular function in the defining ideal of a closed subspace `Z'` of `Y'`, along
a morphism of charts lying over `f : Y ⟶ Y'`, lies in the defining ideal of the inverse image
`f⁻¹(Z')`.  No affineness is needed: the base change of `Z'` along the composite chart maps to
that along the chart of `Y'`. -/
private theorem appTop_mem_definingIdealAt_preimage {Y Y' : AlgebraicSpaces B S hS} (f : Y ⟶ Y')
    (Z' : ClosedSubspaces B S hS Y'.1) (U : SmallEtale B S hS Y'.1) (V : SmallEtale B S hS Y.1)
    (p : V.1.left ⟶ U.1.left) (hp : yoneda.map p ≫ U.1.hom = V.1.hom ≫ f.hom)
    {a : ToType ((structureRingSheaf B S hS Y').obj.obj (op U))}
    (ha : a ∈ definingIdealAt B S hS Y' Z' (op U)) :
    ((BigFppfOver.toScheme B S hS).map p).appTop.hom a ∈
      definingIdealAt B S hS Y (⟨Z'.1.preimage f.hom,
        isClosedSubspace_preimage B S hS f.hom Z'.1 Y'.2 Y.2 Z'.2⟩ :
        ClosedSubspaces B S hS Y.1) (op V) := by
  rw [definingIdealAt_preimage B S hS f Z' V]
  have ha' : (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (Z'.2.2.rep.snd U.1.hom)).op).hom a = 0 := by
    rw [definingIdealAt_eq_ker B S hS Y' Z' U] at ha
    exact ha
  obtain ⟨l, hl⟩ := exists_isPullback_snd_comp B S hS Z'.2.2.rep U.1.hom p
    (V.1.hom ≫ f.hom) hp
  have key := congrArg (fun g => (Scheme.Γ.map g.op).hom a) hl.w
  simp only [op_comp, Functor.map_comp, CommRingCat.hom_comp] at key
  change (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map l).op).hom
      ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map (Z'.2.2.rep.snd U.1.hom)).op).hom a) =
    (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (Z'.2.2.rep.snd (V.1.hom ≫ f.hom))).op).hom
      ((Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map p).op).hom a) at key
  rw [ha', map_zero] at key
  exact key.symm

/-- **A closed subspace of `Y` is read off one affine chart `Y ×_X Q`, for `Q` a surjective étale
chart of `X`.**  If the defining ideal of `Z₂` is contained in that of `Z₁` at the base change
`U = Y ×_X Q` of a surjective étale chart `Q` of `X`, and `U` is affine, then `Z₁ ⊆ Z₂`.

A point of `Y` over a scheme `T` is pulled back along the surjective étale `T ×_X Q ⟶ T`, after
which it factors through `U`; on the affine chart `U` membership is read off the defining ideal,
and membership descends along surjective étale morphisms. -/
private theorem le_of_definingIdealAt_smallBaseChange_le {X Y : AlgebraicSpaces B S hS}
    (π : Y ⟶ X) (hπ : yoneda.relativelyRepresentable π.hom) (Q : SmallEtale B S hS X.1)
    (hQs : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf Q.1.hom)
    (hU : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((smallBaseChange B S hS π hπ).obj Q).1.left))
    (Z₁ Z₂ : ClosedSubspaces B S hS Y.1)
    (h : definingIdealAt B S hS Y Z₂ (op ((smallBaseChange B S hS π hπ).obj Q)) ≤
      definingIdealAt B S hS Y Z₁ (op ((smallBaseChange B S hS π hπ).obj Q))) :
    Z₁.1 ≤ Z₂.1 := by
  intro T x hx
  set U := (smallBaseChange B S hS π hπ).obj Q with hUdef
  set τ : yoneda.obj T.unop ⟶ Y.1 := yonedaEquiv.symm x with hτ
  have hrep := Q.property.rep
  set q := hrep.snd (τ ≫ π.hom) with hq
  refine mem_obj_of_surjective_etale B S hS Y.2.isSheaf Z₂.1 Z₂.2.1.isSheaf q
    (hQs.property_snd (τ ≫ π.hom)) (Q.property.property_snd (τ ≫ π.hom)) x ?_
  have hw : yoneda.map (hrep.fst' (τ ≫ π.hom)) ≫ Q.1.hom =
      yoneda.map q ≫ τ ≫ π.hom := by
    rw [hrep.map_fst' (τ ≫ π.hom)]
    exact hrep.w (τ ≫ π.hom)
  have hcond : (yoneda.map q ≫ τ) ≫ π.hom =
      yoneda.map (hrep.fst' (τ ≫ π.hom)) ≫ Q.1.hom := by
    rw [Category.assoc, hw]
  set k := hπ.lift (yoneda.map q ≫ τ) (hrep.fst' (τ ≫ π.hom)) hcond with hk
  have hval : Y.1.map q.op x = U.1.hom.app (op (hrep.pullback (τ ≫ π.hom))) k := by
    change _ = (hπ.fst Q.1.hom).app (op (hrep.pullback (τ ≫ π.hom))) k
    rw [← yonedaEquiv_yoneda_map_comp B S hS (hπ.fst Q.1.hom) k, hπ.lift_fst,
      ← yonedaEquiv_naturality,
      show yonedaEquiv τ = x from Equiv.apply_symm_apply yonedaEquiv x]
  have := hU
  rw [hval, mem_obj_iff_definingIdealAt_le B S hS Y Z₂ U k]
  refine h.trans ?_
  rw [← mem_obj_iff_definingIdealAt_le B S hS Y Z₁ U k, ← hval]
  exact Z₁.1.map q.op hx

/-- A quasi-compact algebraic space `X` has a surjective étale chart `Q` whose base change along
any affine morphism to `X` is affine. -/
private theorem exists_surjective_smallEtale_affine_baseChange {X : AlgebraicSpaces B S hS}
    (hX : IsQuasiCompactSpace B S hS X.1) :
    ∃ Q : SmallEtale B S hS X.1, (MorphismProperty.inverseImage
        (@Surjective.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf Q.1.hom ∧
      ∀ {Y : AlgebraicSpaces B S hS} (π : Y ⟶ X) (hπ : yoneda.relativelyRepresentable π.hom),
        IsAffineHom B S hS π.hom →
        IsAffine ((BigFppfOver.toScheme B S hS).obj
          ((smallBaseChange B S hS π hπ).obj Q).1.left) := by
  obtain ⟨Q₀, φ, hQaff, hsurj, het⟩ :=
    (isQuasiCompactSpace_iff_exists_affine_etale_surjective_cover B S hS X.1 X.2).1 hX
  exact ⟨⟨CostructuredArrow.mk φ, (isEtale_iff_presheaf_of_yoneda B S hS φ).1 het⟩, hsurj,
    fun π hπ hπa => isAffine_smallBaseChange_obj B S hS π hπ hπa _ hQaff⟩

/-- **The zero locus of an ideal whose direct image is an image is a base change.**  Let
`ι : Y ⟶ Y'` be a morphism of algebraic spaces over a quasi-compact algebraic space `X`, with
affine structure morphisms `π = ι ≫ π'` and `π'`, and let `t : π'_*𝒪_{Y'} ⟶ π_*𝒪_Y` be pullback
of regular functions along the chart maps `Y ×_X Q ⟶ Y' ×_X Q` induced by `ι`.  Let `Z ⊆ Y` and
`Z' ⊆ Y'` be closed subspaces whose defining ideal sheaves `ℐ`, `ℐ'` satisfy
`π_*ℐ = t(π'_*ℐ')`, the image subsheaf.  Then `Z = ι⁻¹(Z') = Z' ×_{Y'} Y`.

Nothing is assumed of `ι` beyond the hypothesis on `t`; in the proof of Stacks 0GV1 it is a
closed immersion of the system of Stacks 07VR. -/
theorem preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule {X Y Y' : AlgebraicSpaces B S hS}
    (hX : IsQuasiCompactSpace B S hS X.1) (ι : Y ⟶ Y') (π' : Y' ⟶ X) {π : Y ⟶ X}
    (hι : ι ≫ π' = π) (hπa : IsAffineHom B S hS π.hom) (hπ'a : IsAffineHom B S hS π'.hom)
    (hπ : yoneda.relativelyRepresentable π.hom) (hπ' : yoneda.relativelyRepresentable π'.hom)
    (t : chartBaseChangeStructureModule B S hS π' hπ' ⟶ chartBaseChangeStructureModule B S hS π hπ)
    (ht : ∀ (Q : SmallEtale B S hS X.1) (c : hπ.pullback Q.1.hom ⟶ hπ'.pullback Q.1.hom),
      c ≫ hπ'.snd Q.1.hom = hπ.snd Q.1.hom →
      yoneda.map c ≫ hπ'.fst Q.1.hom = hπ.fst Q.1.hom ≫ ι.hom →
      ∀ a : chartSectionsRing B S hS Y' ((smallBaseChange B S hS π' hπ').obj Q),
        t.val.app (op Q) a = ((BigFppfOver.toScheme B S hS).map c).appTop.hom a)
    (Z : ClosedSubspaces B S hS Y.1) (Z' : ClosedSubspaces B S hS Y'.1)
    (h : pushforwardSubmodule B S hS π hπ _ (definingIdealSheaf B S hS Y Z) =
      imageSubmodule ((pushforwardSubmodule B S hS π' hπ' _
        (definingIdealSheaf B S hS Y' Z')).ι ≫ t)) :
    Z'.1.preimage ι.hom = Z.1 := by
  -- the chart maps `Y ×_X Q ⟶ Y' ×_X Q` induced by `ι`
  have hcond : ∀ Q : SmallEtale B S hS X.1, (hπ.fst Q.1.hom ≫ ι.hom) ≫ π'.hom =
      yoneda.map (hπ.snd Q.1.hom) ≫ Q.1.hom := fun Q => by
    have hιh : ι.hom ≫ π'.hom = π.hom := congrArg (fun g => g.hom) hι
    rw [Category.assoc, hιh, hπ.w Q.1.hom]
  let c : ∀ Q : SmallEtale B S hS X.1, hπ.pullback Q.1.hom ⟶ hπ'.pullback Q.1.hom := fun Q =>
    hπ'.lift (hπ.fst Q.1.hom ≫ ι.hom) (hπ.snd Q.1.hom) (hcond Q)
  have hc₁ : ∀ Q : SmallEtale B S hS X.1, c Q ≫ hπ'.snd Q.1.hom = hπ.snd Q.1.hom := fun Q =>
    hπ'.lift_snd _ _ _
  have hc₂ : ∀ Q : SmallEtale B S hS X.1,
      yoneda.map (c Q) ≫ hπ'.fst Q.1.hom = hπ.fst Q.1.hom ≫ ι.hom := fun Q =>
    hπ'.lift_fst _ _ _
  set Z₂ : ClosedSubspaces B S hS Y.1 := ⟨Z'.1.preimage ι.hom,
    isClosedSubspace_preimage B S hS ι.hom Z'.1 Y'.2 Y.2 Z'.2⟩ with hZ₂
  -- the image of `π'_*ℐ'` lies in the direct image of the ideal of `ι⁻¹(Z')`
  have himage : imageSubmodule ((pushforwardSubmodule B S hS π' hπ' _
      (definingIdealSheaf B S hS Y' Z')).ι ≫ t) ≤
        pushforwardSubmodule B S hS π hπ _ (definingIdealSheaf B S hS Y Z₂) := by
    refine imageSubmodule_le _ ?_
    rintro ⟨Q⟩ m
    change t.val.app (op Q) m.1 ∈ definingIdealAt B S hS Y Z₂
      (op ((smallBaseChange B S hS π hπ).obj Q))
    rw [ht Q (c Q) (hc₁ Q) (hc₂ Q) m.1]
    exact appTop_mem_definingIdealAt_preimage ι Z' ((smallBaseChange B S hS π' hπ').obj Q)
      ((smallBaseChange B S hS π hπ).obj Q) (c Q) (hc₂ Q) m.2
  -- an affine surjective étale chart of `X`, and its base changes
  obtain ⟨Q, hsurj, hQ⟩ := exists_surjective_smallEtale_affine_baseChange hX
  have hU := hQ π hπ hπa
  have hU' := hQ π' hπ' hπ'a
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((smallBaseChange B S hS π hπ).obj Q).1.left) := hU
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((smallBaseChange B S hS π' hπ').obj Q).1.left) := hU'
  have hK := definingIdealAt_preimage_eq_map B S hS ι Z' ((smallBaseChange B S hS π' hπ').obj Q)
    ((smallBaseChange B S hS π hπ).obj Q) (c Q) (hc₂ Q)
  have hmem : ∀ x, x ∈ definingIdealAt B S hS Y Z (op ((smallBaseChange B S hS π hπ).obj Q)) ↔
      x ∈ (imageSubmodule ((pushforwardSubmodule B S hS π' hπ' _
        (definingIdealSheaf B S hS Y' Z')).ι ≫ t)).obj (op Q) := fun x =>
    SetLike.ext_iff.1 (congrArg (fun P => P.obj (op Q)) h) x
  refine le_antisymm
    (le_of_definingIdealAt_smallBaseChange_le π hπ Q hsurj hU Z₂ Z ?_)
    (le_of_definingIdealAt_smallBaseChange_le π hπ Q hsurj hU Z Z₂ ?_)
  · -- `ℐ(U) ⊆ ℐ_{ι⁻¹(Z')}(U)`
    intro x hx
    exact himage (op Q) ((hmem x).1 hx)
  · -- `ℐ_{ι⁻¹(Z')}(U) = ℐ'(U') · 𝒪(U) ⊆ ℐ(U)`
    rw [hK]
    refine Ideal.map_le_iff_le_comap.2 fun a ha => ?_
    refine (hmem _).2 ?_
    have hm := apply_mem_imageSubmodule ((pushforwardSubmodule B S hS π' hπ' _
      (definingIdealSheaf B S hS Y' Z')).ι ≫ t) (X := op Q) ⟨a, ha⟩
    have heq : ((pushforwardSubmodule B S hS π' hπ' _
        (definingIdealSheaf B S hS Y' Z')).ι ≫ t).val.app (op Q) ⟨a, ha⟩ =
          ((BigFppfOver.toScheme B S hS).map (c Q)).appTop.hom a :=
      ht Q (c Q) (hc₁ Q) (hc₂ Q) a
    exact heq ▸ hm

/-- **A closed subspace is determined by the direct image of its ideal along an affine
morphism.**  For `π : Y ⟶ X` affine with `X` quasi-compact, closed subspaces `Z₁`, `Z₂` of `Y`
whose defining ideals have the same direct image `π_*ℐ_{Z₁} = π_*ℐ_{Z₂}` are equal: both are read
off the single affine chart `Y ×_X Q`, for `Q` an affine surjective étale chart of `X`. -/
theorem eq_of_pushforwardSubmodule_definingIdealSheaf_eq {X Y : AlgebraicSpaces B S hS}
    (hX : IsQuasiCompactSpace B S hS X.1) (π : Y ⟶ X) (hπa : IsAffineHom B S hS π.hom)
    (hπ : yoneda.relativelyRepresentable π.hom) (Z₁ Z₂ : ClosedSubspaces B S hS Y.1)
    (h : pushforwardSubmodule B S hS π hπ _ (definingIdealSheaf B S hS Y Z₁) =
      pushforwardSubmodule B S hS π hπ _ (definingIdealSheaf B S hS Y Z₂)) :
    Z₁ = Z₂ := by
  obtain ⟨Q, hsurj, hQ⟩ := exists_surjective_smallEtale_affine_baseChange hX
  have hU := hQ π hπ hπa
  have hmem : ∀ x, x ∈ definingIdealAt B S hS Y Z₁ (op ((smallBaseChange B S hS π hπ).obj Q)) ↔
      x ∈ definingIdealAt B S hS Y Z₂ (op ((smallBaseChange B S hS π hπ).obj Q)) := fun x =>
    SetLike.ext_iff.1 (congrArg (fun P => P.obj (op Q)) h) x
  exact Subtype.ext (le_antisymm
    (le_of_definingIdealAt_smallBaseChange_le π hπ Q hsurj hU Z₁ Z₂ fun x hx => (hmem x).2 hx)
    (le_of_definingIdealAt_smallBaseChange_le π hπ Q hsurj hU Z₂ Z₁ fun x hx => (hmem x).1 hx))

/-- **The closed subspaces `V(ℐ)` and `V(ℐ') ×_{Y'} Y` agree.**  In the setting of
`AlgebraicGeometry.Space.preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule`, let `ℐ ⊆ 𝒪_Y`
and `ℐ' ⊆ 𝒪_{Y'}` be finite type quasi-coherent sheaves of ideals with `π_*ℐ = t(π'_*ℐ')`.  The
closed subspaces `V(ℐ)` and `V(ℐ')` of
`exists_closedSubspace_isFinitePresentation_ι_of_isFiniteTypeQuasicoherentIdeal`, with defining
ideal sheaves `ℐ`, `ℐ'` and inclusions of finite presentation, satisfy `V(ℐ) = ι⁻¹(V(ℐ'))`. -/
theorem exists_closedSubspace_preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule
    {X Y Y' : AlgebraicSpaces B S hS}
    (hX : IsQuasiCompactSpace B S hS X.1) (ι : Y ⟶ Y') (π' : Y' ⟶ X) {π : Y ⟶ X}
    (hι : ι ≫ π' = π) (hπa : IsAffineHom B S hS π.hom) (hπ'a : IsAffineHom B S hS π'.hom)
    (hπ : yoneda.relativelyRepresentable π.hom) (hπ' : yoneda.relativelyRepresentable π'.hom)
    (t : chartBaseChangeStructureModule B S hS π' hπ' ⟶ chartBaseChangeStructureModule B S hS π hπ)
    (ht : ∀ (Q : SmallEtale B S hS X.1) (c : hπ.pullback Q.1.hom ⟶ hπ'.pullback Q.1.hom),
      c ≫ hπ'.snd Q.1.hom = hπ.snd Q.1.hom →
      yoneda.map c ≫ hπ'.fst Q.1.hom = hπ.fst Q.1.hom ≫ ι.hom →
      ∀ a : chartSectionsRing B S hS Y' ((smallBaseChange B S hS π' hπ').obj Q),
        t.val.app (op Q) a = ((BigFppfOver.toScheme B S hS).map c).appTop.hom a)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule)
    (hI : IsFiniteTypeQuasicoherentIdeal B S hS Y I)
    (I' : (SheafOfModules.unit (structureRingSheaf B S hS Y')).Submodule)
    (hI' : IsFiniteTypeQuasicoherentIdeal B S hS Y' I')
    (h : pushforwardSubmodule B S hS π hπ _ I =
      imageSubmodule ((pushforwardSubmodule B S hS π' hπ' _ I').ι ≫ t)) :
    ∃ (Z : ClosedSubspaces B S hS Y.1) (Z' : ClosedSubspaces B S hS Y'.1),
      definingIdealSheaf B S hS Y Z = I ∧ definingIdealSheaf B S hS Y' Z' = I' ∧
        IsFinitePresentation B S hS Z.1.ι ∧ IsFinitePresentation B S hS Z'.1.ι ∧
        Z'.1.preimage ι.hom = Z.1 := by
  obtain ⟨Z, hZ, -, hZfp⟩ :=
    exists_closedSubspace_isFinitePresentation_ι_of_isFiniteTypeQuasicoherentIdeal B S hS Y I hI
  obtain ⟨Z', hZ', -, hZ'fp⟩ :=
    exists_closedSubspace_isFinitePresentation_ι_of_isFiniteTypeQuasicoherentIdeal B S hS Y' I'
      hI'
  refine ⟨Z, Z', hZ, hZ', hZfp, hZ'fp, ?_⟩
  subst hZ hZ'
  exact preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule hX ι π' hι hπa hπ'a hπ hπ' t ht
    Z Z' h

/-- **`|V(ℐ)|` is the inverse image of `|V(ℐ')|`.**  In the setting of
`AlgebraicGeometry.Space.preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule`, let `ℐ ⊆ 𝒪_Y`
and `ℐ' ⊆ 𝒪_{Y'}` be quasi-coherent sheaves of ideals with `π_*ℐ = t(π'_*ℐ')`.  Then the zero
locus of `ℐ` is the inverse image under `|ι|` of the zero locus of `ℐ'`. -/
theorem idealZeroLocus_eq_preimage_of_pushforwardSubmodule_eq_imageSubmodule
    {X Y Y' : AlgebraicSpaces B S hS}
    (hX : IsQuasiCompactSpace B S hS X.1) (ι : Y ⟶ Y') (π' : Y' ⟶ X) {π : Y ⟶ X}
    (hι : ι ≫ π' = π) (hπa : IsAffineHom B S hS π.hom) (hπ'a : IsAffineHom B S hS π'.hom)
    (hπ : yoneda.relativelyRepresentable π.hom) (hπ' : yoneda.relativelyRepresentable π'.hom)
    (t : chartBaseChangeStructureModule B S hS π' hπ' ⟶ chartBaseChangeStructureModule B S hS π hπ)
    (ht : ∀ (Q : SmallEtale B S hS X.1) (c : hπ.pullback Q.1.hom ⟶ hπ'.pullback Q.1.hom),
      c ≫ hπ'.snd Q.1.hom = hπ.snd Q.1.hom →
      yoneda.map c ≫ hπ'.fst Q.1.hom = hπ.fst Q.1.hom ≫ ι.hom →
      ∀ a : chartSectionsRing B S hS Y' ((smallBaseChange B S hS π' hπ').obj Q),
        t.val.app (op Q) a = ((BigFppfOver.toScheme B S hS).map c).appTop.hom a)
    (I : (SheafOfModules.unit (structureRingSheaf B S hS Y)).Submodule)
    (hI : I.toSheafOfModules.IsQuasicoherentOnSite)
    (I' : (SheafOfModules.unit (structureRingSheaf B S hS Y')).Submodule)
    (hI' : I'.toSheafOfModules.IsQuasicoherentOnSite)
    (h : pushforwardSubmodule B S hS π hπ _ I =
      imageSubmodule ((pushforwardSubmodule B S hS π' hπ' _ I').ι ≫ t)) :
    idealZeroLocus B S hS Y I =
      pointsMap B S hS Y.1 ι.hom ⁻¹' idealZeroLocus B S hS Y' I' := by
  obtain ⟨Z, rfl⟩ := exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS Y I hI
  obtain ⟨Z', rfl⟩ := exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS Y' I' hI'
  rw [← range_pointsMap_ι_eq_idealZeroLocus B S hS Y Z,
    ← range_pointsMap_ι_eq_idealZeroLocus B S hS Y' Z',
    ← preimage_eq_of_pushforwardSubmodule_eq_imageSubmodule hX ι π' hι hπa hπ'a hπ hπ' t ht
      Z Z' h]
  exact range_pointsMap_preimage_ι B S hS ι.hom Z'.1

end AlgebraicGeometry.Space

