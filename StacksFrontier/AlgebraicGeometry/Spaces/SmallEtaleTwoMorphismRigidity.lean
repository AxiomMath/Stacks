/-!
# Rigidity of 2-morphisms of the small étale ringed topos

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` contained in a big fppf
site `B`.  Stacks 04KK says that the morphism of small étale ringed topoi which Stacks 03G8
attaches to `f` has no automorphisms: a 2-morphism from it to itself is the identity.

The proof is the one of Stacks 04KK.  A 2-morphism is a transformation `t : f_* ⟶ f_*` of
direct images compatible with the structure map `f♯`, so it suffices to see that `t` is the
identity on sections over an affine étale scheme chart `V` of `Y`, those charts being a dense
subsite.  Over such a `V` the sections of `f_*` are corepresented by the subsheaf of
`𝒪_X`-valued coordinate families generated by the chart maps over `f` into `V`: a section is a
family of pullbacks of regular functions on `V`, and on an affine `V` a morphism of schemes is
determined by the pullbacks of the regular functions.  The universal element of that
corepresentation is carried to the structure map, which `t` fixes, so `t` fixes the universal
element and is therefore the identity.

## Main statements

* `AlgebraicGeometry.Space.smallEtaleRingedToposHom_twoMorphismOfRingedTopoi_eq_id` is
  Stacks 04KK for a 2-morphism over the four-field
  `Stacks.Sheaves.RingedToposModules.RingedToposHom`.
  `AlgebraicGeometry.Space.smallEtaleRingedToposHom_twoMorphism_eq_id` of
  `StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleRingedToposHomRigidity` is the tag for a
  2-morphism over the two-field `AlgebraicGeometry.RingedToposHom`; the two structures are
  equivalent.

Tags covered: 04KK.

## References

* [Stacks Project, Lemma 65.20.3 (Tag 04KK)](https://stacks.math.columbia.edu/tag/04KK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace Stacks.Sites

universe v w

section JointlyInjective

/-- A map of presheaves of types is a monomorphism as soon as a family of maps out of its source
that factor through it is jointly injective on every object. -/
theorem mono_of_jointly_injective_coordinates {C : Type v} [Category.{w} C]
    {P R O : C ⥤ Type u} {I : Type*} (m : P ⟶ R) (c : I → (P ⟶ O)) (p : I → (R ⟶ O))
    (fac : ∀ i, m ≫ p i = c i)
    (joint : ∀ U (x y : P.obj U), (∀ i, (c i).app U x = (c i).app U y) → x = y) : Mono m := by
  rw [NatTrans.mono_iff_mono_app]
  intro U
  apply ConcreteCategory.mono_of_injective
  intro x y h
  apply joint U x y
  intro i
  have hp := congr_app (fac i) U
  exact (ConcreteCategory.congr_hom hp x).symm.trans
    ((congrArg (fun z => (p i).app U z) h).trans (ConcreteCategory.congr_hom hp y))

end JointlyInjective

variable {C : Type v} [Category.{u} C] {D : Type w} [Category.{u + 1} D]

/-- Sections of a sheaf on a dense subsite over an object `Z` of the big site are the
morphisms into its restriction from the presheaf of arrows into `Z`. -/
noncomputable def denseYonedaEquiv (K : GrothendieckTopology D) (I : C ⥤ D)
    [I.IsCoverDense K] [I.IsLocallyFull K] (Z : D) (P : Cᵒᵖ ⥤ Type u)
    (e : I.op ⋙ yoneda.obj Z ≅ P ⋙ uliftFunctor.{u + 1, u}) (H : Sheaf K (Type u)) :
    (P ⟶ I.op ⋙ H.obj) ≃ H.obj.obj (op Z) :=
  (Functor.FullyFaithful.ofFullyFaithful
      ((Functor.whiskeringRight Cᵒᵖ (Type u) (Type (u + 1))).obj
        uliftFunctor.{u + 1, u})).homEquiv.trans
    ((e.symm.homCongr (Iso.refl _)).trans
      ((Functor.IsCoverDense.restrictHomEquivHom
        (G := I) (ℱ' := (sheafCompose K uliftFunctor.{u + 1, u}).obj H)).trans
        (yonedaEquiv.trans Equiv.ulift)))

/-- The inverse of `Stacks.Sites.denseYonedaEquiv` sends a section `s` over `Z` to the morphism
whose component at an arrow `k : I.obj U ⟶ Z` is the restriction of `s` along `k`. -/
theorem denseYonedaEquiv_symm_apply (K : GrothendieckTopology D) (I : C ⥤ D)
    [I.IsCoverDense K] [I.IsLocallyFull K] (Z : D) (P : Cᵒᵖ ⥤ Type u)
    (e : I.op ⋙ yoneda.obj Z ≅ P ⋙ uliftFunctor.{u + 1, u}) (H : Sheaf K (Type u))
    (s : H.obj.obj (op Z)) (U : Cᵒᵖ) (k : I.obj U.unop ⟶ Z) :
    ((denseYonedaEquiv K I Z P e H).symm s).app U ((e.hom.app U k).down) =
      H.obj.map k.op s := by
  have h := Functor.FullyFaithful.map_preimage
    (Functor.FullyFaithful.ofFullyFaithful
      ((Functor.whiskeringRight Cᵒᵖ (Type u) (Type (u + 1))).obj uliftFunctor.{u + 1, u}))
    (X := P) (Y := I.op ⋙ H.obj)
    (e.inv ≫ Functor.whiskerLeft I.op
      (yonedaEquiv.symm (ULift.up s) : yoneda.obj Z ⟶ H.obj ⋙ uliftFunctor.{u + 1, u}))
  have hh := congrArg ULift.down
    (ConcreteCategory.congr_hom (congr_app h U) (e.hom.app U k))
  change ((denseYonedaEquiv K I Z P e H).symm s).app U ((e.hom.app U k).down) =
    H.obj.map (e.inv.app U (e.hom.app U k)).op s at hh
  have he : e.inv.app U (e.hom.app U k) = k :=
    ConcreteCategory.congr_hom (e.hom_inv_id_app U) k
  rwa [he] at hh


section SheafOfMono

universe v₂ w₂

variable {C : Type v₂} [Category.{w₂} C] {J : GrothendieckTopology C} {P : Cᵒᵖ ⥤ Type u}
  {Q : Sheaf J (Type u)} (m : P ⟶ Q.obj)

/-- The subsheaf of `Q` generated by the image of a morphism of presheaves into it. -/
abbrev sheafOfMono : Sheaf J (Type u) :=
  ⟨((Subfunctor.range m).sheafify J).toFunctor,
    (isSheaf_iff_isSheaf_of_type _ _).mpr ((Subfunctor.range m).sheafify_isSheaf
      ((isSheaf_iff_isSheaf_of_type _ _).mp Q.property))⟩

/-- The canonical morphism from the source presheaf to the subsheaf generated by its image. -/
abbrev sheafOfMonoUnit : P ⟶ (sheafOfMono m).obj := Subfunctor.toRangeSheafify J m

/-- A morphism out of a presheaf which is a monomorphism into a sheaf extends to the subsheaf
generated by its image. -/
noncomputable abbrev sheafOfMonoLift [Mono m] {F : Sheaf J (Type u)} (g : P ⟶ F.obj) :
    sheafOfMono m ⟶ F :=
  ⟨(Subfunctor.range m).sheafifyLift (inv (Subfunctor.toRange m) ≫ g)
    ((isSheaf_iff_isSheaf_of_type _ _).mp F.property)⟩

/-- The lift `Stacks.Sites.sheafOfMonoLift m g` restricts to `g` along the canonical morphism
`Stacks.Sites.sheafOfMonoUnit m`. -/
theorem sheafOfMonoUnit_lift [Mono m] {F : Sheaf J (Type u)} (g : P ⟶ F.obj) :
    sheafOfMonoUnit m ≫ (sheafOfMonoLift m g).hom = g := by
  dsimp [sheafOfMonoUnit, sheafOfMonoLift, Subfunctor.toRangeSheafify]
  rw [Category.assoc, Subfunctor.to_sheafifyLift, IsIso.hom_inv_id_assoc]

/-- Two morphisms out of the subsheaf generated by the image of a monomorphism agree as soon as
they agree after restriction along the canonical morphism. -/
theorem sheafOfMono_hom_ext [Mono m] {F : Sheaf J (Type u)}
    (g h : sheafOfMono m ⟶ F)
    (e : sheafOfMonoUnit m ≫ g.hom = sheafOfMonoUnit m ≫ h.hom) : g = h := by
  apply Sheaf.hom_ext
  apply (Subfunctor.range m).to_sheafify_lift_unique
    ((isSheaf_iff_isSheaf_of_type _ _).mp F.property)
  apply (cancel_epi (Subfunctor.toRange m)).mp
  simpa [sheafOfMonoUnit, Subfunctor.toRangeSheafify] using e

/-- Morphisms out of the subsheaf generated by the image of a monomorphism of presheaves are
exactly morphisms out of the presheaf. -/
noncomputable def sheafOfMonoHomEquiv [Mono m] (F : Sheaf J (Type u)) :
    (sheafOfMono m ⟶ F) ≃ (P ⟶ F.obj) where
  toFun g := sheafOfMonoUnit m ≫ g.hom
  invFun g := sheafOfMonoLift m g
  left_inv _g := sheafOfMono_hom_ext m _ _ (sheafOfMonoUnit_lift m _)
  right_inv := sheafOfMonoUnit_lift m

/-- The inclusion of the subsheaf generated by an image into the ambient sheaf. -/
abbrev sheafOfMonoι : sheafOfMono m ⟶ Q :=
  ⟨((Subfunctor.range m).sheafify J).ι⟩

/-- The canonical morphism into the subsheaf generated by the image of `m`, followed by the
inclusion into the ambient sheaf, is `m`. -/
theorem sheafOfMonoUnit_ι : sheafOfMonoUnit m ≫ (sheafOfMonoι m).hom = m := by
  ext U x
  rfl

/-- The inclusion of the subsheaf generated by an image into the ambient sheaf is a
monomorphism. -/
theorem sheafOfMonoι_mono : Mono (sheafOfMonoι m) := by
  apply (sheafToPresheaf J (Type u)).mono_of_mono_map
  change Mono (((Subfunctor.range m).sheafify J).ι)
  infer_instance

/-- The lift of `m` followed by a morphism `g` out of the ambient sheaf is the inclusion of the
subsheaf generated by the image of `m` followed by `g`. -/
theorem sheafOfMonoLift_eq [Mono m] {F : Sheaf J (Type u)} (g : Q ⟶ F) :
    sheafOfMonoLift m (m ≫ g.hom) = sheafOfMonoι m ≫ g := by
  apply sheafOfMono_hom_ext m
  rw [sheafOfMonoUnit_lift]
  change m ≫ g.hom = sheafOfMonoUnit m ≫ (sheafOfMonoι m).hom ≫ g.hom
  rw [← Category.assoc, sheafOfMonoUnit_ι]

/-- Two morphisms into the subsheaf generated by the image of a monomorphism into a product
agree as soon as all their coordinates do. -/
theorem sheafOfMono_hom_ext_of_pi {I : Type*} (D : I → Sheaf J (Type u))
    [HasProduct D] (m : P ⟶ (∏ᶜ D).obj) [Mono m] {F : Sheaf J (Type u)}
    (g h : F ⟶ sheafOfMono m)
    (e : ∀ i, g ≫ sheafOfMonoLift m (m ≫ (Pi.π D i).hom) =
      h ≫ sheafOfMonoLift m (m ≫ (Pi.π D i).hom)) : g = h := by
  have := sheafOfMonoι_mono m
  apply (cancel_mono (sheafOfMonoι m)).mp
  apply Pi.hom_ext
  intro i
  simpa only [sheafOfMonoLift_eq, Category.assoc] using e i

end SheafOfMono

end Stacks.Sites

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- Scheme-chart maps to a fixed étale chart `V` of `Y` which lie over `f`. -/
def chartFiber (f : X ⟶ Y) (V : SmallEtale B S hS Y.1) :
    Subfunctor ((SmallEtale.toOver B S hS X.1).op ⋙ yoneda.obj V.1.left) where
  obj U := {g | U.unop.1.hom ≫ f.hom = yoneda.map g ≫ V.1.hom}
  map {U U'} i := by
    intro g hg
    change U'.unop.1.hom ≫ f.hom = yoneda.map (i.unop.hom.left ≫ g) ≫ V.1.hom
    rw [Functor.map_comp, Category.assoc, ← hg, ← Category.assoc, CostructuredArrow.w]

/-- The induced morphism of charts of a morphism into the cartesian base change `X ×_Y V`
lies over `f`. -/
theorem chartBaseChangeMap_mem_chartFiber (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    chartBaseChangeMap B S hS f V (StructuredArrow.mk k.op) ∈
      (chartFiber B S hS f V).obj (op U) := by
  have hsq : (SpacesEtale.toSpaces B S hS X).map k ≫
      (spacesBaseChange B S hS f).projection.app ((comparisonFunctor B S hS Y).obj V) ≫
        ((comparisonFunctor B S hS Y).obj V).1.hom =
      ((comparisonFunctor B S hS X).obj U).1.hom ≫ f := by
    rw [((spacesBaseChange B S hS f).isPullback ((comparisonFunctor B S hS Y).obj V)).w,
      ← Category.assoc]
    exact congrArg (· ≫ f) (Over.w k.hom)
  change U.1.hom ≫ f.hom =
    yoneda.map (chartBaseChangeMap B S hS f V (StructuredArrow.mk k.op)) ≫ V.1.hom
  rw [yoneda_map_chartBaseChangeMap]
  exact (congrArg (fun m : (SpacesEtale.toSpaces B S hS X).obj
    ((comparisonFunctor B S hS X).obj U) ⟶ Y => m.hom) hsq).symm

/-- The chart map over `f` attached to a morphism from an étale chart of `X` into the
cartesian base change `X ×_Y V`: the induced morphism of charts of Stacks 03G8. -/
noncomputable def chartFiberOfChartHom (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    (chartFiber B S hS f V).obj (op U) :=
  ⟨chartBaseChangeMap B S hS f V (StructuredArrow.mk k.op),
    chartBaseChangeMap_mem_chartFiber B S hS f V U k⟩

private theorem chartFiberOfChartHom_val (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    (chartFiberOfChartHom B S hS f V U k).val =
      chartBaseChangeMap B S hS f V (StructuredArrow.mk k.op) := rfl

/-- The morphism from an étale chart of `X` into the cartesian base change `X ×_Y V` attached
to a chart map over `f`: the cartesian lift of the chart map and of the structure map. -/
noncomputable def chartHomOfChartFiber (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (U : SmallEtale B S hS X.1) (g : (chartFiber B S hS f V).obj (op U)) :
    (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V := by
  refine ObjectProperty.homMk (Over.homMk
    (((spacesBaseChange B S hS f).isPullback ((comparisonFunctor B S hS Y).obj V)).lift
      (ObjectProperty.homMk (yoneda.map g.val))
      ((comparisonFunctor B S hS X).obj U).1.hom ?_) ?_)
  · apply ObjectProperty.hom_ext
    exact g.property.symm
  · exact ((spacesBaseChange B S hS f).isPullback
      ((comparisonFunctor B S hS Y).obj V)).lift_snd _ _ _

/-- Passing from a chart map over `f` to the morphism of charts into `X ×_Y V` and back gives the
chart map again. -/
theorem chartFiberOfChartHom_chartHomOfChartFiber (f : X ⟶ Y)
    (V : SmallEtale B S hS Y.1) (U : SmallEtale B S hS X.1)
    (g : (chartFiber B S hS f V).obj (op U)) :
    chartFiberOfChartHom B S hS f V U (chartHomOfChartFiber B S hS f V U g) = g := by
  apply Subtype.ext
  apply yoneda.map_injective
  rw [chartFiberOfChartHom_val, yoneda_map_chartBaseChangeMap]
  exact congrArg (fun m : (SpacesEtale.toSpaces B S hS X).obj
      ((comparisonFunctor B S hS X).obj U) ⟶
    ((SpacesEtale.toSpaces B S hS Y).obj ((comparisonFunctor B S hS Y).obj V)) => m.hom)
    (((spacesBaseChange B S hS f).isPullback
      ((comparisonFunctor B S hS Y).obj V)).lift_fst _ _ _)

/-- Passing from a morphism of charts into `X ×_Y V` to its chart map over `f` and back gives the
morphism again. -/
theorem chartHomOfChartFiber_chartFiberOfChartHom (f : X ⟶ Y)
    (V : SmallEtale B S hS Y.1) (U : SmallEtale B S hS X.1)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    chartHomOfChartFiber B S hS f V U (chartFiberOfChartHom B S hS f V U k) = k := by
  apply ObjectProperty.hom_ext
  apply Over.OverMorphism.ext
  refine ((spacesBaseChange B S hS f).isPullback
    ((comparisonFunctor B S hS Y).obj V)).hom_ext ?_ ?_
  · refine Eq.trans (((spacesBaseChange B S hS f).isPullback
      ((comparisonFunctor B S hS Y).obj V)).lift_fst _ _ _) ?_
    apply ObjectProperty.hom_ext
    change yoneda.map (chartFiberOfChartHom B S hS f V U k).val = _
    rw [chartFiberOfChartHom_val]
    exact yoneda_map_chartBaseChangeMap B S hS f V (StructuredArrow.mk k.op)
  · refine Eq.trans (((spacesBaseChange B S hS f).isPullback
      ((comparisonFunctor B S hS Y).obj V)).lift_snd _ _ _) (Over.w k.hom).symm

/-- The chart map over `f` attached to a morphism of charts into `X ×_Y V` is natural in the
étale chart of `X`. -/
theorem chartFiberOfChartHom_naturality (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    {U U' : SmallEtale B S hS X.1} (i : U' ⟶ U)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    chartFiberOfChartHom B S hS f V U' ((comparisonFunctor B S hS X).map i ≫ k) =
      (chartFiber B S hS f V).toFunctor.map i.op (chartFiberOfChartHom B S hS f V U k) := by
  apply Subtype.ext
  let j : StructuredArrow (op (chartBaseChange B S hS f V))
    (comparisonFunctor B S hS X).op := StructuredArrow.mk k.op
  let j' : StructuredArrow (op (chartBaseChange B S hS f V))
    (comparisonFunctor B S hS X).op :=
    StructuredArrow.mk (((comparisonFunctor B S hS X).map i ≫ k).op)
  have hw : j.hom ≫ (comparisonFunctor B S hS X).op.map i.op = j'.hom := rfl
  exact chartBaseChangeMap_comp B S hS f V
    (StructuredArrow.homMk (f := j) (f' := j') i.op hw)

/-- The chart maps over `f` into `V` are exactly the morphisms of charts of `X` into the
cartesian base change `X ×_Y V`. -/
noncomputable def chartFiberLiftIso (f : X ⟶ Y) (V : SmallEtale B S hS Y.1) :
    (comparisonFunctor B S hS X).op ⋙ yoneda.obj (chartBaseChange B S hS f V) ≅
      (chartFiber B S hS f V).toFunctor ⋙ uliftFunctor.{u + 1, u} :=
  NatIso.ofComponents
    (fun U => (({ toFun := chartFiberOfChartHom B S hS f V U.unop
                  invFun := chartHomOfChartFiber B S hS f V U.unop
                  left_inv := chartHomOfChartFiber_chartFiberOfChartHom B S hS f V U.unop
                  right_inv := chartFiberOfChartHom_chartHomOfChartFiber B S hS f V U.unop } :
      ((comparisonFunctor B S hS X).obj U.unop ⟶ chartBaseChange B S hS f V) ≃
        (chartFiber B S hS f V).toFunctor.obj U).trans Equiv.ulift.symm).toIso)
    (by
      intro U U' i
      ext k
      exact congrArg ULift.up (chartFiberOfChartHom_naturality B S hS f V i.unop k))


/-- **Stacks 03G8, the chart correspondence on sections.**  Sections of the direct image of a
sheaf of sets over an étale chart `V` of `Y` are the morphisms into that sheaf from the
presheaf of chart maps over `f` into `V`: the chart maps are the morphisms of charts of `X`
into the cartesian base change `X ×_Y V`, and the sections of the direct image over `V` are
the sections over that base change. -/
private noncomputable def chartFiberHomEquiv (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (F : Sheaf (SmallEtale.topology B S hS X.1) (Type u)) :
    (directImageSections B S hS f V).obj F ≃ ((chartFiber B S hS f V).toFunctor ⟶ F.obj) :=
  haveI := Functor.IsDenseSubsite.isCoverDense (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  haveI := Functor.IsDenseSubsite.isLocallyFull (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  (Stacks.Sites.denseYonedaEquiv (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
      (chartBaseChange B S hS f V) (chartFiber B S hS f V).toFunctor
      (chartFiberLiftIso B S hS f V)
      ((smallEtaleComparisonRan B S hS X).obj F)).symm.trans
    ((Iso.refl _).homCongr ((sheafToPresheaf (SmallEtale.topology B S hS X.1) (Type u)).mapIso
      (asIso (((comparisonFunctor B S hS X).sheafAdjunctionCocontinuous (Type u)
        (SmallEtale.topology B S hS X.1) (SpacesEtale.topology B S hS X)).counit.app F))))

/-- The correspondence of `AlgebraicGeometry.Space.chartFiberHomEquiv` is the canonical one:
on the chart map named by a morphism of charts into `X ×_Y V` it is the chart projection of
`AlgebraicGeometry.Space.chartProjection`. -/
private theorem chartFiberHomEquiv_apply (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (F : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
    (s : (directImageSections B S hS f V).obj F) (U : SmallEtale B S hS X.1)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    (chartFiberHomEquiv B S hS f V F s).app (op U) (chartFiberOfChartHom B S hS f V U k) =
      (chartProjection B S hS f V (StructuredArrow.mk k.op)).app F s := by
  have := Functor.IsDenseSubsite.isCoverDense (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  have := Functor.IsDenseSubsite.isLocallyFull (SmallEtale.topology B S hS X.1)
    (SpacesEtale.topology B S hS X) (comparisonFunctor B S hS X)
  have h := Stacks.Sites.denseYonedaEquiv_symm_apply (SpacesEtale.topology B S hS X)
    (comparisonFunctor B S hS X) (chartBaseChange B S hS f V)
    (chartFiber B S hS f V).toFunctor (chartFiberLiftIso B S hS f V)
    ((smallEtaleComparisonRan B S hS X).obj F) s (op U) k
  change (((comparisonFunctor B S hS X).sheafAdjunctionCocontinuous (Type u)
      (SmallEtale.topology B S hS X.1)
      (SpacesEtale.topology B S hS X)).counit.app F).hom.app (op U)
    (((Stacks.Sites.denseYonedaEquiv (SpacesEtale.topology B S hS X)
      (comparisonFunctor B S hS X) (chartBaseChange B S hS f V)
      (chartFiber B S hS f V).toFunctor (chartFiberLiftIso B S hS f V)
      ((smallEtaleComparisonRan B S hS X).obj F)).symm s).app (op U)
        (chartFiberOfChartHom B S hS f V U k)) = _
  rw [show chartFiberOfChartHom B S hS f V U k =
    ((chartFiberLiftIso B S hS f V).hom.app (op U) k).down from rfl, h]
  rfl

/-- Two morphisms out of the presheaf of chart maps over `f` agree as soon as they agree on the
chart maps attached to morphisms of charts into `X ×_Y V`. -/
private theorem chartFiber_hom_ext (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    {F : Sheaf (SmallEtale.topology B S hS X.1) (Type u)}
    (u v : (chartFiber B S hS f V).toFunctor ⟶ F.obj)
    (h : ∀ (U : SmallEtale B S hS X.1)
      (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V),
      u.app (op U) (chartFiberOfChartHom B S hS f V U k) =
        v.app (op U) (chartFiberOfChartHom B S hS f V U k)) : u = v := by
  apply NatTrans.ext
  funext U
  obtain ⟨U⟩ := U
  ext g
  rw [← chartFiberOfChartHom_chartHomOfChartFiber B S hS f V U g]
  exact h U _

/-- The correspondence of `AlgebraicGeometry.Space.chartFiberHomEquiv` is natural in the
sheaf. -/
private theorem chartFiberHomEquiv_naturality (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    {F G : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : F ⟶ G)
    (s : (directImageSections B S hS f V).obj F) :
    chartFiberHomEquiv B S hS f V G ((directImageSections B S hS f V).map q s) =
      chartFiberHomEquiv B S hS f V F s ≫ q.hom := by
  refine chartFiber_hom_ext B S hS f V _ _ fun U k => ?_
  change (chartFiberHomEquiv B S hS f V G ((directImageSections B S hS f V).map q s)).app
      (op U) _ =
    q.hom.app (op U) ((chartFiberHomEquiv B S hS f V F s).app (op U) _)
  rw [chartFiberHomEquiv_apply, chartFiberHomEquiv_apply]
  have hn := ConcreteCategory.congr_hom ((chartProjection B S hS f V
    (StructuredArrow.mk k.op)).naturality q) s
  simp only [ConcreteCategory.comp_apply] at hn
  exact hn


/-- The coordinate of a chart map over `f` attached to a regular function on `V`: pullback of
that function along the chart map. -/
noncomputable def chartFiberCoordinate (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (b : (structureSetSheaf B S hS Y).obj.obj (op V)) :
    (chartFiber B S hS f V).toFunctor ⟶ (structureSetSheaf B S hS X).obj where
  app U := TypeCat.ofHom fun g : (chartFiber B S hS f V).obj U =>
    (forget CommRingCat.{u}).map
      (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map g.val).op) b
  naturality U U' i := by
    ext g
    change (forget CommRingCat.{u}).map (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      ((SmallEtale.toOver B S hS X.1).map i.unop ≫ g.val)).op) b = _
    rw [Functor.map_comp, op_comp, Functor.map_comp]
    rfl

private theorem chartFiberCoordinate_chartFiberOfChartHom (f : X ⟶ Y)
    (V : SmallEtale B S hS Y.1) (b : (structureSetSheaf B S hS Y).obj.obj (op V))
    (U : SmallEtale B S hS X.1)
    (k : (comparisonFunctor B S hS X).obj U ⟶ chartBaseChange B S hS f V) :
    (chartFiberCoordinate B S hS f V b).app (op U) (chartFiberOfChartHom B S hS f V U k) =
      chartPullback B S hS f V (StructuredArrow.mk k.op) b := rfl

/-- **Stacks 03G8, the chartwise formula for the structure map.**  Under the chart
correspondence on sections, the structure map sends a regular function on `V` to the family of
its pullbacks along the chart maps over `f`. -/
private theorem chartFiberHomEquiv_structureMapApp (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    (b : (structureSetSheaf B S hS Y).obj.obj (op V)) :
    chartFiberHomEquiv B S hS f V (structureSetSheaf B S hS X)
        (structureMapApp B S hS f V b) =
      chartFiberCoordinate B S hS f V b := by
  refine chartFiber_hom_ext B S hS f V _ _ fun U k => ?_
  refine Eq.trans (chartFiberHomEquiv_apply B S hS f V (structureSetSheaf B S hS X)
    (structureMapApp B S hS f V b) U k) ?_
  exact chartProjection_structureMapApp B S hS f V (StructuredArrow.mk k.op) b

/-- On an affine étale chart of `Y` a chart map over `f` is determined by the pullbacks of the
regular functions along it. -/
theorem chartFiber_ext_of_isAffine (f : X ⟶ Y) (V : SmallEtale B S hS Y.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)]
    (U : (SmallEtale B S hS X.1)ᵒᵖ) (g g' : (chartFiber B S hS f V).toFunctor.obj U)
    (h : ∀ b, (chartFiberCoordinate B S hS f V b).app U g =
      (chartFiberCoordinate B S hS f V b).app U g') : g = g' :=
  Subtype.ext <| (BigFppfOver.toScheme B S hS).map_injective <|
    AlgebraicGeometry.ext_of_isAffine <| by ext b; exact h b

