/-- **The rigidity step.**  A 2-endomorphism of the direct image which fixes the structure map
is the identity on the sections over an affine étale chart of `Y`. -/
private theorem directImageSections_natTrans_eq_id_of_isAffine (f : X ⟶ Y)
    (V : SmallEtale B S hS Y.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left)]
    (γ : directImageSections B S hS f V ⟶ directImageSections B S hS f V)
    (hr : ∀ b, γ.app (structureSetSheaf B S hS X) (structureMapApp B S hS f V b) =
      structureMapApp B S hS f V b) :
    γ = 𝟙 (directImageSections B S hS f V) := by
  have := chartCoordinateMap_mono B S hS f V
  set m := chartCoordinateMap B S hS f V with hm
  set Q := Stacks.Sites.sheafOfMono m with hQ
  set E : (G : Sheaf (SmallEtale.topology B S hS X.1) (Type u)) →
      ((directImageSections B S hS f V).obj G ≃ (Q ⟶ G)) :=
    fun G => (chartFiberHomEquiv B S hS f V G).trans
      (Stacks.Sites.sheafOfMonoHomEquiv m G).symm with hEdef
  have hEu (G : Sheaf (SmallEtale.topology B S hS X.1) (Type u))
      (x : (directImageSections B S hS f V).obj G) :
      Stacks.Sites.sheafOfMonoUnit m ≫ (E G x).hom =
        chartFiberHomEquiv B S hS f V G x :=
    (Stacks.Sites.sheafOfMonoHomEquiv m G).apply_symm_apply _
  have hE {G H : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : G ⟶ H)
      (x : (directImageSections B S hS f V).obj G) :
      E H ((directImageSections B S hS f V).map q x) = E G x ≫ q := by
    apply Stacks.Sites.sheafOfMono_hom_ext m
    change Stacks.Sites.sheafOfMonoUnit m ≫ (E H _).hom =
      Stacks.Sites.sheafOfMonoUnit m ≫ (E G x).hom ≫ q.hom
    rw [hEu, ← Category.assoc, hEu]
    exact chartFiberHomEquiv_naturality B S hS f V q x
  set c : (structureSetSheaf B S hS Y).obj.obj (op V) → (Q ⟶ structureSetSheaf B S hS X) :=
    fun b => Stacks.Sites.sheafOfMonoLift m (chartFiberCoordinate B S hS f V b) with hcdef
  have hc (b : (structureSetSheaf B S hS Y).obj.obj (op V)) :
      E (structureSetSheaf B S hS X) (structureMapApp B S hS f V b) = c b := by
    change (Stacks.Sites.sheafOfMonoHomEquiv m (structureSetSheaf B S hS X)).symm
      (chartFiberHomEquiv B S hS f V (structureSetSheaf B S hS X)
        (structureMapApp B S hS f V b)) = _
    rw [chartFiberHomEquiv_structureMapApp]
    rfl
  set a := (E Q).symm (𝟙 Q) with hadef
  have ha : E Q a = 𝟙 Q := Equiv.apply_symm_apply _ _
  have hac {G : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : Q ⟶ G)
      (x : (directImageSections B S hS f V).obj G) (hx : E G x = q) :
      (directImageSections B S hS f V).map q a = x := by
    apply (E G).injective
    rw [hE, ha, Category.id_comp, hx]
  have hγ {G H : Sheaf (SmallEtale.topology B S hS X.1) (Type u)} (q : G ⟶ H)
      (x : (directImageSections B S hS f V).obj G) :
      (directImageSections B S hS f V).map q (γ.app G x) =
        γ.app H ((directImageSections B S hS f V).map q x) := by
    have hn := ConcreteCategory.congr_hom (γ.naturality q) x
    simpa only [ConcreteCategory.comp_apply] using hn.symm
  have hπ (b : (structureSetSheaf B S hS Y).obj.obj (op V)) :
      Stacks.Sites.sheafOfMonoLift m (m ≫ (Pi.π
        (fun _ : (structureSetSheaf B S hS Y).obj.obj (op V) =>
          structureSetSheaf B S hS X) b).hom) = c b :=
    congrArg (Stacks.Sites.sheafOfMonoLift m) (chartCoordinateMap_π B S hS f V b)
  have hσ : E Q (γ.app Q a) = 𝟙 Q := by
    apply Stacks.Sites.sheafOfMono_hom_ext_of_pi
      (fun _ : (structureSetSheaf B S hS Y).obj.obj (op V) => structureSetSheaf B S hS X) m
    intro b
    rw [hπ b, ← hE, hγ, hac _ _ (hc b), hr, hc, Category.id_comp]
  have ht : γ.app Q a = a := (E Q).injective (hσ.trans ha.symm)
  apply NatTrans.ext
  funext F
  ext s
  change γ.app F s = s
  rw [← hac (E F s) s rfl, ← hγ, ht]


