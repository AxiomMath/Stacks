module

public import StacksFrontier.AlgebraicGeometry.Spaces.DirectImageSectionsGlobalFunctionsNaturality
public import StacksFrontier.AlgebraicGeometry.Spaces.FactorThroughClosedSubspace
public import StacksFrontier.AlgebraicGeometry.Spaces.RelationSize
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.GlobalFunctionsAtlas

/-!
# A function vanishing on the preimage of a closed subspace lies in the pulled-back ideal

Let `g : Y ⟶ X` be a morphism of algebraic spaces, `U` an affine étale chart of `X`,
`P = Y ×_X U` and `Z ⊆ X` a closed subspace with defining ideal `I ⊆ 𝒪_X(U)` at `U`. A regular
function `x` on all scheme charts of `P` which vanishes at every point of `P` lying over `Z`
lies, on every affine étale chart `W` of `P`, in the ideal of `𝒪(W)` generated by the pullback
of `I`.

The point used is the closed subscheme `Spec(𝒪(W)/I 𝒪(W)) ⟶ W`: it lies over `Z` by the
chart-local membership criterion of Stacks 03MB
(`AlgebraicGeometry.Space.mem_obj_iff_definingIdealAt_le`), so `x` vanishes there, and the
kernel of `𝒪(W) ⟶ 𝒪(W)/I 𝒪(W)` is `I 𝒪(W)`.

## Main definitions

* `AlgebraicGeometry.Space.quotientSiteObj` and `AlgebraicGeometry.Space.quotientSiteHom`: the
  closed subscheme `Spec(Γ(W)/J) ⟶ W` of an affine object of the site, as a morphism of the site.
* `AlgebraicGeometry.Space.chartBaseChangeChartMap`: the morphism `W ⟶ U` of the site under an
  étale chart `W` of `Y ×_X U`.

## Main results

* `AlgebraicGeometry.Space.ker_quotientSiteHom`: the kernel of `Γ(W) ⟶ Γ(Spec(Γ(W)/J))` is `J`.
* `AlgebraicGeometry.Space.mem_map_definingIdealAt_of_forall_eq_zero`: **the vanishing
  criterion.**

## References

* [Stacks Project, Tag 03MB](https://stacks.math.columbia.edu/tag/03MB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-! ### The closed subscheme cut out by an ideal of an affine object -/

/-- For an affine scheme `X` and an ideal `J ⊆ Γ(X)`, the kernel of
`Γ(X) ⟶ Γ(Spec(Γ(X)/J))` is `J`. -/
theorem _root_.AlgebraicGeometry.Scheme.ker_appTop_spec_quotient_comp_isoSpec_inv (Xs : Scheme.{u})
    [IsAffine Xs] (J : Ideal Γ(Xs, ⊤)) :
    RingHom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ Xs.isoSpec.inv).appTop.hom =
      J := by
  have h1 : (Xs.isoSpec.inv).appTop = (Scheme.ΓSpecIso Γ(Xs, ⊤)).inv := by
    rw [← cancel_mono (Scheme.ΓSpecIso Γ(Xs, ⊤)).hom, Iso.inv_hom_id, ← Scheme.toSpecΓ_appTop,
      ← Scheme.isoSpec_hom, ← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
  have h2 : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))).appTop =
      (Scheme.ΓSpecIso Γ(Xs, ⊤)).hom ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) ≫
        (Scheme.ΓSpecIso (CommRingCat.of (Γ(Xs, ⊤) ⧸ J))).inv := by
    rw [← Category.assoc, ← Scheme.ΓSpecIso_naturality, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  rw [Scheme.Hom.comp_appTop, h1, h2, Iso.inv_hom_id_assoc]
  ext r
  simp only [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
  refine ⟨fun h => ?_, fun h => by rw [Ideal.Quotient.eq_zero_iff_mem.2 h, map_zero]⟩
  have := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(Xs, ⊤) ⧸ J))).hom.hom h
  simp only [map_zero] at this
  rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply] at this
  exact Ideal.Quotient.eq_zero_iff_mem.1 this


section Quotient

variable (Wo : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj Wo)]
  (J : Ideal Γ((BigFppfOver.toScheme B S hS).obj Wo, ⊤))

/-- The closed immersion `Spec(Γ(W)/J) ⟶ W`. -/
abbrev quotientSchemeι :
    Spec (CommRingCat.of (Γ((BigFppfOver.toScheme B S hS).obj Wo, ⊤) ⧸ J)) ⟶
      (BigFppfOver.toScheme B S hS).obj Wo :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
    ((BigFppfOver.toScheme B S hS).obj Wo).isoSpec.inv

/-- The morphism `Spec(Γ(W)/J) ⟶ W` is a monomorphism. -/
instance : Mono (quotientSchemeι Wo J) := by
  have : _root_.AlgebraicGeometry.IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) :=
    _root_.AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  infer_instance

/-- `Spec(Γ(W)/J)` as an object of the site. -/
def quotientSiteObj : BigFppfOver B S hS :=
  BigFppfOver.mk B S hS (B.contains_of_mono (quotientSchemeι Wo J) Wo.left.2)
    (quotientSchemeι Wo J ≫ B.inclusion.map Wo.hom)

/-- `Spec(Γ(W)/J) ⟶ W` as a morphism of the site. -/
def quotientSiteHom : quotientSiteObj Wo J ⟶ Wo :=
  Over.homMk (ObjectProperty.homMk (quotientSchemeι Wo J)) (by apply ObjectProperty.hom_ext; rfl)

/-- The underlying morphism of schemes of `quotientSiteHom Wo J` is `quotientSchemeι Wo J`. -/
theorem toScheme_map_quotientSiteHom :
    (BigFppfOver.toScheme B S hS).map (quotientSiteHom Wo J) = quotientSchemeι Wo J :=
  rfl

/-- **The kernel of `Γ(W) ⟶ Γ(Spec(Γ(W)/J))` is `J`.** -/
theorem ker_quotientSchemeι :
    RingHom.ker (quotientSchemeι Wo J).appTop.hom = J :=
  Scheme.ker_appTop_spec_quotient_comp_isoSpec_inv _ J

/-- The kernel of the map on global sections induced by `quotientSiteHom Wo J` is `J`. -/
theorem ker_quotientSiteHom :
    RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (quotientSiteHom Wo J)).op).hom = J :=
  ker_quotientSchemeι Wo J

end Quotient

/-! ### The vanishing criterion -/

section Vanishing

variable {X Y : AlgebraicSpaces B S hS} (g : Y ⟶ X) (U : SmallEtale B S hS X.1)

/-- The morphism `W ⟶ U` of the site under an étale chart `W` of `Y ×_X U`. -/
abbrev chartBaseChangeChartMap (W : SmallEtale B S hS (chartBaseChangeSpace B S hS g U).1) :
    (SmallEtale.toOver B S hS (chartBaseChangeSpace B S hS g U).1).obj W ⟶ U.1.left :=
  smallEtaleChartMapToBase B S hS (chartBaseChangeProjection B S hS g U).hom W

/-- The composite of `chartBaseChangeChartMap g U W` with the chart `U ⟶ X` equals the composite
`W ⟶ Y ×_X U ⟶ Y ⟶ X`. -/
theorem yoneda_map_chartBaseChangeChartMap
    (W : SmallEtale B S hS (chartBaseChangeSpace B S hS g U).1) :
    yoneda.map (chartBaseChangeChartMap g U W) ≫ U.1.hom =
      W.1.hom ≫ (chartBaseChangeInclusion B S hS g U).hom ≫ g.hom := by
  rw [show yoneda.map (chartBaseChangeChartMap g U W) =
      W.1.hom ≫ (chartBaseChangeProjection B S hS g U).hom from
    yoneda_map_smallEtaleChartMapToBase B S hS _ W]
  exact (Category.assoc _ _ _).trans (congrArg (W.1.hom ≫ ·)
    (congrArg (fun k => k.hom) (isPullback_chartBaseChangeInclusion B S hS g U).w.symm))

/-- **A function vanishing over a closed subspace lies in the pulled-back ideal.** Let `x` be a
regular function on all scheme charts of `P = Y ×_X U` vanishing at every point of `P` whose
image in `X` lies in the closed subspace `Z`. On every affine étale chart `W` of `P` the value
of `x` lies in the ideal generated by the pullback of the defining ideal of `Z` at `U`. -/
theorem mem_map_definingIdealAt_of_forall_eq_zero (Z : ClosedSubspaces B S hS X.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    (W : SmallEtale B S hS (chartBaseChangeSpace B S hS g U).1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left)]
    (x : chartFunctions B S hS (chartBaseChangeSpace B S hS g U).1)
    (hx : ∀ (a : BigFppfOver B S hS) (y : yoneda.obj a ⟶ (chartBaseChangeSpace B S hS g U).1)
      (z : yoneda.obj a ⟶ Z.1.toFunctor),
      z ≫ Z.1.ι = y ≫ (chartBaseChangeInclusion B S hS g U).hom ≫ g.hom →
        x.val (op (CostructuredArrow.mk y)) = 0) :
    x.val (op (CostructuredArrow.mk W.1.hom)) ∈
      Ideal.map (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
        (chartBaseChangeChartMap g U W)).op).hom (definingIdealAt B S hS X Z (op U)) := by
  set ψ := (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
    (chartBaseChangeChartMap g U W)).op).hom
  set J := Ideal.map ψ (definingIdealAt B S hS X Z (op U))
  let πo := quotientSiteHom W.1.left J
  let T := quotientSiteObj W.1.left J
  have hker : RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map πo).op).hom = J :=
    ker_quotientSiteHom W.1.left J
  have hT : U.1.hom.app (op T) (πo ≫ chartBaseChangeChartMap g U W) ∈ Z.1.obj (op T) := by
    refine (mem_obj_iff_definingIdealAt_le B S hS X Z U (πo ≫ chartBaseChangeChartMap g U W)).2
      fun r hr => ?_
    change (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (πo ≫ chartBaseChangeChartMap g U W)).op).hom r = 0
    simp only [Functor.map_comp, op_comp, CommRingCat.hom_comp]
    change (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map πo).op).hom (ψ r) = 0
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_map_of_mem ψ hr
  let z : yoneda.obj T ⟶ Z.1.toFunctor := yonedaEquiv.symm ⟨_, hT⟩
  have hy : (yoneda.map πo ≫ W.1.hom) ≫ (chartBaseChangeInclusion B S hS g U).hom ≫ g.hom =
      yoneda.map (πo ≫ chartBaseChangeChartMap g U W) ≫ U.1.hom := by
    rw [Functor.map_comp, Category.assoc, Category.assoc, yoneda_map_chartBaseChangeChartMap]
  have hz : z ≫ Z.1.ι = (yoneda.map πo ≫ W.1.hom) ≫
      (chartBaseChangeInclusion B S hS g U).hom ≫ g.hom := by
    rw [hy]
    apply yonedaEquiv.injective
    rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map]
    change (Z.1.ι.app (op T)) (yonedaEquiv (yonedaEquiv.symm ⟨_, hT⟩)) = _
    exact (congrArg (fun w => (Z.1.ι.app (op T)) w) (Equiv.apply_symm_apply _ _)).trans rfl
  rw [← hker, RingHom.mem_ker]
  exact (x.property (CostructuredArrow.homMk πo rfl :
    CostructuredArrow.mk (yoneda.map πo ≫ W.1.hom) ⟶ CostructuredArrow.mk W.1.hom).op).trans
      (hx T (yoneda.map πo ≫ W.1.hom) z hz)

end Vanishing

end AlgebraicGeometry.Space

end
