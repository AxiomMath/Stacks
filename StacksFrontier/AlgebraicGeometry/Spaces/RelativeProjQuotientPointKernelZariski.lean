/-!
# The kernel of `f^*𝒜 ⟶ f^*(𝒜/ℱ𝒜)` on the Zariski opens of an affine scheme point

In Situation 0849 let `ℱ ⊆ 𝒜_d` be a quasi-coherent submodule, `ℐ = ℱ𝒜` the graded ideal it
generates and `f : T ⟶ X` a scheme point of the base with `T` affine.  The restriction
`ψ : f^*𝒜 ⟶ f^*(𝒜/ℱ𝒜)` of the quotient homomorphism is a homomorphism of quasi-coherent graded
`𝒪_T`-algebras (Stacks 084B (2)).  This file proves that its kernel is the graded ideal `𝒢(f^*𝒜)`
generated by the image `𝒢 ⊆ (f^*𝒜)_d` of `f^*ℱ`, on the sections over every affine open of `T`:
the kernel clause `…RelativeProjGradedIdeal.IsQuotientByDegreeSubmodule` taken by
`AlgebraicGeometry.Space.RelativeProjSituation.range_eq_range_quotientFibreMap` in the proof of
Stacks 085N.

The argument is the source's "pullback is right exact".  On the small étale site of `T`, `f^*`
preserves the cokernel `ℐ_n ⟶ 𝒜_n ⟶ (𝒜/ℐ)_n`, so a section killed by `ψ` lies in the étale graded
ideal `Ĝ` generated by the étale image of `f^*ℱ`
(`…RelativeProjSituation.mem_pointDegreeIdeal_of_pullback_quotient_eq_zero`).
It remains to compare `Ĝ` with the Zariski ideal `𝒢(f^*𝒜)`.  Let `π : (f^*𝒜)_n ⟶ C` be the Zariski
quotient by `𝒢(f^*𝒜)_n` and `π̃ : (f^*𝒜)_n ⟶ C^a` its transpose for the adjunction of Stacks 03DU
(`AlgebraicGeometry.Space.zariskiReadingAdjunction`), the counit being invertible on the
quasi-coherent module `(f^*𝒜)_n`.  The Zariski reading of `π̃` is `π` followed by the unit at `C`,
an isomorphism, so `π̃` and `π` have the same kernel on the Zariski opens.  The kernel of `π̃`
contains the generators of `Ĝ`: on an affine étale chart over `T` the sections of the
quasi-coherent modules `f^*ℱ` and `(f^*𝒜)_m` are spanned by restrictions of sections over `T`
(Stacks 03DX (2)), and over `T` the products of such sections lie in `𝒢(f^*𝒜)`.

## Main results

* `…RelativeProjSituation.mem_pointDegreeIdeal_of_pullback_quotient_eq_zero`: a section of
  `(f^*𝒜)_n` killed by the pullback of `𝒜 ⟶ 𝒜/ℱ𝒜` lies in the étale ideal `Ĝ_n`.
* `AlgebraicGeometry.Space.zariskiImageSubmodule`: the Zariski image of a morphism into a piece of
  a graded algebra on a represented space; quasi-coherent when the morphism is one of
  quasi-coherent modules.
* `AlgebraicGeometry.Space.mem_generatedByDegree_zariskiImageSubmodule`: **the Zariski step** —
  for `T` affine, the sections of `Ĝ_n` over the Zariski opens lie in `𝒢(E_Zar)_n`.
* `AlgebraicGeometry.Space.isQuotientByDegreeSubmodule_zariskiImageSubmodule`: the kernel clause
  for a homomorphism out of the Zariski reading.
* `AlgebraicGeometry.Space.RelativeProjSituation.pointZariskiImageSubmodule`: the image
  `𝒢 ⊆ (f^*𝒜)_d` of `f^*ℱ`, on the Zariski site of `T`
  (`…isQuasicoherent_pointZariskiImageSubmodule`).
* `…RelativeProjSituation.isQuotientByDegreeSubmodule_pointZariskiImageSubmodule`:
  **the kernel of `f^*𝒜 ⟶ f^*(𝒜/ℱ𝒜)` is `𝒢(f^*𝒜)`** on the affine opens of an affine `T`; this
  is the hypothesis `hk` of
  `AlgebraicGeometry.Space.RelativeProjSituation.range_eq_range_quotientFibreMap`.

## Implementation notes

The algebra `f^*𝒜` of Stacks 084B (2) is spelled through `s.shrink`, the étale ideal `Ĝ` and the
quotient argument through `s.pullback (pointHom f)`; the two spellings are definitionally equal
(`…etalePointAlgebra_shrink_eq`) but comparing their projections is expensive.  The general
statements are therefore proved for an arbitrary graded algebra `E` on a represented space, and
`isQuotientByDegreeSubmodule_zariskiImageSubmodule_of_eq` transports them along an equality
`E = E'` of the two spellings, with an identity bridge `ι` for the sections.

## References

* [Stacks Project, Tag 085N](https://stacks.math.columbia.edu/tag/085N)
* [Stacks Project, Tag 03DU](https://stacks.math.columbia.edu/tag/03DU)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 0802](https://stacks.math.columbia.edu/tag/0802)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Sheaves.GradedAlgebraEssentiallySmall (gradedPull gradedPush gradedAdj)

universe u

namespace CategoryTheory.Adjunction

variable {C D : Type*} [Category C] [Category D] {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G)

/-- For an adjunction between categories with zero morphisms, `F g ≫ q` vanishes as soon as `g`
composed with the adjunct of `q` does. -/
theorem map_comp_eq_zero_of_comp_homEquiv [HasZeroMorphisms C] [HasZeroMorphisms D] {A A' : C}
    {B : D} (g : A' ⟶ A) (q : F.obj A ⟶ B) (h : g ≫ adj.homEquiv _ _ q = 0) :
    F.map g ≫ q = 0 := by
  have := adj.isLeftAdjoint
  have h0 : (adj.homEquiv A' B).symm 0 = 0 := by
    rw [Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]
  rw [← h0, ← h, adj.homEquiv_naturality_left_symm, Equiv.symm_apply_apply]

include adj in
/-- **A left adjoint carries a cokernel to a cokernel**, in the form of the factorization it gives:
a morphism out of `F A` killing `F ι` factors through `F q`, for `q` a cokernel of `ι`. -/
theorem exists_map_comp_eq_of_isColimit [HasZeroMorphisms C] [HasZeroMorphisms D] {K A Q : C}
    {ι : K ⟶ A} {q : A ⟶ Q} {w : ι ≫ q = 0} (hc : IsColimit (CokernelCofork.ofπ q w)) {Y : D}
    (h : F.obj A ⟶ Y) (hh : F.map ι ≫ h = 0) : ∃ σ : F.obj Q ⟶ Y, F.map q ≫ σ = h := by
  have : G.IsRightAdjoint := ⟨F, ⟨adj⟩⟩
  have h0 : adj.homEquiv K Y 0 = 0 := by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have h1 : ι ≫ adj.homEquiv _ _ h = 0 := by
    rw [← adj.homEquiv_naturality_left, hh, h0]
  obtain ⟨σ', hσ'⟩ := CokernelCofork.IsColimit.desc' hc (adj.homEquiv _ _ h) h1
  change q ≫ σ' = _ at hσ'
  refine ⟨(adj.homEquiv _ _).symm σ', ?_⟩
  rw [← adj.homEquiv_naturality_left_symm, hσ', Equiv.symm_apply_apply]

/-- The right adjoint of the transpose `inv ε_P ≫ F π` of a morphism `π : G P ⟶ c`, at an object
where the counit is invertible, is `π` followed by the unit at `c`. -/
theorem map_inv_counit_comp_map {P : D} {c : C} (π : G.obj P ⟶ c) [IsIso (adj.counit.app P)] :
    G.map (inv (adj.counit.app P) ≫ F.map π) = π ≫ adj.unit.app c := by
  rw [Functor.map_comp, Functor.map_inv,
    IsIso.inv_eq_of_inv_hom_id (adj.right_triangle_components P)]
  exact (adj.unit.naturality π).symm

end CategoryTheory.Adjunction

namespace AlgebraicGeometry.Space.RelativeProjSituation

variable (s : RelativeProjSituation.{u, u}) {T : BigFppfOver s.site s.base s.containsBase}
  (f : yoneda.obj T ⟶ s.space.1)

/-- The pullback of modules along a scheme point. -/
local notation "𝒫" => modulePullback s.site s.base s.containsBase (pointHom f)

/-- The morphism of small étale ringed topoi of a scheme point. -/
local notation "ρ" => smallEtaleRingedToposHom s.site s.base s.containsBase (pointHom f)

/-! ### The étale step: the kernel of the pullback of `𝒜 ⟶ 𝒜/ℱ𝒜` -/

/-- **A section of `(f^*𝒜)_n` killed by the pullback of `𝒜 ⟶ 𝒜/ℱ𝒜` lies in `Ĝ_n`**, the étale
graded ideal generated by the image of `f^*ℱ`: the pullback preserves the cokernel
`ℱ𝒜_n ⟶ 𝒜_n ⟶ (𝒜/ℱ𝒜)_n` (it is a left adjoint), and the quotient map by `Ĝ` kills the pullback of
`ℱ𝒜_n ⟶ 𝒜_n`. -/
theorem mem_pointDegreeIdeal_of_pullback_quotient_eq_zero {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (n : ℤ)
    (V : (SmallEtale s.site s.base s.containsBase (yoneda.obj T))ᵒᵖ)
    (x : ((s.pullback (pointHom f)).algebra.piece n).val.obj V)
    (h : ((𝒫).map ((s.smallAlgebraPieceIso n).hom ≫ s.quotientMkApp (s.degreeIdeal ℱ) n)).val.app
      V x = 0) :
    x ∈ ((s.pointDegreeIdeal f ℱ).piece n).obj V := by
  let t := s.pullback (pointHom f)
  let qt := t.quotientMkApp (s.pointDegreeIdeal f ℱ) n
  let e := s.smallAlgebraPieceIso n
  obtain ⟨σ, hσ⟩ := (modulePullbackAdjunction s.site s.base s.containsBase
    (pointHom f)).exists_map_comp_eq_of_isColimit (s.quotientMkIsColimit (s.degreeIdeal ℱ) n)
    ((𝒫).map e.inv ≫ qt) (by
      refine ((𝒫).map_comp_assoc _ _ _).symm.trans ?_
      refine (ρ).pullbackAdjPushforwardModulesViaComparison.map_comp_eq_zero_of_comp_homEquiv
        _ _ ?_
      refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun W => ?_)
      ext y
      exact s.pointQuotientAdjunct_app_eq_zero f ℱ n W y.1 y.2)
  have hx : ((𝒫).map e.inv).val.app V (((𝒫).map e.hom).val.app V x) = x :=
    congrArg (fun φ => φ.val.app V x) ((𝒫).mapIso e).hom_inv_id
  have h1 : qt.val.app V x = σ.val.app V
      (((𝒫).map (s.quotientMkApp (s.degreeIdeal ℱ) n)).val.app V
        (((𝒫).map e.hom).val.app V x)) := by
    have := congrArg (fun φ => φ.val.app V (((𝒫).map e.hom).val.app V x)) hσ
    refine (congrArg (qt.val.app V) hx).symm.trans (this.symm.trans ?_)
    rfl
  have h2 : ((𝒫).map (s.quotientMkApp (s.degreeIdeal ℱ) n)).val.app V
      (((𝒫).map e.hom).val.app V x) = 0 :=
    (congrArg (fun φ => φ.val.app V x)
      ((𝒫).map_comp e.hom (s.quotientMkApp (s.degreeIdeal ℱ) n))).symm.trans h
  exact mem_of_quotientMkApp_eq_zero t (s.pointDegreeIdeal f ℱ) n V x
    (h1.trans ((congrArg (σ.val.app V) h2).trans (map_zero _)))

end AlgebraicGeometry.Space.RelativeProjSituation

namespace AlgebraicGeometry.Space

open Stacks.AlgebraicGeometry.SheafSymmetricAlgebra (toSheafGradedAlgebra)
open Stacks.AlgebraicGeometry.RelativeProjGradedIdeal (generatedByDegree
  isQuasicoherentQuotPieces_gradedIdealGeneratedByDegree)

/-! ### The Zariski step, for an arbitrary graded algebra on a represented space -/

section ZariskiKernel

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} (T : BigFppfOver B S hS)

/-- The étale chart of the Zariski open `⊤` of the scheme of `T`,
`AlgebraicGeometry.Space.readingTopChart`. -/
abbrev selfOpensTop : SmallEtale B S hS (yoneda.obj T) :=
  readingTopChart T

/-- Every étale chart of the represented space of `T` maps to the chart of the open `⊤`. -/
def toSelfOpensTop (W : SmallEtale B S hS (yoneda.obj T)) : W ⟶ selfOpensTop T :=
  ObjectProperty.homMk (CostructuredArrow.homMk (yoneda.preimage W.obj.hom)
      ((Category.comp_id _).trans (yoneda.map_preimage _))) ≫
    (openChartTopIso B S hS (yoneda.obj T) (idEtaleChart B S hS T)).inv ≫
    eqToHom (selfOpensFunctor_obj B S hS T ⊤).symm

/-- The chart of the open `⊤` of an affine scheme is affine. -/
theorem isAffine_selfOpensTop [IsAffine ((BigFppfOver.toScheme B S hS).obj T)] :
    IsAffine ((SmallEtale.toOver B S hS (yoneda.obj T) ⋙ BigFppfOver.toScheme B S hS).obj
      (selfOpensTop T)) := by
  rw [selfOpensTop, readingTopChart, selfOpensFunctor_obj]
  have : IsAffine (chartScheme (idEtaleChart B S hS T)) :=
    inferInstanceAs (IsAffine ((BigFppfOver.toScheme B S hS).obj T))
  exact isAffine_chartScheme_openChart B S hS (yoneda.obj T) (idEtaleChart B S hS T)
    ⟨⊤, isAffineOpen_top _⟩

/-- **On an affine étale chart over an affine `T`, a section of a quasi-coherent module is a
combination of restrictions of sections over `T`** (Stacks 03DX (2)). -/
theorem mem_span_restrict_selfOpensTop [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T))
    (hG : G.IsQuasicoherentOnSite) (W : SmallEtale B S hS (yoneda.obj T))
    (hW : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj T) ⋙
      BigFppfOver.toScheme B S hS).obj W)) (x : G.val.obj (op W)) :
    x ∈ Submodule.span (chartRing B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T) W)
      (Set.range fun y : G.val.obj (op (selfOpensTop T)) =>
        chartRestrictLinear G (toSelfOpensTop T W) y) := by
  rw [← range_chartBaseChange]
  exact (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS (yoneda.obj T)
    (isAlgebraicSpace_yoneda B S hS T) G hG (selfOpensTop T) W (isAffine_selfOpensTop T) hW
    (toSelfOpensTop T W)).2 x

variable (E : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS (yonedaSpace B S hS
    T)))
  (hc : Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.IsCommutative
    (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E))
  (hn : Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.VanishesInNegativeDegrees
    (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E))
  (hq : ∀ n : ℤ, (((zariskiReading T E).piece n :
    ((BigFppfOver.toScheme B S hS).obj T).Modules)).IsQuasicoherent)

/-- The product of the Zariski reading of a graded algebra on a represented space is the product
of the algebra, over the chart of the Zariski open. -/
theorem zariskiReading_mul_app (i j : ℤ) (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
    (a : (E.piece i).val.obj (op ((selfOpensFunctor B S hS T).obj U)))
    (b : (E.piece j).val.obj (op ((selfOpensFunctor B S hS T).obj U))) :
    ((toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
        hq).mul i j).app U a b =
      (E.mul i j).app (op ((selfOpensFunctor B S hS T).obj U)) a b :=
  rfl

/-- **The Zariski image of an étale morphism into a homogeneous piece**: for `φ : G ⟶ E_d` on the
small étale site of the represented space of `T`, the sectionwise image of its Zariski reading, a
submodule of the degree-`d` piece of the Zariski reading of `E`. -/
def zariskiImageSubmodule {d : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (φ : G ⟶ E.piece d) :
    ((toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
        hq).piece d).Submodule :=
  AlgebraicGeometry.imageSubmodule
    ((SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T)).map φ)

/-- The Zariski image of a morphism of quasi-coherent modules is quasi-coherent. -/
theorem isQuasicoherent_zariskiImageSubmodule {d : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (hG : G.IsQuasicoherentOnSite) (hE : (E.piece d).IsQuasicoherentOnSite) (φ : G ⟶ E.piece d) :
    (zariskiImageSubmodule T E hc hn hq φ).toSheafOfModules.IsQuasicoherent := by
  have h1 : (((SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T)).obj G :
      ((BigFppfOver.toScheme B S hS).obj T).Modules)).IsQuasicoherent :=
    isQuasicoherent_zariskiReading_piece T G hG
  have h2 : (((SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T)).obj (E.piece d) :
      ((BigFppfOver.toScheme B S hS).obj T).Modules)).IsQuasicoherent :=
    isQuasicoherent_zariskiReading_piece T (E.piece d) hE
  exact @AlgebraicGeometry.isQuasicoherent_imageSubmodule _ _ _ _ h1 h2

/-- The values of `φ` lie in its Zariski image. -/
theorem apply_mem_zariskiImageSubmodule {d : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (φ : G ⟶ E.piece d) (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
    (c : G.val.obj (op ((selfOpensFunctor B S hS T).obj U))) :
    φ.val.app (op ((selfOpensFunctor B S hS T).obj U)) c ∈
      (zariskiImageSubmodule T E hc hn hq φ).toSubmodule.obj (op U) := by
  refine (AlgebraicGeometry.mem_kernelSubmodule_iff _ U _).2 ?_
  exact congrArg (fun χ => χ.val.app (op U) c)
    (cokernel.condition (C := ((BigFppfOver.toScheme B S hS).obj T).Modules)
      ((SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T)).map φ))

/-- The property of a family `Ĝ` of submodules of the pieces of `E`, of being below every
submodule containing the products of the sections of the image of `φ : G ⟶ E_d` with homogeneous
sections of `E`: the universal property of the étale graded ideal generated by the image. -/
def IsBelowGeneratedInDegree {d : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (φ : G ⟶ E.piece d) (Ĝ : ∀ n : ℤ, (E.piece n).Submodule) : Prop :=
  ∀ (n : ℤ) (N : (E.piece n).Submodule),
    (∀ (m : ℤ), d + m = n → ∀ (V : (SmallEtale B S hS (yoneda.obj T))ᵒᵖ)
      (a : (E.piece d).val.obj V),
      a ∈ (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule φ).obj V →
        ∀ (b : (E.piece m).val.obj V) (y : (E.piece n).val.obj V),
          HEq y ((E.mul d m).app V a b) → y ∈ N.obj V) → Ĝ n ≤ N

/-- **The transpose of the Zariski quotient by `𝒢(E_Zar)`.**  For an adjunction `L ⊣ (-)_Zar`
whose counit is invertible at `E_k` and unit at the quotient `C = (E_Zar/𝒢(E_Zar))_k`, the
transpose `ε⁻¹ ≫ L π : E_k ⟶ L C` of the quotient map `π` kills a section of `E_k` over a Zariski
open exactly when it lies in `𝒢(E_Zar)_k`: its Zariski reading is `π` followed by the unit. -/
theorem exists_transpose_quotMkApp {d : ℤ}
    (𝒢 : ((toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc
        hn hq).piece d).Submodule) (k : ℤ)
    {L : _ ⥤ _} (adj : L ⊣ SheafOfModules.pushforward.{u} (selfOpensStructureMap B S hS T))
    [hε : IsIso (adj.counit.app (E.piece k))]
    [hη : IsIso (adj.unit.app ((Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotSheafAlgebra
      (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
          hq)
      (Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.gradedIdealGeneratedByDegree
        (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
            hq) 𝒢)).piece k))] :
    ∃ πt : E.piece k ⟶ L.obj
        ((Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotSheafAlgebra
          (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc
              hn hq)
          (Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.gradedIdealGeneratedByDegree
            (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E)
                hc hn hq) 𝒢)).piece k),
      ∀ (W : ((BigFppfOver.toScheme B S hS).obj T).Opens)
        (y : Γ((toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T
            E) hc hn hq).piece k, W)),
        πt.val.app (op ((selfOpensFunctor B S hS T).obj W)) y = 0 ↔
          y ∈ (generatedByDegree (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T)
              (zariskiReading T E) hc hn hq) 𝒢
            k).toSubmodule.obj (op W) := by
  let A := toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc
      hn hq
  let I := Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.gradedIdealGeneratedByDegree A 𝒢
  let C := (Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotSheafAlgebra A I).piece k
  let π := Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotMkApp A I k
  refine ⟨inv (adj.counit.app (E.piece k)) ≫ L.map π, fun W y => ?_⟩
  have h1 : (inv (adj.counit.app (E.piece k)) ≫ L.map π).val.app
      (op ((selfOpensFunctor B S hS T).obj W)) y =
        (adj.unit.app C).val.app (op W) (π.val.app (op W) y) :=
    congrArg (fun χ => χ.val.app (op W) y) (adj.map_inv_counit_comp_map π)
  have hiff := Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotMkApp_app_eq_zero_iff A I k W y
  have h2 := congrArg (fun χ => χ.val.app (op W) (π.val.app (op W) y))
    (IsIso.hom_inv_id (adj.unit.app C))
  exact ⟨fun h => hiff.1 (h2.symm.trans ((congrArg ((inv (adj.unit.app C)).val.app (op W))
      (h1.symm.trans h)).trans (map_zero _))),
    fun h => h1.trans ((congrArg ((adj.unit.app C).val.app (op W)) (hiff.2 h)).trans (map_zero _))⟩

/-- On an affine chart `W` over an affine `T`, a morphism `πt : E_{d+m} ⟶ Q` killing the products
`φ(c) · b₀` of sections over the chart of `⊤` kills `φ(c|_W) · b'` for every section `b'` of `E_m`
over `W`. -/
private theorem app_mul_restrict_eq_zero_of_isAffine
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (hE : ∀ n, (E.piece n).IsQuasicoherentOnSite) {d m : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (φ : G ⟶ E.piece d)
    {Q : SheafOfModules.{u} (structureRingSheaf B S hS (yonedaSpace B S hS T))}
    (πt : E.piece (d + m) ⟶ Q)
    (htop : ∀ (c : G.val.obj (op (selfOpensTop T)))
      (b₀ : (E.piece m).val.obj (op (selfOpensTop T))),
      πt.val.app (op (selfOpensTop T))
        ((E.mul d m).app (op (selfOpensTop T)) (φ.val.app (op (selfOpensTop T)) c) b₀) = 0)
    (W : SmallEtale B S hS (yoneda.obj T))
    (hW : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj T) ⋙
      BigFppfOver.toScheme B S hS).obj W))
    (c : G.val.obj (op (selfOpensTop T))) (b' : (E.piece m).val.obj (op W)) :
    πt.val.app (op W) ((E.mul d m).app (op W)
      (φ.val.app (op W) (chartRestrictLinear G (toSelfOpensTop T W) c)) b') = 0 := by
  let k₀ := toSelfOpensTop T W
  have hb' := mem_span_restrict_selfOpensTop T (E.piece m) (hE m) W hW b'
  induction hb' using Submodule.span_induction with
  | mem b₁ hb₁ =>
    obtain ⟨b₀, rfl⟩ := hb₁
    have e1 : φ.val.app (op W) (chartRestrictLinear G k₀ c) =
        (E.piece d).val.map k₀.op (φ.val.app (op (selfOpensTop T)) c) :=
      PresheafOfModules.naturality_apply φ.val k₀.op c
    have e2 := ((E.mul d m).naturality k₀.op (φ.val.app (op (selfOpensTop T)) c) b₀).symm
    have e3 := PresheafOfModules.naturality_apply πt.val k₀.op
      ((E.mul d m).app (op (selfOpensTop T)) (φ.val.app (op (selfOpensTop T)) c) b₀)
    refine (congrArg (fun z => πt.val.app (op W) ((E.mul d m).app (op W) z
      (chartRestrictLinear (E.piece m) k₀ b₀))) e1).trans ?_
    refine (congrArg (πt.val.app (op W)) e2).trans (e3.trans ?_)
    rw [htop c b₀]
    exact map_zero _
  | zero =>
    rw [map_zero]
    exact map_zero _
  | add b₁ b₂ _ _ h₁ h₂ =>
    rw [map_add, map_add, h₁, h₂, add_zero]
  | smul r b₁ _ h₁ =>
    have hu : (E.mul d m).app (op W) _ b₁ ∈
        (Stacks.SheafOfModules.kerSubmodule πt).obj (op W) := h₁
    have hv := ((Stacks.SheafOfModules.kerSubmodule πt).obj (op W)).smul_mem r hu
    exact (congrArg (πt.val.app (op W)) ((E.mul d m).map_smul_right (op W) r _ b₁)).trans hv

/-- On an affine chart `W` over an affine `T`, a morphism `πt : E_{d+m} ⟶ Q` killing the products
`φ(c) · b₀` of sections over the chart of `⊤` kills every product `φ(c') · b'` over `W`. -/
private theorem app_mul_eq_zero_of_isAffine
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (hE : ∀ n, (E.piece n).IsQuasicoherentOnSite) {d m : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (hG : G.IsQuasicoherentOnSite) (φ : G ⟶ E.piece d)
    {Q : SheafOfModules.{u} (structureRingSheaf B S hS (yonedaSpace B S hS T))}
    (πt : E.piece (d + m) ⟶ Q)
    (htop : ∀ (c : G.val.obj (op (selfOpensTop T)))
      (b₀ : (E.piece m).val.obj (op (selfOpensTop T))),
      πt.val.app (op (selfOpensTop T))
        ((E.mul d m).app (op (selfOpensTop T)) (φ.val.app (op (selfOpensTop T)) c) b₀) = 0)
    (W : SmallEtale B S hS (yoneda.obj T))
    (hW : IsAffine ((SmallEtale.toOver B S hS (yoneda.obj T) ⋙
      BigFppfOver.toScheme B S hS).obj W))
    (c' : G.val.obj (op W)) (b' : (E.piece m).val.obj (op W)) :
    πt.val.app (op W) ((E.mul d m).app (op W) (φ.val.app (op W) c') b') = 0 := by
  have hc' := mem_span_restrict_selfOpensTop T G hG W hW c'
  induction hc' using Submodule.span_induction with
  | mem c₁ hc₁ =>
    obtain ⟨c, rfl⟩ := hc₁
    exact app_mul_restrict_eq_zero_of_isAffine T E hE φ πt htop W hW c b'
  | zero =>
    refine (congrArg (fun z => πt.val.app (op W) ((E.mul d m).app (op W) z b'))
      (map_zero (ConcreteCategory.hom (φ.val.app (op W))))).trans ?_
    refine (congrArg (πt.val.app (op W))
      ((DFunLike.congr_fun (map_zero ((E.mul d m).app (op W))) b').trans
        (AddMonoidHom.zero_apply b'))).trans ?_
    exact map_zero (ConcreteCategory.hom (πt.val.app (op W)))
  | add c₁ c₂ _ _ h₁ h₂ =>
    have e : (E.mul d m).app (op W) (φ.val.app (op W) (c₁ + c₂)) b' =
        (E.mul d m).app (op W) (φ.val.app (op W) c₁) b' +
          (E.mul d m).app (op W) (φ.val.app (op W) c₂) b' :=
      (congrArg (fun z => (E.mul d m).app (op W) z b')
        (map_add (ConcreteCategory.hom (φ.val.app (op W))) c₁ c₂)).trans
        ((DFunLike.congr_fun (map_add ((E.mul d m).app (op W)) (φ.val.app (op W) c₁)
          (φ.val.app (op W) c₂)) b').trans (AddMonoidHom.add_apply _ _ b'))
    have hu : (E.mul d m).app (op W) (φ.val.app (op W) c₁) b' ∈
        (Stacks.SheafOfModules.kerSubmodule πt).obj (op W) := h₁
    have hu' : (E.mul d m).app (op W) (φ.val.app (op W) c₂) b' ∈
        (Stacks.SheafOfModules.kerSubmodule πt).obj (op W) := h₂
    exact (congrArg (πt.val.app (op W)) e).trans
      (((Stacks.SheafOfModules.kerSubmodule πt).obj (op W)).add_mem hu hu')
  | smul r c₁ _ h₁ =>
    have hu : (E.mul d m).app (op W) (φ.val.app (op W) c₁) b' ∈
        (Stacks.SheafOfModules.kerSubmodule πt).obj (op W) := h₁
    have hv := ((Stacks.SheafOfModules.kerSubmodule πt).obj (op W)).smul_mem r hu
    have e1 := (ConcreteCategory.hom (φ.val.app (op W))).map_smul r c₁
    have e2 := (E.mul d m).map_smul_left (op W) r (φ.val.app (op W) c₁) b'
    refine (congrArg (fun z => πt.val.app (op W) ((E.mul d m).app (op W) z b')) e1).trans ?_
    exact (congrArg (πt.val.app (op W)) e2).trans hv

/-- **The generators of `Ĝ` die under a morphism killing the products of sections over `T`.**
Let `T` be affine and `πt : E_{d+m} ⟶ Q` kill every product `φ(c) · b` of sections over the chart
of `⊤`.  Then it kills every product `a · b` with `a` a section of the image of `φ`: membership in
its kernel is local, every chart is covered by affine ones, and on an affine chart the sections of
the quasi-coherent `G` and `E_m` are combinations of restrictions of sections over `T`
(Stacks 03DX (2)). -/
theorem mul_mem_kerSubmodule_of_imageSubmodule [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (hE : ∀ n, (E.piece n).IsQuasicoherentOnSite) {d m : ℤ}
    {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (hG : G.IsQuasicoherentOnSite) (φ : G ⟶ E.piece d)
    {Q : SheafOfModules.{u} (structureRingSheaf B S hS (yonedaSpace B S hS T))}
    (πt : E.piece (d + m) ⟶ Q)
    (htop : ∀ (c : G.val.obj (op (selfOpensTop T)))
      (b₀ : (E.piece m).val.obj (op (selfOpensTop T))),
      πt.val.app (op (selfOpensTop T))
        ((E.mul d m).app (op (selfOpensTop T)) (φ.val.app (op (selfOpensTop T)) c) b₀) = 0)
    (V : (SmallEtale B S hS (yoneda.obj T))ᵒᵖ) (a : (E.piece d).val.obj V)
    (ha : a ∈ (Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule φ).obj V)
    (b : (E.piece m).val.obj V) :
    (E.mul d m).app V a b ∈ (Stacks.SheafOfModules.kerSubmodule πt).obj V := by
  have hcov : (AffineEtale.inclusion B S hS (yoneda.obj T)).IsCoverDense
      (SmallEtale.topology B S hS (yoneda.obj T)) :=
    (AffineEtale.inclusion_isSpecialCocontinuous B S hS (yoneda.obj T)
      (isAlgebraicSpace_yoneda B S hS T)).2.isCoverDense'
  refine (Stacks.SheafOfModules.kerSubmodule πt).isSheaf _
    ((SmallEtale.topology B S hS (yoneda.obj T)).superset_covering ?_
      ((AffineEtale.inclusion B S hS (yoneda.obj T)).is_cover_of_isCoverDense
        (SmallEtale.topology B S hS (yoneda.obj T)) V.unop))
  rintro Y g ⟨W', l, k, ⟨rfl⟩⟩
  refine ((Stacks.SheafOfModules.kerSubmodule πt).toSubfunctor.sieveOfSection _).downward_closed
    (f := k) ?_ l
  obtain ⟨c', hc'⟩ := (mem_imageSubmodule_iff_of_isAffine φ hG (hE d) _ W'.property
    ((E.piece d).val.map k.op a)).1 ((Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule φ).map_mem
      k.op ha)
  show πt.val.app (op ((AffineEtale.inclusion B S hS (yoneda.obj T)).obj W'))
    ((E.piece (d + m)).val.map k.op ((E.mul d m).app V a b)) = 0
  refine (congrArg (πt.val.app (op ((AffineEtale.inclusion B S hS (yoneda.obj T)).obj W')))
    ((E.mul d m).naturality k.op a b)).trans ?_
  refine (congrArg (fun z => πt.val.app (op ((AffineEtale.inclusion B S hS (yoneda.obj T)).obj W'))
    ((E.mul d m).app (op ((AffineEtale.inclusion B S hS (yoneda.obj T)).obj W')) z
      ((E.piece m).val.map k.op b))) hc'.symm).trans ?_
  exact app_mul_eq_zero_of_isAffine T E hE hG φ πt htop _ W'.property c' _

/-- **The Zariski step.**  Let `T` be affine, `E` a graded algebra with quasi-coherent pieces on
the small étale site of the represented space of `T`, `φ : G ⟶ E_d` a morphism from a
quasi-coherent module, and `Ĝ` below the étale graded ideal generated by the image of `φ`.  Then
the sections of `Ĝ_n` over the Zariski opens of `T` lie in the Zariski graded ideal `𝒢(E_Zar)`
generated by the Zariski image `𝒢` of `φ`.

Let `π : (E_n)_Zar ⟶ C` be the quotient by `𝒢(E_Zar)_n` and `π̃ = ε⁻¹ ≫ π^a : E_n ⟶ C^a` its
transpose for the adjunction of Stacks 03DU (`exists_transpose_quotMkApp`); the counit is
invertible at the quasi-coherent `E_n` and the unit at the quasi-coherent `C`.  The kernel of `π̃`
contains the generators of `Ĝ_n` (`mul_mem_kerSubmodule_of_imageSubmodule`), because over `T`
the products of the sections of `𝒢` with homogeneous sections lie in `𝒢(E_Zar)`. -/
theorem mem_generatedByDegree_zariskiImageSubmodule
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)] (hE : ∀ n, (E.piece n).IsQuasicoherentOnSite)
    {d : ℤ} {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (hG : G.IsQuasicoherentOnSite) (φ : G ⟶ E.piece d) (Ĝ : ∀ n : ℤ, (E.piece n).Submodule)
    (hĜ : IsBelowGeneratedInDegree T E φ Ĝ) (n : ℤ)
    (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
    (x : Γ((toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc
        hn hq).piece n, U))
    (hx : x ∈ (Ĝ n).obj (op ((selfOpensFunctor B S hS T).obj U))) :
    x ∈ (generatedByDegree (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T)
        (zariskiReading T E) hc hn hq)
      (zariskiImageSubmodule T E hc hn hq φ) n).toSubmodule.obj (op U) := by
  let A := toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc
      hn hq
  let 𝒢 := zariskiImageSubmodule T E hc hn hq φ
  let I := Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.gradedIdealGeneratedByDegree A 𝒢
  have hqc := isQuasicoherentQuotPieces_gradedIdealGeneratedByDegree A 𝒢
    (isQuasicoherent_zariskiImageSubmodule T E hc hn hq hG (hE d) φ)
  obtain ⟨πt, hπt⟩ := exists_transpose_quotMkApp T E hc hn hq 𝒢 n (zariskiReadingAdjunction T)
    (hε := isIso_zariskiReadingAdjunction_counit_app T (E.piece n) (hE n))
    (hη := isIso_zariskiReadingAdjunction_unit_app T
      ((Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotSheafAlgebra A I).piece n) (hqc n))
  refine (hπt U x).1 ((Stacks.SheafOfModules.mem_kerSubmodule_obj πt _ x).1 (hĜ n _ ?_ _ hx))
  rintro m rfl V a ha b y hy
  obtain rfl := eq_of_heq hy
  refine mul_mem_kerSubmodule_of_imageSubmodule T E hE hG φ πt (fun c b₀ => ?_) V a ha b
  refine (hπt ⊤ _).2 ?_
  exact Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.isGeneratedInDegree_generatedByDegree A 𝒢
    (d + m) m rfl ⊤ _ (apply_mem_zariskiImageSubmodule T E hc hn hq φ ⊤ c) b₀ _
    (heq_of_eq (zariskiReading_mul_app T E hc hn hq d m ⊤ _ b₀).symm)

/-- **The kernel clause on the Zariski reading.**  Let `T` be affine, `E` a graded algebra with
quasi-coherent pieces on the small étale site of the represented space of `T`, `φ : G ⟶ E_d` a
morphism from a quasi-coherent module and `ψ : E_Zar ⟶ 𝔹` a homomorphism of sheaf-level graded
algebras on `T`.  Suppose a section of `(E_Zar)_n` killed by `ψ` lies in a family `Ĝ` below the
étale graded ideal generated by the image of `φ`, and `ψ` kills the values of `φ`.  Then the
kernel of `ψ` is the graded ideal generated by the Zariski image `𝒢` of `φ`, on the sections over
every open: `⊆` is `mem_generatedByDegree_zariskiImageSubmodule`, and `⊇` holds because the kernel
of a homomorphism of graded algebras containing `𝒢` contains the ideal `𝒢` generates. -/
theorem isQuotientByDegreeSubmodule_zariskiImageSubmodule
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)] (hE : ∀ n, (E.piece n).IsQuasicoherentOnSite)
    {d : ℤ} {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (hG : G.IsQuasicoherentOnSite) (φ : G ⟶ E.piece d) (Ĝ : ∀ n : ℤ, (E.piece n).Submodule)
    (hĜ : IsBelowGeneratedInDegree T E φ Ĝ)
    {𝔹 : Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra
      ((BigFppfOver.toScheme B S hS).obj T)}
    (ψ : Stacks.AlgebraicGeometry.RelativeProjMapDomain.SheafGradedAlgebraHom
      (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
          hq) 𝔹)
    (h₁ : ∀ (n : ℤ) (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
      (x : (E.piece n).val.obj (op ((selfOpensFunctor B S hS T).obj U))),
      (ψ.app n).app U x = 0 → x ∈ (Ĝ n).obj (op ((selfOpensFunctor B S hS T).obj U)))
    (h₂ : ∀ (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
      (c : G.val.obj (op ((selfOpensFunctor B S hS T).obj U))),
      (ψ.app d).app U (φ.val.app (op ((selfOpensFunctor B S hS T).obj U)) c) = 0) :
    Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.IsQuotientByDegreeSubmodule
      (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
          hq)
      (zariskiImageSubmodule T E hc hn hq φ) ψ := by
  intro n U _ x
  refine ⟨fun hx => mem_generatedByDegree_zariskiImageSubmodule T E hc hn hq hE hG φ Ĝ hĜ n U x
    (h₁ n U x hx), fun hx => ?_⟩
  let A := toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc
      hn hq
  let 𝒢 := zariskiImageSubmodule T E hc hn hq φ
  have hker : 𝒢 ≤ Stacks.Algebraization.kernelSubmodule (ψ.app d) :=
    AlgebraicGeometry.imageSubmodule_le_kernelSubmodule _ _ (by
      refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun W => ?_)
      ext c
      exact h₂ W.unop c)
  have hle : generatedByDegree A 𝒢 n ≤ Stacks.Algebraization.kernelSubmodule (ψ.app n) := by
    refine Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.generatedByDegree_le A 𝒢 ?_
    rintro m rfl W f' hf' a z hz
    obtain rfl := eq_of_heq hz
    refine (AlgebraicGeometry.mem_kernelSubmodule_iff _ W _).2 ?_
    have h0 : (ψ.app d).app W f' = 0 :=
      (AlgebraicGeometry.mem_kernelSubmodule_iff _ W _).1 (hker _ hf')
    refine (ψ.app_mul d m W f' a).trans ?_
    rw [h0, map_zero, AddMonoidHom.zero_apply]
    rfl
  exact (AlgebraicGeometry.mem_kernelSubmodule_iff _ U _).1 (hle _ hx)

/-- Membership in a submodule of a homogeneous piece, transported along an equality of graded
algebras on the represented space of `T`. -/
theorem mem_cast_submodule {E₁ E₂ : SheafOfModules.GradedAlgebra.{u, u}
      (structureRingSheaf B S hS (schemeSpace T))} (h : E₁ = E₂) (n : ℤ)
    (N : (E₂.piece n).Submodule) (V : (SmallEtale B S hS (yoneda.obj T))ᵒᵖ)
    (x : (E₂.piece n).val.obj V) (hx : x ∈ N.obj V) :
    cast (congrArg (fun E₀ : SheafOfModules.GradedAlgebra.{u, u}
      (structureRingSheaf B S hS (schemeSpace T)) => ((E₀.piece n).val.obj V : Type u))
        h.symm) x ∈
      (cast (congrArg (fun E₀ : SheafOfModules.GradedAlgebra.{u, u}
        (structureRingSheaf B S hS (schemeSpace T)) => (E₀.piece n).Submodule) h.symm)
          N).obj V := by
  subst h
  exact hx

/-- `isQuotientByDegreeSubmodule_zariskiImageSubmodule` with the étale data read on a second
spelling `E'` of the algebra `E`: the statement is transported along `E = E'`. -/
theorem isQuotientByDegreeSubmodule_zariskiImageSubmodule_of_eq
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (E' : SheafOfModules.GradedAlgebra.{u, u}
      (structureRingSheaf B S hS (yonedaSpace B S hS T)))
    (h : E = E') (hE : ∀ n, (E'.piece n).IsQuasicoherentOnSite)
    {d : ℤ} {G : Modules.{u, u} B S hS (yoneda.obj T) (isAlgebraicSpace_yoneda B S hS T)}
    (hG : G.IsQuasicoherentOnSite) (φ' : G ⟶ E.piece d) (φ : G ⟶ E'.piece d) (hφ : HEq φ' φ)
    (Ĝ : ∀ n : ℤ, (E'.piece n).Submodule) (hĜ : IsBelowGeneratedInDegree T E' φ Ĝ)
    {𝔹 : Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra
      ((BigFppfOver.toScheme B S hS).obj T)}
    (ψ : Stacks.AlgebraicGeometry.RelativeProjMapDomain.SheafGradedAlgebraHom
      (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
          hq) 𝔹)
    (ι : ∀ (n : ℤ) (V : (SmallEtale B S hS (yoneda.obj T))ᵒᵖ),
      (E'.piece n).val.obj V → (E.piece n).val.obj V)
    (hι : ∀ n V x, HEq (ι n V x) x)
    (h₁ : ∀ (n : ℤ) (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
      (x : (E'.piece n).val.obj (op ((selfOpensFunctor B S hS T).obj U))),
      (ψ.app n).app U (ι n _ x) = 0 → x ∈ (Ĝ n).obj (op ((selfOpensFunctor B S hS T).obj U)))
    (h₂ : ∀ (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
      (c : G.val.obj (op ((selfOpensFunctor B S hS T).obj U))),
      (ψ.app d).app U (ι d _ (φ.val.app (op ((selfOpensFunctor B S hS T).obj U)) c)) = 0) :
    Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.IsQuotientByDegreeSubmodule
      (toSheafGradedAlgebra (S := (BigFppfOver.toScheme B S hS).obj T) (zariskiReading T E) hc hn
          hq)
      (zariskiImageSubmodule T E hc hn hq φ') ψ := by
  subst h
  obtain rfl := eq_of_heq hφ
  refine isQuotientByDegreeSubmodule_zariskiImageSubmodule T E hc hn hq hE hG φ' Ĝ hĜ ψ
    (fun n U x hx => h₁ n U x ((congrArg ((ψ.app n).app U) (eq_of_heq (hι n _ x))).trans hx))
    (fun U c => (congrArg ((ψ.app d).app U) (eq_of_heq (hι d _ _))).symm.trans (h₂ U c))

end ZariskiKernel

end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space.RelativeProjSituation

open Stacks.AlgebraicGeometry.SheafSymmetricAlgebra (toSheafGradedAlgebra)

section HomPointsSections

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : AlgebraicSpaces B S hS}
  {𝒜₁ 𝒜₂ : SheafOfModules.GradedAlgebra.{u, u, u, u + 1} (structureRingSheaf B S hS X)}
  (h₁c : ∀ (i j : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ) (a : (𝒜₁.piece i).val.obj U)
    (b : (𝒜₁.piece j).val.obj U), HEq ((𝒜₁.mul i j).app U a b) ((𝒜₁.mul j i).app U b a))
  (h₁n : ∀ n : ℤ, n < 0 → Limits.IsZero (𝒜₁.piece n))
  (h₁q : ∀ n : ℤ, (𝒜₁.piece n).IsQuasicoherentOnSite)
  (h₁k : ∀ (n : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ),
    HasCardinalLT ↥((𝒜₁.piece n).val.obj U) B.cutoff)
  (h₂c : ∀ (i j : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ) (a : (𝒜₂.piece i).val.obj U)
    (b : (𝒜₂.piece j).val.obj U), HEq ((𝒜₂.mul i j).app U a b) ((𝒜₂.mul j i).app U b a))
  (h₂n : ∀ n : ℤ, n < 0 → Limits.IsZero (𝒜₂.piece n))
  (h₂q : ∀ n : ℤ, (𝒜₂.piece n).IsQuasicoherentOnSite)
  (h₂k : ∀ (n : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ),
    HasCardinalLT ↥((𝒜₂.piece n).val.obj U) B.cutoff)
  (ψ : SheafOfModules.GradedAlgebra.UnitalHom 𝒜₁ 𝒜₂)

local notation "𝔰₁" => RelativeProjSituation.mk B S hS X 𝒜₁ h₁c h₁n h₁q h₁k

/-- **The restriction of a map of graded algebras to a scheme point, on sections**: a section over
a Zariski open of `T` is killed by `f^*ψ` exactly when it is killed by the pullback of `ψ` to the
small étale site of `T`, over the chart of the open. -/
theorem homPoints_hom_app_app_eq_zero_iff (T : BigFppfOver B S hS) (f : yoneda.obj T ⟶ X.1)
    (n : ℤ) (U : ((BigFppfOver.toScheme B S hS).obj T).Opens)
    (x : (((𝔰₁).pullback (pointHom f)).algebra.piece n).val.obj
      (op ((selfOpensFunctor B S hS T).obj U))) :
    (((homPoints h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).hom T f).app n).app U x = 0 ↔
      ((etalePullHom (pointHom f)
        (shrinkMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ).toHom).app n).val.app
          (op ((selfOpensFunctor B S hS T).obj U)) x = 0 :=
  Iff.rfl

end HomPointsSections

/-! ### The kernel clause at an affine scheme point -/

section ZariskiReadingPoint

variable (t : RelativeProjSituation.{u, u}) (T : BigFppfOver t.site t.base t.containsBase)
  (f : yoneda.obj T ⟶ t.space.1)

/-- The Zariski reading of the pullback `f^*𝒜` to a scheme point is commutative. -/
theorem isCommutative_zariskiReading_etalePointAlgebra :
    Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.IsCommutative
      (S := (BigFppfOver.toScheme t.site t.base t.containsBase).obj T)
      (zariskiReading T (etalePointAlgebra t.algebra T f)) :=
  fun i j _ a b => etalePointAlgebra_mul_comm t.algebra t.mul_comm T f i j _ a b

/-- The Zariski reading of the pullback `f^*𝒜` to a scheme point vanishes in negative degrees. -/
theorem vanishesInNegativeDegrees_zariskiReading_etalePointAlgebra :
    Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.VanishesInNegativeDegrees
      (S := (BigFppfOver.toScheme t.site t.base t.containsBase).obj T)
      (zariskiReading T (etalePointAlgebra t.algebra T f)) :=
  fun n hn _ x => etalePointAlgebra_eq_zero t.algebra n (t.negative_isZero n hn) T f _ x

/-- The pieces of the Zariski reading of the pullback `f^*𝒜` are quasi-coherent. -/
theorem isQuasicoherent_zariskiReading_etalePointAlgebra_piece (n : ℤ) :
    (((zariskiReading T (etalePointAlgebra t.algebra T f)).piece n :
      ((BigFppfOver.toScheme t.site t.base t.containsBase).obj T).Modules)).IsQuasicoherent :=
  isQuasicoherent_zariskiReading_piece T _
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite t.site t.base t.containsBase
      (pointHom f) _ (t.isQuasicoherent n))

end ZariskiReadingPoint

variable (s : RelativeProjSituation.{u, u}) {T : BigFppfOver s.site s.base s.containsBase}
  (f : yoneda.obj T ⟶ s.space.1)

/-- The pullback of modules along a scheme point. -/
local notation "𝒫" => modulePullback s.site s.base s.containsBase (pointHom f)

/-- The pullback to a scheme point of the re-presented algebra, in the two spellings of the
situation: through `s.shrink` (Stacks 084B (2)) and through `s.pullback`. -/
theorem etalePointAlgebra_shrink_eq :
    etalePointAlgebra s.shrink.algebra T f = (s.pullback (pointHom f)).algebra :=
  rfl

/-- The pullback `f^*ℱ ⟶ (f^*𝒜)_d` of a submodule `ℱ ⊆ 𝒜_d` to a scheme point, with target the
degree-`d` piece of the pullback of the re-presented algebra in the spelling of Stacks 084B (2). -/
def pointImageMap {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) :
    (𝒫).obj ℱ.toSheafOfModules ⟶ (etalePointAlgebra s.shrink.algebra T f).piece d :=
  cast (congrArg (fun E₀ => (𝒫).obj ℱ.toSheafOfModules ⟶ E₀.piece d)
    (s.etalePointAlgebra_shrink_eq f).symm)
    (show (𝒫).obj ℱ.toSheafOfModules ⟶ (s.pullback (pointHom f)).algebra.piece d from
      (𝒫).map (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv))

/-- **The image `𝒢 ⊆ (f^*𝒜)_d` of `f^*ℱ`, on the Zariski site of `T`**: the Zariski image of the
pullback `f^*ℱ ⟶ (f^*𝒜)_d` of a submodule `ℱ ⊆ 𝒜_d`, a submodule of the degree-`d` piece of the
algebra `f^*𝒜` of Stacks 084B (2). -/
def pointZariskiImageSubmodule {d : ℤ} (ℱ : (s.algebra.piece d).Submodule) :
    ((s.shrink.pointAlgebra T f).piece d).Submodule :=
  zariskiImageSubmodule T (etalePointAlgebra s.shrink.algebra T f)
    (s.shrink.isCommutative_zariskiReading_etalePointAlgebra T f)
    (s.shrink.vanishesInNegativeDegrees_zariskiReading_etalePointAlgebra T f)
    (s.shrink.isQuasicoherent_zariskiReading_etalePointAlgebra_piece T f) (s.pointImageMap f ℱ)

/-- The image `𝒢` of `f^*ℱ` is quasi-coherent when `ℱ` is. -/
theorem isQuasicoherent_pointZariskiImageSubmodule {d : ℤ} (ℱ : (s.algebra.piece d).Submodule)
    (hℱ : ℱ.toSheafOfModules.IsQuasicoherentOnSite) :
    ((s.pointZariskiImageSubmodule f ℱ).toSheafOfModules :
      ((BigFppfOver.toScheme s.site s.base s.containsBase).obj T).Modules).IsQuasicoherent :=
  isQuasicoherent_zariskiImageSubmodule T (etalePointAlgebra s.shrink.algebra T f) _ _ _
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite s.site s.base s.containsBase
      (pointHom f) _ hℱ) ((s.pullback (pointHom f)).isQuasicoherent d) _

/-- The pullback to a scheme point of the quotient homomorphism `𝒜 ⟶ 𝒜/ℱ𝒜`, in degree `n`, is the
pullback of the quotient map conjugated by the identifications of the pieces. -/
private theorem etalePullHom_quotient_app_eq {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (hℐ : ∀ n : ℤ,
      ((s.degreeIdeal ℱ).piece n).toSheafOfModules.IsQuasicoherentOnSite) (n : ℤ) :
    (etalePullHom (pointHom f) (shrinkMap s.mul_comm s.negative_isZero s.isQuasicoherent
      s.sections_hasCardinalLT (s.quotient (s.degreeIdeal ℱ) hℐ).mul_comm
      (s.quotient (s.degreeIdeal ℱ) hℐ).negative_isZero
      (s.quotient (s.degreeIdeal ℱ) hℐ).isQuasicoherent
      (s.quotient (s.degreeIdeal ℱ) hℐ).sections_hasCardinalLT
      (s.quotientHom (s.degreeIdeal ℱ))).toHom).app n =
    (𝒫).map ((s.smallAlgebraPieceIso n).hom ≫ s.quotientMkApp (s.degreeIdeal ℱ) n ≫
      ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso n).inv) :=
  rfl

/-- **A section killed by `f^*𝒜 ⟶ f^*(𝒜/ℱ𝒜)` lies in the étale ideal `Ĝ`**, read on the Zariski
opens of `T` (`mem_pointDegreeIdeal_of_pullback_quotient_eq_zero`, through the identification of
the restriction of the quotient homomorphism with its pullback to the small étale site). -/
theorem mem_pointDegreeIdeal_of_quotientHomPoints_eq_zero {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (hℐ : ∀ n : ℤ,
      ((s.degreeIdeal ℱ).piece n).toSheafOfModules.IsQuasicoherentOnSite) (n : ℤ)
    (U : ((BigFppfOver.toScheme s.site s.base s.containsBase).obj T).Opens)
    (x : ((s.pullback (pointHom f)).algebra.piece n).val.obj
      (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)))
    (hx : (((s.quotientHomPoints (s.degreeIdeal ℱ) hℐ).hom T f).app n).app U x = 0) :
    x ∈ ((s.pointDegreeIdeal f ℱ).piece n).obj
      (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)) := by
  let V := op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)
  have h1 := (homPoints_hom_app_app_eq_zero_iff s.mul_comm s.negative_isZero s.isQuasicoherent
    s.sections_hasCardinalLT (s.quotient (s.degreeIdeal ℱ) hℐ).mul_comm
    (s.quotient (s.degreeIdeal ℱ) hℐ).negative_isZero (s.quotient (s.degreeIdeal ℱ)
        hℐ).isQuasicoherent
    (s.quotient (s.degreeIdeal ℱ) hℐ).sections_hasCardinalLT (s.quotientHom (s.degreeIdeal ℱ))
    T f n U x).1 hx
  have h3 := (congrArg (fun χ => χ.val.app V x)
    (s.etalePullHom_quotient_app_eq f ℱ hℐ n)).symm.trans h1
  have he : ((s.smallAlgebraPieceIso n).hom ≫ s.quotientMkApp (s.degreeIdeal ℱ) n ≫
      ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso n).inv) ≫
        ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso n).hom =
      (s.smallAlgebraPieceIso n).hom ≫ s.quotientMkApp (s.degreeIdeal ℱ) n :=
    (Category.assoc _ _ _).trans (congrArg ((s.smallAlgebraPieceIso n).hom ≫ ·)
      ((Category.assoc _ _ _).trans ((congrArg (s.quotientMkApp (s.degreeIdeal ℱ) n ≫ ·)
        (Iso.inv_hom_id _)).trans (Category.comp_id _))))
  have h4 : ((𝒫).map ((s.smallAlgebraPieceIso n).hom ≫
      s.quotientMkApp (s.degreeIdeal ℱ) n)).val.app V x = 0 :=
    (congrArg (fun χ => χ.val.app V x) (((𝒫).map_comp _ _).symm.trans
      (congrArg (𝒫).map he))).symm.trans
      ((congrArg (((𝒫).map ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso n).hom).val.app
          V)
        h3).trans (map_zero _))
  exact s.mem_pointDegreeIdeal_of_pullback_quotient_eq_zero f ℱ n V x h4

/-- The pullback of the quotient homomorphism `𝒜 ⟶ 𝒜/ℱ𝒜` to a scheme point kills the pullback of
`ℱ ⊆ ℱ𝒜`. -/
theorem etalePullHom_app_pointImage_eq_zero {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (hℐ : ∀ n : ℤ,
      ((s.degreeIdeal ℱ).piece n).toSheafOfModules.IsQuasicoherentOnSite)
    (V : (SmallEtale s.site s.base s.containsBase (yoneda.obj T))ᵒᵖ)
    (c : ((𝒫).obj ℱ.toSheafOfModules).val.obj V) :
    ((etalePullHom (pointHom f) (shrinkMap s.mul_comm s.negative_isZero s.isQuasicoherent
      s.sections_hasCardinalLT (s.quotient (s.degreeIdeal ℱ) hℐ).mul_comm
      (s.quotient (s.degreeIdeal ℱ) hℐ).negative_isZero
      (s.quotient (s.degreeIdeal ℱ) hℐ).isQuasicoherent
      (s.quotient (s.degreeIdeal ℱ) hℐ).sections_hasCardinalLT
      (s.quotientHom (s.degreeIdeal ℱ))).toHom).app d).val.app V
      ((show (𝒫).obj ℱ.toSheafOfModules ⟶ (s.pullback (pointHom f)).algebra.piece d from
        (𝒫).map (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv)).val.app V c) = 0 := by
  have := (modulePullbackAdjunction s.site s.base s.containsBase (pointHom f)).isLeftAdjoint
  refine (congrArg (fun χ => χ.val.app V
    (((𝒫).map (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv)).val.app V c))
    (s.etalePullHom_quotient_app_eq f ℱ hℐ d)).trans ?_
  have hι0 : ℱ.ι ≫ s.quotientMkApp (s.degreeIdeal ℱ) d = 0 := by
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun W => ?_)
    ext y
    exact ι_app_mem_quotientMkApp_eq_zero s (s.degreeIdeal ℱ) d W y.1
      (s.le_generatedByDegree_self ℱ W y.2)
  have hassoc : (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv) ≫ ((s.smallAlgebraPieceIso d).hom ≫
      s.quotientMkApp (s.degreeIdeal ℱ) d ≫ ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso
          d).inv) =
      (ℱ.ι ≫ s.quotientMkApp (s.degreeIdeal ℱ) d) ≫
        ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso d).inv :=
    (Category.assoc _ _ _).trans ((congrArg (ℱ.ι ≫ ·) (Iso.inv_hom_id_assoc _ _)).trans
      (Category.assoc _ _ _).symm)
  have hcomp := ((𝒫).map_comp (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv) ((s.smallAlgebraPieceIso
      d).hom ≫
      s.quotientMkApp (s.degreeIdeal ℱ) d ≫
        ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso d).inv)).symm.trans
    ((congrArg (𝒫).map hassoc).trans ((𝒫).map_comp _ _))
  have hv : ((𝒫).map (ℱ.ι ≫ s.quotientMkApp (s.degreeIdeal ℱ) d)).val.app V c = 0 :=
    (congrArg (fun χ => χ.val.app V c) ((congrArg (𝒫).map hι0).trans ((𝒫).map_zero _ _))).trans
      rfl
  exact (congrArg (fun χ => χ.val.app V c) hcomp).trans
    ((congrArg (((𝒫).map ((s.quotient (s.degreeIdeal ℱ) hℐ).smallAlgebraPieceIso d).inv).val.app V)
      hv).trans (map_zero _))

/-- **The restriction of the quotient homomorphism kills the image of `f^*ℱ`**: `ℱ ⊆ ℱ𝒜` is killed
by `𝒜 ⟶ 𝒜/ℱ𝒜`, hence its pullback by the pullback. -/
theorem quotientHomPoints_app_pointImage_eq_zero {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (hℐ : ∀ n : ℤ,
      ((s.degreeIdeal ℱ).piece n).toSheafOfModules.IsQuasicoherentOnSite)
    (U : ((BigFppfOver.toScheme s.site s.base s.containsBase).obj T).Opens)
    (c : ((𝒫).obj ℱ.toSheafOfModules).val.obj
      (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U))) :
    (((s.quotientHomPoints (s.degreeIdeal ℱ) hℐ).hom T f).app d).app U
      ((show (𝒫).obj ℱ.toSheafOfModules ⟶ (s.pullback (pointHom f)).algebra.piece d from
        (𝒫).map (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv)).val.app
          (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)) c) = 0 :=
  (homPoints_hom_app_app_eq_zero_iff s.mul_comm s.negative_isZero s.isQuasicoherent
    s.sections_hasCardinalLT (s.quotient (s.degreeIdeal ℱ) hℐ).mul_comm
    (s.quotient (s.degreeIdeal ℱ) hℐ).negative_isZero (s.quotient (s.degreeIdeal ℱ)
        hℐ).isQuasicoherent
    (s.quotient (s.degreeIdeal ℱ) hℐ).sections_hasCardinalLT (s.quotientHom (s.degreeIdeal ℱ))
    T f d U ((show (𝒫).obj ℱ.toSheafOfModules ⟶ (s.pullback (pointHom f)).algebra.piece d from
        (𝒫).map (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv)).val.app
          (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)) c)).2
    (s.etalePullHom_app_pointImage_eq_zero f ℱ hℐ _ c)

/-- **The kernel of `f^*𝒜 ⟶ f^*(𝒜/ℱ𝒜)` is `𝒢(f^*𝒜)`** at a scheme point `f : T ⟶ X` with `T`
affine, for a quasi-coherent `ℱ ⊆ 𝒜_d`: on the sections over every affine open of `T`, a
homogeneous section of `f^*𝒜` is killed by the restriction of the quotient homomorphism exactly
when it lies in the graded ideal generated by the image `𝒢` of `f^*ℱ`.  This is the hypothesis
`hk` of `AlgebraicGeometry.Space.RelativeProjSituation.range_eq_range_quotientFibreMap` for
`ℐ = ℱ𝒜`. -/
theorem isQuotientByDegreeSubmodule_pointZariskiImageSubmodule
    [IsAffine ((BigFppfOver.toScheme s.site s.base s.containsBase).obj T)] {d : ℤ}
    (ℱ : (s.algebra.piece d).Submodule) (hℱ : ℱ.toSheafOfModules.IsQuasicoherentOnSite) :
    Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.IsQuotientByDegreeSubmodule
      (s.shrink.pointAlgebra T f) (s.pointZariskiImageSubmodule f ℱ)
      ((s.quotientHomPoints (s.degreeIdeal ℱ)
        (s.isQuasicoherentOnSite_degreeIdeal_piece ℱ hℱ)).hom T f) := by
  have : IsAffine ((BigFppfOver.toScheme s.shrink.site s.shrink.base
      s.shrink.containsBase).obj T) :=
    inferInstanceAs (IsAffine ((BigFppfOver.toScheme s.site s.base s.containsBase).obj T))
  let hℐ := s.isQuasicoherentOnSite_degreeIdeal_piece ℱ hℱ
  let φ : (𝒫).obj ℱ.toSheafOfModules ⟶ (s.pullback (pointHom f)).algebra.piece d :=
    (𝒫).map (ℱ.ι ≫ (s.smallAlgebraPieceIso d).inv)
  have hĜ : IsBelowGeneratedInDegree T (s.pullback (pointHom f)).algebra φ
      (fun n => (s.pointDegreeIdeal f ℱ).piece n) :=
    fun n N hN => (s.pullback (pointHom f)).generatedByDegree_le hN
  have key := isQuotientByDegreeSubmodule_zariskiImageSubmodule_of_eq (B := s.shrink.site)
    (S := s.shrink.base) (hS := s.shrink.containsBase) T (etalePointAlgebra s.shrink.algebra T f)
    (s.shrink.isCommutative_zariskiReading_etalePointAlgebra T f)
    (s.shrink.vanishesInNegativeDegrees_zariskiReading_etalePointAlgebra T f)
    (s.shrink.isQuasicoherent_zariskiReading_etalePointAlgebra_piece T f)
    (s.pullback (pointHom f)).algebra (s.etalePointAlgebra_shrink_eq f)
    (s.pullback (pointHom f)).isQuasicoherent
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite s.site s.base s.containsBase
      (pointHom f) _ hℱ) (s.pointImageMap f ℱ) φ (cast_heq _ _)
    (fun n => (s.pointDegreeIdeal f ℱ).piece n) hĜ
    ((s.quotientHomPoints (s.degreeIdeal ℱ) hℐ).hom T f) (fun _ _ x => x) (fun _ _ _ => HEq.rfl) ?_
        ?_
  · exact key
  · intro n U x hx
    let x₂ : ((s.pullback (pointHom f)).algebra.piece n).val.obj
        (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)) := x
    exact s.mem_pointDegreeIdeal_of_quotientHomPoints_eq_zero f ℱ hℐ n U x₂ hx
  · intro U c
    let c₂ : ((𝒫).obj ℱ.toSheafOfModules).val.obj
        (op ((selfOpensFunctor s.site s.base s.containsBase T).obj U)) := c
    exact s.quotientHomPoints_app_pointImage_eq_zero f ℱ hℐ U c₂

end AlgebraicGeometry.Space.RelativeProjSituation

