/-! ### Two quotients of a module by the same ideal -/

section QuotSMul

variable {B C : Type*} [CommRing B] [CommRing C]

/-- **The fibre of a module read over the base or over the module's own ring.** For a ring
homomorphism `α : B → C`, an ideal `J` of `B`, the ideal `J'` it generates in `C` and a
`C`-module `M`, flatness of `M/JM` over `B/J` does not depend on whether `JM` is formed with
the scalars of `B` or of `C`: the two submodules are the same subgroup of `M`. -/
theorem Module.flat_quotient_smul_top_iff_flatQuotSMul (α : B →+* C) (J : Ideal B)
    (J' : Ideal C) (hJ : J' = J.map α) (M : Type*) [AddCommGroup M] [Module C M] :
    letI : Module B M := Module.compHom M α
    (Module.Flat (B ⧸ J) (M ⧸ (J • (⊤ : Submodule B M))) ↔
      Module.FlatQuotSMul α J J' hJ M) := by
  subst hJ
  let : Algebra B C := α.toAlgebra
  let : Module B M := Module.compHom M α
  let : IsScalarTower B C M := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : Module (B ⧸ J) (M ⧸ ((J.map α) • (⊤ : Submodule C M))) :=
    Module.compHom _ (Ideal.quotientMap (J.map α) α Ideal.le_comap_map)
  have hsub : ((J.map (algebraMap B C)) • (⊤ : Submodule C M)).restrictScalars B =
      J • (⊤ : Submodule B M) := by
    rw [Ideal.smul_restrictScalars, Submodule.restrictScalars_top]
  let e : (M ⧸ (J • (⊤ : Submodule B M))) ≃ₗ[B] (M ⧸ ((J.map α) • (⊤ : Submodule C M))) :=
    (Submodule.quotEquivOfEq _ _ hsub.symm).trans
      (Submodule.Quotient.restrictScalarsEquiv B _)
  let : IsScalarTower B (B ⧸ J) (M ⧸ ((J.map α) • (⊤ : Submodule C M))) :=
    IsScalarTower.of_algebraMap_smul fun b x => by
      induction x using Submodule.Quotient.induction_on with
      | H m => rfl
  have e' := LinearEquiv.ofQuotientSurjective (R := B) (R₀ := B ⧸ J)
    Ideal.Quotient.mk_surjective e
  exact ⟨fun h => Module.Flat.of_linearEquiv e'.symm, fun h => Module.Flat.of_linearEquiv e'⟩

end QuotSMul

/-! ### Flatness of the fibre of a module over the base change to a field -/

section FieldFibre

variable {B C B' C' : Type*} [CommRing B] [CommRing C] [CommRing B'] [CommRing C']
  [Algebra B C] [Algebra B B'] [Algebra C C'] [Algebra B' C']

/-- In a pushout square of rings mapping to `C'` through `φ : C ⊗_B B' → C'`, the two
composites `B → C → C'` and `B → B' → C'` agree. -/
theorem Algebra.TensorProduct.algebraMap_comp_eq_of_ringHom (φ : C ⊗[B] B' →+* C')
    (hl : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap C C')
    (hr : φ.comp Algebra.TensorProduct.includeRight.toRingHom = algebraMap B' C') (b : B) :
    algebraMap C C' (algebraMap B C b) = algebraMap B' C' (algebraMap B B' b) := by
  rw [← hl, ← hr]
  change φ (algebraMap B C b ⊗ₜ[B] (1 : B')) = φ ((1 : C) ⊗ₜ[B] algebraMap B B' b)
  rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]

/-- An ideal of `B` killed in `B'` generates in `C` an ideal killed in `C'`, for a pushout
square of rings mapping to `C'`. -/
theorem Ideal.map_algebraMap_le_ker_of_tensorProduct (φ : C ⊗[B] B' →+* C')
    (hl : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap C C')
    (hr : φ.comp Algebra.TensorProduct.includeRight.toRingHom = algebraMap B' C')
    (J : Ideal B) (hJ : ∀ b ∈ J, algebraMap B B' b = 0) :
    ∀ c ∈ J.map (algebraMap B C), algebraMap C C' c = 0 :=
  fun _ hc => (Ideal.map_le_iff_le_comap.2 fun b hb => by
    rw [Ideal.mem_comap, RingHom.mem_ker,
      Algebra.TensorProduct.algebraMap_comp_eq_of_ringHom φ hl hr b, hJ b hb, map_zero] :
    J.map (algebraMap B C) ≤ RingHom.ker (algebraMap C C')) hc

/-- **The fibre of a module over a field-valued base change.** Let `B → C`, `B → B'`,
`C → C'` and `B' → C'` be ring homomorphisms with `C'` flat over `C ⊗_B B'` through a
homomorphism `φ` restricting to the given maps, let `J` be an ideal of `B` killed in `B'`, and
let `J' = J C`.  Suppose that `B/J → B'` is flat and that `C/J' → C'` is flat and local.  Then
for a `C`-module `M` and a `C'`-module `M'` isomorphic to `C' ⊗_C M`, the fibre `M/J'M` is flat
over `B/J` if and only if `M'` is flat over `B'`. -/
theorem Module.flatQuotSMul_iff_flat_of_tensorProduct_flat [IsLocalRing C] [IsLocalRing C']
    [IsLocalHom (algebraMap C C')]
    (φ : C ⊗[B] B' →+* C')
    (hl : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap C C')
    (hr : φ.comp Algebra.TensorProduct.includeRight.toRingHom = algebraMap B' C')
    (hφ : φ.Flat) (J : Ideal B) (hJ : ∀ b ∈ J, algebraMap B B' b = 0)
    (hB : (Ideal.Quotient.lift J (algebraMap B B') hJ).Flat)
    (hC : (Ideal.Quotient.lift (J.map (algebraMap B C)) (algebraMap C C')
      (Ideal.map_algebraMap_le_ker_of_tensorProduct φ hl hr J hJ)).Flat)
    (M : Type*) [AddCommGroup M] [Module C M] (M' : Type*) [AddCommGroup M'] [Module C' M']
    (e : C' ⊗[C] M ≃ₗ[C'] M') :
    Module.FlatQuotSMul (algebraMap B C) J (J.map (algebraMap B C)) rfl M ↔
      (letI : Module B' M' := Module.compHom M' (algebraMap B' C')
       Module.Flat B' M') := by
  classical
  set J' : Ideal C := J.map (algebraMap B C) with hJ'def
  have hκ := Ideal.map_algebraMap_le_ker_of_tensorProduct φ hl hr J hJ
  let : Algebra (B ⧸ J) B' := (Ideal.Quotient.lift J (algebraMap B B') hJ).toAlgebra
  have : Module.Flat (B ⧸ J) B' := hB
  let : Algebra (C ⧸ J') C' := (Ideal.Quotient.lift J' (algebraMap C C') hκ).toAlgebra
  have : Module.Flat (C ⧸ J') C' := hC
  let : IsScalarTower B (B ⧸ J) B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower C (C ⧸ J') C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hJ'top : J' ≠ ⊤ := by
    intro htop
    have h1 : algebraMap C C' 1 = 0 := hκ 1 (by
      rw [← hJ'def, htop]
      exact Submodule.mem_top)
    exact one_ne_zero (h1 ▸ (map_one (algebraMap C C')).symm)
  have : Nontrivial (C ⧸ J') := Ideal.Quotient.nontrivial_iff.2 hJ'top
  have : IsLocalRing (C ⧸ J') :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J') Ideal.Quotient.mk_surjective
  have : IsLocalHom (algebraMap (C ⧸ J') C') := by
    have : IsLocalHom ((algebraMap (C ⧸ J') C').comp (Ideal.Quotient.mk J')) := by
      have hcomp : (algebraMap (C ⧸ J') C').comp (Ideal.Quotient.mk J') = algebraMap C C' :=
        RingHom.ext fun _ => rfl
      rw [hcomp]
      infer_instance
    exact IsLocalRing.isLocalHom_of_isLocalHom_comp _ (Ideal.Quotient.mk J')
      Ideal.Quotient.mk_surjective
  have : Module.FaithfullyFlat (C ⧸ J') C' := Module.FaithfullyFlat.of_flat_of_isLocalHom
  let : Algebra (B ⧸ J) (C ⧸ J') :=
    (Ideal.quotientMap J' (algebraMap B C) Ideal.le_comap_map).toAlgebra
  let : Algebra (B ⧸ J) C' :=
    ((algebraMap (C ⧸ J') C').comp (algebraMap (B ⧸ J) (C ⧸ J'))).toAlgebra
  let : IsScalarTower (B ⧸ J) (C ⧸ J') C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hBC' : ∀ x : B ⧸ J, algebraMap B' C' (algebraMap (B ⧸ J) B' x) = algebraMap (B ⧸ J) C' x :=
    fun x => by
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact (Algebra.TensorProduct.algebraMap_comp_eq_of_ringHom φ hl hr b).symm
  let : IsScalarTower (B ⧸ J) B' C' := IsScalarTower.of_algebraMap_eq fun x => (hBC' x).symm
  let Mb := M ⧸ (J' • (⊤ : Submodule C M))
  let : Module (B ⧸ J) Mb := Module.compHom _ (algebraMap (B ⧸ J) (C ⧸ J'))
  let : IsScalarTower (B ⧸ J) (C ⧸ J') Mb := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : Module B' M' := Module.compHom M' (algebraMap B' C')
  let : IsScalarTower B' C' M' := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : Module (B ⧸ J) M' := Module.compHom M' (algebraMap (B ⧸ J) C')
  let : IsScalarTower (B ⧸ J) C' M' := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : IsScalarTower (B ⧸ J) B' M' := IsScalarTower.of_algebraMap_smul fun x m => by
    change algebraMap B' C' (algebraMap (B ⧸ J) B' x) • m = algebraMap (B ⧸ J) C' x • m
    rw [hBC']
  constructor
  · intro hM
    let : Module B M := Module.compHom M (algebraMap B C)
    let : IsScalarTower B C M := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    have hMB : Module.Flat (B ⧸ J) (M ⧸ (J • (⊤ : Submodule B M))) :=
      (Module.flat_quotient_smul_top_iff_flatQuotSMul (algebraMap B C) J J' rfl M).2 hM
    let e4 : (B ⧸ J) ⊗[B] M ≃ₗ[B ⧸ J] (M ⧸ (J • (⊤ : Submodule B M))) :=
      LinearEquiv.ofQuotientSurjective (R := B) Ideal.Quotient.mk_surjective
        (TensorProduct.quotTensorEquivQuotSMul M J)
    have h1 : Module.Flat B' (B' ⊗[B ⧸ J] (M ⧸ (J • (⊤ : Submodule B M)))) :=
      Module.Flat.baseChange (B ⧸ J) B' _
    have h2 : Module.Flat B' (B' ⊗[B] M) :=
      Module.Flat.of_linearEquiv
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange B (B ⧸ J) B' B' M).symm ≪≫ₗ
          LinearEquiv.baseChange (B ⧸ J) B' _ _ e4)
    let P := C ⊗[B] B'
    let : Algebra B' P := Algebra.TensorProduct.rightAlgebra
    let : IsScalarTower B B' P := Algebra.TensorProduct.right_isScalarTower
    let : Algebra.IsPushout B B' C P := TensorProduct.isPushout.symm
    let : Algebra P C' := φ.toAlgebra
    let : IsScalarTower C P C' := IsScalarTower.of_algebraMap_eq' hl.symm
    let : IsScalarTower B' P C' := IsScalarTower.of_algebraMap_eq' hr.symm
    have : Module.Flat P C' := hφ
    have h3 : Module.Flat B' (P ⊗[C] M) :=
      Module.Flat.of_linearEquiv (Algebra.IsPushout.cancelBaseChange B B' C P M)
    have h4 : Module.Flat B' (C' ⊗[P] (P ⊗[C] M)) := Module.Flat.tensorProduct_of_flat
    exact Module.Flat.of_linearEquiv ((e.restrictScalars B').symm ≪≫ₗ
      ((TensorProduct.AlgebraTensorModule.cancelBaseChange C P C' C' M).restrictScalars B').symm)
  · intro hM'
    have : Module.Flat B' M' := hM'
    let e0 : (C ⧸ J') ⊗[C] M ≃ₗ[C ⧸ J'] Mb :=
      LinearEquiv.ofQuotientSurjective (R := C) Ideal.Quotient.mk_surjective
        (TensorProduct.quotTensorEquivQuotSMul M J')
    let E : C' ⊗[C ⧸ J'] Mb ≃ₗ[C'] M' :=
      (LinearEquiv.baseChange (C ⧸ J') C' _ _ e0).symm ≪≫ₗ
        TensorProduct.AlgebraTensorModule.cancelBaseChange C (C ⧸ J') C' C' M ≪≫ₗ e
    have : Module.Flat (B ⧸ J) M' := Module.Flat.trans (B ⧸ J) B' M'
    have : Module.Flat (B ⧸ J) (C' ⊗[C ⧸ J'] Mb) :=
      Module.Flat.of_linearEquiv (E.restrictScalars (B ⧸ J))
    exact (Module.Flat.tensorProduct_iff_of_faithfullyFlat (R := B ⧸ J) (S := C ⧸ J')
      (S' := C') (M := Mb)).1 inferInstance

end FieldFibre

/-! ### Base change to a ring whose maximal ideal is killed -/

section OverField

variable {R A S T : Type*} [CommRing R] [CommRing A] [CommRing S] [CommRing T] [IsLocalRing R]
  [Algebra R A] [Algebra R S] [Algebra A T] [Algebra S T]

/-- If the maximal ideal of a local ring `R` maps to zero in `S`, it maps to zero in any ring
receiving `A ⊗_R S` compatibly with the two factors. -/
theorem IsLocalRing.map_maximalIdeal_le_ker_of_tensorProduct
    (hS : (maximalIdeal R).map (algebraMap R S) = ⊥) (φ : A ⊗[R] S →+* T)
    (hl : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap A T)
    (hr : φ.comp Algebra.TensorProduct.includeRight.toRingHom = algebraMap S T) :
    ∀ a ∈ (maximalIdeal R).map (algebraMap R A), algebraMap A T a = 0 :=
  Ideal.map_algebraMap_le_ker_of_tensorProduct φ hl hr (maximalIdeal R) fun r hr => by
    simpa [hS] using Ideal.mem_map_of_mem (algebraMap R S) hr

/-- **The fibre of a flat base change over a field.** Let `R` be a local ring whose maximal
ideal maps to zero in `S`, and let `T` be flat over `A ⊗_R S` through a homomorphism `φ`
restricting to the structure maps.  Then `T` is flat over the fibre `A / 𝔪_R A`. -/
theorem RingHom.Flat.quotient_lift_of_tensorProduct_flat
    (hS : (maximalIdeal R).map (algebraMap R S) = ⊥) (φ : A ⊗[R] S →+* T)
    (hl : φ.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap A T)
    (hr : φ.comp Algebra.TensorProduct.includeRight.toRingHom = algebraMap S T)
    (hφ : φ.Flat) (I : Ideal A) (hI : I = (maximalIdeal R).map (algebraMap R A))
    (hIT : ∀ a ∈ I, algebraMap A T a = 0) :
    (Ideal.Quotient.lift I (algebraMap A T) hIT).Flat := by
  subst hI
  have key := Module.Flat.quotient_of_tensorProduct_flat R A S (maximalIdeal R) ⊥ T hS.le φ hl
    hr hφ _ rfl _ rfl
  set K : Ideal T := (⊥ : Ideal S).map (algebraMap S T)
  let : Algebra (A ⧸ (maximalIdeal R).map (algebraMap R A)) (T ⧸ K) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.1
      (Ideal.map_algebraMap_le_map_of_tensorProduct R A S (maximalIdeal R) ⊥ T hS.le φ hl hr _
        rfl _ rfl))
  let e : (T ⧸ K) ≃+* T := (Ideal.quotEquivOfEq Ideal.map_bot).trans (RingEquiv.quotientBot T)
  have hcomp : Ideal.Quotient.lift _ (algebraMap A T) hIT =
      (e : (T ⧸ K) →+* T).comp
        (algebraMap (A ⧸ (maximalIdeal R).map (algebraMap R A)) (T ⧸ K)) := by
    refine Ideal.Quotient.ringHom_ext (RingHom.ext fun a => ?_)
    simp [e, K]
    rfl
  rw [hcomp]
  exact RingHom.Flat.comp (RingHom.flat_algebraMap_iff.2 key)
    (RingHom.Flat.of_bijective e.bijective)

end OverField

/-! ### Congruences -/

/-- Flatness of the homomorphism induced on a quotient depends only on the ideal and the
homomorphism, not on their presentations. -/
theorem RingHom.flat_quotient_lift_congr {A T : Type*} [CommRing A] [CommRing T]
    {I₁ I₂ : Ideal A} (hI : I₁ = I₂) {ψ₁ ψ₂ : A →+* T} (hψ : ψ₁ = ψ₂)
    (h₁ : ∀ a ∈ I₁, ψ₁ a = 0) (h₂ : ∀ a ∈ I₂, ψ₂ a = 0) :
    (Ideal.Quotient.lift I₁ ψ₁ h₁).Flat ↔ (Ideal.Quotient.lift I₂ ψ₂ h₂).Flat := by
  subst hI hψ
  rfl

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Shortcut instance: instance search for products of presheaves on the big fppf site times
out in Lean v4.35.0. -/
