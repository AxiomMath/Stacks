  HasLimitsOfShape.has_limit _

/-- Precomposing a local homomorphism with the identification of two equal rings keeps it
local. -/
private theorem isLocalHom_eqToHom_comp {R₁ R₂ T : CommRingCat.{u + 1}} (e : R₁ = R₂) (ψ : R₂ ⟶ T)
    [IsLocalHom ψ.hom] : IsLocalHom (eqToHom e ≫ ψ).hom := by
  subst e
  simpa

/-! ### The fibre of a cartesian square over a space with field local rings -/

/-- **The fibre of a base change to a space whose étale local rings are fields.** Let

```
X' --g'--> X
|k         |f
v          v
K  --z---> Z
```

be a cartesian square of algebraic spaces in which every étale local ring of `K` is a field, and
let `x̄'` be a geometric point of `X'` with image `x̄` in `X` (given up to an equality, so that
the statement may be read at any spelling of `x̄`).  Then the maximal ideal of `𝒪_{Z, f(x̄)}`
maps to zero in `𝒪_{X', x̄'}`, and `𝒪_{X', x̄'}` is flat over the fibre
`𝒪_{X, x̄}/𝔪_{f(x̄)} 𝒪_{X, x̄}`. -/
theorem exists_flat_quotient_lift_of_isPullback {X' X K Z : AlgebraicSpaces B S hS}
    {g' : X' ⟶ X} {k : X' ⟶ K} {f : X ⟶ Z} {z : K ⟶ Z} (hpb : IsPullback g' k f z)
    (hK : ∀ w : GeometricPoint B S hS K.1, IsField (etaleLocalRing B S hS K.1 w))
    (x' : GeometricPoint B S hS X'.1) (x : GeometricPoint B S hS X.1)
    (hx : x = geometricPointMap g'.hom x') :
    letI : IsLocalRing ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom x)) :=
      isLocalRing_etaleLocalRing B S hS Z.1 Z.2 _
    ∃ hJ : ∀ a ∈ (maximalIdeal ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom x))).map
        (etaleLocalRingMap X.2 f.hom x),
        (eqToHom (congrArg (etaleLocalRing B S hS X.1) hx) ≫
          CommRingCat.ofHom (etaleLocalRingMap X'.2 g'.hom x')).hom a = 0,
      (Ideal.Quotient.lift _ _ hJ).Flat := by
  subst hx
  have hid : (eqToHom (congrArg (etaleLocalRing B S hS X.1)
      (rfl : geometricPointMap g'.hom x' = geometricPointMap g'.hom x')) ≫
        CommRingCat.ofHom (etaleLocalRingMap X'.2 g'.hom x')).hom =
      etaleLocalRingMap X'.2 g'.hom x' := by
    simp
  rw [hid]
  have hw : geometricPointMap f.hom (geometricPointMap g'.hom x') =
      geometricPointMap z.hom (geometricPointMap k.hom x') :=
    congrArg (fun m : X' ⟶ Z => geometricPointMap m.hom x') hpb.w
  let : Algebra
      ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
      ↥(etaleLocalRing B S hS X.1 (geometricPointMap g'.hom x')) :=
    (etaleLocalRingMap X.2 f.hom (geometricPointMap g'.hom x')).toAlgebra
  let : Algebra
      ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
      ↥(etaleLocalRing B S hS K.1 (geometricPointMap k.hom x')) :=
    ((eqToHom (congrArg (etaleLocalRing B S hS Z.1) hw) ≫ CommRingCat.ofHom
      (etaleLocalRingMap K.2 z.hom (geometricPointMap k.hom x'))).hom).toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS X.1 (geometricPointMap g'.hom x'))
      ↥(etaleLocalRing B S hS X'.1 x') := (etaleLocalRingMap X'.2 g'.hom x').toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS K.1 (geometricPointMap k.hom x'))
      ↥(etaleLocalRing B S hS X'.1 x') := (etaleLocalRingMap X'.2 k.hom x').toAlgebra
  obtain ⟨φ, hleft, hright, hflat⟩ := cartesian_etaleStalk_tensor_flat B S hS g' k f z hpb x'
  let : IsLocalRing
      ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom (geometricPointMap g'.hom x'))) :=
    isLocalRing_etaleLocalRing B S hS Z.1 Z.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS K.1 (geometricPointMap k.hom x')) :=
    isLocalRing_etaleLocalRing B S hS K.1 K.2 _
  have : IsLocalHom (CommRingCat.ofHom
      (etaleLocalRingMap K.2 z.hom (geometricPointMap k.hom x'))).hom :=
    isLocalHom_etaleLocalRingMap B S hS K.2 Z.2 z.hom (geometricPointMap k.hom x')
  have : IsLocalHom (algebraMap
      ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
      ↥(etaleLocalRing B S hS K.1 (geometricPointMap k.hom x'))) :=
    isLocalHom_eqToHom_comp _ _
  have hS' : (maximalIdeal
      ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))).map
      (algebraMap
        ↥(etaleLocalRing B S hS Z.1 (geometricPointMap f.hom (geometricPointMap g'.hom x')))
        ↥(etaleLocalRing B S hS K.1 (geometricPointMap k.hom x'))) = ⊥ := by
    refine le_bot_iff.1 ?_
    rw [← IsLocalRing.isField_iff_maximalIdeal_eq.1 (hK _)]
    exact IsLocalRing.map_maximalIdeal_le _
  have hJ := IsLocalRing.map_maximalIdeal_le_ker_of_tensorProduct hS' φ hleft hright
  exact ⟨hJ, RingHom.Flat.quotient_lift_of_tensorProduct_flat hS' φ hleft hright hflat _ rfl hJ⟩

/-! ### The fibre over a field-valued point -/

section Fibre

variable {X Y Z : AlgebraicSpaces B S hS} (f : X ⟶ Y) (h : Y ⟶ Z)
  (p : FieldValuedPoint B S hS X.1)

/-- The morphism `x : Spec(K) ⟶ X` of algebraic spaces classified by a field-valued point. -/
abbrev fieldPointHom : representedAlgebraicSpace B S hS (p.siteObject B S hS X.1) ⟶ X :=
  ObjectProperty.homMk (yonedaEquiv.symm p.value)

/-- The field-valued point `z = h ∘ f ∘ x : Spec(K) ⟶ Z` below a field-valued point `x` of
`X`. -/
abbrev fieldPointBase : representedAlgebraicSpace B S hS (p.siteObject B S hS X.1) ⟶ Z :=
  fieldPointHom B S hS p ≫ f ≫ h

/-- The fibre `X_z = Spec(K) ×_{z, Z} X` of `X ⟶ Z` over the field-valued point `z`. -/
abbrev fieldPointFibreSource : AlgebraicSpaces B S hS :=
  AlgebraicSpaces.fiberProduct B S hS (fieldPointBase B S hS f h p) (f ≫ h)

/-- The fibre `Y_z = Spec(K) ×_{z, Z} Y` of `Y ⟶ Z` over the field-valued point `z`. -/
abbrev fieldPointFibreTarget : AlgebraicSpaces B S hS :=
  AlgebraicSpaces.fiberProduct B S hS (fieldPointBase B S hS f h p) h

/-- The projection `X_z ⟶ X`. -/
abbrev fieldPointFibreSourceProj : fieldPointFibreSource B S hS f h p ⟶ X :=
  ObjectProperty.homMk (pullback.snd _ _)

/-- The projection `Y_z ⟶ Y`. -/
abbrev fieldPointFibreTargetProj : fieldPointFibreTarget B S hS f h p ⟶ Y :=
  ObjectProperty.homMk (pullback.snd _ _)

/-- The morphism `f_z : X_z ⟶ Y_z` induced by `f` on the fibres over `z`. -/
abbrev fieldPointFibreMap :
    fieldPointFibreSource B S hS f h p ⟶ fieldPointFibreTarget B S hS f h p :=
  ObjectProperty.homMk (pullback.map _ _ _ _ (𝟙 _) f.hom (𝟙 _) (by simp) (by simp))

/-- The `K`-rational point `(id, x) : Spec(K) ⟶ X_z` of the fibre determined by `x`. -/
abbrev fieldPointFibreSection :
    representedAlgebraicSpace B S hS (p.siteObject B S hS X.1) ⟶
      fieldPointFibreSource B S hS f h p :=
  ObjectProperty.homMk (pullback.lift (𝟙 _) (fieldPointHom B S hS p).hom (by simp))

/-- The point of `|X_z|` given by the `K`-rational point `(id, x)` of the fibre. -/
noncomputable def fieldPointFibrePoint : points B S hS (fieldPointFibreSource B S hS f h p).1 :=
  pointsMap B S hS _ (fieldPointFibreSection B S hS f h p).hom
    ((FieldValuedPoint.tautological B S hS p).class B S hS _)

/-- **Condition (2) of Stacks 05WY.** For morphisms `f : X ⟶ Y` and `h : Y ⟶ Z` of algebraic
spaces, an `𝒪_X`-module `F` and a field-valued point `x : Spec(K) ⟶ X`, with `z = h ∘ f ∘ x`:
the pullback `F_z` of `F` to the fibre `X_z = Spec(K) ×_{z, Z} X` is flat over
`Y_z = Spec(K) ×_{z, Z} Y` at the `K`-rational point of `X_z` determined by `x`, in the sense of
Stacks 05VV.

This is what the source means by "the restriction of `F` to its fibre over `z` is flat at `x`
over the fibre of `Y` over `z`" when the fibres are read as genuine fibre products. -/
def IsFlatOnFibreAtFieldValuedPoint (F : Modules.{u, u} B S hS X.1 X.2) : Prop :=
  IsFlatOverAtPoint B S hS (fieldPointFibreSource B S hS f h p).2
    (fieldPointFibreMap B S hS f h p).hom
    ((modulePullback B S hS (fieldPointFibreSourceProj B S hS f h p)).obj F)
    (fieldPointFibrePoint B S hS f h p)

/-- The fibre `Y_z` is the fibre product of `Y ⟶ Z` with `z`. -/
theorem isPullback_fieldPointFibreTarget :
    IsPullback (fieldPointFibreTargetProj B S hS f h p)
      (ObjectProperty.homMk (pullback.fst _ _) :
        fieldPointFibreTarget B S hS f h p ⟶
          representedAlgebraicSpace B S hS (p.siteObject B S hS X.1))
      h (fieldPointBase B S hS f h p) :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (fieldPointBase B S hS f h p) h).flip

/-- The fibre `X_z` is the fibre product of `X ⟶ Z` with `z`. -/
theorem isPullback_fieldPointFibreSource :
    IsPullback (fieldPointFibreSourceProj B S hS f h p)
      (ObjectProperty.homMk (pullback.fst _ _) :
        fieldPointFibreSource B S hS f h p ⟶
          representedAlgebraicSpace B S hS (p.siteObject B S hS X.1))
      (f ≫ h) (fieldPointBase B S hS f h p) :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (fieldPointBase B S hS f h p) (f ≫ h)).flip

/-- The fibre `X_z` is the base change of `X ⟶ Y` along `Y_z ⟶ Y`. -/
theorem isPullback_fieldPointFibreMap :
    IsPullback (fieldPointFibreSourceProj B S hS f h p) (fieldPointFibreMap B S hS f h p) f
      (fieldPointFibreTargetProj B S hS f h p) := by
  have t := AlgebraicSpaces.isPullback_fiberProduct B S hS (fieldPointBase B S hS f h p) h
  have s := AlgebraicSpaces.isPullback_fiberProduct B S hS (fieldPointBase B S hS f h p) (f ≫ h)
  have hfst : fieldPointFibreMap B S hS f h p ≫
      (ObjectProperty.homMk (pullback.fst _ _) :
        fieldPointFibreTarget B S hS f h p ⟶
          representedAlgebraicSpace B S hS (p.siteObject B S hS X.1)) =
      ObjectProperty.homMk (pullback.fst _ _) :=
    ObjectProperty.hom_ext _ ((pullback.lift_fst _ _ _).trans (Category.comp_id _))
  have hw : fieldPointFibreMap B S hS f h p ≫ fieldPointFibreTargetProj B S hS f h p =
      fieldPointFibreSourceProj B S hS f h p ≫ f :=
    ObjectProperty.hom_ext _ (pullback.lift_snd _ _ _)
  rw [← hfst] at s
  exact (IsPullback.of_right s hw t).flip

/-- The étale local rings of the spectrum of the field of a field-valued point are fields. -/
theorem isField_etaleLocalRing_fieldPoint
    (w : GeometricPoint B S hS
      (representedAlgebraicSpace B S hS (p.siteObject B S hS X.1)).1) :
    IsField (etaleLocalRing B S hS
      (representedAlgebraicSpace B S hS (p.siteObject B S hS X.1)).1 w) :=
  isField_etaleLocalRing_yoneda (p.siteObject B S hS X.1)
    (fun x => isField_stalk_Spec_field p.carrier x) w

/-- **Stacks 05WY (1) `⟺` (2) at a geometric point of the fibre.** Let `x̄'` be a geometric point
of the fibre `X_z` of `X ⟶ Z` over the field-valued point `z = h ∘ f ∘ x`, and let `x̄` be its
image in `X`.  The pullback of `F` to `X_z` is flat over `Y_z` at `x̄'` exactly when the fibre
`F_{x̄}/𝔪_{z̄} F_{x̄}` of the geometric stalk is flat over `𝒪_{Y, ȳ}/𝔪_{z̄} 𝒪_{Y, ȳ}`. -/
theorem isFlatOverAtGeometricPoint_fieldPointFibreMap_iff (F : Modules.{u, u} B S hS X.1 X.2)
    (x' : GeometricPoint B S hS (fieldPointFibreSource B S hS f h p).1) :
    IsFlatOverAtGeometricPoint B S hS (fieldPointFibreMap B S hS f h p)
        ((modulePullback B S hS (fieldPointFibreSourceProj B S hS f h p)).obj F) x' ↔
      IsFibreFlatOverAtGeometricPoint B S hS f h F
        (geometricPointMap (fieldPointFibreSourceProj B S hS f h p).hom x') := by
  set q := fieldPointFibreSourceProj B S hS f h p with hq
  set r := fieldPointFibreTargetProj B S hS f h p with hr
  set fz := fieldPointFibreMap B S hS f h p with hfz
  set xb := geometricPointMap q.hom x' with hxb
  set yb' := geometricPointMap fz.hom x' with hyb'
  have hin := isPullback_fieldPointFibreMap B S hS f h p
  have hyw : geometricPointMap f.hom xb = geometricPointMap r.hom yb' :=
    congrArg (fun k : fieldPointFibreSource B S hS f h p ⟶ Y => geometricPointMap k.hom x') hin.w
  obtain ⟨hJ, hB⟩ := exists_flat_quotient_lift_of_isPullback B S hS
    (isPullback_fieldPointFibreTarget B S hS f h p) (isField_etaleLocalRing_fieldPoint B S hS p)
    yb' _ hyw
  obtain ⟨hJX, hC₀⟩ := exists_flat_quotient_lift_of_isPullback B S hS
    (isPullback_fieldPointFibreSource B S hS f h p) (isField_etaleLocalRing_fieldPoint B S hS p)
    x' xb rfl
  let : Algebra ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xb))
      ↥(etaleLocalRing B S hS X.1 xb) := (etaleLocalRingMap X.2 f.hom xb).toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xb))
      ↥(etaleLocalRing B S hS (fieldPointFibreTarget B S hS f h p).1 yb') :=
    ((eqToHom (congrArg (etaleLocalRing B S hS Y.1) hyw) ≫ CommRingCat.ofHom
      (etaleLocalRingMap (fieldPointFibreTarget B S hS f h p).2 r.hom yb')).hom).toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS X.1 xb)
      ↥(etaleLocalRing B S hS (fieldPointFibreSource B S hS f h p).1 x') :=
    (etaleLocalRingMap (fieldPointFibreSource B S hS f h p).2 q.hom x').toAlgebra
  let : Algebra ↥(etaleLocalRing B S hS (fieldPointFibreTarget B S hS f h p).1 yb')
      ↥(etaleLocalRing B S hS (fieldPointFibreSource B S hS f h p).1 x') :=
    (etaleLocalRingMap (fieldPointFibreSource B S hS f h p).2 fz.hom x').toAlgebra
  obtain ⟨φ, hleft, hright, hflat⟩ := cartesian_etaleStalk_tensor_flat B S hS q fz f r hin x'
  let : IsLocalRing ↥(etaleLocalRing B S hS X.1 xb) := isLocalRing_etaleLocalRing B S hS X.1 X.2 _
  let : IsLocalRing ↥(etaleLocalRing B S hS (fieldPointFibreSource B S hS f h p).1 x') :=
    isLocalRing_etaleLocalRing B S hS _ (fieldPointFibreSource B S hS f h p).2 _
  let : IsLocalRing
      ↥(etaleLocalRing B S hS Z.1 (geometricPointMap h.hom (geometricPointMap f.hom xb))) :=
    isLocalRing_etaleLocalRing B S hS Z.1 Z.2 _
  have : IsLocalHom (algebraMap ↥(etaleLocalRing B S hS X.1 xb)
      ↥(etaleLocalRing B S hS (fieldPointFibreSource B S hS f h p).1 x')) :=
    isLocalHom_etaleLocalRingMap B S hS (fieldPointFibreSource B S hS f h p).2 X.2 q.hom x'
  set J := (maximalIdeal ↥(etaleLocalRing B S hS Z.1
      (geometricPointMap h.hom (geometricPointMap f.hom xb)))).map
    (etaleLocalRingMap Y.2 h.hom (geometricPointMap f.hom xb)) with hJdef
  let : IsLocalRing ↥(etaleLocalRing B S hS Z.1 (geometricPointMap (f ≫ h).hom xb)) :=
    isLocalRing_etaleLocalRing B S hS Z.1 Z.2 _
  have hI : (maximalIdeal ↥(etaleLocalRing B S hS Z.1
      (geometricPointMap (f ≫ h).hom xb))).map (etaleLocalRingMap X.2 (f ≫ h).hom xb) =
      J.map (algebraMap ↥(etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xb))
        ↥(etaleLocalRing B S hS X.1 xb)) := by
    rw [hJdef, Ideal.map_map]
    exact congrArg (fun ψ => (maximalIdeal _).map ψ)
      (etaleLocalRingMap_comp X.2 Y.2 f.hom h.hom xb).symm
  have hψ : (eqToHom (congrArg (etaleLocalRing B S hS X.1)
      (rfl : xb = geometricPointMap q.hom x')) ≫ CommRingCat.ofHom
        (etaleLocalRingMap (fieldPointFibreSource B S hS f h p).2 q.hom x')).hom =
      algebraMap ↥(etaleLocalRing B S hS X.1 xb)
        ↥(etaleLocalRing B S hS (fieldPointFibreSource B S hS f h p).1 x') := by
    simp [RingHom.algebraMap_toAlgebra]
  have hC := (RingHom.flat_quotient_lift_congr hI hψ hJX
    (Ideal.map_algebraMap_le_ker_of_tensorProduct φ hleft hright J hJ)).1 hC₀
  have key := Module.flatQuotSMul_iff_flat_of_tensorProduct_flat φ hleft hright hflat J hJ hB
    hC (geometricModuleStalk B S hS X xb F)
    (geometricModuleStalk B S hS (fieldPointFibreSource B S hS f h p) x'
      ((modulePullback B S hS q).obj F))
    (geometricModuleStalkPullbackIso B S hS q x' F).symm.toLinearEquiv
  exact key.symm.trans
    (Module.flatQuotSMul_congr _ rfl (Ideal.map_map _ _) rfl (Ideal.map_map _ _).symm _)

/-- The `K`-rational point of the fibre `X_z` maps to `x : Spec(K) ⟶ X` in `X`. -/
private theorem fieldPointFibreSection_comp_proj :
    (fieldPointFibreSection B S hS f h p).hom ≫ (fieldPointFibreSourceProj B S hS f h p).hom =
      yonedaEquiv.symm p.value :=
  pullback.lift_snd _ _ _

/-- The `K`-rational point of the fibre `X_z` lies over the point of `|X|` it came from. -/
theorem pointsMap_fieldPointFibrePoint :
    pointsMap B S hS _ (fieldPointFibreSourceProj B S hS f h p).hom
      (fieldPointFibrePoint B S hS f h p) = p.class B S hS X.1 := by
  rw [fieldPointFibrePoint, ← Function.comp_apply (f := pointsMap B S hS _ _), ← pointsMap_comp,
    fieldPointFibreSection_comp_proj]
  exact FieldValuedPoint.pointsMap_class_tautological B S hS p

/-- **A geometric point dominating `x` lifts to the fibre.** For a geometric point `x̄` of `X`
whose field-valued point dominates the field-valued point `x`, there is a geometric point of the
fibre `X_z` lying over the `K`-rational point determined by `x` and mapping to `x̄` in `X`: the
point `Spec(k̄) ⟶ Spec(K) ⟶ X_z`. -/
theorem exists_geometricPoint_fieldPointFibre_of_dominates (xbar : GeometricPoint B S hS X.1)
    (hd : FieldValuedPoint.Dominates B S hS X.1 xbar.val p) :
    ∃ x' : GeometricPoint B S hS (fieldPointFibreSource B S hS f h p).1,
      x'.image = fieldPointFibrePoint B S hS f h p ∧
        geometricPointMap (fieldPointFibreSourceProj B S hS f h p).hom x' = xbar := by
  obtain ⟨ι, hι⟩ := hd
  let a : yoneda.obj (xbar.val.siteObject B S hS X.1) ⟶ yoneda.obj (p.siteObject B S hS X.1) :=
    yoneda.map ι
  let x' : GeometricPoint B S hS (fieldPointFibreSource B S hS f h p).1 :=
    ⟨FieldValuedPoint.map B S hS _ (a ≫ (fieldPointFibreSection B S hS f h p).hom)
      (FieldValuedPoint.tautological B S hS xbar.val), xbar.property⟩
  refine ⟨x', ?_, ?_⟩
  · change pointsMap B S hS _ (a ≫ (fieldPointFibreSection B S hS f h p).hom)
        ((FieldValuedPoint.tautological B S hS xbar.val).class B S hS _) = _
    rw [pointsMap_comp, Function.comp_apply,
      (subsingleton_points_yoneda_siteObject B S hS p).elim
        (pointsMap B S hS _ a ((FieldValuedPoint.tautological B S hS xbar.val).class B S hS _))
        ((FieldValuedPoint.tautological B S hS p).class B S hS _)]
    rfl
  · have hs : a ≫ (fieldPointFibreSection B S hS f h p).hom ≫
        (fieldPointFibreSourceProj B S hS f h p).hom = yonedaEquiv.symm xbar.val.value := by
      rw [fieldPointFibreSection_comp_proj, yonedaEquiv_symm_naturality_left, hι]
    refine Subtype.ext ?_
    change FieldValuedPoint.map B S hS _
        ((a ≫ (fieldPointFibreSection B S hS f h p).hom) ≫
          (fieldPointFibreSourceProj B S hS f h p).hom)
        (FieldValuedPoint.tautological B S hS xbar.val) = xbar.val
    rw [Category.assoc, hs]
    exact FieldValuedPoint.map_tautological B S hS xbar.val

/-- **Condition (2) of Stacks 05WY at a geometric point of the fibre.** For a quasi-coherent
`F` and a geometric point `x̄'` of `X_z` above the `K`-rational point determined by `x`,
condition (2) at `x` is condition (1) of Stacks 05WY at the image of `x̄'` in `X`. -/
theorem isFlatOnFibreAtFieldValuedPoint_iff_of_image (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite]
    (x' : GeometricPoint B S hS (fieldPointFibreSource B S hS f h p).1)
    (hx' : x'.image = fieldPointFibrePoint B S hS f h p) :
    IsFlatOnFibreAtFieldValuedPoint B S hS f h p F ↔
      IsFibreFlatOverAtGeometricPoint B S hS f h F
        (geometricPointMap (fieldPointFibreSourceProj B S hS f h p).hom x') := by
  have := isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
    (fieldPointFibreSourceProj B S hS f h p) F inferInstance
  rw [← isFlatOverAtGeometricPoint_fieldPointFibreMap_iff,
    ← mem_flatLocus_iff_isFlatOverAtGeometricPoint, hx']
  rfl

/-- **Condition (1) of Stacks 05WY does not depend on the geometric point.** For a
quasi-coherent `F` and two geometric points `x̄₁`, `x̄₂` of `X` over the same point of `|X|`,
the fibre `F_{x̄}/𝔪_{z̄} F_{x̄}` is flat over `𝒪_{Y, ȳ}/𝔪_{z̄} 𝒪_{Y, ȳ}` at `x̄₁` exactly when it
is at `x̄₂`. -/
theorem isFibreFlatOverAtGeometricPoint_iff_of_image_eq (F : Modules.{u, u} B S hS X.1 X.2)
    [F.IsQuasicoherentOnSite] (x₁ x₂ : GeometricPoint B S hS X.1) (hx : x₁.image = x₂.image) :
    IsFibreFlatOverAtGeometricPoint B S hS f h F x₁ ↔
      IsFibreFlatOverAtGeometricPoint B S hS f h F x₂ := by
  obtain ⟨x₃, h₃₁, h₃₂⟩ := GeometricPoint.exists_common_extension x₁ x₂ rfl hx.symm
  have key : ∀ x : GeometricPoint B S hS X.1,
      FieldValuedPoint.Dominates B S hS X.1 x₃.val x.val →
      (IsFibreFlatOverAtGeometricPoint B S hS f h F x ↔
        IsFibreFlatOverAtGeometricPoint B S hS f h F x₃) := by
    intro x hd
    obtain ⟨a, ha, ha'⟩ := exists_geometricPoint_fieldPointFibre_of_dominates B S hS f h x.val x
      (FieldValuedPoint.dominates_refl B S hS X.1 x.val)
    obtain ⟨b, hb, hb'⟩ := exists_geometricPoint_fieldPointFibre_of_dominates B S hS f h x.val x₃
      hd
    rw [← ha', ← hb', ← isFlatOnFibreAtFieldValuedPoint_iff_of_image B S hS f h x.val F a ha,
      ← isFlatOnFibreAtFieldValuedPoint_iff_of_image B S hS f h x.val F b hb]
  exact (key x₁ h₃₁).trans (key x₂ h₃₂).symm

/-- **Stacks 05WY, (1) `⟺` (2).** Let `f : X ⟶ Y` and `h : Y ⟶ Z` be morphisms of algebraic
spaces over `S`, let `F` be a quasi-coherent `𝒪_X`-module and let `x` be a point of `|X|`.  For
every geometric point `x̄` of `X` lying over `x` and every field-valued point
`x : Spec(K) ⟶ X` in the class of `x`, with `z = h ∘ f ∘ x`, the following are equivalent:

1. the module `F_{x̄}/𝔪_{z̄} F_{x̄}` is flat over `𝒪_{Y, ȳ}/𝔪_{z̄} 𝒪_{Y, ȳ}`, where `ȳ = f ∘ x̄`
   and `z̄ = h ∘ ȳ`;
2. the pullback `F_z` of `F` to `X_z = Spec(K) ×_{z, Z} X` is flat over
   `Y_z = Spec(K) ×_{z, Z} Y` at the `K`-rational point of `X_z` determined by `x`, in the sense
   of Stacks 05VV.

In particular neither condition depends on the choices made. -/
@[stacks 05WY "(1) iff (2), for every geometric point over x and every field-valued \
  representative of x"]
theorem isFlatOnFibreAtFieldValuedPoint_iff_isFibreFlatOverAtGeometricPoint
    (F : Modules.{u, u} B S hS X.1 X.2) [F.IsQuasicoherentOnSite] (x : points B S hS X.1)
    (xbar : GeometricPoint B S hS X.1) (hxbar : xbar.LiesOver x)
    (hp : p.class B S hS X.1 = x) :
    IsFlatOnFibreAtFieldValuedPoint B S hS f h p F ↔
      IsFibreFlatOverAtGeometricPoint B S hS f h F xbar := by
  obtain ⟨x', hx'⟩ := exists_geometricRepresentative B S hS _ (fieldPointFibrePoint B S hS f h p)
  refine (isFlatOnFibreAtFieldValuedPoint_iff_of_image B S hS f h p F x' hx').trans
    (isFibreFlatOverAtGeometricPoint_iff_of_image_eq B S hS f h F _ xbar ?_)
  rw [geometricPointMap_image, hx', pointsMap_fieldPointFibrePoint, hp]
  exact hxbar.symm

