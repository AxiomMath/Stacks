module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ImageSubsheafUniversal
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.MonoImageSubsheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.AlgebraSheafImageQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.BaseRingTensorModuleFlat
public import StacksFrontier.AlgebraicGeometry.Spaces.BaseRingTensorModuleQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleImageSubmoduleAffine

/-!
# The ideal sheaf `I 𝒪_X`

Let `f : X ⟶ T` be a morphism from an algebraic space to a scheme of the big fppf site and let
`I` be an ideal of `R = Γ(T, 𝒪_T)`. The sheaf of ideals `I 𝒪_X ⊆ 𝒪_X` is the image of the map
`𝒪_X ⊗_R I ⟶ 𝒪_X ⊗_R R ≅ 𝒪_X`. It is the ideal sheaf `𝓘 = I𝒪_X` of Situation 08B7, the one
along which Grothendieck's existence theorem completes.

## Main definitions

* `AlgebraicGeometry.Space.baseIdealMapImage`: the sheaf of ideals `I 𝒪_X`, as a sheaf submodule of
  `𝒪_X`.

## Main results

* `AlgebraicGeometry.Space.isQuasicoherentOnSite_baseIdealMapImage`: `I 𝒪_X` is quasi-coherent.

## References

* [Stacks Project, Tag 08B7](https://stacks.math.columbia.edu/tag/08B7)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v t u'

/- The global abelian structure of the cohomology of modules leaves a stuck universe constraint
against the `𝒪_X`-modules at the universe of the schemes; the one at the pinned universe is
used instead. -/
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

namespace AlgebraicGeometry.Space

open Stacks.SheafOfModules.ImageSubsheaf

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-! ### The ideal sheaf `I 𝒪_X` -/

section BaseIdeal

variable (X : AlgebraicSpaces B S hS) {T : BigFppfOver B S hS} (f : X ⟶ schemeSpace T)
  (I : Ideal (baseRing B S hS T))

/-- The map `𝒪_X ⊗_R I ⟶ 𝒪_X ⊗_R R ≅ 𝒪_X` induced by the inclusion of an ideal `I` of the ring
`R = Γ(T, 𝒪_T)` of functions on the target of `f : X ⟶ T`. -/
noncomputable def baseIdealMap :
    (baseRingTensorModule B S hS X (baseRingHomOfMap f)).obj (ModuleCat.of _ I) ⟶
      SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O) :=
  (baseRingTensorModule B S hS X (baseRingHomOfMap f)).map (ModuleCat.ofHom I.subtype) ≫
    (baseRingTensorModuleSelfIso B S hS X (baseRingHomOfMap f)).hom

/-- **The ideal sheaf `I 𝒪_X`** of a morphism `f : X ⟶ T` from an algebraic space to a scheme
and an ideal `I ⊆ Γ(T, 𝒪_T)`: the image of `𝒪_X ⊗_R I ⟶ 𝒪_X`, that is, the sheaf of ideals of
`𝒪_X` locally generated by the pullbacks of the elements of `I`. -/
noncomputable def baseIdealMapImage :
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
      (smallEtaleRingedSite B S hS X.1 X.2).O)).Submodule :=
  imageSubmodule (baseIdealMap X f I)

/-- The ideal sheaf `I 𝒪_X` is quasi-coherent: it is the image of a map from the quasi-coherent
module `𝒪_X ⊗_R I` to `𝒪_X`. -/
theorem isQuasicoherentOnSite_baseIdealMapImage :
    (baseIdealMapImage X f I).toSheafOfModules.IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_imageSubmodule _
    (isQuasicoherentOnSite_baseRingTensorModule B S hS X _ _)
    (SheafOfModules.isQuasicoherentOnSite_unit _)

end BaseIdeal

end AlgebraicGeometry.Space
