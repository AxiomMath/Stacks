module

public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentChartSectionsFinite
public import StacksFrontier.AlgebraicGeometry.Spaces.CoherentSubquotientNoetherian
public import StacksFrontier.AlgebraicGeometry.Spaces.CokernelAffineSurjectivityFromCartesian
public import StacksFrontier.AlgebraicGeometry.Spaces.CoproductCartesian
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasicoherentCartesianOnAffineCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasicoherentCokernelsUnconditional
public import StacksFrontier.AlgebraicGeometry.Topologies.BaseIdealMultiple
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Modules.GlobalSectionLinear

/-!
# The multiple `J F` of a module on an algebraic space by an ideal of a ring of functions

Let `X` be an algebraic space, `F` an `𝒪_X`-module and `φ : A →+* Γ(X, 𝒪_X)` a ring map, for
instance the structure map of an algebraic space over `Spec A`.  For an ideal `J ⊆ A` the
submodule `J F ⊆ F` is the image of the single morphism `∐_{a ∈ J} F ⟶ F` whose `a`-th
component is multiplication by `φ a`, and `F / J F` is the cokernel of the inclusion.  For
`J = Iⁿ` these are the modules `Iⁿ F` and `F / Iⁿ F` of the theorem on formal functions.

Everything is stated in the abelian category of `𝒪_X`-modules whose sections lie in the
universe of the schemes, the universe at which cohomology is finite over the base for a proper
space (Stacks 08AS).

## Main definitions

* `AlgebraicGeometry.Space.idealMultiple`: the submodule `J F`, with its inclusion
  `idealMultipleι` into `F`.
* `AlgebraicGeometry.Space.idealMultipleMap`: multiplication by `a` as a morphism `J F ⟶ K F`,
  for `J a ⊆ K`.
* `AlgebraicGeometry.Space.idealQuotient`: the quotient `F / J F`, and
  `AlgebraicGeometry.Space.idealQuotientMap` the map `F / J F ⟶ F / K F` for `J ≤ K`.
* `AlgebraicGeometry.Space.idealShortComplex`: the short exact sequence
  `0 ⟶ J F ⟶ F ⟶ F / J F ⟶ 0`, and `idealShortComplexMap` the morphism of these sequences
  for `J ≤ K`.

## Main results

* `AlgebraicGeometry.Space.idealShortComplex_shortExact`: the sequence is short exact.
* `AlgebraicGeometry.Space.globalSmul_idealQuotient_eq_zero`: `J` kills `F / J F`.
* `AlgebraicGeometry.Space.isQuasicoherentOnSite_idealMultiple`,
  `isQuasicoherentOnSite_idealQuotient` and `isCoherent_idealMultiple`: `J F` and `F / J F` are
  quasi-coherent with `F`, and `J F` is coherent with `F` on a locally Noetherian space.
* `AlgebraicGeometry.Space.span_idealMultipleFactor_sections`: over an affine étale chart `U`
  of `X` the sections of `J F` are generated by the classes of the multiples `φ(a) s`,
  `a ∈ J`, of sections `s` of `F` over `U`, for `F` quasi-coherent.

## Implementation notes

The coproduct is indexed by the ideal `J` itself, a type in the universe of the schemes, so it
exists in the category of `𝒪_X`-modules at that universe.  Every identity between the
multiplication maps is proved after composing with the inclusion `J F ⟶ F`, a monomorphism,
where it is an identity between multiplications by global functions.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.SiteModules
open scoped IsMulCommutative

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hX : IsAlgebraicSpace B S hS X}
  {A : Type u} [CommRing A]
  (φ : A →+* ↥(GlobalSectionRing
    ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O))))
  (F : Modules.{u, u} B S hS X hX)

/-! ### The submodule `J F` -/

section IdealMultiple

variable (J : Ideal A)

/-- The morphism `∐_{a ∈ J} F ⟶ F` whose `a`-th component is multiplication by `φ a`. -/
def idealMultipleHom : (∐ fun _ : ↥J => F) ⟶ F :=
  Sigma.desc fun a => globalSmul _ (φ a) F

/-- The `a`-th component of `∐_{a ∈ J} F ⟶ F` is multiplication by `φ a`. -/
@[reassoc]
theorem ι_idealMultipleHom (a : ↥J) :
    Sigma.ι (fun _ : ↥J => F) a ≫ idealMultipleHom φ F J = globalSmul _ (φ a) F :=
  Sigma.ι_comp_desc _ _

/-- **The submodule `J F` of `F`**: the image of multiplication by the elements of `J`. -/
abbrev idealMultiple : Modules.{u, u} B S hS X hX :=
  Abelian.image (idealMultipleHom φ F J)

/-- The inclusion `J F ⟶ F`. -/
abbrev idealMultipleι : idealMultiple φ F J ⟶ F :=
  Abelian.image.ι (idealMultipleHom φ F J)

/-- The inclusion `J F ⟶ F` is a monomorphism. -/
instance mono_idealMultipleι : Mono (idealMultipleι φ F J) :=
  inferInstanceAs (Mono (Abelian.image.ι (idealMultipleHom φ F J)))

/-- Multiplication by `φ a`, for `a ∈ J`, as a morphism `F ⟶ J F`. -/
def idealMultipleFactor {a : A} (ha : a ∈ J) : F ⟶ idealMultiple φ F J :=
  Sigma.ι (fun _ : ↥J => F) ⟨a, ha⟩ ≫ Abelian.factorThruImage (idealMultipleHom φ F J)

/-- Multiplication by `φ a` into `J F`, followed by the inclusion `J F ⟶ F`, is multiplication
by `φ a` on `F`. -/
@[reassoc (attr := simp)]
theorem idealMultipleFactor_ι {a : A} (ha : a ∈ J) :
    idealMultipleFactor φ F J ha ≫ idealMultipleι φ F J = globalSmul _ (φ a) F := by
  rw [idealMultipleFactor, idealMultipleι, Category.assoc, Abelian.image.fac,
    ι_idealMultipleHom]

/-- Two morphisms out of `J F` agree once they agree after every `idealMultipleFactor`. -/
theorem idealMultiple_hom_ext {Y : Modules.{u, u} B S hS X hX} {g g' : idealMultiple φ F J ⟶ Y}
    (h : ∀ (a : A) (ha : a ∈ J), idealMultipleFactor φ F J ha ≫ g =
      idealMultipleFactor φ F J ha ≫ g') : g = g' := by
  refine (cancel_epi (Abelian.factorThruImage (idealMultipleHom φ F J))).1 ?_
  refine Sigma.hom_ext _ _ fun a => ?_
  have := h a.1 a.2
  simpa only [idealMultipleFactor, Category.assoc] using this

variable {J} in
/-- If `J a ⊆ K`, then multiplication by `φ a` on `J F ⊆ F` lands in `K F`: its composite with
the projection onto the cokernel of `K F ⟶ F` vanishes. -/
theorem idealMultipleι_globalSmul_comp_cokernelπ {K : Ideal A} {a : A}
    (h : ∀ b ∈ J, b * a ∈ K) :
    (idealMultipleι φ F J ≫ globalSmul _ (φ a) F) ≫ cokernel.π (idealMultipleι φ F K) = 0 := by
  refine idealMultiple_hom_ext φ F J fun b hb => ?_
  rw [comp_zero, Category.assoc, idealMultipleFactor_ι_assoc, ← Category.assoc,
    ← globalSmul_mul, ← map_mul, ← idealMultipleFactor_ι φ F K (h b hb), Category.assoc,
    cokernel.condition, comp_zero]

variable {J} in
/-- **Multiplication by `a` as a morphism `J F ⟶ K F`**, for `J a ⊆ K`. -/
def idealMultipleMap (K : Ideal A) (a : A) (h : ∀ b ∈ J, b * a ∈ K) :
    idealMultiple φ F J ⟶ idealMultiple φ F K :=
  Abelian.monoLift (idealMultipleι φ F K) (idealMultipleι φ F J ≫ globalSmul _ (φ a) F)
    (idealMultipleι_globalSmul_comp_cokernelπ φ F h)

variable {J}

/-- Multiplication by `a` from `J F` to `K F`, followed by the inclusion `K F ⟶ F`, is the
inclusion `J F ⟶ F` followed by multiplication by `φ a`. -/
@[reassoc (attr := simp)]
theorem idealMultipleMap_ι (K : Ideal A) (a : A) (h : ∀ b ∈ J, b * a ∈ K) :
    idealMultipleMap φ F K a h ≫ idealMultipleι φ F K =
      idealMultipleι φ F J ≫ globalSmul _ (φ a) F :=
  Abelian.monoLift_comp _ _ _

/-- Multiplication by `a` depends on `a` alone. -/
theorem idealMultipleMap_congr (K : Ideal A) {a a' : A} (e : a = a')
    (h : ∀ b ∈ J, b * a ∈ K) (h' : ∀ b ∈ J, b * a' ∈ K) :
    idealMultipleMap φ F K a h = idealMultipleMap φ F K a' h' := by
  subst e; rfl

/-- Multiplication maps compose to multiplication by the product. -/
@[reassoc]
theorem idealMultipleMap_comp {K L : Ideal A} (a b : A) (h : ∀ c ∈ J, c * a ∈ K)
    (h' : ∀ c ∈ K, c * b ∈ L) :
    idealMultipleMap φ F K a h ≫ idealMultipleMap φ F L b h' =
      idealMultipleMap φ F L (a * b) (fun c hc => by
        rw [← mul_assoc]; exact h' _ (h c hc)) := by
  refine (cancel_mono (idealMultipleι φ F L)).1 ?_
  simp only [Category.assoc, idealMultipleMap_ι, idealMultipleMap_ι_assoc, map_mul,
    globalSmul_mul]

/-- Multiplication maps are additive in the function. -/
theorem idealMultipleMap_add (K : Ideal A) (a a' : A) (h : ∀ b ∈ J, b * a ∈ K)
    (h' : ∀ b ∈ J, b * a' ∈ K) :
    idealMultipleMap φ F K (a + a')
        (fun b hb => (mul_add b a a').symm ▸ K.add_mem (h b hb) (h' b hb)) =
      idealMultipleMap φ F K a h + idealMultipleMap φ F K a' h' := by
  refine (cancel_mono (idealMultipleι φ F K)).1 ?_
  simp only [idealMultipleMap_ι, Preadditive.add_comp, map_add, globalSmul_add,
    Preadditive.comp_add]

/-- Multiplication by `0` is zero. -/
theorem idealMultipleMap_zero (K : Ideal A) (h : ∀ b ∈ J, b * 0 ∈ K) :
    idealMultipleMap φ F K 0 h = 0 := by
  refine (cancel_mono (idealMultipleι φ F K)).1 ?_
  simp only [idealMultipleMap_ι, map_zero, globalSmul_zero, comp_zero, zero_comp]

/-- Multiplication by `a` from `J F` into itself is multiplication by `φ a` on `J F`. -/
theorem idealMultipleMap_self (a : A) (h : ∀ b ∈ J, b * a ∈ J) :
    idealMultipleMap φ F J a h = globalSmul _ (φ a) (idealMultiple φ F J) := by
  refine (cancel_mono (idealMultipleι φ F J)).1 ?_
  rw [idealMultipleMap_ι, comp_globalSmul]

/-- Multiplication by `1` from `J F` into itself is the identity. -/
theorem idealMultipleMap_one (h : ∀ b ∈ J, b * 1 ∈ J) :
    idealMultipleMap φ F J 1 h = 𝟙 _ := by
  rw [idealMultipleMap_self, map_one, globalSmul_one]

/-- Multiplication by `r * a` is multiplication by `φ r` followed by multiplication by `a`. -/
theorem idealMultipleMap_mul_left (K : Ideal A) (r a : A) (h : ∀ b ∈ J, b * a ∈ K) :
    idealMultipleMap φ F K (r * a) (fun b hb => by
        rw [← mul_assoc]; exact h _ (J.mul_mem_right r hb)) =
      globalSmul _ (φ r) (idealMultiple φ F J) ≫ idealMultipleMap φ F K a h := by
  rw [← idealMultipleMap_self φ F r (fun b hb => J.mul_mem_right r hb), idealMultipleMap_comp]

end IdealMultiple

/-! ### The quotient `F / J F` -/

section IdealQuotient

variable (J : Ideal A)

/-- **The quotient `F / J F`.** -/
abbrev idealQuotient : Modules.{u, u} B S hS X hX := cokernel (idealMultipleι φ F J)

/-- The projection `F ⟶ F / J F`. -/
abbrev idealQuotientπ : F ⟶ idealQuotient φ F J := cokernel.π (idealMultipleι φ F J)

/-- The projection `F ⟶ F / J F` is an epimorphism. -/
instance epi_idealQuotientπ : Epi (idealQuotientπ φ F J) :=
  inferInstanceAs (Epi (cokernel.π (idealMultipleι φ F J)))

/-- The composite `J F ⟶ F ⟶ F / J F` is zero. -/
@[reassoc (attr := simp)]
theorem idealMultipleι_idealQuotientπ :
    idealMultipleι φ F J ≫ idealQuotientπ φ F J = 0 :=
  cokernel.condition _

/-- **`J` kills `F / J F`**: multiplication by `φ a`, for `a ∈ J`, is zero on `F / J F`. -/
theorem globalSmul_idealQuotient_eq_zero {a : A} (ha : a ∈ J) :
    globalSmul _ (φ a) (idealQuotient φ F J) = 0 := by
  refine (cancel_epi (idealQuotientπ φ F J)).1 ?_
  rw [comp_zero, comp_globalSmul, ← idealMultipleFactor_ι φ F J ha, Category.assoc,
    idealMultipleι_idealQuotientπ, comp_zero]

/-- The short complex `J F ⟶ F ⟶ F / J F`. -/
def idealShortComplex : ShortComplex (Modules.{u, u} B S hS X hX) :=
  ShortComplex.mk (idealMultipleι φ F J) (idealQuotientπ φ F J)
    (idealMultipleι_idealQuotientπ φ F J)

/-- **`0 ⟶ J F ⟶ F ⟶ F / J F ⟶ 0` is short exact.** -/
theorem idealShortComplex_shortExact : (idealShortComplex φ F J).ShortExact where
  exact := ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel (idealMultipleι φ F J))
  mono_f := inferInstanceAs (Mono (idealMultipleι φ F J))
  epi_g := inferInstanceAs (Epi (idealQuotientπ φ F J))

variable {J}

/-- For `J ≤ K` the inclusion `J F ⟶ F` factors through `K F`. -/
theorem idealMultipleMap_one_ι {K : Ideal A} (hJK : J ≤ K) :
    idealMultipleMap φ F K 1 (fun b hb => by rw [mul_one]; exact hJK hb) ≫
      idealMultipleι φ F K = idealMultipleι φ F J := by
  rw [idealMultipleMap_ι, map_one, globalSmul_one, Category.comp_id]

/-- The map `F / J F ⟶ F / K F` for `J ≤ K`. -/
def idealQuotientMap {K : Ideal A} (hJK : J ≤ K) : idealQuotient φ F J ⟶ idealQuotient φ F K :=
  cokernel.desc _ (idealQuotientπ φ F K) (by
    rw [← idealMultipleMap_one_ι φ F hJK, Category.assoc, idealMultipleι_idealQuotientπ,
      comp_zero])

/-- Composing `F ⟶ F / J F` with `F / J F ⟶ F / K F` gives the projection `F ⟶ F / K F`. -/
@[reassoc (attr := simp)]
theorem idealQuotientπ_idealQuotientMap {K : Ideal A} (hJK : J ≤ K) :
    idealQuotientπ φ F J ≫ idealQuotientMap φ F hJK = idealQuotientπ φ F K :=
  cokernel.π_desc _ _ _

/-- For `J ≤ K ≤ L` the maps `F / J F ⟶ F / K F ⟶ F / L F` compose to `F / J F ⟶ F / L F`. -/
theorem idealQuotientMap_comp {K L : Ideal A} (hJK : J ≤ K) (hKL : K ≤ L) :
    idealQuotientMap φ F hJK ≫ idealQuotientMap φ F hKL =
      idealQuotientMap φ F (hJK.trans hKL) := by
  refine (cancel_epi (idealQuotientπ φ F J)).1 ?_
  simp

/-- The map `F / J F ⟶ F / J F` for `J ≤ J` is the identity. -/
theorem idealQuotientMap_refl : idealQuotientMap φ F (le_refl J) = 𝟙 _ := by
  refine (cancel_epi (idealQuotientπ φ F J)).1 ?_
  simp

/-- The morphism of short exact sequences `(J F ⟶ F ⟶ F / J F) ⟶ (K F ⟶ F ⟶ F / K F)` for
`J ≤ K`. -/
def idealShortComplexMap {K : Ideal A} (hJK : J ≤ K) :
    idealShortComplex φ F J ⟶ idealShortComplex φ F K where
  τ₁ := idealMultipleMap φ F K 1 (fun b hb => by rw [mul_one]; exact hJK hb)
  τ₂ := 𝟙 F
  τ₃ := idealQuotientMap φ F hJK
  comm₁₂ := by
    change _ ≫ idealMultipleι φ F K = idealMultipleι φ F J ≫ 𝟙 F
    rw [idealMultipleMap_one_ι φ F hJK, Category.comp_id]
  comm₂₃ := by
    change 𝟙 F ≫ idealQuotientπ φ F K = idealQuotientπ φ F J ≫ _
    rw [Category.id_comp, idealQuotientπ_idealQuotientMap]

end IdealQuotient

/-! ### Quasi-coherence and coherence -/

section Coherence

variable (J : Ideal A)

/-- The coproduct `∐_{a ∈ J} F` is cartesian on affine charts when `F` is quasi-coherent. -/
private theorem isCartesianOnAffineCharts_coproduct_of_isQuasicoherentOnSite
    (hF : F.IsQuasicoherentOnSite) : IsCartesianOnAffineCharts (∐ fun _ : ↥J => F) :=
  isCartesianOnAffineCharts_coproduct B S hS X hX _ (coproductIsCoproduct fun _ : ↥J => F)
    fun _ => isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X hX F hF

/-- `J F` is quasi-coherent when `F` is: it is the image of a morphism between quasi-coherent
modules. -/
theorem isQuasicoherentOnSite_idealMultiple (hF : F.IsQuasicoherentOnSite) :
    (idealMultiple φ F J).IsQuasicoherentOnSite := by
  exact isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_image_of_cartesian _
      (isCartesianOnAffineCharts_coproduct_of_isQuasicoherentOnSite F J hF)
      (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X hX F hF))

/-- `F / J F` is quasi-coherent when `F` is. -/
theorem isQuasicoherentOnSite_idealQuotient (hF : F.IsQuasicoherentOnSite) :
    (idealQuotient φ F J).IsQuasicoherentOnSite := by
  have := hF
  have := isQuasicoherentOnSite_idealMultiple φ F J hF
  exact isQuasicoherentOnSite_cokernel_unconditional B S hS X hX (idealMultipleι φ F J)

/-- `J F` is coherent when `F` is, on a locally Noetherian algebraic space. -/
theorem isCoherent_idealMultiple
    [Fact (HasEtaleLocalProperty B S hS X (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (hF : IsCoherent B S hS X hX F) : IsCoherent B S hS X hX (idealMultiple φ F J) :=
  isCoherent_of_mono_of_isQuasicoherentOnSite B S hS X hX (idealMultipleι φ F J)
    (isQuasicoherentOnSite_idealMultiple φ F J hF.toIsQuasicoherentOnSite) hF

end Coherence

/-! ### Sections over an affine chart -/

section Sections

variable (J : Ideal A)

/-- **Over an affine étale chart the sections of `J F` are generated by multiples.**  For a
quasi-coherent `F` and an affine étale chart `U` of `X`, the sections of `J F` over `U` are
spanned over `𝒪(U)` by the images of the sections of `F` over `U` under the morphisms
`F ⟶ J F` of multiplication by the elements of `J`. -/
theorem span_idealMultipleFactor_sections (hF : F.IsQuasicoherentOnSite)
    (U : SmallEtale B S hS X)
    (hU : IsAffine ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    Submodule.span (chartRing B S hS X hX U)
      {t | ∃ (a : A) (ha : a ∈ J) (s : F.val.obj (op U)),
        t = (idealMultipleFactor φ F J ha).val.app (op U) s} = ⊤ := by
  classical
  have hFc := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X hX F hF
  refine eq_top_iff.2 fun t _ => ?_
  clear ‹t ∈ ⊤›
  obtain ⟨y, rfl⟩ := surjective_val_app_factorThruImage_of_cartesian
    (idealMultipleHom φ F J) (isCartesianOnAffineCharts_coproduct_of_isQuasicoherentOnSite F J hF)
    hFc U hU t
  obtain ⟨z, rfl⟩ := (Stacks.Sites.bijective_coproductSectionsMap _
    (coproductIsCoproduct fun _ : ↥J => F) U
    (isQuasiCompactObject_of_isAffine B S hS X U hU)).2 y
  induction z using DirectSum.induction_on with
  | zero => rw [map_zero, map_zero]; exact Submodule.zero_mem _
  | of a s =>
    have h := Stacks.Sites.coproductSectionsMap_lof
      (Cofan.mk _ (Sigma.ι fun _ : ↥J => F)) (op U) a s
    rw [← DirectSum.lof_eq_of
      (R := ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O)).obj.obj
        (op U)), h]
    refine Submodule.subset_span ⟨a.1, a.2, s, ?_⟩
    change ((Sigma.ι (fun _ : ↥J => F) a ≫
      Abelian.factorThruImage (idealMultipleHom φ F J)).val.app (op U)) s = _
    rfl
  | add z z' hz hz' => rw [map_add, map_add]; exact Submodule.add_mem _ hz hz'

end Sections

end AlgebraicGeometry.Space

end
