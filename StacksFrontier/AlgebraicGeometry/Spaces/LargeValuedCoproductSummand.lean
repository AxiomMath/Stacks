module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.CoproductSummand
public import StacksFrontier.AlgebraicGeometry.Spaces.LargeValuedCoproductRefined

/-!
# Summands of a coproduct of algebraic spaces, in an arbitrary value universe

Let `S` be a scheme contained in a big fppf site `B`. **Stacks 0F15** says that every
inclusion of a summand into a coproduct of sheaves on the big fppf site of `S` is representable
by open immersions; `AlgebraicGeometry.coproductIncl_isOpenImmersion` proves it for sheaves
with values in `Type u`, the value universe of the morphisms of the site. That proof is
genuinely tied to that universe: it runs through the subsheaf of the coproduct generated by the
other summands, and the sheafification of a subfunctor is available there and not one universe
up.

For a coproduct of *algebraic spaces* the restriction is harmless, and this file removes it.
An algebraic space over `S` has pointwise `u`-small sections, and so does a `u`-small coproduct
of them, so the whole cofan is the universe lift of a cofan of sheaves of `Type u`
(`AlgebraicGeometry.Space.exists_shrink_isColimit_cofan`); a relative morphism property is
unchanged by that lift, being a relative property along `yoneda` composed with it. So Stacks
0F15 in the value universe of the site gives Stacks 0F15 in any value universe above it.

## Main results

* `AlgebraicGeometry.Space.relative_isOpenImmersion_coproductIncl`: **Stacks 0F15** for a
  coproduct of algebraic spaces over `S` with values in `Type (max w u)`.

## Implementation notes

The index type is asked to be `u`-small, which is what makes the coproduct pointwise `u`-small;
every finite or countable index type is.

No `@[stacks]` registration is made: as in
`StacksFrontier/AlgebraicGeometry/Spaces/CoproductSummand.lean`, where the arbitrary-index form of
Stacks 0F15 is also left untagged, the tagged statement is the binary one of
`StacksFrontier/AlgebraicGeometry/Spaces/CoproductInclusion.lean`; and this is in addition a
special case of the tag, the summands being assumed algebraic spaces.

## References

* [Stacks Project, Tag 0F15](https://stacks.math.columbia.edu/tag/0F15)
* [Stacks Project, Tag 02WQ](https://stacks.math.columbia.edu/tag/02WQ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Stacks 0F15 in an arbitrary value universe.** The inclusion of a summand into a
coproduct of algebraic spaces over `S`, with values in `Type (max w u)` and indexed by a
`u`-small type, is representable by open immersions.

The cofan is the universe lift of a cofan of sheaves of `Type u`, the members and the point
being pointwise `u`-small, and a relative morphism property along the universe-lifted Yoneda
embedding is a relative property along `yoneda` after the lift, hence is read off the statement
in the value universe of the site. -/
theorem relative_isOpenImmersion_coproductIncl {I : Type v} [Small.{u} I]
    {Fᵢ : I → Sheaf (BigFppfOver.topology B S hS) (Type (max w u))}
    (hFᵢ : ∀ i, IsAlgebraicSpaceULift.{w} B S hS (Fᵢ i).obj)
    {G : Sheaf (BigFppfOver.topology B S hS) (Type (max w u))} (ι : ∀ i, Fᵢ i ⟶ G)
    (hG : IsColimit (Cofan.mk G ι)) (i : I) :
    (MorphismProperty.inverseImage
      (@AlgebraicGeometry.IsOpenImmersion.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).relative (uliftYoneda.{w}) (ι i).hom := by
  let P := MorphismProperty.inverseImage
    (@AlgebraicGeometry.IsOpenImmersion.{u} : MorphismProperty Scheme.{u})
    (BigFppfOver.toScheme B S hS)
  let H := (Functor.whiskeringRight (BigFppfOver B S hS)ᵒᵖ (Type u) (Type (max w u))).obj
    uliftFunctor.{w}
  obtain ⟨F', hF', Gsh, ι', eF, eG, ⟨hGcolim⟩, hmap⟩ :=
    exists_shrink_isColimit_cofan B S hS hFᵢ ι hG
  have h0 : P.presheaf (ι' i).hom :=
    coproductIncl_isOpenImmersion B S hS (fun k ↦ ⟨F' k, (hF' k).isSheaf⟩) Gsh ι' hGcolim i
  have h1 : P.relative (uliftYoneda.{w}) (H.map (ι' i).hom) :=
    (relative_comp_map_iff yoneda H P (ι' i).hom).mpr h0
  rw [show H.map (ι' i).hom = (eF i).hom ≫ (ι i).hom ≫ eG.inv from hmap i] at h1
  exact (MorphismProperty.cancel_right_of_respectsIso (P.relative (uliftYoneda.{w}))
    (ι i).hom eG.inv).mp ((MorphismProperty.cancel_left_of_respectsIso
      (P.relative (uliftYoneda.{w})) (eF i).hom ((ι i).hom ≫ eG.inv)).mp h1)

end AlgebraicGeometry.Space

end
