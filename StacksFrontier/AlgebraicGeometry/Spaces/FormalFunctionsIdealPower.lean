module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.AlgebraSheafImageQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.FormalFunctionsAdicLimit
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasicoherentSheavesProperties

/-!
# The submodules `Iⁿℱ` of the theorem on formal functions

Section 08AU of the Stacks project ([Stacks, Tag 08AU]) works in Situation 08AV: a Noetherian ring
`A` with an ideal `I`, a proper morphism `f : X ⟶ Spec A` of algebraic spaces and a coherent
`𝒪_X`-module `ℱ`. In this situation it denotes by `Iⁿℱ` the submodule of `ℱ` generated, as an
`𝒪_X`-module, by the products of local sections of `ℱ` and elements of `Iⁿ`. This file defines
that submodule for `AlgebraicGeometry.Space.FormalFunctionsSituation`, with its inclusion into
`ℱ`.

## Main definitions

* `AlgebraicGeometry.Space.FormalFunctionsSituation.idealPowerMultiple` — the submodule `Iⁿℱ`.
* `AlgebraicGeometry.Space.FormalFunctionsSituation.idealPowerMultipleι` — its inclusion into `ℱ`.
* `AlgebraicGeometry.Space.FormalFunctionsSituation.idealPowerSubmodule` — the same submodule
  `Iⁿℱ` when `ℱ` has its sections in the universe of the schemes, the universe of the
  quasi-coherence API of algebraic spaces.

## Main results

* `AlgebraicGeometry.Space.FormalFunctionsSituation.isQuasicoherentOnSite_idealPowerSubmodule` —
  `Iⁿℱ` is quasi-coherent, the first assertion of the section about it.  The second, that `Iⁿℱ`
  is the image of `f^*Ĩⁿ ⊗ ℱ ⟶ ℱ`, is
  `AlgebraicGeometry.Space.FormalFunctionsSituation.imageSubobject_idealPowerTensorMap` in
  `StacksFrontier/AlgebraicGeometry/Spaces/FormalFunctionsIdealPowerImage.lean`.

## Implementation notes

`Iⁿℱ` is `Stacks.Cohomology.SiteModules.idealSmul` for the ideal of global functions of `X`
generated by the image of `Iⁿ` under `A ⟶ Γ(X, 𝒪_X)`: the image of the map
`⨁_{a} ℱ ⟶ ℱ` whose component at `a` is multiplication by `a`. An element of the generated ideal
is a combination `∑ cᵢ aᵢ` of images of elements `aᵢ ∈ Iⁿ`, so the image is the submodule generated
by the products of local sections of `ℱ` with elements of `Iⁿ`. The thickening `ℱ / Iⁿℱ` of
`AlgebraicGeometry.Space.FormalFunctionsSituation.adicThickening`, on which the theorem on formal
functions is stated, is by definition the cokernel of that same map, and multiplication by an
element of `Iⁿ` factors through `Iⁿℱ` by `Stacks.Cohomology.SiteModules.idealSmulFactor_comp_ι`.
`AlgebraicGeometry.Space.FormalFunctionsSituation.idealPowerMultiple` is stated at the module
universe of `AlgebraicGeometry.Space.cohomologyOverBase`; as there, the universes are given
explicitly so that no image or cokernel is searched for at the small étale ringed site. The
quasi-coherence of `Iⁿℱ` is proved at the module universe of the schemes, where the closure
properties of Stacks 03M1 are available
(`AlgebraicGeometry.Space.isQuasicoherentOnSite_of_isColimit_cofan` for direct sums and
`AlgebraicGeometry.Space.isQuasicoherentOnSite_image_unconditional` for images): there `Iⁿℱ` is
`AlgebraicGeometry.Space.FormalFunctionsSituation.idealPowerSubmodule`, the image of the same
multiplication map out of a direct sum indexed by `Iⁿ` itself.

## References

* [Stacks Project, Section 08AU](https://stacks.math.columbia.edu/tag/08AU)
* [Stacks Project, Tag 08AV](https://stacks.math.columbia.edu/tag/08AV)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open Stacks.Cohomology.SiteModules

universe u w

namespace AlgebraicGeometry.Space

attribute [local instance] isMulCommutative_ringSheaf

namespace FormalFunctionsSituation

open SiteAdicCohomology

variable (S : FormalFunctionsSituation.{u, max (u + 1) w})

/-- **The submodule `Iⁿℱ` of Situation 08AV** (Section 08AU): the submodule of `ℱ` generated by
the products of local sections of `ℱ` and elements of `Iⁿ`, the image of multiplication by the
global functions coming from `Iⁿ`. -/
@[stacks 08AU "the submodule Iⁿℱ of ℱ generated as an 𝒪_X-module by products of local sections \
of ℱ and elements of Iⁿ, in Situation 08AV"]
abbrev idealPowerMultiple (n : ℕ) :
    Modules.{u, max (u + 1) w} S.site (Spec (.of S.ring)) S.containsBase S.space.1 S.space.2 :=
  idealSmul.{u + 1, u, u, max (u + 1) w} (structureRing S)
    (mapIdealPow (structureRing S) (baseRing S) S.ideal n) S.coefficients

/-- The inclusion `Iⁿℱ ⟶ ℱ`. -/
abbrev idealPowerMultipleι (n : ℕ) : idealPowerMultiple S n ⟶ S.coefficients :=
  idealSmulι.{u + 1, u, u, max (u + 1) w} (structureRing S)
    (mapIdealPow (structureRing S) (baseRing S) S.ideal n) S.coefficients

/-- The inclusion `Iⁿℱ ⟶ ℱ` is a monomorphism. -/
instance mono_idealPowerMultipleι (n : ℕ) : Mono (idealPowerMultipleι S n) :=
  idealSmulι_mono.{u + 1, u, u, max (u + 1) w} (structureRing S)
    (mapIdealPow (structureRing S) (baseRing S) S.ideal n) S.coefficients

/-! ### `Iⁿℱ` at the module universe of the schemes, and its quasi-coherence -/

section SchemeUniverse

/- At the module universe of the schemes the abelian structure on the modules is the one of the
small étale ringed site; the global instance of the cohomology of modules, at a larger universe,
would otherwise be tried first and leave the universe constraints of `image` unsolved. -/
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian

variable (S : FormalFunctionsSituation.{u, u})

/-- The multiplication map `⨁_{a ∈ Iⁿ} ℱ ⟶ ℱ` of Situation 08AV at the module universe of the
schemes, whose component at `a` is multiplication by the image of `a` in the global functions. -/
abbrev idealPowerSmulHom (n : ℕ) :
    (∐ fun _ : ↥(S.ideal ^ n) => S.coefficients) ⟶ S.coefficients :=
  Sigma.desc fun a => globalSmul _
    (baseRingHom S.ring S.site S.containsBase S.space.1 S.space.2 a.1) S.coefficients

/-- **The submodule `Iⁿℱ` of Situation 08AV** (Section 08AU), at the module universe of the
schemes: the image of multiplication by the elements of `Iⁿ`, that is the submodule of `ℱ`
generated by the products of local sections of `ℱ` and elements of `Iⁿ`. -/
abbrev idealPowerSubmodule (n : ℕ) :
    Modules.{u, u} S.site (Spec (.of S.ring)) S.containsBase S.space.1 S.space.2 :=
  image (idealPowerSmulHom S n)

/-- The inclusion `Iⁿℱ ⟶ ℱ`, at the module universe of the schemes. -/
abbrev idealPowerSubmoduleι (n : ℕ) : idealPowerSubmodule S n ⟶ S.coefficients :=
  image.ι (idealPowerSmulHom S n)

/-- Multiplication by an element `a ∈ Iⁿ` factors through `Iⁿℱ`. -/
theorem globalSmul_factors_idealPowerSubmoduleι (n : ℕ) {a : S.ring} (ha : a ∈ S.ideal ^ n) :
    ∃ g : S.coefficients ⟶ idealPowerSubmodule S n, g ≫ idealPowerSubmoduleι S n =
      globalSmul _ (baseRingHom S.ring S.site S.containsBase S.space.1 S.space.2 a)
        S.coefficients :=
  ⟨Sigma.ι (fun _ : ↥(S.ideal ^ n) => S.coefficients) ⟨a, ha⟩ ≫
      factorThruImage (idealPowerSmulHom S n), by
    rw [Category.assoc, image.fac, Sigma.ι_comp_desc]⟩

/-- **`Iⁿℱ` is quasi-coherent** (Section 08AU): it is the image of a morphism from a direct sum
of copies of the coherent, hence quasi-coherent, module `ℱ` to `ℱ`; a direct sum of
quasi-coherent modules is quasi-coherent (Stacks 03M1 (1)) and so is the image of a morphism of
quasi-coherent modules (Stacks 03M1 (3)). -/
@[stacks 08AU "Iⁿℱ is a quasi-coherent submodule of ℱ, in Situation 08AV"]
theorem isQuasicoherentOnSite_idealPowerSubmodule (n : ℕ) :
    (idealPowerSubmodule S n).IsQuasicoherentOnSite := by
  have hF : S.coefficients.IsQuasicoherentOnSite := inferInstance
  have hsum : (∐ fun _ : ↥(S.ideal ^ n) => S.coefficients).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_of_isColimit_cofan S.site (Spec (.of S.ring)) S.containsBase
      S.space.1 S.space.2 _ (coproductIsCoproduct _) fun _ ↦ hF
  exact isQuasicoherentOnSite_image_unconditional S.site (Spec (.of S.ring)) S.containsBase
    S.space.1 S.space.2 _ hsum hF

end SchemeUniverse

end FormalFunctionsSituation

end AlgebraicGeometry.Space

end
