universe u

namespace Stacks.Blowup

/-- The ideal sheaf on an affine scheme `Y` generated by an ideal `I` of `Γ(Y, ⊤)`, pulled back to
`Spec Γ(Y, ⊤)` along the canonical isomorphism, is the ideal sheaf generated by the corresponding
ideal of `Γ(Spec Γ(Y, ⊤), ⊤)`. -/
theorem comap_isoSpec_inv_ι_ofIdealTop (Y : Scheme.{u}) [IsAffine Y]
    (I : Ideal ↥Γ(Y, (topAffineOpen Y).1)) :
    (Scheme.IdealSheafData.ofIdealTop I).comap
        ((Stacks.RelativeProj.isAffineOpen (topAffineOpen Y)).isoSpec.inv ≫
          (topAffineOpen Y).1.ι) =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.comap (Scheme.ΓSpecIso (CommRingCat.of (↥Γ(Y, (topAffineOpen Y).1)))).hom.hom
          I) := by
  have key : ((Stacks.RelativeProj.isAffineOpen (topAffineOpen Y)).isoSpec.inv ≫
      (topAffineOpen Y).1.ι).appTop = (Scheme.ΓSpecIso Γ(Y, (topAffineOpen Y).1)).inv := by
    rw [Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_inv_appTop, Scheme.Opens.ι_appTop]
    simp only [Scheme.Opens.topIso_hom]
    refine (Category.assoc _ _ _).symm.trans ?_
    refine (congrArg (· ≫ _) (Y.presheaf.map_comp _ _).symm).trans ?_
    exact (congrArg (· ≫ _) ((congrArg Y.presheaf.map (Subsingleton.elim _ (𝟙 _))).trans
      (Y.presheaf.map_id _))).trans (Category.id_comp _)
  refine (Stacks.IdealSheaf.comap_ofIdealTop _ (I : Ideal ↥Γ(Y, ⊤))).trans ?_
  congr 1
  rw [key]
  exact Ideal.map_symm (Scheme.ΓSpecIso Γ(Y, (topAffineOpen Y).1)).commRingCatIsoToRingEquiv

end Stacks.Blowup

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- On an affine scheme of the site the sheaf of ideals of a closed subspace of its algebraic space
is the ideal sheaf generated by its ideal of global sections. -/
theorem reesChartIdeal_selfPresentation_eq_ofIdealTop_of_ideal_eq (V : BigFppfOver B S hS)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
    (Z : ClosedSubspaces B S hS (schemeSpace V).obj)
    (I : Ideal ↥Γ((BigFppfOver.toScheme B S hS).obj V,
      (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)).1))
    (hI : (reesChartIdeal (centreIdeal Z) (isCartesianOnAffineCharts_centreIdeal Z)
        (selfPresentation B S hS V)).ideal
        (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)) = I) :
    reesChartIdeal (centreIdeal Z) (isCartesianOnAffineCharts_centreIdeal Z)
        (selfPresentation B S hS V) = Scheme.IdealSheafData.ofIdealTop I := by
  rw [reesChartIdeal_selfPresentation_eq_ofIdealTop] at hI ⊢
  exact congrArg _ (((Scheme.IdealSheafData.equivOfIsAffine
    (X := (BigFppfOver.toScheme B S hS).obj V)).right_inv _).symm.trans hI)

/-- The sheaf of ideals induced on an étale chart `c : W ⟶ X'` by the exceptional divisor of a
morphism `b : X' ⟶ X`, when `c ≫ b` factors through a scheme `V ⟶ X`, is the inverse image of
the sheaf of ideals of the centre on `V`. -/
theorem idealSheafDataOfChart_preimage_eq_comap {X X' : AlgebraicSpaces B S hS}
    (Z : ClosedSubspaces B S hS X.1) (b : X' ⟶ X) (V : BigFppfOver B S hS) (a : schemeSpace V ⟶ X)
    {W : BigFppfOver B S hS} (c : yoneda.obj W ⟶ X'.1)
    (hc : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS))) c)
    (g : W ⟶ V) (hcomm : c ≫ b.hom = yoneda.map g ≫ a.hom) :
    idealSheafDataOfChart B S hS X' (definingIdealSheaf B S hS X' (preimageClosedSubspace b Z))
        (definingIdealSheaf_isCartesianOnAffineCharts B S hS X' (preimageClosedSubspace b Z))
        (etaleChartOfHom c hc) =
      (reesChartIdeal (centreIdeal (preimageClosedSubspace a Z))
        (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)).comap
        ((BigFppfOver.toScheme B S hS).map g) := by
  have h0 := ker_rep_snd_eq_idealSheafDataOfChart B S hS X' (preimageClosedSubspace b Z)
    (etaleChartOfHom c hc)
  have h0' := ker_rep_snd_eq_idealSheafDataOfChart B S hS (schemeSpace V)
    (preimageClosedSubspace a Z) (presentationChart (selfPresentation B S hS V))
  have h1 := schemeKer_snd_preimage B S hS b Z (etaleChartOfHom c hc)
  have h2 := schemeKer_snd_preimage B S hS a Z (presentationChart (selfPresentation B S hS V))
  have h3 := schemeKer_snd_comp B S hS Z a.hom g
  refine h0.symm.trans (h1.trans ?_)
  erw [hcomm, h3, ← Category.id_comp a.hom]
  congr 1
  exact h2.symm.trans h0'

namespace IsBlowupAlong

/-- **The invertible sheaf of the exceptional divisor restricts to `𝒪(-1)` on the affine charts
of a blowup.**  Let `b : X' ⟶ X` be a blowup of `X` in `Z`, let `V = Spec A` be an affine scheme
over `X`, with `I ⊆ A` the ideal of `Z` on `V`, and let `c : W ⟶ X'` be an étale morphism from a
scheme of the site with `c ≫ b` factoring through `g : W ⟶ V`.  For every morphism
`f : Proj(⨁ Iᵈ) ⟶ W` over `V` the pullback along `f` of the base change of `𝒪_{X'}(E)` to `W` is
the twist `𝒪(-1)` of `Proj(⨁ Iᵈ)`; here `E = b⁻¹(Z)` is the exceptional divisor, an effective
Cartier divisor by Stacks 085U. -/
theorem nonempty_pullback_baseChangeModule_iso_twistingSheaf_neg_one
    {X X' : AlgebraicSpaces B S hS} {Z : ClosedSubspaces B S hS X.1} {b : X' ⟶ X}
    (hb : IsBlowupAlong B S hS Z b)
    (V : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
    (a : schemeSpace V ⟶ X)
    (I : Ideal ↥Γ((BigFppfOver.toScheme B S hS).obj V,
      (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)).1))
    (hI : (reesChartIdeal (centreIdeal (preimageClosedSubspace a Z))
        (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)).ideal
        (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)) = I)
    {W : BigFppfOver B S hS} (c : yoneda.obj W ⟶ X'.1) (hc : IsEtale B S hS c)
    (g : W ⟶ V) (hcomm : c ≫ b.hom = yoneda.map g ≫ a.hom)
    (f : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I) ⟶ (BigFppfOver.toScheme B S hS).obj W)
    (hf : f ≫ (BigFppfOver.toScheme B S hS).map g =
      Stacks.Blowup.toSpec I ≫
        (Stacks.RelativeProj.isAffineOpen (Stacks.Blowup.topAffineOpen
          ((BigFppfOver.toScheme B S hS).obj V))).isoSpec.inv ≫
          (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)).1.ι) :
    Nonempty ((Scheme.Modules.pullback f).obj
        (baseChangeModule B S hS (associatedInvertibleSheaf B S hS X' (preimageClosedSubspace b Z)
          hb.isPullbackDefined) W c) ≅
      twistingSheaf (Stacks.Blowup.reesGrading I) (-1)) := by
  have hc' := presheaf_etale_of_isEtale B S hS hc
  obtain ⟨e⟩ := nonempty_tensor_baseChangeModule_negativeTwist_iso_unit
    (preimageClosedSubspace b Z) hb.isPullbackDefined c hc'
  refine Stacks.Blowup.nonempty_pullback_iso_twistingSheaf_neg_one_of_tensor_iso_unit I f _ ?_ _ e
  have hK := idealSheafDataOfChart_preimage_eq_comap Z b V a c hc' g hcomm
  rw [hK, ← Scheme.IdealSheafData.comap_comp, hf]
  refine (Scheme.IdealSheafData.comap_comp _ (Stacks.Blowup.toSpec I) _).trans ?_
  refine congrArg (fun J => Scheme.IdealSheafData.comap J (Stacks.Blowup.toSpec I)) ?_
  refine (congrArg (fun J => Scheme.IdealSheafData.comap J _)
    (reesChartIdeal_selfPresentation_eq_ofIdealTop_of_ideal_eq V _ I hI)).trans ?_
  exact Stacks.Blowup.comap_isoSpec_inv_ι_ofIdealTop _ I

/-- **Stacks 085T.**  Let `S` be a scheme, let `X` be an algebraic space over `S`, let `Z ⊆ X` be
a closed subspace and let `b : X' ⟶ X` be the blowing up of `X` in `Z`, in the sense of the
universal property of Stacks 085U.  Then

1. the restriction `b⁻¹(X ∖ Z) ⟶ X ∖ Z` of `b` is an isomorphism;
2. the exceptional divisor `E = b⁻¹(Z)` is an effective Cartier divisor on `X'`;
3. `𝒪_{X'}(E) = 𝒪_{X'}(-1)`: for every affine scheme `V = Spec A` étale over `X`, with `I ⊆ A` the
   ideal of `Z` on `V`, the fibre product `V ×_X X'` is identified over `V` with the scheme
   `Proj(⨁_{d ≥ 0} Iᵈ)` (by `e` and `f`, as in Stacks 085R), and under that identification the
   base change of the invertible sheaf `𝒪_{X'}(E)` of Stacks 0841 is the twist `𝒪(-1)`.

Part (3) is the characterization of the twists of the relative `Proj` in Stacks 084D (their base
change to schemes over `X` are the twists of Stacks 01NR), applied to the affine schemes étale
over `X`, which cover it. -/
@[stacks 085T "all three parts, for any blowup b of X in a closed subspace Z in the sense of the \
Stacks 085U universal property: (1) b is an isomorphism over the complement of Z, (2) the \
exceptional divisor is an effective Cartier divisor, (3) O(E) = O(-1), read as in Stacks 084D \
on every affine scheme V etale over X, where V x_X X' = Proj of the Rees algebra (Stacks 085R) \
and the base change of O(E) is the twist O(-1); no other hypothesis"]
theorem isIso_and_isEffectiveCartierDivisor_and_twist_neg_one
    {X X' : AlgebraicSpaces B S hS} {Z : ClosedSubspaces B S hS X.1} {b : X' ⟶ X}
    (hb : IsBlowupAlong B S hS Z b) :
    IsIso ((openComplementOfClosedSubspace B S hS X Z).1.fromPreimage b.hom) ∧
      IsEffectiveCartierDivisor B S hS X' (preimageClosedSubspace b Z) ∧
      ∀ (V : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
        (a : schemeSpace V ⟶ X), IsEtale B S hS a.hom →
        ∀ (I : Ideal ↥Γ((BigFppfOver.toScheme B S hS).obj V,
            (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)).1)),
          (reesChartIdeal (centreIdeal (preimageClosedSubspace a Z))
            (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)).ideal
            (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)) = I →
        ∀ {W : AlgebraicSpaces B S hS} {q : W ⟶ schemeSpace V} {r : W ⟶ X'},
          IsPullback q r a b →
        ∃ e : W ≅ schemeSpace (reesProjChart (centreIdeal (preimageClosedSubspace a Z))
            (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)
            (contains_relativeProj_reesChartSituation_selfPresentation Z V a)),
          e.hom ≫ schemeSpaceMap (reesProjChartHom (centreIdeal (preimageClosedSubspace a Z))
              (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)
              (contains_relativeProj_reesChartSituation_selfPresentation Z V a)) = q ∧
          ∃ f : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I) ≅
              (BigFppfOver.toScheme B S hS).obj
                (reesProjChart (centreIdeal (preimageClosedSubspace a Z))
                  (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)
                  (contains_relativeProj_reesChartSituation_selfPresentation Z V a)),
            f.hom ≫ (BigFppfOver.toScheme B S hS).map
                (reesProjChartHom (centreIdeal (preimageClosedSubspace a Z))
                  (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)
                  (contains_relativeProj_reesChartSituation_selfPresentation Z V a)) =
              Stacks.Blowup.toSpec I ≫
                (Stacks.RelativeProj.isAffineOpen (Stacks.Blowup.topAffineOpen
                  ((BigFppfOver.toScheme B S hS).obj V))).isoSpec.inv ≫
                  (Stacks.Blowup.topAffineOpen ((BigFppfOver.toScheme B S hS).obj V)).1.ι ∧
            Nonempty ((Scheme.Modules.pullback f.hom).obj
                (baseChangeModule B S hS (associatedInvertibleSheaf B S hS X'
                  (preimageClosedSubspace b Z) hb.isPullbackDefined) _ (e.inv ≫ r).hom) ≅
              twistingSheaf (Stacks.Blowup.reesGrading I) (-1)) := by
  refine ⟨isIso_fromPreimage_openComplement hb, hb.isPullbackDefined, ?_⟩
  intro V _ a ha I hI W q r sq
  obtain ⟨e, he, f, hf⟩ :=
    exists_iso_proj_reesGrading_affineChart_unconditional hb V ha sq I hI
  refine ⟨e, he, f, hf, ?_⟩
  have hr : IsEtale B S hS r.hom := isEtale_of_isPullback B S hS q r a b sq ha
  have hc : IsEtale B S hS (e.inv ≫ r).hom :=
    isEtale_comp B S hS (isEtale_of_isIso B S hS e.inv.hom) hr
  have hq : e.inv ≫ q = schemeSpaceMap (reesProjChartHom (centreIdeal (preimageClosedSubspace a Z))
      (isCartesianOnAffineCharts_centreIdeal _) (selfPresentation B S hS V)
      (contains_relativeProj_reesChartSituation_selfPresentation Z V a)) :=
    (Iso.inv_comp_eq e).2 he.symm
  have hcomm : (e.inv ≫ r).hom ≫ b.hom = yoneda.map (reesProjChartHom
      (centreIdeal (preimageClosedSubspace a Z)) (isCartesianOnAffineCharts_centreIdeal _)
      (selfPresentation B S hS V)
      (contains_relativeProj_reesChartSituation_selfPresentation Z V a)) ≫ a.hom := by
    have h1 : (e.inv ≫ r) ≫ b = (e.inv ≫ q) ≫ a := by
      rw [Category.assoc, Category.assoc, sq.w]
    rw [hq] at h1
    exact congrArg (fun k => k.hom) h1
  exact nonempty_pullback_baseChangeModule_iso_twistingSheaf_neg_one hb V a I hI _ hc _ hcomm
    f.hom hf

end IsBlowupAlong

end AlgebraicGeometry.Space

