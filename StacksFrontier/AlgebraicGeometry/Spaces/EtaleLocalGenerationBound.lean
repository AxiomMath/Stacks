/-!
# Modules étale-locally generated by a bounded number of sections

Let `X` be an algebraic space over a scheme `S` of a big fppf site and `κ` a cardinal.  An
`𝒪_X`-module `F` is *étale-locally generated by fewer than `κ` sections* when there is a jointly
surjective family of étale morphisms `vᵢ : Vᵢ ⟶ X` of algebraic spaces such that each pullback
`vᵢ^*F` is generated by a family of fewer than `κ` global sections.

A module of finite type is étale-locally generated by fewer than `ℵ₀` sections, and the condition
is stable under pullback along an arbitrary morphism of algebraic spaces.

This is the size condition under which the first assertion of Stacks 08K6 holds in a
size-bounded big fppf site: for a free module `𝒪^(I)` with `I` at least as large as the cutoff
of the site, the relative Hom functor `Hom(𝒪^(I), 𝒪)` is `T ↦ Γ(T, 𝒪_T)^I`, which no object of
the site represents.

## Main definitions

* `AlgebraicGeometry.Space.IsEtaleLocallyGeneratedBelow`: `F` is étale-locally generated by fewer
  than `κ` sections.

## Main results

* `AlgebraicGeometry.Space.IsEtaleLocallyGeneratedBelow.mono`: the condition is monotone in `κ`.
* `AlgebraicGeometry.Space.IsEtaleLocallyGeneratedBelow.modulePullback`: **the condition is
  stable under pullback** along an arbitrary morphism of algebraic spaces.
* `AlgebraicGeometry.Space.isEtaleLocallyGeneratedBelow_aleph0_of_isFiniteTypeOnSite`: **a module
  of finite type is étale-locally generated by fewer than `ℵ₀` sections**, and
  `AlgebraicGeometry.Space.exists_isEtaleLocallyGeneratedBelow_lt_cutoff_of_isFiniteTypeOnSite`
  the form with a bound below the cutoff of the site.
* `AlgebraicGeometry.Space.generatingSectionsModulePullbackChartToSpace`: generating sections of
  the restriction of a module to the slice at an étale chart are generating sections of its
  pullback to the chart space, with the same index type.

## Implementation notes

The étale neighbourhoods are algebraic spaces with an étale morphism to `X`, not the objects of
the small étale site of `X`: the generators are global sections of the pullback `vᵢ^*F` of
Stacks 03LU.  This is what makes stability under pullback formal: along `g : X' ⟶ X` the family
is base changed to `Vᵢ ×_X X' ⟶ X'`, which is étale by Stacks 03FU and jointly surjective by
Stacks 03H4, and the generators are carried along the pullback of modules, which preserves
colimits and the structure sheaf, with the same index type.  A module of finite type is
generated by finitely many sections on the members of a family of étale charts covering the
final object of the small étale site (Mathlib's `SheafOfModules.IsFiniteType`), and the
comparison of Stacks 04M0 reads those as generating sections of the pullbacks to the chart
spaces.

## References

* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03DO](https://stacks.math.columbia.edu/tag/03DO)
* [Stacks Project, Tag 03FU](https://stacks.math.columbia.edu/tag/03FU)
* [Stacks Project, Tag 03H4](https://stacks.math.columbia.edu/tag/03H4)
* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
* [Stacks Project, Tag 08K6](https://stacks.math.columbia.edu/tag/08K6)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Cardinal

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **An `𝒪_X`-module étale-locally generated by fewer than `κ` sections**: there is a jointly
surjective family of étale morphisms `vᵢ : Vᵢ ⟶ X` of algebraic spaces such that each pullback
`vᵢ^*F` is generated by a family of fewer than `κ` global sections. -/
def IsEtaleLocallyGeneratedBelow (κ : Cardinal.{u}) {X : AlgebraicSpaces B S hS}
    (F : Modules.{u, u} B S hS X.1 X.2) : Prop :=
  ∃ (ι : Type (u + 1)) (V : ι → AlgebraicSpaces B S hS) (v : ∀ i, V i ⟶ X),
    (∀ i, IsEtale B S hS (v i).hom) ∧
      IsJointlySurjective B S hS (fun i ↦ (V i).1) (fun i ↦ (v i).hom) ∧
        ∀ i, ∃ σ : ((modulePullback B S hS (v i)).obj F).GeneratingSections, #σ.I < κ

variable {B S hS}

/-- Pullbacks of presheaves on the big fppf site (instance search times out without this
shortcut). -/
local instance (priority := high) hasPullback_presheaf_EtaleLocalGenerationBound
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

/-- Being étale-locally generated by fewer than `κ` sections is monotone in `κ`. -/
theorem IsEtaleLocallyGeneratedBelow.mono {κ κ' : Cardinal.{u}} (hκ : κ ≤ κ')
    {X : AlgebraicSpaces B S hS} {F : Modules.{u, u} B S hS X.1 X.2}
    (h : IsEtaleLocallyGeneratedBelow B S hS κ F) : IsEtaleLocallyGeneratedBelow B S hS κ' F := by
  obtain ⟨ι, V, v, hv, hs, hg⟩ := h
  exact ⟨ι, V, v, hv, hs, fun i ↦ (hg i).imp fun _ hσ ↦ hσ.trans_le hκ⟩

/-- **Generating sections transport along the pullback of modules of Stacks 03LU, with the same
index type.** -/
def generatingSectionsModulePullback {X Z : AlgebraicSpaces B S hS} (a : X ⟶ Z)
    {M : Modules.{u, u} B S hS Z.1 Z.2} (σ : M.GeneratingSections) :
    ((modulePullback B S hS a).obj M).GeneratingSections :=
  have := preservesColimitsOfSize_modulePullback B S hS a
  σ.map (modulePullback B S hS a) (modulePullbackUnitIso B S hS a).symm

/-- The sections `generatingSectionsModulePullback a σ` are indexed by the index type of `σ`. -/
@[simp]
theorem generatingSectionsModulePullback_I {X Z : AlgebraicSpaces B S hS} (a : X ⟶ Z)
    {M : Modules.{u, u} B S hS Z.1 Z.2} (σ : M.GeneratingSections) :
    (generatingSectionsModulePullback a σ).I = σ.I := rfl

/-- **Stability under pullback.**  If `F` is étale-locally generated by fewer than `κ` sections,
then so is its pullback `g^*F` along an arbitrary morphism `g : X' ⟶ X` of algebraic spaces. -/
theorem IsEtaleLocallyGeneratedBelow.modulePullback {κ : Cardinal.{u}}
    {X X' : AlgebraicSpaces B S hS} (g : X' ⟶ X) {F : Modules.{u, u} B S hS X.1 X.2}
    (h : IsEtaleLocallyGeneratedBelow B S hS κ F) :
    IsEtaleLocallyGeneratedBelow B S hS κ ((Space.modulePullback B S hS g).obj F) := by
  obtain ⟨ι, V, v, hv, hs, hg⟩ := h
  let P : ι → AlgebraicSpaces B S hS := fun i ↦ AlgebraicSpaces.fiberProduct B S hS (v i) g
  let p : ∀ i, P i ⟶ V i := fun i ↦ ObjectProperty.homMk (pullback.fst (v i).hom g.hom)
  let q : ∀ i, P i ⟶ X' := fun i ↦ ObjectProperty.homMk (pullback.snd (v i).hom g.hom)
  have sq : ∀ i, IsPullback (p i) (q i) (v i) g := fun i ↦
    AlgebraicSpaces.isPullback_fiberProduct B S hS (v i) g
  refine ⟨ι, P, q, fun i ↦ isEtale_of_isPullback B S hS (p i) (q i) (v i) g (sq i) (hv i), ?_, ?_⟩
  · rw [isJointlySurjective_iff] at hs ⊢
    intro x'
    obtain ⟨i, y, hy⟩ := hs (pointsMap B S hS X'.1 g.hom x')
    obtain ⟨w, -, hw⟩ := exists_point_of_isPullback B S hS (sq i) y x' hy
    exact ⟨i, w, hw⟩
  · intro i
    obtain ⟨σ, hσ⟩ := hg i
    let e : (Space.modulePullback B S hS (p i)).obj ((Space.modulePullback B S hS (v i)).obj F) ≅
        (Space.modulePullback B S hS (q i)).obj ((Space.modulePullback B S hS g).obj F) :=
      (modulePullbackCompIso B S hS (p i) (v i)).app F ≪≫
        eqToIso (congrArg (fun k ↦ (Space.modulePullback B S hS k).obj F) (sq i).w) ≪≫
        ((modulePullbackCompIso B S hS (q i) g).app F).symm
    exact ⟨SheafOfModules.GeneratingSections.equivOfIso e
      (generatingSectionsModulePullback (p i) σ), hσ⟩

variable (X : AlgebraicSpaces B S hS)

/-- **Generating sections on the slice at an étale chart are generating sections on the chart
space.**  If the restriction of an `𝒪_X`-module `M` to the slice of the small étale site at an
étale scheme chart `W` is generated by a family of global sections, then so is its pullback of
Stacks 03LU along the structure morphism of `W`, by a family with the same index type. -/
def generatingSectionsModulePullbackChartToSpace
    (M : SheafOfModules.{u} (structureRingSheaf B S hS X)) (W : SmallEtale B S hS X.1)
    (σ : (M.over W).GeneratingSections) :
    ((modulePullback B S hS (chartToSpace B S hS X W)).obj M).GeneratingSections :=
  let E := @Stacks.SheafOfModules.reindexEquivalence _ _ _ _ _
    (SmallEtale.topology B S hS (chartSpace B S hS X W).1)
    (SmallEtale.chartLocalizationEquivalence B S hS X.1 W)
    (isContinuous_chartLocalization_chartSpace B S hS X W)
    (isContinuous_chartLocalizationInverse_chartSpace B S hS X W)
    ((structureRingSheaf B S hS X).over W)
  have key : E.functor.obj (M.over W) ≅
      (etaleModulePullback B S hS (chartToSpace B S hS X W)
        (isEtale_chartToSpace B S hS X W)).obj M :=
    (SheafOfModules.fullyFaithfulForget _).preimageIso
      (PresheafOfModules.isoMk (fun _ => Iso.refl _) (by intro A A' a; ext x; rfl))
  SheafOfModules.GeneratingSections.equivOfIso
    (key ≪≫ ((modulePullbackIsoEtaleModulePullback B S hS (chartToSpace B S hS X W)
      (isEtale_chartToSpace B S hS X W)).app M).symm)
    (σ.map E.functor (Iso.refl _))

/-- The sections `generatingSectionsModulePullbackChartToSpace X M W σ` are indexed by the index
type of `σ`. -/
@[simp]
theorem generatingSectionsModulePullbackChartToSpace_I
    (M : SheafOfModules.{u} (structureRingSheaf B S hS X)) (W : SmallEtale B S hS X.1)
    (σ : (M.over W).GeneratingSections) :
    (generatingSectionsModulePullbackChartToSpace X M W σ).I = σ.I := rfl

/-- **A module of finite type is étale-locally generated by fewer than `ℵ₀` sections.** -/
theorem isEtaleLocallyGeneratedBelow_aleph0_of_isFiniteTypeOnSite
    (F : Modules.{u, u} B S hS X.1 X.2) (hF : SheafOfModules.IsFiniteTypeOnSite F) :
    IsEtaleLocallyGeneratedBelow B S hS ℵ₀ F := by
  have hft : SheafOfModules.IsFiniteType F :=
    Stacks.SheafOfModules.isFiniteType_of_isFiniteTypeOnSite F hF
  obtain ⟨σ, hσ⟩ := hft.exists_localGeneratorsData
  refine ⟨σ.I, fun i ↦ chartSpace B S hS X (σ.X i), fun i ↦ chartToSpace B S hS X (σ.X i),
    fun i ↦ isEtale_chartToSpace B S hS X (σ.X i), ?_, fun i ↦ ?_⟩
  · rw [isJointlySurjective_iff]
    intro y
    obtain ⟨i, z, hz⟩ := exists_mem_range_chartSchemeToPoints_of_coversTop B S hS X σ.coversTop y
    refine ⟨i, (pointsEquivScheme B S hS ((SmallEtale.toOver B S hS X.1).obj (σ.X i))).symm z, ?_⟩
    exact (chartSchemeToPoints_eq_pointsMap_pointsEquivScheme_symm B S hS X.1 (σ.X i) z).symm.trans
      hz
  · have : Finite (σ.generators i).I := (hσ.isFiniteType i).finite
    exact ⟨generatingSectionsModulePullbackChartToSpace X F (σ.X i) (σ.generators i),
      Cardinal.lt_aleph0_of_finite (σ.generators i).I⟩

/-- **A module of finite type is étale-locally generated by a number of sections bounded below
the cutoff of the site**, namely fewer than `ℵ₀`. -/
theorem exists_isEtaleLocallyGeneratedBelow_lt_cutoff_of_isFiniteTypeOnSite
    (F : Modules.{u, u} B S hS X.1 X.2) (hF : SheafOfModules.IsFiniteTypeOnSite F) :
    ∃ μ < B.cutoff, IsEtaleLocallyGeneratedBelow B S hS μ F :=
  ⟨ℵ₀, B.aleph0_lt_cutoff, isEtaleLocallyGeneratedBelow_aleph0_of_isFiniteTypeOnSite X F hF⟩

/-- **Generating sections on the chart space are generating sections on the slice at the
chart.**  The converse of `AlgebraicGeometry.Space.generatingSectionsModulePullbackChartToSpace`:
if the pullback of Stacks 03LU of an `𝒪_X`-module `M` along the structure morphism of an étale
chart `W` is generated by a family of global sections, then so is the restriction of `M` to the
slice at `W`, by a family with the same index type. -/
def generatingSectionsOverOfModulePullbackChartToSpace
    (M : SheafOfModules.{u} (structureRingSheaf B S hS X)) (W : SmallEtale B S hS X.1)
    (σ : ((modulePullback B S hS (chartToSpace B S hS X W)).obj M).GeneratingSections) :
    (M.over W).GeneratingSections :=
  let E := @Stacks.SheafOfModules.reindexEquivalence _ _ _ _ _
    (SmallEtale.topology B S hS (chartSpace B S hS X W).1)
    (SmallEtale.chartLocalizationEquivalence B S hS X.1 W)
    (isContinuous_chartLocalization_chartSpace B S hS X W)
    (isContinuous_chartLocalizationInverse_chartSpace B S hS X W)
    ((structureRingSheaf B S hS X).over W)
  have key : E.functor.obj (M.over W) ≅
      (etaleModulePullback B S hS (chartToSpace B S hS X W)
        (isEtale_chartToSpace B S hS X W)).obj M :=
    (SheafOfModules.fullyFaithfulForget _).preimageIso
      (PresheafOfModules.isoMk (fun _ => Iso.refl _) (by intro A A' a; ext x; rfl))
  let σ' : (E.functor.obj (M.over W)).GeneratingSections :=
    SheafOfModules.GeneratingSections.equivOfIso
      (key ≪≫ ((modulePullbackIsoEtaleModulePullback B S hS (chartToSpace B S hS X W)
        (isEtale_chartToSpace B S hS X W)).app M).symm).symm σ
  SheafOfModules.GeneratingSections.equivOfIso (E.unitIso.app (M.over W)).symm
    (σ'.map E.inverse (E.unitIso.app (SheafOfModules.unit _)))

/-- The sections `generatingSectionsOverOfModulePullbackChartToSpace X M W σ` are indexed by the
index type of `σ`. -/
@[simp]
theorem generatingSectionsOverOfModulePullbackChartToSpace_I
    (M : SheafOfModules.{u} (structureRingSheaf B S hS X)) (W : SmallEtale B S hS X.1)
    (σ : ((modulePullback B S hS (chartToSpace B S hS X W)).obj M).GeneratingSections) :
    (generatingSectionsOverOfModulePullbackChartToSpace X M W σ).I = σ.I := rfl

/-- **A module étale-locally generated by fewer than `κ` sections is generated by fewer than `κ`
sections on the members of a family of étale charts covering the final object of the small étale
site.** -/
theorem exists_coversTop_generatingSections_of_isEtaleLocallyGeneratedBelow {κ : Cardinal.{u}}
    (F : Modules.{u, u} B S hS X.1 X.2) (h : IsEtaleLocallyGeneratedBelow B S hS κ F) :
    ∃ (K : Type (u + 1)) (W : K → SmallEtale B S hS X.1),
      (SmallEtale.topology B S hS X.1).CoversTop W ∧
        ∀ k, ∃ σ : (SheafOfModules.over (R := structureRingSheaf B S hS X) F
          (W k)).GeneratingSections, #σ.I < κ := by
  obtain ⟨ι, V, v, hv, hsurj, hg⟩ := h
  choose U a has hae using fun i => (V i).2.exists_atlas
  have hchart : ∀ i, IsEtaleChart B S hS X.1 (CostructuredArrow.mk (a i ≫ (v i).hom)) := fun i =>
    (isEtale_iff_presheaf_of_yoneda B S hS _).1
      (isEtale_comp B S hS ((isEtale_iff_presheaf_of_yoneda B S hS _).2 (hae i)) (hv i))
  let W : ι → SmallEtale B S hS X.1 := fun i => ⟨CostructuredArrow.mk (a i ≫ (v i).hom), hchart i⟩
  refine ⟨ι, W, SmallEtale.coversTop_of_jointlySurjective B S hS X.1 W fun x => ?_, fun i => ?_⟩
  · rw [isJointlySurjective_iff] at hsurj
    obtain ⟨i, y, rfl⟩ := hsurj x
    obtain ⟨z, rfl⟩ := isSurjective_of_presheafSurjective B S hS (a i) (has i) y
    exact ⟨i, z, pointsMap_comp_apply B S hS (a i) (v i).hom z⟩
  · obtain ⟨σ, hσ⟩ := hg i
    let a' : chartSpace B S hS X (W i) ⟶ V i := ObjectProperty.homMk (a i)
    have ha' : a' ≫ v i = chartToSpace B S hS X (W i) := ObjectProperty.hom_ext _ rfl
    let e : (modulePullback B S hS a').obj ((modulePullback B S hS (v i)).obj F) ≅
        (modulePullback B S hS (chartToSpace B S hS X (W i))).obj F :=
      ((modulePullbackCompIso B S hS a' (v i)).app F) ≪≫
        eqToIso (congrArg (fun k => (modulePullback B S hS k).obj F) ha')
    exact ⟨generatingSectionsOverOfModulePullbackChartToSpace X F (W i)
      (SheafOfModules.GeneratingSections.equivOfIso e (generatingSectionsModulePullback a' σ)), hσ⟩

end AlgebraicGeometry.Space

end
