/-!
# An affine unit locus of a global function is quasi-finite over the base

Let `f : Y ⟶ h_T` be a universally closed morphism, locally of finite type, from an algebraic
space to an object of the big fppf site with affine underlying scheme, and let `g` be a global
regular function on `Y`.  If the open subspace of `Y` where `g` is invertible is the image of an
open immersion `u : h_W ⟶ Y` from an affine scheme `W`, then the morphism of schemes `W ⟶ T`
is locally quasi-finite.

The argument: let `A = Γ(T, ⊤)` and let `C` be the `A`-subalgebra of `Γ(Y, 𝒪_Y)` generated by
`g`, presented as a quotient of `A[x]`.  The construction behind Stacks 0A0Q
(`AlgebraicGeometry.Space.isIntegral_of_universallyClosed_of_injective_of_finiteType`) gives a
universally closed `π : Y ⟶ Spec C` over `T`, with `Spec C ⟶ T` finite.  On an affine chart the
preimage of the basic open `D(t)` of the class `t` of `x` is the basic open of `g`, so by
hypothesis `h_W` and `Y ×_{Spec C} D(t)` are two open subspaces of `Y` with the same points,
hence equal.  Thus `W ⟶ D(t)` is a base change of `π`, so universally closed; it is affine
since `W` is affine, hence integral, and of finite type since `W ⟶ T` is, hence finite.  The
composite `W ⟶ D(t) ⟶ Spec C ⟶ T` of a finite morphism, an open immersion and a finite morphism
is locally quasi-finite.

## Main results

* `AlgebraicGeometry.Space.exists_universallyClosed_specModel`: the spectrum of a finite-type
  model `C` of the global functions of a universally closed algebraic space over an affine base,
  as an object of the site, with the universally closed morphism to it and its chart formula.
* `AlgebraicGeometry.Space.exists_universallyClosed_basicOpen_model`: the same for the subring
  generated by one global function, with the basic open of the generator.
* `AlgebraicGeometry.Space.universallyClosed_toScheme_map_of_range_eq_preimage`: an open
  immersion whose points are the preimage of an open of the target of a universally closed
  morphism inherits universal closedness over that open.
* `AlgebraicGeometry.Space.locallyQuasiFinite_of_isAffine_unitLocus`: the result.

## Implementation notes

The proof is split into several declarations only to keep each one within the default
heartbeat budget.

## References

* [Stacks Project, Tag 0A0Q](https://stacks.math.columbia.edu/tag/0A0Q)
* [Stacks Project, Tag 0D1R](https://stacks.math.columbia.edu/tag/0D1R)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

/-- Pullbacks of presheaves on the big fppf site (instance search times out without this
shortcut). -/
local instance (priority := high) hasPullback_presheaf_affineUnitLocusQuasiFinite
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {P Q R : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : P ⟶ R) (g : Q ⟶ R) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The scheme underlying an object of the big fppf site, as a functor. -/
local notation "𝔉" => BigFppfOver.toScheme B S hS

/-- **The spectrum of a finite-type model of the global functions, as a scheme of the site.**
Let `p : W ⟶ V` be a universally closed morphism from an algebraic space to an object of the
big fppf site with affine underlying scheme, and let `C` be a ring of finite type over
`Γ(V, ⊤)` (through `ρ`) injecting (through `κ`) into the global functions of `W`, compatibly
with pullback along `p`.  Then there are an object `Z` of the site with a morphism `z : Z ⟶ V`,
an isomorphism `e : Spec C ≅ Z` of schemes under which `z` is `Spec ρ`, and a universally closed
morphism `π : W ⟶ Z` lifting `p`, such that `z` is finite and, on every étale scheme chart `c`
of `W`, the morphism of schemes `c ⟶ Z` induced by `π` is the canonical morphism to `Spec C`
attached to `κ` restricted to `c`.

This is the construction inside
`AlgebraicGeometry.Space.isIntegral_of_universallyClosed_of_injective_of_finiteType`, exposed. -/
theorem exists_universallyClosed_specModel
    {W : AlgebraicSpaces B S hS} {V : BigFppfOver B S hS}
    (hV : IsAffine ((BigFppfOver.toScheme B S hS).obj V))
    (p : W.obj ⟶ yoneda.obj V) (huc : UniversallyClosed B S hS p)
    (C : Type u) [CommRing C]
    (ρ : Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) →+* C)
    (hρ : RingHom.FiniteType ρ)
    (κ : C →+* globalFunctions B S hS W.obj) (hκ : Function.Injective κ)
    (hcompat : ∀ c : SmallEtale B S hS W.obj,
      (globalFunctionsChartRestriction B S hS W c).comp (κ.comp ρ) =
        ((BigFppfOver.toScheme B S hS).map (smallEtaleChartMapToBase B S hS p c)).appTop.hom) :
    ∃ (Z : BigFppfOver B S hS) (z : Z ⟶ V)
      (e : Spec (CommRingCat.of C) ≅ (BigFppfOver.toScheme B S hS).obj Z)
      (π : W.obj ⟶ yoneda.obj Z),
      e.hom ≫ (BigFppfOver.toScheme B S hS).map z =
          Spec.map (CommRingCat.ofHom ρ) ≫ ((BigFppfOver.toScheme B S hS).obj V).isoSpec.inv ∧
        π ≫ yoneda.map z = p ∧ UniversallyClosed B S hS π ∧
        _root_.AlgebraicGeometry.IsFinite ((BigFppfOver.toScheme B S hS).map z) ∧
        ∀ (c : SmallEtale B S hS W.obj) (g : (SmallEtale.toOver B S hS W.obj).obj c ⟶ Z),
          yoneda.map g = c.obj.hom ≫ π →
          (BigFppfOver.toScheme B S hS).map g =
            specMapOfGlobalHom C ((globalFunctionsChartRestriction B S hS W c).comp κ) ≫
              e.hom := by
  have := hV
  let : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom ρ)) :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).2 hρ
  set zv : Spec (CommRingCat.of C) ⟶ (BigFppfOver.toScheme B S hS).obj V :=
    Spec.map (CommRingCat.ofHom ρ) ≫ ((BigFppfOver.toScheme B S hS).obj V).isoSpec.inv
    with hzvdef
  have : LocallyOfFiniteType zv := by rw [hzvdef]; infer_instance
  have hzvaff : _root_.AlgebraicGeometry.IsAffineHom zv := by rw [hzvdef]; infer_instance
  obtain ⟨Z, z, e, he⟩ := exists_siteObject_of_locallyOfFiniteType B S hS zv
  have hzeq : (BigFppfOver.toScheme B S hS).map z = e.inv ≫ zv := by
    rw [← he, ← Category.assoc, e.inv_hom_id, Category.id_comp]
  have : _root_.AlgebraicGeometry.IsAffineHom ((BigFppfOver.toScheme B S hS).map z) := by
    rw [hzeq]; infer_instance
  have hsep : IsSeparated B S hS (yoneda.map z) :=
    (isSeparated_yoneda_map_iff B S hS z).2 (AlgebraicGeometry.IsSeparated.of_isAffineHom _)
  -- the canonical morphism to the spectrum
  obtain ⟨π₀, hπ₀⟩ := exists_specMap_of_globalHom B S hS W C κ
  -- an affine surjective étale chart of `W`
  have hWqc : IsQuasiCompactSpace B S hS W.obj :=
    isQuasiCompactSpace_of_universallyClosed_of_isAffine B S hS V hV W.property
      (isAlgebraicSpace_yoneda B S hS V) p huc
  obtain ⟨c₀, hc₀aff, hc₀surj, hc₀etale⟩ :
      ∃ c : SmallEtale B S hS W.obj,
        IsAffine ((BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS W.obj).obj c)) ∧
          (MorphismProperty.inverseImage (@AlgebraicGeometry.Surjective.{u})
            (BigFppfOver.toScheme B S hS)).presheaf c.obj.hom ∧
          (MorphismProperty.inverseImage (@AlgebraicGeometry.Etale.{u})
            (BigFppfOver.toScheme B S hS)).presheaf c.obj.hom := by
    obtain ⟨P, a, hPaff, haSurj, haEtale⟩ :=
      (isQuasiCompactSpace_iff_exists_affine_etale_surjective_cover B S hS W.obj
        W.property).1 hWqc
    exact ⟨chartFromEtaleHom B S hS W P a (presheaf_etale_of_isEtale B S hS haEtale), hPaff,
      haSurj, presheaf_etale_of_isEtale B S hS haEtale⟩
  have := hc₀aff
  set χ : C →+* Γ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS W.obj).obj c₀), ⊤) :=
    (globalFunctionsChartRestriction B S hS W c₀).comp κ with hχdef
  have hχinj : Function.Injective χ :=
    (injective_globalFunctionsChartRestriction_of_isSurjective B S hS W c₀
      ((presheafSurjective_iff_isSurjective_yoneda B S hS W.obj W.property _
        c₀.obj.hom).1 hc₀surj)).comp hκ
  -- the chart value of the canonical morphism, composed with `Spec C ⟶ V`
  have hchart : specMapOfGlobalHom C χ ≫ zv =
      (BigFppfOver.toScheme B S hS).map (smallEtaleChartMapToBase B S hS p c₀) := by
    rw [hzvdef]
    refine specMapOfGlobalHom_comp_specMap_comp_isoSpec_inv ρ χ _ ?_
    rw [← hcompat c₀, hχdef]
    rfl
  -- a point of the chart, read in the functor of points of a scheme
  have hpt : ∀ {P T : BigFppfOver B S hS} (g : P ⟶ T),
      yonedaEquiv (yoneda.map g ≫ yonedaToSchemePoints B S hS T) =
        (BigFppfOver.toScheme B S hS).map g := fun g => by
    rw [yonedaEquiv_comp, yonedaEquiv_yoneda_map]
    exact yonedaToSchemePoints_app B S hS _ _ g
  -- the canonical morphism on a chart, followed by a morphism out of `Spec C`
  have hchartπ : ∀ (c : SmallEtale B S hS W.obj) {T : Scheme.{u}}
      (f : Spec (CommRingCat.of C) ⟶ T),
      yonedaEquiv (c.obj.hom ≫ π₀ ≫ schemePointsMap B S hS f) =
        specMapOfGlobalHom C ((globalFunctionsChartRestriction B S hS W c).comp κ) ≫ f :=
    fun c _ f => by
    rw [← Category.assoc, yonedaEquiv_comp_schemePointsMap]
    exact congrArg (fun k => k ≫ f) (hπ₀ c)
  -- the canonical morphism agrees with `p` after `Spec C ⟶ V`
  have hEq : π₀ ≫ schemePointsMap B S hS zv = p ≫ yonedaToSchemePoints B S hS V := by
    refine hom_ext_of_etale_atlas B S hS W.property.isSheaf
      (isSheaf_schemePoints B S hS ((BigFppfOver.toScheme B S hS).obj V)) c₀.obj.hom hc₀surj
      hc₀etale ?_
    refine yonedaEquiv.injective ((hchartπ c₀ zv).trans (hchart.trans ?_))
    rw [← Category.assoc, ← yoneda_map_smallEtaleChartMapToBase B S hS p c₀, hpt]
  -- the canonical morphism, read as a morphism into the site object
  have hq : ∀ (U : (BigFppfOver B S hS)ᵒᵖ) (w : W.obj.obj U),
      (π₀ ≫ schemePointsMap B S hS e.hom).app U w ≫ (BigFppfOver.toScheme B S hS).map z =
        (BigFppfOver.toScheme B S hS).map (p.app U w) := by
    intro U w
    have h1 : (π₀ ≫ schemePointsMap B S hS e.hom).app U w = π₀.app U w ≫ e.hom := rfl
    rw [h1, Category.assoc, he]
    exact ConcreteCategory.congr_hom (NatTrans.congr_app hEq U) w
  set π := liftToYoneda B S hS (π₀ ≫ schemePointsMap B S hS e.hom) z p hq with hπdef
  have hπz : π ≫ yoneda.map z = p :=
    liftToYoneda_comp_yoneda_map B S hS (π₀ ≫ schemePointsMap B S hS e.hom) z p hq
  have hπ0 : π ≫ yonedaToSchemePoints B S hS Z = π₀ ≫ schemePointsMap B S hS e.hom :=
    liftToYoneda_comp_yonedaToSchemePoints B S hS (π₀ ≫ schemePointsMap B S hS e.hom) z p hq
  have hgs : ∀ (c : SmallEtale B S hS W.obj) (g : (SmallEtale.toOver B S hS W.obj).obj c ⟶ Z),
      yoneda.map g = c.obj.hom ≫ π →
      (BigFppfOver.toScheme B S hS).map g =
        specMapOfGlobalHom C ((globalFunctionsChartRestriction B S hS W c).comp κ) ≫
          e.hom := by
    intro c g hg
    rw [← hpt, hg, Category.assoc, hπ0, ← hchartπ]
  obtain ⟨g, hg⟩ : ∃ g : (SmallEtale.toOver B S hS W.obj).obj c₀ ⟶ Z,
      yoneda.map g = c₀.obj.hom ≫ π := ⟨yoneda.preimage _, yoneda.map_preimage _⟩
  -- the chart has dense image in `Spec C`
  have hdense : DenseRange ((BigFppfOver.toScheme B S hS).map g).base := by
    rw [hgs c₀ g hg]
    exact ((Scheme.Hom.surjective e.hom).denseRange).comp
      (denseRange_base_specMapOfGlobalHom χ hχinj) e.hom.base.hom.continuous
  -- the canonical morphism is universally closed and surjective
  have hπuc : UniversallyClosed B S hS π :=
    universallyClosed_of_comp_of_isSeparated B S hS W.property
      (isAlgebraicSpace_yoneda B S hS Z) (isAlgebraicSpace_yoneda B S hS V) π (yoneda.map z)
      (by rw [hπz]; exact huc) hsep
  have hsurjπ : IsSurjective B S hS π :=
    isSurjective_of_universallyClosed_of_denseRange B S hS π hπuc c₀.obj.hom g hg hdense
  have huczs : AlgebraicGeometry.UniversallyClosed ((BigFppfOver.toScheme B S hS).map z) :=
    universallyClosed_toScheme_map_of_isSurjective B S hS p huc z π hπz hsurjπ
  have : LocallyOfFiniteType ((BigFppfOver.toScheme B S hS).map z) := by
    rw [hzeq]; infer_instance
  have hint : _root_.AlgebraicGeometry.IsIntegralHom ((BigFppfOver.toScheme B S hS).map z) :=
    _root_.AlgebraicGeometry.IsIntegralHom.iff_universallyClosed_and_isAffineHom.2
      ⟨huczs, inferInstance⟩
  exact ⟨Z, z, e, π, he, hπz, hπuc,
    (_root_.AlgebraicGeometry.IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).2
      ⟨hint, inferInstance⟩, hgs⟩

/-- **The basic open of a global function on the spectrum of the subring it generates.**  Let
`f : Y ⟶ h_T` be universally closed with `T` affine and let `g` be a global function on `Y`.
There are an object `Z` of the site, finite over `T` and with affine underlying scheme, a
universally closed morphism `π : Y ⟶ h_Z` over `T`, and an open `O` of the scheme of `Z`, such
that on every étale scheme chart `c` of `Y` the preimage of `O` under the induced morphism
`c ⟶ Z` is the basic open of `g` restricted to `c`.

Here `Z` is the spectrum of the `Γ(T, ⊤)`-subalgebra `C` generated by `g`, and `O` is the basic
open of the generator. -/
theorem exists_universallyClosed_basicOpen_model {Y : AlgebraicSpaces B S hS}
    {T : BigFppfOver B S hS} (hT : IsAffine ((𝔉).obj T))
    (f : Y.1 ⟶ yoneda.obj T) (huc : UniversallyClosed B S hS f)
    (g : globalFunctions B S hS Y.1) :
    ∃ (Z : BigFppfOver B S hS) (z : Z ⟶ T) (π : Y.1 ⟶ yoneda.obj Z) (O : ((𝔉).obj Z).Opens),
      π ≫ yoneda.map z = f ∧ UniversallyClosed B S hS π ∧
        _root_.AlgebraicGeometry.IsFinite ((𝔉).map z) ∧ IsAffine ((𝔉).obj Z) ∧
        ∀ (c : SmallEtale B S hS Y.1) (gc : (SmallEtale.toOver B S hS Y.1).obj c ⟶ Z),
          yoneda.map gc = c.obj.hom ≫ π → ∀ x : chartScheme c,
            (𝔉).map gc x ∈ O ↔
              x ∈ (chartScheme c).basicOpen (globalFunctionsChartRestriction B S hS Y c g) := by
  classical
  -- pullback of functions along `f`, and the subring generated by `g`
  set ψ := pullbackToGlobalFunctions B S hS Y T (ObjectProperty.homMk f) with hψdef
  have hψ : ∀ c : SmallEtale B S hS Y.1,
      (globalFunctionsChartRestriction B S hS Y c).comp ψ =
        ((𝔉).map (smallEtaleChartMapToBase B S hS f c)).appTop.hom := fun _ => rfl
  set φ : MvPolynomial (Fin 1) Γ((𝔉).obj T, ⊤) →+* globalFunctions B S hS Y.1 :=
    MvPolynomial.eval₂Hom ψ (fun _ => g) with hφdef
  set ρ : Γ((𝔉).obj T, ⊤) →+* MvPolynomial (Fin 1) Γ((𝔉).obj T, ⊤) ⧸ RingHom.ker φ :=
    (Ideal.Quotient.mk (RingHom.ker φ)).comp MvPolynomial.C with hρdef
  have hκρ : (RingHom.kerLift φ).comp ρ = ψ := by
    refine RingHom.ext fun r => ?_
    rw [RingHom.comp_apply, hρdef, RingHom.comp_apply, RingHom.kerLift_mk, hφdef]
    exact MvPolynomial.eval₂Hom_C ψ (fun _ => g) r
  have hCft : RingHom.FiniteType
      (MvPolynomial.C : Γ((𝔉).obj T, ⊤) →+* MvPolynomial (Fin 1) Γ((𝔉).obj T, ⊤)) := by
    rw [show (MvPolynomial.C : Γ((𝔉).obj T, ⊤) →+* MvPolynomial (Fin 1) Γ((𝔉).obj T, ⊤)) =
          algebraMap Γ((𝔉).obj T, ⊤) (MvPolynomial (Fin 1) Γ((𝔉).obj T, ⊤)) from
      (MvPolynomial.algebraMap_eq _ _).symm]
    exact RingHom.finiteType_algebraMap.2 inferInstance
  have hρft : RingHom.FiniteType ρ :=
    RingHom.FiniteType.comp_surjective hCft Ideal.Quotient.mk_surjective
  obtain ⟨Z, z, e, π, -, hπz, hπuc, hzfin, hchart⟩ :=
    exists_universallyClosed_specModel B S hS hT f huc _ ρ hρft (RingHom.kerLift φ)
      (RingHom.kerLift_injective φ) (by rw [hκρ]; exact hψ)
  obtain ⟨t, htdef⟩ : ∃ t : MvPolynomial (Fin 1) Γ((𝔉).obj T, ⊤) ⧸ RingHom.ker φ,
      t = Ideal.Quotient.mk (RingHom.ker φ) (MvPolynomial.X 0) := ⟨_, rfl⟩
  have hκt : RingHom.kerLift φ t = g := by
    rw [htdef, RingHom.kerLift_mk, hφdef, MvPolynomial.eval₂Hom_X']
  refine ⟨Z, z, π, e.inv ⁻¹ᵁ PrimeSpectrum.basicOpen t, hπz, hπuc, hzfin,
    IsAffine.of_isIso e.inv, fun c gc hgc x => ?_⟩
  have hx : e.inv ((𝔉).map gc x) = specMapOfGlobalHom _
      ((globalFunctionsChartRestriction B S hS Y c).comp (RingHom.kerLift φ)) x := by
    have h := hchart c gc hgc
    rw [← Scheme.Hom.comp_apply, h, Category.assoc, e.hom_inv_id, Category.comp_id]
  change e.inv ((𝔉).map gc x) ∈ PrimeSpectrum.basicOpen t ↔ _
  rw [hx, ← hκt, ← RingHom.comp_apply (globalFunctionsChartRestriction B S hS Y c),
    ← Scheme.toSpecΓ_preimage_basicOpen, specMapOfGlobalHom, Scheme.Hom.comp_apply]
  exact Iff.rfl

/-- **Reading an open subspace off one affine surjective chart.**  Let `f : Y ⟶ h_T` be
universally closed with `T` affine, and let `π : Y ⟶ h_Z` be a morphism to an object of the
site together with an open `O` of the scheme of `Z` whose preimage on every étale chart is the
basic open of a global function `g`.  If the image of `u : h_W ⟶ Y` is, on every affine chart,
the basic open of `g`, then a point of `Y` lies in the image of `u` exactly when its image in
`Z` lies in `O`. -/
theorem mem_range_pointsMap_iff_of_chart_basicOpen {Y : AlgebraicSpaces B S hS}
    {T : BigFppfOver B S hS} (hT : IsAffine ((𝔉).obj T))
    (f : Y.1 ⟶ yoneda.obj T) (huc : UniversallyClosed B S hS f)
    (g : globalFunctions B S hS Y.1) {Z : BigFppfOver B S hS} (π : Y.1 ⟶ yoneda.obj Z)
    (O : ((𝔉).obj Z).Opens)
    (hO : ∀ (c : SmallEtale B S hS Y.1) (gc : (SmallEtale.toOver B S hS Y.1).obj c ⟶ Z),
      yoneda.map gc = c.obj.hom ≫ π → ∀ x : chartScheme c,
        (𝔉).map gc x ∈ O ↔
          x ∈ (chartScheme c).basicOpen (globalFunctionsChartRestriction B S hS Y c g))
    (W : BigFppfOver B S hS) (u : yoneda.obj W ⟶ Y.1)
    (hpts : ∀ c : SmallEtale B S hS Y.1, IsAffine (chartScheme c) →
      chartPointsMap c ⁻¹' Set.range (pointsMap B S hS (yoneda.obj W) u) =
        ((chartScheme c).basicOpen (globalFunctionsChartRestriction B S hS Y c g) : Set _))
    (y : points B S hS Y.1) :
    y ∈ Set.range (pointsMap B S hS (yoneda.obj W) u) ↔
      pointsToScheme B S hS Z (pointsMap B S hS Y.1 π y) ∈ O := by
  -- an affine surjective étale chart of `Y`
  have hYqc : IsQuasiCompactSpace B S hS Y.obj :=
    isQuasiCompactSpace_of_universallyClosed_of_isAffine B S hS T hT Y.property
      (isAlgebraicSpace_yoneda B S hS T) f huc
  obtain ⟨c₀, hc₀aff, hc₀surj⟩ :
      ∃ c : SmallEtale B S hS Y.obj, IsAffine (chartScheme c) ∧
          (MorphismProperty.inverseImage (@AlgebraicGeometry.Surjective.{u}) (𝔉)).presheaf
            c.obj.hom := by
    obtain ⟨P, a, hPaff, haSurj, haEtale⟩ :=
      (isQuasiCompactSpace_iff_exists_affine_etale_surjective_cover B S hS Y.obj
        Y.property).1 hYqc
    exact ⟨chartFromEtaleHom B S hS Y P a (presheaf_etale_of_isEtale B S hS haEtale), hPaff,
      haSurj⟩
  have hc₀s : IsSurjective B S hS c₀.obj.hom :=
    (presheafSurjective_iff_isSurjective_yoneda B S hS Y.obj Y.property _ c₀.obj.hom).1 hc₀surj
  obtain ⟨g₀, hg₀⟩ : ∃ g₀ : (SmallEtale.toOver B S hS Y.obj).obj c₀ ⟶ Z,
      yoneda.map g₀ = c₀.obj.hom ≫ π := ⟨yoneda.preimage _, yoneda.map_preimage _⟩
  obtain ⟨q, rfl⟩ := hc₀s y
  have hπq : pointsToScheme B S hS Z
      (pointsMap B S hS Y.1 π (pointsMap B S hS _ c₀.obj.hom q)) =
        (𝔉).map g₀ (pointsToScheme B S hS _ q) := by
    rw [← pointsToScheme_pointsMap_yoneda, hg₀, pointsMap_comp]
    rfl
  have hq : pointsMap B S hS _ c₀.obj.hom q =
      chartPointsMap c₀ (pointsToScheme B S hS _ q) := by
    change _ = pointsMap B S hS _ c₀.obj.hom
      ((schemePointsHomeomorph B S hS _).symm (schemePointsHomeomorph B S hS _ q))
    rw [Homeomorph.symm_apply_apply]
  rw [hπq, hO c₀ g₀ hg₀, hq, ← Set.mem_preimage, hpts c₀ hc₀aff]
  rfl

/-- **A morphism of the site landing in an open factors through the open subobject.**  If the
morphism of schemes underlying `m : W ⟶ Z` has image inside an open `O` of the scheme of `Z`,
then `m` factors through `AlgebraicGeometry.Space.opensSiteObjectInclusion`. -/
theorem exists_comp_opensSiteObjectInclusion_eq {W Z : BigFppfOver B S hS}
    (O : ((𝔉).obj Z).Opens) (m : W ⟶ Z)
    (hmO : Set.range ((𝔉).map m) ⊆ (O : Set ((𝔉).obj Z))) :
    ∃ k : W ⟶ opensSiteObject B S hS Z O, k ≫ opensSiteObjectInclusion B S hS Z O = m := by
  have hι : (𝔉).map (opensSiteObjectInclusion B S hS Z O) = O.ι :=
    map_opensSiteObjectInclusion B S hS Z O
  have hrO : Set.range ((𝔉).map m) ⊆ Set.range O.ι := by
    rw [Scheme.Opens.range_ι]; exact hmO
  obtain ⟨k₀, hk₀⟩ : ∃ k₀ : (𝔉).obj W ⟶ (𝔉).obj (opensSiteObject B S hS Z O),
      k₀ ≫ (𝔉).map (opensSiteObjectInclusion B S hS Z O) = (𝔉).map m := by
    let k₁ := _root_.AlgebraicGeometry.IsOpenImmersion.lift O.ι ((𝔉).map m) hrO
    have hk₁ : k₁ ≫ O.ι = (𝔉).map m := _root_.AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    exact ⟨k₁, (congrArg (fun φ => k₁ ≫ φ) hι).trans hk₁⟩
  have hk₀s : k₀ ≫ B.inclusion.map (opensSiteObject B S hS Z O).hom =
      B.inclusion.map W.hom := by
    rw [← BigFppfOver.toScheme_map_comp_structureHom B S hS
      (opensSiteObjectInclusion B S hS Z O), ← Category.assoc, hk₀,
      BigFppfOver.toScheme_map_comp_structureHom]
  exact ⟨homOfSchemeHom B S hS k₀ hk₀s,
    (𝔉).map_injective (by rw [Functor.map_comp, toScheme_map_homOfSchemeHom, hk₀])⟩

/-- The morphism of schemes underlying `AlgebraicGeometry.Space.opensSiteObjectInclusion` has
image inside the open it was built from. -/
theorem range_map_opensSiteObjectInclusion_subset {Z : BigFppfOver B S hS}
    (O : ((𝔉).obj Z).Opens) :
    Set.range ((𝔉).map (opensSiteObjectInclusion B S hS Z O)) ⊆ (O : Set ((𝔉).obj Z)) := by
  have h := range_map_comp_opensSiteObjectInclusion B S hS O (𝟙 _)
  rwa [Category.id_comp] at h

/-- **An open immersion whose image is the preimage of an open is a base change.**  Let
`π : Y ⟶ h_Z` be universally closed, `O` an open of the scheme of `Z`, and `u : h_W ⟶ Y` an
open immersion whose image contains every point mapping into `O`.  If `k : W ⟶ O` lifts
`π ∘ u` (so the points of `h_W` map into `O`), then the morphism of schemes underlying `k` is
universally closed: `h_W` is the base change of `π` along `h_O ⟶ h_Z`, since both are open
subspaces of `Y` with the same points. -/
theorem universallyClosed_toScheme_map_of_range_eq_preimage {Y : AlgebraicSpaces B S hS}
    {Z W : BigFppfOver B S hS} (π : Y.1 ⟶ yoneda.obj Z) (hπuc : UniversallyClosed B S hS π)
    (O : ((𝔉).obj Z).Opens) (u : yoneda.obj W ⟶ Y.1) (hu : IsOpenImmersion B S hS u)
    (hpre : ∀ y : points B S hS Y.1,
      pointsToScheme B S hS Z (pointsMap B S hS Y.1 π y) ∈ O →
        y ∈ Set.range (pointsMap B S hS (yoneda.obj W) u))
    (k : W ⟶ opensSiteObject B S hS Z O)
    (hk : yoneda.map k ≫ yoneda.map (opensSiteObjectInclusion B S hS Z O) = u ≫ π) :
    AlgebraicGeometry.UniversallyClosed ((𝔉).map k) := by
  have hιO := range_map_opensSiteObjectInclusion_subset B S hS O
  have hWa : IsAlgebraicSpace B S hS (yoneda.obj W) := isAlgebraicSpace_yoneda B S hS W
  have hZa : IsAlgebraicSpace B S hS (yoneda.obj Z) := isAlgebraicSpace_yoneda B S hS Z
  have hZta : IsAlgebraicSpace B S hS (yoneda.obj (opensSiteObject B S hS Z O)) :=
    isAlgebraicSpace_yoneda B S hS _
  have hPa : IsAlgebraicSpace B S hS
      (pullback (yoneda.map (opensSiteObjectInclusion B S hS Z O)) π) :=
    isAlgebraicSpace_pullback B S hS _ π hZta Y.property hZa
  have : _root_.AlgebraicGeometry.IsOpenImmersion
      ((𝔉).map (opensSiteObjectInclusion B S hS Z O)) := by
    have h : _root_.AlgebraicGeometry.IsOpenImmersion O.ι := inferInstance
    exact (map_opensSiteObjectInclusion B S hS Z O) ▸ h
  have : Mono (opensSiteObjectInclusion B S hS Z O) := (𝔉).mono_of_mono_map inferInstance
  have : Mono u := mono_of_isOpenImmersion B S hS u hu
  obtain ⟨n₀, hn₀⟩ := (factorsThrough_openSubspace_iff_points B S hS Y.property hPa
    (Subfunctor.range u) (isOpenSubspace_subfunctorRange B S hS hWa hu)
    (pullback.snd (yoneda.map (opensSiteObjectInclusion B S hS Z O)) π)).2 (by
      rintro _ ⟨p, rfl⟩
      have hy : pointsMap B S hS _ (pullback.snd _ π) p ∈
          Set.range (pointsMap B S hS (yoneda.obj W) u) := by
        refine hpre _ ?_
        have h2 := congrFun (pointsMap_comp B S hS _
          (pullback.fst (yoneda.map (opensSiteObjectInclusion B S hS Z O)) π)
          (yoneda.map (opensSiteObjectInclusion B S hS Z O))) p
        have h3 := congrFun (pointsMap_comp B S hS _
          (pullback.snd (yoneda.map (opensSiteObjectInclusion B S hS Z O)) π) π) p
        rw [pullback.condition] at h2
        rw [Function.comp_apply] at h2 h3
        rw [← h3, h2, pointsToScheme_pointsMap_yoneda]
        exact hιO ⟨_, rfl⟩
      obtain ⟨q, hq⟩ := hy
      refine ⟨pointsMap B S hS _ (Subfunctor.toRange u) q, ?_⟩
      rw [← hq, ← Function.comp_apply (f := pointsMap B S hS _ (Subfunctor.range u).ι),
        ← pointsMap_comp, Subfunctor.toRange_ι])
  have hrι : inv (Subfunctor.toRange u) ≫ u = (Subfunctor.range u).ι :=
    (IsIso.inv_comp_eq _).2 (Subfunctor.toRange_ι u).symm
  have hn : (n₀ ≫ inv (Subfunctor.toRange u)) ≫ u =
      pullback.snd (yoneda.map (opensSiteObjectInclusion B S hS Z O)) π := by
    rw [Category.assoc, hrι, hn₀]
  have hℓn : pullback.lift (yoneda.map k) u hk ≫ n₀ ≫ inv (Subfunctor.toRange u) = 𝟙 _ := by
    rw [← cancel_mono u, Category.assoc, hn, pullback.lift_snd, Category.id_comp]
  have hnℓ : (n₀ ≫ inv (Subfunctor.toRange u)) ≫ pullback.lift (yoneda.map k) u hk = 𝟙 _ := by
    apply pullback.hom_ext
    · rw [← cancel_mono (yoneda.map (opensSiteObjectInclusion B S hS Z O))]
      simp only [Category.assoc, Category.id_comp, pullback.lift_fst_assoc]
      rw [hk, ← Category.assoc, ← Category.assoc, hn, pullback.condition]
    · rw [Category.assoc, pullback.lift_snd, hn, Category.id_comp]
  have : IsIso (pullback.lift (yoneda.map k) u hk) := ⟨⟨_, hℓn, hnℓ⟩⟩
  have hkuc : UniversallyClosed B S hS (yoneda.map k) := by
    have h := universallyClosed_comp B S hS hPa hZta (pullback.lift (yoneda.map k) u hk)
      (pullback.fst (yoneda.map (opensSiteObjectInclusion B S hS Z O)) π)
      (universallyClosed_of_isIso B S hS _)
      (universallyClosed_pullback B S hS π _ hπuc)
    rwa [pullback.lift_fst] at h
  exact (presheaf_yoneda_map_iff B S hS (P := @AlgebraicGeometry.UniversallyClosed.{u})
      inferInstance k).mp
    ((presheaf_universallyClosed_iff B S hS hWa hZta
      (Functor.relativelyRepresentable.map yoneda k)).mpr hkuc)

/-- Let `f : Y ⟶ h_T` be universally closed and locally of finite type with `T` affine, and let
`g` be a global regular function on `Y`. If the open subspace of `Y` on which `g` is invertible
is the image of an open immersion `u : h_W ⟶ Y` from an affine scheme `W`, then
`W ⟶ T` is locally quasi-finite. -/
theorem locallyQuasiFinite_of_isAffine_unitLocus {Y : AlgebraicSpaces B S hS}
    {T : BigFppfOver B S hS} (hT : IsAffine ((BigFppfOver.toScheme B S hS).obj T))
    (f : Y.1 ⟶ yoneda.obj T) (huc : UniversallyClosed B S hS f)
    (hft : IsLocallyOfFiniteType B S hS f)
    (g : globalFunctions B S hS Y.1)
    (W : BigFppfOver B S hS) (hW : IsAffine ((BigFppfOver.toScheme B S hS).obj W))
    (u : yoneda.obj W ⟶ Y.1) (hu : IsOpenImmersion B S hS u)
    (hpts : ∀ c : SmallEtale B S hS Y.1, IsAffine (chartScheme c) →
      chartPointsMap c ⁻¹' Set.range (pointsMap B S hS (yoneda.obj W) u) =
        ((chartScheme c).basicOpen (globalFunctionsChartRestriction B S hS Y c g) : Set _))
    (w : W ⟶ T) (hw : yoneda.map w = u ≫ f) :
    LocallyQuasiFinite ((BigFppfOver.toScheme B S hS).map w) := by
  have := hW
  obtain ⟨Z, z, π, O, hπz, hπuc, hzfin, hZaff, hO⟩ :=
    exists_universallyClosed_basicOpen_model B S hS hT f huc g
  have hkey := mem_range_pointsMap_iff_of_chart_basicOpen B S hS hT f huc g π O hO W u hpts
  -- the morphism `W ⟶ Z` and its factorization through `O`
  obtain ⟨m, hm⟩ : ∃ m : W ⟶ Z, yoneda.map m = u ≫ π :=
    ⟨yoneda.preimage _, yoneda.map_preimage _⟩
  have hmw : m ≫ z = w :=
    yoneda.map_injective (by rw [Functor.map_comp, hm, Category.assoc, hπz, hw])
  have hmO : Set.range ((𝔉).map m) ⊆ (O : Set ((𝔉).obj Z)) := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨q, rfl⟩ := surjective_pointsToScheme B S hS W x
    rw [← pointsToScheme_pointsMap_yoneda, hm, pointsMap_comp]
    exact (hkey _).1 ⟨q, rfl⟩
  obtain ⟨k, hkι⟩ := exists_comp_opensSiteObjectInclusion_eq B S hS O m hmO
  have hkucs := universallyClosed_toScheme_map_of_range_eq_preimage B S hS π hπuc O u hu
    (fun y hy => (hkey y).2 hy) k
    (by rw [← Functor.map_comp, hkι, hm])
  -- `W ⟶ O` is finite, and so is `Z ⟶ T`
  have : _root_.AlgebraicGeometry.IsOpenImmersion
      ((𝔉).map (opensSiteObjectInclusion B S hS Z O)) := by
    have h : _root_.AlgebraicGeometry.IsOpenImmersion O.ι := inferInstance
    exact (map_opensSiteObjectInclusion B S hS Z O) ▸ h
  have : _root_.AlgebraicGeometry.IsAffineHom
      ((𝔉).map k ≫ (𝔉).map (opensSiteObjectInclusion B S hS Z O)) := by
    rw [← Functor.map_comp, hkι]; infer_instance
  have : _root_.AlgebraicGeometry.IsAffineHom ((𝔉).map k) :=
    IsAffineHom.of_comp _ ((𝔉).map (opensSiteObjectInclusion B S hS Z O))
  have hwft : LocallyOfFiniteType ((𝔉).map w) :=
    hft W T u (yoneda.map (𝟙 T)) w (presheaf_etale_of_isOpenImmersion B S hS hu)
      ((presheaf_yoneda_map_iff B S hS (P := @AlgebraicGeometry.Etale.{u}) inferInstance
        (𝟙 T)).2 (by rw [CategoryTheory.Functor.map_id]; infer_instance))
      (by rw [CategoryTheory.Functor.map_id, Category.comp_id, hw])
  have hwk : (𝔉).map w = (𝔉).map k ≫ (𝔉).map (opensSiteObjectInclusion B S hS Z O) ≫
      (𝔉).map z := by
    rw [← Functor.map_comp, ← Functor.map_comp, ← Category.assoc, hkι, hmw]
  have : LocallyOfFiniteType ((𝔉).map k ≫ (𝔉).map (opensSiteObjectInclusion B S hS Z O) ≫
      (𝔉).map z) := by
    rw [← hwk]; exact hwft
  have : LocallyOfFiniteType ((𝔉).map k) := locallyOfFiniteType_of_comp _
    ((𝔉).map (opensSiteObjectInclusion B S hS Z O) ≫ (𝔉).map z)
  have : _root_.AlgebraicGeometry.IsIntegralHom ((𝔉).map k) :=
    _root_.AlgebraicGeometry.IsIntegralHom.iff_universallyClosed_and_isAffineHom.2
      ⟨hkucs, inferInstance⟩
  have : _root_.AlgebraicGeometry.IsFinite ((𝔉).map k) :=
    (_root_.AlgebraicGeometry.IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).2
      ⟨inferInstance, inferInstance⟩
  have := hzfin
  rw [hwk]
  exact MorphismProperty.comp_mem _ _ _ inferInstance
    (MorphismProperty.comp_mem _ _ _ inferInstance inferInstance)

end AlgebraicGeometry.Space

