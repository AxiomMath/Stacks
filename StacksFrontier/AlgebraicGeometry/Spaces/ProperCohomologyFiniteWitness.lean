/-!
# The coherent witness on integral closed subspaces for finiteness of cohomology

Let `f : X ⟶ h_T` be a proper morphism of algebraic spaces to the algebraic space of an affine
locally Noetherian object `T` of the site.  For every reduced closed subspace `Z ⊆ X` with `|Z|`
irreducible there is a coherent `𝒪_X`-module with scheme-theoretic support `Z` all of whose
cohomology modules are finite over `Γ(h_T, 𝒪)`.  This is the witness that the dévissage of
[Stacks, Tag 08AN] asks for in the proof of [Stacks, Tag 08AS] through [Stacks, Tag 08AR].

The witness is `i_* p_* (ℒ^{⊗ d})ᵃ^{⊕ n}` for Chow's cover `p : h_V ⟶ Z`
(`AlgebraicGeometry.Space.exists_properSurjective_schemeCover_isAmple_of_isProper_toAffine`)
with an ample `ℒ` on `V₀` and `d` large: the higher direct images along `p` vanish
(`AlgebraicGeometry.Space.exists_isZero_rightDerived_modulePushforward_representedModuleOf`), so
its cohomology is the cohomology on `h_V`, finite by the scheme-level [Stacks, Tag 02O6]
(`AlgebraicGeometry.Space.hasFiniteGlobalCohomologyOver_schemeSpaceMap_of_isProper`); and
`ℒ^{⊗ d}` is generated by `n` global sections, so `p_*` of the sum has full support
(`AlgebraicGeometry.Space.moduleSupportSet_modulePushforward_representedModuleOf_eq_univ`).

## Main results

* `AlgebraicGeometry.Space.hasCoherentWitnessOnIntegralSubspaces_hasFiniteGlobalCohomologyOver`
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.SheafOfModules.Tensor (ringSheaf)
open Stacks.Cohomology.SiteModules
open Stacks.Ample

attribute [local instance 5000] SheafOfModules.instAbelian
attribute [local instance] AlgebraicGeometry.Space.pointTopology

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The coherent witness on integral closed subspaces for finiteness of cohomology over an
affine Noetherian base.** -/
theorem hasCoherentWitnessOnIntegralSubspaces_hasFiniteGlobalCohomologyOver
    (hZtop : B.Contains (⊤_ Scheme.{u})) {X : AlgebraicSpaces B S hS} {T : BigFppfOver B S hS}
    [hTa : IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    [hTn : _root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj T)]
    (f : X ⟶ schemeSpace T) (hf : IsProper B S hS f.hom) :
    HasCoherentWitnessOnIntegralSubspaces B S hS X (HasFiniteGlobalCohomologyOver B S hS f) := by
  intro Z hZ hred
  let Zs := closedSubfunctorSpace B S hS hZ
  let i : Zs ⟶ X := closedSubfunctorι B S hS hZ
  have hi : IsClosedImmersion B S hS i.hom := hZ.2
  have hq : IsProper B S hS (i ≫ f).hom := isProper_comp' B S hS i.hom f.hom X.2
    (schemeSpace T).2 (isProper_of_isClosedImmersion B S hS Zs.2 X.2 _ hi) hf
  have hrep : ∀ W : BigFppfOver B S hS,
      _root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj W) →
        HasEtaleLocalProperty B S hS (yoneda.obj W)
          (fun V : Scheme.{u} => _root_.AlgebraicGeometry.IsLocallyNoetherian V) :=
    fun W hW => hasEtaleLocalProperty_of_representable B S hS _ _ W (Iso.refl _) hW
  have hXN := isLocallyNoetherian_of_isLocallyOfFiniteType B S hS X.2 (schemeSpace T).2 f.hom
    hf.2.1.1 (hrep T hTn)
  have hZN := hasEtaleLocalProperty_isLocallyNoetherian_closedSubfunctor B S hS X hXN hZ
  obtain ⟨V, ρ, hρp, hρs, L, hL, hamp⟩ :=
    exists_properSurjective_schemeCover_isAmple_of_isProper_toAffine B S hS T hTa Zs.2
      (i ≫ f).hom hq
  let p : schemeSpace V ⟶ Zs := ObjectProperty.homMk ρ
  have hpT : IsProper B S hS (p ≫ i ≫ f).hom :=
    isProper_comp' B S hS ρ (i ≫ f).hom Zs.2 (schemeSpace T).2 hρp hq
  let g : V ⟶ T := Yoneda.fullyFaithful.preimage (p ≫ i ≫ f).hom
  have hyg : yoneda.map g = (p ≫ i ≫ f).hom := Yoneda.fullyFaithful.map_preimage _
  have hg : schemeSpaceMap g = p ≫ i ≫ f := ObjectProperty.hom_ext _ hyg
  have hgP : _root_.AlgebraicGeometry.IsProper ((BigFppfOver.toScheme B S hS).map g) :=
    isProper_toScheme_map_of_isProper B S hS g (by rwa [hyg])
  have hVln : _root_.AlgebraicGeometry.IsLocallyNoetherian
      ((BigFppfOver.toScheme B S hS).obj V) :=
    LocallyOfFiniteType.isLocallyNoetherian ((BigFppfOver.toScheme B S hS).map g)
  have hZsep : IsAbsolutelySeparated B S hS hZtop Zs.1 :=
    isAbsolutelySeparated_of_isSeparated_to_affine B S hS hZtop T hTa (i ≫ f).hom hq.1
  have hZqc : IsQuasiCompactSpace B S hS Zs.1 :=
    isQuasiCompactSpace_of_isQuasiCompact_of_isAffineSpace B S hS (i ≫ f).hom
      (isAffineSpace_yoneda B S hS T hTa) hq.2.1.2
  obtain ⟨U, hUaff, hUcov⟩ := SmallEtale.exists_affineObject_coversTop B S hS Zs.1 Zs.2 hZqc
  have hUln := isLocallyNoetherian_chart B S hS hZN U
  obtain ⟨d₀, hd₀⟩ := exists_isZero_rightDerived_modulePushforward_representedModuleOf B S hS
    hZtop hZsep p hρp U hUaff (GrothendieckTopology.coversTop_punit hUcov) L hamp
  obtain ⟨d, hd, σ, hσ⟩ :=
    Stacks.AmpleGlobalGeneration.exists_le_generatingSections_tensorPowModule L hamp d₀
  have : Finite σ.I := hσ
  have : Fintype σ.I := Fintype.ofFinite _
  let Ld := tensorPowModule ((BigFppfOver.toScheme B S hS).obj V) L (d : ℤ)
  let n := Fintype.card σ.I
  let M := representedModuleOf B S hS V (⨁ fun _ : Fin n => Ld)
  have : Ld.IsQuasicoherent :=
    Stacks.AmpleGlobalGeneration.isQuasicoherent_tensorPowModule L (d : ℤ)
  have hMqc : SheafOfModules.IsQuasicoherent
      (show ((BigFppfOver.toScheme B S hS).obj V).Modules from ⨁ fun _ : Fin n => Ld) :=
    Scheme.Modules.isQuasicoherent_biproduct (fun _ : Fin n => Ld)
  have hMc : IsCoherent B S hS (yoneda.obj V) (isAlgebraicSpace_yoneda B S hS V) M :=
    isCoherent_representedModuleOf B S hS V (hrep V hVln) _ hMqc
      (Stacks.AmpleGlobalGeneration.isFiniteType_biproduct_const_of_isInvertibleModule Ld)
  have hpM : IsCoherent B S hS Zs.1 Zs.2 ((modulePushforward B S hS p).obj M) :=
    isCoherent_modulePushforward_of_isProper B S hS p
      (relativelyRepresentable_of_isAlgebraicSpace B S hS Zs.2 ρ) hρp hZN M hMc
  have hiF : IsFinite B S hS i.hom := isFinite_of_isClosedImmersion B S hS i.hom hi
  have hGc : IsCoherent B S hS X.1 X.2
      ((modulePushforward B S hS i).obj ((modulePushforward B S hS p).obj M)) :=
    isCoherent_modulePushforward_of_isFinite' B S hS i hiF hXN _ hpM
  refine ⟨(modulePushforward B S hS i).obj ((modulePushforward B S hS p).obj M), hGc, ?_, ?_⟩
  · have hT : IsClosed (Set.range (pointsMap B S hS Z.toFunctor Z.ι)) :=
      isClosed_range_pointsMap_of_isClosedImmersion B S hS X.2 Z.ι hi
    have hZeq : Z = reducedClosedSubspace B S hS X.1 X.2 _ hT :=
      (existsUnique_reducedClosedSubspace' B S hS X.2 _ hT).unique ⟨hZ, rfl, hred.1⟩
        ⟨isClosedSubspace_reducedClosedSubspace' B S hS X.2 _ hT,
          range_pointsMap_ι_reducedClosedSubspace B S hS X.1 X.2 _ hT,
          hasEtaleLocalProperty_isReduced_reducedClosedSubspace B S hS X.1 X.2 _ hT⟩
    have hann : reducedIdealSheaf B S hS X _ hT ≤ annihilatorIdealSheaf B S hS X
        ((modulePushforward B S hS i).obj ((modulePushforward B S hS p).obj M)) := by
      have hsub : reducedClosedSubspaces B S hS X _ hT = ⟨Z, hZ⟩ := Subtype.ext hZeq.symm
      unfold reducedIdealSheaf
      rw [hsub]
      exact definingIdealSheaf_le_annihilatorIdealSheaf B S hS X _ ⟨Z, hZ⟩
        (annihilatedByKerIdeal_modulePushforward B S hS
          (closedSubspaceInclusion B S hS X ⟨Z, hZ⟩) _)
    have hsupp : moduleSupportSet B S hS X
        ((modulePushforward B S hS i).obj ((modulePushforward B S hS p).obj M)) =
          Set.range (pointsMap B S hS Z.toFunctor Z.ι) := by
      have : SheafOfModules.IsCoherentOnSite ((modulePushforward B S hS p).obj M) :=
        hpM.toIsCoherentOnSite
      have := isFiniteTypeOnSite_of_isCoherentOnSite B S hS Zs ((modulePushforward B S hS p).obj M)
      have h1 := supportOfSheaf_modulePushforward_eq_image_of_isFiniteTypeOnSite B S hS i hi
        ((modulePushforward B S hS p).obj M)
      have h2 := moduleSupportSet_modulePushforward_representedModuleOf_eq_univ B S hS V p hρs
        Ld σ
      change supportOfSheaf B S hS X.1 _ = _
      rw [h1]
      change pointsMap B S hS Z.toFunctor Z.ι '' (moduleSupportSet B S hS Zs
        ((modulePushforward B S hS p).obj M)) = _
      rw [h2, Set.image_univ]
    rw [schemeTheoreticSupport_eq_reducedClosedSubspace B S hS X _ hGc _ hT hann hsupp, ← hZeq]
  · unfold HasFiniteGlobalCohomologyOver
    intro _ k
    have e1 := cohomologyIsoOfIsFinite B S hS i hiF ((modulePushforward B S hS p).obj M)
      hpM.toIsQuasicoherentOnSite k
    have e2 := cohomologyIsoOfIsZeroHigherDirectImages B S hS p M
      (fun q hq => isZero_rightDerived_modulePushforward_representedModuleOf_biproduct B S hS V p
        Ld q (hd₀ d hd q hq)) k
    have hfin := hasFiniteGlobalCohomologyOver_schemeSpaceMap_of_isProper B S hS g M hMc
    unfold HasFiniteGlobalCohomologyOver at hfin
    have h3 := hfin k
    have hc1 : globalSectionsRingHomSite B S hS (schemeSpaceMap g) =
        (globalSectionsRingHomSite B S hS p).comp (globalSectionsRingHomSite B S hS (i ≫ f)) := by
      rw [hg, globalSectionsRingHomSite_comp]
    have hc2 : globalSectionsRingHomSite B S hS (i ≫ f) =
        (globalSectionsRingHomSite B S hS i).comp (globalSectionsRingHomSite B S hS f) :=
      globalSectionsRingHomSite_comp B S hS i f
    let H := ((globalSectionsFunctor.{u + 1, u, u, u}
      (ringSheaf (smallEtaleRingedSite B S hS (schemeSpace V).1 (schemeSpace V).2).O)).rightDerived
        k).obj M
    have iso := ModuleCat.restrictScalarsComp'App _ _ _ hc1 H ≪≫
      ModuleCat.restrictScalarsComp'App _ _ _ hc2 _ ≪≫
      ((globalSectionsRestrictScalars B S hS f).mapIso
        (e1.symm ≪≫ (globalSectionsRestrictScalars B S hS i).mapIso e2.symm)).symm
    exact Module.Finite.equiv iso.toLinearEquiv

end AlgebraicGeometry.Space

end
