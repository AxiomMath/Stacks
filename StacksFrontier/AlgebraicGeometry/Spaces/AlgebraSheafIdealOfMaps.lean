module

public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeChartSections
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.CartesianRelations
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSectionsKernel
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AlgebraSheafIdealQuotientCokernel
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AlgebraSheafIdealQuotientLift
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.BigSiteColimits.AffineGeneratedRelations

/-!
# The sheaf of ideals of an algebra sheaf generated by the images of finitely many modules

Let `ℬ` be a sheaf of `𝒪_X`-algebras on an algebraic space `X` and let `g_x : 𝒢_x ⟶ ℬ`, `x ∈ κ`, be
morphisms of `𝒪_X`-modules into the underlying module of `ℬ`. The sheaf of ideals of `ℬ` they
generate is the local closure of the presheaf of ideals `U ↦ (⋃_x g_x(𝒢_x(U)))ℬ(U)`.

When `κ` is finite, `ℬ` and every `𝒢_x` are cartesian on affine charts and every `𝒢_x` has finitely
generated sections over the affine charts, the sections of this sheaf of ideals over an affine
chart are the ideal generated by the images, they form a finitely generated ideal, and the sheaf of
ideals is quasi-coherent.

## Main definitions

* `AlgebraicGeometry.Space.AlgebraSheaf.idealOfMaps`: the sheaf of ideals generated by the images
  of the `g_x`.

## Main results

* `AlgebraicGeometry.Space.AlgebraSheaf.idealOfMaps_obj_of_isAffine`: its sections over an affine
  étale chart are the ideal generated by the images.
* `AlgebraicGeometry.Space.AlgebraSheaf.isQuasicoherentOnSite_idealModule_idealOfMaps`: it is
  quasi-coherent.
* `AlgebraicGeometry.Space.AlgebraSheaf.idealOfMaps_le_kerIdeal`: it is killed by every morphism of
  algebra sheaves killing the images.

## References

* [Stacks Project, Tag 086Z](https://stacks.math.columbia.edu/tag/086Z)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped TensorProduct

universe u

namespace AlgebraicGeometry.Space.AlgebraSheaf

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
  (ℬ : AlgebraSheaf.{u, u} B S hS F hF) {κ : Type*} {G : κ → Modules.{u, u} B S hS F hF}
  (g : ∀ x, G x ⟶ underlyingModule ℬ)

/-- The sheaf of rings underlying `ℬ`, as a sheaf of rings. -/
abbrev ringSheafOf : Sheaf (SmallEtale.topology B S hS F) RingCat.{u} :=
  Stacks.SheafOfModules.Tensor.ringSheaf ℬ.right

/-- The sections of `ℬ` over a chart, read as sections of the unit module over its ring sheaf. -/
abbrev unitSec (U : (SmallEtale B S hS F)ᵒᵖ) : Type u :=
  (SheafOfModules.unit (ringSheafOf ℬ)).val.obj U

/-- A section of `ℬ`, as a section of the unit module. -/
abbrev toUnitSec {U : (SmallEtale B S hS F)ᵒᵖ} (s : ℬ.right.obj.obj U) : unitSec ℬ U := s

/-- The image of a section of `G x` over a chart, as a section of the unit module. -/
abbrev genVal {U : (SmallEtale B S hS F)ᵒᵖ} (x : κ) (m : (G x).val.obj U) : unitSec ℬ U :=
  toUnitSec ℬ ((g x).val.app U m : ℬ.right.obj.obj U)

/-- The images of the `g_x` over a chart, as a set of sections of `ℬ`. -/
def genSet (U : (SmallEtale B S hS F)ᵒᵖ) : Set (unitSec ℬ U) :=
  ⋃ x, Set.range fun m : (G x).val.obj U => genVal ℬ g x m

/-- The image of a section of `G x` lies in `genSet`. -/
theorem mem_genSet {U : (SmallEtale B S hS F)ᵒᵖ} (x : κ) (m : (G x).val.obj U) :
    genVal ℬ g x m ∈ genSet ℬ g U :=
  Set.mem_iUnion.2 ⟨x, m, rfl⟩

/-- The restriction of an image is the image of the restriction. -/
theorem map_app_eq {U V : (SmallEtale B S hS F)ᵒᵖ} (h : U ⟶ V) (x : κ) (m : (G x).val.obj U) :
    (ℬ.right.obj.map h).hom ((g x).val.app U m : ℬ.right.obj.obj U) =
      ((g x).val.app V ((G x).val.map h m) : ℬ.right.obj.obj V) :=
  (PresheafOfModules.naturality_apply (g x).val h m).symm

/-- The presheaf of ideals generated by the images of the `g_x`. -/
def presheafIdealOfMaps : (SheafOfModules.unit (ringSheafOf ℬ)).val.Submodule where
  obj U := Submodule.span ((ringSheafOf ℬ).obj.obj U) (genSet ℬ g U)
  map {U V} h := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨_, ⟨x, rfl⟩, m, rfl⟩
    change toUnitSec ℬ ((ℬ.right.obj.map h).hom ((g x).val.app U m : ℬ.right.obj.obj U)) ∈
      Submodule.span ((ringSheafOf ℬ).obj.obj V) (genSet ℬ g V)
    rw [map_app_eq]
    exact Submodule.subset_span (mem_genSet ℬ g x _)

/-- **The sheaf of ideals of `ℬ` generated by the images of the `g_x`**: the sections lying
étale-locally in the ideal generated by the images. -/
def idealOfMaps : ℬ.IdealSheaf :=
  Stacks.SheafOfModules.localClosure _ (presheafIdealOfMaps ℬ g)

/-- A section lies in `idealOfMaps` exactly when the sieve on which it lies in the ideal generated
by the images is covering. -/
theorem mem_idealOfMaps_obj_iff (U : (SmallEtale B S hS F)ᵒᵖ) (s : unitSec ℬ U) :
    s ∈ (idealOfMaps ℬ g).obj U ↔
      (presheafIdealOfMaps ℬ g).toSubfunctor.sieveOfSection s ∈
        SmallEtale.topology B S hS F U.unop :=
  Iff.rfl

/-- The ideal generated by the images is contained in the sections of the sheaf of ideals. -/
theorem span_le_idealOfMaps_obj (U : (SmallEtale B S hS F)ᵒᵖ) :
    Submodule.span ((ringSheafOf ℬ).obj.obj U) (genSet ℬ g U) ≤ (idealOfMaps ℬ g).obj U :=
  fun _ hs => (presheafIdealOfMaps ℬ g).toSubfunctor.le_sheafify
    (SmallEtale.topology B S hS F) U hs

/-- The image of a section of `G x` lies in the sheaf of ideals generated by the images. -/
theorem app_mem_idealOfMaps (U : (SmallEtale B S hS F)ᵒᵖ) (x : κ) (m : (G x).val.obj U) :
    genVal ℬ g x m ∈ (idealOfMaps ℬ g).obj U :=
  span_le_idealOfMaps_obj ℬ g U (Submodule.subset_span (mem_genSet ℬ g x m))

/-- **The sheaf of ideals generated by the images is contained in any sheaf of ideals containing
the images.** -/
theorem idealOfMaps_le {I : ℬ.IdealSheaf}
    (h : ∀ (U : (SmallEtale B S hS F)ᵒᵖ) (x : κ) (m : (G x).val.obj U),
      genVal ℬ g x m ∈ I.obj U) :
    idealOfMaps ℬ g ≤ I := by
  intro U s hs
  refine I.isSheaf s ?_
  refine (SmallEtale.topology B S hS F).superset_covering ?_ hs
  intro V k hk
  have hk' : (SheafOfModules.unit (ringSheafOf ℬ)).val.map k.op s ∈
      (presheafIdealOfMaps ℬ g).obj (op V) := hk
  refine (Submodule.span_le.mpr ?_ :
    (presheafIdealOfMaps ℬ g).obj (op V) ≤ I.obj (op V)) hk'
  rintro _ ⟨_, ⟨x, rfl⟩, m, rfl⟩
  exact h (op V) x m

/-- **The sheaf of ideals generated by the images is killed by every morphism of algebra sheaves
killing the images.** -/
theorem idealOfMaps_le_kerIdeal {C : AlgebraSheaf.{u, u} B S hS F hF} (f : ℬ ⟶ C)
    (h : ∀ (U : (SmallEtale B S hS F)ᵒᵖ) (x : κ) (m : (G x).val.obj U),
      (f.right.hom.app U).hom (genVal ℬ g x m) = 0) :
    idealOfMaps ℬ g ≤ kerIdeal f :=
  idealOfMaps_le ℬ g fun U x m => (mem_kerIdeal f U _).2 (h U x m)

/-- **Monotonicity**: the sheaf of ideals generated by a family whose images all lie among the
images of a second family is contained in the one the second family generates. -/
theorem idealOfMaps_mono {κ' : Type*} {G' : κ' → Modules.{u, u} B S hS F hF}
    (g' : ∀ x, G' x ⟶ underlyingModule ℬ)
    (h : ∀ (U : (SmallEtale B S hS F)ᵒᵖ) (x : κ) (m : (G x).val.obj U),
      ∃ (y : κ') (m' : (G' y).val.obj U), genVal ℬ g' y m' = genVal ℬ g x m) :
    idealOfMaps ℬ g ≤ idealOfMaps ℬ g' :=
  idealOfMaps_le ℬ g fun U x m => by
    obtain ⟨y, m', hm'⟩ := h U x m
    rw [← hm']
    exact app_mem_idealOfMaps ℬ g' U y m'

/-! ### Products of sections of `ℬ` read in its underlying module -/

/-- The sections of the underlying module of `ℬ` over a chart. -/
abbrev modSec (U : SmallEtale B S hS F) : Type u := (underlyingModule ℬ).val.obj (op U)

/-- A section of the underlying module, read as a section of `ℬ`. -/
abbrev toRing {U : SmallEtale B S hS F} (a : modSec ℬ U) : ℬ.right.obj.obj (op U) := a

/-- A section of `ℬ`, read as a section of the underlying module. -/
abbrev ofRing {U : SmallEtale B S hS F} (a : ℬ.right.obj.obj (op U)) : modSec ℬ U := a

/-- The product of two sections of `ℬ`, in the spelling of the underlying `𝒪_F`-module. -/
abbrev secMul {U : SmallEtale B S hS F} (a b : modSec ℬ U) : modSec ℬ U :=
  ofRing ℬ (toRing ℬ a * toRing ℬ b)

/-- Scalar multiplication by the chart ring is multiplication by the image under the structure map
of `ℬ`. -/
theorem smul_eq_secMul {U : SmallEtale B S hS F} (r : chartRing B S hS F hF U)
    (a : modSec ℬ U) : r • a = ofRing ℬ (ℬ.algebraMap (op U) r * toRing ℬ a) := rfl

/-- `secMul` is linear over the chart ring in its first argument. -/
theorem smul_secMul {U : SmallEtale B S hS F} (r : chartRing B S hS F hF U)
    (a b : modSec ℬ U) : secMul ℬ (r • a) b = r • secMul ℬ a b :=
  mul_assoc (ℬ.algebraMap (op U) r) (toRing ℬ a) (toRing ℬ b)

/-- The product of zero with a section is zero. -/
theorem secMul_zero_left {U : SmallEtale B S hS F} (b : modSec ℬ U) :
    secMul ℬ 0 b = 0 :=
  zero_mul (toRing ℬ b)

/-- `secMul` is additive in its first argument. -/
theorem secMul_add_left {U : SmallEtale B S hS F} (a a' b : modSec ℬ U) :
    secMul ℬ (a + a') b = secMul ℬ a b + secMul ℬ a' b :=
  add_mul (toRing ℬ a) (toRing ℬ a') (toRing ℬ b)

/-- Restriction along a chart morphism commutes with `secMul`. -/
theorem map_secMul {U V : SmallEtale B S hS F} (h : V ⟶ U) (a b : modSec ℬ U) :
    chartRestrictLinear (underlyingModule ℬ) h (secMul ℬ a b) =
      secMul ℬ (chartRestrictLinear (underlyingModule ℬ) h a)
        (chartRestrictLinear (underlyingModule ℬ) h b) :=
  map_mul (ℬ.right.obj.map h.op).hom (toRing ℬ a) (toRing ℬ b)

/-- `b ↦ Σ_i b_i τ_i`, linear over the chart ring. -/
def combMap {U : SmallEtale B S hS F} {ι : Type*} [Fintype ι] (τ : ι → modSec ℬ U) :
    (ι → modSec ℬ U) →ₗ[chartRing B S hS F hF U] modSec ℬ U where
  toFun b := ∑ i, secMul ℬ (b i) (τ i)
  map_add' b c := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => add_mul (toRing ℬ (b i)) (toRing ℬ (c i)) (toRing ℬ (τ i))
  map_smul' r b := by
    rw [RingHom.id_apply, Finset.smul_sum]
    exact Finset.sum_congr rfl fun i _ => smul_secMul ℬ r (b i) (τ i)

/-- `combMap ℬ τ b = Σ_i b_i τ_i`. -/
theorem combMap_apply {U : SmallEtale B S hS F} {ι : Type*} [Fintype ι]
    (τ : ι → modSec ℬ U) (b : ι → modSec ℬ U) :
    combMap ℬ τ b = ∑ i, secMul ℬ (b i) (τ i) := rfl

/-- The values of `combMap` are closed under multiplication by sections of `ℬ`. -/
theorem secMul_mem_range_combMap {U : SmallEtale B S hS F} {ι : Type*} [Fintype ι]
    (τ : ι → modSec ℬ U) (c : modSec ℬ U) {y : modSec ℬ U}
    (hy : y ∈ LinearMap.range (combMap ℬ τ)) :
    secMul ℬ c y ∈ LinearMap.range (combMap ℬ τ) := by
  obtain ⟨b, rfl⟩ := hy
  refine ⟨fun i => secMul ℬ c (b i), ?_⟩
  show ∑ i, (toRing ℬ c * toRing ℬ (b i)) * toRing ℬ (τ i) =
    toRing ℬ c * ∑ i, toRing ℬ (b i) * toRing ℬ (τ i)
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => mul_assoc _ _ _

/-! ### Étale descent of membership over an affine chart -/

section Descent

variable {ℬ}

/-- The image of a section of `G x` over a chart, as a section of the underlying module. -/
abbrev gModVal {U : SmallEtale B S hS F} (x : κ) (m : (G x).val.obj (op U)) : modSec ℬ U :=
  (g x).val.app (op U) m

/-- The restriction of an image is the image of the restriction. -/
theorem chartRestrict_gModVal {U V : SmallEtale B S hS F} (h : V ⟶ U) (x : κ)
    (m : (G x).val.obj (op U)) :
    chartRestrictLinear (underlyingModule ℬ) h (gModVal g x m) =
      gModVal g x (chartRestrictLinear (G x) h m) :=
  (PresheafOfModules.naturality_apply (g x).val h.op m).symm

/-- The images of the sections of `G x` over a chart `V` lie in the values of `combMap` at a family
`τ'` as soon as the images of the members of a spanning set do. -/
theorem gModVal_mem_range_of_span {V : SmallEtale B S hS F} {ι : Type*} [Fintype ι]
    (τ' : ι → modSec ℬ V) (x : κ) (T : Set ((G x).val.obj (op V)))
    (hspan : Submodule.span (chartRing B S hS F hF V) T = ⊤)
    (hres : ∀ m ∈ T, gModVal g x m ∈ LinearMap.range (combMap ℬ τ'))
    (m' : (G x).val.obj (op V)) :
    gModVal g x m' ∈ LinearMap.range (combMap ℬ τ') := by
  have hm' : m' ∈ Submodule.span (chartRing B S hS F hF V) T := hspan ▸ Submodule.mem_top
  induction hm' using Submodule.span_induction with
  | mem y hy => exact hres y hy
  | zero =>
    show (g x).val.app (op V) 0 ∈ _
    rw [map_zero]; exact zero_mem _
  | add y y' _ _ hy hy' =>
    show (g x).val.app (op V) (y + y') ∈ _
    rw [map_add]; exact add_mem hy hy'
  | smul r y _ hy =>
    show (g x).val.app (op V) (r • y) ∈ _
    rw [map_smul]; exact Submodule.smul_mem _ r hy

/-- The restrictions of a spanning family span the sections over the smaller chart, when the base
change comparison is surjective. -/
theorem span_range_restrict_eq_top (G' : Modules.{u, u} B S hS F hF) {U V : SmallEtale B S hS F}
    (h : V ⟶ U) (hsurj : letI := chartAlgebra (hF := hF) h
      Function.Surjective (sectionsBaseChange G' h))
    {ι : Type*} (σ : ι → G'.val.obj (op U))
    (hσ : Submodule.span (chartRing B S hS F hF U) (Set.range σ) = ⊤) :
    Submodule.span (chartRing B S hS F hF V)
      (Set.range fun k => chartRestrictLinear G' h (σ k)) = ⊤ := by
  let := chartAlgebra (hF := hF) h
  let := chartSectionsModule G' h
  have := chartSections_isScalarTower G' h
  have h1 := (chartBaseChange_surjective_iff_span_eq_top G' h).1 hsurj
  refine eq_top_iff.2 (h1.symm.le.trans (Submodule.span_le.2 ?_))
  rintro _ ⟨m, rfl⟩
  have hm : m ∈ Submodule.span (chartRing B S hS F hF U) (Set.range σ) := hσ ▸ Submodule.mem_top
  have h2 : chartRestrictLinear G' h m ∈ Submodule.span (chartRing B S hS F hF U)
      (Set.range fun k => chartRestrictLinear G' h (σ k)) := by
    have := Submodule.mem_map_of_mem (f := chartRestrictLinear G' h) hm
    rwa [Submodule.map_span, ← Set.range_comp] at this
  exact Submodule.span_le_restrictScalars (chartRing B S hS F hF U) (chartRing B S hS F hF V)
    _ h2

/-- Each `τ i` is a value of `combMap ℬ τ`. -/
theorem mem_range_combMap_self {V : SmallEtale B S hS F} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (τ : ι → modSec ℬ V) (i : ι) : τ i ∈ LinearMap.range (combMap ℬ τ) := by
  refine ⟨Pi.single i (ofRing ℬ 1), ?_⟩
  rw [combMap_apply, Finset.sum_eq_single i]
  · show toRing ℬ (Pi.single (M := fun _ => modSec ℬ V) i (ofRing ℬ 1) i) * toRing ℬ (τ i) =
      toRing ℬ (τ i)
    rw [Pi.single_eq_same]
    exact one_mul _
  · intro j _ hj
    show toRing ℬ (Pi.single (M := fun _ => modSec ℬ V) i (ofRing ℬ 1) j) * toRing ℬ (τ j) = 0
    rw [Pi.single_eq_of_ne hj]
    exact zero_mul _
  · exact fun h => absurd (Finset.mem_univ i) h

/-- **Over a chart at which a finite spanning family of each `G x` is given, the ideal generated by
the images is the set of values of `combMap` at their images.** -/
theorem mem_span_genSet_iff [Fintype κ] {V : SmallEtale B S hS F} {n : κ → ℕ}
    (σ : ∀ x, Fin (n x) → (G x).val.obj (op V))
    (hσ : ∀ x, Submodule.span (chartRing B S hS F hF V) (Set.range (σ x)) = ⊤)
    (y : ℬ.right.obj.obj (op V)) :
    toUnitSec ℬ y ∈ Submodule.span ((ringSheafOf ℬ).obj.obj (op V)) (genSet ℬ g (op V)) ↔
      ofRing ℬ y ∈ LinearMap.range
        (combMap ℬ fun p : Σ x, Fin (n x) => gModVal g p.1 (σ p.1 p.2)) := by
  classical
  set τ : (Σ x, Fin (n x)) → modSec ℬ V := fun p => gModVal g p.1 (σ p.1 p.2) with hτ
  constructor
  · intro hy
    suffices H : ∀ z : unitSec ℬ (op V),
        z ∈ Submodule.span ((ringSheafOf ℬ).obj.obj (op V)) (genSet ℬ g (op V)) →
          (show modSec ℬ V from z) ∈ LinearMap.range (combMap ℬ τ) from H _ hy
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨_, ⟨x, rfl⟩, m, rfl⟩ := hz
      refine gModVal_mem_range_of_span g τ x (Set.range (σ x)) (hσ x) ?_ m
      rintro _ ⟨k, rfl⟩
      exact mem_range_combMap_self τ ⟨x, k⟩
    | zero => exact zero_mem _
    | add a b _ _ ha hb => exact add_mem ha hb
    | smul r a _ ha => exact secMul_mem_range_combMap ℬ τ (ofRing ℬ r) ha
  · rintro ⟨b, hb⟩
    have hy : y = ∑ p, toRing ℬ (b p) * toRing ℬ (τ p) := hb.symm
    rw [hy]
    refine Submodule.sum_mem _ fun p _ => ?_
    exact Submodule.smul_mem _ (toRing ℬ (b p))
      (Submodule.subset_span (mem_genSet ℬ g p.1 (σ p.1 p.2)))

/-- The base change of the coordinatewise restriction of a family of sections of `ℬ` is surjective
when the base change comparison of `ℬ` along the chart morphism is. -/
theorem surjective_liftBaseChange_piRestrict {U V : SmallEtale B S hS F} (h : V ⟶ U)
    (hsurj : letI := chartAlgebra (hF := hF) h
      Function.Surjective (sectionsBaseChange (underlyingModule ℬ) h))
    (ι : Type*) [Fintype ι] [DecidableEq ι] :
    letI := chartAlgebra (hF := hF) h
    letI := chartSectionsModule (underlyingModule ℬ) h
    haveI := chartSections_isScalarTower (underlyingModule ℬ) h
    Function.Surjective (LinearMap.liftBaseChange (chartRing B S hS F hF V)
      ((chartRestrictLinear (underlyingModule ℬ) h).compLeft ι)) := by
  let := chartAlgebra (hF := hF) h
  let := chartSectionsModule (underlyingModule ℬ) h
  have := chartSections_isScalarTower (underlyingModule ℬ) h
  set L := LinearMap.liftBaseChange (chartRing B S hS F hF V)
    ((chartRestrictLinear (underlyingModule ℬ) h).compLeft ι) with hL
  have key : ∀ (k : ι) (t : chartRing B S hS F hF V ⊗[chartRing B S hS F hF U] modSec ℬ U),
      L (LinearMap.lTensor (chartRing B S hS F hF V)
          (LinearMap.single _ (fun _ => modSec ℬ U) k) t) =
        Pi.single k (sectionsBaseChange (underlyingModule ℬ) h t) := by
    intro k t
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero, Pi.single_zero]
    | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, Pi.single_add]
    | tmul b m =>
      rw [LinearMap.lTensor_tmul, hL, LinearMap.liftBaseChange_tmul, chartBaseChange_tmul]
      funext j
      rw [Pi.smul_apply, LinearMap.compLeft_apply]
      by_cases hj : j = k
      · subst hj
        rw [Function.comp_apply, LinearMap.single_apply, Pi.single_eq_same, Pi.single_eq_same]
      · rw [Function.comp_apply, LinearMap.single_apply, Pi.single_eq_of_ne hj,
          Pi.single_eq_of_ne hj, map_zero, smul_zero]
  intro y
  choose t ht using fun k => hsurj (y k)
  refine ⟨∑ k, LinearMap.lTensor (chartRing B S hS F hF V)
    (LinearMap.single _ (fun _ => modSec ℬ U) k) (t k), ?_⟩
  rw [map_sum]
  simp only [key, ht]
  exact (Finset.univ_sum_single y)

/-- A module of sections which is finitely generated over an affine chart has a finite spanning
family. -/
private theorem exists_fin_span_eq_top
    (hfin : ∀ (x : κ) (W : SmallEtale B S hS F),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) ((G x).val.obj (op W)))
    {U : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    (x : κ) : ∃ n : ℕ, ∃ σ : Fin n → (G x).val.obj (op U),
      Submodule.span (chartRing B S hS F hF U) (Set.range σ) = ⊤ := by
  have := hfin x U hU
  exact Module.Finite.exists_fin

/-- **Étale descent of membership in the ideal generated by the images, over an affine chart.** A
section of `ℬ` over an affine étale chart which lies locally in the ideal generated by the images
of the `g_x` lies in that ideal over the chart, when `κ` is finite, `ℬ` and every `G x` are
cartesian on affine charts and every `G x` has finitely generated sections over affine charts. -/
theorem mem_span_genSet_of_mem_idealOfMaps [Finite κ]
    (hℬ : IsCartesianOnAffineCharts (underlyingModule ℬ))
    (hG : ∀ x, IsCartesianOnAffineCharts (G x))
    (hfin : ∀ (x : κ) (W : SmallEtale B S hS F),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) ((G x).val.obj (op W)))
    {U : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U))
    (y : ℬ.right.obj.obj (op U)) (hy : y ∈ (idealOfMaps ℬ g).obj (op U)) :
    toUnitSec ℬ y ∈ Submodule.span ((ringSheafOf ℬ).obj.obj (op U)) (genSet ℬ g (op U)) := by
  classical
  let _ : Fintype κ := Fintype.ofFinite κ
  choose n σ hσ using exists_fin_span_eq_top (G := G) hfin hU
  set ι := Σ x, Fin (n x) with hι
  set τ : ι → modSec ℬ U := fun p => gModVal g p.1 (σ p.1 p.2) with hτ
  obtain ⟨m, z, φ, hzaff, hzT, hff⟩ :=
    exists_finite_affine_faithfullyFlat_pi_le B S hS F hF hU hy
  let algI : ∀ i, Algebra (chartRing B S hS F hF U) (chartRing B S hS F hF (z i)) :=
    fun i => chartAlgebra (hF := hF) (φ i)
  let modI : ∀ i, Module (chartRing B S hS F hF U) (modSec ℬ (z i)) :=
    fun i => chartSectionsModule (underlyingModule ℬ) (φ i)
  have towI : ∀ i, IsScalarTower (chartRing B S hS F hF U) (chartRing B S hS F hF (z i))
      (modSec ℬ (z i)) := fun i => chartSections_isScalarTower (underlyingModule ℬ) (φ i)
  have hFF : Module.FaithfullyFlat (chartRing B S hS F hF U)
      (∀ i, chartRing B S hS F hF (z i)) := hff
  let rN : ∀ i, modSec ℬ U →ₗ[chartRing B S hS F hF U] modSec ℬ (z i) :=
    fun i => chartRestrictLinear (underlyingModule ℬ) (φ i)
  let rP : ∀ i, (ι → modSec ℬ U) →ₗ[chartRing B S hS F hF U] (ι → modSec ℬ (z i)) :=
    fun i => (rN i).compLeft ι
  let τi : ∀ i, ι → modSec ℬ (z i) := fun i p => rN i (τ p)
  let bT := combMap ℬ τ
  let bW : ∀ i, (ι → modSec ℬ (z i)) →ₗ[chartRing B S hS F hF (z i)] modSec ℬ (z i) :=
    fun i => combMap ℬ (τi i)
  have hsq : ∀ (i) (q : ι → modSec ℬ U), rN i (bT q) = bW i (rP i q) := by
    intro i q
    show chartRestrictLinear (underlyingModule ℬ) (φ i) (∑ p, secMul ℬ (q p) (τ p)) =
      ∑ p, secMul ℬ (chartRestrictLinear (underlyingModule ℬ) (φ i) (q p))
        (chartRestrictLinear (underlyingModule ℬ) (φ i) (τ p))
    rw [map_sum]
    exact Finset.sum_congr rfl fun p _ => map_secMul ℬ (φ i) (q p) (τ p)
  have hP : ∀ i, Function.Surjective ((rP i).liftBaseChange (chartRing B S hS F hF (z i))) :=
    fun i => surjective_liftBaseChange_piRestrict (φ i) (hℬ U (z i) hU (hzaff i) (φ i)).2 ι
  have hN : ∀ i, Function.Injective ((rN i).liftBaseChange (chartRing B S hS F hF (z i))) :=
    fun i => (hℬ U (z i) hU (hzaff i) (φ i)).1
  have hn : ∀ i, rN i (ofRing ℬ y) ∈ LinearMap.range (bW i) := by
    intro i
    have hσi : ∀ x, Submodule.span (chartRing B S hS F hF (z i))
        (Set.range fun k => chartRestrictLinear (G x) (φ i) (σ x k)) = ⊤ := fun x =>
      span_range_restrict_eq_top (G x) (φ i) (hG x U (z i) hU (hzaff i) (φ i)).2 (σ x) (hσ x)
    have hmem := (mem_span_genSet_iff g (fun x k => chartRestrictLinear (G x) (φ i) (σ x k))
      hσi ((ℬ.right.obj.map (φ i).op).hom y)).1 (hzT i)
    have hτi : (fun p : ι => gModVal g p.1 (chartRestrictLinear (G p.1) (φ i) (σ p.1 p.2))) =
        τi i := funext fun p => (chartRestrict_gModVal g (φ i) p.1 (σ p.1 p.2)).symm
    rwa [hτi] at hmem
  have hmem := Module.BaseChange.mem_range_of_forall_mem_range_of_liftBaseChange
    (chartRing B S hS F hF U) (fun i => chartRing B S hS F hF (z i)) bT bW rP rN hsq hP hN hn
  exact (mem_span_genSet_iff g σ hσ y).2 hmem

/-- **The sections of the sheaf of ideals generated by the images over an affine chart are the
ideal generated by the images there.** -/
theorem idealOfMaps_obj_of_isAffine [Finite κ]
    (hℬ : IsCartesianOnAffineCharts (underlyingModule ℬ))
    (hG : ∀ x, IsCartesianOnAffineCharts (G x))
    (hfin : ∀ (x : κ) (W : SmallEtale B S hS F),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) ((G x).val.obj (op W)))
    {U : SmallEtale B S hS F}
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (idealOfMaps ℬ g).obj (op U) =
      Submodule.span ((ringSheafOf ℬ).obj.obj (op U)) (genSet ℬ g (op U)) :=
  le_antisymm (fun y hy => mem_span_genSet_of_mem_idealOfMaps g hℬ hG hfin hU y hy)
    (span_le_idealOfMaps_obj ℬ g (op U))

end Descent

/-! ### Quasi-coherence and finite generation -/

/-- The inclusion of the sheaf of ideals, read on the sections over a chart. -/
abbrev idealIncl (I : ℬ.IdealSheaf) (W : SmallEtale B S hS F) :
    (idealModule ℬ I).val.obj (op W) →ₗ[chartRing B S hS F hF W] modSec ℬ W :=
  ((idealModuleι ℬ I).val.app (op W)).hom

/-- `idealIncl` sends a section of the sheaf of ideals to the underlying section of `ℬ`. -/
theorem idealIncl_apply (I : ℬ.IdealSheaf) (W : SmallEtale B S hS F)
    (w : (idealModule ℬ I).val.obj (op W)) : idealIncl ℬ I W w = w.1 := rfl

/-- **The sheaf of ideals generated by the images is cartesian on affine charts.** -/
theorem isCartesianOnAffineCharts_idealModule_idealOfMaps [Finite κ]
    (hℬ : IsCartesianOnAffineCharts (underlyingModule ℬ))
    (hG : ∀ x, IsCartesianOnAffineCharts (G x))
    (hfin : ∀ (x : κ) (W : SmallEtale B S hS F),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) ((G x).val.obj (op W))) :
    IsCartesianOnAffineCharts (idealModule ℬ (idealOfMaps ℬ g)) := by
  classical
  intro U V hU hV f
  let := chartAlgebra (hF := hF) f
  set I := idealOfMaps ℬ g with hI
  set IM := idealModule ℬ I with hIM
  refine ⟨injective_sectionsBaseChange_of_injective_app (idealModuleι ℬ I) f
    (flat_chartRestrict_of_isAffine f hU hV) (fun a b hab => Subtype.ext hab)
    (hℬ U V hU hV f), ?_⟩
  set R : Submodule (chartRing B S hS F hF V) (modSec ℬ V) :=
    LinearMap.range ((idealIncl ℬ I V).comp (sectionsBaseChange IM f)) with hR
  let _ : Fintype κ := Fintype.ofFinite κ
  choose n σ hσ using exists_fin_span_eq_top (G := G) hfin hU
  set τ : (Σ x, Fin (n x)) → modSec ℬ U := fun p => gModVal g p.1 (σ p.1 p.2) with hτ
  have hτmem : ∀ (c : modSec ℬ U) p, toRing ℬ (secMul ℬ c (τ p)) ∈ I.obj (op U) := fun c p =>
    Submodule.smul_mem _ (toRing ℬ c) (app_mem_idealOfMaps ℬ g (op U) p.1 (σ p.1 p.2))
  have hterm : ∀ (b : modSec ℬ V) p,
      secMul ℬ b (chartRestrictLinear (underlyingModule ℬ) f (τ p)) ∈ R := by
    intro b p
    obtain ⟨t, rfl⟩ := (hℬ U V hU hV f).2 b
    induction t using TensorProduct.induction_on with
    | zero =>
      rw [map_zero, secMul_zero_left]
      exact zero_mem R
    | add a c ha hc =>
      rw [map_add, secMul_add_left]
      exact add_mem ha hc
    | tmul o c =>
      rw [chartBaseChange_tmul, smul_secMul, ← map_secMul]
      refine Submodule.smul_mem R o ?_
      refine ⟨TensorProduct.tmul _ (1 : chartRing B S hS F hF V)
        (⟨toRing ℬ (secMul ℬ c (τ p)), hτmem c p⟩ : IM.val.obj (op U)), ?_⟩
      rw [LinearMap.comp_apply]
      exact congrArg (idealIncl ℬ I V) (chartBaseChange_one_tmul IM f _)
  intro w
  have hw : w.1 ∈ R := by
    have h1 : toUnitSec ℬ w.1 ∈
        Submodule.span ((ringSheafOf ℬ).obj.obj (op V)) (genSet ℬ g (op V)) :=
      (idealOfMaps_obj_of_isAffine g hℬ hG hfin hV).le
        (show w.1 ∈ (idealOfMaps ℬ g).obj (op V) from w.2)
    have hσV : ∀ x, Submodule.span (chartRing B S hS F hF V)
        (Set.range fun k => chartRestrictLinear (G x) f (σ x k)) = ⊤ := fun x =>
      span_range_restrict_eq_top (G x) f (hG x U V hU hV f).2 (σ x) (hσ x)
    obtain ⟨b, hb⟩ := (mem_span_genSet_iff g (fun x k => chartRestrictLinear (G x) f (σ x k))
      hσV w.1).1 h1
    suffices H : combMap ℬ (fun p : Σ x, Fin (n x) =>
        gModVal g p.1 (chartRestrictLinear (G p.1) f (σ p.1 p.2))) b ∈ R by
      rwa [hb] at H
    rw [combMap_apply]
    refine Submodule.sum_mem R fun p _ => ?_
    have := hterm (b p) p
    rwa [hτ, chartRestrict_gModVal] at this
  obtain ⟨z, hz⟩ := hw
  exact ⟨z, Subtype.ext hz⟩

/-- **The sheaf of ideals generated by the images is quasi-coherent.** -/
theorem isQuasicoherentOnSite_idealModule_idealOfMaps [Finite κ]
    (hℬ : IsCartesianOnAffineCharts (underlyingModule ℬ))
    (hG : ∀ x, IsCartesianOnAffineCharts (G x))
    (hfin : ∀ (x : κ) (W : SmallEtale B S hS F),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) ((G x).val.obj (op W))) :
    (idealModule ℬ (idealOfMaps ℬ g)).IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_idealModule_idealOfMaps ℬ g hℬ hG hfin)

/-- **The sections of the sheaf of ideals generated by the images over an affine chart form a
finitely generated ideal.** -/
theorem fg_sectionIdeal_idealOfMaps [Finite κ]
    (hℬ : IsCartesianOnAffineCharts (underlyingModule ℬ))
    (hG : ∀ x, IsCartesianOnAffineCharts (G x))
    (hfin : ∀ (x : κ) (W : SmallEtale B S hS F),
      IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj W) →
        Module.Finite (chartRing B S hS F hF W) ((G x).val.obj (op W)))
    (U : SmallEtale B S hS F)
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (Stacks.Sites.sectionIdeal (idealOfMaps ℬ g) (op U)).FG := by
  classical
  let _ : Fintype κ := Fintype.ofFinite κ
  choose n σ hσ using exists_fin_span_eq_top (G := G) hfin hU
  set τ : (Σ x, Fin (n x)) → ℬ.right.obj.obj (op U) :=
    fun p => toRing ℬ (gModVal g p.1 (σ p.1 p.2)) with hτ
  have heq : Stacks.Sites.sectionIdeal (idealOfMaps ℬ g) (op U) = Ideal.span (Set.range τ) := by
    ext y
    constructor
    · intro hy
      have h := (idealOfMaps_obj_of_isAffine g hℬ hG hfin hU).le hy
      obtain ⟨b, hb⟩ := (mem_span_genSet_iff g σ hσ y).1 h
      exact Ideal.mem_span_range_iff_exists_fun.2 ⟨fun p => toRing ℬ (b p), hb⟩
    · intro hy
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 hy
      exact (idealOfMaps_obj_of_isAffine g hℬ hG hfin hU).ge
        ((mem_span_genSet_iff g σ hσ y).2 ⟨fun p => ofRing ℬ (c p), hc⟩)
  rw [heq]
  exact ⟨(Set.finite_range τ).toFinset, by rw [Set.Finite.coe_toFinset]⟩

end AlgebraicGeometry.Space.AlgebraSheaf

