module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import StacksFrontier.AlgebraicGeometry.Spaces.PointsPullback
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleEquiUniverseModel
public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.SpacesEtaleStructureSheaf

/-!
# The small étale sites of a simplicial algebraic space

Let `X` be a simplicial algebraic space over `S` (Stacks 0DE7). The objects of its spaces-étale
site `X_{spaces,étale}` are the algebraic spaces `U` étale over `X_n`, for all simplicial degrees
`n`; a morphism `U/X_n ⟶ V/X_m` is a map `φ : [m] ⟶ [n]` of `Δ` together with a morphism
`U ⟶ V` of algebraic spaces over `X(φ) : X_n ⟶ X_m`. Its coverings are generated by the étale
coverings in a single degree, and global regular functions form its structure sheaf `𝒪`, whose
restriction to degree `n` is the structure sheaf of `X_n`.

## Main definitions

* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite`: the objects of `X_{spaces,étale}`, with
  its category structure, `.degreeInclusion` and `.toSpaces`.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.coverage` and `.topology`: its topology.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.structureSheaf`: the structure sheaf `𝒪`.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.pullbackFunctor`: base change along a
  morphism of simplicial algebraic spaces, continuous by `.pullbackFunctor_isContinuous`, and
  `.structureSharp`, its structure map `𝒪_Y ⟶ h_* 𝒪_X`.

## Main results

* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.coveringFamilies_pullback`: coverings are
  stable under base change.
* `AlgebraicGeometry.Space.SimplicialSpacesEtaleSite.structurePresheaf_isSheaf`.
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The spaces-étale site of a simplicial algebraic space -/

/-- An object `U/X_n` of the spaces-étale site of a simplicial algebraic space `X`: an algebraic
space `U` étale over `X_n` in some simplicial degree `n`. -/
structure SimplicialSpacesEtaleSite (X : SimplicialObject (AlgebraicSpaces B S hS)) where
  /-- The simplicial degree `n`. -/
  degree : SimplexCategory
  /-- The algebraic space `U` étale over `X_n`. -/
  obj : SpacesEtale B S hS (X.obj (op degree))

namespace SimplicialSpacesEtaleSite

variable {B S hS} {X : SimplicialObject (AlgebraicSpaces B S hS)}

/-- A morphism `(φ, f) : U/X_n ⟶ V/X_m` of the spaces-étale site of a simplicial algebraic
space: a map `φ : [m] ⟶ [n]` and a morphism `f : U ⟶ V` of algebraic spaces over
`X(φ) : X_n ⟶ X_m`. -/
@[ext]
structure Hom (U V : SimplicialSpacesEtaleSite B S hS X) where
  /-- The map `φ : [m] ⟶ [n]` of simplicial degrees. -/
  base : V.degree ⟶ U.degree
  /-- The morphism `f : U ⟶ V` of algebraic spaces. -/
  hom : U.obj.1.left ⟶ V.obj.1.left
  /-- `f` lies over `X(φ)`. -/
  w : hom ≫ V.obj.1.hom = U.obj.1.hom ≫ X.map base.op

/-- The category structure on the spaces-étale site of a simplicial algebraic space: the identity
of `U/X_n` is `(𝟙 [n], 𝟙 U)`, and the composite of `(φ, f)` and `(ψ, g)` is `(ψ ≫ φ, f ≫ g)`. -/
instance : Category (SimplicialSpacesEtaleSite B S hS X) where
  Hom := Hom
  id U := ⟨𝟙 _, 𝟙 _, by simp⟩
  comp {U V W} f g := ⟨g.base ≫ f.base, f.hom ≫ g.hom, by
    rw [Category.assoc, g.w, ← Category.assoc, f.w, Category.assoc, op_comp, Functor.map_comp]⟩
  id_comp f := Hom.ext (Category.comp_id _) (Category.id_comp _)
  comp_id f := Hom.ext (Category.id_comp _) (Category.comp_id _)
  assoc f g h := Hom.ext (Category.assoc _ _ _).symm (Category.assoc _ _ _)

/-- The simplicial map of the identity of `U/X_n` is the identity of `[n]`. -/
@[simp] theorem id_base (U : SimplicialSpacesEtaleSite B S hS X) : Hom.base (𝟙 U) = 𝟙 _ := rfl
/-- The morphism of algebraic spaces underlying the identity of `U` is the identity of `U`. -/
@[simp] theorem id_hom (U : SimplicialSpacesEtaleSite B S hS X) : Hom.hom (𝟙 U) = 𝟙 _ := rfl
/-- The simplicial map of a composite `f ≫ g` is the composite `g.base ≫ f.base` in `Δ`. -/
@[simp] theorem comp_base {U V W : SimplicialSpacesEtaleSite B S hS X} (f : U ⟶ V) (g : V ⟶ W) :
    Hom.base (f ≫ g) = g.base ≫ f.base := rfl
/-- The morphism of algebraic spaces underlying `f ≫ g` is `f.hom ≫ g.hom`. -/
@[simp] theorem comp_hom {U V W : SimplicialSpacesEtaleSite B S hS X} (f : U ⟶ V) (g : V ⟶ W) :
    Hom.hom (f ≫ g) = f.hom ≫ g.hom := rfl

variable (X)

/-- The inclusion of the spaces-étale site of `X_n` into that of the simplicial algebraic space
`X`, as the objects of degree `n` and the morphisms over the identity of `[n]`. -/
@[simps]
def degreeInclusion (n : SimplexCategory) :
    SpacesEtale B S hS (X.obj (op n)) ⥤ SimplicialSpacesEtaleSite B S hS X where
  obj V := ⟨n, V⟩
  map {V W} f := ⟨𝟙 n, f.hom.left, by
    rw [Over.w f.hom, op_id, X.map_id, Category.comp_id]⟩

/-- The underlying algebraic space of an object of the spaces-étale site of `X`. -/
@[simps]
def toSpaces : SimplicialSpacesEtaleSite B S hS X ⥤ AlgebraicSpaces B S hS where
  obj U := U.obj.1.left
  map f := f.hom

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

open CategoryTheory.Limits

variable {B S hS} {X : SimplicialObject (AlgebraicSpaces B S hS)}

/-- The covering families of the spaces-étale site of a simplicial algebraic space: the jointly
point-surjective families of the spaces-étale site of `X_n`, in a single degree `n`. -/
def coveringFamilies (U : SimplicialSpacesEtaleSite B S hS X) : Set (Presieve U) :=
  {R | ∃ E : PreZeroHypercover.{u + 1} U.obj,
    SpacesEtale.IsCovering B S hS (X.obj (op U.degree)) ⟨U.obj, E⟩ ∧
      R = Presieve.ofArrows (fun i => (degreeInclusion X U.degree).obj (E.X i))
        (fun i => (degreeInclusion X U.degree).map (E.f i))}

/-- The base change `U' ×_U V` of a member `V ⟶ U` of a covering family along a morphism
`g : U' ⟶ U`, as an algebraic space étale over the simplicial degree of `U'`. -/
noncomputable def baseChangeObj {U U' : SimplicialSpacesEtaleSite B S hS X} (g : U' ⟶ U)
    {V : SpacesEtale B S hS (X.obj (op U.degree))} (a : V ⟶ U.obj) :
    SpacesEtale B S hS (X.obj (op U'.degree)) :=
  ⟨Over.mk (pullback.snd a.hom.left g.hom ≫ U'.obj.1.hom),
    isEtale_comp B S hS
      (isEtale_of_isPullback B S hS _ _ _ _ (IsPullback.of_hasPullback a.hom.left g.hom)
        (SpacesEtale.isEtale_toSpaces_map B S hS _ a)) U'.obj.2⟩

/-- The projection `U' ×_U V ⟶ U'` in the spaces-étale site of the degree of `U'`. -/
noncomputable def baseChangeSnd {U U' : SimplicialSpacesEtaleSite B S hS X} (g : U' ⟶ U)
    {V : SpacesEtale B S hS (X.obj (op U.degree))} (a : V ⟶ U.obj) :
    baseChangeObj g a ⟶ U'.obj :=
  ObjectProperty.homMk (Over.homMk (pullback.snd a.hom.left g.hom) rfl)

/-- The projection `U' ×_U V ⟶ V`, a morphism of the spaces-étale site of `X` over the
simplicial map of `g`. -/
noncomputable def baseChangeFst {U U' : SimplicialSpacesEtaleSite B S hS X} (g : U' ⟶ U)
    {V : SpacesEtale B S hS (X.obj (op U.degree))} (a : V ⟶ U.obj) :
    (⟨U'.degree, baseChangeObj g a⟩ : SimplicialSpacesEtaleSite B S hS X) ⟶ ⟨U.degree, V⟩ :=
  ⟨g.base, pullback.fst a.hom.left g.hom, by
    change pullback.fst a.hom.left g.hom ≫ V.1.hom =
      (pullback.snd a.hom.left g.hom ≫ U'.obj.1.hom) ≫ X.map g.base.op
    rw [← Over.w a.hom, ← Category.assoc, pullback.condition, Category.assoc, g.w,
      Category.assoc]⟩

/-- The square formed by the two projections of `U' ×_U V`. -/
theorem baseChangeFst_comp {U U' : SimplicialSpacesEtaleSite B S hS X} (g : U' ⟶ U)
    {V : SpacesEtale B S hS (X.obj (op U.degree))} (a : V ⟶ U.obj) :
    baseChangeFst g a ≫ (degreeInclusion X U.degree).map a =
      (degreeInclusion X U'.degree).map (baseChangeSnd g a) ≫ g :=
  Hom.ext ((Category.id_comp _).trans (Category.comp_id _).symm) pullback.condition

/-- The coverings of the spaces-étale site of a simplicial algebraic space are stable under
base change: a covering family of `U` pulls back along `g : U' ⟶ U` to a covering family of
`U'` in the degree of `U'`. -/
theorem coveringFamilies_pullback {U U' : SimplicialSpacesEtaleSite B S hS X} (g : U' ⟶ U)
    (R : Presieve U) (hR : R ∈ coveringFamilies U) :
    ∃ T : Presieve U', T ∈ coveringFamilies U' ∧ T.FactorsThruAlong R g := by
  obtain ⟨E, hE, rfl⟩ := hR
  let E' : PreZeroHypercover.{u + 1} U'.obj :=
    { I₀ := E.I₀
      X := fun i => baseChangeObj g (E.f i)
      f := fun i => baseChangeSnd g (E.f i) }
  refine ⟨_, ⟨E', fun x => ?_, rfl⟩, ?_⟩
  · obtain ⟨i, y, hy⟩ := hE (pointsMap B S hS _ g.hom.hom x)
    obtain ⟨w, -, hw⟩ := exists_point_of_isPullback B S hS
      (IsPullback.of_hasPullback (E.f i).hom.left g.hom) y x hy
    exact ⟨i, w, hw⟩
  · rintro _ _ ⟨i⟩
    exact ⟨_, baseChangeFst g (E.f i), _, Presieve.ofArrows.mk i, baseChangeFst_comp g (E.f i)⟩

variable (X)

/-- The coverage of the spaces-étale site of a simplicial algebraic space. -/
noncomputable def coverage : Coverage (SimplicialSpacesEtaleSite B S hS X) where
  coverings := coveringFamilies
  pullback _ _ g R hR := coveringFamilies_pullback g R hR

/-- **Stacks 0DE7.** The topology of the spaces-étale site `X_{spaces,étale}` of a simplicial
algebraic space: it is generated by the étale coverings in a single simplicial degree. -/
noncomputable abbrev topology : GrothendieckTopology (SimplicialSpacesEtaleSite B S hS X) :=
  (coverage X).toGrothendieck

end SimplicialSpacesEtaleSite

section SheafForFunctor

variable {C D : Type*} [Category* C] [Category* D]

/-- A presheaf on `D` is a sheaf for the image of a family of arrows under a functor
`F : C ⥤ D` as soon as its restriction along `F` is a sheaf for the family. -/
theorem
    _root_.CategoryTheory.Presieve.isSheafFor_ofArrows_map_of_isSheafFor_simplicialSmallEtaleSite
    (F : C ⥤ D) (P : Dᵒᵖ ⥤ Type*) {X : C} {ι : Type*} (Y : ι → C) (f : ∀ i, Y i ⟶ X)
    (h : Presieve.IsSheafFor (F.op ⋙ P) (Presieve.ofArrows Y f)) :
    Presieve.IsSheafFor P (Presieve.ofArrows (fun i => F.obj (Y i)) (fun i => F.map (f i))) := by
  rw [Presieve.isSheafFor_arrows_iff] at h ⊢
  intro x hx
  exact h x fun i j Z gi gj w => by
    simpa using hx i j (F.obj Z) (F.map gi) (F.map gj) (by
      rw [← Functor.map_comp, ← Functor.map_comp, w])

end SheafForFunctor

namespace SimplicialSpacesEtaleSite

variable {B S hS} (X : SimplicialObject (AlgebraicSpaces B S hS))

/-- **Stacks 0DE7.** The structure presheaf `𝒪` of a simplicial algebraic space `X`: its value at
`U/X_n` is the ring `Γ(U, 𝒪_U)` of global regular functions, so that its restriction to the
degree `n` is the structure sheaf of `X_n`. -/
noncomputable abbrev structurePresheaf :
    (SimplicialSpacesEtaleSite B S hS X)ᵒᵖ ⥤ CommRingCat.{u + 1} :=
  (toSpaces X).op ⋙ globalFunctionsPresheaf B S hS

/-- The structure presheaf of a simplicial algebraic space restricts in degree `n` to the
structure sheaf of `X_n` on its spaces-étale site. -/
theorem degreeInclusion_op_comp_structurePresheaf (n : SimplexCategory) :
    (degreeInclusion X n).op ⋙ structurePresheaf X =
      SpacesEtale.structurePresheaf B S hS (X.obj (op n)) := rfl

/-- The presheaf represented by a representable algebraic space is a sheaf on the spaces-étale
site of a simplicial algebraic space. -/
theorem isSheaf_yoneda (A : BigFppfOver B S hS) :
    Presieve.IsSheaf (topology X)
      ((toSpaces X).op ⋙ yoneda.obj (representedAlgebraicSpace B S hS A)) := by
  rw [Presieve.isSheaf_coverage]
  rintro U R ⟨E, hE, rfl⟩
  exact Presieve.isSheafFor_ofArrows_map_of_isSheafFor_simplicialSmallEtaleSite
    (degreeInclusion X U.degree) _ E.X E.f <| (Presieve.isSheafFor_iff_generate _).2
      (SpacesEtale.isSheaf_yoneda B S hS (X.obj (op U.degree)) A _
        (Precoverage.generate_mem_toGrothendieck
          ((SpacesEtale.mem_precoverage_iff B S hS (X.obj (op U.degree))).2 ⟨E, rfl, hE⟩)))

/-- **Stacks 0DE7.** Global regular functions form a sheaf of rings on the spaces-étale site of
a simplicial algebraic space. -/
theorem structurePresheaf_isSheaf :
    Presheaf.IsSheaf (topology X) (structurePresheaf X) := by
  apply (Presheaf.isSheaf_iff_isSheaf_forget (topology X)
    (structurePresheaf X) (forget CommRingCat.{u + 1})).2
  apply (isSheaf_iff_isSheaf_of_type _ _).2
  apply (Presieve.isSheaf_iff_of_nat_equiv
    (P₂ := (toSpaces X).op ⋙ yoneda.obj (affineLineSpace B S hS))
    (fun {U} => globalFunctionsHomEquiv B S hS ((toSpaces X).obj U))
    (fun {U V} f s => globalFunctionsHomEquiv_natural B S hS ((toSpaces X).map f) s)).2
  exact isSheaf_yoneda X _

/-- **Stacks 0DE7.** The structure sheaf `𝒪` of a simplicial algebraic space. -/
noncomputable def structureSheaf : Sheaf (topology X) CommRingCat.{u + 1} :=
  ⟨structurePresheaf X, structurePresheaf_isSheaf X⟩

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

open CategoryTheory.Limits

variable {B S hS} {X Y : SimplicialObject (AlgebraicSpaces B S hS)} (h : X ⟶ Y)

/-- The base change `V ×_{Y_n} X_n` of an algebraic space étale over `Y_n` along
`h_n : X_n ⟶ Y_n`, as an object of the spaces-étale site of `X`. -/
noncomputable def pullbackObj (V : SimplicialSpacesEtaleSite B S hS Y) :
    SimplicialSpacesEtaleSite B S hS X :=
  ⟨V.degree, ⟨Over.mk (pullback.snd V.obj.1.hom (h.app (op V.degree))),
    isEtale_of_isPullback B S hS _ _ _ _ (IsPullback.of_hasPullback _ _) V.obj.2⟩⟩

/-- The base change of a morphism `(φ, f)` of the spaces-étale site of `Y` along `h`. -/
noncomputable def pullbackMap {V W : SimplicialSpacesEtaleSite B S hS Y} (g : V ⟶ W) :
    pullbackObj h V ⟶ pullbackObj h W :=
  ⟨g.base, pullback.map _ _ _ _ g.hom (X.map g.base.op) (Y.map g.base.op) g.w.symm
      (h.naturality g.base.op).symm, pullback.lift_snd _ _ _⟩

/-- **Stacks 0DE7.** Base change along a morphism `h : X ⟶ Y` of simplicial algebraic spaces,
as a functor `Y_{spaces,étale} ⥤ X_{spaces,étale}`: in each degree it is the base change of
Stacks 03G0 along `h_n`. -/
noncomputable def pullbackFunctor :
    SimplicialSpacesEtaleSite B S hS Y ⥤ SimplicialSpacesEtaleSite B S hS X where
  obj := pullbackObj h
  map := pullbackMap h
  map_id V := Hom.ext rfl
    (pullback.hom_ext (by simp [pullbackMap]; rfl) (by simp [pullbackMap]; rfl))
  map_comp f g := Hom.ext rfl (pullback.hom_ext
    ((pullback.lift_fst _ _ _).trans (((Category.assoc _ _ _).trans
      ((whisker_eq _ (pullback.lift_fst _ _ _)).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker (pullback.lift_fst _ _ _) _).trans (Category.assoc _ _ _))))).symm))
    ((pullback.lift_snd _ _ _).trans (((Category.assoc _ _ _).trans
      ((whisker_eq _ (pullback.lift_snd _ _ _)).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker (pullback.lift_snd _ _ _) _).trans
          ((Category.assoc _ _ _).trans (whisker_eq _ (by
            rw [comp_base, op_comp, Functor.map_comp]))))))).symm)))

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

open CategoryTheory.Limits

variable {B S hS} {X Y : SimplicialObject (AlgebraicSpaces B S hS)} (h : X ⟶ Y)

/-- The fibre product `A ×_V C` of two morphisms of the spaces-étale site of `Y_n`, as an object of
degree `n` of the spaces-étale site of `Y`. -/
noncomputable def pairObj {n : SimplexCategory} {V A C : SpacesEtale B S hS (Y.obj (op n))}
    (a : A ⟶ V) (c : C ⟶ V) : SimplicialSpacesEtaleSite B S hS Y :=
  ⟨n, ⟨Over.mk (pullback.fst a.hom.left c.hom.left ≫ A.1.hom),
    isEtale_comp B S hS
      (isEtale_of_isPullback B S hS _ _ _ _ (IsPullback.of_hasPullback a.hom.left c.hom.left).flip
        (SpacesEtale.isEtale_toSpaces_map B S hS _ c)) A.2⟩⟩

/-- The first projection of `pairObj a c`, over the identity of `[n]`. -/
noncomputable def pairFst {n : SimplexCategory} {V A C : SpacesEtale B S hS (Y.obj (op n))}
    (a : A ⟶ V) (c : C ⟶ V) : pairObj a c ⟶ (degreeInclusion Y n).obj A :=
  ⟨𝟙 n, pullback.fst a.hom.left c.hom.left, by
    change _ = (pullback.fst a.hom.left c.hom.left ≫ A.1.hom) ≫ Y.map (𝟙 n).op
    rw [op_id, Y.map_id, Category.comp_id]
    rfl⟩

/-- The second projection of `pairObj a c`, over the identity of `[n]`. -/
noncomputable def pairSnd {n : SimplexCategory} {V A C : SpacesEtale B S hS (Y.obj (op n))}
    (a : A ⟶ V) (c : C ⟶ V) : pairObj a c ⟶ (degreeInclusion Y n).obj C :=
  ⟨𝟙 n, pullback.snd a.hom.left c.hom.left, by
    change _ = (pullback.fst a.hom.left c.hom.left ≫ A.1.hom) ≫ Y.map (𝟙 n).op
    rw [op_id, Y.map_id, Category.comp_id]
    exact (whisker_eq _ (Over.w c.hom).symm).trans ((Category.assoc _ _ _).symm.trans
      ((eq_whisker pullback.condition.symm _).trans ((Category.assoc _ _ _).trans
        (whisker_eq _ (Over.w a.hom)))))⟩

/-- The two projections of `pairObj a c` agree after composing with `a` and `c` respectively. -/
theorem pairFst_comp {n : SimplexCategory} {V A C : SpacesEtale B S hS (Y.obj (op n))}
    (a : A ⟶ V) (c : C ⟶ V) :
    pairFst a c ≫ (degreeInclusion Y n).map a = pairSnd a c ≫ (degreeInclusion Y n).map c :=
  Hom.ext rfl pullback.condition

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

open CategoryTheory.Limits

variable {B S hS} {X Y : SimplicialObject (AlgebraicSpaces B S hS)} (h : X ⟶ Y)

/-- The base change along `h` of a family of morphisms of the spaces-étale site of `Y_n` with
common target `U`. -/
noncomputable def pullbackCover {U : SimplicialSpacesEtaleSite B S hS Y}
    (E : PreZeroHypercover.{u + 1} U.obj) : PreZeroHypercover.{u + 1} (pullbackObj h U).obj where
  I₀ := E.I₀
  X i := (pullbackObj h ((degreeInclusion Y U.degree).obj (E.X i))).obj
  f i := ObjectProperty.homMk (Over.homMk
    ((pullbackFunctor h).map ((degreeInclusion Y U.degree).map (E.f i))).hom
    (((pullbackFunctor h).map ((degreeInclusion Y U.degree).map (E.f i))).w.trans (by
      change pullback.snd _ _ ≫ X.map (𝟙 U.degree).op = pullback.snd _ _
      rw [op_id, X.map_id, Category.comp_id])))

/-- The base change of a covering family is a covering family. -/
theorem pullbackCover_isCovering {U : SimplicialSpacesEtaleSite B S hS Y}
    (E : PreZeroHypercover.{u + 1} U.obj)
    (hE : SpacesEtale.IsCovering B S hS (Y.obj (op U.degree)) ⟨U.obj, E⟩) :
    SpacesEtale.IsCovering B S hS (X.obj (op U.degree))
      ⟨(pullbackObj h U).obj, pullbackCover h E⟩ := by
  intro x
  obtain ⟨i, y, hy⟩ :=
    hE (pointsMap B S hS _ (pullback.fst U.obj.1.hom (h.app (op U.degree))).hom x)
  have hm : ((pullbackCover h E).f i).hom.left ≫ pullback.snd U.obj.1.hom (h.app (op U.degree)) =
      pullback.snd (E.X i).1.hom (h.app (op U.degree)) := Over.w ((pullbackCover h E).f i).hom
  have s : IsPullback (((pullbackCover h E).f i).hom.left ≫
      pullback.snd U.obj.1.hom (h.app (op U.degree)))
      (pullback.fst (E.X i).1.hom (h.app (op U.degree))) (h.app (op U.degree))
      ((E.f i).hom.left ≫ U.obj.1.hom) := by
    rw [hm, Over.w (E.f i).hom]
    exact (IsPullback.of_hasPullback _ _).flip
  have sq := IsPullback.of_right s (pullback.lift_fst _ _ _)
    (IsPullback.of_hasPullback U.obj.1.hom (h.app (op U.degree))).flip
  obtain ⟨w, hw, -⟩ := exists_point_of_isPullback B S hS sq x y hy.symm
  exact ⟨i, w, hw⟩

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

open CategoryTheory.Limits

variable {B S hS} {X Y : SimplicialObject (AlgebraicSpaces B S hS)} (h : X ⟶ Y)

/-- A pair of morphisms into the base changes of two members of a family, agreeing over the base
change of the target, factors through the base change of their fibre product. -/
theorem exists_lift_pullbackFunctor_pair {n : SimplexCategory}
    {V A C : SpacesEtale B S hS (Y.obj (op n))} (a : A ⟶ V) (c : C ⟶ V)
    {Z : SimplicialSpacesEtaleSite B S hS X}
    (gi : Z ⟶ (pullbackFunctor h).obj ((degreeInclusion Y n).obj A))
    (gj : Z ⟶ (pullbackFunctor h).obj ((degreeInclusion Y n).obj C))
    (w : gi ≫ (pullbackFunctor h).map ((degreeInclusion Y n).map a) =
      gj ≫ (pullbackFunctor h).map ((degreeInclusion Y n).map c)) :
    ∃ ℓ : Z ⟶ (pullbackFunctor h).obj (pairObj a c),
      ℓ ≫ (pullbackFunctor h).map (pairFst a c) = gi ∧
        ℓ ≫ (pullbackFunctor h).map (pairSnd a c) = gj := by
  have hb : gi.base = gj.base :=
    (Category.id_comp _).symm.trans ((congrArg Hom.base w).trans (Category.id_comp _))
  have hw : gi.hom ≫ ((pullbackFunctor h).map ((degreeInclusion Y n).map a)).hom =
      gj.hom ≫ ((pullbackFunctor h).map ((degreeInclusion Y n).map c)).hom :=
    congrArg Hom.hom w
  have hf : ∀ {D : SpacesEtale B S hS (Y.obj (op n))} (d : D ⟶ V),
      ((pullbackFunctor h).map ((degreeInclusion Y n).map d)).hom ≫
        pullback.fst V.1.hom (h.app (op n)) = pullback.fst D.1.hom (h.app (op n)) ≫ d.hom.left :=
    fun _ => pullback.lift_fst _ _ _
  have c₁ : (gi.hom ≫ pullback.fst A.1.hom (h.app (op n))) ≫ a.hom.left =
      (gj.hom ≫ pullback.fst C.1.hom (h.app (op n))) ≫ c.hom.left :=
    (Category.assoc _ _ _).trans ((whisker_eq _ (hf a).symm).trans
      ((Category.assoc _ _ _).symm.trans ((eq_whisker hw _).trans ((Category.assoc _ _ _).trans
        ((whisker_eq _ (hf c)).trans (Category.assoc _ _ _).symm)))))
  have c₂ : pullback.lift _ _ c₁ ≫ (pairObj a c).obj.1.hom =
      (Z.obj.1.hom ≫ X.map gi.base.op) ≫ h.app (op n) :=
    (Category.assoc _ _ _).symm.trans ((eq_whisker (pullback.lift_fst _ _ _) _).trans
      ((Category.assoc _ _ _).trans ((whisker_eq _ pullback.condition).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker gi.w _)))))
  have hi : (Z.obj.1.hom ≫ X.map gi.base.op) ≫ X.map (𝟙 n).op = Z.obj.1.hom ≫ X.map gi.base.op :=
    (whisker_eq _ (X.map_id _)).trans (Category.comp_id _)
  have hj : (Z.obj.1.hom ≫ X.map gi.base.op) ≫ X.map (𝟙 n).op = Z.obj.1.hom ≫ X.map gj.base.op :=
    hi.trans (congrArg (fun t : n ⟶ Z.degree => Z.obj.1.hom ≫ X.map t.op) hb)
  refine ⟨⟨gi.base, pullback.lift (pullback.lift _ _ c₁) (Z.obj.1.hom ≫ X.map gi.base.op) c₂,
    pullback.lift_snd _ _ _⟩, Hom.ext (Category.id_comp _) ?_,
    Hom.ext ((Category.id_comp _).trans hb) ?_⟩
  all_goals refine pullback.hom_ext ?_ ?_
  all_goals exact (Category.assoc _ _ _).trans ((whisker_eq _ (by
    first | exact pullback.lift_fst _ _ _ | exact pullback.lift_snd _ _ _)).trans
      ((Category.assoc _ _ _).symm.trans ((eq_whisker (by
        first | exact pullback.lift_fst _ _ _ | exact pullback.lift_snd _ _ _) _).trans (by
          first
          | exact pullback.lift_fst _ _ _
          | exact pullback.lift_snd _ _ _
          | exact hi.trans gi.w.symm
          | exact hj.trans gj.w.symm))))

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

variable {B S hS} {X Y : SimplicialObject (AlgebraicSpaces B S hS)} (h : X ⟶ Y)

/-- Restricting a sheaf on `X_{spaces,étale}` along base change by `h` gives a sheaf on
`Y_{spaces,étale}`. -/
theorem isSheaf_pullbackFunctor_op_comp
    {P : (SimplicialSpacesEtaleSite B S hS X)ᵒᵖ ⥤ Type*} (hP : Presieve.IsSheaf (topology X) P) :
    Presieve.IsSheaf (topology Y) ((pullbackFunctor h).op ⋙ P) := by
  rw [Presieve.isSheaf_coverage]
  rintro U R ⟨E, hE, rfl⟩
  have hR' : Presieve.ofArrows
      (fun i => (degreeInclusion X U.degree).obj ((pullbackCover h E).X i))
      (fun i => (degreeInclusion X U.degree).map ((pullbackCover h E).f i)) ∈
        (coverage X).coverings ((pullbackFunctor h).obj U) :=
    ⟨pullbackCover h E, pullbackCover_isCovering h E hE, rfl⟩
  have hsh := (Presieve.isSheaf_coverage _ P).1 hP _ hR'
  change Presieve.IsSheafFor P (Presieve.ofArrows
    (fun i => (pullbackFunctor h).obj ((degreeInclusion Y U.degree).obj (E.X i)))
    (fun i => (pullbackFunctor h).map ((degreeInclusion Y U.degree).map (E.f i)))) at hsh
  rw [Presieve.isSheafFor_arrows_iff] at hsh
  refine (Presieve.isSheafFor_arrows_iff ((pullbackFunctor h).op ⋙ P)
    (fun i => (degreeInclusion Y U.degree).map (E.f i))).2 ?_
  intro x hx
  refine hsh x fun i j Z gi gj w => ?_
  obtain ⟨ℓ, h₁, h₂⟩ := exists_lift_pullbackFunctor_pair h (E.f i) (E.f j) gi gj w
  have hc := hx i j (pairObj (E.f i) (E.f j)) (pairFst (E.f i) (E.f j)) (pairSnd (E.f i) (E.f j))
    (pairFst_comp (E.f i) (E.f j))
  change P.map ((pullbackFunctor h).map (pairFst (E.f i) (E.f j))).op (x i) =
    P.map ((pullbackFunctor h).map (pairSnd (E.f i) (E.f j))).op (x j) at hc
  rw [← h₁, ← h₂, op_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply,
    hc]

/-- **Stacks 0DE7.** Base change along a morphism `h : X ⟶ Y` of simplicial algebraic spaces is
continuous for the spaces-étale topologies. -/
instance pullbackFunctor_isContinuous :
    (pullbackFunctor h).IsContinuous (topology Y) (topology X) where
  op_comp_isSheaf_of_types G :=
    isSheaf_pullbackFunctor_op_comp h ((isSheaf_iff_isSheaf_of_type _ _).1 G.2)

end SimplicialSpacesEtaleSite

namespace SimplicialSpacesEtaleSite

open CategoryTheory.Limits

variable {B S hS} {X Y : SimplicialObject (AlgebraicSpaces B S hS)} (h : X ⟶ Y)

/-- The projections `V ×_{Y_n} X_n ⟶ V`, natural in `V/Y_n`. -/
@[simps]
noncomputable def pullbackFunctorProjection :
    pullbackFunctor h ⋙ toSpaces X ⟶ toSpaces Y where
  app V := pullback.fst V.obj.1.hom (h.app (op V.degree))
  naturality _ _ _ := pullback.lift_fst _ _ _

/-- **Stacks 0DE7.** The structure map `h♯ : 𝒪_Y ⟶ h_* 𝒪_X` of a morphism of simplicial
algebraic spaces: pullback of global regular functions along `V ×_{Y_n} X_n ⟶ V`. -/
noncomputable def structureSharp :
    structurePresheaf Y ⟶ (pullbackFunctor h).op ⋙ structurePresheaf X :=
  Functor.whiskerRight (NatTrans.op (pullbackFunctorProjection h)) (globalFunctionsPresheaf B S hS)

end SimplicialSpacesEtaleSite

end AlgebraicGeometry.Space
