* [Stacks Project, Tag 09W9](https://stacks.math.columbia.edu/tag/09W9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.BigFppfSpaceSite

variable {S : Scheme.{u}} (T : BigFppfSpaceSite S) (X : T.Spaces)

open Space

/-- **Stacks 0DGF (1) for the inclusion `X_{spaces, étale} → (Spaces/X)_fppf`, on sheaves of
sets**, for the fppf topology `AlgebraicGeometry.Space.fppfTopology`: the unit of `h_X⁻¹ ⊣ h_{X,*}`
is invertible. The statement for the big fppf site `T` (Stacks 0DGF) is carried along the
equality of the topology of `T` with the fppf topology. -/
theorem isIso_spacesEtaleComparison_unit_fppfTopology :
    IsIso
      (spacesEtaleComparisonMorphism (fppfTopology T.schemeSite S T.scheme_mem) X).adj.unit := by
  let a := fppfToSmallEtaleMorphism T T.bigEtaleSpaceSite rfl X
  have ha : IsIso a.adj.unit :=
    (isIso_fppfToSmallEtale_units_and_isZero_rightDerived T T.bigEtaleSpaceSite rfl X).1.2
  let e : Sheaf ((fppfTopology T.schemeSite S T.scheme_mem).over X) (Type (u + 1)) ≌
      Sheaf (BigFppfSpaceOver.topology T X) (Type (u + 1)) :=
    sheafEquivOfTopologyEq (congrArg (·.over X) T.topology_eq_spaceFppfTopology.symm)
      (Type (u + 1))
  let iso : e.functor ⋙ a.pushforward ≅
      (spacesEtaleComparisonMorphism (fppfTopology T.schemeSite S T.scheme_mem) X).pushforward :=
    NatIso.ofComponents (fun _ ↦ (fullyFaithfulSheafToPresheaf _ _).preimageIso (Iso.refl _))
      (fun _ ↦ by
        apply Sheaf.hom_ext
        rfl)
  let adj₂ := (a.adj.comp e.symm.toAdjunction).ofNatIsoRight iso
  have hff : (a.inverseImage ⋙ e.inverse).FullyFaithful :=
    a.adj.fullyFaithfulLOfIsIsoUnit.comp e.symm.fullyFaithfulFunctor
  have hff' := hff.ofIso (adj₂.leftAdjointUniq
    (spacesEtaleComparisonMorphism (fppfTopology T.schemeSite S T.scheme_mem) X).adj)
  exact @Adjunction.unit_isIso_of_L_fully_faithful _ _ _ _ _ _ _ hff'.full hff'.faithful

end AlgebraicGeometry.BigFppfSpaceSite

namespace AlgebraicGeometry.Space

open Stacks.Topos.AbelianPushforward

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- The abelian direct image of `h_X : Sh((Spaces/X)_fppf) → Sh(X_étale)` is restriction along
`W ↦ W/X`. -/
def fppfComparisonAbelianPushforwardIso (X : AlgebraicSpaces B S hS) :
    abelianPushforward ((fppfTopology B S hS).over X)
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) X) ≅
      fppfSpacesEtaleAbelianDirectImage X :=
  abelianPushforwardIsoSheafPushforwardContinuous (SpacesEtale.inclusion B S hS X) _ _
    (spacesEtaleComparisonMorphism (fppfTopology B S hS) X) (Iso.refl _)

/-- **Stacks 0DGF (1) for `h_X`, on abelian sheaves**: the unit `F → h_{X,*}h_X⁻¹F` is an
isomorphism for every abelian sheaf `F` on `X_étale`. -/
theorem isIso_fppfComparison_abelianUnit_app (X : AlgebraicSpaces B S hS)
    (F : Sheaf (SpacesEtale.topology B S hS X) AddCommGrpCat.{u + 1}) :
    IsIso ((abelianInverseImageAdjPushforward ((fppfTopology B S hS).over X)
      (spacesEtaleComparisonMorphism (fppfTopology B S hS) X)).unit.app F) :=
  (Adjunction.isIso_unit_app_iff_of_iso _ (fppfSpacesEtaleAbelianAdjunction X)
    (fppfComparisonAbelianPushforwardIso X) F).2
      (fppfSpacesEtaleAcyclic_of_algebraicSpace X F).1

/-- **Stacks 0DGF (2) for `h_X`**: `R^q h_{X,*}(h_X⁻¹F) = 0` for `q > 0` and every abelian sheaf
`F` on `X_étale`. -/
theorem isZero_rightDerived_fppfComparison (X : AlgebraicSpaces B S hS)
    (F : Sheaf (SpacesEtale.topology B S hS X) AddCommGrpCat.{u + 1}) (q : ℕ) (hq : 0 < q) :
    haveI : (abelianPushforward ((fppfTopology B S hS).over X)
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) X)).Additive :=
      abelianPushforward_additive _ _
    IsZero (((abelianPushforward ((fppfTopology B S hS).over X)
      (spacesEtaleComparisonMorphism (fppfTopology B S hS) X)).rightDerived q).obj
        ((CategoryTheory.Sites.abelianInverseImage
          (spacesEtaleComparisonMorphism (fppfTopology B S hS) X)).obj F)) := by
  let e := fppfComparisonAbelianPushforwardIso X
  let i : (CategoryTheory.Sites.abelianInverseImage
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) X)).obj F ≅
      (fppfSpacesEtaleAbelianInverseImage X).obj F :=
    (Adjunction.leftAdjointIsoOfIso (abelianInverseImageAdjPushforward _
      (spacesEtaleComparisonMorphism (fppfTopology B S hS) X))
        (fppfSpacesEtaleAbelianAdjunction X) e).app F
  exact ((fppfSpacesEtaleAcyclic_of_algebraicSpace X F).2 q hq).of_iso
    ((Functor.rightDerivedIsoOfNatIso e q).app _ ≪≫
      ((fppfSpacesEtaleAbelianDirectImage X).rightDerived q).mapIso i)

/-- **Stacks 0DGF (1) for `h_X`, on sheaves of sets**: the inverse image along
`X_{spaces, étale} → (Spaces/X)_fppf` is fully faithful, its unit being invertible. -/
theorem isIso_fppfComparison_unit (X : AlgebraicSpaces B S hS) :
    IsIso (spacesEtaleComparisonMorphism (fppfTopology B S hS) X).adj.unit :=
  (bigFppfSpaceSiteOfSchemeSite B S hS).isIso_spacesEtaleComparison_unit_fppfTopology X

/-! ### Base change for the comparisons `h_X` -/

section BaseChange

variable {X Y : AlgebraicSpaces B S hS} (f : Y ⟶ X)

/-- The morphism of topoi `f_{big} : Sh((Spaces/Y)_fppf) → Sh((Spaces/X)_fppf)` of a morphism
`f : Y ⟶ X` of algebraic spaces (Stacks 09W9), given by the base change `V/X ↦ V ×_X Y / Y`. -/
abbrev fppfOverMorphism :
    MorphismOfTopoi (Sheaf ((fppfTopology B S hS).over Y) (Type (u + 1)))
      (Sheaf ((fppfTopology B S hS).over X) (Type (u + 1))) :=
  (StacksRelocalization.isMorphismOfSites_overPullback (fppfTopology B S hS) f).morphismOfTopoi

/-- **Base change for the comparisons `h_X`, on direct images**: for `f : Y ⟶ X`,
`f_{small,*} ∘ h_{Y,*} = h_{X,*} ∘ f_{big,*}`, both being restriction along `W ↦ W ×_X Y / Y`. -/
def fppfComparisonPushforwardSquareIso :
    (spacesEtaleComparisonMorphism (fppfTopology B S hS) Y).pushforward ⋙
        (spacesBaseChange_isMorphismOfSites B S hS f).morphismOfTopoi.pushforward ≅
      (fppfOverMorphism f).pushforward ⋙
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) X).pushforward :=
  Iso.refl _

/-- **Base change for the comparisons `h_X`, on inverse images**: the conjugate of
`fppfComparisonPushforwardSquareIso`. -/
def fppfComparisonInverseImageSquareIso :
    (spacesEtaleComparisonMorphism (fppfTopology B S hS) X).inverseImage ⋙
        (fppfOverMorphism f).inverseImage ≅
      (spacesBaseChange_isMorphismOfSites B S hS f).morphismOfTopoi.inverseImage ⋙
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) Y).inverseImage :=
  (conjugateIsoEquiv
    ((spacesBaseChange_isMorphismOfSites B S hS f).morphismOfTopoi.adj.comp
      (spacesEtaleComparisonMorphism (fppfTopology B S hS) Y).adj)
    ((spacesEtaleComparisonMorphism (fppfTopology B S hS) X).adj.comp
      (fppfOverMorphism f).adj)).symm
      (fppfComparisonPushforwardSquareIso f)

set_option synthInstance.maxHeartbeats 400000 in
-- Synthesising the pointwise left Kan extension instance needs the limits of presheaves on
-- `BigFppfOver`, which times out under the default `synthInstance.maxHeartbeats`.
/-- Restriction of sheaves along `Over.map f : Spaces/Y ⥤ Spaces/X` is a right adjoint. -/
instance isRightAdjoint_overMap_sheafPushforwardContinuous_fppf :
    ((Over.map f).sheafPushforwardContinuous (Type (u + 1))
      ((fppfTopology B S hS).over Y) ((fppfTopology B S hS).over X)).IsRightAdjoint :=
  haveI : ∀ F : (Over Y)ᵒᵖ ⥤ Type (u + 1), (Over.map f).op.HasPointwiseLeftKanExtension F :=
    fun _ ↦ inferInstance
  ⟨_, ⟨Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (Over.map f) (Type (u + 1))
    ((fppfTopology B S hS).over Y) ((fppfTopology B S hS).over X)⟩⟩

/-- **Base change for the comparisons `h_X`, on abelian sheaves**: restricting `h_X⁻¹F`
to `(Spaces/Y)_fppf` along `f : Y ⟶ X` is `h_Y⁻¹ f_{small}⁻¹ F`. -/
def fppfComparisonAbelianInverseImageSquareIso :
    CategoryTheory.Sites.abelianInverseImage
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) X) ⋙
        (Over.map f).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
          ((fppfTopology B S hS).over Y) ((fppfTopology B S hS).over X) ≅
      CategoryTheory.Sites.abelianInverseImage
          (spacesBaseChange_isMorphismOfSites B S hS f).morphismOfTopoi ⋙
        CategoryTheory.Sites.abelianInverseImage
          (spacesEtaleComparisonMorphism (fppfTopology B S hS) Y) :=
  Functor.isoWhiskerLeft _ (CategoryTheory.Sites.abelianInverseImageIsoSheafPushforwardContinuous
      (Over.map f) _ _ (fppfOverMorphism f)
      (StacksRelocalization.sheafPullbackOverPullbackIso (fppfTopology B S hS) f)).symm ≪≫
    StacksTag03LR.abelianInverseImageSquareIso _ _ _ _ (fppfComparisonInverseImageSquareIso f)

end BaseChange

/-! ### The comparison `h` of the fppf total site with `U_étale` -/

section Total

open EtaleComponent

variable (A : SimplicialObject.Augmented (AlgebraicSpaces B S hS))

/-- **`h⁻¹` is fully faithful** for the comparison `h : Sh((Spaces/U)_{fppf, total}) → Sh(U_étale)`
of Stacks 0DH5: the unit of `h⁻¹ ⊣ h_*` is an isomorphism, the inverse images along
`X_{spaces, étale} → (Spaces/X)_fppf` being fully faithful (Stacks 0DGF (1)). -/
instance isIso_phComparisonMorphism_fppf_adj_unit :
    IsIso (phComparisonMorphism A (fppfTopology B S hS)).adj.unit :=
  have hff := fullyFaithfulPhComparisonInverseImage (A := A) (fppfTopology B S hS)
    isIso_fppfComparison_unit
  haveI := hff.full
  haveI := hff.faithful
  (phComparisonMorphism A (fppfTopology B S hS)).adj.unit_isIso_of_L_fully_faithful

/-- **The square of Stacks 0DH5 on abelian direct images**:
`h_{-1,*} ∘ a_{fppf,*} ≅ a_* ∘ h_*`. -/
def fppfComparisonSquareAbelianPushforwardIso :
    abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
        (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom) ⋙
      abelianPushforward ((fppfTopology B S hS).over A.right)
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right) ≅
    abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
        (phComparisonMorphism A (fppfTopology B S hS)) ⋙
      abelianPushforward (etaleSimplicialSite A).totalTopology (etaleAugmentationMorphism A) :=
  conjugateIsoEquiv
    ((abelianInverseImageAdjPushforward _
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right)).comp
      (abelianInverseImageAdjPushforward _
        (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom)))
    ((abelianInverseImageAdjPushforward _ (etaleAugmentationMorphism A)).comp
      (abelianInverseImageAdjPushforward _ (phComparisonMorphism A (fppfTopology B S hS))))
    (StacksTag03LR.abelianInverseImageSquareIso _ _ _ _
      (phComparisonSquareInverseImageIso A (fppfTopology B S hS)))

/-- The abelian direct image of `h` is restriction along the comparison functor. -/
def fppfPhComparisonAbelianPushforwardIso :
    haveI := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
    abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
        (phComparisonMorphism A (fppfTopology B S hS)) ≅
      (phComparisonFunctor A).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
        (etaleSimplicialSite A).totalTopology
        (SimplicialOver.totalTopology (fppfTopology B S hS) A.left) :=
  haveI := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
  haveI : ((phComparisonFunctor A).sheafPushforwardContinuous (Type (u + 1))
      (etaleSimplicialSite A).totalTopology
        (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)).IsRightAdjoint :=
    ⟨_, ⟨(phComparisonMorphism A (fppfTopology B S hS)).adj⟩⟩
  abelianPushforwardIsoSheafPushforwardContinuous (phComparisonFunctor A) _ _
    (phComparisonMorphism A (fppfTopology B S hS)) (Iso.refl _)

/-- The direct image of abelian sheaves along the comparison of degree `b`, from
`(Spaces/U_b)_fppf` to the degree-`b` component of `U_étale`: restriction along
`V/U_b ↦ V/U_b`. -/
abbrev fppfComparisonDegreeAb (b : SimplexCategoryᵒᵖ) :
    Sheaf ((fppfTopology B S hS).over (A.left.obj b)) AddCommGrpCat.{u + 1} ⥤
      Sheaf (precoverage (A := A) b.unop).toGrothendieck AddCommGrpCat.{u + 1} :=
  (realizeFunctor (A := A) b.unop ⋙ SpacesEtale.inclusion B S hS (A.left.obj b)
    ).sheafPushforwardContinuous AddCommGrpCat.{u + 1} (precoverage (A := A) b.unop).toGrothendieck
      ((fppfTopology B S hS).over (A.left.obj b))

/-- The higher direct images along the comparison of degree `b` vanish at `h_{U_b}⁻¹ G` for every
abelian sheaf `G` on `U_b`: the comparison of degree `b` is that of `U_b` followed by the
equivalence of topoi of Section 0DE7, and Stacks 0DGF (2) holds for `U_b`. -/
theorem isZero_rightDerived_fppfComparisonDegreeAb (b : SimplexCategoryᵒᵖ)
    (G : Sheaf (SpacesEtale.topology B S hS (A.left.obj b)) AddCommGrpCat.{u + 1})
    (q : ℕ) (hq : 0 < q) :
    IsZero (((fppfComparisonDegreeAb A b).rightDerived q).obj
      ((CategoryTheory.Sites.abelianInverseImage
        (spacesEtaleComparisonMorphism (fppfTopology B S hS) (A.left.obj b))).obj G)) := by
  let Rincl := (SpacesEtale.inclusion B S hS (A.left.obj b)).sheafPushforwardContinuous
    AddCommGrpCat.{u + 1} (SpacesEtale.topology B S hS (A.left.obj b))
      ((fppfTopology B S hS).over (A.left.obj b))
  let Rreal := (EtaleComponent.sheafEquiv (A := A) b.unop AddCommGrpCat.{u + 1}).inverse
  have : Rreal.Additive := Functor.additive_of_preserves_binary_products _
  have : Rreal.PreservesHomology := Functor.preservesHomologyOfExact _
  have : (fppfComparisonDegreeAb A b).Additive := Functor.additive_of_preserves_binary_products _
  have e : (fppfComparisonDegreeAb A b).rightDerived q ≅ Rincl.rightDerived q ⋙ Rreal :=
    Functor.rightDerivedCompIso Rincl Rreal q
  refine (Rreal.map_isZero ?_).of_iso (e.app _)
  exact (isZero_rightDerived_fppfComparison (A.left.obj b) G q hq).of_iso
    ((Functor.rightDerivedIsoOfNatIso (fppfComparisonAbelianPushforwardIso _) q).app _).symm

/-- The inclusion of the simplicial degree `b` into the total category of `U_étale` is
continuous (Stacks 09WG). -/
instance etaleDegreeInclusion_isContinuous_precoverage (b : SimplexCategoryᵒᵖ) :
    (Pseudofunctor.CoGrothendieck.ι (etaleSimplicialSite A).totalPseudofunctor b).IsContinuous
      (precoverage (A := A) b.unop).toGrothendieck (etaleSimplicialSite A).totalTopology :=
  SimplicialSiteSituation.componentFunctor_isContinuous (etaleSituation A) b.unop

/-- The inclusion of the simplicial degree `b` into the total category of `U_étale` is
cocontinuous (Stacks 09WG). -/
instance etaleDegreeInclusion_isCocontinuous_precoverage (b : SimplexCategoryᵒᵖ) :
    (Pseudofunctor.CoGrothendieck.ι (etaleSimplicialSite A).totalPseudofunctor b).IsCocontinuous
      (precoverage (A := A) b.unop).toGrothendieck (etaleSimplicialSite A).totalTopology :=
  SimplicialSiteSituation.componentFunctor_isCocontinuous (etaleSituation A) b.unop

/-- Restriction of abelian sheaves on `U_étale` to the simplicial degree `b`, on the strict model
of the degree-`b` component. -/
abbrev etaleDegreeRestrictionAb (b : SimplexCategoryᵒᵖ) :
    Sheaf (etaleSimplicialSite A).totalTopology AddCommGrpCat.{u + 1} ⥤
      Sheaf (precoverage (A := A) b.unop).toGrothendieck AddCommGrpCat.{u + 1} :=
  (Pseudofunctor.CoGrothendieck.ι (etaleSimplicialSite A).totalPseudofunctor b
    ).sheafPushforwardContinuous AddCommGrpCat.{u + 1} (precoverage (A := A) b.unop).toGrothendieck
      (etaleSimplicialSite A).totalTopology

/-- Restriction to a simplicial degree of `U_étale` is left exact. -/
instance etaleDegreeRestrictionAb_preservesFiniteLimits (b : SimplexCategoryᵒᵖ) :
    PreservesFiniteLimits (etaleDegreeRestrictionAb A b) :=
  Functor.preservesFiniteLimits_sheafPushforwardContinuous _ _ _ AddCommGrpCat.{u + 1}

/-- Restriction to a simplicial degree of `U_étale` is right exact, being a left adjoint. -/
instance etaleDegreeRestrictionAb_preservesFiniteColimits (b : SimplexCategoryᵒᵖ) :
    PreservesFiniteColimits (etaleDegreeRestrictionAb A b) :=
  haveI : PreservesColimitsOfSize.{0, 0} (etaleDegreeRestrictionAb A b) :=
    ((Pseudofunctor.CoGrothendieck.ι (etaleSimplicialSite A).totalPseudofunctor b
      ).sheafAdjunctionCocontinuous AddCommGrpCat.{u + 1}
        (precoverage (A := A) b.unop).toGrothendieck
        (etaleSimplicialSite A).totalTopology).leftAdjoint_preservesColimits
  PreservesColimitsOfSize.preservesFiniteColimits _

/-- Restriction to a simplicial degree of `U_étale` is additive. -/
instance etaleDegreeRestrictionAb_additive (b : SimplexCategoryᵒᵖ) :
    (etaleDegreeRestrictionAb A b).Additive :=
  Functor.additive_of_preserves_binary_products _

/-- Restriction to a simplicial degree of `U_étale` is exact. -/
instance etaleDegreeRestrictionAb_preservesHomology (b : SimplexCategoryᵒᵖ) :
    (etaleDegreeRestrictionAb A b).PreservesHomology :=
  Functor.preservesHomologyOfExact _

/-- The comparison functor in degree `b`, followed by the inclusion of that degree into
`(Spaces/U)_{fppf, total}`, is continuous. -/
instance fppfPhComparisonFib_isContinuous (b : SimplexCategoryᵒᵖ) :
    (phComparisonFib (A := A) b).IsContinuous (precoverage (A := A) b.unop).toGrothendieck
      (SimplicialOver.totalTopology (fppfTopology B S hS) A.left) :=
  @Functor.isContinuous_comp _ _ _ _ _ _ (realizeFunctor (A := A) b.unop ⋙
    SpacesEtale.inclusion B S hS (A.left.obj b)) (Grothendieck.ι (SimplicialOver.slices A.left) b)
    (precoverage (A := A) b.unop).toGrothendieck ((fppfTopology B S hS).over (A.left.obj b))
    (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
    (phComparisonFib_realize_isContinuous (A := A) (fppfTopology B S hS) b)
    (SimplicialOver.ι_isContinuous A.left (fppfTopology B S hS) b)

/-- Restricting `h_*` to the simplicial degree `b` is restricting to the degree `b` and then taking
the direct image along the comparison of degree `b`. -/
def fppfPhComparisonRestrictionSquareIso (b : SimplexCategoryᵒᵖ) :
    haveI := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
    (phComparisonFunctor A).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
        (etaleSimplicialSite A).totalTopology
        (SimplicialOver.totalTopology (fppfTopology B S hS) A.left) ⋙
      etaleDegreeRestrictionAb A b ≅
    SimplicialOver.componentRestrictionAb A.left (fppfTopology B S hS) b ⋙
      fppfComparisonDegreeAb A b :=
  haveI := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
  Functor.sheafPushforwardContinuousComp' (G := phComparisonFunctor A)
      (Pseudofunctor.CoGrothendieck.ιCompFunctorFrom phComparisonFib (fun f => phComparisonHom f)
        phComparisonHom_id (fun f g => phComparisonHom_comp f g) b :
        Pseudofunctor.CoGrothendieck.ι (etaleSimplicialSite A).totalPseudofunctor b ⋙
          phComparisonFunctor A ≅ phComparisonFib b) AddCommGrpCat.{u + 1}
      (precoverage (A := A) b.unop).toGrothendieck
      (etaleSimplicialSite A).totalTopology
      (SimplicialOver.totalTopology (fppfTopology B S hS) A.left) ≪≫
    Iso.refl _

/-- In each simplicial degree, `R^q h_*` of `a_fppf⁻¹ h₋₁⁻¹ F` vanishes. -/
theorem isZero_etaleDegreeRestrictionAb_rightDerived_fppfPhComparison (b : SimplexCategoryᵒᵖ)
    (F : Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1}) (q : ℕ)
    (hq : 0 < q) :
    haveI := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
    IsZero ((etaleDegreeRestrictionAb A b).obj
      ((((phComparisonFunctor A).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
        (etaleSimplicialSite A).totalTopology
          (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)).rightDerived q).obj
        ((CategoryTheory.Sites.abelianInverseImage
          (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom)).obj
            ((CategoryTheory.Sites.abelianInverseImage
              (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right)).obj F)))) := by
  have := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
  let f : A.left.obj b ⟶ A.right := SimplicialOver.augmentationApp A.left A.hom b
  have : ((phComparisonFunctor A).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
      (etaleSimplicialSite A).totalTopology
        (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)).Additive :=
    Functor.additive_of_preserves_binary_products _
  refine (isZero_rightDerived_fppfComparisonDegreeAb A b
    ((CategoryTheory.Sites.abelianInverseImage
      (spacesBaseChange_isMorphismOfSites B S hS f).morphismOfTopoi).obj F) q hq).of_iso ?_
  exact ((Functor.rightDerivedIsoOfSquare
      (SimplicialOver.componentRestrictionAb A.left (fppfTopology B S hS) b)
      ((phComparisonFunctor A).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
        (etaleSimplicialSite A).totalTopology
        (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)) (fppfComparisonDegreeAb A b)
      (etaleDegreeRestrictionAb A b)
      (fppfPhComparisonRestrictionSquareIso A b) q).app _) ≪≫
    ((fppfComparisonDegreeAb A b).rightDerived q).mapIso
      ((SimplicialOver.augmentationAbelianInverseImageCompRestrictionIso A.left A.hom
          (fppfTopology B S hS) b).app _ ≪≫
        (fppfComparisonAbelianInverseImageSquareIso f).app F)

/-- **`a_fppf⁻¹ h₋₁⁻¹ F` is acyclic for `h_*`**, for every abelian sheaf `F` on `X_étale`. -/
theorem isZero_rightDerived_fppfPhComparison
    (F : Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1}) (q : ℕ)
    (hq : 0 < q) :
    haveI : (abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
        (phComparisonMorphism A (fppfTopology B S hS))).Additive :=
      abelianPushforward_additive _ _
    IsZero (((abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
      (phComparisonMorphism A (fppfTopology B S hS))).rightDerived q).obj
        ((CategoryTheory.Sites.abelianInverseImage
          (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom)).obj
            ((CategoryTheory.Sites.abelianInverseImage
              (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right)).obj F))) := by
  have := phComparisonFunctor_isContinuous (A := A) (fppfTopology B S hS)
  refine IsZero.of_iso ?_ ((Functor.rightDerivedIsoOfNatIso
    (fppfPhComparisonAbelianPushforwardIso A) q).app _)
  refine IsZero.of_full_of_faithful_of_isZero
    (sheafToPresheaf (etaleSimplicialSite A).totalTopology AddCommGrpCat.{u + 1}) _
    (Functor.isZero _ fun x => ?_)
  exact ((sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (op x.unop.fiber)).map_isZero
    (isZero_etaleDegreeRestrictionAb_rightDerived_fppfPhComparison A x.unop.base F q hq))

end Total

/-! ### Cohomological descent along an fppf hypercovering -/

section Descent

open SimplicialSiteSituation.Augmentation in
attribute [local instance] additive_totalInverseImageAb_etaleAugmentation
  preservesFiniteLimits_totalInverseImageAb_etaleAugmentation
  preservesFiniteColimits_totalInverseImageAb_etaleAugmentation
  additive_abelianTotalPushforward_etaleAugmentation

variable {A : SimplicialObject.Augmented (AlgebraicSpaces B S hS)} (hA : IsFppfHypercovering A)
include hA

/-- The units of `a_fppf` at `h₋₁⁻¹F` and of `h` at `a⁻¹F` are invertible. -/
private theorem isIso_units_fppfHypercovering_square
    (F : Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1}) :
    IsIso ((abelianInverseImageAdjPushforward _
      (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom)).unit.app
        ((CategoryTheory.Sites.abelianInverseImage
          (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right)).obj F)) ∧
    IsIso ((abelianInverseImageAdjPushforward _
      (phComparisonMorphism A (fppfTopology B S hS))).unit.app
        ((CategoryTheory.Sites.abelianInverseImage (etaleAugmentationMorphism A)).obj F)) :=
  ⟨SimplicialOver.isIso_augmentationAbelianUnit_app_of_eq (fppfPretopology B S hS)
    (fppfPretopology_toGrothendieck B S hS)
    (isHypercoveringAugmentation_of_isFppfHypercovering hA) _,
  isIso_abelianInverseImageAdjPushforward_unit_app _ _ _ (NatIso.isIso_app_of_isIso _ _)⟩

/-- **The unit `F → a_*a⁻¹F` is invertible** on abelian sheaves, for an fppf hypercovering: the
units of `h`, `a_fppf` and `h₋₁` around the square of Stacks 0DH5 are invertible (Stacks 0DGF (1)
degreewise, Stacks 0DA8 for the fppf hypercovering, Stacks 0DGF (1) for `X`). -/
theorem IsFppfHypercovering.isIso_etaleAugmentation_abelianUnit_app
    (F : Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1}) :
    IsIso ((abelianInverseImageAdjPushforward (etaleSimplicialSite A).totalTopology
      (etaleAugmentationMorphism A)).unit.app F) := by
  have := isIso_fppfComparison_abelianUnit_app A.right F
  obtain ⟨_, _⟩ := isIso_units_fppfHypercovering_square hA F
  exact Adjunction.isIso_unit_app_of_comp_iso
    (abelianInverseImageAdjPushforward _ (etaleAugmentationMorphism A))
    (abelianInverseImageAdjPushforward _ (phComparisonMorphism A (fppfTopology B S hS)))
    (abelianInverseImageAdjPushforward _
      (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom))
    (abelianInverseImageAdjPushforward _
      (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right))
    (fppfComparisonSquareAbelianPushforwardIso A) F

/-- **`a⁻¹F` is acyclic for `a_*`** for every abelian sheaf `F` on `X_étale` and an fppf
hypercovering: `R^q a_*(a⁻¹F) = 0` for `q > 0`. -/
theorem IsFppfHypercovering.isZero_rightDerived_etaleAugmentation
    (F : Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1}) (q : ℕ)
    (hq : 0 < q) :
    haveI : (abelianPushforward (etaleSimplicialSite A).totalTopology
        (etaleAugmentationMorphism A)).Additive := abelianPushforward_additive _ _
    IsZero (((abelianPushforward (etaleSimplicialSite A).totalTopology
      (etaleAugmentationMorphism A)).rightDerived q).obj
        ((CategoryTheory.Sites.abelianInverseImage (etaleAugmentationMorphism A)).obj F)) := by
  let adj_h := abelianInverseImageAdjPushforward _ (phComparisonMorphism A (fppfTopology B S hS))
  let adj_b := abelianInverseImageAdjPushforward _
    (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left A.hom)
  have : (abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
      (phComparisonMorphism A (fppfTopology B S hS))).PreservesInjectiveObjects :=
    Functor.preservesInjectiveObjects_of_adjunction_of_preservesMonomorphisms adj_h
  have : (abelianPushforward (SimplicialOver.totalTopology (fppfTopology B S hS) A.left)
      (SimplicialOver.augmentationMorphismOfTopoi (fppfTopology B S hS) A.left
        A.hom)).PreservesInjectiveObjects :=
    Functor.preservesInjectiveObjects_of_adjunction_of_preservesMonomorphisms adj_b
  obtain ⟨_, _⟩ := isIso_units_fppfHypercovering_square hA F
  exact Adjunction.isZero_rightDerived_of_comp_iso
    (abelianInverseImageAdjPushforward _ (etaleAugmentationMorphism A)) adj_h adj_b
    (abelianInverseImageAdjPushforward _
      (spacesEtaleComparisonMorphism (fppfTopology B S hS) A.right))
    (fppfComparisonSquareAbelianPushforwardIso A) F
    (isZero_rightDerived_fppfPhComparison A F)
    (SimplicialOver.isZero_rightDerived_augmentationAbelianPushforward_of_eq
      (fppfPretopology B S hS) (fppfPretopology_toGrothendieck B S hS)
      (isHypercoveringAugmentation_of_isFppfHypercovering hA) _)
    (isZero_rightDerived_fppfComparison A.right F) q hq

/-- **Cohomological descent along an fppf hypercovering** (the content of Stacks 0DH7): the unit
`K ⟶ Ra_*(a⁻¹K)` of the adjunction `a⁻¹ ⊣ Ra_*` on bounded below derived categories is an
isomorphism for every `K ∈ D⁺(X_étale)`, in any model of the derived categories. Here
`a : Sh(U_étale) → Sh(X_étale)` is the morphism of topoi of Section 0DE7 and `a⁻¹` on `D⁺` is the
right derived functor of the exact functor `a⁻¹`. -/
theorem IsFppfHypercovering.isIso_abelianTotalAdjunction_rightDerivedFunctorPlus_unit_app
    [HasDerivedCategory (Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1})]
    [HasDerivedCategory (Sheaf (etaleSituation A).totalTopology AddCommGrpCat.{u + 1})]
    (K : DerivedCategory.Plus (Sheaf (SpacesEtale.topology B S hS A.right) AddCommGrpCat.{u + 1})) :
    IsIso ((SimplicialSiteSituation.Augmentation.abelianTotalAdjunction (etaleSituation A) _ _
      (etaleAugmentation A)).rightDerivedFunctorPlus.unit.app K) := by
  let : HasDerivedCategory (Sheaf (etaleSimplicialSite A).totalTopology AddCommGrpCat.{u + 1}) :=
    ‹HasDerivedCategory (Sheaf (etaleSituation A).totalTopology AddCommGrpCat.{u + 1})›
  have : (CategoryTheory.Sites.abelianInverseImage (etaleAugmentationMorphism A)).Additive :=
    (abelianInverseImageAdjPushforward (etaleSimplicialSite A).totalTopology
      (etaleAugmentationMorphism A)).left_adjoint_additive
  have h := Stacks.ComparingTopologies.isIso_derivedPlusAdjunction_unit_app
    (abelianInverseImageAdjPushforward (etaleSimplicialSite A).totalTopology
      (etaleAugmentationMorphism A))
    (fun F ↦ hA.isIso_etaleAugmentation_abelianUnit_app F)
    (fun F ↦ (CategoryTheory.rightAcyclic_iff_isZero_rightDerived _ _).2
      (hA.isZero_rightDerived_etaleAugmentation F)) K
  exact (Adjunction.isIso_unit_app_iff_of_iso _ (Stacks.ComparingTopologies.derivedPlusAdjunction
    (SimplicialSiteSituation.Augmentation.abelianTotalAdjunction (etaleSituation A) _ _
      (etaleAugmentation A))) (Iso.refl _) K).2 h

end Descent

end AlgebraicGeometry.Space

