module

public import StacksFrontier.AlgebraicGeometry.Spaces.Coverings
public import StacksFrontier.AlgebraicGeometry.Spaces.SimplicialSpaces.EtaleSite
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringBySimplicialObject

/-!
# The fppf site of algebraic spaces and fppf hypercoverings (Section 0DH4)

Let `S` be a scheme. This file equips the category of algebraic spaces over `S` with the fppf
topology, the topology generated by the fppf coverings of Stacks 03Y8, and shows that an fppf
hypercovering `a : U → X` of an algebraic space in the sense of Section 0DH4 is a hypercovering
of `X` in that site in the sense of Stacks 09X8. This is the input of Stacks 0D8N in the proof of
Stacks 0DH7, where `U` is regarded as a hypercovering of `X` in `(Spaces/S)_fppf`.

## Main definitions

* `AlgebraicGeometry.Space.fppfPrecoverage`: the families of morphisms of algebraic spaces over
  `S` which are fppf coverings.
* `AlgebraicGeometry.Space.fppfTopology`: the Grothendieck topology they generate.
* `AlgebraicGeometry.Space.fppfPretopology`: the pretopology of presieves generating a covering
  sieve of that topology, in terms of which the hypercovering conditions of Stacks 09X8 are
  stated.

## Main results

* `AlgebraicGeometry.Space.singleton_mem_fppfPretopology`: a flat, locally finitely presented,
  surjective morphism is a covering of the fppf site.
* `AlgebraicGeometry.Space.isHypercoveringAugmentation_of_isFppfHypercovering`: an fppf
  hypercovering is a hypercovering of `X` in the fppf site.

## Implementation notes

The category of algebraic spaces over `S` is small in the universe of its morphisms, so the
fppf site is used on it directly, without choosing a set-sized system of coverings as in
Stacks 0DBV: the precoverage is a predicate on presieves and generates the fppf topology on the
nose. The covering families are indexed in the universe of the objects.

## References

* [Stacks Project, Tag 03Y8](https://stacks.math.columbia.edu/tag/03Y8)
* [Stacks Project, Tag 0DH4](https://stacks.math.columbia.edu/tag/0DH4)
* [Stacks Project, Tag 09X8](https://stacks.math.columbia.edu/tag/09X8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.CategoryTheory.Hypercovering

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The fppf covering families of algebraic spaces over `S`: the presieves of the families
`{f_i : Y_i → X}` which are fppf coverings in the sense of Stacks 03Y8. -/
def fppfPrecoverage : Precoverage (AlgebraicSpaces B S hS) where
  coverings X := {R | ∃ (I : Type (u + 1)) (Y : I → AlgebraicSpaces B S hS) (f : ∀ i, Y i ⟶ X),
    R = Presieve.ofArrows Y f ∧ Space.IsFppfCovering B S hS (fun i ↦ (Y i).1) (fun i ↦ (f i).hom)}

/-- The fppf topology on the category of algebraic spaces over `S`. -/
abbrev fppfTopology : GrothendieckTopology (AlgebraicSpaces B S hS) :=
  (fppfPrecoverage B S hS).toGrothendieck

/-- The pretopology of presieves generating a covering sieve of the fppf topology. -/
abbrev fppfPretopology : Pretopology (AlgebraicSpaces B S hS) :=
  (fppfTopology B S hS).toPretopology

/-- The fppf pretopology generates the fppf topology. -/
theorem fppfPretopology_toGrothendieck :
    (fppfPretopology B S hS).toGrothendieck = fppfTopology B S hS :=
  (Pretopology.gi (AlgebraicSpaces B S hS)).l_u_eq (fppfTopology B S hS)

variable {B S hS}

/-- **A flat, locally finitely presented, surjective morphism is an fppf covering.** The
one-member family `{f : Y → X}` is an fppf covering of Stacks 03Y8, so it lies in the fppf
pretopology. -/
theorem singleton_mem_fppfPretopology {X Y : AlgebraicSpaces B S hS} {f : Y ⟶ X}
    (hf : fppfSurjective B S hS f) : Presieve.singleton f ∈ fppfPretopology B S hS X := by
  have hR : Presieve.singleton f ∈ fppfPrecoverage B S hS X := by
    refine ⟨PUnit.{u + 2}, fun _ ↦ Y, fun _ ↦ f, (Presieve.ofArrows_pUnit f).symm, ?_⟩
    refine ⟨X.2, fun _ ↦ Y.2, fun _ ↦ hf.1, fun _ ↦ hf.2.1, ?_⟩
    refine Set.eq_univ_of_forall fun x ↦ Set.mem_iUnion.2 ⟨PUnit.unit, hf.2.2 x⟩
  exact (GrothendieckTopology.mem_toPretopology _ (fppfTopology B S hS) _).2
    (Precoverage.generate_mem_toGrothendieck hR)

/-- **An fppf hypercovering is a hypercovering in the fppf site.** An augmented simplicial
algebraic space `a : U → X` whose augmentation `U₀ → X`, canonical morphism `U₁ → U₀ ×_X U₀`
and higher matching morphisms are flat, locally of finite presentation and surjective is a
hypercovering of `X` in `(Spaces/S)_fppf` in the sense of Stacks 09X8. -/
theorem isHypercoveringAugmentation_of_isFppfHypercovering
    {A : SimplicialObject.Augmented (AlgebraicSpaces B S hS)} (hA : IsFppfHypercovering A) :
    IsHypercoveringAugmentation (fppfPretopology B S hS) A.left A.hom :=
  ⟨singleton_mem_fppfPretopology hA.map_zero, singleton_mem_fppfPretopology hA.map_one,
    fun n hn ↦ singleton_mem_fppfPretopology (hA.matching n hn)⟩

end AlgebraicGeometry.Space

end
