/-!
# Stacks 0DGG on single sheaves for the fppf site of algebraic spaces

Let `B` be a big fppf site of schemes, `S` a scheme of `B` and `Y` an algebraic space over `S`.
Let `a_Y : Sh((Spaces/Y)_fppf) → Sh(Y_étale)` be the comparison of Section 0DGE, built on the
fppf site of algebraic spaces whose topology is generated by all fppf coverings
(`AlgebraicGeometry.Space.fppfTopology`, `AlgebraicGeometry.Space.fppfSpacesEtaleMorphism`).
For every abelian sheaf `F` on `Y_étale`,

* the unit `F → a_{Y,*}a_Y⁻¹F` is an isomorphism, and
* `R^q a_{Y,*}(a_Y⁻¹F) = 0` for `q > 0`.

This is Stacks 0DGG read on a single abelian sheaf
(`AlgebraicGeometry.Space.FppfSpacesEtaleAcyclic`). Stacks 0DGF and 0DGG are available for a big
fppf site of algebraic spaces in the sense of Stacks 0DBV, whose topology is generated by a
set-sized system of fppf coverings (Stacks 000X), together with a big étale site of algebraic
spaces over the same big fppf site of schemes; the scheme case of Stacks 0DDS (1) that they rest
on is `AlgebraicGeometry.schemeFppfEtaleHigherVanishing`. The two settings are identified here.

## Main definitions

* `AlgebraicGeometry.BigFppfSpaceSite.fppfTopologyOverSheafEquiv`: for a big fppf site `T` of
  algebraic spaces, abelian sheaves on `(Spaces/Y)_fppf` are abelian sheaves on the big fppf site
  of `Y`.
* `AlgebraicGeometry.BigFppfSpaceSite.spacesFppfAbelianDirectImageIso`: through it, `a_{Y,*}` of
  Section 0DGE is `a_{Y,*}` of Stacks 0DGI for `T` and `T.bigEtaleSpaceSite`.

## Main results

* `AlgebraicGeometry.BigFppfSpaceSite.topology_eq_spaceFppfTopology`: the topology of a big fppf
  site of algebraic spaces is the fppf topology `AlgebraicGeometry.Space.fppfTopology`.
* `CategoryTheory.Adjunction.isIso_unit_app_and_isZero_rightDerived_of_iso_comp_equivalence`:
  the unit and the higher derived functors of a right adjoint are read through an equivalence.
* `AlgebraicGeometry.Space.fppfSpacesEtaleAcyclic_of_algebraicSpace`: Stacks 0DGG on single
  sheaves, `FppfSpacesEtaleAcyclic Y`, for every algebraic space `Y`, through the big fppf site
  `AlgebraicGeometry.Space.bigFppfSpaceSiteOfSchemeSite B S hS` built on `B`.

## Implementation notes

The topology of a big fppf site of algebraic spaces is generated by the fppf coverings with index
sets of cardinality at most the chosen bound; every fppf covering is combinatorially equivalent to
one of them, so the two topologies agree. The covering families of the bounded system are indexed
in `Type (u + 2)`, those of `fppfPrecoverage` in `Type (u + 1)`: an fppf covering indexed in
`Type (u + 2)` contains the subfamily indexed by the points of its target, one member through each
point, which is again an fppf covering. With the étale site
`AlgebraicGeometry.BigFppfSpaceSite.bigEtaleSpaceSite`, whose big fppf site of schemes is that of
`T` on the nose, the comparison `a_Y = π_Y ∘ ε_Y` of Stacks 0DGI is restriction along the same
functor `V ↦ V/Y` as `a_Y` here, and the two sheaf categories on `Y` are identified by
`CategoryTheory.sheafEquivOfTopologyEq`. Everything is stated for the algebraic spaces `T.Spaces`
of `T`, which are those over `T.schemeSite` up to reducible unfolding; the case of an arbitrary big
fppf site `B` of schemes is then the case `T = bigFppfSpaceSiteOfSchemeSite B S hS`.

## References

* [Stacks Project, Tag 0DGG](https://stacks.math.columbia.edu/tag/0DGG)
* [Stacks Project, Tag 0DGF](https://stacks.math.columbia.edu/tag/0DGF)
* [Stacks Project, Tag 0DDS](https://stacks.math.columbia.edu/tag/0DDS)
* [Stacks Project, Tag 0DBV](https://stacks.math.columbia.edu/tag/0DBV)
* [Stacks Project, Tag 000X](https://stacks.math.columbia.edu/tag/000X)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.BigFppfSpaceSite

variable {S : Scheme.{u}} (T : BigFppfSpaceSite S)

/-- **The topology of a big fppf site of algebraic spaces is the fppf topology** of the algebraic
spaces over `S`: a chosen covering contains, through each point of its target, one member, and
that subfamily is an fppf covering; conversely an fppf covering, re-indexed in the larger
universe, has a chosen combinatorially equivalent representative, which generates the same
sieve. -/
theorem topology_eq_spaceFppfTopology :
    T.topology = Space.fppfTopology T.schemeSite S T.scheme_mem := by
  apply le_antisymm
  · refine Precoverage.toGrothendieck_le_iff_le_toPrecoverage.2 ?_
    rintro X R ⟨E, rfl, hE, -⟩
    choose σ hσ using fun x ↦ Set.mem_iUnion.1 (Set.eq_univ_iff_forall.1 hE.jointly_surjective x)
    have hsub : Presieve.ofArrows (fun x ↦ E.X (σ x)) (fun x ↦ E.f (σ x)) ∈
        Space.fppfPrecoverage T.schemeSite S T.scheme_mem X :=
      ⟨_, _, _, rfl,
        { target_isAlgebraicSpace := hE.target_isAlgebraicSpace
          source_isAlgebraicSpace := fun x ↦ hE.source_isAlgebraicSpace (σ x)
          flat := fun x ↦ hE.flat (σ x)
          locallyOfFinitePresentation := fun x ↦ hE.locallyOfFinitePresentation (σ x)
          jointly_surjective := Set.eq_univ_of_forall fun x ↦ Set.mem_iUnion.2 ⟨x, hσ x⟩ }⟩
    rw [GrothendieckTopology.mem_toPrecoverage_iff]
    refine (Space.fppfTopology T.schemeSite S T.scheme_mem).superset_covering ?_
      (Precoverage.generate_mem_toGrothendieck hsub)
    refine (Sieve.generate_le_iff _ _).2 (le_trans ?_ (Sieve.le_generate _))
    rintro _ _ ⟨x⟩
    exact Presieve.ofArrows.mk (σ x)
  · refine Precoverage.toGrothendieck_le_iff_le_toPrecoverage.2 ?_
    rintro X R ⟨I, Y, f, rfl, hf⟩
    let E₀ : PreZeroHypercover.{u + 2} X :=
      { I₀ := ULift.{u + 2} I
        X := fun i ↦ Y i.down
        f := fun i ↦ f i.down }
    have hE₀ : Space.IsFppfCoveringFamily T.schemeSite S T.scheme_mem ⟨X, E₀⟩ :=
      Space.IsFppfCovering.reindex T.schemeSite S T.scheme_mem hf (σ := ULift.down)
        ULift.down_surjective
    obtain ⟨⟨X₁, E₁⟩, hE₁, hX, hCE⟩ := T.covering_representative _ hE₀
    change X = X₁ at hX
    subst hX
    have hR : Presieve.ofArrows Y f = E₀.presieve₀ := by
      apply le_antisymm
      · rintro _ _ ⟨i⟩
        exact Presieve.ofArrows.mk (ι := ULift.{u + 2} I) (ULift.up i)
      · rintro _ _ ⟨i⟩
        exact Presieve.ofArrows.mk i.down
    rw [GrothendieckTopology.mem_toPrecoverage_iff, hR,
      PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hCE]
    exact Precoverage.generate_mem_toGrothendieck ⟨E₁, rfl, hE₁⟩

end AlgebraicGeometry.BigFppfSpaceSite

namespace CategoryTheory.Adjunction

variable {C₁ C₂ D : Type*} [Category* C₁] [Category* C₂] [Category* D] [Abelian C₁] [Abelian C₂]
  [Abelian D] [HasInjectiveResolutions C₁] [HasInjectiveResolutions C₂]

/-- **Units and higher derived functors of right adjoints identified through an equivalence.**
Let `L ⊣ R` and `L' ⊣ R'` be adjunctions with `R : C₁ ⥤ D` and `R' : C₂ ⥤ D` additive, and
`e : C₁ ≌ C₂` an equivalence with `e.functor ⋙ R' ≅ R`. If the unit of `L' ⊣ R'` is invertible
at `F` and `R^qR'(L'F) = 0` for `q > 0`, then the unit of `L ⊣ R` is invertible at `F` and
`R^qR(LF) = 0` for `q > 0`: `L` is `L' ⋙ e⁻¹` up to isomorphism, by uniqueness of left adjoints. -/
theorem isIso_unit_app_and_isZero_rightDerived_of_iso_comp_equivalence {L : D ⥤ C₁} {R : C₁ ⥤ D}
    (adj : L ⊣ R) {L' : D ⥤ C₂} {R' : C₂ ⥤ D} (adj' : L' ⊣ R') [hR : R.Additive]
    [hR' : R'.Additive]
    (e : C₁ ≌ C₂) (iso : e.functor ⋙ R' ≅ R) (F : D) (hu : IsIso (adj'.unit.app F))
    (hv : ∀ q : ℕ, 0 < q → IsZero ((R'.rightDerived q).obj (L'.obj F))) :
    IsIso (adj.unit.app F) ∧ ∀ q : ℕ, 0 < q → IsZero ((R.rightDerived q).obj (L.obj F)) := by
  let adj₂ : L' ⋙ e.inverse ⊣ R := (adj'.comp e.symm.toAdjunction).ofNatIsoRight iso
  refine ⟨?_, fun q hq ↦ ?_⟩
  · have e₂ : adj₂.unit.app F = (adj'.comp e.symm.toAdjunction).unit.app F ≫ iso.hom.app _ := by
      rw [← Adjunction.homEquiv_id, Adjunction.homEquiv_ofNatIsoRight_apply,
        Adjunction.homEquiv_id]
      rfl
    have : IsIso (adj₂.unit.app F) := by
      rw [e₂, Adjunction.comp_unit_app]
      infer_instance
    rw [← Adjunction.unit_leftAdjointUniq_hom_app adj adj₂ F] at this
    exact IsIso.of_isIso_comp_right _ (R.map ((Adjunction.leftAdjointUniq adj adj₂).hom.app F))
  · have : e.functor.Additive := e.functor.additive_of_preserves_binary_products
    let sq : R ⋙ 𝟭 _ ≅ e.functor ⋙ R' := Functor.rightUnitor R ≪≫ iso.symm
    let eL : e.functor.obj (L.obj F) ≅ L'.obj F :=
      e.functor.mapIso ((Adjunction.leftAdjointUniq adj adj₂).app F) ≪≫ e.counitIso.app _
    exact (hv q hq).of_iso
      ((Functor.rightDerivedIsoOfSquare e.functor R R' (𝟭 _) sq q).app (L.obj F) ≪≫
        (R'.rightDerived q).mapIso eL)

end CategoryTheory.Adjunction

namespace AlgebraicGeometry.BigFppfSpaceSite

attribute [local instance] BigEtaleSpaceSite.bigToSmallAbelianInverseImage_additive

variable {S : Scheme.{u}} (T : BigFppfSpaceSite S) (E : BigEtaleSpaceSite S)
  (h : T.schemeSite = E.fppfSite) (X : T.Spaces)

/-- **`R^q a_{X,*}(a_X⁻¹F) = 0` for `q > 0`**: `R^q a_{X,*} = π_{X,*} ∘ R^q ε_{X,*}`, the
restriction `π_{X,*}` being exact, and `R^q ε_{X,*}(a_X⁻¹F) = 0` (Stacks 0DGF (2)), from the scheme
case of Stacks 0DDS (1), `AlgebraicGeometry.schemeFppfEtaleHigherVanishing`. -/
theorem isZero_rightDerived_fppfToSmallEtaleAbelianPushforward
    (F : Sheaf (Space.SpacesEtale.topology E.fppfSite S E.fppf_mem (etaleSpace T E h X))
      AddCommGrpCat.{u + 1}) (q : ℕ) (hq : 0 < q) :
    IsZero (((fppfToSmallEtaleAbelianPushforward T E h X).rightDerived q).obj
      ((CategoryTheory.Sites.abelianInverseImage (fppfToSmallEtaleMorphism T E h X)).obj F)) :=
  ((E.bigToSmallEtaleRestriction (etaleSpace T E h X)).map_isZero
    (isZero_rightDerived_fppfToBigEtale_abelianInverseImage_of T E h X
      (schemeFppfEtaleHigherVanishing E.fppfSite) F q hq)).of_iso
    ((Functor.rightDerivedCompIso (fppfToBigEtaleAbelianPushforward T E h X)
      (E.bigToSmallEtaleRestriction (etaleSpace T E h X)) q).app _)

end AlgebraicGeometry.BigFppfSpaceSite

namespace AlgebraicGeometry.BigFppfSpaceSite

attribute [local instance] BigEtaleSpaceSite.bigToSmallAbelianInverseImage_additive

variable {S : Scheme.{u}} (T : BigFppfSpaceSite S) (Y : T.Spaces)

open Space

/-- The abelian sheaves on `(Spaces/Y)_fppf` for the fppf topology are the abelian sheaves on the
big fppf site of `Y` in the sense of Stacks 0DBW. -/
abbrev fppfTopologyOverSheafEquiv :
    Sheaf ((fppfTopology T.schemeSite S T.scheme_mem).over Y) AddCommGrpCat.{u + 1} ≌
      Sheaf (BigFppfSpaceOver.topology T Y) AddCommGrpCat.{u + 1} :=
  sheafEquivOfTopologyEq (congrArg (·.over Y) T.topology_eq_spaceFppfTopology.symm)
    AddCommGrpCat.{u + 1}

/-- The direct image `a_{Y,*}` of Section 0DGE is the direct image `a_{Y,*} = π_{Y,*} ∘ ε_{Y,*}`
of Stacks 0DGI for `T` and the big étale site `T.bigEtaleSpaceSite`, read through
`fppfTopologyOverSheafEquiv`: both are restriction along `V ↦ V/Y`. -/
def spacesFppfAbelianDirectImageIso :
    (fppfTopologyOverSheafEquiv T Y).functor ⋙
        (fppfToSmallEtaleAbelianPushforward T T.bigEtaleSpaceSite rfl Y :
          Sheaf (BigFppfSpaceOver.topology T Y) AddCommGrpCat.{u + 1} ⥤
            Sheaf (SpacesEtale.topology T.schemeSite S T.scheme_mem Y) AddCommGrpCat.{u + 1}) ≅
      fppfSpacesEtaleAbelianDirectImage Y :=
  NatIso.ofComponents (fun _ ↦ (fullyFaithfulSheafToPresheaf _ _).preimageIso (Iso.refl _))
    (fun _ ↦ by
      apply Sheaf.hom_ext
      rfl)

/-- **Stacks 0DGG on single sheaves for the fppf site of algebraic spaces.** For every abelian
sheaf `F` on `Y_étale` the unit `F → a_{Y,*}a_Y⁻¹F` is an isomorphism (Stacks 0DGF (1)) and
`R^q a_{Y,*}(a_Y⁻¹F) = 0` for `q > 0` (Stacks 0DGF (2)). -/
theorem fppfSpacesEtaleAcyclic_of_space : FppfSpacesEtaleAcyclic Y := by
  intro F
  have hR' : (fppfToSmallEtaleAbelianPushforward T T.bigEtaleSpaceSite rfl Y).Additive :=
    inferInstance
  have hu : IsIso (fppfToSmallEtaleAbelianAdjunction T T.bigEtaleSpaceSite rfl Y).unit :=
    Stacks.Adjunction.isIso_unit_of_comp_iso_id _
      (fppfToSmallEtale_abelianInverseImage_comp_restrictionIso T T.bigEtaleSpaceSite rfl Y)
  have hu' : IsIso ((fppfToSmallEtaleAbelianAdjunction T T.bigEtaleSpaceSite rfl Y).unit.app F) :=
    @NatIso.isIso_app_of_isIso _ _ _ _ _ _ _ hu F
  exact Adjunction.isIso_unit_app_and_isZero_rightDerived_of_iso_comp_equivalence (hR' := hR')
    (fppfSpacesEtaleAbelianAdjunction Y)
    (fppfToSmallEtaleAbelianAdjunction T T.bigEtaleSpaceSite rfl Y)
    (fppfTopologyOverSheafEquiv T Y) (spacesFppfAbelianDirectImageIso T Y) F hu'
    (isZero_rightDerived_fppfToSmallEtaleAbelianPushforward T T.bigEtaleSpaceSite rfl Y F)

end AlgebraicGeometry.BigFppfSpaceSite

namespace AlgebraicGeometry.Space

/-- **Stacks 0DGG on single sheaves for the fppf site of algebraic spaces.** For every algebraic
space `Y` over `S` and every abelian sheaf `F` on `Y_étale`, the unit `F → a_{Y,*}a_Y⁻¹F` is an
isomorphism and `R^q a_{Y,*}(a_Y⁻¹F) = 0` for `q > 0`: the case
`T = bigFppfSpaceSiteOfSchemeSite B S hS` of
`AlgebraicGeometry.BigFppfSpaceSite.fppfSpacesEtaleAcyclic_of_space`. -/
theorem fppfSpacesEtaleAcyclic_of_algebraicSpace {B : BigFppfSite.{u}} {S : Scheme.{u}}
    {hS : B.Contains S} (Y : AlgebraicSpaces B S hS) : FppfSpacesEtaleAcyclic Y :=
  (bigFppfSpaceSiteOfSchemeSite B S hS).fppfSpacesEtaleAcyclic_of_space Y

end AlgebraicGeometry.Space

end
