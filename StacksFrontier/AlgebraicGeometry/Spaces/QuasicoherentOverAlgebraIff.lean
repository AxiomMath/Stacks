-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Opposite

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}
    {A : Sheaf (smallEtaleRingedSite B S hS F hF).J RingCat.{u}}
    (α : Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O ⟶ A)

/-- **The algebra structure map read on the slice at a chart.**  The morphism
`α : 𝒪_F ⟶ A`, restricted to the slice of the small étale site at an étale chart `V`, along
which an `A|_V`-module on the slice becomes an `𝒪_F|_V`-module. -/
noncomputable abbrev algebraSliceHom (V : (smallEtaleRingedSite B S hS F hF).C) :
    (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O).over V ⟶
      A.over V :=
  (GrothendieckTopology.overPullback (smallEtaleRingedSite B S hS F hF).J RingCat.{u} V).map α

/-- **A free `A|_V`-module on the slice at a chart is quasi-coherent as an `𝒪_F|_V`-module** as
soon as `A` is quasi-coherent as an `𝒪_F`-module.

Restriction of scalars preserves colimits, so it carries the colimiting cofan exhibiting the free
`A|_V`-module on a type `I` as a direct sum of `I` copies of the unit `A|_V`-module to a
colimiting cofan on the constant family at the restriction of scalars of that unit, which is the
restriction to the slice of `A` read as an `𝒪_F`-module; and a direct sum of quasi-coherent
modules on the slice is quasi-coherent. -/
theorem isQuasicoherentOnSite_restrictScalars_free_over_chart
    (hA : ((SheafOfModules.restrictScalars.{u} α).obj
      (SheafOfModules.unit A)).IsQuasicoherentOnSite)
    (V : (smallEtaleRingedSite B S hS F hF).C) (I : Type u) :
    ((SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).obj
      (SheafOfModules.free.{u} (R := A.over V) I)).IsQuasicoherentOnSite := by
  have hunit : ((SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).obj
      (SheafOfModules.unit (A.over V))).IsQuasicoherentOnSite :=
    Stacks.SheafOfModules.isQuasicoherent_over
      ((SheafOfModules.restrictScalars.{u} α).obj (SheafOfModules.unit A)) hA V
  have hc : IsColimit (Cofan.mk
      ((SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).obj
        (SheafOfModules.free.{u} (R := A.over V) I))
      (fun i : I ↦ (SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).map
        (SheafOfModules.ιFree i))) :=
    (Cofan.isColimitMapCoconeEquiv
      (SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)) _
      (Cofan.mk (SheafOfModules.free.{u} (R := A.over V) I) SheafOfModules.ιFree)).toFun
      (isColimitOfPreserves _ (SheafOfModules.isColimitFreeCofan I))
  exact isQuasicoherentOnSite_of_isColimit_cofan_over_chart B S hS ⟨F, hF⟩ V _ hc fun _ ↦ hunit

/-- **An `A`-module whose restriction of scalars is quasi-coherent has a global presentation over
`A|_V` on the slice at an affine chart.**  This is the local statement behind the hard direction
of the criterion: the generators are the sections of `M` over the chart and the relations are the
sections over the chart of the kernel of the morphism from the free module on them. -/
theorem hasGlobalPresentation_over_affine_chart
    (hA : ((SheafOfModules.restrictScalars.{u} α).obj
      (SheafOfModules.unit A)).IsQuasicoherentOnSite)
    (M : SheafOfModules.{u} A)
    (hM : ((SheafOfModules.restrictScalars.{u} α).obj M).IsQuasicoherentOnSite)
    (V : (smallEtaleRingedSite B S hS F hF).C)
    (hV : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V)) :
    (SheafOfModules.over M V).HasGlobalPresentation := by
  set gen := algebraChartGeneratingSections B S hS α M hM V hV
  have hMV : ((SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).obj
      (SheafOfModules.over M V)).IsQuasicoherentOnSite :=
    Stacks.SheafOfModules.isQuasicoherent_over
      ((SheafOfModules.restrictScalars.{u} α).obj M) hM V
  have hker : ((SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).obj
      (kernel gen.π)).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_of_isLimit_kernelFork_over_chart B S hS ⟨F, hF⟩ V _
      (KernelFork.mapIsLimit _ (kernelIsKernel gen.π)
        (SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)))
      (isQuasicoherentOnSite_restrictScalars_free_over_chart B S hS α hA V gen.I) hMV
  exact SheafOfModules.HasGlobalPresentation.of_presentation'
    { generators := gen
      relations := Stacks.AlgebraicGeometry.QcohOverAlgebra.generatingSectionsOfRestrictScalars
        (algebraSliceHom B S hS α V)
        (chartSliceGeneratingSections B S hS ⟨F, hF⟩ V hV _ hker) }

/-- **An `A`-module which is quasi-coherent as an `𝒪_F`-module is quasi-coherent as an
`A`-module**, for `A` a sheaf of rings on the small étale site of an algebraic space which is
quasi-coherent as an `𝒪_F`-module.

This is the hard direction of the second assertion of Stacks 08AI, for an arbitrary
quasi-coherent algebra: the affine étale charts cover the final object of the small étale site
and on each of them the module is globally presented over `A`, which is the criterion of
Stacks 03DN. -/
theorem isQuasicoherentOnSite_of_isQuasicoherentOnSite_restrictScalars
    (hA : ((SheafOfModules.restrictScalars.{u} α).obj
      (SheafOfModules.unit A)).IsQuasicoherentOnSite)
    (M : SheafOfModules.{u} A)
    (hM : ((SheafOfModules.restrictScalars.{u} α).obj M).IsQuasicoherentOnSite) :
    M.IsQuasicoherentOnSite :=
  (Stacks.SheafOfModules.isQuasicoherentOnSite_iff_exists_cover_hasGlobalPresentation M).2
    ⟨_, _, SmallEtale.coversTop_affineCharts B S hS F, fun V ↦
      hasGlobalPresentation_over_affine_chart B S hS α hA M hM V.1 V.2⟩

/-- **The restriction of scalars of an `A`-module which is globally presented over `A|_V` on the
slice at a chart is quasi-coherent there.**  This is the local statement behind the easy
direction: the presentation exhibits the module as a cokernel of a morphism of free
`A|_V`-modules, restriction of scalars preserves that cokernel, and the two free modules become
quasi-coherent `𝒪_F|_V`-modules. -/
theorem isQuasicoherentOnSite_restrictScalars_over_chart
    (hA : ((SheafOfModules.restrictScalars.{u} α).obj
      (SheafOfModules.unit A)).IsQuasicoherentOnSite)
    (M : SheafOfModules.{u} A) (V : (smallEtaleRingedSite B S hS F hF).C)
    (hP : (SheafOfModules.over M V).HasGlobalPresentation) :
    ((SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)).obj
      (SheafOfModules.over M V)).IsQuasicoherentOnSite := by
  obtain ⟨P⟩ := hP.nonempty_presentation_of_isTerminal (T := Over.mk (𝟙 V)) Over.mkIdTerminal
  let _ : (SheafOfModules.restrictScalars.{u}
      (algebraSliceHom B S hS α V)).PreservesZeroMorphisms := { map_zero := fun _ _ ↦ rfl }
  let _ : PreservesColimitsOfShape WalkingParallelPair
      (SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)) :=
    Stacks.AlgebraicGeometry.RestrictScalarsColimits.preservesColimitsOfShape_restrictScalars.{0, 0}
      (algebraSliceHom B S hS α V) WalkingParallelPair
  have hfπ : ((SheafOfModules.freeHomEquiv _).symm P.relations.s ≫
      kernel.ι P.generators.π) ≫ P.generators.π = 0 := by simp
  exact isQuasicoherentOnSite_of_isColimit_cokernelCofork_over_chart B S hS ⟨F, hF⟩ V _
    (isColimitCoforkMapOfIsColimit'
      (SheafOfModules.restrictScalars.{u} (algebraSliceHom B S hS α V)) hfπ P.isColimit)
    (isQuasicoherentOnSite_restrictScalars_free_over_chart B S hS α hA V P.relations.I)
    (isQuasicoherentOnSite_restrictScalars_free_over_chart B S hS α hA V P.generators.I)

/-- **An `A`-module which is quasi-coherent as an `A`-module is quasi-coherent as an
`𝒪_F`-module**, for `A` a sheaf of rings on the small étale site of an algebraic space which is
quasi-coherent as an `𝒪_F`-module.

This is the easy direction of the second assertion of Stacks 08AI, for an arbitrary
quasi-coherent algebra: quasi-coherence over `A` gives a covering family of the final object on
whose members the module is globally presented over `A`, and the restriction of scalars is
quasi-coherent on each of those members. -/
theorem isQuasicoherentOnSite_restrictScalars
    (hA : ((SheafOfModules.restrictScalars.{u} α).obj
      (SheafOfModules.unit A)).IsQuasicoherentOnSite)
    (M : SheafOfModules.{u} A) (hM : M.IsQuasicoherentOnSite) :
    ((SheafOfModules.restrictScalars.{u} α).obj M).IsQuasicoherentOnSite := by
  obtain ⟨I, U, hU, hP⟩ :=
    (Stacks.SheafOfModules.isQuasicoherentOnSite_iff_exists_cover_hasGlobalPresentation M).1 hM
  exact (Stacks.SheafOfModules.isQuasicoherentOnSite_iff_exists_cover_isQuasicoherentOnSite
    ((SheafOfModules.restrictScalars.{u} α).obj M)).2 ⟨I, U, hU, fun i ↦
      isQuasicoherentOnSite_restrictScalars_over_chart B S hS α hA M (U i) (hP i)⟩

/-- **A module over a quasi-coherent algebra on the small étale site of an algebraic space is
quasi-coherent as a module over the structure sheaf if and only if it is quasi-coherent as a
module over the algebra.**

This is the second assertion of Stacks 08AI for an arbitrary quasi-coherent `𝒪_F`-algebra; the
assertion of the tag itself, for `A = f_*𝒪_Y` along an affine morphism `f`, is
`AlgebraicGeometry.Space.isQuasicoherentOnSite_restrictScalars_structureSharp_iff`. -/
theorem isQuasicoherentOnSite_restrictScalars_iff
    (hA : ((SheafOfModules.restrictScalars.{u} α).obj
      (SheafOfModules.unit A)).IsQuasicoherentOnSite)
    (M : SheafOfModules.{u} A) :
    ((SheafOfModules.restrictScalars.{u} α).obj M).IsQuasicoherentOnSite ↔
      M.IsQuasicoherentOnSite :=
  ⟨isQuasicoherentOnSite_of_isQuasicoherentOnSite_restrictScalars B S hS α hA M,
    isQuasicoherentOnSite_restrictScalars B S hS α hA M⟩

end AlgebraicGeometry.Space

end
