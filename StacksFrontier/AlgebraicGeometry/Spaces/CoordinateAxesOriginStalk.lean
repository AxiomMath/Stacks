module

public import StacksFrontier.AlgebraicGeometry.Spaces.CoordinateAxesQuotientIntegral
public import StacksFrontier.RingTheory.OrderOfVanishing.NodeBranchSum

/-!
# The local ring of the coordinate axes at the origin

Let `k` be a field and `U = Spec (k[x, y]/(xy))`. The local ring `𝒪_{U, 0}` at the origin is
reduced, its maximal ideal is generated by the germs of `x` and `y`, both of which are nonzero,
and `xy = 0`. Hence `𝒪_{U, 0}` is not a domain, `x + y` is a nonzerodivisor of it, and the order
of vanishing of `x + y` at the origin is `2`. These are the local computations behind the last
two assertions of **Stacks 0ENU**.

## Main results

* `AlgebraicGeometry.CoordinateAxesQuotient.maximalIdeal_originStalk`: the maximal ideal of
  `𝒪_{U, 0}` is `(x, y)`.
* `AlgebraicGeometry.CoordinateAxesQuotient.originGerm_xSection_ne_zero` and
  `AlgebraicGeometry.CoordinateAxesQuotient.originGerm_ySection_ne_zero`: the germs of `x` and
  `y` are nonzero.
* `AlgebraicGeometry.CoordinateAxesQuotient.not_isDomain_originStalk`: `𝒪_{U, 0}` is not a
  domain.
* `AlgebraicGeometry.CoordinateAxesQuotient.originGerm_sum_mem_nonZeroDivisors` and
  `AlgebraicGeometry.CoordinateAxesQuotient.ord_originGerm_sum`: the germ of `x + y` is a
  nonzerodivisor of order of vanishing `2`.

## Implementation notes

`𝒪_{U, 0}` is the localization of `k[x, y]/(xy)` at the kernel of evaluation at the origin, by
`AlgebraicGeometry.StructureSheaf.IsLocalization.to_stalk`. Nonvanishing of the germ of `x` is
read off the first axis: an element `t` with `t x = 0` maps to `0` in `k[t]` under `x ↦ t`,
`y ↦ 0`, so vanishes at the origin.
-/

@[expose] public section

open CategoryTheory IsLocalRing CochainComplex.DerivedChangeOfRings

universe u

namespace AlgebraicGeometry.CoordinateAxesQuotient

variable (S : Setup.{u})

/-- The restriction `k[x, y]/(xy) → k[t]` to the first axis, `x ↦ t`, `y ↦ 0`. -/
noncomputable def firstAxisRingHom : NodalRing S.k →+* Polynomial S.k :=
  Ideal.Quotient.lift (nodalRelationIdeal S.k)
    (MvPolynomial.eval₂Hom Polynomial.C (fun i => cond i 0 Polynomial.X)) (by
      intro p hp
      rw [← RingHom.mem_ker]
      refine (Ideal.span_le.mpr ?_) hp
      rintro _ rfl
      simp [RingHom.mem_ker, xVariable, yVariable])

/-- The restriction `k[x, y]/(xy) → k[t]` to the second axis, `x ↦ 0`, `y ↦ t`. -/
noncomputable def secondAxisRingHom : NodalRing S.k →+* Polynomial S.k :=
  Ideal.Quotient.lift (nodalRelationIdeal S.k)
    (MvPolynomial.eval₂Hom Polynomial.C (fun i => cond i Polynomial.X 0)) (by
      intro p hp
      rw [← RingHom.mem_ker]
      refine (Ideal.span_le.mpr ?_) hp
      rintro _ rfl
      simp [RingHom.mem_ker, xVariable, yVariable])

/-- Evaluation at the origin factors through the first axis. -/
theorem originRingMap_eq_eval_firstAxisRingHom (a : NodalRing S.k) :
    originRingMap S a = (firstAxisRingHom S a).eval 0 := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  induction p using MvPolynomial.induction_on with
  | C r => simp [originRingMap, originPolynomialMap, firstAxisRingHom]
  | add p q hp hq => simp only [map_add, Polynomial.eval_add, hp, hq]
  | mul_X p i hp =>
      simp only [map_mul, Polynomial.eval_mul, hp]
      cases i <;> simp [originRingMap, originPolynomialMap, firstAxisRingHom]

/-- Evaluation at the origin factors through the second axis. -/
theorem originRingMap_eq_eval_secondAxisRingHom (a : NodalRing S.k) :
    originRingMap S a = (secondAxisRingHom S a).eval 0 := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  induction p using MvPolynomial.induction_on with
  | C r => simp [originRingMap, originPolynomialMap, secondAxisRingHom]
  | add p q hp hq => simp only [map_add, Polynomial.eval_add, hp, hq]
  | mul_X p i hp =>
      simp only [map_mul, Polynomial.eval_mul, hp]
      cases i <;> simp [originRingMap, originPolynomialMap, secondAxisRingHom]

/-- The kernel of evaluation at the origin is `(x, y)`. -/
theorem ker_originRingMap :
    RingHom.ker (originRingMap S) = Ideal.span {xClass S.k, yClass S.k} := by
  apply le_antisymm
  · intro a ha
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    have hp : MvPolynomial.constantCoeff p = 0 := by
      rw [RingHom.mem_ker] at ha
      simpa [originRingMap, originPolynomialMap, MvPolynomial.constantCoeff_eq,
        MvPolynomial.eval₂_eq', MvPolynomial.coeff] using ha
    have hmem : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set Bool)) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) (by
          rwa [← MvPolynomial.constantCoeff_eq])
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    refine (Ideal.span_le.mpr ?_ : Ideal.span (MvPolynomial.X '' (Set.univ : Set Bool)) ≤
      (Ideal.span {xClass S.k, yClass S.k}).comap (Ideal.Quotient.mk _)) hmem
    rintro _ ⟨i, -, rfl⟩
    cases i
    · exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  · refine Ideal.span_le.mpr ?_
    rintro _ (rfl | rfl) <;>
      simp [RingHom.mem_ker, originRingMap, originPolynomialMap, xClass, yClass, xVariable,
        yVariable]

/-- The prime ideal of `k[x, y]/(xy)` at the origin is `(x, y)`. -/
theorem origin_asIdeal : (origin S).asIdeal = Ideal.span {xClass S.k, yClass S.k} := by
  rw [← ker_originRingMap]
  obtain ⟨q, hq⟩ : ∃ q : PrimeSpectrum S.k,
      (origin S : PrimeSpectrum (NodalRing S.k)) = PrimeSpectrum.comap (originRingMap S) q :=
    ⟨_, rfl⟩
  rw [hq, PrimeSpectrum.comap_asIdeal, Ideal.eq_bot_of_prime q.asIdeal]
  rfl

/-- The local ring `𝒪_{U, 0}` of the coordinate axes at the origin. -/
abbrev originStalk : Type u := (coordinateAxes S).presheaf.stalk (origin S)

/-- The germ at the origin of a global function on the coordinate axes. -/
noncomputable abbrev originGerm (s : Γ(coordinateAxes S, ⊤)) : originStalk S :=
  (coordinateAxes S).presheaf.germ ⊤ (origin S) trivial s

/-- The ideal of `k[x, y]/(xy)` corresponding to the origin is prime. -/
instance isPrime_origin_asIdeal : (origin S).asIdeal.IsPrime :=
  PrimeSpectrum.isPrime (origin S : PrimeSpectrum (NodalRing S.k))

/-- `𝒪_{U, 0}` is an algebra over `k[x, y]/(xy)`. -/
noncomputable instance : Algebra (NodalRing S.k) (originStalk S) :=
  StructureSheaf.stalkAlgebra (NodalRing S.k) (origin S)

/-- `𝒪_{U, 0}` is the localization of `k[x, y]/(xy)` at the prime ideal of the origin. -/
instance : IsLocalization.AtPrime (originStalk S) (origin S).asIdeal :=
  StructureSheaf.IsLocalization.to_stalk (NodalRing S.k) (origin S)

/-- Taking the germ at the origin is additive. -/
theorem originGerm_add (a b : Γ(coordinateAxes S, ⊤)) :
    originGerm S (a + b) = originGerm S a + originGerm S b :=
  map_add _ _ _

/-- The germ of `x` at the origin is the image of `x` under `k[x, y]/(xy) → 𝒪_{U, 0}`. -/
theorem originGerm_xSection : originGerm S (xSection S) = algebraMap _ _ (xClass S.k) := rfl

/-- The germ of `y` at the origin is the image of `y` under `k[x, y]/(xy) → 𝒪_{U, 0}`. -/
theorem originGerm_ySection : originGerm S (ySection S) = algebraMap _ _ (yClass S.k) := rfl

/-- The local ring `𝒪_{U, 0}` is reduced. -/
instance : _root_.IsReduced (originStalk S) :=
  haveI : _root_.IsReduced (CommRingCat.of (NodalRing S.k)) := isReduced_nodalRing S.k
  inferInstance

/-- The product of the germs of `x` and `y` at the origin is zero. -/
theorem originGerm_xSection_mul_ySection :
    originGerm S (xSection S) * originGerm S (ySection S) = 0 := by
  rw [← (coordinateAxes S).presheaf.germ ⊤ (origin S) trivial |>.hom.map_mul,
    xSection_mul_ySection, map_zero]

/-- The maximal ideal of `𝒪_{U, 0}` is generated by the germs of `x` and `y`. -/
theorem maximalIdeal_originStalk :
    maximalIdeal (originStalk S) =
      Ideal.span {originGerm S (xSection S), originGerm S (ySection S)} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (origin S).asIdeal, origin_asIdeal,
    Ideal.map_span, Set.image_pair]
  rfl

/-- The image in `𝒪_{U, 0}` of an element `c` sent to `t` by a map to `k[t]` compatible with
evaluation at the origin is nonzero. -/
private theorem algebraMap_originStalk_ne_zero (φ : NodalRing S.k →+* Polynomial S.k)
    (hφ : ∀ a, originRingMap S a = (φ a).eval 0) (c : NodalRing S.k) (hc : φ c = Polynomial.X) :
    algebraMap _ (originStalk S) c ≠ 0 := by
  intro h
  obtain ⟨⟨t, ht⟩, htc⟩ :=
    (IsLocalization.map_eq_zero_iff (origin S).asIdeal.primeCompl _ _).mp h
  apply ht
  change t ∈ (origin S).asIdeal
  rw [origin_asIdeal, ← ker_originRingMap]
  refine RingHom.mem_ker.mpr ?_
  rw [hφ]
  have h1 := congrArg φ htc
  rw [map_mul, map_zero, hc, mul_eq_zero, or_iff_left Polynomial.X_ne_zero] at h1
  rw [h1, Polynomial.eval_zero]

/-- The germ of `x` at the origin is nonzero: an element killing `x` vanishes at the origin, as
its restriction to the first axis does. -/
theorem originGerm_xSection_ne_zero : originGerm S (xSection S) ≠ 0 :=
  algebraMap_originStalk_ne_zero S (firstAxisRingHom S)
    (originRingMap_eq_eval_firstAxisRingHom S) _ (by
      simp [firstAxisRingHom, xClass, xVariable])

/-- The germ of `y` at the origin is nonzero. -/
theorem originGerm_ySection_ne_zero : originGerm S (ySection S) ≠ 0 :=
  algebraMap_originStalk_ne_zero S (secondAxisRingHom S)
    (originRingMap_eq_eval_secondAxisRingHom S) _ (by
      simp [secondAxisRingHom, yClass, yVariable])

/-- The local ring of the coordinate axes at the origin is not a domain: `xy = 0` there, with
neither germ zero. -/
theorem not_isDomain_originStalk : ¬ IsDomain (originStalk S) := by
  intro h
  rcases mul_eq_zero.mp (originGerm_xSection_mul_ySection S) with h0 | h0
  · exact originGerm_xSection_ne_zero S h0
  · exact originGerm_ySection_ne_zero S h0

/-- The germ of `x + y` at the origin is a nonzerodivisor. -/
theorem originGerm_sum_mem_nonZeroDivisors :
    originGerm S (xSection S + ySection S) ∈ nonZeroDivisors (originStalk S) := by
  rw [originGerm_add]
  exact Ring.add_mem_nonZeroDivisors_of_mul_eq_zero (originGerm_xSection_mul_ySection S)
    (maximalIdeal_originStalk S) (originGerm_xSection_ne_zero S)

/-- The order of vanishing of `x + y` at the origin of the coordinate axes is `2`. -/
theorem ord_originGerm_sum :
    Ring.ord (originStalk S) (originGerm S (xSection S + ySection S)) = 2 := by
  rw [originGerm_add]
  exact Ring.ord_add_eq_two_of_mul_eq_zero (originGerm_xSection_mul_ySection S)
    (maximalIdeal_originStalk S) (originGerm_xSection_ne_zero S) (originGerm_ySection_ne_zero S)

end AlgebraicGeometry.CoordinateAxesQuotient

end
