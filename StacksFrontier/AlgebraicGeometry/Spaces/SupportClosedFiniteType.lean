/-!
# The support of a module of finite type on an algebraic space is closed

Let `X` be an algebraic space over `S` and let `F` be an `𝒪_X`-module which is of finite type
on the small étale site, that is, locally generated by finitely many global sections.  The
support of `F`, in the sense of Stacks 04KA, is then closed in the point set of `X`.

Away from the support the argument is local: a geometric point at which the stalk vanishes has
an étale neighbourhood over which finitely many generators of `F` all restrict to zero, hence
one over which every section of `F` vanishes; the image of that chart is an open set of points
of `X` missing the support, because every geometric point of `X` over a point of the image
lifts to the chart.

## Main results

* `AlgebraicGeometry.Space.exists_zero_neighborhood_of_isFiniteTypeOnSite`: a geometric point
  with vanishing stalk has an étale neighbourhood all of whose refinements carry only the zero
  section.
* `AlgebraicGeometry.Space.isClosed_supportOfSheaf_of_isFiniteTypeOnSite` is part (1), the
  closedness clause, of Stacks 07TZ.  The other clauses of that tag are not proved here, but
  they are proved elsewhere in this development: the comparison of the support with the stalks
  is `AlgebraicGeometry.Space.mem_supportOfSheaf_iff_nontrivial_geometricModuleStalk_of_liesOver`
  and with the fibres
  `AlgebraicGeometry.Space.nontrivial_geometricModuleStalk_iff_nontrivial_residueFibre`; the
  pullback clause is `AlgebraicGeometry.Space.isFiniteTypeOnSite_modulePullback` together with
  `AlgebraicGeometry.Space.supportOfSheaf_modulePullback_eq`.  All three clauses are assembled
  into the statement the tag makes in
  `StacksFrontier.AlgebraicGeometry.Spaces.SupportFiniteTypeModule`.

## Implementation notes

Finite type is `SheafOfModules.IsFiniteTypeOnSite`, local finite generation on the small étale
site, which leaves the universe of the module sections independent of the universe of the
schemes; the universe-pinned `SheafOfModules.IsFiniteType` of the sheaves-of-modules API is
not used.  Quasi-coherence is not needed: nothing below uses cartesianness of the module.

Local finite generation is recorded as the existence of a finite coproduct of copies of the
structure sheaf mapping onto the module.  Turning that into an actual finite family of sections
together with the local spanning property is `finiteGlobalGenerators_local_span`, which reads
the sections off the retractions of the coproduct and gets local spanning from
`Stacks.SheafOfModules.EpiMono.isLocallySurjective_of_epi` applied to the presentation.  The
sheafification hypotheses that lemma needs hold for the enlarged universe of the presentation
because the small étale site is essentially small.

The passage from vanishing of the stalk at one geometric point to vanishing of the sheaf near
every point of the chart is the étale lift of a geometric point, Stacks 05VN
(`AlgebraicGeometry.Space.exists_geometricPoint_lift_of_isEtale`): the support is defined by
the existence of *some* geometric point with nonzero stalk, so a statement proved at one
chosen geometric point over a point of the chart would not suffice.

## References

* [Stacks Project, Tag 07TZ](https://stacks.math.columbia.edu/tag/07TZ)
* [Stacks Project, Tag 04KA](https://stacks.math.columbia.edu/tag/04KA)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 05VN](https://stacks.math.columbia.edu/tag/05VN)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u m r u₁ v₁

namespace AlgebraicGeometry.Space

/-! ### Finitely many generating sections from a finite presentation -/

section Generic

variable {D : Type u₁} [Category.{v₁} D] {J : GrothendieckTopology D}
  {R : Sheaf J RingCat.{r}}

/-- Local surjectivity of a morphism of sheaves of modules is inherited by its restriction to
a slice of the site. -/
private lemma locallySurjective_over {M N : SheafOfModules.{m} R} (q : M ⟶ N)
    [Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map q)] (U : D) :
    Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf (R.over U)).map (q.over U)) := by
  let _ : (Over.forget U).IsCocontinuous (J.over U) J :=
    ⟨fun hS => J.overEquiv_symm_mem_over _ _ hS⟩
  exact Presheaf.isLocallySurjective_whisker (J.over U) J (Over.forget U)
    ((SheafOfModules.toSheaf R).map q).hom

/-- A finite coproduct cocone in a preadditive category admits retractions summing to the
identity. -/
private lemma cofan_retractions {A : Type*} [Category A] [Preadditive A] {L P : A} {n : ℕ}
    (ι : Fin n → (L ⟶ P)) (h : IsColimit (Cofan.mk P ι)) :
    ∃ π : Fin n → (P ⟶ L), ∑ i, π i ≫ ι i = 𝟙 P := by
  classical
  let π (i : Fin n) := h.desc (Cofan.mk L (fun j => if j = i then 𝟙 L else 0))
  have hfac (i j : Fin n) : ι j ≫ π i = if j = i then 𝟙 L else 0 := h.fac _ ⟨j⟩
  refine ⟨π, h.hom_ext ?_⟩
  rintro ⟨j⟩
  change ι j ≫ _ = ι j ≫ _
  simp [Preadditive.comp_sum, ← Category.assoc, hfac, ite_comp]

/-- A module generated by finitely many global sections admits an actual finite family of
sections which spans it locally: the sections are the images of the unit section under the
retractions of the presenting coproduct, and local spanning is local surjectivity of the
presentation. -/
private lemma finiteGlobalGenerators_local_span (M : SheafOfModules.{m} R)
    (hM : SheafOfModules.HasFiniteGlobalGenerators M) :
    ∃ (n : ℕ) (s : Fin n → M.sections), ∀ (U : D) (t : M.val.obj (op U)),
      ∃ T : Sieve U, T ∈ J U ∧ ∀ (V : D) (f : V ⟶ U), T f →
        ∃ a : Fin n → R.obj.obj (op V),
          ∑ i, a i • (show M.val.obj _ from (s i).val (op V)) =
            M.val.restrictₛₗ f.op t := by
  classical
  obtain ⟨n, P, ι, ⟨hc⟩, q, hq⟩ := hM
  let L := SheafOfModules.uliftForPresentation.{u₁, v₁, r, r, max u₁ v₁ m}
    (SheafOfModules.unit R)
  let N := SheafOfModules.uliftForPresentation.{u₁, v₁, r, m, max u₁ v₁ r} M
  let a (i : Fin n) : L ⟶ N := ι i ≫ q
  let s (i : Fin n) : M.sections :=
    PresheafOfModules.sectionsMk
      (fun U => ((a i).val.app U (ULift.up (1 : R.obj.obj U))).down) (by
        intro U V f
        have h := congrArg (fun k => (k (ULift.up (1 : R.obj.obj U))).down)
          ((a i).val.naturality f)
        change ((a i).val.app V (ULift.up (R.obj.map f (1 : R.obj.obj U)))).down =
          M.val.restrictₛₗ f ((a i).val.app U (ULift.up (1 : R.obj.obj U))).down at h
        change M.val.restrictₛₗ f _ = _
        simpa only [map_one] using h.symm)
  obtain ⟨π, hπ⟩ := cofan_retractions ι hc
  have : EssentiallySmall.{max u₁ v₁ r m} D := inferInstance
  have : HasSheafify J AddCommGrpCat.{max u₁ v₁ r m} :=
    hasSheafifyEssentiallySmallSite.{_, _, _, _, max u₁ v₁ r m} J _
  have : J.WEqualsLocallyBijective AddCommGrpCat.{max u₁ v₁ r m} :=
    GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall.{_, _, _, _,
      max u₁ v₁ r m} _
  let _ : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf _).map q) :=
    Stacks.SheafOfModules.EpiMono.isLocallySurjective_of_epi q
  refine ⟨n, s, fun U t => ?_⟩
  let T := Presheaf.imageSieve ((SheafOfModules.toSheaf _).map q).hom (ULift.up t)
  refine ⟨T, Presheaf.imageSieve_mem _ _ _, fun V f hf => ?_⟩
  obtain ⟨p, hp⟩ := hf
  change P.val.obj (op V) at p
  refine ⟨fun i => ((π i).val.app (op V) p).down, ?_⟩
  have hh := congrArg (fun k : P ⟶ P => k.val.app (op V) p) hπ
  have hsum : ∑ i, (ι i).val.app (op V) ((π i).val.app (op V) p) = p := by
    let ev : (P ⟶ P) →+ P.val.obj (op V) :=
      { toFun k := k.val.app (op V) p
        map_zero' := rfl
        map_add' := by intros; rfl }
    exact (map_sum ev _ _).symm.trans hh
  let c (i : Fin n) : R.obj.obj (op V) := ((π i).val.app (op V) p).down
  have hcoef (i : Fin n) : (π i).val.app (op V) p =
      c i • (ULift.up (1 : R.obj.obj (op V)) : L.val.obj (op V)) := by
    apply ULift.ext
    change c i = _ * 1
    simp
  let e : N.val.obj (op V) →ₗ[R.obj.obj (op V)] M.val.obj (op V) :=
    ULift.moduleEquiv.toLinearMap
  have hhq := congrArg (fun z => e ((q.val.app (op V)).hom z)) hsum
  rw [map_sum, map_sum] at hhq
  have ht (i : Fin n) :
      e ((q.val.app (op V)).hom ((ι i).val.app (op V) ((π i).val.app (op V) p))) =
        c i • (show M.val.obj _ from (s i).val (op V)) := by
    rw [hcoef i]
    exact map_smul ((e ∘ₗ (q.val.app (op V)).hom) ∘ₗ ((ι i).val.app (op V)).hom)
      (c i) (ULift.up (1 : R.obj.obj (op V)) : L.val.obj (op V))
  rw [Finset.sum_congr rfl fun i _ => ht i] at hhq
  exact hhq.trans (congrArg ULift.down hp)

/-- If the image under a restriction map of a section's image vanishes, so does the image of the
section over the restricted object. -/
private lemma app_eq_zero_of_map_app_eq_zero {C : Type*} [Category C] {R : Cᵒᵖ ⥤ RingCat}
    {M N : PresheafOfModules R} (q : M ⟶ N) (s : M.sections) {X Y : Cᵒᵖ} (g : X ⟶ Y)
    (h : N.map g (q.app X (s.1 X)) = 0) : q.app Y (s.1 Y) = 0 := by
  exact (congrArg (fun x => q.app Y x) (s.2 g)).symm.trans
    ((PresheafOfModules.naturality_apply q g _).trans h)

/-- If a locally surjective morphism of sheaves of modules kills finitely many sections which
span its source locally, then its target has only the zero section over every object below the
one carrying the sections. -/
private lemma subsingleton_of_zero_generators {M N : SheafOfModules.{m} R} (q : M ⟶ N)
    [Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map q)]
    {n : ℕ} (s : Fin n → M.sections)
    (hs : ∀ (U : D) (t : M.val.obj (op U)),
      ∃ T : Sieve U, T ∈ J U ∧ ∀ (V : D) (f : V ⟶ U), T f →
        ∃ a : Fin n → R.obj.obj (op V),
          ∑ i, a i • (show M.val.obj _ from (s i).val (op V)) =
            M.val.restrictₛₗ f.op t)
    (U : D) (hz : ∀ i, q.val.app (op U) ((s i).val (op U)) = 0)
    (V : D) (f : V ⟶ U) : Subsingleton (N.val.obj (op V)) := by
  have hzero (W : D) (g : W ⟶ U) (i : Fin n) :
      q.val.app (op W) ((s i).val (op W)) = 0 :=
    app_eq_zero_of_map_app_eq_zero q.val (s i) g.op (by rw [hz, map_zero])
  have hqzero (W : D) (g : W ⟶ U) (t : M.val.obj (op W)) : q.val.app (op W) t = 0 := by
    obtain ⟨T, hT, hgen⟩ := hs W t
    apply N.isSheaf.isSeparated _ _ hT
    intro Z k hk
    obtain ⟨a, ha⟩ := hgen Z k hk
    change N.val.restrictₛₗ k.op (q.val.app _ t) = N.val.restrictₛₗ k.op 0
    rw [map_zero]
    refine (PresheafOfModules.naturality_apply q.val k.op t).symm.trans ?_
    rw [← PresheafOfModules.restrictₛₗ_apply, ← ha]
    have hsmul (i : Fin n) : (q.val.app (op Z)).hom
        (a i • (show M.val.obj _ from (s i).val (op Z))) = 0 := by
      rw [map_smul, hzero Z (k ≫ g), smul_zero]
    exact (map_sum (q.val.app (op Z)).hom _ _).trans (Finset.sum_eq_zero fun i _ => hsmul i)
  have hNzero (t : N.val.obj (op V)) : t = 0 := by
    apply N.isSheaf.isSeparated _ _
      (Presheaf.imageSieve_mem J ((SheafOfModules.toSheaf R).map q).hom t)
    rintro W g ⟨a, ha⟩
    change N.val.restrictₛₗ g.op t = N.val.restrictₛₗ g.op 0
    rw [map_zero]
    exact ha.symm.trans (hqzero W (g ≫ f) a)
  exact ⟨fun a b => (hNzero a).trans (hNzero b).symm⟩

end Generic

/-! ### Vanishing of a sheaf near a geometric point with vanishing stalk -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

attribute [local instance] pointTopology

section Vanishing

variable {B S hS X}

/-- Finitely many sections of an abelian sheaf whose germs at a geometric point all vanish
restrict to zero on a single small étale neighbourhood of that point. -/
private lemma finite_sections_zero {p : GeometricPoint B S hS X}
    [IsCofiltered (SmallEtaleNeighborhood p)]
    (F : Sheaf (SmallEtale.topology B S hS X) AddCommGrpCat.{m})
    (hF : Subsingleton (stalkSet p (F.obj ⋙ forget AddCommGrpCat)))
    (n : ℕ) (U : SmallEtaleNeighborhood p) (s : Fin n → F.obj.obj (op U.chart)) :
    ∃ (V : SmallEtaleNeighborhood p) (f : V ⟶ U), ∀ i, F.obj.map f.hom.op (s i) = 0 := by
  induction n generalizing U with
  | zero => exact ⟨U, 𝟙 U, fun i => Fin.elim0 i⟩
  | succ n ih =>
    obtain ⟨V, f, hf⟩ := ih U (fun i => s i.succ)
    let P := SmallEtaleNeighborhood.sections (x := p) (F.obj ⋙ forget AddCommGrpCat)
    have heq : P.ιColimitType (op V) (F.obj.map f.hom.op (s 0)) =
        P.ιColimitType (op V) (0 : F.obj.obj (op V.chart)) := hF.elim _ _
    obtain ⟨W, g, hg⟩ := (Functor.ιColimitType_eq_iff_of_isFiltered' (F := P) _ _).mp heq
    refine ⟨W.unop, g.unop ≫ f, fun i => ?_⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · change F.obj.map (g.unop.hom ≫ f.hom).op (s 0) = 0
      rw [op_comp, F.obj.map_comp]
      change F.obj.map g.unop.hom.op (F.obj.map f.hom.op (s 0)) = 0
      change F.obj.map g.unop.hom.op (F.obj.map f.hom.op (s 0)) =
        F.obj.map g.unop.hom.op (0 : F.obj.obj (op V.chart)) at hg
      simpa only [map_zero] using hg
    · change F.obj.map (g.unop.hom ≫ f.hom).op (s j.succ) = 0
      rw [op_comp, F.obj.map_comp]
      change F.obj.map g.unop.hom.op (F.obj.map f.hom.op (s j.succ)) = 0
      rw [hf, map_zero]

/-- A sheaf with only the zero section over every refinement of a small étale neighbourhood of
a geometric point has vanishing stalk at that point. -/
private lemma stalk_subsingleton_of_neighborhood {p : GeometricPoint B S hS X}
    [IsCofiltered (SmallEtaleNeighborhood p)]
    (F : Sheaf (SmallEtale.topology B S hS X) AddCommGrpCat.{m})
    (U : SmallEtaleNeighborhood p)
    (hU : ∀ (V : SmallEtale B S hS X) (_ : V ⟶ U.chart), Subsingleton (F.obj.obj (op V))) :
    Subsingleton (stalkSet p (F.obj ⋙ forget AddCommGrpCat)) := by
  let P := SmallEtaleNeighborhood.sections (x := p) (F.obj ⋙ forget AddCommGrpCat)
  refine ⟨fun a b => ?_⟩
  obtain ⟨A, a, rfl⟩ := P.ιColimitType_jointly_surjective a
  obtain ⟨A', b, rfl⟩ := P.ιColimitType_jointly_surjective b
  obtain ⟨W, f, g, _⟩ := IsCofilteredOrEmpty.cone_objs A.unop A'.unop
  obtain ⟨Z, h, k, _⟩ := IsCofilteredOrEmpty.cone_objs W U
  exact (P.ιColimitType_eq_iff_of_isFiltered a b).mpr
    ⟨op Z, (h ≫ f).op, (h ≫ g).op, (hU Z.chart k.hom).elim _ _⟩

end Vanishing

/-- A geometric point at which the stalk of a module of finite type vanishes has a small étale
neighbourhood over every refinement of which the module has only the zero section.

Finitely many generators of the module exist on a covering of any neighbourhood; the
generators are pulled back to a chart through which the geometric point factors, their germs
at the point vanish, hence they restrict to zero on a smaller neighbourhood, and there they
still span. -/
theorem exists_zero_neighborhood_of_isFiniteTypeOnSite (hX : IsAlgebraicSpace B S hS X)
    {G H : Modules.{u, m} B S hS X hX} [SheafOfModules.IsFiniteTypeOnSite G] (q : G ⟶ H)
    [Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf _).map q)]
    (p : GeometricPoint B S hS X)
    (hp : Subsingleton (stalkSet p
      (((SheafOfModules.toSheaf _).obj H).obj ⋙ forget AddCommGrpCat))) :
    ∃ U : SmallEtaleNeighborhood p,
      ∀ (V : SmallEtale B S hS X) (_ : V ⟶ U.chart), Subsingleton (H.val.obj (op V)) := by
  classical
  have := isCofiltered_smallEtaleNeighborhood B S hS X hX p
  obtain ⟨U₀⟩ := (IsCofiltered.nonempty : Nonempty (SmallEtaleNeighborhood p))
  obtain ⟨I, V, f, hf, hgen⟩ :=
    SheafOfModules.IsFiniteTypeOnSite.locally_finitelyGenerated (F := G) U₀.chart
  let Φ := etaleSitePoint B S hS X p hX
  obtain ⟨W, g, hg, w, hw⟩ := Φ.jointly_surjective _ hf
    (show Φ.fiber.obj U₀.chart from ⟨U₀.point, U₀.point_comp⟩)
  obtain ⟨i, k, hk⟩ := Sieve.ofArrows.exists hg
  let z := (geometricFiber B S hS X p).map k w
  let U : SmallEtaleNeighborhood p := ⟨V i, z.val, z.property⟩
  obtain ⟨n, s, hs⟩ := finiteGlobalGenerators_local_span (G.over (V i)) (hgen i)
  let t (i : Fin n) : H.val.obj (op U.chart) :=
    q.val.app _ ((s i).val (op (Over.mk (𝟙 U.chart))))
  obtain ⟨N, a, ha⟩ := finite_sections_zero ((SheafOfModules.toSheaf _).obj H) hp n U t
  let R := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X hX).O)
  let _ : Sheaf.IsLocallySurjective
      ((SheafOfModules.toSheaf (R.over U.chart)).map (q.over U.chart)) :=
    locallySurjective_over q U.chart
  have hz (j : Fin n) : (q.over U.chart).val.app (op (Over.mk a.hom))
      ((s j).val (op (Over.mk a.hom))) = 0 :=
    app_eq_zero_of_map_app_eq_zero (q.over U.chart).val (s j)
      (Over.homMk a.hom (by simp) : Over.mk a.hom ⟶ Over.mk (𝟙 U.chart)).op (ha j)
  exact ⟨N, fun W b => subsingleton_of_zero_generators (q.over U.chart) s hs
    (Over.mk a.hom) hz (Over.mk (b ≫ a.hom)) (Over.homMk b (by rfl))⟩

/-- **Stacks 07TZ, part (1).** The support of an `𝒪_X`-module of finite type on an algebraic
space `X` is closed in the point set of `X`.

Outside the support pick a geometric point over the given point; its stalk vanishes, so there
is an étale chart carrying only the zero section of the module.  The image of the point set of
that chart is open, because an étale chart is open on points by clause (3) of Stacks 03BX, it
contains the given point, and it misses the support: a geometric point of `X` over a point of
the image lifts to the chart by Stacks 05VN, so the chart is a neighbourhood of it and its
stalk vanishes too. -/
@[stacks 07TZ "support_closed"]
theorem isClosed_supportOfSheaf_of_isFiniteTypeOnSite (hX : IsAlgebraicSpace B S hS X)
    (F : Modules.{u, m} B S hS X hX) [SheafOfModules.IsFiniteTypeOnSite F] :
    IsClosed (supportOfSheaf B S hS X ((SheafOfModules.toSheaf _).obj F)) := by
  classical
  set M := (SheafOfModules.toSheaf _).obj F
  rw [← isOpen_compl_iff, isOpen_iff_mem_nhds]
  intro x hx
  obtain ⟨p, hpx⟩ := exists_geometricRepresentative B S hS X x
  have hpzero : Subsingleton (stalkSet p (M.obj ⋙ forget AddCommGrpCat)) := by
    by_contra h
    exact hx ⟨p, hpx, h⟩
  obtain ⟨U, hU⟩ := exists_zero_neighborhood_of_isFiniteTypeOnSite B S hS X hX (𝟙 F) p hpzero
  set C := U.chart.obj
  set φ := pointsMap B S hS (yoneda.obj C.left) C.hom
  have hCetale : IsEtale B S hS C.hom := isEtale_of_presheaf_etale B S hS U.chart.property
  have hO : IsOpen (Set.range φ) :=
    (isOpenMap_pointsMap_of_presheafEtale B S hS C.hom U.chart.property).isOpen_range
  have hxO : x ∈ Set.range φ :=
    ⟨(neighborhoodPoint B S hS X U).image, (neighborhoodPoint_image B S hS X U).trans hpx⟩
  have hOsub : Set.range φ ⊆ (supportOfSheaf B S hS X M)ᶜ := by
    rintro _ ⟨z, rfl⟩ ⟨rbar, hr, hrn⟩
    obtain ⟨pz, -, hval⟩ := exists_geometricPoint_lift_of_isEtale B S hS
      (isAlgebraicSpace_yoneda B S hS C.left) hX C.hom hCetale rbar z hr.symm
    refine hrn ?_
    have hreq : (⟨FieldValuedPoint.map B S hS (yoneda.obj C.left) C.hom pz.val,
        pz.property⟩ : GeometricPoint B S hS X) = rbar := Subtype.ext hval
    rw [← hreq]
    have := isCofiltered_smallEtaleNeighborhood B S hS X hX
      (⟨FieldValuedPoint.map B S hS (yoneda.obj C.left) C.hom pz.val, pz.property⟩ :
        GeometricPoint B S hS X)
    exact stalk_subsingleton_of_neighborhood M ⟨U.chart, pz.val.value, rfl⟩ hU
  exact Filter.mem_of_superset (hO.mem_nhds hxO) hOsub

end AlgebraicGeometry.Space

end
