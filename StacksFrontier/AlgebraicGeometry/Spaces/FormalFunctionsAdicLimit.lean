@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.SiteModules
open scoped IsMulCommutative

universe u w s t r v a

namespace AlgebraicGeometry.Space

/-- The sections of the structure sheaf of a ringed site commute, in the shape the
global-sections constructions of `Stacks.Cohomology.SiteModules` take as a hypothesis.  Sheaves
of modules are indexed by a `RingCat`-valued sheaf, where commutativity is not an instance; it
is transported here from the `CommRingCat`-valued structure sheaf of the ringed site. -/
local instance isMulCommutative_ringSheaf (X : RingedSite.{s, t, r}) :
    ∀ U, IsMulCommutative (((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj U) :=
  fun U => ⟨⟨fun a b => RingedSite.mul_comm_ringSheaf X U a b⟩⟩

/-! ## The adic tower of a sheaf of modules on a site, and its cohomology -/

namespace SiteAdicCohomology

variable {C : Type s} [Category.{t} C] {J : GrothendieckTopology C} (O : Sheaf J RingCat.{r})
  [∀ X : Cᵒᵖ, IsMulCommutative (O.obj.obj X)] {A : Type a} [CommRing A]
  (φ : A →+* ↥(GlobalSectionRing O)) (I : Ideal A) (F : SheafOfModules.{max s t r v} O)

/-! ### The tower of quotients `ℱ / I ^ n ℱ` -/

/-- The ideal of global functions generated by the image of `I ^ n`: the global-sections avatar
of the ideal sheaf `(I · 𝒪) ^ n = I ^ n · 𝒪`. -/
def mapIdealPow (n : ℕ) : Ideal ↥(GlobalSectionRing O) := Ideal.map φ (I ^ n)

/-- A global function coming from `I ^ n` lies in `mapIdealPow O φ I n`. -/
lemma mem_mapIdealPow (n : ℕ) {α : A} (hα : α ∈ I ^ n) : φ α ∈ mapIdealPow O φ I n :=
  Ideal.mem_map_of_mem _ hα

/-- The ideals of global functions generated by the powers of `I` decrease. -/
lemma mapIdealPow_le {m n : ℕ} (h : m ≤ n) : mapIdealPow O φ I n ≤ mapIdealPow O φ I m :=
  Ideal.map_mono (Ideal.pow_le_pow_right h)

/-- The quotient `ℱ / I ^ n ℱ`: the cokernel of the map whose image is the subsheaf generated by
the `I ^ n`-multiples of the sections of `ℱ`. -/
def adicQuotient (n : ℕ) : SheafOfModules.{max s t r v} O :=
  cokernel (idealSmulHom O (mapIdealPow O φ I n) F)

/-- The projection `ℱ ⟶ ℱ / I ^ n ℱ`. -/
def adicProj (n : ℕ) : F ⟶ adicQuotient O φ I F n :=
  cokernel.π (idealSmulHom O (mapIdealPow O φ I n) F)

/-- The exponent-lowering map `ℱ / I ^ n ℱ ⟶ ℱ / I ^ m ℱ` for `m ≤ n`: the projection to the
smaller quotient kills the `I ^ n`-multiples, since `I ^ n ⊆ I ^ m`. -/
def adicDrop {m n : ℕ} (h : m ≤ n) : adicQuotient O φ I F n ⟶ adicQuotient O φ I F m :=
  cokernel.desc _ (adicProj O φ I F m) (by
    apply Sigma.hom_ext
    intro b
    rw [← Category.assoc, ι_idealSmulHom]
    exact globalSmul_comp_cokernelπ O (mapIdealPow O φ I m) F
      (mapIdealPow_le O φ I h b.down.2))

/-- The projections to the quotients are compatible with the exponent-lowering maps. -/
@[reassoc]
lemma adicProj_comp_adicDrop {m n : ℕ} (h : m ≤ n) :
    adicProj O φ I F n ≫ adicDrop O φ I F h = adicProj O φ I F m :=
  cokernel.π_desc _ _ _

/-- **Multiplication by a global function coming from `I ^ n` is the zero endomorphism of
`ℱ / I ^ n ℱ`.** The projection from `ℱ` is an epimorphism and multiplication commutes with it,
so it suffices that the composite `ℱ ⟶ ℱ ⟶ ℱ / I ^ n ℱ` vanishes, which is the defining
property of the cokernel. -/
lemma globalSmul_adicQuotient_eq_zero (n : ℕ) {b : ↥(GlobalSectionRing O)}
    (hb : b ∈ mapIdealPow O φ I n) :
    globalSmul O b (adicQuotient O φ I F n) = 0 := by
  have hepi : Epi (adicProj O φ I F n) :=
    inferInstanceAs (Epi (cokernel.π (idealSmulHom O (mapIdealPow O φ I n) F)))
  refine (cancel_epi (adicProj O φ I F n)).1 ?_
  rw [comp_zero, comp_globalSmul]
  exact globalSmul_comp_cokernelπ O (mapIdealPow O φ I n) F hb

/-! ### The tower of cohomology modules -/

/-- Cohomology of the site with scalars restricted to `A` along `φ`. -/
abbrev cohomologyRes (p : ℕ) (M : SheafOfModules.{max s t r v} O) :
    ModuleCat.{max s t r v} A :=
  (ModuleCat.restrictScalars φ).obj ((globalModuleCohomology.{s, t, r, v} O p).obj M)

/-- Functoriality of `AlgebraicGeometry.Space.SiteAdicCohomology.cohomologyRes`. -/
abbrev cohomologyResMap (p : ℕ) {M N : SheafOfModules.{max s t r v} O} (ψ : M ⟶ N) :
    cohomologyRes O φ p M ⟶ cohomologyRes O φ p N :=
  (ModuleCat.restrictScalars φ).map ((globalModuleCohomology.{s, t, r, v} O p).map ψ)

/-- `H ^ p (C, ℱ)`, as an `A`-module. -/
abbrev cohomologyBase (p : ℕ) : Type (max s t r v) := cohomologyRes O φ p F

/-- The `n`-th term `H ^ p (C, ℱ / I ^ n ℱ)` of the tower, as an `A`-module. -/
abbrev cohomologyAdicTower (p n : ℕ) : Type (max s t r v) :=
  cohomologyRes O φ p (adicQuotient O φ I F n)

/-- The transition map `H ^ p (C, ℱ / I ^ n ℱ) ⟶ H ^ p (C, ℱ / I ^ m ℱ)` of the tower, for
`m ≤ n`. -/
abbrev cohomologyAdicTowerMap (p : ℕ) (m n : ℕ) (h : m ≤ n) :
    cohomologyAdicTower O φ I F p n →ₗ[A] cohomologyAdicTower O φ I F p m :=
  (cohomologyResMap O φ p (adicDrop O φ I F h)).hom

/-- The map `H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)`. -/
abbrev cohomologyAdicProj (p n : ℕ) :
    cohomologyBase O φ F p →ₗ[A] cohomologyAdicTower O φ I F p n :=
  (cohomologyResMap O φ p (adicProj O φ I F n)).hom

/-- The image of a cohomology class under `H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)`.  Named for
the same reason as the other abbreviations here: it is instantiated, not re-elaborated, at the
small étale ringed site of an algebraic space, where resynthesizing the coercion of a linear map
to a function does not terminate. -/
abbrev projClass (p n : ℕ) (x : cohomologyBase O φ F p) : cohomologyAdicTower O φ I F p n :=
  cohomologyAdicProj O φ I F p n x

/-- The maps out of `H ^ p (C, ℱ)` are compatible with the transitions of the tower: the
projections to the quotients are, and `H ^ p` is a functor. -/
lemma cohomologyAdicTowerMap_comp_cohomologyAdicProj (p : ℕ) (m n : ℕ) (h : m ≤ n) :
    (cohomologyAdicTowerMap O φ I F p m n h).comp (cohomologyAdicProj O φ I F p n) =
      cohomologyAdicProj O φ I F p m := by
  refine LinearMap.ext fun x => ?_
  have hc : cohomologyResMap O φ p (adicProj O φ I F n) ≫
      cohomologyResMap O φ p (adicDrop O φ I F h) =
      cohomologyResMap O φ p (adicProj O φ I F m) := by
    rw [← Functor.map_comp, ← Functor.map_comp, adicProj_comp_adicDrop]
  have hval := LinearMap.congr_fun (ModuleCat.hom_ext_iff.1 hc) x
  simp only [ModuleCat.hom_comp, LinearMap.coe_comp] at hval
  exact hval

/-- **`I ^ n` annihilates `H ^ p (C, ℱ / I ^ n ℱ)`.** Multiplication by a global function coming
from `I ^ n` is the zero endomorphism of the sheaf `ℱ / I ^ n ℱ`, and cohomology of the site is
linear over the global functions, so that function acts as zero on `H ^ p`.  The action of
`α : A` is by definition the action of `φ α`. -/
lemma smul_cohomologyAdicTower_eq_zero (p n : ℕ) {α : A} (hα : α ∈ I ^ n)
    (y : cohomologyAdicTower O φ I F p n) : α • y = 0 := by
  have hz : (globalModuleCohomology.{s, t, r, v} O p).map
      (globalSmul O (φ α) (adicQuotient O φ I F n)) = 0 := by
    rw [globalSmul_adicQuotient_eq_zero O φ I F n (mem_mapIdealPow O φ I n hα),
      Functor.map_zero]
  rw [globalSmul_eq_smul_id, Functor.map_smul, CategoryTheory.Functor.map_id] at hz
  exact LinearMap.congr_fun (ModuleCat.hom_ext_iff.1 hz) y

/-- `I ^ n H ^ p (C, ℱ)` is contained in the kernel of `H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)`,
because the target is annihilated by `I ^ n`. -/
lemma pow_smul_top_le_ker_cohomologyAdicProj (p n : ℕ) :
    I ^ n • (⊤ : Submodule A (cohomologyBase O φ F p)) ≤
      LinearMap.ker (cohomologyAdicProj O φ I F p n) := by
  refine Submodule.smul_le.2 fun α hα x _ => ?_
  rw [LinearMap.mem_ker, map_smul]
  exact smul_cohomologyAdicTower_eq_zero O φ I F p n hα _

/-! ### The theorem on formal functions for an arbitrary site -/

section Comparison

/-- **Clauses (1) and (3) of [Stacks, Tag 08AY]** for the tower `n ↦ H ^ p (C, ℱ / I ^ n ℱ)`,
bundled.  The shift `c` belongs to clause (1) alone; clause (3) carries its own level for each
`n`, as in the source.

In Situation 08AV these are theorems; on an arbitrary site they are a hypothesis, and this is
the hypothesis [Stacks, Tag 08AZ] is proved from.  They are bundled into a structure because
restating either of them at the small étale ringed site of an algebraic space makes the
elaborator resynthesize the module structures of the cohomology groups at that site, which does
not terminate; instantiating a single named hypothesis at those arguments costs nothing. -/
structure IsAdicCohomologyBound (p c : ℕ) : Prop where
  /-- Clause (1) of [Stacks, Tag 08AY]: for `n ≥ c` the kernel of
  `H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)` is contained in `I ^ (n - c) H ^ p (C, ℱ)`. -/
  ker_le : ∀ n : ℕ, c ≤ n →
    LinearMap.ker (cohomologyAdicProj O φ I F p n) ≤
      I ^ (n - c) • (⊤ : Submodule A (cohomologyBase O φ F p))
  /-- Clause (3) of [Stacks, Tag 08AY]: for every `n` there is a level `c₂ ≥ n` such that for all
  `k ≥ c₂` the image of `H ^ p (C, ℱ / I ^ k ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)` is the image of
  `H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)`.

  The level `c₂` depends on `n` and is unrelated to the shift `c` of `ker_le`, exactly as in the
  source: the threshold produced by the Artin-Rees argument of
  `Stacks.AdicCohomologyBound.exists_range_transition_eq_range_proj` grows with `n`, both because
  the Artin-Rees constant there belongs to a submodule of `H ^ (p+1) (C, I ^ n ℱ)`, a module that
  varies with `n` and that nothing in 08AY or 08AX bounds uniformly, and because the step
  "`I ^ (N - c₃)` kills `H ^ p (C, ℱ / I ^ n ℱ)`" needs `N - c₃ ≥ n`.  A uniform shift, with
  threshold `n + c`, would therefore be strictly stronger than 08AY and is not asked for here;
  the proof below uses this field one `n` at a time. -/
  range_eq : ∀ n : ℕ, ∃ c₂ : ℕ, n ≤ c₂ ∧ ∀ (k : ℕ) (h : n ≤ k), c₂ ≤ k →
    LinearMap.range (cohomologyAdicTowerMap O φ I F p n k h) =
      LinearMap.range (cohomologyAdicProj O φ I F p n)

/-- The limit `lim_n H ^ p (C, ℱ / I ^ n ℱ)` of the tower, as a submodule of the product. -/
abbrev cohomologyAdicLimit (p : ℕ) :=
  Stacks.IntertwinedFiltration.towerLimit (cohomologyAdicTower O φ I F p)
    (cohomologyAdicTowerMap O φ I F p)

/-- The projection `lim_n H ^ p (C, ℱ / I ^ n ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)`. -/
abbrev cohomologyAdicLimitProj (p n : ℕ) :
    cohomologyAdicLimit O φ I F p →ₗ[A] cohomologyAdicTower O φ I F p n :=
  Stacks.IntertwinedFiltration.towerLimit.proj n

/-- The `I`-adic completion `H ^ p (C, ℱ)^∧_I` of the cohomology of `ℱ`.

Like the other abbreviations of this section it is named so that it can be *instantiated* at the
small étale ringed site of an algebraic space rather than re-elaborated there; writing
`AdicCompletion I (cohomologyBase ...)` out at those arguments makes the elaborator resynthesize
the module structure of the cohomology, which does not terminate. -/
abbrev adicCompletionCohomology (p : ℕ) := AdicCompletion I (cohomologyBase O φ F p)

/-- The image of a cohomology class in the `I`-adic completion of `H ^ p (C, ℱ)`. -/
abbrev ofCohomologyBase (p : ℕ) (x : cohomologyBase O φ F p) :
    adicCompletionCohomology O φ I F p :=
  AdicCompletion.of I (cohomologyBase O φ F p) x

/-- The statement the comparison proves: an `A`-linear isomorphism from the `I`-adic completion
of `H ^ p (C, ℱ)` onto the limit of the tower `n ↦ H ^ p (C, ℱ / I ^ n ℱ)`.

This is named rather than written out at its two use sites because writing it out at the small
étale ringed site of an algebraic space makes the elaborator resynthesize the module structures
of both sides there, which does not terminate. -/
abbrev CohomologyAdicComparison (p : ℕ) :=
  adicCompletionCohomology O φ I F p ≃ₗ[A] cohomologyAdicLimit O φ I F p

variable (p c : ℕ) (hb : IsAdicCohomologyBound O φ I F p c)

/-- **Stacks Project, Tag 08AZ**, the isomorphism clause, for an arbitrary site and granted
[Stacks, Tag 08AY].

With `𝒪` a sheaf of commutative rings on a site `C`, `I` an ideal of a ring `A` mapping to the
global functions by `φ` and `ℱ` an `𝒪`-module, the `I`-adic completion of `H ^ p (C, ℱ)` is the
limit of the tower `n ↦ H ^ p (C, ℱ / I ^ n ℱ)`.  That the isomorphism is the one defined by the
system of maps `H ^ p (C, ℱ) / I ^ n H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)` of the source's
statement is `adicCompletionEquivCohomologyTower_proj_of`.

This is more general than Situation 08AV, which is the case of the small étale ringed site of a
proper algebraic space over `Spec A` with a coherent module on it; that case is
`AlgebraicGeometry.Space.FormalFunctionsSituation.formalFunctionsEquiv`.  The properness,
coherence and Noetherian hypotheses of Situation 08AV enter the source's proof only through
[Stacks, Tag 08AY], which is carried here as the hypothesis `hb`, so they are not needed
separately and the statement generalizes.

[Stacks, Tag 08AZ] further asserts that the comparison is a homeomorphism for the limit
topologies.  **That clause is not proved and is not claimed by any declaration in this file.**

The containment `I ^ n H ^ p (C, ℱ) ⊆ ker (H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ))` is reproved
in place rather than taken from `pow_smul_top_le_ker_cohomologyAdicProj`: passing that lemma in
makes the elaborator compare its statement with the one the tower comparison asks for through
the `ModuleCat` coercions of the cohomology modules, which does not terminate. -/
@[stacks 08AZ "the isomorphism of A-modules only, NOT the homeomorphism for the limit \
topologies, which is not proved anywhere in this file; for an arbitrary site, generalizing \
Situation 08AV; granted the bundled hb : IsAdicCohomologyBound, whose two fields ker_le and \
range_eq are exactly Tag 08AY clauses (1) and (3), the latter with its per-n level"]
def adicCompletionEquivCohomologyTower : CohomologyAdicComparison O φ I F p := by
  refine Stacks.IntertwinedFiltration.adicCompletionEquivTowerLimitOfEventualRange
    (cohomologyAdicTower O φ I F p) (cohomologyAdicTowerMap O φ I F p)
    (cohomologyAdicProj O φ I F p) I c
    (cohomologyAdicTowerMap_comp_cohomologyAdicProj O φ I F p) ?_ hb.ker_le hb.range_eq
  intro n
  refine Submodule.smul_le.2 fun α hα x _ => ?_
  rw [LinearMap.mem_ker, map_smul]
  exact smul_cohomologyAdicTower_eq_zero O φ I F p n hα _

/-- The `n`-th component of the comparison isomorphism: the composite of
`adicCompletionEquivCohomologyTower` with the projection
`lim_n H ^ p (C, ℱ / I ^ n ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)`.

It is named because applying the comparison to an element at the small étale ringed site of an
algebraic space makes the elaborator resynthesize the coercion to a function there, which does
not terminate; instantiating this abbreviation costs nothing. -/
abbrev comparisonComponent (n : ℕ) (y : adicCompletionCohomology O φ I F p) :
    cohomologyAdicTower O φ I F p n :=
  cohomologyAdicLimitProj O φ I F p n (adicCompletionEquivCohomologyTower O φ I F p c hb y)

/-- The `n`-th component of the comparison isomorphism, evaluated at the image in the completion
of a cohomology class.  Named for the same reason as `comparisonComponent`. -/
abbrev comparisonComponentOf (n : ℕ) (x : cohomologyBase O φ F p) :
    cohomologyAdicTower O φ I F p n :=
  comparisonComponent O φ I F p c hb n (ofCohomologyBase O φ I F p x)

/-- The assertion that the `n`-th component of the comparison isomorphism carries the image in
`H ^ p (C, ℱ)^∧_I` of a cohomology class `x` to the image of `x` in `H ^ p (C, ℱ / I ^ n ℱ)`,
that is, that the comparison is the map defined by the system of projections.

It is a named `Prop` because spelling the equation out at the small étale ringed site of an
algebraic space makes the elaborator resynthesize the module structures of the cohomology groups
there, which does not terminate; instantiating this abbreviation costs nothing. -/
abbrev IsDefinedByProjections (n : ℕ) : Prop :=
  ∀ x : cohomologyBase O φ F p,
    comparisonComponentOf O φ I F p c hb n x = projClass O φ I F p n x

/-- **The comparison isomorphism is the canonical one**: its `n`-th component carries the image
in `H ^ p (C, ℱ)^∧_I` of a class `x` to the image of `x` in `H ^ p (C, ℱ / I ^ n ℱ)`.  Together
with `adicCompletionEquivCohomologyTower` this says that the system of maps
`H ^ p (C, ℱ) / I ^ n H ^ p (C, ℱ) ⟶ H ^ p (C, ℱ / I ^ n ℱ)` is what defines the isomorphism of
limits, rather than merely that the two modules are isomorphic.

This is the second assertion of the isomorphism clause of [Stacks, Tag 08AZ], for an arbitrary
site; Situation 08AV is the case of the small étale ringed site of a proper algebraic space over
`Spec A` with a coherent module on it, and nothing here asserts the homeomorphism of limit
topologies. -/
@[stacks 08AZ "the identification of the isomorphism as the one DEFINED BY the system of maps
H^p(X, F)/I^n H^p(X, F) -> H^p(X, F/I^n F) of the statement, rather than merely an abstract
isomorphism of the two limits; same carried hypothesis hb : IsAdicCohomologyBound (Tag 08AY
clauses (1) and (3)); again nothing about the limit topologies"]
lemma adicCompletionEquivCohomologyTower_proj_of (n : ℕ) :
    IsDefinedByProjections O φ I F p c hb n :=
  fun _ => rfl

end Comparison

end SiteAdicCohomology

/-! ## The theorem on formal functions in Situation 08AV -/

namespace FormalFunctionsSituation

open SiteAdicCohomology

variable (S : FormalFunctionsSituation.{u, max (u + 1) w})

/-- The structure sheaf of the small étale ringed site of the algebraic space of Situation
08AV, as a sheaf of rings: the sheaf over which the `𝒪_X`-modules are taken. -/
abbrev structureRing :=
  (Stacks.SheafOfModules.Tensor.ringSheaf
    (smallEtaleRingedSite S.site (Spec (.of S.ring)) S.containsBase S.space.1 S.space.2).O)

/-- The ring map from the base ring of Situation 08AV to the global functions of its algebraic
space, along which the cohomology of Situation 08AV is an `A`-module. -/
abbrev baseRing : S.ring →+* ↥(GlobalSectionRing (structureRing S)) :=
  baseRingHom S.ring S.site S.containsBase S.space.1 S.space.2

/-- The `n`-th infinitesimal thickening `ℱ / I ^ n ℱ` of Situation 08AV, read as an
`𝒪_X`-module on the small étale ringed site. -/
abbrev adicThickening (n : ℕ) :
    Modules.{u, max (u + 1) w} S.site (Spec (.of S.ring)) S.containsBase S.space.1 S.space.2 :=
  adicQuotient.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients n

/-- The projection `ℱ ⟶ ℱ / I ^ n ℱ` of Situation 08AV. -/
abbrev adicThickeningProj (n : ℕ) : S.coefficients ⟶ adicThickening S n :=
  adicProj.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal S.coefficients n

/-- The exponent-lowering map `ℱ / I ^ n ℱ ⟶ ℱ / I ^ m ℱ` of Situation 08AV, for `m ≤ n`. -/
abbrev adicThickeningDrop {m n : ℕ} (h : m ≤ n) : adicThickening S n ⟶ adicThickening S m :=
  adicDrop.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal S.coefficients h

/-- `H ^ p (X, ℱ)` in Situation 08AV, as an `A`-module.  That this is
`AlgebraicGeometry.Space.cohomologyOverBase` is `cohomology_eq`. -/
abbrev cohomology (p : ℕ) : Type (max (u + 1) w) :=
  cohomologyBase.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.coefficients p

/-- The `n`-th term `H ^ p (X, ℱ / I ^ n ℱ)` of the tower of Situation 08AV.  That this is
`AlgebraicGeometry.Space.cohomologyOverBase` of the thickening is `cohomologyTower_eq`. -/
abbrev cohomologyTower (p n : ℕ) : Type (max (u + 1) w) :=
  cohomologyAdicTower.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p n

/-- The cohomology used here is the cohomology of an algebraic space over its base of
`AlgebraicGeometry.Space.cohomologyOverBase`, Stacks 071H on the small étale ringed site with
scalars restricted along `AlgebraicGeometry.Space.baseRingHom`. -/
lemma cohomology_eq (p : ℕ) :
    cohomology S p =
      cohomologyOverBase.{u, w} S.ring S.site S.containsBase S.space.1 S.space.2
        S.coefficients p :=
  rfl

/-- The terms of the tower are likewise `AlgebraicGeometry.Space.cohomologyOverBase`, of the
thickenings. -/
lemma cohomologyTower_eq (p n : ℕ) :
    cohomologyTower S p n =
      cohomologyOverBase.{u, w} S.ring S.site S.containsBase S.space.1 S.space.2
        (adicThickening S n) p :=
  rfl

/-- The transition map `H ^ p (X, ℱ / I ^ n ℱ) ⟶ H ^ p (X, ℱ / I ^ m ℱ)` of the tower of
Situation 08AV, for `m ≤ n`: the cohomology of the exponent-lowering map. -/
abbrev cohomologyTowerMap (p : ℕ) (m n : ℕ) (h : m ≤ n) :=
  cohomologyAdicTowerMap.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p m n h

/-- The map `H ^ p (X, ℱ) ⟶ H ^ p (X, ℱ / I ^ n ℱ)` of Situation 08AV, the cohomology of the
projection to the `n`-th thickening: the map whose system [Stacks, Tag 08AZ] asserts to define
an isomorphism of limits. -/
abbrev cohomologyProj (p n : ℕ) :=
  cohomologyAdicProj.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p n

/-- The limit `lim_n H ^ p (X, ℱ / I ^ n ℱ)` of Situation 08AV. -/
abbrev cohomologyLimit (p : ℕ) :=
  cohomologyAdicLimit.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p

/-- The projection `lim_n H ^ p (X, ℱ / I ^ n ℱ) ⟶ H ^ p (X, ℱ / I ^ n ℱ)`. -/
abbrev cohomologyLimitProj (p n : ℕ) :=
  cohomologyAdicLimitProj.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p n

/-- The `I`-adic completion `H ^ p (X, ℱ)^∧_I` of Situation 08AV. -/
abbrev completionOfCohomology (p : ℕ) :=
  adicCompletionCohomology.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p

/-- The image of a cohomology class in `H ^ p (X, ℱ)^∧_I`. -/
abbrev ofCohomology (p : ℕ) (x : cohomology S p) :=
  ofCohomologyBase.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p x

/-- **Clauses (1) and (3) of [Stacks, Tag 08AY] in Situation 08AV**: clause (1), that for a
fixed `c` and all `n ≥ c` the kernel of `H ^ p (X, ℱ) ⟶ H ^ p (X, ℱ / I ^ n ℱ)` lies in
`I ^ (n - c) H ^ p (X, ℱ)`, and clause (3), that for every `n` there is a level `c₂ ≥ n` such
that for all `k ≥ c₂` the image of
`H ^ p (X, ℱ / I ^ k ℱ) ⟶ H ^ p (X, ℱ / I ^ n ℱ)` is the image of
`H ^ p (X, ℱ) ⟶ H ^ p (X, ℱ / I ^ n ℱ)`.  The two clauses are the fields
`AlgebraicGeometry.Space.SiteAdicCohomology.IsAdicCohomologyBound.ker_le` and `range_eq`.

This is a hypothesis here, not a theorem: [Stacks, Tag 08AY] is **not** proved in this file. -/
abbrev Is08AYBound (p c : ℕ) : Prop :=
  IsAdicCohomologyBound.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p c

/-- The statement of [Stacks, Tag 08AZ] in Situation 08AV: an `A`-linear isomorphism from
`H ^ p (X, ℱ)^∧_I` onto `lim_n H ^ p (X, ℱ / I ^ n ℱ)`. -/
abbrev Comparison (p : ℕ) :=
  CohomologyAdicComparison.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S)
    S.ideal S.coefficients p

section Theorem

variable (p c : ℕ) (h08AY : Is08AYBound S p c)

/-- **Stacks Project, Tag 08AZ** in Situation 08AV, the isomorphism clause, granted
[Stacks, Tag 08AY].

In Situation 08AV — `A` Noetherian, `I ⊆ A` an ideal, `f : X ⟶ Spec A` a proper morphism of
algebraic spaces and `ℱ` a coherent `𝒪_X`-module, all of them fields of `S` — the `I`-adic
completion of `H ^ p (X, ℱ)` is the limit of the tower `n ↦ H ^ p (X, ℱ / I ^ n ℱ)`.  The
cohomology is `AlgebraicGeometry.Space.cohomologyOverBase` (`cohomology_eq`,
`cohomologyTower_eq`) and the thickenings are the quotients of `ℱ` by the subsheaf generated by
the `I ^ n`-multiples of its sections (`adicThickening`).

**What is carried.** The hypothesis `h08AY` is the conjunction of clauses (1) and (3) of
[Stacks, Tag 08AY]; see `Is08AYBound`.  [Stacks, Tag 08AY] is not proved
in this file.  Clause (2) of that lemma, the Mittag-Leffler condition, is not needed: in this
formulation clause (3) subsumes it.  The standing hypotheses of Situation 08AV are what make
[Stacks, Tag 08AY] true and are used nowhere else in the argument, which is why `h08AY` is the
only hypothesis beyond the situation itself.

**What is not proved.** [Stacks, Tag 08AZ] further asserts that the comparison is a
homeomorphism for the limit topologies.  That clause is not proved, and no declaration in this
file claims it; neither side is given a topology here.

Everything else is proved: the thickenings and their transition maps are constructed, `I ^ n` is
shown to annihilate `H ^ p (X, ℱ / I ^ n ℱ)`, and the passage from those facts to the comparison
is `AlgebraicGeometry.Space.SiteAdicCohomology.adicCompletionEquivCohomologyTower`, which runs
the source's own argument through
`Stacks.IntertwinedFiltration.adicCompletionEquivTowerLimitOfEventualRange`.

The body is written with `have` and `exact` rather than as a direct term: elaborating the
specialization against the expected type makes the elaborator reduce the module structures of
the cohomology groups at the small étale ringed site, which does not terminate, whereas
elaborating it first and matching the two syntactically equal types afterwards is immediate. -/
@[stacks 08AZ "IN SITUATION 08AV: the isomorphism of A-modules only, NOT the homeomorphism \
for the limit topologies, which is nowhere claimed here; granted the one bundled hypothesis \
h08AY : Is08AYBound S p c, whose two fields ker_le and range_eq are exactly Tag 08AY clauses \
(1) and (3), the latter with its per-n level; Situation 08AV's hypotheses are fields of S"]
def formalFunctionsEquiv : Comparison S p := by
  have e := adicCompletionEquivCohomologyTower.{u + 1, u, u, max (u + 1) w} (structureRing S)
    (baseRing S) S.ideal S.coefficients p c h08AY
  exact e

/-- The assertion of [Stacks, Tag 08AZ] in Situation 08AV that the `n`-th component of the
comparison isomorphism carries the image in `H ^ p (X, ℱ)^∧_I` of a class `x ∈ H ^ p (X, ℱ)` to
the image of `x` in `H ^ p (X, ℱ / I ^ n ℱ)`.  Unfolded, this is

`∀ x, cohomologyLimitProj S p n (formalFunctionsEquiv S p c h08AY (ofCohomology S p x))
  = cohomologyProj S p n x`. -/
abbrev IsDefinedBy08AZProjections (n : ℕ) : Prop :=
  IsDefinedByProjections.{u + 1, u, u, max (u + 1) w} (structureRing S) (baseRing S) S.ideal
    S.coefficients p c h08AY n

/-- **The comparison isomorphism of [Stacks, Tag 08AZ] in Situation 08AV is the canonical
one**: its `n`-th component carries the image in `H ^ p (X, ℱ)^∧_I` of a class
`x ∈ H ^ p (X, ℱ)` to the image of `x` in `H ^ p (X, ℱ / I ^ n ℱ)`.

Together with `formalFunctionsEquiv` this is the assertion of [Stacks, Tag 08AZ] that the system
of maps `H ^ p (X, ℱ) / I ^ n H ^ p (X, ℱ) ⟶ H ^ p (X, ℱ / I ^ n ℱ)` is what *defines* the
isomorphism of limits, rather than merely that the two modules are isomorphic.

Carried: the same single hypothesis `h08AY`, clauses (1) and (3) of [Stacks, Tag 08AY].  Not
claimed: the homeomorphism for the limit topologies. -/
@[stacks 08AZ "IN SITUATION 08AV: the identification of the isomorphism of formalFunctionsEquiv
as the one DEFINED BY the system of maps H^p(X, F)/I^n H^p(X, F) -> H^p(X, F/I^n F) of the
statement; same carried hypothesis h08AY : Is08AYBound S p c (Tag 08AY clauses (1) and (3));
again nothing about the limit topologies"]
lemma formalFunctionsEquiv_proj_of (n : ℕ) : IsDefinedBy08AZProjections S p c h08AY n := by
  have h := adicCompletionEquivCohomologyTower_proj_of.{u + 1, u, u, max (u + 1) w}
    (structureRing S) (baseRing S) S.ideal S.coefficients p c h08AY n
  exact h

end Theorem

end FormalFunctionsSituation

end AlgebraicGeometry.Space

