@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct

universe u

/-- Over a Noetherian commutative ring the coefficient tuples whose combination of a finite
family of elements of a module lies in a given submodule are generated by finitely many of them.

No finiteness hypothesis on the module is needed: the tuples are the relations among the images
of the family in the quotient module, hence a submodule of the Noetherian module `A ^ n`. -/
theorem IsNoetherianRing.exists_fin_generating_coeffs_mem {A : Type*} [CommRing A]
    [IsNoetherianRing A] {M : Type*} [AddCommGroup M] [Module A M] (P : Submodule A M)
    {n : ℕ} (s : Fin n → M) :
    ∃ (k : ℕ) (g : Fin k → Fin n → A),
      (∀ j, ∑ i, g j i • s i ∈ P) ∧
        ∀ x : Fin n → A, ∑ i, x i • P.mkQ (s i) = 0 →
          ∃ b : Fin k → A, ∀ i, x i = ∑ j, b j * g j i := by
  obtain ⟨k, g, hg0, hgspan⟩ :=
    IsNoetherianRing.exists_fin_generating_relations (A := A) (M := M ⧸ P)
      (fun i => P.mkQ (s i))
  refine ⟨k, g, fun j => ?_, hgspan⟩
  have h : P.mkQ (∑ i, g j i • s i) = 0 := by
    rw [map_sum]
    simpa only [map_smul] using hg0 j
  simpa only [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] using h

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-- **Flat base change of the coefficient tuples landing in a submodule.**  Let `φ : V' ⟶ V` be a
morphism of étale charts with `𝒪_F(V')` flat over `𝒪_F(V)`, let `ι : N ⟶ M` be a morphism of
`𝒪_F`-modules whose base change comparison over `φ` is bijective for `M` and surjective for `N`,
and let the coefficient tuples over `V` whose combination of `s₁, …, sₙ` is a section of `N` be
generated by `g₁, …, g_k`.  Then the coefficient tuple of any combination of the restricted
sections which is a section of `N` over `V'` is an `𝒪_F(V')`-combination of the restricted `gⱼ`.

Those coefficient tuples are the relations among the images of the `sᵢ` in the quotient of the
sections of `M` over `V` by the sections of `N`, and a tuple over `V'` annihilating them in the
base change of that quotient is an `𝒪_F(V')`-combination of the `gⱼ` by
`Module.Flat.exists_coeffs_of_sum_tmul_eq_zero`.  That the tuple does annihilate them is the base
change property of the sections: the element it names in the base change of the sections of `M`
comes from the base change of the sections of `N`, by injectivity of the comparison for `M` and
surjectivity for `N`. -/
theorem exists_coeffs_of_mem_range_of_bijective_sectionsBaseChange
    {M N : Modules.{u, u} B S hS F hF} (ι : N ⟶ M)
    {V V' : SmallEtale B S hS F} (φ : V' ⟶ V)
    (hMbij : Function.Bijective (sectionsBaseChange M φ))
    (hNsurj : Function.Surjective (sectionsBaseChange N φ))
    {n k : ℕ} (s : Fin n → M.val.obj (op V))
    (g : Fin k → Fin n → chartRing B S hS F hF V) :
    letI := chartAlgebra (hF := hF) φ
    ∀ _ : Module.Flat (chartRing B S hS F hF V) (chartRing B S hS F hF V'),
      (∀ x : Fin n → chartRing B S hS F hF V,
          ∑ i, x i • (LinearMap.range (ι.val.app (op V)).hom).mkQ (s i) = 0 →
            ∃ b : Fin k → chartRing B S hS F hF V, ∀ i, x i = ∑ j, b j * g j i) →
        ∀ a : Fin n → chartRing B S hS F hF V',
          (∑ i, a i • chartRestrictLinear M φ (s i))
              ∈ LinearMap.range (ι.val.app (op V')).hom →
            ∃ c : Fin k → chartRing B S hS F hF V',
              ∀ i, a i = ∑ j, c j * chartRestrict (hF := hF) φ (g j i) := by
  let _ := chartAlgebra (hF := hF) φ
  intro hflat hgspan a ha
  set P := LinearMap.range (ι.val.app (op V)).hom
  -- the element of the base change of the sections of `M` whose coefficient tuple is `a`
  set m : TensorProduct (chartRing B S hS F hF V) (chartRing B S hS F hF V')
      (M.val.obj (op V)) := ∑ i, a i ⊗ₜ[chartRing B S hS F hF V] s i with hm
  have hmval : sectionsBaseChange M φ m = ∑ i, a i • chartRestrictLinear M φ (s i) := by
    rw [hm, map_sum]
    exact Finset.sum_congr rfl fun i _ => chartBaseChange_tmul M φ (a i) (s i)
  -- it comes from the base change of the sections of `N`, because its image does
  obtain ⟨z, hz⟩ := LinearMap.mem_range.1 ha
  obtain ⟨w, hw⟩ := hNsurj z
  have key : m = (ι.val.app (op V)).hom.lTensor (chartRing B S hS F hF V') w := by
    refine hMbij.1 ?_
    rw [hmval, ← hz, ← hw]
    exact app_sectionsBaseChange_of_commSq φ (ι.val.app (op V)) (ι.val.app (op V'))
      (fun x => PresheafOfModules.naturality_apply ι.val φ.op x) w
  -- so it vanishes in the base change of the quotient
  have hzero : ∑ i, a i ⊗ₜ[chartRing B S hS F hF V] (P.mkQ (s i)) = 0 := by
    have hcomp : P.mkQ.comp (ι.val.app (op V)).hom = 0 :=
      LinearMap.ext fun x => (Submodule.Quotient.mk_eq_zero P).2 ⟨x, rfl⟩
    have h1 : P.mkQ.lTensor (chartRing B S hS F hF V') m = 0 := by
      rw [key, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hcomp]
      simp only [LinearMap.lTensor_zero, LinearMap.zero_apply]
    rw [hm, map_sum] at h1
    simpa only [LinearMap.lTensor_tmul] using h1
  exact Module.Flat.exists_coeffs_of_sum_tmul_eq_zero
    (A := chartRing B S hS F hF V) (A' := chartRing B S hS F hF V')
    (fun i => P.mkQ (s i)) g hgspan a hzero

/-- Restriction of sections along a chart morphism carries a combination to the combination of the
restrictions with restricted coefficients. -/
private theorem chartRestrictLinear_sum_smul (M : Modules.{u, u} B S hS F hF)
    {V W : SmallEtale B S hS F} (g : W ⟶ V) {ι : Type*} [Fintype ι]
    (c : ι → chartRing B S hS F hF V) (x : ι → M.val.obj (op V)) :
    chartRestrictLinear M g (∑ j, c j • x j)
      = ∑ j, chartRestrict (hF := hF) g (c j) • chartRestrictLinear M g (x j) := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun j _ => chartRestrictLinear_smul M g (c j) (x j)

/-- **A submodule of a module on an algebraic space is generated by finitely many sections over
an affine chart with Noetherian ring of sections which carries finitely many generators of the
ambient module**, provided both modules are cartesian on affine charts.

The generating sections of the submodule are those whose images in the ambient module are the
combinations of the given generators along a finite generating family of the coefficient tuples
landing in the submodule; such a family exists because those tuples form a submodule of
`𝒪_F(V) ^ n`, which is a Noetherian module.  That they generate is
`AlgebraicGeometry.Space.exists_coeffs_of_mem_range_of_bijective_sectionsBaseChange`, applied over
the affine charts with Noetherian rings of sections which cover any chart over `V`. -/
theorem exists_generates_of_mono_of_isNoetherianAffineChart
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    {M N : Modules.{u, u} B S hS F hF} (ι : N ⟶ M) [Mono ι]
    (hMcart : IsCartesianOnAffineCharts M) (hNcart : IsCartesianOnAffineCharts N)
    (V : (smallEtaleRingedSite B S hS F hF).C) (hV : IsNoetherianAffineChart B S hS F V)
    {n : ℕ} (s : Fin n → M.val.obj (op V))
    (hs : PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J M.val s) :
    ∃ (k : ℕ) (t : Fin k → N.val.obj (op V)),
      PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J N.val t := by
  classical
  let _ := chartRing_commRing B S hS F hF V
  have hVaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj V) :=
    hV.1
  have hVn : IsNoetherianRing (chartRing B S hS F hF V) := hV.2
  -- a finite generating family of the coefficient tuples landing in the submodule
  obtain ⟨k, g, hgmem, hgspan⟩ := IsNoetherianRing.exists_fin_generating_coeffs_mem
    (A := chartRing B S hS F hF V) (M := M.val.obj (op V))
    (LinearMap.range (ι.val.app (op V)).hom) s
  choose t ht using fun j => LinearMap.mem_range.1 (hgmem j)
  refine ⟨k, t, fun Z f u => ?_⟩
  -- locally on `Z` the image of the given section is a combination of the generators of `M`
  obtain ⟨Sv₁, hSv₁, hgen⟩ := hs Z f (ι.val.app (op Z) u)
  -- refine that covering sieve by the affine charts with Noetherian rings of sections
  let Sv₂ : Sieve Z :=
    { arrows := fun Y h => ∃ (A : (smallEtaleRingedSite B S hS F hF).C) (l : Y ⟶ A)
        (mm : A ⟶ Z), IsNoetherianAffineChart B S hS F A ∧ Sv₁ mm ∧ h = l ≫ mm
      downward_closed := by
        rintro Y Y' h ⟨A, l, mm, hA, hmm, rfl⟩ q
        exact ⟨A, q ≫ l, mm, hA, hmm, (Category.assoc q l mm).symm⟩ }
  refine ⟨Sv₂, ?_, ?_⟩
  · refine (smallEtaleRingedSite B S hS F hF).J.transitive hSv₁ _ ?_
    intro Y mm hmm
    obtain ⟨Sv, hSv, hfac⟩ :=
      exists_covering_through_noetherianAffine B S hS F hF Fact.out Y
    refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_ hSv
    intro Y' q hq
    obtain ⟨A, l, mA, hA, rfl⟩ := hfac q hq
    exact ⟨A, l, mA ≫ mm, hA, Sv₁.downward_closed hmm mA, Category.assoc l mA mm⟩
  · intro Y h hh
    obtain ⟨A, l, mm, hA, hmm, rfl⟩ := hh
    let _ := chartRing_commRing B S hS F hF A
    let _ := chartAlgebra (hF := hF) (mm ≫ f)
    have hAaff : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj A) :=
      hA.1
    have hflat : Module.Flat (chartRing B S hS F hF V) (chartRing B S hS F hF A) :=
      flat_chartRestrict_of_isAffine (hF := hF) (mm ≫ f) hVaff hAaff
    -- the combination of the generators of `M` available over the chart `A`
    obtain ⟨a, ha⟩ := hgen A mm hmm
    have ha' : ∑ i, a i • chartRestrictLinear M (mm ≫ f) (s i)
        = (ι.val.app (op A)).hom (chartRestrictLinear N mm u) :=
      ha.trans (PresheafOfModules.naturality_apply ι.val mm.op u).symm
    obtain ⟨c, hc⟩ := exists_coeffs_of_mem_range_of_bijective_sectionsBaseChange
      B S hS F hF ι (mm ≫ f) (hMcart V A hVaff hAaff (mm ≫ f))
      (hNcart V A hVaff hAaff (mm ≫ f)).2 s g hflat hgspan a
      (LinearMap.mem_range.2 ⟨chartRestrictLinear N mm u, ha'.symm⟩)
    refine ⟨fun j => chartRestrict (hF := hF) l (c j), ?_⟩
    -- the corresponding combination of the generators of `N`, over `A` and then over `Y`
    have hoverA : ∑ j, c j • chartRestrictLinear N (mm ≫ f) (t j)
        = chartRestrictLinear N mm u := by
      refine Stacks.SheafOfModules.injective_val_of_mono ι (op A) ?_
      calc (ι.val.app (op A)).hom (∑ j, c j • chartRestrictLinear N (mm ≫ f) (t j))
          = ∑ j, c j • chartRestrictLinear M (mm ≫ f) ((ι.val.app (op V)).hom (t j)) := by
            rw [map_sum]
            exact Finset.sum_congr rfl fun j _ => (map_smul _ _ _).trans
              (congrArg (fun z => c j • z)
                (PresheafOfModules.naturality_apply ι.val (mm ≫ f).op (t j)))
        _ = ∑ j, ∑ i, (c j * chartRestrict (hF := hF) (mm ≫ f) (g j i)) •
              chartRestrictLinear M (mm ≫ f) (s i) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [ht j]
            refine (congrArg (c j • ·)
              (chartRestrictLinear_sum_smul B S hS F hF M (mm ≫ f) (g j) s)).trans ?_
            rw [Finset.smul_sum]
            exact Finset.sum_congr rfl fun i _ => smul_smul _ _ _
        _ = ∑ i, a i • chartRestrictLinear M (mm ≫ f) (s i) := by
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl fun i _ =>
              Finset.sum_smul.symm.trans (congrArg
                (fun z => z • chartRestrictLinear M (mm ≫ f) (s i)) (hc i).symm)
        _ = (ι.val.app (op A)).hom (chartRestrictLinear N mm u) := ha'
    have hgoal := (chartRestrictLinear_sum_smul B S hS F hF N l c
      fun j => chartRestrictLinear N (mm ≫ f) (t j)).symm.trans
      ((congrArg (chartRestrictLinear N l) hoverA).trans (chartRestrictLinear_comp N mm l u).symm)
    refine Eq.trans (Finset.sum_congr rfl fun j _ => ?_) hgoal
    rw [← chartRestrictLinear_comp N (mm ≫ f) l (t j), Category.assoc]
    rfl

/-- The étale charts which are affine with Noetherian ring of sections and over which a module of
finite type on a locally Noetherian algebraic space is generated by finitely many sections cover
its small étale site.

The charts carrying finitely many generators cover because the module is of finite type, and a
restriction of a generating family is generating; the affine charts with Noetherian rings of
sections covering each of those are what local Noetherianity supplies. -/
theorem coversTop_isNoetherianAffineChart_generates
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    (M : Modules.{u, u} B S hS F hF)
    (hM : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J M.val) :
    (smallEtaleRingedSite B S hS F hF).J.CoversTop
      (Subtype.val : {V : (smallEtaleRingedSite B S hS F hF).C //
          IsNoetherianAffineChart B S hS F V ∧ ∃ (n : ℕ) (s : Fin n → M.val.obj (op V)),
            PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J M.val s} →
        (smallEtaleRingedSite B S hS F hF).C) := by
  intro Y
  obtain ⟨I, U, hU, hgen⟩ := hM.exists_generators
  refine (smallEtaleRingedSite B S hS F hF).J.transitive (hU Y) _ ?_
  intro Z h hh
  obtain ⟨i, ⟨q⟩⟩ := (Sieve.mem_ofObjects_iff U h).1 hh
  obtain ⟨n, sU, hsU⟩ := hgen i
  obtain ⟨Sv, hSv, hfac⟩ := exists_covering_through_noetherianAffine B S hS F hF Fact.out Z
  refine (smallEtaleRingedSite B S hS F hF).J.superset_covering ?_ hSv
  intro Y' y hy
  obtain ⟨A, l, mm, hA, rfl⟩ := hfac y hy
  exact ⟨⟨A, hA, n, _, hsU.restrict (mm ≫ q)⟩, ⟨l⟩⟩

/-- A module coherent on the small étale ringed site is cartesian on affine charts. -/
private theorem isCartesianOnAffineCharts_of_isCoherentOnSite
    (M : Modules.{u, u} B S hS F hF) (hM : SheafOfModules.IsCoherentOnSite M) :
    IsCartesianOnAffineCharts M :=
  isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF M
    (isCoherent_of_isCoherentOnSite B S hS F hF M).toIsQuasicoherentOnSite

/-- **A quasi-coherent submodule of a coherent module on a locally Noetherian algebraic space is
of finite type.**

This is the one assertion of Stacks 07UD which needs local Noetherianity, and the one from which
both of its clauses follow.  The covering family is
`AlgebraicGeometry.Space.coversTop_isNoetherianAffineChart_generates` and the generators on each
of its members are `AlgebraicGeometry.Space.exists_generates_of_mono_of_isNoetherianAffineChart`;
the two cartesian properties those need are Descent, Proposition 03DX(2) applied to `M`, which is
quasi-coherent because it is coherent on the site, and to `N`. -/
theorem isFiniteType_of_mono_of_isQuasicoherentOnSite
    [Fact (HasEtaleLocalProperty B S hS F (fun V : Scheme.{u} => IsLocallyNoetherian V))]
    {M N : Modules.{u, u} B S hS F hF} (ι : N ⟶ M) [Mono ι]
    (hN : N.IsQuasicoherentOnSite) (hM : SheafOfModules.IsCoherentOnSite M) :
    PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J N.val := by
  have hMcart := isCartesianOnAffineCharts_of_isCoherentOnSite B S hS F hF M hM
  have hNcart := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF N hN
  refine ⟨{V : (smallEtaleRingedSite B S hS F hF).C //
      IsNoetherianAffineChart B S hS F V ∧ ∃ (n : ℕ) (s : Fin n → M.val.obj (op V)),
        PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J M.val s},
    Subtype.val, coversTop_isNoetherianAffineChart_generates B S hS F hF M hM.isFiniteType,
    fun Vs => ?_⟩
  obtain ⟨n, s, hs⟩ := Vs.2.2
  exact exists_generates_of_mono_of_isNoetherianAffineChart B S hS F hF ι hMcart hNcart
    Vs.1 Vs.2.1 s hs

/-- **The submodule clause of Stacks 07UD on the small étale ringed site.**  A quasi-coherent
submodule of a module coherent on the small étale ringed site of a locally Noetherian algebraic
space is itself coherent on that site.

The submodule is of finite type by
`AlgebraicGeometry.Space.isFiniteType_of_mono_of_isQuasicoherentOnSite`, and a submodule of finite
type of a coherent module is coherent by
`AlgebraicGeometry.Space.isCoherentOnSite_of_mono_of_isFiniteType`. -/
@[stacks 07UD "a quasi-coherent submodule of a coherent module is coherent"]
