module

public import StacksFrontier.AlgebraicGeometry.Spaces.CompactGeneration.GenerationStep
public import StacksCore.Tactic.StacksAttribute

/-!
# Compact generation of `D_QCoh` of a quasi-compact quasi-separated algebraic space

For a quasi-compact and quasi-separated algebraic space `X`, `D_QCoh(𝒪_X)` has a compact object
which is a weak triangulated generator. This is the content of [Stacks, Tag 09IY] that Brown
representability consumes; the generator is exhibited as a compact object rather than as a perfect
one. The proof is the induction principle of [Stacks, Tag 08GP]: the affine case is
`AlgebraicGeometry.Space.isCompactObject_and_isWeakTriangulatedGenerator_unitQuasicoherent`, and
the step across an elementary distinguished square is
`AlgebraicGeometry.Space.exists_compact_generator_of_eds`.

As a consequence, for a morphism `f : X ⟶ Y` of quasi-compact quasi-separated algebraic spaces,
`Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)` has a right adjoint, which is exact
([Stacks, Tag 0E55]), by Brown representability ([Stacks, Tag 0A8G]).

## Main results

* `AlgebraicGeometry.Space.exists_isCompactObject_isWeakTriangulatedGenerator_of_qcqs`.
* `AlgebraicGeometry.Space.exists_isTriangulated_rightAdjoint_quasicoherentDerivedPushforward`:
  **Stacks 0E55**.
* `AlgebraicGeometry.Space.isLeftAdjoint_quasicoherentDerivedPushforward`: **Stacks 0E55**, as a
  left adjointness statement.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Pretriangulated

attribute [local instance 5000] SheafOfModules.instAbelian

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] HasDerivedCategory.standard

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (hZ : B.Contains (⊤_ Scheme.{u}))

attribute [-instance] CategoryTheory.Limits.Types.instHasPushoutsType in
/-- **`D_QCoh(𝒪_X)` is compactly generated by one object** for a quasi-compact and
quasi-separated algebraic space `X`: there is a compact object `G` of `D_QCoh(𝒪_X)` such that an
object `E` with `Hom(G[n], E) = 0` for all `n` is zero. This is the compact form of
[Stacks, Tag 09IY]. -/
theorem exists_isCompactObject_isWeakTriangulatedGenerator_of_qcqs (X : AlgebraicSpaces B S hS)
    (hqc : IsQuasiCompactSpace B S hS X.1) (hqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1) :
    ∃ G : QuasicoherentDerivedCategory.{u, u} B S hS X.1 X.2,
      IsCompactObject.{u} G ∧ (ObjectProperty.singleton G).IsWeakTriangulatedGenerator :=
  qcqs_induction_on_self B S hS hZ X hqc hqs
    (fun Z _ => ∀ hZ' : IsAlgebraicSpace B S hS Z,
      ∃ G : QuasicoherentDerivedCategory.{u, u} B S hS Z hZ',
        IsCompactObject.{u} G ∧ (ObjectProperty.singleton G).IsWeakTriangulatedGenerator)
    (fun V hV hZ' => ⟨_, isCompactObject_and_isWeakTriangulatedGenerator_unitQuasicoherent
      (hX := hZ') hV⟩)
    (fun _ _ _ _ _ hsq _ hWqs hUqc hVa hPU _ _ _ => by
      obtain ⟨G, hGc, hG⟩ := hPU hsq.isOpenSubspace.1
      exact exists_compact_generator_of_eds hZ hsq hVa hUqc hWqs G hGc hG)
    X.2

variable {B S hS}

/-- **Stacks Project, Tag 0E55, with the adjoint exhibited as exact.** Let `f : X ⟶ Y` be a
morphism of quasi-compact and quasi-separated algebraic spaces over `S`. Then
`Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)` has a right adjoint `a : D_QCoh(𝒪_Y) ⥤ D_QCoh(𝒪_X)`, and `a`
carries a shift structure for which the adjunction `Rf_* ⊣ a` is triangulated. Here `Rf_*` is
the canonical `AlgebraicGeometry.Space.quasicoherentDerivedPushforward`, `f` being quasi-compact
because `X` is quasi-compact and `Y` quasi-separated, and quasi-separated because `X` is. -/
theorem exists_isTriangulated_rightAdjoint_quasicoherentDerivedPushforward
    {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y) (hXqc : IsQuasiCompactSpace B S hS X.1)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1) :
    ∃ (a : QuasicoherentDerivedCategory.{u, u} B S hS Y.1 Y.2 ⥤
        QuasicoherentDerivedCategory.{u, u} B S hS X.1 X.2)
      (adj : quasicoherentDerivedPushforward B S hS f
        (isQuasiCompact_of_isQuasiCompactSpace B S hS hZ Y.2 hYqs hXqc f.hom)
        (isQuasiSeparated_of_isAbsolutelyQuasiSeparated_source B S hS hZ X.2 hXqs f.hom) ⊣ a)
      (_ : a.CommShift ℤ), adj.IsTriangulated := by
  obtain ⟨G, hGc, hG⟩ := exists_isCompactObject_isWeakTriangulatedGenerator_of_qcqs B S hS hZ X
    hXqc hXqs
  have := isGrothendieckAbelian_modules_ringUniverse B S hS X.1 X.2
  have := isGrothendieckAbelian_modules_ringUniverse B S hS Y.1 Y.2
  have := enoughInjectives_modules_ringUniverse B S hS X.1 X.2
  have := enoughInjectives_modules_ringUniverse B S hS Y.1 Y.2
  have := hasCoproducts_quasicoherentDerivedCategory_ringUniverse B S hS X.1 X.2
  have := fun J : Type u => preservesCoproducts_quasicoherentDerivedPushforward B S hS f
    (isQuasiCompact_of_isQuasiCompactSpace B S hS hZ Y.2 hYqs hXqc f.hom)
    (isQuasiSeparated_of_isAbsolutelyQuasiSeparated_source B S hS hZ X.2 hXqs f.hom) J
  have := hGc
  exact exists_isTriangulated_rightAdjoint_of_compact_generator _ G hG

/-- **Stacks Project, Tag 0E55.** Let `f : X ⟶ Y` be a morphism of quasi-compact and
quasi-separated algebraic spaces over `S`. Then `Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)` has a right
adjoint. -/
theorem isLeftAdjoint_quasicoherentDerivedPushforward {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (hXqc : IsQuasiCompactSpace B S hS X.1) (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1) :
    (quasicoherentDerivedPushforward B S hS f
      (isQuasiCompact_of_isQuasiCompactSpace B S hS hZ Y.2 hYqs hXqc f.hom)
      (isQuasiSeparated_of_isAbsolutelyQuasiSeparated_source B S hS hZ X.2 hXqs
        f.hom)).IsLeftAdjoint :=
  let ⟨_, adj, _, _⟩ :=
    exists_isTriangulated_rightAdjoint_quasicoherentDerivedPushforward hZ f hXqc hXqs hYqs
  adj.isLeftAdjoint

end AlgebraicGeometry.Space

end
