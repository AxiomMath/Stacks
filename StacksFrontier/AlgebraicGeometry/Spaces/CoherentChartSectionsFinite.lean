* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public section

open CategoryTheory Opposite TensorProduct

universe u m

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hF : IsAlgebraicSpace B S hS F)

/-! ### Faithful flatness along a finite affine covering family of charts -/

/-- **The product of the rings of regular functions on the members of a finite étale covering
family of an affine chart by affine charts is faithfully flat over the ring of the chart.**

No member of an étale covering family is surjective by itself, so no single ring of functions is
faithfully flat over the base; the product is, and it is the product that descent along the
family runs through. -/
theorem faithfullyFlat_pi_chartRing {A : SmallEtale B S hS F} (hA : IsAffine (chartScheme A))
    {ι : Type*} [Finite ι] {z : ι → SmallEtale B S hS F} (φ : ∀ i, z i ⟶ A)
    (hz : ∀ i, IsAffine (chartScheme (z i)))
    (hcov : Presieve.ofArrows (fun i ↦ chartScheme (z i))
        (fun i ↦ (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map (φ i))) ∈
      Scheme.etalePrecoverage (chartScheme A)) :
    letI : ∀ i, Algebra (chartRing B S hS F hF A) (chartRing B S hS F hF (z i)) := fun i ↦
      chartAlgebra (hF := hF) (φ i)
    Module.FaithfullyFlat (chartRing B S hS F hF A)
      (∀ i, chartRing B S hS F hF (z i)) := by
  let _ : ∀ i, Algebra Γ(chartScheme A, ⊤) Γ(chartScheme (z i), ⊤) := fun i ↦
    chartAlgebra (hF := hF) (φ i)
  have _ : IsAffine (chartScheme A) := hA
  have _ : ∀ i, IsAffine (chartScheme (z i)) := hz
  exact AlgebraicGeometry.faithfullyFlat_pi_gamma_of_ofArrows_mem_fppfPrecoverage
    (fun i ↦ (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map (φ i)))
    (Scheme.etalePrecoverage_le_fppfPrecoverage _ hcov) fun _ ↦ rfl

/-! ### Descent of membership in a submodule of the sections -/

/-- Over a chart on which the base change comparison is bijective, a section whose restriction
lies in the span of the restrictions of a submodule `N` of the sections has vanishing class in
the base change of the quotient by `N`.

Injectivity of the comparison carries the span back to `Submodule.baseChange` of `N`, which the
projection to the quotient kills. -/
private theorem one_tmul_mkQ_eq_zero_of_restrict_mem_span {M : Modules.{u, m} B S hS F hF}
    {A z : SmallEtale B S hS F} (φ : z ⟶ A)
    (hbij : Function.Bijective (sectionsBaseChange M φ))
    (N : Submodule (chartRing B S hS F hF A) (M.val.obj (op A)))
    (t : M.val.obj (op A))
    (ht : chartRestrictLinear M φ t ∈ Submodule.span (chartRing B S hS F hF z)
      (chartRestrictLinear M φ '' (N : Set (M.val.obj (op A))))) :
    letI := chartAlgebra (hF := hF) φ
    (1 : chartRing B S hS F hF z) ⊗ₜ[chartRing B S hS F hF A] (N.mkQ t) = 0 := by
  let _ := chartAlgebra (hF := hF) φ
  let _ := chartSectionsModule M φ
  have _ := chartSections_isScalarTower M φ
  have hmap : Submodule.map (sectionsBaseChange M φ)
      (N.baseChange (chartRing B S hS F hF z)) =
      Submodule.span (chartRing B S hS F hF z)
        (chartRestrictLinear M φ '' (N : Set (M.val.obj (op A)))) := by
    rw [Submodule.baseChange_eq_span, Submodule.map_span, Submodule.map_coe, Set.image_image]
    exact congrArg _ (Set.image_congr' fun n ↦ chartBaseChange_one_tmul M φ n)
  have h1 : (1 : chartRing B S hS F hF z) ⊗ₜ[chartRing B S hS F hF A] t ∈
      N.baseChange (chartRing B S hS F hF z) := by
    have hmem : sectionsBaseChange M φ
        ((1 : chartRing B S hS F hF z) ⊗ₜ[chartRing B S hS F hF A] t) ∈
        Submodule.map (sectionsBaseChange M φ) (N.baseChange (chartRing B S hS F hF z)) := by
      rwa [hmap, chartBaseChange_one_tmul M φ t]
    obtain ⟨y, hy, hyeq⟩ := hmem
    exact (hbij.1 hyeq) ▸ hy
  have hker : N.baseChange (chartRing B S hS F hF z) ≤
      LinearMap.ker (LinearMap.baseChange (chartRing B S hS F hF z) N.mkQ) := by
    rw [Submodule.baseChange_eq_span, Submodule.span_le]
    intro x hx
    obtain ⟨n, hn, rfl⟩ := hx
    have hn0 : N.mkQ n = 0 := (Submodule.Quotient.mk_eq_zero N).2 hn
    show LinearMap.baseChange (chartRing B S hS F hF z) N.mkQ
      ((1 : chartRing B S hS F hF z) ⊗ₜ[chartRing B S hS F hF A] n) = 0
    rw [LinearMap.baseChange_tmul, hn0, TensorProduct.tmul_zero]
  have h2 := hker h1
  rwa [LinearMap.mem_ker, LinearMap.baseChange_tmul] at h2

/-- **Descent of membership in a submodule of the sections over an affine chart.**  Let `M` be an
`𝒪_F`-module cartesian on affine charts, let `A` be an étale chart with affine underlying scheme
and let `N` be a submodule of the sections of `M` over `A`.  A section over `A` whose restriction
to every affine chart in some covering sieve of `A` lies in the span of the restrictions of `N`
already lies in `N`.

Quasi-compactness of the affine chart cuts the covering sieve down to a finite family of affine
charts, and the product of their rings of functions is faithfully flat over the ring of `A`. -/
theorem mem_of_locally_mem_span_restrict {M : Modules.{u, m} B S hS F hF}
    (hMcart : IsCartesianOnAffineCharts M)
    {A : SmallEtale B S hS F} (hA : IsAffine (chartScheme A))
    (N : Submodule (chartRing B S hS F hF A) (M.val.obj (op A))) (t : M.val.obj (op A))
    {Sv : Sieve A} (hSv : Sv ∈ SmallEtale.topology B S hS F A)
    (hloc : ∀ (w : SmallEtale B S hS F) (ρ : w ⟶ A), IsAffine (chartScheme w) → Sv ρ →
      chartRestrictLinear M ρ t ∈ Submodule.span (chartRing B S hS F hF w)
        (chartRestrictLinear M ρ '' (N : Set (M.val.obj (op A))))) :
    t ∈ N := by
  classical
  obtain ⟨n, z, φ, hzaff, hzS, -, hzet⟩ :=
    SmallEtale.exists_finite_affine_etale_ofArrows_le B S hS F hA hSv
  let _ : ∀ i, Algebra (chartRing B S hS F hF A) (chartRing B S hS F hF (z i)) := fun i ↦
    chartAlgebra (hF := hF) (φ i)
  have hff : Module.FaithfullyFlat (chartRing B S hS F hF A)
      (∀ i, chartRing B S hS F hF (z i)) :=
    faithfullyFlat_pi_chartRing B S hS F hF hA φ hzaff hzet
  have hz1 : ∀ i, (1 : chartRing B S hS F hF (z i)) ⊗ₜ[chartRing B S hS F hF A] (N.mkQ t) = 0 :=
    fun i ↦ one_tmul_mkQ_eq_zero_of_restrict_mem_span B S hS F hF (φ i)
      (hMcart A (z i) hA (hzaff i) (φ i)) N t (hloc (z i) (φ i) (hzaff i) (hzS i))
  have hsingle : ∀ i, (Pi.single i (1 : chartRing B S hS F hF (z i)) :
      ∀ j, chartRing B S hS F hF (z j)) ⊗ₜ[chartRing B S hS F hF A] (N.mkQ t) = 0 := by
    intro i
    have h : (LinearMap.rTensor (M.val.obj (op A) ⧸ N)
        (LinearMap.single (chartRing B S hS F hF A)
          (fun j ↦ chartRing B S hS F hF (z j)) i))
        ((1 : chartRing B S hS F hF (z i)) ⊗ₜ[chartRing B S hS F hF A] (N.mkQ t)) = 0 := by
      rw [hz1 i, map_zero]
    rwa [LinearMap.rTensor_tmul, LinearMap.single_apply] at h
  have hone : (1 : ∀ i, chartRing B S hS F hF (z i)) ⊗ₜ[chartRing B S hS F hF A]
      (N.mkQ t) = 0 := by
    have h1 : (1 : ∀ i, chartRing B S hS F hF (z i)) =
        ∑ i, Pi.single i (1 : chartRing B S hS F hF (z i)) := by
      simpa using (Finset.univ_sum_single (1 : ∀ i, chartRing B S hS F hF (z i))).symm
    rw [h1, TensorProduct.sum_tmul]
    exact Finset.sum_eq_zero fun i _ ↦ hsingle i
  exact (Submodule.Quotient.mk_eq_zero N).1
    ((Module.FaithfullyFlat.one_tmul_eq_zero_iff (A := ∀ i, chartRing B S hS F hF (z i))
      (chartRing B S hS F hF A) _ (N.mkQ t)).1 hone)

/-! ### Finiteness of the sections -/

/-- **Finitely many sections generating a module on an algebraic space over an affine chart span
its sections over that chart.**  In particular the sections over the chart form a finite module
over the ring of the chart.

Generation is a local condition; the passage to the chart itself is
`AlgebraicGeometry.Space.mem_of_locally_mem_span_restrict`. -/
theorem moduleFinite_sections_of_generates {M : Modules.{u, m} B S hS F hF}
    (hMcart : IsCartesianOnAffineCharts M)
    {A : SmallEtale B S hS F} (hA : IsAffine (chartScheme A))
    {n : ℕ} {s : Fin n → M.val.obj (op A)}
    (hs : PresheafOfModules.Generates (smallEtaleRingedSite B S hS F hF).J M.val s) :
    Module.Finite (chartRing B S hS F hF A) (M.val.obj (op A)) := by
  classical
  have htop : Submodule.span (chartRing B S hS F hF A) (Set.range s) = ⊤ := by
    refine Submodule.eq_top_iff'.2 fun t ↦ ?_
    obtain ⟨Sv, hSvmem, hgen⟩ := hs A (𝟙 A) t
    refine mem_of_locally_mem_span_restrict B S hS F hF hMcart hA _ t hSvmem ?_
    intro w ρ _ hρ
    obtain ⟨a, ha⟩ := hgen w ρ hρ
    have ha' : ∑ i, a i • chartRestrictLinear M (ρ ≫ 𝟙 A) (s i) =
        chartRestrictLinear M ρ t := ha
    have hid : ∀ i, chartRestrictLinear M (ρ ≫ 𝟙 A) (s i) = chartRestrictLinear M ρ (s i) :=
      fun i ↦ congrArg (fun ψ ↦ chartRestrictLinear M ψ (s i)) (Category.comp_id ρ)
    rw [← ha']
    refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ ?_
    rw [hid i]
    exact Submodule.subset_span ⟨s i, Submodule.subset_span ⟨i, rfl⟩, rfl⟩
  refine ⟨⟨Finset.univ.image s, ?_⟩⟩
  rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ]

/-- **The sections of a module of finite type over an affine chart of an algebraic space form a
finite module over the ring of the chart**, provided the module is cartesian on affine charts.

Finite type gives a covering family of charts carrying finitely many generators; the affine
charts of a finite covering family of the given chart which factor through such a member have
finite sections by `AlgebraicGeometry.Space.moduleFinite_sections_of_generates`, finitely many
sections over the chart already generate there by the base change property, and
`AlgebraicGeometry.Space.mem_of_locally_mem_span_restrict` brings them down to the chart. -/
theorem moduleFinite_sections_of_isFiniteType {M : Modules.{u, m} B S hS F hF}
    (hMcart : IsCartesianOnAffineCharts M)
    (hMft : PresheafOfModules.IsFiniteType (smallEtaleRingedSite B S hS F hF).J M.val)
    {V : SmallEtale B S hS F} (hV : IsAffine (chartScheme V)) :
    Module.Finite (chartRing B S hS F hF V) (M.val.obj (op V)) := by
  classical
  obtain ⟨I, U, hU, hgen⟩ := hMft.exists_generators
  obtain ⟨c, z, φ, hzaff, hzS, hzcov, -⟩ :=
    SmallEtale.exists_finite_affine_etale_ofArrows_le B S hS F hV (hU V)
  have hzfin : ∀ j, Module.Finite (chartRing B S hS F hF (z j)) (M.val.obj (op (z j))) := by
    intro j
    obtain ⟨i, ⟨g⟩⟩ := (Sieve.mem_ofObjects_iff U (φ j)).1 (hzS j)
    obtain ⟨k, s, hs⟩ := hgen i
    exact moduleFinite_sections_of_generates B S hS F hF hMcart (hzaff j) (hs.restrict g)
  -- finitely many sections over `V` whose restrictions span the sections over each `z j`
  have hTj : ∀ j, ∃ T : Finset (M.val.obj (op V)),
      Submodule.span (chartRing B S hS F hF (z j))
        (chartRestrictLinear M (φ j) '' (T : Set (M.val.obj (op V)))) = ⊤ := by
    intro j
    let _ := chartAlgebra (hF := hF) (φ j)
    let _ := chartSectionsModule M (φ j)
    have _ := chartSections_isScalarTower M (φ j)
    have _ := hzfin j
    obtain ⟨k, w, hw⟩ := Module.Finite.exists_fin (R := chartRing B S hS F hF (z j))
      (M := M.val.obj (op (z j)))
    choose ξ hξ using fun l : Fin k ↦ (hMcart V (z j) hV (hzaff j) (φ j)).2 (w l)
    choose d b y hy using fun l : Fin k ↦ TensorProduct.exists_sum_tmul_eq (ξ l)
    refine ⟨Finset.univ.biUnion fun l : Fin k ↦ Finset.univ.image (y l), top_unique ?_⟩
    rw [← hw, Submodule.span_le]
    rintro x ⟨l, rfl⟩
    have hwl : w l = ∑ p, b l p • chartRestrictLinear M (φ j) (y l p) := by
      rw [← hξ l, hy l, map_sum]
      exact Finset.sum_congr rfl fun p _ ↦ chartBaseChange_tmul M (φ j) (b l p) (y l p)
    rw [SetLike.mem_coe, hwl]
    refine Submodule.sum_mem _ fun p _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ?_)
    exact ⟨y l p, Finset.mem_coe.2 (Finset.mem_biUnion.2
      ⟨l, Finset.mem_univ l, Finset.mem_image_of_mem _ (Finset.mem_univ p)⟩), rfl⟩
  choose T hT using hTj
  have htop : Submodule.span (chartRing B S hS F hF V)
      ((Finset.univ.biUnion T : Finset (M.val.obj (op V))) : Set (M.val.obj (op V))) = ⊤ := by
    refine Submodule.eq_top_iff'.2 fun t ↦ ?_
    refine mem_of_locally_mem_span_restrict B S hS F hF hMcart hV _ t hzcov ?_
    intro w ρ _ hρ
    rw [Sieve.mem_ofArrows_iff] at hρ
    obtain ⟨j, a, rfl⟩ := hρ
    set P : Submodule (chartRing B S hS F hF w) (M.val.obj (op w)) :=
      Submodule.span (chartRing B S hS F hF w)
        (chartRestrictLinear M (a ≫ φ j) '' (Submodule.span (chartRing B S hS F hF V)
          ((Finset.univ.biUnion T : Finset (M.val.obj (op V))) :
            Set (M.val.obj (op V))) : Set (M.val.obj (op V)))) with hP
    -- the sections over `z j` whose restriction to `w` lies in `P` form a submodule
    let W : Submodule (chartRing B S hS F hF (z j)) (M.val.obj (op (z j))) :=
      { carrier := {x | chartRestrictLinear M a x ∈ P}
        zero_mem' := by simpa only [Set.mem_ofPred_eq, map_zero] using P.zero_mem
        add_mem' := fun {x y} hx hy => by
          simpa only [Set.mem_ofPred_eq, map_add] using P.add_mem hx hy
        smul_mem' := fun r x hx => by
          simp only [Set.mem_ofPred_eq, chartRestrictLinear_smul]
          exact P.smul_mem _ hx }
    have hW : Submodule.span (chartRing B S hS F hF (z j))
        (chartRestrictLinear M (φ j) '' (T j : Set (M.val.obj (op V)))) ≤ W := by
      rw [Submodule.span_le]
      rintro x ⟨nn, hnn, rfl⟩
      show chartRestrictLinear M a (chartRestrictLinear M (φ j) nn) ∈ P
      rw [← chartRestrictLinear_comp, hP]
      refine Submodule.subset_span ⟨nn, Submodule.subset_span ?_, rfl⟩
      exact Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨j, Finset.mem_univ j, Finset.mem_coe.1 hnn⟩)
    rw [chartRestrictLinear_comp]
    exact hW (Submodule.eq_top_iff'.1 (hT j) _)
  exact ⟨⟨Finset.univ.biUnion T, htop⟩⟩

/-- **The sections of a coherent module over an affine chart of an algebraic space form a finite
module over the ring of the chart.**

This is the space-side analogue of `AlgebraicGeometry.moduleFinite_sections`, and it is proved
the same way: coherence gives quasi-coherence together with finite type, quasi-coherence gives
the base change property of the sections over an affine chart, and finite type together with
quasi-compactness of the chart gives finitely many generators there. -/
theorem moduleFinite_sections_of_isCoherent (M : Modules.{u, u} B S hS F hF)
    (hM : IsCoherent B S hS F hF M)
    {V : SmallEtale B S hS F} (hV : IsAffine (chartScheme V)) :
    Module.Finite (chartRing B S hS F hF V) (M.val.obj (op V)) :=
  moduleFinite_sections_of_isFiniteType B S hS F hF
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF M
      hM.toIsQuasicoherentOnSite)
    hM.toIsCoherentOnSite.isFiniteType hV

/-- **The sections of a coherent module over a Noetherian affine chart of an algebraic space form
a finite module over the ring of the chart.**

Noetherianity of the ring of the chart plays no part; it is carried because this is the shape in
which the Artin–Rees argument on an algebraic space consumes the statement. -/
theorem moduleFinite_sections_of_isNoetherianAffineChart (M : Modules.{u, u} B S hS F hF)
    (hM : IsCoherent B S hS F hF M)
    {V : SmallEtale B S hS F} (hV : IsNoetherianAffineChart B S hS F V) :
    Module.Finite (chartRing B S hS F hF V) (M.val.obj (op V)) :=
  moduleFinite_sections_of_isCoherent B S hS F hF M hM hV.1

end AlgebraicGeometry.Space

end
