-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct

universe v u

/-- **Faithfully flat descent for a pair of nested ideals.**  If two ideals of a commutative ring,
one contained in the other, generate the same ideal in each member of a finite family of algebras
whose product is faithfully flat over the ring, they are equal.

Only faithful flatness of the product is used: the larger ideal is pushed into the quotient by
the smaller one, where a representative of a class becomes `1 ⊗ₜ -` and the hypothesis makes it
vanish in each factor of the product. -/
theorem Ideal.eq_of_le_of_forall_map_le {C : Type u} [CommRing C] {ι : Type v} [Finite ι]
    {D : ι → Type u} [∀ i, CommRing (D i)] [∀ i, Algebra C (D i)]
    [Module.FaithfullyFlat C (∀ i, D i)] {N₁ N₂ : Ideal C} (hle : N₁ ≤ N₂)
    (h : ∀ i, N₂.map (algebraMap C (D i)) ≤ N₁.map (algebraMap C (D i))) :
    N₁ = N₂ := by
  classical
  have _ := Fintype.ofFinite ι
  refine le_antisymm hle fun x hx => ?_
  -- Every class is the image of the class of `1` under the scalar it comes from.
  have htm : ∀ (i : ι) (a : C), (1 : D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ a) =
      algebraMap C (D i) a • ((1 : D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ 1)) := by
    intro i a
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, Algebra.algebraMap_eq_smul_one,
      TensorProduct.smul_tmul]
    congr 1
    rw [map_one, ← Algebra.algebraMap_eq_smul_one, Ideal.Quotient.algebraMap_eq]
  -- In each factor the class of `x` vanishes, because `x` generates there an element of `N₁`.
  have hfac : ∀ i, (1 : D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ x) = 0 := by
    intro i
    have hker : N₁.map (algebraMap C (D i)) ≤
        (Submodule.span (D i) {(1 : D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ 1)}).annihilator := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, Submodule.mem_annihilator_span_singleton, ← htm i a,
        Ideal.Quotient.eq_zero_iff_mem.2 ha, TensorProduct.tmul_zero]
    rw [htm i x, ← Submodule.mem_annihilator_span_singleton]
    exact hker (h i (Ideal.mem_map_of_mem _ hx))
  -- The unit of the product is the sum of the units of the factors.
  have key : (1 : ∀ i, D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ x) = 0 := by
    have h1 : (1 : ∀ i, D i) = ∑ i, Pi.single i (1 : D i) := by
      rw [← Finset.univ_sum_single (1 : ∀ i, D i)]
      rfl
    rw [h1, TensorProduct.sum_tmul]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hsing : Pi.single i (1 : D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ x) =
        LinearMap.rTensor (C ⧸ N₁) (LinearMap.single C D i)
          ((1 : D i) ⊗ₜ[C] (Ideal.Quotient.mk N₁ x)) := by
      rw [LinearMap.rTensor_tmul]
      rfl
    rw [hsing, hfac i, map_zero]
  exact Ideal.Quotient.eq_zero_iff_mem.1
    ((Module.FaithfullyFlat.one_tmul_eq_zero_iff (R := C) (A := ∀ i, D i) (M := C ⧸ N₁) _).1 key)

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (X : AlgebraicSpaces B S hS)

section Ideal

variable (N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)

/-- **The converse of `AlgebraicGeometry.Space.chartIdeal_map_of_surjective_sectionsBaseChange`.**
If the ideal of sections of a sheaf of ideals of `𝒪_X` over the smaller of two étale charts is
generated by the restrictions of the sections over the larger one, the base change comparison is
surjective.

No affineness is needed: a section over the smaller chart which is a combination of restricted
sections is, term by term, the image of the corresponding element of the tensor product. -/
theorem surjective_sectionsBaseChange_of_chartIdeal_le_map
    {A A' : SmallEtale B S hS X.1} (m : A' ⟶ A)
    (h : chartIdeal B S hS X N A' ≤
      Ideal.map (chartRestrict (hF := X.2) m) (chartIdeal B S hS X N A)) :
    Function.Surjective (sectionsBaseChange N.toSheafOfModules m) := by
  let _ := chartAlgebra (hF := X.2) m
  have key : ∀ w : chartRing B S hS X.1 X.2 A',
      w ∈ Ideal.map (chartRestrict (hF := X.2) m) (chartIdeal B S hS X N A) →
      ∃ z, (sectionsBaseChange N.toSheafOfModules m z).1 = w := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
        obtain ⟨x, hx, rfl⟩ := hw
        refine ⟨(1 : chartRing B S hS X.1 X.2 A') ⊗ₜ ⟨x, hx⟩, ?_⟩
        show (1 : chartRing B S hS X.1 X.2 A') * chartRestrict (hF := X.2) m x = _
        rw [one_mul]
    | zero => exact ⟨0, by rw [map_zero]; rfl⟩
    | add a b _ _ ha hb =>
        obtain ⟨za, hza⟩ := ha
        obtain ⟨zb, hzb⟩ := hb
        refine ⟨za + zb, ?_⟩
        rw [map_add]
        exact congrArg₂ (· + ·) hza hzb
    | smul c a _ ha =>
        obtain ⟨za, hza⟩ := ha
        refine ⟨c • za, ?_⟩
        rw [map_smul]
        exact congrArg (fun t : chartRing B S hS X.1 X.2 A' => c • t) hza
  intro y
  obtain ⟨z, hz⟩ := key _ (h y.2)
  exact ⟨z, Subtype.ext hz⟩

/-- **Where the sections of a sheaf of ideals over a chart base change, they generate.**  If the
comparison of `AlgebraicGeometry.Space.SmallEtale.HasSectionBaseChangeOn` is available at an
object `W` of the slice at an étale chart `U`, then the ideal of sections over the chart
underlying `W` is generated by the restrictions of the sections over `U`.

The span condition this unwinds is for the universe lift of the restricted module; the lift
changes neither the ring nor the restriction maps, so the span statement descends term by term. -/
theorem chartIdeal_le_map_of_hasSectionBaseChangeOn
    {U : (smallEtaleRingedSite B S hS X.1 X.2).C} {Q : Over U → Prop}
    (hbc : SmallEtale.HasSectionBaseChangeOn B S hS X.1 X.2
      (SheafOfModules.uliftForPresentation.{u + 1, u, u, u, u + 1}
        (N.toSheafOfModules.over U)) Q)
    (W : Over U) (hQ : Q W) :
    chartIdeal B S hS X N W.left ≤
      Ideal.map (chartRestrict (hF := X.2) W.hom) (chartIdeal B S hS X N U) := by
  have hspan := SmallEtale.globalSectionSpan_eq_top_of_hasSectionBaseChangeOn
    B S hS X.1 X.2 hbc W hQ
  rw [SheafOfModules.globalSectionSpan_eq_span_range] at hspan
  have hspan' := Submodule.eq_top_iff'.1 hspan
  intro y hy
  refine Submodule.span_induction
    (p := fun z _ => (ULift.down z).1 ∈
      Ideal.map (chartRestrict (hF := X.2) W.hom) (chartIdeal B S hS X N U))
    ?_ ?_ ?_ ?_ (hspan' (ULift.up ⟨y, hy⟩))
  · rintro z ⟨x, rfl⟩
    rw [Over.mkIdTerminal.hom_ext ((Over.mkIdTerminal (X := U)).from W)
      (Over.homMk W.hom (by simp))]
    exact Ideal.mem_map_of_mem _ x.down.2
  · exact Ideal.zero_mem _
  · exact fun a b _ _ ha hb => Ideal.add_mem _ ha hb
  · exact fun c a _ ha => Ideal.mul_mem_left _ _ ha

/-- **A quasi-coherent sheaf of ideals of `𝒪_X` is cartesian on affine charts: the surjectivity
half.**  For a morphism of affine étale charts the ideal of sections over the smaller chart is
generated by the restrictions of the sections over the larger one.

Quasi-coherence supplies a covering family of the larger chart over whose affine members the
sections do base change, and that family is refined by a finite affine one which is flat and
jointly surjective in schemes.  Over each member of the refinement the two ideals in question —
the one generated by the sections over the larger chart and the ideal of sections over the
smaller one — therefore agree, and the product of the rings of the refinement is faithfully flat
over the ring of the smaller chart, so `Ideal.eq_of_le_of_forall_map_le` identifies them. -/
theorem surjective_sectionsBaseChange_submodule_unit_of_isQuasicoherentOnSite
    (hN : N.toSheafOfModules.IsQuasicoherentOnSite) {U V : SmallEtale B S hS X.1}
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U))
    (hV : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj V))
    (f : V ⟶ U) :
    Function.Surjective (sectionsBaseChange N.toSheafOfModules f) := by
  classical
  obtain ⟨k, Y, g, hcov, hbc⟩ :=
    SmallEtale.exists_hasSectionBaseChangeOn_of_isQuasicoherentOnSite B S hS X.1 X.2
      N.toSheafOfModules hN U hU
  -- Refine the pulled-back covering sieve of `Over.mk f` by a finite affine flat family.
  obtain ⟨n, Z, a, hZaff, hZmem, -, hfppf⟩ :=
    SmallEtale.exists_finite_affine_etale_ofArrows_le_over B S hS X.1 f hV
      (Sieve.pullback ((Over.mkIdTerminal (X := U)).from (Over.mk f)) (Sieve.ofArrows Y g))
      (((SmallEtale.topology B S hS X.1).over U).pullback_stable _ hcov)
  -- Each member of the refinement lies over a member of the given family.
  have hQ : ∀ i, IsAffine ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS X.1).obj (Z i).left)) ∧ ∃ j, Nonempty (Z i ⟶ Y j) := by
    intro i
    obtain ⟨j, e, -⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 (hZmem i)
    exact ⟨hZaff i, j, ⟨e⟩⟩
  -- The two ideals of `𝒪_X(V)` under comparison.
  have hmap : ∀ {A A' : SmallEtale B S hS X.1} (g : A' ⟶ A),
      Ideal.map (chartRestrict (hF := X.2) g) (chartIdeal B S hS X N A) ≤
        chartIdeal B S hS X N A' :=
    fun g => Ideal.map_le_iff_le_comap.2 fun _ hx => N.map_mem g.op hx
  have hfac : ∀ i, (Z i).hom = (a i).left ≫ f := fun i => (Over.w (a i)).symm
  have hstep : ∀ i, Ideal.map (chartRestrict (hF := X.2) ((a i).left))
        (chartIdeal B S hS X N V) ≤
      Ideal.map (chartRestrict (hF := X.2) ((a i).left))
        (Ideal.map (chartRestrict (hF := X.2) f) (chartIdeal B S hS X N U)) := by
    intro i
    rw [Ideal.map_map, ← chartRestrict_comp, ← hfac i]
    exact (hmap (a i).left).trans
      (chartIdeal_le_map_of_hasSectionBaseChangeOn B S hS X N hbc (Z i) (hQ i))
  -- Faithful flatness of the product of the rings of the refinement.
  let _ : ∀ i, Algebra Γ((BigFppfOver.toScheme B S hS).obj
      ((SmallEtale.toOver B S hS X.1).obj (Over.mk f).left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj
        ((SmallEtale.toOver B S hS X.1).obj (Z i).left), ⊤) := fun i =>
    ((BigFppfOver.toScheme B S hS).map
      ((SmallEtale.toOver B S hS X.1).map (a i).left)).appTop.hom.toAlgebra
  have hffΓ := SmallEtale.faithfullyFlat_pi_gamma_of_ofArrows_mem_fppfPrecoverage
    B S hS X.1 Z a hV hZaff hfppf fun _ => rfl
  let _ : ∀ i, Algebra (chartRing B S hS X.1 X.2 V)
      (chartRing B S hS X.1 X.2 (Z i).left) := fun i =>
    (chartRestrict (hF := X.2) ((a i).left)).toAlgebra
  have _ : Module.FaithfullyFlat (chartRing B S hS X.1 X.2 V)
      (∀ i, chartRing B S hS X.1 X.2 (Z i).left) := hffΓ
  exact surjective_sectionsBaseChange_of_chartIdeal_le_map B S hS X N f
    (Ideal.eq_of_le_of_forall_map_le (hmap f) hstep).ge

/-- **A quasi-coherent sheaf of ideals of `𝒪_X` is cartesian on affine charts**, unconditionally:
this is the forward implication of Descent, Proposition 03DX(2) for a sheaf submodule of the
structure sheaf.

Both halves are now unconditional: injectivity of the base change comparison is
`AlgebraicGeometry.Space.injective_sectionsBaseChange_submodule_unit`, which uses only the
inclusion into `𝒪_X` and flatness of the restriction maps, and surjectivity is
`AlgebraicGeometry.Space.surjective_sectionsBaseChange_submodule_unit_of_isQuasicoherentOnSite`.

For a general `𝒪_X`-module the implication is not obtained this way: the descent step of the
surjectivity half compares two *ideals* of the ring of functions on the smaller chart, and for a
module the corresponding comparison asks for the sections there to be a base change, which is
what was to be proved. -/
theorem isCartesianOnAffineCharts_submodule_unit_of_isQuasicoherentOnSite
    (hN : N.toSheafOfModules.IsQuasicoherentOnSite) :
    IsCartesianOnAffineCharts N.toSheafOfModules :=
  isCartesianOnAffineCharts_submodule_unit_of_surjective B S hS X N fun _ _ hU hV f =>
    surjective_sectionsBaseChange_submodule_unit_of_isQuasicoherentOnSite B S hS X N hN hU hV f

/-- **Stacks 03MB, surjectivity: a quasi-coherent sheaf of ideals of `𝒪_X` is the defining ideal
sheaf of a closed subspace of `X`.**

The sheaf of ideals is cartesian on affine charts, so
`AlgebraicGeometry.Space.exists_definingIdealSheaf_eq_of_isCartesianOnAffineCharts` descends it
to an invariant closed subscheme of an étale atlas and glues that to a closed subspace. -/
theorem exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite
    (hN : N.toSheafOfModules.IsQuasicoherentOnSite) :
    ∃ Z : ClosedSubspaces B S hS X.1, definingIdealSheaf B S hS X Z = N :=
  exists_definingIdealSheaf_eq_of_isCartesianOnAffineCharts B S hS X N
    (isCartesianOnAffineCharts_submodule_unit_of_isQuasicoherentOnSite B S hS X N hN)

end Ideal

/-- **Stacks 03MB, the inclusion-reversing bijection.**  Sending a closed subspace of an algebraic
space `X` to the kernel of the structure map of its inclusion is a bijection from the closed
subspaces of `X` onto the quasi-coherent sheaves of ideals of `𝒪_X`. -/
theorem toDual_definingIdealSheaf_bijective' :
    Function.Bijective (fun Z : ClosedSubspaces B S hS X.1 =>
      OrderDual.toDual (α := QuasicoherentIdeals B S hS X)
        ⟨definingIdealSheaf B S hS X Z, isQuasicoherentOnSite_definingIdealSheaf B S hS X Z⟩) :=
  toDual_definingIdealSheaf_bijective B S hS X
    (isQuasicoherentOnSite_definingIdealSheaf B S hS X)
    fun I hI => exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS X I hI

/-- **The correspondence of Stacks 03MB, as an order isomorphism.** The closed subspaces of an
algebraic space `X` are order-isomorphic to the order dual of the quasi-coherent sheaves of ideals
of `𝒪_X`, by the isomorphism sending a closed subspace to the kernel of the structure map of its
inclusion on every étale chart.

This is `AlgebraicGeometry.Space.closedSubspaceIdealOrderIso` with both of its hypotheses
discharged: a defining ideal sheaf is quasi-coherent by
`AlgebraicGeometry.Space.isQuasicoherentOnSite_definingIdealSheaf`, and every quasi-coherent
sheaf of ideals is a defining ideal sheaf by
`AlgebraicGeometry.Space.exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite`. -/
noncomputable def closedSubspaceQuasicoherentIdealOrderIso :
    {e : ClosedSubspaces B S hS X.1 ≃o (QuasicoherentIdeals B S hS X)ᵒᵈ //
      ∀ (Z : ClosedSubspaces B S hS X.1) (U : (SmallEtale B S hS X.1)ᵒᵖ),
        (OrderDual.ofDual (e Z)).1.obj U =
          RingHom.ker (((smallEtaleRingedToposHom B S hS
            (ObjectProperty.homMk Z.1.ι :
              (⟨Z.1.toFunctor, Z.2.1⟩ : AlgebraicSpaces B S hS) ⟶ X)).fSharp.hom.app U).hom)} :=
  closedSubspaceIdealOrderIso B S hS X (isQuasicoherentOnSite_definingIdealSheaf B S hS X)
    fun I hI => exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS X I hI

/-- **A closed subspace with a prescribed quasi-coherent defining ideal, chart by chart.**  Every
quasi-coherent sheaf of ideals of `𝒪_X` is the chartwise defining ideal of a closed subspace. -/
theorem exists_definingIdealAt_eq_of_isQuasicoherentOnSite
    (N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)
    (hN : N.toSheafOfModules.IsQuasicoherentOnSite) :
    ∃ Z : ClosedSubspaces B S hS X.1, ∀ U : (SmallEtale B S hS X.1)ᵒᵖ,
      definingIdealAt B S hS X Z U = N.obj U := by
  obtain ⟨Z, hZ⟩ := exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS X N hN
  exact ⟨Z, fun U => by rw [← definingIdealSheaf_obj B S hS X Z U, hZ]⟩

/-- **The zero scheme of a section is cut out by the evaluation ideal, as soon as that ideal is
quasi-coherent.**  If a quasi-coherent sheaf of ideals of `𝒪_X` has, over every affine étale
chart, the ideal generated by the values of the linear functionals on `L` at the section `s`, then
the zero scheme of `s` is the closed subspace that sheaf of ideals defines.

This is `AlgebraicGeometry.Space.zeroSchemeSubfunctor_eq` with its hypothesis supplied by the
surjectivity half of Stacks 03MB; what it still asks for is the sheaf of ideals itself, not a
closed subspace. -/
theorem exists_zeroSchemeSubfunctor_eq_of_isQuasicoherentOnSite
    (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)
    (N : (SheafOfModules.unit (structureRingSheaf B S hS X)).Submodule)
    (hN : N.toSheafOfModules.IsQuasicoherentOnSite)
    (hmatch : ∀ U : SmallEtale B S hS X.1,
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj U).1 →
      N.obj (op U) = sectionEvaluationIdealAt B S hS X L s U) :
    ∃ Z : ClosedSubspaces B S hS X.1,
      zeroSchemeSubfunctor B S hS X L s = Z.1 ∧ definingIdealSheaf B S hS X Z = N := by
  obtain ⟨Z, hZ⟩ := exists_definingIdealSheaf_eq_of_isQuasicoherentOnSite B S hS X N hN
  refine ⟨Z, zeroSchemeSubfunctor_eq B S hS X L s Z fun U hU => ?_, hZ⟩
  rw [← hmatch U hU, ← definingIdealSheaf_obj B S hS X Z (op U), hZ]

end AlgebraicGeometry.Space
