module

public import StacksFrontier.AlgebraicGeometry.Spaces.ConormalAlgebraChartPresentation
public import StacksFrontier.AlgebraicGeometry.Spaces.ConormalSymmetricAlgebra
public import StacksFrontier.AlgebraicGeometry.Spaces.SliceFreeModuleCriteria
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Quasi-regular generators of the ideal of a closed immersion over an affine chart

Let `k : Z ⟶ X` be a closed immersion of algebraic spaces over a scheme `S` contained in a big
fppf site `B`, with conormal algebra `𝒞_{Z/X,*}` of Stacks 09RN and canonical map
`Φ : Sym^*(𝒞_{Z/X}) ⟶ 𝒞_{Z/X,*}` of Stacks 09RQ, for some symmetric algebra `Sym^*(𝒞_{Z/X})`.
Let `V` be an affine étale chart of `X` and `I = 𝓘(V)` the ideal of `Z` over it, with base-changed
chart `Z_V`.  This file proves the two chart-level halves of Stacks 09RY:

* if `I` is generated by a quasi-regular sequence of length `c`, then `𝒞_{Z/X}` is free of rank
  `c` on the slice at `Z_V` and `Φ` is an isomorphism on that slice in every degree;
* conversely, if `Φ` is an isomorphism in every degree, `I` is generated by a sequence `f` of
  length `c` and the sections of `𝒞_{Z/X}` over `Z_V` are free of rank `c`, then `f` is
  quasi-regular.

## Main results

* `AlgebraicGeometry.Space.nonempty_iso_free_over_conormal_of_isQuasiRegular`: for a
  quasi-regular generating sequence of length `c`, `𝒞_{Z/X}` is free of rank `c` on the slice
  at `Z_V`.
* `AlgebraicGeometry.Space.isIso_over_symmetricAlgebraToConormalAlgebra_of_isQuasiRegular`: for a
  quasi-regular generating sequence, `Φ` is an isomorphism on the slice at `Z_V` in every degree.
* `AlgebraicGeometry.Space.isQuasiRegular_of_isIso_symmetricAlgebraToConormalAlgebra`: the
  converse, a generating sequence is quasi-regular when `Φ` is an isomorphism in every degree and
  the sections of `𝒞_{Z/X}` over `Z_V` are free of the right rank.

## References

* [Stacks Project, Tag 09RY](https://stacks.math.columbia.edu/tag/09RY)
* [Stacks Project, Tag 063M](https://stacks.math.columbia.edu/tag/063M)
* [Stacks Project, Tag 09RQ](https://stacks.math.columbia.edu/tag/09RQ)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

/-- The monomials of a given degree in `c` variables, for the two spellings `Fin c` and
`ULift (Fin c)` of the variables. -/
noncomputable def monomialsULiftEquiv (c n : ℕ) :
    ({d : ULift.{u} (Fin c) →₀ ℕ | d.degree = n} : Type u) ≃
      ({d : Fin c →₀ ℕ | d.degree = n} : Type) :=
  Equiv.subtypeEquiv (p := fun d => d ∈ {d : ULift.{u} (Fin c) →₀ ℕ | d.degree = n})
    (q := fun d => d ∈ {d : Fin c →₀ ℕ | d.degree = n})
    (Finsupp.domCongr (M := ℕ) (Equiv.ulift : ULift.{u} (Fin c) ≃ Fin c)).toEquiv
    fun d => by
      change d.degree = n ↔ (Finsupp.domCongr Equiv.ulift d).degree = n
      rw [Finsupp.domCongr_apply, Finsupp.equivMapDomain_eq_mapDomain, Finsupp.degree_mapDomain]

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Z : AlgebraicSpaces B S hS}

variable (k : Z ⟶ X) (hk : IsClosedImmersion B S hS k.hom) (V : SmallEtale B S hS X.1)
  (hV : IsAffine (chartScheme V))

include hk in
/-- The inverse image along a closed immersion `k` of the `n`-th power of its kernel ideal sheaf
is cartesian on affine charts. -/
theorem isCartesianOnAffineCharts_modulePullback_kernelPowModule (n : ℕ) :
    IsCartesianOnAffineCharts ((modulePullback B S hS k).obj (kernelPowModule B S hS k (n : ℤ))) :=
  isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Z.1 Z.2 _
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS k _
      (isQuasicoherentOnSite_kernelIdealSheafZPow_natCast B S hS k
        (isQuasicoherentOnSite_kernelIdealSheaf B S hS k
          (isQuasiCompact_of_isClosedImmersion' B S hS hk)) n))

include hV in
/-- The base-changed chart of an affine chart is affine. -/
theorem isAffine_chartScheme_baseChangeChartDiagram :
    IsAffine (chartScheme (baseChangeChartDiagram B S hS k hk.1 V).U) :=
  (isAffine_and_surjective_baseChangeChartDiagram B S hS k hk V hV).1

/-- If the conormal module is free on an affine slice, the sections of each symmetric power over
it are a free module. -/
private theorem nonempty_basis_piece_of_iso_free {Cm : Modules.{u, u} B S hS Z.1 Z.2}
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : Cm ⟶ A.piece 1) (hA : SheafOfModules.GradedAlgebra.IsSymmetricAlgebra A ι)
    (T : SmallEtale B S hS Z.1) (hT : IsAffine (chartScheme T)) {γ : Type u}
    (e : Cm.over T ≅ SheafOfModules.free (R := SmallEtale.sliceRingSheaf B S hS Z.1 Z.2 T) γ)
    (n : ℕ) :
    Nonempty (Module.Basis {d : γ →₀ ℕ | d.degree = n} (chartRing B S hS Z.1 Z.2 T)
      ((show Modules.{u, u} B S hS Z.1 Z.2 from A.piece (n : ℤ)).val.obj (op T))) := by
  classical
  obtain ⟨eA⟩ := nonempty_iso_free_symmetricPower_over B S hS Z.1 Z.2 _ A ι hA T e n
  exact ⟨basisOfIsoFreeOver B S hS Z.1 Z.2 _ T eA (Over.mk (𝟙 T)) hT⟩

/-! ### The direction out of a quasi-regular generating sequence -/

section Forward

variable {c : ℕ} (f : Fin c → chartRing B S hS X.1 X.2 V)
  (hf : conormalChartIdeal B S hS k V = Ideal.span (Set.range f))
  (hqr : RingTheory.Sequence.IsQuasiRegular (chartRing B S hS X.1 X.2 V) (List.ofFn f))

include hV f hf hqr in
/-- **The conormal module is free of rank `c` on the slice at the base-changed chart** when the
ideal of `Z` over the affine chart is generated by a quasi-regular sequence of length `c`. -/
theorem nonempty_iso_free_over_conormal_of_isQuasiRegular :
    Nonempty (((modulePullback B S hS k).obj (kernelPowModule B S hS k ((1 : ℕ) : ℤ))).over
        (baseChangeChartDiagram B S hS k hk.1 V).U ≅
      SheafOfModules.free (R := SmallEtale.sliceRingSheaf B S hS Z.1 Z.2
        (baseChangeChartDiagram B S hS k hk.1 V).U) (ULift.{u} (Fin c))) :=
  nonempty_iso_free_over_of_basis B S hS Z.1 Z.2 _
    (isCartesianOnAffineCharts_modulePullback_kernelPowModule B S hS k hk 1)
    (baseChangeChartDiagram B S hS k hk.1 V).U
    (isAffine_chartScheme_baseChangeChartDiagram B S hS k hk V hV)
    (((conormalChartPresentation B S hS k hk V hV f hf 1).basisOne hqr).reindex
      Equiv.ulift.symm)

include hV f hf hqr in
/-- **The canonical map of Stacks 09RQ is an isomorphism on the slice at the base-changed chart
in every degree** when the ideal of `Z` over the affine chart is generated by a quasi-regular
sequence. -/
theorem isIso_over_symmetricAlgebraToConormalAlgebra_of_isQuasiRegular
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : (conormalAlgebra B S hS k).piece 1 ⟶ A.piece 1)
    (hA : SheafOfModules.GradedAlgebra.IsSymmetricAlgebra A ι) (n : ℤ) :
    IsIso ((SheafOfModules.overFunctor
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Z.1 Z.2).O)
        (baseChangeChartDiagram B S hS k hk.1 V).U).map
      ((symmetricAlgebraToConormalAlgebra B S hS k A ι hA).app n)) := by
  classical
  set Φ := symmetricAlgebraToConormalAlgebra B S hS k A ι hA
  have hι : ι ≫ Φ.app 1 = 𝟙 _ := symmetricAlgebraToConormalAlgebra_app_one B S hS k A ι hA
  set T := (baseChangeChartDiagram B S hS k hk.1 V).U
  have hT := isAffine_chartScheme_baseChangeChartDiagram B S hS k hk V hV
  rcases lt_or_ge n 0 with hn | hn
  · have h1 := isZero_piece_of_isSymmetricAlgebra_of_neg B S hS Z.1 Z.2 _ A ι hA hn
    have h2 := isZero_conormalAlgebra_piece_of_neg B S hS k hn
    have he : Φ.app n = (h1.iso h2).hom := h1.eq_of_src _ _
    rw [he]
    exact ((SheafOfModules.overFunctor
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Z.1 Z.2).O) T).mapIso
        (h1.iso h2)).isIso_hom
  · obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hn
    obtain ⟨e1⟩ := nonempty_iso_free_over_conormal_of_isQuasiRegular B S hS k hk V hV f hf hqr
    obtain ⟨eA⟩ := nonempty_iso_free_symmetricPower_over B S hS Z.1 Z.2 _ A ι hA T e1 m
    obtain ⟨bA⟩ := nonempty_basis_piece_of_iso_free B S hS A ι hA T hT e1 m
    refine isIso_over_map_of_bijective_app B S hS Z.1 Z.2 (Φ.app (m : ℤ))
      (isCartesianOnAffineCharts_modulePullback_kernelPowModule B S hS k hk m) T hT eA ?_
    have hsurj : Function.Surjective
        ((toKernelPowPullback B S hS k A Φ (m : ℤ)).val.app (op T)) := by
      rcases Nat.eq_zero_or_pos m with rfl | hm
      · exact surjective_toKernelPowPullback_app_zero B S hS k hk V hV A Φ
      · exact surjective_toKernelPowPullback_app B S hS k hk V hV A Φ ι hι m hm
    let bC := (conormalChartPresentation B S hS k hk V hV f hf m).basis hqr
    let Θ := bA.equiv bC (monomialsULiftEquiv c m)
    have : Module.Finite (chartRing B S hS Z.1 Z.2 T)
        (((modulePullback B S hS k).obj (kernelPowModule B S hS k (m : ℤ))).val.obj (op T)) :=
      Module.Finite.of_basis bC
    exact ⟨OrzechProperty.injective_of_surjective_of_injective Θ.toLinearMap
      ((toKernelPowPullback B S hS k A Φ (m : ℤ)).val.app (op T)).hom Θ.injective hsurj, hsurj⟩

end Forward

/-! ### The direction into a quasi-regular generating sequence -/

section Converse

include hV in
/-- **A generating sequence of the ideal over an affine chart is quasi-regular** as soon as the
canonical map of Stacks 09RQ is an isomorphism in every degree and the sections of the conormal
module over the base-changed chart are free on as many generators as the sequence has terms. -/
@[sga "1 II 4.14" "special case"]
theorem isQuasiRegular_of_isIso_symmetricAlgebraToConormalAlgebra
    (A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf B S hS Z))
    (ι : (conormalAlgebra B S hS k).piece 1 ⟶ A.piece 1)
    (hA : SheafOfModules.GradedAlgebra.IsSymmetricAlgebra A ι)
    (hiso : ∀ n : ℤ, IsIso ((symmetricAlgebraToConormalAlgebra B S hS k A ι hA).app n))
    {c : ℕ} (f : Fin c → chartRing B S hS X.1 X.2 V)
    (hf : conormalChartIdeal B S hS k V = Ideal.span (Set.range f))
    (b1 : Module.Basis (Fin c) (chartRing B S hS Z.1 Z.2 (baseChangeChartDiagram B S hS k hk.1 V).U)
      (((modulePullback B S hS k).obj (kernelPowModule B S hS k ((1 : ℕ) : ℤ))).val.obj
        (op (baseChangeChartDiagram B S hS k hk.1 V).U))) :
    RingTheory.Sequence.IsQuasiRegular (chartRing B S hS X.1 X.2 V) (List.ofFn f) := by
  classical
  set Φ := symmetricAlgebraToConormalAlgebra B S hS k A ι hA
  set T := (baseChangeChartDiagram B S hS k hk.1 V).U
  have hT := isAffine_chartScheme_baseChangeChartDiagram B S hS k hk V hV
  obtain ⟨e1⟩ := nonempty_iso_free_over_of_basis B S hS Z.1 Z.2 _
    (isCartesianOnAffineCharts_modulePullback_kernelPowModule B S hS k hk 1) T hT
    (b1.reindex Equiv.ulift.symm)
  refine Stacks.RingTheory.QuasiRegular.isQuasiRegular_of_basisTcomp f fun n => ?_
  let bA := (nonempty_basis_piece_of_iso_free B S hS A ι hA T hT e1 n).some
  have := hiso (n : ℤ)
  let An : Modules.{u, u} B S hS Z.1 Z.2 := A.piece (n : ℤ)
  let L : An.val.obj (op T) ≃ₗ[chartRing B S hS Z.1 Z.2 T]
      ((modulePullback B S hS k).obj (kernelPowModule B S hS k (n : ℤ))).val.obj (op T) :=
    LinearEquiv.ofBijective ((toKernelPowPullback B S hS k A Φ (n : ℤ)).val.app (op T)).hom
      (ConcreteCategory.bijective_of_isIso
        ((SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ (op T)).map (Φ.app (n : ℤ))))
  exact (conormalChartPresentation B S hS k hk V hV f hf n).basisTcompOfBasis
    ((bA.map L).reindex (monomialsULiftEquiv c n))

end Converse

end AlgebraicGeometry.Space

end
