module

public import StacksFrontier.AlgebraicGeometry.Descent.EtaleLocal.Cancellation
public import StacksFrontier.AlgebraicGeometry.Spaces.CoveringSieveStepOne
public import StacksFrontier.AlgebraicGeometry.Spaces.PointsRepresentable
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeMorphismDescent

/-!
# The relative morphism functor is an fppf sheaf

Let `S` be a scheme contained in a big fppf site `B` and let `z : Z ⟶ Q` and `x : X ⟶ Q` be
morphisms of algebraic spaces over `S`. The relative morphism functor `Mor_Q(Z, X)` of
Stacks 05Y2 is a sheaf on the big fppf site of `S`. This is part (1) of **Stacks 05Y3**.

## Main results

* `AlgebraicGeometry.Space.isSheaf_relativeHom`: **Stacks 05Y3**, part (1).
* `AlgebraicGeometry.Space.isFppfCovering_yonedaMap_of_isCovering`: a chosen covering family of
  an object of the big fppf site of `S`, read through the Yoneda embedding, is an fppf covering
  of algebraic spaces over `S`.
* `AlgebraicGeometry.Space.isSheafFor_of_isSheafFor_isCovering`: a presheaf on the big fppf site
  of `S` satisfying the sheaf condition for the presieves of the chosen covering families is a
  sheaf for every covering sieve of the localized topology.

## Implementation notes

The content is the descent statement
`AlgebraicGeometry.Space.existsUnique_restrict_of_isFppfCovering`: the sheaf condition for a
single chosen covering family is exactly descent of pairs along the corresponding fppf covering
of representable presheaves, the identification of the sections with pairs being
`AlgebraicGeometry.Space.relativeHomSections` and its compatibility with restriction being
`AlgebraicGeometry.Space.relativeHomSections_map`. The compatibility hypothesis is transported
from the fibre product `U i ×_T U j` taken in the site to the fibre product of the two
representable presheaves through `CategoryTheory.Limits.PreservesPullback.iso`, the Yoneda
embedding preserving fibre products.

Passing from that to the sheaf condition for an arbitrary covering sieve is site bookkeeping:
the topology of the big fppf site is generated by the chosen families, so a covering sieve is
reached from them by the three closure steps of
`CategoryTheory.Precoverage.Saturate`, and the base-change axiom of the chosen system supplies a
chosen family refining each pullback. The localization at `S` is handled by transporting sieves
along `CategoryTheory.Sieve.overEquiv`.

## References

* [Stacks Project, Tag 05Y2](https://stacks.math.columbia.edu/tag/05Y2)
* [Stacks Project, Tag 05Y3](https://stacks.math.columbia.edu/tag/05Y3)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AlgebraicGeometry.Space

/-! ### Chosen covering families as fppf coverings of algebraic spaces -/

/-- A chosen covering family of an object `T` of the big fppf site of `S`, read through the
Yoneda embedding, is an fppf covering of algebraic spaces over `S`. -/
theorem isFppfCovering_yonedaMap_of_isCovering (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) (T : BigFppfOver B S hS) (E : PreZeroHypercover.{u + 1} T.left)
    (hE : B.IsCovering ⟨T.left, E⟩) :
    IsFppfCovering B S hS
      (fun i => yoneda.obj (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS))
      (fun i => yoneda.map (Over.homMk (E.f i) :
        (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T)) where
  target_isAlgebraicSpace := isAlgebraicSpace_yoneda B S hS T
  source_isAlgebraicSpace i := isAlgebraicSpace_yoneda B S hS _
  flat i := isFlat_yoneda_map B S hS _
    ((BigFppfSite.jointlySurjective_flat_locallyOfFinitePresentation_of_isCovering B hE).2 i).1
  locallyOfFinitePresentation i := isLocallyOfFinitePresentation_yoneda_map B S hS _
    ((BigFppfSite.jointlySurjective_flat_locallyOfFinitePresentation_of_isCovering B hE).2 i).2
  jointly_surjective := by
    rw [Set.eq_univ_iff_forall]
    intro w
    obtain ⟨i, y, hy⟩ :=
      (BigFppfSite.jointlySurjective_flat_locallyOfFinitePresentation_of_isCovering B hE).1
        (pointsToScheme B S hS T w)
    obtain ⟨r, hr⟩ := surjective_pointsToScheme B S hS (Over.mk (E.f i ≫ T.hom)) y
    refine Set.mem_iUnion.mpr ⟨i, r, ?_⟩
    apply injective_pointsToScheme B S hS T
    rwa [pointsToScheme_pointsMap_yoneda, hr]

/-! ### From the chosen families to every covering sieve -/

/-- Pulling back a sieve along `g`, transported to the slice, is transported pullback along
`g.left ≫ f`. -/
private theorem pullback_overEquiv_symm_pullback {B : BigFppfSite.{u}} {S : Scheme.{u}}
    {hS : B.Contains S} {T Y : B.Schemes} (R : Sieve T) (f : Y ⟶ T) (t : Y ⟶ B.obj hS)
    {W : BigFppfOver B S hS} (g : W ⟶ Over.mk t) :
    ((Sieve.overEquiv (Over.mk t)).symm (R.pullback f)).pullback g =
      (Sieve.overEquiv W).symm (R.pullback (g.left ≫ f)) := by
  apply (Sieve.overEquiv W).injective
  simp [Sieve.overEquiv_pullback, Sieve.pullback_comp]

/-- The slice structure morphism of an object can be rebuilt from its `hom`. -/
private theorem overEquiv_symm_mk_hom {B : BigFppfSite.{u}} {S : Scheme.{u}}
    {hS : B.Contains S} (W : BigFppfOver B S hS) (R : Sieve W.left) :
    (Sieve.overEquiv (Over.mk W.hom)).symm R = (Sieve.overEquiv W).symm R := by
  apply (Sieve.overEquiv (Over.mk W.hom)).injective
  cases W
  simp [Sieve.overEquiv]

/-- A presheaf on the big fppf site of `S` which satisfies the sheaf condition for the presieve
of every chosen covering family satisfies it for every covering sieve of the localized topology,
pulled back along an arbitrary morphism and read in an arbitrary slice.

The three cases of the induction are the three closure steps generating the topology from the
chosen families; the base case uses the base-change axiom of the chosen system to refine the
pullback of a chosen family by a chosen family. -/
theorem isSheafFor_of_isSheafFor_isCovering (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : ∀ (T : BigFppfOver B S hS) (E : PreZeroHypercover.{u + 1} T.left),
      B.IsCovering ⟨T.left, E⟩ →
      (Presieve.ofArrows (fun i => (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS))
        (fun i => (Over.homMk (E.f i) :
          (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))).IsSheafFor F) :
    ∀ {T : B.Schemes} (R : Sieve T), R ∈ B.topology T →
      ∀ {Y : B.Schemes} (f : Y ⟶ T) (t : Y ⟶ B.obj hS),
        ((Sieve.overEquiv (Over.mk t)).symm (R.pullback f)).arrows.IsSheafFor F := by
  intro T R hR
  rw [Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of T P hP =>
      intro Y f t
      obtain ⟨E, hPE, hE⟩ := hP
      obtain ⟨P', p₁, p₂, hPB, hPcov⟩ := B.coverings_isSite.2.2 ⟨T, E⟩ hE Y f
      let E' : PreZeroHypercover.{u + 1} Y := ⟨E.I₀, P', p₂⟩
      have hE' : B.IsCovering ⟨Y, E'⟩ := hPcov
      let T' : BigFppfOver B S hS := Over.mk t
      have hSieve : (Sieve.overEquiv T').symm ((Sieve.generate P).pullback f) =
          Sieve.generate (Presieve.ofArrows
            (fun i => (Over.mk (E'.f i ≫ T'.hom) : BigFppfOver B S hS))
            (fun i => (Over.homMk (E'.f i) :
              (Over.mk (E'.f i ≫ T'.hom) : BigFppfOver B S hS) ⟶ T'))) := by
        apply (Sieve.overEquiv T').injective
        simp only [OrderIso.apply_symm_apply, Sieve.overEquiv_ofArrows]
        rw [hPE]
        show Sieve.pullback f (Sieve.ofArrows E.X E.f) = Sieve.ofArrows P' p₂
        exact (Sieve.ofArrows_eq_pullback_of_isPullback E.f (fun i => (hPB i).flip)).symm
      rw [hSieve]
      exact (Presieve.isSheafFor_iff_generate _).mp (hF T' E' hE')
  | top T =>
      intro Y f t
      exact Presieve.isSheafFor_top _
  | pullback T R hR Y g ih =>
      intro Z f t
      simpa [Sieve.pullback_comp, Category.assoc] using ih (f ≫ g) t
  | transitive T Sieve₁ R hSCov hRpull ihS ihR =>
      intro Y f t
      let T' : BigFppfOver B S hS := Over.mk t
      let S' : Sieve T' := (Sieve.overEquiv T').symm (Sieve₁.pullback f)
      let R' : Sieve T' := (Sieve.overEquiv T').symm (R.pullback f)
      have hSep : ∀ ⦃W : BigFppfOver B S hS⦄ (g : W ⟶ T'),
          R' g → (S'.pullback g).arrows.IsSeparatedFor F := by
        intro W g _
        rw [show S'.pullback g = _ from pullback_overEquiv_symm_pullback ..]
        exact (ihS (g.left ≫ f) W.hom).isSeparatedFor
      have hGlue : ∀ ⦃W : BigFppfOver B S hS⦄ (g : W ⟶ T'),
          S' g → (R'.pullback g).arrows.IsSheafFor F := by
        intro W g hg
        have hg' : Sieve₁ (g.left ≫ f) := hg
        rw [show R'.pullback g = _ from pullback_overEquiv_symm_pullback ..,
          ← overEquiv_symm_mk_hom]
        simpa [Sieve.pullback_comp] using ihR (f := g.left ≫ f) hg' (𝟙 W.left) W.hom
      exact Presieve.isSheafFor_trans _ S' R' (ihS f t) hSep hGlue

/-! ### The sheaf condition for the relative morphism functor -/

section

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {Z X Q : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {z : Z ⟶ Q} {x : X ⟶ Q}

/-- Restriction of pairs along an isomorphism of test objects is injective. -/
theorem RelativeMorphism.eq_of_restrict_iso_eq {T T' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (e : T' ≅ T) {p q : RelativeMorphism B S hS Z X Q z x T}
    (h : RelativeMorphism.restrict e.hom p = RelativeMorphism.restrict e.hom q) : p = q := by
  have h2 := congrArg (RelativeMorphism.restrict e.inv) h
  rwa [RelativeMorphism.restrict_comp, RelativeMorphism.restrict_comp, e.inv_hom_id,
    RelativeMorphism.restrict_id, RelativeMorphism.restrict_id] at h2

end

/-- The relative morphism functor satisfies the sheaf condition for the presieve of a chosen
covering family of the big fppf site of `S`: that condition is exactly descent of the pairs of
Stacks 05Y1 along the corresponding fppf covering of representable presheaves. -/
theorem relativeHom_isSheafFor_isCovering (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) (Z X Q : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (z : Z ⟶ Q) (x : X ⟶ Q)
    (hZ : IsAlgebraicSpace B S hS Z) (hX : IsAlgebraicSpace B S hS X)
    (hQ : IsAlgebraicSpace B S hS Q) (T : BigFppfOver B S hS)
    (E : PreZeroHypercover.{u + 1} T.left) (hE : B.IsCovering ⟨T.left, E⟩) :
    (Presieve.ofArrows (fun i => (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS))
      (fun i => (Over.homMk (E.f i) :
        (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))).IsSheafFor
      (relativeHom B S hS Z X Q z x hZ hX hQ) := by
  classical
  intro a ha
  have hmem : ∀ i, Presieve.ofArrows
      (fun i => (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS))
      (fun i => (Over.homMk (E.f i) :
        (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
      (Over.homMk (E.f i) : (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T) :=
    fun i => Presieve.ofArrows.mk i
  set p : ∀ i, RelativeMorphism B S hS Z X Q z x
      (yoneda.obj (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS)) := fun i =>
    relativeHomSections B S hS Z X Q z x hZ hX hQ (Over.mk (E.f i ≫ T.hom))
      (a (Over.homMk (E.f i)) (hmem i)) with hpdef
  have hpij : ∀ i j,
      RelativeMorphism.restrict (pullback.fst
          (yoneda.map (Over.homMk (E.f i) :
            (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
          (yoneda.map (Over.homMk (E.f j) :
            (Over.mk (E.f j ≫ T.hom) : BigFppfOver B S hS) ⟶ T))) (p i) =
      RelativeMorphism.restrict (pullback.snd
          (yoneda.map (Over.homMk (E.f i) :
            (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
          (yoneda.map (Over.homMk (E.f j) :
            (Over.mk (E.f j ≫ T.hom) : BigFppfOver B S hS) ⟶ T))) (p j) := by
    intro i j
    refine RelativeMorphism.eq_of_restrict_iso_eq
      (PreservesPullback.iso yoneda
        (Over.homMk (E.f i) : (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T)
        (Over.homMk (E.f j) : (Over.mk (E.f j ≫ T.hom) : BigFppfOver B S hS) ⟶ T)) ?_
    rw [RelativeMorphism.restrict_comp, RelativeMorphism.restrict_comp,
      PreservesPullback.iso_hom_fst, PreservesPullback.iso_hom_snd]
    have hsite := ha (pullback.fst
        (Over.homMk (E.f i) : (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T)
        (Over.homMk (E.f j) : (Over.mk (E.f j ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
      (pullback.snd
        (Over.homMk (E.f i) : (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T)
        (Over.homMk (E.f j) : (Over.mk (E.f j ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
      (hmem i) (hmem j) pullback.condition
    rw [hpdef, ← relativeHomSections_map, ← relativeHomSections_map, hsite]
  obtain ⟨q, hq, hquniq⟩ :=
    existsUnique_restrict_of_isFppfCovering B S hS z x hZ hX hQ
      (fun i => yoneda.obj (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS))
      (fun i => yoneda.map (Over.homMk (E.f i) :
        (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
      (isFppfCovering_yonedaMap_of_isCovering B S hS T E hE) p hpij
  have hsec : ∀ (t : (relativeHom B S hS Z X Q z x hZ hX hQ).obj (op T)) (i),
      relativeHomSections B S hS Z X Q z x hZ hX hQ (Over.mk (E.f i ≫ T.hom))
          ((relativeHom B S hS Z X Q z x hZ hX hQ).map
            (Over.homMk (E.f i) :
              (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T).op t) =
        RelativeMorphism.restrict (yoneda.map (Over.homMk (E.f i) :
            (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T))
          (relativeHomSections B S hS Z X Q z x hZ hX hQ T t) :=
    fun t i => relativeHomSections_map B S hS Z X Q z x hZ hX hQ _ t
  refine ⟨(relativeHomSections B S hS Z X Q z x hZ hX hQ T).symm q, ?_, ?_⟩
  · rintro V _ ⟨i⟩
    refine (relativeHomSections B S hS Z X Q z x hZ hX hQ
      (Over.mk (E.f i ≫ T.hom))).injective ?_
    rw [hsec, Equiv.apply_symm_apply, hq i, hpdef]
  · intro t' ht'
    refine (relativeHomSections B S hS Z X Q z x hZ hX hQ T).injective ?_
    rw [Equiv.apply_symm_apply]
    refine hquniq _ fun i => ?_
    rw [← hsec t' i, ht' (Over.homMk (E.f i) :
      (Over.mk (E.f i ≫ T.hom) : BigFppfOver B S hS) ⟶ T) (hmem i), hpdef]

/-- **Stacks 05Y3**, part (1). For morphisms `z : Z ⟶ Q` and `x : X ⟶ Q` of algebraic spaces
over `S`, the relative morphism functor `Mor_Q(Z, X)` of Stacks 05Y2 is a sheaf on the big fppf
site of `S`. -/
@[stacks 05Y3 "part (1): the relative morphism functor `Mor_B(Z, X)` is a sheaf on the big \
fppf site of `S`"]
theorem isSheaf_relativeHom (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (Z X Q : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (z : Z ⟶ Q) (x : X ⟶ Q)
    (hZ : IsAlgebraicSpace B S hS Z) (hX : IsAlgebraicSpace B S hS X)
    (hQ : IsAlgebraicSpace B S hS Q) :
    Presheaf.IsSheaf (BigFppfOver.topology B S hS)
      (relativeHom B S hS Z X Q z x hZ hX hQ) := by
  rw [isSheaf_iff_isSheaf_of_type]
  intro T R hR
  rw [GrothendieckTopology.mem_over_iff] at hR
  have hmain := isSheafFor_of_isSheafFor_isCovering B S hS
    (relativeHom B S hS Z X Q z x hZ hX hQ)
    (relativeHom_isSheafFor_isCovering B S hS Z X Q z x hZ hX hQ)
    (Sieve.overEquiv T R) hR (𝟙 T.left) T.hom
  simpa only [Sieve.pullback_id, overEquiv_symm_mk_hom,
    OrderIso.symm_apply_apply] using hmain

end AlgebraicGeometry.Space

end
