-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace AlgebraicGeometry.Space

/-! ### Nonzerodivisor generators of a principal ideal -/

/-- In a commutative ring an element by which multiplication on the right is injective is a
nonzerodivisor: left and right multiplication by it are the same map. -/
theorem isRegular_of_injective_mul_right {R : Type*} [CommRing R] {a : R}
    (h : Function.Injective fun r : R => r * a) : IsRegular a :=
  ⟨fun c d hcd => h ((mul_comm c a).trans ((hcd : a * c = a * d).trans (mul_comm a d))), h⟩

/-! ### Injectivity on sections is local -/

/-- **Injectivity on sections descends along a covering family**, when the source is a sheaf of
types: two sections with the same image agree on every member of the family, hence agree by
separatedness. -/
theorem injective_app_of_covering_family
    {C : Type v} [Category.{w} C] {J : GrothendieckTopology C}
    {F G : Cᵒᵖ ⥤ Type u} (φ : F ⟶ G) (hF : Presheaf.IsSheaf J F) {U : C}
    {ι : Type*} (V : ι → C) (f : ∀ i, V i ⟶ U)
    (hT : Sieve.ofArrows V f ∈ J U)
    (h : ∀ i, Function.Injective (φ.app (op (V i)))) :
    Function.Injective (φ.app (op U)) := by
  intro x y hxy
  refine (hF.isSheafFor _ hT).isSeparatedFor.ext ?_
  intro W g hg
  obtain ⟨V', k, l, hl, rfl⟩ := hg
  obtain ⟨i⟩ := hl
  have he : F.map (f i).op x = F.map (f i).op y := by
    refine h i ?_
    simpa only [NatTrans.naturality_apply] using congrArg (G.map (f i).op) hxy
  simpa only [op_comp, Functor.map_comp, types_comp_apply] using congrArg (F.map k.op) he

/-- **Injectivity on sections of a morphism of sheaves of modules descends along a covering
family.**  This is `AlgebraicGeometry.Space.injective_app_of_covering_family` applied to the
underlying morphism of sheaves of types. -/
theorem module_injective_app_of_covering_family
    {C : Type v} [Category.{w} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{u}} {M N : SheafOfModules.{u} R} (p : M ⟶ N)
    {U : C} {ι : Type*} (V : ι → C) (f : ∀ i, V i ⟶ U)
    (hT : Sieve.ofArrows V f ∈ J U)
    (h : ∀ i, Function.Injective (p.val.app (op (V i))).hom) :
    Function.Injective (p.val.app (op U)).hom :=
  injective_app_of_covering_family
    (Functor.whiskerRight ((PresheafOfModules.toPresheaf R.obj).map p.val)
      (forget AddCommGrpCat))
    (Presheaf.isSheaf_comp_of_isSheaf J _ (forget AddCommGrpCat) M.isSheaf) V f hT h

/-- **Multiplication by a global section, read on the sections over an object of the site.**  The
morphism `𝒪 ⟶ M` attached to a global section `a` of a sheaf of modules sends a regular function
`r` over an object to `r • a`. -/
theorem unitHomEquiv_symm_app_apply
    {C : Type v} [Category.{w} C] {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u})
    (M : SheafOfModules.{u} R) (a : M.sections) (U : C) (r : R.obj.obj (op U)) :
    ((M.unitHomEquiv.symm a).val.app (op U)).hom r = r • a.eval (op U) := by
  let : Module (R.obj.obj (op U)) (M.val.obj (op U)) := (M.val.obj (op U)).isModule
  set p := M.unitHomEquiv.symm a
  have h1 : p.val.app (op U) (1 : R.obj.obj (op U)) = a.eval (op U) :=
    (M.unitHomEquiv_apply_coe p (op U)).symm ▸
      congrArg (fun t : M.sections => t.eval (op U)) (M.unitHomEquiv.apply_symm_apply a)
  calc p.val.app (op U) r = p.val.app (op U) (r • (1 : R.obj.obj (op U))) := by simp
    _ = r • p.val.app (op U) (1 : R.obj.obj (op U)) := map_smul _ _ _
    _ = r • a.eval (op U) := by rw [h1]

/-! ### The forward half of part (4) -/

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (X : AlgebraicSpaces B S hS) (L : Modules.{u, u} B S hS X.1 X.2) (s : L.sections)

/-- **The forward half of Stacks 0846 (4).**  If the zero scheme of a global section `s` of an
invertible module `L` is an effective Cartier divisor, then `s` is a regular section.

Regularity is injectivity of multiplication by `s` on the sections over every chart, and that
descends along a covering family; the members of the family used here are affine charts lying
below a chart trivializing `L` and below a chart trivializing the defining ideal sheaf of the
zero scheme, which is finite locally free of rank one by Stacks 0B8Q because the zero scheme is
an effective Cartier divisor.  On such a chart the defining ideal of the zero scheme is the
principal ideal generated by the coordinate of `s` against the trivialization of `L`, and also
the principal ideal generated by a nonzerodivisor, so the coordinate of `s` is a nonzerodivisor
too. -/
theorem isRegularSection_of_isEffectiveCartierDivisor_zeroScheme
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (hD : IsEffectiveCartierDivisor B S hS X (zeroScheme B S hS X L s)) :
    AlgebraicGeometry.IsRegularSection (structurePresheaf B S hS X.1)
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).property s := by
  classical
  let E := smallEtaleRingedSite B S hS X.1 X.2
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hinv
  let Jd := definingIdealSheaf B S hS X (zeroScheme B S hS X L s)
  have hRankL : RingedSite.IsFiniteLocallyFreeOfRank E L 1 :=
    isFiniteLocallyFreeOfRank_one_of_isInvertible B S hS X L hinv
  have hRankI : RingedSite.IsFiniteLocallyFreeOfRank E Jd.toSheafOfModules 1 :=
    isFiniteLocallyFreeOfRank_one_of_isInvertible B S hS X Jd.toSheafOfModules hD
  have key : ∀ (VL : E.C) (_ : L.over VL ≅
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over VL))
      (W : E.C) (_ : W ⟶ VL)
      (_ : SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over W) ≅
        Jd.toSheafOfModules.over W),
      IsAffine ((SmallEtale.toSchemes B S hS X.1).obj W).1 →
      Function.Injective ((L.unitHomEquiv.symm s).val.app (op W)).hom := by
    intro VL eL W gL eIW hW
    obtain ⟨f, hf, hgenf⟩ := exists_isRegular_span_definingIdealAt_of_unitIso B S hS X
      (zeroScheme B S hS X L s) W eIW
    let R := (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op W)
    let : CommRing R := inferInstanceAs (CommRing (E.O.obj.obj (op W)))
    let eRL : L.val.obj (op W) ≃ₗ[R] R :=
      ((SheafOfModules.evaluation ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over VL)
        (op (Over.mk gL))).mapIso eL).toLinearEquiv
    have hb : ∀ x : L.val.obj (op W), eRL x • eRL.symm 1 = x := fun x => by
      apply eRL.injective
      simp
    have hspan : definingIdealAt B S hS X (zeroScheme B S hS X L s) (op W) =
        Ideal.span {eRL (s.eval (op W))} := by
      rw [definingIdealAt_zeroScheme_eq B S hS X L s Z hZ W hW]
      exact sectionEvaluationIdealAt_eq_span_singleton B S hS X L s W
        (eRL.symm 1) eRL.toLinearMap hb
    have hreg : IsRegular (eRL (s.eval (op W))) := by
      let : CommRing (ToType ((structureRingSheaf B S hS X).obj.obj (op W))) :=
        inferInstanceAs (CommRing
          (ToType ((smallEtaleRingedSite B S hS X.1 X.2).O.obj.obj (op W))))
      exact isRegular_of_span_singleton_eq hf (hspan.symm.trans hgenf)
    have hsmul := (injective_smul_eval_iff_injective_mul_generator B S hS X L s W
      (eRL.symm 1) eRL.toLinearMap hb).2 hreg.right
    intro x y hxy
    refine hsmul ?_
    exact (unitHomEquiv_symm_app_apply
      (Stacks.SheafOfModules.Tensor.ringSheaf E.O) L s W x).symm.trans
      (hxy.trans (unitHomEquiv_symm_app_apply
        (Stacks.SheafOfModules.Tensor.ringSheaf E.O) L s W y))
  have hisoL : ∀ (U : E.C) (I : Type (u + 1)) (V : I → E.C) (f : ∀ i, V i ⟶ U)
      (htriv : ∀ i, ∃ ι : ∀ _ : Fin 1,
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i)) ⟶
          L.over (V i), Nonempty (IsColimit (Cofan.mk (L.over (V i)) ι))) (i : I),
      L.over (V i) ≅
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i)) :=
    fun _ _ V _ htriv i =>
      iso_of_one_coproduct ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i))
        (L.over (V i)) (htriv i).choose (Classical.choice (htriv i).choose_spec)
  have hisoI : ∀ (U : E.C) (I : Type (u + 1)) (V : I → E.C) (f : ∀ i, V i ⟶ U)
      (htriv : ∀ i, ∃ ι : ∀ _ : Fin 1,
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i)) ⟶
          Jd.toSheafOfModules.over (V i),
        Nonempty (IsColimit (Cofan.mk (Jd.toSheafOfModules.over (V i)) ι))) (i : I),
      Jd.toSheafOfModules.over (V i) ≅
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i)) :=
    fun _ _ V _ htriv i =>
      iso_of_one_coproduct ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over (V i))
        (Jd.toSheafOfModules.over (V i)) (htriv i).choose
        (Classical.choice (htriv i).choose_spec)
  change Mono (L.unitHomEquiv.symm s)
  apply (SheafOfModules.forget (Stacks.SheafOfModules.Tensor.ringSheaf E.O)).mono_of_mono_map
  apply PresheafOfModules.mono_of_injective
  intro U
  obtain ⟨IL, VL, fL, hcovL, htrivL⟩ := hRankL U.unop
  refine module_injective_app_of_covering_family _ VL fL hcovL ?_
  intro i
  obtain ⟨II, VI, fI, hcovI, htrivI⟩ := hRankI (VL i)
  refine module_injective_app_of_covering_family _ VI fI hcovI ?_
  intro j
  obtain ⟨K, A, a, hcovA, hAff⟩ := affine_chart_cover B S hS X.1 (VI j)
  refine module_injective_app_of_covering_family _ A a hcovA ?_
  intro k
  exact key (VL i) (hisoL U.unop IL VL fL htrivL i) (A k) (a k ≫ fI j)
    (unitIsoRestrict E Jd.toSheafOfModules (a k) (hisoI (VL i) II VI fI htrivI j).symm) (hAff k)

/-! ### The reverse half of part (4) -/

/-- **A rank-one sheaf of modules on the small étale site is trivial on an affine étale chart
through every point of the algebraic space.**  This is the point-chasing of
`AlgebraicGeometry.Space.exists_affine_chart_isRegular_span_of_isFiniteLocallyFree`, stated for an
arbitrary sheaf of modules of rank one instead of the defining ideal sheaf of a closed
subspace. -/
theorem exists_affine_chart_unitIso_of_isFiniteLocallyFreeOfRank_one
    (M : SheafOfModules.{u} (structureRingSheaf B S hS X))
    (hfree : RingedSite.IsFiniteLocallyFreeOfRank (smallEtaleRingedSite B S hS X.1 X.2) M 1)
    (x : points B S hS X.1) :
    ∃ (V : (smallEtaleRingedSite B S hS X.1 X.2).C)
      (v : points B S hS (yoneda.obj V.1.left)),
      IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) ∧
      pointsMap B S hS (yoneda.obj V.1.left) V.1.hom v = x ∧
      Nonempty (SheafOfModules.unit
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS X.1 X.2).O).over V) ≅ M.over V) := by
  set T := BigFppfOver.toScheme B S hS
  obtain ⟨U₀, g₀, hsurj, hetale⟩ := X.2.exists_atlas
  have hg₀ : IsEtale B S hS g₀ := isEtale_of_presheaf_etale B S hS hetale
  set U : SmallEtale B S hS X.1 :=
    ⟨CostructuredArrow.mk g₀, presheaf_etale_of_isEtale B S hS hg₀⟩
  obtain ⟨p, hp⟩ := (presheafSurjective_iff_isSurjective_yoneda B S hS X.1 X.2 U₀ g₀).1 hsurj x
  obtain ⟨p, rfl⟩ := Quot.exists_rep p
  obtain ⟨I, V, k, hcov, hfreeV⟩ := hfree U
  obtain ⟨i, z', hz'⟩ := exists_index_schemePoint_of_sieve_mem B S hS X V k hcov
    (schemePoint B S hS U₀ p)
  obtain ⟨V', ι, haff', w₀, hw₀⟩ := exists_affine_chart_at B S hS X.1 (V i) z'
  obtain ⟨ιf, ⟨hcolim⟩⟩ := hfreeV i
  set q := schemePointRepresentative B S hS V'.1.left w₀ with hqd
  have hw₀' : (T.map ι.hom.left) w₀ = z' := hw₀
  have hz : (T.map (ι.hom.left ≫ (k i).hom.left)) w₀ = schemePoint B S hS U₀ p := by
    rw [Functor.map_comp]
    change (T.map (k i).hom.left) ((T.map ι.hom.left) w₀) = _
    rw [hw₀']
    exact hz'
  have hqm : pointsMap B S hS _ (yoneda.map (ι.hom.left ≫ (k i).hom.left))
      (q.class B S hS _) = p.class B S hS _ := by
    apply injective_pointsToScheme B S hS U₀
    rw [pointsToScheme_pointsMap]
    change (T.map (ι.hom.left ≫ (k i).hom.left)) (schemePoint B S hS V'.1.left q) = _
    rw [hqd]
    exact (congrArg (fun w => (T.map (ι.hom.left ≫ (k i).hom.left)) w)
      (schemePointRepresentative_point B S hS V'.1.left w₀)).trans hz
  have hm : V'.1.hom = yoneda.map (ι.hom.left ≫ (k i).hom.left) ≫ U.1.hom := by
    rw [Functor.map_comp, Category.assoc, CostructuredArrow.w (k i).hom,
      CostructuredArrow.w ι.hom]
  refine ⟨V', q.class B S hS _, haff', ?_,
    ⟨unitIsoRestrict (smallEtaleRingedSite B S hS X.1 X.2) _ ι
      (@asIso _ _ _ _ (ιf default) (Limits.isIso_cofan_inj_of_unique ιf hcolim))⟩⟩
  have hstep : pointsMap B S hS _ V'.1.hom (q.class B S hS _) =
      pointsMap B S hS _ U.1.hom
        (pointsMap B S hS _ (yoneda.map (ι.hom.left ≫ (k i).hom.left))
          (q.class B S hS _)) :=
    congrArg (fun t => pointsMap B S hS _ t (q.class B S hS _)) hm
  rw [hstep, hqm]
  exact hp

/-- **On an affine étale chart where the invertible module is trivialized, the zero scheme of a
regular section is cut out by a single nonzerodivisor.**  The trivialization turns the section
into a regular function `f` on the chart; the evaluation ideal of Stacks 0845 is then the
principal ideal `(f)`, which is the defining ideal of the zero scheme there, and regularity of
the section is injectivity of multiplication by `f`. -/
theorem exists_isRegular_span_definingIdealAt_zeroScheme_of_unitIso
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (hs : AlgebraicGeometry.IsRegularSection (structurePresheaf B S hS X.1)
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).property s)
    (V : (smallEtaleRingedSite B S hS X.1 X.2).C)
    (hV : IsAffine ((SmallEtale.toSchemes B S hS X.1).obj V).1)
    (e : SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf
        (smallEtaleRingedSite B S hS X.1 X.2).O).over V) ≅ L.over V) :
    ∃ f : Γ((BigFppfOver.toScheme B S hS).obj V.1.left, ⊤),
      IsRegular f ∧
        definingIdealAt B S hS X (zeroScheme B S hS X L s) (op V) = Ideal.span {f} := by
  obtain ⟨Z, hZ⟩ :=
    exists_definingIdealAt_eq_sectionEvaluationIdealAt_of_isInvertible B S hS X L s hinv
  let E := smallEtaleRingedSite B S hS X.1 X.2
  let R := (Stacks.SheafOfModules.Tensor.ringSheaf E.O).obj.obj (op V)
  let : CommRing R := inferInstanceAs (CommRing (E.O.obj.obj (op V)))
  let eRL : L.val.obj (op V) ≃ₗ[R] R :=
    ((SheafOfModules.evaluation ((Stacks.SheafOfModules.Tensor.ringSheaf E.O).over V)
      (op (Over.mk (𝟙 V)))).mapIso e.symm).toLinearEquiv
  have hb : ∀ x : L.val.obj (op V), eRL x • eRL.symm 1 = x := fun x => eRL.injective (by simp)
  have hmul : Function.Injective (fun r : R => r * eRL (s.eval (op V))) :=
    (injective_smul_eval_iff_injective_mul_generator B S hS X L s V
      (eRL.symm 1) eRL.toLinearMap hb).1
      ((isRegularSection_iff_forall_injective_smul B S hS X L s).1 hs (op V))
  refine ⟨eRL (s.eval (op V)), isRegular_of_injective_mul_right hmul, ?_⟩
  rw [definingIdealAt_zeroScheme_eq B S hS X L s Z hZ V hV]
  exact sectionEvaluationIdealAt_eq_span_singleton B S hS X L s V
    (eRL.symm 1) eRL.toLinearMap hb

/-- **The reverse half of Stacks 0846 (4).**  If `s` is a regular section of the invertible
module `L`, then its zero scheme is an effective Cartier divisor.  Invertibility of `L` supplies
a trivialization of `L` on an affine étale chart through every point of `X`; there the zero
scheme is cut out by a single nonzerodivisor, which is condition (4) of Stacks 083C. -/
theorem isEffectiveCartierDivisor_zeroScheme_of_isRegularSection
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L)
    (hs : AlgebraicGeometry.IsRegularSection (structurePresheaf B S hS X.1)
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).property s) :
    IsEffectiveCartierDivisor B S hS X (zeroScheme B S hS X L s) := by
  refine isEffectiveCartierDivisor_of_hasEffectiveCartierEtalePullbacks B S hS X _
    (hasEffectiveCartierEtalePullbacks_of_pointwise_charts B S hS X _ fun x => ?_)
  obtain ⟨V, v, haff, hv, ⟨e⟩⟩ := exists_affine_chart_unitIso_of_isFiniteLocallyFreeOfRank_one
    B S hS X L (isFiniteLocallyFreeOfRank_one_of_isInvertible B S hS X L hinv) x
  obtain ⟨f, hf, hgen⟩ :=
    exists_isRegular_span_definingIdealAt_zeroScheme_of_unitIso B S hS X L s hinv hs V haff e
  exact ⟨V.1.left, V.1.hom, v, isEtale_of_presheaf_etale B S hS V.2, hv,
    isSchemeEffectiveCartierPullback_of_isRegular_span B S hS X _ V haff f hf hgen⟩

/-! ### Part (4) of Stacks 0846 -/

/-- **Stacks 0846 (4).**  Let `X` be an algebraic space over a scheme `S`, let `L` be an
invertible `𝒪_X`-module and let `s` be a global section of `L`.  The zero scheme `Z(s)` of
Stacks 0845 is an effective Cartier divisor on `X` if and only if `s` is a regular section of
`L` in the sense of Stacks 0843.

The hypotheses are the source's own and nothing else: no local freeness of `L` of rank one on a
chart, and no chart data, is assumed.  Invertibility of `L` supplies that data chart by chart,
by Stacks 0B8Q, and both sides of the equivalence are local on the small étale site of `X`, so
the chartwise content of the part can be assembled into the global statement. -/
@[stacks 0846 "part (4): the zero scheme is an effective Cartier divisor exactly when the \
section is regular, with no assumed inputs"]
theorem isEffectiveCartierDivisor_zeroScheme_iff_isRegularSection
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible (structureCommRings B S hS X)
      (structureRingSheaf B S hS X).property L) :
    IsEffectiveCartierDivisor B S hS X (zeroScheme B S hS X L s) ↔
      AlgebraicGeometry.IsRegularSection (structurePresheaf B S hS X.1)
        (Stacks.SheafOfModules.Tensor.ringSheaf
          (smallEtaleRingedSite B S hS X.1 X.2).O).property s :=
  ⟨isRegularSection_of_isEffectiveCartierDivisor_zeroScheme B S hS X L s hinv,
    isEffectiveCartierDivisor_zeroScheme_of_isRegularSection B S hS X L s hinv⟩

