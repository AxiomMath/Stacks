* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

namespace AlgebraicGeometry.Space

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The four conditions of Stacks 083C -/

/-- The inverse image of a closed subspace `D ⊆ X` on a scheme chart `g : h_U ⟶ X` is precisely
the closed subscheme of `U` associated to an effective Cartier ideal sheaf.  This is the
condition "`D ×_X U` is an effective Cartier divisor on `U`" of Stacks 083C (2), (3). -/
def IsSchemeEffectiveCartierPullback (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1) : Prop :=
  ∃ (I : ((BigFppfOver.toScheme B S hS).obj U).IdealSheafData)
      (R : BigFppfOver B S hS) (j : R ⟶ U)
      (e : (BigFppfOver.toScheme B S hS).obj R ≅ I.subscheme),
    Stacks.Divisors.IsEffectiveCartierDivisor I ∧
      (BigFppfOver.toScheme B S hS).map j = e.hom ≫ I.subschemeι ∧
      D.1.preimage g = Subfunctor.range (yoneda.map j)

/-- **Stacks 083C, condition (2).** The inverse image of the closed subspace is an effective
Cartier divisor on one surjective étale scheme chart. -/
def HasEffectiveCartierEtaleCover (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) : Prop :=
  ∃ (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1),
    IsEtale B S hS g ∧ IsSurjective B S hS g ∧
      IsSchemeEffectiveCartierPullback B S hS X D U g

/-- **Stacks 083C, condition (3).** The inverse image of the closed subspace is an effective
Cartier divisor on every étale scheme chart. -/
def HasEffectiveCartierEtalePullbacks (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) : Prop :=
  ∀ (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1),
    IsEtale B S hS g → IsSchemeEffectiveCartierPullback B S hS X D U g

/-- **Stacks 083C, condition (4).** Every point of the closed subspace has an affine étale
neighbourhood of the ambient algebraic space on which the subspace is cut out by a
nonzerodivisor on global sections. -/
def HasAffinePrincipalEtaleNeighborhoods (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) : Prop :=
  ∀ x : points B S hS D.1.toFunctor,
    ∃ (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1)
      (v : points B S hS (yoneda.obj U)),
      IsAffine ((BigFppfOver.toScheme B S hS).obj U) ∧
      IsEtale B S hS g ∧
      pointsMap B S hS (yoneda.obj U) g v =
        pointsMap B S hS D.1.toFunctor D.1.ι x ∧
      ∃ (f : Γ((BigFppfOver.toScheme B S hS).obj U, ⊤))
          (R : BigFppfOver B S hS) (j : R ⟶ U)
          (e : (BigFppfOver.toScheme B S hS).obj R ≅
            (Scheme.IdealSheafData.ofIdealTop (Ideal.span {f})).subscheme),
        IsRegular f ∧
          (BigFppfOver.toScheme B S hS).map j =
            e.hom ≫ (Scheme.IdealSheafData.ofIdealTop (Ideal.span {f})).subschemeι ∧
          D.1.preimage g = Subfunctor.range (yoneda.map j)

/-! ### The inverse image on a chart has exactly one closed-subscheme presentation -/

/-- **The ideal sheaf presenting the inverse image of a closed subspace on a chart is its
kernel.** An ideal sheaf `I` of the scheme `U` presents the subfunctor `D ×_X U` as a closed
subscheme — through an object `R` of the site, a morphism `j : R ⟶ U` whose range is
`D ×_X U`, and an identification of `R` with the subscheme cut out by `I` compatible with `j` —
exactly when `I` is the kernel of pullback of regular functions along the canonical base change
`D ×_X U ⟶ U`.

For the forward direction the canonical base change is itself such a presentation, obtained
from the universal property of the closed immersion `I.subschemeι` with `I = ker`.  For the
converse, the two subfunctor ranges agree, so `j` factors through the canonical base change and
conversely, whence the two kernels agree; and `I` is the kernel of `j` because `j` differs from
`I.subschemeι` by an isomorphism. -/
theorem ker_eq_iff_exists_closedSubschemePresentation (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1)
    (I : ((BigFppfOver.toScheme B S hS).obj U).IdealSheafData) :
    ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd g)).ker = I ↔
      ∃ (R : BigFppfOver B S hS) (j : R ⟶ U)
        (e : (BigFppfOver.toScheme B S hS).obj R ≅ I.subscheme),
        (BigFppfOver.toScheme B S hS).map j = e.hom ≫ I.subschemeι ∧
          D.1.preimage g = Subfunctor.range (yoneda.map j) := by
  set R₀ := D.2.2.rep.pullback g
  set j₀ := D.2.2.rep.snd g
  have hci : _root_.AlgebraicGeometry.IsClosedImmersion
      ((BigFppfOver.toScheme B S hS).map j₀) := D.2.2.property_snd g
  have hpre : D.1.preimage g = Subfunctor.range (yoneda.map j₀) :=
    (range_yoneda_snd_eq_preimage B S hS g D.2.2.rep).symm
  constructor
  · rintro rfl
    have hle : (((BigFppfOver.toScheme B S hS).map j₀).ker).subschemeι.ker =
        ((BigFppfOver.toScheme B S hS).map j₀).ker :=
      Scheme.IdealSheafData.ker_subschemeι _
    have hiso := IsClosedImmersion.isIso_lift
      (((BigFppfOver.toScheme B S hS).map j₀).ker).subschemeι
      ((BigFppfOver.toScheme B S hS).map j₀) hle
    have hfac := IsClosedImmersion.lift_fac
      (((BigFppfOver.toScheme B S hS).map j₀).ker).subschemeι
      ((BigFppfOver.toScheme B S hS).map j₀) hle.le
    exact ⟨R₀, j₀, asIso (IsClosedImmersion.lift
      (((BigFppfOver.toScheme B S hS).map j₀).ker).subschemeι
      ((BigFppfOver.toScheme B S hS).map j₀) hle.le), hfac.symm, hpre⟩
  · rintro ⟨R, j, e, hmap, hran⟩
    have hIeq : ((BigFppfOver.toScheme B S hS).map j).ker = I := by
      rw [hmap, Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_subschemeι]
    have key : ∀ {R₁ R₂ : BigFppfOver B S hS} (k₁ : R₁ ⟶ U) (k₂ : R₂ ⟶ U),
        Subfunctor.range (yoneda.map k₁) = Subfunctor.range (yoneda.map k₂) →
          ((BigFppfOver.toScheme B S hS).map k₂).ker ≤
            ((BigFppfOver.toScheme B S hS).map k₁).ker := by
      intro R₁ R₂ k₁ k₂ h
      obtain ⟨a, rfl⟩ : ∃ a : R₁ ⟶ R₂, a ≫ k₂ = k₁ :=
        show k₁ ∈ (Subfunctor.range (yoneda.map k₂)).obj (op R₁) from
          h ▸ ⟨𝟙 R₁, by simp⟩
      rw [Functor.map_comp]
      exact Scheme.Hom.le_ker_comp _ _
    have hrr := hran.symm.trans hpre
    rw [le_antisymm (key j j₀ hrr) (key j₀ j hrr.symm), hIeq]

/-- **The chart condition of Stacks 083C is a condition on one ideal sheaf.** The inverse image
of a closed subspace on a scheme chart is an effective Cartier divisor exactly when the kernel
of pullback of regular functions along the canonical base change `D ×_X U ⟶ U` is an effective
Cartier ideal sheaf of `U`. -/
theorem isSchemeEffectiveCartierPullback_iff (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1) :
    IsSchemeEffectiveCartierPullback B S hS X D U g ↔
      Stacks.Divisors.IsEffectiveCartierDivisor
        ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd g)).ker := by
  constructor
  · rintro ⟨I, R, j, e, hI, hmap, hran⟩
    rwa [(ker_eq_iff_exists_closedSubschemePresentation B S hS X D U g I).2
      ⟨R, j, e, hmap, hran⟩]
  · intro h
    obtain ⟨R, j, e, hmap, hran⟩ :=
      (ker_eq_iff_exists_closedSubschemePresentation B S hS X D U g _).1 rfl
    exact ⟨_, R, j, e, h, hmap, hran⟩

/-- **Condition (4) of Stacks 083C is a condition on one ideal sheaf.** The affine étale
neighbourhoods it asks for are exactly those on which the kernel of pullback of regular
functions along the canonical base change is generated by a nonzerodivisor on global
sections. -/
theorem hasAffinePrincipalEtaleNeighborhoods_iff (X : AlgebraicSpaces B S hS)
    (D : ClosedSubspaces B S hS X.1) :
    HasAffinePrincipalEtaleNeighborhoods B S hS X D ↔
      ∀ x : points B S hS D.1.toFunctor,
        ∃ (U : BigFppfOver B S hS) (g : yoneda.obj U ⟶ X.1)
          (v : points B S hS (yoneda.obj U)),
          IsAffine ((BigFppfOver.toScheme B S hS).obj U) ∧
          IsEtale B S hS g ∧
          pointsMap B S hS (yoneda.obj U) g v =
            pointsMap B S hS D.1.toFunctor D.1.ι x ∧
          ∃ f : Γ((BigFppfOver.toScheme B S hS).obj U, ⊤),
            IsRegular f ∧
              ((BigFppfOver.toScheme B S hS).map (D.2.2.rep.snd g)).ker =
                Scheme.IdealSheafData.ofIdealTop (Ideal.span {f}) := by
  refine forall_congr' fun x => ?_
  constructor
  · rintro ⟨U, g, v, hU, hg, hv, f, R, j, e, hf, hmap, hran⟩
    exact ⟨U, g, v, hU, hg, hv, f, hf,
      (ker_eq_iff_exists_closedSubschemePresentation B S hS X D U g _).2 ⟨R, j, e, hmap, hran⟩⟩
  · rintro ⟨U, g, v, hU, hg, hv, f, hf, hker⟩
    obtain ⟨R, j, e, hmap, hran⟩ :=
      (ker_eq_iff_exists_closedSubschemePresentation B S hS X D U g _).1 hker
    exact ⟨U, g, v, hU, hg, hv, f, R, j, e, hf, hmap, hran⟩

/-! ### The chart ideal sheaves and the defining ideal of Stacks 083B -/

/-- **On an affine chart the chart ideal sheaf is the defining ideal of Stacks 083B.** The
kernel of pullback of regular functions along the canonical base change `Z ×_X U ⟶ U` is the
ideal sheaf of the global-sections ideal `AlgebraicGeometry.Space.definingIdealAt`.

So the ideal sheaf `𝓘_Z` of Stacks 083B and the chart ideal sheaves appearing in Stacks 083C
are the same data, read on affine charts: the left side is the ideal sheaf of a scheme, the
right side the chart sections of `AlgebraicGeometry.Space.definingIdealSheaf`. -/
theorem ker_rep_snd_eq_ofIdealTop_definingIdealAt (X : AlgebraicSpaces B S hS)
    (Z : ClosedSubspaces B S hS X.1) (U : SmallEtale B S hS X.1)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)] :
    ((BigFppfOver.toScheme B S hS).map (Z.2.2.rep.snd U.1.hom)).ker =
      Scheme.IdealSheafData.ofIdealTop (definingIdealAt B S hS X Z (op U)) := by
  rw [Scheme.ker_of_isAffine, definingIdealAt_eq_ker, Scheme.Γ_map_op]
  rfl

/-! ### Condition (3) implies condition (2) -/

/-- **Stacks 083C, (3) ⟹ (2).** If the inverse image of a closed subspace is an effective
Cartier divisor on every étale scheme chart, then it is so on a surjective étale scheme chart:
an algebraic space has a scheme chart which is surjective and étale after every representable
base change, and such a chart is étale and surjective on points. -/
theorem hasEffectiveCartierEtaleCover_of_hasEffectiveCartierEtalePullbacks
    (X : AlgebraicSpaces B S hS) (D : ClosedSubspaces B S hS X.1)
    (h : HasEffectiveCartierEtalePullbacks B S hS X D) :
    HasEffectiveCartierEtaleCover B S hS X D := by
  obtain ⟨U, f, hfS, hfE⟩ := X.2.exists_atlas
  have hE := isEtale_of_presheaf_etale B S hS hfE
  exact ⟨U, f, hE, isSurjective_of_presheafSurjective B S hS f hfS, h U f hE⟩

end AlgebraicGeometry.Space

end
