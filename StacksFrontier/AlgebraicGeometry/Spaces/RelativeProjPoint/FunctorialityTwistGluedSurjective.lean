module

public import StacksFrontier.AlgebraicGeometry.Spaces.FlatModuleEtaleChartTransport
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjF1Generated
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjPoint.FunctorialityTwistGlued
public import StacksFrontier.AlgebraicGeometry.Spaces.RelativeProjPoint.FunctorialityTwistMapEpi

/-!
# The glued `θ_n` of Stacks 085F is surjective, resp. an isomorphism

For a map `ψ : 𝒜₁ ⟶ 𝒜₂` of quasi-coherent graded `𝒪_X`-algebras on an algebraic space `X`
with `ψ_d` surjective for `d ≫ 0`, the glued map `θ_n : r_ψ^*𝒪_P(n) ⟶ ι^*𝒪_Q(n)` of Stacks 085F
(`AlgebraicGeometry.Space.RelativeProjSituation.twistMap`) is surjective (Stacks 085H (3)), and an
isomorphism when moreover `𝒜₁` is generated by `𝒜₁,₁` over `𝒜₁,₀` (Stacks 085J (3)). Both are
read on the chart of a presentation of `X` (`…IsAtlasMapComp.epi_iff`, `…isIso_iff`), where `θ_n`
is Tag 07ZG's, surjective by Stacks 07ZI (3) and an isomorphism by Stacks 07ZK (3).

## Main results

* `AlgebraicGeometry.Space.RelativeProjSituation.IsGeneratedInDegreeOne.
  isGeneratedInDegreeOneAt_pointAlgebra`: generation in degree one passes to the restriction to
  an étale chart, over its affine opens.
* `AlgebraicGeometry.Space.RelativeProjSituation.epi_twistMap`: Stacks 085H (3), surjectivity.
* `AlgebraicGeometry.Space.RelativeProjSituation.isIso_twistMap`: Stacks 085J (3).
-/

@[expose] public noncomputable section

open CategoryTheory Opposite AlgebraicGeometry Filter
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProjMapDomain

universe u m

namespace AlgebraicGeometry.Space.RelativeProjSituation

attribute [local irreducible] CategoryTheory.yoneda

/-- **Generation in degree one, on the restriction to an étale chart.** If `𝒜` is generated by
`𝒜₁` over `𝒜₀`, so is its restriction `u^*𝒜` to an étale chart `u : U ⟶ X`, over every affine open
of `U`. -/
theorem IsGeneratedInDegreeOne.isGeneratedInDegreeOneAt_pointAlgebra
    {s : RelativeProjSituation.{u, m}} (h : s.IsGeneratedInDegreeOne)
    (V : SmallEtale s.site s.base s.containsBase s.space.1)
    (U : ((BigFppfOver.toScheme s.site s.base s.containsBase).obj V.obj.left).Opens)
    (hU : IsAffineOpen U) :
    (s.shrink.pointAlgebra V.obj.left V.obj.hom).IsGeneratedInDegreeOneAt U := by
  have hf : IsEtale s.site s.base s.containsBase (pointHom V.obj.hom).hom :=
    isEtale_of_presheaf_etale s.site s.base s.containsBase V.2
  let W := (selfOpensFunctor s.site s.base s.containsBase V.obj.left).obj U
  have hW : IsAffine (chartScheme W) :=
    (congrArg (fun Q => IsAffine (chartScheme Q))
      (selfOpensFunctor_obj s.site s.base s.containsBase V.obj.left U)).mpr hU
  have hgen := isGeneratedInDegreeOne_gradedPull s.smallAlgebra (pointHom V.obj.hom) hf V.2.rep W
    (h.smallAlgebra _ hW)
  have := isContinuous_selfOpensFunctor s.site s.base s.containsBase V.obj.left
  exact Stacks.SymGraded.isGeneratedInDegreeOneAt_toSheafGradedAlgebra _ _ _ _ U
    (SheafOfModules.GradedAlgebra.isGeneratedInDegreeOne_pushforward
      (selfOpensStructureMap s.site s.base s.containsBase V.obj.left)
      (etalePointAlgebra s.smallAlgebra V.obj.left V.obj.hom) (op U) hgen)

section Map

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {X : AlgebraicSpaces B S hS}
  {𝒜₁ 𝒜₂ : SheafOfModules.GradedAlgebra.{u, m, u, u + 1} (structureRingSheaf B S hS X)}
  (h₁c : ∀ (i j : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ) (a : (𝒜₁.piece i).val.obj U)
    (b : (𝒜₁.piece j).val.obj U), HEq ((𝒜₁.mul i j).app U a b) ((𝒜₁.mul j i).app U b a))
  (h₁n : ∀ n : ℤ, n < 0 → Limits.IsZero (𝒜₁.piece n))
  (h₁q : ∀ n : ℤ, (𝒜₁.piece n).IsQuasicoherentOnSite)
  (h₁k : ∀ (n : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ),
    HasCardinalLT ↥((𝒜₁.piece n).val.obj U) B.cutoff)
  (h₂c : ∀ (i j : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ) (a : (𝒜₂.piece i).val.obj U)
    (b : (𝒜₂.piece j).val.obj U), HEq ((𝒜₂.mul i j).app U a b) ((𝒜₂.mul j i).app U b a))
  (h₂n : ∀ n : ℤ, n < 0 → Limits.IsZero (𝒜₂.piece n))
  (h₂q : ∀ n : ℤ, (𝒜₂.piece n).IsQuasicoherentOnSite)
  (h₂k : ∀ (n : ℤ) (U : (SmallEtale B S hS X.1)ᵒᵖ),
    HasCardinalLT ↥((𝒜₂.piece n).val.obj U) B.cutoff)
  (ψ : SheafOfModules.GradedAlgebra.UnitalHom 𝒜₁ 𝒜₂)

local notation "𝔰₁" => RelativeProjSituation.mk B S hS X 𝒜₁ h₁c h₁n h₁q h₁k

/-- **Stacks 085H (3), surjectivity: the maps `θ : r_ψ^*𝒪_P(n) ⟶ 𝒪_Q(n)` are surjective** when
`ψ_d` is surjective for `d ≫ 0`. -/
@[stacks 085H "(3), first half: the maps θ : r_ψ^*O_P(n) → O_Q(n) are surjective \
(θ the glued map of 085F, twistMap), for ψ_d surjective for d ≫ 0"]
theorem epi_twistMap
    (hsurj : ∀ᶠ d : ℕ in atTop, Presheaf.IsLocallySurjective (SmallEtale.topology B S hS X.1)
      ((PresheafOfModules.toPresheaf _).map (ψ.app (d : ℤ)).val))
    (Px : Presentation B S hS X.1 X.2) (n : ℤ) :
    Epi (twistMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ Px n) :=
  epi_of_isDescendedChartHom_twistChartMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ hsurj Px n
    (isDescendedChartHom_twistMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ Px n)

/-- **Stacks 085J (3): the maps `θ : r_ψ^*𝒪_P(n) ⟶ 𝒪_Q(n)` are isomorphisms** when `ψ_d` is
surjective for `d ≫ 0` and `𝒜₁` is generated by its degree-one part over its degree-zero part. -/
@[stacks 085J "(3): the maps θ : r_ψ^*O_P(n) → O_Q(n) are isomorphisms (θ the glued map of 085F,
twistMap), for ψ_d surjective for d ≫ 0 and A generated by A_1 over A_0"]
theorem isIso_twistMap
    (hsurj : ∀ᶠ d : ℕ in atTop, Presheaf.IsLocallySurjective (SmallEtale.topology B S hS X.1)
      ((PresheafOfModules.toPresheaf _).map (ψ.app (d : ℤ)).val))
    (hgen : (𝔰₁).IsGeneratedInDegreeOne) (Px : Presentation B S hS X.1 X.2) (n : ℤ) :
    IsIso (twistMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ Px n) := by
  have hχ := isDescendedChartHom_twistMap h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ Px n
  unfold RelativeProjHomPoints.IsDescendedChartHom RelativeProjHomPoints.IsChartHom at hχ
  refine (@Presentation.IsAtlasMapComp.isIso_iff _ _ _ _ _ _ _ _ _ _ _ _ _ hχ
    (Iso.isIso_hom _)).2 ?_
  exact RelativeProjHomPoints.isIso_equivalence_map_chartTwistMap _ Px.U Px.toSpace n _ _ _ _ _ _
    (Stacks.AlgebraicGeometry.Tag07ZGTwist.isIso_relativeTwistMap_of_generatedInDegreeOne _
      (hsurj.mono fun d hd =>
        epi_restrictHom_app h₁c h₁n h₁q h₁k h₂c h₂n h₂q h₂k ψ d hd Px.U Px.toSpace)
      (fun U hU => hgen.isGeneratedInDegreeOneAt_pointAlgebra
        (etaleChartOfIsEtale B S hS (X := X) Px.toSpace
          ((isEtale_iff_presheaf_of_yoneda B S hS Px.toSpace).2 Px.etale)) U hU) n)

end Map

end AlgebraicGeometry.Space.RelativeProjSituation

end
