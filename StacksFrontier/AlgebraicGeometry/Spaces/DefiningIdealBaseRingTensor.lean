module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SubmoduleFactorThru
public import StacksFrontier.AlgebraicGeometry.Spaces.BaseIdealSheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.BaseRingTensorModulePullback
public import StacksFrontier.AlgebraicGeometry.Spaces.ConormalModuleBaseChange
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeOnSiteAffineCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.IdentityMorphismProperties
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedClosedSubspaceIdeal

/-!
# The ideal of `X ×_{T'} T ⊆ X` is `𝒪_X ⊗_{R'} I` for flat `X ⟶ T'`

Let `T'` be an affine object of the big fppf site, `R' = Γ(T', 𝒪_{T'})`, and let `j : T ⟶ T'`
be a closed immersion with kernel `I = Ker(R' → Γ(T, 𝒪_T))`.  For a morphism `g : X ⟶ T'` of
algebraic spaces the inverse image `g⁻¹(T) = X ×_{T'} T` is a closed subspace of `X`.  This file
proves that when `g` is flat its defining ideal sheaf is the base-ring tensor product
`𝒪_X ⊗_{R'} I` of [Stacks Project, Tag 0D3F], the identification being the map
`𝒪_X ⊗_{R'} I ⟶ 𝒪_X ⊗_{R'} R' = 𝒪_X` induced by the inclusion `I ⊆ R'`
(`AlgebraicGeometry.Space.baseIdealMap`).

In the body of [Stacks Project, Tag 0D3X] this is the kernel of `𝒪_{Xₙ} ⟶ 𝒪_{X₁}` for the flat
family `Xₙ ⟶ Spec(Rₙ)` and `X₁ = Xₙ ×_{Spec(Rₙ)} Spec(R₁)`: it is `𝒪_{Xₙ} ⊗_{Rₙ} Iₙ`, which the
source writes `𝒪_{X₁} ⊗_{R₁} Iₙ`, `Iₙ` being killed by `Iₙ`.

## Proof

The map `𝒪_X ⊗_{R'} I ⟶ 𝒪_X` is a monomorphism by flatness
(`AlgebraicGeometry.Space.mono_baseRingTensorModule_map`).  It factors through the defining
ideal `𝓘`: by the mapping property of `𝒪_X ⊗_{R'} -` it is determined by the global functions
`g^♯ x`, `x ∈ I`, and these vanish on `g⁻¹(T)` because `g⁻¹(T) ⟶ T' ` factors through `T`
(`AlgebraicGeometry.Space.globalFunctionsOfMap_mem_definingIdealAt`).  The factorisation is an
epimorphism because on an affine étale chart `V` of `X` the defining ideal is generated by the
pullback of `I` (`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`), so every section of
`𝓘` over `V` is a combination of the sections `g^♯ x`, which lie in the image; and the affine
charts cover.

## Main definitions

* `AlgebraicGeometry.Space.closedSubspaceBaseIdeal`: the ideal `I ⊆ Γ(T', 𝒪_{T'})` of a closed
  subspace of `T'`, which for the subspace cut out by a closed immersion `j : T ⟶ T'` is
  `Ker(Γ(T', 𝒪) → Γ(T, 𝒪))` (`AlgebraicGeometry.Space.closedSubspaceBaseIdeal_rangeSubspace`).
* `AlgebraicGeometry.Space.baseRingTensorModuleSelfHom`: the isomorphism `𝒪_X ⊗_R R ⟶ 𝒪_X`
  corresponding to `r ↦ r · 1`.
* `AlgebraicGeometry.Space.baseRingTensorPreimageIdealHom`: the morphism `𝒪_X ⊗_{R'} I ⟶ 𝓘`.
* `AlgebraicGeometry.Space.definingIdealSheafPreimageIso`: **`𝒪_X ⊗_{R'} I ≅ 𝓘_{g⁻¹(T)}`** for
  flat `g` and affine `T'`.
* `AlgebraicGeometry.Space.conormalModuleRangeIso`: the conormal module of `T ⊆ T'`, read on `T`,
  is `𝒪_T ⊗_{R'} I`.

## Main results

* `AlgebraicGeometry.Space.baseRingTensorPreimageIdealHom_ι`: composed with the inclusion of the
  ideal, `𝒪_X ⊗_{R'} I ⟶ 𝓘` is `𝒪_X ⊗_{R'} I ⟶ 𝒪_X ⊗_{R'} R' ≅ 𝒪_X`.
* `AlgebraicGeometry.Space.mono_baseRingTensorPreimageIdealHom` (flatness) and
  `AlgebraicGeometry.Space.epi_baseRingTensorPreimageIdealHom` (local generation).

## References

* [Stacks Project, Tag 0D3X](https://stacks.math.columbia.edu/tag/0D3X)
* [Stacks Project, Tag 0D3F](https://stacks.math.columbia.edu/tag/0D3F)
* [Stacks Project, Tag 04CN](https://stacks.math.columbia.edu/tag/04CN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.Cohomology.SiteModules

universe u

/- The global instance `Abelian (SheafOfModules.{max u v r w} O)` leaves a stuck universe
constraint against the `𝒪_X`-modules at the universe of the schemes. -/
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

section SelfHom

variable (X : AlgebraicSpaces B S hS) {R : Type u} [CommRing R]
  (φ : R →+* modelGlobalFunctions B S hS X)

/-- The global function `1` of `X`, as a global section of `𝒪_X` read on the model. -/
def unitGlobalSection : (baseRingGlobalSectionsModule B S hS X φ).obj (unitModule B S hS X.2) :=
  (modelSectionsHomEquiv B S hS X φ (unitModule B S hS X.2)).symm (𝟙 _)

/-- **The morphism `𝒪_X ⊗_R R ⟶ 𝒪_X`** corresponding, by the mapping property of `𝒪_X ⊗_R -`,
to the `R`-linear map `r ↦ r · 1`. It is an isomorphism,
`AlgebraicGeometry.Space.isIso_baseRingTensorModuleSelfHom`. -/
def baseRingTensorModuleSelfHom :
    (baseRingTensorModule B S hS X φ).obj (ModuleCat.of R R) ⟶ unitModule B S hS X.2 :=
  ((baseRingTensorModuleAdjunction B S hS X φ).homEquiv _ _).symm
    ((ModuleCat.selfHomEquiv R _).symm (unitGlobalSection B S hS X φ))

/-- Precomposition with `AlgebraicGeometry.Space.baseRingTensorModuleSelfHom` carries a morphism
`v : 𝒪_X ⟶ F` to the morphism out of `𝒪_X ⊗_R R` attached to the global section `v(1)`. -/
theorem selfHomEquiv_homEquiv_baseRingTensorModuleSelfHom_comp
    (F : Modules.{u, u} B S hS X.1 X.2) (v : unitModule B S hS X.2 ⟶ F) :
    ModuleCat.selfHomEquiv R _ ((baseRingTensorModuleAdjunction B S hS X φ).homEquiv _ _
        (baseRingTensorModuleSelfHom B S hS X φ ≫ v)) =
      (modelSectionsHomEquiv B S hS X φ F).symm v := by
  rw [Adjunction.homEquiv_naturality_right, baseRingTensorModuleSelfHom, Equiv.apply_symm_apply]
  change ((baseRingGlobalSectionsModule B S hS X φ).map v).hom
      (((ModuleCat.selfHomEquiv R _).symm (unitGlobalSection B S hS X φ)).hom 1) = _
  rw [show ((ModuleCat.selfHomEquiv R ((baseRingGlobalSectionsModule B S hS X φ).obj
      (unitModule B S hS X.2))).symm (unitGlobalSection B S hS X φ)).hom 1 =
      unitGlobalSection B S hS X φ from
      (ModuleCat.selfHomEquiv R ((baseRingGlobalSectionsModule B S hS X φ).obj
        (unitModule B S hS X.2))).apply_symm_apply (unitGlobalSection B S hS X φ),
    unitGlobalSection, ← modelSectionsHomEquiv_symm_naturality, Category.id_comp]

/-- **`𝒪_X ⊗_R R ≅ 𝒪_X`**: `AlgebraicGeometry.Space.baseRingTensorModuleSelfHom` is an
isomorphism, both objects corepresenting global sections. -/
instance isIso_baseRingTensorModuleSelfHom : IsIso (baseRingTensorModuleSelfHom B S hS X φ) := by
  refine isIso_of_coyoneda_map_bijective _ fun F => ?_
  have key : (fun v : unitModule B S hS X.2 ⟶ F => baseRingTensorModuleSelfHom B S hS X φ ≫ v) =
      (((baseRingTensorModuleAdjunction B S hS X φ).homEquiv _ _).trans
        (ModuleCat.selfHomEquiv R _)).symm ∘ (modelSectionsHomEquiv B S hS X φ F).symm := by
    funext v
    apply (((baseRingTensorModuleAdjunction B S hS X φ).homEquiv _ _).trans
      (ModuleCat.selfHomEquiv R _)).injective
    rw [Function.comp_apply, Equiv.apply_symm_apply]
    exact selfHomEquiv_homEquiv_baseRingTensorModuleSelfHom_comp B S hS X φ F v
  rw [key]
  exact (Equiv.bijective _).comp (Equiv.bijective _)

end SelfHom

section UnitModuleMul

variable (X : AlgebraicSpaces B S hS)

/-- Two endomorphisms of `𝒪_X` agreeing on every chart ring are equal. -/
private theorem unitModule_hom_ext {f g : unitModule B S hS X.2 ⟶ unitModule B S hS X.2}
    (h : ∀ (V : SmallEtale B S hS X.1) (x : chartRing B S hS X.1 X.2 V),
      f.val.app (op V) x = g.val.app (op V) x) : f = g :=
  SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U =>
    ModuleCat.hom_ext (LinearMap.ext fun x => h U.unop x))

/-- Multiplication by a global function `e` acts on a chart ring as multiplication by `e`. -/
private theorem unitModuleMul_val_app_eq_mul
    (e : GlobalFunctionRing (structureSheaf B S hS X.1 X.2)) (V : SmallEtale B S hS X.1)
    (y : chartRing B S hS X.1 X.2 V) :
    (unitModuleMul B S hS X e).val.app (op V) y =
      y * (show chartRing B S hS X.1 X.2 V from e.1 (op V)) := by
  rw [unitModule_hom_val_app B S hS X (unitModuleMul B S hS X e) V y, unitModuleMul_val_app_one]
  rfl

/-- Multiplication by a sum of global functions is the sum of the multiplications. -/
theorem unitModuleMul_add (c d : GlobalFunctionRing (structureSheaf B S hS X.1 X.2)) :
    unitModuleMul B S hS X (c + d) = unitModuleMul B S hS X c + unitModuleMul B S hS X d := by
  refine unitModule_hom_ext B S hS X fun V x => ?_
  change _ = (unitModuleMul B S hS X c).val.app (op V) x +
    (unitModuleMul B S hS X d).val.app (op V) x
  rw [unitModuleMul_val_app_eq_mul, unitModuleMul_val_app_eq_mul, unitModuleMul_val_app_eq_mul]
  exact mul_add (R := chartRing B S hS X.1 X.2 V) _ _ _

/-- Multiplication by a product of global functions is the composite of the multiplications. -/
theorem unitModuleMul_mul (c d : GlobalFunctionRing (structureSheaf B S hS X.1 X.2)) :
    unitModuleMul B S hS X (c * d) = unitModuleMul B S hS X c ≫ unitModuleMul B S hS X d := by
  refine unitModule_hom_ext B S hS X fun V x => ?_
  change _ = (unitModuleMul B S hS X d).val.app (op V) ((unitModuleMul B S hS X c).val.app (op V) x)
  rw [unitModuleMul_val_app_eq_mul, unitModuleMul_val_app_eq_mul, unitModuleMul_val_app_eq_mul,
    mul_assoc]
  rfl

end UnitModuleMul

section Ideal

variable {W : AlgebraicSpaces B S hS} {T : BigFppfOver B S hS} (g : W ⟶ schemeSpace T)
  (Z : ClosedSubspaces B S hS (schemeSpace T).1)

/-- The ideal of `Γ(T, 𝒪_T)` of the closed subspace `Z` of `T`: its defining ideal at the
identity chart of `T`. -/
def closedSubspaceBaseIdeal : Ideal (baseRing B S hS T) :=
  definingIdealAt B S hS (schemeSpace T) Z (op (selfChart B S hS T))

/-- The ideal of `Γ(T, 𝒪_T)` of `Z` is the kernel of pullback of functions to the base change of
`Z` along the identity chart of `T`. -/
theorem closedSubspaceBaseIdeal_eq_ker :
    closedSubspaceBaseIdeal B S hS Z = RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map
      (Z.2.2.rep.snd (selfChart B S hS T).1.hom)).op).hom :=
  definingIdealAt_eq_ker B S hS (schemeSpace T) Z (selfChart B S hS T)

/-- A morphism of the site whose range is contained in that of `n` kills every function `n`
kills: it factors through `n`. -/
theorem ker_Γ_map_le_of_range_le {a b c : BigFppfOver B S hS} (m : a ⟶ c) (n : b ⟶ c)
    (h : Subfunctor.range (yoneda.map m) ≤ Subfunctor.range (yoneda.map n)) :
    RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map n).op).hom ≤
      RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map m).op).hom := by
  obtain ⟨v, hv⟩ := h (op a)
    (⟨𝟙 a, by simp⟩ : m ∈ (Subfunctor.range (yoneda.map m)).obj (op a))
  have hvm : v ≫ n = m := hv
  exact hvm ▸ ker_le_ker_comp B S hS v n

/-- A closed subscheme `T' ⟶ T` of an object of the site, as a closed subspace of the algebraic
space `T`: `AlgebraicGeometry.Space.closedSubspaceRange`, spelled over `schemeSpace T`. -/
abbrev rangeSubspace {T' : BigFppfOver B S hS} (i : T' ⟶ T)
    (hi : AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map i)) :
    ClosedSubspaces B S hS (schemeSpace T).1 :=
  closedSubspaceRange B S hS i hi

/-- **The ideal of a closed subscheme of `T`, read as a closed subspace, is the kernel of
`Γ(T, 𝒪_T) ⟶ Γ(T', 𝒪_{T'})`.** -/
theorem closedSubspaceBaseIdeal_rangeSubspace {T' : BigFppfOver B S hS} (i : T' ⟶ T)
    (hi : AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map i)) :
    closedSubspaceBaseIdeal B S hS (rangeSubspace B S hS i hi) =
      RingHom.ker (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map i).op).hom := by
  rw [closedSubspaceBaseIdeal_eq_ker]
  have h : Subfunctor.range (yoneda.map ((rangeSubspace B S hS i hi).2.2.rep.snd
      (selfChart B S hS T).1.hom)) = Subfunctor.range (yoneda.map i) :=
    (range_yoneda_snd_eq_preimage B S hS _ _).trans (Subfunctor.preimage_id _)
  exact le_antisymm (ker_Γ_map_le_of_range_le B S hS _ _ h.ge)
    (ker_Γ_map_le_of_range_le B S hS _ _ h.le)

/-- **The pullback of a function vanishing on `Z` vanishes on `g⁻¹(Z)`.** -/
theorem globalFunctionsOfMap_mem_definingIdealAt (a : baseRing B S hS T)
    (ha : a ∈ closedSubspaceBaseIdeal B S hS Z) (U : SmallEtale B S hS W.1) :
    (globalFunctionsOfMap g a).1 (op U) ∈
      definingIdealAt B S hS W (preimageSubspace B S hS g Z) (op U) :=
  mem_definingIdealAt_chartDiagramPullback B S hS (preimageSubspace B S hS g Z) Z g
    (preimageProjection B S hS g Z) (conormalEtaleRestrictionSquare B S hS g Z)
    (chartDiagramToBase B S hS g U) a ha

/-- The defining ideal sheaf of `g⁻¹(Z)`. -/
abbrev preimageIdeal : Modules.{u, u} B S hS W.1 W.2 :=
  (definingIdealSheaf B S hS W (preimageSubspace B S hS g Z)).toSheafOfModules

/-- The inclusion of the defining ideal of `g⁻¹(Z)` into `𝒪_W`. -/
abbrev preimageIdealι : preimageIdeal B S hS g Z ⟶ unitModule B S hS W.2 :=
  (definingIdealSheaf B S hS W (preimageSubspace B S hS g Z)).ι

/-- The inclusion of the defining ideal of `g⁻¹(Z)` into `𝒪_W` is a monomorphism. -/
instance : Mono (preimageIdealι B S hS g Z) :=
  ⟨fun _ _ h => SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U =>
    ModuleCat.hom_ext (LinearMap.ext fun x => Subtype.ext
      (congrArg (fun k => (k.val.app U).hom x) h)))⟩

/-- Multiplication by the pullback of a function vanishing on `Z` takes values in the defining
ideal of `g⁻¹(Z)`. -/
theorem unitModuleMul_val_app_mem (a : closedSubspaceBaseIdeal B S hS Z)
    (V : SmallEtale B S hS W.1) (x : chartRing B S hS W.1 W.2 V) :
    (unitModuleMul B S hS W (globalFunctionsOfMap g a.1)).val.app (op V) x ∈
      definingIdealAt B S hS W (preimageSubspace B S hS g Z) (op V) := by
  rw [unitModule_hom_val_app B S hS W _ V x, unitModuleMul_val_app_one]
  exact Ideal.mul_mem_left _ x (globalFunctionsOfMap_mem_definingIdealAt B S hS g Z a.1 a.2 V)

/-- Multiplication by the pullback of a function `a` vanishing on `Z`, as a morphism from `𝒪_W`
to the defining ideal of `g⁻¹(Z)`. -/
def preimageIdealSection (a : closedSubspaceBaseIdeal B S hS Z) :
    unitModule B S hS W.2 ⟶ preimageIdeal B S hS g Z :=
  (definingIdealSheaf B S hS W (preimageSubspace B S hS g Z)).factorThru
    (unitModuleMul B S hS W (globalFunctionsOfMap g a.1))
    (fun U x => unitModuleMul_val_app_mem B S hS g Z a U.unop x)

/-- Composed with the inclusion of the ideal, `preimageIdealSection` is multiplication by the
pullback of `a`. -/
@[reassoc (attr := simp)]
theorem preimageIdealSection_ι (a : closedSubspaceBaseIdeal B S hS Z) :
    preimageIdealSection B S hS g Z a ≫ preimageIdealι B S hS g Z =
      unitModuleMul B S hS W (globalFunctionsOfMap g a.1) :=
  SheafOfModules.Submodule.factorThru_ι _ _ _

/-- `preimageIdealSection` is additive in `a`. -/
theorem preimageIdealSection_add (a b : closedSubspaceBaseIdeal B S hS Z) :
    preimageIdealSection B S hS g Z (a + b) =
      preimageIdealSection B S hS g Z a + preimageIdealSection B S hS g Z b := by
  refine (cancel_mono (preimageIdealι B S hS g Z)).1 ?_
  refine (preimageIdealSection_ι B S hS g Z _).trans (Eq.trans ?_
    ((Preadditive.add_comp _ _ _ _ _ _).trans (congrArg₂ (· + ·)
      (preimageIdealSection_ι B S hS g Z a) (preimageIdealSection_ι B S hS g Z b))).symm)
  exact (congrArg (fun x => unitModuleMul B S hS W (globalFunctionsOfMap g x))
    (Submodule.coe_add a b)).trans ((congrArg (unitModuleMul B S hS W)
      (map_add (globalFunctionsOfMap g) a.1 b.1)).trans (unitModuleMul_add B S hS W _ _))

/-- `preimageIdealSection` of `r • a` is `preimageIdealSection` of `a` precomposed with
multiplication by the pullback of `r`. -/
theorem preimageIdealSection_smul (r : baseRing B S hS T) (a : closedSubspaceBaseIdeal B S hS Z) :
    preimageIdealSection B S hS g Z (r • a) =
      unitModuleMul B S hS W (globalFunctionsOfMap g r) ≫ preimageIdealSection B S hS g Z a := by
  refine (cancel_mono (preimageIdealι B S hS g Z)).1 ?_
  refine (preimageIdealSection_ι B S hS g Z _).trans (Eq.trans ?_
    ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·)
      (preimageIdealSection_ι B S hS g Z a))).symm)
  exact (congrArg (fun x => unitModuleMul B S hS W (globalFunctionsOfMap g x))
    (Submodule.coe_smul r a)).trans ((congrArg (unitModuleMul B S hS W)
      (map_mul (globalFunctionsOfMap g) r a.1)).trans (unitModuleMul_mul B S hS W _ _))

/-- The functions of `I` pulled back to `W`, as global sections of the defining ideal of
`g⁻¹(Z)`. -/
def preimageIdealGlobalSectionsLinearMap :
    closedSubspaceBaseIdeal B S hS Z →ₗ[baseRing B S hS T]
      (baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).obj
        (preimageIdeal B S hS g Z) where
  toFun a := (modelSectionsHomEquiv B S hS W (baseRingHomOfMap g) _).symm
    (preimageIdealSection B S hS g Z a)
  map_add' a b := by
    simp only [preimageIdealSection_add, modelSectionsHomEquiv_symm_add]
  map_smul' r a := by
    simp only [preimageIdealSection_smul, modelSectionsHomEquiv_symm_comp, RingHom.id_apply]

/-- `AlgebraicGeometry.Space.preimageIdealGlobalSectionsLinearMap` as a morphism of modules. -/
def preimageIdealGlobalSections :
    ModuleCat.of (baseRing B S hS T) (closedSubspaceBaseIdeal B S hS Z) ⟶
      (baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).obj
        (preimageIdeal B S hS g Z) :=
  ModuleCat.ofHom (X := closedSubspaceBaseIdeal B S hS Z)
    (Y := (baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).obj
      (preimageIdeal B S hS g Z)) (preimageIdealGlobalSectionsLinearMap B S hS g Z)

/-- **The morphism `𝒪_W ⊗_{R} I ⟶ 𝓘_{g⁻¹(Z)}`**, `R = Γ(T, 𝒪_T)`, attached by the mapping property
of `𝒪_W ⊗_R -` to the pullbacks of the functions of `I`. -/
def baseRingTensorPreimageIdealHom :
    (baseRingTensorModule B S hS W (baseRingHomOfMap g)).obj
        (ModuleCat.of (baseRing B S hS T) (closedSubspaceBaseIdeal B S hS Z)) ⟶
      preimageIdeal B S hS g Z :=
  ((baseRingTensorModuleAdjunction B S hS W _).homEquiv _ _).symm
    (preimageIdealGlobalSections B S hS g Z)

/-- `preimageIdealGlobalSections` sends `a` to the global section corresponding to
`preimageIdealSection` of `a`. -/
theorem preimageIdealGlobalSections_apply (a : closedSubspaceBaseIdeal B S hS Z) :
    (preimageIdealGlobalSections B S hS g Z).hom a =
      (modelSectionsHomEquiv B S hS W (baseRingHomOfMap g) _).symm
        (preimageIdealSection B S hS g Z a) :=
  rfl

/-- Composed with the inclusion of the ideal, `preimageIdealGlobalSections` sends `a ∈ I` to `a`
times the unit global section of `𝒪_W`. -/
theorem preimageIdealGlobalSections_comp_map_ι :
    preimageIdealGlobalSections B S hS g Z ≫
        (baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).map
          (preimageIdealι B S hS g Z) =
      ModuleCat.ofHom (closedSubspaceBaseIdeal B S hS Z).subtype ≫
        (ModuleCat.selfHomEquiv (baseRing B S hS T)
          ((baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).obj
            (unitModule B S hS W.2))).symm (unitGlobalSection B S hS W (baseRingHomOfMap g)) := by
  refine ModuleCat.hom_ext (LinearMap.ext fun a => ?_)
  change ((baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).map
      (preimageIdealι B S hS g Z)).hom ((preimageIdealGlobalSections B S hS g Z).hom a) =
    ((ModuleCat.selfHomEquiv (baseRing B S hS T)
      ((baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).obj
        (unitModule B S hS W.2))).symm (unitGlobalSection B S hS W (baseRingHomOfMap g))).hom a.1
  refine (congrArg ((baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).map
    (preimageIdealι B S hS g Z)).hom (preimageIdealGlobalSections_apply B S hS g Z a)).trans ?_
  refine (modelSectionsHomEquiv_symm_naturality B S hS W _ (preimageIdealι B S hS g Z)
    _).symm.trans ?_
  refine (congrArg (modelSectionsHomEquiv B S hS W (baseRingHomOfMap g) _).symm
    ((preimageIdealSection_ι B S hS g Z a).trans (Category.comp_id _).symm)).trans ?_
  exact modelSectionsHomEquiv_symm_comp B S hS W g (unitModule B S hS W.2) a.1 (𝟙 _)

/-- Composed with the inclusion of the ideal, the morphism `𝒪_W ⊗_R I ⟶ 𝓘` is the morphism
`𝒪_W ⊗_R I ⟶ 𝒪_W ⊗_R R ≅ 𝒪_W` induced by the inclusion `I ⊆ R`. -/
theorem baseRingTensorPreimageIdealHom_ι :
    baseRingTensorPreimageIdealHom B S hS g Z ≫
        preimageIdealι B S hS g Z =
      (baseRingTensorModule B S hS W (baseRingHomOfMap g)).map
          (ModuleCat.ofHom (closedSubspaceBaseIdeal B S hS Z).subtype) ≫
        baseRingTensorModuleSelfHom B S hS W (baseRingHomOfMap g) := by
  apply ((baseRingTensorModuleAdjunction B S hS W _).homEquiv _ _).injective
  rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_left,
    baseRingTensorPreimageIdealHom, Equiv.apply_symm_apply, baseRingTensorModuleSelfHom,
    Equiv.apply_symm_apply]
  exact preimageIdealGlobalSections_comp_map_ι B S hS g Z

/-- For flat `g` and affine `T` the morphism `𝒪_W ⊗_R I ⟶ 𝓘` is a monomorphism. -/
theorem mono_baseRingTensorPreimageIdealHom (hg : IsFlat B S hS g.hom)
    (hT : IsAffine ((BigFppfOver.toScheme B S hS).obj T)) :
    Mono (baseRingTensorPreimageIdealHom B S hS g Z) := by
  have hm : Mono ((baseRingTensorModule B S hS W (baseRingHomOfMap g)).map
      (ModuleCat.ofHom (closedSubspaceBaseIdeal B S hS Z).subtype)) :=
    mono_baseRingTensorModule_map g hg hT _ Subtype.val_injective
  have : Mono (baseRingTensorPreimageIdealHom B S hS g Z ≫ preimageIdealι B S hS g Z) := by
    rw [baseRingTensorPreimageIdealHom_ι]
    have hi := isIso_baseRingTensorModuleSelfHom B S hS W (baseRingHomOfMap g)
    exact mono_comp' hm (IsIso.mono_of_iso _)
  exact mono_of_mono _ (preimageIdealι B S hS g Z)

/-- The global section `a ∈ I` of `𝒪_W ⊗_R I`, read as a morphism out of `𝒪_W`, is carried by
`𝒪_W ⊗_R I ⟶ 𝓘 ⊆ 𝒪_W` to multiplication by the pullback of `a`. -/
theorem modelSectionsHomEquiv_unit_comp_baseRingTensorPreimageIdealHom_ι
    (a : closedSubspaceBaseIdeal B S hS Z) :
    modelSectionsHomEquiv B S hS W (baseRingHomOfMap g) _
        (((baseRingTensorModuleAdjunction B S hS W (baseRingHomOfMap g)).unit.app
          (ModuleCat.of _ (closedSubspaceBaseIdeal B S hS Z))).hom a) ≫
      (baseRingTensorPreimageIdealHom B S hS g Z ≫ preimageIdealι B S hS g Z) =
      unitModuleMul B S hS W (globalFunctionsOfMap g a.1) := by
  have key : (baseRingTensorModuleAdjunction B S hS W (baseRingHomOfMap g)).unit.app
        (ModuleCat.of _ (closedSubspaceBaseIdeal B S hS Z)) ≫
      (baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).map
        (baseRingTensorPreimageIdealHom B S hS g Z ≫ preimageIdealι B S hS g Z) =
      ModuleCat.ofHom (closedSubspaceBaseIdeal B S hS Z).subtype ≫
        (ModuleCat.selfHomEquiv (baseRing B S hS T)
          ((baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).obj
            (unitModule B S hS W.2))).symm (unitGlobalSection B S hS W (baseRingHomOfMap g)) := by
    refine ((baseRingTensorModuleAdjunction B S hS W _).homEquiv_unit _ _ _).symm.trans ?_
    rw [Adjunction.homEquiv_naturality_right, baseRingTensorPreimageIdealHom]
    exact (congrArg (· ≫ (baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).map
      (preimageIdealι B S hS g Z)) (Equiv.apply_symm_apply _ _)).trans
      (preimageIdealGlobalSections_comp_map_ι B S hS g Z)
  have hk : ((baseRingGlobalSectionsModule B S hS W (baseRingHomOfMap g)).map
        (baseRingTensorPreimageIdealHom B S hS g Z ≫ preimageIdealι B S hS g Z)).hom
        (((baseRingTensorModuleAdjunction B S hS W (baseRingHomOfMap g)).unit.app
          (ModuleCat.of _ (closedSubspaceBaseIdeal B S hS Z))).hom a) =
      a.1 • unitGlobalSection B S hS W (baseRingHomOfMap g) :=
    congrArg (fun k => k.hom a) key
  refine (modelSectionsHomEquiv_naturality B S hS W _ _ _).symm.trans ?_
  refine (congrArg (modelSectionsHomEquiv B S hS W (baseRingHomOfMap g) _) hk).trans ?_
  refine (modelSectionsHomEquiv_smul B S hS W g _ a.1 _).trans ?_
  refine (congrArg (unitModuleMul B S hS W (globalFunctionsOfMap g a.1) ≫ ·)
    (Equiv.apply_symm_apply _ _)).trans ?_
  exact Category.comp_id _

/-- **The morphism `𝒪_W ⊗_R I ⟶ 𝓘` is an epimorphism**, for affine `T`: on an affine étale chart
`V` of `W` the defining ideal of `g⁻¹(Z)` is generated by the pullbacks of the functions of `I`
(`AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map_chartDiagram`), which are the images of
global sections of `𝒪_W ⊗_R I`, and the affine charts cover. -/
theorem epi_baseRingTensorPreimageIdealHom
    (hT : IsAffine ((BigFppfOver.toScheme B S hS).obj T)) :
    Epi (baseRingTensorPreimageIdealHom B S hS g Z) := by
  refine Stacks.SheafOfModules.EpiMono.epi_of_isLocallySurjective _ ⟨fun {U} s => ?_⟩
  refine GrothendieckTopology.superset_covering _ ?_
    (SmallEtale.ofArrows_openChart_affineOpens_mem B S hS W.1 U)
  refine (Sieve.generate_le_iff _ _).2 ?_
  rintro _ _ ⟨O⟩
  set V := openChart B S hS W.1 U O.down.1
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj V.1.left) := O.down.2
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj
    (chartDiagramToBase B S hS g V).U.obj.left) := O.down.2
  set d := chartDiagramToBase B S hS g V
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj d.V.obj.left) := hT
  set s' := (preimageIdeal B S hS g Z).val.map (openChartInclusion B S hS W.1 U O.down.1).op s
  have hx : (preimageIdealι B S hS g Z).val.app (op V) s' ∈
      Ideal.map (chartDiagramPullback B S hS g d).hom (closedSubspaceBaseIdeal B S hS Z) := by
    have hs : (preimageIdealι B S hS g Z).val.app (op V) s' ∈
        definingIdealAt B S hS W (preimageSubspace B S hS g Z) (op d.U) := s'.2
    rwa [definingIdealAt_preimage_eq_map_chartDiagram B S hS g Z d] at hs
  have hle : Ideal.map (chartDiagramPullback B S hS g d).hom (closedSubspaceBaseIdeal B S hS Z) ≤
      LinearMap.range ((baseRingTensorPreimageIdealHom B S hS g Z ≫
        preimageIdealι B S hS g Z).val.app (op V)).hom := by
    refine Ideal.map_le_iff_le_comap.2 fun a ha => ?_
    refine ⟨(modelSectionsHomEquiv B S hS W (baseRingHomOfMap g) _
        (((baseRingTensorModuleAdjunction B S hS W (baseRingHomOfMap g)).unit.app
          (ModuleCat.of _ (closedSubspaceBaseIdeal B S hS Z))).hom ⟨a, ha⟩)).val.app (op V)
          (1 : chartRing B S hS W.1 W.2 V), ?_⟩
    have h := congrArg (fun k : unitModule B S hS W.2 ⟶ unitModule B S hS W.2 =>
      k.val.app (op V) (1 : chartRing B S hS W.1 W.2 V))
      (modelSectionsHomEquiv_unit_comp_baseRingTensorPreimageIdealHom_ι B S hS g Z ⟨a, ha⟩)
    exact h.trans (unitModuleMul_val_app_one B S hS W _ V)
  obtain ⟨t, ht⟩ := hle hx
  exact ⟨t, Subtype.ext ht⟩

/-- **The defining ideal of `g⁻¹(Z) ⊆ W` is `𝒪_W ⊗_R I`** for a flat morphism `g : W ⟶ T` to an
affine object `T` of the site, `R = Γ(T, 𝒪_T)` and `I ⊆ R` the ideal of `Z`. -/
def definingIdealSheafPreimageIso (hg : IsFlat B S hS g.hom)
    (hT : IsAffine ((BigFppfOver.toScheme B S hS).obj T)) :
    (baseRingTensorModule B S hS W (baseRingHomOfMap g)).obj
        (ModuleCat.of (baseRing B S hS T) (closedSubspaceBaseIdeal B S hS Z)) ≅
      preimageIdeal B S hS g Z :=
  haveI := mono_baseRingTensorPreimageIdealHom B S hS g Z hg hT
  haveI := epi_baseRingTensorPreimageIdealHom B S hS g Z hT
  haveI := isIso_of_mono_of_epi (baseRingTensorPreimageIdealHom B S hS g Z)
  asIso (baseRingTensorPreimageIdealHom B S hS g Z)

/-- The forward morphism of `definingIdealSheafPreimageIso` is `baseRingTensorPreimageIdealHom`. -/
theorem definingIdealSheafPreimageIso_hom (hg : IsFlat B S hS g.hom)
    (hT : IsAffine ((BigFppfOver.toScheme B S hS).obj T)) :
    (definingIdealSheafPreimageIso B S hS g Z hg hT).hom =
      baseRingTensorPreimageIdealHom B S hS g Z :=
  rfl

end Ideal

section Conormal

variable {T T' : BigFppfOver B S hS} (j : T ⟶ T')
  (hj : AlgebraicGeometry.IsClosedImmersion ((BigFppfOver.toScheme B S hS).map j))

/-- The inverse image of `Z` along the identity is `Z`. -/
theorem preimageSubspace_id (Z : ClosedSubspaces B S hS (schemeSpace T').1) :
    preimageSubspace B S hS (𝟙 (schemeSpace T')) Z = Z :=
  Subtype.ext (Subfunctor.preimage_id _)

/-- **The defining ideal of a closed subscheme `T ⊆ T'` of an affine `T'` is `𝒪_{T'} ⊗_{R'} I`**,
`R' = Γ(T', 𝒪_{T'})`, `I = Ker(R' → Γ(T, 𝒪_T))`. -/
def definingIdealSheafRangeIso (hT' : IsAffine ((BigFppfOver.toScheme B S hS).obj T')) :
    (baseRingTensorModule B S hS (schemeSpace T') (baseRingHomOfMap (𝟙 (schemeSpace T')))).obj
        (ModuleCat.of (baseRing B S hS T')
          (closedSubspaceBaseIdeal B S hS (rangeSubspace B S hS j hj))) ≅
      (definingIdealSheaf B S hS (schemeSpace T') (rangeSubspace B S hS j hj)).toSheafOfModules :=
  definingIdealSheafPreimageIso B S hS (𝟙 (schemeSpace T')) (rangeSubspace B S hS j hj)
      (isFlat_id B S hS (schemeSpace T').2) hT' ≪≫
    eqToIso (congrArg (fun Z => (definingIdealSheaf B S hS (schemeSpace T') Z).toSheafOfModules)
      (preimageSubspace_id B S hS (rangeSubspace B S hS j hj)))

/-- **The conormal module of `T ⊆ T'` is `𝒪_T ⊗_{R'} I`.**  For a closed immersion `j : T ⟶ T'`
of objects of the site with `T'` affine, `R' = Γ(T', 𝒪_{T'})` and `I = Ker(R' → Γ(T, 𝒪_T))`
(`AlgebraicGeometry.Space.closedSubspaceBaseIdeal_rangeSubspace`), the conormal module of
[Stacks Project, Tag 04CN] of the closed subspace cut out by `j`, read on `T` along
`AlgebraicGeometry.Space.rangeSpaceIso`, is `𝒪_T ⊗_{R'} I`.  When `I² = 0` the `R'`-module `I` is
a module over `Γ(T, 𝒪_T) = R'/I` and this is the conormal module `𝒪_T ⊗_{R₁} I` of the body of
[Stacks Project, Tag 0D3X]. -/
def conormalModuleRangeIso (hT' : IsAffine ((BigFppfOver.toScheme B S hS).obj T')) :
    (modulePullback B S hS (rangeSpaceIso B S hS j hj).hom).obj
        (conormalModule B S hS (schemeSpace T') (rangeSubspace B S hS j hj)) ≅
      (baseRingTensorModule B S hS (schemeSpace T) (baseRingHomOfMap (schemeSpaceMap j))).obj
        (ModuleCat.of (baseRing B S hS T')
          (closedSubspaceBaseIdeal B S hS (rangeSubspace B S hS j hj))) :=
  (modulePullbackCompIso B S hS (rangeSpaceIso B S hS j hj).hom
      (subspaceInclusion B S hS (schemeSpace T') (rangeSubspace B S hS j hj))).app
      (definingIdealSheaf B S hS (schemeSpace T') (rangeSubspace B S hS j hj)).toSheafOfModules ≪≫
    eqToIso (congrArg (fun m => (modulePullback B S hS m).obj
        (definingIdealSheaf B S hS (schemeSpace T') (rangeSubspace B S hS j hj)).toSheafOfModules)
      (rangeSpaceIso_hom_comp_subspaceInclusion B S hS j hj)) ≪≫
    (modulePullback B S hS (schemeSpaceMap j)).mapIso
      (definingIdealSheafRangeIso B S hS j hj hT').symm ≪≫
    (baseRingTensorModulePullbackIso B S hS (schemeSpaceMap j)).app _

end Conormal

