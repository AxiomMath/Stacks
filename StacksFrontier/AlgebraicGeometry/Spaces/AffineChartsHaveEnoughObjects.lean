module

public import StacksFrontier.AlgebraicGeometry.Spaces.AffineEtaleDenseSubsite
public import StacksFrontier.CategoryTheory.Sites.WeaklyContractible

/-!
# The affine charts have enough objects in the small étale site of an algebraic space

Let `S` be a scheme of a big fppf site `B` and let `F` be a presheaf on the big fppf site of `S`.
Every étale chart of `F` is covered, in the small étale topology, by affine étale charts, and the
covering family can be indexed in the *morphism* universe `u` of the site.  That is the predicate
`CategoryTheory.GrothendieckTopology.HasEnoughObjects`, which is what the site-theoretic criteria
of [Stacks, Tag 0D6P] and [Stacks, Tag 0BKY] take as their input.

## Main results

* `AlgebraicGeometry.Space.hasEnoughObjects_isAffineChart`: **the small étale topology of `F` has
  enough affine charts.**

## Implementation notes

The content is already in the proof of [Stacks, Tag 04JS],
`AlgebraicGeometry.Space.AffineEtale.inclusion_isSpecialCocontinuous`: cover density of the
affine charts is checked there on the affine open cover of the scheme underlying a chart.  What
is *not* available from that theorem is the index universe.  `Functor.IsCoverDense` produces the
sieve `CategoryTheory.Presieve.coverByImage`, generated by *all* morphisms from affine charts,
whose indexing runs over the objects of the site and so lives in `Type (u + 1)`; and the covering
families of `AlgebraicGeometry.Space.SmallEtale.precoverage` are
`CategoryTheory.PreZeroHypercover.{u + 1}` as well, because a chosen covering family of the big
fppf site has its index type bounded only by `AlgebraicGeometry.BigFppfSite.coveringBound`, a
`Cardinal.{u + 1}`.  `HasEnoughObjects` asks for `I : Type u`.

The affine opens of a scheme *do* live in `Type u`, and that is what closes the gap: the family
indexed by `(B.inclusion.obj T).affineOpenCover.I₀` is a `Type u`-indexed family of affine
charts, and the sieve it generates contains the sieve generated by a *chosen* étale covering
family tautologically equivalent to it — the one produced by
`AlgebraicGeometry.Space.exists_etaleCovering_tautologicallyEquivalent` — which is a covering
sieve.  Upward closure of a Grothendieck topology finishes the argument.

So the affine open cover is used twice: once to produce the chosen covering family, and once as
the `Type u`-indexed family itself.  The bridge between them is
`AlgebraicGeometry.Space.chartFamily_factor`: a morphism of schemes over the chart's scheme lifts
to a morphism of charts, because the two chart structure morphisms both factor through the chart
`X` and the triangle over `F` therefore commutes automatically.

No `@[stacks]` attribute is attached.  [Stacks, Tag 04JS] is the dense-subsite theorem and is
registered at `AlgebraicGeometry.Space.AffineEtale.inclusion_isSpecialCocontinuous`; what is here
is the index-universe form of one step of its proof, not a clause of the tag.

## References

* [Stacks Project, Tag 04JS](https://stacks.math.columbia.edu/tag/04JS)
* [Stacks Project, Tag 03EC](https://stacks.math.columbia.edu/tag/03EC)
* [Stacks Project, Tag 090L](https://stacks.math.columbia.edu/tag/090L)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w w' u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-- The étale chart of `F` obtained by composing an étale morphism `Y ⟶ T` of the big fppf site
with a chart `X` whose underlying scheme is `T`.  This is [Stacks, Tag 03EC], composition. -/
noncomputable def chartComp {X : SmallEtale B S hS F} {Y : B.Schemes}
    (f : Y ⟶ (SmallEtale.toSchemes B S hS F).obj X)
    (hf : AlgebraicGeometry.Etale (B.inclusion.map f)) : SmallEtale B S hS F :=
  ⟨CostructuredArrow.mk
      (yoneda.map (Over.homMk f (by rfl) :
          (Over.mk (f ≫ X.1.left.hom) : BigFppfOver B S hS) ⟶ X.1.left) ≫ X.1.hom),
    etale_comp_of_scheme B S hS _ X.1.hom hf X.property⟩

/-- The structure morphism of `AlgebraicGeometry.Space.chartComp` to the chart it was built
over. -/
noncomputable def chartCompHom {X : SmallEtale B S hS F} {Y : B.Schemes}
    (f : Y ⟶ (SmallEtale.toSchemes B S hS F).obj X)
    (hf : AlgebraicGeometry.Etale (B.inclusion.map f)) :
    chartComp B S hS F f hf ⟶ X :=
  ObjectProperty.homMk (CostructuredArrow.homMk
    (Over.homMk f (by rfl) :
      (Over.mk (f ≫ X.1.left.hom) : BigFppfOver B S hS) ⟶ X.1.left) (by rfl))

/-- A family of étale morphisms into the scheme of a chart `X`, read as a family of charts over
`X`. -/
noncomputable def chartFamily {X : SmallEtale B S hS F} {I : Type w} (Y : I → B.Schemes)
    (f : ∀ i, Y i ⟶ (SmallEtale.toSchemes B S hS F).obj X)
    (hf : ∀ i, AlgebraicGeometry.Etale (B.inclusion.map (f i))) :
    PreZeroHypercover.{w} X where
  I₀ := I
  X i := chartComp B S hS F (f i) (hf i)
  f i := chartCompHom B S hS F (f i) (hf i)

/-- The scheme underlying a member of `AlgebraicGeometry.Space.chartFamily` is the source of the
corresponding morphism. -/
theorem chartFamily_map_toSchemes {X : SmallEtale B S hS F} {I : Type w} (Y : I → B.Schemes)
    (f : ∀ i, Y i ⟶ (SmallEtale.toSchemes B S hS F).obj X)
    (hf : ∀ i, AlgebraicGeometry.Etale (B.inclusion.map (f i))) :
    (chartFamily B S hS F Y f hf).map (SmallEtale.toSchemes B S hS F) =
      ⟨I, Y, f⟩ := rfl

/-- **A morphism of schemes over the chart's scheme lifts to a morphism of charts.**  If
`g : Y i ⟶ Y' j` satisfies `g ≫ f' j = f i` then the `i`-th member of the first chart family
maps to the `j`-th member of the second, compatibly with their structure morphisms to `X`.

The triangle over `F` commutes automatically: both chart structure morphisms are the chart `X`'s
own, precomposed with the images under `yoneda` of morphisms of the big fppf site, so the
equation is the image of `g ≫ f' j = f i`. -/
theorem chartFamily_factor {X : SmallEtale B S hS F} {I : Type w} {I' : Type w'}
    (Y : I → B.Schemes) (f : ∀ i, Y i ⟶ (SmallEtale.toSchemes B S hS F).obj X)
    (hf : ∀ i, AlgebraicGeometry.Etale (B.inclusion.map (f i)))
    (Y' : I' → B.Schemes) (f' : ∀ j, Y' j ⟶ (SmallEtale.toSchemes B S hS F).obj X)
    (hf' : ∀ j, AlgebraicGeometry.Etale (B.inclusion.map (f' j)))
    (i : I) (j : I') (g : Y i ⟶ Y' j) (hg : g ≫ f' j = f i) :
    ∃ φ : (chartFamily B S hS F Y f hf).X i ⟶ (chartFamily B S hS F Y' f' hf').X j,
      φ ≫ (chartFamily B S hS F Y' f' hf').f j = (chartFamily B S hS F Y f hf).f i := by
  have hcomm : g ≫ (Over.mk (f' j ≫ X.1.left.hom) : BigFppfOver B S hS).hom =
      (Over.mk (f i ≫ X.1.left.hom) : BigFppfOver B S hS).hom := by
    change g ≫ f' j ≫ X.1.left.hom = f i ≫ X.1.left.hom
    rw [← Category.assoc, hg]
  let ψ : (Over.mk (f i ≫ X.1.left.hom) : BigFppfOver B S hS) ⟶
      Over.mk (f' j ≫ X.1.left.hom) := Over.homMk g hcomm
  have key : ψ ≫ (Over.homMk (f' j) (by rfl) :
      (Over.mk (f' j ≫ X.1.left.hom) : BigFppfOver B S hS) ⟶ X.1.left) =
      (Over.homMk (f i) (by rfl) :
        (Over.mk (f i ≫ X.1.left.hom) : BigFppfOver B S hS) ⟶ X.1.left) :=
    Over.OverMorphism.ext (by simpa [ψ] using hg)
  refine ⟨ObjectProperty.homMk (CostructuredArrow.homMk ψ ?_), ?_⟩
  · exact (Category.assoc _ _ _).symm.trans (congrArg (fun m => yoneda.map m ≫ X.1.hom) key)
  · exact ObjectProperty.hom_ext _ (CostructuredArrow.hom_ext _ _ key)

/-- **The small étale topology of an algebraic space has enough affine charts.**  Every étale
chart `X` of `F` admits a covering family, indexed in the morphism universe `u` of the site, all
of whose members are affine charts.

The family is the affine open cover of the scheme `T` underlying `X`, whose index type lies in
`Type u`, read as a family of charts over `X`; an affine open immersion is étale, so
[Stacks, Tag 03EC] makes each member a chart.  The sieve it generates is covering because the
*chosen* étale covering family tautologically equivalent to it, produced by
`AlgebraicGeometry.Space.exists_etaleCovering_tautologicallyEquivalent`, generates a covering
sieve contained in it: each member of the chosen family is isomorphic over `T` to a member of the
affine open cover, and `AlgebraicGeometry.Space.chartFamily_factor` lifts that isomorphism to the
charts. -/
theorem hasEnoughObjects_isAffineChart :
    (SmallEtale.topology B S hS F).HasEnoughObjects (IsAffineChart B S hS F) := by
  intro X
  let T : B.Schemes := (SmallEtale.toSchemes B S hS F).obj X
  let A := (B.inclusion.obj T).affineOpenCover
  have hopen : ∀ j : A.I₀, AlgebraicGeometry.IsOpenImmersion (A.openCover.f j) := fun j =>
    A.openCover.map_prop j
  have hsizeA : ∀ j : A.I₀, B.Contains (A.openCover.X j) := fun j =>
    have := hopen j
    Scheme.size_lt_of_isOpenImmersion (A.openCover.f j) T.property
  -- the `Type u`-indexed family of affine opens of `T`, read in `Sch_κ`
  let Ya : A.I₀ → B.Schemes := fun j => B.obj (hsizeA j)
  let fa : ∀ j, Ya j ⟶ T := fun j =>
    B.inclusion.preimage
      (show B.inclusion.obj (Ya j) ⟶ B.inclusion.obj T from A.openCover.f j)
  have hmapfa : ∀ j, B.inclusion.map (fa j) = A.openCover.f j := fun j =>
    B.inclusion.map_preimage _
  have hetalefa : ∀ j, AlgebraicGeometry.Etale (B.inclusion.map (fa j)) := fun j => by
    have := hopen j
    rw [hmapfa j]
    infer_instance
  let Ea := chartFamily B S hS F Ya fa hetalefa
  -- its members are affine charts
  have haff : ∀ j, IsAffineChart B S hS F (Ea.X j) := by
    intro j
    change IsAffine (A.openCover.X j)
    exact Scheme.isAffine_affineOpenCover _ A j
  -- the same family at index universe `u + 1`, as an open cover of `T`
  let Ul : (B.inclusion.obj T).OpenCover.{u + 1} :=
    { I₀ := ULift.{u + 1, u} A.I₀
      X i := A.openCover.X i.down
      f i := A.openCover.f i.down
      mem₀ := by
        rw [Scheme.presieve₀_mem_precoverage_iff]
        refine ⟨fun x => ?_, fun i => A.openCover.map_prop i.down⟩
        obtain ⟨i, y, hy⟩ := A.openCover.exists_eq x
        exact ⟨ULift.up i, y, hy⟩ }
  obtain ⟨V, hV, hEq⟩ :=
    exists_etaleCovering_tautologicallyEquivalent B T Ul.toPreZeroHypercover
      (Scheme.precoverage_mono (P := @AlgebraicGeometry.IsOpenImmersion) (Q := @Etale)
        (fun _ _ f _ => inferInstance) (B.inclusion.obj T) Ul.mem₀)
      (fun i => Scheme.size_lt_of_isOpenImmersion (Ul.f i) T.property)
  have hetaleV : ∀ i, AlgebraicGeometry.Etale (B.inclusion.map (V.f i)) := fun i => by
    have h := (Scheme.presieve₀_mem_precoverage_iff (V.map B.inclusion)).mp hV.2
    exact h.2 i
  let Ev := chartFamily B S hS F (fun i => V.X i) (fun i => V.f i) hetaleV
  -- the chosen family is a covering family of charts
  have hcovEv : SmallEtale.IsCovering B S hS F ⟨X, Ev⟩ := hV
  have hgenEv : Ev.sieve₀ ∈ SmallEtale.topology B S hS F X :=
    .of X Ev.presieve₀ ⟨Ev, rfl, hcovEv⟩
  -- every member of the chosen family factors through a member of the affine open cover
  obtain ⟨β, hβ⟩ := hEq.2
  have hle : Ev.sieve₀ ≤ Ea.sieve₀ := by
    rw [show Ev.sieve₀ = Sieve.generate Ev.presieve₀ from rfl, Sieve.generate_le_iff]
    rintro Z p ⟨i⟩
    obtain ⟨e, he⟩ := hβ i
    let g : V.X i ⟶ Ya (β i).down :=
      B.inclusion.preimage
        (show B.inclusion.obj (V.X i) ⟶ B.inclusion.obj (Ya (β i).down) from e.hom)
    have hge : g ≫ fa (β i).down = V.f i := by
      apply B.inclusion.map_injective
      rw [B.inclusion.map_comp, hmapfa]
      show B.inclusion.map g ≫ A.openCover.f (β i).down = _
      rw [show B.inclusion.map g = e.hom from B.inclusion.map_preimage _]
      exact he
    obtain ⟨φ, hφ⟩ := chartFamily_factor B S hS F (fun i => V.X i) (fun i => V.f i) hetaleV
      Ya fa hetalefa i (β i).down g hge
    exact ⟨Ea.X (β i).down, φ, Ea.f (β i).down, ⟨(β i).down⟩, hφ⟩
  exact ⟨A.I₀, Ea.X, Ea.f,
    (SmallEtale.topology B S hS F).superset_covering hle hgenEv, haff⟩

end AlgebraicGeometry.Space

end
