/-!
# Models of an algebraic space of finite presentation over a ring of finite type over `ℤ`

Let `X` be an algebraic space of finite presentation over `Spec A`. Write `Spec A` as the limit
of the spectra `Spec A_λ` of the subrings of `A` generated by its finite subsets. Then `X` is the
base change of an algebraic space `X_λ` of finite presentation over some `Spec A_λ`; `X_λ` can be
chosen separated if `X` is separated, and flat if `X` is flat.

## Main results

* `AlgebraicGeometry.Space.exists_relation_of_isFinitePresentation`: an affine étale atlas of
  `X` whose kernel pair is of finite presentation over `Spec A`.
* `AlgebraicGeometry.Space.exists_stageModel`: the model `X_λ`.

## References

* [Stacks Project, Tag 07SK](https://stacks.math.columbia.edu/tag/07SK)
* [Stacks Project, Tag 02WW](https://stacks.math.columbia.edu/tag/02WW)
* [Stacks Project, Tag 03I4](https://stacks.math.columbia.edu/tag/03I4)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

/-! ### Pairings and binary products -/

/-- A jointly monic pair of morphisms has a monic pairing. -/
lemma mono_prodLift_of_jointlyMono₂ {C : Type*} [Category* C] [HasBinaryProducts C] {R W : C}
    {s t : R ⟶ W} (h : JointlyMono₂ s t) : Mono (prod.lift s t) :=
  ⟨fun a b hab => h.right_cancellation a b (by simpa using hab =≫ prod.fst)
    (by simpa using hab =≫ prod.snd)⟩

/-! ### An étale atlas of finite presentation -/

variable (B : BigFppfSite.{u}) {A : Type u} [CommRing A] {hA : B.Contains (Spec (.of A))}
  {X : (BigFppfOver B (Spec (.of A)) hA)ᵒᵖ ⥤ Type u}

include B in
/-- **The kernel pair of an affine étale chart.** Let `X` be an algebraic space of finite
presentation over `Spec A` and `c : W ⟶ X` an étale morphism from an affine object of the site.
Then `W` is of finite presentation over `Spec A`, and the kernel pair `R = W ×_X W` is represented
by a quasi-compact object of the site. If `X` is separated, the pairing `R ⟶ W ×_A W` is a closed
immersion, and if `X` is flat, so is `W`. -/
theorem exists_relation_of_chart (hX : IsAlgebraicSpace B (Spec (.of A)) hA X)
    (f : X ⟶ yoneda.obj (Over.mk (𝟙 (B.obj hA))))
    (hfp : IsFinitePresentation B (Spec (.of A)) hA f) {W : BigFppfOver B (Spec (.of A)) hA}
    (c : yoneda.obj W ⟶ X) (hW : IsAffine ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj W))
    (hpe : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf c) :
    ∃ (R : BigFppfOver B (Spec (.of A)) hA) (r₁ r₂ : R ⟶ W),
      IsPullback (yoneda.map r₁) (yoneda.map r₂) c c ∧
      FinitePresentation (B.inclusion.map W.hom) ∧
      CompactSpace ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj R) ∧
      (IsSeparated B (Spec (.of A)) hA f →
        _root_.AlgebraicGeometry.IsClosedImmersion
          ((BigFppfOver.toScheme B (Spec (.of A)) hA).map (prod.lift r₁ r₂))) ∧
      (IsFlat B (Spec (.of A)) hA f → Flat (B.inclusion.map W.hom)) := by
  have hZ := BigFppfSite.contains_terminal B
  let hq := hX.diagonal_representable.of_diag c
  have hR : IsPullback (yoneda.map (hq.fst' c)) (yoneda.map (hq.snd c)) c c := hq.isPullback' c
  have hWfp : FinitePresentation (B.inclusion.map W.hom) := by
    have : IsAffine (B.inclusion.obj W.left) := hW
    have : IsAffine (B.inclusion.obj (B.obj hA)) := inferInstanceAs (IsAffine (Spec (.of A)))
    have : LocallyOfFinitePresentation (B.inclusion.map W.hom) :=
      holdsOnEveryEtaleChart_structure_chart B _ f hfp.1 c hpe
    exact ⟨inferInstance, inferInstance, inferInstance⟩
  have hT : IsAbsolutelyQuasiSeparated B (Spec (.of A)) hA hZ
      (yoneda.obj (Over.mk (𝟙 (B.obj hA)))) :=
    isAbsolutelyQuasiSeparated_of_isQuasiSeparatedScheme B (Spec (.of A)) hA _ hZ
      ⟨_, inferInstanceAs (QuasiSeparatedSpace (Spec (.of A))),
        ⟨Functor.RepresentableBy.yoneda _⟩⟩
  have hXqs := isAbsolutelyQuasiSeparated_of_isQuasiSeparated B (Spec (.of A)) hA hZ hX hT
    hfp.2.2
  have hWqc : IsQuasiCompactSpace B (Spec (.of A)) hA (yoneda.obj W) :=
    isQuasiCompactSpace_yoneda_obj B (Spec (.of A)) hA
      (have : IsAffine ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj W) := hW; inferInstance)
  have hRqc : CompactSpace ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj (hq.pullback c)) :=
    compactSpace_of_isQuasiCompactSpace_yoneda_obj B (Spec (.of A)) hA
      ((isQuasiCompactSpace_pullback B (Spec (.of A)) hA hZ c c
        (isAlgebraicSpace_yoneda B _ hA W) hX hWqc hWqc hXqs).of_iso B (Spec (.of A)) hA
          hR.isoPullback.symm)
  refine ⟨hq.pullback c, hq.fst' c, hq.snd c, hR, hWfp, hRqc, fun hsep => ?_,
    fun hflat => holdsOnEveryEtaleChart_structure_chart B _ f hflat c hpe⟩
  have hsep' : IsSeparatedOver B (Spec (.of A)) hA X :=
    (isSeparatedOver_iff_isSeparated_of_isTerminal B (Spec (.of A)) hA
      (isTerminal_yoneda_obj_base B (Spec (.of A)) hA) f).2 hsep
  exact isClosedImmersion_kernelPairToProd_of_isSeparatedOver B (Spec (.of A)) hA hsep' hq

include B in
/-- **An affine étale atlas with a kernel pair of finite presentation.** An algebraic space of
finite presentation over `Spec A` has a surjective étale atlas `p : W ⟶ X` with `W` affine whose
kernel pair `R` is the representing object of the base change of the diagonal; both are of
finite presentation over `Spec A`. If `X` is separated, the pairing `R ⟶ W ×_A W` is a closed
immersion, and if `X` is flat, so is `W`. -/
theorem exists_relation_of_isFinitePresentation (hX : IsAlgebraicSpace B (Spec (.of A)) hA X)
    (f : X ⟶ yoneda.obj (Over.mk (𝟙 (B.obj hA))))
    (hfp : IsFinitePresentation B (Spec (.of A)) hA f) :
    ∃ (W R : BigFppfOver B (Spec (.of A)) hA) (p : yoneda.obj W ⟶ X) (r₁ r₂ : R ⟶ W),
      (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf p ∧
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf p ∧
      IsPullback (yoneda.map r₁) (yoneda.map r₂) p p ∧
      IsAffine ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj W) ∧
      FinitePresentation (B.inclusion.map W.hom) ∧
      CompactSpace ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj R) ∧
      (IsSeparated B (Spec (.of A)) hA f →
        _root_.AlgebraicGeometry.IsClosedImmersion
          ((BigFppfOver.toScheme B (Spec (.of A)) hA).map (prod.lift r₁ r₂))) ∧
      (IsFlat B (Spec (.of A)) hA f → Flat (B.inclusion.map W.hom)) := by
  obtain ⟨W, c, hW, hcs, hce⟩ :=
    exists_isAffine_isEtale_isSurjective_chart_of_isQuasiCompact B (Spec (.of A)) hA hX f
      hfp.2.1
  have hpe := presheaf_etale_of_isEtale B (Spec (.of A)) hA hce
  obtain ⟨R, r₁, r₂, hR, hWfp, hRc, hsep, hflat⟩ := exists_relation_of_chart B hX f hfp c hW hpe
  exact ⟨W, R, c, r₁, r₂, hcs, hpe, hR, hW, hWfp, hRc, hsep, hflat⟩

/-! ### The model over a stage -/

/-- Every stage of the Noetherian approximation of `Spec A` lies in every big fppf site, being of
finite type over `ℤ`. -/
lemma contains_specAdjoinFinsetDiagram_obj (i : (Finset A)ᵒᵖ) :
    B.Contains ((specAdjoinFinsetDiagram A).obj i) :=
  @Scheme.size_lt_of_locallyOfFiniteType_of_quasiCompact _ _ _ _
    (locallyOfFiniteType_terminalFrom_specAdjoinFinsetDiagram_obj A i)
    (quasiCompact_of_compactSpace _) (BigFppfSite.contains_terminal B)

include B in
/-- **The restriction of a quotient presentation.** Let `p : W ⟶ X` be a surjective étale atlas
of an algebraic space over `Spec A` with kernel pair `r₁, r₂ : R ⟶ W`, and let `q : W₀ ⟶ X₀` be a
surjective étale atlas of an algebraic space over `S₀` with kernel pair `s, t : R₀ ⟶ W₀`. If the
restriction of `(W₀, R₀, s, t)` along `g : Spec A ⟶ S₀` is identified with `(W, R, r₁, r₂)`,
then `X` is the restriction of `X₀`, compatibly with the atlases. -/
theorem exists_iso_relocalizeRestrict_of_quotient (hX : IsAlgebraicSpace B (Spec (.of A)) hA X)
    {W R : BigFppfOver B (Spec (.of A)) hA} (p : yoneda.obj W ⟶ X) (r₁ r₂ : R ⟶ W)
    (hps : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf p)
    (hpe : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf p)
    (hR : IsPullback (yoneda.map r₁) (yoneda.map r₂) p p)
    {S₀ : Scheme.{u}} (h₀ : B.Contains S₀) {Wo Ro : BigFppfOver B S₀ h₀} (sR tR : Ro ⟶ Wo)
    (hrel : Stacks.Groupoids.IsEtaleEquivalenceRelation
      (prod.lift ((Over.post B.inclusion).map sR) ((Over.post B.inclusion).map tR)))
    {X₀ : (BigFppfOver B S₀ h₀)ᵒᵖ ⥤ Type u} (hX₀ : IsAlgebraicSpace B S₀ h₀ X₀)
    (q : yoneda.obj Wo ⟶ X₀)
    (hqs : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S₀ h₀)).presheaf q)
    (hqe : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S₀ h₀)).presheaf q)
    (hqk : IsPullback (yoneda.map sR) (yoneda.map tR) q q) (g : B.obj hA ⟶ B.obj h₀)
    (φW : (Over.pullback g).obj Wo ≅ W) (φR : (Over.pullback g).obj Ro ≅ R)
    (hφs : (Over.pullback g).map sR ≫ φW.hom = φR.hom ≫ r₁)
    (hφt : (Over.pullback g).map tR ≫ φW.hom = φR.hom ≫ r₂) :
    ∃ e : X ≅ (OverShriek.relocalizeRestrict g).obj X₀,
      p ≫ e.hom = yoneda.map φW.inv ≫ (OverShriek.restrictYonedaIso g Wo).hom ≫
        (OverShriek.relocalizeRestrict g).map q := by
  let P₀ : Presentation B S₀ h₀ X₀ hX₀ :=
    { U := Wo
      R := Ro
      target := sR
      source := tR
      isEtaleEquivalenceRelation := hrel
      toSpace := q
      surjective := hqs
      etale := hqe
      isPullback := hqk }
  let P₁ := baseChangePresentation B (Spec (.of A)) S₀ hA h₀ g P₀
  have _ : (MorphismProperty.inverseImage (@Surjective.{u})
      (BigFppfOver.toScheme B (Spec (.of A)) hA)).RespectsIso :=
    MorphismProperty.RespectsIso.inverseImage _ _
  have _ : (MorphismProperty.inverseImage (@Etale.{u})
      (BigFppfOver.toScheme B (Spec (.of A)) hA)).RespectsIso := by
    have _ : MorphismProperty.RespectsIso (@Etale.{u}) :=
      MorphismProperty.IsStableUnderBaseChange.respectsIso
    exact MorphismProperty.RespectsIso.inverseImage _ _
  let c' : yoneda.obj W ⟶ (OverShriek.relocalizeRestrict g).obj X₀ :=
    yoneda.map φW.inv ≫ P₁.toSpace
  have hcs : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf c' :=
    MorphismProperty.RespectsIso.precomp _ _ _ P₁.surjective
  have hce : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf c' :=
    MorphismProperty.RespectsIso.precomp _ _ _ P₁.etale
  have hck : IsPullback (yoneda.map r₁) (yoneda.map r₂) c' c' := by
    refine P₁.isPullback.of_iso (yoneda.mapIso φR) (yoneda.mapIso φW) (yoneda.mapIso φW)
      (Iso.refl _) ?_ ?_ ?_ ?_
    · show yoneda.map ((Over.pullback g).map sR) ≫ yoneda.map φW.hom =
        yoneda.map φR.hom ≫ yoneda.map r₁
      rw [← Functor.map_comp, ← Functor.map_comp, hφs]
    · show yoneda.map ((Over.pullback g).map tR) ≫ yoneda.map φW.hom =
        yoneda.map φR.hom ≫ yoneda.map r₂
      rw [← Functor.map_comp, ← Functor.map_comp, hφt]
    all_goals exact (Category.comp_id _).trans ((Category.id_comp _).symm.trans
        (congrArg (· ≫ P₁.toSpace) ((yoneda.mapIso φW).hom_inv_id.symm) |>.trans
          (Category.assoc _ _ _)))
  obtain ⟨e, he⟩ := exists_iso_of_common_atlas B (Spec (.of A)) hA hX
    (isAlgebraicSpace_relocalizeRestrict B (Spec (.of A)) S₀ hA h₀ g X₀ hX₀) r₁ r₂ p c' hps
    hpe hcs hce hR hck
  exact ⟨e, he⟩

include B in
/-- **A model of an algebraic space of finite presentation, with a model of a given atlas.**
Let `X` be an algebraic space of finite presentation over `Spec A` and `p : W ⟶ X` a surjective
étale atlas with `W` affine. Then for some finite subset `k ⊆ A`, with `A₀ = ℤ[k] ⊆ A`, there
are an algebraic space `X₀` of finite presentation over `Spec A₀` and a surjective étale atlas
`q : W₀ ⟶ X₀` with `W₀` affine, whose base change along `Spec A ⟶ Spec A₀` is `p : W ⟶ X`.
If `X` is separated, or flat, over `Spec A`, then `X₀` can be chosen separated, respectively
flat, over `Spec A₀`. -/
theorem exists_stageModel_of_atlas (hX : IsAlgebraicSpace B (Spec (.of A)) hA X)
    (f : X ⟶ yoneda.obj (Over.mk (𝟙 (B.obj hA))))
    (hfp : IsFinitePresentation B (Spec (.of A)) hA f) {W : BigFppfOver B (Spec (.of A)) hA}
    (p : yoneda.obj W ⟶ X) (hW : IsAffine ((BigFppfOver.toScheme B (Spec (.of A)) hA).obj W))
    (hps : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf p)
    (hpe : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B (Spec (.of A)) hA)).presheaf p) :
    ∃ (i : (Finset A)ᵒᵖ) (X₀ : (BigFppfOver B ((specAdjoinFinsetDiagram A).obj i)
        (contains_specAdjoinFinsetDiagram_obj B i))ᵒᵖ ⥤ Type u)
      (_ : IsAlgebraicSpace B _ (contains_specAdjoinFinsetDiagram_obj B i) X₀)
      (f₀ : X₀ ⟶ yoneda.obj (Over.mk (𝟙 (B.obj (contains_specAdjoinFinsetDiagram_obj B i))))),
      IsFinitePresentation B _ _ f₀ ∧
      (IsSeparated B (Spec (.of A)) hA f → IsSeparated B _ _ f₀) ∧
      (IsFlat B (Spec (.of A)) hA f → IsFlat B _ _ f₀) ∧
      ∃ (W₀ : BigFppfOver B _ (contains_specAdjoinFinsetDiagram_obj B i)) (q : yoneda.obj W₀ ⟶ X₀),
        IsAffine ((BigFppfOver.toScheme B _ (contains_specAdjoinFinsetDiagram_obj B i)).obj W₀) ∧
        (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
          (BigFppfOver.toScheme B _ (contains_specAdjoinFinsetDiagram_obj B i))).presheaf q ∧
        (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
          (BigFppfOver.toScheme B _ (contains_specAdjoinFinsetDiagram_obj B i))).presheaf q ∧
        ∀ (g : B.obj hA ⟶ B.obj (contains_specAdjoinFinsetDiagram_obj B i)),
          B.inclusion.map g = (specAdjoinFinsetCone A).π.app i →
          ∃ (e : X ≅ (OverShriek.relocalizeRestrict g).obj X₀) (φ : (Over.pullback g).obj W₀ ≅ W),
            p ≫ e.hom = yoneda.map φ.inv ≫ (OverShriek.restrictYonedaIso g W₀).hom ≫
              (OverShriek.relocalizeRestrict g).map q := by
  classical
  have hZ := BigFppfSite.contains_terminal B
  obtain ⟨R, r₁, r₂, hR, hWfp, hRc, hsep, hflat⟩ := exists_relation_of_chart B hX f hfp p hW hpe
  let F := Over.post (X := B.obj hA) B.inclusion
  have hFF : F.FullyFaithful := fullyFaithful_overPost_bigFppfInclusion B _ hA
  have : PreservesFiniteProducts F := preservesFiniteProducts_overPost_bigFppfInclusion B _ hA
  have hc : IsLimit (specAdjoinFinsetCone A) := isLimit_specAdjoinFinsetCone A
  let W' : Over (specAdjoinFinsetCone A).pt := F.obj W
  let R' : Over (specAdjoinFinsetCone A).pt := F.obj R
  let s : R' ⟶ W' := F.map r₁
  let t : R' ⟶ W' := F.map r₂
  have hEq : IsEquivalenceRelation s t := isEquivalenceRelation_of_isPullback B _ hA p r₁ r₂ hR
  have hs : Etale s.left := hpe.property p (yoneda.map r₂) r₁ hR.flip
  have ht : Etale t.left := hpe.property p (yoneda.map r₁) r₂ hR
  have hmono' : Mono (prod.lift s t) :=
    mono_prodLift_of_jointlyMono₂ hEq.nonempty_equivalenceRelation.some.toJointlyMono₂
  have hmono : Mono (prod.lift s t).left := inferInstance
  have hWa : IsAffine W'.left := hW
  have hAa : IsAffine (specAdjoinFinsetCone A).pt := inferInstanceAs (IsAffine (Spec (.of A)))
  have haff : _root_.AlgebraicGeometry.IsAffineHom W'.hom := inferInstance
  have hRfp : FinitePresentation R'.hom := by
    have hRw : R'.hom = s.left ≫ W'.hom := (Over.w s).symm
    have hRw' : R'.hom = (prod.lift s t).left ≫ (W' ⨯ W').hom := (Over.w (prod.lift s t)).symm
    have : LocallyOfFinitePresentation W'.hom := hWfp.1
    have : CompactSpace R'.left := hRc
    have : QuasiSeparated (W' ⨯ W').hom := (finitePresentation_prod_hom hWfp hWfp).2.2
    refine ⟨?_, inferInstance, ?_⟩
    · rw [hRw]; infer_instance
    · rw [hRw']; infer_instance
  obtain ⟨M, hMs, hMt, hMmono, hMaff, hMgrp, hMci, hMflat⟩ :=
    RelationModel.exists_etaleEquivalenceRelation hc s t hWfp hRfp
      (IsGroupoidRelation.of_isEquivalenceRelation hEq)
  let S₀ := (specAdjoinFinsetDiagram A).obj M.stage
  have h₀ : B.Contains S₀ := contains_specAdjoinFinsetDiagram_obj B M.stage
  have hS₀ : IsAffine S₀ := inferInstanceAs (IsAffine ((specAdjoinFinsetDiagram A).obj M.stage))
  have hc₀ : ∀ Y : Over S₀, FinitePresentation Y.hom → B.Contains Y.left := fun Y hY =>
    @Scheme.size_lt_of_locallyOfFiniteType_of_quasiCompact _ _ _ Y.hom
      (have := hY.1; inferInstance) hY.2.1 h₀
  let Wo := BigFppfOver.mk B S₀ h₀ (hc₀ _ M.finitePresentation_W₀) M.W₀.hom
  let Ro := BigFppfOver.mk B S₀ h₀ (hc₀ _ M.finitePresentation_R₀) M.R₀.hom
  let G₀ := Over.post (X := B.obj h₀) B.inclusion
  have hG₀ : G₀.FullyFaithful := fullyFaithful_overPost_bigFppfInclusion B S₀ h₀
  let sR : Ro ⟶ Wo := hG₀.preimage M.s₀
  let tR : Ro ⟶ Wo := hG₀.preimage M.t₀
  have hsR : G₀.map sR = M.s₀ := hG₀.map_preimage _
  have htR : G₀.map tR = M.t₀ := hG₀.map_preimage _
  have hgrpo : IsGroupoidRelation sR tR := IsGroupoidRelation.of_map hG₀ (by rwa [hsR, htR])
  obtain ⟨refl, symm, comp, hr₁, hr₂, hσ₁, hσ₂, hc₁, hc₂⟩ := hgrpo
  have hjm : JointlyMono₂ (G₀.map sR) (G₀.map tR) := by
    have : Mono (prod.lift M.s₀ M.t₀) := Over.mono_of_mono_left _
    rw [hsR, htR]
    exact AlgebraicGeometry.jointlyMono₂_of_mono_prodLift _ _ this
  have hE : ∀ (a : Ro ⟶ Wo) (m : M.R₀ ⟶ M.W₀), G₀.map a = m → Etale m.left →
      Etale ((BigFppfOver.toScheme B S₀ h₀).map a) := fun a m h hm => by subst h; exact hm
  have hsE := hE sR _ hsR hMs
  have htE := hE tR _ htR hMt
  have hWoAff : IsAffine ((BigFppfOver.toScheme B S₀ h₀).obj Wo) := by
    have := hMaff
    exact (isAffine_of_isAffineHom M.W₀.hom : IsAffine M.W₀.left)
  let T := yoneda.obj (Over.mk (𝟙 (B.obj h₀)) : BigFppfOver B S₀ h₀)
  have hT : IsAlgebraicSpace B S₀ h₀ T := isAlgebraicSpace_yoneda B S₀ h₀ _
  have hTqc : IsQuasiCompactSpace B S₀ h₀ T :=
    isQuasiCompactSpace_yoneda_obj B S₀ h₀ (inferInstanceAs (CompactSpace S₀))
  have hTqs : IsAbsolutelyQuasiSeparated B S₀ h₀ hZ T :=
    isAbsolutelyQuasiSeparated_of_isQuasiSeparatedScheme B S₀ h₀ _ hZ
      ⟨_, inferInstanceAs (QuasiSeparatedSpace S₀), ⟨Functor.RepresentableBy.yoneda _⟩⟩
  let wo : yoneda.obj Wo ⟶ T :=
    yoneda.map (Over.homMk Wo.hom (Category.comp_id _) : Wo ⟶ Over.mk (𝟙 (B.obj h₀)))
  have hwo : yoneda.map sR ≫ wo = yoneda.map tR ≫ wo :=
    (isTerminal_yoneda_obj_base B S₀ h₀).hom_ext _ _
  have hwoFp : IsFinitePresentation B S₀ h₀ wo :=
    isFinitePresentation_yoneda_map B S₀ h₀ _ M.finitePresentation_W₀
  have hRoqc : IsQuasiCompactSpace B S₀ h₀ (yoneda.obj Ro) :=
    isQuasiCompactSpace_yoneda_obj B S₀ h₀ M.compactSpace_R₀
  obtain ⟨X₀, hX₀, q, y, hqs, hqe, hqk, hqy, hyfp⟩ :=
    exists_finitePresentation_quotient B S₀ h₀ hZ hT hTqc hTqs hWoAff sR tR hsE htE hjm refl
      hr₁ hr₂ symm hσ₁ hσ₂ comp hc₁ hc₂ wo hwo hwoFp hRoqc
  refine ⟨M.stage, X₀, hX₀, y, hyfp, fun hf => ?_, fun hf => ?_, Wo, q, hWoAff, hqs, hqe,
    fun g hg => ?_⟩
  · have hci : _root_.AlgebraicGeometry.IsClosedImmersion
        ((BigFppfOver.toScheme B S₀ h₀).map (prod.lift sR tR)) := by
      show _root_.AlgebraicGeometry.IsClosedImmersion (G₀.map (prod.lift sR tR)).left
      refine (AlgebraicGeometry.prop_prodLift_map_iff
        @_root_.AlgebraicGeometry.IsClosedImmersion G₀ sR tR).1 ?_
      rw [hsR, htR]
      exact hMci ((AlgebraicGeometry.prop_prodLift_map_iff
        @_root_.AlgebraicGeometry.IsClosedImmersion F r₁ r₂).2 (hsep hf))
    let hq := hX₀.diagonal_representable.of_diag q
    let e := (hqk.isoIsPullback _ _ (hq.isPullback' q))
    have he₁ : e.hom ≫ yoneda.map (hq.fst' q) = yoneda.map sR := hqk.isoIsPullback_hom_fst _ _ _
    have he₂ : e.hom ≫ yoneda.map (hq.snd q) = yoneda.map tR := hqk.isoIsPullback_hom_snd _ _ _
    let e' := Yoneda.fullyFaithful.preimageIso e
    have hf : ∀ {a b : _ ⟶ Wo}, e.hom ≫ yoneda.map b = yoneda.map a → e'.hom ≫ b = a :=
      fun h => Yoneda.fullyFaithful.map_injective (by
        rw [Functor.map_comp, Functor.FullyFaithful.preimageIso_hom,
          Functor.FullyFaithful.map_preimage, h])
    have hf₁ := hf he₁
    have hf₂ := hf he₂
    have hkp : kernelPairToProd B S₀ h₀ hq = e'.inv ≫ prod.lift sR tR := by
      apply prod.hom_ext
      · simp [kernelPairToProd, ← hf₁]
      · simp [kernelPairToProd, ← hf₂]
    have hsepo : IsSeparatedOver B S₀ h₀ X₀ := by
      refine isSeparatedOver_of_isClosedImmersion_kernelPairToProd B S₀ h₀ hX₀ hqs hqe ?_
      rw [hkp, Functor.map_comp]
      infer_instance
    exact isSeparated_of_isSeparatedOver B S₀ h₀ hsepo y
  · refine (holdsOnEveryEtaleChart_iff_surjectiveChart B S₀ h₀ _
      Flat.isEtaleLocalOnSourceAndTarget hX₀ hT y).2
      ⟨Wo, Over.mk (𝟙 (B.obj h₀)), q, 𝟙 T, Over.homMk Wo.hom (Category.comp_id _), hqe,
        presheaf_inverseImage_id_yoneda B S₀ h₀ (@Etale.{u}) (fun q hq => by
          have := hq; infer_instance) _, hqs, ?_, hMflat (hflat hf)⟩
    rw [Category.comp_id, hqy]
  · let Θ : Over.pullback g ⋙ F ≅ G₀ ⋙ Over.pullback ((specAdjoinFinsetCone A).π.app M.stage) :=
      Over.postPullbackIso B.inclusion g ≪≫ Functor.isoWhiskerLeft G₀ (Over.pullbackCongr hg)
    let ξW : F.obj ((Over.pullback g).obj Wo) ≅ F.obj W := Θ.app Wo ≪≫ M.eW
    let ξR : F.obj ((Over.pullback g).obj Ro) ≅ F.obj R := Θ.app Ro ≪≫ M.eR
    have hξ : ∀ (a : Ro ⟶ Wo) (b : R ⟶ W), 
        (Over.pullback ((specAdjoinFinsetCone A).π.app M.stage)).map (G₀.map a) ≫ M.eW.hom =
          M.eR.hom ≫ F.map b →
        F.map ((Over.pullback g).map a) ≫ ξW.hom = ξR.hom ≫ F.map b := fun a b h'' => by
      have h' : F.map ((Over.pullback g).map a) ≫ Θ.hom.app Wo =
          Θ.hom.app Ro ≫ (Over.pullback ((specAdjoinFinsetCone A).π.app M.stage)).map
            (G₀.map a) := Θ.hom.naturality a
      exact ((reassoc_of% h') M.eW.hom).trans
        ((congrArg (Θ.hom.app Ro ≫ ·) h'').trans (Category.assoc _ _ _).symm)
    have hξs := hξ sR r₁ (by rw [hsR]; exact M.hs)
    have hξt := hξ tR r₂ (by rw [htR]; exact M.ht)
    obtain ⟨e, he⟩ := exists_iso_relocalizeRestrict_of_quotient B hX p r₁ r₂ hps hpe hR h₀ sR tR
      (isEtaleEquivalenceRelation_of_witnesses B S₀ h₀ sR tR hsE htE hjm refl hr₁ hr₂ symm hσ₁ hσ₂
        comp hc₁ hc₂) hX₀ q hqs hqe hqk g (hFF.preimageIso ξW) (hFF.preimageIso ξR)
      (hFF.map_injective (by simpa using hξs)) (hFF.map_injective (by simpa using hξt))
    exact ⟨e, hFF.preimageIso ξW, he⟩

include B in
/-- **A model of an algebraic space of finite presentation over a ring of finite type over `ℤ`.**
Let `X` be an algebraic space of finite presentation over `Spec A`. Then for some finite subset
`k ⊆ A`, with `A₀ = ℤ[k] ⊆ A`, there is an algebraic space `X₀` of finite presentation over
`Spec A₀` whose base change along `Spec A ⟶ Spec A₀` is `X`. If `X` is separated, or flat, over
`Spec A`, then `X₀` can be chosen separated, respectively flat, over `Spec A₀`. -/
theorem exists_stageModel (hX : IsAlgebraicSpace B (Spec (.of A)) hA X)
    (f : X ⟶ yoneda.obj (Over.mk (𝟙 (B.obj hA))))
    (hfp : IsFinitePresentation B (Spec (.of A)) hA f) :
    ∃ (i : (Finset A)ᵒᵖ) (X₀ : (BigFppfOver B ((specAdjoinFinsetDiagram A).obj i)
        (contains_specAdjoinFinsetDiagram_obj B i))ᵒᵖ ⥤ Type u)
      (_ : IsAlgebraicSpace B _ (contains_specAdjoinFinsetDiagram_obj B i) X₀)
      (f₀ : X₀ ⟶ yoneda.obj (Over.mk (𝟙 (B.obj (contains_specAdjoinFinsetDiagram_obj B i))))),
      IsFinitePresentation B _ _ f₀ ∧
      (IsSeparated B (Spec (.of A)) hA f → IsSeparated B _ _ f₀) ∧
      (IsFlat B (Spec (.of A)) hA f → IsFlat B _ _ f₀) ∧
      ∀ (g : B.obj hA ⟶ B.obj (contains_specAdjoinFinsetDiagram_obj B i)),
        B.inclusion.map g = (specAdjoinFinsetCone A).π.app i →
        Nonempty (X ≅ (OverShriek.relocalizeRestrict g).obj X₀) := by
  obtain ⟨W, c, hW, hcs, hce⟩ :=
    exists_isAffine_isEtale_isSurjective_chart_of_isQuasiCompact B (Spec (.of A)) hA hX f
      hfp.2.1
  obtain ⟨i, X₀, hX₀, f₀, h₁, h₂, h₃, W₀, q, -, -, -, h₄⟩ :=
    exists_stageModel_of_atlas B hX f hfp c hW hcs
      (presheaf_etale_of_isEtale B (Spec (.of A)) hA hce)
  exact ⟨i, X₀, hX₀, f₀, h₁, h₂, h₃, fun g hg => (h₄ g hg).elim fun e _ => ⟨e⟩⟩

end AlgebraicGeometry.Space
