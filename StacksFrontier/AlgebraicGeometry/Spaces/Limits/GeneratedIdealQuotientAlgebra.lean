module

public import StacksFrontier.AlgebraicGeometry.Spaces.FinitePresentationChartSections
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeChartSections
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AffineCartesianAlgebraSheaf

/-!
# The quotient of a quasi-coherent algebra by the ideal generated by a module

Let `ℬ` be a quasi-coherent algebra on an algebraic space `X`, `N` a quasi-coherent module and
`n : N ⟶ ℬ` a morphism of `𝒪_X`-modules.  This file builds the algebra sheaf `ℬ/(n(N))` as the
sheafification of the presheaf of rings `U ↦ ℬ(U)/(n(N(U)))`, and proves:

* over an affine étale chart its ring of sections is `ℬ(U)/(n(N(U)))`;
* it is quasi-coherent;
* it is of finite presentation when `ℬ` is and `N` is of finite type.

The presheaf is cartesian on affine charts: a morphism `V ⟶ U` of affine charts identifies
`ℬ(V)` with `𝒪(V) ⊗ ℬ(U)` and `N(V)` with `𝒪(V) ⊗ N(U)`, and a base change of a quotient by the
ideal generated by the image of a module is the quotient by the ideal generated by the image of
the base change (`TensorProduct.bijective_quotient_baseChange`).

## Main definitions

* `AlgebraicGeometry.Space.GenQuot.presheaf`: the presheaf `U ↦ ℬ(U)/(n(N(U)))`.
* `AlgebraicGeometry.Space.GenQuot.algebra`: its sheafification, as an algebra sheaf.

## Main results

* `AlgebraicGeometry.Space.GenQuot.bijective_unit_app`: the sheafification unit is bijective
  over affine charts.
* `AlgebraicGeometry.Space.GenQuot.isQuasicoherent_algebra` and
  `AlgebraicGeometry.Space.GenQuot.isFinitePresentation_algebra`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct Stacks.PresheafOfModules

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

namespace GenQuot

variable {ℬ : AlgebraSheaf.{u, u} B S hS F hF} {N : Modules.{u, u} B S hS F hF}
  (n : N ⟶ AlgebraSheaf.underlyingModule ℬ)

/-- The ideal of `ℬ(U)` generated by the image of `N(U)`. -/
def sectionIdeal (U : (SmallEtale B S hS F)ᵒᵖ) : Ideal (ℬ.right.obj.obj U) :=
  Ideal.span (Set.range fun m : N.val.obj U => (n.val.app U m : ℬ.right.obj.obj U))

/-- Restriction along `f : U ⟶ V` carries the ideal generated by `n(N(U))` into the ideal
generated by `n(N(V))`. -/
theorem map_mem_sectionIdeal {U V : (SmallEtale B S hS F)ᵒᵖ} (f : U ⟶ V) :
    sectionIdeal n U ≤ (sectionIdeal n V).comap (ℬ.right.obj.map f).hom := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨m, rfl⟩
  exact Ideal.subset_span ⟨N.val.map f m, PresheafOfModules.naturality_apply n.val f m⟩

/-- **The presheaf `U ↦ ℬ(U)/(n(N(U)))`.** -/
noncomputable def presheaf : (SmallEtale B S hS F)ᵒᵖ ⥤ CommRingCat.{u} where
  obj U := CommRingCat.of (ℬ.right.obj.obj U ⧸ sectionIdeal n U)
  map f := CommRingCat.ofHom
    (Ideal.quotientMap _ (ℬ.right.obj.map f).hom (map_mem_sectionIdeal n f))
  map_id U := by
    refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun a => ?_))
    change Ideal.Quotient.mk _ ((ℬ.right.obj.map (𝟙 U)).hom a) = Ideal.Quotient.mk _ a
    rw [ℬ.right.obj.map_id]
    rfl
  map_comp f g := by
    refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun a => ?_))
    change Ideal.Quotient.mk _ ((ℬ.right.obj.map (f ≫ g)).hom a) =
      Ideal.Quotient.mk _ ((ℬ.right.obj.map g).hom ((ℬ.right.obj.map f).hom a))
    rw [ℬ.right.obj.map_comp]
    rfl

/-- The quotient map `ℬ(U) ⟶ ℬ(U)/(n(N(U)))`. -/
noncomputable abbrev mk (U : (SmallEtale B S hS F)ᵒᵖ) :
    ℬ.right.obj.obj U →+* (presheaf n).obj U :=
  Ideal.Quotient.mk (sectionIdeal n U)

/-- The quotient maps, as a morphism of presheaves of rings. -/
noncomputable def toPresheaf : ℬ.right.obj ⟶ presheaf n where
  app U := CommRingCat.ofHom (mk n U)
  naturality {U V} f := by
    ext a
    rfl

/-- The structure map `𝒪 ⟶ ℬ/(n(N))`. -/
noncomputable def structureMap : structurePresheaf B S hS F ⟶ presheaf n :=
  ℬ.hom.hom ≫ toPresheaf n

/-- The structure map sends a section `r` of `𝒪` to the class of its image in `ℬ(U)`. -/
theorem structureMap_app_apply (U : (SmallEtale B S hS F)ᵒᵖ)
    (r : (structurePresheaf B S hS F).obj U) :
    (structureMap n).app U r = mk n U (ℬ.algebraMap U r) :=
  rfl

/-- **The presheaf `U ↦ ℬ(U)/(n(N(U)))` is cartesian on affine charts**, for `ℬ` and `N`
quasi-coherent. -/
theorem isAffineCartesian (hℬ : ℬ.IsQuasicoherent) (hN : N.IsQuasicoherentOnSite) :
    AffineCartesian.IsAffineCartesian (presheaf n) (structureMap n) := by
  intro U V hU hV f
  have hℬc := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF _ hℬ
  have hNs : Function.Surjective (sectionsBaseChange N f) :=
    (isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF N hN U V hU hV f).2
  rw [chartBaseChange_surjective_iff_span_eq_top] at hNs
  let u : N.val.obj (op U) →ₛₗ[chartRestrict (hF := hF) f] N.val.obj (op V) :=
    { toFun := fun m => chartRestrictLinear N f m
      map_add' := fun m m' => map_add (chartRestrictLinear N f) m m'
      map_smul' := fun r m => (N.val.restrictₛₗ f.op).map_smulₛₗ r m }
  have hu : ∀ m' : N.val.obj (op V),
      m' ∈ Submodule.span (chartRing B S hS F hF V) (Set.range u) := fun m' => by
    show m' ∈ Submodule.span (chartRing B S hS F hF V)
      (Set.range fun x : N.val.obj (op U) => chartRestrictLinear N f x)
    rw [hNs]
    exact Submodule.mem_top
  let := chartAlgebra (hF := hF) f
  have hc : ∀ (b : chartRing B S hS F hF V) (x : (AlgebraSheaf.underlyingModule ℬ).val.obj (op U)),
      sectionsBaseChange (AlgebraSheaf.underlyingModule ℬ) f (b ⊗ₜ x) =
        ℬ.algebraMap (op V) b * (ℬ.right.obj.map f.op).hom x :=
    fun b x => chartBaseChange_tmul (AlgebraSheaf.underlyingModule ℬ) f b x
  refine TensorProduct.bijective_quotient_baseChange (R := chartRing B S hS F hF U)
    (R' := chartRing B S hS F hF V) (chartRestrict f) (ℬ.algebraMap (op U))
    (ℬ.algebraMap (op V)) (ℬ.right.obj.map f.op).hom
    ⟨(sectionsBaseChange (AlgebraSheaf.underlyingModule ℬ) f).toAddMonoidHom, hc,
      hℬc U V hU hV f⟩
    u hu (n.val.app (op U)).hom (n.val.app (op V)).hom
    (fun m => (PresheafOfModules.naturality_apply n.val f.op m).symm)
    (mk n (op U)) Ideal.Quotient.mk_surjective Ideal.mk_ker
    (mk n (op V)) Ideal.Quotient.mk_surjective Ideal.mk_ker
    (instQ := ((AffineCartesian.sectionsModule (presheaf n) (structureMap n)).obj
      (op U)).isModule)
    (fun r a => (map_mul (mk n (op U)) _ a).symm)
    (restrictionBaseChange.{u + 1, u, u, u}
      (AffineCartesian.sectionsModule (presheaf n) (structureMap n)) f.op).hom.toAddMonoidHom
    (fun b a => ?_)
  exact (restrictionBaseChange_tmul.{u + 1, u, u, u}
    (AffineCartesian.sectionsModule (presheaf n) (structureMap n)) f.op b (mk n (op U) a)).trans
      (map_mul (mk n (op V)) _ _).symm

variable (hF) in
/-- **The quotient `ℬ/(n(N))`, as an algebra sheaf.** -/
noncomputable def algebra : AlgebraSheaf.{u, u} B S hS F hF :=
  AffineCartesian.algebra (presheaf n) (structureMap n) hF

/-- The sheafification unit `ℬ(U)/(n(N(U))) ⟶ (ℬ/(n(N)))(U)`. -/
noncomputable abbrev unit : presheaf n ⟶ (algebra hF n).right.obj :=
  toSheafify (SmallEtale.topology B S hS F) (presheaf n)

/-- **Over an affine chart the sections of `ℬ/(n(N))` are `ℬ(U)/(n(N(U)))`.** -/
theorem bijective_unit_app (hℬ : ℬ.IsQuasicoherent) (hN : N.IsQuasicoherentOnSite)
    (U : SmallEtale B S hS F) (hU : IsAffine (smallEtaleScheme B S hS F U)) :
    Function.Bijective ((unit n).app (op U)) :=
  AffineCartesian.bijective_toSheafify_app hF (isAffineCartesian n hℬ hN) U hU

/-- **`ℬ/(n(N))` is quasi-coherent.** -/
theorem isQuasicoherent_algebra (hℬ : ℬ.IsQuasicoherent) (hN : N.IsQuasicoherentOnSite) :
    (algebra hF n).IsQuasicoherent :=
  AffineCartesian.isQuasicoherent_algebra hF (isAffineCartesian n hℬ hN)

/-- The ideal of sections generated by a module of finite type over an affine chart is finitely
generated. -/
theorem fg_sectionIdeal (hN : N.IsQuasicoherentOnSite)
    (hNft : SheafOfModules.IsFiniteTypeOnSite N) (U : SmallEtale B S hS F)
    (hU : IsAffine ((SmallEtale.toOver B S hS F ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (sectionIdeal n (op U)).FG := by
  classical
  obtain ⟨s, hs⟩ := (module_finite_sections_of_isFiniteTypeOnSite N hN hNft U hU).1
  let g : N.val.obj (op U) → ℬ.right.obj.obj (op U) :=
    fun m => show ℬ.right.obj.obj (op U) from n.val.app (op U) m
  refine ⟨Finset.image g s, ?_⟩
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ hx
    obtain ⟨m, -, rfl⟩ := Finset.mem_image.1 hx
    exact Ideal.subset_span ⟨m, rfl⟩
  · rintro _ ⟨m, rfl⟩
    have hm := Eq.mpr (congrArg (fun P => m ∈ P) hs)
      (Submodule.mem_top (R := chartRing B S hS F hF U) (M := N.val.obj (op U)) (x := m))
    refine Submodule.span_induction (p := fun m _ => g m ∈
        Ideal.span ((Finset.image g s : Finset (ℬ.right.obj.obj (op U))) :
          Set (ℬ.right.obj.obj (op U)))) ?_ ?_ ?_ ?_ hm
    · intro x hx
      exact Ideal.subset_span (Finset.mem_image_of_mem _ hx)
    · show n.val.app (op U) 0 ∈ _
      rw [map_zero]
      exact zero_mem _
    · intro x y _ _ hx hy
      show n.val.app (op U) (x + y) ∈ _
      rw [map_add]
      exact add_mem hx hy
    · intro r x _ hx
      rw [show g (r • x) = ℬ.algebraMap (op U) r * g x from (n.val.app (op U)).hom.map_smul r x]
      exact Ideal.mul_mem_left _ _ hx

/-- **`ℬ/(n(N))` is of finite presentation** when `ℬ` is quasi-coherent of finite presentation and
`N` is quasi-coherent of finite type. -/
theorem isFinitePresentation_algebra (hℬ : ℬ.IsQuasicoherent) (hℬfp : ℬ.IsFinitePresentation)
    (hN : N.IsQuasicoherentOnSite) (hNft : SheafOfModules.IsFiniteTypeOnSite N) :
    (algebra hF n).IsFinitePresentation := by
  intro U hU
  have hb := bijective_unit_app n hℬ hN U hU
  have h1 : ((mk n (op U)).comp (ℬ.algebraMap (op U))).FinitePresentation :=
    RingHom.FinitePresentation.comp_surjective (hℬfp U hU) Ideal.Quotient.mk_surjective
      (by
        have hk : RingHom.ker (mk n (op U)) = sectionIdeal n (op U) := Ideal.mk_ker
        rw [hk]
        exact fg_sectionIdeal n hN hNft U hU)
  have h2 : ((unit n).app (op U)).hom.FinitePresentation :=
    RingHom.FinitePresentation.of_surjective _ hb.2
      ((RingHom.injective_iff_ker_eq_bot _).mp hb.1 ▸ Submodule.fg_bot)
  exact h2.comp h1

/-! ### Morphisms -/

section Hom

/-- Morphisms out of `ℬ/(n(N))` agree as soon as they agree on the classes of sections of `ℬ`. -/
theorem hom_ext {𝒜 : AlgebraSheaf.{u, u} B S hS F hF} {g g' : algebra hF n ⟶ 𝒜}
    (h : ∀ (U : (SmallEtale B S hS F)ᵒᵖ) (a : ℬ.right.obj.obj U),
      g.right.hom.app U ((unit n).app U (mk n U a)) =
        g'.right.hom.app U ((unit n).app U (mk n U a))) :
    g = g' :=
  AffineCartesian.hom_ext hF fun U x => by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact h U a

variable {ℬ' : AlgebraSheaf.{u, u} B S hS F hF} {N' : Modules.{u, u} B S hS F hF}
  {n' : N' ⟶ AlgebraSheaf.underlyingModule ℬ'}

/-- The morphism of presheaves `ℬ/(n(N)) ⟶ ℬ'/(n'(N'))` induced by `β : ℬ ⟶ ℬ'` carrying the first
ideal into the second. -/
noncomputable def presheafMap (β : ℬ ⟶ ℬ')
    (hβ : ∀ U, sectionIdeal n U ≤ (sectionIdeal n' U).comap (β.right.hom.app U).hom) :
    presheaf n ⟶ presheaf n' where
  app U := CommRingCat.ofHom (Ideal.quotientMap _ (β.right.hom.app U).hom (hβ U))
  naturality {U V} f := by
    refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun a => ?_))
    change mk n' V ((β.right.hom.app V) ((ℬ.right.obj.map f) a)) =
      mk n' V ((ℬ'.right.obj.map f) ((β.right.hom.app U) a))
    rw [← ConcreteCategory.comp_apply, β.right.hom.naturality]
    rfl

/-- The induced presheaf map sends the class of `a` to the class of `β a`. -/
theorem presheafMap_app_mk (β : ℬ ⟶ ℬ')
    (hβ : ∀ U, sectionIdeal n U ≤ (sectionIdeal n' U).comap (β.right.hom.app U).hom)
    (U : (SmallEtale B S hS F)ᵒᵖ) (a : ℬ.right.obj.obj U) :
    (presheafMap n β hβ).app U (mk n U a) = mk n' U (β.right.hom.app U a) :=
  rfl

/-- The induced presheaf map is compatible with the structure maps from `𝒪`. -/
theorem structureMap_presheafMap (β : ℬ ⟶ ℬ')
    (hβ : ∀ U, sectionIdeal n U ≤ (sectionIdeal n' U).comap (β.right.hom.app U).hom) :
    structureMap n ≫ presheafMap n β hβ = structureMap n' := by
  ext U r
  exact congrArg (mk n' U) (β.comm U r)

variable (hF) in
/-- The morphism `ℬ/(n(N)) ⟶ ℬ'/(n'(N'))` of algebra sheaves induced by `β`. -/
noncomputable def map (β : ℬ ⟶ ℬ')
    (hβ : ∀ U, sectionIdeal n U ≤ (sectionIdeal n' U).comap (β.right.hom.app U).hom) :
    algebra hF n ⟶ algebra hF n' :=
  AffineCartesian.map hF (presheafMap n β hβ) (structureMap_presheafMap n β hβ)

/-- The induced morphism `map hF n β hβ` sends the image of the class of `a` to the image of the
class of `β a`. -/
theorem map_app_unit (β : ℬ ⟶ ℬ')
    (hβ : ∀ U, sectionIdeal n U ≤ (sectionIdeal n' U).comap (β.right.hom.app U).hom)
    (U : (SmallEtale B S hS F)ᵒᵖ) (a : ℬ.right.obj.obj U) :
    (map hF n β hβ).right.hom.app U ((unit n).app U (mk n U a)) =
      (unit n').app U (mk n' U (β.right.hom.app U a)) :=
  AffineCartesian.map_app_toSheafify hF _ _ U _

variable {𝒜 : AlgebraSheaf.{u, u} B S hS F hF}

/-- The presheaf map `ℬ/(n(N)) ⟶ 𝒜` induced by `ψ : ℬ ⟶ 𝒜` killing `n(N)`. -/
noncomputable def presheafLift (ψ : ℬ ⟶ 𝒜)
    (hψ : ∀ U (m : N.val.obj U), ψ.right.hom.app U (n.val.app U m) = 0) :
    presheaf n ⟶ 𝒜.right.obj where
  app U := CommRingCat.ofHom (Ideal.Quotient.lift _ (ψ.right.hom.app U).hom (by
    intro a ha
    refine Submodule.span_induction (p := fun a _ => (ψ.right.hom.app U) a = 0) ?_ ?_ ?_ ?_ ha
    · rintro _ ⟨m, rfl⟩
      exact hψ U m
    · exact map_zero _
    · intro x y _ _ hx hy
      rw [map_add, hx, hy, add_zero]
    · intro r x _ hx
      rw [smul_eq_mul, map_mul, hx, mul_zero]))
  naturality {U V} f := by
    refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun a => ?_))
    change (ψ.right.hom.app V) ((ℬ.right.obj.map f) a) =
      (𝒜.right.obj.map f) ((ψ.right.hom.app U) a)
    rw [← ConcreteCategory.comp_apply, ψ.right.hom.naturality]
    rfl

/-- The induced presheaf map to `𝒜` is compatible with the structure maps from `𝒪`. -/
theorem structureMap_presheafLift (ψ : ℬ ⟶ 𝒜)
    (hψ : ∀ U (m : N.val.obj U), ψ.right.hom.app U (n.val.app U m) = 0) :
    structureMap n ≫ presheafLift n ψ hψ = 𝒜.hom.hom := by
  ext U r
  exact ψ.comm U r

variable (hF) in
/-- The morphism `ℬ/(n(N)) ⟶ 𝒜` of algebra sheaves induced by `ψ : ℬ ⟶ 𝒜` killing `n(N)`. -/
noncomputable def lift (ψ : ℬ ⟶ 𝒜)
    (hψ : ∀ U (m : N.val.obj U), ψ.right.hom.app U (n.val.app U m) = 0) :
    algebra hF n ⟶ 𝒜 :=
  AffineCartesian.lift hF (presheafLift n ψ hψ) (structureMap_presheafLift n ψ hψ)

/-- The induced morphism `lift hF n ψ hψ` sends the image of the class of `a` to `ψ a`. -/
theorem lift_app_unit (ψ : ℬ ⟶ 𝒜)
    (hψ : ∀ U (m : N.val.obj U), ψ.right.hom.app U (n.val.app U m) = 0)
    (U : (SmallEtale B S hS F)ᵒᵖ) (a : ℬ.right.obj.obj U) :
    (lift hF n ψ hψ).right.hom.app U ((unit n).app U (mk n U a)) = ψ.right.hom.app U a :=
  AffineCartesian.lift_app_toSheafify hF _ _ U _

end Hom

end GenQuot

end AlgebraicGeometry.Space

end
