/-!
# Proper, flat, finitely presented algebraic spaces over `Spec A` come from a finite type ring

Let `A` be a ring with `Spec A` in the big fppf site. The ring `A` is the filtered colimit of its
subrings `Λ_s` generated by the finite subsets `s ⊆ A`, each of finite type over `ℤ`, so `Spec A`
is the cofiltered limit of the affine schemes `Spec Λ_s`. This file sets up that inverse system as
the situation of Stacks 07SK over the final scheme, and descends a proper, flat, finitely
presented algebraic space `X ⟶ Spec A` to some `X_s ⟶ Spec Λ_s` with the same three properties.
That is the descent step of the fifth paragraph of the proof of Stacks 0DLN.

## Main definitions

* `AlgebraicGeometry.Space.adjoinRing`: the subring `Λ_s` of `A` generated by a finite subset,
  with `AlgebraicGeometry.Space.finiteType_adjoinRing` (it is of finite type over `ℤ`).
* `AlgebraicGeometry.Space.adjoinSiteDiagram` and `AlgebraicGeometry.Space.adjoinSiteCone`: the
  `Spec Λ_s` and the cone with vertex `Spec A`, in the big fppf site of the final scheme, with
  `AlgebraicGeometry.Space.isLimitAdjoinSiteCone`.
* `AlgebraicGeometry.Space.adjoinDescentSystem`: the system of their presheaves as the situation
  `AlgebraicGeometry.Stack.StackDescentSystem` of Stacks 07SK.
* `AlgebraicGeometry.Space.stageStructureDescentSystem`: the situation of Stacks 084W of the
  structure morphism of a space over a stage.

## Main results

* `AlgebraicGeometry.Space.exists_adjoinRing_model`: a proper, flat, finitely presented morphism
  `X ⟶ Spec A` is the base change of a proper, flat, finitely presented `X_s ⟶ Spec Λ_s` along
  `Spec A ⟶ Spec Λ_s`. Stacks 07SK and 08K0 are applied (as
  `AlgebraicGeometry.Space.exists_model_of_finitePresentation` and
  `AlgebraicGeometry.Space.MorphismDescentSystem.exists_isFlat_mapAt`); Stacks 08K1 is the
  hypothesis `h08K1`.

## Implementation notes

The subrings are written as `ULift ℤ`-subalgebras so that
`AlgebraicGeometry.AdjoinFinset.diagram`, whose base ring lives in the universe of the algebra,
applies; `AlgebraicGeometry.Space.uliftIntAlgebra` is the action, a local instance here.

The library's Stacks 07SK and Stacks 084W bound the cardinality of the index of the system by the
cofinality of the cutoff of the site. The finite subsets of `A` index the system, so the
statement asks for the cardinality of `A` to be below that cofinality; the source asks for nothing
of the kind.

## References

* [Stacks Project, Tag 07SK](https://stacks.math.columbia.edu/tag/07SK)
* [Stacks Project, Tag 08K0](https://stacks.math.columbia.edu/tag/08K0)
* [Stacks Project, Tag 08K1](https://stacks.math.columbia.edu/tag/08K1)
* [Stacks Project, Tag 084W](https://stacks.math.columbia.edu/tag/084W)
* [Stacks Project, Tag 0DLN](https://stacks.math.columbia.edu/tag/0DLN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

section Iso

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X X' Y Y' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- Properness, flatness and finite presentation together are unchanged by precomposing with an
isomorphism. -/
theorem isProper_isFlat_isFinitePresentation_isIso_comp_iff (e : X ⟶ X') [IsIso e]
    (q : X' ⟶ Y) :
    (IsProper B S hS (e ≫ q) ∧ IsFlat B S hS (e ≫ q) ∧ IsFinitePresentation B S hS (e ≫ q)) ↔
      (IsProper B S hS q ∧ IsFlat B S hS q ∧ IsFinitePresentation B S hS q) :=
  and_congr (isProper_isIso_comp_iff B S hS e q)
    (and_congr (holdsOnEveryEtaleChart_iso_comp_iff B S hS _ e q)
      (and_congr (holdsOnEveryEtaleChart_iso_comp_iff B S hS _ e q)
        (and_congr (isQuasiCompact_isIso_comp_iff B S hS e q)
          (isQuasiSeparated_isIso_comp_iff B S hS e q))))

/-- Properness, flatness and finite presentation together are unchanged by postcomposing with
an isomorphism. -/
theorem isProper_isFlat_isFinitePresentation_comp_isIso_iff (q : X ⟶ Y) (ι : Y ⟶ Y')
    [IsIso ι] :
    (IsProper B S hS (q ≫ ι) ∧ IsFlat B S hS (q ≫ ι) ∧ IsFinitePresentation B S hS (q ≫ ι)) ↔
      (IsProper B S hS q ∧ IsFlat B S hS q ∧ IsFinitePresentation B S hS q) :=
  and_congr (isProper_comp_isIso_iff B S hS q ι)
    (and_congr (holdsOnEveryEtaleChart_comp_iso_iff B S hS _ q ι)
      (and_congr (holdsOnEveryEtaleChart_comp_iso_iff B S hS _ q ι)
        (and_congr (isQuasiCompact_comp_isIso_iff B S hS q ι)
          (isQuasiSeparated_comp_isIso_iff B S hS q ι))))

end Iso

section FiniteTypeSubalgebras

/-- `ℤ`, lifted to the universe of `A`, acting on `A` through the characteristic map. It lets the
finitely generated subrings of `A` be written with
`AlgebraicGeometry.AdjoinFinset.diagram`, whose base ring lives in the universe of `A`. -/
abbrev uliftIntAlgebra (A : Type u) [CommRing A] : Algebra (ULift.{u} ℤ) A :=
  ((Int.castRingHom A).comp ULift.ringEquiv.toRingHom).toAlgebra

attribute [local instance] uliftIntAlgebra

/-- The subring of `A` generated by a finite subset `s`. -/
abbrev adjoinRing (A : Type u) [CommRing A] (s : Finset A) : Type u :=
  Algebra.adjoin (ULift.{u} ℤ) (s : Set A)

/-- The subring of `A` generated by a finite subset is a finite type `ℤ`-algebra. -/
instance finiteType_adjoinRing (A : Type u) [CommRing A] (s : Finset A) :
    Algebra.FiniteType ℤ (adjoinRing A s) := by
  let e : ℤ ≃+* ULift.{u} ℤ := ULift.ringEquiv.symm
  have : Algebra.FiniteType ℤ (ULift.{u} ℤ) :=
    Algebra.FiniteType.of_surjective e.toRingHom.toIntAlgHom
      (fun x => ⟨e.symm x, e.apply_symm_apply x⟩)
  have : Algebra.FiniteType (ULift.{u} ℤ) (adjoinRing A s) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset s)
  have : @IsScalarTower ℤ (ULift.{u} ℤ) (adjoinRing A s) Algebra.toSMul Algebra.toSMul
      Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext_int _ _)
  exact Algebra.FiniteType.trans (S := ULift.{u} ℤ) inferInstance inferInstance

variable (B : BigFppfSite.{u}) (hZ : B.Contains (⊤_ Scheme.{u}))

/-- The morphism of the big fppf site from an object to the final scheme. -/
abbrev toTerminalSite {X : Scheme.{u}} (hX : B.Contains X) : B.obj hX ⟶ B.obj hZ :=
  ObjectProperty.homMk (terminal.from X)

variable (A : Type u) [CommRing A] (hA : B.Contains (Spec (.of A)))

include hA in
/-- The spectrum of the subring of `A` generated by a finite subset lies in the site, the subring
embedding in `A` (Stacks 000R). -/
theorem contains_spec_adjoinRing (s : Finset A) :
    B.Contains (Spec (.of (adjoinRing A s))) :=
  B.contains_spec_of_injective hA (Algebra.adjoin (ULift.{u} ℤ) (s : Set A)).val.toRingHom
    Subtype.val_injective

/-- The inverse system of the spectra `Spec Λ_s` of the subrings `Λ_s` of `A` generated by the
finite subsets `s`, in the big fppf site. -/
def adjoinSchemesDiagram : (Finset A)ᵒᵖ ⥤ B.Schemes :=
  ObjectProperty.lift _ (AdjoinFinset.specDiagram (ULift.{u} ℤ) A)
    (fun s => contains_spec_adjoinRing B A hA s.unop)

/-- The morphisms of the system to the final scheme. -/
def adjoinSchemesToTerminal :
    adjoinSchemesDiagram B A hA ⟶ (Functor.const (Finset A)ᵒᵖ).obj (B.obj hZ) where
  app s := toTerminalSite B hZ (contains_spec_adjoinRing B A hA s.unop)
  naturality _ _ _ := B.inclusion.map_injective (terminal.hom_ext _ _)

/-- The inverse system of the `Spec Λ_s`, in the big fppf site of the final scheme. -/
def adjoinSiteDiagram : (Finset A)ᵒᵖ ⥤ BigFppfOver B (⊤_ Scheme.{u}) hZ :=
  Over.lift (adjoinSchemesDiagram B A hA) (adjoinSchemesToTerminal B hZ A hA)

/-- The cone with vertex `Spec A` over the system of the `Spec Λ_s`, in the big fppf site. -/
def adjoinSchemesCone : Cone (adjoinSchemesDiagram B A hA) where
  pt := B.obj hA
  π :=
    { app := fun s => ObjectProperty.homMk ((AdjoinFinset.specCone (ULift.{u} ℤ) A).π.app s)
      naturality := fun _ _ f => B.inclusion.map_injective
        ((AdjoinFinset.specCone (ULift.{u} ℤ) A).π.naturality f) }

/-- `Spec A` is the limit of the `Spec Λ_s` in the big fppf site. -/
def isLimitAdjoinSchemesCone : IsLimit (adjoinSchemesCone B A hA) :=
  isLimitOfReflects B.inclusion (AdjoinFinset.isLimitSpecCone (ULift.{u} ℤ) A)

/-- The cone with vertex `Spec A` over the system of the `Spec Λ_s`, in the big fppf site of the
final scheme. -/
def adjoinSiteCone : Cone (adjoinSiteDiagram B hZ A hA) :=
  Over.liftCone (adjoinSchemesDiagram B A hA) (adjoinSchemesToTerminal B hZ A hA)
    (adjoinSchemesCone B A hA) (toTerminalSite B hZ hA)
    (fun _ => B.inclusion.map_injective (terminal.hom_ext _ _))

/-- `Spec A` is the limit of the `Spec Λ_s` in the big fppf site of the final scheme. -/
def isLimitAdjoinSiteCone : IsLimit (adjoinSiteCone B hZ A hA) :=
  haveI : Nonempty (Finset A)ᵒᵖ := ⟨op ∅⟩
  Over.isLimitLiftCone _ _ _ _ _ (isLimitAdjoinSchemesCone B A hA)

/-- The limit of the presheaves represented by the `Spec Λ_s` is the presheaf represented by
`Spec A`. -/
def adjoinLimitIso :
    limit (adjoinSiteDiagram B hZ A hA ⋙ yoneda) ≅ yoneda.obj (Over.mk (toTerminalSite B hZ hA)) :=
  (limit.isLimit _).conePointUniqueUpToIso
    (isLimitOfPreserves yoneda (isLimitAdjoinSiteCone B hZ A hA))

/-- The identification `AlgebraicGeometry.Space.adjoinLimitIso` is compatible with the
projections to the stages. -/
theorem adjoinLimitIso_inv_π (s : (Finset A)ᵒᵖ) :
    (adjoinLimitIso B hZ A hA).inv ≫ limit.π (adjoinSiteDiagram B hZ A hA ⋙ yoneda) s =
      yoneda.map ((adjoinSiteCone B hZ A hA).π.app s) :=
  IsLimit.conePointUniqueUpToIso_inv_comp _ _ s

end FiniteTypeSubalgebras

section Descent

attribute [local instance] uliftIntAlgebra

variable (B : BigFppfSite.{u}) (hZ : B.Contains (⊤_ Scheme.{u}))
  (A : Type u) [CommRing A] (hA : B.Contains (Spec (.of A)))

/-- **The system of the `Spec Λ_s` as the situation of Stacks 07SK.** For a ring `A` whose
cardinality is below the cofinality of the cutoff of the site, the presheaves represented by the
spectra of the subrings `Λ_s` of `A` generated by its finite subsets `s` form a directed inverse
system of quasi-compact, quasi-separated algebraic spaces over the final scheme with affine
transition morphisms, indexed by a set small enough for Stacks 07SK. -/
def adjoinDescentSystem (hAsize : Cardinal.mk A < B.cutoff.ord.cof) :
    Stack.StackDescentSystem B (⊤_ Scheme.{u}) hZ hZ (Finset A) where
  diagram := adjoinSiteDiagram B hZ A hA ⋙ yoneda
  indexSize := by
    classical
    refine lt_of_le_of_lt ?_ (max_lt B.aleph0_lt_cutoff_cof hAsize)
    rw [← Cardinal.mk_congr (Opposite.equivToOpposite (α := Finset A))]
    exact (Cardinal.mk_le_of_surjective (f := fun l : List A => l.toFinset)
      (fun s => ⟨s.toList, Finset.toList_toFinset s⟩)).trans (Cardinal.mk_list_le_max A)
  homSize _ _ := (Cardinal.le_one_iff_subsingleton.mpr inferInstance).trans_lt
    (Cardinal.one_lt_aleph0.trans B.aleph0_lt_cutoff_cof)
  stage_isAlgebraicSpace _ := isAlgebraicSpace_yoneda B _ hZ _
  transition_affine {i j} _ := by
    have : IsAffine ((BigFppfOver.toScheme B _ hZ).obj ((adjoinSiteDiagram B hZ A hA).obj i)) :=
      inferInstanceAs (IsAffine (Spec (.of (adjoinRing A i.unop))))
    have : IsAffine ((BigFppfOver.toScheme B _ hZ).obj ((adjoinSiteDiagram B hZ A hA).obj j)) :=
      inferInstanceAs (IsAffine (Spec (.of (adjoinRing A j.unop))))
    exact isAffineHom_yoneda_map B _ hZ _
  stage_quasiCompact i := isQuasiCompactSpace_yoneda_of_isAffine B _ hZ _
    (inferInstanceAs (IsAffine (Spec (.of (adjoinRing A i.unop)))))
  stage_quasiSeparated i := isAbsolutelyQuasiSeparated_of_isQuasiSeparatedScheme B _ hZ
    (yoneda.obj _) hZ
    ⟨_, inferInstanceAs (QuasiSeparatedSpace (Spec (.of (adjoinRing A i.unop)))),
      ⟨Functor.RepresentableBy.yoneda _⟩⟩

end Descent

section ModelSystem

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
  [Nonempty I]

/-- **The situation of Stacks 084W attached to a space over a stage.** For an algebraic space
`X_i` of finite presentation over a stage `B_i` of the situation of Stacks 07SK, its structure
morphism `X_i ⟶ B_i`, read as a morphism of algebraic spaces over `B_i`. Its base change to a
stage `B_j` is `X_j ⟶ B_j ×_{B_i} B_i`, and to the limit it is `X ⟶ B ×_{B_i} B_i`. -/
def stageStructureDescentSystem (C : Stack.StackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) (Xi : Over (C.diagram.obj i)) (hXi : IsAlgebraicSpace B S hS Xi.left)
    (hXifp : IsFinitePresentation B S hS Xi.hom) : MorphismDescentSystem B S hS hZ I where
  base := C.diagram
  indexSize := (Cardinal.mk_congr (Opposite.equivToOpposite (α := I))).trans_lt C.indexSize
  base_isAlgebraicSpace j := C.stage_isAlgebraicSpace (op j)
  transition_affine := C.transition_affine
  limit_isAlgebraicSpace := C.limit_isAlgebraicSpace
  initial := i.unop
  source₀ := Xi.left
  target₀ := C.diagram.obj i
  sourceToBase := Xi.hom
  targetToBase := 𝟙 _
  map₀ := Xi.hom
  map₀_over := Category.comp_id _
  source₀_isAlgebraicSpace := hXi
  target₀_isAlgebraicSpace := C.stage_isAlgebraicSpace i
  base₀_quasiCompact := C.stage_quasiCompact i
  base₀_quasiSeparated := C.stage_quasiSeparated i
  source₀_quasiCompact := isQuasiCompactSpace_of_isFinitePresentation B S hS Xi.hom
    (C.stage_isAlgebraicSpace i) (C.stage_quasiCompact i) hXifp
  source₀_quasiSeparated := isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hXi
    (C.stage_quasiSeparated i) hXifp.2.2
  target₀_quasiCompact := C.stage_quasiCompact i
  target₀_quasiSeparated := C.stage_quasiSeparated i

end ModelSystem

section Model

attribute [local instance] uliftIntAlgebra

variable (B : BigFppfSite.{u}) (hZ : B.Contains (⊤_ Scheme.{u}))
  (A : Type u) [CommRing A] (hA : B.Contains (Spec (.of A)))

/-- **A proper, flat, finitely presented algebraic space over `Spec A` comes from a finite type
subring of `A`.** Let `A` be a ring whose cardinality is below the cofinality of the cutoff of the
site, and let `p : X ⟶ Spec A` be a proper, flat, finitely presented morphism of algebraic spaces
over the final scheme. Then for some finite subset `s` of `A` there are an algebraic space `X_s`
and a proper, flat, finitely presented morphism `f_s : X_s ⟶ Spec Λ_s`, where `Λ_s` is the
subring generated by `s`, of finite type over `ℤ`, such that `p` is the base change of `f_s`
along `Spec A ⟶ Spec Λ_s`.

This is the descent step of the fifth paragraph of the proof of Stacks 0DLN: `A` is the filtered
colimit of the `Λ_s` (`AlgebraicGeometry.AdjoinFinset.isColimitCocone`), so `Spec A` is the limit
of the `Spec Λ_s`, and Stacks 07SK, 08K0 and 08K1 descend `X`, its flatness and its properness to
a stage. Stacks 07SK (essential surjectivity) and Stacks 08K0 are
`AlgebraicGeometry.Space.exists_model_of_finitePresentation` and
`AlgebraicGeometry.Space.MorphismDescentSystem.exists_isFlat_mapAt`; Stacks 08K1 is the
hypothesis `h08K1`, stated at the situation of Stacks 084W. The bound on the cardinality of `A`
is the bound on the index of the system that the library's Stacks 07SK and Stacks 084W
(`AlgebraicGeometry.Space.MorphismDescentSystem.indexSize`) require. -/
theorem exists_adjoinRing_model
    (h08K1 : ∀ {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
      (D : MorphismDescentSystem B (⊤_ Scheme.{u}) hZ hZ I),
      IsProper B _ hZ D.mapLimit → IsLocallyOfFiniteType B _ hZ D.map₀ →
        ∃ (i : I) (hi : D.initial ≤ i), IsProper B _ hZ (D.mapAt i hi))
    (hAsize : Cardinal.mk A < B.cutoff.ord.cof)
    {X₀ : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u} (hX₀ : IsAlgebraicSpace B _ hZ X₀)
    (p : X₀ ⟶ yoneda.obj (Over.mk (toTerminalSite B hZ hA)))
    (hp : IsProper B _ hZ p ∧ IsFlat B _ hZ p ∧ IsFinitePresentation B _ hZ p) :
    ∃ (s : Finset A) (X₁ : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u)
      (_ : IsAlgebraicSpace B _ hZ X₁)
      (f₁ : X₁ ⟶ yoneda.obj ((adjoinSiteDiagram B hZ A hA).obj (op s))),
      (IsProper B _ hZ f₁ ∧ IsFlat B _ hZ f₁ ∧ IsFinitePresentation B _ hZ f₁) ∧
      ∃ π : X₀ ⟶ X₁,
        IsPullback π p f₁ (yoneda.map ((adjoinSiteCone B hZ A hA).π.app (op s))) := by
  classical
  let C := adjoinDescentSystem B hZ A hA hAsize
  let eL : limit C.diagram ≅ yoneda.obj (Over.mk (toTerminalSite B hZ hA)) :=
    adjoinLimitIso B hZ A hA
  have hL : IsAlgebraicSpace B _ hZ (limit C.diagram) := C.limit_isAlgebraicSpace
  have hY : IsAlgebraicSpace B _ hZ (yoneda.obj (Over.mk (toTerminalSite B hZ hA))) :=
    isAlgebraicSpace_yoneda B _ hZ _
  -- Stacks 07SK: `X` descends to a stage
  have hp'fp : IsFinitePresentation B _ hZ (p ≫ eL.inv) :=
    isFinitePresentation_comp_iso hX₀ hY hL p eL.symm hp.2.2
  obtain ⟨i, Xi, hXi, hXifp, ⟨eX⟩⟩ :=
    C.exists_stage_model_of_isFinitePresentation_over_limit hX₀ (p ≫ eL.inv) hp'fp
  let ε₀ : X₀ ≅ pullback (limit.π C.diagram i) Xi.hom :=
    (Over.forget _).mapIso eX ≪≫ pullbackSymmetry Xi.hom (limit.π C.diagram i)
  have hε₀ : ε₀.hom ≫ pullback.fst (limit.π C.diagram i) Xi.hom = p ≫ eL.inv := by
    show (eX.hom.left ≫ (pullbackSymmetry Xi.hom (limit.π C.diagram i)).hom) ≫
      pullback.fst (limit.π C.diagram i) Xi.hom = p ≫ eL.inv
    rw [Category.assoc, pullbackSymmetry_hom_comp_fst]
    exact Over.w eX.hom
  -- the situation of Stacks 084W, and everything read in its terms
  let M := stageStructureDescentSystem C i Xi hXi hXifp
  have : IsIso M.targetToBase := inferInstanceAs (IsIso (𝟙 (C.diagram.obj i)))
  let eM : limit M.base ≅ yoneda.obj (Over.mk (toTerminalSite B hZ hA)) := eL
  have heM : ∀ s, eM.inv ≫ limit.π M.base s = yoneda.map ((adjoinSiteCone B hZ A hA).π.app s) :=
    adjoinLimitIso_inv_π B hZ A hA
  let πL := limit.π M.base (op M.initial)
  let ε : X₀ ≅ pullback πL M.sourceToBase := ε₀
  have hε : ε.hom ≫ pullback.fst πL M.sourceToBase = p ≫ eM.inv := hε₀
  -- the base change of `X_i ⟶ B_i` to the limit is `X ⟶ Spec A`, up to isomorphisms
  have : IsIso (pullback.fst πL M.targetToBase) :=
    (IsPullback.of_hasPullback πL M.targetToBase).isIso_fst_of_isIso
  let eτ : pullback πL M.targetToBase ≅ limit M.base := asIso (pullback.fst πL M.targetToBase)
  have h₁ : M.mapLimit ≫ eτ.hom = pullback.fst πL M.sourceToBase := M.mapLimit_fst
  have hfst : pullback.fst πL M.sourceToBase = ε.inv ≫ (p ≫ eM.inv) := (Iso.eq_inv_comp ε).2 hε
  have hmapLimit : M.mapLimit = (ε.inv ≫ (p ≫ eM.inv)) ≫ eτ.inv :=
    (Iso.eq_comp_inv eτ).2 (h₁.trans hfst)
  have hLimit : IsProper B _ hZ M.mapLimit ∧ IsFlat B _ hZ M.mapLimit ∧
      IsFinitePresentation B _ hZ M.mapLimit := by
    rw [hmapLimit]
    exact (isProper_isFlat_isFinitePresentation_comp_isIso_iff B _ hZ _ eτ.inv).2
      ((isProper_isFlat_isFinitePresentation_isIso_comp_iff B _ hZ ε.inv _).2
        ((isProper_isFlat_isFinitePresentation_comp_isIso_iff B _ hZ p eM.inv).2 hp))
  -- Stacks 08K0 and Stacks 08K1: flatness and properness at stages
  obtain ⟨j₁, le₁, hflat⟩ := M.exists_isFlat_mapAt hLimit.2.1 hXifp.1
  obtain ⟨j₂, le₂, hprop⟩ := h08K1 M hLimit.1
    (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B _ hZ hXifp.1)
  obtain ⟨k, hk₁, hk₂⟩ : ∃ k, j₁ ≤ k ∧ j₂ ≤ k := ⟨j₁ ⊔ j₂, le_sup_left, le_sup_right⟩
  have hk : M.initial ≤ k := le₁.trans hk₁
  have hflatk : IsFlat B _ hZ (M.mapAt k hk) := by
    obtain ⟨α, β, hpb⟩ := M.exists_isPullback_mapAt_of_le le₁ hk₁
    exact (isFlat_isStableUnderBaseChange B _ hZ).of_isPullback
      (isPullback_homMk B _ hZ (M.sourceAt_isAlgebraicSpace j₁ le₁)
        (M.targetAt_isAlgebraicSpace k hk) (M.targetAt_isAlgebraicSpace j₁ le₁)
        (M.sourceAt_isAlgebraicSpace k hk) hpb) hflat
  have hpropk : IsProper B _ hZ (M.mapAt k hk) := by
    obtain ⟨α, β, hpb⟩ := M.exists_isPullback_mapAt_of_le le₂ hk₂
    exact isProper_of_isPullback B _ hZ (M.sourceAt_isAlgebraicSpace k hk)
      (M.sourceAt_isAlgebraicSpace j₂ le₂) (M.targetAt_isAlgebraicSpace k hk)
      (M.targetAt_isAlgebraicSpace j₂ le₂) hpb hprop
  have hfpk : IsFinitePresentation B _ hZ (M.mapAt k hk) :=
    isFinitePresentation_of_isPullback B _ hZ (M.sourceAt_isAlgebraicSpace k hk)
      M.source₀_isAlgebraicSpace (M.targetAt_isAlgebraicSpace k hk)
      M.target₀_isAlgebraicSpace (M.isPullback_mapAt k hk) hXifp
  -- the model `X_k ⟶ B_k`
  let bk := M.baseAtToInitial k hk
  have hf₁ : M.mapAt k hk ≫ pullback.fst bk M.targetToBase = pullback.fst bk M.sourceToBase :=
    M.mapAt_fst k hk
  have hprops : IsProper B _ hZ (pullback.fst bk M.sourceToBase) ∧
      IsFlat B _ hZ (pullback.fst bk M.sourceToBase) ∧
      IsFinitePresentation B _ hZ (pullback.fst bk M.sourceToBase) := by
    have : @IsIso _ _ (M.targetAt k hk) (M.base.obj (op k)) (pullback.fst bk M.targetToBase) :=
      (IsPullback.of_hasPullback bk M.targetToBase).isIso_fst_of_isIso
    rw [← hf₁]
    exact (isProper_isFlat_isFinitePresentation_comp_isIso_iff B _ hZ (M.mapAt k hk)
      (pullback.fst bk M.targetToBase)).2 ⟨hpropk, hflatk, hfpk⟩
  -- the square exhibiting `X` as the base change of `X_k`
  let πk := limit.π M.base (op k)
  have hw : πk ≫ bk = πL := limit.w M.base (homOfLE hk).op
  have hcond : (pullback.fst πL M.sourceToBase ≫ πk) ≫ bk =
      pullback.snd πL M.sourceToBase ≫ M.sourceToBase := by
    rw [Category.assoc, hw]
    exact pullback.condition
  let α' :=
    pullback.lift (pullback.fst πL M.sourceToBase ≫ πk) (pullback.snd πL M.sourceToBase) hcond
  have hα'snd : α' ≫ pullback.snd bk M.sourceToBase = pullback.snd πL M.sourceToBase :=
    pullback.lift_snd _ _ _
  have hα'fst : α' ≫ pullback.fst bk M.sourceToBase = pullback.fst πL M.sourceToBase ≫ πk :=
    pullback.lift_fst _ _ _
  have hsq₀ : IsPullback α' (pullback.fst πL M.sourceToBase) (pullback.fst bk M.sourceToBase)
      πk := by
    refine IsPullback.of_right (h₁₂ := pullback.snd bk M.sourceToBase) (h₂₂ := bk)
      (v₁₃ := M.sourceToBase) ?_ hα'fst (IsPullback.of_hasPullback bk M.sourceToBase).flip
    rw [hα'snd, hw]
    exact (IsPullback.of_hasPullback πL M.sourceToBase).flip
  have hcommsnd : pullback.fst πL M.sourceToBase ≫ eM.hom = ε.symm.hom ≫ p := by
    rw [Iso.symm_hom, Iso.eq_inv_comp, ← Category.assoc, hε, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
  have hcommg : πk ≫ (Iso.refl _).hom =
      eM.hom ≫ yoneda.map ((adjoinSiteCone B hZ A hA).π.app (op k)) :=
    (Category.comp_id _).trans ((eM.hom_inv_id_assoc πk).symm.trans
      (congrArg (fun x => eM.hom ≫ x) (heM (op k))))
  exact ⟨k, pullback bk M.sourceToBase, M.sourceAt_isAlgebraicSpace k hk,
    pullback.fst bk M.sourceToBase,
    hprops, ε.hom ≫ α',
    hsq₀.of_iso ε.symm (Iso.refl _) eM (Iso.refl _)
      ((Category.comp_id _).trans (ε.inv_hom_id_assoc α').symm) hcommsnd
      ((Category.comp_id _).trans (Category.id_comp _).symm) hcommg⟩

end Model

end AlgebraicGeometry.Space

