/-!
# A quasi-coherent algebra as a small directed colimit of finite type subalgebras

Let `Y` be a quasi-compact and quasi-separated algebraic space over a scheme `S` and `𝒜` a
quasi-coherent `𝒪_Y`-algebra.  This file writes `𝒜` as the colimit of a directed system of finite
type quasi-coherent subalgebras **indexed by a preorder of fewer than `B.cutoff` elements**, which
is what the proof of Stacks 07VT needs to apply Stacks 07SQ to the relative spectra of the stages.
When `𝒜` is integral the stages are finite (Algebra, Lemma 10.36.5 on affine charts,
`AlgebraicGeometry.Space.isFinite_subobject_iff_isFiniteType'`), so this is part (1) of
Stacks 082C on a small index.

The source's route is followed: a section of `𝒜` over an affine étale chart lies in a finite type
quasi-coherent submodule `ℱ` (the extension property behind Stacks 0829 and Stacks 07V9,
`AlgebraicGeometry.Space.chartExtensionProperty_id`), hence in the subalgebra generated by `ℱ`,
the image of `Sym(ℱ) ⟶ 𝒜`, which is quasi-coherent and of finite type.

## Main definitions

* `AlgebraicGeometry.Space.FiniteTypeSubalgebraIndex`: the sets of sections over one affine
  étale chart `U₀` of `Y`, with surjective structure morphism, of the finite type quasi-coherent
  subalgebras of `𝒜`, ordered by inclusion; with its diagram
  `AlgebraicGeometry.Space.FiniteTypeSubalgebraIndex.diagram` and cocone
  `AlgebraicGeometry.Space.FiniteTypeSubalgebraIndex.cocone`.

## Main results

* `AlgebraicGeometry.Space.SymAlgSheaf.isFiniteType_symmetricAlgebraSheaf`: the symmetric
  algebra of a quasi-coherent module of finite type is of finite type.
* `AlgebraicGeometry.Space.exists_finiteTypeSubalgebra_mem`: every section of `𝒜` over an affine
  étale chart lies in a finite type quasi-coherent subalgebra.
* `AlgebraicGeometry.Space.AlgebraSheaf.subobject_le_of_range_subset`: a quasi-coherent
  subalgebra whose sections over `U₀` lie among those of another subalgebra is contained in it.
* `AlgebraicGeometry.Space.FiniteTypeSubalgebraIndex.nonempty_isColimit_cocone`: `𝒜` is the
  colimit of the small system, and `AlgebraicGeometry.Space.FiniteTypeSubalgebraIndex.mk_le`
  bounds the index by `2 ^ #𝒜(U₀)`.

## References

* [Stacks Project, Tag 082C](https://stacks.math.columbia.edu/tag/082C)
* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
* [Stacks Project, Tag 07VT](https://stacks.math.columbia.edu/tag/07VT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **The symmetric algebra of a quasi-coherent module of finite type is of finite type.** -/
theorem SymAlgSheaf.isFiniteType_symmetricAlgebraSheaf (W : AlgebraicSpaces B S hS)
    (F : Modules.{u, u} B S hS W.1 W.2) (hF : F.IsQuasicoherentOnSite)
    (hft : SheafOfModules.IsFiniteTypeOnSite F) :
    (symmetricAlgebraSheaf B S hS W F).IsFiniteType := by
  intro U hU
  have : Module.Finite (chartRing B S hS W.1 W.2 U)
      ((SymAlgSheaf.FM B S hS W F).val.obj (op U)) :=
    module_finite_sections_of_isFiniteTypeOnSite F hF hft U hU
  have hSym : (algebraMap (chartRing B S hS W.1 W.2 U)
      (SymmetricAlgebra (chartRing B S hS W.1 W.2 U)
        ((SymAlgSheaf.FM B S hS W F).val.obj (op U)))).FiniteType :=
    SymmetricAlgebra.finiteType (chartRing B S hS W.1 W.2 U)
      ((SymAlgSheaf.FM B S hS W F).val.obj (op U))
  rw [← SymAlgSheaf.symSectionsRingHom_comp_algebraMap B S hS W F U]
  exact (RingHom.FiniteType.of_surjective _
    (SymAlgSheaf.symSectionsRingHom_bijective B S hS W F hF U hU).2).comp hSym

variable {Y : AlgebraicSpaces B S hS}

/-- **Every section of a quasi-coherent algebra over an affine étale chart of a quasi-compact
quasi-separated algebraic space lies in a finite type quasi-coherent subalgebra.** -/
theorem exists_finiteTypeSubalgebra_mem (hqc : IsQuasiCompactSpace B S hS Y.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal Y.1)
    (A : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) (hA : A.IsQuasicoherent)
    (U : SmallEtale B S hS Y.1) (hU : IsAffine (chartScheme U)) (x : A.right.obj.obj (op U)) :
    ∃ C : FiniteTypeSubalgebra B S hS Y.1 Y.2 A,
      x ∈ Set.range (C.obj.arrow.right.hom.app (op U)).hom := by
  set F := AlgebraSheaf.underlyingModule A
  have hF : IsCartesianOnAffineCharts F :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2 F hA
  obtain ⟨D, hD⟩ := chartExtensionProperty_id (hX := Y.2) B.contains_terminal hqc hqs hF U
    U.1.hom (Category.comp_id _) hU x
  set G := (D.toSubmodule F).toSheafOfModules
  have hGqc : G.IsQuasicoherentOnSite :=
    (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS Y.1 Y.2 _).2
      (D.isCartesianOnAffineCharts_toSubmodule hF)
  have hGft : SheafOfModules.IsFiniteTypeOnSite G := D.isFiniteTypeOnSite_toSubmodule hF
  set φ := SymAlgSheaf.algebraLift B S hS Y A G (D.toSubmodule F).ι
  have hSqc := SymAlgSheaf.isQuasicoherent_symmetricAlgebraSheaf B S hS Y G hGqc
  have hSft := SymAlgSheaf.isFiniteType_symmetricAlgebraSheaf Y G hGqc hGft
  have hqc' : (image φ).IsQuasicoherent := AlgebraSheaf.isQuasicoherent_image φ hSqc hA
  have hft' : (image φ).IsFiniteType := AlgebraSheaf.isFiniteType_image φ hSqc hA hSft
  refine ⟨⟨imageSubobject φ,
    AlgebraSheaf.IsQuasicoherent.of_iso (imageSubobjectIso φ).symm hqc',
    AlgebraSheaf.IsFiniteType.of_iso (imageSubobjectIso φ).symm hft'⟩, ?_⟩
  let s : G.val.obj (op U) := ⟨x, hD⟩
  refine ⟨((factorThruImageSubobject φ).right.hom.app (op U)).hom
    ((symmetricAlgebra B S hS Y G).ungradedIncl 1
      ((symmetricAlgebraGen B S hS Y G).val.app (op U) s)), ?_⟩
  exact (congrArg (fun t : symmetricAlgebraSheaf B S hS Y G ⟶ A =>
    (t.right.hom.app (op U)).hom ((symmetricAlgebra B S hS Y G).ungradedIncl 1
      ((symmetricAlgebraGen B S hS Y G).val.app (op U) s))) (imageSubobject_arrow_comp φ)).trans
    (SymAlgSheaf.algebraLift_ungradedIncl_gen B S hS Y A G (D.toSubmodule F).ι (op U) s)

/-- **A quasi-coherent subalgebra lies in a subalgebra as soon as it does over one affine chart
over which the other charts are covered.**  Let `U₀` be an affine étale chart of `Y` with
surjective structure morphism, and let `C`, `C'` be subalgebras of an algebra sheaf `A`, with `C`
quasi-coherent.  If the sections of `C` over `U₀` lie among those of `C'`, then `C ≤ C'`.

Over an affine chart `W` mapping to `U₀` the sections of `C` are combinations of restrictions of
sections over `U₀`, `C` being cartesian on affine charts, so they lie in `C'`; the affine charts
mapping to `U₀` cover every chart, `U₀` covering the final object of the small étale site; and
membership in the subsheaf `C'` is local. -/
theorem AlgebraSheaf.subobject_le_of_range_subset (A : AlgebraSheaf.{u, u} B S hS Y.1 Y.2)
    (U₀ : SmallEtale B S hS Y.1) (hU₀ : IsAffine (chartScheme U₀))
    (hsurj : IsSurjective B S hS U₀.1.hom) (C C' : Subobject A)
    (hC : (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).IsQuasicoherent)
    (h : Set.range (C.arrow.right.hom.app (op U₀)).hom ⊆
      Set.range (C'.arrow.right.hom.app (op U₀)).hom) :
    C ≤ C' := by
  have hstep1 : ∀ (W : SmallEtale B S hS Y.1), IsAffine (chartScheme W) → ∀ (g : W ⟶ U₀)
      (c : (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.obj.obj (op W)),
      (C.arrow.right.hom.app (op W)).hom c ∈ Set.range (C'.arrow.right.hom.app (op W)).hom := by
    intro W hW g c
    have hF := isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS Y.1 Y.2
      (AlgebraSheaf.underlyingModule (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2)) hC
    obtain ⟨t, ht⟩ := exists_finset_mem_span_chartRes hF hU₀ hW g c
    induction ht using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨z, -, rfl⟩ := hy
      obtain ⟨c', hc'⟩ := h ⟨z, rfl⟩
      refine ⟨((Subobject.underlying.obj C').right.obj.map g.op).hom c', ?_⟩
      rw [NatTrans.naturality_apply C'.arrow.right.hom g.op c', hc']
      exact (NatTrans.naturality_apply C.arrow.right.hom g.op z).symm
    | zero => exact ⟨0, by rw [map_zero, map_zero]⟩
    | add y y' _ _ hy hy' =>
      obtain ⟨a, ha⟩ := hy
      obtain ⟨a', ha'⟩ := hy'
      exact ⟨a + a', by rw [map_add, ha, ha']; exact (map_add _ y y').symm⟩
    | smul r y _ hy =>
      obtain ⟨a, ha⟩ := hy
      have key : ∀ (D : Subobject A) (z : (D : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.obj.obj
          (op W)), (D.arrow.right.hom.app (op W)).hom
            ((D : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).algebraMap (op W) r * z) =
          A.algebraMap (op W) r * (D.arrow.right.hom.app (op W)).hom z := fun D z =>
        (map_mul _ _ _).trans (congrArg (· * _) (D.arrow.comm (op W) r))
      exact ⟨_, (key C' a).trans ((congrArg (A.algebraMap (op W) r * ·) ha).trans
        (key C y).symm)⟩
  set G := Stacks.CategoryTheory.RingSubpresheaf.range C'.arrow.right.hom
  have hinj' : ∀ V, Function.Injective (C'.arrow.right.hom.app V).hom :=
    fun V => injective_subobject_arrow_app C' V
  have := Stacks.CategoryTheory.RingSubpresheaf.isIso_toRange C'.arrow.right.hom hinj'
  have hAsh : Presieve.IsSheaf (SmallEtale.topology B S hS Y.1)
      (A.right.obj ⋙ CategoryTheory.forget CommRingCat.{u}) :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      (GrothendieckTopology.HasSheafCompose.isSheaf _ A.right.property)
  have hC'sh : Presieve.IsSheaf (SmallEtale.topology B S hS Y.1)
      ((C' : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.obj ⋙
        CategoryTheory.forget CommRingCat.{u}) :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      (GrothendieckTopology.HasSheafCompose.isSheaf _
        (C' : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.property)
  have hGsh : Presieve.IsSheaf (SmallEtale.topology B S hS Y.1) G.toSubfunctor.toFunctor :=
    Presieve.isSheaf_iso _
      (Functor.isoWhiskerRight
        (asIso (Stacks.CategoryTheory.RingSubpresheaf.toRange C'.arrow.right.hom))
        (CategoryTheory.forget CommRingCat.{u}) ≪≫ G.forgetIso) hC'sh
  have hstep2 : ∀ (V : (SmallEtale B S hS Y.1)ᵒᵖ)
      (c : (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.obj.obj V),
      (C.arrow.right.hom.app V).hom c ∈ G.obj V := by
    intro V c
    refine Stacks.CategoryTheory.RingSubpresheaf.sheafify_le le_rfl hAsh hGsh V ?_
    rw [Stacks.CategoryTheory.RingSubpresheaf.mem_sheafify_iff]
    have hcov := SmallEtale.coversTop_of_isSurjective B S hS Y.1 Y.2 U₀ hsurj V.unop
    refine (SmallEtale.topology B S hS Y.1).transitive hcov _ fun T g hg => ?_
    obtain ⟨i, ⟨k⟩⟩ := hg
    refine (SmallEtale.topology B S hS Y.1).superset_covering ?_
      (SmallEtale.ofArrows_openChart_affineOpens_mem B S hS Y.1 T)
    intro W e he
    obtain ⟨O, e', rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 he
    refine Sieve.downward_closed _ ?_ e'
    change (A.right.obj.map (openChartInclusion B S hS Y.1 T O.down.1 ≫ g).op).hom
      ((C.arrow.right.hom.app V).hom c) ∈ G.obj _
    rw [← NatTrans.naturality_apply C.arrow.right.hom]
    obtain ⟨a, ha⟩ := hstep1 _ (isAffine_chartScheme_openChart B S hS Y.1 T O.down)
      (openChartInclusion B S hS Y.1 T O.down.1 ≫ k) _
    exact ⟨a, ha⟩
  let ψ₀ : (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.obj ⟶
      (C' : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).right.obj :=
    Stacks.CategoryTheory.RingSubpresheaf.lift C.arrow.right.hom hstep2 ≫
      inv (Stacks.CategoryTheory.RingSubpresheaf.toRange C'.arrow.right.hom)
  have hψ₀ : ψ₀ ≫ C'.arrow.right.hom = C.arrow.right.hom := by
    simp only [ψ₀, Category.assoc]
    rw [show inv (Stacks.CategoryTheory.RingSubpresheaf.toRange C'.arrow.right.hom) ≫
        C'.arrow.right.hom = G.ι from (IsIso.inv_comp_eq _).2
          (Stacks.CategoryTheory.RingSubpresheaf.toRange_ι C'.arrow.right.hom).symm,
      Stacks.CategoryTheory.RingSubpresheaf.lift_ι]
  let ψ : (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) ⟶ (C' : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) :=
    { right := ObjectProperty.homMk ψ₀
      comm := fun V r => by
        apply hinj' V
        have h1 := congrArg (fun t => (t.app V).hom
          ((C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2).algebraMap V r)) hψ₀
        simp only [NatTrans.comp_app, CommRingCat.comp_apply] at h1
        change (C'.arrow.right.hom.app V).hom (ψ₀.app V _) = _
        rw [h1, C.arrow.comm, C'.arrow.comm] }
  exact Subobject.le_of_comm ψ (AlgebraSheaf.Hom.ext (ObjectProperty.hom_ext _ hψ₀))

/-! ### A small directed system of finite type subalgebras -/

section SmallSystem

variable (A : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) (U₀ : SmallEtale B S hS Y.1)

/-- The sections over the chart `U₀` of a subalgebra of `A`, as a set of sections of `A`. -/
def AlgebraSheaf.chartRange (C : Subobject A) : Set (A.right.obj.obj (op U₀)) :=
  Set.range (C.arrow.right.hom.app (op U₀)).hom

/-- The sections over `U₀` of a subalgebra lie among those of any larger subalgebra. -/
theorem AlgebraSheaf.chartRange_mono {C C' : Subobject A} (h : C ≤ C') :
    AlgebraSheaf.chartRange A U₀ C ⊆ AlgebraSheaf.chartRange A U₀ C' := by
  rintro _ ⟨c, rfl⟩
  exact ⟨((Subobject.ofLE C C' h).right.hom.app (op U₀)).hom c,
    congrArg (fun t : (C : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) ⟶ A =>
      (t.right.hom.app (op U₀)).hom c) (Subobject.ofLE_arrow h)⟩

/-- **The index of the small system**: the sets of sections over `U₀` of the finite type
quasi-coherent subalgebras of `A`, ordered by inclusion.  It lives in the universe of the
schemes, and has at most `2 ^ #A(U₀)` elements. -/
def FiniteTypeSubalgebraIndex : Type u :=
  {T : Set (A.right.obj.obj (op U₀)) //
    ∃ C : FiniteTypeSubalgebra B S hS Y.1 Y.2 A, AlgebraSheaf.chartRange A U₀ C.obj = T}

/-- The index is ordered by inclusion of sets of sections. -/
instance : PartialOrder (FiniteTypeSubalgebraIndex A U₀) :=
  inferInstanceAs (PartialOrder {T : Set (A.right.obj.obj (op U₀)) //
    ∃ C : FiniteTypeSubalgebra B S hS Y.1 Y.2 A, AlgebraSheaf.chartRange A U₀ C.obj = T})

variable {A U₀}

/-- The finite type subalgebra chosen at an index. -/
def FiniteTypeSubalgebraIndex.stage (j : FiniteTypeSubalgebraIndex A U₀) :
    FiniteTypeSubalgebra B S hS Y.1 Y.2 A :=
  j.2.choose

/-- The sections over `U₀` of the subalgebra chosen at an index form that index. -/
theorem FiniteTypeSubalgebraIndex.chartRange_stage (j : FiniteTypeSubalgebraIndex A U₀) :
    AlgebraSheaf.chartRange A U₀ j.stage.obj = j.1 :=
  j.2.choose_spec

/-- The index of a finite type subalgebra. -/
def FiniteTypeSubalgebraIndex.ofSubalgebra (C : FiniteTypeSubalgebra B S hS Y.1 Y.2 A) :
    FiniteTypeSubalgebraIndex A U₀ :=
  ⟨AlgebraSheaf.chartRange A U₀ C.obj, C, rfl⟩

variable (hU₀ : IsAffine (chartScheme U₀)) (hsurj : IsSurjective B S hS U₀.1.hom)
include hU₀ hsurj

/-- The subalgebra chosen at an index is monotone in the index. -/
theorem FiniteTypeSubalgebraIndex.stage_mono :
    Monotone fun j : FiniteTypeSubalgebraIndex A U₀ => j.stage.obj := by
  intro j j' hjj'
  refine AlgebraSheaf.subobject_le_of_range_subset A U₀ hU₀ hsurj _ _ j.stage.property.1 ?_
  change AlgebraSheaf.chartRange A U₀ j.stage.obj ⊆ AlgebraSheaf.chartRange A U₀ j'.stage.obj
  rw [j.chartRange_stage, j'.chartRange_stage]
  exact hjj'

/-- A finite type subalgebra is contained in the subalgebra chosen at its index. -/
theorem FiniteTypeSubalgebraIndex.le_stage_ofSubalgebra
    (C : FiniteTypeSubalgebra B S hS Y.1 Y.2 A) :
    C.obj ≤ (FiniteTypeSubalgebraIndex.ofSubalgebra (U₀ := U₀) C).stage.obj := by
  refine AlgebraSheaf.subobject_le_of_range_subset A U₀ hU₀ hsurj _ _ C.property.1 ?_
  change AlgebraSheaf.chartRange A U₀ C.obj ⊆ AlgebraSheaf.chartRange A U₀ _
  rw [FiniteTypeSubalgebraIndex.chartRange_stage]
  rfl

omit hU₀ hsurj in
/-- For a quasi-coherent algebra sheaf `A`, the index is directed. -/
theorem FiniteTypeSubalgebraIndex.isDirected (hA : A.IsQuasicoherent) :
    IsDirected (FiniteTypeSubalgebraIndex A U₀) (· ≤ ·) := by
  refine ⟨fun j j' => ?_⟩
  have := isFiltered_finiteTypeSubalgebra Y A hA
  let E := IsFiltered.max j.stage j'.stage
  refine ⟨FiniteTypeSubalgebraIndex.ofSubalgebra E, ?_, ?_⟩
  · change j.1 ⊆ AlgebraSheaf.chartRange A U₀ E.obj
    rw [← j.chartRange_stage]
    exact AlgebraSheaf.chartRange_mono A U₀ (leOfHom (IsFiltered.leftToMax j.stage j'.stage).hom)
  · change j'.1 ⊆ AlgebraSheaf.chartRange A U₀ E.obj
    rw [← j'.chartRange_stage]
    exact AlgebraSheaf.chartRange_mono A U₀
      (leOfHom (IsFiltered.rightToMax j.stage j'.stage).hom)

omit hU₀ hsurj in
/-- For a quasi-coherent algebra sheaf `A`, the index is nonempty. -/
theorem FiniteTypeSubalgebraIndex.nonempty (hA : A.IsQuasicoherent) :
    Nonempty (FiniteTypeSubalgebraIndex A U₀) :=
  let ⟨C⟩ := nonempty_finiteTypeSubalgebra_of_isQuasicoherent B S hS Y A hA
  ⟨FiniteTypeSubalgebraIndex.ofSubalgebra C⟩

omit hU₀ hsurj in
/-- The index has at most `2 ^ #A(U₀)` elements. -/
theorem FiniteTypeSubalgebraIndex.mk_le :
    Cardinal.mk (FiniteTypeSubalgebraIndex A U₀) ≤ 2 ^ Cardinal.mk (A.right.obj.obj (op U₀)) := by
  rw [← Cardinal.mk_set]
  exact Cardinal.mk_le_of_injective Subtype.val_injective

/-- **The small system of finite type subalgebras**, as a diagram of algebra sheaves. -/
def FiniteTypeSubalgebraIndex.diagram :
    FiniteTypeSubalgebraIndex A U₀ ⥤ AlgebraSheaf.{u, u} B S hS Y.1 Y.2 :=
  (FiniteTypeSubalgebraIndex.stage_mono hU₀ hsurj).functor ⋙ Subobject.underlying

/-- The cocone of the inclusions of the stages into `A`. -/
def FiniteTypeSubalgebraIndex.cocone :
    Cocone (FiniteTypeSubalgebraIndex.diagram (A := A) hU₀ hsurj) where
  pt := A
  ι :=
    { app := fun j => j.stage.obj.arrow
      naturality := fun _ _ f => by
        simp only [Functor.const_obj_obj, Functor.const_obj_map]
        exact Subobject.underlying_arrow _ }

/-- The diagram sends an index to the subalgebra chosen at it. -/
theorem FiniteTypeSubalgebraIndex.diagram_obj (j : FiniteTypeSubalgebraIndex A U₀) :
    (FiniteTypeSubalgebraIndex.diagram (A := A) hU₀ hsurj).obj j =
      (j.stage.obj : AlgebraSheaf.{u, u} B S hS Y.1 Y.2) :=
  rfl

/-- **The small system has colimit `A`** (Stacks 082C(1), on a small index): every section of
`A` over an affine étale chart lies in a finite type quasi-coherent subalgebra, which lies in
the stage at its index. -/
theorem FiniteTypeSubalgebraIndex.nonempty_isColimit_cocone (hqc : IsQuasiCompactSpace B S hS Y.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal Y.1) (hA : A.IsQuasicoherent) :
    letI := FiniteTypeSubalgebraIndex.isDirected (U₀ := U₀) hA
    letI := FiniteTypeSubalgebraIndex.nonempty (U₀ := U₀) hA
    Nonempty (IsColimit (FiniteTypeSubalgebraIndex.cocone (A := A) hU₀ hsurj)) := by
  let := FiniteTypeSubalgebraIndex.isDirected (U₀ := U₀) hA
  let := FiniteTypeSubalgebraIndex.nonempty (U₀ := U₀) hA
  refine AlgebraSheaf.nonempty_isColimit_of_affineChartSections_of_injective _
    (fun U _ j => ?_) (fun U hU x => ?_)
  · rw [AlgebraSheaf.chartSectionsFunctor_map]
    exact AlgebraSheaf.injective_subobject_arrow_app j.stage.obj (op U)
  · obtain ⟨C, hC⟩ := exists_finiteTypeSubalgebra_mem hqc hqs A hA U hU x
    exact ⟨FiniteTypeSubalgebraIndex.ofSubalgebra C, AlgebraSheaf.chartRange_mono A U
      (FiniteTypeSubalgebraIndex.le_stage_ofSubalgebra hU₀ hsurj C) hC⟩

end SmallSystem

end AlgebraicGeometry.Space

end
