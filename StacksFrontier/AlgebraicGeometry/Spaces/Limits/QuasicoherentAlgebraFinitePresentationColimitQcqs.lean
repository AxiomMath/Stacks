module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeQuasicoherentSubobjectsQcqs
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AlgebraSheafColimits
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.IntegralAlgebraFiniteColimitQcqs
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.QuasicoherentAlgebraFinitePresentationColimit
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.SurjectiveFinitePresentationSystem

/-!
# A quasi-coherent algebra on a qcqs algebraic space is a directed colimit of finitely presented
quasi-coherent algebras

Let `S` be a scheme, `X` a quasi-compact and quasi-separated algebraic space over `S` and `𝒜` a
quasi-coherent `𝒪_X`-algebra.  Then `𝒜` is a directed colimit of finitely presented
quasi-coherent `𝒪_X`-algebras (Stacks 082A).

The construction of the source — the quotients `Sym(ℱᵢ)/(ℰ)` of the symmetric algebras of a
presentation `𝒜 = colim ℱᵢ` of the underlying module by modules of finite presentation, by the
ideals generated by finite type quasi-coherent submodules `ℰ` of the kernels of `Sym(ℱᵢ) ⟶ 𝒜` — is
`AlgebraicGeometry.Space.exists_isColimit_isFinitePresentation_quasicoherentAlgebra`, over its two
inputs Stacks 07V9 and the colimit clause of Stacks 0829.  On a quasi-compact and quasi-separated
algebraic space both hold, by
`AlgebraicGeometry.Space.exists_small_isFilteredColimit_isFinitePresentation` and
`AlgebraicGeometry.Space.nonempty_isColimit_finiteTypeQuasicoherentSubobjectCocone_of_qcqs`, and
the filtered system is then reindexed by a directed poset
(`Stacks.DirectedCokernelSystem.exists_directed_of_filtered_colimit`).

## Main results

* `AlgebraicGeometry.Space.exists_directed_isFinitePresentation_algebra_of_isQuasiCompactSpace`:
  **Stacks 082A**, with the colimit taken among all algebra sheaves.
* `AlgebraicGeometry.Space.exists_directed_isFinitePresentation_quasicoherentAlgebra`: the same
  in the category `AlgebraicGeometry.Space.QuasicoherentAlgebra`.

## References

* [Stacks Project, Tag 082A](https://stacks.math.columbia.edu/tag/082A)
* [Stacks Project, Tag 07V9](https://stacks.math.columbia.edu/tag/07V9)
* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- Let `S` be a scheme, `X` a quasi-compact and quasi-separated algebraic space over `S` and `𝒜` a
quasi-coherent `𝒪_X`-algebra.  Then `𝒜` is the colimit, in the category of all `𝒪_X`-algebras, of a
system of quasi-coherent `𝒪_X`-algebras of finite presentation indexed by a nonempty directed
partially ordered set.  The colimit is taken in `AlgebraicGeometry.Space.AlgebraSheaf`, which is
stronger than in the full subcategory of the quasi-coherent algebras. -/
@[stacks 082A "a quasi-coherent algebra on a quasi-compact quasi-separated algebraic space is \
the colimit, among all algebra sheaves, of a system of quasi-coherent algebras of finite \
presentation indexed by a nonempty directed poset"]
theorem exists_directed_isFinitePresentation_algebra_of_isQuasiCompactSpace
    (X : AlgebraicSpaces B S hS) (hqc : IsQuasiCompactSpace B S hS X.1)
    (hqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal X.1)
    (A : AlgebraSheaf.{u, u} B S hS X.1 X.2) (hA : A.IsQuasicoherent) :
    ∃ (J : Type u) (_ : PartialOrder J) (_ : Nonempty J) (_ : IsDirected J (· ≤ ·))
      (E : J ⥤ AlgebraSheaf.{u, u} B S hS X.1 X.2) (ψ : E ⟶ (Functor.const J).obj A)
      (_ : IsColimit (Cocone.mk A ψ)),
      ∀ j, (E.obj j).IsQuasicoherent ∧ (E.obj j).IsFinitePresentation := by
  obtain ⟨K, inst, hK, D, φ, hD, ⟨hc⟩⟩ :=
    exists_isColimit_isFinitePresentation_quasicoherentAlgebra B S hS X.1 X.2
      (fun G hG => exists_small_isFilteredColimit_isFinitePresentation B S hS B.contains_terminal
        X.2 hqc hqs G hG)
      (fun G _ => nonempty_isColimit_finiteTypeQuasicoherentSubobjectCocone_of_qcqs B S hS
        B.contains_terminal X.1 X.2 hqc hqs G)
      A hA
  have : FinallySmall.{u} K := finallySmall_of_essentiallySmall.{u, u, u} K
  exact Stacks.DirectedCokernelSystem.exists_directed_of_filtered_colimit
    (fun C : AlgebraSheaf.{u, u} B S hS X.1 X.2 => C.IsQuasicoherent ∧ C.IsFinitePresentation)
    D A φ hc hD

/-- **Stacks 082A in the category of quasi-coherent algebras.**  Let `Y` be a quasi-compact and
quasi-separated algebraic space and `𝒜` a quasi-coherent `𝒪_Y`-algebra.  Then `𝒜` is the colimit,
in `AlgebraicGeometry.Space.QuasicoherentAlgebra`, of a system of quasi-coherent algebras of
finite presentation indexed by a nonempty directed preorder. -/
theorem exists_directed_isFinitePresentation_quasicoherentAlgebra (Y : AlgebraicSpaces B S hS)
    (A : QuasicoherentAlgebra B S hS Y) (hqc : IsQuasiCompactSpace B S hS Y.obj)
    (hqs : IsAbsolutelyQuasiSeparated B S hS B.contains_terminal Y.obj) :
    ∃ (I : Type u) (_ : Preorder I) (_ : Nonempty I) (_ : IsDirected I (· ≤ ·))
      (D : I ⥤ QuasicoherentAlgebra B S hS Y) (φ : D ⟶ (Functor.const I).obj A),
      Nonempty (IsColimit (Cocone.mk A φ)) ∧ ∀ i, (D.obj i).obj.IsFinitePresentation := by
  obtain ⟨J, _, hne, hdir, E, ψ, hcol, hE⟩ :=
    exists_directed_isFinitePresentation_algebra_of_isQuasiCompactSpace Y hqc hqs A.obj A.property
  let D : J ⥤ QuasicoherentAlgebra B S hS Y := ObjectProperty.lift _ E fun j => (hE j).1
  let φ : D ⟶ (Functor.const J).obj A :=
    { app := fun j => ObjectProperty.homMk (ψ.app j)
      naturality := fun _ _ f => ObjectProperty.hom_ext _ (ψ.naturality f) }
  exact ⟨J, inferInstance, hne, hdir, D, φ,
    ⟨isColimit_of_isColimit_quasicoherentAlgebraInclusion _ hcol⟩, fun j => (hE j).2⟩

end AlgebraicGeometry.Space

end
