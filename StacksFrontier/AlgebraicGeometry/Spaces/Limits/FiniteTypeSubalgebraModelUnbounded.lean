module

public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.FiniteTypeSubalgebraModel
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.FinitePresentationDescentUnbounded
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.FlatDescentOverPullback

/-!
# Proper, flat, finitely presented spaces over `Spec A` come from a finite type ring, for any `A`

This is `AlgebraicGeometry.Space.exists_adjoinRing_model` without its bound on the cardinality of
`A`. That bound is the index bound of Stacks 07SK and Stacks 084W as formalized here. The system
of the spectra `Spec Λ_s` of the subrings of `A` generated by its finite subsets satisfies the
chapter's convention 07SD whatever the cardinality of `A`: every base change of a stage to an
affine object `Z` of the site is `Z ×_{Spec Λ_i} Spec Λ_s`. Its size is bounded by the sizes of
`Z` and of `Spec A`, and the index has fewer elements than the cutoff. So Stacks 07SK in its form
under the convention
(`AlgebraicGeometry.Space.exists_model_of_finitePresentation_of_chartLimitsInSite`) applies.

Stacks 08K0 (flatness of the morphism) and Stacks 08K1 are hypotheses here. They are stated at
their content under the same convention, in the situation of Stacks 084W: an inverse system with
affine transition morphisms, a morphism `f₀ : X₀ ⟶ Y₀` over a quasi-compact and quasi-separated
stage `B₀` between quasi-compact and quasi-separated algebraic spaces, and its base changes
`((Over.pullback _).map f₀).left`. Their bound-free forms are not in this library. The proof
uses Stacks 08K0 only for the system of the `Spec Λ_s`, which is indexed by the opposite of the
directed preorder `Finset A`; in that case it is proved
(`AlgebraicGeometry.Space.exists_isFlat_overPullback_map_of_chartLimitsInSite`), and
`AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded'` has no hypothesis `h08K0`.

## Main results

* `AlgebraicGeometry.Space.adjoinSiteDiagram_chartLimitsInSite`: the system of the `Spec Λ_s`
  satisfies the convention 07SD.
* `AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded`: a proper, flat, finitely presented
  morphism `X ⟶ Spec A` is the base change of a proper, flat, finitely presented
  `X_s ⟶ Spec Λ_s`, for every ring `A` with `Spec A` in the site.
* `AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded_of_flatDescent`: the same, with
  Stacks 08K0 asked only of the system of the `Spec Λ_s`.
* `AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded_of_adjoinDescent`: the same, with
  Stacks 08K0 and Stacks 08K1 both asked only of the system of the `Spec Λ_s`.
* `AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded'`: the same, with Stacks 08K0
  proved.

## References

* [Stacks Project, Tag 07SD](https://stacks.math.columbia.edu/tag/07SD)
* [Stacks Project, Tag 07SK](https://stacks.math.columbia.edu/tag/07SK)
* [Stacks Project, Tag 08K0](https://stacks.math.columbia.edu/tag/08K0)
* [Stacks Project, Tag 08K1](https://stacks.math.columbia.edu/tag/08K1)
* [Stacks Project, Tag 084W](https://stacks.math.columbia.edu/tag/084W)
* [Stacks Project, Tag 0DLN](https://stacks.math.columbia.edu/tag/0DLN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

section Model

attribute [local instance] uliftIntAlgebra

variable (B : BigFppfSite.{u}) (hZ : B.Contains (⊤_ Scheme.{u}))
  (A : Type u) [CommRing A] (hA : B.Contains (Spec (.of A)))

/-- **The system of the `Spec Λ_s` satisfies the chapter's convention 07SD.** For every stage
`i`, every affine object `Z` of the site and every `g : Z ⟶ Spec Λ_i`, the limit of the base
changes `Z ×_{Spec Λ_i} Spec Λ_s` over the stages `s` over `i` lies in the site. No bound on the
cardinality of `A` is needed. The index has fewer elements than the cutoff, because `#A` is below
it. Each base change has size at most `max (size Z) (size (Spec A))`, because `Λ_s` embeds in `A`.
A limit of affine schemes indexed below the cutoff with stages bounded by one cardinal below the
cutoff lies below the cutoff, by
`AlgebraicGeometry.Scheme.size_lt_of_isLimit_of_isAffine_of_size_le`. -/
theorem adjoinSiteDiagram_chartLimitsInSite :
    ∀ (i : (Finset A)ᵒᵖ) (Z : BigAffineFppf B (⊤_ Scheme.{u}) hZ)
      (g : yoneda.obj ((BigAffineFppf.inclusion B _ hZ).obj Z) ⟶
        (adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)
      (W : Over i ⥤ BigAffineFppf B (⊤_ Scheme.{u}) hZ),
      (W ⋙ (BigAffineFppf.inclusion B _ hZ ⋙ yoneda) ≅
        (Over.post (X := i) (adjoinSiteDiagram B hZ A hA ⋙ yoneda) ⋙ Over.pullback g) ⋙
          Over.forget (yoneda.obj ((BigAffineFppf.inclusion B _ hZ).obj Z))) →
      ∀ c : Cone (((W ⋙ BigAffineFppf.inclusion B _ hZ) ⋙
          BigFppfOver.forget B _ hZ) ⋙ B.inclusion),
        IsLimit c → B.Contains c.pt := by
  classical
  intro i Z g W e c hc
  let T := adjoinSiteDiagram B hZ A hA
  have hT : ∀ s, ((BigFppfOver.toScheme B _ hZ).obj (T.obj s)).size ≤ (Spec (.of A)).size := by
    intro s
    change (Spec (.of (adjoinRing A s.unop))).size ≤ (Spec (.of A)).size
    rw [Scheme.size_Spec, Scheme.size_Spec]
    exact max_le_max le_rfl (Cardinal.mk_le_of_injective Subtype.val_injective)
  have hB : BaseChangeSizeBounded B _ hZ (T ⋙ yoneda) :=
    baseChangeSizeBounded_of_isPullback B _ hZ (T ⋙ yoneda) T (fun _ => 𝟙 _)
      (fun f => IsPullback.id_vert (yoneda.map (T.map f))) hA hT
  obtain ⟨μ, hμ, hbound⟩ := hB i ((BigAffineFppf.inclusion B _ hZ).obj Z) g
  let V : Over i ⥤ Scheme.{u} := ((W ⋙ BigAffineFppf.inclusion B _ hZ) ⋙
    BigFppfOver.forget B _ hZ) ⋙ B.inclusion
  have hV : ∀ k, IsAffine (V.obj k) := fun k => (W.obj k).property
  have hsize : ∀ k, (V.obj k).size ≤ μ := by
    intro k
    refine hbound k ((BigAffineFppf.inclusion B _ hZ).obj (W.obj k))
      ((e.app k).hom ≫ pullback.fst _ _) ((e.app k).hom ≫ pullback.snd _ _) ?_
    refine IsPullback.of_iso_pullback ⟨?_⟩ (e.app k) rfl rfl
    exact (Category.assoc _ _ _).trans (congrArg ((e.app k).hom ≫ ·) pullback.condition)
  have hA' : Cardinal.mk A < B.cutoff := BigFppfSite.mk_lt_cutoff_of_contains_spec B hA
  have hI : Cardinal.mk (Finset A)ᵒᵖ < B.cutoff := by
    rw [← Cardinal.mk_congr (Opposite.equivToOpposite (α := Finset A))]
    refine lt_of_le_of_lt ?_ (max_lt B.aleph0_lt_cutoff hA')
    exact (Cardinal.mk_le_of_surjective (f := fun l : List A => l.toFinset)
      (fun s => ⟨s.toList, Finset.toList_toFinset s⟩)).trans (Cardinal.mk_list_le_max A)
  have hJ : Cardinal.mk (Over i) < B.cutoff :=
    mk_over_lt_of_mk_hom_le B.aleph0_lt_cutoff hI B.aleph0_lt_cutoff
      (fun _ _ => (Cardinal.le_one_iff_subsingleton.mpr inferInstance).trans
        Cardinal.one_le_aleph0) i
  exact Scheme.size_lt_of_isLimit_of_isAffine_of_size_le B.aleph0_lt_cutoff V hV hJ hμ hsize hc

/-- The stages of the system of the `Spec Λ_s` are algebraic spaces, its transition morphisms
are affine, and its stages are quasi-compact and quasi-separated. -/
theorem adjoinSiteDiagram_isAlgebraicSpace_isAffineHom_qcqs :
    (∀ i, IsAlgebraicSpace B _ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)) ∧
    (∀ {i j : (Finset A)ᵒᵖ} (f : i ⟶ j),
      IsAffineHom B _ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).map f)) ∧
    (∀ i, IsQuasiCompactSpace B _ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)) ∧
    (∀ i, IsAbsolutelyQuasiSeparated B _ hZ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)) :=
  ⟨fun _ => isAlgebraicSpace_yoneda B _ hZ _,
    fun {i j} _ => by
      have : IsAffine ((BigFppfOver.toScheme B _ hZ).obj ((adjoinSiteDiagram B hZ A hA).obj i)) :=
        inferInstanceAs (IsAffine (Spec (.of (adjoinRing A i.unop))))
      have : IsAffine ((BigFppfOver.toScheme B _ hZ).obj ((adjoinSiteDiagram B hZ A hA).obj j)) :=
        inferInstanceAs (IsAffine (Spec (.of (adjoinRing A j.unop))))
      exact isAffineHom_yoneda_map B _ hZ _,
    fun i => isQuasiCompactSpace_yoneda_of_isAffine B _ hZ _
      (inferInstanceAs (IsAffine (Spec (.of (adjoinRing A i.unop))))),
    fun i => isAbsolutelyQuasiSeparated_of_isQuasiSeparatedScheme B _ hZ (yoneda.obj _) hZ
      ⟨_, inferInstanceAs (QuasiSeparatedSpace (Spec (.of (adjoinRing A i.unop)))),
        ⟨Functor.RepresentableBy.yoneda _⟩⟩⟩

omit [CommRing A] hA in
/-- The base change of `X ⟶ Over.mk (𝟙 T)`, the structure morphism of `X` read as a morphism of
spaces over `T`, followed by the identification of the base change of `𝟙 T`, is the base change
of the structure morphism. -/
theorem overPullback_map_homMk_comp_snd {S : Scheme.{u}} {hS : B.Contains S}
    {T T' : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (X : Over T) (g : T' ⟶ T) :
    ((Over.pullback g).map (Over.homMk X.hom (Category.comp_id _) : X ⟶ Over.mk (𝟙 T))).left ≫
        pullback.snd (𝟙 T) g = pullback.snd X.hom g :=
  Over.w ((Over.pullback g).map (Over.homMk X.hom (Category.comp_id _) : X ⟶ Over.mk (𝟙 T)))

/-- **A proper, flat, finitely presented algebraic space over `Spec A` comes from a finite type
subring of `A`, given Stacks 08K0 and Stacks 08K1 for the system of the `Spec Λ_s`.** This is
`AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded_of_flatDescent` with its hypothesis
`h08K1` also asked only of the system `adjoinSiteDiagram B hZ A hA ⋙ yoneda`, the one system at
which the proof uses it. The hypothesis `h08K1` is put first. -/
theorem exists_adjoinRing_model_unbounded_of_adjoinDescent
    (h08K1 : ∀ (i : (Finset A)ᵒᵖ) {X Y : Over ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)}
      (f : X ⟶ Y),
      IsQuasiCompactSpace B _ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i) →
      IsAbsolutelyQuasiSeparated B _ hZ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i) →
      IsAlgebraicSpace B _ hZ X.left → IsAlgebraicSpace B _ hZ Y.left →
      IsQuasiCompactSpace B _ hZ X.left → IsAbsolutelyQuasiSeparated B _ hZ hZ X.left →
      IsQuasiCompactSpace B _ hZ Y.left → IsAbsolutelyQuasiSeparated B _ hZ hZ Y.left →
      IsProper B _ hZ
        ((Over.pullback (limit.π (adjoinSiteDiagram B hZ A hA ⋙ yoneda) i)).map f).left →
      IsLocallyOfFiniteType B _ hZ f.left →
      ∃ (j : (Finset A)ᵒᵖ) (e : j ⟶ i),
        IsProper B _ hZ
          ((Over.pullback ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).map e)).map f).left)
    (h08K0 : ∀ (i : (Finset A)ᵒᵖ) {X Y : Over ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)}
      (f : X ⟶ Y),
      IsQuasiCompactSpace B _ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i) →
      IsAbsolutelyQuasiSeparated B _ hZ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i) →
      IsAlgebraicSpace B _ hZ X.left → IsAlgebraicSpace B _ hZ Y.left →
      IsQuasiCompactSpace B _ hZ X.left → IsAbsolutelyQuasiSeparated B _ hZ hZ X.left →
      IsQuasiCompactSpace B _ hZ Y.left → IsAbsolutelyQuasiSeparated B _ hZ hZ Y.left →
      IsFlat B _ hZ
        ((Over.pullback (limit.π (adjoinSiteDiagram B hZ A hA ⋙ yoneda) i)).map f).left →
      IsLocallyOfFinitePresentation B _ hZ f.left →
      ∃ (j : (Finset A)ᵒᵖ) (e : j ⟶ i),
        IsFlat B _ hZ ((Over.pullback ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).map e)).map f).left)
    {X₀ : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u} (hX₀ : IsAlgebraicSpace B _ hZ X₀)
    (p : X₀ ⟶ yoneda.obj (Over.mk (toTerminalSite B hZ hA)))
    (hp : IsProper B _ hZ p ∧ IsFlat B _ hZ p ∧ IsFinitePresentation B _ hZ p) :
    ∃ (s : Finset A) (X₁ : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u)
      (_ : IsAlgebraicSpace B _ hZ X₁)
      (f₁ : X₁ ⟶ yoneda.obj ((adjoinSiteDiagram B hZ A hA).obj (op s))),
      (IsProper B _ hZ f₁ ∧ IsFlat B _ hZ f₁ ∧ IsFinitePresentation B _ hZ f₁) ∧
      ∃ π : X₀ ⟶ X₁,
        IsPullback π p f₁ (yoneda.map ((adjoinSiteCone B hZ A hA).π.app (op s))) := by
  classical
  let D := adjoinSiteDiagram B hZ A hA ⋙ yoneda
  obtain ⟨hD, hAff, hQc, hQs⟩ := adjoinSiteDiagram_isAlgebraicSpace_isAffineHom_qcqs B hZ A hA
  have hconv := adjoinSiteDiagram_chartLimitsInSite B hZ A hA
  let eL : limit D ≅ yoneda.obj (Over.mk (toTerminalSite B hZ hA)) := adjoinLimitIso B hZ A hA
  have hL : IsAlgebraicSpace B _ hZ (limit D) :=
    (isAlgebraicSpace_yoneda B _ hZ _).of_iso eL.symm
  have hY : IsAlgebraicSpace B _ hZ (yoneda.obj (Over.mk (toTerminalSite B hZ hA))) :=
    isAlgebraicSpace_yoneda B _ hZ _
  -- Stacks 07SK under the convention: `X` descends to a stage
  have hp'fp : IsFinitePresentation B _ hZ (p ≫ eL.inv) :=
    isFinitePresentation_comp_iso hX₀ hY hL p eL.symm hp.2.2
  obtain ⟨i, Xi, hXi, hXifp, ⟨eX⟩⟩ :=
    exists_model_of_finitePresentation_of_chartLimitsInSite B _ hZ hZ D hconv hD hAff hQc hQs
      (Over.mk (p ≫ eL.inv)) hX₀ hp'fp
  have hXiqc : IsQuasiCompactSpace B _ hZ Xi.left :=
    isQuasiCompactSpace_of_isFinitePresentation B _ hZ Xi.hom (hD i) (hQc i) hXifp
  have hXiqs : IsAbsolutelyQuasiSeparated B _ hZ hZ Xi.left :=
    isAbsolutelyQuasiSeparated_of_isQuasiSeparated B _ hZ hZ hXi (hQs i) hXifp.2.2
  -- the structure morphism of `X_i`, as a morphism of spaces over the stage
  let m : Xi ⟶ Over.mk (𝟙 (D.obj i)) := Over.homMk Xi.hom (Category.comp_id _)
  -- the base change of `X_i ⟶ B_i` to the limit is `X ⟶ Spec A`, up to isomorphisms
  let πi := limit.π D i
  have hsndπ : pullback.snd Xi.hom πi = eX.inv.left ≫ p ≫ eL.inv := by
    rw [← Iso.inv_hom_id_assoc ((Over.forget _).mapIso eX) (pullback.snd Xi.hom πi)]
    congr 1
    exact Over.w eX.hom
  have hsndlim : IsProper B _ hZ (pullback.snd Xi.hom πi) ∧ IsFlat B _ hZ (pullback.snd Xi.hom πi) ∧
      IsFinitePresentation B _ hZ (pullback.snd Xi.hom πi) := by
    rw [hsndπ]
    have : IsIso eX.inv.left := inferInstanceAs (IsIso ((Over.forget _).map eX.inv))
    exact (isProper_isFlat_isFinitePresentation_isIso_comp_iff B _ hZ eX.inv.left _).2
      ((isProper_isFlat_isFinitePresentation_comp_isIso_iff B _ hZ p eL.inv).2 hp)
  have hmap : ∀ {T' : (BigFppfOver B (⊤_ Scheme.{u}) hZ)ᵒᵖ ⥤ Type u} (g : T' ⟶ D.obj i),
      (IsFlat B _ hZ ((Over.pullback g).map m).left ↔ IsFlat B _ hZ (pullback.snd Xi.hom g)) ∧
      (IsProper B _ hZ ((Over.pullback g).map m).left ↔
        IsProper B _ hZ (pullback.snd Xi.hom g)) := by
    intro T' g
    rw [← overPullback_map_homMk_comp_snd B Xi g]
    exact ⟨(holdsOnEveryEtaleChart_comp_iso_iff B _ hZ _ _ _).symm,
      (isProper_comp_isIso_iff B _ hZ _ _).symm⟩
  have hYi : IsAlgebraicSpace B _ hZ (Over.mk (𝟙 (D.obj i))).left := hD i
  -- Stacks 08K0 and Stacks 08K1: flatness and properness at stages
  obtain ⟨j₁, e₁, hflat₁⟩ := h08K0 i m (hQc i) (hQs i) hXi hYi hXiqc hXiqs
    (hQc i) (hQs i) ((hmap πi).1.2 hsndlim.2.1) hXifp.1
  obtain ⟨j₂, e₂, hprop₂⟩ := h08K1 i m (hQc i) (hQs i) hXi hYi hXiqc hXiqs
    (hQc i) (hQs i) ((hmap πi).2.2 hsndlim.1)
    (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B _ hZ hXifp.1)
  rw [(hmap _).1] at hflat₁
  rw [(hmap _).2] at hprop₂
  obtain ⟨k, a, b, hab⟩ := IsCofiltered.cospan e₁ e₂
  -- the model `X_k = (X_i ×_{B_i} B_{j₁}) ×_{B_{j₁}} B_k ⟶ B_k`
  let f₁ := pullback.snd Xi.hom (D.map e₁)
  let Xk := pullback f₁ (D.map a)
  let fk : Xk ⟶ D.obj k := pullback.snd f₁ (D.map a)
  have hP₁ : IsAlgebraicSpace B _ hZ (pullback Xi.hom (D.map e₁)) :=
    isAlgebraicSpace_pullback B _ hZ Xi.hom (D.map e₁) hXi (hD j₁) (hD i)
  have hXk : IsAlgebraicSpace B _ hZ Xk :=
    isAlgebraicSpace_pullback B _ hZ f₁ (D.map a) hP₁ (hD k) (hD j₁)
  have hsqa : IsPullback (pullback.fst f₁ (D.map a)) fk f₁ (D.map a) :=
    IsPullback.of_hasPullback f₁ (D.map a)
  have hsq₁ : IsPullback (pullback.fst Xi.hom (D.map e₁)) f₁ Xi.hom (D.map e₁) :=
    IsPullback.of_hasPullback Xi.hom (D.map e₁)
  -- `X_k ⟶ B_k` is the base change of `X_i ⟶ B_i` along `B_k ⟶ B_i`
  have hout : IsPullback (pullback.fst f₁ (D.map a) ≫ pullback.fst Xi.hom (D.map e₁)) fk Xi.hom
      (D.map a ≫ D.map e₁) := hsqa.paste_horiz hsq₁
  have hab' : D.map a ≫ D.map e₁ = D.map b ≫ D.map e₂ := by
    rw [← Functor.map_comp, ← Functor.map_comp, hab]
  have hsq₂ : IsPullback (pullback.fst Xi.hom (D.map e₂)) (pullback.snd Xi.hom (D.map e₂))
      Xi.hom (D.map e₂) := IsPullback.of_hasPullback Xi.hom (D.map e₂)
  have hout₂ : IsPullback (pullback.fst f₁ (D.map a) ≫ pullback.fst Xi.hom (D.map e₁)) fk Xi.hom
      (D.map b ≫ D.map e₂) := hab' ▸ hout
  have hsqb := IsPullback.of_right' hout₂ hsq₂
  have hP₂ : IsAlgebraicSpace B _ hZ (pullback Xi.hom (D.map e₂)) :=
    isAlgebraicSpace_pullback B _ hZ Xi.hom (D.map e₂) hXi (hD j₂) (hD i)
  have hflatk : IsFlat B _ hZ fk :=
    isFlat_of_isPullback_of_isAlgebraicSpace B _ hZ hsqa.flip hP₁ (hD j₁) hflat₁
  have hpropk : IsProper B _ hZ fk :=
    isProper_of_isPullback B _ hZ hXk hP₂ (hD k) (hD j₂) hsqb hprop₂
  have hfpk : IsFinitePresentation B _ hZ fk :=
    isFinitePresentation_of_isPullback B _ hZ hXk hXi (hD k) (hD i) hout hXifp
  -- the square exhibiting `X` as the base change of `X_k`
  let πk := limit.π D k
  have hπ : πk ≫ D.map a ≫ D.map e₁ = πi := by
    rw [limit.w_assoc, limit.w]
  let L := hout.lift (pullback.fst Xi.hom πi) (pullback.snd Xi.hom πi ≫ πk)
    (by rw [pullback.condition, Category.assoc, hπ])
  have hlimsq : IsPullback L (pullback.snd Xi.hom πi) fk πk :=
    IsPullback.of_right' (by simpa only [hπ] using IsPullback.of_hasPullback Xi.hom πi) hout
  refine ⟨k.unop, Xk, hXk, fk, ⟨hpropk, hflatk, hfpk⟩, eX.hom.left ≫ L, ?_⟩
  refine hlimsq.of_iso ((Over.forget _).mapIso eX).symm (Iso.refl _) eL (Iso.refl _) ?_ ?_ ?_ ?_
  · simp
  · change pullback.snd Xi.hom πi ≫ eL.hom = eX.inv.left ≫ p
    rw [hsndπ]
    simp
  · simp
  · exact (Category.comp_id _).trans ((eL.hom_inv_id_assoc πk).symm.trans
      (congrArg (fun x => eL.hom ≫ x) (adjoinLimitIso_inv_π B hZ A hA k)))

/-- **A proper, flat, finitely presented algebraic space over `Spec A` comes from a finite type
subring of `A`, given Stacks 08K0 for the system of the `Spec Λ_s`.** This is
`AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded` with its hypothesis `h08K0` asked
only of the system `adjoinSiteDiagram B hZ A hA ⋙ yoneda` of the spectra of the finitely
generated subrings of `A`, the one system at which the proof uses it. That case is proved:
`AlgebraicGeometry.Space.exists_isFlat_overPullback_map_of_chartLimitsInSite`, giving
`AlgebraicGeometry.Space.exists_adjoinRing_model_unbounded'`. -/
theorem exists_adjoinRing_model_unbounded_of_flatDescent
    (h08K0 : ∀ (i : (Finset A)ᵒᵖ) {X Y : Over ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i)}
      (f : X ⟶ Y),
      IsQuasiCompactSpace B _ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i) →
      IsAbsolutelyQuasiSeparated B _ hZ hZ ((adjoinSiteDiagram B hZ A hA ⋙ yoneda).obj i) →
      IsAlgebraicSpace B _ hZ X.left → IsAlgebraicSpace B _ hZ Y.left →
      IsQuasiCompactSpace B _ hZ X.left → IsAbsolutelyQuasiSeparated B _ hZ hZ X.left →
      IsQuasiCompactSpace B _ hZ Y.left → IsAbsolutelyQuasiSeparated B _ hZ hZ Y.left →
      IsFlat B _ hZ
        ((Over.pullback (limit.π (adjoinSiteDiagram B hZ A hA ⋙ yoneda) i)).map f).left →
      IsLocallyOfFinitePresentation B _ hZ f.left →
