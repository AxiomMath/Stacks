module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GradedModuleAbelian
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeQuasicoherentSubobjectsDirected
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AffineSectionsOfColimit
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AlgebraSheafColimits
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.FiniteAlgebraSurjectiveSystem
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.GeneratedIdealQuotientAlgebra
public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.SymmetricSectionsAlgebraAffine
public import StacksFrontier.AlgebraicGeometry.Topologies.FinitePresentationOnSiteOfFinitePresentation
public import StacksFrontier.AlgebraicGeometry.Topologies.FinitePresentationQuasicoherentOnSite
public import StacksFrontier.AlgebraicGeometry.Topologies.FiniteTypeOnSiteKernel

/-!
# A quasi-coherent algebra as a filtered colimit of algebras of finite presentation

Let `𝒜` be a quasi-coherent algebra on an algebraic space `X`.  Granted that every
quasi-coherent `𝒪_X`-module is a filtered colimit of modules of finite presentation (Stacks 07V9)
and the colimit of its finite type quasi-coherent submodules (Stacks 0829), `𝒜` is a filtered
colimit, in the category of all algebra sheaves on `X`, of quasi-coherent algebras of finite
presentation.

Write the underlying module of `𝒜` as a filtered colimit of modules `F_k` of finite presentation,
with legs `φ_k`.  Each `φ_k` extends to a morphism of algebras `ψ_k : Sym(F_k) ⟶ 𝒜`, whose kernel
`J_k` is quasi-coherent.  The index is the category of pairs `(k, E)` with `E` a finite type
quasi-coherent submodule of `J_k`, and the member at `(k, E)` is `Sym(F_k)/(E)`, the quotient by
the ideal generated by `E`: it is of finite presentation because `Sym(F_k)` is and `E` is of
finite type.  On the sections over an affine chart, a section of `𝒜` comes from some `F_k`, and a
section of `Sym(F_k)` killed by `ψ_k` lies in a finite type quasi-coherent submodule of `J_k`.

## Main definitions

* `AlgebraicGeometry.Space.FPAlgColim.Idx`: the index category of pairs `(k, E)`.
* `AlgebraicGeometry.Space.FPAlgColim.diagram`: the diagram `(k, E) ↦ Sym(F_k)/(E)`.
* `AlgebraicGeometry.Space.FPAlgColim.coconeι`: the cocone `Sym(F_k)/(E) ⟶ 𝒜`.

## Main results

* `AlgebraicGeometry.Space.FPAlgColim.nonempty_isColimit`: the cocone `coconeι` is a colimit.
* `AlgebraicGeometry.Space.exists_isColimit_isFinitePresentation_quasicoherentAlgebra`: a
  quasi-coherent algebra is a filtered colimit of quasi-coherent algebras of finite presentation,
  granted Stacks 07V9 and Stacks 0829.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hF : IsAlgebraicSpace B S hS F}

namespace FPAlgColim

variable {𝒜 : AlgebraSheaf.{u, u} B S hS F hF} {K : Type u} [SmallCategory K]
  {D : K ⥤ Modules.{u, u} B S hS F hF}
  (φ : D ⟶ (Functor.const K).obj (AlgebraSheaf.underlyingModule 𝒜))

/-- The sections map of a composite of algebra sheaf morphisms is the composite of the sections
maps. -/
theorem comp_right_app_apply {A C E : AlgebraSheaf.{u, u} B S hS F hF} (f : A ⟶ C) (g : C ⟶ E)
    (U : (SmallEtale B S hS F)ᵒᵖ) (x : A.right.obj.obj U) :
    (f ≫ g).right.hom.app U x = g.right.hom.app U (f.right.hom.app U x) :=
  rfl

/-- The morphism of algebras `Sym(F_k) ⟶ 𝒜` extending the leg `φ_k`. -/
noncomputable def ψ (k : K) : SymSections.algebra (D.obj k) ⟶ 𝒜 :=
  SymSections.lift (φ.app k)

/-- For `f : k ⟶ k'`, the composite `Sym(F_k) ⟶ Sym(F_{k'}) ⟶ 𝒜` is `ψ_k`. -/
theorem map_comp_ψ {k k' : K} (f : k ⟶ k') : SymSections.map (D.map f) ≫ ψ φ k' = ψ φ k := by
  rw [ψ, ψ, SymSections.map_lift]
  congr 1
  simp

/-- The kernel `J_k` of `ψ_k`, as a module. -/
noncomputable def J (k : K) : Modules.{u, u} B S hS F hF :=
  SheafOfModules.kerObj (AlgebraSheaf.underlyingModuleMap (ψ φ k))

/-- The inclusion `J_k ⟶ Sym(F_k)`. -/
noncomputable def ι (k : K) :
    J φ k ⟶ AlgebraSheaf.underlyingModule (SymSections.algebra (D.obj k)) :=
  SheafOfModules.kerIota _

/-- The inclusion `J_k ⟶ Sym(F_k)` is a monomorphism. -/
instance (k : K) : Mono (ι φ k) := SheafOfModules.mono_kerIota _

/-- A section of `J_k` is sent to zero by `ψ_k`. -/
theorem ψ_ι_apply (k : K) (U : (SmallEtale B S hS F)ᵒᵖ) (z : (J φ k).val.obj U) :
    (ψ φ k).right.hom.app U ((ι φ k).val.app U z) = 0 :=
  (SheafOfModules.mem_kerSubmodule _ U z.1).1 z.2

/-- The map of kernels `J_k ⟶ J_{k'}` induced by `k ⟶ k'`. -/
noncomputable def jmap {k k' : K} (f : k ⟶ k') : J φ k ⟶ J φ k' :=
  SheafOfModules.kerLift
    (ι φ k ≫ AlgebraSheaf.underlyingModuleMap (SymSections.map (D.map f))) (by
      ext U z
      exact (ConcreteCategory.congr_hom
        (congrArg (fun g => g.right.hom.app U) (map_comp_ψ φ f))
        (show (SymSections.algebra (D.obj k)).right.obj.obj U from z.1)).trans
        (ψ_ι_apply φ k U z))

/-- The map `J_k ⟶ J_{k'}` is the restriction of `Sym(F_k) ⟶ Sym(F_{k'})`. -/
theorem ι_jmap_apply {k k' : K} (f : k ⟶ k') (U : (SmallEtale B S hS F)ᵒᵖ)
    (z : (J φ k).val.obj U) :
    (ι φ k').val.app U ((jmap φ f).val.app U z) =
      (SymSections.map (D.map f)).right.hom.app U ((ι φ k).val.app U z) :=
  rfl

/-! ### The index category -/

/-- The index: a pair `(k, E)` of an index of the presentation and a finite type quasi-coherent
submodule of `J_k`. -/
structure Idx where
  /-- The index of the presentation. -/
  k : K
  /-- The finite type quasi-coherent submodule of the kernel. -/
  E : FiniteTypeQuasicoherentSubobject B S hS F hF (J φ k)

variable {φ}

/-- The inclusion `E ⟶ Sym(F_k)`. -/
noncomputable def n (i : Idx φ) : Subobject.underlying.obj i.E.obj ⟶
    AlgebraSheaf.underlyingModule (SymSections.algebra (D.obj i.k)) :=
  i.E.obj.arrow ≫ ι φ i.k

/-- A morphism `(k, E) ⟶ (k', E')`: a morphism `k ⟶ k'` carrying the ideal generated by `E`
into the one generated by `E'`. -/
def Hom (i j : Idx φ) :=
  {f : i.k ⟶ j.k // ∀ U, GenQuot.sectionIdeal (n i) U ≤
    (GenQuot.sectionIdeal (n j) U).comap ((SymSections.map (D.map f)).right.hom.app U).hom}

/-- The category of pairs `(k, E)`, with composition that of `K`. -/
instance category : Category (Idx φ) where
  Hom := Hom
  id i := ⟨𝟙 i.k, fun U x hx => by
    rw [Ideal.mem_comap, D.map_id, SymSections.map_id]
    exact hx⟩
  comp f g := ⟨f.1 ≫ g.1, fun U x hx => by
    rw [Ideal.mem_comap, D.map_comp, SymSections.map_comp]
    exact Ideal.mem_comap.1 (g.2 U (Ideal.mem_comap.1 (f.2 U hx)))⟩
  id_comp f := Subtype.ext (Category.id_comp f.1)
  comp_id f := Subtype.ext (Category.comp_id f.1)
  assoc f g h := Subtype.ext (Category.assoc f.1 g.1 h.1)

/-! ### Filteredness -/

section Filtered

/-- The abelian structure on the category of modules on `X`, at universe `u`. -/
noncomputable local instance (priority := high) abelianModules :
    Abelian (Modules.{u, u} B S hS F hF) :=
  SheafOfModules.instAbelian _

/-- The image of a morphism out of a module of finite type is of finite type. -/
theorem isFiniteType_imageSubobject_of_isFiniteType {M N : Modules.{u, u} B S hS F hF} (g : M ⟶ N)
    (hM : M.IsFiniteType) :
    (Subobject.underlying.obj (imageSubobject g)).IsFiniteType :=
  Stacks.SheafOfModules.isFiniteType_of_epi
    (R := (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS F hF).O))
    (factorThruImageSubobject g) hM

/-- The index category of pairs `(k, E)` is essentially small. -/
theorem essentiallySmall : EssentiallySmall.{u} (Idx φ) := by
  have hes : EssentiallySmall.{u} (smallEtaleRingedSite B S hS F hF).C := by
    show EssentiallySmall.{u} (SmallEtale B S hS F)
    infer_instance
  have : IsGrothendieckAbelian.{u} (Modules.{u, u} B S hS F hF) :=
    SheafOfModules.isGrothendieckAbelian_of_essentiallySmall _
  have : ∀ k, Small.{u} (FiniteTypeQuasicoherentSubobject B S hS F hF (J φ k)) := fun k =>
    small_of_injective (f := fun E : FiniteTypeQuasicoherentSubobject B S hS F hF (J φ k) =>
      E.obj) fun _ _ h => ObjectProperty.FullSubcategory.ext h
  have : Small.{u} (Idx φ) := by
    refine small_of_injective
      (f := fun i : Idx φ => (⟨i.k, i.E⟩ : Σ k, FiniteTypeQuasicoherentSubobject B S hS F hF
        (J φ k))) ?_
    rintro ⟨k, E⟩ ⟨k', E'⟩ h
    cases h
    rfl
  exact essentiallySmall_of_small_of_locallySmall _

variable (φ) in
/-- If every `F_k` and `𝒜` are quasi-coherent, then the kernel `J_k` is quasi-coherent. -/
theorem isQuasicoherentOnSite_J (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite)
    (h𝒜 : 𝒜.IsQuasicoherent) (k : K) : (J φ k).IsQuasicoherentOnSite := by
  have := isClosedUnderKernels_quasicoherentSheaves B S hS F hF
    (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS F hF)
  have h1 : (AlgebraSheaf.underlyingModule (SymSections.algebra (D.obj k))).IsQuasicoherentOnSite :=
    SymSections.isQuasicoherent_algebra _ (hD k)
  have h2 : (kernel (AlgebraSheaf.underlyingModuleMap (ψ φ k))).IsQuasicoherentOnSite :=
    ObjectProperty.prop_kernel _ _ h1 h𝒜
  exact ObjectProperty.prop_of_iso _
    (IsLimit.conePointUniqueUpToIso (SheafOfModules.kerIsLimit _) (kernelIsKernel _)).symm h2

variable (φ) in
/-- A section of a submodule `E ⊆ J_k`, pushed to `Sym(F_{k'})`, comes from any submodule of
`J_{k'}` containing the image of `E`. -/
theorem exists_eq_of_imageSubobject_le {k k' : K} (f : k ⟶ k') (E : Subobject (J φ k))
    (E' : Subobject (J φ k')) (h : imageSubobject (E.arrow ≫ jmap φ f) ≤ E')
    (U : (SmallEtale B S hS F)ᵒᵖ) (z : (Subobject.underlying.obj E).val.obj U) :
    ∃ z' : (Subobject.underlying.obj E').val.obj U,
      (ι φ k').val.app U (E'.arrow.val.app U z') =
        (SymSections.map (D.map f)).right.hom.app U ((ι φ k).val.app U (E.arrow.val.app U z)) := by
  refine ⟨(Subobject.ofLE _ _ h).val.app U
    ((factorThruImageSubobject (E.arrow ≫ jmap φ f)).val.app U z), ?_⟩
  have h3 : factorThruImageSubobject (E.arrow ≫ jmap φ f) ≫ Subobject.ofLE _ _ h ≫ E'.arrow =
      E.arrow ≫ jmap φ f := by
    rw [Subobject.ofLE_arrow, imageSubobject_arrow_comp]
  exact congrArg ((ι φ k').val.app U)
    (ConcreteCategory.congr_hom (congrArg (fun g => g.val.app U) h3) z)

/-- If `E'` contains the image of `E` under `f : k ⟶ k'`, then `Sym(F_k) ⟶ Sym(F_{k'})` carries
the ideal generated by `E` into the one generated by `E'`. -/
theorem le_comap_of_imageSubobject_le {i j : Idx φ} (f : i.k ⟶ j.k)
    (h : imageSubobject (i.E.obj.arrow ≫ jmap φ f) ≤ j.E.obj) (U : (SmallEtale B S hS F)ᵒᵖ) :
    GenQuot.sectionIdeal (n i) U ≤
      (GenQuot.sectionIdeal (n j) U).comap ((SymSections.map (D.map f)).right.hom.app U).hom := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨z, rfl⟩
  obtain ⟨z', hz'⟩ := exists_eq_of_imageSubobject_le φ f i.E.obj j.E.obj h U z
  exact Ideal.mem_comap.2 (Ideal.subset_span ⟨z', hz'⟩)

/-- The morphism `(k, E) ⟶ (k', E')` attached to `f : k ⟶ k'` when `E'` contains the image of
`E`. -/
def homOfImageLE {i j : Idx φ} (f : i.k ⟶ j.k)
    (h : imageSubobject (i.E.obj.arrow ≫ jmap φ f) ≤ j.E.obj) : i ⟶ j :=
  ⟨f, le_comap_of_imageSubobject_le f h⟩

/-- The underlying morphism of `homOfImageLE f h` is `f`. -/
theorem homOfImageLE_val {i j : Idx φ} (f : i.k ⟶ j.k)
    (h : imageSubobject (i.E.obj.arrow ≫ jmap φ f) ≤ j.E.obj) : (homOfImageLE f h).1 = f :=
  rfl

variable (φ) in
/-- The image of a finite type quasi-coherent submodule of `J_k` in `J_{k'}`. -/
noncomputable def imageFT (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite) (h𝒜 : 𝒜.IsQuasicoherent)
    {k k' : K} (E : FiniteTypeQuasicoherentSubobject B S hS F hF (J φ k)) (f : k ⟶ k') :
    FiniteTypeQuasicoherentSubobject B S hS F hF (J φ k') :=
  ⟨imageSubobject (E.obj.arrow ≫ jmap φ f),
    ⟨isQuasicoherentOnSite_image B S hS F hF
      (isClosedUnderKernels_quasicoherentSheaves B S hS F hF
        (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS F hF))
      (isClosedUnderCokernels_quasicoherentSheaves B S hS F hF) _ E.property.1
      (isQuasicoherentOnSite_J φ hD h𝒜 k'),
    isFiniteType_imageSubobject_of_isFiniteType (E.obj.arrow ≫ jmap φ f) E.property.2⟩⟩

/-- If every `F_k` and `𝒜` are quasi-coherent, the finite type quasi-coherent submodules of `J_k`
form a filtered category. -/
private theorem isFiltered_subobject_J (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite)
    (h𝒜 : 𝒜.IsQuasicoherent) (k : K) :
    IsFiltered (FiniteTypeQuasicoherentSubobject B S hS F hF (J φ k)) :=
  have := isQuasicoherentOnSite_J φ hD h𝒜 k
  isFiltered_finiteTypeQuasicoherentSubobject B S hS F hF (J φ k)

/-- If `K` is filtered and every `F_k` and `𝒜` are quasi-coherent, then the index category of
pairs `(k, E)` is filtered. -/
theorem isFiltered [IsFiltered K] (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite)
    (h𝒜 : 𝒜.IsQuasicoherent) : IsFiltered (Idx φ) := by
  have hJ := isFiltered_subobject_J (φ := φ) hD h𝒜
  have : Nonempty (Idx φ) := by
    obtain ⟨k⟩ : Nonempty K := IsFiltered.nonempty
    obtain ⟨E⟩ := (hJ k).nonempty
    exact ⟨⟨k, E⟩⟩
  refine { cocone_objs := fun i j => ?_, cocone_maps := fun i j f g => ?_ }
  · let k := IsFiltered.max i.k j.k
    let A₁ := imageFT φ hD h𝒜 i.E (IsFiltered.leftToMax i.k j.k)
    let A₂ := imageFT φ hD h𝒜 j.E (IsFiltered.rightToMax i.k j.k)
    have := hJ k
    exact ⟨⟨k, IsFiltered.max A₁ A₂⟩,
      homOfImageLE (j := ⟨k, IsFiltered.max A₁ A₂⟩) _ (leOfHom (IsFiltered.leftToMax A₁ A₂).hom),
      homOfImageLE (j := ⟨k, IsFiltered.max A₁ A₂⟩) _ (leOfHom (IsFiltered.rightToMax A₁ A₂).hom),
      trivial⟩
  · let k := IsFiltered.coeq f.1 g.1
    let A := imageFT φ hD h𝒜 j.E (IsFiltered.coeqHom f.1 g.1)
    exact ⟨⟨k, A⟩, homOfImageLE (j := ⟨k, A⟩) (IsFiltered.coeqHom f.1 g.1) le_rfl,
      Subtype.ext (IsFiltered.coeq_condition f.1 g.1)⟩

end Filtered

/-! ### The diagram and its cocone -/

variable (φ) in
/-- The diagram `(k, E) ↦ Sym(F_k)/(E)`. -/
noncomputable def diagram : Idx φ ⥤ AlgebraSheaf.{u, u} B S hS F hF where
  obj i := GenQuot.algebra hF (n i)
  map {i j} f := GenQuot.map hF (n i) (SymSections.map (D.map f.1)) f.2
  map_id i := GenQuot.hom_ext (n i) fun U a => by
    refine (GenQuot.map_app_unit (n i) _ _ U a).trans ?_
    change (GenQuot.unit (n i)).app U (GenQuot.mk (n i) U
      ((SymSections.map (D.map (𝟙 i.k))).right.hom.app U a)) = _
    rw [D.map_id, SymSections.map_id]
    rfl
  map_comp {i j l} f g := GenQuot.hom_ext (n i) fun U a => by
    rw [comp_right_app_apply]
    refine (GenQuot.map_app_unit (n i) _ _ U a).trans ?_
    refine Eq.trans ?_ (congrArg _ (GenQuot.map_app_unit (n i) _ _ U a)).symm
    refine Eq.trans ?_ (GenQuot.map_app_unit (n j) _ _ U _).symm
    change (GenQuot.unit (n l)).app U (GenQuot.mk (n l) U
      ((SymSections.map (D.map (f.1 ≫ g.1))).right.hom.app U a)) = _
    rw [D.map_comp, SymSections.map_comp]
    rfl

/-- A section of `E ⊆ J_k` is sent to zero by `ψ_k`. -/
theorem kills (i : Idx φ) (U : (SmallEtale B S hS F)ᵒᵖ)
    (m : (Subobject.underlying.obj i.E.obj).val.obj U) :
    (ψ φ i.k).right.hom.app U ((n i).val.app U m) = 0 :=
  ψ_ι_apply φ i.k U _

variable (φ) in
/-- The cocone of the morphisms `Sym(F_k)/(E) ⟶ 𝒜` induced by `ψ_k`. -/
noncomputable def coconeι : diagram φ ⟶ (Functor.const (Idx φ)).obj 𝒜 where
  app i := GenQuot.lift hF (n i) (ψ φ i.k) (kills i)
  naturality {i j} f := by
    refine (GenQuot.hom_ext (n i) fun U a => ?_).trans (Category.comp_id _).symm
    refine (congrArg ((GenQuot.lift hF (n j) (ψ φ j.k) (kills j)).right.hom.app U)
      (GenQuot.map_app_unit (n i) (SymSections.map (D.map f.1)) f.2 U a)).trans ?_
    refine (GenQuot.lift_app_unit (n j) (ψ φ j.k) (kills j) U _).trans ?_
    refine Eq.trans ?_ (GenQuot.lift_app_unit (n i) (ψ φ i.k) (kills i) U a).symm
    exact ConcreteCategory.congr_hom (congrArg (fun g => g.right.hom.app U) (map_comp_ψ φ f.1)) a

/-- If every `F_k` is quasi-coherent, then each `Sym(F_k)/(E)` is quasi-coherent. -/
theorem isQuasicoherent_diagram_obj (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite) (i : Idx φ) :
    ((diagram φ).obj i).IsQuasicoherent :=
  GenQuot.isQuasicoherent_algebra (n i) (SymSections.isQuasicoherent_algebra _ (hD i.k))
    i.E.property.1

/-- If every `F_k` is quasi-coherent and of finite presentation on the site, then each
`Sym(F_k)/(E)` is of finite presentation. -/
theorem isFinitePresentation_diagram_obj (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite)
    (hfp : ∀ k, SheafOfModules.IsFinitePresentationOnSite (D.obj k)) (i : Idx φ) :
    ((diagram φ).obj i).IsFinitePresentation :=
  GenQuot.isFinitePresentation_algebra (n i) (SymSections.isQuasicoherent_algebra _ (hD i.k))
    (SymSections.isFinitePresentation_algebra _ (hD i.k) (hfp i.k)) i.E.property.1
    (Stacks.SheafOfModules.isFiniteTypeOnSite_of_isFiniteType _ i.E.property.2)

/-- If `K` is filtered, `F_k ⟶ 𝒜` is a colimit cocone, every `F_k` and `𝒜` are quasi-coherent,
and every quasi-coherent module is the colimit of its finite type quasi-coherent submodules, then
the cocone of the morphisms `Sym(F_k)/(E) ⟶ 𝒜` is a colimit. -/
theorem nonempty_isColimit [IsFiltered K] (hc : IsColimit (Cocone.mk _ φ))
    (hD : ∀ k, (D.obj k).IsQuasicoherentOnSite) (h𝒜 : 𝒜.IsQuasicoherent)
    (h0829 : ∀ G : Modules.{u, u} B S hS F hF, G.IsQuasicoherentOnSite →
      Nonempty (IsColimit (finiteTypeQuasicoherentSubobjectCocone B S hS F hF G))) :
    Nonempty (IsColimit (Cocone.mk 𝒜 (coconeι φ))) := by
  have hJ := isFiltered_subobject_J (φ := φ) hD h𝒜
  have := isFiltered hD h𝒜 (φ := φ)
  refine AlgebraSheaf.nonempty_isColimit_of_affineChartSections _ (fun U hU x => ?_)
    (fun U hU i a b hab => ?_)
  · obtain ⟨k, y, hy⟩ := exists_eq_of_isColimit_of_isQuasicoherentOnSite φ hc hD h𝒜 hU x
    obtain ⟨E₀⟩ := (hJ k).nonempty
    refine ⟨⟨k, E₀⟩, (GenQuot.unit (n (φ := φ) ⟨k, E₀⟩)).app (op U)
      (GenQuot.mk _ (op U) (SymSections.genApp (D.obj k) (op U) y)), ?_⟩
    exact (GenQuot.lift_app_unit _ _ _ _ _).trans
      ((SymSections.gen_lift_apply (φ.app k) (op U) y).trans hy)
  · have hab' : (coconeι φ |>.app i).right.hom.app (op U) a =
        (coconeι φ |>.app i).right.hom.app (op U) b := hab
    obtain ⟨q, hq⟩ := (GenQuot.bijective_unit_app (n i)
      (SymSections.isQuasicoherent_algebra _ (hD i.k)) i.E.property.1 U hU).2 (a - b)
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective q
    have h0 : (ψ φ i.k).right.hom.app (op U) w = 0 := by
      have e := congrArg ((coconeι φ |>.app i).right.hom.app (op U)) hq
      have e2 : (coconeι φ |>.app i).right.hom.app (op U) (a - b) = 0 :=
        (map_sub ((coconeι φ |>.app i).right.hom.app (op U)).hom a b).trans
          (sub_eq_zero.2 hab')
      exact (GenQuot.lift_app_unit (n i) (ψ φ i.k) (kills i) (op U) w).symm.trans (e.trans e2)
    let wJ : (J φ i.k).val.obj (op U) := ⟨w, (SheafOfModules.mem_kerSubmodule _ _ _).2 h0⟩
    obtain ⟨hcol⟩ := h0829 (J φ i.k) (isQuasicoherentOnSite_J φ hD h𝒜 i.k)
    have := hJ i.k
    obtain ⟨E'', z, hz⟩ := exists_eq_of_isColimit_of_mono
      (finiteTypeQuasicoherentSubobjectCocone B S hS F hF (J φ i.k)).ι hcol
      (fun E => (inferInstance : Mono E.obj.arrow)) hU wJ
    let A₁ := imageFT φ hD h𝒜 i.E (𝟙 i.k)
    let A₂ := imageFT φ hD h𝒜 E'' (𝟙 i.k)
    let j : Idx φ := ⟨i.k, IsFiltered.max A₁ A₂⟩
    refine ⟨j, homOfImageLE (j := j) (𝟙 i.k) (leOfHom (IsFiltered.leftToMax A₁ A₂).hom), ?_⟩
    obtain ⟨z', hz'⟩ := exists_eq_of_imageSubobject_le φ (𝟙 i.k) E''.obj j.E.obj
      (leOfHom (IsFiltered.rightToMax A₁ A₂).hom) (op U) z
    have hw : (ι φ i.k).val.app (op U) (E''.obj.arrow.val.app (op U) z) = w :=
      congrArg Subtype.val hz
    have hz2 := hz'.trans
      (congrArg ((SymSections.map (D.map (𝟙 i.k))).right.hom.app (op U)) hw)
    have h0' : GenQuot.mk (n j) (op U)
        ((SymSections.map (D.map (𝟙 i.k))).right.hom.app (op U) w) = 0 := by
      refine (congrArg (GenQuot.mk (n j) (op U)) hz2.symm).trans ?_
      exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨z', rfl⟩)
    refine sub_eq_zero.1 ((map_sub _ a b).symm.trans ?_)
    refine (congrArg _ hq.symm).trans ?_
    refine (GenQuot.map_app_unit (n i) _ _ (op U) w).trans ?_
    exact (congrArg _ h0').trans (map_zero _)

end FPAlgColim

variable (B S hS F hF) in
/-- **A quasi-coherent algebra is a filtered colimit of quasi-coherent algebras of finite
presentation**, over Stacks 07V9 (`h07V9`) and the colimit assertion of Stacks 0829 (`h0829`) on
the algebraic space.  The index category is small and filtered, and the colimit is taken in the
category of all algebra sheaves. -/
theorem exists_isColimit_isFinitePresentation_quasicoherentAlgebra
    (h07V9 : ∀ G : Modules.{u, u} B S hS F hF, G.IsQuasicoherentOnSite →
      ∃ (K : Type u) (inst : SmallCategory K),
        let _ := inst
        ∃ (_ : IsFiltered K) (D : K ⥤ Modules.{u, u} B S hS F hF)
          (φ : D ⟶ (Functor.const K).obj G),
          (∀ k, (D.obj k).IsFinitePresentation) ∧ Nonempty (IsColimit (Cocone.mk G φ)))
    (h0829 : ∀ G : Modules.{u, u} B S hS F hF, G.IsQuasicoherentOnSite →
      Nonempty (IsColimit (finiteTypeQuasicoherentSubobjectCocone B S hS F hF G)))
    (𝒜 : AlgebraSheaf.{u, u} B S hS F hF) (h𝒜 : 𝒜.IsQuasicoherent) :
    ∃ (K : Type u) (inst : SmallCategory K),
      let _ := inst
      ∃ (_ : IsFiltered K) (D : K ⥤ AlgebraSheaf.{u, u} B S hS F hF)
        (φ : D ⟶ (Functor.const K).obj 𝒜),
        (∀ k, (D.obj k).IsQuasicoherent ∧ (D.obj k).IsFinitePresentation) ∧
          Nonempty (IsColimit (Cocone.mk 𝒜 φ)) := by
  obtain ⟨K, inst, hK, D, φ, hfp, ⟨hc⟩⟩ := h07V9 _ h𝒜
  let _ := inst
  have hD : ∀ k, (D.obj k).IsQuasicoherentOnSite := fun k =>
    have := hfp k
    Stacks.SheafOfModules.isQuasicoherentOnSite_of_isFinitePresentation (D.obj k)
  have hD' : ∀ k, SheafOfModules.IsFinitePresentationOnSite (D.obj k) := fun k =>
    SheafOfModules.isFinitePresentationOnSite_of_isFinitePresentation (D.obj k) (h := hfp k)
  have := FPAlgColim.isFiltered hD h𝒜 (φ := φ)
  have := FPAlgColim.essentiallySmall (φ := φ)
  obtain ⟨hcol⟩ := FPAlgColim.nonempty_isColimit hc hD h𝒜 h0829
  obtain ⟨I, instI, hne, hdir, D', φ', hcol', hP, -⟩ :=
    Stacks.FiniteAlgebraSurjectiveSystem.exists_directed_of_filtered_colimit_hom.{u}
      (fun A : AlgebraSheaf.{u, u} B S hS F hF => A.IsQuasicoherent ∧ A.IsFinitePresentation)
      (fun _ _ _ => True) (FPAlgColim.diagram φ) 𝒜 (FPAlgColim.coconeι φ) hcol
      (fun i => ⟨FPAlgColim.isQuasicoherent_diagram_obj hD i,
        FPAlgColim.isFinitePresentation_diagram_obj hD hD' i⟩)
      (fun _ _ _ => trivial)
  let _ := instI
  exact ⟨I, inferInstance, inferInstance, D', φ', hP, ⟨hcol'⟩⟩

end AlgebraicGeometry.Space

