module

public import StacksFrontier.AlgebraicGeometry.Spaces.Limits.AlgebraSheafIdealQuotientCokernel
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeChartSections
public import StacksFrontier.AlgebraicGeometry.Spaces.ClosedSubspaceIdealQuasicoherent
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSectionsKernel
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.BigSiteColimits.AffineGeneratedRelations
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ULiftUnit

/-!
# The sheaf of ideals of an algebra generated by a quasi-coherent module

Let `X` be an algebraic space, `ℬ` a quasi-coherent `𝒪_X`-algebra and `g : 𝒢 ⟶ ℬ` a morphism of
`𝒪_X`-modules out of a quasi-coherent module.  The *sheaf of ideals generated by `𝒢`* is the local
closure of the presheaf of ideals `V ↦ (g(𝒢(V)))` of `ℬ`.  This file shows that over an affine
étale chart nothing is added by the local closure, that the sheaf of ideals is a quasi-coherent
`𝒪_X`-module, and that its ideal of sections over an affine chart is finitely generated when `𝒢`
is of finite type.

These are the inputs that make the quotient `ℬ/(𝒢)` a quasi-coherent algebra, of finite
presentation when `ℬ` is: `AlgebraicGeometry.Space.AlgebraSheaf.isQuasicoherent_idealQuotient` and
`AlgebraicGeometry.Space.AlgebraSheaf.isFinitePresentation_idealQuotient`.  This is the step
`𝒜ᵢ = Sym(ℱ)/(ℰᵢ)` of the proof of Stacks 086Z.

## Main definitions

* `AlgebraicGeometry.Space.AlgebraSheaf.generatedPresheafIdeal`: the presheaf of ideals
  `V ↦ (g(𝒢(V)))`.
* `AlgebraicGeometry.Space.AlgebraSheaf.generatedIdeal`: its local closure, a sheaf of ideals.

## Main results

* `AlgebraicGeometry.Space.AlgebraSheaf.mem_span_of_forall_restrict_mem_span_range`: **étale
  descent of membership in the ideal generated by the image of `𝒢`**, along a jointly faithfully
  flat finite family of affine charts.
* `AlgebraicGeometry.Space.AlgebraSheaf.generatedIdeal_obj_of_isAffine`: over an affine chart the
  sections of the generated sheaf of ideals are the ideal generated by the image of `𝒢`.
* `AlgebraicGeometry.Space.AlgebraSheaf.isQuasicoherentOnSite_idealModule_generatedIdeal`: the
  generated sheaf of ideals is a quasi-coherent `𝒪_X`-module.
* `AlgebraicGeometry.Space.AlgebraSheaf.fg_sectionIdeal_generatedIdeal`: over an affine chart its
  ideal of sections is finitely generated when `𝒢` is of finite type.

## References

* [Stacks Project, Tag 086Z](https://stacks.math.columbia.edu/tag/086Z)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct

universe u

namespace AlgebraicGeometry.Space.AlgebraSheaf

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {X : AlgebraicSpaces B S hS}

/-! ### Spans of restrictions of an ideal are ideals -/

/-- A section of `ℬ` read as a section of its underlying `𝒪_X`-module.  The two types are the
same; the abbreviation only fixes which of the two structures instance search sees. -/
noncomputable abbrev toModuleSection (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (V : (SmallEtale B S hS X.1)ᵒᵖ)
    (x : ℬ.right.obj.obj V) : (underlyingModule ℬ).val.obj V := x

/-- A section of the underlying `𝒪_X`-module of `ℬ` read as a section of `ℬ`. -/
noncomputable abbrev ofModuleSection (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (V : (SmallEtale B S hS X.1)ᵒᵖ)
    (x : (underlyingModule ℬ).val.obj V) : ℬ.right.obj.obj V := x

/-- The image of the sections of `𝒢` in the sections of `ℬ` over a chart, as a subset of the ring
`ℬ(V)`. -/
noncomputable abbrev imageSet (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ)
    (V : (SmallEtale B S hS X.1)ᵒᵖ) : Set (ℬ.right.obj.obj V) :=
  Set.range fun e => ofModuleSection ℬ V (g.val.app V e)

/-- The `𝒪_X(V)`-span, inside the underlying module of `ℬ`, of the restriction of a subset of
`ℬ(U)` along `f : V ⟶ U`. -/
noncomputable abbrev spanRestrict (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {U V : SmallEtale B S hS X.1}
    (f : V ⟶ U) (K : Set (ℬ.right.obj.obj (op U))) :
    Submodule (chartRing B S hS X.1 X.2 V) ((underlyingModule ℬ).val.obj (op V)) :=
  Submodule.span (chartRing B S hS X.1 X.2 V)
    ((fun x => toModuleSection ℬ (op V) (ℬ.right.obj.map f.op x)) '' K)

/-- Multiplication by a fixed section `r` of `ℬ` maps the span of a set into a submodule `T` of the
underlying module once it maps the set into `T`. -/
private theorem mul_mem_of_mem_span (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {V : SmallEtale B S hS X.1}
    (T : Submodule (chartRing B S hS X.1 X.2 V) ((underlyingModule ℬ).val.obj (op V)))
    (r : ℬ.right.obj.obj (op V)) (S' : Set ((underlyingModule ℬ).val.obj (op V)))
    (h : ∀ x ∈ S', toModuleSection ℬ (op V) (r * ofModuleSection ℬ (op V) x) ∈ T)
    {y : (underlyingModule ℬ).val.obj (op V)}
    (hy : y ∈ Submodule.span (chartRing B S hS X.1 X.2 V) S') :
    toModuleSection ℬ (op V) (r * ofModuleSection ℬ (op V) y) ∈ T := by
  induction hy using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero => exact (congrArg (· ∈ T) (mul_zero r)).mpr T.zero_mem
  | add x z _ _ hx hz =>
    exact (congrArg (· ∈ T) (mul_add r (ofModuleSection ℬ (op V) x)
      (ofModuleSection ℬ (op V) z))).mpr (T.add_mem hx hz)
  | smul o x _ hx =>
    refine (congrArg (· ∈ T) ?_).mpr (T.smul_mem o hx)
    change toModuleSection ℬ (op V) (r * (ℬ.algebraMap (op V) o * ofModuleSection ℬ (op V) x)) =
      toModuleSection ℬ (op V) (ℬ.algebraMap (op V) o * (r * ofModuleSection ℬ (op V) x))
    congr 1
    ring

/-- **Over a morphism along which the base change comparison of `ℬ` is surjective, the
`𝒪_X(V)`-span of the restriction of an ideal of `ℬ(U)` is an ideal of `ℬ(V)`.**  The ring `ℬ(V)`
is spanned over `𝒪_X(V)` by the restrictions of `ℬ(U)`, and the restriction map is a ring map, so
a product of a restricted section with a restricted element of the ideal is a restricted element
of the ideal. -/
theorem mul_mem_spanRestrict (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {U V : SmallEtale B S hS X.1} (f : V ⟶ U)
    (hsurj : Function.Surjective (sectionsBaseChange (underlyingModule ℬ) f))
    (K : Ideal (ℬ.right.obj.obj (op U))) (c : ℬ.right.obj.obj (op V))
    {y : ℬ.right.obj.obj (op V)} (hy : toModuleSection ℬ (op V) y ∈ spanRestrict ℬ f K) :
    toModuleSection ℬ (op V) (c * y) ∈ spanRestrict ℬ f K := by
  let T := spanRestrict ℬ f K
  have hspan : Submodule.span (chartRing B S hS X.1 X.2 V)
      (Set.range fun x : (underlyingModule ℬ).val.obj (op U) =>
        chartRestrictLinear (underlyingModule ℬ) f x) = ⊤ :=
    (chartBaseChange_surjective_iff_span_eq_top (underlyingModule ℬ) f).1 hsurj
  -- multiplication by a restricted section preserves `T`
  have hres : ∀ b : ℬ.right.obj.obj (op U), ∀ y' ∈ T,
      toModuleSection ℬ (op V)
        (((ℬ.right.obj.map f.op).hom b) * ofModuleSection ℬ (op V) y') ∈ T := by
    intro b y' hy'
    refine mul_mem_of_mem_span ℬ T _ _ ?_ hy'
    rintro _ ⟨k, hk, rfl⟩
    refine Submodule.subset_span ⟨b * k, K.mul_mem_left b hk, ?_⟩
    exact map_mul (ℬ.right.obj.map f.op).hom b k
  have hall : ∀ c' ∈ Submodule.span (chartRing B S hS X.1 X.2 V)
      (Set.range fun x : (underlyingModule ℬ).val.obj (op U) =>
        chartRestrictLinear (underlyingModule ℬ) f x),
      toModuleSection ℬ (op V) (ofModuleSection ℬ (op V) c' * y) ∈ T := by
    intro c' hc'
    refine (congrArg (· ∈ T) (mul_comm _ y)).mpr
      (mul_mem_of_mem_span ℬ T y _ (fun x hx => ?_) hc')
    obtain ⟨b, rfl⟩ := hx
    rw [mul_comm]
    exact hres b _ hy
  exact hall (toModuleSection ℬ (op V) c) (Submodule.eq_top_iff'.mp hspan _)

/-- **The ideal generated by the image of a module over the smaller chart lies in the span of the
restriction of the ideal generated over the larger chart**, when the base change comparisons of
the module and of `ℬ` are surjective. -/
theorem span_range_le_spanRestrict (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ)
    {U V : SmallEtale B S hS X.1} (f : V ⟶ U)
    (hsurj : Function.Surjective (sectionsBaseChange (underlyingModule ℬ) f))
    (hGsurj : Function.Surjective (sectionsBaseChange G f))
    {y : ℬ.right.obj.obj (op V)} (hy : y ∈ Ideal.span (imageSet ℬ g (op V))) :
    toModuleSection ℬ (op V) y ∈ spanRestrict ℬ f (Ideal.span (imageSet ℬ g (op U))) := by
  let K : Ideal (ℬ.right.obj.obj (op U)) := Ideal.span (imageSet ℬ g (op U))
  let T := spanRestrict ℬ f K
  let TI : Ideal (ℬ.right.obj.obj (op V)) :=
    { carrier := {x | toModuleSection ℬ (op V) x ∈ T}
      add_mem' := fun {a b} ha hb => T.add_mem ha hb
      zero_mem' := T.zero_mem
      smul_mem' := fun c x hx => mul_mem_spanRestrict ℬ f hsurj K c hx }
  have hgen : imageSet ℬ g (op V) ⊆ (TI : Set (ℬ.right.obj.obj (op V))) := by
    rintro _ ⟨e, rfl⟩
    obtain ⟨t, rfl⟩ := hGsurj e
    let _ := chartAlgebra (hF := X.2) f
    show g.val.app (op V) (sectionsBaseChange G f t) ∈ T
    induction t using TensorProduct.induction_on with
    | zero =>
      rw [map_zero, map_zero]
      exact T.zero_mem
    | add a b ha hb =>
      rw [map_add, map_add]
      exact T.add_mem ha hb
    | tmul o e' =>
      rw [chartBaseChange_tmul, (g.val.app (op V)).hom.map_smul]
      refine T.smul_mem o (Submodule.subset_span ⟨g.val.app (op U) e',
        Ideal.subset_span ⟨e', rfl⟩, ?_⟩)
      exact (congrArg (fun φ => (ConcreteCategory.hom φ : _ → _) e')
        (g.val.naturality f.op)).symm
  exact (Ideal.span_le.mpr hgen) hy

/-! ### Étale descent of membership in the generated ideal -/

/-- **Étale descent of membership in the ideal generated by the image of a quasi-coherent
module.**  Let `ℬ` be a quasi-coherent `𝒪_X`-algebra and `g : 𝒢 ⟶ ℬ` a morphism out of a
quasi-coherent module.  A section of `ℬ` over an affine chart `U` whose restriction to each member
of a jointly faithfully flat finite family of affine charts lies in the ideal generated by the
image of `𝒢` there lies in the ideal generated by the image of `𝒢(U)`.

The ideal over `U` is read as an `𝒪_X(U)`-submodule `L` of the underlying module of `ℬ`; over a
member `zᵢ` the ideal generated by the image of `𝒢(zᵢ)` lies in the `𝒪_X(zᵢ)`-span of the
restriction of `L` (`AlgebraicGeometry.Space.AlgebraSheaf.span_range_le_span_restrict`), which is
the range of the base change of `L ⟶ ℬ(zᵢ)`; and
`Module.BaseChange.mem_range_of_forall_mem_range_of_liftBaseChange` descends the membership, its
injectivity input being the cartesianness of `ℬ`. -/
theorem mem_span_of_forall_restrict_mem_span_range (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (hℬ : ℬ.IsQuasicoherent) {G : Modules.{u, u} B S hS X.1 X.2} (hG : G.IsQuasicoherentOnSite)
    (g : G ⟶ underlyingModule ℬ) {U : SmallEtale B S hS X.1}
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U))
    {n : ℕ} {z : Fin n → SmallEtale B S hS X.1} (φ : ∀ i, z i ⟶ U)
    (hz : ∀ i, IsAffine
      ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj (z i)))
    (hff : (RingHom.pi fun i => chartRestrict (hF := X.2) (φ i)).FaithfullyFlat)
    {s : ℬ.right.obj.obj (op U)}
    (hs : ∀ i, ℬ.right.obj.map (φ i).op s ∈ Ideal.span (imageSet ℬ g (op (z i)))) :
    s ∈ Ideal.span (imageSet ℬ g (op U)) := by
  classical
  let M := underlyingModule ℬ
  have hM : IsCartesianOnAffineCharts M :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 M hℬ
  have hGc : IsCartesianOnAffineCharts G :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 G hG
  let A := chartRing B S hS X.1 X.2 U
  let K : Ideal (ℬ.right.obj.obj (op U)) := Ideal.span (imageSet ℬ g (op U))
  let L : Submodule A (M.val.obj (op U)) :=
    { carrier := {x | ofModuleSection ℬ (op U) x ∈ K}
      add_mem' := fun {a b} ha hb => K.add_mem ha hb
      zero_mem' := K.zero_mem
      smul_mem' := fun r x hx => K.mul_mem_left (ℬ.algebraMap (op U) r) hx }
  let algI : ∀ i, Algebra A (chartRing B S hS X.1 X.2 (z i)) :=
    fun i => chartAlgebra (hF := X.2) (φ i)
  let modI : ∀ i, Module A (M.val.obj (op (z i))) := fun i => chartSectionsModule M (φ i)
  have towI : ∀ i, IsScalarTower A (chartRing B S hS X.1 X.2 (z i)) (M.val.obj (op (z i))) :=
    fun i => chartSections_isScalarTower M (φ i)
  have hFF : Module.FaithfullyFlat A (∀ i, chartRing B S hS X.1 X.2 (z i)) := hff
  let rN : ∀ i, M.val.obj (op U) →ₗ[A] M.val.obj (op (z i)) :=
    fun i => chartRestrictLinear M (φ i)
  let bT : L →ₗ[A] M.val.obj (op U) := L.subtype
  let rP : ∀ i, L →ₗ[A] (chartRing B S hS X.1 X.2 (z i)) ⊗[A] L :=
    fun i => TensorProduct.mk A (chartRing B S hS X.1 X.2 (z i)) L 1
  let bW : ∀ i, (chartRing B S hS X.1 X.2 (z i)) ⊗[A] L →ₗ[chartRing B S hS X.1 X.2 (z i)]
      M.val.obj (op (z i)) := fun i => ((rN i).comp bT).liftBaseChange _
  have hsq : ∀ (i) (q : L), rN i (bT q) = bW i (rP i q) := by
    intro i q
    show rN i (bT q) = ((rN i).comp bT).liftBaseChange _ ((1 : chartRing B S hS X.1 X.2 (z i))
      ⊗ₜ[A] q)
    rw [LinearMap.liftBaseChange_tmul, one_smul]
    rfl
  have hP : ∀ i, Function.Surjective ((rP i).liftBaseChange (chartRing B S hS X.1 X.2 (z i))) := by
    intro i w
    refine ⟨w, ?_⟩
    induction w using TensorProduct.induction_on with
    | zero => exact map_zero _
    | add a b ha hb => rw [map_add, ha, hb]
    | tmul o q =>
      rw [LinearMap.liftBaseChange_tmul]
      show o • ((1 : chartRing B S hS X.1 X.2 (z i)) ⊗ₜ[A] q) = o ⊗ₜ[A] q
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have hn : ∀ i, rN i s ∈ LinearMap.range (bW i) := by
    intro i
    show rN i s ∈ LinearMap.range (((rN i).comp bT).liftBaseChange _)
    rw [LinearMap.range_liftBaseChange]
    refine Submodule.span_mono ?_ (span_range_le_spanRestrict ℬ g (φ i)
      (hM U (z i) hU (hz i) (φ i)).2 (hGc U (z i) hU (hz i) (φ i)).2 (hs i))
    rintro _ ⟨k, hk, rfl⟩
    exact ⟨⟨toModuleSection ℬ (op U) k, hk⟩, rfl⟩
  obtain ⟨q, hq⟩ := Module.BaseChange.mem_range_of_forall_mem_range_of_liftBaseChange
    A (fun i => chartRing B S hS X.1 X.2 (z i)) bT bW rP rN hsq hP
    (fun i => (hM U (z i) hU (hz i) (φ i)).1) hn
  rw [← hq]
  exact q.2

/-! ### The generated sheaf of ideals -/

/-- **The presheaf of ideals of `ℬ` generated by the image of `g : 𝒢 ⟶ ℬ`**: over each chart, the
ideal generated by the image of the sections of `𝒢`.  Membership in it is not local, and its
local closure is `AlgebraicGeometry.Space.AlgebraSheaf.generatedIdeal`. -/
noncomputable def generatedPresheafIdeal (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ) :
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf ℬ.right)).val.Submodule where
  obj V := Ideal.span (imageSet ℬ g V)
  map {V W} h := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨e, rfl⟩
    change ℬ.right.obj.map h (g.val.app V e) ∈ Ideal.span (imageSet ℬ g W)
    refine Ideal.subset_span ⟨G.val.map h e, ?_⟩
    exact congrArg (fun φ => (ConcreteCategory.hom φ : _ → _) e) (g.val.naturality h)

/-- **The sheaf of ideals of `ℬ` generated by the image of `g : 𝒢 ⟶ ℬ`**: the sections lying
étale-locally in the ideal generated by the image of `𝒢`. -/
noncomputable def generatedIdeal (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ) : ℬ.IdealSheaf :=
  Stacks.SheafOfModules.localClosure _ (generatedPresheafIdeal ℬ g)

/-- The ideal generated by the image of `𝒢` over a chart lies in the generated sheaf of ideals. -/
theorem span_range_le_generatedIdeal (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ)
    (V : (SmallEtale B S hS X.1)ᵒᵖ) :
    Ideal.span (imageSet ℬ g V) ≤ (generatedIdeal ℬ g).obj V := fun _ hs =>
  (generatedPresheafIdeal ℬ g).toSubfunctor.le_sheafify (SmallEtale.topology B S hS X.1) V hs

/-- The image of `𝒢` lies in the generated sheaf of ideals. -/
theorem app_mem_generatedIdeal (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ)
    (V : (SmallEtale B S hS X.1)ᵒᵖ) (e : G.val.obj V) :
    g.val.app V e ∈ (generatedIdeal ℬ g).obj V :=
  span_range_le_generatedIdeal ℬ g V (Ideal.subset_span ⟨e, rfl⟩)

/-- **Over an affine chart the generated sheaf of ideals has as sections the ideal generated by
the image of `𝒢`**, for `ℬ` and `𝒢` quasi-coherent. -/
theorem generatedIdeal_obj_of_isAffine (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (hℬ : ℬ.IsQuasicoherent) {G : Modules.{u, u} B S hS X.1 X.2} (hG : G.IsQuasicoherentOnSite)
    (g : G ⟶ underlyingModule ℬ) (U : SmallEtale B S hS X.1)
    (hU : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (generatedIdeal ℬ g).obj (op U) = Ideal.span (imageSet ℬ g (op U)) := by
  refine le_antisymm (fun s hs => ?_) (span_range_le_generatedIdeal ℬ g (op U))
  obtain ⟨n, z, φ, hzaff, hzT, hff⟩ :=
    exists_finite_affine_faithfullyFlat_pi_le B S hS X.1 X.2 hU hs
  exact mem_span_of_forall_restrict_mem_span_range ℬ hℬ hG g hU φ hzaff hff hzT

/-- **The generated sheaf of ideals is contained in every sheaf of ideals containing the image of
`𝒢`.** -/
theorem generatedIdeal_le (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ) {I : ℬ.IdealSheaf}
    (h : ∀ (V : (SmallEtale B S hS X.1)ᵒᵖ) (e : G.val.obj V), g.val.app V e ∈ I.obj V) :
    generatedIdeal ℬ g ≤ I := by
  rw [SheafOfModules.Submodule.le_iff]
  intro V s hs
  refine I.isSheaf s ((SmallEtale.topology B S hS X.1).superset_covering ?_ hs)
  intro W a ha
  have ha' : ℬ.right.obj.map a.op s ∈ Ideal.span (imageSet ℬ g (op W)) := ha
  have hle : Ideal.span (imageSet ℬ g (op W)) ≤ I.obj (op W) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨e, rfl⟩
    exact h _ e
  exact hle ha'

/-- **The generated sheaf of ideals is monotone in the image of `𝒢`.** -/
theorem generatedIdeal_mono (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    {G G' : Modules.{u, u} B S hS X.1 X.2} (g : G ⟶ underlyingModule ℬ)
    (g' : G' ⟶ underlyingModule ℬ)
    (h : ∀ (V : (SmallEtale B S hS X.1)ᵒᵖ) (e : G.val.obj V), ∃ e' : G'.val.obj V,
      g'.val.app V e' = g.val.app V e) :
    generatedIdeal ℬ g ≤ generatedIdeal ℬ g' := by
  refine generatedIdeal_le ℬ g fun V e => ?_
  obtain ⟨e', he'⟩ := h V e
  rw [← he']
  exact app_mem_generatedIdeal ℬ g' V e'

/-- **The generated sheaf of ideals is cartesian on affine charts**, for `ℬ` and `𝒢`
quasi-coherent.  Injectivity of the comparison is flatness together with the cartesianness of
`ℬ`; for surjectivity, over the smaller chart the sections are the ideal generated by the image of
`𝒢`, which lies in the span of the restriction of the ideal over the larger chart
(`AlgebraicGeometry.Space.AlgebraSheaf.span_range_le_spanRestrict`), and that span is the image of
the comparison. -/
theorem isCartesianOnAffineCharts_idealModule_generatedIdeal
    (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2) (hℬ : ℬ.IsQuasicoherent)
    {G : Modules.{u, u} B S hS X.1 X.2} (hG : G.IsQuasicoherentOnSite)
    (g : G ⟶ underlyingModule ℬ) :
    IsCartesianOnAffineCharts (idealModule ℬ (generatedIdeal ℬ g)) := by
  intro U V hU hV f
  have hM : IsCartesianOnAffineCharts (underlyingModule ℬ) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 _ hℬ
  have hGc : IsCartesianOnAffineCharts G :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS X.1 X.2 G hG
  let I := generatedIdeal ℬ g
  refine ⟨injective_sectionsBaseChange_of_injective_app (idealModuleι ℬ I) f
    (flat_chartRestrict_of_isAffine f hU hV) (fun _ _ hab => Subtype.val_injective hab)
    (hM U V hU hV f), ?_⟩
  let _ := chartAlgebra (hF := X.2) f
  intro y
  -- the image of the comparison, read inside the underlying module of `ℬ`
  let ιV := ((idealModuleι ℬ I).val.app (op V)).hom
  have hy : toModuleSection ℬ (op V) (ofModuleSection ℬ (op V) (ιV y)) ∈
      spanRestrict ℬ f (Ideal.span (imageSet ℬ g (op U))) := by
    refine span_range_le_spanRestrict ℬ g f (hM U V hU hV f).2 (hGc U V hU hV f).2 ?_
    have hmem : ιV y ∈ I.obj (op V) := y.2
    rwa [generatedIdeal_obj_of_isAffine ℬ hℬ hG g V hV] at hmem
  have hle : spanRestrict ℬ f (Ideal.span (imageSet ℬ g (op U))) ≤
      Submodule.map ιV (LinearMap.range (sectionsBaseChange (idealModule ℬ I) f)) := by
    rw [range_chartBaseChange, Submodule.map_span]
    refine Submodule.span_mono ?_
    rintro _ ⟨k, hk, rfl⟩
    have hkI : k ∈ I.obj (op U) := by
      rwa [generatedIdeal_obj_of_isAffine ℬ hℬ hG g U hU]
    exact ⟨chartRestrictLinear (idealModule ℬ I) f ⟨k, hkI⟩, ⟨⟨k, hkI⟩, rfl⟩, rfl⟩
  obtain ⟨w, ⟨t, rfl⟩, hw⟩ := hle hy
  exact ⟨t, Subtype.val_injective hw⟩

/-- **The generated sheaf of ideals is a quasi-coherent `𝒪_X`-module**, for `ℬ` and `𝒢`
quasi-coherent. -/
theorem isQuasicoherentOnSite_idealModule_generatedIdeal (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (hℬ : ℬ.IsQuasicoherent) {G : Modules.{u, u} B S hS X.1 X.2} (hG : G.IsQuasicoherentOnSite)
    (g : G ⟶ underlyingModule ℬ) :
    (idealModule ℬ (generatedIdeal ℬ g)).IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isCartesianOnAffineCharts _
    (isCartesianOnAffineCharts_idealModule_generatedIdeal ℬ hℬ hG g)

/-- **Over an affine chart the ideal of sections of the generated sheaf of ideals is finitely
generated** when `𝒢` is a quasi-coherent module of finite type: it is generated by the images of
finitely many generators of the sections of `𝒢`. -/
theorem fg_sectionIdeal_generatedIdeal (ℬ : AlgebraSheaf.{u, u} B S hS X.1 X.2)
    (hℬ : ℬ.IsQuasicoherent) {G : Modules.{u, u} B S hS X.1 X.2} (hG : G.IsQuasicoherentOnSite)
    (hft : SheafOfModules.IsFiniteTypeOnSite G) (g : G ⟶ underlyingModule ℬ)
    (W : SmallEtale B S hS X.1)
    (hW : IsAffine ((SmallEtale.toOver B S hS X.1 ⋙ BigFppfOver.toScheme B S hS).obj W)) :
    (Stacks.Sites.sectionIdeal (generatedIdeal ℬ g) (op W)).FG := by
  classical
  obtain ⟨t, ht⟩ := (module_finite_sections_of_isFiniteTypeOnSite G hG hft W hW).fg_top
  refine ⟨t.image fun e => ofModuleSection ℬ (op W) (g.val.app (op W) e), ?_⟩
  show _ = (generatedIdeal ℬ g).obj (op W)
  rw [generatedIdeal_obj_of_isAffine ℬ hℬ hG g W hW, Finset.coe_image]
  refine le_antisymm (Ideal.span_mono ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨e, -, rfl⟩
    exact ⟨e, rfl⟩
  · rintro _ ⟨e, rfl⟩
    have he := (Submodule.eq_top_iff'.mp ht) e
    induction he using Submodule.span_induction with
    | mem x hx => exact Ideal.subset_span ⟨x, hx, rfl⟩
    | zero =>
      have : ofModuleSection ℬ (op W) (g.val.app (op W) 0) = 0 := map_zero (g.val.app (op W)).hom
      beta_reduce
      exact (congrArg (· ∈ Ideal.span _) this).mpr (Ideal.zero_mem _)
    | add x z _ _ hx hz =>
      have : ofModuleSection ℬ (op W) (g.val.app (op W) (x + z)) =
          ofModuleSection ℬ (op W) (g.val.app (op W) x) +
            ofModuleSection ℬ (op W) (g.val.app (op W) z) := map_add (g.val.app (op W)).hom x z
      beta_reduce at hx hz ⊢
      exact (congrArg (· ∈ Ideal.span _) this).mpr (Ideal.add_mem _ hx hz)
    | smul o x _ hx =>
      beta_reduce at hx ⊢
      have h2 := (g.val.app (op W)).hom.map_smul o x
      exact (congrArg (fun y : ℬ.right.obj.obj (op W) =>
        y ∈ Ideal.span ((fun e => ofModuleSection ℬ (op W) (g.val.app (op W) e)) '' ↑t)) h2).mpr
        (Ideal.mul_mem_left _ (ℬ.algebraMap (op W) o) hx)

end AlgebraicGeometry.Space.AlgebraSheaf
