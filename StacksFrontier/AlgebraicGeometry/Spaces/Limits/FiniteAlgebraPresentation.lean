module

public import StacksFrontier.AlgebraicGeometry.Spaces.AlgebraSheafIdealOfMaps
public import StacksFrontier.AlgebraicGeometry.Spaces.FiniteTypeQuasicoherentExtension
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartSubmodules

/-!
# The ideals generated by local sections of a kernel, indexed by a small directed set

Let `ℬ` be a sheaf of `𝒪_X`-algebras on a quasi-compact quasi-separated algebraic space `X` and
let `κ : 𝒦 ⟶ ℬ` be a morphism of `𝒪_X`-modules from a module cartesian on affine charts with the
extension property of Stacks 0829 (every section over an affine chart lies in a finite type
quasi-coherent submodule).  This file indexes the sheaves of ideals of `ℬ` generated by the images
of finitely many such submodules by a *small* directed set: the finite sets of pairs of an object
of a small model of the small étale site and a section of `𝒦` over it.  Every section of `ℬ` over
an affine chart which comes from `𝒦` lies in one of these ideals.

This is the system `(ℰ_i)` of the proof of Stacks 086Z, made small.

## Main definitions

* `AlgebraicGeometry.Space.KernelIdealSystem.Gen`: the small type of generators.
* `AlgebraicGeometry.Space.KernelIdealSystem.ideal`: the sheaf of ideals attached to a finite set
  of generators.

## Main results

* `AlgebraicGeometry.Space.KernelIdealSystem.ideal_mono`: the ideals grow with the set.
* `AlgebraicGeometry.Space.KernelIdealSystem.exists_mem_ideal`: every section of `ℬ` over an
  affine chart which is the image of a section of `𝒦` lies in the ideal of a single generator.

## References

* [Stacks Project, Tag 086Z](https://stacks.math.columbia.edu/tag/086Z)
* [Stacks Project, Tag 0829](https://stacks.math.columbia.edu/tag/0829)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space.KernelIdealSystem

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {hX : IsAlgebraicSpace B S hS X}
  (ℬ : AlgebraSheaf.{u, u} B S hS X hX) {K : Modules.{u, u} B S hS X hX}
  (κ : K ⟶ AlgebraSheaf.underlyingModule ℬ) (hK : IsCartesianOnAffineCharts K)
  (hP : ChartExtensionProperty K (𝟙 X))

/-- The small model of the small étale site. -/
abbrev Model := SmallModel.{u} (SmallEtale B S hS X)

/-- The chart attached to an object of the small model. -/
abbrev chartOf (T : Model (B := B) (S := S) (hS := hS) (X := X)) : SmallEtale B S hS X :=
  (equivSmallModel.{u} (SmallEtale B S hS X)).inverse.obj T

variable (K) in
/-- **The generators**: an object of the small model with a section of `𝒦` over its chart. -/
abbrev Gen : Type u := Σ T : Model (B := B) (S := S) (hS := hS) (X := X), K.val.obj (op (chartOf T))

/-- The finite type quasi-coherent submodule of `𝒦` chosen for a generator: one containing its
section when the chart is affine, by the extension property, and the zero submodule otherwise. -/
def genSub (x : Gen K) : ChartSubmodule K (𝟙 X) := by
  classical
  exact if h : IsAffine (chartScheme (chartOf x.1)) then
    Classical.choose (hP (chartOf x.1) (chartOf x.1).1.hom (Category.comp_id _) h x.2)
  else ChartSubmodule.bot hK (𝟙 X)

/-- The section of a generator over an affine chart lies in its chosen submodule. -/
theorem mem_genSub (x : Gen K) (h : IsAffine (chartScheme (chartOf x.1))) :
    x.2 ∈ (genSub hK hP x).obj (chartOf x.1) (chartOf x.1).1.hom (Category.comp_id _) := by
  classical
  unfold genSub
  rw [dite_eq_left h]
  exact Classical.choose_spec (hP (chartOf x.1) (chartOf x.1).1.hom (Category.comp_id _) h x.2)

/-- The module underlying the chosen submodule of a generator. -/
abbrev genModule (x : Gen K) : Modules.{u, u} B S hS X hX :=
  ((genSub hK hP x).toSubmodule K).toSheafOfModules

/-- The family of morphisms into `ℬ` attached to a finite set of generators. -/
def fam (s : Finset (Gen K)) : ∀ x : s, genModule hK hP x.1 ⟶ AlgebraSheaf.underlyingModule ℬ :=
  fun x => ((genSub hK hP x.1).toSubmodule K).ι ≫ κ

/-- **The sheaf of ideals of `ℬ` attached to a finite set of generators.** -/
def ideal (s : Finset (Gen K)) : ℬ.IdealSheaf :=
  AlgebraSheaf.idealOfMaps ℬ (fam ℬ κ hK hP s)

/-- **The ideals grow with the set of generators.** -/
theorem ideal_mono {s s' : Finset (Gen K)} (h : s ⊆ s') :
    ideal ℬ κ hK hP s ≤ ideal ℬ κ hK hP s' :=
  AlgebraSheaf.idealOfMaps_mono ℬ _ _ fun _ x m => ⟨⟨x.1, h x.2⟩, m, rfl⟩

/-- **A section of `ℬ` over an affine chart coming from `𝒦` lies in the ideal of one generator.** -/
theorem exists_mem_ideal {W : SmallEtale B S hS X} (hW : IsAffine (chartScheme W))
    (k : K.val.obj (op W)) :
    ∃ x : Gen K, ((κ.val.app (op W) k : AlgebraSheaf.underlyingModule ℬ |>.val.obj (op W)) :
      ℬ.right.obj.obj (op W)) ∈ (ideal ℬ κ hK hP {x}).obj (op W) := by
  let e := equivSmallModel.{u} (SmallEtale B S hS X)
  let η : W ≅ chartOf (e.functor.obj W) := e.unitIso.app W
  let k' : K.val.obj (op (chartOf (e.functor.obj W))) := K.val.map η.inv.op k
  let x : Gen K := ⟨e.functor.obj W, k'⟩
  have haff : IsAffine (chartScheme (chartOf x.1)) := by
    have : IsAffine ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).obj W) := hW
    exact IsAffine.of_isIso ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).map η.inv)
  have hkW : K.val.map η.hom.op k' ∈ ((genSub hK hP x).toSubmodule K).obj (op W) :=
    ((genSub hK hP x).toSubmodule K).map η.hom.op
      ((ChartSubmodule.mem_toSubmodule (genSub hK hP x) _ k').2 (mem_genSub hK hP x haff))
  have hback : K.val.map η.hom.op k' = k :=
    (PresheafOfModules.map_comp_apply K.val η.inv.op η.hom.op k).symm.trans
      ((PresheafOfModules.congr_map_apply K.val
        (show η.inv.op ≫ η.hom.op = 𝟙 (op W) by rw [← op_comp, η.hom_inv_id, op_id]) k).trans
        (PresheafOfModules.map_id_apply K.val (op W) k))
  refine ⟨x, ?_⟩
  have := AlgebraSheaf.app_mem_idealOfMaps ℬ (fam ℬ κ hK hP {x}) (op W)
    ⟨x, Finset.mem_singleton_self x⟩ ⟨K.val.map η.hom.op k', hkW⟩
  change ((κ.val.app (op W) (K.val.map η.hom.op k')) : ℬ.right.obj.obj (op W)) ∈ _ at this
  rw [hback] at this
  exact this

/-- The module underlying the chosen submodule of a generator is cartesian on affine charts. -/
theorem isCartesianOnAffineCharts_genModule (x : Gen K) :
    IsCartesianOnAffineCharts (genModule hK hP x) :=
  (genSub hK hP x).isCartesianOnAffineCharts_toSubmodule hK

/-- The module underlying the chosen submodule of a generator has finitely generated sections
over affine charts. -/
theorem moduleFinite_genModule (x : Gen K) (W : SmallEtale B S hS X)
    (hW : IsAffine ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).obj W)) :
    Module.Finite (chartRing B S hS X hX W) ((genModule hK hP x).val.obj (op W)) :=
  Module.Finite.iff_fg.2 ((genSub hK hP x).fg_obj hK hW W.1.hom (Category.comp_id _))

/-- **The ideals of the system are quasi-coherent.** -/
theorem isQuasicoherentOnSite_idealModule_ideal
    (hℬ : IsCartesianOnAffineCharts (AlgebraSheaf.underlyingModule ℬ)) (s : Finset (Gen K)) :
    (AlgebraSheaf.idealModule ℬ (ideal ℬ κ hK hP s)).IsQuasicoherentOnSite :=
  AlgebraSheaf.isQuasicoherentOnSite_idealModule_idealOfMaps ℬ (fam ℬ κ hK hP s) hℬ
    (fun x => isCartesianOnAffineCharts_genModule hK hP x.1)
    (fun x W hW => moduleFinite_genModule hK hP x.1 W hW)

/-- **The ideals of the system have finitely generated sections over affine charts.** -/
theorem fg_sectionIdeal_ideal
    (hℬ : IsCartesianOnAffineCharts (AlgebraSheaf.underlyingModule ℬ)) (s : Finset (Gen K))
    (U : SmallEtale B S hS X)
    (hU : IsAffine ((SmallEtale.toOver B S hS X ⋙ BigFppfOver.toScheme B S hS).obj U)) :
    (Stacks.Sites.sectionIdeal (ideal ℬ κ hK hP s) (op U)).FG :=
  AlgebraSheaf.fg_sectionIdeal_idealOfMaps ℬ (fam ℬ κ hK hP s) hℬ
    (fun x => isCartesianOnAffineCharts_genModule hK hP x.1)
    (fun x W hW => moduleFinite_genModule hK hP x.1 W hW) U hU

/-- **The ideals of the system are killed by a morphism killing `𝒦`.** -/
theorem ideal_le_kerIdeal {C : AlgebraSheaf.{u, u} B S hS X hX} (f : ℬ ⟶ C)
    (hκ : κ ≫ AlgebraSheaf.underlyingModuleMap f = 0) (s : Finset (Gen K)) :
    ideal ℬ κ hK hP s ≤ AlgebraSheaf.kerIdeal f :=
  AlgebraSheaf.idealOfMaps_le_kerIdeal ℬ (fam ℬ κ hK hP s) f fun U x m =>
    congrArg (fun t => t.val.app U ((((genSub hK hP x.1).toSubmodule K).ι).val.app U m)) hκ


end AlgebraicGeometry.Space.KernelIdealSystem

end
