-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)

/-! ### A Zariski-open chart and its scheme -/

/-- The scheme underlying the Zariski-open chart cut out of an étale chart `U` by an open `O`
of its scheme is the open subscheme `O`. -/
theorem chartScheme_openChart (U : SmallEtale B S hS F) (O : (chartScheme U).Opens) :
    chartScheme (openChart B S hS F U O) = O.toScheme := rfl

/-- **A basic open of an affine étale chart is an affine étale chart.** -/
theorem isAffine_chartScheme_openChart_basicOpen (U : SmallEtale B S hS F)
    (hU : IsAffine (chartScheme U)) (g : Γ(chartScheme U, ⊤)) :
    IsAffine (chartScheme (openChart B S hS F U ((chartScheme U).basicOpen g))) :=
  have := hU
  inferInstanceAs (IsAffine ((chartScheme U).basicOpen g).toScheme)

/-! ### Regular functions on a Zariski-open chart -/

variable {F} (hF : IsAlgebraicSpace B S hS F)

/-- **Restriction of regular functions along the inclusion of a Zariski-open chart** is the map
of global functions induced by the inclusion of the open subscheme. -/
theorem chartRestrict_openChartInclusion (U : SmallEtale B S hS F)
    (O : (chartScheme U).Opens) :
    chartRestrict (hF := hF) (openChartInclusion B S hS F U O) = O.ι.appTop.hom :=
  congrArg (fun k : O.toScheme ⟶ chartScheme U => k.appTop.hom)
    (toScheme_map_toOver_map_openChartInclusion B S hS F U O)

/-- **A regular function restricted along the inclusion of its own basic open has that whole
open as its basic open**, which is the invertibility of the restricted function. -/
theorem basicOpen_appTop_ι_basicOpen (X : Scheme.{u}) (g : Γ(X, ⊤)) :
    (X.basicOpen g).toScheme.basicOpen ((X.basicOpen g).ι.appTop g) = ⊤ := by
  rw [← Scheme.preimage_basicOpen_top]
  exact Scheme.Opens.ι_preimage_self _

/-! ### The basic-open chart as a localization -/

/-- **The regular functions on the basic-open chart of `g` are the localization of the regular
functions on an affine chart away from `g`**, with restriction of functions as the structure
map.

This is Mathlib's `AlgebraicGeometry.Γ_restrict_isLocalization` for the scheme of the chart;
the only thing to check is that the algebra structure that
`AlgebraicGeometry.Space.chartAlgebra` puts on the functions of the basic-open chart is the one
coming from the inclusion of the open, which is
`AlgebraicGeometry.Space.chartRestrict_openChartInclusion`. -/
theorem isLocalization_away_chartRing_openChart_basicOpen (U : SmallEtale B S hS F)
    (hU : IsAffine (chartScheme U)) (g : chartRing B S hS F hF U) :
    letI := chartAlgebra (hF := hF)
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
    IsLocalization.Away g
      (chartRing B S hS F hF (openChart B S hS F U ((chartScheme U).basicOpen g))) := by
  have _ := hU
  have halg : chartAlgebra (hF := hF)
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)) =
      ΓRestrictAlgebra ((chartScheme U).basicOpen g) :=
    congrArg RingHom.toAlgebra
      (chartRestrict_openChartInclusion B S hS hF U ((chartScheme U).basicOpen g))
  exact halg ▸ Γ_restrict_isLocalization (chartScheme U) g

/-- **A regular function restricts to a unit on its own basic-open chart.** It belongs to the
monoid being inverted by
`AlgebraicGeometry.Space.isLocalization_away_chartRing_openChart_basicOpen`. -/
theorem isUnit_chartRestrict_openChartInclusion_basicOpen (U : SmallEtale B S hS F)
    (hU : IsAffine (chartScheme U)) (g : chartRing B S hS F hF U) :
    IsUnit (chartRestrict (hF := hF)
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)) g) := by
  let _ := chartAlgebra (hF := hF)
    (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
  have := isLocalization_away_chartRing_openChart_basicOpen B S hS hF U hU g
  exact IsLocalization.map_units
    (chartRing B S hS F hF (openChart B S hS F U ((chartScheme U).basicOpen g)))
    (⟨g, 1, pow_one g⟩ : Submonoid.powers g)

/-- **The sections of a cartesian `𝒪_F`-module over the basic-open chart of `g` are the
localization away from `g` of its sections over an affine chart**, with restriction of sections
as the structure map.

The functions on the basic-open chart are the localization away from `g`, so the base change of
the sections along it is a localization of modules
(`isLocalizedModule_iff_isBaseChange` and `TensorProduct.isBaseChange`); for a module cartesian
on affine charts the base change comparison
`AlgebraicGeometry.Space.sectionsBaseChange` is bijective, and restriction of sections is that
comparison applied to `1 ⊗ -`. -/
theorem isLocalizedModule_chartRestrictLinear_openChart_basicOpen
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (U : SmallEtale B S hS F) (hU : IsAffine (chartScheme U))
    (g : chartRing B S hS F hF U) :
    letI := chartSectionsModule G
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
    IsLocalizedModule.Away g
      (chartRestrictLinear G
        (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))) := by
  let _ := chartAlgebra (hF := hF)
    (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
  let _ := chartSectionsModule G (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
  have _ := chartSections_isScalarTower G
    (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
  have := isLocalization_away_chartRing_openChart_basicOpen B S hS hF U hU g
  have hmk : IsLocalizedModule (Submonoid.powers g)
      (TensorProduct.mk (chartRing B S hS F hF U)
        (chartRing B S hS F hF (openChart B S hS F U ((chartScheme U).basicOpen g)))
        (G.val.obj (op U)) 1) :=
    (isLocalizedModule_iff_isBaseChange (Submonoid.powers g)
      (chartRing B S hS F hF (openChart B S hS F U ((chartScheme U).basicOpen g))) _).mpr
      (TensorProduct.isBaseChange _ _ _)
  have hbij : Function.Bijective (sectionsBaseChange G
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))) :=
    hG U (openChart B S hS F U ((chartScheme U).basicOpen g)) hU
      (isAffine_chartScheme_openChart_basicOpen B S hS F U hU g) _
  have hcomp : chartRestrictLinear G
        (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)) =
      (sectionsBaseChange G
          (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))).restrictScalars
            (chartRing B S hS F hF U) ∘ₗ
        TensorProduct.mk (chartRing B S hS F hF U)
          (chartRing B S hS F hF (openChart B S hS F U ((chartScheme U).basicOpen g)))
          (G.val.obj (op U)) 1 := by
    ext x
    exact (chartBaseChange_one_tmul G
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)) x).symm
  rw [hcomp]
  exact (IsLocalizedModule.comp_iff_of_bijective_left (Submonoid.powers g)
    ((sectionsBaseChange G
        (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))).restrictScalars
      (chartRing B S hS F hF U)) hbij).mpr hmk

/-! ### Stacks 0859, part (2) -/

section Torsion

attribute [local instance] pointTopology

/-- A point of a chart carried to the scheme of the chart and back is unchanged. -/
private theorem chartPointsMap_schemePointsHomeomorph (U : SmallEtale B S hS F)
    (x : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U))) :
    chartPointsMap U (schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj U) x) =
      pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.1.hom x :=
  congrArg (pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.1.hom)
    ((schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj U)).symm_apply_apply x)

/-- The points of a Zariski-open chart are exactly the points of the ambient chart lying in
the open. -/
private theorem range_pointsMap_openChartInclusion (U : SmallEtale B S hS F)
    (O : (chartScheme U).Opens) :
    Set.range (pointsMap B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS F).obj (openChart B S hS F U O)))
        (yoneda.map ((SmallEtale.toOver B S hS F).map (openChartInclusion B S hS F U O)))) =
      schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj U) ⁻¹'
        (O : Set (chartScheme U)) := by
  rw [range_pointsMap_yoneda_eq_preimage, toScheme_map_toOver_map_openChartInclusion]
  exact congrArg (fun A => pointsToScheme B S hS ((SmallEtale.toOver B S hS F).obj U) ⁻¹' A)
    (Scheme.Opens.range_ι O)

/-- **A section vanishes on the basic-open chart of `g` exactly when a power of `g` kills
it.** For a module cartesian on affine charts the sections over the basic-open chart are the
localization away from `g` of the sections over the chart, so vanishing there is exactly
annihilation by an element of the multiplicative set generated by `g`. -/
theorem chartRestrictLinear_openChart_basicOpen_eq_zero_iff
    (G : Modules.{u, u} B S hS F hF) (hG : IsCartesianOnAffineCharts G)
    (U : SmallEtale B S hS F) (hU : IsAffine (chartScheme U))
    (g : chartRing B S hS F hF U) (s : G.val.obj (op U)) :
    G.val.map (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)).op s = 0 ↔
      ∃ k : ℕ, (g ^ k) • s = 0 := by
  let _ := chartAlgebra (hF := hF)
    (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
  let _ := chartSectionsModule G
    (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))
  have _ := isLocalizedModule_chartRestrictLinear_openChart_basicOpen B S hS hF G hG U hU g
  refine Iff.trans (IsLocalizedModule.eq_zero_iff (Submonoid.powers g)
    (chartRestrictLinear G
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)))) ?_
  refine ⟨?_, fun ⟨k, hk⟩ => ⟨⟨g ^ k, k, rfl⟩, hk⟩⟩
  rintro ⟨⟨_, k, rfl⟩, ht⟩
  exact ⟨k, ht⟩

/-- The points of the basic-open chart of a member of an ideal cutting out the preimage of `T`
avoid that preimage. -/
private theorem pointsMap_openChartInclusion_basicOpen_notMem {T : Set (points B S hS F)}
    (U : SmallEtale B S hS F) {I : Ideal (chartRing B S hS F hF U)}
    (hI : chartPointsMap U ⁻¹' T =
      (chartScheme U).zeroLocus (U := ⊤) (I : Set (chartRing B S hS F hF U)))
    {g : chartRing B S hS F hF U} (hg : g ∈ I)
    (y : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj
        (openChart B S hS F U ((chartScheme U).basicOpen g))))) :
    pointsMap B S hS _ (yoneda.map ((SmallEtale.toOver B S hS F).map
        (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)))) y ∉
      pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.1.hom ⁻¹' T := by
  intro hmem
  have hx : pointsMap B S hS _ (yoneda.map ((SmallEtale.toOver B S hS F).map
      (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)))) y ∈
      schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj U) ⁻¹'
        ((chartScheme U).basicOpen g : Set (chartScheme U)) := by
    rw [← range_pointsMap_openChartInclusion B S hS U ((chartScheme U).basicOpen g)]
    exact Set.mem_range_self y
  have hTmem : chartPointsMap U (schemePointsHomeomorph B S hS
      ((SmallEtale.toOver B S hS F).obj U) (pointsMap B S hS _
        (yoneda.map ((SmallEtale.toOver B S hS F).map
          (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)))) y)) ∈ T := by
    rwa [chartPointsMap_schemePointsHomeomorph]
  exact (Scheme.mem_zeroLocus_iff _ _ _).mp ((Set.ext_iff.mp hI _).mp hTmem) g hg hx

/-- A point of a chart outside the preimage of `T` lies in the basic open of some member of an
ideal cutting out that preimage. -/
private theorem exists_mem_basicOpen_of_pointsMap_notMem {T : Set (points B S hS F)}
    (U : SmallEtale B S hS F) {I : Ideal (chartRing B S hS F hF U)}
    (hI : chartPointsMap U ⁻¹' T =
      (chartScheme U).zeroLocus (U := ⊤) (I : Set (chartRing B S hS F hF U)))
    (x : points B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)))
    (hx : pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.1.hom x ∉ T) :
    ∃ g ∈ (I : Set (chartRing B S hS F hF U)),
      schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj U) x ∈
        (chartScheme U).basicOpen g := by
  by_contra hno
  apply hx
  have hzl : schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj U) x ∈
      (chartScheme U).zeroLocus (U := ⊤) (I : Set (chartRing B S hS F hF U)) :=
    (Scheme.mem_zeroLocus_iff _ _ _).mpr fun f hf hxf => hno ⟨f, hf, hxf⟩
  have hmem := (Set.ext_iff.mp hI _).mpr hzl
  rwa [Set.mem_preimage, chartPointsMap_schemePointsHomeomorph] at hmem

/-- Let `T` be a subset of the points of an algebraic space `F`, let
`U` be an affine étale chart of `F` and let `I` be a finitely generated ideal of the regular
functions on the chart whose zero locus is the preimage of `T`. A section of a quasi-coherent
`𝒪_F`-module over `U` is supported on `T` exactly when some power of `I` annihilates it.

Part (1), `AlgebraicGeometry.Space.exists_fg_ideal_zeroLocus_eq_preimage_chartPointsMap`,
supplies such an `I` whenever `T` is closed and its complement is the point set of an open
subspace with quasi-compact inclusion; `AlgebraicGeometry.Space.chartRing` of a chart is the
ring of global functions on its scheme, so the two are ideals of the same ring.

Quasi-coherence enters only through
`AlgebraicGeometry.Space.IsCartesianOnAffineCharts`, which it implies by Stacks 03DX; it is
derived here rather than assumed, since Stacks 0859 already assumes the module
quasi-coherent. -/
@[stacks 0859 "part (2): the supported sections over an affine chart are the ideal-power torsion"]
theorem sectionSupportedIn_iff_exists_pow_le_annihilator
    (G : Modules.{u, u} B S hS F hF) (hG : G.IsQuasicoherentOnSite)
    (T : Set (points B S hS F)) (U : SmallEtale B S hS F) (hU : IsAffine (chartScheme U))
    {I : Ideal (chartRing B S hS F hF U)} (hIfg : I.FG)
    (hI : chartPointsMap U ⁻¹' T =
      (chartScheme U).zeroLocus (U := ⊤) (I : Set (chartRing B S hS F hF U)))
    (s : G.val.obj (op U)) :
    SectionSupportedIn B S hS F hF T G U s ↔ ∃ n : ℕ, ∀ a ∈ I ^ n, a • s = 0 := by
  have hcart : IsCartesianOnAffineCharts G :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF G hG
  set J : Ideal (chartRing B S hS F hF U) := (Submodule.span _ {s}).annihilator
  have hJmem : ∀ a : chartRing B S hS F hF U, a ∈ J ↔ a • s = 0 :=
    Submodule.mem_annihilator_span_singleton _
  constructor
  · intro hs
    have hrad : I ≤ J.radical := by
      intro g hg
      have himg : ImageInOpen B S hS F
          (largestOpenZeroLocus B S hS F (moduleAddSheaf B S hS F hF G) U s).1
          (openChartInclusion B S hS F U ((chartScheme U).basicOpen g)) := by
        intro y
        by_contra hcon
        exact pointsMap_openChartInclusion_basicOpen_notMem B S hS hF U hI hg y (hs hcon)
      have hzero : G.val.map (openChartInclusion B S hS F U
          ((chartScheme U).basicOpen g)).op s = 0 :=
        (largestOpenZeroLocus_restrict_iff B S hS F (moduleAddSheaf B S hS F hF G) U s _
          (openChartInclusion B S hS F U ((chartScheme U).basicOpen g))).2 himg
      obtain ⟨k, hk⟩ := (chartRestrictLinear_openChart_basicOpen_eq_zero_iff
        B S hS hF G hcart U hU g s).mp hzero
      exact ⟨k, (hJmem (g ^ k)).mpr hk⟩
    obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad hIfg
    exact ⟨n, fun a ha => (hJmem a).mp (hn ha)⟩
  · rintro ⟨n, hn⟩ x hx
    by_contra hcon
    obtain ⟨g, hg, hxg⟩ := exists_mem_basicOpen_of_pointsMap_notMem B S hS hF U hI x hcon
    have hzero : G.val.map (openChartInclusion B S hS F U
        ((chartScheme U).basicOpen g)).op s = 0 :=
      (chartRestrictLinear_openChart_basicOpen_eq_zero_iff
        B S hS hF G hcart U hU g s).mpr ⟨n, hn _ (Ideal.pow_mem_pow hg n)⟩
    obtain ⟨y, hy⟩ : x ∈ Set.range (pointsMap B S hS _ (yoneda.map
        ((SmallEtale.toOver B S hS F).map (openChartInclusion B S hS F U
          ((chartScheme U).basicOpen g))))) := by
      rwa [range_pointsMap_openChartInclusion B S hS U ((chartScheme U).basicOpen g)]
    exact hx ⟨openChart B S hS F U ((chartScheme U).basicOpen g),
      openChartInclusion B S hS F U ((chartScheme U).basicOpen g), hzero, y, hy⟩

end Torsion

/-! ### Zero loci and the pushforward of an ideal -/

/-- **The preimage of the zero locus of an ideal of global functions is the zero locus of the
ideal it generates downstairs.**  Mathlib's `AlgebraicGeometry.Scheme.preimage_zeroLocus`
computes the preimage as the zero locus of the *image set* of the ideal, and
`AlgebraicGeometry.Scheme.zeroLocus_span` replaces that set by the ideal it spans, which is
`Ideal.map` of it. -/
theorem preimage_zeroLocus_ideal_map {X Y : Scheme.{u}} (φ : Y ⟶ X) (J : Ideal Γ(X, ⊤)) :
    φ ⁻¹' X.zeroLocus (U := ⊤) (J : Set Γ(X, ⊤)) =
      Y.zeroLocus (U := ⊤) ((Ideal.map φ.appTop.hom J : Ideal Γ(Y, ⊤)) : Set Γ(Y, ⊤)) := by
  rw [Scheme.preimage_zeroLocus, Ideal.map, ← Scheme.zeroLocus_span]
  rfl

/-! ### Ideal-power torsion and flat base change -/

/-- **Ideal-power torsion commutes with flat base change**, in the form the comparison of
supported sections needs: for a flat `A`-algebra `A'`, a finitely generated ideal `I` of `A` and
a submodule `P` of an `A`-module `M` containing everything that `I ^ n` annihilates, every
element of `A' ⊗_A M` annihilated by `I ^ n` already comes from `A' ⊗_A P`.

Writing `I ^ n = (a_1, …, a_r)`, the submodule annihilated by `I ^ n` is the kernel of
`x ↦ (a_1 x, …, a_r x)`, so flatness carries the exact sequence
`0 → ker → M → M ^ r` through the base change (`Module.Flat.lTensor_exact`); the kernel of the
base changed map is again the elements annihilated by every `a_i`, because
`TensorProduct.piRight` identifies `A' ⊗_A M ^ r` with `(A' ⊗_A M) ^ r` componentwise.  Finite
generation of `I` is used exactly here, to make the index set of the generators finite.

Only the containment `ker ⊆ P` is used, which is why the hypothesis on `P` is one-sided; for
the supported sections `P` is the ideal-power torsion itself and the containment is an
equality. -/
theorem mem_range_lTensor_of_pow_smul_eq_zero
    {A : Type u} [CommRing A] {A' : Type u} [CommRing A'] [Algebra A A']
    [Module.Flat A A'] {M : Type u} [AddCommGroup M] [Module A M]
    (P : Submodule A M) {I : Ideal A} (hIfg : I.FG) {n : ℕ}
    (hP : ∀ x : M, (∀ a ∈ I ^ n, a • x = 0) → x ∈ P)
    (y : TensorProduct A A' M) (hy : ∀ a ∈ I ^ n, a • y = 0) :
    y ∈ LinearMap.range (LinearMap.lTensor A' P.subtype) := by
  classical
  obtain ⟨s, hs⟩ := hIfg.pow (n := n)
  set ι := {x : A // x ∈ s}
  set gen : ι → A := fun a => a.1
  have hgenmem : ∀ i : ι, gen i ∈ I ^ n := fun i => hs ▸ Ideal.subset_span i.2
  set φ : M →ₗ[A] (ι → M) := LinearMap.pi fun i => LinearMap.lsmul A M (gen i)
  have hφapply : ∀ (x : M) (i : ι), φ x i = gen i • x := fun _ _ => rfl
  have hker : LinearMap.ker φ ≤ P := by
    intro x hx
    refine hP x ?_
    have hspan : I ^ n ≤ (Submodule.span A {x}).annihilator := by
      rw [← hs, Ideal.span_le]
      exact fun a ha => (Submodule.mem_annihilator_span_singleton _ _).mpr
        (congrFun (LinearMap.mem_ker.mp hx) ⟨a, ha⟩)
    exact fun a ha => (Submodule.mem_annihilator_span_singleton _ _).mp (hspan ha)
  have hex : Function.Exact (LinearMap.lTensor A' (LinearMap.ker φ).subtype)
      (LinearMap.lTensor A' φ) :=
    Module.Flat.lTensor_exact A' (LinearMap.exact_subtype_ker_map φ)
  have hcomp : ∀ (z : TensorProduct A A' M) (i : ι),
      TensorProduct.piRight A A A' (fun _ : ι => M) (LinearMap.lTensor A' φ z) i =
        gen i • z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => intro i; simp
    | tmul b x =>
      intro i
      rw [LinearMap.lTensor_tmul, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
      show TensorProduct.tmul A b (φ x i) = gen i • TensorProduct.tmul A b x
      rw [hφapply, TensorProduct.tmul_smul]
    | add z w hz hw => intro i; rw [map_add, map_add, Pi.add_apply, hz, hw, smul_add]
  have hzero : LinearMap.lTensor A' φ y = 0 := by
    refine (TensorProduct.piRight A A A' (fun _ : ι => M)).injective ?_
    rw [map_zero]
    funext i
    rw [hcomp y i, hy (gen i) (hgenmem i)]
    rfl
  obtain ⟨z, hz⟩ := (hex y).mp hzero
  exact ⟨LinearMap.lTensor A' (Submodule.inclusion hker) z, by
    rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]; exact hz⟩

/-- A power of the image of an ideal under a ring map annihilates an element exactly when the
image of the same power of the ideal does. -/
private theorem forall_mem_map_pow_smul_eq_zero_iff {A A' M : Type*} [CommRing A] [CommRing A']
    [AddCommGroup M] [Module A' M] (f : A →+* A') (I : Ideal A) (n : ℕ) (x : M) :
    (∀ b ∈ Ideal.map f I ^ n, b • x = 0) ↔ ∀ a ∈ I ^ n, f a • x = 0 := by
  simp_rw [← Submodule.mem_annihilator_span_singleton, ← Ideal.map_pow]
  exact Ideal.map_le_iff_le_comap (K := (Submodule.span A' {x}).annihilator)

/-! ### Stacks 0859, part (3) -/

section Quasicoherent

attribute [local instance] pointTopology

/-- **The map on points of a chart is the map on points of any chart it factors through**,
composed with the morphism of underlying schemes.

This is naturality of the comparison homeomorphism of Stacks 03BX,
`AlgebraicGeometry.Space.pointsMap_yoneda_eq_conj`, together with the triangle of a chart
morphism over `F`, `AlgebraicGeometry.Space.pointsMap_chart_hom`. -/
theorem chartPointsMap_comp {U V : SmallEtale B S hS F} (g : V ⟶ U) (x : chartScheme V) :
    chartPointsMap V x =
      chartPointsMap U
        (((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map g)) x) := by
  have hconj := congrFun (pointsMap_yoneda_eq_conj B S hS ((SmallEtale.toOver B S hS F).map g))
      ((schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj V)).symm x)
  rw [Function.comp_apply, Function.comp_apply, Homeomorph.apply_symm_apply] at hconj
  exact (pointsMap_chart_hom B S hS F g
      ((schemePointsHomeomorph B S hS ((SmallEtale.toOver B S hS F).obj V)).symm x)).symm.trans
    (congrArg (pointsMap B S hS (yoneda.obj ((SmallEtale.toOver B S hS F).obj U)) U.obj.hom)
      hconj)

/-- **An ideal cutting out a subset of the points of `F` on a chart cuts it out on every chart
over it**, after pushing it forward along restriction of functions.

So part (1) of Stacks 0859 only has to be invoked on the *larger* of two affine charts: the
ideal for the smaller one can be taken to be the image of the ideal for the larger one, which
keeps it finitely generated and makes its relation to the larger chart transparent.  That is
what lets part (2) describe the supported sections over both charts by one and the same ideal of
functions on the larger chart. -/
theorem preimage_chartPointsMap_eq_zeroLocus_map {T : Set (points B S hS F)}
    {U V : SmallEtale B S hS F} (g : V ⟶ U) (I : Ideal (chartRing B S hS F hF U))
    (hI : chartPointsMap U ⁻¹' T =
      (chartScheme U).zeroLocus (U := ⊤) (I : Set (chartRing B S hS F hF U))) :
    chartPointsMap V ⁻¹' T =
      (chartScheme V).zeroLocus (U := ⊤)
        ((Ideal.map (chartRestrict (hF := hF) g) I : Ideal (chartRing B S hS F hF V)) :
          Set (chartRing B S hS F hF V)) := by
  have hpre : chartPointsMap V ⁻¹' T =
      ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map g)) ⁻¹'
        (chartPointsMap U ⁻¹' T) :=
    Set.ext fun x => Iff.of_eq (congrArg (fun p => p ∈ T) (chartPointsMap_comp B S hS g x))
  rw [hpre, hI]
  exact preimage_zeroLocus_ideal_map
    ((BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS F).map g)) I

/-- **The base change comparison of the supported-section subsheaf is bijective over a morphism
of affine étale charts.**  This is the whole content of part (3) of Stacks 0859; quasi-coherence
of the subsheaf is this statement read through Descent, Proposition 03DX (2).

Part (2), `AlgebraicGeometry.Space.sectionSupportedIn_iff_exists_pow_le_annihilator`, describes
the sections supported on `T` over each of the two charts as the ideal-power torsion of the
sections there, for the ideal of part (1); by
`AlgebraicGeometry.Space.preimage_chartPointsMap_eq_zeroLocus_map` one ideal `I` on the larger
chart serves for both, the ideal on the smaller chart being its image under restriction.  What
remains is purely algebraic — that `I`-power torsion commutes with flat base change,
`AlgebraicGeometry.Space.mem_range_lTensor_of_pow_smul_eq_zero` — the flatness being
`AlgebraicGeometry.Space.flat_chartRestrict_of_isAffine`, since both charts are affine and a
morphism of étale charts is étale.  Injectivity needs nothing beyond flatness and the ambient
module, by `AlgebraicGeometry.Space.injective_sectionsBaseChange_of_injective_app`. -/
theorem bijective_sectionsBaseChange_supportedSectionsSubmodule
    (G : Modules.{u, u} B S hS F hF) (hG : G.IsQuasicoherentOnSite)
    {T : Set (points B S hS F)} (hT : IsClosed T) {O : Subfunctor F}
    (hO : IsOpenSubspace B S hS O)
    (hOT : Set.range (pointsMap B S hS O.toFunctor O.ι) = Tᶜ)
    (hOqc : IsQuasiCompact B S hS O.ι) {U V : SmallEtale B S hS F}
    (hU : IsAffine (chartScheme U)) (hV : IsAffine (chartScheme V)) (g : V ⟶ U) :
    Function.Bijective (sectionsBaseChange
      (supportedSectionsSubmodule B S hS F hF T G).toSheafOfModules g) := by
  set N := supportedSectionsSubmodule B S hS F hF T G
  let _ := chartAlgebra (hF := hF) g
  let _ := chartSectionsModule G g
  have _ : Module.Flat (chartRing B S hS F hF U) (chartRing B S hS F hF V) :=
    flat_chartRestrict_of_isAffine g hU hV
  have hGbij : Function.Bijective (sectionsBaseChange G g) :=
    isCartesianOnAffineCharts_of_isQuasicoherentOnSite B S hS F hF G hG U V hU hV g
  obtain ⟨I, hIfg, hI⟩ : ∃ I : Ideal (chartRing B S hS F hF U), I.FG ∧
      chartPointsMap U ⁻¹' T =
        (chartScheme U).zeroLocus (U := ⊤) (I : Set (chartRing B S hS F hF U)) :=
    exists_fg_ideal_zeroLocus_eq_preimage_chartPointsMap hF hT hO hOT hOqc U hU
  -- part (2) over a chart, for any ideal cutting out the subset there
  have hmem : ∀ (W : SmallEtale B S hS F), IsAffine (chartScheme W) →
      ∀ {J : Ideal (chartRing B S hS F hF W)}, J.FG →
      chartPointsMap W ⁻¹' T =
        (chartScheme W).zeroLocus (U := ⊤) (J : Set (chartRing B S hS F hF W)) →
      ∀ x : G.val.obj (op W),
        x ∈ N.toSubmodule.obj (op W) ↔ ∃ n : ℕ, ∀ a ∈ J ^ n, a • x = 0 :=
    fun W hW J hJfg hJ x => (mem_supportedSectionsSubmodule_iff B S hS F hF T G W x).trans
      (sectionSupportedIn_iff_exists_pow_le_annihilator B S hS hF G hG T W hW hJfg hJ x)
  have hmemU := hmem U hU hIfg hI
  -- over the smaller chart, read with the image of the same ideal
  have hmemV := fun x => (hmem V hV (hIfg.map _)
    (preimage_chartPointsMap_eq_zeroLocus_map B S hS hF g I hI) x).trans
      (exists_congr fun n =>
        forall_mem_map_pow_smul_eq_zero_iff (chartRestrict (hF := hF) g) I n x)
  have hinjι : ∀ W, Function.Injective (N.ι.val.app (op W)) :=
    fun _ _ _ hab => Subtype.val_injective hab
  have hinj : Function.Injective (sectionsBaseChange N.toSheafOfModules g) :=
    injective_sectionsBaseChange_of_injective_app N.ι g
      (flat_chartRestrict_of_isAffine g hU hV) (fun _ _ hab => hinjι U hab) hGbij
  refine ⟨hinj, fun t => ?_⟩
  obtain ⟨n, hn⟩ := (hmemV ((N.ι.val.app (op V)) t)).mp t.2
  obtain ⟨y, hy⟩ := hGbij.2 ((N.ι.val.app (op V)) t)
  have hytors : ∀ a ∈ I ^ n, a • y = 0 := by
    intro a ha
    refine hGbij.1 ?_
    rw [map_zero, ← algebraMap_smul (chartRing B S hS F hF V) a y, map_smul, hy]
    exact hn a ha
  obtain ⟨z, hz⟩ := mem_range_lTensor_of_pow_smul_eq_zero (N.toSubmodule.obj (op U)) hIfg
    (fun x hx => (hmemU x).mpr ⟨n, hx⟩) y hytors
  refine ⟨z, hinjι V ?_⟩
  rw [app_sectionsBaseChange N.ι g z, ← hy]
  exact congrArg (sectionsBaseChange G g) hz

/-- Let `T ⊆ |F|` be a closed subset of the points of an algebraic
space `F` whose complement is the point set of an open subspace `O ⊆ F` with quasi-compact
inclusion, and let `G` be a quasi-coherent `𝒪_F`-module.  Then the subsheaf of `G` of sections
supported on `T` is again quasi-coherent.

The hypotheses are `T` closed, `T ⨿ |O| = |F|`, and `O → F` quasi-compact.  Quasi-coherence
of the subsheaf is `SheafOfModules.IsQuasicoherentOnSite` (Stacks 03DL (6)), the condition that
cuts out `AlgebraicGeometry.Space.QuasicoherentSheaves` (Stacks 03G9); it follows from
`AlgebraicGeometry.Space.bijective_sectionsBaseChange_supportedSectionsSubmodule` by
Descent, Proposition 03DX (2),
`AlgebraicGeometry.Space.isQuasicoherentOnSite_iff_isCartesianOnAffineCharts`. -/
@[stacks 0859 "part (3): the subsheaf of sections supported on T is quasi-coherent"]
theorem isQuasicoherentOnSite_supportedSectionsSubmodule
    (G : Modules.{u, u} B S hS F hF) (hG : G.IsQuasicoherentOnSite)
    {T : Set (points B S hS F)} (hT : IsClosed T) {O : Subfunctor F}
    (hO : IsOpenSubspace B S hS O)
    (hOT : Set.range (pointsMap B S hS O.toFunctor O.ι) = Tᶜ)
    (hOqc : IsQuasiCompact B S hS O.ι) :
    (supportedSectionsSubmodule B S hS F hF T G).toSheafOfModules.IsQuasicoherentOnSite :=
  (isQuasicoherentOnSite_iff_isCartesianOnAffineCharts B S hS F hF _).mpr
    fun _ _ hU hV g =>
      bijective_sectionsBaseChange_supportedSectionsSubmodule B S hS hF G hG hT hO hOT hOqc
        hU hV g

end Quasicoherent

end AlgebraicGeometry.Space

