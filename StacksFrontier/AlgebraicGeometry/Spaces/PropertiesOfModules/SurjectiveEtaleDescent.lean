/-!
# Local properties of modules descend along a surjective étale morphism

Let `f : Y ⟶ X` be an étale morphism of algebraic spaces which is surjective on points.  Then
`{Y → X}` is a covering of `X` in the small étale site, and each of the local properties of
modules of Stacks 03DL which is local on the site in the sense of Stacks 03DN descends along it:
if the inverse image `f^*M` of an `𝒪_X`-module `M` (Stacks 03LU) has the property, so has `M`.

The route is uniform.  An étale chart `V₀` of `Y` surjective on points composes with `f` to an
étale chart of `X` surjective on points, which covers the final object.  Every chart of `X` is
therefore covered by charts mapping to that composite, and those are, up to isomorphism,
composites of charts of `Y`.  Over the composite of a chart `V` of `Y`, the restriction of `M`
is the reindexing of the restriction of `f^*M` to `V` along the slice comparison of Stacks 04M0,
so the global condition defining each local property (freeness, finite freeness, generation by
global sections, by `r` of them, by finitely many) passes from `f^*M` to `M`.  Coherence is not
of that shape; it is read on the slice at the surjective composite chart directly.

## Main results

* `AlgebraicGeometry.Space.isLocallyFreeOnSite_of_modulePullback_of_isSurjective`,
  `AlgebraicGeometry.Space.isFiniteLocallyFreeOnSite_of_modulePullback_of_isSurjective`,
  `AlgebraicGeometry.Space.isLocallyGeneratedBySectionsOnSite_of_modulePullback_of_isSurjective`,
  `AlgebraicGeometry.Space.isLocallyGeneratedByOnSite_of_modulePullback_of_isSurjective`,
  `AlgebraicGeometry.Space.isFiniteTypeOnSite_of_modulePullback_of_isSurjective`,
  `AlgebraicGeometry.Space.isQuasicoherentOnSite_of_modulePullback_of_isSurjective` and
  `AlgebraicGeometry.Space.isCoherentOnSite_of_modulePullback_of_isSurjective`: the properties
  locally free, finite locally free, locally generated by sections, locally generated by `r`
  sections, of finite type, quasi-coherent and coherent descend along a surjective étale
  morphism.  The case of finite presentation is
  `AlgebraicGeometry.Space.isFinitePresentationOnSite_of_modulePullback`.

## References

* [Stacks Project, Tag 05VR](https://stacks.math.columbia.edu/tag/05VR)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03DN](https://stacks.math.columbia.edu/tag/03DN)
* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU)
* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

section Generic

universe v₁ u₁ w₁

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}

/-- A family of objects of a site satisfying a property stable under passing to a source of an
arrow, which covers the final object, gives every object a covering family of arrows whose
sources satisfy the property. -/
private theorem exists_cover_of_coversTop_subtype (Q : C → Prop)
    (hQ : ∀ {Z W : C} (_ : Z ⟶ W), Q W → Q Z)
    (hcov : J.CoversTop (fun z : {Z : C // Q Z} => z.1)) (W : C) :
    ∃ (I : Type (max u₁ v₁)) (V : I → C) (g : ∀ i, V i ⟶ W),
      Sieve.ofArrows V g ∈ J W ∧ ∀ i, Q (V i) := by
  refine ⟨{q : (Σ Z : C, Z ⟶ W) // Q q.1}, fun q => q.1.1, fun q => q.1.2,
    J.superset_covering ?_ (hcov W), fun q => q.2⟩
  intro Z g hg
  obtain ⟨z, ⟨a⟩⟩ := (Sieve.mem_ofObjects_iff _ g).mp hg
  exact (Sieve.mem_ofArrows_iff _ _ _).2 ⟨⟨⟨Z, g⟩, hQ a z.2⟩, 𝟙 Z, (Category.id_comp _).symm⟩

/-- A covering family of arrows whose sources satisfy a property generates a sieve contained in
the sieve of arrows factoring through an object satisfying it, which is therefore covering. -/
private theorem ofObjects_subtype_mem_of_ofArrows_mem (Q : C → Prop) {W : C} {I : Type*}
    {V : I → C} {g : ∀ i, V i ⟶ W} (hcov : Sieve.ofArrows V g ∈ J W) (hV : ∀ i, Q (V i)) :
    Sieve.ofObjects (fun z : {Z : C // Q Z} => z.1) W ∈ J W := by
  refine J.superset_covering ?_ hcov
  intro T p hp
  obtain ⟨i, b, -⟩ := (Sieve.mem_ofArrows_iff _ _ _).mp hp
  exact ⟨⟨V i, hV i⟩, ⟨b⟩⟩

/-- An isomorphism of sheaves of modules carries a presentation as a coproduct of copies of the
structure sheaf, indexed by a given type, to such a presentation. -/
private theorem exists_isColimitCofan_of_iso {R : Sheaf J RingCat.{w₁}}
    {F G : SheafOfModules.{w₁} R} (e : F ≅ G) {B : Type*}
    (h : ∃ ι : B → (SheafOfModules.unit R ⟶ F), Nonempty (IsColimit (Cofan.mk F ι))) :
    ∃ ι : B → (SheafOfModules.unit R ⟶ G), Nonempty (IsColimit (Cofan.mk G ι)) := by
  obtain ⟨ι, ⟨hc⟩⟩ := h
  exact ⟨fun b => ι b ≫ e.hom,
    ⟨hc.ofIsoColimit (Cocone.ext e (by rintro ⟨b⟩; rfl))⟩⟩

end Generic

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- **Objects of a local kind cover an algebraic space once they cover a surjective étale
cover.**  Let `f : Y ⟶ X` be étale and surjective on points, and `Q` a property of the étale
charts of `X`.  If every chart of `Y` is covered by charts whose composites with `f` satisfy
`Q`, then the charts of `X` satisfying `Q` cover the final object of the small étale site of
`X`. -/
theorem coversTop_subtype_of_forall_ofObjects_postcomp_mem (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (Q : (smallEtaleRingedSite B S hS X.1 X.2).C → Prop)
    (hQ : ∀ V : (smallEtaleRingedSite B S hS Y.1 Y.2).C,
      Sieve.ofObjects (fun z : {V' : (smallEtaleRingedSite B S hS Y.1 Y.2).C //
        Q ((ringedSitePostcomp B S hS f hf).obj V')} => z.1) V ∈
        (smallEtaleRingedSite B S hS Y.1 Y.2).J V) :
    (smallEtaleRingedSite B S hS X.1 X.2).J.CoversTop
      (fun z : {Z : (smallEtaleRingedSite B S hS X.1 X.2).C // Q Z} => z.1) := by
  obtain ⟨V₀, hV₀⟩ := exists_surjective_smallEtale_chart B S hS Y.1 Y.2
  have hcovU₀ : (smallEtaleRingedSite B S hS X.1 X.2).J.CoversTop
      (fun _ : PUnit.{u + 2} => (ringedSitePostcomp B S hS f hf).obj V₀) :=
    SmallEtale.coversTop_of_isSurjective B S hS X.1 X.2
      ((smallEtalePostcomp B S hS f hf).obj V₀)
      (isSurjective_smallEtalePostcomp_obj_hom B S hS f hf hsurj V₀ hV₀)
  intro W
  refine (smallEtaleRingedSite B S hS X.1 X.2).J.transitive (hcovU₀ W) _
    fun W' g hg => ?_
  obtain ⟨-, ⟨a⟩⟩ := (Sieve.mem_ofObjects_iff _ g).mp hg
  have hpush := (SmallEtale.coverPreserving_smallEtalePostcomp B S hS f hf).cover_preserve
    (hQ ((SmallEtale.postcompOverInverse B S hS f hf V₀).obj (Over.mk a)).left)
  have hle : Sieve.functorPushforward (ringedSitePostcomp B S hS f hf)
      (Sieve.ofObjects (fun z : {V' : (smallEtaleRingedSite B S hS Y.1 Y.2).C //
        Q ((ringedSitePostcomp B S hS f hf).obj V')} => z.1)
        ((SmallEtale.postcompOverInverse B S hS f hf V₀).obj (Over.mk a)).left) ≤
      Sieve.ofObjects (fun z : {Z : (smallEtaleRingedSite B S hS X.1 X.2).C // Q Z} => z.1)
        ((ringedSitePostcomp B S hS f hf).obj
          ((SmallEtale.postcompOverInverse B S hS f hf V₀).obj (Over.mk a)).left) := by
    rintro T p ⟨Z₀, p₀, q, hp₀, rfl⟩
    obtain ⟨z, ⟨b⟩⟩ := (Sieve.mem_ofObjects_iff _ p₀).mp hp₀
    exact ⟨⟨_, z.2⟩, ⟨q ≫ (ringedSitePostcomp B S hS f hf).map b⟩⟩
  have hα := (smallEtaleRingedSite B S hS X.1 X.2).J.pullback_stable
    ((Over.forget ((smallEtalePostcomp B S hS f hf).obj V₀)).mapIso
      ((SmallEtale.postcompOverCounitIso B S hS f hf V₀).app (Over.mk a))).inv
    ((smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering hle hpush)
  exact (smallEtaleRingedSite B S hS X.1 X.2).J.superset_covering (fun _ _ hb => hb) hα

/-! ### Transport of the global conditions to the composite chart -/

/-- **Freeness passes from an étale pullback to the composite chart.** If the restriction of the
étale pullback of `M` along an étale `f : Y ⟶ X` to a chart `V` of `Y` is free, so is the
restriction of `M` to the composite chart of `X`. -/
theorem isFree_over_postcomp_of (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2) (V : (smallEtaleRingedSite B S hS Y.1 Y.2).C)
    (h : (((etaleModulePullback B S hS f hf).obj M).over V).IsFree) :
    (M.over ((ringedSitePostcomp B S hS f hf).obj V)).IsFree :=
  (Stacks.SheafOfModules.isFree_reindex_iff
    (J' := (smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
    (smallEtaleRingedSitePostcompOverEquivalence B S hS f hf V)
    ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over
      ((ringedSitePostcomp B S hS f hf).obj V))
    (M.over ((ringedSitePostcomp B S hS f hf).obj V))).1 h

/-- **Finite freeness passes from an étale pullback to the composite chart.** If the restriction
of the étale pullback of `M` along an étale `f : Y ⟶ X` to a chart `V` of `Y` is finite free, so
is the restriction of `M` to the composite chart of `X`. -/
theorem isFiniteFree_over_postcomp_of (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2) (V : (smallEtaleRingedSite B S hS Y.1 Y.2).C)
    (h : SheafOfModules.IsFiniteFree
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS Y.1 Y.2).O).over V)
      (((etaleModulePullback B S hS f hf).obj M).over V)) :
    SheafOfModules.IsFiniteFree
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over
        ((ringedSitePostcomp B S hS f hf).obj V))
      (M.over ((ringedSitePostcomp B S hS f hf).obj V)) :=
  (Stacks.SheafOfModules.isFiniteFree_reindex_iff
    (J' := (smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
    (smallEtaleRingedSitePostcompOverEquivalence B S hS f hf V)
    ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over
      ((ringedSitePostcomp B S hS f hf).obj V))
    (M.over ((ringedSitePostcomp B S hS f hf).obj V))).1 h

/-- **Generating sections pass from an étale pullback to the composite chart.** A family of
global sections generating the restriction of the étale pullback of `M` along an étale
`f : Y ⟶ X` to a chart `V` of `Y` gives one, with the same index type, generating the restriction
of `M` to the composite chart of `X`. -/
theorem exists_generatingSections_over_postcomp_of (f : Y ⟶ X) (hf : IsEtale B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2) (V : (smallEtaleRingedSite B S hS Y.1 Y.2).C)
    (σ : (((etaleModulePullback B S hS f hf).obj M).over V).GeneratingSections) :
    ∃ τ : (M.over ((ringedSitePostcomp B S hS f hf).obj V)).GeneratingSections,
      Nonempty (τ.I ≃ σ.I) :=
  ⟨Stacks.SheafOfModules.generatingSectionsOfReindex
    (J' := (smallEtaleRingedSite B S hS Y.1 Y.2).J.over V)
    (smallEtaleRingedSitePostcompOverEquivalence B S hS f hf V)
    ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over
      ((ringedSitePostcomp B S hS f hf).obj V)) σ, ⟨Equiv.refl _⟩⟩

/-! ### Descent of the local properties -/

/-- **Local freeness descends along a surjective étale morphism** (Stacks 05VR, with Stacks 03DN):
if the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on points is locally
free, so is `M`. -/
@[stacks 05VR "consequence (3), property 'locally free': for a surjective étale morphism f : Y → X \
of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is locally free then 𝓕 is locally free"]
theorem isLocallyFreeOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : SheafOfModules.IsLocallyFreeOnSite ((modulePullback B S hS f).obj M)) :
    SheafOfModules.IsLocallyFreeOnSite M := by
  have hcov := coversTop_subtype_of_forall_ofObjects_postcomp_mem B S hS f hf hsurj
    (fun Z => (M.over Z).IsFree) fun V => by
      obtain ⟨I, W, g, hg, hfree⟩ := (SheafOfModules.isLocallyFreeOnSite_iff_isFree _).1 h V
      refine ofObjects_subtype_mem_of_ofArrows_mem _ hg fun i => ?_
      obtain ⟨Bi, hBi⟩ := hfree i
      exact isFree_over_postcomp_of B S hS f hf M (W i) ⟨Bi, exists_isColimitCofan_of_iso
        ((SheafOfModules.overFunctor _ (W i)).mapIso
          ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M)) hBi⟩
  exact (SheafOfModules.isLocallyFreeOnSite_iff_isFree M).2 fun W =>
    Stacks.SheafOfModules.exists_cover_isFree_of_coversTop _ hcov M (fun z => z.2) W

/-- **Finite local freeness descends along a surjective étale morphism** (Stacks 05VR, with
Stacks 03DN): if the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on
points is finite locally free, so is `M`. -/
@[stacks 05VR "consequence (3), property 'finite locally free': for a surjective étale morphism f \
: Y → X of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is finite locally free then 𝓕 is finite \
locally free"]
theorem isFiniteLocallyFreeOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : SheafOfModules.IsFiniteLocallyFreeOnSite ((modulePullback B S hS f).obj M)) :
    SheafOfModules.IsFiniteLocallyFreeOnSite M := by
  have hcov := coversTop_subtype_of_forall_ofObjects_postcomp_mem B S hS f hf hsurj
    (fun Z => SheafOfModules.IsFiniteFree
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over Z)
      (M.over Z)) fun V => by
      obtain ⟨I, W, g, hg, hfree⟩ := h V
      refine ofObjects_subtype_mem_of_ofArrows_mem _ hg fun i => ?_
      have hi := hfree i
      rw [SheafOfModules.isFiniteFree_iff_exists_isColimit] at hi
      obtain ⟨n, hn⟩ := hi
      refine isFiniteFree_over_postcomp_of B S hS f hf M (W i) ?_
      rw [SheafOfModules.isFiniteFree_iff_exists_isColimit]
      exact ⟨n, exists_isColimitCofan_of_iso
        ((SheafOfModules.overFunctor _ (W i)).mapIso
          ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M)) hn⟩
  exact fun W => exists_cover_of_coversTop_subtype _
    (fun a hW => Stacks.SheafOfModules.isFiniteFree_overMap _ a hW) hcov W

/-- **Local generation by sections descends along a surjective étale morphism** (Stacks 05VR,
with Stacks 03DN): if the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on
points is locally generated by sections, so is `M`. -/
@[stacks 05VR "consequence (3), property 'locally generated by sections': for a surjective étale \
morphism f : Y → X of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is locally generated by \
sections then 𝓕 is locally generated by sections"]
theorem isLocallyGeneratedBySectionsOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : SheafOfModules.IsLocallyGeneratedBySectionsOnSite ((modulePullback B S hS f).obj M)) :
    SheafOfModules.IsLocallyGeneratedBySectionsOnSite M := by
  have hcov := coversTop_subtype_of_forall_ofObjects_postcomp_mem B S hS f hf hsurj
    (fun Z => Nonempty (M.over Z).GeneratingSections) fun V => by
      obtain ⟨I, W, hW, hgen⟩ := h V
      have hV := hW (Over.mk (𝟙 V))
      rw [GrothendieckTopology.mem_over_iff] at hV
      refine (smallEtaleRingedSite B S hS Y.1 Y.2).J.superset_covering ?_ hV
      intro T p hp
      rw [Sieve.overEquiv_iff] at hp
      obtain ⟨i, ⟨b⟩⟩ := (Sieve.mem_ofObjects_iff _ _).mp hp
      obtain ⟨σ⟩ := hgen i
      obtain ⟨τ, -⟩ := exists_generatingSections_over_postcomp_of B S hS f hf M (W i).left
        (SheafOfModules.GeneratingSections.equivOfIso
          ((SheafOfModules.overFunctor _ (W i).left).mapIso
            ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M)) σ)
      exact ⟨⟨(W i).left, ⟨τ⟩⟩, ⟨b.left⟩⟩
  exact Stacks.SheafOfModules.isLocallyGeneratedBySectionsOnSite_of_coversTop M _ hcov
    fun z => z.2

/-- **Local generation by `r` sections descends along a surjective étale morphism** (Stacks 05VR,
with Stacks 03DN): if the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on
points is locally generated by `r` sections, so is `M`. -/
@[stacks 05VR "consequence (3), property 'locally generated by r sections': for a surjective étale \
morphism f : Y → X of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is locally generated by r \
sections then 𝓕 is locally generated by r sections"]
theorem isLocallyGeneratedByOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2) (r : ℕ)
    (h : SheafOfModules.IsLocallyGeneratedByOnSite ((modulePullback B S hS f).obj M) r) :
    SheafOfModules.IsLocallyGeneratedByOnSite M r := by
  have h' := Stacks.SheafOfModules.Intrinsic.isLocallyGeneratedByOnSite_of_iso
    ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M) r h
  have hcov := coversTop_subtype_of_forall_ofObjects_postcomp_mem B S hS f hf hsurj
    (fun Z => ∃ σ : (M.over Z).GeneratingSections, Nonempty (σ.I ≃ Fin r)) fun V => by
      obtain ⟨T, hT⟩ := h' V
      refine (smallEtaleRingedSite B S hS Y.1 Y.2).J.superset_covering ?_ T.2
      intro Z p hp
      obtain ⟨σ, ⟨d⟩⟩ := hT Z p hp
      obtain ⟨τ, ⟨d'⟩⟩ := exists_generatingSections_over_postcomp_of B S hS f hf M Z σ
      exact ⟨⟨Z, τ, ⟨d'.trans d⟩⟩, ⟨𝟙 Z⟩⟩
  exact Stacks.SheafOfModules.isLocallyGeneratedByOnSite_of_coversTop M r _ hcov fun z => z.2

/-- **Finite type descends along a surjective étale morphism** (Stacks 05VR, with Stacks 03DN):
if the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on points is of
finite type, so is `M`. -/
@[stacks 05VR "consequence (3), property 'of finite type': for a surjective étale morphism f : Y → \
X of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is of finite type then 𝓕 is of finite type"]
theorem isFiniteTypeOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : ((modulePullback B S hS f).obj M).IsFiniteTypeOnSite) :
    M.IsFiniteTypeOnSite := by
  have hcov := coversTop_subtype_of_forall_ofObjects_postcomp_mem B S hS f hf hsurj
    (fun Z => (M.over Z).HasFiniteGlobalGenerators) fun V => by
      obtain ⟨I, W, g, hg, hgen⟩ := h.locally_finitelyGenerated V
      exact ofObjects_subtype_mem_of_ofArrows_mem _ hg fun i =>
        hasFiniteGlobalGenerators_over_postcomp B S hS f hf M (W i)
          (Stacks.SheafOfModules.FiniteTypeTransport.hasFiniteGlobalGenerators_of_iso
            ((SheafOfModules.overFunctor _ (W i)).mapIso
              ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M)) (hgen i))
  exact ⟨fun W => exists_cover_of_coversTop_subtype _
    (fun a hW => Stacks.SheafOfModules.FiniteTypeTransport.hasFiniteGlobalGenerators_overMap
      M a hW) hcov W⟩

/-- **Quasi-coherence descends along a surjective étale morphism** (Stacks 05VR, with
Stacks 03DN): if the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on
points is quasi-coherent, so is `M`. -/
@[stacks 05VR "consequence (3), property 'quasi-coherent': for a surjective étale morphism f : Y → \
X of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is quasi-coherent then 𝓕 is quasi-coherent"]
theorem isQuasicoherentOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : ((modulePullback B S hS f).obj M).IsQuasicoherentOnSite) :
    M.IsQuasicoherentOnSite :=
  (isQuasicoherentOnSite_etaleModulePullback_iff B S hS f hf hsurj M).2
    (SheafOfModules.IsQuasicoherentOnSite.of_iso
      ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M) h)

/-- **Coherence descends along a surjective étale morphism** (Stacks 05VR, with Stacks 03DN): if
the inverse image `f^*M` along an étale morphism `f : Y ⟶ X` surjective on points is coherent,
so is `M`.  Coherence of `f^*M` restricts to the slice at an étale chart `V₀` of `Y` surjective
on points, crosses the slice comparison of Stacks 04M0 to the slice of `X` at the composite
chart, and descends from that surjective chart to `X`. -/
@[stacks 05VR "consequence (3), property 'coherent': for a surjective étale morphism f : Y → X of \
algebraic spaces and a module 𝓕 on X, if f^*𝓕 is coherent then 𝓕 is coherent"]
theorem isCoherentOnSite_of_modulePullback_of_isSurjective (f : Y ⟶ X)
    (hf : IsEtale B S hS f.hom) (hsurj : IsSurjective B S hS f.hom)
    (M : Modules.{u, u} B S hS X.1 X.2)
    (h : SheafOfModules.IsCoherentOnSite ((modulePullback B S hS f).obj M)) :
    SheafOfModules.IsCoherentOnSite M := by
  obtain ⟨V₀, hV₀⟩ : ∃ V₀ : (smallEtaleRingedSite B S hS Y.1 Y.2).C,
      IsSurjective B S hS V₀.1.hom := exists_surjective_smallEtale_chart B S hS Y.1 Y.2
  have h₁ : SheafOfModules.IsCoherentOnSite ((etaleModulePullback B S hS f hf).obj M) :=
    Stacks.SheafOfModules.isCoherentOnSite_of_iso
      ((modulePullbackIsoEtaleModulePullback B S hS f hf).app M) h
  have h₂ := Stacks.SheafOfModules.isCoherentOnSite_over _ h₁ V₀
  let E := smallEtaleRingedSitePostcompOverEquivalence B S hS f hf V₀
  have _ : E.functor.IsCocontinuous ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V₀)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V₀)) :=
    SmallEtale.isCocontinuous_overPostcomp B S hS f hf V₀
  have _ : E.inverse.IsCocontinuous
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V₀))
      ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V₀) :=
    SmallEtale.isCocontinuous_postcompOverInverse B S hS f hf V₀
  have _ : E.functor.IsDenseSubsite ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V₀)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over
        ((ringedSitePostcomp B S hS f hf).obj V₀)) :=
    Equivalence.isDenseSubsite_functor_of_isCocontinuous _ _ E
  have h₃ : SheafOfModules.IsCoherentOnSite (M.over ((ringedSitePostcomp B S hS f hf).obj V₀)) :=
    (Stacks.Sheaves.SpecialCocontinuous.isCoherentOnSite_iff
      ((smallEtaleRingedSite B S hS Y.1 Y.2).J.over V₀)
      ((smallEtaleRingedSite B S hS X.1 X.2).J.over ((ringedSitePostcomp B S hS f hf).obj V₀))
      E.functor
      ((Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedSite B S hS X.1 X.2).O).over
        ((ringedSitePostcomp B S hS f hf).obj V₀))
      (M.over ((ringedSitePostcomp B S hS f hf).obj V₀))).2 h₂
  exact isCoherentOnSite_of_over_of_isSurjective B S hS X.1 X.2 M
    ((ringedSitePostcomp B S hS f hf).obj V₀)
    (isSurjective_smallEtalePostcomp_obj_hom B S hS f hf hsurj V₀ hV₀) h₃

end AlgebraicGeometry.Space

add_to_stacks 05VR "consequence (3), property 'of finite presentation': for a surjective étale \
morphism f : Y → X of algebraic spaces and a module 𝓕 on X, if f^*𝓕 is of finite presentation then \
𝓕 is of finite presentation"
  AlgebraicGeometry.Space.isFinitePresentationOnSite_of_modulePullback

end
