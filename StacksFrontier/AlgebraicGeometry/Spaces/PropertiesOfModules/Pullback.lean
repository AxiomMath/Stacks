/-!
# Properties of modules preserved by pullback along a morphism of algebraic spaces

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` contained in a big fppf site
`B`, and let `f^*` be the inverse image of `𝒪_Y`-modules of Stacks 03LU, that is the pullback of
modules along the morphism of small étale ringed topoi of `f`.  Modules on Sites, Lemmas 03DF,
03DO and 05VD say that the pullback along a morphism of ringed topoi preserves the global
properties of Stacks 03DE, the local properties of Stacks 03DL other than coherence, and
flatness.  This file states those of them which the library did not yet state at the small
étale ringed topoi of algebraic spaces, and registers all of them, together with those stated
elsewhere, as consequences (1) and (2) of Properties of Spaces, Section 05VR: every property of
that section except "coherent" is preserved by pullback along an arbitrary morphism of
algebraic spaces, and so in particular along an étale one.  The properties "locally free" and
"locally generated by sections" are in
`StacksFrontier.AlgebraicGeometry.Spaces.PropertiesOfModules.LocalFreenessPullback`, and coherence
under étale pullback in
`StacksFrontier.AlgebraicGeometry.Spaces.PropertiesOfModules.EtalePullbackCoherent`.

## Main results

* `AlgebraicGeometry.Space.isGeneratedByGlobalSectionsOfCard_modulePullback` and
  `AlgebraicGeometry.Space.exists_isGeneratedByGlobalSectionsOfCard_modulePullback`: generation
  by `r`, respectively by finitely many, global sections is preserved.
* `AlgebraicGeometry.Space.isPresentedByGlobalSections_modulePullback` and
  `AlgebraicGeometry.Space.isFinitelyPresentedByGlobalSections_modulePullback`: having a global
  presentation, respectively a global finite presentation, is preserved.
* `AlgebraicGeometry.Space.isLocallyGeneratedByOnSite_modulePullback`: local generation by `r`
  sections is preserved.
* `AlgebraicGeometry.Space.isFlat_modulePullback`: flatness is preserved.

## References

* [Stacks Project, Tag 05VR](https://stacks.math.columbia.edu/tag/05VR)
* [Stacks Project, Tag 03DF](https://stacks.math.columbia.edu/tag/03DF)
* [Stacks Project, Tag 03DO](https://stacks.math.columbia.edu/tag/03DO)
* [Stacks Project, Tag 05VD](https://stacks.math.columbia.edu/tag/05VD)
* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : AlgebraicSpaces B S hS}

/-- **Generation by `r` global sections is preserved by pullback.**  For a morphism `f : X ⟶ Y`
of algebraic spaces and an `𝒪_Y`-module `G` generated by `r` global sections, `f^*G` is
generated by `r` global sections (Stacks 03DF). -/
theorem isGeneratedByGlobalSectionsOfCard_modulePullback (f : X ⟶ Y)
    {G : Modules.{u, u} B S hS Y.1 Y.2} {r : ℕ} (hG : G.IsGeneratedByGlobalSectionsOfCard r) :
    ((modulePullback B S hS f).obj G).IsGeneratedByGlobalSectionsOfCard r := by
  have h := AlgebraicGeometry.RingedToposHom.pullbackModules_isGeneratedByGlobalSectionsOfCard
    (smallEtaleRingedToposHom B S hS f) hG
  rw [(smallEtaleRingedToposHom B S hS f).toModulesHom_eq_toRingedToposModulesHom] at h
  exact h

/-- **Generation by finitely many global sections is preserved by pullback.**  For a morphism
`f : X ⟶ Y` of algebraic spaces and an `𝒪_Y`-module `G` generated by finitely many global
sections, `f^*G` is generated by finitely many global sections (Stacks 03DF). -/
@[stacks 05VR "consequences (1) and (2), property 'generated by finitely many global sections': \
for a morphism f of algebraic spaces, in particular an étale one, the pullback f^*𝓕 of a module \
generated by finitely many global sections is generated by finitely many global sections"]
theorem exists_isGeneratedByGlobalSectionsOfCard_modulePullback (f : X ⟶ Y)
    {G : Modules.{u, u} B S hS Y.1 Y.2} (hG : ∃ r : ℕ, G.IsGeneratedByGlobalSectionsOfCard r) :
    ∃ r : ℕ, ((modulePullback B S hS f).obj G).IsGeneratedByGlobalSectionsOfCard r :=
  ⟨hG.choose, isGeneratedByGlobalSectionsOfCard_modulePullback B S hS f hG.choose_spec⟩

/-- **Having a global presentation is preserved by pullback.**  For a morphism `f : X ⟶ Y` of
algebraic spaces and an `𝒪_Y`-module `G` with a global presentation, `f^*G` has a global
presentation (Stacks 03DF). -/
@[stacks 05VR "consequences (1) and (2), property 'having a global presentation': for a morphism f \
of algebraic spaces, in particular an étale one, the pullback f^*𝓕 of a module with a global \
presentation is a module with a global presentation"]
theorem isPresentedByGlobalSections_modulePullback (f : X ⟶ Y)
    {G : Modules.{u, u} B S hS Y.1 Y.2} (hG : G.IsPresentedByGlobalSections) :
    ((modulePullback B S hS f).obj G).IsPresentedByGlobalSections := by
  have h := AlgebraicGeometry.RingedToposHom.pullbackModules_isPresentedByGlobalSections
    (smallEtaleRingedToposHom B S hS f) hG
  rw [(smallEtaleRingedToposHom B S hS f).toModulesHom_eq_toRingedToposModulesHom] at h
  exact h

/-- **Having a global finite presentation is preserved by pullback.**  For a morphism
`f : X ⟶ Y` of algebraic spaces and an `𝒪_Y`-module `G` with a global finite presentation, `f^*G`
has a global finite presentation (Stacks 03DF). -/
@[stacks 05VR "consequences (1) and (2), property 'having a global finite presentation': for a \
morphism f of algebraic spaces, in particular an étale one, the pullback f^*𝓕 of a module with a \
global finite presentation is a module with a global finite presentation"]
theorem isFinitelyPresentedByGlobalSections_modulePullback (f : X ⟶ Y)
    {G : Modules.{u, u} B S hS Y.1 Y.2} (hG : G.IsFinitelyPresentedByGlobalSections) :
    ((modulePullback B S hS f).obj G).IsFinitelyPresentedByGlobalSections := by
  have h := AlgebraicGeometry.RingedToposHom.pullbackModules_isFinitelyPresentedByGlobalSections
    (smallEtaleRingedToposHom B S hS f) hG
  rw [(smallEtaleRingedToposHom B S hS f).toModulesHom_eq_toRingedToposModulesHom] at h
  exact h

/-- **Local generation by `r` sections is preserved by pullback.**  For a morphism `f : X ⟶ Y` of
algebraic spaces and an `𝒪_Y`-module `G` locally generated by `r` sections, `f^*G` is locally
generated by `r` sections (Stacks 03DO). -/
@[stacks 05VR "consequences (1) and (2), property 'locally generated by r sections': for a \
morphism f of algebraic spaces, in particular an étale one, the pullback f^*𝓕 of a module locally \
generated by r sections is locally generated by r sections"]
theorem isLocallyGeneratedByOnSite_modulePullback (f : X ⟶ Y)
    (G : Modules.{u, u} B S hS Y.1 Y.2) (r : ℕ) (hG : G.IsLocallyGeneratedByOnSite r) :
    ((modulePullback B S hS f).obj G).IsLocallyGeneratedByOnSite r :=
  Stacks.Sheaves.LocalGeneration.pullbackModules_isLocallyGeneratedByOnSite
    (smallEtaleRingedToposModulesHom B S hS f) G r hG

/-- **Flatness is preserved by pullback.**  For a morphism `f : X ⟶ Y` of algebraic spaces and a
flat `𝒪_Y`-module `G`, the inverse image `f^*G` is a flat `𝒪_X`-module (Stacks 05VD). -/
@[stacks 05VR "consequences (1) and (2), property 'flat': for a morphism f of algebraic spaces, in \
particular an étale one, the pullback f^*𝓕 of a flat module is flat"]
theorem isFlat_modulePullback (f : X ⟶ Y) (G : Modules.{u, u} B S hS Y.1 Y.2)
    (hG : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u + 1, u, u}
      (O := (smallEtaleRingedTopos B S hS Y).O) G) :
    AlgebraicGeometry.SheafOfModules.IsFlat.{u, u + 1, u, u}
      (O := (smallEtaleRingedTopos B S hS X).O) ((modulePullback B S hS f).obj G) := by
  have h := Stacks.Sheaves.DerivedPullback.KFlatPullbackOfToposHom.isFlat_pullbackModules_obj
    (smallEtaleRingedToposHom B S hS f) G hG
  rw [(smallEtaleRingedToposHom B S hS f).toModulesHom_eq_toRingedToposModulesHom] at h
  exact h

end AlgebraicGeometry.Space

