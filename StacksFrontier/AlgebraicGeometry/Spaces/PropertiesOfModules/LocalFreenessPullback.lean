/-!
# Local freeness and local generation under the inverse image of algebraic spaces

Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S` and let `N` be an
`𝒪_Y`-module on the small étale site of `Y`.  If `N` is locally free, Stacks 03DL (1), or locally
generated by sections, Stacks 03DL (3), then so is the inverse image `f^*N` of Stacks 03LU.  These
are two clauses of consequence (1) of Stacks 05VR, which reads Stacks 03DO along the morphism of
small étale ringed topoi of `f`.  No quasi-coherence of `N` is assumed.

## Main results

* `AlgebraicGeometry.Space.isLocallyFreeOnSite_modulePullback`: the inverse image of a locally
  free module is locally free.
* `AlgebraicGeometry.Space.isLocallyGeneratedBySectionsOnSite_modulePullback`: the inverse image
  of a module locally generated by sections is locally generated by sections.

## Implementation notes

The general ringed-topos statements of Stacks 03DO in the tree are stated for ringed topoi whose
three universes agree, which the small étale ringed topos of an algebraic space is not, so the
proof runs on charts instead.  The module `N` is free (respectively generated by global sections)
on the slices at a family of étale charts covering `Y`; by
`AlgebraicGeometry.Space.mem_topology_of_hasAffineChartDiagramWith` the étale charts `W` of `X`
carrying a morphism `q` to such a chart `V` over `f` cover `X`.  On the slice at `W` the inverse
image is, through the comparison of Stacks 04M0 and the commutative square of chart morphisms,
the inverse image along `q` of the restriction of `N` to `V`, and the global properties are
preserved by every inverse image (`AlgebraicGeometry.Space.isFreeModule_modulePullback` and
`AlgebraicGeometry.C1764Prereq.isGeneratedByGlobalSections_modulePullback`).  The covering family
is then glued by Stacks 03DN.  Unlike the finite locally free case, no comparison with Zariski
modules on the chart schemes (Stacks 05VG) is involved, so no quasi-coherence is needed.

## References

* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03DN](https://stacks.math.columbia.edu/tag/03DN)
* [Stacks Project, Tag 03DO](https://stacks.math.columbia.edu/tag/03DO)
* [Stacks Project, Tag 03LU](https://stacks.math.columbia.edu/tag/03LU)
* [Stacks Project, Tag 04M0](https://stacks.math.columbia.edu/tag/04M0)
* [Stacks Project, Tag 05VR](https://stacks.math.columbia.edu/tag/05VR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **A property holding on a covering family of charts holds on a chart through every point.**
If a property `P` of étale charts of `Z` passes to charts over one and holds on each member of a
family covering the final object of the small étale site of `Z`, then every point of `|Z|` lies in
the image of an étale chart satisfying `P`. -/
theorem exists_chart_mem_range_of_coversTop (Z : AlgebraicSpaces B S hS)
    (P : SmallEtale B S hS Z.1 → Prop)
    (hPhom : ∀ {V V' : SmallEtale B S hS Z.1}, (V' ⟶ V) → P V → P V')
    {I : Type*} (Y : I → SmallEtale B S hS Z.1)
    (hY : (SmallEtale.topology B S hS Z.1).CoversTop Y) (hP : ∀ i, P (Y i))
    (x : points B S hS Z.1) :
    ∃ V : SmallEtale B S hS Z.1, P V ∧
      x ∈ Set.range (pointsMap B S hS
        (yoneda.obj ((SmallEtale.toOver B S hS Z.1).obj V)) V.1.hom) := by
  obtain ⟨U, p, hp⟩ := exists_chart_point B S hS Z.1 Z.2 x
  obtain ⟨W, g, hg, q, hq⟩ := SmallEtale.exists_mem_arrows_pointsMap_eq B S hS Z.1 (hY U) p
  obtain ⟨i, ⟨k⟩⟩ := hg
  refine ⟨W, hPhom k (hP i), q, ?_⟩
  have hW : yoneda.map ((SmallEtale.toOver B S hS Z.1).map g) ≫ U.obj.hom = W.obj.hom :=
    CostructuredArrow.w g.hom
  have h₁ := congrFun (pointsMap_comp B S hS
    (yoneda.obj ((SmallEtale.toOver B S hS Z.1).obj W))
    (yoneda.map ((SmallEtale.toOver B S hS Z.1).map g)) U.obj.hom) q
  simp only [Function.comp_apply] at h₁
  rw [hW] at h₁
  rw [h₁, hq]
  exact hp

/-- **Freeness on the slice at a chart is freeness on the chart space.**  The restriction of an
`𝒪_Z`-module to the slice of the small étale site at an étale chart `V` is free exactly when its
inverse image along the structure morphism of the chart space of `V` is; this is the comparison of
Stacks 04M0, along which restriction changes no sections. -/
theorem isFreeModule_modulePullback_chartToSpace_iff (Z : AlgebraicSpaces B S hS)
    (N : Modules.{u, u} B S hS Z.1 Z.2) (V : SmallEtale B S hS Z.1) :
    IsFreeModule B S hS (chartSpace B S hS Z V)
        ((modulePullback B S hS (chartToSpace B S hS Z V)).obj N) ↔
      SheafOfModules.IsFree (R := (structureRingSheaf B S hS Z).over V) (N.over V) := by
  have h₂ : (SmallEtale.chartLocalizationEquivalence B S hS Z.1 V).inverse.IsContinuous
      ((SmallEtale.topology B S hS Z.1).over V)
      (SmallEtale.topology B S hS (chartSpace B S hS Z V).1) :=
    @Functor.IsDenseSubsite.instIsContinuous _ _ _ _ _ _ _
      (isDenseSubsite_chartLocalizationEquivalence_inverse B S hS Z V)
  have e : (chartSmallEtaleRestrictionFunctor Z V).obj (N.over V) ≅
      (modulePullback B S hS (chartToSpace B S hS Z V)).obj N :=
    chartSmallEtaleRestrictionFunctorObjIso Z N V ≪≫
      ((modulePullbackIsoEtaleModulePullback B S hS (chartToSpace B S hS Z V)
        (isEtale_chartToSpace B S hS Z V)).app N).symm
  constructor
  · rintro ⟨I, h⟩
    exact ⟨I, @Stacks.SheafOfModules.exists_isColimitCofan_of_reindex _ _ _ _
      ((SmallEtale.topology B S hS Z.1).over V)
      (SmallEtale.topology B S hS (chartSpace B S hS Z V).1)
      (SmallEtale.chartLocalizationEquivalence B S hS Z.1 V)
      (isContinuous_chartLocalization_chartSpace B S hS Z V) h₂
      ((structureRingSheaf B S hS Z).over V) (N.over V) _
      (Stacks.SheafOfModules.exists_isColimitCofan_of_iso e.symm h)⟩
  · rintro ⟨I, h⟩
    exact ⟨I, Stacks.SheafOfModules.exists_isColimitCofan_of_iso e
      (@Stacks.SheafOfModules.exists_isColimitCofan_reindex _ _ _ _
        ((SmallEtale.topology B S hS Z.1).over V)
        (SmallEtale.topology B S hS (chartSpace B S hS Z V).1)
        (SmallEtale.chartLocalizationEquivalence B S hS Z.1 V)
        (isContinuous_chartLocalization_chartSpace B S hS Z V) h₂
        ((structureRingSheaf B S hS Z).over V) (N.over V) _ h)⟩

/-- **The inverse image of a locally free module is locally free.**  For a morphism `f : X ⟶ Y`
of algebraic spaces over `S` and a locally free `𝒪_Y`-module `N` (Stacks 03DL (1)), the inverse
image `f^*N` of Stacks 03LU is locally free.  This is the locally free clause of Stacks 03DO along
the morphism of small étale ringed topoi of `f`, consequence (1) of Stacks 05VR. -/
@[stacks 05VR "consequences (1) and (2), property 'locally free': for a morphism f of algebraic \
spaces, in particular an étale one, the pullback f^*𝓕 of a locally free module is locally free"]
theorem isLocallyFreeOnSite_modulePullback {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (N : Modules.{u, u} B S hS Y.1 Y.2) (hN : N.IsLocallyFreeOnSite) :
    ((modulePullback B S hS f).obj N).IsLocallyFreeOnSite := by
  obtain ⟨I, V, hV, hfree⟩ := (Stacks.SheafOfModules.isLocallyFreeOnSite_iff_exists_cover_isFree
    (smallEtaleRingedSite B S hS Y.1 Y.2) N).1 hN
  let P : SmallEtale B S hS Y.1 → Prop := fun V =>
    SheafOfModules.IsFree (R := (structureRingSheaf B S hS Y).over V) (N.over V)
  have hPhom : ∀ {V V' : SmallEtale B S hS Y.1}, (V' ⟶ V) → P V → P V' := fun φ hV =>
    Stacks.SheafOfModules.isFree_over_of_le N φ hV
  have hPcov := exists_chart_mem_range_of_coversTop B S hS Y P hPhom V hV hfree
  refine (Stacks.SheafOfModules.isLocallyFreeOnSite_iff_exists_cover_isFree
    (smallEtaleRingedSite B S hS X.1 X.2) ((modulePullback B S hS f).obj N)).2
    ⟨{W : SmallEtale B S hS X.1 // HasAffineChartDiagramWith B S hS f P W}, Subtype.val,
      fun U => mem_topology_of_hasAffineChartDiagramWith B S hS P f hPhom hPcov U _
        fun {W} _ hW => ⟨⟨W, hW⟩, ⟨𝟙 W⟩⟩, fun i => ?_⟩
  obtain ⟨-, W, q, hq, -, hPW⟩ := i.2
  have hW := (isFreeModule_modulePullback_chartToSpace_iff B S hS Y N W).2 hPW
  have hq' := isFreeModule_modulePullback B S hS (chartSpaceMapOver B S hS q) _ hW
  refine (isFreeModule_modulePullback_chartToSpace_iff B S hS X _ i.1).1 ?_
  exact SheafOfModules.IsFree.of_iso
    ((modulePullbackCommSquareIso B S hS
      (chartSpaceMapOver_comp_chartToSpace B S hS f q hq)).app N) hq'

/-- **Generation by global sections on the slice at a chart is generation on the chart space.**
The restriction of an `𝒪_Z`-module to the slice of the small étale site at an étale chart `V` is
generated by global sections exactly when its inverse image along the structure morphism of the
chart space of `V` is; this is the comparison of Stacks 04M0. -/
theorem nonempty_generatingSections_modulePullback_chartToSpace_iff (Z : AlgebraicSpaces B S hS)
    (N : Modules.{u, u} B S hS Z.1 Z.2) (V : SmallEtale B S hS Z.1) :
    Nonempty ((modulePullback B S hS (chartToSpace B S hS Z V)).obj N).GeneratingSections ↔
      Nonempty (SheafOfModules.GeneratingSections
        (R := (structureRingSheaf B S hS Z).over V) (N.over V)) := by
  have h₂ : (SmallEtale.chartLocalizationEquivalence B S hS Z.1 V).inverse.IsContinuous
      ((SmallEtale.topology B S hS Z.1).over V)
      (SmallEtale.topology B S hS (chartSpace B S hS Z V).1) :=
    @Functor.IsDenseSubsite.instIsContinuous _ _ _ _ _ _ _
      (isDenseSubsite_chartLocalizationEquivalence_inverse B S hS Z V)
  have e : (chartSmallEtaleRestrictionFunctor Z V).obj (N.over V) ≅
      (modulePullback B S hS (chartToSpace B S hS Z V)).obj N :=
    chartSmallEtaleRestrictionFunctorObjIso Z N V ≪≫
      ((modulePullbackIsoEtaleModulePullback B S hS (chartToSpace B S hS Z V)
        (isEtale_chartToSpace B S hS Z V)).app N).symm
  constructor
  · rintro ⟨σ⟩
    exact ⟨@Stacks.SheafOfModules.generatingSectionsOfReindex _ _ _ _
      ((SmallEtale.topology B S hS Z.1).over V)
      (SmallEtale.topology B S hS (chartSpace B S hS Z V).1)
      (SmallEtale.chartLocalizationEquivalence B S hS Z.1 V)
      (isContinuous_chartLocalization_chartSpace B S hS Z V) h₂
      ((structureRingSheaf B S hS Z).over V) _ _ _ _ (N.over V)
      (SheafOfModules.GeneratingSections.equivOfIso e.symm σ)⟩
  · rintro ⟨σ⟩
    let E := @Stacks.SheafOfModules.reindexEquivalence _ _ _ _
      ((SmallEtale.topology B S hS Z.1).over V)
      (SmallEtale.topology B S hS (chartSpace B S hS Z V).1)
      (SmallEtale.chartLocalizationEquivalence B S hS Z.1 V)
      (isContinuous_chartLocalization_chartSpace B S hS Z V) h₂
      ((structureRingSheaf B S hS Z).over V)
    have : PreservesColimitsOfSize.{u, u} (chartSmallEtaleRestrictionFunctor Z V) :=
      E.toAdjunction.leftAdjoint_preservesColimits
    have : (chartSmallEtaleRestrictionFunctor Z V).PreservesEpimorphisms :=
      Functor.preservesEpimorphisms_of_adjunction E.toAdjunction
    exact ⟨SheafOfModules.GeneratingSections.equivOfIso e
      (Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap
        (chartSmallEtaleRestrictionFunctor Z V) (chartSmallEtaleRestrictionFunctorUnitIso Z V) σ)⟩

/-- **The inverse image of a module locally generated by sections is locally generated by
sections.**  For a morphism `f : X ⟶ Y` of algebraic spaces over `S` and an `𝒪_Y`-module `N`
locally generated by sections (Stacks 03DL (3)), the inverse image `f^*N` of Stacks 03LU is
locally generated by sections.  This is that clause of Stacks 03DO along the morphism of small
étale ringed topoi of `f`, consequence (1) of Stacks 05VR. -/
@[stacks 05VR "consequences (1) and (2), property 'locally generated by sections': for a morphism \
f of algebraic spaces, in particular an étale one, the pullback f^*𝓕 of a module locally generated \
by sections is locally generated by sections"]
theorem isLocallyGeneratedBySectionsOnSite_modulePullback {X Y : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (N : Modules.{u, u} B S hS Y.1 Y.2) (hN : N.IsLocallyGeneratedBySectionsOnSite) :
    ((modulePullback B S hS f).obj N).IsLocallyGeneratedBySectionsOnSite := by
  obtain ⟨I, V, hV, hgen⟩ :=
    (Stacks.SheafOfModules.isLocallyGeneratedBySectionsOnSite_iff_exists_cover_generatingSections
      (smallEtaleRingedSite B S hS Y.1 Y.2) N).1 hN
  let P : SmallEtale B S hS Y.1 → Prop := fun V =>
    Nonempty (SheafOfModules.GeneratingSections (R := (structureRingSheaf B S hS Y).over V)
      (N.over V))
  have hPhom : ∀ {V V' : SmallEtale B S hS Y.1}, (V' ⟶ V) → P V → P V' := fun φ ⟨σ⟩ =>
    ⟨Stacks.SheafOfModules.generatingSectionsOverMap N φ σ⟩
  have hPcov := exists_chart_mem_range_of_coversTop B S hS Y P hPhom V hV hgen
  refine
    (Stacks.SheafOfModules.isLocallyGeneratedBySectionsOnSite_iff_exists_cover_generatingSections
      (smallEtaleRingedSite B S hS X.1 X.2) ((modulePullback B S hS f).obj N)).2
      ⟨{W : SmallEtale B S hS X.1 // HasAffineChartDiagramWith B S hS f P W}, Subtype.val,
        fun U => mem_topology_of_hasAffineChartDiagramWith B S hS P f hPhom hPcov U _
          fun {W} _ hW => ⟨⟨W, hW⟩, ⟨𝟙 W⟩⟩, fun i => ?_⟩
  obtain ⟨-, W, q, hq, -, hPW⟩ := i.2
  have hσ : ((modulePullback B S hS (chartToSpace B S hS Y W)).obj N).IsGeneratedByGlobalSections :=
    (nonempty_generatingSections_modulePullback_chartToSpace_iff B S hS Y N W).2 hPW
  have hσ' := C1764Prereq.isGeneratedByGlobalSections_modulePullback
    (chartSpaceMapOver B S hS q) hσ
  refine (nonempty_generatingSections_modulePullback_chartToSpace_iff B S hS X _ i.1).1 ?_
  obtain ⟨τ⟩ := hσ'
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso
    ((modulePullbackCommSquareIso B S hS
      (chartSpaceMapOver_comp_chartToSpace B S hS f q hq)).app N) τ⟩

end AlgebraicGeometry.Space

end
