/-! ### The classifying morphisms of Tag 01NZ against pullback and transport -/

namespace Stacks.AlgebraicGeometry.RelativeProjInvertibleMorphism

section Classifying

variable {S : Scheme.{u}}

/-- **The classifying morphism of a pulled-back point is the pulled-back classifying morphism.**
The representation of Tag 01NZ is natural in the test scheme. -/
theorem F.classifyingMorphism_pullback (A : SheafGradedAlgebra.{u} S) {W W' : Scheme.{u}}
    (g : W' ⟶ W) (x : F (situationAlgebra A) W) :
    F.classifyingMorphism A (F.pullback g x) = g ≫ F.classifyingMorphism A x := by
  apply (relativeProjRepresentableByFunctorUnconditional A).homEquiv.injective
  rw [Functor.RepresentableBy.homEquiv_comp, homEquiv_classifyingMorphism,
    homEquiv_classifyingMorphism]
  refine Scheme.QcExtension.ext (funext fun W₀ => funext fun hW₀ => funext fun w => ?_)
  exact (F.pullback_comp g w x).symm

/-- **The classifying morphism of a transported point is the classifying morphism followed by
the induced isomorphism of relative homogeneous spectra.** For a unital isomorphism
`Φ : 𝒜₁ ⟶ 𝒜₂` of graded algebras, transporting a point of `F` of `𝒜₁` to one of `𝒜₂` (along the
inverse of `Φ`) corresponds to composing with `Proj(𝒜₁) ≅ Proj(𝒜₂)`. -/
theorem F.classifyingMorphism_comp_relativeProjCongr {A₁ A₂ : SheafGradedAlgebra.{u} S}
    (Φ : SheafOfModules.GradedAlgebra.UnitalHom (situationAlgebra A₁) (situationAlgebra A₂))
    (hΦ : ∀ n : ℤ, IsIso (Φ.app n)) {W : Scheme.{u}} (x : F (situationAlgebra A₁) W) :
    F.classifyingMorphism A₁ x ≫ (relativeProjCongr Φ hΦ).hom =
      F.classifyingMorphism A₂
        (F.algebraTransport (unitalHomInverse Φ hΦ) (isIso_unitalHomInverse_app Φ hΦ) x) := by
  apply (relativeProjRepresentableByFunctorUnconditional A₂).homEquiv.injective
  rw [homEquiv_classifyingMorphism]
  refine Scheme.QcExtension.ext (funext fun W₀ => funext fun hW₀ => funext fun w => ?_)
  rw [homEquiv_comp_relativeProjCongr_val, homEquiv_classifyingMorphism]
  exact F.algebraTransport_pullback _ _ w x

end Classifying

end Stacks.AlgebraicGeometry.RelativeProjInvertibleMorphism

namespace Stacks.AlgebraicGeometry.ProjRepresentsF1

open Stacks.AlgebraicGeometry.RelativeProjInvertibleMorphism

/-- **The degree-one classifying morphism into the relative homogeneous spectrum is the
classifying morphism of the representation of Tag 01NZ** at the class of the quadruple. -/
theorem classifyingHom_relativeProj_mk {S W : Scheme.{u}} (A : SheafGradedAlgebra.{u} S)
    {g : W ⟶ S} (Q : Quadruple g (situationAlgebra A) 1) :
    classifyingHom A (relativeProj A) (Fd.mk g Q) = F.classifyingMorphism A (F.mk g one_pos Q) := by
  have e := F.classifyingMorphism_mk A (g := g) (k := 1) Nat.one_pos Q
  rw [canonicalIso_relativeProj, Iso.refl_inv, Category.comp_id] at e
  exact e.symm

/-- **The degree-one classifying morphism is injective**, for every graded algebra: it is the
injective morphism into the degree-one open of Tag 01NU followed by the inclusion of that open. -/
theorem classifyingHom_injective {S W : Scheme.{u}} (A : SheafGradedAlgebra.{u} S)
    (P : RelativeProjData A) : Function.Injective (classifyingHom A P (W := W)) :=
  fun _ _ h => Fd.homDegreeOpen_injective A P Nat.one_pos W ((cancel_mono (P.degreeOpen 1).ι).mp h)

end Stacks.AlgebraicGeometry.ProjRepresentsF1

namespace AlgebraicGeometry.Space

/-! ### The restriction datum and the degree-one classifying morphisms -/

namespace GradedAlgebraRestriction

open Stacks.AlgebraicGeometry.RelativeProjInvertibleMorphism
open Stacks.AlgebraicGeometry.ProjRepresentsF1 (classifyingHom classifyingHom_relativeProj_mk)

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

section Restrict

variable {r : GradedAlgebraPoints B S hS X} (ρ : GradedAlgebraRestriction r)

/-- **The restriction of a strict-equivalence class of quadruples of degree one** along a
morphism `τ : T' ⟶ T` of test objects: the class of the restriction
`AlgebraicGeometry.Space.GradedAlgebraRestriction.quadrupleRestrict` of a representative, which
is well defined by `strictlyEquivalent_quadrupleRestrict`. -/
def quadrupleClassRestrict {T T' : BigFppfOver B S hS} (τ : T' ⟶ T) (f : yoneda.obj T ⟶ X)
    (f' : yoneda.obj T' ⟶ X) (hf : yoneda.map τ ≫ f = f') :
    Quotient (Quadruple.setoid (𝟙 ((BigFppfOver.toScheme B S hS).obj T)) (r.algebra T f) 1) →
      Quotient (Quadruple.setoid (𝟙 ((BigFppfOver.toScheme B S hS).obj T')) (r.algebra T' f') 1) :=
  Quotient.map (ρ.quadrupleRestrict τ f f' hf)
    (fun _ _ h => ρ.strictlyEquivalent_quadrupleRestrict τ f f' hf h)

/-- The restriction along `τ` of the class of a quadruple `P` is the class of the restricted
quadruple `quadrupleRestrict τ f f' hf P`. -/
@[simp] theorem quadrupleClassRestrict_mk {T T' : BigFppfOver B S hS} (τ : T' ⟶ T)
    (f : yoneda.obj T ⟶ X) (f' : yoneda.obj T' ⟶ X) (hf : yoneda.map τ ≫ f = f')
    (P : r.Quadruples T f 1) :
    ρ.quadrupleClassRestrict τ f f' hf (Quotient.mk _ P) =
      Quotient.mk _ (ρ.quadrupleRestrict τ f f' hf P) :=
  rfl

end Restrict

variable {Â : ∀ T : BigFppfOver B S hS, (yoneda.obj T ⟶ X) →
      SheafGradedAlgebra ((BigFppfOver.toScheme B S hS).obj T)}
    (ρ : GradedAlgebraRestriction (GradedAlgebraPoints.ofQuasicoherentFamily Â))

/-- **Restriction of a point of `F` and the classifying morphisms of Tag 01NZ.** For
`τ : T' ⟶ T` and a class `q` over the identity of `T` for `f^*𝒜`, the classifying morphism of the
restriction of `q`, followed by the identification `Proj_{T'}((f ∘ τ)^*𝒜) ≅ Proj_{T'}(τ^*(f^*𝒜))`
and the base-change morphism of Tag 01O3, is `τ` followed by the classifying morphism of `q`. -/
theorem classifyingMorphism_fibreRestrict {T T' : BigFppfOver B S hS} (τ : T' ⟶ T)
    (f : yoneda.obj T ⟶ X)
    (q : Quot (UnionRel (f := 𝟙 ((BigFppfOver.toScheme B S hS).obj T))
      (A := situationAlgebra (Â T f)))) :
    F.classifyingMorphism (Â T' (yoneda.map τ ≫ f)) ⟨𝟙 _, ρ.fibreRestrict τ f _ rfl q⟩ ≫
        (ρ.restrictProjIso f τ).hom ≫
          Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.baseChangeHom (Â T f)
            ((BigFppfOver.toScheme B S hS).map τ) =
      (BigFppfOver.toScheme B S hS).map τ ≫ F.classifyingMorphism (Â T f) ⟨𝟙 _, q⟩ := by
  let tr := fun z : F (situationAlgebra (Â T' (yoneda.map τ ≫ f)))
      ((BigFppfOver.toScheme B S hS).obj T') =>
    F.algebraTransport (unitalHomInverse (ρ.restrict τ f _ rfl) (ρ.isIso_restrict_app τ f _ rfl))
      (isIso_unitalHomInverse_app _ _) z
  have h3 : F.baseChangeUp ((BigFppfOver.toScheme B S hS).map τ) (situationAlgebra (Â T f))
      (tr ⟨𝟙 _, ρ.fibreRestrict τ f _ rfl q⟩) =
      F.pullback ((BigFppfOver.toScheme B S hS).map τ) ⟨𝟙 _, q⟩ :=
    (congrArg (fun z => F.baseChangeUp ((BigFppfOver.toScheme B S hS).map τ)
      (situationAlgebra (Â T f)) (tr z)) (ρ.sigma_fibreRestrict τ f _ rfl q)).trans
    ((congrArg (F.baseChangeUp ((BigFppfOver.toScheme B S hS).map τ) (situationAlgebra (Â T f)))
      ((F.algebraTransportEquiv _ _ _).symm_apply_apply _)).trans
      (F.baseChangeUp_baseChangeDownQ _ _ _ _))
  have h1 := F.classifyingMorphism_comp_relativeProjCongr (A₁ := Â T' (yoneda.map τ ≫ f))
    (A₂ := (Â T f).pullback ((BigFppfOver.toScheme B S hS).map τ))
    (ρ.restrict τ f _ rfl) (ρ.isIso_restrict_app τ f _ rfl) ⟨𝟙 _, ρ.fibreRestrict τ f _ rfl q⟩
  have h2 := classifyingMorphism_baseChangeUp (Â T f) ((BigFppfOver.toScheme B S hS).map τ)
    (tr ⟨𝟙 _, ρ.fibreRestrict τ f _ rfl q⟩)
  refine (Category.assoc _ _ _).symm.trans ?_
  refine (congrArg (· ≫ _) h1).trans ?_
  refine h2.symm.trans ?_
  refine (congrArg (F.classifyingMorphism (Â T f)) h3).trans ?_
  exact F.classifyingMorphism_pullback _ _ _

/-- **Restriction of a class of quadruples of degree one and the degree-one classifying
morphisms.** The classifying morphism of the restriction along `τ : T' ⟶ T`, followed by the
identification of the restricted algebras and the base-change morphism of Tag 01O3, is `τ`
followed by the classifying morphism of the class. -/
theorem classifyingHom_quadrupleClassRestrict {T T' : BigFppfOver B S hS} (τ : T' ⟶ T)
    (f : yoneda.obj T ⟶ X)
    (ξ : Quotient (Quadruple.setoid (𝟙 ((BigFppfOver.toScheme B S hS).obj T))
      (situationAlgebra (Â T f)) 1)) :
    classifyingHom (Â T' (yoneda.map τ ≫ f)) (relativeProj _)
        ⟨𝟙 _, ρ.quadrupleClassRestrict τ f _ rfl ξ⟩ ≫
        (ρ.restrictProjIso f τ).hom ≫
          Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.baseChangeHom (Â T f)
            ((BigFppfOver.toScheme B S hS).map τ) =
      (BigFppfOver.toScheme B S hS).map τ ≫ classifyingHom (Â T f) (relativeProj _) ⟨𝟙 _, ξ⟩ := by
  induction ξ using Quotient.ind with
  | _ P =>
    have e1 := classifyingHom_relativeProj_mk (Â T' (yoneda.map τ ≫ f))
      (ρ.quadrupleRestrict τ f _ rfl P)
    have e2 := classifyingHom_relativeProj_mk (Â T f) P
    refine (congrArg (· ≫ _) e1).trans (Eq.trans ?_ (congrArg (_ ≫ ·) e2.symm))
    exact ρ.classifyingMorphism_fibreRestrict τ f (Quot.mk _ ⟨⟨1, one_pos⟩, P⟩)

end GradedAlgebraRestriction

/-! ### The functor `F₁` and its morphism to the relative Proj -/

namespace RelativeProjSituation

open Stacks.AlgebraicGeometry.ProjRepresentsF1

variable (s : RelativeProjSituation.{u, m}) (TA : TensorAlgebras.{u})

/-- **The restriction of a class of triples along a morphism of test objects.** A strict
isomorphism class of pairs `(ℒ, ψ)` for `f^*𝒜` is sent to the class, for `(f ∘ τ)^*𝒜`, of its
pullback along `τ` read through `(f ∘ τ)^*𝒜 ≅ τ^*(f^*𝒜)`; the operation is computed on the
quadruple of degree one the class determines (`quadrupleClass`, a bijection). -/
def f1Restrict {T T' : BigFppfOver s.site s.base s.containsBase} (τ : T' ⟶ T)
    (f : yoneda.obj T ⟶ s.space.1) (f' : yoneda.obj T' ⟶ s.space.1)
    (hf : yoneda.map τ ≫ f = f') :
    F1 (s.shrink.pointAlgebra T f) TA (𝟙 _) → F1 (s.shrink.pointAlgebra T' f') TA (𝟙 _) :=
  fun c => (Equiv.ofBijective _ (quadrupleClass_bijective (s.shrink.pointAlgebra T' f') TA
    (𝟙 _))).symm (s.quadrupleRestriction.quadrupleClassRestrict τ f f' hf
      (quadrupleClass (s.shrink.pointAlgebra T f) TA (𝟙 _) c))

/-- The class of quadruples determined by the restriction `f1Restrict` of a class `c` is the
restriction `quadrupleClassRestrict` of the class of quadruples determined by `c`. -/
theorem quadrupleClass_f1Restrict {T T' : BigFppfOver s.site s.base s.containsBase}
    (τ : T' ⟶ T) (f : yoneda.obj T ⟶ s.space.1) (f' : yoneda.obj T' ⟶ s.space.1)
    (hf : yoneda.map τ ≫ f = f') (c : F1 (s.shrink.pointAlgebra T f) TA (𝟙 _)) :
    quadrupleClass (s.shrink.pointAlgebra T' f') TA (𝟙 _) (s.f1Restrict TA τ f f' hf c) =
      s.quadrupleRestriction.quadrupleClassRestrict τ f f' hf
        (quadrupleClass (s.shrink.pointAlgebra T f) TA (𝟙 _) c) :=
  (Equiv.ofBijective _ (quadrupleClass_bijective (s.shrink.pointAlgebra T' f') TA
    (𝟙 _))).apply_symm_apply _

/-- The value at a test object `T` of the functor `F₁` of Stacks 085D: a `T`-point `f` of `X`
together with a strict isomorphism class of pairs `(ℒ, ψ)` — `ℒ` invertible on `T`,
`ψ : f^*𝒜 ⟶ ⨁_{n ≥ 0} ℒ^{⊗ n}` a map of graded algebras surjective in degree one. -/
abbrev F1Triples (T : BigFppfOver s.site s.base s.containsBase) : Type (u + 1) :=
  Σ f : yoneda.obj T ⟶ s.space.1, F1 (s.shrink.pointAlgebra T f) TA (𝟙 _)

/-- **The point of `P` classifying a triple.** The degree-one classifying morphism
`T ⟶ Proj_T(f^*𝒜)` of the triple, a section over `T`, read as a `T`-point of `P` over `f`
through `Proj_T(f^*𝒜) = T ×_X P` (Stacks 084B). -/
def f1ToPoint {T : BigFppfOver s.site s.base s.containsBase} (x : s.F1Triples TA T) :
    yoneda.obj T ⟶ s.relativeProjFunctor :=
  ((s.relativeProjPoints.pointEquivProjOver T x.1 (𝟙 T)).symm
    ⟨classifyingHom (s.shrink.pointAlgebra T x.1) (relativeProj _)
      ⟨𝟙 _, quadrupleClass _ TA _ x.2⟩, by
        rw [CategoryTheory.Functor.map_id]
        exact classifyingHom_comp_toBase _ _ _⟩).1

/-- The point `f1ToPoint` of `P` classifying a triple `(f, ℒ, ψ)` lies over the point `f` of
`X`. -/
theorem f1ToPoint_comp_relativeProjπ {T : BigFppfOver s.site s.base s.containsBase}
    (x : s.F1Triples TA T) : s.f1ToPoint TA x ≫ s.relativeProjπ = x.1 := by
  refine ((s.relativeProjPoints.pointEquivProjOver T x.1 (𝟙 T)).symm _).2.trans ?_
  rw [CategoryTheory.Functor.map_id, Category.id_comp]

/-- The section of `Proj_T(f^*𝒜)` corresponding to the point `f1ToPoint` of a triple is the
degree-one classifying morphism `classifyingHom` of the triple. -/
theorem pointEquivProjOver_f1ToPoint {T : BigFppfOver s.site s.base s.containsBase}
    (x : s.F1Triples TA T) (h : s.f1ToPoint TA x ≫ s.relativeProjπ = yoneda.map (𝟙 T) ≫ x.1) :
    (s.relativeProjPoints.pointEquivProjOver T x.1 (𝟙 T) ⟨s.f1ToPoint TA x, h⟩).1 =
      classifyingHom (s.shrink.pointAlgebra T x.1) (relativeProj _)
        ⟨𝟙 _, quadrupleClass _ TA _ x.2⟩ :=
  congrArg Subtype.val ((s.relativeProjPoints.pointEquivProjOver T x.1 (𝟙 T)).apply_symm_apply _)

/-- **The morphism `P ⟶ F₁` is injective on points**, with no hypothesis on `𝒜`: the point of `X`
is recovered by `π`, the section of `Proj_T(f^*𝒜)` by Stacks 084B, the class of quadruples by
the injectivity of the degree-one classifying morphism, and the triple by `quadrupleClass`. -/
theorem f1ToPoint_injective (T : BigFppfOver s.site s.base s.containsBase) :
    Function.Injective (s.f1ToPoint TA (T := T)) := by
  rintro ⟨f, c⟩ ⟨f', c'⟩ h
  obtain rfl : f = f' := (s.f1ToPoint_comp_relativeProjπ TA ⟨f, c⟩).symm.trans
    ((congrArg (· ≫ s.relativeProjπ) h).trans (s.f1ToPoint_comp_relativeProjπ TA ⟨f', c'⟩))
  have h1 := (s.relativeProjPoints.pointEquivProjOver T f (𝟙 T)).symm.injective
    (Subtype.ext h)
  have h2 := classifyingHom_injective _ _ (congrArg Subtype.val h1)
  have h3 : quadrupleClass _ TA _ c = quadrupleClass _ TA _ c' :=
    eq_of_heq (Sigma.mk.inj h2).2
  rw [quadrupleClass_injective _ TA _ h3]

/-- **The comparison of Stacks 084B on the sections of `Proj`.** For a `T`-point `u` of `P` over
`f` and `τ : T' ⟶ T`, the section of `Proj_{T'}((f ∘ τ)^*𝒜)` attached to `u ∘ τ`, followed by the
comparison morphism `Proj_{T'}((f ∘ τ)^*𝒜) ⟶ Proj_T(f^*𝒜)`, is `τ` followed by the section of
`Proj_T(f^*𝒜)` attached to `u`. -/
theorem pointEquivProjOver_comp_projComparison {T T' : BigFppfOver s.site s.base s.containsBase}
    (τ : T' ⟶ T) (f : yoneda.obj T ⟶ s.space.1)
    (u : {u : yoneda.obj T ⟶ s.relativeProjFunctor // u ≫ s.relativeProjπ = yoneda.map (𝟙 T) ≫ f})
    (hv : (yoneda.map τ ≫ u.1) ≫ s.relativeProjπ = yoneda.map (𝟙 T') ≫ yoneda.map τ ≫ f) :
    (s.relativeProjPoints.pointEquivProjOver T' (yoneda.map τ ≫ f) (𝟙 T')
        ⟨yoneda.map τ ≫ u.1, hv⟩).1 ≫
        (BigFppfOver.toScheme s.site s.base s.containsBase).map
          (s.quadrupleRestriction.projComparison s.shrink.contains_relativeProj_pointAlgebra f τ) =
      (BigFppfOver.toScheme s.site s.base s.containsBase).map τ ≫
        (s.relativeProjPoints.pointEquivProjOver T f (𝟙 T) u).1 := by
  set d := s.relativeProjPoints
  obtain ⟨hsq, hsp, -⟩ := s.isPullback_projComparison f τ
  let pc : d.fibre T' (yoneda.map τ ≫ f) ⟶ d.fibre T f :=
    s.quadrupleRestriction.projComparison s.shrink.contains_relativeProj_pointAlgebra f τ
  let sv : T' ⟶ d.fibre T' (yoneda.map τ ≫ f) :=
    (d.pointEquivOver T' (yoneda.map τ ≫ f) (𝟙 T') ⟨yoneda.map τ ≫ u.1, hv⟩).1
  let su : T ⟶ d.fibre T f := (d.pointEquivOver T f (𝟙 T) u).1
  have hsv : sv ≫ d.fibreHom T' (yoneda.map τ ≫ f) = 𝟙 T' :=
    (d.pointEquivOver T' (yoneda.map τ ≫ f) (𝟙 T') ⟨yoneda.map τ ≫ u.1, hv⟩).2
  have hsu : su ≫ d.fibreHom T f = 𝟙 T := (d.pointEquivOver T f (𝟙 T) u).2
  have hw : pc ≫ d.fibreHom T f = d.fibreHom T' (yoneda.map τ ≫ f) ≫ τ := hsq.w
  have hp : yoneda.map pc ≫ d.fibreToSpace T f = d.fibreToSpace T' (yoneda.map τ ≫ f) := hsp
  have key : sv ≫ pc = τ ≫ su := by
    apply Yoneda.fullyFaithful.map_injective
    refine (d.isPullback T f).hom_ext ?_ ?_
    · calc yoneda.map (sv ≫ pc) ≫ d.fibreToSpace T f
          = yoneda.map sv ≫ (yoneda.map pc ≫ d.fibreToSpace T f) := by
            rw [CategoryTheory.Functor.map_comp, Category.assoc]
        _ = yoneda.map sv ≫ d.fibreToSpace T' (yoneda.map τ ≫ f) := by rw [hp]
        _ = yoneda.map τ ≫ u.1 := d.map_pointEquivOver _ _ _ _
        _ = yoneda.map τ ≫ (yoneda.map su ≫ d.fibreToSpace T f) := by
            rw [d.map_pointEquivOver T f (𝟙 T) u]
        _ = yoneda.map (τ ≫ su) ≫ d.fibreToSpace T f := by
            rw [CategoryTheory.Functor.map_comp, Category.assoc]
    · calc yoneda.map (sv ≫ pc) ≫ yoneda.map (d.fibreHom T f)
          = yoneda.map (sv ≫ pc ≫ d.fibreHom T f) := by
            rw [← CategoryTheory.Functor.map_comp, Category.assoc]
        _ = yoneda.map τ := by rw [hw, ← Category.assoc, hsv, Category.id_comp]
        _ = yoneda.map (τ ≫ su) ≫ yoneda.map (d.fibreHom T f) := by
            rw [← CategoryTheory.Functor.map_comp, Category.assoc, hsu, Category.comp_id]
  calc (d.pointEquivProjOver T' (yoneda.map τ ≫ f) (𝟙 T') ⟨yoneda.map τ ≫ u.1, hv⟩).1 ≫
        (BigFppfOver.toScheme s.site s.base s.containsBase).map pc
      = ((BigFppfOver.toScheme s.site s.base s.containsBase).map sv ≫ 𝟙 _) ≫
        (BigFppfOver.toScheme s.site s.base s.containsBase).map pc := rfl
    _ = (BigFppfOver.toScheme s.site s.base s.containsBase).map (sv ≫ pc) := by
        rw [Category.comp_id, CategoryTheory.Functor.map_comp]
    _ = (BigFppfOver.toScheme s.site s.base s.containsBase).map τ ≫
          ((BigFppfOver.toScheme s.site s.base s.containsBase).map su ≫ 𝟙 _) := by
        rw [key, Category.comp_id, CategoryTheory.Functor.map_comp]
    _ = _ := rfl

/-- **Naturality of the morphism `F₁ ⟶ P`.** Restricting the point classifying a triple along
`τ : T' ⟶ T` gives the point classifying the restricted triple.

Both are sections over `T'` of `Proj_{T'}((f ∘ τ)^*𝒜)`, which by the third assertion of
Stacks 084B is `T' ×_T Proj_T(f^*𝒜)`; their images in `Proj_T(f^*𝒜)` agree, by
`pointEquivProjOver_comp_projComparison` for the first and by
`GradedAlgebraRestriction.classifyingHom_quadrupleClassRestrict` for the second, through the
identification of the comparison morphism with the base-change morphism of Tag 01O3. -/
theorem yoneda_map_comp_f1ToPoint {T T' : BigFppfOver s.site s.base s.containsBase}
    (τ : T' ⟶ T) (f : yoneda.obj T ⟶ s.space.1) (c : F1 (s.shrink.pointAlgebra T f) TA (𝟙 _)) :
    yoneda.map τ ≫ s.f1ToPoint TA ⟨f, c⟩ =
      s.f1ToPoint TA ⟨yoneda.map τ ≫ f, s.f1Restrict TA τ f _ rfl c⟩ := by
  set φ := BigFppfOver.toScheme s.site s.base s.containsBase
  have hπ : ∀ {T : BigFppfOver s.site s.base s.containsBase} (x : s.F1Triples TA T),
      s.f1ToPoint TA x ≫ s.relativeProjπ = yoneda.map (𝟙 T) ≫ x.1 := fun x => by
    rw [s.f1ToPoint_comp_relativeProjπ, CategoryTheory.Functor.map_id, Category.id_comp]
  have hv : (yoneda.map τ ≫ s.f1ToPoint TA ⟨f, c⟩) ≫ s.relativeProjπ =
      yoneda.map (𝟙 T') ≫ yoneda.map τ ≫ f := by
    rw [Category.assoc, s.f1ToPoint_comp_relativeProjπ, CategoryTheory.Functor.map_id,
      Category.id_comp]
  have hsq := s.quadrupleRestriction.isPullback_baseChangeHom_restrictProjIso
    s.shrink.contains_relativeProj_pointAlgebra f τ
  refine congrArg Subtype.val ((s.relativeProjPoints.pointEquivProjOver T' (yoneda.map τ ≫ f)
    (𝟙 T')).injective (a₁ := ⟨_, hv⟩) (a₂ := ⟨_, hπ ⟨yoneda.map τ ≫ f, _⟩⟩) (Subtype.ext ?_))
  rw [s.pointEquivProjOver_f1ToPoint TA ⟨yoneda.map τ ≫ f, s.f1Restrict TA τ f _ rfl c⟩ (hπ _)]
  set γ := classifyingHom (s.shrink.pointAlgebra T' (yoneda.map τ ≫ f)) (relativeProj _)
    ⟨𝟙 _, quadrupleClass _ TA _ (s.f1Restrict TA τ f _ rfl c)⟩
  have e2 : γ ≫ (s.quadrupleRestriction.restrictProjIso f τ).hom ≫
        Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.baseChangeHom
          (s.shrink.pointAlgebra T f) (φ.map τ) =
      φ.map τ ≫ classifyingHom (s.shrink.pointAlgebra T f) (relativeProj _)
        ⟨𝟙 _, quadrupleClass _ TA _ c⟩ := by
    have := s.quadrupleRestriction.classifyingHom_quadrupleClassRestrict τ f
      (quadrupleClass _ TA _ c)
    rwa [← s.quadrupleClass_f1Restrict TA τ f _ rfl c] at this
  refine hsq.1.hom_ext ?_ ?_
  · refine (s.pointEquivProjOver_comp_projComparison τ f ⟨_, hπ ⟨f, c⟩⟩ hv).trans
      ((congrArg (φ.map τ ≫ ·) (s.pointEquivProjOver_f1ToPoint TA ⟨f, c⟩ (hπ _))).trans
      (e2.symm.trans ?_))
    exact congrArg (γ ≫ ·) hsq.2.symm
  · exact (s.relativeProjPoints.pointEquivProjOver T' (yoneda.map τ ≫ f) (𝟙 T') _).2.trans
      ((φ.map_id T').trans (classifyingHom_comp_toBase _ _
      ⟨𝟙 _, quadrupleClass _ TA _ (s.f1Restrict TA τ f _ rfl c)⟩).symm)

/-- **The functor `F₁` of Stacks 085D** on the big fppf site, for the constructed relative Proj:
on a test object `T` the pairs of a `T`-point `f` of `X` and a strict isomorphism class of pairs
`(ℒ, ψ)` for `f^*𝒜`; on a morphism `τ : T' ⟶ T` the pullback of triples,
`AlgebraicGeometry.Space.RelativeProjSituation.f1Restrict`.

The functor laws are read off in `P` through the injective natural map `f1ToPoint`, so no
hypothesis on `𝒜` is needed. -/
def relativeProjF1Functor :
    (BigFppfOver s.site s.base s.containsBase)ᵒᵖ ⥤ Type (u + 1) where
  obj T := s.F1Triples TA T.unop
  map {T T'} τ := TypeCat.ofHom fun x => ⟨yoneda.map τ.unop ≫ x.1,
    s.f1Restrict TA τ.unop x.1 _ rfl x.2⟩
  map_id T := TypeCat.homEquiv.injective (funext fun x => by
    apply s.f1ToPoint_injective TA
    obtain ⟨f, c⟩ := x
    exact (s.yoneda_map_comp_f1ToPoint TA (𝟙 T.unop) f c).symm.trans
      (by rw [CategoryTheory.Functor.map_id, Category.id_comp]; rfl))
  map_comp {T T' T''} τ τ' := TypeCat.homEquiv.injective (funext fun x => by
    apply s.f1ToPoint_injective TA
    obtain ⟨f, c⟩ := x
    refine (s.yoneda_map_comp_f1ToPoint TA (τ'.unop ≫ τ.unop) f c).symm.trans ?_
    refine Eq.trans ?_ (s.yoneda_map_comp_f1ToPoint TA τ'.unop _ _)
    rw [CategoryTheory.Functor.map_comp, Category.assoc, s.yoneda_map_comp_f1ToPoint TA τ.unop f c]
    rfl)

/-- The value of `relativeProjF1Functor` at `T` is the type `F1Triples` of triples on `T`. -/
@[simp] theorem relativeProjF1Functor_obj (T : (BigFppfOver s.site s.base s.containsBase)ᵒᵖ) :
    (s.relativeProjF1Functor TA).obj T = s.F1Triples TA T.unop :=
  rfl

/-- The functor `relativeProjF1Functor` sends a triple `(f, c)` along `τ` to the composite
point `yoneda.map τ.unop ≫ f` together with the restriction `f1Restrict` of the class `c`. -/
theorem relativeProjF1Functor_map {T T' : (BigFppfOver s.site s.base s.containsBase)ᵒᵖ}
    (τ : T ⟶ T') (f : yoneda.obj T.unop ⟶ s.space.1)
    (c : F1 (s.shrink.pointAlgebra T.unop f) TA (𝟙 _)) :
    (s.relativeProjF1Functor TA).map τ ⟨f, c⟩ =
      ⟨yoneda.map τ.unop ≫ f, s.f1Restrict TA τ.unop f _ rfl c⟩ :=
  rfl

/-- **The morphism `F₁ ⟶ P` (after lifting the universe of `P`).** A triple `(f, ℒ, ψ)` is sent
to the point of `P` it classifies, `f1ToPoint`. -/
def f1ToRelativeProj :
    s.relativeProjF1Functor TA ⟶ s.relativeProjFunctor ⋙ uliftFunctor.{u + 1} where
  app T := TypeCat.ofHom fun x => ULift.up (yonedaEquiv (s.f1ToPoint TA x))
  naturality {T T'} τ := TypeCat.homEquiv.injective (funext fun x => by
    obtain ⟨f, c⟩ := x
    exact congrArg ULift.up ((congrArg yonedaEquiv
      (s.yoneda_map_comp_f1ToPoint TA τ.unop f c).symm).trans
      (yonedaEquiv_naturality (s.f1ToPoint TA ⟨f, c⟩) τ.unop).symm))

section Generated

variable (hgen : ∀ (T : BigFppfOver s.site s.base s.containsBase) (f : yoneda.obj T ⟶ s.space.1),
  IsGeneratedInDegreeOne (s.shrink.pointAlgebra T f))

/-- Under degree-one generation of the restrictions, the bijection
`RelativeProjPoints.homEquivF1OfGenerated` at the constructed relative Proj is inverse to the
classifying map `f1ToPoint`. -/
theorem homEquivF1OfGenerated_symm_apply (T : BigFppfOver s.site s.base s.containsBase)
    (x : s.F1Triples TA T) :
    (s.relativeProjPoints.homEquivF1OfGenerated TA hgen T).symm x = s.f1ToPoint TA x :=
  rfl

end Generated

