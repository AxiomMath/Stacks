module

public import StacksFrontier.AlgebraicGeometry.Spaces.KernelIdealSheafCartesianSquare
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleModulePullbackEpiLocal
public import StacksFrontier.AlgebraicGeometry.Spaces.AffineChartDiagramCover
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulePullbackSectionGenerators
public import StacksFrontier.AlgebraicGeometry.Spaces.ConormalModuleBaseChangeFlat
public import StacksFrontier.AlgebraicGeometry.Spaces.SmallEtaleFlatTopos
public import StacksFrontier.AlgebraicGeometry.Spaces.ModulesAbelian
public import StacksFrontier.AlgebraicGeometry.Spaces.SmoothAtlas
public import StacksFrontier.AlgebraicGeometry.Spaces.MeromorphicSectionGlobalPullbackNatural

/-!
# The map of powers of kernel ideal sheaves of a cartesian square of immersions

Let
```
Z --i--→ X
|        |
f        g
↓        ↓
Z' -i'-→ X'
```
be a cartesian square of algebraic spaces over a scheme `S` contained in a big fppf site `B`, with
`i'` an immersion, and write `𝓘 = Ker(i^♯) ⊆ 𝒪_X`, `𝓘' = Ker((i')^♯) ⊆ 𝒪_{X'}`.  A morphism of
`𝒪_X`-modules `φ : g^*((𝓘')ⁿ) ⟶ 𝓘ⁿ` is *induced by pullback of regular functions* when on every
commutative diagram of étale scheme charts over `g` it carries the unit section of a section of
`(𝓘')ⁿ` to the pullback of that section; the degree-`n` component of the ambient comparison of
Stacks 09RS is such a morphism.  This file proves:

* **surjectivity near `Z`**: `i^*φ` is an epimorphism of `𝒪_Z`-modules, for every `n ≥ 0`;
* **invertibility near `Z` along a flat morphism**: if `g` is flat, `i^*φ` is an isomorphism.

This is the content, upstairs on the ambient space, of [Stacks Project, Tag 09RT]; the source
deduces it from the case of schemes, Divisors, Lemma 0635, after étale localization, and the
argument below is that argument read on étale charts.  Near `Z` — on the open subspace
`U = g⁻¹(X' ∖ ∂Z')` of `X`, through which `i` factors — the ideal `𝓘(W)` of an affine chart `W`
lying over an affine chart `V` of `X' ∖ ∂Z'` is generated by the pullback of `𝓘'(V)`
(`AlgebraicGeometry.Space.kernelIdealSheaf_obj_eq_map_of_isPullback`), so its `n`-th power is
generated by pullbacks of elements of `𝓘'(V)ⁿ`, each of which is a value of `φ` on a unit
section.  Such charts cover `U`, and a section of `𝓘ⁿ` lies locally in the `n`-th power of the
ideal of sections; so `φ` is locally surjective at the charts of `U`, and `i^*φ` is an
epimorphism because the inverse image along the étale inclusion of `U` is étale restriction.

Surjectivity cannot hold globally on `X` when `i'` is not a closed immersion: for the open
immersion `D(t) ⊆ 𝔸¹` and `g : Spec k[t]/(t²) ⟶ 𝔸¹` the ideal `𝓘'` is zero while `Z` is empty and
`𝓘 = 𝒪_X`.  This is why the statements are about `i^*φ` and not about `φ`.

Injectivity, for flat `g`, holds globally: `φ` followed by the embedding `𝓘ⁿ ⊆ 𝒪_X` is the
inverse image of the embedding `(𝓘')ⁿ ⊆ 𝒪_{X'}` followed by the isomorphism `g^*𝒪_{X'} ≅ 𝒪_X`,
and the inverse image along a flat morphism preserves injections.

## Main definitions

* `AlgebraicGeometry.Space.IsInducedByPullback`: the condition on `φ` of being induced by
  pullback of regular functions.

## Main results

* `AlgebraicGeometry.Space.isLocallySurjectiveAt_of_isPullback`: `φ` is locally surjective at
  every étale chart of `U = g⁻¹(X' ∖ ∂Z')`.
* `AlgebraicGeometry.Space.epi_modulePullback_map_of_isPullback`: **`i^*φ` is an epimorphism**.
* `AlgebraicGeometry.Space.mono_of_isInducedByPullback_of_isFlat`: for flat `g`, `φ` is a
  monomorphism.
* `AlgebraicGeometry.Space.isIso_modulePullback_map_of_isPullback_of_isFlat`: **for flat `g`,
  `i^*φ` is an isomorphism**.

## References

* [Stacks Project, Tag 09RT](https://stacks.math.columbia.edu/tag/09RT)
* [Stacks Project, Tag 0635](https://stacks.math.columbia.edu/tag/0635)
* [Stacks Project, Tag 04CQ](https://stacks.math.columbia.edu/tag/04CQ)
* [Stacks Project, Tag 03LW](https://stacks.math.columbia.edu/tag/03LW)
-/

@[expose] public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable {Z X Z' X' : AlgebraicSpaces B S hS}

/-- **A morphism `g^*((𝓘')ⁿ) ⟶ 𝓘ⁿ` induced by pullback of regular functions.**  On every
commutative diagram `d` of étale scheme charts over `g`, the value on the unit section of a
section `s` of `(𝓘')ⁿ` over the chart of `X'` is, as a regular function, the pullback of `s`
along the vertical morphism of `d`. -/
def IsInducedByPullback (i : Z ⟶ X) (i' : Z' ⟶ X') (g : X ⟶ X') (n : ℤ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules) : Prop :=
  ∀ (d : ChartDiagram B S hS X.1 X'.1 g.hom)
    (s : (kernelIdealSheafZPow B S hS i' n).toSheafOfModules.val.obj (op d.V)),
    (φ.val.app (op d.U) (modulePullbackUnitSection B S hS g _ d s)).1 =
      (chartDiagramPullback B S hS g d).hom s.1

section Surjectivity

attribute [local instance] pointTopology

variable {i : Z ⟶ X} {i' : Z' ⟶ X'} {f : Z ⟶ Z'} {g : X ⟶ X'}

/-- **On an affine chart diagram near `Z`, every element of the `n`-th power of the kernel ideal
of `i` is a value of `φ`.**  The ideal is generated by the pullback of the kernel ideal of `i'`
(`AlgebraicGeometry.Space.kernelIdealSheaf_obj_eq_map_of_isPullback`), so its `n`-th power is
generated by pullbacks of elements of the `n`-th power of that ideal, which are values of `φ` on
unit sections, and the values of `φ` over a chart form a submodule. -/
theorem mem_range_of_isInducedByPullback (sq : IsPullback i f g i')
    (hi' : IsImmersion B S hS i'.hom) (n : ℕ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ)
    (T : SmallEtale B S hS (immersionAmbientPreimage B S hS i' hi' g).1)
    (hT : HasAffineChartDiagram B S hS (immersionAmbientPreimageMap B S hS i' hi' g) T)
    (y : (kernelIdealSheafZPow B S hS i n).toSheafOfModules.val.obj
      (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T)))
    (hy : y.1 ∈ SheafOfModules.idealAt (kernelIdealSheaf B S hS i)
      (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T)) ^ n) :
    y ∈ LinearMap.range (φ.val.app
      (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T))).hom := by
  obtain ⟨hTaff, V, q, hq, hVaff⟩ := hT
  have hcomm : ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T).1.hom ≫ g.hom =
      yoneda.map q ≫ ((smallEtalePostcomp B S hS (immersionAmbientι B S hS i' hi')
        (isEtale_immersionAmbientι B S hS i' hi')).obj V).1.hom := by
    have h₁ : (immersionAmbientPreimageMap B S hS i' hi' g).hom ≫
        (immersionAmbientι B S hS i' hi').hom =
        (immersionAmbientPreimageι B S hS i' hi' g).hom ≫ g.hom :=
      congrArg (fun k => k.hom) (immersionAmbientPreimageMap_comp_immersionAmbientι B S hS i' hi' g)
    change (T.1.hom ≫ (immersionAmbientPreimageι B S hS i' hi' g).hom) ≫ g.hom =
      yoneda.map q ≫ V.1.hom ≫ (immersionAmbientι B S hS i' hi').hom
    rw [Category.assoc, ← h₁, ← Category.assoc, ← hq, Category.assoc]
  let d : ChartDiagram B S hS X.1 X'.1 g.hom :=
    ⟨(smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T,
      (smallEtalePostcomp B S hS (immersionAmbientι B S hS i' hi')
        (isEtale_immersionAmbientι B S hS i' hi')).obj V, q, hcomm⟩
  have hK : SheafOfModules.idealAt (kernelIdealSheaf B S hS i) (op d.U) =
      Ideal.map (chartDiagramPullback B S hS g d).hom
        (SheafOfModules.idealAt (kernelIdealSheaf B S hS i') (op d.V)) :=
    kernelIdealSheaf_obj_eq_map_of_isPullback B S hS i' hi' g sq T V q hq
  have hy' : y.1 ∈ Ideal.map (chartDiagramPullback B S hS g d).hom
      (SheafOfModules.idealAt (kernelIdealSheaf B S hS i') (op d.V) ^ n) :=
    (Ideal.map_pow (chartDiagramPullback B S hS g d).hom
      (SheafOfModules.idealAt (kernelIdealSheaf B S hS i') (op d.V)) n).ge (hK ▸ hy)
  have hle : Ideal.map (chartDiagramPullback B S hS g d).hom
        (SheafOfModules.idealAt (kernelIdealSheaf B S hS i') (op d.V) ^ n) ≤
      SheafOfModules.idealAt (kernelIdealSheafZPow B S hS i n) (op d.U) := by
    intro z hz
    have h2 : z ∈ SheafOfModules.idealAt (kernelIdealSheaf B S hS i) (op d.U) ^ n := by
      rw [hK]
      exact (Ideal.map_pow (chartDiagramPullback B S hS g d).hom
        (SheafOfModules.idealAt (kernelIdealSheaf B S hS i') (op d.V)) n).le hz
    rw [kernelIdealSheafZPow, SheafOfModules.idealSheafZPow_natCast]
    exact SheafOfModules.mem_idealSheafPow_of_mem_pow _ n h2
  have aux : ∀ b, b ∈ Ideal.map (chartDiagramPullback B S hS g d).hom
        (SheafOfModules.idealAt (kernelIdealSheaf B S hS i') (op d.V) ^ n) →
      ∀ hb : b ∈ SheafOfModules.idealAt (kernelIdealSheafZPow B S hS i n) (op d.U),
        (⟨b, hb⟩ : (kernelIdealSheafZPow B S hS i n).toSheafOfModules.val.obj (op d.U)) ∈
          LinearMap.range (φ.val.app (op d.U)).hom := by
    intro b hb
    induction hb using Submodule.span_induction with
    | mem b hb =>
        obtain ⟨a, ha, rfl⟩ := hb
        intro hbI
        have haz : a ∈ SheafOfModules.idealAt (kernelIdealSheafZPow B S hS i' n) (op d.V) := by
          rw [kernelIdealSheafZPow, SheafOfModules.idealSheafZPow_natCast]
          exact SheafOfModules.mem_idealSheafPow_of_mem_pow _ n ha
        exact ⟨modulePullbackUnitSection B S hS g _ d ⟨a, haz⟩, Subtype.ext (hφ d ⟨a, haz⟩)⟩
    | zero => exact fun _ => Submodule.zero_mem _
    | add b c hb hc ihb ihc => exact fun _ => Submodule.add_mem _ (ihb (hle hb)) (ihc (hle hc))
    | smul r b hb ih => exact fun _ => Submodule.smul_mem _ r (ih (hle hb))
  exact aux y.1 hy' y.2

/-- **At a chart of `X` landing in `U = g⁻¹(X' ∖ ∂Z')`, every section of `𝓘ⁿ` lying in the
`n`-th power of the ideal of sections lifts locally along `φ`.**  The chart is a chart of `U`,
covered by charts carrying an affine chart diagram over `U ⟶ X' ∖ ∂Z'`
(`AlgebraicGeometry.Space.mem_topology_of_hasAffineChartDiagram`), pushed to charts of `X` by
postcomposition (`AlgebraicGeometry.Space.SmallEtale.coverPreserving_smallEtalePostcomp`); on
those, `AlgebraicGeometry.Space.mem_range_of_isInducedByPullback` applies. -/
theorem imageSieve_mem_of_isPullback (sq : IsPullback i f g i')
    (hi' : IsImmersion B S hS i'.hom) (n : ℕ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ)
    (T : SmallEtale B S hS (immersionAmbientPreimage B S hS i' hi' g).1)
    (x : ToType (((PresheafOfModules.toPresheaf _).obj
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules.val).obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T))))
    (hx : (x : (kernelIdealSheafZPow B S hS i n).toSheafOfModules.val.obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T))).1 ∈
      SheafOfModules.idealAt (kernelIdealSheaf B S hS i)
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T)) ^ n) :
    Presheaf.imageSieve ((PresheafOfModules.toPresheaf _).map φ.val) x ∈
      SmallEtale.topology B S hS X.1
        ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj T) := by
  have hpush := (SmallEtale.coverPreserving_smallEtalePostcomp B S hS
    (immersionAmbientPreimageι B S hS i' hi' g)
    (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).cover_preserve
    (mem_topology_of_hasAffineChartDiagram B S hS (immersionAmbientPreimageMap B S hS i' hi' g)
      T (Sieve.functorPullback (smallEtalePostcomp B S hS
        (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g))
        (Presheaf.imageSieve ((PresheafOfModules.toPresheaf _).map φ.val) x))
      (fun {T₀} b hb => ?_))
  · refine (SmallEtale.topology B S hS X.1).superset_covering ?_ hpush
    rintro T₁ c ⟨T₀, b, c', hb, hc⟩
    rw [hc]
    exact (Presheaf.imageSieve ((PresheafOfModules.toPresheaf _).map φ.val) x).downward_closed
      hb c'
  · obtain ⟨t, ht⟩ := mem_range_of_isInducedByPullback B S hS sq hi' n φ hφ T₀ hb
      ((kernelIdealSheafZPow B S hS i n).toSheafOfModules.val.map
        ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).map b).op x)
      (SheafOfModules.map_mem_idealAt_pow ((smallEtalePostcomp B S hS
        (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).map b).op n hx)
    exact ⟨t, ht⟩

/-- **`φ` is locally surjective at every étale chart of `U = g⁻¹(X' ∖ ∂Z')`.**  A section of
`𝓘ⁿ` over such a chart restricts, on a covering sieve, into the `n`-th power of the ideal of
sections (the definition of `SheafOfModules.idealSheafPow`), and each chart of that sieve again
lands in `U`, so `AlgebraicGeometry.Space.imageSieve_mem_of_isPullback` applies there. -/
theorem isLocallySurjectiveAt_of_isPullback (sq : IsPullback i f g i')
    (hi' : IsImmersion B S hS i'.hom) (n : ℕ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ)
    (W : SmallEtale B S hS (immersionAmbientPreimage B S hS i' hi' g).1) :
    Stacks.SheafOfModules.IsLocallySurjectiveAt (SmallEtale.topology B S hS X.1) φ.val
      ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
        (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W) := by
  intro s
  have hUo : IsAlgebraicSpace B S hS (immersionAmbientPreimageSubfunctor B S hS i' g).toFunctor :=
    (isOpenSubspace_immersionAmbientPreimageSubfunctor B S hS i' hi' g).1
  have hs : SheafOfModules.powSieve (kernelIdealSheaf B S hS i) n
      (s : (kernelIdealSheafZPow B S hS i n).toSheafOfModules.val.obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W))).1 ∈
        SmallEtale.topology B S hS X.1 ((smallEtalePostcomp B S hS
          (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W) := by
    have hmem : ∀ (y : ToType ((structureRingSheaf B S hS X).obj.obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W)))),
        y ∈ SheafOfModules.idealAt (kernelIdealSheafZPow B S hS i n)
          (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
            (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W)) →
        SheafOfModules.powSieve (kernelIdealSheaf B S hS i) n y ∈
          SmallEtale.topology B S hS X.1 ((smallEtalePostcomp B S hS
            (immersionAmbientPreimageι B S hS i' hi' g)
            (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W) := by
      intro y hy
      rwa [kernelIdealSheafZPow, SheafOfModules.idealSheafZPow_natCast,
        SheafOfModules.mem_idealSheafPow_iff] at hy
    exact hmem _ (s : (kernelIdealSheafZPow B S hS i n).toSheafOfModules.val.obj
        (op ((smallEtalePostcomp B S hS (immersionAmbientPreimageι B S hS i' hi' g)
          (isEtale_immersionAmbientPreimageι B S hS i' hi' g)).obj W))).2
  refine (SmallEtale.topology B S hS X.1).transitive hs _ (fun {T} a ha => ?_)
  rw [Presheaf.pullback_imageSieve]
  have hTU : Subfunctor.range T.1.hom ≤ immersionAmbientPreimageSubfunctor B S hS i' g :=
    range_le_of_hom B S hS _ a (range_smallEtalePostcomp_le B S hS _ hUo
      (isEtale_immersionAmbientPreimageι B S hS i' hi' g) W)
  exact imageSieve_mem_of_isPullback B S hS sq hi' n φ hφ
    (liftChartOfRangeLE B S hS _ hUo T hTU) _ ha

/-- **Surjectivity near `Z`: the inverse image `i^*φ` of a morphism `g^*((𝓘')ⁿ) ⟶ 𝓘ⁿ` induced
by pullback of regular functions is an epimorphism**, for a cartesian square with `i'` an
immersion.  The morphism `i` factors through the open subspace `U = g⁻¹(X' ∖ ∂Z')`, along whose
étale inclusion the inverse image of `φ` is an epimorphism by
`AlgebraicGeometry.Space.isLocallySurjectiveAt_of_isPullback` and
`AlgebraicGeometry.Space.epi_modulePullback_map_of_isLocallySurjectiveAt`. -/
theorem epi_modulePullback_map_of_isPullback (sq : IsPullback i f g i')
    (hi' : IsImmersion B S hS i'.hom) (n : ℕ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ) :
    Epi ((modulePullback B S hS i).map φ) := by
  have h := epi_modulePullback_comp_map B S hS (immersionAmbientPreimageLift B S hS i' hi' g sq)
    (immersionAmbientPreimageι B S hS i' hi' g) φ
    (epi_modulePullback_map_of_isLocallySurjectiveAt B S hS
      (immersionAmbientPreimageι B S hS i' hi' g)
      (isEtale_immersionAmbientPreimageι B S hS i' hi' g) φ
      (isLocallySurjectiveAt_of_isPullback B S hS sq hi' n φ hφ))
  rwa [immersionAmbientPreimageLift_comp] at h

end Surjectivity

/-! ### Injectivity along a flat morphism -/

section Injectivity

variable {i : Z ⟶ X} {i' : Z' ⟶ X'} {g : X ⟶ X'}

/-- The inverse image along a flat morphism of algebraic spaces preserves monomorphisms. -/
private theorem preservesMonomorphisms_modulePullback_of_isFlat (g : X ⟶ X')
    (hg : IsFlat B S hS g.hom) : (modulePullback B S hS g).PreservesMonomorphisms :=
  have := ((exactFunctor_iff (modulePullback B S hS g)).mp
    (exactFunctor_modulePullback_of_isFlat B S hS g
      ((isFlat_iff_smallEtaleRingedToposHom_isFlat B S hS g).mp hg))).1
  inferInstance

/-- The chartwise transpose of `φ` followed by the embedding `𝓘ⁿ ⊆ 𝒪_X` is pullback of regular
functions. -/
private theorem modulePullbackHomFMap_comp_ι_app (n : ℤ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ)
    (d : ChartDiagram B S hS X.1 X'.1 g.hom)
    (s : (kernelIdealSheafZPow B S hS i' n).toSheafOfModules.val.obj (op d.V)) :
    (modulePullbackHomFMap B S hS g _ _ (φ ≫ (kernelIdealSheafZPow B S hS i n).ι)).app d s =
      (chartDiagramPullback B S hS g d).hom s.1 :=
  (modulePullbackHomFMap_app B S hS g _ _ _ d s).trans (hφ d s)

/-- The chartwise transpose of the inverse image of the embedding `(𝓘')ⁿ ⊆ 𝒪_{X'}` followed by
`g^*𝒪_{X'} ⟶ 𝒪_X` is pullback of regular functions. -/
private theorem modulePullbackHomFMap_map_ι_comp_app (n : ℤ)
    (d : ChartDiagram B S hS X.1 X'.1 g.hom)
    (s : (kernelIdealSheafZPow B S hS i' n).toSheafOfModules.val.obj (op d.V)) :
    (modulePullbackHomFMap B S hS g _ _
        ((modulePullback B S hS g).map (kernelIdealSheafZPow B S hS i' n).ι ≫
          structureSheafMap B S hS g)).app d s =
      (chartDiagramPullback B S hS g d).hom s.1 := by
  refine (modulePullbackHomFMap_app B S hS g _ _ _ d s).trans ?_
  refine (congrArg (fun t => (structureSheafMap B S hS g).val.app (op d.U) t)
    (modulePullbackUnitSection_naturality_module B S hS g
      (kernelIdealSheafZPow B S hS i' n).ι d s).symm).trans ?_
  refine (modulePullbackHomFMap_app B S hS g _ _ (structureSheafMap B S hS g) d _).symm.trans ?_
  exact congrArg (fun ξ : ModuleFMap B S hS g (SheafOfModules.unit (structureRingSheaf B S hS X))
      (SheafOfModules.unit (structureRingSheaf B S hS X')) =>
        ξ.app d ((kernelIdealSheafZPow B S hS i' n).ι.val.app (op d.V) s))
    (structureSheafMap_transpose B S hS g)

/-- **`φ` followed by the embedding `𝓘ⁿ ⊆ 𝒪_X` is the inverse image of the embedding
`(𝓘')ⁿ ⊆ 𝒪_{X'}` followed by `g^*𝒪_{X'} ⟶ 𝒪_X`.**  Both are morphisms out of `g^*((𝓘')ⁿ)`, so
they agree as soon as their chartwise transposes do, and both transposes are pullback of regular
functions. -/
theorem comp_ι_eq_of_isInducedByPullback (n : ℤ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ) :
    φ ≫ (kernelIdealSheafZPow B S hS i n).ι =
      (modulePullback B S hS g).map (kernelIdealSheafZPow B S hS i' n).ι ≫
        structureSheafMap B S hS g := by
  refine ((modulePullbackAdjunction B S hS g).homEquiv _ _).injective ?_
  refine (modulePushforwardHomEquiv B S hS g
    (SheafOfModules.unit (structureRingSheaf B S hS X))
    (kernelIdealSheafZPow B S hS i' n).toSheafOfModules).injective ?_
  refine ModuleFMap.ext B S hS (funext fun d => funext fun s => ?_)
  exact (modulePullbackHomFMap_comp_ι_app B S hS n φ hφ d s).trans
    (modulePullbackHomFMap_map_ι_comp_app B S hS n d s).symm

/-- **Along a flat morphism a morphism `g^*((𝓘')ⁿ) ⟶ 𝓘ⁿ` induced by pullback of regular
functions is a monomorphism.**  By `AlgebraicGeometry.Space.comp_ι_eq_of_isInducedByPullback`
its composite with the embedding `𝓘ⁿ ⊆ 𝒪_X` is the inverse image of the embedding
`(𝓘')ⁿ ⊆ 𝒪_{X'}`, injective because the inverse image along a flat morphism preserves
injections, followed by the isomorphism `g^*𝒪_{X'} ≅ 𝒪_X`. -/
theorem mono_of_isInducedByPullback_of_isFlat (hg : IsFlat B S hS g.hom) (n : ℤ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ) : Mono φ := by
  have h1 : Mono ((modulePullback B S hS g).map (kernelIdealSheafZPow B S hS i' n).ι) :=
    @Functor.map_mono _ _ _ _ (modulePullback B S hS g)
      (preservesMonomorphisms_modulePullback_of_isFlat B S hS g hg) _ _ _
      (SheafOfModules.Submodule.instMonoι _)
  have h2 : Mono (structureSheafMap B S hS g) :=
    @IsIso.mono_of_iso _ _ _ _ (structureSheafMap B S hS g) (isIso_structureSheafMap B S hS g)
  have h3 : Mono (φ ≫ (kernelIdealSheafZPow B S hS i n).ι) := by
    rw [comp_ι_eq_of_isInducedByPullback B S hS n φ hφ]
    exact @mono_comp _ _ _ _ _ _ h1 _ h2
  exact mono_of_mono _ (kernelIdealSheafZPow B S hS i n).ι

end Injectivity

section Invertibility

variable {i : Z ⟶ X} {i' : Z' ⟶ X'} {f : Z ⟶ Z'} {g : X ⟶ X'}

/-- **Invertibility near `Z` along a flat morphism: for flat `g` the inverse image `i^*φ` of a
morphism `g^*((𝓘')ⁿ) ⟶ 𝓘ⁿ` induced by pullback of regular functions is an isomorphism**, for a
cartesian square with `i'` an immersion and `n ≥ 0`.

Along the étale inclusion `U ⟶ X` of `U = g⁻¹(X' ∖ ∂Z')` the inverse image of `φ` is an
epimorphism (`AlgebraicGeometry.Space.isLocallySurjectiveAt_of_isPullback`) and a monomorphism,
because `φ` is (`AlgebraicGeometry.Space.mono_of_isInducedByPullback_of_isFlat`) and an étale
morphism is flat; the category of modules is balanced, and `i` factors through `U`. -/
theorem isIso_modulePullback_map_of_isPullback_of_isFlat (sq : IsPullback i f g i')
    (hi' : IsImmersion B S hS i'.hom) (hg : IsFlat B S hS g.hom) (n : ℕ)
    (φ : (modulePullback B S hS g).obj (kernelIdealSheafZPow B S hS i' n).toSheafOfModules ⟶
      (kernelIdealSheafZPow B S hS i n).toSheafOfModules)
    (hφ : IsInducedByPullback B S hS i i' g n φ) :
    IsIso ((modulePullback B S hS i).map φ) := by
  have he := epi_modulePullback_map_of_isLocallySurjectiveAt B S hS
    (immersionAmbientPreimageι B S hS i' hi' g)
    (isEtale_immersionAmbientPreimageι B S hS i' hi' g) φ
    (isLocallySurjectiveAt_of_isPullback B S hS sq hi' n φ hφ)
  have hm : Mono ((modulePullback B S hS (immersionAmbientPreimageι B S hS i' hi' g)).map φ) :=
    @Functor.map_mono _ _ _ _ _ (preservesMonomorphisms_modulePullback_of_isFlat B S hS _
      (isFlat_of_isEtale B S hS (isEtale_immersionAmbientPreimageι B S hS i' hi' g))) _ _ _
      (mono_of_isInducedByPullback_of_isFlat B S hS hg n φ hφ)
  have hbal : Balanced (Modules.{u, u} B S hS (immersionAmbientPreimage B S hS i' hi' g).1
      (immersionAmbientPreimage B S hS i' hi' g).2) := by
    let : Abelian (Modules.{u, u} B S hS (immersionAmbientPreimage B S hS i' hi' g).1
        (immersionAmbientPreimage B S hS i' hi' g).2) :=
      @SheafOfModules.instAbelian _ _ _ _
        (smallEtaleRingedSite_hasSheafify B S hS _ (immersionAmbientPreimage B S hS i' hi' g).2)
        (smallEtaleRingedSite_wEqualsLocallyBijective B S hS _
          (immersionAmbientPreimage B S hS i' hi' g).2)
    exact Stacks.SheafOfModules.ImageSubsheaf.balanced_of_abelian
  have h := isIso_modulePullback_comp_map B S hS (immersionAmbientPreimageLift B S hS i' hi' g sq)
    (immersionAmbientPreimageι B S hS i' hi' g) φ (@isIso_of_mono_of_epi _ _ hbal _ _ _ hm he)
  rwa [immersionAmbientPreimageLift_comp] at h

end Invertibility

