module

public import StacksFrontier.AlgebraicGeometry.SectionProduct.BijStalk
public import StacksFrontier.AlgebraicGeometry.SectionProduct.Basic
public import StacksFrontier.AlgebraicGeometry.SectionRingGeometric.UnitScalar

/-!
# Multiples of a stalk element, and multiplication by a section

Let `X` be a scheme, `φ : M ⟶ N` a morphism of `𝒪_X`-modules, `x` a point and `r ∈ 𝒪_{X,x}`.
This file studies the two inclusions between the image of the stalk map `φ_x` and the submodule
`r · N_x` of the `r`-multiples: `StalkMulLE φ x r` says that every value of `φ_x` is an
`r`-multiple, and `StalkMulGE φ x r` that every `r`-multiple is a value; together they say that
the image of `φ_x` is exactly `r · N_x`. For `r = 1` the second is the surjectivity
`Stacks.SectionProduct.SurjStalk` of the sibling file
`StacksFrontier/AlgebraicGeometry/SectionProduct/Stalk.lean`, whose route this file follows: both
conditions are stable under tensoring on either side with an arbitrary module, and therefore
under multiplication `Stacks.GradedSections.mulMap s m` by a section `s` of a tensor power.

For a morphism out of the monoidal unit, that is a global section of `F`, both conditions are
statements about the germ of that global section alone, because the stalk of the monoidal unit
is generated by the germ of its unit section.

## Main definitions

* `Stacks.SectionProduct.StalkMulLE`, `Stacks.SectionProduct.StalkMulGE`: the image of the stalk
  map of a morphism of `𝒪_X`-modules at `x` is contained in, respectively contains, `r · N_x`.
* `Stacks.SectionProduct.PStalkMulLE`, `Stacks.SectionProduct.PStalkMulGE`: the same for a
  morphism of presheaves of modules over the structure presheaf.

## Main results

* `Stacks.SectionProduct.StalkMulLE.whiskerLeft`, `Stacks.SectionProduct.StalkMulGE.whiskerLeft`,
  `Stacks.SectionProduct.StalkMulLE.whiskerRight`, `Stacks.SectionProduct.StalkMulGE.whiskerRight`:
  **tensoring with an arbitrary module preserves both conditions.**
* `Stacks.SectionProduct.stalkMulLE_comp_iff`, `Stacks.SectionProduct.stalkMulGE_comp_iff` and
  their variants: both conditions are unchanged by composing with a morphism that is bijective on
  stalks, in particular with an isomorphism.
* `Stacks.SectionProduct.stalkMulLE_mulMap`, `Stacks.SectionProduct.stalkMulGE_mulMap`:
  **multiplication by a section inherits both conditions from the section.**
* `Stacks.SectionProduct.stalkMulLE_unit_iff`, `Stacks.SectionProduct.stalkMulGE_unit_iff`: for a
  morphism `f : 𝟙_ X.Modules ⟶ F` with global section `g`, the image of `f_x` lies in `r · F_x`
  exactly when the germ of `g` is an `r`-multiple, and contains `r · F_x` exactly when every
  `r`-multiple is a multiple of the germ of `g`.
* `Stacks.SectionProduct.exists_smul_Γgerm_globalSection_id`: the stalk of the monoidal unit is
  generated by the germ of the global section of `𝟙 (𝟙_ X.Modules)`.

## Implementation notes

**Two module structures on one stalk.** The stalk of `M : X.Modules` carries the
`𝒪_{X,x}`-module structure `Stacks.ModuleStalk.stalkModule`, and the stalk of its underlying
presheaf of modules `Stacks.SectionProduct.pmod M` carries the one instance search finds for a
presheaf of modules over `X.presheaf`. The carriers are the same, but the two instances are not
definitionally equal at the transparency the module system allows. Both are pinned down by their
value on germs, and `Stacks.SectionProduct.smul_pmod` proves them equal that way; every
statement at the presheaf level is transported to `X.Modules` through it, in
`Stacks.SectionProduct.stalkMulLE_iff_pStalkMulLE` and its `GE` twin.

**Scalars are functions on an open.** At the presheaf level a scalar `r` of the stalk is written
as the germ of a function `c` on a neighbourhood, and every computation is done with `c` acting
on sections, where `c • (a ⊗ₜ q) = a ⊗ₜ (c • q)` holds in the sectionwise tensor product;
`Stacks.SectionProduct.pgerm_smul` returns to the stalk. Lemmas take the scalar as `r` together
with a proof that the germ of `c` is `r`, so that the two spellings of a germ map
(`ConcreteCategory.hom` and `CommRingCat.Hom.hom`) meet only in an `exact`.

**Elementary tensors of restricted sections are never rewritten.** As in the sibling file, a goal
mentioning `A.map i.op a ⊗ₜ Q.map i.op q` is not type-correct at the transparency `rw` uses, so
such steps are written as chains of `Eq.trans` with the tensor factors left to unification.

The passage through sheafification and through the monoidal `tensorLeft` uses only that the
sheafification unit is bijective on stalks
(`Stacks.SectionProduct.pstalkHom_toSheafify_bijective`) and linear
(`Stacks.SectionProduct.pstalkHom_smul`), and the naturality of
`Stacks.SheafInternalHom.tensorLeftIso`; no formula for the monoidality isomorphism of
sheafification on sections is needed.
-/

@[expose] public section

open CategoryTheory Category AlgebraicGeometry Opposite MonoidalCategory
  Stacks.SheafOfModules.TensorSheafification
open TopologicalSpace
open scoped TensorProduct
open Stacks.ModuleStalk

universe u

namespace Stacks.SectionProduct

variable {X : Scheme.{u}}

/-- The germ of a scalar multiple of a section of a presheaf of modules, for a scalar whose germ
is a given element `r` of the local ring. -/
theorem pgerm_smul (P : PresheafOfModulesOfCommRing.{u} X.presheaf) {U : X.Opens} {x : X}
    (hx : x ∈ U) {c : X.presheaf.obj (op U)} {r : X.presheaf.stalk x}
    (hr : (X.presheaf.germ U x hx).hom c = r) (t : P.obj (op U)) :
    pgerm P U x hx (c • t) = r • pgerm P U x hx t := by
  subst hr
  exact Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul X.toRingedSpace P x U
    hx c t

/-- `pstalkHom_smul` on a germ, for a scalar given by a function on the same open. -/
theorem pstalkHom_smul_pgerm {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q)
    {x : X} {W : X.Opens} (hxW : x ∈ W) {c : X.presheaf.obj (op W)} {r : X.presheaf.stalk x}
    (hr : (X.presheaf.germ W x hxW).hom c = r) (t : P.obj (op W)) :
    pstalkHom φ x (r • pgerm P W x hxW t) = r • pstalkHom φ x (pgerm P W x hxW t) := by
  rw [← pgerm_smul P hxW hr, pstalkHom_pgerm, pstalkHom_pgerm, map_smul]
  exact pgerm_smul Q hxW hr _

/-- The stalk map of a morphism of presheaves of modules is linear over the local ring. -/
theorem pstalkHom_smul {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q) (x : X)
    (r : X.presheaf.stalk x) (m : TopCat.Presheaf.stalk (C := Ab.{u}) P.presheaf x) :
    pstalkHom φ x (r • m) = r • pstalkHom φ x m := by
  obtain ⟨V, hxV, t, rfl⟩ := exists_pgerm_eq P m
  obtain ⟨W, hWV, hxW, c, hc⟩ := TopCat.Presheaf.exists_le_germ_eq X.presheaf r hxV
  let i : W ⟶ V := homOfLE hWV
  rw [← pgerm_res P i x hxW t]
  exact pstalkHom_smul_pgerm φ hxW hc (P.map i.op t)

/-! ### Multiples on stalks, at the presheaf level -/

/-- **Every value of the stalk map is an `r`-multiple**, for a morphism of presheaves of
modules. -/
def PStalkMulLE {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q) (x : X)
    (r : X.presheaf.stalk x) : Prop :=
  ∀ w, ∃ z, pstalkHom φ x w = r • z

/-- **Every `r`-multiple is a value of the stalk map**, for a morphism of presheaves of
modules. -/
def PStalkMulGE {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q) (x : X)
    (r : X.presheaf.stalk x) : Prop :=
  ∀ z, ∃ w, pstalkHom φ x w = r • z

/-- The germ of an elementary tensor whose second factor is a scalar multiple is a scalar
multiple: `c • (a ⊗ₜ q) = a ⊗ₜ (c • q)` on sections. -/
theorem pgerm_tmul_smul (A Q : PresheafOfModulesOfCommRing.{u} X.presheaf) {W : X.Opens} {x : X}
    (hxW : x ∈ W) {c : X.presheaf.obj (op W)} {r : X.presheaf.stalk x}
    (hr : (X.presheaf.germ W x hxW).hom c = r) (a : A.obj (op W)) (q : Q.obj (op W)) :
    pgerm (PresheafOfModules.tensorObj A Q) W x hxW
        (a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)] (c • q)) =
      r • pgerm (PresheafOfModules.tensorObj A Q) W x hxW
        (a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)] q) :=
  (congrArg (pgerm (PresheafOfModules.tensorObj A Q) W x hxW) (TensorProduct.tmul_smul
    (R := (structureRingPresheaf X.presheaf).obj (op W))
    (R' := (structureRingPresheaf X.presheaf).obj (op W)) c a q)).trans
    (pgerm_smul (PresheafOfModules.tensorObj A Q) hxW hr _)

/-- If the germ of `q` is a value of the stalk map of `φ`, then the germ of `a ⊗ₜ q` is a value of
the stalk map of `PresheafOfModules.tensorHom (𝟙 A) φ`. This is the elementary-tensor step of
`Stacks.SectionProduct.pstalkHom_whiskerLeft_surjective`. -/
theorem pgerm_tmul_mem_range (A : PresheafOfModulesOfCommRing.{u} X.presheaf)
    {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q) (x : X) {U : X.Opens}
    (hxU : x ∈ U) (a : A.obj (op U)) (q : Q.obj (op U))
    (h : pgerm Q U x hxU q ∈ (pstalkHom φ x).range) :
    pgerm (PresheafOfModules.tensorObj A Q) U x hxU
        (a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op U)] q) ∈
      (pstalkHom (PresheafOfModules.tensorHom (𝟙 A) φ) x).range := by
  obtain ⟨ξ, hξ⟩ := h
  obtain ⟨U₁, hxU₁, p, rfl⟩ := exists_pgerm_eq P ξ
  obtain ⟨W, hxW, i₁, i₂, heq⟩ := pgerm_eq_exists Q x hxU₁ hxU (φ.app (op U₁) p) q
    ((pstalkHom_pgerm φ x U₁ hxU₁ p).symm.trans hξ)
  refine ⟨pgerm (PresheafOfModules.tensorObj A P) W x hxW
    (A.map i₂.op a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)] P.map i₁.op p), ?_⟩
  refine (pstalkHom_whiskerLeft_pgerm_tmul A φ x W hxW _ _).trans ?_
  refine Eq.trans (congrArg (fun z => pgerm (PresheafOfModules.tensorObj A Q) W x hxW
    (A.map i₂.op a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)] z)) ?_)
    (pgerm_tmul_res A Q i₂ x hxW a q)
  exact (PresheafOfModules.naturality_apply φ i₁.op p).trans heq

/-- If the germ of `q` is an `r`-multiple, so is the germ of `a ⊗ₜ q`. -/
theorem exists_pgerm_tmul_eq_smul (A Q : PresheafOfModulesOfCommRing.{u} X.presheaf) {x : X}
    {U : X.Opens} (hxU : x ∈ U) (r : X.presheaf.stalk x) (a : A.obj (op U)) (q : Q.obj (op U))
    (h : ∃ z, pgerm Q U x hxU q = r • z) :
    ∃ z, pgerm (PresheafOfModules.tensorObj A Q) U x hxU
        (a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op U)] q) = r • z := by
  obtain ⟨z, hz⟩ := h
  obtain ⟨V, hxV, q', rfl⟩ := exists_pgerm_eq Q z
  obtain ⟨V', hV'V, hxV', c, hc⟩ := TopCat.Presheaf.exists_le_germ_eq X.presheaf r hxV
  let i : V' ⟶ V := homOfLE hV'V
  have h1 : pgerm Q U x hxU q = pgerm Q V' x hxV' (c • Q.map i.op q') :=
    hz.trans ((congrArg (r • ·) (pgerm_res Q i x hxV' q').symm).trans
      (pgerm_smul Q hxV' hc _).symm)
  obtain ⟨W, hxW, iU, iV, heq⟩ := pgerm_eq_exists Q x hxU hxV' q _ h1
  have hcW : (X.presheaf.germ W x hxW).hom (X.presheaf.map iV.op c) = r :=
    (TopCat.Presheaf.germ_res_apply X.presheaf iV x hxW c).trans hc
  refine ⟨pgerm (PresheafOfModules.tensorObj A Q) W x hxW
    (A.map iU.op a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)]
      Q.map iV.op (Q.map i.op q')), ?_⟩
  refine (pgerm_tmul_res A Q iU x hxW a q).symm.trans ?_
  refine Eq.trans (congrArg (fun z => pgerm (PresheafOfModules.tensorObj A Q) W x hxW
    (A.map iU.op a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)] z)) ?_)
    (pgerm_tmul_smul A Q hxW hcW _ _)
  exact heq.trans (PresheafOfModules.map_smul Q iV.op c _)

/-- If every `r`-multiple is a value of the stalk map of `φ`, then `r` times the germ of `a ⊗ₜ q`
is a value of the stalk map of `PresheafOfModules.tensorHom (𝟙 A) φ`. -/
theorem smul_pgerm_tmul_mem_range (A : PresheafOfModulesOfCommRing.{u} X.presheaf)
    {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q) (x : X) {U : X.Opens}
    (hxU : x ∈ U) (r : X.presheaf.stalk x) (a : A.obj (op U)) (q : Q.obj (op U))
    (h : ∀ z, r • z ∈ (pstalkHom φ x).range) :
    r • pgerm (PresheafOfModules.tensorObj A Q) U x hxU
        (a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op U)] q) ∈
      (pstalkHom (PresheafOfModules.tensorHom (𝟙 A) φ) x).range := by
  obtain ⟨W, hWU, hxW, c, hc⟩ := TopCat.Presheaf.exists_le_germ_eq X.presheaf r hxU
  let i : W ⟶ U := homOfLE hWU
  have hq : pgerm Q W x hxW (c • Q.map i.op q) ∈ (pstalkHom φ x).range := by
    obtain ⟨w, hw⟩ := h (pgerm Q W x hxW (Q.map i.op q))
    exact ⟨w, hw.trans (pgerm_smul Q hxW hc _).symm⟩
  have key : r • pgerm (PresheafOfModules.tensorObj A Q) U x hxU
        (a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op U)] q) =
      pgerm (PresheafOfModules.tensorObj A Q) W x hxW
        (A.map i.op a ⊗ₜ[(structureRingPresheaf X.presheaf).obj (op W)] (c • Q.map i.op q)) :=
    ((pgerm_tmul_smul A Q hxW hc (A.map i.op a) (Q.map i.op q)).trans
      (congrArg (r • ·) (pgerm_tmul_res A Q i x hxW a q))).symm
  rw [key]
  exact pgerm_tmul_mem_range A φ x hxW _ _ hq

/-- **Tensoring on the left preserves "every value is an `r`-multiple", at the presheaf
level.** -/
theorem PStalkMulLE.whiskerLeft (A : PresheafOfModulesOfCommRing.{u} X.presheaf)
    {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} {φ : P ⟶ Q} {x : X}
    {r : X.presheaf.stalk x} (h : PStalkMulLE φ x r) :
    PStalkMulLE (PresheafOfModules.tensorHom (𝟙 A) φ) x r := by
  intro w
  obtain ⟨U, hxU, t, rfl⟩ := exists_pgerm_eq (PresheafOfModules.tensorObj A P) w
  induction t using TensorProduct.inductionOn with
  | tmul a p =>
    obtain ⟨z, hz⟩ := exists_pgerm_tmul_eq_smul A Q hxU r a (φ.app (op U) p)
      (by
        obtain ⟨z, hz⟩ := h (pgerm P U x hxU p)
        exact ⟨z, (pstalkHom_pgerm φ x U hxU p).symm.trans hz⟩)
    exact ⟨z, (pstalkHom_whiskerLeft_pgerm_tmul A φ x U hxU a p).trans hz⟩
  | add t t' ht ht' =>
    obtain ⟨z, hz⟩ := ht
    obtain ⟨z', hz'⟩ := ht'
    refine ⟨z + z', ?_⟩
    refine (congrArg (pstalkHom (PresheafOfModules.tensorHom (𝟙 A) φ) x)
      (map_add (pgerm (PresheafOfModules.tensorObj A P) U x hxU) t t')).trans ?_
    exact (map_add _ _ _).trans ((congrArg₂ (· + ·) hz hz').trans (smul_add r z z').symm)

/-- **Tensoring on the left preserves "every `r`-multiple is a value", at the presheaf
level.** -/
theorem PStalkMulGE.whiskerLeft (A : PresheafOfModulesOfCommRing.{u} X.presheaf)
    {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} {φ : P ⟶ Q} {x : X}
    {r : X.presheaf.stalk x} (h : PStalkMulGE φ x r) :
    PStalkMulGE (PresheafOfModules.tensorHom (𝟙 A) φ) x r := by
  have h' : ∀ z, r • z ∈ (pstalkHom φ x).range := fun z => by
    obtain ⟨w, hw⟩ := h z
    exact ⟨w, hw⟩
  suffices H : ∀ z, r • z ∈ (pstalkHom (PresheafOfModules.tensorHom (𝟙 A) φ) x).range by
    intro z
    obtain ⟨w, hw⟩ := H z
    exact ⟨w, hw⟩
  intro z
  obtain ⟨U, hxU, t, rfl⟩ := exists_pgerm_eq (PresheafOfModules.tensorObj A Q) z
  induction t using TensorProduct.inductionOn with
  | tmul a q => exact smul_pgerm_tmul_mem_range A φ x hxU r a q h'
  | add t t' ht ht' =>
    have e : r • pgerm (PresheafOfModules.tensorObj A Q) U x hxU (t + t') =
        r • pgerm (PresheafOfModules.tensorObj A Q) U x hxU t +
          r • pgerm (PresheafOfModules.tensorObj A Q) U x hxU t' :=
      (congrArg (r • ·) (map_add (pgerm (PresheafOfModules.tensorObj A Q) U x hxU) t t')).trans
        (smul_add _ _ _)
    exact e ▸ add_mem ht ht'

/-- The sheafification unit intertwines a morphism of presheaves of modules with its
sheafification, on stalks. -/
theorem pstalkHom_sheafify_map_toSheafify
    {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q) (x : X)
    (v : TopCat.Presheaf.stalk (C := Ab.{u}) P.presheaf x) :
    pstalkHom ((forgetFun X).map ((sheafify X.presheaf (hStruct X)).map φ)) x
        (pstalkHom (toSheafify X.presheaf (hStruct X) P) x v) =
      pstalkHom (toSheafify X.presheaf (hStruct X) Q) x (pstalkHom φ x v) := by
  have hnat : φ ≫ toSheafify X.presheaf (hStruct X) Q =
      toSheafify X.presheaf (hStruct X) P ≫
        (forgetFun X).map ((sheafify X.presheaf (hStruct X)).map φ) :=
    (sheafifyAdjunction X.presheaf (hStruct X)).unit.naturality φ
  have l := pstalkHom_comp (toSheafify X.presheaf (hStruct X) P)
    ((forgetFun X).map ((sheafify X.presheaf (hStruct X)).map φ)) x v
  have r := pstalkHom_comp φ (toSheafify X.presheaf (hStruct X) Q) x v
  have e := congrArg
    (fun α : P ⟶ (forgetFun X).obj ((sheafify X.presheaf (hStruct X)).obj Q) =>
      pstalkHom α x v) hnat
  exact l.symm.trans (e.symm.trans r)

/-- **Sheafification preserves "every value is an `r`-multiple".** -/
theorem PStalkMulLE.sheafify_map {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} {φ : P ⟶ Q}
    {x : X} {r : X.presheaf.stalk x} (h : PStalkMulLE φ x r) :
    PStalkMulLE ((forgetFun X).map ((sheafify X.presheaf (hStruct X)).map φ)) x r := by
  intro w
  obtain ⟨v, rfl⟩ := (pstalkHom_toSheafify_bijective P x).2 w
  obtain ⟨z, hz⟩ := h v
  exact ⟨pstalkHom (toSheafify X.presheaf (hStruct X) Q) x z,
    (pstalkHom_sheafify_map_toSheafify φ x v).trans
      ((congrArg _ hz).trans (pstalkHom_smul _ x r z))⟩

/-- **Sheafification preserves "every `r`-multiple is a value".** -/
theorem PStalkMulGE.sheafify_map {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} {φ : P ⟶ Q}
    {x : X} {r : X.presheaf.stalk x} (h : PStalkMulGE φ x r) :
    PStalkMulGE ((forgetFun X).map ((sheafify X.presheaf (hStruct X)).map φ)) x r := by
  intro z'
  obtain ⟨z, rfl⟩ := (pstalkHom_toSheafify_bijective Q x).2 z'
  obtain ⟨v, hv⟩ := h z
  exact ⟨pstalkHom (toSheafify X.presheaf (hStruct X) P) x v,
    (pstalkHom_sheafify_map_toSheafify φ x v).trans
      ((congrArg _ hv).trans (pstalkHom_smul _ x r z))⟩

/-! ### Multiples on stalks of modules on a scheme -/

/-- The underlying presheaf of modules of an `𝒪_X`-module, over the structure presheaf of
commutative rings. -/
noncomputable abbrev pmod (M : X.Modules) : PresheafOfModulesOfCommRing.{u} X.presheaf :=
  (forgetFun X).obj M

/-- **The two module structures on a stalk of an `𝒪_X`-module agree**: the one of
`Stacks.ModuleStalk.stalkModule` and the one on the stalk of the underlying presheaf of modules.
They are not definitionally equal, but both are characterized by their value on germs. -/
theorem smul_pmod (M : X.Modules) (x : X) (r : X.presheaf.stalk x)
    (z : TopCat.Presheaf.stalk (C := Ab.{u}) (pmod M).presheaf x) :
    r • z = (r • (@id (TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) z) :
      TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) := by
  obtain ⟨U, hx, t, rfl⟩ := exists_pgerm_eq (pmod M) z
  obtain ⟨V, hVU, hxV, c, rfl⟩ := TopCat.Presheaf.exists_le_germ_eq X.presheaf r hx
  let i : V ⟶ U := homOfLE hVU
  rw [← pgerm_res (pmod M) i x hxV t]
  exact (pgerm_smul (pmod M) hxV rfl _).symm.trans
    (Stacks.ModuleStalk.germ_smul M x V hxV c ((pmod M).map i.op t))

section SheafLevel

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

/-- **Every value of the stalk map at `x` is an `r`-multiple**, for a morphism of
`𝒪_X`-modules and `r ∈ 𝒪_{X,x}`: the image of `φ_x` is contained in `r · N_x`. -/
def StalkMulLE {M N : X.Modules} (φ : M ⟶ N) (x : X) (r : X.presheaf.stalk x) : Prop :=
  ∀ w, ∃ z, Stacks.ModuleStalk.mapFun φ x w = r • z

/-- **Every `r`-multiple is a value of the stalk map at `x`**, for a morphism of `𝒪_X`-modules
and `r ∈ 𝒪_{X,x}`: the image of `φ_x` contains `r · N_x`. -/
def StalkMulGE {M N : X.Modules} (φ : M ⟶ N) (x : X) (r : X.presheaf.stalk x) : Prop :=
  ∀ z, ∃ w, Stacks.ModuleStalk.mapFun φ x w = r • z

variable {M N K : X.Modules} {x : X} {r : X.presheaf.stalk x}

/-- `StalkMulLE` is `PStalkMulLE` of the underlying morphism of presheaves of modules: the two
module structures on the stalks agree by `smul_pmod`. -/
theorem stalkMulLE_iff_pStalkMulLE (φ : M ⟶ N) :
    StalkMulLE φ x r ↔ PStalkMulLE ((forgetFun X).map φ) x r :=
  ⟨fun h w => let ⟨z, hz⟩ := h w; ⟨z, hz.trans (smul_pmod N x r z).symm⟩,
    fun h w => let ⟨z, hz⟩ := h w; ⟨z, hz.trans (smul_pmod N x r z)⟩⟩

/-- `StalkMulGE` is `PStalkMulGE` of the underlying morphism of presheaves of modules. -/
theorem stalkMulGE_iff_pStalkMulGE (φ : M ⟶ N) :
    StalkMulGE φ x r ↔ PStalkMulGE ((forgetFun X).map φ) x r :=
  ⟨fun h z => let ⟨w, hw⟩ := h z; ⟨w, hw.trans (smul_pmod N x r z).symm⟩,
    fun h z => let ⟨w, hw⟩ := h z; ⟨w, hw.trans (smul_pmod N x r z)⟩⟩

/-- Transport of `StalkMulLE` along an equality of morphisms. -/
theorem stalkMulLE_congr {φ ψ : M ⟶ N} (h : φ = ψ) (hφ : StalkMulLE φ x r) :
    StalkMulLE ψ x r := h ▸ hφ

/-- Transport of `StalkMulGE` along an equality of morphisms. -/
theorem stalkMulGE_congr {φ ψ : M ⟶ N} (h : φ = ψ) (hφ : StalkMulGE φ x r) :
    StalkMulGE ψ x r := h ▸ hφ

/-- Post-composing with any morphism preserves "every value is an `r`-multiple". -/
theorem StalkMulLE.comp_right {φ : M ⟶ N} (h : StalkMulLE φ x r) (ψ : N ⟶ K) :
    StalkMulLE (φ ≫ ψ) x r := fun w => by
  obtain ⟨z, hz⟩ := h w
  exact ⟨Stacks.ModuleStalk.mapFun ψ x z, by rw [mapFun_comp, hz, mapFun_smul]⟩

/-- Pre-composing with any morphism preserves "every value is an `r`-multiple". -/
theorem StalkMulLE.comp_left (e : K ⟶ M) {φ : M ⟶ N} (h : StalkMulLE φ x r) :
    StalkMulLE (e ≫ φ) x r := fun w => by
  obtain ⟨z, hz⟩ := h (Stacks.ModuleStalk.mapFun e x w)
  exact ⟨z, by rw [mapFun_comp]; exact hz⟩

/-- Cancelling a stalkwise bijection off the right of a composite. -/
theorem StalkMulLE.of_comp_right {φ : M ⟶ N} {e : N ⟶ K} (he : BijStalk e x)
    (h : StalkMulLE (φ ≫ e) x r) : StalkMulLE φ x r := fun w => by
  have he' : Function.Bijective (Stacks.ModuleStalk.mapFun e x) := he
  obtain ⟨z, hz⟩ := h w
  obtain ⟨z', rfl⟩ := he'.2 z
  exact ⟨z', he'.1 (by rw [← mapFun_comp, hz, mapFun_smul])⟩

/-- Cancelling a stalkwise surjection off the left of a composite. -/
theorem StalkMulLE.of_comp_left {e : K ⟶ M} {φ : M ⟶ N} (he : SurjStalk e x)
    (h : StalkMulLE (e ≫ φ) x r) : StalkMulLE φ x r := fun w => by
  obtain ⟨v, rfl⟩ := he w
  obtain ⟨z, hz⟩ := h v
  exact ⟨z, by rw [← mapFun_comp]; exact hz⟩

/-- Post-composing with a stalkwise surjection preserves "every `r`-multiple is a value". -/
theorem StalkMulGE.comp_right {φ : M ⟶ N} (h : StalkMulGE φ x r) {ψ : N ⟶ K}
    (hψ : SurjStalk ψ x) : StalkMulGE (φ ≫ ψ) x r := fun z'' => by
  obtain ⟨z, rfl⟩ := hψ z''
  obtain ⟨w, hw⟩ := h z
  exact ⟨w, by rw [mapFun_comp, hw, mapFun_smul]⟩

/-- Pre-composing with a stalkwise surjection preserves "every `r`-multiple is a value". -/
theorem StalkMulGE.comp_left {e : K ⟶ M} (he : SurjStalk e x) {φ : M ⟶ N}
    (h : StalkMulGE φ x r) : StalkMulGE (e ≫ φ) x r := fun z => by
  obtain ⟨w, hw⟩ := h z
  obtain ⟨v, rfl⟩ := he w
  exact ⟨v, by rw [mapFun_comp]; exact hw⟩

/-- Cancelling a stalkwise bijection off the right of a composite. -/
theorem StalkMulGE.of_comp_right {φ : M ⟶ N} {e : N ⟶ K} (he : BijStalk e x)
    (h : StalkMulGE (φ ≫ e) x r) : StalkMulGE φ x r := fun z => by
  have he' : Function.Bijective (Stacks.ModuleStalk.mapFun e x) := he
  obtain ⟨w, hw⟩ := h (Stacks.ModuleStalk.mapFun e x z)
  exact ⟨w, he'.1 (by rw [← mapFun_comp, hw, mapFun_smul])⟩

/-- Cancelling any morphism off the left of a composite. -/
theorem StalkMulGE.of_comp_left (e : K ⟶ M) {φ : M ⟶ N} (h : StalkMulGE (e ≫ φ) x r) :
    StalkMulGE φ x r := fun z => by
  obtain ⟨v, hv⟩ := h z
  exact ⟨Stacks.ModuleStalk.mapFun e x v, by rw [← mapFun_comp]; exact hv⟩

/-- Post-composition with a stalkwise bijection does not change "every value is an
`r`-multiple". -/
theorem stalkMulLE_comp_iff {φ : M ⟶ N} {e : N ⟶ K} (he : BijStalk e x) :
    StalkMulLE (φ ≫ e) x r ↔ StalkMulLE φ x r :=
  ⟨StalkMulLE.of_comp_right he, fun h => h.comp_right e⟩

/-- Pre-composition with a stalkwise bijection does not change "every value is an
`r`-multiple". -/
theorem stalkMulLE_comp_left_iff {e : K ⟶ M} {φ : M ⟶ N} (he : BijStalk e x) :
    StalkMulLE (e ≫ φ) x r ↔ StalkMulLE φ x r :=
  ⟨StalkMulLE.of_comp_left he.2, StalkMulLE.comp_left e⟩

/-- Post-composition with a stalkwise bijection does not change "every `r`-multiple is a
value". -/
theorem stalkMulGE_comp_iff {φ : M ⟶ N} {e : N ⟶ K} (he : BijStalk e x) :
    StalkMulGE (φ ≫ e) x r ↔ StalkMulGE φ x r :=
  ⟨StalkMulGE.of_comp_right he, fun h => h.comp_right he.2⟩

/-- Pre-composition with a stalkwise bijection does not change "every `r`-multiple is a
value". -/
theorem stalkMulGE_comp_left_iff {e : K ⟶ M} {φ : M ⟶ N} (he : BijStalk e x) :
    StalkMulGE (e ≫ φ) x r ↔ StalkMulGE φ x r :=
  ⟨StalkMulGE.of_comp_left e, StalkMulGE.comp_left he.2⟩

/-- `Stacks.SectionProduct.stalkMulLE_comp_iff` for an isomorphism. -/
theorem stalkMulLE_comp_iso_iff {φ : M ⟶ N} (e : N ≅ K) :
    StalkMulLE (φ ≫ e.hom) x r ↔ StalkMulLE φ x r :=
  stalkMulLE_comp_iff (bijStalk_of_isIso e.hom x)

/-- `Stacks.SectionProduct.stalkMulLE_comp_left_iff` for an isomorphism. -/
theorem stalkMulLE_iso_comp_iff (e : K ≅ M) {φ : M ⟶ N} :
    StalkMulLE (e.hom ≫ φ) x r ↔ StalkMulLE φ x r :=
  stalkMulLE_comp_left_iff (bijStalk_of_isIso e.hom x)

/-- `Stacks.SectionProduct.stalkMulGE_comp_iff` for an isomorphism. -/
theorem stalkMulGE_comp_iso_iff {φ : M ⟶ N} (e : N ≅ K) :
    StalkMulGE (φ ≫ e.hom) x r ↔ StalkMulGE φ x r :=
  stalkMulGE_comp_iff (bijStalk_of_isIso e.hom x)

/-- `Stacks.SectionProduct.stalkMulGE_comp_left_iff` for an isomorphism. -/
theorem stalkMulGE_iso_comp_iff (e : K ≅ M) {φ : M ⟶ N} :
    StalkMulGE (e.hom ≫ φ) x r ↔ StalkMulGE φ x r :=
  stalkMulGE_comp_left_iff (bijStalk_of_isIso e.hom x)

/-- **Sheafification preserves "every value is an `r`-multiple"**, in the `Scheme.Modules`
spelling. -/
theorem stalkMulLE_sheafify_map {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q)
    (h : PStalkMulLE φ x r) :
    StalkMulLE (M := (sheafify X.presheaf (hStruct X)).obj P)
      (N := (sheafify X.presheaf (hStruct X)).obj Q)
      ((sheafify X.presheaf (hStruct X)).map φ) x r :=
  (stalkMulLE_iff_pStalkMulLE _).2 h.sheafify_map

/-- **Sheafification preserves "every `r`-multiple is a value"**, in the `Scheme.Modules`
spelling. -/
theorem stalkMulGE_sheafify_map {P Q : PresheafOfModulesOfCommRing.{u} X.presheaf} (φ : P ⟶ Q)
    (h : PStalkMulGE φ x r) :
    StalkMulGE (M := (sheafify X.presheaf (hStruct X)).obj P)
      (N := (sheafify X.presheaf (hStruct X)).obj Q)
      ((sheafify X.presheaf (hStruct X)).map φ) x r :=
  (stalkMulGE_iff_pStalkMulGE _).2 h.sheafify_map

/-- **Tensoring on the left preserves "every value is an `r`-multiple".** The monoidal
`tensorLeft` is the sheafified sectionwise tensor product, by
`Stacks.SheafInternalHom.tensorLeftIso`. -/
theorem StalkMulLE.whiskerLeft (A : X.Modules) {M N : X.Modules} (f : M ⟶ N) {x : X}
    {r : X.presheaf.stalk x} (h : StalkMulLE f x r) : StalkMulLE (A ◁ f) x r := by
  set e := Stacks.SheafInternalHom.tensorLeftIso X.presheaf (hStruct X) A with he
  refine StalkMulLE.of_comp_right
    (bijStalk_of_hom_inv (e.hom_inv_id_app N) (e.inv_hom_id_app N) x) ?_
  refine stalkMulLE_congr (e.hom.naturality f).symm ?_
  exact StalkMulLE.comp_left _ (stalkMulLE_sheafify_map _
    (PStalkMulLE.whiskerLeft _ ((stalkMulLE_iff_pStalkMulLE f).1 h)))

/-- **Tensoring on the left preserves "every `r`-multiple is a value".** -/
theorem StalkMulGE.whiskerLeft (A : X.Modules) {M N : X.Modules} (f : M ⟶ N) {x : X}
    {r : X.presheaf.stalk x} (h : StalkMulGE f x r) : StalkMulGE (A ◁ f) x r := by
  set e := Stacks.SheafInternalHom.tensorLeftIso X.presheaf (hStruct X) A with he
  refine StalkMulGE.of_comp_right
    (bijStalk_of_hom_inv (e.hom_inv_id_app N) (e.inv_hom_id_app N) x) ?_
  refine stalkMulGE_congr (e.hom.naturality f).symm ?_
  exact StalkMulGE.comp_left (surjStalk_of_inv (e.inv_hom_id_app M) x)
    (stalkMulGE_sheafify_map _ (PStalkMulGE.whiskerLeft _ ((stalkMulGE_iff_pStalkMulGE f).1 h)))

/-- Whiskering on the left is whiskering on the right conjugated by the braidings. -/
private theorem whiskerLeft_eq_braiding_comp {M N : X.Modules} (A : X.Modules) (f : M ⟶ N) :
    A ◁ f = (β_ A M).hom ≫ (f ▷ A) ≫ (β_ A N).inv := by
  rw [← Category.assoc, ← BraidedCategory.braiding_naturality_right A f,
    Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- **Tensoring on the right preserves "every value is an `r`-multiple"**, by the braiding. -/
theorem StalkMulLE.whiskerRight {M N : X.Modules} (f : M ⟶ N) (A : X.Modules) {x : X}
    {r : X.presheaf.stalk x} (h : StalkMulLE f x r) : StalkMulLE (f ▷ A) x r := by
  have hb := whiskerLeft_eq_braiding_comp A f
  exact StalkMulLE.of_comp_right
    (bijStalk_of_hom_inv (β_ A N).inv_hom_id (β_ A N).hom_inv_id x)
    (StalkMulLE.of_comp_left (surjStalk_of_inv (β_ A M).inv_hom_id x)
      (stalkMulLE_congr hb (StalkMulLE.whiskerLeft A f h)))

/-- **Tensoring on the right preserves "every `r`-multiple is a value"**, by the braiding. -/
theorem StalkMulGE.whiskerRight {M N : X.Modules} (f : M ⟶ N) (A : X.Modules) {x : X}
    {r : X.presheaf.stalk x} (h : StalkMulGE f x r) : StalkMulGE (f ▷ A) x r := by
  have hb := whiskerLeft_eq_braiding_comp A f
  exact StalkMulGE.of_comp_right
    (bijStalk_of_hom_inv (β_ A N).inv_hom_id (β_ A N).hom_inv_id x)
    (StalkMulGE.of_comp_left (β_ A M).hom
      (stalkMulGE_congr hb (StalkMulGE.whiskerLeft A f h)))

end SheafLevel

/-! ### Multiplication by a section -/

section MulMap

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

attribute [local implicit_reducible] Stacks.TensorPowers.natTensorPow

/-- **Multiplication by a section has image inside `r · (L ^⊗ (n + m))_x` wherever the section
has image inside `r · (L ^⊗ n)_x`.** -/
theorem stalkMulLE_mulMap (L : X.Modules) {n : ℕ} (s : Stacks.GradedSections.powSections L n)
    {x : X} {r : X.presheaf.stalk x} (h : StalkMulLE s x r) (m : ℕ) :
    StalkMulLE (Stacks.GradedSections.mulMap s m) x r := by
  induction m with
  | zero => exact h
  | succ m ih => exact StalkMulLE.whiskerRight (Stacks.GradedSections.mulMap s m) L ih

/-- **Multiplication by a section has image containing `r · (L ^⊗ (n + m))_x` wherever the
section has image containing `r · (L ^⊗ n)_x`.** -/
theorem stalkMulGE_mulMap (L : X.Modules) {n : ℕ} (s : Stacks.GradedSections.powSections L n)
    {x : X} {r : X.presheaf.stalk x} (h : StalkMulGE s x r) (m : ℕ) :
    StalkMulGE (Stacks.GradedSections.mulMap s m) x r := by
  induction m with
  | zero => exact h
  | succ m ih => exact StalkMulGE.whiskerRight (Stacks.GradedSections.mulMap s m) L ih

end MulMap

/-! ### Morphisms out of the monoidal unit -/

section Unit

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

open Stacks.SectionRingGeometric in
/-- The stalk of the free rank-one module `𝒪_X` is generated by the germ of the section `1`. -/
theorem exists_smul_Γgerm_unitOne (x : X)
    (v : TopCat.Presheaf.stalk (C := Ab.{u}) (unitModule X).presheaf x) :
    ∃ c : X.presheaf.stalk x, v = c • ((unitModule X).presheaf.Γgerm x).hom (unitOne X) := by
  obtain ⟨U, hx, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq (unitModule X).presheaf v
  refine ⟨(X.presheaf.germ U x hx).hom (show Γ(X, U) from t), ?_⟩
  have ht : t = (show Γ(X, U) from t) •
      (unitModule X).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (unitOne X) := by
    change t = (show Γ(X, U) from t) * X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op 1
    rw [map_one, mul_one]
  rw [← TopCat.Presheaf.Γgerm_res_apply (i := homOfLE (le_top : U ≤ ⊤)) _ x hx,
    ← Stacks.ModuleStalk.germ_smul, ← ht]

open Stacks.SectionRingGeometric in
/-- **The stalk of the monoidal unit is generated by the germ of its unit section**, the global
section of `𝟙 (𝟙_ X.Modules)`. -/
theorem exists_smul_Γgerm_globalSection_id (x : X)
    (w : TopCat.Presheaf.stalk (C := Ab.{u}) (𝟙_ X.Modules).presheaf x) :
    ∃ c : X.presheaf.stalk x, w = c • ((𝟙_ X.Modules).presheaf.Γgerm x).hom
      (globalSection X (𝟙_ X.Modules) (𝟙 (𝟙_ X.Modules))) := by
  obtain ⟨c, hc⟩ := exists_smul_Γgerm_unitOne x
    (Stacks.ModuleStalk.mapFun (unitComparison X).hom x w)
  have hg : ((𝟙_ X.Modules).presheaf.Γgerm x).hom
      (globalSection X (𝟙_ X.Modules) (𝟙 (𝟙_ X.Modules))) =
      Stacks.ModuleStalk.mapFun (unitComparison X).inv x
        (((unitModule X).presheaf.Γgerm x).hom (unitOne X)) := by
    have hg0 : globalSection X (𝟙_ X.Modules) (𝟙 (𝟙_ X.Modules)) =
        (unitComparison X).inv.app ⊤ (unitOne X) := by
      change schemeGlobalSectionsAddEquiv X _ _ = _
      rw [schemeGlobalSectionsAddEquiv_apply, Category.comp_id]
    rw [mapFun_Γgerm, hg0]
  refine ⟨c, ?_⟩
  rw [hg, ← mapFun_smul, ← hc, ← mapFun_comp, Iso.hom_inv_id, mapFun_id]

/-- The stalk map of `f : 𝟙_ X.Modules ⟶ F` sends the germ of the unit section to the germ of the
global section of `f`. -/
private theorem mapFun_unit_Γgerm {F : X.Modules} (f : 𝟙_ X.Modules ⟶ F) (x : X) :
    Stacks.ModuleStalk.mapFun f x (((𝟙_ X.Modules).presheaf.Γgerm x).hom
        (globalSection X (𝟙_ X.Modules) (𝟙 (𝟙_ X.Modules)))) =
      (F.presheaf.Γgerm x).hom (globalSection X F f) := by
  rw [← Γgerm_globalSection_comp, Category.id_comp]

/-- **"Every value is an `r`-multiple", for a morphism out of the monoidal unit**: it holds
exactly when the germ of the global section is an `r`-multiple. -/
theorem stalkMulLE_unit_iff (F : X.Modules) (f : 𝟙_ X.Modules ⟶ F) (x : X)
    (r : X.presheaf.stalk x) :
    StalkMulLE f x r ↔ ∃ z, (F.presheaf.Γgerm x).hom (globalSection X F f) = r • z := by
  have key := mapFun_unit_Γgerm f x
  refine ⟨fun h => ?_, fun ⟨z, hz⟩ w => ?_⟩
  · obtain ⟨z, hz⟩ := h (((𝟙_ X.Modules).presheaf.Γgerm x).hom
      (globalSection X (𝟙_ X.Modules) (𝟙 (𝟙_ X.Modules))))
    exact ⟨z, key.symm.trans hz⟩
  · obtain ⟨c, rfl⟩ := exists_smul_Γgerm_globalSection_id x w
    exact ⟨c • z, by rw [mapFun_smul, key, hz, smul_comm]⟩

/-- **"Every `r`-multiple is a value", for a morphism out of the monoidal unit**: it holds
exactly when every `r`-multiple is a multiple of the germ of the global section. -/
theorem stalkMulGE_unit_iff (F : X.Modules) (f : 𝟙_ X.Modules ⟶ F) (x : X)
    (r : X.presheaf.stalk x) :
    StalkMulGE f x r ↔ ∀ z, ∃ c : X.presheaf.stalk x,
      c • (F.presheaf.Γgerm x).hom (globalSection X F f) = r • z := by
  have key := mapFun_unit_Γgerm f x
  refine ⟨fun h z => ?_, fun h z => ?_⟩
  · obtain ⟨w, hw⟩ := h z
    obtain ⟨c, rfl⟩ := exists_smul_Γgerm_globalSection_id x w
    exact ⟨c, by rw [← key, ← mapFun_smul]; exact hw⟩
  · obtain ⟨c, hc⟩ := h z
    exact ⟨c • _, by rw [mapFun_smul, key]; exact hc⟩

end Unit

end Stacks.SectionProduct

end
