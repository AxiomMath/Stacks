/-! ### The degree-one coordinates, containing a prescribed finite set -/

/-- **The coordinates of [Stacks, Tag 02NP], chosen to contain a prescribed finite set of
degree-one elements.** If the graded ring `A` is generated over `R` by its degree-one part then
every finite set `T` of elements of `A` consists of polynomials over `R` in finitely many
degree-one elements, and the finite family may be taken to contain any prescribed finite set `T'`
of degree-one elements.

This is `Stacks.CoordinateChoice.exists_fin_mem_adjoin_range` with `T'` adjoined to the index set.
The strengthening is what the coordinate cut needs: the overlap chart `α⁻¹(D₊(y⁰_i f_j))` lies
inside the pinning chart `α⁻¹(D₊(y_{i'}))` only when `y⁰_i` *is* `y_{i'}`, and membership of
`y⁰_i` in the subalgebra generated by the family does not give that. -/
theorem exists_fin_mem_adjoin_range_subset {R : Type*} {A : Type u} {σ : Type w} [CommRing R]
    [CommRing A] [Algebra R A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
    (hgen : Algebra.adjoin R ((𝒜 1 : σ) : Set A) = ⊤) (T T' : Finset A)
    (hT' : ∀ a ∈ T', a ∈ 𝒜 1) :
    ∃ (n : ℕ) (y : Fin (n + 1) → 𝒜 1), (∀ a ∈ T', ∃ i, ((y i : A)) = a) ∧
      ∀ t ∈ T, t ∈ Algebra.adjoin R (Set.range fun i => ((y i : A))) := by
  classical
  have hsub : ∀ t : A, ∃ u : Finset A, ↑u ⊆ ((𝒜 1 : σ) : Set A) ∧
      t ∈ Algebra.adjoin R (u : Set A) :=
    fun t => Stacks.CoordinateChoice.exists_finset_subset_adjoin
      (by rw [hgen]; exact Algebra.mem_top)
  choose u hu hmem using hsub
  set U : Finset A := T.biUnion u ∪ T' with hU
  obtain ⟨m, ⟨eqv⟩⟩ : ∃ m : ℕ, Nonempty (↥U ≃ Fin m) := ⟨_, ⟨Finite.equivFin _⟩⟩
  set y : Fin (m + 1) → A := Fin.lastCases 0 fun k => (eqv.symm k : A) with hy
  have hyval : ∀ (a : A) (ha : a ∈ U), y (eqv ⟨a, ha⟩).castSucc = a := by
    intro a ha
    simp only [hy, Fin.lastCases_castSucc, Equiv.symm_apply_apply]
  have hmemU : ∀ a ∈ U, a ∈ 𝒜 1 := by
    intro a ha
    rcases Finset.mem_union.mp ha with h | h
    · obtain ⟨t, _, hau⟩ := Finset.mem_biUnion.mp h
      simpa only [SetLike.mem_coe] using hu t hau
    · exact hT' a h
  have hyone : ∀ i, y i ∈ 𝒜 1 := by
    intro i
    refine Fin.lastCases ?_ (fun k => ?_) i
    · simpa only [hy, Fin.lastCases_last] using zero_mem (𝒜 1)
    · simpa only [hy, Fin.lastCases_castSucc] using hmemU _ (eqv.symm k).2
  refine ⟨m, fun i => ⟨y i, hyone i⟩,
    fun a ha => ⟨_, hyval a (Finset.mem_union_right _ ha)⟩, fun t ht => ?_⟩
  refine Algebra.adjoin_mono (fun a ha => ?_) (hmem t)
  have haU : a ∈ U := Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨t, ht, ha⟩)
  exact ⟨(eqv ⟨a, haU⟩).castSucc, hyval a haU⟩

/-! ### The closed immersion over a standard open, at a named open -/

/-- **`Stacks.OverlapSurjectivity.isClosedImmersion_morphismRestrict_basicOpen` with the standard
open of the image named.** The open `X_a` cut out of `W` by the image `a` of `t` occurs in the
types of the inverse and of the generation hypothesis, so it cannot be rewritten there; taking it
as a variable with a defining equation is the substitute. -/
theorem isClosedImmersion_morphismRestrict_basicOpen_of_eq {X Y : Scheme.{u}} (g : X ⟶ Y)
    {U : Y.Opens} {W : X.Opens} (hgU : g ⁻¹ᵁ U = W) (t : Γ(Y, U)) (hU : IsAffineOpen U)
    {C : X.Opens} (hC : X.basicOpen ((g.appLE U W hgU.ge).hom t) = C) (hCle : C ≤ W)
    (hCaff : IsAffineOpen C) {w : Γ(X, C)}
    (hw : resO hCle ((g.appLE U W hgU.ge).hom t) * w = 1)
    (hgen : Subring.closure (Set.range (fun z : Γ(Y, U) =>
        resO hCle ((g.appLE U W hgU.ge).hom z)) ∪ {w}) = ⊤) :
    IsClosedImmersion (g ∣_ Y.basicOpen t) := by
  subst hC
  exact Stacks.OverlapSurjectivity.isClosedImmersion_morphismRestrict_basicOpen g hgU t hU
    hCaff hw hgen

/-! ### The sections of the overlap chart -/

section Overlap

variable {S X : Scheme.{u}} (hS : IsAffineOpen (⊤ : S.Opens)) (E : S.Modules)
  [E.IsQuasicoherent] {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L]
  (α : X ⟶ AlgebraicGeometry.Proj ((symAlgebra E).grading (⊤ : S.Opens))) [IsImmersion α]

omit [IsImmersion α] in
/-- **The sections of the overlap chart of [Stacks, Tag 02NP] are generated by the base sections,
the coordinate ratios and one inverse.** Every section of `Γ(X, α⁻¹(D₊(g)))` lies in the subring
generated by the inverse images along the structure morphism of the sections of `𝒪_S`, the
restrictions of the coordinate ratios `s_m/s_i`, and the inverse image of `y_i^{dg}/g`.

The hypotheses are exactly what the choice supplies: `tt` is the finite set of fractions whose
images generate the chart over the base, by
`Stacks.CoordinateChoice.exists_finset_away_forall_mem_closure`, and `httnum` is the statement
that the numerator of each of them is a polynomial in the coordinates — which is what the second
choice of coordinates was made for. The transport of each generator is
`Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap_base`. -/
theorem mem_closure_overlap
    (hgen : Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      ((((symAlgebra E).grading (⊤ : S.Opens)) 1 :
        Set ((symAlgebra E).sectionRing (⊤ : S.Opens)))) = ⊤)
    (ee : pullbackTwistOne ((symAlgebra E).grading (⊤ : S.Opens)) α ≅ L)
    {ι : Type*} (Y : ι → ((symAlgebra E).grading (⊤ : S.Opens)) 1) (s : ι → Γ(L, ⊤))
    (hsy : ∀ j, s j =
      ee.hom.app ⊤ (coordSection ((symAlgebra E).grading (⊤ : S.Opens)) α (Y j))) (i : ι)
    {dg : ℕ} {g : (symAlgebra E).sectionRing (⊤ : S.Opens)}
    (hg : g ∈ (symAlgebra E).grading (⊤ : S.Opens) dg) (hdg : 0 < dg)
    (hgq : ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens)) g ≤
      ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        ((Y i : (symAlgebra E).sectionRing ⊤)))
    {f : X ⟶ S} (hf : α ≫ projStructureHom (symAlgebra E) hS = f)
    (hCtop : (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens)) g) ≤ f ⁻¹ᵁ ⊤)
    (hCq : (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
        ((symAlgebra E).grading (⊤ : S.Opens)) g) ≤
      α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        ((Y i : (symAlgebra E).sectionRing ⊤)))
    (tt : Finset (Away ((symAlgebra E).grading (⊤ : S.Opens)) g))
    (htt : ∀ v : Γ(X, α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
        ((symAlgebra E).grading (⊤ : S.Opens)) g), v ∈ Subring.closure
      (Set.range (f.appLE ⊤ (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
          ((symAlgebra E).grading (⊤ : S.Opens)) g) hCtop).hom ∪
        Stacks.CoordinateChoice.awayToChart ((symAlgebra E).grading (⊤ : S.Opens)) α g ''
          (tt : Set (Away ((symAlgebra E).grading (⊤ : S.Opens)) g))))
    (httnum : ∀ z ∈ tt, ∃ (k : ℕ) (b : (symAlgebra E).sectionRing (⊤ : S.Opens))
      (hb : b ∈ (symAlgebra E).grading (⊤ : S.Opens) (k • dg)),
      b ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
          (Set.range fun j => ((Y j : (symAlgebra E).sectionRing ⊤))) ∧
        Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hg k b hb = z)
    (v : Γ(X, α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens)) g)) :
    v ∈ Subring.closure
      ((Set.range (fun r : Γ(S, ⊤) => (f.appLE ⊤ (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
              ((symAlgebra E).grading (⊤ : S.Opens)) g) hCtop).hom r) ∪
          Set.range fun m =>
            resO (hCq.trans (preimage_basicOpen_le_nvCover
                ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee Y s hsy i))
              (ratio s i m)) ∪
        {pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α le_rfl
          (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hg 1
            ((Y i : (symAlgebra E).sectionRing ⊤) ^ dg)
            (by simpa using SetLike.pow_mem_graded dg (Y i).2))}) := by
  classical
  refine Subring.closure_le.mpr ?_ (htt v)
  rintro z (⟨r, rfl⟩ | ⟨z₀, hz₀, rfl⟩)
  · exact Subring.subset_closure
      (Set.mem_union_left _ (Set.mem_union_left _ ⟨r, rfl⟩))
  · obtain ⟨k, b, hb, hbmem, rfl⟩ := httnum z₀ hz₀
    have hb' : b ∈ (symAlgebra E).grading (⊤ : S.Opens) (k * dg) := by simpa using hb
    rw [Stacks.OverlapDictionary.awayToChart_eq_pullbackAway]
    exact Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap_base hS E α hgen ee Y s
      hsy i hg hdg hgq le_rfl hCq hf hCtop hb' hbmem

/-! ### The cutting section of the target chart -/

/-- **The cutting section of [Stacks, Tag 02NP].** On the chart `D₊(T_i) ⊓ pr⁻¹(⊤)` of `ℙⁿ_S`
there is a section `t` whose standard open pulls back along the pinned morphism `p` to the overlap
chart `α⁻¹(D₊(y_i f))`, and over which `p` is a closed immersion.

The section exists because the section cutting the overlap out of the coordinate chart is in the
range of `p` on sections: it is the inverse image of the degree-zero fraction `y_i f / y_i^{1+d}`,
which `Stacks.CoefficientBridge.pullbackAway_mk_mem_closure_base` exhibits as a polynomial in the
coordinate ratios with base-section coefficients, and
`Stacks.ChartDictionary.appLE_baseSection` and `Stacks.ChartDictionary.appLE_chartCoordChart` say
those are reached. That its standard open is the overlap chart is
`Stacks.ProjChartBasicOpen.basicOpen_appLE_awayToSection_mk` together with
`Stacks.OverlapChart.preimage_basicOpen_inf_mul`, and the closed immersion is
`Stacks.OverlapSurjectivity.isClosedImmersion_morphismRestrict_basicOpen` fed by `hallgen`. -/
theorem exists_cuttingSection
    (hgen : Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      ((((symAlgebra E).grading (⊤ : S.Opens)) 1 :
        Set ((symAlgebra E).sectionRing (⊤ : S.Opens)))) = ⊤)
    (ee : pullbackTwistOne ((symAlgebra E).grading (⊤ : S.Opens)) α ≅ L)
    {n : ℕ} (Y : Fin (n + 1) → ((symAlgebra E).grading (⊤ : S.Opens)) 1)
    (s : Fin (n + 1) → Γ(L, ⊤))
    (hsy : ∀ j, s j =
      ee.hom.app ⊤ (coordSection ((symAlgebra E).grading (⊤ : S.Opens)) α (Y j)))
    (hgens : GeneratesStalks s) (i : Fin (n + 1)) {dj : ℕ}
    {ffj qq : (symAlgebra E).sectionRing (⊤ : S.Opens)}
    (hqq : (Y i : (symAlgebra E).sectionRing ⊤) = qq)
    (hffj : ffj ∈ (symAlgebra E).grading (⊤ : S.Opens) dj)
    (hgg : qq * ffj ∈ (symAlgebra E).grading (⊤ : S.Opens) (1 + dj))
    (hcob : AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens)) ffj ≤
      α.coborderRange)
    (hffmem : ffj ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      (Set.range fun j => ((Y j : (symAlgebra E).sectionRing ⊤))))
    {f : X ⟶ S} (hf : α ≫ projStructureHom (symAlgebra E) hS = f)
    (p : X ⟶ projectiveSpaceOver n S)
    (hpf : p ≫ pullback.fst (terminal.from S)
      (terminal.from (projectiveSpaceAtUniverse.{u} n)) = f)
    (hchart : ∀ k, (nvCover s k).ι ≫ p ≫ projectiveSpaceOver.toIntegralAtUniverse n S =
      toProjectiveSpaceAtUniverse (chartRatio s k) (span_range_chartRatio s k))
    (hCtop : (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens))
      (qq * ffj)) ≤ f ⁻¹ᵁ ⊤)
    (hWitop : nvCover s i ≤ f ⁻¹ᵁ ⊤)
    (hCnv : (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens))
      (qq * ffj)) ≤ nvCover s i)
    (hallgen : ∀ v : Γ(X, α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
        ((symAlgebra E).grading (⊤ : S.Opens))
        (qq * ffj)),
      v ∈ Subring.closure
        ((Set.range (fun r : Γ(S, ⊤) => (f.appLE ⊤ (α ⁻¹ᵁ
                AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
                (qq * ffj)) hCtop).hom r) ∪
            Set.range fun m => resO hCnv (ratio s i m)) ∪
          {pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α le_rfl
            (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hgg 1
              ((Y i : (symAlgebra E).sectionRing ⊤) ^ (1 + dj))
              (by simpa using SetLike.pow_mem_graded (1 + dj) (Y i).2))})) :
    ∃ t : Γ(projectiveSpaceOver n S,
        Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤),
      p ⁻¹ᵁ (projectiveSpaceOver n S).basicOpen t =
          α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
            (qq * ffj) ∧
        IsClosedImmersion (p ∣_ (projectiveSpaceOver n S).basicOpen t) := by
  classical
  subst hqq
  have hq : ((Y i : (symAlgebra E).sectionRing ⊤)) ∈
      (symAlgebra E).grading (⊤ : S.Opens) 1 := (Y i).2
  have hdgg : 0 < 1 + dj := Nat.lt_of_lt_of_le Nat.zero_lt_one (Nat.le_add_right 1 dj)
  have hmul : ((Y i : (symAlgebra E).sectionRing ⊤)) * ffj ∈
      (symAlgebra E).grading (⊤ : S.Opens) ((1 + dj) • 1) := by simpa using hgg
  have hpow : ((Y i : (symAlgebra E).sectionRing ⊤)) ^ (1 + dj) ∈
      (symAlgebra E).grading (⊤ : S.Opens) (1 • (1 + dj)) := by
    simpa using SetLike.pow_mem_graded (1 + dj) (Y i).2
  have hgq : ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj) ≤
      ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        ((Y i : (symAlgebra E).sectionRing ⊤)) :=
    Stacks.OverlapChart.basicOpen_mul_le_left ((symAlgebra E).grading (⊤ : S.Opens))
      ((Y i : (symAlgebra E).sectionRing ⊤)) ffj
  have hWiq : nvCover s i ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens)) ((Y i : (symAlgebra E).sectionRing ⊤)) :=
    (preimage_basicOpen_eq_nvCover ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee Y s hsy
      i).ge
  have hCq : (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
        ((symAlgebra E).grading (⊤ : S.Opens))
        (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj)) ≤
      α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        ((Y i : (symAlgebra E).sectionRing ⊤)) := fun x hx => hgq hx
  -- the chart of the target, its affineness and the inverse image of it
  have hUch : Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤ =
      projectiveSpaceOver.standardChart n S i :=
    le_antisymm (Stacks.ChartDictionary.chartOpenOver_le_standardChart n S i ⊤)
      (le_inf le_rfl le_top)
  have hgU : p ⁻¹ᵁ Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤ = nvCover s i := by
    rw [hUch]
    exact Stacks.AmpleImmersionReduction.preimage_standardChart s hgens p hchart i
  have hUaff : IsAffineOpen (Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤) :=
    Stacks.ChartDictionary.isAffineOpen_chartOpenOver n S i hS
  -- the section cutting the overlap out of the coordinate chart is reached by `p`
  have ha₀ : pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α hWiq
      (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hq (1 + dj)
        (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj) hmul) ∈
      (p.appLE (Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤)
        (nvCover s i) hgU.ge).hom.range := by
    refine Subring.closure_le.mpr ?_
      (Stacks.CoefficientBridge.pullbackAway_mk_mem_closure_base hS E α hgen ee Y s hsy i hWiq
        hf hWitop hgg (mul_mem (Algebra.subset_adjoin ⟨i, rfl⟩) hffmem))
    rintro z (⟨r, rfl⟩ | ⟨k, rfl⟩)
    · exact ⟨_, Stacks.ChartDictionary.appLE_baseSection s p hpf i ⊤ hWitop hgU.ge r⟩
    · refine ⟨Stacks.ChartDictionary.chartCoordChart n S i ⊤ k, ?_⟩
      rw [Stacks.ChartDictionary.appLE_chartCoordChart s p i (hchart i) ⊤ hgU.ge k]
      exact (Stacks.ChartImmersionFinish.resO_self _ _).symm
  obtain ⟨t, ht⟩ := ha₀
  -- its standard open is the overlap chart
  have hbasic : X.basicOpen ((p.appLE (Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤)
        (nvCover s i) hgU.ge).hom t) =
      α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj) := by
    rw [ht, Stacks.OverlapDictionary.pullbackAway_apply,
      Stacks.ProjChartBasicOpen.basicOpen_appLE_awayToSection_mk
        ((symAlgebra E).grading (⊤ : S.Opens)) α hq Nat.one_pos (1 + dj)
        (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj) hmul hWiq]
    exact inf_eq_right.mpr hCnv
  -- the inverse of the cutting section on the overlap
  have hw : resO hCnv ((p.appLE (Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤)
        (nvCover s i) hgU.ge).hom t) *
      pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α le_rfl
        (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hgg 1
          ((Y i : (symAlgebra E).sectionRing ⊤) ^ (1 + dj)) hpow) = 1 := by
    have h1 : resO hCnv (pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α hWiq
          (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hq (1 + dj)
            (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj) hmul)) =
        pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α le_rfl
          (Stacks.OverlapFraction.restrictCoord ((symAlgebra E).grading (⊤ : S.Opens)) hq hgg
            hdgg hgq (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hq (1 + dj)
              (((Y i : (symAlgebra E).sectionRing ⊤)) * ffj) hmul)) :=
      (Stacks.OverlapDictionary.resO_pullbackAway
          ((symAlgebra E).grading (⊤ : S.Opens)) α hWiq hCnv _).trans
        (Stacks.OverlapDictionary.pullbackAway_degreeZeroRingMap
          ((symAlgebra E).grading (⊤ : S.Opens)) α ⟨1, Nat.one_pos, hq⟩ ⟨1 + dj, hdgg, hgg⟩ hgq
          le_rfl hCq _).symm
    rw [ht, h1, ← map_mul,
      Stacks.OverlapFraction.restrictCoord_mk_mul_mk_eq_one
        ((symAlgebra E).grading (⊤ : S.Opens)) hq hgg hdgg hgq, map_one]
  -- the generation hypothesis of the closure-to-surjectivity step
  have hgenclosure : Subring.closure (Set.range (fun z :
        Γ(projectiveSpaceOver n S, Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤) =>
      resO hCnv ((p.appLE (Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤)
        (nvCover s i) hgU.ge).hom z)) ∪
      {pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α le_rfl
        (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hgg 1
          ((Y i : (symAlgebra E).sectionRing ⊤) ^ (1 + dj)) hpow)}) = ⊤ := by
    rw [eq_top_iff]
    intro v _
    refine Subring.closure_le.mpr ?_ (hallgen v)
    rintro z ((⟨r, rfl⟩ | ⟨m, rfl⟩) | rfl)
    · exact Subring.subset_closure (Set.mem_union_left _
        ⟨(pullback.fst (terminal.from S)
            (terminal.from (projectiveSpaceAtUniverse.{u} n))).appLE ⊤
            (Stacks.ChartImmersionAssembly.chartOpenOver n S i ⊤)
            (Stacks.ChartDictionary.chartOpenOver_le_preimage n S i ⊤) r,
          (congrArg (fun z => resO hCnv z)
              (Stacks.ChartDictionary.appLE_baseSection s p hpf i ⊤ hWitop hgU.ge r)).trans
            (CategoryTheory.ConcreteCategory.congr_hom
              (Scheme.Hom.appLE_map f hWitop (homOfLE hCnv).op) r)⟩)
    · refine Subring.subset_closure (Set.mem_union_left _
        ⟨Stacks.ChartDictionary.chartCoordChart n S i ⊤ m, ?_⟩)
      exact congrArg (fun z => resO hCnv z)
        (Stacks.ChartDictionary.appLE_chartCoordChart s p i (hchart i) ⊤ hgU.ge m)
    · exact Subring.subset_closure (Set.mem_union_right _ rfl)
  refine ⟨t, ?_, ?_⟩
  · rw [Stacks.OverlapSurjectivity.preimage_basicOpen_eq p hgU t, hbasic]
  · exact isClosedImmersion_morphismRestrict_basicOpen_of_eq p hgU t hUaff hbasic hCnv
      (Stacks.OverlapChart.isAffineOpen_preimage_basicOpen_mul
        ((symAlgebra E).grading (⊤ : S.Opens)) α hq hffj hcob) hw hgenclosure

end Overlap

/-! ### The coordinate cut, and Stacks Tag 02NP -/

/-- **`Stacks.VeryAmpleAffineBase.ProjCoordinateImmersion`: the coordinate cut of
[Stacks, Tag 02NP].** From an immersion `α : X ⟶ Proj Γ(S, Sym(E))` over an affine base carrying
the absolute degree-one twist to `L`, there is a finite family of global sections of `L`
generating every stalk whose pinned morphism to `ℙⁿ_S` is an immersion.

The family is the one attached to the degree-one coordinates chosen in four steps — the cutting
cover, a first family of coordinates, the generators of each overlap chart, and the final family
containing the first — as described in the module docstring. The verification that the morphism is
an immersion is `Stacks.ChartImmersionAssembly.isImmersion_of_isImmersion_restrict_of_cover` at
the cover of `X` by the overlap charts and the family of standard opens
`Stacks.CoordinateImmersion.exists_cuttingSection` cuts out of the charts of `ℙⁿ_S`. -/
theorem projCoordinateImmersion : ProjCoordinateImmersion.{u} := by
  classical
  intro X S f L _ _ _ hS E _ α hα hover e0
  have := hα
  have hgen : Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      ((((symAlgebra E).grading (⊤ : S.Opens)) 1 :
        Set ((symAlgebra E).sectionRing (⊤ : S.Opens)))) = ⊤ :=
    adjoin_symAlgebra_eq_top E (⊤ : S.Opens) hS
  have ee : pullbackTwistOne ((symAlgebra E).grading (⊤ : S.Opens)) α ≅ L := e0.symm
  have hSc : CompactSpace S := ⟨by simpa using hS.isCompact⟩
  have hXc : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  -- the cutting cover
  obtain ⟨m, d, ff, hd, hff, hcovff, hcobff⟩ :=
    Stacks.CoordinateChoice.exists_fin_basicOpen_cover_le_coborderRange
      ((symAlgebra E).grading (⊤ : S.Opens)) α
  -- a first family of degree-one coordinates in which every cutting element is a polynomial
  obtain ⟨n₀, y₀, hy₀, hff₀⟩ :=
    Stacks.CoordinateChoice.exists_fin_mem_adjoin_range
      ((symAlgebra E).grading (⊤ : S.Opens)) hgen (Finset.image ff Finset.univ)
  have hff₀' : ∀ j, ff j ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      (Set.range y₀) := fun j =>
    hff₀ _ (Finset.mem_image_of_mem ff (Finset.mem_univ j))
  have hcovy₀ : ∀ x : X, ∃ i, x ∈ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ i) := fun x =>
    Stacks.CoordinateChoice.exists_mem_preimage_basicOpen_of_mem_adjoin
      ((symAlgebra E).grading (⊤ : S.Opens)) α y₀ (fun i => ⟨1, hy₀ i⟩) hd hff hff₀' hcovff x
  -- the overlap charts are cutting charts of the same kind
  have hdgg : ∀ j : Fin m, 0 < 1 + d j := fun j =>
    Nat.lt_of_lt_of_le Nat.zero_lt_one (Nat.le_add_right 1 (d j))
  have hggmem : ∀ ij : Fin (n₀ + 1) × Fin m,
      y₀ ij.1 * ff ij.2 ∈ (symAlgebra E).grading (⊤ : S.Opens) (1 + d ij.2) := fun ij =>
    SetLike.mul_mem_graded (hy₀ ij.1) (hff ij.2)
  have hcobgg : ∀ ij : Fin (n₀ + 1) × Fin m,
      AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        (y₀ ij.1 * ff ij.2) ≤ α.coborderRange := fun ij =>
    Stacks.OverlapChart.basicOpen_mul_le_coborderRange
      ((symAlgebra E).grading (⊤ : S.Opens)) α (y₀ ij.1) (ff ij.2) (hcobff ij.2)
  have hCtop : ∀ ij : Fin (n₀ + 1) × Fin m,
      (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        (y₀ ij.1 * ff ij.2)) ≤ f ⁻¹ᵁ ⊤ := fun _ => le_top
  -- the algebra generators of each overlap chart, as fractions
  have hgenerators : ∀ ij : Fin (n₀ + 1) × Fin m,
      ∃ tt : Finset (Away ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ ij.1 * ff ij.2)),
        ∀ v : Γ(X, α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
            ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ ij.1 * ff ij.2)),
          v ∈ Subring.closure
            (Set.range (f.appLE ⊤ (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
                ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ ij.1 * ff ij.2))
                (hCtop ij)).hom ∪
              Stacks.CoordinateChoice.awayToChart ((symAlgebra E).grading (⊤ : S.Opens)) α
                  (y₀ ij.1 * ff ij.2) ''
                (tt : Set (Away ((symAlgebra E).grading (⊤ : S.Opens))
                  (y₀ ij.1 * ff ij.2)))) := fun ij =>
    Stacks.CoordinateChoice.exists_finset_away_forall_mem_closure
      ((symAlgebra E).grading (⊤ : S.Opens)) α f (hggmem ij) (hdgg ij.2) (hcobgg ij) hS
      (hCtop ij)
  choose tt htt using hgenerators
  -- their numerators
  have hrep : ∀ (ij : Fin (n₀ + 1) × Fin m)
      (z : Away ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ ij.1 * ff ij.2)),
      ∃ (k : ℕ) (b : (symAlgebra E).sectionRing (⊤ : S.Opens))
        (hb : b ∈ (symAlgebra E).grading (⊤ : S.Opens) (k • (1 + d ij.2))),
        Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) (hggmem ij) k b hb = z := fun ij z =>
    HomogeneousLocalization.Away.mk_surjective _ (hggmem ij) z
  choose kk bb hbb hbbeq using hrep
  -- the final family of coordinates, containing the first
  obtain ⟨n, Y, hYmem, hT⟩ :=
    exists_fin_mem_adjoin_range_subset ((symAlgebra E).grading (⊤ : S.Opens)) hgen
      (((Finset.univ : Finset (Fin (n₀ + 1) × Fin m)).biUnion fun ij =>
          (tt ij).image (bb ij)) ∪ Finset.image ff Finset.univ)
      (Finset.image y₀ Finset.univ) (by
        intro a ha
        obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
        exact hy₀ i)
  have hidxex : ∀ i : Fin (n₀ + 1), ∃ i' : Fin (n + 1),
      ((Y i' : (symAlgebra E).sectionRing ⊤)) = y₀ i := fun i =>
    hYmem _ (Finset.mem_image_of_mem y₀ (Finset.mem_univ i))
  choose idx hidx using hidxex
  have hTff : ∀ j, ff j ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      (Set.range fun i => ((Y i : (symAlgebra E).sectionRing ⊤))) := fun j =>
    hT _ (Finset.mem_union_right _ (Finset.mem_image_of_mem ff (Finset.mem_univ j)))
  have hTnum : ∀ (ij : Fin (n₀ + 1) × Fin m)
      (z : Away ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ ij.1 * ff ij.2)), z ∈ tt ij →
      bb ij z ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
        (Set.range fun i => ((Y i : (symAlgebra E).sectionRing ⊤))) := fun ij z hz =>
    hT _ (Finset.mem_union_left _
      (Finset.mem_biUnion.mpr ⟨ij, Finset.mem_univ ij, Finset.mem_image_of_mem (bb ij) hz⟩))
  -- the family of sections attached to the final coordinates
  set s : Fin (n + 1) → Γ(L, ⊤) :=
    fun i => ee.hom.app ⊤ (coordSection ((symAlgebra E).grading (⊤ : S.Opens)) α (Y i)) with hs
  have hsy : ∀ j, s j =
      ee.hom.app ⊤ (coordSection ((symAlgebra E).grading (⊤ : S.Opens)) α (Y j)) :=
    fun _ => rfl
  have hcovy : ∀ x : X, ∃ i, x ∈ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens))
      ((Y i : (symAlgebra E).sectionRing ⊤)) := by
    intro x
    obtain ⟨i, hi⟩ := hcovy₀ x
    exact ⟨idx i, by rw [hidx i]; exact hi⟩
  have hgens : GeneratesStalks s :=
    generatesStalks_coordFamily ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee Y s hsy hcovy
  refine ⟨n, s, hgens, ?_⟩
  intro p hpf hchart
  have hgqs : ∀ ij : Fin (n₀ + 1) × Fin m,
      ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
          (y₀ ij.1 * ff ij.2) ≤
        ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
          ((Y (idx ij.1) : (symAlgebra E).sectionRing ⊤)) := by
    intro ij
    rw [hidx ij.1]
    exact Stacks.OverlapChart.basicOpen_mul_le_left
      ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ ij.1) (ff ij.2)
  have hCq : ∀ ij : Fin (n₀ + 1) × Fin m,
      (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
          (y₀ ij.1 * ff ij.2)) ≤
        α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
          ((Y (idx ij.1) : (symAlgebra E).sectionRing ⊤)) := fun ij _ hx => hgqs ij hx
  have hCnv : ∀ ij : Fin (n₀ + 1) × Fin m,
      (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        (y₀ ij.1 * ff ij.2)) ≤ nvCover s (idx ij.1) := fun ij =>
    (hCq ij).trans (preimage_basicOpen_le_nvCover
      ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee Y s hsy (idx ij.1))
  have hWitop : ∀ i : Fin (n + 1), nvCover s i ≤ f ⁻¹ᵁ ⊤ := fun _ => le_top
  have hchoice : ∀ ij : Fin (n₀ + 1) × Fin m,
      ∃ t : Γ(projectiveSpaceOver n S,
          Stacks.ChartImmersionAssembly.chartOpenOver n S (idx ij.1) ⊤),
        p ⁻¹ᵁ (projectiveSpaceOver n S).basicOpen t =
            α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
              (y₀ ij.1 * ff ij.2) ∧
          IsClosedImmersion (p ∣_ (projectiveSpaceOver n S).basicOpen t) := by
    intro ij
    refine exists_cuttingSection hS E α hgen ee Y s hsy hgens (idx ij.1) (hidx ij.1)
      (hff ij.2) (hggmem ij) (hcobff ij.2) (hTff ij.2) hover p hpf hchart (hCtop ij)
      (hWitop (idx ij.1)) (hCnv ij) fun v => ?_
    exact mem_closure_overlap hS E α hgen ee Y s hsy (idx ij.1) (hggmem ij) (hdgg ij.2)
      (hgqs ij) hover (hCtop ij) (hCq ij) (tt ij) (htt ij)
      (fun z hz => ⟨kk ij z, bb ij z, hbb ij z, hTnum ij z hz, hbbeq ij z⟩) v
  choose tsec htsec1 htsec2 using hchoice
  refine Stacks.ChartImmersionAssembly.isImmersion_of_isImmersion_restrict_of_cover p
    (fun ij : Fin (n₀ + 1) × Fin m =>
      α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        (y₀ ij.1 * ff ij.2)) ?_
    (fun ij => (projectiveSpaceOver n S).basicOpen (tsec ij))
    (fun ij => (htsec1 ij).ge) fun ij => ?_
  · rw [eq_top_iff]
    intro x _
    obtain ⟨j, hj⟩ := hcovff x
    obtain ⟨i, hi⟩ := hcovy₀ x
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨(i, j), ?_⟩
    change α.base x ∈ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens)) (y₀ i * ff j)
    rw [AlgebraicGeometry.Proj.basicOpen_mul]
    exact ⟨hi, hj⟩
  · have := htsec2 ij
    infer_instance

/-- **`Stacks.VeryAmpleAffineBase.ProjCoordinateCut`.** The twist identification it asks for is
free, by `Stacks.VeryAmpleAffineBase.projCoordinateCut_of_projCoordinateImmersion`. -/
theorem projCoordinateCut : ProjCoordinateCut.{u} :=
  projCoordinateCut_of_projCoordinateImmersion projCoordinateImmersion.{u}

/-- **Stacks Tag 02NP.** A relatively very ample invertible sheaf on a scheme of finite type over
an affine base is the hyperplane sheaf pulled back along an immersion into a finite-dimensional
projective space over that base, lying over the base.

Finite type is the conjunction of local finiteness of type with quasi-compactness, and the
conclusion is `Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver`, the source's conclusion
written out.

`Stacks.VeryAmpleAffineBase.hasImmersionTwistOver_of_isRelativelyVeryAmple` is the same statement
on the hypothesis `Stacks.VeryAmpleAffineBase.ProjCoordinateCut`, the coordinate-cutting step of
the source's proof; that hypothesis is discharged by
`Stacks.CoordinateImmersion.projCoordinateCut`. -/
@[stacks 02NP, ega "II 5.3.3" "special case"]
theorem hasImmersionTwistOver_of_isRelativelyVeryAmple {S X : Scheme.{u}} (f : X ⟶ S)
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] [LocallyOfFiniteType f]
    [QuasiCompact f] [IsAffine S]
    (hL : Tag01VMVeryAmple.IsRelativelyVeryAmple f L) :
    AmpleProjectiveImmersion.HasImmersionTwistOver f L :=
  Stacks.VeryAmpleAffineBase.hasImmersionTwistOver_of_isRelativelyVeryAmple
    projCoordinateCut.{u} f L hL

end Stacks.CoordinateImmersion

