module

public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.DegreeOneMonomial
public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.SectionDictionary
public import StacksFrontier.RingTheory.GradedAlgebra.VeroneseAwayDegreeOne

/-!
# Dividing by a power of a coordinate: the fraction arithmetic of Stacks Tag 02NP

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring and let `y_0, …, y_n` be elements of `𝒜 1`. The
coordinate cut of [Stacks, Tag 02NP] has to divide a homogeneous element `b` of degree `D` by
`y_i^D` and read the quotient as a *polynomial over `𝒜 0` in the degree-zero fractions
`y_m / y_i`*. `Stacks.DegreeOneMonomial.exists_sum_monomials_of_mem_adjoin` supplies the
decomposition of `b` itself — an `𝒜 0`-combination of monomials of total degree `D` in the `y` —
and this file pushes that decomposition through `HomogeneousLocalization.Away.mk`.

## What has to be pushed through

`HomogeneousLocalization.Away.mk 𝒜 hq n x hx` is the fraction `x / q^n`, for `q` homogeneous of
degree `d` and `x` homogeneous of degree `n • d`. It is *not* a ring homomorphism in `x` alone:
the numerator and the denominator exponent move together. The four facts needed are therefore
additivity at a fixed exponent, multiplicativity across exponents, and the `Finset`-indexed
versions of both:

* `Stacks.AwayFraction.mk_sum`: `(∑ x_j)/q^n` splits. Its binary case is available, as
  `Stacks.Veronese.awayMk_add`, and is used rather than restated.
* `Stacks.AwayFraction.mk_mul`, `Stacks.AwayFraction.mk_prod`: `(x₁ x₂)/q^{n₁+n₂}` splits.
* `Stacks.AwayFraction.mk_pow`: `x^k/q^{nk} = (x/q^n)^k`.

The binary addition and the vanishing of `0/q^n` come from the `AwayFractions` section of
`StacksFrontier/RingTheory/GradedAlgebra/VeroneseAwayDegreeOne.lean`, which proves them for an
arbitrary graded ring and an arbitrary degree; the multiplicative and the `Finset`-indexed facts
are new here (that section's multiplication lemma is `private`).

Every exponent is given as a separate variable together with an equation, rather than as the
syntactic sum or product, because the exponent also occurs in the *type* of the homogeneity
hypothesis: a `rw` of the exponent inside `Away.mk` is not type correct, so the shape has to be
arranged before the lemma is applied. `Stacks.AwayFraction.mk_congr` does the arranging.

## Main results

* `Stacks.AwayFraction.mk_zero_eq_algebraMap`: the fraction `r/q^0` of a degree-zero `r` is the
  image of `r` under `algebraMap (𝒜 0) (A_q)`.
* `Stacks.AwayFraction.mk_finsuppProd`: **a monomial divided by the matching power of `y_i` is the
  same monomial in the fractions `y_m/y_i`.**
* `Stacks.AwayFraction.mk_mem_closure_of_mem_adjoin`: **the fraction arithmetic of
  [Stacks, Tag 02NP].** If `b` is homogeneous of degree `D` and lies in the subalgebra generated
  over `𝒜 0` by degree-one elements `y`, then `b / y_i^D` lies in the subring generated by the
  degree-zero constants together with the fractions `y_m / y_i`. No positivity hypothesis on `D`
  and no finiteness hypothesis on the index type occurs.
* `Stacks.AwayFraction.mk_mem_closure_awayCoord`: the same with the fractions spelled as
  `Stacks.CoordinateDictionary.awayCoord`, the spelling the section-value dictionary of
  `StacksFrontier/AlgebraicGeometry/VeryAmpleAffineBase/SectionDictionary.lean` converts into the
  coordinate ratios `s_m/s_i` of the pinned family. Through
  `Stacks.CoordinateDictionary.resO_ratio_eq_pullbackAwayCoord_of_le_preimage` that is the
  hypothesis shape of `Stacks.ChartDictionary.surjective_appLE_chartOpenOver`: a polynomial over
  the base sections in `Stacks.ProjectiveFromSections.ratio`.

## References

* [Stacks Project, Tag 02NP](https://stacks.math.columbia.edu/tag/02NP)
-/

@[expose] public noncomputable section

open HomogeneousLocalization

universe u w

namespace Stacks.AwayFraction

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-! ### Fraction arithmetic -/

section Arith

variable {d : ℕ} {q : A} (hq : q ∈ 𝒜 d)

/-- **The exponent and the numerator of a fraction may be rewritten.** Both occur in the type of
the homogeneity hypothesis of `HomogeneousLocalization.Away.mk`, so neither can be rewritten by
`rw`; this is the congruence lemma that replaces it. It is
`Stacks.Veronese.awayMk_congr` with the exponent allowed to move as well, which is what the
induction in `Stacks.AwayFraction.mk_prod` needs. -/
theorem mk_congr {n n' : ℕ} (hn : n = n') {x x' : A} (hx : x = x') (h : x ∈ 𝒜 (n • d))
    (h' : x' ∈ 𝒜 (n' • d)) :
    Away.mk 𝒜 hq n x h = Away.mk 𝒜 hq n' x' h' := by
  subst hn
  exact Stacks.Veronese.awayMk_congr 𝒜 hq n h h' hx

/-- **`1 / q^0 = 1`.** -/
theorem mk_one' (h : (1 : A) ∈ 𝒜 (0 • d)) : Away.mk 𝒜 hq 0 1 h = 1 := by
  rw [HomogeneousLocalization.ext_iff_val]
  simp

/-- **The fraction `r / q^0` of a degree-zero element is the image of `r` under the structure map
`𝒜 0 ⟶ A_q`.** -/
theorem mk_zero_eq_algebraMap (r : 𝒜 0) (h : (r : A) ∈ 𝒜 (0 • d)) :
    Away.mk 𝒜 hq 0 (r : A) h = algebraMap (𝒜 0) (Away 𝒜 q) r := by
  have hr : algebraMap (𝒜 0) (Away 𝒜 q) r =
      HomogeneousLocalization.mk ⟨0, r, 1, one_mem (Submonoid.powers q)⟩ := rfl
  rw [HomogeneousLocalization.ext_iff_val, hr]
  simp

/-- **Multiplicativity across denominators**: `(x₁ x₂)/q^{n₁+n₂} = (x₁/q^{n₁})(x₂/q^{n₂})`. -/
theorem mk_mul {n₁ n₂ N : ℕ} (hN : N = n₁ + n₂) {x₁ x₂ : A} (h : x₁ * x₂ ∈ 𝒜 (N • d))
    (h₁ : x₁ ∈ 𝒜 (n₁ • d)) (h₂ : x₂ ∈ 𝒜 (n₂ • d)) :
    Away.mk 𝒜 hq N (x₁ * x₂) h = Away.mk 𝒜 hq n₁ x₁ h₁ * Away.mk 𝒜 hq n₂ x₂ h₂ := by
  subst hN
  rw [HomogeneousLocalization.ext_iff_val]
  simp [Localization.mk_mul, pow_add]

/-- **Powers**: `x^k/q^{nk} = (x/q^n)^k`. -/
theorem mk_pow {n k N : ℕ} (hN : N = n * k) {x : A} (h : x ^ k ∈ 𝒜 (N • d))
    (h' : x ∈ 𝒜 (n • d)) :
    Away.mk 𝒜 hq N (x ^ k) h = Away.mk 𝒜 hq n x h' ^ k := by
  subst hN
  rw [HomogeneousLocalization.ext_iff_val]
  simp [Localization.mk_pow, pow_mul]

/-- **A `Finset` sum at a fixed denominator splits.** -/
theorem mk_sum {κ : Type*} (t : Finset κ) {n : ℕ} (x : κ → A) (hx : ∀ j, x j ∈ 𝒜 (n • d))
    (h : (∑ j ∈ t, x j) ∈ 𝒜 (n • d)) :
    Away.mk 𝒜 hq n (∑ j ∈ t, x j) h = ∑ j ∈ t, Away.mk 𝒜 hq n (x j) (hx j) := by
  classical
  induction t using Finset.cons_induction with
  | empty => simpa using Stacks.Veronese.awayMk_zero 𝒜 hq n _
  | cons a s ha ih =>
    have hs : (∑ j ∈ s, x j) ∈ 𝒜 (n • d) := sum_mem fun j _ => hx j
    have ha' : x a + ∑ j ∈ s, x j ∈ 𝒜 (n • d) := add_mem (hx a) hs
    refine (mk_congr 𝒜 hq rfl (Finset.sum_cons ha) h ha').trans ?_
    rw [← Stacks.Veronese.awayMk_add 𝒜 hq n (hx a) hs ha', ih hs, Finset.sum_cons]

/-- **A `Finset` product splits, the denominator exponents adding up.** -/
theorem mk_prod {κ : Type*} (t : Finset κ) (n : κ → ℕ) (x : κ → A)
    (hx : ∀ j, x j ∈ 𝒜 (n j • d)) {N : ℕ} (hN : N = ∑ j ∈ t, n j)
    (h : (∏ j ∈ t, x j) ∈ 𝒜 (N • d)) :
    Away.mk 𝒜 hq N (∏ j ∈ t, x j) h = ∏ j ∈ t, Away.mk 𝒜 hq (n j) (x j) (hx j) := by
  classical
  subst hN
  induction t using Finset.cons_induction with
  | empty => simpa using mk_one' 𝒜 hq _
  | cons a s ha ih =>
    have hs : (∏ j ∈ s, x j) ∈ 𝒜 ((∑ j ∈ s, n j) • d) := by
      have h' := SetLike.prod_mem_graded 𝒜 (fun j => n j • d) x fun j (_ : j ∈ s) => hx j
      simpa [Finset.sum_mul] using h'
    have ha' : x a * ∏ j ∈ s, x j ∈ 𝒜 ((n a + ∑ j ∈ s, n j) • d) := by
      simpa [add_mul] using SetLike.mul_mem_graded (hx a) hs
    refine (mk_congr 𝒜 hq (Finset.sum_cons ha) (Finset.prod_cons ha) h ha').trans ?_
    rw [mk_mul 𝒜 hq rfl ha' (hx a) hs, ih hs, Finset.prod_cons]

end Arith

/-! ### Dividing a monomial in the coordinates by a power of one of them -/

section Coordinates

variable {ι : Type*}

/-- **A monomial of total degree `D` in degree-one elements, divided by `y_i^D`, is the same
monomial in the fractions `y_m / y_i`.** -/
theorem mk_finsuppProd (y : ι → A) (hy : ∀ j, y j ∈ 𝒜 1) (i : ι) (m : ι →₀ ℕ) {N : ℕ}
    (hN : N = m.sum fun _ k => k) (h : (m.prod fun j k => y j ^ k) ∈ 𝒜 (N • 1)) :
    Away.mk 𝒜 (hy i) N (m.prod fun j k => y j ^ k) h =
      m.prod fun j k => Away.mk 𝒜 (hy i) 1 (y j) (by simpa using hy j) ^ k := by
  refine (mk_prod 𝒜 (hy i) m.support (fun j => m j) (fun j => y j ^ m j)
    (fun j => SetLike.pow_mem_graded (m j) (hy j)) hN h).trans ?_
  exact Finset.prod_congr rfl fun j _ =>
    mk_pow 𝒜 (hy i) (one_mul (m j)).symm _ (by simpa using hy j)

/-- **The fraction arithmetic of [Stacks, Tag 02NP].** Let `y : ι → A` be a family of elements of
`𝒜 1` and let `b` be homogeneous of degree `D` and lie in the subalgebra generated over `𝒜 0` by
the family. Then the degree-zero fraction `b / y_i^D` lies in the subring of `A_{(y_i)}` generated
by the degree-zero constants together with the fractions `y_m / y_i`.

`Stacks.DegreeOneMonomial.exists_sum_monomials_of_mem_adjoin` writes `b` as an `𝒜 0`-combination
of monomials of total degree `D` in the `y`, and the fraction arithmetic of this file carries that
decomposition through `HomogeneousLocalization.Away.mk`: the sum splits by
`Stacks.AwayFraction.mk_sum`, each coefficient becomes a degree-zero constant by
`Stacks.AwayFraction.mk_zero_eq_algebraMap`, and each monomial becomes a monomial in the
fractions by `Stacks.AwayFraction.mk_finsuppProd`.

No positivity hypothesis on `D`, no finiteness hypothesis on `ι` and no hypothesis on `A` beyond
the grading occurs. -/
theorem mk_mem_closure_of_mem_adjoin (y : ι → A) (hy : ∀ j, y j ∈ 𝒜 1) (i : ι) {D : ℕ} {b : A}
    (hb : b ∈ 𝒜 D) (hmem : b ∈ Algebra.adjoin (𝒜 0) (Set.range y)) :
    Away.mk 𝒜 (hy i) D b (by simpa using hb) ∈
      Subring.closure (Set.range (algebraMap (𝒜 0) (Away 𝒜 (y i))) ∪
        Set.range fun j : ι => Away.mk 𝒜 (hy i) 1 (y j) (by simpa using hy j)) := by
  classical
  obtain ⟨t, c, hdeg, hsum⟩ :=
    Stacks.DegreeOneMonomial.exists_sum_monomials_of_mem_adjoin 𝒜 y hy hb hmem
  -- The decomposition, reindexed by the subtype of `t` so that the degree of every member is `D`.
  have hprod : ∀ m : {m : ι →₀ ℕ // m ∈ t},
      (m.1.prod fun j k => y j ^ k) ∈ 𝒜 (D • 1) := by
    intro m
    have h1 := Stacks.DegreeOneMonomial.finsuppProd_mem 𝒜 y hy m.1
    rw [hdeg m.1 m.2] at h1
    simpa using h1
  have hFmem : ∀ m : {m : ι →₀ ℕ // m ∈ t},
      ((c m.1 : A) * m.1.prod fun j k => y j ^ k) ∈ 𝒜 (D • 1) :=
    fun m => by simpa using SetLike.mul_mem_graded (c m.1).2 (hprod m)
  have hbsum : b = ∑ m ∈ t.attach, (c m.1 : A) * m.1.prod fun j k => y j ^ k :=
    hsum.trans (Finset.sum_attach t _).symm
  -- The fraction is the corresponding sum of fractions.
  have key : Away.mk 𝒜 (hy i) D b (by simpa using hb) =
      ∑ m ∈ t.attach,
        Away.mk 𝒜 (hy i) D ((c m.1 : A) * m.1.prod fun j k => y j ^ k) (hFmem m) := by
    refine (mk_congr 𝒜 (hy i) rfl hbsum _ (sum_mem fun m _ => hFmem m)).trans ?_
    exact mk_sum 𝒜 (hy i) t.attach _ hFmem _
  rw [key]
  refine sum_mem fun m _ => ?_
  have hc : ((c m.1 : A)) ∈ 𝒜 (0 • 1) := by simp
  rw [mk_mul 𝒜 (hy i) (zero_add D).symm (hFmem m) hc (hprod m),
    mk_zero_eq_algebraMap 𝒜 (hy i) (c m.1) hc,
    mk_finsuppProd 𝒜 y hy i m.1 (hdeg m.1 m.2).symm (hprod m)]
  refine mul_mem (Subring.subset_closure (Set.mem_union_left _ ?_))
    (prod_mem fun j _ => pow_mem (Subring.subset_closure (Set.mem_union_right _ ?_)) _)
  · exact ⟨c m.1, rfl⟩
  · exact ⟨j, rfl⟩

/-- **The fraction arithmetic of [Stacks, Tag 02NP], with the fractions spelled as
`Stacks.CoordinateDictionary.awayCoord`** — the spelling the section-value dictionary converts
into the coordinate ratios of the pinned family of sections. -/
theorem mk_mem_closure_awayCoord (y : ι → 𝒜 1) (i : ι) {D : ℕ} {b : A} (hb : b ∈ 𝒜 D)
    (hmem : b ∈ Algebra.adjoin (𝒜 0) (Set.range fun j => (y j : A))) :
    Away.mk 𝒜 (y i).2 D b (by simpa using hb) ∈
      Subring.closure (Set.range (algebraMap (𝒜 0) (Away 𝒜 ((y i : A)))) ∪
        Set.range (Stacks.CoordinateDictionary.awayCoord 𝒜 (y i).2 ∘ y)) :=
  mk_mem_closure_of_mem_adjoin 𝒜 (fun j => (y j : A)) (fun j => (y j).2) i hb hmem

end Coordinates

end Stacks.AwayFraction

end
