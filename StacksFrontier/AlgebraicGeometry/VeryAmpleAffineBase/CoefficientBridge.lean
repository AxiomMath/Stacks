module

public import StacksFrontier.AlgebraicGeometry.SheafSymmetricAlgebra.StructureDegreeZero
public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.BaseSectionDictionary

/-!
# The two coefficient dictionaries of Stacks Tag 02NP meet

`Stacks.CoordinateDictionary.pullbackAway_mk_mem_closure` puts the inverse image along
`α : X ⟶ Proj Γ(S, Sym(E))` of a chart generator `b / y_i^D` in the subring of `Γ(X, W)`
generated by **the inverse images of the degree-zero constants** together with the coordinate
ratios `s_m / s_i`. What the morphism to `ℙⁿ_S` reaches, by
`Stacks.ChartDictionary.appLE_baseSection` and `Stacks.ChartDictionary.appLE_chartCoordChart`, is
the subring generated by **the inverse images of the sections of `𝒪_S`** together with those same
ratios. This file identifies the two generating sets, which is the last comparison the coordinate
cut of [Stacks, Tag 02NP] needed:

* the inverse image of a degree-zero constant *is* the inverse image of a base section, by
  `Stacks.BaseSectionDictionary.pullbackAway_algebraMap_strZeroSheaf`;
* and every degree-zero constant comes from a base section, by
  `Stacks.SymGraded.surjective_strZeroSheaf`, the degree-zero part of `Sym(E)` being the
  structure sheaf.

## Main results

* `Stacks.CoefficientBridge.pullbackAway_mk_mem_closure_base`: **the chart generator is a
  polynomial in the coordinate ratios with base-section coefficients.** For `b` homogeneous of
  degree `D` in the subalgebra generated over the degree-zero part by the degree-one coordinates,
  the inverse image along `α` of `b / y_i^D` lies in the subring of `Γ(X, W)` generated by the
  inverse images along the structure morphism of the sections of `𝒪_S` together with the
  coordinate ratios.

## What is not done

This is a statement about an arbitrary open `W` inside the coordinate chart `α⁻¹(D₊(y_i))`. It is
*not* the surjectivity the finishing step consumes: that is stated at the **overlap** chart
`α⁻¹(D₊(y_i f_j))`, where the generators are the fractions `b / (y_i f_j)^k` of
`Stacks.OverlapChart.surjective_awayToChart_mul` and one inverse of the cut section, and where
`Stacks.OverlapFraction.mk_mem_closure_mk` rather than
`Stacks.AwayFraction.mk_mem_closure_of_mem_adjoin` is the algebraic input. Transporting that one
through the restriction `A₍y_i₎ ⟶ A₍y_i f_j₎` of
`ProjectiveSpectrum.degreeZeroRingMap` is the step that still has to be written.

## References

* [Stacks Project, Tag 02NP](https://stacks.math.columbia.edu/tag/02NP)
* [Stacks Project, Tag 01NA](https://stacks.math.columbia.edu/tag/01NA)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry HomogeneousLocalization
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.CoordinateDictionary
open Stacks.ProjectiveFromSections
open Stacks.Tag01VMRelativeVeryAmple
open Stacks.VeryAmpleAffineBase

universe u

namespace Stacks.CoefficientBridge

variable {S : Scheme.{u}} (hS : IsAffineOpen (⊤ : S.Opens)) (E : S.Modules)
  [E.IsQuasicoherent] {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L]
  (α : X ⟶ AlgebraicGeometry.Proj ((symAlgebra E).grading (⊤ : S.Opens)))

/-- **The chart generator of [Stacks, Tag 02NP] is a polynomial in the coordinate ratios with
coefficients coming from the base.** Let `b` be homogeneous of degree `D` and lie in the
subalgebra generated over the degree-zero part by the degree-one coordinates `y`. Then the
inverse image along `α` of the degree-zero fraction `b / y_i^D` lies in the subring of `Γ(X, W)`
generated by the inverse images along `f = α ≫ projStructureHom` of the sections of `𝒪_S`
together with the coordinate ratios `s_m / s_i`.

`Stacks.CoordinateDictionary.pullbackAway_mk_mem_closure` is the same with the degree-zero
constants of the graded ring in place of the base sections; the two generating sets agree by
`Stacks.BaseSectionDictionary.pullbackAway_algebraMap_mem_range`, whose surjectivity hypothesis
is `Stacks.SymGraded.surjective_strZeroSheaf`. -/
theorem pullbackAway_mk_mem_closure_base
    (hgen : Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      ((((symAlgebra E).grading (⊤ : S.Opens)) 1 :
        Set ((symAlgebra E).sectionRing (⊤ : S.Opens)))) = ⊤)
    (ee : pullbackTwistOne ((symAlgebra E).grading (⊤ : S.Opens)) α ≅ L)
    {ι : Type*} (y : ι → ((symAlgebra E).grading (⊤ : S.Opens)) 1) (s : ι → Γ(L, ⊤))
    (hsy : ∀ j, s j =
      ee.hom.app ⊤ (coordSection ((symAlgebra E).grading (⊤ : S.Opens)) α (y j))) (i : ι)
    {W : X.Opens}
    (hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      ((symAlgebra E).grading (⊤ : S.Opens)) ((y i : (symAlgebra E).sectionRing ⊤)))
    {f : X ⟶ S} (hf : α ≫ projStructureHom (symAlgebra E) hS = f) (hW : W ≤ f ⁻¹ᵁ ⊤)
    {D : ℕ} {b : (symAlgebra E).sectionRing (⊤ : S.Opens)}
    (hb : b ∈ (symAlgebra E).grading (⊤ : S.Opens) D)
    (hbmem : b ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      (Set.range fun j => ((y j : (symAlgebra E).sectionRing ⊤)))) :
    pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α hle
        (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) (y i).2 D b (by simpa using hb)) ∈
      Subring.closure
        (Set.range (fun r : Γ(S, ⊤) => (f.appLE ⊤ W hW).hom r) ∪
          Set.range fun k =>
            resO (hle.trans (preimage_basicOpen_le_nvCover
                ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee y s hsy i))
              (ratio s i k)) := by
  refine Subring.closure_mono (Set.union_subset_union_left _ ?_)
    (pullbackAway_mk_mem_closure ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee y s hsy i hle
      hb hbmem)
  rintro z ⟨r₀, rfl⟩
  exact Stacks.BaseSectionDictionary.pullbackAway_algebraMap_mem_range (symAlgebra E) hS α
    (y i).2 Nat.one_pos hle hf hW
    (Stacks.SymGraded.surjective_strZeroSheaf E
      (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent E) hS) r₀

end Stacks.CoefficientBridge

end
