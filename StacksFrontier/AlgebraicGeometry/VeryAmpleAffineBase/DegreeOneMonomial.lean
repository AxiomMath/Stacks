module

public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.CoordinateChoice

/-!
# A homogeneous element of the subalgebra generated by degree-one elements

Let `A` be a graded ring with graded pieces `𝒜 n`. An element of `𝒜 D` lying in the subalgebra
generated over `𝒜 0` by elements `y_i` of `𝒜 1` is an `𝒜 0`-combination of monomials of total
degree `D` in the `y_i`.

## Main results

* `Stacks.DegreeOneMonomial.exists_sum_monomials_of_mem_adjoin`: a homogeneous element of degree
  `D` of the subalgebra generated over `𝒜 0` by degree-one elements is an `𝒜 0`-combination of
  monomials of total degree `D` in them.

## References

* [Stacks Project, Tag 02NP](https://stacks.math.columbia.edu/tag/02NP)
-/

@[expose] public noncomputable section

open DirectSum

universe u w

namespace Stacks.DegreeOneMonomial

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- A monomial in degree-one elements is homogeneous of its total degree. -/
theorem finsuppProd_mem {ι : Type*} (y : ι → A) (hy : ∀ i, y i ∈ 𝒜 1) (m : ι →₀ ℕ) :
    (m.prod fun i k => y i ^ k) ∈ 𝒜 (m.sum fun _ k => k) := by
  have h := SetLike.prod_mem_graded (F := m.support) 𝒜 (fun i => m i)
    (fun i => y i ^ m i) fun i _ => by
      simpa only [smul_eq_mul, mul_one] using SetLike.pow_mem_graded (m i) (hy i)
  simpa only [Finsupp.prod, Finsupp.sum] using h

/-- A homogeneous element of degree `D` of the subalgebra generated over `𝒜 0` by degree-one
elements is an `𝒜 0`-combination of the monomials of total degree `D` in them. -/
theorem exists_sum_monomials_of_mem_adjoin {ι : Type*} (y : ι → A) (hy : ∀ i, y i ∈ 𝒜 1)
    {D : ℕ} {b : A} (hb : b ∈ 𝒜 D) (hmem : b ∈ Algebra.adjoin (𝒜 0) (Set.range y)) :
    ∃ (t : Finset (ι →₀ ℕ)) (c : (ι →₀ ℕ) → (𝒜 0)),
      (∀ m ∈ t, (m.sum fun _ k => k) = D) ∧
        b = ∑ m ∈ t, (c m : A) * m.prod fun i k => y i ^ k := by
  classical
  rw [Algebra.adjoin_range_eq_range_aeval] at hmem
  obtain ⟨P, hP⟩ := hmem
  set term : (ι →₀ ℕ) → A :=
    fun m => ((P.coeff m : 𝒜 0) : A) * m.prod fun i k => y i ^ k with hterm
  have hdeg : ∀ m : ι →₀ ℕ, term m ∈ 𝒜 (m.sum fun _ k => k) := fun m => by
    simpa only [hterm, zero_add] using
      SetLike.mul_mem_graded (P.coeff m).2 (finsuppProd_mem 𝒜 y hy m)
  have hsum : b = ∑ m ∈ P.support, term m := by
    conv_lhs => rw [← hP, P.as_sum, map_sum]
    exact Finset.sum_congr rfl fun m _ => MvPolynomial.aeval_monomial ..
  refine ⟨P.support.filter fun m => (m.sum fun _ k => k) = D, P.coeff,
    fun m hm => (Finset.mem_filter.mp hm).2, ?_⟩
  calc b = GradedRing.proj 𝒜 D b := by
        rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hb]
    _ = ∑ m ∈ P.support, GradedRing.proj 𝒜 D (term m) := by rw [hsum, map_sum]
    _ = ∑ m ∈ P.support, if (m.sum fun _ k => k) = D then term m else 0 := by
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [GradedRing.proj_apply]
        split_ifs with h
        · exact DirectSum.decompose_of_mem_same 𝒜 (h ▸ hdeg m)
        · exact DirectSum.decompose_of_mem_ne 𝒜 (hdeg m) h
    _ = ∑ m ∈ P.support.filter fun m => (m.sum fun _ k => k) = D, term m :=
        (Finset.sum_filter _ _).symm

end Stacks.DegreeOneMonomial

end
