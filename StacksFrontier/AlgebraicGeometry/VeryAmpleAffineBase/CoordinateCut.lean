/-! ### The hyperplane sheaf is free: Tag 01VS's conclusion from a pinned immersion -/

/-- **A finite generating family of global sections of an invertible module whose pinned morphism
to projective space is an immersion gives `Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver`
at that module.**

The morphism is Stacks Tag 01NE's,
`Stacks.ProjGlobalSectionsAppTop.exists_hom_projectiveSpaceOver_of_generatesStalks`; the
identification of the hyperplane sheaf with the module is
`Stacks.AmpleImmersionReduction.twistPullback`, which is unconditional. So no twist
comparison has to be supplied: a covering family and the immersion clause are the whole of the
input.

No ampleness, no tensor power and no finite type hypothesis occurs; the conclusion entails
`LocallyOfFiniteType f` all the same, by
`Stacks.AmpleImmersionReduction.locallyOfFiniteType_of_hasImmersionTwistOver`, through the
immersion clause. -/
theorem hasImmersionTwistOver_of_generatesStalks {X S : Scheme.{u}} (f : X ⟶ S) (M : X.Modules)
    [IsInvertibleModule X M] {n : ℕ} (s : Fin (n + 1) → Γ(M, ⊤)) (hgen : GeneratesStalks s)
    (himm : ∀ p : X ⟶ projectiveSpaceOver n S,
      p ≫ pullback.fst (terminal.from S)
          (terminal.from (projectiveSpaceAtUniverse.{u} n)) = f →
        (∀ i, (nvCover s i).ι ≫ p ≫ projectiveSpaceOver.toIntegralAtUniverse n S =
          toProjectiveSpaceAtUniverse (chartRatio s i) (span_range_chartRatio s i)) →
        IsImmersion p) :
    HasImmersionTwistOver f M := by
  obtain ⟨p, hpf, hchart⟩ :=
    Stacks.ProjGlobalSectionsAppTop.exists_hom_projectiveSpaceOver_of_generatesStalks s hgen f
  exact ⟨n, p, himm p hpf hchart, hpf,
    Stacks.AmpleImmersionReduction.twistPullback f M n s hgen p hpf hchart⟩

/-! ### The cut to finitely many degree-one coordinates -/

section Cut

variable {X S : Scheme.{u}} (f : X ⟶ S) (L : X.Modules) [IsInvertibleModule X L]

/-- **A finite covering subfamily of global sections, padded to a `Fin (n + 1)`.** A family
indexed by an arbitrary type whose nonvanishing opens cover `X` at the members of a finite subset
is reindexed to `Fin (n + 1)` by adjoining the zero section, and the reindexed family generates
every stalk. -/
theorem exists_fin_generatesStalks_of_finset {ι : Type*} (t : ι → Γ(L, ⊤)) (T : Finset ι)
    (hT : ∀ x : X, ∃ i ∈ T, x ∈ nvCover t i) :
    ∃ (n : ℕ) (s : Fin (n + 1) → Γ(L, ⊤)), GeneratesStalks s := by
  classical
  obtain ⟨m, ⟨eqv⟩⟩ : ∃ m : ℕ, Nonempty (↥T ≃ Fin m) := ⟨_, ⟨Finite.equivFin _⟩⟩
  set s : Fin (m + 1) → Γ(L, ⊤) := Fin.lastCases 0 fun k => t (eqv.symm k : ι) with hs
  have hsval : ∀ (i : ι) (hi : i ∈ T), s (eqv ⟨i, hi⟩).castSucc = t i := by
    intro i hi
    simp only [hs, Fin.lastCases_castSucc, Equiv.symm_apply_apply]
  refine ⟨m, s, Stacks.AmpleImmersionReduction.generatesStalks_of_forall_exists_mem s fun x => ?_⟩
  obtain ⟨i, hiT, hx⟩ := hT x
  refine ⟨(eqv ⟨i, hiT⟩).castSucc, ?_⟩
  show x ∈ nvOpen L (s (eqv ⟨i, hiT⟩).castSucc)
  rw [hsval i hiT]
  exact hx

/-- **The standard opens of the degree-one elements cover `Proj Γ(S, Sym(E))`**, for `S` affine.
The section ring is generated in degree one over its degree-zero part by
`Stacks.Tag01VMRelativeVeryAmple.adjoin_symAlgebra_eq_top`, and
`AlgebraicGeometry.Proj.iSup_basicOpen_eq_top'` converts generation into a covering. -/
theorem degreeOpen_symAlgebra_one_eq_top (hS : IsAffineOpen (⊤ : S.Opens)) (E : S.Modules)
    [E.IsQuasicoherent] :
    AlgebraicGeometry.Proj.degreeOpen ((symAlgebra E).grading (⊤ : S.Opens)) 1 = ⊤ := by
  have hset : (Set.range fun g : ((symAlgebra E).grading (⊤ : S.Opens)) 1 =>
      (g : (symAlgebra E).sectionRing ⊤)) =
      ((symAlgebra E).grading (⊤ : S.Opens) 1 : Set ((symAlgebra E).sectionRing ⊤)) := by
    ext y
    refine ⟨fun hy => ?_, fun hy => ⟨⟨y, hy⟩, rfl⟩⟩
    obtain ⟨g, rfl⟩ := hy
    exact g.2
  refine AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' _
    (fun g : ((symAlgebra E).grading (⊤ : S.Opens)) 1 => (g : (symAlgebra E).sectionRing ⊤))
    (fun g => ⟨1, g.2⟩) ?_
  rw [hset]
  exact adjoin_symAlgebra_eq_top E (⊤ : S.Opens) hS

/-- **The inverse image of the degree-one twist along a morphism to `Proj Γ(S, Sym(E))` has a
finite generating family of global sections** — the step of Stacks Tag 02NP that cuts the
coordinates down to finitely many degree-one ones.

`α` factors through the degree-one open `U₁` of [Stacks, Tag 01N5], which is all of `Proj` by
`Stacks.VeryAmpleAffineBase.degreeOpen_symAlgebra_one_eq_top`; the global generation clause of
[Stacks, Tag 01N7],
`Stacks.AlgebraicGeometry.MorphismsIntoProj.generatesStalks_psiPullbackVeroneseHom_one`, generates
the inverse image of the twist by the sections attached to the degree-one elements; and `X` is
quasi-compact because `f` is and the base is affine, so finitely many of those sections already
cover. The family is padded with the zero section to be indexed by a `Fin (n + 1)`.

No immersion hypothesis on `α` is used. -/
theorem exists_generatesStalks_of_pullback_twistingSheaf [QuasiCompact f]
    (hS : IsAffineOpen (⊤ : S.Opens)) (E : S.Modules) [E.IsQuasicoherent]
    (α : X ⟶ AlgebraicGeometry.Proj ((symAlgebra E).grading (⊤ : S.Opens)))
    (e : L ≅ (Scheme.Modules.pullback α).obj
      (twistingSheaf ((symAlgebra E).grading (⊤ : S.Opens)) 1)) :
    ∃ (n : ℕ) (s : Fin (n + 1) → Γ(L, ⊤)), GeneratesStalks s := by
  classical
  set B := (symAlgebra E).grading (⊤ : S.Opens) with hB
  -- `α` factors through the degree-one open, which is everything.
  have hU : AlgebraicGeometry.Proj.degreeOpen B 1 = ⊤ := degreeOpen_symAlgebra_one_eq_top hS E
  have hrange : Set.range α.base ⊆ Set.range (AlgebraicGeometry.Proj.degreeOpen B 1).ι.base := by
    rw [Scheme.Opens.range_ι, hU]
    exact fun x _ => trivial
  obtain ⟨φ, hφ⟩ : ∃ φ : X ⟶ (AlgebraicGeometry.Proj.degreeOpen B 1).toScheme,
      φ ≫ (AlgebraicGeometry.Proj.degreeOpen B 1).ι = α :=
    ⟨IsOpenImmersion.lift _ α hrange, IsOpenImmersion.lift_fac _ α hrange⟩
  -- The pullback twist of the factorisation is the one the hypothesis speaks about.
  have hobj : MorphismsIntoProj.pullbackTwist B φ ((1 * 1 : ℕ) : ℤ) =
      (Scheme.Modules.pullback α).obj (twistingSheaf B 1) := by
    rw [show ((1 * 1 : ℕ) : ℤ) = 1 from by norm_num, ← hφ]
  have hinv : IsInvertibleModule X (MorphismsIntoProj.pullbackTwist B φ ((1 * 1 : ℕ) : ℤ)) :=
    MorphismsIntoProj.isInvertibleModule_pullbackTwist_one B φ
  set e' : MorphismsIntoProj.pullbackTwist B φ ((1 * 1 : ℕ) : ℤ) ≅ L :=
    eqToIso hobj ≪≫ e.symm with he'
  -- The degree-one sections generate.
  have hgen0 : GeneratesStalks
      (fun x : ↥(Stacks.Veronese.veroneseGrading B 1 1) =>
        MorphismsIntoProj.psiPullbackVeroneseHom B φ 1 x) :=
    MorphismsIntoProj.generatesStalks_psiPullbackVeroneseHom_one B φ
  have hgenL : GeneratesStalks
      (fun x : ↥(Stacks.Veronese.veroneseGrading B 1 1) =>
        e'.hom.app ⊤ (MorphismsIntoProj.psiPullbackVeroneseHom B φ 1 x)) :=
    Stacks.ProductFamilyTwist.generatesStalks_congr e' hgen0
  set t : ↥(Stacks.Veronese.veroneseGrading B 1 1) → Γ(L, ⊤) :=
    fun x => e'.hom.app ⊤ (MorphismsIntoProj.psiPullbackVeroneseHom B φ 1 x) with ht
  -- `X` is quasi-compact, so finitely many of them already cover it.
  have hSc : CompactSpace S := ⟨by simpa using hS.isCompact⟩
  have hXc : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨T, hT⟩ : ∃ T : Finset ↥(Stacks.Veronese.veroneseGrading B 1 1),
      (Set.univ : Set X) ⊆ ⋃ i ∈ T, ((nvCover t i : X.Opens) : Set X) :=
    isCompact_univ.elim_finite_subcover (fun i => ((nvCover t i : X.Opens) : Set X))
      (fun i => (nvCover t i).isOpen)
      (fun x _ => Set.mem_iUnion.mpr (exists_mem_nvCover_of_generatesStalks t hgenL x))
  refine exists_fin_generatesStalks_of_finset L t T fun x => ?_
  obtain ⟨i, hiT, hx⟩ := Set.mem_iUnion₂.mp (hT (Set.mem_univ x))
  exact ⟨i, hiT, hx⟩

end Cut

/-! ### The immersion clause of the coordinate cut -/

/-- **The immersion clause of the coordinate cut of Stacks Tag 02NP**, with the twist obligation
discharged: from an immersion over an affine base into the absolute homogeneous spectrum of
`Γ(S, Sym(E))` carrying the degree-one twist to `L`, a finite generating family of global
sections of `L` whose pinned morphism to `ℙⁿ_S` is an immersion.

**It is a theorem**, `Stacks.CoordinateImmersion.projCoordinateImmersion`; it is kept as a named
`Prop` because it is the clause the rest of this file reduces the tag to.

This is `Stacks.VeryAmpleAffineBase.ProjCoordinateCut` with everything about `𝒪(1)` removed —
`Stacks.VeryAmpleAffineBase.hasImmersionTwistOver_of_generatesStalks` supplies that for free — and
it is *not* vacuous in its generation clause: a finite generating family always exists, by
`Stacks.VeryAmpleAffineBase.exists_generatesStalks_of_pullback_twistingSheaf`. The content is the
immersion clause: the family has to be chosen so that the morphism it defines is an immersion,
which is the source's choice of coordinates in which the finitely many homogeneous elements
cutting out the cover, and the algebra generators of each chart, are polynomials.

**The choice itself is made**, in
`StacksFrontier/AlgebraicGeometry/VeryAmpleAffineBase/CoordinateChoice.lean`, with no hypothesis:

* `Stacks.CoordinateChoice.exists_fin_basicOpen_cover_le_coborderRange` is the finite cover of `X`
  by the charts `α⁻¹(D₊(f_j))` of standard opens of homogeneous elements of positive degree
  inside `Scheme.Hom.coborderRange`, on which `α` is a closed immersion
  (`Stacks.CoordinateChoice.isClosedImmersion_restrict_basicOpen`) and the chart is affine
  (`Stacks.CoordinateChoice.isAffineOpen_preimage_basicOpen`);
* `Stacks.CoordinateChoice.exists_finset_away_forall_mem_closure` writes the algebra generators of
  each chart over the base as fractions `f_{j,k} / f_j^{e}` — [Stacks, Tag 01T2] at the chart;
* `Stacks.CoordinateChoice.exists_fin_mem_adjoin_range` chooses the finitely many degree-one
  `y_0, …, y_n` in which every `f_j` and every `f_{j,k}` is a polynomial, out of
  `Stacks.Tag01VMRelativeVeryAmple.adjoin_symAlgebra_eq_top`;
* `Stacks.CoordinateChoice.exists_mem_preimage_basicOpen_of_mem_adjoin` is the generation clause
  at that choice: the charts `α⁻¹(D₊(y_i))` cover `X`, because a homogeneous element of positive
  degree in the subalgebra generated by the `y_i` lies in the ideal they span, and the
  nonvanishing locus of the section of `α⁎𝒪(1)` attached to `y_i` is `α⁻¹(D₊(y_i))` by
  `Stacks.AlgebraicGeometry.MorphismsIntoProj.nonvanishingLocus_psiPullbackHom_one`.

What the choice leaves is the *verification* that the chosen family defines an immersion. The
chart machinery does not do it: `Stacks.ChartImmersionFinish.isImmersion_of_closure_subcover`,
`Stacks.ChartDictionary.isImmersion_of_closure` and
`Stacks.AmpleImmersionReduction.isImmersion_of_isImmersion_standardChart` all ask for the chart
`X_{s_i}` of a *member of the family* to be affine, and `α⁻¹(D₊(y))` for `y` of degree one is not
— which is exactly why the source cuts with the `f_j` and not with the coordinates.

The cheapest route that does not need the standard open `D₊(F)` of a homogeneous polynomial in
`ℙⁿ_S` keeps everything inside one coordinate chart, and all of its glue is available.
`p⁻¹(D₊(T_i)) = X_{s_i}` is `Stacks.AmpleImmersionReduction.preimage_standardChart`, and on that
chart the pinning hypothesis *is* the description of `p`. Inside the affine chart `D₊(T_i)` over
an affine open of `S`, cover `X_{s_i}` by the opens `X_{s_i} ∩ α⁻¹(D₊(f_j))`: each is the basic
open of the *affine* `α⁻¹(D₊(f_j))` at the degree-zero fraction `y_i^{d_j} / f_j`, hence affine,
and `AlgebraicGeometry.Scheme.preimage_basicOpen` identifies it with the preimage of the basic
open of `D₊(T_i)` at `F_j / T_i^{d_j}`, for `F_j` a homogeneous polynomial with `F_j(y) = f_j`.
The glue is then `Stacks.ChartImmersionAssembly.isImmersion_of_isImmersion_restrict_of_cover` —
in its range form, since those basic opens do not cover `ℙⁿ_S` — together with
`Stacks.FiniteFactorization.isClosedImmersion_morphismRestrict`, which asks only for an affine
open of the target whose preimage is affine and over which the map on sections is surjective. The
surjectivity is what the choice above was made for: a generator `b / f_j^k` of
`Γ(X, α⁻¹(D₊(f_j)))` is `(b / y_i^{k d_j}) · (f_j / y_i^{d_j})^{-k}`, where `b / y_i^{k d_j}` is a
polynomial in the ratios `y_m / y_i` because `b` is an `A₀`-combination of monomials of degree
`k d_j` in the `y`, and `f_j / y_i^{d_j}` is invertible on the chart.

What that route needs is the *section-value dictionary*: that the function on `X_{s_i}` attached
to a degree-zero fraction in the `y` is the corresponding expression in the coordinate ratios of
the pinned family. Every step above is an identity between two such functions.
**That dictionary is available**, in
`StacksFrontier/AlgebraicGeometry/VeryAmpleAffineBase/SectionDictionary.lean` and its consumer file
`CoordinateCharts.lean`: `Stacks.CoordinateDictionary.resO_ratio_eq_pullbackAwayCoord` says that
the ratio `s_k / s_i` of the family attached to degree-one elements `y_i` of the graded ring is
the inverse image along `α` of the degree-zero fraction `y_k / y_i`, and
`Stacks.CoordinateDictionary.resO_ratio_eq_pullbackAwayCoord_of_le_preimage` is the same with the
inclusion `α⁻¹(D₊(y_i)) ≤ X_{s_i}` discharged. The generation clause at those sections is
`Stacks.CoordinateDictionary.generatesStalks_coordFamily`.

What remains on top of it is **the surjectivity**, which has one algebraic ingredient and
one geometric one. **The algebraic one is proved in full**, in
`StacksFrontier/AlgebraicGeometry/VeryAmpleAffineBase/AwayFraction.lean` and
`StacksFrontier/AlgebraicGeometry/VeryAmpleAffineBase/OverlapFraction.lean`:

* `Stacks.AwayFraction.mk_mem_closure_of_mem_adjoin`: a homogeneous element `b` of degree `D` of
  the subalgebra generated over `A₀` by the degree-one `y_i` has `b / y_i^D` in the subring of
  `A₍y_i₎` generated by the degree-zero constants together with the ratios `y_m / y_i` — the
  decomposition of `b` being
  `Stacks.DegreeOneMonomial.exists_sum_monomials_of_mem_adjoin` and the push through
  `HomogeneousLocalization.Away.mk` being that file's fraction arithmetic.
  `Stacks.AwayFraction.mk_mem_closure_awayCoord` is the same with the ratios spelled as
  `Stacks.CoordinateDictionary.awayCoord`, which is the spelling the dictionary above converts
  into `chartRatio s i`.
* `Stacks.OverlapFraction.mk_mul_restrictCoord_pow`: whenever `D₊(g) ⊆ D₊(y_i)`, the generator
  `b / g^k` of the chart satisfies `(b/g^k)·(g/y_i^{d})^k = b/y_i^{k d}` in `A₍g₎`, and
  `Stacks.OverlapFraction.mk_mem_closure_mk` concludes — with no hypothesis beyond the choice
  data, the inverse of `g/y_i^{d}` being exhibited as `y_i^{d}/g` — that `b / g^k` lies in the
  subring generated by the degree-zero constants, the restricted ratios, and that inverse.

The containment `D₊(g) ⊆ D₊(y_i)` that the last item asks for costs nothing: the cut may be made
with `g := y_i f_j` instead of `f_j`, which is again homogeneous of positive degree, whose
standard open `D₊(y_i f_j) = D₊(y_i) ⊓ D₊(f_j)` still lies in `α.coborderRange`, and whose chart
is therefore still affine with `α` a closed immersion over it and its sections still fractions —
all by `Stacks.CoordinateChoice.isAffineOpen_preimage_basicOpen`,
`Stacks.CoordinateChoice.isClosedImmersion_restrict_basicOpen` and
`Stacks.CoordinateChoice.surjective_awayToChart` applied at `y_i f_j`. So no separate treatment
of an overlap is needed: the refined charts are charts of the same family.

The comparison of `AlgebraicGeometry.Proj.awayToSection 𝒜 g_j` with
`AlgebraicGeometry.Proj.awayToSection 𝒜 y_i` on the overlap, which that step needs, **is available as
well**: `ProjectiveSpectrum.degreeZeroRingMap` is the restriction
`A₍f₎ ⟶ A₍h₎` attached to `D₊(h) ⊆ D₊(f)`,
`ProjectiveSpectrum.awayToSection_degreeZeroRingMap` identifies it with the restriction map of the
structure sheaf of `Proj`, and `ProjectiveSpectrum.isLocalizationAway_degreeZeroRingMap` says that
`A₍h₎` is the localization of `A₍f₎` at `h^{deg f}/f^{deg h}` — which for `f = y_i` of degree one
and `h = y_i g_j` is exactly the `g_j / y_i^{d_j}` being inverted.

The geometric ingredient has since been built, and must not be rebuilt either. Writing
`g := y_i f_j` for the refined cut:

* **the overlap chart is affine, at the spelling the cut produces it.**
  `Stacks.ProjChartBasicOpen.basicOpen_appLE_awayToSection_mk` exhibits
  `α⁻¹(D₊(y_i)) ⊓ α⁻¹(D₊(g))` as the nonvanishing locus, inside the coordinate chart, of the
  inverse image of the degree-zero fraction `g / y_i^{1 + d_j}`, and
  `Stacks.OverlapChart.isAffineOpen_basicOpen_appLE_mul` says that open is affine — the overlap
  is the chart `α⁻¹(D₊(g))` itself, because `D₊(g) ≤ D₊(y_i)`
  (`Stacks.OverlapChart.preimage_basicOpen_inf_mul`), and that chart is a cutting chart of the
  same kind (`Stacks.OverlapChart.isAffineOpen_preimage_basicOpen_mul`,
  `Stacks.OverlapChart.isClosedImmersion_restrict_basicOpen_mul`,
  `Stacks.OverlapChart.surjective_awayToChart_mul`).
* **the section-value dictionary applies to a whole chart generator, not only to one ratio.**
  `Stacks.CoordinateDictionary.pullbackAway` packages the inverse image of a degree-zero fraction
  as a *ring homomorphism* `A₍y_i₎ ⟶ Γ(X, W)`, so
  `Stacks.CoordinateDictionary.pullbackAway_mk_finsuppProd` reads a monomial of the coordinates
  divided by `y_i^N` as the same monomial in the ratios `s_m / s_i`, and
  `Stacks.CoordinateDictionary.pullbackAway_mk_mem_closure` puts the inverse image of
  `b / y_i^D` in the subring generated by the inverse images of the degree-zero constants
  together with those ratios.
* **the closure-to-surjectivity step at a standard open of the target.**
  `Stacks.OverlapSurjectivity.surjective_appLE_basicOpen_of_closure`: for an affine open `U` of
  the target whose inverse image is `W` and a section `t` of it, the map on sections from the
  standard open of `t` to the standard open of its image is surjective as soon as the restricted
  images of `Γ(U)` and one inverse of the restricted image of `t` generate — and
  `Stacks.OverlapSurjectivity.isClosedImmersion_morphismRestrict_basicOpen` then makes the
  restriction over that standard open a closed immersion, through
  `Stacks.FiniteFactorization.isClosedImmersion_morphismRestrict`. The inverse is the one
  `Stacks.OverlapFraction.restrictCoord_mk_mul_mk_eq_one` exhibits, and the generation is
  `Stacks.OverlapFraction.mk_mem_closure_mk` transported by the dictionary.
* **the inverse image along the pinned morphism of a standard open of the target.**
  `Stacks.OverlapSurjectivity.preimage_basicOpen_eq` for a section of the chart, and
  `Stacks.ChartPolynomialOpen.preimage_basicOpen_eq_basicOpen` for a homogeneous polynomial with
  *integer* coefficients, which generalises
  `Stacks.AmpleImmersionReduction.preimage_standardChart` from the variables to any homogeneous
  element of positive degree.

The `ℙⁿ_S` side of the dictionary is available as well:
`Stacks.ChartDictionary.appLE_chartCoordChart` sends the chart coordinate `T_k/T_i` to
`Stacks.ProjectiveFromSections.ratio s i k`, `Stacks.ChartDictionary.appLE_baseSection` sends a
section of `𝒪_S(V)` to its image under `f.appLE V (X_{s_i})`, and
`Stacks.ChartDictionary.isAffineOpen_chartOpenOver` says the chart `D₊(T_i) ⊓ pr⁻¹(V)` is affine
for affine `V`, which is the affine open the surjectivity step above is applied at.

**The comparison of structure morphisms is available.** The
decomposition of `f_j` in the coordinates has coefficients in `A₀`, the degree-zero part of
`Γ(S, Sym(E))`, while the cutting section `t` on `D₊(T_i) ⊓ pr⁻¹(V)` has coefficients in
`𝒪_S(V)`; the two dictionaries therefore meet only once the inverse image along `α` of a
degree-zero constant is known to be the inverse image along `f` of a section of the base. It is:

* `Stacks.BaseSectionDictionary.projStructureHom_eq` says that
  `Stacks.VeryAmpleAffineBase.projStructureHom` **is** `AlgebraicGeometry.Proj.toSpecZero`
  followed by `Spec` of the degree-zero structure map and
  `AlgebraicGeometry.IsAffineOpen.fromSpec` of the base — by definition; the
  identity is also recorded (as a `rfl`) at
  `StacksFrontier/AlgebraicGeometry/RelativeProjFiniteType/Basic.lean`.
* `Stacks.BaseSectionDictionary.toSpecZero_appLE_basicOpen` reads `Proj.toSpecZero` on the
  sections of a standard open: it is `HomogeneousLocalization.fromZeroRingHom` followed by
  `AlgebraicGeometry.Proj.awayToSection`.
* `Stacks.BaseSectionDictionary.appLE_top_eq` is the comparison itself, as an equality of ring
  maps `Γ(S, ⊤) ⟶ Γ(X, W)`, and
  `Stacks.BaseSectionDictionary.pullbackAway_algebraMap_strZeroSheaf` is it in the spelling the
  dictionary consumes.
* `Stacks.SymGraded.surjective_strZeroSheaf` says every degree-zero constant *does* come from a
  base section — the degree-zero part of `Sym(E)` being the structure sheaf, which is
  `Stacks.LocallyProjectiveHProjective.exists_strHom_eq`.
* `Stacks.CoefficientBridge.pullbackAway_mk_mem_closure_base` puts the four together: the inverse
  image of a chart generator `b / y_i^D` lies in the subring generated by the inverse images
  along `f` of the sections of `𝒪_S` together with the coordinate ratios `s_m / s_i`, which is
  exactly the generating set `Stacks.ChartDictionary.surjective_appLE_chartOpenOver` asks for.

**One further equality of opens is needed for the same reason.**
`Stacks.CoordinateDictionary.preimage_basicOpen_eq_nvCover`: the coordinate chart `X_{s_i}` *is*
`α⁻¹(D₊(y_i))`, not merely a superset. The cut needs both directions, because the inverse image
along the pinned morphism of a standard open of `D₊(T_i)` is computed inside `X_{s_i}`
(`Stacks.AmpleImmersionReduction.preimage_standardChart`) while the fraction dictionary produces
its sections over `α⁻¹(D₊(y_i))`.

**This condition is a theorem**,
`Stacks.CoordinateImmersion.projCoordinateImmersion`, proved in three steps, the first of which
needs the coordinates to be chosen twice.

1. **The surjectivity at the overlap chart.** `Stacks.CoefficientBridge
   .pullbackAway_mk_mem_closure_base` is stated at an open `W` inside `α⁻¹(D₊(y_i))` and for a
   generator `b / y_i^D`. The generators of `Γ(X, α⁻¹(D₊(y_i f_j)))` are the fractions
   `b / (y_i f_j)^k` of `Stacks.OverlapChart.surjective_awayToChart_mul`, and the algebraic
   input for them is `Stacks.OverlapFraction.mk_mem_closure_mk`, whose generating set is the
   degree-zero constants, the *restricted* ratios `Stacks.OverlapFraction.restrictCoord` and the
   inverse `y_i^{d}/(y_i f_j)` of
   `Stacks.OverlapFraction.restrictCoord_mk_mul_mk_eq_one`. The remaining dictionary step —
   the restricted ratio identified with the restriction of
   `Stacks.ProjectiveFromSections.ratio s i k` — is
   `Stacks.OverlapDictionary.pullbackAway_restrictCoord_coord`, through
   `Stacks.OverlapDictionary.pullbackAway_degreeZeroRingMap`, which is
   `ProjectiveSpectrum.awayToSection_degreeZeroRingMap` read on a scheme over `Proj A`; the whole
   generating set is transported in
   `Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap_base`, whose base-section half is
   `Stacks.BaseSectionDictionary.pullbackAway_algebraMap_mem_range` at `q = y_i f_j`.

   **The coordinates have to be chosen twice.**
   `Stacks.OverlapFraction.mk_mem_closure_mk` asks that the numerator `b` of a generator of the
   *overlap* chart lie in the subalgebra generated by the coordinates — but the overlap chart
   `α⁻¹(D₊(y_i f_j))`, hence its generators, depends on the choice of `y_i`. So
   `Stacks.CoordinateChoice.exists_fin_mem_adjoin_range` is applied twice: once to the `f_j`, to
   get a family `y⁰` for which the overlap charts `α⁻¹(D₊(y⁰_i f_j))` already cover `X`, and then
   to the numerators of the generators of those charts. The second application has to return a
   family *containing* `y⁰`, since the overlap chart must lie in the pinning chart of a member of
   the final family; that is
   `Stacks.CoordinateImmersion.exists_fin_mem_adjoin_range_subset`.
2. **The cutting section `t` of the target chart** is
   `Stacks.CoordinateImmersion.exists_cuttingSection`: the section cutting `α⁻¹(D₊(y_i f_j))` out
   of `X_{s_i}` is `Stacks.ProjChartBasicOpen.basicOpen_appLE_awayToSection_mk` at `a = y_i f_j`,
   it is in the range of `p` on sections by 1., its standard open is the overlap by
   `Stacks.OverlapChart.preimage_basicOpen_inf_mul`, that open is affine by
   `Stacks.OverlapChart.isAffineOpen_preimage_basicOpen_mul`, and
   `Stacks.OverlapSurjectivity.preimage_basicOpen_eq` together with
   `Stacks.OverlapSurjectivity.isClosedImmersion_morphismRestrict_basicOpen` makes `p` a closed
   immersion over `(ℙⁿ_S)_t`.
3. **The assembly** is `Stacks.ChartImmersionAssembly.isImmersion_of_isImmersion_restrict_of_cover`
   at the cover of `X` by the `α⁻¹(D₊(y⁰_i f_j))` — `AlgebraicGeometry.Proj.basicOpen_mul` putting
   a point of `α⁻¹(D₊(f_j))` ⊓ `α⁻¹(D₊(y⁰_i))` in the product's chart — and the family of target
   opens `(ℙⁿ_S)_{t_{i,j}}`.

The [Stacks, Tag 01MY] machinery for the route through `r_ψ ∘ α` is also available — the open `U(ψ)`, the morphism and its comparison maps on the twists are
`Stacks.AlgebraicGeometry.ProjShared.mapDomain`,
`Stacks.AlgebraicGeometry.ProjTwistChain.mapHom` and
`Stacks.AlgebraicGeometry.ProjTwistCompare.twistMap`, bundled as
`Stacks.AlgebraicGeometry.ProjTwistCompare.projMapData`, and the inverse images of the standard
opens, which identify `r_ψ⁻¹(D₊(F_j))` with `D₊(f_j)`, are Tag 01MY part (2) in
`StacksFrontier/AlgebraicGeometry/ProjTwistChain/MY.lean` — but that route still owes the passage
to this file's *pinned* formulation: the conclusion here is about the morphism that a family of
global sections of `L` defines chart by chart, not about `r_ψ ∘ α`. -/
def ProjCoordinateImmersion : Prop :=
  ∀ {X S : Scheme.{u}} (f : X ⟶ S) (L : X.Modules) [IsInvertibleModule X L]
    [LocallyOfFiniteType f] [QuasiCompact f] (hS : IsAffineOpen (⊤ : S.Opens))
    (E : S.Modules) [E.IsQuasicoherent]
    (α : X ⟶ AlgebraicGeometry.Proj ((symAlgebra E).grading (⊤ : S.Opens))),
    IsImmersion α → α ≫ projStructureHom (symAlgebra E) hS = f →
      (L ≅ (Scheme.Modules.pullback α).obj
        (twistingSheaf ((symAlgebra E).grading (⊤ : S.Opens)) 1)) →
      ∃ (n : ℕ) (s : Fin (n + 1) → Γ(L, ⊤)), GeneratesStalks s ∧
        ∀ p : X ⟶ projectiveSpaceOver n S,
          p ≫ pullback.fst (terminal.from S)
              (terminal.from (projectiveSpaceAtUniverse.{u} n)) = f →
            (∀ i, (nvCover s i).ι ≫ p ≫ projectiveSpaceOver.toIntegralAtUniverse n S =
              toProjectiveSpaceAtUniverse (chartRatio s i) (span_range_chartRatio s i)) →
            IsImmersion p

/-- **`Stacks.VeryAmpleAffineBase.ProjCoordinateCut` from
`Stacks.VeryAmpleAffineBase.ProjCoordinateImmersion`.** The twist identification that
`ProjCoordinateCut` asks for is not an input: it is
`Stacks.AmpleImmersionReduction.twistPullback`, through
`Stacks.VeryAmpleAffineBase.hasImmersionTwistOver_of_generatesStalks`. -/
theorem projCoordinateCut_of_projCoordinateImmersion
    (h : ProjCoordinateImmersion.{u}) : ProjCoordinateCut.{u} := by
  intro X S f L _ _ _ hS E _ α hα hover e
  obtain ⟨n, s, hgen, himm⟩ := h f L hS E α hα hover e
  exact hasImmersionTwistOver_of_generatesStalks f L s hgen himm

end Stacks.VeryAmpleAffineBase

end
