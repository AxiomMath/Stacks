module

public import StacksFrontier.AlgebraicGeometry.ProjGradedModuleQcoh.StructureRestriction
public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.CoefficientBridge
public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.OverlapChart
public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.OverlapFraction

/-!
# The section-value dictionary at the overlap chart of Stacks Tag 02NP

`Stacks.CoefficientBridge.pullbackAway_mk_mem_closure_base` reads a chart generator `b / y_i^D` of
a *coordinate* chart as a polynomial in the coordinate ratios with base-section coefficients. The
coordinate cut of [Stacks, Tag 02NP] consumes the same statement at the **overlap** chart
`α⁻¹(D₊(y_i g))`, whose sections are the fractions `b / (y_i g)^k`
(`Stacks.OverlapChart.surjective_awayToChart_mul`) and whose algebraic input is therefore
`Stacks.OverlapFraction.mk_mem_closure_mk` — generated by the degree-zero constants, the
*restricted* ratios `Stacks.OverlapFraction.restrictCoord` and one inverse of `y_i^{d}/(y_i g)`.

This file transports that generating set along `α`. The one thing it needs and nothing had is the
compatibility of `Stacks.CoordinateDictionary.pullbackAway` with the restriction maps of `Proj`:
the inverse image along `α` of the restriction of a degree-zero fraction *is* the inverse image of
the fraction, over the smaller open. That is
`ProjectiveSpectrum.awayToSection_degreeZeroRingMap` read on a scheme over `Proj A`, and with it
`Stacks.OverlapFraction.restrictCoord` carries the one-ratio dictionary verbatim: the restricted
ratio is the restriction of `Stacks.ProjectiveFromSections.ratio`.

## Main results

* `Stacks.OverlapDictionary.pullbackAway_degreeZeroRingMap`: **the inverse image of a restricted
  fraction is the inverse image of the fraction.**
* `Stacks.OverlapDictionary.awayToChart_eq_pullbackAway`:
  `Stacks.CoordinateChoice.awayToChart` is `Stacks.CoordinateDictionary.pullbackAway` over the
  whole chart.
* `Stacks.OverlapDictionary.pullbackAway_restrictCoord_coord`: **the dictionary at the overlap
  chart** — the restricted ratio `y_k/y_i` is the restriction of `ratio s i k`.
* `Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap`: the generator `b / g^k` of the
  overlap chart lies in the subring generated by the inverse images of the degree-zero constants,
  the restricted coordinate ratios, and the inverse of the cutting fraction.
* `Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap_base`: the same with **base
  sections** in place of the degree-zero constants, by
  `Stacks.BaseSectionDictionary.pullbackAway_algebraMap_mem_range` — which is stated at an
  arbitrary homogeneous element of positive degree and so applies at `y_i g` directly.

## References

* [Stacks Project, Tag 02NP](https://stacks.math.columbia.edu/tag/02NP)
* [Stacks Project, Tag 01M4](https://stacks.math.columbia.edu/tag/01M4)
* [Stacks Project, Tag 01NA](https://stacks.math.columbia.edu/tag/01NA)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open HomogeneousLocalization
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.CoordinateDictionary
open Stacks.ProjectiveFromSections
open Stacks.Tag01VMRelativeVeryAmple
open Stacks.VeryAmpleAffineBase

universe u w

namespace Stacks.OverlapDictionary

section Dictionary

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {X : Scheme.{u}} (α : X ⟶ AlgebraicGeometry.Proj 𝒜)

/-! ### The inverse image of a fraction under restriction -/

/-- **Restricting the inverse image of a degree-zero fraction is the inverse image over the
smaller open.** -/
theorem resO_pullbackAway {q : A} {W W' : X.Opens}
    (hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 q) (h : W' ≤ W) (z : Away 𝒜 q) :
    resO h (pullbackAway 𝒜 α hle z) = pullbackAway 𝒜 α (h.trans hle) z :=
  CategoryTheory.ConcreteCategory.congr_hom (Scheme.Hom.appLE_map α hle (homOfLE h).op)
    ((AlgebraicGeometry.Proj.awayToSection 𝒜 q).hom z)

/-- **The inverse image of a degree-zero fraction, written out**:
`AlgebraicGeometry.Proj.awayToSection` followed by `α` on sections. -/
theorem pullbackAway_apply {q : A} {W : X.Opens}
    (hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 q) (z : Away 𝒜 q) :
    pullbackAway 𝒜 α hle z =
      (α.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 q) W hle).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 q).hom z) := rfl

/-- **The inverse image along `α` of the restriction `A₍q₎ ⟶ A₍g₎` of a degree-zero fraction is
the inverse image of the fraction itself**, over an open inside the smaller chart.

`ProjectiveSpectrum.awayToSection_degreeZeroRingMap` identifies
`ProjectiveSpectrum.degreeZeroRingMap` with the restriction map of the structure sheaf of `Proj`,
and `AlgebraicGeometry.Scheme.Hom.map_appLE` absorbs that restriction into
`AlgebraicGeometry.Scheme.Hom.appLE`. -/
theorem pullbackAway_degreeZeroRingMap {q g : A} (hq : ∃ e : ℕ, 0 < e ∧ q ∈ 𝒜 e)
    (hg : ∃ e : ℕ, 0 < e ∧ g ∈ 𝒜 e)
    (hgq : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 q)
    {W : X.Opens} (hleg : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g)
    (hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 q) (z : Away 𝒜 q) :
    pullbackAway 𝒜 α hleg (ProjectiveSpectrum.degreeZeroRingMap 𝒜 q g hq hg hgq z) =
      pullbackAway 𝒜 α hle z := by
  have key := ProjectiveSpectrum.awayToSection_degreeZeroRingMap 𝒜 q g hq hg hgq
  have h3 := Scheme.Hom.map_appLE α hleg (homOfLE hgq).op
  have h2 : CommRingCat.ofHom
        (ProjectiveSpectrum.degreeZeroRingMap 𝒜 q g hq hg hgq).toRingHom ≫
        AlgebraicGeometry.Proj.awayToSection 𝒜 g ≫
          α.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 g) W hleg =
      AlgebraicGeometry.Proj.awayToSection 𝒜 q ≫
        α.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 q) W hle :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (fun φ => φ ≫ α.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 g) W hleg) key).trans
        ((Category.assoc _ _ _).trans
          (congrArg (fun φ => AlgebraicGeometry.Proj.awayToSection 𝒜 q ≫ φ) h3)))
  have h4 := CategoryTheory.ConcreteCategory.congr_hom h2 z
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_ofHom, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom] at h4
  exact h4

variable [IsImmersion α]

omit [IsImmersion α] in
/-- **`Stacks.CoordinateChoice.awayToChart` is
`Stacks.CoordinateDictionary.pullbackAway` over the whole chart.** -/
theorem awayToChart_eq_pullbackAway (g : A) (z : Away 𝒜 g) :
    Stacks.CoordinateChoice.awayToChart 𝒜 α g z =
      pullbackAway 𝒜 α
        (le_rfl : α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g ≤
          α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g) z := by
  have h : α.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 g)
      (α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g) le_rfl =
      α.app (AlgebraicGeometry.Proj.basicOpen 𝒜 g) := Scheme.Hom.appLE_eq_app α
  exact (CategoryTheory.ConcreteCategory.congr_hom h
    ((AlgebraicGeometry.Proj.awayToSection 𝒜 g).hom z)).symm

end Dictionary

/-! ### The dictionary at the overlap chart -/

section Family

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {X : Scheme.{u}} (α : X ⟶ AlgebraicGeometry.Proj 𝒜)
  {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L]

/-- **The one dictionary step the coordinate cut of [Stacks, Tag 02NP] was missing.** On an open
inside the overlap chart `α⁻¹(D₊(g))` the inverse image along `α` of the *restricted* coordinate
ratio `Stacks.OverlapFraction.restrictCoord` of `y_k/y_i` is the restriction of the coordinate
ratio `s_k/s_i` of the pinned family.

`Stacks.OverlapDictionary.pullbackAway_degreeZeroRingMap` removes the restriction, and
`Stacks.CoordinateDictionary.resO_ratio_eq_pullbackAwayCoord_of_le_preimage` is then the
one-ratio dictionary itself. -/
theorem pullbackAway_restrictCoord_coord (hgen : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤)
    (e : pullbackTwistOne 𝒜 α ≅ L) {ι : Type*} (y : ι → 𝒜 1) (s : ι → Γ(L, ⊤))
    (hs : ∀ j, s j = e.hom.app ⊤ (coordSection 𝒜 α (y j))) (i : ι) {dg : ℕ} {g : A}
    (hg : g ∈ 𝒜 dg) (hdg : 0 < dg)
    (hgq : ProjectiveSpectrum.basicOpen 𝒜 g ≤
      ProjectiveSpectrum.basicOpen 𝒜 ((y i : A))) {W : X.Opens}
    (hleg : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g)
    (hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 ((y i : A))) (k : ι) :
    pullbackAway 𝒜 α hleg (Stacks.OverlapFraction.restrictCoord 𝒜 (y i).2 hg hdg hgq
        (Away.mk 𝒜 (y i).2 1 ((y k : A)) (by simpa using (y k).2))) =
      resO (hle.trans (preimage_basicOpen_le_nvCover 𝒜 α hgen e y s hs i)) (ratio s i k) := by
  rw [pullbackAway_degreeZeroRingMap 𝒜 α ⟨1, Nat.one_pos, (y i).2⟩ ⟨dg, hdg, hg⟩ hgq hleg hle,
    resO_ratio_eq_pullbackAwayCoord_of_le_preimage 𝒜 α hgen e y s hs i k hle]
  rfl

/-- **The generator of the overlap chart of [Stacks, Tag 02NP], read on `X`.** Let `y` be a family
of degree-one elements, `g` homogeneous of positive degree `dg` with `D₊(g) ⊆ D₊(y_i)`, and `b`
homogeneous of degree `k · dg` lying in the subalgebra generated over `𝒜 0` by the family. Then the
inverse image along `α` of the fraction `b / g^k` lies in the subring of `Γ(X, W)` generated by the
inverse images of the degree-zero constants, the restrictions of the coordinate ratios `s_m/s_i`,
and the inverse image of `y_i^{dg}/g`.

This is `Stacks.OverlapFraction.mk_mem_closure_mk` pushed through the ring homomorphism
`Stacks.CoordinateDictionary.pullbackAway`, the images of the generators being computed by
`Stacks.OverlapDictionary.pullbackAway_restrictCoord_coord`. -/
theorem pullbackAway_mk_mem_closure_overlap (hgen : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤)
    (e : pullbackTwistOne 𝒜 α ≅ L) {ι : Type*} (y : ι → 𝒜 1) (s : ι → Γ(L, ⊤))
    (hs : ∀ j, s j = e.hom.app ⊤ (coordSection 𝒜 α (y j))) (i : ι) {dg : ℕ} {g : A}
    (hg : g ∈ 𝒜 dg) (hdg : 0 < dg)
    (hgq : ProjectiveSpectrum.basicOpen 𝒜 g ≤
      ProjectiveSpectrum.basicOpen 𝒜 ((y i : A))) {W : X.Opens}
    (hleg : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g)
    (hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 ((y i : A)))
    {k : ℕ} {b : A} (hb : b ∈ 𝒜 (k * dg))
    (hbmem : b ∈ Algebra.adjoin (𝒜 0) (Set.range fun j => ((y j : A)))) :
    pullbackAway 𝒜 α hleg (Away.mk 𝒜 hg k b (by simpa using hb)) ∈
      Subring.closure
        ((Set.range (fun r : 𝒜 0 =>
              pullbackAway 𝒜 α hleg (algebraMap (𝒜 0) (Away 𝒜 g) r)) ∪
            Set.range fun m =>
              resO (hle.trans (preimage_basicOpen_le_nvCover 𝒜 α hgen e y s hs i))
                (ratio s i m)) ∪
          {pullbackAway 𝒜 α hleg
            (Away.mk 𝒜 hg 1 ((y i : A) ^ dg)
              (by simpa using SetLike.pow_mem_graded dg (y i).2))}) := by
  classical
  set T : Set Γ(X, W) :=
    (Set.range (fun r : 𝒜 0 =>
          pullbackAway 𝒜 α hleg (algebraMap (𝒜 0) (Away 𝒜 g) r)) ∪
        Set.range fun m =>
          resO (hle.trans (preimage_basicOpen_le_nvCover 𝒜 α hgen e y s hs i))
            (ratio s i m)) ∪
      {pullbackAway 𝒜 α hleg
        (Away.mk 𝒜 hg 1 ((y i : A) ^ dg)
          (by simpa using SetLike.pow_mem_graded dg (y i).2))} with hT
  set u : Set (Away 𝒜 g) :=
    (Set.range (algebraMap (𝒜 0) (Away 𝒜 g)) ∪
        Set.range (fun m : ι => Stacks.OverlapFraction.restrictCoord 𝒜 (y i).2 hg hdg hgq
          (Away.mk 𝒜 (y i).2 1 ((y m : A)) (by simp)))) ∪
      {Away.mk 𝒜 hg 1 ((y i : A) ^ dg)
        (by simpa using SetLike.pow_mem_graded dg (y i).2)} with hu
  have hgenmap : ∀ z ∈ u, pullbackAway 𝒜 α hleg z ∈ Subring.closure T := by
    rw [hu]
    rintro z ((⟨r, rfl⟩ | ⟨m, rfl⟩) | rfl)
    · exact Subring.subset_closure
        (hT ▸ Set.mem_union_left _ (Set.mem_union_left _ ⟨r, rfl⟩))
    · refine Subring.subset_closure
        (hT ▸ Set.mem_union_left _ (Set.mem_union_right _ ⟨m, ?_⟩))
      exact (pullbackAway_restrictCoord_coord 𝒜 α hgen e y s hs i hg hdg hgq hleg hle m).symm
    · exact Subring.subset_closure (hT ▸ Set.mem_union_right _ rfl)
  have hsub : Subring.closure u ≤ Subring.comap (pullbackAway 𝒜 α hleg) (Subring.closure T) :=
    Subring.closure_le.mpr fun z hz => Subring.mem_comap.mpr (hgenmap z hz)
  exact hsub (Stacks.OverlapFraction.mk_mem_closure_mk 𝒜 (fun j => ((y j : A)))
    (fun j => (y j).2) i hg hdg hgq hb hbmem)

end Family

/-! ### The coefficients come from the base -/

section Base

variable {S : Scheme.{u}} (hS : IsAffineOpen (⊤ : S.Opens)) (E : S.Modules)
  [E.IsQuasicoherent] {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L]
  (α : X ⟶ AlgebraicGeometry.Proj ((symAlgebra E).grading (⊤ : S.Opens))) [IsImmersion α]

omit [IsImmersion α] in
/-- **The generator of the overlap chart of [Stacks, Tag 02NP] is a polynomial in the coordinate
ratios with base-section coefficients and one inverse.** This is
`Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap` with the degree-zero constants
replaced by sections of `𝒪_S` pulled back along the structure morphism, by
`Stacks.BaseSectionDictionary.pullbackAway_algebraMap_mem_range` — whose homogeneous element is
arbitrary of positive degree, so it applies at `g` itself — together with
`Stacks.SymGraded.surjective_strZeroSheaf`.

It is the generating set `Stacks.OverlapSurjectivity.surjective_appLE_basicOpen_of_closure` asks
for: the base sections and the ratios are what the morphism to `ℙⁿ_S` reaches on the chart
`D₊(T_i) ⊓ pr⁻¹(⊤)`, and the last generator is the inverse of the section cutting the overlap
out of that chart. -/
theorem pullbackAway_mk_mem_closure_overlap_base
    (hgen : Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      ((((symAlgebra E).grading (⊤ : S.Opens)) 1 :
        Set ((symAlgebra E).sectionRing (⊤ : S.Opens)))) = ⊤)
    (ee : pullbackTwistOne ((symAlgebra E).grading (⊤ : S.Opens)) α ≅ L)
    {ι : Type*} (y : ι → ((symAlgebra E).grading (⊤ : S.Opens)) 1) (s : ι → Γ(L, ⊤))
    (hsy : ∀ j, s j =
      ee.hom.app ⊤ (coordSection ((symAlgebra E).grading (⊤ : S.Opens)) α (y j))) (i : ι)
    {dg : ℕ} {g : (symAlgebra E).sectionRing (⊤ : S.Opens)}
    (hg : g ∈ (symAlgebra E).grading (⊤ : S.Opens) dg) (hdg : 0 < dg)
    (hgq : ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens)) g ≤
      ProjectiveSpectrum.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        ((y i : (symAlgebra E).sectionRing ⊤)))
    {W : X.Opens}
    (hleg : W ≤ α ⁻¹ᵁ
      AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens)) g)
    (hle : W ≤ α ⁻¹ᵁ
      AlgebraicGeometry.Proj.basicOpen ((symAlgebra E).grading (⊤ : S.Opens))
        ((y i : (symAlgebra E).sectionRing ⊤)))
    {f : X ⟶ S} (hf : α ≫ projStructureHom (symAlgebra E) hS = f) (hW : W ≤ f ⁻¹ᵁ ⊤)
    {k : ℕ} {b : (symAlgebra E).sectionRing (⊤ : S.Opens)}
    (hb : b ∈ (symAlgebra E).grading (⊤ : S.Opens) (k * dg))
    (hbmem : b ∈ Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      (Set.range fun j => ((y j : (symAlgebra E).sectionRing ⊤)))) :
    pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α hleg
        (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hg k b (by simpa using hb)) ∈
      Subring.closure
        ((Set.range (fun r : Γ(S, ⊤) => (f.appLE ⊤ W hW).hom r) ∪
            Set.range fun m =>
              resO (hle.trans (preimage_basicOpen_le_nvCover
                  ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee y s hsy i))
                (ratio s i m)) ∪
          {pullbackAway ((symAlgebra E).grading (⊤ : S.Opens)) α hleg
            (Away.mk ((symAlgebra E).grading (⊤ : S.Opens)) hg 1
              ((y i : (symAlgebra E).sectionRing ⊤) ^ dg)
              (by simpa using SetLike.pow_mem_graded dg (y i).2))}) := by
  refine Subring.closure_mono
    (Set.union_subset_union_left _ (Set.union_subset_union_left _ ?_))
    (pullbackAway_mk_mem_closure_overlap ((symAlgebra E).grading (⊤ : S.Opens)) α hgen ee y s hsy
      i hg hdg hgq hleg hle hb hbmem)
  rintro z ⟨r₀, rfl⟩
  exact Stacks.BaseSectionDictionary.pullbackAway_algebraMap_mem_range (symAlgebra E) hS α
    hg hdg hleg hf hW
    (Stacks.SymGraded.surjective_strZeroSheaf E
      (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent E) hS) r₀

end Base

end Stacks.OverlapDictionary

end
