namespace Stacks.VeryAmpleFiniteSections

/-- **A ratio of global sections is a polynomial in the ratios of a generating family.** Let `T`
be a finite family of global sections of an invertible `𝒪_X`-module `L` such that every global
section is a combination of `T` with coefficients pulled back along `f : X ⟶ S` from `Γ(S, 𝒪_S)`.
Then on any open `W` on which `s₀` does not vanish, the ratio `s / s₀` lies in the subring
generated by the base sections and the ratios `t / s₀`, `t ∈ T`. -/
theorem ratio_mem_closure {S X : Scheme.{u}} (f : X ⟶ S) {L : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] (T : Finset Γ(L, ⊤))
    (hT : ∀ s : Γ(L, ⊤), ∃ c : Γ(L, ⊤) → Γ(S, ⊤), s = ∑ t ∈ T, f.appTop (c t) • t)
    (s₀ : Γ(L, ⊤)) {W : X.Opens} (hW : W ≤ nvOpen L s₀) (hWf : W ≤ f ⁻¹ᵁ ⊤) (s : Γ(L, ⊤)) :
    div s₀ hW (resT W s) ∈ Subring.closure
      (Set.range (f.appLE ⊤ W hWf).hom ∪
        (fun t => div s₀ hW (resT W t)) '' (T : Set Γ(L, ⊤))) := by
  obtain ⟨c, hc⟩ := hT s
  have hres : ∀ r : Γ(S, ⊤), resO (le_top : W ≤ ⊤) (f.appTop r) = (f.appLE ⊤ W hWf).hom r :=
    fun _ => rfl
  have key : div s₀ hW (resT W s) =
      ∑ t ∈ T, (f.appLE ⊤ W hWf).hom (c t) * div s₀ hW (resT W t) := by
    refine (eq_div s₀ hW ?_).symm
    rw [Finset.sum_smul, hc]
    have hsum : resT W (∑ t ∈ T, f.appTop (c t) • t) =
        ∑ t ∈ T, resT W (f.appTop (c t) • t) := by
      simp only [resT, resM]
      exact map_sum _ _ _
    rw [hsum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [mul_smul, div_smul]
    change _ = resM (le_top : W ≤ ⊤) _
    rw [resM_smul, hres]
  rw [key]
  refine Subring.sum_mem _ fun t ht => Subring.mul_mem _ ?_ ?_
  · exact Subring.subset_closure (Set.mem_union_left _ ⟨c t, rfl⟩)
  · exact Subring.subset_closure (Set.mem_union_right _ ⟨t, ht, rfl⟩)

/-- **A restricted ratio of a family is a polynomial in the ratios of a generating family.** On
an open `W` inside the nonvanishing locus of `s i`, the restriction of the ratio `s k / s i` lies
in the subring generated by the base sections and the ratios `t / s i`, `t ∈ T`. -/
theorem resO_ratio_mem_closure {S X : Scheme.{u}} (f : X ⟶ S) {L : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] (T : Finset Γ(L, ⊤))
    (hT : ∀ s : Γ(L, ⊤), ∃ c : Γ(L, ⊤) → Γ(S, ⊤), s = ∑ t ∈ T, f.appTop (c t) • t)
    {ι : Type*} (s : ι → Γ(L, ⊤)) {i : ι} {W : X.Opens} (hW : W ≤ nvCover s i)
    (hWf : W ≤ f ⁻¹ᵁ ⊤) (k : ι) :
    resO hW (ratio s i k) ∈ Subring.closure
      (Set.range (f.appLE ⊤ W hWf).hom ∪
        (fun t => div (s i) hW (resT W t)) '' (T : Set Γ(L, ⊤))) := by
  rw [eq_div (s i) hW (resO_ratio_smul s hW k)]
  exact ratio_mem_closure f T hT (s i) hW hWf (s k)

/-- **A ring map is of finite type once its target is generated as a ring by its image and a
finite set.** -/
theorem finiteType_of_closure_eq_top {R B : Type*} [CommRing R] [CommRing B] (φ : R →+* B)
    (G : Finset B) (hG : ∀ b : B, b ∈ Subring.closure (Set.range φ ∪ (G : Set B))) :
    φ.FiniteType := by
  let := φ.toAlgebra
  refine ⟨⟨G, ?_⟩⟩
  rw [← Algebra.toSubring_eq_top, Algebra.adjoin_eq_ring_closure, eq_top_iff]
  exact fun b _ => hG b

/-- **Relative very ampleness over an affine base, with finitely generated global sections,
forces the morphism to be locally of finite type.** Let `S` be affine, `f : X ⟶ S`, and `L` an
`f`-relatively very ample invertible module whose global sections are combinations, with
coefficients pulled back from `Γ(S, 𝒪_S)`, of a finite family `T`. Then `f` is locally of
finite type.

Around a point of `X` the overlap chart `α⁻¹(D₊(y₀ g))` of the immersion
`α : X ⟶ Proj Γ(S, Sym(E))` is affine and its sections are generated over the base by the
ratios `s_y / s_{y₀}` of the degree-one sections and one inverse
(`Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap_base`); by `ratio_mem_closure`
the ratios `t / s_{y₀}`, `t ∈ T`, already generate them. -/
theorem locallyOfFiniteType_of_isRelativelyVeryAmple {S X : Scheme.{u}}
    (hS : IsAffineOpen (⊤ : S.Opens)) (f : X ⟶ S) (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f L) (T : Finset Γ(L, ⊤))
    (hT : ∀ s : Γ(L, ⊤), ∃ c : Γ(L, ⊤) → Γ(S, ⊤), s = ∑ t ∈ T, f.appTop (c t) • t) :
    LocallyOfFiniteType f := by
  classical
  obtain ⟨E, hE, α, hα, hover, ⟨e0⟩⟩ := exists_immersion_proj_of_isRelativelyVeryAmple hS f L hL
  have hgen : Algebra.adjoin (((symAlgebra E).grading (⊤ : S.Opens)) 0)
      ((((symAlgebra E).grading (⊤ : S.Opens)) 1 :
        Set ((symAlgebra E).sectionRing (⊤ : S.Opens)))) = ⊤ :=
    adjoin_symAlgebra_eq_top E (⊤ : S.Opens) hS
  have ee : pullbackTwistOne ((symAlgebra E).grading (⊤ : S.Opens)) α ≅ L := e0.symm
  set 𝒜 := (symAlgebra E).grading (⊤ : S.Opens)
  let B := (symAlgebra E).sectionRing (⊤ : S.Opens)
  let y : 𝒜 1 → 𝒜 1 := id
  let s : 𝒜 1 → Γ(L, ⊤) := fun j => ee.hom.app ⊤ (coordSection 𝒜 α (y j))
  have hsy : ∀ j, s j = ee.hom.app ⊤ (coordSection 𝒜 α (y j)) := fun _ => rfl
  have hadj : Algebra.adjoin (𝒜 0) (Set.range fun j => ((y j : 𝒜 1) : B)) = ⊤ := by
    rw [← hgen]
    congr 1
    ext b
    exact ⟨fun ⟨j, hj⟩ => hj ▸ j.2, fun hb => ⟨⟨b, hb⟩, rfl⟩⟩
  rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFiniteType)
    (RingHom.finiteType_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finiteType_holdsForLocalizationAway).1]
  intro x
  obtain ⟨d, g, hd, hg, hxg, hcob⟩ :=
    Stacks.CoordinateChoice.exists_basicOpen_le_coborderRange 𝒜 α x
  -- a degree-one coordinate whose chart contains `x`
  obtain ⟨y₀, hy₀⟩ := TopologicalSpace.Opens.mem_iSup.mp
    (Stacks.CoordinateChoice.basicOpen_le_iSup_basicOpen_of_mem_adjoin 𝒜
      (fun j => ((y j : 𝒜 1) : B)) (fun j => ⟨1, (y j).2⟩) hd hg (by rw [hadj]; trivial) hxg)
  -- the overlap chart
  set W := α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 ((y₀ : B) * g) with hWdef
  have hxW : x ∈ W := by
    change α.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 ((y₀ : B) * g)
    rw [AlgebraicGeometry.Proj.basicOpen_mul]
    exact ⟨hy₀, hxg⟩
  have hWf : W ≤ f ⁻¹ᵁ ⊤ := le_top
  refine ⟨⟨⊤, hS⟩, ⟨W, Stacks.OverlapChart.isAffineOpen_preimage_basicOpen_mul 𝒜 α y₀.2 hg hcob⟩,
    hxW, hWf, ?_⟩
  have hyg : (y₀ : B) * g ∈ 𝒜 (1 + d) := SetLike.mul_mem_graded y₀.2 hg
  have hgq : ProjectiveSpectrum.basicOpen 𝒜 ((y₀ : B) * g) ≤
      ProjectiveSpectrum.basicOpen 𝒜 ((y y₀ : 𝒜 1) : B) :=
    Stacks.OverlapChart.basicOpen_mul_le_left 𝒜 (y₀ : B) g
  have hle : W ≤ α ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 ((y y₀ : 𝒜 1) : B) :=
    fun _ hz => hgq hz
  have hW0 : W ≤ nvOpen L (s y₀) :=
    hle.trans (preimage_basicOpen_le_nvCover 𝒜 α hgen ee y s hsy y₀)
  let inv : Γ(X, W) := pullbackAway 𝒜 α (le_rfl : W ≤ W)
    (Away.mk 𝒜 hyg 1 (((y y₀ : 𝒜 1) : B) ^ (1 + d))
      (by simpa using SetLike.pow_mem_graded (1 + d) (y y₀).2))
  let G : Finset Γ(X, W) := T.image (fun t => div (s y₀) hW0 (resT W t)) ∪ {inv}
  refine finiteType_of_closure_eq_top _ G fun v => ?_
  obtain ⟨z, rfl⟩ := Stacks.OverlapChart.surjective_awayToChart_mul 𝒜 α y₀.2 hg hcob v
  obtain ⟨k, b, hb, rfl⟩ := Away.mk_surjective 𝒜 hyg z
  rw [Stacks.OverlapDictionary.awayToChart_eq_pullbackAway]
  have hb' : b ∈ 𝒜 (k * (1 + d)) := by simpa using hb
  have hmem := Stacks.OverlapDictionary.pullbackAway_mk_mem_closure_overlap_base hS E α hgen ee
    y s hsy y₀ hyg (by omega) hgq (le_rfl : W ≤ W) hle hover hWf hb' (by rw [hadj]; trivial)
  refine Subring.closure_le.mpr ?_ hmem
  rintro w ((⟨r, rfl⟩ | ⟨m, rfl⟩) | hw)
  · exact Subring.subset_closure (Set.mem_union_left _ ⟨r, rfl⟩)
  · beta_reduce
    refine Subring.closure_mono ?_ (resO_ratio_mem_closure f T hT s hW0 hWf m)
    rintro w (hw | ⟨t, ht, rfl⟩)
    · exact Set.mem_union_left _ hw
    · refine Set.mem_union_right _ ?_
      simp only [G, Finset.coe_union, Finset.coe_image, Finset.coe_singleton]
      exact Set.mem_union_left _ ⟨t, ht, rfl⟩
  · rw [Set.mem_singleton_iff] at hw
    subst hw
    refine Subring.subset_closure (Set.mem_union_right _ ?_)
    simp only [G, Finset.coe_union, Finset.coe_singleton]
    exact Set.mem_union_right _ rfl

end Stacks.VeryAmpleFiniteSections

namespace Stacks.Tag01VMVeryAmple

/-- **Relative very ampleness is invariant under isomorphism of the invertible module.** -/
theorem IsRelativelyVeryAmple.of_iso {S X : Scheme.{u}} {f : X ⟶ S} {L M : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] [Stacks.Ample.IsInvertibleModule X M] (e : L ≅ M)
    (h : IsRelativelyVeryAmple f L) : IsRelativelyVeryAmple f M := by
  obtain ⟨E, hE, i, him, hover, ⟨e'⟩⟩ := h
  exact ⟨E, hE, i, him, hover, ⟨e.symm ≪≫ e'⟩⟩

end Stacks.Tag01VMVeryAmple

end
