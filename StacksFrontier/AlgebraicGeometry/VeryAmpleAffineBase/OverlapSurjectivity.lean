module

public import StacksFrontier.AlgebraicGeometry.FiniteFactorization.FromSubalgebra

/-!
# Surjectivity on sections over a standard open of an affine open of the target

The coordinate cut of [Stacks, Tag 02NP] finishes by feeding
`Stacks.FiniteFactorization.isClosedImmersion_morphismRestrict` an affine open of `ℙⁿ_S` whose
preimage is affine and over which the map on sections is surjective. The affine open is a
*standard open* `Y_t` of the chart `D₊(T_i) ⊓ pr⁻¹(V)`, and the surjectivity over it is not the
surjectivity over the chart: the chart itself has no reason to be mapped onto, because the
generators of the overlap chart are fractions `b / g^k` whose denominators only become invertible
after `t` is inverted.

This file supplies that step, for an arbitrary morphism of schemes. Over an affine open `U` of
the target whose preimage is `W`, the sections over the standard open `Y_t` are `Γ(Y, U)`
localized at `t`, so the image of the map on sections is the subring generated by the restricted
images of `Γ(Y, U)` together with one inverse of the restricted image of `t`. Surjectivity is
therefore exactly the statement that those elements generate — which is what
`Stacks.CoordinateDictionary.pullbackAway_mk_mem_closure` and
`Stacks.OverlapFraction.mk_mem_closure_mk` provide.

## Main results

* `Stacks.OverlapSurjectivity.isUnit_res_appLE`: the restriction to `X_{a}` of the image `a` of
  `t` is a unit, so the inverse the generation hypothesis speaks of exists and is unique.
* `Stacks.OverlapSurjectivity.surjective_appLE_basicOpen_of_closure`: **the
  `Subring.closure`-to-`Function.Surjective` step.** If the restricted images of `Γ(Y, U)`
  together with an inverse of the restricted image of `t` generate `Γ(X, X_{a})` as a ring, then
  the map on sections from `Y_t` to `X_{a}` is surjective.
* `Stacks.OverlapSurjectivity.isClosedImmersion_morphismRestrict_basicOpen`: **the closed
  immersion over the standard open**, which is the form
  `Stacks.ChartImmersionAssembly.isImmersion_of_isImmersion_restrict_of_cover` consumes.

## Implementation notes

The generation hypothesis is stated with *all* of `Γ(Y, U)`, not with a chosen finite generating
set: a generating subset is a special case, and no finiteness is needed for surjectivity.

An inverse of the restriction of `a` is a hypothesis rather than a construction, even though
`Stacks.OverlapSurjectivity.isUnit_res_appLE` says one exists: the consumer produces its own
inverse — `y_i^{d}/g` in the coordinate cut — and uniqueness of inverses in a commutative ring
identifies it with the canonical one, which is what the proof uses.

## References

* [Stacks Project, Tag 02NP](https://stacks.math.columbia.edu/tag/02NP)
* [Stacks Project, Tag 01T2](https://stacks.math.columbia.edu/tag/01T2)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.OverlapSurjectivity

/-- **Restriction of a section of the structure sheaf to its own nonvanishing open**, as a ring
homomorphism. -/
abbrev resBasicOpen {X : Scheme.{u}} {V : X.Opens} (a : Γ(X, V)) :
    Γ(X, V) →+* Γ(X, X.basicOpen a) :=
  (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom

variable {X Y : Scheme.{u}} (g : X ⟶ Y) {U : Y.Opens} {W : X.Opens} (hgU : g ⁻¹ᵁ U = W)
  (t : Γ(Y, U))

/-- **The preimage of the standard open of `t` is the standard open of its image.** -/
theorem preimage_basicOpen_eq :
    g ⁻¹ᵁ Y.basicOpen t = X.basicOpen ((g.appLE U W hgU.ge).hom t) :=
  Stacks.FiniteFactorization.preimage_basicOpen_appLE g hgU.ge hgU.le t

/-- **The restriction of the image of `t` to its own nonvanishing open is a unit**, so an inverse
of it exists and — inverses in a commutative ring being unique — is the only one. -/
theorem isUnit_res_appLE :
    IsUnit (resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom t)) :=
  X.toRingedSpace.isUnit_res_basicOpen ((g.appLE U W hgU.ge).hom t)

/-- **The `Subring.closure`-to-`Function.Surjective` step of the coordinate cut of
[Stacks, Tag 02NP].** Let `U` be an affine open of `Y` whose preimage along `g` is `W`, let
`t : Γ(Y, U)` and let `a` be its image in `Γ(X, W)`. If every section of `Γ(X, X_a)` lies in the
subring generated by the restrictions of the images of the sections over `U` together with an
inverse `w` of the restriction of `a`, then `g` is surjective on sections from `Y_t` to `X_a`.

The sections over `Y_t` are `Γ(Y, U)` localized at `t`
(`AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen`), so the restriction of `t` is a unit
there and the image of its inverse inverts the restriction of `a`; inverses in a commutative ring
being unique, that image *is* `w`. Everything else is in the range of the map on sections because
it is the restriction of something over `U`. -/
theorem surjective_appLE_basicOpen_of_closure (hU : IsAffineOpen U)
    {w : Γ(X, X.basicOpen ((g.appLE U W hgU.ge).hom t))}
    (hw : resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom t) * w = 1)
    (hgen : Subring.closure (Set.range (fun z : Γ(Y, U) =>
        resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom z)) ∪ {w}) = ⊤) :
    Function.Surjective (g.appLE (Y.basicOpen t)
      (X.basicOpen ((g.appLE U W hgU.ge).hom t))
      (preimage_basicOpen_eq g hgU t).ge).hom := by
  classical
  -- Restricting to the standard opens commutes with the map on sections.
  have hkey : ∀ z : Γ(Y, U),
      (g.appLE (Y.basicOpen t) (X.basicOpen ((g.appLE U W hgU.ge).hom t))
          (preimage_basicOpen_eq g hgU t).ge).hom
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le t)).op).hom z) =
      resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom z) :=
    fun z => Stacks.FiniteFactorization.appLE_restrict g (Y.basicOpen_le t)
      (X.basicOpen_le ((g.appLE U W hgU.ge).hom t)) hgU.ge
      (preimage_basicOpen_eq g hgU t).ge z
  -- The restriction of `t` to `Y_t` is a unit, because `Γ(Y, Y_t)` is `Γ(Y, U)` localized at `t`.
  have hloc : IsLocalization.Away t Γ(Y, Y.basicOpen t) := hU.isLocalization_basicOpen t
  have hut : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le t)).op).hom t) :=
    IsLocalization.map_units Γ(Y, Y.basicOpen t) ⟨t, Submonoid.mem_powers t⟩
  obtain ⟨v, hv⟩ := hut.exists_right_inv
  -- Its image inverts the restriction of the image of `t`, hence equals `w`.
  have hρv : resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom t) *
      (g.appLE (Y.basicOpen t) (X.basicOpen ((g.appLE U W hgU.ge).hom t))
        (preimage_basicOpen_eq g hgU t).ge).hom v = 1 := by
    rw [← hkey t, ← map_mul, hv, map_one]
  have hwv : w = (g.appLE (Y.basicOpen t) (X.basicOpen ((g.appLE U W hgU.ge).hom t))
      (preimage_basicOpen_eq g hgU t).ge).hom v := by
    calc w
        = w * (resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom t) *
            (g.appLE (Y.basicOpen t) (X.basicOpen ((g.appLE U W hgU.ge).hom t))
              (preimage_basicOpen_eq g hgU t).ge).hom v) := by rw [hρv, mul_one]
      _ = (resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom t) * w) *
            (g.appLE (Y.basicOpen t) (X.basicOpen ((g.appLE U W hgU.ge).hom t))
              (preimage_basicOpen_eq g hgU t).ge).hom v := by ring
      _ = _ := by rw [hw, one_mul]
  -- The closure of the generators lies in the range.
  have hsub : Subring.closure (Set.range (fun z : Γ(Y, U) =>
      resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom z)) ∪ {w}) ≤
      (g.appLE (Y.basicOpen t) (X.basicOpen ((g.appLE U W hgU.ge).hom t))
        (preimage_basicOpen_eq g hgU t).ge).hom.range := by
    refine Subring.closure_le.mpr ?_
    rintro z (⟨y, rfl⟩ | rfl)
    · exact ⟨_, hkey y⟩
    · exact ⟨v, hwv.symm⟩
  intro z
  exact hsub (hgen ▸ Subring.mem_top z)

/-- **The closed immersion over the standard open.** With the surjectivity of
`Stacks.OverlapSurjectivity.surjective_appLE_basicOpen_of_closure` and the affineness of the
standard open of the image, `Stacks.FiniteFactorization.isClosedImmersion_morphismRestrict` makes
the restriction of `g` over `Y_t` a closed immersion. This is what
`Stacks.ChartImmersionAssembly.isImmersion_of_isImmersion_restrict_of_cover` consumes on each
member of the cover. -/
theorem isClosedImmersion_morphismRestrict_basicOpen (hU : IsAffineOpen U)
    (hP : IsAffineOpen (X.basicOpen ((g.appLE U W hgU.ge).hom t)))
    {w : Γ(X, X.basicOpen ((g.appLE U W hgU.ge).hom t))}
    (hw : resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom t) * w = 1)
    (hgen : Subring.closure (Set.range (fun z : Γ(Y, U) =>
        resBasicOpen ((g.appLE U W hgU.ge).hom t) ((g.appLE U W hgU.ge).hom z)) ∪ {w}) = ⊤) :
    IsClosedImmersion (g ∣_ Y.basicOpen t) := by
  have hpre := preimage_basicOpen_eq g hgU t
  refine Stacks.FiniteFactorization.isClosedImmersion_morphismRestrict g (Y.basicOpen t)
    (hU.basicOpen t) (hpre ▸ hP) ?_
  have : IsIso (homOfLE (hpre.ge : X.basicOpen ((g.appLE U W hgU.ge).hom t) ≤
      g ⁻¹ᵁ Y.basicOpen t)) :=
    ⟨homOfLE hpre.le, Subsingleton.elim _ _, Subsingleton.elim _ _⟩
  exact Stacks.FiniteFactorization.surjective_of_comp_isIso
    (X.presheaf.map (homOfLE hpre.ge).op)
    (surjective_appLE_basicOpen_of_closure g hgU t hU hw hgen)

end Stacks.OverlapSurjectivity

end
