/-!
# The range of an integral family of points of a scheme of finite presentation

Let `k` be a field and `A` a `k`-algebra which is integral over `k`. For every scheme `T` which
is locally of finite presentation over the terminal scheme, the image of every morphism
`Spec A ⟶ T` is a *finite* subset of `T`.

The set `Spec A` itself need not be finite: `A` is the directed union of its module-finite
`k`-subalgebras, each of which has finite spectrum, so `Spec A` is the corresponding inverse
limit, a profinite set which may well be infinite. The image is finite because a morphism out of
a limit of affine schemes into a scheme locally of finite presentation factors through one of
the stages (`AlgebraicGeometry.Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation`).

## Main definitions

* `Stacks.IntegralFamilyFiniteRange.finiteSubalgebraDiagram`: the `Finset A`-indexed diagram of
  the `k`-subalgebras of `A` generated by finite subsets.
* `Stacks.IntegralFamilyFiniteRange.finiteSubalgebraCocone`: the cocone on that diagram with
  vertex `A`.

## Main results

* `Stacks.IntegralFamilyFiniteRange.finiteSubalgebraCocone_isColimit`: that cocone is a colimit,
  i.e. `A` is the filtered colimit of its finitely generated `k`-subalgebras.
* `Stacks.IntegralFamilyFiniteRange.finite_spec_adjoin_finset`: the spectrum of a finitely
  generated subalgebra of an integral algebra over a field is a finite set.
* `Stacks.IntegralFamilyFiniteRange.finite_range_of_integral_of_locallyOfFinitePresentation`:
  the range of a morphism `Spec A ⟶ T` is finite when `T` is locally of finite presentation
  over the terminal scheme.
* `Stacks.IntegralFamilyFiniteRange.compactSpace_and_quasiSeparatedSpace_of_finiteType`: a
  scheme of finite type over the terminal scheme is quasi-compact and quasi-separated.
* `Stacks.IntegralFamilyFiniteRange.locallyOfFinitePresentation_of_finiteType`: a scheme of
  finite type over the terminal scheme is locally of finite presentation over it.
* `Stacks.IntegralFamilyFiniteRange.finite_range_of_integral_of_finiteType`: the range of a
  morphism `Spec A ⟶ T` is finite when `T` is of finite type over the terminal scheme.

## References

* [Stacks Project, Tag 0E21](https://stacks.math.columbia.edu/tag/0E21)
* [Stacks Project, Tag 0817](https://stacks.math.columbia.edu/tag/0817)
* [Stacks Project, Tag 01TX](https://stacks.math.columbia.edu/tag/01TX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

namespace Stacks.IntegralFamilyFiniteRange

universe u v

/-- The diagram of the `k`-subalgebras of `A` generated by the finite subsets of `A`, indexed by
`Finset A` ordered by inclusion. -/
public def finiteSubalgebraDiagram (k : Type v) (A : Type u) [Field k] [CommRing A]
    [Algebra k A] : Finset A ⥤ CommRingCat.{u} where
  obj i := CommRingCat.of (Algebra.adjoin k (i : Set A))
  map {i j} h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (show (i : Set A) ⊆ j from
      fun x hx => leOfHom h hx))).toRingHom
  map_id i := by ext x; simp [Subalgebra.inclusion]
  map_comp f g := by ext x; simp [Subalgebra.inclusion]

/-- The cocone on `finiteSubalgebraDiagram` whose vertex is `A` itself, given by the inclusions
of the subalgebras. -/
public def finiteSubalgebraCocone (k : Type v) (A : Type u) [Field k] [CommRing A]
    [Algebra k A] : Cocone (finiteSubalgebraDiagram k A) where
  pt := CommRingCat.of A
  ι :=
    { app i := CommRingCat.ofHom (Algebra.adjoin k (i : Set A)).val.toRingHom
      naturality := by intro i j h; ext x; rfl }

/-- `A` is the filtered colimit of its finitely generated `k`-subalgebras. -/
@[ega "IV 8.12.3" "special case"]
public noncomputable def finiteSubalgebraCocone_isColimit (k : Type v) (A : Type u) [Field k]
    [CommRing A] [Algebra k A] : IsColimit (finiteSubalgebraCocone k A) := by
  let F := finiteSubalgebraDiagram k A
  let c := finiteSubalgebraCocone k A
  let := reflectsColimit_of_reflectsIsomorphisms F (forget CommRingCat)
  apply isColimitOfReflects (forget CommRingCat)
  refine Types.FilteredColimit.isColimitOf' (F := F ⋙ forget CommRingCat)
    ((forget CommRingCat).mapCocone c) ?_ ?_
  · intro x
    exact ⟨({x} : Finset A),
      ⟨x, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self x))⟩, rfl⟩
  · intro i x y h
    exact ⟨i, 𝟙 i, Subtype.ext h⟩

/-- The spectrum of a finitely generated `k`-subalgebra of an algebra integral over the field `k`
is a finite set. -/
public theorem finite_spec_adjoin_finset (k : Type v) (A : Type u) [Field k] [CommRing A]
    [Algebra k A] [Algebra.IsIntegral k A] (i : Finset A) :
    Finite (Spec (CommRingCat.of (Algebra.adjoin k (i : Set A)))) := by
  have : Module.Finite k (Algebra.adjoin k (i : Set A)) :=
    Stacks.RingTheory.IntegralApproximation.moduleFinite_adjoin_finset i
  have : IsArtinianRing (Algebra.adjoin k (i : Set A)) :=
    IsArtinianRing.of_finite k (Algebra.adjoin k (i : Set A))
  show Finite (PrimeSpectrum (Algebra.adjoin k (i : Set A)))
  infer_instance

/-- The image of an integral family of points of a scheme locally of finite presentation over the
terminal scheme is a finite set. -/
public theorem finite_range_of_integral_of_locallyOfFinitePresentation
    (k : Type v) (A : Type u) [Field k] [CommRing A] [Algebra k A] [Algebra.IsIntegral k A]
    (T : Scheme.{u}) [LocallyOfFinitePresentation (terminal.from T)]
    (a : Spec (CommRingCat.of A) ⟶ T) : (Set.range a.base).Finite := by
  classical
  let F : Finset A ⥤ CommRingCat.{u} := finiteSubalgebraDiagram k A
  let SF : (Finset A)ᵒᵖ ⥤ Scheme.{u} := F.op ⋙ Scheme.Spec
  let cF : Cone SF := Scheme.Spec.mapCone (finiteSubalgebraCocone k A).op
  have hcF : IsLimit cF :=
    isLimitOfPreserves Scheme.Spec (finiteSubalgebraCocone_isColimit k A).op
  let tF : SF ⟶ (Functor.const ((Finset A)ᵒᵖ)).obj (⊤_ Scheme.{u}) :=
    { app := fun i => terminal.from (SF.obj i)
      naturality _ _ _ := terminal.hom_ext _ _ }
  have : ∀ i : (Finset A)ᵒᵖ, Finite (SF.obj i) := fun i => by
    show Finite (PrimeSpectrum (Algebra.adjoin k ((i.unop : Finset A) : Set A)))
    exact finite_spec_adjoin_finset k A i.unop
  have : ∀ {i j : (Finset A)ᵒᵖ} (f : i ⟶ j), IsAffineHom (SF.map f) := by
    intro i j f
    dsimp [SF, F, finiteSubalgebraDiagram]
    infer_instance
  have ha : cF.π ≫ tF = (Functor.const ((Finset A)ᵒᵖ)).map (a ≫ terminal.from T) := by
    ext i
    exact terminal.hom_ext _ _
  obtain ⟨j, q, hfactor, -⟩ :=
    Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation SF tF (terminal.from T) cF hcF a ha
  refine (Set.finite_range q.base).subset ?_
  rintro y ⟨z, rfl⟩
  refine ⟨(cF.π.app j).base z, ?_⟩
  show q.base.hom ((cF.π.app j).base.hom z) = a.base.hom z
  exact congrArg (fun h : Spec (CommRingCat.of A) ⟶ T => h.base.hom z) hfactor

/-- A scheme of finite type over the terminal scheme is quasi-compact and quasi-separated. -/
public theorem compactSpace_and_quasiSeparatedSpace_of_finiteType (T : Scheme.{u})
    [LocallyOfFiniteType (terminal.from T)] [QuasiCompact (terminal.from T)] :
    CompactSpace T ∧ QuasiSeparatedSpace T := by
  let e : (⊤_ Scheme.{u}) ≅ Spec (CommRingCat.of (ULift.{u} ℤ)) :=
    (specULiftZIsTerminal.uniqueUpToIso terminalIsTerminal).symm
  have : IsNoetherianRing (ULift.{u} ℤ) := isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
  have : IsLocallyNoetherian (⊤_ Scheme.{u}) := LocallyOfFiniteType.isLocallyNoetherian e.hom
  have : CompactSpace (⊤_ Scheme.{u}) := QuasiCompact.compactSpace_of_compactSpace e.hom
  have : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian (terminal.from T)
  exact ⟨QuasiCompact.compactSpace_of_compactSpace (terminal.from T), inferInstance⟩

/-- A scheme of finite type over the terminal scheme is locally of finite presentation over
it. -/
public theorem locallyOfFinitePresentation_of_finiteType (T : Scheme.{u})
    [LocallyOfFiniteType (terminal.from T)] [QuasiCompact (terminal.from T)] :
    LocallyOfFinitePresentation (terminal.from T) := by
  let e : (⊤_ Scheme.{u}) ≅ Spec (CommRingCat.of (ULift.{u} ℤ)) :=
    (specULiftZIsTerminal.uniqueUpToIso terminalIsTerminal).symm
  have : IsNoetherianRing (ULift.{u} ℤ) := isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
  have : IsLocallyNoetherian (⊤_ Scheme.{u}) := LocallyOfFiniteType.isLocallyNoetherian e.hom
  exact (finitePresentation_of_finiteType (terminal.from T)).locallyOfFinitePresentation

/-- The range of an integral family of points of a scheme of finite type over the terminal scheme
is finite. -/
public theorem finite_range_of_integral_of_finiteType
    (k : Type v) (A : Type u) [Field k] [CommRing A] [Algebra k A] [Algebra.IsIntegral k A]
    (T : Scheme.{u}) [LocallyOfFiniteType (terminal.from T)] [QuasiCompact (terminal.from T)]
    (a : Spec (CommRingCat.of A) ⟶ T) : (Set.range a.base).Finite :=
  have := locallyOfFinitePresentation_of_finiteType T
  finite_range_of_integral_of_locallyOfFinitePresentation k A T a

end Stacks.IntegralFamilyFiniteRange

end
