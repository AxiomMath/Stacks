@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open AlgebraicGeometry

universe u w

variable {S : Type u} [CommRing S] {σ : Type w} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

variable {f h : S} {d : ℕ}

/-- **Two chart functions are equal exactly when the cross-multiplied numerators agree.** This is
the general form of `AlgebraicGeometry.ProjectiveSpectrum.Proj.chartFraction_pow_mul_left`. -/
theorem chartFraction_eq_of_cross (hf : f ∈ 𝒮 d) (a b : ℕ) (u : 𝒮 (a • d)) (v : 𝒮 (b • d))
    (huv : (u : S) * f ^ b = (v : S) * f ^ a) :
    chartFraction 𝒮 hf a u = chartFraction 𝒮 hf b v := by
  refine congrArg (Proj.awayToSection 𝒮 f).hom
    (HomogeneousLocalization.val_injective (Submonoid.powers f) ?_)
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
  refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
  change f ^ b * (u : S) = f ^ a * (v : S)
  rw [mul_comm (f ^ b), mul_comm (f ^ a)]
  exact huv

/-- The chart function of a product of homogeneous elements is the product of their chart
functions. -/
theorem chartFraction_mul (hf : f ∈ 𝒮 d) (a b : ℕ) (u : 𝒮 (a • d)) (v : 𝒮 (b • d))
    (w : 𝒮 ((a + b) • d)) (hw : (w : S) = (u : S) * (v : S)) :
    chartFraction 𝒮 hf (a + b) w = chartFraction 𝒮 hf a u * chartFraction 𝒮 hf b v := by
  refine Eq.trans (congrArg (Proj.awayToSection 𝒮 f).hom
    (HomogeneousLocalization.val_injective (Submonoid.powers f) ?_)) (map_mul _ _ _)
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
    Localization.mk_mul, hw]
  refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
  change f ^ a * f ^ b * ((u : S) * (v : S)) = f ^ (a + b) * ((u : S) * (v : S))
  rw [pow_add]

/-- The chart function of a power of a homogeneous element of degree `d` is the corresponding
power of its chart function. -/
theorem chartFraction_pow (hf : f ∈ 𝒮 d) (a k : ℕ) (u : 𝒮 (a • d)) (w : 𝒮 ((k * a) • d))
    (hw : (w : S) = (u : S) ^ k) :
    chartFraction 𝒮 hf (k * a) w = chartFraction 𝒮 hf a u ^ k := by
  refine Eq.trans (congrArg (Proj.awayToSection 𝒮 f).hom
    (HomogeneousLocalization.val_injective (Submonoid.powers f) ?_)) (map_pow _ _ _)
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_pow,
    HomogeneousLocalization.Away.val_mk, Localization.mk_pow, hw]
  refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
  change ((f ^ a) ^ k) * (u : S) ^ k = f ^ (k * a) * (u : S) ^ k
  rw [← pow_mul, Nat.mul_comm a k]

/-- **Every section of the structure sheaf over a standard open is a chart function.** The ring of
sections over `D₊(f)` is the degree-zero localization at `f`, whose elements are the fractions
`b / f ^ n`. -/
theorem exists_chartFraction_eq (hf : f ∈ 𝒮 d) (hd : 0 < d)
    (s : Γ(Proj 𝒮, Proj.basicOpen 𝒮 f)) :
    ∃ (n : ℕ) (b : 𝒮 (n • d)), chartFraction 𝒮 hf n b = s := by
  obtain ⟨a, ha⟩ := (ConcreteCategory.bijective_of_isIso
    (_root_.AlgebraicGeometry.Proj.basicOpenIsoAway 𝒮 f hf hd).hom).2 s
  obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒮 hf a
  exact ⟨n, ⟨b, hb⟩, ha⟩

/-- The canonical map `Away 𝒮 f ⟶ Away 𝒮 (f * g)` carries `b / f ^ n` to `b g ^ n / (f g) ^ n`,
expressed with the numerator given by an equation. -/
theorem awayMk_restrict (hf : f ∈ 𝒮 d) {g : S} {e : ℕ} (hg : g ∈ 𝒮 e)
    {x : S} (hx : x = f * g) (hxm : x ∈ 𝒮 (d + e)) (n : ℕ)
    (b : 𝒮 (n • d)) (c : 𝒮 (n • (d + e))) (hc : (c : S) = (b : S) * g ^ n) :
    HomogeneousLocalization.awayMap 𝒮 hg hx
        (HomogeneousLocalization.Away.mk 𝒮 hf n (b : S) b.2)
      = HomogeneousLocalization.Away.mk 𝒮 hxm n (c : S) c.2 := by
  rw [HomogeneousLocalization.awayMap_mk]
  refine HomogeneousLocalization.val_injective (Submonoid.powers x) ?_
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hc]

/-- **Restricting a chart function to a smaller standard open.** The restriction of `b / f ^ n`
from `D₊(f)` to `D₊(f g)` is `b g ^ n / (f g) ^ n`. -/
theorem chartFraction_restrict (hf : f ∈ 𝒮 d) {g : S} {e : ℕ} (hg : g ∈ 𝒮 e)
    {x : S} (hx : x = f * g) (hxm : x ∈ 𝒮 (d + e)) (n : ℕ)
    (b : 𝒮 (n • d)) (c : 𝒮 (n • (d + e))) (hc : (c : S) = (b : S) * g ^ n) :
    (Proj 𝒮).presheaf.map
        (homOfLE (_root_.AlgebraicGeometry.Proj.basicOpen_mono 𝒮 f x ⟨g, hx⟩)).op
        (chartFraction 𝒮 hf n b)
      = chartFraction 𝒮 hxm n c := by
  have hsq := ConcreteCategory.congr_hom
    (_root_.AlgebraicGeometry.Proj.awayMap_awayToSection 𝒮 (g_deg := hg) (hx := hx))
    (HomogeneousLocalization.Away.mk 𝒮 hf n (b : S) b.2)
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply] at hsq
  exact hsq.symm.trans (congrArg _ (awayMk_restrict 𝒮 hf hg hx hxm n b c hc))

/-- The product of homogeneous elements of degrees `a • d` and `b • d` has degree `(a + b) • d`. -/
private theorem mul_mem_graded_add_smul {x y : S} {a b : ℕ} (hx : x ∈ 𝒮 (a • d))
    (hy : y ∈ 𝒮 (b • d)) : x * y ∈ 𝒮 ((a + b) • d) := by
  rw [add_smul]
  exact SetLike.mul_mem_graded hx hy

/-- **The localization step.** If the chart function `b / f ^ n` of a homogeneous element lies in
the kernel of `i` over `D₊(f)`, then for every other degree-one element `h` there is an exponent
`N` such that the chart function `f ^ N b / h ^ (N + n)` lies in the kernel of `i` over `D₊(h)`.

Over the intersection `D₊(h f)` the fractions `b / f ^ n` and `b / h ^ n` differ by a unit, so the
second restricts into the kernel there; the kernel over `D₊(h f)` is generated by the kernel over
`D₊(h)`, and `Away 𝒮 (h f)` is the localization of `Away 𝒮 h` at `f / h`, so some power of
`f / h` carries the element back into the kernel over `D₊(h)`. -/
theorem exists_pow_mul_chartFraction_mem_ker (hd : 0 < d) (hf : f ∈ 𝒮 d) (hh : h ∈ 𝒮 d)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] (n : ℕ) (b : 𝒮 (n • d))
    (hb : chartFraction 𝒮 hf n b ∈ RingHom.ker (i.app (Proj.basicOpen 𝒮 f)).hom) :
    ∃ N : ℕ, ∀ c : 𝒮 ((N + n) • d), (c : S) = f ^ N * (b : S) →
      chartFraction 𝒮 hh (N + n) c ∈ RingHom.ker (i.app (Proj.basicOpen 𝒮 h)).hom := by
  have hxm : h * f ∈ 𝒮 (d + d) := SetLike.mul_mem_graded hh hf
  have hd2 : (0 : ℕ) < d + d := by omega
  have affx := Proj.isAffineOpen_basicOpen 𝒮 (h * f) hxm hd2
  have lehx : Proj.basicOpen 𝒮 (h * f) ≤ Proj.basicOpen 𝒮 h :=
    _root_.AlgebraicGeometry.Proj.basicOpen_mono 𝒮 h (h * f) ⟨f, rfl⟩
  have lefx : Proj.basicOpen 𝒮 (h * f) ≤ Proj.basicOpen 𝒮 f :=
    _root_.AlgebraicGeometry.Proj.basicOpen_mono 𝒮 f (h * f) ⟨h, mul_comm h f⟩
  have hK : ∀ (g : S) (hg : g ∈ 𝒮 d) (le : Proj.basicOpen 𝒮 (h * f) ≤ Proj.basicOpen 𝒮 g),
      RingHom.ker (i.app (Proj.basicOpen 𝒮 (h * f))).hom
        = Ideal.map ((Proj 𝒮).presheaf.map (homOfLE le).op).hom
            (RingHom.ker (i.app (Proj.basicOpen 𝒮 g)).hom) := fun g hg le => by
    have affg := Proj.isAffineOpen_basicOpen 𝒮 g hg hd
    rw [← Scheme.Hom.ker_apply i ⟨_, affg⟩, ← Scheme.Hom.ker_apply i ⟨_, affx⟩]
    exact (Scheme.IdealSheafData.map_ideal i.ker (U := ⟨_, affx⟩) (V := ⟨_, affg⟩) le).symm
  have hcm : ∀ g ∈ 𝒮 d, (b : S) * g ^ n ∈ 𝒮 (n • (d + d)) := fun g hg => by
    have hp := SetLike.mul_mem_graded b.2 (SetLike.pow_mem_graded (A := 𝒮) n hg)
    rwa [← smul_add] at hp
  have hc1m := hcm h hh
  have hc2m := hcm f hf
  have hUm : f ^ (n + n) ∈ 𝒮 (n • (d + d)) := by
    have hp := SetLike.pow_mem_graded (A := 𝒮) (n + n) hf
    rwa [(add_smul n n d).trans (smul_add n d d).symm] at hp
  have hWm : (b : S) * h ^ n * f ^ (n + n) ∈ 𝒮 ((n + n) • (d + d)) := by
    exact mul_mem_graded_add_smul 𝒮 hc1m hUm
  have hstepB : chartFraction 𝒮 hxm n ⟨(b : S) * h ^ n, hc1m⟩ ∈
      RingHom.ker (i.app (Proj.basicOpen 𝒮 (h * f))).hom := by
    rw [← chartFraction_restrict 𝒮 hf hh (mul_comm h f) hxm n b ⟨_, hc1m⟩ rfl, hK f hf lefx]
    exact Ideal.mem_map_of_mem _ hb
  have hstepC : chartFraction 𝒮 hxm n ⟨(b : S) * f ^ n, hc2m⟩ ∈
      RingHom.ker (i.app (Proj.basicOpen 𝒮 (h * f))).hom := by
    rw [chartFraction_eq_of_cross 𝒮 hxm n (n + n) ⟨(b : S) * f ^ n, hc2m⟩ ⟨_, hWm⟩ (by ring),
      chartFraction_mul 𝒮 hxm n n ⟨(b : S) * h ^ n, hc1m⟩ ⟨f ^ (n + n), hUm⟩ ⟨_, hWm⟩ rfl]
    exact Ideal.mul_mem_right _ _ hstepB
  have hstepD : ((Proj 𝒮).presheaf.map (homOfLE lehx).op).hom (chartFraction 𝒮 hh n b) ∈
      RingHom.ker (i.app (Proj.basicOpen 𝒮 (h * f))).hom := by
    rw [chartFraction_restrict 𝒮 hh hf rfl hxm n b ⟨(b : S) * f ^ n, hc2m⟩ rfl]
    exact hstepC
  have hpowd : f ^ d ∈ 𝒮 (d • d) := SetLike.pow_mem_graded (A := 𝒮) d hf
  let θ := HomogeneousLocalization.awayMap 𝒮 hf (rfl : h * f = h * f)
  let _alg : Algebra (HomogeneousLocalization.Away 𝒮 h)
      (HomogeneousLocalization.Away 𝒮 (h * f)) := θ.toAlgebra
  have _hloc : IsLocalization.Away
      (HomogeneousLocalization.Away.isLocalizationElem hh hf)
      (HomogeneousLocalization.Away 𝒮 (h * f)) :=
    HomogeneousLocalization.Away.isLocalization_mul hh hf rfl hd.ne'
  have hbijh : Function.Bijective
      (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom :=
    ConcreteCategory.bijective_of_isIso
      (_root_.AlgebraicGeometry.Proj.basicOpenIsoAway 𝒮 h hh hd).hom
  have hbijx : Function.Bijective
      (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 (h * f)).hom :=
    ConcreteCategory.bijective_of_isIso
      (_root_.AlgebraicGeometry.Proj.basicOpenIsoAway 𝒮 (h * f) hxm hd2).hom
  have hsq := congrArg CommRingCat.Hom.hom
    (_root_.AlgebraicGeometry.Proj.awayMap_awayToSection 𝒮 (g_deg := hf)
      (hx := (rfl : h * f = h * f)))
  rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom] at hsq
  have hmapid : Ideal.map (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 (h * f)).hom
        (Ideal.map θ (Ideal.comap
          (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom
          (RingHom.ker (i.app (Proj.basicOpen 𝒮 h)).hom)))
      = Ideal.map ((Proj 𝒮).presheaf.map (homOfLE lehx).op).hom
          (RingHom.ker (i.app (Proj.basicOpen 𝒮 h)).hom) := by
    rw [Ideal.map_map, hsq, ← Ideal.map_map, Ideal.map_comap_of_surjective _ hbijh.2]
  have hthetamem : θ (HomogeneousLocalization.Away.mk 𝒮 hh n (b : S) b.2) ∈
      Ideal.map θ (Ideal.comap (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom
        (RingHom.ker (i.app (Proj.basicOpen 𝒮 h)).hom)) := by
    have he : (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 (h * f)).hom
          (θ (HomogeneousLocalization.Away.mk 𝒮 hh n (b : S) b.2))
        = ((Proj 𝒮).presheaf.map (homOfLE lehx).op).hom (chartFraction 𝒮 hh n b) :=
      RingHom.congr_fun hsq (HomogeneousLocalization.Away.mk 𝒮 hh n (b : S) b.2)
    have h1 : (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 (h * f)).hom
        (θ (HomogeneousLocalization.Away.mk 𝒮 hh n (b : S) b.2))
        ∈ Ideal.map (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 (h * f)).hom
          (Ideal.map θ (Ideal.comap
            (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom
            (RingHom.ker (i.app (Proj.basicOpen 𝒮 h)).hom))) := by
      rw [hmapid, he, ← hK h hh lehx]
      exact hstepD
    have h2 := Ideal.mem_comap.mpr h1
    rwa [Ideal.comap_map_of_surjective _ hbijx.2,
      show Ideal.comap (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 (h * f)).hom
          (⊥ : Ideal _) = ⊥ from (RingHom.injective_iff_ker_eq_bot _).mp hbijx.1,
      sup_bot_eq] at h2
  obtain ⟨m, ⟨k, rfl⟩, hmem⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
    (Submonoid.powers (HomogeneousLocalization.Away.isLocalizationElem hh hf))
    (HomogeneousLocalization.Away 𝒮 (h * f))
    (Ideal.comap (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom
      (RingHom.ker (i.app (Proj.basicOpen 𝒮 h)).hom))
    (HomogeneousLocalization.Away.mk 𝒮 hh n (b : S) b.2)).mp hthetamem
  refine ⟨k * d, fun c hc => ?_⟩
  have hK := Ideal.mem_comap.mp hmem
  rw [map_mul, map_pow] at hK
  have hfkd : f ^ (k * d) ∈ 𝒮 ((k * d) • d) := SetLike.pow_mem_graded (A := 𝒮) (k * d) hf
  have hfk := mul_mem_graded_add_smul 𝒮 hfkd b.2
  have hpowe : f ^ (k * d) = (f ^ d) ^ k := by rw [Nat.mul_comm k d, pow_mul]
  rw [show (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom
        (HomogeneousLocalization.Away.isLocalizationElem hh hf)
      = chartFraction 𝒮 hh d ⟨f ^ d, hpowd⟩ from rfl,
    ← chartFraction_pow 𝒮 hh d k ⟨f ^ d, hpowd⟩ ⟨f ^ (k * d), hfkd⟩ hpowe,
    show (_root_.AlgebraicGeometry.Proj.awayToSection 𝒮 h).hom
        (HomogeneousLocalization.Away.mk 𝒮 hh n (b : S) b.2)
      = chartFraction 𝒮 hh n b from rfl,
    ← chartFraction_mul 𝒮 hh (k * d) n ⟨f ^ (k * d), hfkd⟩ b ⟨_, hfk⟩ rfl] at hK
  rwa [chartFraction_eq_of_cross 𝒮 hh (k * d + n) (k * d + n) c ⟨f ^ (k * d) * (b : S), hfk⟩
    (by rw [hc])]

/-- **Finitely many degree-one standard opens cover `Proj 𝒮`** over a Noetherian graded ring
generated in degree one: finitely many degree-one elements already span the irrelevant ideal.

This is the shape in which the degree-one consumers of the chart comparison below supply its
covering family; over an arbitrary graded ring the cover comes instead from quasi-compactness of
`Proj 𝒮`, through `AlgebraicGeometry.Proj.exists_common_degree_finite_basicOpen_cover`. -/
theorem exists_finite_degreeOne_cover [IsNoetherianRing S]
    (hgen : Algebra.adjoin (𝒮 0) ((𝒮 1 : Set S)) = ⊤) :
    ∃ t : Finset S, (∀ g ∈ t, g ∈ 𝒮 1) ∧
      ⨆ j : {x : S // x ∈ t}, Proj.basicOpen 𝒮 (j : S) = ⊤ := by
  obtain ⟨t, ht1, htspan⟩ := exists_finset_degreeOne_span_irrelevant 𝒮 hgen
  have hfam : ∀ j : {x : S // x ∈ t}, (j : S) ∈ 𝒮 1 := fun j => ht1 _ j.2
  have hrange : Set.range (fun j : {x : S // x ∈ t} => (j : S)) = (t : Set S) := by
    ext z
    exact ⟨fun ⟨j, hj⟩ => hj ▸ j.2, fun hz => ⟨⟨z, hz⟩, rfl⟩⟩
  have hadj : Algebra.adjoin (𝒮 0)
      (Set.range (fun j : {x : S // x ∈ t} => (j : S))) = ⊤ :=
    (generates_algebra_iff_generates_irrelevant 𝒮 (fun j : {x : S // x ∈ t} => (j : S))
      (fun _ => 1) (fun _ => Nat.one_pos) hfam).mpr (by rwa [hrange])
  exact ⟨t, ht1, _root_.AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒮
    (fun j : {x : S // x ∈ t} => (j : S)) (fun j => ⟨1, hfam j⟩) hadj⟩

/-- **One exponent serves every chart.** Over a Noetherian graded ring generated in degree one, if
the chart function `b / f ^ n` lies in the kernel of `i` over `D₊(f)`, then `f ^ N b` lies in the
ideal of `Z` for some `N`.

The maximum of the per-chart exponents of `exists_pow_mul_chartFraction_mem_ker` works on every
member of the cover at once — which is what the cover being finite is for — and padding a chart
function by a further power of `f` keeps it in the kernel because the kernel is an ideal. -/
theorem exists_pow_mul_mem_idealOfClosedSubscheme (hd : 0 < d)
    {ι : Type*} [Finite ι] (fam : ι → S) (hfam : ∀ j, fam j ∈ 𝒮 d)
    (hcov : ⨆ j, Proj.basicOpen 𝒮 (fam j) = ⊤)
    (hf : f ∈ 𝒮 d)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] (n : ℕ) (b : 𝒮 (n • d))
    (hb : chartFraction 𝒮 hf n b ∈ RingHom.ker (i.app (Proj.basicOpen 𝒮 f)).hom) :
    ∃ N : ℕ, f ^ N * (b : S) ∈ idealOfClosedSubscheme 𝒮 i := by
  classical
  cases nonempty_fintype ι
  choose NN hNN using fun j : ι =>
    exists_pow_mul_chartFraction_mem_ker 𝒮 hd hf (hfam j) i n b hb
  have hmem := mul_mem_graded_add_smul 𝒮
    (SetLike.pow_mem_graded (A := 𝒮) (Finset.univ.sup NN) hf) b.2
  refine ⟨Finset.univ.sup NN, mem_idealOfClosedSubscheme_of_forall_chartFraction_mem_ker 𝒮 hd
    fam hfam hcov i ⟨f ^ Finset.univ.sup NN * (b : S), hmem⟩ fun j => ?_⟩
  obtain ⟨M, hM⟩ := Nat.exists_eq_add_of_le
    (Finset.le_sup (f := NN) (Finset.mem_univ j))
  have hum : f ^ M ∈ 𝒮 (M • d) := SetLike.pow_mem_graded (A := 𝒮) M hf
  have hvm := mul_mem_graded_add_smul 𝒮 (SetLike.pow_mem_graded (A := 𝒮) (NN j) hf) b.2
  have hwm := mul_mem_graded_add_smul 𝒮 hum hvm
  have hcross : f ^ Finset.univ.sup NN * (b : S) * fam j ^ (M + (NN j + n))
      = f ^ M * (f ^ NN j * (b : S)) * fam j ^ (Finset.univ.sup NN + n) := by
    rw [hM]
    ring
  rw [chartFraction_eq_of_cross 𝒮 (hfam j) (Finset.univ.sup NN + n) (M + (NN j + n))
      ⟨f ^ Finset.univ.sup NN * (b : S), hmem⟩ ⟨_, hwm⟩ hcross,
    chartFraction_mul 𝒮 (hfam j) M (NN j + n) ⟨f ^ M, hum⟩ ⟨_, hvm⟩ ⟨_, hwm⟩ rfl]
  exact Ideal.mul_mem_left _ _ (hNN j ⟨_, hvm⟩ rfl)

/-- **The reverse inclusion of the chart comparison.** Every element of `Ker(i.app D₊(f))` is the
chart function of a homogeneous element of the ideal of `Z`. -/
theorem exists_mem_idealOfClosedSubscheme_chartFraction_eq (hd : 0 < d)
    {ι : Type*} [Finite ι] (fam : ι → S) (hfam : ∀ j, fam j ∈ 𝒮 d)
    (hcov : ⨆ j, Proj.basicOpen 𝒮 (fam j) = ⊤)
    (hf : f ∈ 𝒮 d)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i]
    (s : Γ(Proj 𝒮, Proj.basicOpen 𝒮 f))
    (hs : s ∈ RingHom.ker (i.app (Proj.basicOpen 𝒮 f)).hom) :
    ∃ (m : ℕ) (c : 𝒮 (m • d)), (c : S) ∈ idealOfClosedSubscheme 𝒮 i ∧
      chartFraction 𝒮 hf m c = s := by
  obtain ⟨n, b, rfl⟩ := exists_chartFraction_eq 𝒮 hf hd s
  obtain ⟨N, hN⟩ :=
    exists_pow_mul_mem_idealOfClosedSubscheme 𝒮 hd fam hfam hcov hf i n b hs
  have hmem := mul_mem_graded_add_smul 𝒮 (SetLike.pow_mem_graded (A := 𝒮) N hf) b.2
  exact ⟨N + n, ⟨f ^ N * (b : S), hmem⟩, hN,
    chartFraction_pow_mul_left 𝒮 hf N n b ⟨_, hmem⟩ rfl⟩

/-- **The chart-level comparison of ideals, both inclusions.** A section of the structure sheaf
over `D₊(f)` is carried to zero by a closed immersion `i : Z ⟶ Proj 𝒮` exactly when it is the
chart function of a homogeneous element of `idealOfClosedSubscheme 𝒮 i`.

This is the computational content of Tag 0801 on a standard chart; see the module docstring for
why the tag is withheld. -/
theorem mem_ker_app_basicOpen_iff (hd : 0 < d)
    {ι : Type*} [Finite ι] (fam : ι → S) (hfam : ∀ j, fam j ∈ 𝒮 d)
    (hcov : ⨆ j, Proj.basicOpen 𝒮 (fam j) = ⊤)
    (hf : f ∈ 𝒮 d)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i]
    (s : Γ(Proj 𝒮, Proj.basicOpen 𝒮 f)) :
    s ∈ RingHom.ker (i.app (Proj.basicOpen 𝒮 f)).hom ↔
      ∃ (m : ℕ) (c : 𝒮 (m • d)), (c : S) ∈ idealOfClosedSubscheme 𝒮 i ∧
        chartFraction 𝒮 hf m c = s := by
  refine ⟨exists_mem_idealOfClosedSubscheme_chartFraction_eq 𝒮 hd fam hfam hcov hf i s, ?_⟩
  rintro ⟨m, c, hc, rfl⟩
  have := algebraicGeometry_isInvertible_twistingSheaf_of_cover 𝒮 fam d hfam hcov m
  exact chartFraction_mem_ker_app_of_mem_idealOfClosedSubscheme 𝒮 hf hd i m c hc

section ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (e : ℕ)

/-- **The chart-level comparison on projective space.** A function on the standard chart
`D₊(X k)` of `P^{e-1}_R` dies on a closed subscheme `Z` exactly when it is `G / X k ^ m` for some
homogeneous `G` in the homogeneous ideal of `Z`. -/
theorem projectiveSpace_mem_ker_app_basicOpen_iff [IsNoetherianRing R] {Z : Scheme.{u}}
    (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin e) R)) [IsClosedImmersion i]
    (k : Fin e) (s : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin e) R),
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin e) R) (MvPolynomial.X k))) :
    s ∈ RingHom.ker (i.app (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin e) R) (MvPolynomial.X k))).hom ↔
      ∃ (m : ℕ) (c : MvPolynomial.homogeneousSubmodule (Fin e) R (m • 1)),
        (c : MvPolynomial (Fin e) R) ∈
            idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i ∧
          chartFraction (MvPolynomial.homogeneousSubmodule (Fin e) R)
            (MvPolynomial.isHomogeneous_X R k) m c = s := by
  obtain ⟨t, ht1, hcov⟩ := exists_finite_degreeOne_cover _
    (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin e) R)
  exact mem_ker_app_basicOpen_iff _ Nat.one_pos
    (fun j : {x : MvPolynomial (Fin e) R // x ∈ t} => (j : MvPolynomial (Fin e) R))
    (fun j => ht1 _ j.2) hcov (MvPolynomial.isHomogeneous_X R k) i s

end ProjectiveSpace

