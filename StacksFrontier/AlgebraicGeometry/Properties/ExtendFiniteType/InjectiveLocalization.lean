module

public import Mathlib.Algebra.Category.ModuleCat.Injective
public import Mathlib.AlgebraicGeometry.Modules.Tilde
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.Noetherian.Defs
public import StacksCore.Tactic.StacksAttribute

/-!
# Localizing an injective module at a single element

Over a Noetherian ring a localization map out of an injective module at the powers of one
element is surjective.  Geometrically, for an injective module `M` over a Noetherian ring `A`
the sheaf `M̃` on `Spec A` has the property that every section over a basic open `D(f)` is the
restriction of a global section.

## Main results

* `Module.surjective_of_isLocalizedModule_powers_of_injective`: if `R` is Noetherian, `M` is an
  injective `R`-module and `g : M →ₗ[R] N` exhibits `N` as the localization of `M` at the powers
  of `f`, then `g` is surjective.
* `AlgebraicGeometry.tilde.surjective_toOpen_basicOpen_of_injective`: for an injective module
  over a Noetherian ring, the map from the module to the sections of `M̃` over `D(f)` is
  surjective.
* `AlgebraicGeometry.tilde.surjective_res_basicOpen_of_injective`: restriction of sections of
  `M̃` from `Spec A` to `D(f)` is surjective for an injective module over a Noetherian ring.
* `AlgebraicGeometry.tilde.surjective_presheaf_map_basicOpen_of_injective`: the same
  surjectivity for the presheaf of modules over the structure sheaf underlying `M̃`.

## Implementation notes

The proof of the algebraic statement is Baer's criterion applied to a principal ideal.  Write an
element of the localization as `m / f ^ n`.  The annihilators of the elements `f ^ j • m` form an
ascending chain of ideals, which is stationary from some index `k` on; this is the only use of the
Noetherian hypothesis.  Consequently the kernel of multiplication by `f ^ (n + k)` on `R` is
contained in the annihilator of `f ^ k • m`, so `a • f ^ (n + k) ↦ a • (f ^ k • m)` is a
well-defined map from the ideal generated by `f ^ (n + k)` to the module; it is realized here as
a map out of the range of multiplication by `f ^ (n + k)`, factored through the quotient by the
kernel.  Injectivity extends it to `R`, and the image of `1` is an element whose class in the
localization is the prescribed one, because multiplication by `f ^ (n + k)` is injective there.

The geometric statement uses that `AlgebraicGeometry.tilde.toOpen M (PrimeSpectrum.basicOpen f)`
is a localization map at the powers of `f`, together with the factorization of that map through
the global sections, which holds by definition.

## References

* [Stacks Project, Tag 08XW](https://stacks.math.columbia.edu/tag/08XW)
* [Stacks Project, Tag 0A6T](https://stacks.math.columbia.edu/tag/0A6T)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace Module

variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {M N : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- Over a Noetherian ring, a localization map at the powers of a single element out of an
injective module is surjective. -/
public theorem surjective_of_isLocalizedModule_powers_of_injective
    [Module.Injective R M] (f : R) (g : M →ₗ[R] N)
    [IsLocalizedModule (Submonoid.powers f) g] :
    Function.Surjective g := by
  intro y
  obtain ⟨⟨m, s⟩, hs⟩ := IsLocalizedModule.surj (Submonoid.powers f) g y
  obtain ⟨n, hn⟩ := s.2
  have hsy : f ^ n • y = g m := by
    have h0 : (s : R) • y = g m := hs
    rw [← hn] at h0
    exact h0
  obtain ⟨k, hk⟩ : ∃ k : ℕ, ∀ j, k ≤ j →
      LinearMap.ker (LinearMap.toSpanSingleton R M (f ^ k • m)) =
        LinearMap.ker (LinearMap.toSpanSingleton R M (f ^ j • m)) := by
    obtain ⟨k, hk⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance)
      (⟨fun j => LinearMap.ker (LinearMap.toSpanSingleton R M (f ^ j • m)), by
        intro i j hij a ha
        simp only [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at ha ⊢
        obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hij
        rw [pow_add, mul_comm, mul_smul, smul_comm, ha, smul_zero]⟩ : ℕ →o Submodule R R)
    exact ⟨k, fun j hj => hk j hj⟩
  set χ : R →ₗ[R] R := LinearMap.toSpanSingleton R R (f ^ (n + k)) with hχ
  set ψ : R →ₗ[R] M := LinearMap.toSpanSingleton R M (f ^ k • m) with hψ
  have hker : LinearMap.ker χ ≤ LinearMap.ker ψ := by
    intro a ha
    simp only [hχ, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, smul_eq_mul] at ha
    have h1 : a ∈ LinearMap.ker (LinearMap.toSpanSingleton R M (f ^ (n + k) • m)) := by
      simp only [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
      rw [smul_smul, ha, zero_smul]
    rw [← hk (n + k) (Nat.le_add_left k n)] at h1
    simpa [hψ] using h1
  set φ : LinearMap.range χ →ₗ[R] M :=
    ((LinearMap.ker χ).liftQ ψ hker) ∘ₗ (χ.quotKerEquivRange.symm.toLinearMap) with hφdef
  have hφ : ∀ a : R, φ ⟨χ a, ⟨a, rfl⟩⟩ = ψ a := by
    intro a
    have hsymm : χ.quotKerEquivRange.symm ⟨χ a, ⟨a, rfl⟩⟩ = Submodule.Quotient.mk a := by
      apply χ.quotKerEquivRange.injective
      rw [LinearEquiv.apply_symm_apply]
      rfl
    rw [hφdef]
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe, hsymm]
    rfl
  obtain ⟨h, hh⟩ := Module.Injective.out (R := R) (Q := M) (LinearMap.range χ).subtype
    Subtype.val_injective φ
  refine ⟨h 1, ?_⟩
  have hm : f ^ (n + k) • h 1 = f ^ k • m := by
    have h1 := hh ⟨χ 1, ⟨1, rfl⟩⟩
    rw [hφ 1] at h1
    simpa [hχ, hψ, ← h.map_smul] using h1
  have hgoal : f ^ (n + k) • g (h 1) = f ^ (n + k) • y := by
    rw [← LinearMap.map_smul, hm, LinearMap.map_smul, ← hsy, smul_smul, ← pow_add,
      Nat.add_comm]
  exact IsLocalizedModule.smul_injective g
    (⟨f ^ (n + k), n + k, rfl⟩ : Submonoid.powers f) hgoal

end Module

namespace AlgebraicGeometry.tilde

variable {A : CommRingCat.{u}} [IsNoetherianRing A]

omit [IsNoetherianRing A] in
/-- An injective object of the category of `A`-modules is an injective module. -/
private theorem moduleInjective_of_injective (M : ModuleCat.{u} A)
    [CategoryTheory.Injective M] : Module.Injective A M :=
  (Module.injective_iff_injective_object A M).mpr ‹CategoryTheory.Injective M›

/-- For an injective module `M` over a Noetherian ring `A` and `f : A`, every section of `M̃`
over the basic open `D(f)` comes from an element of `M`. -/
public theorem surjective_toOpen_basicOpen_of_injective (M : ModuleCat.{u} A)
    [CategoryTheory.Injective M] (f : A) :
    Function.Surjective (tilde.toOpen M (PrimeSpectrum.basicOpen f)).hom := by
  have := moduleInjective_of_injective M
  exact Module.surjective_of_isLocalizedModule_powers_of_injective f _

/-- For an injective module `M` over a Noetherian ring `A` and `f : A`, restriction of sections
of `M̃` from `Spec A` to the basic open `D(f)` is surjective. -/
public theorem surjective_res_basicOpen_of_injective (M : ModuleCat.{u} A)
    [CategoryTheory.Injective M] (f : A) :
    Function.Surjective ((modulesSpecToSheaf.obj (tilde M)).presheaf.map
      (PrimeSpectrum.basicOpen f).leTop.op).hom := by
  have hfac : ((modulesSpecToSheaf.obj (tilde M)).presheaf.map
        (PrimeSpectrum.basicOpen f).leTop.op).hom ∘ (tilde.toOpen M ⊤).hom =
      (tilde.toOpen M (PrimeSpectrum.basicOpen f)).hom := rfl
  refine Function.Surjective.of_comp (g := (tilde.toOpen M ⊤).hom) ?_
  rw [hfac]
  exact surjective_toOpen_basicOpen_of_injective M f

/-- For an injective module `M` over a Noetherian ring `A` and `f : A`, the restriction map of
the presheaf of modules over the structure sheaf underlying `M̃`, from `Spec A` to the basic open
`D(f)`, is surjective. -/
public theorem surjective_presheaf_map_basicOpen_of_injective (M : ModuleCat.{u} A)
    [CategoryTheory.Injective M] (f : A) :
    Function.Surjective ((tilde M).val.presheaf.map
      (PrimeSpectrum.basicOpen f).leTop.op).hom :=
  surjective_res_basicOpen_of_injective M f

end AlgebraicGeometry.tilde

end
