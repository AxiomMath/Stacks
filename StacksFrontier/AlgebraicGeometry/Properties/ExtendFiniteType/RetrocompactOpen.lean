module

public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.FittingIdeals
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.FiniteTypeSubobjectExtension
public import StacksCore.Tactic.StacksAttribute

/-!
# Quasi-compact opens of a quasi-compact quasi-separated scheme

For an open subscheme `U` of a quasi-compact and quasi-separated scheme `X`, being retrocompact
in `X`, being quasi-compact, and being a finite union of affine opens are all equivalent, and
each of them follows from the existence of a finite type quasi-coherent sheaf of ideals whose
vanishing locus is `X \ U`.

## Main results

* `AlgebraicGeometry.isCompact_iff_exists_finset_affineOpens`: an open of a scheme is
  quasi-compact exactly when it is a finite union of affine opens.
* `AlgebraicGeometry.isRetrocompact_iff_forall_affineOpens`: a subset of a scheme is
  retrocompact exactly when it meets every affine open in a quasi-compact set.
* `AlgebraicGeometry.isCompact_of_isFiniteType_idealSheafData`: an open whose complement is the
  vanishing locus of a finite type quasi-coherent sheaf of ideals is quasi-compact.

## Implementation notes

A quasi-coherent sheaf of ideals is `AlgebraicGeometry.Scheme.IdealSheafData`, which records the
ideal of sections on each affine open together with its compatibility with localization; being
of finite type is `AlgebraicGeometry.Scheme.IdealSheafData.IsFiniteType`, finite generation of
each of those ideals. On an affine open `W` whose ideal is generated by a finite set `t`, the
part of `W` outside the vanishing locus is the union of the basic opens of the elements of `t`,
each of which is an affine open; this is what makes the open quasi-compact.

The equivalence of retrocompactness and quasi-compactness for an open of a quasi-compact
quasi-separated space is `QuasiSeparatedSpace.isRetrocompact_iff_isCompact`.

## References

* [Stacks Project, Tag 01PH](https://stacks.math.columbia.edu/tag/01PH)
* [Stacks Project, Tag 07ZL](https://stacks.math.columbia.edu/tag/07ZL)
-/

@[expose] public section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

add_to_stacks 01PH "(1) ↔ (2)" QuasiSeparatedSpace.isRetrocompact_iff_isCompact
add_to_sga "3 VIA 2.6.3" "special case" QuasiSeparatedSpace.isRetrocompact_iff_isCompact
add_to_ega "0 9.1.6" QuasiSeparatedSpace.isRetrocompact_iff_isCompact

variable {X : Scheme.{u}}

/-- An open that is the supremum of a finite set of affine opens is their union. -/
private theorem coe_eq_biUnion_of_eq_sup {s : Finset X.affineOpens} {U : X.Opens}
    (h : U = s.sup fun V => (V : X.Opens)) : (U : Set X) = ⋃ W ∈ s, ((W : X.Opens) : Set X) := by
  rw [h, Opens.coe_finset_sup, Finset.sup_eq_iSup]
  rfl

/-- **An open of a scheme is quasi-compact exactly when it is a finite union of affine
opens.** -/
@[stacks 01PH "(2) ↔ (3)", ega "IV 1.8.1" "qc open ⟺ finite ∪ aff"]
theorem isCompact_iff_exists_finset_affineOpens (U : X.Opens) :
    IsCompact (U : Set X) ↔ ∃ s : Finset X.affineOpens, U = s.sup fun V => (V : X.Opens) := by
  classical
  refine ⟨fun hU => ?_, ?_⟩
  · have hb : Opens.IsBasis (Set.range fun V : X.affineOpens => (V : X.Opens)) := by
      rw [Subtype.range_coe]
      exact X.isBasis_affineOpens
    obtain ⟨κ, hκ, a, ha⟩ := hb.exists_iSup_eq_of_isCompact U hU
    refine ⟨(Set.finite_range a).toFinset, ha.trans ?_⟩
    rw [Finset.sup_eq_iSup]
    simp
  · rintro ⟨s, rfl⟩
    rw [coe_eq_biUnion_of_eq_sup rfl]
    exact s.finite_toSet.isCompact_biUnion fun W _ => W.2.isCompact

/-- **A subset of a scheme is retrocompact exactly when its intersection with every affine open
is quasi-compact.** -/
@[stacks 07ZL, ega "IV 1.8.1" "retrocompact criterion"]
theorem isRetrocompact_iff_forall_affineOpens (E : Set X) :
    IsRetrocompact E ↔ ∀ W : X.affineOpens, IsCompact (E ∩ (W : Set X)) := by
  refine ⟨fun hE W => hE W.2.isCompact (W : X.Opens).2, fun hE V hVc hVo => ?_⟩
  obtain ⟨s, hs⟩ := (isCompact_iff_exists_finset_affineOpens ⟨V, hVo⟩).mp hVc
  rw [show V = _ from coe_eq_biUnion_of_eq_sup hs, Set.inter_iUnion₂]
  exact s.finite_toSet.isCompact_biUnion fun W _ => hE W

/-- The part of an affine open lying outside the vanishing locus of a finite type quasi-coherent
sheaf of ideals is a finite union of basic opens, hence quasi-compact. -/
theorem isCompact_compl_support_inter (I : X.IdealSheafData)
    (hI : I.IsFiniteType) (W : X.affineOpens) :
    IsCompact ((I.support : Set X)ᶜ ∩ (W : Set X)) := by
  classical
  obtain ⟨t, ht⟩ := hI W
  have key : (I.support : Set X)ᶜ ∩ (W : Set X) = ⋃ f ∈ t, (X.basicOpen f : Set X) := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_iUnion, exists_prop]
    constructor
    · rintro ⟨hx, hxW⟩
      rw [SetLike.mem_coe, I.mem_support_iff_of_mem (U := W) hxW, ← ht,
        X.zeroLocus_span (U := W.1) (t : Set Γ(X, W.1)), Scheme.mem_zeroLocus_iff] at hx
      simpa using hx
    · rintro ⟨f, hf, hxf⟩
      refine ⟨?_, X.basicOpen_le f hxf⟩
      rw [SetLike.mem_coe, I.mem_support_iff_of_mem (U := W) (X.basicOpen_le f hxf), ← ht,
        X.zeroLocus_span (U := W.1) (t : Set Γ(X, W.1)), Scheme.mem_zeroLocus_iff]
      exact fun h => (h f hf) hxf
  rw [key]
  exact t.finite_toSet.isCompact_biUnion fun f _ => (W.2.basicOpen f).isCompact

/-- **An open subscheme of a quasi-compact scheme whose complement is the vanishing locus of a
finite type quasi-coherent sheaf of ideals is quasi-compact.** -/
@[stacks 01PH "(4) ⟹ (2)"]
theorem isCompact_of_isFiniteType_idealSheafData [CompactSpace X] (U : X.Opens)
    (I : X.IdealSheafData) (hI : I.IsFiniteType)
    (hsupp : (I.support : Set X) = (U : Set X)ᶜ) : IsCompact (U : Set X) := by
  obtain ⟨s, hs⟩ := exists_finset_affineOpens_sup_eq_top (⊥ : X.Opens)
  have huniv : (⋃ W ∈ s, ((W : X.Opens) : Set X)) = Set.univ := by
    rw [← coe_eq_biUnion_of_eq_sup (U := ⊤) (by rw [Finset.sup_eq_iSup]; simpa using hs.symm)]
    rfl
  have hcov : (U : Set X) = ⋃ W ∈ s, ((I.support : Set X)ᶜ ∩ (W : Set X)) := by
    rw [← Set.inter_iUnion₂, huniv, Set.inter_univ, hsupp, compl_compl]
  rw [hcov]
  exact s.finite_toSet.isCompact_biUnion fun W _ => isCompact_compl_support_inter I hI W

end AlgebraicGeometry

end
