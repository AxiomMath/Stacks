module

public import Mathlib.CategoryTheory.Abelian.GrothendieckAxioms.Connected
public import Mathlib.CategoryTheory.Abelian.GrothendieckAxioms.SheafOfModules
public import Mathlib.CategoryTheory.Abelian.Subobject
public import Mathlib.CategoryTheory.Filtered.Connected
public import StacksFrontier.AlgebraicGeometry.CardinalGeneration.Basic

/-!
# Gabber's colimit presentation, reduced to the existence of bounded submodules

[Stacks, Tag 077N](https://stacks.math.columbia.edu/tag/077N) says that on a scheme `X` there is
a cardinal depending only on `X` such that every quasi-coherent `𝒪_X`-module is the directed
colimit of its quasi-coherent submodules generated by at most that many local sections. This file
proves the colimit assertion from the two inputs it genuinely needs: that the system of such
submodules is filtered, and that every section over an affine open is a section of one of them.

## Main results

* `Stacks.AlgebraicGeometry.CardinalGeneration.isColimit_cocone_of_exists_mem`: for a filtered
  system of bounded quasi-coherent subobjects whose sections exhaust those of `F` over the affine
  opens, the canonical cocone with vertex `F` is a colimit.

## Implementation notes

The argument is the one the source gives for the last sentence of its proof, and it is purely
formal once those two inputs are available. The comparison map out of the colimit is a
monomorphism because the index category is filtered and filtered colimits in `X.Modules` are
exact, so `colim` preserves the monomorphism of diagrams `D ⟹ const F` whose components are the
inclusions of the subobjects; and it is an isomorphism because a monomorphism of `𝒪_X`-modules
which is locally surjective on sections is an isomorphism, which is
`Stacks.AlgebraicGeometry.CardinalGeneration.isIso_of_mono_of_locallySurjective`. Affine opens
form a basis, so the hypothesis over affine opens gives local surjectivity over all opens.

Two points about how it is set up. The index category is the full subcategory of `Subobject F`
cut out by the boundedness property, so it lives in `Type (u + 1)` whereas `AB5OfSize.{u, u}`
speaks about shapes in `Type u`; exactness is therefore transported from the small model of the
index category, which exists because `X.Modules` is well-powered. And
`CategoryTheory.Limits.Cocone.isColimitOfIsIsoColimMapι` is stated for `colimMap` of the cocone's
natural transformation rather than for `colimit.desc`, so `colimMap_comp_constPointIso` identifies
the two. That isomorphism is left written out rather than abbreviated: naming it with `set` hides
it from instance search, which then cannot see that its underlying map is an isomorphism.

## References

* [Stacks Project, Tag 077N](https://stacks.math.columbia.edu/tag/077N)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace

universe u

namespace Stacks.AlgebraicGeometry.CardinalGeneration

/-- For a cocone `c` over a connected shape, `colimMap` of the cocone's own natural
transformation `D ⟹ const c.pt`, followed by the identification of the colimit of a constant
diagram with its value, is the canonical map `colimit D ⟶ c.pt`. This is what lets a statement
about `colimMap`, such as `CategoryTheory.Limits.Cocone.isColimitOfIsIsoColimMapι`, be applied to
`colimit.desc`. -/
theorem colimMap_comp_constPointIso {J : Type u} [Category.{u} J] [IsConnected J]
    {C : Type*} [Category C] {D : J ⥤ C} [HasColimitsOfShape J C] (c : Cocone D) :
    colimMap c.ι ≫ ((colimit.isColimit _).coconePointUniqueUpToIso
        (isColimitConstCocone J c.pt)).hom = colimit.desc D c := by
  refine colimit.hom_ext fun j => ?_
  have key : colimit.ι ((Functor.const J).obj c.pt) j ≫
      ((colimit.isColimit ((Functor.const J).obj c.pt)).coconePointUniqueUpToIso
        (isColimitConstCocone J c.pt)).hom = 𝟙 c.pt :=
    IsColimit.comp_coconePointUniqueUpToIso_hom _ _ _
  simp only [ι_colimMap_assoc, key]
  exact (Category.comp_id _).trans (colimit.ι_desc c j).symm

/-- A morphism that becomes a monomorphism after composing with an isomorphism is one. -/
theorem mono_of_comp_iso_eq {C : Type*} [Category C] {A B D : C} {f : A ⟶ B} (ε : B ≅ D)
    {g : A ⟶ D} (h : f ≫ ε.hom = g) (hf : Mono f) : Mono g := by
  rw [← h]
  exact @mono_comp _ _ _ _ _ f hf ε.hom inferInstance

/-- A morphism that becomes an isomorphism after composing with an isomorphism is one. -/
theorem isIso_of_comp_iso_eq {C : Type*} [Category C] {A B D : C} {f : A ⟶ B} (ε : B ≅ D)
    {g : A ⟶ D} (h : f ≫ ε.hom = g) (hg : IsIso g) : IsIso f :=
  @IsIso.of_isIso_fac_right _ _ _ _ _ ε.hom f g (Iso.isIso_hom ε) hg h

variable {X : AlgebraicGeometry.Scheme.{u}}

/-- Evaluating a composite of morphisms of `𝒪_X`-modules on a section is the composite of the
evaluations. -/
theorem comp_app_apply {M N P : X.Modules} (a : M ⟶ N) (b : N ⟶ P) (U : X.Opens) (t : Γ(M, U)) :
    (a ≫ b).app U t = b.app U (a.app U t) := by
  simp

/-- **Gabber's colimit presentation, from its two inputs.** If the quasi-coherent `κ`-generated
subobjects of an `𝒪_X`-module `F` form a filtered system, and every section of `F` over an affine
open is a section of one of them, then `F` is the colimit of that system.

Both hypotheses are about the system rather than about the colimit: the first is the directedness
assertion of Tag 077N, and the second is what the closure construction
`Stacks.AlgebraicGeometry.GabberColimit.exists_bounded_compatible_family` is for. -/
def isColimit_cocone_of_exists_mem (F : X.Modules) (κ : Cardinal.{u})
    [IsFiltered (CardinalGeneratedQuasicoherentSubobject F κ)]
    (hgen : ∀ (U : X.affineOpens) (s : Γ(F, U.1)),
      ∃ G : CardinalGeneratedQuasicoherentSubobject F κ,
        s ∈ Set.range (G.obj.arrow.app U.1)) :
    IsColimit (cardinalGeneratedQuasicoherentSubobjectCocone F κ) := by
  classical
  have hcol : HasColimitsOfShape (CardinalGeneratedQuasicoherentSubobject F κ) X.Modules :=
    hasColimitsOfShape_cardinalGeneratedQuasicoherentSubobject F κ
  have : IsFiltered (SmallModel (CardinalGeneratedQuasicoherentSubobject F κ)) :=
    IsFiltered.of_equivalence (equivSmallModel _)
  have : HasExactColimitsOfShape (CardinalGeneratedQuasicoherentSubobject F κ) X.Modules :=
    HasExactColimitsOfShape.of_domain_equivalence X.Modules (equivSmallModel _).symm
  have : IsConnected (CardinalGeneratedQuasicoherentSubobject F κ) := IsFiltered.isConnected _
  have : ∀ G : CardinalGeneratedQuasicoherentSubobject F κ,
      Mono ((cardinalGeneratedQuasicoherentSubobjectCocone F κ).ι.app G) :=
    fun G => Subobject.arrow_mono G.obj
  have : Mono (cardinalGeneratedQuasicoherentSubobjectCocone F κ).ι :=
    NatTrans.mono_of_mono_app _
  have hmcm : Mono (colimMap (cardinalGeneratedQuasicoherentSubobjectCocone F κ).ι) := by
    rw [colimMap_eq]
    exact Functor.map_mono _ _
  have hfac := colimMap_comp_constPointIso (cardinalGeneratedQuasicoherentSubobjectCocone F κ)
  -- the canonical map out of the colimit is a monomorphism
  have hmc : Mono (colimit.desc (cardinalGeneratedQuasicoherentSubobjectFunctor F κ)
      (cardinalGeneratedQuasicoherentSubobjectCocone F κ)) :=
    mono_of_comp_iso_eq _ hfac hmcm
  -- and it is locally surjective on sections: affine opens form a basis, and over an affine open
  -- every section of `F` comes from one of the subobjects
  have hloc : ∀ (U : X.Opens) (s : Γ(F, U)) (x : X), x ∈ U →
      ∃ V : X.Opens, ∃ hVU : V ≤ U, x ∈ V ∧
        F.presheaf.map (homOfLE hVU).op s ∈
          Set.range ((colimit.desc (cardinalGeneratedQuasicoherentSubobjectFunctor F κ)
            (cardinalGeneratedQuasicoherentSubobjectCocone F κ)).app V) := by
    intro U s x hxU
    obtain ⟨-, ⟨V, hVaff, rfl⟩, hxV, hVU⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ (U : Set X) from hxU) U.isOpen
    have hle : V ≤ U := hVU
    obtain ⟨G, y, hy⟩ := hgen ⟨V, hVaff⟩ (F.presheaf.map (homOfLE hle).op s)
    have hcomp : colimit.ι (cardinalGeneratedQuasicoherentSubobjectFunctor F κ) G ≫
        colimit.desc (cardinalGeneratedQuasicoherentSubobjectFunctor F κ)
          (cardinalGeneratedQuasicoherentSubobjectCocone F κ) = G.obj.arrow :=
      colimit.ι_desc _ _
    exact ⟨V, hle, hxV, ⟨(colimit.ι (cardinalGeneratedQuasicoherentSubobjectFunctor F κ) G).app V y,
      (comp_app_apply _ _ V y).symm.trans
        ((congrArg
          (fun f : (cardinalGeneratedQuasicoherentSubobjectFunctor F κ).obj G ⟶ F => f.app V y)
          hcomp).trans hy)⟩⟩
  have hiso : IsIso (colimit.desc (cardinalGeneratedQuasicoherentSubobjectFunctor F κ)
      (cardinalGeneratedQuasicoherentSubobjectCocone F κ)) :=
    @isIso_of_mono_of_locallySurjective X _ _ _ hmc hloc
  -- hence the comparison map of the cocone is an isomorphism, which is what makes it a colimit
  have : IsIso (colimMap (cardinalGeneratedQuasicoherentSubobjectCocone F κ).ι) :=
    isIso_of_comp_iso_eq _ hfac hiso
  exact Cocone.isColimitOfIsIsoColimMapι _

end Stacks.AlgebraicGeometry.CardinalGeneration

end
