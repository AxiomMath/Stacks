module

public import Mathlib.CategoryTheory.Abelian.GrothendieckAxioms.Basic
public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.Basic
public import Mathlib.CategoryTheory.Generator.Basic
public import Mathlib.CategoryTheory.Preadditive.LeftExact
public import StacksFrontier.AlgebraicGeometry.Properties.GabberResult.Abelian
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Quasi-coherent modules on a scheme: the Grothendieck axioms

For a scheme `X`, the abelian category of quasi-coherent `𝒪_X`-modules is a Grothendieck
abelian category. `CategoryTheory.IsGrothendieckAbelian` asks for three things beyond the
abelian structure: local smallness, filtered colimits of the ambient size, and exactness of
those colimits (AB5), together with a separator.

This file proves the colimit half of that list, and reduces the whole statement to the
separator.

## Main results

* `AlgebraicGeometry.quasicoherent_hasFilteredColimitsOfSize`: the category of quasi-coherent
  modules on a scheme has all filtered colimits of the size of the scheme.
* `AlgebraicGeometry.quasicoherent_hasExactFilteredColimitsOfShape`: those colimits are exact,
  which is Grothendieck's axiom AB5.
* `AlgebraicGeometry.quasicoherentModules_isGrothendieckAbelian_of_hasSeparator`: a scheme whose
  category of quasi-coherent modules has a separator has a Grothendieck abelian category of
  quasi-coherent modules.

## Implementation notes

Colimits of quasi-coherent modules are computed in all `𝒪_X`-modules, because quasi-coherence is
closed under colimits of any shape living in the scheme's universe
(`Stacks.AlgebraicGeometry.QuasicoherentColimits.isClosedUnderColimitsOfShape`); that closure is
what both colimit results rest on. Exactness is then transported from the ambient category: the
full subcategory inclusion creates the colimits and preserves finite limits, the latter because
it preserves kernels and the subcategory has finite products and a zero object.

The separator is not proved here. It is the one assertion of
[Stacks, Tag 077P](https://stacks.math.columbia.edu/tag/077P) that does not follow from the
closure properties of quasi-coherence: it needs Gabber's presentation of a quasi-coherent module
as the directed colimit of its quasi-coherent submodules generated by boundedly many local
sections, which is [Stacks, Tag 077N](https://stacks.math.columbia.edu/tag/077N) and is not yet
available. `StacksFrontier/AlgebraicGeometry/CardinalGeneration/Basic.lean` supplies the
cardinal, the diagram and the cocone of that presentation, but not the proof that the cocone is
colimiting. Accordingly no `@[stacks 077P]` attribute is carried anywhere in this file: the tag
labels the full Grothendieck assertion, and attaching it to the colimit half alone would claim
the separator.

## References

* [Stacks Project, Tag 077P](https://stacks.math.columbia.edu/tag/077P)
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open AlgebraicGeometry Scheme.Modules

namespace AlgebraicGeometry

/-- The category of quasi-coherent modules on a scheme has all filtered colimits of the size of
the scheme: they are the colimits of all `𝒪_X`-modules, quasi-coherence being closed under
them. -/
lemma quasicoherent_hasFilteredColimitsOfSize (X : Scheme.{u}) :
    HasFilteredColimitsOfSize.{u, u}
      (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory :=
  ⟨fun J _ _ => by
    have : (SheafOfModules.isQuasicoherent X.ringCatSheaf).IsClosedUnderColimitsOfShape J :=
      Stacks.AlgebraicGeometry.QuasicoherentColimits.isClosedUnderColimitsOfShape X
    exact Limits.hasColimitsOfShape_of_closedUnderColimits J _⟩

/-- **Grothendieck's axiom AB5 for quasi-coherent modules.** A filtered colimit of quasi-coherent
modules on a scheme is exact.

The colimit is created by the inclusion of the quasi-coherent modules into all `𝒪_X`-modules,
and that inclusion preserves finite limits, so exactness in the ambient category gives exactness
here. -/
@[sga "6 II 3.1" "partial"]
lemma quasicoherent_hasExactFilteredColimitsOfShape (X : Scheme.{u})
    (J : Type u) [Category.{u, u} J] [IsFiltered J]
    [HasColimitsOfShape J (X.Modules)]
    [HasColimitsOfShape J (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory] :
    HasExactColimitsOfShape J
      (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory := by
  let P : ObjectProperty (SheafOfModules X.ringCatSheaf) :=
    SheafOfModules.isQuasicoherent X.ringCatSheaf
  have : Abelian P.FullSubcategory := quasicoherentModules_abelian X
  let U : SheafOfModules X.ringCatSheaf := SheafOfModules.unit X.ringCatSheaf
  have hU : U.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffineQcohPushforward.isQuasicoherent_unit X
  have : P.IsClosedUnderKernels := ⟨by
    rintro _ ⟨f, k, hk, ⟨hX, hY⟩⟩
    exact P.prop_of_iso (IsLimit.conePointUniqueUpToIso (kernelIsKernel f) hk)
      (@Stacks.AlgebraicGeometry.QcohLimits.isQuasicoherent_kernel X _ _ f hX hY)⟩
  have : P.ContainsZero :=
    ⟨⟨kernel (𝟙 U), isZero_kernel_of_mono (𝟙 U), P.prop_kernel (𝟙 U) hU hU⟩⟩
  have : P.IsClosedUnderBinaryProducts := by
    refine ⟨?_⟩
    rintro Z ⟨p⟩
    let A := p.diag.obj ⟨WalkingPair.left⟩
    let B := p.diag.obj ⟨WalkingPair.right⟩
    have hprod : P (A ⨯ B) := @isQuasicoherent_binaryProduct X A B
      (p.prop_diag_obj ⟨WalkingPair.left⟩) (p.prop_diag_obj ⟨WalkingPair.right⟩)
    have e : Z ≅ A ⨯ B :=
      p.isLimit.conePointUniqueUpToIso (limit.isLimit p.diag) ≪≫
        HasLimit.isoOfNatIso (Limits.diagramIsoPair p.diag)
    exact P.prop_of_iso e.symm hprod
  have : P.IsClosedUnderFiniteProducts :=
    ObjectProperty.IsClosedUnderFiniteProducts.mk'
  have : PreservesFiniteLimits P.ι := by
    have : HasBinaryBiproducts P.FullSubcategory :=
      HasBinaryBiproducts.of_hasBinaryProducts
    have := P.preservesKernels_ι
    exact P.ι.preservesFiniteLimits_of_preservesKernels
  have : P.IsClosedUnderColimitsOfShape J :=
    Stacks.AlgebraicGeometry.QuasicoherentColimits.isClosedUnderColimitsOfShape X
  have : CreatesColimitsOfShape J P.ι :=
    Limits.createsColimitsOfShapeFullSubcategoryInclusion J P
  have : PreservesColimitsOfShape J P.ι :=
    preservesColimitOfShape_of_createsColimitsOfShape_and_hasColimitsOfShape P.ι
  exact HasExactColimitsOfShape.domain_of_functor J P.ι

/-- Granted a separator, the category of quasi-coherent modules on a scheme is Grothendieck
abelian: local smallness, filtered colimits and their exactness are the three statements above
and the abelian structure of
`StacksFrontier/AlgebraicGeometry/Properties/GabberResult/Abelian.lean`.

The separator is the remaining content of Tag 077P, and this is the reduction of the tag to
it. -/
lemma quasicoherentModules_isGrothendieckAbelian_of_hasSeparator (X : Scheme.{u})
    [HasSeparator (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory] :
    IsGrothendieckAbelian.{u}
      (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory where
  hasFilteredColimitsOfSize := quasicoherent_hasFilteredColimitsOfSize X
  ab5OfSize :=
    haveI := quasicoherent_hasFilteredColimitsOfSize X
    ⟨fun J _ _ => quasicoherent_hasExactFilteredColimitsOfShape X J⟩

end AlgebraicGeometry

end
