private lemma encard_eq_iSup_finset_sum_fibres {α β : Type u} (s : Set α)
    (f : α → β) :
    s.encard = ⨆ t : Finset β, ∑ b ∈ t, (s ∩ f ⁻¹' ({b} : Set β)).encard := by
  classical
  let fibre : β → Set α := fun b => s ∩ f ⁻¹' ({b} : Set β)
  have hdisj : Pairwise (Function.onFun Disjoint fibre) := by
    intro a b hab
    show Disjoint (fibre a) (fibre b)
    rw [Set.disjoint_left]
    intro z hz hz'
    have hza : f z = a := by simpa [fibre] using hz.2
    have hzb : f z = b := by simpa [fibre] using hz'.2
    exact hab (hza.symm.trans hzb)
  have hsubset (t : Finset β) : (⋃ b ∈ (t : Set β), fibre b) ⊆ s := by
    intro z hz
    obtain ⟨b, hbt, hzb⟩ := Set.mem_iUnion₂.mp hz
    exact hzb.1
  have hpartial (t : Finset β) :
      (⋃ b ∈ (t : Set β), fibre b).encard = ∑ b ∈ t, (fibre b).encard := by
    have h := Set.Finite.encard_biUnion t.finite_toSet
      (fun a ha b hb hab => hdisj hab)
    rw [finsum_mem_eq_finite_toFinset_sum _ t.finite_toSet] at h
    simpa using h
  have hle (t : Finset β) :
      (∑ b ∈ t, (fibre b).encard) ≤ s.encard := by
    rw [← hpartial t]
    exact Set.encard_mono (hsubset t)
  have hcover : s = ⋃ b, fibre b := by
    ext z
    constructor
    · intro hz
      exact Set.mem_iUnion.mpr ⟨f z, Set.mem_inter hz (by simp)⟩
    · intro hz
      simp only [Set.mem_iUnion] at hz
      obtain ⟨b, hb⟩ := hz
      exact hb.1
  apply le_antisymm
  · obtain hs | hs := s.finite_or_infinite
    · have hfs : (f '' s).Finite := hs.image f
      let t := hfs.toFinset
      have hcover' : s = ⋃ b ∈ (t : Set β), fibre b := by
        ext z
        constructor
        · intro hz
          have hfb : f z ∈ t := hfs.mem_toFinset.mpr ⟨z, hz, rfl⟩
          exact Set.mem_iUnion₂.mpr ⟨f z, hfb, Set.mem_inter hz (by simp)⟩
        · intro hz
          obtain ⟨b, _, hb⟩ := Set.mem_iUnion₂.mp hz
          exact hb.1
      have hsum : s.encard = ∑ b ∈ t, (fibre b).encard := by
        rw [hcover', hpartial]
      rw [hsum]
      exact le_iSup_of_le t le_rfl
    · have htop : (⨆ t : Finset β, ∑ b ∈ t, (fibre b).encard) = ⊤ := by
        rw [iSup_eq_top]
        intro n hn
        by_cases hInf : ∃ b, (fibre b).Infinite
        · obtain ⟨b, hb⟩ := hInf
          refine ⟨{b}, ?_⟩
          simpa [hb] using hn
        · have hfiniteFib : ∀ b, (fibre b).Finite := fun b => by
            by_contra h
            exact hInf ⟨b, Set.not_finite.mp h⟩
          have hsupp : (f '' s).Infinite := by
            intro hfinite
            have hcover' : s = ⋃ b ∈ (f '' s), fibre b := by
              ext z
              constructor
              · intro hz
                exact Set.mem_iUnion₂.mpr ⟨f z, ⟨z, hz, rfl⟩,
                  Set.mem_inter hz (by simp)⟩
              · intro hz
                obtain ⟨b, _, hb⟩ := Set.mem_iUnion₂.mp hz
                exact hb.1
            have hsfinite : s.Finite := by
              rw [hcover']
              exact hfinite.biUnion (fun b _ => hfiniteFib b)
            exact hs hsfinite
          cases n with
          | top => exact False.elim ((not_lt_of_ge le_top) hn)
          | coe n =>
            obtain ⟨t, ht, hcard⟩ := hsupp.exists_subset_card_eq (n + 1)
            have hsum : (↑(n + 1) : ℕ∞) ≤ ∑ b ∈ t, (fibre b).encard := by
              calc
                (↑(n + 1) : ℕ∞) = ∑ b ∈ t, (1 : ℕ∞) := by simp [hcard]
                _ ≤ ∑ b ∈ t, (fibre b).encard := by
                  apply Finset.sum_le_sum
                  intro b hb
                  obtain ⟨a, ha, hba⟩ := ht hb
                  have hnon : (fibre b).Nonempty := by
                    refine ⟨a, ?_⟩
                    simp [fibre, ha, hba]
                  exact (Order.one_le_iff_ne_zero.mpr (Set.encard_ne_zero.mpr hnon))
            refine ⟨t, ?_⟩
            exact lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self n) hsum
      rw [hs.encard_eq, htop]
  · refine iSup_le fun t => hle t

private theorem comap_mem_minimalPrimes_of_flat
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    {q : Ideal S} (hq : q ∈ minimalPrimes S) :
    Ideal.comap (algebraMap R S) q ∈ minimalPrimes R := by
  let : Algebra.HasGoingDown R S := Algebra.HasGoingDown.of_flat
  let : q.IsPrime := hq.isPrime
  set p : Ideal R := Ideal.comap (algebraMap R S) q
  show Minimal (fun r : Ideal R => r.IsPrime ∧ (⊥ : Ideal R) ≤ r) p
  refine ⟨⟨Ideal.IsPrime.comap _, bot_le⟩, fun p₀ hp₀ hp₀le => ?_⟩
  let : p₀.IsPrime := hp₀.1
  by_contra hnle
  have hlt : p₀ < p := lt_of_le_of_ne hp₀le (fun h => hnle (h ▸ le_rfl))
  have hlt' : p₀ < Ideal.under R q := hlt
  obtain ⟨P, hPle, hPprime, hPlies⟩ :=
    Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt q hlt'
  have hqP : q ≤ P := hq.right ⟨hPprime, bot_le⟩ hPle
  have hPunder : p₀ = P.comap (algebraMap R S) := by
    have := hPlies.over
    rwa [Ideal.under_def] at this
  exact hnle ((Ideal.comap_mono hqP).trans_eq hPunder.symm)

private theorem encard_fiber_minimalPrimes_eq_quotient
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.FaithfullyFlat R S] (p : minimalPrimes R) :
    Set.encard {q : minimalPrimes S |
        Ideal.comap (algebraMap R S) q.1 = p.1} =
      Set.encard (minimalPrimes (S ⧸ p.1.map (algebraMap R S))) := by
  classical
  let f := algebraMap R S
  let I := p.1.map f
  let fiber : Set (minimalPrimes S) := {q |
    Ideal.comap f q.1 = p.1}
  let over : Set (Ideal S) := I.minimalPrimes
  have fiberEquiv : fiber ≃ over := by
    let toFun : fiber → over := fun q => ⟨q.1.1, by
      refine ⟨⟨q.1.2.isPrime, ?_⟩, ?_⟩
      · rw [Ideal.map_le_iff_le_comap]
        exact q.2.symm ▸ le_rfl
      · intro r hr hrq
        exact q.1.2.2 ⟨hr.1, bot_le⟩ hrq⟩
    let invFun : over → fiber := fun q => by
      let q' : Ideal S := q.1
      have : q'.IsPrime := q.2.1.1
      have : p.1.IsPrime := p.2.isPrime
      have hcon : q'.comap f = p.1 := by
        let : Algebra.HasGoingDown R S := Algebra.HasGoingDown.of_flat
        by_contra hne
        have hple : p.1 ≤ q'.comap f := by
          rw [← Ideal.map_le_iff_le_comap]
          simpa [I, f] using q.2.1.2
        have hlt : p.1 < q'.comap f := lt_of_le_of_ne hple (Ne.symm hne)
        obtain ⟨P, hPle, hPprime, hPlies⟩ :=
          Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt q' hlt
        have hpP : I ≤ P := by
          apply Ideal.map_le_iff_le_comap.mpr
          rw [hPlies.over]
        have hqP : q' ≤ P := q.2.2 ⟨hPprime, hpP⟩ hPle
        have heq : q' = P := le_antisymm hqP hPle
        have hPunder : p.1 = P.comap f := by
          have := hPlies.over
          rwa [Ideal.under_def] at this
        exact hne (by rw [heq, ← hPunder])
      have hmin : q' ∈ minimalPrimes S := by
        show Minimal (fun r : Ideal S => r.IsPrime ∧ (⊥ : Ideal S) ≤ r) q'
        refine ⟨⟨q.2.1.1, bot_le⟩, ?_⟩
        intro r hr hrq
        let : r.IsPrime := hr.1
        have hrc : r.comap f ≤ p.1 := by rw [← hcon]; exact Ideal.comap_mono hrq
        have hprc : p.1 ≤ r.comap f :=
          p.2.2 ⟨Ideal.IsPrime.comap f, bot_le⟩ hrc
        have hIr : I ≤ r := Ideal.map_le_iff_le_comap.mpr hprc
        exact q.2.2 ⟨hr.1, hIr⟩ hrq
      exact ⟨⟨q', hmin⟩, hcon⟩
    exact ⟨toFun, invFun, fun _ => rfl, fun _ => rfl⟩
  refine (Set.encard_congr fiberEquiv).trans ?_
  show I.minimalPrimes.encard = (minimalPrimes (S ⧸ I)).encard
  rw [Ideal.minimalPrimes_eq_comap]
  exact (Ideal.comap_injective_of_surjective (f := Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective).encard_image _

private theorem encard_minimalPrimes_eq_iSup_sum_quotients
    {R S : Type u} [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S]
    [Module.FaithfullyFlat R S] :
    Set.encard (minimalPrimes S) =
      ⨆ t : Finset (minimalPrimes R),
        ∑ p ∈ t, Set.encard (minimalPrimes (S ⧸ p.1.map (algebraMap R S))) := by
  classical
  obtain ⟨p₀, hp₀, _⟩ := Ideal.exists_minimalPrimes_le
    (I := (⊥ : Ideal R)) (J := maximalIdeal R) bot_le
  let pDefault : minimalPrimes R := ⟨p₀, hp₀⟩
  let f : Ideal S → minimalPrimes R := fun q =>
    if hq : q ∈ minimalPrimes S then
      ⟨Ideal.comap (algebraMap R S) q, comap_mem_minimalPrimes_of_flat hq⟩
    else pDefault
  have h := encard_eq_iSup_finset_sum_fibres (minimalPrimes S) f
  rw [h]
  refine iSup_congr fun t => ?_
  apply Finset.sum_congr rfl
  intro p hp
  have hfiber :
      Set.encard (minimalPrimes S ∩ f ⁻¹' ({p} : Set (minimalPrimes R))) =
        Set.encard {q : minimalPrimes S |
          Ideal.comap (algebraMap R S) q.1 = p.1} := by
    classical
    let e : ↥(minimalPrimes S ∩ f ⁻¹' ({p} : Set (minimalPrimes R))) ≃
        ↥{q : minimalPrimes S | Ideal.comap (algebraMap R S) q.1 = p.1} :=
      { toFun := fun q => ⟨⟨q.1, q.2.1⟩, by
          have h := q.2.2
          change f q.1 ∈ ({p} : Set (minimalPrimes R)) at h
          have heq := Set.mem_singleton_iff.mp h
          show Ideal.comap (algebraMap R S) q.1 = p.1
          simpa only [f, dite_eq_left q.2.1] using congrArg Subtype.val heq⟩,
        invFun := fun q => ⟨q.1.1, ⟨q.1.2, by
          have hq := q.2
          change Ideal.comap (algebraMap R S) q.1.1 = p.1 at hq
          show f q.1.1 = p
          unfold f
          rw [dite_eq_left q.1.2]
          exact Subtype.ext hq⟩⟩
        left_inv := by intro q; apply Subtype.ext; rfl
        right_inv := by intro q; apply Subtype.ext; apply Subtype.ext; rfl }
    exact Set.encard_congr e
  rw [hfiber]
  exact encard_fiber_minimalPrimes_eq_quotient p

private noncomputable def affineComponentsThroughEquiv
    {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime] :
    PrimeSpectrum.irreducibleComponentsThrough A p ≃ minimalPrimes (Localization.AtPrime p) := by
  classical
  let toFun : PrimeSpectrum.irreducibleComponentsThrough A p →
      minimalPrimes (Localization.AtPrime p) := fun W => by
    have hWmem : W.1 ∈ PrimeSpectrum.irreducibleComponentsThrough A p := W.2
    change W.1 ∈ irreducibleComponents (PrimeSpectrum A) ∧ PrimeSpectrum.pt A p ∈ W.1 at hWmem
    let J := PrimeSpectrum.vanishingIdeal W.1
    have hJmin : J ∈ minimalPrimes A := by
      rw [PrimeSpectrum.vanishingIdeal_mem_minimalPrimes,
        (isClosed_of_mem_irreducibleComponents W.1 hWmem.1).closure_eq]
      exact hWmem.1
    have hJp : J ≤ p := by
      intro a ha
      exact (PrimeSpectrum.mem_vanishingIdeal W.1 a).mp ha (PrimeSpectrum.pt A p) hWmem.2
    let Jloc := J.map (algebraMap A (Localization.AtPrime p))
    have hdisj : Disjoint (p.primeCompl : Set A) (J : Set A) :=
      Set.disjoint_left.mpr fun _ hp' hJ' => hp' (hJp hJ')
    have hunder : Ideal.under A Jloc = J :=
      IsLocalization.under_map_of_isPrime_disjoint p.primeCompl
        (Localization.AtPrime p) hJmin.isPrime hdisj
    have hJloc' : Jloc ∈
        (((⊥ : Ideal A).map (algebraMap A (Localization.AtPrime p))).minimalPrimes) := by
      rw [IsLocalization.minimalPrimes_map p.primeCompl
        (Localization.AtPrime p) (⊥ : Ideal A)]
      change Ideal.under A Jloc ∈ minimalPrimes A
      rw [hunder]
      exact hJmin
    have hJloc : Jloc ∈ minimalPrimes (Localization.AtPrime p) := by
      simpa only [Ideal.map_bot] using hJloc'
    exact ⟨Jloc, hJloc⟩
  let invFun : minimalPrimes (Localization.AtPrime p) →
      PrimeSpectrum.irreducibleComponentsThrough A p := fun q => by
    let J := Ideal.under A q.1
    have hqprime : q.1.IsPrime := q.2.isPrime
    have hJprime : J.IsPrime := hqprime.comap _
    have hJp : J ≤ p := by
      intro a ha
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (Localization.AtPrime p) p a).mp
        (IsLocalRing.le_maximalIdeal hqprime.ne_top ha)
    have hJmin : J ∈ minimalPrimes A := by
      change Minimal (fun r : Ideal A => r.IsPrime ∧ (⊥ : Ideal A) ≤ r) J
      refine ⟨⟨hJprime, bot_le⟩, ?_⟩
      intro J₀ hJ₀ hJ₀le
      have hdisj : Disjoint (p.primeCompl : Set A) (J₀ : Set A) :=
        Set.disjoint_left.mpr fun _ hp' hJ₀' => hp' (hJ₀le.trans hJp hJ₀')
      have hJ₀maple : J₀.map (algebraMap A (Localization.AtPrime p)) ≤ q.1 :=
        Ideal.map_le_iff_le_comap.mpr hJ₀le
      have hmap : J₀.map (algebraMap A (Localization.AtPrime p)) = q.1 := by
        apply le_antisymm hJ₀maple
        exact q.2.2 ⟨IsLocalization.isPrime_of_isPrime_disjoint
          p.primeCompl (Localization.AtPrime p) J₀ hJ₀.1 hdisj, bot_le⟩ hJ₀maple
      have hunder : J₀ = J := by
        rw [← IsLocalization.under_map_of_isPrime_disjoint p.primeCompl
          (Localization.AtPrime p) hJ₀.1 hdisj, hmap]
      rw [hunder]
    have hW : PrimeSpectrum.zeroLocus (J : Set A) ∈
        irreducibleComponents (PrimeSpectrum A) := by
      rw [irreducibleComponents_eq_maximals_closed]
      refine ⟨⟨PrimeSpectrum.isClosed_zeroLocus _,
        (PrimeSpectrum.isIrreducible_zeroLocus_iff_of_radical _
          hJprime.isRadical).mpr hJprime⟩, ?_⟩
      rintro Z ⟨hZclosed, hZirr⟩ hsub
      have hZle : PrimeSpectrum.vanishingIdeal Z ≤ J := by
        rw [← hJprime.isRadical.radical, ←
          PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical]
        exact PrimeSpectrum.vanishingIdeal_anti_mono hsub
      have heq : J = PrimeSpectrum.vanishingIdeal Z := by
        apply le_antisymm _ hZle
        exact hJmin.2 ⟨PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hZirr,
          bot_le⟩ hZle
      have hZeq : Z = PrimeSpectrum.zeroLocus J := by
        calc
          Z = PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal Z) := by
            rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hZclosed.closure_eq]
          _ = PrimeSpectrum.zeroLocus J :=
            congrArg (fun I : Ideal A => PrimeSpectrum.zeroLocus (I : Set A)) heq.symm
      exact hZeq.subset
    have hpoint : PrimeSpectrum.pt A p ∈ PrimeSpectrum.zeroLocus (J : Set A) := by
      rw [PrimeSpectrum.mem_zeroLocus]
      intro a ha
      exact hJp ha
    exact ⟨PrimeSpectrum.zeroLocus J, ⟨hW, hpoint⟩⟩
  refine ⟨toFun, invFun, ?_, ?_⟩
  · intro W
    apply Subtype.ext
    have hWmem : W.1 ∈ PrimeSpectrum.irreducibleComponentsThrough A p := W.2
    change W.1 ∈ irreducibleComponents (PrimeSpectrum A) ∧ PrimeSpectrum.pt A p ∈ W.1 at hWmem
    let J := PrimeSpectrum.vanishingIdeal W.1
    have hJmin : J ∈ minimalPrimes A := by
      rw [PrimeSpectrum.vanishingIdeal_mem_minimalPrimes,
        (isClosed_of_mem_irreducibleComponents W.1 hWmem.1).closure_eq]
      exact hWmem.1
    have hJp : J ≤ p := by
      intro a ha
      exact (PrimeSpectrum.mem_vanishingIdeal W.1 a).mp ha (PrimeSpectrum.pt A p) hWmem.2
    have hdisj : Disjoint (p.primeCompl : Set A) (J : Set A) :=
      Set.disjoint_left.mpr fun _ hp' hJ' => hp' (hJp hJ')
    change PrimeSpectrum.zeroLocus (Ideal.under A
      (J.map (algebraMap A (Localization.AtPrime p)))) = W.1
    rw [IsLocalization.under_map_of_isPrime_disjoint p.primeCompl
      (Localization.AtPrime p) hJmin.isPrime hdisj,
      PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
      (isClosed_of_mem_irreducibleComponents W.1 hWmem.1).closure_eq]
  · intro q
    apply Subtype.ext
    change (PrimeSpectrum.vanishingIdeal
      (PrimeSpectrum.zeroLocus (Ideal.under A q.1)) ).map
      (algebraMap A (Localization.AtPrime p)) = q.1
    rw [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical]
    have hqprime : q.1.IsPrime := q.2.isPrime
    have hJprime : (Ideal.under A q.1).IsPrime := hqprime.comap _
    rw [hJprime.isRadical.radical]
    exact IsLocalization.map_under p.primeCompl (Localization.AtPrime p) q.1

private theorem isSepClosure_transport_right {K L M : Type u} [Field K] [Field L] [Field M]
    [Algebra K L] [Algebra K M] [IsSepClosure K L] (e : L ≃+* M)
    (he : ∀ x, e (algebraMap K L x) = algebraMap K M x) : IsSepClosure K M := by
  rw [isSepClosure_iff]
  let : IsSepClosed L := IsSepClosure.sep_closed K
  refine ⟨IsSepClosed.of_ringEquiv e.symm, ?_⟩
  apply Algebra.IsSeparable.of_equiv_equiv (RingEquiv.refl K) e
  ext x
  exact (he x).symm

private theorem isLocalRing_quotient_of_proper_ideal {R : Type u} [CommRing R]
    [IsLocalRing R] {I : Ideal R} (hI : I ≠ ⊤) : IsLocalRing (R ⧸ I) := by
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective

private theorem encard_minimalPrimes_strictHenselization_quotient
    (A : Type u) [CommRing A] [IsLocalRing A] (p : Ideal A) [p.IsPrime]
    (hp : p ∈ minimalPrimes A)
    [IsLocalRing (A ⧸ p)] :
    Set.encard (minimalPrimes
        ((strictHenselizationData A).carrier ⧸
          p.map (algebraMap A (strictHenselizationData A).carrier))) =
      numberOfGeometricBranchesOfLocalRing (A ⧸ p) := by
  classical
  let D := (strictHenselizationData A).carrier
  let K := SeparableClosure (ResidueField A)
  let : CommRing D := (strictHenselizationData A).commRing
  let : IsLocalRing D := (strictHenselizationData A).isLocalRing
  let : Algebra A D := (strictHenselizationData A).algebra
  let : Field K := inferInstance
  let : Algebra (ResidueField A) K := inferInstance
  let : IsHenselization A K D := (strictHenselizationData A).isHenselization
  let : IsLocalHom (algebraMap A D) := IsLocalRing.IsHenselization.isLocalHom (L := K)
  let : HenselianLocalRing D := IsLocalRing.IsHenselization.henselian A K
  let hmax : (maximalIdeal A).map (algebraMap A D) = maximalIdeal D :=
    IsLocalRing.IsHenselization.map_maximalIdeal (L := K)
  obtain ⟨eD, heD⟩ := IsLocalRing.IsHenselization.exists_residueFieldEquiv
    (R := A) (L := K) (Rh := D)
  have hSepD : IsSepClosure (ResidueField A) (ResidueField D) := by
    apply isSepClosure_transport_right eD
    intro x
    obtain ⟨a, rfl⟩ := residue_surjective x
    rw [ResidueField.algebraMap_residue]
    exact heD a
  let : IsSepClosure (ResidueField A) (ResidueField D) := hSepD
  have hpProper : p ≠ ⊤ := hp.isPrime.ne_top
  have hpMax : p ≤ maximalIdeal A := IsLocalRing.le_maximalIdeal hpProper
  obtain ⟨hLocA0, hLocD0, hLocHomD0, hHensD0, hIndD0, hMaxD0, hSepD0⟩ :=
    @IsLocalRing.strictHenselization_quotient A D inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance hSepD
      (IsLocalRing.IsHenselization.ind_etale_of_universe_le K) hmax p hpMax
  let A0 := A ⧸ p
  let D0 := D ⧸ p.map (algebraMap A D)
  let : IsLocalRing A0 := hLocA0
  let Qdata := strictHenselizationData A0
  let Q := Qdata.carrier
  let L0 := SeparableClosure (ResidueField A0)
  let : CommRing Q := Qdata.commRing
  let : IsLocalRing Q := Qdata.isLocalRing
  let : Algebra A0 Q := Qdata.algebra
  let : IsLocalHom (algebraMap A0 Q) :=
    IsLocalRing.IsHenselization.isLocalHom (R := A0) (L := L0) (Rh := Q)
  let : Field L0 := inferInstance
  let : Algebra (ResidueField A0) L0 := inferInstance
  let : IsSepClosure (ResidueField A0) L0 := inferInstance
  let : IsHenselization A0 L0 Q := Qdata.isHenselization
  let : HenselianLocalRing Q := IsLocalRing.IsHenselization.henselian A0 L0
  let : IsLocalRing D0 := hLocD0
  let : CommRing D0 := inferInstance
  let : Algebra A0 D0 := inferInstance
  let : HenselianLocalRing D0 := hHensD0
  let : IsLocalHom (algebraMap A0 D0) := hLocHomD0
  let : IsSepClosure (ResidueField A0) (ResidueField D0) := hSepD0
  let eD0 := IsSepClosure.equiv (ResidueField A0) L0 (ResidueField D0)
  obtain ⟨eQ, heQ⟩ := IsLocalRing.IsHenselization.exists_residueFieldEquiv
    (R := A0) (L := L0) (Rh := Q)
  have hSepQ : IsSepClosure (ResidueField A0) (ResidueField Q) := by
    apply isSepClosure_transport_right eQ
    intro x
    obtain ⟨a, rfl⟩ := residue_surjective x
    rw [ResidueField.algebraMap_residue]
    exact heQ a
  let : IsSepClosure (ResidueField A0) (ResidueField Q) := hSepQ
  let pD : D0 →ₐ[A0] L0 :=
    { toRingHom := eD0.symm.toRingHom.comp (residue D0)
      commutes' := fun x => by
        show eD0.symm (residue D0 (algebraMap A0 D0 x)) = algebraMap A0 L0 x
        apply eD0.injective
        simp only [AlgEquiv.apply_symm_apply]
        show residue D0 (algebraMap A0 D0 x) =
          eD0 (algebraMap (ResidueField A0) L0 (residue A0 x))
        calc
          residue D0 (algebraMap A0 D0 x) =
              algebraMap (ResidueField A0) (ResidueField D0) (residue A0 x) :=
            (ResidueField.algebraMap_residue (R := A0) (S := D0) x).symm
          _ = eD0 (algebraMap (ResidueField A0) L0 (residue A0 x)) :=
            (eD0.commutes (residue A0 x)).symm }
  let pQ : Q →ₐ[A0] L0 :=
    { toRingHom := eQ.symm.toRingHom.comp (residue Q)
      commutes' := fun x => by
        show eQ.symm (residue Q (algebraMap A0 Q x)) = algebraMap A0 L0 x
        apply eQ.injective
        simp only [RingEquiv.apply_symm_apply]
        exact (heQ x).symm }
  have hpDsurj : Function.Surjective pD := by
    intro x
    obtain ⟨y, hy⟩ := residue_surjective (eD0 x)
    refine ⟨y, ?_⟩
    show eD0.symm (residue D0 y) = x
    rw [hy]
    simp
  have hpQsurj : Function.Surjective pQ := by
    intro x
    obtain ⟨y, hy⟩ := residue_surjective (eQ x)
    refine ⟨y, ?_⟩
    show eQ.symm (residue Q y) = x
    rw [hy]
    simp
  have hIndQ := IsLocalRing.IsHenselization.ind_etale_of_universe_le
    (R := A0) (L := L0) (Rh := Q)
  obtain ⟨eDQ, -⟩ := HenselianLocalRing.existsUnique_algEquiv_of_ind_etale
    hIndD0 hIndQ pD pQ hpDsurj hpQsurj
  show Set.encard (minimalPrimes D0) = _
  rw [numberOfGeometricBranchesOfLocalRing_eq_encard_minimalPrimes]
  exact (Set.encard_congr (minimalPrimes_equiv_of_ringEquiv eDQ.toRingEquiv))

private theorem ind_etale_of_base_equiv.{uBase} {R S A : Type uBase} [CommRing R] [CommRing S]
    [CommRing A] [Algebra R A] [Algebra S A] (e : S ≃+* R)
    (he : ∀ s, algebraMap S A s = algebraMap R A (e s))
    (h : (CommAlgCat.etale R).ind.{uBase} (CommAlgCat.of R A)) :
    (CommAlgCat.etale S).ind.{uBase} (CommAlgCat.of S A) := by
  let E := (commAlgCatEquivUnder (.of R)).trans
    ((Under.mapIso e.toCommRingCatIso).trans (commAlgCatEquivUnder (.of S)).symm)
  obtain ⟨J, _, _, pres, hp⟩ := h
  refine ⟨J, inferInstance, inferInstance, (pres.map E.functor).ofIso ?_, fun j => ?_⟩
  · let B : CommAlgCat S := E.functor.obj (CommAlgCat.of R A)
    let f : B ≃ₐ[S] A := { toRingEquiv := RingEquiv.refl A, commutes' := fun s => (he s).symm }
    exact CommAlgCat.isoMk f
  · let B := pres.diag.obj j
    let : Algebra S R := e.toRingHom.toAlgebra
    let : Algebra S B := ((algebraMap R B).comp e.toRingHom).toAlgebra
    have : IsScalarTower S R B := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale S R := RingHom.Etale.toAlgebra (RingHom.Etale.of_bijective e.bijective)
    have : Algebra.Etale R B := hp j
    exact Algebra.Etale.comp S R B

/-- A separable closure transports along a compatible pair of ring isomorphisms, one of the base
field and one of the closure. The same statement is proved in the root namespace of
`StacksFrontier.RingTheory.Henselian.PermanenceOfProperties`, where it is `private` and hence out
of scope here. -/
public theorem isSepClosure_of_equiv_equiv
    {K L M N : Type*} [Field K] [Field L] [Field M] [Field N]
    [Algebra K L] [Algebra M N] [IsSepClosure K L]
    (e : K ≃+* M) (f : L ≃+* N)
    (h : (algebraMap M N).comp e.toRingHom =
      f.toRingHom.comp (algebraMap K L)) : IsSepClosure M N := by
  have : IsSepClosed L := IsSepClosure.sep_closed K
  have : IsSepClosed N := by
    let : Algebra L N := f.toRingHom.toAlgebra
    have : Algebra.IsAlgebraic L N := ⟨fun x =>
      (show x = algebraMap L N (f.symm x) by simp [RingHom.algebraMap_toAlgebra]) ▸
        isAlgebraic_algebraMap (f.symm x)⟩
    exact Algebra.IsAlgebraic.isSepClosed (F := L) (E := N)
  exact ⟨this, Algebra.IsSeparable.of_equiv_equiv e f h⟩

private theorem encard_minimalPrimes_strictHenselization_ringEquiv
    (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    (e : A ≃+* B) :
    Set.encard (minimalPrimes (strictHenselizationData A).carrier) =
      Set.encard (minimalPrimes (strictHenselizationData B).carrier) := by
  classical
  let DA := (strictHenselizationData A).carrier
  let DB := (strictHenselizationData B).carrier
  let : CommRing DA := (strictHenselizationData A).commRing
  let : CommRing DB := (strictHenselizationData B).commRing
  let : IsLocalRing DA := (strictHenselizationData A).isLocalRing
  let : IsLocalRing DB := (strictHenselizationData B).isLocalRing
  let : Algebra A DA := (strictHenselizationData A).algebra
  let : Algebra B DB := (strictHenselizationData B).algebra
  let K := SeparableClosure (ResidueField A)
  let KB := SeparableClosure (ResidueField B)
  let : Field K := inferInstance
  let : Field KB := inferInstance
  let : Algebra (ResidueField A) K := inferInstance
  let : Algebra (ResidueField B) KB := inferInstance
  let : IsSepClosure (ResidueField A) K := inferInstance
  let : IsSepClosure (ResidueField B) KB := inferInstance
  let : IsHenselization A K DA := (strictHenselizationData A).isHenselization
  let : IsHenselization B KB DB := (strictHenselizationData B).isHenselization
  let eκ : ResidueField A ≃+* ResidueField B := ResidueField.mapEquiv e
  let : Algebra (ResidueField B) K :=
    ((algebraMap (ResidueField A) K).comp eκ.symm.toRingHom).toAlgebra
  have hSepK : IsSepClosure (ResidueField B) K := by
    have hcompat :
        (algebraMap (ResidueField B) K).comp eκ.toRingHom =
          (RingEquiv.refl K).toRingHom.comp (algebraMap (ResidueField A) K) := by
      ext x
      simp [RingHom.algebraMap_toAlgebra, RingHom.comp_apply]
    exact isSepClosure_of_equiv_equiv eκ (RingEquiv.refl K) hcompat
  let eK : KB ≃ₐ[ResidueField B] K := IsSepClosure.equiv (ResidueField B) KB K
  let : Algebra B DA := ((algebraMap A DA).comp e.symm.toRingHom).toAlgebra
  let : HenselianLocalRing DA := IsHenselization.henselian A K
  let : HenselianLocalRing DB := IsHenselization.henselian B KB
  have hbaseDA : IsHenselization B K DA := by
    obtain ⟨a, ha⟩ := IsHenselization.exists_residueFieldEquiv (R := A) (L := K) (Rh := DA)
    apply IsHenselization.of_ind_etale.{u, u} (IsHenselization.henselian A K)
      (ind_etale_of_base_equiv e.symm (fun b => rfl)
        (IsHenselization.ind_etale_of_universe_le (R := A) (L := K)))
    refine ⟨a, fun b => ?_⟩
    have hres : eκ.symm (residue B b) = residue A (e.symm b) := by
      simp [eκ, ResidueField.mapEquiv, ResidueField.map_residue]
    have hK : algebraMap (ResidueField B) K (residue B b) =
        algebraMap (ResidueField A) K (residue A (e.symm b)) := by
      show algebraMap (ResidueField A) K (eκ.symm (residue B b)) = _
      rw [hres]
    have hDA : algebraMap B DA b = algebraMap A DA (e.symm b) := by
      simp [RingHom.algebraMap_toAlgebra]
    rw [hK, hDA, ha]
  have hbaseDB : IsHenselization B K DB := by
    obtain ⟨a, ha⟩ := IsHenselization.exists_residueFieldEquiv (R := B) (L := KB) (Rh := DB)
    apply IsHenselization.of_ind_etale.{u, u} (IsHenselization.henselian B KB)
      (IsHenselization.ind_etale_of_universe_le (R := B) (L := KB))
    refine ⟨eK.toRingEquiv.symm.trans a, fun b => ?_⟩
    show a (eK.symm (algebraMap (ResidueField B) K (residue B b))) = _
    rw [← eK.commutes (residue B b), eK.symm_apply_apply]
    exact ha b
  let : IsHenselization B K DA := hbaseDA
  let : IsHenselization B K DB := hbaseDB
  let : Algebra B K :=
    ((algebraMap (ResidueField B) K).comp (residue B)).toAlgebra
  obtain ⟨aDA, haDA⟩ := IsHenselization.exists_residueFieldEquiv
    (R := B) (L := K) (Rh := DA)
  obtain ⟨aDB, haDB⟩ := IsHenselization.exists_residueFieldEquiv
    (R := B) (L := K) (Rh := DB)
  let pDA : DA →ₐ[B] K :=
    { toRingHom := aDA.symm.toRingHom.comp (residue DA)
      commutes' := fun b => by
        show aDA.symm (residue DA (algebraMap B DA b)) = algebraMap B K b
        rw [← haDA b, aDA.symm_apply_apply]
        rfl }
  let pDB : DB →ₐ[B] K :=
    { toRingHom := aDB.symm.toRingHom.comp (residue DB)
      commutes' := fun b => by
        show aDB.symm (residue DB (algebraMap B DB b)) = algebraMap B K b
        rw [← haDB b, aDB.symm_apply_apply]
        rfl }
  have hpDAsurj : Function.Surjective pDA := by
    intro z
    obtain ⟨y, hy⟩ := residue_surjective (aDA z)
    refine ⟨y, ?_⟩
    show aDA.symm (residue DA y) = z
    rw [hy, aDA.symm_apply_apply]
  have hpDBsurj : Function.Surjective pDB := by
    intro z
    obtain ⟨y, hy⟩ := residue_surjective (aDB z)
    refine ⟨y, ?_⟩
    show aDB.symm (residue DB y) = z
    rw [hy, aDB.symm_apply_apply]
  obtain ⟨eD, -⟩ := HenselianLocalRing.existsUnique_algEquiv_of_ind_etale
    (IsHenselization.ind_etale_of_universe_le (R := B) (L := K))
    (IsHenselization.ind_etale_of_universe_le (R := B) (L := K))
    pDA pDB hpDAsurj hpDBsurj
  exact Set.encard_congr (minimalPrimes_equiv_of_ringEquiv eD.toRingEquiv)

/-- The residue-field-valued `R`-algebra map of a local `R`-algebra whose residue field map is
bijective. -/
private noncomputable def residueAlgHomOfBijective
    {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)]
    (h : Function.Bijective (ResidueField.map (algebraMap R S))) :
    S →ₐ[R] ResidueField R where
  toRingHom := (RingEquiv.ofBijective _ h).symm.toRingHom.comp (residue S)
  commutes' x := by
    change (RingEquiv.ofBijective _ h).symm (residue S (algebraMap R S x)) = _
    apply (RingEquiv.ofBijective _ h).injective
    rw [RingEquiv.apply_symm_apply]
    change _ = ResidueField.map (algebraMap R S) (algebraMap R (ResidueField R) x)
    rw [show algebraMap R (ResidueField R) x = residue R x from rfl,
      ResidueField.map_residue]

private theorem residueAlgHomOfBijective_surjective
    {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)]
    (h : Function.Bijective (ResidueField.map (algebraMap R S))) :
    Function.Surjective (residueAlgHomOfBijective (R := R) (S := S) h) :=
  (RingEquiv.ofBijective _ h).symm.surjective.comp residue_surjective

private theorem encard_minimalPrimes_henselization_quotient
    (A : Type u) [CommRing A] [IsLocalRing A] (p : Ideal A) [p.IsPrime]
    (hp : p ∈ minimalPrimes A)
    [IsLocalRing (A ⧸ p)] :
    Set.encard (minimalPrimes
        ((henselizationData A).carrier ⧸
          p.map (algebraMap A (henselizationData A).carrier))) =
      numberOfBranchesOfLocalRing (A ⧸ p) := by
  classical
  let D := (henselizationData A).carrier
  let : CommRing D := (henselizationData A).commRing
  let : IsLocalRing D := (henselizationData A).isLocalRing
  let : Algebra A D := (henselizationData A).algebra
  let : IsHenselization A (ResidueField A) D := (henselizationData A).isHenselization
  let : IsLocalHom (algebraMap A D) := (henselizationData A).isLocalHom
  let : HenselianLocalRing D := IsLocalRing.IsHenselization.henselian A (ResidueField A)
  let hmax : (maximalIdeal A).map (algebraMap A D) = maximalIdeal D :=
    IsLocalRing.IsHenselization.map_maximalIdeal (L := ResidueField A)
  have hpMax : p ≤ maximalIdeal A := IsLocalRing.le_maximalIdeal hp.isPrime.ne_top
  obtain ⟨hLocA0, hLocD0, hLocHomD0, hHensD0, hIndD0, hMaxD0, hResD0⟩ :=
    @IsLocalRing.henselization_quotient A D inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance
      (IsLocalRing.IsHenselization.ind_etale_of_universe_le (ResidueField A)) hmax
      (henselizationData A).residueFieldMap_bijective p hpMax
  let A0 := A ⧸ p
  let D0 := D ⧸ p.map (algebraMap A D)
  let : IsLocalRing A0 := hLocA0
  let : IsLocalRing D0 := hLocD0
  let : CommRing D0 := inferInstance
  let : Algebra A0 D0 := inferInstance
  let : HenselianLocalRing D0 := hHensD0
  let : IsLocalHom (algebraMap A0 D0) := hLocHomD0
  let Qdata := henselizationData A0
  let Q := Qdata.carrier
  let : CommRing Q := Qdata.commRing
  let : IsLocalRing Q := Qdata.isLocalRing
  let : Algebra A0 Q := Qdata.algebra
  let : IsLocalHom (algebraMap A0 Q) := Qdata.isLocalHom
  let : IsHenselization A0 (ResidueField A0) Q := Qdata.isHenselization
  let : HenselianLocalRing Q := IsLocalRing.IsHenselization.henselian A0 (ResidueField A0)
  obtain ⟨eDQ, -⟩ := HenselianLocalRing.existsUnique_algEquiv_of_ind_etale
    hIndD0 (IsLocalRing.IsHenselization.ind_etale_of_universe_le (R := A0) (ResidueField A0))
    (residueAlgHomOfBijective hResD0)
    (residueAlgHomOfBijective Qdata.residueFieldMap_bijective)
    (residueAlgHomOfBijective_surjective hResD0)
    (residueAlgHomOfBijective_surjective Qdata.residueFieldMap_bijective)
  show Set.encard (minimalPrimes D0) = _
  rw [numberOfBranchesOfLocalRing_eq_encard_minimalPrimes]
  exact Set.encard_congr (minimalPrimes_equiv_of_ringEquiv eDQ.toRingEquiv)

private theorem encard_minimalPrimes_henselization_ringEquiv
    (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    (e : A ≃+* B) :
    Set.encard (minimalPrimes (henselizationData A).carrier) =
      Set.encard (minimalPrimes (henselizationData B).carrier) := by
  classical
  let DA := (henselizationData A).carrier
  let DB := (henselizationData B).carrier
  let : CommRing DA := (henselizationData A).commRing
  let : CommRing DB := (henselizationData B).commRing
  let : IsLocalRing DA := (henselizationData A).isLocalRing
  let : IsLocalRing DB := (henselizationData B).isLocalRing
  let : Algebra A DA := (henselizationData A).algebra
  let : Algebra B DB := (henselizationData B).algebra
  let : IsHenselization A (ResidueField A) DA := (henselizationData A).isHenselization
  let : IsHenselization B (ResidueField B) DB := (henselizationData B).isHenselization
  let : HenselianLocalRing DA := IsHenselization.henselian A (ResidueField A)
  let : HenselianLocalRing DB := IsHenselization.henselian B (ResidueField B)
  let : Algebra B DA := ((algebraMap A DA).comp e.symm.toRingHom).toAlgebra
  let eκ : ResidueField A ≃+* ResidueField B := ResidueField.mapEquiv e
  have hbaseDA : IsHenselization B (ResidueField B) DA := by
    obtain ⟨a, ha⟩ := IsHenselization.exists_residueFieldEquiv
      (R := A) (L := ResidueField A) (Rh := DA)
    apply IsHenselization.of_ind_etale.{u, u} (IsHenselization.henselian A (ResidueField A))
      (ind_etale_of_base_equiv e.symm (fun _ => rfl)
        (IsHenselization.ind_etale_of_universe_le (R := A) (ResidueField A)))
    refine ⟨eκ.symm.trans a, fun b => ?_⟩
    have hres : eκ.symm (residue B b) = residue A (e.symm b) := by
      simp [eκ, ResidueField.mapEquiv, ResidueField.map_residue]
    have hDA : algebraMap B DA b = algebraMap A DA (e.symm b) := by
      simp [RingHom.algebraMap_toAlgebra]
    show a (eκ.symm (algebraMap (ResidueField B) (ResidueField B) (residue B b))) = _
    rw [show algebraMap (ResidueField B) (ResidueField B) (residue B b) = residue B b from rfl,
      hres, hDA, ← ha (e.symm b)]
    rfl
  let : IsHenselization B (ResidueField B) DA := hbaseDA
  let : IsLocalHom (algebraMap B DA) := IsHenselization.isLocalHom (L := ResidueField B)
  have hbijDA : Function.Bijective (ResidueField.map (algebraMap B DA)) := by
    obtain ⟨a, ha⟩ := IsHenselization.exists_residueFieldEquiv
      (R := B) (L := ResidueField B) (Rh := DA)
    have hmap : (ResidueField.map (algebraMap B DA)) = a.toRingHom := by
      apply RingHom.ext
      intro x
      obtain ⟨b, rfl⟩ := residue_surjective x
      rw [ResidueField.map_residue]
      exact (ha b).symm
    rw [hmap]
    exact a.bijective
  obtain ⟨eD, -⟩ := HenselianLocalRing.existsUnique_algEquiv_of_ind_etale
    (IsHenselization.ind_etale_of_universe_le (R := B) (ResidueField B) (Rh := DA))
    (IsHenselization.ind_etale_of_universe_le (R := B) (ResidueField B) (Rh := DB))
    (residueAlgHomOfBijective hbijDA)
    (residueAlgHomOfBijective (henselizationData B).residueFieldMap_bijective)
    (residueAlgHomOfBijective_surjective hbijDA)
    (residueAlgHomOfBijective_surjective (henselizationData B).residueFieldMap_bijective)
  exact Set.encard_congr (minimalPrimes_equiv_of_ringEquiv eD.toRingEquiv)

end AlgebraicGeometry

/-- Geometric unibranchness of a local ring only depends on its isomorphism class. -/
public theorem isGeometricallyUnibranchRing_of_ringEquiv
    {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    (e : A ≃+* B) (h : IsGeometricallyUnibranchRing A) :
    IsGeometricallyUnibranchRing B := by
  rw [← numberOfGeometricBranchesOfLocalRing_eq_one_iff] at h ⊢
  rw [numberOfGeometricBranchesOfLocalRing_eq_encard_minimalPrimes,
    ← AlgebraicGeometry.encard_minimalPrimes_strictHenselization_ringEquiv A B e,
    ← numberOfGeometricBranchesOfLocalRing_eq_encard_minimalPrimes]
  exact h

namespace AlgebraicGeometry

private noncomputable def localizationQuotientAtPrimeEquiv
    {A : Type u} [CommRing A] (J p : Ideal A) [p.IsPrime] (hJp : J ≤ p) :
    (Localization.AtPrime p ⧸ J.map (algebraMap A (Localization.AtPrime p))) ≃+*
      Localization.AtPrime (quotientPrime J p hJp).asIdeal := by
  classical
  let q := quotientPrime J p hJp
  have hcp : Ideal.comap (Ideal.Quotient.mk J) q.asIdeal = p :=
    congrArg PrimeSpectrum.asIdeal
      (quotientPrime_comap J p hJp)
  let f := Localization.localRingHom p q.asIdeal (Ideal.Quotient.mk J)
    hcp.symm
  have hT : Submonoid.map (Ideal.Quotient.mk J) p.primeCompl = q.asIdeal.primeCompl := by
    apply Submonoid.ext
    intro y
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨a, ha, rfl⟩
      rw [Ideal.mem_primeCompl_iff] at ha ⊢
      intro hy
      apply ha
      have hac : a ∈ Ideal.comap (Ideal.Quotient.mk J) q.asIdeal :=
        Ideal.mem_comap.mpr hy
      exact hcp ▸ hac
    · intro hy
      have hy' : y ∉ q.asIdeal := Ideal.mem_primeCompl_iff.mp hy
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨a, ?_, rfl⟩
      rw [Ideal.mem_primeCompl_iff]
      intro ha
      apply hy'
      have hac : a ∈ Ideal.comap (Ideal.Quotient.mk J) q.asIdeal := hcp.symm ▸ ha
      exact Ideal.mem_comap.mp hac
  letI : IsLocalization (Submonoid.map (Ideal.Quotient.mk J) p.primeCompl)
      (Localization.AtPrime q.asIdeal) :=
    hT.symm ▸ (inferInstance : IsLocalization q.asIdeal.primeCompl
      (Localization.AtPrime q.asIdeal))
  have hsurj : Function.Surjective f := by
    convert (IsLocalization.map_surjective_of_surjective
        (M := p.primeCompl) (S := Localization.AtPrime p)
        (g := Ideal.Quotient.mk J) (Q := Localization.AtPrime q.asIdeal)
        Ideal.Quotient.mk_surjective) using 1
    rfl
  have hker : RingHom.ker f = J.map (algebraMap A (Localization.AtPrime p)) := by
    simpa [f, q, Localization.localRingHom, Ideal.mk_ker] using
      (IsLocalization.ker_map (Localization.AtPrime q.asIdeal)
        (Ideal.Quotient.mk J) hT)
  exact (Ideal.quotientEquivAlgOfEq (Localization.AtPrime p) hker).symm.toRingEquiv.trans
    (RingHom.quotientKerEquivOfSurjective hsurj)

private theorem vanishingComponentStalk_quotientEquiv
    {X : Scheme.{u}} (C : Closeds X) (hC : (C : Set X) ∈ irreducibleComponents X)
    (x : X) (hx : x ∈ (C : Set X)) (V : X.affineOpens)
    (hxV : x ∈ (V : X.Opens))
    (y : (Scheme.IdealSheafData.vanishingIdeal C).subscheme)
    (hy : (Scheme.IdealSheafData.vanishingIdeal C).subschemeι y = x) :
    ∃ q : minimalPrimes (X.presheaf.stalk x),
      ∃ _ : ((Scheme.IdealSheafData.vanishingIdeal C).subscheme.presheaf.stalk y) ≃+*
        (X.presheaf.stalk x ⧸ q.1),
        q.1 = ((Scheme.IdealSheafData.vanishingIdeal C).ideal V).map
          (X.presheaf.germ (V : X.Opens) x hxV).hom := by
  classical
  let I : X.IdealSheafData := Scheme.IdealSheafData.vanishingIdeal C
  let U : X.Opens := V
  have hxU : x ∈ U := hxV
  let : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  let A := Γ(X, U)
  let fromSpec := V.2.fromSpec
  let p : PrimeSpectrum A := V.2.primeIdealOf ⟨x, hxU⟩
  have hp : fromSpec p = x := V.2.fromSpec_primeIdealOf ⟨x, hxU⟩
  let Z : Set (PrimeSpectrum A) := fromSpec ⁻¹' (C : Set X)
  have hZ : Z ∈ irreducibleComponents (PrimeSpectrum A) := by
    apply preimage_mem_irreducibleComponents hC
      V.2.fromSpec.isOpenEmbedding
    exact ⟨x, hx, p, hp⟩
  let J : Ideal A := I.ideal V
  have hJ : J = PrimeSpectrum.vanishingIdeal Z := by
    dsimp [J, I, Z]
    exact Scheme.IdealSheafData.vanishingIdeal_ideal C ⟨U, V.2⟩
  have hJmin : J ∈ minimalPrimes A := by
    rw [hJ, PrimeSpectrum.vanishingIdeal_mem_minimalPrimes,
      (isClosed_of_mem_irreducibleComponents Z hZ).closure_eq]
    exact hZ
  have hpZ : p ∈ Z := by
    show fromSpec p ∈ (C : Set X)
    simpa [hp] using hx
  have hJp : J ≤ p.asIdeal := by
    rw [hJ]
    intro a ha
    exact (PrimeSpectrum.mem_vanishingIdeal Z a).mp ha p hpZ
  let : Algebra A (X.presheaf.stalk x) :=
    (X.presheaf.germ U x hxU).hom.toAlgebra
  let : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal :=
    V.2.isLocalization_stalk ⟨x, hxU⟩
  let eLoc : Localization.AtPrime p.asIdeal ≃+* X.presheaf.stalk x :=
    (IsLocalization.algEquiv p.asIdeal.primeCompl (Localization.AtPrime p.asIdeal)
      (X.presheaf.stalk x)).toRingEquiv
  let Jloc := J.map (algebraMap A (Localization.AtPrime p.asIdeal))
  have hJloc : Jloc ∈ minimalPrimes (Localization.AtPrime p.asIdeal) := by
    have hdisj : Disjoint (p.asIdeal.primeCompl : Set A) (J : Set A) :=
      Set.disjoint_left.mpr fun _ hp' hJ' => hp' (hJp hJ')
    have hunder : Ideal.under A Jloc = J :=
      IsLocalization.under_map_of_isPrime_disjoint p.asIdeal.primeCompl
        (Localization.AtPrime p.asIdeal) hJmin.isPrime hdisj
    have hJloc' : Jloc ∈
        (((⊥ : Ideal A).map (algebraMap A (Localization.AtPrime p.asIdeal))).minimalPrimes) := by
      rw [IsLocalization.minimalPrimes_map p.asIdeal.primeCompl
        (Localization.AtPrime p.asIdeal) (⊥ : Ideal A)]
      show Ideal.under A Jloc ∈ minimalPrimes A
      rw [hunder]
      exact hJmin
    simpa only [Ideal.map_bot] using hJloc'
  let eMin := minimalPrimes_equiv_of_ringEquiv eLoc
  let q : minimalPrimes (X.presheaf.stalk x) := eMin ⟨Jloc, hJloc⟩
  have hq : q.1 = Jloc.map eLoc.toRingHom := rfl
  let eQuot : (Localization.AtPrime p.asIdeal ⧸ Jloc) ≃+*
      (X.presheaf.stalk x ⧸ q.1) := Ideal.quotientEquiv Jloc q.1 eLoc hq
  let z := quotientPrime J p.asIdeal hJp
  let chart := I.subschemeCover.f V
  have hchart : chart ≫ I.subschemeι =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ fromSpec := by
    rw [I.subschemeCover_map_subschemeι, I.glueDataObjι_ι]
  have hz : I.subschemeι (chart z) = x := by
    have hz' : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))).base z = p :=
      quotientPrime_comap J p.asIdeal hJp
    show (chart ≫ I.subschemeι).base z = x
    rw [hchart]
    exact (congrArg fromSpec hz').trans hp
  have hychart : chart z = y := Subtype.ext (hz.trans hy.symm)
  subst y
  have hopen : IsOpenImmersion chart := by
    dsimp [chart]
    exact I.subschemeCover.map_prop V
  have : IsIso (chart.stalkMap z) :=
    (IsOpenImmersion.iff_isIso_stalkMap.mp hopen).2 z
  let eChart : (Localization.AtPrime z.asIdeal) ≃+*
    I.subscheme.presheaf.stalk (chart z) :=
    (Spec.stalkIso (CommRingCat.of (A ⧸ J)) z).commRingCatIsoToRingEquiv.symm.trans
      ((asIso (chart.stalkMap z)).commRingCatIsoToRingEquiv.symm)
  have hqAmbient : q.1 = J.map (algebraMap A (X.presheaf.stalk x)) := by
    calc
      q.1 = Jloc.map eLoc.toRingHom := hq
      _ = J.map (algebraMap A (X.presheaf.stalk x)) := by
        rw [Ideal.map_map]
        congr 1
        ext a
        simp [eLoc]
  have hgm : algebraMap A (X.presheaf.stalk x) =
      (X.presheaf.germ U x hxU).hom := by
    ext a
    rfl
  exact ⟨q, eChart.symm.trans
    ((localizationQuotientAtPrimeEquiv J p.asIdeal hJp).symm.trans eQuot),
      (by simpa [A, J, I, U, hgm] using hqAmbient)⟩

/-- The irreducible components of `X` through `x` correspond to the minimal primes of the stalk at
`x`, and the stalk of a reduced component at `x` is the quotient of that stalk by the matching
prime. -/
private theorem exists_components_equiv_minimalPrimes_stalk (X : Scheme.{u}) (x : X) :
    ∃ e : {Z : Set X // Z ∈ irreducibleComponents X ∧ x ∈ Z} ≃
        minimalPrimes (X.presheaf.stalk x),
      ∀ (C : Closeds X) (hC : (C : Set X) ∈ irreducibleComponents X) (hxC : x ∈ (C : Set X))
        (y : (Scheme.IdealSheafData.vanishingIdeal C).subscheme),
        (Scheme.IdealSheafData.vanishingIdeal C).subschemeι y = x →
        Nonempty ((Scheme.IdealSheafData.vanishingIdeal C).subscheme.presheaf.stalk y ≃+*
          X.presheaf.stalk x ⧸ (e ⟨C, hC, hxC⟩).1) := by
  classical
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (a := x) (by trivial) isOpen_univ
  let : IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
  let p : PrimeSpectrum Γ(X, V) := hV.primeIdealOf ⟨x, hxV⟩
  have hp : hV.fromSpec p = x := hV.fromSpec_primeIdealOf ⟨x, hxV⟩
  let ePoint : {Z : irreducibleComponents X // x ∈ (Z : Set X)} ≃
      {Z : irreducibleComponents X // hV.fromSpec p ∈ (Z : Set X)} :=
    { toFun := fun Z => ⟨Z.1, by simpa [hp] using Z.2⟩
      invFun := fun Z => ⟨Z.1, by simpa [hp] using Z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let eOpen := irreducibleComponentsThrough_equiv_of_isOpenEmbedding
    hV.fromSpec.isOpenEmbedding p
  let eAffine : {Z : Set (PrimeSpectrum Γ(X, V)) //
      Z ∈ irreducibleComponents (PrimeSpectrum Γ(X, V)) ∧ p ∈ Z} ≃
      minimalPrimes (Localization.AtPrime p.asIdeal) :=
    affineComponentsThroughEquiv p.asIdeal
  let : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    (X.presheaf.germ V x hxV).hom.toAlgebra
  let : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal :=
    hV.isLocalization_stalk ⟨x, hxV⟩
  let eStalk : Localization.AtPrime p.asIdeal ≃+* X.presheaf.stalk x :=
    (IsLocalization.algEquiv p.asIdeal.primeCompl (Localization.AtPrime p.asIdeal)
      (X.presheaf.stalk x)).toRingEquiv
  let eCompSpec : {Z : irreducibleComponents (PrimeSpectrum Γ(X, V)) //
      p ∈ (Z : Set (PrimeSpectrum Γ(X, V)))} ≃
      {Z : Set (PrimeSpectrum Γ(X, V)) //
        Z ∈ irreducibleComponents (PrimeSpectrum Γ(X, V)) ∧ p ∈ Z} :=
    (componentThrough_equiv_subtype p).symm
  let e : {Z : Set X // Z ∈ irreducibleComponents X ∧ x ∈ Z} ≃
      minimalPrimes (X.presheaf.stalk x) :=
    (componentThrough_equiv_subtype x).trans
      (ePoint.trans (eOpen.trans (eCompSpec.trans
        (eAffine.trans (minimalPrimes_equiv_of_ringEquiv eStalk)))))
  refine ⟨e, fun C hC hxC y hy => ?_⟩
  obtain ⟨q, eC, hqAmbient⟩ :=
    vanishingComponentStalk_quotientEquiv C hC x hxC ⟨V, hV⟩ hxV y hy
  let A := Γ(X, V)
  let Vaff : X.affineOpens := ⟨V, hV⟩
  let W : Set (PrimeSpectrum A) := hV.fromSpec ⁻¹' (C : Set X)
  have hJ : (Scheme.IdealSheafData.vanishingIdeal C).ideal Vaff =
      PrimeSpectrum.vanishingIdeal W := by
    dsimp [W, A, Vaff]
    exact Scheme.IdealSheafData.vanishingIdeal_ideal C ⟨V, hV⟩
  have hmap : eStalk.toRingHom.comp (algebraMap A (Localization.AtPrime p.asIdeal)) =
      (X.presheaf.germ V x hxV).hom := by
    ext a
    exact (IsLocalization.algEquiv p.asIdeal.primeCompl
      (Localization.AtPrime p.asIdeal) (X.presheaf.stalk x)).commutes a
  have hq : q = e ⟨C, hC, hxC⟩ := by
    refine Subtype.ext (hqAmbient.trans ?_)
    change _ = ((PrimeSpectrum.vanishingIdeal W).map
      (algebraMap A (Localization.AtPrime p.asIdeal))).map eStalk.toRingHom
    rw [Ideal.map_map, hmap, hJ]
  subst hq
  exact ⟨eC⟩


/-- The geometric branches at a point are the geometric branches of its reduced irreducible
components through that point, counted with multiplicity one per component. -/
@[stacks 0E20 "geometric_branches_sum"]
public theorem numberOfGeometricBranches_eq_iSup_sum_components
    (X : Scheme.{u}) (x : X) :
    numberOfGeometricBranches X x =
      ⨆ s : Finset {Z : Set X // Z ∈ irreducibleComponents X ∧ x ∈ Z},
        ∑ Z ∈ s,
        let C : Closeds X :=
          ⟨Z.1, isClosed_of_mem_irreducibleComponents Z.1 Z.property.1⟩
        let I := Scheme.IdealSheafData.vanishingIdeal C
        numberOfGeometricBranches I.subscheme
          (⟨x, by
            change x ∈ ((Scheme.IdealSheafData.vanishingIdeal C).support : Set X)
            have h := Scheme.IdealSheafData.coe_support_vanishingIdeal C
            exact h.symm ▸ (show x ∈ (C : Set X) from Z.property.2)⟩ : I.subscheme) := by
  classical
  obtain ⟨e, he⟩ := exists_components_equiv_minimalPrimes_stalk X x
  change Set.encard (minimalPrimes (strictHenselizationData (X.presheaf.stalk x)).carrier) = _
  let A : Type u := X.presheaf.stalk x
  let Ddata := strictHenselizationData A
  let D : Type u := Ddata.carrier
  let : CommRing D := Ddata.commRing
  let : IsLocalRing D := Ddata.isLocalRing
  let : Algebra A D := Ddata.algebra
  let : IsHenselization A (SeparableClosure (ResidueField A)) D := Ddata.isHenselization
  let : Module.FaithfullyFlat A D :=
    IsLocalRing.IsHenselization.faithfullyFlat (R := A) (L := SeparableClosure (ResidueField A))
      (Rh := D)
  rw [encard_minimalPrimes_eq_iSup_sum_quotients (R := A) (S := D)]
  apply (Equiv.iSup_congr (Equiv.finsetCongr e) ?_).symm
  intro s
  rw [Equiv.finsetCongr_apply, Finset.sum_map]
  refine Finset.sum_congr rfl fun Z _ => ?_
  let C : Closeds X := ⟨Z.1, isClosed_of_mem_irreducibleComponents Z.1 Z.property.1⟩
  let y : (Scheme.IdealSheafData.vanishingIdeal C).subscheme := ⟨x, by
    change x ∈ ((Scheme.IdealSheafData.vanishingIdeal C).support : Set X)
    have h := Scheme.IdealSheafData.coe_support_vanishingIdeal C
    exact h.symm ▸ (show x ∈ (C : Set X) from Z.property.2)⟩
  obtain ⟨eC⟩ := he C Z.property.1 Z.property.2 y rfl
  have : (e Z).1.IsPrime := (e Z).2.isPrime
  have : IsLocalRing (A ⧸ (e Z).1) := isLocalRing_quotient_of_proper_ideal this.ne_top
  change Set.encard (minimalPrimes (D ⧸ (e Z).1.map (algebraMap A D))) =
    numberOfGeometricBranches (Scheme.IdealSheafData.vanishingIdeal C).subscheme y
  rw [encard_minimalPrimes_strictHenselization_quotient A (e Z).1 (e Z).2,
    numberOfGeometricBranches_eq_numberOfGeometricBranchesOfLocalRing,
    numberOfGeometricBranchesOfLocalRing_eq_encard_minimalPrimes,
    numberOfGeometricBranchesOfLocalRing_eq_encard_minimalPrimes]
  exact (encard_minimalPrimes_strictHenselization_ringEquiv _ _ eC).symm


/-- The branches at a point are the branches of its reduced irreducible components through that
point, counted with multiplicity one per component. -/
@[stacks 0E20 "branches_sum"]
public theorem numberOfBranches_eq_iSup_sum_components
    (X : Scheme.{u}) (x : X) :
    numberOfBranches X x =
      ⨆ s : Finset {Z : Set X // Z ∈ irreducibleComponents X ∧ x ∈ Z},
        ∑ Z ∈ s,
        let C : Closeds X :=
          ⟨Z.1, isClosed_of_mem_irreducibleComponents Z.1 Z.property.1⟩
        let I := Scheme.IdealSheafData.vanishingIdeal C
        numberOfBranches I.subscheme
          (⟨x, by
            change x ∈ ((Scheme.IdealSheafData.vanishingIdeal C).support : Set X)
            have h := Scheme.IdealSheafData.coe_support_vanishingIdeal C
            exact h.symm ▸ (show x ∈ (C : Set X) from Z.property.2)⟩ : I.subscheme) := by
  classical
  obtain ⟨e, he⟩ := exists_components_equiv_minimalPrimes_stalk X x
  change Set.encard (minimalPrimes (henselizationData (X.presheaf.stalk x)).carrier) = _
  let A : Type u := X.presheaf.stalk x
  let Ddata := henselizationData A
  let D : Type u := Ddata.carrier
  let : CommRing D := Ddata.commRing
  let : IsLocalRing D := Ddata.isLocalRing
  let : Algebra A D := Ddata.algebra
  let : IsHenselization A (ResidueField A) D := Ddata.isHenselization
  let : Module.FaithfullyFlat A D :=
    IsLocalRing.IsHenselization.faithfullyFlat (R := A) (L := ResidueField A)
      (Rh := D)
  rw [encard_minimalPrimes_eq_iSup_sum_quotients (R := A) (S := D)]
  apply (Equiv.iSup_congr (Equiv.finsetCongr e) ?_).symm
  intro s
  rw [Equiv.finsetCongr_apply, Finset.sum_map]
  refine Finset.sum_congr rfl fun Z _ => ?_
  let C : Closeds X := ⟨Z.1, isClosed_of_mem_irreducibleComponents Z.1 Z.property.1⟩
  let y : (Scheme.IdealSheafData.vanishingIdeal C).subscheme := ⟨x, by
    change x ∈ ((Scheme.IdealSheafData.vanishingIdeal C).support : Set X)
    have h := Scheme.IdealSheafData.coe_support_vanishingIdeal C
    exact h.symm ▸ (show x ∈ (C : Set X) from Z.property.2)⟩
  obtain ⟨eC⟩ := he C Z.property.1 Z.property.2 y rfl
  have : (e Z).1.IsPrime := (e Z).2.isPrime
  have : IsLocalRing (A ⧸ (e Z).1) := isLocalRing_quotient_of_proper_ideal this.ne_top
  change Set.encard (minimalPrimes (D ⧸ (e Z).1.map (algebraMap A D))) =
    numberOfBranches (Scheme.IdealSheafData.vanishingIdeal C).subscheme y
  rw [encard_minimalPrimes_henselization_quotient A (e Z).1 (e Z).2,
    numberOfBranches_eq_numberOfBranchesOfLocalRing,
    numberOfBranchesOfLocalRing_eq_encard_minimalPrimes,
    numberOfBranchesOfLocalRing_eq_encard_minimalPrimes]
  exact (encard_minimalPrimes_henselization_ringEquiv _ _ eC).symm


end AlgebraicGeometry
