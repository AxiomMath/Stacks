module

public import StacksFrontier.AlgebraicGeometry.EmptyLimitCounterexample.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.AlgebraicGeometry.Morphisms.Integral
public import Mathlib.RingTheory.Algebraic.Cardinality

/-!
# Finite transition morphisms are incompatible with the universe collapse

The system of affine schemes in `StacksFrontier.AlgebraicGeometry.EmptyLimitCounterexample.Basic` is
a cofiltered inverse system, indexed one universe above the schemes, which satisfies every
hypothesis of Situation 081D and has an **empty** limit while no stage is empty.  It refutes the
universe-free form of Tag 06AC.

Tag 09ZN asks for more of its system than Situation 081D does: its transition morphisms must be
**finite**, not merely affine.  This file shows that the extra hypothesis is exactly what the
collapse cannot survive, so that construction cannot refute 09ZN.

## The obstruction

The stages of the system are the spectra of the subrings `ℤ[T] ⊆ F` generated by the finite
subsets `T` of a field `F` which is not `u`-small.  If every transition morphism were integral —
in particular if every one were finite — then for each `x : F` the transition from the stage `∅`
to the stage `{x}` would make `x` integral over the prime subring `ℤ · 1 = Subring.closure ∅`.
So `F` would be an algebraic extension of a countable ring, hence countable, hence `u`-small,
contradicting the one property of `F` the construction needs.

This is the specialization to the construction of a general fact about such systems, which is
**not** proved here: a directed system of nonempty schemes with integral affine transition
morphisms never has an empty limit, because the filtered colimit `B` of the stage rings is
nonzero and integral over any one stage ring, so `B` has a maximal ideal whose residue field is
algebraic over a `u`-small field and therefore `u`-small, and the resulting
`Spec` of that residue field is a cone with a nonempty vertex.

## Main results

* `Stacks.FiniteTransitionObstruction.small_of_isIntegral_subring`: a field all of whose
  elements are integral over a countable subring is `u`-small, in any universe.
* `Stacks.FiniteTransitionObstruction.small_of_isIntegral_stageMap`: if every transition
  homomorphism of stage rings of the 06AC system is integral, the field is `u`-small.
* `Stacks.FiniteTransitionObstruction.not_isIntegralHom_schemeDiagram`: some transition morphism
  of the 06AC system is **not** integral.
* `Stacks.FiniteTransitionObstruction.not_isFinite_schemeDiagram`: some transition morphism of
  the 06AC system is **not** finite.  This is the hypothesis `hfinite` of the statement of Tag 09ZN,
  with its binders made explicit, and it **fails** for this system — so the 06AC counterexample
  is not a counterexample to 09ZN.

## What this does and does not settle

It settles that the library's 06AC refutation cannot be reused for 09ZN: its transition morphisms
are not finite, and they cannot be made finite by changing the field, since for *any* field indexed
this way integral transitions force `u`-smallness.  It settles **nothing** about the truth of 09ZN
at a free index universe, which remains open — neither a proof nor a counterexample is given here.
The general fact quoted above, if formalized, would say that no system with integral transition
morphisms and nonempty stages has an empty limit at all, whatever its index.

## References

* [The Stacks Project, Tag 09ZN](https://stacks.math.columbia.edu/tag/09ZN)
* [The Stacks Project, Tag 06AC](https://stacks.math.columbia.edu/tag/06AC)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe w u

namespace Stacks.FiniteTransitionObstruction

open Stacks.EmptyLimitCounterexample

/-- The prime subring of a ring is countable: it is the image of `ℤ`. -/
theorem countable_closure_empty {F : Type w} [Ring F] :
    Countable (Subring.closure (∅ : Set F)) := by
  rw [Subring.closure_empty]
  refine Function.Surjective.countable (f := fun n : ℤ => (⟨(n : F), ?_⟩ : (⊥ : Subring F))) ?_
  · exact Subring.mem_bot.mpr ⟨n, rfl⟩
  · intro y
    obtain ⟨n, hn⟩ := Subring.mem_bot.mp y.2
    exact ⟨n, Subtype.ext hn⟩

/-- **A field integral over a countable subring is small.**  If every element of a field `F` is
integral over a countable subring, then `F` is `u`-small, whatever universe `F` lives in. -/
theorem small_of_isIntegral_subring {F : Type w} [Field F] (A : Subring F) [Countable A]
    (h : ∀ x : F, IsIntegral A x) : Small.{u} F := by
  have halg : Algebra.IsAlgebraic A F := ⟨fun x => (h x).isAlgebraic⟩
  have hc : Cardinal.mk A ≤ Cardinal.aleph0 := Cardinal.mk_le_aleph0_iff.mpr ‹Countable A›
  have hF : Cardinal.mk F ≤ Cardinal.aleph0 :=
    (Algebra.IsAlgebraic.cardinalMk_le_max A F).trans (max_le hc le_rfl)
  have : Countable F := Cardinal.mk_le_aleph0_iff.mp hF
  infer_instance

variable (F : Type (u + 1)) [Field F]

/-- The subring of `F` generated by the empty set, the prime subring, is countable. -/
theorem countable_closure_coe_empty :
    Countable (Subring.closure ((∅ : Finset F) : Set F)) := by
  rw [Finset.coe_empty]
  exact countable_closure_empty

/-- The ring homomorphism from a stage ring to the field, through the chosen identification of
the stage with the subring it copies. -/
def stageToField (T : Finset F) : stage F T →+* F :=
  (Subring.subtype _).comp (stageEquiv F T).toRingHom

/-- `stageToField F T z` is the element of `F` underlying `stageEquiv F T z`. -/
@[simp] theorem stageToField_apply (T : Finset F) (z : stage F T) :
    stageToField F T z = (stageEquiv F T z : F) := rfl

/-- The maps `stageToField` to `F` are compatible with the transition homomorphisms `stageMap`. -/
theorem stageToField_comp_stageMap {T T' : Finset F} (h : T ≤ T') :
    (stageToField F T').comp (stageMap F h) = stageToField F T := by
  ext z
  simp

/-- If the transition homomorphism from the stage `∅` to the stage `{x}` is integral, then `x` is
integral over the base stage's subring — the prime subring of `F`. -/
theorem isIntegral_of_isIntegral_stageMap
    (h : ∀ (T T' : Finset F) (hT : T ≤ T'), RingHom.IsIntegral (stageMap F hT)) (x : F) :
    IsIntegral (Subring.closure ((∅ : Finset F) : Set F)) x := by
  obtain ⟨p, hp, hpx⟩ :=
    h ∅ {x} (by simp)
      ((stageEquiv F {x}).symm ⟨x, Subring.subset_closure (by simp)⟩)
  have hval : Polynomial.eval₂ (stageToField F ∅) x p = 0 := by
    have hcongr := congrArg (stageToField F {x}) hpx
    rw [Polynomial.hom_eval₂, map_zero, stageToField_comp_stageMap] at hcongr
    simpa using hcongr
  refine ⟨p.map (stageEquiv F (∅ : Finset F)).toRingHom, hp.map _, ?_⟩
  rw [Polynomial.eval₂_map]
  exact hval

/-- If every transition homomorphism `stageMap F hT` of stage rings is integral, then the field
`F` is `u`-small. -/
theorem small_of_isIntegral_stageMap
    (h : ∀ (T T' : Finset F) (hT : T ≤ T'), RingHom.IsIntegral (stageMap F hT)) :
    Small.{u} F :=
  have := countable_closure_coe_empty F
  small_of_isIntegral_subring _ (isIntegral_of_isIntegral_stageMap F h)

/-- Some transition homomorphism `stageMap bigField hT` of stage rings is not integral. -/
theorem not_isIntegral_stageMap :
    ¬ ∀ (T T' : Finset bigField.{u}) (hT : T ≤ T'),
        RingHom.IsIntegral (stageMap bigField.{u} hT) :=
  fun h => not_small_bigField.{u} (small_of_isIntegral_stageMap bigField.{u} h)

/-- Some transition morphism of the diagram `schemeDiagram bigField` is not integral. -/
theorem not_isIntegralHom_schemeDiagram :
    ¬ ∀ (i j : Finset bigField.{u}) (h : i ≤ j),
        IsIntegralHom ((schemeDiagram bigField.{u}).map (homOfLE h).op) := by
  intro hall
  refine not_isIntegral_stageMap.{u} fun T T' hT => ?_
  exact AlgebraicGeometry.IsIntegralHom.SpecMap_iff.mp (hall T T' hT)

/-- Some transition morphism of the diagram `schemeDiagram bigField` is not finite. -/
theorem not_isFinite_schemeDiagram :
    ¬ ∀ (i j : Finset bigField.{u}) (h : i ≤ j),
        IsFinite ((schemeDiagram bigField.{u}).map (homOfLE h).op) := by
  intro hall
  refine not_isIntegralHom_schemeDiagram.{u} fun i j h => ?_
  have := hall i j h
  infer_instance

end Stacks.FiniteTransitionObstruction

end
