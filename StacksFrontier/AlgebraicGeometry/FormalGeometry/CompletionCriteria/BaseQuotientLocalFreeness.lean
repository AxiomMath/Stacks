module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionCriteria.FirstTermStalkFreeness
public import Mathlib.Algebra.Module.Torsion.Basic

/-!
# The localization of the first term of the system at a prime of `A ⧸ (f)` is free

Fix an algebraization situation: a Noetherian ring `A` with ideals `I ⊆ 𝔞`, the affine scheme
`X = Spec(A)` and the open complement `U = X ∖ V(𝔞)`, and let `(F_n)` be a coherent `I`-adic
system on `U`. Stacks 0DXW assumes

1. `I = (f)` for a nonzerodivisor `f ∈ 𝔞`,
2. `F_n` is a finite locally free `𝒪_U/f^n𝒪_U`-module,
3. `H¹_𝔞(A/fA)` and `H²_𝔞(A/fA)` are finite `A`-modules.

Conditions (1) and (2) make the stalk of `F_1`, modulo the ideal, free over the local ring modulo
the ideal; that is
`Stacks.Algebraization.free_localizedModule_of_isFiniteLocallyFreeAdic`, which states it for an
`A`-module `M` realizing `F_1` as `M̃|_U` in the spelling `M_𝔭/f M_𝔭` free over `A_𝔭/f A_𝔭`.
The finiteness half of the source's proof consumes that freeness through
`Stacks.BaseQuotientFactorization.exists_pow_smul_factor_through_baseQuotient'`, which asks for
it in the spelling `M_𝔮` free over `B_𝔮`, where `B = A ⧸ (f)` and `𝔮 = 𝔭B`. This file translates
between the two spellings.

## Main results

* `Stacks.Algebraization.quotientLocalizationAtPrimeRingEquiv` — for `f ∈ 𝔭` the ring
  `A_𝔭/f A_𝔭` is the localization `B_𝔮` of `B = A ⧸ (f)`, characterised on the image of `A` by
  `Stacks.Algebraization.quotientLocalizationAtPrimeRingEquiv_mk`.
* `Stacks.Algebraization.exists_quotientLocalizedModuleAddEquiv` — for `M` annihilated by `f`
  the localizations `M_𝔭` and `M_𝔮` agree, the two multiplicative sets corresponding under
  `A → B`.
* `Stacks.Algebraization.exists_point_underlyingPrime` — every prime of `A` not containing `𝔞`
  is the prime under a point of `U`.
* `Stacks.Algebraization.free_localizedModule_baseQuotient` — **the conclusion**: `M_𝔮` is a free
  `B_𝔮`-module, for `M` a module annihilated by `f` realizing `F_1` on `U`, and for `𝔮` the
  prime of `B` under a prime `𝔭` of `A` which contains `f` and does not contain `𝔞`.

## Implementation notes

The semilinearity of the comparison of modules is checked only on the scalars coming from `A`,
and `Stacks.Algebraization.addEquiv_smul_of_isLocalization` promotes that to semilinearity over
the whole localization: a scalar of `B_𝔮` becomes one of `A` after multiplication by a unit.

## References

* [Stacks Project, Tag 0DXW](https://stacks.math.columbia.edu/tag/0DXW)
* [Stacks Project, Tag 0EHC](https://stacks.math.columbia.edu/tag/0EHC)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.ModuleSkyscraper
open scoped AlgebraicGeometry

universe u

namespace Stacks.Algebraization

section Ring

variable {A : Type u} [CommRing A]

/-- For `f ∈ p` the image of `p.primeCompl` in `A ⧸ (f)` is the prime complement of the image
of `p`. -/
theorem primeCompl_map_quotient_mk (f : A) (p : Ideal A) [p.IsPrime] (hf : f ∈ p)
    (q : Ideal (A ⧸ Ideal.span {f})) [q.IsPrime]
    (hq : q = p.map (Ideal.Quotient.mk (Ideal.span {f}))) :
    Algebra.algebraMapSubmonoid (A ⧸ Ideal.span {f}) p.primeCompl = q.primeCompl := by
  have hmem : ∀ a : A, Ideal.Quotient.mk (Ideal.span {f}) a ∈ q ↔ a ∈ p := by
    intro a
    rw [hq]
    exact Ideal.mem_quotient_iff_mem ((Ideal.span_singleton_le_iff_mem p).2 hf)
  ext x
  simp only [Algebra.algebraMapSubmonoid, Submonoid.mem_map, Ideal.Quotient.algebraMap_eq]
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact fun hx => ha ((hmem a).1 hx)
  · intro hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨a, fun hap => hx ((hmem a).2 hap), rfl⟩

/-- The ideal generated by the image of `f` in a localization is the image of `(f)`. -/
theorem map_span_singleton_algebraMap (f : A) (p : Ideal A) [p.IsPrime] :
    (Ideal.span {f}).map (algebraMap A (Localization.AtPrime p)) =
      Ideal.span {algebraMap A (Localization.AtPrime p) f} := by
  rw [Ideal.map_span, Set.image_singleton]

/-- The quotient of `A_p` by `f` is a localization of `A ⧸ (f)` at the image of `p`. -/
theorem isLocalization_quotient_map_algebraMap (f : A) (p : Ideal A) [p.IsPrime] (hf : f ∈ p)
    (q : Ideal (A ⧸ Ideal.span {f})) [q.IsPrime]
    (hq : q = p.map (Ideal.Quotient.mk (Ideal.span {f}))) :
    IsLocalization q.primeCompl
      (Localization.AtPrime p ⧸ (Ideal.span {f}).map (algebraMap A (Localization.AtPrime p))) :=
  primeCompl_map_quotient_mk f p hf q hq ▸ inferInstance

/-- **The quotient of a localization at a prime containing `f` is the localization of the
quotient by `f` at the image of that prime.** -/
def quotientLocalizationAtPrimeRingEquiv (f : A) (p : Ideal A) [p.IsPrime] (hf : f ∈ p)
    (q : Ideal (A ⧸ Ideal.span {f})) [q.IsPrime]
    (hq : q = p.map (Ideal.Quotient.mk (Ideal.span {f}))) :
    (Localization.AtPrime p ⧸
        Ideal.span {algebraMap A (Localization.AtPrime p) f}) ≃+* Localization.AtPrime q :=
  letI := isLocalization_quotient_map_algebraMap f p hf q hq
  (Ideal.quotEquivOfEq (map_span_singleton_algebraMap f p)).symm.trans
    (IsLocalization.algEquiv q.primeCompl
      (Localization.AtPrime p ⧸ (Ideal.span {f}).map (algebraMap A (Localization.AtPrime p)))
      (Localization.AtPrime q)).toRingEquiv

/-- `quotientLocalizationAtPrimeRingEquiv` is the identity on the image of `A`. -/
theorem quotientLocalizationAtPrimeRingEquiv_mk (f : A) (p : Ideal A) [p.IsPrime] (hf : f ∈ p)
    (q : Ideal (A ⧸ Ideal.span {f})) [q.IsPrime]
    (hq : q = p.map (Ideal.Quotient.mk (Ideal.span {f}))) (a : A) :
    quotientLocalizationAtPrimeRingEquiv f p hf q hq
        (Ideal.Quotient.mk (Ideal.span {algebraMap A (Localization.AtPrime p) f})
          (algebraMap A (Localization.AtPrime p) a)) =
      algebraMap (A ⧸ Ideal.span {f}) (Localization.AtPrime q)
        (Ideal.Quotient.mk (Ideal.span {f}) a) := by
  let := isLocalization_quotient_map_algebraMap f p hf q hq
  have h1 : (Ideal.quotEquivOfEq (map_span_singleton_algebraMap f p)).symm
        (Ideal.Quotient.mk (Ideal.span {algebraMap A (Localization.AtPrime p) f})
          (algebraMap A (Localization.AtPrime p) a)) =
      algebraMap (A ⧸ Ideal.span {f})
        (Localization.AtPrime p ⧸ (Ideal.span {f}).map (algebraMap A (Localization.AtPrime p)))
        (Ideal.Quotient.mk (Ideal.span {f}) a) :=
    (Ideal.Quotient.algebraMap_quotient_map_quotient a).symm
  exact (congrArg (fun z => (IsLocalization.algEquiv q.primeCompl
      (Localization.AtPrime p ⧸ (Ideal.span {f}).map (algebraMap A (Localization.AtPrime p)))
      (Localization.AtPrime q)) z) h1).trans
    ((IsLocalization.algEquiv q.primeCompl
      (Localization.AtPrime p ⧸ (Ideal.span {f}).map (algebraMap A (Localization.AtPrime p)))
      (Localization.AtPrime q)).commutes _)

/-- **Semilinearity over a localization from semilinearity over the base.** If an additive
isomorphism between a module over a localization `R₁` of `R` and a module over a ring `R₂`
identified with `R₁` is semilinear for the scalars coming from `R`, then it is semilinear. -/
theorem addEquiv_smul_of_isLocalization {R : Type*} [CommRing R] (T : Submonoid R)
    {R₁ R₂ : Type*} [CommRing R₁] [CommRing R₂] [Algebra R R₁] [IsLocalization T R₁]
    (ψ : R₁ ≃+* R₂) {M₁ M₂ : Type*} [AddCommGroup M₁] [Module R₁ M₁]
    [AddCommGroup M₂] [Module R₂ M₂] (φ : M₁ ≃+ M₂)
    (h : ∀ (a : R) (x : M₁), φ (algebraMap R R₁ a • x) = ψ (algebraMap R R₁ a) • φ x)
    (r : R₁) (x : M₁) : φ (r • x) = ψ r • φ x := by
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq T r
  have key : algebraMap R R₁ (s : R) * IsLocalization.mk' R₁ a s = algebraMap R R₁ a := by
    rw [mul_comm, IsLocalization.mk'_spec]
  refine (((IsLocalization.map_units R₁ s).map ψ).smul_left_cancel).1 ?_
  calc ψ (algebraMap R R₁ (s : R)) • φ (IsLocalization.mk' R₁ a s • x)
      = φ (algebraMap R R₁ (s : R) • (IsLocalization.mk' R₁ a s • x)) := (h _ _).symm
    _ = φ (algebraMap R R₁ a • x) := by rw [smul_smul, key]
    _ = ψ (algebraMap R R₁ a) • φ x := h a x
    _ = ψ (algebraMap R R₁ (s : R) * IsLocalization.mk' R₁ a s) • φ x := by rw [key]
    _ = ψ (algebraMap R R₁ (s : R)) • (ψ (IsLocalization.mk' R₁ a s) • φ x) := by
        rw [map_mul, smul_smul]

/-- A localization of a module annihilated by `f` is annihilated by `f`. -/
theorem localizedModule_smul_eq_zero {A : Type u} [CommRing A] {Mm : Type u} [AddCommGroup Mm]
    [Module A Mm] (T : Submonoid A) {f : A} (hfM : ∀ x : Mm, f • x = 0)
    (w : LocalizedModule T Mm) : f • w = 0 := by
  induction w using LocalizedModule.induction_on with
  | _ m s => rw [LocalizedModule.smul'_mk, hfM m, LocalizedModule.zero_mk]

section Torsion

variable {A : Type u} [CommRing A] {f : A}

/-- The scalar tower for the `A ⧸ (f)`-action on a module annihilated by `f`. -/
theorem isScalarTower_isTorsionBy {Z : Type*} [AddCommGroup Z] [Module A Z]
    (hZ : ∀ x : Z, f • x = 0) :
    letI : Module (A ⧸ Ideal.span {f}) Z :=
      Module.IsTorsionBy.module (R := A) (M := Z) (r := f) (fun ⦃x⦄ => hZ x)
    IsScalarTower A (A ⧸ Ideal.span {f}) Z :=
  let : Module (A ⧸ Ideal.span {f}) Z :=
    Module.IsTorsionBy.module (R := A) (M := Z) (r := f) (fun ⦃x⦄ => hZ x)
  IsScalarTower.of_algebraMap_smul fun a x => by
    rw [Ideal.Quotient.algebraMap_eq]
    exact Module.IsTorsionBy.mk_smul (R := A) (M := Z) (fun ⦃x⦄ => hZ x) a x

/-- **A localization of `M` at `p` is a localization of `M` at the image of `p` in `A ⧸ (f)`**,
for `M` annihilated by `f`: the two localizations are additively isomorphic by a map carrying
the action of `a : A` to itself.  The multiplicative sets agree by
`Stacks.Algebraization.primeCompl_map_quotient_mk`. -/
theorem exists_quotientLocalizedModuleAddEquiv {Mm : Type u} [AddCommGroup Mm] [Module A Mm]
    [Module (A ⧸ Ideal.span {f}) Mm] [IsScalarTower A (A ⧸ Ideal.span {f}) Mm]
    (hfM : ∀ x : Mm, f • x = 0) (p : Ideal A) [p.IsPrime] (hf : f ∈ p)
    (q : Ideal (A ⧸ Ideal.span {f})) [q.IsPrime]
    (hq : q = p.map (Ideal.Quotient.mk (Ideal.span {f}))) :
    ∃ g : LocalizedModule q.primeCompl Mm ≃+ LocalizedModule p.primeCompl Mm,
      ∀ (a : A) (x : LocalizedModule q.primeCompl Mm),
        g (Ideal.Quotient.mk (Ideal.span {f}) a • x) = a • g x := by
  have hfW : ∀ w : LocalizedModule p.primeCompl Mm, f • w = 0 :=
    localizedModule_smul_eq_zero p.primeCompl hfM
  let : Module (A ⧸ Ideal.span {f}) (LocalizedModule p.primeCompl Mm) :=
    Module.IsTorsionBy.module (R := A) (M := LocalizedModule p.primeCompl Mm) (r := f)
      (fun ⦃x⦄ => hfW x)
  let : IsScalarTower A (A ⧸ Ideal.span {f}) (LocalizedModule p.primeCompl Mm) :=
    isScalarTower_isTorsionBy hfW
  have hmk : ∀ (a : A) (w : LocalizedModule p.primeCompl Mm),
      Ideal.Quotient.mk (Ideal.span {f}) a • w = a • w := fun a w =>
    Module.IsTorsionBy.mk_smul (R := A) (M := LocalizedModule p.primeCompl Mm)
      (fun ⦃x⦄ => hfW x) a w
  let h : Mm →ₗ[A ⧸ Ideal.span {f}] LocalizedModule p.primeCompl Mm :=
    (LocalizedModule.mkLinearMap p.primeCompl Mm).extendScalarsOfSurjective
      Ideal.Quotient.mk_surjective
  have : IsLocalizedModule p.primeCompl (h.restrictScalars A) := by
    change IsLocalizedModule p.primeCompl (LocalizedModule.mkLinearMap p.primeCompl Mm)
    infer_instance
  have : IsLocalizedModule q.primeCompl h :=
    primeCompl_map_quotient_mk f p hf q hq ▸
      IsLocalizedModule.of_restrictScalars (A := A ⧸ Ideal.span {f}) p.primeCompl h
  let e := IsLocalizedModule.linearEquiv q.primeCompl
    (LocalizedModule.mkLinearMap q.primeCompl Mm) h
  refine ⟨e.toAddEquiv, fun a x => ?_⟩
  exact (e.map_smul (Ideal.Quotient.mk (Ideal.span {f}) a) x).trans (hmk a (e x))

end Torsion

end Ring

/-! ### The freeness in the spelling the factorization criterion consumes -/

variable (S : AlgebraizationSituation.{u})
  (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))

/-- **Every prime of `A` not containing `𝔞` is the prime under a point of `U`.** The underlying
set of the open complement `U = X ∖ V(𝔞)` is the complement of the vanishing locus of `𝔞`, so
such a prime is itself a point of `U`. -/
theorem exists_point_underlyingPrime (p : Ideal S.A) [p.IsPrime] (hap : ¬ (S.a ≤ p)) :
    ∃ y : S.U.toScheme, (underlyingPrime S y).asIdeal = p := by
  refine ⟨⟨⟨p, inferInstance⟩, ?_⟩, rfl⟩
  exact fun h => hap fun z hz => (PrimeSpectrum.mem_zeroLocus _ _ |>.mp h) hz

/-- **The localization of the first term at a prime of `B = A ⧸ (f)` is free.** Let `(F_n)` be a
coherent `I`-adic system on `U` whose terms are finite locally free over the infinitesimal
neighbourhoods, with `I = (f)`, and let `M` be an `A`-module annihilated by `f` whose associated
sheaf restricts on `U` to the first term `F_1`. Then for every prime `𝔭` of `A` which contains
`f` and does not contain `𝔞`, the localization of `M` at the corresponding prime `𝔮 = 𝔭B` of `B`
is a free `B_𝔮`-module.

This is the shape of the hypothesis of
`Stacks.BaseQuotientFactorization.exists_pow_smul_factor_through_baseQuotient'`. Freeness is
known in the spelling `M_𝔭/f M_𝔭` over `A_𝔭/f A_𝔭`
(`Stacks.Algebraization.free_localizedModule_of_isFiniteLocallyFreeAdic`), and `f` annihilating
`M` makes `f M_𝔭` vanish, so that quotient is `M_𝔭` itself. -/
theorem free_localizedModule_baseQuotient (f : S.A) (hI : S.I = Ideal.span {f})
    (hfreeAdic : IsFiniteLocallyFreeAdic (idealOnOpen S) F)
    (M : ModuleCat.{u} (CommRingCat.of S.A)) (hfM : ∀ x : (M : Type u), f • x = 0)
    (e : (AlgebraicGeometry.tilde M).restrict S.U.ι ≅ systemObj S F 0)
    [Module (S.A ⧸ Ideal.span {f}) (M : Type u)]
    [IsScalarTower S.A (S.A ⧸ Ideal.span {f}) (M : Type u)]
    (p : Ideal S.A) [p.IsPrime] (q : Ideal (S.A ⧸ Ideal.span {f})) [q.IsPrime]
    (hq : q = p.map (Ideal.Quotient.mk (Ideal.span {f}))) (hap : ¬ (S.a ≤ p)) (hfp : f ∈ p) :
    Module.Free (Localization.AtPrime q) (LocalizedModule q.primeCompl (M : Type u)) := by
  obtain ⟨y, hy⟩ := exists_point_underlyingPrime S p hap
  subst hy
  have := free_localizedModule_of_isFiniteLocallyFreeAdic S F f hI hfreeAdic M e y
  have hbot : (Ideal.span {algebraMap S.A
                              (Localization.AtPrime (underlyingPrime S y).asIdeal) f} •
      (⊤ : Submodule (Localization.AtPrime (underlyingPrime S y).asIdeal)
        (LocalizedModule (underlyingPrime S y).asIdeal.primeCompl (M : Type u)))) = ⊥ := by
    refine le_antisymm (Submodule.smul_le.2 fun c hc w _ => ?_) bot_le
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hc
    rw [Submodule.mem_bot, mul_smul,
      algebraMap_smul (Localization.AtPrime (underlyingPrime S y).asIdeal) f w,
      localizedModule_smul_eq_zero (underlyingPrime S y).asIdeal.primeCompl hfM w, smul_zero]
  let Φ₁ := Submodule.quotEquivOfEqBot _ hbot
  obtain ⟨Φ₃, hΦ₃⟩ := exists_quotientLocalizedModuleAddEquiv hfM
    (underlyingPrime S y).asIdeal hfp q hq
  let Φ := Φ₃.trans Φ₁.toAddEquiv.symm
  let ε := (quotientLocalizationAtPrimeRingEquiv f (underlyingPrime S y).asIdeal hfp q hq).symm
  have hA : ∀ (b : S.A ⧸ Ideal.span {f})
      (x : LocalizedModule q.primeCompl (M : Type u)),
      Φ (algebraMap (S.A ⧸ Ideal.span {f}) (Localization.AtPrime q) b • x) =
        ε (algebraMap (S.A ⧸ Ideal.span {f}) (Localization.AtPrime q) b) • Φ x := by
    intro b x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [algebraMap_smul (Localization.AtPrime q)]
    have hε : ε (algebraMap (S.A ⧸ Ideal.span {f}) (Localization.AtPrime q)
          (Ideal.Quotient.mk (Ideal.span {f}) a)) =
        Ideal.Quotient.mk _ (algebraMap S.A
          (Localization.AtPrime (underlyingPrime S y).asIdeal) a) :=
      (RingEquiv.symm_apply_eq _).mpr
        (quotientLocalizationAtPrimeRingEquiv_mk f (underlyingPrime S y).asIdeal hfp q hq a).symm
    rw [hε]
    change Φ₁.symm (Φ₃ (Ideal.Quotient.mk (Ideal.span {f}) a • x)) = _
    rw [hΦ₃ a x]
    show Φ₁.symm (a • Φ₃ x) = _
    rw [← algebraMap_smul (Localization.AtPrime (underlyingPrime S y).asIdeal) a (Φ₃ x),
      Φ₁.symm.map_smul]
    change _ = Ideal.Quotient.mk _ (algebraMap S.A
      (Localization.AtPrime (underlyingPrime S y).asIdeal) a) • Φ₁.symm (Φ₃ x)
    exact (algebraMap_smul _ _ _).symm
  exact free_of_ringEquiv_of_addEquiv ε Φ
    (addEquiv_smul_of_isLocalization q.primeCompl ε Φ hA)

end Stacks.Algebraization

end
