/-!
# Grothendieck existence on an affine scheme, and the last condition of Stacks 0EIL

Let `A` be an `I`-adically complete Noetherian ring and `X = Spec A`. This file proves that the
completion functor of Stacks 0880, from coherent `𝒪_X`-modules to coherent `I`-adic systems on
`X`, is essentially surjective, and deduces the implication of Stacks 0EIL that was missing from
`StacksFrontier/AlgebraicGeometry/FormalGeometry/CompletionCriteria/Algebraization.lean`: a coherent
adic system on the open complement `U` that extends to `X` is the restriction of the completion of
a coherent module on `X`.

The construction is the affine case of Grothendieck existence, and every analytic input is already
available. Given a coherent adic system `(F_n)` along `I 𝒪_X`, its module of compatible global
sections `M = limₙ Γ(X, F_n)` is `I`-adically complete, its projection to level `n` is surjective
with kernel `I ^ (n+1) M`, and `M / I M` is a finite module (Stacks 087W, in
`StacksFrontier/AlgebraicGeometry/FormalGeometry/CoherentAdicSystem/Equivalence.lean`). Over an `I`-adically complete ring that forces `M`
itself to be finite, by [Stacks, Tag 031D]. So `M̃` is a coherent module on `X`, and the surjection
`M ↠ Γ(X, F_n)` with kernel `I ^ (n+1) M` becomes, after `~`, the quotient of `M̃` by
`I ^ (n+1) M̃` — which is exactly the `n`-th term of the completion of `M̃`. Composing with the
counit `Γ(X, F_n)~ ≅ F_n`, which is an isomorphism because `F_n` is quasi-coherent, identifies the
two systems term by term; the identification is compatible with the transition maps because both
sides are compatible with the canonical projections out of `M̃`, which are epimorphisms.

## Main results

* `Stacks.Coherent.finite_globalSectionsLimit_of_isAdicComplete` — the inverse limit of global
  sections of a coherent adic system is a finite module when the ring is complete.
* `Stacks.Coherent.isIso_affineTildeAdjunction_counit_app` — the counit `Γ(G, ⊤)~ ⟶ G` is an
  isomorphism for a quasi-coherent module on an affine scheme.
* `Stacks.Coherent.essImage_completionFunctor_of_isAdicComplete` — **Grothendieck existence in the
  affine case**: the completion functor on `Spec A` is essentially surjective for `A` complete.
* `Stacks.Algebraization.ker_Yι_eq_ofIdealTop` — the kernel ideal sheaf of `Y ⟶ X` is generated by
  the image of `I` in `Γ(X, 𝒪_X)`.
* `Stacks.Algebraization.isRestrictionOfCompletion_of_extendsToX` — **Stacks 0EIL, condition (6)
  implies condition (5) when `A` is `I`-adically complete.**

## Implementation notes

**No `@[stacks 0EIL]` or `@[stacks 088C]` attribute is placed.** Tag 088C is Grothendieck existence
for a *proper* morphism to the spectrum of a complete ring; only the case of the identity morphism
is proved here, so that tag's covering set is not complete. Tag 0EIL's covering set is spread over
this file and
`StacksFrontier/AlgebraicGeometry/FormalGeometry/CompletionCriteria/Algebraization.lean`, and placing
it is a separate decision.

The ideal of `Γ(X, 𝒪_X)` attached to `I` is `Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom I`; the
statements of Stacks 087W are indexed by such an ideal through
`AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop`, while `Stacks.Algebraization.ExtendsToX` uses
the kernel ideal sheaf of the closed immersion `Y ⟶ X`. `ker_Yι_eq_ofIdealTop` identifies the two,
and `IsAdicComplete.congr_ringEquiv` transports completeness across
`Scheme.ΓSpecIso`. Goals mentioning the completion functor are not type-correct at the transparency
a rewrite motive is built at, so the compatibilities below are assembled in term mode out of
`Category.assoc` and `congrArg`.

## References

* [Stacks Project, Tag 0EIL](https://stacks.math.columbia.edu/tag/0EIL)
* [Stacks Project, Tag 088C](https://stacks.math.columbia.edu/tag/088C)
* [Stacks Project, Tag 087W](https://stacks.math.columbia.edu/tag/087W)
* [Stacks Project, Tag 0880](https://stacks.math.columbia.edu/tag/0880)
* [Stacks Project, Tag 031D](https://stacks.math.columbia.edu/tag/031D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

universe u

namespace Stacks.Coherent

/-- Over an `I`-adically complete Noetherian ring of global sections, the inverse limit of the
global sections of a coherent adic system is a finite module. -/
public theorem finite_globalSectionsLimit_of_isAdicComplete (X : Scheme.{u}) [IsAffine X]
    [IsNoetherianRing Γ(X, ⊤)] (I : Ideal Γ(X, ⊤)) [IsAdicComplete I Γ(X, ⊤)]
    (F : CoherentAdicSystems (Scheme.IdealSheafData.ofIdealTop I)) :
    Module.Finite Γ(X, ⊤) (limit (globalSectionsSystem F) : ModuleCat Γ(X, ⊤)) := by
  have hcomplete : IsAdicComplete I (limit (globalSectionsSystem F) : ModuleCat Γ(X, ⊤)) :=
    coherentSystem_globalSectionsLimit_isAdicComplete X I F
  have hzq : Module.Finite Γ(X, ⊤)
      ((limit (globalSectionsSystem F) : ModuleCat Γ(X, ⊤)) ⧸
        I • (⊤ : Submodule Γ(X, ⊤) (limit (globalSectionsSystem F) : ModuleCat Γ(X, ⊤)))) := by
    have hcoh : (F.obj.obj (op 0)).IsCoherent := F.property.1 0
    exact moduleLimit_zeroQuotient_finite (globalSectionsSystem F)
      (coherentSystem_globalSectionsTransition_surjective X I F)
      (coherentSystem_globalSectionsTransition_ker X I F) I.fg_of_isNoetherianRing
      (coherentAdicTerm_finiteSections X (F.obj.obj (op 0)))
  exact Module.Finite.of_iInf_pow_smul_top_eq_bot_of_finite_quotient_smul_top I
    (IsHausdorff.iInf_pow_smul inferInstance)
    (Module.Finite.of_restrictScalars_finite Γ(X, ⊤) (Γ(X, ⊤) ⧸ I) _)


/-- For a quasi-coherent module on an affine scheme, the counit `(Γ(G, ⊤))~ ⟶ G` of the
adjunction between `affineTilde` and global sections is an isomorphism.

Taking global sections of the counit gives an isomorphism by the triangle identity, because the
unit of the adjunction is one; and global sections are fully faithful on quasi-coherent modules,
so they reflect isomorphisms there. -/
public theorem isIso_affineTildeAdjunction_counit_app (X : Scheme.{u}) [IsAffine X]
    (G : X.Modules) [hGq : G.IsQuasicoherent] :
    IsIso ((affineTildeAdjunction X).counit.app G) := by
  let adj := affineTildeAdjunction X
  let ev := SheafOfModules.evaluation X.ringCatSheaf (op ⊤)
  have hunit : IsIso (adj.unit.app (ev.obj G)) := by
    let u := affineTildeSectionsIso X (ev.obj G)
    exact ⟨u.inv, u.hom_inv_id, u.inv_hom_id⟩
  have h1 : IsIso (ev.map (adj.counit.app G)) :=
    isIso_of_hom_comp_eq_id (adj.unit.app (ev.obj G)) (adj.right_triangle_components G)
  let P := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let A' : P.FullSubcategory :=
    ⟨(affineTilde X).obj (ev.obj G), affineTilde_quasicoherent X (ev.obj G)⟩
  let G' : P.FullSubcategory := ⟨G, hGq⟩
  let φ : A' ⟶ G' := ObjectProperty.homMk (adj.counit.app G)
  have hFF : (P.ι ⋙ ev).FullyFaithful := affineQuasicoherentSectionsFullyFaithful X
  have hfull := hFF.full
  have hfaithful := hFF.faithful
  have h2 : IsIso ((P.ι ⋙ ev).map φ) := h1
  have h3 : IsIso φ := isIso_of_reflects_iso φ (P.ι ⋙ ev)
  exact Functor.map_isIso P.ι φ


open Stacks.Algebraization in
/-- **Grothendieck existence in the affine case.** On the spectrum of an `I`-adically complete
Noetherian ring, every coherent `I`-adic system is the completion of a coherent module. -/
public theorem essImage_completionFunctor_of_isAdicComplete (X : Scheme.{u}) [IsAffine X]
    [IsLocallyNoetherian X] [IsNoetherianRing Γ(X, ⊤)] (I : Ideal Γ(X, ⊤))
    [IsAdicComplete I Γ(X, ⊤)]
    (F : CoherentAdicSystems (Scheme.IdealSheafData.ofIdealTop I)) :
    (completionFunctor X (Scheme.IdealSheafData.ofIdealTop I)).essImage F := by
  let J := Scheme.IdealSheafData.ofIdealTop I
  let adj := affineTildeAdjunction X
  let L : ModuleCat.{u} Γ(X, ⊤) := limit (globalSectionsSystem F)
  have hLfin : Module.Finite Γ(X, ⊤) L := finite_globalSectionsLimit_of_isAdicComplete X I F
  let G : AlgebraicGeometry.SheafOfModules.CoherentModules X.ringCatSheaf :=
    ⟨(affineTilde X).obj L, affineTilde_coherent X L⟩
  let π : ∀ n : ℕ, L ⟶ (globalSectionsSystem F).obj (op n) := fun n =>
    limit.π (globalSectionsSystem F) (op n)
  let q : ∀ n : ℕ, { e : Stacks.Algebraization.idealPowerQuotient J (n + 1) G.obj ≅
        (affineTilde X).obj ((globalSectionsSystem F).obj (op n)) //
      cokernel.π (Stacks.Algebraization.idealPowerMultiple J (n + 1) G.obj).ι ≫ e.hom =
        (affineTilde X).map (π n) } := fun n =>
    affineTildeQuotientIso X I (n + 1) (π n) (coherentSystem_limitProjection_surjective X I F n)
      (coherentSystem_limitProjection_ker X I F n)
  have hFq : ∀ n : ℕ, (F.obj.obj (op n)).IsQuasicoherent := fun n =>
    @isQuasicoherent_of_isCoherent _ _ _ (F.obj.obj (op n)) (F.property.1 n)
  let cn : ∀ n : ℕ, (affineTilde X).obj ((globalSectionsSystem F).obj (op n)) ≅
      F.obj.obj (op n) := fun n =>
    @asIso _ _ _ _ (adj.counit.app (F.obj.obj (op n)))
      (@isIso_affineTildeAdjunction_counit_app X _ (F.obj.obj (op n)) (hFq n))
  let c : ∀ n : ℕ, ((completionFunctor X J).obj G).obj.obj (op n) ≅ F.obj.obj (op n) := fun n =>
    eqToIso (completionFunctor_obj X J G n) ≪≫ (q n).1 ≪≫ cn n
  have hobj : ∀ n : ℕ, ((completionFunctor X J).obj G).obj.obj (op n) =
      Stacks.Algebraization.idealPowerQuotient J (n + 1) G.obj := completionFunctor_obj X J G
  have hinner : ∀ n : ℕ, completionProjection X J G n ≫ eqToHom (hobj n) =
      cokernel.π (Stacks.Algebraization.idealPowerMultiple J (n + 1) G.obj).ι := fun n =>
    (Category.assoc _ _ _).trans
      ((congrArg (fun k =>
          cokernel.π (Stacks.Algebraization.idealPowerMultiple J (n + 1) G.obj).ι ≫ k)
        ((eqToHom_trans _ _).trans (eqToHom_refl _ _))).trans (Category.comp_id _))
  have hcp : ∀ n : ℕ, completionProjection X J G n ≫ (c n).hom =
      (affineTilde X).map (π n) ≫ (cn n).hom := by
    intro n
    refine Eq.trans (Category.assoc _ _ _).symm ?_
    refine Eq.trans (congrArg (fun k => k ≫ ((q n).1.hom ≫ (cn n).hom)) (hinner n)) ?_
    refine Eq.trans (Category.assoc _ _ _).symm ?_
    exact congrArg (fun k => k ≫ (cn n).hom) (q n).2
  have hqnat : ∀ {i j : ℕᵒᵖ} (g : i ⟶ j),
      ((affineTilde X).map (π i.unop) ≫ (cn i.unop).hom) ≫ F.obj.map g =
        (affineTilde X).map (π j.unop) ≫ (cn j.unop).hom := by
    intro i j g
    have hcounit : (cn i.unop).hom ≫ F.obj.map g =
        (affineTilde X).map ((globalSectionsSystem F).map g) ≫ (cn j.unop).hom :=
      (adj.counit.naturality (F.obj.map g)).symm
    have hlim : π i.unop ≫ (globalSectionsSystem F).map g = π j.unop := limit.w _ g
    refine Eq.trans (Category.assoc _ _ _) ?_
    refine Eq.trans (congrArg (fun k => (affineTilde X).map (π i.unop) ≫ k) hcounit) ?_
    refine Eq.trans (Category.assoc _ _ _).symm ?_
    refine Eq.trans (congrArg (fun k => k ≫ (cn j.unop).hom)
      ((affineTilde X).map_comp _ _).symm) ?_
    exact congrArg (fun k => (affineTilde X).map k ≫ (cn j.unop).hom) hlim
  have hepiP : ∀ n : ℕ, Epi (completionProjection X J G n) := by
    intro n
    have h2 : Epi (eqToHom (hobj n).symm) := IsIso.epi_of_iso _
    exact epi_comp' inferInstance h2
  refine ⟨G, ⟨ObjectProperty.isoMk _ (NatIso.ofComponents (fun n => c n.unop) ?_)⟩⟩
  intro i j g
  have hepi := hepiP i.unop
  apply (cancel_epi (completionProjection X J G i.unop)).mp
  refine Eq.trans (Category.assoc _ _ _).symm ?_
  refine Eq.trans (congrArg (fun k => k ≫ (c j.unop).hom)
    (completionProjection_naturality J G g)) ?_
  refine Eq.trans (hcp j.unop) ?_
  refine Eq.trans (hqnat g).symm ?_
  refine Eq.trans (congrArg (fun k => k ≫ F.obj.map g) (hcp i.unop).symm) ?_
  exact Category.assoc _ _ _

end Stacks.Coherent

namespace Stacks.Algebraization

/-- Transporting the completion of a coherent module along an equality of ideal sheaves. -/
public noncomputable def completionFunctorObjCongr {X : Scheme.{u}}
    [IsLocallyNoetherian X] {I J : X.IdealSheafData} (e : I = J)
    (G : AlgebraicGeometry.SheafOfModules.CoherentModules X.ringCatSheaf) :
    ((completionFunctor X I).obj G).obj ≅ ((completionFunctor X J).obj G).obj := by
  cases e
  exact Iso.refl _

/-- The kernel ideal sheaf of `Y ⟶ X` is the ideal sheaf generated by the image of `I` in the
global functions of `X = Spec A`. -/
public theorem ker_Yι_eq_ofIdealTop (S : AlgebraizationSituation.{u}) :
    S.Yι.ker = Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of S.A)).inv.hom S.I) := by
  rw [Scheme.ker_of_isAffine]
  apply Scheme.IdealSheafData.ext_of_isAffine
  simp only [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map]
  let q : CommRingCat := CommRingCat.of S.A
  let q' : CommRingCat := CommRingCat.of (S.A ⧸ S.I)
  let φ : q ⟶ q' := CommRingCat.ofHom (Ideal.Quotient.mk S.I)
  let eA := Scheme.ΓSpecIso q
  let eQ := Scheme.ΓSpecIso q'
  have hnat := Scheme.ΓSpecIso_inv_naturality φ
  have hkercomp : RingHom.ker (CommRingCat.Hom.hom
      (eA.inv ≫ Scheme.Hom.appTop S.Yι)) = S.I := by
    have hh := congrArg (fun f => RingHom.ker f.hom) hnat
    rw [CommRingCat.hom_comp, RingHom.ker_comp_of_injective] at hh
    · have hφ : RingHom.ker φ.hom = S.I := Ideal.mk_ker
      rw [hφ] at hh
      exact hh.symm
    · exact (ConcreteCategory.bijective_of_isIso eQ.inv).1
  have hker : Ideal.comap eA.inv.hom (RingHom.ker
      (CommRingCat.Hom.hom (Scheme.Hom.appTop S.Yι))) = S.I := by
    simpa [CommRingCat.hom_comp, RingHom.ker_eq_comap_bot, Ideal.comap_comap] using hkercomp
  have hEq : RingHom.ker (CommRingCat.Hom.hom (Scheme.Hom.appTop S.Yι)) =
      Ideal.map eA.inv.hom S.I := by
    rw [← hker, Ideal.map_comap_of_surjective _ (ConcreteCategory.bijective_of_isIso eA.inv).2]
  rw [hEq]
  simp [eA, q]

/-- **Stacks 0EIL, condition (6) implies condition (5) when `A` is `I`-adically complete.** -/
@[stacks 0EIL "extendable implies restriction of a completion"]
public theorem isRestrictionOfCompletion_of_extendsToX (S : AlgebraizationSituation.{u})
    [IsAdicComplete S.I S.A]
    (F : Stacks.Coherent.CoherentAdicSystems (S.Yι.ker.comap S.U.ι))
    (h : ExtendsToX S F) : IsRestrictionOfCompletion S F := by
  obtain ⟨H, ⟨eH⟩⟩ := h
  let eA := Scheme.ΓSpecIso (CommRingCat.of S.A)
  let I' : Ideal Γ(S.X, ⊤) := Ideal.map eA.inv.hom S.I
  have hK : S.Yι.ker = Scheme.IdealSheafData.ofIdealTop I' := ker_Yι_eq_ofIdealTop S
  have hNoeth : IsNoetherianRing Γ(S.X, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top S.X⟩
  have hComplete : IsAdicComplete I' Γ(S.X, ⊤) :=
    (IsAdicComplete.congr_ringEquiv S.I eA.symm.commRingCatIsoToRingEquiv).2 inferInstance
  let H' : Stacks.Coherent.CoherentAdicSystems (Scheme.IdealSheafData.ofIdealTop I') :=
    ⟨H.obj, hK ▸ H.property⟩
  obtain ⟨G, ⟨eG⟩⟩ :=
    Stacks.Coherent.essImage_completionFunctor_of_isAdicComplete S.X I' H'
  have eG' : ((completionFunctor S.X S.Yι.ker).obj G).obj ≅ H.obj :=
    completionFunctorObjCongr hK G ≪≫ (ObjectProperty.ι _).mapIso eG
  exact ⟨G, ⟨Functor.isoWhiskerRight eG' (Scheme.Modules.restrictFunctor S.U.ι) ≪≫ eH⟩⟩

end Stacks.Algebraization

end
