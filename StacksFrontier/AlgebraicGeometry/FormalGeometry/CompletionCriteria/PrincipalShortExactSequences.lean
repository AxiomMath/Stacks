/-! ### Freeness and regular parameters -/


/-- In a free module over `B`, an element killed by `b` is a `b ^ t`-multiple as soon as every
scalar killed by `b` is one: the coordinates of the element in a basis are killed by `b`, so
each is a `b ^ t`-multiple, and the chosen multipliers assemble into a finitely supported
family. -/
theorem exists_pow_smul_of_smul_eq_zero_of_free {B : Type u} [CommRing B] (b : B) (t : ℕ)
    (hb : ∀ c : B, b * c = 0 → ∃ d : B, c = b ^ t * d)
    {Q : Type v} [AddCommGroup Q] [Module B Q] [Module.Free B Q]
    (x : Q) (hx : b • x = 0) : ∃ y : Q, x = b ^ t • y := by
  classical
  obtain ⟨ι, bas⟩ := Module.Free.exists_basis (R := B) (M := Q)
  have hcoef : ∀ i, b * bas.repr x i = 0 := by
    intro i
    have h : bas.repr (b • x) i = 0 := by simp [hx]
    simpa only [map_smul, Finsupp.smul_apply, smul_eq_mul] using h
  set φ : B → B := fun c => if h : ∃ d : B, c = b ^ t * d then h.choose else 0 with hφ
  have hφspec : ∀ c : B, b * c = 0 → c = b ^ t * φ c := by
    intro c hc
    simp only [hφ, dif_pos (hb c hc)]
    exact (hb c hc).choose_spec
  let d : ι →₀ B := Finsupp.onFinset (bas.repr x).support
    (fun i => if i ∈ (bas.repr x).support then φ (bas.repr x i) else 0)
    (fun i hi => not_not.mp fun hni => hi (if_neg hni))
  refine ⟨bas.repr.symm d, ?_⟩
  have hd : b ^ t • d = bas.repr x := by
    ext i
    by_cases hi : i ∈ (bas.repr x).support
    · have h := hφspec (bas.repr x i) (hcoef i)
      simp only [Finsupp.smul_apply, smul_eq_mul, d, Finsupp.onFinset_apply, if_pos hi]
      exact h.symm
    · simp only [Finsupp.smul_apply, smul_eq_mul, d, Finsupp.onFinset_apply, if_neg hi,
        Finsupp.notMem_support_iff.mp hi]
      ring
  calc x = bas.repr.symm (bas.repr x) := by simp
    _ = bas.repr.symm (b ^ t • d) := by rw [hd]
    _ = b ^ t • bas.repr.symm d := by rw [map_smul]

/-- Modulo `(b) ^ (t + 1)`, an element killed by `b` is a `b ^ t`-multiple, for `b` a
nonzerodivisor: lifting to `R`, the relation says `b r ∈ (b ^ (t+1))`, and cancelling one `b`
puts `r` in `(b ^ t)`. -/
theorem exists_pow_mul_of_mul_eq_zero_quotient {R : Type u} [CommRing R] {b : R}
    (hb : IsSMulRegular R b) (t : ℕ) (I : Ideal R) (hI : I = Ideal.span {b} ^ (t + 1))
    (c : R ⧸ I) (hc : (Ideal.Quotient.mk I b) * c = 0) :
    ∃ d : R ⧸ I, c = (Ideal.Quotient.mk I b) ^ t * d := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective c
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hI, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton] at hc
  obtain ⟨s, hs⟩ := hc
  have hcancel : b • r = b • (b ^ t * s) := by
    simp only [smul_eq_mul]
    rw [hs]; ring
  refine ⟨Ideal.Quotient.mk I s, ?_⟩
  rw [← map_pow, ← map_mul]
  exact congrArg (Ideal.Quotient.mk I) (hb hcancel)

/-- **The local form of the short exact sequences of Stacks 0DXW.** Let `b` be a nonzerodivisor
of `R` and let `M` be an `R`-module isomorphic to a free module over `R / (b) ^ (t + 1)`. Then an
element of `M` killed by `b` is a `b ^ t`-multiple. -/
theorem exists_pow_smul_of_smul_eq_zero_of_linearEquiv
    {R : Type u} [CommRing R] {b : R} (hb : IsSMulRegular R b) (t : ℕ) (I : Ideal R)
    (hI : I = Ideal.span {b} ^ (t + 1))
    {M Q : Type v} [AddCommGroup M] [Module R M] [AddCommGroup Q] [Module R Q]
    [Module (R ⧸ I) Q] [Module.Free (R ⧸ I) Q]
    (hcompat : ∀ (r : R) (q : Q), r • q = (Ideal.Quotient.mk I r) • q)
    (e : M ≃ₗ[R] Q) (x : M) (hx : b • x = 0) : ∃ y : M, x = b ^ t • y := by
  have hbz : (Ideal.Quotient.mk I b) • e x = 0 := by
    rw [← hcompat, ← map_smul, hx, map_zero]
  obtain ⟨y, hy⟩ := exists_pow_smul_of_smul_eq_zero_of_free (Ideal.Quotient.mk I b) t
    (fun c hc => exists_pow_mul_of_mul_eq_zero_quotient hb t I hI c hc) (e x) hbz
  refine ⟨e.symm y, ?_⟩
  have : e x = e (b ^ t • e.symm y) := by
    rw [map_smul, e.apply_symm_apply, hy, hcompat, map_pow]
  exact e.injective this

/-- Regularity of a scalar transports along a bijective ring homomorphism. -/
theorem IsSMulRegular.of_bijective_ringHom {R R' : Type u} [CommRing R] [CommRing R']
    (e : R →+* R') (he : Function.Bijective e) {a : R} (h : IsSMulRegular R a) :
    IsSMulRegular R' (e a) := by
  intro u v huv
  obtain ⟨u', rfl⟩ := he.2 u
  obtain ⟨v', rfl⟩ := he.2 v
  have h1 : e (a * u') = e (a * v') := by
    rw [map_mul, map_mul]; exact huv
  exact congrArg e (h (show a • u' = a • v' from he.1 h1))


/-! ### The ideal sheaf of a principal ideal -/


section PrincipalShortExact

variable (S : AlgebraizationSituation.{u})

/-- The local scalar of multiplication by the image of `f ∈ A` is the restriction of that
image. -/
theorem scalarAt_mulBySection (f : S.A) (V : S.U.toScheme.Opens) :
    Stacks.SheafOfModules.scalarAt (mulBySection S f) V =
      (S.U.toScheme.presheaf.map (homOfLE (le_top (a := V))).op).hom (scalarMap S f) := by
  have h : Stacks.SheafOfModules.scalarAt (mulBySection S f) V =
      (S.U.toScheme.presheaf.map (isTerminalTop.from V).op).hom (scalarMap S f) * 1 := rfl
  rw [h, mul_one, Subsingleton.elim (isTerminalTop.from V) (homOfLE (le_top (a := V)))]

/-- The local scalar of multiplication by the image of `f ∈ A` over the whole of `U` is that
image. -/
theorem scalarAt_mulBySection_top (f : S.A) :
    Stacks.SheafOfModules.scalarAt (mulBySection S f) ⊤ = scalarMap S f := by
  rw [scalarAt_mulBySection,
    Subsingleton.elim (homOfLE (le_top (a := (⊤ : S.U.toScheme.Opens)))) (𝟙 _)]
  simp only [op_id, CategoryTheory.Functor.map_id]
  rfl

/-- The germ of the image of `f` in `Γ(U, 𝒪_U)` is the image of `f` in the stalk. -/
theorem germ_scalarMap_eq_baseToPointStalk (f : S.A) (y : S.U.toScheme) :
    (S.U.toScheme.presheaf.germ ⊤ y (Set.mem_univ _)).hom (scalarMap S f) =
      baseToPointStalk S y f :=
  (Scheme.Hom.germ_stalkMap_apply S.U.ι (⊤ : S.X.Opens) y (Set.mem_univ _)
    ((Scheme.ΓSpecIso (.of S.A)).inv.hom f)).symm

/-- The stalk of the ideal sheaf generated by a global scalar is generated by its germ. -/
theorem stalk_scalarIdealData {X : Scheme.{u}}
    (g : End (𝟭 (_root_.SheafOfModules.{u} X.ringCatSheaf))) (y : X) :
    IdealSheafData.stalk (scalarIdealData g) y =
      Ideal.span {(X.presheaf.germ ⊤ y (Set.mem_univ _)).hom
                    (Stacks.SheafOfModules.scalarAt g ⊤)} := by
  obtain ⟨V, hyV, -⟩ := exists_affineOpen_mem_le y ⊤ trivial
  rw [IdealSheafData.stalk_eq_map_germ _ y V hyV, scalarIdealData_ideal, Ideal.map_span,
    Set.image_singleton,
    Stacks.SheafOfModules.scalarAt_res g (homOfLE (le_top (a := V.1))),
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top (a := V.1))) y hyV]

/-- **The ideal sheaf of the situation is the one generated by the image of `f`.** When
`I = (f)` the ideal `I 𝒪_U` is the ideal sheaf generated by the global section of `𝒪_U`
attached to `f`, which is the presentation the principal-ideal results of Stacks 0H39 use. -/
theorem scalarIdealData_mulBySection_eq_idealOnOpen (f : S.A) (hI : S.I = Ideal.span {f}) :
    scalarIdealData (mulBySection S f) = idealOnOpen S := by
  refine IdealSheafData.eq_of_stalk_eq _ _ fun y => ?_
  rw [stalk_scalarIdealData, scalarAt_mulBySection_top, germ_scalarMap_eq_baseToPointStalk,
    stalk_idealOnOpen_eq_map, hI, Ideal.map_span, Set.image_singleton]

/-- The local scalar lies in the ideal sheaf of the situation, on an affine open. -/
theorem scalarAt_mem_idealOnOpen (f : S.A) (hI : S.I = Ideal.span {f})
    (W : S.U.toScheme.affineOpens) :
    Stacks.SheafOfModules.scalarAt (mulBySection S f) W.1 ∈ (idealOnOpen S).ideal W := by
  rw [← scalarIdealData_mulBySection_eq_idealOnOpen S f hI,
    scalarIdealData_ideal (mulBySection S f) W]
  exact Ideal.mem_span_singleton_self _

/-- A morphism of sheaves of modules on a scheme vanishing on all sections is zero. -/
theorem hom_eq_zero_of_sections {X : Scheme.{u}} {M N : X.Modules} (g : M ⟶ N)
    (h : ∀ (V : X.Opens) (x : Γ(M, V)), (Scheme.Modules.Hom.app g V) x = 0) : g = 0 := by
  apply Scheme.Modules.hom_ext
  intro V
  ext x
  rw [h V x]
  simp

/-- Multiplication by `f ^ n` is zero on a module annihilated by `(I 𝒪_U) ^ n`, for `I = (f)`:
its value on any section lies in the subsheaf `(I 𝒪_U) ^ n M`, which is zero. -/
theorem mulBySection_pow_app_eq_zero (f : S.A) (hI : S.I = Ideal.span {f}) (n : ℕ)
    (M : S.U.toScheme.Modules) (hM : idealPowerMultiple (idealOnOpen S) n M = ⊥) :
    ((mulBySection S f) ^ n).asHom.app M = 0 := by
  have hbot : idealPowerMultiple (scalarIdealData (mulBySection S f)) n M = ⊥ := by
    rwa [scalarIdealData_mulBySection_eq_idealOnOpen S f hI]
  refine hom_eq_zero_of_sections _ fun V x => ?_
  have hmem := principalPower_mem_idealPower (mulBySection S f) M n V x
  rwa [hbot, bot_submodule_obj_eq_bot] at hmem

/-- **The composite of two cokernel projections is a cokernel projection.** Let `p` present `N`
as the cokernel of `a`, let `q` present `P` as the cokernel of `b`, let `a` factor through `c`,
and let `c` and `b` correspond under `p`. Then `p ≫ q` presents `P` as the cokernel of `c`.

The two comparison maps are built from the universal property: `p ≫ q` kills `c` because `c`
corresponds to `b` under `p`; and the projection `M ⟶ coker c` descends first along `p`, since
`a` factors through `c`, and then along `q`, since `p` is an epimorphism. -/
theorem exists_cokernelIso_comp {𝒞 : Type*} [Category 𝒞] [HasZeroMorphisms 𝒞]
    {A M N P : 𝒞} (a : A ⟶ M) (b : N ⟶ N) (c : M ⟶ M) (a' : A ⟶ M)
    [HasCokernel a] [HasCokernel b] [HasCokernel c]
    (p : M ⟶ N) (q : N ⟶ P)
    (e₁ : cokernel a ≅ N) (he₁ : cokernel.π a ≫ e₁.hom = p)
    (e₂ : cokernel b ≅ P) (he₂ : cokernel.π b ≫ e₂.hom = q)
    (ha : a' ≫ c = a) (hc : c ≫ p = p ≫ b) :
    ∃ e : cokernel c ≅ P, cokernel.π c ≫ e.hom = p ≫ q := by
  have hpepi : Epi p := by rw [← he₁]; infer_instance
  have hqepi : Epi q := by rw [← he₂]; infer_instance
  have hbq : b ≫ q = 0 := by
    rw [← he₂, ← Category.assoc, cokernel.condition, zero_comp]
  have hcpq : c ≫ (p ≫ q) = 0 := by
    rw [← Category.assoc, hc, Category.assoc, hbq, comp_zero]
  have hac : a ≫ cokernel.π c = 0 := by
    rw [← ha, Category.assoc, cokernel.condition, comp_zero]
  let α : cokernel c ⟶ P := cokernel.desc c (p ≫ q) hcpq
  let γ : N ⟶ cokernel c := e₁.inv ≫ cokernel.desc a (cokernel.π c) hac
  have hpγ : p ≫ γ = cokernel.π c := by
    simp only [γ, ← he₁, Category.assoc, Iso.hom_inv_id_assoc, cokernel.π_desc]
  have hbγ : b ≫ γ = 0 := by
    refine hpepi.left_cancellation _ _ ?_
    rw [← Category.assoc, ← hc, Category.assoc, hpγ, cokernel.condition, comp_zero]
  let β : P ⟶ cokernel c := e₂.inv ≫ cokernel.desc b γ hbγ
  have hqβ : q ≫ β = γ := by
    simp only [β, ← he₂, Category.assoc, Iso.hom_inv_id_assoc, cokernel.π_desc]
  have hπα : cokernel.π c ≫ α = p ≫ q := cokernel.π_desc _ _ _
  have hγα : γ ≫ α = q := by
    refine hpepi.left_cancellation _ _ ?_
    rw [← Category.assoc, hpγ, hπα]
  refine ⟨⟨α, β, ?_, ?_⟩, hπα⟩
  · refine (inferInstance : Epi (cokernel.π c)).left_cancellation _ _ ?_
    rw [← Category.assoc, hπα, Category.assoc, hqβ, hpγ, Category.comp_id]
  · refine hqepi.left_cancellation _ _ ?_
    rw [← Category.assoc, hqβ, hγα, Category.comp_id]

variable (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))

/-- The iterated transition map of the tower is the functor's own map from level `n` to level
`0`: both are the image of the unique morphism `op n ⟶ op 0` of `ℕᵒᵖ`. -/
theorem proj_eq_map (n : ℕ) :
    proj (systemObj S F) (systemMapSucc S F) n = F.obj.map (homOfLE (Nat.zero_le n)).op := by
  induction n with
  | zero =>
    rw [show (homOfLE (Nat.zero_le 0)).op = 𝟙 (op 0) from Quiver.Hom.unop_inj
      (Subsingleton.elim _ _), CategoryTheory.Functor.map_id]
    rfl
  | succ n ih =>
    show systemMapSucc S F n ≫ proj (systemObj S F) (systemMapSucc S F) n = _
    rw [ih, ← CategoryTheory.Functor.map_comp]
    exact congrArg F.obj.map (Subsingleton.elim _ _)

/-- A cokernel presentation transports along an equality of the morphisms. -/
theorem exists_cokernelIso_congr {𝒞 : Type*} [Category 𝒞] [HasZeroMorphisms 𝒞] {M N P : 𝒞}
    {a b : M ⟶ N} [HasCokernel a] [HasCokernel b] (hab : a = b) (p : N ⟶ P)
    (h : ∃ e : cokernel a ≅ P, cokernel.π a ≫ e.hom = p) :
    ∃ e : cokernel b ≅ P, cokernel.π b ≫ e.hom = p := by
  subst hab; exact h

variable (f : S.A)

/-- Multiplication by `f ^ n` followed by multiplication by `f` is multiplication by `f ^ (n+1)`. -/
private theorem pow_app_comp_mulBySection_app (M : S.U.toScheme.Modules) (n : ℕ) :
    ((mulBySection S f) ^ n).asHom.app M ≫ (mulBySection S f).asHom.app M =
      ((mulBySection S f) ^ (n + 1)).asHom.app M :=
  (mulF_naturality (mulBySection S f) (((mulBySection S f) ^ n).asHom.app M)).symm.trans
    (mulF_pow_succ (mulBySection S f) M n)

/-- The system read as an adic system along the principal ideal sheaf generated by the image of
`f`, the two ideal sheaves being equal. -/
theorem isCoherentAdicSystem_scalarIdealData (hI : S.I = Ideal.span {f}) :
    Stacks.Coherent.IsCoherentAdicSystem (scalarIdealData (mulBySection S f)) F.obj := by
  rw [scalarIdealData_mulBySection_eq_idealOnOpen S f hI]; exact F.property

/-- **Each transition map of the system is a cokernel of multiplication by `f ^ (k+1)`.** The
transition is the projection onto the quotient by `I ^ (k+1)`, and for the principal ideal
`I = (f)` that quotient is the cokernel of multiplication by `f ^ (k+1)`. -/
theorem exists_cokernelIso_systemMapSucc (hI : S.I = Ideal.span {f}) (k : ℕ) :
    ∃ e : cokernel (((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 1)))
        ≅ systemObj S F k,
      cokernel.π (((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 1))) ≫ e.hom
        = systemMapSucc S F k := by
  obtain ⟨e, he⟩ := principalPowerQuotientIso (mulBySection S f) (systemObj S F (k + 1)) (k + 1)
  have hp := isCoherentAdicSystem_scalarIdealData S F f hI
  have hπ : cokernel.π (((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 1))) ≫ e.inv
      = cokernel.π (idealPowerMultiple (scalarIdealData (mulBySection S f)) (k + 1)
          (systemObj S F (k + 1))).ι :=
    (congrArg (fun g => g ≫ e.inv) he).symm.trans
      ((Category.assoc _ _ _).trans
        ((congrArg (fun g => cokernel.π (idealPowerMultiple
            (scalarIdealData (mulBySection S f)) (k + 1) (systemObj S F (k + 1))).ι ≫ g)
          e.hom_inv_id).trans (Category.comp_id _)))
  exact ⟨e.symm ≪≫ hp.quotientIso k,
    ((Category.assoc _ _ _).symm.trans
        (congrArg (fun g => g ≫ (hp.quotientIso k).hom) hπ)).trans
      (hp.cokernel_π_comp_quotientIso k)⟩

/-- **The iterated transition map of the system is a cokernel of multiplication by `f`.** For
`k = 0` this is the previous statement; the inductive step composes the cokernel presentation of
`F_(k+2) ⟶ F_(k+1)` with that of `F_(k+1) ⟶ F_1`, which is legitimate because multiplication by
`f` on `F_(k+2)` corresponds to multiplication by `f` on `F_(k+1)` under the transition map, and
because multiplication by `f ^ (k+2)` factors through multiplication by `f`. -/
theorem exists_cokernelIso_proj (hI : S.I = Ideal.span {f}) (k : ℕ) :
    ∃ e : cokernel ((mulBySection S f).asHom.app (systemObj S F (k + 1))) ≅ systemObj S F 0,
      cokernel.π ((mulBySection S f).asHom.app (systemObj S F (k + 1))) ≫ e.hom
        = proj (systemObj S F) (systemMapSucc S F) (k + 1) := by
  induction k with
  | zero =>
    obtain ⟨e, he⟩ := exists_cokernelIso_systemMapSucc S F f hI 0
    refine exists_cokernelIso_congr
      (congrArg (fun t => t.asHom.app (systemObj S F 1)) (pow_one (mulBySection S f))) _ ⟨e, ?_⟩
    exact he.trans (Category.comp_id (systemMapSucc S F 0)).symm
  | succ k ih =>
    obtain ⟨e₂, he₂⟩ := ih
    obtain ⟨e₁, he₁⟩ := exists_cokernelIso_systemMapSucc S F f hI (k + 1)
    have ha := pow_app_comp_mulBySection_app S f (systemObj S F (k + 2)) (k + 1)
    have hc : (mulBySection S f).asHom.app (systemObj S F (k + 2)) ≫ systemMapSucc S F (k + 1) =
        systemMapSucc S F (k + 1) ≫ (mulBySection S f).asHom.app (systemObj S F (k + 1)) :=
      mulF_naturality (mulBySection S f) (systemMapSucc S F (k + 1))
    obtain ⟨e, he⟩ := exists_cokernelIso_comp
      (((mulBySection S f) ^ (k + 2)).asHom.app (systemObj S F (k + 2)))
      ((mulBySection S f).asHom.app (systemObj S F (k + 1)))
      ((mulBySection S f).asHom.app (systemObj S F (k + 2)))
      (((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 2)))
      (systemMapSucc S F (k + 1)) (proj (systemObj S F) (systemMapSucc S F) (k + 1))
      e₁ he₁ e₂ he₂ ha hc
    exact ⟨e, he.trans rfl⟩

/-! ### Monomorphy checked on stalks -/

/-- The two spellings of the stalk map of a morphism of `𝒪_X`-modules have the same underlying
function: both send the germ of a section to the germ of its image, and every element of a stalk
is a germ. -/
theorem stalkMap_apply_eq_modulesStalkFunctor_map_apply (X : Scheme.{u}) (x : X)
    {M N : X.Modules} (g : M ⟶ N)
    (z : AlgebraicGeometry.SheafOfModules.stalkObj X.ringCatSheaf x M) :
    (AlgebraicGeometry.SheafOfModules.stalkMap X.ringCatSheaf x g).hom z =
      ((modulesStalkFunctor X x).map g).hom z := by
  obtain ⟨V, hx, s, hs⟩ := TopCat.Presheaf.exists_germ_eq M.val.presheaf z
  subst hs
  exact (AlgebraicGeometry.SheafOfModules.stalkMap_germ (O := X.ringCatSheaf) (x := x)
      g V hx s).trans (modulesStalkFunctor_map_germ g x V hx s).symm

/-- **A morphism of `𝒪_X`-modules injective on every stalk is a monomorphism.** -/
theorem mono_of_injective_modulesStalkFunctor_map (X : Scheme.{u}) {M N : X.Modules} (g : M ⟶ N)
    (h : ∀ x : X, Function.Injective ((modulesStalkFunctor X x).map g).hom) : Mono g := by
  refine (AlgebraicGeometry.SheafOfModules.mono_iff_injective_stalkMap
    (O := X.ringCatSheaf) g).2 fun x z₁ z₂ hz => h x ?_
  rwa [← stalkMap_apply_eq_modulesStalkFunctor_map_apply X x g z₁,
    ← stalkMap_apply_eq_modulesStalkFunctor_map_apply X x g z₂]

/-! ### The regular parameter in the local rings of `U` -/

/-- The identification of the stalk of `U` at `y` with a localization of `A` is compatible with
the two maps from `A`. -/
theorem pointStalkRingEquiv_comp_baseToPointStalk (y : S.U.toScheme) :
    (pointStalkRingEquiv S y).toRingHom.comp (baseToPointStalk S y) =
      algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal) := by
  apply RingHom.ext
  intro a
  let q := underlyingPrime S y
  have hu := Scheme.Opens.stalkIso_inv S.U y
  have hs' :
      S.X.presheaf.germ ⊤ (S.U.ι.base y) (Set.mem_univ _) ≫
          (Spec.stalkIso (.of S.A) q).hom =
        (Scheme.ΓSpecIso (.of S.A)).hom ≫
          CommRingCat.ofHom (algebraMap S.A (Localization.AtPrime q.asIdeal)) :=
    Spec.germ_stalkMapIso_hom (R := .of S.A) (x := q)
  have hrestrict :
      S.U.ι.stalkMap y ≫
          ((Scheme.Opens.stalkIso S.U y).trans (Spec.stalkIso (.of S.A) q)).hom =
        (Spec.stalkIso (.of S.A) q).hom := by
    rw [← hu]
    show (Scheme.Opens.stalkIso S.U y).inv ≫
      (Scheme.Opens.stalkIso S.U y).hom ≫ (Spec.stalkIso (.of S.A) q).hom = _
    calc
      _ = ((Scheme.Opens.stalkIso S.U y).inv ≫ (Scheme.Opens.stalkIso S.U y).hom) ≫
          (Spec.stalkIso (.of S.A) q).hom := (Category.assoc _ _ _).symm
      _ = _ := by
        rw [Iso.inv_hom_id]
        show 𝟙 ((AlgebraicGeometry.Spec (CommRingCat.of S.A)).presheaf.stalk q) ≫
          (Spec.stalkIso (.of S.A) q).hom = _
        exact Category.id_comp _
  have hmorph :
      (Scheme.ΓSpecIso (.of S.A)).inv ≫
          S.X.presheaf.germ ⊤ (S.U.ι.base y) (Set.mem_univ _) ≫
          S.U.ι.stalkMap y ≫
          ((Scheme.Opens.stalkIso S.U y).trans (Spec.stalkIso (.of S.A) q)).hom =
        CommRingCat.ofHom (algebraMap S.A (Localization.AtPrime q.asIdeal)) := by
    simp only [hrestrict]
    rw [hs']
    simp
  exact congrArg (fun t : (.of S.A : CommRingCat) ⟶
      .of (Localization.AtPrime q.asIdeal) => t.hom a) hmorph

/-- **A nonzerodivisor of `A` stays a nonzerodivisor in the local rings of `U`.** The stalk is a
localization of `A`, and localization is flat. -/
theorem isSMulRegular_baseToPointStalk (f : S.A) (hf : f ∈ nonZeroDivisors S.A)
    (y : S.U.toScheme) :
    IsSMulRegular (S.U.toScheme.presheaf.stalk y) (baseToPointStalk S y f) := by
  have hreg : IsSMulRegular S.A f := Module.Flat.isSMulRegular_of_nonZeroDivisors hf
  have hloc : IsSMulRegular (Localization.AtPrime (underlyingPrime S y).asIdeal)
      (algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal) f) :=
    hreg.of_isLocalization _ (underlyingPrime S y).asIdeal.primeCompl
  have he : (pointStalkRingEquiv S y) (baseToPointStalk S y f) =
      algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal) f :=
    congrArg (fun t : S.A →+* Localization.AtPrime (underlyingPrime S y).asIdeal => t f)
      (pointStalkRingEquiv_comp_baseToPointStalk S y)
  have htrans := IsSMulRegular.of_bijective_ringHom (pointStalkRingEquiv S y).symm.toRingHom
    (pointStalkRingEquiv S y).symm.bijective (a := (pointStalkRingEquiv S y)
      (baseToPointStalk S y f)) (he ▸ hloc)
  simpa only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    RingEquiv.symm_apply_apply] using htrans

/-- The stalk of `I 𝒪_U` is generated by the image of `f`, for `I = (f)`. This is
`Stacks.Algebraization.stalk_idealOnOpen_eq_span` of the non-catenary counterexample module
without its `IsLocalRing` hypothesis, which the computation does not use. -/
theorem stalk_idealOnOpen_eq_span_of_ideal_eq_span (f : S.A) (hI : S.I = Ideal.span {f})
    (y : S.U.toScheme) :
    IdealSheafData.stalk (idealOnOpen S) y = Ideal.span {baseToPointStalk S y f} := by
  rw [stalk_idealOnOpen_eq_map, hI, Ideal.map_span, Set.image_singleton]

/-- A cokernel presentation of `p` as the cokernel of `a` gives the colimit property. -/
def isColimit_cokernelCofork_of_iso {𝒞 : Type*} [Category 𝒞] [HasZeroMorphisms 𝒞]
    {M N P : 𝒞} (a : M ⟶ N) [HasCokernel a] (p : N ⟶ P) (t : cokernel a ≅ P)
    (ht : cokernel.π a ≫ t.hom = p) (w : a ≫ p = 0) :
    IsColimit (CokernelCofork.ofπ p w) :=
  (cokernelIsCokernel a).ofIsoColimit (Cofork.ext t ht)

/-- A cokernel presentation makes the composite vanish. -/
theorem comp_eq_zero_of_cokernelIso {𝒞 : Type*} [Category 𝒞] [HasZeroMorphisms 𝒞]
    {M N P : 𝒞} (a : M ⟶ N) [HasCokernel a] (p : N ⟶ P) (t : cokernel a ≅ P)
    (ht : cokernel.π a ≫ t.hom = p) : a ≫ p = 0 :=
  (congrArg (fun m => a ≫ m) ht).symm.trans
    ((Category.assoc _ _ _).symm.trans
      ((congrArg (fun m => m ≫ t.hom) (cokernel.condition a)).trans zero_comp))

/-- **A monomorphism together with a cokernel presentation of its cokernel is a short exact
sequence.** -/
theorem shortExact_of_mono_of_cokernelIso {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞] {M N P : 𝒞}
    (a : M ⟶ N) (hmono : Mono a) (p : N ⟶ P) (t : cokernel a ≅ P)
    (ht : cokernel.π a ≫ t.hom = p) (w : a ≫ p = 0) :
    (ShortComplex.mk a p w).ShortExact := by
  have hepi : Epi p := by
    rw [← ht]; infer_instance
  exact ShortComplex.ShortExact.mk'
    (ShortComplex.exact_of_g_is_cokernel _ (isColimit_cokernelCofork_of_iso a p t ht w))
    hmono hepi

/-- **A cokernel presentation is unchanged by precomposition with an epimorphism.** -/
theorem exists_cokernelIso_of_epi_comp {𝒞 : Type*} [Category 𝒞] [HasZeroMorphisms 𝒞]
    {W X Y P : 𝒞} (e : W ⟶ X) [Epi e] (h : X ⟶ Y) [HasCokernel h] [HasCokernel (e ≫ h)]
    (p : Y ⟶ P) (t : cokernel (e ≫ h) ≅ P) (ht : cokernel.π (e ≫ h) ≫ t.hom = p) :
    ∃ t' : cokernel h ≅ P, cokernel.π h ≫ t'.hom = p := by
  have hw := comp_eq_zero_of_cokernelIso (e ≫ h) p t ht
  have h1 : IsColimit (CokernelCofork.ofπ (cokernel.π h)
      (show (e ≫ h) ≫ cokernel.π h = 0 by
        rw [Category.assoc, cokernel.condition, comp_zero])) :=
    isCokernelEpiComp (cokernelIsCokernel h) e rfl
  have h2 : IsColimit (CokernelCofork.ofπ p hw) :=
    isColimit_cokernelCofork_of_iso (e ≫ h) p t ht hw
  exact ⟨h1.coconePointUniqueUpToIso h2,
    IsColimit.comp_coconePointUniqueUpToIso_hom h1 h2 WalkingParallelPair.one⟩

/-- The germ of the local scalar by which `f` acts is the image of `f` in the local ring. -/
theorem germ_scalarAt_mulBySection (f : S.A) (y : S.U.toScheme) (V : S.U.toScheme.Opens)
    (hy : y ∈ V) :
    (S.U.toScheme.presheaf.germ V y hy).hom
        (Stacks.SheafOfModules.scalarAt (mulBySection S f) V) = baseToPointStalk S y f := by
  rw [scalarAt_mulBySection]
  exact (TopCat.Presheaf.germ_res_apply S.U.toScheme.presheaf (homOfLE (le_top (a := V))) y hy
    (scalarMap S f)).trans (germ_scalarMap_eq_baseToPointStalk S f y)

/-- **Multiplication by `f` acts on a germ as multiplication by the image of `f` in the local
ring.** -/
theorem modulesStalkFunctor_map_mulBySection_germ (f : S.A) (M : S.U.toScheme.Modules)
    (y : S.U.toScheme) (V : S.U.toScheme.Opens) (hy : y ∈ V) (s : Γ(M, V)) :
    ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
        ((mulBySection S f).asHom.app M)).hom ((M.presheaf.germ V y hy).hom s) =
      baseToPointStalk S y f • (M.presheaf.germ V y hy).hom s :=
  (modulesStalkFunctor_map_germ ((mulBySection S f).asHom.app M) y V hy s).trans
    ((congrArg (fun u => (M.presheaf.germ V y hy).hom u)
        (Stacks.SheafOfModules.scalarActionLocal (mulBySection S f) M V s)).trans
      ((germ_smul y V hy (Stacks.SheafOfModules.scalarAt (mulBySection S f) V) s).trans
        (congrArg (fun r => r • (M.presheaf.germ V y hy).hom s)
          (germ_scalarAt_mulBySection S f y V hy))))

/-- **Multiplication by `f` acts on stalks as multiplication by the image of `f` in the local
ring.** -/
theorem modulesStalkFunctor_map_mulBySection (f : S.A) (M : S.U.toScheme.Modules)
    (y : S.U.toScheme) (z : (modulesStalkFunctor S.U.toScheme y).obj M) :
    ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
        ((mulBySection S f).asHom.app M)).hom z = baseToPointStalk S y f • z := by
  obtain ⟨V, hy, s, hs⟩ := TopCat.Presheaf.exists_germ_eq M.presheaf z
  subst hs
  exact modulesStalkFunctor_map_mulBySection_germ S f M y V hy s

/-! ### The short exact sequences -/

/-- **The stalk-level content of the short exact sequences.** At a point of `U`, an element of
the stalk of `F_(n+1)` killed by `f` lies in `I_y ^ (n+1)` times that stalk.

Away from the support of `I` the stalk of `I` is the unit ideal, so the conclusion is vacuous.
At a point of the support, finite local freeness makes the stalk of `F_(n+1)` a free module over
`𝒪_{U,y} / f ^ (n+2)`, and `f` is a nonzerodivisor of `𝒪_{U,y}`, so the annihilator of `f` in a
free module over that quotient is exactly its `f ^ (n+1)`-multiples. -/
theorem mem_pow_smul_stalk_of_smul_eq_zero (f : S.A) (hI : S.I = Ideal.span {f})
    (hf : f ∈ nonZeroDivisors S.A) (hfree : IsFiniteLocallyFreeAdic (idealOnOpen S) F) (k : ℕ)
    (y : S.U.toScheme)
    (x : (modulesStalkFunctor S.U.toScheme y).obj (systemObj S F (k + 1)))
    (hx : baseToPointStalk S y f • x = 0) :
    x ∈ IdealSheafData.stalk (idealOnOpen S) y ^ (k + 1) •
      (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
        ((modulesStalkFunctor S.U.toScheme y).obj (systemObj S F (k + 1)))) := by
  by_cases hy : y ∈ (idealOnOpen S).support
  · have hqc : (F.obj.obj (op (k + 2))).IsQuasicoherent := F.property.isQuasicoherent (k + 2)
    have hfr := free_stalk_quotient_of_isFiniteLocallyFreeAdic S F hfree (k + 1) hy
    have hIk : IdealSheafData.stalk (idealOnOpen S) y ^ (k + 2) =
        Ideal.span {baseToPointStalk S y f} ^ (k + 1 + 1) := by
      rw [stalk_idealOnOpen_eq_span_of_ideal_eq_span S f hI]
    let e : (modulesStalkFunctor S.U.toScheme y).obj (systemObj S F (k + 1)) ≃ₗ[
          S.U.toScheme.presheaf.stalk y]
        ((modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (k + 2))) ⧸
          (IdealSheafData.stalk (idealOnOpen S) y ^ (k + 2) •
            (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
              ((modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (k + 2))))))) :=
      ((idealPowerQuotientStalkLinearEquiv (idealOnOpen S) (k + 2)
          (F.obj.obj (op (k + 2))) y).trans
        ((modulesStalkFunctor S.U.toScheme y).mapIso (C := S.U.toScheme.Modules)
          (F.property.quotientIso (k + 1))).toLinearEquiv).symm
    obtain ⟨z, hz⟩ := exists_pow_smul_of_smul_eq_zero_of_linearEquiv
      (isSMulRegular_baseToPointStalk S f hf y) (k + 1)
      (IdealSheafData.stalk (idealOnOpen S) y ^ (k + 2)) hIk
      (fun r q => (algebraMap_smul
        (S.U.toScheme.presheaf.stalk y ⧸ IdealSheafData.stalk (idealOnOpen S) y ^ (k + 2))
        r q).symm) e x hx
    rw [hz, stalk_idealOnOpen_eq_span_of_ideal_eq_span S f hI]
    exact Submodule.smul_mem_smul
      (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) (k + 1)) Submodule.mem_top
  · have htop : IdealSheafData.stalk (idealOnOpen S) y = ⊤ :=
      (IdealSheafData.stalk_eq_top_iff_notMem_support (idealOnOpen S) y).mpr hy
    rw [htop, Ideal.top_pow, Submodule.top_smul]
    exact Submodule.mem_top

/-- **The map induced by multiplication by `f` is a monomorphism.** A map `ι : F_n ⟶ F_(n+1)`
through which multiplication by `f` on `F_(n+1)` factors via the transition map is injective on
every stalk, by finite local freeness and the nonzerodivisor property of `f`. -/
private theorem mono_of_comp_eq_mulBySection (f : S.A) (hI : S.I = Ideal.span {f})
    (hf : f ∈ nonZeroDivisors S.A) (hfree : IsFiniteLocallyFreeAdic (idealOnOpen S) F) (k : ℕ)
    {ι : systemObj S F k ⟶ systemObj S F (k + 1)}
    (hmapι : systemMapSucc S F k ≫ ι = (mulBySection S f).asHom.app (systemObj S F (k + 1))) :
    Mono ι := by
  refine mono_of_injective_modulesStalkFunctor_map S.U.toScheme ι fun y => ?_
  have key : ∀ z, ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
        ι).hom
      (((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
        (systemMapSucc S F k)).hom z) = baseToPointStalk S y f • z := by
    intro z
    have h1 : ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
        (systemMapSucc S F k ≫ ι)).hom z =
        ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules) ι).hom
          (((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
            (systemMapSucc S F k)).hom z) := by
      rw [(modulesStalkFunctor S.U.toScheme y).map_comp (C := S.U.toScheme.Modules)]
      rfl
    rw [← h1, hmapι]
    exact modulesStalkFunctor_map_mulBySection S f (systemObj S F (k + 1)) y z
  intro u v huv
  obtain ⟨x, hx⟩ := surjective_stalk_coherentAdicTransition F y k u
  obtain ⟨x', hx'⟩ := surjective_stalk_coherentAdicTransition F y k v
  have hbb : baseToPointStalk S y f • (x - x') = 0 := by
    rw [smul_sub, ← key x, ← key x', hx, hx', huv, sub_self]
  have hmem := mem_pow_smul_stalk_of_smul_eq_zero S F f hI hf hfree k y (x - x') hbb
  rw [← ker_stalk_coherentAdicTransition F y k] at hmem
  have hzero : ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
      (systemMapSucc S F k)).hom (x - x') = 0 := hmem
  rwa [map_sub, hx, hx', sub_eq_zero] at hzero

/-- **Stacks Project, Tag 0DXW, the short exact sequences of the proof.** Let `S` be an
algebraization situation whose ideal `I` is generated by a nonzerodivisor `f ∈ A`, and let
`(F_n)` be a coherent `I`-adic system on the open complement `U` whose terms are finite locally
free over the infinitesimal neighbourhoods. Then `(F_n)` has the short exact sequences
`0 → F_n → F_(n+1) → F_1 → 0`, i.e. condition (1) of Stacks 0H39 for multiplication by `f`.

Because `I = (f)`, every transition map `F_(n+1) ⟶ F_n` is a cokernel of multiplication by
`f ^ n` on `F_(n+1)`, and the iterated transition `F_(n+1) ⟶ F_1` is a cokernel of multiplication
by `f`. The first makes multiplication by `f` on `F_(n+1)` descend to the map `ι : F_n ⟶ F_(n+1)`
the condition asks for, and the second makes `F_(n+1) ⟶ F_1` a cokernel of `ι`, which is
exactness at the middle and surjectivity. Injectivity of `ι` is the only point where finite
local freeness and the nonzerodivisor property are used, and it is checked on stalks. -/
theorem hasPrincipalShortExactSequences_of_locallyFree (f : S.A)
    (hI : S.I = Ideal.span {f}) (hf : f ∈ nonZeroDivisors S.A)
    (hfree : IsFiniteLocallyFreeAdic (idealOnOpen S) F) :
    HasPrincipalShortExactSequences S F f := by
  intro k
  obtain ⟨e₁, he₁⟩ := exists_cokernelIso_systemMapSucc S F f hI k
  obtain ⟨e₂, he₂⟩ := exists_cokernelIso_proj S F f hI k
  have hz2 : ((mulBySection S f) ^ (k + 2)).asHom.app (systemObj S F (k + 1)) = 0 :=
    mulBySection_pow_app_eq_zero S f hI (k + 2) (systemObj S F (k + 1))
      (F.property.idealPowerMultiple_eq_bot (k + 1))
  have hcomp : ((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 1)) ≫
      (mulBySection S f).asHom.app (systemObj S F (k + 1)) = 0 :=
    (pow_app_comp_mulBySection_app S f (systemObj S F (k + 1)) (k + 1)).trans hz2
  have w1 := comp_eq_zero_of_cokernelIso
    (((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 1))) (systemMapSucc S F k) e₁ he₁
  have hc1 := isColimit_cokernelCofork_of_iso
    (((mulBySection S f) ^ (k + 1)).asHom.app (systemObj S F (k + 1))) (systemMapSucc S F k) e₁ he₁ w1
  obtain ⟨ι, hmapι⟩ : ∃ ι : systemObj S F k ⟶ systemObj S F (k + 1),
      systemMapSucc S F k ≫ ι = (mulBySection S f).asHom.app (systemObj S F (k + 1)) :=
    ⟨hc1.desc (CokernelCofork.ofπ ((mulBySection S f).asHom.app (systemObj S F (k + 1))) hcomp),
      Cofork.IsColimit.π_desc hc1⟩
  have hepi : Epi (systemMapSucc S F k) := F.property.epi_map_succ k
  obtain ⟨e₂', he₂'⟩ := exists_cokernelIso_congr hmapι.symm
    (proj (systemObj S F) (systemMapSucc S F) (k + 1)) ⟨e₂, he₂⟩
  obtain ⟨t, ht⟩ := exists_cokernelIso_of_epi_comp (systemMapSucc S F k) ι
    (proj (systemObj S F) (systemMapSucc S F) (k + 1)) e₂' he₂'
  have w := comp_eq_zero_of_cokernelIso ι _ t ht
  exact ⟨ι, w, hmapι, shortExact_of_mono_of_cokernelIso ι
    (mono_of_comp_eq_mulBySection S F f hI hf hfree k hmapι) _ t ht w⟩

end PrincipalShortExact


end Stacks.Algebraization

