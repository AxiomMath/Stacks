open CategoryTheory
open scoped Pointwise

attribute [local instance] HasDerivedCategory.standard

universe u v

namespace Stacks.LocalCohomology

/-- **One index serves every prime at once, by the ascending chain condition.**  Let `A` be a
Noetherian local ring, let `P` be a finite `A`-module, and let `ψ n : P →ₗ[A] N n` be a family of
maps into finite `A`-modules whose kernels increase with `n`.  If for every prime `𝔭` other than
the maximal ideal the localization of *some* `ψ n` at `𝔭` vanishes — the index being allowed to
depend on `𝔭` — then there is a single `n` for which the image of `ψ n` has finite length.

The kernels `ker(ψ n)` form an ascending chain of submodules of the Noetherian module `P`, so they
stabilise at some `n₀`.  A prime `𝔭` whose own index `n` exceeds `n₀` has
`ker(ψ n) = ker(ψ n₀)`, and one whose index is below `n₀` has `ker(ψ n) ⊆ ker(ψ n₀)`; either way
the vanishing at `𝔭` already holds at `n₀`, and
`Stacks.LocalCohomology.isFiniteLength_range_of_forall_exists_smul_eq_zero` applies there.

This is the step with which the proof of [Stacks, Tag 0DXU] passes from "the map is zero after
localization at each prime `𝔮 ∈ V(f)` other than `𝔪`, for `n` large enough depending on `𝔮`" to
"there exists an `n` such that the image has finite length"; the source gets the uniformity from
its Lemma 52.5.2, that the image is independent of `n` for `n` large. -/
theorem exists_isFiniteLength_range_of_forall_exists_smul_eq_zero {A : Type u} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] {P : Type v} [AddCommGroup P] [Module A P]
    [Module.Finite A P] {N : ℕ → Type v} [∀ n, AddCommGroup (N n)] [∀ n, Module A (N n)]
    [∀ n, Module.Finite A (N n)] (ψ : ∀ n : ℕ, P →ₗ[A] N n)
    (hmono : ∀ m n : ℕ, m ≤ n → LinearMap.ker (ψ m) ≤ LinearMap.ker (ψ n))
    (hvan : ∀ p : PrimeSpectrum A, p ≠ IsLocalRing.closedPoint A → ∀ x : P,
      ∃ n : ℕ, ∃ r ∉ p.asIdeal, r • ψ n x = 0) :
    ∃ n : ℕ, IsFiniteLength A ↥(LinearMap.range (ψ n)) := by
  have hP : IsNoetherian A P := isNoetherian_of_isNoetherianRing_of_finite A P
  obtain ⟨n₀, hn₀⟩ := monotone_stabilizes_iff_noetherian.mpr hP
    ⟨fun n => LinearMap.ker (ψ n), fun _ _ h => hmono _ _ h⟩
  refine ⟨n₀, isFiniteLength_range_of_forall_exists_smul_eq_zero (ψ n₀) fun p hp x => ?_⟩
  obtain ⟨n, r, hr, hrx⟩ := hvan p hp x
  refine ⟨r, hr, ?_⟩
  have hle : LinearMap.ker (ψ n) ≤ LinearMap.ker (ψ n₀) :=
    (hmono n (max n n₀) (le_max_left _ _)).trans
      (hn₀ (max n n₀) (le_max_right _ _)).ge
  simpa using hle (by simpa using hrx : r • x ∈ LinearMap.ker (ψ n))

end Stacks.LocalCohomology

namespace Dualizing

open IsLocalRing
open Stacks.RingTheory.PrincipalDivisorDepth

/-- A factor of a finite product of modules has support inside the support of the product. -/
theorem support_subset_support_pi {R : Type u} [CommRing R] {ι : Type*}
    (E : ι → Type v) [∀ j, AddCommGroup (E j)] [∀ j, Module R (E j)] (k : ι) :
    Module.support R (E k) ⊆ Module.support R (∀ j, E j) := by
  classical
  intro p hp
  obtain ⟨m, hm⟩ := Module.mem_support_iff'.mp hp
  refine Module.mem_support_iff'.mpr ⟨Pi.single k m, fun r hr hzero => hm r hr ?_⟩
  have h := congrFun hzero k
  simpa using h

/-- The depth of the localization of `B` at a prime `𝔓`, taken on the model
`LocalizedModule 𝔓ᶜ B`, is the self-depth of `B_𝔓`. -/
theorem depth_localizedModule_self_eq {B : Type u} [CommRing B] (P : Ideal B) [P.IsPrime] :
    Module.depth (Localization.AtPrime P) (maximalIdeal (Localization.AtPrime P))
        (LocalizedModule P.primeCompl B) =
      Module.depth (Localization.AtPrime P) (maximalIdeal (Localization.AtPrime P))
        (Localization.AtPrime P) :=
  Module.depth_eq_depth_of_linearEquiv _
    ((IsLocalizedModule.linearEquiv P.primeCompl
        (LocalizedModule.mkLinearMap P.primeCompl B)
        (Algebra.linearMap B (Localization.AtPrime P))).extendScalarsOfIsLocalization
      P.primeCompl (Localization.AtPrime P))

/-- **A prime other than the closed point of a local ring has `dim(A/𝔮) ≥ 1`.**  This is the
source's "`𝔮 ≠ 𝔪` so `dim(A/𝔮) ≥ 1`", which rules out the case `d = 0` of the three-way split on
`dim(A/𝔮)` in the proof of [Stacks, Tag 0DXU]. -/
theorem one_le_ringKrullDim_quotient_of_ne_closedPoint {A : Type u} [CommRing A] [IsLocalRing A]
    {q : PrimeSpectrum A} (hqm : q ≠ closedPoint A) : 1 ≤ ringKrullDim (A ⧸ q.asIdeal) := by
  have hle : q ≤ closedPoint A := le_maximalIdeal q.isPrime.ne_top
  have hnotmax : ¬ IsMax q := fun hmax => hqm (le_antisymm hle (hmax hle))
  rw [← coheight_eq_ringKrullDim_quotient]
  exact_mod_cast Order.one_le_iff_ne_zero.mpr (Order.coheight_ne_zero.mpr hnotmax)

/-- **Transporting a vanishing precomposition map along a shift of the target.**  Let `g : X ⟶ Y`
and let `a + b = ab`.  If every map `Y ⟶ W⟦a⟧⟦b⟧` is killed by precomposition with `g`, then so is
every map `Y ⟶ W⟦ab⟧`.

This is how the proof of [Stacks, Tag 0DXU] reads its vanishing in degree `-2` into a vanishing in
degree `-2 + dim(A/𝔮)`: the normalized dualizing complex of `A_𝔮` is `(ω^•_A)_𝔮⟦-dim(A/𝔮)⟧`
([Stacks, Tag 0A7Z]), and `shiftFunctorAdd'` identifies the two targets.  Precomposition is
unaffected because the identification acts on the other side. -/
theorem comp_eq_zero_of_comp_shift_eq_zero {C : Type*} [Category C] [Preadditive C]
    [HasShift C ℤ] {X Y : C} (g : X ⟶ Y) (W : C) (a b ab : ℤ) (hab : a + b = ab)
    (h : ∀ y : Y ⟶ (W⟦a⟧)⟦b⟧, g ≫ y = 0) (x : Y ⟶ W⟦ab⟧) : g ≫ x = 0 := by
  have hy := h (x ≫ ((shiftFunctorAdd' C a b ab hab).app W).hom)
  rw [← Category.assoc] at hy
  exact (cancel_mono ((shiftFunctorAdd' C a b ab hab).app W).hom).mp
    (hy.trans Limits.zero_comp.symm)

/-- **Hypothesis (6) of [Stacks, Tag 0DXU] makes `f` nilpotent on `H^{-k}(ω^•_{A_𝔮})`.**  Let `A`
be a Noetherian local ring satisfying hypothesis (6) for `f`, let `𝔮` be a prime containing `f`
and different from `𝔪`, with `dim(A/𝔮) = d`, and let `ω_{A_𝔮}` be a normalized dualizing complex
for `A_𝔮`.  If `k + d ≤ 3` then some power of `f` annihilates
`Ext^{-k}_{A_𝔮}(A_𝔮, ω_{A_𝔮}) = H^{-k}(ω_{A_𝔮})`.

This is the source's "condition (6) tells us these primes are contained in `V(f)`", used at
`d = 2` with `k = 1` and at `d = 1` with `k = 2`.  By [Stacks, Tag 0DWZ] part (4)
(`Dualizing.mem_support_pi_moduleExtInto_iff_depth_add_ringKrullDim_le`) a prime `𝔓` of `A_𝔮` in
the support of `H^{-k}(ω_{A_𝔮})` has `depth((A_𝔮)_𝔓) + dim(A_𝔮/𝔓) ≤ k`; writing `𝔓 = 𝔭A_𝔮` for
a prime `𝔭 ⊆ 𝔮` of `A`, that reads `depth(A_𝔭) + dim((A/𝔭)_𝔮) ≤ k`, and
`Stacks.RingTheory.PrincipalDivisorDepth.depth_add_ringKrullDim_quotient_le` turns it into
`depth(A_𝔭) + dim(A/𝔭) ≤ k + d ≤ 3`, which
`Stacks.RingTheory.PrincipalDivisorDepth.mem_of_depth_add_ringKrullDim_le_three` refutes unless
`f ∈ 𝔭`.  So the support lies in `V(f)` and
`Stacks.RingTheory.PrincipalDivisorDepth.exists_pow_smul_eq_zero_of_support_subset` produces the
power. -/
theorem exists_pow_smul_moduleExtInto_eq_zero_of_depthDimOffDivisor {A : Type u} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] {f : A} (hcat : Ring.IsUniversallyCatenary A)
    (h6 : DepthDimOffDivisor f) {q : PrimeSpectrum A} (hfq : f ∈ q.asIdeal)
    (hqm : q ≠ closedPoint A) (k d : ℕ)
    (hd : ringKrullDim (A ⧸ q.asIdeal) = (d : WithBot ℕ∞)) (hkd : k + d ≤ 3)
    (KB : DerivedCategory (ModuleCat.{u} (Localization.AtPrime q.asIdeal)))
    (hKB : IsNormalizedDualizingComplex.{u, u} KB) :
    ∃ c : ℕ, ∀ x : moduleExtInto (Localization.AtPrime q.asIdeal) KB (-(k : ℤ)),
      (algebraMap A (Localization.AtPrime q.asIdeal) f) ^ c • x = 0 := by
  have hfin : Module.Finite (Localization.AtPrime q.asIdeal)
      (moduleExtInto (Localization.AtPrime q.asIdeal) KB (-(k : ℤ))) :=
    moduleExtInto_finite KB hKB k
  refine exists_pow_smul_eq_zero_of_support_subset
    (N := moduleExtInto (Localization.AtPrime q.asIdeal) KB (-(k : ℤ)))
    (f := algebraMap A (Localization.AtPrime q.asIdeal) f) fun P hP => ?_
  rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem]
  have hPp : P.asIdeal.IsPrime := P.isPrime
  -- the prime of `A` below `𝔓`
  have hpp : (P.asIdeal.comap (algebraMap A (Localization.AtPrime q.asIdeal))).IsPrime :=
    Ideal.comap_isPrime _ _
  set p : PrimeSpectrum A :=
    ⟨P.asIdeal.comap (algebraMap A (Localization.AtPrime q.asIdeal)), hpp⟩ with hpdef
  have hpq : p.asIdeal ≤ q.asIdeal := by
    have h1 : P.asIdeal ≤ maximalIdeal (Localization.AtPrime q.asIdeal) :=
      le_maximalIdeal P.isPrime.ne_top
    have h2 := Localization.AtPrime.under_maximalIdeal (R := A) (I := q.asIdeal)
    exact h2 ▸ Ideal.comap_mono h1
  have hQp : (q.asIdeal.map (Ideal.Quotient.mk p.asIdeal)).IsPrime :=
    Ideal.isPrime_map_quotientMk_of_isPrime hpq
  -- the support of `H^{-k}` sits inside the support of `H^0 ⊕ ⋯ ⊕ H^{-k}`
  have hPpi : P ∈ Module.support (Localization.AtPrime q.asIdeal)
      ((j : Fin (k + 1)) →
        moduleExtInto (Localization.AtPrime q.asIdeal) KB (-(j : ℤ))) :=
    support_subset_support_pi _ (⟨k, Nat.lt_succ_self k⟩ : Fin (k + 1)) (by simpa using hP)
  rw [mem_support_pi_moduleExtInto_iff_depth_add_ringKrullDim_le KB hKB P k,
    depth_localizedModule_self_eq] at hPpi
  -- the depth over `A_𝔭` and the dimension of `(A/𝔭)_𝔮`
  have hring : Module.depth (Localization.AtPrime P.asIdeal)
        (maximalIdeal (Localization.AtPrime P.asIdeal)) (Localization.AtPrime P.asIdeal) =
      Module.depth (Localization.AtPrime p.asIdeal)
        (maximalIdeal (Localization.AtPrime p.asIdeal)) (Localization.AtPrime p.asIdeal) :=
    (Module.depth_self_eq_of_ringEquiv
      (IsLocalization.localizationLocalizationAtPrimeIsoLocalization
        q.asIdeal.primeCompl P.asIdeal).toRingEquiv).symm
  have hdimeq : ringKrullDim (Localization.AtPrime q.asIdeal ⧸ P.asIdeal) =
      ringKrullDim (Localization.AtPrime (q.asIdeal.map (Ideal.Quotient.mk p.asIdeal))) := by
    rw [show P.asIdeal =
        p.asIdeal.map (algebraMap A (Localization.AtPrime q.asIdeal)) from
      (IsLocalization.map_under q.asIdeal.primeCompl _ P.asIdeal).symm,
      Stacks.AdicCompletionDimension.ringKrullDim_quotient_localizationAtPrime
        p.asIdeal q.asIdeal hpq]
    exact (IsLocalization.AtPrime.ringKrullDim_eq_height _ _).symm
  rw [hring, hdimeq] at hPpi
  have h3 := depth_add_ringKrullDim_quotient_le hcat p.asIdeal q.asIdeal hpq k d hd hPpi
  exact mem_of_depth_add_ringKrullDim_le_three h6 hfq hqm hpq
    (h3.trans (by exact_mod_cast hkd))

/-! ### The three cases on `dim(A/𝔮)` -/

/-- **The localized `Ext` map vanishes at a prime of `V(f)` other than `𝔪`.**  Let `(A, 𝔪)` be a
Noetherian local ring with a normalized dualizing complex `ω`, let `f ∈ 𝔪` be a nonzerodivisor
satisfying hypotheses (5) and (6) of [Stacks, Tag 0DXU], and let `𝔮 ∈ V(f)` with `𝔮 ≠ 𝔪` and
`dim(A/𝔮) = d`.  Let `(Lₙ)` be a tower of finite `A_𝔮`-modules with maps `Lₙ ⟶ L₀` presenting
`Lₙ` as a free `A_𝔮/f^{n+1}`-module with `L₀ = Lₙ/fLₙ`.  Then for some `n` precomposition with
`Lₙ ⟶ L₀` kills `Ext^{-2}_{A_𝔮}(L₀, ω_𝔮)`.

The three cases of the source are these.  Write `ω_{A_𝔮} = (ω)_𝔮⟦-d⟧`, a normalized dualizing
complex for `A_𝔮` by [Stacks, Tag 0A7Z]; the degree `-2` into `(ω)_𝔮` becomes the degree `-2 + d`
into `ω_{A_𝔮}`.

* `d ≥ 3`: the degree is positive, so `Ext^{-2+d}_{A_𝔮}(Lₙ, ω_{A_𝔮})` vanishes outright
  (`Dualizing.subsingleton_moduleExtInto_of_pos`, which is [Stacks, Tag 0DWZ] part (1)), and the
  map is zero for every `n`.
* `d = 2`: the degree is `0 = -1 + 1`, so `k = 1`, and `depth(A_𝔮) ≥ 1` because `f` is a
  nonzerodivisor.
* `d = 1`: the degree is `-1 = -2 + 1`, so `k = 2`, and `depth(A_𝔮) ≥ 2` by hypothesis (5).

In the last two cases hypothesis (6) supplies the `c` with `f^c` annihilating `H^{-k}(ω_{A_𝔮})`,
and the vanishing holds for every `n ≥ c`.  The case `d = 0` does not occur: `𝔮 ≠ 𝔪`. -/
theorem exists_forall_ext_precomp_localized_eq_zero {A : Type u} [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] {f : A} (hf : f ∈ nonZeroDivisors A) (hcat : Ring.IsUniversallyCatenary A)
    (h5 : DepthDimOnDivisor f) (h6 : DepthDimOffDivisor f)
    (ω : DerivedCategory (ModuleCat.{u} A)) (hω : IsNormalizedDualizingComplex.{u, u} ω)
    {q : PrimeSpectrum A} (hfq : f ∈ q.asIdeal) (hqm : q ≠ closedPoint A)
    (d : ℕ) (hd : ringKrullDim (A ⧸ q.asIdeal) = (d : WithBot ℕ∞))
    (L : ℕ → Type u) [∀ n, AddCommGroup (L n)]
    [∀ n, Module (Localization.AtPrime q.asIdeal) (L n)]
    [∀ n, Module.Finite (Localization.AtPrime q.asIdeal) (L n)]
    (φ : ∀ n, L n →ₗ[Localization.AtPrime q.asIdeal] L 0)
    (hstruct : ∀ n : ℕ, ∃ r : ℕ,
      Nonempty (L n ≃ₗ[Localization.AtPrime q.asIdeal]
        QuotSMulTop ((algebraMap A (Localization.AtPrime q.asIdeal) f) ^ (n + 1))
          (Fin r → Localization.AtPrime q.asIdeal)) ∧
      Function.Surjective (φ n) ∧
      LinearMap.ker (φ n) =
        (algebraMap A (Localization.AtPrime q.asIdeal) f) •
          (⊤ : Submodule (Localization.AtPrime q.asIdeal) (L n))) :
    ∃ n : ℕ, ∀ x : moduleExtInto (L 0)
        ((ModuleCat.localizedModuleFunctor.{u} q.asIdeal.primeCompl).mapDerivedCategory.obj ω)
        (-2),
      (DerivedCategory.singleFunctor (ModuleCat.{u} (Localization.AtPrime q.asIdeal)) 0).map
        (ModuleCat.ofHom (φ n)) ≫ x = 0 := by
  have hnorm : IsNormalizedDualizingComplex.{u, u}
      (((ModuleCat.localizedModuleFunctor.{u} q.asIdeal.primeCompl).mapDerivedCategory.obj
        ω)⟦-(d : ℤ)⟧) :=
    isNormalizedDualizingComplex_localizedModule_shift ω hω q.asIdeal d hd
  have hd1 : 1 ≤ d := by
    have h := one_le_ringKrullDim_quotient_of_ne_closedPoint hqm
    rw [hd] at h
    exact_mod_cast h
  rcases lt_or_ge d 3 with hlt | hge
  · -- `d = 1` or `d = 2`: the long exact sequence, through the companion
    have hdepth : ((3 - d : ℕ) : ℕ∞) ≤
        Module.depth (Localization.AtPrime q.asIdeal)
          (maximalIdeal (Localization.AtPrime q.asIdeal)) (Localization.AtPrime q.asIdeal) := by
      obtain rfl | rfl : d = 1 ∨ d = 2 := by omega
      · simpa using two_le_depth_localization_of_depthDimOnDivisor hf h5 hfq hqm (by simpa using hd)
      · simpa using one_le_depth_localization hf hfq
    obtain ⟨c, hc⟩ := exists_pow_smul_moduleExtInto_eq_zero_of_depthDimOffDivisor
      hcat h6 hfq hqm (3 - d) d hd (by omega) _ hnorm
    obtain ⟨r, ⟨e⟩, hsurj, hker⟩ := hstruct c
    refine ⟨c, fun x => comp_eq_zero_of_comp_shift_eq_zero _ _ (-(d : ℤ))
      (-((3 - d : ℕ) : ℤ) + 1) (-2) (by omega) ?_ x⟩
    have hvan := ext_precomp_eq_zero_of_isoQuotPow _ hnorm _
      (isSMulRegular_localization hf q) (3 - d) (by omega) hdepth c hc c le_rfl r e (φ c)
      hsurj hker
    intro y
    simpa only [Linear.leftComp_apply, LinearMap.zero_apply] using LinearMap.congr_fun hvan y
  · -- `d ≥ 3`: the degree is positive and both `Ext` modules vanish
    refine ⟨0, fun x => comp_eq_zero_of_comp_shift_eq_zero _ _ (-(d : ℤ)) (-2 + (d : ℤ)) (-2)
      (by omega) (fun y => ?_) x⟩
    have : Subsingleton (moduleExtInto (L 0)
        (((ModuleCat.localizedModuleFunctor.{u} q.asIdeal.primeCompl).mapDerivedCategory.obj
          ω)⟦-(d : ℤ)⟧) (-2 + (d : ℤ))) :=
      subsingleton_moduleExtInto_of_pos (M := L 0) _ hnorm (-2 + (d : ℤ)) (by omega)
    exact Subsingleton.elim _ _

/-! ### Finiteness of the Krull dimension of a quotient -/

/-- The Krull dimension of `A ⧸ 𝔭` over a Noetherian local ring is a natural number: it is at
most `dim(A)`, which is finite, and it is not `⊥` because `A ⧸ 𝔭` is nonzero. -/
theorem exists_ringKrullDim_quotient_eq_natCast {A : Type u} [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (p : Ideal A) [p.IsPrime] :
    ∃ d : ℕ, ringKrullDim (A ⧸ p) = (d : WithBot ℕ∞) := by
  have hlt : ringKrullDim (A ⧸ p) < ⊤ :=
    lt_of_le_of_lt (ringKrullDim_quotient_le p) ringKrullDim_lt_top
  have hne : ringKrullDim (A ⧸ p) ≠ ⊥ := fun hbot =>
    (not_subsingleton_iff_nontrivial.mpr (Ideal.Quotient.nontrivial_iff.mpr ‹p.IsPrime›.ne_top))
      ((ringKrullDim_eq_bot_iff_subsingleton (R := A ⧸ p)).mp hbot)
  obtain ⟨b, hb⟩ := WithBot.ne_bot_iff_exists.mp hne
  have hbne : b ≠ ⊤ := fun htop => (ne_of_lt hlt) (by rw [← hb, htop]; rfl)
  obtain ⟨d, hd⟩ := ENat.ne_top_iff_exists.mp hbne
  exact ⟨d, by rw [← hb]; exact congrArg (fun z : ℕ∞ => (z : WithBot ℕ∞)) hd.symm⟩

/-! ### An element annihilating the module annihilates its Ext groups -/

/-- **An element annihilating `M` annihilates `Ext^i(M, K)`.**  Precomposition with `a • 𝟙` is
multiplication by `a`, and `a • 𝟙 M` is zero when `a` annihilates `M`.

The proof of [Stacks, Tag 0DXU] uses this for the primes off `V(f)`: `f^{n+1}` annihilates
`Mₙ = H⁰(U, ℱₙ)`, hence annihilates `Ext^{-2}_A(Mₙ, ω)`, so the localization of that module — and
with it the localized map — vanishes at any prime not containing `f`. -/
theorem smul_ext_eq_zero_of_smul_eq_zero {A : Type u} [CommRing A] (M : ModuleCat.{u} A)
    (K : DerivedCategory (ModuleCat.{u} A)) (i : ℤ) {a : A} (ha : ∀ m : M, a • m = 0)
    (x : DerivedCategory.Ext ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj M) K i) :
    a • x = 0 := by
  have hzero : (a • 𝟙 M) = 0 := by
    ext m
    change a • m = 0
    exact ha m
  have hx : a • x = (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).map (a • 𝟙 M) ≫ x := by
    rw [Functor.map_smul, CategoryTheory.Functor.map_id, Linear.smul_comp, Category.id_comp]
  rw [hx, hzero, Functor.map_zero, Limits.zero_comp]

end Dualizing

namespace Stacks.Algebraization

open _root_.Stacks.AlgebraicGeometry Dualizing IsLocalRing Opposite
open Stacks.RingTheory.PrincipalDivisorDepth

variable (S : AlgebraizationSituation.{u})
  (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))

/-- Precomposition with the transition `Mₙ ⟶ M₀` of the system of global sections, as an
`A`-linear map on `Ext^i(−, K)`.  This is the map whose image the last step of
[Stacks, Tag 0DXU] shows to have finite length, at `i = -2` and `K = ω`. -/
noncomputable abbrev extPrecompGlobalSections (K : DerivedCategory (ModuleCat.{u} S.A)) (i : ℤ)
    (n : ℕ) :=
  Linear.leftComp S.A ((shiftFunctor (DerivedCategory (ModuleCat.{u} S.A)) i).obj K)
    ((DerivedCategory.singleFunctor (ModuleCat.{u} S.A) 0).map
      ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le n)).op))

/-- **The kernels of the `Ext` transition maps increase.**  The transition `Mₙ ⟶ M₀` factors
through `M_m` for `m ≤ n`, so the `Ext` map at `n` factors through the one at `m`.

This is what makes the ascending chain condition available in the proof of [Stacks, Tag 0DXU],
and so lets one index serve every prime at once. -/
theorem ker_extPrecompGlobalSections_le (K : DerivedCategory (ModuleCat.{u} S.A)) (i : ℤ)
    {m n : ℕ} (hmn : m ≤ n) :
    LinearMap.ker (extPrecompGlobalSections S F K i m) ≤
      LinearMap.ker (extPrecompGlobalSections S F K i n) := by
  intro y hy
  rw [LinearMap.mem_ker, Linear.leftComp_apply] at hy ⊢
  have hfac : (homOfLE (Nat.zero_le n)).op =
      (homOfLE hmn).op ≫ (homOfLE (Nat.zero_le m)).op :=
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  rw [hfac, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, Category.assoc,
    hy, Limits.comp_zero]

/-- **The `Ext` transition map dies at a prime of `V(f)` other than `𝔪`.**  At such a prime `𝔭`,
for `n` large enough, every value of the precomposition map
`Ext^{-2}_A(M₀, ω) ⟶ Ext^{-2}_A(Mₙ, ω)` is annihilated by an element outside `𝔭`.

`Dualizing.localizedExtLinearEquivOfDerivedHom_naturality` identifies the localization of the `Ext`
map at `𝔭` with the precomposition map over `A_𝔭` for the localized modules and the localized
complex, and `Dualizing.exists_forall_ext_precomp_localized_eq_zero` kills the latter.  The
hypothesis `hgeo` is the local structure that hypothesis (4) of [Stacks, Tag 0DXU] provides. -/
theorem exists_smul_extPrecompGlobalSections_eq_zero_of_mem [IsLocalRing S.A]
    (ω : DerivedCategory (ModuleCat.{u} S.A)) (hω : IsNormalizedDualizingComplex.{u, u} ω)
    (hωge : ∃ b : ℤ, ω.IsGE b) {f : S.A} (hf : f ∈ nonZeroDivisors S.A)
    (hcat : Ring.IsUniversallyCatenary S.A) (h5 : DepthDimOnDivisor f)
    (h6 : DepthDimOffDivisor f)
    [hMn : ∀ n : ℕ, Module.Finite S.A ((globalSectionsSystem S F).obj (op n))]
    {p : PrimeSpectrum S.A} (hfp : f ∈ p.asIdeal) (hp : p ≠ closedPoint S.A)
    (hgeo : ∀ n : ℕ, ∃ r : ℕ,
      Nonempty ((((globalSectionsSystem S F).obj (op n)).localizedModule
            p.asIdeal.primeCompl : Type u) ≃ₗ[Localization.AtPrime p.asIdeal]
          QuotSMulTop ((algebraMap S.A (Localization.AtPrime p.asIdeal) f) ^ (n + 1))
            (Fin r → Localization.AtPrime p.asIdeal)) ∧
        Function.Surjective
          (((ModuleCat.localizedModuleFunctor.{u} p.asIdeal.primeCompl).map
            ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le n)).op)).hom) ∧
        LinearMap.ker
            (((ModuleCat.localizedModuleFunctor.{u} p.asIdeal.primeCompl).map
              ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le n)).op)).hom) =
          (algebraMap S.A (Localization.AtPrime p.asIdeal) f) •
            (⊤ : Submodule (Localization.AtPrime p.asIdeal)
              (((globalSectionsSystem S F).obj (op n)).localizedModule
                p.asIdeal.primeCompl)))
    (y : moduleExtInto ((globalSectionsSystem S F).obj (op 0)) ω (-(2 : ℤ))) :
    ∃ n : ℕ, ∃ r ∉ p.asIdeal,
      r • extPrecompGlobalSections S F ω (-2) n y = 0 := by
  obtain ⟨d, hd⟩ := exists_ringKrullDim_quotient_eq_natCast p.asIdeal
  have hfinLoc : ∀ k : ℕ, Module.Finite (Localization.AtPrime p.asIdeal)
      ((((globalSectionsSystem S F).obj (op k)).localizedModule
        p.asIdeal.primeCompl : Type u)) := fun k =>
    Module.Finite.equiv (Shrink.linearEquiv (Localization.AtPrime p.asIdeal)
      (LocalizedModule p.asIdeal.primeCompl
        ((globalSectionsSystem S F).obj (op k)))).symm
  obtain ⟨n, hn⟩ := exists_forall_ext_precomp_localized_eq_zero hf hcat h5 h6 ω hω hfp hp d hd
    (fun k => (((globalSectionsSystem S F).obj (op k)).localizedModule
      p.asIdeal.primeCompl : Type u))
    (fun k => ((ModuleCat.localizedModuleFunctor.{u} p.asIdeal.primeCompl).map
      ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le k)).op)).hom)
    hgeo
  have hkey := @localizedExtLinearEquivOfDerivedHom_naturality.{u} S.A _ _ p.asIdeal.primeCompl
    ((globalSectionsSystem S F).obj (op n)) ((globalSectionsSystem S F).obj (op 0))
    inferInstance inferInstance (hMn n) inferInstance inferInstance (hMn 0)
    ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le n)).op) ω hωge (-(2 : ℤ))
    (LocalizedModule.mk y 1)
  have hzero := hkey.trans (hn _)
  have hmk : (LocalizedModule.mk (extPrecompGlobalSections S F ω (-2) n y) 1 :
      LocalizedModule p.asIdeal.primeCompl
        (moduleExtInto ((globalSectionsSystem S F).obj (op n)) ω (-(2 : ℤ)))) = 0 := by
    refine (@localizedExtLinearEquivOfDerivedHom.{u} S.A _ _ p.asIdeal.primeCompl
      ((globalSectionsSystem S F).obj (op n)) inferInstance inferInstance (hMn n)
      ω hωge (-(2 : ℤ))).injective ?_
    rw [map_zero, ← LocalizedModule.map_mk]
    exact hzero
  refine ⟨n, ?_⟩
  rw [show (0 : LocalizedModule p.asIdeal.primeCompl
      (moduleExtInto ((globalSectionsSystem S F).obj (op n)) ω (-(2 : ℤ)))) =
        LocalizedModule.mk 0 1 from (LocalizedModule.zero_mk 1).symm,
    LocalizedModule.mk_eq] at hmk
  obtain ⟨c, hc⟩ := hmk
  refine ⟨(c : S.A), c.2, ?_⟩
  simp only [one_smul, smul_zero] at hc
  exact hc

/-- **The Ext-side half of the last step of [Stacks, Tag 0DXU].**  In an algebraization situation
whose ring `A` is Noetherian local with `𝔞 = 𝔪` (hypothesis (1)) and with a normalized dualizing
complex `ω` (hypothesis (2)), with `I = (f)` for a nonzerodivisor `f` (hypothesis (3)), with every
term of the system finite locally free over the infinitesimal neighbourhood it is annihilated by
(hypothesis (4)), and satisfying hypotheses (5) and (6), there is an `n` for which the image of

  `Ext^{-2}_A(M₀, ω) ⟶ Ext^{-2}_A(Mₙ, ω)`,   `Mₙ = H⁰(U, ℱₙ)`,

has finite length as an `A`-module.  The map is precomposition with the transition `Mₙ ⟶ M₀`.

This is the statement to which the source reduces its claim about the image of
`H¹(U, ℱₙ) ⟶ H¹(U, ℱ₁)` by local duality and Matlis duality, and whose proof is the last three
paragraphs of the source.  The three steps are:

* the modules in question are finite `A`-modules supported in `V(f)`, so it suffices to make the
  map vanish after localization at a prime `𝔮 ∈ V(f)` with `𝔮 ≠ 𝔪`; off `V(f)` the localization
  is zero because `f` annihilates `M₀` (`Dualizing.smul_ext_eq_zero_of_smul_eq_zero`), and one
  index serves every prime at once by the ascending chain condition
  (`Stacks.LocalCohomology.exists_isFiniteLength_range_of_forall_exists_smul_eq_zero`, fed by
  `Stacks.Algebraization.ker_extPrecompGlobalSections_le`);
* at such a `𝔮` the localized map is the precomposition map over `A_𝔮`
  (`Dualizing.localizedExtLinearEquivOfDerivedHom_naturality`), and `(ω)_𝔮⟦-dim(A/𝔮)⟧` is a
  normalized dualizing complex for `A_𝔮` ([Stacks, Tag 0A7Z]), which moves the degree to
  `-2 + dim(A/𝔮)`;
* the three cases on `dim(A/𝔮)` are
  `Dualizing.exists_forall_ext_precomp_localized_eq_zero`.

The local structure of hypothesis (4) enters as `hgeo`: at a prime `𝔮 ∈ V(f) ∖ {𝔪}` the
localization `(Mₙ)_𝔮` is a free `A_𝔮/f^{n+1}`-module and the transition `(Mₙ)_𝔮 ⟶ (M₀)_𝔮` is
surjective with kernel `f(Mₙ)_𝔮`.  No compatibility between the bases at different levels is
needed, which is why no rank or basis compatible with the transition maps has to be produced. -/
theorem exists_isFiniteLength_range_extPrecompGlobalSections [IsLocalRing S.A]
    (ha : S.a = maximalIdeal S.A) (ω : DerivedCategory (ModuleCat.{u} S.A))
    (hω : IsNormalizedDualizingComplex.{u, u} ω)
    {f : S.A} (hI : S.I = Ideal.span {f}) (hf : f ∈ nonZeroDivisors S.A)
    (hfree : IsFiniteLocallyFreeAdic (idealOnOpen S) F)
    (h5 : DepthDimOnDivisor f) (h6 : DepthDimOffDivisor f) :
    ∃ n : ℕ, IsFiniteLength S.A ↥(LinearMap.range (extPrecompGlobalSections S F ω (-2) n)) := by
  have hcat : Ring.IsUniversallyCatenary S.A := isUniversallyCatenary_of_isDualizingComplex hω.1
  have hωge : ∃ b : ℤ, ω.IsGE b := exists_isGE_of_isNormalizedDualizingComplex.{u, u} ω hω
  have hses : HasPrincipalShortExactSequences S F f :=
    hasPrincipalShortExactSequences_of_locallyFree S F f hI hf hfree
  have hM0 : Module.Finite S.A ((globalSectionsSystem S F).obj (op 0)) :=
    finite_globalSectionsSystem_zero_of_depthDimOnDivisor S ha F f hI hfree ω hω.1 h5
  have hMn : ∀ n : ℕ, Module.Finite S.A ((globalSectionsSystem S F).obj (op n)) :=
    finite_globalSections_of_shortExactSequences S F f hses hM0
  have hfinExt : ∀ n : ℕ, Module.Finite S.A
      (moduleExtInto ((globalSectionsSystem S F).obj (op n)) ω (-(2 : ℤ))) :=
    fun n => moduleExtInto_finite ω hω 2
  have hann0 : ∀ m : ((globalSectionsSystem S F).obj (op 0)), f • m = 0 := by
    intro m
    have hb := idealPow_smul_globalSections_eq_bot S F 0
    rw [hI, pow_one] at hb
    have hmem : f • m ∈ (Ideal.span {f} : Ideal S.A) •
        (⊤ : Submodule S.A ((globalSectionsSystem S F).obj (op 0))) :=
      Submodule.smul_mem_smul (Ideal.mem_span_singleton_self f) Submodule.mem_top
    rw [hb] at hmem
    exact (Submodule.mem_bot _).mp hmem
  have hgeo : ∀ q : PrimeSpectrum S.A, f ∈ q.asIdeal → q ≠ closedPoint S.A → ∀ n : ℕ,
      ∃ r : ℕ,
        Nonempty ((((globalSectionsSystem S F).obj (op n)).localizedModule
              q.asIdeal.primeCompl : Type u) ≃ₗ[Localization.AtPrime q.asIdeal]
            QuotSMulTop ((algebraMap S.A (Localization.AtPrime q.asIdeal) f) ^ (n + 1))
              (Fin r → Localization.AtPrime q.asIdeal)) ∧
          Function.Surjective
            (((ModuleCat.localizedModuleFunctor.{u} q.asIdeal.primeCompl).map
              ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le n)).op)).hom) ∧
          LinearMap.ker
              (((ModuleCat.localizedModuleFunctor.{u} q.asIdeal.primeCompl).map
                ((globalSectionsSystem S F).map (homOfLE (Nat.zero_le n)).op)).hom) =
            (algebraMap S.A (Localization.AtPrime q.asIdeal) f) •
              (⊤ : Submodule (Localization.AtPrime q.asIdeal)
                (((globalSectionsSystem S F).obj (op n)).localizedModule
                  q.asIdeal.primeCompl)) := by
    intro q hfq hqm n
    have := q.isPrime
    have hqm' : q.asIdeal ≠ maximalIdeal S.A := fun h => hqm (PrimeSpectrum.ext h)
    obtain ⟨r, he⟩ := exists_linearEquiv_quotSMulTop_localizedModule_globalSectionsSystem
      S F ha f hI hfree q.asIdeal hfq hqm' n
    obtain ⟨hsurj, hker⟩ :=
      surjective_and_ker_localizedModule_map_globalSectionsSystem S F ha f hI q.asIdeal hqm' n
    exact ⟨r, he, hsurj, hker⟩
  refine Stacks.LocalCohomology.exists_isFiniteLength_range_of_forall_exists_smul_eq_zero
    (P := moduleExtInto ((globalSectionsSystem S F).obj (op 0)) ω (-(2 : ℤ)))
    (N := fun n => moduleExtInto ((globalSectionsSystem S F).obj (op n)) ω (-(2 : ℤ)))
    (extPrecompGlobalSections S F ω (-2))
    (fun _ _ hmn => ker_extPrecompGlobalSections_le S F ω (-2) hmn) (fun p hp y => ?_)
  by_cases hfp : f ∈ p.asIdeal
  · exact exists_smul_extPrecompGlobalSections_eq_zero_of_mem S F ω hω hωge hf hcat h5 h6 hfp hp
      (hgeo p hfp hp) y
  · exact ⟨0, f, hfp, smul_ext_eq_zero_of_smul_eq_zero _ ω (-(2 : ℤ)) hann0 _⟩

end Stacks.Algebraization

