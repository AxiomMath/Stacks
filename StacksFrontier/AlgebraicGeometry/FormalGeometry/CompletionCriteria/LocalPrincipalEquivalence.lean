/-! ### Freeness of completed stalks and of stalks -/

/-- **The completed stalk of an object with finite free stalks is free.** Let `(ℱₙ)` be an object
of `Coh(U, I𝒪_U)` whose terms have finite free stalks over the infinitesimal neighbourhoods. At
every point `y ∈ U ∩ V(I)` the completed stalk `ℱ_y^∧ = lim ℱ_{n,y}` is a free module over the
completed local ring `𝒪_{U,y}^∧`.

The reduction `ℱ_y^∧ / (I𝒪_{U,y}^∧)ⁿ⁺¹ ℱ_y^∧` is the stalk `ℱ_{n,y}`
(`Stacks.Algebraization.completedStalkQuotientEquivStalk`), which is free over
`𝒪_{U,y}/I_yⁿ⁺¹` by hypothesis. It is therefore free over the truncation of the completed local
ring (`Stacks.Algebraization.free_quotient_adicCompletion_of_linearEquiv`), and freeness descends
from the adic quotients of a finite module over a Noetherian local ring. -/
theorem free_completedStalk_of_hasFiniteFreeStalks
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S)) (hfree : HasFiniteFreeStalks S F)
    (y : S.U.toScheme) (z : S.Y) (hyz : S.U.ι.base y = S.Yι.base z) :
    Module.Free (completedLocalRing (idealOnOpen S) y) (completedStalk (idealOnOpen S) F y) := by
  have _ : IsLocallyNoetherian S.U.toScheme := isLocallyNoetherian_of_isOpenImmersion S.U.ι
  have hle : IdealSheafData.stalk (idealOnOpen S) y ≤
      maximalIdeal (S.U.toScheme.presheaf.stalk y) := stalk_idealOnOpen_le_maximalIdeal S y z hyz
  have hI : IdealSheafData.stalk (idealOnOpen S) y ≠ ⊤ := fun h =>
    (maximalIdeal.isMaximal _).ne_top (top_le_iff.mp (h ▸ hle))
  have hfg : (IdealSheafData.stalk (idealOnOpen S) y).FG := Ideal.fg_of_isNoetherianRing _
  have : IsNoetherianRing (completedLocalRing (idealOnOpen S) y) :=
    AdicCompletion.isNoetherianRing _
  have : IsLocalRing (completedLocalRing (idealOnOpen S) y) :=
    Stacks.AdicCompletionDimension.isLocalRing_adicCompletion_of_le_maximalIdeal _ hle
  have : Module.Finite (completedLocalRing (idealOnOpen S) y)
      (completedStalk (idealOnOpen S) F y) :=
    finite_completedStalk (idealOnOpen S) F y
  have hK : completedLocalIdeal (idealOnOpen S) y ≠ ⊤ := by
    intro htop
    have hker := AdicCompletion.ker_evalOneₐ_eq_map (IdealSheafData.stalk (idealOnOpen S) y) hfg
    have h1 : (1 : completedLocalRing (idealOnOpen S) y) ∈
        RingHom.ker (AdicCompletion.evalOneₐ
          (IdealSheafData.stalk (idealOnOpen S) y)).toRingHom := by
      rw [hker]
      change (1 : completedLocalRing (idealOnOpen S) y) ∈ completedLocalIdeal (idealOnOpen S) y
      rw [htop]
      exact Submodule.mem_top
    rw [RingHom.mem_ker, map_one] at h1
    exact hI (Ideal.Quotient.zero_eq_one_iff.mp h1.symm)
  refine Stacks.FreeOfAdicQuotients.free_of_forall_free_quotient_pow_smul_top hK fun n => ?_
  obtain ⟨r, ⟨ψ⟩⟩ := hfree n y
  exact free_quotient_adicCompletion_of_linearEquiv _ hfg (n + 1)
    ((completedStalkQuotientEquivStalk F y n).trans ψ)

/-- **A coherent module whose completion has finite free stalks is free where the germ of `f` is
not a unit.** Let `I = (f)` be principal, with no condition on `f`, and let `(ℱₙ)` be an object of
`Coh(U, I𝒪_U)` whose terms have finite free stalks over the infinitesimal neighbourhoods. Suppose
a coherent module `𝒢` on an open `V ⊆ U` has completion isomorphic to the restriction of `(ℱₙ)`.
Then `𝒢_y` is a free `𝒪_{V,y}`-module at every `y ∈ V` where the germ `T` of `f` lies in the
maximal ideal.

Each `𝒢_y / Tⁿ⁺¹𝒢_y` is a finite free `𝒪_{V,y}/(Tⁿ⁺¹)`-module
(`Stacks.Algebraization.nonempty_linearEquiv_quotient_germOfBaseOpen_pow_smul`). A finite module
over a Noetherian local ring all of whose adic quotients are free is free
(`Stacks.FreeOfAdicQuotients.free_of_forall_free_quotient_pow_smul_top_of_le_maximalIdeal`). Unlike
`Stacks.Algebraization.free_stalk_of_hasFiniteFreeStalks_completion`, this does not ask `f` to be a
nonzerodivisor. -/
theorem free_stalk_of_hasFiniteFreeStalks_completion_of_germ_mem_maximalIdeal {f : S.A}
    (hI : S.I = Ideal.span {f})
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S)) (hfree : HasFiniteFreeStalks S F)
    (V : S.U.toScheme.Opens)
    (G : AlgebraicGeometry.SheafOfModules.CoherentModules V.toScheme.ringCatSheaf)
    (e : ((completionFunctor V.toScheme ((idealOnOpen S).comap V.ι)).obj G).obj ≅
          F.obj ⋙ AlgebraicGeometry.Scheme.Modules.restrictFunctor V.ι)
    (y : V.toScheme)
    (hy : germOfBase S (V.ι.base y) f ∈
      maximalIdeal (S.U.toScheme.presheaf.stalk (V.ι.base y))) :
    Module.Free (V.toScheme.presheaf.stalk y)
      ((modulesStalkFunctor V.toScheme y).obj G.obj) := by
  have _ : IsLocallyNoetherian S.U.toScheme := isLocallyNoetherian_of_isOpenImmersion S.U.ι
  have _ : IsLocallyNoetherian V.toScheme := isLocallyNoetherian_of_isOpenImmersion V.ι
  have : G.obj.IsFiniteType := _root_.SheafOfModules.IsCoherent.isFiniteType
  have : Module.Finite (V.toScheme.presheaf.stalk y)
      ((modulesStalkFunctor V.toScheme y).obj G.obj) :=
    _root_.SheafOfModules.finite_stalk V.toScheme.sheaf G.obj y
  refine Stacks.FreeOfAdicQuotients.free_of_forall_free_quotient_pow_smul_top_of_le_maximalIdeal
    (I := Ideal.span {germOfBaseOpen S V y f})
    ((Ideal.span_singleton_le_iff_mem _).2 (germOfBaseOpen_mem_maximalIdeal S V y hy))
    fun n => ?_
  obtain ⟨r, ⟨ψ⟩⟩ := nonempty_linearEquiv_quotient_germOfBaseOpen_pow_smul S hI F hfree V G e y n
  rw [Ideal.span_singleton_pow]
  exact Module.Free.of_equiv
    (ψ.extendScalarsOfSurjective (S := V.toScheme.presheaf.stalk y ⧸
      Ideal.span {germOfBaseOpen S V y f ^ (n + 1)}) Ideal.Quotient.mk_surjective).symm

/-! ### Serre's condition on `A_f` -/

/-- **`(S₂)` for `A_f` is `(S₂)` at every local ring `A_𝔭` with `f ∉ 𝔭`.** A prime `𝔭` of `A` with
`f ∉ 𝔭` extends to a prime `𝔭A_f` of `A_f`, and the localization of `A_f` at `𝔭A_f` is `A_𝔭`.
Serre's condition passes to a localization at a prime
(`propertySkRing_localizationAtPrime`) and is invariant under ring isomorphism. -/
theorem propertySkRing_localizationAtPrime_of_away (A : Type u) [CommRing A] [IsNoetherianRing A]
    (f : A) (k : ℕ) (h : PropertySkRing (Localization.Away f) k)
    (p : PrimeSpectrum A) (hf : f ∉ p.asIdeal) :
    PropertySkRing (Localization.AtPrime p.asIdeal) k := by
  have hdisj : Disjoint (Submonoid.powers f : Set A) (p.asIdeal : Set A) := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hn
    exact hf (p.isPrime.mem_of_pow_mem n hn)
  let P : Ideal (Localization.Away f) := p.asIdeal.map (algebraMap A (Localization.Away f))
  have : P.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) _ p.asIdeal p.isPrime hdisj
  have hcomap : P.comap (algebraMap A (Localization.Away f)) = p.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
      p.isPrime hdisj
  have h' :
      PropertySkRing (Localization.AtPrime (P.comap (algebraMap A (Localization.Away f)))) k :=
    propertySkRing_of_ringEquiv
      (IsLocalization.localizationLocalizationAtPrimeIsoLocalization (Submonoid.powers f)
        P).toRingEquiv.symm k
        (Stacks.LocalCohomology.propertySkRing_localizationAtPrime (Localization.Away f) P k h)
  have key : ∀ (q : Ideal A) [q.IsPrime], q = p.asIdeal →
      PropertySkRing (Localization.AtPrime q) k →
      PropertySkRing (Localization.AtPrime p.asIdeal) k := by
    rintro q _ rfl hq
    exact hq
  exact key _ hcomap h'

/-! ### Essential surjectivity -/

/-- If `I = (f)`, then `I ≤ 𝔭` iff `f ∈ 𝔭`, for a prime `𝔭`. -/
private theorem le_asIdeal_iff_mem_of_eq_span_singleton {R : Type*} [CommRing R] {I : Ideal R}
    {f : R} (hI : I = Ideal.span {f}) (p : PrimeSpectrum R) : I ≤ p.asIdeal ↔ f ∈ p.asIdeal := by
  rw [hI, Ideal.span_singleton_le_iff_mem]

/-- If `I = (f)` over a Noetherian ring, then `cd(A, I) ≤ 1`. -/
private theorem cohomologicalDimension_le_one_of_eq_span_singleton [IsLocalRing S.A] {f : S.A}
    (hI : S.I = Ideal.span {f}) (hfg : S.I.FG) :
    Stacks.LocalCohomology.cohomologicalDimension S.A S.I hfg ≤ 1 := by
  have h := Stacks.LocalCohomology.cohomologicalDimension_span_singleton_le_one S.A f
  rw [← hI] at h
  exact h

/-- **The essential-surjectivity half of [Stacks, Tag 0EKY].** In Situation 0EHC assume

1. `A` has a dualizing complex and is `I`-adically complete,
2. `I = (f)`,
3. `A` is local with maximal ideal `𝔞 = 𝔪`, and
4. either (a) `A_f` is `(S₂)` and `dim(A/𝔭) ≥ 4` for every minimal prime `𝔭` of `A` with
   `f ∉ 𝔭`, or (b) `depth(A_𝔭) + dim(A/𝔭) > 3` for every prime `𝔭 ∉ V(f)` with
   `V(𝔭) ∩ V(f) ≠ {𝔪}`.

Then every object of `Coh(U, f𝒪_U)` whose terms are finite locally free (read at the stalks,
`Stacks.Algebraization.HasFiniteFreeStalks`) is the completion of a finite locally free coherent
module on an open neighbourhood of `U₀ = U ∩ V(f)` inside `U`.

The system satisfies the `(2, 3)`-inequalities by [Stacks, Tag 0EJB], its completed stalks being
free (`Stacks.Algebraization.free_completedStalk_of_hasFiniteFreeStalks`). So it is the completion
of a coherent `𝒪_U`-module by [Stacks, Tag 0EJ9]. When `cd(A, (f)) ≤ 0` the ideal `(f)` is
nilpotent and the system extends to `X` directly. The module is free at the points of `U₀`
(`Stacks.Algebraization.free_stalk_of_hasFiniteFreeStalks_completion_of_germ_mem_maximalIdeal`),
and shrinking to its free locus leaves the completion unchanged. -/
theorem isCompletionNearClosedFiniteLocallyFree_of_isLocalRing_of_eq_span_singleton
    [IsLocalRing S.A] {f : S.A} [HasDerivedCategory.{w} (ModuleCat.{u} S.A)]
    (hdual : ∃ K : DerivedCategory (ModuleCat.{u} S.A), Dualizing.IsDualizingComplex K)
    (hcomplete : IsAdicComplete S.I S.A)
    (hI : S.I = Ideal.span {f})
    (hmax : S.a = maximalIdeal S.A)
    (hcond :
      (PropertySkRing (Localization.Away f) 2 ∧
        ∀ p : PrimeSpectrum S.A, IsMinimalPrime p.asIdeal → f ∉ p.asIdeal →
          (4 : WithBot ℕ∞) ≤ ringKrullDim (S.A ⧸ p.asIdeal)) ∨
      (∀ p : PrimeSpectrum S.A, f ∉ p.asIdeal →
        ({q : PrimeSpectrum S.A | p.asIdeal ≤ q.asIdeal} ∩
          {q : PrimeSpectrum S.A | f ∈ q.asIdeal}) ≠
          {⟨maximalIdeal S.A, (maximalIdeal.isMaximal S.A).isPrime⟩} →
        (3 : WithBot ℕ∞) <
          (Module.depth (Localization.AtPrime p.asIdeal)
            (maximalIdeal (Localization.AtPrime p.asIdeal))
            (Localization.AtPrime p.asIdeal) : WithBot ℕ∞) +
            ringKrullDim (S.A ⧸ p.asIdeal)))
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S)) (hfree : HasFiniteFreeStalks S F) :
    IsCompletionNearClosedFiniteLocallyFree S F := by
  have := hcomplete
  replace hdual := (Dualizing.exists_isDualizingComplex_iff_of_models (A := S.A) inferInstance
    (HasDerivedCategory.standard (ModuleCat.{u} S.A))).mp hdual
  have hmem := le_asIdeal_iff_mem_of_eq_span_singleton hI
  have hcd := cohomologicalDimension_le_one_of_eq_span_singleton S hI
    (IsNoetherian.noetherian S.I)
  have hess : (completionFunctor S.U.toScheme (S.Yι.ker.comap S.U.ι)).essImage
      (toKerSystem S F) := by
    rcases Int.le_iff_lt_or_eq.mp hcd with hlt | heq
    · obtain ⟨t, ht⟩ :=
        Stacks.LocalCohomology.exists_pow_eq_bot_of_cohomologicalDimension_le_zero
          S.A S.I (hmax ▸ S.I_le_a) _ (Int.lt_add_one_iff.mp hlt)
      exact (isCompletion_iff_ofRestriction S (toKerSystem S F)).mpr
        ((isCompletionOfRestriction_iff_isRestrictionOfCompletion S (toKerSystem S F)).mpr
          (isRestrictionOfCompletion_of_extendsToX S (toKerSystem S F)
            (extendsToX_of_pow_eq_bot S ht (toKerSystem S F))))
    · have hcondI :
          ((∀ p : PrimeSpectrum S.A, ¬ S.I ≤ p.asIdeal →
              PropertySkRing (Localization.AtPrime p.asIdeal) 2) ∧
            (∀ p : PrimeSpectrum S.A, IsMinimalPrime p.asIdeal →
              ¬ S.I ≤ p.asIdeal →
              (4 : WithBot ℕ∞) ≤ ringKrullDim (S.A ⧸ p.asIdeal))) ∨
          (∀ p : PrimeSpectrum S.A, ¬ S.I ≤ p.asIdeal →
            ({q : PrimeSpectrum S.A | p.asIdeal ≤ q.asIdeal} ∩
              {q : PrimeSpectrum S.A | S.I ≤ q.asIdeal}) ≠
              {⟨maximalIdeal S.A, (IsLocalRing.maximalIdeal.isMaximal S.A).isPrime⟩} →
            (3 : WithBot ℕ∞) <
              (Module.depth (Localization.AtPrime p.asIdeal)
                (maximalIdeal (Localization.AtPrime p.asIdeal))
                (Localization.AtPrime p.asIdeal) : WithBot ℕ∞) +
                ringKrullDim (S.A ⧸ p.asIdeal)) := by
        have hset : {q : PrimeSpectrum S.A | S.I ≤ q.asIdeal} =
            {q : PrimeSpectrum S.A | f ∈ q.asIdeal} := Set.ext fun q => hmem q
        rcases hcond with ⟨hS2, hcomp⟩ | hb
        · exact Or.inl ⟨fun p hp => propertySkRing_localizationAtPrime_of_away S.A f 2 hS2 p
              fun h => hp ((hmem p).2 h),
            fun p hmin hp => hcomp p hmin fun h => hp ((hmem p).2 h)⟩
        · refine Or.inr fun p hp => ?_
          rw [hset]
          exact hb p fun h => hp ((hmem p).2 h)
      have hfreeLoc : ∀ (y : S.U.toScheme) (z : S.Y), S.U.ι.base y = S.Yι.base z →
          ∀ p : PrimeSpectrum (completedLocalRing (idealOnOpen S) y),
            ¬ completedLocalIdeal (idealOnOpen S) y ≤ p.asIdeal →
            Module.Free (Localization.AtPrime p.asIdeal)
              (LocalizedModule p.asIdeal.primeCompl (completedStalk (idealOnOpen S) F y)) := by
        intro y z hyz p _
        have := free_completedStalk_of_hasFiniteFreeStalks S F hfree y z hyz
        exact Module.free_of_isLocalizedModule p.asIdeal.primeCompl
          (LocalizedModule.mkLinearMap p.asIdeal.primeCompl _)
      have hineq : SatisfiesDepthInequalities S F 2 3 :=
        satisfiesDepthInequalities_of_finiteLocallyFreeOutside S hmax hdual heq F hfreeLoc hcondI
      exact essImage_completionFunctor_of_isLocalRing_of_eq_span_singleton S F f hmax hdual hI
        hineq
  obtain ⟨V, hV, G, ⟨e'⟩⟩ := (isCompletion_iff_nearClosed S (toKerSystem S F)).mp hess
  have hJ : (idealOnOpen S).comap V.ι = (S.Yι.ker.comap S.U.ι).comap V.ι := by
    rw [idealOnOpen_eq_ker_comap]
  have _ : IsLocallyNoetherian S.U.toScheme := isLocallyNoetherian_of_isOpenImmersion S.U.ι
  have _ : IsLocallyNoetherian V.toScheme := isLocallyNoetherian_of_isOpenImmersion V.ι
  have e : ((completionFunctor V.toScheme ((idealOnOpen S).comap V.ι)).obj G).obj ≅
      F.obj ⋙ AlgebraicGeometry.Scheme.Modules.restrictFunctor V.ι :=
    completionFunctorObjCongr hJ G ≪≫ e' ≪≫ eqToIso (by rw [toKerSystem_obj])
  obtain ⟨V', hV', -, G', hflf, ⟨e''⟩⟩ :=
    exists_isFiniteLocallyFree_completion_of_free_stalks S F V G e
      (S.U.ι.base ⁻¹' Set.range S.Yι.base) hV
      (fun y hy => free_stalk_of_hasFiniteFreeStalks_completion_of_germ_mem_maximalIdeal S hI F
        hfree V G e y (germOfBase_mem_maximalIdeal_of_formalLocus S hI (V.ι.base y) hy))
  exact ⟨V', hV', G', hflf, ⟨e''⟩⟩

/-! ### Full faithfulness -/

/-- **The full-faithfulness half of [Stacks, Tag 0EKY].** Under hypotheses (1)–(4) of the tag,
for every open neighbourhood `V` of `U₀ = U ∩ V(f)` in `U` and all finite locally free coherent
`𝒪_V`-modules `𝒢`, `ℱ`, the map
`colim_{V' ⊆ V} Hom_{V'}(𝒢|_{V'}, ℱ|_{V'}) ⟶ Hom_{Coh(V, f𝒪_V)}(𝒢^∧, ℱ^∧)` is bijective.

This is [Stacks, Tag 0EKU] (`Stacks.Algebraization.completionFullyFaithful_finiteLocallyFree_on`).
Its hypothesis is checked as follows. For an associated prime `𝔭` of `A` with `f ∉ 𝔭` whose closure
meets `V(f)` outside `{𝔪}`, the only point of `V(𝔭) ∩ V(𝔪)` is `𝔪`, where the local dimension of
the closure is `dim(A/𝔭)`. Since `cd(A, (f)) ≤ 1` it suffices that `dim(A/𝔭) ≥ 3`. An associated
prime has `depth(A_𝔭) = 0`, which settles (b). Under (a), `(S₂)` at `A_𝔭` then forces
`dim(A_𝔭) = 0`, so `𝔭` is minimal and `dim(A/𝔭) ≥ 4`. -/
theorem completionFullyFaithful_finiteLocallyFree_of_isLocalRing_of_eq_span_singleton
    [IsLocalRing S.A] {f : S.A} [HasDerivedCategory.{w} (ModuleCat.{u} S.A)]
    (hdual : ∃ K : DerivedCategory (ModuleCat.{u} S.A), Dualizing.IsDualizingComplex K)
    (hcomplete : IsAdicComplete S.I S.A)
    (hI : S.I = Ideal.span {f})
    (hmax : S.a = maximalIdeal S.A)
    (hcond :
      (PropertySkRing (Localization.Away f) 2 ∧
        ∀ p : PrimeSpectrum S.A, IsMinimalPrime p.asIdeal → f ∉ p.asIdeal →
          (4 : WithBot ℕ∞) ≤ ringKrullDim (S.A ⧸ p.asIdeal)) ∨
      (∀ p : PrimeSpectrum S.A, f ∉ p.asIdeal →
        ({q : PrimeSpectrum S.A | p.asIdeal ≤ q.asIdeal} ∩
          {q : PrimeSpectrum S.A | f ∈ q.asIdeal}) ≠
          {⟨maximalIdeal S.A, (maximalIdeal.isMaximal S.A).isPrime⟩} →
        (3 : WithBot ℕ∞) <
          (Module.depth (Localization.AtPrime p.asIdeal)
            (maximalIdeal (Localization.AtPrime p.asIdeal))
            (Localization.AtPrime p.asIdeal) : WithBot ℕ∞) +
            ringKrullDim (S.A ⧸ p.asIdeal))) :
    ∀ (V : OpensNearVanishing S.A S.I S.a)
      (G F : AlgebraicGeometry.SheafOfModules.CoherentModules V.openSet.toScheme.ringCatSheaf),
      Scheme.Modules.IsFiniteLocallyFree G.obj → Scheme.Modules.IsFiniteLocallyFree F.obj →
        Function.Bijective (nbhdHomComparisonOn V G F) := by
  replace hdual := (Dualizing.exists_isDualizingComplex_iff_of_models (A := S.A) inferInstance
    (HasDerivedCategory.standard (ModuleCat.{u} S.A))).mp hdual
  have hmem := le_asIdeal_iff_mem_of_eq_span_singleton hI
  refine completionFullyFaithful_finiteLocallyFree_on S.I_le_a hcomplete hdual ?_
  rintro p hpass hpI ⟨y, hpy, hIy, hay⟩ z _ haz
  have hf : f ∉ p.asIdeal := fun h => hpI ((hmem p).2 h)
  have hz : z = closedPoint S.A := by
    ext1
    exact ((maximalIdeal.isMaximal S.A).eq_of_le z.isPrime.ne_top (hmax ▸ haz)).symm
  subst hz
  rw [closureLocalDimension_closedPoint]
  have hdepth0 : Module.depth (Localization.AtPrime p.asIdeal)
      (maximalIdeal (Localization.AtPrime p.asIdeal)) (Localization.AtPrime p.asIdeal) = 0 := by
    rw [← Module.depth_eq_depth_of_linearEquiv _
      ((LocalizedModule.equivTensorProduct p.asIdeal.primeCompl S.A).trans
        (Algebra.TensorProduct.rid S.A (Localization.AtPrime p.asIdeal)
          (Localization.AtPrime p.asIdeal)).toLinearEquiv)]
    exact depth_localization_eq_zero_of_mem_associatedPrimes p
      ((Stacks.Depth.isAssociatedPrimeStacks_iff_mem_associatedPrimes p.asIdeal).1 hpass)
  have h3 : (3 : WithBot ℕ∞) ≤ ringKrullDim (S.A ⧸ p.asIdeal) := by
    rcases hcond with ⟨hS2, hcomp⟩ | hb
    · let m := maximalIdeal (Localization.AtPrime p.asIdeal)
      have hm := propertySkRing_localizationAtPrime_of_away S.A f 2 hS2 p hf m
      let e : Localization.AtPrime m ≃+* Localization.AtPrime p.asIdeal :=
        (IsLocalization.atUnits (Localization.AtPrime p.asIdeal) m.primeCompl
          (S := Localization.AtPrime m) fun x hx => notMem_maximalIdeal.mp hx).symm.toRingEquiv
      rw [e.ringKrullDim, _root_.ringDepth_eq_of_ringEquiv e, ringDepth_eq_depth_maximalIdeal,
        hdepth0, IsLocalization.AtPrime.ringKrullDim_eq_height p.asIdeal, WithBot.unbotD_coe]
        at hm
      have hh : p.asIdeal.height = 0 := by
        rcases min_le_iff.mp hm with h2 | h0
        · exact absurd h2 (by norm_num)
        · exact nonpos_iff_eq_zero.mp h0
      exact le_trans (by norm_num) (hcomp p (Ideal.height_eq_zero_iff.mp hh) hf)
    · have hne : ({q : PrimeSpectrum S.A | p.asIdeal ≤ q.asIdeal} ∩
          {q : PrimeSpectrum S.A | f ∈ q.asIdeal}) ≠
          {⟨maximalIdeal S.A, (maximalIdeal.isMaximal S.A).isPrime⟩} := by
        intro h
        have hy : y ∈ ({q : PrimeSpectrum S.A | p.asIdeal ≤ q.asIdeal} ∩
            {q : PrimeSpectrum S.A | f ∈ q.asIdeal}) := ⟨hpy, (hmem y).1 hIy⟩
        rw [h, Set.mem_singleton_iff] at hy
        exact hay (by rw [hmax, hy])
      simpa [hdepth0] using (hb p hf hne).le
  have hcd := cohomologicalDimension_le_one_of_eq_span_singleton S hI S.I.fg_of_isNoetherianRing
  generalize ringKrullDim (S.A ⧸ p.asIdeal) = d at h3 ⊢
  generalize Stacks.LocalCohomology.cohomologicalDimension S.A S.I
    S.I.fg_of_isNoetherianRing = c at hcd ⊢
  induction d using WithBot.recBotCoe with
  | bot => exact absurd h3 (by simp)
  | coe d =>
    induction d using ENat.recTopCoe with
    | top => exact lt_top_iff_ne_top.mpr (WithBotTop.coe_ne_top _)
    | coe n =>
      have h3' : ((3 : ℕ∞) : WithBot ℕ∞) ≤ ((n : ℕ∞) : WithBot ℕ∞) := h3
      have hn : (3 : ℕ) ≤ n := by exact_mod_cast WithBot.coe_le_coe.mp h3'
      change ((c + 1 : ℤ) : EInt) < ((n : ℤ) : EInt)
      exact WithBotTop.coe_lt_coe.mpr (by omega)

/-! ### Stacks 0EKY -/

/-- **[Stacks, Tag 0EKY].** In Situation 0EHC assume

1. `A` has a dualizing complex and is `I`-adically complete,
2. `I = (f)` is generated by a single element,
3. `A` is local with maximal ideal `𝔞 = 𝔪`,
4. one of the following is true
   * (a) `A_f` is `(S₂)` and for `𝔭 ⊂ A` minimal with `f ∉ 𝔭` we have `dim(A/𝔭) ≥ 4`, or
   * (b) if `𝔭 ∉ V(f)` and `V(𝔭) ∩ V(f) ≠ {𝔪}`, then `depth(A_𝔭) + dim(A/𝔭) > 3`.

Then with `U₀ = U ∩ V(f)` the completion functor
`colim_{U₀ ⊆ U' ⊆ U open} Coh(𝒪_{U'}) ⟶ Coh(U, f𝒪_U)` is an equivalence on the full
subcategories of finite locally free objects. As for [Stacks, Tag 0EKZ]
(`Stacks.Algebraization.completionEquivalence_principal_finiteLocallyFree`), this is three
statements, and they are the three conjuncts below:

1. the functor carries a finite locally free coherent module on an open neighbourhood `V` of `U₀`
   inside `U` to a finite locally free object of `Coh(V, f𝒪_V)`. At the member `V = U` the
   stalkwise form of that conclusion holds too;
2. it is fully faithful there: for every open neighbourhood `V` of `U₀` inside `U` and all
   finite locally free `𝒪_V`-modules `𝒢`, `ℱ` the canonical map
   `colim_{V' ⊆ V} Hom_{V'}(𝒢|_{V'}, ℱ|_{V'}) ⟶ Hom_{Coh(V, f𝒪_V)}(𝒢^∧, ℱ^∧)` is bijective;
3. it is essentially surjective onto them: every finite locally free object of `Coh(U, f𝒪_U)` is
   the completion of a finite locally free coherent module on some open neighbourhood of `U₀`
   inside `U`.

An object of `colim_{U₀ ⊆ U' ⊆ U} Coh(𝒪_{U'})` is a coherent module on one of the
neighbourhoods, so the first two conjuncts quantify over a neighbourhood. Two objects given on
`V₁` and `V₂` are compared on `V₁ ∩ V₂`, which is again a neighbourhood. The target of the second
conjunct is `Coh(U, f𝒪_U)` on morphisms (`Stacks.Algebraization.bijective_restrictCompletionHom`).
A finite locally free object is one whose `n`-th term is a finite locally free
`𝒪/fⁿ⁺¹𝒪`-module: in the first conjunct this is `Stacks.Algebraization.IsFiniteLocallyFreeAdic`,
and in the third its stalkwise content `Stacks.Algebraization.HasFiniteFreeStalks`, which the first
conjunct also delivers. So the conjuncts compose into the equivalence.

Hypothesis (4a) reads "`A_f` is `(S₂)`" as `PropertySkRing (Localization.Away f) 2`, Serre's
condition of [Stacks, Tag 031P] for the ring `A_f`. In (4b), `V(f)` is the set of primes
containing `f`.

The source's proof: full faithfulness is [Stacks, Tag 0EKU]
(`completionFullyFaithful_finiteLocallyFree_of_isLocalRing_of_eq_span_singleton`). Essential
surjectivity is [Stacks, Tag 0EJ9] fed by [Stacks, Tag 0EJB], followed by the passage to the locus
where the module is free
(`isCompletionNearClosedFiniteLocallyFree_of_isLocalRing_of_eq_span_singleton`). -/
@[stacks 0EKY]
theorem completionEquivalence_local_principal_finiteLocallyFree
    [IsLocalRing S.A] {f : S.A} [HasDerivedCategory.{w} (ModuleCat.{u} S.A)]
    (hdual : ∃ K : DerivedCategory (ModuleCat.{u} S.A), Dualizing.IsDualizingComplex K)
    (hcomplete : IsAdicComplete S.I S.A)
    (hI : S.I = Ideal.span {f})
    (hmax : S.a = maximalIdeal S.A)
    (hcond :
      (PropertySkRing (Localization.Away f) 2 ∧
        ∀ p : PrimeSpectrum S.A, IsMinimalPrime p.asIdeal → f ∉ p.asIdeal →
          (4 : WithBot ℕ∞) ≤ ringKrullDim (S.A ⧸ p.asIdeal)) ∨
      (∀ p : PrimeSpectrum S.A, f ∉ p.asIdeal →
        ({q : PrimeSpectrum S.A | p.asIdeal ≤ q.asIdeal} ∩
          {q : PrimeSpectrum S.A | f ∈ q.asIdeal}) ≠
          {⟨maximalIdeal S.A, (maximalIdeal.isMaximal S.A).isPrime⟩} →
        (3 : WithBot ℕ∞) <
          (Module.depth (Localization.AtPrime p.asIdeal)
            (maximalIdeal (Localization.AtPrime p.asIdeal))
            (Localization.AtPrime p.asIdeal) : WithBot ℕ∞) +
            ringKrullDim (S.A ⧸ p.asIdeal))) :
    ((∀ (V : S.U.toScheme.Opens),
          (S.U.ι.base ⁻¹' Set.range S.Yι.base) ⊆ (V : Set S.U.toScheme) →
          ∀ G : AlgebraicGeometry.SheafOfModules.CoherentModules V.toScheme.ringCatSheaf,
            AlgebraicGeometry.Scheme.Modules.IsFiniteLocallyFree G.obj →
            IsFiniteLocallyFreeAdic ((idealOnOpen S).comap V.ι)
              ((completionFunctor V.toScheme ((idealOnOpen S).comap V.ι)).obj G)) ∧
        ∀ G : AlgebraicGeometry.SheafOfModules.CoherentModules S.U.toScheme.ringCatSheaf,
          AlgebraicGeometry.Scheme.Modules.IsFiniteLocallyFree G.obj →
          HasFiniteFreeStalks S ((completionFunctor S.U.toScheme (idealOnOpen S)).obj G)) ∧
      (∀ (V : OpensNearVanishing S.A S.I S.a)
        (G F : AlgebraicGeometry.SheafOfModules.CoherentModules V.openSet.toScheme.ringCatSheaf),
        Scheme.Modules.IsFiniteLocallyFree G.obj → Scheme.Modules.IsFiniteLocallyFree F.obj →
          Function.Bijective (nbhdHomComparisonOn V G F)) ∧
      (∀ F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S),
        HasFiniteFreeStalks S F → IsCompletionNearClosedFiniteLocallyFree S F) :=
  ⟨⟨fun V _ G hG =>
      isFiniteLocallyFreeAdic_completion V.toScheme ((idealOnOpen S).comap V.ι) G
        ((AlgebraicGeometry.Scheme.Modules.isFiniteLocallyFree_iff G.obj).mp hG),
    fun G hG m y => hasFiniteFreeStalks_completionFunctor_of_isFiniteLocallyFree S G hG m y⟩,
    completionFullyFaithful_finiteLocallyFree_of_isLocalRing_of_eq_span_singleton S hdual
      hcomplete hI hmax hcond,
    fun F hfree =>
      isCompletionNearClosedFiniteLocallyFree_of_isLocalRing_of_eq_span_singleton S hdual
        hcomplete hI hmax hcond F hfree⟩

end Stacks.Algebraization

