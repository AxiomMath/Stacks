module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionCriteria.ComplementTildeStalk
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionCriteria.OpenStalkNonzerodivisor
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionCriteria.PrincipalShortExactStalk

/-!
# Finite freeness of a stalk of `Ñ|_U` read in the base ring

Fix an algebraization situation: a Noetherian ring `A` with ideals `I ⊆ 𝔞`, the affine scheme
`X = Spec(A)` and the open complement `U = X ∖ V(𝔞)`, and suppose `I = (f)` is principal. For an
`A`-module `N` the sheaf `Ñ|_U` of `𝒪_U`-modules has, at a point `y` of `U` lying over the prime
`𝔭 ⊆ A`, the stalk `N_𝔭`.

The hypothesis one has in practice is geometric: the stalk at `y` of a sheaf `G` isomorphic to
`Ñ|_U` is finite free over `𝒪_{U,y} / (I 𝒪_U)_y`. The conclusion one wants is algebraic: `N_𝔭` is
finite free over `A_𝔭 / f A_𝔭`. This file transports the former into the latter. Nothing
mathematical happens: the identification `𝒪_{U,y} ≅ A_𝔭` of
`Stacks.Algebraization.pointStalkRingEquiv` carries the stalk `(I 𝒪_U)_y`, which is generated by
the germ of `f`, onto the ideal generated by the image of `f`, so it descends to an isomorphism of
the two quotient rings, and the identification of `Ñ|_U`'s stalk with `N_𝔭` is semilinear over
it. Composing the isomorphism of sheaves, the hypothesis, and these two identifications gives an
isomorphism which is semilinear over the composite of `pointStalkRingEquiv` with its inverse, that
is, linear over `A_𝔭`.

## Main definitions

* `Stacks.Algebraization.stalkQuotientRingEquiv` — the isomorphism
  `𝒪_{U,y} / (I 𝒪_U)_y ≅ A_𝔭 / f A_𝔭` induced by `pointStalkRingEquiv`.

## Main results

* `Stacks.Algebraization.pointStalkRingEquiv_germOfBase` — the identification `𝒪_{U,y} ≅ A_𝔭`
  carries the germ at `y` of the function determined by `a ∈ A` to the image of `a` in `A_𝔭`.
* `Stacks.Algebraization.map_pointStalkRingEquiv_stalk_idealOnOpen` — when `I = (f)` that
  identification carries the stalk of `I 𝒪_U` at `y` onto the ideal of `A_𝔭` generated by the
  image of `f`.
* `Stacks.Algebraization.stalkQuotientRingEquiv_smul` — the induced isomorphism of quotient rings
  is semilinear over `pointStalkRingEquiv`.
* `Stacks.Algebraization.exists_linearEquiv_localizedModule_of_free_stalk` — **if the stalk at `y`
  of a sheaf isomorphic to `Ñ|_U` is finite free over `𝒪_{U,y} / (I 𝒪_U)_y`, then `N_𝔭` is finite
  free over `A_𝔭 / f A_𝔭`.**

## References

* [Stacks Project, Tag 0EKZ](https://stacks.math.columbia.edu/tag/0EKZ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Algebraization

variable (S : AlgebraizationSituation.{u}) (y : S.U.toScheme)

/-- **The identification `𝒪_{U,y} ≅ A_𝔭` carries germs of base functions to images in `A_𝔭`.**
The germ at `y` of the global function on `U` determined by `a ∈ A` is the image of `a` under the
ring map `A → 𝒪_{U,y}` going through the stalk of `X` at the prime under `y`, and the
identification of local rings carries that map to the localization map. -/
theorem pointStalkRingEquiv_germOfBase (a : S.A) :
    pointStalkRingEquiv S y (germOfBase S y a) =
      algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal) a := by
  rw [germOfBase_eq_baseToPointStalk]
  exact pointStalkRingEquiv_baseToPointStalk_apply S y a

/-- **When `I = (f)` the identification `𝒪_{U,y} ≅ A_𝔭` carries the stalk of `I 𝒪_U` at `y` onto
`f A_𝔭`.** The stalk is generated by the germ of `f`
(`Stacks.Algebraization.stalk_idealOnOpen_eq_span_germOfBase`), the image of a principal ideal is
generated by the image of its generator, and the identification carries the germ of `f` to the
image of `f` in `A_𝔭`.

The equality is stated in the direction `Ideal.quotientEquiv` expects, and with the first power of
the stalk ideal, which is the shape in which the finite-freeness hypothesis on stalks arises. -/
theorem map_pointStalkRingEquiv_stalk_idealOnOpen {f : S.A} (hI : S.I = Ideal.span {f}) :
    (Ideal.span {f}).map
        (algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal)) =
      Ideal.map (pointStalkRingEquiv S y).toRingHom
        (IdealSheafData.stalk (idealOnOpen S) y ^ 1) := by
  rw [pow_one, stalk_idealOnOpen_eq_span_germOfBase S hI y, Ideal.map_span, Ideal.map_span,
    Set.image_singleton, Set.image_singleton]
  exact congrArg (fun t => Ideal.span {t}) (pointStalkRingEquiv_germOfBase S y f).symm

/-- **The identification `𝒪_{U,y} ≅ A_𝔭` descends to the quotients by the stalk of `I 𝒪_U` and by
`f A_𝔭`**, when `I = (f)` is principal. -/
def stalkQuotientRingEquiv {f : S.A} (hI : S.I = Ideal.span {f}) :
    (S.U.toScheme.presheaf.stalk y ⧸ IdealSheafData.stalk (idealOnOpen S) y ^ 1) ≃+*
      (Localization.AtPrime (underlyingPrime S y).asIdeal ⧸
        (Ideal.span {f}).map
          (algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal))) :=
  Ideal.quotientEquiv _ _ (pointStalkRingEquiv S y)
    (map_pointStalkRingEquiv_stalk_idealOnOpen S y hI)

/-- **The isomorphism of quotient rings is semilinear over `pointStalkRingEquiv`** for the scalar
actions of `𝒪_{U,y}` on the one quotient and of `A_𝔭` on the other: both actions are by
multiplication of representatives, and the isomorphism is induced by a ring map. -/
theorem stalkQuotientRingEquiv_smul {f : S.A} (hI : S.I = Ideal.span {f})
    (c : S.U.toScheme.presheaf.stalk y)
    (x : S.U.toScheme.presheaf.stalk y ⧸ IdealSheafData.stalk (idealOnOpen S) y ^ 1) :
    stalkQuotientRingEquiv S y hI (c • x) =
      pointStalkRingEquiv S y c • stalkQuotientRingEquiv S y hI x := by
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hc : c • (Ideal.Quotient.mk (IdealSheafData.stalk (idealOnOpen S) y ^ 1) a) =
      Ideal.Quotient.mk (IdealSheafData.stalk (idealOnOpen S) y ^ 1) (c * a) := rfl
  rw [hc]
  show Ideal.Quotient.mk _ (pointStalkRingEquiv S y (c * a)) =
    pointStalkRingEquiv S y c • Ideal.Quotient.mk _ (pointStalkRingEquiv S y a)
  rw [map_mul]
  rfl

/-- **Finite freeness of the stalk of `Ñ|_U` is finite freeness of `N_𝔭` over `A_𝔭 / f A_𝔭`.**
Let `I = (f)` be principal, let `G` be a sheaf of `𝒪_U`-modules isomorphic to `Ñ|_U`, and suppose
the stalk of `G` at a point `y` of `U` is free of finite rank over
`𝒪_{U,y} / (I 𝒪_U)_y`. Then the localization `N_𝔭` of `N` at the prime under `y` is free of the
same finite rank over `A_𝔭 / f A_𝔭`.

The equivalence is the composite of: the stalk of the given isomorphism of sheaves; the assumed
finite-free basis; and the identifications
`Stacks.Algebraization.exists_addEquiv_modulesStalk_complementTilde` of the stalk of `Ñ|_U` with
`N_𝔭` and `Stacks.Algebraization.stalkQuotientRingEquiv` of the two quotient rings. The first two
are linear over `𝒪_{U,y}`; the other two are semilinear over `pointStalkRingEquiv` and are used in
opposite directions, so the composite is linear over `A_𝔭`. -/
theorem exists_linearEquiv_localizedModule_of_free_stalk
    (S : AlgebraizationSituation.{u}) {f : S.A} (hI : S.I = Ideal.span {f})
    (N : ModuleCat.{u} S.A) (G : S.U.toScheme.Modules)
    (e0 : G ≅ (Stacks.LocalCohomology.complementTilde S.A S.a N : S.U.toScheme.Modules))
    (y : S.U.toScheme)
    (hfree : ∃ r : ℕ, Nonempty
      ((Stacks.ModuleSkyscraper.modulesStalkFunctor S.U.toScheme y).obj G
        ≃ₗ[S.U.toScheme.presheaf.stalk y]
        (Fin r → (S.U.toScheme.presheaf.stalk y ⧸
          IdealSheafData.stalk (idealOnOpen S) y ^ 1)))) :
    ∃ r : ℕ, Nonempty
      (LocalizedModule (underlyingPrime S y).asIdeal.primeCompl (N : Type u)
        ≃ₗ[Localization.AtPrime (underlyingPrime S y).asIdeal]
        (Fin r → (Localization.AtPrime (underlyingPrime S y).asIdeal ⧸
          (Ideal.span {f}).map (algebraMap S.A
            (Localization.AtPrime (underlyingPrime S y).asIdeal))))) := by
  obtain ⟨r, ⟨ψ⟩⟩ := hfree
  obtain ⟨e, he⟩ := exists_addEquiv_modulesStalk_complementTilde S N y
  set ρ := pointStalkRingEquiv S y with hρ
  set μ := ((Stacks.ModuleSkyscraper.modulesStalkFunctor S.U.toScheme y).mapIso e0).toLinearEquiv
    with hμ
  set θ : (Fin r → (S.U.toScheme.presheaf.stalk y ⧸
        IdealSheafData.stalk (idealOnOpen S) y ^ 1)) ≃+
      (Fin r → (Localization.AtPrime (underlyingPrime S y).asIdeal ⧸
        (Ideal.span {f}).map
          (algebraMap S.A (Localization.AtPrime (underlyingPrime S y).asIdeal)))) :=
    AddEquiv.piCongrRight fun _ => (stalkQuotientRingEquiv S y hI).toAddEquiv with hθ
  have hθsmul : ∀ (c : S.U.toScheme.presheaf.stalk y) v, θ (c • v) = ρ c • θ v := by
    intro c v
    funext i
    exact stalkQuotientRingEquiv_smul S y hI c (v i)
  refine ⟨r, ⟨{ __ := e.symm.trans (μ.symm.toAddEquiv.trans (ψ.toAddEquiv.trans θ))
                map_smul' := ?_ }⟩⟩
  intro d n
  have key := he (ρ.symm d) (e.symm n)
  rw [e.apply_symm_apply, RingEquiv.apply_symm_apply] at key
  have h1 : e.symm (d • n) = ρ.symm d • e.symm n := by
    rw [← key, e.symm_apply_apply]
  show θ (ψ (μ.symm (e.symm (d • n)))) = _
  rw [h1, map_smul, map_smul, hθsmul, RingEquiv.apply_symm_apply]
  rfl

end Stacks.Algebraization

end
