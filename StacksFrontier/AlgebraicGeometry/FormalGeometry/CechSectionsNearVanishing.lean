module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.FormalSectionsRealization
public import StacksFrontier.RingTheory.LocalCohomology.SectionsIso.CechHomology
public import StacksFrontier.RingTheory.LocalCohomology.SectionsIso.Naturality

/-!
# Sections of `M̃|_U` over `D(J)` are the degree-one Čech cocycles

Let `J ⊆ 𝔞` be ideals of a commutative ring `A`, let `U = Spec(A) ∖ V(𝔞)` and let
`g₁, …, g_r` generate `J`. The open `D(J) = Spec(A) ∖ V(J)` lies in `U`, and for every
`A`-module `M` the sections of `M̃|_U` over `D(J)`, read as an open of `U`, are the degree-one
cocycles of the extended Čech complex `C^•(g; M)`, naturally in `M`. A cocycle is a family of
fractions `mᵢ ∈ M_{gᵢ}` that agree on the overlaps, and such a family glues to a section over
`D(J) = ⋃ D(gᵢ)`.

In the proof of Stacks 0EIF this reads the sections of `F ≅ M̃|_U` on the open `V = D(J)`
produced by Stacks 0EFL as Čech cocycles, where the lifting statement of
`Stacks.LocalCohomology.exists_cycles_lift_of_isIso_homologyMap` applies.

## Main definitions

* `Stacks.Algebraization.sectionsComplementCechKerEquiv`: the sections of `M̃|_U` over `D(J)`
  are the kernel of the first Čech differential.
* `Stacks.Algebraization.sectionsComplementCechCyclesIso`: the same as a natural isomorphism of
  functors from `A`-modules to abelian groups, with the degree-one cocycles of `C^•(g; M)`.

## Main results

* `Stacks.Algebraization.sectionsComplementCechKerEquiv_naturality`: naturality in the module.

## References

* [Stacks Project, Tag 0EIF](https://stacks.math.columbia.edu/tag/0EIF)
* [Stacks Project, Tag 0A6Q](https://stacks.math.columbia.edu/tag/0A6Q)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.Algebraization

open Stacks.LocalCohomology

variable {A : Type u} [CommRing A] {a J : Ideal A} (hJ : J ≤ a) {r : ℕ} {g : Fin r → A}
  (hg : Ideal.span (Set.range g) = J)

include hJ in
/-- **`D(J)`, read as an open of `U = Spec(A) ∖ V(𝔞)`, has image `D(J)` in `Spec(A)`** when
`J ⊆ 𝔞`: the open `D(J)` lies in `U`. -/
theorem image_preimage_complementZeroLocus :
    (complementZeroLocus A a).ι ''ᵁ ((complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J) =
      (complementZeroLocus A J).ι ''ᵁ ⊤ := by
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
    Scheme.Opens.ι_image_top]
  exact inf_eq_right.2 fun x hx hxa => hx (PrimeSpectrum.zeroLocus_anti_mono hJ hxa)

variable (M : ModuleCat.{u} A)

include hg in
/-- **The sections of `M̃|_U` over `D(J)` are the degree-one Čech cocycles.** For `J ⊆ 𝔞`
generated by `g₁, …, g_r`, the sections over `D(J)`, an open of `U = Spec(A) ∖ V(𝔞)`, of the
restriction to `U` of the quasi-coherent module `M̃` are the kernel of the first differential
of the extended Čech complex `C^•(g; M)`.

It is the restriction along the equality of opens `image_preimage_complementZeroLocus` followed
by the comparison `Stacks.LocalCohomology.kerCechDOneEquivComplementGlobalSections` of the Čech
cocycles with the sections over `D(J)`. -/
def sectionsComplementCechKerEquiv :
    Γ((Scheme.Modules.restrictFunctor (complementZeroLocus A a).ι).obj
        ((tilde.functor (CommRingCat.of A)).obj M),
      (complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J) ≃+
      LinearMap.ker (_root_.Cech.cechD g (M : Type u) 1) :=
  ((moduleSectionsCongr M (image_preimage_complementZeroLocus hJ)).trans
    ((complementGlobalSectionsEquiv J M).trans
      (kerCechDOneEquivComplementGlobalSections J M g hg).symm)).toAddEquiv

/-- The value of the identification of `sectionsComplementCechKerEquiv` under the comparison of
the Čech cocycles with the sections over `D(J)`: the restriction along the equality of opens. -/
theorem kerCechDOneEquivComplementGlobalSections_sectionsComplementCechKerEquiv
    (s : Γ((Scheme.Modules.restrictFunctor (complementZeroLocus A a).ι).obj
        ((tilde.functor (CommRingCat.of A)).obj M),
      (complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J)) :
    kerCechDOneEquivComplementGlobalSections J M g hg (sectionsComplementCechKerEquiv hJ hg M s) =
      complementGlobalSectionsEquiv J M
        (moduleSectionsCongr M (image_preimage_complementZeroLocus hJ) s) :=
  LinearEquiv.apply_symm_apply _ _

/-- **The identification of the sections over `D(J)` with the Čech cocycles is natural in the
module.** -/
theorem sectionsComplementCechKerEquiv_naturality {M N : ModuleCat.{u} A} (h : M ⟶ N)
    (s : Γ((Scheme.Modules.restrictFunctor (complementZeroLocus A a).ι).obj
        ((tilde.functor (CommRingCat.of A)).obj M),
      (complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J)) :
    sectionsComplementCechKerEquiv hJ hg N
        (((Scheme.Modules.restrictFunctor (complementZeroLocus A a).ι).map
          ((tilde.functor (CommRingCat.of A)).map h)).app
            ((complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J) s) =
      kerCechDOneMap g h (sectionsComplementCechKerEquiv hJ hg M s) := by
  apply (kerCechDOneEquivComplementGlobalSections J N g hg).injective
  rw [kerCechDOneEquivComplementGlobalSections_naturality,
    kerCechDOneEquivComplementGlobalSections_sectionsComplementCechKerEquiv,
    kerCechDOneEquivComplementGlobalSections_sectionsComplementCechKerEquiv]
  rfl

/-- **The degree-one cocycles of `C^•(g; M)` are the kernel of the first Čech differential**,
naturally in `M`: the passage from integer to natural-number indexing followed by the comparison
of the cycles with the kernel. -/
def extendedCechCyclesOneIsoKer :
    (extendedCechComplex.{0} g M).cycles 1 ≅
      ModuleCat.of A (LinearMap.ker (_root_.Cech.cechD g (M : Type u) 1)) :=
  extendedCechCyclesOneIso.{0} g M ≪≫ cechCyclesOneIsoKer g M

/-- The isomorphism `extendedCechCyclesOneIsoKer` is natural in the module: it intertwines the map
on degree-one cycles induced by `h : M ⟶ N` with the map `kerCechDOneMap g h` on kernels. -/
theorem extendedCechCyclesOneIsoKer_hom_naturality {M N : ModuleCat.{u} A} (h : M ⟶ N)
    (z : (extendedCechComplex.{0} g M).cycles 1) :
    (extendedCechCyclesOneIsoKer N).hom
        (HomologicalComplex.cyclesMap (extendedCechComplexMap.{0} g h) 1 z) =
      kerCechDOneMap g h ((extendedCechCyclesOneIsoKer M).hom z) := by
  show (cechCyclesOneIsoKer g N).hom ((extendedCechCyclesOneIso.{0} g N).hom _) = _
  rw [extendedCechCyclesOneIso_hom_naturality]
  exact cechCyclesOneIsoKer_hom_naturality.{0} g h _

include hg in
/-- **The sections of `M̃|_U` over `D(J)` are the degree-one Čech cocycles, as a natural
isomorphism of functors to abelian groups.** For `J ⊆ 𝔞` generated by `g₁, …, g_r`, sections
over the open `D(J)` of `U = Spec(A) ∖ V(𝔞)` of the restriction of `M̃` to `U` are the
degree-one cocycles of the extended Čech complex `C^•(g; M)`, naturally in `M`. -/
def sectionsComplementCechCyclesIso :
    (tilde.functor (CommRingCat.of A) ⋙
        Scheme.Modules.restrictFunctor (complementZeroLocus A a).ι) ⋙
      sectionsAtFunctor ((complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J) ≅
    extendedCechFunctor.{0} g ⋙
      HomologicalComplex.cyclesFunctor (ModuleCat.{u} A) (ComplexShape.up ℤ) 1 ⋙
        forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u} :=
  NatIso.ofComponents
    (fun M => ((sectionsComplementCechKerEquiv hJ hg M).trans
      (extendedCechCyclesOneIsoKer M).toLinearEquiv.symm.toAddEquiv).toAddCommGrpIso)
    (fun {M N} h => by
      ext s
      change (extendedCechCyclesOneIsoKer N).toLinearEquiv.symm
          (sectionsComplementCechKerEquiv hJ hg N (((Scheme.Modules.restrictFunctor
            (complementZeroLocus A a).ι).map ((tilde.functor (CommRingCat.of A)).map h)).app
              ((complementZeroLocus A a).ι ⁻¹ᵁ complementZeroLocus A J) s)) =
        HomologicalComplex.cyclesMap (extendedCechComplexMap.{0} g h) 1
          ((extendedCechCyclesOneIsoKer M).toLinearEquiv.symm
            (sectionsComplementCechKerEquiv hJ hg M s))
      apply (extendedCechCyclesOneIsoKer N).toLinearEquiv.injective
      rw [LinearEquiv.apply_symm_apply, sectionsComplementCechKerEquiv_naturality]
      change _ = (extendedCechCyclesOneIsoKer N).hom _
      rw [extendedCechCyclesOneIsoKer_hom_naturality]
      congr 1
      exact ((extendedCechCyclesOneIsoKer M).toLinearEquiv.apply_symm_apply _).symm)

end Stacks.Algebraization

end
