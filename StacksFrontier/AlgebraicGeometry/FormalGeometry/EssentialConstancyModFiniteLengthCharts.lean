/-!
# Essential constancy modulo finite length, assembled from the charts of the punctured spectrum

`Stacks.Algebraization.IsEssentiallyConstantModFiniteLength` asks for a finite module `N` mapping
to the late terms of a direct system `(G_n)` of finite modules over a Noetherian local ring, with
kernels of finite length and with the images of the transition maps in the cokernels of finite
length. This file proves it from a statement about the images of the transition maps alone,
checked over finitely many charts `D(f_j)` of the punctured spectrum, which is the form in which
the last paragraph of the proof of [Stacks, Tag 0EHK] produces it.

## Main results

* `isFiniteLength_of_subsingleton_localizedAway` — finite length is detected on a finite cover of
  the punctured spectrum by basic opens.
* `Stacks.Algebraization.isEssentiallyConstantModFiniteLength_of_transitionImage` — from some
  index `a` on, the image of `G m` in `G n ⧸ im(G a → G n)` has finite length for `n ≫ m`.
* `Stacks.Algebraization.isEssentiallyConstantModFiniteLength_of_localizedAway` — the same, with
  the finite length checked one chart at a time.
* `Stacks.Algebraization.isEssentiallyConstantModFiniteLength_of_chart` — the same, with the
  stabilisation index chosen inside each chart and the images compared after localization.

## Implementation notes

`N` is the image of one transition map `G a → G (a + c)` at an index at which the kernels of the
transition maps out of `G a` have stabilised, so the approximating maps are injective. The
exchange of the stabilisation index with the chart is the sandwich of
`Stacks.Algebraization.exists_localized₀_range_transitionMap_eq_of_chart`.

## References

* [Stacks Project, Tag 0EHK](https://stacks.math.columbia.edu/tag/0EHK)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

/-- **Finite length is detected on a cover of the punctured spectrum.** Let `R` be a Noetherian
local ring whose maximal ideal is generated by a family `f`, and let `M` be a finite `R`-module
all of whose localizations `M[1/f i]` vanish. Then `M` has finite length: the basic opens
`D(f i)` cover the punctured spectrum, so the support of `M` is confined to the closed point. -/
public theorem isFiniteLength_of_subsingleton_localizedAway {R : Type*} [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] {M : Type*} [AddCommGroup M] [Module R M]
    [Module.Finite R M] {ι : Type*} (f : ι → R)
    (hf : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal R)
    (h : ∀ i : ι, Subsingleton (LocalizedModule.Away (f i) M)) :
    IsFiniteLength R M := by
  refine isFiniteLength_of_support_subset fun p hp => ?_
  rw [← zeroLocus_maximalIdeal, PrimeSpectrum.mem_zeroLocus, ← hf, SetLike.coe_subset_coe,
    Ideal.span_le]
  rintro - ⟨i, rfl⟩
  exact LocalizedModule.subsingleton_iff_support_subset.mp (h i) hp rfl

namespace Stacks.Algebraization

section Globalization

variable {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

omit [IsLocalRing A] in
/-- A submodule of a finite module over a Noetherian ring is finite. -/
private theorem finite_submodule {X : Type u} [AddCommGroup X] [Module A X] [Module.Finite A X]
    (P : Submodule A X) : Module.Finite A P :=
  Module.Finite.iff_fg.mpr (IsNoetherian.noetherian P)

omit [IsNoetherianRing A] [IsLocalRing A] in
/-- Dividing by a larger submodule produces a quotient of the quotient, so finite length is
inherited. -/
private theorem isFiniteLength_quotient_of_le {X : Type u} [AddCommGroup X] [Module A X]
    {P Q : Submodule A X} (h : P ≤ Q) (hP : IsFiniteLength A (X ⧸ P)) :
    IsFiniteLength A (X ⧸ Q) :=
  IsFiniteLength.of_surjective (f := Submodule.factor h) hP (Submodule.factor_surjective h)

omit [IsLocalRing A] in
/-- **The kernels of the transition maps out of one term stabilise.** The kernels of
`G a → G j` increase with `j` inside the finite module `G a`, so they are constant from some
index `a + c` on. Stated elementwise, at the indices `a + c + n` at which it is used, so that no
equality of indices has to be transported across the functor. -/
private theorem exists_ker_stabilizes (G : ℕ ⥤ ModuleCat.{u} A)
    (hfin : ∀ n : ℕ, Module.Finite A (G.obj n)) (a : ℕ) :
    ∃ c : ℕ, ∀ (j : ℕ), a + c ≤ j → ∀ (hj : a ≤ j) (x : G.obj a),
      (G.map (homOfLE hj)).hom x = 0 →
        (G.map (homOfLE (Nat.le_add_right a c))).hom x = 0 := by
  have hGa : Module.Finite A (G.obj a) := hfin a
  obtain ⟨c, hc⟩ := monotone_stabilizes_iff_noetherian.mpr
    (inferInstance : IsNoetherian A (G.obj a))
    ⟨fun c => LinearMap.ker (G.map (homOfLE (Nat.le_add_right a c))).hom, fun c c' h => by
      intro x hx
      rw [LinearMap.mem_ker] at hx ⊢
      rw [← directSystem_map_comp_apply G (Nat.le_add_right a c) (Nat.add_le_add_left h a)
        (Nat.le_add_right a c'), hx, map_zero]⟩
  refine ⟨c, ?_⟩
  rintro j hj hj' x hx
  obtain ⟨t, rfl⟩ : ∃ t : ℕ, j = a + t := ⟨j - a, by omega⟩
  have hmap : homOfLE hj' = homOfLE (Nat.le_add_right a t) := Subsingleton.elim _ _
  rw [hmap] at hx
  have hceq : LinearMap.ker (G.map (homOfLE (Nat.le_add_right a c))).hom =
      LinearMap.ker (G.map (homOfLE (Nat.le_add_right a t))).hom := hc t (by omega)
  rw [← LinearMap.mem_ker, hceq, LinearMap.mem_ker]
  exact hx

omit [IsLocalRing A] in
/-- **Essential constancy modulo finite length from the images of the transition maps alone.**
Let `G` be a direct system of finite modules over a Noetherian ring `A`, each annihilated by a
power of `I`. Suppose that from some index `a` on the later terms contribute nothing new
beyond the image of `G a`, up to finite length: for each `m ≥ a` and all `n ≫ m` the image of
`G m` in `G n ⧸ im(G a → G n)` has finite length. Then `G` is essentially constant modulo
modules of finite length.

This is the shape in which the last step of the source's proof of Stacks 0EHK can be fed, and
the reason to state it is that its hypothesis is a *local* condition while that of
`Stacks.Algebraization.isEssentiallyConstantModFiniteLength_of_support` is not. When `A` is
local, finite length of a finite module over `A` is containment of its support in the closed
point, so the hypothesis here may be verified one prime -- equivalently, by
`isFiniteLength_of_subsingleton_localizedAway`, one element of a generating family of `𝔪` -- at
a time, with no object defined over `A` as a whole. The hypothesis of
`Stacks.Algebraization.isEssentiallyConstantModFiniteLength_of_support`, by contrast, names a
finite `A`-module `L` receiving the whole system, and for `G` the system of the modules
`Ext^{-i}_A(M_n, ω_A^∙)` no such `L` exists: see the implementation notes of
`StacksFrontier.AlgebraicGeometry.FormalGeometry.LocalCohomologyMatlisDualModel`.

No local hypothesis is needed for the *kernels* of the approximating maps, which are zero here
rather than merely of finite length: `N` is taken to be the image of `G a → G (a + c)` for an
index `a + c` at which the kernels of the transition maps out of `G a` have stabilised, and an
element of `N` killed in a later term then comes from an element of `G a` already killed in
`G (a + c)`. -/
public theorem isEssentiallyConstantModFiniteLength_of_transitionImage
    (I : Ideal A) (G : ℕ ⥤ ModuleCat.{u} A)
    (hfin : ∀ n : ℕ, Module.Finite A (G.obj n))
    (hann : ∀ n : ℕ, ∃ k : ℕ, I ^ k • (⊤ : Submodule A (G.obj n)) = ⊥)
    (a : ℕ)
    (hstab : ∀ (m : ℕ) (hm : a ≤ m), ∃ k : ℕ, ∀ (n : ℕ) (hmn : m ≤ n), k ≤ n →
      IsFiniteLength A (LinearMap.range
        ((LinearMap.range (G.map (homOfLE (hm.trans hmn))).hom).mkQ ∘ₗ
          (G.map (homOfLE hmn)).hom))) :
    IsEssentiallyConstantModFiniteLength A I G := by
  obtain ⟨c, hc⟩ := exists_ker_stabilizes G hfin a
  have hab : a ≤ a + c := Nat.le_add_right a c
  have hGac : Module.Finite A (G.obj (a + c)) := hfin (a + c)
  have hcomp : ∀ (n : ℕ) (x : G.obj a),
      (G.map (homOfLE (Nat.le_add_right (a + c) n))).hom ((G.map (homOfLE hab)).hom x) =
        (G.map (homOfLE (show a ≤ a + c + n by omega))).hom x := fun n x =>
    directSystem_map_comp_apply G hab _ _ x
  refine ⟨ModuleCat.of A (LinearMap.range ((G.map (homOfLE hab)).hom)), a + c,
    fun n => (G.map (homOfLE (Nat.le_add_right (a + c) n))).hom ∘ₗ
      (LinearMap.range ((G.map (homOfLE hab)).hom)).subtype,
    finite_submodule _, ?_, ?_, ?_, ?_⟩
  · -- `N` is an image of `G a`, so a power of `I` annihilates it
    obtain ⟨k, hk⟩ := hann a
    refine ⟨k, le_antisymm ?_ bot_le⟩
    rw [Submodule.smul_le]
    intro r hr y _
    obtain ⟨x, hx⟩ := y.2
    have hrx : r • x = 0 := by
      have hmem := Submodule.smul_mem_smul hr (Submodule.mem_top (R := A) (x := x))
      rw [hk] at hmem
      exact (Submodule.mem_bot A).mp hmem
    have hsm : (G.map (homOfLE hab)).hom (r • x) = r • (G.map (homOfLE hab)).hom x :=
      map_smul _ r x
    refine (Submodule.mem_bot A).mpr (Subtype.ext ?_)
    change r • (y : G.obj (a + c)) = 0
    rw [← hx, ← hsm, hrx, map_zero]
  · -- compatibility with the transition maps
    intro m n h
    refine LinearMap.ext fun y => ?_
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply]
    exact directSystem_map_comp_apply G _ _ _ _
  · -- the approximating maps are injective, by the choice of `a + c`
    intro n
    have hzero : ∀ y : (LinearMap.ker ((G.map (homOfLE (Nat.le_add_right (a + c) n))).hom ∘ₗ
        (LinearMap.range ((G.map (homOfLE hab)).hom)).subtype) : Type u),
        ((y : LinearMap.range ((G.map (homOfLE hab)).hom)) : G.obj (a + c)) = 0 := by
      intro y
      obtain ⟨x, hx⟩ := y.1.2
      have hy0 : (G.map (homOfLE (Nat.le_add_right (a + c) n))).hom
          ((y.1 : G.obj (a + c))) = 0 := by
        have hmem := y.2
        rw [LinearMap.mem_ker, LinearMap.comp_apply] at hmem
        exact hmem
      have hx0 : (G.map (homOfLE (show a ≤ a + c + n by omega))).hom x = 0 := by
        rw [← hcomp, hx, hy0]
      rw [← hx]
      exact hc (a + c + n) (by omega) (by omega) x hx0
    have : Subsingleton (LinearMap.ker ((G.map (homOfLE (Nat.le_add_right (a + c) n))).hom ∘ₗ
        (LinearMap.range ((G.map (homOfLE hab)).hom)).subtype) : Type u) :=
      ⟨fun y z => Subtype.ext (Subtype.ext (by rw [hzero y, hzero z]))⟩
    exact IsFiniteLength.of_subsingleton
  · -- the images in the cokernels, which is the hypothesis at the shifted index
    intro m
    obtain ⟨k, hk⟩ := hstab (a + c + m) (by omega)
    refine ⟨k, fun n hmn hkn => ?_⟩
    have hrange : LinearMap.range ((G.map (homOfLE (Nat.le_add_right (a + c) n))).hom ∘ₗ
        (LinearMap.range ((G.map (homOfLE hab)).hom)).subtype) =
      LinearMap.range (G.map (homOfLE (show a ≤ a + c + n by omega))).hom := by
      rw [LinearMap.range_comp, Submodule.range_subtype, ← LinearMap.range_comp]
      exact congrArg _ (LinearMap.ext (hcomp n))
    rw [hrange]
    exact hk (a + c + n) (Nat.add_le_add_left hmn (a + c)) (by omega)

/-- **Essential constancy modulo finite length, assembled from finitely many localizations.**
The hypothesis of `Stacks.Algebraization.isEssentiallyConstantModFiniteLength_of_transitionImage`
checked over the localizations `A_{f j}` at a finite generating family `f` of `𝔪`: what has to
die over `A_{f j}`, for each `j` and all `n ≫ m`, is the image of `G m` in
`G n ⧸ im(G a → G n)`.

This is the shape in which the source of Stacks 0EHK assembles its conclusion over `A` out of
the statements it proves over the completions of the localizations `A_f`, and the two inputs the
assembly needs are both here: the cover of the punctured spectrum by the `D(f j)`, used through
`isFiniteLength_of_subsingleton_localizedAway`, and the finiteness of the family, used to make
one index `k` serve every `j` at once. Nothing in between is needed, because the index `a` is
quantified outside the choice of `j`: no object over `A` is required to compare the charts. -/
public theorem isEssentiallyConstantModFiniteLength_of_localizedAway
    (I : Ideal A) (G : ℕ ⥤ ModuleCat.{u} A)
    (hfin : ∀ n : ℕ, Module.Finite A (G.obj n))
    (hann : ∀ n : ℕ, ∃ k : ℕ, I ^ k • (⊤ : Submodule A (G.obj n)) = ⊥)
    {r : ℕ} (f : Fin r → A) (hf : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (a : ℕ)
    (hloc : ∀ (m : ℕ) (hm : a ≤ m) (j : Fin r), ∃ k : ℕ, ∀ (n : ℕ) (hmn : m ≤ n), k ≤ n →
      Subsingleton (LocalizedModule.Away (f j)
        (LinearMap.range ((LinearMap.range (G.map (homOfLE (hm.trans hmn))).hom).mkQ ∘ₗ
          (G.map (homOfLE hmn)).hom) : Type u))) :
    IsEssentiallyConstantModFiniteLength A I G := by
  refine isEssentiallyConstantModFiniteLength_of_transitionImage I G hfin hann a fun m hm => ?_
  choose k hk using fun j : Fin r => hloc m hm j
  refine ⟨Finset.univ.sup k, fun n hmn hkn => ?_⟩
  have : Module.Finite A (G.obj n) := hfin n
  have : Module.Finite A ((G.obj n : Type u) ⧸
      LinearMap.range (G.map (homOfLE (hm.trans hmn))).hom) :=
    Module.Finite.of_surjective _ (Submodule.mkQ_surjective _)
  have := finite_submodule (LinearMap.range
    ((LinearMap.range (G.map (homOfLE (hm.trans hmn))).hom).mkQ ∘ₗ (G.map (homOfLE hmn)).hom))
  exact isFiniteLength_of_subsingleton_localizedAway f hf
    fun j => hk j n hmn (le_trans (Finset.le_sup (Finset.mem_univ j)) hkn)


/-- **Essential constancy modulo finite length from the charts, with each chart's own
stabilisation index.** Let `G` be a direct system of finite modules over a Noetherian local ring
`A`, each annihilated by a power of `I`, and let `f` be a finite family generating the maximal
ideal. Suppose that for each chart `D(f j)` there is an index `a` such that for all `n ≫ m ≥ a`
the images of the transition maps `G m → G n` and `G a → G n` have the same localization away
from `f j`. Then `G` is essentially constant modulo modules of finite length. -/
public theorem isEssentiallyConstantModFiniteLength_of_chart
    (I : Ideal A) (G : ℕ ⥤ ModuleCat.{u} A)
    (hfin : ∀ n : ℕ, Module.Finite A (G.obj n))
    (hann : ∀ n : ℕ, ∃ k : ℕ, I ^ k • (⊤ : Submodule A (G.obj n)) = ⊥)
    {r : ℕ} (f : Fin r → A) (hf : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (himg : ∀ j : Fin r, ∃ a : ℕ, ∀ (m : ℕ) (hm : a ≤ m), ∃ k : ℕ,
      ∀ (n : ℕ) (hmn : m ≤ n), k ≤ n →
        Submodule.localized₀ (Submonoid.powers (f j))
            (LocalizedModule.mkLinearMap (Submonoid.powers (f j)) (G.obj n))
            (LinearMap.range (G.map (homOfLE hmn)).hom) =
          Submodule.localized₀ (Submonoid.powers (f j))
            (LocalizedModule.mkLinearMap (Submonoid.powers (f j)) (G.obj n))
            (LinearMap.range (G.map (homOfLE (hm.trans hmn))).hom)) :
    IsEssentiallyConstantModFiniteLength A I G := by
  obtain ⟨a, ha⟩ := exists_localized₀_range_transitionMap_eq_of_chart G f himg
  refine isEssentiallyConstantModFiniteLength_of_localizedAway I G hfin hann f hf a
    fun m hm j => ?_
  obtain ⟨k, hk⟩ := ha m hm j
  exact ⟨k, fun n hmn hkn => subsingleton_localizedAway_transitionImage G (f j) (hm.trans hmn)
    hmn (hk n hmn hkn)⟩

end Globalization

end Stacks.Algebraization

