module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.IdealSheafSiteSubmodule
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.SheafifiedCechFiniteType
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SiteCoherenceKernels
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SiteFiniteTypeBridge
public import Mathlib.AlgebraicGeometry.Noetherian

/-!
# A quasi-coherent ideal sheaf of a locally Noetherian scheme is of finite type

Let `X` be a locally Noetherian scheme and `I : X.IdealSheafData` a quasi-coherent sheaf of
ideals. `Stacks.Algebraization.idealSheafSiteSubmodule` reads `I` as a sheaf of ideals `ℐ ⊂ 𝒪_X`
of the small Zariski ringed site of `X`. This file proves that `ℐ` is **of finite type** in the
sense of `SheafOfModules.IsFiniteType`, which is the hypothesis of [Stacks, Tag 099F]
(`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete`), so that the derived
completion functor `(-)^∧` along `ℐ` exists for an arbitrary quasi-coherent sheaf of ideals of a
locally Noetherian scheme.

## Main results

* `Stacks.Algebraization.generates_idealSheafSiteSection` — on an affine open `U`, generators of
  the ideal `I(U) ⊂ Γ(X, U)` generate `ℐ` in the sectionwise sense of
  `PresheafOfModules.Generates`.
* `Stacks.Algebraization.isFiniteType_idealSheafSiteSubmodule` — **`ℐ` is of finite type.**
* `Stacks.Algebraization.exists_eq_idealOfGlobalSections_overIdeal_affine` — on an affine open
  `U`, `ℐ|_U` is the sheaf of ideals of the slice site generated by finitely many global
  sections of `𝒪_U`. This is the hypothesis `hgen` of [Stacks, Tag 0CQI]
  (`AlgebraicGeometry.RingedSite.nonempty_iso_derivedSectionsOverObject_derivedCompletion`) and
  of [Stacks, Tag 0A0E] at a finite-type ideal sheaf, at an *affine* open rather than at an
  unspecified member of a covering family.

## The argument

Everything rests on one Mathlib lemma, `AlgebraicGeometry.Scheme.IdealSheafData.map_ideal`: for
affine opens `V ≤ U` the ideal `I(V)` is generated by the image of `I(U)` under restriction. So
if `g_1, …, g_n` generate `I(U)` — which a Noetherian `Γ(X, U)` provides — then their
restrictions generate `I(V)` for **every** affine open `V ≤ U`, and that is the sectionwise
generation condition, the affine opens inside a given open being a basis of it.

Mathlib's categorical finite-type condition then follows from the sectionwise one by
`SheafOfModules.isFiniteType_of_presheaf_isFiniteType`, and the sectionwise one is assembled
over the covering family of affine opens by
`Stacks.SheafOfModules.isFiniteType_presheaf_of_coversTop`.

## Implementation notes

The sections of the unit sheaf of modules of the ringed site over an open are the sections of
`𝒪_X` there, and its restriction maps are those of `X.presheaf`, both definitionally; the
statements below are therefore written with `X.presheaf.map` and the subtype projection, which
is the spelling the ideals of an `IdealSheafData` live in.

The covering sieve witnessing the generation condition is `CategoryTheory.Sieve.ofObjects` on
the affine opens contained in the given open, so that no sieve has to be built by hand: an
arrow of that sieve factors through an affine open, where the ideal is computed, and the
representation is then restricted along the factorisation.

## References

* [Stacks Project, Tag 099F](https://stacks.math.columbia.edu/tag/099F)
* [Stacks Project, Tag 0CQI](https://stacks.math.columbia.edu/tag/0CQI)
* [Stacks Project, Tag 01XZ](https://stacks.math.columbia.edu/tag/01XZ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace Stacks.Algebraization

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- A section of `𝒪_X` over an affine open which lies in the ideal, read as a section of the
sheaf of ideals of the ringed site. -/
def idealSheafSiteSection (U : X.affineOpens) (g : Γ(X, U.1)) (hg : g ∈ I.ideal U) :
    (idealSheafSiteSubmodule I).toSheafOfModules.val.obj (op U.1) :=
  ⟨g, (mem_idealSheafSiteSubmodule_obj_affine I U g).2 hg⟩

/-- The value of a section of the sheaf of ideals over an affine open lies in the ideal there. -/
theorem val_mem_ideal_of_idealSheafSiteSubmodule (A : X.affineOpens)
    (t : (idealSheafSiteSubmodule I).toSheafOfModules.val.obj (op A.1)) :
    (t.1 : Γ(X, A.1)) ∈ I.ideal A :=
  (mem_idealSheafSiteSubmodule_obj_affine I A _).1 t.2

/-- **On an affine open inside an affine open, the ideal is generated by the restrictions of
generators upstairs.** This is `AlgebraicGeometry.Scheme.IdealSheafData.map_ideal` together with
`Ideal.map_span`. -/
theorem ideal_eq_span_restrict {n : ℕ} (U V : X.affineOpens) (hVU : V.1 ≤ U.1)
    (g : Fin n → Γ(X, U.1)) (hspan : Ideal.span (Set.range g) = I.ideal U) :
    I.ideal V =
      Ideal.span (Set.range fun i => (X.presheaf.map (homOfLE hVU).op).hom (g i)) := by
  have h : (I.ideal U).map (X.presheaf.map (homOfLE hVU).op).hom = I.ideal V :=
    I.map_ideal (U := V) (V := U) hVU
  rw [← h, ← hspan, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **A section of the ideal over an affine open is a linear combination of the restrictions of
generators of the ideal over a larger affine open.** -/
theorem exists_sum_eq_of_mem_ideal {n : ℕ} (U A : X.affineOpens) (hAU : A.1 ≤ U.1)
    (g : Fin n → Γ(X, U.1)) (hspan : Ideal.span (Set.range g) = I.ideal U)
    (x : Γ(X, A.1)) (hx : x ∈ I.ideal A) :
    ∃ a : Fin n → Γ(X, A.1),
      ∑ i, a i * (X.presheaf.map (homOfLE hAU).op).hom (g i) = x := by
  rw [ideal_eq_span_restrict I U A hAU g hspan] at hx
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hx
  exact ⟨a, by simpa only [smul_eq_mul] using ha⟩

/-- **A combination identity at the level of `𝒪_X` is one in the sheaf of ideals.** The sections
of the sheaf of ideals over an open are a submodule of those of `𝒪_X`, so an identity between
their values is an identity between them. -/
theorem sum_smul_restrict_eq (U : X.affineOpens) {n : ℕ}
    (g : Fin n → Γ(X, U.1)) (hg : ∀ i, g i ∈ I.ideal U)
    {V W : X.Opens} (φ : W ⟶ U.1) (ψ : W ⟶ V)
    (t : (idealSheafSiteSubmodule I).toSheafOfModules.val.obj (op V))
    (a : Fin n → (((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)).obj.obj (op W)))
    (ha : ∑ i, a i •
        ((idealSheafSiteSubmodule I).toSheafOfModules.val.restrictₛₗ φ.op
          (idealSheafSiteSection I U (g i) (hg i))).1 =
      ((idealSheafSiteSubmodule I).toSheafOfModules.val.restrictₛₗ ψ.op t).1) :
    ∑ i, a i • (idealSheafSiteSubmodule I).toSheafOfModules.val.restrictₛₗ φ.op
        (idealSheafSiteSection I U (g i) (hg i)) =
      (idealSheafSiteSubmodule I).toSheafOfModules.val.restrictₛₗ ψ.op t := by
  refine Subtype.ext ?_
  refine Eq.trans (AddSubmonoidClass.coe_finsetSum _ Finset.univ) ?_
  exact Eq.trans (Finset.sum_congr rfl fun i _ => rfl) ha

/-- **Generators of the ideal on an affine open generate the sheaf of ideals sectionwise.**

The witnessing covering sieve is the one generated by the affine opens contained in the given
open. An arrow of that sieve factors through such an affine open `A`; over `A` the section is a
combination of the restricted generators, by
`Stacks.Algebraization.exists_sum_eq_of_mem_ideal`, and restricting that identity along the
factorisation gives the required combination. -/
theorem generates_idealSheafSiteSection (U : X.affineOpens) {n : ℕ}
    (g : Fin n → Γ(X, U.1)) (hg : ∀ i, g i ∈ I.ideal U)
    (hspan : Ideal.span (Set.range g) = I.ideal U) :
    PresheafOfModules.Generates (Stacks.SheafOfModules.opensRingedSite X.sheaf).J
      (idealSheafSiteSubmodule I).toSheafOfModules.val
      (fun i => idealSheafSiteSection I U (g i) (hg i)) := by
  classical
  intro V f t
  refine ⟨Sieve.ofObjects (fun A : {A : X.affineOpens // A.1 ≤ V} => A.1.1) V, ?_, ?_⟩
  · intro x hx
    obtain ⟨W, hWaff, hxW, hWV⟩ := (Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hx
    exact ⟨W, homOfLE hWV, ⟨⟨⟨W, hWaff⟩, hWV⟩, ⟨𝟙 W⟩⟩, hxW⟩
  · intro W h hh
    obtain ⟨⟨A, hAV⟩, ⟨k⟩⟩ := (Sieve.mem_ofObjects_iff _ h).1 hh
    have hmemA : (X.presheaf.map (homOfLE hAV).op).hom (t.1 : Γ(X, V)) ∈ I.ideal A :=
      (mem_idealSheafSiteSubmodule_obj_affine I A _).1
        ((idealSheafSiteSubmodule I).map (homOfLE hAV).op t.2)
    obtain ⟨a, ha⟩ := exists_sum_eq_of_mem_ideal I U A (le_trans hAV f.le) g hspan _ hmemA
    refine ⟨fun i => (X.presheaf.map k.op).hom (a i), ?_⟩
    refine sum_smul_restrict_eq I U g hg (h ≫ f) h t _ ?_
    have e : ∀ {B : X.Opens} (p : A.1 ⟶ B) (r : W ⟶ B),
        X.presheaf.map p.op ≫ X.presheaf.map k.op = X.presheaf.map r.op := fun p r => by
      rw [← X.presheaf.map_comp]
      exact congrArg X.presheaf.map (Quiver.Hom.unop_inj (Subsingleton.elim _ _))
    have hres := congrArg (X.presheaf.map k.op).hom ha
    rw [map_sum] at hres
    have hΓ : ∑ i, (X.presheaf.map k.op).hom (a i) *
          (X.presheaf.map (h ≫ f).op).hom (g i) =
        (X.presheaf.map h.op).hom (t.1 : Γ(X, V)) := by
      refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) (hres.trans ?_)
      · rw [map_mul, ← CommRingCat.comp_apply, e]
      · exact (CommRingCat.comp_apply _ _ _).symm.trans
          (congrArg (fun m => (CommRingCat.Hom.hom m) (t.1 : Γ(X, V))) (e (homOfLE hAV) h))
    exact hΓ

/-- **The affine opens of a scheme cover its small Zariski site.** -/
theorem coversTop_affineOpens :
    (Stacks.SheafOfModules.opensRingedSite X.sheaf).J.CoversTop
      (fun U : X.affineOpens => U.1) := by
  intro Z x hx
  obtain ⟨W, hWaff, hxW, hWZ⟩ := (Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hx
  exact ⟨W, homOfLE hWZ, ⟨⟨W, hWaff⟩, ⟨𝟙 W⟩⟩, hxW⟩

/-- Finitely many generators of the ideal over an affine open of a locally Noetherian scheme. -/
theorem exists_fin_generators_ideal [IsLocallyNoetherian X] (U : X.affineOpens) :
    ∃ (n : ℕ) (g : Fin n → Γ(X, U.1)), Ideal.span (Set.range g) = I.ideal U := by
  have := IsLocallyNoetherian.component_noetherian U
  exact Submodule.fg_iff_exists_fin_generating_family.1 (IsNoetherian.noetherian (I.ideal U))

/-- **A quasi-coherent sheaf of ideals of a locally Noetherian scheme is of finite type**, in the
sectionwise sense of `PresheafOfModules.IsFiniteType`. -/
theorem presheaf_isFiniteType_idealSheafSiteSubmodule [IsLocallyNoetherian X] :
    PresheafOfModules.IsFiniteType (Stacks.SheafOfModules.opensRingedSite X.sheaf).J
      (idealSheafSiteSubmodule I).toSheafOfModules.val := by
  refine Stacks.SheafOfModules.isFiniteType_presheaf_of_coversTop
    (fun U : X.affineOpens => U.1) coversTop_affineOpens fun U => ?_
  obtain ⟨n, g, hspan⟩ := exists_fin_generators_ideal I U
  have hg : ∀ i, g i ∈ I.ideal U := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  exact ⟨n, _, generates_idealSheafSiteSection I U g hg hspan⟩

/-- **A quasi-coherent sheaf of ideals of a locally Noetherian scheme is of finite type**, in
Mathlib's sense — the hypothesis of [Stacks, Tag 099F]. -/
instance isFiniteType_idealSheafSiteSubmodule [IsLocallyNoetherian X] :
    (idealSheafSiteSubmodule I).toSheafOfModules.IsFiniteType :=
  SheafOfModules.isFiniteType_of_presheaf_isFiniteType _
    (presheaf_isFiniteType_idealSheafSiteSubmodule I)

/-- **On an affine open of a locally Noetherian scheme the sheaf of ideals is generated by
finitely many global sections of the structure sheaf of the slice.**

This is the hypothesis `hgen` of [Stacks, Tag 0CQI] and of [Stacks, Tag 0A0E] at a finite-type
ideal sheaf, available at an affine open and not merely at some member of a covering family. -/
theorem exists_eq_idealOfGlobalSections_overIdeal_affine [IsLocallyNoetherian X]
    (U : X.affineOpens) :
    ∃ (n : ℕ) (g : Fin n → Γ(X, U.1)) (_hg : ∀ i, g i ∈ I.ideal U),
      Ideal.span (Set.range g) = I.ideal U ∧
        RingedSite.overIdeal (idealSheafSiteSubmodule I) U.1 =
          RingedSite.idealOfGlobalSections
            ((Stacks.SheafOfModules.opensRingedSite X.sheaf).over U.1)
            (fun i => RingedSite.globalSectionOfSection
              (Stacks.SheafOfModules.opensRingedSite X.sheaf) U.1 (g i)) := by
  obtain ⟨n, g, hspan⟩ := exists_fin_generators_ideal I U
  have hg : ∀ i, g i ∈ I.ideal U := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  refine ⟨n, g, hg, hspan, ?_⟩
  exact RingedSite.overIdeal_eq_idealOfGlobalSections_of_generates
    (Stacks.SheafOfModules.opensRingedSite X.sheaf) U.1 (idealSheafSiteSubmodule I)
    (fun i => idealSheafSiteSection I U (g i) (hg i))
    (generates_idealSheafSiteSection I U g hg hspan)

end Stacks.Algebraization

end
