@[stacks 0A0K "part (1), `K^∧ = R lim (K ⊗^𝐋_𝒪 𝒪/𝓘ⁿ)`, at the source's own hypotheses: on a \
locally Noetherian scheme `Y`, for an **arbitrary** quasi-coherent sheaf of ideals `𝓘` and an \
**arbitrary** object `K` of `D(𝒪_Y)`, the derived completion `K^∧` along `𝓘` (the reflector of \
Tag 099F) is a derived limit of the tower `n ↦ K ⊗^𝐋_{𝒪_Y} 𝒪_Y/𝓘ⁿ⁺¹`. No quasi-compactness of \
`Y` and no generation of `𝓘` by global sections is assumed. `R lim` is a predicate rather than a \
functor, so the source's equality is read as `K^∧` being a derived limit of that tower, the same \
reading as the tag's part (4); the tower over the positive powers `𝓘ⁿ⁺¹` is cofinal in the one \
over all powers"]
theorem isDerivedLimit_adicReductionTower_derivedCompletion
    (K : DerivedCategory (_root_.SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite Y.sheaf).O)))) :
    IsDerivedLimit
      (adicReductionTower (Stacks.SheafOfModules.opensRingedSite Y.sheaf)
        (idealSheafSiteSubmodule 𝓘) K)
      ((derivedCompletion (Stacks.SheafOfModules.opensRingedSite Y.sheaf)
        (idealSheafSiteSubmodule 𝓘)).obj K) := by
  set X := Stacks.SheafOfModules.opensRingedSite Y.sheaf
  set I := idealSheafSiteSubmodule 𝓘
  obtain ⟨Kt, hKt, ⟨e⟩⟩ := Stacks.SheafOfModules.Tensor.exists_kFlat_representative X K
  have hpres := fun V : Y.affineOpens ↦
    exists_isDerivedLimitWithProjections_map_kInjectiveAdicMilnorObj X I Kt hKt V.1
  have hL' : ∀ V : Y.affineOpens, IsDerivedComplete (X.over V.1) (overIdeal I V.1)
      ((_root_.SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        V.1).mapDerivedCategory.obj (kInjectiveAdicMilnorObj X I Kt)) := fun V ↦ by
    obtain ⟨π', hπ', -⟩ := hpres V
    exact isDerivedComplete_of_isDerivedLimit (X.over V.1) _ _ _ hπ'.isDerivedLimit
      fun n ↦ isDerivedComplete_derivedTensor_adicQuotient (X.over V.1) _ _ (n + 1)
  refine isDerivedLimit_derivedCompletion_adicReductionTower_of_coversTop_slice X I Kt hKt e
    (coversTop_affineOpens (X := Y)) hL' fun V ↦ ?_
  obtain ⟨r, g, hgen⟩ := Stacks.KoszulProZero.exists_eq_generatedIdealSheaf_overIdeal_affine Y 𝓘 V
  obtain ⟨π', hπ', hu⟩ := hpres V
  have hco : _root_.SheafOfModules.IsCoherent
      (show Y.Modules from
        _root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :=
    Stacks.AlgebraicGeometry.CoherentTFAE.isCoherent_unit Y
  have : (ObjectProperty.ι (IsDerivedComplete (X.over V.1) (overIdeal I V.1))).IsRightAdjoint :=
    isRightAdjoint_ι_isDerivedComplete_overIdeal X I V.1
  exact isIso_pinnedAdicComparison_of_exists_factor (X.over V.1)
    (fun i ↦ globalSectionOfSection X V.1 (g i))
    (fun n p hp ↦ Stacks.KoszulProZero.exists_koszulDualSystemOn_over_homologyMap_eq_zero_of_section
      Y (show Y.Modules from
        _root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) V g n p hp)
    _ (overIdeal I V.1) hgen (hL' V) _ hπ' hu

