module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.AdicQuotientSystem
public import StacksFrontier.AlgebraicGeometry.IdealPowerSections.CompatibleFractions
public import StacksFrontier.Homology.DerivedCategory.InverseSystem.ProIsomorphismInterleaving
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The quotient tower by the powers of the generators is pro-isomorphic to the adic quotient tower

Let `X` be a scheme, let `a₁, …, a_r` be global sections of `𝒪_X` and let `ℐ ⊂ 𝒪_X` be the
quasi-coherent sheaf of ideals they generate. For a sheaf of modules `ℱ` there are two towers of
quotients of `ℱ` in play: the adic one `n ↦ ℱ / ℐⁿℱ`, which is
`Stacks.Algebraization.adicQuotientSystem`, and the one by the subsheaves generated by the
`n`-th powers of the generators, `n ↦ ℱ / (a₁ⁿ, …, a_rⁿ)ℱ`. This file proves that the two are
isomorphic as pro-objects, using the containments `ℐ^{rn+1} ⊆ (a₁ⁿ, …, a_rⁿ) ⊆ ℐⁿ` of sheaves of
ideals.

## Main definitions

* `Stacks.Algebraization.affineLocalMultiple` — the least subsheaf of `ℳ` containing
  `𝔞(U) · Γ(ℳ, U)` on every affine open `U`, for an arbitrary affine-local family of ideals `𝔞`.
  `Stacks.Algebraization.idealPowerMultiple` is the case `𝔞 U = ℐ(U)ⁿ`.
* `Stacks.Algebraization.globalRes` — the restriction of a global section of `𝒪_X` to an affine
  open.
* `Stacks.Algebraization.globalSpanIdeals` — the affine-local family `U ↦ (a₁ⁿ|_U, …, a_rⁿ|_U)`.
* `Stacks.Algebraization.globalSpanMultiple` — the subsheaf `(a₁ⁿ, …, a_rⁿ)ℱ`.
* `Stacks.Algebraization.submoduleQuotientSystem` — the tower of quotients of a module by an
  antitone family of subsheaves, of which `adicQuotientSystem` is an instance.
* `Stacks.Algebraization.globalSpanQuotientSystem` — the tower `n ↦ ℱ / (a₁ⁿ, …, a_rⁿ)ℱ`.
* `Stacks.Algebraization.globalSectionsIdealSheafData` — the quasi-coherent sheaf of ideals
  generated by finitely many global sections, as `Scheme.IdealSheafData`.

## Main results

* `Stacks.Algebraization.quotientInterleaving` — interleaved maps between the quotient towers of
  two antitone families of subsheaves that interleave.
* `Stacks.Algebraization.proIso_globalSpanQuotientSystem_adicQuotientSystem` — the two quotient
  towers are pro-isomorphic, for an ideal sheaf generated by `r` global sections.
* `Stacks.Algebraization.proIso_globalSpanQuotientSystem_adicQuotientSystem_globalSections` —
  the same with no hypothesis, at the sheaf of ideals the sections generate.

## References

* [Stacks Project, Tag 0A0E](https://stacks.math.columbia.edu/tag/0A0E)
* [Stacks Project, Tag 0A0K](https://stacks.math.columbia.edu/tag/0A0K)
* [Stacks Project, Tag 0921](https://stacks.math.columbia.edu/tag/0921)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open InverseSequence

universe u

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

namespace Stacks.Algebraization

variable {X : Scheme.{u}}

/-! ### Multiples of a sheaf of modules by an affine-local family of ideals -/

/-- The subsheaf `𝔞 ℳ` of a sheaf of modules, for an affine-local family of ideals `𝔞`: the least
subsheaf which on every affine open `U` contains `𝔞(U) · Γ(ℳ, U)`. -/
def affineLocalMultiple (𝔞 : ∀ U : X.affineOpens, Ideal Γ(X, U)) (M : X.Modules) : M.Submodule :=
  sInf { N | ∀ U : X.affineOpens,
    𝔞 U • (⊤ : Submodule Γ(X, U) Γ(M, U)) ≤ N.toSubmodule.obj (op U.1) }

/-- The affine-local universal property characterising `affineLocalMultiple`. -/
theorem affineLocalMultiple_le_iff (𝔞 : ∀ U : X.affineOpens, Ideal Γ(X, U)) (M : X.Modules)
    (N : M.Submodule) :
    affineLocalMultiple 𝔞 M ≤ N ↔
      ∀ U : X.affineOpens,
        𝔞 U • (⊤ : Submodule Γ(X, U) Γ(M, U)) ≤ N.toSubmodule.obj (op U.1) := by
  refine ⟨fun h U ↦ ?_, fun h ↦ sInf_le h⟩
  have hgen : 𝔞 U • (⊤ : Submodule Γ(X, U) Γ(M, U)) ≤
      (affineLocalMultiple 𝔞 M).toSubmodule.obj (op U.1) := by
    change _ ≤ (sInf ((fun P : M.Submodule ↦ P.toSubmodule) ''
      {P : M.Submodule | ∀ V : X.affineOpens,
        𝔞 V • (⊤ : Submodule Γ(X, V) Γ(M, V)) ≤ P.toSubmodule.obj (op V.1)})).obj (op U.1)
    rw [PresheafOfModules.Submodule.sInf_obj]
    refine le_iInf₂ fun P hP ↦ ?_
    obtain ⟨Q, hQ, rfl⟩ := hP
    exact hQ U
  exact hgen.trans (h (op U.1))

/-- The ideal-power multiple is the affine-local multiple by the powers of the ideal sheaf. -/
theorem idealPowerMultiple_eq_affineLocalMultiple (I : X.IdealSheafData) (n : ℕ)
    (M : X.Modules) :
    idealPowerMultiple I n M = affineLocalMultiple (fun U => I.ideal U ^ n) M :=
  rfl

/-- A containment of affine-local families of ideals gives a containment of the subsheaves they
cut out. -/
theorem affineLocalMultiple_mono {𝔞 𝔟 : ∀ U : X.affineOpens, Ideal Γ(X, U)}
    (h : ∀ U, 𝔞 U ≤ 𝔟 U) (M : X.Modules) :
    affineLocalMultiple 𝔞 M ≤ affineLocalMultiple 𝔟 M :=
  (affineLocalMultiple_le_iff _ _ _).2 fun U ↦
    (Submodule.smul_mono_left (h U)).trans ((affineLocalMultiple_le_iff 𝔟 M _).1 le_rfl U)

/-! ### The subsheaf generated by the powers of finitely many global sections -/

/-- The restriction of a global section of the structure sheaf to an affine open. -/
def globalRes (U : X.affineOpens) (s : Γ(X, ⊤)) : Γ(X, U) :=
  (X.presheaf.map (homOfLE (le_top (a := U.1))).op).hom s

/-- Restricting a global section to a smaller affine open is restricting the restriction. -/
theorem globalRes_res {U V : X.affineOpens} (h : U.1 ≤ V.1) (s : Γ(X, ⊤)) :
    (X.presheaf.map (homOfLE h).op).hom (globalRes V s) = globalRes U s := by
  have he : ((homOfLE (le_top (a := V.1))).op ≫ (homOfLE h).op) =
      (homOfLE (le_top (a := U.1))).op := Subsingleton.elim _ _
  rw [globalRes, globalRes, ← CommRingCat.comp_apply, ← X.presheaf.map_comp, he]

/-- The affine-local family of ideals generated by the `n`-th powers of `a₁, …, a_r`. -/
def globalSpanIdeals {r : ℕ} (a : Fin r → Γ(X, ⊤)) (n : ℕ) :
    ∀ U : X.affineOpens, Ideal Γ(X, U) :=
  fun U ↦ Ideal.span (Set.range fun i ↦ globalRes U (a i) ^ n)

/-- The subsheaf `(a₁ⁿ, …, a_rⁿ)ℱ` of a sheaf of modules. -/
def globalSpanMultiple {r : ℕ} (a : Fin r → Γ(X, ⊤)) (n : ℕ) (M : X.Modules) : M.Submodule :=
  affineLocalMultiple (globalSpanIdeals a n) M

/-- Higher powers of the generators span smaller ideals. -/
theorem globalSpanIdeals_antitone {r : ℕ} (a : Fin r → Γ(X, ⊤)) {n m : ℕ} (h : n ≤ m)
    (U : X.affineOpens) : globalSpanIdeals a m U ≤ globalSpanIdeals a n U := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  exact Ideal.pow_mem_of_pow_mem _ (Ideal.subset_span ⟨i, rfl⟩) h

/-- Higher powers of the generators cut out smaller subsheaves. -/
theorem globalSpanMultiple_antitone {r : ℕ} (a : Fin r → Γ(X, ⊤)) (M : X.Modules) {n m : ℕ}
    (h : n ≤ m) : globalSpanMultiple a m M ≤ globalSpanMultiple a n M :=
  affineLocalMultiple_mono (globalSpanIdeals_antitone a h) M

/-- `(a₁ⁿ, …, a_rⁿ)ℱ ⊆ ℐⁿℱ` whenever each `a_i` is a section of `ℐ`. -/
theorem globalSpanMultiple_le_idealPowerMultiple {r : ℕ} (a : Fin r → Γ(X, ⊤))
    (I : X.IdealSheafData) (hmem : ∀ (U : X.affineOpens) (i : Fin r), globalRes U (a i) ∈ I.ideal U)
    (n : ℕ) (M : X.Modules) :
    globalSpanMultiple a n M ≤ idealPowerMultiple I n M := by
  refine affineLocalMultiple_mono (fun U ↦ Ideal.span_le.2 ?_) M
  rintro _ ⟨i, rfl⟩
  exact Ideal.pow_mem_pow (hmem U i) n

/-- `ℐ^{m}ℱ ⊆ (a₁ⁿ, …, a_rⁿ)ℱ` for `m ≥ rn + 1` whenever `a₁, …, a_r` generate `ℐ` on every affine
open. -/
theorem idealPowerMultiple_le_globalSpanMultiple {r : ℕ} (a : Fin r → Γ(X, ⊤))
    (I : X.IdealSheafData)
    (hgen : ∀ U : X.affineOpens, I.ideal U = Ideal.span (Set.range fun i => globalRes U (a i)))
    (n m : ℕ) (hm : r * n + 1 ≤ m) (M : X.Modules) :
    idealPowerMultiple I m M ≤ globalSpanMultiple a n M := by
  refine affineLocalMultiple_mono (fun U ↦ (Ideal.pow_le_pow_right hm).trans ?_) M
  rw [hgen U]
  have hcard : Fintype.card (Fin r) * n + 1 = r * n + 1 := by
    rw [Fintype.card_fin]
  exact hcard ▸ Stacks.AlgebraicGeometry.IdealPowerSections.span_range_pow_le_span_range_pow
    (fun i ↦ globalRes U (a i)) n

/-! ### The quotient tower of an antitone family of subsheaves -/

/-- Composing two quotient maps induced by containments of subsheaves is the quotient map
induced by the composite containment. -/
theorem quotientMapOfLE_comp {F : X.Modules} {N₁ N₂ N₃ : F.Submodule} (h₁₂ : N₁ ≤ N₂)
    (h₂₃ : N₂ ≤ N₃) (h₁₃ : N₁ ≤ N₃) :
    quotientMapOfLE h₁₂ ≫ quotientMapOfLE h₂₃ = quotientMapOfLE h₁₃ := by
  refine coequalizer.hom_ext ?_
  rw [← Category.assoc, quotientMapOfLE_π, quotientMapOfLE_π, quotientMapOfLE_π]

/-- The tower of quotients of a sheaf of modules by an antitone family of subsheaves. -/
def submoduleQuotientSystem (M : X.Modules) (N : ℕ → M.Submodule)
    (hN : ∀ m n : ℕ, n ≤ m → N m ≤ N n) : ℕᵒᵖ ⥤ X.Modules where
  obj n := cokernel (C := X.Modules) (N n.unop).ι
  map h := quotientMapOfLE (hN _ _ (leOfHom h.unop))
  map_id n := by
    refine coequalizer.hom_ext ?_
    simp only [quotientMapOfLE_π, Category.comp_id]
  map_comp {i j k} f g := by
    refine coequalizer.hom_ext ?_
    rw [quotientMapOfLE_π, ← Category.assoc, quotientMapOfLE_π, quotientMapOfLE_π]

/-- The transition maps of the quotient tower are the quotient maps of the containments. -/
theorem submoduleQuotientSystem_tr (M : X.Modules) (N : ℕ → M.Submodule)
    (hN : ∀ m n : ℕ, n ≤ m → N m ≤ N n) {n m : ℕ} (h : n ≤ m) :
    tr (submoduleQuotientSystem M N hN) h = quotientMapOfLE (hN m n h) :=
  rfl

/-- The adic quotient tower is the quotient tower of the ideal-power multiples. -/
theorem adicQuotientSystem_eq_submoduleQuotientSystem (I : X.IdealSheafData) (F : X.Modules) :
    adicQuotientSystem I F =
      submoduleQuotientSystem F (fun n => idealPowerMultiple I n F)
        (fun _ _ h => idealPowerMultiple_antitone I F h) :=
  rfl

/-- Interleaved quotient maps between the quotient towers of two interleaved antitone families
of subsheaves. -/
def quotientInterleaving (M : X.Modules) (N N' : ℕ → M.Submodule)
    (hN : ∀ m n : ℕ, n ≤ m → N m ≤ N n) (hN' : ∀ m n : ℕ, n ≤ m → N' m ≤ N' n)
    (idx : ℕ → ℕ) (hidx : StrictMono idx)
    (hfwd : ∀ i : ℕ, N (idx (2 * i + 2)) ≤ N' (idx (2 * i + 1)))
    (hbwd : ∀ i : ℕ, N' (idx (2 * i + 1)) ≤ N (idx (2 * i))) :
    ProIso.Interleaving (submoduleQuotientSystem M N hN)
      (submoduleQuotientSystem M N' hN') where
  idx := idx
  idx_strictMono := hidx
  fwd i := quotientMapOfLE (hfwd i)
  bwd i := quotientMapOfLE (hbwd i)
  fwd_bwd i := by
    rw [submoduleQuotientSystem_tr]
    exact quotientMapOfLE_comp _ _ _
  bwd_fwd i := by
    rw [submoduleQuotientSystem_tr]
    exact quotientMapOfLE_comp _ _ _

/-! ### The pro-isomorphism -/

/-- The sequence `k ↦ (r + 2) ^ k` is strictly increasing. -/
theorem strictMono_interleavingIdx (r : ℕ) : StrictMono (fun k : ℕ => (r + 2) ^ k) :=
  strictMono_nat_of_lt_succ fun _ ↦ Nat.pow_lt_pow_succ (by omega)

/-- `r (r + 2)ᵏ + 1 ≤ (r + 2)ᵏ⁺¹`. -/
theorem interleavingIdx_bound (r k : ℕ) : r * (r + 2) ^ k + 1 ≤ (r + 2) ^ (k + 1) := by
  rw [pow_succ]
  nlinarith [Nat.one_le_pow k (r + 2) (by omega)]

/-- The tower `n ↦ ℱ / (a₁ⁿ, …, a_rⁿ)ℱ`. -/
def globalSpanQuotientSystem {r : ℕ} (a : Fin r → Γ(X, ⊤)) (F : X.Modules) : ℕᵒᵖ ⥤ X.Modules :=
  submoduleQuotientSystem F (fun n ↦ globalSpanMultiple a n F)
    (fun _ _ h ↦ globalSpanMultiple_antitone a F h)

/-- For `a₁, …, a_r` global sections of `𝒪_X` generating the quasi-coherent sheaf of ideals `ℐ`
and `ℱ` a sheaf of modules, the tower `n ↦ ℱ / (a₁ⁿ, …, a_rⁿ)ℱ` of quotients by the subsheaves
generated by the powers of the generators and the adic tower `n ↦ ℱ / ℐⁿℱ` are pro-isomorphic. -/
def proIso_globalSpanQuotientSystem_adicQuotientSystem {r : ℕ} (a : Fin r → Γ(X, ⊤))
    (I : X.IdealSheafData)
    (hgen : ∀ U : X.affineOpens, I.ideal U = Ideal.span (Set.range fun i => globalRes U (a i)))
    (F : X.Modules) :
    ProIso (globalSpanQuotientSystem a F) (adicQuotientSystem I F) := by
  have hmem : ∀ (U : X.affineOpens) (i : Fin r), globalRes U (a i) ∈ I.ideal U := fun U i ↦ by
    rw [hgen U]
    exact Ideal.subset_span ⟨i, rfl⟩
  refine ProIso.Interleaving.proIso ?_
  rw [adicQuotientSystem_eq_submoduleQuotientSystem]
  refine quotientInterleaving F (fun n ↦ globalSpanMultiple a n F)
    (fun n ↦ idealPowerMultiple I n F) (fun _ _ h ↦ globalSpanMultiple_antitone a F h)
    (fun _ _ h ↦ idealPowerMultiple_antitone I F h)
    (fun k ↦ (r + 2) ^ k) (strictMono_interleavingIdx r) (fun i ↦ ?_) (fun i ↦ ?_)
  · refine le_trans
      (globalSpanMultiple_le_idealPowerMultiple a I hmem ((r + 2) ^ (2 * i + 2)) F) ?_
    exact idealPowerMultiple_antitone I F
      ((strictMono_interleavingIdx r).monotone (by omega))
  · refine le_trans ?_
      (idealPowerMultiple_le_globalSpanMultiple a I hgen ((r + 2) ^ (2 * i))
        (r * (r + 2) ^ (2 * i) + 1) le_rfl F)
    exact idealPowerMultiple_antitone I F (interleavingIdx_bound r (2 * i))

/-! ### The ideal sheaf generated by finitely many global sections -/

/-- The quasi-coherent sheaf of ideals generated by finitely many global sections, as
`Scheme.IdealSheafData`: on an affine open `U` it is the ideal of `Γ(X, U)` generated by the
restrictions `a₁|_U, …, a_r|_U`. -/
@[ega "I 10.3.1" "special case"]
def globalSectionsIdealSheafData {r : ℕ} (a : Fin r → Γ(X, ⊤)) : X.IdealSheafData where
  ideal U := Ideal.span (Set.range fun i ↦ globalRes U (a i))
  map_ideal_basicOpen U f := by
    rw [Ideal.map_span]
    congr 1
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i ↦
      globalRes_res (U := X.affineBasicOpen f) (V := U) (X.basicOpen_le f) (a i))

/-- On an affine open `U`, the ideal of `globalSectionsIdealSheafData a` is the ideal of
`Γ(X, U)` generated by the restrictions of the global sections `a i`. -/
@[simp]
theorem ideal_globalSectionsIdealSheafData {r : ℕ} (a : Fin r → Γ(X, ⊤)) (U : X.affineOpens) :
    (globalSectionsIdealSheafData a).ideal U =
      Ideal.span (Set.range fun i => globalRes U (a i)) :=
  rfl

/-- The tower `n ↦ ℱ / (a₁ⁿ, …, a_rⁿ)ℱ` is pro-isomorphic to the adic tower of the sheaf of
ideals that the global sections `a₁, …, a_r` generate. -/
def proIso_globalSpanQuotientSystem_adicQuotientSystem_globalSections {r : ℕ}
    (a : Fin r → Γ(X, ⊤)) (F : X.Modules) :
    ProIso (globalSpanQuotientSystem a F)
      (adicQuotientSystem (globalSectionsIdealSheafData a) F) :=
  proIso_globalSpanQuotientSystem_adicQuotientSystem a _ (fun _ ↦ rfl) F

end Stacks.Algebraization

end
