module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.KoszulAdicCompletionLimit
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.GlobalSectionsCompletionGenerated
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.SiteBaseDerivedGlobalSections

/-!
# `I · 𝒪_X` is the ideal sheaf generated by the images of a generating family of `I`

Let `A` be a ring, `f : X ⟶ Spec A` a scheme over `A` and `a_1, …, a_r` a family of elements of
`A`. The ideal sheaf `I · 𝒪_X` of `I = (a_1, …, a_r)` — `Stacks.Cohomology.FormalFunctions`
`.baseIdealSheaf`, recorded by its ideals on the affine opens — is generated by the global
sections `ρ a_1, …, ρ a_r` of `𝒪_X`, where `ρ : A ⟶ Γ(X, 𝒪_X)` is the structure map. This file
proves that in the two spellings the ringed-site results use.

## Main definitions

* `Stacks.Algebraization.baseKoszulGenerators`: the images of `a_1, …, a_r` as global sections of
  the structure sheaf of the small Zariski site of `X`, in the spelling
  `AlgebraicGeometry.RingedSite.globalSectionOfSections` that the Koszul identity of
  [Stacks, Tag 0BLX] is indexed by.

## Main results

* `Stacks.Algebraization.globalSectionOver_baseKoszulGenerators`: the value of the `i`-th
  generator over an open set is the restriction of `ρ a_i`.
* `Stacks.Algebraization.baseIdealSheaf_ideal_eq_span_globalRes`: **affine-locally,
  `(I · 𝒪_X)(U)` is the ideal generated by the restrictions of the `ρ a_i`** — the hypothesis
  `hgen` of part (3) of [Stacks, Tag 0A0K] at `I · 𝒪_X`.
* `Stacks.Algebraization.nonempty_iso_completion_limit_adicQuotients_baseIdealSheaf`: part (3) of
  [Stacks, Tag 0A0K] at `I · 𝒪_X`, with no generation hypothesis left: for `A` Noetherian, `X`
  Noetherian over `A` and `ℱ` coherent, the Čech completion of `ℱ` along `I · 𝒪_X` is the
  ordinary inverse limit `lim ℱ/(I𝒪_X)ⁿℱ`.

## Implementation notes

Two spellings of "a global section of `𝒪`" occur, and both are needed: `generatedIdealSheaf` and
the Koszul identity are indexed by `AlgebraicGeometry.RingedSite.globalSectionOfSections`, applied
to a compatible family of local sections, while
`Stacks.Algebraization.koszulGlobalGenerator` reads a global section off its value over `⊤`. They
agree by `AlgebraicGeometry.RingedSite.globalSectionOfSections_terminalSectionsRingHom`, the
ring map `Stacks.Algebraization.baseSiteRingHom` being built by restricting a section over `⊤`.

## References

* [Stacks Project, Tag 0A0K](https://stacks.math.columbia.edu/tag/0A0K)
* [Stacks Project, Tag 0BLX](https://stacks.math.columbia.edu/tag/0BLX)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.SheafOfModules (opensRingedSite)
open Stacks.Cohomology.FormalFunctions (baseIdeal baseIdealSheaf)
open scoped IsMulCommutative

universe u

namespace Stacks.Algebraization

open AlgebraicGeometry.RingedSite

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice
attribute [local instance] modulesEnoughInjectives
attribute [local instance 100000] HasDerivedCategory.standard

/-- **The derived completion of [Stacks, Tags 099B and 099F] exists on `D(𝒪_X)` along an ideal
sheaf generated by finitely many global sections**, for a scheme `X`.

This is `AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf` at
the small Zariski site of `X`. It is restated as an instance because instance search does not
apply that theorem on its own: it is a `theorem`, so it is not in the instance set, and its
ringed-site argument is explicit. The ringed-*space* restatement
`Stacks.AlgebraicGeometry.PushforwardCommutesCompletionGenerated`
`.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf` exists for the same reason, at a
different site. -/
instance isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf_opensRingedSite
    (X : Scheme.{u}) {r : ℕ}
    (g : Fin r → Presheaf.globalSections
      ((opensRingedSite X.sheaf).O.obj ⋙ forget CommRingCat.{u})) :
    (ObjectProperty.ι (AlgebraicGeometry.RingedSite.IsDerivedComplete.{u, u, u, u}
      (opensRingedSite X.sheaf) (generatedIdealSheaf g))).IsRightAdjoint :=
  AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf _ g

variable {A : Type u} [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) {r : ℕ}
  (a : Fin r → A)

/-- **The images of `a_1, …, a_r` as global sections of the structure sheaf of the small Zariski
site of `X`**, in the spelling the Koszul identity of [Stacks, Tag 0BLX] is indexed by. -/
def baseKoszulGenerators (i : Fin r) :
    Presheaf.globalSections ((opensRingedSite X.sheaf).O.obj ⋙ forget CommRingCat.{u}) :=
  globalSectionOfSections (X := opensRingedSite X.sheaf) (baseSiteRingHom f (a i))

/-- The value of the `i`-th generator over an open set is the restriction of `ρ a_i`. -/
@[simp]
theorem globalSectionOver_baseKoszulGenerators (U : X.Opens) (i : Fin r) :
    globalSectionOver X (baseKoszulGenerators f a i) U =
      (X.presheaf.map (homOfLE (le_top (a := U))).op).hom
        (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom (a i)) := by
  refine (globalSectionVal_globalSectionOfSections (X := opensRingedSite X.sheaf) _ (op U)).trans ?_
  change (X.presheaf.map (isTerminalTop.from U).op).hom _ = _
  congr 2

/-- Restricting the `i`-th generator from `Γ(X, ⊤)` to an affine open is the restriction of
`ρ a_i`. -/
theorem globalRes_koszulGlobalGenerator_baseKoszulGenerators (U : X.affineOpens) (i : Fin r) :
    globalRes U (koszulGlobalGenerator X (baseKoszulGenerators f a) i) =
      (X.presheaf.map (homOfLE (le_top (a := U.1))).op).hom
        (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom (a i)) :=
  (globalRes_koszulGlobalGenerator X (baseKoszulGenerators f a) U i).trans
    (globalSectionOver_baseKoszulGenerators f a U.1 i)

/-- **Affine-locally, `(I · 𝒪_X)(U)` is the ideal generated by the restrictions of the
`ρ a_i`**, for `I = (a_1, …, a_r)`. This is the generation condition that identifies `I · 𝒪_X`
with the ideal sheaf `Stacks.Algebraization.koszulIdealSheafData` that part (3) of
[Stacks, Tag 0A0K] is stated at. -/
theorem baseIdealSheaf_ideal_eq_span_globalRes (U : X.affineOpens) :
    (baseIdealSheaf A (Ideal.span (Set.range a)) f).ideal U =
      Ideal.span (Set.range fun i =>
        globalRes U (koszulGlobalGenerator X (baseKoszulGenerators f a) i)) := by
  rw [Stacks.Cohomology.FormalFunctions.baseIdealSheaf_ideal, baseIdeal, Ideal.map_span,
    Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
  refine congrArg Ideal.span (congrArg Set.range (funext fun i => ?_))
  exact (globalRes_koszulGlobalGenerator_baseKoszulGenerators f a U i).symm

/-- **`I · 𝒪_X` is the ideal sheaf `Stacks.Algebraization.koszulIdealSheafData` of the global
sections `ρ a_1, …, ρ a_r`**, for `I = (a_1, …, a_r)`. An `IdealSheafData` is determined by its
affine components, so the generation condition
`Stacks.Algebraization.baseIdealSheaf_ideal_eq_span_globalRes` pins it down, by
`Stacks.Algebraization.eq_koszulIdealSheafData`. -/
theorem baseIdealSheaf_eq_koszulIdealSheafData :
    baseIdealSheaf A (Ideal.span (Set.range a)) f =
      koszulIdealSheafData X (baseKoszulGenerators f a) :=
  eq_koszulIdealSheafData X (baseKoszulGenerators f a) _
    (baseIdealSheaf_ideal_eq_span_globalRes f a)

/-- **Part (3) of [Stacks, Tag 0A0K] at `I · 𝒪_X`, with no generation hypothesis left, and read
at the derived completion reflector.** Let `A` be a Noetherian ring, `a_1, …, a_r ∈ A`,
`f : X ⟶ Spec A` a Noetherian scheme over `A` and `ℱ` a coherent `𝒪_X`-module. Write
`𝓘 = (a_1, …, a_r) · 𝒪_X`. Then the derived completion `ℱ^∧` of `ℱ` along `𝓘` — the reflector of
[Stacks, Tags 099B and 099F] at the ideal sheaf generated by the global sections `ρ a_i` — is
isomorphic in `D(𝒪_X)` to the **ordinary** inverse limit `lim ℱ/𝓘ⁿℱ`, placed in degree zero. -/
theorem nonempty_iso_derivedCompletion_limit_adicQuotients_baseIdealSheaf [IsNoetherian X]
    (ℱ : X.Modules) [ℱ.IsCoherent] :
    Nonempty
      ((RingedSite.derivedCompletion (opensRingedSite X.sheaf)
            (RingedSite.generatedIdealSheaf (baseKoszulGenerators f a))).obj
          ((DerivedCategory.singleFunctor X.Modules 0).obj ℱ) ≅
        (DerivedCategory.singleFunctor X.Modules 0).obj
          (limit (adicQuotientSystem (baseIdealSheaf A (Ideal.span (Set.range a)) f) ℱ))) := by
  obtain ⟨eQ⟩ := nonempty_iso_completion_limit_adicQuotientSystem X (baseKoszulGenerators f a) ℱ
  rw [← baseIdealSheaf_eq_koszulIdealSheafData f a] at eQ
  obtain ⟨eC, -⟩ := AlgebraicGeometry.RingedSite.exists_iso_derivedCompletion_completionFunctor_obj
    (opensRingedSite X.sheaf) (baseKoszulGenerators f a)
    ((DerivedCategory.singleFunctor X.Modules 0).obj ℱ)
  have esingle : (DerivedCategory.singleFunctor X.Modules 0).obj ℱ ≅
      DerivedCategory.Q.obj
        (RingedSite.singleSheafComplex (opensRingedSite X.sheaf) ℱ) :=
    (DerivedCategory.singleFunctorIsoCompQ X.Modules 0).app ℱ
  exact ⟨eC ≪≫ (RingedSite.completionFunctor (opensRingedSite X.sheaf)
    (baseKoszulGenerators f a)).mapIso esingle ≪≫ eQ⟩

end Stacks.Algebraization

end
