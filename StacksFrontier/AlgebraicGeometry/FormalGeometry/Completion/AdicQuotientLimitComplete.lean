universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance 100000] HasDerivedCategory.standard

/-- **The canonical map out of the derived completion into a derived-complete object exists and
is unique**: for `N` derived complete, every map `u : K ⟶ N` factors through the unit
`K ⟶ K^∧` by exactly one map `K^∧ ⟶ N`. -/
theorem existsUnique_derivedCompletionUnit_comp (X : RingedSite.{u, u, u})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint]
    {K N : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hN : IsDerivedComplete.{u, u, u, u} X I N) (u : K ⟶ N) :
    ∃! c : (derivedCompletion X I).obj K ⟶ N,
      (derivedCompletionUnit X I).app K ≫ c = u := by
  obtain ⟨g, hg⟩ := ((derivedCompletionAdjunction X I).homEquiv K
      (⟨N, hN⟩ : ObjectProperty.FullSubcategory
        (IsDerivedComplete.{u, u, u, u} X I))).surjective u
  rw [Adjunction.homEquiv_unit] at hg
  exact ⟨(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).map g, hg,
    fun _ hc => hom_ext_derivedCompletionUnit X I hN (hc.trans hg.symm)⟩

end AlgebraicGeometry.RingedSite

namespace Stacks.Algebraization

variable {X : Scheme.{u}}

section Annihilation

/-- **The `n`-th power of a section of `𝓘 𝒪_X` is a section of `𝓘ⁿ𝒪_X`**, over an arbitrary
open. -/
theorem pow_mem_idealPowerMultiple_unit (I : X.IdealSheafData) (n : ℕ) {V : X.Opens}
    {a : Γ(X, V)}
    (ha : a ∈ (idealPowerMultiple I 1 (structureModule X)).toSubmodule.obj (op V)) :
    a ^ n ∈ (idealPowerMultiple I n (structureModule X)).toSubmodule.obj (op V) := by
  refine mem_of_forall_affineOpens (idealPowerMultiple I n (structureModule X))
    (a ^ n) fun W hW => ?_
  have h1 := (idealPowerMultiple I 1 (structureModule X)).toSubmodule.map_mem (homOfLE hW).op ha
  have hres : X.presheaf.map (homOfLE hW).op a ∈ I.ideal W := by
    have h2 : X.presheaf.map (homOfLE hW).op a ∈ I.ideal W ^ 1 :=
      (idealPowerMultiple_unit_toSubmodule_obj_affine I 1 W) ▸ h1
    exact (pow_one (I.ideal W)) ▸ h2
  have key : X.presheaf.map (homOfLE hW).op (a ^ n) ∈ I.ideal W ^ n := by
    rw [map_pow]
    exact Ideal.pow_mem_pow hres n
  exact (idealPowerMultiple_unit_toSubmodule_obj_affine I n W) ▸ key

/-- **`aⁿ` kills `ℱ/𝓘ⁿℱ`**: for a section `a` of `𝓘` over an open `V`, the power `aⁿ`
annihilates the sections of `ℱ/𝓘ⁿℱ` over every open of `V`. -/
theorem sectionKills_pow_adicQuotientSystem_obj (I : X.IdealSheafData) (ℱ : X.Modules) (n : ℕ)
    {V : X.Opens} {a : Γ(X, V)}
    (ha : a ∈ (idealPowerMultiple I 1 (structureModule X)).toSubmodule.obj (op V)) :
    AlgebraicGeometry.RingedSite.SectionKills (Stacks.SheafOfModules.opensRingedSite X.sheaf)
      (U := op V) (a ^ n)
      (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
        (adicQuotientSystem I ℱ).obj ⟨n⟩) := by
  let π : (show SheafOfModules.{u} X.ringCatSheaf from ℱ) ⟶
      (show SheafOfModules.{u} X.ringCatSheaf from
        cokernel (C := X.Modules) (idealPowerMultiple I n ℱ).ι) :=
    cokernel.π (C := X.Modules) (idealPowerMultiple I n ℱ).ι
  have hepi : Epi π := coequalizer.π_epi
  have han := pow_mem_idealPowerMultiple_unit I n ha
  intro W g y
  obtain ⟨T, hT, hlift⟩ := Stacks.SheafOfModules.EpiMono.exists_covering_of_epi π (V := W.unop) y
  refine Stacks.SheafOfModules.eq_zero_of_locally_eq_zero _ hT fun {V''} k hk => ?_
  obtain ⟨t, ht⟩ := hlift k hk
  have ht' : (cokernel.π (C := X.Modules) (idealPowerMultiple I n ℱ).ι).val.app (op V'') t =
      ((adicQuotientSystem I ℱ).obj ⟨n⟩).val.map k.op y := ht
  refine (PresheafOfModules.map_smul ((adicQuotientSystem I ℱ).obj ⟨n⟩).val k.op
    (X.presheaf.map g (a ^ n)) y).trans ?_
  rw [← ht']
  refine (((cokernel.π (C := X.Modules)
    (idealPowerMultiple I n ℱ).ι).val.app (op V'')).hom.map_smul _ t).symm.trans ?_
  refine (AlgebraicGeometry.cokernel_π_val_app_eq_zero_iff (idealPowerMultiple I n ℱ).ι
    (monoSubmoduleι _) V'' _).2 ⟨⟨_, smul_mem_idealPowerMultiple I n ℱ _ ?_ t⟩, rfl⟩
  exact (idealPowerMultiple I n (structureModule X)).toSubmodule.map_mem k.op
    ((idealPowerMultiple I n (structureModule X)).toSubmodule.map_mem g han)

end Annihilation

section Complete

attribute [local instance 100000] HasDerivedCategory.standard

/-- **Every term `ℱ/𝓘ⁿℱ` of the adic quotient tower, placed in degree zero, is derived complete
along `𝓘`.** Nothing is assumed of `ℱ` or of `𝓘`. -/
theorem isDerivedComplete_single_adicQuotientSystem_obj (I : X.IdealSheafData) (ℱ : X.Modules)
    (n : ℕ) :
    AlgebraicGeometry.RingedSite.IsDerivedComplete.{u, u, u, u}
      (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)
      ((DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
        (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
          (adicQuotientSystem I ℱ).obj ⟨n⟩)) :=
  AlgebraicGeometry.RingedSite.isDerivedComplete_single_of_sectionKills _ _ _
    fun _ _ ha => ⟨n, sectionKills_pow_adicQuotientSystem_obj I ℱ n ha⟩

/-- **The ordinary limit `lim ℱ/𝓘ⁿℱ`, placed in degree zero, is derived complete along `𝓘`.** -/
theorem isDerivedComplete_single_limit_adicQuotientSystem [IsLocallyNoetherian X]
    (I : X.IdealSheafData) (ℱ : X.Modules) [ℱ.IsCoherent] :
    AlgebraicGeometry.RingedSite.IsDerivedComplete.{u, u, u, u}
      (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)
      ((DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
        (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
          (show X.Modules from limit (adicQuotientSystem I ℱ)))) := by
  have hsh : ∀ n : ℤ, (shiftFunctor (DerivedCategory (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)))) n).Additive := inferInstance
  have hzo : HasZeroObject (DerivedCategory (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)))) := inferInstance
  intro V f hf
  let RV := ((Stacks.SheafOfModules.Tensor.ringSheaf
    (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)).over V
  let A := SheafOfModules.{u} RV
  let : Linear (CatCenter A) A := Linear.ofRingMorphism (RingHom.id (CatCenter A))
  let : ∀ W : (Over V)ᵒᵖ, IsMulCommutative (RV.obj.obj W) := fun W ↦ by
    show IsMulCommutative ((Stacks.SheafOfModules.opensRingedSite X.sheaf).O.obj.obj
      (op W.unop.left))
    infer_instance
  have hLim : PreservesFiniteLimits
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) V) :=
    Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits V
  have hColim : PreservesFiniteColimits
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) V) :=
    Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits V
  have hProd : HasProductsOfShape ℕ (DerivedCategory A) :=
    AlgebraicGeometry.RingedSite.hasProductsOfShape_nat_derivedCategory_over.{u, u, u}
      (Stacks.SheafOfModules.opensRingedSite X.sheaf) V
  refine ⟨inferInstance, hLim, hColim, hProd, ?_⟩
  have hG : ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) V).mapDerivedCategory).IsRightAdjoint :=
    (Stacks.Cohomology.Localization.derivedExtensionByZeroRestrictionAdjunction
      (Stacks.SheafOfModules.opensRingedSite X.sheaf) V).isRightAdjoint
  obtain ⟨hprod0, hlim0⟩ := isDerivedLimit_single_limit_powerQuotients I ℱ
  have := hprod0
  obtain ⟨hprod1, hlim1⟩ := @Stacks.Injectives.isDerivedLimit_map_rightAdjoint
    (DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))))
    (DerivedCategory (SheafOfModules.{u} (((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)).over V)))
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) V).mapDerivedCategory
    inferInstance inferInstance inferInstance
    (adicQuotientSystem I ℱ ⋙ DerivedCategory.singleFunctor (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0) inferInstance _ hlim0
  have := hProd
  refine AlgebraicGeometry.RingedSite.isDerivedCompleteAt_of_isDerivedLimit _ _ hlim1 fun n => ?_
  exact (isDerivedComplete_single_adicQuotientSystem_obj I ℱ n V f hf).2.2.2.2

/-- **The canonical map `ℱ ⟶ lim ℱ/𝓘ⁿℱ`**, the limit lift of the cone of quotient
projections. -/
def toLimitAdicQuotientSystem (I : X.IdealSheafData) (ℱ : X.Modules) :
    ℱ ⟶ (show X.Modules from limit (adicQuotientSystem I ℱ)) :=
  limit.lift (adicQuotientSystem I ℱ) (adicQuotientCone I ℱ)

/-- **The canonical comparison `ℱ^∧ ⟶ (lim ℱ/𝓘ⁿℱ)[0]` exists and is unique.** -/
theorem existsUnique_comparison_derivedCompletion_limit_adicQuotientSystem
    [IsLocallyNoetherian X] (I : X.IdealSheafData) (ℱ : X.Modules) [ℱ.IsCoherent] :
    ∃! c : (AlgebraicGeometry.RingedSite.derivedCompletion
          (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)).obj
          ((DerivedCategory.singleFunctor (SheafOfModules.{u}
            ((Stacks.SheafOfModules.Tensor.ringSheaf
              (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
            (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
              (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ)) ⟶
        (DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
          (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
              (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
            (show X.Modules from limit (adicQuotientSystem I ℱ))),
      (AlgebraicGeometry.RingedSite.derivedCompletionUnit
          (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)).app _ ≫ c =
        (DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
          (toLimitAdicQuotientSystem I ℱ) :=
  AlgebraicGeometry.RingedSite.existsUnique_derivedCompletionUnit_comp _ _
    (isDerivedComplete_single_limit_adicQuotientSystem I ℱ) _

end Complete

end Stacks.Algebraization

