rings of `X` is written. -/
public theorem exists_isDerivedLimitWithProjections_single_limit_adicQuotientSystem
    [IsLocallyNoetherian X] (I : X.IdealSheafData) (F : X.Modules) [F.IsCoherent] :
    ∃ h : HasProduct (fun n : ℕ =>
        (adicQuotientSystem I F ⋙ DerivedCategory.singleFunctor X.Modules 0).obj ⟨n⟩),
      @NoetherianAdicCompletion.IsDerivedLimitWithProjections (DerivedCategory X.Modules)
        _ _ _ _ _ _ (adicQuotientSystem I F ⋙ DerivedCategory.singleFunctor X.Modules 0) h
        ((DerivedCategory.singleFunctor X.Modules 0).obj (limit (adicQuotientSystem I F)))
        (fun n : ℕ => (DerivedCategory.singleFunctor X.Modules 0).map
          (limit.π (adicQuotientSystem I F) ⟨n⟩)) :=
  exists_isDerivedLimitWithProjections_aux I F

/-! ### Maps into a derived limit of a tower of modules in degree zero -/

section Uniqueness

variable {A : Type u₁} [Category.{v₁} A] [Abelian A] [HasDerivedCategory.{w₁} A]

/-- **A map into the shift by `-1` of a product of objects of `D(A)` concentrated in degrees
`≥ 0`, out of an object concentrated in degrees `≤ 0`, is zero.** The shift functor is an
equivalence, so it carries the product to a product, and each component lands in an object
concentrated in degrees `≥ 1`; orthogonality of the two halves of the canonical `t`-structure
kills it. -/
public theorem hom_eq_zero_of_isLE_of_shift_product
    {Z : DerivedCategory A} (hZ : Z.IsLE 0) (Y : ℕ → DerivedCategory A)
    (hY : ∀ n : ℕ, (Y n).IsGE 0) [HasProduct Y]
    (h : Z ⟶ (∏ᶜ Y)⟦(-1 : ℤ)⟧) : h = 0 := by
  refine (isLimitOfPreserves (shiftFunctor (DerivedCategory A) (-1 : ℤ))
    (limit.isLimit (Discrete.functor Y))).hom_ext ?_
  rintro ⟨n⟩
  rw [zero_comp]
  have : DerivedCategory.TStructure.t.IsGE ((Discrete.functor Y).obj ⟨n⟩) 0 := hY n
  exact DerivedCategory.TStructure.t.zero_of_isLE_of_isGE _ 0 1 (by exact zero_lt_one) hZ
    (DerivedCategory.TStructure.t.isGE_shift _ 0 (-1) 1 (neg_add_cancel 1))

/-- **Two maps into a derived limit with pinned projections agree as soon as their composites
with the projections agree**, provided the source is concentrated in degrees `≤ 0` and the terms
of the tower in degrees `≥ 0`.

Without that proviso the statement is false: the difference of the two maps is killed by the
structural map of the presenting triangle, so it factors through the shift by `-1` of the
product, and that group of maps — the `R¹lim` of the `Ext^{-1}` groups — is what the hypotheses
make vanish. -/
public theorem hom_ext_of_comp_proj
    {F : ℕᵒᵖ ⥤ DerivedCategory A} [HasProduct fun n : ℕ => F.obj ⟨n⟩]
    {K : DerivedCategory A} {π : ∀ n : ℕ, K ⟶ F.obj ⟨n⟩}
    (hK : NoetherianAdicCompletion.IsDerivedLimitWithProjections F K π)
    (hF : ∀ n : ℕ, (F.obj ⟨n⟩).IsGE 0)
    {Z : DerivedCategory A} (hZ : Z.IsLE 0) {g g' : Z ⟶ K}
    (hgg : ∀ n : ℕ, g ≫ π n = g' ≫ π n) : g = g' := by
  obtain ⟨δ, hT⟩ := hK
  have hzero : (g - g') ≫ (Pi.lift π) = 0 := by
    refine Limits.Pi.hom_ext _ _ fun n => ?_
    rw [Category.assoc, Limits.Pi.lift_π, Preadditive.sub_comp, hgg n, sub_self, zero_comp]
  obtain ⟨b, hb⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _
    (Pretriangulated.inv_rot_of_distTriang _ hT) (g - g') hzero
  refine sub_eq_zero.mp ?_
  rw [hb, hom_eq_zero_of_isLE_of_shift_product hZ (fun n : ℕ => F.obj ⟨n⟩) hF b]
  exact zero_comp

/-- **A map between two derived-limit presentations of one tower that matches their projections
is invertible.** Let `π` and `ρ` present the same inverse system `F` at `P` and at `L`, let the
terms of `F` be concentrated in degrees `≥ 0`, and let `c : P ⟶ L` satisfy `c ≫ ρ n = π n`. If
`L` is concentrated in degrees `≤ 0`, and if maps out of `P` are determined by their composites
with the projections `π`, then `c` is an isomorphism.

The cone `ρ` lifts through the presentation at `P` to a map `w : L ⟶ P` with `w ≫ π n = ρ n`, and
the two composites `c ≫ w` and `w ≫ c` are identities because each is pinned by its composites
with the projections — `w ≫ c` by
`Stacks.Algebraization.hom_ext_of_comp_proj` at the presentation `ρ`, and `c ≫ w` by the
hypothesis `hPext`.

That hypothesis is not idle. `P` is a derived completion in the application, and a map out of a
derived completion is determined by its restriction along the completion unit, whose source *is*
concentrated in degrees `≤ 0`; `hom_ext_of_comp_proj` is then available at the presentation `π`.
Without some such input the statement is false: two derived-limit presentations of one tower with
matching projections do not by themselves make a comparison invertible, the third square of the
morphism of Milnor triangles being undetermined — take the Milnor difference map to be zero,
where the fibre is `P ⊕ P⟦-1⟧` and the projection `P ⊕ P⟦-1⟧ ⟶ P` is matched by non-invertible
endomorphisms. -/
public theorem isIso_of_isDerivedLimitWithProjections_of_comp_proj
    {F : ℕᵒᵖ ⥤ DerivedCategory A} [HasProduct fun n : ℕ => F.obj ⟨n⟩]
    (hF : ∀ n : ℕ, (F.obj ⟨n⟩).IsGE 0)
    {P L : DerivedCategory A} {π : ∀ n : ℕ, P ⟶ F.obj ⟨n⟩} {ρ : ∀ n : ℕ, L ⟶ F.obj ⟨n⟩}
    (hP : NoetherianAdicCompletion.IsDerivedLimitWithProjections F P π)
    (hL : NoetherianAdicCompletion.IsDerivedLimitWithProjections F L ρ)
    (hLle : L.IsLE 0)
    (hPext : ∀ g₁ g₂ : P ⟶ P, (∀ n : ℕ, g₁ ≫ π n = g₂ ≫ π n) → g₁ = g₂)
    (c : P ⟶ L) (hc : ∀ n : ℕ, c ≫ ρ n = π n) :
    IsIso c := by
  obtain ⟨w, hw⟩ := hP.exists_lift ρ hL.comp_map_succ
  refine ⟨w, hPext _ _ fun n => ?_, hom_ext_of_comp_proj hL hF hLle fun n => ?_⟩
  · rw [Category.assoc, hw n, hc n, Category.id_comp]
  · rw [Category.assoc, hc n, hw n, Category.id_comp]

end Uniqueness

/-! ### The canonical maps out of the derived completion -/

section Canonical

variable [IsLocallyNoetherian X] (I : X.IdealSheafData) (ℱ : X.Modules) [ℱ.IsCoherent]

/-- **The canonical map `ℱ^∧ ⟶ (ℱ/𝓘ⁿℱ)[0]`.** Each term of the adic quotient tower, placed in
degree zero, is derived complete along `𝓘`
(`Stacks.Algebraization.isDerivedComplete_single_adicQuotientSystem_obj`), so the universal
property of the completion unit produces exactly one map out of `ℱ^∧` restricting along the unit
to the quotient projection `ℱ ⟶ ℱ/𝓘ⁿℱ`. -/
public def completionToAdicQuotient (n : ℕ) :
    (AlgebraicGeometry.RingedSite.derivedCompletion
        (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
          (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ)) ⟶
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
        (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
          (adicQuotientSystem I ℱ).obj ⟨n⟩) :=
  (AlgebraicGeometry.RingedSite.existsUnique_derivedCompletionUnit_comp _ _
    (isDerivedComplete_single_adicQuotientSystem_obj I ℱ n)
    ((DerivedCategory.singleFunctor (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
      ((adicQuotientCone I ℱ).π.app ⟨n⟩))).choose

omit [ℱ.IsCoherent] in
/-- The defining property of `Stacks.Algebraization.completionToAdicQuotient`: composing the
completion unit with it gives the `n`-th quotient projection. -/
public theorem derivedCompletionUnit_comp_completionToAdicQuotient (n : ℕ) :
    (AlgebraicGeometry.RingedSite.derivedCompletionUnit
        (Stacks.SheafOfModules.opensRingedSite X.sheaf)
        (idealSheafSiteSubmodule I)).app _ ≫ completionToAdicQuotient I ℱ n =
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
        ((adicQuotientCone I ℱ).π.app ⟨n⟩) :=
  (AlgebraicGeometry.RingedSite.existsUnique_derivedCompletionUnit_comp _ _
    (isDerivedComplete_single_adicQuotientSystem_obj I ℱ n) _).choose_spec.1

omit [ℱ.IsCoherent] in
/-- `Stacks.Algebraization.completionToAdicQuotient` is the **only** map out of `ℱ^∧` whose
composite with the completion unit is the `n`-th quotient projection. -/
public theorem completionToAdicQuotient_unique (n : ℕ)
    {g : (AlgebraicGeometry.RingedSite.derivedCompletion
        (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
          (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ)) ⟶
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
        (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
          (adicQuotientSystem I ℱ).obj ⟨n⟩)}
    (hg : (AlgebraicGeometry.RingedSite.derivedCompletionUnit
        (Stacks.SheafOfModules.opensRingedSite X.sheaf)
        (idealSheafSiteSubmodule I)).app _ ≫ g =
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
        ((adicQuotientCone I ℱ).π.app ⟨n⟩)) :
    g = completionToAdicQuotient I ℱ n :=
  (AlgebraicGeometry.RingedSite.existsUnique_derivedCompletionUnit_comp _ _
    (isDerivedComplete_single_adicQuotientSystem_obj I ℱ n) _).choose_spec.2 g hg

/-- A map out of `ℱ^∧` which restricts along the completion unit to `s` and is followed by the
image of `q`, where `s ≫ q` is the `n`-th quotient projection, is the `n`-th canonical map. -/
private theorem comp_map_eq_completionToAdicQuotient
    (I : X.IdealSheafData) (ℱ : X.Modules) (n : ℕ)
    {Y : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))}
    {g : (AlgebraicGeometry.RingedSite.derivedCompletion
        (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
          (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ)) ⟶
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj Y}
    (s : (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ) ⟶ Y)
    (hg : (AlgebraicGeometry.RingedSite.derivedCompletionUnit
        (Stacks.SheafOfModules.opensRingedSite X.sheaf)
        (idealSheafSiteSubmodule I)).app _ ≫ g =
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map s)
    (q : Y ⟶ (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
      (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
      (adicQuotientSystem I ℱ).obj ⟨n⟩))
    (hq : s ≫ q = (adicQuotientCone I ℱ).π.app ⟨n⟩) :
    g ≫ (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map q =
      completionToAdicQuotient I ℱ n :=
  completionToAdicQuotient_unique I ℱ n
    (by rw [← Category.assoc, hg, ← Functor.map_comp, hq]; rfl)

omit [ℱ.IsCoherent] in
/-- **The canonical maps onto the terms of the tower form a cone**: the `(n+1)`-st followed by the
transition map is the `n`-th. Both sides restrict along the completion unit to the `n`-th quotient
projection, by the naturality of the quotient cone, so they agree by the uniqueness clause. -/
public theorem completionToAdicQuotient_succ_comp_map (n : ℕ) :
    completionToAdicQuotient I ℱ (n + 1) ≫
        (DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
          ((adicQuotientSystem I ℱ).map (homOfLE (Nat.le_succ n)).op) =
      completionToAdicQuotient I ℱ n :=
  comp_map_eq_completionToAdicQuotient I ℱ n ((adicQuotientCone I ℱ).π.app ⟨n + 1⟩)
    (derivedCompletionUnit_comp_completionToAdicQuotient I ℱ (n + 1))
    ((adicQuotientSystem I ℱ).map (homOfLE (Nat.le_succ n)).op)
    ((adicQuotientCone I ℱ).π.naturality (homOfLE (Nat.le_succ n)).op).symm

/-- **The canonical comparison `c : ℱ^∧ ⟶ (lim ℱ/𝓘ⁿℱ)[0]`**, the unique map of
`Stacks.Algebraization.existsUnique_comparison_derivedCompletion_limit_adicQuotientSystem`. -/
public def comparisonDerivedCompletionLimitAdicQuotient :
    (AlgebraicGeometry.RingedSite.derivedCompletion
        (Stacks.SheafOfModules.opensRingedSite X.sheaf) (idealSheafSiteSubmodule I)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
          (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ)) ⟶
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
        (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
          (show X.Modules from limit (adicQuotientSystem I ℱ))) :=
  (existsUnique_comparison_derivedCompletion_limit_adicQuotientSystem I ℱ).choose

/-- The defining property of `Stacks.Algebraization.comparisonDerivedCompletionLimitAdicQuotient`:
its composite with the completion unit is the limit lift `ℱ ⟶ lim ℱ/𝓘ⁿℱ`. -/
public theorem derivedCompletionUnit_comp_comparisonDerivedCompletionLimitAdicQuotient :
    (AlgebraicGeometry.RingedSite.derivedCompletionUnit
        (Stacks.SheafOfModules.opensRingedSite X.sheaf)
        (idealSheafSiteSubmodule I)).app _ ≫
      comparisonDerivedCompletionLimitAdicQuotient I ℱ =
      (DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
        (toLimitAdicQuotientSystem I ℱ) :=
  (existsUnique_comparison_derivedCompletion_limit_adicQuotientSystem I ℱ).choose_spec.1

/-- **The canonical comparison followed by the `n`-th limit projection is the `n`-th canonical
map onto the tower.** Both restrict along the completion unit to the `n`-th quotient projection —
on the left because the limit lift followed by the `n`-th limit projection is that projection —
so they agree by the uniqueness clause of
`Stacks.Algebraization.completionToAdicQuotient_unique`. -/
public theorem comparison_comp_single_limit_π (n : ℕ) :
    comparisonDerivedCompletionLimitAdicQuotient I ℱ ≫
        (DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
          (limit.π (adicQuotientSystem I ℱ) ⟨n⟩) =
      completionToAdicQuotient I ℱ n :=
  comp_map_eq_completionToAdicQuotient I ℱ n (toLimitAdicQuotientSystem I ℱ)
    (derivedCompletionUnit_comp_comparisonDerivedCompletionLimitAdicQuotient I ℱ)
    (limit.π (adicQuotientSystem I ℱ) ⟨n⟩)
    (limit.lift_π (adicQuotientCone I ℱ) ⟨n⟩)

/-! ### The reduction of part (3) to the canonicity of the projections -/

/-- **If the canonical maps `ℱ^∧ ⟶ (ℱ/𝓘ⁿℱ)[0]` are the projections of a derived-limit
presentation of `ℱ^∧`, then the canonical comparison `c : ℱ^∧ ⟶ (lim ℱ/𝓘ⁿℱ)[0]` is an
isomorphism** — that is, part (3) of [Stacks, Tag 0A0K] holds, at the tag's own hypotheses and
through its canonical comparison map.

The proof is two applications of the universal property of a derived limit, made unambiguous by the
vanishing of the obstruction group. Part (4) presents `(lim ℱ/𝓘ⁿℱ)[0]` as a derived limit of the
same tower through the images of the limit projections
(`Stacks.Algebraization.exists_isDerivedLimitWithProjections_single_limit_adicQuotientSystem`), so
that cone lifts through the presentation at `ℱ^∧` to a map `w` backwards, and `c ≫ w` and `w ≫ c`
are identities because each is pinned by its composites with the projections: a map out of `ℱ^∧` is
determined by its restriction along the completion unit, and two maps into a derived limit of a
tower of modules *in degree zero*, out of an object in degrees `≤ 0`, agree as soon as their
composites with the projections do — the difference factors through the shift by `-1` of the
product of the tower, whose `Hom` group from such a source vanishes.

This is the one statement part (3) at the tag's own hypotheses reduces to, and
`Stacks.Algebraization.isIso_comparisonDerivedCompletionLimitAdicQuotient` of
`Completion/AdicQuotientSliceTowerKoszul.lean` discharges it. The hypothesis is
not weaker than the conclusion: it says that the Koszul presentation of `ℱ^∧` can be arranged to
have *the canonical* projections, equivalently that the completion unit followed by the
projections of some presentation is the quotient map `ℱ ⟶ ℱ/𝓘ⁿℱ` — a compatibility of the Koszul
identification with the unit, not a restatement of the invertibility. -/
public theorem isIso_comparison_of_isDerivedLimitWithProjections
    (hq : ∃ h : HasProduct (fun n : ℕ =>
        (adicQuotientSystem I ℱ ⋙ DerivedCategory.singleFunctor
          (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj ⟨n⟩),
      @NoetherianAdicCompletion.IsDerivedLimitWithProjections _ _ _ _ _ _ _
        (adicQuotientSystem I ℱ ⋙ DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0) h _
        (completionToAdicQuotient I ℱ)) :
    IsIso (comparisonDerivedCompletionLimitAdicQuotient I ℱ) := by
  obtain ⟨hp4, hlim4⟩ := exists_isDerivedLimitWithProjections_aux I ℱ
  obtain ⟨hpq, hlimq⟩ := hq
  have := hpq
  have hGE : ∀ n : ℕ, ((adicQuotientSystem I ℱ ⋙ DerivedCategory.singleFunctor
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj ⟨n⟩).IsGE 0 := fun n =>
    inferInstanceAs (((DerivedCategory.singleFunctor (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
      (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
        (adicQuotientSystem I ℱ).obj ⟨n⟩)).IsGE 0)
  refine isIso_of_isDerivedLimitWithProjections_of_comp_proj hGE hlimq hlim4
    (inferInstanceAs (((DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
      (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from
        (show X.Modules from limit (adicQuotientSystem I ℱ)))).IsLE 0))
    ?_ _ (comparison_comp_single_limit_π I ℱ)
  intro g₁ g₂ hg
  refine AlgebraicGeometry.RingedSite.hom_ext_derivedCompletionUnit _ _
    (AlgebraicGeometry.RingedSite.isDerivedComplete_derivedCompletion_obj _ _ _) ?_
  refine hom_ext_of_comp_proj hlimq hGE
    (inferInstanceAs (((DerivedCategory.singleFunctor (SheafOfModules.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj
      (show SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)) from ℱ)).IsLE 0)) fun n => ?_
  exact ((Category.assoc _ _ _).trans
    (congrArg (fun z => _ ≫ z) (hg n))).trans (Category.assoc _ _ _).symm

/-- **The converse of `Stacks.Algebraization.isIso_comparison_of_isDerivedLimitWithProjections`.**
If the canonical comparison is invertible then the canonical maps onto the terms of the tower are
the projections of a derived-limit presentation of `ℱ^∧`: transport part (4)'s presentation along
that isomorphism, whose composites with the limit projections are exactly those canonical maps.

Together the two statements say that the hypothesis of the reduction is **equivalent** to part (3)
and so is not a weakening of it — it is the compatibility of a Koszul presentation of `ℱ^∧` with
the completion unit, read as a statement about the presentation's cone. -/
public theorem isDerivedLimitWithProjections_completionToAdicQuotient_of_isIso
    (hc : IsIso (comparisonDerivedCompletionLimitAdicQuotient I ℱ)) :
    ∃ h : HasProduct (fun n : ℕ =>
        (adicQuotientSystem I ℱ ⋙ DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).obj ⟨n⟩),
      @NoetherianAdicCompletion.IsDerivedLimitWithProjections _ _ _ _ _ _ _
        (adicQuotientSystem I ℱ ⋙ DerivedCategory.singleFunctor (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0) h _
        (completionToAdicQuotient I ℱ) := by
  obtain ⟨hp4, hlim4⟩ := exists_isDerivedLimitWithProjections_aux I ℱ
  refine ⟨hp4, ?_⟩
  have key : (fun n : ℕ => comparisonDerivedCompletionLimitAdicQuotient I ℱ ≫
      (DerivedCategory.singleFunctor (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))) 0).map
        (limit.π (adicQuotientSystem I ℱ) ⟨n⟩)) = completionToAdicQuotient I ℱ :=
    funext fun n => comparison_comp_single_limit_π I ℱ n
  exact key ▸ hlim4.of_iso (@asIso _ _ _ _ _ hc)

end Canonical

end Stacks.Algebraization

