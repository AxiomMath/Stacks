module

public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebraModule
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.Quasicoherent.IdealPowerMultiple

/-!
# The graded module `⨁ₙ ℐⁿF` is the family of ideal-power multiples, and is quasi-coherent

Two subsheaves of `F` carry the name `ℐⁿF` in this library: `Stacks.Blowup.reesMultiple`, the
subsheaf generated by the products of local sections of the degree-`n` piece of the Rees algebra
of `ℐ` with local sections of `F`, and `Stacks.Algebraization.idealPowerMultiple`, the least
subsheaf containing `ℐ(U)ⁿ · Γ(F, U)` for every *affine* open `U`. This file identifies them, and
deduces that the pieces of the graded module `Stacks.Blowup.reesGradedModule` over the Rees
algebra are quasi-coherent when `F` is.

## Main results

* `Stacks.Blowup.reesMultiple_natCast_eq_idealPowerMultiple`: the two subsheaves agree in every
  nonnegative degree.
* `Stacks.Blowup.reesMultiple_isQuasicoherent`: in nonnegative degrees `ℐⁿF` is quasi-coherent
  when `F` is.

## References

* [Stacks Project, Tag 02O7](https://stacks.math.columbia.edu/tag/02O7)
* [Stacks Project, Tag 02O9](https://stacks.math.columbia.edu/tag/02O9)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.Algebraization

namespace Stacks.Blowup

universe u

attribute [local instance] Stacks.Algebraization.sectionsModuleΓSheaf
  Stacks.Algebraization.sectionsModuleΓ
  AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

/-- The subsheaf of `F` generated by the products of local sections of the degree-`n` piece of
the Rees algebra of `ℐ` with local sections of `F` is the ideal-power multiple `ℐⁿF`. -/
public lemma reesMultiple_natCast_eq_idealPowerMultiple {X : Scheme.{u}}
    (I : X.IdealSheafData) (n : ℕ) (F : X.Modules) :
    reesMultiple I (n : ℤ) F = idealPowerMultiple I n F := by
  refine le_antisymm ?_ ?_
  · refine (reesMultiple_le_iff I (n : ℤ) F _).2 fun U r m => ?_
    refine mem_submodule_of_affine _ U _ ?_
    intro V hiV
    have hle : V.1 ≤ U := leOfHom hiV
    have hgen : I.ideal V ^ n • (⊤ : Submodule Γ(X, V) Γ(F, V)) ≤
        (idealPowerMultiple I n F).toSubmodule.obj (op V.1) :=
      (idealPowerMultiple_le_iff I n F _).mp le_rfl V
    have hmem : reesPieceAmbient I (n : ℤ) V.1
        (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hle).op r) ∈ I.ideal V ^ n := by
      simpa using reesPieceAmbient_mem_affine I (n : ℤ) (Int.natCast_nonneg n) V
        (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hle).op r)
    have hres : Stacks.restr F.val (homOfLE hle).op (reesPieceAmbient I (n : ℤ) U r • m) =
        reesPieceAmbient I (n : ℤ) V.1
          (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hle).op r) •
          Stacks.restr F.val (homOfLE hle).op m :=
      (restr_smul_gamma (F := F) hle (reesPieceAmbient I (n : ℤ) U r) m).trans
        (congrArg (fun a : Γ(X, V.1) => a • Stacks.restr F.val (homOfLE hle).op m)
          (reesPieceAmbient_restr I (n : ℤ) hle r).symm)
    have hfin := hgen (Submodule.smul_mem_smul hmem
      (Submodule.mem_top (x := Stacks.restr F.val (homOfLE hle).op m)))
    rw [Subsingleton.elim hiV (homOfLE hle)]
    show Stacks.restr F.val (homOfLE hle).op (reesPieceAmbient I (n : ℤ) U r • m) ∈
      (idealPowerMultiple I n F).toSubmodule.obj (op V.1)
    exact hres ▸ hfin
  · refine (idealPowerMultiple_le_iff I n F _).2 fun U => ?_
    refine Submodule.smul_le.2 fun a ha m _ => ?_
    have hn : (0 : ℤ) ≤ (n : ℤ) := Int.natCast_nonneg n
    set r := (reesPieceAffineEquiv I (n : ℤ) hn U).symm ⟨a, by rwa [Int.toNat_natCast]⟩ with hr
    have hamb : reesPieceAmbient I (n : ℤ) U.1 r = a := by
      rw [← reesPieceAffineEquiv_coe I (n : ℤ) hn U r, hr, AddEquiv.apply_symm_apply]
    exact hamb ▸ smul_mem_reesMultiple I (n : ℤ) F U.1 r m

/-- In nonnegative degrees the piece `ℐⁿF` of the graded module over the Rees algebra is
quasi-coherent when `F` is. -/
public lemma reesMultiple_isQuasicoherent {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℕ)
    (F : X.Modules) [F.IsQuasicoherent] :
    (reesMultiple I (n : ℤ) F).toSheafOfModules.IsQuasicoherent := by
  rw [reesMultiple_natCast_eq_idealPowerMultiple]
  exact idealPowerMultiple_isQuasicoherent I n F

end Stacks.Blowup

end
