module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.Quasicoherent.HigherDirectImageGradedFiniteType
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.Quasicoherent.PushforwardReesPieceQcoh
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.Quasicoherent.ReesMultipleRestrict
public import StacksFrontier.AlgebraicGeometry.Groupoids.IdealSheafComap
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The ideal sheaf of an affine chart of the base, and the graded module it carries

Let `f : X ⟶ Y` be a morphism of schemes, `ℐ ⊆ 𝒪_Y` a quasi-coherent sheaf of ideals and `V` an
affine open of `Y`. [Stacks, Tag 02O8] is stated for a scheme over the spectrum of a ring and the
ideal `I ⊆ A` there becomes, on the chart
`Stacks.Algebraization.affineBaseChart`, the ideal sheaf
`Stacks.Cohomology.FormalFunctions.baseIdealSheaf Γ(Y, V) ℐ(V)` of the structure morphism
`f⁻¹(V) ⟶ Spec Γ(Y, V)`. This file identifies that ideal sheaf with the restriction to `f⁻¹(V)`
of the inverse image ideal sheaf `ℐ𝒪_X`, and deduces that the graded module
`Stacks.Cohomology.FormalFunctions.reesFiltrationModule` of the chart has for its pieces exactly
the restrictions to `f⁻¹(V)` of the pieces of
`Stacks.Blowup.pushforwardReesGradedModulePlus`'s source.

## Main results

* `Stacks.Algebraization.baseIdealSheaf_isoSpec`: on an affine open `V`, read as a scheme over
  `Spec Γ(Y, V)`, the ideal sheaf generated by `ℐ(V)` is the restriction `ℐ|_V`.
* `Stacks.Algebraization.baseIdealSheaf_affineBaseChart`: **the chart identity** — the ideal
  sheaf of the chart is `(ℐ𝒪_X)|_{f⁻¹(V)}`.
* `Stacks.Algebraization.piece_reesFiltrationModule_affineBaseChart`: the pieces of the chart's
  graded module are the restrictions of `ℐⁿℱ`.

## Implementation notes

Both ideal sheaves live on an affine scheme, so `AlgebraicGeometry.Scheme.IdealSheafData` is
determined by its ideal of global sections
(`AlgebraicGeometry.Scheme.IdealSheafData.ext_of_isAffine`), and the whole content of
`baseIdealSheaf_isoSpec` is that the two ring maps `Γ(Y, V) ⟶ Γ(V, ⊤)` in play agree: the one
through the `Spec`-`Γ` adjunction and `V ≅ Spec Γ(Y, V)`, which is
`AlgebraicGeometry.IsAffineOpen.isoSpec_hom_appTop`, and the one through
`AlgebraicGeometry.Scheme.Opens.topIso`, which is what
`Stacks.IdealSheaf.ideal_comap_ι_top` computes the restricted ideal with.

The chart identity is then formal: `Stacks.PuncturedSpectrumPicard.baseIdealSheaf_comap` moves
the structure morphism's factorisation inside `baseIdealSheaf`, and
`AlgebraicGeometry.morphismRestrict_ι` exchanges the two ways of restricting `f` over `V`.

`Stacks.IdealSheaf.ideal_comap_ι_top` is one of three identical statements in the tree; see the
anti-duplication note in the commit message. The copy imported here is the one in
`StacksFrontier.AlgebraicGeometry.Groupoids.IdealSheafComap`.

## References

* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
* [Stacks Project, Tag 02O9](https://stacks.math.columbia.edu/tag/02O9)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.Cohomology.FormalFunctions

universe u

namespace Stacks.Algebraization

variable {Y : Scheme.{u}} (I : Y.IdealSheafData)

/-- **An ideal sheaf on an affine open is generated by its ideal of sections there.** Read
through `V ≅ Spec Γ(Y, V)`, the ideal sheaf `ℐ(V) · 𝒪_V` of
`Stacks.Cohomology.FormalFunctions.baseIdealSheaf` is the restriction of `ℐ` to `V`. -/
public theorem baseIdealSheaf_isoSpec (V : Y.affineOpens) :
    baseIdealSheaf ↥Γ(Y, V.1) (I.ideal V) V.2.isoSpec.hom = I.comap V.1.ι := by
  have : IsAffine V.1.toScheme := V.2
  have hT : IsAffineOpen (⊤ : V.1.toScheme.Opens) := isAffineOpen_top _
  refine Scheme.IdealSheafData.ext_of_isAffine ?_
  rw [Stacks.IdealSheaf.ideal_comap_ι_top I V.2 hT]
  have hid : V.1.toScheme.presheaf.map
      (homOfLE (le_top (a := (⊤ : V.1.toScheme.Opens)))).op = CategoryTheory.CategoryStruct.id _ :=
    (congrArg (fun φ : (⊤ : V.1.toScheme.Opens) ⟶ ⊤ =>
      V.1.toScheme.presheaf.map φ.op)
        (Subsingleton.elim _ (CategoryTheory.CategoryStruct.id _))).trans
      (V.1.toScheme.presheaf.map_id _)
  have hmap : ((Scheme.ΓSpecIso (.of ↥Γ(Y, V.1))).inv ≫ V.2.isoSpec.hom.appTop) =
      V.1.topIso.inv := by
    rw [V.2.isoSpec_hom_appTop]
    exact Iso.inv_hom_id_assoc _ _
  change Ideal.map (V.1.toScheme.presheaf.map
      (homOfLE (le_top (a := (⊤ : V.1.toScheme.Opens)))).op).hom
      (baseIdeal ↥Γ(Y, V.1) (I.ideal V) V.2.isoSpec.hom) = _
  rw [hid]
  change Ideal.map (CategoryTheory.CategoryStruct.id
      (V.1.toScheme.presheaf.obj (op (⊤ : V.1.toScheme.Opens)))).hom
      (baseIdeal ↥Γ(Y, V.1) (I.ideal V) V.2.isoSpec.hom) = _
  rw [CommRingCat.hom_id, Ideal.map_id, baseIdeal, hmap]

variable {X : Scheme.{u}} (f : X ⟶ Y) (F : X.Modules)

/-- **The chart identity.** The ideal sheaf that [Stacks, Tag 02O8] works with on the chart
`f⁻¹(V) ⟶ Spec Γ(Y, V)` is the restriction to `f⁻¹(V)` of the inverse image ideal sheaf
`ℐ𝒪_X`. -/
public theorem baseIdealSheaf_affineBaseChart (V : Y.affineOpens) :
    baseIdealSheaf ↥Γ(Y, V.1) (I.ideal V) (affineBaseChart f V).hom =
      (I.comap f).comap (f ⁻¹ᵁ V.1).ι := by
  change baseIdealSheaf ↥Γ(Y, V.1) (I.ideal V) ((f ∣_ V.1) ≫ V.2.isoSpec.hom) = _
  rw [← Stacks.PuncturedSpectrumPicard.baseIdealSheaf_comap ↥Γ(Y, V.1) (I.ideal V)
    V.2.isoSpec.hom (f ∣_ V.1), baseIdealSheaf_isoSpec I V,
    ← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
    morphismRestrict_ι]

/-- **The pieces of the chart's graded module are the restrictions of `ℐⁿℱ`.** The graded
`⨁ₙ ℐ(V)ⁿ`-module that [Stacks, Tag 02O8] is applied to on the chart has for its degree-`n`
piece the restriction to `f⁻¹(V)` of `ℐⁿℱ`, which is the degree-`n` piece of
`Stacks.Blowup.pushforwardReesGradedModulePlus`'s source. -/
public theorem piece_reesFiltrationModule_affineBaseChart [F.IsQuasicoherent]
    (V : Y.affineOpens) (n : ℤ) :
    ((reesFiltrationModule (I.ideal V) (affineBaseChart f V)
        (affineBaseChartModule f F V)).piece n : (f ⁻¹ᵁ V.1).toScheme.Modules) =
      (Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V.1).ι).obj (Stacks.Blowup.reesComapMod f I F n) := by
  change ((Stacks.Blowup.reesMultiple
      (baseIdealSheaf ↥Γ(Y, V.1) (I.ideal V) (affineBaseChart f V).hom) n
      (affineBaseChartModule f F V)).toSheafOfModules : (f ⁻¹ᵁ V.1).toScheme.Modules) = _
  rw [baseIdealSheaf_affineBaseChart I f V]
  exact Stacks.Blowup.reesMultiple_restrictFunctor_eq (I.comap f) (f ⁻¹ᵁ V.1) F n

/-- **[Stacks, Tag 02O8] on an affine chart of the base, at the chart's graded module.** For `Y`
locally Noetherian, `f` proper and `ℱ` coherent, the graded module `⨁ₙ Hᵖ(f⁻¹(V), ℐⁿℱ)` is a
finite module over the Rees algebra `⨁ₙ ℐ(V)ⁿ`, the summands being the cohomology of the pieces
of `Stacks.Cohomology.FormalFunctions.reesFiltrationModule` — which, by
`piece_reesFiltrationModule_affineBaseChart`, are the restrictions to `f⁻¹(V)` of the pieces of
`Stacks.Blowup.pushforwardReesGradedModulePlus`'s source.

This is `Stacks.Cohomology.FormalFunctions.isCohomologyReesFiniteOfGradedModule` — 02O8 at an
arbitrary graded module over the chart's Rees algebra — instantiated at that graded module. Each
of its five inputs is already discharged in the tree: quasi-coherence and the vanishing of the
negative pieces by `isQuasicoherent_piece_reesFiltrationModule` and
`isZero_piece_reesFiltrationModule_of_neg`, finite type by
`Stacks.Blowup.isFiniteType_reesGradedModule_of_isCoherent`, properness by
`isProper_affineBaseChart_hom`, and Noetherianness of `Γ(Y, V)` by
`isNoetherianRing_sections_affineOpens`.

`Stacks.Algebraization.isCohomologyReesFinite_affineBaseChart` is the same tag on the same chart
read at the *ideal-power filtration of `ℱ`* instead; it is not interchangeable with this, because
the finite module it speaks of is `⨁ₙ Hᵖ(f⁻¹(V), Stacks.Algebraization.idealPowerMod …)` and the
comparison with the pieces here is the surjection
`Stacks.Cohomology.FormalFunctions.transferLinear`, not an identity. The pieces are what the
transport to the base consumes, so the statement is taken in this form. -/
@[ega "III 3.3.1" "special case",
  ega "III 4.1.7.12" "more general",
  ega "III 4.1.7.7" "more general", sga "2 XII 5.8" "(ii), special case"]
public theorem isCohomologyReesFiniteOfGradedModule_affineBaseChart [IsLocallyNoetherian Y]
    [IsProper f] [F.IsCoherent] (V : Y.affineOpens) (p : ℕ) :
    IsCohomologyReesFiniteOfGradedModule (I.ideal V) (affineBaseChart f V)
      (reesFiltrationModule (I.ideal V) (affineBaseChart f V)
        (affineBaseChartModule f F V)) p :=
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  isCohomologyReesFiniteOfGradedModule (I.ideal V) (affineBaseChart f V)
    (reesFiltrationModule (I.ideal V) (affineBaseChart f V) (affineBaseChartModule f F V))
    (isQuasicoherent_piece_reesFiltrationModule (I.ideal V) (affineBaseChart f V)
      (affineBaseChartModule f F V))
    (isZero_piece_reesFiltrationModule_of_neg (I.ideal V) (affineBaseChart f V)
      (affineBaseChartModule f F V))
    p inferInstance
    (Stacks.Blowup.isFiniteType_reesGradedModule_of_isCoherent
      (baseIdealSheaf ↥Γ(Y, V.1) (I.ideal V) (affineBaseChart f V).hom)
      (affineBaseChartModule f F V) inferInstance)

end Stacks.Algebraization

end
