attribute [local instance 100000] HasDerivedCategory.standard

/-! ### A tower of zero objects has vanishing first derived inverse limit -/

/-- A tower of zero objects satisfies the Mittag-Leffler condition: every transition image is a
subobject of a zero object, hence `⊥`. -/
private theorem isMittagLefflerCategorical_of_isZero {C : Type*} [Category C] [Abelian C]
    (E : ℕᵒᵖ ⥤ C) (hE : ∀ n : ℕᵒᵖ, IsZero (E.obj n)) : IsMittagLefflerCategorical E := by
  have hbot : ∀ (i k : ℕ) (h : i ≤ k), transitionImage E i k h = ⊥ := by
    intro i k h
    exact Subobject.mk_eq_bot_iff_zero.2 ((hE (op i)).eq_zero_of_tgt _)
  exact fun i => ⟨i, le_rfl, fun k hk => (hbot i k _).trans (hbot i i le_rfl).symm⟩

/-! ### The identity of Tag 0BLX at `I · 𝒪_X` -/

variable {A : Type u} [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) {r : ℕ}
  (a : Fin r → A)

/-- **`RΓ(X, ℱ)^∧ ≅ RΓ(X, lim ℱ/𝓘ⁿℱ)`**, the identity of [Stacks, Tag 0BLX] at the ideal sheaf
`𝓘 = (a_1, …, a_r) · 𝒪_X`, for a Noetherian scheme `f : X ⟶ Spec A` over `A` and a coherent
`𝒪_X`-module `ℱ`. The derived completion on the left is
`DerivedCompletion.derivedCompletionFunctor A a`, the reflector of [Stacks, Tag 0G3E] along
`(a_1, …, a_r) ⊆ A`.

Three steps, all read through the comparison
`Stacks.Algebraization.derivedGlobalSectionsOverSiteIso` of the ringed-site and scheme-level
derived global sections: the identity `RΓ(𝒞, K)^∧ = RΓ(𝒞, K^∧)` at the ideal sheaf generated by
the global sections `ρ a_i`; part (3) of [Stacks, Tag 0A0K] identifying `ℱ^∧` with the ordinary
limit of the adic quotients; and that comparison again. -/
theorem nonempty_iso_derivedCompletion_derivedGlobalSections_baseIdealSheaf [IsNoetherian X]
    (F : X.Modules) [F.IsCoherent] :
    Nonempty
      ((DerivedCompletion.derivedCompletionFunctor A a).obj
          ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj F)) ≅
        (derivedGlobalSectionsOver f).obj
          ((DerivedCategory.singleFunctor X.Modules 0).obj
            (limit (adicQuotientSystem (baseIdealSheaf A (Ideal.span (Set.range a)) f) F)))) := by
  obtain ⟨e₁⟩ := nonempty_iso_derivedCompletion_derivedGlobalSections_baseSiteRingHom f a
    ((DerivedCategory.singleFunctor X.Modules 0).obj F)
  obtain ⟨e₂⟩ := nonempty_iso_derivedCompletion_limit_adicQuotients_baseIdealSheaf f a F
  have Φ := derivedGlobalSectionsOverSiteIso f
  refine ⟨((DerivedCompletion.derivedCompletionFunctor A a).mapIso
      (Φ.app ((DerivedCategory.singleFunctor X.Modules 0).obj F))).symm ≪≫ e₁.symm ≪≫
    (siteDerivedGlobalSections f).mapIso e₂ ≪≫ Φ.app _⟩

/-- **The identity of [Stacks, Tag 0BLX] at `I · 𝒪_X`, for every reflector onto the
derived-complete objects of `D(A)`.** This is the shape in which
`Stacks.Algebraization.exists_shortExact_adicCompletion_cohomology` consumes it: the library
fixes no choice of reflector, so the hypothesis is quantified over all of them, which by
uniqueness of left adjoints is no stronger than naming one.

The named reflector `DerivedCompletion.derivedCompletionFunctor A a` is identified with an
arbitrary one by `CategoryTheory.ObjectProperty.isoOfReflection`: both are reflections of `D(A)`
onto the objects derived complete along `(a_1, …, a_r)`. -/
theorem hBLX_baseIdealSheaf [IsNoetherian X] (F : X.Modules) [F.IsCoherent] :
    ∀ (C : DerivedCategory (ModuleCat.{u} A) ⥤
        (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
          fun L ↦ IsDerivedComplete (Ideal.span (Set.range a)) L).FullSubcategory)
        (_ : C ⊣ (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
          fun L ↦ IsDerivedComplete (Ideal.span (Set.range a)) L).ι),
      Nonempty
        ((C.obj ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj F))).obj ≅
          (derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj
              (limit (adicQuotientSystem
                (baseIdealSheaf A (Ideal.span (Set.range a)) f) F)))) := by
  intro C adj
  have : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  obtain ⟨e⟩ := nonempty_iso_derivedCompletion_derivedGlobalSections_baseIdealSheaf f a F
  exact ⟨ObjectProperty.isoOfReflection
    (fun L ↦ IsDerivedComplete (Ideal.span (Set.range a)) L)
    adj.unit (DerivedCompletion.derivedCompletionUnit A a)
    (fun Z ↦ (C.obj Z).property)
    (DerivedCompletion.derivedCompletion_isReflection A a).1
    (fun Z E' hE' ↦ ObjectProperty.bijective_precomp_adjunction_unit _ adj Z E' hE')
    (DerivedCompletion.derivedCompletion_isReflection A a).2 _ ≪≫ e⟩

/-- **The short exact sequence of [Stacks, Tag 0A0M] at an ideal presented by a finite generating
family.** Let `A` be a Noetherian ring, `a_1, …, a_r ∈ A`, `f : X ⟶ Spec A` a Noetherian scheme
over `A` and `ℱ` a coherent `𝒪_X`-module whose cohomology modules `H^p(X, ℱ)` are finite over
`A`. Write `I = (a_1, …, a_r)` and `𝓘 = I · 𝒪_X`. Then for every `p` the `I`-adic completion of
`H^p(X, ℱ)` sits in a short exact sequence of `A`-modules

`0 ⟶ R¹lim H^{p-1}(X, ℱ/𝓘ⁿℱ) ⟶ H^p(X, ℱ)^∧ ⟶ lim H^p(X, ℱ/𝓘ⁿℱ) ⟶ 0`.

This is `Stacks.Algebraization.exists_shortExact_adicCompletion_cohomology` with its hypothesis
`hBLX` discharged by `Stacks.Algebraization.hBLX_baseIdealSheaf`. -/
theorem exists_shortExact_adicCompletion_cohomology_of_fin_generating_family
    [IsNoetherianRing A] [IsNoetherian X] (F : X.Modules) [F.IsCoherent]
    (hfinite : ∀ p : ℤ, Module.Finite A
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) p).obj
        ((derivedGlobalSectionsOver f).obj
          ((DerivedCategory.singleFunctor X.Modules 0).obj F))))
    (p : ℤ) :
    let T : ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A) :=
      adicQuotientSystem (baseIdealSheaf A (Ideal.span (Set.range a)) f) F ⋙
        DerivedCategory.singleFunctor X.Modules 0 ⋙ derivedGlobalSectionsOver f
    let H : ℤ → DerivedCategory (ModuleCat.{u} A) ⥤ ModuleCat.{u} A := fun q ↦
      DerivedCategory.homologyFunctor (ModuleCat.{u} A) q
    ∃ (i : CompletionSequences.firstDerivedLimit A (T ⋙ H (p - 1)) ⟶
        ModuleCat.of A (AdicCompletion (Ideal.span (Set.range a))
          ((H p).obj ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj F)))))
      (q : ModuleCat.of A (AdicCompletion (Ideal.span (Set.range a))
          ((H p).obj ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj F)))) ⟶
        limit (T ⋙ H p))
      (w : i ≫ q = 0),
      (ShortComplex.mk i q w).ShortExact :=
  exists_shortExact_adicCompletion_cohomology_of_forall_reflector A (Ideal.span (Set.range a)) f F
    hfinite (hBLX_baseIdealSheaf f a F) p

/-! ### The properness clause in every degree -/

/-- **In negative degrees the cohomology tower of the adic quotients vanishes, so its first
derived inverse limit does.** `H^q(X, ℱ/𝓘ⁿℱ)` is the degree-`q` cohomology of derived global
sections of a sheaf placed in degree zero, which is zero for `q < 0`
(`Stacks.DerivedFunctor.isZero_homology_totalRightDerived_obj`); a tower of zero objects is
Mittag-Leffler, and a Mittag-Leffler tower has no `R¹lim`. -/
private theorem isZero_firstDerivedLimit_cohomology_adicQuotients_of_neg
    (𝓘 : X.IdealSheafData) (F : X.Modules) (q : ℤ) (hq : q < 0) :
    IsZero (CompletionSequences.firstDerivedLimit A
      ((adicQuotientSystem 𝓘 F ⋙ DerivedCategory.singleFunctor X.Modules 0 ⋙
          derivedGlobalSectionsOver f) ⋙
        DerivedCategory.homologyFunctor (ModuleCat.{u} A) q)) :=
  isZero_firstDerivedLimit_of_isMittagLefflerCategorical _
    (isMittagLefflerCategorical_of_isZero _ fun n =>
      Stacks.DerivedFunctor.isZero_homology_totalRightDerived_obj
        (AlgebraicGeometry.globalSectionsOver f)
        ((DerivedCategory.singleFunctor X.Modules 0).obj ((adicQuotientSystem 𝓘 F).obj n))
        0 q hq)

/-- **The properness clause of [Stacks, Tag 0A0M] in every degree.** For a proper
`f : X ⟶ Spec A` over a Noetherian base and a coherent `ℱ`, the `R¹lim` term of the tag's
sequence vanishes in every degree `q : ℤ`.

For `q ≥ 0` this is
`Stacks.Algebraization.isZero_firstDerivedLimit_cohomology_adicQuotients_of_isProper`, the
Mittag-Leffler condition of [Stacks, Tag 02OB]; for `q < 0` the tower is identically zero. -/
theorem isZero_firstDerivedLimit_cohomology_adicQuotients_of_isProper_int
    [IsNoetherianRing A] (I : Ideal A) [IsNoetherian X] (F : X.Modules) [F.IsCoherent]
    (hf : AlgebraicGeometry.IsProper f) (q : ℤ) :
    IsZero (CompletionSequences.firstDerivedLimit A
      ((adicQuotientSystem (baseIdealSheaf A I f) F ⋙
          DerivedCategory.singleFunctor X.Modules 0 ⋙ derivedGlobalSectionsOver f) ⋙
        DerivedCategory.homologyFunctor (ModuleCat.{u} A) q)) := by
  rcases lt_or_ge q 0 with hq | hq
  · exact isZero_firstDerivedLimit_cohomology_adicQuotients_of_neg f _ F q hq
  · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hq
    exact isZero_firstDerivedLimit_cohomology_adicQuotients_of_isProper A I f F hf n

/-! ### Tag 0A0M -/

/-- **Stacks Project, Tag 0A0M.** Let `A` be a Noetherian ring, `I ⊆ A` an ideal,
`f : X ⟶ Spec A` a Noetherian scheme over `A` and `ℱ` a coherent `𝒪_X`-module whose cohomology
modules `H^p(X, ℱ)` are finite over `A` — the hypotheses of the source, and nothing else. Write
`𝓘 = I · 𝒪_X`. Then for every `p`:

* the `I`-adic completion of the `A`-module `H^p(X, ℱ)` sits in a short exact sequence of
  `A`-modules

  `0 ⟶ R¹lim H^{p-1}(X, ℱ/𝓘ⁿℱ) ⟶ H^p(X, ℱ)^∧ ⟶ lim H^p(X, ℱ/𝓘ⁿℱ) ⟶ 0`,

  whose left term is the cokernel of `1 - shift` on the product of the degree-`(p-1)` cohomology
  tower and whose right term is the inverse limit of the degree-`p` cohomology tower; and
* **if `f` is proper the `R¹lim` term is zero**.

Both are the source's own assertions, at the source's own hypotheses, with nothing assumed. The
sequence is `Stacks.Algebraization.exists_shortExact_adicCompletion_cohomology`, whose single
input — the identification `RΓ(X, ℱ)^∧ ≅ RΓ(X, lim ℱ/𝓘ⁿℱ)` of [Stacks, Tag 0BLX] — is supplied
by `Stacks.Algebraization.hBLX_baseIdealSheaf`: `A` being Noetherian, `I = (a_1, …, a_r)`, and
`I · 𝒪_X` is then the ideal sheaf generated by the global sections `ρ a_i`, where the Koszul
identity of [Stacks, Tag 0BLX] and part (3) of [Stacks, Tag 0A0K] are both available. The
properness clause is
`Stacks.Algebraization.isZero_firstDerivedLimit_cohomology_adicQuotients_of_isProper_int`, which
rests on the Mittag-Leffler condition of [Stacks, Tag 02OB] and through it on the proper mapping
theorem [Stacks, Tag 02O5].

Derived `I`-adic completion is never introduced as data: a reflector onto the derived-complete
objects of `D(A)` exists by [Stacks, Tag 0920] and is produced inside the proof. -/
@[stacks 0A0M "the whole lemma, at the source's own hypotheses — `A` Noetherian, `I ⊆ A` an \
ideal, `f : X ⟶ Spec A` a Noetherian scheme over `A` and `ℱ` a coherent `𝒪_X`-module with every \
`H^p(X, ℱ)` finite over `A`: for every `p` the short exact sequence of `A`-modules \
`0 → R¹lim H^{p-1}(X, ℱ/𝓘ⁿℱ) → H^p(X,ℱ)^∧ → lim H^p(X, ℱ/𝓘ⁿℱ) → 0` whose middle term is the \
I-adic completion of the A-module H^p(X,ℱ), together with the vanishing of the R¹lim term for a \
proper f. The ideal is arbitrary: the identification of the middle term is the identity \
`RΓ(X,ℱ)^∧ = RΓ(X, lim ℱ/𝓘ⁿℱ)` of [Stacks, Tag 0BLX], got from the Koszul identity of that tag \
at the ideal sheaf generated by the images of a generating family of I — which a Noetherian A \
provides — and part (3) of [Stacks, Tag 0A0K]. The properness clause is the Mittag-Leffler \
condition of [Stacks, Tag 02OB], discharged from [Stacks, Tag 02O8]. The reflector onto the \
derived-complete objects of D(A) is produced in the proof out of [Stacks, Tag 0920]"]
theorem exists_shortExact_adicCompletion_cohomology_whole
    [IsNoetherianRing A] (I : Ideal A) [IsNoetherian X] (F : X.Modules) [F.IsCoherent]
    (hfinite : ∀ p : ℤ, Module.Finite A
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) p).obj
        ((derivedGlobalSectionsOver f).obj
          ((DerivedCategory.singleFunctor X.Modules 0).obj F))))
    (p : ℤ) :
    let T : ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A) :=
      adicQuotientSystem (baseIdealSheaf A I f) F ⋙
        DerivedCategory.singleFunctor X.Modules 0 ⋙ derivedGlobalSectionsOver f
    let H : ℤ → DerivedCategory (ModuleCat.{u} A) ⥤ ModuleCat.{u} A := fun q ↦
      DerivedCategory.homologyFunctor (ModuleCat.{u} A) q
    (∃ (i : CompletionSequences.firstDerivedLimit A (T ⋙ H (p - 1)) ⟶
        ModuleCat.of A (AdicCompletion I
          ((H p).obj ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj F)))))
      (q : ModuleCat.of A (AdicCompletion I
          ((H p).obj ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj F)))) ⟶
        limit (T ⋙ H p))
      (w : i ≫ q = 0),
      (ShortComplex.mk i q w).ShortExact) ∧
    (AlgebraicGeometry.IsProper f →
      IsZero (CompletionSequences.firstDerivedLimit A (T ⋙ H (p - 1)))) := by
  intro T H
  refine ⟨?_, fun hf ↦
    isZero_firstDerivedLimit_cohomology_adicQuotients_of_isProper_int f I F hf (p - 1)⟩
  obtain ⟨r, a, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp I.fg_of_isNoetherianRing
  change Ideal.span (Set.range a) = I at hf
  subst hf
  exact exists_shortExact_adicCompletion_cohomology_of_fin_generating_family f a F hfinite p

end Stacks.Algebraization

end
