-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open Stacks.Cohomology.FormalFunctions (baseIdealSheaf)

attribute [local instance 10000] Stacks.Algebraization.modulesHasDerivedCategory

universe u

namespace Stacks.Algebraization

variable (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A)
  {X : Scheme.{u}} [IsNoetherian X] (f : X ⟶ Spec (.of A)) (F : X.Modules) [F.IsCoherent]

omit [AlgebraicGeometry.IsNoetherian X] in
/-- **The properness clause of [Stacks, Tag 0A0M], with nothing assumed.** Let `A` be a
Noetherian ring, `I ⊆ A` an ideal, `f : X ⟶ Spec A` a *proper* morphism with `X` Noetherian and
`ℱ` a coherent `𝒪_X`-module; write `𝓘 = I · 𝒪_X`. Then for every `q` the `R¹lim` term of that
tag's sequence vanishes:

`R¹lim H^q(X, ℱ/𝓘ⁿℱ) = 0`,

in the cokernel model `CompletionSequences.firstDerivedLimit` — the cokernel of `1 - shift` on
the product of the tower — that the sequence of
`Stacks.Algebraization.exists_shortExact_cohomology_limit_adicQuotients` produces.

The source gets the vanishing from the Mittag-Leffler condition of [Stacks, Tag 02OB] for the
tower `n ↦ H^q(X, ℱ/𝓘ⁿℱ)`, and that is how it is got here:
`Stacks.Cohomology.FormalFunctions.exists_uniform_bound_idealPowerQuotient_of_reesFinite` proves
the condition from [Stacks, Tag 02O8], which
`Stacks.FormalFunctions.isReesFinite_cohomologyIdealPowerSystem` supplies;
`Stacks.Algebraization.isMittagLefflerCategorical_homologyDerivedGlobalSections` carries it from
the `(moduleGlobalSections X).rightDerived q` model to the unbounded model the sequence is
stated in; and `Stacks.Algebraization.isZero_firstDerivedLimit_of_isMittagLefflerCategorical`
turns it into the vanishing. No hypothesis on the tower is taken, and in particular nothing of
the Mittag-Leffler or "exists stabilizing data" kind: properness and coherence are all that
enter.

`q` runs over the natural numbers, which is the whole range in which the tower is not identically
zero: `H^q(X, ℱ/𝓘ⁿℱ)` is the degree-`q` cohomology of derived global sections of a sheaf placed
in degree zero, so it vanishes for `q < 0` by
`Stacks.DerivedFunctor.isZero_homology_totalRightDerived_obj`. -/
public theorem isZero_firstDerivedLimit_cohomology_adicQuotients_of_isProper
    (hf : AlgebraicGeometry.IsProper f) (q : ℕ) :
    IsZero (CompletionSequences.firstDerivedLimit A
      ((adicQuotientSystem (baseIdealSheaf A I f) F ⋙
          DerivedCategory.singleFunctor X.Modules 0 ⋙ derivedGlobalSectionsOver f) ⋙
        DerivedCategory.homologyFunctor (ModuleCat.{u} A) (q : ℤ))) := by
  obtain ⟨-, -, hML, -⟩ :=
    Stacks.Cohomology.FormalFunctions.exists_uniform_bound_idealPowerQuotient_of_reesFinite
      I f F hf (Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent'_of_isCoherent
        inferInstance) q Stacks.FormalFunctions.isReesFinite_cohomologyIdealPowerSystem
  exact isZero_firstDerivedLimit_of_isMittagLefflerCategorical _
    (isMittagLefflerCategorical_homologyDerivedGlobalSections f _ F q hML)

/-- **The conclusion [Stacks, Tag 0A0M] draws under its properness clause, with nothing
assumed.** With the hypotheses of
`Stacks.Algebraization.exists_shortExact_cohomology_limit_adicQuotients` and `f` proper,

`H^{q+1}(X, lim ℱ/𝓘ⁿℱ) ≅ lim H^{q+1}(X, ℱ/𝓘ⁿℱ)`.

This is `Stacks.Algebraization.exists_iso_cohomology_limit_adicQuotients_of_reesFinite` with its
hypothesis `h02O8` — [Stacks, Tag 02O8] — discharged by
`Stacks.FormalFunctions.isReesFinite_cohomologyIdealPowerSystem`. -/
public theorem exists_iso_cohomology_limit_adicQuotients_of_isProper
    (hfinite : ∀ p : ℤ, Module.Finite A
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) p).obj
        ((derivedGlobalSectionsOver f).obj
          ((DerivedCategory.singleFunctor X.Modules 0).obj F))))
    (hf : AlgebraicGeometry.IsProper f) (q : ℕ) :
    Nonempty
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) ((q : ℤ) + 1)).obj
          ((derivedGlobalSectionsOver f).obj
            ((DerivedCategory.singleFunctor X.Modules 0).obj
              (limit (adicQuotientSystem (baseIdealSheaf A I f) F)))) ≅
        limit ((adicQuotientSystem (baseIdealSheaf A I f) F ⋙
              DerivedCategory.singleFunctor X.Modules 0 ⋙ derivedGlobalSectionsOver f) ⋙
          DerivedCategory.homologyFunctor (ModuleCat.{u} A) ((q : ℤ) + 1))) :=
  exists_iso_cohomology_limit_adicQuotients_of_reesFinite A I f F hfinite hf q
    Stacks.FormalFunctions.isReesFinite_cohomologyIdealPowerSystem

end Stacks.Algebraization

end
