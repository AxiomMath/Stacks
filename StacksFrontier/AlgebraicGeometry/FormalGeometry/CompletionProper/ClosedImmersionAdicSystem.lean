module

public import StacksFrontier.AlgebraicGeometry.CoherentPushforwardCriteria.ClosedImmersionCoherence
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionProper.ClosedImmersionCompletion

/-!
# Coherent adic systems and the direct image along a closed immersion

Let `i : Z ⟶ X` be a closed immersion of locally Noetherian schemes and `ℐ ⊆ 𝒪_X` a
quasi-coherent sheaf of ideals, with inverse image `ℐ 𝒪_Z = ℐ.comap i`. Termwise direct image
carries `Coh(Z, ℐ 𝒪_Z)` into `Coh(X, ℐ)`. This file proves:

* a system of coherent `𝒪_Z`-modules whose termwise direct image is a coherent adic system along
  `ℐ` is a coherent adic system along `ℐ 𝒪_Z`;
* an inverse system of coherent `𝒪_X`-modules annihilated by the ideal of `i` *is* a termwise
  direct image, up to isomorphism.

## Main results

* `Stacks.Coherent.idealPowerMultiple_pushforward_eq_bot_iff`: a module on `Z` is annihilated by
  `(ℐ 𝒪_Z) ᵐ` exactly when its direct image is annihilated by `ℐ ᵐ`.
* `Stacks.Coherent.bijective_whiskerRight_pushforward`: direct image is bijective on morphisms
  of inverse systems of modules.
* `Stacks.Coherent.isCoherentAdicSystem_of_pushforward`: membership in `Coh(-, -)` descends
  along direct image.
* `Stacks.Coherent.exists_system_pushforward_iso`: an inverse system of coherent `𝒪_X`-modules
  annihilated by the ideal of `i` is a termwise direct image.

## Implementation notes

Annihilation descends because the preimages of the affine opens of `X` are a basis of the
topology of `Z` (`Stacks.Algebraization.exists_affineOpen_preimage_le`) and the ideal of `ℐ 𝒪_Z`
on such a chart is generated by the image of the ideal of `ℐ`
(`Stacks.Algebraization.ideal_comap_preimage`), so
`Stacks.Algebraization.idealPowerMultiple_le_of_basis` applies. In the other direction no basis
is needed: every affine open of `X` is a chart.

Membership in `Coh(-, -)` is descended through
`Stacks.Coherent.isCoherentAdicSystem_iff_precomp_bijective`, which replaces the quotient clause
`F_{n+1} / ℐ ⁿ⁺¹ F_{n+1} ≅ F_n` by bijectivity of precomposition with the transition map on maps
into the coherent modules annihilated by `ℐ ⁿ⁺¹`. Those test objects are matched across `i_*` by
pushing a test object on `Z` forward, and bijectivity is transported by
`Stacks.Coherent.precomp_map_bijective_iff` out of full faithfulness of `i_*`
([Stacks, Tag 08KS]).

The system upstairs is assembled by hand rather than through the essential-image equivalence of a
fully faithful functor: each term is produced by [Stacks, Tag 087T], the transition maps are the
preimages under `i_*` of the transitions downstairs conjugated by the chosen isomorphisms, and
`CategoryTheory.Functor.ofOpSequence` and `CategoryTheory.NatTrans.ofOpSequence` assemble the
functor and the comparison from their successor-step data.

## References

* [Stacks Project, Tag 088A](https://stacks.math.columbia.edu/tag/088A)
* [Stacks Project, Tag 087T](https://stacks.math.columbia.edu/tag/087T)
* [Stacks Project, Tag 08KS](https://stacks.math.columbia.edu/tag/08KS)
* [Stacks Project, Tag 087W](https://stacks.math.columbia.edu/tag/087W)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open scoped AlgebraicGeometry

universe u

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

namespace Stacks.Coherent

open Stacks.Algebraization Stacks.AlgebraicGeometry.Tag087TCoherentImage

section ClosedImmersion

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
  [IsLocallyNoetherian X] [IsLocallyNoetherian Z]

/-! ### Annihilation across the direct image -/

omit [IsLocallyNoetherian X] [IsLocallyNoetherian Z] in
/-- A module on `Z` is annihilated by `(ℐ 𝒪_Z) ᵐ` exactly when its direct image is annihilated
by `ℐ ᵐ`.

In both directions the scalar action on the sections of `i_* M` over an affine open `U` of `X` is
the action on the sections of `M` over `i ⁻¹ U` through the comorphism, and the ideal of `ℐ 𝒪_Z`
on `i ⁻¹ U` is generated by the image of the ideal of `ℐ` on `U`. The direction that descends the
annihilation needs the charts `i ⁻¹ U` to form a basis of the topology of `Z`; the other
direction needs nothing, every affine open of `X` being a chart. -/
public theorem idealPowerMultiple_pushforward_eq_bot_iff (I : X.IdealSheafData) (m : ℕ)
    (M : Z.Modules) :
    idealPowerMultiple I m ((Scheme.Modules.pushforward i).obj M) = ⊥ ↔
      idealPowerMultiple (I.comap i) m M = ⊥ := by
  have hmap : ∀ U : X.affineOpens, (I.comap i).ideal ⟨i ⁻¹ᵁ U.1, U.2.preimage i⟩ ^ m =
      Ideal.map (i.app U.1).hom (I.ideal U ^ m) := fun U => by
    rw [Ideal.map_pow, ideal_comap_preimage i I U]
  refine ⟨fun h => ?_, fun h => ?_⟩
  · refine idealPowerMultiple_eq_bot_of_basis (I.comap i) m M
      (fun U : X.affineOpens => (⟨i ⁻¹ᵁ U.1, U.2.preimage i⟩ : Z.affineOpens))
      (fun W z hz => exists_affineOpen_preimage_le i W z hz) ?_
    intro U c hc y
    rw [hmap U] at hc
    refine Submodule.span_induction
      (p := fun c _ => ∀ w : Γ(M, (⟨i ⁻¹ᵁ U.1, U.2.preimage i⟩ : Z.affineOpens).1), c • w = 0)
      ?_ ?_ ?_ ?_ hc y
    · rintro c ⟨a, ha, rfl⟩ w
      exact affine_sections_annihilated_of_idealPowerMultiple_eq_bot h U ha w
    · exact fun w => zero_smul _ w
    · intro c d _ _ hcw hdw w
      rw [add_smul, hcw w, hdw w, add_zero]
    · intro a c _ hcw w
      rw [smul_assoc, hcw w, smul_zero]
  · refine idealPowerMultiple_eq_bot_of_affine_sections_annihilated fun U r hr x => ?_
    have hr' : (i.app U.1).hom r ∈ (I.comap i).ideal ⟨i ⁻¹ᵁ U.1, U.2.preimage i⟩ ^ m :=
      hmap U ▸ Ideal.mem_map_of_mem _ hr
    exact affine_sections_annihilated_of_idealPowerMultiple_eq_bot h
      ⟨i ⁻¹ᵁ U.1, U.2.preimage i⟩ hr' x

/-! ### Direct image on morphisms -/

omit [IsLocallyNoetherian X] [IsLocallyNoetherian Z] in
/-- Termwise direct image is bijective on morphisms of inverse systems. Injectivity is
faithfulness in each degree; for surjectivity the degreewise preimages are natural because
`i_*` is faithful. -/
public theorem bijective_whiskerRight_pushforward (A B : ℕᵒᵖ ⥤ Z.Modules) :
    Function.Bijective (fun α : A ⟶ B =>
      Functor.whiskerRight α (Scheme.Modules.pushforward i)) := by
  let ff := Stacks.ClosedImmersion.fullyFaithfulPushforward i
  constructor
  · intro α β hab
    exact NatTrans.ext (funext fun n => ff.map_injective (NatTrans.congr_app hab n))
  · intro γ
    refine ⟨⟨fun n => ff.preimage (γ.app n), fun m n g => ff.map_injective ?_⟩,
      NatTrans.ext (funext fun n => ff.map_preimage (γ.app n))⟩
    rw [Functor.map_comp, Functor.map_comp, ff.map_preimage, ff.map_preimage]
    exact γ.naturality g

/-! ### Descending membership in the category of coherent adic systems -/

/-- A system of coherent `𝒪_Z`-modules whose termwise direct image is a coherent adic system
along `ℐ` is a coherent adic system along `ℐ 𝒪_Z`. -/
public theorem isCoherentAdicSystem_of_pushforward (I : X.IdealSheafData)
    (Q : ℕᵒᵖ ⥤ Z.Modules) (hQ : ∀ n : ℕᵒᵖ, (Q.obj n).IsCoherent)
    (h : IsCoherentAdicSystem I (Q ⋙ Scheme.Modules.pushforward i)) :
    IsCoherentAdicSystem (I.comap i) Q := by
  let ff := Stacks.ClosedImmersion.fullyFaithfulPushforward i
  rw [isCoherentAdicSystem_iff_precomp_bijective] at h ⊢
  refine ⟨fun n => ⟨hQ (op n), ?_⟩, fun n T hT => ?_⟩
  · exact (idealPowerMultiple_pushforward_eq_bot_iff i I (n + 1) (Q.obj (op n))).mp (h.1 n).2
  · have := hT.1
    have hTq : T.IsQuasicoherent := _root_.isQuasicoherent_of_isCoherent T
    have hiT : coherentAnnihilatedBy I (n + 1) ((Scheme.Modules.pushforward i).obj T) :=
      ⟨isCoherent_pushforward_closedImmersion i T,
        (idealPowerMultiple_pushforward_eq_bot_iff i I (n + 1) T).mpr hT.2⟩
    exact (precomp_map_bijective_iff (Scheme.Modules.pushforward i)
      (Q.map (homOfLE (Nat.le_succ n)).op)
      (ff.map_bijective (Q.obj (op n)) T) (ff.map_bijective (Q.obj (op (n + 1))) T)).mpr
      (h.2 n _ hiT)

/-! ### Recognizing a system as a direct image -/

omit [IsLocallyNoetherian X] in
/-- An inverse system of coherent `𝒪_X`-modules annihilated by the ideal of `i` is the termwise
direct image of a system of coherent `𝒪_Z`-modules.

Each term is a direct image by [Stacks, Tag 087T]; the transition maps are the preimages under
`i_*` of the transitions downstairs, conjugated by the chosen isomorphisms, and the comparison is
assembled from them with `CategoryTheory.NatTrans.ofOpSequence`. -/
public theorem exists_system_pushforward_iso (P : ℕᵒᵖ ⥤ X.Modules)
    (hcoh : ∀ n : ℕᵒᵖ, (P.obj n).IsCoherent)
    (hann : ∀ n : ℕᵒᵖ, AnnihilatedByKer i (P.obj n)) :
    ∃ Q : ℕᵒᵖ ⥤ Z.Modules, (∀ n : ℕᵒᵖ, (Q.obj n).IsCoherent) ∧
      Nonempty (Q ⋙ Scheme.Modules.pushforward i ≅ P) := by
  have hex : ∀ n : ℕ, ∃ G : Z.Modules, G.IsCoherent ∧
      Nonempty ((Scheme.Modules.pushforward i).obj G ≅ P.obj (op n)) := fun n =>
    have := hcoh (op n)
    exists_isCoherent_pushforward_iso i (P.obj (op n)) (hann (op n))
  choose Gobj hGcoh hGiso using hex
  let alpha : ∀ n : ℕ, (Scheme.Modules.pushforward i).obj (Gobj n) ≅ P.obj (op n) := fun n =>
    (hGiso n).some
  let ff := Stacks.ClosedImmersion.fullyFaithfulPushforward i
  let beta : ∀ n : ℕ, Gobj (n + 1) ⟶ Gobj n := fun n =>
    ff.preimage ((alpha (n + 1)).hom ≫ P.map (homOfLE (Nat.le_succ n)).op ≫ (alpha n).inv)
  refine ⟨Functor.ofOpSequence beta, fun n => hGcoh n.unop, ⟨?_⟩⟩
  have hnat : ∀ n : ℕ,
      (Functor.ofOpSequence beta ⋙ Scheme.Modules.pushforward i).map
          (homOfLE (n.le_add_right 1)).op ≫ (alpha n).hom =
        (alpha (n + 1)).hom ≫ P.map (homOfLE (n.le_add_right 1)).op := by
    intro n
    have h0 : (Functor.ofOpSequence beta).map (homOfLE (n.le_add_right 1)).op = beta n :=
      Functor.ofOpSequence_map_homOfLE_succ beta n
    have h1 : (Functor.ofOpSequence beta ⋙ Scheme.Modules.pushforward i).map
        (homOfLE (n.le_add_right 1)).op =
        (Scheme.Modules.pushforward i).map (beta n) :=
      congrArg (Scheme.Modules.pushforward i).map h0
    have h2 : (Scheme.Modules.pushforward i).map (beta n) =
        (alpha (n + 1)).hom ≫ P.map (homOfLE (Nat.le_succ n)).op ≫ (alpha n).inv :=
      ff.map_preimage _
    rw [h1, h2]
    exact (Category.assoc _ _ _).trans
      ((congrArg (fun k => (alpha (n + 1)).hom ≫ k)
        ((Category.assoc _ _ _).trans
          ((congrArg (fun k => P.map (homOfLE (Nat.le_succ n)).op ≫ k)
            (alpha n).inv_hom_id).trans (Category.comp_id _)))))
  let tau : Functor.ofOpSequence beta ⋙ Scheme.Modules.pushforward i ⟶ P :=
    NatTrans.ofOpSequence (fun n : ℕ => (alpha n).hom) hnat
  have hiso (n : ℕᵒᵖ) : IsIso (tau.app n) := inferInstanceAs (IsIso (alpha n.unop).hom)
  exact @asIso _ _ _ _ tau (NatIso.isIso_of_isIso_app _)

end ClosedImmersion

end Stacks.Coherent

end
