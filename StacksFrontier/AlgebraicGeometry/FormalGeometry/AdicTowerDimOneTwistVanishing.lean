/-!
# The uniform twisted vanishing of [Stacks, Tag 089A] for a tower of dimension at most one

The second paragraph of the proof of Grothendieck's algebraization theorem [Stacks, Tag 089A]
needs an integer `d₀` with `H¹(Xₙ₊₁, 𝓘ₙ ⊗ ℒₙ₊₁ ^⊗ d) = 0` for every `n` and every `d ≥ d₀`,
where `𝓘ₙ` is the ideal sheaf of `Xₙ` in `Xₙ₊₁`. When `X₀` has dimension at most one — the
situation of [Stacks, Tag 0E7R] — this follows without [Stacks, Tag 0897]:

* `𝓘ₙ` is generated by finitely many global sections, the images of generators of the ideal of
  `Sₙ` in `Sₙ₊₁` (the squares of the tower are cartesian), so it is a quotient of a finite free
  module, and so is `𝓘ₙ ⊗ ℒₙ₊₁ ^⊗ d`;
* the ideal of `X₀` annihilates `𝓘ₙ ⊗ ℒₙ₊₁ ^⊗ d`, and on a Noetherian space of dimension at most
  one `H¹` is right exact, so the vanishing reduces to that of `H¹(X₀, 𝒪^{⊕ r} ⊗ ℒ₀ ^⊗ d)`, which
  holds for `d` beyond a bound depending on `X₀` and `ℒ₀` alone ([Stacks, Tag 0B5T]).

## Main results

* `Stacks.AdicTowerDimOne.epi_freeHomEquiv_symm_of_mem_span`: a family of global sections whose
  values span the sections over every affine open generates the module.
* `Stacks.AdicTowerDimOne.epi_idealGenerators`: the ideal sheaf of `Xₙ` in `Xₙ₊₁` is a quotient
  of a finite free module.
* `Stacks.AdicTowerDimOne.exists_uniform_isZero_rightDerived_one_idealSheafTensor`: the uniform
  vanishing itself, in the shape
  `Stacks.AmpleFormalSystemTheorem.surjective_transitionSections_of_isZero_h1` consumes.

## References

* [Stacks Project, Tag 089A](https://stacks.math.columbia.edu/tag/089A)
* [Stacks Project, Tag 0E7R](https://stacks.math.columbia.edu/tag/0E7R)
* [Stacks Project, Tag 0B5T](https://stacks.math.columbia.edu/tag/0B5T)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.AdicTowerDimOne

/-- **A family of global sections spanning the sections over every affine open generates.** Let
`F` be an `𝒪_X`-module and `s` a family of global sections of `F` such that over every affine
open `U` the values of `s` span `Γ(U, F)` over `Γ(U, 𝒪_X)`. Then `⊕ 𝒪_X ⟶ F` given by `s` is an
epimorphism: every germ of `F` is the germ of a section over an affine open, hence a combination
of the germs of the `s i`. -/
theorem epi_freeHomEquiv_symm_of_mem_span {X : Scheme.{u}} (F : X.Modules) {ι : Type u}
    (s : ι → F.sections)
    (h : ∀ (U : X.affineOpens) (m : Γ(F, U)),
      m ∈ Submodule.span Γ(X, U)
        (Set.range fun i => (show Γ(F, U) from (s i).eval (op (U : X.Opens))))) :
    Epi (F.freeHomEquiv.symm s) := by
  rw [Stacks.AlgebraicGeometry.FlatBaseChange.generates_iff_span_germTop_eq_top]
  intro x
  refine eq_top_iff.mpr fun y _ => ?_
  obtain ⟨V, hxV, m, rfl⟩ := TopCat.Presheaf.germ_exist F.val.presheaf y
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.2
  rw [← TopCat.Presheaf.germ_res_apply F.val.presheaf (homOfLE hWV) x hxW m]
  have key : ∀ z ∈ Submodule.span Γ(X, W)
      (Set.range fun i => (show Γ(F, W) from (s i).eval (op W))),
      TopCat.Presheaf.germ F.val.presheaf W x hxW z ∈ Submodule.span
        (R := ToType (X.presheaf.stalk x)) (Set.range fun i ↦
          Stacks.AlgebraicGeometry.FlatBaseChange.germTop F x ((s i).eval (op ⊤))) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      refine Submodule.subset_span ⟨i, ?_⟩
      show (TopCat.Presheaf.germ F.val.presheaf ⊤ x trivial) ((s i).eval (op ⊤)) = _
      rw [← TopCat.Presheaf.germ_res_apply F.val.presheaf (homOfLE le_top) x hxW]
      congr 1
      exact (s i).2 (homOfLE (le_top : W ≤ ⊤)).op
    | zero =>
      convert Submodule.zero_mem _ using 1
      exact map_zero _
    | add a b _ _ ha hb =>
      convert Submodule.add_mem _ ha hb using 1
      exact map_add _ a b
    | smul r a _ ha =>
      convert Submodule.smul_mem _ ((X.presheaf.germ W x hxW).hom r) ha using 1
      exact PresheafOfModules.germ_smul (R := X.presheaf) F.val x W hxW r a
  exact key _ (h ⟨W, hW⟩ (F.val.presheaf.map (homOfLE hWV).op m))

/-! ### Global generators of the ideal sheaf of `Xₙ` in `Xₙ₊₁` -/

variable {A : Type u} [CommRing A] {I : Ideal A}

variable (A I) in
/-- **The ideal of `Sₙ` in `Sₙ₊₁`**, on global sections of `Sₙ₊₁ = Spec (A / I ^ (n + 2))`. -/
abbrev thickeningIdeal (n : ℕ) : Ideal Γ(adicThickening A I (n + 1), ⊤) :=
  RingHom.ker (adicThickeningSucc A I n).appTop.hom

variable (A I) in
/-- The ideal of `Sₙ` in `Sₙ₊₁` is finitely generated, the ring of `Sₙ₊₁` being a quotient of
the Noetherian ring `A`. -/
theorem fg_thickeningIdeal [IsNoetherianRing A] (n : ℕ) : (thickeningIdeal A I n).FG := by
  have : IsNoetherianRing Γ(adicThickening A I (n + 1), ⊤) :=
    isNoetherianRing_of_ringEquiv _
      (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ I ^ (n + 1 + 1)))).symm.commRingCatIsoToRingEquiv
  exact IsNoetherian.noetherian _

variable (A I) in
/-- A finite generating set of the ideal of `Sₙ` in `Sₙ₊₁`. -/
def idealGenerators [IsNoetherianRing A] (n : ℕ) : Finset Γ(adicThickening A I (n + 1), ⊤) :=
  (fg_thickeningIdeal A I n).choose

/-- The chosen generators span the ideal of `Sₙ` in `Sₙ₊₁`. -/
theorem span_idealGenerators [IsNoetherianRing A] (n : ℕ) :
    Ideal.span (idealGenerators A I n : Set Γ(adicThickening A I (n + 1), ⊤)) =
      thickeningIdeal A I n :=
  (fg_thickeningIdeal A I n).choose_spec

/-- Each chosen generator lies in the ideal of `Sₙ` in `Sₙ₊₁`. -/
theorem mem_thickeningIdeal_of_mem_idealGenerators [IsNoetherianRing A] (n : ℕ)
    (g : idealGenerators A I n) : (g : Γ(adicThickening A I (n + 1), ⊤)) ∈ thickeningIdeal A I n :=
  span_idealGenerators (A := A) (I := I) n ▸ Ideal.subset_span g.2

variable {Xn : ℕ → Scheme.{u}}
  (q : ∀ n, Xn n ⟶ adicThickening A I n) (t : ∀ n, Xn n ⟶ Xn (n + 1))
  (hcart : ∀ n, IsPullback (t n) (q n) (q (n + 1)) (adicThickeningSucc A I n))

include hcart in
/-- A function on `Sₙ₊₁` vanishing on `Sₙ` pulls back to a function on `Xₙ₊₁` vanishing on
`Xₙ`, the square being commutative. -/
theorem appTop_transition_eq_zero (n : ℕ) (g : Γ(adicThickening A I (n + 1), ⊤))
    (hg : g ∈ thickeningIdeal A I n) : (t n).appTop.hom ((q (n + 1)).appTop.hom g) = 0 := by
  have h := congrArg (fun f => f.appTop.hom g) (hcart n).w
  simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
  rw [h, RingHom.mem_ker.mp hg, map_zero]

/-- The inclusion of the ideal sheaf of `Xₙ` in `Xₙ₊₁` into the structure sheaf, on sections over
an open. -/
abbrev idealInclusionApp (n : ℕ) (U : (Xn (n + 1)).Opens) :=
  (kernel.ι (SheafOfModules.unitToPushforwardObjUnit (t n).toRingCatSheafHom)).val.app (op U)

include hcart in
/-- The pullback to `Xₙ₊₁` of a generator of the ideal of `Sₙ` is a global section of the ideal
sheaf of `Xₙ`. -/
theorem exists_idealSection [IsNoetherianRing A] (n : ℕ) (g : idealGenerators A I n) :
    ∃ x : Γ(Stacks.AdicTower.transitionIdeal t n, ⊤),
      idealInclusionApp t n ⊤ x = (q (n + 1)).appTop.hom g :=
  ((Stacks.Thickenings.exact_app_idealSheafModule (t n) ⊤) _).mp
    (appTop_transition_eq_zero q t hcart n g (mem_thickeningIdeal_of_mem_idealGenerators n g))

/-- **The global sections of the ideal sheaf of `Xₙ` in `Xₙ₊₁`** pulled back from the generators
of the ideal of `Sₙ` in `Sₙ₊₁`. -/
def idealGeneratorSections [IsNoetherianRing A] (n : ℕ) (g : idealGenerators A I n) :
    (Stacks.AdicTower.transitionIdeal t n).sections :=
  (Stacks.NonvanishingSpelling.sectionsEquiv (Xn (n + 1))
    (Stacks.AdicTower.transitionIdeal t n)).symm (exists_idealSection q t hcart n g).choose

/-- Over any open `U`, the section `idealGeneratorSections` attached to a generator `g` is the
image of `g` in `Γ(Xₙ₊₁, U)`. -/
theorem idealInclusionApp_idealGeneratorSections [IsNoetherianRing A] (n : ℕ)
    (U : (Xn (n + 1)).Opens) (g : idealGenerators A I n) :
    idealInclusionApp t n U ((idealGeneratorSections q t hcart n g).eval (op U)) =
      (q (n + 1)).appLE ⊤ U le_top g := by
  rw [idealGeneratorSections, Stacks.NonvanishingSpelling.sectionsEquiv_symm_eval]
  refine (PresheafOfModules.naturality_apply
    (kernel.ι (SheafOfModules.unitToPushforwardObjUnit (t n).toRingCatSheafHom)).val
    (homOfLE (le_top : U ≤ ⊤)).op _).trans ?_
  show (Xn (n + 1)).presheaf.map _ (idealInclusionApp t n ⊤ _) = _
  rw [(exists_idealSection q t hcart n g).choose_spec]
  rfl

include hcart in
/-- **The ideal sheaf of `Xₙ` in `Xₙ₊₁` is a quotient of a finite free module**, by the
sections pulled back from generators of the ideal of `Sₙ` in `Sₙ₊₁`. Over an affine open `U`
of `Xₙ₊₁` the ideal of `Xₙ` is extended from that of `Sₙ`
(`Stacks.AdicTower.ideal_ker_transition`), hence generated by the images of the generators. -/
theorem epi_idealGenerators [IsNoetherianRing A] (n : ℕ) :
    Epi ((Stacks.AdicTower.transitionIdeal t n).freeHomEquiv.symm
      (idealGeneratorSections q t hcart n)) := by
  have := Stacks.AdicTower.isClosedImmersion_transition q t hcart n
  refine epi_freeHomEquiv_symm_of_mem_span _ _ fun U m => ?_
  have hm : (show Γ(Xn (n + 1), U) from idealInclusionApp t n U m) ∈ (t n).ker.ideal U := by
    rw [Scheme.Hom.ker_apply]
    exact (Stacks.Thickenings.exact_app_idealSheafModule (t n) U).apply_apply_eq_zero m
  rw [Stacks.AdicTower.ideal_ker_transition q t hcart n U] at hm
  change _ ∈ Ideal.map _ (thickeningIdeal A I n) at hm
  rw [← span_idealGenerators n, Ideal.map_span] at hm
  have key : ∀ y : Γ(Xn (n + 1), U), y ∈ Ideal.span ((Stacks.AdicTower.baseAppLE q n U).hom ''
      (idealGenerators A I n : Set Γ(adicThickening A I (n + 1), ⊤))) →
      ∃ m' ∈ Submodule.span Γ(Xn (n + 1), U) (Set.range fun g =>
        (show Γ(Stacks.AdicTower.transitionIdeal t n, U) from
          (idealGeneratorSections q t hcart n g).eval (op (U : (Xn (n + 1)).Opens)))),
        (show Γ(Xn (n + 1), U) from idealInclusionApp t n U m') = y := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨g, hg, rfl⟩ := hz
      exact ⟨_, Submodule.subset_span ⟨⟨g, hg⟩, rfl⟩,
        idealInclusionApp_idealGeneratorSections q t hcart n U ⟨g, hg⟩⟩
    | zero => exact ⟨0, Submodule.zero_mem _, map_zero _⟩
    | add a b _ _ ha hb =>
      obtain ⟨a', ha', rfl⟩ := ha
      obtain ⟨b', hb', rfl⟩ := hb
      exact ⟨a' + b', Submodule.add_mem _ ha' hb', map_add _ a' b'⟩
    | smul r a _ ha =>
      obtain ⟨a', ha', rfl⟩ := ha
      exact ⟨r • a', Submodule.smul_mem _ r ha', (idealInclusionApp t n U).hom.map_smul r a'⟩
  obtain ⟨m', hm', he⟩ := key _ hm
  rwa [← Stacks.Thickenings.injective_app_idealSheafModule (t n) U he]

/-! ### The vanishing on the closed member -/

open Stacks.Ample Stacks.RelativeVeryAmple in
/-- **`H¹` of the inverse image of a free twist.** Let `j : X₀ ⟶ X` be a morphism of schemes,
`L` an invertible `𝒪_X`-module whose inverse image is isomorphic to an invertible `𝒪_{X₀}`-module
`L₀`, and `κ` a finite type. If `H¹(X₀, 𝒪 ⊗ L₀ ^⊗ d) = 0` then
`H¹(X₀, j^*(𝒪^{⊕ κ} ⊗ L ^⊗ d)) = 0`: inverse image commutes with tensor products, free modules
and tensor powers, and a free twist is a finite coproduct of copies of the twist. -/
theorem isZero_rightDerived_one_pullback_freeTwist {X₀ X : Scheme.{u}} (j : X₀ ⟶ X)
    (κ : Type u) [Finite κ] (L : X.Modules) [IsInvertibleModule X L] (L₀ : X₀.Modules)
    [IsInvertibleModule X₀ L₀] (ψ : (Scheme.Modules.pullback j).obj L ≅ L₀) (d : ℕ)
    (h : IsZero (Hgroup X₀.ringCatSheaf ⊤ 1
      (tensorModules X₀ (Stacks.SectionRingGeometric.unitModule X₀)
        (tensorPowModule X₀ L₀ (d : ℤ))))) :
    IsZero (((moduleGlobalSections X₀).rightDerived 1).obj ((Scheme.Modules.pullback j).obj
      (tensorModules X (SheafOfModules.free κ) (tensorPowModule X L (d : ℤ))))) := by
  have h1 := Stacks.AlgebraicGeometry.AmpleTwistAcyclicity.isZero_Hgroup_tensorModules_free X₀
    (Stacks.SectionRingGeometric.unitModule X₀) L₀ κ 1 d h
  let e : (Scheme.Modules.pullback j).obj
      (tensorModules X (SheafOfModules.free κ) (tensorPowModule X L (d : ℤ))) ≅
      tensorModules X₀ (tensorModules X₀ (SheafOfModules.free κ)
        (Stacks.SectionRingGeometric.unitModule X₀)) (tensorPowModule X₀ L₀ (d : ℤ)) :=
    pullbackTensorModulesIso j _ _ ≪≫ tensorModulesMapIso X₀
      (Scheme.Modules.pullbackFreeIso j κ ≪≫
        (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X₀ _).symm)
      (pullbackTensorPowModuleIso j L d ≪≫ tensorPowModuleIsoOfIso X₀ _ L₀ ψ d)
  exact (Stacks.Cohomology.Affine.isZero_rightDerived_evaluation_of_isZero_Hgroup
    X₀.ringCatSheaf ⊤ 1 _ h1).of_iso (((moduleGlobalSections X₀).rightDerived 1).mapIso e)

variable (L : ∀ n, (Xn n).Modules) (hL : ∀ n, Stacks.Ample.IsInvertibleModule (Xn n) (L n))
  (φ : ∀ n, (Scheme.Modules.pullback (t n)).obj (L (n + 1)) ≅ L n)

/-- **The members of a compatible system of modules pull back to the first one** along the
composite inclusions `X₀ ⟶ Xₙ` of the tower. -/
def inclPullbackIso : ∀ n, (Scheme.Modules.pullback (Stacks.AdicTower.incl t n)).obj (L n) ≅ L 0
  | 0 => (Scheme.Modules.pullbackId (Xn 0)).app (L 0)
  | n + 1 =>
      ((Scheme.Modules.pullbackComp (Stacks.AdicTower.incl t n) (t n)).app (L (n + 1))).symm ≪≫
        (Scheme.Modules.pullback (Stacks.AdicTower.incl t n)).mapIso (φ n) ≪≫ inclPullbackIso n

include hcart φ in
open Stacks.Ample in
/-- **The uniform twisted vanishing of the proof of [Stacks, Tag 089A], in dimension at most
one.** Let `A` be a Noetherian ring, `I ⊆ A` an ideal, and `X₀ ⟶ X₁ ⟶ ⋯` a tower over the
thickenings `Sₙ = Spec (A / I ^ (n + 1))` with cartesian squares, `X₀` proper over `S₀` of
dimension at most one. Let `ℒₙ` be invertible `𝒪_{Xₙ}`-modules with `ℒ₀` ample and
`φₙ : iₙ^* ℒₙ₊₁ ≅ ℒₙ`. Then for every `d₁` there is `d ≥ d₁` with
`H¹(Xₙ₊₁, 𝓘ₙ ⊗ ℒₙ₊₁ ^⊗ d) = 0` for every `n`, `𝓘ₙ` the ideal sheaf of `Xₙ` in `Xₙ₊₁`.

`𝓘ₙ ⊗ ℒₙ₊₁ ^⊗ d` is a quotient of `𝒪^{⊕ r} ⊗ ℒₙ₊₁ ^⊗ d` (`epi_idealGenerators`) annihilated by
the ideal of `X₀` (`smul_idealSheafTensor_eq_zero`), so by right exactness of `H¹` in dimension
at most one (`isZero_rightDerived_one_of_epi_of_smul_eq_zero`) it suffices that
`H¹(X₀, 𝒪^{⊕ r} ⊗ ℒ₀ ^⊗ d) = 0`, which holds for `d ≥ d₀` with `d₀` given by clause (4) of
[Stacks, Tag 0B5T] at `𝒪_{X₀}`, independently of `n` and `r`. -/
theorem exists_uniform_isZero_rightDerived_one_idealSheafTensor [IsNoetherianRing A]
    [IsProper (q 0)] (hample : letI := hL 0; IsAmple (Xn 0) (L 0))
    (hdim : topologicalKrullDim (Xn 0 : Type u) ≤ 1) :
    ∀ d₁ : ℕ, ∃ d : ℕ, d₁ ≤ d ∧ ∀ n : ℕ,
      IsZero (((AlgebraicGeometry.moduleGlobalSections (Xn (n + 1))).rightDerived 1).obj
        ((((Stacks.SheafOfModules.Tensor.sheafTensor
              ⟨((Xn (n + 1)).toRingedSpace).presheaf, ((Xn (n + 1)).toRingedSpace).IsSheaf⟩).obj
            (Stacks.ClosedImmersion.idealSheaf (t n).toLRSHom.toShHom)).obj
          (letI := hL (n + 1); tensorPowModule (Xn (n + 1)) (L (n + 1)) (d : ℤ))))) := by
  intro d₁
  let := hL 0
  have : IsLocallyNoetherian (Xn 0) := LocallyOfFiniteType.isLocallyNoetherian (q 0)
  have : CompactSpace (Xn 0 : Type u) := QuasiCompact.compactSpace_of_compactSpace (q 0)
  have : AlgebraicGeometry.IsNoetherian (Xn 0) := ⟨⟩
  have : NoetherianSpace (Xn 0 : Type u) := AlgebraicGeometry.IsNoetherian.noetherianSpace
  have : _root_.SheafOfModules.IsCoherent (Stacks.SectionRingGeometric.unitModule (Xn 0)) :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_unit
  obtain ⟨d₀, hd₀⟩ :=
    Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_isZero_Hgroup_tensorPowTwist (q 0)
      (Stacks.SectionRingGeometric.unitModule (Xn 0)) (L 0) hample
  refine ⟨max d₁ d₀, le_max_left _ _, fun n => ?_⟩
  let := hL (n + 1)
  have := Stacks.AdicTower.isClosedImmersion_incl q t hcart (n + 1)
  have := noetherianSpace_level q t hcart (n + 1)
  have hdim' : topologicalKrullDim (Xn (n + 1) : Type u) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    rw [topologicalKrullDim_level q t hcart (n + 1)]
    exact hdim
  let T := tensorPowModule (Xn (n + 1)) (L (n + 1)) ((max d₁ d₀ : ℕ) : ℤ)
  let O : TopCat.Sheaf CommRingCat (Xn (n + 1) : TopCat) :=
    ⟨((Xn (n + 1)).toRingedSpace).presheaf, ((Xn (n + 1)).toRingedSpace).IsSheaf⟩
  let π := (Stacks.AdicTower.transitionIdeal t n).freeHomEquiv.symm
    (idealGeneratorSections q t hcart n)
  have : Epi (C := SheafOfModules (Stacks.SheafOfModules.Tensor.ringSheaf O)) π :=
    epi_idealGenerators q t hcart n
  have := Stacks.SheafOfModules.FlatSheafification.sheafTensorRight_preservesColimits
    (Opens.grothendieckTopology (Xn (n + 1) : TopCat)) O T
  have := preservesColimitsOfSize_shrink.{0, u, 0, u}
    ((Stacks.SheafOfModules.Tensor.sheafTensor O).flip.obj T)
  let p := ((Stacks.SheafOfModules.Tensor.sheafTensor O).flip.obj T).map π
  exact @isZero_rightDerived_one_of_epi_of_smul_eq_zero _ _ (Stacks.AdicTower.incl t (n + 1)) _ _
    hdim' _ _ p
    (preserves_epi_of_preservesColimit ((Stacks.SheafOfModules.Tensor.sheafTensor O).flip.obj T) π)
    (smul_idealSheafTensor_eq_zero q t hcart n T)
    (isZero_rightDerived_one_pullback_freeTwist (Stacks.AdicTower.incl t (n + 1))
      (idealGenerators A I n) (L (n + 1)) (L 0) (inclPullbackIso t L φ (n + 1)) _
      (hd₀ _ 1 (le_max_right _ _) one_pos))

end Stacks.AdicTowerDimOne

end
