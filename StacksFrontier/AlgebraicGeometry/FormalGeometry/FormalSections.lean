module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.NearVanishing
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.AdicQuotientSystem
public import StacksFrontier.RingTheory.LocalCohomology.UniformCohomologyBound

/-!
# Formal sections on the complement of a closed subset of an affine scheme

Let `I ⊆ 𝔞` be ideals of a commutative ring `A` and let `U = Spec(A) \ V(𝔞)`. For a module `F`
on `U` the algebraization statements of Stacks chapter 52 compare sections of `F` near
`U ∩ V(I)` with compatible families of sections of the quotients `F / Iⁿ F` on all of `U`.

This file sets up the right-hand side of that comparison. The ideal `I` is transported to `U`
as the quasi-coherent ideal sheaf it generates there, the quotients `F / Iⁿ F` are the
tower `Stacks.Algebraization.adicQuotientSystem`, and `formalSections` evaluates that tower on
all of `U`. A compatible family of such sections — an element of `limit (formalSections …)` —
is a *formal section* of `F` along `U ∩ V(I)`.

## Main definitions

* `Stacks.Algebraization.idealSheafNearVanishing` — the ideal sheaf `I · 𝒪_U` on `U`.
* `Stacks.Algebraization.quotientSystemNearVanishing` — the tower `n ↦ F / Iⁿ F` on `U`.
* `Stacks.Algebraization.formalSections` — the inverse system `n ↦ Γ(U, F / Iⁿ F)`.

## Implementation notes

The ideal sheaf is `Stacks.Cohomology.FormalFunctions.baseIdealSheaf` along the open immersion
`U ⟶ Spec A`, which is the quasi-coherent ideal sheaf generated by the image of `I` in the
global functions of `U`. The tower is zero-indexed by the exponent itself, so its term at `n`
is `F / Iⁿ F`; in particular its term at `0` is the zero sheaf, which is harmless and keeps the
indexing of the source.

## References

* [Stacks Project, Tag 0EG2](https://stacks.math.columbia.edu/tag/0EG2)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe u

namespace Stacks.Algebraization

open Stacks.LocalCohomology

/-- The quasi-coherent ideal sheaf `I · 𝒪_U` on `U = Spec(A) \ V(𝔞)`, generated by the image of
`I` under `A ⟶ Γ(U, 𝒪_U)`. -/
abbrev idealSheafNearVanishing (A : Type u) [CommRing A] (I a : Ideal A) :
    (complementZeroLocus A a : Scheme).IdealSheafData :=
  Stacks.Cohomology.FormalFunctions.baseIdealSheaf A I (complementZeroLocus A a).ι

/-- The tower of quotients `n ↦ F / Iⁿ F` of a module on `U = Spec(A) \ V(𝔞)`. -/
abbrev quotientSystemNearVanishing (A : Type u) [CommRing A] (I a : Ideal A)
    (F : (complementZeroLocus A a : Scheme).Modules) :
    ℕᵒᵖ ⥤ (complementZeroLocus A a : Scheme).Modules :=
  adicQuotientSystem (idealSheafNearVanishing A I a) F

/-- The inverse system `n ↦ Γ(U, F / Iⁿ F)` of sections on all of `U` of the ideal-power
quotients. Its limit is the group of formal sections of `F` along `U ∩ V(I)`. -/
def formalSections (A : Type u) [CommRing A] (I a : Ideal A)
    (F : (complementZeroLocus A a : Scheme).Modules) : ℕᵒᵖ ⥤ Ab.{u} :=
  quotientSystemNearVanishing A I a F ⋙
    Scheme.Modules.toPresheaf _ ⋙ (CategoryTheory.evaluation _ Ab.{u}).obj (op ⊤)

/-- The sections of `F / Iⁿ F` on all of `U`, as the system `formalSections` records them. -/
lemma formalSections_obj (A : Type u) [CommRing A] (I a : Ideal A)
    (F : (complementZeroLocus A a : Scheme).Modules) (n : ℕᵒᵖ) :
    (formalSections A I a F).obj n =
      ((quotientSystemNearVanishing A I a F).obj n).val.presheaf.obj (op ⊤) :=
  rfl

/-- The transition maps of `formalSections` are the transition maps of the quotient tower,
taken on sections over all of `U`. -/
lemma formalSections_map (A : Type u) [CommRing A] (I a : Ideal A)
    (F : (complementZeroLocus A a : Scheme).Modules) {m n : ℕᵒᵖ} (f : m ⟶ n) :
    (formalSections A I a F).map f =
      ((quotientSystemNearVanishing A I a F).map f).app ⊤ :=
  rfl

end Stacks.Algebraization

end
