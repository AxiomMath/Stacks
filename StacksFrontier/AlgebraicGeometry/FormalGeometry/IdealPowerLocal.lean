module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.IdealPowerQuasicoherent

/-!
# The sections of the ideal-power subsheaf, described locally

Let `X` be a scheme, `I` a quasi-coherent ideal sheaf on `X` and `M` a sheaf of modules. The
subsheaf `I ^ k M` is defined as the least subsheaf which, on every affine open `V`, contains
`I(V) ^ k · Γ(M, V)`; nothing in that definition says what a section of `I ^ k M` over an
arbitrary open *is*. This file says it:

> a section of `M` over `W` lies in `I ^ k M` exactly when every point of `W` has an affine
> neighbourhood `V ⊆ W` on which the section restricts into `I(V) ^ k · Γ(M, V)`.

No quasi-coherence of `M` is needed, which matters because `I ^ k M` is used for the inverse
limit `lim F_n` of a coherent adic system, and that limit is not quasi-coherent. Over an affine
open the description is strictly weaker than membership in the span itself; that stronger
statement needs quasi-coherence.

## Main definitions

* `Stacks.Algebraization.MemIdealPowerSpanNear` — a section lies in the ideal-power span near a
  point.
* `Stacks.Algebraization.localIdealPowerSpan` — the subsheaf of sections lying in the
  ideal-power span near every point of their domain.

## Main results

* `Stacks.Algebraization.map_mem_idealPowerSmul` — restriction carries the ideal-power span of
  an affine open into that of a smaller affine open.
* `Stacks.Algebraization.localIdealPowerSpan_eq` — the subsheaf of locally-spanned sections is
  `I ^ k M`.
* `Stacks.Algebraization.mem_idealPowerMultiple_iff` — the resulting description of the
  sections.

## Implementation notes

That restriction carries the span into the span is where the ideal sheaf's own axiom is used:
`AlgebraicGeometry.Scheme.IdealSheafData.map_ideal` says the ideal of a smaller affine open is
*generated by* the restriction of the larger one, which is more than the containment needed
here.

Both the additivity of `localIdealPowerSpan` and its stability under restriction need a single
affine open small enough for two constraints at once; `shrinkToAffine` is that step, taken from
the basis of affine opens, and it is where every proof in the file bottoms out.

The module structure on sections is declared over `X.ringCatSheaf.obj.obj U` in Mathlib's sheaf
files and over `Γ(X, U)` in its scheme files, and instance search does not cross the
`TopCat.Sheaf` definition between them; the bridging instances of
`Completion.IdealPowerQuasicoherent` are re-enabled here. For the same reason the step that
would naturally be `rw [M.val.map_smul]` is an explicit `congrArg`/`Eq.mpr` term: a rewrite
motive mixing the two presentations is not type-correct at the transparency `rw` builds it at,
and the restriction map's codomain is a `ModuleCat.restrictScalars` of the sections, a third
spelling again.

## References

* [Stacks Project, Tag 0EI8](https://stacks.math.columbia.edu/tag/0EI8)
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TopologicalSpace
open scoped AlgebraicGeometry

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

namespace Stacks.Algebraization

attribute [local instance] sectionsModuleΓ sectionsModuleΓSheaf sectionsModuleRingCatSheaf

variable {X : Scheme.{u}}

/-- Membership in the ideal-power span of an affine open transports along an equality. -/
private theorem mem_idealPowerSmul_of_eq (I : X.IdealSheafData) (k : ℕ) (M : X.Modules)
    {V : X.affineOpens} {a b : Γ(M, V.1)} (h : a = b)
    (hb : b ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V))) :
    a ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)) :=
  Eq.mpr (congrArg (· ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V))) h) hb

/-- **Restriction carries the ideal-power span into the ideal-power span.**

The ideal of the smaller affine open is generated by the restriction of the ideal of the larger
one, so a product `r · m` with `r ∈ I(W) ^ k` restricts to a product whose scalar lies in
`I(V) ^ k`. -/
public lemma map_mem_idealPowerSmul (I : X.IdealSheafData) (k : ℕ) (M : X.Modules)
    {V W : X.affineOpens} (h : V.1 ≤ W.1) {s : Γ(M, W.1)}
    (hs : s ∈ I.ideal W ^ k • (⊤ : Submodule Γ(X, W) Γ(M, W))) :
    M.val.map (homOfLE h).op s ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)) := by
  have hmapW : Ideal.map (X.presheaf.map (homOfLE h).op).hom (I.ideal W) = I.ideal V :=
    I.map_ideal (U := V) (V := W) h
  have hideal : Ideal.map (X.presheaf.map (homOfLE h).op).hom (I.ideal W ^ k) =
      I.ideal V ^ k := by
    rw [Ideal.map_pow, hmapW]
  refine Submodule.smul_induction_on hs ?_ ?_
  · intro r hr m _
    have hr' : (X.presheaf.map (homOfLE h).op).hom r ∈ I.ideal V ^ k := by
      rw [← hideal]
      exact Ideal.mem_map_of_mem _ hr
    exact mem_idealPowerSmul_of_eq I k M (M.val.map_smul (homOfLE h).op r m)
      (Submodule.smul_mem_smul hr' Submodule.mem_top)
  · intro y z hy hz
    exact mem_idealPowerSmul_of_eq I k M ((M.val.map (homOfLE h).op).hom.map_add y z)
      (Submodule.add_mem _ hy hz)

/-- A section lies in the **ideal-power span near a point** when some affine open containing
that point, inside the section's domain, carries the section into `I(V) ^ k · Γ(M, V)`. -/
public def MemIdealPowerSpanNear (I : X.IdealSheafData) (k : ℕ) (M : X.Modules)
    {W : X.Opens} (s : Γ(M, W)) (x : X) : Prop :=
  ∃ (V : X.affineOpens) (h : V.1 ≤ W), x ∈ V.1 ∧
    M.val.map (homOfLE h).op s ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V))

/-- **An affine witness can be shrunk inside any open neighbourhood of the point.**

This is the step both the additivity and the restriction-stability of
`Stacks.Algebraization.localIdealPowerSpan` reduce to. -/
public lemma shrinkToAffine (I : X.IdealSheafData) (k : ℕ) (M : X.Modules)
    {W : X.Opens} {s : Γ(M, W)} {x : X} (hs : MemIdealPowerSpanNear I k M s x)
    {O : X.Opens} (hO : O ≤ W) (hx : x ∈ O) :
    ∃ (V : X.affineOpens) (h : V.1 ≤ O), x ∈ V.1 ∧
      M.val.map (homOfLE (h.trans hO)).op s ∈
        I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)) := by
  obtain ⟨V₀, h₀, hxV₀, hspan⟩ := hs
  have hxinter : x ∈ (V₀.1 ⊓ O : X.Opens) := ⟨hxV₀, hx⟩
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVsub⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxinter (V₀.1 ⊓ O : X.Opens).2
  have hVV₀ : V ≤ V₀.1 := fun y hy => (hVsub hy).1
  have hVO : V ≤ O := fun y hy => (hVsub hy).2
  exact ⟨⟨V, hV⟩, hVO, hxV, mem_idealPowerSmul_of_eq I k M
    (M.val.map_comp_apply (homOfLE h₀).op (homOfLE hVV₀).op s)
    (map_mem_idealPowerSmul I k M hVV₀ hspan)⟩

/-- **The subsheaf of sections lying in the ideal-power span near every point.**

The membership condition is pointwise, hence local, which is what makes this a subsheaf; the
two closure properties need an affine open small enough for two witnesses at once. -/
public def localIdealPowerSpan (I : X.IdealSheafData) (k : ℕ) (M : X.Modules) :
    M.Submodule where
  toSubmodule :=
    { obj W :=
        { carrier := {s | ∀ x ∈ W.unop, MemIdealPowerSpanNear I k M (W := W.unop) s x}
          add_mem' := by
            intro s t hs ht x hx
            obtain ⟨V, h, hxV, hspan⟩ := shrinkToAffine I k M (hs x hx) (le_refl W.unop) hx
            obtain ⟨V', h', hxV', hspan'⟩ := shrinkToAffine I k M (ht x hx) h hxV
            refine ⟨V', h'.trans h, hxV', ?_⟩
            have hadd : M.val.map (homOfLE (h'.trans h)).op (s + t) =
                M.val.map (homOfLE (h'.trans h)).op s +
                  M.val.map (homOfLE (h'.trans h)).op t :=
              (M.val.map (homOfLE (h'.trans h)).op).hom.map_add s t
            refine Eq.mpr (congrArg (· ∈ I.ideal V' ^ k •
              (⊤ : Submodule Γ(X, V') Γ(M, V'))) hadd) (Submodule.add_mem _ ?_ hspan')
            have hcomp : M.val.map (homOfLE (h'.trans h)).op s =
                M.val.map (homOfLE h').op (M.val.map (homOfLE h).op s) :=
              M.val.map_comp_apply (homOfLE h).op (homOfLE h').op s
            exact Eq.mp (congrArg (· ∈ I.ideal V' ^ k •
              (⊤ : Submodule Γ(X, V') Γ(M, V'))) hcomp.symm)
              (map_mem_idealPowerSmul I k M h' hspan)
          zero_mem' := by
            intro x hx
            obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVsub⟩ :=
              X.isBasis_affineOpens.exists_subset_of_mem_open hx W.unop.2
            refine ⟨⟨V, hV⟩, hVsub, hxV, ?_⟩
            have hzero : M.val.map (homOfLE (show V ≤ W.unop from hVsub)).op
                (0 : Γ(M, W.unop)) = 0 :=
              (M.val.map (homOfLE (show V ≤ W.unop from hVsub)).op).hom.map_zero
            exact Eq.mpr (congrArg (· ∈ I.ideal (⟨V, hV⟩ : X.affineOpens) ^ k •
                (⊤ : Submodule Γ(X, (⟨V, hV⟩ : X.affineOpens))
                  Γ(M, (⟨V, hV⟩ : X.affineOpens)))) hzero)
              (Submodule.zero_mem _)
          smul_mem' := by
            intro r s hs x hx
            obtain ⟨V, h, hxV, hspan⟩ := hs x hx
            refine ⟨V, h, hxV, ?_⟩
            exact Eq.mpr (congrArg (· ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)))
                (M.val.map_smul (homOfLE h).op r s))
              (Submodule.smul_mem _ _ hspan) }
      map := by
        intro W W' f s hs x hx
        have hle : W'.unop ≤ W.unop := leOfHom f.unop
        obtain ⟨V, h, hxV, hspan⟩ := shrinkToAffine I k M (hs x (hle hx)) hle hx
        refine ⟨V, h, hxV, ?_⟩
        have hcomp : M.val.map (homOfLE (h.trans hle)).op s =
            M.val.map (homOfLE h).op (M.val.map f s) :=
          M.val.map_comp_apply f (homOfLE h).op s
        exact Eq.mp (congrArg (· ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)))
          hcomp) hspan }
  isSheaf := by
    intro W s hs x hx
    rw [Opens.mem_grothendieckTopology] at hs
    obtain ⟨O, i, hi, hxO⟩ := hs x hx
    have hi' : ∀ y ∈ O, MemIdealPowerSpanNear I k M (W := O) (M.val.map i.op s) y := hi
    obtain ⟨V, h, hxV, hspan⟩ := shrinkToAffine I k M (hi' x hxO) (le_refl O) hxO
    refine ⟨V, h.trans (leOfHom i), hxV, ?_⟩
    have hcomp : M.val.map (homOfLE (h.trans (leOfHom i))).op s =
        M.val.map (homOfLE h).op (M.val.map i.op s) :=
      M.val.map_comp_apply i.op (homOfLE h).op s
    exact Eq.mp (congrArg (· ∈ I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)))
      hcomp.symm) hspan

/-- **The locally-spanned sections are exactly the sections of `I ^ k M`.** -/
public theorem localIdealPowerSpan_eq (I : X.IdealSheafData) (k : ℕ) (M : X.Modules) :
    localIdealPowerSpan I k M = idealPowerMultiple I k M := by
  refine le_antisymm ?_ ((idealPowerMultiple_le_iff I k M _).2 fun V => ?_)
  · refine SheafOfModules.Submodule.le_iff.mpr (PresheafOfModules.Submodule.le_iff.mpr ?_)
    intro W s hs
    have hs' : ∀ x ∈ W.unop, MemIdealPowerSpanNear I k M (W := W.unop) s x := hs
    refine (idealPowerMultiple I k M).isSheaf s ?_
    rw [Opens.mem_grothendieckTopology]
    intro x hx
    obtain ⟨V, h, hxV, hspan⟩ := hs' x hx
    have hgen : I.ideal V ^ k • (⊤ : Submodule Γ(X, V) Γ(M, V)) ≤
        (idealPowerMultiple I k M).toSubmodule.obj (op V.1) :=
      (idealPowerMultiple_le_iff I k M (idealPowerMultiple I k M)).mp le_rfl V
    exact ⟨V.1, homOfLE h, hgen hspan, hxV⟩
  · intro s hs
    change ∀ x ∈ V.1, MemIdealPowerSpanNear I k M (W := V.1) s x
    intro x hx
    obtain ⟨_, ⟨V', hV', rfl⟩, hxV', hV'sub⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx V.1.2
    exact ⟨⟨V', hV'⟩, hV'sub, hxV', map_mem_idealPowerSmul I k M hV'sub hs⟩

/-- **The sections of `I ^ k M`, described locally.** A section of `M` over `W` lies in
`I ^ k M` exactly when it lies in the ideal-power span near every point of `W`. -/
public theorem mem_idealPowerMultiple_iff (I : X.IdealSheafData) (k : ℕ) (M : X.Modules)
    (W : X.Opens) (s : Γ(M, W)) :
    s ∈ (idealPowerMultiple I k M).toSubmodule.obj (op W) ↔
      ∀ x ∈ W, MemIdealPowerSpanNear I k M s x := by
  rw [← localIdealPowerSpan_eq I k M]
  exact Iff.rfl

end Stacks.Algebraization

