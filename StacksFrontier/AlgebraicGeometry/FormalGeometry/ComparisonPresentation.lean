/-!
# Finite presentations of coherent modules away from a vanishing locus

Let `A` be a Noetherian ring, `𝔞 ⊆ A` an ideal and `U = Spec(A) ∖ V(𝔞)`. A coherent module on
`U` is the restriction of the sheaf associated to a *finite* `A`-module, and a finite module is
generated by finitely many elements, so every coherent module on `U` is a quotient of a finite
free module.

On a Noetherian scheme a section of a coherent module over an open `V` is the value on the unit
section of a morphism out of a power `K ^ n · 𝒪_X` of an ideal sheaf whose vanishing locus
misses `V`; this is the surjectivity half of the sections clause of [Stacks, Tag 01YB], applied
to the vanishing ideal of the complement of `V`.

Combining the two with the pullback of a short exact sequence gives the input the comparison
argument of [Stacks, Tag 0H48] needs: for a short exact sequence `0 → F' → F → F'' → 0` of
coherent modules on `U` and a section `s` of `F''` over `V`, a finite free module maps to `F`
and onto `K ^ n · 𝒪_U`, compatibly with a morphism realizing `s`.

## Main results

* `Stacks.Algebraization.exists_epi_free_of_isCoherent` — a coherent module on the complement of
  the zero locus of an ideal in a Noetherian affine spectrum is a quotient of a finite free
  module.
* `Stacks.Algebraization.exists_idealPower_hom_of_section` — a section of a coherent module over
  an open of a Noetherian scheme is the value on the unit section of a morphism out of a power of
  an ideal sheaf whose support misses that open.
* `Stacks.Algebraization.exists_finite_lifting_generators` — the combination of the two along the
  pullback of a short exact sequence.

## Implementation notes

The ideal sheaf produced by `exists_idealPower_hom_of_section` is the vanishing ideal of the
closed complement of `V`, whose open complement is `V` itself; the section is transported along
that equality by substitution, which keeps the ideal sheaf opaque and so avoids unfolding
`Scheme.IdealSheafData.vanishingIdeal`.

Coherence of `K ^ n · 𝒪_X` and of a finite free module are both instances of
`Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType`: the
first is a quasi-coherent submodule of the structure sheaf, which is of finite type by
`Stacks.AlgebraicGeometry.CoherentTFAE.isFiniteType_of_mono`, and the second is a finite
coproduct of copies of the structure sheaf.

`AlgebraicGeometry.Scheme.Modules` is a `def`, so instance search does not see that a module on
a scheme is a sheaf of modules over `X.ringCatSheaf`; the closure properties of coherence and
the monomorphism of a submodule inclusion are stated at the latter spelling and are therefore
invisible on a scheme. Three devices keep the statements of this file on one side of that wall:
`Stacks.Ample.unitModule` and `AlgebraicGeometry.SheafOfModules.Submodule.toModules`, which are
`abbrev`s at `X.Modules`; the submodule inclusion
`AlgebraicGeometry.SheafOfModules.Submodule.ιModules`, whose `Mono` instance is stated at
`X.Modules`; and, for the kernel of the epimorphism produced below, a local
`instance_reducible` attribute together with an explicit application of
`AlgebraicGeometry.CoherentAbelian.isCoherent_kernel`. The epimorphism onto the pullback is
passed as an explicit hypothesis rather than an instance for the same reason: the free module of
`Stacks.Algebraization.exists_epi_free_of_isCoherent` is spelled at
`CategoryTheory.SheafOfModules`, so an `Epi` hypothesis about it is not found by search from a
goal phrased at `X.Modules`.

## References

* [Stacks Project, Tag 0H48](https://stacks.math.columbia.edu/tag/0H48)
* [Stacks Project, Tag 01YB](https://stacks.math.columbia.edu/tag/01YB)
* [Stacks Project, Tag 0BK0](https://stacks.math.columbia.edu/tag/0BK0)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits SheafOfModules TopologicalSpace
  Opposite

universe u

namespace Stacks.Algebraization

open Stacks.LocalCohomology
open Stacks.Ample (unitModule)

/-! ### Coherence of the finite free modules and of the ideal-power multiples -/

/-- A finite free module on a locally Noetherian scheme is coherent: it is a finite coproduct of
copies of the structure sheaf, hence quasi-coherent and of finite type. -/
private lemma isCoherent_free_of_finite {X : Scheme.{u}} [IsLocallyNoetherian X] (ι : Type u)
    [Finite ι] : (SheafOfModules.free (R := X.ringCatSheaf) ι : X.Modules).IsCoherent := by
  have hqc : (SheafOfModules.free (R := X.ringCatSheaf) ι : X.Modules).IsQuasicoherent := by
    change (∐ fun _ : ι => SheafOfModules.unit X.ringCatSheaf).IsQuasicoherent
    exact Stacks.AlgebraicGeometry.QuasicoherentColimits.isQuasicoherent_sigma _
  exact Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType _

/-- The subsheaf `K ^ n · 𝒪_X` of the structure sheaf of a locally Noetherian scheme is
coherent. -/
@[ega "I 10.11.1" "special case"]
private lemma isCoherent_idealPowerMultiple_unit {X : Scheme.{u}} [IsLocallyNoetherian X]
    (K : X.IdealSheafData) (n : ℕ) :
    ((idealPowerMultiple K n (unitModule X)).toModules).IsCoherent := by
  have hO := AlgebraicGeometry.unit_isQuasicoherent_and_isFiniteType (X := X)
  have _ : (unitModule X).IsQuasicoherent := hO.1
  have _ : (unitModule X).IsFiniteType := hO.2
  have _ : ((idealPowerMultiple K n (unitModule X)).toModules).IsQuasicoherent :=
    idealPowerMultiple_isQuasicoherent K n (unitModule X)
  have _ : ((idealPowerMultiple K n (unitModule X)).toModules).IsFiniteType :=
    Stacks.AlgebraicGeometry.CoherentTFAE.isFiniteType_of_mono
      (idealPowerMultiple K n (unitModule X)).ιModules
  exact Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType _

section

-- Instance search does not unfold `AlgebraicGeometry.Scheme.Modules`, so the closure properties
-- of coherence, stated for a general sheaf of modules, are invisible to it on a scheme.
attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

/-- An epimorphism from a coherent module onto the pullback of a short exact sequence along
`φ : N ⟶ F''` is a morphism to the middle term together with an epimorphism onto `N` with
coherent kernel, and the resulting square commutes. -/
private lemma exists_epi_of_epi_pullback {X : Scheme.{u}} (S : ShortComplex X.Modules)
    {N E : X.Modules} (hE : E.IsCoherent) (hN : N.IsCoherent) (φ : N ⟶ S.X₃)
    (q : E ⟶ pullback S.g φ) (hq : Epi q) [Epi S.g] :
    ∃ (m : E ⟶ S.X₂) (p : E ⟶ N), Epi p ∧ (kernel p).IsCoherent ∧ m ≫ S.g = p ≫ φ :=
  have := hq
  have := hE
  have := hN
  ⟨q ≫ pullback.fst S.g φ, q ≫ pullback.snd S.g φ, epi_comp _ _,
    AlgebraicGeometry.CoherentAbelian.isCoherent_kernel (q ≫ pullback.snd S.g φ),
    by rw [Category.assoc, Category.assoc, pullback.condition]⟩

end

/-! ### A coherent module away from a vanishing locus is a quotient of a finite free module -/

/-- A coherent module on the complement of the zero locus of an ideal in the spectrum of a
Noetherian ring is a quotient of a finite free module. -/
theorem exists_epi_free_of_isCoherent (A : Type u) [CommRing A] [IsNoetherianRing A] (a : Ideal A)
    (F : (complementZeroLocus A a : Scheme).Modules) [F.IsCoherent] :
    ∃ (ι : Type u) (_ : Finite ι)
      (p : SheafOfModules.free (R := (complementZeroLocus A a : Scheme).ringCatSheaf) ι ⟶ F),
      Epi p := by
  obtain ⟨M, hMfin, ⟨e⟩⟩ := exists_finiteModule_iso_restrict_tilde A a F
  obtain ⟨σ, hσ⟩ :=
    @Stacks.AlgebraicGeometry.CoherentTFAE.exists_finite_generatingSections_tilde
      (CommRingCat.of A) M hMfin
  let τ := Stacks.AlgebraicGeometry.CoherentTFAE.generatingSectionsRestrict
    (complementZeroLocus A a).ι σ
  let G := SheafOfModules.GeneratingSections.equivOfIso e.symm τ
  exact ⟨G.I, hσ, G.π, G.epi⟩

/-! ### A section as a morphism out of a power of an ideal sheaf -/

/-- A section of a coherent module over an open `V` of a Noetherian scheme is the value on the
unit section of a morphism out of a power of an ideal sheaf whose support misses `V`. -/
theorem exists_idealPower_hom_of_section {X : Scheme.{u}} [IsNoetherian X] (V : X.Opens)
    (F : X.Modules) [F.IsCoherent] (s : Γ(F, V)) :
    ∃ (K : X.IdealSheafData) (n : ℕ)
      (φ : (idealPowerMultiple K n (SheafOfModules.unit X.ringCatSheaf)).toSheafOfModules ⟶ F),
      (∀ x ∈ V, x ∉ K.support) ∧
      ∀ t : Γ((idealPowerMultiple K n (SheafOfModules.unit X.ringCatSheaf)).toSheafOfModules, V),
        (idealPowerMultiple K n (SheafOfModules.unit X.ringCatSheaf)).ι.val.app
            (Opposite.op V) t = (1 : Γ(X, V)) →
          φ.val.app (Opposite.op V) t = s := by
  let K : X.IdealSheafData :=
    Scheme.IdealSheafData.vanishingIdeal ⟨(V : Set X)ᶜ, V.isOpen.isClosed_compl⟩
  have hsupp : ∀ x ∈ V, x ∉ K.support := by
    intro x hx hxK
    change x ∈ ((V : Set X)ᶜ) at hxK
    exact hxK hx
  have hVK : idealComplement K = V := by
    ext x
    change x ∈ ((V : Set X)ᶜ)ᶜ ↔ x ∈ V
    simp
  clear_value K
  subst hVK
  have _ : ((Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple K 1
      (unitModule X)).toModules).IsFiniteType :=
    (@Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent
      _ _ (isCoherent_idealPowerMultiple_unit K 1)).2
  obtain ⟨n, φ, hφ⟩ :=
    (canonicalMapToSections_surjective_iff K F).1
      (canonicalMapToSections_surjective_of_isCoherent K F) s
  refine ⟨K, n, φ, hsupp, fun t ht => ?_⟩
  obtain rfl : t = complementUnitLift K n (idealComplement K) le_rfl := Subtype.ext ht
  exact hφ

/-! ### The lifting of a section through a short exact sequence -/

/-- For a short exact sequence of coherent modules on `U = Spec(A) ∖ V(𝔞)` and a section `s` of
the third term over an open `V`, a finite free module maps to the middle term and onto a power
of an ideal sheaf missing `V`, compatibly with a morphism realizing `s`. -/
theorem exists_finite_lifting_generators (A : Type u) [CommRing A] [IsNoetherianRing A]
    (a : Ideal A) (S : ShortComplex (complementZeroLocus A a : Scheme).Modules)
    (hS : S.ShortExact) [S.X₁.IsCoherent] [S.X₂.IsCoherent] [S.X₃.IsCoherent]
    (V : (complementZeroLocus A a : Scheme).Opens) (s : Γ(S.X₃, V)) :
    ∃ (K : (complementZeroLocus A a : Scheme).IdealSheafData) (n : ℕ)
      (φ : (idealPowerMultiple K n
          (SheafOfModules.unit (complementZeroLocus A a : Scheme).ringCatSheaf)).toSheafOfModules
        ⟶ S.X₃)
      (ι : Type u) (_ : Finite ι)
      (m : SheafOfModules.free (R := (complementZeroLocus A a : Scheme).ringCatSheaf) ι ⟶ S.X₂)
      (p : SheafOfModules.free (R := (complementZeroLocus A a : Scheme).ringCatSheaf) ι ⟶
        (idealPowerMultiple K n
          (SheafOfModules.unit (complementZeroLocus A a : Scheme).ringCatSheaf)).toSheafOfModules),
      Epi p ∧ (kernel p).IsCoherent ∧ m ≫ S.g = p ≫ φ ∧
      (∀ x ∈ V, x ∉ K.support) ∧
      ∀ t : Γ((idealPowerMultiple K n
          (SheafOfModules.unit (complementZeroLocus A a : Scheme).ringCatSheaf)).toSheafOfModules,
            V),
        (idealPowerMultiple K n
            (SheafOfModules.unit (complementZeroLocus A a : Scheme).ringCatSheaf)).ι.val.app
              (Opposite.op V) t = (1 : Γ((complementZeroLocus A a : Scheme), V)) →
          φ.val.app (Opposite.op V) t = s := by
  obtain ⟨K, n, φ, hsupp, hφ⟩ := exists_idealPower_hom_of_section V S.X₃ s
  have _ : Epi S.g := hS.epi_g
  have hN := isCoherent_idealPowerMultiple_unit K n
  obtain ⟨j, hj, hSE⟩ := AdequateFunctor.exists_shortExact_pullback hS φ
  have _ : (pullback S.g φ).IsCoherent :=
    AlgebraicGeometry.CoherentAbelian.isCoherent_X₂_of_shortExact hSE ‹S.X₁.IsCoherent› hN
  obtain ⟨ι, hι, q, hq⟩ := exists_epi_free_of_isCoherent A a (pullback S.g φ)
  obtain ⟨m, p, hp, hker, hcomm⟩ :=
    exists_epi_of_epi_pullback S (isCoherent_free_of_finite ι) hN φ q hq
  exact ⟨K, n, φ, ι, hι, m, p, hp, hker, hcomm, hsupp, hφ⟩

end Stacks.Algebraization

end
