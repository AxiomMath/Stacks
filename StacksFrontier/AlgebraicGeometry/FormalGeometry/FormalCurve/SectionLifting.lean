/-!
# Lifting sections up a tower of curves

Let `X₀ ⟶ X₁ ⟶ ⋯` be a cartesian tower of schemes over the thickenings `Sₙ = Spec (A / Iⁿ⁺¹)` of
a Noetherian ring, whose underlying spaces are Noetherian of dimension at most one, and let
`(Mₙ, θₙ : iₙ^* Mₙ₊₁ ≅ Mₙ)` be a compatible system of invertible modules. If `H¹(X₀, M₀) = 0`, then
every restriction map `Γ(Xₙ₊₁, Mₙ₊₁) ⟶ Γ(Xₙ, Mₙ)` is surjective. This is the step "the vanishing of
`H¹(X, 𝓕ₙ ⊗ ℒ^{⊗d})` implies we can inductively lift the sections" of the proof of
[Stacks, Tag 089A], in the situation of [Stacks, Tag 0E7R], where the dimension bound makes a
single vanishing at the bottom of the tower enough.

## The argument

Fix `n` and let `ℐ` be the ideal sheaf of `iₙ : Xₙ ⟶ Xₙ₊₁`. Generators `a₁, …, a_r` of
`I ^ (n + 1)` give global functions `g_k` on `Xₙ₊₁` generating `ℐ` on every affine open
(`Stacks.FormalCurve.ker_app_le_span`) with `g_j g_k = 0`, since `I ^ (2n+2) ⊆ I ^ (n+2)`.
Multiplication by the `g_k` kills `ℐ`, so it descends to an epimorphism
`(iₙ_* 𝒪_{Xₙ}) ^ r ↠ ℐ` (`Stacks.FormalCurve.epi_generatorsDesc`). Tensoring with `Mₙ₊₁` and using
the projection formula, `ℐ ⊗ Mₙ₊₁` becomes a quotient of `(iₙ_* Mₙ) ^ r`. On a scheme whose space
is Noetherian of dimension at most one `H²` vanishes ([Stacks, Tag 02UZ]), so `H¹` is right exact
(`Stacks.FormalCurve.isZero_rightDerived_one_of_epi`) and `H¹(Xₙ₊₁, ℐ ⊗ Mₙ₊₁) = 0` as soon as
`H¹(Xₙ, Mₙ) = 0`. The sequence `0 → ℐ ⊗ Mₙ₊₁ → Mₙ₊₁ → iₙ_* Mₙ → 0` then gives both
`H¹(Xₙ₊₁, Mₙ₊₁) = 0`, which is the induction, and the surjectivity on global sections
(`Stacks.AmpleSurjectiveThickening.surjective_pullbackGlobalSection_of_isZero_h1`).

## Main results

* `Stacks.FormalCurve.surjective_transitionSections_of_isZero_rightDerived_one`.
* `Stacks.FormalCurve.isZero_rightDerived_one_step` — one step of the induction, for a closed
  immersion whose ideal is generated by square-zero global functions.

## References

* [Stacks Project, Tag 089A](https://stacks.math.columbia.edu/tag/089A)
* [Stacks Project, Tag 0E7R](https://stacks.math.columbia.edu/tag/0E7R)
* [Stacks Project, Tag 02UZ](https://stacks.math.columbia.edu/tag/02UZ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.FormalCurve

section LongExact

variable {C D : Type*} [Category* C] [Category* D] [Abelian C] [Abelian D]
  [HasDerivedCategory C] [HasDerivedCategory D] [EnoughInjectives C]
  (F : C ⥤ D) [F.Additive]

/-- **Right exactness of `R¹F` when `R²F` vanishes on the kernel.** -/
theorem isZero_rightDerived_one_X₃ {S : ShortComplex C} (hS : S.ShortExact)
    (h₂ : IsZero ((F.rightDerived 1).obj S.X₂)) (h₁ : IsZero ((F.rightDerived 2).obj S.X₁)) :
    IsZero ((F.rightDerived 1).obj S.X₃) :=
  (Stacks.DerivedIndexing.rightDerivedDeltaFunctorOfEnoughInjectives F).exact_δ₁ hS 1
    |>.isZero_X₂ (h₂.eq_of_src _ _) (h₁.eq_of_tgt _ _)

/-- **`R¹F` vanishes on the middle term when it vanishes on both ends.** -/
theorem isZero_rightDerived_one_X₂ {S : ShortComplex C} (hS : S.ShortExact)
    (h₁ : IsZero ((F.rightDerived 1).obj S.X₁)) (h₃ : IsZero ((F.rightDerived 1).obj S.X₃)) :
    IsZero ((F.rightDerived 1).obj S.X₂) :=
  (Stacks.DerivedIndexing.rightDerivedDeltaFunctorOfEnoughInjectives F).exact_map hS 1
    |>.isZero_X₂ (h₁.eq_of_src _ _) (h₃.eq_of_tgt _ _)

end LongExact

section Scheme

attribute [local instance] HasDerivedCategory.standard

/-- **Grothendieck vanishing in degree two on a scheme whose underlying space is Noetherian of
dimension at most one** ([Stacks, Tag 02UZ]), in the spelling of derived global sections. -/
theorem isZero_rightDerived_two_of_topologicalKrullDim_le_one {Y : Scheme.{u}}
    [NoetherianSpace Y] (hdim : topologicalKrullDim (Y : Type u) ≤ 1) (F : Y.Modules) :
    IsZero (((moduleGlobalSections Y).rightDerived 2).obj F) := by
  refine Stacks.Cohomology.Affine.isZero_rightDerived_evaluation_of_isZero_Hgroup
    Y.ringCatSheaf ⊤ 2 F ?_
  rw [Stacks.Cohomology.ModuleComparison.isZero_schemeHgroupTop_iff_subsingleton_sheafH]
  exact Stacks.CohomologyVanishing.subsingleton_sheafCohomology_of_noetherianSpace_of_dim_le
    (d := 1) (by exact_mod_cast hdim) (by norm_num) _

/-- **On a scheme whose underlying space is Noetherian of dimension at most one, `H¹` is right
exact**: an epimorphism `P ↠ Q` with `H¹(P) = 0` forces `H¹(Q) = 0`. -/
theorem isZero_rightDerived_one_of_epi {Y : Scheme.{u}} [NoetherianSpace Y]
    (hdim : topologicalKrullDim (Y : Type u) ≤ 1) {P Q : Y.Modules} (φ : P ⟶ Q) (hφ : Epi φ)
    (hP : IsZero (((moduleGlobalSections Y).rightDerived 1).obj P)) :
    IsZero (((moduleGlobalSections Y).rightDerived 1).obj Q) :=
  isZero_rightDerived_one_X₃ (moduleGlobalSections Y)
    (S := ShortComplex.mk (kernel.ι φ) φ (kernel.condition φ)) (have := hφ;
    { exact := ShortComplex.exact_kernel φ }) hP
    (isZero_rightDerived_two_of_topologicalKrullDim_le_one hdim _)

end Scheme

section Generators

open RingedSpaceModuleAdjunction Stacks.Thickenings Stacks.ClosedImmersion

attribute [local implicit_reducible]
  TopCat.Sheaf
  structureSheafRing
  SheafOfModules.toSheaf

variable {Y Z : Scheme.{u}} (i : Z ⟶ Y) {r : ℕ} (g : Fin r → Γ(Y, ⊤))

/-- The affine opens, as a family of opens indexed by themselves. -/
abbrev affineBasis (Y : Scheme.{u}) : Y.affineOpens → Y.Opens := Subtype.val

/-- The affine opens of a scheme form a basis of its topology. -/
theorem isBasis_affineBasis (Y : Scheme.{u}) : Opens.IsBasis (Set.range (affineBasis Y)) := by
  rw [Subtype.range_coe]
  exact Y.isBasis_affineOpens

/-- A global function killed by `i` restricts to sections killed by `i`. -/
theorem globalRestrict_mem_ker (hg : ∀ k, (i.appTop (g k)) = 0) (k : Fin r) (V : Y.Opens) :
    globalRestrict Y (g k) V ^ 1 ∈ RingHom.ker (i.app V).hom := by
  rw [pow_one, RingHom.mem_ker, globalRestrict, ← CommRingCat.comp_apply, i.naturality]
  show (Z.presheaf.map _).hom (i.appTop (g k)) = 0
  rw [hg k, map_zero]

/-- Multiplication by the `k`-th generator, as a morphism from `𝒪_Y` into the ideal sheaf. -/
def generatorLift (hg : ∀ k, (i.appTop (g k)) = 0) (k : Fin r) :
    SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) ⟶
      idealSheaf i.toLRSHom.toShHom :=
  powSmulLift i (g k) 1 (isBasis_affineBasis Y) fun j => globalRestrict_mem_ker i g hg k j.1

/-- **The generators annihilate the ideal, on sections.** If the ideal of `i` over an affine open
is contained in the ideal generated by the restrictions of the `g j`, and the `g j` multiply to
zero pairwise, then each `g k` kills every section of that ideal. -/
theorem generator_mul_eq_zero
    (hgen : ∀ U : Y.affineOpens,
      RingHom.ker (i.app U.1).hom ≤ Ideal.span (Set.range fun j => globalRestrict Y (g j) U.1))
    (hsq : ∀ j k, g j * g k = 0) (k : Fin r) (U : Y.affineOpens) (x : Γ(Y, U.1))
    (hx : x ∈ RingHom.ker (i.app U.1).hom) :
    globalRestrict Y (g k) U.1 ^ 1 * x = 0 := by
  rw [pow_one]
  have hx' := hgen U hx
  clear hx
  induction hx' using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨j, rfl⟩ := hz
    show (Y.presheaf.map _).hom (g k) * (Y.presheaf.map _).hom (g j) = 0
    rw [← map_mul, hsq k j, map_zero]
  | zero => exact mul_zero _
  | add a b _ _ ha hb => rw [mul_add, ha, hb, add_zero]
  | smul c a _ ha => rw [smul_eq_mul, mul_left_comm, ha, mul_zero]

/-- Multiplication by a generator kills the ideal sheaf. -/
theorem idealSheafι_comp_globalPowSmul_generator
    (hgen : ∀ U : Y.affineOpens,
      RingHom.ker (i.app U.1).hom ≤ Ideal.span (Set.range fun j => globalRestrict Y (g j) U.1))
    (hsq : ∀ j k, g j * g k = 0) (k : Fin r) :
    idealSheafι i.toLRSHom.toShHom ≫ globalPowSmul Y (g k) 1 = 0 := by
  refine SheafOfModules.hom_ext ((PresheafOfModules.toPresheaf _).map_injective ?_)
  refine TopCat.Sheaf.hom_ext (B := affineBasis Y) _
    (show TopCat.Sheaf AddCommGrpCat.{u} Y.carrier from
      ⟨(SheafOfModules.unit (structureSheafRing Y.toSheafedSpace)).val.presheaf,
        (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace)).isSheaf⟩)
    (isBasis_affineBasis Y) fun U => ?_
  ext y
  refine Eq.trans (globalPowSmul_val_app Y (g k) 1 (homOfLE le_top) _) ?_
  exact generator_mul_eq_zero i g hgen hsq k U _ (mem_ker_idealSheafι_val_app i U.1 y _ rfl)

/-- Finite biproducts of sheaves of modules on a scheme, in the ringed-space spelling. -/
instance hasFiniteBiproducts_structureSheafRing (Y : Scheme.{u}) :
    HasFiniteBiproducts (SheafOfModules.{u} (structureSheafRing Y.toSheafedSpace)) :=
  HasFiniteBiproducts.of_hasFiniteProducts

/-- Finite biproducts of sheaves of modules on a scheme, in the tensor spelling. -/
instance hasFiniteBiproducts_ringSheaf (Y : Scheme.{u}) :
    HasFiniteBiproducts
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf)) :=
  HasFiniteBiproducts.of_hasFiniteProducts

/-- Finite biproducts of sheaves of modules on a scheme, in the ringed-space spelling. -/
instance hasFiniteBiproducts_structureSheafRing' (Y : Scheme.{u}) :
    HasFiniteBiproducts (SheafOfModules.{u} (structureSheafRing Y.toRingedSpace)) :=
  HasFiniteBiproducts.of_hasFiniteProducts

section Desc

variable [IsClosedImmersion i] (hg : ∀ k, (i.appTop (g k)) = 0)
  (hgen : ∀ U : Y.affineOpens,
    RingHom.ker (i.app U.1).hom ≤ Ideal.span (Set.range fun j => globalRestrict Y (g j) U.1))
  (hsq : ∀ j k, g j * g k = 0)

/-- Multiplication by the `k`-th generator, as a morphism from `i_* 𝒪_Z` into the ideal sheaf:
it kills the ideal sheaf, which is the kernel of `𝒪_Y ⟶ i_* 𝒪_Z`. -/
def generatorDesc (k : Fin r) :
    (modulePushforward i.toLRSHom.toShHom).obj
        (SheafOfModules.unit (structureSheafRing Z.toSheafedSpace)) ⟶
      idealSheaf i.toLRSHom.toShHom :=
  Abelian.epiDesc (structureSheafModuleHom i.toLRSHom.toShHom) (generatorLift i g hg k) (by
    rw [← cancel_mono (idealSheafι i.toLRSHom.toShHom), zero_comp, Category.assoc,
      generatorLift, powSmulLift_idealSheafι]
    exact idealSheafι_comp_globalPowSmul_generator i g hgen hsq k)

/-- `generatorDesc` restricts along `𝒪_Y ⟶ i_* 𝒪_Z` to `generatorLift`. -/
theorem structureSheafModuleHom_comp_generatorDesc (k : Fin r) :
    structureSheafModuleHom i.toLRSHom.toShHom ≫ generatorDesc i g hg hgen hsq k =
      generatorLift i g hg k :=
  Abelian.comp_epiDesc _ _ _

/-- The generators, assembled into one morphism out of `𝒪_Y ^ r`. -/
def generatorsLift :
    (⨁ fun _ : Fin r => (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) :
      SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf))) ⟶
      (idealSheaf i.toLRSHom.toShHom :
        SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf)) :=
  biproduct.desc fun k => generatorLift i g hg k

/-- The generators, assembled into one morphism out of `(i_* 𝒪_Z) ^ r`. -/
def generatorsDesc :
    (⨁ fun _ : Fin r => ((modulePushforward i.toLRSHom.toShHom).obj
        (SheafOfModules.unit (structureSheafRing Z.toSheafedSpace)) :
          SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf))) ⟶
      (idealSheaf i.toLRSHom.toShHom :
        SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf)) :=
  biproduct.desc fun k => generatorDesc i g hg hgen hsq k

/-- `generatorsDesc` restricts along `(𝒪_Y ⟶ i_* 𝒪_Z) ^ r` to `generatorsLift`. -/
theorem map_comp_generatorsDesc :
    biproduct.map (fun _ : Fin r => (structureSheafModuleHom i.toLRSHom.toShHom :
      (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) :
        SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf)) ⟶ _)) ≫
        generatorsDesc i g hg hgen hsq = generatorsLift i g hg := by
  ext k
  simp [generatorsDesc, generatorsLift, structureSheafModuleHom_comp_generatorDesc]

include hgen in
omit [IsClosedImmersion i] in
/-- The generators generate the ideal sheaf. -/
theorem epi_generatorsLift : Epi (generatorsLift i g hg) := by
  refine Stacks.SheafOfModules.StalkEpiMono.epi_of_exists_sections _ fun U t x hx => ?_
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open hx U.2
  let t' : (idealSheaf i.toLRSHom.toShHom).val.obj (op V) :=
    (idealSheaf i.toLRSHom.toShHom).val.map (homOfLE hVU).op t
  have hs := mem_ker_idealSheafι_val_app i V t' _ rfl
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 (hgen ⟨V, hV⟩ hs)
  refine ⟨V, hVU, hxV, ∑ k, (biproduct.ι (fun _ : Fin r =>
    (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) :
      SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf))) k).val.app (op V)
        (c k), ?_⟩
  apply injective_idealSheafι_val_app i.toLRSHom.toShHom V
  rw [map_sum, map_sum]
  show _ = (idealSheafι i.toLRSHom.toShHom).val.app (op V) t'
  rw [← hc]
  refine Finset.sum_congr rfl fun k _ => ?_
  have h1 : (biproduct.ι _ k ≫ generatorsLift i g hg ≫ idealSheafι i.toLRSHom.toShHom) =
      globalPowSmul Y (g k) 1 := by
    rw [generatorsLift, biproduct.ι_desc_assoc, generatorLift, powSmulLift_idealSheafι]
  have h2 := congrArg (fun φ => φ.val.app (op V) (c k)) h1
  simp only [SheafOfModules.comp_val] at h2
  refine h2.trans ?_
  rw [globalPowSmul_val_app Y (g k) 1 (homOfLE le_top), pow_one, smul_eq_mul, mul_comm]

/-- The morphism `(i_* 𝒪_Z) ^ r ⟶ ℐ` given by the generators is an epimorphism. -/
theorem epi_generatorsDesc : Epi (generatorsDesc i g hg hgen hsq) := by
  have := epi_generatorsLift i g hg hgen
  rw [← map_comp_generatorsDesc i g hg hgen hsq] at this
  exact epi_of_epi (biproduct.map fun _ : Fin r => (structureSheafModuleHom i.toLRSHom.toShHom :
      (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) :
        SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf)) ⟶ _))
    (generatorsDesc i g hg hgen hsq)

end Desc

end Generators

/-- An additive functor killing every summand kills a finite biproduct. -/
theorem isZero_map_biproduct {C D : Type*} [Category* C] [Preadditive C] [Category* D]
    [Preadditive D] (H : C ⥤ D) [H.Additive] {J : Type} [Fintype J]
    (f : J → C) {hf : HasBiproduct f} (h : ∀ j, IsZero (H.obj (f j))) :
    IsZero (H.obj (⨁ f)) := by
  rw [IsZero.iff_id_eq_zero, ← H.map_id, ← biproduct.total, H.map_sum]
  exact Finset.sum_eq_zero fun j _ => by
    rw [H.map_comp, (h j).eq_of_src (H.map (biproduct.ι f j)) 0, comp_zero]

section Tensor

open RingedSpaceModuleAdjunction Stacks.ClosedImmersion

attribute [local instance] HasDerivedCategory.standard

variable {Y : Scheme.{u}}
  (P : _root_.SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf))
  [AlgebraicGeometry.SheafOfModules.IsInvertible Y.presheaf
    (structureSheafRing Y.toRingedSpace).property P]

/-- Tensoring on the right by an invertible module is an equivalence. -/
instance isEquivalence_tensorRight :
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).flip.obj P).IsEquivalence :=
  Functor.isEquivalence_of_iso (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight Y P)

/-- Tensoring on the right by an invertible module is additive. -/
instance additive_tensorRight :
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).flip.obj P).Additive := by
  have : ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).obj P).Additive :=
    Functor.additive_of_preserves_binary_products _
  exact Functor.additive_of_iso (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight Y P)

/-- **The obstruction group vanishes for a square-zero ideal generated by global functions.**
Let `i : Z ⟶ Y` be a closed immersion whose ideal is generated, on affine opens, by finitely many
global functions `g k` killed by `i` with `g j * g k = 0`, on a scheme `Y` whose underlying space
is Noetherian of dimension at most one. If `H¹(Y, i_* 𝒪_Z ⊗ P) = 0` for an invertible `P`, then
`H¹(Y, ℐ ⊗ P) = 0` for the ideal sheaf `ℐ` of `i`: the generators give an epimorphism
`(i_* 𝒪_Z) ^ r ⊗ P ↠ ℐ ⊗ P`, and `H¹` is right exact on `Y`. -/
theorem isZero_rightDerived_one_idealSheaf_tensor {Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [NoetherianSpace Y] (hdim : topologicalKrullDim (Y : Type u) ≤ 1)
    {r : ℕ} (g : Fin r → Γ(Y, ⊤)) (hg : ∀ k, (i.appTop (g k)) = 0)
    (hgen : ∀ U : Y.affineOpens,
      RingHom.ker (i.app U.1).hom ≤
        Ideal.span (Set.range fun j => Stacks.Thickenings.globalRestrict Y (g j) U.1))
    (hsq : ∀ j k, g j * g k = 0)
    (hP : IsZero (((moduleGlobalSections Y).rightDerived 1).obj
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).flip.obj P).obj
        ((modulePushforward i.toLRSHom.toShHom).obj
          (SheafOfModules.unit (structureSheafRing Z.toSheafedSpace)))))) :
    IsZero (((moduleGlobalSections Y).rightDerived 1).obj
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨Y.presheaf, Y.IsSheaf⟩).obj
        (idealSheaf i.toLRSHom.toShHom)).obj P))) := by
  set F := (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).flip.obj P
  have : F.IsEquivalence := isEquivalence_tensorRight P
  have : F.Additive := additive_tensorRight P
  refine isZero_rightDerived_one_of_epi hdim (F.map (generatorsDesc i g hg hgen hsq))
    (@Functor.map_epi _ _ _ _ F _ _ _ (generatorsDesc i g hg hgen hsq)
      (epi_generatorsDesc i g hg hgen hsq)) ?_
  let G : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.sheaf) ⥤
      ModuleCat.{u} Γ(Y, ⊤) := (moduleGlobalSections Y).rightDerived 1
  have : G.Additive :=
    (Stacks.DerivedIndexing.rightDerivedDeltaFunctorOfEnoughInjectives
      (moduleGlobalSections Y)).additive 1
  exact isZero_map_biproduct (F ⋙ G) _ fun _ => hP

omit [AlgebraicGeometry.SheafOfModules.IsInvertible Y.presheaf
    (structureSheafRing Y.toRingedSpace).property P] in
/-- **`H¹(Y, i_* 𝒪_Z ⊗ P) = H¹(Z, i^* P)`**, in the vanishing form: the projection formula for the
closed immersion `i` identifies `i_* 𝒪_Z ⊗ P` with `i_* (i^* P)`, and cohomology does not change
along a closed immersion. -/
theorem isZero_rightDerived_one_pushforward_tensor {Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i]
    [AlgebraicGeometry.SheafOfModules.IsInvertible Z.presheaf
      (structureSheafRing Z.toRingedSpace).property ((modulePullback i.toLRSHom.toShHom).obj P)]
    (hZ : IsZero (((moduleGlobalSections Z).rightDerived 1).obj
      ((modulePullback i.toLRSHom.toShHom).obj P))) :
    IsZero (((moduleGlobalSections Y).rightDerived 1).obj
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).flip.obj P).obj
        ((modulePushforward i.toLRSHom.toShHom).obj
          (SheafOfModules.unit (structureSheafRing Z.toSheafedSpace))))) := by
  have e1 := Stacks.AffineProjectionFormula.closedImmersionProjectionFormulaIso i
    (SheafOfModules.unit (structureSheafRing Z.toRingedSpace)) P
  have e2 := Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor Z.presheaf
    (structureSheafRing Z.toRingedSpace).property ((modulePullback i.toLRSHom.toShHom).obj P)
  have h := ((ModuleCat.restrictScalars i.appTop.hom).map_isZero hZ).of_iso
    (Stacks.Cohomology.ClosedImmersion.cohomologyObjIsoPushforward i
      ((modulePullback i.toLRSHom.toShHom).obj P) 1)
  exact h.of_iso (((moduleGlobalSections Y).rightDerived 1).mapIso
    (e1 ≪≫ (modulePushforward i.toLRSHom.toShHom).mapIso e2))

/-- **One step of the induction.** In the situation of
`isZero_rightDerived_one_idealSheaf_tensor`, if `H¹(Z, i^* P) = 0` then `H¹(Y, ℐ ⊗ P) = 0` and
`H¹(Y, P) = 0`. -/
theorem isZero_rightDerived_one_step {Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [NoetherianSpace Y] (hdim : topologicalKrullDim (Y : Type u) ≤ 1)
    {r : ℕ} (g : Fin r → Γ(Y, ⊤)) (hg : ∀ k, (i.appTop (g k)) = 0)
    (hgen : ∀ U : Y.affineOpens,
      RingHom.ker (i.app U.1).hom ≤
        Ideal.span (Set.range fun j => Stacks.Thickenings.globalRestrict Y (g j) U.1))
    (hsq : ∀ j k, g j * g k = 0)
    [AlgebraicGeometry.SheafOfModules.IsInvertible Z.presheaf
      (structureSheafRing Z.toRingedSpace).property ((modulePullback i.toLRSHom.toShHom).obj P)]
    (hZ : IsZero (((moduleGlobalSections Z).rightDerived 1).obj
      ((modulePullback i.toLRSHom.toShHom).obj P))) :
    IsZero (((moduleGlobalSections Y).rightDerived 1).obj
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨Y.presheaf, Y.IsSheaf⟩).obj
        (idealSheaf i.toLRSHom.toShHom)).obj P))) ∧
    IsZero (((moduleGlobalSections Y).rightDerived 1).obj P) := by
  have hpush := isZero_rightDerived_one_pushforward_tensor P i hZ
  have hideal := isZero_rightDerived_one_idealSheaf_tensor P i hdim g hg hgen hsq hpush
  refine ⟨hideal, ?_⟩
  let F : SheafOfModules.{u} (structureSheafRing Y.toRingedSpace) ⥤
      SheafOfModules.{u} (structureSheafRing Y.toRingedSpace) :=
    (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.sheaf).flip.obj P
  have : F.IsEquivalence := isEquivalence_tensorRight P
  have : F.Additive := additive_tensorRight P
  have hS := (Stacks.Cohomology.AmpleH1.shortExact_idealSheaf i).map_of_exact F
  exact (isZero_rightDerived_one_X₂ (moduleGlobalSections Y) hS hideal hpush).of_iso
    (((moduleGlobalSections Y).rightDerived 1).mapIso
      (Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor Y.presheaf
        (structureSheafRing Y.toRingedSpace).property P).symm)

end Tensor

section TowerGenerators

open Stacks.Thickenings

variable {A : Type u} [CommRing A] (I : Ideal A) {X X' : Scheme.{u}} (n : ℕ)
  (q : X ⟶ adicThickening A I n) (q' : X' ⟶ adicThickening A I (n + 1)) (i : X ⟶ X')
  (hcart : IsPullback i q q' (adicThickeningSucc A I n))

/-- The global functions on `X'` coming from elements of `A`. -/
def baseFunction (a : A) : Γ(X', ⊤) :=
  q'.appTop ((Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1 + 1)))).inv (Ideal.Quotient.mk _ a))

/-- `baseFunction` is multiplicative. -/
lemma baseFunction_mul (a b : A) :
    baseFunction I n q' (a * b) = baseFunction I n q' a * baseFunction I n q' b := by
  simp only [baseFunction, map_mul]

/-- An element of `I ^ (n + 2)` gives the zero function on `X'`. -/
lemma baseFunction_eq_zero (a : A) (ha : a ∈ I ^ (n + 1 + 1)) : baseFunction I n q' a = 0 := by
  simp only [baseFunction, Ideal.Quotient.eq_zero_iff_mem.2 ha, map_zero]

/-- `Γ(Spec -, ⊤)` inverse is natural for the map `A / Iⁿ⁺² ⟶ A / Iⁿ⁺¹` of thickenings. -/
private theorem ΓSpecIso_inv_comp_adicThickeningSucc_appTop :
    (Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1 + 1)))).inv ≫ (adicThickeningSucc A I n).appTop =
      CommRingCat.ofHom (Ideal.Quotient.factorPow I (Nat.le_succ (n + 1))) ≫
        (Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1)))).inv :=
  (Scheme.ΓSpecIso_inv_naturality _).symm

include hcart in
/-- An element of `I ^ (n + 1)` gives a function killed by the transition map. -/
lemma appTop_baseFunction (a : A) (ha : a ∈ I ^ (n + 1)) :
    i.appTop (baseFunction I n q' a) = 0 := by
  have h1 := ΓSpecIso_inv_comp_adicThickeningSucc_appTop I n
  have h3 : (Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1 + 1)))).inv ≫ q'.appTop ≫ i.appTop =
      CommRingCat.ofHom (Ideal.Quotient.factorPow I (Nat.le_succ (n + 1))) ≫
        (Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1)))).inv ≫ q.appTop := by
    rw [← Scheme.Hom.comp_appTop, hcart.w, Scheme.Hom.comp_appTop,
      ← Category.assoc, h1, Category.assoc]
  have h4 := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (I ^ (n + 1 + 1)) a)) h3
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
    Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem.2 ha, map_zero] at h4
  exact h4

include hcart in
/-- **The ideal of the transition map is generated by elements of `I ^ (n + 1)`**, on every
affine open: if the `a k` generate `I ^ (n + 1)`, their images generate the kernel of
`Γ(X', U) ⟶ Γ(X, i⁻¹ U)`. -/
lemma ker_app_le_span {r : ℕ} (a : Fin r → A) (ha : Ideal.span (Set.range a) = I ^ (n + 1))
    (U : X'.affineOpens) :
    haveI : IsClosedImmersion i :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hcart.flip inferInstance
    RingHom.ker (i.app U.1).hom ≤
      Ideal.span (Set.range fun k => globalRestrict X' (baseFunction I n q' (a k)) U.1) := by
  have : IsClosedImmersion i :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback hcart.flip inferInstance
  rw [← Scheme.Hom.ker_apply i U]
  have hker : i.ker = (adicThickeningSucc A I n).ker.comap q' := by
    rw [← hcart.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
      Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
  rw [hker, Stacks.IdealSheaf.ideal_comap_appLE _ q' ⟨⊤, isAffineOpen_top _⟩ U le_top,
    Scheme.Hom.ker_apply, Ideal.map_le_iff_le_comap]
  intro x hx
  set e := Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1 + 1)))
  obtain ⟨y, rfl⟩ : ∃ y, e.inv y = x := ⟨e.hom x, by simp⟩
  have h1 := ΓSpecIso_inv_comp_adicThickeningSucc_appTop I n
  have hy : y ∈ RingHom.ker (Ideal.Quotient.factorPow I (Nat.le_succ (n + 1))) := by
    have h2 := congrArg (fun φ => φ.hom y) h1
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    rw [RingHom.mem_ker]
    apply (Scheme.ΓSpecIso (.of (A ⧸ I ^ (n + 1)))).commRingCatIsoToRingEquiv.symm.injective
    rw [map_zero]
    exact h2.symm.trans hx
  rw [Ideal.Quotient.factor_ker, ← ha, Ideal.map_span, ← Set.range_comp] at hy
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hy
  simp only [Ideal.mem_comap, map_sum, smul_eq_mul, map_mul]
  exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)

end TowerGenerators

attribute [local instance] HasDerivedCategory.standard

/-- **Section lifting on a tower of curves.** Let `X₀ ⟶ X₁ ⟶ ⋯` be a cartesian tower over the
thickenings `Sₙ = Spec (A / Iⁿ⁺¹)` of a Noetherian ring, whose members have Noetherian underlying
spaces of dimension at most one, and let `(Mₙ, θₙ)` be a compatible system of invertible modules
with `H¹(X₀, M₀) = 0`. Then every transition map `Γ(Xₙ₊₁, Mₙ₊₁) ⟶ Γ(Xₙ, Mₙ)` is surjective.

By induction `H¹(Xₙ, Mₙ) = 0` for every `n`: the ideal `ℐ` of `Xₙ` in `Xₙ₊₁` is generated by
the images of generators of `I ^ (n + 1)` and has square zero, so `ℐ ⊗ Mₙ₊₁` is a quotient of
`(iₙ_* Mₙ) ^ r`, and `H¹` is right exact in dimension one. The vanishing of `H¹(Xₙ₊₁, ℐ ⊗ Mₙ₊₁)`
then makes the restriction of sections surjective. -/
theorem surjective_transitionSections_of_isZero_rightDerived_one
    (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    {Xn : ℕ → Scheme.{u}} (q : ∀ n, Xn n ⟶ adicThickening A I n)
    (i : ∀ n, Xn n ⟶ Xn (n + 1))
    (hcart : ∀ n, IsPullback (i n) (q n) (q (n + 1)) (adicThickeningSucc A I n))
    (hnoeth : ∀ n, NoetherianSpace (Xn n))
    (hdim : ∀ n, topologicalKrullDim (Xn n : Type u) ≤ 1)
    (M : ∀ n, (Xn n).Modules) (hM : ∀ n, Stacks.Ample.IsInvertibleModule (Xn n) (M n))
    (θ : ∀ n, (Scheme.Modules.pullback (i n)).obj (M (n + 1)) ≅ M n)
    (hvan : IsZero (((AlgebraicGeometry.moduleGlobalSections (Xn 0)).rightDerived 1).obj
      (M 0))) :
    ∀ n, Function.Surjective (Stacks.AmpleFormalSystemLifting.transitionSections i M θ n) := by
  have hci : ∀ n, IsClosedImmersion (i n) := fun n =>
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (hcart n).flip inferInstance
  have hgen : ∀ n, ∃ (r : ℕ) (a : Fin r → A), Ideal.span (Set.range a) = I ^ (n + 1) := fun n =>
    Submodule.fg_iff_exists_fin_generating_family.1 (IsNoetherian.noetherian _)
  choose r a ha using hgen
  have hmem : ∀ n k, a n k ∈ I ^ (n + 1) := fun n k => ha n ▸ Ideal.subset_span ⟨k, rfl⟩
  have step : ∀ n, IsZero (((moduleGlobalSections (Xn n)).rightDerived 1).obj (M n)) →
      IsZero (((moduleGlobalSections (Xn (n + 1))).rightDerived 1).obj
        ((((Stacks.SheafOfModules.Tensor.sheafTensor
          ⟨(Xn (n + 1)).presheaf, (Xn (n + 1)).IsSheaf⟩).obj
            (Stacks.ClosedImmersion.idealSheaf (i n).toLRSHom.toShHom)).obj (M (n + 1))))) ∧
      IsZero (((moduleGlobalSections (Xn (n + 1))).rightDerived 1).obj (M (n + 1))) := by
    intro n hn
    have := hnoeth (n + 1)
    have := hM (n + 1)
    have : AlgebraicGeometry.SheafOfModules.IsInvertible (Xn (n + 1)).presheaf
        (structureSheafRing (Xn (n + 1)).toRingedSpace).property (M (n + 1)) := hM (n + 1)
    have : AlgebraicGeometry.SheafOfModules.IsInvertible (Xn n).presheaf
        (structureSheafRing (Xn n).toRingedSpace).property
          ((RingedSpaceModuleAdjunction.modulePullback (i n).toLRSHom.toShHom).obj (M (n + 1))) :=
      Stacks.InvertiblePullback.isInvertibleModule_pullback (i n) (M (n + 1))
    refine isZero_rightDerived_one_step (M (n + 1)) (i n) (hdim (n + 1))
      (fun k => baseFunction I n (q (n + 1)) (a n k))
      (fun k => appTop_baseFunction I n (q n) (q (n + 1)) (i n) (hcart n) _ (hmem n k))
      (ker_app_le_span I n (q n) (q (n + 1)) (i n) (hcart n) (a n) (ha n))
      (fun j k => ?_) (hn.of_iso (((moduleGlobalSections (Xn n)).rightDerived 1).mapIso (θ n)))
    rw [← baseFunction_mul]
    refine baseFunction_eq_zero I n (q (n + 1)) _ ?_
    exact Ideal.pow_le_pow_right (by omega)
      (pow_add I (n + 1) (n + 1) ▸ Ideal.mul_mem_mul (hmem n j) (hmem n k))
  have hall : ∀ n, IsZero (((moduleGlobalSections (Xn n)).rightDerived 1).obj (M n)) := by
    intro n
    induction n with
    | zero => exact hvan
    | succ n ih => exact (step n ih).2
  intro n y
  have := hM (n + 1)
  obtain ⟨x, hx⟩ := Stacks.AmpleSurjectiveThickening.surjective_pullbackGlobalSection_of_isZero_h1
    (i n) (M (n + 1)) (step n (hall n)).1 (Scheme.Modules.Hom.app (θ n).inv ⊤ y)
  refine ⟨x, ?_⟩
  rw [Stacks.AmpleFormalSystemLifting.transitionSections,
    Stacks.AmpleFormalSystemLifting.pullbackGlobalSections_eq_pullbackGlobalSection, hx]
  exact Stacks.AmpleFormalSystemEmbeddedTuple.app_hom_app_inv _ y

end Stacks.FormalCurve

end
