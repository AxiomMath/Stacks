module

public import StacksFrontier.AlgebraicGeometry.AmpleClosedImmersion.Converse
public import StacksFrontier.AlgebraicGeometry.AmpleSurjectiveThickening.Basic
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AdicTowerConormalPoly
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AdicTowerTransitionKernelCoherent
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.PolyAlgebraTwistVanishing

/-!
# The graded module of transition kernels of an adic tower

Let `A` be a ring, `I` an ideal generated by a family `a : ι → A`, and `X₀ ⟶ X₁ ⟶ ⋯` a tower over
the adic thickenings with cartesian squares. The conormal algebras `Cₖ` of `X₀ ⟶ Xₖ`, the
canonical maps `Cₖ₊₁ ⟶ Cₖ` and the structure maps `𝒪_{X₀}[xᵢ] ⟶ Cₖ` form a
`Stacks.GradedTower.Tower`; its diagonal module `M` has `Mₙ = (Cₙ)ₙ = Iⁿ𝒪_{Xₙ}`, the `(n-1)`-st
transition kernel of the tower. This is the graded `𝒪_{X₀}`-module `⨁ₙ Iⁿ𝒪_{Xₙ₊₁}` of the second
paragraph of the proof of [Stacks, Tag 089A], viewed over a polynomial algebra mapping onto
`⨁ Iⁿ/Iⁿ⁺¹`.

It is quasi-coherent and of finite type, generated in degree zero by the unit, so part (2) of
[Stacks, Tag 0897] over the polynomial algebra gives one `d₀` above which the higher cohomology of
every `Mₙ ⊗ L ^⊗ d` vanishes, for an ample `L` on a proper `X₀`.

## Main results

* `Stacks.AdicTower.towerModule`: the graded module.
* `Stacks.AdicTower.isFiniteTypeOnAffine_towerModule`: it is of finite type.
* `Stacks.AdicTower.exists_isZero_Hgroup_towerModule`: the uniform vanishing.

## References

* [Stacks Project, Tag 089A](https://stacks.math.columbia.edu/tag/089A)
* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.Ample Stacks.RelativeVeryAmple

universe u

namespace Stacks.AdicTower

attribute [local instance_reducible] TopCat.Sheaf
attribute [local implicit_reducible] TopCat.Sheaf PresheafOfModules.presheaf
  SheafOfModules.toSheaf ModuleCat.restrictScalars

variable {A : Type u} [CommRing A] {I : Ideal A} {Xn : ℕ → Scheme.{u}}
  (q : ∀ n, Xn n ⟶ adicThickening A I n) (t : ∀ n, Xn n ⟶ Xn (n + 1))
  (hcart : ∀ n, IsPullback (t n) (q n) (q (n + 1)) (adicThickeningSucc A I n))
  [hci : ∀ k, IsClosedImmersion (incl t k)] [hct : ∀ k, IsClosedImmersion (t k)]
  {ι : Type u} (a : ι → A) (ha : ∀ i, a i ∈ I)

/-- **The tower of conormal algebras of the adic tower**, under `𝒪_{X₀}[xᵢ]`. -/
def conormalTower : Stacks.GradedTower.Tower (Stacks.Coherent.polyAlgebra (Xn 0) ι) :=
  Stacks.GradedTower.Tower.ofSteps (conormalAlg t) (conormalStep t)
    (polyHomTower q t hcart a ha) (polyHomTower_step q t hcart a ha)
    (fun m n hn => isIso_stepApp q t hcart m n hn)
    (fun m n hn => (Stacks.Conormal.conormalAlgebra (incl t m)).negative_isZero n hn)

omit [∀ k, IsClosedImmersion (incl t k)] [∀ k, IsClosedImmersion (t k)] in
/-- The pieces of `𝒪_{X₀}[xᵢ]` of negative degree vanish: every section of the degree-`n` piece
is zero for `n < 0`. -/
lemma polyAlgebra_eq_zero (n : ℤ) (hn : n < 0) (U : (Xn 0).Opensᵒᵖ)
    (y : ((Stacks.Coherent.polyAlgebra (Xn 0) ι).piece n).val.obj U) : y = 0 :=
  SheafOfModules.symmetricPiece_eq_zero_of_neg_sheafifiedSymmetricAlgebra _ _ n hn U y

/-- **The graded `𝒪_{X₀}[xᵢ]`-module `⨁ₙ Iⁿ𝒪_{Xₙ}`.** -/
def towerModule : SheafOfModules.GradedModule (Stacks.Coherent.polyAlgebra (Xn 0) ι) :=
  (conormalTower q t hcart a ha).module (polyAlgebra_eq_zero (ι := ι))

/-- The degree-`n` piece of `towerModule` is the degree-`n` piece of the conormal algebra `Cₙ`. -/
lemma towerModule_piece (n : ℕ) :
    (towerModule q t hcart a ha).piece (n : ℤ) = (conormalAlg t n).piece (n : ℤ) := rfl

/-- Every piece of `towerModule` is quasi-coherent. -/
lemma isQuasicoherent_towerModule (n : ℤ) :
    ((towerModule q t hcart a ha).piece n).IsQuasicoherent :=
  (Stacks.Conormal.conormalAlgebra (incl t n.toNat)).isQuasicoherent n

/-! ### Every affine open of `X₀` is a chart -/

include hcart in
omit hct in
/-- Every open of `X₀` is the preimage of an open of `Xₖ`. -/
lemma exists_preimage_eq (k : ℕ) (U : (Xn 0).Opens) : ∃ W : (Xn k).Opens, incl t k ⁻¹ᵁ W = U := by
  have hsurj := surjective_incl q t hcart k
  have hemb := (incl t k).isClosedEmbedding
  have himg : IsOpen ((incl t k).base '' (U : Set (Xn 0))) := by
    have hc := hemb.isClosedMap _ U.isOpen.isClosed_compl
    rw [Set.image_compl_eq ⟨hemb.injective, hsurj⟩] at hc
    exact isClosed_compl_iff.mp hc
  refine ⟨⟨_, himg⟩, Opens.ext ?_⟩
  exact Set.preimage_image_eq _ hemb.injective

include hcart in
omit hct in
/-- **Every affine open of `X₀` is a chart**, for a tower of locally Noetherian schemes: the open
of `Xₖ` it comes from is affine because `X₀ ⟶ Xₖ` is a thickening. -/
lemma exists_chartOpen_eq [∀ k, IsLocallyNoetherian (Xn k)] (k : ℕ) (U : (Xn 0).affineOpens) :
    ∃ V : (Xn k).affineOpens, chartOpen t k V = U.1 := by
  obtain ⟨W, hW⟩ := exists_preimage_eq q t hcart k U.1
  have : Surjective (incl t k) := ⟨surjective_incl q t hcart k⟩
  have hWaff : IsAffineOpen W :=
    Stacks.AmpleSurjectiveThickening.isAffineOpen_of_isAffineOpen_preimage (incl t k) W
      (hW ▸ U.2)
  exact ⟨⟨W, hWaff⟩, hW⟩

/-! ### The ideal of `X₀` on a chart is generated by the `aᵢ` -/

omit [∀ k, IsClosedImmersion (incl t k)] [∀ k, IsClosedImmersion (t k)] in
/-- On an affine open `V` of `Xₖ`, the section `genElt q k V x` is the image under
`baseAppLEAt q k V` of the class of `x` in the global sections of `Spec (A ⧸ I ^ (k + 1))`. -/
lemma genElt_eq_baseAppLEAt (k : ℕ) (V : (Xn k).affineOpens) (x : A) :
    genElt q k V.1 x = (baseAppLEAt q k V).hom
      ((Scheme.ΓSpecIso (CommRingCat.of (A ⧸ I ^ (k + 1)))).inv.hom (Ideal.Quotient.mk _ x)) := by
  rw [genElt, towerHom, adicThickeningι, baseSectionHom_comp_specMap]
  rfl

include hcart in
omit hct in
/-- If `I` is generated by the `aᵢ`, the ideal of `X₀` on an affine open `V` of `Xₖ` is contained
in the ideal generated by the sections `genElt q k V (a i)`. -/
lemma chartIdeal_le_span (hspan : Ideal.span (Set.range a) = I) (k : ℕ)
    (V : (Xn k).affineOpens) :
    Stacks.Conormal.chartIdeal (incl t k) V ≤
      Ideal.span (Set.range fun i => genElt q k V.1 (a i)) := by
  have h : Stacks.Conormal.chartIdeal (incl t k) V = (towerIdealPow q k 1 (by omega)).ideal V := by
    rw [towerIdealPow_one q t hcart k, Scheme.Hom.ker_apply]
  rw [h, ideal_towerIdealPow, Ideal.map_le_iff_le_comap]
  intro x hx
  set e := Scheme.ΓSpecIso (CommRingCat.of (A ⧸ I ^ (k + 1)))
  rw [mem_ker_appTop_iff] at hx
  simp only [CommRingCat.hom_ofHom, Ideal.Quotient.factor_ker, pow_one] at hx
  have hx2 : e.hom.hom x ∈ Ideal.span (Ideal.Quotient.mk (I ^ (k + 1)) '' Set.range a) := by
    rw [← Ideal.map_span, hspan]; exact hx
  have hxe : x = e.inv.hom (e.hom.hom x) := by
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  rw [Ideal.mem_comap, hxe, ← CommRingCat.comp_apply]
  have hmem := Ideal.mem_map_of_mem (e.inv ≫ baseAppLEAt q k V).hom hx2
  rw [Ideal.map_span] at hmem
  refine Ideal.span_mono ?_ hmem
  rintro _ ⟨_, ⟨_, ⟨i, rfl⟩, rfl⟩, rfl⟩
  exact ⟨i, (genElt_eq_baseAppLEAt q k V (a i)).trans rfl⟩

/-! ### The structure maps are surjective on the charts -/

section Cover

variable {m : ℕ} (V : (Xn m).affineOpens)

/-- A section of `Cₘ` over a chart is *covered* if it is in the image of `𝒪_{X₀}[xᵢ]`. -/
def IsCovered (j : ℤ) (b : ((conormalAlg t m).piece j).val.obj (op (chartOpen t m V))) : Prop :=
  ∃ c : ((Stacks.Coherent.polyAlgebra (Xn 0) ι).piece j).val.obj (op (chartOpen t m V)),
    ((polyHomTower q t hcart a ha m).app j).val.app _ c = b

omit hct in
/-- The zero section is covered. -/
lemma isCovered_zero (j : ℤ) : IsCovered q t hcart a ha V j 0 := ⟨0, map_zero _⟩

omit hct in
/-- A sum of covered sections is covered. -/
lemma isCovered_add (j : ℤ) {b b'} (hb : IsCovered q t hcart a ha V j b)
    (hb' : IsCovered q t hcart a ha V j b') : IsCovered q t hcart a ha V j (b + b') := by
  obtain ⟨c, rfl⟩ := hb
  obtain ⟨c', rfl⟩ := hb'
  exact ⟨c + c', map_add _ _ _⟩

omit hct in /-- Covered ideal-power classes add. -/ private lemma isCovered_localMap_add (j : ℕ)
    {y z : ↥(Stacks.Conormal.chartIdeal (incl t m) V ^ j)}
    (hy : IsCovered q t hcart a ha V j ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
      (isClosedImmersion_resLE_incl t m V.1) j y))
    (hz : IsCovered q t hcart a ha V j ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
      (isClosedImmersion_resLE_incl t m V.1) j z)) :
    IsCovered q t hcart a ha V j ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
      (isClosedImmersion_resLE_incl t m V.1) j (y + z)) := by
  rw [map_add]
  exact isCovered_add q t hcart a ha V j hy hz

omit hct in
/-- The product of a section of `𝒪_{X₀}` and a covered section is covered. -/
lemma isCovered_smul (j : ℤ) (r : (Xn 0).ringCatSheaf.obj.obj (op (chartOpen t m V))) {b}
    (hb : IsCovered q t hcart a ha V j b) : IsCovered q t hcart a ha V j (r • b) := by
  obtain ⟨c, rfl⟩ := hb
  exact ⟨r • c, (((polyHomTower q t hcart a ha m).app j).val.app _).hom.map_smul r c⟩

omit hct in
/-- The product in `Cₘ` of covered sections of degrees `j` and `j'` is covered in degree
`j + j'`. -/
lemma isCovered_mul (j j' : ℤ) {b b'} (hb : IsCovered q t hcart a ha V j b)
    (hb' : IsCovered q t hcart a ha V j' b') :
    IsCovered q t hcart a ha V (j + j') (((conormalAlg t m).mul j j').app _ b b') := by
  obtain ⟨c, rfl⟩ := hb
  obtain ⟨c', rfl⟩ := hb'
  exact ⟨((Stacks.Coherent.polyAlgebra (Xn 0) ι).mul j j').app _ c c',
    (polyHomTower q t hcart a ha m).map_mul j j' _ c c'⟩

omit hct in
/-- The unit of `Cₘ` is covered. -/
lemma isCovered_one : IsCovered q t hcart a ha V 0 ((conormalAlg t m).one.eval _) :=
  ⟨(Stacks.Coherent.polyAlgebra (Xn 0) ι).one.eval _, (polyHomTower q t hcart a ha m).map_one _⟩

omit hct in
/-- The degree-one class `genClass q t hcart a ha m i V` of the generator `a i` is covered. -/
lemma isCovered_genClass (i : ι) :
    IsCovered q t hcart a ha V 1 (genClass q t hcart a ha m i V) := by
  have hcomp : (Limits.Sigma.ι (fun _ : ι => SheafOfModules.unit (Xn 0).ringCatSheaf) i ≫
        SheafOfModules.sheafifiedSymmetricGenerator (Opens.grothendieckTopology ↥(Xn 0))
          (SheafOfModules.free (R := (Xn 0).ringCatSheaf) ι)) ≫
          (polyHomTower q t hcart a ha m).app 1 = genHom q t hcart a ha m i :=
    (Category.assoc _ _ _).trans
      ((congrArg (fun g => Limits.Sigma.ι (fun _ : ι => SheafOfModules.unit (Xn 0).ringCatSheaf) i
          ≫ g) (polyHomTower_extends q t hcart a ha m)).trans (Limits.Sigma.ι_comp_desc _ _))
  refine ⟨(Limits.Sigma.ι (fun _ : ι => SheafOfModules.unit (Xn 0).ringCatSheaf) i ≫
      SheafOfModules.sheafifiedSymmetricGenerator (Opens.grothendieckTopology ↥(Xn 0))
        (SheafOfModules.free (R := (Xn 0).ringCatSheaf) ι)).val.app (op (chartOpen t m V))
      (1 : (Xn 0).ringCatSheaf.obj.obj (op (chartOpen t m V))), ?_⟩
  have h1 := congrArg (fun g : SheafOfModules.unit (Xn 0).ringCatSheaf ⟶
      (conormalAlg t m).piece 1 => g.val.app (op (chartOpen t m V))
        (1 : (Xn 0).ringCatSheaf.obj.obj (op (chartOpen t m V)))) hcomp
  refine h1.trans ?_
  have h2 := congrArg (fun f => f (1 : (Xn 0).ringCatSheaf.obj.obj (op (chartOpen t m V))))
    (congrArg ModuleCat.Hom.hom (genHom_app q t hcart a ha m i V))
  exact h2.trans (one_smul _ _)

include ha in
omit hct in
/-- If `I` is generated by the `aᵢ`, the degree-one class of every element of the ideal of `X₀`
on the chart of `V` is covered. -/
lemma isCovered_localMap_one (hspan : Ideal.span (Set.range a) = I) (w : Γ(Xn m, V.1))
    (hw : w ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 1) :
    IsCovered q t hcart a ha V 1 ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
      (isClosedImmersion_resLE_incl t m V.1) 1 ⟨w, hw⟩) := by
  have hle : Ideal.span (Set.range fun i => genElt q m V.1 (a i)) ≤
      Stacks.Conormal.chartIdeal (incl t m) V := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact genElt_mem q t hcart m V (a i) (ha i)
  have hw1 : w ∈ Stacks.Conormal.chartIdeal (incl t m) V := by rwa [pow_one] at hw
  have key : ∀ x ∈ Ideal.span (Set.range fun i => genElt q m V.1 (a i)),
      ∀ hx : x ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 1,
      IsCovered q t hcart a ha V 1 ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
        (isClosedImmersion_resLE_incl t m V.1) 1 ⟨x, hx⟩) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      exact fun _ => isCovered_genClass q t hcart a ha V i
    | zero =>
      intro hx
      rw [show (⟨0, hx⟩ : ↥(Stacks.Conormal.chartIdeal (incl t m) V ^ 1)) = 0 from rfl, map_zero]
      exact isCovered_zero q t hcart a ha V 1
    | add y z hy hz ihy ihz =>
      intro hx
      have hy1 : y ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 1 := by rw [pow_one]; exact hle hy
      have hz1 : z ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 1 := by rw [pow_one]; exact hle hz
      exact isCovered_localMap_add q t hcart a ha V 1 (y := ⟨y, hy1⟩) (z := ⟨z, hz1⟩)
        (ihy hy1) (ihz hz1)
    | smul c y hy ihy =>
      intro hx
      have hy1 : y ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 1 := by rw [pow_one]; exact hle hy
      rw [(Stacks.Conormal.conormalAlgebra (incl t m)).localMap_smul V _ 1 c ⟨y, hy1⟩ ⟨_, hx⟩ rfl]
      exact isCovered_smul q t hcart a ha V 1 _ (ihy hy1)
  exact key w (chartIdeal_le_span q t hcart a hspan m V hw1) hw

include ha in
omit hct in
/-- If `I` is generated by the `aᵢ`, the degree-`j` class of every element of the `j`-th power
of the ideal of `X₀` on the chart of `V` is covered. -/
lemma isCovered_localMap (hspan : Ideal.span (Set.range a) = I) (j : ℕ)
    (b : ↥(Stacks.Conormal.chartIdeal (incl t m) V ^ j)) :
    IsCovered q t hcart a ha V j ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
      (isClosedImmersion_resLE_incl t m V.1) j b) := by
  induction j with
  | zero =>
    have h1 : (1 : Γ(Xn m, V.1)) ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 0 := by
      rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
    rw [(Stacks.Conormal.conormalAlgebra (incl t m)).localMap_smul V _ 0 b ⟨1, h1⟩ b
      (mul_one _).symm, (Stacks.Conormal.conormalAlgebra (incl t m)).localMap_one V _ ⟨1, h1⟩ rfl]
    exact isCovered_smul q t hcart a ha V 0 _ (isCovered_one q t hcart a ha V)
  | succ j ih =>
    have key : ∀ x ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ j *
        Stacks.Conormal.chartIdeal (incl t m) V,
        ∃ hx : x ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ (j + 1),
        IsCovered q t hcart a ha V ((j + 1 : ℕ) : ℤ)
          ((Stacks.Conormal.conormalAlgebra (incl t m)).localMap V
            (isClosedImmersion_resLE_incl t m V.1) (j + 1) ⟨x, hx⟩) := by
      intro x hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro y hy w hw
        have hw1 : w ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ 1 := by rwa [pow_one]
        have hyw : y * w ∈ Stacks.Conormal.chartIdeal (incl t m) V ^ (j + 1) := by
          rw [pow_succ]; exact Ideal.mul_mem_mul hy hw
        refine ⟨hyw, ?_⟩
        rw [(Stacks.Conormal.conormalAlgebra (incl t m)).localMap_mul V _ j 1 ⟨y, hy⟩ ⟨w, hw1⟩
          ⟨_, hyw⟩ rfl]
        exact isCovered_mul q t hcart a ha V j 1 (ih ⟨y, hy⟩)
          (isCovered_localMap_one q t hcart a ha V hspan w hw1)
      · rintro y z ⟨hy, Py⟩ ⟨hz, Pz⟩
        refine ⟨Ideal.add_mem _ hy hz, ?_⟩
        exact isCovered_localMap_add q t hcart a ha V (j + 1) (y := ⟨y, hy⟩) (z := ⟨z, hz⟩) Py Pz
    obtain ⟨_, P⟩ := key b (by rw [← pow_succ]; exact b.2)
    exact P

include ha in
omit hct in
/-- If `I` is generated by the `aᵢ`, the structure map `𝒪_{X₀}[xᵢ] ⟶ Cₘ` is surjective in every
degree `j ≥ 0` on sections over the chart of `V`. -/
lemma surjective_polyHomTower_chart (hspan : Ideal.span (Set.range a) = I) (j : ℕ) :
    Function.Surjective (((polyHomTower q t hcart a ha m).app (j : ℤ)).val.app
      (op (chartOpen t m V))) := by
  intro y
  obtain ⟨b, rfl⟩ := (Stacks.Conormal.conormalAlgebra (incl t m)).localMap_surjective V
    (isClosedImmersion_resLE_incl t m V.1) j y
  exact isCovered_localMap q t hcart a ha V hspan j b

end Cover

/-! ### Finite type, and the uniform vanishing -/

include ha in
/-- **The graded module `⨁ₙ Iⁿ𝒪_{Xₙ}` is of finite type**, generated in degree zero by the unit,
for a tower of locally Noetherian schemes and generators `aᵢ` of `I`. -/
theorem isFiniteTypeOnAffine_towerModule [∀ k, IsLocallyNoetherian (Xn k)]
    (hspan : Ideal.span (Set.range a) = I) :
    Stacks.Coherent.IsFiniteTypeOnAffine (towerModule q t hcart a ha) := by
  refine (conormalTower q t hcart a ha).isFiniteTypeOnAffine_module _ fun U n hn => ?_
  obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
  obtain ⟨V, hV⟩ := exists_chartOpen_eq q t hcart k U
  have h := surjective_polyHomTower_chart q t hcart a ha V hspan k
  rw [hV] at h
  exact h

include ha in
/-- **The uniform vanishing of the twisted transition kernels, [Stacks, Tag 089A].** Let `A` be
Noetherian, `I = (aᵢ)` with finitely many generators, `X₀ ⟶ S₀` proper and `L` ample on `X₀`.
Then one `d₀` kills `Hᵖ(X₀, Iⁿ𝒪_{Xₙ} ⊗ L ^⊗ d)` for all `p > 0`, all `d ≥ d₀` and all `n`. -/
theorem exists_isZero_Hgroup_towerModule [IsNoetherianRing A] [IsProper (q 0)] [Finite ι]
    (hspan : Ideal.span (Set.range a) = I) (L : (Xn 0).Modules) [IsInvertibleModule (Xn 0) L]
    (hL : IsAmple (Xn 0) L) :
    ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d → ∀ p : ℕ, 0 < p → ∀ n : ℤ,
      IsZero (Hgroup (Xn 0).ringCatSheaf ⊤ p
        (tensorModules (Xn 0) ((towerModule q t hcart a ha).piece n)
          (tensorPowModule (Xn 0) L d))) := by
  have : ∀ k, IsLocallyNoetherian (Xn k) := isLocallyNoetherian_tower q t hcart
  have : IsProper (q 0 ≫ adicThickeningι A I 0) := by
    have : IsClosedImmersion (adicThickeningι A I 0) := by
      rw [adicThickeningι]
      exact IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    infer_instance
  exact Stacks.Coherent.exists_isZero_Hgroup_piece_tensorPowModule_polyAlgebra A
    (q 0 ≫ adicThickeningι A I 0) L hL ι (towerModule q t hcart a ha)
    (isQuasicoherent_towerModule q t hcart a ha)
    (isFiniteTypeOnAffine_towerModule q t hcart a ha hspan)

end Stacks.AdicTower

end
