* [Stacks Project, Tag 0EJG](https://stacks.math.columbia.edu/tag/0EJG)
* [Stacks Project, Tag 0EJI](https://stacks.math.columbia.edu/tag/0EJI)
* [Stacks Project, Tag 0EHH](https://stacks.math.columbia.edu/tag/0EHH)
* [Stacks Project, Tag 0A80](https://stacks.math.columbia.edu/tag/0A80)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Stacks.Algebraization

variable (S : AlgebraizationSituation.{u})

/-! ### The two spellings of the ideal sheaf -/

/-- The ideal sheaf `I 𝒪_X` of an algebraization situation is the kernel ideal sheaf of the
closed immersion `Y ⟶ X`. -/
public theorem idealOnX_eq_ker_Yι : idealOnX S = S.Yι.ker :=
  (ker_Yι_eq_ofIdealTop S).symm

/-- The pullback to `U` of the kernel ideal sheaf of `Y ⟶ X` is `I 𝒪_U`. -/
public theorem ker_Yι_comap_eq_idealOnOpen : S.Yι.ker.comap S.U.ι = idealOnOpen S :=
  congrArg (fun J : S.X.IdealSheafData => J.comap S.U.ι) (idealOnX_eq_ker_Yι S).symm

/-- Transport a coherent adic system along an equality of ideal sheaves.  The underlying
inverse diagram is unchanged; only the membership proof is transported.  Both ideal sheaves are
variables, so the transport is an elimination of an equation between variables and the
concrete ideal sheaves of a situation are never unfolded. -/
public def castSystem {X : Scheme.{u}} {I J : X.IdealSheafData} (h : I = J)
    (F : Stacks.Coherent.CoherentAdicSystems I) :
    Stacks.Coherent.CoherentAdicSystems J := by
  subst h
  exact F

/-- Transport along an equality of ideal sheaves does not change the underlying diagram. -/
public theorem castSystem_obj {X : Scheme.{u}} {I J : X.IdealSheafData} (h : I = J)
    (F : Stacks.Coherent.CoherentAdicSystems I) :
    (castSystem h F).obj = F.obj := by
  subst h
  rfl

/-- A coherent adic system along `I 𝒪_U`, read along the kernel-ideal-sheaf spelling of that
ideal used by `Stacks.Algebraization.ExtendsToX`. -/
public def toKerSystem (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S)) :
    Stacks.Coherent.CoherentAdicSystems (S.Yι.ker.comap S.U.ι) :=
  castSystem (ker_Yι_comap_eq_idealOnOpen S).symm F

public theorem toKerSystem_obj (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S)) :
    (toKerSystem S F).obj = F.obj :=
  castSystem_obj _ F

/-! ### Transports along the two spellings -/

/-- The conclusion of `Stacks.Algebraization.ExtendsToX` with the ideal sheaf on `X` a
variable, so that an extension found along `I 𝒪_X` is one along the kernel ideal sheaf. -/
private theorem exists_restrictionIso_of_eq
    {I : S.X.IdealSheafData} (hI : I = S.Yι.ker)
    (G : Stacks.Coherent.CoherentAdicSystems I)
    {D : ℕᵒᵖ ⥤ S.U.toScheme.Modules}
    (e : G.obj ⋙ Scheme.Modules.restrictFunctor S.U.ι ≅ D) :
    ∃ G' : Stacks.Coherent.CoherentAdicSystems S.Yι.ker,
      Nonempty (G'.obj ⋙ Scheme.Modules.restrictFunctor S.U.ι ≅ D) := by
  subst hI
  exact ⟨G, ⟨e⟩⟩

/-- The conclusion of `Stacks.Algebraization.ExtendsToX` depends on the system only through its
underlying diagram. -/
theorem exists_restrictionIso_congr
    {D D' : ℕᵒᵖ ⥤ S.U.toScheme.Modules} (h : D = D')
    (hD : ∃ G : Stacks.Coherent.CoherentAdicSystems S.Yι.ker,
      Nonempty (G.obj ⋙ Scheme.Modules.restrictFunctor S.U.ι ≅ D)) :
    ∃ G : Stacks.Coherent.CoherentAdicSystems S.Yι.ker,
      Nonempty (G.obj ⋙ Scheme.Modules.restrictFunctor S.U.ι ≅ D') := by
  obtain ⟨G, ⟨e⟩⟩ := hD
  exact ⟨G, ⟨e ≪≫ eqToIso h⟩⟩

/-! ### From canonical extension to extension -/

/-- **Conclusion (1) of [Stacks, Tag 0EIR].** If a coherent adic system `(ℱₙ)` on `U`
canonically extends to `X`, and if the quasi-coherent sheaves associated to its global sections
restrict on `U` to `(ℱₙ)` itself, then `(ℱₙ)` extends to `X`.

Restriction along `U ⟶ X` carries the pro-isomorphism of the canonical extension to a
pro-isomorphism on `U`, whose source is the pro-object of `(ℱₙ)` by the comparison
`hsections` and whose target is the pro-object of the termwise restriction of the extension;
two objects of `Coh(U, I𝒪_U)` presenting the same pro-object are isomorphic, the pro-object
functor being fully faithful. -/
public theorem extendsToX_of_canonicallyExtends
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))
    (hsections : tildeGlobalSectionsSystem S F ⋙
        Stacks.Coherent.quasicoherentModulesPullback S.U.ι ≅
      Stacks.Coherent.quasicoherentDiagram F)
    (h : CanonicallyExtends S F) :
    ExtendsToX S (toKerSystem S F) := by
  obtain ⟨G, ⟨e⟩⟩ := h
  obtain ⟨e'⟩ := Stacks.Coherent.nonempty_diagramToPro_comp_iso
    (Stacks.Coherent.quasicoherentModulesPullback S.U.ι)
    (tildeGlobalSectionsSystem S F) (Stacks.Coherent.quasicoherentDiagram G) e
  let G' : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S) :=
    (Stacks.Coherent.coherentAdicPullback S.U.ι (idealOnX S)).obj G
  have hdiag : Stacks.Coherent.quasicoherentDiagram G' =
      Stacks.Coherent.quasicoherentDiagram G ⋙
        Stacks.Coherent.quasicoherentModulesPullback S.U.ι :=
    Stacks.Coherent.coherentAdicPullback_quasicoherentDiagram S.U.ι (idealOnX S) G
  have key : (Stacks.Coherent.coherentAdicToPro S.U.toScheme (idealOnOpen S)).obj F ≅
      (Stacks.Coherent.coherentAdicToPro S.U.toScheme (idealOnOpen S)).obj G' :=
    (Stacks.Coherent.diagramToProMapIso hsections).symm ≪≫ e' ≪≫
      eqToIso (congrArg Stacks.Coherent.diagramToPro hdiag).symm
  obtain ⟨hff⟩ :=
    Stacks.Coherent.coherentAdicToPro_fullyFaithful S.U.toScheme (idealOnOpen S)
  have eGF : G.obj ⋙ Scheme.Modules.restrictFunctor S.U.ι ≅ F.obj :=
    Functor.isoWhiskerLeft G.obj (Scheme.Modules.restrictFunctorIsoPullback S.U.ι) ≪≫
      ((ObjectProperty.ι _).mapIso (hff.preimageIso key)).symm
  exact exists_restrictionIso_of_eq S (idealOnX_eq_ker_Yι S) G
    (eGF ≪≫ eqToIso (toKerSystem_obj S F).symm)

end Stacks.Algebraization

end
