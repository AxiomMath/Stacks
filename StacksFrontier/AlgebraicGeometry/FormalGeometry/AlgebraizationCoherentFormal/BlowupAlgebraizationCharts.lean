module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalChart
public import StacksFrontier.AlgebraicGeometry.Blowup.Proper
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AlgebraizationSituation
public import StacksFrontier.RingTheory.LocalCohomology.VanishingTFAE.BlowupFibreDimension
public import StacksFrontier.RingTheory.LocalCohomology.VanishingTFAE.ClopenCriterion
public import StacksFrontier.RingTheory.LocalCohomology.CohomologicalDimensionBounds

/-!
# The affine charts of the blowup in the proof of Stacks 0EJK

In Situation [Stacks, Tag 0EHC] let `b : X' ⟶ X = Spec(A)` be the blowup of `X` in `I`. The proof
of [Stacks, Tag 0EJK] works on the affine charts `Spec(A[I/f])`, `f ∈ I`, of `X'`. This file
records what the proof uses about them:

* `X'` is Noetherian, being proper over the Noetherian scheme `X`;
* finitely many charts cover `X'`, and on each of them the exceptional ideal `I𝒪_{X'}` is
  generated by a single nonzerodivisor (`Stacks.Algebraization.exists_blowup_chartCover`);
* an ideal generated by a nonzerodivisor `t` is either the unit ideal or of cohomological
  dimension exactly one (`Stacks.Algebraization.span_eq_top_or_cohomologicalDimension_eq_one`):
  its cohomological dimension is at most one, and if it is at most zero then `V(t)` is open and
  closed, cut out by an idempotent `e` with `t e` nilpotent, so `e = 0` and `V(t) = ∅`.

## Main results

* `Stacks.Algebraization.isNoetherian_situationBlowUp`
* `Stacks.Algebraization.exists_blowup_chartCover`
* `Stacks.Algebraization.span_eq_top_or_cohomologicalDimension_eq_one`
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Algebraization

/-- **A principal ideal generated by a nonzerodivisor is the unit ideal or has cohomological
dimension one.** -/
theorem span_eq_top_or_cohomologicalDimension_eq_one {R : Type u} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (hfg : (Ideal.span ({t} : Set R)).FG) :
    Ideal.span ({t} : Set R) = ⊤ ∨
      Stacks.LocalCohomology.cohomologicalDimension R (Ideal.span {t}) hfg = 1 := by
  have h := Stacks.LocalCohomology.cohomologicalDimension_le_card_generators R (Ideal.span {t})
    hfg (n := 1) ![t] (by simp)
  rcases (show Stacks.LocalCohomology.cohomologicalDimension R (Ideal.span {t}) hfg ≤ 0 ∨
      Stacks.LocalCohomology.cohomologicalDimension R (Ideal.span {t}) hfg = 1 by omega)
    with h0 | h1
  · left
    have hcl :=
      (Stacks.LocalCohomology.isClopen_zeroLocus_iff_cohomologicalDimension_le_zero R _ hfg).1 h0
    rw [PrimeSpectrum.zeroLocus_span] at hcl
    obtain ⟨e, he, hse⟩ := PrimeSpectrum.isClopen_iff.1 hcl
    have hnil : IsNilpotent (t * e) := by
      rw [← mem_nilradical, nilradical_eq_sInf, Submodule.mem_sInf]
      intro p hp
      by_cases hep : e ∈ p
      · exact Ideal.mul_mem_left p t hep
      · have : (⟨p, hp⟩ : PrimeSpectrum R) ∈ PrimeSpectrum.zeroLocus {t} := by
          rwa [hse]
        exact Ideal.mul_mem_right e p (by simpa using this)
    obtain ⟨n, hn⟩ := hnil
    have hn' : t ^ (n + 1) * e = 0 := by
      have h1 : (t * e) ^ (n + 1) = 0 := by rw [pow_succ, hn, zero_mul]
      rwa [mul_pow, he.pow_succ_eq n] at h1
    have he0 : e = 0 := (mem_nonZeroDivisors_iff.1 (pow_mem ht (n + 1))).1 e hn'
    rw [← PrimeSpectrum.zeroLocus_empty_iff_eq_top, PrimeSpectrum.zeroLocus_span, hse, he0,
      PrimeSpectrum.basicOpen_zero]
    rfl
  · exact Or.inr h1

variable (S : AlgebraizationSituation.{u})

/-- The blowup of `X = Spec(A)` in `I`, in the model of `Stacks.Blowup.blowUp`. -/
abbrev situationBlowUp : Scheme.{u} :=
  Stacks.Blowup.blowUp (Stacks.LocalCohomology.specIdealSheaf S.A S.I)

/-- The blowup morphism `b : X' ⟶ X`. -/
abbrev situationBlowUpToBase : situationBlowUp S ⟶ S.X :=
  Stacks.Blowup.blowUpToBase (Stacks.LocalCohomology.specIdealSheaf S.A S.I)

/-- The exceptional ideal `I𝒪_{X'}`. -/
abbrev situationExceptionalIdeal : (situationBlowUp S).IdealSheafData :=
  Stacks.Blowup.exceptionalIdeal (Stacks.LocalCohomology.specIdealSheaf S.A S.I)

/-- The blowup of a Noetherian affine scheme is Noetherian. -/
instance isNoetherian_situationBlowUp : IsNoetherian (situationBlowUp S) := by
  have : IsLocallyNoetherian (situationBlowUp S) :=
    LocallyOfFiniteType.isLocallyNoetherian (situationBlowUpToBase S)
  have : CompactSpace (situationBlowUp S) :=
    QuasiCompact.compactSpace_of_compactSpace (situationBlowUpToBase S)
  exact {}

/-- **Finitely many affine charts cover the blowup, and on each of them the exceptional ideal is
generated by a nonzerodivisor** ([Stacks, Tag 0804] and [Stacks, Tag 02OS]). -/
theorem exists_blowup_chartCover :
    ∃ (ι : Type u) (_ : Finite ι) (T : ι → (situationBlowUp S).affineOpens),
      ⨆ i, (T i : (situationBlowUp S).Opens) = ⊤ ∧
      ∀ i, ∃ t ∈ nonZeroDivisors Γ(situationBlowUp S, (T i : (situationBlowUp S).Opens)),
        (situationExceptionalIdeal S).ideal (T i) = Ideal.span {t} := by
  classical
  let ℐ := Stacks.LocalCohomology.specIdealSheaf S.A S.I
  let U₀ : S.X.affineOpens := ⟨⊤, isAffineOpen_top _⟩
  let W : ℐ.ideal U₀ → (situationBlowUp S).affineOpens := fun r =>
    ⟨Stacks.Blowup.blowUpAffineChart ℐ U₀ r.2 ''ᵁ ⊤,
      (isAffineOpen_top _).image_of_isOpenImmersion _⟩
  have hW : ⨆ r, (W r : (situationBlowUp S).Opens) = ⊤ := by
    simp only [W, Scheme.Hom.image_top_eq_opensRange]
    rw [Stacks.Blowup.iSup_opensRange_blowUpAffineChart ℐ U₀]
    rfl
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun r => ((W r : (situationBlowUp S).Opens) : Set (situationBlowUp S)))
    (fun r => (W r).1.isOpen) (fun x _ => by
      have : x ∈ (⨆ r, (W r : (situationBlowUp S).Opens)) := hW ▸ trivial
      exact Set.mem_iUnion.mpr (Opens.mem_iSup.mp this))
  refine ⟨t, inferInstance, fun r => W r.1, ?_, fun r => ?_⟩
  · refine top_le_iff.mp fun x _ => ?_
    obtain ⟨r, hr, hx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    exact Opens.mem_iSup.mpr ⟨⟨r, hr⟩, hx⟩
  · exact Stacks.Blowup.exists_span_eq_ideal_exceptionalIdeal_blowUpAffineChart ℐ U₀ r.1.2

end Stacks.Algebraization

end
