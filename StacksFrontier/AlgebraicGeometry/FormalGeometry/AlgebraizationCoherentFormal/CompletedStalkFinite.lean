* [Stacks Project, Tag 031D](https://stacks.math.columbia.edu/tag/031D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.ModuleSkyscraper
open scoped AlgebraicGeometry

universe u

namespace Stacks.Algebraization

variable {X : Scheme.{u}}

/-! ### The stalk of an ideal-power multiple -/

/-- The germ at `x` of a section of `ℐ^n` over an affine open lies in the `n`-th power of the
stalk `ℐ_x`. -/
theorem germ_mem_stalk_pow (J : X.IdealSheafData) (n : ℕ) (U : X.affineOpens) {x : X}
    (hx : x ∈ U.1) {b : Γ(X, U.1)} (hb : b ∈ J.ideal U ^ n) :
    (X.presheaf.germ U.1 x hx).hom b ∈ IdealSheafData.stalk J x ^ n := by
  rw [IdealSheafData.stalk_eq_map_germ J x U hx, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ hb

/-- The germ at `x` of a section of `ℐ(U)^n Γ(ℳ, U)` over an affine open `U` lies in
`ℐ_x^n ℳ_x`. -/
theorem germ_mem_stalk_pow_smul (J : X.IdealSheafData) (n : ℕ) (M : X.Modules)
    (U : X.affineOpens) {x : X} (hx : x ∈ U.1) {s : Γ(M, U.1)}
    (hs : s ∈ J.ideal U ^ n • (⊤ : Submodule Γ(X, U.1) Γ(M, U.1))) :
    (M.presheaf.germ U.1 x hx).hom s ∈
      IdealSheafData.stalk J x ^ n •
        (⊤ : Submodule (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj M)) := by
  refine Submodule.smul_induction_on hs ?_ ?_
  · intro a ha m _
    have hmem : (X.presheaf.germ U.1 x hx).hom a •
        (show (modulesStalkFunctor X x).obj M from (M.presheaf.germ U.1 x hx).hom m) ∈
          IdealSheafData.stalk J x ^ n •
            (⊤ : Submodule (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj M)) :=
      Submodule.smul_mem_smul (germ_mem_stalk_pow J n U hx ha) Submodule.mem_top
    have key : (M.presheaf.germ U.1 x hx).hom (a • m)
        = (X.presheaf.germ U.1 x hx).hom a •
          (show (modulesStalkFunctor X x).obj M from (M.presheaf.germ U.1 x hx).hom m) :=
      germ_smul x U.1 hx a m
    rw [key]
    exact hmem
  · intro p q hp hq
    rw [map_add]
    exact Submodule.add_mem _ hp hq

/-- The germ of a section of a submodule subsheaf lies in the range of the induced map of
stalks. -/
theorem germ_mem_range_stalk_submodule_ι {M : X.Modules} (N : M.Submodule) (x : X) (U : X.Opens)
    (hx : x ∈ U) (s : Γ(M, U)) (hs : s ∈ N.toSubmodule.obj (op U)) :
    (M.presheaf.germ U x hx).hom s ∈
      LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules) N.ι).hom := by
  refine ⟨((show X.Modules from N.toSheafOfModules).presheaf.germ U x hx).hom ⟨s, hs⟩, ?_⟩
  rw [modulesStalkFunctor_map_germ (M := (show X.Modules from N.toSheafOfModules)) (N := M)
    N.ι x U hx ⟨s, hs⟩]
  rfl

/-- `ℐ_x^n ℳ_x` is contained in the stalk of `ℐ^n ℳ`. -/
theorem stalk_pow_smul_le_range_idealPowerMultiple (J : X.IdealSheafData) (n : ℕ) (M : X.Modules)
    [M.IsQuasicoherent] (x : X) :
    IdealSheafData.stalk J x ^ n •
        (⊤ : Submodule (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj M)) ≤
      LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules)
        (idealPowerMultiple J n M).ι).hom := by
  set K := LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules)
    (idealPowerMultiple J n M).ι).hom with hK
  -- The scalars whose action maps the whole stalk into `K` form an ideal.
  let T : Ideal (X.presheaf.stalk x) :=
    { carrier := {a | ∀ w : (modulesStalkFunctor X x).obj M, a • w ∈ K}
      zero_mem' := fun w => by rw [zero_smul]; exact K.zero_mem
      add_mem' := fun {a b} ha hb w => by
        simpa [add_smul] using K.add_mem (ha w) (hb w)
      smul_mem' := fun c {a} ha w => by
        simpa [smul_eq_mul, mul_smul] using K.smul_mem c (ha w) }
  have hsub : IdealSheafData.stalk J x ^ n ≤ T := by
    obtain ⟨U₀, hxU₀, -⟩ := exists_affineOpen_mem_le x ⊤ trivial
    rw [IdealSheafData.stalk_eq_map_germ J x U₀ hxU₀, ← Ideal.map_pow]
    refine Ideal.map_le_iff_le_comap.2 fun b hb => ?_
    intro w
    obtain ⟨V, hxV, t, ht⟩ := TopCat.Presheaf.exists_germ_eq M.presheaf w
    obtain ⟨U, hxU, hUle⟩ := exists_affineOpen_mem_le x (U₀.1 ⊓ V) ⟨hxU₀, hxV⟩
    have hUU₀ : U.1 ≤ U₀.1 := hUle.trans inf_le_left
    have hUV : U.1 ≤ V := hUle.trans inf_le_right
    -- restrict both the scalar and the section to `U`
    have hb'mem : (X.presheaf.map (homOfLE hUU₀).op).hom b ∈ J.ideal U ^ n := by
      have h1 : J.ideal U = Ideal.map (X.presheaf.map (homOfLE hUU₀).op).hom (J.ideal U₀) :=
        (Scheme.IdealSheafData.map_ideal J (U := U) (V := U₀) hUU₀).symm
      rw [h1, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hb
    have hsec : (X.presheaf.map (homOfLE hUU₀).op).hom b •
        (M.presheaf.map (homOfLE hUV).op).hom t ∈
          (idealPowerMultiple J n M).toSubmodule.obj (op U.1) := by
      rw [idealPowerMultiple_toSubmodule_obj_affine J n M U]
      exact Submodule.smul_mem_smul hb'mem Submodule.mem_top
    have hgerm := germ_mem_range_stalk_submodule_ι (idealPowerMultiple J n M) x U.1 hxU _ hsec
    have key : (M.presheaf.germ U.1 x hxU).hom
          ((X.presheaf.map (homOfLE hUU₀).op).hom b •
            (M.presheaf.map (homOfLE hUV).op).hom t)
        = (X.presheaf.germ U.1 x hxU).hom ((X.presheaf.map (homOfLE hUU₀).op).hom b) •
          (show (modulesStalkFunctor X x).obj M from
            (M.presheaf.germ U.1 x hxU).hom ((M.presheaf.map (homOfLE hUV).op).hom t)) :=
      germ_smul x U.1 hxU _ _
    rw [key] at hgerm
    have hbg : (X.presheaf.germ U.1 x hxU).hom ((X.presheaf.map (homOfLE hUU₀).op).hom b)
        = (X.presheaf.germ U₀.1 x hxU₀).hom b :=
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hUU₀) x hxU b
    have htg : (M.presheaf.germ U.1 x hxU).hom
        ((M.presheaf.map (homOfLE hUV).op).hom t) = w :=
      (TopCat.Presheaf.germ_res_apply M.presheaf (homOfLE hUV) x hxU t).trans ht
    rwa [hbg, htg] at hgerm
  refine Submodule.smul_le.2 fun a ha w _ => ?_
  exact hsub ha w

/-- The stalk of a submodule subsheaf is contained in any submodule of `ℳ_x` containing the
germs at `x` of the sections of the subsheaf over the affine open neighbourhoods of `x`.

Every element of the stalk of the subsheaf is the germ of a section over some open
neighbourhood, and the affine opens form a basis, so the section may be restricted to an affine
neighbourhood without changing its germ. -/
theorem range_stalk_submodule_ι_le_of_affine {M : X.Modules} (N : M.Submodule) (x : X)
    (S : Submodule (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj M))
    (h : ∀ (U : X.affineOpens) (hx : x ∈ U.1) (s : Γ(M, U.1)),
      s ∈ N.toSubmodule.obj (op U.1) → (M.presheaf.germ U.1 x hx).hom s ∈ S) :
    LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules) N.ι).hom ≤ S := by
  rintro z ⟨w, rfl⟩
  obtain ⟨V, hxV, t, ht⟩ := TopCat.Presheaf.exists_germ_eq
    (show X.Modules from N.toSheafOfModules).presheaf w
  obtain ⟨U, hxU, hUV⟩ := exists_affineOpen_mem_le x V hxV
  have hmapgerm := modulesStalkFunctor_map_germ
    (M := (show X.Modules from N.toSheafOfModules)) (N := M) N.ι x V hxV t
  have hres : (M.presheaf.map (homOfLE hUV).op).hom
      ((Scheme.Modules.Hom.app N.ι V).hom t) ∈ N.toSubmodule.obj (op U.1) :=
    N.toSubmodule.map_mem (homOfLE hUV).op t.2
  have hgermeq : (M.presheaf.germ U.1 x hxU).hom
      ((M.presheaf.map (homOfLE hUV).op).hom ((Scheme.Modules.Hom.app N.ι V).hom t))
      = (M.presheaf.germ V x hxV).hom ((Scheme.Modules.Hom.app N.ι V).hom t) :=
    TopCat.Presheaf.germ_res_apply M.presheaf (homOfLE hUV) x hxU _
  rw [← ht, hmapgerm, ← hgermeq]
  exact h U hxU _ hres

/-- The stalk of `ℐ^n ℳ` is contained in `ℐ_x^n ℳ_x`. -/
theorem range_idealPowerMultiple_le_stalk_pow_smul (J : X.IdealSheafData) (n : ℕ) (M : X.Modules)
    [M.IsQuasicoherent] (x : X) :
    LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules)
        (idealPowerMultiple J n M).ι).hom ≤
      IdealSheafData.stalk J x ^ n •
        (⊤ : Submodule (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj M)) :=
  range_stalk_submodule_ι_le_of_affine _ x _ fun U hx _s hs =>
    germ_mem_stalk_pow_smul J n M U hx
      ((idealPowerMultiple_toSubmodule_obj_affine J n M U) ▸ hs)

/-- **The stalk of the ideal-power multiple `ℐ^n ℳ` is `ℐ_x^n ℳ_x`.**

For a quasi-coherent `ℳ` the sections of `ℐ^n ℳ` over an affine open `U` are `ℐ(U)^n Γ(ℳ, U)`,
and `ℐ_x` is generated by the germs of the sections of `ℐ` over such a `U`; the equality is the
two resulting inclusions. -/
theorem stalk_idealPowerMultiple (J : X.IdealSheafData) (n : ℕ) (M : X.Modules)
    [M.IsQuasicoherent] (x : X) :
    LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules)
        (idealPowerMultiple J n M).ι).hom =
      IdealSheafData.stalk J x ^ n •
        (⊤ : Submodule (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj M)) :=
  le_antisymm (range_idealPowerMultiple_le_stalk_pow_smul J n M x)
    (stalk_pow_smul_le_range_idealPowerMultiple J n M x)

/-! ### The transition maps of a coherent adic system on stalks -/

/-- The stalk of a submodule subsheaf is the kernel of the stalk of the quotient projection: the
stalk functor on a scheme is exact, so it carries the short exact sequence
`0 → 𝒩 → ℳ → ℳ/𝒩 → 0` to a short exact sequence of stalk modules. -/
theorem range_stalk_submodule_ι_eq_ker_stalk_cokernel_π {M : X.Modules} (N : M.Submodule)
    (x : X) :
    LinearMap.range ((modulesStalkFunctor X x).map (C := X.Modules) N.ι).hom =
      LinearMap.ker ((modulesStalkFunctor X x).map (C := X.Modules)
        (cokernel.π (C := X.Modules) N.ι)).hom :=
  (ShortComplex.exact_cokernel (C := X.Modules) N.ι |>.map
    (modulesStalkFunctor X x)).moduleCat_range_eq_ker

/-- The stalk of the quotient projection `ℳ ⟶ ℳ/𝒩` is surjective. -/
theorem surjective_stalk_cokernel_π {M : X.Modules} (N : M.Submodule) (x : X) :
    Function.Surjective ((modulesStalkFunctor X x).map (C := X.Modules)
      (cokernel.π (C := X.Modules) N.ι)).hom := by
  have h1 : Epi (C := X.Modules) (cokernel.π (C := X.Modules) N.ι) := coequalizer.π_epi
  have h2 : Epi ((modulesStalkFunctor X x).map (C := X.Modules)
      (cokernel.π (C := X.Modules) N.ι)) := Functor.map_epi _ _
  exact (ModuleCat.epi_iff_surjective _).mp h2

variable {J : X.IdealSheafData}

/-- On stalks, the transition `ℱ_{n+1} → ℱ_n` of a coherent adic system factors as the
projection onto the quotient by `ℐ^{n+1} ℱ_{n+1}` followed by an isomorphism. -/
theorem stalk_coherentAdicTransition_factorisation
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) (n : ℕ)
    {e : idealPowerQuotient J (n + 1) (G.obj.obj (op (n + 1))) ≅ G.obj.obj (op n)}
    (he : cokernel.π ((idealPowerMultiple J (n + 1) (G.obj.obj (op (n + 1)))).ι) ≫ e.hom =
      G.obj.map (homOfLE (Nat.le_succ n)).op) :
    (modulesStalkFunctor X x).map (C := X.Modules) (G.obj.map (homOfLE (Nat.le_succ n)).op)
      = (modulesStalkFunctor X x).map (C := X.Modules)
          (cokernel.π (C := X.Modules)
            (idealPowerMultiple J (n + 1) (G.obj.obj (op (n + 1)))).ι)
        ≫ (modulesStalkFunctor X x).map (C := X.Modules) e.hom := by
  rw [← Functor.map_comp]
  exact congrArg _ he.symm

/-- The stalk functor carries an isomorphism of modules to a bijection. -/
private theorem bijective_stalk_map_hom {A B : X.Modules} (e : A ≅ B) (x : X) :
    Function.Bijective ((modulesStalkFunctor X x).map (C := X.Modules) e.hom).hom :=
  ((modulesStalkFunctor X x).mapIso e).toLinearEquiv.bijective

/-- **A transition map of a coherent adic system is surjective on stalks.** -/
theorem surjective_stalk_coherentAdicTransition
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) (n : ℕ) :
    Function.Surjective ((modulesStalkFunctor X x).map (C := X.Modules)
      (G.obj.map (homOfLE (Nat.le_succ n)).op)).hom := by
  obtain ⟨e, he⟩ := G.property.2.2 n
  rw [stalk_coherentAdicTransition_factorisation G x n he, ModuleCat.hom_comp]
  exact (bijective_stalk_map_hom e x).2.comp
    (surjective_stalk_cokernel_π (idealPowerMultiple J (n + 1) (G.obj.obj (op (n + 1)))) x)

/-- **On stalks, the kernel of a transition map of a coherent adic system is
`ℐ_x^{n+1} ℱ_{n+1,x}`.**

The transition is the projection onto the quotient by `ℐ^{n+1} ℱ_{n+1}` composed with an
isomorphism, so its kernel on stalks is the stalk of `ℐ^{n+1} ℱ_{n+1}`, which is
`ℐ_x^{n+1} ℱ_{n+1,x}` by `Stacks.Algebraization.stalk_idealPowerMultiple`. -/
theorem ker_stalk_coherentAdicTransition
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) (n : ℕ) :
    LinearMap.ker ((modulesStalkFunctor X x).map (C := X.Modules)
        (G.obj.map (homOfLE (Nat.le_succ n)).op)).hom =
      IdealSheafData.stalk J x ^ (n + 1) •
        (⊤ : Submodule (X.presheaf.stalk x)
          ((modulesStalkFunctor X x).obj (G.obj.obj (op (n + 1))))) := by
  have hcoh : _root_.SheafOfModules.IsCoherent.{u} (G.obj.obj (op (n + 1))) :=
    G.property.1 (n + 1)
  have : (G.obj.obj (op (n + 1))).IsQuasicoherent := isQuasicoherent_of_isCoherent _
  obtain ⟨e, he⟩ := G.property.2.2 n
  have heker : LinearMap.ker ((modulesStalkFunctor X x).map (C := X.Modules) e.hom).hom = ⊥ :=
    LinearMap.ker_eq_bot.2 (bijective_stalk_map_hom e x).1
  rw [stalk_coherentAdicTransition_factorisation G x n he, ModuleCat.hom_comp,
    LinearMap.ker_comp, heker, Submodule.comap_bot,
    ← range_stalk_submodule_ι_eq_ker_stalk_cokernel_π,
    stalk_idealPowerMultiple J (n + 1) (G.obj.obj (op (n + 1))) x]

/-! ### Finiteness of the completed stalk -/

/-- The stalk at `x` of a term of a coherent adic system is a finite `𝒪_{X,x}`-module, each term
being coherent hence of finite type. -/
theorem finite_stalk_coherentAdicSystem_obj (G : Stacks.Coherent.CoherentAdicSystems J) (x : X)
    (n : ℕ) :
    Module.Finite (X.presheaf.stalk x) ((modulesStalkFunctor X x).obj (G.obj.obj (op n))) := by
  have hcoh : _root_.SheafOfModules.IsCoherent.{u} (G.obj.obj (op n)) := G.property.1 n
  have : (G.obj.obj (op n)).IsFiniteType := _root_.SheafOfModules.IsCoherent.isFiniteType
  exact _root_.SheafOfModules.finite_stalk X.sheaf (G.obj.obj (op n)) x

/-- The reduction modulo `ℐ_x` of the inverse limit of the stalks of a coherent adic system is a
finite `𝒪_{X,x}`-module.

The limit projection to level `0` is surjective with kernel `ℐ_x` times the limit, so the
reduction is the stalk `ℱ_{0,x}`, which is finite because `ℱ_0` is coherent. -/
theorem finite_quotient_moduleStalkLimit [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    Module.Finite (X.presheaf.stalk x)
      ((limit (G.obj ⋙ modulesStalkFunctor X x) :
          ModuleCat.{u} (X.presheaf.stalk x)) ⧸
        (IdealSheafData.stalk J x •
          (⊤ : Submodule (X.presheaf.stalk x)
            (limit (G.obj ⋙ modulesStalkFunctor X x) :
              ModuleCat.{u} (X.presheaf.stalk x))))) :=
  Stacks.Coherent.moduleLimit_zeroQuotient_finite (G.obj ⋙ modulesStalkFunctor X x)
    (fun n => surjective_stalk_coherentAdicTransition G x n)
    (fun n => ker_stalk_coherentAdicTransition G x n)
    (Ideal.fg_of_isNoetherianRing _) (finite_stalk_coherentAdicSystem_obj G x 0)

/-- `Stacks.Algebraization.formalStalk` is the inverse limit of the stalks in the spelling of
`Stacks.ModuleSkyscraper.modulesStalkFunctor`. The two stalk functors differ only by the
restriction of scalars along the comparison of the `RingCat`- and `CommRingCat`-valued stalks of
the structure sheaf, and that is exactly the isomorphism
`AlgebraicGeometry.restrictScalarsStalkFunctorIso`. -/
def formalStalkEquivModuleStalkLimit (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    formalStalk G x ≃ₗ[X.presheaf.stalk x]
      (limit (G.obj ⋙ modulesStalkFunctor X x) : ModuleCat.{u} (X.presheaf.stalk x)) :=
  (HasLimit.isoOfNatIso
    (Functor.isoWhiskerLeft G.obj
      (AlgebraicGeometry.restrictScalarsStalkFunctorIso x))).toLinearEquiv

/-- An isomorphism of modules carries `K M` to `K N`, for `K` an ideal of the base ring: the
image of `⊤` is the range, which is `⊤`. -/
theorem map_smul_top_linearEquiv {A : Type*} [CommRing A] {M N : Type*} [AddCommGroup M]
    [Module A M] [AddCommGroup N] [Module A N] (e : M ≃ₗ[A] N) (K : Ideal A) :
    Submodule.map e.toLinearMap (K • (⊤ : Submodule A M)) = K • (⊤ : Submodule A N) := by
  rw [Submodule.map_smul'', Submodule.map_top]
  exact congrArg (K • ·) (LinearMap.range_eq_top.2 e.surjective)

/-- **The reduction `ℱ_x^∧ / ℐ_x ℱ_x^∧` of the formal stalk is a finite `𝒪_{X,x}`-module.** -/
theorem finite_quotient_formalStalk [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    Module.Finite (X.presheaf.stalk x)
      (formalStalk G x ⧸
        (IdealSheafData.stalk J x •
          (⊤ : Submodule (X.presheaf.stalk x) (formalStalk G x)))) :=
  (finite_quotient_moduleStalkLimit G x).equiv
    (Submodule.Quotient.equiv _ _ (formalStalkEquivModuleStalkLimit G x)
      (map_smul_top_linearEquiv _ _)).symm

/-! ### The reduction of the formal stalk at every level

The limit projections of the stalk tower are surjective with kernel the `(n+1)`-st ideal-power
multiple at *every* level, not only at level zero
(`Stacks.Coherent.moduleLimit_projection_surjective`,
`Stacks.Coherent.moduleLimit_projection_ker`), so the identification behind
`Stacks.Algebraization.finite_quotient_formalStalk` is available at every level: the `n`-th
reduction of the formal stalk is the stalk of `ℱ_n`.
-/

/-- **The level-`n` reduction of the limit of the stalk tower is the stalk of `ℱ_n`:** the limit
projection to level `n` is surjective with kernel `ℐ_x^{n+1}` times the limit. -/
def moduleStalkLimitQuotientEquivStalk [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) (n : ℕ) :
    ((limit (G.obj ⋙ modulesStalkFunctor X x) : ModuleCat.{u} (X.presheaf.stalk x)) ⧸
        (IdealSheafData.stalk J x ^ (n + 1) •
          (⊤ : Submodule (X.presheaf.stalk x)
            (limit (G.obj ⋙ modulesStalkFunctor X x) :
              ModuleCat.{u} (X.presheaf.stalk x))))) ≃ₗ[X.presheaf.stalk x]
      ((modulesStalkFunctor X x).obj (G.obj.obj (op n))) :=
  (Submodule.quotEquivOfEq _ _
    (Stacks.Coherent.moduleLimit_projection_ker (I := IdealSheafData.stalk J x)
      (G.obj ⋙ modulesStalkFunctor X x)
      (fun k => surjective_stalk_coherentAdicTransition G x k)
      (fun k => ker_stalk_coherentAdicTransition G x k)
      (Ideal.fg_of_isNoetherianRing _) n).symm).trans
    (LinearMap.quotKerEquivOfSurjective _
      (Stacks.Coherent.moduleLimit_projection_surjective (G.obj ⋙ modulesStalkFunctor X x)
        (fun k => surjective_stalk_coherentAdicTransition G x k) n))

/-- **The level-`n` reduction of the formal stalk is the stalk of `ℱ_n`:**
`ℱ_x^∧ / ℐ_x^{n+1} ℱ_x^∧ ≅ ℱ_{n,x}`.

For `n = 0` this is the identification behind
`Stacks.Algebraization.finite_quotient_formalStalk`. -/
def formalStalkQuotientEquivStalk [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) (n : ℕ) :
    (formalStalk G x ⧸
        (IdealSheafData.stalk J x ^ (n + 1) •
          (⊤ : Submodule (X.presheaf.stalk x) (formalStalk G x)))) ≃ₗ[X.presheaf.stalk x]
      ((modulesStalkFunctor X x).obj (G.obj.obj (op n))) :=
  (Submodule.Quotient.equiv _ _ (formalStalkEquivModuleStalkLimit G x)
      (map_smul_top_linearEquiv _ _)).trans
    (moduleStalkLimitQuotientEquivStalk G x n)

/-- **Stacks 0EJE, finiteness of the completed stalk.**

Let `ℐ` be a quasi-coherent sheaf of ideals on a locally Noetherian scheme `X` and let `(ℱ_n)` be
an object of `Coh(X, ℐ)`. At every point `x` the completed stalk `ℱ_x^∧` is a finite module over
the completed local ring `𝒪_{X,x}^∧`.

Each `ℱ_n` is coherent, so `ℱ_{n,x}` is a finite `𝒪_{X,x}`-module, and the transitions are
surjective on stalks with kernel `ℐ_x^{n+1} ℱ_{n+1,x}`; the limit therefore has reduction
`ℱ_{0,x}` modulo `ℐ_x`, which is finite, and [Stacks, Tag 031D] turns a module with finite
reduction into one whose `ℐ_x`-adic completion is finite over `𝒪_{X,x}^∧`. -/
@[stacks 0EJE "finiteness of the completed stalk over the completed local ring"]
theorem finite_completedStalk [IsLocallyNoetherian X] (J : X.IdealSheafData)
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    Module.Finite (completedLocalRing J x) (completedStalk J G x) :=
  Stacks.Coherent.finite_adicCompletion_of_finite_reduction
    (Ideal.fg_of_isNoetherianRing _) (formalStalk G x) (finite_quotient_formalStalk G x)

/-- The completed stalk of an object of `Coh(X, ℐ)` on a Noetherian scheme is a finite module
over the completed local ring; the shape of `Stacks.Algebraization.finite_completedStalk` in
which a Noetherian scheme is assumed outright. -/
theorem finite_completedStalk_of_isNoetherian [IsNoetherian X] (J : X.IdealSheafData)
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    Module.Finite (completedLocalRing J x) (completedStalk J G x) :=
  finite_completedStalk J G x

/-! ### The formal stalk is its own completion -/

/-- **The formal stalk of a coherent adic system is already `ℐ_x`-adically complete.**

Each term `ℱ_{n,x}` of the stalk tower is a finite `𝒪_{X,x}`-module, the transitions are
surjective on stalks with kernel `ℐ_x^{n+1} ℱ_{n+1,x}` by
`Stacks.Algebraization.surjective_stalk_coherentAdicTransition` and
`Stacks.Algebraization.ker_stalk_coherentAdicTransition`, and `ℐ_x` is finitely generated
because `𝒪_{X,x}` is Noetherian; `Stacks.Coherent.moduleLimit_isAdicComplete` then gives
completeness of the limit in the `modulesStalkFunctor` spelling, which is transported to
`Stacks.Algebraization.formalStalk` along
`Stacks.Algebraization.formalStalkEquivModuleStalkLimit`. -/
theorem isAdicComplete_formalStalk [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    IsAdicComplete (IdealSheafData.stalk J x) (formalStalk G x) :=
  Stacks.Coherent.isAdicComplete_of_linearEquiv (IdealSheafData.stalk J x)
    (formalStalkEquivModuleStalkLimit G x)
    (Stacks.Coherent.moduleLimit_isAdicComplete (G.obj ⋙ modulesStalkFunctor X x)
      (fun n => surjective_stalk_coherentAdicTransition G x n)
      (fun n => ker_stalk_coherentAdicTransition G x n)
      (Ideal.fg_of_isNoetherianRing _))

/-- **Stacks 0EJE, the remaining identification: the formal stalk is canonically its own
completion.** Since `Stacks.Algebraization.formalStalk` is already `ℐ_x`-adically complete
(`Stacks.Algebraization.isAdicComplete_formalStalk`), the canonical map to
`Stacks.Algebraization.completedStalk` — which is by definition the `ℐ_x`-adic completion of the
formal stalk — is bijective. This is the fact that `Stacks.Algebraization.completedStalk`'s own
module docstring records as "the content of Stacks 0EJE and not proved here"; no `stacks`
attribute is placed, since the full statement of 0EJE also covers the finiteness already given
by `Stacks.Algebraization.finite_completedStalk`, and combining the two into one covering
declaration is left to whichever file registers that tag. -/
noncomputable def formalStalkEquivCompletedStalk [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) :
    formalStalk G x ≃ₗ[X.presheaf.stalk x] completedStalk J G x := by
  haveI := isAdicComplete_formalStalk G x
  exact LinearEquiv.ofBijective (AdicCompletion.of (IdealSheafData.stalk J x) (formalStalk G x))
    (AdicCompletion.of_bijective (IdealSheafData.stalk J x) (formalStalk G x))

/-- The `𝒪_{X,x}^∧`-submodule `(ℐ𝒪_{X,x}^∧)ⁿ N` of a module over the completed local ring has the
same elements as the `𝒪_{X,x}`-submodule `ℐ_xⁿ N`: the ideal that acts is the image of `ℐ_x`, so
the two differ only in which ring is made to act.

The module of interest is the completed stalk `ℱ_x^∧` and its quotients by the powers of
`ℐ𝒪_{X,x}^∧`. -/
theorem restrictScalars_completedLocalIdeal_pow_smul_top (J : X.IdealSheafData) (x : X)
    (N : Type*) [AddCommGroup N] [Module (X.presheaf.stalk x) N]
    [Module (completedLocalRing J x) N]
    [IsScalarTower (X.presheaf.stalk x) (completedLocalRing J x) N] (n : ℕ) :
    (completedLocalIdeal J x ^ n •
          (⊤ : Submodule (completedLocalRing J x) N)).restrictScalars (X.presheaf.stalk x) =
      IdealSheafData.stalk J x ^ n • (⊤ : Submodule (X.presheaf.stalk x) N) := by
  rw [completedLocalIdeal, ← Ideal.map_pow, Ideal.smul_restrictScalars,
    Submodule.restrictScalars_top]

/-- **The level-`n` reduction of the completed stalk is the stalk of `ℱ_n`:**
`ℱ_x^∧ / (ℐ𝒪_{X,x}^∧)ⁿ⁺¹ ℱ_x^∧ ≅ ℱ_{n,x}`.

The quotient on the left is by a submodule over the completed local ring, the ring that acts on
the completed stalk, and the ideal is the image `ℐ𝒪_{X,x}^∧` of `ℐ_x`; that submodule has the same
elements as `ℐ_x^{n+1} ℱ_x^∧` by
`Stacks.Algebraization.restrictScalars_completedLocalIdeal_pow_smul_top`, and the completed stalk
is the formal stalk by `Stacks.Algebraization.formalStalkEquivCompletedStalk`, so this is
`Stacks.Algebraization.formalStalkQuotientEquivStalk` read on the completed stalk. -/
def completedStalkQuotientEquivStalk [IsLocallyNoetherian X]
    (G : Stacks.Coherent.CoherentAdicSystems J) (x : X) (n : ℕ) :
    (completedStalk J G x ⧸
        (completedLocalIdeal J x ^ (n + 1) •
          (⊤ : Submodule (completedLocalRing J x) (completedStalk J G x)))) ≃ₗ[X.presheaf.stalk x]
      ((modulesStalkFunctor X x).obj (G.obj.obj (op n))) :=
  (Submodule.Quotient.restrictScalarsEquiv (X.presheaf.stalk x) _).symm.trans
    ((Submodule.quotEquivOfEq _ _
        (restrictScalars_completedLocalIdeal_pow_smul_top J x (completedStalk J G x)
          (n + 1))).trans
      ((Submodule.Quotient.equiv _ _ (formalStalkEquivCompletedStalk G x).symm
          (map_smul_top_linearEquiv _ _)).trans
        (formalStalkQuotientEquivStalk G x n)))

end Stacks.Algebraization

end
