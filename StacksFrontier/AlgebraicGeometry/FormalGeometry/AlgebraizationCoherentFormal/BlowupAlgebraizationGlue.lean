module

public import StacksFrontier.AlgebraicGeometry.Algebraization.DistanceVanishing
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AlgebraizationCoherentFormal.BlowupAlgebraizationPullback
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AlgebraizationCoherentFormal.BlowupChartConditions
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.ImprovingCoherentModules.DepthTwoExtensionExistence
public import StacksFrontier.AlgebraicGeometry.Modules.RestrictStalkDepth
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CoherentAdicSystem.StableImageExtension
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.RestrictOpen
public import StacksFrontier.RingTheory.LocalCohomology.TopLocalCohomology

/-!
# The canonical extensions on the charts of the blowup, in the proof of Stacks 0EJK

In Situation [Stacks, Tag 0EHC] let `b : X' ⟶ X` be the blowup in `I`, `U' = b⁻¹(U)`, and let
`(ℋₙ)` be an object of `Coh(U', I𝒪_{U'})` pro-isomorphic to an inverse system `(ℱ''ₙ)` of
coherent `𝒪_{U'}`-modules with `depth(ℱ''_{n,y}) ≥ 1` where `δ^{Y'}_{Z'}(y) ≤ 2` and
`depth(ℱ''_{n,y}) ≥ 2` where `δ^{Y'}_{Z'}(y) ≤ 1` (the output of [Stacks, Tag 0EJF]). On an
affine open `V ⊆ X'` on which `I𝒪_{X'}` is generated by a nonzerodivisor, the proof of
[Stacks, Tag 0EJK] applies [Stacks, Tag 0EJI] to the algebraization situation of `V`: there
`cd = 1` (or the ideal is the unit ideal), `δ` is at least `δ^{Y'}_{Z'}` by [Stacks, Tag 0EIY]
part (6), and so `depth + δ ≥ 3`. What is recorded here is the output the gluing needs: the
three conditions of [Stacks, Tag 0EHH] for the sections over `V` of the direct images
`j_*ℋₙ` (`Stacks.Algebraization.zeroEHHConditions_blowupChart`).
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Algebraization

variable (S : AlgebraizationSituation.{u})

/-- The algebraization situation of an affine open `V` of the blowup, for `U' ⊆ X'`. -/
abbrev blowupChartSituation (V : (situationBlowUp S).affineOpens) : AlgebraizationSituation.{u} :=
  chartSituation (situationExceptionalIdeal S) (situationBlowUpU S) V
    (compl_situationBlowUpU_subset S)

/-- **`depth + δ ≥ 3` on a chart of the blowup.** -/
theorem three_le_depth_add_chartDistance (V : (situationBlowUp S).affineOpens)
    (M : (situationBlowUpU S).toScheme.Modules)
    (hM : ∀ x : (situationBlowUpU S).toScheme,
      letI : Module ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (TopCat.Presheaf.stalk (C := Ab.{u}) M.val.presheaf x) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
          (R := (situationBlowUpU S).toScheme.presheaf) M.val x
      (x ∈ blowupT S 2 → (1 : ℕ∞) ≤ Module.depth ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk x))
          (TopCat.Presheaf.stalk (C := Ab.{u}) M.val.presheaf x)) ∧
        (x ∈ blowupT S 1 → (2 : ℕ∞) ≤ Module.depth
          ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk x))
          (TopCat.Presheaf.stalk (C := Ab.{u}) M.val.presheaf x)))
    (y : (blowupChartSituation S V).U.toScheme) (z : (blowupChartSituation S V).Y)
    (hyz : (blowupChartSituation S V).U.ι y = (blowupChartSituation S V).Yι z) :
    3 ≤ depthOfStalkOnOpen (blowupChartSituation S V)
        ((Scheme.Modules.restrictFunctor (chartMap (situationExceptionalIdeal S)
          (situationBlowUpU S) V (compl_situationBlowUpU_subset S))).obj M) y +
      (blowupChartSituation S V).distanceToZ z := by
  set j := chartMap (situationExceptionalIdeal S) (situationBlowUpU S) V
    (compl_situationBlowUpU_subset S)
  set e := (situationExceptionalIdeal S).subschemeCover.f V z
  have hpt : situationExceptionalι S e = (situationBlowUpU S).ι (j y) := by
    rw [situationExceptionalι_subschemeCover, ← hyz, ← Scheme.Hom.comp_apply,
      ← Scheme.Hom.comp_apply, chartMap_ι]
  have hdepth : depthOfStalkOnOpen (blowupChartSituation S V)
      ((Scheme.Modules.restrictFunctor j).obj M) y =
      Module.depth ((situationBlowUpU S).toScheme.presheaf.stalk (j y))
        (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk (j y)))
        (TopCat.Presheaf.stalk (C := Ab.{u}) M.val.presheaf (j y)) :=
    Scheme.Modules.depth_stalk_restrict j M y
  have hδ := exceptionalDistance_le_chartDistance S V z
  have hpos : exceptionalDistance S e ≠ 0 := by
    intro h0
    rw [distanceFunction_eq_zero_iff_mem] at h0
    exact (mem_exceptionalZ_iff S e).1 h0 (hpt ▸ (j y).2)
  obtain ⟨h1, h2⟩ := hM (j y)
  rw [hdepth]
  rcases le_or_gt (exceptionalDistance S e) 1 with hle1 | hgt1
  · calc (3 : ℕ∞) = 2 + 1 := by norm_num
      _ ≤ _ := add_le_add (h2 ⟨e, hpt, hle1⟩)
        ((Order.one_le_iff_pos.mpr (pos_iff_ne_zero.mpr hpos)).trans hδ)
  · rcases le_or_gt (exceptionalDistance S e) 2 with hle2 | hgt2
    · calc (3 : ℕ∞) = 1 + 2 := by norm_num
        _ ≤ _ := add_le_add (h1 ⟨e, hpt, hle2⟩) ((Order.add_one_le_of_lt hgt1).trans hδ)
    · exact ((Order.add_one_le_of_lt hgt2).trans hδ).trans le_add_self

/-- **The conditions of [Stacks, Tag 0EHH] on a chart of the blowup.** Let `V ⊆ X'` be an affine
open on which `I𝒪_{X'}` is generated by a nonzerodivisor `t`, and let `(ℋₙ)` be pro-isomorphic
to a system `(ℱ''ₙ)` with the depth bounds that [Stacks, Tag 0EJF] produces. Then the sections
over `V` of the direct images `j_*ℋₙ` satisfy the three conditions of 0EHH: if `t` is a unit the
terms vanish, and otherwise `cd = 1` and [Stacks, Tag 0EJI] applies on `V`. -/
theorem zeroEHHConditions_blowupChart (hX : LocallyHasDualizingComplex (situationBlowUp S))
    (H : Stacks.Coherent.CoherentAdicSystems (blowupIdealU S))
    (F'' : ℕᵒᵖ ⥤ (situationBlowUpU S).toScheme.Modules) [∀ n, (F''.obj n).IsCoherent]
    (e : InverseSequence.ProIso F'' H.obj)
    (hF'' : ∀ (n : ℕᵒᵖ) (x : (situationBlowUpU S).toScheme),
      letI : Module ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (TopCat.Presheaf.stalk (C := Ab.{u}) (F''.obj n).val.presheaf x) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
          (R := (situationBlowUpU S).toScheme.presheaf) (F''.obj n).val x
      (x ∈ blowupT S 2 → (1 : ℕ∞) ≤ Module.depth ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk x))
          (TopCat.Presheaf.stalk (C := Ab.{u}) (F''.obj n).val.presheaf x)) ∧
        (x ∈ blowupT S 1 → (2 : ℕ∞) ≤ Module.depth
          ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk x))
          (TopCat.Presheaf.stalk (C := Ab.{u}) (F''.obj n).val.presheaf x)))
    (V : (situationBlowUp S).affineOpens)
    (t : Γ(situationBlowUp S, (V : (situationBlowUp S).Opens)))
    (ht : t ∈ nonZeroDivisors _) (hV : (situationExceptionalIdeal S).ideal V = Ideal.span {t}) :
    ZeroEHHConditions ((H.obj ⋙ Scheme.Modules.pushforward (situationBlowUpU S).ι) ⋙
      affineSectionFunctor V) ((situationExceptionalIdeal S).ideal V) := by
  apply zeroEHHConditions_chart (hU := compl_situationBlowUpU_subset S)
  have : IsNoetherianRing Γ(situationBlowUp S, (V : (situationBlowUp S).Opens)) :=
    IsLocallyNoetherian.component_noetherian V
  rcases span_eq_top_or_cohomologicalDimension_eq_one t ht (Ideal.fg_of_isNoetherianRing _)
    with htop | hcd
  · exact zeroEHHConditions_of_ideal_eq_top _ _ (hV.trans htop)
  · set j := chartMap (situationExceptionalIdeal S) (situationBlowUpU S) V
      (compl_situationBlowUpU_subset S)
    have hcd' : Stacks.LocalCohomology.cohomologicalDimension (blowupChartSituation S V).A
        (blowupChartSituation S V).I (IsNoetherian.noetherian _) = 1 := by
      rw [← hcd]
      exact Stacks.LocalCohomology.cohomologicalDimension_congr _ _ hV
    have : ∀ n, ((F'' ⋙ Scheme.Modules.restrictFunctor j).obj n).IsCoherent := fun n =>
      isCoherent_restrict_of_isOpenImmersion j (F''.obj n)
    exact zeroEHHConditions_of_cd_one_of_proIso_depthThree (blowupChartSituation S V)
      (chartSystem (situationExceptionalIdeal S) (situationBlowUpU S) V
        (compl_situationBlowUpU_subset S) H) (hX V) hcd' (F'' ⋙ Scheme.Modules.restrictFunctor j)
      (proIsoComp e.symm (Scheme.Modules.restrictFunctor j))
      fun n => three_le_depth_add_chartDistance S V _ (hF'' (op n))

/-- **The extension of `(ℋₙ)` across the blowup.** Under the hypotheses of
`Stacks.Algebraization.zeroEHHConditions_blowupChart`, there is an object `(𝒢ₙ)` of
`Coh(X', I𝒪_{X'})` whose restriction to `U'` is isomorphic to `(ℋₙ)`: the canonical extensions
of [Stacks, Tag 0EIR] on finitely many charts are assembled from the direct images `j_*ℋₙ` by
`Stacks.Coherent.exists_coherentAdicSystem_restrict_iso_of_affineCover`. -/
theorem exists_blowup_extension (hX : LocallyHasDualizingComplex (situationBlowUp S))
    (H : Stacks.Coherent.CoherentAdicSystems (blowupIdealU S))
    (F'' : ℕᵒᵖ ⥤ (situationBlowUpU S).toScheme.Modules) [∀ n, (F''.obj n).IsCoherent]
    (e : InverseSequence.ProIso F'' H.obj)
    (hF'' : ∀ (n : ℕᵒᵖ) (x : (situationBlowUpU S).toScheme),
      letI : Module ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (TopCat.Presheaf.stalk (C := Ab.{u}) (F''.obj n).val.presheaf x) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
          (R := (situationBlowUpU S).toScheme.presheaf) (F''.obj n).val x
      (x ∈ blowupT S 2 → (1 : ℕ∞) ≤ Module.depth ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk x))
          (TopCat.Presheaf.stalk (C := Ab.{u}) (F''.obj n).val.presheaf x)) ∧
        (x ∈ blowupT S 1 → (2 : ℕ∞) ≤ Module.depth
          ((situationBlowUpU S).toScheme.presheaf.stalk x)
          (IsLocalRing.maximalIdeal ((situationBlowUpU S).toScheme.presheaf.stalk x))
          (TopCat.Presheaf.stalk (C := Ab.{u}) (F''.obj n).val.presheaf x))) :
    ∃ G : Stacks.Coherent.CoherentAdicSystems (situationExceptionalIdeal S),
      Nonempty (G.obj ⋙ Scheme.Modules.restrictFunctor (situationBlowUpU S).ι ≅ H.obj) := by
  obtain ⟨ι, hι, T, hT, ht⟩ := exists_blowup_chartCover S
  choose t ht hV using ht
  let P := H.obj ⋙ Scheme.Modules.pushforward (situationBlowUpU S).ι
  have : ∀ n, (P.obj n).IsQuasicoherent := fun n => by
    have : (H.obj.obj n).IsQuasicoherent := H.property.isQuasicoherent n.unop
    exact AlgebraicGeometry.pushforward_isQuasicoherent (situationBlowUpU S).ι _
  have hC := fun i => zeroEHHConditions_blowupChart S hX H F'' e hF'' (T i) (t i) (ht i) (hV i)
  obtain ⟨G, hG⟩ := Stacks.Coherent.exists_coherentAdicSystem_restrict_iso_of_affineCover
    (situationExceptionalIdeal S) P T hT (fun i => (hC i).1) (fun i => (hC i).2.1)
    (fun i => (hC i).2.2)
  exact ⟨G, hG (situationBlowUpU S).ι H.obj H.property
    (Functor.isoWhiskerLeft H.obj
      (Scheme.Modules.restrictFunctorAdjCounitIso (situationBlowUpU S).ι) ≪≫
      Functor.rightUnitor _)⟩

end Stacks.Algebraization

end
