/-! ### Quasi-regularity, indexed by `Fin d` -/

namespace Stacks.QuasiregularSequence

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {d : ℕ}

/-- The ideal generated by the list `List.ofFn v` is the span of the range of `v`. -/
theorem ofList_ofFn (v : Fin d → R) : Ideal.ofList (List.ofFn v) = Ideal.span (Set.range v) := by
  unfold Ideal.ofList
  congr 1
  ext x
  simp [List.mem_ofFn]

/-- The monomial `listPow (List.ofFn v) I` is `∏ i, v i ^ I i`, with `I` reindexed along
`List.length_ofFn`. -/
theorem listPow_ofFn (v : Fin d → R) (I : Fin (List.ofFn v).length → ℕ) :
    listPow (List.ofFn v) I = ∏ i : Fin d, v i ^ I (Fin.cast (List.length_ofFn ..).symm i) := by
  unfold listPow
  exact Fintype.prod_equiv (finCongr (List.length_ofFn ..)) _ _ fun i => by simp [Fin.cast]

/-- Sums over the multi-indices of a fixed total degree are unchanged by a reindexing of the
variables along an equality of lengths. -/
theorem sum_antidiagonalTuple_cast {a b : ℕ} (h : a = b) (n : ℕ) (φ : (Fin b → ℕ) → M) :
    ∑ I ∈ Finset.Nat.antidiagonalTuple a n, φ (fun i => I (Fin.cast h.symm i)) =
      ∑ e ∈ Finset.Nat.antidiagonalTuple b n, φ e := by
  subst h
  rfl

/-- Reindexing a multi-index of total degree `n` along an equality of lengths gives a
multi-index of total degree `n`. -/
theorem mem_antidiagonalTuple_cast {a b : ℕ} (h : a = b) (n : ℕ) (e : Fin b → ℕ)
    (he : e ∈ Finset.Nat.antidiagonalTuple b n) :
    (fun i => e (Fin.cast h i)) ∈ Finset.Nat.antidiagonalTuple a n := by
  subst h
  exact he

/-- **A regular sequence is quasi-regular (Stacks 00LN), indexed by `Fin d`.** If
`v₁, …, v_d` is an `M`-regular sequence with ideal `J`, a relation
`∑_{|e| = n} v^e m_e ∈ Jⁿ⁺¹ M` forces every `m_e` into `J M`. -/
theorem coeff_mem_of_isRegular_ofFn (v : Fin d → R)
    (hv : RingTheory.Sequence.IsRegular M (List.ofFn v)) (n : ℕ) (m : (Fin d → ℕ) → M)
    (hsum : ∑ e ∈ Finset.Nat.antidiagonalTuple d n, (∏ i, v i ^ e i) • m e ∈
      Ideal.span (Set.range v) ^ (n + 1) • (⊤ : Submodule R M))
    (e : Fin d → ℕ) (he : e ∈ Finset.Nat.antidiagonalTuple d n) :
    m e ∈ Ideal.span (Set.range v) • (⊤ : Submodule R M) := by
  have hlen : (List.ofFn v).length = d := List.length_ofFn ..
  have hq := isRegular_isQuasiregularSeq M (List.ofFn v) hv n
    (fun I => m fun i => I (Fin.cast hlen.symm i))
  simp only [listPow_ofFn, ofList_ofFn] at hq
  have h := hq (by
    rw [sum_antidiagonalTuple_cast hlen n (fun e => (∏ i, v i ^ e i) • m e)]
    exact hsum) _ (mem_antidiagonalTuple_cast hlen n e he)
  simpa [Fin.cast] using h

/-- **The monomial description of `Jⁿ M`, indexed by `Fin d`.** Every element of `Jⁿ M`, for
`J = (v₁, …, v_d)`, is `∑_{|e| = n} v^e m_e`. -/
theorem exists_eq_sum_monomial_smul (v : Fin d → R) (n : ℕ) (x : M)
    (hx : x ∈ Ideal.span (Set.range v) ^ n • (⊤ : Submodule R M)) :
    ∃ m : (Fin d → ℕ) → M,
      x = ∑ e ∈ Finset.Nat.antidiagonalTuple d n, (∏ i, v i ^ e i) • m e := by
  have hlen : (List.ofFn v).length = d := List.length_ofFn ..
  rw [← ofList_ofFn] at hx
  obtain ⟨w, hw⟩ := exists_listPow_repr (List.ofFn v) M n x hx
  refine ⟨fun e => w fun i => e (Fin.cast hlen i), ?_⟩
  rw [hw, ← sum_antidiagonalTuple_cast hlen n]
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [listPow_ofFn]
  congr 2

/-- A monomial of total degree `n` in `v₁, …, v_d` lies in `(v₁, …, v_d)ⁿ`. -/
theorem prod_pow_mem_span_pow (v : Fin d → R) (n : ℕ) (e : Fin d → ℕ)
    (he : e ∈ Finset.Nat.antidiagonalTuple d n) :
    ∏ i, v i ^ e i ∈ Ideal.span (Set.range v) ^ n := by
  rw [Finset.Nat.mem_antidiagonalTuple] at he
  have h1 : (∏ i, v i ^ e i) ∈ ∏ i, Ideal.span (Set.range v) ^ e i :=
    Ideal.prod_mem_prod fun i _ => Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _
  rwa [Finset.prod_pow_eq_pow_sum, he] at h1

end Stacks.QuasiregularSequence

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

namespace Stacks.Algebraization

attribute [local instance] hasFiniteBiproducts_schemeModules

variable (S : AlgebraizationSituation.{u})
  (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))

/-! ### Bijectivity of the stalk maps from the formal stalks -/

/-- **The stalk maps of `Stacks.Algebraization.idealPowerDesc` are bijective** when, on the formal
stalk `F_y^∧` at every point `y` of `U ∩ Y`, the components `aᵢ ∈ A` of the morphism satisfy

* `hinj`: if `∑ aᵢ zᵢ ∈ I_y^(n+2) F_y^∧` then every `zᵢ ∈ I_y F_y^∧`, and
* `hsurj`: every element of `I_y^(n+1) F_y^∧` is some `∑ aᵢ zᵢ` modulo `I_y^(n+2) F_y^∧`.

Both statements are transported to the stalk of `F_(n+1)` along the surjection
`F_y^∧ → F_(n+1,y)` of `Stacks.Algebraization.completedStalkQuotientEquivStalk`; off `U ∩ Y` both
sides of the morphism have vanishing stalks. -/
theorem bijective_stalk_idealPowerDesc_of_completedStalk (n : ℕ) {k : ℕ}
    [(F.obj.obj (op (n + 1))).IsQuasicoherent] (a : Fin k → S.A)
    (hb : ∀ i, RestrictMemIdealPow (idealOnOpen S) (n + 1) (scalarMap S (a i)))
    (hbot : idealPowerMultiple (idealOnOpen S) (n + 1 + 1) (F.obj.obj (op (n + 1))) = ⊥)
    (e : idealPowerQuotient (idealOnOpen S) 1 (F.obj.obj (op (n + 1))) ≅ F.obj.obj (op 0))
    (he : cokernel.π (C := S.U.toScheme.Modules)
        (idealPowerMultiple (idealOnOpen S) 1 (F.obj.obj (op (n + 1)))).ι ≫ e.hom =
      F.obj.map (homOfLE (Nat.zero_le (n + 1))).op)
    (y : S.U.toScheme)
    (hinj : y ∈ (idealOnOpen S).support → ∀ z : Fin k → completedStalk (idealOnOpen S) F y,
      ∑ i, germOfBase S y (a i) • z i ∈ IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1 + 1) •
          (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
            (completedStalk (idealOnOpen S) F y)) →
        ∀ i, z i ∈ IdealSheafData.stalk (idealOnOpen S) y •
          (⊤ : Submodule (S.U.toScheme.presheaf.stalk y) (completedStalk (idealOnOpen S) F y)))
    (hsurj : y ∈ (idealOnOpen S).support → ∀ u : completedStalk (idealOnOpen S) F y,
      u ∈ IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1) •
          (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
            (completedStalk (idealOnOpen S) F y)) →
        ∃ z : Fin k → completedStalk (idealOnOpen S) F y,
          u - ∑ i, germOfBase S y (a i) • z i ∈
            IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1 + 1) •
              (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
                (completedStalk (idealOnOpen S) F y))) :
    Function.Bijective ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
      (idealPowerDesc (F.obj.obj (op (n + 1))) (n + 1) hbot hb e)).hom := by
  classical
  have : IsLocallyNoetherian S.U.toScheme := isLocallyNoetherian_of_isOpenImmersion S.U.ι
  have hmonoι : Mono (C := S.U.toScheme.Modules) (idealPowerSub S F n).ι :=
    (idealPowerShortComplex_shortExact S F n).mono_f
  have hiyinj : Function.Injective
      ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
        (idealPowerSub S F n).ι).hom :=
    (ModuleCat.mono_iff_injective _).mp (Functor.map_mono _ _)
  have hiyrange : LinearMap.range ((modulesStalkFunctor S.U.toScheme y).map
        (C := S.U.toScheme.Modules) (idealPowerSub S F n).ι).hom =
      IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1) •
        (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
          ((modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (n + 1))))) :=
    stalk_idealPowerMultiple (idealOnOpen S) (n + 1) (F.obj.obj (op (n + 1))) y
  by_cases hy : y ∈ (idealOnOpen S).support
  · obtain ⟨πL, hπL⟩ : ∃ f : completedStalk (idealOnOpen S) F y →ₗ[S.U.toScheme.presheaf.stalk y]
        ((modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (n + 1)))),
        ∀ z, f z = completedStalkQuotientEquivStalk F y (n + 1) (Submodule.Quotient.mk z) :=
      ⟨(completedStalkQuotientEquivStalk F y (n + 1)).toLinearMap ∘ₗ
          LinearMap.restrictScalars (S.U.toScheme.presheaf.stalk y)
            (Submodule.mkQ (completedLocalIdeal (idealOnOpen S) y ^ (n + 1 + 1) •
              (⊤ : Submodule (completedLocalRing (idealOnOpen S) y)
                (completedStalk (idealOnOpen S) F y)))),
        fun _ => rfl⟩
    have hπsurj : Function.Surjective πL := by
      intro m
      obtain ⟨q, hq⟩ := (completedStalkQuotientEquivStalk F y (n + 1)).surjective m
      obtain ⟨z, hz⟩ := Submodule.Quotient.mk_surjective _ q
      exact ⟨z, by rw [hπL, hz, hq]⟩
    have hπker : ∀ z, πL z = 0 ↔ z ∈ IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1 + 1) •
        (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
          (completedStalk (idealOnOpen S) F y)) := by
      intro z
      rw [hπL, LinearEquiv.map_eq_zero_iff, Submodule.Quotient.mk_eq_zero,
        ← restrictScalars_completedLocalIdeal_pow_smul_top (idealOnOpen S) y
          (completedStalk (idealOnOpen S) F y) (n + 1 + 1), Submodule.restrictScalars_mem]
    have hπcomb : ∀ z : Fin k → completedStalk (idealOnOpen S) F y,
        πL (∑ i, germOfBase S y (a i) • z i) =
          ∑ i, germOfBase S y (a i) • πL (z i) := by
      intro z
      rw [map_sum]
      exact Finset.sum_congr rfl fun i _ => map_smul _ _ _
    have hπmap : ∀ I : Ideal (S.U.toScheme.presheaf.stalk y),
        (I • (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
            (completedStalk (idealOnOpen S) F y))).map πL =
          I • (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
            ((modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (n + 1))))) := fun I => by
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.2 hπsurj]
    refine ⟨LinearMap.ker_eq_bot.1 (LinearMap.ker_eq_bot'.2 ?_), ?_⟩
    · intro u hu
      choose w hw using fun i : Fin k =>
        surjective_stalk_transition F y (Nat.zero_le (n + 1))
          (((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
            (biproduct.π (fun _ : Fin k => F.obj.obj (op 0)) i)).hom u)
      choose z hz using fun i : Fin k => hπsurj (w i)
      have hmf := stalk_idealPowerDesc_apply (F.obj.obj (op (n + 1))) (n + 1) hbot hb e he y w
      rw [show (fun i => ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
            (F.obj.map (homOfLE (Nat.zero_le (n + 1))).op)).hom (w i)) =
          (fun i => ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
            (biproduct.π (fun _ : Fin k => F.obj.obj (op 0)) i)).hom u) from funext hw,
        stalkOfTuple_stalk_π, hu, map_zero] at hmf
      have hzero : πL (∑ i, germOfBase S y (a i) • z i) = 0 := by
        rw [hπcomb, show (∑ i, germOfBase S y (a i) • πL (z i)) =
            ∑ i, (S.U.toScheme.presheaf.germ ⊤ y trivial).hom (scalarMap S (a i)) • w i from
          Finset.sum_congr rfl fun i _ => by rw [hz i]; rfl]
        exact hmf.symm
      have hzmem := hinj hy z ((hπker _).1 hzero)
      have hzerou : ∀ i, ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
          (biproduct.π (fun _ : Fin k => F.obj.obj (op 0)) i)).hom u = 0 := by
        intro i
        rw [← hw i]
        refine (LinearMap.mem_ker (f := ((modulesStalkFunctor S.U.toScheme y).map
          (C := S.U.toScheme.Modules)
          (F.obj.map (homOfLE (Nat.zero_le (n + 1))).op)).hom)).1 ?_
        rw [ker_stalk_transition_zero F y (n + 1), ← hz i]
        exact hπmap _ ▸ Submodule.mem_map_of_mem (hzmem i)
      rw [← stalkOfTuple_stalk_π y (F.obj.obj (op 0)) u, stalkOfTuple]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [hzerou i, map_zero]
    · intro ξ
      have hξ : ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
          (idealPowerSub S F n).ι).hom ξ ∈
          IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1) •
            (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
              ((modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (n + 1))))) := by
        rw [← hiyrange]
        exact ⟨ξ, rfl⟩
      obtain ⟨uu, huumem, huu⟩ := Submodule.mem_map.1 (hπmap _ ▸ hξ)
      obtain ⟨z, hzsub⟩ := hsurj hy uu huumem
      have hsub0 : πL (uu - ∑ i, germOfBase S y (a i) • z i) = 0 := (hπker _).2 hzsub
      have hπusum : πL uu = ∑ i, germOfBase S y (a i) • πL (z i) := by
        rw [← hπcomb]
        rw [map_sub] at hsub0
        exact sub_eq_zero.1 hsub0
      refine ⟨stalkOfTuple y (F.obj.obj (op 0))
        (fun i => ((modulesStalkFunctor S.U.toScheme y).map (C := S.U.toScheme.Modules)
          (F.obj.map (homOfLE (Nat.zero_le (n + 1))).op)).hom (πL (z i))), ?_⟩
      refine hiyinj ?_
      rw [stalk_idealPowerDesc_apply (F.obj.obj (op (n + 1))) (n + 1) hbot hb e he y
        (fun i => πL (z i))]
      refine Eq.trans ?_ huu
      rw [hπusum]
      rfl
  · have hzeroM : ∀ wm : (modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op (n + 1))),
        wm = 0 := fun wm => eq_zero_stalk_of_notMem_support F hy (n + 1) wm
    have hzero0 : ∀ v : (modulesStalkFunctor S.U.toScheme y).obj (F.obj.obj (op 0)), v = 0 :=
      fun v => eq_zero_stalk_of_notMem_support F hy 0 v
    have hzeroSub : ∀ ξ : (modulesStalkFunctor S.U.toScheme y).obj
        ((idealPowerSub S F n).toSheafOfModules), ξ = 0 := by
      intro ξ
      refine hiyinj ?_
      rw [map_zero]
      exact hzeroM _
    refine ⟨fun u₁ u₂ _ => ?_, fun ξ => ⟨0, ?_⟩⟩
    · rw [← stalkOfTuple_stalk_π y (F.obj.obj (op 0)) u₁,
        ← stalkOfTuple_stalk_π y (F.obj.obj (op 0)) u₂]
      exact congrArg (stalkOfTuple y (F.obj.obj (op 0)))
        (funext fun i => (hzero0 _).trans (hzero0 _).symm)
    · rw [map_zero, hzeroSub ξ]

/-! ### The decomposition along a regular sequence -/

/-- The germ of a monomial `∏ i, f i ^ e i` is the corresponding monomial in the germs of the
`f i`. -/
theorem germOfBase_prod_pow {d : ℕ} (y : S.U.toScheme) (f : Fin d → S.A) (e : Fin d → ℕ) :
    germOfBase S y (∏ i, f i ^ e i) = ∏ i, germOfBase S y (f i) ^ e i := by
  simp only [germOfBase, map_prod, map_pow]

/-- **The direct-sum decomposition of `Iⁿ⁺¹ F_(n+2)` along a regular sequence (the decomposition
of the proof of Stacks 0EJS).** Under hypothesis (1) of Stacks 0EJS, for any identification `e`
of `F_(n+2)/I F_(n+2)` with `F_1` compatible with the transition,
`Stacks.Algebraization.idealPowerDesc` for the monomials `f^m`, `|m| = n + 1`, is an isomorphism
`⨁_{|m| = n+1} F_1 ≅ Iⁿ⁺¹ F_(n+2)`.

At a point `y ∈ U ∩ Y` the stalk ideal `I_y` is `(f₁, …, f_d)`, so its powers are spanned by
monomials, and the `fᵢ` are quasi-regular on `F_y^∧` because they are regular on it. -/
theorem exists_isIso_idealPowerDesc_of_regularSequence {d : ℕ} (f : Fin d → S.A)
    (hf : ∀ i, f i ∈ S.I)
    (hreg : ∀ y ∈ (idealOnOpen S).support,
      AlgebraicGeometry.IdealSheafData.stalk (idealOnOpen S) y =
          Ideal.span (Set.range fun i => germOfBase S y (f i)) ∧
        RingTheory.Sequence.IsRegular (completedStalk (idealOnOpen S) F y)
          (List.ofFn fun i => germOfBase S y (f i)))
    (n : ℕ)
    (e : idealPowerQuotient (idealOnOpen S) 1 (F.obj.obj (op (n + 1))) ≅ F.obj.obj (op 0))
    (he : cokernel.π (C := S.U.toScheme.Modules)
        (idealPowerMultiple (idealOnOpen S) 1 (F.obj.obj (op (n + 1)))).ι ≫ e.hom =
      F.obj.map (homOfLE (Nat.zero_le (n + 1))).op) :
    ∃ (k : ℕ) (a : Fin k → S.A) (_ : ∀ i, a i ∈ Ideal.span (Set.range f) ^ (n + 1))
      (hb : ∀ i, RestrictMemIdealPow (idealOnOpen S) (n + 1) (scalarMap S (a i))),
      haveI := F.property.isQuasicoherent (n + 1)
      IsIso (idealPowerDesc (F.obj.obj (op (n + 1))) (n + 1)
        (F.property.idealPowerMultiple_eq_bot (n + 1)) hb e) := by
  classical
  have hqc : (F.obj.obj (op (n + 1))).IsQuasicoherent := F.property.isQuasicoherent (n + 1)
  set T := Finset.Nat.antidiagonalTuple d (n + 1) with hT
  let σ : Fin T.card ≃ T := T.equivFin.symm
  let a : Fin T.card → S.A := fun i => ∏ j, f j ^ (σ i : Fin d → ℕ) j
  have ha : ∀ i, a i ∈ Ideal.span (Set.range f) ^ (n + 1) := fun i =>
    Stacks.QuasiregularSequence.prod_pow_mem_span_pow f (n + 1) _ (σ i).2
  have hb : ∀ i, RestrictMemIdealPow (idealOnOpen S) (n + 1) (scalarMap S (a i)) := fun i =>
    restrictMemIdealPow_scalarMap_of_mem_span_pow S f hf (ha i)
  refine ⟨T.card, a, ha, hb, ?_⟩
  refine AlgebraicGeometry.isIso_of_forall_modulesStalk _ fun y => ?_
  rw [ConcreteCategory.isIso_iff_bijective]
  -- Sums over `Fin T.card` are sums over the monomials of degree `n + 1`.
  have hreindex : ∀ {N : Type u} [AddCommGroup N] (φ : (Fin d → ℕ) → N),
      ∑ i, φ (σ i) = ∑ m ∈ T, φ m := fun φ => by
    rw [← Finset.sum_coe_sort T]
    exact Equiv.sum_comp σ (fun m : T => φ m)
  refine bijective_stalk_idealPowerDesc_of_completedStalk S F n a hb _ e he y ?_ ?_
  · intro hy z hz i
    obtain ⟨hJ, hregy⟩ := hreg y hy
    let mz : (Fin d → ℕ) → completedStalk (idealOnOpen S) F y :=
      fun m => if h : m ∈ T then z (σ.symm ⟨m, h⟩) else 0
    have hmz : ∀ i, mz (σ i) = z i := fun i => by
      simp only [mz, dite_eq_left (σ i).2, Subtype.coe_eta, Equiv.symm_apply_apply]
    have hsum : ∑ m ∈ T, (∏ j, germOfBase S y (f j) ^ m j) • mz m ∈
        Ideal.span (Set.range fun j => germOfBase S y (f j)) ^ (n + 1 + 1) •
          (⊤ : Submodule (S.U.toScheme.presheaf.stalk y)
            (completedStalk (idealOnOpen S) F y)) := by
      rw [← hreindex (fun m => (∏ j, germOfBase S y (f j) ^ m j) • mz m), ← hJ]
      simpa only [hmz, a, germOfBase_prod_pow] using hz
    have h := Stacks.QuasiregularSequence.coeff_mem_of_isRegular_ofFn _ hregy (n + 1) mz hsum
      (σ i) (σ i).2
    rwa [hmz, ← hJ] at h
  · intro hy u hu
    obtain ⟨hJ, -⟩ := hreg y hy
    have hpow : IdealSheafData.stalk (idealOnOpen S) y ^ (n + 1) =
        Ideal.span (Set.range fun j => germOfBase S y (f j)) ^ (n + 1) := by rw [hJ]
    rw [hpow] at hu
    obtain ⟨m, hm⟩ := Stacks.QuasiregularSequence.exists_eq_sum_monomial_smul _ (n + 1) u hu
    refine ⟨fun i => m (σ i), ?_⟩
    have : u - ∑ i, germOfBase S y (a i) • m (σ i) = 0 := by
      rw [hm, ← hreindex (fun m' => (∏ j, germOfBase S y (f j) ^ m' j) • m m'), sub_eq_zero]
      simp only [a, germOfBase_prod_pow]
    rw [this]
    exact Submodule.zero_mem _

/-! ### Stacks 0EJS -/

/-- **Stacks Project, Tag 0EJS.** In Situation 0EHC let `(F_n)` be an object of
`Coh(U, I 𝒪_U)`. Assume that

1. there exist `f₁, …, f_d ∈ I` such that for `y ∈ U ∩ Y` the ideal `I 𝒪_{X,y}` is generated by
   `f₁, …, f_d` and `f₁, …, f_d` form an `F_y^∧`-regular sequence
   (`Stacks.Algebraization.HasRegularSequenceOnCompletedStalks`),
2. `H⁰(U, F_1)` and `H¹(U, F_1)` are finite `A`-modules
   (`Stacks.Algebraization.HasFiniteLowDegreeCohomology`).

Then `(F_n)` extends canonically to `X`.

The proof is the source's: the decomposition
`Stacks.Algebraization.exists_isIso_idealPowerDesc_of_regularSequence` of `Iⁿ F_(n+1)` into copies
of `F_1` indexed by the monomials in the `fᵢ`, fed to
`Stacks.Algebraization.canonicallyExtends_of_idealPowerDesc`, which verifies conditions (a), (b),
(c) of Stacks 0EHH. -/
@[stacks 0EJS "first sentence: if f₁, …, f_d ∈ I generate I𝒪_{X,y} and form an F_y^∧-regular \
sequence for every y ∈ U ∩ Y, and H⁰(U, F_1), H¹(U, F_1) are finite A-modules, then (F_n) \
extends canonically to X"]
theorem canonicallyExtends_of_regularSequence (hreg : HasRegularSequenceOnCompletedStalks S F)
    (h2 : HasFiniteLowDegreeCohomology S F) : CanonicallyExtends S F := by
  obtain ⟨d, f, hf, hreg⟩ := hreg
  exact canonicallyExtends_of_idealPowerDesc S F f hf
    (exists_isIso_idealPowerDesc_of_regularSequence S F f hf hreg) h2

/-- **Stacks Project, Tag 0EJS, the second sentence.** Under the hypotheses of Stacks 0EJS, if
`A` is moreover `I`-adically complete, then `(F_n)` is the completion of a coherent
`𝒪_U`-module. -/
@[stacks 0EJS "second sentence: under assumptions (1) and (2), if A is moreover I-adically \
complete, then (F_n) is the completion of a coherent 𝒪_U-module"]
theorem essImage_completionFunctor_of_regularSequence [IsAdicComplete S.I S.A]
    (hreg : HasRegularSequenceOnCompletedStalks S F) (h2 : HasFiniteLowDegreeCohomology S F) :
    (completionFunctor S.U.toScheme (idealOnOpen S)).essImage F := by
  obtain ⟨d, f, hf, hreg⟩ := hreg
  exact essImage_completionFunctor_of_idealPowerDesc S F f hf
    (exists_isIso_idealPowerDesc_of_regularSequence S F f hf hreg) h2

