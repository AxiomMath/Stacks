module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AlgebraizationCoherentFormal.BlowupAlgebraizationGlue
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AlgebraizationCoherentFormal.ImprovingFormalModulesDepthTwoCarrier
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.ImprovingCoherentModules.ClosedSubsetExistence

/-!
# The algebraization on the blowup, in the proof of Stacks 0EJK

In Situation [Stacks, Tag 0EHC] let `b : X' ⟶ X` be the blowup in `I`, `U' = b⁻¹(U)` and let
`(ℱₙ)` be an object of `Coh(U, I𝒪_U)`. Granted conditions (b), (c), (d) of
[Stacks, Tag 0EJF] for the pullback `(b|_{U'}^*ℱₙ)` with `d = 1` and the subsets
`T' = {δ^{Y'}_{Z'} ≤ 1} ⊆ T = {δ^{Y'}_{Z'} ≤ 2}` of `U'`, this file carries out the part of the
proof of [Stacks, Tag 0EJK] that follows "This finishes the proof of our claim": condition (a)
holds because `I𝒪_{X'}` is locally principal, condition (e) is [Stacks, Tag 0EIY] part (7) on the
exceptional divisor, [Stacks, Tag 0EJF] produces `(b|_{U'}^*ℱₙ) ⟶ (ℋₙ)` with kernel and cokernel
killed by a power of `I`, and the canonical extensions of [Stacks, Tag 0EJI] on the charts give
an object `(𝒢ₙ)` of `Coh(X', I𝒪_{X'})` restricting to `(ℋₙ)`
(`Stacks.Algebraization.exists_blowup_extension_of_pullback`).

Conditions (b), (c), (d) themselves are the depth comparison (0EJL)/(0EJM) of the source and are
established separately.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Algebraization

variable (S : AlgebraizationSituation.{u})

/-- **`I𝒪_{U'}` is locally principal.** Every point of `U'` has an affine open neighbourhood on
which `I𝒪_{U'}` is generated by one element. -/
theorem exists_affineOpen_blowupIdealU_eq_span_singleton (x : (situationBlowUpU S).toScheme) :
    ∃ W : (situationBlowUpU S).toScheme.affineOpens, x ∈ W.1 ∧
      ∃ s, (blowupIdealU S).ideal W = Ideal.span {s} := by
  obtain ⟨ι, -, T, hT, ht⟩ := exists_blowup_chartCover S
  have hxT : (situationBlowUpU S).ι x ∈ (⨆ i, (T i : (situationBlowUp S).Opens)) := by
    rw [hT]; trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hxT
  obtain ⟨t, -, hti⟩ := ht i
  obtain ⟨-, ⟨W, hW, rfl⟩, hxW, hWsub⟩ :=
    (situationBlowUpU S).toScheme.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ ((situationBlowUpU S).ι ⁻¹ᵁ (T i : (situationBlowUp S).Opens) : Set _) from hi)
      ((situationBlowUpU S).ι ⁻¹ᵁ (T i : (situationBlowUp S).Opens)).isOpen
  refine ⟨⟨W, hW⟩, hxW, ?_⟩
  let : IsNoetherianRing Γ((situationBlowUpU S).toScheme, W) :=
    IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  have hle : (⟨(situationBlowUpU S).ι ''ᵁ W, hW.image_of_isOpenImmersion _⟩ :
      (situationBlowUp S).affineOpens) ≤ T i := by
    show SetLike.coe ((situationBlowUpU S).ι ''ᵁ W) ⊆
      SetLike.coe (T i : (situationBlowUp S).Opens)
    rintro _ ⟨w, hw, rfl⟩
    exact hWsub hw
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    ← Scheme.IdealSheafData.map_ideal _ hle, hti, Ideal.map_span, Set.image_singleton]
  have hsymm : ∀ K : Ideal Γ(situationBlowUp S, (situationBlowUpU S).ι ''ᵁ W),
      K.comap ((situationBlowUpU S).ι.appIso W).inv.hom =
        K.map ((situationBlowUpU S).ι.appIso W).hom.hom := fun K =>
    Ideal.comap_symm (I := K) ((situationBlowUpU S).ι.appIso W).commRingCatIsoToRingEquiv
  rw [hsymm, Ideal.map_span, Set.image_singleton]
  exact ⟨_, rfl⟩

/-- **Condition (a) of [Stacks, Tag 0EJF] on `U'` with `d = 1`.** Every point of `U'` has an
affine open neighbourhood on which `I𝒪_{U'}` is principal, hence of cohomological dimension at
most one. -/
theorem exists_affineOpen_cohomologicalDimension_blowupIdealU_le_one
    (x : (situationBlowUpU S).toScheme) :
    ∃ W : (situationBlowUpU S).toScheme.affineOpens, x ∈ W.1 ∧
      letI : IsNoetherianRing Γ((situationBlowUpU S).toScheme, W.1) :=
        IsLocallyNoetherian.component_noetherian W
      Stacks.LocalCohomology.cohomologicalDimension Γ((situationBlowUpU S).toScheme, W.1)
        ((blowupIdealU S).ideal W) (Ideal.fg_of_isNoetherianRing _) ≤ ((1 : ℕ) : ℤ) := by
  obtain ⟨W, hxW, s, hs⟩ := exists_affineOpen_blowupIdealU_eq_span_singleton S x
  refine ⟨W, hxW, ?_⟩
  let : IsNoetherianRing Γ((situationBlowUpU S).toScheme, W.1) :=
    IsLocallyNoetherian.component_noetherian W
  rw [Stacks.LocalCohomology.cohomologicalDimension_congr _ (Ideal.fg_of_isNoetherianRing _) hs]
  exact Stacks.LocalCohomology.cohomologicalDimension_le_card_generators _ _ _ (n := 1) ![s]
    (by simp)

/-- **The algebraization on the blowup, granted the depth conditions.** Let `A` have a dualizing
complex and let `(ℱₙ)` be an object of `Coh(U, I𝒪_U)` whose pullback `(b|_{U'}^*ℱₙ)` satisfies
conditions (b), (c), (d) of [Stacks, Tag 0EJF] with `d = 1` and `T' = {δ ≤ 1} ⊆ T = {δ ≤ 2}`.
Then there are an object `(𝒢ₙ)` of `Coh(X', I𝒪_{X'})` and a morphism
`(b|_{U'}^*ℱₙ) ⟶ (𝒢ₙ|_{U'})` whose levelwise kernels and cokernels are killed by a power of `I`. -/
theorem exists_blowup_extension_of_pullback
    (hdual : ∃ K : @DerivedCategory (ModuleCat.{u} S.A) _ _
      (HasDerivedCategory.standard (ModuleCat.{u} S.A)),
      @Dualizing.IsDualizingComplex S.A _ _ (HasDerivedCategory.standard (ModuleCat.{u} S.A)) K)
    (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))
    (hb : ∀ y ∈ blowupT S 2, ∀ p : PrimeSpectrum (completedLocalRing (blowupIdealU S) y),
      p.asIdeal ≠ completedMaximalIdeal (blowupIdealU S) y →
      adicClosedFibreThrough (blowupIdealU S) y p = {completedMaximalIdeal (blowupIdealU S) y} →
      0 < completedStalkDepth (blowupIdealU S) (blowupPullbackSystem S F) y p)
    (hc : ∀ y ∈ blowupT S 1, ∀ p : PrimeSpectrum (completedLocalRing (blowupIdealU S) y),
      ¬ completedLocalIdeal (blowupIdealU S) y ≤ p.asIdeal →
      adicClosedFibreThrough (blowupIdealU S) y p ≠ {completedMaximalIdeal (blowupIdealU S) y} →
      1 ≤ completedStalkDepth (blowupIdealU S) (blowupPullbackSystem S F) y p ∨
        enatToEInt (completedStalkDepth (blowupIdealU S) (blowupPullbackSystem S F) y p) +
            krullDimToEInt (ringKrullDim (completedLocalRing (blowupIdealU S) y ⧸ p.asIdeal)) >
          ((1 + ((1 : ℕ) : ℤ) : ℤ) : EInt))
    (hd : ∀ y ∈ blowupT S 1, ∀ p : PrimeSpectrum (completedLocalRing (blowupIdealU S) y),
      p.asIdeal ≠ completedMaximalIdeal (blowupIdealU S) y →
      adicClosedFibreThrough (blowupIdealU S) y p = {completedMaximalIdeal (blowupIdealU S) y} →
      1 < completedStalkDepth (blowupIdealU S) (blowupPullbackSystem S F) y p) :
    ∃ (G : Stacks.Coherent.CoherentAdicSystems (situationExceptionalIdeal S))
      (σ : (blowupPullbackSystem S F).obj ⟶
        G.obj ⋙ Scheme.Modules.restrictFunctor (situationBlowUpU S).ι),
      IsKernelCokernelAnnihilatedByPower (blowupIdealU S) σ := by
  obtain ⟨K, hK⟩ := hdual
  let := HasDerivedCategory.standard (ModuleCat.{u} S.A)
  have hX : LocallyHasDualizingComplex (situationBlowUp S) :=
    locallyHasDualizingComplex_of_locallyOfFiniteType (situationBlowUpToBase S) K hK
  have hU' : HasDualizingComplexOnAffineCover (situationBlowUpU S).toScheme :=
    hasDualizingComplexOnAffineCover_of_locallyHasDualizingComplex _
      (locallyHasDualizingComplex_of_locallyOfFiniteType
        ((situationBlowUpU S).ι ≫ situationBlowUpToBase S) K hK)
  have hcatX : Scheme.IsUniversallyCatenary S.X :=
    isUniversallyCatenary_of_locallyHasDualizingComplex _
      (locallyHasDualizingComplex_of_locallyOfFiniteType (𝟙 S.X) K hK)
  have hcatE : IrreducibleClosedsCodim.IsCatenarySpace (situationExceptional S) :=
    hcatX.isCatenarySpace (situationExceptionalι S ≫ situationBlowUpToBase S)
  have himm := mem_blowupT_two_of_isImmediateSpecialization S hcatE
  obtain ⟨hdep, -, H, e, σ, -, -, -, hσ⟩ := exists_proIso_coherentAdicSystem_canonicalImprovedSystem
    hU' (blowupPullbackSystem S F) (stableUnderSpecialization_blowupT S 2)
    (stableUnderSpecialization_blowupT S 1) (blowupT_subset_support S 2)
    (blowupT_mono S (by norm_num)) 1
    (exists_affineOpen_cohomologicalDimension_blowupIdealU_le_one S)
    hb hc hd himm
  have := isCoherent_canonicalImprovedSystem_obj hU' (blowupPullbackSystem S F)
    (stableUnderSpecialization_blowupT S 2) (stableUnderSpecialization_blowupT S 1)
    (blowupT_subset_support S 2) himm
  obtain ⟨G, ⟨i⟩⟩ := exists_blowup_extension S hX H _ e hdep
  exact ⟨G, σ.hom ≫ i.inv,
    (Stacks.Coherent.isKernelCokernelAnnihilatedByPower_comp_iso_iff _ _ i.symm).2 hσ⟩

end Stacks.Algebraization

end
