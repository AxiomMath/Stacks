/-!
# The limit topology on `limₙ H⁰(U, ℱₙ)` in cohomological dimension one

Fix an algebraization situation: a Noetherian ring `A` with ideals `I ⊆ 𝔞`, `X = Spec(A)` and
the open complement `U = X ∖ V(𝔞)`.  For an object `(ℱₙ)` of `Coh(U, I𝒪_U)` the `A`-module
`M = limₙ H⁰(U, ℱₙ)` of [Stacks, Tag 0EHD] carries two topologies: the limit topology, induced
from the discrete modules `H⁰(U, ℱₙ)`, and its `I`-adic topology.  When `cd(A, I) = 1` they
agree.  This is the case `p = 0` of [Stacks, Tag 0EH7] for the scheme `U`, and it is
condition (b) of [Stacks, Tag 0EHH] as the proof of [Stacks, Tag 0EJI] uses it.

## Main results

* `Stacks.AdicLimit.exists_pow_smul_top_le_ker_of_iInf_induced_eq` and
  `Stacks.AdicLimit.exists_ker_le_pow_smul_top_of_iInf_induced_eq` — the converse of
  `Stacks.AdicLimit.iInf_induced_eq_adicModuleTopology`: if the topology induced from a family
  of maps to discrete modules is `I`-adic, then the kernels and the powers of `I` interleave.
* `Stacks.AdicLimit.iInf_induced_eq_adicModuleTopology_of_semilinear` — transport of that
  equality of topologies along an additive bijection which is semilinear over a ring map
  `φ : A → R`, from the ideal `I · R` to the ideal `I`.
* `Stacks.Algebraization.limitGlobalSections_topology_eq_adicModuleTopology` — the limit
  topology on `limₙ H⁰(U, ℱₙ)` is its `I`-adic topology when `cd(A, I) = 1`.

## Implementation notes

[Stacks, Tag 0EH7] is available as
`Stacks.Algebraization.AdicInverseSystem.limitIntCohomologyTopology_eq_adicModuleTopology`, for
an `Stacks.Algebraization.AdicInverseSystem` on a Noetherian scheme over `Spec A`, with
cohomology the right derived functor of global sections taken in `Γ(U, 𝒪_U)`-modules and the
`I`-adic topology that of the ideal of `Γ(U, 𝒪_U)` generated by the image of `I`.  Three
translations bring it to the module `Stacks.Algebraization.limitGlobalSections`, which is a limit
of `A`-modules:

* the object `(ℱₙ)` of `Coh(U, I𝒪_U)` is an adic inverse system on `U` along
  `Stacks.Cohomology.FormalFunctions.baseIdealSheaf A I (U ⟶ X)`, which is
  `Stacks.Algebraization.idealOnOpen` by
  `Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_comap`;
* in degree `0` the derived functor is global sections itself,
  `Stacks.RightDerivedPlus.rightDerivedPlusZeroIso`, global sections being left exact;
* the limit of the restriction of scalars along `A → Γ(U, 𝒪_U)` is the restriction of scalars of
  the limit, restriction of scalars preserving limits.

The last two give an additive bijection between the two limits which is semilinear over
`A → Γ(U, 𝒪_U)` and matches the kernels of the projections, and the transport lemma above turns
the equality of topologies for `I · Γ(U, 𝒪_U)` into the one for `I`.

## References

* [Stacks Project, Tag 0EH7](https://stacks.math.columbia.edu/tag/0EH7)
* [Stacks Project, Tag 0EHD](https://stacks.math.columbia.edu/tag/0EHD)
* [Stacks Project, Tag 0EHH](https://stacks.math.columbia.edu/tag/0EHH)
* [Stacks Project, Tag 0EJI](https://stacks.math.columbia.edu/tag/0EJI)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Stacks.AdicLimit

section Converse

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] (I : Ideal R)

/-- The powers `Iᵏ M` form a basis of neighbourhoods of `0` for the `I`-adic topology on `M`. -/
theorem adicModuleTopology_nhds_zero_hasBasis :
    (@nhds M (I.adicModuleTopology M) 0).HasBasis (fun _ : ℕ => True)
      (fun k => ((I ^ k • (⊤ : Submodule R M) : Submodule R M) : Set M)) := by
  let : TopologicalSpace R := I.adicTopology
  refine ⟨fun V => ?_⟩
  show V ∈ @nhds M ((I.ringFilterBasis.moduleFilterBasis (I.adic_module_basis M)).topology) 0 ↔
    _
  rw [(I.ringFilterBasis.moduleFilterBasis
    (I.adic_module_basis M)).toAddGroupFilterBasis.nhds_zero_hasBasis.mem_iff]
  constructor
  · rintro ⟨W, ⟨k, rfl⟩, hWV⟩
    exact ⟨k, trivial, hWV⟩
  · rintro ⟨k, -, hWV⟩
    exact ⟨((I ^ k • (⊤ : Submodule R M) : Submodule R M) : Set M), ⟨k, rfl⟩, hWV⟩

variable {N : ℕ → Type*} [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)]
  (g : ∀ n, M →ₗ[R] N n)

/-- **Kernels contain powers.** If the topology induced from maps `gₙ` to discrete modules is the
`I`-adic topology, then every kernel of a `gₙ` contains some `Iᵏ M`: it is open. -/
theorem exists_pow_smul_top_le_ker_of_iInf_induced_eq
    (h : (⨅ n, TopologicalSpace.induced (fun x : M ↦ g n x) ⊥) = I.adicModuleTopology M)
    (n : ℕ) : ∃ k, I ^ k • (⊤ : Submodule R M) ≤ LinearMap.ker (g n) := by
  have hmem : ((LinearMap.ker (g n) : Submodule R M) : Set M) ∈
      @nhds M (⨅ n, TopologicalSpace.induced (fun x : M ↦ g n x) ⊥) 0 := by
    rw [nhds_iInf]
    refine Filter.mem_iInf_of_mem n ?_
    let : TopologicalSpace (N n) := ⊥
    have : DiscreteTopology (N n) := ⟨rfl⟩
    refine (mem_nhds_induced (fun x : M ↦ g n x) 0 _).mpr ⟨{0}, ?_, fun x hx => ?_⟩
    · rw [map_zero, nhds_discrete]
      exact Filter.mem_pure.mpr rfl
    · exact LinearMap.mem_ker.mpr hx
  rw [h] at hmem
  obtain ⟨k, -, hk⟩ := (adicModuleTopology_nhds_zero_hasBasis I).mem_iff.mp hmem
  exact ⟨k, hk⟩

/-- **Powers contain kernels.** If the topology induced from maps `gₙ` to discrete modules, with
decreasing kernels, is the `I`-adic topology, then every `Iᵏ M` contains the kernel of some
`gₙ`. -/
theorem exists_ker_le_pow_smul_top_of_iInf_induced_eq
    (hmono : ∀ i j, i ≤ j → LinearMap.ker (g j) ≤ LinearMap.ker (g i))
    (h : (⨅ n, TopologicalSpace.induced (fun x : M ↦ g n x) ⊥) = I.adicModuleTopology M)
    (k : ℕ) : ∃ n, LinearMap.ker (g n) ≤ I ^ k • (⊤ : Submodule R M) := by
  have hmem : ((I ^ k • (⊤ : Submodule R M) : Submodule R M) : Set M) ∈
      @nhds M (⨅ n, TopologicalSpace.induced (fun x : M ↦ g n x) ⊥) 0 := by
    rw [h]
    exact (adicModuleTopology_nhds_zero_hasBasis I).mem_of_mem (i := k) trivial
  rw [nhds_iInf] at hmem
  obtain ⟨J, hJfin, V, hV, hVeq⟩ := Filter.mem_iInf.mp hmem
  obtain ⟨n, hn⟩ := hJfin.bddAbove
  refine ⟨n, fun x hx => ?_⟩
  show x ∈ ((I ^ k • (⊤ : Submodule R M) : Submodule R M) : Set M)
  rw [hVeq, Set.mem_iInter]
  intro j
  have hxj : g j x = 0 := hmono j n (hn j.2) hx
  let : TopologicalSpace (N j) := ⊥
  obtain ⟨W, hW, hWV⟩ := (mem_nhds_induced (fun x : M ↦ g j x) 0 (V j)).mp (hV j)
  refine hWV ?_
  show g j x ∈ W
  rw [hxj, ← map_zero (g j)]
  exact mem_of_mem_nhds hW

end Converse

section Semilinear

variable {A R : Type*} [CommRing A] [CommRing R] (φ : A →+* R) (I : Ideal A)
  {M M' : Type*} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module R M']
  (ψ : M ≃+ M') (hψ : ∀ (a : A) (x : M), ψ (a • x) = φ a • ψ x)

include hψ in
/-- An element of `(J · R) M'` comes, along a `φ`-semilinear additive bijection `M ≃ M'`, from
an element of `J M`. -/
theorem symm_mem_smul_top_of_mem_map_smul_top (J : Ideal A) {y : M'}
    (hy : y ∈ J.map φ • (⊤ : Submodule R M')) :
    ψ.symm y ∈ J • (⊤ : Submodule A M) := by
  have hgen : ∀ r ∈ J.map φ, ∀ m : M', ψ.symm (r • m) ∈ J • (⊤ : Submodule A M) := by
    intro r hr
    induction hr using Submodule.span_induction with
    | mem r hr =>
      obtain ⟨j, hj, rfl⟩ := hr
      intro m
      have : ψ.symm (φ j • m) = j • ψ.symm m := by
        apply ψ.injective
        rw [hψ, ψ.apply_symm_apply, ψ.apply_symm_apply]
      rw [this]
      exact Submodule.smul_mem_smul hj Submodule.mem_top
    | zero =>
      intro m
      simp
    | add r s _ _ hr hs =>
      intro m
      rw [add_smul, map_add]
      exact add_mem (hr m) (hs m)
    | smul c r _ hr =>
      intro m
      rw [smul_eq_mul, mul_comm, mul_smul]
      exact hr (c • m)
  refine Submodule.smul_induction_on hy (fun r hr m _ => hgen r hr m) (fun y z hy hz => ?_)
  rw [map_add]
  exact add_mem hy hz

variable {N N' : ℕ → Type*} [∀ n, AddCommGroup (N n)] [∀ n, Module A (N n)]
  [∀ n, AddCommGroup (N' n)] [∀ n, Module R (N' n)]
  (g : ∀ n, M →ₗ[A] N n) (g' : ∀ n, M' →ₗ[R] N' n)

include hψ in
/-- **Transport of an `I`-adic limit topology along a semilinear bijection.**  Let `φ : A → R` be
a ring map, `ψ : M ≃ M'` an additive bijection from an `A`-module to an `R`-module with
`ψ (a • x) = φ a • ψ x`, and let maps `gₙ` out of `M` and `g'ₙ` out of `M'` have matching
kernels, the kernels of the `gₙ` decreasing.  If the topology induced on `M'` from the discrete
targets of the `g'ₙ` is the `I · R`-adic topology, then the topology induced on `M` from the
discrete targets of the `gₙ` is the `I`-adic topology. -/
theorem iInf_induced_eq_adicModuleTopology_of_semilinear
    (hker : ∀ n x, g n x = 0 ↔ g' n (ψ x) = 0)
    (hmono : ∀ i j, i ≤ j → LinearMap.ker (g j) ≤ LinearMap.ker (g i))
    (h : (⨅ n, TopologicalSpace.induced (fun x : M' ↦ g' n x) ⊥) =
      (I.map φ).adicModuleTopology M') :
    (⨅ n, TopologicalSpace.induced (fun x : M ↦ g n x) ⊥) = I.adicModuleTopology M := by
  have hmono' : ∀ i j, i ≤ j → LinearMap.ker (g' j) ≤ LinearMap.ker (g' i) := by
    intro i j hij y hy
    have hy' : g j (ψ.symm y) = 0 := (hker j _).mpr (by simpa using hy)
    simpa using (hker i _).mp (hmono i j hij hy')
  refine iInf_induced_eq_adicModuleTopology I g hmono (fun n => ?_) (fun k => ?_)
  · obtain ⟨k, hk⟩ := exists_pow_smul_top_le_ker_of_iInf_induced_eq (I.map φ) g' h n
    refine ⟨k, Submodule.smul_le.mpr fun a ha x _ => ?_⟩
    refine LinearMap.mem_ker.mpr ((hker n _).mpr ?_)
    rw [hψ]
    refine LinearMap.mem_ker.mp (hk ?_)
    rw [← Ideal.map_pow]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem φ ha) Submodule.mem_top
  · obtain ⟨n, hn⟩ := exists_ker_le_pow_smul_top_of_iInf_induced_eq (I.map φ) g' hmono' h k
    refine ⟨n, fun x hx => ?_⟩
    have hx' : ψ x ∈ (I ^ k).map φ • (⊤ : Submodule R M') := by
      rw [Ideal.map_pow]
      exact hn (LinearMap.mem_ker.mpr ((hker n x).mp (LinearMap.mem_ker.mp hx)))
    simpa using symm_mem_smul_top_of_mem_map_smul_top φ ψ hψ (I ^ k) hx'

end Semilinear

end Stacks.AdicLimit

namespace Stacks.Algebraization

variable (S : AlgebraizationSituation.{u})
  (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))

/-- An object of `Coh(U, I𝒪_U)`, as an adic inverse system on the scheme `U`. -/
def adicInverseSystemOnOpen : AdicInverseSystem.{u} where
  X := S.U.toScheme
  I := idealOnOpen S
  system := F.obj
  isQuasicoherent n :=
    haveI := F.property.1 n.unop
    isQuasicoherent_of_isCoherent (F.obj.obj n)
  quotientIso n := (F.property.2.2 n).choose
  quotientIso_hom_comp n := (F.property.2.2 n).choose_spec

/-- **The limit topology on `limₙ H⁰(U, ℱₙ)` is `I`-adic in cohomological dimension one.**  In
Situation 0EHC with `cd(A, I) = 1`, for every object `(ℱₙ)` of `Coh(U, I𝒪_U)` the limit
topology on the `A`-module `M = limₙ H⁰(U, ℱₙ)` is its `I`-adic topology.

This is the case `p = 0` of [Stacks, Tag 0EH7] on the Noetherian scheme `U`, read for the limit
of `A`-modules: see the implementation notes of this file. -/
theorem limitGlobalSections_topology_eq_adicModuleTopology
    (hcd : Stacks.LocalCohomology.cohomologicalDimension S.A S.I
      (IsNoetherian.noetherian S.I) = 1) :
    (⨅ n : ℕ, TopologicalSpace.induced
      (fun x : limitGlobalSections S F =>
        (limit.π (globalSectionsSystem S F) (op n)).hom x) ⊥) =
      S.I.adicModuleTopology (limitGlobalSections S F) := by
  have : AlgebraicGeometry.IsNoetherian S.U.toScheme := by
    have : IsLocallyNoetherian S.U.toScheme := isLocallyNoetherian_of_isOpenImmersion S.U.ι
    have : CompactSpace S.U :=
      isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (S.U : Set S.X))
    exact (isNoetherian_iff S.U.toScheme).2 ⟨inferInstance, inferInstance⟩
  let T := adicInverseSystemOnOpen S F
  have : AlgebraicGeometry.IsNoetherian T.X := ‹AlgebraicGeometry.IsNoetherian S.U.toScheme›
  have h0 := AdicInverseSystem.limitIntCohomologyTopology_eq_adicModuleTopology S.A S.I T
    S.U.ι (Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_comap S.A S.I S.U.ι).symm
    (fun n => F.property.1 n) hcd 0
  let D : ℕᵒᵖ ⥤ ModuleCat.{u} Γ(S.U.toScheme, ⊤) := F.obj ⋙ moduleGlobalSections S.U.toScheme
  let E : AdicInverseSystem.cohomologySystem T
      (AdicInverseSystem.moduleCohomologyFunctorInt S.U.toScheme 0) ≅ D :=
    Functor.isoWhiskerLeft F.obj
      (Stacks.RightDerivedPlus.rightDerivedPlusZeroIso (moduleGlobalSections S.U.toScheme))
  let eL : AdicInverseSystem.cohomologyLimit T
      (AdicInverseSystem.moduleCohomologyFunctorInt S.U.toScheme 0) ≅ limit D :=
    lim.mapIso E
  let cI : limitGlobalSections S F ≅ (ModuleCat.restrictScalars (scalarMap S)).obj (limit D) :=
    (preservesLimitIso (ModuleCat.restrictScalars (scalarMap S)) D).symm
  let c := cI.hom
  have hc : ∀ n : ℕ, c ≫ (ModuleCat.restrictScalars (scalarMap S)).map (limit.π D (op n)) =
      limit.π (globalSectionsSystem S F) (op n) := fun n =>
    preservesLimitIso_inv_π (ModuleCat.restrictScalars (scalarMap S)) D (op n)
  let ψ : limitGlobalSections S F ≃+ AdicInverseSystem.cohomologyLimit T
      (AdicInverseSystem.moduleCohomologyFunctorInt S.U.toScheme 0) :=
    cI.toLinearEquiv.toAddEquiv.trans eL.symm.toLinearEquiv.toAddEquiv
  refine Stacks.AdicLimit.iInf_induced_eq_adicModuleTopology_of_semilinear (scalarMap S) S.I
    ψ (fun a x => ?_) (fun n => (limit.π (globalSectionsSystem S F) (op n)).hom)
    (fun n => (limit.π (AdicInverseSystem.cohomologySystem T
      (AdicInverseSystem.moduleCohomologyFunctorInt S.U.toScheme 0)) (op n)).hom)
    (fun n x => ?_) (fun i j hij x hx => ?_) h0
  · show eL.inv.hom (c.hom (a • x)) = scalarMap S a • eL.inv.hom (c.hom x)
    rw [map_smul]
    exact map_smul eL.inv.hom (scalarMap S a) (c.hom x)
  · have hπ : ∀ y : (limit D : ModuleCat.{u} Γ(S.U.toScheme, ⊤)),
        (limit.π (AdicInverseSystem.cohomologySystem T
        (AdicInverseSystem.moduleCohomologyFunctorInt S.U.toScheme 0)) (op n)).hom
          (eL.inv.hom y) = (E.inv.app (op n)).hom ((limit.π D (op n)).hom y) := fun y =>
      congrArg (fun f => ModuleCat.Hom.hom f y) (limMap_π E.inv (op n))
    have hD : (limit.π D (op n)).hom (c.hom x) =
        (limit.π (globalSectionsSystem S F) (op n)).hom x :=
      congrArg (fun f => ModuleCat.Hom.hom f x) (hc n)
    constructor
    · exact fun hx => (hπ (c.hom x)).trans (by rw [hD, hx]; exact LinearMap.map_zero _)
    · intro hx
      have h1 := congrArg (E.hom.app (op n)).hom ((hπ (c.hom x)).symm.trans hx)
      rwa [← ModuleCat.comp_apply, Iso.inv_hom_id_app, LinearMap.map_zero, hD] at h1
  · show (limit.π (globalSectionsSystem S F) (op i)).hom x = 0
    rw [← limit.w (globalSectionsSystem S F) (homOfLE hij).op, ModuleCat.comp_apply,
      show (limit.π (globalSectionsSystem S F) (op j)).hom x = 0 from hx, map_zero]

end Stacks.Algebraization

