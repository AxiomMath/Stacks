module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.AlgebraizationCoherentFormal.FlatLocalBaseCanonicalExtension

/-!
# Canonical extension from a decomposition along a finite family of elements of `I`

Fix an algebraization situation (Stacks 0EHC): a Noetherian ring `A` with ideals `I ⊆ 𝔞`,
`X = Spec(A)` and `U = X \ V(𝔞)`, and a coherent `I`-adic system `(F_n)` on `U`. The proofs of
Stacks 0EJS and Stacks 0EJU share one argument: there is a finite family `g₁, …, g_d ∈ I` such
that every `Iⁿ⁺¹ F_(n+2)` is a finite direct sum of copies of `F_1`, the components being
multiplication by elements of `(g₁, …, g_d)ⁿ⁺¹`; then the three conditions of the
Mittag-Leffler criterion Stacks 0EHH hold as soon as `H⁰(U, F_1)` and `H¹(U, F_1)` are finite
`A`-modules. The two tags differ only in how the decomposition is obtained: from flatness over a
Noetherian local base in Stacks 0EJU, from a regular sequence on the formal stalks in Stacks
0EJS.

This file carries out the common argument for an arbitrary finite family `g : L → A` of
elements of `I`. The family need not generate `I`: in Stacks 0EJS the `fᵢ` only generate
`I 𝒪_{X,y}` at the points `y ∈ U ∩ Y`.

## Main definitions

* `Stacks.Algebraization.upMapOf` — the up map `F_n ⟶ F_(n+1)` lifting multiplication by `gₗ`.
* `Stacks.Algebraization.shiftSubOf` — its restriction `Iⁿ⁺¹ F_(n+1) ⟶ Iⁿ⁺² F_(n+2)`.

## Main results

* `Stacks.Algebraization.exists_sum_shiftSubOf` — generation in degree one: after any additive
  functor, every element of degree `n + 1` is a sum of shifts of elements of degree `n`.
* `Stacks.Algebraization.isMittagLeffler_globalSectionsSystem_of_idealPowerDesc` — condition (a)
  of Stacks 0EHH (Cohomology 0GYK).
* `Stacks.Algebraization.limitTopology_eq_adicModuleTopology_of_idealPowerDesc` — condition (b)
  of Stacks 0EHH (Cohomology 0GYM).
* `Stacks.Algebraization.canonicallyExtends_of_idealPowerDesc` and
  `Stacks.Algebraization.essImage_completionFunctor_of_idealPowerDesc` — canonical extension,
  and over an `I`-adically complete `A` algebraization on `U`.

## Implementation notes

The decomposition hypothesis `hdesc` is stated exactly as
`Stacks.Algebraization.exists_isIso_idealPowerDesc` concludes it: for every identification `e`
of `F_(n+2)/I F_(n+2)` with `F_1` compatible with the transition, some
`Stacks.Algebraization.idealPowerDesc` built from elements of `(g)ⁿ⁺¹` is an isomorphism.

Condition (a) runs the general-ideal Mittag-Leffler criterion for the ideal `J = (g)` rather
than `I`; this is legitimate because `J ⊆ I`, so `Jⁿ⁺¹` still annihilates `H⁰(U, F_n)`, and the
Mittag-Leffler property does not mention the ideal. Condition (b) is stated for `I`, and its
approximation step only needs `gₗ ∈ I`.

## References

* [Stacks Project, Tag 0EJS](https://stacks.math.columbia.edu/tag/0EJS)
* [Stacks Project, Tag 0EJU](https://stacks.math.columbia.edu/tag/0EJU)
* [Stacks Project, Tag 0EHH](https://stacks.math.columbia.edu/tag/0EHH)
* [Stacks Project, Tag 0GYK](https://stacks.math.columbia.edu/tag/0GYK)
* [Stacks Project, Tag 0GYM](https://stacks.math.columbia.edu/tag/0GYM)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open scoped AlgebraicGeometry

universe u v w

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

namespace Stacks.Algebraization

attribute [local instance] hasFiniteBiproducts_schemeModules

variable (S : AlgebraizationSituation.{u})
  (F : Stacks.Coherent.CoherentAdicSystems (idealOnOpen S))
  {L : Type v} (g : L → S.A) (hg : ∀ l, g l ∈ S.I)

/-! ### The up maps and the shifts of the family -/

include hg in
/-- The ideal generated by a family of elements of `I` is contained in `I`. -/
theorem span_range_le_of_mem : Ideal.span (Set.range g) ≤ S.I :=
  Ideal.span_le.mpr (Set.range_subset_iff.mpr hg)

include hg in
/-- Multiplication by an element of `(g)ᵏ` restricts to the `k`-th power of the ideal on `U`. -/
theorem restrictMemIdealPow_scalarMap_of_mem_span_pow {k : ℕ} {a : S.A}
    (ha : a ∈ Ideal.span (Set.range g) ^ k) :
    RestrictMemIdealPow (idealOnOpen S) k (scalarMap S a) :=
  restrictMemIdealPow_scalarMap S k (Ideal.pow_right_mono (span_range_le_of_mem S g hg) k ha)

include hg in
/-- Multiplication by `gₗ` lifts to a map `F_n ⟶ F_(n+1)` whose composites with the transition
map on either side are multiplication by `gₗ`. -/
theorem exists_upMapOf (l : L) (n : ℕ) :
    ∃ u : F.obj.obj (op n) ⟶ F.obj.obj (op (n + 1)),
      succTrans S F n ≫ u = sectionSmul (scalarMap S (g l)) (F.obj.obj (op (n + 1))) ∧
        u ≫ succTrans S F n = sectionSmul (scalarMap S (g l)) (F.obj.obj (op n)) :=
  exists_transitionSmulUp F (Nat.le_succ n) (le_refl (n + 1))
    (restrictMemIdealPow_scalarMap S 1 (by rw [pow_one]; exact hg l))

/-- **The up map of a member of the family**: multiplication by `gₗ`, lifted to
`F_n ⟶ F_(n+1)`. -/
def upMapOf (l : L) (n : ℕ) : F.obj.obj (op n) ⟶ F.obj.obj (op (n + 1)) :=
  (exists_upMapOf S F g hg l n).choose

/-- The transition `F_(n+1) ⟶ F_n` followed by the up map is multiplication by `gₗ` on
`F_(n+1)`. -/
theorem trans_upMapOf (l : L) (n : ℕ) :
    succTrans S F n ≫ upMapOf S F g hg l n =
      sectionSmul (scalarMap S (g l)) (F.obj.obj (op (n + 1))) :=
  (exists_upMapOf S F g hg l n).choose_spec.1

/-- The up map followed by the transition `F_(n+1) ⟶ F_n` is multiplication by `gₗ` on `F_n`. -/
theorem upMapOf_trans (l : L) (n : ℕ) :
    upMapOf S F g hg l n ≫ succTrans S F n = sectionSmul (scalarMap S (g l)) (F.obj.obj (op n)) :=
  (exists_upMapOf S F g hg l n).choose_spec.2

/-- Two transitions `F_(n+2) ⟶ F_n` followed by the up maps of `gₗ'` and `gₗ` is multiplication by
`gₗ gₗ'` on `F_(n+2)`. -/
theorem succTrans_succTrans_upMapOf_upMapOf (l l' : L) (n : ℕ) :
    succTrans S F (n + 1) ≫ succTrans S F n ≫ upMapOf S F g hg l' n ≫ upMapOf S F g hg l (n + 1) =
      sectionSmul (scalarMap S (g l) * scalarMap S (g l')) (F.obj.obj (op (n + 2))) := by
  rw [← Category.assoc (succTrans S F n), trans_upMapOf, ← Category.assoc, comp_sectionSmul,
    Category.assoc, trans_upMapOf, sectionSmul_comp]

/-- The up maps of two members of the family commute. -/
theorem upMapOf_comm (l l' : L) (n : ℕ) :
    upMapOf S F g hg l' n ≫ upMapOf S F g hg l (n + 1) =
      upMapOf S F g hg l n ≫ upMapOf S F g hg l' (n + 1) := by
  have : Epi (succTrans S F n) := F.property.epi_map (Nat.le_succ n)
  have : Epi (succTrans S F (n + 1)) := F.property.epi_map (Nat.le_succ (n + 1))
  rw [← cancel_epi (succTrans S F n), ← cancel_epi (succTrans S F (n + 1)),
    succTrans_succTrans_upMapOf_upMapOf, succTrans_succTrans_upMapOf_upMapOf, mul_comm]

/-- Multiplication by `b ∈ I` kills `Iⁿ⁺¹ F_(n+1)` inside `F_(n+1)`. -/
private theorem idealPowerSub_ι_comp_sectionSmul_eq_zero (n : ℕ) {b : S.A}
    (hb : b ∈ S.I) :
    (idealPowerSub S F n).ι ≫ sectionSmul (scalarMap S b) (F.obj.obj (op (n + 1))) =
      (0 : ((idealPowerSub S F n).toSheafOfModules : S.U.toScheme.Modules) ⟶ _) := by
  have : (F.obj.obj (op (n + 1))).IsQuasicoherent := F.property.isQuasicoherent (n + 1)
  exact idealPowerMultiple_ι_comp_sectionSmul (F.obj.obj (op (n + 1))) (k := 1)
    (d := n + 1) (r := n + 1 + 1) (by omega) (F.property.idealPowerMultiple_eq_bot (n + 1))
    (restrictMemIdealPow_scalarMap S 1 (by rw [pow_one]; exact hb))

include hg in
/-- The up map of `gₗ` sends `Iⁿ⁺¹ F_(n+1)` into the kernel of the projection
`(idealPowerShortComplex S F (n + 1)).g` out of `F_(n+2)`. -/
theorem idealPowerSub_ι_upMapOf_comp_π (l : L) (n : ℕ) :
    ((idealPowerSub S F n).ι ≫ upMapOf S F g hg l (n + 1)) ≫
      (idealPowerShortComplex S F (n + 1)).g = 0 := by
  obtain ⟨e, he⟩ := F.property.2.2 (n + 1)
  have hπ : (idealPowerShortComplex S F (n + 1)).g = succTrans S F (n + 1) ≫ e.inv :=
    (Iso.eq_comp_inv e).mpr he
  have hzero := idealPowerSub_ι_comp_sectionSmul_eq_zero S F n (hg l)
  rw [hπ]
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (fun φ => φ ≫ e.inv) ((Category.assoc _ _ _).trans
      ((congrArg (fun φ => (idealPowerSub S F n).ι ≫ φ) (upMapOf_trans S F g hg l (n + 1))).trans
        hzero))).trans zero_comp)

/-- **The shift of a member of the family**, `Iⁿ⁺¹ F_(n+1) ⟶ Iⁿ⁺² F_(n+2)`: the restriction of
its up map `F_(n+1) ⟶ F_(n+2)`. -/
def shiftSubOf (l : L) (n : ℕ) :
    (idealPowerSub S F n).toSheafOfModules ⟶ (idealPowerSub S F (n + 1)).toSheafOfModules :=
  (idealPowerShortComplex_shortExact S F (n + 1)).exact.lift
    ((idealPowerSub S F n).ι ≫ upMapOf S F g hg l (n + 1))
    (idealPowerSub_ι_upMapOf_comp_π S F g hg l n)

/-- The shift of `gₗ` followed by the inclusion `Iⁿ⁺² F_(n+2) ⟶ F_(n+2)` is the inclusion
`Iⁿ⁺¹ F_(n+1) ⟶ F_(n+1)` followed by the up map of `gₗ`. -/
theorem shiftSubOf_ι (l : L) (n : ℕ) :
    shiftSubOf S F g hg l n ≫ (idealPowerSub S F (n + 1)).ι =
      (idealPowerSub S F n).ι ≫ upMapOf S F g hg l (n + 1) :=
  (idealPowerShortComplex_shortExact S F (n + 1)).exact.lift_f _ _

/-- The shifts of two members of the family commute. -/
theorem shiftSubOf_comm (l l' : L) (n : ℕ) :
    shiftSubOf S F g hg l' n ≫ shiftSubOf S F g hg l (n + 1) =
      shiftSubOf S F g hg l n ≫ shiftSubOf S F g hg l' (n + 1) :=
  comp_eq_comp_of_lift _ _ _ (cancel_sheafSubmodule_ι (idealPowerSub S F (n + 1 + 1)))
    (shiftSubOf_ι S F g hg l' n) (shiftSubOf_ι S F g hg l n) (shiftSubOf_ι S F g hg l (n + 1))
    (shiftSubOf_ι S F g hg l' (n + 1)) (upMapOf_comm S F g hg l l' (n + 1))

/-! ### Generation in degree one -/

/-- An element of `(g)ⁿ⁺²` is `∑ₗ gₗ sₗ` with every `sₗ ∈ (g)ⁿ⁺¹`. -/
theorem exists_eq_sum_mul_of_mem_span_pow [Fintype L] (n : ℕ) (r : S.A)
    (hr : r ∈ Ideal.span (Set.range g) ^ (n + 1 + 1)) :
    ∃ a : L → S.A, (∀ l, a l ∈ Ideal.span (Set.range g) ^ (n + 1)) ∧
      ∑ l, g l * a l = r := by
  classical
  have hmem : r ∈ Ideal.span (Set.range g) ^ (n + 1) • Submodule.span S.A (Set.range g) := by
    rw [← Ideal.span, Ideal.smul_eq_mul, ← pow_succ]
    exact hr
  obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp hmem
  refine ⟨a, ha, ?_⟩
  rw [← hsum, Finsupp.sum_fintype _ _ (fun _ => by simp)]
  exact Finset.sum_congr rfl fun l _ => by rw [smul_eq_mul, mul_comm]

/-- **Generation in degree one.** If every `Iⁿ⁺¹ F_(n+1)` decomposes as a finite direct sum of
copies of `F_1` with components given by elements of `(g)ⁿ⁺¹` (hypothesis `hdesc`), then after
any additive functor `G`, every element of `G(Iⁿ⁺² F_(n+2))` is a sum `∑ₗ G(μₗ)(yₗ)` of shifts of
elements of `G(Iⁿ⁺¹ F_(n+1))`. -/
theorem exists_sum_shiftSubOf [Fintype L]
    (hdesc : ∀ (n : ℕ)
      (e : idealPowerQuotient (idealOnOpen S) 1 (F.obj.obj (op (n + 1))) ≅ F.obj.obj (op 0))
      (_ : cokernel.π (C := S.U.toScheme.Modules)
          (idealPowerMultiple (idealOnOpen S) 1 (F.obj.obj (op (n + 1)))).ι ≫ e.hom =
        F.obj.map (homOfLE (Nat.zero_le (n + 1))).op),
      ∃ (k : ℕ) (a : Fin k → S.A) (_ : ∀ i, a i ∈ Ideal.span (Set.range g) ^ (n + 1))
        (hb : ∀ i, RestrictMemIdealPow (idealOnOpen S) (n + 1) (scalarMap S (a i))),
        haveI := F.property.isQuasicoherent (n + 1)
        IsIso (idealPowerDesc (F.obj.obj (op (n + 1))) (n + 1)
          (F.property.idealPowerMultiple_eq_bot (n + 1)) hb e))
    {A' : Type*} [Ring A'] (G : S.U.toScheme.Modules ⥤ ModuleCat.{w} A')
    [G.Additive] (n : ℕ) (x : G.obj (idealPowerSub S F (n + 1)).toSheafOfModules) :
    ∃ y : L → G.obj (idealPowerSub S F n).toSheafOfModules,
      x = ∑ l, (G.map (shiftSubOf S F g hg l n)).hom (y l) := by
  classical
  have := F.property.isQuasicoherent (n + 1 + 1)
  have := F.property.isQuasicoherent (n + 1)
  obtain ⟨e, he⟩ := exists_quotientZeroIso F (n + 1 + 1)
  obtain ⟨e', he'⟩ := exists_quotientZeroIso F (n + 1)
  obtain ⟨k, r, hr, hb, hiso⟩ := hdesc (n + 1) e he
  choose a ha hsum using fun i => exists_eq_sum_mul_of_mem_span_pow S g n (r i) (hr i)
  have hs : ∀ i l, RestrictMemIdealPow (idealOnOpen S) (n + 1) (scalarMap S (a i l)) :=
    fun i l => restrictMemIdealPow_scalarMap_of_mem_span_pow S g hg (ha i l)
  have := hiso
  have : Epi (F.obj.map (homOfLE (Nat.zero_le (n + 1 + 1))).op) :=
    F.property.epi_map (Nat.zero_le (n + 1 + 1))
  refine exists_eq_sum_map_of_isIso (C := S.U.toScheme.Modules) G
    (idealPowerDesc (F.obj.obj (op (n + 1 + 1))) (n + 1 + 1)
      (F.property.idealPowerMultiple_eq_bot (n + 1 + 1)) hb e)
    (fun i l => idealPowerComponent (F.obj.obj (op (n + 1))) (n + 1)
      (F.property.idealPowerMultiple_eq_bot (n + 1)) (hs i l) e')
    (fun l => shiftSubOf S F g hg l n) (fun i => ?_) x
  refine (biproduct.ι_desc _ i).trans ?_
  refine eq_sum_comp_of_cancel (C := S.U.toScheme.Modules) Finset.univ
    (F.obj.map (homOfLE (Nat.zero_le (n + 1 + 1))).op)
    (succTrans S F (n + 1)) (F.obj.map (homOfLE (Nat.zero_le (n + 1))).op)
    (succTrans_zero S F n) (idealPowerSub S F n).ι (idealPowerSub S F (n + 1)).ι
    (cancel_sheafSubmodule_ι (idealPowerSub S F (n + 1))) _ _ (fun l => shiftSubOf S F g hg l n)
    (fun l => upMapOf S F g hg l (n + 1)) _ _
    (fun l => sectionSmul (scalarMap S (g l) * scalarMap S (a i l))
      (F.obj.obj (op (n + 1 + 1))))
    (comp_idealPowerComponent_comp_ι _ _ _ (hb i) e he)
    (fun l => comp_idealPowerComponent_comp_ι _ _ _ (hs i l) e' he')
    (fun l => shiftSubOf_ι S F g hg l n) (fun l => ?_) ?_
  · rw [← Category.assoc, comp_sectionSmul, Category.assoc, trans_upMapOf, sectionSmul_comp]
  · rw [← sectionSmul_sum, ← hsum i, map_sum]
    exact congrArg (fun b => sectionSmul b _)
      (Finset.sum_congr rfl fun l _ => by rw [map_mul])

/-! ### The boundary maps and the shifts -/

/-- The morphism of ideal-power sequences given by the up maps of a member of the family. -/
def shiftShortComplexOf (l : L) (n : ℕ) :
    idealPowerShortComplex S F n ⟶ idealPowerShortComplex S F (n + 1) where
  τ₁ := shiftSubOf S F g hg l n
  τ₂ := upMapOf S F g hg l (n + 1)
  τ₃ := (cokernelIso S F n).hom ≫ upMapOf S F g hg l n ≫ (cokernelIso S F (n + 1)).inv
  comm₁₂ := shiftSubOf_ι S F g hg l n
  comm₂₃ := abstract_up_comp_π _ _ _ _ _ _ _ _ _ (π_cokernelIso_hom S F n)
    ((Iso.eq_comp_inv _).mpr (π_cokernelIso_hom S F (n + 1))) (trans_upMapOf S F g hg l n)
    (upMapOf_trans S F g hg l (n + 1))

/-- **The boundary maps commute with the shifts**: `δ_(n+1) ∘ H⁰(uₗ) = H¹(μₗ) ∘ δₙ`. -/
theorem upMapOf_comp_sectionsBoundary (l : L) (n : ℕ) :
    (topSections S).map (upMapOf S F g hg l n) ≫ sectionsBoundary S F (n + 1) =
      sectionsBoundary S F n ≫ ((topSections S).rightDerived 1).map (shiftSubOf S F g hg l n) :=
  abstract_boundary_naturality _ _ _ (topSections S).rightDerivedZeroIsoSelf _ _ _ _ _ _
    (boundary_naturality S (idealPowerShortComplex_shortExact S F n)
      (idealPowerShortComplex_shortExact S F (n + 1)) (shiftShortComplexOf S F g hg l n))

/-- The shift `Hᵖ(U, Iⁿ⁺¹ F_(n+1)) ⟶ Hᵖ(U, Iⁿ⁺² F_(n+2))` of a member of the family, over `A`. -/
def cohomologyShiftOf (p : ℕ) (l : L) (n : ℕ) :
    (openCohomologyFunctor S p).obj (idealPowerSub S F n).toSheafOfModules →ₗ[S.A]
      (openCohomologyFunctor S p).obj (idealPowerSub S F (n + 1)).toSheafOfModules :=
  ((openCohomologyFunctor S p).map (shiftSubOf S F g hg l n)).hom

/-- The shift `H⁰(U, Iⁿ⁺¹ F_(n+1)) ⟶ H⁰(U, Iⁿ⁺² F_(n+2))` of a member of the family, over `A`. -/
abbrev sectionsShiftOf (l : L) (n : ℕ) :
    idealPowerSections S F n →ₗ[S.A] idealPowerSections S F (n + 1) :=
  ((openSectionsFunctor S).map (shiftSubOf S F g hg l n)).hom

/-! ### The decomposition and its consequences -/

section Decomposition

variable [Fintype L]
  (hdesc : ∀ (n : ℕ)
    (e : idealPowerQuotient (idealOnOpen S) 1 (F.obj.obj (op (n + 1))) ≅ F.obj.obj (op 0))
    (_ : cokernel.π (C := S.U.toScheme.Modules)
        (idealPowerMultiple (idealOnOpen S) 1 (F.obj.obj (op (n + 1)))).ι ≫ e.hom =
      F.obj.map (homOfLE (Nat.zero_le (n + 1))).op),
    ∃ (k : ℕ) (a : Fin k → S.A) (_ : ∀ i, a i ∈ Ideal.span (Set.range g) ^ (n + 1))
      (hb : ∀ i, RestrictMemIdealPow (idealOnOpen S) (n + 1) (scalarMap S (a i))),
      haveI := F.property.isQuasicoherent (n + 1)
      IsIso (idealPowerDesc (F.obj.obj (op (n + 1))) (n + 1)
        (F.property.idealPowerMultiple_eq_bot (n + 1)) hb e))

include hdesc in
/-- The decomposition `hdesc` makes every `Iⁿ⁺¹ F_(n+2)` a finite direct sum of copies of
`F_1`. -/
theorem exists_isoDirectSum_idealPowerSub_of_idealPowerDesc (n : ℕ) :
    ∃ k : ℕ, Nonempty ((⨁ fun _ : Fin k => F.obj.obj (op 0)) ≅
      (idealPowerSub S F n).toSheafOfModules) := by
  obtain ⟨e, he⟩ := exists_quotientZeroIso F (n + 1)
  obtain ⟨k, r, -, hb, hiso⟩ := hdesc n e he
  have hqc : (F.obj.obj (op (n + 1))).IsQuasicoherent := F.property.isQuasicoherent (n + 1)
  exact ⟨k, ⟨asIso (idealPowerDesc (F.obj.obj (op (n + 1))) (n + 1)
    (F.property.idealPowerMultiple_eq_bot (n + 1)) hb e)⟩⟩

include hg hdesc in
/-- **Condition (a) of Stacks 0EHH from the decomposition.** If `hdesc` holds and `H¹(U, F_1)`
is a finite `A`-module, the inverse system `H⁰(U, F_n)` has the Mittag-Leffler property.

This is Cohomology 0GYK in its general-ideal form
`Stacks.Cohomology.IdealBoundaries.isMittagLefflerCategorical_of_idealBoundaries`, run for the
ideal `(g) ⊆ I` and the up maps of the family; the boundaries are eventually generated in degree
one by the chain condition `Stacks.CommutingShifts.exists_eventual_sum_shift` on
`⨁ₙ H¹(U, Iⁿ⁺¹ F_(n+1))`. -/
theorem isMittagLeffler_globalSectionsSystem_of_idealPowerDesc
    (h1 : Module.Finite S.A
      (Stacks.LocalCohomology.cohomologyOverBase.{u, u} S.A S.U.ι (F.obj.obj (op 0)) 1)) :
    IsMittagLefflerCategorical (globalSectionsSystem S F) := by
  classical
  have hfin0 : Module.Finite S.A
      ((openCohomologyFunctor S 1).obj (idealPowerSub S F 0).toSheafOfModules) :=
    finite_openCohomology_of_finite_cohomologyOverBase S 1 _
      (finite_cohomologyOverBase_idealPowerSub_of_isoDirectSum S F 1 h1
        (exists_isoDirectSum_idealPowerSub_of_idealPowerDesc S F g hdesc) 0)
  have hd : ∀ n, LinearMap.range ((openSectionsFunctor S).map (succTrans S F n)).hom =
      LinearMap.ker (sectionsBoundaryA S F n) := by
    intro n
    ext y
    exact (sectionsBoundary_eq_zero_iff S F n y).symm
  have hdu : ∀ (l : L) (n : ℕ), (sectionsBoundaryA S F (n + 1)).comp
      ((openSectionsFunctor S).map (upMapOf S F g hg l n)).hom =
        (cohomologyShiftOf S F g hg 1 l n).comp (sectionsBoundaryA S F n) := by
    intro l n
    refine LinearMap.ext fun x => ?_
    have h := congrArg ModuleCat.Hom.hom (upMapOf_comp_sectionsBoundary S F g hg l n)
    exact LinearMap.congr_fun h x
  have hup : ∀ (l : L) (n : ℕ),
      ((openSectionsFunctor S).map (upMapOf S F g hg l n) ≫
        (openSectionsFunctor S).map (succTrans S F n)).hom =
        g l • (LinearMap.id : (openSectionsFunctor S).obj (F.obj.obj (op n)) →ₗ[S.A] _) := by
    intro l n
    rw [← Functor.map_comp, upMapOf_trans]
    exact LinearMap.ext fun x => openSectionsFunctor_map_sectionSmul S (g l) _ x
  have hann : ∀ i : ℕ, Ideal.span (Set.range g) ^ (i + 1) •
      (⊤ : Submodule S.A ((openSectionsFunctor S).obj (F.obj.obj (op i)))) = ⊥ := fun i =>
    le_bot_iff.mp ((Submodule.smul_mono_left
      (Ideal.pow_right_mono (span_range_le_of_mem S g hg) (i + 1))).trans
        (idealPow_smul_globalSections_eq_bot S F i).le)
  obtain ⟨c, hc⟩ := Stacks.CommutingShifts.exists_eventual_sum_shift
    (N := fun n => (openCohomologyFunctor S 1).obj (idealPowerSub S F n).toSheafOfModules)
    (cohomologyShiftOf S F g hg 1)
    (fun l l' n x => abstract_map_comm _ _ _ _ _ (shiftSubOf_comm S F g hg l l' n) x)
    (fun n x => exists_sum_shiftSubOf S F g hg hdesc (openCohomologyFunctor S 1) n x)
    (fun n => LinearMap.range (sectionsBoundaryA S F n))
    (fun l n x hx => by
      obtain ⟨y, rfl⟩ := hx
      exact ⟨_, LinearMap.congr_fun (hdu l n) y⟩)
  have hboundary : ∀ n, c ≤ n → ∀ x : (openSectionsFunctor S).obj (F.obj.obj (op (n + 1))),
      ∃ y : L → (openSectionsFunctor S).obj (F.obj.obj (op n)),
        sectionsBoundaryA S F (n + 1) x =
          ∑ l, cohomologyShiftOf S F g hg 1 l n (sectionsBoundaryA S F n (y l)) := by
    intro n hn x
    obtain ⟨z, hz, hsum⟩ := hc n hn _ ⟨x, rfl⟩
    choose y hy using hz
    exact ⟨y, by rw [hsum]; simp only [hy]⟩
  have key := Stacks.Cohomology.IdealBoundaries.isMittagLefflerCategorical_of_idealBoundaries
    (openSectionsFunctor S) (fun n => F.obj.obj (op n)) (succTrans S F) g
    (Ideal.span (Set.range g)) rfl (upMapOf S F g hg) hup hann (sectionsBoundaryA S F) hd
    (cohomologyShiftOf S F g hg 1) hdu c hboundary
  have hsystem : globalSectionsSystem S F =
      Functor.ofOpSequence (X := fun n => F.obj.obj (op n))
        (fun n => F.obj.map (homOfLE (Nat.le_succ n)).op) ⋙ openSectionsFunctor S :=
    congrArg (fun G => G ⋙ openSectionsFunctor S) (eq_ofOpSequence F.obj)
  rw [hsystem]
  exact key

include hg in
/-- `gₗ` kills the sections of `Iⁿ⁺¹ F_(n+1)` inside those of `F_(n+1)`. -/
theorem smul_idealPowerSectionsι_of_mem (l : L) (n : ℕ) (k : idealPowerSections S F n) :
    g l • (idealPowerSectionsι S F n).hom k = 0 := by
  rw [← openSectionsFunctor_map_sectionSmul]
  exact (congrArg (fun φ => ((openSectionsFunctor S).map φ).hom k)
    (idealPowerSub_ι_comp_sectionSmul_eq_zero S F n (hg l))).trans rfl

/-- On a compatible family whose `(n+1)`-st term is a section `k` of `Iⁿ⁺¹ F_(n+1)`,
multiplication by `gₗ` in degree `n + 2` is the shift of `k`. -/
theorem smul_π_eq_sectionsShiftOf (l : L) (n : ℕ) (x : limitGlobalSections S F)
    (k : idealPowerSections S F n)
    (hk : (limit.π (globalSectionsSystem S F) (op (n + 1))).hom x =
      (idealPowerSectionsι S F n).hom k) :
    g l • (limit.π (globalSectionsSystem S F) (op (n + 2))).hom x =
      (idealPowerSectionsι S F (n + 1)).hom (sectionsShiftOf S F g hg l n k) := by
  rw [← openSectionsFunctor_map_sectionSmul, ← trans_upMapOf S F g hg]
  have hw : ((openSectionsFunctor S).map (succTrans S F (n + 1))).hom
      ((limit.π (globalSectionsSystem S F) (op (n + 2))).hom x) =
        (limit.π (globalSectionsSystem S F) (op (n + 1))).hom x :=
    congrArg (fun g => ModuleCat.Hom.hom g x)
      (limit.w (globalSectionsSystem S F) (homOfLE (Nat.le_succ (n + 1))).op)
  rw [Functor.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hw, hk]
  exact abstract_map_comm _ _ _ _ _ (shiftSubOf_ι S F g hg l n).symm k

/-- The shift of sections by `gₗ` maps `Stacks.Algebraization.liftingSections` in degree `n` into
`Stacks.Algebraization.liftingSections` in degree `n + 1`. -/
theorem sectionsShiftOf_mem_liftingSections (l : L) (n : ℕ)
    (k : idealPowerSections S F n) (hk : k ∈ liftingSections S F n) :
    sectionsShiftOf S F g hg l n k ∈ liftingSections S F (n + 1) := by
  obtain ⟨x, hx0, hx1⟩ := (mem_liftingSections_iff S F n k).mp hk
  refine (mem_liftingSections_iff S F (n + 1) _).mpr ⟨g l • x, ?_, ?_⟩
  · rw [map_smul, hx1]
    exact smul_idealPowerSectionsι_of_mem S F g hg l n k
  · rw [map_smul]
    exact smul_π_eq_sectionsShiftOf S F g hg l n x k hx1

include hg hdesc in
/-- **Condition (b) of Stacks 0EHH from the decomposition.** If `hdesc` holds and `H⁰(U, F_1)`
is a finite `A`-module, the limit topology on `M = lim H⁰(U, F_n)` is the `I`-adic topology.

This is Cohomology 0GYM: the chain condition `Stacks.CommutingShifts.exists_eventual_sum_shift` on
`⨁ₙ H⁰(U, Iⁿ⁺¹ F_(n+1))`, applied to the graded submodule
`Stacks.Algebraization.liftingSections`, approximates the elements of `M` dying in degree `n + 1`
by `gₗ`-multiples of elements dying in degree `n`; since every `gₗ` lies in `I`, this gives the
`I`-adic topology. -/
theorem limitTopology_eq_adicModuleTopology_of_idealPowerDesc
    (h0 : Module.Finite S.A ((globalSectionsSystem S F).obj (op 0))) :
    (⨅ n : ℕ, TopologicalSpace.induced
      (fun x : limitGlobalSections S F =>
        (limit.π (globalSectionsSystem S F) (op n)).hom x) ⊥) =
        S.I.adicModuleTopology (limitGlobalSections S F) := by
  classical
  have : Module.Finite S.A (idealPowerSections S F 0) :=
    finite_idealPowerSections_of_isoDirectSum S F h0
      (exists_isoDirectSum_idealPowerSub_of_idealPowerDesc S F g hdesc) 0
  obtain ⟨c, hc⟩ := Stacks.CommutingShifts.exists_eventual_sum_shift
    (N := fun n => idealPowerSections S F n) (sectionsShiftOf S F g hg)
    (fun l l' n x => abstract_map_comm _ _ _ _ _ (shiftSubOf_comm S F g hg l l' n) x)
    (fun n x => exists_sum_shiftSubOf S F g hg hdesc (openSectionsFunctor S) n x)
    (liftingSections S F) (sectionsShiftOf_mem_liftingSections S F g hg)
  refine Stacks.AdicLimit.iInf_induced_limit_eq_adicModuleTopology (globalSectionsSystem S F)
    S.I (idealPow_smul_globalSections_eq_bot S F) g hg c fun n hn x hx => ?_
  have hker : (limit.π (globalSectionsSystem S F) (op (n + 2))).hom x ∈ LinearMap.ker
      ((globalSectionsSystem S F).map (homOfLE (Nat.le_succ (n + 1))).op).hom := by
    rw [LinearMap.mem_ker]
    exact (congrArg (fun g => ModuleCat.Hom.hom g x)
      (limit.w (globalSectionsSystem S F) (homOfLE (Nat.le_succ (n + 1))).op)).trans hx
  obtain ⟨k, hk⟩ := ker_globalSectionsSystem_map_le_range S F (n + 1) hker
  obtain ⟨z, hz, hsum⟩ := hc n hn k ((mem_liftingSections_iff S F (n + 1) k).mpr ⟨x, hx, hk.symm⟩)
  choose y hy0 hy1 using fun l => (mem_liftingSections_iff S F n (z l)).mp (hz l)
  refine ⟨y, hy0, ?_⟩
  rw [map_sub, map_sum, ← hk, hsum, map_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_eq_zero fun l _ => ?_
  rw [map_smul, smul_π_eq_sectionsShiftOf S F g hg l n (y l) (z l) (hy1 l), sub_self]

include hg hdesc in
/-- **Canonical extension from the decomposition.** If `hdesc` holds for a finite family of
elements of `I` and `H⁰(U, F_1)`, `H¹(U, F_1)` are finite `A`-modules, then `(F_n)` extends
canonically to `X`: the three conditions of Stacks 0EHH hold. -/
theorem canonicallyExtends_of_idealPowerDesc (h3 : HasFiniteLowDegreeCohomology S F) :
    CanonicallyExtends S F :=
  canonicallyExtends_of_isoDirectSum S F
    (isMittagLeffler_globalSectionsSystem_of_idealPowerDesc S F g hg hdesc h3.2)
    (limitTopology_eq_adicModuleTopology_of_idealPowerDesc S F g hg hdesc h3.1) h3.1
    (exists_isoDirectSum_idealPowerSub_of_idealPowerDesc S F g hdesc)

include hg hdesc in
/-- **Algebraization from the decomposition.** Under the hypotheses of
`Stacks.Algebraization.canonicallyExtends_of_idealPowerDesc`, if `A` is moreover `I`-adically
complete, then `(F_n)` is the completion of a coherent `𝒪_U`-module. -/
theorem essImage_completionFunctor_of_idealPowerDesc [IsAdicComplete S.I S.A]
    (h3 : HasFiniteLowDegreeCohomology S F) :
    (completionFunctor S.U.toScheme (idealOnOpen S)).essImage F :=
  essImage_completionFunctor_of_isoDirectSum S F
    (isMittagLeffler_globalSectionsSystem_of_idealPowerDesc S F g hg hdesc h3.2)
    (limitTopology_eq_adicModuleTopology_of_idealPowerDesc S F g hg hdesc h3.1) h3.1
    (exists_isoDirectSum_idealPowerSub_of_idealPowerDesc S F g hdesc)

end Decomposition

