/-!
# Stacks 0EIF: realizing formal sections on the complement of a smaller vanishing locus

Let `I` and `𝔞` be ideals of a Noetherian ring `A` which is `I`-adically complete, let
`U = Spec(A) ∖ V(𝔞)` and let `F ≅ M̃|_U` for a finite `A`-module `M`. Suppose `J₀ ⊆ 𝔞` is an ideal
as in the conclusion of Stacks 0EFL for `M`, `𝔞` and `s = 1`, generated by `g₁, …, g_r`, and let
`W = U ∖ V(J₀)`. This file proves that every formal section of `F` is the image of one section of
`F` over `W`, which is the realization half of Stacks 0EIF.

The argument replaces the source's comparison of three completed localization triangles by the
extended Čech complex `C^•(g; M)` and its termwise `I`-adic completion `C^•(g; M)^∧`:

* the termwise completion map `C^•(g; M) ⟶ C^•(g; M)^∧` is a derived completion
  (`Stacks.LocalCohomology.isIso_adicCompletionFunctor_map_toTermwiseAdicCompletion`, with Stacks
  0EEU underneath), so Stacks 0EFL makes it an isomorphism on `H⁰` and `H¹`
  (`Stacks.Algebraization.IsAlgebraizationIdeal.isIso_homologyMap_of_cech`);
* by the five lemma on degree-one cocycles, compatible degree-one cocycles of the `C^•(g; M/IⁿM)`
  then come from one degree-one cocycle of `C^•(g; M)`
  (`Stacks.LocalCohomology.exists_cycles_lift_of_isIso_homologyMap`);
* degree-one cocycles of `C^•(g; N)` are the sections of `Ñ|_U` over `W`, naturally in `N`, and
  the realization follows by `Stacks.Algebraization.exists_comparisonAt_eq_of_surjective_lift`.

## Main results

* `Stacks.Algebraization.surjective_limitLift_cycles_of_isAlgebraizationIdeal` — compatible
  families of degree-one cocycles of the `C^•(g; M/IⁿM)` lift to `C^•(g; M)`.
* `Stacks.Algebraization.serreOneAlternativeComparison` — Stacks 0EIF in the quantified form
  `Stacks.Algebraization.SerreOneAlternativeComparison`, without the standing assumption
  `I ⊆ 𝔞`; the form with it is
  `Stacks.Algebraization.isIso_comparisonMap_of_formalSectionsHypotheses`.

## References

* [Stacks Project, Tag 0EIF](https://stacks.math.columbia.edu/tag/0EIF)
* [Stacks Project, Tag 0EFL](https://stacks.math.columbia.edu/tag/0EFL)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace Stacks.Algebraization

open Stacks.LocalCohomology

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {I a : Ideal A}

/-- The functor `N ↦ Z¹(C^•(g; N))` of degree-one Čech cocycles, valued in abelian groups. -/
abbrev cechCyclesOneFunctor {r : ℕ} (g : Fin r → A) : ModuleCat.{u} A ⥤ Ab.{u} :=
  extendedCechFunctor.{0} g ⋙ HomologicalComplex.cyclesFunctor (ModuleCat.{u} A)
    (ComplexShape.up ℤ) 1 ⋙ forget₂ (ModuleCat.{u} A) Ab.{u}

/-- **Compatible degree-one cocycles lift, under the conclusion of Stacks 0EFL.** Let `A` be
`I`-adically complete, `M` finite, `J₀` an ideal as in the conclusion of Stacks 0EFL for `M`, `𝔞`
and `s = 1`, and `g` generators of `J₀`. Then every compatible family of degree-one cocycles of
the Čech complexes `C^•(g; M/IⁿM)` comes from one degree-one cocycle of `C^•(g; M)`. -/
theorem surjective_limitLift_cycles_of_isAlgebraizationIdeal (hA : IsAdicComplete I A)
    {M : Type u} [AddCommGroup M] [Module A M] [Module.Finite A M] {J₀ : Ideal A}
    (hJ₀ : IsAlgebraizationIdeal (M := M) I a 1 J₀) {r : ℕ} (g : Fin r → A)
    (hg : Ideal.span (Set.range g) = J₀) :
    Function.Surjective (ConcreteCategory.hom
      (limit.lift (idealPowerQuotientTower.{u, u} I (ModuleCat.of A M) ⋙ cechCyclesOneFunctor g)
        ((cechCyclesOneFunctor g).mapCone
          (idealPowerQuotientCone.{u, u} I (ModuleCat.of A M))))) := by
  have := hA
  let MC := ModuleCat.of A M
  let K := extendedCechComplex.{0} g MC
  let φ := HomologicalComplex.toTermwiseAdicCompletion I K
  let φQ : (extendedCechObjectFunctor.{0} g).obj (ModuleCat.of A M) ⟶
      DerivedCategory.Q.obj (HomologicalComplex.termwiseAdicCompletion I K) :=
    DerivedCategory.Q.map φ
  have : IsIso ((adicCompletionFunctor A I I.fg_of_isNoetherianRing).map φQ) :=
    isIso_adicCompletionFunctor_map_toTermwiseAdicCompletion I g MC I.fg_of_isNoetherianRing
  have hY := isDerivedComplete_termwiseAdicCompletion I g MC I.fg_of_isNoetherianRing
  have hH : ∀ i : ℤ, i ≤ 1 → IsIso (HomologicalComplex.homologyMap φ i) := fun i hi =>
    (NatIso.isIso_map_iff (DerivedCategory.homologyFunctorFactors (ModuleCat.{u} A) i) φ).1
      (IsAlgebraizationIdeal.isIso_homologyMap_of_cech a hJ₀ J₀ le_rfl hJ₀.zeroLocus_inter g hg
        φQ hY i hi)
  have : IsIso (HomologicalComplex.homologyMap φ 0) := hH 0 (by omega)
  have : IsIso (HomologicalComplex.homologyMap φ 1) := hH 1 le_rfl
  have : IsAdicComplete I MC :=
    AdicCompletion.isAdicComplete_of_finite_of_isNoetherianRing I M
  intro s
  let L := idealPowerQuotientTower.{u, u} I MC ⋙ cechCyclesOneFunctor g
  let z : ∀ n : ℕ, ((cechQuotientTower g I MC).obj (op n)).cycles 1 := fun n =>
    ConcreteCategory.hom (limit.π L (op n)) s
  obtain ⟨w, hw⟩ := exists_cycles_lift_of_isIso_homologyMap g I MC z fun m n h =>
    congrArg (fun f : limit L ⟶ L.obj (op m) => ConcreteCategory.hom f s) (limit.w L (homOfLE h).op)
  let w' : ToType ((cechCyclesOneFunctor g).obj MC) := w
  refine ⟨w', Concrete.limit_ext _ _ _ fun n => ?_⟩
  induction n using Opposite.rec with | op n => ?_
  show ConcreteCategory.hom (limit.lift L ((cechCyclesOneFunctor g).mapCone
    (idealPowerQuotientCone.{u, u} I MC)) ≫ limit.π L (op n)) w' = _
  rw [limit.lift_π]
  exact hw n

/-- **Stacks 0EIF, for every Noetherian ring, every pair of ideals and every coherent module**,
in the quantified form `Stacks.Algebraization.SerreOneAlternativeComparison` that Stacks 0EG2
consumes: if `B` is `J`-adically complete and has a dualizing complex, every associated point
`x ∉ V(J)` of `G` whose closure meets `V(J)` outside `V(𝔟)` has
`dim(𝒪_{closure {x}, z}) > cd(B, J) + 1` at every `z ∈ closure {x} ∩ V(𝔟)`, and either `G` is
`(S₁)` on `U ∖ V(J)` or `V(𝔟)` has dimension at most `2`
(`Stacks.Algebraization.FormalSectionsHypotheses`), then
`colim_V H⁰(V, G) ⟶ lim_n H⁰(U, G / JⁿG)` is an isomorphism.

Unlike `Stacks.Algebraization.isIso_comparisonMap_of_formalSectionsHypotheses`, the source's
standing assumption `J ⊆ 𝔟` is not needed, which is what the quantified form asks for.
Injectivity is `Stacks.Algebraization.mono_comparisonMap`; for surjectivity, write `G ≅ M̃|_U`
(Stacks 0BK0), take the ideal `J₀ ⊆ 𝔟` of Stacks 0EFL for `s = 1` with generators `g`, and
realize every formal section on `U ∖ V(J₀)` through the degree-one cocycles of the Čech
complexes `C^•(g; M/JⁿM)`. -/
theorem serreOneAlternativeComparison : SerreOneAlternativeComparison.{u} := by
  intro A _ _ I a F hF h
  have := hF
  obtain ⟨M, hM, ⟨e⟩⟩ := exists_finiteModule_iso_restrict_tilde A a F
  let e' : F ≅ (Scheme.Modules.restrictFunctor (complementZeroLocus A a).ι).obj
      ((tilde.functor (CommRingCat.of A)).obj M) := e
  obtain ⟨J₀, hJ₀⟩ := exists_isAlgebraizationIdeal_of_formalSectionsHypotheses e h
  obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    J₀.fg_of_isNoetherianRing
  change Ideal.span (Set.range g) = J₀ at hg
  refine (isIso_comparisonMap_iff_realized A I a F).2 fun s =>
    exists_comparisonAt_eq_of_surjective_lift e' _ (cechCyclesOneFunctor g)
      (sectionsComplementCechCyclesIso hJ₀.le hg) (fun x hx => ?_)
      (surjective_limitLift_cycles_of_isAlgebraizationIdeal h.adicComplete hJ₀ g hg) s
  show ¬ J₀ ≤ x.1.asIdeal
  intro hJ
  have hmem : x.1 ∈ PrimeSpectrum.zeroLocus (J₀ : Set A) ∩
      PrimeSpectrum.zeroLocus (I : Set A) :=
    ⟨(PrimeSpectrum.mem_zeroLocus _ _).2 hJ, (PrimeSpectrum.mem_zeroLocus _ _).2 hx⟩
  rw [hJ₀.zeroLocus_inter] at hmem
  exact x.2 hmem.1

end Stacks.Algebraization

end
