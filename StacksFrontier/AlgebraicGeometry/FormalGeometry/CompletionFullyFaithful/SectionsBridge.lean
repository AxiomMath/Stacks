module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFullyFaithful.PrincipalComplete
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.ComplementFormalFunctions
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.FiniteModuleModel
public import StacksFrontier.AlgebraicGeometry.PuncturedSpectrumPicard.PrincipalPowerSubscheme
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.PushforwardCoherence.FirstLocalCohomologyFiniteness
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFunctor.NeighbourhoodHoms
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFunctor.FullyFaithful
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CoherentAdicSystem.ModuleTower

/-!
# From the module-level theorem on formal functions to the sheaf-level one

Let `A` be a Noetherian ring, let `f ∈ 𝔞 ⊆ A` and let `U = Spec(A) ∖ V(𝔞)`. Stacks 0EII is
stated for a finite `A`-module `M` as the bijectivity of
`Γ(U, M̃) ⟶ lim_n Γ(U, (M/fⁿM)̃)`, while the completion functor of Stacks 0880 compares
`Γ(U, ℱ)` with `lim_n Γ(U, ℱ / ℐⁿ ℱ)` for the ideal sheaf `ℐ = f 𝒪_U`. This file identifies the
two, so that Stacks 0EII becomes an instance of the theorem on formal functions in degree zero
for the sheaf `ℱ = M̃|_U`.

## Main results

* `Stacks.Algebraization.idealSheafNearVanishing_span_singleton` — the ideal sheaf `(f)𝒪_U` of
  `Stacks.Algebraization.complementPrincipalIdealSheaf` is the ideal sheaf
  `Stacks.Algebraization.idealSheafNearVanishing` at the principal ideal `(f)`.

## References

* [Stacks Project, Tag 0EII](https://stacks.math.columbia.edu/tag/0EII)
* [Stacks Project, Tag 0880](https://stacks.math.columbia.edu/tag/0880)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
open Stacks.LocalCohomology

universe u

namespace Stacks.Algebraization

variable (A : Type u) [CommRing A] [IsNoetherianRing A] (a : Ideal A) (f : A)

omit [IsNoetherianRing A] in
/-- The two spellings of the ideal sheaf `(f)𝒪_U` on `U = Spec(A) ∖ V(𝔞)` agree: extending the
principal ideal `(f)` gives the ideal generated by the restriction of `f`. -/
public theorem idealSheafNearVanishing_span_singleton :
    idealSheafNearVanishing A (Ideal.span {f}) a = complementPrincipalIdealSheaf A a f := by
  unfold idealSheafNearVanishing complementPrincipalIdealSheaf
    Stacks.Cohomology.FormalFunctions.baseIdealSheaf Stacks.Cohomology.FormalFunctions.baseIdeal
  rw [Ideal.map_span, Set.image_singleton]

/-- The data of Stacks 0EHC attached to `f ∈ 𝔞`: the ring `A` with the nested ideals
`(f) ⊆ 𝔞`. -/
public def principalSituation (hf : f ∈ a) : AlgebraizationSituation.{u} where
  A := A
  I := Ideal.span {f}
  a := a
  I_le_a := Ideal.span_le.2 (Set.singleton_subset_iff.2 hf)

variable {A a f}

/-- The ideal sheaf of the situation attached to `f ∈ 𝔞` is `(f)𝒪_U`. -/
public theorem idealOnOpen_principalSituation (hf : f ∈ a) :
    idealOnOpen (principalSituation A a f hf) = complementPrincipalIdealSheaf A a f := by
  rw [← idealSheafNearVanishing_span_singleton A a f]
  exact (Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_comap A (Ideal.span {f})
    (complementZeroLocus A a).ι).symm

/-- The restricted sheafification of the situation attached to `f ∈ 𝔞` is `complementTilde`. -/
public theorem restrictedTildeFunctor_obj_principalSituation (hf : f ∈ a)
    (M : ModuleCat.{u} A) :
    (restrictedTildeFunctor (principalSituation A a f hf)).obj M = complementTilde A a M :=
  rfl

/-! ### The terms of the completion of `M̃|_U` -/

/-- The functor `N ↦ Ñ|_U` attached to `f ∈ 𝔞`. -/
public abbrev principalTildeFunctor (hf : f ∈ a) :
    ModuleCat.{u} A ⥤ (complementZeroLocus A a : Scheme).Modules :=
  restrictedTildeFunctor (principalSituation A a f hf)

/-- The ideal sheaf `(f)𝒪_U` attached to `f ∈ 𝔞`. -/
public abbrev principalIdealOnOpen (hf : f ∈ a) :
    (complementZeroLocus A a : Scheme).IdealSheafData :=
  idealOnOpen (principalSituation A a f hf)

/-- The ideal sheaf `(f)𝒪_U` of the situation attached to `f ∈ 𝔞`, in the spelling the
completion functor of Stacks 0EKS is stated with. -/
public theorem principalIdealOnOpen_eq (hf : f ∈ a) :
    principalIdealOnOpen hf = complementPrincipalIdealSheaf A a f :=
  idealOnOpen_principalSituation hf

/-- `M̃|_U` as a coherent module on `U = Spec(A) ∖ V(𝔞)`. -/
public def coherentPrincipalTilde (hf : f ∈ a) (M : ModuleCat.{u} A) [Module.Finite A M] :
    AlgebraicGeometry.SheafOfModules.CoherentModules
      (complementZeroLocus A a : Scheme).ringCatSheaf :=
  ⟨(principalTildeFunctor hf).obj M,
    restrictedTildeFunctor_obj_principalSituation hf M ▸ isCoherent_complementTilde A a M⟩

/-- The chosen identification `(M̃|_U) / (f)ⁿ (M̃|_U) ≅ (M/fⁿM)̃|_U`. -/
public noncomputable def quotIso (hf : f ∈ a) (M : ModuleCat.{u} A) (n : ℕ) :
    idealPowerQuotient (principalIdealOnOpen hf) n ((principalTildeFunctor hf).obj M) ≅
      (principalTildeFunctor hf).obj (ComplementTower.quotientModule A f M n) :=
  (restrictedTilde_idealPowerQuotient_iso (principalSituation A a f hf) M n).choose

/-- `quotIso` intertwines the two quotient projections. -/
public theorem quotIso_spec (hf : f ∈ a) (M : ModuleCat.{u} A) (n : ℕ) :
    cokernel.π (idealPowerMultiple (principalIdealOnOpen hf) n
          ((principalTildeFunctor hf).obj M)).ι ≫ (quotIso hf M n).hom =
      (principalTildeFunctor hf).map (ComplementTower.quotientMap A f M n) :=
  (restrictedTilde_idealPowerQuotient_iso (principalSituation A a f hf) M n).choose_spec

omit [IsNoetherianRing A] in
/-- Reducing `M` modulo `fⁿ⁺¹` and then modulo `fⁿ` is reducing modulo `fⁿ`. -/
public theorem quotientMap_comp_quotientTransition (M : ModuleCat.{u} A) (n : ℕ) :
    ComplementTower.quotientMap A f M (n + 1) ≫ ComplementTower.quotientTransition A f M n =
      ComplementTower.quotientMap A f M n := rfl

/-- `quotIso` intertwines the transitions of the ideal-power tower with the sheafifications of
the module transitions. -/
public theorem quotIso_naturality (hf : f ∈ a) (M : ModuleCat.{u} A) (n : ℕ) :
    (adicQuotientSystem (principalIdealOnOpen hf) ((principalTildeFunctor hf).obj M)).map
          (homOfLE (Nat.le_succ (n + 1))).op ≫ (quotIso hf M (n + 1)).hom =
      (quotIso hf M (n + 2)).hom ≫
        (principalTildeFunctor hf).map (ComplementTower.quotientTransition A f M (n + 1)) := by
  refine (cancel_epi (cokernel.π (C := (complementZeroLocus A a : Scheme).Modules)
    (idealPowerMultiple (principalIdealOnOpen hf) (n + 2)
      ((principalTildeFunctor hf).obj M)).ι)).1 ?_
  have hL : cokernel.π (C := (complementZeroLocus A a : Scheme).Modules)
        (idealPowerMultiple (principalIdealOnOpen hf) (n + 2)
          ((principalTildeFunctor hf).obj M)).ι ≫
        ((adicQuotientSystem (principalIdealOnOpen hf)
            ((principalTildeFunctor hf).obj M)).map (homOfLE (Nat.le_succ (n + 1))).op ≫
          (quotIso hf M (n + 1)).hom) =
      (principalTildeFunctor hf).map (ComplementTower.quotientMap A f M (n + 1)) :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (fun k => k ≫ (quotIso hf M (n + 1)).hom)
          ((adicQuotientCone (principalIdealOnOpen hf)
            ((principalTildeFunctor hf).obj M)).w
              (homOfLE (Nat.le_succ (n + 1))).op)).trans (quotIso_spec hf M (n + 1)))
  have hR : cokernel.π (C := (complementZeroLocus A a : Scheme).Modules)
        (idealPowerMultiple (principalIdealOnOpen hf) (n + 2)
          ((principalTildeFunctor hf).obj M)).ι ≫
        ((quotIso hf M (n + 2)).hom ≫ (principalTildeFunctor hf).map
          (ComplementTower.quotientTransition A f M (n + 1))) =
      (principalTildeFunctor hf).map (ComplementTower.quotientMap A f M (n + 1)) :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (fun k => k ≫ (principalTildeFunctor hf).map
            (ComplementTower.quotientTransition A f M (n + 1)))
          (quotIso_spec hf M (n + 2))).trans
        (((principalTildeFunctor hf).map_comp _ _).symm.trans
          (congrArg (principalTildeFunctor hf).map
            (quotientMap_comp_quotientTransition M (n + 1)))))
  exact hL.trans hR.symm

/-- The `n`-th term of the completion of `M̃|_U` along `(f)𝒪_U` is `(M/fⁿ⁺¹M)̃|_U`. -/
public noncomputable def completionTermIso (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M] (n : ℕ) :
    ((completionFunctor (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)).obj
        (coherentPrincipalTilde hf M)).obj.obj (op n) ≅
      (principalTildeFunctor hf).obj (ComplementTower.quotientModule A f M (n + 1)) :=
  NeighbourhoodHoms.towerIso (principalIdealOnOpen hf) (coherentPrincipalTilde hf M) n ≪≫
    quotIso hf M (n + 1)

/-- The completion projection, read through `completionTermIso`, is the sheafification of the
module projection `M ⟶ M/fⁿ⁺¹M`. -/
public theorem completionProjection_completionTermIso (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M] (n : ℕ) :
    completionProjection (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)
          (coherentPrincipalTilde hf M) n ≫ (completionTermIso hf M n).hom =
      (principalTildeFunctor hf).map (ComplementTower.quotientMap A f M (n + 1)) :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (fun k => k ≫ (quotIso hf M (n + 1)).hom)
        (NeighbourhoodHoms.completionProjection_comp_towerIso (principalIdealOnOpen hf)
          (coherentPrincipalTilde hf M) n)).trans (quotIso_spec hf M (n + 1)))

/-- The transitions of the completion, read through `completionTermIso`, are the sheafifications
of the module transitions `M/fⁿ⁺²M ⟶ M/fⁿ⁺¹M`. -/
public theorem completionTermIso_naturality (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M] (n : ℕ) :
    ((completionFunctor (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)).obj
          (coherentPrincipalTilde hf M)).obj.map (homOfLE (Nat.le_succ n)).op ≫
        (completionTermIso hf M n).hom =
      (completionTermIso hf M (n + 1)).hom ≫
        (principalTildeFunctor hf).map (ComplementTower.quotientTransition A f M (n + 1)) :=
  (congrArg (fun k => ((completionFunctor (complementZeroLocus A a : Scheme)
        (principalIdealOnOpen hf)).obj (coherentPrincipalTilde hf M)).obj.map
          (homOfLE (Nat.le_succ n)).op ≫ k) (Iso.trans_hom _ _)).trans
    ((Category.assoc _ _ _).symm.trans
      ((congrArg (fun k => k ≫ (quotIso hf M (n + 1)).hom)
          (NeighbourhoodHoms.towerIso_naturality (principalIdealOnOpen hf)
            (coherentPrincipalTilde hf M) (Nat.le_succ n))).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (fun k => (NeighbourhoodHoms.towerIso (principalIdealOnOpen hf)
                (coherentPrincipalTilde hf M) (n + 1)).hom ≫ k)
              (quotIso_naturality hf M n)).trans
            ((Category.assoc _ _ _).symm.trans
              (congrArg (fun k => k ≫ (principalTildeFunctor hf).map
                  (ComplementTower.quotientTransition A f M (n + 1)))
                (Iso.trans_hom _ _).symm))))))

/-! ### Global sections -/

variable (a) in
/-- Global sections on `U` of `Ñ|_U` are the sections of `Ñ` over the open `U`. -/
public noncomputable def complementSectionsEquiv (N : ModuleCat.{u} A) :
    complementGlobalSections A a (complementTilde A a N) ≅ ComplementTower.sections A a N :=
  (sectionsOnAffineComplementIso a).app (associatedSheaf A N)

omit [IsNoetherianRing A] in
variable (a) in
/-- Naturality of `complementSectionsEquiv`, elementwise. -/
public theorem complementSectionsEquiv_naturality {N N' : ModuleCat.{u} A} (φ : N ⟶ N')
    (x : complementGlobalSections A a (complementTilde A a N)) :
    (complementSectionsEquiv a N').hom
        ((complementGlobalSectionsFunctor A a).map
          ((restrictFunctor (complementZeroLocus A a).ι).map
            ((tilde.functor (CommRingCat.of A)).map φ)) x) =
      (sectionsOnAffineComplement A a).map ((tilde.functor (CommRingCat.of A)).map φ)
        ((complementSectionsEquiv a N).hom x) :=
  ConcreteCategory.congr_hom
    ((sectionsOnAffineComplementIso a).hom.naturality ((tilde.functor (CommRingCat.of A)).map φ)) x

omit [IsNoetherianRing A] in
/-- The map on sections of `M̃` over `U` induced by `M ⟶ M/fⁿM`. -/
public theorem sectionQuotientMap_eq (M : ModuleCat.{u} A) (n : ℕ) :
    ComplementTower.sectionQuotientMap A a f M n =
      (sectionsOnAffineComplement A a).map
        ((tilde.functor (CommRingCat.of A)).map (ComplementTower.quotientMap A f M n)) :=
  rfl

omit [IsNoetherianRing A] in
/-- The map on sections of `M̃` over `U` induced by `M/fⁿ⁺¹M ⟶ M/fⁿM`. -/
public theorem sectionsTransition_eq' (M : ModuleCat.{u} A) (n : ℕ) :
    ComplementTower.sectionsTransition A a f M n =
      (sectionsOnAffineComplement A a).map
        ((tilde.functor (CommRingCat.of A)).map (ComplementTower.quotientTransition A f M n)) :=
  rfl

/-! ### The comparison of the two limits -/

/-- Global sections of the `n`-th term of the completion of `M̃|_U`, identified with the
sections of `(M/fⁿ⁺¹M)̃` over `U`. -/
public noncomputable def gammaCompare (hf : f ∈ a) (M : ModuleCat.{u} A) [Module.Finite A M]
    (n : ℕ) :
    complementGlobalSections A a
        (((completionFunctor (complementZeroLocus A a : Scheme)
          (principalIdealOnOpen hf)).obj (coherentPrincipalTilde hf M)).obj.obj (op n)) ≅
      ComplementTower.sectionsModPower A a f M (n + 1) :=
  (complementGlobalSectionsFunctor A a).mapIso (completionTermIso hf M n) ≪≫
    complementSectionsEquiv a (ComplementTower.quotientModule A f M (n + 1))

/-- Transport along `complementSectionsEquiv` of a global-sections identity coming from a
commuting square `p ≫ e = ψ ≫ (M ⟶ N)̃`. -/
private theorem sectionsEquiv_map_apply_eq {A : Type u} [CommRing A] (a : Ideal A)
    {X Y : (complementZeroLocus A a : Scheme).Modules}
    {N N' : ModuleCat.{u} A} (φ : N ⟶ N') (p : X ⟶ Y) (e : Y ⟶ complementTilde A a N')
    (ψ : X ⟶ complementTilde A a N)
    (h : p ≫ e = ψ ≫ (restrictFunctor (complementZeroLocus A a).ι).map
      ((tilde.functor (CommRingCat.of A)).map φ))
    (x : complementGlobalSections A a X) :
    (complementSectionsEquiv a N').hom
        ((complementGlobalSectionsFunctor A a).map e
          ((complementGlobalSectionsFunctor A a).map p x)) =
      (sectionsOnAffineComplement A a).map ((tilde.functor (CommRingCat.of A)).map φ)
        ((complementSectionsEquiv a N).hom
          ((complementGlobalSectionsFunctor A a).map ψ x)) :=
  (congrArg (complementSectionsEquiv a N').hom (ConcreteCategory.congr_hom
    (((complementGlobalSectionsFunctor A a).map_comp _ _).symm.trans
      ((congrArg (complementGlobalSectionsFunctor A a).map h).trans
        ((complementGlobalSectionsFunctor A a).map_comp _ _))) x)).trans
    (complementSectionsEquiv_naturality a φ _)

/-- `gammaCompare` carries the global sections of the completion projection to the reduction
map on sections. -/
public theorem gammaCompare_completionProjection (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M] (n : ℕ)
    (x : complementGlobalSections A a (complementTilde A a M)) :
    (gammaCompare hf M n).hom
        ((complementGlobalSectionsFunctor A a).map
          (completionProjection (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)
            (coherentPrincipalTilde hf M) n) x) =
      ComplementTower.sectionQuotientMap A a f M (n + 1)
        ((complementSectionsEquiv a M).hom x) := by
  exact sectionsEquiv_map_apply_eq a (ComplementTower.quotientMap A f M (n + 1)) _
    (completionTermIso hf M n).hom 
    (𝟙 (complementTilde A a M))
    ((completionProjection_completionTermIso hf M n).trans (Category.id_comp _).symm) x

/-- `gammaCompare` carries the global sections of the completion transitions to the transition
maps on sections. -/
public theorem gammaCompare_transition (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M] (n : ℕ)
    (y : complementGlobalSections A a
      (((completionFunctor (complementZeroLocus A a : Scheme)
        (principalIdealOnOpen hf)).obj (coherentPrincipalTilde hf M)).obj.obj (op (n + 1)))) :
    (gammaCompare hf M n).hom
        ((complementGlobalSectionsFunctor A a).map
          (((completionFunctor (complementZeroLocus A a : Scheme)
            (principalIdealOnOpen hf)).obj
              (coherentPrincipalTilde hf M)).obj.map (homOfLE (Nat.le_succ n)).op) y) =
      ComplementTower.sectionsTransition A a f M (n + 1) ((gammaCompare hf M (n + 1)).hom y) :=
  sectionsEquiv_map_apply_eq a (ComplementTower.quotientTransition A f M (n + 1)) _
    (completionTermIso hf M n).hom (completionTermIso hf M (n + 1)).hom
    (completionTermIso_naturality hf M n) y

/-! ### Stacks 0EII as the theorem on formal functions in degree zero -/

/-- The `n`-th component of the comparison into the limit of global sections is the global
sections of the `n`-th completion projection. -/
public theorem moduleLimitTowerEquiv_globalSectionsToLimit (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M]
    (x : complementGlobalSections A a (complementTilde A a M)) (n : ℕ) :
    ((Stacks.Coherent.moduleLimitTowerEquiv (Stacks.Coherent.globalSectionsSystem
          ((completionFunctor (complementZeroLocus A a : Scheme)
            (principalIdealOnOpen hf)).obj (coherentPrincipalTilde hf M))))
        (ConcreteCategory.hom (globalSectionsToLimit (principalIdealOnOpen hf)
          (coherentPrincipalTilde hf M)) x)).1 n =
      (complementGlobalSectionsFunctor A a).map
        (completionProjection (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)
          (coherentPrincipalTilde hf M) n) x :=
  (Stacks.Coherent.moduleLimitTowerEquiv_apply_coe _ _ n).trans
    (ConcreteCategory.congr_hom (globalSectionsToLimit_π (principalIdealOnOpen hf)
      (coherentPrincipalTilde hf M) (op n)) x)

/-- If the comparison `Γ(U, M̃) ⟶ lim_n Γ(U, (M/fⁿM)̃)` is injective, a global section of
`M̃|_U` is determined by its images under the completion projections. -/
public theorem eq_of_forall_completionProjection_eq (hf : f ∈ a) (M : ModuleCat.{u} A)
    [Module.Finite A M] (hinj : Function.Injective (ComplementTower.sectionsToLimit A a f M))
    {x y : complementGlobalSections A a (complementTilde A a M)}
    (h : ∀ n : ℕ,
      (complementGlobalSectionsFunctor A a).map
          (completionProjection (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)
            (coherentPrincipalTilde hf M) n) x =
        (complementGlobalSectionsFunctor A a).map
          (completionProjection (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)
            (coherentPrincipalTilde hf M) n) y) :
    x = y := by
  have hM : Function.Bijective (complementSectionsEquiv a M).hom :=
    ConcreteCategory.bijective_of_isIso _
  have hq : ∀ n : ℕ, ComplementTower.sectionQuotientMap A a f M (n + 1)
        ((complementSectionsEquiv a M).hom x) =
      ComplementTower.sectionQuotientMap A a f M (n + 1)
        ((complementSectionsEquiv a M).hom y) := fun n =>
    (gammaCompare_completionProjection hf M n x).symm.trans
      ((congrArg (gammaCompare hf M n).hom (h n)).trans
        (gammaCompare_completionProjection hf M n y))
  refine hM.1 (hinj (Subtype.ext (funext fun n => ?_)))
  cases n with
  | zero =>
    exact ((ComplementTower.sectionsToLimit A a f M
        ((complementSectionsEquiv a M).hom x)).2 0).symm.trans
      ((congrArg (ComplementTower.sectionsTransition A a f M 0) (hq 0)).trans
        ((ComplementTower.sectionsToLimit A a f M
          ((complementSectionsEquiv a M).hom y)).2 0))
  | succ k => exact hq k

/-- **Stacks 0EII read as the theorem on formal functions in degree zero.** If the comparison
`Γ(U, M̃) ⟶ lim_n Γ(U, (M/fⁿM)̃)` of Stacks 0EII is bijective, then the comparison
`Γ(U, ℱ) ⟶ lim_n Γ(U, ℱ/(f)ⁿℱ)` of the completion functor is an isomorphism for
`ℱ = M̃|_U`. -/
public theorem isIso_globalSectionsToLimit_coherentPrincipalTilde (hf : f ∈ a)
    (M : ModuleCat.{u} A) [Module.Finite A M]
    (hbij : Function.Bijective (ComplementTower.sectionsToLimit A a f M)) :
    IsIso (globalSectionsToLimit (principalIdealOnOpen hf) (coherentPrincipalTilde hf M)) := by
  refine (ConcreteCategory.isIso_iff_bijective _).2 ?_
  refine (Function.Bijective.of_comp_iff'
    (Stacks.Coherent.moduleLimitTowerEquiv (Stacks.Coherent.globalSectionsSystem
      ((completionFunctor (complementZeroLocus A a : Scheme)
        (principalIdealOnOpen hf)).obj (coherentPrincipalTilde hf M)))).bijective _).1 ?_
  have hM : Function.Bijective (complementSectionsEquiv a M).hom :=
    ConcreteCategory.bijective_of_isIso _
  constructor
  · intro x y hxy
    exact eq_of_forall_completionProjection_eq hf M hbij.1 fun n =>
      (moduleLimitTowerEquiv_globalSectionsToLimit hf M x n).symm.trans
        ((congrArg (fun z => z.1 n) hxy).trans
          (moduleLimitTowerEquiv_globalSectionsToLimit hf M y n))
  · intro t
    have hcomp : ∀ n : ℕ, ComplementTower.sectionsTransition A a f M (n + 1)
          ((gammaCompare hf M (n + 1)).hom (t.1 (n + 1))) =
        (gammaCompare hf M n).hom (t.1 n) := fun n =>
      (gammaCompare_transition hf M n (t.1 (n + 1))).symm.trans
        (congrArg (gammaCompare hf M n).hom (t.2 n))
    let u : ∀ n : ℕ, ComplementTower.sectionsModPower A a f M n := fun n =>
      match n with
      | 0 => ComplementTower.sectionsTransition A a f M 0 ((gammaCompare hf M 0).hom (t.1 0))
      | (k + 1) => (gammaCompare hf M k).hom (t.1 k)
    have hu : ∀ n : ℕ, ComplementTower.sectionsTransition A a f M n (u (n + 1)) = u n
      | 0 => rfl
      | k + 1 => hcomp k
    obtain ⟨z, hz⟩ := hbij.2 ⟨u, hu⟩
    obtain ⟨x, hx⟩ := hM.2 z
    refine ⟨x, Subtype.ext (funext fun n => ?_)⟩
    have key : (gammaCompare hf M n).hom
          ((complementGlobalSectionsFunctor A a).map
            (completionProjection (complementZeroLocus A a : Scheme) (principalIdealOnOpen hf)
              (coherentPrincipalTilde hf M) n) x) =
        (gammaCompare hf M n).hom (t.1 n) := by
      rw [gammaCompare_completionProjection hf M n x, hx]
      exact congrArg (fun w => w.1 (n + 1)) hz
    exact (moduleLimitTowerEquiv_globalSectionsToLimit hf M x n).trans
      ((ConcreteCategory.bijective_of_isIso (gammaCompare hf M n).hom).1 key)

end Stacks.Algebraization

