-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TopologicalSpace
open scoped AlgebraicGeometry

universe u

namespace Stacks.Algebraization

open Stacks.LocalCohomology Stacks.SheafOfModules.InternalHom

section Pair

variable {X : Scheme.{u}} [IsLocallyNoetherian X] (I : X.IdealSheafData)
  (G F : AlgebraicGeometry.SheafOfModules.CoherentModules X.ringCatSheaf)

/-- **The completion functor is bijective on `G ⟶ F` exactly when the theorem on formal functions
in degree zero holds for `SheafHom(G, F)`.** -/
public theorem bijective_completionFunctor_map_iff_isIso_globalSectionsToLimit :
    Function.Bijective ((completionFunctor X I).map :
        (G ⟶ F) → ((completionFunctor X I).obj G ⟶ (completionFunctor X I).obj F)) ↔
      IsIso (globalSectionsToLimit I (internalHomCoherent X G F)) := by
  refine ⟨fun hbij => ?_, completionFunctor_map_bijective I G F⟩
  -- Read the chain of bijections of Stacks 0883 backwards.
  have hmap : (fun g : G ⟶ F =>
      completionHomLimitEquiv (I := I) G ((completionFunctor X I).obj F)
        (internalHomSectionsTopEquiv (coherentObj G)
          (limit (C := X.Modules) ((completionFunctor X I).obj F).obj)
          ((completionToLimit X I (internalHomCoherent X G F) ≫
              completedSheafHomComparison (I := I) G F).val.app (op (⊤ : X.Opens))
            (internalHomSectionsTopMapAddEquiv (coherentObj G) (coherentObj F) g.hom)))) =
      ((completionFunctor X I).map :
        (G ⟶ F) → ((completionFunctor X I).obj G ⟶ (completionFunctor X I).obj F)) :=
    funext fun g => completionFunctor_map_eq I G F g
  rw [← hmap] at hbij
  have hhom : Function.Bijective (fun g : G ⟶ F => g.hom) :=
    ⟨fun _ _ e => ObjectProperty.hom_ext _ e, fun g => ⟨ObjectProperty.homMk g, rfl⟩⟩
  have hsrc : Function.Bijective (fun g : G ⟶ F =>
      internalHomSectionsTopMapAddEquiv (coherentObj G) (coherentObj F) g.hom) :=
    (internalHomSectionsTopMapAddEquiv (coherentObj G) (coherentObj F)).bijective.comp hhom
  have htgt : Function.Bijective (fun y =>
      completionHomLimitEquiv (I := I) G ((completionFunctor X I).obj F)
        (internalHomSectionsTopEquiv (coherentObj G)
          (limit (C := X.Modules) ((completionFunctor X I).obj F).obj) y)) :=
    (completionHomLimitEquiv (I := I) G ((completionFunctor X I).obj F)).bijective.comp
      (internalHomSectionsTopEquiv (coherentObj G)
        (limit (C := X.Modules) ((completionFunctor X I).obj F).obj)).bijective
  have hmid := (htgt.of_comp_iff' _).1 hbij
  have hcmpBij := (Function.Bijective.of_comp_iff _ hsrc).1 hmid
  -- The composite of the map into the limit with the comparison of Stacks 0882 is therefore an
  -- isomorphism on global sections; the comparison alone is one, so the map into the limit is.
  have hcomposite : IsIso ((completionToLimit X I (internalHomCoherent X G F) ≫
      completedSheafHomComparison (I := I) G F).val.app (op (⊤ : X.Opens))) :=
    (ConcreteCategory.isIso_iff_bijective _).2 hcmpBij
  have hcmpApp : IsIso ((completedSheafHomComparison (I := I) G F).val.app
      (op (⊤ : X.Opens))) :=
    show IsIso ((_root_.SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).map
        (completedSheafHomComparison (I := I) G F)) from
      ((_root_.SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).mapIso
        (@asIso _ _ _ _ (completedSheafHomComparison (I := I) G F)
          (isIso_completedSheafHomComparison G F))).isIso_hom
  have hlimit : IsIso ((completionToLimit X I (internalHomCoherent X G F)).val.app
      (op (⊤ : X.Opens))) := by
    have hsplit : (completionToLimit X I (internalHomCoherent X G F) ≫
          completedSheafHomComparison (I := I) G F).val.app (op (⊤ : X.Opens)) =
        (completionToLimit X I (internalHomCoherent X G F)).val.app (op (⊤ : X.Opens)) ≫
          (completedSheafHomComparison (I := I) G F).val.app (op (⊤ : X.Opens)) :=
      (_root_.SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).map_comp _ _
    rw [hsplit] at hcomposite
    exact IsIso.of_isIso_comp_right _ ((completedSheafHomComparison (I := I) G F).val.app
      (op (⊤ : X.Opens)))
  have hgs : globalSectionsToLimit I (internalHomCoherent X G F) =
      (completionToLimit X I (internalHomCoherent X G F)).val.app (op (⊤ : X.Opens)) ≫
        (globalSectionsLimitIso I (internalHomCoherent X G F)).hom :=
    globalSectionsToLimit_eq I (internalHomCoherent X G F)
  rw [hgs]
  exact ((@asIso _ _ _ _ _ hlimit) ≪≫
    globalSectionsLimitIso I (internalHomCoherent X G F)).isIso_hom

end Pair

/-- **Stacks 0EKQ, reduced to the theorem on formal functions in degree zero.** For ideals
`I ⊆ 𝔞` of a Noetherian ring `A` and `U = Spec(A) ∖ V(𝔞)`, completion along `I𝒪_U` is fully
faithful on the finite locally free coherent sheaves on `U` exactly when
`Γ(U, ℋ) ⟶ lim_n Γ(U, ℋ / Iⁿ ℋ)` is an isomorphism for every `ℋ = SheafHom(ℱ, 𝒢)`. -/
@[stacks 0EKQ "REDUCED, not proved: full faithfulness on the finite locally free objects holds \
exactly when the formal-functions comparison is an isomorphism for the internal homs. That half \
is Stacks 0EIG, which the library has at Stacks 0EG2's hypotheses and for another spelling of \
the comparison; it is neither proved nor assumed here, being one side of this equivalence. \
Conditions (1)-(3) of the tag are not consumed"]
public theorem completionFullyFaithfulOnFiniteLocallyFree_iff
    (A : Type u) [CommRing A] [IsNoetherianRing A] (I a : Ideal A) :
    CompletionFullyFaithfulOnFiniteLocallyFree (complementZeroLocus A a : Scheme)
        (idealSheafNearVanishing A I a) ↔
      ∀ P Q : AlgebraicGeometry.SheafOfModules.CoherentModules
          (complementZeroLocus A a : Scheme).ringCatSheaf,
        AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} P.obj →
        AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} Q.obj →
        IsIso (globalSectionsToLimit (idealSheafNearVanishing A I a)
          (internalHomCoherent (complementZeroLocus A a : Scheme) P Q)) :=
  forall_congr' fun P => forall_congr' fun Q =>
    imp_congr_right fun _ => imp_congr_right fun _ =>
      bijective_completionFunctor_map_iff_isIso_globalSectionsToLimit _ P Q

end Stacks.Algebraization

end
