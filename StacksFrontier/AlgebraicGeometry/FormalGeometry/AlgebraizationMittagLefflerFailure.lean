* [Stacks Project, Tag 0EFM](https://stacks.math.columbia.edu/tag/0EFM)
* [Stacks Project, Tag 0EFL](https://stacks.math.columbia.edu/tag/0EFL)
-/

@[expose] public noncomputable section

open PowerSeries

namespace Stacks.Algebraization.MittagLefflerFailure

section Auxiliary

variable {R : Type*} [CommRing R] (q : ℕ)

/-- The `i`-th coefficient of `z * q` is the `i`-th coefficient of `z` times `q`. -/
private theorem coeff_mul_natCast_eq (i : ℕ) (z : PowerSeries R) :
    coeff i (z * ((q : ℕ) : PowerSeries R)) = coeff i z * (q : R) := by
  rw [show ((q : ℕ) : PowerSeries R) = C ((q : ℕ) : R) from (map_natCast C q).symm, coeff_mul_C]

/-- The `i`-th coefficient of `qⁿ * z` is `qⁿ` times the `i`-th coefficient of `z`. -/
private theorem coeff_natCast_pow_mul_eq (i n : ℕ) (z : PowerSeries R) :
    coeff i (((q : ℕ) : PowerSeries R) ^ n * z) = (q : R) ^ n * coeff i z := by
  rw [show ((q : ℕ) : PowerSeries R) ^ n = C (((q : ℕ) : R) ^ n) by
      rw [show ((q : ℕ) : PowerSeries R) = C ((q : ℕ) : R) from (map_natCast C q).symm,
        ← map_pow], coeff_C_mul]

/-- A power series over `R⟦X⟧` whose constant coefficient is `A₀ q + b Xᵐ⁺¹` and whose further
coefficients are `c i * q + d i * X` lies in the ideal `(q, X * C X, (C X)ᵐ⁺¹)`. -/
private theorem exists_mem_span_triple_of_coeff (m : ℕ) (f : PowerSeries (PowerSeries R))
    (A₀ b : PowerSeries R) (c d : ℕ → PowerSeries R)
    (hf₀ : coeff 0 f = A₀ * ((q : ℕ) : PowerSeries R) + b * X ^ (m + 1))
    (htail : ∀ i, coeff (i + 1) f = c i * ((q : ℕ) : PowerSeries R) + d i * X) :
    ∃ u v w : PowerSeries (PowerSeries R),
      f = u * ((q : ℕ) : PowerSeries (PowerSeries R)) + v * (X * C X)
        + w * (C X) ^ (m + 1) := by
  refine ⟨C A₀ + X * mk c, mk d, C b, PowerSeries.ext fun i => ?_⟩
  rw [map_add, map_add, coeff_mul_natCast_eq, ← map_pow, coeff_mul_C]
  rcases i with _ | i
  · simp [hf₀]
  · have h₁ : coeff (i + 1) (C A₀ + X * mk c) = c i := by simp
    have h₂ : coeff (i + 1) (mk d * (X * C X)) = d i * X := by
      rw [show (mk d * (X * C X) : PowerSeries (PowerSeries R)) = X * (mk d * C X) by ring,
        coeff_succ_X_mul, coeff_mul_C]
      simp
    rw [h₁, h₂, htail i]
    simp

end Auxiliary

variable (p : ℕ) [Fact p.Prime]

/-- Cancelling one `p` from a divisibility `p^{t+1} ∣ p c` in `ℤ_[p]`. -/
private theorem pow_dvd_of_mul_dvd_pow_succ {t : ℕ} {c : ℤ_[p]}
    (h : (p : ℤ_[p]) ^ (t + 1) ∣ (p : ℤ_[p]) * c) : (p : ℤ_[p]) ^ t ∣ c := by
  have hp₀ : (p : ℤ_[p]) ≠ 0 := by exact_mod_cast (Fact.out : p.Prime).ne_zero
  rw [pow_succ, mul_comm ((p : ℤ_[p]) ^ t)] at h
  exact (mul_dvd_mul_iff_left hp₀).1 h

/-- If `a * p = p^{t+1} * b` in `ℤ_[p]`, then `p^s ∣ a` for every `s ≤ t`. -/
private theorem pow_dvd_of_mul_eq {s t : ℕ} {a b : ℤ_[p]} (hst : s ≤ t)
    (h : a * (p : ℤ_[p]) = (p : ℤ_[p]) ^ (t + 1) * b) : (p : ℤ_[p]) ^ s ∣ a :=
  (pow_dvd_pow _ hst).trans (pow_dvd_of_mul_dvd_pow_succ p ⟨b, by rw [mul_comm, h]⟩)

/-- A power series over `ℤ_[p]` whose first `m` coefficients are divisible by `p` lies in the
ideal `(p, Xᵐ)`. -/
private theorem mem_span_pair_of_dvd_coeff (m : ℕ) (z : PowerSeries ℤ_[p])
    (h : ∀ j < m, (p : ℤ_[p]) ∣ coeff j z) :
    z ∈ Ideal.span {((p : ℕ) : PowerSeries ℤ_[p]), X ^ m} := by
  have hpC : ((p : ℕ) : PowerSeries ℤ_[p]) = C ((p : ℕ) : ℤ_[p]) := (map_natCast C p).symm
  induction m with
  | zero =>
    have hmem : (X : PowerSeries ℤ_[p]) ^ 0 ∈ Ideal.span {((p : ℕ) : PowerSeries ℤ_[p]), X ^ 0} :=
      Ideal.subset_span (by simp)
    simpa using Ideal.eq_top_of_isUnit_mem _ hmem isUnit_one ▸ Submodule.mem_top
  | succ m ih =>
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.1 (ih fun j hj => h j (by omega))
    have h₁ : coeff m (a * C ((p : ℕ) : ℤ_[p])) = (p : ℤ_[p]) * coeff m a := by
      rw [coeff_mul_C]
      ring
    have h₂ : coeff m (b * X ^ m) = coeff 0 b := by simpa using coeff_mul_X_pow b m 0
    have hc : coeff m z = (p : ℤ_[p]) * coeff m a + coeff 0 b := by
      rw [← hab, hpC, map_add, h₁, h₂]
    have hb₀ : (p : ℤ_[p]) ∣ coeff 0 b := by
      have hm := h m (by omega)
      rw [hc] at hm
      exact (dvd_add_right (Dvd.intro _ rfl)).mp hm
    obtain ⟨e, he⟩ := hb₀
    obtain ⟨d, hd⟩ : (X : PowerSeries ℤ_[p]) ∣ (b - C (coeff 0 b)) := by
      rw [PowerSeries.X_dvd_iff]
      simp
    refine Ideal.mem_span_pair.2 ⟨a + C e * X ^ m, d, ?_⟩
    have hb : b = C ((p : ℕ) : ℤ_[p]) * C e + X * d := by rw [← map_mul, ← he, ← hd]; ring
    rw [← hab, hb, hpC]
    ring

/-- **The key computation, in `ℤ_p[[y]][[x]]`.** If `x^k f = g(xy - p) + p^{m+1} h` then `f`
lies in the ideal `(p, xy, y^{m+1})`. -/
private theorem exists_eq_add_of_pow_mul_eq (m k : ℕ) (f g h : PowerSeries (PowerSeries ℤ_[p]))
    (hyp : X ^ k * f = g * (X * C X - ((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])))
      + ((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])) ^ (m + 1) * h) :
    ∃ u v w : PowerSeries (PowerSeries ℤ_[p]),
      f = u * ((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])) + v * (X * C X)
        + w * (C X) ^ (m + 1) := by
  have hpC : ((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])) = C ((p : ℕ) : PowerSeries ℤ_[p]) :=
    (map_natCast C p).symm
  have hpCn : ((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])) ^ (m + 1)
      = C (((p : ℕ) : PowerSeries ℤ_[p]) ^ (m + 1)) := by rw [hpC, ← map_pow]
  have hrw : X ^ k * f = (X * g) * C X - g * C ((p : ℕ) : PowerSeries ℤ_[p])
      + C (((p : ℕ) : PowerSeries ℤ_[p]) ^ (m + 1)) * h := by
    rw [hyp, ← hpC, ← hpCn]
    ring
  have master : ∀ i : ℕ, coeff i (X ^ k * f)
      = coeff i (X * g) * X - coeff i g * ((p : ℕ) : PowerSeries ℤ_[p])
        + ((p : ℕ) : PowerSeries ℤ_[p]) ^ (m + 1) * coeff i h := by
    intro i
    rw [hrw, map_add, map_sub, coeff_mul_C, coeff_mul_C, coeff_C_mul]
  have hlow : ∀ i, i < k → coeff i (X ^ k * f) = (0 : PowerSeries ℤ_[p]) := by
    intro i hi
    rw [coeff_X_pow_mul']
    simp [Nat.not_le.mpr hi]
  have chain : ∀ i, i < k → ∀ j, (p : ℤ_[p]) ^ (m - j) ∣ coeff j (coeff i g) := by
    intro i
    induction i with
    | zero =>
      intro hik j
      have h₀ := master 0
      rw [hlow 0 hik] at h₀
      have hz : coeff 0 (X * g) = (0 : PowerSeries ℤ_[p]) := by simp
      rw [hz] at h₀
      have h₁ : coeff 0 g * ((p : ℕ) : PowerSeries ℤ_[p])
          = ((p : ℕ) : PowerSeries ℤ_[p]) ^ (m + 1) * coeff 0 h := by linear_combination h₀
      have h₂ := congrArg (fun z => coeff j z) h₁
      simp only [coeff_mul_natCast_eq, coeff_natCast_pow_mul_eq] at h₂
      exact pow_dvd_of_mul_eq p (by omega : m - j ≤ m) h₂
    | succ i ih =>
      intro hik j
      have hi : i < k := by omega
      have h₀ := master (i + 1)
      rw [hlow (i + 1) hik, coeff_succ_X_mul] at h₀
      have h₁ : coeff (i + 1) g * ((p : ℕ) : PowerSeries ℤ_[p])
          = coeff i g * X + ((p : ℕ) : PowerSeries ℤ_[p]) ^ (m + 1) * coeff (i + 1) h := by
        linear_combination h₀
      have h₂ := congrArg (fun z => coeff j z) h₁
      simp only [coeff_mul_natCast_eq, coeff_natCast_pow_mul_eq, map_add] at h₂
      match j with
      | 0 =>
        simp only [coeff_zero_mul_X, zero_add] at h₂
        exact pow_dvd_of_mul_eq p (by omega : m - 0 ≤ m) h₂
      | j + 1 =>
        rw [coeff_succ_mul_X] at h₂
        by_cases hjm : m ≤ j
        · simp [Nat.sub_eq_zero_of_le (by omega : m ≤ j + 1)]
        · have hdvd : (p : ℤ_[p]) ^ (m - j) ∣ (p : ℤ_[p]) * coeff (j + 1) (coeff (i + 1) g) := by
            rw [mul_comm, h₂]
            exact dvd_add (ih hi j) (Dvd.dvd.mul_right (pow_dvd_pow _ (by omega)) _)
          rw [show m - j = (m - (j + 1)) + 1 by omega] at hdvd
          exact pow_dvd_of_mul_dvd_pow_succ p hdvd
  match k with
  | 0 =>
    rw [pow_zero, one_mul] at hyp
    exact ⟨((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])) ^ m * h - g, g, 0, by rw [hyp]; ring⟩
  | k' + 1 =>
    have hXkf : ∀ i, coeff (k' + 1 + i) (X ^ (k' + 1) * f) = coeff i f := by
      intro i
      rw [coeff_X_pow_mul']
      simp
    have hgk : coeff k' g ∈ Ideal.span {((p : ℕ) : PowerSeries ℤ_[p]), X ^ m} := by
      refine mem_span_pair_of_dvd_coeff p m _ fun j hj => ?_
      exact dvd_trans (dvd_pow_self _ (by omega : m - j ≠ 0)) (chain k' (by omega) j)
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.1 hgk
    have hf₀ : coeff 0 f
        = (a * X - coeff (k' + 1) g + ((p : ℕ) : PowerSeries ℤ_[p]) ^ m * coeff (k' + 1) h)
            * ((p : ℕ) : PowerSeries ℤ_[p]) + b * X ^ (m + 1) := by
      rw [← hXkf 0, master, coeff_succ_X_mul, ← hab]
      ring
    have htail : ∀ i, coeff (i + 1) f
        = (((p : ℕ) : PowerSeries ℤ_[p]) ^ m * coeff (k' + 1 + i + 1) h
            - coeff (k' + 1 + i + 1) g) * ((p : ℕ) : PowerSeries ℤ_[p])
          + coeff (k' + 1 + i) g * X := by
      intro i
      rw [← show coeff (k' + 1 + i + 1) (X ^ (k' + 1) * f) = _ from hXkf (i + 1), master,
        coeff_succ_X_mul]
      ring
    exact exists_mem_span_triple_of_coeff p m f _ b _ _ hf₀ htail

/-- **Nontriviality, in `ℤ_p[[y]][[x]]`.** The element `yⁿ` is not in the ideal
`(p, xy, yⁿ⁺¹)`. -/
private theorem X_pow_ne_combination (n : ℕ) (u v w : PowerSeries (PowerSeries ℤ_[p])) :
    (C X : PowerSeries (PowerSeries ℤ_[p])) ^ n
      ≠ u * ((p : ℕ) : PowerSeries (PowerSeries ℤ_[p])) + v * (X * C X)
        + w * (C X) ^ (n + 1) := by
  intro hcon
  simp only [← map_pow] at hcon
  have hv : coeff 0 (v * (X * C X)) = (0 : PowerSeries ℤ_[p]) := by
    rw [show (v * (X * C X) : PowerSeries (PowerSeries ℤ_[p])) = X * (v * C X) by ring]
    simp
  have h₀ : (X : PowerSeries ℤ_[p]) ^ n
      = coeff 0 u * ((p : ℕ) : PowerSeries ℤ_[p]) + coeff 0 w * X ^ (n + 1) := by
    have hh := congrArg (fun z => coeff 0 z) hcon
    simp only [map_add, coeff_mul_natCast_eq, coeff_mul_C, hv, coeff_C] at hh
    simpa using hh
  have h₁ : (1 : ℤ_[p]) = coeff n (coeff 0 u) * (p : ℤ_[p]) := by
    have hh := congrArg (fun z => coeff n z) h₀
    simpa [coeff_mul_natCast_eq, coeff_mul_X_pow', coeff_X_pow] using hh
  exact PadicInt.p_nonunit (isUnit_of_dvd_one ⟨coeff n (coeff 0 u), by rw [h₁]; ring⟩)

/-- The index equivalence `Fin 2 ≃ Option Unit` sending `0`, the variable `x`, to `none`. -/
private def idxEquiv : Fin 2 ≃ Option Unit where
  toFun i := if i = 0 then none else some ()
  invFun o := o.elim 0 (fun _ => 1)
  left_inv := by decide
  right_inv := by decide

/-- The identification `ℤ_p[[x, y]] = ℤ_p[[y]][[x]]`, which expands an element of
`ℤ_p[[x, y]]` into its `x`-adic coefficients. -/
private def iterEquiv : MvPowerSeries (Fin 2) ℤ_[p] ≃ₐ[ℤ_[p]] PowerSeries (PowerSeries ℤ_[p]) :=
  (MvPowerSeries.renameEquiv ℤ_[p] idxEquiv).trans (MvPowerSeries.optionEquivLeft Unit ℤ_[p])

/-- The variable `x` of `A = ℤ_p[[x, y]]`. -/
def varX : MvPowerSeries (Fin 2) ℤ_[p] := MvPowerSeries.X 0

/-- The variable `y` of `A = ℤ_p[[x, y]]`. -/
def varY : MvPowerSeries (Fin 2) ℤ_[p] := MvPowerSeries.X 1

/-- The element `xy - p` of `A = ℤ_p[[x, y]]`, whose quotient is the module `M = A/(xy - p)`. -/
def relation : MvPowerSeries (Fin 2) ℤ_[p] :=
  varX p * varY p - ((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p])

/-- The ideal `J = (p, x)` of `A = ℤ_p[[x, y]]`. -/
def supportIdeal : Ideal (MvPowerSeries (Fin 2) ℤ_[p]) :=
  Ideal.span {((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]), varX p}

/-- The ideal `(xy - p, pⁿ)` of `A = ℤ_p[[x, y]]`, the kernel of `A → M/pⁿM`. -/
def modIdeal (n : ℕ) : Ideal (MvPowerSeries (Fin 2) ℤ_[p]) :=
  Ideal.span {relation p, ((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]) ^ n}

/-- The identification of `ℤ_p[[x, y]]` with `ℤ_p[[y]][[x]]` sends `x` to the outer variable. -/
private theorem iterEquiv_varX : iterEquiv p (varX p) = (X : PowerSeries (PowerSeries ℤ_[p])) := by
  simp [iterEquiv, idxEquiv, varX]

/-- The identification of `ℤ_p[[x, y]]` with `ℤ_p[[y]][[x]]` sends `y` to the inner variable. -/
private theorem iterEquiv_varY :
    iterEquiv p (varY p) = (C X : PowerSeries (PowerSeries ℤ_[p])) := by
  simp [iterEquiv, idxEquiv, varY, PowerSeries.X]

/-- `x` lies in `J = (p, x)`. -/
theorem varX_mem_supportIdeal : varX p ∈ supportIdeal p := Ideal.subset_span (by simp)

/-- `xⁿyⁿ = pⁿ` in `M`, so `xⁿyⁿ` lies in `(xy - p, pⁿ)`. -/
@[stacks 0EFM "the containment `(yⁿ) ⊆` the image: `xⁿyⁿ = pⁿ` in `M`"]
theorem pow_mul_pow_mem_modIdeal (n : ℕ) : varX p ^ n * varY p ^ n ∈ modIdeal p n := by
  obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow (varX p * varY p)
    (((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p])) n
  refine Ideal.mem_span_pair.2 ⟨c, 1, ?_⟩
  rw [relation]
  linear_combination -hc

/-- `(xy - p, pⁿ⁺¹) ⊆ (xy - p, p)`, so that `M/pⁿ⁺¹M` maps onto `M/pM`. -/
theorem modIdeal_le (n : ℕ) : modIdeal p (n + 1) ≤ modIdeal p 1 := by
  rw [modIdeal, modIdeal, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
  exact ⟨Ideal.subset_span (by simp),
    Ideal.mem_span_pair.2 ⟨0, ((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]) ^ n, by ring⟩⟩

/-- **`M/pM = A/(p, xy)`.** The ideal `(xy - p, p)` is the ideal `(p, xy)`. -/
theorem modIdeal_one_eq : modIdeal p 1
    = Ideal.span {((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]), varX p * varY p} := by
  refine le_antisymm ?_ ?_
  · rw [modIdeal, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨Ideal.mem_span_pair.2 ⟨-1, 1, by rw [relation]; ring⟩,
      Ideal.mem_span_pair.2 ⟨1, 0, by ring⟩⟩
  · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨Ideal.mem_span_pair.2 ⟨0, 1, by ring⟩,
      Ideal.mem_span_pair.2 ⟨1, 1, by rw [relation]; ring⟩⟩

/-- **The presentation `M/pⁿM = A/(xy - p, pⁿ)`.** The quotient of `M = A/(xy - p)` by the ideal
generated by `pⁿ`, that is by `pⁿM`, is `A/(xy - p, pⁿ)`. -/
def quotientEquiv (n : ℕ) :
    ((MvPowerSeries (Fin 2) ℤ_[p] ⧸ Ideal.span {relation p}) ⧸
        Ideal.span {((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p] ⧸ Ideal.span {relation p}) ^ n})
      ≃+* MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p n :=
  (Ideal.quotEquivOfEq (by
      rw [Ideal.map_span, Set.image_singleton, map_pow, map_natCast])).trans
    ((DoubleQuot.quotQuotEquivQuotSup (Ideal.span {relation p})
        (Ideal.span {((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]) ^ n})).trans
      (Ideal.quotEquivOfEq (by rw [modIdeal, Ideal.span_insert])))

/-- `Jᵏ ⊆ (xᵏ) + (xy - p)`: modulo `xy - p` the ideal `J = (p, x)` is generated by `x`. -/
theorem supportIdeal_pow_le (k : ℕ) :
    supportIdeal p ^ k ≤ Ideal.span {varX p ^ k} ⊔ Ideal.span {relation p} := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ]
    refine Ideal.mul_le.2 fun r hr s hs => ?_
    obtain ⟨r₁, hr₁, r₂, hr₂, rfl⟩ := Submodule.mem_sup.1 (ih hr)
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hr₁
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.1 hr₂
    obtain ⟨e, g, hs'⟩ := Ideal.mem_span_pair.1 hs
    refine Submodule.mem_sup.2 ⟨varX p ^ (k + 1) * (c * e * varY p + c * g),
      Ideal.mem_span_singleton'.2 ⟨_, mul_comm _ _⟩,
      relation p * (d * s - c * varX p ^ k * e),
      Ideal.mem_span_singleton'.2 ⟨_, mul_comm _ _⟩, ?_⟩
    simp only [relation] at *
    linear_combination (c * varX p ^ k) * hs'

/-- **`H⁰_J(M/pⁿM)` is the `x`-power-torsion.** The class of `f` lies in the `J`-power-torsion of
`M/pⁿM = A/(xy - p, pⁿ)` exactly when `x^k f ∈ (xy - p, pⁿ)` for some `k`. -/
theorem mem_primaryComponent_iff (n : ℕ) (f : MvPowerSeries (Fin 2) ℤ_[p]) :
    Ideal.Quotient.mk (modIdeal p n) f ∈
        (supportIdeal p).primaryComponent (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p n)
      ↔ ∃ k, varX p ^ k * f ∈ modIdeal p n := by
  rw [Ideal.primaryComponent_mem]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have hkill := (Submodule.mem_torsionBySet_iff _ _).1 hk
      ⟨varX p ^ k, Ideal.pow_mem_pow (varX_mem_supportIdeal p) k⟩
    rwa [show varX p ^ k • Ideal.Quotient.mk (modIdeal p n) f
        = Ideal.Quotient.mk (modIdeal p n) (varX p ^ k * f) from rfl,
      Ideal.Quotient.eq_zero_iff_mem] at hkill
  · rintro ⟨k, hk⟩
    refine ⟨k, (Submodule.mem_torsionBySet_iff _ _).2 ?_⟩
    rintro ⟨a, ha⟩
    obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := Submodule.mem_sup.1 (supportIdeal_pow_le p k ha)
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 ha₁
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.1 ha₂
    have hrel : relation p ∈ modIdeal p n := Ideal.subset_span (by simp)
    have h₂ : (c * varX p ^ k + d * relation p) * f ∈ modIdeal p n := by
      rw [show (c * varX p ^ k + d * relation p) * f
        = c * (varX p ^ k * f) + d * f * relation p by ring]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hk) (Ideal.mul_mem_left _ _ hrel)
    exact Ideal.Quotient.eq_zero_iff_mem.2 h₂

/-- **The `x`-power-torsion of `A/(xy - p, pⁿ⁺¹)` is carried by `(xy - p, yⁿ⁺¹)`.** If
`x^k f ∈ (xy - p, pⁿ⁺¹)` then `f ∈ (p, xy, yⁿ⁺¹)`. -/
@[stacks 0EFM "the containment image `⊆ (yⁿ)`: an `x`-power-torsion element mod `(xy - p, pⁿ)`
lies in `(p, xy, yⁿ)`"]
theorem mem_span_of_pow_mul_mem (n k : ℕ) (f : MvPowerSeries (Fin 2) ℤ_[p])
    (hf : varX p ^ k * f ∈ modIdeal p (n + 1)) :
    f ∈ Ideal.span {((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]), varX p * varY p,
      varY p ^ (n + 1)} := by
  obtain ⟨g, h, hgh⟩ := Ideal.mem_span_pair.1 hf
  have hX := iterEquiv_varX p
  have hY := iterEquiv_varY p
  have himg := congrArg (iterEquiv p) hgh
  simp only [map_add, map_mul, map_sub, map_pow, map_natCast, relation, hX, hY] at himg
  obtain ⟨u, v, w, huvw⟩ := exists_eq_add_of_pow_mul_eq p n k (iterEquiv p f) (iterEquiv p g)
    (iterEquiv p h) (by rw [← himg]; ring)
  have hf' : f = (iterEquiv p).symm u * ((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p])
      + (iterEquiv p).symm v * (varX p * varY p)
      + (iterEquiv p).symm w * varY p ^ (n + 1) := by
    have := congrArg (iterEquiv p).symm huvw
    simpa only [AlgEquiv.symm_apply_apply, map_add, map_mul, map_pow, map_natCast,
      ← hX, ← hY] using this
  rw [hf']
  refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_ <;>
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))

/-- **`yⁿ⁺¹` is not in `(p, xy, yⁿ⁺²)`.** This is what makes the images of the inverse system
strictly decrease. -/
theorem varY_pow_notMem (n : ℕ) :
    varY p ^ (n + 1) ∉
      Ideal.span {((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]), varX p * varY p,
        varY p ^ (n + 2)} := by
  intro hmem
  obtain ⟨a, b, c, habc⟩ := Submodule.mem_span_triple.1 hmem
  have himg := congrArg (iterEquiv p) habc
  simp only [smul_eq_mul, map_add, map_mul, map_pow, map_natCast, iterEquiv_varX,
    iterEquiv_varY] at himg
  exact X_pow_ne_combination p (n + 1) (iterEquiv p a) (iterEquiv p b) (iterEquiv p c)
    (by rw [← himg])

/-- The transition map `M/pⁿ⁺¹M → M/pM` of the inverse system. -/
def transition (n : ℕ) :
    (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p (n + 1)) →ₗ[MvPowerSeries (Fin 2) ℤ_[p]]
      (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p 1) :=
  (Ideal.Quotient.factorₐ (MvPowerSeries (Fin 2) ℤ_[p]) (modIdeal_le p n)).toLinearMap

/-- The transition map sends the class of `f` to the class of `f`. -/
@[simp]
theorem transition_mk (n : ℕ) (f : MvPowerSeries (Fin 2) ℤ_[p]) :
    transition p n (Ideal.Quotient.mk (modIdeal p (n + 1)) f)
      = Ideal.Quotient.mk (modIdeal p 1) f := rfl

/-- The image of `H⁰_J(M/pⁿ⁺¹M) → H⁰_J(M/pM)`, computed inside `M/pM`. -/
def imageSections (n : ℕ) : Submodule (MvPowerSeries (Fin 2) ℤ_[p])
    (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p 1) :=
  Submodule.map (transition p n)
    ((supportIdeal p).primaryComponent (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p (n + 1)))

/-- **Stacks 0EFM.** The image of `H⁰_J(M/pⁿM) → H⁰_J(M/pM)` is the ideal generated by `yⁿ` in
`M/pM = A/(p, xy)`, for `A = ℤ_p[[x, y]]`, `I = (p)`, `J = (p, x)` and `M = A/(xy - p)`. -/
@[stacks 0EFM "the example: the image of `H⁰_J(M/pⁿM) ⟶ H⁰_J(M/pM)` is the ideal generated by
`yⁿ` in `M/pM = A/(p, xy)`, for `A = ℤ_p[[x,y]]`, `I = (p)`, `J = (p, x)` and `M = A/(xy - p)`"]
theorem imageSections_eq (n : ℕ) :
    imageSections p n = Submodule.restrictScalars (MvPowerSeries (Fin 2) ℤ_[p])
      (Ideal.span {Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 1))}) := by
  apply le_antisymm
  · rintro z ⟨w, hw, rfl⟩
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨k, hk⟩ := (mem_primaryComponent_iff p (n + 1) f).1 hw
    obtain ⟨a, b, c, habc⟩ :=
      Submodule.mem_span_triple.1 (mem_span_of_pow_mul_mem p n k f hk)
    have hp₀ : Ideal.Quotient.mk (modIdeal p 1) ((p : ℕ) : MvPowerSeries (Fin 2) ℤ_[p]) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_pair.2 ⟨0, 1, by ring⟩
    have hxy : Ideal.Quotient.mk (modIdeal p 1) (varX p * varY p) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_pair.2 ⟨1, 1, by rw [relation]; ring⟩
    rw [transition_mk, ← habc]
    simp only [smul_eq_mul, map_add, map_mul, hp₀, hxy, mul_zero, zero_add]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · intro z hz
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.1 hz
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective t
    refine ⟨Ideal.Quotient.mk (modIdeal p (n + 1)) (a * varY p ^ (n + 1)), ?_,
      by rw [transition_mk, map_mul]⟩
    refine (mem_primaryComponent_iff p (n + 1) _).2 ⟨n + 1, ?_⟩
    rw [mul_left_comm (varX p ^ (n + 1))]
    exact Ideal.mul_mem_left _ _ (pow_mul_pow_mem_modIdeal p (n + 1))

/-- The images of the inverse system `n ↦ H⁰_J(M/pⁿM)` in `H⁰_J(M/pM)` strictly decrease. -/
theorem imageSections_lt (n : ℕ) : imageSections p (n + 1) < imageSections p n := by
  rw [imageSections_eq, imageSections_eq, show n + 1 + 1 = n + 2 from rfl]
  have hle : Ideal.span {Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 2))}
      ≤ Ideal.span {Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 1))} := by
    rw [Ideal.span_singleton_le_span_singleton]
    refine ⟨Ideal.Quotient.mk (modIdeal p 1) (varY p), ?_⟩
    rw [← map_mul]
    congr 1
  refine lt_of_le_of_ne (fun z hz => hle hz) (fun hcon => ?_)
  have hmem : Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 1))
      ∈ Ideal.span {Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 2))} := by
    have h₀ : Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 1))
        ∈ Submodule.restrictScalars (MvPowerSeries (Fin 2) ℤ_[p])
          (Ideal.span {Ideal.Quotient.mk (modIdeal p 1) (varY p ^ (n + 1))}) :=
      Ideal.subset_span rfl
    rwa [← hcon] at h₀
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.1 hmem
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective t
  rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem] at ht
  obtain ⟨b, c, hbc⟩ := Ideal.mem_span_pair.1 ht
  refine varY_pow_notMem p n (Submodule.mem_span_triple.2 ⟨b - c, -b, a, ?_⟩)
  simp only [smul_eq_mul, relation] at hbc ⊢
  linear_combination -hbc

/-- **The inverse system `n ↦ H⁰_J(M/pⁿM)` is not Mittag-Leffler.** The images of its transition
maps into `H⁰_J(M/pM)` never stabilise. -/
@[stacks 0EFM "the point of the example: the inverse system `H⁰_J(M/pⁿM)` does NOT satisfy the
Mittag-Leffler condition, so the hypothesis of Lemma 0EFL cannot be dropped"]
theorem not_mittagLeffler :
    ¬ ∃ m : ℕ, ∀ k, m ≤ k → imageSections p k = imageSections p m :=
  fun ⟨m, hm⟩ => (imageSections_lt p m).ne (hm _ m.le_succ)

/-- The `J`-power-torsion submodule used here as `H⁰_J` is the library's degree-zero sections
with support in `V(J)`. -/
theorem sectionsWithSupportIn_eq_primaryComponent (n : ℕ) :
    Stacks.LocalCohomology.sectionsWithSupportIn (MvPowerSeries (Fin 2) ℤ_[p])
        (PrimeSpectrum.zeroLocus (supportIdeal p : Set (MvPowerSeries (Fin 2) ℤ_[p])))
        (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p n)
      = (supportIdeal p).primaryComponent (MvPowerSeries (Fin 2) ℤ_[p] ⧸ modIdeal p n) :=
  Stacks.LocalCohomology.sectionsWithSupportIn_zeroLocus_eq_primaryComponent _ _
    (Submodule.fg_span (Set.toFinite _)) _

end Stacks.Algebraization.MittagLefflerFailure

