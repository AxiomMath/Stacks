/-! ### Multiples of a power of `f` in a localization -/

section Algebra

variable {S : Type*} {M : Type*} {σ : Type*} {τ : Type*}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [SetLike.GradedSMul 𝒜 𝒨]

/-- **The multiples of `f^{e m}` by elements of degree `-e m` are the multiples of `(fᵉ/β)ᵐ` by
elements of degree zero**, in the localization of a graded module at a homogeneous `β` of degree
`e`, for `f` homogeneous of degree one. -/
theorem exists_smul_mk_iff {f β : S} {e : ℕ} (_hf : f ∈ 𝒜 1) (hβ : β ∈ 𝒜 e) (m : ℕ)
    (z : LocalizedModule.Away (R := S) β M) :
    (∃ w ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒨 β (-(e * m : ℕ)), z = f ^ (e * m) • w) ↔
      ∃ z₀ ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒨 β 0,
        z = (Localization.mk (f ^ (e * m)) (⟨β ^ m, m, rfl⟩ : Submonoid.powers β) :
          Localization.Away β) • z₀ := by
  constructor
  · rintro ⟨w, hw, rfl⟩
    obtain ⟨k, x, hx, rfl⟩ := (Stacks.GradedLocalization.mem_gradedPiece_iff 𝒜 𝒨 hβ _ w).1 hw
    refine ⟨LocalizedModule.mk (β ^ m • x) ⟨β ^ k, k, rfl⟩,
      Stacks.GradedLocalization.mk_mem_gradedPiece 𝒜 𝒨 hβ ?_, ?_⟩
    · have h := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) (SetLike.pow_mem_graded m hβ) hx
      convert h using 2
      change (0 : ℤ) + k • (e : ℤ) = ((m • e : ℕ) : ℤ) + (-((e * m : ℕ) : ℤ) + k • (e : ℤ))
      simp only [smul_eq_mul, Nat.cast_mul]
      ring
    · rw [LocalizedModule.mk_smul_mk, LocalizedModule.smul'_mk]
      refine LocalizedModule.mk_eq.2 ⟨1, ?_⟩
      simp only [one_smul, Submonoid.smul_def, Submonoid.coe_mul, smul_smul]
      ring_nf
  · rintro ⟨z₀, hz₀, rfl⟩
    obtain ⟨k, x, hx, rfl⟩ := (Stacks.GradedLocalization.mem_gradedPiece_iff 𝒜 𝒨 hβ _ z₀).1 hz₀
    refine ⟨LocalizedModule.mk x ⟨β ^ (m + k), m + k, rfl⟩,
      Stacks.GradedLocalization.mk_mem_gradedPiece 𝒜 𝒨 hβ ?_, ?_⟩
    · convert hx using 2
      push_cast
      ring
    · rw [LocalizedModule.mk_smul_mk, LocalizedModule.smul'_mk]
      congr 1
      exact Subtype.ext (by simp [pow_add])

end Algebra

/-! ### The ideal of an infinitesimal neighbourhood on a standard open -/

section Monoidal

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- The homogeneous element of degree one of the section ring given by a global section. -/
abbrev sectionElt (s : Γ(L, ⊤)) : sectionRing L :=
  DirectSum.of (powSections L) 1 (Stacks.Algebraization.degreeOneSection L s)

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The element `sectionElt L s` is homogeneous of degree one. -/
theorem sectionElt_mem (s : Γ(L, ⊤)) : sectionElt L s ∈ grading L 1 :=
  Stacks.ExternalGrading.of_mem_summand 1 _

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The `e`-th power of `sectionElt L s` is homogeneous of degree `e`. -/
theorem pow_sectionElt_mem (s : Γ(L, ⊤)) (e : ℕ) : sectionElt L s ^ e ∈ grading L (1 • e) := by
  simpa [smul_eq_mul, mul_comm] using SetLike.pow_mem_graded e (sectionElt_mem L s)

/-- The degree-zero fraction `fᵉ / β` of the section ring, for `β` homogeneous of degree `e` and
`f` the element of degree one given by `s`. -/
abbrev chartFraction (s : Γ(L, ⊤)) {e : ℕ} (β : powSections L e) :
    HomogeneousLocalization.Away (grading L) (DirectSum.of (powSections L) e β) :=
  HomogeneousLocalization.Away.mk (grading L) (Stacks.ExternalGrading.of_mem_summand e β) 1
    (sectionElt L s ^ e) (pow_sectionElt_mem L s e)

/-- **The ideal of the infinitesimal neighbourhood `Q_{e k}` of `Z(s)` on `X_β`** is generated by
the `k`-th power of the value of the chart ring map on `fᵉ / β`. -/
theorem zeroScheme_pow_ideal_chart (hL : Stacks.Ample.IsAmple X L) (s : Γ(L, ⊤)) {e : ℕ}
    (he : 1 ≤ e) (β : powSections L e) (hW : IsAffineOpen (nvOpen L β)) (k : ℕ) :
    (zeroScheme X L s ^ (e * k)).ideal ⟨nvOpen L β, hW⟩ = Ideal.span
      {(Stacks.SectionRingChartMap.chartRingMap L β (le_refl _) (chartFraction L s β)) ^ k} := by
  set sp := Stacks.Algebraization.degreeOneSection L s
  set c := Stacks.SectionRingChartMap.chartRingMap L β (le_refl _) (chartFraction L s β)
  have hZ := Stacks.Algebraization.zeroScheme_powSec_degreeOneSection L hL s he
  rw [pow_mul, ← hZ, ← Ideal.span_singleton_pow]
  change (zeroScheme X (natTensorPow L (1 * e)) (globalSection X _ (powSec L sp e))).ideal
    ⟨nvOpen L β, hW⟩ ^ k = _
  congr 1
  have h1 : e = 1 * e := (one_mul e).symm
  set φ := (eqToHom (congrArg (natTensorPow L) h1)).app (nvOpen L β)
  set gen : Γ(natTensorPow L (1 * e), nvOpen L β) := φ (unitSec β (nvOpen L β))
  refine zeroScheme_ideal_eq_span_singleton_of_bijective_smul X (natTensorPow L (1 * e))
    (globalSection X _ (powSec L sp e)) ⟨nvOpen L β, hW⟩ gen ?_ c ?_
  · have hb := Stacks.NonvanishingSpelling.bijective_smul X (natTensorPow L e)
      (globalSection X _ β) (le_refl (nvOpen L β))
    have : (fun r : Γ(X, nvOpen L β) => r • gen) =
        φ ∘ fun r : Γ(X, nvOpen L β) => r • (natTensorPow L e).presheaf.map (homOfLE le_top).op
            (globalSection X _ β) := by
      funext r
      simp only [Function.comp_apply, Scheme.Modules.Hom.app_smul, φ, gen,
        Stacks.SectionRingProjQuasicoherent.unitSec_eq_map_globalSection]
    rw [this]
    exact (Stacks.TensorPowerDivision.bijective_app_of_isIso _ _).comp hb
  · have key := Stacks.SectionRingProjQuasicoherent.chartRingMap_smul_unitSec_powSec L β
      (le_refl _) 1 (sectionElt L s ^ e) (pow_sectionElt_mem L s e) (powSec L sp e)
      (Stacks.SectionRingChartMap.of_powSec_eq_pow L sp e)
    have h2 : e * 1 = 1 * e := by ring
    have key' := congrArg ((eqToHom (congrArg (natTensorPow L) h2)).app (nvOpen L β)) key
    rw [Scheme.Modules.Hom.app_smul,
      Stacks.SectionRingProjQuasicoherent.eqToHom_app_unitSec_of_of_eq L h2 (powSec L β 1)
        (β ≫ eqToHom (congrArg (natTensorPow L) h1))
        (by rw [Stacks.SectionRingChartMap.of_powSec_eq_pow,
          Stacks.SectionRingProjQuasicoherent.of_comp_eqToHom L h1, pow_one]),
      ← Stacks.SectionRingProjQuasicoherent.unitSec_comp] at key'
    simp only [Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id] at key'
    rw [← Stacks.SectionRingProjQuasicoherent.unitSec_eq_map_globalSection, ← key']
    rfl

end Monoidal

/-! ### Restriction to a closed subscheme with ideal `Iⁿ`, over an affine open -/

section Restriction

variable {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℕ) (F : X.Modules) [F.IsQuasicoherent]

/-- The restriction of `ℱ` to the closed subscheme cut out by `Iⁿ` is quasi-coherent, as a module on
`X`: it is the quotient `ℱ / Iⁿ ℱ` of Stacks Tag 0EL1. -/
theorem isQuasicoherent_restriction :
    ((Scheme.Modules.pushforward (I ^ n).subschemeι).obj
      ((Scheme.Modules.pullback (I ^ n).subschemeι).obj F)).IsQuasicoherent := by
  have := Stacks.Algebraization.idealPowerMultiple_isQuasicoherent I n F
  have : (Stacks.Algebraization.idealPowerQuotient I n F).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.QuasicoherentColimits.isQuasicoherent_cokernel _
  exact (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso
    (Stacks.Algebraization.idealQuotientPushforwardIso I n F (I ^ n).subschemeι
      (Scheme.IdealSheafData.ker_subschemeι _)) inferInstance

/-- The restriction to the closed subscheme cut out by `Iⁿ` is an epimorphism. -/
theorem epi_unit_restriction :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction (I ^ n).subschemeι).unit.app F) := by
  rw [← Stacks.Algebraization.idealQuotientPushforwardMap_π I n F (I ^ n).subschemeι
    (Scheme.IdealSheafData.ker_subschemeι _)]
  have := Stacks.Algebraization.isIso_idealQuotientPushforwardMap I n F (I ^ n).subschemeι
    (Scheme.IdealSheafData.ker_subschemeι _)
  exact epi_comp _ _

/-- **Restriction to the closed subscheme cut out by `Iⁿ` is surjective on the sections over an
affine open.** -/
theorem unit_app_surjective {U : X.Opens} (hU : IsAffineOpen U) :
    Function.Surjective
      (((Scheme.Modules.pullbackPushforwardAdjunction (I ^ n).subschemeι).unit.app F).app U) := by
  have h1 := isQuasicoherent_restriction I n F
  have := epi_unit_restriction I n F
  exact @AlgebraicGeometry.surjective_app_of_epi_of_isAffineOpen X F _ _ h1 _ _ U hU

/-- **A section over an affine open dies on the closed subscheme cut out by `Iⁿ` exactly when it
lies in `I(U)ⁿ Γ(U, ℱ)`.** -/
theorem mem_ker_unit_app_iff (U : X.affineOpens) (y : Γ(F, U.1)) :
    ((Scheme.Modules.pullbackPushforwardAdjunction (I ^ n).subschemeι).unit.app F).app U.1 y = 0 ↔
      y ∈ I.ideal U ^ n • (⊤ : Submodule Γ(X, U.1) Γ(F, U.1)) := by
  have h := Stacks.Algebraization.kernelSubmodule_unit_app_eq_idealPowerMultiple I n F
    (I ^ n).subschemeι (Scheme.IdealSheafData.ker_subschemeι _)
  have h2 := congrArg (fun P => P.toSubmodule.obj (op U.1)) h
  simp only [Stacks.Algebraization.kernelSubmodule_toSubmodule_obj] at h2
  rw [← Stacks.Algebraization.idealPowerMultiple_toSubmodule_obj_affine I n F U, ← h2]
  rfl

end Restriction

/-! ### The kernel of the restriction, read in the localization -/

section KernelChart

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
  (hL : Stacks.Ample.IsAmple X L) (F : X.Modules) [F.IsQuasicoherent]

/-- **The lift is semilinear over the chart ring map.** -/
theorem chartLift_smul {e : ℕ} (he : 0 < e) (β : powSections L e)
    (a : HomogeneousLocalization.Away (grading L) (DirectSum.of (powSections L) e β))
    (y : Γ(F, nvOpen L β)) :
    Stacks.SectionRingChartCech.chartLift L hL F he β rfl
        (Stacks.SectionRingChartMap.chartRingMap L β (le_refl _) a • y) =
      a.val • Stacks.SectionRingChartCech.chartLift L hL F he β rfl y := by
  have h := Stacks.SectionRingProjQuasicoherent.localDivision_smul L F β (le_refl _) a
    ((Stacks.SectionRingChartCech.divisionEquiv L hL F he β).symm y)
  have hy : localDivision L F β (le_refl _)
      ((Stacks.SectionRingChartCech.divisionEquiv L hL F he β).symm y) = y :=
    (Stacks.SectionRingChartCech.divisionEquiv L hL F he β).apply_symm_apply y
  rw [hy] at h
  have h' : (Stacks.SectionRingChartCech.divisionEquiv L hL F he β).symm
      (Stacks.SectionRingChartMap.chartRingMap L β (le_refl _) a • y) =
      a • (Stacks.SectionRingChartCech.divisionEquiv L hL F he β).symm y :=
    (AddEquiv.symm_apply_eq _).2 h.symm
  change ((Stacks.SectionRingChartCech.divisionEquiv L hL F he β).symm _).1 =
    a.val • ((Stacks.SectionRingChartCech.divisionEquiv L hL F he β).symm y).1
  rw [h']
  rfl

/-- **A section over a standard chart dies on the infinitesimal neighbourhood `Q_{e k}`** exactly
when its lift to the localization `M_β` is `f^{e k}` times an element of degree `-e k`. -/
theorem unit_app_eq_zero_iff (s : Γ(L, ⊤)) {e : ℕ} (he : 0 < e) (β : powSections L e)
    (hW : IsAffineOpen (nvOpen L β)) (k : ℕ) (y : Γ(F, nvOpen L β)) :
    ((Scheme.Modules.pullbackPushforwardAdjunction (zeroScheme X L s ^ (e * k)).subschemeι).unit.app
        F).app (nvOpen L β) y = 0 ↔
      ∃ w ∈ Stacks.GradedLocalization.gradedPiece (grading L)
          (Stacks.TwistedSections.moduleGrading F L) (DirectSum.of (powSections L) e β)
          (-(e * k : ℕ)),
        Stacks.SectionRingChartCech.chartLift L hL F he β rfl y = sectionElt L s ^ (e * k) • w := by
  rw [mem_ker_unit_app_iff (zeroScheme X L s) (e * k) F ⟨nvOpen L β, hW⟩ y,
    show (zeroScheme X L s).ideal ⟨nvOpen L β, hW⟩ ^ (e * k) =
      (zeroScheme X L s ^ (e * k)).ideal ⟨nvOpen L β, hW⟩ from rfl,
    zeroScheme_pow_ideal_chart L hL s he β hW k, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists, exists_smul_mk_iff (grading L)
      (Stacks.TwistedSections.moduleGrading F L) (sectionElt_mem L s)
      (Stacks.ExternalGrading.of_mem_summand e β) k]
  have hval : ((chartFraction L s β) ^ k).val =
      (Localization.mk (sectionElt L s ^ (e * k))
        (⟨DirectSum.of (powSections L) e β ^ k, k, rfl⟩ :
          Submonoid.powers (DirectSum.of (powSections L) e β)) :
        Localization.Away (DirectSum.of (powSections L) e β)) := by
    rw [HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
      Localization.mk_pow]
    congr 1
    · rw [← pow_mul]
    · exact Subtype.ext (by simp)
  constructor
  · rintro ⟨y', -, rfl⟩
    refine ⟨_, (Stacks.SectionRingChartCech.mem_range_chartLift L hL F he β rfl _).1 ⟨y', rfl⟩, ?_⟩
    rw [← map_pow, chartLift_smul, hval]
  · rintro ⟨z₀, hz₀, hz⟩
    obtain ⟨y', rfl⟩ := (Stacks.SectionRingChartCech.mem_range_chartLift L hL F he β rfl z₀).2 hz₀
    refine ⟨y', trivial, ?_⟩
    apply Stacks.SectionRingChartCech.chartLift_injective L hL F he β rfl
    rw [← map_pow, chartLift_smul, hval, ← hz]

end KernelChart

end Stacks.SectionRingChartTower

end
