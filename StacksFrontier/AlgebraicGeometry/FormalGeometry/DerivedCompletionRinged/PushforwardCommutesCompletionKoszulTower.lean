* [Stacks Project, Tag 0H9L](https://stacks.math.columbia.edu/tag/0H9L)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite
open AlgebraicGeometry
open Stacks.Cohomology.DerivedPullbackPushforwardAdjunction

universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance 100000] HasDerivedCategory.standard
attribute [local instance] hasFiniteBiproducts_sheafOfModules
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat
attribute [local instance] isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf

section Reflector

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}] {r : ℕ}
  (g : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
  (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))

/-- **The reflector of [Stacks, Tag 099F] mapped to the Čech completion of
[Stacks, Tag 099B]**, at the sheaf of ideals generated by the global sections `g_1, …, g_r`: the
adjunct, under the reflector adjunction, of the Čech completion map
`K ⟶ R𝑆heafHom_𝒪(Č(g), K)`, whose target is derived complete by
`AlgebraicGeometry.RingedSite.isDerivedComplete_generatedIdealSheaf_completionFunctor_obj`.

This is the comparison that lets a statement about `AlgebraicGeometry.RingedSite.completionFunctor`
be read as a statement about `AlgebraicGeometry.RingedSite.derivedCompletion`; it is invertible,
by `AlgebraicGeometry.RingedSite.isIso_reflectorToCompletionFunctor`. -/
def reflectorToCompletionFunctor :
    (derivedCompletion X (generatedIdealSheaf g)).obj K ⟶ (completionFunctor X g).obj K :=
  (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X (generatedIdealSheaf g))).map
    (((derivedCompletionAdjunction X (generatedIdealSheaf g)).homEquiv K
      ⟨(completionFunctor X g).obj K,
        isDerivedComplete_generatedIdealSheaf_completionFunctor_obj X g K⟩).symm
      ((completionUnit X g).app K))

/-- **The comparison map is compatible with the two completion maps out of `K`**: the derived
completion map `K ⟶ K^∧` of [Stacks, Tag 099F] followed by it is the Čech completion map
`K ⟶ R𝑆heafHom_𝒪(Č(g), K)` of [Stacks, Tag 099B]. This is `Equiv.apply_symm_apply` for the
hom-set equivalence of the reflector adjunction, the unit of which is the derived completion
map. -/
theorem derivedCompletionUnit_comp_reflectorToCompletionFunctor :
    (derivedCompletionUnit X (generatedIdealSheaf g)).app K ≫
        reflectorToCompletionFunctor X g K =
      (completionUnit X g).app K :=
  ((derivedCompletionAdjunction X (generatedIdealSheaf g)).homEquiv_unit _ _ _).symm.trans
    (Equiv.apply_symm_apply _ _)

/-- **The reflector of [Stacks, Tag 099F] at a globally generated ideal sheaf is the Čech
completion of [Stacks, Tag 099B].** The canonical map between them is invertible, so
`K^∧ = R𝑆heafHom_𝒪(Č(g), K)` objectwise and compatibly with the two completion maps out of `K`.

Both objects are reflections of `K` into the derived-complete objects: composition with the
completion map is bijective onto the morphisms into a derived-complete object, for the Čech
completion by `AlgebraicGeometry.RingedSite.bijective_precomp_completionUnit_generatedIdealSheaf`
and for the reflector by
`AlgebraicGeometry.RingedSite.bijective_derivedCompletionUnit_comp`. Surjectivity of each
produces a map back, and injectivity of each identifies the two composites with the identities. -/
instance isIso_reflectorToCompletionFunctor :
    IsIso (reflectorToCompletionFunctor X g K) := by
  have hC : IsDerivedComplete.{u, u, u, u} X (generatedIdealSheaf g)
      ((completionFunctor X g).obj K) :=
    isDerivedComplete_generatedIdealSheaf_completionFunctor_obj X g K
  have hD : IsDerivedComplete.{u, u, u, u} X (generatedIdealSheaf g)
      ((derivedCompletion X (generatedIdealSheaf g)).obj K) :=
    isDerivedComplete_derivedCompletion_obj X (generatedIdealSheaf g) K
  obtain ⟨α, hα₀⟩ := (bijective_precomp_completionUnit_generatedIdealSheaf X g K _ hD).2
    ((derivedCompletionUnit X (generatedIdealSheaf g)).app K)
  have hα : (completionUnit X g).app K ≫ α =
      (derivedCompletionUnit X (generatedIdealSheaf g)).app K := hα₀
  refine ⟨α, ?_, ?_⟩
  · have h : (derivedCompletionUnit X (generatedIdealSheaf g)).app K ≫
        (reflectorToCompletionFunctor X g K ≫ α) =
      (derivedCompletionUnit X (generatedIdealSheaf g)).app K ≫
        𝟙 ((derivedCompletion X (generatedIdealSheaf g)).obj K) := by
      rw [← Category.assoc, derivedCompletionUnit_comp_reflectorToCompletionFunctor, hα,
        Category.comp_id]
    exact (bijective_derivedCompletionUnit_comp X (generatedIdealSheaf g) (K := K) hD).1 h
  · have h : (completionUnit X g).app K ≫ (α ≫ reflectorToCompletionFunctor X g K) =
      (completionUnit X g).app K ≫ 𝟙 ((completionFunctor X g).obj K) := by
      rw [← Category.assoc, hα, derivedCompletionUnit_comp_reflectorToCompletionFunctor,
        Category.comp_id]
    exact (bijective_precomp_completionUnit_generatedIdealSheaf X g K _ hC).1 h

/-- The comparison map of `AlgebraicGeometry.RingedSite.reflectorToCompletionFunctor` as an
isomorphism `K^∧ ≅ R𝑆heafHom_𝒪(Č(g), K)`. -/
def reflectorIsoCompletionFunctor :
    (derivedCompletion X (generatedIdealSheaf g)).obj K ≅ (completionFunctor X g).obj K :=
  asIso (reflectorToCompletionFunctor X g K)

end Reflector

section Pushforward

variable {X Y : RingedSite.{u, u, u}}
  [HasSheafify X.J AddCommGrpCat.{u}]
  [HasWeakSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor X.O)
      (ComplexShape.up ℤ)]
  [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify Y.J AddCommGrpCat.{u}]
  [HasWeakSheafify Y.J AddCommGrpCat.{u}]
  [Y.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} Y.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} Y.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} Y.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor Y.O)
      (ComplexShape.up ℤ)]
  [HasWeakSheafify Y.J CommRingCat.{u}]
  (f : RingedSite.Hom X Y) {r s : ℕ}
  (g : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
  (t : Fin s → Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u}))
  (hI : PushforwardIdealCompatible f (generatedIdealSheaf t) (generatedIdealSheaf g))

include hI in
/-- **`Rf_*` commutes with derived completion for an arbitrary object, at two sheaves of ideals
generated by finitely many global sections, with [Stacks, Tag 0944] as the only input.** Let
`f : (Sh(𝒟), 𝒪') ⟶ (Sh(𝒞), 𝒪)` be a morphism of ringed sites, let `ℐ = (t_1, …, t_s) ⊂ 𝒪` and
`ℐ' = (g_1, …, g_r) ⊂ 𝒪'` be the ideal sheaves generated by finite families of global sections
with `f^♯` carrying sections of `ℐ` into `ℐ'`, and let `K ∈ D(𝒪')` be **arbitrary**. Then
`Rf_*(K^∧) ≅ (Rf_*K)^∧`.

This is
`AlgebraicGeometry.RingedSite.nonempty_iso_derivedPushforward_derivedCompletion_of_isDerivedLimit`
of `FiniteTypeIdealPending099E.lean` with two of its three inputs discharged, and the two towers
specialised to the Koszul towers of the source's proof.

* **[Stacks, Tag 099F]**, there two instance binders, comes from the generators by
  `AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`, so no
  part of it appears in this signature and both derived completion functors are produced from the
  data.
* **[Stacks, Tag 0A0E]**, there the hypotheses `hsource` and `htarget`, is
  `isDerivedLimit_tensorDerivedDualSystem_derivedCompletion_generatedIdealSheaf` above on either
  site, at the Koszul towers on `g_1, …, g_r` and on `t_1, …, t_s`.
* **[Stacks, Tag 0A07]**, the exchange of `Rf_*` with `R lim`, is
  `Stacks.Cohomology.DerivedPushforwardOnRingedTopoi.isDerivedLimit_map_derivedPushforward`,
  which applies to a morphism of ringed sites with no extra hypothesis.
* **[Stacks, Tag 0944]** remains, as `hproj`: the projection formula levelwise, together with
  the identification of the pulled-back Koszul complexes.

Given those, the two sides are derived limits of isomorphic towers and the conclusion is the
uniqueness of derived limits, `Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_natIso`
([Stacks, Tag 0H9L]).

The conclusion is the display as the source writes it, an isomorphism of the two objects, and
not invertibility of the canonical comparison map
`AlgebraicGeometry.RingedSite.derivedCompletionPushforwardComparison`, which is what the source's
proof establishes; uniqueness of derived limits is not canonical. `hI` is the source's own
relation between the two ideal sheaves and is recorded rather than consumed: the derived-limit
argument does not use it, while the construction of the canonical comparison map does. -/
theorem nonempty_iso_derivedPushforward_derivedCompletion_generatedIdealSheaf_of_natIso
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    [HasCoproduct ((koszulPowerSystem X g ⋙ DerivedCategory.Q).obj)]
    [HasCoproduct ((koszulPowerSystem Y t ⋙ DerivedCategory.Q).obj)]
    (hproj : tensorDerivedDualSystem X
          (Stacks.SheafOfModules.canonicalDerivedTensorProduct X)
          (koszulPowerSystem X g ⋙ DerivedCategory.Q) K ⋙
        derivedPushforward.{u} f.toRingedToposSiteHom ≅
      tensorDerivedDualSystem Y
        (Stacks.SheafOfModules.canonicalDerivedTensorProduct Y)
        (koszulPowerSystem Y t ⋙ DerivedCategory.Q)
        ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) :
    Nonempty ((derivedPushforward.{u} f.toRingedToposSiteHom).obj
        ((derivedCompletion X (generatedIdealSheaf g)).obj K) ≅
      (derivedCompletion Y (generatedIdealSheaf t)).obj
        ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) := by
  have := hasProductsOfShape_nat_derivedCategory_ringSheaf.{u, u, u} X
  have := hasProductsOfShape_nat_derivedCategory_ringSheaf.{u, u, u} Y
  -- [Stacks, Tag 0A0E] on the source side, for the reflector.
  have hsource := isDerivedLimit_tensorDerivedDualSystem_koszulPowerSystem_completion X g K
  -- [Stacks, Tag 0A0E] on the target side, at `Rf_*K`.
  have htarget := isDerivedLimit_tensorDerivedDualSystem_koszulPowerSystem_completion Y t
    ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)
  -- [Stacks, Tag 0A07]: `Rf_*` carries the derived limit of the source tower to a derived limit.
  obtain ⟨hprod, hlim⟩ :=
    Stacks.Cohomology.DerivedPushforwardOnRingedTopoi.isDerivedLimit_map_derivedPushforward
      f.toRingedToposSiteHom f.isMorphismOfSites _ _ hsource
  have hprod' : HasProduct fun n : ℕ ↦ (tensorDerivedDualSystem X
      (Stacks.SheafOfModules.canonicalDerivedTensorProduct X)
      (koszulPowerSystem X g ⋙ DerivedCategory.Q) K ⋙
        derivedPushforward.{u} f.toRingedToposSiteHom).obj (op n) := hprod
  -- [Stacks, Tag 0H9L] at `hproj`: the two derived limits agree.
  obtain ⟨e⟩ := Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_natIso hlim htarget hproj
  exact ⟨(derivedPushforward.{u} f.toRingedToposSiteHom).mapIso
      (reflectorIsoCompletionFunctor X g K) ≪≫ e ≪≫
    (reflectorIsoCompletionFunctor Y t
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)).symm⟩

end Pushforward

end AlgebraicGeometry.RingedSite

end
