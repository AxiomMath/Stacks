-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v u' v' w

namespace HomologicalComplex

variable {V : Type u} [Category.{v} V] [Preadditive V] [HasZeroObject V] {ι : Type w}
  {c : ComplexShape ι} [DecidableEq ι]

/-- **A map of complexes matching two maps out of the degree-`j` terms commutes with the
induced maps to the object placed in degree `j`.** -/
theorem comp_mkHomToSingle {K L : HomologicalComplex V c} {j : ι} {A : V} (p : K.X j ⟶ A)
    (hp : ∀ i, c.Rel i j → K.d i j ≫ p = 0) (q : L.X j ⟶ A)
    (hq : ∀ i, c.Rel i j → L.d i j ≫ q = 0) (φ : K ⟶ L) (h : φ.f j ≫ q = p) :
    φ ≫ mkHomToSingle q hq = mkHomToSingle p hp := by
  refine to_single_hom_ext ?_
  rw [comp_f, mkHomToSingle_f, mkHomToSingle_f, ← Category.assoc, h]

section Map

variable {W : Type u'} [Category.{v'} W] [Preadditive W] [HasZeroObject W] (G : V ⥤ W)
  [G.Additive] {K : HomologicalComplex V c} {j : ι} {A : V}

omit [HasZeroObject V] [DecidableEq ι] [HasZeroObject W] in
/-- The hypothesis of `HomologicalComplex.mkHomToSingle`, transported along an additive
functor. -/
theorem map_d_comp_eq_zero {p : K.X j ⟶ A} (hp : ∀ i, c.Rel i j → K.d i j ≫ p = 0) (i : ι)
    (hi : c.Rel i j) : ((G.mapHomologicalComplex c).obj K).d i j ≫ G.map p = 0 := by
  rw [Functor.mapHomologicalComplex_obj_d, ← G.map_comp, hp i hi, G.map_zero]

/-- **An additive functor carries the map to an object placed in a single degree to the map to
its image placed in that degree.** -/
theorem map_mkHomToSingle (p : K.X j ⟶ A) (hp : ∀ i, c.Rel i j → K.d i j ≫ p = 0) :
    (G.mapHomologicalComplex c).map (mkHomToSingle p hp) ≫
        (singleMapHomologicalComplex G c j).hom.app A =
      mkHomToSingle (G.map p) (map_d_comp_eq_zero G hp) := by
  refine to_single_hom_ext ?_
  rw [comp_f, Functor.mapHomologicalComplex_map_f, mkHomToSingle_f, mkHomToSingle_f,
    singleMapHomologicalComplex_hom_app_self, G.map_comp, Category.assoc,
    Iso.inv_hom_id_map_assoc]

end Map

end HomologicalComplex

namespace CategoryTheory.AlternatingCech

variable {r : ℕ} {𝒜 : Type u} [Category.{v} 𝒜] [Preadditive 𝒜] [HasFiniteProducts 𝒜]

/-- **The degree-zero term of the extended alternating Čech complex is the factor at the empty
subset**, there being no other subset of cardinality zero. -/
def complexXZeroIso (F : Finset (Fin r) ⥤ 𝒜) : (complex F).X 0 ≅ F.obj ∅ :=
  productUniqueIso (fun S : Idx r 0 => F.obj S.1)

end CategoryTheory.AlternatingCech

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}] {r : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- **The augmentation `𝒪 ⟶ Č(f)^0` is an isomorphism**, with the identification
`AlgebraicGeometry.RingedSite.cechAugmentationZero` of `Completion.lean` for its inverse: the
degree-zero term is the single factor `𝒪_{f_∅}`, and `f_∅ = 1` is already invertible. -/
def unitIsoCechXZero : SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O) ≅
    (extendedAlternatingCech X f).X 0 :=
  unitIsoAwayModuleEmpty X f ≪≫
    (AlternatingCech.complexXZeroIso (awayLocalizationFunctor X f)).symm

/-- The isomorphism is the augmentation of the extended alternating Čech complex. -/
theorem unitIsoCechXZero_hom :
    (unitIsoCechXZero X f).hom = extendedAlternatingCechAugmentation X f :=
  (Iso.comp_inv_eq _).2 (extendedAlternatingCechAugmentation_comp_pi X f default).symm

/-- Its inverse is the identification of the degree-zero term with `𝒪` out of which the
augmentation `Č(f) ⟶ 𝒪` of `Completion.lean` is built. -/
theorem unitIsoCechXZero_inv :
    (unitIsoCechXZero X f).inv = cechAugmentationZero X f :=
  rfl

/-- **The augmentation `𝒪 ⟶ Č(f)^0` of the extended alternating Čech complex is an
isomorphism.** -/
theorem isIso_extendedAlternatingCechAugmentation :
    IsIso (extendedAlternatingCechAugmentation X f) :=
  unitIsoCechXZero_hom X f ▸ (inferInstance : IsIso (unitIsoCechXZero X f).hom)

section Restrict

attribute [local instance] additive_overFunctor

variable (U : X.C) [HasWeakSheafify (X.over U).J CommRingCat.{u}]

/-- **The restriction to a slice of a map of complexes of `𝒪`-modules to the structure sheaf
placed in degree zero.** -/
def restrictStructureSheafMap {K : CochainComplex (SheafOfModules.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ}
    (a : K ⟶ structureSheafComplex X) :
    ((SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj K ⟶ structureSheafComplex (X.over U) :=
  ((SheafOfModules.overFunctor.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U).mapHomologicalComplex
      (ComplexShape.up ℤ)).map a ≫
    (HomologicalComplex.singleMapHomologicalComplex
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U)
          (ComplexShape.up ℤ) 0).hom.app
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O))

/-- **`Č(f)|_U ≅ Č(f|_U)` carries the restriction of the augmentation `Č(f) ⟶ 𝒪` to the
augmentation `Č(f|_U) ⟶ 𝒪_U`.**

Both augmentations are `HomologicalComplex.mkHomToSingle` of the identification of the
degree-zero term with the structure sheaf, so by `HomologicalComplex.map_mkHomToSingle` and
`HomologicalComplex.comp_mkHomToSingle` the statement reduces to that identification, where it
is `AlgebraicGeometry.RingedSite.overFunctor_map_extendedAlternatingCechAugmentation_comp` read
through the inverse of the augmentation `𝒪 ⟶ Č^0`. -/
theorem restrictStructureSheafMap_cechAugmentation :
    restrictStructureSheafMap X U (cechAugmentation X f) =
      (extendedAlternatingCechOverIso X U f).hom ≫
        cechAugmentation (X.over U) (fun i ↦ globalSectionOver X U (f i)) :=
  have hkey : (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U).map
        (unitIsoCechXZero X f).hom ≫ (extendedAlternatingCechOverIso X U f).hom.f 0 =
      (unitIsoCechXZero (X.over U) (fun i ↦ globalSectionOver X U (f i))).hom :=
    (congrArg (fun m => (SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U).map m ≫
        (extendedAlternatingCechOverIso X U f).hom.f 0) (unitIsoCechXZero_hom X f)).trans
      ((overFunctor_map_extendedAlternatingCechAugmentation_comp X U f).trans
        (unitIsoCechXZero_hom (X.over U) (fun i ↦ globalSectionOver X U (f i))).symm)
  (HomologicalComplex.map_mkHomToSingle _ _ _).trans
    (HomologicalComplex.comp_mkHomToSingle _ _ _ _ _
      ((Iso.comp_inv_eq _).2 ((Iso.eq_inv_comp
        ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U).mapIso
          (unitIsoCechXZero X f))).2 hkey))).symm

end Restrict

section Global

attribute [local instance] HasDerivedCategory.standard additive_overFunctor

/-- **The condition of [Stacks, Tag 099E]** on a map `a : K ⟶ 𝒪` of complexes of sheaves of
`𝒪`-modules: for every object `U` of the site and every finite family `g_1, …, g_s` of sections
of `𝒪` over `U` generating `ℐ|_U` there is an isomorphism

`Č(g_1, …, g_s) ≅ K|_U`

in `D(𝒪_U)`, compatible with the maps to `𝒪_U`.

The family is quantified universally and the isomorphism asserted to exist for each one, as in
the source; no choice of a system of isomorphisms, and no choice of a generating family, is part
of the condition. -/
def IsGlobalExtendedCech (ℐ : SheafOfModules.Submodule (SheafOfModules.unit
    ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ)
    (a : K ⟶ structureSheafComplex X) :
    Prop :=
  ∀ (U : X.C) [HasWeakSheafify (X.over U).J CommRingCat.{u}] (s : ℕ)
    (g : Fin s → Presheaf.globalSections ((X.over U).O.obj ⋙ forget CommRingCat.{u})),
    idealOfGlobalSections (X.over U) g = overIdeal ℐ U →
      ∃ e : DerivedCategory.Q.obj (extendedAlternatingCech (X.over U) g) ≅
          DerivedCategory.Q.obj
            (((SheafOfModules.overFunctor.{u}
                ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) U).mapHomologicalComplex
              (ComplexShape.up ℤ)).obj K),
        e.hom ≫ DerivedCategory.Q.map (restrictStructureSheafMap X U a) =
          DerivedCategory.Q.map (cechAugmentation (X.over U) g)

/-- **Independence of the chosen finite generating family**, relative to the family
`f_1, …, f_r`: on every slice `𝒞/U`, the extended alternating Čech complex of any finite family
of sections generating `ℐ|_U` agrees, in `D(𝒪_U)` and compatibly with the augmentations to
`𝒪_U`, with the extended alternating Čech complex of the restricted family `f|_U`.

This is the one input of [Stacks, Tag 099E] which the Čech machinery of `CechSliceRestriction`
does not supply; it is proved below, for `ℐ` generated by finitely many global sections. It
is a statement about sheaves of modules on a ringed site, and in particular it is *not* a choice
of generating family functorial in the object, which
`StacksFrontier/RingTheory/Cech/FunctorialCechFamilyObstruction.lean` shows cannot exist. -/
def CechIndependentOfRestriction
    (ℐ : SheafOfModules.Submodule (SheafOfModules.unit
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) : Prop :=
  ∀ (U : X.C) [HasWeakSheafify (X.over U).J CommRingCat.{u}] (s : ℕ)
    (g : Fin s → Presheaf.globalSections ((X.over U).O.obj ⋙ forget CommRingCat.{u})),
    idealOfGlobalSections (X.over U) g = overIdeal ℐ U →
      ∃ e : DerivedCategory.Q.obj (extendedAlternatingCech (X.over U) g) ≅
          DerivedCategory.Q.obj (extendedAlternatingCech (X.over U)
            (fun i ↦ globalSectionOver X U (f i))),
        e.hom ≫ DerivedCategory.Q.map (cechAugmentation (X.over U)
            (fun i ↦ globalSectionOver X U (f i))) =
          DerivedCategory.Q.map (cechAugmentation (X.over U) g)

omit [HasWeakSheafify X.J CommRingCat.{u}] in
/-- **The Čech complex on a slice depends only on the ideal sheaf the generating family
generates**, for `ℐ = (f_1, …, f_r)` generated by finitely many global sections of `𝒪`: on every
slice `𝒞/U`, the extended alternating Čech complex of any finite family of sections generating
`ℐ|_U` agrees in `D(𝒪_U)`, compatibly with the augmentations, with that of the restricted family
`f|_U`.

Three inputs, each proved elsewhere. The restricted family does generate `ℐ|_U`
(`AlgebraicGeometry.RingedSite.overIdeal_idealOfGlobalSections`), so the two families generate
the same sheaf of ideals on the slice; two such families give isomorphic objects of `D(𝒪_U)` over
`𝒪_U` for the sheafification of the presheaf of Čech complexes
(`AlgebraicGeometry.RingedSite.exists_iso_sheafifiedCech_of_idealOfGlobalSections_eq`); and that
object is the extended alternating Čech complex the tag displays
(`AlgebraicGeometry.RingedSite.sheafifiedCechIsoExtendedAlternatingCech`) compatibly with the two
augmentations by
`AlgebraicGeometry.RingedSite.sheafifiedCechIsoExtendedAlternatingCech_hom_comp_cechAugmentation`,
so the isomorphism over `𝒪_U` transports from the one spelling to the other. -/
theorem cechIndependentOfRestriction_idealOfGlobalSections :
    CechIndependentOfRestriction X f (idealOfGlobalSections X f) := by
  intro U _ s g hg
  obtain ⟨e, he⟩ := exists_iso_sheafifiedCech_of_idealOfGlobalSections_eq (X.over U) g
    (fun i => globalSectionOver X U (f i)) (hg.trans (overIdeal_idealOfGlobalSections X U f))
  refine ⟨(DerivedCategory.Q.mapIso
        (sheafifiedCechIsoExtendedAlternatingCech (X.over U) g)).symm ≪≫ e ≪≫
      DerivedCategory.Q.mapIso (sheafifiedCechIsoExtendedAlternatingCech (X.over U)
        (fun i => globalSectionOver X U (f i))), ?_⟩
  rw [Iso.trans_hom, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_inv, Functor.mapIso_hom,
    Category.assoc, Category.assoc, ← Functor.map_comp,
    sheafifiedCechIsoExtendedAlternatingCech_hom_comp_cechAugmentation, he,
    ← sheafifiedCechIsoExtendedAlternatingCech_hom_comp_cechAugmentation (X.over U) g,
    ← Functor.map_comp, Iso.inv_hom_id_assoc]

/-- **For an ideal sheaf generated by finitely many global sections the object of
[Stacks, Tag 099E] can be taken to be the Čech complex of the generators.** If
`ℐ = (f_1, …, f_r)` for finitely many global sections of `𝒪`, then the extended alternating Čech
complex `Č(f)` of those sections, with its augmentation to `𝒪`, has the property the tag
asserts: on every object `U` carrying a finite family generating `ℐ|_U`, its restriction is the
extended alternating Čech complex of that family in `D(𝒪_U)`, compatibly with the maps to `𝒪_U`.

Two inputs. The restriction of `Č(f)` to the slice *is* the Čech complex of the restricted
family, compatibly with the augmentations
(`AlgebraicGeometry.RingedSite.restrictStructureSheafMap_cechAugmentation`); and the Čech
complex of an arbitrary generating family agrees with that of the restricted family, which is
`AlgebraicGeometry.RingedSite.cechIndependentOfRestriction_idealOfGlobalSections` above. The tag
itself, for an arbitrary sheaf of ideals, is
`AlgebraicGeometry.RingedSite.exists_isGlobalExtendedCech` of `FiniteTypeExtendedCech.lean`, whose
object is the sheafified colimit of the Čech complexes of all local generators; this statement
records that for a globally generated `ℐ` the Čech complex of one generating family already
serves. -/
theorem exists_isGlobalExtendedCech_idealOfGlobalSections :
    ∃ (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ)
      (a : K ⟶ structureSheafComplex X),
      IsGlobalExtendedCech X (idealOfGlobalSections X f) K a :=
  have hind : CechIndependentOfRestriction X f (idealOfGlobalSections X f) :=
    cechIndependentOfRestriction_idealOfGlobalSections X f
  ⟨extendedAlternatingCech X f, cechAugmentation X f, fun U _ s g hg =>
    have key : (extendedAlternatingCechOverIso X U f).inv ≫
        restrictStructureSheafMap X U (cechAugmentation X f) =
        cechAugmentation (X.over U) (fun i ↦ globalSectionOver X U (f i)) :=
      (Iso.inv_comp_eq _).2 (restrictStructureSheafMap_cechAugmentation X f U)
    let e₀ := (hind U s g hg).choose
    ⟨e₀ ≪≫ (DerivedCategory.Q.mapIso (extendedAlternatingCechOverIso X U f)).symm,
      (Category.assoc _ _ _).trans
        ((congrArg (fun m => e₀.hom ≫ m)
          ((DerivedCategory.Q.map_comp _ _).symm.trans
            (congrArg (fun m => DerivedCategory.Q.map m) key))).trans
          (hind U s g hg).choose_spec)⟩⟩

end Global

end AlgebraicGeometry.RingedSite

