module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.CompletionUnitIso
public import StacksFrontier.CategoryTheory.Sites.Cohomology.InternalHom.DerivedCurrying

/-!
# Objects killed by the Čech complex see no derived-complete object

Let `(𝒞, 𝒪)` be a ringed site, let `f_1, …, f_r` be global sections of `𝒪` and let `Č(f)` be the
extended alternating Čech complex they span. If `M ⊗^𝐋_𝒪 Č(f)` vanishes then there is no
non-zero map from `M` into an object `Y` of `D(𝒪)` which is derived complete along the ideal
sheaf generated by the `f_i`.

This is the half of the proof of [Stacks, Tag 099I] which turns the Čech comparison
[Stacks, Tag 099H] into a statement about morphism groups.

## Main results

* `AlgebraicGeometry.RingedSite.subsingleton_hom_of_isZero_derivedTensor_extendedAlternatingCech`:
  the statement above.

## Implementation notes

Nothing is constructed. The completion functor `K ↦ K^∧` of [Stacks, Tag 099B] is by definition
`R𝑆heafHom_𝒪(Č(f), -)`, so the tensor–internal-Hom bijection of [Stacks, Tag 08J8],
`AlgebraicGeometry.RingedSite.derivedCurryHomEquiv`, reads

`Hom_{D(𝒪)}(M, Y^∧) ≃ Hom_{D(𝒪)}(M ⊗^𝐋_𝒪 Č(f), Y)`,

whose right-hand side is a singleton when the derived tensor product vanishes. A derived
complete `Y` is its own completion, by
`AlgebraicGeometry.RingedSite.isIso_completionUnit_app_of_isDerivedComplete_idealOfGlobalSections`,
so the left-hand side is `Hom_{D(𝒪)}(M, Y)`.

## References

* [Stacks Project, Tag 08J8](https://stacks.math.columbia.edu/tag/08J8)
* [Stacks Project, Tag 099B](https://stacks.math.columbia.edu/tag/099B)
* [Stacks Project, Tag 099I](https://stacks.math.columbia.edu/tag/099I)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u,
    u} X.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor X.O)
      (ComplexShape.up ℤ)]
  {r : ℕ} (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

attribute [local instance] HasDerivedCategory.standard

-- The finite (co)products of `D(O)` are those of its triangulated structure, as in the lemmas
-- used below, and not those of the instances of Stacks 07D9.
attribute [-instance] Stacks.Injectives.hasCoproducts_derivedCategory
  Stacks.Injectives.hasProducts_derivedCategory

/-- **An object killed by the Čech complex admits no non-zero map into a derived-complete
object.** If `M ⊗^𝐋_𝒪 Č(f)` is a zero object and `Y` is derived complete along the ideal sheaf
generated by `f_1, …, f_r`, then `M ⟶ Y` has at most one element.

The tensor–internal-Hom bijection of [Stacks, Tag 08J8] identifies `Hom(M, Y^∧)` with
`Hom(M ⊗^𝐋_𝒪 Č(f), Y)`, which is a singleton, and the completion map `Y ⟶ Y^∧` is invertible
because `Y` is derived complete. -/
theorem subsingleton_hom_of_isZero_derivedTensor_extendedAlternatingCech
    (M Y : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hM : IsZero (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj M).obj
      (DerivedCategory.Q.obj (extendedAlternatingCech X f))))
    (hY : IsDerivedComplete.{u, u, u, u} X (idealOfGlobalSections X f) Y) :
    Subsingleton (M ⟶ Y) := by
  have : IsIso ((completionUnit X f).app Y) :=
    isIso_completionUnit_app_of_isDerivedComplete_idealOfGlobalSections X f Y hY
  have hcompl : Subsingleton (M ⟶ (completionFunctor X f).obj Y) :=
    ⟨fun a b => (derivedCurryHomEquiv X M
      (DerivedCategory.Q.obj (extendedAlternatingCech X f)) Y).injective
        (hM.eq_of_src _ _)⟩
  refine ⟨fun a b => ?_⟩
  have h := hcompl.elim (a ≫ (completionUnit X f).app Y) (b ≫ (completionUnit X f).app Y)
  exact (cancel_mono ((completionUnit X f).app Y)).mp h

end AlgebraicGeometry.RingedSite

end
