-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v u r

section Transfer

variable {A A' : Type*} [CommSemiring A] [CommSemiring A']
  {D D' : Type*} [Category D] [Category D'] [Preadditive D] [Preadditive D']
  [Linear A D] [Linear A' D'] [HasProductsOfShape ℕ D] [HasProductsOfShape ℕ D']

/-- An additive functor `G` carrying the scalar `a'` to the scalar `a`, in the sense that it
takes multiplication by `a'` on `L` to multiplication by `a` on `G L`, intertwines the two
difference maps `1 - a' · shift` and `1 - a · shift` through the comparison of the countable
products. -/
theorem oneSubSmulShift_map_comp_piComparison (G : D' ⥤ D) [G.Additive]
    {L : D'} {a' : A'} {a : A} (hsmul : G.map (a' • 𝟙 L) = a • 𝟙 (G.obj L)) :
    G.map (oneSubSmulShift L a') ≫ piComparison G (fun _ : ℕ ↦ L) =
      piComparison G (fun _ : ℕ ↦ L) ≫ oneSubSmulShift (G.obj L) a := by
  have haux : ∀ n : ℕ, (a' • Pi.π (fun _ : ℕ ↦ L) n)
      = Pi.π (fun _ : ℕ ↦ L) n ≫ (a' • 𝟙 L) := by
    intro n
    rw [Linear.comp_smul, Category.comp_id]
  apply Limits.Pi.hom_ext
  intro n
  rw [Category.assoc, piComparison_comp_π, ← Functor.map_comp, oneSubSmulShift_π,
    Functor.map_sub, haux, Functor.map_comp, hsmul, Linear.comp_smul, Category.comp_id,
    Category.assoc, oneSubSmulShift_π, Preadditive.comp_sub, piComparison_comp_π,
    Linear.comp_smul, piComparison_comp_π]

/-- `T(L, a') = 0` implies `T(G L, a) = 0` for an additive functor `G` which preserves countable
products and takes multiplication by `a'` to multiplication by `a`. -/
theorem isDerivedCompleteAt_map_of_smul_id (G : D' ⥤ D) [G.Additive]
    [PreservesLimitsOfShape (Discrete ℕ) G] {L : D'} {a' : A'} {a : A}
    (hsmul : G.map (a' • 𝟙 L) = a • 𝟙 (G.obj L)) (h : IsDerivedCompleteAt L a') :
    IsDerivedCompleteAt (G.obj L) a := by
  rw [isDerivedCompleteAt_iff_isIso] at h ⊢
  have hc : IsIso (piComparison G (fun _ : ℕ ↦ L)) := inferInstance
  have h1 : IsIso (G.map (oneSubSmulShift L a') ≫ piComparison G (fun _ : ℕ ↦ L)) := by
    have := G.map_isIso (oneSubSmulShift L a')
    infer_instance
  rw [oneSubSmulShift_map_comp_piComparison G hsmul] at h1
  exact IsIso.of_isIso_comp_left (piComparison G (fun _ : ℕ ↦ L)) _

end Transfer

namespace AlgebraicGeometry.RingedSite

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {R R' : Sheaf J RingCat.{r}} (α : R ⟶ R')

/-- The sheaf of ideals `ℐ𝒪'` of `𝒪'`: the smallest sheaf of ideals of `𝒪'` containing the image
of a sheaf of ideals `ℐ` of `𝒪` under a homomorphism of sheaves of rings `𝒪 ⟶ 𝒪'`. -/
def extendIdeal (I : SheafOfModules.Submodule (SheafOfModules.unit R)) :
    SheafOfModules.Submodule (SheafOfModules.unit R') :=
  sInf {I' | ∀ (U : Cᵒᵖ) (f : R.obj.obj U), f ∈ I.toSubmodule.obj U →
    α.hom.app U f ∈ I'.toSubmodule.obj U}

/-- The image of a local section of `ℐ` is a local section of `ℐ𝒪'`. -/
theorem mem_extendIdeal_of_mem (I : SheafOfModules.Submodule (SheafOfModules.unit R))
    (U : Cᵒᵖ) (f : R.obj.obj U) (hf : f ∈ I.toSubmodule.obj U) :
    α.hom.app U f ∈ (extendIdeal α I).toSubmodule.obj U := by
  have key : ∀ (S : Set (SheafOfModules.Submodule (SheafOfModules.unit R')))
      (x : (SheafOfModules.unit R').val.obj U),
      (∀ N ∈ S, x ∈ N.toSubmodule.obj U) → x ∈ (sInf S).toSubmodule.obj U := by
    intro S x hx
    rw [SheafOfModules.Submodule.toSubmodule_sInf, PresheafOfModules.Submodule.sInf_obj]
    refine (Submodule.mem_iInf _).2 fun N ↦ (Submodule.mem_iInf _).2 ?_
    rintro ⟨N₀, hN₀, rfl⟩
    exact hx N₀ hN₀
  exact key _ _ fun _ hN ↦ hN U f hf

/-- `ℐ𝒪'` is contained in every sheaf of ideals of `𝒪'` containing the image of `ℐ`. -/
theorem extendIdeal_le (I : SheafOfModules.Submodule (SheafOfModules.unit R))
    (I' : SheafOfModules.Submodule (SheafOfModules.unit R'))
    (h : ∀ (U : Cᵒᵖ) (f : R.obj.obj U), f ∈ I.toSubmodule.obj U →
      α.hom.app U f ∈ I'.toSubmodule.obj U) :
    extendIdeal α I ≤ I' :=
  sInf_le h

/-- Restriction of scalars along `𝒪 ⟶ 𝒪'` commutes with restriction to the slice site over an
object, the two composites being equal functors: both send a sheaf of `𝒪'`-modules to its
sections over the slice site, read as a sheaf of modules over the restriction of `𝒪`. -/
theorem restrictScalars_comp_overFunctor (U : C) :
    SheafOfModules.restrictScalars.{w} α ⋙ SheafOfModules.overFunctor.{w} R U =
      SheafOfModules.overFunctor.{w} R' U ⋙
        SheafOfModules.restrictScalars.{w} ((J.overPullback RingCat.{r} U).map α) :=
  rfl

section Sections

open scoped IsMulCommutative

variable [∀ U, IsMulCommutative (R.obj.obj U)] [∀ U, IsMulCommutative (R'.obj.obj U)]

/-- Restriction of scalars along `𝒪 ⟶ 𝒪'` takes multiplication by a compatible family of local
sections of `𝒪'` to multiplication by any compatible family of local sections of `𝒪` mapping to
it. -/
theorem restrictScalars_map_globalSectionToEnd
    (g : (R.obj ⋙ forget RingCat).sections) (g' : (R'.obj ⋙ forget RingCat).sections)
    (hg : ∀ U, α.hom.app U (g.val U) = g'.val U) (M : SheafOfModules.{w} R') :
    (SheafOfModules.restrictScalars.{w} α).map
        ((Stacks.SheafOfModules.globalSectionToEnd R' g').app M) =
      (Stacks.SheafOfModules.globalSectionToEnd R g).app
        ((SheafOfModules.restrictScalars.{w} α).obj M) := by
  ext V x
  exact congrArg (fun s : R'.obj.obj V ↦ s • (show M.val.obj V from x)) (hg V).symm

/-- Restriction of scalars along `𝒪 ⟶ 𝒪'` takes multiplication by the image in `𝒪'` of a section
`f` of `𝒪` over a terminal object to multiplication by `f`: it does not matter whether `f` is
read as a section of `𝒪` or as a section of `𝒪'`. -/
theorem restrictScalars_map_terminalSectionToEnd
    (T : C) (hT : IsTerminal T) (f : R.obj.obj (op T)) (M : SheafOfModules.{w} R') :
    (SheafOfModules.restrictScalars.{w} α).map
        ((Stacks.SheafOfModules.terminalSectionToEnd R' T hT
          (α.hom.app (op T) f)).app M) =
      (Stacks.SheafOfModules.terminalSectionToEnd R T hT f).app
        ((SheafOfModules.restrictScalars.{w} α).obj M) := by
  refine restrictScalars_map_globalSectionToEnd α _ _ (fun U ↦ ?_) M
  show α.hom.app U (R.obj.map (hT.from U.unop).op f)
    = R'.obj.map (hT.from U.unop).op (α.hom.app (op T) f)
  rw [← RingCat.comp_apply, ← RingCat.comp_apply, α.hom.naturality]

end Sections

end AlgebraicGeometry.RingedSite

namespace Stacks.SheafOfModules.DerivedRestrictScalars

open _root_.AlgebraicGeometry
open scoped IsMulCommutative

attribute [local instance] HasDerivedCategory.standard

section Identity

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)

/-- The identity functor of a site is a morphism of sites from that site to itself: it is
continuous, and the functor it induces on sheaves of sets, being a left adjoint of the identity
functor, is isomorphic to it and so exact. -/
theorem isMorphismOfSites_id : (𝟭 C).IsMorphismOfSites J J := by
  rw [Functor.isMorphismOfSites_iff_preservesFiniteLimits]
  exact preservesFiniteLimits_of_natIso
    (((𝟭 C).sheafAdjunctionContinuous (Type u) J J).leftAdjointUniq
      (Adjunction.id (C := Sheaf J (Type u)))).symm

end Identity

section Transfer

variable {A A' A'' : Type*} [Category A] [Category A'] [Category A''] [Abelian A] [Abelian A']
  [Abelian A''] [HasDerivedCategory A] [HasDerivedCategory A'] [HasDerivedCategory A'']

/-- A linear functor carries the scalar `a • 𝟙 X` to `a • 𝟙 (F X)`. -/
private theorem map_smul_id {R : Type*} [Semiring R] {C D : Type*} [Category C] [Category D]
    [Preadditive C] [Preadditive D] [Linear R C] [Linear R D] (F : C ⥤ D) [F.Additive]
    [F.Linear R] (a : R) (X : C) : F.map (a • 𝟙 X) = a • 𝟙 (F.obj X) := by
  rw [Functor.Linear.map_smul, CategoryTheory.Functor.map_id]

/-- Conjugating a scalar by an isomorphism gives the scalar. -/
private theorem inv_comp_smul_id_comp_hom {R : Type*} [Semiring R] {C : Type*} [Category C]
    [Preadditive C] [Linear R C] (a : R) {X Y : C} (e : X ≅ Y) :
    e.inv ≫ (a • 𝟙 X) ≫ e.hom = a • 𝟙 Y := by
  rw [Linear.smul_comp, Linear.comp_smul, Category.id_comp, e.inv_hom_id]

/-- The functor induced on derived categories by a composite of exact functors is the composite
of the induced functors. -/
noncomputable def mapDerivedCategoryCompIso (F : A'' ⥤ A') (G : A' ⥤ A) [F.Additive]
    [PreservesFiniteLimits F] [PreservesFiniteColimits F] [G.Additive]
    [PreservesFiniteLimits G] [PreservesFiniteColimits G] :
    (F ⋙ G).mapDerivedCategory ≅ F.mapDerivedCategory ⋙ G.mapDerivedCategory := by
  refine (Localization.liftNatIso DerivedCategory.Q (HomologicalComplex.quasiIso A'' (.up ℤ))
    (DerivedCategory.Q ⋙ (F.mapDerivedCategory ⋙ G.mapDerivedCategory))
    (DerivedCategory.Q ⋙ (F ⋙ G).mapDerivedCategory) _ _ ?_).symm
  exact Functor.isoWhiskerRight F.mapDerivedCategoryFactors G.mapDerivedCategory ≪≫
    Functor.isoWhiskerLeft (F.mapHomologicalComplex (.up ℤ)) G.mapDerivedCategoryFactors ≪≫
    (F ⋙ G).mapDerivedCategoryFactors.symm

/-- **The derived form of a scalar match.** An exact functor which, degreewise on cochain
complexes, carries multiplication by `a'` to multiplication by `a` carries multiplication by `a'`
to multiplication by `a` on the derived category too: every object of the derived category is the
image of a cochain complex, and multiplication by a scalar is natural. -/
theorem mapDerivedCategory_map_smul_id {R R' : Type*} [Ring R] [Ring R'] [Linear R A]
    [Linear R' A'] (G : A' ⥤ A) [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G] (a' : R') (a : R)
    (hcx : ∀ Z : CochainComplex A' ℤ,
      (G.mapHomologicalComplex (ComplexShape.up ℤ)).map (a' • 𝟙 Z) =
        a • 𝟙 ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj Z))
    (L : DerivedCategory A') :
    G.mapDerivedCategory.map (a' • 𝟙 L) = a • 𝟙 (G.mapDerivedCategory.obj L) := by
  have key : ∀ Z : CochainComplex A' ℤ,
      G.mapDerivedCategory.map (a' • 𝟙 (DerivedCategory.Q.obj Z)) =
        a • 𝟙 (G.mapDerivedCategory.obj (DerivedCategory.Q.obj Z)) := by
    intro Z
    have hnat := G.mapDerivedCategoryFactors.hom.naturality (a' • 𝟙 Z)
    simp only [Functor.comp_map] at hnat
    rw [map_smul_id DerivedCategory.Q a' Z, hcx Z, map_smul_id DerivedCategory.Q a] at hnat
    have h2 : G.mapDerivedCategoryFactors.hom.app Z ≫ (a • 𝟙 _) ≫
        G.mapDerivedCategoryFactors.inv.app Z =
        G.mapDerivedCategory.map (a' • 𝟙 (DerivedCategory.Q.obj Z)) := by
      rw [← Category.assoc]
      simp only [Functor.comp_obj]
      rw [← hnat, Category.assoc, Iso.hom_inv_id_app, Category.comp_id]
    rw [← h2]
    simp only [Linear.comp_smul, Linear.smul_comp, Category.id_comp, Iso.hom_inv_id_app,
      Functor.comp_obj]
  obtain ⟨Z, ⟨e⟩⟩ : ∃ Z : CochainComplex A' ℤ, Nonempty (DerivedCategory.Q.obj Z ≅ L) :=
    ⟨DerivedCategory.Q.objPreimage L, ⟨DerivedCategory.Q.objObjPreimageIso L⟩⟩
  rw [← inv_comp_smul_id_comp_hom a' e, G.mapDerivedCategory.map_comp,
    G.mapDerivedCategory.map_comp, key Z]
  exact inv_comp_smul_id_comp_hom a (G.mapDerivedCategory.mapIso e)

end Transfer

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  {O O' : Sheaf J CommRingCat.{u}}

open RingedToposSiteHom (coefficientChange)

omit [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The pushforward of sheaves of modules along `coefficientChange J α` is restriction of
scalars along the homomorphism of sheaves of not necessarily commutative rings underlying
`α`. -/
theorem pushforwardTopos_coefficientChange (α : O ⟶ O') :
    (coefficientChange J α).pushforwardTopos =
      _root_.SheafOfModules.restrictScalars.{u}
        ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map α) :=
  rfl

/-- **Restriction of scalars commutes with countable products in the derived category.** For a
homomorphism `𝒪 ⟶ 𝒪'` of sheaves of commutative rings on a small site, the functor
`D(𝒪') ⟶ D(𝒪)` induced by restriction of scalars preserves countable products.

Restriction of scalars is the pushforward of sheaves of modules along the morphism of ringed
topoi which `𝒪 ⟶ 𝒪'` defines over the identity of the site, so the derived pushforward `Rf_*` of
[Stacks, Tag 07A6] is right adjoint to the derived pullback `Lf^*` of [Stacks, Tag 06YY], which
exists for every morphism of ringed topoi. Restriction of scalars is exact, so the functor it
induces on derived categories is itself a right derived functor of the degreewise pushforward and
is therefore isomorphic to `Rf_*`; and a right adjoint preserves every limit that exists. -/
theorem preservesProducts_mapDerivedCategory (α : O ⟶ O') :
    PreservesLimitsOfShape (Discrete ℕ)
      (_root_.SheafOfModules.restrictScalars.{u}
        ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map α)).mapDerivedCategory := by
  have hmos : (coefficientChange J α).u.IsMorphismOfSites
      (Cohomology.ringedTopos J O).J (Cohomology.ringedTopos J O').J :=
    isMorphismOfSites_id J
  have hadd : (coefficientChange J α).pushforwardTopos.Additive :=
    RingedToposSiteHom.pushforwardTopos_additive _
  have hlim : PreservesFiniteLimits (coefficientChange J α).pushforwardTopos :=
    inferInstanceAs (PreservesFiniteLimits
      (_root_.SheafOfModules.restrictScalars.{u} (coefficientChange J α).fSharpRing))
  have hcol : PreservesFiniteColimits (coefficientChange J α).pushforwardTopos :=
    inferInstanceAs (PreservesFiniteColimits
      (_root_.SheafOfModules.restrictScalars.{u} (coefficientChange J α).fSharpRing))
  have hLf :=
    Cohomology.DerivedPullbackOnRingedTopoi.hasLeftDerivedFunctor_pullbackOnHomotopy
      (coefficientChange J α) hmos
  have adj := Cohomology.DerivedPullbackPushforwardAdjunction.derivedPullbackPushforwardAdjunction
    (coefficientChange J α) Cohomology.DerivedPullbackPushforwardAdjunction.IsKFlat
    Cohomology.DerivedPullbackPushforwardAdjunction.hasResolutions_isKFlat
    (Cohomology.DerivedPullbackOnRingedTopoi.pullbackInvertsQuasiIso_isKFlat
      (coefficientChange J α) hmos)
  have hprod : PreservesLimitsOfShape (Discrete ℕ)
      (Cohomology.DerivedPullbackPushforwardAdjunction.derivedPushforward
        (coefficientChange J α)) :=
    (adj.rightAdjoint_preservesLimits).preservesLimitsOfShape
  have hrd := Functor.isRightDerivedFunctor_mapDerivedCategory_of_exact
    (coefficientChange J α).pushforwardTopos
  have e : Cohomology.DerivedPullbackPushforwardAdjunction.derivedPushforward
        (coefficientChange J α) ≅
      (coefficientChange J α).pushforwardTopos.mapDerivedCategory :=
    Functor.rightDerivedUnique _ _
      (Cohomology.DerivedPullbackPushforwardAdjunction.derivedPushforwardUnit
        (coefficientChange J α))
      (coefficientChange J α).pushforwardTopos.mapDerivedCategoryFactorsh.inv
      (HomotopyCategory.quasiIso
        (_root_.SheafOfModules.{u}
          (Stacks.SheafOfModules.Tensor.ringSheaf (Cohomology.ringedTopos J O').O))
        (ComplexShape.up ℤ))
  exact @preservesLimitsOfShape_of_natIso _ _ _ _ _ _ _ _ e hprod

/-- A sheaf of commutative rings on a site, read as a ringed site on that site. -/
abbrev ringedSite (J : GrothendieckTopology C) (O : Sheaf J CommRingCat.{u}) :
    RingedSite.{u, u, u} where
  C := C
  J := J
  O := O

/-- The homomorphism of sheaves of rings underlying a homomorphism of sheaves of commutative
rings, read between the structure sheaves of the two ringed sites. -/
abbrev ringSheafHom (α : O ⟶ O') :
    (Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O).O) ⟶
      (Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O').O) :=
  (sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map α

/-- **[Stacks, Tag 099C], the inclusion `D_comp(𝒪', ℐ𝒪') ⊆` the inverse image of
`D_comp(𝒪, ℐ)`.** A complex of `𝒪'`-modules which is derived complete along the extension
`ℐ𝒪'` of a sheaf of ideals `ℐ ⊂ 𝒪` restricts to a complex of `𝒪`-modules which is derived
complete along `ℐ`.

A local section `f` of `ℐ` has its image in `ℐ𝒪'` by `extendIdeal`, so the hypothesis gives
`T(E|_U, f) = 0` computed over `𝒪'`. Restriction of scalars commutes with restriction to the
slice site over `U`, and it carries multiplication by the image of `f` to multiplication by `f`,
so the two difference maps `1 - f·shift` correspond; since restriction of scalars commutes with
the countable products of the derived categories, invertibility transfers. -/
@[stacks 099C "the inclusion D_comp(𝒪', ℐ𝒪') ⊆ the inverse image of D_comp(𝒪, ℐ)"]
theorem isDerivedComplete_restrictScalars_of_extendIdeal (α : O ⟶ O')
    (I : _root_.SheafOfModules.Submodule
      (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O).O))))
    (E : DerivedCategory
      (_root_.SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O').O))))
    (h : RingedSite.IsDerivedComplete.{u, u, u, u} (ringedSite J O')
      (RingedSite.extendIdeal (ringSheafHom (O := O) (O' := O') α) I) E) :
    RingedSite.IsDerivedComplete.{u, u, u, u} (ringedSite J O) I
      ((_root_.SheafOfModules.restrictScalars.{u}
        (ringSheafHom (O := O) (O' := O') α)).mapDerivedCategory.obj E) := by
  intro U f hf
  let R := ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O).O)).over U
  let A := _root_.SheafOfModules.{u} R
  let : Linear (CatCenter A) A := Linear.ofRingMorphism (RingHom.id (CatCenter A))
  let : ∀ W : (Over U)ᵒᵖ, IsMulCommutative (R.obj.obj W) := fun W ↦ by
    show IsMulCommutative (O.obj.obj (op W.unop.left))
    infer_instance
  let R' := ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O').O)).over U
  let A' := _root_.SheafOfModules.{u} R'
  let : Linear (CatCenter A') A' := Linear.ofRingMorphism (RingHom.id (CatCenter A'))
  let : ∀ W : (Over U)ᵒᵖ, IsMulCommutative (R'.obj.obj W) := fun W ↦ by
    show IsMulCommutative (O'.obj.obj (op W.unop.left))
    infer_instance
  have hLim : PreservesFiniteLimits
      (_root_.SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O).O)) U) :=
    SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits U
  have hColim : PreservesFiniteColimits
      (_root_.SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O).O)) U) :=
    SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits U
  have hProd : HasProductsOfShape ℕ (DerivedCategory A) :=
    RingedSite.hasProductsOfShape_nat_derivedCategory_over.{u, u, u} (ringedSite J O) U
  refine ⟨inferInstance, hLim, hColim, hProd, ?_⟩
  obtain ⟨hAdd', hLim', hColim', hProd', hc⟩ :=
    h U ((ringSheafHom (O := O) (O' := O') α).hom.app (op U) f)
      (RingedSite.mem_extendIdeal_of_mem (ringSheafHom (O := O) (O' := O') α) I (op U) f hf)
  let φ := (J.overPullback RingCat.{u} U).map (ringSheafHom (O := O) (O' := O') α)
  let AU := _root_.SheafOfModules.restrictScalars.{u} φ
  have hpres : PreservesLimitsOfShape (Discrete ℕ) AU.mapDerivedCategory :=
    preservesProducts_mapDerivedCategory
      ((J.overPullback CommRingCat.{u} U).map α)
  have hsmul := mapDerivedCategory_map_smul_id AU
    (SheafOfModules.terminalSectionToEnd R' (Over.mk (𝟙 U)) Over.mkIdTerminal
      (φ.hom.app (op (Over.mk (𝟙 U))) f))
    (SheafOfModules.terminalSectionToEnd R (Over.mk (𝟙 U)) Over.mkIdTerminal f)
    (fun Z => by
      refine HomologicalComplex.hom_ext _ _ fun n => ?_
      show AU.map ((SheafOfModules.terminalSectionToEnd R' (Over.mk (𝟙 U))
            Over.mkIdTerminal (φ.hom.app (op (Over.mk (𝟙 U))) f)).app (Z.X n) ≫ 𝟙 (Z.X n)) =
          (SheafOfModules.terminalSectionToEnd R (Over.mk (𝟙 U)) Over.mkIdTerminal
            f).app (AU.obj (Z.X n)) ≫ 𝟙 (AU.obj (Z.X n))
      refine (congrArg (fun g => AU.map g) (Category.comp_id _)).trans ?_
      exact (RingedSite.restrictScalars_map_terminalSectionToEnd φ
        (Over.mk (𝟙 U)) Over.mkIdTerminal f (Z.X n)).trans (Category.comp_id _).symm)
  refine (AlgebraicGeometry.RingedSite.isDerivedCompleteAt_iff_of_iso
    (((mapDerivedCategoryCompIso
        (_root_.SheafOfModules.overFunctor.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O').O)) U)
        AU).app E).symm ≪≫
      (mapDerivedCategoryCompIso
        (_root_.SheafOfModules.restrictScalars.{u} (ringSheafHom (O := O) (O' := O') α))
        (_root_.SheafOfModules.overFunctor.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite J O).O)) U)).app E) _).mp ?_
  exact isDerivedCompleteAt_map_of_smul_id AU.mapDerivedCategory (hsmul _) hc

end Stacks.SheafOfModules.DerivedRestrictScalars

