module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SheafHomFilteredColimit
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.GeneratedIdealSheaf
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The generated ideal sheaf of a ringed space is the one of its small Zariski site

Let `X` be a ringed space and `f_1, …, f_r` global sections of `𝒪_X`, that is sections over the
open set `⊤`. Two constructions of the ideal sheaf they generate are available: the infimum
`Stacks.AlgebraicGeometry.QuasiRegular.generatedIdeal` of the ideal subsheaves of `𝒪_X`
containing them, and
`AlgebraicGeometry.RingedSite.generatedIdealSheaf` at the small Zariski site
`Stacks.SheafOfModules.opensRingedSite X.sheaf`. This file identifies them.

## Main results

* `Stacks.AlgebraicGeometry.QuasiRegular.generatedIdealSheaf_eq_generatedIdeal`: the two agree.

## Implementation notes

The two live in the same type on the nose: the sheaf of rings
`(Stacks.SheafOfModules.Tensor.ringSheaf (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)` and
the one `Stacks.RingedSpace.structureSheafModule` is taken over are both
`(sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).obj X.sheaf`, the
two differing only in which `GrothendieckTopology.HasSheafCompose` instance proves the sheaf
condition — a proposition, so the terms are definitionally equal. The equation is oriented with
the site-level object on the left so that its type is the one Lean elaborates against; the
ringed-space object is then accepted on the right by that definitional equality, which an
equation oriented the other way would have to force by an ascription.

The proof is the characterisation of the site-level construction by
`AlgebraicGeometry.RingedSite.eq_generatedIdealSheaf`: both objects contain the generators over
every open set and are least among the ideal sheaves that do. For the infimum, membership over an
arbitrary `U` is objectwise (`SheafOfModules.Submodule.toSubmodule_sInf`) and comes from
restriction stability of each indexed ideal subsheaf; leastness is `sInf_le`, the index condition
being membership over `⊤` only, which is the value of the global section there.

A global section of `𝒪_X` in the sense of [Stacks, Tag 06UN] is the same thing as a section over
`⊤`, because `⊤` is the terminal object of the site of opens; that translation is
`AlgebraicGeometry.RingedSite.globalSectionOfTerminalSection`.

## References

* [Stacks Project, Tag 06UN](https://stacks.math.columbia.edu/tag/06UN)
* [Stacks Project, Tag 099B](https://stacks.math.columbia.edu/tag/099B)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.RingedSite

universe u

namespace Stacks.AlgebraicGeometry.QuasiRegular

variable (X : RingedSpace.{u}) {r : ℕ} (f : Fin r → X.presheaf.obj (op (⊤ : Opens X)))

/-- The global sections of `𝒪_X` named by sections over `⊤`, as global sections of the structure
sheaf of the small Zariski site of `X`. -/
def siteGenerators (i : Fin r) :
    Presheaf.globalSections
      ((Stacks.SheafOfModules.opensRingedSite X.sheaf).O.obj ⋙ forget CommRingCat.{u}) :=
  globalSectionOfTerminalSection (X := Stacks.SheafOfModules.opensRingedSite X.sheaf)
    isTerminalTop (f i)

/-- The value of the `i`-th global section over an open set is the restriction of `f i`. -/
@[simp]
theorem globalSectionVal_siteGenerators (i : Fin r) (U : (Opens X)ᵒᵖ) :
    globalSectionVal (siteGenerators X f i) U =
      (X.presheaf.map (isTerminalTop.from U.unop).op).hom (f i) :=
  globalSectionVal_globalSectionOfTerminalSection
    (X := Stacks.SheafOfModules.opensRingedSite X.sheaf) isTerminalTop (f i) U

/-- **The ideal sheaf generated by global sections of a ringed space is the one generated by
them on its small Zariski site.** Both are the least ideal subsheaf of `𝒪_X` containing
`f_1, …, f_r`, so they agree; the site-level one additionally has the local description
`AlgebraicGeometry.RingedSite.mem_generatedIdealSheaf_iff`, which is how the schemes-level
results consume it. -/
theorem generatedIdealSheaf_eq_generatedIdeal :
    generatedIdealSheaf (siteGenerators X f) = generatedIdeal X f := by
  have key : ∀ (S : Set (SheafOfModules.Submodule
        (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.SheafOfModules.opensRingedSite X.sheaf).O)))))
      (U : (Opens X)ᵒᵖ) (x : (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Stacks.SheafOfModules.opensRingedSite X.sheaf).O))).val.obj U),
      (∀ N ∈ S, x ∈ N.toSubmodule.obj U) → x ∈ (sInf S).toSubmodule.obj U := by
    intro S U x hx
    rw [SheafOfModules.Submodule.toSubmodule_sInf, PresheafOfModules.Submodule.sInf_obj]
    refine (Submodule.mem_iInf _).2 fun N ↦ (Submodule.mem_iInf _).2 ?_
    rintro ⟨N₀, hN₀, rfl⟩
    exact hx N₀ hN₀
  refine (eq_generatedIdealSheaf (𝓙 := generatedIdeal X f) (siteGenerators X f)
    (fun i U ↦ ?_) (fun 𝓚 h𝓚 ↦ ?_)).symm
  · rw [globalSectionVal_siteGenerators]
    refine key _ U _ ?_
    rintro N ⟨I, rfl⟩
    exact I.1.map_mem _ (I.2 i)
  · refine sInf_le ⟨⟨𝓚, fun i ↦ ?_⟩, rfl⟩
    have h := h𝓚 i (op (⊤ : Opens X))
    rw [globalSectionVal_siteGenerators,
      show isTerminalTop.from (op (⊤ : Opens X)).unop = 𝟙 _ from isTerminalTop.hom_ext _ _] at h
    simp only [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply] at h
    exact h

end Stacks.AlgebraicGeometry.QuasiRegular

end
