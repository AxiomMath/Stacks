@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance] HasDerivedCategory.standard

variable (X : RingedSite.{u, u, u})
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) (U : X.C)

section Restrict

variable (IU : SheafOfModules.Submodule
  (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X.over U).O))))
  (hIU : ∀ (W : Over U)
    (g : ((Stacks.SheafOfModules.Tensor.ringSheaf (X.over U).O)).obj.obj (op W)),
    g ∈ IU.toSubmodule.obj (op W) → g ∈ I.toSubmodule.obj (op W.left))
  [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint]

include hIU in
/-- **`K^∧|_U` is derived complete along `ℐ|_U`.** This is the first assertion of
[Stacks, Tag 0A0F] — "from the definition of derived complete objects it follows that `K^∧|_U` is
derived complete" — namely
`AlgebraicGeometry.RingedSite.restrict_isDerivedComplete` applied to the derived completion of
`K`, which is derived complete by construction. It is what makes the map `a` of that Remark
exist. -/
theorem isDerivedComplete_derivedRestrict_derivedCompletion
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    IsDerivedComplete.{u, u, u, u} (X.over U) IU
      ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.obj
        ((derivedCompletion X I).obj K)) := by
  obtain ⟨_, _, _, h⟩ := restrict_isDerivedComplete X I U IU hIU
    ((derivedCompletion X I).obj K) (isDerivedComplete_derivedCompletion_obj X I K)
  exact h

/-- The natural map `K|_U ⟶ K^∧|_U`, that is restriction to the localized ringed site applied to
the unit `K ⟶ K^∧` of derived completion. -/
def restrictDerivedCompletionUnit :
    (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      U).mapDerivedCategory ⟶
      derivedCompletion X I ⋙
        (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory :=
  Functor.whiskerRight (derivedCompletionUnit X I)
    (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      U).mapDerivedCategory

/-- `K ↦ K^∧|_U`, read as a functor into the derived-complete objects of `D(𝒪_U)`. -/
def completedRestrictOfDerivedCompletion :
    DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) ⥤
      ObjectProperty.FullSubcategory
        (IsDerivedComplete.{u, u, u, u} (X.over U) IU) :=
  ObjectProperty.lift _
    (derivedCompletion X I ⋙
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory)
    (isDerivedComplete_derivedRestrict_derivedCompletion X I U IU hIU)

variable [(ObjectProperty.ι
  (IsDerivedComplete.{u, u, u, u} (X.over U) IU)).IsRightAdjoint]

/-- The map `a` of [Stacks, Tag 0A0F] read in the derived-complete objects of `D(𝒪_U)`: the
adjunct, under the reflector adjunction of [Stacks, Tag 099F] on `D(𝒪_U)`, of the natural map
`K|_U ⟶ K^∧|_U`. -/
def derivedCompletionRestrictComparisonLift :
    (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      U).mapDerivedCategory ⋙
        (ObjectProperty.ι
          (IsDerivedComplete.{u, u, u, u} (X.over U) IU)).leftAdjoint ⟶
      completedRestrictOfDerivedCompletion X I U IU hIU :=
  Functor.whiskerRight (restrictDerivedCompletionUnit X I U)
      (ObjectProperty.ι
        (IsDerivedComplete.{u, u, u, u} (X.over U) IU)).leftAdjoint ≫
    Functor.whiskerLeft (completedRestrictOfDerivedCompletion X I U IU hIU)
      (derivedCompletionAdjunction (X.over U) IU).counit

/-- **The canonical map `a : (K|_U)^∧ ⟶ K^∧|_U` of [Stacks, Tag 0A0F].** It exists because
`K^∧|_U` is derived complete, `isDerivedComplete_derivedRestrict_derivedCompletion`, so the
universal property of the derived completion of `K|_U` applies to the restricted unit
`K|_U ⟶ K^∧|_U`. Built as a mate, so that it is natural in `K`.

This states the construction for an arbitrary `ℐ`, taking the conclusion of
[Stacks, Tag 099F] on each of the two sites as a typeclass input. For `ℐ` of finite type, with
both inputs the instance of [Stacks, Tag 099F], it is an isomorphism at every `K`
(`AlgebraicGeometry.RingedSite.isIso_derivedCompletionRestrictComparison_overIdeal_app`), and
the statement of [Stacks, Tag 0A0F] that `K^∧|_U` is the derived completion of `K|_U` is
`AlgebraicGeometry.RingedSite.derivedCompletion_restrict` of
`LocalizationCompletionFiniteType.lean`. See the "Tag 0A0F in this library" section of the module
documentation. -/
def derivedCompletionRestrictComparison :
    (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      U).mapDerivedCategory ⋙
        derivedCompletion (X.over U) IU ⟶
      derivedCompletion X I ⋙
        (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory :=
  Functor.whiskerRight (derivedCompletionRestrictComparisonLift X I U IU hIU)
    (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} (X.over U) IU))

/-- The map `a` is the map the universal property of derived completion produces: it is the
unique map `(K|_U)^∧ ⟶ K^∧|_U` whose composite with the unit `K|_U ⟶ (K|_U)^∧` is the
restriction of the unit `K ⟶ K^∧`. -/
theorem derivedCompletionUnit_comp_derivedCompletionRestrictComparison
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    (derivedCompletionUnit (X.over U) IU).app
          ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
            U).mapDerivedCategory.obj K) ≫
        (derivedCompletionRestrictComparison X I U IU hIU).app K =
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.map
        ((derivedCompletionUnit X I).app K) :=
  (derivedCompletionAdjunction (X.over U) IU).unit_comp_map_comp_counit
    (B := (completedRestrictOfDerivedCompletion X I U IU hIU).obj K)
    ((restrictDerivedCompletionUnit X I U).app K)

/-- **A criterion for derived completion to commute with restriction at `K`.** If the restriction
`(K ⟶ K^∧)|_U` of the unit is invertible, then so is the comparison map
`a : (K|_U)^∧ ⟶ K^∧|_U`.

Indeed `K^∧|_U` is derived complete, so an invertible `(K ⟶ K^∧)|_U` makes `K|_U` derived
complete too, whence its unit `K|_U ⟶ (K|_U)^∧` is invertible; and `a` is the second factor of
that unit followed by itself in
`derivedCompletionUnit_comp_derivedCompletionRestrictComparison`. -/
theorem isIso_derivedCompletionRestrictComparison_of_isIso_map_unit
    {K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hK : IsIso ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      U).mapDerivedCategory.map
      ((derivedCompletionUnit X I).app K))) :
    IsIso ((derivedCompletionRestrictComparison X I U IU hIU).app K) := by
  have e : (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
    U).mapDerivedCategory.obj K ≅
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.obj
        ((derivedCompletion X I).obj K) :=
    @asIso _ _ _ _ _ hK
  have hcomplete : IsDerivedComplete.{u, u, u, u} (X.over U) IU
      ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.obj K) :=
    (isDerivedComplete_iff_of_iso (X.over U) IU e).mpr
      (isDerivedComplete_derivedRestrict_derivedCompletion X I U IU hIU K)
  have hunit : IsIso ((derivedCompletionUnit (X.over U) IU).app
      ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.obj K)) :=
    isIso_derivedCompletionUnit_app (X.over U) IU hcomplete
  exact @IsIso.of_isIso_fac_left _ _ _ _ _ _ _ _ hunit hK
    (derivedCompletionUnit_comp_derivedCompletionRestrictComparison X I U IU hIU K)

/-- **The map `a` is the only map compatible with the two units**: any map
`θ : (K|_U)^∧ ⟶ K^∧|_U` whose composite with the unit `K|_U ⟶ (K|_U)^∧` is the restriction of the
unit `K ⟶ K^∧` is `a`.

This is `derivedCompletionUnit_comp_derivedCompletionRestrictComparison` together with the
uniqueness half of the universal property of the derived completion of `K|_U`,
`AlgebraicGeometry.RingedSite.hom_ext_derivedCompletionUnit`, applied at the derived-complete
object `K^∧|_U`. -/
theorem eq_derivedCompletionRestrictComparison_of_derivedCompletionUnit_comp
    {K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (θ : (derivedCompletion (X.over U) IU).obj
        ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory.obj K) ⟶
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.obj
        ((derivedCompletion X I).obj K))
    (hθ : (derivedCompletionUnit (X.over U) IU).app
          ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
            U).mapDerivedCategory.obj K) ≫ θ =
        (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory.map
          ((derivedCompletionUnit X I).app K)) :
    θ = (derivedCompletionRestrictComparison X I U IU hIU).app K :=
  hom_ext_derivedCompletionUnit (X.over U) IU
    (isDerivedComplete_derivedRestrict_derivedCompletion X I U IU hIU K)
    (hθ.trans
      (derivedCompletionUnit_comp_derivedCompletionRestrictComparison X I U IU hIU K).symm)

/-- **A criterion for [Stacks, Tag 0A0F] at an arbitrary `K`.** If some *isomorphism*
`(K|_U)^∧ ≅ K^∧|_U` carries the unit `K|_U ⟶ (K|_U)^∧` to the restriction of the unit
`K ⟶ K^∧`, then the canonical map `a` is that isomorphism, and in particular invertible.

This is the form in which a model computation applies, and it is strictly weaker than
`isIso_derivedCompletionRestrictComparison_of_isIso_map_unit`: it does not ask the restricted
unit to be invertible, only that the restricted completion be *a* completion of the restriction.
The isomorphism in the Čech model of [Stacks, Tag 099B] is
`AlgebraicGeometry.RingedSite.completionFunctorRestrictIso` of `CechCompletionSlice.lean`; what
makes it applicable is the compatibility of that isomorphism with the completion maps,
`AlgebraicGeometry.RingedSite.completionUnit_comp_completionFunctorRestrictIso_inv` of
`CompletionUnitRestriction.lean`; the two together are
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionRestrictComparisonGlobalSections_app`. For
`ℐ` of finite type the isomorphism is built from the map `K ⟶ 𝒪` of [Stacks, Tag 099E] in
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionRestrictComparison_overIdeal_app` of
`LocalizationCompletionFiniteType.lean`. -/
theorem isIso_derivedCompletionRestrictComparison_of_unit_comp
    {K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (θ : (derivedCompletion (X.over U) IU).obj
        ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory.obj K) ≅
      (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        U).mapDerivedCategory.obj
        ((derivedCompletion X I).obj K))
    (hθ : (derivedCompletionUnit (X.over U) IU).app
          ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
            U).mapDerivedCategory.obj K) ≫ θ.hom =
        (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory.map
          ((derivedCompletionUnit X I).app K)) :
    IsIso ((derivedCompletionRestrictComparison X I U IU hIU).app K) :=
  eq_derivedCompletionRestrictComparison_of_derivedCompletionUnit_comp X I U IU hIU θ.hom hθ ▸
    θ.isIso_hom

/-- **[Stacks, Tag 0A0F] at a derived-complete object.** For `K` in `D_comp(𝒪, ℐ)` the canonical
map `a : (K|_U)^∧ ⟶ K^∧|_U` is invertible, so `K^∧|_U = K|_U = (K|_U)^∧`: the unit `K ⟶ K^∧` is
invertible on a derived-complete `K`, and restriction carries that isomorphism to one.

This asks nothing of `ℐ`, and is what the invertibility of `a` comes to when the reflector is
an abstract `CategoryTheory.Functor.leftAdjoint` with no formula to compute with. At every `K`,
for `ℐ` generated by finitely many global sections of `𝒪`, it is
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionRestrictComparisonOverIdeal_app` of
`OverIdealComparison.lean`. -/
theorem isIso_derivedCompletionRestrictComparison_of_isDerivedComplete
    {K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hK : IsDerivedComplete.{u, u, u, u} X I K) :
    IsIso ((derivedCompletionRestrictComparison X I U IU hIU).app K) := by
  let := isIso_derivedCompletionUnit_app X I hK
  exact isIso_derivedCompletionRestrictComparison_of_isIso_map_unit X I U IU hIU
    (Functor.map_isIso _ _)

end Restrict

section GlobalSections

variable {r : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- **The ideal sheaf generated on the slice by the restricted global sections has its local
sections among those of `ℐ = (f_1, …, f_r)`.** Over an object `V` of `𝒞/U` the sections of
`(f_1|_U, …, f_r|_U)` are sections of `(f_1, …, f_r)` over `V.left`. -/
theorem idealOfGlobalSections_over_le :
    idealOfGlobalSections (X.over U) (fun i ↦ globalSectionOver X U (f i)) ≤
      overIdeal (idealOfGlobalSections X f) U :=
  idealOfGlobalSections_le (X.over U) (fun i ↦ globalSectionOver X U (f i))
    (G := overIdeal (idealOfGlobalSections X f) U) fun i V ↦ by
      rw [globalSectionVal_globalSectionOver]
      exact globalSectionVal_mem_idealOfGlobalSections X f i (op V.unop.left)

/-- `idealOfGlobalSections_over_le` in the sectionwise shape
`AlgebraicGeometry.RingedSite.restrict_isDerivedComplete` asks for. -/
theorem mem_idealOfGlobalSections_of_mem_idealOfGlobalSections_over
    (W : Over U) (g : ((Stacks.SheafOfModules.Tensor.ringSheaf (X.over U).O)).obj.obj (op W))
    (hg : g ∈ (idealOfGlobalSections (X.over U)
      (fun i ↦ globalSectionOver X U (f i))).toSubmodule.obj (op W)) :
    g ∈ (idealOfGlobalSections X f).toSubmodule.obj (op W.left) :=
  idealOfGlobalSections_over_le X U f (op W) hg

variable [HasWeakSheafify X.J CommRingCat.{u}]
  [HasWeakSheafify (X.over U).J CommRingCat.{u}]

/-- **The map `a : (K|_U)^∧ ⟶ K^∧|_U` of [Stacks, Tag 0A0F] with no reflector hypothesis**, for
`ℐ = (f_1, …, f_r)` the ideal sheaf generated by a finite family of global sections and
`ℐ|_U = (f_1|_U, …, f_r|_U)` the one generated on the slice by their restrictions.

Both reflectors are the hypothesis-free [Stacks, Tag 099B] of `CompletionIdempotent.lean`,
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections`, applied
once on `(𝒞, 𝒪)` and once on `(𝒞/U, 𝒪_U)`, where the restricted family is
`AlgebraicGeometry.RingedSite.globalSectionOver`; so on both sites `K ↦ K^∧` is the Čech
completion functor `R𝑆heafHom(Č(f), -)` of `Completion.lean`. The only hypotheses left are the
sheafification instances the construction of that functor needs on each of the two sites.

That this map is an isomorphism at every `K` is
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionRestrictComparisonGlobalSections_app` of
`CompletionUnitRestriction.lean`. -/
def derivedCompletionRestrictComparisonGlobalSections :
    letI := isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections X f
    letI := isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections (X.over U)
      (fun i ↦ globalSectionOver X U (f i))
    (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      U).mapDerivedCategory ⋙
        derivedCompletion (X.over U)
          (idealOfGlobalSections (X.over U) (fun i ↦ globalSectionOver X U (f i))) ⟶
      derivedCompletion X (idealOfGlobalSections X f) ⋙
        (SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
          U).mapDerivedCategory :=
  letI := isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections X f
  letI := isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections (X.over U)
    (fun i ↦ globalSectionOver X U (f i))
  derivedCompletionRestrictComparison X (idealOfGlobalSections X f) U
    (idealOfGlobalSections (X.over U) (fun i ↦ globalSectionOver X U (f i)))
    (mem_idealOfGlobalSections_of_mem_idealOfGlobalSections_over X U f)

end GlobalSections

