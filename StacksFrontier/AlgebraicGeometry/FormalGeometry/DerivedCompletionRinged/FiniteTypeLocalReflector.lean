* [Stacks Project, Tag 099F](https://stacks.math.columbia.edu/tag/099F)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

section Section

variable (X : RingedSite.{u, u, u}) (U : X.C)

/-- **A section of `𝒪` over `U`, read as a global section of the localized structure sheaf
`𝒪_U`.** Its value over an object `V/U` of `𝒞/U` is the restriction `a|_V`, and compatibility
with the arrows of `𝒞/U` is `CategoryTheory.Over.w`.

This is why [Stacks, Tag 099B] — whose hypothesis is that the ideal sheaf be generated by
finitely many *global* sections — reaches a sheaf of ideals of finite type on each slice of a
cover: a section over `U` is a global section there. It is the companion of
`AlgebraicGeometry.RingedSite.globalSectionOver`, which restricts a global section of `𝒪`
instead. -/
def globalSectionOfSection (a : X.O.obj.obj (op U)) :
    Presheaf.globalSections ((X.over U).O.obj ⋙ forget CommRingCat.{u}) :=
  (Presheaf.globalSectionsEquivSections _).symm
    { val := fun V => (X.O.obj.map V.unop.hom.op).hom a
      property := fun {V W} b => by
        change (X.O.obj.map b.unop.left.op).hom ((X.O.obj.map V.unop.hom.op).hom a) = _
        rw [← CommRingCat.comp_apply, ← X.O.obj.map_comp, ← op_comp, Over.w] }

/-- The value of `globalSectionOfSection X U a` over an object `V/U` of `𝒞/U` is the restriction
`a|_V`. -/
@[simp]
theorem globalSectionVal_globalSectionOfSection (a : X.O.obj.obj (op U)) (V : (Over U)ᵒᵖ) :
    globalSectionVal (globalSectionOfSection X U a) V =
      (X.O.obj.map V.unop.hom.op).hom a := by
  show (Presheaf.globalSectionsEquivSections _
    ((Presheaf.globalSectionsEquivSections _).symm _)).1 V = _
  rw [Equiv.apply_symm_apply]

/-- **A section of `𝒪` which is an explicit finite linear combination of the restrictions
`f_i|_V` lies in the ideal they span.** The converse direction of
`AlgebraicGeometry.RingedSite.exists_fun_of_mem_span_restrictGlobalSections`, stated with the
ambient ring written out for the same reason: neither it nor the module is then inferred from the
surrounding goal. -/
theorem mem_span_restrictGlobalSections_of_sum {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u})) (V : X.Cᵒᵖ)
    {x : ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj V}
    (c : Fin r → ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj V)
    (hc : ∑ i, c i • restrictGlobalSections X f V i = x) :
    x ∈ Ideal.span (Set.range (restrictGlobalSections X f V)) :=
  (Submodule.mem_span_range_iff_exists_fun _).2 ⟨c, hc⟩

end Section

section Generates

variable (X : RingedSite.{u, u, u}) (U : X.C)
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))

/-- **The ideal sheaf generated on the slice by finitely many sections of `ℐ` over `U` is
contained in `ℐ|_U`.** The easy half: each generator's value over `V/U` is a restriction of a
section of `ℐ`, and a sheaf of ideals is stable under restriction, so minimality of the
generated ideal sheaf finishes it. No generation hypothesis is used. -/
theorem idealOfGlobalSections_le_overIdeal_of_section {n : ℕ}
    (s : Fin n → I.toSheafOfModules.val.obj (op U)) :
    idealOfGlobalSections (X.over U) (fun i => globalSectionOfSection X U (s i).val) ≤
      overIdeal I U :=
  idealOfGlobalSections_le (X.over U) _ (G := overIdeal I U) fun i V =>
    globalSectionVal_globalSectionOfSection X U (s i).val V ▸
      I.toSubmodule.map_mem V.unop.hom.op (s i).2

/-- **`ℐ|_U` is contained in the ideal sheaf generated on the slice by a generating family of
sections of `ℐ` over `U`.** This is the content: a section `x` of `ℐ` over `V` is, by the
generation hypothesis, an `𝒪`-linear combination of the restrictions of `s_1, …, s_n` along each
arrow of some covering sieve `S` of `V` for `J`; the sieve `(Sieve.overEquiv V).symm S` on `V/U`
is then a covering sieve for `J.over U` whose arrows have their underlying arrows in `S`, and
`AlgebraicGeometry.RingedSite.globalSectionVal_globalSectionOfSection` with
`CategoryTheory.Over.w` identifies the restriction of `s_i|_U` over `Z/U` with the restriction
of `s_i` over `Z`. So `x` is locally a combination of the slice generators, which by the
sheafification description `mem_idealOfGlobalSections_iff` is the membership asserted. -/
theorem le_idealOfGlobalSections_of_generates {n : ℕ}
    (s : Fin n → I.toSheafOfModules.val.obj (op U))
    (hs : PresheafOfModules.Generates X.J I.toSheafOfModules.val s) :
    overIdeal I U ≤
      idealOfGlobalSections (X.over U) (fun i => globalSectionOfSection X U (s i).val) := by
  intro W x hx
  obtain ⟨S, hS, hSgen⟩ := hs W.unop.left W.unop.hom ⟨x, hx⟩
  refine (mem_idealOfGlobalSections_iff (X.over U)
    (fun i => globalSectionOfSection X U (s i).val) W).2
    ⟨(Sieve.overEquiv W.unop).symm S, (X.J.mem_over_iff _).2 ?_, fun Z h hh => ?_⟩
  · rw [OrderIso.apply_symm_apply]
    exact hS
  · obtain ⟨a, ha⟩ := hSgen Z.left h.left ((Sieve.overEquiv_symm_iff S h).1 hh)
    refine mem_span_restrictGlobalSections_of_sum (X.over U) _ (op Z) a ?_
    have hmid : ∑ i, a i •
        (I.toSheafOfModules.val.restrictₛₗ (h.left ≫ W.unop.hom).op (s i)).val =
          (I.toSheafOfModules.val.restrictₛₗ h.left.op
            (⟨x, hx⟩ : I.toSheafOfModules.val.obj (op W.unop.left))).val :=
      Eq.trans (map_sum (I.toSubmodule.obj (op Z.left)).subtype
        (fun i => a i • I.toSheafOfModules.val.restrictₛₗ (h.left ≫ W.unop.hom).op (s i))
        Finset.univ).symm (congrArg Subtype.val ha)
    have hval : ∀ i, restrictGlobalSections (X.over U)
        (fun i => globalSectionOfSection X U (s i).val) (op Z) i =
          (I.toSheafOfModules.val.restrictₛₗ (h.left ≫ W.unop.hom).op (s i)).val := fun i =>
      Eq.trans (globalSectionVal_globalSectionOfSection X U (s i).val (op Z))
        (congrArg (fun m : op U ⟶ op Z.left => (X.O.obj.map m).hom (s i).val)
          (congrArg Quiver.Hom.op (Over.w h).symm))
    exact Eq.trans (Finset.sum_congr rfl fun i _ =>
      congrArg
        (fun y : ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj (op Z.left) => a i • y)
        (hval i)) hmid

/-- **A finite family of sections of `ℐ` over `U` generating `ℐ` sectionwise generates `ℐ|_U` on
the localized ringed site.** Read as global sections of `𝒪_U` through
`AlgebraicGeometry.RingedSite.globalSectionOfSection`, the family generates exactly the
restricted sheaf of ideals `AlgebraicGeometry.RingedSite.overIdeal`.

This is what makes the hypothesis-free [Stacks, Tag 099B] of `CompletionIdempotent.lean` apply
to `ℐ|_U` itself rather than to some smaller ideal sheaf on the slice — the point left open by
the "Which ideal sheaf on the slice" note of `LocalizationCompletion.lean`. -/
theorem overIdeal_eq_idealOfGlobalSections_of_generates {n : ℕ}
    (s : Fin n → I.toSheafOfModules.val.obj (op U))
    (hs : PresheafOfModules.Generates X.J I.toSheafOfModules.val s) :
    overIdeal I U =
      idealOfGlobalSections (X.over U) (fun i => globalSectionOfSection X U (s i).val) :=
  le_antisymm (le_idealOfGlobalSections_of_generates X U I s hs)
    (idealOfGlobalSections_le_overIdeal_of_section X U I s)

end Generates

section Reflector

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] isMulCommutative_over overCatCenterLinear
  overFunctor_preservesFiniteLimits overFunctor_preservesFiniteColimits
  hasProductsOfShape_nat_derivedCategory_over

variable (X : RingedSite.{u, u, u})
  [∀ V : X.C, HasWeakSheafify (X.J.over V) CommRingCat.{u}]
  [∀ V : X.C, HasSheafify (X.J.over V) AddCommGrpCat.{u}]
  [∀ V : X.C, (X.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))

omit [∀ V : X.C, HasWeakSheafify (X.J.over V) CommRingCat.{u}]
  [∀ V : X.C, HasSheafify (X.J.over V) AddCommGrpCat.{u}]
  [∀ V : X.C, (X.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- **[Stacks, Tag 099F] on the slices of a cover, from the sectionwise finite-type
condition.** If the sheaf of ideals `ℐ` is of finite type in the sectionwise sense of
[Stacks, Tag 03DL] part (5), then there is a family of objects covering the site on each of whose
slices `(𝒞/U_i, 𝒪_{U_i})` the inclusion of the objects derived complete along `ℐ|_{U_i}` into
`D(𝒪_{U_i})` has a left adjoint.

On each member of the covering family the finite-type condition supplies finitely many sections
of `ℐ` over `U_i` generating `ℐ`; they are global sections of `𝒪_{U_i}` by
`globalSectionOfSection`, and the sheaf of ideals they generate there is `ℐ|_{U_i}` by
`overIdeal_eq_idealOfGlobalSections_of_generates`. So
`isRightAdjoint_ι_isDerivedComplete_of_eq_idealOfGlobalSections` of
`FiniteTypeGlobalSections.lean` — which is [Stacks, Tag 099B] — applies on the slice. -/
theorem exists_coversTop_isRightAdjoint_ι_isDerivedComplete_overIdeal_of_presheafIsFiniteType
    (hI : PresheafOfModules.IsFiniteType X.J I.toSheafOfModules.val) :
    ∃ (ι : Type u) (V : ι → X.C), X.J.CoversTop V ∧
      ∀ i, (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} (X.over (V i))
        (overIdeal I (V i)))).IsRightAdjoint := by
  obtain ⟨ι, V, hV, hgen⟩ := hI.exists_generators
  refine ⟨ι, V, hV, fun i => ?_⟩
  obtain ⟨n, s, hs⟩ := hgen i
  exact isRightAdjoint_ι_isDerivedComplete_of_eq_idealOfGlobalSections (X.over (V i))
    (fun j => globalSectionOfSection X (V i) (s j).val) (overIdeal I (V i))
    (overIdeal_eq_idealOfGlobalSections_of_generates X (V i) I s hs)

omit [∀ V : X.C, HasWeakSheafify (X.J.over V) CommRingCat.{u}] in
/-- **[Stacks, Tag 099F] on the slices of a cover, for a sheaf of ideals of finite type.** For
`ℐ ⊂ 𝒪` of finite type — the hypothesis of the tag — there is a family of objects `{U_i}`
covering the site such that on each localized ringed site `(𝒞/U_i, 𝒪_{U_i})` the inclusion

`D_comp(𝒪_{U_i}, ℐ|_{U_i}) ⥤ D(𝒪_{U_i})`

has a left adjoint, which is the Čech completion of [Stacks, Tag 099B] at the restricted
generators.

The global conclusion of the tag — a left adjoint on `D(𝒪)` itself — is not obtained by gluing
these: the reflectors are arbitrary choices of left adjoint with no formula, and objects of a
derived category do not glue along a cover from isomorphisms on the pieces. It is
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete` of `FiniteTypeReflector.lean`,
from the map `K ⟶ 𝒪` of [Stacks, Tag 099E].

Mathlib's finite-type condition is turned into the sectionwise one by
`Stacks.SheafOfModules.presheaf_isFiniteType_of_isFiniteType`.

No `@[stacks 099F]` attribute, and that is still the right decision: 099F asserts the left
adjoint on `D(𝒪)` itself, a family of adjoints on the slices of a cover is a different
assertion, and attaching the tag here would say the tag holds where what holds is its
localization. What this does settle is that the tag's hypothesis is the right one to localize
under — the reduction to [Stacks, Tag 099B] goes through for a finite-type ideal sheaf, on each
slice, with the ideal sheaf there being `overIdeal I (V i)` on the nose.

**The globalization is now carried out**, in `GlobalCechReflector.lean`, and it does not glue these
adjoints: it checks each clause of the universal property of a single global candidate
`(Φ, η) = (R𝑆heafHom_𝒪(K, -), a)` on the slices of this very covering family. See
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_of_isGlobalExtendedCech` there,
whose hypothesis on `a : K ⟶ 𝒪` is the conclusion of [Stacks, Tag 099E] and nothing else, which
`AlgebraicGeometry.RingedSite.exists_isGlobalExtendedCech` of `FiniteTypeExtendedCech.lean`
supplies; and also
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_of_isNilpotent_of_sieve`, which is
the tag for a finite-type ideal sheaf whose local sections become nilpotent on a covering. So the
sentence above about objects of a derived category not gluing along a cover describes a route that
is not needed: the three clauses are each local, invertibility by [Stacks, Tag 08JJ] and derived
completeness by the sheaf condition of [Stacks, Tag 0998]. -/
theorem exists_coversTop_isRightAdjoint_ι_isDerivedComplete_overIdeal
    [I.toSheafOfModules.IsFiniteType] :
    ∃ (ι : Type u) (V : ι → X.C), X.J.CoversTop V ∧
      ∀ i, (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} (X.over (V i))
        (overIdeal I (V i)))).IsRightAdjoint :=
  exists_coversTop_isRightAdjoint_ι_isDerivedComplete_overIdeal_of_presheafIsFiniteType X I
    (Stacks.SheafOfModules.presheaf_isFiniteType_of_isFiniteType I.toSheafOfModules
      inferInstance)

end Reflector

end AlgebraicGeometry.RingedSite

end
