module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.CechTensorCriterion
public import StacksFrontier.CategoryTheory.Sites.Modules.TensorUnit
public import StacksFrontier.Algebra.Homology.TotalSingleRowNaturality
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.MonoidalSheafTensorUnitors
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorUnitSections

/-!
# Derived tensoring with the structure map of a ring map, and the Čech complex

Let `(𝒞, 𝒪)` be a ringed site and let `φ : 𝒪 ⟶ 𝒪'` be a homomorphism of sheaves of commutative
rings. Read as a map of `𝒪`-modules, `φ` is the map `η : 𝒪 ⟶ 𝒪'` of
`AlgebraicGeometry.RingedSite.ringModuleMap`. For a complex `K` of `𝒪`-modules this file
identifies the derived tensor product `K ⊗^𝐋_𝒪 η`, when `φ` is flat, with the degreewise
extension of scalars `K ⟶ K ⊗_𝒪 𝒪'`, `x ↦ x ⊗ 1`, of
`Stacks.Sheaves.FlatNeighbourhood.tensorUnitComplexMap` — the map [Stacks, Tag 099H] is about.

Combined with `CechTensorCriterion.lean` this gives the local input of [Stacks, Tag 099I]: if
`φ` is flat, an isomorphism modulo an ideal sheaf `ℐ`, and `ℐ` is contained in the ideal sheaf
generated by finitely many global sections `f_1, …, f_r`, then `R𝑆heafHom_𝒪(η, Y)` is invertible
for every `Y` derived complete along `(f_1, …, f_r)`.

## Main definitions

* `AlgebraicGeometry.RingedSite.ringModuleMap`: `φ` read as a map `𝒪 ⟶ 𝒪'` of `𝒪`-modules.
* `AlgebraicGeometry.RingedSite.derivedTensorRingModuleMapArrowIso`: the arrow
  `K ⊗^𝐋_𝒪 η` is isomorphic to the image in `D(𝒪)` of `K ⟶ K ⊗_𝒪 𝒪'`.

## Main results

* `AlgebraicGeometry.RingedSite.inv_comp_map_ringModuleMap`: for a sheaf of modules `F`, the
  inverse unit constraint `F ⟶ F ⊗_𝒪 𝒪` followed by `F ⊗ η` is `x ↦ x ⊗ 1`.
* `AlgebraicGeometry.RingedSite.isIso_derivedSheafHom_ringModuleMap_of_globalSections`: the
  invertibility of `R𝑆heafHom_𝒪(η, Y)` described above.

## Implementation notes

The derived tensor product is `Stacks.SheafOfModules.derivedTensorProductFunctor`, the canonical
derived tensor product; it is computed against the K-flat complexes `𝒪[0]` and `𝒪'[0]` by its
right K-flat comparison, which is natural in both variables. The total complex of a complex
with an object in degree zero is the termwise complex, naturally in that object
(`CochainComplex.KFlatBifunctor.totalSingleIso_hom_naturality_right`), and the termwise complex
at `𝒪` is the complex itself (`Stacks.SheafOfModules.rowComplexUnitIso`). What is left is a
statement about one sheaf of modules, `inv_comp_map_ringModuleMap`, checked on sections: the
inverse unit constraint is `x ↦ x ⊗ 1` (`Stacks.SheafOfModules.tensorSheafUnitRightIso_inv_app`)
and `F ⊗ η` carries `x ⊗ 1` to `x ⊗ φ(1) = x ⊗ 1`.

## References

* [Stacks Project, Tag 099H](https://stacks.math.columbia.edu/tag/099H)
* [Stacks Project, Tag 099I](https://stacks.math.columbia.edu/tag/099I)
* [Stacks Project, Tag 06YU](https://stacks.math.columbia.edu/tag/06YU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite MonoidalCategory
open scoped TensorProduct

universe u

namespace AlgebraicGeometry.RingedSite

open Stacks.Sheaves.FlatNeighbourhood (RestrictedRingModule tensorUnitMap tensorUnitComplexMap)

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  {O' : Sheaf X.J CommRingCat.{u}} (φ : X.O ⟶ O')

/-- **A homomorphism of sheaves of rings read as a map of modules**: `φ : 𝒪 ⟶ 𝒪'` as a morphism
from the rank-one `𝒪`-module to `𝒪'` viewed as an `𝒪`-module by restriction of scalars. -/
def ringModuleMap :
    SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O) ⟶
      RestrictedRingModule.{u, u, u} φ :=
  ⟨PresheafOfModules.homMk
      { app := fun V => AddCommGrpCat.ofHom
          (((sheafCompose X.J (forget₂ CommRingCat RingCat)).map φ).hom.app V).hom.toAddMonoidHom
        naturality V W g := by
          ext r
          exact NatTrans.naturality_apply
            ((sheafCompose X.J (forget₂ CommRingCat RingCat)).map φ).hom g r }
      (fun V r m =>
        map_mul (((sheafCompose X.J (forget₂ CommRingCat RingCat)).map φ).hom.app V).hom r m)⟩

omit [HasWeakSheafify X.J CommRingCat] [HasSheafify X.J AddCommGrpCat]
  [X.J.WEqualsLocallyBijective AddCommGrpCat] in
/-- On sections over `V`, `ringModuleMap X φ` sends `r` to `φ(r)`. -/
theorem ringModuleMap_val_app (V : X.Cᵒᵖ)
    (r : (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj.obj V) :
    (ringModuleMap X φ).val.app V r = (φ.hom.app V).hom r := rfl

omit [HasWeakSheafify X.J CommRingCat] in
/-- **`x ↦ x ⊗ 1` is the inverse unit constraint followed by `F ⊗ η`.** For a sheaf of
`𝒪`-modules `F`, the composite `F ≅ F ⊗_𝒪 𝒪 ⟶ F ⊗_𝒪 𝒪'` of the inverse right unit constraint
with `F ⊗ η` is the canonical map `Stacks.Sheaves.FlatNeighbourhood.tensorUnitMap`. -/
theorem inv_comp_map_ringModuleMap
    (F : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) :
    ((Stacks.SheafOfModules.sheafTensorUnitNatIso X.O).app F).inv ≫
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj F).map
          (ringModuleMap X φ) =
      (tensorUnitMap φ F).val := by
  apply (SheafOfModules.fullyFaithfulForget
    (Stacks.SheafOfModules.Tensor.ringSheaf X.O)).map_injective
  refine PresheafOfModules.hom_ext fun V => ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
  have h1 := Stacks.SheafOfModules.tensorSheafUnitRightIso_inv_app X.O.obj
          (Stacks.SheafOfModules.Tensor.ringSheaf X.O).property F V x
  rw [← SheafOfModules.rightUnitor_sheafTensor_eq_iso] at h1
  have h2 := Stacks.SheafOfModules.sheafify_map_toSheafify_apply X.O.obj
          (Stacks.SheafOfModules.Tensor.ringSheaf X.O).property
          (F.val ◁ (ringModuleMap X φ).val) V (x ⊗ₜ (1 : X.O.obj.obj V))
  refine (congrArg (fun z =>
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj F).map
    (ringModuleMap X φ)).val.app V z) h1).trans ?_
  refine h2.trans ?_
  refine Eq.trans ?_ ((tensorUnitMap φ F).2 V x).symm
  dsimp only [Stacks.Sheaves.FlatNeighbourhood.tensorUnitSection]
  congr 1
  rw [show Stacks.Sheaves.FlatNeighbourhood.restrictedOne φ V = (φ.hom.app V).hom 1 from
    (map_one (φ.hom.app V).hom).symm]
  rfl

omit [HasWeakSheafify X.J CommRingCat] in
/-- **Degreewise, `K ⊗ η` is `x ↦ x ⊗ 1`.** The termwise complex `p ↦ K^p ⊗_𝒪 η` is the
identification `p ↦ K^p ⊗_𝒪 𝒪 ≅ K` followed by the degreewise extension of scalars. -/
theorem rowComplexMapRight_ringModuleMap
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) :
    CochainComplex.KFlatBifunctor.rowComplexMapRight
        (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O) K (ringModuleMap X φ) =
      (Stacks.SheafOfModules.rowComplexUnitIso X.O K).hom ≫
        (@tensorUnitComplexMap.{u, u, u} X.C X.category X.J
        inferInstance inferInstance inferInstance X.O O' φ
        (@Functor.preservesZeroMorphisms_of_additive _ _ _ _ _ _
          ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
            (RestrictedRingModule.{u, u, u} φ))
          (@Functor.flip_obj_additive _ _ _ _ _ _ _ _
            (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O)
            (Stacks.SheafOfModules.Tensor.sheafTensor_additive.{u, u, u, u, u} X.O)
            (RestrictedRingModule.{u, u, u} φ))) ℤ (ComplexShape.up ℤ) K) := by
  refine HomologicalComplex.hom_ext _ _ (fun p => ?_)
  have h' : ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj (K.X p)).map
        (ringModuleMap X φ) =
      ((Stacks.SheafOfModules.sheafTensorUnitNatIso X.O).app (K.X p)).hom ≫
        (tensorUnitMap φ (K.X p)).val := by
    rw [← inv_comp_map_ringModuleMap X φ (K.X p), Iso.hom_inv_id_assoc]
  refine h'.trans ?_
  rw [HomologicalComplex.comp_f]
  rfl

/-- `rowComplexMapRight_ringModuleMap` as an isomorphism of arrows. -/
def rowComplexMapRightArrowIso
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) :
    Arrow.mk (CochainComplex.KFlatBifunctor.rowComplexMapRight
        (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O) K (ringModuleMap X φ)) ≅
      Arrow.mk ((@tensorUnitComplexMap.{u, u, u} X.C X.category X.J
        inferInstance inferInstance inferInstance X.O O' φ
        (@Functor.preservesZeroMorphisms_of_additive _ _ _ _ _ _
          ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
            (RestrictedRingModule.{u, u, u} φ))
          (@Functor.flip_obj_additive _ _ _ _ _ _ _ _
            (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O)
            (Stacks.SheafOfModules.Tensor.sheafTensor_additive.{u, u, u, u, u} X.O)
            (RestrictedRingModule.{u, u, u} φ))) ℤ (ComplexShape.up ℤ) K)) :=
  Arrow.isoMk (Stacks.SheafOfModules.rowComplexUnitIso X.O K) (Iso.refl _)
    ((rowComplexMapRight_ringModuleMap X φ K).symm.trans (Category.comp_id _).symm)

variable [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u,
    u} X.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂
      (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O)
      (ComplexShape.up ℤ)]

/-- The total complex of `K ⊗ η[0]` is the termwise complex `p ↦ K^p ⊗ η`, as arrows. -/
def totalSingleArrowIso
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) :
    Arrow.mk (HomologicalComplex.mapBifunctorMap (𝟙 K)
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ringModuleMap X φ))
          (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O) (ComplexShape.up ℤ)) ≅
      Arrow.mk (CochainComplex.KFlatBifunctor.rowComplexMapRight
        (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O) K (ringModuleMap X φ)) :=
  Arrow.isoMk (CochainComplex.KFlatBifunctor.totalSingleIso _ K _)
    (CochainComplex.KFlatBifunctor.totalSingleIso _ K _)
    (CochainComplex.KFlatBifunctor.totalSingleIso_hom_naturality_right _ K _).symm

variable [PreservesFiniteLimits
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
      (RestrictedRingModule.{u, u, u} φ))]
  [PreservesFiniteColimits
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
      (RestrictedRingModule.{u, u, u} φ))]

attribute [local instance] HasDerivedCategory.standard

/-- `K ⊗^𝐋_𝒪 η[0]` is the total complex of `K ⊗ η[0]`, as arrows: `𝒪[0]` and `𝒪'[0]` are
K-flat, and the right K-flat comparison of the derived tensor product is natural. -/
def derivedTensorComparisonArrowIso
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) :
    Arrow.mk (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
        (DerivedCategory.Q.obj K)).map (DerivedCategory.Q.map
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ringModuleMap X φ)))) ≅
      Arrow.mk (DerivedCategory.Q.map (HomologicalComplex.mapBifunctorMap (𝟙 K)
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ringModuleMap X φ))
          (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O) (ComplexShape.up ℤ))) :=
  Arrow.isoMk
    ((Stacks.SheafOfModules.canonicalDerivedTensorProduct X).comparisonRight K _
        (Stacks.SheafOfModules.isKFlat_single_unit X.O))
    ((Stacks.SheafOfModules.canonicalDerivedTensorProduct X).comparisonRight K _
        (isKFlat_restrictedRingModule X φ)) (by
    have h := (Stacks.SheafOfModules.canonicalDerivedTensorProduct X).comparisonRight_naturality
      (𝟙 K) ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ringModuleMap X φ))
      (Stacks.SheafOfModules.isKFlat_single_unit X.O) (isKFlat_restrictedRingModule X φ)
    simp only [CategoryTheory.Functor.map_id, NatTrans.id_app, Category.id_comp] at h
    exact h.symm)

/-- **`K ⊗^𝐋_𝒪 η` is the degreewise extension of scalars `K ⟶ K ⊗_𝒪 𝒪'`**, as an
isomorphism of arrows of `D(𝒪)`, for a flat `φ`. -/
def derivedTensorRingModuleMapArrowIso
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) :
    Arrow.mk (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
        (DerivedCategory.Q.obj K)).map (DerivedCategory.Q.map
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (ringModuleMap X φ)))) ≅
      Arrow.mk (DerivedCategory.Q.map (tensorUnitComplexMap.{u, u, u} φ K)) :=
  derivedTensorComparisonArrowIso X φ K ≪≫
    DerivedCategory.Q.mapArrow.mapIso
      (totalSingleArrowIso X φ K ≪≫ rowComplexMapRightArrowIso X φ K)

/-- **Invertibility transported along an isomorphism of arrows.** -/
theorem isIso_of_arrow_iso {𝒜 : Type*} [Category 𝒜] {f g : Arrow 𝒜} (e : f ≅ g)
    (hg : IsIso g.hom) : IsIso f.hom :=
  ((MorphismProperty.isomorphisms 𝒜).arrow_iso_iff e).mpr hg

variable {r : ℕ} (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- **[Stacks, Tag 099H] read through `R𝑆heafHom(-, Y)`.** Let `φ : 𝒪 ⟶ 𝒪'` be flat and an
isomorphism modulo an ideal sheaf `ℐ` (the pair `e`, `he`, as in [Stacks, Tag 099H]), and let
`ℐ` be locally generated by global sections `f_1, …, f_r`. Then for every `Y` derived complete
along the ideal sheaf generated by the `f_i` the map

`R𝑆heafHom_𝒪(𝒪', Y) ⟶ R𝑆heafHom_𝒪(𝒪, Y)`

induced by `η = φ` is invertible.

By `isIso_derivedSheafHom_map_of_isIso_derivedTensor_map` it suffices that `Č(f) ⊗^𝐋_𝒪 η` be
invertible; that arrow is the degreewise extension of scalars on `Č(f)` by
`derivedTensorRingModuleMapArrowIso`, which is a quasi-isomorphism by [Stacks, Tag 099H]. -/
theorem isIso_derivedSheafHom_ringModuleMap_of_globalSections
    {I : _root_.SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)}
    (i : I ⟶ _root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) [Mono i]
    (e : cokernel i ≅
      cokernel (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
        (RestrictedRingModule.{u, u, u} φ)).map i))
    (he : cokernel.π i ≫ e.hom =
      (tensorUnitMap φ (Stacks.Sheaves.FlatNeighbourhood.RingModule.{u, u, u} X.O)).val ≫
        cokernel.π (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
          (RestrictedRingModule.{u, u, u} φ)).map i))
    (hgen : Stacks.Sheaves.CechFlatNeighbourhood.IsLocallyGeneratedBySections.{u}
      (J := X.J) X.O f i)
    (Y : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hY : IsDerivedComplete.{u, u, u, u} X (idealOfGlobalSections X f) Y) :
    IsIso (((derivedSheafHomBifunctor X).map (DerivedCategory.Q.map
      ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        (ringModuleMap X φ))).op).app Y) := by
  refine isIso_derivedSheafHom_map_of_isIso_derivedTensor_map X f _ ?_ Y hY
  exact isIso_of_arrow_iso (derivedTensorRingModuleMapArrowIso X φ (extendedAlternatingCech X f))
    (isIso_Q_map_tensorUnitComplexMap_extendedAlternatingCech X φ f
      (Stacks.Sheaves.CechFlatNeighbourhood.quasiIso_extendedAlternatingCechBaseChangeMap
        X.O f φ i e he hgen))

end AlgebraicGeometry.RingedSite

end
