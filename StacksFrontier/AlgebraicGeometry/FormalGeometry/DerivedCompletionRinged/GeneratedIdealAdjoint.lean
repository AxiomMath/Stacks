/-!
# The left adjoint of the inclusion of the derived-complete objects

Let `(𝒞, 𝒪)` be a ringed site, let `f_1, …, f_r` be global sections of `𝒪` and let
`ℐ = (f_1, …, f_r)` be the sheaf of ideals they generate. The inclusion `D_comp(𝒪) ⥤ D(𝒪)` of
the objects derived complete along `ℐ` has a left adjoint, the Čech completion
`K ↦ K^∧ = R𝑆heafHom_𝒪(Č(f), K)` of [Stacks, Tag 099B].

## Main results

* `AlgebraicGeometry.RingedSite.completionFunctorDerivedSheafHomIso`: the completion functor
  commutes with derived internal Hom out of a fixed object,
  `(R𝑆heafHom_𝒪(A, K))^∧ ≅ R𝑆heafHom_𝒪(A, K^∧)`.
* `AlgebraicGeometry.RingedSite.bijective_precomp_completionUnit_generatedIdealSheaf`: the
  universal property of `K^∧`: precomposition with `K ⟶ K^∧` is a bijection onto the morphisms
  into a derived-complete object.
* `AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`: the
  inclusion of the objects derived complete along the ideal sheaf generated by finitely many
  global sections has a left adjoint.

## References

* [Stacks Project, Tag 08J9](https://stacks.math.columbia.edu/tag/08J9)
* [Stacks Project, Tag 08JC](https://stacks.math.columbia.edu/tag/08JC)
* [Stacks Project, Tag 099B](https://stacks.math.columbia.edu/tag/099B)
* [Stacks Project, Tag 099F](https://stacks.math.columbia.edu/tag/099F)
* [Stacks Project, Tag 0FPT](https://stacks.math.columbia.edu/tag/0FPT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite

universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance] hasMapBifunctor

section Derived

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] linearCatCenterRingSheaf

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}] {r : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- **The commutativity constraint of the derived tensor product**, `A ⊗^𝐋_𝒪 B ≅ B ⊗^𝐋_𝒪 A`, for
the packaging of the derived tensor product indexed by the ringed site rather than by its
structure sheaf: `Stacks.DerivedTensor.RingedSite.DerivedTensorProduct.braidingIso` read through
`AlgebraicGeometry.RingedSite.derivedTensorProductDatumOfSite`. -/
def derivedTensorBraidingIso
    (A B : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj A).obj B ≅
      ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj B).obj A :=
  (derivedTensorProductDatumOfSite X
    (Stacks.SheafOfModules.canonicalDerivedTensorProduct X)).braidingIso X A B

/-- **The Čech completion functor commutes with derived internal Hom out of a fixed object**:
for all `A` and `K` in `D(𝒪)`

`(R𝑆heafHom_𝒪(A, K))^∧ ≅ R𝑆heafHom_𝒪(A, K^∧)`,

where `K^∧ = R𝑆heafHom_𝒪(Č(f), K)`. -/
def completionFunctorDerivedSheafHomIso
    (A K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    (completionFunctor X f).obj (((derivedSheafHomBifunctor X).obj (op A)).obj K) ≅
      ((derivedSheafHomBifunctor X).obj (op A)).obj ((completionFunctor X f).obj K) :=
  derivedCurryIso X (DerivedCategory.Q.obj (extendedAlternatingCech X f)) A K ≪≫
    ((derivedSheafHomBifunctor X).mapIso (derivedTensorBraidingIso X
      (DerivedCategory.Q.obj (extendedAlternatingCech X f)) A).symm.op).app K ≪≫
    (derivedSheafHom_completionFunctor_iso X f A K).symm

/-- **Each subproduct `f_S` with `S` non-empty lies in the vanishing locus of the Čech
completion.** -/
theorem memVanishingIdeal_prodGlobalSection_completionFunctor_obj
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {S : Finset (Fin r)}
    (hS : S.Nonempty) :
    MemVanishingIdeal X ((completionFunctor X f).obj K) (prodGlobalSection f S) := by
  obtain ⟨i, hi⟩ := hS
  exact memVanishingIdeal_prodGlobalSection_of_mem X f _ hi
    (memVanishingIdeal_completionFunctor_obj X f K i)

/-- **The completion of the derived internal Hom out of the kernel of the Čech augmentation
vanishes**: `(R𝑆heafHom_𝒪(Č(f)^{≥1}, K))^∧ = 0`. -/
theorem isZero_completionFunctor_derivedSheafHom_stupidTruncGE
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    IsZero ((completionFunctor X f).obj
      (((derivedSheafHomBifunctor X).obj (op (DerivedCategory.Q.obj
        ((extendedAlternatingCech X f).stupidTrunc
          (ComplexShape.embeddingUpIntGE (1 : ℤ)))))).obj K)) :=
  IsZero.of_iso
    (isZero_derivedSheafHom_stupidTruncGE_extendedAlternatingCech X f
      ((completionFunctor X f).obj K)
      fun _ hS ↦ memVanishingIdeal_prodGlobalSection_completionFunctor_obj X f K hS)
    (completionFunctorDerivedSheafHomIso X f _ K)

/-- **The completion functor carries the completion map `K ⟶ K^∧` to an isomorphism.** -/
private theorem isIso_completionFunctor_map_completionUnit_app
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    IsIso ((completionFunctor X f).map ((completionUnit X f).app K)) := by
  set G := completionFunctor X f
  set H := (derivedSheafHomBifunctor X).flip.obj K
  obtain ⟨δ, hδ⟩ := exists_distinguished_derivedSheafHom X K
    (StacksDraft.StupidTruncation.stupidTruncGETriangle (extendedAlternatingCech X f) 0)
    (StacksDraft.StupidTruncation.stupidTruncGETriangle_distinguished _ 0)
  obtain ⟨δ', hδ'⟩ := exists_distinguished_derivedSheafHom_second X
    (DerivedCategory.Q.obj (extendedAlternatingCech X f)) _ hδ
  have hmor₁ : IsIso (G.map (H.map (DerivedCategory.Q.map
      (StacksDraft.StupidTruncation.stupidTruncGEπ (extendedAlternatingCech X f) 0)).op)) :=
    (Triangle.isZero₃_iff_isIso₁ _ hδ').mp
      (isZero_completionFunctor_derivedSheafHom_stupidTruncGE X f K)
  have hι : IsIso ((extendedAlternatingCech X f).ιStupidTrunc
      (ComplexShape.embeddingUpIntGE (0 : ℤ))) :=
    isIso_ιStupidTrunc_extendedAlternatingCech X f
  have hz : IsIso (cechAugmentationZero X f) := isIso_cechAugmentationZero X f
  have key := congrArg (fun φ ↦ G.map (H.map (DerivedCategory.Q.map φ).op))
    (ιStupidTrunc_comp_cechAugmentation X f)
  simp only [DerivedCategory.Q.map_comp, op_comp, Functor.map_comp] at key
  have hcech : IsIso (G.map (H.map (DerivedCategory.Q.map (cechAugmentation X f)).op)) := by
    have : IsIso (G.map (H.map (DerivedCategory.Q.map (cechAugmentation X f)).op) ≫
        G.map (H.map (DerivedCategory.Q.map ((extendedAlternatingCech X f).ιStupidTrunc
          (ComplexShape.embeddingUpIntGE (0 : ℤ)))).op)) := by
      rw [key]
      infer_instance
    exact IsIso.of_isIso_comp_right _ (G.map (H.map (DerivedCategory.Q.map
      ((extendedAlternatingCech X f).ιStupidTrunc (ComplexShape.embeddingUpIntGE (0 : ℤ)))).op))
  change IsIso (G.map ((derivedStructureSheafHomIso X K).inv ≫
    H.map (DerivedCategory.Q.map (cechAugmentation X f)).op))
  rw [Functor.map_comp]
  exact IsIso.comp_isIso

/-- **The universal property of the Čech completion**: for every `K` in `D(𝒪)` and every `E`
derived complete along `ℐ = (f_1, …, f_r)`, precomposition with the completion map `K ⟶ K^∧` is a
bijection

`Hom_{D(𝒪)}(K^∧, E) ⟶ Hom_{D(𝒪)}(K, E)`,

where `K^∧ = R𝑆heafHom_𝒪(Č(f), K)` is the Čech completion and the map `K ⟶ K^∧` is
`completionUnit`. -/
@[stacks 099B "the universal property of the Čech completion: precomposition with `K ⟶ K^∧` is \
bijective onto the morphisms into a derived-complete object"]
theorem bijective_precomp_completionUnit_generatedIdealSheaf
    (K E : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hE : IsDerivedComplete.{u, u, u, u} X (generatedIdealSheaf f) E) :
    Function.Bijective
      (fun g : (completionFunctor X f).obj K ⟶ E ↦ (completionUnit X f).app K ≫ g) :=
  Stacks.Algebraization.bijective_precomp_completionUnit
    (P := IsDerivedComplete.{u, u, u, u} X (generatedIdealSheaf f)) (completionUnit X f)
    (isIso_completionUnit_app_of_isDerivedComplete_generatedIdealSheaf X f)
    (isIso_completionFunctor_map_completionUnit_app X f) K hE

/-- The completion functor carries the completion map `K ⟶ K^∧` to the completion map
`K^∧ ⟶ (K^∧)^∧`, that is `Φ η_K = η_{Φ K}`. -/
private theorem completionFunctor_map_completionUnit_app
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    (completionFunctor X f).map ((completionUnit X f).app K) =
      (completionUnit X f).app ((completionFunctor X f).obj K) :=
  (bijective_precomp_completionUnit_generatedIdealSheaf X f K _
      (isDerivedComplete_generatedIdealSheaf_completionFunctor_obj X f
        ((completionFunctor X f).obj K))).1
    (Stacks.Algebraization.comp_app_unit (completionUnit X f)
      ((completionUnit X f).app K)).symm

/-- Let `(𝒞, 𝒪)` be a ringed site and let `f_1, …, f_r` be global sections of `𝒪`. The inclusion
of the objects of `D(𝒪)` derived complete along `ℐ = (f_1, …, f_r)` into `D(𝒪)` has a left
adjoint, namely the Čech completion `K ↦ R𝑆heafHom_𝒪(Č(f), K)`. -/
@[stacks 099F "for the sheaf of ideals generated by finitely many global sections of the \
structure sheaf, with the Čech completion of 099B as the left adjoint",
  stacks 099B "the existence of the left adjoint of the inclusion `D_comp(𝒪) ⥤ D(𝒪)`, at the \
ideal sheaf generated by the given global sections"]
theorem isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf :
    (ObjectProperty.ι
      (IsDerivedComplete.{u, u, u, u} X (generatedIdealSheaf f))).IsRightAdjoint :=
  isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf_of_comm X f
    (completionFunctor_map_completionUnit_app X f)

end Derived

end AlgebraicGeometry.RingedSite

end

