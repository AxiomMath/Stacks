@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.RingedSite

section Monotone

universe u

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] isMulCommutative_over overCatCenterLinear
  overFunctor_preservesFiniteLimits overFunctor_preservesFiniteColimits
  hasProductsOfShape_nat_derivedCategory_over

variable (X : RingedSite.{u, u, u})
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
  (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))

/-- **Derived completeness along `ℐ` is the containment `ℐ ≤ 𝒟(K)`.** The predicate of
[Stacks, Tag 0999] asks the Milnor condition `T(K|_U, f) = 0` at every local section `f` of `ℐ`,
and the sections at which that condition holds are exactly the sections of the sheaf of ideals
`AlgebraicGeometry.RingedSite.derivedCompleteIdealSheaf` of [Stacks, Tag 0998]. -/
theorem isDerivedComplete_iff_le_derivedCompleteIdealSheaf :
    IsDerivedComplete.{u, u, u, u} X I K ↔ I ≤ derivedCompleteIdealSheaf X K := by
  rw [isDerivedComplete_iff_forall_isDerivedCompleteAtSection,
    SheafOfModules.Submodule.le_iff, PresheafOfModules.Submodule.le_iff]
  exact ⟨fun h V _ hx => (mem_derivedCompleteIdealSheaf_iff X K V.unop _).2 (h V.unop _ hx),
    fun h U _ hx => (mem_derivedCompleteIdealSheaf_iff X K U _).1 (h (op U) hx)⟩

/-- **Derived completeness is antitone in the sheaf of ideals.** A smaller ideal sheaf has fewer
local sections at which the Milnor condition is tested, so an object derived complete along `𝒥`
is derived complete along every `ℐ ≤ 𝒥`. -/
theorem isDerivedComplete_of_le
    {I J : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hIJ : I ≤ J)
    (hK : IsDerivedComplete.{u, u, u, u} X J K) :
    IsDerivedComplete.{u, u, u, u} X I K :=
  (isDerivedComplete_iff_le_derivedCompleteIdealSheaf X I K).2
    (hIJ.trans ((isDerivedComplete_iff_le_derivedCompleteIdealSheaf X J K).1 hK))

end Monotone

section GlobalSections

universe u

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] isMulCommutative_over overCatCenterLinear
  overFunctor_preservesFiniteLimits overFunctor_preservesFiniteColimits
  hasProductsOfShape_nat_derivedCategory_over

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  {r : ℕ} (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))

/-- **The exact reach of the Čech criterion for [Stacks, Tag 099F], as a sandwich of ideal
sheaves.** The inclusion of the objects derived complete along `ℐ` has a left adjoint as soon as
`ℐ` contains the ideal sheaf generated by the global sections `f_1, …, f_r` and is contained in
the sheaf of ideals of [Stacks, Tag 0998] of every Čech completion `K^∧`.

This is `isRightAdjoint_ι_isDerivedComplete_of_isDerivedComplete_completion` of
`CompletionIdempotent.lean` with both of its hypotheses read as containments of ideal sheaves:
the hypothesis on the generators is `idealOfGlobalSections_le`, and the derived completeness of
`K^∧` is `isDerivedComplete_iff_le_derivedCompleteIdealSheaf`. Stated in this form because it
displays what the criterion can and cannot reach — see the section "What remains for Tag 099F"
of the module docstring. -/
theorem isRightAdjoint_ι_isDerivedComplete_of_le_of_forall_le
    (hge : idealOfGlobalSections X f ≤ I)
    (hle : ∀ K, I ≤ derivedCompleteIdealSheaf X ((completionFunctor X f).obj K)) :
    (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint :=
  isRightAdjoint_ι_isDerivedComplete_of_isDerivedComplete_completion X f I
    (fun i U => (PresheafOfModules.Submodule.le_iff.1
        (SheafOfModules.Submodule.le_iff.1 hge)) (op U)
      (globalSectionVal_mem_idealOfGlobalSections X f i (op U)))
    fun K => (isDerivedComplete_iff_le_derivedCompleteIdealSheaf X I _).2 (hle K)

/-- **The conclusion of [Stacks, Tag 099F] for a sheaf of ideals generated by finitely many global
sections.** If
`ℐ` is the ideal sheaf generated by global sections `f_1, …, f_r` of `𝒪`, then the inclusion of
the objects of `D(𝒪)` derived complete along `ℐ` into `D(𝒪)` has a left adjoint; that left
adjoint is the Čech completion `K ↦ R𝑆heafHom_𝒪(Č(f), K)` of `Completion.lean`.

The hypothesis is given as an equation on an arbitrary `ℐ` rather than by taking `ℐ` to be
`AlgebraicGeometry.RingedSite.idealOfGlobalSections` outright, because that is the form in
which a consumer holding an abstract sheaf of ideals — as the readers of this tag listed in
`CompletedTensorProduct.lean`, `AdicQuotientReduction.lean` and `LocalizationCompletion.lean`
all do — can discharge the instance hypothesis. The underlying statement is
`isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections` of `CompletionIdempotent.lean`,
which is [Stacks, Tag 099B]. For an arbitrary sheaf of ideals of finite type the conclusion is
the instance `AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete` of
`FiniteTypeReflector.lean`, which carries the tag. -/
theorem isRightAdjoint_ι_isDerivedComplete_of_eq_idealOfGlobalSections
    (hI : I = idealOfGlobalSections X f) :
    (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint :=
  hI ▸ isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections X f

end GlobalSections

end AlgebraicGeometry.RingedSite

end
