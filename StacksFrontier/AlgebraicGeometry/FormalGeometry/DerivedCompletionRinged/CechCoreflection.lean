open CategoryTheory CategoryTheory.Limits Opposite

universe u

attribute [local instance] HasDerivedCategory.standard

namespace Stacks.SheafOfModules.DerivedRestrictScalars

open _root_.AlgebraicGeometry

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

open RingedToposSiteHom (coefficientChange)

/-- **An object killed by the derived change of coefficients admits no nonzero morphism into a
complex of `𝒪'`-modules.** For `α : 𝒪 ⟶ 𝒪'` and `T` in `D(𝒪)` with `T ⊗^𝐋_𝒪 𝒪' = 0`, every
morphism from `T` to the image in `D(𝒪)` of an object of `D(𝒪')` vanishes.

This is the base-change adjunction `Lf^* ⊣ Rf_*` of [Stacks, Tag 07A6] at the morphism of
ringed topoi which `α` presents over the identity of the site: the derived pullback along it is
`Stacks.Cohomology.derivedCoefficientChange`, which exists for every `α` with no flatness
hypothesis, and its right adjoint is identified with restriction of scalars on derived
categories exactly as in
`Stacks.SheafOfModules.DerivedRestrictScalars.preservesProducts_mapDerivedCategory`. -/
theorem subsingleton_hom_restrictScalars_of_isZero_derivedCoefficientChange
    {O O' : Sheaf J CommRingCat.{u}} (α : O ⟶ O')
    {T : DerivedCategory (_root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf O))}
    (hT : IsZero ((Cohomology.derivedCoefficientChange α).obj T))
    (N : DerivedCategory (_root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf O'))) :
    Subsingleton (T ⟶ (_root_.SheafOfModules.restrictScalars.{u}
      ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map α)).mapDerivedCategory.obj
        N) := by
  have hmos : (coefficientChange J α).u.IsMorphismOfSites
      (Cohomology.ringedTopos J O).J (Cohomology.ringedTopos J O').J :=
    isMorphismOfSites_id J
  have hadd : (coefficientChange J α).pushforwardTopos.Additive :=
    RingedToposSiteHom.pushforwardTopos_additive _
  have hlim : PreservesFiniteLimits (coefficientChange J α).pushforwardTopos :=
    inferInstanceAs (PreservesFiniteLimits
      (_root_.SheafOfModules.restrictScalars.{u} (coefficientChange J α).fSharpRing))
  have hcol : PreservesFiniteColimits (coefficientChange J α).pushforwardTopos :=
    inferInstanceAs (PreservesFiniteColimits
      (_root_.SheafOfModules.restrictScalars.{u} (coefficientChange J α).fSharpRing))
  have hLf :=
    Cohomology.DerivedPullbackOnRingedTopoi.hasLeftDerivedFunctor_pullbackOnHomotopy
      (coefficientChange J α) hmos
  have adj := Cohomology.DerivedPullbackPushforwardAdjunction.derivedPullbackPushforwardAdjunction
    (coefficientChange J α) Cohomology.DerivedPullbackPushforwardAdjunction.IsKFlat
    Cohomology.DerivedPullbackPushforwardAdjunction.hasResolutions_isKFlat
    (Cohomology.DerivedPullbackOnRingedTopoi.pullbackInvertsQuasiIso_isKFlat
      (coefficientChange J α) hmos)
  have hrd := Functor.isRightDerivedFunctor_mapDerivedCategory_of_exact
    (coefficientChange J α).pushforwardTopos
  have e : Cohomology.DerivedPullbackPushforwardAdjunction.derivedPushforward
        (coefficientChange J α) ≅
      (coefficientChange J α).pushforwardTopos.mapDerivedCategory :=
    Functor.rightDerivedUnique _ _
      (Cohomology.DerivedPullbackPushforwardAdjunction.derivedPushforwardUnit
        (coefficientChange J α))
      (coefficientChange J α).pushforwardTopos.mapDerivedCategoryFactorsh.inv
      (HomotopyCategory.quasiIso
        (_root_.SheafOfModules.{u}
          (Stacks.SheafOfModules.Tensor.ringSheaf (Cohomology.ringedTopos J O').O))
        (ComplexShape.up ℤ))
  have h0 : Subsingleton ((Cohomology.derivedCoefficientChange α).obj T ⟶ N) :=
    ⟨fun a b => hT.eq_of_src a b⟩
  have h1 : Subsingleton (T ⟶
      (Cohomology.DerivedPullbackPushforwardAdjunction.derivedPushforward
        (coefficientChange J α)).obj N) :=
    (adj.homEquiv T N).symm.injective.subsingleton
  exact Stacks.LocalCohomology.subsingleton_hom_of_iso (e.app N) h1

omit [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})] [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- **Left orthogonality propagates along a tower of sheaves of rings**: if `T` admits no
nonzero morphism into the image of `D(R')` in `D(R)` and `R ⟶ R''` factors through `R'`, then it
admits none into the image of `D(R'')` either.

Restriction of scalars along `a ≫ b` is restriction along `a` of restriction along `b`, an
equality of functors on complexes, so the comparison in the derived category is read off from
`CategoryTheory.Functor.mapDerivedCategoryFactors` at a complex representing the given object.
This is the mirror of
`AlgebraicGeometry.RingedSite.isZero_derivedSheafHom_restrictScalars_of_factorization`, which
does the same for the derived internal Hom *out of* the image. -/
theorem subsingleton_hom_restrictScalars_of_factorization
    {R R' R'' : Sheaf J RingCat.{u}} (a : R ⟶ R') (b : R' ⟶ R'') (c : R ⟶ R'')
    (hc : a ≫ b = c) {T : DerivedCategory (_root_.SheafOfModules.{u} R)}
    (H : ∀ L : DerivedCategory (_root_.SheafOfModules.{u} R'),
      Subsingleton (T ⟶ (_root_.SheafOfModules.restrictScalars.{u} a).mapDerivedCategory.obj L))
    (L : DerivedCategory (_root_.SheafOfModules.{u} R'')) :
    Subsingleton (T ⟶
      (_root_.SheafOfModules.restrictScalars.{u} c).mapDerivedCategory.obj L) := by
  subst hc
  set L₀ := DerivedCategory.Q.objPreimage L with hL₀
  have eL : DerivedCategory.Q.obj L₀ ≅ L := DerivedCategory.Q.objObjPreimageIso L
  set A := _root_.SheafOfModules.restrictScalars.{u} a with hA
  set B := _root_.SheafOfModules.restrictScalars.{u} b with hB
  have e : (_root_.SheafOfModules.restrictScalars.{u} (a ≫ b)).mapDerivedCategory.obj L ≅
      A.mapDerivedCategory.obj
        (DerivedCategory.Q.obj ((B.mapHomologicalComplex (ComplexShape.up ℤ)).obj L₀)) :=
    (_root_.SheafOfModules.restrictScalars.{u} (a ≫ b)).mapDerivedCategory.mapIso eL.symm ≪≫
      (_root_.SheafOfModules.restrictScalars.{u} (a ≫ b)).mapDerivedCategoryFactors.app L₀ ≪≫
        (A.mapDerivedCategoryFactors.app
          ((B.mapHomologicalComplex (ComplexShape.up ℤ)).obj L₀)).symm
  have := H (DerivedCategory.Q.obj ((B.mapHomologicalComplex (ComplexShape.up ℤ)).obj L₀))
  exact Stacks.LocalCohomology.subsingleton_hom_of_iso e.symm this

section Conservative

omit [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})] [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- **Restriction of scalars reflects the zero object of the derived category.** If the image of
`Y` in `D(R)` under restriction of scalars along `R ⟶ R'` is zero then `Y` is zero.

An object of an unbounded derived category is zero exactly when all of its cohomology vanishes,
restriction of scalars is exact and hence commutes with cohomology, and it is faithful, so a
cohomology object whose restriction is zero has identity zero. -/
theorem isZero_of_isZero_restrictScalars_mapDerivedCategory
    {R R' : Sheaf J RingCat.{u}} (a : R ⟶ R')
    {Y : DerivedCategory (_root_.SheafOfModules.{u} R')}
    (h : IsZero ((_root_.SheafOfModules.restrictScalars.{u} a).mapDerivedCategory.obj Y)) :
    IsZero Y := by
  rw [DerivedCategory.isZero_iff_forall_isZero_homology] at h ⊢
  intro n
  have e := (StacksDraft.DerivedCategoryHomology.mapDerivedCategoryHomologyIso
    (_root_.SheafOfModules.restrictScalars.{u} a) n).app Y
  have h' : IsZero ((_root_.SheafOfModules.restrictScalars.{u} a).obj
      ((DerivedCategory.homologyFunctor (_root_.SheafOfModules.{u} R') n).obj Y)) :=
    (h n).of_iso e.symm
  refine (IsZero.iff_id_eq_zero _).2
    ((_root_.SheafOfModules.restrictScalars.{u} a).map_injective
      (a₁ := 𝟙 ((DerivedCategory.homologyFunctor (_root_.SheafOfModules.{u} R') n).obj Y))
      (a₂ := 0) ?_)
  rw [CategoryTheory.Functor.map_id, (_root_.SheafOfModules.restrictScalars.{u} a).map_zero]
  exact (IsZero.iff_id_eq_zero _).1 h'

end Conservative

end Stacks.SheafOfModules.DerivedRestrictScalars

namespace AlgebraicGeometry.RingedSite

attribute [local instance] hasMapBifunctor
attribute [local instance] linearCatCenterRingSheaf

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]

/-- **The derived base change of `M` to `𝒪_g` vanishes as soon as `𝒪_g ⊗^𝐋_𝒪 M` does.**

The projection formula of [Stacks, Tag 0942]'s dévissage,
`Stacks.Cohomology.CoefficientChange.projectionFormulaIso`, at the sheaf of modules `𝒪_g` reads
`M ⊗^𝐋_𝒪 𝒪_g` as the restriction to `𝒪` of `(M ⊗^𝐋_𝒪 𝒪_g) ⊗^𝐋_{𝒪_g} 𝒪_g`, which the unit
constraint of [Stacks, Tag 0FPT] collapses to the restriction of the derived base change; and
restriction of scalars reflects the zero object. The two factors are exchanged by the
commutativity constraint, `AlgebraicGeometry.RingedSite.derivedTensorBraidingIso`. -/
theorem isZero_derivedCoefficientChange_of_isZero_derivedTensor
    (g : Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (M : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (h : IsZero (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
      (DerivedCategory.Q.obj (awaySingleComplex X g))).obj M)) :
    IsZero ((Stacks.Cohomology.derivedCoefficientChange (toAwaySheaf g)).obj M) := by
  have h1 : IsZero (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj M).obj
      (DerivedCategory.Q.obj (awaySingleComplex X g))) :=
    h.of_iso (derivedTensorBraidingIso X M (DerivedCategory.Q.obj (awaySingleComplex X g)))
  refine
    Stacks.SheafOfModules.DerivedRestrictScalars.isZero_of_isZero_restrictScalars_mapDerivedCategory
      (toAwayRingSheaf X g) (h1.of_iso ?_)
  exact (Stacks.Cohomology.CoefficientChange.projectionFormulaIso (toAwaySheaf g)
      (derivedTensorProductDatumOfSite X (Stacks.SheafOfModules.canonicalDerivedTensorProduct X))
      (derivedTensorProductDatumOfSite (awayRingedSite X g)
        (Stacks.SheafOfModules.canonicalDerivedTensorProduct (awayRingedSite X g)))
      M (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (awayRingedSite X g).O)) ≪≫
    (SheafOfModules.restrictScalars.{u}
        (toAwayRingSheaf X g)).mapDerivedCategory.mapIso
      ((derivedTensorProductDatumOfSite (awayRingedSite X g)
        (Stacks.SheafOfModules.canonicalDerivedTensorProduct
          (awayRingedSite X g))).rightUnitIso (awayRingedSite X g)
        ((Stacks.Cohomology.derivedCoefficientChange (toAwaySheaf g)).obj M))).symm

/-- **Every power of `f_j` with `j ∈ S` becomes invertible in `𝒪_{f_S}`**, `f_j` being one of the
factors of `f_S`. This is
`AlgebraicGeometry.RingedSite.isUnit_toAwaySheaf_prodGlobalSection_of_subset` at the singleton
`{j}`, whose subproduct is `f_j`. -/
theorem isUnit_toAwaySheaf_prodGlobalSection_of_mem {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    {j : Fin r} {S : Finset (Fin r)} (hj : j ∈ S) (U : X.Cᵒᵖ) (n : ℕ) :
    IsUnit (((toAwaySheaf (prodGlobalSection f S)).hom.app U).hom
      (globalSectionVal (f j) U ^ n)) := by
  have h := isUnit_toAwaySheaf_prodGlobalSection_of_subset f
    (Finset.singleton_subset_iff.mpr hj) U n
  rwa [globalSectionVal_prodGlobalSection, Finset.prod_singleton] at h

open Stacks.SheafOfModules.DerivedRestrictScalars in
/-- **A localization `𝒪_{f_S}`, placed in any degree, receives no nonzero morphism from an object
killed by the derived base change to `𝒪_{f_j}`, for any `j ∈ S`.** The canonical map
`𝒪 ⟶ 𝒪_{f_S}` factors through `𝒪_{f_j}`, uniquely, because `f_j` is invertible in `𝒪_{f_S}`; so
`𝒪_{f_S}` lies in the image of `D(𝒪_{f_j})` and the base-change adjunction applies. -/
theorem subsingleton_hom_singleFunctor_awayModule_prodGlobalSection {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    {T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    {j : Fin r}
    (hT : IsZero ((Stacks.Cohomology.derivedCoefficientChange (toAwaySheaf (f j))).obj T))
    {S : Finset (Fin r)} (hj : j ∈ S) (q : ℤ) :
    Subsingleton (T ⟶ (DerivedCategory.singleFunctor
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q).obj
      (awayModule X (prodGlobalSection f S))) := by
  obtain ⟨φ, hφ, -⟩ := existsUnique_lift_toAwaySheaf (f j)
    (awaySheaf (prodGlobalSection f S)) (toAwaySheaf (prodGlobalSection f S))
    (isUnit_toAwaySheaf_prodGlobalSection_of_mem X f hj)
  have H := subsingleton_hom_restrictScalars_of_factorization
    (toAwayRingSheaf X (f j)) (awayRingSheafMap X φ) (toAwayRingSheaf X (prodGlobalSection f S))
    (toAwayRingSheaf_comp_awayRingSheafMap X φ hφ)
    (fun L => subsingleton_hom_restrictScalars_of_isZero_derivedCoefficientChange
      (toAwaySheaf (f j)) hT L)
    ((DerivedCategory.singleFunctor
      (SheafOfModules.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf (awayRingedSite X (prodGlobalSection f S)).O))
        q).obj
      (SheafOfModules.unit
        (Stacks.SheafOfModules.Tensor.ringSheaf (awayRingedSite X (prodGlobalSection f S)).O)))
  have e : (SheafOfModules.restrictScalars.{u}
        (toAwayRingSheaf X (prodGlobalSection f S))).mapDerivedCategory.obj
          ((DerivedCategory.singleFunctor
            (SheafOfModules.{u}
              (Stacks.SheafOfModules.Tensor.ringSheaf
                (awayRingedSite X (prodGlobalSection f S)).O)) q).obj
            (SheafOfModules.unit
              (Stacks.SheafOfModules.Tensor.ringSheaf
                (awayRingedSite X (prodGlobalSection f S)).O))) ≅
      (DerivedCategory.singleFunctor
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q).obj
        (awayModule X (prodGlobalSection f S)) :=
    ((SheafOfModules.restrictScalars.{u}
      (toAwayRingSheaf X (prodGlobalSection f S))).mapDerivedCategorySingleFunctor q).app
      (SheafOfModules.unit
        (Stacks.SheafOfModules.Tensor.ringSheaf (awayRingedSite X (prodGlobalSection f S)).O))
  exact Stacks.LocalCohomology.subsingleton_hom_of_iso e H

/-- Every subset of `Fin r` of nonzero cardinality is nonempty. -/
private theorem nonempty_of_idx {r : ℕ} {i : ℤ} (hi : i ≠ 0)
    (S : CategoryTheory.AlternatingCech.Idx r i) : S.1.Nonempty := by
  rw [← Finset.card_pos]
  have h := S.2
  rcases Nat.eq_zero_or_pos S.1.card with hc | hc
  · exact absurd (by rw [← h, hc]; rfl) hi
  · exact hc

/-- **The terms of the Čech complex in nonzero degrees are invisible to a torsion object.** The
degree-`i` term is the product of the `𝒪_{f_S}` over the subsets `S` of cardinality `i`; the
index type is finite, so morphisms into the product are detected on each factor, and for
`i ≠ 0` every such `S` contains an index. -/
theorem subsingleton_hom_singleFunctor_extendedAlternatingCech_X {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    {T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (hT : ∀ i : Fin r,
      IsZero ((Stacks.Cohomology.derivedCoefficientChange (toAwaySheaf (f i))).obj T))
    {i : ℤ} (hi : i ≠ 0) (q : ℤ) :
    Subsingleton (T ⟶ (DerivedCategory.singleFunctor
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q).obj
      ((extendedAlternatingCech X f).X i)) := by
  classical
  refine Stacks.LocalCohomology.subsingleton_hom_of_iso
    (PreservesProduct.iso (DerivedCategory.singleFunctor
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q)
      (fun S : CategoryTheory.AlternatingCech.Idx r i =>
        awayModule X (prodGlobalSection f S.1))).symm ?_
  refine Stacks.LocalCohomology.subsingleton_hom_pi T _ fun S => ?_
  obtain ⟨j, hj⟩ := nonempty_of_idx hi S
  exact subsingleton_hom_singleFunctor_awayModule_prodGlobalSection X f (hT j) hj q

/-- **The Čech augmentation is universal among morphisms from a torsion object**, with the
torsion hypothesis in the form the proof consumes: the derived base change of `T` to each
`𝒪_{f_i}` vanishes. For every such `T`, composing with `Č(f) ⟶ 𝒪` identifies the morphisms from
`T` to `Č(f)` with the morphisms from `T` to `𝒪`.

`AlgebraicGeometry.RingedSite.bijective_comp_cechAugmentation_of_derivedPowerTorsion` is the
same statement with the hypothesis read as the vanishing of the derived localizations
`𝒪_{f_i} ⊗^𝐋_𝒪 T`, which is the form `Č(f)` itself is known to satisfy. -/
theorem bijective_comp_cechAugmentation {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hT : ∀ i : Fin r,
      IsZero ((Stacks.Cohomology.derivedCoefficientChange (toAwaySheaf (f i))).obj T)) :
    Function.Bijective
      (fun g : T ⟶ DerivedCategory.Q.obj (extendedAlternatingCech X f) =>
        g ≫ DerivedCategory.Q.map (cechAugmentation X f)) :=
  Stacks.LocalCohomology.bijective_comp_toSingle T (extendedAlternatingCech X f)
    (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 0 0 (r + 1)
    (cechAugmentation X f)
    (by
      rw [cechAugmentation_f_zero]
      have := isIso_cechAugmentationZero X f
      infer_instance)
    (fun i hi => by
      rcases hi with h | h
      · exact isZero_extendedAlternatingCech_X_of_neg X f h
      · refine isZero_extendedAlternatingCech_X_of_lt X f ?_
        push_cast at h
        omega)
    (fun i hi q => subsingleton_hom_singleFunctor_extendedAlternatingCech_X X f hT hi q)

/-! ### The torsion condition, and the coreflection -/

/-- **The `ℐ`-power-torsion condition on an object of `D(𝒪)`**, for `ℐ` the sheaf of ideals
generated by the global sections `f_1, …, f_r`: the derived localization `𝒪_{f_i} ⊗^𝐋_𝒪 T`
vanishes for every `i`.

This is the sheaf-level form of the ring-level `Dualizing.derivedPowerTorsionProperty`, which
`Dualizing.PowerTorsionBaseChange.derivedPowerTorsion_iff_locDerived_isZero` identifies with the
vanishing of the derived localization at each element of a generating family. That it is a
condition on the cohomology *sheaves* of `T`, namely that inverting any one of the `f_i` kills
every `H^q(T)`, is `AlgebraicGeometry.RingedSite.derivedPowerTorsion_iff`. -/
def DerivedPowerTorsion {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    Prop :=
  ∀ i : Fin r, IsZero (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
    (DerivedCategory.Q.obj (awaySingleComplex X (f i)))).obj T)

/-- **The torsion condition is a condition on the cohomology sheaves**: the derived localization
`𝒪_{f_i} ⊗^𝐋_𝒪 T` vanishes for every `i` exactly when `𝒪_{f_i} ⊗_𝒪 H^q(T)` vanishes for every
`i` and every `q`, that is, exactly when inverting any one of the `f_i` kills every cohomology
sheaf of `T`.

`𝒪_{f_i}` is flat over `𝒪` by `AlgebraicGeometry.RingedSite.isFlatMap_toAwaySheaf`, so tensoring
with it commutes with cohomology — `Stacks.DerivedTensor.RingedSite.homologyTensorFlatIso` — and
an object of the derived category is zero exactly when all its cohomology is. -/
theorem derivedPowerTorsion_iff {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    DerivedPowerTorsion X f T ↔ ∀ (i : Fin r) (q : ℤ),
      IsZero (((Stacks.SheafOfModules.Tensor.sheafTensor X.O).obj
        ((DerivedCategory.homologyFunctor
          (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q).obj T)).obj
        (awayModule X (f i))) := by
  refine forall_congr' fun i => ?_
  set L := DerivedCategory.Q.objPreimage T with hL
  have eL : DerivedCategory.Q.obj L ≅ T := DerivedCategory.Q.objObjPreimageIso T
  have e1 : ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
      (DerivedCategory.Q.obj (awaySingleComplex X (f i)))).obj T ≅
      (((Stacks.DerivedTensor.RingedSite.canonicalDerivedTensorProduct X.O).tensor.obj
        (DerivedCategory.Q.obj L)).obj
        (DerivedCategory.Q.obj (awaySingleComplex X (f i)))) :=
    derivedTensorBraidingIso X (DerivedCategory.Q.obj (awaySingleComplex X (f i))) T ≪≫
      derivedTensorObjIso X T (DerivedCategory.Q.obj (awaySingleComplex X (f i))) ≪≫
      (((Stacks.DerivedTensor.RingedSite.canonicalDerivedTensorProduct X.O).tensor.mapIso
        eL.symm).app (DerivedCategory.Q.obj (awaySingleComplex X (f i))))
  rw [e1.isZero_iff, DerivedCategory.isZero_iff_forall_isZero_homology]
  refine forall_congr' fun q => ?_
  refine Iso.isZero_iff ?_
  refine Stacks.DerivedTensor.RingedSite.homologyTensorFlatIso X.O (awayModule X (f i))
      (isFlatMap_toAwaySheaf (f i)) L q ≪≫
    ((Stacks.SheafOfModules.Tensor.sheafTensor X.O).mapIso ?_).app (awayModule X (f i))
  exact ((DerivedCategory.homologyFunctorFactors
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q).app L).symm ≪≫
    (DerivedCategory.homologyFunctor
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) q).mapIso eL

/-- **The extended alternating Čech complex is `ℐ`-power-torsion.** Tensoring `Č(f)` with
`𝒪_{f_i}` kills it, `f_i` becoming invertible there; this is
`isZero_derivedTensor_awayComplex_extendedAlternatingCech_prodGlobalSection`
at the singleton `{i}`, whose subproduct is `f_i`. -/
theorem derivedPowerTorsion_extendedAlternatingCech {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u})) :
    DerivedPowerTorsion X f (DerivedCategory.Q.obj (extendedAlternatingCech X f)) := by
  intro i
  have h := isZero_derivedTensor_awayComplex_extendedAlternatingCech_prodGlobalSection X f {i} i
    (Finset.mem_singleton_self i)
  rwa [prodGlobalSection_singleton] at h

/-- **The Čech augmentation is universal among morphisms from an `ℐ`-power-torsion object.** For
every `T` in `D(𝒪)` all of whose derived localizations `𝒪_{f_i} ⊗^𝐋_𝒪 T` vanish, composing with
the augmentation `Č(f) ⟶ 𝒪` is a bijection

`Hom_{D(𝒪)}(T, Č(f)) ⟶ Hom_{D(𝒪)}(T, 𝒪)`.

Together with `AlgebraicGeometry.RingedSite.derivedPowerTorsion_extendedAlternatingCech`, which
says that `Č(f)` is itself `ℐ`-power-torsion, this exhibits `Č(f) ⟶ 𝒪` as a coreflection of
`D(𝒪)` onto the `ℐ`-power-torsion objects. It is the sheaf-level counterpart of the ring-level
`Stacks.LocalCohomology.bijective_comp_extendedCechAugmentationHom`. -/
theorem bijective_comp_cechAugmentation_of_derivedPowerTorsion {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hT : DerivedPowerTorsion X f T) :
    Function.Bijective
      (fun g : T ⟶ DerivedCategory.Q.obj (extendedAlternatingCech X f) =>
        g ≫ DerivedCategory.Q.map (cechAugmentation X f)) :=
  bijective_comp_cechAugmentation X f T
    fun i => isZero_derivedCoefficientChange_of_isZero_derivedTensor X (f i) T (hT i)

/-- **The coreflection is unique: anything with the same universal property is `Č(f)`.** If
`κ : K ⟶ 𝒪` is a morphism of `D(𝒪)` with `K` an `ℐ`-power-torsion object and with the universal
property of the Čech augmentation, then there is an isomorphism `Č(f) ≅ K` in `D(𝒪)` carrying
`κ` to the augmentation.

This is the form in which [Stacks, Tag 099E] needs the universal property: a complex on `𝒞`
produced by any construction whatever is identified with `Č(f)` over `𝒪` as soon as it is
power-torsion and universal, with no natural map between the two constructions to be
built. -/
theorem exists_iso_extendedAlternatingCech_of_universal {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (κ : K ⟶ DerivedCategory.Q.obj (structureSheafComplex X))
    (hK : DerivedPowerTorsion X f K)
    (hκ : ∀ T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)),
      DerivedPowerTorsion X f T →
      Function.Bijective (fun g : T ⟶ K => g ≫ κ)) :
    ∃ e : DerivedCategory.Q.obj (extendedAlternatingCech X f) ≅ K,
      e.hom ≫ κ = DerivedCategory.Q.map (cechAugmentation X f) :=
  Stacks.LocalCohomology.exists_iso_over_of_universal _ _
    (hκ _ (derivedPowerTorsion_extendedAlternatingCech X f))
    (bijective_comp_cechAugmentation_of_derivedPowerTorsion X f K hK)
    (bijective_comp_cechAugmentation_of_derivedPowerTorsion X f _
      (derivedPowerTorsion_extendedAlternatingCech X f)).1
    (hκ _ hK).1

omit [HasWeakSheafify X.J CommRingCat.{u}] in
/-- **The universal property on a slice site**, which is the form [Stacks, Tag 099E] uses it in:
for an object `U` of `𝒞` and a finite family `f` of global sections of `𝒪_U` — the family that
`AlgebraicGeometry.RingedSite.exists_coversTop_eq_generatedIdealSheaf_of_isFiniteType` produces
from a finite-type sheaf of ideals — the Čech augmentation over `𝒪_U` is universal among
morphisms from an object of `D(𝒪_U)` whose derived localizations at the `f_i` vanish.

This is `AlgebraicGeometry.RingedSite.bijective_comp_cechAugmentation_of_derivedPowerTorsion`
read on the localized ringed site `AlgebraicGeometry.RingedSite.over` of [Stacks, Tag 04IX];
the hypothesis on the slice topology is the one the neighbouring slice statements take. -/
theorem bijective_comp_cechAugmentation_over (U : X.C)
    [HasWeakSheafify (X.J.over U) CommRingCat.{u}] {r : ℕ}
    (f : Fin r → Presheaf.globalSections ((X.over U).O.obj ⋙ forget CommRingCat.{u}))
    (T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (X.over U).O)))
    (hT : DerivedPowerTorsion (X.over U) f T) :
    Function.Bijective
      (fun g : T ⟶ DerivedCategory.Q.obj (extendedAlternatingCech (X.over U) f) =>
        g ≫ DerivedCategory.Q.map (cechAugmentation (X.over U) f)) := by
  have : HasWeakSheafify (X.over U).J CommRingCat.{u} :=
    inferInstanceAs (HasWeakSheafify (X.J.over U) CommRingCat.{u})
  exact bijective_comp_cechAugmentation_of_derivedPowerTorsion (X.over U) f T hT

end AlgebraicGeometry.RingedSite

