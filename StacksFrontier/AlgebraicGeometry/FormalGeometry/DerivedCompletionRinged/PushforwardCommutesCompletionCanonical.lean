section Orthogonal

variable (X : RingedSite.{u, u, u})
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
  [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint]

/-- A map out of `K^∧` into a derived-complete object vanishes if its restriction along the
completion map does. -/
private theorem eq_zero_of_derivedCompletionUnit_comp_eq_zero
    {K Z : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hZ : IsDerivedComplete.{u, u, u, u} X I Z) {φ : (derivedCompletion X I).obj K ⟶ Z}
    (h : (derivedCompletionUnit X I).app K ≫ φ = 0) : φ = 0 :=
  (bijective_derivedCompletionUnit_comp X I hZ (K := K)).1
    (h.trans comp_zero.symm)

/-- **An object admits no nonzero map to a derived-complete object exactly when its derived
completion vanishes.** Both directions are the universal property of the reflector of
[Stacks, Tag 099F], `AlgebraicGeometry.RingedSite.bijective_derivedCompletionUnit_comp`: every
map `K ⟶ Z` into a derived-complete `Z` factors through `K^∧`, so it vanishes when `K^∧` does;
and conversely the identity of `K^∧`, being determined by its restriction along `K ⟶ K^∧`, is
zero as soon as that restriction is. -/
theorem leftOrthogonal_isDerivedComplete_iff_isZero_derivedCompletion
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    ObjectProperty.leftOrthogonal (IsDerivedComplete.{u, u, u, u} X I) K ↔
      IsZero ((derivedCompletion X I).obj K) := by
  constructor
  · intro h
    rw [IsZero.iff_id_eq_zero]
    refine eq_zero_of_derivedCompletionUnit_comp_eq_zero X I
      (isDerivedComplete_derivedCompletion_obj X I K) ?_
    rw [Category.comp_id]
    exact h _ (isDerivedComplete_derivedCompletion_obj X I K)
  · intro h Z φ hZ
    obtain ⟨g, hg⟩ := (bijective_derivedCompletionUnit_comp X I hZ (K := K)).2 φ
    have hg' : (derivedCompletionUnit X I).app K ≫ g = φ := hg
    rw [← hg', h.eq_of_src g 0, comp_zero]

/-- **Every map `K⟦1⟧ ⟶ Z` into a derived-complete object factors through `(K^∧)⟦1⟧`.**

The shift is an equivalence, so a map out of `K⟦1⟧` is a map `K ⟶ Z⟦-1⟧`; `Z⟦-1⟧` is derived
complete by `AlgebraicGeometry.RingedSite.isDerivedComplete_shiftFunctor_obj`, so that map
factors through `K ⟶ K^∧` by the universal property of the reflector, and the factorisation is
carried back along the adjunction, whose hom-set bijection is natural in the source. -/
theorem exists_comp_shift_derivedCompletionUnit
    {K Z : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hZ : IsDerivedComplete.{u, u, u, u} X I Z) (ψ : K⟦(1 : ℤ)⟧ ⟶ Z) :
    ∃ χ : ((derivedCompletion X I).obj K)⟦(1 : ℤ)⟧ ⟶ Z,
      ((derivedCompletionUnit X I).app K)⟦(1 : ℤ)⟧' ≫ χ = ψ := by
  have adj :
      shiftFunctor
          (DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
          (1 : ℤ) ⊣
        shiftFunctor
          (DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
          (-1 : ℤ) :=
    (shiftEquiv
      (DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
      (1 : ℤ)).toAdjunction
  obtain ⟨χ₀, hχ₀⟩ := (bijective_derivedCompletionUnit_comp X I
    (isDerivedComplete_shiftFunctor_obj X I (-1) hZ) (K := K)).2 (adj.homEquiv K Z ψ)
  have hχ₀' : (derivedCompletionUnit X I).app K ≫ χ₀ = adj.homEquiv K Z ψ := hχ₀
  refine ⟨(adj.homEquiv _ Z).symm χ₀, (adj.homEquiv K Z).injective ?_⟩
  rw [Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply, hχ₀']

/-- **The cone of the completion map `K ⟶ K^∧` admits no nonzero map to a derived-complete
object.** Equivalently, its own derived completion vanishes.

Let `φ : C ⟶ Z` with `Z` derived complete. Its restriction to `K^∧` is killed by the completion
map, because two consecutive maps of a distinguished triangle compose to zero, hence vanishes by
the universal property; so `φ` factors through `K⟦1⟧`, hence — by
`exists_comp_shift_derivedCompletionUnit`, which is where shift-stability of derived
completeness is used — through `(K^∧)⟦1⟧`; and the composite `C ⟶ K⟦1⟧ ⟶ (K^∧)⟦1⟧` of the
triangle's third map with the shift of its first is zero. -/
theorem leftOrthogonal_isDerivedComplete_cone_derivedCompletionUnit
    {K Cn : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (v : (derivedCompletion X I).obj K ⟶ Cn) (w : Cn ⟶ K⟦(1 : ℤ)⟧)
    (hT : Triangle.mk ((derivedCompletionUnit X I).app K) v w ∈
      distTriang
        (DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))) :
    ObjectProperty.leftOrthogonal (IsDerivedComplete.{u, u, u, u} X I) Cn := by
  intro Z φ hZ
  have h12 : (derivedCompletionUnit X I).app K ≫ v = 0 :=
    comp_distTriang_mor_zero₁₂ _ hT
  have h31 : w ≫ ((derivedCompletionUnit X I).app K)⟦(1 : ℤ)⟧' = 0 :=
    comp_distTriang_mor_zero₃₁ _ hT
  have ha : v ≫ φ = 0 := by
    refine eq_zero_of_derivedCompletionUnit_comp_eq_zero X I hZ ?_
    rw [← Category.assoc, h12, zero_comp]
  obtain ⟨ψ, hψ⟩ := Triangle.yoneda_exact₃ _ hT φ ha
  have hψ' : φ = w ≫ ψ := hψ
  obtain ⟨χ, hχ⟩ := exists_comp_shift_derivedCompletionUnit X I (K := K) hZ ψ
  rw [hψ', ← hχ, ← Category.assoc, h31, zero_comp]

end Orthogonal

section Pushforward

variable {X Y : RingedSite.{u, u, u}} (f : RingedSite.Hom X Y)
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))
  (I' : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
  (hI : PushforwardIdealCompatible f I I')
  [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I')).IsRightAdjoint]
  [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I)).IsRightAdjoint]

/-- **`Rf_*` carries an object orthogonal to the derived-complete objects of `D(𝒪')` to one
orthogonal to the derived-complete objects of `D(𝒪)`**, as soon as the display
`Rf_*(D^∧) ≅ (Rf_*D)^∧` of [Stacks, Tag 0A0G] holds at the level of objects.

Orthogonality is vanishing of the derived completion, by
`leftOrthogonal_isDerivedComplete_iff_isZero_derivedCompletion`; so the hypothesis says
`D^∧ = 0`, whence `Rf_*(D^∧) = 0`, and the display transports that vanishing to `(Rf_*D)^∧`. The
display is used here at the object `D` only, which is why the hypothesis is quantified over all
objects in the consumers below rather than over one. -/
theorem leftOrthogonal_isDerivedComplete_derivedPushforward
    [(derivedPushforward.{u} f.toRingedToposSiteHom).PreservesZeroMorphisms]
    (habs : ∀ D :
        DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      Nonempty ((derivedPushforward.{u} f.toRingedToposSiteHom).obj
          ((derivedCompletion X I').obj D) ≅
        (derivedCompletion Y I).obj ((derivedPushforward.{u} f.toRingedToposSiteHom).obj D)))
    {D : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hD : ObjectProperty.leftOrthogonal (IsDerivedComplete.{u, u, u, u} X I') D) :
    ObjectProperty.leftOrthogonal (IsDerivedComplete.{u, u, u, u} Y I)
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj D) := by
  rw [leftOrthogonal_isDerivedComplete_iff_isZero_derivedCompletion] at hD ⊢
  obtain ⟨e⟩ := habs D
  exact (Functor.map_isZero (derivedPushforward.{u} f.toRingedToposSiteHom) hD).of_iso e.symm

include hI in
/-- **The display at the level of objects, for every object, makes the canonical comparison map
of [Stacks, Tag 0A0G] invertible.** If `Rf_*(D^∧) ≅ (Rf_*D)^∧` for every `D ∈ D(𝒪')` — an
isomorphism of objects, not asked to be canonical or natural — then
`AlgebraicGeometry.RingedSite.derivedCompletionPushforwardComparison`, the canonical map
`(Rf_*K)^∧ ⟶ Rf_*(K^∧)`, is invertible at every `K`.

So the step from the source's display to the source's actual assertion costs nothing beyond
quantifying the display over all objects. The argument applies it at the cone `C` of the
completion map `K ⟶ K^∧`: that cone is orthogonal to the derived-complete objects by
`leftOrthogonal_isDerivedComplete_cone_derivedCompletionUnit`, so `Rf_*C` is orthogonal to them
too by `leftOrthogonal_isDerivedComplete_derivedPushforward`, and so is `(Rf_*C)⟦-1⟧` because
that orthogonal is stable under the shift. `Rf_*` is exact, hence carries the triangle
`K ⟶ K^∧ ⟶ C` to a distinguished triangle, and a triangle whose third object is orthogonal to
`N` in both its shifts makes composition with `Rf_*(K ⟶ K^∧)` a bijection
`Hom(Rf_*(K^∧), N) ≃ Hom(Rf_*K, N)` — which is exactly
`isIso_derivedCompletionPushforwardComparison_iff_bijective`.

The sheaves of ideals are arbitrary, subject only to the source's relation `hI` between them
([Stacks, Tag 099J]'s hypothesis), which the comparison map needs in order to exist. -/
theorem isIso_derivedCompletionPushforwardComparison_of_nonempty_iso
    (habs : ∀ D :
        DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      Nonempty ((derivedPushforward.{u} f.toRingedToposSiteHom).obj
          ((derivedCompletion X I').obj D) ≅
        (derivedCompletion Y I).obj ((derivedPushforward.{u} f.toRingedToposSiteHom).obj D)))
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    IsIso ((derivedCompletionPushforwardComparison f I I' hI).app K) := by
  let _ := Functor.IsRightDerivedFunctor.commShift
    (derivedPushforward.{u} f.toRingedToposSiteHom)
    (derivedPushforwardUnit f.toRingedToposSiteHom)
    (HomotopyCategory.quasiIso
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
      (ComplexShape.up ℤ)) ℤ
  have _ := SheafOfModules.isGrothendieckAbelianU ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  have _ : (derivedPushforward.{u} f.toRingedToposSiteHom).IsTriangulated :=
    Stacks.Injectives.rightDerivedFunctor_isTriangulated
      f.toRingedToposSiteHom.pushforwardTopos
      (derivedPushforward.{u} f.toRingedToposSiteHom)
      (derivedPushforwardUnit f.toRingedToposSiteHom)
  rw [isIso_derivedCompletionPushforwardComparison_iff_bijective f I I' hI K]
  intro N hN
  obtain ⟨Cn, v, w, hT⟩ :=
    distinguished_cocone_triangle ((derivedCompletionUnit X I').app K)
  have hPC : ObjectProperty.leftOrthogonal (IsDerivedComplete.{u, u, u, u} Y I)
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj Cn) :=
    leftOrthogonal_isDerivedComplete_derivedPushforward f I I' habs
      (leftOrthogonal_isDerivedComplete_cone_derivedCompletionUnit X I' v w hT)
  have hPC' : ObjectProperty.leftOrthogonal (IsDerivedComplete.{u, u, u, u} Y I)
      (((derivedPushforward.{u} f.toRingedToposSiteHom).obj Cn)⟦(-1 : ℤ)⟧) :=
    ObjectProperty.le_shift _ (-1 : ℤ) _ hPC
  have hS := (derivedPushforward.{u} f.toRingedToposSiteHom).map_distinguished _ hT
  have key : ∀ φ : (derivedPushforward.{u} f.toRingedToposSiteHom).obj
        ((derivedCompletion X I').obj K) ⟶ N,
      (derivedPushforward.{u} f.toRingedToposSiteHom).map
          ((derivedCompletionUnit X I').app K) ≫ φ = 0 → φ = 0 := by
    intro φ hφ0
    obtain ⟨g, hg⟩ := Triangle.yoneda_exact₂ _ hS φ hφ0
    rw [hg, hPC g hN]
    exact comp_zero
  refine ⟨fun φ₁ φ₂ hφ ↦ sub_eq_zero.mp (key (φ₁ - φ₂) ?_), fun h ↦ ?_⟩
  · rw [Preadditive.comp_sub, sub_eq_zero]
    exact hφ
  · obtain ⟨g, hg⟩ := Triangle.yoneda_exact₂ _ (inv_rot_of_distTriang _ hS) h
      (hPC' _ hN)
    exact ⟨g, hg.symm⟩

end Pushforward

