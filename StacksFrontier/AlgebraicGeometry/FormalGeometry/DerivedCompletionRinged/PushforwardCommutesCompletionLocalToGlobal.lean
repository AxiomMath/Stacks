namespace AlgebraicGeometry.RingedSite

attribute [local instance 100000] HasDerivedCategory.standard
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

variable {X Y : RingedSite.{u, u, u}} (f : RingedSite.Hom X Y)

/-- **The invertibility of the comparison map of [Stacks, Tag 0A0G] depends only on the two
sheaves of ideals, not on how they are presented.** Equal sheaves of ideals give the same
comparison map: the relation of [Stacks, Tag 099J] between them and the existence of the two
derived completion functors are `Prop`s, so they contribute nothing beyond the ideals
themselves.

This is what lets the invertibility proved at a pair of ideal sheaves *generated by finitely many
global sections* be read at the restriction of a pair of ideal sheaves that happens to equal
it. -/
theorem isIso_derivedCompletionPushforwardComparison_congr
    {I₁ I₂ : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O)))}
    {I'₁ I'₂ : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (h : I₁ = I₂) (h' : I'₁ = I'₂)
    (hI₁ : PushforwardIdealCompatible f I₁ I'₁) (hI₂ : PushforwardIdealCompatible f I₂ I'₂)
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I₁)).IsRightAdjoint]
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I'₁)).IsRightAdjoint]
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I₂)).IsRightAdjoint]
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I'₂)).IsRightAdjoint]
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (hiso : IsIso ((derivedCompletionPushforwardComparison f I₂ I'₂ hI₂).app K)) :
    IsIso ((derivedCompletionPushforwardComparison f I₁ I'₁ hI₁).app K) := by
  subst h
  subst h'
  exact hiso

section Local

attribute [local instance] isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf

variable [HasSheafify X.J AddCommGrpCat.{u}] [HasWeakSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify Y.J AddCommGrpCat.{u}] [HasWeakSheafify Y.J AddCommGrpCat.{u}]
  [Y.J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasSheafify (Y.J.over V) AddCommGrpCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) AddCommGrpCat.{u}]
  [∀ V : Y.C, (Y.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}]
  [∀ (U : X.C) (K₁ K₂ : HomologicalComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (X.over U).O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂
      (Stacks.SheafOfModules.Tensor.sheafTensor (X.over U).O) (ComplexShape.up ℤ)]
  [∀ (V : Y.C) (K₁ K₂ : HomologicalComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (Y.over V).O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂
      (Stacks.SheafOfModules.Tensor.sheafTensor (Y.over V).O) (ComplexShape.up ℤ)]
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))
  [I.toSheafOfModules.IsFiniteType]

omit [HasSheafify X.J AddCommGrpCat.{u}] [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify Y.J AddCommGrpCat.{u}] [HasWeakSheafify Y.J AddCommGrpCat.{u}]
  [Y.J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasSheafify (Y.J.over V) AddCommGrpCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}] in
/-- **[Stacks, Tag 0A0G] for the localized morphism, at the source's own pair of sheaves of
ideals, over an object on which `ℐ` is generated by finitely many sections.** For `V` an object
of the target site on which `ℐ|_V = (t_1, …, t_r)`, the comparison map of the localized morphism
`f' : (Sh(𝒞/U), 𝒪_U) ⟶ (Sh(𝒟/V), 𝒪'_V)` of [Stacks, Tag 04J0] at the pair
`(ℐ|_V, (f^{-1}ℐ · 𝒪_X)|_U)` is invertible, for an arbitrary object of `D(𝒪')`.

Both sheaves of ideals of that pair are globally generated on the slice: the first by hypothesis,
and the second because
`AlgebraicGeometry.RingedSite.overIdeal_inverseImageIdealSheaf` identifies it with
`(f')^{-1}(ℐ|_V) · 𝒪_U` and
`AlgebraicGeometry.RingedSite.inverseImageIdealSheaf_generatedIdealSheaf` identifies *that* with
the ideal sheaf generated by the transported generators. So this is
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf`
at the localized morphism, read across those two identifications by
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_congr`.

The two terminal objects the globally generated statement asks for are free on a slice: `V` is
terminal in `𝒟/V` and its image is `u(V)`, terminal in `𝒞/u(V)`. -/
theorem isIso_derivedCompletionPushforwardComparison_localized_overIdeal (V : Y.C) {r : ℕ}
    (t : Fin r → Presheaf.globalSections ((Y.over V).O.obj ⋙ forget CommRingCat.{u}))
    (ht : overIdeal I V = generatedIdealSheaf t)
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    IsIso ((derivedCompletionPushforwardComparison (f.localized V) (overIdeal I V)
      (overIdeal (inverseImageIdealSheaf f I) (f.u.obj V))
      (pushforwardIdealCompatible_localized f V I (inverseImageIdealSheaf f I)
        (pushforwardIdealCompatible_inverseImageIdealSheaf f I))).app
      ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
        (f.u.obj V)).mapDerivedCategory.obj K)) := by
  have hT : IsTerminal (Over.mk (𝟙 V)) := Over.mkIdTerminal
  have hT' : IsTerminal ((f.localized V).u.obj (Over.mk (𝟙 V))) :=
    IsTerminal.ofIso (Y := Over.mk (𝟙 (f.u.obj V))) Over.mkIdTerminal
      (Over.isoMk (Iso.refl _) ((Category.id_comp _).trans (f.u.map_id V)))
  have ht' : overIdeal (inverseImageIdealSheaf f I) (f.u.obj V) =
      generatedIdealSheaf (pushGlobalSections (f.localized V) hT' t) :=
    (overIdeal_inverseImageIdealSheaf f I V).trans
      ((congrArg (fun J => inverseImageIdealSheaf (f.localized V) J) ht).trans
        (inverseImageIdealSheaf_generatedIdealSheaf (f.localized V) hT hT' t))
  exact isIso_derivedCompletionPushforwardComparison_congr (f.localized V) ht ht' _
    (pushforwardIdealCompatible_pushGlobalSections (f.localized V) hT hT' t) _
    (isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf (f.localized V) hT hT' t
      _)

omit [HasWeakSheafify X.J CommRingCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}] in
/-- **[Stacks, Tag 0A0G] at a sheaf of ideals of finite type, for an arbitrary object.** Let
`f : (Sh(𝒟), 𝒪') ⟶ (Sh(𝒞), 𝒪)` be a morphism of ringed sites, let `ℐ ⊂ 𝒪` be a sheaf of ideals
**of finite type** and let `ℐ' = f^{-1}ℐ · 𝒪_X` be the ideal sheaf Section 52.7 builds out of
`ℐ`. Then the canonical comparison map

`(Rf_*K)^∧ ⟶ Rf_*(K^∧)`

is invertible for **every** object `K` of `D(𝒪')`, the completion on the target being taken
along `ℐ` and the one on the source along `ℐ'`.

The proof is the source's own localization. `ℐ` of finite type is generated by finitely many
sections above a covering family `{V_i}` of the final object of the target site
(`exists_coversTop_eq_generatedIdealSheaf_of_isFiniteType`); on each `𝒟/V_i` the comparison map
of the localized morphism of [Stacks, Tag 04J0] at `(ℐ|_{V_i}, ℐ'|_{u(V_i)})` is invertible,
because both of those sheaves of ideals are globally generated there
(`isIso_derivedCompletionPushforwardComparison_localized_overIdeal`); the restriction coherence
`derivedCompletionPushforwardComparison_localized` identifies the restriction of the comparison
map of `f` with it up to three isomorphisms — the two comparison maps of [Stacks, Tag 0A0F],
invertible because `ℐ` and `ℐ'` are of finite type, and [Stacks, Tag 0D6G]; and invertibility in
the derived category of sheaves of modules is local on the site
(`Stacks.SheafOfModules.isIso_of_coversTop_mapDerivedCategory`).

Finite type of `ℐ'` is not a hypothesis: it is
`AlgebraicGeometry.RingedSite.isFiniteType_inverseImageIdealSheaf`, and it is what makes the
derived completion functor along `ℐ'` exist at all, by [Stacks, Tag 099F]. -/
@[stacks 0A0G "**the ringed-sites case**, in full for that case: the **canonical** comparison \
map, at the tag's own data and for an **arbitrary** object. The tag states a morphism of ringed \
*topoi*; this is the statement for a morphism of ringed *sites*. That is how the sibling \
[Stacks, Tag 099J] is handled in this directory — \
`AlgebraicGeometry.RingedSite.derivedPushforward_isDerivedComplete` is its full sites case and \
is deliberately untagged, the attribute sitting instead on the topos-level theorem reached by \
[Stacks, Tag 03CR] transport. The topos-level comparison map and its universal property are in \
`PushforwardCommutesCompletionTopoi.lean`, and the invertibility criterion in \
`PushforwardCommutesCompletionToposCriterion.lean`; what the transport still owes is a \
topos-level `f^♯(f^{-1}ℐ)·𝒪`, submodule transport along the dense-subsite replacement, and \
derived completion across that equivalence. Concretely here: for a morphism of ringed sites, a \
sheaf of ideals `ℐ ⊂ 𝒪` of \
finite type and `ℐ' = f^{-1}ℐ · 𝒪_X` the ideal sheaf Section 52.7 constructs out of `ℐ`, the \
canonical map `(Rf_*K)^∧ ⟶ Rf_*(K^∧)` is invertible for every `K` of `D(𝒪')`. Both derived \
completion functors come from [Stacks, Tag 099F] at a sheaf of ideals of finite type — `ℐ'` is \
of finite type because `ℐ` is, by \
`AlgebraicGeometry.RingedSite.isFiniteType_inverseImageIdealSheaf` — and the relation of \
[Stacks, Tag 099J] between the two sheaves of ideals is proved from the construction rather \
than assumed. The hypotheses are the source's: no object is excluded and no generating family \
is assumed global; the source's own reduction to the globally generated case by localization on \
the target site is the proof"]
theorem isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    IsIso ((derivedCompletionPushforwardComparison f I (inverseImageIdealSheaf f I)
      (pushforwardIdealCompatible_inverseImageIdealSheaf f I)).app K) := by
  obtain ⟨σ, V, hV, r, t, hft⟩ :=
    exists_coversTop_eq_generatedIdealSheaf_of_isFiniteType I inferInstance
  refine Stacks.SheafOfModules.isIso_of_coversTop_mapDerivedCategory hV _ fun i => ?_
  have hsq := derivedCompletionPushforwardComparison_localized f (V i) I
    (inverseImageIdealSheaf f I) (pushforwardIdealCompatible_inverseImageIdealSheaf f I) K
  have := isIso_derivedCompletionPushforwardComparison_localized_overIdeal f I (V i) (t i)
    (hft i) K
  have hA : IsIso ((derivedCompletionRestrictComparison Y I (V i) (overIdeal I (V i))
      (fun _ _ h => h)).app ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) :=
    isIso_derivedCompletionRestrictComparison_overIdeal_app Y I (V i) _
  have hB : IsIso ((derivedCompletionRestrictComparison X (inverseImageIdealSheaf f I)
      (f.u.obj (V i)) (overIdeal (inverseImageIdealSheaf f I) (f.u.obj (V i)))
      (fun _ _ h => h)).app K) :=
    isIso_derivedCompletionRestrictComparison_overIdeal_app X (inverseImageIdealSheaf f I)
      (f.u.obj (V i)) K
  have hS : IsIso ((derivedPushforwardOverIso f (V i)).hom.app
      ((derivedCompletion X (inverseImageIdealSheaf f I)).obj K)) := inferInstance
  have hS' : IsIso ((derivedPushforwardOverIso f (V i)).hom.app K) := inferInstance
  have ha : IsIso ((derivedCompletion (Y.over (V i)) (overIdeal I (V i))).map
      ((derivedPushforwardOverIso f (V i)).hom.app K)) :=
    ((derivedCompletion (Y.over (V i)) (overIdeal I (V i))).mapIso
      ((derivedPushforwardOverIso f (V i)).app K)).isIso_hom
  have hc : IsIso ((derivedPushforward.{u} (f.localized (V i)).toRingedToposSiteHom).map
      ((derivedCompletionRestrictComparison X (inverseImageIdealSheaf f I) (f.u.obj (V i))
        (overIdeal (inverseImageIdealSheaf f I) (f.u.obj (V i)))
        (fun _ _ h => h)).app K)) := Functor.map_isIso _ _
  have hR : IsIso
      ((derivedCompletion (Y.over (V i)) (overIdeal I (V i))).map
            ((derivedPushforwardOverIso f (V i)).hom.app K) ≫
          (derivedCompletionPushforwardComparison (f.localized (V i)) (overIdeal I (V i))
              (overIdeal (inverseImageIdealSheaf f I) (f.u.obj (V i)))
              (pushforwardIdealCompatible_localized f (V i) I (inverseImageIdealSheaf f I)
                (pushforwardIdealCompatible_inverseImageIdealSheaf f I))).app
            ((SheafOfModules.overFunctor.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
              (f.u.obj (V i))).mapDerivedCategory.obj K) ≫
        (derivedPushforward.{u} (f.localized (V i)).toRingedToposSiteHom).map
          ((derivedCompletionRestrictComparison X (inverseImageIdealSheaf f I) (f.u.obj (V i))
            (overIdeal (inverseImageIdealSheaf f I) (f.u.obj (V i)))
            (fun _ _ h => h)).app K)) := inferInstance
  have hL := Eq.subst (motive := fun z => IsIso z) hsq.symm hR
  exact (isIso_comp_right_iff _
      ((derivedPushforwardOverIso f (V i)).hom.app
        ((derivedCompletion X (inverseImageIdealSheaf f I)).obj K))).mp
    ((isIso_comp_left_iff
      ((derivedCompletionRestrictComparison Y I (V i) (overIdeal I (V i))
        (fun _ _ h => h)).app ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) _).mp hL)

end Local

