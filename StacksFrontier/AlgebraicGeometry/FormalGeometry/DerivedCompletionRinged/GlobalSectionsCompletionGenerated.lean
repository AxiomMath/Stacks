variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}] {r : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

omit [HasWeakSheafify X.J CommRingCat] in
/-- **The universal property of the derived completion reflector, in elementary form.** For `E`
derived complete along `ℐ`, precomposition with the completion map `K ⟶ K^∧` is a bijection from
the morphisms `K^∧ ⟶ E` to the morphisms `K ⟶ E`.

This is the hom-set bijection of the reflector adjunction of [Stacks, Tag 099F] with the
inclusion of the derived-complete objects evaluated away, using that the inclusion is fully
faithful. It is the shape in which the reflection is compared with another reflection, in
`exists_iso_derivedCompletion_completionFunctor_obj`. -/
theorem bijective_precomp_derivedCompletionUnit_app
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint]
    (L E : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (hE : IsDerivedComplete.{u, u, u, u} X I E) :
    Function.Bijective (fun g : (derivedCompletion X I).obj L ⟶ E ↦
      (derivedCompletionUnit X I).app L ≫ g) := by
  have ff := ObjectProperty.fullyFaithfulι (IsDerivedComplete.{u, u, u, u} X I)
  have h : Function.Bijective ((fun g : (derivedCompletion X I).obj L ⟶ E ↦
      (derivedCompletionUnit X I).app L ≫ g) ∘
      (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).map
        (X := (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).leftAdjoint.obj L)
        (Y := ⟨E, hE⟩)) := by
    convert ((derivedCompletionAdjunction X I).homEquiv L ⟨E, hE⟩).bijective using 1
    exact funext fun g ↦ ((derivedCompletionAdjunction X I).homEquiv_unit L _ g).symm
  exact (Function.Bijective.of_comp_iff _ (ff.map_bijective _ _)).1 h

attribute [local instance] isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf

/-- **At the sheaf of ideals generated by finitely many global sections, the derived completion
reflector is the Čech completion of [Stacks, Tag 099B]**, objectwise and *compatibly with the two
completion maps out of `K`*: there is an isomorphism `θ : K^∧ ≅ R𝑆heafHom_𝒪(Č(f), K)` with

`derivedCompletionUnit ≫ θ.hom = completionUnit`.

Both objects are derived complete — `isDerivedComplete_derivedCompletion_obj` and
`isDerivedComplete_generatedIdealSheaf_completionFunctor_obj` — and each of the two completion
maps out of `K` is a reflection of `K` into the derived-complete objects, by
`bijective_precomp_derivedCompletionUnit_app` and
`bijective_precomp_completionUnit_generatedIdealSheaf`. So each object receives a unique map
from the other compatible with the units, and both composites are the identity by injectivity.
Nothing is assumed: the reflector exists by
`isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`, which is a local instance here.

**The unit equation is part of the statement, and has to be.** An isomorphism of the two objects
on its own transports *properties* across — that is all
`isGE_derivedCompletion_generatedIdealSheaf_obj` below asks of it — but it identifies no map, so
it cannot carry a *pinned* derived-limit presentation from one model of the completion to the
other. A projection of such a presentation is pinned by its composite with the completion map
(`completionUnit_app_comp_koszulTopSingleProjection_eq` for the Čech model), and transporting
that pinning along `θ` is exactly the equation above. `Stacks.Algebraization`
`.exists_isDerivedLimitWithProjections_idealSmulQuotientTower_of_eq` of
`Completion/AdicQuotientSliceTowerKoszul.lean` is the consumer: it is where part (3) of
[Stacks, Tag 0A0K] crosses from the Čech model of the completion to the reflector. -/
theorem exists_iso_derivedCompletion_completionFunctor_obj
    (L : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    ∃ θ : (derivedCompletion X (generatedIdealSheaf f)).obj L ≅
        (completionFunctor X f).obj L,
      (derivedCompletionUnit X (generatedIdealSheaf f)).app L ≫ θ.hom =
        (completionUnit X f).app L := by
  obtain ⟨α, hα⟩ := (bijective_precomp_derivedCompletionUnit_app X (generatedIdealSheaf f) L _
    (isDerivedComplete_generatedIdealSheaf_completionFunctor_obj X f L)).2
      ((completionUnit X f).app L)
  obtain ⟨β, hβ⟩ := (bijective_precomp_completionUnit_generatedIdealSheaf X f L _
    (isDerivedComplete_derivedCompletion_obj X (generatedIdealSheaf f) L)).2
      ((derivedCompletionUnit X (generatedIdealSheaf f)).app L)
  have hα' : (derivedCompletionUnit X (generatedIdealSheaf f)).app L ≫ α =
    (completionUnit X f).app L := hα
  have hβ' : (completionUnit X f).app L ≫ β =
    (derivedCompletionUnit X (generatedIdealSheaf f)).app L := hβ
  refine ⟨⟨α, β, ?_, ?_⟩, hα'⟩
  · refine (bijective_precomp_derivedCompletionUnit_app X (generatedIdealSheaf f) L _
      (isDerivedComplete_derivedCompletion_obj X (generatedIdealSheaf f) L)).1 ?_
    simp [← Category.assoc, hα', hβ']
  · refine (bijective_precomp_completionUnit_generatedIdealSheaf X f L _
      (isDerivedComplete_generatedIdealSheaf_completionFunctor_obj X f L)).1 ?_
    simp [← Category.assoc, hα', hβ']

/-- **The extended alternating Čech complex is cohomologically bounded above by `r`.** Its terms
vanish above degree `r` (`isZero_extendedAlternatingCech_X_of_lt`), and the cohomology of a
complex in a degree where the complex itself vanishes is zero. -/
theorem isLE_derivedCategoryQ_extendedAlternatingCech :
    (DerivedCategory.Q.obj (extendedAlternatingCech X f)).IsLE (r : ℤ) := by
  rw [DerivedCategory.isLE_iff]
  intro i hi
  refine IsZero.of_iso ?_ ((DerivedCategory.homologyFunctorFactors
    (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) i).app
      (extendedAlternatingCech X f))
  exact ShortComplex.isZero_homology_of_isZero_X₂ _
    (isZero_extendedAlternatingCech_X_of_lt X f hi)

/-- **The derived completion along `ℐ = (f_1, …, f_r)` of a cohomologically bounded below object
is cohomologically bounded below**, by `b - r` when the object is bounded below by `b`.

By `exists_iso_derivedCompletion_completionFunctor_obj` the completion is
`R𝑆heafHom_𝒪(Č(f), L)`; `Č(f)` is cohomologically `≤ r` by
`isLE_derivedCategoryQ_extendedAlternatingCech`; and `isGE_derivedSheafHom` bounds the derived
internal Hom of a cohomologically `≤ d` object into a cohomologically `≥ b` one below by
`b - d`. -/
theorem isGE_derivedCompletion_generatedIdealSheaf_obj
    (L : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (b : ℤ) (hL : L.IsGE b) :
    ((derivedCompletion X (generatedIdealSheaf f)).obj L).IsGE (b - r) := by
  have h : ((completionFunctor X f).obj L).IsGE (b - r) :=
    isGE_derivedSheafHom X (DerivedCategory.Q.obj (extendedAlternatingCech X f)) L
      (r : ℤ) b (isLE_derivedCategoryQ_extendedAlternatingCech X f) hL
  obtain ⟨e, -⟩ := exists_iso_derivedCompletion_completionFunctor_obj X f L
  exact DerivedCategory.TStructure.t.isGE_of_iso e.symm (b - r)

/-- **The derived completion of a sheaf along `ℐ = (f_1, …, f_r)` has a bounded below
representative.** This is the second of the two inputs that
`AlgebraicGeometry.RingedSite.exists_pages_derivedCompletion_globalSections` assumes, proved: a
bounded below cochain complex `K` together with an isomorphism `Q(K) ≅ ℱ^∧`.

`ℱ` in degree zero is cohomologically `≥ 0`, so `ℱ^∧` is cohomologically `≥ -r` by
`isGE_derivedCompletion_generatedIdealSheaf_obj`, and a cohomologically bounded below object of
`D(𝒪)` is the image of a complex concentrated in degrees `≥ -r` by
`DerivedCategory.exists_iso_Q_obj_of_isGE`. -/
theorem exists_plus_derivedCompletion_generatedIdealSheaf_obj
    (F : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    ∃ (K : CochainComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) ℤ)
      (_ : CochainComplex.plus
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) K),
      Nonempty (DerivedCategory.Q.obj K ≅ (derivedCompletion X (generatedIdealSheaf f)).obj
        ((DerivedCategory.singleFunctor
          (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) 0).obj F)) := by
  have := isGE_derivedCompletion_generatedIdealSheaf_obj X f
    ((DerivedCategory.singleFunctor
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) 0).obj F) 0
    inferInstance
  obtain ⟨K, hK, ⟨e⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isGE
    ((derivedCompletion X (generatedIdealSheaf f)).obj
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) 0).obj F)) (0 - r)
  exact ⟨K, ⟨0 - r, hK⟩, ⟨e.symm⟩⟩

/-- **[Stacks, Tag 0BLX], the second spectral sequence, at a sheaf of ideals generated by
finitely many global sections, with nothing assumed.** Let `A` be a ring, `I ⊂ A` a finitely
generated ideal, `(𝒞, 𝒪)` a ringed site with `𝒪` a sheaf of `A`-algebras, `f_1, …, f_r` global
sections of `𝒪` whose generated ideal sheaf `ℐ = (f_1, …, f_r)` is the ideal sheaf `I𝒪`, and `ℱ`
a sheaf of `𝒪`-modules. Write `ℱ^∧` for the derived completion of `ℱ` along `I𝒪`. Then `ℱ^∧`
has a bounded below representative `K`, and for every Cartan-Eilenberg resolution of `K` the
second spectral sequence of [Stacks, Tag 015J] for `Γ(𝒞, -)` has
```
E₂^{p,q} = H^p(𝒞, H^q(ℱ^∧))
```
and abuts to `H^{p+q}(RΓ(𝒞, ℱ^∧))`.

This is `exists_pages_derivedCompletion_globalSections` of `GlobalSectionsCompletion.lean` with
**both** of its assumed inputs discharged, and that is the whole difference between the two:

* [Stacks, Tag 099F], which that theorem carries as the instance argument
  `[(ObjectProperty.ι (IsDerivedComplete X 𝓘)).IsRightAdjoint]`, is here proved from the
  generators by `isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`, a local instance of
