module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.LocalizationCompletion

/-!
# The restricted generators generate the restricted ideal sheaf

Let `(𝒞, 𝒪)` be a ringed site, let `f_1, …, f_r` be global sections of `𝒪` and let `U` be an
object of `𝒞`. There are two sheaves of ideals on the localized ringed site `(𝒞/U, 𝒪_U)` built
from `ℐ = (f_1, …, f_r)`:

* the restriction `ℐ|_U`, `AlgebraicGeometry.RingedSite.overIdeal`, whose sections over `V/U` are
  the sections of `ℐ` over `V`; and
* the sheaf of ideals `(f_1|_U, …, f_r|_U)` generated *on the slice* by the restrictions of the
  generators.

This file proves that they are equal.

## Main results

* `AlgebraicGeometry.RingedSite.le_idealOfGlobalSections_over`: a section of `ℐ` over `V` is a
  section of `(f_1|_U, …, f_r|_U)` over `V/U`.
* `AlgebraicGeometry.RingedSite.overIdeal_idealOfGlobalSections`: the two sheaves of ideals on
  the slice agree, `ℐ|_U = (f_1|_U, …, f_r|_U)`.

## References

* [Stacks Project, Tag 099B](https://stacks.math.columbia.edu/tag/099B)
* [Stacks Project, Tag 099E](https://stacks.math.columbia.edu/tag/099E)
* [Stacks Project, Tag 099F](https://stacks.math.columbia.edu/tag/099F)
* [Stacks Project, Tag 0A0F](https://stacks.math.columbia.edu/tag/0A0F)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u}) (U : X.C) {r : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- A section of `ℐ = (f_1, …, f_r)` over `V` is a section over `V/U` of the ideal sheaf generated
on the slice by the restricted generators: `ℐ|_U ≤ (f_1|_U, …, f_r|_U)`. -/
theorem le_idealOfGlobalSections_over :
    overIdeal (idealOfGlobalSections X f) U ≤
      idealOfGlobalSections (X.over U) (fun i => globalSectionOver X U (f i)) := by
  intro W x hx
  obtain ⟨S, hS, hSmem⟩ := (mem_idealOfGlobalSections_iff X f (op W.unop.left)).1 hx
  refine (mem_idealOfGlobalSections_iff (X.over U)
    (fun i => globalSectionOver X U (f i)) W).2
    ⟨(Sieve.overEquiv W.unop).symm S,
      (X.J.mem_over_iff _).2 (by rwa [OrderIso.apply_symm_apply]), fun Z h hh => ?_⟩
  have hrange : Set.range (restrictGlobalSections (X.over U)
      (fun i => globalSectionOver X U (f i)) (op Z)) =
      Set.range (restrictGlobalSections X f (op Z.left)) :=
    congrArg Set.range (funext fun i => globalSectionVal_globalSectionOver X U (f i) (op Z))
  exact hrange ▸ hSmem h.left ((Sieve.overEquiv_symm_iff S h).1 hh)

/-- For `ℐ` the sheaf of ideals generated by finitely many global sections `f_1, …, f_r` of `𝒪`,
the restriction `ℐ|_U` of `ℐ` to the localized ringed site `(𝒞/U, 𝒪_U)` is the sheaf of ideals
generated there by the restrictions `f_1|_U, …, f_r|_U`. -/
theorem overIdeal_idealOfGlobalSections :
    overIdeal (idealOfGlobalSections X f) U =
      idealOfGlobalSections (X.over U) (fun i => globalSectionOver X U (f i)) :=
  le_antisymm (le_idealOfGlobalSections_over X U f) (idealOfGlobalSections_over_le X U f)

end AlgebraicGeometry.RingedSite

end
