include hg in
/-- **`Rf_*` carries the Koszul Hom tower of the source to the Koszul Hom tower of the target.**
For `K ∈ D(𝒪')` arbitrary, the isomorphism of towers `ℕᵒᵖ ⥤ D(𝒪)`

`n ↦ Rf_* R𝓗om_{𝒪'}(K(𝒪', g_1^{n+1}, …, g_r^{n+1}), K)` ≅
`n ↦ R𝓗om_𝒪(K(𝒪, t_1^{n+1}, …, t_r^{n+1}), Rf_*K)`.

This is step 3 of the source's proof of [Stacks, Tag 0A0G], and it replaces that proof's appeal
to the projection formula [Stacks, Tag 0944]. Two inputs, both for arbitrary objects:

* `Stacks.Cohomology.DerivedInternalHomPushforward.derivedPushforwardSheafHomIsoOfObj`, the
  adjoint formula `Rf_* R𝓗om_{𝒪'}(Lf^*A, M) ≅ R𝓗om_𝒪(A, Rf_*M)` at a fixed `M`, read as an
  isomorphism of functors of `A` — so the naturality in `A` that an isomorphism of towers needs
  is part of it;
* `AlgebraicGeometry.RingedSite.derivedPullbackKoszulPowerSystemIso`, the identification
  `Lf^*K(𝒪, t^{n+1}) ≅ K(𝒪', g^{n+1})` of the pulled-back Koszul towers, which is the source's
  other input at this step.

The first is whiskered with the Koszul tower of the target and the second is pushed through
`R𝓗om_{𝒪'}(-, K) ⋙ Rf_*`. -/
def derivedPushforwardKoszulSheafHomSystemIso
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    derivedSheafHomSystem X (koszulPowerSystem X g ⋙ DerivedCategory.Q) K ⋙
        derivedPushforward.{u} f.toRingedToposSiteHom ≅
      derivedSheafHomSystem Y (koszulPowerSystem Y t ⋙ DerivedCategory.Q)
        ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K) :=
  Functor.isoWhiskerRight (NatIso.op (derivedPullbackKoszulPowerSystemIso f t g hg))
      ((derivedSheafHomBifunctor X).flip.obj K ⋙
        derivedPushforward.{u} f.toRingedToposSiteHom) ≪≫
    Functor.isoWhiskerLeft (koszulPowerSystem Y t ⋙ DerivedCategory.Q).op
      (Stacks.Cohomology.DerivedInternalHomPushforward.derivedPushforwardSheafHomIsoOfObj
        f.toRingedToposSiteHom f.isMorphismOfSites K)

include hg in
/-- **[Stacks, Tags 0A0G and 0A0I] for an arbitrary object, at two sheaves of ideals generated by
finitely many global sections.** Let `f : (Sh(𝒟), 𝒪') ⟶ (Sh(𝒞), 𝒪)` be a morphism of ringed
sites, let `t_1, …, t_r` be global sections
of `𝒪` generating `ℐ ⊂ 𝒪`, let `g_1, …, g_r` be global sections of `𝒪'` with `g_i = f^♯(t_i)`
generating `ℐ' ⊂ 𝒪'`, and let `K ∈ D(𝒪')` be **arbitrary**. Then

`Rf_*(K^∧) ≅ (Rf_*K)^∧`:

`Rf_*` commutes with derived completion. Both derived completion functors are the reflector of
[Stacks, Tag 099F], produced from the generators by
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`, so no
part of that tag is an input here.

The proof is the source's own. `K^∧` is the derived limit of the Koszul Hom tower
`n ↦ R𝓗om_{𝒪'}(K(𝒪', g^{n+1}), K)` by
`isDerivedLimit_derivedSheafHomSystem_derivedCompletion` ([Stacks, Tag 0A0E]); `Rf_*` carries
that derived limit to one of the pushed-forward tower by
`Stacks.Cohomology.DerivedPushforwardOnRingedTopoi.isDerivedLimit_map_derivedPushforward`
([Stacks, Tag 0A07]); `derivedPushforwardKoszulSheafHomSystemIso` identifies the pushed-forward
tower with `n ↦ R𝓗om_𝒪(K(𝒪, t^{n+1}), Rf_*K)`, whose derived limit is `(Rf_*K)^∧` by the same
presentation on the target; and two derived limits of isomorphic towers are isomorphic, by
`Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_natIso` ([Stacks, Tag 0H9L]).

The conclusion is the display as the source writes it, an isomorphism of the two objects, rather
than invertibility of the canonical comparison map
`AlgebraicGeometry.RingedSite.derivedCompletionPushforwardComparison`: the uniqueness of derived
limits produces a non-canonical isomorphism. The source's `ℐ` is of finite type, hence only
locally generated by finitely many sections; [Stacks, Tag 099F] at such an `ℐ` rests on
[Stacks, Tags 099D and 099E]. -/
@[stacks 0A0G "`Rf_*` commutes with derived completion, `Rf_*(K^∧) = (Rf_*K)^∧`, for an \
**arbitrary** object `K` of `D(𝒪')`, at **any** morphism of ringed sites and at \
`ℐ = (t_1, …, t_r) ⊂ 𝒪` and `ℐ' = (f^♯t_1, …, f^♯t_r) ⊂ 𝒪'` \
generated by finitely many global sections of the two structure sheaves — the regime the \
source's own proof reduces to, and the regime in which [Stacks, Tag 099F] is available here, so \
that both derived completion functors are built from those generators and no part of that tag \
is an input. The argument is the source's: the two completions are the derived limits of the \
Koszul Hom towers ([Stacks, Tag 0A0E]), `Rf_*` exchanges with `R lim` ([Stacks, Tag 0A07]), and \
the two towers are identified by `Rf_* R𝓗om_{𝒪'}(Lf^*A, M) ≅ R𝓗om_𝒪(A, Rf_*M)` naturally in \
both variables together with `Lf^*K(𝒪, t^n) ≅ K(𝒪', g^n)`. Restrictions on the data only: the \
object is arbitrary"]
theorem nonempty_iso_derivedPushforward_derivedCompletion_generatedIdealSheaf
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    [HasCoproduct ((koszulPowerSystem X g ⋙ DerivedCategory.Q).obj)]
    [HasCoproduct ((koszulPowerSystem Y t ⋙ DerivedCategory.Q).obj)] :
    Nonempty ((derivedPushforward.{u} f.toRingedToposSiteHom).obj
        ((derivedCompletion X (generatedIdealSheaf g)).obj K) ≅
      (derivedCompletion Y (generatedIdealSheaf t)).obj
        ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) := by
  have : HasProductsOfShape ℕ
      (DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :=
    hasProductsOfShape_nat_derivedCategory_ringSheaf.{u, u, u} X
  have : HasProductsOfShape ℕ
      (DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))) :=
    hasProductsOfShape_nat_derivedCategory_ringSheaf.{u, u, u} Y
  -- [Stacks, Tag 0A0E] on the source, in the Hom tower: `K^∧ = R lim R𝓗om(K(𝒪', g^n), K)`.
  have hsource := isDerivedLimit_derivedSheafHomSystem_derivedCompletion X g K
  -- The same on the target, at `Rf_*K`.
  have htarget := isDerivedLimit_derivedSheafHomSystem_derivedCompletion Y t
    ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)
  -- [Stacks, Tag 0A07]: `Rf_*` carries the source's derived limit to a derived limit.
  obtain ⟨hprod, hlim⟩ :=
    Stacks.Cohomology.DerivedPushforwardOnRingedTopoi.isDerivedLimit_map_derivedPushforward
      f.toRingedToposSiteHom f.isMorphismOfSites _ _ hsource
  have hprod' : HasProduct fun n : ℕ ↦ (derivedSheafHomSystem X
      (koszulPowerSystem X g ⋙ DerivedCategory.Q) K ⋙
        derivedPushforward.{u} f.toRingedToposSiteHom).obj (op n) := hprod
  -- [Stacks, Tag 0H9L] at the identification of the two towers.
  exact Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_natIso hlim htarget
    (derivedPushforwardKoszulSheafHomSystemIso f t g hg K)

end HomTower

