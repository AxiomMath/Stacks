-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.Cohomology.DerivedPullbackPushforwardAdjunction

universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

section Transport

variable {X Y : RingedSite.{u, u, u}} (f : RingedSite.Hom X Y)

/-- **`f^♯` commutes with restriction.** The structure map of a morphism of ringed sites is a map
of sheaves of rings `𝒪 ⟶ f_*𝒪'`, so this is its naturality, written on sections. -/
theorem fSharpSection_map {V W : Y.C} (g : V ⟶ W) (s : Y.O.obj.obj (op W)) :
    fSharpSection f V ((Y.O.obj.map g.op).hom s) =
      (X.O.obj.map (f.u.map g).op).hom (fSharpSection f W s) := by
  have h := congrArg (fun k ↦ (ConcreteCategory.hom k) s)
    (f.toRingedToposSiteHom.fSharpRing.hom.naturality g.op)
  simp only at h
  exact h

variable (I' : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
  {s : ℕ} (t : Fin s → Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u}))

/-- **The relation of [Stacks, Tag 099J] at a sheaf of ideals generated by global sections is
decided by the generators.** If `f^♯` carries the value of each `t_i` over each object of the
target site into `ℐ'`, then it carries every section of `ℐ = (t_1, …, t_s)` into `ℐ'`.

Membership in `ℐ` is local, so this is not a formal consequence of the generators' case: a
section of `ℐ` over `W` becomes an `𝒪`-linear combination of the `t_i` only along the arrows of
some covering sieve of `W`. That sieve is pushed forward to a covering sieve of `f.u W`, which
is covering because `f.u` is continuous, and `ℐ'` is a sheaf of ideals. -/
theorem pushforwardIdealCompatible_generatedIdealSheaf
    (h : ∀ (i : Fin s) (W : Y.C),
      fSharpSection f W (globalSectionVal (t i) (op W)) ∈
        I'.toSubmodule.obj (op (f.u.obj W))) :
    PushforwardIdealCompatible f (generatedIdealSheaf t) I' := by
  intro W x hx
  obtain ⟨S, hS, hc⟩ := exists_sieve_of_mem_generatedIdealSheaf t hx
  refine I'.isSheaf (X := op (f.u.obj W)) (fSharpSection f W x)
    (X.J.superset_covering ?_
      ((CoverPreserving.of_isContinuous f.u Y.J X.J).cover_preserve hS))
  rintro Z _ ⟨V, p, q, hp, rfl⟩
  obtain ⟨c₀, hcv⟩ := hc p hp
  -- the coefficients and the values of the generators, read in the sheaf of rings in which the
  -- sheaves of ideals live
  let c : Fin s → (Stacks.SheafOfModules.Tensor.ringSheaf Y.O).obj.obj (op V) := fun i ↦ c₀ i
  let g : Fin s → (Stacks.SheafOfModules.Tensor.ringSheaf Y.O).obj.obj (op V) :=
    fun i ↦ globalSectionVal (t i) (op V)
  have hcv' : (Stacks.SheafOfModules.Tensor.ringSheaf Y.O).obj.map p.op x = ∑ i, c i * g i :=
    hcv.symm
  have hnat : (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj.map (f.u.map p).op
      (fSharpSection f W x) =
      fSharpSection f V ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O).obj.map p.op x) :=
    (fSharpSection_map f p x).symm
  have hsum : (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj.map (f.u.map p).op
      (fSharpSection f W x) =
      ∑ i, fSharpSection f V (c i) * fSharpSection f V (g i) := by
    rw [hnat, hcv']
    exact (map_sum _ _ _).trans (Finset.sum_congr rfl fun i _ ↦ map_mul _ (c i) (g i))
  have hmem : ∑ i, fSharpSection f V (c i) * fSharpSection f V (g i) ∈
      I'.toSubmodule.obj (op (f.u.obj V)) :=
    Submodule.sum_mem _ fun i _ ↦
      (I'.toSubmodule.obj (op (f.u.obj V))).smul_mem _ (h i V)
  exact Sieve.downward_closed _
    (Eq.subst (motive := fun y ↦ y ∈ I'.toSubmodule.obj (op (f.u.obj V))) hsum.symm hmem) q

end Transport

section Terminal

variable {X Y : RingedSite.{u, u, u}} (f : RingedSite.Hom X Y) {T : Y.C}
  (hT : IsTerminal T) (hT' : IsTerminal (f.u.obj T))

/-- **The transport of a global section of `𝒪` along `f`**, available when the target site has a
terminal object `T` whose image is terminal in the source site: a global section of `𝒪` is its
value over `T`, `f^♯` carries that to a section of `𝒪'` over `f.u T`, and a section over a
terminal object is a global section. -/
def pushGlobalSection (t : Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u})) :
    Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}) :=
  globalSectionOfTerminalSection hT' (fSharpSection f T (globalSectionVal t (op T)))

/-- The transported section over `U` is the restriction of `f^♯(t|_T)` from `f.u T`. -/
private theorem globalSectionVal_pushGlobalSection_eq
    (t : Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u})) (U : (X.C)ᵒᵖ) :
    globalSectionVal (pushGlobalSection f hT' t) U =
      (X.O.obj.map (hT'.from U.unop).op).hom (fSharpSection f T (globalSectionVal t (op T))) :=
  globalSectionVal_globalSectionOfTerminalSection hT' _ U

include hT in
/-- **The transport is `f^♯` over every object of the target site.** The value of
`pushGlobalSection f hT' t` over `f.u W` is `f^♯` of the value of `t` over `W`: both are the
restriction of `f^♯(t|_T)` along the unique arrow `f.u W ⟶ f.u T`, the right hand side by
naturality of `f^♯` and the left hand side by terminality of `f.u T`. -/
theorem globalSectionVal_pushGlobalSection
    (t : Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u})) (W : Y.C) :
    globalSectionVal (pushGlobalSection f hT' t) (op (f.u.obj W)) =
      fSharpSection f W (globalSectionVal t (op W)) := by
  have h2 : hT'.from (op (f.u.obj W)).unop = f.u.map (hT.from W) := hT'.hom_ext _ _
  rw [globalSectionVal_pushGlobalSection_eq, h2,
    ← fSharpSection_map f (hT.from W) (globalSectionVal t (op T)),
    globalSectionVal_map t (hT.from W).op]

variable {s : ℕ} (t : Fin s → Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u}))

/-- The transport of a finite family of global sections of `𝒪`: the generators of
`f^{-1}ℐ · 𝒪_X` for `ℐ = (t_1, …, t_s)`. -/
def pushGlobalSections :
    Fin s → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}) :=
  fun i ↦ pushGlobalSection f hT' (t i)

include hT in
/-- **`f^♯` carries `f^{-1}ℐ` into the ideal sheaf generated by the transported generators.**
This is the relation of [Stacks, Tag 099J] between `ℐ = (t_1, …, t_s)` and
`ℐ' = (f^♯t_1, …, f^♯t_s)`, proved from `f` and `t`. -/
theorem pushforwardIdealCompatible_pushGlobalSections :
    PushforwardIdealCompatible f (generatedIdealSheaf t)
      (generatedIdealSheaf (pushGlobalSections f hT' t)) :=
  pushforwardIdealCompatible_generatedIdealSheaf f _ t fun i W ↦ by
    rw [← globalSectionVal_pushGlobalSection f hT hT' (t i) W]
    exact globalSectionVal_mem_generatedIdealSheaf (pushGlobalSections f hT' t) i
      (op (f.u.obj W))

/-- **The ideal sheaf generated by the transported generators is the least one receiving
`f^♯(f^{-1}ℐ)`.** Every sheaf of ideals of `𝒪'` into which `f^♯` carries the sections of
`ℐ = (t_1, …, t_s)` contains it.

The transported generators live, by construction, over the terminal object `f.u T`, which is in
the image of `f.u`; so each of them is a section of such a sheaf of ideals there, and its value
over an arbitrary object is a restriction of that. -/
theorem generatedIdealSheaf_pushGlobalSections_le
    {𝓚 : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (h𝓚 : PushforwardIdealCompatible f (generatedIdealSheaf t) 𝓚) :
    generatedIdealSheaf (pushGlobalSections f hT' t) ≤ 𝓚 := by
  refine generatedIdealSheaf_le _ fun i U ↦ ?_
  rw [pushGlobalSections, globalSectionVal_pushGlobalSection_eq]
  exact 𝓚.toSubmodule.map_mem (hT'.from U.unop).op
    (h𝓚 T _ (globalSectionVal_mem_generatedIdealSheaf t i (op T)))

include hT in
/-- **The ideal sheaf generated by the transported generators is `f^{-1}ℐ · 𝒪_X`.** Any sheaf of
ideals of `𝒪'` that receives `f^♯(f^{-1}ℐ)` and is least among those that do — which is the
defining property of the `f^{-1}ℐ · 𝒪_X` of Section 52.7 — is this one. -/
theorem eq_generatedIdealSheaf_pushGlobalSections
    {𝓙 : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))}
    (hmem : PushforwardIdealCompatible f (generatedIdealSheaf t) 𝓙)
    (hle : ∀ 𝓚 : SheafOfModules.Submodule
        (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      PushforwardIdealCompatible f (generatedIdealSheaf t) 𝓚 → 𝓙 ≤ 𝓚) :
    𝓙 = generatedIdealSheaf (pushGlobalSections f hT' t) :=
  le_antisymm (hle _ (pushforwardIdealCompatible_pushGlobalSections f hT hT' t))
    (generatedIdealSheaf_pushGlobalSections_le f hT' t hmem)

end Terminal

section Site

attribute [local instance] isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf

variable {X Y : RingedSite.{u, u, u}} [HasWeakSheafify X.J CommRingCat.{u}]
  [HasWeakSheafify Y.J CommRingCat.{u}] (f : RingedSite.Hom X Y) {T : Y.C}
  (hT : IsTerminal T) (hT' : IsTerminal (f.u.obj T)) {s : ℕ}
  (t : Fin s → Presheaf.globalSections (Y.O.obj ⋙ forget CommRingCat.{u}))

omit [HasWeakSheafify Y.J CommRingCat.{u}] in
include hT in
/-- **[Stacks, Tag 0A0I], the left hand side of the display, at the source's own ideal sheaves.**
`Rf_*(K^∧)` is derived complete along `ℐ = (t_1, …, t_s)`, for an arbitrary `K ∈ D(𝒪')`, the
completion on the source being taken along `ℐ' = f^{-1}ℐ · 𝒪_X`.

This is `RingedSite.isDerivedComplete_derivedPushforward_derivedCompletion_generatedIdealSheaf` at
the ideal sheaf the source builds: the generators of `ℐ'` are `f^♯t_1, …, f^♯t_s`, and the relation
between the two sheaves of ideals that the general statement takes in is here proved, by
`pushforwardIdealCompatible_pushGlobalSections`. So the statement depends on `f`, on the two
terminal objects and on `t`, and on nothing else. -/
@[stacks 0A0I "the left hand side `Rf_*(ℱ^∧)` of Equation 52.7.0.1 is derived complete along \
`ℐ`, for an **arbitrary** object, at a morphism of ringed sites sending a terminal object of \
the target site to a terminal object of the source site, for `ℐ` generated by finitely many \
global sections of `𝒪` and the completion on the source taken along the ideal sheaf \
`f^{-1}ℐ · 𝒪_X` that Section 52.7 builds out of `ℐ` — identified as that ideal sheaf by \
`AlgebraicGeometry.RingedSite.eq_generatedIdealSheaf_pushGlobalSections`, and built here from \
`f` and the generators of `ℐ`. The derived completion functor is produced from those same \
generators, by \
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`, so no \
