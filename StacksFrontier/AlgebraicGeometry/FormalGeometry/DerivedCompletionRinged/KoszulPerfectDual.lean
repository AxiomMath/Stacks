namespace AlgebraicGeometry.RingedSite

attribute [local instance] HasDerivedCategory.standard hasFiniteBiproducts_sheafOfModules

/-! ## The Koszul complex is strictly perfect

It is bounded, `AlgebraicGeometry.RingedSite.finite_support_koszulPowerComplex`, and each of its
terms is a direct summand of a finite free module,
`AlgebraicGeometry.RingedSite.isFiniteFreeSummand_koszulPowerComplex_X`.
-/

/-! ## The interchange morphism at a Koszul complex, and the right unit constraint -/

section Interchange

variable (X : RingedSite.{u, u, u})
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u,
    u} X.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor X.O)
      (ComplexShape.up ℤ)]

/-- **The right unit constraint of the canonical derived tensor product**, `K ⊗^𝐋_𝒪 𝒪 ≅ K`:
the unit law `Stacks.SheafOfModules.DerivedTensorProduct.unitIso` of the derived tensor product,
read at the `AlgebraicGeometry.RingedSite.derivedStructureSheaf` spelling of the structure sheaf
in degree zero that the internal-Hom cluster uses.

This is a spelling abbreviation and not a construction: the two spellings of the unit object are
equal by `AlgebraicGeometry.RingedSite.derivedStructureSheaf_eq_singleFunctor_obj`. Pointing it
at the unit law is what makes the whole apparatus of
`StacksFrontier.CategoryTheory.Sites.Cohomology.DerivedTensor.UnitLawNaturality` available here —
the value at the image of a complex (`unitIso_hom_q`), the `toTensor` form
(`unitIso_inv_comp_toTensor`) and the naturality in the tensor factor
(`unitIso_hom_naturality`) — and it is the same unit law that the derived reduction
`AlgebraicGeometry.RingedSite.adicQuotientReduction` of [Stacks, Tag 0CQH] is written against,
so the two can be composed. -/
def derivedTensorRightUnitIso
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).obj
      (derivedStructureSheaf X) ≅ K :=
  (Stacks.SheafOfModules.canonicalDerivedTensorProduct X).unitIso K

/-- The right unit constraint is the unit law of the derived tensor product, by definition. -/
theorem derivedTensorRightUnitIso_eq_unitIso
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    derivedTensorRightUnitIso X K =
      (Stacks.SheafOfModules.canonicalDerivedTensorProduct X).unitIso K :=
  rfl

/-- **The right unit constraint at the image of a complex, on the nose**: the right K-flat
comparison of [Stacks, Tag 06YU] against the K-flat complex `𝒪[0]`, followed by `Q` of the unit
law on complexes. This is
`Stacks.SheafOfModules.DerivedTensorProduct.unitIso_hom_q`. -/
theorem derivedTensorRightUnitIso_hom_q
    (A : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) :
    (derivedTensorRightUnitIso X (DerivedCategory.Q.obj A)).hom =
      ((Stacks.SheafOfModules.canonicalDerivedTensorProduct X).comparisonRight A
          (structureSheafComplex X)
          (Stacks.SheafOfModules.isKFlat_single_unit X.O)).hom ≫
        DerivedCategory.Q.map
          (Stacks.SheafOfModules.tensorComplexUnitIsoFreeSections X.O A).hom :=
  (Stacks.SheafOfModules.canonicalDerivedTensorProduct X).unitIso_hom_q X A

/-- **The right unit constraint composed with a morphism in the tensor slot.** This is
`Stacks.SheafOfModules.DerivedTensorProduct.unitIso_hom_naturality`, stated at the spelling of
this file. -/
theorem derivedTensorRightUnitIso_hom_naturality
    {K K' : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (a : K ⟶ K') :
    ((Stacks.SheafOfModules.derivedTensorProductFunctor X).map a).app
          (derivedStructureSheaf X) ≫ (derivedTensorRightUnitIso X K').hom =
      (derivedTensorRightUnitIso X K).hom ≫ a :=
  (Stacks.SheafOfModules.canonicalDerivedTensorProduct X).unitIso_hom_naturality X a

/-- **The inverse right unit constraint composed with a morphism into the tensor slot.** This is
`Stacks.SheafOfModules.DerivedTensorProduct.unitIso_inv_naturality`, stated at the spelling of
this file. -/
theorem derivedTensorRightUnitIso_inv_naturality
    {K K' : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (a : K ⟶ K') :
    a ≫ (derivedTensorRightUnitIso X K').inv =
      (derivedTensorRightUnitIso X K).inv ≫
        ((Stacks.SheafOfModules.derivedTensorProductFunctor X).map a).app
          (derivedStructureSheaf X) :=
  (Stacks.SheafOfModules.canonicalDerivedTensorProduct X).unitIso_inv_naturality X a

variable {r : ℕ} [HasWeakSheafify X.J CommRingCat.{u}]
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

omit [HasWeakSheafify X.J CommRingCat.{u}] in
/-- **The interchange morphism of [Stacks, Tag 0BYU] is invertible at a Koszul complex.** The
Koszul complex is strictly perfect, so this is
`AlgebraicGeometry.RingedSite.isIso_derivedTensorHomInterchange_of_isFiniteFreeSummand`. -/
theorem isIso_derivedTensorHomInterchange_koszulPowerComplex
    [HasWeakSheafify X.J AddCommGrpCat.{u}]
    (K L : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (n : ℕ) :
    IsIso (derivedTensorHomInterchange X K L
      (DerivedCategory.Q.obj (koszulPowerComplex X f n))) :=
  isIso_derivedTensorHomInterchange_of_isFiniteFreeSummand X K L (koszulPowerComplex X f n)
    (finite_support_koszulPowerComplex X f n)
    (isFiniteFreeSummand_koszulPowerComplex_X X f n)

end Interchange

/-! ## The two towers are isomorphic, and the formula of Tag 0A0E -/

section Formula

variable (X : RingedSite.{u, u, u})
  [HasSheafify X.J AddCommGrpCat.{u}]
  [HasWeakSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u,
    u} X.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor X.O)
      (ComplexShape.up ℤ)]

/-- The comparison `K ⊗^𝐋_𝒪 M^∨ ⟶ R𝑆heafHom_𝒪(M, K)` used below: the interchange morphism of
[Stacks, Tag 0BYU] with its internal-Hom target at the structure sheaf, followed by the right
unit constraint read inside the internal Hom.

This is **not** the canonical map of [Stacks, Tag 08JD]; see the implementation notes of this
file. It has the same source and target, and that is all the formula of [Stacks, Tag 0A0E]
needs. -/
def interchangeDualComparison
    (K M : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).obj
        (((derivedSheafHomBifunctor X).obj (op M)).obj (derivedStructureSheaf X)) ⟶
      ((derivedSheafHomBifunctor X).obj (op M)).obj K :=
  derivedTensorHomInterchange X K (derivedStructureSheaf X) M ≫
    ((derivedSheafHomBifunctor X).obj (op M)).map (derivedTensorRightUnitIso X K).hom

/-- **The comparison is contravariantly natural in the dualized object.** This is the
functoriality of [Stacks, Tag 0BYU] in its internal-Hom source, with the two other slots held
by identities, followed by the naturality of `R𝑆heafHom_𝒪(h, -)` at the right unit
constraint — the unit constraint not depending on the dualized object. -/
theorem interchangeDualComparison_naturality
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {M M' : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (h : M' ⟶ M) :
    ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).map
          (((derivedSheafHomBifunctor X).map h.op).app (derivedStructureSheaf X)) ≫
        interchangeDualComparison X K M' =
      interchangeDualComparison X K M ≫ ((derivedSheafHomBifunctor X).map h.op).app K := by
  have hnat := derivedTensorHomInterchange_natural X (𝟙 K) (𝟙 (derivedStructureSheaf X)) h
  simp only [CategoryTheory.Functor.map_id, NatTrans.id_app, Category.id_comp,
    Category.comp_id] at hnat
  dsimp only [interchangeDualComparison]
  rw [← Category.assoc, hnat, Category.assoc, Category.assoc]
  exact congrArg _ (((derivedSheafHomBifunctor X).map h.op).naturality
    (derivedTensorRightUnitIso X K).hom).symm

variable {r : ℕ} [HasWeakSheafify X.J CommRingCat.{u}]
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

omit [HasWeakSheafify X.J CommRingCat.{u}] in
/-- **The comparison of [Stacks, Tag 0BYU] at the structure sheaf is the trivialisation
`K ≅ R𝑆heafHom_𝒪(𝒪[0], K)`.** Taken with its dualized object also at the structure sheaf, the
comparison `K ⊗^𝐋_𝒪 𝒪^∨ ⟶ R𝑆heafHom_𝒪(𝒪[0], K)` is the trivialisation of `𝒪^∨` tensored with
`K`, the right unit constraint, and the inverse of the trivialisation of `K`.

This is the unit law of [Stacks, Tag 0BYU] in its internal-Hom source
(`AlgebraicGeometry.RingedSite.derivedTensorHomInterchange_comp_derivedStructureSheafHomIso`),
read through the naturality of the trivialisation at the right unit constraint. -/
theorem interchangeDualComparison_structureSheaf
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    interchangeDualComparison X K (derivedStructureSheaf X) =
      ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).map
          (derivedStructureSheafHomIso X (derivedStructureSheaf X)).hom ≫
        (derivedTensorRightUnitIso X K).hom ≫
          (derivedStructureSheafHomIso X K).inv := by
  have hnat : ((derivedSheafHomBifunctor X).obj (op (derivedStructureSheaf X))).map
        (derivedTensorRightUnitIso X K).hom ≫ (derivedStructureSheafHomIso X K).hom =
      (derivedStructureSheafHomIso X
        (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).obj
          (derivedStructureSheaf X))).hom ≫ (derivedTensorRightUnitIso X K).hom :=
    derivedStructureSheafHomIso_naturality X _
  have hunit := derivedTensorHomInterchange_comp_derivedStructureSheafHomIso X K
    (derivedStructureSheaf X)
  rw [← cancel_mono (derivedStructureSheafHomIso X K).hom, interchangeDualComparison,
    Category.assoc (derivedTensorHomInterchange X K (derivedStructureSheaf X)
      (derivedStructureSheaf X)),
    hnat, ← Category.assoc (derivedTensorHomInterchange X K (derivedStructureSheaf X)
      (derivedStructureSheaf X)),
    hunit, Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]

omit [HasWeakSheafify X.J CommRingCat.{u}] in
/-- **The comparison of [Stacks, Tag 0BYU] against the dual of a morphism into the structure
sheaf.** For a morphism `φ : P ⟶ 𝒪[0]` of `D(𝒪)`, the composite

`K ≅ K ⊗^𝐋_𝒪 𝒪[0] ≅ K ⊗^𝐋_𝒪 𝒪^∨ ⟶ K ⊗^𝐋_𝒪 P^∨ ⟶ R𝑆heafHom_𝒪(P, K)`

— the inverse right unit constraint, the trivialisation of `𝒪^∨` and the dual of `φ` inside the
tensor product, and then the comparison — is the trivialisation `K ≅ R𝑆heafHom_𝒪(𝒪[0], K)`
followed by precomposition with `φ`.

This is `AlgebraicGeometry.RingedSite.interchangeDualComparison_structureSheaf` together with
the contravariant naturality
`AlgebraicGeometry.RingedSite.interchangeDualComparison_naturality` of the comparison in the
dualized object. It is the form in which the comparison enters the computation of the cone of
[Stacks, Tag 0A0E]'s pinned presentation along the completion unit, whose value
`AlgebraicGeometry.RingedSite.completionUnit_app_comp_tensorDerivedDualSystem_π` is exactly the
right-hand side at `φ` the Koszul–Čech comparison followed by the Čech augmentation. -/
theorem derivedTensorRightUnitIso_inv_comp_interchangeDualComparison
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {P : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (φ : P ⟶ derivedStructureSheaf X) :
    (derivedTensorRightUnitIso X K).inv ≫
        ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).map
          ((derivedStructureSheafHomIso X (derivedStructureSheaf X)).inv ≫
            ((derivedSheafHomBifunctor X).map φ.op).app (derivedStructureSheaf X)) ≫
        interchangeDualComparison X K P =
      (derivedStructureSheafHomIso X K).inv ≫
        ((derivedSheafHomBifunctor X).map φ.op).app K := by
  have hA : (derivedTensorRightUnitIso X K).inv ≫
        ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).map
          (derivedStructureSheafHomIso X (derivedStructureSheaf X)).inv ≫
        interchangeDualComparison X K (derivedStructureSheaf X) =
      (derivedStructureSheafHomIso X K).inv := by
    rw [interchangeDualComparison_structureSheaf, ← Category.assoc
        (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).map
          (derivedStructureSheafHomIso X (derivedStructureSheaf X)).inv),
      ← CategoryTheory.Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
      Category.id_comp, Iso.inv_hom_id_assoc]
  rw [CategoryTheory.Functor.map_comp, Category.assoc
      (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).map
        (derivedStructureSheafHomIso X (derivedStructureSheaf X)).inv),
    interchangeDualComparison_naturality X K φ, reassoc_of% hA]

omit [HasWeakSheafify X.J CommRingCat.{u}] in
/-- **The comparison is invertible at a Koszul complex.** The interchange morphism of
[Stacks, Tag 0BYU] is invertible there because the Koszul complexes are strictly perfect, and
the right unit constraint is an isomorphism. -/
theorem isIso_interchangeDualComparison_koszulPowerComplex
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (n : ℕ) :
    IsIso (interchangeDualComparison X K
      (DerivedCategory.Q.obj (koszulPowerComplex X f n))) := by
  have := isIso_derivedTensorHomInterchange_koszulPowerComplex X f K (derivedStructureSheaf X) n
  unfold interchangeDualComparison
  infer_instance

/-- The comparison at a Koszul complex, as an isomorphism. -/
def koszulInterchangeDualIso
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (n : ℕ) :
    ((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj K).obj
        (((derivedSheafHomBifunctor X).obj
          (op (DerivedCategory.Q.obj (koszulPowerComplex X f n)))).obj
            (derivedStructureSheaf X)) ≅
      ((derivedSheafHomBifunctor X).obj
        (op (DerivedCategory.Q.obj (koszulPowerComplex X f n)))).obj K :=
  @asIso _ _ _ _ (interchangeDualComparison X K
      (DerivedCategory.Q.obj (koszulPowerComplex X f n)))
    (isIso_interchangeDualComparison_koszulPowerComplex X f K n)

