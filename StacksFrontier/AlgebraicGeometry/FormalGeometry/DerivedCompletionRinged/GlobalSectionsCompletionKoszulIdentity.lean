* [Stacks Project, Tag 08U1](https://stacks.math.columbia.edu/tag/08U1)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite

universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance 100000] HasDerivedCategory.standard
attribute [local instance] hasFiniteBiproducts_sheafOfModules
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat
attribute [local instance] isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf

section Identity

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).Additive]
  [∀ B, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u} X.O).obj B).Additive]
  [∀ (K₁ K₂ : HomologicalComplex (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.O)) (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor X.O)
      (ComplexShape.up ℤ)]
  (A : Type u) [CommRing A]
  (ρ : A →+* RingCat.sectionsSubring ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj)
  {r : ℕ} (a : Fin r → A)
  [HasCoproduct ((koszulPowerSystem X (fun i ↦ globalSectionOfSections (ρ (a i))) ⋙
    DerivedCategory.Q).obj)]

/-- **`RΓ(𝒞, J)^∧ = RΓ(𝒞, J^∧)` for a K-injective complex `J`** — the identity of
[Stacks, Tag 0BLX] in the form the argument of this file produces it. The derived completion on
the left is along `Ideal.span {a_1, …, a_r}` and on the right along the ideal sheaf
`(ρ a_1, …, ρ a_r)𝒪`.

Both sides are derived limits of one tower: the left by
`KoszulCompletion.isDerivedLimit_coefficientKoszulTower_derivedCompletion` after
`AlgebraicGeometry.RingedSite.globalSectionsKoszulSheafHomComplexSystemIso`, the right by
`AlgebraicGeometry.RingedSite.isDerivedLimit_derivedGlobalSections_derivedSheafHomSystem` after
`AlgebraicGeometry.RingedSite.derivedKoszulHomTowerComparison`, and
`CategoryTheory.Pretriangulated.nonempty_iso_of_isDerivedLimit` identifies them. The last step
replaces `Q(Γ_A(𝒞, J))` by `RΓ_A(𝒞, QJ)`, which is
`AlgebraicGeometry.RingedSite.isIso_moduleGlobalSectionsDerivedUnit_app` and is where
K-injectivity of `J` is used. -/
theorem nonempty_iso_derivedCompletion_derivedGlobalSections_of_isKInjective
    (J : CochainComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) ℤ)
    [J.IsKInjective]
    [HasProduct fun n : ℕ ↦ (derivedSheafHomSystem X
      (koszulPowerSystem X (fun i ↦ globalSectionOfSections (ρ (a i))) ⋙ DerivedCategory.Q)
      (DerivedCategory.Q.obj J)).obj (op n)] :
    Nonempty ((derivedGlobalSectionsOverUnbounded X A ρ).obj
        ((derivedCompletion X
          (generatedIdealSheaf (fun i ↦ globalSectionOfSections (ρ (a i))))).obj
            (DerivedCategory.Q.obj J)) ≅
      (DerivedCompletion.derivedCompletionFunctor A a).obj
        ((derivedGlobalSectionsOverUnbounded X A ρ).obj (DerivedCategory.Q.obj J))) := by
  obtain ⟨_, hlim⟩ := isDerivedLimit_derivedGlobalSections_derivedSheafHomSystem X
    (fun i ↦ globalSectionOfSections (ρ (a i))) (DerivedCategory.Q.obj J) A ρ
  obtain ⟨e⟩ := derivedKoszulHomTowerComparison X A ρ a J
  have hJ := IsDerivedLimit.of_natIso
    (Functor.isoWhiskerRight (globalSectionsKoszulSheafHomComplexSystemIso X A ρ a J)
      DerivedCategory.Q) (IsDerivedLimit.of_natIso e hlim)
  obtain ⟨iso⟩ := nonempty_iso_of_isDerivedLimit hJ
    (KoszulCompletion.isDerivedLimit_coefficientKoszulTower_derivedCompletion a
      (((moduleGlobalSectionsOver X A ρ).mapHomologicalComplex (ComplexShape.up ℤ)).obj J))
  have : IsIso ((moduleGlobalSectionsDerivedUnit X A ρ).app J) :=
    isIso_moduleGlobalSectionsDerivedUnit_app X A ρ J inferInstance
  exact ⟨iso ≪≫ (DerivedCompletion.derivedCompletionFunctor A a).mapIso
    (asIso ((moduleGlobalSectionsDerivedUnit X A ρ).app J))⟩

/-- **[Stacks, Tag 0BLX], the identity `RΓ(𝒞, K)^∧ = RΓ(𝒞, K^∧)`**, at an ideal sheaf generated
by finitely many global sections and for an arbitrary object `K` of `D(𝒪)`. Let `(𝒞, 𝒪)` be a
ringed site, `A` a commutative ring, `ρ : A ⟶ Γ(𝒞, 𝒪)` making `𝒪` a sheaf of `A`-algebras and
`a_1, …, a_r ∈ A`. Then the derived completion of `RΓ_A(𝒞, K)` along `Ideal.span {a_1, …, a_r}`
— the reflector of [Stacks, Tag 0G3E] — is `RΓ_A(𝒞, K^∧)`, the derived completion of `K` being
taken along the ideal sheaf `(ρ a_1, …, ρ a_r)𝒪` and being the reflector of [Stacks, Tag 099F],
which exists at that ideal sheaf.

There is **no nilpotence hypothesis**: both reflectors are produced, the sheaf-side one by
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf` (a local
instance of this file, so nowhere a hypothesis) and the module-side one by
`DerivedCompletion.derivedCompletionFunctor`. There is no boundedness or finiteness hypothesis
on `K` either, and the ideal sheaf is general: the completion on the left is along
`Ideal.span (Set.range a)`, and by
`AlgebraicGeometry.RingedSite.isIdealSheafGeneratedBy_generatedIdealSheaf` the ideal sheaf
`(ρ a_1, …, ρ a_r)𝒪` *is* the `I𝒪` of that ideal, so for a finitely generated `I` with
generating family `a` this is the tag's own data.

The two remaining hypotheses are the existence of the coproduct of the Koszul system in `D(𝒪)`
and of the products of the Hom tower, which is what makes the derived colimit and the derived
limits of the argument exist; they are the same hypotheses that
`AlgebraicGeometry.RingedSite.isDerivedLimit_derivedGlobalSections_derivedSheafHomSystem`
carries.

This carries no `@[stacks 0BLX]` attribute because that tag asserts the identity **and** two
spectral sequences; see the module documentation. -/
theorem nonempty_iso_derivedCompletion_derivedGlobalSections
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    [HasProduct fun n : ℕ ↦ (derivedSheafHomSystem X
      (koszulPowerSystem X (fun i ↦ globalSectionOfSections (ρ (a i))) ⋙ DerivedCategory.Q)
      K).obj (op n)] :
    Nonempty ((derivedGlobalSectionsOverUnbounded X A ρ).obj
        ((derivedCompletion X
          (generatedIdealSheaf (fun i ↦ globalSectionOfSections (ρ (a i))))).obj K) ≅
      (DerivedCompletion.derivedCompletionFunctor A a).obj
        ((derivedGlobalSectionsOverUnbounded X A ρ).obj K)) := by
  have hinc : IsIso (DerivedCategory.Q.map
      ((kInjectiveAugmentation X).app (DerivedCategory.Q.objPreimage K))) :=
    (DerivedCategory.isIso_Q_map_iff_quasiIso _ _).2 inferInstance
  have eJ : DerivedCategory.Q.obj
      ((kInjectiveResolution X).obj (DerivedCategory.Q.objPreimage K)) ≅ K :=
    (asIso (DerivedCategory.Q.map
        ((kInjectiveAugmentation X).app (DerivedCategory.Q.objPreimage K)))).symm ≪≫
      DerivedCategory.Q.objObjPreimageIso K
  have : HasProduct fun n : ℕ ↦ (derivedSheafHomSystem X
      (koszulPowerSystem X (fun i ↦ globalSectionOfSections (ρ (a i))) ⋙ DerivedCategory.Q)
      (DerivedCategory.Q.obj ((kInjectiveResolution X).obj
        (DerivedCategory.Q.objPreimage K)))).obj (op n) :=
    hasProduct_of_equiv_of_iso
      (fun n : ℕ ↦ (derivedSheafHomSystem X
        (koszulPowerSystem X (fun i ↦ globalSectionOfSections (ρ (a i))) ⋙ DerivedCategory.Q)
        K).obj (op n)) _ (Equiv.refl ℕ) fun n ↦
      ((derivedSheafHomBifunctor X).obj (op ((koszulPowerSystem X
        (fun i ↦ globalSectionOfSections (ρ (a i))) ⋙ DerivedCategory.Q).obj n))).mapIso eJ
  obtain ⟨iso⟩ := nonempty_iso_derivedCompletion_derivedGlobalSections_of_isKInjective X A ρ a
    ((kInjectiveResolution X).obj (DerivedCategory.Q.objPreimage K))
  exact ⟨((derivedGlobalSectionsOverUnbounded X A ρ).mapIso
        ((derivedCompletion X
          (generatedIdealSheaf (fun i ↦ globalSectionOfSections (ρ (a i))))).mapIso eJ)).symm ≪≫
      iso ≪≫ (DerivedCompletion.derivedCompletionFunctor A a).mapIso
        ((derivedGlobalSectionsOverUnbounded X A ρ).mapIso eJ)⟩

end Identity

end AlgebraicGeometry.RingedSite

end
