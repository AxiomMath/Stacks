/-!
# Derived completion in the constant Noetherian case

Let `𝒞` be a site, let `Λ` be a Noetherian ring and let `I ⊂ Λ` be an ideal. On the constant
ringed site `(𝒞, Λ̲)` the derived completion `K ↦ K^∧` — the left adjoint of the inclusion of the
objects of `D(𝒞, Λ)` which are derived complete along `IΛ̲` ([Stacks, Tag 099F]) — is computed by
the naive formula

`K^∧ = R lim (K ⊗^𝐋_Λ (Λ/Iⁿ)̲)`,

and an object is derived complete exactly when it is the derived limit of its reductions. This is
[Stacks, Tag 099M].

## Main results

* `AlgebraicGeometry.RingedSite.derivedCompletion_eq_rlim_constantAdicTower`:
  **[Stacks, Tag 099M]**, both assertions.
* `AlgebraicGeometry.RingedSite.isDerivedLimit_constantAdicTower_derivedCompletion`: the formula.
* `AlgebraicGeometry.RingedSite.isDerivedComplete_iff_isDerivedLimit_constantAdicTower`: the
  criterion.
* `AlgebraicGeometry.RingedSite.koszulPowerDualSystemProIso`: on the constant site, the tower of
  duals of the Koszul complexes is pro-isomorphic to `{(Λ/Iⁿ)̲}`.
* `AlgebraicGeometry.RingedSite.derivedCompletionIsoCompletionFunctor`: the derived completion
  along an ideal sheaf generated by global sections is the Čech completion of
  [Stacks, Tag 099B].

## Main definitions

* `AlgebraicGeometry.RingedSite.constantAdicTower`: the tower `n ↦ K ⊗^𝐋_Λ (Λ/Iⁿ)̲` in
  `D(𝒞, Λ)`, with the reduction maps as transition maps.
* `InverseSequence.ProIso.trans`: the composite of two pro-isomorphisms of inverse sequences.

## Implementation notes

The proof is the source's. Choose generators `f_1, …, f_r` of `I`. By [Stacks, Tag 0A0E]
(`AlgebraicGeometry.RingedSite.isDerivedLimit_tensorDerivedDualSystem_koszulPowerSystem_canonical`)
`K^∧` is a derived limit of `n ↦ K ⊗^𝐋 K_n^∨`, `K_n` the Koszul complex on the powers of the
`f̲_i`. On the constant site `K_n^∨` is the constant sheaf of the Koszul complex
`K(Λ, f_1^{n+1}, …, f_r^{n+1})` in degrees `-r, …, 0`, naturally in `n`
(`AlgebraicGeometry.RingedSite.constantKoszulDualIso`), and [Stacks, Tag 0921]
(`NoetherianKoszulProIso.koszulPowerSystem_proIso_quotientPowerSystem`) makes that tower
pro-isomorphic in `D(Λ)` to `{Λ/(f_1^{n+1}, …, f_r^{n+1})}`, which is pro-isomorphic to
`{Λ/Iⁿ}`. The constant sheaf of modules functor is exact, so it carries these pro-isomorphisms
to `D(𝒞, Λ)`, and so does `K ⊗^𝐋 -`; derived limits of pro-isomorphic towers are isomorphic
([Stacks, Tag 0H9L]).

The derived limit is recorded by `CategoryTheory.Pretriangulated.IsDerivedLimit`, as everywhere
in this directory: a derived limit is determined only up to non-unique isomorphism. The ideal
sheaf is `AlgebraicGeometry.RingedSite.constantIdealSheaf`, the sheaf of ideals of `Λ̲`
generated by `I`, which is of finite type because `Λ` is Noetherian, so that the reflector of
[Stacks, Tag 099F] exists. The site has objects and morphisms in one universe `u`, and `Λ` lives
there too: that is the universe at which [Stacks, Tag 0A0E] and the derived duality it rests on
are available, and the source's sites are sets.

## References

* [Stacks Project, Tag 099M](https://stacks.math.columbia.edu/tag/099M)
* [Stacks Project, Tag 0A0E](https://stacks.math.columbia.edu/tag/0A0E)
* [Stacks Project, Tag 0921](https://stacks.math.columbia.edu/tag/0921)
* [Stacks Project, Tag 099F](https://stacks.math.columbia.edu/tag/099F)
* [Stacks Project, Tag 0H9L](https://stacks.math.columbia.edu/tag/0H9L)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite

universe u v w

namespace InverseSequence.ProIso

variable {D : Type*} [Category D] {X Y Z : ℕᵒᵖ ⥤ D}

/-- **The composite of two pro-isomorphisms.** -/
def trans (a : ProIso X Y) (b : ProIso Y Z) : ProIso X Z where
  α m := a.α (b.α m)
  β m := b.β (a.β m)
  αmono _ _ h := a.αmono (b.αmono h)
  βmono _ _ h := b.βmono (a.βmono h)
  αle m := (b.αle m).trans (a.αle (b.α m))
  βle m := (a.βle m).trans (b.βle (a.β m))
  φ m := a.φ (b.α m) ≫ b.φ m
  ψ m := b.ψ (a.β m) ≫ a.ψ m
  φnat {m m'} h := by
    rw [← Category.assoc, a.φnat (b.αmono h), Category.assoc, b.φnat h, Category.assoc]
  ψnat {m m'} h := by
    rw [← Category.assoc, b.ψnat (a.βmono h), Category.assoc, a.ψnat h, Category.assoc]
  ψφ m := by
    calc (a.φ (b.α (b.β (a.β m))) ≫ b.φ (b.β (a.β m))) ≫ b.ψ (a.β m) ≫ a.ψ m
        = a.φ (b.α (b.β (a.β m))) ≫ (b.φ (b.β (a.β m)) ≫ b.ψ (a.β m)) ≫ a.ψ m := by
          simp only [Category.assoc]
      _ = tr X _ ≫ a.φ (a.β m) ≫ a.ψ m := by
          rw [b.ψφ (a.β m), ← Category.assoc, ← a.φnat, Category.assoc]
      _ = _ := by rw [a.ψφ, ProIso.tr_trans]
  φψ m := by
    calc (b.ψ (a.β (a.α (b.α m))) ≫ a.ψ (a.α (b.α m))) ≫ a.φ (b.α m) ≫ b.φ m
        = b.ψ (a.β (a.α (b.α m))) ≫ (a.ψ (a.α (b.α m)) ≫ a.φ (b.α m)) ≫ b.φ m := by
          simp only [Category.assoc]
      _ = tr Z _ ≫ b.ψ (b.α m) ≫ b.φ m := by
          rw [a.φψ (b.α m), ← Category.assoc, ← b.ψnat, Category.assoc]
      _ = _ := by rw [b.φψ, ProIso.tr_trans]

end InverseSequence.ProIso


namespace CategoryTheory.NatIso

variable {C : Type*} [Category C] {F G : ℕᵒᵖ ⥤ C}

/-- A natural isomorphism of `ℕᵒᵖ`-diagrams from componentwise isomorphisms which commute with
the transition maps between successive indices. -/
def ofOpSequence (e : ∀ n : ℕ, F.obj (op n) ≅ G.obj (op n))
    (h : ∀ n : ℕ, F.map (homOfLE (Nat.le_add_right n 1)).op ≫ (e n).hom =
      (e (n + 1)).hom ≫ G.map (homOfLE (Nat.le_add_right n 1)).op) : F ≅ G :=
  have : IsIso (NatTrans.ofOpSequence (fun n => (e n).hom) h) :=
    @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ fun n => Iso.isIso_hom (e n.unop)
  asIso (NatTrans.ofOpSequence (fun n => (e n).hom) h)

/-- The component of `NatIso.ofOpSequence e h` at `n` is `(e n).hom`. -/
@[simp]
theorem ofOpSequence_hom_app (e : ∀ n : ℕ, F.obj (op n) ≅ G.obj (op n)) (h) (n : ℕ) :
    (ofOpSequence e h).hom.app (op n) = (e n).hom :=
  rfl

end CategoryTheory.NatIso

namespace AlgebraicGeometry.RingedSite

section Ring

variable {Λ : Type u} [CommRing Λ] {r : ℕ} (g : Fin r → Λ)

/-- For `m ≤ n`, the ideal `(g_1^{n+1}, …, g_r^{n+1})` is contained in
`(g_1^{m+1}, …, g_r^{m+1})`. -/
theorem span_pow_succ_le {m n : ℕ} (h : m ≤ n) :
    Ideal.span (Set.range fun i => g i ^ (n + 1)) ≤
      Ideal.span (Set.range fun i => g i ^ (m + 1)) := by
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact Ideal.mem_of_dvd _ (pow_dvd_pow _ (by omega)) (Ideal.subset_span ⟨i, rfl⟩)

/-- The tower `n ↦ Λ/(g_1^{n+1}, …, g_r^{n+1})` of `Λ`-modules, with the quotient maps. -/
def koszulQuotientSystem : ℕᵒᵖ ⥤ ModuleCat.{u} Λ where
  obj n := ModuleCat.of Λ (Λ ⧸ Ideal.span (Set.range fun i => g i ^ (n.unop + 1)))
  map {a b} h := ModuleCat.ofHom <| Submodule.mapQ _ _ LinearMap.id (by
    simpa using span_pow_succ_le g (leOfHom h.unop))
  map_id _ := ModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl))
  map_comp _ _ := ModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl))

/-- If the `g_i` generate `I`, then `(g_1^{m+1}, …, g_r^{m+1}) ⊂ I^m`. -/
theorem span_pow_succ_le_pow (I : Ideal Λ) (hg : Ideal.span (Set.range g) = I) (m : ℕ) :
    Ideal.span (Set.range fun i => g i ^ (m + 1)) ≤ I ^ m := by
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  have hi : g i ∈ I := hg ▸ Ideal.subset_span ⟨i, rfl⟩
  exact Ideal.pow_le_pow_right (Nat.le_succ m) (Ideal.pow_mem_pow hi (m + 1))

/-- If the `g_i` generate `I`, then some power `I^N` is contained in
`(g_1^{m+1}, …, g_r^{m+1})`. -/
theorem exists_pow_le_span_pow_succ (I : Ideal Λ) (hg : Ideal.span (Set.range g) = I) (m : ℕ) :
    ∃ N : ℕ, I ^ N ≤ Ideal.span (Set.range fun i => g i ^ (m + 1)) := by
  classical
  refine Ideal.exists_pow_le_of_le_radical_of_fg ?_ ⟨Finset.univ.image g, ?_⟩
  · rw [← hg, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨m + 1, Ideal.subset_span ⟨i, rfl⟩⟩
  · rw [← hg, Finset.coe_image, Finset.coe_univ, Set.image_univ]

/-- The index at which `I^N ⊂ (g_1^{m+1}, …, g_r^{m+1})`, made monotone in `m` and at least `m`. -/
noncomputable def koszulQuotientIndex (I : Ideal Λ) (hg : Ideal.span (Set.range g) = I)
    (m : ℕ) : ℕ :=
  m + ∑ k ∈ Finset.range (m + 1), (exists_pow_le_span_pow_succ g I hg k).choose

/-- `koszulQuotientIndex g I hg` is monotone. -/
theorem monotone_koszulQuotientIndex (I : Ideal Λ) (hg : Ideal.span (Set.range g) = I) :
    Monotone (koszulQuotientIndex g I hg) :=
  monotone_id.add ((Finset.sum_mono_set _).comp (Finset.range_mono.comp (monotone_id.add_const 1)))

/-- `I^N ⊂ (g_1^{m+1}, …, g_r^{m+1})` for `N = koszulQuotientIndex g I hg m`. -/
theorem pow_koszulQuotientIndex_le (I : Ideal Λ) (hg : Ideal.span (Set.range g) = I) (m : ℕ) :
    I ^ koszulQuotientIndex g I hg m ≤ Ideal.span (Set.range fun i => g i ^ (m + 1)) := by
  refine le_trans (Ideal.pow_le_pow_right ?_) (exists_pow_le_span_pow_succ g I hg m).choose_spec
  refine le_trans ?_ (Nat.le_add_left _ m)
  exact Finset.single_le_sum (f := fun k => (exists_pow_le_span_pow_succ g I hg k).choose)
    (fun _ _ => Nat.zero_le _) (Finset.self_mem_range_succ m)

/-- **The towers `{Λ/(g_1^{n+1}, …, g_r^{n+1})}` and `{Λ/Iⁿ}` are pro-isomorphic** when the `g_i`
generate `I`. -/
def koszulQuotientProIso (I : Ideal Λ) (hg : Ideal.span (Set.range g) = I) :
    InverseSequence.ProIso (koszulQuotientSystem g)
      (Stacks.ConstantSheaf.adicQuotientSystem I) where
  α := id
  β := koszulQuotientIndex g I hg
  αmono := monotone_id
  βmono := monotone_koszulQuotientIndex g I hg
  αle _ := le_rfl
  βle m := Nat.le_add_right m _
  φ m := ModuleCat.ofHom <| Submodule.mapQ _ _ LinearMap.id (by
    simpa using span_pow_succ_le_pow g I hg m)
  ψ m := ModuleCat.ofHom <| Submodule.mapQ _ _ LinearMap.id (by
    simpa using pow_koszulQuotientIndex_le g I hg m)
  φnat _ := by
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    ext
    rfl
  ψnat _ := by
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    ext
    rfl
  ψφ _ := by
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    ext
    rfl
  φψ _ := by
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    ext
    rfl

end Ring

section Single

variable (V : Type u) [Category.{v} V] [Abelian V]

/-- A chain complex in degree zero, extended to a cochain complex along `n ↦ -n`, is the cochain
complex in degree zero. -/
def single₀ExtendIso :
    ChainComplex.single₀ V ⋙ ComplexShape.embeddingDownNat.extendFunctor V ≅
      HomologicalComplex.single V (ComplexShape.up ℤ) 0 :=
  NatIso.ofComponents
    (fun A => HomologicalComplex.extendSingleIso ComplexShape.embeddingDownNat A 0 0 (by simp))
    (fun {A B} f => by
      refine HomologicalComplex.to_single_hom_ext ?_
      simp only [Functor.comp_map, HomologicalComplex.comp_f]
      change (HomologicalComplex.extendMap _ _).f 0 ≫ _ = _
      rw [HomologicalComplex.extendMap_f _ _ (by simp : ComplexShape.embeddingDownNat.f 0 = 0),
        HomologicalComplex.extendSingleIso_hom_f]
      exact (HomologicalComplex.extendSingleIso_hom_f_assoc ComplexShape.embeddingDownNat A 0 0
        _ _).symm ▸ by simp only [HomologicalComplex.single_map_f_self, Category.assoc,
          Iso.inv_hom_id_assoc])

end Single


section RingDerived

variable {Λ : Type u} [CommRing Λ] {r : ℕ} (g : Fin r → Λ)

/-- The tower of Koszul cochain complexes of [Stacks, Tag 0921], as a diagram of complexes. -/
abbrev ringKoszulSystem : ℕᵒᵖ ⥤ CochainComplex (ModuleCat.{u} Λ) ℤ :=
  Functor.ofOpSequence (ringKoszulTransition g)

/-- The tower of [Stacks, Tag 0921] in `D(Λ)` is the image of the tower of complexes. -/
def koszulPowerSystemIso :
    NoetherianKoszulProIso.koszulPowerSystem g ≅ ringKoszulSystem g ⋙ DerivedCategory.Q :=
  NatIso.ofOpSequence (fun _ => Iso.refl _) (fun n => by
    simp only [Iso.refl_hom, Functor.comp_map, Functor.ofOpSequence_map_homOfLE_succ,
      NoetherianKoszulProIso.koszulPowerSystem]
    exact (Category.comp_id _).trans (Category.id_comp _).symm)

/-- The transition map `Λ/(g_i^{n+2}) ⟶ Λ/(g_i^{n+1})` of
`NoetherianKoszulProIso.quotientPowerTransition` is the transition map of
`koszulQuotientSystem g`. -/
theorem quotientPowerTransition_eq (n : ℕ) :
    NoetherianKoszulProIso.quotientPowerTransition g (n + 1) n (Nat.le_succ n) =
      (koszulQuotientSystem g).map (homOfLE (Nat.le_succ n)).op := by
  have hepi : Epi (ModuleCat.ofHom
      (Ideal.span (Set.range fun i => g i ^ (n + 1 + 1))).mkQ) :=
    (ModuleCat.epi_iff_surjective _).2 (Submodule.mkQ_surjective _)
  refine (cancel_epi (ModuleCat.ofHom
    (Ideal.span (Set.range fun i => g i ^ (n + 1 + 1))).mkQ)).1 ?_
  rw [NoetherianKoszulProIso.quotientPowerTransition_comp_mkQ]
  rfl

/-- The functor `M ↦ M[0]` from `Λ`-modules to `D(Λ)`, through chain complexes, in the form in
which the quotient tower of [Stacks, Tag 0921] is written. -/
abbrev single₀Q : ModuleCat.{u} Λ ⥤ DerivedCategory (ModuleCat.{u} Λ) :=
  ChainComplex.single₀ _ ⋙ ComplexShape.embeddingDownNat.extendFunctor _ ⋙ DerivedCategory.Q

/-- The quotient tower of [Stacks, Tag 0921] in `D(Λ)` is the image of the tower of modules. -/
def quotientPowerSystemIso :
    NoetherianKoszulProIso.quotientPowerSystem g ≅ koszulQuotientSystem g ⋙ single₀Q :=
  NatIso.ofOpSequence (fun _ => Iso.refl _) (fun n => by
    simp only [Iso.refl_hom, Functor.comp_map,
      NoetherianKoszulProIso.quotientPowerSystem, Functor.ofOpSequence_map_homOfLE_succ,
      quotientPowerTransition_eq, ComplexShape.Embedding.extendFunctor_map]
    exact (Category.comp_id _).trans (Category.id_comp _).symm)

/-- `single₀Q` is the functor `M ↦ M[0]`. -/
def single₀QIso : (single₀Q : ModuleCat.{u} Λ ⥤ _) ≅ DerivedCategory.singleFunctor _ 0 :=
  Functor.isoWhiskerRight (single₀ExtendIso (ModuleCat.{u} Λ)) DerivedCategory.Q ≪≫
    (DerivedCategory.singleFunctorIsoCompQ _ 0).symm

end RingDerived

section Sheaf

attribute [local instance] HasDerivedCategory.standard

variable {C : Type u} [Category.{u} C] (J : GrothendieckTopology C) (Λ : Type u) [CommRing Λ]
  {r : ℕ} (g : Fin r → Λ)

/-- The tower of dual Koszul complexes on the constant ringed site is the constant sheaf of
modules applied to the tower of Koszul cochain complexes of `Λ`-modules. -/
def koszulPowerDualComplexSystemIso :
    ringKoszulSystem g ⋙ (constantModuleFunctor J Λ).mapHomologicalComplex _ ≅
      koszulPowerDualComplexSystem (constant J Λ) (fun i => constantGlobalSection J Λ (g i)) :=
  NatIso.ofOpSequence (fun n => constantKoszulDualIso J Λ g n) (fun n => by
    simp only [Functor.comp_map, Functor.ofOpSequence_map_homOfLE_succ]
    exact constantKoszulDualIso_naturality J Λ g n)

/-- **The dual Koszul tower on the constant ringed site is pro-isomorphic to the tower of the
constant sheaves `(Λ/Iⁿ)̲`**, for generators `g_1, …, g_r` of an ideal `I` of a Noetherian ring
`Λ`. This is [Stacks, Tag 0921] carried along the constant sheaf of modules functor. -/
noncomputable def koszulPowerDualSystemProIso [IsNoetherianRing Λ] (I : Ideal Λ)
    (hg : Ideal.span (Set.range g) = I) :
    InverseSequence.ProIso
      (koszulPowerDualSystem (constant J Λ) (fun i => constantGlobalSection J Λ (g i)))
      (Stacks.ConstantSheaf.adicQuotientSystem I ⋙ constantModuleFunctor J Λ ⋙
        DerivedCategory.singleFunctor _ 0) :=
  let Φ := constantModuleFunctor J Λ
  (InverseSequence.ProIso.ofNatIso (derivedDualKoszulPowerSystemIso (constant J Λ)
      (fun i => constantGlobalSection J Λ (g i)))).trans <|
  (InverseSequence.ProIso.ofNatIso (Functor.isoWhiskerRight
      (koszulPowerDualComplexSystemIso J Λ g).symm DerivedCategory.Q)).trans <|
  (InverseSequence.ProIso.ofNatIso (Functor.isoWhiskerLeft (ringKoszulSystem g)
      Φ.mapDerivedCategoryFactors.symm)).trans <|
  (InverseSequence.ProIso.ofNatIso (Functor.isoWhiskerRight (koszulPowerSystemIso g).symm
      Φ.mapDerivedCategory)).trans <|
  ((Classical.choice
      (NoetherianKoszulProIso.nonempty_proIso_koszulPowerSystem_quotientPowerSystem g)).whiskerRight
      Φ.mapDerivedCategory).trans <|
  (InverseSequence.ProIso.ofNatIso (Functor.isoWhiskerRight (quotientPowerSystemIso g)
      Φ.mapDerivedCategory)).trans <|
  ((koszulQuotientProIso g I hg).whiskerRight (single₀Q ⋙ Φ.mapDerivedCategory)).trans <|
  InverseSequence.ProIso.ofNatIso (Functor.isoWhiskerLeft _
    (Functor.isoWhiskerRight single₀QIso Φ.mapDerivedCategory ≪≫
      Φ.mapDerivedCategorySingleFunctor 0))

end Sheaf

section Completion

attribute [local instance] HasDerivedCategory.standard

variable {C : Type u} [Category.{u} C] (J : GrothendieckTopology C) (Λ : Type u) [CommRing Λ]

/-- **The sheaf of ideals `IΛ̲` is of finite type** when `I` is finitely generated. -/
theorem isFiniteType_constantIdealSheaf {I : Ideal Λ} (hI : I.FG) :
    (constantIdealSheaf J Λ I).toSheafOfModules.IsFiniteType := by
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1 hI
  rw [constantIdealSheaf_eq_idealOfGlobalSections J Λ I g hg]
  exact isFiniteType_idealOfGlobalSections _ _

/-- Over a Noetherian ring `Λ`, the sheaf of ideals `IΛ̲` is of finite type. -/
instance [IsNoetherianRing Λ] (I : Ideal Λ) :
    (constantIdealSheaf J Λ I).toSheafOfModules.IsFiniteType :=
  isFiniteType_constantIdealSheaf J Λ (IsNoetherian.noetherian I)

/-- **The tower `n ↦ K ⊗^𝐋_Λ (Λ/Iⁿ)̲`** in `D(𝒞, Λ)`, with the maps induced by the reductions
`Λ/I^{n+1} ⟶ Λ/Iⁿ` as transition maps; the derived tensor product is the canonical one of
[Stacks, Tag 06YU]. -/
abbrev constantAdicTower (I : Ideal Λ)
    (K : DerivedCategory (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))) :
    ℕᵒᵖ ⥤ DerivedCategory (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O)) :=
  Stacks.ConstantSheaf.adicQuotientSystem I ⋙ constantModuleFunctor J Λ ⋙
    DerivedCategory.singleFunctor _ 0 ⋙
      (Stacks.SheafOfModules.derivedTensorProductFunctor (constant J Λ)).obj K

/-- Being a derived limit of a tower is invariant under isomorphism of the limit object. -/
theorem isDerivedLimit_iff_of_iso {D : Type*} [Category D] [HasZeroObject D]
    [HasShift D ℤ] [Preadditive D] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {F : ℕᵒᵖ ⥤ D} [HasProduct fun n : ℕ => F.obj ⟨n⟩] {K L : D} (e : K ≅ L) :
    IsDerivedLimit F K ↔ IsDerivedLimit F L := by
  suffices h : ∀ {K L : D} (e : K ≅ L), IsDerivedLimit F L → IsDerivedLimit F K from
    ⟨h e.symm, h e⟩
  intro K L e hL
  obtain ⟨p, δ, hT⟩ := hL
  refine ⟨e.hom ≫ p, δ ≫ (shiftFunctor D (1 : ℤ)).map e.inv,
    isomorphic_distinguished _ hT _
      (Triangle.isoMk _ _ e (Iso.refl _) (Iso.refl _) (by simp) (by simp) (by simp))⟩

/-- The derived completion along the ideal sheaf generated by finitely many global sections is
the Čech completion of [Stacks, Tag 099B]. -/
def derivedCompletionIsoCompletionFunctor (X : RingedSite.{u, u, u}) {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hI : I = idealOfGlobalSections X f)
    [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint] :
    derivedCompletion X I ≅ completionFunctor X f := by
  subst hI
  exact Stacks.Algebraization.leftAdjointCompιIsoOfCompletionFunctor (completionUnit X f)
    (fun L => isDerivedComplete_completionFunctor X f L)
    (fun Z hZ => isIso_completionUnit_app_of_isDerivedComplete_idealOfGlobalSections X f Z hZ)
    (fun L => by
      rw [completionFunctor_map_completionUnit_app_idealOfGlobalSections]
      exact isIso_completionUnit_app_completionFunctor_obj X f L)

variable [IsNoetherianRing Λ] (I : Ideal Λ)

/-- Over a Noetherian ring `Λ`, the inclusion of the objects derived complete along `IΛ̲` has a
left adjoint. -/
instance : (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} (constant J Λ)
    (constantIdealSheaf J Λ I))).IsRightAdjoint :=
  isRightAdjoint_ι_isDerivedComplete (constant J Λ) (constantIdealSheaf J Λ I)

/-- **The completion formula of [Stacks, Tag 099M].** -/
theorem isDerivedLimit_constantAdicTower_derivedCompletion
    (K : DerivedCategory (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))) :
    IsDerivedLimit (constantAdicTower J Λ I K)
      ((derivedCompletion (constant J Λ) (constantIdealSheaf J Λ I)).obj K) := by
  obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (IsNoetherian.noetherian I)
  let f' := fun i => constantGlobalSection J Λ (g i)
  have h0A0E := isDerivedLimit_tensorDerivedDualSystem_koszulPowerSystem_canonical
    (constant J Λ) f' K
  have a := (koszulPowerDualSystemProIso J Λ g I hg).whiskerRight
    ((Stacks.SheafOfModules.derivedTensorProductFunctor (constant J Λ)).obj K)
  obtain ⟨M, hM⟩ := exists_isDerivedLimit (constantAdicTower J Λ I K)
  obtain ⟨e⟩ := Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_pro_isomorphism _ _ _ M h0A0E hM a
  exact (isDerivedLimit_iff_of_iso ((derivedCompletionIsoCompletionFunctor (constant J Λ) f' _
    (constantIdealSheaf_eq_idealOfGlobalSections J Λ I g hg)).app K ≪≫ e)).2 hM

/-- **The completeness criterion of [Stacks, Tag 099M].** -/
theorem isDerivedComplete_iff_isDerivedLimit_constantAdicTower
    (K : DerivedCategory (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))) :
    IsDerivedComplete.{u, u, u, u} (constant J Λ) (constantIdealSheaf J Λ I) K ↔
      IsDerivedLimit (constantAdicTower J Λ I K) K := by
  have hcompl := isDerivedLimit_constantAdicTower_derivedCompletion J Λ I K
  constructor
  · intro hK
    have := isIso_derivedCompletionUnit_app (constant J Λ) (constantIdealSheaf J Λ I) hK
    exact (isDerivedLimit_iff_of_iso
      (asIso ((derivedCompletionUnit (constant J Λ) (constantIdealSheaf J Λ I)).app K))).2 hcompl
  · intro hK
    obtain ⟨e⟩ := Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_pro_isomorphism _ _ _ K
      hcompl hK (InverseSequence.ProIso.ofNatIso (Iso.refl _))
    exact (isDerivedComplete_iff_of_iso (constant J Λ) (constantIdealSheaf J Λ I) e).1
      (isDerivedComplete_derivedCompletion_obj _ _ K)

/-- Let `𝒞` be a site, let `Λ` be a Noetherian ring and let `I ⊂ Λ` be an ideal. The left adjoint
`K ↦ K^∧` of the inclusion of the objects of `D(𝒞, Λ)` derived complete along `IΛ̲`
([Stacks, Tag 099F]) sends `K` to `R lim (K ⊗^𝐋_Λ (Λ/Iⁿ)̲)`; and `K` is derived complete exactly
when `K = R lim (K ⊗^𝐋_Λ (Λ/Iⁿ)̲)`. -/
@[stacks 099M]
theorem derivedCompletion_eq_rlim_constantAdicTower
    (K : DerivedCategory (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))) :
    IsDerivedLimit (constantAdicTower J Λ I K)
        ((derivedCompletion (constant J Λ) (constantIdealSheaf J Λ I)).obj K) ∧
      (IsDerivedComplete.{u, u, u, u} (constant J Λ) (constantIdealSheaf J Λ I) K ↔
        IsDerivedLimit (constantAdicTower J Λ I K) K) :=
  ⟨isDerivedLimit_constantAdicTower_derivedCompletion J Λ I K,
    isDerivedComplete_iff_isDerivedLimit_constantAdicTower J Λ I K⟩

end Completion

