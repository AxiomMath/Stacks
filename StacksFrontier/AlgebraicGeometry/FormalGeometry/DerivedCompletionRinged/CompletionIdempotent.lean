  have hbij := Stacks.Algebraization.bijective_precomp_completionUnit (completionUnit X f)
    (fun Z hZ => isIso_completionUnit_app_of_isDerivedComplete X f Z I hI hZ)
    (fun K => isIso_completionFunctor_map_completionUnit_app X f K) L
    (hΦ ((completionFunctor X f).obj L))
  exact hbij.1
    (Stacks.Algebraization.comp_app_unit (completionUnit X f) ((completionUnit X f).app L)).symm

