theorem completionFunctor_map_completionUnit_app_idealOfGlobalSections :
    (completionFunctor X f).map ((completionUnit X f).app L) =
      (completionUnit X f).app ((completionFunctor X f).obj L) :=
  completionFunctor_map_completionUnit_app X f L (idealOfGlobalSections X f)
    (fun i U => globalSectionVal_mem_idealOfGlobalSections X f i (op U))
    (isDerivedComplete_completionFunctor X f)

/-- **[Stacks, Tag 099F] for the ideal sheaf generated by finitely many global sections, with no
