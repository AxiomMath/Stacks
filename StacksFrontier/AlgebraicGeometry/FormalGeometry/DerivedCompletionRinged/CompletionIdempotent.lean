@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite
open HomologicalComplex ComplexShape
open Stacks.Sheaves.CechFlatNeighbourhood (baseChangeFamily awayLocalizationBaseChangeIso
  tensorExtendedAlternatingCechIso)

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  {r : ℕ} (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))
  (h : Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- **The transitions of the base-changed localization system that only adjoin an invertible
index are invertible.** If `f_j` becomes a unit in `𝒪_h` and `S ⊆ T ⊆ S ∪ {j}`, then
`𝒪_{f_S} ⊗_𝒪 𝒪_h ⟶ 𝒪_{f_T} ⊗_𝒪 𝒪_h` is an isomorphism.

The system `S ↦ 𝒪_{f_S} ⊗_𝒪 𝒪_h` is the system `S ↦ (𝒪_h)_{f_S}` of localizations of `𝒪_h`
read over `𝒪` (`Stacks.Sheaves.CechFlatNeighbourhood.awayLocalizationBaseChangeIso`), where the
assertion is `isIso_awayModuleTransition_of_subset_insert` over the ringed site `(𝒞, 𝒪_h)`. -/
theorem isIso_tensorAwayLocalizationFunctor_map (j : Fin r)
    (hj : ∀ U : X.Cᵒᵖ,
      IsUnit (((toAwaySheaf h).hom.app U).hom (globalSectionVal (f j) U)))
    {S T : Finset (Fin r)} (hST : S ⊆ T) (hTS : T ⊆ insert j S) :
    IsIso ((awayLocalizationFunctor X f ⋙
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
        (awayModule X h))).map (homOfLE hST)) := by
  refine (NatIso.isIso_map_iff (awayLocalizationBaseChangeIso X.O f (toAwaySheaf h))
    (homOfLE hST)).2 ?_
  have : IsIso (awayModuleTransition (awayRingedSite X h)
      (baseChangeFamily X.O f (toAwaySheaf h)) hST) :=
    isIso_awayModuleTransition_of_subset_insert (awayRingedSite X h)
      (baseChangeFamily X.O f (toAwaySheaf h)) j hj hST hTS
  exact inferInstanceAs (IsIso ((SheafOfModules.restrictScalars
    (baseChangeRingSheafMap X (awaySheaf h) (toAwaySheaf h))).map
      (awayModuleTransition (awayRingedSite X h)
        (baseChangeFamily X.O f (toAwaySheaf h)) hST)))

section Derived

attribute [local instance] HasDerivedCategory.standard

/-- **The degreewise tensor product of the Čech complex with `𝒪_h` is a Čech complex.** It is the
extended alternating Čech complex of the base-changed localization system
`S ↦ 𝒪_{f_S} ⊗_𝒪 𝒪_h`. This is
`Stacks.Sheaves.CechFlatNeighbourhood.tensorExtendedAlternatingCechIso`, whose flatness
hypothesis is `isFlat_awayModule`. -/
def tensorAwayExtendedAlternatingCechIso :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
      (awayModule X h))).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj (extendedAlternatingCech X f) ≅
      AlternatingCech.complex (awayLocalizationFunctor X f ⋙
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
          (awayModule X h))) :=
  @tensorExtendedAlternatingCechIso X.C _ X.J _ _ _ _ X.O r f (awaySheaf h) (toAwaySheaf h)
    (isFlat_awayModule X h).1

/-- **The Čech complex becomes contractible after inverting one of its sections.** If `f_j`
becomes a unit in `𝒪_h` then `Č(f) ⊗_𝒪 𝒪_h` is a zero object of `D(𝒪)`: it is the extended
alternating Čech complex of a system whose transitions adjoining `j` are invertible, and such a
complex carries a contracting homotopy. -/
theorem isZero_Q_tensorAwayModule_extendedAlternatingCech_of_isUnit (j : Fin r)
    (hj : ∀ U : X.Cᵒᵖ,
      IsUnit (((toAwaySheaf h).hom.app U).hom (globalSectionVal (f j) U))) :
    IsZero (DerivedCategory.Q.obj
      (((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
        (awayModule X h))).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj (extendedAlternatingCech X f))) := by
  have hz : IsZero (DerivedCategory.Q.obj (AlternatingCech.complex
      (awayLocalizationFunctor X f ⋙
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).flip.obj
          (awayModule X h))))) :=
    AlternatingCech.isZero_Q_complex _ j
      fun hST hTS => isIso_tensorAwayLocalizationFunctor_map X f h j hj hST hTS
  exact hz.of_iso (DerivedCategory.Q.mapIso (tensorAwayExtendedAlternatingCechIso X f h))

/-- **The completion of any object is in the vanishing locus of a section which makes one of the
generators invertible.** For every `K`, `R𝑆heafHom_𝒪(𝒪_h, K^∧) = 0` as soon as some `f_j` becomes
a unit in `𝒪_h`.

This is the first step of the source's proof of clause 1: currying
(`isZero_derivedSheafHom_completionFunctor_of_isZero_tensor`) turns the vanishing of
`𝒪_h[0] ⊗^𝐋_𝒪 Č(f)` into the vanishing of `R𝑆heafHom_𝒪(𝒪_h, K^∧)`, and the derived tensor
product is computed by `derivedTensorSingleAwayModuleIso` after the two factors are exchanged by
the commutativity constraint of [Stacks, Tag 0FPT]. -/
theorem memVanishingIdeal_completionFunctor_of_isUnit (j : Fin r)
    (hj : ∀ U : X.Cᵒᵖ,
      IsUnit (((toAwaySheaf h).hom.app U).hom (globalSectionVal (f j) U)))
    (K : DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.O))) :
    MemVanishingIdeal X ((completionFunctor X f).obj K) h := by
  have h1 : IsZero (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
      (DerivedCategory.Q.obj (extendedAlternatingCech X f))).obj (derivedAwayModule X h)) :=
    (isZero_Q_tensorAwayModule_extendedAlternatingCech_of_isUnit X f h j hj).of_iso
      (derivedTensorSingleAwayModuleIso X h (extendedAlternatingCech X f))
  have h2 : IsZero (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
      (derivedAwayModule X h)).obj (DerivedCategory.Q.obj (extendedAlternatingCech X f))) :=
    h1.of_iso ((derivedTensorProductDatumOfSite X
      (Stacks.SheafOfModules.canonicalDerivedTensorProduct X)).braidingIso X _ _)
  exact isZero_derivedSheafHom_completionFunctor_of_isZero_tensor X f
    (derivedAwayModule X h) K h2

variable (L : DerivedCategory
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.O)))

/-- **Every non-empty subproduct of the generators lies in the vanishing locus of a completion**:
`R𝑆heafHom_𝒪(𝒪_{f_S}, K^∧) = 0` for every `K` and every non-empty `S`, with no hypothesis.
Choosing `j ∈ S`, the section `f_j` divides `f_S` and so becomes a unit in `𝒪_{f_S}`
(`isUnit_toAwaySheaf_prodGlobalSection_of_subset`). -/
theorem memVanishingIdeal_prodGlobalSection_completionFunctor (S : Finset (Fin r))
    (hS : S.Nonempty) :
    MemVanishingIdeal X ((completionFunctor X f).obj L) (prodGlobalSection f S) := by
  obtain ⟨j, hjS⟩ := hS
  refine memVanishingIdeal_completionFunctor_of_isUnit X f (prodGlobalSection f S) j
    (fun U => ?_) L
  have hu := isUnit_toAwaySheaf_prodGlobalSection_of_subset f
    (Finset.singleton_subset_iff.2 hjS) U 1
  simpa using hu

/-- **Clause 1 of [Stacks, Tag 099B]: every completion is derived complete along the ideal sheaf
generated by `f_1, …, f_r`**, with no hypothesis on `K`.

`AlgebraicGeometry.RingedSite.isDerivedComplete_idealOfGlobalSections` reduces the predicate of
[Stacks, Tag 0999] to the generators, so what has to be produced is `T((K^∧)|_V, f_i|_V) = 0`
for every object `V` and every `i`. The global statement
`memVanishingIdeal_prodGlobalSection_completionFunctor` at the singleton `S = {i}` gives
`R𝑆heafHom_𝒪(𝒪_{f_i}, K^∧) = 0`, which the equivalence of conditions (1) and (3) of
[Stacks, Tag 0997] (`memVanishingIdeal_iff_isDerivedCompleteAt`) turns into the Milnor condition
for `K^∧` itself at the *global* scalar given by `f_i`; and
`isDerivedCompleteAtSection_of_isDerivedCompleteAt` of `CompleteGlobalSection.lean` restricts
that condition to every slice, derived restriction being additive, product-preserving and
compatible with the two spellings of the scalar.

So neither an identification `Č(f)|_V ≅ Č(f|_V)` nor [Stacks, Tag 08JB] is needed: the Milnor
condition descends from the site to its slices for free, and only the ascent — which is
`isDerivedCompleteAt_of_forall_isDerivedCompleteAtSection`, and is what clause 2 consumes —
needs the locality of invertibility in `D(𝒪)`. -/
theorem isDerivedComplete_completionFunctor :
    IsDerivedComplete.{u, u, u, u} X (idealOfGlobalSections X f)
      ((completionFunctor X f).obj L) := by
  refine isDerivedComplete_idealOfGlobalSections X f _ fun i V => ?_
  have hsec := isDerivedCompleteAtSection_of_isDerivedCompleteAt X
    ((completionFunctor X f).obj L) (prodGlobalSection f {i})
    ((memVanishingIdeal_iff_isDerivedCompleteAt X (prodGlobalSection f {i})
        ((completionFunctor X f).obj L)).1
      (memVanishingIdeal_prodGlobalSection_completionFunctor X f L {i}
        (Finset.singleton_nonempty i))) V.unop
  rwa [globalSectionVal_prodGlobalSection, Finset.prod_singleton] at hsec

/-- **The completion map is invertible at a completion.** This is clause 2 of
`Completion.lean`'s "What remains for Tag 099B" read at `K^∧`, where its hypothesis is
`memVanishingIdeal_prodGlobalSection_completionFunctor` and so costs nothing: no derived
completeness of anything is used. -/
theorem isIso_completionUnit_app_completionFunctor_obj :
    IsIso ((completionUnit X f).app ((completionFunctor X f).obj L)) :=
  isIso_completionUnit_app_of_forall_memVanishingIdeal X f ((completionFunctor X f).obj L)
    (memVanishingIdeal_prodGlobalSection_completionFunctor X f L)

/-- **The completion of the derived internal Hom out of the kernel of the augmentation
vanishes**: `Φ(R𝑆heafHom_𝒪(Č(f)^{≥1}, K)) = 0`.

Currying twice moves `Č(f)` across the tensor product,
`R𝑆heafHom(Č, R𝑆heafHom(Č^{≥1}, K)) ≅ R𝑆heafHom(Č ⊗^𝐋 Č^{≥1}, K)` and
`R𝑆heafHom(Č^{≥1}, R𝑆heafHom(Č, K)) ≅ R𝑆heafHom(Č^{≥1} ⊗^𝐋 Č, K)`, and the commutativity
constraint of [Stacks, Tag 0FPT] identifies the two tensor products; the right-hand side is
`R𝑆heafHom(Č^{≥1}, K^∧)`, which vanishes by `isZero_derivedSheafHom_stupidTruncGE_one` at
`K^∧`. -/
theorem isZero_completionFunctor_derivedSheafHom_stupidTruncGE_one :
    IsZero ((completionFunctor X f).obj
      (((derivedSheafHomBifunctor X).obj (op (DerivedCategory.Q.obj
        ((extendedAlternatingCech X f).stupidTrunc (embeddingUpIntGE 1))))).obj L)) := by
  set A := DerivedCategory.Q.obj
    ((extendedAlternatingCech X f).stupidTrunc (embeddingUpIntGE 1)) with hA
  set C := DerivedCategory.Q.obj (extendedAlternatingCech X f) with hC
  have h0 : IsZero (((derivedSheafHomBifunctor X).obj (op A)).obj
      ((completionFunctor X f).obj L)) :=
    isZero_derivedSheafHom_stupidTruncGE_one X f ((completionFunctor X f).obj L)
      (memVanishingIdeal_prodGlobalSection_completionFunctor X f L)
  refine h0.of_iso (derivedCurryIso X C A L ≪≫ ?_ ≪≫ (derivedCurryIso X A C L).symm)
  exact ((derivedSheafHomBifunctor X).flip.obj L).mapIso
    ((derivedTensorProductDatumOfSite X
      (Stacks.SheafOfModules.canonicalDerivedTensorProduct X)).braidingIso X A C).op

/-- **The completion functor carries the map induced by the augmentation to an isomorphism.**

The derived internal Hom into `L` of the filtration triangle
`Č(f)^{≥1} ⟶ Č(f)^{≥0} ⟶ Č(f)⁰[0]` is distinguished by the contravariant half of
[Stacks, Tag 08JC]; pushing *that* triangle through `Φ`, by the covariant half, gives a
distinguished triangle whose third vertex is `Φ(R𝑆heafHom(Č^{≥1}, L)) = 0`, so the map `Φ`
