theorem isRightAdjoint_ι_isDerivedComplete_idealOfGlobalSections_of_isDerivedComplete
    (hΦ : ∀ K, IsDerivedComplete.{u, u, u, u} X (idealOfGlobalSections X f)
      ((completionFunctor X f).obj K)) :
    (ObjectProperty.ι
      (IsDerivedComplete.{u, u, u, u} X (idealOfGlobalSections X f))).IsRightAdjoint :=
  isRightAdjoint_ι_isDerivedComplete_of_isDerivedComplete_completion X f
    (idealOfGlobalSections X f)
    (fun i U => globalSectionVal_mem_idealOfGlobalSections X f i (op U)) hΦ

/-- **Clause 3 of [Stacks, Tag 099B] for `ℐ = (f_1, …, f_r)`, unconditionally**: `Φ η_K = η_{Φ K}`
