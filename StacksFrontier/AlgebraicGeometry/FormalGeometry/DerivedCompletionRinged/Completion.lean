@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}] {r : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

/-- The term of the extended alternating Čech complex in degree `p` is zero when there is no
subset of `Fin r` of cardinality `p`, being then an empty product. -/
private theorem isZero_extendedAlternatingCech_X_of_isEmpty {p : ℤ}
    (h : IsEmpty (AlternatingCech.Idx r p)) : IsZero ((extendedAlternatingCech X f).X p) := by
  rw [IsZero.iff_id_eq_zero]
  exact Pi.hom_ext _ _ fun b ↦ h.elim b

/-- **The extended alternating Čech complex vanishes in negative degrees**: there is no subset
of `Fin r` of negative cardinality, so the term there is an empty product. -/
theorem isZero_extendedAlternatingCech_X_of_neg {p : ℤ} (hp : p < 0) :
    IsZero ((extendedAlternatingCech X f).X p) :=
  isZero_extendedAlternatingCech_X_of_isEmpty X f (AlternatingCech.isEmpty_idx_of_neg hp)

/-- **The extended alternating Čech complex vanishes above degree `r`**: there is no subset of
`Fin r` of cardinality greater than `r`, so the term there is an empty product. -/
theorem isZero_extendedAlternatingCech_X_of_lt {p : ℤ} (hp : (r : ℤ) < p) :
    IsZero ((extendedAlternatingCech X f).X p) :=
  isZero_extendedAlternatingCech_X_of_isEmpty X f (AlternatingCech.isEmpty_idx_of_lt hp)

/-- The identification of the degree-zero term of the extended alternating Čech complex with
`𝒪`: the projection onto its unique factor `𝒪_{f_∅}`, followed by the inverse of the
isomorphism `𝒪 ≅ 𝒪_{f_∅}` which inverting `f_∅ = 1` gives. -/
def cechAugmentationZero :
    (extendedAlternatingCech X f).X 0 ⟶
      SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O) :=
  Pi.π (fun S : AlternatingCech.Idx r 0 => awayModule X (prodGlobalSection f S.1)) default ≫
    (unitIsoAwayModuleEmpty X f).inv

/-- **The augmentation of the extended alternating Čech complex**, as a map of complexes
`Č(f) ⟶ 𝒪[0]`: the identification of the degree-zero term with `𝒪` in degree zero and zero
elsewhere. This is the map derived internal Hom into `K` turns into `K ⟶ K^∧`. -/
def cechAugmentation : extendedAlternatingCech X f ⟶ structureSheafComplex X :=
  HomologicalComplex.mkHomToSingle (cechAugmentationZero X f) fun i hi ↦ by
    obtain rfl : i = -1 := by
      have : i + 1 = 0 := hi
      omega
    exact (isZero_extendedAlternatingCech_X_of_neg X f (by norm_num)).eq_of_src _ 0

/-- In degree zero the augmentation is the identification of the degree-zero term with `𝒪`. -/
theorem cechAugmentation_f_zero :
    (cechAugmentation X f).f 0 =
      cechAugmentationZero X f ≫
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) (0 : ℤ)
          (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O))).inv :=
  HomologicalComplex.mkHomToSingle_f _ _

section Derived

attribute [local instance] HasDerivedCategory.standard

/-- **The completion functor of a finite family of global sections**: the endofunctor
`K ↦ K^∧ = R𝑆heafHom_𝒪(Č(f), K)` of `D(𝒪)` of [Stacks, Tag 099B], derived internal Hom out of
the extended alternating Čech complex of `f_1, …, f_r`. -/
def completionFunctor :
    DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ⥤
      DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) :=
  (derivedSheafHomBifunctor X).obj
    (op (DerivedCategory.Q.obj (extendedAlternatingCech X f)))

/-- **The completion map `K ⟶ K^∧`**, naturally in `K`: the identification
`K = R𝑆heafHom_𝒪(𝒪, K)` followed by the map which the augmentation `Č(f) ⟶ 𝒪` induces on
derived internal Hom into `K`. -/
def completionUnit :
    𝟭 (DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) ⟶
      completionFunctor X f :=
  (derivedStructureSheafHomNatIso X).inv ≫
    (derivedSheafHomBifunctor X).map (DerivedCategory.Q.map (cechAugmentation X f)).op

/-- The completion map at an object of `D(𝒪)`. -/
theorem completionUnit_app
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    (completionUnit X f).app K =
      (derivedStructureSheafHomIso X K).inv ≫
        ((derivedSheafHomBifunctor X).map
          (DerivedCategory.Q.map (cechAugmentation X f)).op).app K :=
  rfl

/-! ### The dévissage of the Čech complex, and invertibility of the completion map -/

/-- **Vanishing of the derived internal Hom into `K` out of a sheaf placed in degree `i` does
not depend on `i`.** The single functors of the derived category are compatible with the shift,
and that vanishing is shift-stable in its contravariant variable by
`AlgebraicGeometry.RingedSite.isZero_derivedSheafHom_shift_iff`, which needs no
`CategoryTheory.Functor.CommShift` for the derived internal Hom. -/
theorem isZero_derivedSheafHom_single_iff_single_zero
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) (i : ℤ)
    (M : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) :
    IsZero (((derivedSheafHomBifunctor X).obj
        (op ((DerivedCategory.singleFunctor
          (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) i).obj M))).obj K) ↔
      IsZero (((derivedSheafHomBifunctor X).obj
          (op ((DerivedCategory.singleFunctor
            (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 0).obj M))).obj
        K) := by
  refine Iff.trans ?_ (isZero_derivedSheafHom_iff_of_iso X K
    (((DerivedCategory.singleFunctors
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))).shiftIso i 0 i
      (add_zero i)).app M))
  exact (isZero_derivedSheafHom_shift_iff X K _ i).symm

/-- **The derived internal Hom into `K` out of a positive-degree term of the Čech complex
vanishes**, granted that it vanishes out of every `𝒪_{f_S}` with `S` non-empty. The degree-`i`
term is the product of the sheaves `𝒪_{f_S}` over the subsets `S` of cardinality `i` — a finite
index type, which is what `AlgebraicGeometry.RingedSite.isZero_derivedSheafHom_single_pi`
handles — and for `1 ≤ i` every such `S` is non-empty. -/
theorem isZero_derivedSheafHom_extendedAlternatingCech_X_single
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hK : ∀ S : Finset (Fin r), S.Nonempty → MemVanishingIdeal X K (prodGlobalSection f S))
    {i : ℤ} (hi : 1 ≤ i) :
    IsZero (((derivedSheafHomBifunctor X).obj
      (op ((DerivedCategory.singleFunctor
          (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) i).obj
        ((extendedAlternatingCech X f).X i)))).obj K) := by
  refine isZero_derivedSheafHom_single_pi X K i
    (fun S : AlternatingCech.Idx r i => awayModule X (prodGlobalSection f S.1)) fun S ↦ ?_
  refine (isZero_derivedSheafHom_single_iff_single_zero X K i _).mpr ?_
  refine hK S.1 (Finset.card_pos.mp ?_)
  have hcard := S.2
  omega

/-- **The derived internal Hom into `K` out of the kernel of the Čech augmentation vanishes**,
granted that it vanishes out of every `𝒪_{f_S}` with `S` non-empty.

The kernel is the brutal truncation `Č(f)^{≥1}`, and the stupid filtration reaches it from the
zero complex in finitely many extension steps because `Č(f)` is bounded: it vanishes outside
the degrees `0, …, r`. Each step is the vanishing on the middle vertex of a
distinguished triangle whose outer vertices it is known on,
`AlgebraicGeometry.RingedSite.isZero_derivedSheafHom_obj₂_of_distTriang`, and the terms are
handled by `isZero_derivedSheafHom_extendedAlternatingCech_X_single`. -/
theorem isZero_derivedSheafHom_stupidTruncGE_extendedAlternatingCech
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hK : ∀ S : Finset (Fin r), S.Nonempty → MemVanishingIdeal X K (prodGlobalSection f S)) :
    IsZero (((derivedSheafHomBifunctor X).obj
      (op (DerivedCategory.Q.obj ((extendedAlternatingCech X f).stupidTrunc
        (ComplexShape.embeddingUpIntGE (1 : ℤ)))))).obj K) :=
  Stacks.DerivedCategory.BoundedInduction.property_of_bounded_complex_stupidTruncGE
    (fun L ↦ IsZero (((derivedSheafHomBifunctor X).obj (op L)).obj K))
    (fun e hL ↦ (isZero_derivedSheafHom_iff_of_iso X K e).mp hL)
    (fun _ hL ↦ Functor.map_isZero ((derivedSheafHomBifunctor X).flip.obj K) hL.op)
    (fun T hT h₁ h₃ ↦ isZero_derivedSheafHom_obj₂_of_distTriang X K T hT h₁ h₃)
    (extendedAlternatingCech X f)
    (by
      refine Set.Finite.subset (Set.finite_Icc (0 : ℤ) r) fun i hi ↦ ?_
      simp only [Set.mem_setOf_eq] at hi
      refine Set.mem_Icc.mpr ⟨by_contra fun h ↦ hi ?_, by_contra fun h ↦ hi ?_⟩
      · exact isZero_extendedAlternatingCech_X_of_neg X f (by omega)
      · exact isZero_extendedAlternatingCech_X_of_lt X f (by omega)) 1
    (fun _ hi ↦ isZero_derivedSheafHom_extendedAlternatingCech_X_single X f K hK hi)

/-- **[Stacks, Tag 099F] for the ideal sheaf generated by `f_1, …, f_r`, reduced to the three
remaining properties of the completion functor.** If every completion `K^∧` is derived complete
along `ℐ`, if `K ⟶ K^∧` is invertible whenever `K` is derived complete, and if the completion
functor carries `K ⟶ K^∧` to `K^∧ ⟶ (K^∧)^∧`, then the inclusion of the derived-complete
objects into `D(𝒪)` has a left adjoint. -/
theorem isRightAdjoint_ι_isDerivedComplete_of_completion
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (hΦ : ∀ K, IsDerivedComplete.{u, u, u, u} X I ((completionFunctor X f).obj K))
    (hη : ∀ K, IsDerivedComplete.{u, u, u, u} X I K → IsIso ((completionUnit X f).app K))
    (hcomm : ∀ K, (completionFunctor X f).map ((completionUnit X f).app K) =
      (completionUnit X f).app ((completionFunctor X f).obj K)) :
    (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I)).IsRightAdjoint :=
  isRightAdjoint_ι_isDerivedComplete_of_completionFunctor X I (completionUnit X f) hΦ hη hcomm

end Derived

end AlgebraicGeometry.RingedSite

