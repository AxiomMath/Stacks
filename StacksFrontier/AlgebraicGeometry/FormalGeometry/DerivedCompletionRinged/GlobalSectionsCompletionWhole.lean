namespace CategoryTheory.ObjectProperty

/-- **The universal property of a reflector onto a class of objects.** If `L` is left adjoint to
the inclusion of the objects satisfying `P`, then for `E` satisfying `P` precomposition with the
unit `Z ⟶ L Z` is a bijection from the morphisms `L Z ⟶ E` to the morphisms `Z ⟶ E`.

This is the hom-set bijection of the adjunction with the inclusion evaluated away, using that
the inclusion is fully faithful. It is the shape in which
`CategoryTheory.ObjectProperty.isoOfReflection` compares two reflections. -/
theorem bijective_precomp_adjunction_unit {C : Type u} [Category.{v} C] (P : ObjectProperty C)
    {L : C ⥤ P.FullSubcategory} (adj : L ⊣ P.ι) (Z E : C) (hE : P E) :
    Function.Bijective (fun g : (L ⋙ P.ι).obj Z ⟶ E ↦ adj.unit.app Z ≫ g) := by
  have ff := P.fullyFaithfulι
  refine ⟨fun g g' hgg' ↦ ?_, fun φ ↦ ?_⟩
  · have e1 : P.ι.map (ff.preimage (X := L.obj Z) (Y := ⟨E, hE⟩) g) = g := ff.map_preimage _
    have e2 : P.ι.map (ff.preimage (X := L.obj Z) (Y := ⟨E, hE⟩) g') = g' := ff.map_preimage _
    have key : adj.homEquiv Z ⟨E, hE⟩ (ff.preimage (X := L.obj Z) (Y := ⟨E, hE⟩) g) =
        adj.homEquiv Z ⟨E, hE⟩ (ff.preimage (X := L.obj Z) (Y := ⟨E, hE⟩) g') := by
      rw [adj.homEquiv_unit, adj.homEquiv_unit, e1, e2]
      exact hgg'
    rw [← e1, ← e2, (adj.homEquiv Z ⟨E, hE⟩).injective key]
  · refine ⟨P.ι.map ((adj.homEquiv Z ⟨E, hE⟩).symm φ), ?_⟩
    exact (adj.homEquiv_unit Z ⟨E, hE⟩ _).symm.trans
      ((adj.homEquiv Z ⟨E, hE⟩).apply_symm_apply φ)

end CategoryTheory.ObjectProperty

