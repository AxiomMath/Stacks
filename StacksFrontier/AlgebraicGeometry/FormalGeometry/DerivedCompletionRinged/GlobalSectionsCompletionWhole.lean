section BoundedBelow

variable (X : RingedSite.{u, u, u}) (A : Type u) [CommRing A]
  (ρ : A →+* RingCat.sectionsSubring ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj)

/-- A complex bounded below by `b` has an injective resolution which is K-injective and on which
the unbounded derived unit and the localization of `R.ι` are invertible. -/
private theorem exists_injectiveResolution_isIso_derivedUnit
    (K : CochainComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) ℤ)
    (b : ℤ) [K.IsGE b] :
    ∃ R : K.InjectiveResolution, R.cocomplex.IsStrictlyGE b ∧ R.cocomplex.IsKInjective ∧
      IsIso ((moduleGlobalSectionsDerivedUnit X A ρ).app R.cocomplex) ∧
      IsIso (DerivedCategory.Q.map R.ι) := by
  obtain ⟨R, -, hRGE⟩ := CochainComplex.exists_injectiveResolution_isStrictlyGE b K
  have _ := hRGE
  have _ : R.cocomplex.IsKInjective := CochainComplex.isKInjective_of_injective R.cocomplex b
  exact ⟨R, hRGE, inferInstance,
    isIso_moduleGlobalSectionsDerivedUnit_app X A ρ R.cocomplex inferInstance,
    (DerivedCategory.isIso_Q_map_iff_quasiIso _ _).2 inferInstance⟩

/-- **The bounded below and the unbounded derived global sections agree on a bounded below
complex.** For `K` a bounded below cochain complex of `𝒪`-modules, the image in `D(A)` of
`RΓ(𝒞, -) : D⁺(𝒪) ⥤ D⁺(A)` at `K` is `RΓ(𝒞, -) : D(𝒪) ⥤ D(A)` at `K`.

Both functors are right derived functors of `Γ(𝒞, -)`, so both are computed by applying
`Γ(𝒞, -)` degreewise to a bounded below complex of injectives: for the bounded below one this is
`CategoryTheory.Functor.isIso_totalRightDerivedUnit_app_of_rightAcyclic`, an injective object
being right acyclic by `CategoryTheory.Functor.rightAcyclic_of_injective`, and for the unbounded
one `AlgebraicGeometry.RingedSite.isIso_moduleGlobalSectionsDerivedUnit_app`, a bounded below
complex of injectives being K-injective by `CochainComplex.isKInjective_of_injective`. Such a
resolution exists by [Stacks, Tag 013K],
`CochainComplex.exists_injectiveResolution_isStrictlyGE`.

The isomorphism is a `Nonempty`: it depends on the chosen resolution. -/
theorem nonempty_iso_derivedGlobalSectionsOverUnbounded_of_plus
    (K : CochainComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) ℤ)
    (hK : CochainComplex.plus
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) K) :
    Nonempty (DerivedCategory.Plus.ι.obj ((derivedGlobalSectionsOver X A ρ).obj
        (DerivedCategory.Plus.Q.obj ⟨K, hK⟩)) ≅
      (derivedGlobalSectionsOverUnbounded X A ρ).obj (DerivedCategory.Q.obj K)) := by
  obtain ⟨b, _⟩ := (CochainComplex.plus_iff
    (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) K).1 hK
  obtain ⟨R, hRGE, hKI, hunb, hQ⟩ := exists_injectiveResolution_isIso_derivedUnit X A ρ K b
  have hplusUnit : IsIso ((moduleGlobalSectionsOver X A ρ).rightDerivedFunctorPlusUnith.app
      ((HomotopyCategory.Plus.quotient
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))).obj
        ⟨R.cocomplex, R.boundedBelow⟩)) := inferInstance
  have _ := hplusUnit
  have hmap : IsIso ((moduleGlobalSectionsOver X A ρ).mapHomologicalComplexDerivedUnit
      R.boundedBelow) := by
    dsimp only [Functor.mapHomologicalComplexDerivedUnit]
    infer_instance
  have hQh : IsIso (DerivedCategory.Plus.Qh.map
      (HomotopyCategory.Plus.quotientHomMk hK R.boundedBelow R.ι)) :=
    Localization.inverts DerivedCategory.Plus.Qh
      (HomotopyCategory.Plus.quasiIso
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) _
      ((HomotopyCategory.quotient_map_mem_quasiIso_iff _).2 (by
        change QuasiIso R.ι
        infer_instance))
  exact ⟨(derivedGlobalSectionsOver X A ρ ⋙ DerivedCategory.Plus.ι).mapIso
      (((DerivedCategory.Plus.quotientCompQhIso
          (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))).app ⟨K, hK⟩).symm ≪≫
        asIso (DerivedCategory.Plus.Qh.map
          (HomotopyCategory.Plus.quotientHomMk hK R.boundedBelow R.ι))) ≪≫
    (asIso ((moduleGlobalSectionsOver X A ρ).mapHomologicalComplexDerivedUnit
      R.boundedBelow)).symm ≪≫
    asIso ((moduleGlobalSectionsDerivedUnit X A ρ).app R.cocomplex) ≪≫
    (derivedGlobalSectionsOverUnbounded X A ρ).mapIso (asIso (DerivedCategory.Q.map R.ι)).symm⟩

/-- **The cohomology of the site is the cohomology of the unbounded `RΓ(𝒞, -)`**:
`H^j(𝒞, ℱ) ≅ H^j(RΓ(𝒞, ℱ[0]))`, with `H^j(𝒞, -) = R^jΓ(𝒞, -)` the bounded below construction of
[Stacks, Tag 015A] on the left and the unbounded derived global sections on the right.

An injective resolution `I` of `ℱ[0]` computes the bounded below right derived functor, by
`CategoryTheory.Functor.rightDerivedFunctorPlusInjectiveResolutionIso`, and it is K-injective, so
it computes the unbounded one as well. -/
theorem nonempty_iso_siteCohomologyOver_homologyFunctor
    (F : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) (j : ℤ) :
    Nonempty ((siteCohomologyOver X A ρ j).obj F ≅
      (DerivedCategory.homologyFunctor (ModuleCat.{u} A) j).obj
        ((derivedGlobalSectionsOverUnbounded X A ρ).obj
          ((DerivedCategory.singleFunctor
            (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) 0).obj F))) := by
  obtain ⟨R, -, -, hunb, hQ⟩ := exists_injectiveResolution_isIso_derivedUnit X A ρ
    ((CochainComplex.singleFunctor
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) 0).obj F) 0
  exact ⟨(DerivedCategory.homologyFunctor (ModuleCat.{u} A) j).mapIso
    ((moduleGlobalSectionsOver X A ρ).rightDerivedFunctorPlusInjectiveResolutionIso F R ≪≫
      asIso ((moduleGlobalSectionsDerivedUnit X A ρ).app R.cocomplex) ≪≫
      (derivedGlobalSectionsOverUnbounded X A ρ).mapIso
        ((asIso (DerivedCategory.Q.map R.ι)).symm ≪≫
          ((DerivedCategory.singleFunctorIsoCompQ
            (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) 0).app F).symm))⟩

end BoundedBelow

