@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry
open Stacks.Cohomology.DerivedPullbackPushforwardAdjunction

universe u

namespace CategoryTheory.Adjunction

/-- For an adjunction `F ⊣ G`, the round trip `g ↦ F g ≫ ε_Y ↦ η_X ≫ G (-)` is the identity:
this is `Equiv.apply_symm_apply` for `CategoryTheory.Adjunction.homEquiv`, written out so that it
applies without unfolding the hom-set equivalence. -/
theorem unit_comp_map_comp_counit {C : Type*} [Category C] {D : Type*} [Category D]
    {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G) {A : C} {B : D} (g : A ⟶ G.obj B) :
    adj.unit.app A ≫ G.map (F.map g ≫ adj.counit.app B) = g := by
  simp

end CategoryTheory.Adjunction

namespace AlgebraicGeometry.RingedSite

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

variable {X Y : RingedSite.{u, u, u}}

/-- **[Stacks, Tag 06YY] for a morphism of ringed sites.** Degreewise pullback on the homotopy
category has a left derived functor, so `Lf^*` exists. This is [Stacks, Tag 05VD] fed into
`pullbackOnHomotopy_hasLeftDerivedFunctor_of_flatPullback`; it is made a local instance below,
because `Lf^*` carries it as an instance argument. -/
theorem hasLeftDerivedFunctor_pullbackOnHomotopy (f : RingedSite.Hom X Y) :
    (pullbackOnHomotopy f.toRingedToposSiteHom).HasLeftDerivedFunctor
      (HomotopyCategory.quasiIso (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))
        (ComplexShape.up ℤ)) :=
  pullbackOnHomotopy_hasLeftDerivedFunctor_of_flatPullback f.toRingedToposSiteHom
    f.isMorphismOfSites
    (AlgebraicGeometry.RingedToposSiteHom.pullbackPreservesIsFlatUniv.{u})

attribute [local instance] hasLeftDerivedFunctor_pullbackOnHomotopy

/-- **[Stacks, Tag 07A6] for a morphism of ringed sites.** `Lf^*` is left adjoint to `Rf_*` on
the unbounded derived categories of sheaves of modules. -/
def derivedPullbackPushforwardAdjunction (f : RingedSite.Hom X Y) :
    derivedPullback.{u} f.toRingedToposSiteHom ⊣
      derivedPushforward.{u} f.toRingedToposSiteHom :=
  derivedPullbackPushforwardAdjunctionOfFlatPullback f.toRingedToposSiteHom
    f.isMorphismOfSites
    (AlgebraicGeometry.RingedToposSiteHom.pullbackPreservesIsFlatUniv.{u})

variable (f : RingedSite.Hom X Y)
  (I : SheafOfModules.Submodule (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)))
  (I' : SheafOfModules.Submodule (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))

/-- The hypothesis of [Stacks, Tag 099J]: `f^♯` carries `f^{-1}ℐ` into `ℐ'`, spelled as the
condition that `f^♯(s)` is a section of `ℐ'` over `u(W)` whenever `s` is a section of `ℐ` over
`W`. -/
abbrev PushforwardIdealCompatible : Prop :=
  ∀ (W : Y.C) (s : (Stacks.SheafOfModules.Tensor.ringSheaf Y.O).obj.obj (op W)),
    s ∈ I.toSubmodule.obj (op W) →
      fSharpSection f W s ∈ I'.toSubmodule.obj (op (f.u.obj W))

section Restricted

variable (hI : PushforwardIdealCompatible f I I')

/-- **The first statement of [Stacks, Tag 099K], for a morphism of ringed sites.** `Rf_*` as a
functor `D_comp(𝒪', ℐ') ⥤ D_comp(𝒪, ℐ)`: the derived direct image of a derived-complete object is
derived complete, by [Stacks, Tag 099J]. The tag is registered for a morphism of ringed topoi, on
`AlgebraicGeometry.RingedToposHom.isDerivedComplete_derivedPushforward`.

This is also part (1) of [Stacks, Tag 099N], stated for an arbitrary ringed site rather than for
the constant Noetherian coefficients `(𝒞, Λ)` of that tag. The identification of `D(𝒞, Λ)` with
`D(𝒪)` for the constant sheaf of rings `Λ` is not formalized in this library, so what is proved
is the statement at a generality containing the source's, not a composite with that
identification. -/
@[stacks 099N "part (1), for an arbitrary ringed site in place of the source's constant
  Noetherian coefficients `(𝒞, Λ)`"]
def derivedCompletePushforward :
    ObjectProperty.FullSubcategory (IsDerivedComplete.{u, u, u, u} X I') ⥤
      ObjectProperty.FullSubcategory (IsDerivedComplete.{u, u, u, u} Y I) :=
  ObjectProperty.lift _
    (ObjectProperty.ι _ ⋙ derivedPushforward.{u} f.toRingedToposSiteHom)
    (fun K ↦ derivedPushforward_isDerivedComplete f I I' hI K.1 K.2)

variable [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I')).IsRightAdjoint]

/-- **The left adjoint of [Stacks, Tag 099K], for a reflective `D_comp(𝒪', ℐ')`.** `Lf^*_comp`,
that is `Lf^*` followed by derived completion, as a functor `D_comp(𝒪, ℐ) ⥤ D_comp(𝒪', ℐ')`.

The source reaches the derived completion functor from "`ℐ'` of finite type" through
[Stacks, Tag 099F]. What this construction consumes is that conclusion alone — that the
inclusion of the derived-complete objects has a left adjoint — so that is what the statement
asks for; for an `ℐ'` of finite type the instance of [Stacks, Tag 099F],
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete`, supplies it. This is also
part (2) of [Stacks, Tag 099N], at the generality of part (1). -/
@[stacks 099N "part (2), the functor `Lf^*_comp`, for an arbitrary ringed site in place of the
  source's constant Noetherian coefficients, and for every `ℐ'` whose derived-complete objects
  are reflective in `D(𝒪')` — which [Stacks, Tag 099F] gives for an ideal sheaf of finite
  type"]
def derivedCompletePullback :
    ObjectProperty.FullSubcategory (IsDerivedComplete.{u, u, u, u} Y I) ⥤
      ObjectProperty.FullSubcategory (IsDerivedComplete.{u, u, u, u} X I') :=
  ObjectProperty.ι _ ⋙ derivedPullback.{u} f.toRingedToposSiteHom ⋙
    (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I')).leftAdjoint

/-- **The adjunction of [Stacks, Tag 099K], for a reflective `D_comp(𝒪', ℐ')`.** On the
derived-complete objects, `Lf^*` followed by derived completion is left adjoint to `Rf_*`. This
is the source's chain `Hom(K, Rf_*M) = Hom(Lf^*K, M) = Hom(Lf^*_comp K, M)`: the composite of
the adjunction `Lf^* ⊣ Rf_*` of [Stacks, Tag 07A6] with the reflector adjunction of
[Stacks, Tag 099F], restricted along the fully faithful inclusion of `D_comp(𝒪, ℐ)` into
`D(𝒪)`.

The `@[stacks 099K]` registration of this second statement is on the statement for a morphism
of ringed topoi, `AlgebraicGeometry.RingedToposHom.derivedCompletePullbackPushforwardAdjunction`
of `PushforwardCompletionTopos.lean`.

This is also part (2) of [Stacks, Tag 099N]. Parts (4) and (5) of that tag, the formulas
`Rf_*K = R lim Rf_*(K ⊗^L Λ/Iⁿ)` and `Lf^*_comp M = R lim Lf^*(M ⊗^L Λ/Iⁿ)`, are proved in
`PushforwardAdicLimit.lean` of this directory, as
`AlgebraicGeometry.RingedSite.isDerivedLimit_derivedPushforward_adicReductionTower_of_proIso`
and
`AlgebraicGeometry.RingedSite.isDerivedLimit_adicReductionTower_derivedCompletePullback_of_proIso`;
each carries the single hypothesis of this library's form of [Stacks, Tag 099M], a
pro-isomorphism of the dual Koszul tower with the tower of adic quotients. -/
@[stacks 099N "part (2), the adjunction, at the generality named on `derivedCompletePullback`;
  parts (4) and (5) are in `PushforwardAdicLimit.lean`"]
def derivedCompletePullbackPushforwardAdjunction :
    derivedCompletePullback f I I' ⊣ derivedCompletePushforward f I I' hI :=
  @Adjunction.restrictReflective _ _ _ _ _ _ (derivedPullbackPushforwardAdjunction f) _ _ ‹_›
    (fun K ↦ derivedPushforward_isDerivedComplete f I I' hI K.1 K.2)

end Restricted

section Commutation

variable (hI : PushforwardIdealCompatible f I I')
  [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} X I')).IsRightAdjoint]

include hI in
/-- `Rf_*(K^∧)` is derived complete: `K^∧` is derived complete, and `Rf_*` preserves derived
completeness by [Stacks, Tag 099J]. -/
theorem isDerivedComplete_derivedPushforward_derivedCompletion
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    IsDerivedComplete.{u, u, u, u} Y I
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj
        ((derivedCompletion X I').obj K)) :=
  derivedPushforward_isDerivedComplete f I I' hI _
    (isDerivedComplete_derivedCompletion_obj X I' K)

variable [(ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I)).IsRightAdjoint]

/-- `K ↦ Rf_*(K^∧)`, read as a functor into the derived-complete objects of `D(𝒪)`. -/
def completedPushforwardOfDerivedCompletion :
    DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ⥤
      ObjectProperty.FullSubcategory (IsDerivedComplete.{u, u, u, u} Y I) :=
  ObjectProperty.lift _
    (derivedCompletion X I' ⋙ derivedPushforward.{u} f.toRingedToposSiteHom)
    (isDerivedComplete_derivedPushforward_derivedCompletion f I I' hI)

/-- The natural map `Rf_*K ⟶ Rf_*(K^∧)`, that is `Rf_*` applied to the unit `K ⟶ K^∧` of
derived completion. -/
def pushforwardDerivedCompletionUnit :
    derivedPushforward.{u} f.toRingedToposSiteHom ⟶
      derivedCompletion X I' ⋙ derivedPushforward.{u} f.toRingedToposSiteHom :=
  Functor.whiskerRight (derivedCompletionUnit X I')
    (derivedPushforward.{u} f.toRingedToposSiteHom)

/-- The comparison map of [Stacks, Tag 0A0G] read in the derived-complete objects: the adjunct,
under the reflector adjunction of [Stacks, Tag 099F] on `D(𝒪)`, of the natural map
`Rf_*K ⟶ Rf_*(K^∧)`. -/
def derivedCompletionPushforwardComparisonLift :
    derivedPushforward.{u} f.toRingedToposSiteHom ⋙
        (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I)).leftAdjoint ⟶
      completedPushforwardOfDerivedCompletion f I I' hI :=
  Functor.whiskerRight (pushforwardDerivedCompletionUnit f I')
      (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I)).leftAdjoint ≫
    Functor.whiskerLeft (completedPushforwardOfDerivedCompletion f I I' hI)
      (derivedCompletionAdjunction Y I).counit

/-- **The canonical map `(Rf_*K)^∧ ⟶ Rf_*(K^∧)` of [Stacks, Tag 0A0G].** It exists because
`Rf_*(K^∧)` is derived complete, by [Stacks, Tag 099J], so the universal property of derived
completion applies to `Rf_*K ⟶ Rf_*(K^∧)`. Built as a mate, so that it is natural in `K`.

This is the map the tag asserts to be invertible, and it is invertible at every object of
`D(𝒪')` at the tag's own data — `ℐ` of **finite type** and `ℐ' = f^{-1}ℐ · 𝒪_X` — by
`RingedSite.isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType`
of `PushforwardCommutesCompletionLocalToGlobal.lean`; that statement localizes the globally
generated case,
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf`
of `PushforwardCommutesCompletionCanonical.lean`. Here `ℐ` and `ℐ'` are an arbitrary pair of
sheaves of ideals subject only to `hI`, which is where the construction already makes sense. -/
@[stacks 0A0G "the canonical map `(Rf_*K)^∧ ⟶ Rf_*(K^∧)` whose invertibility the tag asserts,
  constructed as a mate and hence natural in `K`, at an arbitrary pair of sheaves of ideals
  subject only to the relation of [Stacks, Tag 099J] between them. Its invertibility at every
  object of `D(𝒪')`, which is the tag's assertion, is
  `AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType`
  of `PushforwardCommutesCompletionLocalToGlobal.lean`, at the tag's own data: `ℐ` of finite
  type and `ℐ' = f^{-1}ℐ · 𝒪_X`"]
def derivedCompletionPushforwardComparison :
    derivedPushforward.{u} f.toRingedToposSiteHom ⋙ derivedCompletion Y I ⟶
      derivedCompletion X I' ⋙ derivedPushforward.{u} f.toRingedToposSiteHom :=
  Functor.whiskerRight (derivedCompletionPushforwardComparisonLift f I I' hI)
    (ObjectProperty.ι (IsDerivedComplete.{u, u, u, u} Y I))

include hI in
/-- The comparison map is the map the universal property of derived completion produces: it is
the unique map `(Rf_*K)^∧ ⟶ Rf_*(K^∧)` whose composite with the unit `Rf_*K ⟶ (Rf_*K)^∧` is
`Rf_*` applied to the unit `K ⟶ K^∧`. -/
theorem derivedCompletionUnit_comp_derivedCompletionPushforwardComparison
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    (derivedCompletionUnit Y I).app
          ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K) ≫
        (derivedCompletionPushforwardComparison f I I' hI).app K =
      (derivedPushforward.{u} f.toRingedToposSiteHom).map
        ((derivedCompletionUnit X I').app K) :=
  (derivedCompletionAdjunction Y I).unit_comp_map_comp_counit
    (B := (completedPushforwardOfDerivedCompletion f I I' hI).obj K)
    ((pushforwardDerivedCompletionUnit f I').app K)

include hI in
/-- **A criterion for `Rf_*` to commute with derived completion at `K`.** If `Rf_*` applied to
the unit `K ⟶ K^∧` is invertible, then so is the comparison map `(Rf_*K)^∧ ⟶ Rf_*(K^∧)`.

Indeed `Rf_*(K^∧)` is derived complete, so an invertible `Rf_*(K ⟶ K^∧)` makes `Rf_*K` derived
complete too, whence its unit `Rf_*K ⟶ (Rf_*K)^∧` is invertible; and the comparison map is the
second factor of that unit followed by itself in
`derivedCompletionUnit_comp_derivedCompletionPushforwardComparison`. -/
@[stacks 0A0G "the criterion: `Rf_*` commutes with derived completion at every `K` for which
  `Rf_*(K ⟶ K^∧)` is invertible; the source proves it for every `K`"]
theorem isIso_derivedCompletionPushforwardComparison_of_isIso_map_unit
    {K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (hK : IsIso ((derivedPushforward.{u} f.toRingedToposSiteHom).map
      ((derivedCompletionUnit X I').app K))) :
    IsIso ((derivedCompletionPushforwardComparison f I I' hI).app K) := by
  have hcomplete : IsDerivedComplete.{u, u, u, u} Y I
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K) :=
    (isDerivedComplete_iff_of_iso Y I (asIso ((derivedPushforward.{u} f.toRingedToposSiteHom).map
      ((derivedCompletionUnit X I').app K)))).mpr
      (isDerivedComplete_derivedPushforward_derivedCompletion f I I' hI K)
  have hunit : IsIso ((derivedCompletionUnit Y I).app
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) :=
    isIso_derivedCompletionUnit_app Y I hcomplete
  have hcomp : IsIso ((derivedCompletionUnit Y I).app
        ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K) ≫
      (derivedCompletionPushforwardComparison f I I' hI).app K) := by
    rwa [derivedCompletionUnit_comp_derivedCompletionPushforwardComparison f I I' hI K]
  exact IsIso.of_isIso_comp_left ((derivedCompletionUnit Y I).app
    ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) _

include hI in
/-- **[Stacks, Tag 0A0G] at a derived-complete object.** For `K` in `D_comp(𝒪', ℐ')` the
canonical map `(Rf_*K)^∧ ⟶ Rf_*(K^∧)` is invertible, so `Rf_*(K^∧) = Rf_*K = (Rf_*K)^∧`: the
unit `K ⟶ K^∧` is invertible on a derived-complete `K`.

The general case of Tag 0A0G is not proved; see
`isIso_derivedCompletionPushforwardComparison_of_isIso_map_unit` for the criterion that is, and
the module documentation for the state of the four inputs of the source's proof. Three of them
([Stacks, Tags 0A0F, 0A0E, 0A07]) are now available; what is missing is the base case
`K = 𝒪[n]` of the projection formula [Stacks, Tag 0944] on a ringed topos — the dévissage from
it to a strictly perfect complex is available, and takes that case as a hypothesis — together
with the identification of `Lf^*` of a Koszul complex with a Koszul complex. That is also why
part (3) of [Stacks, Tag 099N] is registered here only for a derived-complete object.

This statement also carries [Stacks, Tag 0A0I], Equation 52.7.0.1 `Rf_*(ℱ^∧) = (Rf_*ℱ)^∧`,
which the source justifies by citing Tag 0A0G: what is proved is that ringed-site statement, at
a derived-complete object. The display's own setting — a proper morphism of schemes and a
coherent module, Section 52.7 — is not formalized here. It also carries part (3) of
[Stacks, Tag 099N], with the restrictions named on `derivedCompletePushforward`. -/
@[stacks 0A0I "Equation 52.7.0.1 at the generality of a morphism of ringed sites and for a
  derived-complete object; the display's own setting, Section 52.7, is not formalized here",
  stacks 0A0G "for `K` in `D_comp(𝒪', ℐ')`, where the unit `K ⟶ K^∧` is invertible, at an
  arbitrary pair of sheaves of ideals subject only to the relation of [Stacks, Tag 099J]. The
  tag's assertion for an arbitrary `K` is
  `AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf`
  of `PushforwardCommutesCompletionCanonical.lean`, at the tag's own pair of sheaves of ideals",
  stacks 099N "part (3), for a derived-complete object and an arbitrary ringed site"]
theorem isIso_derivedCompletionPushforwardComparison_of_isDerivedComplete
    {K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (hK : IsDerivedComplete.{u, u, u, u} X I' K) :
    IsIso ((derivedCompletionPushforwardComparison f I I' hI).app K) :=
  isIso_derivedCompletionPushforwardComparison_of_isIso_map_unit f I I' hI
    (@Functor.map_isIso _ _ _ _ _ _ _ _ (isIso_derivedCompletionUnit_app X I' hK))

end Commutation

end AlgebraicGeometry.RingedSite

