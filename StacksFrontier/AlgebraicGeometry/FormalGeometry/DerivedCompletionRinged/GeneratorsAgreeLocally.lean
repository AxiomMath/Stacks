module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.IdealOfGlobalSections
import StacksCore.Tactic.StacksAttribute

/-!
# Two finite families generating the same sheaf of ideals agree on a covering

Let `(𝒞, 𝒪)` be a ringed site and let `f_1, …, f_r` and `g_1, …, g_s` be two finite families of
global sections of `𝒪` generating the *same* sheaf of ideals `ℐ ⊆ 𝒪`. Over a single object `V` the
two ideals `(f_1|_V, …, f_r|_V)` and `(g_1|_V, …, g_s|_V)` of `𝒪(V)` need not agree: a section of
`ℐ` over `V` is only *locally* an `𝒪`-linear combination of the generators. They agree after
passing to a covering: there is a covering sieve `S` of `V` such that
`(f_1|_Y, …, f_r|_Y) = (g_1|_Y, …, g_s|_Y)` as ideals of `𝒪(Y)` for every arrow `Y → V` of `S`.

This is the hint in the proof of [Stacks, Tag 099E]: for finitely generated ideals `I` and `I'` of
`𝒪(U)` both generating `ℐ|_U`, there is a covering `{U_j → U}` with `I𝒪(U_j) = I'𝒪(U_j)`.

## Main results

* `AlgebraicGeometry.RingedSite.exists_mem_sieve_span_le`: if the ideal sheaf generated by
  `g_1, …, g_s` is contained in the one generated by `f_1, …, f_r`, then `(g|_Y) ≤ (f|_Y)` as
  ideals of `𝒪(Y)` along every arrow of some covering sieve.
* `AlgebraicGeometry.RingedSite.exists_mem_sieve_span_eq`: two finite families of global sections
  generating the same sheaf of ideals span the same ideal of sections along every arrow of some
  covering sieve.
* `AlgebraicGeometry.RingedSite.exists_coversTop_span_eq`: the same conclusion along every arrow
  into a member of a family of objects covering the site.

## References

* [Stacks Project, Tag 099D](https://stacks.math.columbia.edu/tag/099D)
* [Stacks Project, Tag 099E](https://stacks.math.columbia.edu/tag/099E)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C]

/-- A finite infimum of covering sieves is a covering sieve. -/
@[sga "3 IV 4.2.1" "T′5 with F representable", sga "4 II 1.1.1"]
theorem finite_iInf_covering (J : GrothendieckTopology C) {V : C} {ι : Type*} [Finite ι]
    (S : ι → Sieve V) (hS : ∀ i, S i ∈ J V) : (⨅ i, S i) ∈ J V := by
  classical
  let _ := Fintype.ofFinite ι
  have h (t : Finset ι) : t.inf S ∈ J V := by
    induction t using Finset.induction_on with
    | empty => simp
    | @insert i t _ ht =>
      rw [Finset.inf_insert]
      exact J.intersection_covering (hS i) ht
  simpa only [Finset.inf_eq_iInf, Finset.mem_univ, iInf_true] using h Finset.univ

end CategoryTheory.GrothendieckTopology

namespace AlgebraicGeometry.RingedSite

section Covering

variable (X : RingedSite.{u, v, w}) {r s : ℕ}
  (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))
  (g : Fin s → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))

/-- If the sheaf of ideals generated by `g_1, …, g_s` is contained in the one generated by
`f_1, …, f_r`, then there is a covering sieve `S` of `V` such that
`(g_1|_Y, …, g_s|_Y) ≤ (f_1|_Y, …, f_r|_Y)` as ideals of `𝒪(Y)` for every arrow `Y → V` of `S`. -/
theorem exists_mem_sieve_span_le
    (h : idealOfGlobalSections X g ≤ idealOfGlobalSections X f) (V : X.C) :
    ∃ S : Sieve V, S ∈ X.J V ∧ ∀ ⦃Y : X.C⦄ (a : Y ⟶ V), S a →
      Ideal.span (Set.range (restrictGlobalSections X g (op Y))) ≤
        Ideal.span (Set.range (restrictGlobalSections X f (op Y))) := by
  classical
  choose S hS hspan using fun j : Fin s =>
    (mem_idealOfGlobalSections_iff X f (op V)).1
      (h (op V) (globalSectionVal_mem_idealOfGlobalSections X g j (op V)))
  refine ⟨⨅ j, S j, X.J.finite_iInf_covering S hS, fun {Y} a ha => Ideal.span_le.2 ?_⟩
  rintro x ⟨j, rfl⟩
  have hmem : (X.O.obj.map a.op).hom (globalSectionVal (g j) (op V)) ∈
      Ideal.span (Set.range (restrictGlobalSections X f (op Y))) :=
    hspan j a (iInf_le S j a ha)
  rwa [globalSectionVal_map (g j) a.op] at hmem

/-- If two finite families `f` and `g` of global sections generate the same sheaf of ideals, then
there is a covering sieve `S` of `V` such that `(f_1|_Y, …, f_r|_Y) = (g_1|_Y, …, g_s|_Y)` as
ideals of `𝒪(Y)` for every arrow `Y → V` of `S`. -/
theorem exists_mem_sieve_span_eq
    (h : idealOfGlobalSections X f = idealOfGlobalSections X g) (V : X.C) :
    ∃ S : Sieve V, S ∈ X.J V ∧ ∀ ⦃Y : X.C⦄ (a : Y ⟶ V), S a →
      Ideal.span (Set.range (restrictGlobalSections X f (op Y))) =
        Ideal.span (Set.range (restrictGlobalSections X g (op Y))) := by
  obtain ⟨S₁, hS₁, h₁⟩ := exists_mem_sieve_span_le X f g h.ge V
  obtain ⟨S₂, hS₂, h₂⟩ := exists_mem_sieve_span_le X g f h.le V
  exact ⟨S₁ ⊓ S₂, X.J.intersection_covering hS₁ hS₂, fun {_Y} a ha =>
    le_antisymm (h₂ a ha.2) (h₁ a ha.1)⟩

/-- If two finite families `f` and `g` of global sections generate the same sheaf of ideals, then
there is a family of objects `V i` covering the site such that
`(f_1|_Y, …, f_r|_Y) = (g_1|_Y, …, g_s|_Y)` as ideals of `𝒪(Y)` for every arrow `Y → V i`. -/
theorem exists_coversTop_span_eq
    (h : idealOfGlobalSections X f = idealOfGlobalSections X g) :
    ∃ (ι : Type (max u v)) (V : ι → X.C), X.J.CoversTop V ∧
      ∀ (i : ι) ⦃Y : X.C⦄ (_ : Y ⟶ V i),
        Ideal.span (Set.range (restrictGlobalSections X f (op Y))) =
          Ideal.span (Set.range (restrictGlobalSections X g (op Y))) := by
  classical
  choose S hS hspan using exists_mem_sieve_span_eq X f g h
  exact ⟨Σ W : X.C, Σ Y : X.C, { a : Y ⟶ W // S W a }, fun i => i.2.1,
    fun W => X.J.superset_covering (fun Y a ha => ⟨⟨W, Y, a, ha⟩, ⟨𝟙 Y⟩⟩) (hS W),
    fun i _Y b => hspan _ (b ≫ i.2.2.1) ((S i.1).downward_closed i.2.2.2 b)⟩

end Covering

end AlgebraicGeometry.RingedSite

end
