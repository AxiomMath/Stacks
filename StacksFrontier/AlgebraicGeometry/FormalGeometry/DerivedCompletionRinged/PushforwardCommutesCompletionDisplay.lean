universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance 100000] HasDerivedCategory.standard
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

variable {X Y : RingedSite.{u, u, u}} (f : RingedSite.Hom X Y)

section Display

variable [HasSheafify X.J AddCommGrpCat.{u}] [HasWeakSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify Y.J AddCommGrpCat.{u}] [HasWeakSheafify Y.J AddCommGrpCat.{u}]
  [Y.J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasSheafify (Y.J.over V) AddCommGrpCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) AddCommGrpCat.{u}]
  [∀ V : Y.C, (Y.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}]
  [∀ (U : X.C) (K₁ K₂ : HomologicalComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (X.over U).O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂
      (Stacks.SheafOfModules.Tensor.sheafTensor (X.over U).O) (ComplexShape.up ℤ)]
  [∀ (V : Y.C) (K₁ K₂ : HomologicalComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (Y.over V).O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂
      (Stacks.SheafOfModules.Tensor.sheafTensor (Y.over V).O) (ComplexShape.up ℤ)]
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))
  [I.toSheafOfModules.IsFiniteType]

omit [HasWeakSheafify X.J CommRingCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}] in
/-- **[Stacks, Tag 0A0G]: `Rf_*` commutes with derived completion.** For a morphism of ringed
sites `f : (Sh(𝒟), 𝒪') ⟶ (Sh(𝒞), 𝒪)`, a sheaf of ideals `ℐ ⊂ 𝒪` of **finite type** and
`ℐ' = f^{-1}ℐ · 𝒪_X` the ideal sheaf Section 52.7 builds out of `ℐ`, the canonical natural
transformation

`Rf_* ⋙ (-)^∧_ℐ ⟶ (-)^∧_{ℐ'} ⋙ Rf_*`

of [Stacks, Tag 0A0G] is **invertible as a morphism of functors**. This is the tag's own
phrasing: the two functors are identified, not merely their values at one object.

It is `isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType` —
the invertibility at each object, for an arbitrary object and the tag's finite-type ideal sheaf
— assembled over all objects by `CategoryTheory.NatIso.isIso_of_isIso_app`, which applies
because the comparison map is a natural transformation by construction. -/
@[stacks 0A0G "`Rf_*` commutes with derived completion, as the tag phrases it: the canonical \
natural transformation `Rf_* ⋙ (-)^∧ ⟶ (-)^∧ ⋙ Rf_*` is invertible **as a morphism of \
functors**, for a morphism of ringed sites, a sheaf of ideals `ℐ ⊂ 𝒪` of **finite type** and \
`ℐ' = f^{-1}ℐ · 𝒪_X` the ideal sheaf Section 52.7 constructs out of `ℐ`. The finite type of \
`ℐ'` and the relation of [Stacks, Tag 099J] between the two sheaves of ideals are proved, not \
assumed. No hypothesis is placed on the object, none on the generating family, and the \
identification is the canonical comparison map characterised by its compatibility with the two \
completion units, so the two functors are identified by the map the tag names"]
theorem
    isIso_natTrans_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType :
    IsIso (derivedCompletionPushforwardComparison f I (inverseImageIdealSheaf f I)
      (pushforwardIdealCompatible_inverseImageIdealSheaf f I)) := by
  have : ∀ K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      IsIso ((derivedCompletionPushforwardComparison f I (inverseImageIdealSheaf f I)
        (pushforwardIdealCompatible_inverseImageIdealSheaf f I)).app K) := fun K =>
    isIso_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType f I K
  exact NatIso.isIso_of_isIso_app _

/-- **The commutation of [Stacks, Tag 0A0G] as an isomorphism of functors.** At a sheaf of ideals
`ℐ ⊂ 𝒪` of finite type and `ℐ' = f^{-1}ℐ · 𝒪_X`,

`Rf_* ⋙ (-)^∧_ℐ ≅ (-)^∧_{ℐ'} ⋙ Rf_*`.

The underlying morphism is the canonical comparison map of [Stacks, Tag 0A0G], by
`AlgebraicGeometry.RingedSite.derivedCompletionPushforwardIsoOfIsFiniteType_hom`. -/
def derivedCompletionPushforwardIsoOfIsFiniteType :
    derivedPushforward.{u} f.toRingedToposSiteHom ⋙ derivedCompletion Y I ≅
      derivedCompletion X (inverseImageIdealSheaf f I) ⋙
        derivedPushforward.{u} f.toRingedToposSiteHom :=
  have :=
    isIso_natTrans_derivedCompletionPushforwardComparison_inverseImageIdealSheaf_of_isFiniteType
      f I
  asIso (derivedCompletionPushforwardComparison f I (inverseImageIdealSheaf f I)
    (pushforwardIdealCompatible_inverseImageIdealSheaf f I))

omit [HasWeakSheafify X.J CommRingCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}] in
/-- The morphism underlying `derivedCompletionPushforwardIsoOfIsFiniteType` is the comparison map
`derivedCompletionPushforwardComparison`. -/
@[simp]
theorem derivedCompletionPushforwardIsoOfIsFiniteType_hom :
    (derivedCompletionPushforwardIsoOfIsFiniteType f I).hom =
      derivedCompletionPushforwardComparison f I (inverseImageIdealSheaf f I)
        (pushforwardIdealCompatible_inverseImageIdealSheaf f I) :=
  rfl

/-- **Equation 52.7.0.1 of [Stacks, Tag 0A0I]**, `Rf_*(ℱ^∧) = (Rf_*ℱ)^∧`, as an isomorphism

`(Rf_*K)^∧ ≅ Rf_*(K^∧)`

for an **arbitrary** object `K` of `D(𝒪')`, at a sheaf of ideals `ℐ ⊂ 𝒪` of **finite type** and
`ℐ' = f^{-1}ℐ · 𝒪_X`. The isomorphism is the component at `K` of the isomorphism of functors
`derivedCompletionPushforwardIsoOfIsFiniteType`, hence natural in `K`, and its underlying
morphism is the canonical comparison map that [Stacks, Tag 0A0G] names. -/
def derivedCompletionPushforwardObjIsoOfIsFiniteType
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    (derivedCompletion Y I).obj ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K) ≅
      (derivedPushforward.{u} f.toRingedToposSiteHom).obj
        ((derivedCompletion X (inverseImageIdealSheaf f I)).obj K) :=
  (derivedCompletionPushforwardIsoOfIsFiniteType f I).app K

omit [HasWeakSheafify X.J CommRingCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}] in
/-- The morphism underlying `derivedCompletionPushforwardObjIsoOfIsFiniteType f I K` is the
component at `K` of the comparison map `derivedCompletionPushforwardComparison`. -/
@[simp]
theorem derivedCompletionPushforwardObjIsoOfIsFiniteType_hom
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    (derivedCompletionPushforwardObjIsoOfIsFiniteType f I K).hom =
      (derivedCompletionPushforwardComparison f I (inverseImageIdealSheaf f I)
        (pushforwardIdealCompatible_inverseImageIdealSheaf f I)).app K :=
  rfl

omit [HasWeakSheafify X.J CommRingCat.{u}] [HasWeakSheafify Y.J CommRingCat.{u}]
  [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, HasWeakSheafify (X.J.over U) CommRingCat.{u}]
  [∀ V : Y.C, HasWeakSheafify (Y.J.over V) CommRingCat.{u}] in
/-- The isomorphism of Equation 52.7.0.1 is compatible with the two completion units: the unit
`Rf_*K ⟶ (Rf_*K)^∧` followed by `(Rf_*K)^∧ ≅ Rf_*(K^∧)` is `Rf_*` applied to the unit
`K ⟶ K^∧`. This is what makes the isomorphism the *canonical* identification of the display's
two sides rather than an abstract isomorphism between them. -/
theorem derivedCompletionUnit_comp_derivedCompletionPushforwardObjIsoOfIsFiniteType_hom
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))) :
    (derivedCompletionUnit Y I).app ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K) ≫
        (derivedCompletionPushforwardObjIsoOfIsFiniteType f I K).hom =
      (derivedPushforward.{u} f.toRingedToposSiteHom).map
        ((derivedCompletionUnit X (inverseImageIdealSheaf f I)).app K) :=
  derivedCompletionUnit_comp_derivedCompletionPushforwardComparison f I
    (inverseImageIdealSheaf f I) (pushforwardIdealCompatible_inverseImageIdealSheaf f I) K

end Display

