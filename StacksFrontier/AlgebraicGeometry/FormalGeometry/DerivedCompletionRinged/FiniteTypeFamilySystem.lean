module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.CechGlobalSliceAway
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.FiniteTypeLocalReflector
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.GeneratorsAgreeLocally
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.Localization
public import StacksFrontier.RingTheory.Cech.FamilySystem

/-!
# The family system of local generators of a sheaf of ideals

Let `(𝒞, 𝒪)` be a ringed site and `ℐ ⊆ 𝒪` a sheaf of ideals. Over an object `V` call a finite
family `f_1, …, f_n` of sections of `𝒪` over `V` a family of *local generators* of `ℐ|_V` when
each `f_i` is a section of `ℐ`, and every section of `ℐ` over an object `W ⟶ V` lies, locally on
`W`, in the ideal generated by the restrictions of the `f_i`. This condition is stable under
restriction, so it is a `Stacks.CechFamilySystem.FamilySystem` on `𝒪`: the index system over
which [Stacks, Tag 099D] takes its colimit of Čech complexes, transported to a site.

## Main definitions

* `AlgebraicGeometry.RingedSite.generatesFamilySystem`: the family system of local generators
  of `ℐ`.

## Main results

* `AlgebraicGeometry.RingedSite.exists_mem_sieve_span_eq_of_mem`: finitely many families of
  local generators over `V` span one ideal of sections along every arrow of some covering sieve
  of `V`.
* `AlgebraicGeometry.RingedSite.mem_generatesFamilySystem_of_eq`: a finite family of global
  sections of the slice `𝒪_U` generating `ℐ|_U` gives, over each object of the slice, a family
  of local generators.

## Implementation notes

The condition asks for the local membership along *every* arrow `W ⟶ V`, not only at `V`
itself: that is what makes it stable under restriction with no appeal to the sheaf property.

## References

* [Stacks Project, Tag 099D](https://stacks.math.columbia.edu/tag/099D)
* [Stacks Project, Tag 099E](https://stacks.math.columbia.edu/tag/099E)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u})
  (ℐ : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))

/-- **The family system of local generators of a sheaf of ideals `ℐ`.** Over an object `V`, a
finite family `f` of sections of `𝒪` is distinguished when each `f i` is a section of `ℐ` over
`V`, and every section `s` of `ℐ` over an object `W` mapping to `V` restricts, along every arrow
of some covering sieve of `W`, into the ideal generated by the restrictions of the `f i`. -/
def generatesFamilySystem : Stacks.CechFamilySystem.FamilySystem X.O.obj where
  Mem {V} {_} f := (∀ i, f i ∈ ℐ.toSubmodule.obj V) ∧
    ∀ ⦃W : X.C⦄ (b : W ⟶ V.unop) (s : X.O.obj.obj (op W)), s ∈ ℐ.toSubmodule.obj (op W) →
      ∃ S : Sieve W, S ∈ X.J W ∧ ∀ ⦃W' : X.C⦄ (c : W' ⟶ W), S c →
        (X.O.obj.map c.op).hom s ∈
          Ideal.span (Set.range fun i => (X.O.obj.map (c ≫ b).op).hom (f i))
  Mem_map {V V'} a {_} f hf := by
    refine ⟨fun i => ℐ.toSubmodule.map a (hf.1 i), fun W b s hs => ?_⟩
    obtain ⟨S, hS, hSmem⟩ := hf.2 (b ≫ a.unop) s hs
    refine ⟨S, hS, fun W' c hc => ?_⟩
    have hrange : (fun i => (X.O.obj.map (c ≫ b ≫ a.unop).op).hom (f i)) =
        fun i => (X.O.obj.map (c ≫ b).op).hom ((X.O.obj.map a).hom (f i)) := by
      funext i
      have e : (c ≫ b ≫ a.unop).op = a ≫ (c ≫ b).op := by simp
      rw [e, X.O.obj.map_comp, CommRingCat.comp_apply]
    exact hrange ▸ hSmem c hc

variable {X ℐ}

/-- One family of local generators locally contains the sections of another: along every arrow
of some covering sieve of `V`, the ideal spanned by the restrictions of `y` is contained in the
ideal spanned by the restrictions of `x`. -/
theorem exists_mem_sieve_span_le_of_generatesFamilySystem {V : X.Cᵒᵖ}
    (x y : (generatesFamilySystem X ℐ).Gen V) :
    ∃ S : Sieve V.unop, S ∈ X.J V.unop ∧ ∀ ⦃W : X.C⦄ (b : W ⟶ V.unop), S b →
      Ideal.span (Set.range (Stacks.CechFamilySystem.FamilySystem.Gen.map b.op y).elts) ≤
        Ideal.span (Set.range (Stacks.CechFamilySystem.FamilySystem.Gen.map b.op x).elts) := by
  choose S hS hSmem using fun j : Fin y.arity => x.mem.2 (𝟙 V.unop) (y.elts j) (y.mem.1 j)
  refine ⟨⨅ j, S j, X.J.finite_iInf_covering S hS, fun W b hb => Ideal.span_le.2 ?_⟩
  rintro _ ⟨j, rfl⟩
  have h := hSmem j b (iInf_le S j b hb)
  rw [Category.comp_id] at h
  exact h

/-- **Finitely many families of local generators agree locally.** For a finite set `T` of
families of local generators of `ℐ` over `V`, there is a covering sieve of `V` along every arrow
of which all the families of `T` span one ideal of sections. -/
theorem exists_mem_sieve_span_eq_of_mem {V : X.Cᵒᵖ}
    (T : Finset ((generatesFamilySystem X ℐ).Gen V)) :
    ∃ S : Sieve V.unop, S ∈ X.J V.unop ∧ ∀ ⦃W : X.C⦄ (b : W ⟶ V.unop), S b →
      ∀ x ∈ T, ∀ y ∈ T,
        Ideal.span (Set.range (Stacks.CechFamilySystem.FamilySystem.Gen.map b.op x).elts) =
          Ideal.span (Set.range (Stacks.CechFamilySystem.FamilySystem.Gen.map b.op y).elts) := by
  choose S hS hSmem using fun p : (T ×ˢ T : Finset _) =>
    exists_mem_sieve_span_le_of_generatesFamilySystem p.1.1 p.1.2
  refine ⟨⨅ p, S p, X.J.finite_iInf_covering S hS, fun W b hb x hx y hy => le_antisymm ?_ ?_⟩
  · let p : (T ×ˢ T : Finset _) := ⟨(y, x), Finset.mem_product.2 ⟨hy, hx⟩⟩
    exact hSmem p b (iInf_le S p b hb)
  · let p : (T ×ˢ T : Finset _) := ⟨(x, y), Finset.mem_product.2 ⟨hx, hy⟩⟩
    exact hSmem p b (iInf_le S p b hb)

/-- **Generators of `ℐ|_U` on the slice are local generators of `ℐ`.** If finitely many global
sections `g_1, …, g_s` of the slice `𝒪_U` generate the restriction `ℐ|_U`, then over every object
`V ⟶ U` of the slice their values form a family of local generators of `ℐ` over `V`. -/
theorem mem_generatesFamilySystem_of_eq (U : X.C) {s : ℕ}
    (g : Fin s → Presheaf.globalSections ((X.over U).O.obj ⋙ forget CommRingCat.{u}))
    (hg : idealOfGlobalSections (X.over U) g = overIdeal ℐ U) (V' : (Over U)ᵒᵖ) :
    (generatesFamilySystem X ℐ).Mem (V := op V'.unop.left)
      (fun i => globalSectionVal (g i) V') := by
  refine ⟨fun i => ?_, fun W b t ht => ?_⟩
  · have h := globalSectionVal_mem_idealOfGlobalSections (X.over U) g i V'
    rw [hg] at h
    exact h
  · let W' : Over U := Over.mk (b ≫ V'.unop.hom)
    have ht' : t ∈ (idealOfGlobalSections (X.over U) g).toSubmodule.obj (op W') := by
      rw [hg]
      exact ht
    obtain ⟨S', hS', hS'mem⟩ := (mem_idealOfGlobalSections_iff (X.over U) g (op W')).1 ht'
    refine ⟨Sieve.overEquiv W' S', (X.J.mem_over_iff S').1 hS', fun W'' c hc => ?_⟩
    have h := hS'mem (Over.homMk c : Over.mk (c ≫ W'.hom) ⟶ W')
      ((Sieve.overEquiv_iff S' c).1 hc)
    have hrange : Set.range (restrictGlobalSections (X.over U) g (op (Over.mk (c ≫ W'.hom)))) =
        Set.range fun i => (X.O.obj.map (c ≫ b).op).hom (globalSectionVal (g i) V') :=
      congrArg Set.range (funext fun i =>
        (globalSectionVal_map (g i)
          (Over.homMk (c ≫ b) : Over.mk (c ≫ W'.hom) ⟶ V'.unop).op).symm)
    exact hrange ▸ h

/-- **Local generators over `U` generate `ℐ|_U` on the slice.** A family of local generators of
`ℐ` over `U`, read as global sections of `𝒪_U` through `globalSectionOfSection`, generates the
restricted sheaf of ideals `ℐ|_U`. This is the converse of `mem_generatesFamilySystem_of_eq`. -/
theorem idealOfGlobalSections_eq_overIdeal_of_mem (U : X.C) {n : ℕ}
    {f : Fin n → X.O.obj.obj (op U)} (hf : (generatesFamilySystem X ℐ).Mem f) :
    idealOfGlobalSections (X.over U) (fun i => globalSectionOfSection X U (f i)) =
      overIdeal ℐ U := by
  refine le_antisymm (idealOfGlobalSections_le (X.over U) _ fun i V => ?_) fun W t ht => ?_
  · rw [globalSectionVal_globalSectionOfSection]
    exact ℐ.toSubmodule.map V.unop.hom.op (hf.1 i)
  · obtain ⟨S, hS, hSmem⟩ := hf.2 W.unop.hom t ht
    refine (mem_idealOfGlobalSections_iff (X.over U) _ W).2
      ⟨(Sieve.overEquiv W.unop).symm S, (X.J.mem_over_iff _).2 ?_, fun Z h hh => ?_⟩
    · rw [OrderIso.apply_symm_apply]
      exact hS
    · have hrange : Set.range (fun i => (X.O.obj.map (h.left ≫ W.unop.hom).op).hom (f i)) =
          Set.range (restrictGlobalSections (X.over U)
            (fun i => globalSectionOfSection X U (f i)) (op Z)) :=
        congrArg Set.range (funext fun i => by
          rw [restrictGlobalSections, globalSectionVal_globalSectionOfSection, Over.w h])
      exact hrange ▸ hSmem h.left ((Sieve.overEquiv_symm_iff S h).1 hh)

end AlgebraicGeometry.RingedSite

end
