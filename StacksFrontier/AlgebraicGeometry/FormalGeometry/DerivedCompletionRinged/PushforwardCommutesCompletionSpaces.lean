namespace Stacks.RingedSpace

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

/-- **The morphism of ringed sites presented by a morphism of ringed spaces.** The underlying
functor is `V ↦ f⁻¹V` between the small Zariski sites, which is a morphism of sites by
[Stacks, Tag 00X2], and the structure map is `f^♯ : 𝒪_Y ⟶ f_*𝒪_X`.

This is `Stacks.ToposBridge.ringedToposHom` in the `AlgebraicGeometry.RingedSite.Hom` form: the
derived direct image of sheaves of modules is available along the latter. -/
def toRingedSiteHom {X Y : AlgebraicGeometry.RingedSpace.{u, u}} (f : X ⟶ Y) :
    AlgebraicGeometry.RingedSite.Hom (toRingedSite X) (toRingedSite Y) where
  u := Opens.map f.hom.base
  isMorphismOfSites := StacksZariskiSite.isMorphismOfSites_opensMap f.hom.base
  fsharp := Stacks.ToposBridge.commRingStructureHom f

section Display

variable {X Y : AlgebraicGeometry.RingedSpace.{u, u}} (f : X ⟶ Y)
  (I : _root_.SheafOfModules.Submodule
    (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite Y).O))))
  (I' : _root_.SheafOfModules.Submodule
    (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite X).O))))
  (hI : RingedSite.PushforwardIdealCompatible (toRingedSiteHom f) I I')

include hI in
/-- **The left hand side of the display [Stacks, Tag 0A0I] is derived complete**, at a morphism
of ringed spaces: `Rf_*(ℱ^∧)` is derived complete along `ℐ`, for an arbitrary object `ℱ` of
`D(𝒪_X)`. This is
`AlgebraicGeometry.RingedSite.isDerivedComplete_derivedPushforward_derivedCompletion` read at
the small Zariski sites of `X` and `Y`.

Writing `ℱ^∧` needs the derived completion functor on `D(𝒪_X)`, which is the instance
hypothesis below — the conclusion of [Stacks, Tag 099F]. With that instance discharged, this is,
at a sheaf of ideals of finite type,
`Stacks.RingedSpace.isDerivedComplete_derivedPushforward_derivedCompletion_of_isFiniteType` of
`PushforwardCommutesCompletionFiniteType.lean`, and, at ideal sheaves generated by finitely many
global sections,
`Stacks.RingedSpace.isDerivedComplete_derivedPushforward_derivedCompletion_generatedIdealSheaf`
of `PushforwardCommutesCompletionGenerated.lean`. -/
theorem isDerivedComplete_derivedPushforward_derivedCompletion
    [(ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
      (toRingedSite X) I')).IsRightAdjoint]
    (K : DerivedCategory (_root_.SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite X).O)))) :
    RingedSite.IsDerivedComplete.{u, u, u, u} (toRingedSite Y) I
      ((derivedPushforward.{u} (toRingedSiteHom f).toRingedToposSiteHom).obj
        ((RingedSite.derivedCompletion (toRingedSite X) I').obj K)) :=
  RingedSite.isDerivedComplete_derivedPushforward_derivedCompletion
    (toRingedSiteHom f) I I' hI K

/-- **The comparison map at a morphism of ringed spaces, for a derived-complete object**: the
canonical comparison `(Rf_*ℱ)^∧ ⟶ Rf_*(ℱ^∧)` is invertible when `ℱ` is derived complete along
`ℐ'`. This is
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_of_isDerivedComplete`
read at the small Zariski sites.

Besides restricting `ℱ`, it assumes the conclusion of [Stacks, Tag 099F] on both sites as
instance hypotheses. With both instances discharged, this is, at two sheaves of ideals of finite
type, `Stacks.RingedSpace`
`.isIso_derivedCompletionPushforwardComparison_of_isFiniteType_of_isDerivedComplete` of
`PushforwardCommutesCompletionFiniteType.lean`, and, at ideal sheaves generated by finitely many
global sections,
`isIso_derivedCompletionPushforwardComparison_generatedIdealSheaf_of_isDerivedComplete` of
`PushforwardCommutesCompletionGenerated.lean`. -/
theorem isIso_derivedCompletionPushforwardComparison_of_isDerivedComplete
    [(ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
      (toRingedSite Y) I)).IsRightAdjoint]
    [(ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
      (toRingedSite X) I')).IsRightAdjoint]
    {K : DerivedCategory (_root_.SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite X).O)))}
    (hK : RingedSite.IsDerivedComplete.{u, u, u, u} (toRingedSite X) I' K) :
    IsIso ((RingedSite.derivedCompletionPushforwardComparison
      (toRingedSiteHom f) I I' hI).app K) :=
  RingedSite.isIso_derivedCompletionPushforwardComparison_of_isDerivedComplete
    (toRingedSiteHom f) I I' hI hK

/-- **The display [Stacks, Tag 0A0I] at a morphism of ringed spaces, for an arbitrary object**,
when the local sections of `ℐ` and of `ℐ'` are nilpotent: the comparison
`(Rf_*ℱ)^∧ ⟶ Rf_*(ℱ^∧)` is invertible for every `ℱ ∈ D(𝒪_X)`.

The restriction is on the two sheaves of ideals, not on the object, and it *discharges* the
conclusion of [Stacks, Tag 099F] on `X` and on `Y` rather than assuming it: this statement has
no instance hypothesis. Nilpotence makes every object derived complete, by
`AlgebraicGeometry.RingedSite.isDerivedComplete_of_forall_isNilpotent`, so this is
`AlgebraicGeometry.RingedSite.isIso_derivedCompletionPushforwardComparison_of_isDerivedComplete`
with its hypothesis discharged. -/
@[stacks 0A0I "Equation 52.7.0.1 at a morphism of ringed spaces read on its small Zariski
  sites, for an **arbitrary** object, when the local sections of both sheaves of ideals are
  nilpotent — a restriction on the data, not on the object, from which the two derived
  completion functors are produced rather than assumed, so that no part of
  [Stacks, Tag 099F] is a hypothesis here. The display at the source's own data, two sheaves of
  ideals of finite type, is `Stacks.RingedSpace`
  `.isIso_derivedCompletionPushforwardComparison_of_isFiniteType_of_isDerivedComplete` of
  `PushforwardCommutesCompletionFiniteType.lean`, for an object derived complete along `ℐ'`"]
theorem isIso_derivedCompletionPushforwardComparison_of_forall_isNilpotent
    (hnil : ∀ (V : Opens X.carrier)
      (g : ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite X).O)).obj.obj (op V)),
      g ∈ I'.toSubmodule.obj (op V) → IsNilpotent g)
    (hnil' : ∀ (W : Opens Y.carrier)
      (s : ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite Y).O)).obj.obj (op W)),
      s ∈ I.toSubmodule.obj (op W) → IsNilpotent s)
    (K : DerivedCategory (_root_.SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (toRingedSite X).O)))) :
    letI : (ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
        (toRingedSite X) I')).IsRightAdjoint :=
      RingedSite.isRightAdjoint_ι_isDerivedComplete_of_forall_isNilpotent
        (toRingedSite X) I' hnil
    letI : (ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
        (toRingedSite Y) I)).IsRightAdjoint :=
      RingedSite.isRightAdjoint_ι_isDerivedComplete_of_forall_isNilpotent
        (toRingedSite Y) I hnil'
    IsIso ((RingedSite.derivedCompletionPushforwardComparison
      (toRingedSiteHom f) I I' hI).app K) :=
  let : (ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
      (toRingedSite X) I')).IsRightAdjoint :=
    RingedSite.isRightAdjoint_ι_isDerivedComplete_of_forall_isNilpotent
      (toRingedSite X) I' hnil
  let : (ObjectProperty.ι (RingedSite.IsDerivedComplete.{u, u, u, u}
      (toRingedSite Y) I)).IsRightAdjoint :=
    RingedSite.isRightAdjoint_ι_isDerivedComplete_of_forall_isNilpotent
      (toRingedSite Y) I hnil'
  RingedSite.isIso_derivedCompletionPushforwardComparison_of_isDerivedComplete
    (toRingedSiteHom f) I I' hI
    (RingedSite.isDerivedComplete_of_forall_isNilpotent (toRingedSite X) I' hnil K)

end Display

end Stacks.RingedSpace

