module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.DerivedHomComplete
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.FlatNeighbourhoodCechDerived
public import StacksFrontier.CategoryTheory.Sites.Cohomology.InternalHom.DerivedCurryingNaturality

/-!
# Maps which the Čech complex inverts are inverted by `R𝑆heafHom(-, Y)` for complete `Y`

Let `(𝒞, 𝒪)` be a ringed site, let `f_1, …, f_r` be global sections of `𝒪` and let `Č(f)` be
their extended alternating Čech complex. If a map `t : A ⟶ B` of `D(𝒪)` becomes invertible after
`Č(f) ⊗^𝐋_𝒪 -`, then for every `Y` which is derived complete along the ideal sheaf generated by
the `f_i` the induced map

`R𝑆heafHom_𝒪(B, Y) ⟶ R𝑆heafHom_𝒪(A, Y)`

is invertible.

## Main results

* `AlgebraicGeometry.RingedSite.isIso_derivedSheafHom_map_of_isIso_derivedTensor_map`: the
  statement above.

## Implementation notes

Both ends of the map are derived complete by [Stacks, Tag 099A]
(`AlgebraicGeometry.RingedSite.isDerivedComplete_derivedSheafHom`), so by
`AlgebraicGeometry.RingedSite.isIso_of_isIso_completionFunctor_map` it is enough to invert the
map after the completion functor `R𝑆heafHom_𝒪(Č(f), -)` of [Stacks, Tag 099B]. There the derived
currying isomorphism of [Stacks, Tag 08J9], natural in its middle variable
(`AlgebraicGeometry.RingedSite.derivedCurryIso_natural`), identifies it with the map
`R𝑆heafHom_𝒪(Č(f) ⊗^𝐋_𝒪 t, Y)`, which is invertible because `Č(f) ⊗^𝐋_𝒪 t` is.

This is the step of the proof of [Stacks, Tag 099I] at which the comparison of Čech complexes
[Stacks, Tag 099H] is turned into a statement about derived-complete objects.

## References

* [Stacks Project, Tag 08J9](https://stacks.math.columbia.edu/tag/08J9)
* [Stacks Project, Tag 099A](https://stacks.math.columbia.edu/tag/099A)
* [Stacks Project, Tag 099B](https://stacks.math.columbia.edu/tag/099B)
* [Stacks Project, Tag 099I](https://stacks.math.columbia.edu/tag/099I)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u}) [HasWeakSheafify X.J CommRingCat.{u}]
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).Additive]
  [∀ A, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj A).Additive]
  [∀ (K₁ K₂ : HomologicalComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u,
    u} X.O))
      (ComplexShape.up ℤ)),
    HomologicalComplex.HasMapBifunctor K₁ K₂ (Stacks.SheafOfModules.Tensor.sheafTensor X.O)
      (ComplexShape.up ℤ)]
  {r : ℕ} (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{u}))

attribute [local instance] HasDerivedCategory.standard

/-- **A map inverted by `Č(f) ⊗^𝐋_𝒪 -` is inverted by `R𝑆heafHom_𝒪(-, Y)` for complete `Y`.**
If `Č(f) ⊗^𝐋_𝒪 t` is invertible and `Y` is derived complete along the ideal sheaf generated by
`f_1, …, f_r`, then `R𝑆heafHom_𝒪(t, Y) : R𝑆heafHom_𝒪(B, Y) ⟶ R𝑆heafHom_𝒪(A, Y)` is invertible.

Both ends are derived complete by [Stacks, Tag 099A], so it suffices to invert the map after
completion; after completion it is `R𝑆heafHom_𝒪(Č(f) ⊗^𝐋_𝒪 t, Y)` by the derived currying
isomorphism of [Stacks, Tag 08J9]. -/
theorem isIso_derivedSheafHom_map_of_isIso_derivedTensor_map
    {A B : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))}
    (t : A ⟶ B)
    (ht : IsIso (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
      (DerivedCategory.Q.obj (extendedAlternatingCech X f))).map t))
    (Y : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hY : IsDerivedComplete.{u, u, u, u} X (idealOfGlobalSections X f) Y) :
    IsIso (((derivedSheafHomBifunctor X).map t.op).app Y) := by
  refine isIso_of_isIso_completionFunctor_map X f _
    (isDerivedComplete_derivedSheafHom X _ B Y hY)
    (isDerivedComplete_derivedSheafHom X _ A Y hY) ?_
  have h := derivedCurryIso_natural X
    (𝟙 (DerivedCategory.Q.obj (extendedAlternatingCech X f))) t (𝟙 Y)
  simp only [op_id, CategoryTheory.Functor.map_id, NatTrans.id_app, Category.id_comp,
    Category.comp_id] at h
  have hR : IsIso (((derivedSheafHomBifunctor X).map
      (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
        (DerivedCategory.Q.obj (extendedAlternatingCech X f))).map t).op).app Y) :=
    inferInstance
  have hc : (completionFunctor X f).map (((derivedSheafHomBifunctor X).map t.op).app Y) =
      (derivedCurryIso X _ B Y).hom ≫
        ((derivedSheafHomBifunctor X).map
          (((Stacks.SheafOfModules.derivedTensorProductFunctor X).obj
            (DerivedCategory.Q.obj (extendedAlternatingCech X f))).map t).op).app Y ≫
        (derivedCurryIso X _ A Y).inv := by
    rw [← Category.assoc, ← h, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rfl
  rw [hc]
  exact IsIso.comp_isIso' (Iso.isIso_hom _) (IsIso.comp_isIso' hR (Iso.isIso_inv _))

end AlgebraicGeometry.RingedSite

end
