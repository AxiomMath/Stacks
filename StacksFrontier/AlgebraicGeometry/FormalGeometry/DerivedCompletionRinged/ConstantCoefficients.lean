module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.IdealOfGlobalSections
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.KoszulDerivedCompletion
public import StacksFrontier.CategoryTheory.Sites.Cohomology.StrictlyPerfect.MapOutOfAConstantComplex

/-!
# The constant ringed site of a commutative ring

Let `(𝒞, J)` be a site and `Λ` a commutative ring. The *constant ringed site* `(𝒞, Λ̲)` carries
the constant sheaf of commutative rings `Λ̲` as its structure sheaf. This file records three
pieces of structure relating `Λ`-modules to sheaves of `Λ̲`-modules:

* the constant sheaf of modules functor `M ↦ M̲`, an exact additive functor from `Λ`-modules to
  sheaves of `Λ̲`-modules carrying `Λ` to the unit module `Λ̲`;
* the global section `a̲` of `Λ̲` attached to an element `a` of `Λ`, by which `a` acts on every
  constant sheaf of modules: the map `M̲ ⟶ M̲` induced by multiplication by `a` on `M` is
  multiplication by `a̲`;
* the sheaf of ideals `IΛ̲ ⊂ Λ̲` generated by an ideal `I ⊂ Λ`, which for `I = (f_1, …, f_r)` is
  the ideal sheaf generated by the global sections `f̲_1, …, f̲_r`.

## Main definitions

* `AlgebraicGeometry.RingedSite.constant`: the constant ringed site `(𝒞, Λ̲)`.
* `AlgebraicGeometry.RingedSite.constantModuleFunctor`: the constant sheaf of modules functor
  `Mod(Λ) ⥤ Mod(Λ̲)`.
* `AlgebraicGeometry.RingedSite.constantModuleFunctorUnitIso`: `Λ̲` as the constant sheaf of
  modules on `Λ`.
* `AlgebraicGeometry.RingedSite.constantSection` and
  `AlgebraicGeometry.RingedSite.constantGlobalSection`: the global section `a̲`.
* `AlgebraicGeometry.RingedSite.constantScalar`: multiplication by `a̲` on `Λ̲`.
* `AlgebraicGeometry.RingedSite.constantIdealSheaf`: the ideal sheaf `IΛ̲`.

## Main results

* `AlgebraicGeometry.RingedSite.constantModuleFunctor_map_smul`: the map induced by
  multiplication by `a` is multiplication by `a̲`.
* `AlgebraicGeometry.RingedSite.koszulScalar_constantGlobalSection`: the entries of the Koszul
  complexes on the sections `f̲_i` are multiplications by monomials in the `f_i`.
* `AlgebraicGeometry.RingedSite.constantIdealSheaf_eq_idealOfGlobalSections`: `IΛ̲` is generated
  by the sections `f̲_i` for any generators `f_i` of `I`.

## Implementation notes

The universes are diagonal: the site has objects and morphisms in `Type u` and `Λ : Type u`.
This is the universe at which the derived completion of [Stacks, Tag 0A0E] is available in this
library. `AlgebraicGeometry.RingedSite.constantRingedSite` is the case `u = 0` of the same
construction, with its universe-`0` API, and the constant coefficient ringed sites of the étale
and pro-étale sites are the cases of particular sites at their own universes.

The constant sheaf of modules functor is built over the constant sheaf of *rings*
`(constantSheaf J RingCat).obj Λ` by `Stacks.SheafOfModules.Constant.constantModuleSheafFunctor`,
and read over the ring sheaf of the structure sheaf `Λ̲` by restriction of scalars along the
isomorphism `AlgebraicGeometry.RingedSite.constantRingSheafIso'` given by the commutation of
`forget₂ CommRingCat RingCat` with sheafification. The global section `a̲` is defined through the
same isomorphism, so that its action on a constant sheaf of modules is the action of the image of
`a` in the sections of the constant sheaf of rings, which is what the sheafification adjunction
computes.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite

variable {C : Type u} [Category.{u} C] (J : GrothendieckTopology C) (Λ : Type u) [CommRing Λ]

/-- **The constant ringed site** `(𝒞, Λ̲)`: the site `(𝒞, J)` with the constant sheaf of
commutative rings on `Λ` as its structure sheaf. -/
abbrev constant : RingedSite.{u, u, u} where
  C := C
  J := J
  O := (constantSheaf J CommRingCat.{u}).obj (CommRingCat.of Λ)

/-- The sheaf of rings underlying the structure sheaf of the constant ringed site is the constant
sheaf of rings on `Λ`: forgetting commutativity commutes with sheafification. -/
def constantRingSheafIso' :
    Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O ≅
      (constantSheaf J RingCat.{u}).obj (RingCat.of Λ) :=
  (constantCommuteCompose J (forget₂ CommRingCat.{u} RingCat.{u})).app (CommRingCat.of Λ)

/-- **The constant sheaf of modules functor** `M ↦ M̲` from `Λ`-modules to sheaves of modules over
the structure sheaf of the constant ringed site. -/
def constantModuleFunctor :
    ModuleCat.{u} Λ ⥤
      SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O) :=
  Stacks.SheafOfModules.Constant.constantModuleSheafFunctor J (R := Λ) ⋙
    SheafOfModules.restrictScalars (constantRingSheafIso' J Λ).symm.inv

/-- Restriction of scalars along the inverse of `constantRingSheafIso'` is an equivalence of
categories of sheaves of modules. -/
instance :
    (SheafOfModules.restrictScalars.{u} (constantRingSheafIso' J Λ).symm.inv).IsEquivalence :=
  Stacks.SheafOfModules.isEquivalence_restrictScalars_inv _

/-- The constant sheaf of modules functor is left exact. -/
instance : PreservesFiniteLimits (constantModuleFunctor J Λ) := by
  have h2 : PreservesFiniteLimits
      (SheafOfModules.restrictScalars.{u} (constantRingSheafIso' J Λ).symm.inv) :=
    @PreservesLimitsOfSize0.preservesFiniteLimits _ _ _ _ _
      (Adjunction.isEquivalencePreservesLimits _)
  exact @comp_preservesFiniteLimits _ _ _ _ _ _ _ _
    (Stacks.SheafOfModules.Constant.preservesFiniteLimits_constantModuleSheafFunctor J (R := Λ)) h2

/-- The constant sheaf of modules functor is right exact. -/
instance : PreservesFiniteColimits (constantModuleFunctor J Λ) :=
  @comp_preservesFiniteColimits _ _ _ _ _ _ _ _
    (Stacks.SheafOfModules.Constant.preservesFiniteColimits_constantModuleSheafFunctor J (R := Λ))
    (Stacks.SheafOfModules.preservesFiniteColimits_restrictScalars_inv _)

/-- The constant sheaf of modules functor is additive. -/
instance : (constantModuleFunctor J Λ).Additive :=
  letI := preservesBinaryBiproducts_of_preservesBinaryCoproducts (constantModuleFunctor J Λ)
  Functor.additive_of_preservesBinaryBiproducts (constantModuleFunctor J Λ)

/-- **`Λ̲` is the constant sheaf of modules on `Λ`.** -/
def constantModuleFunctorUnitIso :
    (constantModuleFunctor J Λ).obj (ModuleCat.of Λ Λ) ≅
      SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O) :=
  (SheafOfModules.restrictScalars (constantRingSheafIso' J Λ).symm.inv).mapIso
      (Stacks.SheafOfModules.Constant.unitIsoConstantModuleSheaf J (R := Λ)).symm ≪≫
    Stacks.SheafOfModules.restrictScalarsUnitIso (constantRingSheafIso' J Λ).symm

/-- The image of `a ∈ Λ` in the sections of the constant sheaf of rings over `U`. -/
abbrev constantRingValue (a : Λ) (U : Cᵒᵖ) :
    ((constantSheaf J RingCat.{u}).obj (RingCat.of Λ)).obj.obj U :=
  ((toSheafify J ((Functor.const Cᵒᵖ).obj (RingCat.of Λ))).app U).hom a

/-- **The global section `a̲` of `Λ̲` attached to `a ∈ Λ`**, as a compatible family of sections of
the ring sheaf of the structure sheaf of the constant ringed site. -/
def constantSection (a : Λ) :
    ((Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O).obj ⋙ forget RingCat.{u}).sections
    where
  val U := ((constantRingSheafIso' J Λ).inv.hom.app U).hom (constantRingValue J Λ a U)
  property {U V} g := by
    change ((Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O).obj.map g).hom
      (((constantRingSheafIso' J Λ).inv.hom.app U).hom (constantRingValue J Λ a U)) =
        ((constantRingSheafIso' J Λ).inv.hom.app V).hom (constantRingValue J Λ a V)
    rw [← RingCat.comp_apply, ← (constantRingSheafIso' J Λ).inv.hom.naturality g,
      RingCat.comp_apply]
    congr 1
    exact (congrArg (fun φ => (ConcreteCategory.hom φ) a)
      ((toSheafify J ((Functor.const Cᵒᵖ).obj (RingCat.of Λ))).naturality g)).symm

/-- **Multiplication by `a` on a `Λ`-module induces multiplication by `a̲` on its constant sheaf of
modules.** -/
theorem constantModuleFunctor_map_smul (M : ModuleCat.{u} Λ) (a : Λ) :
    (constantModuleFunctor J Λ).map (a • 𝟙 M) =
      (Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ a)).app
        ((constantModuleFunctor J Λ).obj M) := by
  let F := SheafOfModules.restrictScalars.{u} (constantRingSheafIso' J Λ).symm.inv
  let α := toSheafify J ((Functor.const Cᵒᵖ).obj (RingCat.of Λ))
  obtain ⟨φ, hφ⟩ := F.map_surjective
    ((Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ a)).app
      ((constantModuleFunctor J Λ).obj M))
  rw [← hφ]
  show F.map (Stacks.SheafOfModules.Constant.constantModuleSheafMap J (a • 𝟙 M)) = F.map φ
  congr 1
  have h₁ := (PresheafOfModules.sheafificationAdjunction α).homEquiv_naturality_left
    ((PresheafOfModules.constFunctor
      (CategoryTheory.Limits.constCocone Cᵒᵖ (RingCat.of Λ))).map (a • 𝟙 M))
    (𝟙 (Stacks.SheafOfModules.Constant.constantModuleSheaf J M))
  have h₂ := (PresheafOfModules.sheafificationAdjunction α).homEquiv_naturality_right
    (𝟙 (Stacks.SheafOfModules.Constant.constantModuleSheaf J M)) φ
  let η := (PresheafOfModules.sheafificationAdjunction α).homEquiv _ _
    (𝟙 (Stacks.SheafOfModules.Constant.constantModuleSheaf J M))
  have hmid : (PresheafOfModules.constFunctor
        (CategoryTheory.Limits.constCocone Cᵒᵖ (RingCat.of Λ))).map (a • 𝟙 M) ≫ η =
      η ≫ (SheafOfModules.forget _ ⋙ PresheafOfModules.restrictScalars α).map φ := by
    refine PresheafOfModules.hom_ext fun U => ModuleCat.hom_ext (LinearMap.ext fun y => ?_)
    have hφU := congrArg (fun ψ => (ψ.val.app U).hom ((η.app U).hom y)) hφ
    show (η.app U).hom (a • y) = (φ.val.app U).hom ((η.app U).hom y)
    rw [(η.app U).hom.map_smul]
    refine Eq.trans ?_ hφU.symm
    let z : (Stacks.SheafOfModules.Constant.constantModuleSheaf J M).val.obj U := (η.app U).hom y
    exact (congrArg (fun r => r • z) (Stacks.SheafOfModules.ringIso_inv_hom_apply
      (constantRingSheafIso' J Λ) U (constantRingValue J Λ a U))).symm
  exact (Category.comp_id _).symm.trans
    ((((PresheafOfModules.sheafificationAdjunction α).homEquiv _ _).injective
      (h₁.trans (hmid.trans h₂.symm))).trans (Category.id_comp _))

/-- The ring homomorphism `Λ ⟶ Γ(U, Λ̲)`, `a ↦ a̲|_U`. -/
def constantSectionRingHom (U : Cᵒᵖ) :
    Λ →+* (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O).obj.obj U :=
  ((constantRingSheafIso' J Λ).inv.hom.app U).hom.comp
    ((toSheafify J ((Functor.const Cᵒᵖ).obj (RingCat.of Λ))).app U).hom

/-- The section of `a̲` over `U` is the image of `a` under `constantSectionRingHom`. -/
theorem constantSection_val (a : Λ) (U : Cᵒᵖ) :
    (constantSection J Λ a).val U = constantSectionRingHom J Λ U a :=
  rfl

/-- **The global section `a̲` of `Λ̲`**, in the form the Koszul and Čech constructions of a ringed
site take their global sections. -/
def constantGlobalSection (a : Λ) :
    Presheaf.globalSections ((constant J Λ).O.obj ⋙ forget CommRingCat.{u}) :=
  (Presheaf.globalSectionsEquivSections _).symm ⟨(constantSection J Λ a).val,
    fun g => (constantSection J Λ a).property g⟩

/-- The section of `constantGlobalSection J Λ a` over `U` is the image of `a` under
`constantSectionRingHom`. -/
@[simp]
theorem globalSectionVal_constantGlobalSection (a : Λ) (U : Cᵒᵖ) :
    globalSectionVal (X := constant J Λ) (constantGlobalSection J Λ a) U =
      constantSectionRingHom J Λ U a := by
  simp only [globalSectionVal, constantGlobalSection, Equiv.apply_symm_apply]
  rfl

/-- **Multiplication by `a` on `Λ` induces multiplication by `a̲` on `Λ̲`**, through the
identification `constantModuleFunctorUnitIso` of the constant sheaf of modules on `Λ` with the
unit module. -/
theorem constantModuleFunctor_map_smul_unitIso (a : Λ) :
    (constantModuleFunctor J Λ).map (a • 𝟙 (ModuleCat.of Λ Λ)) ≫
        (constantModuleFunctorUnitIso J Λ).hom =
      (constantModuleFunctorUnitIso J Λ).hom ≫
        (Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ a)).app
          (SheafOfModules.unit _) := by
  rw [constantModuleFunctor_map_smul]
  exact ((Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ a)).naturality
    (constantModuleFunctorUnitIso J Λ).hom).symm

/-- **The Koszul scalars at the sections `f̲_i` are multiplications by the monomials in the
`f_i`.** -/
theorem koszulScalar_constantGlobalSection {r : ℕ} (g : Fin r → Λ) (e : Fin r → ℕ) :
    koszulScalar (constant J Λ) (fun i => constantGlobalSection J Λ (g i)) e =
      (Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ (∏ i, g i ^ e i))).app
        (SheafOfModules.unit _) := by
  refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
  refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
  show koszulRingValue _ _ e U • x = constantSectionRingHom J Λ U (∏ i, g i ^ e i) • x
  congr 1
  simp only [koszulRingValue, koszulValue, globalSectionVal_constantGlobalSection, map_prod,
    map_pow]
  rfl

/-- **The sheaf of ideals `IΛ̲` generated by an ideal `I ⊂ Λ`**: the smallest submodule sheaf of
`Λ̲` containing the restrictions of the global sections `a̲` for `a ∈ I`. -/
def constantIdealSheaf (I : Ideal Λ) :
    SheafOfModules.Submodule
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O)) :=
  SheafOfModules.Submodule.generatedBy
    (F := SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))
    (fun p : I × Cᵒᵖ => p.2) (fun p => constantSectionRingHom J Λ p.2 p.1)

/-- If `I` is contained in the ideal generated by `g_1, …, g_r`, then `IΛ̲` is contained in the
ideal sheaf generated by the global sections `g̲_1, …, g̲_r`. -/
theorem constantIdealSheaf_le_idealOfGlobalSections (I : Ideal Λ) {r : ℕ} (g : Fin r → Λ)
    (hg : I ≤ Ideal.span (Set.range g)) :
    constantIdealSheaf J Λ I ≤
      idealOfGlobalSections (constant J Λ) (fun i => constantGlobalSection J Λ (g i)) := by
  refine SheafOfModules.Submodule.generatedBy_le
    (F := SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))
    (fun p : I × Cᵒᵖ => p.2) (fun p => constantSectionRingHom J Λ p.2 p.1) fun p => ?_
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun Λ).1 (hg p.1.2)
  have h : constantSectionRingHom J Λ p.2 p.1.1 ∈ Ideal.span (Set.range
      (restrictGlobalSections (constant J Λ) (fun i => constantGlobalSection J Λ (g i)) p.2)) := by
    rw [← hc]
    simp only [smul_eq_mul, map_sum, map_mul]
    refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, ?_⟩)
    simp only [restrictGlobalSections, globalSectionVal_constantGlobalSection]
  exact mem_idealOfGlobalSections_of_mem_span (constant J Λ)
    (fun i => constantGlobalSection J Λ (g i)) p.2 h

/-- If `g_1, …, g_r` lie in `I`, then the ideal sheaf generated by the global sections
`g̲_1, …, g̲_r` is contained in `IΛ̲`. -/
theorem idealOfGlobalSections_le_constantIdealSheaf (I : Ideal Λ) {r : ℕ} (g : Fin r → Λ)
    (hg : ∀ i, g i ∈ I) :
    idealOfGlobalSections (constant J Λ) (fun i => constantGlobalSection J Λ (g i)) ≤
      constantIdealSheaf J Λ I := by
  refine idealOfGlobalSections_le _ _ fun i V => ?_
  rw [globalSectionVal_constantGlobalSection]
  exact SheafOfModules.Submodule.mem_generatedBy
    (F := SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O))
    (fun p : I × Cᵒᵖ => p.2) (fun p => constantSectionRingHom J Λ p.2 p.1) (⟨g i, hg i⟩, V)

/-- **`IΛ̲` is generated by the sections `f̲_1, …, f̲_r` for any generators `f_1, …, f_r` of
`I`.** -/
theorem constantIdealSheaf_eq_idealOfGlobalSections (I : Ideal Λ) {r : ℕ} (g : Fin r → Λ)
    (hg : Ideal.span (Set.range g) = I) :
    constantIdealSheaf J Λ I =
      idealOfGlobalSections (constant J Λ) (fun i => constantGlobalSection J Λ (g i)) :=
  le_antisymm (constantIdealSheaf_le_idealOfGlobalSections J Λ I g hg.ge)
    (idealOfGlobalSections_le_constantIdealSheaf J Λ I g fun i =>
      hg ▸ Ideal.subset_span ⟨i, rfl⟩)

/-- **Multiplication by `a̲`** on `Λ̲`, additively in `a`. -/
def constantScalar : Λ →+ (SheafOfModules.unit
    (Stacks.SheafOfModules.Tensor.ringSheaf (constant J Λ).O) ⟶ SheafOfModules.unit _) where
  toFun a := (Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ a)).app _
  map_zero' := by
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    change constantSectionRingHom J Λ U 0 • x = 0
    rw [map_zero, zero_smul]
  map_add' a b := by
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    change constantSectionRingHom J Λ U (a + b) • x =
      constantSectionRingHom J Λ U a • x + constantSectionRingHom J Λ U b • x
    rw [map_add, add_smul]

/-- `constantScalar J Λ a` is multiplication by the global section `a̲` on `Λ̲`. -/
theorem constantScalar_apply (a : Λ) :
    constantScalar J Λ a =
      (Stacks.SheafOfModules.globalSectionToEnd _ (constantSection J Λ a)).app _ :=
  rfl

end AlgebraicGeometry.RingedSite

end
