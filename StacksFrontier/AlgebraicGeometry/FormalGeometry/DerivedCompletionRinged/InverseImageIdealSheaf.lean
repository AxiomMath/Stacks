-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry

universe u

namespace AlgebraicGeometry.RingedSite

attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

variable {X Y : RingedSite.{u, u, u}}
  [HasWeakSheafify X.J AddCommGrpCat.{u}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  (f : RingedSite.Hom X Y)
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))

/-- **The canonical map `f^*ℐ ⟶ 𝒪'`**: the inverse image of the inclusion `ℐ ↪ 𝒪`, followed by
the comparison `f^*𝒪 ⟶ 𝒪'` of `SheafOfModules.pullbackObjUnitToUnit`, which is invertible at a
morphism of ringed sites by
`AlgebraicGeometry.RingedSite.isIso_pullbackObjUnitToUnit_fSharpRing`. -/
def inverseImageIdealMap :
    (SheafOfModules.pullback.{u} f.toRingedToposSiteHom.fSharpRing).obj I.toSheafOfModules ⟶
      SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) :=
  (SheafOfModules.pullback.{u} f.toRingedToposSiteHom.fSharpRing).map I.ι ≫
    SheafOfModules.pullbackObjUnitToUnit.{u} f.toRingedToposSiteHom.fSharpRing

/-- **The ideal sheaf `ℐ' = f^{-1}ℐ · 𝒪_X` of Section 52.7, at an arbitrary sheaf of ideals
`ℐ ⊂ 𝒪`**: the image subsheaf of the canonical map `f^*ℐ ⟶ 𝒪'`.

Being an image it is the least sheaf of ideals of `𝒪'` through which that map factors, by
`Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule_le`; and `f^♯` carries `f^{-1}ℐ` into it, by
`AlgebraicGeometry.RingedSite.pushforwardIdealCompatible_inverseImageIdealSheaf`. Those two
properties are what Section 52.7 asks of `f^{-1}ℐ · 𝒪_X`. -/
def inverseImageIdealSheaf :
    SheafOfModules.Submodule (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :=
  Stacks.SheafOfModules.ImageSubsheaf.imageSubmodule (inverseImageIdealMap f I)

/-- **The adjunct of `f^*ℐ ⟶ 𝒪'` is `ℐ ↪ 𝒪 ⟶ f_*𝒪'`.** Under `f^* ⊣ f_*` the canonical map
corresponds to the inclusion of `ℐ` followed by the structure map `f^♯` of the morphism of
ringed sites, read as a morphism of sheaves of modules by
`SheafOfModules.unitToPushforwardObjUnit`.

This is naturality of the adjunction in the source variable together with the defining property
of `SheafOfModules.pullbackObjUnitToUnit`, and it is the only place the construction of `ℐ'`
touches the adjunction. -/
theorem homEquiv_inverseImageIdealMap :
    (SheafOfModules.pullbackPushforwardAdjunction.{u}
          f.toRingedToposSiteHom.fSharpRing).homEquiv _ _ (inverseImageIdealMap f I) =
      I.ι ≫ SheafOfModules.unitToPushforwardObjUnit.{u} f.toRingedToposSiteHom.fSharpRing := by
  rw [inverseImageIdealMap, Adjunction.homEquiv_naturality_left,
    SheafOfModules.pullbackPushforwardAdjunction_homEquiv_pullbackObjUnitToUnit]

/-- **On sections, the canonical map `f^*ℐ ⟶ 𝒪'` sends the unit image of a section of `ℐ` to its
image under `f^♯`.** A section `s` of `ℐ` over `W` has an image under the adjunction unit
`ℐ ⟶ f_*f^*ℐ`, which by the definition of the direct image is a section of `f^*ℐ` over `u(W)`;
the canonical map carries it to `f^♯(s)`.

This is `AlgebraicGeometry.RingedSite.homEquiv_inverseImageIdealMap` evaluated at `s`, through
`CategoryTheory.Adjunction.homEquiv_unit`. -/
theorem inverseImageIdealMap_val_app_unit (W : Y.C)
    (s : I.toSheafOfModules.val.obj (op W)) :
    (inverseImageIdealMap f I).val.app (op (f.u.obj W))
        (((SheafOfModules.pullbackPushforwardAdjunction.{u}
          f.toRingedToposSiteHom.fSharpRing).unit.app I.toSheafOfModules).val.app (op W) s) =
      fSharpSection f W s.1 := by
  have h := homEquiv_inverseImageIdealMap f I
  rw [Adjunction.homEquiv_unit] at h
  exact congr(($h).val.app (op W) s)

/-- **`f^♯` carries `f^{-1}ℐ` into `ℐ' = f^{-1}ℐ · 𝒪_X`**: the relation of [Stacks, Tag 099J]
between `ℐ` and the constructed `ℐ'`, with no hypothesis on `ℐ` and none on the morphism beyond
its being a morphism of ringed sites.

A section `s` of `ℐ` over `W` is carried by the adjunction unit to a section of `f^*ℐ` over
`u(W)` whose image under the canonical map is exactly `f^♯(s)`, by
`AlgebraicGeometry.RingedSite.inverseImageIdealMap_val_app_unit`; so `f^♯(s)` is in the
pointwise range of that map, hence a section of its image subsheaf, by
`Stacks.SheafOfModules.ImageSubsheaf.apply_mem_imageSubmodule`.

This is the hypothesis `AlgebraicGeometry.RingedSite.PushforwardIdealCompatible` that every
statement of `PushforwardCommutesCompletion.lean` carries, discharged for the source's own
ideal sheaf. -/
theorem pushforwardIdealCompatible_inverseImageIdealSheaf :
    PushforwardIdealCompatible f I (inverseImageIdealSheaf f I) := by
  intro W s hs
  rw [← inverseImageIdealMap_val_app_unit f I W ⟨s, hs⟩]
  exact Stacks.SheafOfModules.ImageSubsheaf.apply_mem_imageSubmodule
    (inverseImageIdealMap f I) _

section Minimality

variable (Q : SheafOfModules.Submodule
  (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))

/-- **The direct image of a sheaf of ideals of `𝒪'`, as a submodule of `f_*𝒪'`**, at the level of
presheaves of modules: its sections over `W` are the sections of `𝒥` over `u(W)`.

Only the presheaf-level submodule is formed, because that is all the factorisation below needs,
and it has no locality condition to check. The scalar restriction along `f^♯` is what
`smul_mem'` absorbs: a scalar is carried to `𝒪'(u(W))` by `f^♯` before it acts. -/
def pushforwardPresheafSubmodule :
    ((SheafOfModules.pushforward.{u} f.toRingedToposSiteHom.fSharpRing).obj
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))).val.Submodule where
  obj W :=
    { carrier := {x | x ∈ Q.toSubmodule.obj (op (f.u.obj W.unop))}
      add_mem' := fun hx hy => (Q.toSubmodule.obj _).add_mem hx hy
      zero_mem' := (Q.toSubmodule.obj _).zero_mem
      smul_mem' := fun c _ hx =>
        (Q.toSubmodule.obj _).smul_mem
          (f.toRingedToposSiteHom.fSharpRing.hom.app W c) hx }
  map g _ hx := Q.toSubmodule.map_mem (f.u.map g.unop).op hx

/-- **`ℐ' = f^{-1}ℐ · 𝒪_X` is the least sheaf of ideals of `𝒪'` receiving `f^♯(f^{-1}ℐ)`**: every
sheaf of ideals `𝒥 ⊂ 𝒪'` with `AlgebraicGeometry.RingedSite.PushforwardIdealCompatible f ℐ 𝒥`
contains it.

Together with `AlgebraicGeometry.RingedSite.pushforwardIdealCompatible_inverseImageIdealSheaf`
this is the defining property Section 52.7 asks of `f^{-1}ℐ · 𝒪_X`, and it is what identifies the
construction with every other one.

*Why this is an adjunction argument and not a membership check.* A section of `f^*ℐ` over an
object of the source site is not presented by anything, so the values of `f^*ℐ ⟶ 𝒪'` cannot be
inspected one at a time. What is inspectable is the **adjunct**: by
`Stacks.SheafOfModules.ImageSubsheaf.exists_factorThru_iff_imageSubmodule_le` the conclusion is
that `f^*ℐ ⟶ 𝒪'` factors through `𝒥`, which under `f^* ⊣ f_*` is the statement that
`ℐ ↪ 𝒪 ⟶ f_*𝒪'` factors through `f_*𝒥` — and *that* is objectwise, being exactly the hypothesis
`f^♯(s) ∈ 𝒥(u(W))` for every section `s` of `ℐ` over `W`. The factorisation is
`PresheafOfModules.Submodule.factorThru` through
`AlgebraicGeometry.RingedSite.pushforwardPresheafSubmodule`, whose presheaf of modules is
`f_*(𝒥)` and whose inclusion is `f_*` of the inclusion of `𝒥`, both on the nose. -/
theorem inverseImageIdealSheaf_le (hQ : PushforwardIdealCompatible f I Q) :
    inverseImageIdealSheaf f I ≤ Q := by
  set g := I.ι ≫ SheafOfModules.unitToPushforwardObjUnit.{u} f.toRingedToposSiteHom.fSharpRing
  have hmem : ∀ (W : Y.Cᵒᵖ) (x : I.toSheafOfModules.val.obj W),
      g.val.app W x ∈ (pushforwardPresheafSubmodule f Q).obj W :=
    fun W x => hQ W.unop x.1 x.2
  let φ : I.toSheafOfModules ⟶ (SheafOfModules.pushforward.{u}
      f.toRingedToposSiteHom.fSharpRing).obj Q.toSheafOfModules :=
    ⟨(pushforwardPresheafSubmodule f Q).factorThru g.val hmem⟩
  have hfac : φ ≫ (SheafOfModules.pushforward.{u} f.toRingedToposSiteHom.fSharpRing).map Q.ι = g :=
    SheafOfModules.hom_ext ((pushforwardPresheafSubmodule f Q).factorThru_ι _ hmem)
  refine (Stacks.SheafOfModules.ImageSubsheaf.exists_factorThru_iff_imageSubmodule_le
    (inverseImageIdealMap f I)).mp ⟨((SheafOfModules.pullbackPushforwardAdjunction.{u}
      f.toRingedToposSiteHom.fSharpRing).homEquiv _ _).symm φ, ?_⟩
  rw [← Adjunction.homEquiv_naturality_right_symm, hfac, Equiv.symm_apply_eq]
  exact (homEquiv_inverseImageIdealMap f I).symm

/-- The universal property of `ℐ' = f^{-1}ℐ · 𝒪_X` as an iff: a sheaf of ideals of `𝒪'` contains
it exactly when `f^♯` carries `f^{-1}ℐ` into it. -/
theorem inverseImageIdealSheaf_le_iff :
    inverseImageIdealSheaf f I ≤ Q ↔ PushforwardIdealCompatible f I Q :=
  ⟨fun h W s hs => h _ (pushforwardIdealCompatible_inverseImageIdealSheaf f I W s hs),
    inverseImageIdealSheaf_le f I Q⟩

end Minimality

section FiniteType

variable [∀ U : X.C, HasWeakSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ W : Y.C, HasWeakSheafify (Y.J.over W) AddCommGrpCat.{u}]
  [∀ W : Y.C, (Y.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **[Stacks, Tag 03DO] for the clause [Stacks, Tag 03DL] (5), at the site-presented pullback.**
The inverse image `f^*M` of a sheaf of modules of finite type along a morphism of ringed sites is
of finite type.

`Stacks.Sheaves.FiniteType.pullbackModules_isFiniteType` is the tag, for the pullback
`Stacks.Sheaves.RingedToposModules.pullbackModules` of the modules development; this transports
it to `AlgebraicGeometry.RingedToposSiteHom.pullbackTopos`, the pullback the derived development
and the construction of `f^{-1}ℐ · 𝒪_X` are stated over, along
`AlgebraicGeometry.RingedSite.Hom.pullbackModulesToposIso` and
`Stacks.SheafOfModules.Intrinsic.isFiniteType_of_iso`. -/
theorem isFiniteType_pullbackTopos
    (M : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O)))
    (hM : M.IsFiniteType) :
    (f.toRingedToposSiteHom.pullbackTopos.obj M).IsFiniteType :=
  Stacks.SheafOfModules.Intrinsic.isFiniteType_of_iso (f.pullbackModulesToposIso.app M)
    (Stacks.Sheaves.FiniteType.pullbackModules_isFiniteType
      f.ringedToposHom.toRingedToposModulesHom M hM)

/-- **`ℐ' = f^{-1}ℐ · 𝒪_X` is of finite type when `ℐ` is.** This is the second property
Section 52.7 needs of its ideal sheaf, after the relation of [Stacks, Tag 099J]: it is what makes
the derived completion functor along `ℐ'` exist, by [Stacks, Tag 099F] in the form
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete`.

`ℐ'` is the image of `f^*ℐ ⟶ 𝒪'`; the source is of finite type by
`AlgebraicGeometry.RingedSite.isFiniteType_pullbackTopos`, and the image of a morphism out of a
sheaf of modules of finite type is of finite type by
`Stacks.SheafOfModules.ImageSubsheaf.isFiniteType_imageSubmodule`. -/
theorem isFiniteType_inverseImageIdealSheaf (hI : I.toSheafOfModules.IsFiniteType) :
    (inverseImageIdealSheaf f I).toSheafOfModules.IsFiniteType :=
  have : HasSheafify X.J AddCommGrpCat.{u} :=
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  have : ∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u} := fun _ =>
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  Stacks.SheafOfModules.ImageSubsheaf.isFiniteType_imageSubmodule (inverseImageIdealMap f I)
    (isFiniteType_pullbackTopos f I.toSheafOfModules hI)

/-- `AlgebraicGeometry.RingedSite.isFiniteType_inverseImageIdealSheaf` as an instance, for an
`ℐ` carrying the finite-type instance. -/
instance isFiniteType_inverseImageIdealSheaf_of_instance [I.toSheafOfModules.IsFiniteType] :
    (inverseImageIdealSheaf f I).toSheafOfModules.IsFiniteType :=
  isFiniteType_inverseImageIdealSheaf f I inferInstance

end FiniteType

end AlgebraicGeometry.RingedSite

end
