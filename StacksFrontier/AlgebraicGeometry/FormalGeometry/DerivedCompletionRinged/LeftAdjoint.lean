module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.LocalizationAtGlobalSection

/-!
# Inverting the subproducts of a finite family of global sections

Let `(C, 𝒪)` be a ringed site and let `f_1, …, f_r` be global sections of `𝒪`. For a subset
`S ⊆ {1, …, r}` write `f_S = ∏_{i ∈ S} f_i`, again a global section, and `𝒪_{f_S}` for the
sheaf of rings obtained by inverting it. When `S ⊆ T` the section `f_S` divides `f_T`, so it
becomes invertible in `𝒪_{f_T}` and there is a unique map `𝒪_{f_S} ⟶ 𝒪_{f_T}` of sheaves of
rings over `𝒪`; these maps compose. This is the system of rings whose products
`∏_{|S| = p} 𝒪_{f_S}` are the terms of the extended alternating Čech complex.

## Main definitions

* `AlgebraicGeometry.RingedSite.prodGlobalSection`: the global section `f_S`.

## Main results

* `AlgebraicGeometry.RingedSite.globalSectionVal_prodGlobalSection`: the value of `f_S` over an
  object is the product of the values there.
* `AlgebraicGeometry.RingedSite.isUnit_toAwaySheaf_prodGlobalSection_of_subset`: for `S ⊆ T`
  every power of `f_S` becomes invertible in `𝒪_{f_T}`.
* `AlgebraicGeometry.RingedSite.existsUnique_awayTransition`: consequently there is a unique
  map `𝒪_{f_S} ⟶ 𝒪_{f_T}` of sheaves of rings compatible with the maps from `𝒪`.
* `AlgebraicGeometry.RingedSite.awayTransition_comp_eq`: those maps compose, for `S ⊆ T ⊆ V`.

## Implementation notes

`f_S` is built from the compatible family of its values rather than from a ring structure on
the global sections: `CategoryTheory.Presheaf.globalSections` is a morphism type, and the
product of the values over each object is compatible with restriction because a ring
homomorphism carries a product to the product of the images.

Divisibility is used only through `Finset.prod_sdiff`: the image of `f_S^n` in `𝒪_{f_T}` times
the image of `f_{T \ S}^n` is the image of `f_T^n`, which is a unit, so the first factor is a
unit. Transition maps and their composites are therefore not constructed by hand but pinned by
the universal property `AlgebraicGeometry.RingedSite.existsUnique_lift_toAwaySheaf` of the
neighbouring file, which is what makes the alternating differential of the Čech complex
well defined and its square zero: the two factorisations of a map `𝒪_{f_S} ⟶ 𝒪_{f_V}` through
an intermediate `T` agree because both lift the same map from `𝒪`.

No `@[stacks]` attribute is attached here, because the carrier of [Stacks, Tag 099B] is
`AlgebraicGeometry.RingedSite.isRightAdjoint_ι_isDerivedComplete_of_forall_isNilpotent` of
`StacksFrontier/AlgebraicGeometry/FormalGeometry/DerivedCompletionRinged/NilpotentIdeal.lean`,
which proves the tag's conclusion for a sheaf of ideals with nilpotent local sections. The
general case — for `ℐ` generated by the global sections above, with the Čech complex as the
completion — needs the equivalence of the vanishing of `R𝑆heafHom_𝒪(𝒪_f, K)` with the vanishing
of the derived limit `T(K, f)` that defines
`AlgebraicGeometry.RingedSite.IsDerivedComplete` — [Stacks, Tag 0997] — together with
[Stacks, Tag 0998]. Neither is available, so nothing here claims the general case.

## References

* [Stacks Project, Tag 099B](https://stacks.math.columbia.edu/tag/099B)
* [Stacks Project, Tag 0997](https://stacks.math.columbia.edu/tag/0997)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u v w

namespace AlgebraicGeometry.RingedSite

variable {X : RingedSite.{u, v, w}}

/-- The product `f_S = ∏_{i ∈ S} f_i` of a finite subfamily of global sections of the structure
sheaf, as a global section. -/
def prodGlobalSection {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))
    (S : Finset (Fin r)) : Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}) :=
  (Presheaf.globalSectionsEquivSections _).symm
    ⟨fun U ↦ ∏ i ∈ S, globalSectionVal (f i) U, fun {U V} g ↦ by
      change (X.O.obj.map g).hom (∏ i ∈ S, globalSectionVal (f i) U) = _
      rw [map_prod]
      exact Finset.prod_congr rfl fun i _ ↦ globalSectionVal_map (f i) g⟩

/-- The value of `f_S` over an object is the product of the values of the `f_i` there. -/
@[simp]
theorem globalSectionVal_prodGlobalSection {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))
    (S : Finset (Fin r)) (U : X.Cᵒᵖ) :
    globalSectionVal (prodGlobalSection f S) U = ∏ i ∈ S, globalSectionVal (f i) U := by
  simp [prodGlobalSection, globalSectionVal]

variable [HasWeakSheafify X.J CommRingCat.{w}]

/-- For `S ⊆ T` every power of `f_S` becomes invertible in `𝒪_{f_T}`: its image times the image
of the corresponding power of `f_{T \ S}` is the image of a power of `f_T`, which is a unit. -/
theorem isUnit_toAwaySheaf_prodGlobalSection_of_subset {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))
    {S T : Finset (Fin r)} (hST : S ⊆ T) (U : X.Cᵒᵖ) (n : ℕ) :
    IsUnit (((toAwaySheaf (prodGlobalSection f T)).hom.app U).hom
      (globalSectionVal (prodGlobalSection f S) U ^ n)) := by
  have hT : IsUnit (((toAwaySheaf (prodGlobalSection f T)).hom.app U).hom
      (globalSectionVal (prodGlobalSection f T) U ^ n)) :=
    isUnit_toAwaySheaf (prodGlobalSection f T) U n
  have key : ((toAwaySheaf (prodGlobalSection f T)).hom.app U).hom
        (globalSectionVal (prodGlobalSection f S) U ^ n) *
      ((toAwaySheaf (prodGlobalSection f T)).hom.app U).hom
        ((∏ i ∈ T \ S, globalSectionVal (f i) U) ^ n) =
      ((toAwaySheaf (prodGlobalSection f T)).hom.app U).hom
        (globalSectionVal (prodGlobalSection f T) U ^ n) := by
    rw [← map_mul]
    congr 1
    rw [globalSectionVal_prodGlobalSection, globalSectionVal_prodGlobalSection, ← mul_pow,
      mul_comm, Finset.prod_sdiff hST]
  exact isUnit_of_mul_isUnit_left (by rw [key]; exact hT)

/-- **The transition map of the localization system.** For `S ⊆ T` there is a unique map
`𝒪_{f_S} ⟶ 𝒪_{f_T}` of sheaves of rings through which the canonical map `𝒪 ⟶ 𝒪_{f_T}`
factors. -/
theorem existsUnique_awayTransition {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))
    {S T : Finset (Fin r)} (hST : S ⊆ T) :
    ∃! φ : awaySheaf (prodGlobalSection f S) ⟶ awaySheaf (prodGlobalSection f T),
      toAwaySheaf (prodGlobalSection f S) ≫ φ = toAwaySheaf (prodGlobalSection f T) :=
  existsUnique_lift_toAwaySheaf (prodGlobalSection f S) _ _
    (isUnit_toAwaySheaf_prodGlobalSection_of_subset f hST)

/-- The transition maps of the localization system compose: for `S ⊆ T ⊆ V` the composite of
the transition maps along `S ⊆ T` and `T ⊆ V` is the transition map along `S ⊆ V`, because both
lift the same map out of the structure sheaf. -/
theorem awayTransition_comp_eq {r : ℕ}
    (f : Fin r → Presheaf.globalSections (X.O.obj ⋙ forget CommRingCat.{w}))
    {S T V : Finset (Fin r)} (hSV : S ⊆ V)
    {φST : awaySheaf (prodGlobalSection f S) ⟶ awaySheaf (prodGlobalSection f T)}
    (hφST : toAwaySheaf (prodGlobalSection f S) ≫ φST = toAwaySheaf (prodGlobalSection f T))
    {φTV : awaySheaf (prodGlobalSection f T) ⟶ awaySheaf (prodGlobalSection f V)}
    (hφTV : toAwaySheaf (prodGlobalSection f T) ≫ φTV = toAwaySheaf (prodGlobalSection f V))
    {φSV : awaySheaf (prodGlobalSection f S) ⟶ awaySheaf (prodGlobalSection f V)}
    (hφSV : toAwaySheaf (prodGlobalSection f S) ≫ φSV = toAwaySheaf (prodGlobalSection f V)) :
    φST ≫ φTV = φSV := by
  obtain ⟨ψ, -, huniq⟩ := existsUnique_awayTransition f hSV
  have h : toAwaySheaf (prodGlobalSection f S) ≫ (φST ≫ φTV) =
      toAwaySheaf (prodGlobalSection f V) := by rw [← Category.assoc, hφST, hφTV]
  rw [huniq (φST ≫ φTV) h, huniq φSV hφSV]

end AlgebraicGeometry.RingedSite

end
