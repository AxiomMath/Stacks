public import StacksFrontier.CategoryTheory.Sites.Cohomology.Slice.DerivedIsomorphismLocality

/-!
# The hypotheses of [Stacks, Tag 099I] on the slices of a site

Let `α : 𝒪 ⟶ 𝒪'` be a homomorphism of sheaves of commutative rings on a site `𝒞` and `ℐ ⊂ 𝒪` a
sheaf of ideals. [Stacks, Tag 099I] assumes that `α` is flat, that `𝒪/ℐ ≅ 𝒪'/ℐ𝒪'`, and that `ℐ`
is of finite type; its proof works locally, on objects `U` over which `ℐ` is generated by finitely
many sections, where [Stacks, Tag 099H] applies to those sections read as global sections of
`𝒪|_U`. This file restricts each hypothesis to such a slice `𝒞/U` and proves the resulting local
statement.

## Main results

* `Stacks.SheafOfModules.DerivedRestrictScalars.isFlatMap_overRingHom`: flatness restricts.
* `Stacks.SheafOfModules.DerivedRestrictScalars.isIso_tensorUnitMap_cokernel_over`: the condition
  `𝒪/ℐ ≅ 𝒪'/ℐ𝒪'` restricts.
* `Stacks.SheafOfModules.DerivedRestrictScalars.isLocallyGeneratedBySections_over`: local
  generators of `ℐ` generate `ℐ|_U` in the sense [Stacks, Tag 099H] asks.
* `Stacks.SheafOfModules.DerivedRestrictScalars.isIso_overDerivedSheafHom_ringModuleMap`: on such
  a slice, `R𝑆heafHom(η[0], Y)|_U` is invertible for every `Y` derived complete along `ℐ`, where
  `η : 𝒪 ⟶ 𝒪'` is `α` read as a map of `𝒪`-modules.

## Implementation notes

The condition `𝒪/ℐ ≅ 𝒪'/ℐ𝒪'` is carried in the form [Stacks, Tag 099H] and [Stacks, Tag 0GLY] take
it: an isomorphism `𝒪/ℐ ≅ (𝒪 ⊗_𝒪 𝒪')/(ℐ ⊗_𝒪 𝒪')` compatible with `x ↦ x ⊗ 1`, that is,
`𝒪/ℐ ⟶ (𝒪/ℐ) ⊗_𝒪 𝒪'` is an isomorphism (`isIso_tensorUnitMap_cokernel_of_iso` and its converse).
Since `(𝒪/ℐ) ⊗_𝒪 𝒪' = 𝒪'/ℐ𝒪'`, this is the source's hypothesis. In this form it restricts to a
slice because restriction is exact and commutes with extension of scalars
(`tensorUnitMap_over`).

## References

* [Stacks Project, Tag 099H](https://stacks.math.columbia.edu/tag/099H)
* [Stacks Project, Tag 099I](https://stacks.math.columbia.edu/tag/099I)
* [Stacks Project, Tag 0E8J](https://stacks.math.columbia.edu/tag/0E8J)
* [Stacks Project, Tag 0GLY](https://stacks.math.columbia.edu/tag/0GLY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite MonoidalCategory
open scoped TensorProduct

universe u

namespace Stacks.SheafOfModules.DerivedRestrictScalars

open _root_.AlgebraicGeometry
open Stacks.Sheaves.FlatNeighbourhood (RestrictedRingModule tensorUnitMap tensorUnitComplexMap
  RingModule)

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  {O O' : Sheaf J CommRingCat.{u}} (α : O ⟶ O') (V : C)

/-- **The restriction `α|_V : 𝒪|_V ⟶ 𝒪'|_V` of a homomorphism of sheaves of rings to a slice.** -/
abbrev overRingHom : O.over V ⟶ O'.over V :=
  ((Over.forget V).sheafPushforwardContinuous CommRingCat.{u} (J.over V) J).map α

/-- **Extension of scalars commutes with restriction to a slice.** The restriction to `C/V` of
the canonical map `M ⟶ M ⊗_𝒪 𝒪'`, `x ↦ x ⊗ 1`, followed by the identification
`(M ⊗_𝒪 𝒪')|_V ≅ M|_V ⊗_{𝒪|_V} 𝒪'|_V` of `Stacks.SheafOfModules.TensorPower.overTensorSheafIso`,
is the canonical map for `α|_V`. Both are compared on sections, where each is the class of
`x ⊗ 1`; the identification is characterized on such classes by
`Stacks.SheafOfModules.TensorPower.whiskerTensorSheafIso_hom`. -/
theorem tensorUnitMap_over (M : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)) :
    (SheafOfModules.overFunctor _ V).map (tensorUnitMap α M).val ≫
        (Stacks.SheafOfModules.TensorPower.overTensorSheafIso O.obj
          (Stacks.SheafOfModules.Tensor.ringSheaf O).cond V M
          (RestrictedRingModule α)).hom =
      (tensorUnitMap (overRingHom α V) (M.over V)).val := by
  apply (SheafOfModules.fullyFaithfulForget _).map_injective
  refine PresheafOfModules.hom_ext fun W => ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
  have h := Stacks.SheafOfModules.TensorPower.whiskerTensorSheafIso_hom (J' := J.over V) O.obj
      (Stacks.SheafOfModules.Tensor.ringSheaf O).property (Over.forget V) M
      (RestrictedRingModule α)
  have key := fun z => congrArg (fun k => (PresheafOfModules.Hom.app k W).hom z) h
  let x' : M.val.obj (op W.unop.left) := x
  have k1 := key (x' ⊗ₜ[O.obj.obj (op W.unop.left)]
    Stacks.Sheaves.FlatNeighbourhood.restrictedOne α (op W.unop.left))
  refine Eq.trans ?_ (((tensorUnitMap (overRingHom α V) (M.over V)).2 W x).symm)
  refine Eq.trans ?_ k1
  exact congrArg (fun z => ((Stacks.SheafOfModules.TensorPower.overTensorSheafIso O.obj
      (Stacks.SheafOfModules.Tensor.ringSheaf O).property V M
      (RestrictedRingModule α)).hom.val.app W).hom z) ((tensorUnitMap α M).2 (op W.unop.left) x)

section Quotient

variable {O₁ O₂ : Sheaf J CommRingCat.{u}} (β : O₁ ⟶ O₂)
  [PreservesFiniteColimits (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
    (RestrictedRingModule β)))]
  {I : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O₁)}
  (i : I ⟶ RingModule O₁)

/-- The canonical map `x ↦ x ⊗ 1` on `𝒪/ℐ` is the one on `𝒪` passed to the cokernels, the
cokernel of `ℐ ⊗ 𝒪' ⟶ 𝒪 ⊗ 𝒪'` being `(𝒪/ℐ) ⊗ 𝒪'` because `- ⊗_𝒪 𝒪'` is right exact. -/
theorem tensorUnitMap_cokernel_eq :
    cokernel.π i ≫ (tensorUnitMap β (cokernel i)).val =
      (tensorUnitMap β (RingModule O₁)).val ≫ cokernel.π
        ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
          (RestrictedRingModule β))).map i) ≫
        (PreservesCokernel.iso
          (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
            (RestrictedRingModule β))) i).inv := by
  rw [Stacks.Sheaves.FlatNeighbourhood.tensorUnitMap_naturality, ← PreservesCokernel.π_iso_hom,
    Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- **The hypothesis "`𝒪/ℐ ≅ 𝒪'/ℐ𝒪'`" of [Stacks, Tag 099H], restated.** An isomorphism
`e : 𝒪/ℐ ≅ (𝒪 ⊗ 𝒪')/(ℐ ⊗ 𝒪')` compatible with `x ↦ x ⊗ 1` makes the canonical map
`𝒪/ℐ ⟶ (𝒪/ℐ) ⊗_𝒪 𝒪'` invertible. -/
theorem isIso_tensorUnitMap_cokernel_of_iso
    (e : cokernel i ≅ cokernel
      ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
        (RestrictedRingModule β))).map i))
    (he : cokernel.π i ≫ e.hom = (tensorUnitMap β (RingModule O₁)).val ≫ cokernel.π
      ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
        (RestrictedRingModule β))).map i)) :
    IsIso (tensorUnitMap β (cokernel i)).val := by
  have h : (tensorUnitMap β (cokernel i)).val = e.hom ≫ (PreservesCokernel.iso
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
        (RestrictedRingModule β))) i).inv := by
    refine coequalizer.hom_ext ?_
    rw [tensorUnitMap_cokernel_eq, ← Category.assoc, ← he, Category.assoc]
  rw [h]
  infer_instance

/-- The converse of `isIso_tensorUnitMap_cokernel_of_iso`: an invertible canonical map
`𝒪/ℐ ⟶ (𝒪/ℐ) ⊗_𝒪 𝒪'` gives the isomorphism in the form [Stacks, Tag 099H] takes. -/
theorem exists_iso_of_isIso_tensorUnitMap_cokernel
    (h : IsIso (tensorUnitMap β (cokernel i)).val) :
    ∃ e : cokernel i ≅ cokernel
        ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
          (RestrictedRingModule β))).map i),
      cokernel.π i ≫ e.hom = (tensorUnitMap β (RingModule O₁)).val ≫ cokernel.π
        ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
          (RestrictedRingModule β))).map i) := by
  refine ⟨asIso (tensorUnitMap β (cokernel i)).val ≪≫ PreservesCokernel.iso
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O₁).flip.obj
        (RestrictedRingModule β))) i, ?_⟩
  rw [Iso.trans_hom, asIso_hom, ← Category.assoc, tensorUnitMap_cokernel_eq, Category.assoc,
    Category.assoc, Iso.inv_hom_id, Category.comp_id]

end Quotient

section Slice

/-- Restriction of sheaves of `𝒪`-modules to the slice over `V`, with its target written over the
restricted sheaf of rings `𝒪|_V` itself. -/
abbrev overModules :
    SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O) ⥤
      SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (O.over V)) :=
  SheafOfModules.overFunctor _ V

/-- Restriction to a slice is right exact. -/
instance : PreservesFiniteColimits (overModules (O := O) V) :=
  Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits V

/-- Restriction to a slice is left exact. -/
instance : PreservesFiniteLimits (overModules (O := O) V) :=
  Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits V

variable
  [PreservesFiniteLimits (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
    (RestrictedRingModule α)))]
  [PreservesFiniteColimits (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
    (RestrictedRingModule α)))]

/-- **A flat homomorphism stays flat on a slice**, by [Stacks, Tag 0E8J]
(`Stacks.SheafOfModules.FlatRestriction.isFlat_over`) applied to `𝒪'` viewed as an `𝒪`-module. -/
theorem isFlatMap_overRingHom : AlgebraicGeometry.SheafOfModules.IsFlatMap (overRingHom α V) :=
  Stacks.SheafOfModules.FlatRestriction.isFlat_over (ringedSite J O) V (RestrictedRingModule α)
    (Stacks.Sheaves.FlatNeighbourhood.isFlatMap_of_preservesFiniteLimitsColimits α)

/-- `- ⊗ 𝒪'|_V` is left exact, by `isFlatMap_overRingHom`. -/
instance preservesFiniteLimits_sheafTensorRight_overRingHom :
    PreservesFiniteLimits
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} (O.over V)).flip.obj
        (RestrictedRingModule (overRingHom α V)))) :=
  ((exactFunctor_iff _).mp (isFlatMap_overRingHom α V)).1

/-- `- ⊗ 𝒪'|_V` is right exact. -/
instance preservesFiniteColimits_sheafTensorRight_overRingHom :
    PreservesFiniteColimits
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} (O.over V)).flip.obj
        (RestrictedRingModule (overRingHom α V)))) :=
  ((exactFunctor_iff _).mp (isFlatMap_overRingHom α V)).2

/-- An invertible canonical map `M ⟶ M ⊗_𝒪 𝒪'` stays invertible on a slice, by
`tensorUnitMap_over`. -/
theorem isIso_tensorUnitMap_over (M : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O))
    (h : IsIso (tensorUnitMap α M).val) :
    IsIso (tensorUnitMap (overRingHom α V) ((overModules V).obj M)).val := by
  have key : IsIso ((SheafOfModules.overFunctor _ V).map (tensorUnitMap α M).val ≫
      (Stacks.SheafOfModules.TensorPower.overTensorSheafIso O.obj
          (Stacks.SheafOfModules.Tensor.ringSheaf O).property V M
          (RestrictedRingModule α)).hom) := by
    have : IsIso ((SheafOfModules.overFunctor _ V).map (tensorUnitMap α M).val) :=
      Functor.map_isIso _ _
    exact IsIso.comp_isIso' this (Iso.isIso_hom _)
  exact (tensorUnitMap_over α V M) ▸ key

variable {I : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)}
  (i : I ⟶ RingModule O)

/-- **"`𝒪/ℐ ≅ 𝒪'/ℐ𝒪'`" restricts to a slice.** If `𝒪/ℐ ⟶ (𝒪/ℐ) ⊗_𝒪 𝒪'` is invertible then so
is the corresponding map for `ℐ|_V ⊂ 𝒪|_V` and `α|_V`: restriction to a slice is exact, so it
carries `𝒪/ℐ` to `𝒪|_V/ℐ|_V`, and it commutes with extension of scalars. -/
theorem isIso_tensorUnitMap_cokernel_over (h : IsIso (tensorUnitMap α (cokernel i)).val) :
    IsIso (tensorUnitMap (overRingHom α V) (cokernel ((overModules V).map i))).val := by
  let c := PreservesCokernel.iso (overModules (O := O) V) i
  rw [(Iso.eq_inv_comp c).mpr
    (Stacks.Sheaves.FlatNeighbourhood.tensorUnitMap_naturality (overRingHom α V) c.hom)]
  exact IsIso.comp_isIso' (Iso.isIso_inv c)
    (IsIso.comp_isIso' (isIso_tensorUnitMap_over α V (cokernel i) h) (Functor.map_isIso _ _))

end Slice

section Restriction

/-- The restriction of `η = α` to a slice is `η` for `α|_V`, on the nose. -/
theorem overModules_map_ringModuleMap :
    (SheafOfModules.overFunctor.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V).map
        (RingedSite.ringModuleMap (ringedSite J O) α) =
      RingedSite.ringModuleMap ((ringedSite J O).over V) (overRingHom α V) := rfl

/-- The restriction of the rank-one module to a slice is the rank-one module of the slice
(`Stacks.SheafOfModules.FiniteTypeKernel.unitOverIso`). -/
def overUnitIso :
    (SheafOfModules.overFunctor.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V).obj
      (SheafOfModules.unit
        ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O))) ≅
      SheafOfModules.unit
        ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} ((ringedSite J O).over V).O)) :=
  (Stacks.SheafOfModules.FiniteTypeKernel.unitOverIso V).symm

/-- The restriction of `𝒪'` to a slice, read as an `𝒪|_V`-module, is `𝒪'|_V`. -/
def overRestrictedRingModuleIso :
    (SheafOfModules.overFunctor.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V).obj
      (RestrictedRingModule α) ≅ RestrictedRingModule (overRingHom α V) := Iso.refl _

/-- `overModules_map_ringModuleMap` as an isomorphism of arrows. -/
def overRingModuleMapArrowIso₀ :
    Arrow.mk ((SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V).map
      (RingedSite.ringModuleMap (ringedSite J O) α)) ≅
    Arrow.mk (RingedSite.ringModuleMap ((ringedSite J O).over V) (overRingHom α V)) :=
  Arrow.isoMk (overUnitIso V) (overRestrictedRingModuleIso α V) (by
    simp only [overUnitIso, overRestrictedRingModuleIso, Iso.symm_hom,
      Stacks.SheafOfModules.FiniteTypeKernel.unitOverIso_inv, Iso.refl_hom, Category.id_comp,
      Category.comp_id, Arrow.mk_hom]
    exact (overModules_map_ringModuleMap α V).symm)

attribute [local instance] HasDerivedCategory.standard

/-- Restriction to a slice is right exact. -/
instance : PreservesFiniteColimits
    (SheafOfModules.overFunctor.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V) :=
  Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits V

/-- Restriction to a slice is left exact. -/
instance : PreservesFiniteLimits
    (SheafOfModules.overFunctor.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V) :=
  Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits V

/-- **The restriction of `η[0]` to a slice, in `D(𝒪|_V)`**, is the image of the restricted map
`η|_V` in degree zero: derived restriction is computed degreewise
(`CategoryTheory.Functor.mapDerivedCategoryFactors`) and commutes with placing in degree zero. -/
def overRingModuleMapArrowIso :
    Arrow.mk ((SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O))
        V).mapDerivedCategory.map
      (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        (RingedSite.ringModuleMap (ringedSite J O) α)))) ≅
    Arrow.mk (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        ((SheafOfModules.overFunctor.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V).map
          (RingedSite.ringModuleMap (ringedSite J O) α)))) :=
  Arrow.isoOfNatIso (SheafOfModules.overFunctor.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O))
        V).mapDerivedCategoryFactors
      (Arrow.mk ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        (RingedSite.ringModuleMap (ringedSite J O) α))) ≪≫
    DerivedCategory.Q.mapArrow.mapIso (Arrow.isoOfNatIso
      (HomologicalComplex.singleMapHomologicalComplex
        (SheafOfModules.overFunctor.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)) V)
          (ComplexShape.up ℤ) 0)
      (Arrow.mk (RingedSite.ringModuleMap (ringedSite J O) α)))

end Restriction

section Generation

/-- **Local generators of `ℐ` generate `ℐ|_U` on the slice, in the sense of [Stacks, Tag 099H].**
If finitely many sections `s_j` of `ℐ` over `U` generate `ℐ` sectionwise
(`PresheafOfModules.Generates`), then every section of `ℐ|_U` is, locally on `C/U`, an
`𝒪|_U`-linear combination of the `s_j` read as global sections of `𝒪|_U`
(`AlgebraicGeometry.RingedSite.globalSectionOfSection`). -/
theorem isLocallyGeneratedBySections_over
    (I : _root_.SheafOfModules.Submodule
      (_root_.SheafOfModules.unit
        ((Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} (ringedSite J O).O)))) (U : C) {n : ℕ}
    (s : Fin n → I.toSheafOfModules.val.obj (op U))
    (hs : PresheafOfModules.Generates J I.toSheafOfModules.val s) :
    Stacks.Sheaves.CechFlatNeighbourhood.IsLocallyGeneratedBySections.{u} (J := J.over U)
      (O.over U) (fun j => RingedSite.globalSectionOfSection (ringedSite J O) U (s j).val)
      ((overModules (O := O) U).map I.ι) := by
  intro Y t
  obtain ⟨S, hS, hcomb⟩ := hs Y.unop.left Y.unop.hom t
  refine ⟨(Sieve.overEquiv Y.unop).symm S, J.overEquiv_symm_mem_over _ S hS, ?_⟩
  intro Z g hg
  obtain ⟨a, ha⟩ := hcomb Z.left g.left hg
  refine ⟨a, ?_⟩
  refine Eq.trans (show _ = (I.ι.val.app (op Z.left)).hom
    ((I.toSheafOfModules.val.restrictₛₗ g.left.op) t) from rfl) ?_
  rw [← ha, map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_smul]
  refine (smul_eq_mul (a k) _).trans (congrArg (a k * ·) ?_)
  refine Eq.trans ?_ (RingedSite.globalSectionVal_globalSectionOfSection (ringedSite J O) U
    (s k).val (op Z)).symm
  rw [← Over.w g]
  rfl

end Generation

/-- A contravariant functor inverting a map inverts every map isomorphic to it as an arrow. -/
theorem isIso_map_op_of_arrow_iso {𝒜 𝒟 : Type*} [Category 𝒜] [Category 𝒟] (G : 𝒜ᵒᵖ ⥤ 𝒟)
    {f g : Arrow 𝒜} (e : f ≅ g) (h : IsIso (G.map g.hom.op)) : IsIso (G.map f.hom.op) := by
  have hw : f.hom = e.hom.left ≫ g.hom ≫ e.inv.right := by
    rw [← Category.assoc, Arrow.w e.hom, Category.assoc, ← Arrow.comp_right, e.hom_inv_id,
      Arrow.id_right, Category.comp_id]
  rw [hw, op_comp, op_comp, G.map_comp, G.map_comp]
  infer_instance

/-- `isIso_map_op_of_arrow_iso` for a bifunctor evaluated at a fixed second argument. -/
theorem isIso_app_map_op_of_arrow_iso {𝒜 𝒜' 𝒟 : Type*} [Category 𝒜] [Category 𝒜'] [Category 𝒟]
    (G : 𝒜ᵒᵖ ⥤ 𝒜' ⥤ 𝒟) (Y : 𝒜') {f g : Arrow 𝒜} (e : f ≅ g)
    (h : IsIso ((G.map g.hom.op).app Y)) : IsIso ((G.map f.hom.op).app Y) :=
  isIso_map_op_of_arrow_iso (G.flip.obj Y) e h

section Local

attribute [local instance] HasDerivedCategory.standard

variable
  [PreservesFiniteLimits (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
    (RestrictedRingModule α)))]
  [PreservesFiniteColimits (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
    (RestrictedRingModule α)))]
  (I : _root_.SheafOfModules.Submodule
      (_root_.SheafOfModules.unit
