module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatNeighbourhoodCech
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorIdealImage
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.IdealOfGlobalSections

/-!
# Extending the ideal generated by global sections

Let `φ : 𝒪 ⟶ 𝒪'` be a homomorphism of sheaves of commutative rings on a site and let
`f_1, …, f_r` be global sections of `𝒪`. The sheaf of ideals of `𝒪'` generated by the image of
`(f_1, …, f_r)` is the sheaf of ideals generated by the images `φ(f_1), …, φ(f_r)`:
`(f_1, …, f_r)𝒪' = (φ(f_1), …, φ(f_r))`.

## Main results

* `Stacks.Sheaves.CechFlatNeighbourhood.extendedIdeal_idealOfGlobalSections`:
  `(f_1, …, f_r)𝒪' = (φ(f_1), …, φ(f_r))`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

open AlgebraicGeometry AlgebraicGeometry.RingedSite

namespace Stacks.Sheaves.CechFlatNeighbourhood

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasSheafify J AddCommGrpCat.{u}]
  [HasWeakSheafify J CommRingCat.{u}]
  (O : Sheaf J CommRingCat.{u}) {r : ℕ}
  (f : Fin r → Presheaf.globalSections (O.obj ⋙ forget CommRingCat.{u}))
  {O' : Sheaf J CommRingCat.{u}} (φ : O ⟶ O')

omit [J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasSheafify J AddCommGrpCat.{u}]
  [HasWeakSheafify J CommRingCat.{u}] in
/-- **`(f_1, …, f_r)𝒪' = (φ(f_1), …, φ(f_r))`.** The sheaf of ideals of `𝒪'` generated by the
image of the sheaf of ideals `(f_1, …, f_r) ⊂ 𝒪` is the sheaf of ideals generated by the images
of the `f_i`. A section of `(f_1, …, f_r)` is locally an `𝒪`-linear combination of the `f_i`, so
its image is locally an `𝒪'`-linear combination of the `φ(f_i)`; conversely each `φ(f_i)` is the
image of a section of `(f_1, …, f_r)`. -/
theorem extendedIdeal_idealOfGlobalSections :
    Stacks.Sheaves.FlatNeighbourhood.extendedIdeal φ (idealOfGlobalSections (ringedSite O) f) =
      idealOfGlobalSections (ringedSite O') (baseChangeFamily O f φ) := by
  refine le_antisymm (extendIdeal_le _ _ _ fun U x hx ↦ ?_)
    (idealOfGlobalSections_le _ _ fun i V ↦ ?_)
  · obtain ⟨S, hS, hSx⟩ := (mem_idealOfGlobalSections_iff (ringedSite O) f U).1 hx
    refine (idealOfGlobalSections (ringedSite O') (baseChangeFamily O f φ)).isSheaf _
      (J.superset_covering (fun Y g hg ↦ ?_) hS)
    have hspan : Ideal.span (Set.range (restrictGlobalSections (ringedSite O) f (op Y))) ≤
        Ideal.comap (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app
          (op Y)).hom
          (Ideal.span (Set.range (restrictGlobalSections (ringedSite O')
            (baseChangeFamily O f φ) (op Y)))) := by
      refine Ideal.span_le.2 ?_
      rintro _ ⟨i, rfl⟩
      exact Ideal.subset_span ⟨i, rfl⟩
    have hmem := mem_idealOfGlobalSections_of_mem_span (ringedSite O') (baseChangeFamily O f φ)
      (op Y) (hspan (hSx g hg))
    have hnat := NatTrans.naturality_apply
      ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom g.op x
    exact (congrArg (· ∈ _) hnat).mp hmem
  · exact mem_extendIdeal_of_mem _ _ V _
      (globalSectionVal_mem_idealOfGlobalSections (ringedSite O) f i V)

end Stacks.Sheaves.CechFlatNeighbourhood

end
