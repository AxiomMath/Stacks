/-! ### Bridging instances

Each instance below is an existing instance restated at the spelling instance search meets, so
nothing new is assumed. -/

/-- On a scheme, multiplication on the sections of the structure sheaf is commutative. -/
local instance ringCatSheafIsMulCommutative (X : Scheme.{u}) :
    ∀ U, IsMulCommutative (X.ringCatSheaf.obj.obj U) :=
  fun U => inferInstanceAs (IsMulCommutative (X.presheaf.obj U))

/-! ### Powers of a global section and the ideal they generate -/

/-- The `n`-th power of a natural endomorphism of the identity functor acts on local sections of
a module over a scheme as multiplication by the `n`-th power of the local scalar. -/
theorem scalarActionLocal_pow {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (M : X.Modules)
    (U : X.Opens) (n : ℕ) (x : Γ(M, U)) :
    (Scheme.Modules.Hom.app ((f ^ n).app M) U) x = scalarAt f U ^ n • x := by
  induction n generalizing x with
  | zero =>
    have hone : (f ^ 0).app M = 𝟙 M := by rw [pow_zero]; rfl
    have hid : (Scheme.Modules.Hom.app ((f ^ 0).app M) U) x = x :=
      (congrArg (fun g => ConcreteCategory.hom (Scheme.Modules.Hom.app g U) x) hone).trans
        (congrArg (fun g : Γ(M, U) ⟶ Γ(M, U) => ConcreteCategory.hom g x)
          (Scheme.Modules.Hom.id_app M))
    rw [hid, pow_zero, one_smul]
  | succ n ih =>
    rw [← mulF_pow_succ f M n]
    change (Scheme.Modules.Hom.app ((f ^ n).app M) U)
        ((Scheme.Modules.Hom.app (f.app M) U) x) = scalarAt f U ^ (n + 1) • x
    rw [ih, scalarActionLocal f M U x, ← mul_smul, pow_succ]

/-- The quasi-coherent ideal sheaf generated by the global section through which a natural
endomorphism of the identity functor acts. -/
def scalarIdealData {X : Scheme.{u}} (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) :
    X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (Ideal.span {scalarAt f ⊤})

/-- A principal ideal sheaf is of finite type. -/
theorem scalarIdealData_finiteType {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) :
    Scheme.IdealSheafData.IsFiniteType (scalarIdealData f) := by
  intro U
  change (Ideal.map (X.presheaf.map (homOfLE le_top).op).hom
    (Ideal.span {scalarAt f ⊤})).FG
  have hfg : (Ideal.span {scalarAt f ⊤}).FG := ⟨{scalarAt f ⊤}, by simp⟩
  exact Ideal.FG.map hfg _

/-- The defining description of the principal ideal sheaf on an affine open: the ideal there is
the extension of the ideal generated by the global scalar. -/
theorem scalarIdealData_ideal_eq_map {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (U : X.affineOpens) :
    (scalarIdealData f).ideal U =
      Ideal.map (X.presheaf.map (homOfLE le_top).op).hom (Ideal.span {scalarAt f ⊤}) := rfl

/-- On an affine open the principal ideal sheaf is generated by the restriction of the global
scalar. -/
theorem scalarIdealData_ideal {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (U : X.affineOpens) :
    (scalarIdealData f).ideal U = Ideal.span {scalarAt f U.1} := by
  rw [scalarIdealData_ideal_eq_map, Ideal.map_span]
  simp only [Set.image_singleton]
  rw [(scalarAt_res f (homOfLE le_top)).symm]

/-! ### The ideal-power subsheaf of a principal ideal sheaf -/

/-- A section lies in the sectionwise kernel of a morphism exactly when the morphism kills it. -/
theorem mem_kernelSubmodule_iff {X : Scheme.{u}} {F G : X.Modules} (g : F ⟶ G)
    (U : (Opens X)ᵒᵖ) (y : F.val.obj U) :
    y ∈ (kernelSubmodule g).toSubmodule.obj U ↔ (g.val.app U).hom y = 0 :=
  (SetLike.ext_iff.mp (kernelSubmodule_toSubmodule_obj g U) y).trans LinearMap.mem_ker

/-- Multiplication by `fⁿ` kills the ideal-power subsheaf `(f)ⁿ M` modulo the image of `fⁿ`:
the subsheaf is contained in the kernel of the projection to the cokernel of `fⁿ`. -/
theorem principalPower_kills_cokernel {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (M : X.Modules) (n : ℕ) :
    (idealPowerMultiple (scalarIdealData f) n M).ι ≫ cokernel.π ((f ^ n).app M) = 0 := by
  let P := idealPowerMultiple (scalarIdealData f) n M
  let π := cokernel.π ((f ^ n).app M)
  have hPK : P ≤ kernelSubmodule π := by
    apply (idealPowerMultiple_le_iff (scalarIdealData f) n M (kernelSubmodule π)).2
    intro U
    rw [scalarIdealData_ideal f U]
    apply Submodule.smul_le.mpr
    intro a ha x _
    have ha' : a ∈ Ideal.span {scalarAt f U.1 ^ n} := by
      simpa [Ideal.span_singleton_pow] using ha
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ha'
    have hax : a • x = scalarAt f U.1 ^ n • (b • x) := by
      calc
        a • x = (b * scalarAt f U.1 ^ n) • x := by rw [hb]
        _ = (scalarAt f U.1 ^ n * b) • x := by rw [mul_comm]
        _ = scalarAt f U.1 ^ n • (b • x) := (smul_smul _ _ _).symm
    have hc : ((f ^ n).app M).val.app (op U.1) ≫ π.val.app (op U.1) = 0 := by
      have hc0 := congrArg (fun q => q.val) (cokernel.condition ((f ^ n).app M))
      have hc1 := congrArg (fun q => q.app (op U.1)) hc0
      change ((f ^ n).app M).val.app (op U.1) ≫ π.val.app (op U.1) = 0 at hc1
      exact hc1
    have hzero : (π.val.app (op U.1)).hom
        ((Scheme.Modules.Hom.app ((f ^ n).app M) U.1) (b • x)) = 0 := by
      have hz := congrArg (fun q => q.hom (b • x)) hc
      exact hz
    refine (mem_kernelSubmodule_iff π (op U.1) (a • x)).mpr ?_
    rw [hax, ← scalarActionLocal_pow f M U.1 n (b • x)]
    exact hzero
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.Hom.ext
  funext U
  apply ModuleCat.Hom.ext
  ext x
  exact (mem_kernelSubmodule_iff π U x.val).mp
    ((SheafOfModules.Submodule.le_iff.mp hPK) U x.property)

/-- Multiplication by `fⁿ` lands in the ideal-power subsheaf `(f)ⁿ M`. -/
theorem principalPower_mem_idealPower {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (M : X.Modules)
    (n : ℕ) (V : X.Opens) (x : Γ(M, V)) :
    (Scheme.Modules.Hom.app ((f ^ n).app M) V) x ∈
      (idealPowerMultiple (scalarIdealData f) n M).toSubmodule.obj (op V) := by
  let P := idealPowerMultiple (scalarIdealData f) n M
  let s := (Scheme.Modules.Hom.app ((f ^ n).app M) V) x
  let T := P.toSubmodule.toSubfunctor.sieveOfSection s
  have hT : T ∈ Opens.grothendieckTopology X V := by
    rw [Opens.mem_grothendieckTopology]
    intro z hz
    obtain ⟨V', hV', hzV', hV'V⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open hz V.2
    obtain ⟨W, hWaff, hWV'⟩ := hV'
    let A : X.affineOpens := ⟨W, hWaff⟩
    have hAV : (A : X.Opens) ≤ V := by
      change (W : Set X) ⊆ (V : Set X)
      rw [hWV']
      exact hV'V
    have hzA : z ∈ (A : X.Opens) := by
      change z ∈ (W : Set X)
      rw [hWV']
      exact hzV'
    refine ⟨A, homOfLE hAV, ?_, hzA⟩
    change M.val.map (homOfLE hAV).op (((f ^ n).app M).val.app (op V) x) ∈
      P.toSubmodule.obj (op (A : X.Opens))
    have hgen := (idealPowerMultiple_le_iff (scalarIdealData f) n M P).mp le_rfl A
    have hr : scalarAt f A.1 ^ n ∈ (scalarIdealData f).ideal A ^ n := by
      rw [scalarIdealData_ideal f A]
      exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n
    let xA : Γ(M, A) := M.val.map (homOfLE hAV).op x
    have hmul : scalarAt f A.1 ^ n • xA ∈
        (scalarIdealData f).ideal A ^ n • (⊤ : Submodule Γ(X, A) Γ(M, A)) :=
      Submodule.smul_mem_smul hr Submodule.mem_top
    have hres : M.val.map (homOfLE hAV).op (((f ^ n).app M).val.app (op V) x) =
        scalarAt f A.1 ^ n • xA := by
      have hn := congrArg (fun q => q.hom x)
        (((f ^ n).app M).val.naturality (homOfLE hAV).op)
      have hn' : M.val.map (homOfLE hAV).op (((f ^ n).app M).val.app (op V) x) =
          ((f ^ n).app M).val.app (op A.1) xA := by
        have hpoint : (((f ^ n).app M).val.app (op A.1)).hom
            ((M.val.map (homOfLE hAV).op).hom x) =
            (M.val.map (homOfLE hAV).op).hom
              (((f ^ n).app M).val.app (op V) x) := hn
        exact hpoint.symm
      rw [hn']
      exact scalarActionLocal_pow f M A.1 n xA
    rw [hres]
    exact hgen hmul
  exact P.isSheaf s hT

/-- Multiplication by `fⁿ`, corestricted to the ideal-power subsheaf `(f)ⁿ M`. -/
def principalPowerFactor {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (M : X.Modules) (n : ℕ) :
    M ⟶ (idealPowerMultiple (scalarIdealData f) n M).toSheafOfModules := by
  let d : M.val ⟶ (idealPowerMultiple (scalarIdealData f) n M).toSheafOfModules.val := {
    app := fun U => ModuleCat.ofHom {
      toFun := fun x => ⟨((f ^ n).app M).val.app U x,
        principalPower_mem_idealPower f M n U.unop x⟩
      map_add' := by intro x y; exact Subtype.ext (map_add _ _ _)
      map_smul' := by intro r x; exact Subtype.ext (map_smul _ _ _) }
    naturality := by
      intro U V i
      apply ModuleCat.Hom.ext
      ext x
      apply Subtype.ext
      have hn := congrArg (fun q => q.hom x) (((f ^ n).app M).val.naturality i)
      exact hn }
  exact ⟨d⟩

/-- The corestriction of multiplication by `fⁿ`, composed with the inclusion of `(f)ⁿ M`, is
multiplication by `fⁿ`. -/
theorem principalPowerFactor_comp {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (M : X.Modules) (n : ℕ) :
    principalPowerFactor f M n ≫ (idealPowerMultiple (scalarIdealData f) n M).ι =
      (f ^ n).app M := by
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.Hom.ext
  funext U
  apply ModuleCat.Hom.ext
  ext x
  rfl

/-- For the principal ideal sheaf `(f)`, the ideal-power quotient `M / (f)ⁿ M` is the cokernel
of multiplication by `fⁿ`, compatibly with the two quotient projections.

The two subsheaves `(f)ⁿ M` and the image of `fⁿ` need not agree, but each quotient projection
kills the other subsheaf, so the two cokernels have the same universal property. -/
theorem principalPowerQuotientIso {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf))) (M : X.Modules) (n : ℕ) :
    ∃ e : idealPowerQuotient (scalarIdealData f) n M ≅ powQuotient f M n,
      cokernel.π ((idealPowerMultiple (scalarIdealData f) n M).ι) ≫ e.hom =
        cokernel.π ((f ^ n).app M) := by
  let P := idealPowerMultiple (scalarIdealData f) n M
  let πP := cokernel.π P.ι
  let πf := cokernel.π ((f ^ n).app M)
  have hPπ : P.ι ≫ πf = 0 := principalPower_kills_cokernel f M n
  have hcond : P.ι ≫ πP = 0 := cokernel.condition P.ι
  let e₁ : cokernel P.ι ⟶ cokernel ((f ^ n).app M) := cokernel.desc P.ι πf hPπ
  let e₂ : cokernel ((f ^ n).app M) ⟶ cokernel P.ι :=
    cokernel.desc ((f ^ n).app M) πP
      ((congrArg (fun g => g ≫ πP) (principalPowerFactor_comp f M n).symm).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (fun g => principalPowerFactor f M n ≫ g) hcond).trans comp_zero)))
  have hπ₁ : πP ≫ e₁ = πf := cokernel.π_desc _ _ _
  have hπ₂ : πf ≫ e₂ = πP := cokernel.π_desc _ _ _
  have h₁ : e₁ ≫ e₂ = 𝟙 _ :=
    Cofork.IsColimit.hom_ext (cokernelIsCokernel P.ι)
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ e₂) hπ₁).trans
        (hπ₂.trans (Category.comp_id πP).symm)))
  have h₂ : e₂ ≫ e₁ = 𝟙 _ :=
    Cofork.IsColimit.hom_ext (cokernelIsCokernel ((f ^ n).app M))
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ e₁) hπ₂).trans
        (hπ₁.trans (Category.comp_id πf).symm)))
  exact ⟨{ hom := e₁, inv := e₂, hom_inv_id := h₁, inv_hom_id := h₂ }, hπ₁⟩

/-- Under the second condition of Stacks 0H39, the `n`-th term of the system is the cokernel of
multiplication by `f^(n+1)` on the `(n+1)`-st term, compatibly with the transition map. -/
theorem conditionTwo_powQuotientIso {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf)))
    (obj : ℕ → X.Modules) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (h₂ : Condition2 f obj map) (n : ℕ) :
    ∃ e : powQuotient f (obj (n + 1)) (n + 1) ≅ obj n,
      cokernel.π ((f ^ (n + 1)).app (obj (n + 1))) ≫ e.hom = map n := by
  obtain ⟨j, w, hp, hS⟩ := h₂ n
  have hepiMap : ∀ m, Epi (map m) := by
    intro m
    obtain ⟨j', w', hp', hS'⟩ := h₂ m
    exact hS'.epi_g
  have hepiProj : ∀ m, Epi (proj obj map m) := by
    intro m
    induction m with
    | zero => change Epi (𝟙 (obj 0)); infer_instance
    | succ m ih =>
        change Epi (map m ≫ proj obj map m)
        exact epi_comp' (hepiMap m) ih
  have hzero : (f ^ (n + 1)).app (obj (n + 1)) ≫ map n = (0 : obj (n + 1) ⟶ obj n) :=
    (congrArg (fun g => g ≫ map n) hp.symm).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (fun g => proj obj map (n + 1) ≫ g) w).trans comp_zero))
  have hcol : IsColimit (CokernelCofork.ofπ (map n) hzero) := by
    letI := hepiProj (n + 1)
    exact isCokernelEpiComp hS.gIsCokernel (proj obj map (n + 1))
      (show (f ^ (n + 1)).app (obj (n + 1)) = proj obj map (n + 1) ≫ j from hp.symm)
  let e : cokernel ((f ^ (n + 1)).app (obj (n + 1))) ≅ obj n :=
    (cokernelIsCokernel ((f ^ (n + 1)).app (obj (n + 1)))).coconePointUniqueUpToIso hcol
  exact ⟨e, IsColimit.comp_coconePointUniqueUpToIso_hom
    (cokernelIsCokernel ((f ^ (n + 1)).app (obj (n + 1)))) hcol WalkingParallelPair.one⟩

/-- A module jointly monomorphically mapped onto a tower is `f`-torsion-free as soon as
multiplication by `f` on each term of the tower factors as a transition map followed by a
monomorphism.

This is the torsion-freeness half of the fourth condition of Stacks 0H39, stated for an
abstract jointly monic family `p` so that it applies to the limit cone of the system. Two
morphisms into `A` agreeing after multiplication by `f` agree after each `p n`: the
factorization `tr n ≫ up n = f` lets `up n` cancel against naturality of `f`. -/
private theorem mono_app_of_jointly_mono {X : Scheme.{u}}
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf)))
    (A : X.Modules) (B : ℕ → X.Modules) (p : ∀ n : ℕ, A ⟶ B n)
    (hext : ∀ (Y : X.Modules) (g₁ g₂ : Y ⟶ A), (∀ n : ℕ, g₁ ≫ p n = g₂ ≫ p n) → g₁ = g₂)
    (tr : ∀ n : ℕ, B (n + 1) ⟶ B n) (htr : ∀ n : ℕ, p (n + 1) ≫ tr n = p n)
    (up : ∀ n : ℕ, B n ⟶ B (n + 1)) (hup : ∀ n, Mono (up n))
    (hmul : ∀ n : ℕ, tr n ≫ up n = f.app (B (n + 1))) :
    Mono (f.app A) := by
  have key : Mono (C := X.Modules) (f.app A) := by
    refine ⟨?_⟩
    intro Y g₁ g₂ hgg
    refine hext Y g₁ g₂ ?_
    intro n
    have := hup n
    refine (cancel_mono (up n)).1 ?_
    have hπ : p n ≫ up n = f.app A ≫ p (n + 1) :=
      (congrArg (fun q => q ≫ up n) (htr n).symm).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (fun q => p (n + 1) ≫ q) (hmul n)).trans
            (mulF_naturality f (p (n + 1))).symm))
    have step : ∀ g : Y ⟶ A, (g ≫ p n) ≫ up n = (g ≫ f.app A) ≫ p (n + 1) := fun g =>
      (Category.assoc _ _ _).trans
        ((congrArg (fun q => g ≫ q) hπ).trans (Category.assoc _ _ _).symm)
    exact (step g₁).trans ((congrArg (fun q => q ≫ p (n + 1)) hgg).trans (step g₂).symm)
  exact key

/-- For a quasi-coherent inverse system on a scheme, the successive short-exact-sequence
condition is equivalent to realization as the compatible system of quotients of an
`f`-torsion-free module by the powers of `f`.

This is the half of Stacks 0EH9 that the scheme structure is needed for; the remaining
equivalences are supplied by Stacks 0H39 over an arbitrary sheaf of rings, and the four
conditions are assembled in `Stacks.Algebraization.conditions_tfae_of_quasicoherent`. -/
theorem condition_one_iff_four_of_quasicoherent
    (X : Scheme.{u})
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf)))
    (obj : ℕ → X.Modules) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (hobj : ∀ n, (obj n).IsQuasicoherent) :
    Condition1 f obj map ↔ Condition4 f obj map := by
  constructor
  · intro h
    classical
    have h₂ := stacks0H39_one_imp_two f obj map h
    choose qIso hq using fun n : ℕ => conditionTwo_powQuotientIso f obj map h₂ n
    choose pIso hp using fun n : ℕ => principalPowerQuotientIso f (obj (n + 1)) (n + 1)
    choose up w hmul hS using h
    -- The inverse limit of the system, together with its projections, its reduction
    -- isomorphisms and its torsion-freeness. Everything the limit supplies is pinned here at
    -- the `X.Modules` spelling of the category, so that no later term has to mediate between
    -- the two presentations of it.
    obtain ⟨L, pr, rIso, hmonoL, hpr, hr⟩ :
        ∃ (L : X.Modules) (pr : ∀ n : ℕ, L ⟶ obj n)
            (rIso : ∀ n : ℕ, idealPowerQuotient (scalarIdealData f) (n + 1) L ≅ obj n),
          Mono (f.app L) ∧ (∀ n : ℕ, pr (n + 1) ≫ map n = pr n) ∧
            ∀ n : ℕ, cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1) L).ι) ≫
              (rIso n).hom = pr n := by
      let S : AdicInverseSystem := {
        X := X
        I := scalarIdealData f
        system := Functor.ofOpSequence map
        isQuasicoherent := fun n => hobj n.unop
        quotientIso := fun n => (pIso n).trans (qIso n)
        quotientIso_hom_comp := by
          intro n
          have hassoc :
              cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1) (obj (n + 1))).ι) ≫
                  (pIso n).hom ≫ (qIso n).hom =
                (cokernel.π
                    ((idealPowerMultiple (scalarIdealData f) (n + 1) (obj (n + 1))).ι) ≫
                  (pIso n).hom) ≫ (qIso n).hom :=
            (Category.assoc _ _ _).symm
          have hsucc : map n =
              (Functor.ofOpSequence map).map (homOfLE (Nat.le_succ n)).op :=
            (Functor.ofOpSequence_map_homOfLE_succ map n).symm
          exact hassoc.trans
            (((congrArg (fun q => q ≫ (qIso n).hom) (hp n)).trans (hq n)).trans hsucc) }
      have hI : Scheme.IdealSheafData.IsFiniteType (scalarIdealData f) :=
        scalarIdealData_finiteType f
      choose rIso hr using fun n : ℕ => S.exists_idealPowerQuotientIso hI n
      have hpr : ∀ n : ℕ, limit.π S.system (op (n + 1)) ≫ map n =
          limit.π S.system (op n) := fun n =>
        (congrArg (fun q => limit.π S.system (op (n + 1)) ≫ q)
            (Functor.ofOpSequence_map_homOfLE_succ map n)).symm.trans
          (limit.w S.system (homOfLE (Nat.le_succ n)).op)
      refine ⟨S.limitModule, fun n => limit.π S.system (op n), fun n => rIso n, ?_, hpr,
        fun n => hr n⟩
      exact mono_app_of_jointly_mono f S.limitModule obj (fun n => limit.π S.system (op n))
        (fun _ g₁ g₂ hg => limit.hom_ext fun j => hg j.unop) map hpr up
        (fun n => (hS n).mono_f) hmul
    choose bIso hb using fun n : ℕ => principalPowerQuotientIso f L (n + 1)
    refine ⟨L, hmonoL, fun n => (rIso n).symm.trans (bIso n), ?_⟩
    intro n
    change ((rIso (n + 1)).inv ≫ (bIso (n + 1)).hom) ≫ quotientToQuotient f L (n + 1) =
      map n ≫ (rIso n).inv ≫ (bIso n).hom
    -- Cancelling the reduction isomorphism of the `(n+1)`-st term leaves the `n`-th
    -- quotient projection on the left.
    have hcancel : (rIso (n + 1)).hom ≫
          ((rIso (n + 1)).inv ≫ (bIso (n + 1)).hom) ≫ quotientToQuotient f L (n + 1) =
        (bIso (n + 1)).hom ≫ quotientToQuotient f L (n + 1) :=
      (congrArg (fun q => (rIso (n + 1)).hom ≫ q) (Category.assoc _ _ _)).trans
        (Iso.hom_inv_id_assoc (rIso (n + 1)) _)
    have hcollapse : pr n ≫ (rIso n).inv ≫ (bIso n).hom =
        cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1) L).ι) ≫ (bIso n).hom :=
      (congrArg (fun q => q ≫ (rIso n).inv ≫ (bIso n).hom) (hr n).symm).trans
        ((Category.assoc _ _ _).trans
          (congrArg (fun q =>
              cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1) L).ι) ≫ q)
            (Iso.hom_inv_id_assoc (rIso n) (bIso n).hom)))
    -- Both sides agree after the quotient projection out of the `(n+1)`-st term: on the left
    -- because the quotient projections of `L` are compatible, on the right because the limit
    -- projections are.
    have hleft : cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1 + 1) L).ι) ≫
          (bIso (n + 1)).hom ≫ quotientToQuotient f L (n + 1) =
        cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1) L).ι) ≫ (bIso n).hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun q => q ≫ quotientToQuotient f L (n + 1)) (hb (n + 1))).trans
          ((qToQ_pi f L (n + 1)).trans (hb n).symm))
    have hright : cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1 + 1) L).ι) ≫
          (rIso (n + 1)).hom ≫ map n ≫ (rIso n).inv ≫ (bIso n).hom =
        cokernel.π ((idealPowerMultiple (scalarIdealData f) (n + 1) L).ι) ≫ (bIso n).hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun q => q ≫ map n ≫ (rIso n).inv ≫ (bIso n).hom) (hr (n + 1))).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (fun q => q ≫ (rIso n).inv ≫ (bIso n).hom) (hpr n)).trans hcollapse)))
    refine (cancel_epi (rIso (n + 1)).hom).1 (hcancel.trans ?_)
    refine Cofork.IsColimit.hom_ext
      (cokernelIsCokernel ((idealPowerMultiple (scalarIdealData f) (n + 1 + 1) L).ι)) ?_
    exact hleft.trans hright.symm
  · intro h
    have h₃ := stacks0H39_four_imp_three f obj map h
    have h₂ := (stacks0H39_two_iff_three f obj map).2 h₃
    exact (stacks0H39_one_iff_two f obj map).2 h₂

/-- The equivalence of the short-exact-sequence condition with the torsion-free realization,
for multiplication by a genuine global section of the structure sheaf. -/
theorem condition_one_iff_four_of_quasicoherent_globalSection
    (X : Scheme.{u}) (f : X.presheaf.obj (.op ⊤))
    (obj : ℕ → X.Modules) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (hobj : ∀ n, (obj n).IsQuasicoherent) :
    Condition1
        (Stacks.SheafOfModules.terminalSectionToEnd X.ringCatSheaf ⊤ isTerminalTop f) obj map ↔
      Condition4
        (Stacks.SheafOfModules.terminalSectionToEnd X.ringCatSheaf ⊤ isTerminalTop f) obj map :=
  condition_one_iff_four_of_quasicoherent X _ obj map hobj

/-- **Stacks Project, Tag 0EH9.** Let `X` be a scheme, let `f` act by multiplication by a
global section of `𝒪_X`, and let `… → ℱ₃ → ℱ₂ → ℱ₁` be an inverse system of quasi-coherent
`𝒪_X`-modules. The following are equivalent:

1. for all `n ≥ 1` the map `f : ℱ_{n+1} → ℱ_{n+1}` factors through `ℱ_{n+1} → ℱ_n` to give a
   short exact sequence `0 → ℱ_n → ℱ_{n+1} → ℱ₁ → 0`;
2. for all `n ≥ 1` the map `f^n : ℱ_{n+1} → ℱ_{n+1}` factors through `ℱ_{n+1} → ℱ₁` to give a
   short exact sequence `0 → ℱ₁ → ℱ_{n+1} → ℱ_n → 0`;
3. there is an `f`-divisible `𝒪_X`-module `𝒢` with `ℱ_n = 𝒢[f^n]`;
4. there is an `f`-torsion-free `𝒪_X`-module `ℱ` with `ℱ_n = ℱ/f^nℱ`.

The equivalence of (1), (2) and (3) holds over an arbitrary sheaf of rings and is Stacks
0H39; so does (4) ⇒ (1). The converse (1) ⇒ (4) is
`Stacks.Algebraization.condition_one_iff_four_of_quasicoherent`, which is where the scheme
structure and quasi-coherence enter. -/
@[stacks 0EH9]
theorem conditions_tfae_of_quasicoherent
    (X : Scheme.{u})
    (f : End (𝟭 (SheafOfModules.{u} X.ringCatSheaf)))
    (obj : ℕ → X.Modules) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (hobj : ∀ n, (obj n).IsQuasicoherent) :
    List.TFAE
      [Condition1 f obj map, Condition2 f obj map, Condition3 f obj map,
        Condition4 f obj map] := by
  tfae_have 1 ↔ 2 := stacks0H39_one_iff_two f obj map
  tfae_have 2 ↔ 3 := stacks0H39_two_iff_three f obj map
  tfae_have 1 ↔ 4 := condition_one_iff_four_of_quasicoherent X f obj map hobj
  tfae_finish

/-- The four equivalent conditions of Stacks 0EH9, for multiplication by a genuine global
section of the structure sheaf. -/
theorem conditions_tfae_of_quasicoherent_globalSection
    (X : Scheme.{u}) (f : X.presheaf.obj (.op ⊤))
    (obj : ℕ → X.Modules) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (hobj : ∀ n, (obj n).IsQuasicoherent) :
    List.TFAE
      [Condition1 (Stacks.SheafOfModules.terminalSectionToEnd X.ringCatSheaf ⊤ isTerminalTop f)
          obj map,
        Condition2 (Stacks.SheafOfModules.terminalSectionToEnd X.ringCatSheaf ⊤ isTerminalTop f)
          obj map,
        Condition3 (Stacks.SheafOfModules.terminalSectionToEnd X.ringCatSheaf ⊤ isTerminalTop f)
          obj map,
        Condition4 (Stacks.SheafOfModules.terminalSectionToEnd X.ringCatSheaf ⊤ isTerminalTop f)
          obj map] :=
  conditions_tfae_of_quasicoherent X _ obj map hobj

end Stacks.Algebraization

