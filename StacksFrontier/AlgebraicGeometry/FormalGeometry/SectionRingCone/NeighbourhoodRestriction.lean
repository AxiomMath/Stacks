/-!
# Sections over an open neighbourhood of the zero scheme of an ample section

Let `k` be a field, `X` a proper scheme over `k`, `L` an ample invertible `𝒪_X`-module,
`s ∈ Γ(X, L)` and `Y = Z(s)` its zero scheme. Let `W ⊆ X` be an open subscheme containing `Y`.
The proof of [Stacks, Tag 0EL2] passes from `X` to `W` by observing that the complement
`T = X ∖ W` is a closed subset of the affine open `X ∖ Y`, so that `T` is proper and affine over
`k`, hence a finite set of closed points, and that a coherent module of depth at least two at
the points of `T` has the same sections on `W` as on `X` ([Stacks, Tag 0E9I]).

This file proves that. The finiteness of `T` is replaced by what is actually used: every point of
`T` is closed, because its closure lies in `T`, hence in the affine open `X_s ⊇ X ∖ Y`, and a
point of a scheme proper over a field whose closure lies in an affine open is closed
(`Stacks.EnriquesSeveriZariski.isClosed_singleton_of_closure_subset_of_isAffineOpen`).

## Main results

* `Stacks.Algebraization.SectionRingCone.mem_nonvanishingOpen_of_notMem_support_zeroScheme` —
  a point outside the zero scheme of `s` lies in the nonvanishing open `X_s`.
* `Stacks.Algebraization.SectionRingCone.isClosed_singleton_of_notMem_neighbourhood` — on a
  scheme proper over a field with an ample invertible module, every point outside an open
  neighbourhood of the zero scheme of a section is closed.
* `Stacks.Algebraization.SectionRingCone.two_le_depth_of_isClosed_of_depthAddDim` — at a closed
  point outside the zero scheme, the hypothesis `depth(𝒪_{X,x}) + dim({x}‾) > 1` of
  [Stacks, Tag 0ELC] is `depth(𝒪_{X,x}) ≥ 2`.
* `Stacks.Algebraization.SectionRingCone.bijective_restrict_of_depthAddDimGtOne` — **the
  restriction of sections of a finite locally free coherent module from `X` to `W` is
  bijective** under that hypothesis.

## References

* [Stacks Project, Tag 0EL2](https://stacks.math.columbia.edu/tag/0EL2)
* [Stacks Project, Tag 0E9I](https://stacks.math.columbia.edu/tag/0E9I)
* [Stacks Project, Tag 0EKE](https://stacks.math.columbia.edu/tag/0EKE)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite

universe u

namespace Stacks.Algebraization.SectionRingCone

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- **A point outside the zero scheme of a section lies in its nonvanishing open.** On an affine
open inside a trivializing open of `L`, the ideal of `Z(s)` is generated by the trivializing
function of `s`, and the nonvanishing locus is where that function is a unit. -/
public theorem mem_nonvanishingOpen_of_notMem_support_zeroScheme (s : Γ(L, ⊤)) {x : X}
    (hx : x ∉ (zeroScheme X L s).supportSet) :
    x ∈ Stacks.NonvanishingOpen.nonvanishingOpen X L s := by
  obtain ⟨V, hV, htriv⟩ := Stacks.SheafRankOne.exists_cover_trivialization_of_isInvertible
    (X := X.toRingedSpace) X.ringCatSheaf.2 L
  obtain ⟨z, hz⟩ : ∃ z : X, x ∈ V z := Opens.mem_iSup.mp (hV ▸ Opens.mem_top x)
  obtain ⟨t⟩ := htriv z
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hz (V z).2
  let h : U ⟶ V z := homOfLE hUV
  let e : Γ(L, U) ≃ₗ[Γ(X, U)] Γ(X, U) := t.θ U h
  have he : e (L.presheaf.map (homOfLE le_top).op s) =
      X.presheaf.map h.op (Stacks.NonvanishingOpen.trivTop t s) := by
    have hres : L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op s =
        L.presheaf.map h.op (L.presheaf.map (homOfLE (le_top : V z ≤ ⊤)).op s) := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl
    exact (congrArg (Stacks.NonvanishingOpen.triv t h) hres).trans
      (Stacks.NonvanishingOpen.triv_res t (𝟙 (V z)) h h
        (L.presheaf.map (homOfLE (le_top : V z ≤ ⊤)).op s))
  have hideal := zeroScheme_ideal_of_trivialization X L s ⟨U, hU⟩ e _ he
  have hnot : x ∉ X.zeroLocus (U := U) ((zeroScheme X L s).ideal ⟨U, hU⟩) := fun hmem =>
    hx ((Scheme.IdealSheafData.mem_supportSet_iff_of_mem (U := ⟨U, hU⟩) hxU).2 hmem)
  rw [hideal, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton, Set.mem_compl_iff,
    not_not] at hnot
  have hunit := (X.mem_basicOpen _ x hxU).mp hnot
  rw [TopCat.Presheaf.germ_res_apply] at hunit
  exact (Stacks.NonvanishingOpen.mem_nonvanishingLocus_iff_isUnit t s hz).2 hunit

/-- **A point outside an open neighbourhood of the zero scheme of a section is closed**, on a
scheme proper over a field with an ample invertible module. -/
public theorem isClosed_singleton_of_notMem_neighbourhood (k : Type u) [Field k]
    (g : X ⟶ Spec (.of k)) [IsProper g] (hL : Stacks.Ample.IsAmple X L) (s : Γ(L, ⊤))
    (W : X.Opens) (hW : (zeroScheme X L s).supportSet ⊆ W) {x : X} (hx : x ∉ (W : Set X)) :
    IsClosed ({x} : Set X) := by
  have hU : IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X L s) :=
    Stacks.AmpleNonvanishingUniversallyClosed.isAffineOpen_nonvanishingOpen_of_isAmple L hL
      (Stacks.SectionRingProjIso.universallyClosed_toSpecΓ g) s
  have hcl : closure ({x} : Set X) ⊆ (W : Set X)ᶜ :=
    closure_minimal (Set.singleton_subset_iff.2 hx) W.2.isClosed_compl
  exact Stacks.EnriquesSeveriZariski.isClosed_singleton_of_closure_subset_of_isAffineOpen k g hU
    fun y hy => mem_nonvanishingOpen_of_notMem_support_zeroScheme L s fun hys => hcl hy (hW hys)

/-- A closed point has a zero-dimensional closure. -/
public theorem dimClosureAt_eq_zero_of_isClosed {x : X} (hx : IsClosed ({x} : Set X)) :
    dimClosureAt X x = 0 := by
  rw [dimClosureAt, hx.closure_eq]
  have : Nonempty ({x} : Set X) := ⟨⟨x, rfl⟩⟩
  exact AlgebraicGeometry.topologicalKrullDim_eq_zero_of_subsingleton

/-- **At a closed point the depth–dimension inequality `depth + dim({x}‾) > 1` says that the
depth is at least two.** -/
public theorem two_le_of_enatToEInt_add_zero_gt_one {d : ℕ∞}
    (h : enatToEInt d + krullDimToEInt (0 : WithBot ℕ∞) > ((1 : ℤ) : EInt)) : 2 ≤ d := by
  induction d using ENat.recTopCoe with
  | top => exact le_top
  | coe n =>
    have h0 : krullDimToEInt (0 : WithBot ℕ∞) = ((0 : ℤ) : EInt) := krullDimToEInt_natCast 0
    rw [h0, show enatToEInt (n : ℕ∞) = ((n : ℤ) : EInt) from rfl,
      ← Stacks.Chow.coe_add_coe_eq_coe_add] at h
    have h' := WithBotTop.coe_lt_coe.1 h
    exact_mod_cast (show (2 : ℤ) ≤ n by omega)

/-- **The hypothesis of [Stacks, Tag 0ELC] gives depth at least two at every closed point outside
the zero scheme.** -/
public theorem two_le_depth_of_isClosed_of_depthAddDim (Y : X.IdealSheafData)
    (hdepth : Stacks.FundamentalGroup.DepthAddDimGtOneOutsideSupport X Y) {x : X}
    (hxY : x ∉ (Y.support : Set X)) (hx : IsClosed ({x} : Set X)) :
    (2 : ℕ∞) ≤ Module.depth (X.presheaf.stalk x) (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
      (X.presheaf.stalk x) := by
  have h := hdepth x hxY
  rw [dimClosureAt_eq_zero_of_isClosed hx] at h
  exact two_le_of_enatToEInt_add_zero_gt_one h

/-- **[Stacks, Tag 0EL2], the passage from `X` to an open neighbourhood.** Let `X` be proper over
a field `k`, `L` an ample invertible module, `s ∈ Γ(X, L)` with
`depth(𝒪_{X,x}) + dim({x}‾) > 1` at every point outside `Z(s)`, and `W ⊆ X` an open containing
`Z(s)`. Then for every finite locally free coherent module `F` the restriction
`Γ(X, F) ⟶ Γ(W, F)` is bijective. Every point outside `W` is closed, the stalk of `F` there has
depth at least that of `𝒪_{X,x}`, which is at least two, and [Stacks, Tag 0E9I] applies. -/
public theorem bijective_restrict_of_depthAddDimGtOne (k : Type u) [Field k]
    (g : X ⟶ Spec (.of k)) [IsProper g] (hL : Stacks.Ample.IsAmple X L) (s : Γ(L, ⊤))
    (hdepth : Stacks.FundamentalGroup.DepthAddDimGtOneOutsideSupport X (zeroScheme X L s))
    (W : X.Opens) (hW : ((zeroScheme X L s).support : Set X) ⊆ W) (F : X.Modules)
    [F.IsCoherent] [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} F] :
    Function.Bijective (F.presheaf.map (homOfLE (show W ≤ (⊤ : X.Opens) from le_top)).op) := by
  have : IsNoetherianRing (CommRingCat.of k) := inferInstanceAs (IsNoetherianRing k)
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian g
  exact restriction_bijective_of_depth_ge_two X F W fun x hx =>
    (two_le_depth_of_isClosed_of_depthAddDim (zeroScheme X L s) hdepth (fun h => hx (hW h))
      (isClosed_singleton_of_notMem_neighbourhood L k g hL s W hW hx)).trans
      (depth_stalk_le_sheafDepthAt F x)

/-- **Condition (2) of [Stacks, Tag 0EJZ] passes from `X` to every open neighbourhood of the zero
scheme**, under the hypothesis of [Stacks, Tag 0ELC]. Let `X` be proper over a field `k`, `L` an
ample invertible module, `s ∈ Γ(X, L)` with `depth(𝒪_{X,x}) + dim({x}‾) > 1` at every point
outside `Y = Z(s)`. If the sections of the large powers of some ample invertible module `L₀` on
`X` are the inverse limits of their sections on the infinitesimal neighbourhoods of `Y` in `X`,
then the same holds on every open `W ⊇ Y` for the restriction of `L₀` to `W`, along the closed
immersion `Y ⟶ W`.

The sections of `L₀^{⊗ m}` over `X` and over `W` agree
(`Stacks.Algebraization.SectionRingCone.bijective_restrict_of_depthAddDimGtOne`, the source's
argument for [Stacks, Tag 0EL2]), so
`Stacks.Algebraization.isInfinitesimalSectionsComplete_of_isOpenImmersion_factor` transfers the
completeness to `W`; the restriction of `L₀` to `W` is ample and invertible
(`Stacks.AmpleRestrict.isAmple_pullback_ι_of_isNoetherian`), and its tensor powers are the
restrictions of those of `L₀` (`AlgebraicGeometry.Scheme.Modules.pullbackTensorPowerIso`). -/
public theorem sectionsCompleteAmplePowers_neighborhood (k : Type u) [Field k]
    (g : X ⟶ Spec (.of k)) [IsProper g] (hL : AlgebraicGeometry.Scheme.Modules.IsAmple X L)
    (s : Γ(L, ⊤))
    (hdepth : Stacks.FundamentalGroup.DepthAddDimGtOneOutsideSupport X (zeroScheme X L s))
    (W : Stacks.FundamentalGroup.Neighborhood X (zeroScheme X L s))
    (h : Stacks.FundamentalGroup.SectionsCompleteAmplePowers (zeroScheme X L s).subschemeι) :
    Stacks.FundamentalGroup.SectionsCompleteAmplePowers
      (Stacks.FundamentalGroup.Neighborhood.toSchemeHom X (zeroScheme X L s) W) := by
  have hLs : Stacks.Ample.IsAmple X L :=
    (Stacks.PowerFamilyBridge.modulesIsAmple_iff_isAmple X L).mp hL
  have : IsNoetherian X :=
    Stacks.FundamentalGroup.isNoetherian_of_isProper_of_isAmple k g L hL
  obtain ⟨L₀, hL₀, hample, N, hN⟩ := h
  have := hL₀
  have hL₀s : Stacks.Ample.IsInvertibleModule X L₀ :=
    Stacks.InvertibleBridge.stacksIsInvertible_of_algebraicGeometryIsInvertible
  set V := Stacks.FundamentalGroup.Neighborhood.open X (zeroScheme X L s) W
  set i := (zeroScheme X L s).subschemeι with hi
  set j := Stacks.FundamentalGroup.Neighborhood.toSchemeHom X (zeroScheme X L s) W
  have hjfac : j ≫ V.ι = i := Stacks.FundamentalGroup.Neighborhood.toSchemeHom_fac X _ W
  have hrange : Set.range i.base ⊆ V := by
    rw [hi, Scheme.IdealSheafData.range_subschemeι]
    exact Stacks.FundamentalGroup.Neighborhood.support_subset_open X _ W
  refine ⟨(Scheme.Modules.pullback V.ι).obj L₀, inferInstance,
    Stacks.AmpleRestrict.isAmple_pullback_ι_of_isNoetherian V L₀ hample, N, fun m hm => ?_⟩
  -- the module `L₀^{⊗ m}` in the spelling of `Stacks.Ample`
  set G := Stacks.Ample.tensorPowModule X L₀ (m : ℤ)
  have hGqc : G.IsQuasicoherent := Stacks.AmpleGlobalGeneration.isQuasicoherent_tensorPowModule L₀ _
  have hGcoh : G.IsCoherent :=
    Stacks.AlgebraicGeometry.RelativeSerreVanishing.isCoherent_tensorPowModule L₀ _
  have hGflf : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} G :=
    Stacks.Algebraization.isFiniteLocallyFree_tensorPowModule L₀ _
  have hGX : IsInfinitesimalSectionsComplete i G :=
    isInfinitesimalSectionsComplete_of_iso i
      (Stacks.PowerFamilyBridge.invertibleTensorPowerModuleIso X L₀ (m : ℤ)) (hN m hm)
  have hres := bijective_restrict_of_depthAddDimGtOne L k g hLs s hdepth V
    (Stacks.FundamentalGroup.Neighborhood.support_subset_open X _ W) G
  have e : (Scheme.Modules.pullback V.ι).obj G ≅
      Stacks.SheafOfModules.Invertible.tensorPower V.toScheme.toRingedSpace.presheaf
        (structureSheafRing V.toScheme.toRingedSpace).property
        ((Scheme.Modules.pullback V.ι).obj L₀) (m : ℤ) :=
    (Scheme.Modules.pullback V.ι).mapIso
        (Stacks.PowerFamilyBridge.invertibleTensorPowerModuleIso X L₀ (m : ℤ)).symm ≪≫
      AlgebraicGeometry.Scheme.Modules.pullbackTensorPowerIso V.ι L₀ m
  exact isInfinitesimalSectionsComplete_of_iso j e
    (isInfinitesimalSectionsComplete_of_isOpenImmersion_factor i V hrange j hjfac G hGX hres)

end Stacks.Algebraization.SectionRingCone

end
