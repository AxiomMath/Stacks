module

public import StacksFrontier.Algebra.DirectSum.GradedQuotient
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.ComplementFormalFunctionsHigher
public import StacksFrontier.RingTheory.LocalCohomology.SectionsIso.GradedComplement
public import StacksFrontier.RingTheory.LocalCohomology.LowDegree.LocalizationData
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Formal functions on the punctured spectrum, one degree at a time

Let `S = ⨁_{i ≥ 0} 𝒜 i` be a Noetherian graded ring, let `M` be a finite `ℤ`-graded `S`-module,
let `I` be the ideal generated by homogeneous elements `fam 0, …, fam (r-1)`, set
`U = Spec(S) ∖ V(I)`, and let `f` be homogeneous of positive degree. If powers of `f` kill
`H¹_I(M)` and `H²_I(M)`, then in every degree `e` the sections of `M̃` on `U` are the inverse
limit of the sections of the `(M / fⁿM)~` on `U`:

`Γ(U, M̃)_e ⟶ lim_n Γ(U, (M / fⁿM)~)_e` is bijective.

This is the degree-zero algebraic step of [Stacks, Tag 0EL1] in its graded form. The ungraded
statement over an `f`-adically complete ring is [Stacks, Tag 0EII]; here no completeness is
assumed, because in a fixed degree the tower `Γ(U, M̃)_e / (fⁿ Γ(U, M̃))_e` is eventually constant:
a finite graded module is bounded below and `f ^ c` carries the sections of low degree into `M`.

## The model

Sections on `U` are the degree-one cocycles of the extended alternating Čech complex of `fam`
(`Stacks.LocalCohomology.cechComplementHomologyZeroEquivKer`), and their degree-`e` part is
`Stacks.Algebraization.SectionRingCone.kerDegree`: the cocycles all of whose coordinates are
homogeneous fractions of degree `e` (`Cech.gradedCechTerm`). The quotients `M / fⁿM` are graded
by `Submodule.gradedQuotientPiece`, `fⁿM` being homogeneous.

## The argument

The kernel and cokernel steps of the library's proof of [Stacks, Tag 0EKM]
(`Stacks.Algebraization.HigherComplementTower.exists_pow_smul_of_quotient_eq_zero` and
`exists_preimage_of_quotient`) are moved to the Čech cocycles and then projected onto one degree:

* a degree-`e` section dying modulo `f ^ m`, for `m` past the stabilization of the `f`-power
  torsion of `M`, is `f ^ p` times a section of degree `e - p · deg f`; a power `f ^ c` killing
  `H¹_I(M)` turns that section into a restriction `m / 1` of degree `e - (p - c) · deg f`, which
  vanishes once that degree is below the degrees of `M`. So reduction modulo one fixed power of
  `f` is injective in degree `e`;
* the cokernel step lifts every member of a compatible family, and the degree-`e` part of a lift
  is again a lift because all the maps preserve degrees;
* injectivity at one level makes these lifts agree, which gives the unique antecedent.

## Main definitions

* `Stacks.Algebraization.SectionRingCone.kerDegree` — the degree-`e` Čech sections.
* `Stacks.Algebraization.SectionRingCone.cechRes` — the restriction map `m ↦ m / 1`.
* `Stacks.Algebraization.SectionRingCone.quotientTowerPiece` — the grading of `M / fⁿM`.
* `Stacks.Algebraization.SectionRingCone.towerReduction`,
  `Stacks.Algebraization.SectionRingCone.towerTransition` — reduction modulo `fⁿ` and the
  transition maps of the tower of quotients.

## Main results

* `Stacks.Algebraization.SectionRingCone.exists_sum_mem_kerDegree`,
  `Stacks.Algebraization.SectionRingCone.eq_zero_of_sum_mem_kerDegree_eq_zero` — the Čech
  sections are the direct sum of their degree-`e` parts.
* `Stacks.Algebraization.SectionRingCone.exists_cechRes_eq_pow_smul` — `f ^ c` times a section
  is a restriction when `f ^ c` kills `H¹_I(M)`.
* `Stacks.Algebraization.SectionRingCone.exists_forall_lt_eq_zero_of_finite` — a finite graded
  module is bounded below.
* `Stacks.Algebraization.SectionRingCone.existsUnique_mem_kerDegree_of_compatible` — **the
  degreewise formal functions theorem**.

## References

* [Stacks Project, Tag 0EL1](https://stacks.math.columbia.edu/tag/0EL1)
* [Stacks Project, Tag 0EII](https://stacks.math.columbia.edu/tag/0EII)
* [Stacks Project, Tag 0EKM](https://stacks.math.columbia.edu/tag/0EKM)
-/

@[expose] public noncomputable section

open CategoryTheory DirectSum Stacks.LocalCohomology

attribute [local instance] instVAddNatIntGradedLocalizedModule

universe u w t

namespace Stacks.Algebraization.SectionRingCone

/-! ### The degree-`e` Čech sections -/

section KerDegree

variable {S : Type u} {σ : Type w}
  [CommRing S] [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {r : ℕ} (fam : Fin r → S)

/-- **The degree-`e` Čech sections** of a `ℤ`-graded module `P`: the degree-one Čech cocycles
of `fam` all of whose coordinates, fractions in the localizations of `P` at the products of the
`fam i`, are homogeneous of degree `e`. For `fam` generating an ideal `I` these cocycles are the
sections of `P̃` on `Spec(S) ∖ V(I)`. -/
def kerDegree (P : ModuleCat.{u} S) {τ' : Type*} [SetLike τ' P] (𝒢 : ℤ → τ') (e : ℤ) :
    AddSubgroup (LinearMap.ker (Cech.cechD fam (P : Type u) 1)) :=
  (Cech.gradedCechTerm 𝒜 𝒢 fam e 1).comap
    (LinearMap.ker (Cech.cechD fam (P : Type u) 1)).subtype.toAddMonoidHom

omit [AddSubgroupClass σ S] [GradedRing 𝒜] in
/-- Membership in the degree-`e` Čech sections is homogeneity of the underlying cochain. -/
theorem mem_kerDegree {P : ModuleCat.{u} S} {τ' : Type*} [SetLike τ' P] {𝒢 : ℤ → τ'}
    {e : ℤ} {x : LinearMap.ker (Cech.cechD fam (P : Type u) 1)} :
    x ∈ kerDegree 𝒜 fam P 𝒢 e ↔ (x : Cech.cechTerm fam (P : Type u) 1) ∈
      Cech.gradedCechTerm 𝒜 𝒢 fam e 1 :=
  Iff.rfl

variable {c : Fin r → ℕ} (hc : ∀ i, fam i ∈ 𝒜 (c i))
  (P : ModuleCat.{u} S) {τ' : Type*} [SetLike τ' P] [AddSubgroupClass τ' P] (𝒢 : ℤ → τ')
  [Decomposition 𝒢] [SetLike.GradedSMul 𝒜 𝒢]

include hc in
/-- **Independence of the degrees of the Čech sections.** -/
theorem eq_zero_of_sum_mem_kerDegree_eq_zero (t : Finset ℤ)
    (y : ℤ → LinearMap.ker (Cech.cechD fam (P : Type u) 1))
    (hy : ∀ e ∈ t, y e ∈ kerDegree 𝒜 fam P 𝒢 e) (hsum : (∑ e ∈ t, y e) = 0) {e₀ : ℤ}
    (he₀ : e₀ ∈ t) : y e₀ = 0 := by
  refine Subtype.ext (Cech.eq_zero_of_sum_mem_gradedCechTerm_eq_zero 𝒜 𝒢 fam hc 1 t
    (fun e => (y e : Cech.cechTerm fam (P : Type u) 1)) (fun e he => hy e he) ?_ he₀)
  rw [← Submodule.coe_sum, hsum]
  rfl

include hc in
/-- **Every Čech section is a finite sum of homogeneous ones**: the homogeneous parts of a
cocycle are again cocycles, the differential preserving degrees and the degrees being independent
in the degree-two term. -/
theorem exists_sum_mem_kerDegree (x : LinearMap.ker (Cech.cechD fam (P : Type u) 1)) :
    ∃ (t : Finset ℤ) (y : ℤ → LinearMap.ker (Cech.cechD fam (P : Type u) 1)),
      (∀ e, y e ∈ kerDegree 𝒜 fam P 𝒢 e) ∧ (∀ e ∉ t, y e = 0) ∧ (∑ e ∈ t, y e) = x := by
  classical
  obtain ⟨t, w, hw, hwzero, hwsum⟩ :=
    Cech.exists_sum_mem_gradedCechTerm 𝒜 𝒢 fam hc 1 (x : Cech.cechTerm fam (P : Type u) 1)
  have hker : ∀ e, w e ∈ LinearMap.ker (Cech.cechD fam (P : Type u) 1) := by
    intro e
    by_cases he : e ∈ t
    · refine Cech.eq_zero_of_sum_mem_gradedCechTerm_eq_zero 𝒜 𝒢 fam hc 2 t
        (fun e => Cech.cechD fam (P : Type u) 1 (w e))
        (fun e _ => Cech.cechD_mem_gradedCechTerm 𝒜 𝒢 fam hc e 1 (hw e)) ?_ he
      rw [← map_sum, hwsum]
      exact x.2
    · rw [hwzero e he]
      exact zero_mem _
  refine ⟨t, fun e => ⟨w e, hker e⟩, fun e => hw e, fun e he => Subtype.ext (hwzero e he), ?_⟩
  exact Subtype.ext (by rw [Submodule.coe_sum]; exact hwsum)

omit [Decomposition 𝒢] in
include hc in
/-- **A homogeneous scalar shifts the degree of a Čech section.** -/
theorem smul_mem_kerDegree {i : ℕ} {e : ℤ} {a : S} (ha : a ∈ 𝒜 i)
    {x : LinearMap.ker (Cech.cechD fam (P : Type u) 1)} (hx : x ∈ kerDegree 𝒜 fam P 𝒢 e) :
    a • x ∈ kerDegree 𝒜 fam P 𝒢 ((i : ℤ) + e) :=
  Cech.smul_mem_gradedCechTerm 𝒜 𝒢 fam hc ha hx

include hc in
/-- **Dividing a homogeneous Čech section by a homogeneous scalar.** If a homogeneous section of
degree `e` is `a • w` with `a` homogeneous of degree `i`, then it is also `a • w'` with `w'`
homogeneous of degree `e - i`. -/
theorem exists_mem_kerDegree_smul_eq {i : ℕ} {e : ℤ} {a : S} (ha : a ∈ 𝒜 i)
    {x w : LinearMap.ker (Cech.cechD fam (P : Type u) 1)} (hx : x ∈ kerDegree 𝒜 fam P 𝒢 e)
    (hxw : x = a • w) :
    ∃ w' ∈ kerDegree 𝒜 fam P 𝒢 (e - i), x = a • w' := by
  classical
  obtain ⟨t, y, hy, hzero, hsum⟩ := exists_sum_mem_kerDegree 𝒜 fam hc P 𝒢 w
  refine ⟨y (e - i), hy _, ?_⟩
  set T := insert e ((insert (e - i) t).image fun j => (i : ℤ) + j) with hT
  let u : ℤ → LinearMap.ker (Cech.cechD fam (P : Type u) 1) :=
    fun k => a • y (k - i) - if k = e then x else 0
  have humem : ∀ k ∈ T, u k ∈ kerDegree 𝒜 fam P 𝒢 k := by
    intro k _
    refine sub_mem ?_ ?_
    · have h := smul_mem_kerDegree 𝒜 fam hc P 𝒢 ha (hy (k - i))
      rwa [add_sub_cancel] at h
    · by_cases hk : k = e
      · subst hk; simpa using hx
      · simp only [hk, ite_false]; exact zero_mem _
  have husum : (∑ k ∈ T, u k) = 0 := by
    simp only [u, Finset.sum_sub_distrib, Finset.sum_ite_eq', hT, Finset.mem_insert_self,
      ite_true]
    rw [hxw, ← Finset.smul_sum, sub_eq_zero]
    congr 1
    rw [← hsum]
    have hsub : t ⊆ (T.image fun k => k - i) := by
      intro j hj
      refine Finset.mem_image.2 ⟨(i : ℤ) + j, ?_, by ring⟩
      exact Finset.mem_insert_of_mem (Finset.mem_image.2 ⟨j, Finset.mem_insert_of_mem hj, rfl⟩)
    rw [← Finset.sum_image (f := y) (fun a _ b _ h => by simpa using h)]
    exact (Finset.sum_subset hsub fun j _ hj => hzero j hj).symm
  have hue := eq_zero_of_sum_mem_kerDegree_eq_zero 𝒜 fam hc P 𝒢 T u humem husum
    (Finset.mem_insert_self e _)
  simp only [u, ite_true, sub_eq_zero] at hue
  exact hue.symm

end KerDegree

/-! ### Induced maps and the restriction map preserve degrees -/

section Maps

variable {S : Type u} {σ : Type w}
  [CommRing S] [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {r : ℕ} (fam : Fin r → S) {c : Fin r → ℕ} (hc : ∀ i, fam i ∈ 𝒜 (c i))
  {P P' : ModuleCat.{u} S} {τ₁ τ₂ : Type*} [SetLike τ₁ P] [AddSubgroupClass τ₁ P]
  [SetLike τ₂ P'] (𝒢 : ℤ → τ₁) (𝒢' : ℤ → τ₂) [SetLike.GradedSMul 𝒜 𝒢]

include hc in
/-- A module map preserving degrees preserves the degrees of the localizations. -/
theorem cechModMap_mem_gradedPiece (g : P ⟶ P') (hg : ∀ (j : ℤ) (x : P), x ∈ 𝒢 j → g x ∈ 𝒢' j)
    (s : Finset (Fin r)) {e : ℤ} {y : Cech.cechMod fam (P : Type u) s}
    (hy : y ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒢 (∏ i ∈ s, fam i) e) :
    cechModMap fam g s y ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒢' (∏ i ∈ s, fam i) e := by
  have hfs : (∏ i ∈ s, fam i) ∈ 𝒜 (∑ i ∈ s, c i) :=
    SetLike.prod_mem_graded 𝒜 c fam fun i _ => hc i
  obtain ⟨n, x, hx, rfl⟩ :=
    (Stacks.GradedLocalization.mem_gradedPiece_iff 𝒜 𝒢 hfs e y).1 hy
  rw [cechModMap_mk]
  exact Stacks.GradedLocalization.mk_mem_gradedPiece 𝒜 𝒢' hfs (hg _ _ hx)

include hc in
/-- A module map preserving degrees preserves the degrees of the Čech terms. -/
theorem cechTermMap_mem_gradedCechTerm (g : P ⟶ P')
    (hg : ∀ (j : ℤ) (x : P), x ∈ 𝒢 j → g x ∈ 𝒢' j) (p : ℕ) {e : ℤ}
    {z : Cech.cechTerm fam (P : Type u) p} (hz : z ∈ Cech.gradedCechTerm 𝒜 𝒢 fam e p) :
    cechTermMap fam g p z ∈ Cech.gradedCechTerm 𝒜 𝒢' fam e p := by
  classical
  rw [← DirectSum.sum_support_of z, map_sum]
  refine AddSubgroup.sum_mem _ fun s _ => ?_
  rw [← DirectSum.lof_eq_of S, cechTermMap_lof]
  exact Cech.lof_mem_gradedCechTerm s
    (cechModMap_mem_gradedPiece 𝒜 fam hc 𝒢 𝒢' g hg s.1 (Cech.mem_gradedCechTerm.1 hz s))

include hc in
/-- **A module map preserving degrees preserves the degrees of the Čech sections.** -/
theorem kerCechDOneMap_mem_kerDegree (g : P ⟶ P')
    (hg : ∀ (j : ℤ) (x : P), x ∈ 𝒢 j → g x ∈ 𝒢' j) {e : ℤ}
    {x : LinearMap.ker (Cech.cechD fam (P : Type u) 1)} (hx : x ∈ kerDegree 𝒜 fam P 𝒢 e) :
    kerCechDOneMap fam g x ∈ kerDegree 𝒜 fam P' 𝒢' e := by
  rw [mem_kerDegree, kerCechDOneMap_coe]
  exact cechTermMap_mem_gradedCechTerm 𝒜 fam hc 𝒢 𝒢' g hg 1 hx

/-- **The restriction map** `P → Γ(Spec S ∖ V(I), P̃)`, `m ↦ m / 1`, in the Čech model: the image
of `m` under the degree-zero Čech differential. -/
def cechRes (P : ModuleCat.{u} S) :
    (P : Type u) →ₗ[S] LinearMap.ker (Cech.cechD fam (P : Type u) 1) :=
  ((Cech.cechD fam (P : Type u) 0).comp (cechTermZeroEquiv fam P).symm.toLinearMap).codRestrict
    _ fun m => by
      rw [LinearMap.mem_ker]
      exact LinearMap.congr_fun (Cech.cechD_comp_cechD fam (P : Type u) 0)
        ((cechTermZeroEquiv fam P).symm m)

/-- The underlying cochain of a restriction. -/
theorem coe_cechRes (P : ModuleCat.{u} S) (m : P) :
    (cechRes fam P m : Cech.cechTerm fam (P : Type u) 1) =
      Cech.cechD fam (P : Type u) 0 ((cechTermZeroEquiv fam P).symm m) :=
  rfl

include hc in
/-- **The restriction map preserves degrees.** -/
theorem cechRes_mem_kerDegree {e : ℤ} {m : P} (hm : m ∈ 𝒢 e) :
    cechRes fam P m ∈ kerDegree 𝒜 fam P 𝒢 e := by
  rw [mem_kerDegree, coe_cechRes]
  refine Cech.cechD_mem_gradedCechTerm 𝒜 𝒢 fam hc e 0 ?_
  rw [cechTermZeroEquiv_symm_apply]
  refine Cech.lof_mem_gradedCechTerm _ ?_
  have hfs : (∏ i ∈ (default : ExtendedAlternatingCech.Idx r 0).1, fam i) ∈
      𝒜 (∑ i ∈ (default : ExtendedAlternatingCech.Idx r 0).1, c i) :=
    SetLike.prod_mem_graded 𝒜 c fam fun i _ => hc i
  have h := Stacks.GradedLocalization.mk_mem_gradedPiece 𝒜 𝒢 hfs (n := 0) (e := e) (x := m)
    (by simpa using hm)
  convert h using 1
  rw [LocalizedModule.mkLinearMap_apply]
  exact congrArg _ (Subtype.ext (pow_zero _).symm)

end Maps

/-! ### Bounded below -/

section BoundedBelow

variable {S : Type u} {M : Type u} {σ : Type w} {τ : Type t}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨]

include 𝒜 in
/-- **A finite graded module is bounded below**: below some degree all its graded pieces
vanish. The components of a finite generating family have finitely many degrees, and
multiplication by the nonnegatively graded ring only raises degrees. -/
@[ega "II 2.1.6" "(i)"]
theorem exists_forall_lt_eq_zero_of_finite [Module.Finite S M] :
    ∃ e₀ : ℤ, ∀ j < e₀, ∀ x ∈ 𝒨 j, x = 0 := by
  classical
  obtain ⟨g, hg⟩ := Module.finite_def.mp (inferInstance : Module.Finite S M)
  let T : Finset ℤ := insert 0 (g.biUnion fun x => DFinsupp.support (decompose 𝒨 x))
  let e₀ : ℤ := T.min' ⟨0, Finset.mem_insert_self 0 _⟩
  let N : Submodule S M :=
    { carrier := {x | ∀ j < e₀, ((decompose 𝒨 x j) : M) = 0}
      zero_mem' := fun j _ => by simp
      add_mem' := fun {x y} hx hy j hj => by
        rw [decompose_add, DFinsupp.add_apply, AddMemClass.coe_add, hx j hj, hy j hj,
          add_zero]
      smul_mem' := fun a x hx j hj => by
        change ((decompose 𝒨 (a • x) j) : M) = 0
        conv_lhs => rw [← sum_support_decompose 𝒜 a]
        rw [Finset.sum_smul, decompose_sum, DFinsupp.finsetSum_apply,
          AddSubmonoidClass.coe_finsetSum]
        refine Finset.sum_eq_zero fun p _ => ?_
        have h := DirectSum.coe_decompose_smul_of_mem_graded 𝒜 𝒨
          (fun i d b y hb hy => SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) hb hy)
          (decompose 𝒜 a p).2 (j - p) x
        rw [show (p : ℤ) + (j - p) = j by ring] at h
        rw [h, show ((decompose 𝒨 x (j - p)) : M) = 0 from hx _ (by omega), smul_zero] }
  have hgN : (g : Set M) ⊆ N := by
    intro x hx j hj
    by_contra hne
    have hmem : j ∈ T := Finset.mem_insert_of_mem (Finset.mem_biUnion.2 ⟨x, hx,
      DFinsupp.mem_support_iff.2 fun h => hne (by rw [h]; rfl)⟩)
    exact absurd (T.min'_le j hmem) (not_le.2 hj)
  have hN : N = ⊤ := top_le_iff.1 (hg ▸ Submodule.span_le.2 hgN)
  refine ⟨e₀, fun j hj x hx => ?_⟩
  have hxN : x ∈ N := hN ▸ Submodule.mem_top
  rw [← decompose_of_mem_same 𝒨 hx]
  exact hxN j hj

end BoundedBelow

/-! ### Projecting onto one degree -/

section Projection

variable {S : Type u} {σ : Type w}
  [CommRing S] [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {r : ℕ} (fam : Fin r → S) {c : Fin r → ℕ} (hc : ∀ i, fam i ∈ 𝒜 (c i))
  (P : ModuleCat.{u} S) {τ' : Type*} [SetLike τ' P] [AddSubgroupClass τ' P] (𝒢 : ℤ → τ')
  [Decomposition 𝒢] [SetLike.GradedSMul 𝒜 𝒢]

include hc in
/-- **The degree-`e` summand of a homogeneous decomposition of a degree-`e` section is the
section itself.** -/
theorem eq_of_sum_mem_kerDegree (t : Finset ℤ)
    (x : ℤ → LinearMap.ker (Cech.cechD fam (P : Type u) 1))
    (hx : ∀ j, x j ∈ kerDegree 𝒜 fam P 𝒢 j) (hzero : ∀ j ∉ t, x j = 0) {e : ℤ}
    {y : LinearMap.ker (Cech.cechD fam (P : Type u) 1)} (hy : y ∈ kerDegree 𝒜 fam P 𝒢 e)
    (hsum : (∑ j ∈ t, x j) = y) : x e = y := by
  classical
  let u : ℤ → LinearMap.ker (Cech.cechD fam (P : Type u) 1) :=
    fun j => x j - if j = e then y else 0
  have humem : ∀ j ∈ insert e t, u j ∈ kerDegree 𝒜 fam P 𝒢 j := by
    intro j _
    refine sub_mem (hx j) ?_
    by_cases hj : j = e
    · subst hj; simpa using hy
    · simp only [hj, ite_false]; exact zero_mem _
  have hins : (∑ j ∈ insert e t, x j) = y := by
    by_cases he : e ∈ t
    · rw [Finset.insert_eq_self.2 he, hsum]
    · rw [Finset.sum_insert he, hzero e he, zero_add, hsum]
  have husum : (∑ j ∈ insert e t, u j) = 0 := by
    simp only [u, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_insert_self, ite_true,
      hins, sub_self]
  have h := eq_zero_of_sum_mem_kerDegree_eq_zero 𝒜 fam hc P 𝒢 (insert e t) u humem husum
    (Finset.mem_insert_self e t)
  simpa [u, sub_eq_zero] using h

include hc in
/-- **A restriction of degree `e` is the restriction of a homogeneous element of degree `e`.** -/
theorem exists_mem_cechRes_eq {e : ℤ} {m : P}
    (hm : cechRes fam P m ∈ kerDegree 𝒜 fam P 𝒢 e) :
    ∃ m' ∈ 𝒢 e, cechRes fam P m' = cechRes fam P m := by
  classical
  refine ⟨decompose 𝒢 m e, (decompose 𝒢 m e).2, ?_⟩
  refine eq_of_sum_mem_kerDegree 𝒜 fam hc P 𝒢 (DFinsupp.support (decompose 𝒢 m))
    (fun j => cechRes fam P (decompose 𝒢 m j)) (fun j => cechRes_mem_kerDegree 𝒜 fam hc 𝒢
      (decompose 𝒢 m j).2) (fun j hj => by rw [DFinsupp.notMem_support_iff.1 hj]; simp) hm ?_
  rw [← map_sum, sum_support_decompose 𝒢 m]

variable {P' : ModuleCat.{u} S} {τ₂ : Type*} [SetLike τ₂ P'] [AddSubgroupClass τ₂ P']
  (𝒢' : ℤ → τ₂) [Decomposition 𝒢'] [SetLike.GradedSMul 𝒜 𝒢']

include hc in
/-- **A degree-`e` image of a Čech section under a degree-preserving map is the image of a
degree-`e` section.** -/
theorem exists_mem_kerDegree_kerCechDOneMap_eq (g : P ⟶ P')
    (hg : ∀ (j : ℤ) (x : P), x ∈ 𝒢 j → g x ∈ 𝒢' j)
    (s : LinearMap.ker (Cech.cechD fam (P : Type u) 1)) {e : ℤ}
    (hs : kerCechDOneMap fam g s ∈ kerDegree 𝒜 fam P' 𝒢' e) :
    ∃ s' ∈ kerDegree 𝒜 fam P 𝒢 e, kerCechDOneMap fam g s' = kerCechDOneMap fam g s := by
  obtain ⟨t, y, hy, hzero, hsum⟩ := exists_sum_mem_kerDegree 𝒜 fam hc P 𝒢 s
  refine ⟨y e, hy e, eq_of_sum_mem_kerDegree 𝒜 fam hc P' 𝒢' t
    (fun j => kerCechDOneMap fam g (y j))
    (fun j => kerCechDOneMap_mem_kerDegree 𝒜 fam hc 𝒢 𝒢' g hg (hy j))
    (fun j hj => by rw [hzero j hj, map_zero]) hs ?_⟩
  rw [← map_sum, hsum]

end Projection

/-! ### The two pro-zero steps on the Čech sections -/

section Steps

variable {S : Type u} [CommRing S] {r : ℕ} (fam : Fin r → S)

/-- `kerCechDOneMap` is functorial. -/
theorem kerCechDOneMap_comp_apply {P P' P'' : ModuleCat.{u} S} (g : P ⟶ P') (h : P' ⟶ P'')
    (x : LinearMap.ker (Cech.cechD fam (P : Type u) 1)) :
    kerCechDOneMap fam (g ≫ h) x = kerCechDOneMap fam h (kerCechDOneMap fam g x) := by
  refine Subtype.ext ?_
  simp only [kerCechDOneMap_coe, cechTermMap_comp, LinearMap.comp_apply]

/-- The degree-zero cohomology of derived sections on `U = Spec(S) ∖ V(I)` in the Čech model,
identified with the degree-one Čech cocycles. This is
`Stacks.LocalCohomology.cechComplementHomologyZeroEquivKer`, read on
`Stacks.Algebraization.complementCohomologyFunctor`. -/
def complementEquivKer (P : ModuleCat.{u} S) :
    (complementCohomologyFunctor fam 0).obj P ≃ₗ[S]
      LinearMap.ker (Cech.cechD fam (P : Type u) 1) :=
  cechComplementHomologyZeroEquivKer fam P

/-- The identification with the Čech cocycles is natural in the module. -/
theorem complementEquivKer_naturality {P P' : ModuleCat.{u} S} (g : P ⟶ P')
    (z : (complementCohomologyFunctor fam 0).obj P) :
    complementEquivKer fam P' ((complementCohomologyFunctor fam 0).map g z) =
      kerCechDOneMap fam g (complementEquivKer fam P z) :=
  cechComplementHomologyZeroEquivKer_naturality fam g z

/-- **The cokernel of the restriction map is killed by what kills `H¹_I`.** If `f ^ c` kills
`H¹_I(P)`, then `f ^ c` times any Čech section is a restriction `m / 1`: the section
`f ^ c • x` is killed by the connecting map of the localization triangle into `H¹_I(P)`, so by
exactness it comes from `P`. -/
theorem exists_cechRes_eq_pow_smul (I : Ideal S) (hI : I.FG)
    (hfam : Ideal.span (Set.range fam) = I) (P : ModuleCat.{u} S) (f : S) (c : ℕ)
    (h1 : ∀ x : localCohomologyModule S I hI P 1, f ^ c • x = 0)
    (x : LinearMap.ker (Cech.cechD fam (P : Type u) 1)) :
    ∃ m : P, cechRes fam P m = f ^ c • x := by
  -- The base `cechLocalizationTriangleData` and `cechRestriction` are built in the standard
  -- model.
  let := HasDerivedCategory.standard (ModuleCat.{u} S)
  let D := cechLocalizationTriangleData.{u} fam I hI hfam
  let E := complementEquivKer fam P
  let z : (DerivedCategory.homologyFunctor (ModuleCat.{u} S) 0).obj (D.triangle P).obj₃ :=
    E.symm x
  let δ := DerivedCategory.HomologySequence.δ (D.triangle P) 0 1
  have hδ : δ.hom (f ^ c • z) = 0 := (δ.hom.map_smul (f ^ c) z).trans (h1 _)
  have hex := (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).1
    (DerivedCategory.HomologySequence.exact₃ (D.triangle P) (D.distinguished P) 0 1)
  obtain ⟨w, hw⟩ := (hex (f ^ c • z)).1 hδ
  let e := DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} S) 0
  refine ⟨(e.hom.app P).hom w, ?_⟩
  have hinv : (e.inv.app P).hom ((e.hom.app P).hom w) = w := (e.app P).hom_inv_id_apply w
  -- The restriction map of the Čech model is the map induced on degree-zero cohomology by the
  -- second arrow of the localization triangle.
  have h2 : cechComplementHomologyZeroEquivKer fam P
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} S) 0).map
        ((cechRestriction.{u} fam).app P) ((e.inv.app P).hom ((e.hom.app P).hom w))) =
      cechRes fam P ((e.hom.app P).hom w) := by
    refine Subtype.ext ((cechTermOneEquiv fam P).injective (funext fun i => ?_))
    rw [cechComplementHomologyZeroEquivKer_restriction, coe_cechRes, cechTermOneEquiv_cechD_zero]
  refine h2.symm.trans ?_
  have h3 : ((DerivedCategory.homologyFunctor (ModuleCat.{u} S) 0).map
      ((cechRestriction.{u} fam).app P)).hom ((e.inv.app P).hom ((e.hom.app P).hom w)) =
      f ^ c • z := (congrArg _ hinv).trans hw
  refine (congrArg (cechComplementHomologyZeroEquivKer fam P) h3).trans ?_
  exact (E.map_smul (f ^ c) z).trans (congrArg _ (E.apply_symm_apply x))

/-- **The kernel step on the Čech sections.** If the `f ^ m`-torsion of `P` is already
`f ^ (m - p)`-torsion, a Čech section of `P` dying modulo `f ^ m` is `f ^ p` times a Čech
section. -/
theorem exists_pow_smul_of_kerCechDOneMap_eq_zero (f : S) (P : ModuleCat.{u} S) {p m : ℕ}
    (hpm : p ≤ m) (hkill : ∀ x : P, f ^ m • x = 0 → f ^ (m - p) • x = 0)
    (x : LinearMap.ker (Cech.cechD fam (P : Type u) 1))
    (hx : kerCechDOneMap fam (powerQuotientShortComplex f P m).g x = 0) :
    ∃ w, x = f ^ p • w := by
  let φ := complementEquivKer fam P
  have hs : (complementCohomologyFunctor fam 0).map (powerQuotientShortComplex f P m).g
      (φ.symm x) = 0 := by
    apply (complementEquivKer fam _).injective
    refine (complementEquivKer_naturality fam _ _).trans ?_
    refine (congrArg _ (φ.apply_symm_apply x)).trans ?_
    exact hx.trans (map_zero _).symm
  obtain ⟨w, hw⟩ := HigherComplementTower.exists_pow_smul_of_quotient_eq_zero fam f P 0 1
    (by norm_num) hpm hkill _ hs
  exact ⟨φ w, (φ.apply_symm_apply x).symm.trans ((congrArg φ hw).trans (φ.map_smul _ _))⟩

/-- **The cokernel step on the Čech sections.** Let `n ≤ p ≤ m`, suppose the `f ^ m`-torsion of
`P` is `f ^ (m - p)`-torsion and `f ^ (p - n)` kills `H¹(U, P̃)`. Then every Čech section modulo
`f ^ m`, reduced modulo `f ^ n`, is the reduction of a Čech section of `P`. -/
theorem exists_kerCechDOneMap_eq_of_quotient (f : S) (P : ModuleCat.{u} S) {n p m : ℕ}
    (hnp : n ≤ p) (hpm : p ≤ m) (hkill : ∀ x : P, f ^ m • x = 0 → f ^ (m - p) • x = 0)
    (hc : ∀ x : (complementCohomologyFunctor fam ((1 : ℕ) : ℤ)).obj P, f ^ (p - n) • x = 0)
    (y : LinearMap.ker (Cech.cechD fam ((powerQuotientShortComplex f P m).X₃ : Type u) 1)) :
    ∃ s : LinearMap.ker (Cech.cechD fam (P : Type u) 1),
      kerCechDOneMap fam (powerQuotientShortComplex f P n).g s =
        kerCechDOneMap fam (powerQuotientSESMap f P (hnp.trans hpm)).τ₃ y := by
  obtain ⟨s, hs⟩ := HigherComplementTower.exists_preimage_of_quotient fam f P 0 ((1 : ℕ) : ℤ)
    (((1 : ℕ) : ℤ) + 1) (by norm_num) rfl hnp hpm hkill hc
    ((complementEquivKer fam _).symm y)
  refine ⟨complementEquivKer fam P s, ?_⟩
  refine (complementEquivKer_naturality fam _ s).symm.trans ?_
  refine (congrArg (complementEquivKer fam _) hs).trans ?_
  refine (complementEquivKer_naturality fam _ _).trans ?_
  exact congrArg _ ((complementEquivKer fam _).apply_symm_apply y)

end Steps

/-! ### The tower of quotients and the main theorem -/

section Tower

variable {S : Type u} {σ : Type w} {τ : Type t}
  [CommRing S] [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {r : ℕ} (fam : Fin r → S) {c : Fin r → ℕ} (hc : ∀ i, fam i ∈ 𝒜 (c i))
  (M : ModuleCat.{u} S) [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨] (f : S)

/-- The grading of the quotient `M / fⁿM`, the classes of homogeneous elements of `M`: the
quotient grading `Submodule.gradedQuotientPiece`. -/
def quotientTowerPiece (n : ℕ) :
    ℤ → AddSubgroup ((powerQuotientShortComplex f M n).X₃ : Type u) :=
  Submodule.gradedQuotientPiece 𝒨 (powerSmulTop f M n)

/-- The degrees of `S` act on the grading of `M / fⁿM`. -/
instance quotientTowerPiece_gradedSMul (n : ℕ) :
    SetLike.GradedSMul 𝒜 (quotientTowerPiece M 𝒨 f n) where
  smul_mem := fun _ _ _ _ ha hz => Submodule.smul_mem_gradedQuotientPiece 𝒜 𝒨
    (fun _ _ _ _ hb hy => SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) hb hy) _ ha hz

/-- **`fⁿM` is homogeneous** for `f` homogeneous. -/
theorem isHomogeneous_powerSmulTop {δ : ℕ} (hf : f ∈ 𝒜 δ) (n : ℕ) :
    (powerSmulTop f M n).IsHomogeneous 𝒨 :=
  Submodule.isHomogeneous_smul_top 𝒜 𝒨
    (fun _ _ _ _ hb hy => SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) hb hy)
    (Ideal.IsHomogeneous.pow 𝒜
      (Ideal.homogeneous_span 𝒜 {f} fun _ hx => (Set.mem_singleton_iff.1 hx) ▸ ⟨δ, hf⟩) n)

/-- For `f` homogeneous, `M / fⁿM` is the direct sum of its graded pieces. -/
@[instance_reducible] def quotientTowerDecomposition {δ : ℕ} (hf : f ∈ 𝒜 δ) (n : ℕ) :
    DirectSum.Decomposition (quotientTowerPiece M 𝒨 f n) :=
  (Submodule.isInternal_gradedQuotientPiece 𝒨
    (isHomogeneous_powerSmulTop 𝒜 M 𝒨 f hf n)).chooseDecomposition

omit [Decomposition 𝒨] [SetLike.GradedSMul 𝒜 𝒨] in
/-- The projection `M → M / fⁿM` preserves degrees. -/
theorem mem_quotientTowerPiece_g (n : ℕ) (j : ℤ) (x : M) (hx : x ∈ 𝒨 j) :
    (powerQuotientShortComplex f M n).g x ∈ quotientTowerPiece M 𝒨 f n j :=
  Submodule.mkQ_mem_gradedQuotientPiece 𝒨 hx

omit [Decomposition 𝒨] [SetLike.GradedSMul 𝒜 𝒨] in
/-- The projections `M / fᵐM → M / fⁿM` preserve degrees. -/
theorem mem_quotientTowerPiece_τ₃ {n m : ℕ} (h : n ≤ m) (j : ℤ)
    (y : (powerQuotientShortComplex f M m).X₃) (hy : y ∈ quotientTowerPiece M 𝒨 f m j) :
    (powerQuotientSESMap f M h).τ₃ y ∈ quotientTowerPiece M 𝒨 f n j := by
  obtain ⟨x, hx, rfl⟩ := hy
  exact ⟨x, hx, rfl⟩

omit [SetLike τ M] [AddSubgroupClass τ M] in
/-- The projections between the quotients `M / fⁿM` compose. -/
theorem powerQuotientSESMap_τ₃_comp {n p m : ℕ} (h₁ : n ≤ p) (h₂ : p ≤ m) :
    (powerQuotientSESMap f M h₂).τ₃ ≫ (powerQuotientSESMap f M h₁).τ₃ =
      (powerQuotientSESMap f M (h₁.trans h₂)).τ₃ :=
  ModuleCat.hom_ext (LinearMap.ext fun y => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (powerSmulTop f M m) y
    rfl)

omit [SetLike τ M] [AddSubgroupClass τ M] in
/-- The projection from `M / fⁿM` to itself is the identity. -/
theorem powerQuotientSESMap_τ₃_refl (n : ℕ) :
    (powerQuotientSESMap f M (le_refl n)).τ₃ = 𝟙 _ :=
  ModuleCat.hom_ext (LinearMap.ext fun y => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (powerSmulTop f M n) y
    rfl)

/-- **Reduction modulo `fⁿ`** of a Čech section, the map induced by `M → M / fⁿM`. -/
def towerReduction (n : ℕ) :
    LinearMap.ker (Cech.cechD fam (M : Type u) 1) →ₗ[S]
      LinearMap.ker (Cech.cechD fam ((powerQuotientShortComplex f M n).X₃ : Type u) 1) :=
  kerCechDOneMap fam (powerQuotientShortComplex f M n).g

/-- **The transition maps** between the Čech sections of the quotients, induced by the
projections `M / fᵐM → M / fⁿM`. -/
def towerTransition {n m : ℕ} (h : n ≤ m) :
    LinearMap.ker (Cech.cechD fam ((powerQuotientShortComplex f M m).X₃ : Type u) 1) →ₗ[S]
      LinearMap.ker (Cech.cechD fam ((powerQuotientShortComplex f M n).X₃ : Type u) 1) :=
  kerCechDOneMap fam (powerQuotientSESMap f M h).τ₃

/-- The reductions of a Čech section modulo the powers of `f` are compatible. -/
theorem towerTransition_towerReduction {n m : ℕ} (h : n ≤ m)
    (x : LinearMap.ker (Cech.cechD fam (M : Type u) 1)) :
    towerTransition fam M f h (towerReduction fam M f m x) = towerReduction fam M f n x :=
  (kerCechDOneMap_comp_apply fam (powerQuotientShortComplex f M m).g
      (powerQuotientSESMap f M h).τ₃ x).symm.trans
    (congrArg (fun φ => kerCechDOneMap fam φ x) (powerQuotient_g_comp_τ₃ f M h))

/-- A family of Čech sections of the quotients compatible under the successive projections is
compatible under all of them. -/
theorem towerTransition_eq_of_compatible
    (y : ∀ n : ℕ,
      LinearMap.ker (Cech.cechD fam ((powerQuotientShortComplex f M n).X₃ : Type u) 1))
    (hy : ∀ n, towerTransition fam M f (Nat.le_succ n) (y (n + 1)) = y n) {n m : ℕ}
    (h : n ≤ m) : towerTransition fam M f h (y m) = y n := by
  induction m, h using Nat.le_induction with
  | base =>
      refine Subtype.ext ?_
      change cechTermMap fam (powerQuotientSESMap f M (le_refl n)).τ₃ 1 (y n : _) = _
      rw [powerQuotientSESMap_τ₃_refl, cechTermMap_id]
      rfl
  | succ m hnm ih =>
      refine (congrArg (fun φ => kerCechDOneMap fam φ (y (m + 1)))
        (powerQuotientSESMap_τ₃_comp M f hnm (Nat.le_succ m))).symm.trans ?_
      refine (kerCechDOneMap_comp_apply fam _ _ _).trans ?_
      change towerTransition fam M f hnm (towerTransition fam M f (Nat.le_succ m) (y (m + 1))) = _
      rw [hy, ih]

include hc in
/-- **Formal functions on the punctured spectrum, one degree at a time.** Let `S` be a
Noetherian graded ring, `M` a finite `ℤ`-graded `S`-module, `I` the ideal generated by
homogeneous elements `fam i`, and `f` homogeneous of positive degree. Suppose some power of `f`
kills `H¹_I(M)` and some power of `f` kills `H²_I(M)`. Then for every degree `e`, every family
of degree-`e` sections of the `(M / fⁿM)~` on `U = Spec(S) ∖ V(I)`, compatible under the
projections, comes from a unique degree-`e` section of `M̃` on `U`.

Sections on `U` are the degree-one Čech cocycles of `fam`, and their degree-`e` part is
`Stacks.Algebraization.SectionRingCone.kerDegree`. -/
theorem existsUnique_mem_kerDegree_of_compatible [IsNoetherianRing S] [Module.Finite S M]
    (I : Ideal S) (hI : I.FG) (hfam : Ideal.span (Set.range fam) = I) {δ : ℕ} (hf : f ∈ 𝒜 δ)
    (hδ : 0 < δ)
    (h1 : ∃ c : ℕ, ∀ x : localCohomologyModule S I hI M 1, f ^ c • x = 0)
    (h2 : ∃ c : ℕ, ∀ x : localCohomologyModule S I hI M 2, f ^ c • x = 0) (e : ℤ)
    (y : ∀ n : ℕ,
      LinearMap.ker (Cech.cechD fam ((powerQuotientShortComplex f M n).X₃ : Type u) 1))
    (hy : ∀ n, y n ∈ kerDegree 𝒜 fam (powerQuotientShortComplex f M n).X₃
      (quotientTowerPiece M 𝒨 f n) e)
    (hcompat : ∀ n, towerTransition fam M f (Nat.le_succ n) (y (n + 1)) = y n) :
    ∃! x : LinearMap.ker (Cech.cechD fam (M : Type u) 1), x ∈ kerDegree 𝒜 fam M 𝒨 e ∧
      ∀ n, towerReduction fam M f n x = y n := by
  classical
  obtain ⟨c₁, hc₁⟩ := h1
  obtain ⟨c₂, hc₂⟩ := h2
  obtain ⟨Nst, hNst⟩ := exists_powerTorsion_stable f M
  obtain ⟨B, hB⟩ := exists_forall_lt_eq_zero_of_finite 𝒜 𝒨 (M := (M : Type u))
  have hkill : ∀ {p m : ℕ}, p + Nst ≤ m → ∀ z : M, f ^ m • z = 0 → f ^ (m - p) • z = 0 :=
    fun {p m} h z hz =>
      pow_smul_eq_zero_of_powerTorsion_stable f M hNst (by omega) (by omega) z hz
  have hc₂' : ∀ x : (complementCohomologyFunctor fam ((1 : ℕ) : ℤ)).obj M, f ^ c₂ • x = 0 :=
    HigherComplementTower.pow_smul_complementCohomology_eq_zero hI fam hfam f M 1 le_rfl c₂
      (by rw [show ((1 : ℕ) : ℤ) + 1 = 2 by norm_num]; exact hc₂)
  -- injectivity at a single level
  have hinj : ∃ n₁, ∀ x ∈ kerDegree 𝒜 fam M 𝒨 e, towerReduction fam M f n₁ x = 0 → x = 0 := by
    refine ⟨c₁ + (e - B).toNat + 1 + Nst, fun x hx hred => ?_⟩
    obtain ⟨w, hw⟩ := exists_pow_smul_of_kerCechDOneMap_eq_zero fam f M
      (p := c₁ + (e - B).toNat + 1) (Nat.le_add_right _ _) (hkill le_rfl) x hred
    obtain ⟨w', hw'deg, hxw'⟩ := exists_mem_kerDegree_smul_eq 𝒜 fam hc M 𝒨
      (SetLike.pow_mem_graded _ hf) hx hw
    obtain ⟨m₀, hm₀⟩ := exists_cechRes_eq_pow_smul fam I hI hfam M f c₁ hc₁ w'
    have hdeg := smul_mem_kerDegree 𝒜 fam hc M 𝒨 (SetLike.pow_mem_graded c₁ hf) hw'deg
    rw [← hm₀] at hdeg
    obtain ⟨m', hm'deg, hm'⟩ := exists_mem_cechRes_eq 𝒜 fam hc M 𝒨 hdeg
    have hlt : ((c₁ • δ : ℕ) : ℤ) + (e - ((c₁ + (e - B).toNat + 1) • δ : ℕ)) < B := by
      have h0 : e - B ≤ ((e - B).toNat : ℤ) := Int.self_le_toNat _
      have hδ' : (1 : ℤ) ≤ δ := by exact_mod_cast hδ
      simp only [smul_eq_mul]
      push_cast
      nlinarith
    have hm'0 : m' = 0 := hB _ hlt m' hm'deg
    have hzero : f ^ c₁ • w' = 0 := by rw [← hm₀, ← hm', hm'0, map_zero]
    rw [hxw', show c₁ + (e - B).toNat + 1 = ((e - B).toNat + 1) + c₁ by omega, pow_add,
      mul_smul, hzero, smul_zero]
  -- a degree-`e` lift at every level
  have hlift : ∀ n, ∃ x ∈ kerDegree 𝒜 fam M 𝒨 e, towerReduction fam M f n x = y n := by
    intro n
    let := quotientTowerDecomposition 𝒜 M 𝒨 f hf n
    obtain ⟨s, hs⟩ := exists_kerCechDOneMap_eq_of_quotient fam f M (n := n) (p := n + c₂)
      (m := n + c₂ + Nst) (Nat.le_add_right _ _) (Nat.le_add_right _ _) (hkill le_rfl)
      (by rw [Nat.add_sub_cancel_left]; exact hc₂') (y (n + c₂ + Nst))
    have hs' : towerReduction fam M f n s = y n :=
      hs.trans (towerTransition_eq_of_compatible fam M f y hcompat _)
    obtain ⟨s', hs'deg, hs''⟩ := exists_mem_kerDegree_kerCechDOneMap_eq 𝒜 fam hc M 𝒨
      (quotientTowerPiece M 𝒨 f n) (powerQuotientShortComplex f M n).g
      (mem_quotientTowerPiece_g M 𝒨 f n) s (hs' ▸ hy n)
    exact ⟨s', hs'deg, hs''.trans hs'⟩
  obtain ⟨n₁, hn₁⟩ := hinj
  choose xs hxsdeg hxs using hlift
  refine ⟨xs n₁, ⟨hxsdeg n₁, fun n => ?_⟩, ?_⟩
  · rcases le_total n n₁ with h | h
    · rw [← towerTransition_towerReduction fam M f h, hxs n₁,
        towerTransition_eq_of_compatible fam M f y hcompat h]
    · have heq : xs n = xs n₁ := by
        refine sub_eq_zero.1 (hn₁ _ (sub_mem (hxsdeg n) (hxsdeg n₁)) ?_)
        rw [map_sub, hxs n₁, ← towerTransition_towerReduction fam M f h, hxs n,
          towerTransition_eq_of_compatible fam M f y hcompat h, sub_self]
      rw [← heq, hxs n]
  · rintro x' ⟨hx'deg, hx'red⟩
    exact sub_eq_zero.1 (hn₁ _ (sub_mem hx'deg (hxsdeg n₁))
      (by rw [map_sub, hx'red, hxs n₁, sub_self]))

end Tower

end Stacks.Algebraization.SectionRingCone

