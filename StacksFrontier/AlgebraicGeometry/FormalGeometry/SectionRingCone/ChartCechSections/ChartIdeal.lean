universe u

namespace Stacks.Algebraization.SectionRingCone

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
  (hL : Stacks.Ample.IsAmple X L) {d : ℕ} (hd : 0 < d) (a : powSections L d)
  (t : powSections L 1) {k : ℕ} {c : sectionRing L} (hc : c ∈ grading L k) (hk : 1 + k = d)
  (hac : DirectSum.of (powSections L) 1 t * c = DirectSum.of (powSections L) d a)

/-- The image `f ∈ A₁` of a global section `s` of `L`. -/
abbrev sectionDegreeOne (s : Γ(L, ⊤)) : sectionRing L :=
  DirectSum.of (powSections L) 1 (degreeOneSection L s)

include hc hk in
omit [Stacks.Ample.IsInvertibleModule X L] in
/-- `f c` has the degree of `a`. -/
theorem sectionDegreeOne_mul_mem (s : Γ(L, ⊤)) :
    sectionDegreeOne L s * c ∈ grading L (1 • d) := by
  rw [one_smul, ← hk]
  exact SetLike.mul_mem_graded (Stacks.ExternalGrading.of_mem_summand 1 _) hc

/-- **The local equation of `Z(s)` on `X_a`**: the degree-zero fraction `f c / a`, which is `s`
divided by the trivialization `t` of `L` on `X_a`. -/
def chartEquation (s : Γ(L, ⊤)) : HomogeneousLocalization.Away (grading L)
    (DirectSum.of (powSections L) d a) :=
  HomogeneousLocalization.Away.mk (grading L) (Stacks.ExternalGrading.of_mem_summand d a) 1
    (sectionDegreeOne L s * c) (sectionDegreeOne_mul_mem L hc hk s)

/-- The local equation, as a fraction of the localization. -/
theorem chartEquation_val (s : Γ(L, ⊤)) :
    (chartEquation L a hc hk s).val =
      Localization.mk (sectionDegreeOne L s * c)
        (⟨DirectSum.of (powSections L) d a ^ 1, 1, rfl⟩ :
          Submonoid.powers (DirectSum.of (powSections L) d a)) :=
  HomogeneousLocalization.Away.val_mk _ _ _ _ _

/-- The chart comparison as a map into the localization `A_a`. -/
abbrev chartMap (e : ℕ) (σ : Γ(natTensorPow L e, nvOpen L a)) :
    LocalizedModule.Away (DirectSum.of (powSections L) d a) (sectionRing L) :=
  (chartSectionsEquiv L hL hd a e σ :
    Stacks.GradedLocalization.gradedPiece (grading L)
      (integerGrading (S := sectionRing L) (grading L)) (DirectSum.of (powSections L) d a)
      (e : ℤ))

/-- The chart comparison is injective. -/
theorem chartMap_injective (e : ℕ) : Function.Injective (chartMap L hL hd a e) :=
  fun _ _ h => (chartSectionsEquiv L hL hd a e).injective (Subtype.ext h)

include hL hd hac in
/-- **`s = (f c / a) · t` on `X_a`**, as sections of `L^{⊗ 1}`. -/
theorem chartEquation_smul_unitSec (s : Γ(L, ⊤)) :
    chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) • unitSec t (nvOpen L a) =
      unitSec (degreeOneSection L s) (nvOpen L a) := by
  apply chartMap_injective L hL hd a 1
  rw [chartMap, chartSectionsEquiv_smul, RingEquiv.symm_apply_apply, chartMap,
    chartSectionsEquiv_unitSec, chartSectionsEquiv_unitSec, chartEquation_val,
    LocalizedModule.mk_smul_mk]
  refine LocalizedModule.mk_eq.2 ⟨1, ?_⟩
  simp only [one_smul, Submonoid.smul_def, smul_eq_mul, mul_one, pow_one]
  rw [← hac]
  ring

include hL hd hc hk hac in
/-- **The trivialization by `t`**: `r ↦ r · t` is a bijection from the functions on `X_a` to the
sections of `L^{⊗ 1}` over `X_a`. -/
theorem bijective_smul_unitSec :
    Function.Bijective (fun r : Γ(X, nvOpen L a) => r • unitSec t (nvOpen L a)) := by
  obtain ⟨hmem, hinj, hsurj⟩ := bijective_smul_mk_degreeOne (𝒜 := grading L)
    (Stacks.ExternalGrading.of_mem_summand d a) (Stacks.ExternalGrading.of_mem_summand 1 t) hc hk
    hac
  have hχ : ∀ r : Γ(X, nvOpen L a), chartMap L hL hd a 1 (r • unitSec t (nvOpen L a)) =
      ((chartFunctionsEquiv L hL hd a).symm r).val •
        LocalizedModule.mk (DirectSum.of (powSections L) 1 t)
          (1 : Submonoid.powers (DirectSum.of (powSections L) d a)) := by
    intro r
    rw [chartMap, chartSectionsEquiv_smul, ← chartMap, chartMap, chartSectionsEquiv_unitSec]
  refine ⟨fun r r' h => ?_, fun σ => ?_⟩
  · have h' := congrArg (chartMap L hL hd a 1) h
    simp only [hχ] at h'
    exact (chartFunctionsEquiv L hL hd a).symm.injective (hinj h')
  · obtain ⟨w, hw⟩ := hsurj (chartMap L hL hd a 1 σ)
      (chartSectionsEquiv L hL hd a 1 σ).2
    refine ⟨chartFunctionsEquiv L hL hd a w, chartMap_injective L hL hd a 1 ?_⟩
    rw [hχ, RingEquiv.symm_apply_apply, hw]

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- **The section `s`, restricted to an open**, is the image under the left unitor of the section
of `L^{⊗ 1}` attached to its degree-one element. -/
theorem leftUnitor_app_unitSec_degreeOneSection (s : Γ(L, ⊤)) (U : X.Opens) :
    (λ_ L).hom.app U (unitSec (degreeOneSection L s) U) =
      L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op s := by
  rw [Stacks.SectionRingProjQuasicoherent.unitSec_eq_map_globalSection]
  refine (modulesHom_app_presheaf_map (M := 𝟙_ X.Modules ⊗ L) (λ_ L).hom
    (homOfLE (le_top : U ≤ ⊤)) _).trans ?_
  refine congrArg (L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op) ?_
  refine (congrArg ((λ_ L).hom.app ⊤) (globalSection_degreeOneSection L s)).trans ?_
  rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, Iso.inv_hom_id,
    Scheme.Modules.Hom.id_app, ConcreteCategory.id_apply]

include hL hd hc hk hac in
/-- **The ideal of the zero scheme on `X_a`** is generated by the local equation `f c / a`.

`s = (f c / a) · t` on `X_a`, so every value of a linear functional at `s` is a multiple of the
local equation; conversely the inverse of the trivialization `r ↦ r · t` is a linear functional
taking the value `f c / a` at `s`. -/
theorem zeroScheme_ideal_chart (haff : IsAffineOpen (nvOpen L a)) (s : Γ(L, ⊤)) :
    (AlgebraicGeometry.zeroScheme X L s).ideal ⟨nvOpen L a, haff⟩ =
      Ideal.span {chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s)} := by
  refine (Stacks.Tag02OQSectionIdeal.zeroScheme_ideal L s ⟨nvOpen L a, haff⟩).trans ?_
  set U := nvOpen L a
  set r₀ := chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s)
  set ℓ := (λ_ L).hom.app U (unitSec t U)
  have hsU : L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op s = r₀ • ℓ := by
    rw [← leftUnitor_app_unitSec_degreeOneSection, ←
      chartEquation_smul_unitSec L hL hd a t hc hk hac s, Scheme.Modules.Hom.app_smul]
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨φ, rfl⟩
    rw [hsU, map_smul, smul_eq_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self r₀)
  · let μ : Γ(X, U) →ₗ[Γ(X, U)] Γ(L, U) := LinearMap.toSpanSingleton _ _ ℓ
    have hμ : Function.Bijective μ := by
      have hiso : Function.Bijective ((λ_ L).hom.app U) :=
        ConcreteCategory.bijective_of_isIso _
      have hcomp : (μ : Γ(X, U) → Γ(L, U)) =
          (λ_ L).hom.app U ∘ (fun r : Γ(X, U) => r • unitSec t U) := by
        funext r
        simp only [μ, LinearMap.toSpanSingleton_apply, Function.comp_apply, ℓ,
          Scheme.Modules.Hom.app_smul]
      rw [hcomp]
      exact hiso.comp (bijective_smul_unitSec L hL hd a t hc hk hac)
    refine (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨
      (LinearEquiv.ofBijective μ hμ).symm.toLinearMap, ?_⟩)
    show r₀ = (LinearEquiv.ofBijective μ hμ).symm _
    rw [hsU]
    exact ((LinearEquiv.ofBijective μ hμ).symm_apply_apply r₀).symm

variable {L} in
/-- The `f`-adic quotients of the section ring, as in the tower of
`Stacks.Algebraization.SectionRingCone.towerReduction`. -/
abbrev sectionRingModule : @ModuleCat.{u} (sectionRing L) CommRing.toRing :=
  @ModuleCat.of (sectionRing L) CommRing.toRing (sectionRing L) _ (Semiring.toModule)

include hL hd hc hk hac in
/-- **The kernel of the ideal-power quotient on `X_a`**: a section of `L^{⊗ m}` over `X_a` dies
in `L^{⊗ m} / Z(s)^{n+1} L^{⊗ m}` exactly when it is a multiple of the `(n+1)`-st power of the
local equation of `Z(s)`. -/
theorem idealPowerQuotient_app_eq_zero_iff_chart (haff : IsAffineOpen (nvOpen L a))
    (s : Γ(L, ⊤)) (m n : ℕ) [(natTensorPow L m).IsQuasicoherent]
    (σ : Γ(natTensorPow L m, nvOpen L a)) :
    (cokernel.π (C := X.Modules) (Stacks.Algebraization.idealPowerMultiple
        (AlgebraicGeometry.zeroScheme X L s) (n + 1) (natTensorPow L m)).ι).app
        (nvOpen L a) σ = 0 ↔
      ∃ σ' : Γ(natTensorPow L m, nvOpen L a),
        σ = chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) ^ (n + 1) • σ' := by
  refine (Stacks.Algebraization.cokernel_π_app_eq_zero_iff _ _ (nvOpen L a) σ).trans ?_
  rw [Stacks.Algebraization.idealPowerMultiple_toSubmodule_obj_affine _ (n + 1) _
      ⟨nvOpen L a, haff⟩,
    zeroScheme_ideal_chart L hL hd a t hc hk hac haff s, Ideal.span_singleton_pow]
  refine (Stacks.AdicCompletion.NearVanishingLocus.mem_span_singleton_smul_top_iff _ σ).trans ?_
  exact ⟨fun ⟨σ', h⟩ => ⟨σ', h.symm⟩, fun ⟨σ', h⟩ => ⟨σ', h.symm⟩⟩

/-- The powers of the local equation, read back in the localization. -/
theorem chartScalar_pow_val (s : Γ(L, ⊤)) (n : ℕ) :
    ((chartFunctionsEquiv L hL hd a).symm
        (chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) ^ (n + 1))).val =
      Localization.mk ((sectionDegreeOne L s * c) ^ (n + 1))
        ((⟨DirectSum.of (powSections L) d a ^ 1, 1, rfl⟩ :
          Submonoid.powers (DirectSum.of (powSections L) d a)) ^ (n + 1)) := by
  rw [← map_pow, RingEquiv.symm_apply_apply, HomogeneousLocalization.val_pow, chartEquation_val,
    Localization.mk_pow]

/-- **The reduction of a chart section modulo `f^{n+1}`**: the image of `χ σ ∈ A_a` in
`(A / f^{n+1} A)_a`. -/
def chartQuotientReduction (s : Γ(L, ⊤)) (m n : ℕ) (σ : Γ(natTensorPow L m, nvOpen L a)) :
    LocalizedModule (Submonoid.powers (DirectSum.of (powSections L) d a))
      ((Stacks.LocalCohomology.powerQuotientShortComplex (sectionDegreeOne L s)
        (sectionRingModule (L := L)) (n + 1)).X₃) :=
  LocalizedModule.map (Submonoid.powers (DirectSum.of (powSections L) d a))
    (Stacks.LocalCohomology.powerQuotientShortComplex (sectionDegreeOne L s)
      (sectionRingModule (L := L)) (n + 1)).g.hom (chartMap L hL hd a m σ)

/-- A multiple of `f ^ j` lies in `f ^ j A`. -/
theorem pow_mul_mem_powerSmulTop (f : sectionRing L) (j : ℕ) (y : sectionRing L) :
    f ^ j * y ∈ Stacks.LocalCohomology.powerSmulTop f (sectionRingModule (L := L)) j :=
  Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self f) j) trivial

/-- Every element of `f ^ j A` is a multiple of `f ^ j`. -/
theorem exists_eq_pow_mul_of_mem_powerSmulTop (f : sectionRing L) (j : ℕ) {x : sectionRing L}
    (hx : x ∈ Stacks.LocalCohomology.powerSmulTop f (sectionRingModule (L := L)) j) :
    ∃ y : sectionRing L, x = f ^ j * y := by
  rw [Stacks.LocalCohomology.powerSmulTop, Ideal.span_singleton_pow] at hx
  obtain ⟨y, hy⟩ :=
    (Stacks.AdicCompletion.NearVanishingLocus.mem_span_singleton_smul_top_iff _ x).1 hx
  exact ⟨y, hy.symm⟩

include hd in
/-- If `A₀ ^ M' x = f ^ (n+1) y` with `A₀ ∈ A_d`, `f ∈ A₁` and `x ∈ A_i`, then
`A₀ ^ (M' + n + 1) x` is `f ^ (n+1)` times a homogeneous element of the complementary degree. -/
theorem exists_mem_grading_pow_mul_eq {f A₀ x y : sectionRing L} {i M' n : ℕ}
    (hA₀ : A₀ ∈ grading L d) (hf : f ∈ grading L 1) (hx : x ∈ grading L i)
    (hy : A₀ ^ M' * x = f ^ (n + 1) * y) :
    ∃ y' ∈ grading L (i + (M' + (n + 1)) * d - (n + 1)),
      f ^ (n + 1) * y' = A₀ ^ (M' + (n + 1)) * x := by
  set M'' := M' + (n + 1)
  set D := i + M'' * d
  have hD : n + 1 ≤ D := by
    have : n + 1 ≤ M'' * d := by
      calc n + 1 ≤ M'' := by omega
        _ ≤ M'' * d := Nat.le_mul_of_pos_right _ hd
    omega
  have hax : A₀ ^ M'' * x ∈ grading L D := by
    rw [show D = M'' * d + i by ring]
    exact SetLike.mul_mem_graded (by simpa using SetLike.pow_mem_graded M'' hA₀) hx
  have e1 : A₀ ^ M'' * x = f ^ (n + 1) * (A₀ ^ (n + 1) * y) := by
    rw [show M'' = (n + 1) + M' by omega, pow_add, mul_assoc, hy]
    ring
  refine ⟨_, SetLike.coe_mem (DirectSum.decompose (grading L) (A₀ ^ (n + 1) * y) (D - (n + 1))),
    ?_⟩
  rw [← DirectSum.decompose_of_mem_same _ hax, e1,
    DirectSum.coe_decompose_mul_of_left_mem_of_le (grading L)
      (by simpa using SetLike.pow_mem_graded (n + 1) hf) hD]

include hc hk hac in
/-- A section whose chart image dies modulo `f^{n+1}` is a multiple of the `(n+1)`-st power of
the local equation of `Z(s)`. -/
theorem exists_eq_chartEquation_pow_smul_of_chartQuotientReduction_eq_zero (s : Γ(L, ⊤))
    (m n : ℕ) (σ : Γ(natTensorPow L m, nvOpen L a))
    (h : chartQuotientReduction L hL hd a s m n σ = 0) :
    ∃ σ' : Γ(natTensorPow L m, nvOpen L a),
      σ = chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) ^ (n + 1) • σ' := by
  set f := sectionDegreeOne L s
  set A₀ := DirectSum.of (powSections L) d a
  have hA₀ : A₀ ∈ grading L d := Stacks.ExternalGrading.of_mem_summand d a
  set g := (Stacks.LocalCohomology.powerQuotientShortComplex f
    (sectionRingModule (L := L)) (n + 1)).g
  obtain ⟨N, i, x, hi, hx, hχ⟩ := exists_mk_of_mem_gradedPiece (grading L) hA₀
    (Int.natCast_nonneg m) (chartSectionsEquiv L hL hd a m σ).2
  have h0 : LocalizedModule.mk (g x) (⟨A₀ ^ N, N, rfl⟩ : Submonoid.powers A₀) = 0 :=
    (LocalizedModule.map_mk _ g.hom x _).symm.trans ((congrArg _ hχ).symm.trans h)
  obtain ⟨M', hM'⟩ := LocalizedModule.exists_pow_smul_eq_zero_of_mk_eq_zero h0
  have hmem : A₀ ^ M' * x ∈
      Stacks.LocalCohomology.powerSmulTop f (sectionRingModule (L := L)) (n + 1) :=
    (Submodule.Quotient.mk_eq_zero _).1 ((map_smul g.hom (A₀ ^ M') x).trans hM')
  obtain ⟨y, hy⟩ := exists_eq_pow_mul_of_mem_powerSmulTop L f (n + 1) hmem
  obtain ⟨y', hy'mem, hy'⟩ := exists_mem_grading_pow_mul_eq L hd hA₀
    (Stacks.ExternalGrading.of_mem_summand 1 _) hx hy
  set M'' := M' + (n + 1)
  set D := i + M'' * d
  set T := DirectSum.of (powSections L) 1 t
  have hTmem : T ∈ grading L 1 := Stacks.ExternalGrading.of_mem_summand 1 t
  have hD : n + 1 ≤ D :=
    (Nat.le_add_left _ M').trans ((Nat.le_mul_of_pos_right _ hd).trans (Nat.le_add_left _ i))
  have hnum : T ^ (n + 1) * y' ∈ grading L D := by
    have h1 := SetLike.mul_mem_graded (by simpa using SetLike.pow_mem_graded (n + 1) hTmem)
      hy'mem
    rwa [show n + 1 + (D - (n + 1)) = D by omega] at h1
  have hz := mk_mem_gradedPiece_of_mem (grading L) hA₀ (e := (m : ℤ)) (n := M'' + N)
    (i := D) (by
      have : (i : ℤ) = m + N * d := by simpa using hi
      simp only [D, M'', Nat.cast_add, Nat.cast_mul, Nat.cast_one]
      linear_combination this) hnum
  refine ⟨(chartSectionsEquiv L hL hd a m).symm ⟨_, hz⟩, chartMap_injective L hL hd a m ?_⟩
  have e1 := chartSectionsEquiv_smul L hL hd a m
    (chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) ^ (n + 1))
    ((chartSectionsEquiv L hL hd a m).symm ⟨_, hz⟩)
  rw [chartScalar_pow_val L hL hd a hc hk s n, AddEquiv.apply_symm_apply,
    LocalizedModule.mk_smul_mk] at e1
  refine hχ.trans (Eq.trans ?_ e1.symm)
  refine LocalizedModule.mk_eq.2 ⟨1, ?_⟩
  simp only [one_smul, Submonoid.smul_def, smul_eq_mul, Submonoid.coe_mul,
    SubmonoidClass.coe_pow, pow_one]
  rw [show (f * c) ^ (n + 1) * (T ^ (n + 1) * y') = (T * c) ^ (n + 1) * (f ^ (n + 1) * y') by
    ring, hac, hy']
  ring

/-- A multiple of the `(n+1)`-st power of the local equation of `Z(s)` has chart image dying
modulo `f^{n+1}`. -/
theorem chartQuotientReduction_chartEquation_pow_smul (s : Γ(L, ⊤)) (m n : ℕ)
    (σ' : Γ(natTensorPow L m, nvOpen L a)) :
    chartQuotientReduction L hL hd a s m n
      (chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) ^ (n + 1) • σ') = 0 := by
  set f := sectionDegreeOne L s
  set A₀ := DirectSum.of (powSections L) d a
  have hA₀ : A₀ ∈ grading L d := Stacks.ExternalGrading.of_mem_summand d a
  set g := (Stacks.LocalCohomology.powerQuotientShortComplex f
    (sectionRingModule (L := L)) (n + 1)).g
  obtain ⟨N, i, x, -, -, hχ⟩ := exists_mk_of_mem_gradedPiece (grading L) hA₀
    (Int.natCast_nonneg m) (chartSectionsEquiv L hL hd a m σ').2
  have e1 := chartSectionsEquiv_smul L hL hd a m
    (chartFunctionsEquiv L hL hd a (chartEquation L a hc hk s) ^ (n + 1)) σ'
  rw [chartScalar_pow_val L hL hd a hc hk s n, hχ, LocalizedModule.mk_smul_mk] at e1
  have hgz : g ((f * c) ^ (n + 1) • x) = 0 := by
    refine (Submodule.Quotient.mk_eq_zero _).2 ?_
    rw [smul_eq_mul, mul_pow, mul_assoc]
    exact pow_mul_mem_powerSmulTop L f (n + 1) _
  show LocalizedModule.map (Submonoid.powers A₀) g.hom (chartMap L hL hd a m _) = 0
  exact (congrArg (LocalizedModule.map (Submonoid.powers A₀) g.hom) e1).trans
    ((LocalizedModule.map_mk _ g.hom _ _).trans
      ((congrArg (fun z => LocalizedModule.mk z _) hgz).trans (LocalizedModule.zero_mk _)))

include hc hk hac in
/-- **A section dies modulo `Z(s)^{n+1}` exactly when its chart image dies modulo `f^{n+1}`.** -/
theorem chartQuotientReduction_eq_zero_iff (haff : IsAffineOpen (nvOpen L a)) (s : Γ(L, ⊤))
    (m n : ℕ) [(natTensorPow L m).IsQuasicoherent] (σ : Γ(natTensorPow L m, nvOpen L a)) :
    chartQuotientReduction L hL hd a s m n σ = 0 ↔
      (cokernel.π (C := X.Modules) (Stacks.Algebraization.idealPowerMultiple
        (AlgebraicGeometry.zeroScheme X L s) (n + 1) (natTensorPow L m)).ι).app
        (nvOpen L a) σ = 0 := by
  rw [idealPowerQuotient_app_eq_zero_iff_chart L hL hd a t hc hk hac haff s m n σ]
  refine ⟨exists_eq_chartEquation_pow_smul_of_chartQuotientReduction_eq_zero
    L hL hd a t hc hk hac s m n σ, ?_⟩
  rintro ⟨σ', rfl⟩
  exact chartQuotientReduction_chartEquation_pow_smul L hL hd a hc hk s m n σ'

end Stacks.Algebraization.SectionRingCone

