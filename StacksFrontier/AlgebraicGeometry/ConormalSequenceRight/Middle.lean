module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import StacksFrontier.AlgebraicGeometry.ConormalSequenceRight.Basic
public import StacksFrontier.AlgebraicGeometry.Morphisms.Differentials.Stalk
import StacksCore.Tactic.StacksAttribute

/-!
# Exactness at the middle term of the conormal sequence of an immersion

For an immersion `i : Z ⟶ X` of schemes over `S` whose source is cut out by global sections
`f j` of `𝒪_X`, the kernel of the canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` of [Stacks, Tag 01UV]
is generated by the pulled-back differentials `d (f j)`. Together with surjectivity of that map
this is exactness of the conormal sequence of [Stacks, Tag 01UZ] at its middle term, in the
concrete form in which the equations present the conormal module of the immersion.

## Main results

* `Stacks.ConormalSequenceRight.equationDifferentialsComplex_exact`: the complex
  `⊕_j 𝒪_Z ⟶ i^*Ω_{X/S} ⟶ Ω_{Z/S}`, whose left-hand map sends the `j`-th generator to the
  pullback of `d (f j)`, is exact at its middle term as soon as `i` is surjective on stalks.
* `Stacks.ConormalSequenceRight.equationDifferentialsComplexOver_exact`: the same for an
  immersion, which is the hypothesis [Stacks, Tag 01UZ] states it under. This is the assertion
  labelled *exactness at the middle term*.

## Implementation notes

Being cut out by a family of global sections is taken in the stalkwise form
`Stacks.ConormalSequenceRight.IsCutOutBy`: at every point of `Z` the kernel of the stalk map of
`i` is the ideal generated by the germs of the sections.

The left-hand term of the complex is the free sheaf of modules on the index type, which is the
form in which the conormal module of an immersion cut out by equations is presented.

The stalk of a sheaf of modules carries an action of the stalk of the sheaf of commutative rings
only when its ring presheaf is presented as a composite with `forget₂ CommRingCat RingCat`, so
the three stalks are named through such a presentation inside the proof, exactly as in
`AlgebraicGeometry.Scheme.Hom.isIso_relativeDifferentialsMap_of_stalk`.

## References

* [Stacks Project, Tag 01UZ](https://stacks.math.columbia.edu/tag/01UZ)
* [Stacks Project, Tag 01UV](https://stacks.math.columbia.edu/tag/01UV)
* [Stacks Project, Tag 08TS](https://stacks.math.columbia.edu/tag/08TS)
* [Stacks Project, Tag 01V0](https://stacks.math.columbia.edu/tag/01V0)
* [Stacks Project, Tag 0098](https://stacks.math.columbia.edu/tag/0098)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.RelativeDifferentialStalk Stacks.RelativeDifferentialStalkMap
open scoped TensorProduct

universe u

namespace Stacks.ConormalSequenceRight

variable {Z X S : Scheme.{u}}

/-- A family of global sections of `𝒪_X` **cuts out** a morphism `i : Z ⟶ X` if at every point
of `Z` the kernel of the stalk map of `i` is the ideal generated by the germs of the sections.
This is the local form of `Z` being the closed subscheme defined by the equations. -/
def IsCutOutBy (i : Z ⟶ X) {I : Type u} (f : I → Γ(X, ⊤)) : Prop :=
  ∀ x : Z, RingHom.ker (i.stalkMap x).hom =
    Ideal.span (Set.range fun j => X.presheaf.germ ⊤ (i.base x) trivial (f j))

/-- The preimage of the whole space is the whole space. -/
theorem le_preimage_top (i : Z ⟶ X) (W : Z.Opens) : W ≤ i ⁻¹ᵁ (⊤ : X.Opens) :=
  fun _ _ => trivial

/-- A section over an open subset containing every open subset, read as a global section. -/
def sectionOfGlobal {Y : Scheme.{u}} (M : Y.Modules) {V : Y.Opens}
    (hV : ∀ W : Y.Opens, W ≤ V) (m : M.val.obj (op V)) : SheafOfModules.sections M :=
  M.val.sectionsMk (fun W => M.val.map (homOfLE (hV W.unop)).op m) fun {_ _} g => by
    rw [← M.val.map_comp_apply]
    exact M.val.congr_map_apply (Subsingleton.elim _ _) m

/-- The value of a global section coming from a largest open subset is the original section. -/
theorem sectionOfGlobal_eval {Y : Scheme.{u}} (M : Y.Modules) {V : Y.Opens}
    (hV : ∀ W : Y.Opens, W ≤ V) (m : M.val.obj (op V)) :
    (sectionOfGlobal M hV m).eval (op V) = m := by
  refine (M.val.congr_map_apply (Subsingleton.elim _ (𝟙 (op V))) m).trans ?_
  change (ConcreteCategory.hom (M.val.presheaf.map (𝟙 (op V)))) m = m
  rw [M.val.presheaf.map_id]
  rfl

/-- The pullback along `i` of the universal differential of a global section of `𝒪_X`, as a
global section of `i^*Ω_{X/S}`. -/
def pulledBackDifferential (i : Z ⟶ X) (p : X ⟶ S) (a : Γ(X, ⊤)) :
    SheafOfModules.sections
      ((Scheme.Modules.pullback i).obj (Scheme.Hom.relativeDifferentials p)) :=
  sectionOfGlobal _ (le_preimage_top i)
    (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app
        (Scheme.Hom.relativeDifferentials p)).val.app (op ⊤)
      ((Scheme.Hom.universalRelativeDerivation p).d a))

/-- The canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` carries the pullback of the universal differential
of a section `a` of `𝒪_X` over `U` to the universal differential of the pullback of `a`. -/
private theorem relativeDifferentialsMap_app_unit_d (i : Z ⟶ X) (p : X ⟶ S)
    (hcomm : i ≫ p = (i ≫ p) ≫ 𝟙 S) (U : X.Opens) (a : Γ(X, U)) :
    ((Scheme.Hom.relativeDifferentialsMap i p (i ≫ p) (𝟙 S) hcomm).val.app
        (op (i ⁻¹ᵁ U))).hom
        (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app
            (Scheme.Hom.relativeDifferentials p)).val.app (op U)
          ((Scheme.Hom.universalRelativeDerivation p).d a)) =
      (Scheme.Hom.universalRelativeDerivation (i ≫ p)).d ((i.app U).hom a) := by
  have h := Scheme.Hom.relativeDifferentialsMap_app_d (f := i) (p := p) (p' := i ≫ p)
    (𝟙 S) hcomm U a
  rwa [Adjunction.homEquiv_unit] at h

/-- A global section of `𝒪_X` cutting out `i` pulls back to zero on `Z`. -/
private theorem app_top_eq_zero (i : Z ⟶ X) {I : Type u} {f : I → Γ(X, ⊤)}
    (hf : IsCutOutBy i f) (j : I) : (i.app ⊤).hom (f j) = 0 := by
  refine TopCat.Presheaf.section_ext Z.sheaf _ _ 0 fun x hx => ?_
  refine (Scheme.Hom.germ_stalkMap_apply i ⊤ x hx (f j)).symm.trans ?_
  refine Eq.trans ?_ (map_zero (ConcreteCategory.hom
    (Z.presheaf.germ (i ⁻¹ᵁ (⊤ : X.Opens)) x hx))).symm
  refine RingHom.mem_ker.1 ?_
  rw [hf x]
  exact Ideal.subset_span ⟨j, rfl⟩

/-- The free sheaf of modules on an index type over the structure sheaf of a scheme. -/
def freeModules (Z : Scheme.{u}) (I : Type u) : Z.Modules := SheafOfModules.free I

/-- Morphisms out of the free sheaf of modules on `I` are the families of global sections
indexed by `I`. -/
def freeModulesHomEquiv (Z : Scheme.{u}) (I : Type u) (M : Z.Modules) :
    (freeModules Z I ⟶ M) ≃ (I → SheafOfModules.sections M) :=
  SheafOfModules.freeHomEquiv M

/-- Postcomposition acts on the family of sections attached to a morphism out of a free sheaf
of modules by pushing each section forward. -/
theorem freeModulesHomEquiv_comp (Z : Scheme.{u}) (I : Type u) {M N : Z.Modules}
    (c : freeModules Z I ⟶ M) (ψ : M ⟶ N) (j : I) :
    freeModulesHomEquiv Z I N (c ≫ ψ) j =
      SheafOfModules.sectionsMap ψ (freeModulesHomEquiv Z I M c j) :=
  rfl

/-- The tautological global section of the free sheaf of modules attached to an index. -/
def freeModulesSection (Z : Scheme.{u}) {I : Type u} (j : I) :
    SheafOfModules.sections (freeModules Z I) :=
  SheafOfModules.freeSection j

/-- A morphism out of a free sheaf of modules carries the `j`-th tautological section to the
`j`-th section of its family. -/
theorem sectionsMap_freeModulesSection (Z : Scheme.{u}) {I : Type u} {M : Z.Modules}
    (s : I → SheafOfModules.sections M) (j : I) :
    SheafOfModules.sectionsMap ((freeModulesHomEquiv Z I M).symm s) (freeModulesSection Z j) =
      s j :=
  SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection s j

/-- The left-hand map `⊕_j 𝒪_Z ⟶ i^*Ω_{X/S}` of the conormal sequence of an immersion cut out
by the sections `f j`: the `j`-th generator goes to the pullback of `d (f j)`. -/
def equationDifferentialsMap (i : Z ⟶ X) (p : X ⟶ S) {I : Type u} (f : I → Γ(X, ⊤)) :
    freeModules Z I ⟶
      (Scheme.Modules.pullback i).obj (Scheme.Hom.relativeDifferentials p) :=
  (freeModulesHomEquiv Z I _).symm fun j => pulledBackDifferential i p (f j)

/-- The left-hand map composed with the canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` is zero. -/
theorem equationDifferentialsMap_comp (i : Z ⟶ X) (p : X ⟶ S)
    (hcomm : i ≫ p = (i ≫ p) ≫ 𝟙 S) {I : Type u} {f : I → Γ(X, ⊤)} (hf : IsCutOutBy i f) :
    equationDifferentialsMap i p f ≫
        Scheme.Hom.relativeDifferentialsMap i p (i ≫ p) (𝟙 S) hcomm = 0 := by
  refine (freeModulesHomEquiv Z I _).injective (funext fun j => ?_)
  have hκ : freeModulesHomEquiv Z I _ (equationDifferentialsMap i p f) j =
      pulledBackDifferential i p (f j) :=
    congrFun ((freeModulesHomEquiv Z I _).apply_symm_apply _) j
  rw [freeModulesHomEquiv_comp, hκ]
  refine PresheafOfModules.sections_ext _ _ fun V => ?_
  have hd : (Scheme.Hom.universalRelativeDerivation (i ≫ p)).d
      (0 : Γ(Z, i ⁻¹ᵁ (⊤ : X.Opens))) = 0 := map_zero _
  refine Eq.trans (PresheafOfModules.naturality_apply
    (Scheme.Hom.relativeDifferentialsMap i p (i ≫ p) (𝟙 S) hcomm).val
    (homOfLE (le_preimage_top i V.unop)).op _) ?_
  rw [relativeDifferentialsMap_app_unit_d i p hcomm ⊤ (f j), app_top_eq_zero i hf j, hd]
  exact map_zero _

/-- **The conormal sequence of an immersion cut out by equations**, with its conormal module
presented by the free module on the equations:
`⊕_j 𝒪_Z ⟶ i^*Ω_{X/S} ⟶ Ω_{Z/S}`, the first map sending the `j`-th generator to the pullback
of `d (f j)` and the second being the canonical map of [Stacks, Tag 01UV]. -/
def equationDifferentialsComplex (i : Z ⟶ X) (p : X ⟶ S) (hcomm : i ≫ p = (i ≫ p) ≫ 𝟙 S)
    {I : Type u} (f : I → Γ(X, ⊤)) (hf : IsCutOutBy i f) : ShortComplex Z.Modules :=
  ShortComplex.mk (equationDifferentialsMap i p f)
    (Scheme.Hom.relativeDifferentialsMap i p (i ≫ p) (𝟙 S) hcomm)
    (equationDifferentialsMap_comp i p hcomm hf)

/-- **The kernel of the canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` is generated by the pulled-back
differentials `d (f j)`** whenever `i : Z ⟶ X` is surjective on stalks and is cut out by the
global sections `f j` of `𝒪_X`. -/
theorem equationDifferentialsComplex_exact (i : Z ⟶ X) [SurjectiveOnStalks i] (p : X ⟶ S)
    (hcomm : i ≫ p = (i ≫ p) ≫ 𝟙 S) {I : Type u} (f : I → Γ(X, ⊤)) (hf : IsCutOutBy i f) :
    (equationDifferentialsComplex i p hcomm f hf).Exact := by
  classical
  refine (AlgebraicGeometry.SheafOfModules.exact_iff_stalkFunctor_map_exact _).2 fun x => ?_
  refine (ShortComplex.moduleCat_exact_iff _).2 fun ω hω => ?_
  let ΩXS : X.Modules := Scheme.Hom.relativeDifferentials p
  let ΩZS : Z.Modules := Scheme.Hom.relativeDifferentials (i ≫ p)
  let c := Scheme.Hom.relativeDifferentialsMap i p (i ≫ p) (𝟙 S) hcomm
  let κ := equationDifferentialsMap i p f
  let P' : _root_.PresheafOfModules (Z.sheaf.presheaf ⋙ forget₂ CommRingCat RingCat) :=
    ((Scheme.Modules.pullback i).obj ΩXS).val
  let K' : _root_.PresheafOfModules (Z.sheaf.presheaf ⋙ forget₂ CommRingCat RingCat) :=
    (freeModules Z I).val
  let R : Type u := ToType (S.presheaf.stalk (p.base (i.base x)))
  let A : Type u := ToType (X.sheaf.presheaf.stalk (i.base x))
  let C : Type u := ToType (Z.sheaf.presheaf.stalk x)
  let : Algebra R A := algebraStalkMap p (i.base x)
  let : Algebra A C := (i.stalkMap x).hom.toAlgebra
  let : Algebra R C := algebraStalkMap (i ≫ p) x
  have htower : IsScalarTower R A C := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    exact congrArg CommRingCat.Hom.hom (Scheme.Hom.stalkMap_comp i p x)
  let M : Type u :=
    ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) ΩXS.val.presheaf (i.base x))
  let P : Type u := ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) P'.presheaf x)
  let N : Type u := ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) ΩZS.val.presheaf x)
  let PK : Type u := ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) K'.presheaf x)
  let eA : M ≃ₗ[A] Ω[A⁄R] := relativeDifferentialsStalkKaehlerEquiv p (i.base x)
  let eC : N ≃ₗ[C] Ω[C⁄R] := relativeDifferentialsStalkKaehlerEquiv (i ≫ p) x
  obtain ⟨ePull, hPullGerm⟩ :=
    RingedSpaceModuleAdjunction.exists_modulePullbackStalkLinearEquiv i.toLRSHom.toShHom ΩXS x
  let ePull' : P ≃ₗ[C] C ⊗[A] M := ePull
  let stalkC : P →ₗ[C] N :=
    Stacks.Sheafify.ModuleStalkTensor.stalkLinearMapOfHom Z.sheaf.presheaf x c.val
  let stalkK : PK →ₗ[C] P :=
    Stacks.Sheafify.ModuleStalkTensor.stalkLinearMapOfHom Z.sheaf.presheaf x κ.val
  let eT : C ⊗[A] M ≃ₗ[C] C ⊗[A] Ω[A⁄R] :=
    TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl C C) eA
  let E : C ⊗[A] Ω[A⁄R] →ₗ[C] Ω[C⁄R] := KaehlerDifferential.mapBaseChange R A C
  have hcongrT : ∀ (b : C) (z : M), eT (b ⊗ₜ[A] z) = b ⊗ₜ[A] eA z := fun _ _ => rfl
  have hE : ∀ a : A, E ((1 : C) ⊗ₜ[A] KaehlerDifferential.D R A a) =
      KaehlerDifferential.D R C (algebraMap A C a) := fun a => by
    have hEdef : E = KaehlerDifferential.mapBaseChange R A C := rfl
    rw [hEdef, KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D, one_smul]
  have hb (L : Type u) [AddCommGroup L] [Module A L] (b : C) (z : L) :
      b ⊗ₜ[A] z = b • ((1 : C) ⊗ₜ[A] z) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have hgen : ∀ (b : C) (a : A),
      E (eT (b ⊗ₜ[A] eA.symm (KaehlerDifferential.D R A a)))
        = eC (stalkC (ePull'.symm (b ⊗ₜ[A] eA.symm (KaehlerDifferential.D R A a)))) := by
    intro b a
    obtain ⟨U, hxU, v, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.sheaf.presheaf a
    set dX := (Scheme.Hom.universalRelativeDerivation p).d v with hdX
    set mX := TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) ΩXS.val.presheaf U (i.base x) hxU dX
      with hmX
    set dW := (Scheme.Hom.universalRelativeDerivation (i ≫ p)).d ((i.app U).hom v) with hdW
    set mW := TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) ΩZS.val.presheaf (i ⁻¹ᵁ U) x hxU dW
      with hmW
    have heA : eA mX = KaehlerDifferential.D R A (X.sheaf.presheaf.germ U (i.base x) hxU v) :=
      relativeDifferentialsStalkKaehlerEquiv_germ_d p (i.base x) (OrderDual.toDual ⟨U, hxU⟩) v
    have heC : eC mW = KaehlerDifferential.D R C
        (Z.sheaf.presheaf.germ (i ⁻¹ᵁ U) x hxU ((i.app U).hom v)) :=
      relativeDifferentialsStalkKaehlerEquiv_germ_d (i ≫ p) x
        (OrderDual.toDual ⟨i ⁻¹ᵁ U, hxU⟩) ((i.app U).hom v)
    have hunit : ePull'.symm ((1 : C) ⊗ₜ[A] mX) =
        TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) P'.presheaf (i ⁻¹ᵁ U) x hxU
          (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app ΩXS).val.app (op U)
            dX) := by
      refine ePull'.injective ?_
      rw [LinearEquiv.apply_symm_apply]
      exact (hPullGerm U hxU dX).symm
    have hd : ((Scheme.Modules.pushforward i).map c).val.app (op U)
        (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app ΩXS).val.app (op U) dX)
          = dW := by
      exact relativeDifferentialsMap_app_unit_d i p hcomm U v
    have hstalkC : stalkC (ePull'.symm ((1 : C) ⊗ₜ[A] mX)) = mW := by
      rw [hunit]
      refine Eq.trans (TopCat.Presheaf.stalkFunctor_map_germ_apply (i ⁻¹ᵁ U) x hxU
        ((PresheafOfModules.toPresheaf Z.ringCatSheaf.obj).map c.val) _) ?_
      exact congrArg (TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) ΩZS.val.presheaf
        (i ⁻¹ᵁ U) x hxU) hd
    have hgerm : (algebraMap A C) (X.sheaf.presheaf.germ U (i.base x) hxU v) =
        Z.sheaf.presheaf.germ (i ⁻¹ᵁ U) x hxU ((i.app U).hom v) :=
      DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (i.germ_stalkMap U x hxU)) v
    rw [← heA, LinearEquiv.symm_apply_apply, hcongrT, heA, hb, map_smul, hE, hgerm, hb, map_smul,
      map_smul, hstalkC, map_smul, heC]
  have hspan : ∀ (w : Ω[A⁄R]) (b : C),
      E (eT (b ⊗ₜ[A] eA.symm w)) = eC (stalkC (ePull'.symm (b ⊗ₜ[A] eA.symm w))) := by
    intro w
    have hw : w ∈ Submodule.span A (Set.range (KaehlerDifferential.D R A)) := by
      rw [KaehlerDifferential.span_range_derivation]
      exact Submodule.mem_top
    induction hw using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨a, rfl⟩ := hy
      exact fun b => hgen b a
    | zero => intro b; simp
    | add y z _ _ ihy ihz =>
      intro b
      simp only [map_add, TensorProduct.tmul_add, ihy b, ihz b]
    | smul a y _ ihy =>
      intro b
      rw [map_smul, ← TensorProduct.smul_tmul]
      exact ihy (a • b)
  have hBridge : ∀ w : C ⊗[A] M, E (eT w) = eC (stalkC (ePull'.symm w)) := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul b m =>
      have h := hspan (eA m) b
      rwa [LinearEquiv.symm_apply_apply] at h
    | add w₁ w₂ h₁ h₂ => simp only [map_add, h₁, h₂]
  let gf : I → A := fun j => X.sheaf.presheaf.germ ⊤ (i.base x) trivial (f j)
  let gen : I → P := fun j => TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) P'.presheaf
    (i ⁻¹ᵁ (⊤ : X.Opens)) x trivial
    (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app ΩXS).val.app (op ⊤)
      ((Scheme.Hom.universalRelativeDerivation p).d (f j)))
  let genK : I → PK := fun j => TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) K'.presheaf
    (i ⁻¹ᵁ (⊤ : X.Opens)) x trivial
    ((freeModulesSection Z j).eval (op (i ⁻¹ᵁ (⊤ : X.Opens))))
  have hstalkK : ∀ j, stalkK (genK j) = gen j := by
    intro j
    refine Eq.trans (TopCat.Presheaf.stalkFunctor_map_germ_apply (i ⁻¹ᵁ (⊤ : X.Opens)) x trivial
      ((PresheafOfModules.toPresheaf Z.ringCatSheaf.obj).map κ.val) _) ?_
    refine congrArg (TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) P'.presheaf
      (i ⁻¹ᵁ (⊤ : X.Opens)) x trivial) ?_
    refine Eq.trans (congrArg
      (fun t => PresheafOfModules.sections.eval t (op (i ⁻¹ᵁ (⊤ : X.Opens))))
      (sectionsMap_freeModulesSection Z (fun j => pulledBackDifferential i p (f j)) j)) ?_
    exact sectionOfGlobal_eval _ _ _
  have hgenKer : ∀ j, eT (ePull' (gen j)) = (1 : C) ⊗ₜ[A] KaehlerDifferential.D R A (gf j) := by
    intro j
    have h := hPullGerm ⊤ trivial ((Scheme.Hom.universalRelativeDerivation p).d (f j))
    rw [show ePull' (gen j) = (1 : C) ⊗ₜ[A]
      TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) ΩXS.val.presheaf ⊤ (i.base x) trivial
        ((Scheme.Hom.universalRelativeDerivation p).d (f j)) from h, hcongrT]
    exact congrArg (fun z => (1 : C) ⊗ₜ[A] z)
      (relativeDifferentialsStalkKaehlerEquiv_germ_d p (i.base x)
        (OrderDual.toDual ⟨⊤, trivial⟩) (f j))
  have hsurj : Function.Surjective (algebraMap A C) := i.stalkMap_surjective x
  have hkerEq : RingHom.ker (algebraMap A C) = Ideal.span (Set.range gf) := hf x
  have hTmem : ∀ y : A, y ∈ RingHom.ker (algebraMap A C) →
      (1 : C) ⊗ₜ[A] KaehlerDifferential.D R A y ∈
        Submodule.span C (Set.range fun j => (1 : C) ⊗ₜ[A] KaehlerDifferential.D R A (gf j)) := by
    have e1 : ∀ (s : A) (w : Ω[A⁄R]), (1 : C) ⊗ₜ[A] (s • w) =
        (algebraMap A C s) • ((1 : C) ⊗ₜ[A] w) := fun s w => by
      rw [← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one, hb]
    intro y hy
    rw [hkerEq] at hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨j, rfl⟩ := hz
      exact Submodule.subset_span ⟨j, rfl⟩
    | zero => simp
    | add z w _ _ ihz ihw =>
      rw [map_add, TensorProduct.tmul_add]
      exact Submodule.add_mem _ ihz ihw
    | smul r z hz ihz =>
      have hz0 : algebraMap A C z = 0 := RingHom.mem_ker.1 (by rw [hkerEq]; exact hz)
      rw [smul_eq_mul, Derivation.leibniz, TensorProduct.tmul_add, e1, e1, hz0, zero_smul,
        add_zero]
      exact Submodule.smul_mem _ _ ihz
  have hkerspan : ∀ z : P, stalkC z = 0 → z ∈ Submodule.span C (Set.range gen) := by
    intro z hz
    have h1 : E (eT (ePull' z)) = 0 := by
      rw [hBridge, LinearEquiv.symm_apply_apply, hz, map_zero]
    have h2 : eT (ePull' z) ∈
        LinearMap.range (KaehlerDifferential.kerCotangentToTensor R A C) := by
      rwa [KaehlerDifferential.range_kerCotangentToTensor R A C hsurj]
    obtain ⟨ξ, hξ⟩ := h2
    obtain ⟨a, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker (algebraMap A C)) ξ
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hξ
    have h3 : eT (ePull' z) ∈
        Submodule.span C
          (Set.range fun j => (1 : C) ⊗ₜ[A] KaehlerDifferential.D R A (gf j)) :=
      hξ ▸ hTmem a.1 a.2
    let φ : P ≃ₗ[C] C ⊗[A] Ω[A⁄R] := ePull'.trans eT
    have hmapφ : Submodule.map (φ : P →ₗ[C] C ⊗[A] Ω[A⁄R])
        (Submodule.span C (Set.range gen)) =
          Submodule.span C
            (Set.range fun j => (1 : C) ⊗ₜ[A] KaehlerDifferential.D R A (gf j)) := by
      rw [Submodule.map_span, ← Set.range_comp]
      exact congrArg (Submodule.span C) (congrArg Set.range (funext hgenKer))
    have h4 : φ z ∈ Submodule.map (φ : P →ₗ[C] C ⊗[A] Ω[A⁄R])
        (Submodule.span C (Set.range gen)) := by
      rwa [hmapφ]
    obtain ⟨w, hw, hwz⟩ := h4
    exact (φ.injective hwz) ▸ hw
  have hωP : stalkC (ω : P) = 0 := hω
  obtain ⟨n, cc, gg, hsum⟩ := Submodule.mem_span_set'.1 (hkerspan ω hωP)
  choose jj hjj using fun k : Fin n => (gg k).2
  refine ⟨∑ k : Fin n, cc k • genK (jj k), ?_⟩
  refine Eq.trans (map_sum stalkK _ _) ?_
  refine Eq.trans (Finset.sum_congr rfl fun k _ => ?_) hsum
  rw [map_smul, hstalkK, hjj k]

/-- **[Stacks, Tag 01UZ], exactness at the middle term.** For an immersion `i : Z ⟶ X` of schemes
over `S` cut out by global sections `f j` of `𝒪_X`, the conormal sequence is exact at
`i^*Ω_{X/S}`: the kernel of the canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` of [Stacks, Tag 01UV] is
generated by the pulled-back differentials `d (f j)`, which generate the image of the conormal
module of the immersion. -/
@[stacks 01UZ "exactness at the middle term"]
theorem equationDifferentialsComplexOver_exact (i : Z ⟶ X) [IsImmersion i] (p : X ⟶ S)
    {I : Type u} (f : I → Γ(X, ⊤)) (hf : IsCutOutBy i f) :
    (equationDifferentialsComplex i p (by simp) f hf).Exact :=
  equationDifferentialsComplex_exact i p _ f hf

end Stacks.ConormalSequenceRight

