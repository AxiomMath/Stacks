public import Mathlib.Topology.Sheaves.SheafCondition.Sites

/-!
# Trivializing the ideal sheaf of a thickening cut out by a power of a nonzerodivisor

Let `Y` be a scheme, `g` a global section of `𝒪_Y`, and let `u : A ⟶ Y` and `v : B ⟶ Y` be
closed subschemes of `Y` cut out, on a basis of opens, by `g ^ m` and by the annihilator of
`g ^ m`. Multiplication by `g ^ m` then identifies the structure sheaf of `B` with the ideal
sheaf of `A`, as sheaves of `𝒪_Y`-modules.

For the tower of infinitesimal neighbourhoods `Z₀ ⟶ Z₁ ⟶ ⋯` of an immersion `i : Z ⟶ X` whose
defining ideal sheaf is generated by a nonzerodivisor `f`, the defining ideal sheaf of
`Zₙ ⊆ Zₙ₊₁` is `K ^ (n + 1) / K ^ (n + 2)`, and multiplication by `f ^ (n + 1)` identifies it
with the structure sheaf of `Z₀`.

## Main definitions

* `Stacks.Thickenings.globalPowSmul` is multiplication by a power of a global section of the
  structure sheaf, as an endomorphism of the structure sheaf viewed as a sheaf of modules.
* `Stacks.Thickenings.principalTrivializationHom` is the induced morphism from the pushforward
  of the structure sheaf of `B` to the ideal sheaf of `A`.
* `Stacks.Thickenings.principalTrivialization` is that morphism as an isomorphism, oriented so
  that its source is the ideal sheaf.
* `Stacks.Thickenings.nthOrderBottom` is the inclusion `Z₀ ⟶ Zₙ₊₁` of the bottom stage of the
  tower of infinitesimal neighbourhoods into a higher stage.

## Main results

* `Stacks.Thickenings.pow_mul_eq_zero_iff_mem_map_span`: for a surjection `φ` with kernel
  generated by `f ^ (m + 1)` and `f` a nonzerodivisor, a section is killed by `φ f ^ m` exactly
  when it is divisible by `φ f`.
* `Stacks.Thickenings.idealSheafIsoStructureSheafNthOrderBottom`: for an immersion whose defining
  ideal sheaf is generated by a nonzerodivisor `f`, the defining ideal sheaf of the stage
  `Zₙ ⟶ Zₙ₊₁` of the tower of infinitesimal neighbourhoods is isomorphic, as a sheaf of
  `𝒪_{Zₙ₊₁}`-modules, to the structure sheaf of the bottom stage `Z₀`, by multiplication by
  `f ^ (n + 1)`.

## References

* [Stacks Project, Tag 04EY](https://stacks.math.columbia.edu/tag/04EY)
* [Stacks Project, Tag 0F2D](https://stacks.math.columbia.edu/tag/0F2D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.Thickenings

attribute [local implicit_reducible]
  TopCat.Sheaf
  structureSheafRing
  SheafOfModules.toSheaf

/-- The sections of the structure sheaf of a scheme, read through `structureSheafRing`, form a
commutative ring. -/
local instance ringSheafIsMulCommutative {Y : Scheme.{u}} (U : (Opens Y.carrier)ᵒᵖ) :
    IsMulCommutative ((structureSheafRing Y.toSheafedSpace).obj.obj U) :=
  inferInstanceAs (IsMulCommutative (Y.presheaf.obj U))

/-! ### Multiplication by a power of a global section -/

/-- Multiplication by the `m`-th power of a global section `g`, as an endomorphism of the
structure sheaf viewed as a sheaf of modules over itself. -/
def globalPowSmul (Y : Scheme.{u}) (g : Γ(Y, ⊤)) (m : ℕ) :
    SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) ⟶
      SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) :=
  ((Stacks.SheafOfModules.terminalSectionToEnd
    (structureSheafRing Y.toSheafedSpace) ⊤ isTerminalTop g) ^ m).asHom.app
      (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace))

/-- The restriction of a global section of the structure sheaf of a scheme to an open. -/
abbrev globalRestrict (Y : Scheme.{u}) (g : Γ(Y, ⊤)) (O : Y.Opens) : Γ(Y, O) :=
  (Y.presheaf.map (homOfLE (le_top (a := O))).op).hom g

/-- On sections over an open, multiplication by the `m`-th power of a global section is
multiplication by the `m`-th power of its restriction. -/
theorem globalPowSmul_val_app (Y : Scheme.{u}) (g : Γ(Y, ⊤)) (m : ℕ) {O : Y.Opens}
    (h : O ⟶ ⊤) (x : Γ(Y, O)) :
    (globalPowSmul Y g m).val.app (op O) x = (Y.presheaf.map h.op).hom g ^ m * x := by
  obtain rfl : h = isTerminalTop.from O := isTerminalTop.hom_ext _ _
  exact Stacks.SheafOfModules.terminalSectionToEnd_pow_apply
    (structureSheafRing Y.toSheafedSpace) ⊤ isTerminalTop g
    (SheafOfModules.unit (structureSheafRing Y.toSheafedSpace)) m (op O) x

/-! ### The algebraic core -/

/-- Let `φ : R ⟶ S` be a surjective ring map whose kernel is generated by `f ^ (m + 1)` for a
nonzerodivisor `f`. Then a section of `S` is killed by `φ f ^ m` exactly when it lies in the
ideal generated by `φ f`. -/
theorem pow_mul_eq_zero_iff_mem_map_span {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (hφ : Function.Surjective φ) {f : R} (hf : f ∈ nonZeroDivisors R) {m : ℕ}
    (hker : RingHom.ker φ = Ideal.span {f ^ (m + 1)}) (x : S) :
    φ f ^ m * x = 0 ↔ x ∈ Ideal.map φ (Ideal.span {f}) := by
  obtain ⟨r, rfl⟩ := hφ x
  rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
  constructor
  · intro h
    obtain ⟨s, hs⟩ : f ^ (m + 1) ∣ f ^ m * r := by
      rwa [← Ideal.mem_span_singleton, ← hker, RingHom.mem_ker, map_mul, map_pow]
    refine ⟨φ s, ?_⟩
    rw [← map_mul, sub_eq_zero.1 ((mem_nonZeroDivisors_iff.1 (pow_mem hf m)).2
      (r - f * s) (by linear_combination hs))]
  · rintro ⟨y, hy⟩
    have : f ^ (m + 1) ∈ RingHom.ker φ := hker ▸ Ideal.mem_span_singleton_self _
    rw [hy, ← mul_assoc, ← pow_succ, ← map_pow, RingHom.mem_ker.1 this, zero_mul]

/-! ### Sections of the arrows in play -/

private theorem comp_val_app_apply {Y : Scheme.{u}}
    {M N P : SheafOfModules.{u} (structureSheafRing Y.toSheafedSpace)} (a : M ⟶ N) (b : N ⟶ P)
    (O : (Opens Y.carrier)ᵒᵖ) (x : M.val.obj O) :
    (a ≫ b).val.app O x = b.val.app O (a.val.app O x) :=
  rfl

/-- On sections over an open, the structure-sheaf map of a morphism of schemes read as a
morphism of sheaves of modules is the section map of the morphism. -/
theorem structureSheafModuleHom_val_app_apply {A Y : Scheme.{u}} (w : A ⟶ Y) (O : Y.Opens)
    (x : Γ(Y, O)) :
    (structureSheafModuleHom w.toLRSHom.toShHom).val.app (op O) x = (w.app O).hom x :=
  rfl

/-- Every section over an open of the pushforward of the structure sheaf along a morphism of
schemes whose section map there is surjective comes from a section of the structure sheaf of the
target. -/
theorem exists_structureSheafModuleHom_val_app {A Y : Scheme.{u}} (w : A ⟶ Y) (O : Y.Opens)
    (h : Function.Surjective ((w.app O).hom))
    (y : ((modulePushforward w.toLRSHom.toShHom).obj
      (SheafOfModules.unit (structureSheafRing A.toSheafedSpace))).val.obj (op O)) :
    ∃ x : Γ(Y, O), (structureSheafModuleHom w.toLRSHom.toShHom).val.app (op O) x = y :=
  h y

/-- The sections of the ideal sheaf of a morphism of schemes over an open are killed by the
section map of that morphism. -/
theorem mem_ker_idealSheafι_val_app {A Y : Scheme.{u}} (w : A ⟶ Y) (O : Y.Opens)
    (y : (Stacks.ClosedImmersion.idealSheaf w.toLRSHom.toShHom).val.obj (op O)) (s : Γ(Y, O))
    (hs : (Stacks.ClosedImmersion.idealSheafι w.toLRSHom.toShHom).val.app (op O) y = s) :
    s ∈ RingHom.ker ((w.app O).hom) := by
  rw [← Stacks.ClosedImmersion.range_idealSheafι_val_app w O]
  exact ⟨y, hs⟩

/-- `𝒪_Y ⟶ v_* 𝒪_B` is an epimorphism of sheaves of `𝒪_Y`-modules for a closed immersion
`v : B ⟶ Y` of schemes. -/
instance epi_structureSheafModuleHom {B Y : Scheme.{u}} (v : B ⟶ Y) [IsClosedImmersion v] :
    Epi (structureSheafModuleHom v.toLRSHom.toShHom) :=
  Stacks.AlgebraicGeometry.ClosedImmersionTFAE.epi_unitToPushforwardObjUnit_of_isClosedImmersion v

/-- The inclusion of the ideal sheaf of a morphism of schemes into the structure sheaf is a
monomorphism. -/
instance mono_idealSheafι {A Y : Scheme.{u}} (w : A ⟶ Y) :
    Mono (Stacks.ClosedImmersion.idealSheafι w.toLRSHom.toShHom) :=
  inferInstanceAs (Mono (kernel.ι (structureSheafModuleHom w.toLRSHom.toShHom)))

/-- Two morphisms of sheaves of `𝒪_Y`-modules agreeing on sections over a basis of opens are
equal. -/
private theorem hom_ext_of_isBasis {Y : Scheme.{u}} {ιb : Type*} {Bs : ιb → Y.Opens}
    (hB : Opens.IsBasis (Set.range Bs))
    {M N : SheafOfModules.{u} (structureSheafRing Y.toSheafedSpace)} {p q : M ⟶ N}
    (h : ∀ j x, p.val.app (op (Bs j)) x = q.val.app (op (Bs j)) x) : p = q := by
  refine SheafOfModules.hom_ext ((PresheafOfModules.toPresheaf _).map_injective ?_)
  refine TopCat.Sheaf.hom_ext (B := Bs) _
    (show TopCat.Sheaf AddCommGrpCat.{u} Y.carrier from ⟨N.val.presheaf, N.isSheaf⟩) hB fun j => ?_
  ext x
  exact h j x

/-- Multiplication by `g ^ m` on sections over an open is killed by the section map of a
morphism whose kernel there contains `g ^ m`. -/
theorem app_globalPowSmul_val_app {A Y : Scheme.{u}} (w : A ⟶ Y) (g : Γ(Y, ⊤)) (m : ℕ)
    (O : Y.Opens) (hw : globalRestrict Y g O ^ m ∈ RingHom.ker ((w.app O).hom))
    (x : Γ(Y, O)) :
    (w.app O).hom ((globalPowSmul Y g m).val.app (op O) x) = 0 := by
  rw [globalPowSmul_val_app Y g m (homOfLE le_top) x, map_mul, RingHom.mem_ker.1 hw, zero_mul]

/-- Multiplication by `g ^ m` kills the sections of the ideal sheaf of a morphism whose kernel
on sections is the annihilator of `g ^ m`. -/
theorem globalPowSmul_val_app_idealSheafι {B Y : Scheme.{u}} (v : B ⟶ Y) (g : Γ(Y, ⊤)) (m : ℕ)
    (O : Y.Opens)
    (hv : ∀ x : Γ(Y, O), globalRestrict Y g O ^ m * x = 0 ↔ x ∈ RingHom.ker ((v.app O).hom))
    (y : (Stacks.ClosedImmersion.idealSheaf v.toLRSHom.toShHom).val.obj (op O)) :
    (globalPowSmul Y g m).val.app (op O)
      ((Stacks.ClosedImmersion.idealSheafι v.toLRSHom.toShHom).val.app (op O) y) = 0 := by
  refine Eq.trans (globalPowSmul_val_app Y g m (homOfLE le_top) _) ?_
  exact (hv _).2 (mem_ker_idealSheafι_val_app v O y _ rfl)

/-! ### The trivialization -/

section Trivialization

variable {Y A B : Scheme.{u}} (u : A ⟶ Y) (v : B ⟶ Y) (g : Γ(Y, ⊤)) (m : ℕ)
  {ιb : Type*} {Bs : ιb → Y.Opens}

/-- Multiplication by `g ^ m` lands in the ideal sheaf of `u` as soon as `g ^ m` lies in the
kernel of the section maps of `u` over a basis of opens. -/
theorem globalPowSmul_comp_structureSheafModuleHom
    (hB : Opens.IsBasis (Set.range Bs))
    (hu : ∀ j, globalRestrict Y g (Bs j) ^ m ∈ RingHom.ker ((u.app (Bs j)).hom)) :
    globalPowSmul Y g m ≫ structureSheafModuleHom u.toLRSHom.toShHom = 0 := by
  refine hom_ext_of_isBasis hB fun j x => ?_
  exact app_globalPowSmul_val_app u g m (Bs j) (hu j) x

/-- Multiplication by `g ^ m`, as a morphism from the structure sheaf to the ideal sheaf of
`u`. -/
def powSmulLift (hB : Opens.IsBasis (Set.range Bs))
    (hu : ∀ j, globalRestrict Y g (Bs j) ^ m ∈ RingHom.ker ((u.app (Bs j)).hom)) :
    SheafOfModules.unit (structureSheafRing Y.toSheafedSpace) ⟶
      Stacks.ClosedImmersion.idealSheaf u.toLRSHom.toShHom :=
  kernel.lift _ (globalPowSmul Y g m) (globalPowSmul_comp_structureSheafModuleHom u g m hB hu)

/-- `powSmulLift` followed by the inclusion of the ideal sheaf of `u` is multiplication by
`g ^ m`. -/
theorem powSmulLift_idealSheafι (hB : Opens.IsBasis (Set.range Bs))
    (hu : ∀ j, globalRestrict Y g (Bs j) ^ m ∈ RingHom.ker ((u.app (Bs j)).hom)) :
    powSmulLift u g m hB hu ≫ Stacks.ClosedImmersion.idealSheafι u.toLRSHom.toShHom =
      globalPowSmul Y g m :=
  kernel.lift_ι _ _ _

/-- The ideal sheaf of `v` is killed by multiplication by `g ^ m` as soon as the sections of the
structure sheaf killed by `g ^ m` over a basis of opens are those vanishing on `B`. -/
theorem idealSheafι_comp_globalPowSmul
    (hB : Opens.IsBasis (Set.range Bs))
    (hv : ∀ j, ∀ x : Γ(Y, Bs j),
      globalRestrict Y g (Bs j) ^ m * x = 0 ↔ x ∈ RingHom.ker ((v.app (Bs j)).hom)) :
    Stacks.ClosedImmersion.idealSheafι v.toLRSHom.toShHom ≫ globalPowSmul Y g m = 0 := by
  refine hom_ext_of_isBasis hB fun j y => ?_
  exact globalPowSmul_val_app_idealSheafι v g m (Bs j) (hv j) y

/-- Multiplication by `g ^ m` kills the ideal sheaf of `v`, read as a morphism into the ideal
sheaf of `u`. -/
theorem idealSheafι_comp_powSmulLift
    (hB : Opens.IsBasis (Set.range Bs))
    (hu : ∀ j, globalRestrict Y g (Bs j) ^ m ∈ RingHom.ker ((u.app (Bs j)).hom))
    (hv : ∀ j, ∀ x : Γ(Y, Bs j),
      globalRestrict Y g (Bs j) ^ m * x = 0 ↔ x ∈ RingHom.ker ((v.app (Bs j)).hom)) :
    kernel.ι (structureSheafModuleHom v.toLRSHom.toShHom) ≫ powSmulLift u g m hB hu = 0 := by
  rw [← cancel_mono (Stacks.ClosedImmersion.idealSheafι u.toLRSHom.toShHom), zero_comp,
    Category.assoc, powSmulLift_idealSheafι]
  exact idealSheafι_comp_globalPowSmul v g m hB hv

variable [IsClosedImmersion v]
  (hB : Opens.IsBasis (Set.range Bs))
  (hu : ∀ j, RingHom.ker ((u.app (Bs j)).hom) = Ideal.span {globalRestrict Y g (Bs j) ^ m})
  (hv : ∀ j, ∀ x : Γ(Y, Bs j),
    globalRestrict Y g (Bs j) ^ m * x = 0 ↔ x ∈ RingHom.ker ((v.app (Bs j)).hom))

/-- Multiplication by `g ^ m`, as a morphism from the pushforward of the structure sheaf of `B`
to the ideal sheaf of `u`. -/
def principalTrivializationHom :
    (modulePushforward v.toLRSHom.toShHom).obj
        (SheafOfModules.unit (structureSheafRing B.toSheafedSpace)) ⟶
      Stacks.ClosedImmersion.idealSheaf u.toLRSHom.toShHom :=
  Abelian.epiDesc (structureSheafModuleHom v.toLRSHom.toShHom)
    (powSmulLift u g m hB fun j => (hu j).ge (Ideal.mem_span_singleton_self _))
    (idealSheafι_comp_powSmulLift u v g m hB
      (fun j => (hu j).ge (Ideal.mem_span_singleton_self _)) hv)

/-- `principalTrivializationHom` precomposed with `𝒪_Y ⟶ v_* 𝒪_B` is multiplication by
`g ^ m` into the ideal sheaf of `u`. -/
theorem structureSheafModuleHom_comp_principalTrivializationHom :
    structureSheafModuleHom v.toLRSHom.toShHom ≫ principalTrivializationHom u v g m hB hu hv =
      powSmulLift u g m hB fun j => (hu j).ge (Ideal.mem_span_singleton_self _) :=
  Abelian.comp_epiDesc _ _ _

include hB hu hv in
/-- On sections, the trivialization carries the restriction to `B` of a section `x` of `𝒪_Y` to
the section `g ^ m * x` of the ideal sheaf of `u`. -/
theorem idealSheafι_principalTrivializationHom_val_app (O : Y.Opens) (x : Γ(Y, O)) :
    ((Stacks.ClosedImmersion.idealSheafι u.toLRSHom.toShHom).val.app (op O)
        ((principalTrivializationHom u v g m hB hu hv).val.app (op O)
          ((structureSheafModuleHom v.toLRSHom.toShHom).val.app (op O) x)) : Γ(Y, O)) =
      globalRestrict Y g O ^ m * x := by
  have key : structureSheafModuleHom v.toLRSHom.toShHom ≫
      principalTrivializationHom u v g m hB hu hv ≫
        Stacks.ClosedImmersion.idealSheafι u.toLRSHom.toShHom = globalPowSmul Y g m := by
    rw [← Category.assoc, structureSheafModuleHom_comp_principalTrivializationHom,
      powSmulLift_idealSheafι]
  exact (congrArg (fun a => a.val.app (op O) x) key).trans
    (globalPowSmul_val_app Y g m (homOfLE le_top) x)

include hB hu hv in
/-- The trivialization is injective on sections over a basis open. -/
theorem injective_principalTrivializationHom_val_app
    (hsurj : ∀ j, Function.Surjective ((v.app (Bs j)).hom)) (j : ιb) :
    Function.Injective
      ((principalTrivializationHom u v g m hB hu hv).val.app (op (Bs j))) := by
  intro y y' hyy'
  obtain ⟨x, rfl⟩ := exists_structureSheafModuleHom_val_app v (Bs j) (hsurj j) y
  obtain ⟨x', rfl⟩ := exists_structureSheafModuleHom_val_app v (Bs j) (hsurj j) y'
  have hxx' : globalRestrict Y g (Bs j) ^ m * x = globalRestrict Y g (Bs j) ^ m * x' := by
    rw [← idealSheafι_principalTrivializationHom_val_app u v g m hB hu hv (Bs j) x,
      ← idealSheafι_principalTrivializationHom_val_app u v g m hB hu hv (Bs j) x', hyy']
  have hker := RingHom.mem_ker.1 ((hv j (x - x')).1 (by rw [mul_sub, hxx', sub_self]))
  rwa [map_sub, sub_eq_zero] at hker

include hB hu hv in
/-- The trivialization is surjective on sections over a basis open: a section of the ideal sheaf
of `u` is divisible by `g ^ m` there. -/
theorem surjective_principalTrivializationHom_val_app (j : ιb) :
    Function.Surjective
      ((principalTrivializationHom u v g m hB hu hv).val.app (op (Bs j))) := by
  intro z
  obtain ⟨s, hs⟩ : ∃ s : Γ(Y, Bs j),
      (Stacks.ClosedImmersion.idealSheafι u.toLRSHom.toShHom).val.app (op (Bs j)) z = s :=
    ⟨_, rfl⟩
  obtain ⟨x, hx⟩ :=
    Ideal.mem_span_singleton.1 ((hu j).le (mem_ker_idealSheafι_val_app u (Bs j) z s hs))
  exact ⟨(structureSheafModuleHom v.toLRSHom.toShHom).val.app (op (Bs j)) x,
    Stacks.ClosedImmersion.injective_idealSheafι_val_app u.toLRSHom.toShHom (Bs j)
      ((idealSheafι_principalTrivializationHom_val_app u v g m hB hu hv (Bs j) x).trans
        (hx.symm.trans hs.symm))⟩

include hB hu hv in
/-- The trivialization is a monomorphism. -/
theorem mono_principalTrivializationHom
    (hsurj : ∀ j, Function.Surjective ((v.app (Bs j)).hom)) :
    Mono (principalTrivializationHom u v g m hB hu hv) := by
  refine ⟨fun p q hpq => ?_⟩
  refine hom_ext_of_isBasis hB fun j y => ?_
  exact injective_principalTrivializationHom_val_app u v g m hB hu hv hsurj j
    (congrArg (fun a => a.val.app (op (Bs j)) y) hpq)

include hB hu hv in
/-- The trivialization is an epimorphism. -/
theorem epi_principalTrivializationHom :
    Epi (principalTrivializationHom u v g m hB hu hv) := by
  refine ⟨fun {N} p q hpq => ?_⟩
  refine hom_ext_of_isBasis hB fun j z => ?_
  obtain ⟨y, rfl⟩ := surjective_principalTrivializationHom_val_app u v g m hB hu hv j z
  exact congrArg (fun a => a.val.app (op (Bs j)) y) hpq

include hB hu hv in
/-- The ideal sheaf of `u` is isomorphic, as a sheaf of `𝒪_Y`-modules, to the pushforward of the
structure sheaf of `B`, by multiplication by `g ^ m`. -/
def principalTrivialization
    (hsurj : ∀ j, Function.Surjective ((v.app (Bs j)).hom)) :
    Stacks.ClosedImmersion.idealSheaf u.toLRSHom.toShHom ≅
      (modulePushforward v.toLRSHom.toShHom).obj
        (SheafOfModules.unit (structureSheafRing B.toSheafedSpace)) :=
  letI := mono_principalTrivializationHom u v g m hB hu hv hsurj
  letI := epi_principalTrivializationHom u v g m hB hu hv
  letI := isIso_of_mono_of_epi (principalTrivializationHom u v g m hB hu hv)
  (asIso (principalTrivializationHom u v g m hB hu hv)).symm

end Trivialization

/-! ### Restriction of a global section along a morphism -/

/-- The section map of a morphism of schemes over an open carries the restriction of a global
section to the restriction of its image under the map on global sections. -/
theorem app_globalRestrict {A Y : Scheme.{u}} (w : A ⟶ Y) (g : Γ(Y, ⊤)) (O : Y.Opens) :
    (w.app O).hom (globalRestrict Y g O) =
      globalRestrict A (w.appTop.hom g) (w ⁻¹ᵁ O) := by
  have h1 : w.appLE ⊤ ⊤ (by simp) = w.appTop := by
    simpa [Scheme.Hom.appTop] using Scheme.Hom.appLE_eq_app (f := w) (U := (⊤ : Y.Opens))
  have h2 : w.appLE O (w ⁻¹ᵁ O) le_rfl = w.app O :=
    Scheme.Hom.appLE_eq_app (f := w) (U := O)
  have e1 := Scheme.Hom.appLE_map w (U := (⊤ : Y.Opens)) (V := (⊤ : A.Opens))
    (by simp) (homOfLE (le_top (a := w ⁻¹ᵁ O))).op
  have e2 := Scheme.Hom.map_appLE w (U := O) (V := w ⁻¹ᵁ O) le_rfl
    (homOfLE (le_top (a := O))).op
  rw [h1] at e1
  rw [h2] at e2
  have h := congrArg (fun t : Γ(Y, ⊤) ⟶ Γ(A, w ⁻¹ᵁ O) => t.hom g) (e2.trans e1.symm)
  simpa only [CommRingCat.hom_comp, CommRingCat.comp_apply, RingHom.comp_apply] using h

/-! ### The tower of infinitesimal neighbourhoods of an immersion -/

section Tower

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]

/-- The inclusion of the bottom stage `Z₀` of the tower of infinitesimal neighbourhoods of an
immersion into the stage `Zₙ₊₁`: the inclusion of closed subschemes attached to the containment
`K ^ (n + 2) ≤ K`. -/
def nthOrderBottom (n : ℕ) :
    nthOrderInfinitesimalNeighbourhood i 0 ⟶ nthOrderInfinitesimalNeighbourhood i (n + 1) :=
  Scheme.IdealSheafData.inclusion
    (idealSheaf_pow_le_pow_right (I := i.liftCoborder.ker)
      (show 0 + 1 ≤ n + 1 + 1 by omega))

/-- `nthOrderBottom` is the inclusion of closed subschemes attached to
`K ^ (n + 2) ≤ K`. -/
theorem nthOrderBottom_eq (n : ℕ) :
    nthOrderBottom i n = Scheme.IdealSheafData.inclusion
      (idealSheaf_pow_le_pow_right (I := i.liftCoborder.ker)
        (show 0 + 1 ≤ n + 1 + 1 by omega)) :=
  rfl

/-- The inclusion of the bottom stage of the tower into a higher stage is a closed
immersion. -/
instance isClosedImmersion_nthOrderBottom (n : ℕ) :
    IsClosedImmersion (nthOrderBottom i n) := by
  rw [nthOrderBottom_eq]
  infer_instance

/-- The defining ideal sheaf of `Z₀ ⊆ Zₙ₊₁` is `K / K ^ (n + 2)`: on the chart of `Zₙ₊₁` over an
affine open `V` of the ambient open subscheme it is the image of `K(V)`. -/
theorem ker_app_nthOrderBottom (n : ℕ) (V : i.coborderRange.toScheme.affineOpens) :
    RingHom.ker ((nthOrderBottom i n).app (nthOrderι i (n + 1) ⁻¹ᵁ V.1)).hom =
      Ideal.map ((nthOrderι i (n + 1)).app V.1).hom (i.liftCoborder.ker.ideal V) := by
  refine (Scheme.Hom.ker_apply (nthOrderBottom i n)
    ⟨nthOrderι i (n + 1) ⁻¹ᵁ V.1, V.2.preimage _⟩).symm.trans ?_
  rw [nthOrderBottom_eq, Stacks.ClosedImmersion.ker_inclusion_ideal]
  refine congrArg (Ideal.map ((nthOrderι i (n + 1)).app V.1).hom) ?_
  rw [Scheme.IdealSheafData.ideal_pow]
  simp

/-- The charts of an infinitesimal neighbourhood over the affine opens of the ambient open
subscheme form a basis of its topology. -/
theorem isBasis_nthOrderChart (n : ℕ) :
    Opens.IsBasis
      (Set.range fun V : i.coborderRange.toScheme.affineOpens => nthOrderι i n ⁻¹ᵁ V.1) := by
  rw [Opens.isBasis_iff_nbhd]
  intro U x hx
  obtain ⟨t, ht, hteq⟩ :=
    (Scheme.Hom.isClosedEmbedding (nthOrderι i n)).isInducing.isOpen_iff.1 U.2
  have hxt : (nthOrderι i n).base x ∈ (⟨t, ht⟩ : i.coborderRange.toScheme.Opens) := by
    show x ∈ (nthOrderι i n).base ⁻¹' t
    rwa [hteq]
  obtain ⟨V, hV, hxV, hVt⟩ :=
    Opens.isBasis_iff_nbhd.1 i.coborderRange.toScheme.isBasis_affineOpens hxt
  refine ⟨nthOrderι i n ⁻¹ᵁ V, ⟨⟨V, hV⟩, rfl⟩, hxV, fun y hy => ?_⟩
  have h2 : y ∈ (nthOrderι i n).base ⁻¹' t := hVt hy
  rwa [hteq] at h2

variable (n : ℕ) (f : Γ(i.coborderRange.toScheme, ⊤))
  (hK : ∀ V : i.coborderRange.toScheme.affineOpens,
    i.liftCoborder.ker.ideal V = Ideal.span {globalRestrict i.coborderRange.toScheme f V.1})
  (hf : ∀ V : i.coborderRange.toScheme.affineOpens,
    globalRestrict i.coborderRange.toScheme f V.1 ∈
      nonZeroDivisors Γ(i.coborderRange.toScheme, V.1))

include hK in
/-- If the defining ideal sheaf of the immersion is generated on charts by the restrictions of a
global section `f`, then the defining ideal sheaf of `Zₙ ⊆ Zₙ₊₁` is generated on the charts of
`Zₙ₊₁` by `f ^ (n + 1)`. -/
theorem ker_app_nthOrderSucc_eq_span (V : i.coborderRange.toScheme.affineOpens) :
    RingHom.ker ((nthOrderSucc i n).app (nthOrderι i (n + 1) ⁻¹ᵁ V.1)).hom =
      Ideal.span {(globalRestrict (nthOrderInfinitesimalNeighbourhood i (n + 1))
           ((nthOrderι i (n + 1)).appTop.hom f) (nthOrderι i (n + 1) ⁻¹ᵁ V.1) ^ (n + 1))} := by
  rw [ker_app_nthOrderSucc, hK V, Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton,
    map_pow, app_globalRestrict]

include hK hf in
/-- A section of `𝒪_{Zₙ₊₁}` over a chart is killed by `f ^ (n + 1)` exactly when it vanishes on
the bottom stage `Z₀`. -/
theorem pow_mul_eq_zero_iff_mem_ker_nthOrderBottom (V : i.coborderRange.toScheme.affineOpens)
    (x : Γ(nthOrderInfinitesimalNeighbourhood i (n + 1), nthOrderι i (n + 1) ⁻¹ᵁ V.1)) :
    globalRestrict (nthOrderInfinitesimalNeighbourhood i (n + 1))
          ((nthOrderι i (n + 1)).appTop.hom f) (nthOrderι i (n + 1) ⁻¹ᵁ V.1) ^ (n + 1) * x = 0 ↔
      x ∈ RingHom.ker ((nthOrderBottom i n).app (nthOrderι i (n + 1) ⁻¹ᵁ V.1)).hom := by
  rw [ker_app_nthOrderBottom, hK V, ← app_globalRestrict]
  exact pow_mul_eq_zero_iff_mem_map_span _
    ((i.liftCoborder.ker ^ (n + 1 + 1)).subschemeι_app_surjective V) (hf V)
    (by rw [ker_app_nthOrderι, hK V, Ideal.span_singleton_pow]) x

include hK hf in
/-- The defining ideal sheaf of a stage of the tower of infinitesimal neighbourhoods is the
structure sheaf of the bottom stage. Let `i : Z ⟶ X` be an immersion whose defining ideal sheaf
is generated on every affine chart of the ambient open subscheme by the restriction of a global
section `f`, and let `f` restrict to a nonzerodivisor on every such chart. Then multiplication by
`f ^ (n + 1)` is an isomorphism of sheaves of `𝒪_{Zₙ₊₁}`-modules from the defining ideal sheaf of
`Zₙ ⟶ Zₙ₊₁` onto the structure sheaf of `Z₀`. -/
def idealSheafIsoStructureSheafNthOrderBottom :
    idealModuleSheaf (nthOrderSucc i n) ≅
      (modulePushforward (nthOrderBottom i n).toLRSHom.toShHom).obj
        (SheafOfModules.unit
          (structureSheafRing (nthOrderInfinitesimalNeighbourhood i 0).toSheafedSpace)) :=
  principalTrivialization (nthOrderSucc i n) (nthOrderBottom i n)
    ((nthOrderι i (n + 1)).appTop.hom f) (n + 1)
    (isBasis_nthOrderChart i (n + 1))
    (ker_app_nthOrderSucc_eq_span i n f hK)
    (pow_mul_eq_zero_iff_mem_ker_nthOrderBottom i n f hK hf)
    fun V => Scheme.Hom.app_surjective (nthOrderBottom i n)
      (nthOrderι i (n + 1) ⁻¹ᵁ V.1) (V.2.preimage _)

end Tower

end Stacks.Thickenings

end
