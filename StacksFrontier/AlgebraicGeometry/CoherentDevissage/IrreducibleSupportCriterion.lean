/-- The inclusion of one submodule of `M` into a larger one. -/
private noncomputable def submoduleInclusion {X : Scheme.{u}} {M : X.Modules}
    {H K : M.Submodule} (h : H ≤ K) : H.toSheafOfModules ⟶ K.toSheafOfModules :=
  ⟨PresheafOfModules.Submodule.homOfLE (SheafOfModules.Submodule.le_iff.mp h)⟩

/-- The inclusion of submodules is compatible with the inclusions into the ambient module. -/
private lemma submoduleInclusion_comp {X : Scheme.{u}} {M : X.Modules}
    {H K : M.Submodule} (h : H ≤ K) : submoduleInclusion h ≫ K.ι = H.ι := rfl

/-- The inclusion of one submodule into a larger one is a monomorphism. -/
private lemma submoduleInclusion_mono {X : Scheme.{u}} {M : X.Modules}
    {H K : M.Submodule} (h : H ≤ K) : Mono (submoduleInclusion h) := by
  let : Mono H.ι := SheafOfModules.Submodule.instMonoι H
  let : Mono K.ι := SheafOfModules.Submodule.instMonoι K
  exact mono_of_mono_fac (submoduleInclusion_comp h)

