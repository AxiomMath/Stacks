/-- The stalk of `G` at `x` has length one over the local ring at `x`. For a stalk annihilated
by the maximal ideal this is the condition `dim_{κ(x)} G_x = 1` of the source. -/
private def stalkLengthOne {X : Scheme.{u}} (G : X.Modules) (x : X) : Prop :=
  letI : Module (X.presheaf.stalk x) (G.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) G.val x
  Module.length (X.presheaf.stalk x) (G.presheaf.stalk x) = 1

/-- The map induced by `f` on the stalks at `x`, as a linear map over the local ring at `x`. -/
private noncomputable def stalkLinearMap {X : Scheme.{u}} {F G : X.Modules}
    (f : F ⟶ G) (x : X) :
    letI : Module (X.presheaf.stalk x) (F.presheaf.stalk x) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
        (R := X.presheaf) F.val x
    letI : Module (X.presheaf.stalk x) (G.presheaf.stalk x) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
        (R := X.presheaf) G.val x
    (F.presheaf.stalk x) →ₗ[X.presheaf.stalk x] (G.presheaf.stalk x) := by
  letI : Module (X.presheaf.stalk x) (F.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) F.val x
  letI : Module (X.presheaf.stalk x) (G.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) G.val x
  exact {
    toFun := fun s => (ConcreteCategory.hom
      ((TopCat.Presheaf.stalkFunctor Ab x).map (Scheme.Modules.Hom.mapPresheaf f))) s
    map_add' := by intro a b; exact map_add _ _ _
    map_smul' := by
      intro ρ s
      simp only [RingHom.id_apply]
      obtain ⟨Ur, hxr, r, hr⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf ρ
      obtain ⟨Um, hxm, m, hm⟩ := TopCat.Presheaf.exists_germ_eq F.presheaf s
      set U : X.Opens := Ur ⊓ Um with hU
      have hxU : x ∈ U := ⟨hxr, hxm⟩
      have iUr : U ⟶ Ur := homOfLE inf_le_left
      have iUm : U ⟶ Um := homOfLE inf_le_right
      set r' : X.presheaf.obj (Opposite.op U) :=
        (ConcreteCategory.hom (X.presheaf.map iUr.op)) r with hr'
      set m' : F.val.obj (Opposite.op U) :=
        (ConcreteCategory.hom (F.presheaf.map iUm.op)) m with hm'
      have hgr : (ConcreteCategory.hom (X.presheaf.germ U x hxU)) r' = ρ := by
        rw [hr', TopCat.Presheaf.germ_res_apply]; exact hr
      have hgm : (ConcreteCategory.hom (F.presheaf.germ U x hxU)) m' = s := by
        rw [hm', TopCat.Presheaf.germ_res_apply]; exact hm
      set Φ := (TopCat.Presheaf.stalkFunctor Ab x).map
        (Scheme.Modules.Hom.mapPresheaf f) with hΦ
      have eF : ρ • s = (ConcreteCategory.hom (F.presheaf.germ U x hxU))
          ((show (X.ringCatSheaf.obj.obj (Opposite.op U)) from r') • m') := by
        rw [← hgr, ← hgm]
        exact (PresheafOfModules.germ_smul F.val x U hxU r' m').symm
      have nat : ∀ (t : F.val.obj (Opposite.op U)),
          (ConcreteCategory.hom Φ) ((ConcreteCategory.hom (F.presheaf.germ U x hxU)) t)
            = (ConcreteCategory.hom (G.presheaf.germ U x hxU))
                ((ConcreteCategory.hom (f.val.app (Opposite.op U))) t) := by
        intro t
        exact TopCat.Presheaf.stalkFunctor_map_germ_apply U x hxU
          (Scheme.Modules.Hom.mapPresheaf f) t
      have lin : (ConcreteCategory.hom (f.val.app (Opposite.op U)))
          ((show (X.ringCatSheaf.obj.obj (Opposite.op U)) from r') • m')
          = (show (X.ringCatSheaf.obj.obj (Opposite.op U)) from r') •
              (ConcreteCategory.hom (f.val.app (Opposite.op U))) m' :=
        map_smul _ _ _
      have eG := PresheafOfModules.germ_smul G.val x U hxU
          (show (X.ringCatSheaf.obj.obj (Opposite.op U)) from r')
          ((ConcreteCategory.hom (f.val.app (Opposite.op U))) m')
      rw [eF, nat, lin, ← hgr, ← hgm, nat m']
      exact eG }

/-- The map induced by `f` on the stalks at `x` is bijective. -/
private def stalkMapBijective {X : Scheme.{u}} {F G : X.Modules}
    (f : F ⟶ G) (x : X) : Prop :=
  letI : Module (X.presheaf.stalk x) (F.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) F.val x
  letI : Module (X.presheaf.stalk x) (G.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) G.val x
  Function.Bijective (stalkLinearMap f x).toFun

/-- **A monomorphism into a module whose stalk has length one is an isomorphism on that stalk,
provided the source is supported there.** The stalk of the target is a simple module, so the
nonzero image of the injective stalk map is everything. -/
private theorem stalkMap_bijective_of_simple_codomain {X : Scheme.{u}}
    {F G : X.Modules} (f : F ⟶ G) [Mono f] (x : X)
    (hGlen : stalkLengthOne G x)
    (hF : x ∈ SheafOfModules.supp F) :
    stalkMapBijective f x := by
  let : Module (X.presheaf.stalk x) (G.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) G.val x
  let : Module (X.presheaf.stalk x) (F.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) F.val x
  have hGlen' : Module.length (X.presheaf.stalk x) (G.presheaf.stalk x) = 1 := hGlen
  let : IsSimpleModule (X.presheaf.stalk x) (G.presheaf.stalk x) :=
    Module.length_eq_one_iff.mp hGlen'
  show Function.Bijective (stalkLinearMap f x).toFun
  let Sh := SheafOfModules.toSheaf X.ringCatSheaf
  have hmonoPresheaf : Mono ((Scheme.Modules.toPresheaf X).map f) :=
    Functor.map_mono (Scheme.Modules.toPresheaf X) f
  have hmono : Mono (Sh.map f) := by
    have : (TopCat.Sheaf.forget Ab (TopCat.of X)).ReflectsMonomorphisms :=
      Functor.reflectsMonomorphisms_of_faithful _
    apply (TopCat.Sheaf.forget Ab (TopCat.of X)).mono_of_mono_map
    show Mono ((Scheme.Modules.toPresheaf X).map f)
    exact hmonoPresheaf
  have hmonoStalk : Mono ((TopCat.Presheaf.stalkFunctor Ab x).map (Sh.map f).hom) :=
    (TopCat.Presheaf.mono_iff_stalk_mono (Sh.map f)).mp hmono x
  have hinj' : Function.Injective
      (ConcreteCategory.hom ((TopCat.Presheaf.stalkFunctor Ab x).map
        (Scheme.Modules.Hom.mapPresheaf f))) := by
    have hm : Mono ((TopCat.Presheaf.stalkFunctor Ab x).map
        (Scheme.Modules.Hom.mapPresheaf f)) := by
      change Mono ((TopCat.Presheaf.stalkFunctor Ab x).map (Sh.map f).hom) at hmonoStalk
      exact hmonoStalk
    exact (AddCommGrpCat.mono_iff_injective _).mp hm
  have hinj : Function.Injective (stalkLinearMap f x).toFun := by
    intro a b hab
    apply hinj'
    simpa only [stalkLinearMap, TopCat.Presheaf.stalk] using hab
  have hFn : Nontrivial (F.presheaf.stalk x) :=
    (SheafOfModules.mem_supp_iff_nontrivial_stalk F x).mp hF
  let L : (F.presheaf.stalk x) →ₗ[X.presheaf.stalk x] (G.presheaf.stalk x) :=
    stalkLinearMap f x
  have hne : L ≠ (0 : (F.presheaf.stalk x) →ₗ[X.presheaf.stalk x]
      (G.presheaf.stalk x)) := by
    intro hz
    obtain ⟨a, ha⟩ := (nontrivial_iff_exists_ne (0 : F.presheaf.stalk x)).mp hFn
    have hzero : L a = 0 := by
      rw [hz]
      simp
    change (stalkLinearMap f x).toFun a = 0 at hzero
    exact ha (hinj (by simpa using hzero))
  refine ⟨hinj, ?_⟩
  exact LinearMap.surjective_of_ne_zero (f := L) hne

