/-- **A two-out-of-three property holding on one coherent module holds on the zero module.**
Apply the two-out-of-three condition to the short exact sequence `0 → G → G → 0 → 0`. -/
public theorem property_terminal_of_property
    (X : Scheme.{u}) (P : X.Modules → Prop)
    (hexact : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      S.X₁.IsCoherent → S.X₂.IsCoherent → S.X₃.IsCoherent →
      ((P S.X₁ ∧ P S.X₂ → P S.X₃) ∧
        (P S.X₁ ∧ P S.X₃ → P S.X₂) ∧
        (P S.X₂ ∧ P S.X₃ → P S.X₁)))
    {G : X.Modules} (hG : G.IsCoherent) (hP : P G) :
    P (⊤_ X.Modules) := by
  let Z : X.Modules := ⊤_ X.Modules
  let hZ : IsZero Z := IsTerminal.isZero terminalIsTerminal
  let S : ShortComplex X.Modules :=
    ShortComplex.mk (𝟙 G) (0 : G ⟶ Z) (by simp [Z])
  have hExact : S.Exact :=
    (S.exact_iff_epi (by change (0 : G ⟶ Z) = 0; rfl)).2 (by
      dsimp [S]
      infer_instance)
  let : Epi (0 : G ⟶ Z) := ⟨fun f g _ => hZ.eq_of_src f g⟩
  have hShort : S.ShortExact := ShortComplex.ShortExact.mk' hExact
    (by dsimp [S]; infer_instance) (by dsimp [S]; infer_instance)
  have hparts := hexact S hShort hG hG (coherent_terminal X)
  simpa [S, Z] using hparts.1 ⟨hP, hP⟩

/-- **A property holding on a zero module and stable under extensions is invariant under
isomorphism.** For an isomorphism `e : F ≅ G` the complex `F → G → 0` is short exact. -/
private alias property_of_iso :=
  Stacks.AlgebraicGeometry.HigherRankIrreducibleDevissage.property_of_iso

/-- **A quasi-coherent ideal on an integral scheme is either zero or the whole structure sheaf
near the generic point.** A nonzero section generates the structure sheaf on the basic open it
defines, which contains the generic point. -/
private lemma ideal_eq_zero_or_iso_near_genericPoint {Z : Scheme.{u}} [IsIntegral Z]
    (H : (SheafOfModules.unit Z.ringCatSheaf).Submodule) :
    IsZero H.toSheafOfModules ∨ ∃ U : Z.Opens, genericPoint Z ∈ U ∧
      IsIso ((Scheme.Modules.restrictFunctor U.ι).map H.ι) := by
  classical
  by_cases hz : IsZero H.toSheafOfModules
  · exact Or.inl hz
  right
  have hs : ∃ (U : Z.Opens) (s : Γ(H.toSheafOfModules, U)),
      (s.val : Γ(Z, U)) ≠ 0 := by
    by_contra! h
    apply hz
    apply (IsZero.iff_id_eq_zero _).mpr
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.Hom.ext
    funext U
    apply ModuleCat.Hom.ext
    ext s
    apply Subtype.ext
    exact h U.unop s
  obtain ⟨U, s, hs⟩ := hs
  let t : Γ(Z, U) := s.val
  let V := Z.basicOpen t
  have hV : (V : Set Z).Nonempty :=
    V.ne_bot_iff_nonempty.mp (fun h => hs ((basicOpen_eq_bot_iff t).mp h))
  have hξ : genericPoint Z ∈ V :=
    ((genericPoint_spec Z).mem_open_set_iff V.isOpen).mpr (by simpa using hV)
  refine ⟨V, hξ, Scheme.Modules.Hom.isIso_iff_isIso_app.mpr ?_⟩
  intro W
  let W' : Z.Opens := V.ι ''ᵁ W
  have hWV : W' ≤ V := by simpa [W'] using V.ι.image_le_opensRange W
  let k : W' ⟶ U := homOfLE (hWV.trans (Z.basicOpen_le t))
  have htH : (Z.presheaf.map k.op) t ∈ H.toSubmodule.obj (op W') :=
    H.toSubmodule.map k.op s.property
  have htUnit : IsUnit ((Z.presheaf.map k.op) t) := by
    have h := (Z.toRingedSpace.isUnit_res_basicOpen t).map
      (Z.presheaf.map (homOfLE hWV).op).hom
    change IsUnit ((Z.presheaf.map (homOfLE hWV).op)
      ((Z.presheaf.map (homOfLE (Z.basicOpen_le t)).op) t)) at h
    rwa [← CommRingCat.comp_apply, ← Functor.map_comp] at h
  have htop : H.toSubmodule.obj (op W') = ⊤ := by
    apply top_unique
    intro a _
    obtain ⟨v, hv⟩ := htUnit
    let a' : Γ(Z, W') := a
    have h := (H.toSubmodule.obj (op W')).smul_mem
      (a' * (↑(v⁻¹) : Γ(Z, W'))) htH
    change (a' * (↑(v⁻¹) : Γ(Z, W'))) * ((Z.presheaf.map k.op) t) ∈ _ at h
    rw [← hv] at h
    have hmul : a' * (↑(v⁻¹) : Γ(Z, W')) * (↑v : Γ(Z, W')) = a' := by
      rw [mul_assoc, Units.inv_mul, mul_one]
    rwa [hmul] at h
  have hinj : Function.Injective (Scheme.Modules.Hom.app
      ((Scheme.Modules.restrictFunctor V.ι).map H.ι) W) := Subtype.val_injective
  have hsurj : Function.Surjective (Scheme.Modules.Hom.app
      ((Scheme.Modules.restrictFunctor V.ι).map H.ι) W) :=
    fun a => ⟨⟨a, htop.ge trivial⟩, rfl⟩
  have : Mono (Scheme.Modules.Hom.app ((Scheme.Modules.restrictFunctor V.ι).map H.ι) W) :=
    (AddCommGrpCat.mono_iff_injective _).mpr hinj
  have : Epi (Scheme.Modules.Hom.app ((Scheme.Modules.restrictFunctor V.ι).map H.ι) W) :=
    (AddCommGrpCat.epi_iff_surjective _).mpr hsurj
  exact isIso_of_mono_of_epi _

