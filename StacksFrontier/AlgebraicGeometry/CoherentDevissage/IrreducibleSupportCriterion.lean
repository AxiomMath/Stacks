/-- **The criterion of [Stacks, Tag 01YG] restricted to modules supported inside a fixed set.**
It suffices to know the property on those direct images of ideals which are themselves
supported inside that set, since "`P`, or the support is not contained in the set" is again
stable under extensions. -/
private alias property_of_support_subset :=
  Stacks.AlgebraicGeometry.HigherRankIrreducibleDevissage.property_of_support_subset

/-- A quasi-coherent ideal on a scheme with a closed immersion into a Noetherian scheme is
coherent. -/
private lemma isCoherent_ideal_of_isClosedImmersion {X Z : Scheme.{u}} [IsNoetherian X]
    (i : Z ⟶ X) [IsClosedImmersion i]
    (H : (SheafOfModules.unit Z.ringCatSheaf).Submodule)
    [H.toSheafOfModules.IsQuasicoherent] : H.toSheafOfModules.IsCoherent := by
  have : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian i
  have : (SheafOfModules.unit Z.ringCatSheaf).IsCoherent :=
    CoherenceCriteria.structureSheaf_isCoherent Z
  exact CoherentSubquotients.isCoherent_of_mono H.ι

/-- The property holds on the direct image of a zero ideal, given it on the zero module. -/
private lemma property_pushforward_of_isZero {X Z : Scheme.{u}} [IsNoetherian X]
    (P : X.Modules → Prop) (i : Z ⟶ X) [IsClosedImmersion i]
    (H : (SheafOfModules.unit Z.ringCatSheaf).Submodule)
    [H.toSheafOfModules.IsQuasicoherent] (hzero : P (⊤_ X.Modules))
    (hext : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      S.X₁.IsCoherent → S.X₂.IsCoherent → S.X₃.IsCoherent →
      P S.X₁ → P S.X₃ → P S.X₂)
    (hHz : IsZero H.toSheafOfModules) :
    P ((Scheme.Modules.pushforward i).obj H.toSheafOfModules) :=
  property_of_iso P hzero hext
    ((IsTerminal.isZero terminalIsTerminal).iso ((Scheme.Modules.pushforward i).map_isZero hHz))
    (coherent_terminal X) (coherent_pushforward_ideal i H) hzero

/-- **Every coherent module supported inside a proper closed part of `Z₀` has the property.**
Its dévissage quotients are direct images of ideals on integral closed subschemes whose range
is contained in that part, hence strictly inside `Z₀`. -/
private theorem property_of_proper_support {X : Scheme.{u}} [IsNoetherian X]
    (P : X.Modules → Prop) (Z₀ T : Set X) (hTZ : T ⊂ Z₀)
    (hzero : P (⊤_ X.Modules))
    (hext : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      S.X₁.IsCoherent → S.X₂.IsCoherent → S.X₃.IsCoherent →
      P S.X₁ → P S.X₃ → P S.X₂)
    (hproper : ∀ (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i]
      [IsIntegral Z], Set.range i.base ⊂ Z₀ →
      ∀ (H : (SheafOfModules.unit Z.ringCatSheaf).Submodule)
        [H.toSheafOfModules.IsQuasicoherent],
        P ((Scheme.Modules.pushforward i).obj H.toSheafOfModules)) :
    ∀ (F : X.Modules), F.IsCoherent → SheafOfModules.supp F ⊆ T → P F := by
  intro F hF hFT
  apply property_of_support_subset P T hzero hext ?_ F hF hFT
  intro Z i hi hZ H hH hFsupp
  let : H.toSheafOfModules.IsQuasicoherent := hH
  by_cases hHz : IsZero H.toSheafOfModules
  · exact property_pushforward_of_isZero P i H hzero hext hHz
  · have hHc := isCoherent_ideal_of_isClosedImmersion i H
    have hsupport := supp_pushforward_ideal i H hHc hHz
    have hrange : Set.range i.base ⊆ T := by
      rw [← hsupport]
      exact hFsupp
    exact hproper Z i ⟨hrange.trans hTZ.1, fun hback => hTZ.2 (hback.trans hrange)⟩ H

/-- **A coherent module supported inside `Z₀` but not at its generic point has the property.**
Its support is then a closed set strictly smaller than `Z₀`. -/
private theorem property_of_support_avoiding_generic
    {X : Scheme.{u}} [IsNoetherian X] (P : X.Modules → Prop)
    (Z₀ : Set X) (_hZ₀ : IsClosed Z₀) (ξ : X) (hξ : IsGenericPoint ξ Z₀)
    (hzero : P (⊤_ X.Modules))
    (hext : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      S.X₁.IsCoherent → S.X₂.IsCoherent → S.X₃.IsCoherent →
      P S.X₁ → P S.X₃ → P S.X₂)
    (hproper : ∀ (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i]
      [IsIntegral Z], Set.range i.base ⊂ Z₀ →
      ∀ (H : (SheafOfModules.unit Z.ringCatSheaf).Submodule)
        [H.toSheafOfModules.IsQuasicoherent],
        P ((Scheme.Modules.pushforward i).obj H.toSheafOfModules))
    (Q : X.Modules) (hQ : Q.IsCoherent)
    (hQT : SheafOfModules.supp Q ⊆ Z₀)
    (hQξ : ξ ∉ SheafOfModules.supp Q) : P Q := by
  let T := SheafOfModules.supp Q
  let : Q.IsFiniteType := hQ.isFiniteType
  have hTclosed : IsClosed T := SheafOfModules.isClosed_supp Q
  have hstrict : T ⊂ Z₀ := ⟨hQT, fun heq => hQξ ((hξ.mem_closed_set_iff hTclosed).2 heq)⟩
  exact property_of_proper_support P Z₀ T hstrict hzero hext hproper Q hQ le_rfl

/-- A two-out-of-three property of coherent sheaves holds for every sheaf
supported on the given irreducible closed subset if it holds on proper
integral closed subschemes and on one generically simple sheaf of full support. -/
@[stacks 01YH]
public theorem property_of_irreducible_support
    (X : Scheme.{u}) [IsNoetherian X]
    (Z₀ : Set X) (hZ₀ : IsClosed Z₀) (_hZ₀irr : IsIrreducible Z₀)
    (ξ : X) (hξ : IsGenericPoint ξ Z₀)
    (P : X.Modules → Prop)
    (hexact : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      S.X₁.IsCoherent → S.X₂.IsCoherent → S.X₃.IsCoherent →
      ((P S.X₁ ∧ P S.X₂ → P S.X₃) ∧
        (P S.X₁ ∧ P S.X₃ → P S.X₂) ∧
        (P S.X₂ ∧ P S.X₃ → P S.X₁)))
    (hproper : ∀ (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i]
      [IsIntegral Z], Set.range i.base ⊂ Z₀ →
      ∀ (I : (SheafOfModules.unit Z.ringCatSheaf).Submodule)
        [I.toSheafOfModules.IsQuasicoherent],
        P ((Scheme.Modules.pushforward i).obj I.toSheafOfModules))
    (hgeneric : ∃ G : X.Modules,
      G.IsCoherent ∧ SheafOfModules.supp G = Z₀ ∧
      Stacks.ClosedImmersion.StalkKilledByMaximalIdeal G ξ ∧
      (letI : Module (X.presheaf.stalk ξ) (G.presheaf.stalk ξ) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
          (R := X.presheaf) G.val ξ
       Module.length (X.presheaf.stalk ξ) (G.presheaf.stalk ξ) = 1) ∧
      P G) :
    ∀ F : X.Modules, F.IsCoherent → SheafOfModules.supp F ⊆ Z₀ → P F := by
  classical
  rcases hgeneric with ⟨G, hGc, hGs, hGann, hGlen, hGP⟩
  have hzero : P (⊤_ X.Modules) :=
    property_terminal_of_property X P hexact hGc hGP
  have hGξ : ξ ∈ SheafOfModules.supp G := hGs ▸ hξ.mem
  have hext : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      S.X₁.IsCoherent → S.X₂.IsCoherent → S.X₃.IsCoherent →
      P S.X₁ → P S.X₃ → P S.X₂ := fun S hS h1 h2 h3 hp1 hp3 =>
    (hexact S hS h1 h2 h3).2.1 ⟨hp1, hp3⟩
  have hsmall : ∀ Q : X.Modules, Q.IsCoherent →
      SheafOfModules.supp Q ⊆ Z₀ → ξ ∉ SheafOfModules.supp Q → P Q := fun Q hQ hQT hQξ =>
    property_of_support_avoiding_generic P Z₀ hZ₀ ξ hξ hzero hext hproper Q hQ hQT hQξ
  have hideal : ∀ {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
      [IsIntegral Z] (H : (SheafOfModules.unit Z.ringCatSheaf).Submodule),
      H.toSheafOfModules.IsQuasicoherent →
      SheafOfModules.supp ((Scheme.Modules.pushforward i).obj H.toSheafOfModules) ⊆ Z₀ →
      P ((Scheme.Modules.pushforward i).obj H.toSheafOfModules) := by
    intro Z i hi hZ H hH hFT
    let : H.toSheafOfModules.IsQuasicoherent := hH
    let L := Scheme.Modules.pushforward i
    let : L.IsRightAdjoint := by
      dsimp [L]
      infer_instance
    let : PreservesFiniteLimits L := inferInstance
    have hLmono : L.PreservesMonomorphisms := inferInstance
    let : L.PreservesMonomorphisms := hLmono
    have hHc := isCoherent_ideal_of_isClosedImmersion i H
    by_cases hHz : IsZero H.toSheafOfModules
    · exact property_pushforward_of_isZero P i H hzero hext hHz
    have hrange : Set.range i.base ⊆ Z₀ := by rwa [← supp_pushforward_ideal i H hHc hHz]
    by_cases hrange_eq : Set.range i.base = Z₀
    · let η : Z := genericPoint Z
      have hηgen : IsGenericPoint (i η) Z₀ := by
        have h := (genericPoint_spec Z).image i.continuous
        rwa [Set.image_univ, hrange_eq, hZ₀.closure_eq] at h
      have hpoint : i η = ξ := hηgen.eq hξ
      have hGann' : Stacks.ClosedImmersion.StalkKilledByMaximalIdeal G (i η) := by
        rw [hpoint]
        exact hGann
      have hGlen' : stalkLengthOne G ξ := by
        simpa only [stalkLengthOne] using hGlen
      obtain ⟨r, A, hAc, hMc, ψ, hψ, U, hU, hψU⟩ :=
        Stacks.ClosedImmersion.exists_idealCoproduct_pushforward_mono_isIso_near_genericPoint
          i η (genericPoint_spec Z) G hGann'
      let : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian i
      let : (SheafOfModules.unit Z.ringCatSheaf).IsCoherent :=
        CoherenceCriteria.structureSheaf_isCoherent Z
      let : A.toSheafOfModules.IsCoherent := hAc
      let : A.toSheafOfModules.IsQuasicoherent :=
        isQuasicoherent_of_isCoherent A.toSheafOfModules
      have hψst := stalk_isIso_of_restrict_isIso ψ U (i η) hU
      have hGη : i η ∈ SheafOfModules.supp G := by
        simpa only [hpoint] using hGξ
      have hMη : i η ∈ SheafOfModules.supp
          (L.obj (∐ fun _ : Fin r => A.toSheafOfModules)) :=
        mem_supp_of_stalk_surjective ψ (i η)
          ((AddCommGrpCat.epi_iff_surjective _).mp inferInstance) hGη
      have hMnz : ¬ IsZero (L.obj (∐ fun _ : Fin r => A.toSheafOfModules)) := fun hMz =>
        (supp_eq_empty_of_isZero hMz ▸ hMη : i η ∈ (∅ : Set X)).elim
      have hAne : ¬ IsZero A.toSheafOfModules := fun hz =>
        hMnz (L.map_isZero (isZero_coproduct _ fun _ => hz))
      have hr : r ≠ 0 := by
        rintro rfl
        exact hMnz (L.map_isZero (isZero_coproduct _ fun j => Fin.elim0 j))
      obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hr
      let : HasFiniteBiproducts Z.Modules := HasFiniteBiproducts.of_hasFiniteProducts
      let j : Fin (n + 1) := Fin.last n
      have hιA : Mono (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) := by
        show Mono (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j)
        infer_instance
      have : IsSplitMono (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) := by
        show IsSplitMono (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j)
        infer_instance
      let ρA : (∐ fun _ : Fin (n + 1) => A.toSheafOfModules) ⟶ A.toSheafOfModules :=
        CategoryTheory.retraction
          (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j)
      have hretA :
          Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j ≫ ρA = 𝟙 _ :=
        IsSplitMono.id _
      have hretLA : L.map
          (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) ≫ L.map ρA = 𝟙 _ := by
        calc
          _ = L.map (Limits.Sigma.ι
              (fun _ : Fin (n + 1) => A.toSheafOfModules) j ≫ ρA) :=
                (Functor.map_comp L _ _).symm
          _ = L.map (𝟙 _) := congrArg (L.map) hretA
          _ = 𝟙 _ := L.map_id _
      have hLιA : Mono (L.map
          (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j)) := by
        refine ⟨?_⟩
        intro T g h hgh
        calc
          g = g ≫ (L.map
              (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) ≫ L.map ρA) :=
                by rw [hretLA, Category.comp_id]
          _ = h ≫ (L.map
              (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) ≫ L.map ρA) :=
                by
                  calc
                    _ = (g ≫ L.map
                        (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j)) ≫
                          L.map ρA := (Category.assoc _ _ _).symm
                    _ = (h ≫ L.map
                        (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j)) ≫
                          L.map ρA := congrArg (fun k => k ≫ L.map ρA) hgh
                    _ = h ≫ (L.map
                        (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) ≫
                          L.map ρA) := Category.assoc _ _ _
          _ = h := by rw [hretLA, Category.comp_id]
      let f : L.obj A.toSheafOfModules ⟶ G :=
        L.map (Limits.Sigma.ι (fun _ : Fin (n + 1) => A.toSheafOfModules) j) ≫ ψ
      have hf : Mono f := by
        dsimp [f]
        refine ⟨?_⟩
        intro T g h hgh
        apply hLιA.right_cancellation
        apply hψ.right_cancellation
        exact (Category.assoc _ _ _).trans
          (hgh.trans (Category.assoc _ _ _).symm)
      have hFη : i η ∈ SheafOfModules.supp (L.obj A.toSheafOfModules) := by
        apply (mem_supp_pushforward_iff i A.toSheafOfModules η).mpr
        rw [supp_ideal_eq_univ_of_not_isZero A hAc hAne]
        trivial
      have hGlenη : stalkLengthOne G (i η) := by
        rw [hpoint]
        exact hGlen'
      have hbij := stalkMap_bijective_of_simple_codomain f (i η) hGlenη hFη
      have hsurj : Function.Surjective (((TopCat.Presheaf.stalkFunctor Ab (i η)).map
          (Scheme.Modules.Hom.mapPresheaf f)).hom) := by
        simpa only [stalkLinearMap, TopCat.Presheaf.stalk] using hbij.2
      have hiff : ∀ {F G : X.Modules} (g : F ⟶ G) [Mono g], F.IsCoherent → G.IsCoherent →
          SheafOfModules.supp G ⊆ Z₀ → Function.Surjective
            (((TopCat.Presheaf.stalkFunctor Ab (i η)).map
              (Scheme.Modules.Hom.mapPresheaf g)).hom) → (P F ↔ P G) := by
        intro F G g _ hF hG hGT hgsurj
        have hQc := coherent_cokernel g hF hG
        have hQP := hsmall (cokernel g) hQc ((supp_of_epi (cokernel.π g)).trans hGT)
          fun hξ' => not_mem_supp_cokernel_of_stalk_surjective g (i η) hgsurj (hpoint ▸ hξ')
        have hshort : (ShortComplex.mk g (cokernel.π g) (cokernel.condition g)).ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.cokernelSequence_exact g) inferInstance
            inferInstance
        have h := hexact _ hshort hF hG hQc
        exact ⟨fun hp => h.2.1 ⟨hp, hQP⟩, fun hp => h.2.2 ⟨hp, hQP⟩⟩
      have hGsub : SheafOfModules.supp G ⊆ Z₀ := by rw [hGs]
      have hPA : P (L.obj A.toSheafOfModules) :=
        (hiff f (coherent_pushforward_ideal i A) hGc hGsub hsurj).2 hGP
      have hAisoData :=
        (ideal_eq_zero_or_iso_near_genericPoint A).resolve_left hAne
      obtain ⟨UA, hUA, hAiso⟩ := hAisoData
      obtain ⟨UH, hUH, hHiso⟩ :=
        (ideal_eq_zero_or_iso_near_genericPoint H).resolve_left hHz
      let B := H ⊓ A
      have hBc : B.toSheafOfModules.IsCoherent :=
        coherent_submodule_inf H A hHc hAc (CoherenceCriteria.structureSheaf_isCoherent Z)
      have hBq : B.toSheafOfModules.IsQuasicoherent :=
        isQuasicoherent_of_isCoherent B.toSheafOfModules
      let a : B.toSheafOfModules ⟶ H.toSheafOfModules :=
        submoduleInclusion (show B ≤ H from inf_le_left)
      let b : B.toSheafOfModules ⟶ A.toSheafOfModules :=
        submoduleInclusion (show B ≤ A from inf_le_right)
      have ha : Mono a := submoduleInclusion_mono (show B ≤ H from inf_le_left)
      have hb : Mono b := submoduleInclusion_mono (show B ≤ A from inf_le_right)
      have haU : IsIso ((Scheme.Modules.restrictFunctor UA.ι).map a) :=
        restrict_submoduleInclusion_isIso _ UA fun W s =>
          ⟨s.property, mem_of_isIso_restrict_ι A UA W s.val⟩
      have hbU : IsIso ((Scheme.Modules.restrictFunctor UH.ι).map b) :=
        restrict_submoduleInclusion_isIso _ UH fun W s =>
          ⟨mem_of_isIso_restrict_ι H UH W s.val, s.property⟩
      have haSt := stalk_isIso_of_restrict_isIso a UA (genericPoint Z) hUA
      have hbSt := stalk_isIso_of_restrict_isIso b UH (genericPoint Z) hUH
      let : IsIso ((TopCat.Presheaf.stalkFunctor Ab (genericPoint Z)).map
          (Scheme.Modules.Hom.mapPresheaf a)) := haSt
      let : IsIso ((TopCat.Presheaf.stalkFunctor Ab (genericPoint Z)).map
          (Scheme.Modules.Hom.mapPresheaf b)) := hbSt
      have haL := stalk_pushforward_map_isIso i a η
      have hbL := stalk_pushforward_map_isIso i b η
      let : IsIso ((TopCat.Presheaf.stalkFunctor Ab (i η)).map
          (Scheme.Modules.Hom.mapPresheaf (L.map a))) := haL
      let : IsIso ((TopCat.Presheaf.stalkFunctor Ab (i η)).map
          (Scheme.Modules.Hom.mapPresheaf (L.map b))) := hbL
      have hLa : Mono (L.map a) :=
        @CategoryTheory.Functor.PreservesMonomorphisms.preserves _ _ _ _ _ hLmono _ _ a ha
      have hLb : Mono (L.map b) :=
        @CategoryTheory.Functor.PreservesMonomorphisms.preserves _ _ _ _ _ hLmono _ _ b hb
      have hPB : P (L.obj B.toSheafOfModules) :=
        (hiff (L.map b) (coherent_pushforward_ideal i B) (coherent_pushforward_ideal i A)
          ((supp_pushforward_subset_range i A.toSheafOfModules).trans hrange)
          ((AddCommGrpCat.epi_iff_surjective _).mp inferInstance)).2 hPA
      exact (hiff (L.map a) (coherent_pushforward_ideal i B) (coherent_pushforward_ideal i H)
        ((supp_pushforward_subset_range i H.toSheafOfModules).trans hrange)
        ((AddCommGrpCat.epi_iff_surjective _).mp inferInstance)).1 hPB
    · exact hproper Z i ⟨hrange, fun hback => hrange_eq (hrange.antisymm hback)⟩ H
  intro F hF hFT
  exact property_of_support_subset P Z₀ hzero hext hideal F hF hFT

end Stacks.AlgebraicGeometry.IrreducibleSupportDevissage

