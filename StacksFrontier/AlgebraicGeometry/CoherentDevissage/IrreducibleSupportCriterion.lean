/-- A morphism whose sections all land in a submodule `H` of the target factors through `H`. -/
private noncomputable def submoduleLift {X : Scheme.{u}} {M N : X.Modules}
    (f : M ⟶ N) (H : N.Submodule)
    (h : ∀ U s, (f.val.app U).hom s ∈ H.toSubmodule.obj U) :
    M ⟶ H.toSheafOfModules :=
  ⟨{ app := fun U => ModuleCat.ofHom ((f.val.app U).hom.codRestrict _ (h U))
     naturality := by
       intro U V k
       apply ModuleCat.Hom.ext
       ext s
       apply Subtype.ext
       exact PresheafOfModules.naturality_apply f.val k s }⟩

/-- The factorisation through a submodule recovers the original morphism. -/
private lemma submoduleLift_comp {X : Scheme.{u}} {M N : X.Modules}
    (f : M ⟶ N) (H : N.Submodule)
    (h : ∀ U s, (f.val.app U).hom s ∈ H.toSubmodule.obj U) :
    submoduleLift f H h ≫ H.ι = f := by
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.Hom.ext
  funext U
  apply ModuleCat.Hom.ext
  ext s
  rfl

/-- **The intersection of two coherent submodules of a coherent module is coherent.** The
intersection is the pullback of the two inclusions, hence the kernel of a map out of their
biproduct, and coherent modules are closed under kernels and biproducts. -/
@[ega "0 5.3.4" "intersection clause"]
private lemma coherent_submodule_inf {X : Scheme.{u}} {M : X.Modules}
    (H K : M.Submodule) (hH : H.toSheafOfModules.IsCoherent)
    (hK : K.toSheafOfModules.IsCoherent) (hM : M.IsCoherent) :
    (H ⊓ K).toSheafOfModules.IsCoherent := by
  let : Mono H.ι := SheafOfModules.Submodule.instMonoι H
  let : Mono K.ι := SheafOfModules.Submodule.instMonoι K
  let : Mono (H ⊓ K).ι := SheafOfModules.Submodule.instMonoι (H ⊓ K)
  let a := submoduleInclusion (show H ⊓ K ≤ H from inf_le_left)
  let b := submoduleInclusion (show H ⊓ K ≤ K from inf_le_right)
  have hab : a ≫ H.ι = b ≫ K.ι := rfl
  have hcompA : a ≫ H.ι = (H ⊓ K).ι := submoduleInclusion_comp _
  have hcompB : b ≫ K.ι = (H ⊓ K).ι := submoduleInclusion_comp _
  let l := pullback.lift a b hab
  have hm : ∀ U s, ((pullback.fst H.ι K.ι ≫ H.ι).val.app U).hom s ∈
      (H ⊓ K).toSubmodule.obj U := by
    intro U s
    constructor
    · exact ((pullback.fst H.ι K.ι).val.app U s).property
    · have e := congrArg (fun f : pullback H.ι K.ι ⟶ M => (f.val.app U).hom s)
        (pullback.condition (f := H.ι) (g := K.ι))
      rw [e]
      exact ((pullback.snd H.ι K.ι).val.app U s).property
  let r := submoduleLift (pullback.fst H.ι K.ι ≫ H.ι) (H ⊓ K) hm
  have hr : r ≫ (H ⊓ K).ι = pullback.fst H.ι K.ι ≫ H.ι :=
    submoduleLift_comp _ _ _
  have hl₁ : l ≫ pullback.fst H.ι K.ι = a := pullback.lift_fst a b hab
  have hl₂ : l ≫ pullback.snd H.ι K.ι = b := pullback.lift_snd a b hab
  have hra : (r ≫ a) ≫ H.ι = pullback.fst H.ι K.ι ≫ H.ι :=
    have h₁ : (r ≫ a) ≫ H.ι = r ≫ a ≫ H.ι := Category.assoc _ _ _
    have h₂ : r ≫ a ≫ H.ι = r ≫ (H ⊓ K).ι := congrArg (fun g => r ≫ g) hcompA
    h₁.trans (h₂.trans hr)
  have hr₁ : r ≫ a = pullback.fst H.ι K.ι := (cancel_mono H.ι).mp hra
  have hrb : (r ≫ b) ≫ K.ι = pullback.snd H.ι K.ι ≫ K.ι :=
    have h₁ : (r ≫ b) ≫ K.ι = r ≫ b ≫ K.ι := Category.assoc _ _ _
    have h₂ : r ≫ b ≫ K.ι = r ≫ (H ⊓ K).ι := congrArg (fun g => r ≫ g) hcompB
    h₁.trans (h₂.trans (hr.trans pullback.condition))
  have hr₂ : r ≫ b = pullback.snd H.ι K.ι := (cancel_mono K.ι).mp hrb
  have hlr : l ≫ r = 𝟙 (H ⊓ K).toSheafOfModules := by
    refine (cancel_mono (H ⊓ K).ι).mp ?_
    have h₁ : (l ≫ r) ≫ (H ⊓ K).ι = l ≫ r ≫ (H ⊓ K).ι := Category.assoc _ _ _
    have h₂ : l ≫ r ≫ (H ⊓ K).ι = l ≫ pullback.fst H.ι K.ι ≫ H.ι :=
      congrArg (fun g => l ≫ g) hr
    have h₃ : l ≫ pullback.fst H.ι K.ι ≫ H.ι = (l ≫ pullback.fst H.ι K.ι) ≫ H.ι :=
      (Category.assoc _ _ _).symm
    have h₄ : (l ≫ pullback.fst H.ι K.ι) ≫ H.ι = a ≫ H.ι :=
      congrArg (fun g => g ≫ H.ι) hl₁
    exact h₁.trans (h₂.trans (h₃.trans (h₄.trans
      (hcompA.trans (Category.id_comp (H ⊓ K).ι).symm))))
  have hrl : r ≫ l = 𝟙 _ := by
    refine pullback.hom_ext (f := H.ι) (g := K.ι) ?_ ?_
    · have h₁ : (r ≫ l) ≫ pullback.fst H.ι K.ι = r ≫ l ≫ pullback.fst H.ι K.ι :=
        Category.assoc _ _ _
      have h₂ : r ≫ l ≫ pullback.fst H.ι K.ι = r ≫ a := congrArg (fun g => r ≫ g) hl₁
      exact h₁.trans (h₂.trans (hr₁.trans (Category.id_comp (pullback.fst H.ι K.ι)).symm))
    · have h₁ : (r ≫ l) ≫ pullback.snd H.ι K.ι = r ≫ l ≫ pullback.snd H.ι K.ι :=
        Category.assoc _ _ _
      have h₂ : r ≫ l ≫ pullback.snd H.ι K.ι = r ≫ b := congrArg (fun g => r ≫ g) hl₂
      exact h₁.trans (h₂.trans (hr₂.trans (Category.id_comp (pullback.snd H.ι K.ι)).symm))
  let e : (H ⊓ K).toSheafOfModules ≅ pullback H.ι K.ι := ⟨l, r, hlr, hrl⟩
  let : HasBinaryBiproducts X.Modules := HasBinaryBiproducts.of_hasBinaryProducts
  let C : ObjectProperty X.Modules := fun M => M.IsCoherent
  have hpb : (pullback H.ι K.ι : X.Modules).IsCoherent :=
    C.prop_of_isLimit_kernelFork
      (Abelian.PullbackToBiproductIsKernel.isLimitPullbackToBiproduct H.ι K.ι)
      (C.prop_biprod hH hK) hM
  exact coherent_of_iso e.symm hpb

/-- Every section of `M` over an open of `U` lies in `K` if `K.ι` is an isomorphism over `U`. -/
private lemma mem_of_isIso_restrict_ι {X : Scheme.{u}} {M : X.Modules} (K : M.Submodule)
    (U : X.Opens) [IsIso ((Scheme.Modules.restrictFunctor U.ι).map K.ι)] (W : U.toScheme.Opens)
    (s : Γ(M, U.ι ''ᵁ W)) : s ∈ K.toSubmodule.obj (op (U.ι ''ᵁ W)) := by
  let : Mono K.ι := SheafOfModules.Submodule.instMonoι K
  let a := Scheme.Modules.Hom.app ((Scheme.Modules.restrictFunctor U.ι).map K.ι) W
  have ha : IsIso a := by dsimp [a]; infer_instance
  obtain ⟨t, ht⟩ := (AddCommGrpCat.epi_iff_surjective a).mp inferInstance s
  exact ht ▸ t.property

/-- An inclusion of submodules `B ≤ H` is an isomorphism over `U` once every section of `H` over
an open of `U` lies in `B`. -/
private lemma restrict_submoduleInclusion_isIso {X : Scheme.{u}} {M : X.Modules}
    {B H : M.Submodule} (h : B ≤ H) (U : X.Opens)
    (hs : ∀ (W : U.toScheme.Opens) (s : Γ(H.toSheafOfModules, U.ι ''ᵁ W)),
      s.val ∈ B.toSubmodule.obj (op (U.ι ''ᵁ W))) :
    IsIso ((Scheme.Modules.restrictFunctor U.ι).map (submoduleInclusion h)) := by
  apply Scheme.Modules.Hom.isIso_iff_isIso_app.mpr
  intro W
  let b := Scheme.Modules.Hom.app ((Scheme.Modules.restrictFunctor U.ι).map
    (submoduleInclusion h)) W
  have hb : Function.Bijective b := by
    constructor
    · intro s t hst
      apply Subtype.ext
      exact congrArg (fun y : Γ(H.toSheafOfModules, U.ι ''ᵁ W) => y.val) hst
    · intro s
      exact ⟨⟨s.val, hs W s⟩, rfl⟩
  have : Mono b := (AddCommGrpCat.mono_iff_injective _).mpr hb.1
  have : Epi b := (AddCommGrpCat.epi_iff_surjective _).mpr hb.2
  exact isIso_of_mono_of_epi b

