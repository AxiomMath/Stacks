module

public import StacksFrontier.AlgebraicGeometry.Etale.FiniteEtaleIrreducibleCover0551
public import StacksFrontier.AlgebraicGeometry.Etale.FiniteEtaleIrreducibleCover0551b
public import StacksFrontier.AlgebraicGeometry.Morphisms.GeometricComponentsFiniteEtale

/-!
# The `Y`-half of Tag 0551

This file proves `AlgebraicGeometry.SpreadsOutFiniteSeparableResidueExtension`, the hypothesis
isolated in `StacksFrontier.AlgebraicGeometry.Etale.FiniteEtaleIrreducibleCover0551`, and hence
closes Tag 0551.

## Main results

* `Stacks.GeometricComponents.exists_notMem_forall_isLocalization_finiteEtale` is the
  ring-theoretic content: for a prime `p` of `A` contained in every prime and a finite separable
  extension `K` of `κ(p)`, there is an `a ∉ p` such that *every* localization `Rₐ` of `A` away
  from `a` admits a finite étale `Rₐ`-algebra `Bₐ` with `Spec Bₐ → Spec Rₐ` surjective, whose
  nilradical is a prime `q` with `κ(q) ≅ K` as an extension of `κ(p)`.
* `AlgebraicGeometry.spreadsOutFiniteSeparableResidueExtension` is the geometric form of the same
  statement, the `Y`-half of Tag 0551.
Feeding it to the `X`-half `..._genericFiber_components_of_spreadsOut` of
`StacksFrontier.AlgebraicGeometry.Etale.FiniteEtaleIrreducibleCover0551` gives Tag 0551 itself,
which is stated as
`AlgebraicGeometry.exists_nonemptyOpen_finiteEtale_cover_geometricallyIrreducible_genericFiber` in
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.GeometricallyIrreducible`.

## Implementation notes

`Bₐ` is `(A[x]/(f))_a` for `f` a monic lift of the minimal polynomial of a primitive element `β`
of `K/κ(p)`, and `q` is the kernel of the map `Bₐ → K` sending `x` to `β`. Finiteness, étaleness
and surjectivity come from
`StacksFrontier.AlgebraicGeometry.Morphisms.GeometricComponentsFiniteEtale`; the two facts proved
here are that `q` is the nilradical — so that `Spec Bₐ` is irreducible with generic point `q` —
and that `κ(q) ≅ K`.

Both rest on `Stacks.GeometricComponents.ringHom_ext_residueField`: a ring map out of `κ(p)` is
determined by its restriction to `A`. That is what identifies the composite
`κ(p) → κ(q) → K` with the structure map, which in turn is what makes the field generated by the
image of `κ(q) → K` contain `κ(p)` and hence, with `β`, all of `K`.

## References

* [Stacks Project, Tag 0551](https://stacks.math.columbia.edu/tag/0551)
* [Stacks Project, Tag 00UD](https://stacks.math.columbia.edu/tag/00UD)
* [Stacks Project, Tag 030N](https://stacks.math.columbia.edu/tag/030N)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Polynomial TopologicalSpace

universe u v

noncomputable section

namespace Stacks.GeometricComponents

/-- Two ring homomorphisms out of the residue field of a prime `p` of `A` that agree on `A` are
equal: `κ(p)` is a localization of `A ⧸ p`, and `A ⧸ p` is generated by the image of `A`. -/
theorem ringHom_ext_residueField {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime]
    {K : Type v} [CommRing K] {u v : p.ResidueField →+* K}
    (huv : u.comp (algebraMap A p.ResidueField) = v.comp (algebraMap A p.ResidueField)) :
    u = v := by
  refine IsLocalization.ringHom_ext (nonZeroDivisors (A ⧸ p)) (RingHom.ext fun x => ?_)
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  simpa [Ideal.algebraMap_quotient_residueField_mk] using RingHom.congr_fun huv a

/-- The kernel of `A → κ(p) → K` is `p`. -/
theorem ker_algebraMap_comp_algebraMap_residueField {A : Type u} [CommRing A] (p : Ideal A)
    [p.IsPrime] {K : Type v} [Field K] [Algebra p.ResidueField K] :
    RingHom.ker ((algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField)) = p := by
  ext x
  rw [RingHom.mem_ker, RingHom.comp_apply,
    map_eq_zero_iff _ (algebraMap p.ResidueField K).injective,
    Ideal.algebraMap_residueField_eq_zero]

/-- If `ψ : B →+* K` restricts on `A` to `A → κ(p) → K`, then `p` is the contraction of `ker ψ`. -/
private theorem under_ker_eq_of_comp_eq {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (p : Ideal A) [p.IsPrime] {K : Type v} [Field K] [Algebra p.ResidueField K] {ψ : B →+* K}
    (hψA : ψ.comp (algebraMap A B) =
      (algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField)) :
    (RingHom.ker ψ).under A = p := by
  rw [Ideal.under_def, RingHom.comap_ker, hψA, ker_algebraMap_comp_algebraMap_residueField]

/-- The map `κ(ker ψ) → K` induced by `ψ : B →+* K` extends `ψ`. -/
theorem lift_kerLift_algebraMap {B : Type u} [CommRing B] {K : Type v} [Field K] (ψ : B →+* K)
    [(RingHom.ker ψ).IsPrime] (y : B) : (IsFractionRing.lift (RingHom.kerLift_injective ψ) :
      (RingHom.ker ψ).ResidueField →+* K) (algebraMap B (RingHom.ker ψ).ResidueField y) = ψ y := by
  rw [← Ideal.algebraMap_quotient_residueField_mk (RingHom.ker ψ) y]
  exact (IsFractionRing.lift_algebraMap _ _).trans (RingHom.kerLift_mk ψ y)

/-- If `ψ : B →+* K` restricts on `A` to `A → κ(p) → K` and its image contains a generator `β` of
`K` over `κ(p)`, then the induced map `κ(ker ψ) → K` is surjective. -/
theorem surjective_lift_kerLift_of_adjoin_eq_top {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (p : Ideal A) [p.IsPrime] {K : Type v} [Field K] [Algebra p.ResidueField K]
    (ψ : B →+* K) [(RingHom.ker ψ).IsPrime]
    (hψA : ψ.comp (algebraMap A B) =
      (algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField))
    {β : K} (hβ : IntermediateField.adjoin p.ResidueField {β} = ⊤) (hβψ : ∃ y, ψ y = β) :
    Function.Surjective
      (IsFractionRing.lift (RingHom.kerLift_injective ψ) :
        (RingHom.ker ψ).ResidueField →+* K) := by
  set e0 : (RingHom.ker ψ).ResidueField →+* K := IsFractionRing.lift (RingHom.kerLift_injective ψ)
  have he0 : ∀ y : B, e0 (algebraMap B (RingHom.ker ψ).ResidueField y) = ψ y :=
    lift_kerLift_algebraMap ψ
  have hqA := (under_ker_eq_of_comp_eq p hψA).symm
  have he0map : e0.comp (Ideal.ResidueField.map p (RingHom.ker ψ) (algebraMap A B) hqA) =
      algebraMap p.ResidueField K := by
    refine ringHom_ext_residueField p (RingHom.ext fun r => ?_)
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
      Ideal.ResidueField.map_algebraMap, he0, ← RingHom.comp_apply, hψA]
    rfl
  have hmemrange : ∀ x : p.ResidueField, algebraMap p.ResidueField K x ∈ e0.fieldRange :=
    fun x => ⟨_, by rw [← RingHom.comp_apply, he0map]⟩
  have hle : (⊤ : IntermediateField p.ResidueField K) ≤
      (e0.fieldRange).toIntermediateField hmemrange := by
    obtain ⟨y, hy⟩ := hβψ
    rw [← hβ, IntermediateField.adjoin_simple_le_iff]
    exact ⟨algebraMap B (RingHom.ker ψ).ResidueField y, (he0 y).trans hy⟩
  exact fun _ => RingHom.mem_fieldRange.mp (hle IntermediateField.mem_top)

/-- If `p` is contained in every prime of `A` and `f` is a monic lift of the minimal polynomial of
a generator `β` of `K` over `κ(p)`, then the nilradical of `A[x]/(f)` is the kernel of any
`A`-algebra map `A[x]/(f) → K`. -/
theorem nilradical_adjoinRoot_eq_ker {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime]
    (hp : ∀ q : Ideal A, q.IsPrime → p ≤ q) {K : Type u} [Field K] [Algebra p.ResidueField K]
    [Module.Finite p.ResidueField K] [Algebra A K] [IsScalarTower A p.ResidueField K]
    {f : A[X]} (hfmon : f.Monic) {β : K}
    (hfmap : f.map (algebraMap A p.ResidueField) = minpoly p.ResidueField β)
    (hβ : IntermediateField.adjoin p.ResidueField {β} = ⊤) (φ : AdjoinRoot f →ₐ[A] K) :
    nilradical (AdjoinRoot f) = RingHom.ker (φ : AdjoinRoot f →+* K) := by
  have _ : Module.Free A (AdjoinRoot f) := hfmon.free_adjoinRoot
  have _ : Module.Flat A (AdjoinRoot f) := Module.Flat.of_free
  have hq0prime : (RingHom.ker (φ : AdjoinRoot f →+* K)).IsPrime :=
    RingHom.ker_isPrime (φ : AdjoinRoot f →+* K)
  have hA : (φ : AdjoinRoot f →+* K).comp (algebraMap A (AdjoinRoot f)) =
      (algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField) :=
    RingHom.ext fun x => (φ.commutes x).trans (IsScalarTower.algebraMap_apply A p.ResidueField K x)
  exact nilradical_eq_of_flat_of_unique_prime_over p hp _ fun r hr hro =>
    eq_of_under_eq_of_field_fiber p (adjoinRootFiberAlgEquiv p hfmon hfmap hβ).toRingEquiv
      r _ hr hq0prime hro (under_ker_eq_of_comp_eq p hA)

/-- If the nilradical of `R` is the kernel of `R → B → K` for a localization `B` of `R`, then the
nilradical of `B` is the kernel of `B → K`. -/
theorem nilradical_eq_ker_of_isLocalization {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (M : Submonoid R) [IsLocalization M B] {K : Type v} [Field K] (ψ : B →+* K)
    (h : nilradical R = RingHom.ker (ψ.comp (algebraMap R B))) :
    nilradical B = RingHom.ker ψ := by
  have _ : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  refine nilradical_eq_of_le_primes _ fun J hJ => ?_
  have hJ' : (J.under R).IsPrime := Ideal.IsPrime.under _ J
  rw [← IsLocalization.map_under M B (RingHom.ker ψ), ← IsLocalization.map_under M B J]
  refine Ideal.map_mono ?_
  rw [Ideal.under_def, RingHom.comap_ker, ← h]
  exact nilradical_le_prime _

section Localization

variable {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime]
  (K : Type u) [Field K] [Algebra p.ResidueField K] [Module.Finite p.ResidueField K]
  {f : A[X]} (hfmon : f.Monic) (β : K)
  (hfmap : f.map (algebraMap A p.ResidueField) = minpoly p.ResidueField β)
  (hβ : IntermediateField.adjoin p.ResidueField {β} = ⊤)
  (a : A) (ha : a ∉ p)
  (hetaleAway : Algebra.Etale A (Localization.Away (algebraMap A (AdjoinRoot f) a)))
  (Rₐ Bₐ : Type u) [CommRing Rₐ] [CommRing Bₐ]
  [Algebra A Rₐ] [Algebra (AdjoinRoot f) Bₐ] [Algebra A Bₐ] [Algebra Rₐ Bₐ]
  [IsScalarTower A Rₐ Bₐ] [IsScalarTower A (AdjoinRoot f) Bₐ]
  [IsLocalization.Away a Rₐ]
  [IsLocalization (Algebra.algebraMapSubmonoid (AdjoinRoot f) (Submonoid.powers a)) Bₐ]

include hfmon hfmap hβ ha hetaleAway

/-- **The generic point and the residue field of `Spec (A[x]/(f))_a`.** Let `p` be a prime of `A`
contained in every prime of `A`, let `K` be a finite extension of `κ(p)` generated by `β`, let `f`
be a monic polynomial over `A` lifting the minimal polynomial of `β`, and let `a ∉ p`. Then the
localization `Bₐ` of `A[x]/(f)` at the image of the powers of `a` has a prime `q` which is its
nilradical — equivalently, `Spec Bₐ` is irreducible with generic point `q` — together with an
isomorphism `κ(q) ≃+* K` carrying the composite `A → Bₐ → κ(q)` to `A → κ(p) → K`.

The prime is the kernel of the map `ψ : Bₐ → K` sending `x` to `β`. It is the nilradical because
the fibre of `A[x]/(f)` at `p` is the field `K`, so `ker (A[x]/(f) → K)` is the only prime over
`p` and therefore, by flatness and going down, the nilradical of `A[x]/(f)`; contraction along
`A[x]/(f) → Bₐ` is injective on ideals, which transports the statement to `Bₐ`. The residue field
is `K` because `ψ` makes `κ(q)` a subfield of `K` containing both `κ(p)` and `β`. -/
theorem exists_finiteEtale_nilradical_eq_residueFieldEquiv_isLocalization_adjoinRoot
    (hp : ∀ q : Ideal A, q.IsPrime → p ≤ q) :
    ∃ (q : Ideal Bₐ) (_ : q.IsPrime) (_ : Module.Finite Rₐ Bₐ) (_ : Algebra.Etale Rₐ Bₐ)
      (_ : Function.Surjective (PrimeSpectrum.comap (algebraMap Rₐ Bₐ)))
      (ε : q.ResidueField ≃+* K),
      nilradical Bₐ = q ∧
        (ε : q.ResidueField →+* K).comp ((algebraMap Bₐ q.ResidueField).comp
            ((algebraMap Rₐ Bₐ).comp (algebraMap A Rₐ))) =
          (algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField) := by
  let _ : Algebra A K :=
    ((algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField)).toAlgebra
  have htower : IsScalarTower A p.ResidueField K := .of_algebraMap_eq' rfl
  have halgAK : (algebraMap A K : A →+* K) =
      (algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField) := rfl
  have hβ0 : f.eval₂ (Algebra.ofId A K : A →+* K) β = 0 := by
    simpa [Polynomial.aeval_def] using (show Polynomial.aeval β f = 0 by
      rw [← Polynomial.aeval_map_algebraMap p.ResidueField β f, hfmap, minpoly.aeval])
  -- The `A`-algebra map `A[x]/(f) → K` sending the root to `β`, and its extension to `Bₐ`.
  let φ : AdjoinRoot f →ₐ[A] K := AdjoinRoot.liftAlgHom f (Algebra.ofId A K) β hβ0
  have hunit : IsUnit ((φ : AdjoinRoot f →+* K) (algebraMap A (AdjoinRoot f) a)) := by
    rw [show ((φ : AdjoinRoot f →+* K)) (algebraMap A (AdjoinRoot f) a) = algebraMap A K a from
      φ.commutes a, isUnit_iff_ne_zero, halgAK, RingHom.comp_apply,
      map_ne_zero_iff _ (algebraMap p.ResidueField K).injective]
    simpa [Ideal.algebraMap_residueField_eq_zero] using ha
  have hawayB : IsLocalization.Away (algebraMap A (AdjoinRoot f) a) Bₐ := by
    change IsLocalization (Submonoid.powers (algebraMap A (AdjoinRoot f) a)) Bₐ
    rw [← Algebra.algebraMapSubmonoid_powers]
    infer_instance
  let ψ : Bₐ →+* K :=
    IsLocalization.Away.lift (g := (φ : AdjoinRoot f →+* K)) (algebraMap A (AdjoinRoot f) a) hunit
  have hψB : ψ.comp (algebraMap (AdjoinRoot f) Bₐ) = (φ : AdjoinRoot f →+* K) :=
    IsLocalization.Away.lift_comp _ hunit
  have hψA : ψ.comp (algebraMap A Bₐ) = (algebraMap A K : A →+* K) := by
    rw [IsScalarTower.algebraMap_eq A (AdjoinRoot f) Bₐ, ← RingHom.comp_assoc, hψB]
    exact RingHom.ext φ.commutes
  have hqprime : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  have hnt : Nontrivial Bₐ := ψ.domain_nontrivial
  -- `ker φ` is the nilradical of `A[x]/(f)`: the fibre at `p` is the field `K`.
  -- Hence `ker ψ` is the nilradical of `Bₐ`.
  have hnil : nilradical Bₐ = RingHom.ker ψ :=
    nilradical_eq_ker_of_isLocalization
      (Algebra.algebraMapSubmonoid (AdjoinRoot f) (Submonoid.powers a)) ψ
      ((nilradical_adjoinRoot_eq_ker p hp hfmon hfmap hβ φ).trans (by rw [hψB]))
  -- The residue field at `ker ψ` is `K`.
  let e0 : (RingHom.ker ψ).ResidueField →+* K := IsFractionRing.lift (RingHom.kerLift_injective ψ)
  have he0 : ∀ y : Bₐ, e0 (algebraMap Bₐ (RingHom.ker ψ).ResidueField y) = ψ y :=
    lift_kerLift_algebraMap ψ
  have hsurj : Function.Surjective e0 :=
    surjective_lift_kerLift_of_adjoin_eq_top p ψ hψA hβ
      ⟨algebraMap (AdjoinRoot f) Bₐ (AdjoinRoot.root f), (RingHom.congr_fun hψB _).trans
        (AdjoinRoot.liftAlgHom_root f (Algebra.ofId A K) β hβ0)⟩
  refine ⟨RingHom.ker ψ, hqprime, finite_isLocalization_adjoinRoot a Rₐ Bₐ hfmon,
    etale_isLocalization_adjoinRoot a Rₐ Bₐ hetaleAway,
    comap_surjective_isLocalization_adjoinRoot a Rₐ Bₐ hfmon,
    RingEquiv.ofBijective e0 ⟨e0.injective, hsurj⟩, hnil, ?_⟩
  change e0.comp _ = _
  refine RingHom.ext fun r => ?_
  rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
    ← IsScalarTower.algebraMap_apply A Rₐ Bₐ, he0, ← RingHom.comp_apply, hψA, halgAK]

end Localization

/-- **The ring-theoretic content of Tag 0551.** Let `p` be a prime of `A` contained in every prime
of `A` — the unique minimal prime — and let `K` be a finite separable extension of `κ(p)`. Then
there is an element `a ∉ p` such that for *every* localization `Rₐ` of `A` away from `a` there is
an `Rₐ`-algebra `Bₐ` with:

* `Bₐ` finite and étale over `Rₐ`, with `Spec Bₐ → Spec Rₐ` surjective;
* a prime `q` of `Bₐ` which is the nilradical, so that `Spec Bₐ` is irreducible with generic
  point `q`;
* an isomorphism `κ(q) ≃+* K` carrying the composite `A → Bₐ → κ(q)` to `A → κ(p) → K`.

The quantification over all localizations `Rₐ` is what lets the geometric argument take `Rₐ` to be
the sections of a basic open of an affine chart, with no comparison isomorphism. -/
theorem exists_notMem_forall_isLocalization_finiteEtale {A : Type u} [CommRing A] (p : Ideal A)
    [p.IsPrime] (hp : ∀ q : Ideal A, q.IsPrime → p ≤ q) (K : Type u) [Field K]
    [Algebra p.ResidueField K] [Module.Finite p.ResidueField K]
    [Algebra.IsSeparable p.ResidueField K] :
    ∃ a ∉ p, ∀ (Rₐ : Type u) [CommRing Rₐ] [Algebra A Rₐ] [IsLocalization.Away a Rₐ],
      ∃ (Bₐ : Type u) (_ : CommRing Bₐ) (_ : Algebra Rₐ Bₐ) (q : Ideal Bₐ) (_ : q.IsPrime)
        (_ : Module.Finite Rₐ Bₐ) (_ : Algebra.Etale Rₐ Bₐ)
        (_ : Function.Surjective (PrimeSpectrum.comap (algebraMap Rₐ Bₐ)))
        (ε : q.ResidueField ≃+* K),
        nilradical Bₐ = q ∧
          (ε : q.ResidueField →+* K).comp ((algebraMap Bₐ q.ResidueField).comp
              ((algebraMap Rₐ Bₐ).comp (algebraMap A Rₐ))) =
            (algebraMap p.ResidueField K).comp (algebraMap A p.ResidueField) := by
  obtain ⟨f, β, a, hfmon, hfmap, hβ, ha, hetaleAway⟩ :=
    exists_monic_notMem_etale_localizationAway_residueField p K
  refine ⟨a, ha, fun Rₐ _ _ _ => ?_⟩
  let _ : Algebra Rₐ
      (Localization (Algebra.algebraMapSubmonoid (AdjoinRoot f) (Submonoid.powers a))) :=
    localizationAlgebra (Submonoid.powers a) (AdjoinRoot f)
  have _ : IsScalarTower A Rₐ
      (Localization (Algebra.algebraMapSubmonoid (AdjoinRoot f) (Submonoid.powers a))) :=
    isScalarTower_localizationAlgebra (Submonoid.powers a) (AdjoinRoot f)
  exact ⟨_, inferInstance, inferInstance,
    exists_finiteEtale_nilradical_eq_residueFieldEquiv_isLocalization_adjoinRoot p K hfmon β
      hfmap hβ a ha hetaleAway Rₐ
      (Localization (Algebra.algebraMapSubmonoid (AdjoinRoot f) (Submonoid.powers a))) hp⟩

end Stacks.GeometricComponents

namespace AlgebraicGeometry

/-- **The residue field map of `Spec.map φ`.** Read through
`AlgebraicGeometry.Scheme.Spec.residueFieldIso`, the map of residue fields induced by `Spec.map φ`
at a prime `q` is the one induced by `φ` itself: precomposing it with `R → κ(z)`, where `z` is the
contraction of `q`, gives `φ` followed by `S → κ(q)`.

The image point `z` is passed as a separate argument together with the equation naming it, so that
the equation can be `subst`ed before any rewriting; `((Spec.map φ) q).asIdeal` does not even
elaborate its `Ideal.IsPrime` instance, since instance search does not see through the carrier of
`Spec`. -/
theorem algebraMap_Spec_map_residueFieldMap {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (q : PrimeSpectrum S) (z : PrimeSpectrum R) (hz : (Spec.map φ) q = z) :
    CommRingCat.ofHom (algebraMap R z.asIdeal.ResidueField) ≫
        (Scheme.Spec.residueFieldIso R z).inv ≫ ((Spec R).residueFieldCongr hz).inv ≫
          (Spec.map φ).residueFieldMap q ≫ (Scheme.Spec.residueFieldIso S q).hom =
      φ ≫ CommRingCat.ofHom (algebraMap S q.asIdeal.ResidueField) := by
  subst hz
  rw [Scheme.residueFieldCongr_refl, Iso.refl_inv, Category.id_comp, ← Category.assoc,
    show _ = (Scheme.ΓSpecIso R).inv ≫ (Spec R).Γevaluation _ from
      Scheme.Spec.algebraMap_residueFieldIso_inv R ((Spec.map φ) q), Category.assoc,
    ← Category.assoc _ _ (Scheme.Spec.residueFieldIso S q).hom,
    Scheme.Γevaluation_naturality (Spec.map φ) q, Category.assoc, ← Category.assoc,
    ← Scheme.ΓSpecIso_inv_naturality φ, Category.assoc]
  congr 1
  rw [← Category.assoc, ← show _ = (Scheme.ΓSpecIso S).inv ≫ (Spec S).Γevaluation _ from
      Scheme.Spec.algebraMap_residueFieldIso_inv S q, Category.assoc, Iso.inv_hom_id,
    Category.comp_id]

/-- Restriction of sections followed by evaluation at a point is evaluation at that point. -/
@[reassoc]
theorem evaluation_res {X : Scheme.{u}} {V U : X.Opens} (i : V ⟶ U) {x : X} (hx : x ∈ V) :
    X.presheaf.map i.op ≫ X.evaluation V x hx = X.evaluation U x (i.le hx) := by
  rw [Scheme.evaluation, Scheme.evaluation, ← Category.assoc, X.presheaf.germ_res]

/-- **A ring map out of a residue field is determined on an affine chart.** If `U` is an open of
`Y` containing `x` and the residue field at `x` is identified with the residue field of a prime
`p` of `Γ(Y, U)` compatibly with evaluation of sections, then two ring maps out of `Y.residueField
x` which agree after evaluation on `U` are equal: `κ(p)` is generated as a field by the image of
`Γ(Y, U)`. -/
theorem residueField_hom_ext_of_evaluation {Y : Scheme.{u}} {U : Y.Opens} {x : Y} (hx : x ∈ U)
    (p : Ideal Γ(Y, U)) [p.IsPrime] {T : CommRingCat.{u}}
    (e : Y.residueField x ≅ CommRingCat.of p.ResidueField)
    (heval : Y.evaluation U x hx ≫ e.hom = CommRingCat.ofHom (algebraMap Γ(Y, U) p.ResidueField))
    {u v : Y.residueField x ⟶ T} (huv : Y.evaluation U x hx ≫ u = Y.evaluation U x hx ≫ v) :
    u = v := by
  have hev : CommRingCat.ofHom (algebraMap Γ(Y, U) p.ResidueField) ≫ e.inv =
      Y.evaluation U x hx := by
    rw [← heval, Category.assoc, e.hom_inv_id, Category.comp_id]
  have h2 : CommRingCat.ofHom (algebraMap Γ(Y, U) p.ResidueField) ≫ e.inv ≫ u =
      CommRingCat.ofHom (algebraMap Γ(Y, U) p.ResidueField) ≫ e.inv ≫ v := by
    rw [← Category.assoc, ← Category.assoc, hev, huv]
  refine (cancel_epi e.inv).mp (CommRingCat.hom_ext
    (Stacks.GeometricComponents.ringHom_ext_residueField p ?_))
  simpa [CommRingCat.hom_comp] using congrArg CommRingCat.Hom.hom h2

/-- **The residue field map of `Spec.map φ ≫ hV.fromSpec`, read on sections over `V`.** For `V` an
affine open of `Y`, `φ : Γ(Y, V) ⟶ B` and a prime `η'` of `B` lying over the prime `z` of
`Γ(Y, V)`, evaluating a section over `V` at the image point `x` of `η'` and then mapping to the
residue field of `η'` is the same as applying `φ` and passing to the residue field of `η'`.

This is the computation of the residue field map of the cover in Tag 0551. It is assembled from
`AlgebraicGeometry.IsAffineOpen.evaluation_residueFieldIso_hom` for the `fromSpec` factor and
`AlgebraicGeometry.algebraMap_Spec_map_residueFieldMap` for the `Spec.map` factor, glued by
`AlgebraicGeometry.Scheme.Hom.residueFieldMap_congr'` along `hz`. -/
theorem evaluation_residueFieldMap_fromSpec_SpecMap {Y : Scheme.{u}} {V : Y.Opens}
    (hV : IsAffineOpen V) {B : CommRingCat.{u}} (φ : Γ(Y, V) ⟶ B) (η' : PrimeSpectrum B)
    (z : PrimeSpectrum Γ(Y, V)) (hz : (Spec.map φ) η' = z)
    (x : Y) (hx : hV.fromSpec ((Spec.map φ) η') = x) (hxV : x ∈ V) :
    Y.evaluation V x hxV ≫ (Y.residueFieldCongr hx).inv ≫
        (Spec.map φ ≫ hV.fromSpec).residueFieldMap η' ≫
          (Scheme.Spec.residueFieldIso B η').hom =
      φ ≫ CommRingCat.ofHom (algebraMap B η'.asIdeal.ResidueField) := by
  have hzV : hV.fromSpec z ∈ V := by rwa [← hz, hx]
  have hstar := hV.evaluation_residueFieldIso_hom z hzV
  rw [IsAffineOpen.residueFieldIso, Iso.trans_hom, asIso_hom] at hstar
  have hstar' : Y.evaluation V (hV.fromSpec z) hzV ≫ hV.fromSpec.residueFieldMap z =
      CommRingCat.ofHom (algebraMap Γ(Y, V) z.asIdeal.ResidueField) ≫
        (Scheme.Spec.residueFieldIso Γ(Y, V) z).inv := by
    rw [← hstar, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hins : hV.fromSpec.residueFieldMap ((Spec.map φ) η') =
      (hV.fromSpec.residueFieldMap ((Spec.map φ) η') ≫
          ((Spec Γ(Y, V)).residueFieldCongr hz).hom) ≫
        ((Spec Γ(Y, V)).residueFieldCongr hz).inv := by
    rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  rw [Scheme.residueFieldCongr_inv, ← Category.assoc, evaluation_residueFieldCongr,
    Scheme.residueFieldMap_comp (f := Spec.map φ) hV.fromSpec η', hins,
    Scheme.Hom.residueFieldMap_congr' (f := hV.fromSpec) hz]
  simp only [Category.assoc]
  rw [← Category.assoc, evaluation_residueFieldCongr, ← Category.assoc, hstar', Category.assoc,
    algebraMap_Spec_map_residueFieldMap φ η' z hz]

/-- `AlgebraicGeometry.evaluation_residueFieldMap_fromSpec_SpecMap` for a morphism presented in
any spelling, which is what lets it be applied to `(g ≫ hV.isoSpec.inv) ≫ V.ι`. -/
theorem evaluation_residueFieldMap_eq_of_eq_fromSpec_SpecMap {Y : Scheme.{u}} {V : Y.Opens}
    (hV : IsAffineOpen V) {B : CommRingCat.{u}} (φ : Γ(Y, V) ⟶ B) (η' : PrimeSpectrum B)
    (z : PrimeSpectrum Γ(Y, V)) (hz : (Spec.map φ) η' = z) (G : Spec B ⟶ Y)
    (hG : G = Spec.map φ ≫ hV.fromSpec) (x : Y) (hx : G η' = x) (hxV : x ∈ V) :
    Y.evaluation V x hxV ≫ (Y.residueFieldCongr hx).inv ≫ G.residueFieldMap η' ≫
        (Scheme.Spec.residueFieldIso B η').hom =
      φ ≫ CommRingCat.ofHom (algebraMap B η'.asIdeal.ResidueField) := by
  subst hG
  exact evaluation_residueFieldMap_fromSpec_SpecMap hV φ η' z hz x hx hxV

/-- The image of a generic point of the whole space under a surjective morphism is a generic point
of the whole space. -/
theorem isGenericPoint_image_of_surjective {X Y : Scheme.{u}} (g : X ⟶ Y) [Surjective g] {x : X}
    (hx : IsGenericPoint x Set.univ) : IsGenericPoint (g x) Set.univ := by
  simpa [Set.image_univ_of_surjective g.surjective] using hx.image g.continuous

/-- A surjection onto an open `V` of an irreducible scheme containing the generic point maps a
generic point of the whole space to the generic point. -/
theorem comp_ι_apply_eq_genericPoint {X Y : Scheme.{u}} [IrreducibleSpace Y] {V : Y.Opens}
    (hV : genericPoint Y ∈ V) (g : X ⟶ V.toScheme) [Surjective g] {x : X}
    (hx : IsGenericPoint x Set.univ) : (g ≫ V.ι) x = genericPoint Y := by
  have : IrreducibleSpace V.toScheme :=
    Subtype.irreducibleSpace ⟨⟨_, hV⟩,
      (IrreducibleSpace.isIrreducible_univ Y).isPreirreducible.open_subset
        V.isOpen (Set.subset_univ _)⟩
  exact (congrArg (fun t => V.ι t)
      ((isGenericPoint_image_of_surjective g hx).eq (genericPoint_spec V.toScheme))).trans
    (genericPoint_eq_of_isOpenImmersion V.ι)

/-- If the residue field at `x ∈ U` is identified with `κ(p)` for a prime `p` of `Γ(Y, U)`,
compatibly with evaluation, then `x` lies in the basic open of every section outside `p`. -/
theorem mem_basicOpen_of_notMem_of_evaluation {Y : Scheme.{u}} {U : Y.Opens} {x : Y} (hx : x ∈ U)
    (p : Ideal Γ(Y, U)) [p.IsPrime] (e : Y.residueField x ≅ CommRingCat.of p.ResidueField)
    (heval : Y.evaluation U x hx ≫ e.hom = CommRingCat.ofHom (algebraMap Γ(Y, U) p.ResidueField))
    {a : Γ(Y, U)} (ha : a ∉ p) : x ∈ Y.basicOpen a := by
  refine (Y.evaluation_ne_zero_iff_mem_basicOpen x hx a).mp fun h0 => ha ?_
  have h := ConcreteCategory.congr_hom heval a
  rw [CommRingCat.comp_apply, h0, map_zero] at h
  exact Ideal.algebraMap_residueField_eq_zero.mp h.symm

/-- A finite separable extension of `k` is a finite separable extension of any field `F`
isomorphic to `k`, for the induced algebra structure. -/
theorem finite_isSeparable_of_ringEquiv {k F K : Type*} [Field k] [Field F] [Field K]
    [Algebra k K] [Module.Finite k K] [Algebra.IsSeparable k K] [Algebra F K] (e : k ≃+* F)
    (halg : algebraMap F K = (algebraMap k K).comp e.symm.toRingHom) :
    Module.Finite F K ∧ Algebra.IsSeparable F K := by
  let _ : Algebra F k := e.symm.toRingHom.toAlgebra
  have _ : IsScalarTower F k K := .of_algebraMap_eq' halg
  have _ : Module.Finite F k :=
    Module.Finite.of_surjective (Algebra.linearMap _ _) e.symm.surjective
  exact ⟨Module.Finite.trans k K, Algebra.IsSeparable.of_equiv_equiv e (RingEquiv.refl K)
    (RingHom.ext fun y => by simp [halg])⟩

/-- `Spec` of a finite étale algebra which is surjective on spectra is finite, étale and
surjective. -/
theorem isFinite_etale_surjective_SpecMap_algebraMap {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] [Module.Finite R B] [Algebra.Etale R B]
    (hs : Function.Surjective (PrimeSpectrum.comap (algebraMap R B))) :
    IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R B))) ∧
      Etale (Spec.map (CommRingCat.ofHom (algebraMap R B))) ∧
        Surjective (Spec.map (CommRingCat.ofHom (algebraMap R B))) := by
  refine ⟨?_, ?_, ⟨hs⟩⟩
  · rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
    exact RingHom.finite_algebraMap.mpr ‹_›
  · rw [HasRingHomProperty.Spec_iff (P := @Etale), CommRingCat.hom_ofHom]
    exact RingHom.etale_algebraMap.mpr ‹_›

/-- **The `Y`-half of Tag 0551.** Every irreducible scheme spreads a finite separable extension of
the residue field at its generic point out to a surjective finite étale cover of a nonempty open
by an irreducible affine scheme.

The cover is `Spec Bₐ ⟶ D(a) ⊆ Y` for an affine chart `U = Spec A` through the generic point and
the data `a`, `Bₐ` supplied by
`Stacks.GeometricComponents.exists_notMem_forall_isLocalization_finiteEtale`, with
`Rₐ = Γ(Y, D(a))` — which is a localization of `A` away from `a` by
`AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen`, so that no comparison isomorphism of
rings appears anywhere. -/
theorem spreadsOutFiniteSeparableResidueExtension (Y : Scheme.{u}) [IrreducibleSpace Y] :
    SpreadsOutFiniteSeparableResidueExtension Y := by
  intro K hKfield hKalg hKfin hKsep
  obtain ⟨U, hU, hηU, p, e, hfp, hmin, heval⟩ :=
    exists_affineOpen_mem_genericPoint_residueFieldIso Y
  -- Transport the extension structure on `K` from `κ(η)` to `κ(p)` along `e`.
  let _ : Algebra p.asIdeal.ResidueField K :=
    ((algebraMap (Y.residueField (genericPoint Y)) K).comp e.inv.hom).toAlgebra
  have halgK : (algebraMap p.asIdeal.ResidueField K : _ →+* K) =
      (algebraMap (Y.residueField (genericPoint Y)) K).comp e.inv.hom := rfl
  obtain ⟨_, _⟩ := finite_isSeparable_of_ringEquiv e.commRingCatIsoToRingEquiv halgK
  -- The ring-theoretic input.
  obtain ⟨a, ha, hall⟩ :=
    Stacks.GeometricComponents.exists_notMem_forall_isLocalization_finiteEtale p.asIdeal
      (fun r hr => hmin ⟨r, hr⟩) K
  have hV : IsAffineOpen (Y.basicOpen a) := hU.basicOpen a
  have hloc : IsLocalization.Away a Γ(Y, Y.basicOpen a) := hU.isLocalization_basicOpen a
  have hηV : genericPoint Y ∈ Y.basicOpen a :=
    mem_basicOpen_of_notMem_of_evaluation hηU p.asIdeal e heval ha
  obtain ⟨B, _, _, q, hq, hfin, het, hsurjc, ε, hnil, hcompat⟩ := hall Γ(Y, Y.basicOpen a)
  -- The cover.
  obtain ⟨_, _, _⟩ := isFinite_etale_surjective_SpecMap_algebraMap hsurjc
  have hirrB : IrreducibleSpace (PrimeSpectrum B) := by
    rwa [PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical, hnil]
  have hgenq : IsGenericPoint (⟨q, hq⟩ : PrimeSpectrum B) Set.univ := by
    rw [IsGenericPoint, PrimeSpectrum.closure_singleton, PrimeSpectrum.zeroLocus_eq_univ_iff]
    exact hnil.ge
  -- The generic point of the cover lies over the generic point of `Y`.
  have hgenPt : ((Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, Y.basicOpen a) B)) ≫
      hV.isoSpec.inv) ≫ (Y.basicOpen a).ι) (⟨q, hq⟩ : PrimeSpectrum B) = genericPoint Y :=
    comp_ι_apply_eq_genericPoint hηV _ hgenq
  -- The residue field identification.
  have hkey := evaluation_residueFieldMap_eq_of_eq_fromSpec_SpecMap hV
    (CommRingCat.ofHom (algebraMap Γ(Y, Y.basicOpen a) B)) (⟨q, hq⟩ : PrimeSpectrum B) _ rfl _
    (by rw [Category.assoc, IsAffineOpen.isoSpec_inv_ι]) (genericPoint Y) hgenPt hηV
  refine ⟨Y.basicOpen a, ⟨genericPoint Y, hηV⟩, Spec (CommRingCat.of B),
    Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, Y.basicOpen a) B)) ≫ hV.isoSpec.inv,
    inferInstance, inferInstance, inferInstance, hirrB, inferInstance,
    (⟨q, hq⟩ : PrimeSpectrum B), hgenq, hgenPt,
    (Scheme.Spec.residueFieldIso (CommRingCat.of B) (⟨q, hq⟩ : PrimeSpectrum B)).trans
      ε.toCommRingCatIso, ?_⟩
  refine residueField_hom_ext_of_evaluation hηU p.asIdeal e heval ?_
  have hkeyres := Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op ≫= hkey
  simp only [← Category.assoc] at hkeyres
  rw [evaluation_res (X := Y) (homOfLE (Y.basicOpen_le a)) hηV] at hkeyres
  have hRHS : CommRingCat.ofHom (algebraMap (Y.residueField (genericPoint Y)) K) =
      e.hom ≫ CommRingCat.ofHom (algebraMap p.asIdeal.ResidueField K) :=
    CommRingCat.hom_ext (RingHom.ext fun y => (congrArg (algebraMap _ K)
      (ConcreteCategory.congr_hom e.hom_inv_id y)).symm)
  simp only [Iso.trans_hom, ← Category.assoc]
  rw [hkeyres, hRHS, ← Category.assoc, heval]
  exact CommRingCat.hom_ext (RingHom.ext fun r => RingHom.congr_fun hcompat r)

