module

public import StacksFrontier.RingTheory.Flat.LocalCriteria
public import StacksCore.Tactic.StacksAttribute

/-!
# Flatness after quotienting by a fibrewise regular element

Let `R → S` be a local homomorphism of local rings with `S` Noetherian. If a finite `S`-module
`M` is flat over `R` and multiplication by `f ∈ S` is injective on its closed fibre, then
`M / fM` is flat over `R`.

## Main results

* `Module.flat_quotient_smul_of_isSMulRegular_maximalIdeal` proves flatness of the quotient by
  the submodule generated by `fM`.

## Implementation notes

The closed fibre is the quotient of `M` by the action of the extension of the maximal ideal of
`R` to `S`. The quotient `M / fM` is expressed using the action of `Ideal.span {f}`. The
hypotheses that `R` is Noetherian and that `f` lies in the maximal ideal of `S` are unnecessary
for the flatness conclusion.

## References

* [Stacks Project, Tag 0252](https://stacks.math.columbia.edu/tag/0252)
-/

@[expose] public section

namespace Module

open IsLocalRing Module.Flat

/-- Restricting scalars along a tower identifies the range of multiplication by `f` with the
submodule generated by the ideal `Ideal.span {f}`. -/
private lemma range_restrictScalars_lsmul {R S M : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] (f : S) :
    LinearMap.range ((LinearMap.lsmul S M f).restrictScalars R) =
      Submodule.restrictScalars R (Ideal.span {f} • (⊤ : Submodule S M)) := by
  rw [LinearMap.range_restrictScalars, Submodule.ideal_span_singleton_smul,
    Submodule.pointwise_smul_def, ← LinearMap.range_eq_map]; rfl

/-- **Stacks Project, Tag 0252.** A finite module flat over the base remains flat after
quotienting by an element that acts injectively on its closed fibre. -/
@[stacks 0252]
theorem flat_quotient_smul_of_isSMulRegular_maximalIdeal
    {R S M : Type*} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    [Algebra R S] [IsLocalHom (algebraMap R S)] [IsNoetherianRing S]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
    [Module.Finite S M] [Module.Flat R M] {f : S}
    (hf : IsSMulRegular
      (M ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S M))) f) :
    Module.Flat R (M ⧸ (Ideal.span {f} • (⊤ : Submodule S M))) := by
  have hres :
      (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S M)).restrictScalars R =
        maximalIdeal R • (⊤ : Submodule R M) := by
    rw [Ideal.smul_restrictScalars, Submodule.restrictScalars_top]
  have hcomap :
      Submodule.comap ((LinearMap.lsmul S M f).restrictScalars R)
          (maximalIdeal R • (⊤ : Submodule R M)) ≤
        maximalIdeal R • (⊤ : Submodule R M) := by
    intro m hm; rw [← hres] at hm ⊢
    exact mem_of_isSMulRegular_quotient_of_smul_mem hf hm
  obtain ⟨_, hflat⟩ :=
    injective_and_flat_quotient_range_of_injective_mapQ_maximalIdeal_of_isNoetherianRing
      (S := S) (N := M) ((LinearMap.lsmul S M f).restrictScalars R)
      ((Stacks.Flatness.FibreNonZeroDivisor.mapQ_injective_iff _).2 hcomap)
  exact Module.Flat.of_linearEquiv
    (Submodule.quotEquivOfEq _ _ (range_restrictScalars_lsmul f)).symm

end Module
