module

public import Mathlib.CategoryTheory.Sites.Equivalence
public import Mathlib.CategoryTheory.Sites.InducedTopology
public import Mathlib.CategoryTheory.Sites.Over
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Precoverage

/-!
# The small étale site of an étale scheme is a localization

Let `B` be a big étale site containing a scheme `X`, and let `U` be an object of the small
étale site of `X`, that is, a scheme of `B` whose structure morphism to `X` is étale. This
file identifies the small étale site of `U` with the localization of the small étale site of
`X` at `U`.

## Main definitions

* `AlgebraicGeometry.SmallEtale.postcompose` — post-composition with the structure morphism
  of `U`, as a functor from the small étale site of `U` to the small étale site of `X`.
* `AlgebraicGeometry.SmallEtale.localizationObj` — the object of the slice at `U`
  corresponding to an object of the small étale site of `U`.
* `AlgebraicGeometry.SmallEtale.localizationEquivalence` — the canonical equivalence between
  the small étale site of `U` and the slice of the small étale site of `X` at `U`.

## Main results

* `AlgebraicGeometry.SmallEtale.localizationEquivalence_obj` and
  `AlgebraicGeometry.SmallEtale.localizationEquivalence_map` pin the equivalence down by its
  action on objects and on morphisms.
* `AlgebraicGeometry.SmallEtale.localizationEquivalence_topology` identifies the étale
  topology of `U` with the topology induced from the slice topology at `U`.
* `AlgebraicGeometry.SmallEtale.localizationEquivalence_restriction` identifies the
  equivalence followed by the slice projection with post-composition.

## Implementation notes

Post-composition lands in the small étale site of `X` because étale morphisms compose, and
its essential surjectivity onto the slice is the converse: a scheme étale over `X` with a
morphism to `U` is étale over `U`, by `CategoryTheory.MorphismProperty.of_postcomp` applied
to the étale structure morphism of `U`. The two functors are therefore mutually inverse, not
merely adjoint, and both unit and counit are built from identity morphisms of the underlying
schemes.

Both small étale topologies are generated by precoverages which are stable under base change and
composition and contain the isomorphisms — this is
`AlgebraicGeometry.smallEtale_precoverage_eq_comap` and the instances derived from it — so a
covering sieve of either is generated by a covering family, and cover preservation in both
directions is checked on such a family. Cocontinuity of the two functors then exhibits the
equivalence as a dense subsite, whose topology is the induced one.

The same statement one level up, for an étale scheme chart of an algebraic space, is Stacks
04M0, `AlgebraicGeometry.Space.smallEtaleEquivalenceOverChart`.

Post-composition and the object assignment are definitional. The inverse functor, and hence
the equivalence, is noncomputable because `CategoryTheory.MorphismProperty.of_postcomp`
provides no data.

## References

* [Stacks Project, Étale Cohomology, localization of the small étale site]
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

namespace SmallEtale

variable (B : BigEtaleSite.{u}) (X : Scheme.{u}) (hX : B.Contains X)
  (U : SmallEtale B X hX)

/-- Post-composition with the structure morphism of `U`, as a functor from the small étale
site of `U` to the small étale site of `X`. It lands in the small étale site of `X` because
étale morphisms compose. -/
public def postcompose :
    SmallEtale B U.obj.left.obj U.obj.left.property ⥤ SmallEtale B X hX :=
  (BigEtaleOver.IsEtaleOver B X hX).lift
    (SmallEtale.inclusion B U.obj.left.obj U.obj.left.property ⋙ Over.map U.obj.hom)
    (fun V => by
      change Etale (B.inclusion.map (V.obj.hom ≫ U.obj.hom))
      rw [Functor.map_comp]
      infer_instance)

/-- The object of the slice of the small étale site of `X` at `U` corresponding to an object
`V` of the small étale site of `U`: the composite structure morphism `V ⟶ U ⟶ X` makes `V`
étale over `X`, and the original morphism `V ⟶ U` is its arrow to `U`. -/
public def localizationObj (V : SmallEtale B U.obj.left.obj U.obj.left.property) : Over U :=
  Over.mk (ObjectProperty.homMk (Over.homMk V.obj.hom rfl) :
    (postcompose B X hX U).obj V ⟶ U)

/-- The small étale site of `U`, mapped into the slice of the small étale site of `X` at `U`
by post-composition, remembering the original structure morphism as the arrow to `U`. -/
public def localization :
    SmallEtale B U.obj.left.obj U.obj.left.property ⥤ Over U :=
  Over.lift (postcompose B X hX U)
    { app := fun V => ObjectProperty.homMk (Over.homMk V.obj.hom rfl)
      naturality := fun V W f => by
        ext
        exact congrArg (fun g => g.hom) f.hom.w }

/-- The inverse of `AlgebraicGeometry.SmallEtale.localization`: a scheme étale over `X`
together with a morphism to `U` is étale over `U`, because the structure morphism of `U` is
étale. -/
public noncomputable def localizationInverse :
    Over U ⥤ SmallEtale B U.obj.left.obj U.obj.left.property :=
  (BigEtaleOver.IsEtaleOver B U.obj.left.obj U.obj.left.property).lift
    (Over.post (X := U) (SmallEtale.inclusion B X hX ⋙ BigEtaleOver.forget B X hX))
    (fun V => by
      have hU : Etale (B.inclusion.map U.obj.hom) := U.property
      have hw : (V.hom.hom).left ≫ U.obj.hom = V.left.obj.hom := V.hom.hom.w
      have hcomp : Etale (B.inclusion.map ((V.hom.hom).left ≫ U.obj.hom)) := by
        rw [hw]
        exact V.left.property
      exact MorphismProperty.of_postcomp _ _ (B.inclusion.map U.obj.hom) hU
        (by rw [Functor.map_comp] at hcomp; exact hcomp))

/-- The small étale site of `U` is the localization of the small étale site of `X` at `U`:
post-composition with the structure morphism of `U` is an equivalence onto the
slice at `U`. -/
public noncomputable def localizationEquivalence :
    SmallEtale B U.obj.left.obj U.obj.left.property ≌ Over U where
  functor := localization B X hX U
  inverse := localizationInverse B X hX U
  unitIso := NatIso.ofComponents fun V =>
    ObjectProperty.isoMk (BigEtaleOver.IsEtaleOver B U.obj.left.obj U.obj.left.property)
      (Over.isoMk (Iso.refl V.obj.left) rfl)
  counitIso := NatIso.ofComponents fun V =>
    Over.isoMk
      (ObjectProperty.isoMk (BigEtaleOver.IsEtaleOver B X hX)
        (Over.isoMk (Iso.refl V.left.obj.left) (by
          change 𝟙 V.left.obj.left ≫ V.left.obj.hom = V.hom.hom.left ≫ U.obj.hom
          simp)))
      (by ext; rfl)
  functor_unitIso_comp V := by ext; rfl

/-- The equivalence sends `V` to the composite `V ⟶ U ⟶ X` carrying its original arrow
to `U`. -/
public theorem localizationEquivalence_obj
    (V : SmallEtale B U.obj.left.obj U.obj.left.property) :
    (localizationEquivalence B X hX U).functor.obj V = localizationObj B X hX U V :=
  rfl

/-- On morphisms the equivalence retains the original morphism of schemes. -/
public theorem localizationEquivalence_map
    {V W : SmallEtale B U.obj.left.obj U.obj.left.property} (f : V ⟶ W) :
    HEq ((localizationEquivalence B X hX U).functor.map f).left.hom.left f.hom.left :=
  HEq.rfl

/-- Composing the equivalence with the slice projection is post-composition with the
structure morphism of `U`. The equality holds in the small étale site of `X`, before
forgetting to schemes. -/
public theorem localizationEquivalence_restriction :
    (localizationEquivalence B X hX U).functor ⋙ Over.forget U = postcompose B X hX U :=
  rfl

/-- The sieve generated by a covering family of the small étale site of `S` is covering. -/
private theorem generate_presieve₀_mem_topology {S : Scheme.{u}} {hS : B.Contains S}
    {Y : SmallEtale B S hS} (E : PreZeroHypercover.{u + 1} Y)
    (hE : SmallEtale.IsCovering B S hS ⟨Y, E⟩) :
    Sieve.generate E.presieve₀ ∈ SmallEtale.topology B S hS Y :=
  Precoverage.generate_mem_toGrothendieck
    ((SmallEtale.mem_precoverage_iff B S hS).2 ⟨E, rfl, hE⟩)

/-- The equivalence preserves covering sieves: a covering family of the small étale site of
`U` is, after post-composition, a covering family of the small étale site of `X`, hence
generates a covering sieve of the slice at `U`. -/
private theorem localization_coverPreserving :
    CoverPreserving (SmallEtale.topology B U.obj.left.obj U.obj.left.property)
      ((SmallEtale.topology B X hX).over U) (localizationEquivalence B X hX U).functor := by
  set e := localizationEquivalence B X hX U
  constructor
  intro V S hS
  rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hS
  obtain ⟨R, hR, hRS⟩ := hS
  rw [SmallEtale.mem_precoverage_iff] at hR
  obtain ⟨E, rfl, hE⟩ := hR
  have hGen : Sieve.generate (E.map e.functor).presieve₀ ∈
      ((SmallEtale.topology B X hX).over U) (e.functor.obj V) := by
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate]
    have hle : (E.map (e.functor ⋙ Over.forget U)).presieve₀ ≤
        Presieve.functorPushforward (Over.forget U) ((E.map e.functor).presieve₀) := by
      rintro Y f ⟨i⟩
      exact Presieve.image_mem_functorPushforward (Over.forget U)
        ((E.map e.functor).presieve₀)
        (show (E.map e.functor).presieve₀ ((E.map e.functor).f i) from ⟨i⟩)
    exact (SmallEtale.topology B X hX).superset_covering (Sieve.generate_mono hle)
      (generate_presieve₀_mem_topology B (E.map (e.functor ⋙ Over.forget U)) hE)
  refine ((SmallEtale.topology B X hX).over U).superset_covering ?_ hGen
  calc
    Sieve.generate (E.map e.functor).presieve₀ =
        Sieve.functorPushforward e.functor (Sieve.generate E.presieve₀) := by
      rw [← Sieve.generate_map_eq_functorPushforward, ← PreZeroHypercover.presieve₀_map]
    _ ≤ Sieve.functorPushforward e.functor S :=
      Sieve.functorPushforward_monotone _ _ ((Sieve.generate_le_iff _ _).2 hRS)

/-- The inverse equivalence preserves covering sieves: a covering family of the slice at `U`
is a covering family of the small étale site of `U`, since neither the underlying schemes nor
the underlying morphisms change. -/
private theorem localizationInverse_coverPreserving :
    CoverPreserving ((SmallEtale.topology B X hX).over U)
      (SmallEtale.topology B U.obj.left.obj U.obj.left.property)
      (localizationEquivalence B X hX U).inverse := by
  set e := localizationEquivalence B X hX U
  constructor
  intro T R hR
  rw [GrothendieckTopology.mem_over_iff,
    Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hR
  obtain ⟨Q, hQ, hQR⟩ := hR
  rw [SmallEtale.mem_precoverage_iff] at hQ
  obtain ⟨E, rfl, hE⟩ := hQ
  let E' : PreZeroHypercover T :=
    { I₀ := E.I₀
      X := fun i => Over.mk (E.f i ≫ T.hom)
      f := fun i => Over.homMk (E.f i) (by simp) }
  have hE'le : E'.presieve₀ ≤ R.arrows := by
    rintro Z g ⟨i⟩
    exact (Sieve.overEquiv_iff R (E.f i)).mp (hQR _ _ ⟨i⟩)
  refine (SmallEtale.topology B U.obj.left.obj U.obj.left.property).superset_covering ?_
    (generate_presieve₀_mem_topology B (E'.map e.inverse) hE)
  rw [Sieve.generate_le_iff, PreZeroHypercover.presieve₀_map]
  exact (Presieve.map_le_functorPushforward e.inverse E'.presieve₀).trans
    (Presieve.functorPushforward_monotone hE'le)

/-- The canonical equivalence identifies the étale topology of `U` with the
topology induced from the slice topology of the small étale site of `X` at `U`. -/
public theorem localizationEquivalence_topology :
    (localizationEquivalence B X hX U).functor.inducedTopology
        ((SmallEtale.topology B X hX).over U) =
      SmallEtale.topology B U.obj.left.obj U.obj.left.property := by
  set e := localizationEquivalence B X hX U
  set J := SmallEtale.topology B U.obj.left.obj U.obj.left.property
  set K := (SmallEtale.topology B X hX).over U
  have : e.functor.IsCocontinuous J K :=
    (e.toAdjunction.isCocontinuous_iff_coverPreserving J K).2
      (localizationInverse_coverPreserving B X hX U)
  have : e.inverse.IsCocontinuous K J :=
    (e.symm.toAdjunction.isCocontinuous_iff_coverPreserving K J).2
      (localization_coverPreserving B X hX U)
  have : e.inverse.IsDenseSubsite K J :=
    Equivalence.isDenseSubsite_inverse_of_isCocontinuous J K e
  have hK : K = e.inverse.inducedTopology J :=
    Equivalence.eq_inducedTopology_of_isDenseSubsite J K e
  have hJ : J = e.functor.inducedTopology (e.inverse.inducedTopology J) := by
    ext V S
    simp [Functor.mem_inducedTopology_iff_of_isCoverDense,
      Sieve.functorPushforward_equivalence_eq_pullback]
  rw [hK]
  exact hJ.symm

/-- **The localization equivalence is cocontinuous.** A covering family of the slice of the
small étale site of `X` at `U`, read back through the inverse of the equivalence, is a covering
family of the small étale site of the scheme of `U`. -/
public instance isCocontinuous_localizationEquivalence_functor :
    (localizationEquivalence B X hX U).functor.IsCocontinuous
      (SmallEtale.topology B U.obj.left.obj U.obj.left.property)
      ((SmallEtale.topology B X hX).over U) :=
  ((localizationEquivalence B X hX U).toAdjunction.isCocontinuous_iff_coverPreserving
      (SmallEtale.topology B U.obj.left.obj U.obj.left.property)
      ((SmallEtale.topology B X hX).over U)).2
    (localizationInverse_coverPreserving B X hX U)

/-- **The localization equivalence is a dense subsite inclusion.** A sieve of the small étale
site of the scheme of `U` is covering exactly when its image in the slice of the small étale
site of `X` at `U` generates a covering sieve. -/
public instance isDenseSubsite_localizationEquivalence_functor :
    (localizationEquivalence B X hX U).functor.IsDenseSubsite
      (SmallEtale.topology B U.obj.left.obj U.obj.left.property)
      ((SmallEtale.topology B X hX).over U) := by
  rw [← localizationEquivalence_topology B X hX U]
  infer_instance

end SmallEtale

end AlgebraicGeometry

end
