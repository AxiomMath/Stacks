module

public import StacksFrontier.AlgebraicGeometry.Etale.ModuleSheafDirectImageAcyclic
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Constructible.MainstreamTransport
public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import Mathlib.RingTheory.Congruence.Basic
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.SmoothBaseChange.TorsionExhaustion

/-!
# Sheaves of `Λ`-modules annihilated by an integer `m`, as sheaves of `Λ/mΛ`-modules

Let `Λ` be a ring and `m` a natural number. Write `Λ/mΛ` for the quotient of `Λ` by the
two-sided ideal generated by the central element `m`, and `π : Λ ⟶ Λ/mΛ`. Restriction of scalars
along `π` has the right adjoint `M ↦ Hom_Λ(Λ/mΛ, M)` (coextension of scalars), and on a
`Λ`-module annihilated by `m` the counit `Hom_Λ(Λ/mΛ, M) ⟶ M` is bijective. Composing with these
functors on the small étale sites of a big étale site:

* a sheaf of `Λ`-modules annihilated by `m` is the restriction of scalars of a sheaf of
  `Λ/mΛ`-modules (`AlgebraicGeometry.SmallEtale.isIso_moduleSheafCoextensionAdj_counit_app`);
* coextension of scalars carries injective sheaves of `Λ`-modules to injective sheaves of
  `Λ/mΛ`-modules, being right adjoint to the exact restriction of scalars.

This is how the source's reduction of case (a) of [Stacks, Tag 0F7B] to case (b), for the
torsion ring `Λ/mΛ`, is carried out: an injective resolution of a sheaf of `Λ/mΛ`-modules is,
after restriction of scalars, a resolution by sheaves of `Λ`-modules acyclic for direct images
([Stacks, Tag 03FD] over `Λ/mΛ`).

## Main definitions

* `AlgebraicGeometry.SmallEtale.natCastRingCon`: the congruence `a ~ b ⟺ a - b ∈ mΛ`.
* `AlgebraicGeometry.SmallEtale.moduleSheafRestriction`,
  `AlgebraicGeometry.SmallEtale.moduleSheafCoextension` and their adjunction
  `AlgebraicGeometry.SmallEtale.moduleSheafCoextensionAdj`.

## References

* [Stacks Project, Tag 0F7B](https://stacks.math.columbia.edu/tag/0F7B)
* [Stacks Project, Tag 03FD](https://stacks.math.columbia.edu/tag/03FD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.SmallEtale

/-- Limits of modules at the universes at hand, so that instance search does not have to solve
`max (u + 1) ?r = u + 1`. -/
private instance hasLimitsOfSize_moduleCat_succ_succ' (R : Type u) [Ring R] :
    HasLimitsOfSize.{u + 1, u + 1} (ModuleCat.{u + 1} R) :=
  ModuleCat.hasLimitsOfSize.{u + 1, u + 1, u + 1, u}

/-! ### The ring `Λ/mΛ` -/

section Ring

variable (Λ : Type u) [Ring Λ] (m : ℕ)

/-- The ring congruence `a ~ b ⟺ a - b ∈ mΛ` on `Λ`; the integer `m` is central, so `mΛ` is a
two-sided ideal. -/
def natCastRingCon : RingCon Λ where
  r a b := ∃ c, a - b = (m : Λ) * c
  iseqv :=
    { refl := fun a => ⟨0, by simp⟩
      symm := fun {a b} ⟨c, h⟩ => ⟨-c, by rw [mul_neg, ← h, neg_sub]⟩
      trans := fun {a b d} ⟨c, h⟩ ⟨e, h'⟩ => ⟨c + e, by
        rw [mul_add, ← h, ← h', sub_add_sub_cancel]⟩ }
  add' := fun {a₁ b₁ a₂ b₂} ⟨c, h⟩ ⟨e, h'⟩ => ⟨c + e, by
    rw [mul_add, ← h, ← h']
    abel⟩
  mul' := fun {a₁ b₁ a₂ b₂} ⟨c, h⟩ ⟨e, h'⟩ => ⟨c * a₂ + b₁ * e, by
    rw [mul_add, ← mul_assoc, ← h, ← mul_assoc, Nat.cast_comm m b₁, mul_assoc, ← h']
    noncomm_ring⟩

/-- The ring `Λ/mΛ`. -/
abbrev NatCastQuotient : Type u := (natCastRingCon Λ m).Quotient

/-- The projection `Λ ⟶ Λ/mΛ`. -/
abbrev natCastQuotientMk : Λ →+* NatCastQuotient Λ m := (natCastRingCon Λ m).mk'

/-- The projection `Λ ⟶ Λ/mΛ` is surjective. -/
theorem natCastQuotientMk_surjective : Function.Surjective (natCastQuotientMk Λ m) :=
  (natCastRingCon Λ m).mk'_surjective

/-- `m` vanishes in `Λ/mΛ`. -/
theorem natCast_natCastQuotient_eq_zero : ((m : ℕ) : NatCastQuotient Λ m) = 0 := by
  rw [← map_natCast (natCastQuotientMk Λ m), ← (natCastQuotientMk Λ m).map_zero]
  exact (natCastRingCon Λ m).eq.2 ⟨1, by simp⟩

/-- Two elements of `Λ` with the same image in `Λ/mΛ` differ by an element of `mΛ`. -/
theorem exists_sub_eq_of_natCastQuotientMk_eq {a b : Λ}
    (h : natCastQuotientMk Λ m a = natCastQuotientMk Λ m b) : ∃ c, a - b = (m : Λ) * c :=
  (natCastRingCon Λ m).eq.1 h

end Ring

/-! ### Modules annihilated by `m` -/

section ModuleCat

variable (Λ : Type u) [Ring Λ] (m : ℕ)

/-- The `Λ`-linear map `Λ/mΛ ⟶ M`, `[a] ↦ a • x`, for an element `x` annihilated by `m`. -/
def natCastQuotientLift (M : ModuleCat.{u + 1} Λ) (x : M) (hx : (m : Λ) • x = 0) :
    (ModuleCat.restrictScalars (natCastQuotientMk Λ m)).obj
      (ModuleCat.of (NatCastQuotient Λ m) (NatCastQuotient Λ m)) →ₗ[Λ] M where
  toFun s := Quotient.liftOn' s (fun a => a • x) (fun a b hab => by
    obtain ⟨c, hc⟩ := hab
    rw [← sub_eq_zero, ← sub_smul, hc, Nat.cast_comm m c, mul_smul, hx, smul_zero])
  map_add' s t := by
    induction s using Quotient.inductionOn'
    induction t using Quotient.inductionOn'
    exact add_smul _ _ x
  map_smul' r s := by
    induction s using Quotient.inductionOn'
    exact mul_smul _ _ x

/-- The map `Λ/mΛ ⟶ M` sends the class of `a` to `a • x`. -/
theorem natCastQuotientLift_mk (M : ModuleCat.{u + 1} Λ) (x : M) (hx : (m : Λ) • x = 0) (a : Λ) :
    natCastQuotientLift Λ m M x hx (natCastQuotientMk Λ m a) = a • x :=
  rfl

/-- **On a `Λ`-module annihilated by `m`, the counit `Hom_Λ(Λ/mΛ, M) ⟶ M` of restriction and
coextension of scalars is bijective**: a `Λ`-linear map out of `Λ/mΛ` is determined by the image
of `1`, and every element annihilated by `m` is such an image. -/
theorem isIso_restrictCoextendScalarsAdj_counit_app (M : ModuleCat.{u + 1} Λ)
    (hM : ∀ x : M, (m : Λ) • x = 0) :
    IsIso ((ModuleCat.restrictCoextendScalarsAdj.{u + 1}
      (natCastQuotientMk Λ m)).counit.app M) := by
  rw [ConcreteCategory.isIso_iff_bijective]
  let e := ModuleCat.CoextendScalars.equiv (natCastQuotientMk Λ m) M
  have hcounit : ∀ g, (ModuleCat.restrictCoextendScalarsAdj.{u + 1}
      (natCastQuotientMk Λ m)).counit.app M g = e g (natCastQuotientMk Λ m 1) := fun _ => rfl
  refine ⟨fun g₁ g₂ h => ?_, fun x => ⟨e.symm (natCastQuotientLift Λ m M x (hM x)), ?_⟩⟩
  · refine e.injective (LinearMap.ext fun s => ?_)
    obtain ⟨a, rfl⟩ := natCastQuotientMk_surjective Λ m s
    have hg : ∀ g, e g (natCastQuotientMk Λ m a) = a • e g (natCastQuotientMk Λ m 1) := fun g => by
      refine Eq.trans ?_ ((e g).map_smul a (natCastQuotientMk Λ m 1))
      congr 1
      change natCastQuotientMk Λ m a = natCastQuotientMk Λ m a * natCastQuotientMk Λ m 1
      rw [map_one, mul_one]
    rw [hg g₁, hg g₂, ← hcounit g₁, ← hcounit g₂, h]
  · refine (hcounit _).trans ?_
    rw [LinearEquiv.apply_symm_apply]
    exact (natCastQuotientLift_mk Λ m M x (hM x) 1).trans (one_smul _ _)

end ModuleCat

/-! ### Sheaves -/

section Sheaf

variable (B : BigEtaleSite.{u}) (S : B.Scheme) (Λ : Type u) [Ring Λ] (m : ℕ)

/-- Restriction of scalars and the forgetful functor to abelian groups commute. -/
def restrictScalarsCompForget₂Iso :
    ModuleCat.restrictScalars.{u + 1} (natCastQuotientMk Λ m) ⋙
        forget₂ (ModuleCat.{u + 1} Λ) AddCommGrpCat.{u + 1} ≅
      forget₂ (ModuleCat.{u + 1} (NatCastQuotient Λ m)) AddCommGrpCat.{u + 1} :=
  NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)

/-- Restriction of scalars carries sheaves to sheaves: a presheaf of modules is a sheaf exactly
when its underlying presheaf of abelian groups is, and restriction of scalars does not change the
underlying abelian groups. -/
instance hasSheafCompose_restrictScalars_natCastQuotientMk :
    (SmallEtale.topology B S.obj S.property).HasSheafCompose
      (ModuleCat.restrictScalars.{u + 1} (natCastQuotientMk Λ m)) where
  isSheaf P hP := by
    have : PreservesLimitsOfSize.{u, u + 1}
        (forget₂ (ModuleCat.{u + 1} Λ) AddCommGrpCat.{u + 1}) :=
      ModuleCat.forget₂AddCommGroup_preservesLimitsOfSize.{u, u + 1, u + 1, u}
    have : HasLimitsOfSize.{u, u + 1} (ModuleCat.{u + 1} Λ) :=
      ModuleCat.hasLimitsOfSize.{u, u + 1, u + 1, u}
    have : PreservesLimitsOfSize.{u, u + 1}
        (forget₂ (ModuleCat.{u + 1} (NatCastQuotient Λ m)) AddCommGrpCat.{u + 1}) :=
      ModuleCat.forget₂AddCommGroup_preservesLimitsOfSize.{u, u + 1, u + 1, u}
    have : HasLimitsOfSize.{u, u + 1} (ModuleCat.{u + 1} (NatCastQuotient Λ m)) :=
      ModuleCat.hasLimitsOfSize.{u, u + 1, u + 1, u}
    refine (Presheaf.isSheaf_iff_isSheaf_comp _ _
      (forget₂ (ModuleCat.{u + 1} Λ) AddCommGrpCat.{u + 1})).2 ?_
    refine (Presheaf.isSheaf_of_iso_iff (Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft P (restrictScalarsCompForget₂Iso Λ m))).2 ?_
    exact (Presheaf.isSheaf_iff_isSheaf_comp _ _
      (forget₂ (ModuleCat.{u + 1} (NatCastQuotient Λ m)) AddCommGrpCat.{u + 1})).1 hP

/-- Coextension of scalars carries sheaves to sheaves, being a right adjoint. -/
instance hasSheafCompose_coextendScalars_natCastQuotientMk :
    (SmallEtale.topology B S.obj S.property).HasSheafCompose
      (ModuleCat.coextendScalars.{u, u, u + 1} (natCastQuotientMk Λ m)) :=
  haveI : PreservesLimitsOfSize.{u, u + 1}
      (ModuleCat.coextendScalars.{u, u, u + 1} (natCastQuotientMk Λ m)) :=
    (ModuleCat.restrictCoextendScalarsAdj.{u + 1}
      (natCastQuotientMk Λ m)).rightAdjoint_preservesLimits
  hasSheafCompose_of_preservesLimitsOfSize _

/-- Restriction of scalars along `Λ ⟶ Λ/mΛ`, on étale sheaves of modules. -/
abbrev moduleSheafRestriction :
    ModuleSheaf.{u, u, u} B S (NatCastQuotient Λ m) ⥤ ModuleSheaf.{u, u, u} B S Λ :=
  letI := hasSheafCompose_restrictScalars_natCastQuotientMk B S Λ m
  sheafCompose (SmallEtale.topology B S.obj S.property)
    (ModuleCat.restrictScalars.{u + 1} (natCastQuotientMk Λ m))

/-- Coextension of scalars `M ↦ Hom_Λ(Λ/mΛ, M)`, on étale sheaves of modules. -/
abbrev moduleSheafCoextension :
    ModuleSheaf.{u, u, u} B S Λ ⥤ ModuleSheaf.{u, u, u} B S (NatCastQuotient Λ m) :=
  letI := hasSheafCompose_coextendScalars_natCastQuotientMk B S Λ m
  sheafCompose (SmallEtale.topology B S.obj S.property)
    (ModuleCat.coextendScalars.{u, u, u + 1} (natCastQuotientMk Λ m))

/-- Restriction of scalars is left adjoint to coextension of scalars, on étale sheaves of
modules. -/
def moduleSheafCoextensionAdj : moduleSheafRestriction B S Λ m ⊣ moduleSheafCoextension B S Λ m :=
  letI := hasSheafCompose_restrictScalars_natCastQuotientMk B S Λ m
  letI := hasSheafCompose_coextendScalars_natCastQuotientMk B S Λ m
  sheafComposeAdjunction (SmallEtale.topology B S.obj S.property)
    (ModuleCat.restrictCoextendScalarsAdj.{u + 1} (natCastQuotientMk Λ m))

/-- **A sheaf of `Λ`-modules annihilated by `m` is the restriction of scalars of a sheaf of
`Λ/mΛ`-modules**: the counit `Hom_Λ(Λ/mΛ, M) ⟶ M` is invertible, sectionwise by
`AlgebraicGeometry.SmallEtale.isIso_restrictCoextendScalarsAdj_counit_app`. -/
theorem isIso_moduleSheafCoextensionAdj_counit_app (M : ModuleSheaf.{u, u, u} B S Λ)
    (hM : ∀ (U : (SmallEtale B S.obj S.property)ᵒᵖ) (x : M.obj.obj U), (m : Λ) • x = 0) :
    IsIso ((moduleSheafCoextensionAdj B S Λ m).counit.app M) :=
  (isIso_iff_of_reflects_iso _ (sheafToPresheaf _ _)).1 <|
    @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ fun U =>
      isIso_restrictCoextendScalarsAdj_counit_app Λ m (M.obj.obj U) (hM U)

/-- Restriction of scalars does not change the underlying abelian sheaf. -/
def moduleSheafRestrictionCompForgetIso :
    moduleSheafRestriction B S Λ m ⋙ forgetModuleSheaf.{u, u, u} B S Λ ≅
      forgetModuleSheaf.{u, u, u} B S (NatCastQuotient Λ m) :=
  Iso.refl _

/-- Restriction of scalars is exact: it is a left adjoint, and it preserves finite limits since
forgetting the module structure, which reflects them, takes it to the forgetful functor. -/
instance preservesFiniteLimits_moduleSheafRestriction :
    PreservesFiniteLimits (moduleSheafRestriction B S Λ m) := by
  have := preservesFiniteLimits_forgetModuleSheaf.{u, u, u} B S Λ
  have := preservesFiniteLimits_forgetModuleSheaf.{u, u, u} B S (NatCastQuotient Λ m)
  have : ReflectsFiniteLimits (forgetModuleSheaf.{u, u, u} B S Λ) :=
    reflectsFiniteLimits_of_reflectsIsomorphisms _
  have : PreservesFiniteLimits
      (moduleSheafRestriction B S Λ m ⋙ forgetModuleSheaf.{u, u, u} B S Λ) :=
    preservesFiniteLimits_of_natIso (moduleSheafRestrictionCompForgetIso B S Λ m).symm
  exact preservesFiniteLimits_of_reflects_of_preserves _ (forgetModuleSheaf.{u, u, u} B S Λ)

/-- Restriction of scalars along `Λ ⟶ Λ/mΛ` on étale sheaves of modules preserves finite
colimits. -/
instance preservesFiniteColimits_moduleSheafRestriction :
    PreservesFiniteColimits (moduleSheafRestriction B S Λ m) :=
  haveI : PreservesColimitsOfSize.{0, 0} (moduleSheafRestriction B S Λ m) :=
    (moduleSheafCoextensionAdj B S Λ m).leftAdjoint_preservesColimits
  PreservesColimitsOfSize.preservesFiniteColimits _

/-- Restriction of scalars is additive: it does not change the underlying maps. -/
instance additive_moduleSheafRestriction : (moduleSheafRestriction B S Λ m).Additive where
  map_add := rfl

/-- **Coextension of scalars carries injective sheaves to injective sheaves**, being right
adjoint to the exact restriction of scalars. -/
instance injective_moduleSheafCoextension_obj (I : ModuleSheaf.{u, u, u} B S Λ) [Injective I] :
    Injective ((moduleSheafCoextension B S Λ m).obj I) :=
  haveI : PreservesLimitsOfShape WalkingCospan (moduleSheafRestriction B S Λ m) :=
    (preservesFiniteLimits_moduleSheafRestriction B S Λ m).preservesFiniteLimits _
  haveI : (moduleSheafRestriction B S Λ m).PreservesMonomorphisms :=
    preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : (moduleSheafCoextension B S Λ m).PreservesInjectiveObjects :=
    Functor.preservesInjectiveObjects_of_adjunction_of_preservesMonomorphisms
      (moduleSheafCoextensionAdj B S Λ m)
  Functor.injective_obj _ I

end Sheaf

/-! ### A torsion sheaf is the union of its `k!`-torsion subsheaves -/

section Exhaustion

open Stacks.EtaleCohomology.SmoothBaseChange

variable (B : BigEtaleSite.{u}) {S : B.Scheme} (Λ : Type u) [Ring Λ]
  (M : ModuleSheaf.{u, u, u} B S Λ)

/-- **The chain `k ↦ M[k!]`** of the subsheaves of a sheaf of `Λ`-modules annihilated by `k!`. -/
def factorialTorsionDiagram : ULift.{u + 1} ℕ ⥤ ModuleSheaf.{u, u, u} B S Λ where
  obj k := kernel (((k.down.factorial : ℕ) : ℤ) • 𝟙 M)
  map {k k'} φ := torsionInclusion M (Int.natCast_dvd_natCast.2
    (Nat.factorial_dvd_factorial (ULift.down_le.2 (leOfHom φ))))
  map_id _ := by
    rw [← cancel_mono (kernel.ι _)]
    simp
  map_comp _ _ := by
    rw [← cancel_mono (kernel.ι _)]
    simp

/-- The inclusions `M[k!] ⟶ M`. -/
def factorialTorsionCocone : Cocone (factorialTorsionDiagram B Λ M) where
  pt := M
  ι :=
    { app _ := kernel.ι _
      naturality _ _ φ := (torsionInclusion_ι M (Int.natCast_dvd_natCast.2
          (Nat.factorial_dvd_factorial (ULift.down_le.2 (leOfHom φ))))).trans
        (Category.comp_id _).symm }

/-- A section annihilated by `a` is a section of the subsheaf `M[a]`. -/
theorem exists_kernel_zsmul_section (a : ℤ) {W : SmallEtale B S.obj S.property}
    (x : M.obj.obj (Opposite.op W)) (hx : a • x = 0) :
    ∃ y : (kernel (a • 𝟙 M)).obj.obj (Opposite.op W), (kernel.ι (a • 𝟙 M)).hom.app _ y = x := by
  let E := sheafToPresheaf (SmallEtale.topology B S.obj S.property) (ModuleCat.{u + 1} Λ) ⋙
    (evaluation _ (ModuleCat.{u + 1} Λ)).obj (Opposite.op W)
  have hE : (E.map (a • 𝟙 M)).hom x = 0 := by
    change (a • 𝟙 M.obj).app (Opposite.op W) x = 0
    rwa [NatTrans.app_zsmul]
  refine ⟨(PreservesKernel.iso E (a • 𝟙 M)).inv
    ((ModuleCat.kernelIsoKer (E.map (a • 𝟙 M))).inv ⟨x, hE⟩), ?_⟩
  change (E.map (kernel.ι (a • 𝟙 M))) ((PreservesKernel.iso E (a • 𝟙 M)).inv
    ((ModuleCat.kernelIsoKer (E.map (a • 𝟙 M))).inv ⟨x, hE⟩)) = x
  rw [← ConcreteCategory.comp_apply, PreservesKernel.iso_inv_ι E (a • 𝟙 M),
    ModuleCat.kernelIsoKer_inv_kernel_ι_apply]

/-- **A torsion sheaf of `Λ`-modules is the union of its subsheaves `M[k!]`.** The comparison
from the colimit is a monomorphism, filtered colimits being exact, and an epimorphism on
underlying abelian sheaves: a local section is locally annihilated by some `n > 0`, hence by
`n!`, and so lies locally in `M[n!]`. -/
noncomputable def isColimitFactorialTorsionCocone
    (hM : moduleTorsionSheafProperty.{u, u, u} B S Λ M) :
    IsColimit (factorialTorsionCocone B Λ M) := by
  let D := factorialTorsionDiagram B Λ M
  let φ := (colimit.isColimit D).desc (factorialTorsionCocone B Λ M)
  have hφ : ∀ k, colimit.ι D k ≫ φ = kernel.ι _ := (colimit.isColimit D).fac _
  have : ∀ k, Mono ((factorialTorsionCocone B Λ M).ι.app k) := fun k =>
    (inferInstance : Mono (kernel.ι (((k.down.factorial : ℕ) : ℤ) • 𝟙 M)))
  have : Mono (factorialTorsionCocone B Λ M).ι := NatTrans.mono_of_mono_app _
  have hmono : Mono φ :=
    colim.map_mono' (factorialTorsionCocone B Λ M).ι (colimit.isColimit D)
      (isColimitConstCocone _ M) φ fun k => (hφ k).trans (Category.comp_id _).symm
  let G := forgetModuleSheaf.{u, u, u} B S Λ
  have hloc : Presheaf.IsLocallySurjective (SmallEtale.topology B S.obj S.property)
      (G.map φ).hom := by
    refine ⟨@fun U x => ?_⟩
    obtain ⟨R, hR, hRx⟩ := hM U x
    refine (SmallEtale.topology B S.obj S.property).superset_covering
      (fun V f hf => ?_) hR
    obtain ⟨n, hn, hnx⟩ := hRx V f hf
    have hz : (((n.factorial : ℕ) : ℤ)) • M.obj.map f.op x = 0 := by
      obtain ⟨c, hc⟩ := Nat.dvd_factorial hn le_rfl
      rw [natCast_zsmul, hc, mul_comm, mul_smul]
      change c • (n • ((M.obj.map f.op) x : M.obj.obj (Opposite.op V))) = 0
      rw [show (n • ((M.obj.map f.op) x : M.obj.obj (Opposite.op V))) = 0 from hnx, smul_zero]
    obtain ⟨y, hy⟩ := exists_kernel_zsmul_section B Λ M _ (M.obj.map f.op x) hz
    exact ⟨(colimit.ι D ⟨n⟩).hom.app (Opposite.op V) y,
      (congrArg (fun g => g.hom.app (Opposite.op V) y) (hφ ⟨n⟩)).trans hy⟩
  have : Sheaf.IsLocallySurjective (G.map φ) := hloc
  have : Epi φ := G.epi_of_epi_map inferInstance
  have : IsIso φ := isIso_of_mono_of_epi φ
  exact IsColimit.ofPointIso (colimit.isColimit D)

end Exhaustion

end AlgebraicGeometry.SmallEtale

end
