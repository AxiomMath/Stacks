module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Properties
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.OrderOfVanishing.Basic
public import Mathlib.RingTheory.TensorProduct.Quotient
public import Mathlib.RingTheory.Unramified.LocalRing
public import StacksFrontier.RingTheory.Length.HenselizationBaseChange

/-!
# The order of vanishing and the codimension of a point along an étale morphism

An étale morphism of schemes is flat and formally unramified, so each of its stalk maps
`𝒪_{Y, f y} ⟶ 𝒪_{X, y}` is a flat local homomorphism which is essentially of finite type and
formally unramified, and for such a homomorphism the maximal ideal of the target is generated by
the image of the maximal ideal of the source — Stacks 00UW. Two consequences follow, and they are
the two local facts needed to know that the order of vanishing on a scheme is an *étale*-local
notion rather than merely a Zariski-local one.

The first is that the order of vanishing of a section of the structure sheaf, in the sense of
`Ring.ord` applied to the local ring, is unchanged: the fibre `𝒪_{X,y} / 𝔪_{f y} 𝒪_{X,y}` is the
residue field of `𝒪_{X,y}`, so the factor it contributes to the length formula of Stacks 02M1 for
a flat local base change is trivial.

The second is that the codimension of a point is unchanged: going down holds for a flat algebra,
so the height of the maximal ideal is the height of the maximal ideal below it plus the height of
the maximal ideal of the fibre, and the fibre is a field.

Both are stated at the level of local rings first and then for a morphism of schemes.

## Main results

* `IsLocalRing.ord_algebraMap_of_map_maximalIdeal`: the order of vanishing of an element of a
  local ring is unchanged by a flat local homomorphism whose target's maximal ideal is generated
  by the image of the source's.
* `IsLocalRing.ringKrullDim_eq_of_map_maximalIdeal`: such a homomorphism preserves the Krull
  dimension.
* `Stacks.Etale.map_maximalIdeal_stalkMap`: **the stalk map of an étale morphism carries the
  maximal ideal onto a generating set of the maximal ideal.**
* `Stacks.Etale.ord_stalkMap`: **the order of vanishing of a germ is unchanged by the stalk map
  of an étale morphism.**
* `Stacks.Etale.coheight_eq`: **an étale morphism preserves the codimension of a point.**

## Implementation notes

The hypothesis on the local rings is the conclusion `𝔪_A B = 𝔪_B` of Stacks 00UW rather than
formal unramifiedness itself, because that is all either proof uses and it is the form in which
the hypothesis is available for other maps — a henselization, say, for which
`IsLocalRing.IsHenselization.ord_algebraMap` is the same statement proved the same way.

For a scheme morphism the `Algebra` structure on the stalks is the one produced by `algebraize`
from the stalk map, and the three ring-homomorphism properties of the stalk map are
`AlgebraicGeometry.Flat.stalkMap`, `AlgebraicGeometry.FormallyUnramified.stalkMap` and
`AlgebraicGeometry.LocallyOfFiniteType.stalkMap`; the last is what supplies
`Algebra.EssFiniteType`, which Stacks 00UW needs and which étaleness provides through local
finite presentation.

## References

* [Stacks Project, Tag 00UW](https://stacks.math.columbia.edu/tag/00UW): an unramified local
  homomorphism has `𝔪_A B = 𝔪_B` and a separable residue field extension.
* [Stacks Project, Tag 02M1](https://stacks.math.columbia.edu/tag/02M1): the length of a base
  change along a flat local homomorphism.
* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON): the height of a prime
  under going down.
-/

@[expose] public noncomputable section

open CategoryTheory Order TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped TensorProduct

universe u

namespace IsLocalRing

variable (A B : Type*) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [Algebra A B]
  [IsLocalHom (algebraMap A B)] [Module.Flat A B]

/-- **The order of vanishing is unchanged by an unramified flat local homomorphism.** For a flat
local homomorphism `A → B` whose target's maximal ideal is generated by the image of `𝔪_A`, the
quotient `B / xB` is the base change of `A / xA`, and such a base change preserves lengths by
`length_baseChange_eq_of_map_maximalIdeal`. -/
theorem ord_algebraMap_of_map_maximalIdeal
    (hmax : Ideal.map (algebraMap A B) (maximalIdeal A) = maximalIdeal B) (x : A) :
    Ring.ord B (algebraMap A B x) = Ring.ord A x := by
  calc Ring.ord B (algebraMap A B x)
      = Module.length B (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {x})) := by
        rw [Ring.ord, Ideal.map_span, Set.image_singleton]
    _ = Module.length B (B ⊗[A] (A ⧸ Ideal.span {x})) :=
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B
          (Ideal.span {x})).toLinearEquiv.length_eq
    _ = Ring.ord A x :=
        (length_baseChange_eq_of_map_maximalIdeal A B hmax (A ⧸ Ideal.span {x})).symm

/-- **An unramified flat local homomorphism preserves the Krull dimension.** Going down holds for
a flat algebra, so the height of `𝔪_B` is the height of `𝔪_A` plus the height of the image of
`𝔪_B` in `B / 𝔪_A B`; that image is the zero ideal, whose height is zero. -/
theorem ringKrullDim_eq_of_map_maximalIdeal [IsNoetherianRing A] [IsNoetherianRing B]
    (hmax : Ideal.map (algebraMap A B) (maximalIdeal A) = maximalIdeal B) :
    ringKrullDim B = ringKrullDim A := by
  have : Algebra.HasGoingDown A B := .of_flat
  have : (maximalIdeal B).LiesOver (maximalIdeal A) :=
    ⟨(((local_hom_TFAE (algebraMap A B)).out 1 5 rfl rfl).mp ‹_›).symm⟩
  have : Nontrivial (B ⧸ Ideal.map (algebraMap A B) (maximalIdeal A)) :=
    Ideal.Quotient.nontrivial_iff.mpr (by rw [hmax]; exact (maximalIdeal.isMaximal B).ne_top)
  have hb : (maximalIdeal B).map
      (Ideal.Quotient.mk (Ideal.map (algebraMap A B) (maximalIdeal A))) = ⊥ := by
    rw [← hmax]
    exact Ideal.map_quotient_self _
  have hht := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (R := A) (S := B) (maximalIdeal A) (maximalIdeal B)
  rw [hb, Ideal.height_bot, add_zero] at hht
  rw [← maximalIdeal_height_eq_ringKrullDim (R := B),
    ← maximalIdeal_height_eq_ringKrullDim (R := A)]
  exact_mod_cast hht

end IsLocalRing

namespace Stacks.Etale

variable {X Y : Scheme.{u}} (f : X ⟶ Y) [AlgebraicGeometry.Etale f] (y : X)

/-- The stalk map of an étale morphism, as an algebra structure, is a flat local homomorphism. -/
private theorem isLocalHom_and_flat_stalkMap :
    letI := (f.stalkMap y).hom.toAlgebra
    IsLocalHom (algebraMap (Y.presheaf.stalk (f.base y)) (X.presheaf.stalk y)) ∧
      Module.Flat (Y.presheaf.stalk (f.base y)) (X.presheaf.stalk y) :=
  ⟨inferInstanceAs <| IsLocalHom (f.stalkMap y).hom, AlgebraicGeometry.Flat.stalkMap f y⟩

/-- **The stalk map of an étale morphism carries the maximal ideal onto a generating set of the
maximal ideal.** The stalk map is a local homomorphism which is essentially of finite type and
formally unramified, so this is Stacks 00UW. -/
theorem map_maximalIdeal_stalkMap :
    Ideal.map (f.stalkMap y).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f.base y))) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk y) := by
  algebraize [(f.stalkMap y).hom]
  obtain ⟨_, _⟩ := isLocalHom_and_flat_stalkMap f y
  have : Algebra.EssFiniteType (Y.presheaf.stalk (f.base y)) (X.presheaf.stalk y) := by
    rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
    exact AlgebraicGeometry.LocallyOfFiniteType.stalkMap f y
  have : Algebra.FormallyUnramified (Y.presheaf.stalk (f.base y)) (X.presheaf.stalk y) := by
    rw [← RingHom.formallyUnramified_algebraMap, RingHom.algebraMap_toAlgebra]
    exact AlgebraicGeometry.FormallyUnramified.stalkMap f y
  exact Algebra.FormallyUnramified.map_maximalIdeal

/-- **The order of vanishing of a germ is unchanged by the stalk map of an étale morphism.** The
stalk map is flat and the maximal ideal of the target is generated by the image of the maximal
ideal of the source, so `IsLocalRing.ord_algebraMap_of_map_maximalIdeal` applies. -/
theorem ord_stalkMap (a : Y.presheaf.stalk (f.base y)) :
    Ring.ord (X.presheaf.stalk y) ((f.stalkMap y).hom a) =
      Ring.ord (Y.presheaf.stalk (f.base y)) a := by
  algebraize [(f.stalkMap y).hom]
  obtain ⟨_, _⟩ := isLocalHom_and_flat_stalkMap f y
  exact IsLocalRing.ord_algebraMap_of_map_maximalIdeal _ _ (map_maximalIdeal_stalkMap f y) a

/-- **An étale morphism preserves the codimension of a point.** The codimension of a point is the
Krull dimension of its local ring, and the stalk map of an étale morphism preserves that by
`IsLocalRing.ringKrullDim_eq_of_map_maximalIdeal`. -/
theorem coheight_eq [IsLocallyNoetherian Y] : coheight (f.base y) = coheight y := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  algebraize [(f.stalkMap y).hom]
  obtain ⟨_, _⟩ := isLocalHom_and_flat_stalkMap f y
  have h := IsLocalRing.ringKrullDim_eq_of_map_maximalIdeal
    (Y.presheaf.stalk (f.base y)) (X.presheaf.stalk y) (map_maximalIdeal_stalkMap f y)
  rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight] at h
  exact_mod_cast h.symm

end Stacks.Etale

end
