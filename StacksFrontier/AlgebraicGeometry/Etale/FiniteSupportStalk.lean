        AddCommGrpCat.ofHom (fiberStalksMap B f s φ) :=
    (Category.assoc _ _ _).trans
      ((congrArg (fun z => AddCommGrpCat.ofHom (supportedSectionsSheafMap B X.obj X.property φ
