module

public import StacksFrontier.AlgebraicGeometry.AmpleEventualGeneration.Basic
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.FiniteTypeGeneration
public import StacksFrontier.AlgebraicGeometry.InvertibleClasses.Basic
public import StacksFrontier.AlgebraicGeometry.Modules.FiniteLocallyFree
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Finitely many global sections out of all of them, and clause (7) of Tag 01Q3 on an affine scheme

Clause (7) of [Stacks, Tag 01Q3] — `Stacks.AmpleGlobalGeneration.IsEventuallyGloballyGenerated` —
asks that a finite-type quasi-coherent module become generated by **finitely many** global sections
after a sufficiently positive twist. This file verifies the clause on every affine scheme, for
every invertible module and with no ampleness hypothesis.

On a quasi-compact scheme a module of finite type generated by *any* family of global sections is
generated by finitely many of them (Modules, Lemma 17.9.7, [Stacks, Tag 01BB]); on an affine
scheme every quasi-coherent module is generated by all its global sections
(`AlgebraicGeometry.generatingSectionsOfIsAffine`).

## Main results

* `Stacks.AmpleEventualGeneration.isFinGen_of_generatingSections`: **Tag 01BB for generation by
  global sections.** On a quasi-compact scheme, a module of finite type carrying a family of
  generating global sections carries a *finite* one.
* `Stacks.AmpleEventualGeneration.isFinGen_of_isAffine`: **[Stacks, Tag 01PB] read on the whole
  scheme.** On an affine scheme every finite-type quasi-coherent module is generated by finitely
  many global sections.
* `Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule`: an invertible module is of
  finite type, being finite locally free of rank one ([Stacks, Tag 0B8M] clause 2).
* `Stacks.AmpleEventualGeneration.isEventuallyGloballyGenerated_of_isAffine`: **clause (7) of
  [Stacks, Tag 01Q3] holds on every affine scheme**, for every invertible module, with `n₀ = 0`.
* `Stacks.AmpleEventualGeneration.isQuotientOfNegativeTwists_of_isAffine`: **clause (8) of
  [Stacks, Tag 01Q3] on every affine scheme**.
* `Stacks.AmpleEventualGeneration.isEventuallyFinGenPowers_of_isAffine` and
  `Stacks.AmpleEventualGeneration.isFinGenAfterSomeTwist_of_isAffine`: the two halves of clause
  (7), separately, on an affine scheme.

## Implementation notes

`AlgebraicGeometry.generatedSubobject σ J` is the submodule generated by a finite subfamily `J` of
`σ`, `AlgebraicGeometry.isColimit_generatedSubobjectCocone` says those submodules have `M` as their
colimit, and `Stacks.SheafOfModules.exists_isIso_to_colimit_of_isFiniteType` — Tag 01BB's second
assertion — produces a `J` whose transition map to the colimit is an isomorphism. This is
`Stacks.AmpleEventualGeneration.exists_isIso_generatedSubobject_arrow`, on `X` itself rather than
after restriction to an open as in `AlgebraicGeometry.exists_generatedSubobject_restrict_isIso`.

`AlgebraicGeometry.Scheme.Modules.freeOn X ι` and `Stacks.AmpleGlobalGeneration.freeModule X ι`
are the same module definitionally, so `Stacks.AmpleEventualGeneration.isFinGen_freeModule`
applies to the source of `generatedSubobjectHom` with no transport.

Finite type of an invertible module is not found by instance search; it goes through
`Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry`.

No tag attribute is attached here: Tag 01Q3 asserts the equivalence of all nine of its clauses,
and this file proves two of them on affine schemes only. Clause (7) for every scheme with an ample
invertible module is
`Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple`,
which carries the tag.

## References

* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
* [Stacks Project, Tag 01PB](https://stacks.math.columbia.edu/tag/01PB)
* [Stacks Project, Tag 01BB](https://stacks.math.columbia.edu/tag/01BB)
* [Stacks Project, Tag 01AO](https://stacks.math.columbia.edu/tag/01AO)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.Ample AlgebraicGeometry.SheafOfModules
open AlgebraicGeometry.Scheme.Modules AlgebraicGeometry

universe u

namespace Stacks.AmpleEventualGeneration

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

variable {X : Scheme.{u}}

/-! ### Tag 01BB for generation by global sections -/

/-- **A finite subfamily of a family of generating global sections already generates**, on a
quasi-compact scheme and for a module of finite type. -/
theorem exists_isIso_generatedSubobject_arrow [CompactSpace X] {M : X.Modules}
    (hft : SheafOfModules.IsFiniteType.{u, u, u} M) (σ : M.GeneratingSections) :
    ∃ J : Finset σ.I, IsIso (generatedSubobject σ J).arrow := by
  classical
  have hcol : IsColimit (generatedSubobjectCocone σ) := isColimit_generatedSubobjectCocone σ
  have hftcol : (colimit (generatedSubobjectDiagram σ)).IsFiniteType :=
    isFiniteType_of_iso_modules
      ((colimit.isColimit (generatedSubobjectDiagram σ)).coconePointUniqueUpToIso hcol) hft
  have hmono : ∀ (i j : Finset σ.I) (f : i ⟶ j), Mono ((generatedSubobjectDiagram σ).map f) :=
    fun i j f => @mono_of_mono_fac _ _ _ _ _ _ _ _ (Subobject.arrow_mono _)
      (Subobject.underlying_arrow ((generatedSubobjectFunctor σ).map f))
  obtain ⟨J, hJ⟩ := @Stacks.SheafOfModules.exists_isIso_to_colimit_of_isFiniteType
    X.toPresheafedSpace X.ringCatSheaf _ _ _ _ _ _ _ _ _
    (generatedSubobjectDiagram σ) hmono hftcol
  refine ⟨J, ?_⟩
  have hι : IsIso ((colimit.cocone (generatedSubobjectDiagram σ)).ι.app J) := hJ
  show IsIso ((generatedSubobjectCocone σ).ι.app J)
  rw [← IsColimit.comp_coconePointUniqueUpToIso_hom
    (colimit.isColimit (generatedSubobjectDiagram σ)) hcol J]
  infer_instance

/-- **The free module on a finite subfamily surjects onto the ambient module** as soon as the
submodule that subfamily generates is everything. -/
theorem epi_generatedSubobjectHom {M : X.Modules} (σ : M.GeneratingSections) (J : Finset σ.I)
    (h : IsIso (generatedSubobject σ J).arrow) : Epi (generatedSubobjectHom σ J) := by
  have h2 : Epi (imageSubobject (generatedSubobjectHom σ J)).arrow :=
    @IsIso.epi_of_iso _ _ _ _ _ h
  have h3 : Epi (factorThruImageSubobject (generatedSubobjectHom σ J) ≫
      (imageSubobject (generatedSubobjectHom σ J)).arrow) :=
    @epi_comp _ _ _ _ _ _ inferInstance _ h2
  rwa [imageSubobject_arrow_comp] at h3

/-- **On a quasi-compact scheme, a module of finite type generated by global sections is generated
by finitely many of them.** This is Modules, Lemma 17.9.7 ([Stacks, Tag 01BB]) for generation by
global sections. -/
theorem isFinGen_of_generatingSections [CompactSpace X] {M : X.Modules}
    (hft : SheafOfModules.IsFiniteType.{u, u, u} M) (σ : M.GeneratingSections) : IsFinGen M := by
  classical
  obtain ⟨J, hJ⟩ := exists_isIso_generatedSubobject_arrow hft σ
  exact (isFinGen_freeModule (X := X) (↥J)).of_epi (generatedSubobjectHom σ J)
    (epi_generatedSubobjectHom σ J hJ)

/-! ### Finite type of an invertible module -/

/-- **An invertible module is of finite type.** -/
theorem isFiniteType_of_isInvertibleModule (L : X.Modules) [IsInvertibleModule X L] :
    SheafOfModules.IsFiniteType.{u, u, u} L :=
  have h := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree L 1
  have := (Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry L).2 h
  Stacks.FiniteLocallyFree.isFiniteType L

/-! ### The affine case -/

/-- **[Stacks, Tag 01PB] on the whole of an affine scheme**: a quasi-coherent module of finite
type on an affine scheme is generated by finitely many global sections. -/
theorem isFinGen_of_isAffine [IsAffine X] (M : X.Modules) (hqc : M.IsQuasicoherent)
    (hft : SheafOfModules.IsFiniteType.{u, u, u} M) : IsFinGen M :=
  have := hqc
  isFinGen_of_generatingSections hft (generatingSectionsOfIsAffine M)

/-- **Every tensor power of an invertible module on an affine scheme is generated by finitely many
global sections.** -/
theorem isFinGen_tensorPowModule_of_isAffine [IsAffine X] (L : X.Modules)
    [IsInvertibleModule X L] (n : ℤ) : IsFinGen (tensorPowModule X L n) :=
  isFinGen_of_isAffine _ (Stacks.AmpleGlobalGeneration.isQuasicoherent_tensorPowModule L n)
    (isFiniteType_of_isInvertibleModule _)

/-- **The first half of clause (7) of [Stacks, Tag 01Q3] on an affine scheme**, with `n₀ = 0`:
every tensor power of `L`, of whatever degree, is generated by finitely many global sections. -/
theorem isEventuallyFinGenPowers_of_isAffine [IsAffine X] (L : X.Modules)
    [IsInvertibleModule X L] : IsEventuallyFinGenPowers X L :=
  ⟨0, fun n _ => isFinGen_tensorPowModule_of_isAffine L n⟩

/-- **The second half of clause (7) of [Stacks, Tag 01Q3] on an affine scheme**, with the trivial
twist: a finite-type quasi-coherent module on an affine scheme needs no twist at all. -/
theorem isFinGenAfterSomeTwist_of_isAffine [IsAffine X] (L : X.Modules)
    [IsInvertibleModule X L] : IsFinGenAfterSomeTwist X L := fun F hF hFt =>
  ⟨0, (isFinGen_of_isAffine F hF hFt).tensor (isFinGen_tensorPowModule_of_isAffine L 0)⟩

/-- **Clause (7) of [Stacks, Tag 01Q3] holds on every affine scheme**, for every invertible
module and with no ampleness hypothesis: `F ⊗ L ^⊗ n` is generated by finitely many global
sections for every `n`, so `n₀ = 0` serves. -/
@[ega "II 4.5.8" "special case"]
theorem isEventuallyGloballyGenerated_of_isAffine [IsAffine X] (L : X.Modules)
    [IsInvertibleModule X L] :
    Stacks.AmpleGlobalGeneration.IsEventuallyGloballyGenerated X L := fun F hF hFt =>
  ⟨0, fun n _ => (isFinGen_of_isAffine F hF hFt).tensor
    (isFinGen_tensorPowModule_of_isAffine L n)⟩

/-- **Clause (8) of [Stacks, Tag 01Q3] holds on every affine scheme**: every finite-type
quasi-coherent module is a quotient of a finite direct sum of negative tensor powers of `L` of
arbitrarily negative degree, with quasi-coherent kernel. -/
theorem isQuotientOfNegativeTwists_of_isAffine [IsAffine X] (L : X.Modules)
    [IsInvertibleModule X L] :
    Stacks.AmpleGlobalGeneration.IsQuotientOfNegativeTwists X L :=
  Stacks.AmpleGlobalGeneration.isQuotientOfNegativeTwists_of_isEventuallyGloballyGenerated
    (isEventuallyGloballyGenerated_of_isAffine L)

end Stacks.AmpleEventualGeneration

end
