module

public import StacksFrontier.AlgebraicGeometry.AmpleEventualGeneration.Generation
public import StacksFrontier.AlgebraicGeometry.RelativeVeryAmple.TensorPower

/-!
# Eventual global generation from its two halves

Let `L` be an invertible module on a scheme `X`. Clause (7) of [Stacks, Tag 01Q3],
`Stacks.AmpleGlobalGeneration.IsEventuallyGloballyGenerated`, says that for every quasi-coherent
`𝒪_X`-module `F` of finite type there is an `n₀` with `F ⊗ L ^⊗ n` generated by finitely many
global sections for every `n ≥ n₀`. This file shows that clause (7) follows from the conjunction of
two weaker statements:

1. `IsEventuallyFinGenPowers`: the powers `L ^⊗ n` are themselves generated by finitely many
   global sections for all `n ≥ n₀`.
2. `IsFinGenAfterSomeTwist`: every quasi-coherent `F` of finite type is generated by finitely many
   global sections after some twist.

Conversely, clause (7) implies (2). The first statement is reduced to a residue-class criterion:
if `L ^⊗ d` is generated by finitely many global sections for some `d > 0`, and some power of `L`
in every residue class modulo `d` is, then every sufficiently positive power is.

## Main definitions

* `Stacks.AmpleEventualGeneration.IsEventuallyFinGenPowers`: the tensor powers of `L` are
  generated by finitely many global sections in every sufficiently positive degree.
* `Stacks.AmpleEventualGeneration.IsFinGenAfterSomeTwist`: every quasi-coherent module of finite
  type is generated by finitely many global sections after some twist by `L`.

## Main results

* `Stacks.AmpleEventualGeneration.mem_of_le_of_forall_emod`: an additively closed set of integers
  containing `d > 0` and a representative below `N` of every residue class modulo `d` contains
  every integer at least `N`.
* `Stacks.AmpleEventualGeneration.IsFinGen.tensorPow_add`: if `L ^⊗ a` and `L ^⊗ b` are generated
  by finitely many global sections then so is `L ^⊗ (a + b)`.
* `Stacks.AmpleEventualGeneration.isEventuallyFinGenPowers_of_forall_emod`: the residue-class
  criterion for `IsEventuallyFinGenPowers`.
* `Stacks.AmpleEventualGeneration.isEventuallyFinGenPowers_of_forall_exists_pow`: the same
  criterion, with hypothesis clause (5) of [Stacks, Tag 01Q3] for `L ^⊗ d` applied to `L ^⊗ j`.
* `Stacks.AmpleEventualGeneration.isEventuallyGloballyGenerated_of_isEventuallyFinGenPowers`:
  clause (7) of [Stacks, Tag 01Q3] from its two halves.
* `Stacks.AmpleEventualGeneration.isFinGenAfterSomeTwist_of_isEventuallyGloballyGenerated`:
  clause (7) implies `IsFinGenAfterSomeTwist`.
* `Stacks.AmpleEventualGeneration.isQuotientOfNegativeTwists_of_isEventuallyFinGenPowers`:
  clause (8) of [Stacks, Tag 01Q3] from the two halves of clause (7).
* `Stacks.AmpleEventualGeneration.isEventuallyFinGenPowers_of_isFinGen`: if `L` is generated by
  finitely many global sections then so is every nonnegative tensor power of `L`.
* `Stacks.AmpleEventualGeneration.isEventuallyGloballyGenerated_unitModule_iff`: for the
  structure sheaf, clause (7) is equivalent to `IsFinGenAfterSomeTwist`.

## Implementation notes

The degrees are integers, as in `Stacks.Ample.tensorPowModule`, so the residue arithmetic uses
`Int.emod`. The addition law `tensorPowAdd` takes its target degree as an equation `a + b = c`.

## References

* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.Ample AlgebraicGeometry.SheafOfModules

universe u

namespace Stacks.AmpleEventualGeneration

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

open Stacks.AmpleGlobalGeneration

/-! ### Integer arithmetic -/

/-- **An additively closed set of integers which contains a representative below `N` of every
residue class modulo `d` contains every integer at least `N`.** -/
theorem mem_of_le_of_forall_emod {S : Set ℤ} (hadd : ∀ a ∈ S, ∀ b ∈ S, a + b ∈ S) {d : ℤ}
    (hd : 0 < d) (hdS : d ∈ S) {N : ℤ} (h : ∀ j : ℤ, ∃ e ∈ S, e ≤ N ∧ e % d = j % d) {n : ℤ}
    (hn : N ≤ n) : n ∈ S := by
  obtain ⟨e, heS, heN, hemod⟩ := h n
  have hdvd : d ∣ n - e := Int.ModEq.dvd hemod
  obtain ⟨k, hk⟩ := hdvd
  have hk0 : 0 ≤ k := by
    by_contra hneg
    have hk1 : k ≤ -1 := by omega
    have : d * k ≤ d * (-1) := mul_le_mul_of_nonneg_left hk1 hd.le
    omega
  obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hk0
  have key : ∀ m : ℕ, e + d * (m : ℤ) ∈ S := by
    intro m
    induction m with
    | zero => simpa using heS
    | succ m ih =>
      have hring : e + d * ((m : ℤ) + 1) = e + d * (m : ℤ) + d := by ring
      rw [show ((m + 1 : ℕ) : ℤ) = (m : ℤ) + 1 from by push_cast; ring, hring]
      exact hadd _ ih _ hdS
  have hn' : n = e + d * (m : ℤ) := by omega
  rw [hn']
  exact key m

/-- A representative of every residue class modulo `d` can be chosen below a single bound, since
there are only `d` classes. -/
theorem exists_bound_of_forall_emod {Q : ℤ → Prop} {d : ℤ} (hd : 0 < d)
    (h : ∀ j : ℤ, ∃ e, Q e ∧ e % d = j % d) :
    ∃ N : ℤ, ∀ j : ℤ, ∃ e, Q e ∧ e ≤ N ∧ e % d = j % d := by
  classical
  choose f hQf hmodf using h
  have hne : (Finset.Ico (0 : ℤ) d).Nonempty := ⟨0, by simp [hd]⟩
  refine ⟨((Finset.Ico (0 : ℤ) d).image f).max' (hne.image f), fun j => ?_⟩
  have hmem : j % d ∈ Finset.Ico (0 : ℤ) d :=
    Finset.mem_Ico.mpr ⟨Int.emod_nonneg j hd.ne', Int.emod_lt_of_pos j hd⟩
  refine ⟨f (j % d), hQf _, Finset.le_max' _ _ (Finset.mem_image_of_mem f hmem), ?_⟩
  rw [hmodf, Int.emod_emod_of_dvd _ dvd_rfl]

/-! ### The two halves of clause (7) -/

variable (X : Scheme.{u}) (L : X.Modules) [IsInvertibleModule X L]

/-- **The first half of clause (7) of Stacks Tag 01Q3**: the tensor powers of `L` are themselves
generated by finitely many global sections in every sufficiently positive degree. -/
def IsEventuallyFinGenPowers : Prop :=
  ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n → IsFinGen (tensorPowModule X L n)

/-- **The second half of clause (7) of Stacks Tag 01Q3**: every quasi-coherent module of finite
type is generated by finitely many global sections after *some* twist. -/
def IsFinGenAfterSomeTwist : Prop :=
  ∀ F : X.Modules, F.IsQuasicoherent → SheafOfModules.IsFiniteType.{u, u, u} F →
    ∃ m : ℤ, IsFinGen (F ⊗ tensorPowModule X L m)

/-! ### Degrees add -/

variable {X L}

/-- The isomorphism `L ^⊗ a ⊗ L ^⊗ b ≅ L ^⊗ c` for integers with `a + b = c`. -/
def tensorPowAdd {a b c : ℤ} (h : a + b = c) :
    tensorPowModule X L a ⊗ tensorPowModule X L b ≅ tensorPowModule X L c :=
  h ▸ tensorPowAddIso X.presheaf (sheafCondition X) L a b

/-- **Degrees add**: if `L ^⊗ a` and `L ^⊗ b` are each generated by finitely many global sections
then so is `L ^⊗ (a + b)`. -/
theorem IsFinGen.tensorPow_add {a b c : ℤ} (h : a + b = c)
    (ha : IsFinGen (tensorPowModule X L a)) (hb : IsFinGen (tensorPowModule X L b)) :
    IsFinGen (tensorPowModule X L c) :=
  (ha.tensor hb).of_iso (tensorPowAdd h)

/-- The set of degrees in which `L` has a tensor power generated by finitely many global sections
is closed under addition. -/
theorem finGenDegrees_add {a b : ℤ} (ha : IsFinGen (tensorPowModule X L a))
    (hb : IsFinGen (tensorPowModule X L b)) : IsFinGen (tensorPowModule X L (a + b)) :=
  IsFinGen.tensorPow_add rfl ha hb

/-- **The residue-class criterion for the first half of clause (7).** If some positive power
`L ^⊗ d` is generated by finitely many global sections, and if for every residue class modulo `d`
*some* power of `L` in that class is, then every sufficiently positive power is. -/
theorem isEventuallyFinGenPowers_of_forall_emod {d : ℤ} (hd : 0 < d)
    (hdgen : IsFinGen (tensorPowModule X L d))
    (h : ∀ j : ℤ, ∃ e : ℤ, IsFinGen (tensorPowModule X L e) ∧ e % d = j % d) :
    IsEventuallyFinGenPowers X L := by
  obtain ⟨N, hN⟩ := exists_bound_of_forall_emod hd h
  refine ⟨N, fun n hn => ?_⟩
  exact mem_of_le_of_forall_emod
    (S := {e : ℤ | IsFinGen (tensorPowModule X L e)})
    (fun a ha b hb => finGenDegrees_add ha hb) hd hdgen
    (fun j => by obtain ⟨e, he, hle, hmod⟩ := hN j; exact ⟨e, he, hle, hmod⟩) hn

/-- **The residue-class criterion in the shape the source supplies it.** If `L ^⊗ d` is generated
by finitely many global sections for some `d > 0`, and if for every `j` some tensor power of
`L ^⊗ d` twists `L ^⊗ j` into a module generated by finitely many global sections, then every
sufficiently positive power of `L` is so generated. -/
theorem isEventuallyFinGenPowers_of_forall_exists_pow {d : ℤ} (hd : 0 < d)
    (hdgen : IsFinGen (tensorPowModule X L d))
    (h : ∀ j : ℤ, ∃ k : ℕ, IsFinGen
      (tensorPowModule X L j ⊗ tensorPowModule X (tensorPowModule X L d) (k : ℤ))) :
    IsEventuallyFinGenPowers X L := by
  refine isEventuallyFinGenPowers_of_forall_emod hd hdgen fun j => ?_
  obtain ⟨k, hk⟩ := h j
  refine ⟨j + d * (k : ℤ), hk.of_iso ?_, by simp⟩
  exact whiskerLeftIso (tensorPowModule X L j)
    (Stacks.RelativeVeryAmple.tensorPowModulePowIso X L d k) ≪≫ tensorPowAdd rfl

/-! ### The reduction -/

/-- **Clause (7) of Stacks Tag 01Q3 from its two halves.** If every sufficiently positive tensor
power of `L` is generated by finitely many global sections, and every quasi-coherent module of
finite type becomes so generated after some twist, then every quasi-coherent module of finite type
is so generated after every sufficiently positive twist. -/
theorem isEventuallyGloballyGenerated_of_isEventuallyFinGenPowers
    (hpow : IsEventuallyFinGenPowers X L) (htwist : IsFinGenAfterSomeTwist X L) :
    Stacks.AmpleGlobalGeneration.IsEventuallyGloballyGenerated X L := by
  intro F hF hFt
  obtain ⟨n₀, hn₀⟩ := hpow
  obtain ⟨m, hm⟩ := htwist F hF hFt
  refine ⟨m + n₀, fun n hn => ?_⟩
  have hk : n₀ ≤ n - m := by omega
  exact (hm.tensor (hn₀ (n - m) hk)).of_iso
    (α_ F (tensorPowModule X L m) (tensorPowModule X L (n - m)) ≪≫
      whiskerLeftIso F (tensorPowAdd (a := m) (b := n - m) (c := n) (by ring)))

/-- The second half of clause (7) is implied by clause (7). -/
theorem isFinGenAfterSomeTwist_of_isEventuallyGloballyGenerated
    (h : Stacks.AmpleGlobalGeneration.IsEventuallyGloballyGenerated X L) :
    IsFinGenAfterSomeTwist X L := by
  intro F hF hFt
  obtain ⟨n₀, hn₀⟩ := h F hF hFt
  exact ⟨n₀, hn₀ n₀ le_rfl⟩

/-- **Clause (8) of Stacks Tag 01Q3 from the two halves of clause (7)**: every quasi-coherent
module of finite type is a quotient of a finite direct sum of negative tensor powers of `L`, of
arbitrarily negative degree. -/
theorem isQuotientOfNegativeTwists_of_isEventuallyFinGenPowers
    (hpow : IsEventuallyFinGenPowers X L) (htwist : IsFinGenAfterSomeTwist X L) :
    Stacks.AmpleGlobalGeneration.IsQuotientOfNegativeTwists X L :=
  Stacks.AmpleGlobalGeneration.isQuotientOfNegativeTwists_of_isEventuallyGloballyGenerated
    (isEventuallyGloballyGenerated_of_isEventuallyFinGenPowers hpow htwist)

/-! ### Two instances of the first half -/

/-- The zeroth tensor power of `L` is generated by finitely many global sections. -/
theorem isFinGen_tensorPowModule_zero :
    IsFinGen (tensorPowModule X L 0) :=
  (isFinGen_unitModule X).of_iso (tensorPowModuleZeroIso X L).symm

/-- **If `L` itself is generated by finitely many global sections then so is every nonnegative
tensor power.** -/
theorem isEventuallyFinGenPowers_of_isFinGen (h : IsFinGen L) :
    IsEventuallyFinGenPowers X L := by
  refine isEventuallyFinGenPowers_of_forall_emod (d := 1) one_pos
    (h.of_iso (tensorPowModuleOneIso X L).symm) fun j => ⟨0, isFinGen_tensorPowModule_zero, ?_⟩
  simp

/-- **The first half of clause (7) holds unconditionally for the structure sheaf**: every tensor
power of `𝒪_X` is generated by finitely many global sections. -/
theorem isEventuallyFinGenPowers_unitModule (X : Scheme.{u}) :
    IsEventuallyFinGenPowers X (unitModule X) :=
  ⟨0, fun n _ => (isFinGen_unitModule X).of_iso (unitTensorPowIso X n)⟩

/-- **For the structure sheaf, clause (7) of Stacks Tag 01Q3 is equivalent to its second half**:
every quasi-coherent module of finite type is generated by finitely many global sections after
every sufficiently positive twist by `𝒪_X` if and only if it is after some twist. -/
theorem isEventuallyGloballyGenerated_unitModule_iff (X : Scheme.{u}) :
    Stacks.AmpleGlobalGeneration.IsEventuallyGloballyGenerated X (unitModule X) ↔
      IsFinGenAfterSomeTwist X (unitModule X) :=
  ⟨isFinGenAfterSomeTwist_of_isEventuallyGloballyGenerated,
    isEventuallyGloballyGenerated_of_isEventuallyFinGenPowers
      (isEventuallyFinGenPowers_unitModule X)⟩

end Stacks.AmpleEventualGeneration

end
