module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.InfinitesimalNeighbourhood.ChartStages

/-!
# The ideal of the reduction read on an affine formal chart

Let `W` be an fppf sheaf with a reduction `i : W_red ⟶ W`. For a section `t ∈ W(T)` over an
affine object `T`, `AlgebraicGeometry.FormalSpace.IsReductionIdeal i t K` says that `K` is the
ideal of the closed immersion `T ×_W W_red ⟶ T`, read through the points it cuts out. This ideal
is unique, it is compatible with restriction, and on an affine formal chart `f : Spf A ⟶ W`
(representable by algebraic spaces and étale) it is generated by the image of the ideal `𝔞` of
topologically nilpotent elements of `A`. Consequently a section of the chart lies in the stage
`Spec(A/𝔞^(k+1))` exactly when the `(k+1)`st power of the ideal of the reduction vanishes: this is
the description of the `k`-th infinitesimal neighbourhood `W_k` of `W_red` in `W` of Stacks 0GHM.

## Main definitions

* `AlgebraicGeometry.FormalSpace.IsReductionIdeal`: `K` is the ideal of `T ×_W W_red` in `T`.

## Main results

* `AlgebraicGeometry.FormalSpace.IsReductionIdeal.unique`: the ideal is unique.
* `AlgebraicGeometry.FormalSpace.IsReductionIdeal.map`: its restriction along `V ⟶ T` is the
  ideal generated by its image.
* `AlgebraicGeometry.FormalSpace.isReductionIdeal_chart`: on an affine formal chart it is the
  ideal generated by the image of `𝔞`.
* `AlgebraicGeometry.FormalSpace.mem_range_powStage_iff`: a chart section lies in the stage
  `Spec(A/𝔞^(k+1))` iff the `(k+1)`st power of the ideal of the reduction vanishes.

## References

* [Stacks Project, Tag 0GHM](https://stacks.math.columbia.edu/tag/0GHM)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalRing

universe u

namespace AlgebraicGeometry.FormalSpace

attribute [local instance] sheaf_hasColimits

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- `K` is the ideal of the base change `T ×_W W_red ⟶ T` of the reduction `i : W_red ⟶ W` along
`t ∈ W(T)`, read through the points it cuts out: a morphism `h : T' ⟶ T` of the site carries `t`
into `W_red` exactly when `h` kills `K`. -/
def IsReductionIdeal {W Wred : FppfSheaf B S hS} (i : Wred ⟶ W) {T : BigFppfOver B S hS}
    (t : W.obj.obj (op T)) (K : Ideal Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) : Prop :=
  ∀ (T' : BigFppfOver B S hS) (h : T' ⟶ T),
    (∃ r : Wred.obj.obj (op T'), i.hom.app (op T') r = W.obj.map h.op t) ↔
      K ≤ RingHom.ker ((BigFppfOver.toScheme B S hS).map h).appTop.hom

variable {W Wred : FppfSheaf B S hS} {i : Wred ⟶ W}

/-- Every section over an affine object has an ideal of the reduction. -/
theorem IsReduction.exists_isReductionIdeal (hred : IsReduction B S hS W Wred i)
    {T : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (t : W.obj.obj (op T)) : ∃ K, IsReductionIdeal i t K :=
  hred.exists_reductionIdeal T t

/-- Over an affine object an ideal is determined by the morphisms of the site from affine objects
killing it. -/
theorem ideal_eq_of_forall_le_ker_iff {T : BigFppfOver B S hS}
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    {K₁ K₂ : Ideal Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)}
    (h : ∀ (T' : BigFppfOver B S hS) (h : T' ⟶ T),
      IsAffine ((BigFppfOver.toScheme B S hS).obj T') →
      (K₁ ≤ RingHom.ker ((BigFppfOver.toScheme B S hS).map h).appTop.hom ↔
        K₂ ≤ RingHom.ker ((BigFppfOver.toScheme B S hS).map h).appTop.hom)) :
    K₁ = K₂ := by
  obtain ⟨T₁, h₁, hc₁, hk₁⟩ := exists_siteHom_ker_appTop_eq T K₁
  obtain ⟨T₂, h₂, hc₂, hk₂⟩ := exists_siteHom_ker_appTop_eq T K₂
  exact le_antisymm
    (hk₂ ▸ (h T₂ h₂ (isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map h₂))).2 hk₂.ge)
    (hk₁ ▸ (h T₁ h₁ (isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map h₁))).1 hk₁.ge)

/-- **The ideal of the reduction is unique** over an affine object. -/
theorem IsReductionIdeal.unique {T : BigFppfOver B S hS}
    [IsAffine ((BigFppfOver.toScheme B S hS).obj T)] {t : W.obj.obj (op T)}
    {K₁ K₂ : Ideal Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)}
    (h₁ : IsReductionIdeal i t K₁) (h₂ : IsReductionIdeal i t K₂) : K₁ = K₂ :=
  ideal_eq_of_forall_le_ker_iff fun T' h _ => (h₁ T' h).symm.trans (h₂ T' h)

/-- **The ideal of the reduction is compatible with restriction**: along `h : V ⟶ T` it is the
ideal generated by the image of the ideal over `T`. -/
theorem IsReductionIdeal.map {T V : BigFppfOver B S hS} {t : W.obj.obj (op T)}
    {K : Ideal Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)} (hK : IsReductionIdeal i t K)
    (h : V ⟶ T) :
    IsReductionIdeal i (W.obj.map h.op t)
      (Ideal.map ((BigFppfOver.toScheme B S hS).map h).appTop.hom K) := by
  intro T' g
  rw [← Functor.map_comp_apply, ← op_comp, hK T' (g ≫ h), Ideal.map_le_iff_le_comap,
    Functor.map_comp, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, ← RingHom.comap_ker]

variable {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsLinearTopology A A]

/-- The ideal `𝔞` of topologically nilpotent elements of `A`, transported to the global sections
of `Spec A` and pushed along the ring map of a morphism `T ⟶ Spec(A/J) ⟶ Spec A`. -/
abbrev chartNilIdeal (D : QuotientSystem B S hS A)
    (J : { I : Ideal A // IsWeakIdealOfDefinition I }) {T : BigFppfOver B S hS}
    (g : T ⟶ D.stageObj J) : Ideal Γ((BigFppfOver.toScheme B S hS).obj T, ⊤) :=
  Ideal.map ((BigFppfOver.toScheme B S hS).map g ≫ stageQuotientSpecMap D J).appTop.hom
    (Ideal.comap (Scheme.ΓSpecIso (.of A)).hom.hom (topologicalNilradical A))

omit [IsTopologicalRing A] [IsLinearTopology A A] in
/-- A section of a formal spectrum given by `g : T ⟶ Spec(A/J)` restricts along `h : T' ⟶ T` to
the section given by `h ≫ g`. -/
theorem sectionEquiv_symm_map_eq (D : QuotientSystem B S hS A)
    (J : { I : Ideal A // IsWeakIdealOfDefinition I }) {T T' : BigFppfOver B S hS}
    {y : (formalSpectrum D).obj.obj (op T)} {g : T ⟶ D.stageObj J}
    (hg : (Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).symm y =
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).map g ≫ stageIncl D J)
    (h : T' ⟶ T) :
    (Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).symm ((formalSpectrum D).obj.map h.op y) =
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).map (h ≫ g) ≫ stageIncl D J := by
  apply (Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).injective
  rw [Equiv.apply_symm_apply, Functor.map_comp, Category.assoc, Sheaf.sectionEquiv_map_comp,
    ← hg, Equiv.apply_symm_apply]

/-- A section of a formal spectrum given by `g : T ⟶ Spec(A/J)` lies in the stage `Spec(A/L)`
exactly when the ring map of `T ⟶ Spec(A/J) ⟶ Spec A` kills `L`. -/
theorem mem_range_stageIncl_iff (hA : IsWeaklyAdmissible A) (D : QuotientSystem B S hS A)
    (J L : { I : Ideal A // IsWeakIdealOfDefinition I }) {T : BigFppfOver B S hS}
    {y : (formalSpectrum D).obj.obj (op T)} {g : T ⟶ D.stageObj J}
    (hg : (Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).symm y =
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).map g ≫ stageIncl D J) :
    y ∈ (Subfunctor.range (stageIncl D L).hom).obj (op T) ↔
      Ideal.map ((BigFppfOver.toScheme B S hS).map g ≫ stageQuotientSpecMap D J).appTop.hom
        (Ideal.comap (Scheme.ΓSpecIso (.of A)).hom.hom L.1) = ⊥ := by
  rw [eq_bot_iff, Ideal.map_le_iff_le_comap]
  constructor
  · intro hy
    obtain ⟨z, hz⟩ := exists_siteHom_of_mem_range_stageIncl D L hy
    obtain ⟨l, hl⟩ := (stage_factor_iff hA D J L g (𝟙 T)).1 ⟨z, by rw [← hz, Category.id_comp, hg]⟩
    rw [Category.id_comp] at hl
    intro ξ hξ
    exact ((exists_factor_stageQuotientSpecMap_iff D L _).1 ⟨l, hl⟩) ξ hξ
  · intro h
    obtain ⟨z, hz⟩ := (stage_factor_iff hA D J L g (𝟙 T)).2
      ((exists_factor_stageQuotientSpecMap_iff D L _).2 fun ξ hξ => by
        rw [Category.id_comp]
        exact h hξ)
    refine mem_range_stageIncl_of_eq D L z ?_
    rw [hz, Category.id_comp, ← hg]

/-- **The ideal of the reduction on an affine formal chart.** For an affine formal chart
`f : Spf A ⟶ W` (representable by algebraic spaces and étale) and a section `y` of `Spf A` given
by `g : T ⟶ Spec(A/J)`, the ideal of `T ×_W W_red` along `f(y)` is generated by the image of the
ideal `𝔞` of topologically nilpotent elements of `A`. -/
theorem isReductionIdeal_chart (hA : IsWeaklyAdmissible A) (D : QuotientSystem B S hS A)
    (hred : IsReduction B S hS W Wred i) (f : formalSpectrum D ⟶ W)
    (hfrep : Space.IsRepresentableByAlgebraicSpacesULift.{u + 1} B S hS f.hom)
    (hfet : Space.HasPropertyULift.{u + 1} B S hS
      (fun _ _ g ↦ Space.IsEtaleULift.{u + 1} B S hS g.hom) f.hom hfrep)
    (J : { I : Ideal A // IsWeakIdealOfDefinition I }) {T : BigFppfOver B S hS}
    {y : (formalSpectrum D).obj.obj (op T)} {g : T ⟶ D.stageObj J}
    (hg : (Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).symm y =
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).map g ≫ stageIncl D J) :
    IsReductionIdeal i (f.hom.app (op T) y) (chartNilIdeal D J g) := by
  intro T' h
  rw [← NatTrans.naturality_apply, Ideal.map_le_iff_le_comap]
  have key := mem_range_stageIncl_iff hA D J (nilWeakIdeal hA) (sectionEquiv_symm_map_eq D J hg h)
  rw [eq_bot_iff, Ideal.map_le_iff_le_comap, Functor.map_comp, Category.assoc,
    Scheme.Hom.comp_appTop] at key
  constructor
  · rintro ⟨r, hr⟩
    exact key.1 (mem_range_nilStage_of_mapsTo_reduction hA D hred f hfrep hfet _ r hr)
  · intro hle
    exact exists_mapsTo_reduction_of_mem_range_nilStage hA D hred f _ (key.2 hle)

omit [IsTopologicalRing A] in
/-- The ideal `𝔞^(k+1)`, transported to global sections and pushed forward, is the `(k+1)`st power
of the pushed-forward `𝔞`. -/
theorem map_comap_pow_eq (D : QuotientSystem B S hS A)
    (J : { I : Ideal A // IsWeakIdealOfDefinition I }) {T : BigFppfOver B S hS}
    (g : T ⟶ D.stageObj J) (k : ℕ) :
    Ideal.map ((BigFppfOver.toScheme B S hS).map g ≫ stageQuotientSpecMap D J).appTop.hom
        (Ideal.comap (Scheme.ΓSpecIso (.of A)).hom.hom (topologicalNilradical A ^ (k + 1))) =
      chartNilIdeal D J g ^ (k + 1) := by
  let e := (Scheme.ΓSpecIso (.of A)).commRingCatIsoToRingEquiv
  have h1 : Ideal.comap (Scheme.ΓSpecIso (.of A)).hom.hom (topologicalNilradical A ^ (k + 1)) =
      (Ideal.comap (Scheme.ΓSpecIso (.of A)).hom.hom (topologicalNilradical A)) ^ (k + 1) := by
    show Ideal.comap e _ = (Ideal.comap e _) ^ (k + 1)
    rw [← Ideal.map_symm, ← Ideal.map_symm, Ideal.map_pow]
  rw [h1, Ideal.map_pow]

/-- **A chart section lies in the `k`-th stage iff the `(k+1)`st power of the ideal of the
reduction vanishes.** For an affine formal chart `f : Spf A ⟶ W` with `𝔞^(k+1)` open, a section
`y` of `Spf A` over an affine object lies in the stage `Spec(A/𝔞^(k+1))` exactly when `K^(k+1) = 0`
for the ideal `K` of `T ×_W W_red` along `f(y)`. -/
theorem mem_range_powStage_iff (hA : IsWeaklyAdmissible A)
    (hopen : ∀ k : ℕ, IsOpen ((topologicalNilradical A ^ (k + 1) : Ideal A) : Set A))
    (D : QuotientSystem B S hS A)
    (hred : IsReduction B S hS W Wred i) (f : formalSpectrum D ⟶ W)
    (hfrep : Space.IsRepresentableByAlgebraicSpacesULift.{u + 1} B S hS f.hom)
    (hfet : Space.HasPropertyULift.{u + 1} B S hS
      (fun _ _ g ↦ Space.IsEtaleULift.{u + 1} B S hS g.hom) f.hom hfrep)
    (k : ℕ) {T : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
    (y : (formalSpectrum D).obj.obj (op T))
    {K : Ideal Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)}
    (hK : IsReductionIdeal i (f.hom.app (op T) y) K) :
    y ∈ (Subfunctor.range (stageIncl D (powNilWeakIdeal hopen k)).hom).obj (op T) ↔
      K ^ (k + 1) = ⊥ := by
  obtain ⟨J, g, hg₀⟩ := exists_stage_hom hA D T
    ((Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).symm y)
  have hg : (Sheaf.sectionEquiv (BigFppfOver.topology B S hS)).symm y =
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).map g ≫ stageIncl D J := hg₀
  rw [hK.unique (isReductionIdeal_chart hA D hred f hfrep hfet J hg),
    mem_range_stageIncl_iff hA D J _ hg, map_comap_pow_eq]

end AlgebraicGeometry.FormalSpace

end
