module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.QuasiCompactQuasiSeparatedStages
public import StacksFrontier.AlgebraicGeometry.FormalSpace.RepresentableEtaleCancellation
public import StacksFrontier.AlgebraicGeometry.FormalSpace.EtaleSurjective
public import StacksFrontier.AlgebraicGeometry.FormalSpace.ReductionDescent
public import StacksFrontier.AlgebraicGeometry.FormalSpace.Surjective
public import StacksFrontier.AlgebraicGeometry.Spaces.LargeValuedEtaleAtlas
public import StacksFrontier.AlgebraicGeometry.Spaces.LargeValuedFiniteType
public import StacksFrontier.AlgebraicGeometry.Spaces.SubsheafImageCartesian
public import StacksFrontier.AlgebraicGeometry.FormalSpace.RepresentableEtaleCancellationOnSite

/-!
# The stages of a quasi-compact quasi-separated formal algebraic space, as subsheaves

Let `S` be a scheme contained in a big fppf site `B`, let `X` be an fppf sheaf over `S` and let
`c : Y ⟶ X` be a chart which is representable by objects of the site, surjective and étale. Let
`Z ⊆ Y` be a closed subscheme which is *invariant* for the étale equivalence relation `Y ×_X Y`,
in the sense that `Y ×_X Z` is an object of the site whose projection to `Y` factors through `Z`.
Then `Z` is the fibre product over `X` of `Y` with the subsheaf
`CategoryTheory.Sheaf.image (z ≫ c)` of `X` generated by `Z`, and this subsheaf is an algebraic
space over `S`. For two such stages, one factoring through the other, the induced morphism of
subsheaves is a representable thickening, surjective on points.

## Main definitions

* `AlgebraicGeometry.FormalSpace.imageTransition`: the transition morphism between the
  subsheaves of `X` generated by two stages, one factoring through the other.

## Main results

* `AlgebraicGeometry.FormalSpace.isPullback_toImage_of_invariant`: the square relating an
  invariant stage, the chart, and the subsheaf of `X` the stage generates is cartesian.
* `AlgebraicGeometry.FormalSpace.isPullback_uliftYonedaHom_toImage`: the same square read along
  the universe-lifted Yoneda embedding.
* `AlgebraicGeometry.FormalSpace.isAlgebraicSpaceULift_image_of_invariant`: the subsheaf of `X`
  generated by an invariant stage is an algebraic space over `S`.
* `AlgebraicGeometry.FormalSpace.isThickening_transition`: a transition of stages is a
  thickening of schemes.
* `AlgebraicGeometry.FormalSpace.isPullback_imageTransition`: the square relating two stages and
  the two subsheaves they generate is cartesian.
* `AlgebraicGeometry.FormalSpace.surjective_pointsMapULift_imageTransition`: a transition of
  subsheaves is surjective on points.
* `AlgebraicGeometry.FormalSpace.isRepresentableThickening_imageTransition`: a transition of
  stage subsheaves is a representable thickening.

## References

* [Stacks Project, Tag 0AJE](https://stacks.math.columbia.edu/tag/0AJE)
* [Stacks Project, Tag 0BGR](https://stacks.math.columbia.edu/tag/0BGR)
* [Stacks Project, Tag 083Q](https://stacks.math.columbia.edu/tag/083Q)
-/

@[expose] public section

open Opposite CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.FormalSpace

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable {Y X : FppfSheaf B S hS} (c : Y ⟶ X)

/-- For an invariant stage `z`, the square formed by `z`, the chart `c`, and the subsheaf of `X`
generated by `z` is cartesian. -/
theorem isPullback_toImage_of_invariant {Z : BigFppfOver B S hS}
    (z : (fppfYoneda B S hS).obj Z ⟶ Y) (hzpmono : Mono (uliftYonedaHom B S hS z))
    {R : BigFppfOver B S hS} (t r : R ⟶ Z)
    (hinv : IsPullback ((uliftYoneda.{u + 1}).map t ≫ uliftYonedaHom B S hS z)
      ((uliftYoneda.{u + 1}).map r) c.hom (uliftYonedaHom B S hS z ≫ c.hom)) :
    IsPullback z.hom (Sheaf.toImage (z ≫ c)).hom c.hom (Sheaf.imageι (z ≫ c)).hom := by
  classical
  have hzp : uliftYonedaHom B S hS z =
      ((fppfYonedaCompSheafToPresheaf' B S hS).app Z).inv ≫ z.hom := rfl
  refine Sheaf.isPullback_toImage_of_sieveOfSection_le z c ?_ ?_
  · have h2 : MorphismProperty.monomorphisms ((BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1))
        (((fppfYonedaCompSheafToPresheaf' B S hS).app Z).inv ≫ z.hom) := by
      show Mono _
      rwa [← hzp]
    exact (MorphismProperty.cancel_left_of_respectsIso
      (P := MorphismProperty.monomorphisms ((BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)))
      ((fppfYonedaCompSheafToPresheaf' B S hS).app Z).inv z.hom).1 h2
  · rintro U y V i ⟨w', hw'⟩
    have hcond : uliftYonedaEquiv.{u + 1}.symm (Y.obj.map i.op y) ≫ c.hom =
        uliftYonedaEquiv.{u + 1}.symm
            (((fppfYonedaCompSheafToPresheaf' B S hS).app Z).hom.app (op V) w') ≫
          (uliftYonedaHom B S hS z ≫ c.hom) := by
      rw [uliftYonedaEquiv_symm_comp, uliftYonedaEquiv_symm_comp]
      congr 1
      rw [NatTrans.naturality_apply, ← hw']
      simp only [unop_op, NatTrans.comp_app, ConcreteCategory.comp_apply,
        uliftYonedaHom_app B S hS z V w']
      rfl
    refine ⟨((fppfYonedaCompSheafToPresheaf' B S hS).app Z).inv.app (op V)
      (uliftYonedaEquiv.{u + 1}
        (hinv.lift (uliftYonedaEquiv.{u + 1}.symm (Y.obj.map i.op y))
          (uliftYonedaEquiv.{u + 1}.symm
            (((fppfYonedaCompSheafToPresheaf' B S hS).app Z).hom.app (op V) w')) hcond ≫
          (uliftYoneda.{u + 1}).map t)), ?_⟩
    show (((fppfYonedaCompSheafToPresheaf' B S hS).app Z).inv ≫ z.hom).app (op V) _ = _
    rw [← hzp, ← uliftYonedaEquiv_comp, Category.assoc, hinv.lift_fst,
      Equiv.apply_symm_apply]

/-- For an invariant stage `z`, the square formed by `z`, the chart `c`, and the subsheaf of `X`
generated by `z`, read along the universe-lifted Yoneda embedding, is cartesian. -/
theorem isPullback_uliftYonedaHom_toImage {Z : BigFppfOver B S hS}
    (z : (fppfYoneda B S hS).obj Z ⟶ Y) (hzpmono : Mono (uliftYonedaHom B S hS z))
    {R : BigFppfOver B S hS} (t r : R ⟶ Z)
    (hinv : IsPullback ((uliftYoneda.{u + 1}).map t ≫ uliftYonedaHom B S hS z)
      ((uliftYoneda.{u + 1}).map r) c.hom (uliftYonedaHom B S hS z ≫ c.hom)) :
    IsPullback (uliftYonedaHom B S hS z)
      (uliftYonedaHom B S hS (Sheaf.toImage (z ≫ c))) c.hom
      (Sheaf.imageι (z ≫ c)).hom :=
  (isPullback_toImage_of_invariant B S hS c z hzpmono t r hinv).of_iso'
    ((fppfYonedaCompSheafToPresheaf' B S hS).app Z).symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
    (Category.comp_id _).symm (Category.comp_id _).symm
    ((Category.id_comp _).trans (Category.comp_id _).symm)
    ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- The subsheaf of `X` generated by an invariant stage is an algebraic space over `S`. -/
theorem isAlgebraicSpaceULift_image_of_invariant {Z : BigFppfOver B S hS}
    (z : (fppfYoneda B S hS).obj Z ⟶ Y) (hzpmono : Mono (uliftYonedaHom B S hS z))
    {R : BigFppfOver B S hS} (t r : R ⟶ Z)
    (hinv : IsPullback ((uliftYoneda.{u + 1}).map t ≫ uliftYonedaHom B S hS z)
      ((uliftYoneda.{u + 1}).map r) c.hom (uliftYonedaHom B S hS z ≫ c.hom))
    (hcsurj : (Space.surjectiveOnSite B S hS).relative (uliftYoneda.{u + 1}) c.hom)
    (hcet : (Space.etaleOnSite B S hS).relative (uliftYoneda.{u + 1}) c.hom) :
    Space.IsAlgebraicSpaceULift.{u + 1} B S hS (Sheaf.image (z ≫ c)).obj := by
  have _ := MorphismProperty.relative_isStableUnderBaseChange
    (F := uliftYoneda.{u + 1} (C := BigFppfOver B S hS)) (Space.surjectiveOnSite B S hS)
  have _ := MorphismProperty.relative_isStableUnderBaseChange
    (F := uliftYoneda.{u + 1} (C := BigFppfOver B S hS)) (Space.etaleOnSite B S hS)
  have hsq := isPullback_uliftYonedaHom_toImage B S hS c z hzpmono t r hinv
  exact Space.isAlgebraicSpaceULift_of_relative_surjective_etale B S hS
    (Sheaf.image (z ≫ c)).property
    (Space.isAlgebraicSpaceULift_uliftYoneda.{u + 1} B S hS Z) _
    (MorphismProperty.of_isPullback hsq hcsurj) (MorphismProperty.of_isPullback hsq hcet)

section Transition

variable {Zi Zj : BigFppfOver B S hS}
  (zi : (fppfYoneda B S hS).obj Zi ⟶ Y) (zj : (fppfYoneda B S hS).obj Zj ⟶ Y)
  (w : Zi ⟶ Zj) (hw : (fppfYoneda B S hS).map w ≫ zj = zi)

include hw in
/-- An earlier stage generates a smaller subsheaf of `X` than a later one. -/
theorem sheafifyRange_le_of_factor :
    (Subfunctor.range (zi ≫ c).hom).sheafify (BigFppfOver.topology B S hS) ≤
      (Subfunctor.range (zj ≫ c).hom).sheafify (BigFppfOver.topology B S hS) := by
  have hXsheaf : Presieve.IsSheaf (BigFppfOver.topology B S hS) X.obj :=
    (isSheaf_iff_isSheaf_of_type _ X.obj).mp X.property
  refine Subfunctor.sheafify_le _ _ ?_ hXsheaf
    ((Subfunctor.range (zj ≫ c).hom).sheafify_isSheaf hXsheaf)
  refine le_trans ?_ (Subfunctor.le_sheafify (J := BigFppfOver.topology B S hS)
    (G := Subfunctor.range (zj ≫ c).hom))
  rw [← hw]
  exact Subfunctor.range_comp_le ((fppfYoneda B S hS).map w).hom (zj ≫ c).hom

include hw in
/-- The transition morphism between the subsheaves of `X` generated by two stages. -/
noncomputable def imageTransition :
    Sheaf.image (zi ≫ c) ⟶ Sheaf.image (zj ≫ c) :=
  ⟨Subfunctor.homOfLe (sheafifyRange_le_of_factor B S hS c zi zj w hw)⟩

include hw in
/-- The transition morphism commutes with the inclusions of the two subsheaves into `X`. -/
theorem imageTransition_comp_imageι :
    imageTransition B S hS c zi zj w hw ≫ Sheaf.imageι (zj ≫ c) =
      Sheaf.imageι (zi ≫ c) :=
  Sheaf.hom_ext (Subfunctor.homOfLe_ι (sheafifyRange_le_of_factor B S hS c zi zj w hw))

include hw in
/-- The transition morphism commutes with the maps from the two stages onto their subsheaves. -/
theorem toImage_comp_imageTransition :
    (fppfYoneda B S hS).map w ≫ Sheaf.toImage (zj ≫ c) =
      Sheaf.toImage (zi ≫ c) ≫ imageTransition B S hS c zi zj w hw := by
  refine (cancel_mono (Sheaf.imageι (zj ≫ c))).1 ?_
  rw [Category.assoc, Sheaf.toImage_ι, Category.assoc,
    imageTransition_comp_imageι B S hS c zi zj w hw, Sheaf.toImage_ι, ← Category.assoc, hw]

/-- The lifted Yoneda image of a factorization `w` of stages is compatible with the stage maps. -/
private theorem uliftYoneda_map_comp_uliftYonedaHom_of_factor
    (hw : (fppfYoneda B S hS).map w ≫ zj = zi) :
    (uliftYoneda.{u + 1}).map w ≫ uliftYonedaHom B S hS zj = uliftYonedaHom B S hS zi := by
  rw [← uliftYonedaHom_map_comp B S hS, hw]

include hw in
/-- If the earlier stage is a representable thickening and the later stage is a monomorphism, then
the transition of stages is a thickening of schemes. -/
theorem isThickening_transition
    (hzi : Space.IsRepresentableThickeningULift.{u + 1} B S hS (uliftYonedaHom B S hS zi))
    (hzjmono : Mono (uliftYonedaHom B S hS zj)) :
    Stacks.Thickenings.IsThickening ((BigFppfOver.toScheme B S hS).map w) := by
  have hwU := uliftYoneda_map_comp_uliftYonedaHom_of_factor B S hS zi zj w hw
  refine hzi.property (uliftYonedaHom B S hS zj) (𝟙 _) w ?_
  refine IsPullback.mk' (by rw [Category.id_comp, hwU])
    (fun {T} {φ φ'} h₁ _ => by simpa using h₁) (fun {T} a b hab => ?_)
  refine ⟨a, Category.comp_id a, ?_⟩
  refine (cancel_mono (uliftYonedaHom B S hS zj)).1 ?_
  rw [Category.assoc, hwU, hab]

include hw in
/-- The square relating two invariant stages and the two subsheaves they generate, read along the
universe-lifted Yoneda embedding, is cartesian. -/
theorem isPullback_imageTransition
    (hzimono : Mono (uliftYonedaHom B S hS zi)) (hzjmono : Mono (uliftYonedaHom B S hS zj))
    {Ri Rj : BigFppfOver B S hS} (ti ri : Ri ⟶ Zi) (tj rj : Rj ⟶ Zj)
    (hinvi : IsPullback ((uliftYoneda.{u + 1}).map ti ≫ uliftYonedaHom B S hS zi)
      ((uliftYoneda.{u + 1}).map ri) c.hom (uliftYonedaHom B S hS zi ≫ c.hom))
    (hinvj : IsPullback ((uliftYoneda.{u + 1}).map tj ≫ uliftYonedaHom B S hS zj)
      ((uliftYoneda.{u + 1}).map rj) c.hom (uliftYonedaHom B S hS zj ≫ c.hom)) :
    IsPullback ((uliftYoneda.{u + 1}).map w)
      (uliftYonedaHom B S hS (Sheaf.toImage (zi ≫ c)))
      (uliftYonedaHom B S hS (Sheaf.toImage (zj ≫ c)))
      (imageTransition B S hS c zi zj w hw).hom := by
  have hwU := uliftYoneda_map_comp_uliftYonedaHom_of_factor B S hS zi zj w hw
  have hιU : (imageTransition B S hS c zi zj w hw).hom ≫ (Sheaf.imageι (zj ≫ c)).hom =
      (Sheaf.imageι (zi ≫ c)).hom :=
    congrArg (fun k : Sheaf.image (zi ≫ c) ⟶ X => k.hom)
      (imageTransition_comp_imageι B S hS c zi zj w hw)
  refine IsPullback.of_right ?_ ?_
    (isPullback_uliftYonedaHom_toImage B S hS c zj hzjmono tj rj hinvj)
  · rw [hwU, hιU]
    exact isPullback_uliftYonedaHom_toImage B S hS c zi hzimono ti ri hinvi
  · have h := congrArg (uliftYonedaHom B S hS)
      (toImage_comp_imageTransition B S hS c zi zj w hw)
    rwa [uliftYonedaHom_map_comp, uliftYonedaHom_comp] at h

include hw in
/-- If the transition of stages is a surjective morphism of schemes, then the transition of the
subsheaves they generate is surjective on points. -/
theorem surjective_pointsMapULift_imageTransition
    (hwsurj : AlgebraicGeometry.Surjective ((BigFppfOver.toScheme B S hS).map w)) :
    Function.Surjective (Space.pointsMapULift.{u + 1} B S hS (Sheaf.image (zi ≫ c)).obj
      (imageTransition B S hS c zi zj w hw).hom) := by
  intro p
  obtain ⟨q, hq⟩ := isSurjective_of_isLocallySurjective B S hS
    ((Sheaf.isLocallySurjective_iff_epi (Sheaf.toImage (zj ≫ c))).2 inferInstance) p
  obtain ⟨q', hq'⟩ :=
    (surjective_pointsMapULift_sheafifiedYoneda_iff B S hS w).2 hwsurj q
  refine ⟨Space.pointsMapULift.{u + 1} B S hS _ (Sheaf.toImage (zi ≫ c)).hom q', ?_⟩
  have h2 : ((fppfYoneda B S hS).map w).hom ≫ (Sheaf.toImage (zj ≫ c)).hom =
      (Sheaf.toImage (zi ≫ c)).hom ≫ (imageTransition B S hS c zi zj w hw).hom :=
    congrArg (fun k : (fppfYoneda B S hS).obj Zi ⟶ Sheaf.image (zj ≫ c) => k.hom)
      (toImage_comp_imageTransition B S hS c zi zj w hw)
  have h3 := congrArg (fun k => k q')
    (congrArg (Space.pointsMapULift.{u + 1} B S hS
      ((fppfYoneda B S hS).obj Zi).obj) h2)
  rw [Space.pointsMapULift_comp, Space.pointsMapULift_comp] at h3
  simp only [Function.comp_apply] at h3
  rw [← h3, hq', hq]

include hw in
/-- The square relating two invariant stages and the two subsheaves they generate is cartesian in
the category of fppf sheaves. -/
theorem isPullback_sheaf_imageTransition
    (hzimono : Mono (uliftYonedaHom B S hS zi)) (hzjmono : Mono (uliftYonedaHom B S hS zj))
    {Ri Rj : BigFppfOver B S hS} (ti ri : Ri ⟶ Zi) (tj rj : Rj ⟶ Zj)
    (hinvi : IsPullback ((uliftYoneda.{u + 1}).map ti ≫ uliftYonedaHom B S hS zi)
      ((uliftYoneda.{u + 1}).map ri) c.hom (uliftYonedaHom B S hS zi ≫ c.hom))
    (hinvj : IsPullback ((uliftYoneda.{u + 1}).map tj ≫ uliftYonedaHom B S hS zj)
      ((uliftYoneda.{u + 1}).map rj) c.hom (uliftYonedaHom B S hS zj ≫ c.hom)) :
    IsPullback (Sheaf.toImage (zi ≫ c)) ((fppfYoneda B S hS).map w)
      (imageTransition B S hS c zi zj w hw) (Sheaf.toImage (zj ≫ c)) := by
  have hnat (T T' : BigFppfOver B S hS) (g : T ⟶ T') :
      ((fppfYonedaCompSheafToPresheaf' B S hS).app T).hom ≫ (uliftYoneda.{u + 1}).map g =
        ((fppfYoneda B S hS).map g).hom ≫
          ((fppfYonedaCompSheafToPresheaf' B S hS).app T').hom := by
    have h := uliftYonedaHom_naturality B S hS g
    have h2 : (uliftYoneda.{u + 1}).map g =
        ((fppfYonedaCompSheafToPresheaf' B S hS).app T).inv ≫
          ((fppfYoneda B S hS).map g).hom ≫
            ((fppfYonedaCompSheafToPresheaf' B S hS).app T').hom := by
      rw [← Category.assoc, ← h, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [h2, Iso.hom_inv_id_assoc]
  have hP := (isPullback_imageTransition B S hS c zi zj w hw hzimono hzjmono
    ti ri tj rj hinvi hinvj).flip
  have hQ : IsPullback (Sheaf.toImage (zi ≫ c)).hom ((fppfYoneda B S hS).map w).hom
      (imageTransition B S hS c zi zj w hw).hom (Sheaf.toImage (zj ≫ c)).hom := by
    refine hP.of_iso' ((fppfYonedaCompSheafToPresheaf' B S hS).app Zi) (Iso.refl _)
      ((fppfYonedaCompSheafToPresheaf' B S hS).app Zj) (Iso.refl _) ?_ (hnat Zi Zj w) ?_ ?_
    · show _ = _ ≫ 𝟙 _
      rw [Category.comp_id]
      show _ ≫ ((fppfYonedaCompSheafToPresheaf' B S hS).app Zi).inv ≫ _ = _
      rw [Iso.hom_inv_id_assoc]
    · simp
    · show _ ≫ ((fppfYonedaCompSheafToPresheaf' B S hS).app Zj).inv ≫ _ = _ ≫ 𝟙 _
      rw [Iso.hom_inv_id_assoc, Category.comp_id]
  exact IsPullback.of_map_of_faithful
    (F := sheafToPresheaf (BigFppfOver.topology B S hS) (Type (u + 1)))
    (f := Sheaf.toImage (zi ≫ c)) (g := (fppfYoneda B S hS).map w)
    (h := imageTransition B S hS c zi zj w hw) (i := Sheaf.toImage (zj ≫ c)) hQ

include hw in
/-- If the earlier of two invariant stages is a representable thickening, then the transition of
the subsheaves they generate is a representable thickening. -/
theorem isRepresentableThickening_imageTransition
    (hzimono : Mono (uliftYonedaHom B S hS zi)) (hzjmono : Mono (uliftYonedaHom B S hS zj))
    {Ri Rj : BigFppfOver B S hS} (ti ri : Ri ⟶ Zi) (tj rj : Rj ⟶ Zj)
    (hinvi : IsPullback ((uliftYoneda.{u + 1}).map ti ≫ uliftYonedaHom B S hS zi)
      ((uliftYoneda.{u + 1}).map ri) c.hom (uliftYonedaHom B S hS zi ≫ c.hom))
    (hinvj : IsPullback ((uliftYoneda.{u + 1}).map tj ≫ uliftYonedaHom B S hS zj)
      ((uliftYoneda.{u + 1}).map rj) c.hom (uliftYonedaHom B S hS zj ≫ c.hom))
    (hcet : (Space.etaleOnSite B S hS).relative (uliftYoneda.{u + 1}) c.hom)
    (hzi : Space.IsRepresentableThickeningULift.{u + 1} B S hS
      (uliftYonedaHom B S hS zi)) :
    Space.IsRepresentableThickeningULift.{u + 1} B S hS
      (imageTransition B S hS c zi zj w hw).hom := by
  let : HasColimitsOfSize.{u + 1, u + 1} (FppfSheaf B S hS) := Sheaf.instHasColimitsOfSize
  have _ := MorphismProperty.relative_isStableUnderBaseChange
    (F := uliftYoneda.{u + 1} (C := BigFppfOver B S hS)) (Space.etaleOnSite B S hS)
  have hmono : Mono (imageTransition B S hS c zi zj w hw) := by
    refine (sheafToPresheaf (BigFppfOver.topology B S hS) (Type (u + 1))).mono_of_mono_map
      (f := imageTransition B S hS c zi zj w hw) ?_
    show Mono (Subfunctor.homOfLe (sheafifyRange_le_of_factor B S hS c zi zj w hw))
    infer_instance
  have hchart : IsRepresentableEtale B S hS (Sheaf.toImage (zj ≫ c)) := by
    refine isRepresentableEtale_of_relative_etaleOnSite B S hS _ ?_
    refine (MorphismProperty.cancel_left_of_respectsIso _
      ((fppfYonedaCompSheafToPresheaf' B S hS).app Zj).inv
      (Sheaf.toImage (zj ≫ c)).hom).1 ?_
    exact MorphismProperty.of_isPullback
      (isPullback_uliftYonedaHom_toImage B S hS c zj hzjmono tj rj hinvj) hcet
  have hcover : Sheaf.IsLocallySurjective
      (Sigma.desc (fun _ : PUnit.{u + 2} => Sheaf.toImage (zj ≫ c))) := by
    have _ : Sheaf.IsLocallySurjective (Sheaf.toImage (zj ≫ c)) :=
      (Sheaf.isLocallySurjective_iff_epi _).2 inferInstance
    refine Presheaf.isLocallySurjective_of_isLocallySurjective_fac _
      (f₁ := (Sigma.ι (fun _ : PUnit.{u + 2} => (fppfYoneda B S hS).obj Zj) PUnit.unit).hom)
      (f₃ := (Sheaf.toImage (zj ≫ c)).hom) ?_
    have h : (Sigma.ι (fun _ : PUnit.{u + 2} => (fppfYoneda B S hS).obj Zj) PUnit.unit ≫
        Sigma.desc (fun _ : PUnit.{u + 2} => Sheaf.toImage (zj ≫ c))).hom =
        (Sheaf.toImage (zj ≫ c)).hom := by
      rw [Sigma.ι_desc]
    exact h
  have _ := MorphismProperty.relative_isStableUnderBaseChange
    (F := uliftYoneda.{u + 1} (C := BigFppfOver B S hS))
    (MorphismProperty.inverseImage
      (@Stacks.Thickenings.IsThickening : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS))
