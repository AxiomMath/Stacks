/-! ### Two transfers of a relative morphism property -/

/-- An isomorphism of presheaves out of a universe-lifted Yoneda presheaf has every relative
property of morphisms of schemes which holds for isomorphisms: a base change of an
isomorphism is an isomorphism, and the Yoneda embedding reflects them. -/
private theorem hasSchemePropertyULift_of_iso
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    (Q : MorphismProperty Scheme.{u})
    (hQ : ∀ ⦃X Y : Scheme.{u}⦄ (f : X ⟶ Y), IsIso f → Q f)
    {T : BigFppfOver B S hS} {G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)}
    (e : (uliftYoneda.{u + 1}).obj T ≅ G) :
    Space.HasSchemePropertyULift.{u + 1} B S hS Q e.hom := by
  refine ⟨Functor.relativelyRepresentable.of_isIso (uliftYoneda.{u + 1}) e.hom, ?_⟩
  intro a b g fst snd hpb
  have : IsIso ((uliftYoneda.{u + 1}).map snd) := hpb.isIso_snd_of_isIso
  have : IsIso snd :=
    Functor.FullyFaithful.isIso_of_isIso_map (ULiftYoneda.fullyFaithful _) snd
  change Q ((BigFppfOver.toScheme B S hS).map snd)
  exact hQ _ (Functor.map_isIso _ snd)

/-- On a subcanonical site, the sheafified Yoneda embedding followed by the inclusion of sheaves
into presheaves is the universe-lifted Yoneda embedding. -/
private noncomputable def sheafifiedYonedaCompSheafToPresheafIso
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    letI := bigFppfOver_subcanonical B S hS
    Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS) ⋙
        sheafToPresheaf (BigFppfOver.topology B S hS) (Type (u + 1)) ≅
      uliftYoneda.{u + 1} (C := BigFppfOver B S hS) :=
  letI := bigFppfOver_subcanonical B S hS
  Functor.isoWhiskerRight (Sheaf.sheafifiedYonedaIsoUliftYoneda' (BigFppfOver.topology B S hS))
      (sheafToPresheaf (BigFppfOver.topology B S hS) (Type (u + 1))) ≪≫
    (BigFppfOver.topology B S hS).uliftYonedaCompSheafToPresheaf

/-- A relative property of a morphism of fppf sheaves relative to the sheafified Yoneda
embedding holds relative to the universe-lifted Yoneda embedding of presheaves: the site being
subcanonical the two embeddings agree after including sheaves into presheaves, a
scheme-valued point of the target lifts to the sheaf level along that identification, and the
inclusion of sheaves into presheaves carries the resulting cartesian square to a cartesian
square of presheaves. -/
private theorem relative_uliftYoneda_of_relative_sheafifiedYoneda
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    (P : MorphismProperty (BigFppfOver B S hS)) [P.RespectsIso]
    {X Y : FppfSheaf B S hS} {f : X ⟶ Y}
    (h : MorphismProperty.relative
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)) P f) :
    MorphismProperty.relative (uliftYoneda.{u + 1} (C := BigFppfOver B S hS)) P f.hom := by
  let JT := BigFppfOver.topology B S hS
  let _ : JT.Subcanonical := bigFppfOver_subcanonical B S hS
  let ε := sheafifiedYonedaCompSheafToPresheafIso B S hS
  apply MorphismProperty.relative.of_exists
  intro a g
  let g' : (Sheaf.sheafifiedYoneda JT).obj a ⟶ Y := ⟨(ε.app a).hom ≫ g⟩
  obtain ⟨b, snd, fst, sq⟩ := h.rep g'
  refine ⟨b, (ε.app b).inv ≫ fst.hom, snd, ?_, h.property g' fst snd sq⟩
  exact (sq.map (sheafToPresheaf JT (Type (u + 1)))).of_iso
    (ε.app b) (Iso.refl _) (ε.app a) (Iso.refl _)
    (by rw [← Category.assoc, Iso.hom_inv_id, Category.id_comp, Iso.refl_hom,
      Category.comp_id]; rfl)
    (ε.hom.naturality snd) (by simp) (by simp [g'])

/-- A relative property of a morphism of fppf sheaves relative to the sheafified Yoneda
embedding holds relative to the universe-lifted Yoneda embedding of presheaves: the site being
subcanonical the two embeddings agree after including sheaves into presheaves, a
scheme-valued point of the target lifts to the sheaf level along that identification, and the
inclusion of sheaves into presheaves carries the resulting cartesian square to a cartesian
square of presheaves. -/
alias relative_uliftYoneda_of_relative_sheafifiedYoneda' :=
  relative_uliftYoneda_of_relative_sheafifiedYoneda

/-! ### The canonical presentation of the formal spectrum -/

/-- The transition morphism of quotient spectra attached to an inclusion `L ⊆ J` of weak ideals
of definition is a thickening: the kernel of `A ⧸ L ⟶ A ⧸ J` is generated by the image of `J`,
whose elements are topologically nilpotent, hence nilpotent modulo the open ideal `L`. -/
@[ega "I 10.1.1" "partial"]
private theorem isThickening_specMap_quotientFactor
    {A : Type u} [CommRing A] [TopologicalSpace A]
    {J L : { I : Ideal A // TopologicalRing.IsWeakIdealOfDefinition I }}
    (hJL : L.1 ≤ J.1) :
    Stacks.Thickenings.IsThickening
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor hJL))) := by
  let q := Ideal.Quotient.factor hJL
  have hker : RingHom.ker q ≤ nilradical (A ⧸ L.1) := by
    rw [Ideal.Quotient.factor_ker hJL]
    apply Ideal.map_le_iff_le_comap.mpr
    intro x hx
    rw [Ideal.mem_comap, mem_nilradical]
    obtain ⟨n, hn⟩ := (J.2.2 x hx).exists_pow_mem_of_mem_nhds
      (L.2.1.mem_nhds (Ideal.zero_mem L.1))
    refine ⟨n, ?_⟩
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hn
  have hqSurj : Function.Surjective q := Ideal.Quotient.factor_surjective hJL
  have hSpecSurj : Function.Surjective (PrimeSpectrum.comap q) := by
    intro p
    let p' : PrimeSpectrum (A ⧸ J.1) :=
      ⟨p.asIdeal.map q,
        Ideal.map_isPrime_of_surjective hqSurj
          (hker.trans (nilradical_le_prime p.asIdeal))⟩
    refine ⟨p', ?_⟩
    apply PrimeSpectrum.ext
    change (p.asIdeal.map q).comap q = p.asIdeal
    rw [Ideal.comap_map_of_surjective q hqSurj p.asIdeal,
      ← RingHom.ker_eq_comap_bot,
      sup_eq_left.mpr (hker.trans (nilradical_le_prime p.asIdeal))]
  have : Surjective (Spec.map (CommRingCat.ofHom q)) := ⟨hSpecSurj⟩
  exact ⟨IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom q) hqSurj,
    Scheme.Hom.surjective _⟩

/-- The weak ideals of definition of a topological ring, ordered by reverse inclusion, are
directed: the intersection of two of them is again one, and it is larger than both for that
order. -/
private theorem isDirected_weakIdealOfDefinition
    {A : Type u} [CommRing A] [TopologicalSpace A] :
    IsDirected (OrderDual { I : Ideal A // TopologicalRing.IsWeakIdealOfDefinition I })
      (· ≤ ·) := by
  refine ⟨fun i j => ⟨OrderDual.toDual ⟨i.1 ⊓ j.1,
    TopologicalRing.isWeakIdealOfDefinition_inf_of_isOpen_right i.2 j.2.1⟩, ?_, ?_⟩⟩
  · change i.1 ⊓ j.1 ≤ i.1
    exact inf_le_left
  · change i.1 ⊓ j.1 ≤ j.1
    exact inf_le_right

/-- Every quotient stage of the formal spectrum maps to it by a morphism which is representable
by objects of the site and whose represented base changes are thickenings. This is the stage
statement of Stacks 0AI9 for the canonical presentation of the formal spectrum, transported
along the universe lift of the index of weak ideals of definition. -/
private theorem relative_isThickening_formalSpectrumInclusion
    {A : Type u} [CommRing A] [TopologicalSpace A]
    (J : { I : Ideal A // TopologicalRing.IsWeakIdealOfDefinition I })
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    (D : QuotientSystem B S hS A) :
    MorphismProperty.relative
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS))
      (MorphismProperty.inverseImage
        (@Stacks.Thickenings.IsThickening : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS))
      (formalSpectrumInclusion D (OrderDual.toDual J)) := by
  let _ : HasColimitsOfSize.{u + 1, u + 1}
      (Sheaf (BigFppfOver.topology B S hS) (Type (u + 1))) :=
    Sheaf.instHasColimitsOfSize
  let I₀ := { I : Ideal A // TopologicalRing.IsWeakIdealOfDefinition I }
  let I := ULift.{u + 1} (OrderDual I₀)
  let eOrder : OrderDual I₀ ≃o I :=
    { toEquiv := Equiv.ulift.symm, map_rel_iff' := Iff.rfl }
  let eI : OrderDual I₀ ≌ I := eOrder.equivalence
  let _ : Nonempty I := ⟨ULift.up (OrderDual.toDual J)⟩
  let _ : IsDirected I (· ≤ ·) := ⟨fun i j => by
    obtain ⟨k, hik, hjk⟩ :=
      (isDirected_weakIdealOfDefinition (A := A)).directed i.down j.down
    exact ⟨ULift.up k, hik, hjk⟩⟩
  let d₀ := QuotientSystem.diagram D
  let d := eI.inverse ⋙ d₀
  have hd : ∀ ⦃i j : I⦄ (f : i ⟶ j),
      Stacks.Thickenings.IsThickening
        ((BigAffineFppf.toScheme B S hS).map (d.map f)) := by
    intro i j f
    let J₁ : { I : Ideal A // TopologicalRing.IsWeakIdealOfDefinition I } :=
      OrderDual.ofDual (eI.inverse.obj i)
    let L₁ : { I : Ideal A // TopologicalRing.IsWeakIdealOfDefinition I } :=
      OrderDual.ofDual (eI.inverse.obj j)
    have hJL : L₁.1 ≤ J₁.1 := leOfHom (eI.inverse.map f)
    change Stacks.Thickenings.IsThickening
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor hJL)))
    exact isThickening_specMap_quotientFactor hJL
  let H := BigAffineFppf.inclusion B S hS
  let G := Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)
  let K₀ := formalSpectrumDiagram D
  let K := d ⋙ H ⋙ G
  have hw : eI.functor ⋙ K ≅ K₀ := by
    dsimp [K, K₀, d, d₀, H, G]
    exact Functor.isoWhiskerRight eI.unitIso.symm
      (d₀ ⋙ BigAffineFppf.inclusion B S hS ⋙
        Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS))
  let eCol := HasColimit.isoOfEquivalence eI hw
  let j := OrderDual.toDual J
  let i : I := ULift.up j
  let j' := eI.inverse.obj i
  have hj : j' = j := rfl
  let eSrc : K.obj i ≅ K₀.obj j :=
    K.mapIso (asIso (eI.counitInv.app i)) ≪≫ hw.app j' ≪≫
      eqToIso (congrArg K₀.obj hj)
  let f : K.obj i ⟶ formalSpectrum D :=
    colimit.ι K i ≫ eCol.symm.hom
  let g : K₀.obj j ⟶ formalSpectrum D := formalSpectrumInclusion D j
  have hcomm : eSrc.hom ≫ g = f := by
    change (K.map (eI.counitInv.app i) ≫ hw.hom.app j' ≫
      eqToHom (congrArg K₀.obj hj) ≫ colimit.ι K₀ j) =
      colimit.ι K i ≫ eCol.inv
    rw [colimit.eqToHom_comp_ι K₀ hj.symm]
    exact (HasColimit.ι_isoOfEquivalence_inv eI hw i).symm
  let hArrow : Arrow.mk f ≅ Arrow.mk g :=
    Arrow.isoMk eSrc (Iso.refl _) hcomm
  have hf := isThickening_colimitι B S hS d hd (formalSpectrum D) eCol.symm i
  exact (MorphismProperty.arrow_mk_iso_iff _ hArrow).mp hf

/-- A section of the target of a representable thickening over an object of the site with
reduced underlying scheme is the image of a section of the source: the base change of the
thickening to that object is a surjective closed immersion into a reduced scheme, hence an
isomorphism. -/
private theorem exists_app_eq_of_isReduced
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {Xr Xt : (BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)} {m : Xr ⟶ Xt}
    (hm : Space.IsRepresentableThickeningULift.{u + 1} B S hS m)
    {T : BigFppfOver B S hS} (hT : IsReduced ((BigFppfOver.toScheme B S hS).obj T))
    (v : Xt.obj (op T)) : ∃ a : Xr.obj (op T), m.app (op T) a = v := by
  obtain ⟨b, snd, fst, sq⟩ := hm.rep (uliftYonedaEquiv.{u + 1}.symm v)
  obtain ⟨hclosed, hsurj⟩ := hm.property _ fst snd sq
  have _ : IsClosedImmersion ((BigFppfOver.toScheme B S hS).map snd) := hclosed
  have _ : Surjective ((BigFppfOver.toScheme B S hS).map snd) := ⟨hsurj⟩
  have _ : IsIso ((BigFppfOver.toScheme B S hS).map snd) :=
    isIso_of_isClosedImmersion_of_surjective _
  have _ : IsIso snd := isIso_of_reflects_iso snd (BigFppfOver.toScheme B S hS)
  refine ⟨uliftYonedaEquiv.{u + 1} (inv ((uliftYoneda.{u + 1}).map snd) ≫ fst), ?_⟩
  apply (uliftYonedaEquiv.{u + 1} (X := T) (F := Xt)).symm.injective
  rw [← uliftYonedaEquiv_comp, Equiv.symm_apply_apply, Category.assoc, sq.w,
    ← Category.assoc, IsIso.inv_hom_id, Category.id_comp]

/-- A representable thickening of presheaves is injective on sections: a lift of a section of
the target splits the base change of the thickening to the object carrying it, and a split
closed immersion is an isomorphism, so the lift is the unique one. -/
private theorem injective_app_of_isRepresentableThickening
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {Xr Xt : (BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)} {m : Xr ⟶ Xt}
    (hm : Space.IsRepresentableThickeningULift.{u + 1} B S hS m)
    (T : BigFppfOver B S hS) : Function.Injective (m.app (op T)) := by
  intro a₁ a₂ he
  apply (uliftYonedaEquiv.{u + 1} (X := T) (F := Xr)).symm.injective
  obtain ⟨b, snd, fst, sq⟩ := hm.rep (uliftYonedaEquiv.{u + 1}.symm (m.app (op T) a₁))
  obtain ⟨hclosed, -⟩ := hm.property _ fst snd sq
  have hw₁ : uliftYonedaEquiv.{u + 1}.symm a₁ ≫ m
      = 𝟙 _ ≫ uliftYonedaEquiv.{u + 1}.symm (m.app (op T) a₁) := by
    rw [Category.id_comp]
    exact uliftYonedaEquiv_symm_comp a₁ m
  have hw₂ : uliftYonedaEquiv.{u + 1}.symm a₂ ≫ m
      = 𝟙 _ ≫ uliftYonedaEquiv.{u + 1}.symm (m.app (op T) a₁) := by
    rw [Category.id_comp, uliftYonedaEquiv_symm_comp, he]
  have _ : IsClosedImmersion ((BigFppfOver.toScheme B S hS).map snd) := hclosed
  have _ : Mono snd := (BigFppfOver.toScheme B S hS).mono_of_mono_map inferInstance
  have _ : IsSplitEpi snd := by
    refine IsSplitEpi.mk' ⟨(ULiftYoneda.fullyFaithful _).preimage (sq.lift _ (𝟙 _) hw₁), ?_⟩
    apply (ULiftYoneda.fullyFaithful (BigFppfOver B S hS)).map_injective
    rw [Functor.map_comp, Functor.FullyFaithful.map_preimage, sq.lift_snd]
    simp
  have _ : IsIso snd := isIso_of_mono_of_isSplitEpi snd
  have hl : sq.lift _ (𝟙 _) hw₁ = sq.lift _ (𝟙 _) hw₂ :=
    (cancel_mono ((uliftYoneda.{u + 1}).map snd)).mp (by rw [sq.lift_snd, sq.lift_snd])
  calc uliftYonedaEquiv.{u + 1}.symm a₁
      = sq.lift _ (𝟙 _) hw₁ ≫ fst := (sq.lift_fst _ _ _).symm
    _ = sq.lift _ (𝟙 _) hw₂ ≫ fst := by rw [hl]
    _ = uliftYonedaEquiv.{u + 1}.symm a₂ := sq.lift_fst _ _ _

/-- A section of the target of a morphism of sheaves which is injective on sections and whose
restriction along one surjective étale morphism lifts is itself the image of a section: the
lifts over the arrows of the covering sieve generated by that morphism are compatible because
of injectivity, and their amalgamation is the required section. -/
private theorem exists_app_eq_of_singleton_cover
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {Xr Xt : (BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)} {m : Xr ⟶ Xt}
    (hinj : ∀ T : BigFppfOver B S hS, Function.Injective (m.app (op T)))
    (hXr : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Xr)
    (hXt : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Xt)
    {T c : BigFppfOver B S hS} {π : c ⟶ T}
    (hcov : Sieve.generate (Presieve.singleton π) ∈ BigFppfOver.topology B S hS T)
    (v : Xt.obj (op T)) (a : Xr.obj (op c)) (ha : m.app (op c) a = Xt.map π.op v) :
    ∃ w : Xr.obj (op T), m.app (op T) w = v := by
  classical
  have key : ∀ ⦃Y : BigFppfOver B S hS⦄ (g : Y ⟶ T),
      (Sieve.generate (Presieve.singleton π)).arrows g →
      ∃ z : Xr.obj (op Y), m.app (op Y) z = Xt.map g.op v := by
    intro Y g hg
    obtain ⟨Z, e, g', hg', hfac⟩ := hg
    cases hg'
    refine ⟨Xr.map e.op a, ?_⟩
    rw [NatTrans.naturality_apply m e.op a, ha, ← Functor.map_comp_apply, ← op_comp, hfac]
  let x : Presieve.FamilyOfElements Xr (Sieve.generate (Presieve.singleton π)).arrows :=
    fun _ g hg => (key g hg).choose
  have hx : ∀ ⦃Y : BigFppfOver B S hS⦄ (g : Y ⟶ T)
      (hg : (Sieve.generate (Presieve.singleton π)).arrows g),
      m.app (op Y) (x g hg) = Xt.map g.op v := fun _ g hg => (key g hg).choose_spec
  have hxc : x.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
    apply hinj Z
    rw [NatTrans.naturality_apply m g₁.op, NatTrans.naturality_apply m g₂.op, hx f₁ h₁,
      hx f₂ h₂, ← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp,
      hcomm]
  obtain ⟨w, hw, -⟩ := ((isSheaf_iff_isSheaf_of_type _ _).mp hXr) _ hcov x hxc
  refine ⟨w, ?_⟩
  refine (((isSheaf_iff_isSheaf_of_type _ _).mp hXt) _ hcov).isSeparatedFor.ext
    fun Y g hg => ?_
  rw [← NatTrans.naturality_apply m g.op w, hw g hg, hx g hg]

/-- A morphism to the target of a representable thickening from a sheaf admitting a surjective
étale atlas by a reduced object of the site factors uniquely through the thickening: the
factorization exists over the atlas because the base change of a thickening to a reduced object
is an isomorphism, and it descends and is unique because a representable thickening is
injective on sections. -/
private theorem existsUnique_comp_eq_of_hasEtaleLocalProperty
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X Xred : FppfSheaf B S hS} {i : Xred ⟶ X}
    (hm : Space.IsRepresentableThickeningULift.{u + 1} B S hS i.hom)
    (U : FppfSheaf B S hS)
    (hUred : Space.HasEtaleLocalPropertyULift.{u + 1} B S hS U.obj
      (fun T : Scheme.{u} ↦ IsReduced T))
    (f : U ⟶ X) : ∃! g : U ⟶ Xred, g ≫ i = f := by
  classical
  obtain ⟨W, p, hpsurj, hpetale, hWred⟩ := hUred
  obtain ⟨l, hl⟩ : ∃ l : (uliftYoneda.{u + 1}).obj W ⟶ Xred.obj, l ≫ i.hom = p ≫ f.hom := by
    obtain ⟨l₀, hl₀⟩ := exists_app_eq_of_isReduced hm hWred
      (uliftYonedaEquiv.{u + 1} (p ≫ f.hom))
    exact ⟨uliftYonedaEquiv.{u + 1}.symm l₀, by
      rw [uliftYonedaEquiv_symm_comp, hl₀, Equiv.symm_apply_apply]⟩
  have hinj : ∀ T : (BigFppfOver B S hS)ᵒᵖ, Function.Injective (i.hom.app T) :=
    fun T => injective_app_of_isRepresentableThickening hm T.unop
  have hex : ∀ (T : (BigFppfOver B S hS)ᵒᵖ) (s : U.obj.obj T),
      ∃ a : Xred.obj.obj T, i.hom.app T a = f.hom.app T s := by
    rintro ⟨T⟩ s
    obtain ⟨c, π, fstp, sqp⟩ := hpsurj.rep (uliftYonedaEquiv.{u + 1}.symm s)
    refine exists_app_eq_of_singleton_cover
      (injective_app_of_isRepresentableThickening hm) Xred.property X.property
      (Space.sieve_generate_singleton_mem_topology_over B S hS π
        (hpsurj.property _ fstp π sqp) (hpetale.property _ fstp π sqp))
      (f.hom.app (op T) s) (uliftYonedaEquiv.{u + 1} (fstp ≫ l)) ?_
    calc i.hom.app (op c) (uliftYonedaEquiv.{u + 1} (fstp ≫ l))
        = uliftYonedaEquiv.{u + 1} ((fstp ≫ l) ≫ i.hom) := (uliftYonedaEquiv_comp _ _).symm
      _ = uliftYonedaEquiv.{u + 1}
            ((uliftYoneda.{u + 1}).map π ≫ (uliftYonedaEquiv.{u + 1}.symm s ≫ f.hom)) :=
          congrArg uliftYonedaEquiv.{u + 1}
            (by rw [Category.assoc, hl, ← Category.assoc, sqp.w, Category.assoc])
      _ = X.obj.map π.op
            (uliftYonedaEquiv.{u + 1} (uliftYonedaEquiv.{u + 1}.symm s ≫ f.hom)) :=
          (uliftYonedaEquiv_naturality _ π.op).symm
      _ = X.obj.map π.op (f.hom.app (op T) s) := by
          rw [uliftYonedaEquiv_comp, Equiv.apply_symm_apply]
  choose a ha using hex
  refine ⟨⟨{ app := fun T => TypeCat.ofHom (a T), naturality := ?_ }⟩, ?_, ?_⟩
  · intro T T' k
    have hnat : ∀ s : U.obj.obj T, a T' (U.obj.map k s) = Xred.obj.map k (a T s) := by
      intro s
      apply hinj T'
      rw [ha, NatTrans.naturality_apply i.hom k, ha, NatTrans.naturality_apply f.hom k]
    exact TypeCat.homEquiv.injective (funext hnat)
  · exact Sheaf.hom_ext (NatTrans.ext (funext fun T => TypeCat.homEquiv.injective (funext (ha T))))
  · intro φ hφ
    have huniq : ∀ (T : (BigFppfOver B S hS)ᵒᵖ) (s : U.obj.obj T),
        TypeCat.homEquiv (φ.hom.app T) s = a T s := by
      intro T s
      apply hinj T
      rw [ha]
      exact congrArg (fun ψ : U ⟶ X => TypeCat.homEquiv (ψ.hom.app T) s) hφ
    exact Sheaf.hom_ext (NatTrans.ext (funext fun T =>
      TypeCat.homEquiv.injective (funext (huniq T))))

/-! ### The reduction of the formal spectrum -/

/-- **Stacks 0GB6.** Let `A` be a weakly admissible topological ring over `S` and let `𝔞` be
its ideal of topologically nilpotent elements, the largest weak ideal of definition of `A`.
The stage of `Spf A` at `𝔞` is `Spec (A ⧸ 𝔞)`, and its morphism to `Spf A` exhibits it as the
reduction of `Spf A`. -/
@[stacks 0GB6 "the reduction"]
public theorem isReduction_formalSpectrum
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] (hA : TopologicalRing.IsWeaklyAdmissible A)
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    (D : QuotientSystem B S hS A) (_hB : D.HasLargeSite) :
    IsReduction B S hS (formalSpectrum D)
      ((formalSpectrumDiagram D).obj (OrderDual.toDual (TopologicalRing.nilIdx hA.1)))
      (formalSpectrumInclusion D (OrderDual.toDual (TopologicalRing.nilIdx hA.1))) := by
  let N : TopologicalRing.WeakIdealOfDefinitionIndex A := TopologicalRing.nilIdx hA.1
  let JT := BigFppfOver.topology B S hS
  let _ : JT.Subcanonical := bigFppfOver_subcanonical B S hS
  let U₀ : BigFppfOver B S hS := (BigAffineFppf.inclusion B S hS).obj (D.stage N)
  let ε := sheafifiedYonedaCompSheafToPresheafIso B S hS
  let _ : (MorphismProperty.inverseImage
      (@Stacks.Thickenings.IsThickening : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).RespectsIso :=
    MorphismProperty.RespectsIso.inverseImage _ _
  -- the stage at `𝔞` is the universe-lifted Yoneda presheaf of an affine object of the site
  have hatlas : (uliftYoneda.{u + 1} (C := BigFppfOver B S hS)).obj U₀ ≅
      ((formalSpectrumDiagram D).obj (OrderDual.toDual N)).obj := (ε.app U₀).symm
  -- the stage morphism is representable and a thickening after every represented base change
  have hthick := relative_uliftYoneda_of_relative_sheafifiedYoneda
    (MorphismProperty.inverseImage
      (@Stacks.Thickenings.IsThickening : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS))
    (relative_isThickening_formalSpectrumInclusion N D)
  have hreduced : Space.HasEtaleLocalPropertyULift.{u + 1} B S hS
      ((formalSpectrumDiagram D).obj (OrderDual.toDual N)).obj
      (fun T : Scheme.{u} ↦ IsReduced T) := by
    refine ⟨U₀, hatlas.hom, ?_, ?_, ?_⟩
    · exact hasSchemePropertyULift_of_iso _
        (fun _ _ f hf ↦ by have := hf; infer_instance) hatlas
    · exact hasSchemePropertyULift_of_iso _
        (fun _ _ f hf ↦ by have := hf; infer_instance) hatlas
    · change IsReduced (Spec (CommRingCat.of (A ⧸ topologicalNilradical A)))
      have : _root_.IsReduced (A ⧸ topologicalNilradical A) :=
        TopologicalRing.isReduced_quotient_topologicalNilradical
      infer_instance
  exact
    { algebraic := Space.isAlgebraicSpaceULift_of_iso B S hS hatlas
        (Space.isAlgebraicSpaceULift_uliftYoneda B S hS U₀)
      reduced := hreduced
      representable := hthick.rep
      thickening := hthick.property
      universal := fun U _ hUred f ↦
        existsUnique_comp_eq_of_hasEtaleLocalProperty hthick U hUred f }

end AlgebraicGeometry.FormalSpace

end
