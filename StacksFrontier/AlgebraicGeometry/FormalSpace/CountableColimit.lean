/-!
# The set-theoretic condition for a countable colimit (Stacks 0AIS)

`AlgebraicGeometry.FormalSpace.satisfiesSetTheoreticCondition_of_colimit` deduces the
set-theoretic condition of Stacks 0AIS for a directed colimit of affine fppf sheaves along
thickenings *from the hypothesis that the coproduct of the stages is representable in the
site*. This file discharges that hypothesis when the index is **countable**, and so proves
the set-theoretic condition outright for a countable directed colimit.

Countability is what makes the coproduct available, but it is not what the argument uses: a
countable index is *admissible for coproducts* in the site
(`AlgebraicGeometry.BigFppfSite.AdmitsCoproductIndex`), its cardinality being at most `ℵ₀` and
so below the cofinality of the size cutoff, and that is the hypothesis of
`AlgebraicGeometry.FormalSpace.satisfiesSetTheoreticCondition_of_admissible_colimit`, of which
the statement below is the countable case. An index of arbitrary cardinality does just as well
when the stages carry a uniform size bound, which is
`AlgebraicGeometry.FormalSpace.satisfiesSetTheoreticCondition_of_bounded_colimit`.

## Main results

* `AlgebraicGeometry.FormalSpace.satisfiesSetTheoreticCondition_of_countable_colimit`:
  **Stacks 0AIS**, countable colimit.

## References

* [Stacks Project, Tag 0AIS](https://stacks.math.columbia.edu/tag/0AIS)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.FormalSpace

universe u

universe w₁ w₂ w₃ w₄

/-- The size cutoff of a big fppf site is closed under countable coproducts: it is a strong
prelimit of uncountable cofinality. This is the countable case of
`AlgebraicGeometry.BigFppfSite.contains_sigma`. -/
private instance schemeCutoff_isClosedUnderCountableCoproducts (B : BigFppfSite.{u})
    (ι : Type u) [Countable ι] :
    (schemeSizeBelow B.cutoff).IsClosedUnderColimitsOfShape (Discrete ι) := by
  apply ObjectProperty.IsClosedUnderColimitsOfShape.mk'
  rintro X ⟨F, hF⟩
  let Y : ι → Scheme.{u} := fun i ↦ F.obj (Discrete.mk i)
  let c : Cofan Y := Cofan.mk (∐ Y) (Sigma.ι Y)
  let eF : F ≅ Discrete.functor Y := NatIso.ofComponents (fun _ ↦ Iso.refl _) (by
    rintro ⟨i⟩ ⟨j⟩ f
    obtain rfl : i = j := Discrete.eq_of_hom f
    obtain rfl : f = 𝟙 _ := Subsingleton.elim _ _
    simp [Y])
  let e : colimit F ≅ c.pt :=
    HasColimit.isoOfNatIso eF ≪≫ colimit.isoColimitCocone ⟨c, coproductIsCoproduct Y⟩
  change (colimit F).size < B.cutoff
  rw [Scheme.size_congr e]
  exact Scheme.size_sigmaObj_lt B.aleph0_lt_cutoff B.aleph0_lt_cutoff_cof
    Cardinal.mk_le_aleph0 Y fun i ↦ hF (Discrete.mk i)

/-- A sieve of the big fppf site of `S` generated by a family of arrows covers as soon as the
family of underlying arrows covers in the big fppf site. -/
private theorem sieve₀_mem_bigFppfOverTopology (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) {U : BigFppfOver B S hS} {E : PreZeroHypercover U}
    (hE : (E.map (Over.forget (B.obj hS))).sieve₀ ∈
      B.topology ((Over.forget (B.obj hS)).obj U)) :
    E.sieve₀ ∈ BigFppfOver.topology B S hS U := by
  rw [BigFppfOver.topology, GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  simpa [PreZeroHypercover.sieve₀, PreZeroHypercover.map] using hE

/-- A colimiting cofan of schemes is jointly surjective on points. -/
private theorem jointlySurjective_of_coproductCofan {ι : Type u} [Small.{u} ι]
    {Y : ι → Scheme.{u}} {c : Cofan Y} (hc : IsColimit c) :
    ∀ x : c.pt, ∃ i y, c.inj i y = x := by
  intro x
  let e : c.pt ≅ ∐ Y := IsColimit.coconePointUniqueUpToIso hc (coproductIsCoproduct Y)
  obtain ⟨⟨i, y⟩, hy⟩ := (sigmaMk Y).surjective (e.hom.base x)
  refine ⟨i, y, ?_⟩
  apply (Scheme.Hom.isOpenEmbedding e.hom).injective
  calc
    e.hom.base ((c.inj i).base y) = (c.inj i ≫ e.hom).base y := rfl
    _ = (Sigma.ι Y i).base y :=
      congrArg (fun f : Y i ⟶ ∐ Y ↦ f.base y)
        (IsColimit.comp_coconePointUniqueUpToIso_hom hc (coproductIsCoproduct Y)
          (Discrete.mk i))
    _ = (sigmaMk Y) ⟨i, y⟩ := by rw [sigmaMk_mk]
    _ = e.hom.base x := hy

/-- The injections of a colimiting cofan of schemes form an fppf covering family as soon as
they are open immersions. -/
private theorem coproductCofan_mem_fppfPrecoverage {ι : Type u} [Small.{u} ι]
    {Y : ι → Scheme.{u}} {c : Cofan Y} (hc : IsColimit c)
    (hopen : ∀ i, IsOpenImmersion (c.inj i)) :
    (PreZeroHypercover.mk ι Y c.inj).presieve₀ ∈ Scheme.fppfPrecoverage c.pt := by
  rw [Scheme.fppfPrecoverage, Scheme.presieve₀_mem_precoverage_iff]
  refine ⟨jointlySurjective_of_coproductCofan hc, fun i ↦ ?_⟩
  let _ : IsOpenImmersion (c.inj i) := hopen i
  exact ⟨inferInstance, inferInstance⟩

/-- Reindexing a family of arrows along `ULift.down` does not change its presieve. -/
private theorem ofArrows_uliftIndex {C : Type*} [Category C] {X : C} {ι : Type u}
    (Y : ι → C) (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows (fun i : ULift.{u + 1, u} ι ↦ Y i.down) (fun i ↦ f i.down) =
      Presieve.ofArrows Y f :=
  Presieve.ofArrows_comp_eq_of_surjective f fun i ↦ ⟨⟨i⟩, rfl⟩

/-- The injections of a colimiting cofan over a countable index in the big fppf site of `S`
generate a covering sieve. This is the countable case of
`AlgebraicGeometry.BigFppfOver.sieve_sigmaCofan_mem_topology`. -/
private theorem coproduct_arrows_mem_bigFppfOverTopology (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) {ι : Type u} [Countable ι] (V : ι → BigFppfOver B S hS)
    {c : Cofan V} (hc : IsColimit c) :
    Sieve.ofArrows V c.inj ∈ BigFppfOver.topology B S hS c.pt := by
  classical
  let H := BigFppfOver.toScheme B S hS
  let Y : ι → Scheme.{u} := fun i ↦ H.obj (V i)
  let cS : Cofan Y := Cofan.mk (H.obj c.pt) fun i ↦ H.map (c.inj i)
  have hcS : IsColimit cS :=
    (Cofan.isColimitMapCoconeEquiv H V c).1 (isColimitOfPreserves H hc)
  let e : H.obj c.pt ≅ ∐ Y :=
    IsColimit.coconePointUniqueUpToIso hcS (coproductIsCoproduct Y)
  have hopen : ∀ i, IsOpenImmersion (cS.inj i) := by
    intro i
    have hcomp : cS.inj i ≫ e.hom = Sigma.ι Y i :=
      IsColimit.comp_coconePointUniqueUpToIso_hom hcS (coproductIsCoproduct Y) (Discrete.mk i)
    rw [← MorphismProperty.cancel_right_of_respectsIso
      (P := @AlgebraicGeometry.IsOpenImmersion) _ e.hom, hcomp]
    infer_instance
  have hfp : (PreZeroHypercover.mk ι Y cS.inj).presieve₀ ∈
      Scheme.fppfPrecoverage (H.obj c.pt) :=
    coproductCofan_mem_fppfPrecoverage hcS hopen
  let F := BigFppfOver.forget B S hS
  let E' : PreZeroHypercover.{u + 1} c.pt :=
    PreZeroHypercover.mk (ULift.{u + 1, u} ι) (fun i ↦ V i.down) fun i ↦ c.inj i.down
  have hE : IsFppfCovering (⟨F.obj c.pt, E'.map F⟩ : Covering.{u + 1, u, u + 1} B.Schemes) := by
    change ((E'.map F).presieve₀).map B.inclusion ∈ Scheme.fppfPrecoverage (H.obj c.pt)
    have hpres : ((E'.map F).presieve₀).map B.inclusion =
        (PreZeroHypercover.mk ι Y cS.inj).presieve₀ := by
      simp only [PreZeroHypercover.presieve₀_map, PreZeroHypercover.presieve₀,
        Presieve.map_ofArrows]
      exact ofArrows_uliftIndex Y cS.inj
    rw [hpres]
    exact hfp
  have hOver : E'.sieve₀ ∈ BigFppfOver.topology B S hS c.pt :=
    sieve₀_mem_bigFppfOverTopology B S hS
      (by
        simpa [PreZeroHypercover.sieve₀] using
          B.generate_mem_topology_of_isFppfCovering (E'.map (Over.forget (B.obj hS))) hE)
  have hpres : E'.presieve₀ = (PreZeroHypercover.mk ι V c.inj).presieve₀ :=
    ofArrows_uliftIndex V c.inj
  have hsieve : E'.sieve₀ = (PreZeroHypercover.mk ι V c.inj).sieve₀ := congrArg Sieve.generate hpres
  rw [hsieve] at hOver
  simpa [PreZeroHypercover.sieve₀, PreZeroHypercover.presieve₀, Sieve.ofArrows] using hOver

/-- The universe-lifted form of `CategoryTheory.GrothendieckTopology.isColimitCofanMkYoneda`:
a family of pairwise disjoint monomorphisms covering their target becomes a coproduct under
the universe-lifted Yoneda embedding into sheaves of types in a larger universe. -/
@[sga "4 II 4.6.2" "special case"]
private noncomputable def isColimitCofanMkUliftYoneda {C : Type w₁} [Category.{w₂} C]
    (J : GrothendieckTopology C) [J.Subcanonical] {ι : Type w₃} (X : ι → C) {c : Cofan X}
    (H : Sieve.ofArrows X c.inj ∈ J c.pt) [∀ i, Mono (c.inj i)]
    (hempty : ∀ Y : C, IsInitial Y → ⊥ ∈ J Y)
    (hdisj : ∀ {i j : ι}, i ≠ j → ∀ {Y : C} (a : Y ⟶ X i) (b : Y ⟶ X j),
      a ≫ c.inj i = b ≫ c.inj j → Nonempty (IsInitial Y)) :
    IsColimit (Cofan.mk (J.uliftYoneda.{w₄}.obj c.pt)
      fun i ↦ J.uliftYoneda.{w₄}.map (c.inj i)) := by
  classical
  let S : Sieve c.pt := Sieve.ofArrows X c.inj
  have heq (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) {Y : C} {i j : ι} (a : Y ⟶ X i)
      (b : Y ⟶ X j) (hab : a ≫ c.inj i = b ≫ c.inj j) :
      (s.inj i).hom.app (op Y) ⟨a⟩ = (s.inj j).hom.app (op Y) ⟨b⟩ := by
    by_cases h : i = j
    · subst h
      rw [(cancel_mono _).mp hab]
    · obtain ⟨hY⟩ := hdisj h a b hab
      have hsub : Subsingleton (s.pt.obj.obj (op Y)) := by
        have := Types.isTerminalEquivUnique _
          (Sheaf.isTerminalOfBotCover s.pt _ (hempty Y hY))
        infer_instance
      exact hsub.elim _ _
  let family (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) :
      Presieve.FamilyOfElements s.pt.obj S.arrows :=
    fun Y f hf ↦ (s.inj (Sieve.ofArrows.i hf)).hom.app (op Y) ⟨Sieve.ofArrows.h hf⟩
  have hfamily (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) : (family s).Compatible := by
    rw [Presieve.compatible_iff_sieveCompatible]
    intro Y Z f g hf
    simp only [family, ← heq s (g ≫ Sieve.ofArrows.h hf)
      (Sieve.ofArrows.h <| Sieve.downward_closed _ hf g) (by simp)]
    exact ConcreteCategory.congr_hom ((s.inj (Sieve.ofArrows.i hf)).hom.naturality g.op)
      (⟨Sieve.ofArrows.h hf⟩ : ULift (Y ⟶ X (Sieve.ofArrows.i hf)))
  let hsheaf (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) :=
    s.pt.property.isSheafFor S H (family s) (hfamily s)
  let sectionValue (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) := Classical.choose (hsheaf s)
  have sectionValue_spec (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) :
      (family s).IsAmalgamation (sectionValue s) := (Classical.choose_spec (hsheaf s)).1
  let desc (s : Cofan fun i ↦ J.uliftYoneda.{w₄}.obj (X i)) :
      J.uliftYoneda.{w₄}.obj c.pt ⟶ s.pt := J.uliftYonedaEquiv.symm (sectionValue s)
  refine Cofan.IsColimit.mk _ (fun s ↦ desc s) ?_ ?_
  · intro s i
    apply J.uliftYonedaEquiv.injective
    change J.uliftYonedaEquiv (J.uliftYoneda.map (c.inj i) ≫ desc s) =
      J.uliftYonedaEquiv (s.inj i)
    rw [J.uliftYonedaEquiv_comp, J.uliftYonedaEquiv_uliftYoneda_map,
      ← J.map_uliftYonedaEquiv (desc s) (c.inj i)]
    have hi := sectionValue_spec s (c.inj i) (Sieve.ofArrows_mk _ _ i)
    have hval : family s (c.inj i) (Sieve.ofArrows_mk _ _ i) = J.uliftYonedaEquiv (s.inj i) := by
      rw [J.uliftYonedaEquiv_apply]
      simpa [family] using heq s (Sieve.ofArrows.h (Sieve.ofArrows_mk _ _ i)) (𝟙 (X i))
        (by simp [Sieve.ofArrows.fac (Sieve.ofArrows_mk _ _ i)])
    simpa only [desc, Equiv.apply_symm_apply] using hi.trans hval
  · intro s m hm
    apply J.uliftYonedaEquiv.injective
    have hM : (family s).IsAmalgamation (J.uliftYonedaEquiv m) := by
      intro Y f hf
      let i := Sieve.ofArrows.i hf
      let g := Sieve.ofArrows.h hf
      have hmi : (m.hom.app (op (X i))) ⟨c.inj i⟩ =
          (s.inj i).hom.app (op (X i)) ⟨𝟙 (X i)⟩ := by
        calc
          (m.hom.app (op (X i))) ⟨c.inj i⟩ =
              s.pt.obj.map (c.inj i).op (J.uliftYonedaEquiv m) :=
            (J.map_uliftYonedaEquiv m (c.inj i)).symm
          _ = J.uliftYonedaEquiv (J.uliftYoneda.map (c.inj i) ≫ m) :=
            J.uliftYonedaEquiv_naturality m (c.inj i)
          _ = J.uliftYonedaEquiv (s.inj i) := congrArg J.uliftYonedaEquiv (hm i)
          _ = (s.inj i).hom.app (op (X i)) ⟨𝟙 (X i)⟩ := J.uliftYonedaEquiv_apply (s.inj i)
      have hnat : s.pt.obj.map g.op ((s.inj i).hom.app (op (X i)) ⟨𝟙 (X i)⟩) =
          (s.inj i).hom.app (op Y) ⟨g⟩ := by
        rw [← J.uliftYonedaEquiv_apply (s.inj i)]
        exact J.map_uliftYonedaEquiv (s.inj i) g
      calc
        s.pt.obj.map f.op (J.uliftYonedaEquiv m) =
            s.pt.obj.map (g ≫ c.inj i).op (J.uliftYonedaEquiv m) := by
          rw [Sieve.ofArrows.fac hf]
        _ = s.pt.obj.map g.op (s.pt.obj.map (c.inj i).op (J.uliftYonedaEquiv m)) := by
          simp [op_comp, Functor.map_comp]
        _ = s.pt.obj.map g.op ((m.hom.app (op (X i))) ⟨c.inj i⟩) := by
          rw [J.map_uliftYonedaEquiv]
        _ = s.pt.obj.map g.op ((s.inj i).hom.app (op (X i)) ⟨𝟙 (X i)⟩) :=
          congrArg (s.pt.obj.map g.op) hmi
        _ = (s.inj i).hom.app (op Y) ⟨g⟩ := hnat
        _ = family s f hf := rfl
    simpa only [desc, Equiv.apply_symm_apply] using (Classical.choose_spec (hsheaf s)).2 _ hM

/-- **Stacks 0AIS, countable colimit.** A countable directed colimit of affine fppf sheaves
along thickenings satisfies the set-theoretic condition.

Countability replaces the representability hypothesis on the coproduct of the stages in
`AlgebraicGeometry.FormalSpace.satisfiesSetTheoreticCondition_of_colimit`: a countable
coproduct is itself represented by an object of the big fppf site. What the argument uses is
only that a countable index is admissible for coproducts in the site, so this is the countable
case of `AlgebraicGeometry.FormalSpace.satisfiesSetTheoreticCondition_of_admissible_colimit`. -/
@[stacks 0AIS "countable_colimit"]
theorem satisfiesSetTheoreticCondition_of_countable_colimit (B : BigFppfSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) {I : Type (u + 1)} [Preorder I] [Nonempty I]
    [IsDirected I (· ≤ ·)] [Countable I] (D : I ⥤ BigAffineFppf B S hS)
    (hD : ∀ ⦃i j : I⦄ (f : i ⟶ j),
      Stacks.Thickenings.IsThickening ((BigAffineFppf.toScheme B S hS).map (D.map f)))
    (X : Sheaf (BigFppfOver.topology B S hS) (Type (u + 1)))
    (hX : Nonempty (X ≅ colimit
      (D ⋙ BigAffineFppf.inclusion B S hS ⋙
        Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)))) :
    SatisfiesSetTheoreticCondition B S hS X := by
  let : Small.{u} I := Countable.toSmall.{u} I
  let : Countable (Shrink.{u} I) := (equivShrink.{u} I).symm.injective.countable
  let : B.AdmitsCoproductIndex I :=
    ⟨Cardinal.mk_le_aleph0.trans_lt B.aleph0_lt_cutoff_cof⟩
  exact satisfiesSetTheoreticCondition_of_admissible_colimit B S hS D hD X hX

end AlgebraicGeometry.FormalSpace

end
