-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe v u

namespace AlgebraicGeometry.FormalSpace

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {X : FppfSheaf B S hS}

/-- The uniqueness half of **Stacks 0AQD** for every object of the site at once: an fppf sheaf
on the big fppf site of `S` is separated for every fpqc covering presieve.

This is the one property beyond the fppf sheaf condition that the reduction of this module uses,
and `AlgebraicGeometry.FormalSpace.isSeparatedFor_fpqc_of_isFormalAlgebraicSpace` supplies it
for an arbitrary formal algebraic space. -/
abbrev IsSeparatedForFpqc (X : FppfSheaf B S hS) : Prop :=
  ∀ ⦃Y : BigFppfOver B S hS⦄ {R : Presieve Y},
    R ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) Y →
    Presieve.IsSeparatedFor X.obj R

/-- The uniqueness half of **Stacks 0AQD** holds, in the form
`AlgebraicGeometry.FormalSpace.IsSeparatedForFpqc`, for an arbitrary formal algebraic space. -/
theorem isSeparatedForFpqc_of_isFormalAlgebraicSpace (hX : IsFormalAlgebraicSpace B S hS X) :
    IsSeparatedForFpqc X :=
  fun _ _ hR ↦ isSeparatedFor_fpqc_of_isFormalAlgebraicSpace hX hR

/-! ### The Zariski stage and the refinement over an affine object -/

/-- An fppf sheaf of `Type (u + 1)` satisfies the sheaf condition for the fppf topology. -/
private theorem isSheaf_obj_of_fppf (X : FppfSheaf B S hS) :
    Presieve.IsSheaf (BigFppfOver.topology B S hS) X.obj :=
  (isSheaf_iff_isSheaf_of_type _ _).mp X.property

/-- The pullback of the sieve generated by an fpqc covering presieve is separated for `X`. -/
private theorem isSeparatedFor_pullback_generate (hsep : IsSeparatedForFpqc X)
    {T Y : BigFppfOver B S hS} {R : Presieve T}
    (f : Y ⟶ T) (hR : R ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) T) :
    Presieve.IsSeparatedFor X.obj (Sieve.pullback f (Sieve.generate R)).arrows := by
  rw [← Sieve.pullbackArrows_comm, ← Presieve.isSeparatedFor_iff_generate]
  exact hsep (Precoverage.pullbackArrows_mem f hR)

/-- The sheaf condition for an fpqc covering presieve of a fixed object follows from the sheaf
condition for any fpqc covering presieve refining it.

Only the uniqueness half of Stacks 0AQD is used: separatedness for the refinement after an
arbitrary base change upgrades the sheaf condition from the refinement to the original presieve.
This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_fpqc_of_isSheafFor_refinement`. -/
theorem isSheafFor_fpqc_of_isSheafFor_refinement (hsep : IsSeparatedForFpqc X)
    {T : BigFppfOver B S hS} {R R' : Presieve T}
    (hR' : R' ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) T)
    (hle : Sieve.generate R' ≤ Sieve.generate R) (hsheaf : Presieve.IsSheafFor X.obj R') :
    Presieve.IsSheafFor X.obj R := by
  rw [Presieve.isSheafFor_iff_generate]
  refine Presieve.isSheafFor_subsieve_aux X.obj hle
    ((Presieve.isSheafFor_iff_generate _).mp hsheaf) fun Y f _ ↦ ?_
  exact isSeparatedFor_pullback_generate hsep f hR'

/-- **The fpqc sheaf condition is Zariski local on the base.** An fppf sheaf on the big fppf
site of `S` which is separated for every fpqc covering presieve is a sheaf for the fpqc topology
as soon as it satisfies the sheaf condition for every fpqc covering presieve of an object whose
underlying scheme is *affine*.

The affine opens of the sources of an fpqc covering family give a Zariski covering of the base
by affine objects of the site, which is an fppf covering of it; the sheaf condition for a sieve
may be checked after pulling it back along such a covering, and the pullback of an fpqc covering
presieve is again one. This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheaf_fpqc_of_isSheafFor_of_isAffine`. -/
theorem isSheaf_fpqc_of_isSheafFor_of_isAffine (hsep : IsSeparatedForFpqc X)
    (h : ∀ ⦃Y : BigFppfOver B S hS⦄ (R : Presieve Y),
      IsAffine ((BigFppfOver.toScheme B S hS).obj Y) →
      R ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) Y →
      Presieve.IsSheafFor X.obj R) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) X.obj := by
  refine isSheaf_fpqc_of_isSheafFor fun {T} R hR ↦ ?_
  obtain ⟨J, Z, u, m, W, w, hZaff, hu, hzar, -, -, -, -⟩ :=
    BigFppfOver.exists_zariski_affine_flat_refinement R hR
  have hmem₀ : Sieve.generate (Presieve.ofArrows Z u) ∈ BigFppfOver.topology B S hS T := by
    refine BigFppfOver.sieve_generate_ofArrows_mem_topology Z u ?_
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hzar
    exact Scheme.zariskiPrecoverage_le_fppfPrecoverage _ hzar
  let E₀ : PreZeroHypercover.{u} T := ⟨J, Z, u⟩
  let E : (BigFppfOver.topology B S hS).OneHypercover T :=
    GrothendieckTopology.OneHypercover.mk' E₀.toPreOneHypercover hmem₀ (fun i j ↦
      (CategoryTheory.sieve₁'_toPreOneHypercover_eq_top E₀ i j) ▸
        GrothendieckTopology.top_mem _ _)
  refine E.isSheafFor_of_pullback (isSheaf_obj_of_fppf X) (fun i ↦ ?_) (fun i j k ↦ ?_)
  · show Presieve.IsSheafFor X.obj (Sieve.pullback (u i) (Sieve.generate R)).arrows
    rw [← Sieve.pullbackArrows_comm, ← Presieve.isSheafFor_iff_generate]
    exact h _ (hZaff i) (Precoverage.pullbackArrows_mem _ hR)
  · exact isSeparatedFor_pullback_generate hsep _ hR

/-- **The fpqc sheaf condition from the standard fpqc coverings of Stacks 022F.** An fppf sheaf
on the big fppf site of `S` which is separated for every fpqc covering presieve is a sheaf for
the fpqc topology as soon as it satisfies the sheaf condition for the fpqc covering presieves
generated by a *finite* family of flat morphisms with affine sources over an affine base.

Over an affine object every fpqc covering presieve is refined by such a family,
`AlgebraicGeometry.BigFppfOver.exists_finite_affine_flat_refinement`, which is the refinement
half of **Stacks 022H**. This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheaf_fpqc_of_isSheafFor_affine_flat_finite`. -/
theorem isSheaf_fpqc_of_isSheafFor_affine_flat_finite (hsep : IsSeparatedForFpqc X)
    (h : ∀ ⦃Y : BigFppfOver B S hS⦄ (m : ℕ) (W : Fin m → BigFppfOver B S hS)
      (w : ∀ i, W i ⟶ Y), IsAffine ((BigFppfOver.toScheme B S hS).obj Y) →
      (∀ i, IsAffine ((BigFppfOver.toScheme B S hS).obj (W i))) →
      (∀ i, Flat ((BigFppfOver.toScheme B S hS).map (w i))) →
      Presieve.ofArrows W w ∈
        Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) Y →
      Presieve.IsSheafFor X.obj (Presieve.ofArrows W w)) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) X.obj := by
  refine isSheaf_fpqc_of_isSheafFor_of_isAffine hsep fun {Y} R hYaff hR ↦ ?_
  obtain ⟨m, W, w, hWaff, hwflat, hmem, hle⟩ :=
    BigFppfOver.exists_finite_affine_flat_refinement hYaff R hR
  exact isSheafFor_fpqc_of_isSheafFor_refinement hsep hmem hle
    (h m W w hYaff hWaff hwflat hmem)

/-! ### Finite coproducts and the disjoint union step -/

/-- **An fppf sheaf takes the initial object of the site to a singleton.** This is the nullary
case of the preservation of finite products, and it needs no fpqc input: the initial object of
the big fppf category over `S` has empty underlying scheme, and the empty family is an fppf
covering family of the empty scheme, joint surjectivity on points being vacuous there.

This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_empty_of_isInitial`. -/
theorem isSheafFor_empty_of_isInitial {I : BigFppfOver B S hS} (hI : IsInitial I) {ι : Type v}
    [IsEmpty ι] (Z : ι → BigFppfOver B S hS) (u : ∀ j, Z j ⟶ I) :
    Presieve.IsSheafFor X.obj (Presieve.ofArrows Z u) := by
  have hIe : IsEmpty ((BigFppfOver.toScheme B S hS).obj I) :=
    isInitial_iff_isEmpty.mp ⟨hI.isInitialObj (BigFppfOver.toScheme B S hS) I⟩
  refine (Presieve.isSheafFor_iff_generate _).mpr (isSheaf_obj_of_fppf X _ ?_)
  refine BigFppfOver.sieve_generate_ofArrows_mem_topology Z u ?_
  have hbot : Presieve.ofArrows (fun j ↦ (BigFppfOver.toScheme B S hS).obj (Z j))
      (fun j ↦ (BigFppfOver.toScheme B S hS).map (u j)) = ⊥ := by
    refine le_antisymm ?_ bot_le
    rw [Presieve.ofArrows_le_iff]
    intro j
    exact (IsEmpty.false j).elim
  rw [hbot]
  exact Scheme.bot_mem_precoverage _ _

/-- **An fppf sheaf satisfies the sheaf condition for the injections of a finite coproduct of
the site.** Those injections are an fppf covering family by
`AlgebraicGeometry.BigFppfOver.ofArrows_cofan_inj_mem_fppfPrecoverage`, so this is again only the
fppf sheaf condition.

This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_ofArrows_cofan_inj`. -/
theorem isSheafFor_ofArrows_cofan_inj {ι : Type v} [Finite ι] (W : ι → BigFppfOver B S hS)
    {c : Cofan W} (hc : IsColimit c) :
    Presieve.IsSheafFor X.obj (Presieve.ofArrows W c.inj) := by
  refine (Presieve.isSheafFor_iff_generate _).mpr (isSheaf_obj_of_fppf X _ ?_)
  exact BigFppfOver.sieve_generate_ofArrows_mem_topology W c.inj
    (BigFppfOver.ofArrows_cofan_inj_mem_fppfPrecoverage W hc)

/-- **An fppf sheaf on the big fppf site of `S` preserves finite products.** This is the third
ingredient the disjoint union step needs.

`CategoryTheory.Presieve.preservesProduct_of_isSheafFor` turns the sheaf condition for the
injections of a coproduct into preservation of the corresponding product, given that the
injections are monomorphisms with pairwise initial intersections and given the nullary case.
This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.preservesLimitsOfShape_discrete`. -/
theorem preservesLimitsOfShape_discrete (X : FppfSheaf B S hS) (ι : Type v) [Finite ι] :
    PreservesLimitsOfShape (Discrete ι) X.obj := by
  apply (config := { allowSynthFailures := true }) preservesLimitsOfShape_of_discrete
  intro Y
  set Z : ι → BigFppfOver B S hS := fun i ↦ unop (Y i) with hZ
  have hmono (i : ι) : Mono ((Cofan.mk (∐ Z) (Sigma.ι Z)).inj i) :=
    inferInstanceAs (Mono (Sigma.ι Z i))
  refine Presieve.preservesProduct_of_isSheafFor X.obj
    (isSheafFor_empty_of_isInitial initialIsInitial _ _) initialIsInitial
    (Cofan.mk (∐ Z) (Sigma.ι Z)) (coproductIsCoproduct Z) (fun i j ↦ ?_)
    (isSheafFor_ofArrows_cofan_inj Z (coproductIsCoproduct Z))
  exact CoproductDisjoint.isPullback_of_isInitial (coproductIsCoproduct Z) initialIsInitial

/-- **The disjoint union step.** The sheaf condition for a finite family `{W i ⟶ Y}` of the big
fppf category over `S` follows from the sheaf condition for the single morphism `⨿ᵢ W i ⟶ Y` out
of its coproduct.

This is Mathlib's `CategoryTheory.Presieve.isSheafFor_sigmaDesc_iff`, whose inputs are the
existence of the coproduct and the universality of its cofan, both from
`AlgebraicGeometry.finitaryExtensive_bigFppfOver`, and the preservation of the two finite
products involved. It is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_ofArrows_of_isSheafFor_singleton_cofanDesc`. -/
theorem isSheafFor_ofArrows_of_isSheafFor_singleton_cofanDesc {ι : Type v} [Finite ι]
    {Y : BigFppfOver B S hS} (W : ι → BigFppfOver B S hS) (w : ∀ i, W i ⟶ Y) {c : Cofan W}
    (hc : IsColimit c)
    (h : Presieve.IsSheafFor X.obj (Presieve.singleton (Cofan.IsColimit.desc hc w))) :
    Presieve.IsSheafFor X.obj (Presieve.ofArrows W w) := by
  have h₁ := preservesLimitsOfShape_discrete X ι
  have h₂ := preservesLimitsOfShape_discrete X (ι × ι)
  exact (Presieve.isSheafFor_sigmaDesc_iff w hc
    (FinitaryExtensive.isVanKampen_finiteCoproducts hc).isUniversal X.obj).mp h

/-! ### The reduction to a single morphism of affines -/

/-- **The first paragraph of Stacks 0APL, for an fppf sheaf of `Type (u + 1)`.** An fppf sheaf
on the big fppf site of `S` which is separated for every fpqc covering presieve is a sheaf for
the fpqc topology of that site as soon as it satisfies the sheaf condition for the presieve
generated by a *single* morphism of the site whose source and target have affine underlying
scheme and whose underlying morphism of schemes is surjective, flat and quasi-compact.

The finite family supplied by
`AlgebraicGeometry.FormalSpace.isSheaf_fpqc_of_isSheafFor_affine_flat_finite` is replaced by the
morphism out of the coproduct of its sources: that source is affine because a finite coproduct of
affine schemes is affine, the morphism is flat because a coproduct of flat morphisms is flat, it
is surjective because the family is jointly surjective, and it is quasi-compact because both of
its ends are affine.

This is the `Type (u + 1)` form of
`AlgebraicGeometry.IsAlgebraicSpace.isSheaf_fpqc_of_isSheafFor_singleton_affine`. -/
theorem isSheaf_fpqc_of_isSheafFor_singleton_affine (hsep : IsSeparatedForFpqc X)
    (h : ∀ ⦃Y T : BigFppfOver B S hS⦄ (f : T ⟶ Y),
      IsAffine ((BigFppfOver.toScheme B S hS).obj Y) →
      IsAffine ((BigFppfOver.toScheme B S hS).obj T) →
      Surjective ((BigFppfOver.toScheme B S hS).map f) →
      Flat ((BigFppfOver.toScheme B S hS).map f) →
      QuasiCompact ((BigFppfOver.toScheme B S hS).map f) →
      Presieve.IsSheafFor X.obj (Presieve.singleton f)) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) X.obj := by
  refine isSheaf_fpqc_of_isSheafFor_affine_flat_finite hsep
    fun {Y} m W w hYaff hWaff hwflat hmem ↦ ?_
  set G := BigFppfOver.toScheme B S hS with hG
  have hc : IsColimit (Cofan.mk (∐ W) (Sigma.ι W)) := coproductIsCoproduct W
  obtain ⟨e, he⟩ := BigFppfOver.exists_iso_sigma_of_isColimit_cofan W hc
  set g := Cofan.IsColimit.desc hc w with hg
  -- the comparison isomorphism identifies `G.map g` with the coproduct descent in schemes
  have hgdesc : G.map g = e.inv ≫ Sigma.desc fun i ↦ G.map (w i) := by
    rw [← Category.id_comp (G.map g), ← e.inv_hom_id, Category.assoc]
    congr 1
    refine Sigma.hom_ext _ _ fun i ↦ ?_
    rw [← Category.assoc, he i, Sigma.ι_desc, ← Functor.map_comp]
    exact congrArg G.map (Cofan.IsColimit.fac hc w i)
  -- the source of the single morphism is affine: a finite coproduct of affines is affine
  have hWaff' (i : Fin m) : IsAffine (G.obj (W i)) := hWaff i
  have hTaff : IsAffine (G.obj (Cofan.mk (∐ W) (Sigma.ι W)).pt) :=
    IsAffine.of_isIso e.inv
  -- flatness
  have hflat : Flat (G.map g) := by
    have : Flat (Sigma.desc fun i ↦ G.map (w i)) := by
      have hw (i : Fin m) : Flat (G.map (w i)) := hwflat i
      infer_instance
    rw [hgdesc]
    infer_instance
  -- surjectivity, from joint surjectivity of the family
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hmem
  obtain ⟨-, hfl⟩ := hmem
  obtain ⟨hjs, -⟩ := (Scheme.ofArrows_mem_precoverage_iff _).mp hfl
  have hsurj : Surjective (G.map g) := by
    have : Surjective (Sigma.desc fun i ↦ G.map (w i)) := by
      refine ⟨fun y ↦ ?_⟩
      obtain ⟨i, z, hzy⟩ := hjs y
      refine ⟨Sigma.ι (fun i ↦ G.obj (W i)) i z, ?_⟩
      rw [← Scheme.Hom.comp_apply, Sigma.ι_desc]
      exact hzy
    rw [hgdesc]
    infer_instance
  -- quasi-compactness, both ends being affine
  have hqc : QuasiCompact (G.map g) := by
    have := hTaff
    have := hYaff
    infer_instance
  exact isSheafFor_ofArrows_of_isSheafFor_singleton_cofanDesc W w hc
    (h g hYaff hTaff hsurj hflat hqc)

/-- **Stacks 0AQD for an arbitrary formal algebraic space, reduced to one morphism of
affines.** A formal algebraic space over `S` is a sheaf for the fpqc topology of the big fppf
site of `S` as soon as it satisfies the sheaf condition for the presieve generated by a single
morphism of the site whose source and target have affine underlying scheme and whose underlying
morphism of schemes is surjective, flat and quasi-compact.

This is the whole first paragraph of the source's proof, discharged: the uniqueness half, which
`AlgebraicGeometry.FormalSpace.isSheaf_fpqc_of_isSheafFor_singleton_affine` takes as `hsep`, is
supplied by `AlgebraicGeometry.FormalSpace.isSeparatedFor_fpqc_of_isFormalAlgebraicSpace`.

The remaining hypothesis is the source's second paragraph, where **Stacks 0APK** enters. It is
discharged by `AlgebraicGeometry.FormalSpace.isSheafFor_singleton_of_isFormalAlgebraicSpace`, and
Stacks 0AQD is registered on `AlgebraicGeometry.FormalSpace.isSheaf_fpqc`. -/
theorem isSheaf_fpqc_of_isSheafFor_singleton_affine_of_formal
    (hX : IsFormalAlgebraicSpace B S hS X)
    (h : ∀ ⦃Y T : BigFppfOver B S hS⦄ (f : T ⟶ Y),
      IsAffine ((BigFppfOver.toScheme B S hS).obj Y) →
      IsAffine ((BigFppfOver.toScheme B S hS).obj T) →
      Surjective ((BigFppfOver.toScheme B S hS).map f) →
      Flat ((BigFppfOver.toScheme B S hS).map f) →
      QuasiCompact ((BigFppfOver.toScheme B S hS).map f) →
      Presieve.IsSheafFor X.obj (Presieve.singleton f)) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) X.obj :=
  isSheaf_fpqc_of_isSheafFor_singleton_affine (isSeparatedForFpqc_of_isFormalAlgebraicSpace hX) h

end AlgebraicGeometry.FormalSpace

end
