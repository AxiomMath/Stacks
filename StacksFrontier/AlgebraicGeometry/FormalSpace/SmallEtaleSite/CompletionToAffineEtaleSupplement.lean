/-! ### Rigidity of the quotient stages below a weak ideal of definition -/

section Rigidity

/-- The transition map of the quotient stages is compatible with their structure maps. -/
theorem transitionMap_comp_stageStr (Y : EtaleCompletion A)
    {J K : WeakIdealOfDefinitionIndex A} (h : K.1 ≤ J.1) :
    (transitionMap Y.str h).comp (Y.stageStr K) =
      (Y.stageStr J).comp (Ideal.Quotient.factor h) := by
  refine Ideal.Quotient.ringHom_ext (RingHom.ext fun a ↦ ?_)
  simp [transitionMap, stageStr]

/-- **The kernel of a transition map of quotient stages consists of nilpotent elements.** The
kernel is generated by the image of the bigger weak ideal of definition `J`, each element of
which is topologically nilpotent, so a power of it already lies in the smaller `K`. -/
theorem ker_transitionMap_le_nilradical (Z : EtaleCompletion A)
    {J K : WeakIdealOfDefinitionIndex A} (hKJ : K.1 ≤ J.1) :
    RingHom.ker (transitionMap Z.str hKJ) ≤ nilradical (Z.stage K) := by
  have hstep : extendedIdeal Z.str J ≤
      Ideal.comap (Ideal.Quotient.mk (extendedIdeal Z.str K)) (nilradical (Z.stage K)) := by
    refine Ideal.map_le_iff_le_comap.mpr fun j hj ↦ ?_
    change Ideal.Quotient.mk (extendedIdeal Z.str K) (Z.str j) ∈ nilradical (Z.stage K)
    obtain ⟨n, hn⟩ := (J.2.2 j hj).exists_pow_mem_of_mem_nhds (K.2.1.mem_nhds K.1.zero_mem)
    refine mem_nilradical.mpr ⟨n, ?_⟩
    rw [← map_pow, ← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hn)
  intro x hx
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine hstep ?_
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  simpa [transitionMap] using hx

/-- The quotient of `B ⧸ KB` by the kernel of its transition map to `B ⧸ JB` is `B ⧸ JB`, that
transition map being surjective. -/
private noncomputable def kerTransitionEquiv (Z : EtaleCompletion A)
    {J K : WeakIdealOfDefinitionIndex A} (hKJ : K.1 ≤ J.1) :
    (Z.stage K) ⧸ RingHom.ker (transitionMap Z.str hKJ) ≃+* Z.stage J :=
  RingHom.quotientKerEquivOfSurjective
    (Ideal.Quotient.factor_surjective (Ideal.map_mono hKJ))

/-- **Rigidity of the quotient stages below `J`.** An `A ⧸ J`-algebra homomorphism
`B₁ ⧸ JB₁ → B₂ ⧸ JB₂` of the quotient stages at a weak ideal of definition `J` is induced by a
unique `A ⧸ K`-algebra homomorphism `B₁ ⧸ KB₁ → B₂ ⧸ KB₂` of the quotient stages at any weak
ideal of definition `K ⊆ J`.

This is the étale lifting of Stacks 0ALI at the pair `(A ⧸ K, J ⧸ K)`: the stage `B₁ ⧸ KB₁` is
étale over `A ⧸ K` by Stacks 0AN8, first step, and the kernel of the transition map
`B₂ ⧸ KB₂ → B₂ ⧸ JB₂` is locally nilpotent because `J` is a weak ideal of definition and `K` is
open, so `Algebra.Etale.existsUnique_lift_of_isLocallyNilpotent` applies.

It is the rigidity step of the full faithfulness of the functor of Stacks 0DEF: a morphism
`B₁^∧ → B₂^∧` of the category of Stacks 0DEF is a compatible family of maps of quotient stages,
one for each weak ideal of definition, and this determines each member of that family from the
one at `J`. -/
@[sga "4 XIII 1.5" "special case"]
theorem existsUnique_stageHom_of_le {J K : WeakIdealOfDefinitionIndex A} (hKJ : K.1 ≤ J.1)
    (Y Z : EtaleCompletion A) (φ : Y.stage J →+* Z.stage J)
    (hφ : φ.comp (Y.stageStr J) = Z.stageStr J) :
    ∃! ψ : Y.stage K →+* Z.stage K, ψ.comp (Y.stageStr K) = Z.stageStr K ∧
      (transitionMap Z.str hKJ).comp ψ = φ.comp (transitionMap Y.str hKJ) := by
  let : Algebra (A ⧸ K.1) (Y.stage K) := (Y.stageStr K).toAlgebra
  let : Algebra (A ⧸ K.1) (Z.stage K) := (Z.stageStr K).toAlgebra
  have : Algebra.Etale (A ⧸ K.1) (Y.stage K) := Y.etale_stageStr K
  have hN : (RingHom.ker (transitionMap Z.str hKJ)).IsLocallyNilpotent := fun x hx ↦
    mem_nilradical.mp (ker_transitionMap_le_nilradical Z hKJ hx)
  set e := kerTransitionEquiv Z hKJ with hedef
  have hmk : ∀ x : Z.stage K,
      e (Ideal.Quotient.mk (RingHom.ker (transitionMap Z.str hKJ)) x) =
        transitionMap Z.str hKJ x := fun _ ↦ rfl
  -- the condition on a lift, transported across `e`
  have hchar : ∀ ψ : Y.stage K →+* Z.stage K,
      ((Ideal.Quotient.mk (RingHom.ker (transitionMap Z.str hKJ))).comp ψ =
          (e.symm : Z.stage J →+* _).comp (φ.comp (transitionMap Y.str hKJ))) ↔
        (transitionMap Z.str hKJ).comp ψ = φ.comp (transitionMap Y.str hKJ) := by
    refine fun ψ ↦ ?_
    rw [RingHom.ext_iff, RingHom.ext_iff]
    refine forall_congr' fun x ↦ ?_
    simp only [RingHom.comp_apply, RingHom.coe_coe]
    rw [← hmk, e.eq_symm_apply]
  -- the prescribed map into the quotient is a homomorphism of `A ⧸ K`-algebras
  have hcomm : ∀ r : A ⧸ K.1,
      ((e.symm : Z.stage J →+* _).comp (φ.comp (transitionMap Y.str hKJ)))
          (algebraMap (A ⧸ K.1) (Y.stage K) r) =
        algebraMap (A ⧸ K.1) ((Z.stage K) ⧸ RingHom.ker (transitionMap Z.str hKJ)) r := by
    intro r
    have hY := RingHom.congr_fun (transitionMap_comp_stageStr Y hKJ) r
    have hZ := RingHom.congr_fun (transitionMap_comp_stageStr Z hKJ) r
    have hφr := RingHom.congr_fun hφ (Ideal.Quotient.factor hKJ r)
    simp only [RingHom.comp_apply] at hY hZ hφr
    change e.symm (φ (transitionMap Y.str hKJ (Y.stageStr K r))) =
      Ideal.Quotient.mk (RingHom.ker (transitionMap Z.str hKJ)) (Z.stageStr K r)
    refine e.injective ?_
    rw [RingEquiv.apply_symm_apply, hmk (Z.stageStr K r), hY, hφr, hZ]
  obtain ⟨f, hf, hu⟩ := Algebra.Etale.existsUnique_lift_of_isLocallyNilpotent hN
    ({ ((e.symm : Z.stage J →+* _).comp (φ.comp (transitionMap Y.str hKJ))) with
        commutes' := hcomm } : Y.stage K →ₐ[A ⧸ K.1] _)
  refine ⟨f.toRingHom, ⟨RingHom.ext fun r ↦ f.commutes r, (hchar _).mp ?_⟩, ?_⟩
  · exact congrArg AlgHom.toRingHom hf
  · rintro ψ ⟨hψ₁, hψ₂⟩
    have hfψ := hu ({ ψ with commutes' := fun r ↦ RingHom.congr_fun hψ₁ r } :
      Y.stage K →ₐ[A ⧸ K.1] Z.stage K) (by
        ext x
        exact RingHom.congr_fun ((hchar ψ).mpr hψ₂) x)
    exact congrArg AlgHom.toRingHom hfψ

end Rigidity

/-! ### The formal spectrum of an object is a chart of the category of Stacks 0DEE -/

section Chart

variable [IsTopologicalRing A] [IsLinearTopology A A]
  (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **The formal spectrum of an object of the category of Stacks 0DEF is an object of the
category of Stacks 0DEE over `Spf A`.** For an object `B^∧` of the category of Stacks 0DEF over
a weakly admissible `A` presented by a quotient system, the relative completion carries a
quotient system over `S` and a continuous map from `A` whose underlying ring map is the
canonical one, and the resulting morphism `Spf B^∧ ⟶ Spf A` satisfies both conditions of
Stacks 0DEE: its source is an affine formal algebraic space, and it is representable by
algebraic spaces and étale.

The quotient system of the completion and the bound making
its stages lie in the site are Stacks 0ANM,
`AlgebraicGeometry.FormalSpace.exists_completionOver_quotientSystem` and
`AlgebraicGeometry.FormalSpace.hasLargeSite_completionOver_of_finiteType`, an étale ring map
being of finite type; being an affine formal algebraic space is then Stacks 0AIF for the
completion, which is weakly admissible. The representability and étaleness conditions are
`AlgebraicGeometry.FormalSpace.isRepresentableEtale_formalSpectrumMap_completionOver`, which is
Stacks 0ANM for the first and Stacks 0AN8, first step, localized on the target for the second.

This is what the quasi-inverse of Stacks 0DEF asks of `Spf B^∧ ⟶ Spf A`. -/
theorem exists_isAffineEtaleFormalChart_formalSpectrumMap
    (hA : IsWeaklyAdmissible A) (D : QuotientSystem B S hS A) (hD : D.HasLargeSite)
    (Y : EtaleCompletion A) :
    ∃ (E : QuotientSystem B S hS Y.completion) (g : ContinuousHom D E),
      g.toRingHom = TopologicalRing.CompletionOver.canonicalMap Y.str ∧
        IsAffineEtaleFormalChart B S hS (formalSpectrum D)
          (Over.mk (formalSpectrumMap hA g)) := by
  have hft : Y.str.FiniteType := finiteType_of_etale Y.str Y.etale
  obtain ⟨E, g, hg⟩ := exists_completionOver_quotientSystem B S hS Y.str hft hA D hD
  exact ⟨E, g, hg,
    isAffineFormalAlgebraicSpace_formalSpectrum
      (TopologicalRing.completionOver_isWeaklyAdmissible Y.str hA) E
      (hasLargeSite_completionOver_of_finiteType B S hS Y.str hft hD E),
    isRepresentableEtale_formalSpectrumMap_completionOver hA Y.str Y.etale D hD E g hg⟩

end Chart

end EtaleCompletion

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

end AlgebraicGeometry.FormalSpace

