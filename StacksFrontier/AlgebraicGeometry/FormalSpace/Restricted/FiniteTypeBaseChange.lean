/-!
# Adic morphisms of topological finite type under completed tensor-product base change

Let `A` and `C` be linearly topologized algebras over a linearly topologized ring `R`.  If `A`
is topologically of finite type over `R`, then the completed tensor product `A ⊗̂[R] C` is
topologically of finite type over `C`: the same `n` variables work, evaluated at the images of
a dense polynomial presentation of `A` under `A → A ⊗[R] C`.  Indeed the `C`-subalgebra of
`A ⊗[R] C` topologically generated by those images contains every pure tensor `a ⊗ c`, hence is
dense, and the algebraic tensor product is dense in its completion.

Combining this with the base-change stability of tautness, and with the fact that the completed
tensor product of weakly pre-admissible rings is weakly admissible, the conjunction of being
adic and being topologically of finite type is preserved by this base change.

## Main results

* `TopologicalRing.continuous_algebraMap_completedTensorProduct_right`: the canonical map from
  the second factor into the completed tensor product is continuous.
* `TopologicalRing.isTopologicallyOfFiniteType_completedTensorProduct_baseChange`: the base
  change of a homomorphism topologically of finite type along the completed tensor product is
  topologically of finite type.
* `TopologicalRing.isAdic_and_isTopologicallyOfFiniteType_completedTensorProduct_baseChange`:
  the same for the conjunction of adicness and topological finite type.
* `TopologicalRing.adicAndFiniteType_isStableUnderBaseChange`: adic morphisms of topological
  finite type form a local property stable under completed tensor-product base change.

## References

* [Stacks Project, Tag 0ANS](https://stacks.math.columbia.edu/tag/0ANS)
* [Stacks Project, Tag 0GBY](https://stacks.math.columbia.edu/tag/0GBY)
-/

@[expose] public section

namespace TopologicalRing

section

universe u

open scoped TensorProduct

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- The canonical homomorphism from the second factor into the completed tensor product is
continuous. -/
public theorem continuous_algebraMap_completedTensorProduct_right
    {R A C : Type u} [CommRing R] [CommRing A] [CommRing C]
    [TopologicalSpace A] [TopologicalSpace C] [IsTopologicalRing A] [IsTopologicalRing C]
    [IsLinearTopology A A] [IsLinearTopology C C] [Algebra R A] [Algebra R C] :
    Continuous
      (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))) := by
  let : TopologicalSpace (A ⊗[R] C) :=
    TopologicalRing.tensorProductTopology (R := R) (M := A) (N := C)
  let : UniformSpace (A ⊗[R] C) :=
    TopologicalRing.tensorProductUniformSpace (R := R) (M := A) (N := C)
  change Continuous fun c : C =>
    (((1 : A) ⊗ₜ[R] c : A ⊗[R] C) :
      TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))
  exact (UniformSpace.Completion.continuous_coe (A ⊗[R] C)).comp
    (TopologicalRing.continuous_const_tmul (R := R) (M := A) (N := C) (1 : A))

/-- If `A` is topologically of finite type over `R`, then the completed tensor product
`A ⊗̂[R] C` is topologically of finite type over `C`. -/
public theorem isTopologicallyOfFiniteType_completedTensorProduct_baseChange
    {R A C : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsLinearTopology R R] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra R A] [Algebra R C]
    (hA : TopologicalRing.IsTopologicallyOfFiniteType (algebraMap R A)) :
    TopologicalRing.IsTopologicallyOfFiniteType
      (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))) := by
  obtain ⟨n, f, hf, hfdense⟩ := hA
  let T := A ⊗[R] C
  let D := TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)
  let : TopologicalSpace T := TopologicalRing.tensorProductTopology (R := R) (M := A) (N := C)
  let : UniformSpace T := TopologicalRing.tensorProductUniformSpace (R := R) (M := A) (N := C)
  let : IsUniformAddGroup T := TopologicalRing.tensorProduct_isUniformAddGroup
  let : IsLinearTopology T T := TopologicalRing.tensorProduct_isLinearTopologyRing
  let : IsTopologicalRing T := TopologicalRing.tensorProduct_isTopologicalRing
  let q : MvPolynomial (Fin n) C →ₐ[C] T :=
    MvPolynomial.aeval (fun i : Fin n =>
      ((Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] C)
        (f (MvPolynomial.X i : MvPolynomial (Fin n) R))))
  let mapC : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C :=
    MvPolynomial.map (algebraMap R C)
  have hright (c : C) : algebraMap C T c = (1 : A) ⊗ₜ[R] c :=
    Algebra.TensorProduct.includeRight_apply c
  have hpoly : q.toRingHom.comp mapC =
      (Algebra.TensorProduct.includeLeft : A →ₐ[R] T).toRingHom.comp f := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      dsimp [mapC]
      rw [MvPolynomial.map_C]
      change q (algebraMap C (MvPolynomial (Fin n) C) (algebraMap R C r)) =
        f (MvPolynomial.C r) ⊗ₜ[R] (1 : C)
      rw [q.commutes]
      change algebraMap C T (algebraMap R C r) =
        (f.comp MvPolynomial.C) r ⊗ₜ[R] (1 : C)
      rw [hf, hright]
      change (1 : A) ⊗ₜ[R] algebraMap R C r =
        (algebraMap R A r) ⊗ₜ[R] (1 : C)
      calc
        (1 : A) ⊗ₜ[R] algebraMap R C r =
            (1 : A) ⊗ₜ[R] (r • (1 : C)) := by simp [Algebra.smul_def]
        _ = (r • (1 : A)) ⊗ₜ[R] (1 : C) :=
          (TensorProduct.smul_tmul (R := R) r (1 : A) (1 : C)).symm
        _ = algebraMap R A r ⊗ₜ[R] (1 : C) := by rw [Algebra.smul_def]; simp
    · intro i
      simp [q, mapC]
  let S : Subalgebra C T := q.range.topologicalClosure
  have hpure : ∀ a : A, ∀ c : C, a ⊗ₜ[R] c ∈ S := by
    intro a c
    let g : A → T := fun x => x ⊗ₜ[R] c
    have hclosed : IsClosed (g ⁻¹' (S : Set T)) := by
      simpa [S] using (Subalgebra.isClosed_topologicalClosure q.range).preimage
        (TopologicalRing.continuous_tmul_const (R := R) (M := A) (N := C) c)
    have hrange : Set.range f ⊆ g ⁻¹' (S : Set T) := by
      rintro _ ⟨p, rfl⟩
      have hq : q (mapC p) ∈ S :=
        (Subalgebra.le_topologicalClosure q.range) ⟨mapC p, rfl⟩
      have hqp : q (mapC p) = f p ⊗ₜ[R] (1 : C) :=
        DFunLike.congr_fun hpoly p
      have heq : g (f p) = q (mapC p) * algebraMap C T c := by
        rw [hqp, hright c]
        dsimp [g]
        rw [Algebra.TensorProduct.tmul_mul_tmul]
        simp
      change g (f p) ∈ S
      rw [heq]
      exact S.mul_mem hq (S.algebraMap_mem c)
    change g a ∈ S
    exact closure_minimal hrange hclosed
      (by rw [denseRange_iff_closure_range.mp hfdense]; simp)
  have hall : ∀ x : T, x ∈ S := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul a c => exact hpure a c
    | add x y hx hy => exact S.add_mem hx hy
  have htop : S = ⊤ := top_unique fun x _ => hall x
  have hqDense : DenseRange (q : MvPolynomial (Fin n) C → T) := by
    rw [denseRange_iff_closure_range]
    simpa [S, Subalgebra.topologicalClosure_coe] using
      congrArg (fun U : Subalgebra C T => (U : Set T)) htop
  let qD : MvPolynomial (Fin n) C →+* D :=
    (UniformSpace.Completion.coeRingHom : T →+* D).comp q.toRingHom
  refine ⟨n, qD, ?_, ?_⟩
  · change qD.comp MvPolynomial.C = algebraMap C D
    have hqconst : q.toRingHom.comp MvPolynomial.C = algebraMap C T :=
      RingHom.ext fun c => q.commutes c
    change (UniformSpace.Completion.coeRingHom : T →+* D).comp
        (q.toRingHom.comp MvPolynomial.C) =
      (UniformSpace.Completion.coeRingHom : T →+* D).comp (algebraMap C T)
    rw [hqconst]
  · have hdense : DenseRange (UniformSpace.Completion.coeRingHom : T →+* D) :=
      UniformSpace.Completion.denseRange_coe
    exact hdense.comp hqDense (UniformSpace.Completion.continuous_coe T)

/-- **Base change of adic morphisms of topological finite type.**  If `A` and `C` are weakly
admissible linearly topologized algebras over `R`, `C` has a finitely generated ideal of
definition, and `R → A` is adic and topologically of finite type, then the canonical
homomorphism from `C` into the completed tensor product `A ⊗̂[R] C` is again adic and
topologically of finite type. -/
public theorem isAdic_and_isTopologicallyOfFiniteType_completedTensorProduct_baseChange
    {R A C : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsLinearTopology R R] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra R A] [Algebra R C]
    (hA : TopologicalRing.IsWeaklyAdmissible A) (hC : TopologicalRing.IsWeaklyAdmissible C)
    (hCfg : ∃ I : Ideal C, I.FG ∧ _root_.IsAdic I)
    (hRA : Continuous (algebraMap R A)) (hRC : Continuous (algebraMap R C))
    (hP : RingHom.IsAdic (algebraMap R A) ∧
      TopologicalRing.IsTopologicallyOfFiniteType (algebraMap R A)) :
    RingHom.IsAdic
        (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))) ∧
      TopologicalRing.IsTopologicallyOfFiniteType
        (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))) := by
  classical
  obtain ⟨hPadic, hPft⟩ := hP
  refine ⟨?_, isTopologicallyOfFiniteType_completedTensorProduct_baseChange hPft⟩
  have hDweak := TopologicalRing.completedTensorProduct_isWeaklyAdmissible
    (B := R) (A := A) (C := C) hA.1 hC.1
  let : UniformSpace (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) :=
    IsTopologicalAddGroup.rightUniformSpace
      (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))
  let : CompleteSpace (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) :=
    hDweak.2.1
  let : T2Space (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) :=
    hDweak.2.2
  exact (RingHom.isAdic_iff_isTaut
    (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)))
    hCfg).mpr
      (RingHom.isTaut_completedTensorProduct_baseChange hRA hRC
        (RingHom.isTaut_of_isAdic (algebraMap R A) hPadic))

end

section

universe u

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- Adic morphisms of topologically finite type in the category of weakly admissible adic-star
rings form a local property which is stable under completed tensor-product base change. -/
@[stacks 0GBY]
public theorem adicAndFiniteType_isStableUnderBaseChange :
    TopologicalRing.AdicStarPropertyIsStableUnderBaseChange.{u}
      (fun φ => RingHom.IsAdic φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ) where
  isLocal := TopologicalRing.adicAndFiniteType_propertyIsLocal
  baseChange := fun _ _ hA _ hC hCfg hBA hBC hP =>
    isAdic_and_isTopologicallyOfFiniteType_completedTensorProduct_baseChange
      hA hC hCfg hBA hBC hP

/-- Adic morphisms of topologically finite type form a local property of morphisms of
`WAdm^{adic*}` which is stable under base change in the sense of the first half of Stacks
0GBE. This is `TopologicalRing.adicAndFiniteType_isStableUnderBaseChange` read at the class of
rings the source names, and it is what makes the statements of the second half of Stacks 0GBE
that take `TopologicalRing.PropertyIsStableUnderBaseChangeAdicStar` as their hypothesis
non-vacuous. -/
public theorem adicAndFiniteType_isStableUnderBaseChangeAdicStar :
    TopologicalRing.PropertyIsStableUnderBaseChangeAdicStar.{u}
      (fun φ => RingHom.IsAdic φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ) :=
  TopologicalRing.isStableUnderBaseChangeAdicStar_of_adicStarProperty
    adicAndFiniteType_isStableUnderBaseChange

end

end TopologicalRing

