/-!
# Finite type on reductions under completed tensor-product base change

Let `A` and `C` be linearly topologized algebras over a linearly topologized ring `R`, both
having a weak ideal of definition.  The reduction of the completed tensor product
`T = A ⊗̂[R] C` by its topological nilradical is computed by the projection of `T` onto
`A/N(A) ⊗[R] C/N(C)`: that projection is surjective, and its kernel is the closure of the ideal
generated by the images of the two topological nilradicals, hence sits inside `N(T)`.  The
reduction of `T` is therefore a quotient of `A/N(A) ⊗[R] C/N(C)`, which is of finite type over
`C/N(C)` as soon as `A/N(A)` is of finite type over `R`.  Finite type on reductions is
consequently inherited by the base change.

## Main results

* `Rig.isFiniteTypeOnReductions_completedTensorProduct_baseChange`: the base change of a
  homomorphism of finite type on reductions is of finite type on reductions.
* `Rig.isFiniteTypeOnReductions_stableUnderBaseChange`: finite type on reductions is a local
  property of morphisms of countably indexed weakly admissible rings that is stable under
  completed tensor-product base change.

## Implementation notes

Only a weak ideal of definition is required of each factor; neither completeness,
separatedness nor countable generation of the neighbourhood filter is used.  The two
fundamental systems fed to the inverse-limit description of the completed tensor product are
the open ideals contained in the respective topological nilradicals, so that the index
`(N(A), N(C))` used to read off the reduction belongs to both systems.

## References

* [Stacks Project, Tag 0GC2](https://stacks.math.columbia.edu/tag/0GC2)
* [Stacks Project, Tag 0GC3](https://stacks.math.columbia.edu/tag/0GC3)
-/

@[expose] public section

open Filter
open scoped TensorProduct Topology

namespace Rig

section

universe u

open TopologicalRing

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- A weak ideal of definition is contained in the topological nilradical, which is therefore
open. -/
private theorem isOpen_topologicalNilradical_of_isWeaklyPreAdmissible
    {B : Type*} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
    (hB : TopologicalRing.IsWeaklyPreAdmissible B) :
    IsOpen (topologicalNilradical B : Set B) := by
  obtain ⟨I, hI⟩ := hB
  exact (topologicalNilradical B).toAddSubgroup.isOpen_of_mem_nhds
    (Filter.mem_of_superset (hI.1.mem_nhds (Ideal.zero_mem I)) fun x hx =>
      IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mpr (hI.2 x hx))

/-- A continuous ring homomorphism maps the topological nilradical into the topological
nilradical. -/
private theorem topologicalNilradical_le_comap {B D : Type*} [CommRing B] [TopologicalSpace B]
    [IsLinearTopology B B] [CommRing D] [TopologicalSpace D] [IsLinearTopology D D]
    (f : B →+* D) (hf : Continuous f) :
    topologicalNilradical B ≤ (topologicalNilradical D).comap f := fun _ hx =>
  IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mpr
    ((IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mp hx).map hf)

/-- The open ideals of `B` contained in its topological nilradical. -/
private abbrev NilIndex (B : Type u) [CommRing B] [TopologicalSpace B] [IsLinearTopology B B] :=
  {I : Ideal B // IsOpen (I : Set B) ∧ I ≤ topologicalNilradical B}

/-- The topological nilradical, as a member of the system of open ideals contained in it. -/
private abbrev nilZero {B : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] (hB : TopologicalRing.IsWeaklyPreAdmissible B) : NilIndex B :=
  ⟨topologicalNilradical B, isOpen_topologicalNilradical_of_isWeaklyPreAdmissible hB, le_rfl⟩

/-- The open ideals contained in the topological nilradical form a neighbourhood basis of
zero. -/
private theorem hasBasis_nilIndex {B : Type u} [CommRing B] [TopologicalSpace B]
    [IsTopologicalRing B] [IsLinearTopology B B]
    (hB : TopologicalRing.IsWeaklyPreAdmissible B) :
    (𝓝 (0 : B)).HasBasis (fun _ : NilIndex B => True) (fun i => (i.1 : Set B)) :=
  (IsLinearTopology.hasBasis_open_ideal (R := B)).to_hasBasis
    (fun L hL => ⟨⟨L ⊓ topologicalNilradical B,
      hL.inter (isOpen_topologicalNilradical_of_isWeaklyPreAdmissible hB), inf_le_right⟩,
      trivial, inf_le_left⟩)
    (fun i _ => ⟨i.1, i.2.1, le_rfl⟩)

section

variable {R A C : Type u} [CommRing R] [CommRing A] [CommRing C]
  [TopologicalSpace A] [TopologicalSpace C] [IsTopologicalRing A] [IsTopologicalRing C]
  [IsLinearTopology A A] [IsLinearTopology C C] [Algebra R A] [Algebra R C]
  (hA : TopologicalRing.IsWeaklyPreAdmissible A)
  (hC : TopologicalRing.IsWeaklyPreAdmissible C)

/-- The projection of the completed tensor product onto the tensor product of the reductions of
the two factors: the component of the inverse-limit description at the index `(N(A), N(C))`. -/
private noncomputable def reduceProj :
    TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C) →+*
      (A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C) :=
  TopologicalRing.projectionRingHom (B := R) (fun i : NilIndex A => i.1)
    (fun j : NilIndex C => j.1) (hasBasis_nilIndex hA) (hasBasis_nilIndex hC)
    (nilZero hA) (nilZero hC)

include hA hC in
/-- On the algebraic tensor product the projection is the evident reduction map. -/
private theorem reduceProj_coe (x : A ⊗[R] C) :
    reduceProj hA hC
        (x : TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) =
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ R (topologicalNilradical A))
        (Ideal.Quotient.mkₐ R (topologicalNilradical C))).toRingHom x :=
  TopologicalRing.projectionRingHom_coe (B := R) (A := A) (C := C)
    (fun i : NilIndex A => i.1) (fun j : NilIndex C => j.1)
    (hasBasis_nilIndex hA) (hasBasis_nilIndex hC) (nilZero hA) (nilZero hC) x

include hA hC in
/-- The projection onto the tensor product of the reductions is surjective. -/
private theorem reduceProj_surjective :
    Function.Surjective (reduceProj (R := R) (A := A) (C := C) hA hC) :=
  TopologicalRing.projectionRingHom_surjective (B := R) (A := A) (C := C)
    (fun i : NilIndex A => i.1) (fun j : NilIndex C => j.1)
    (hasBasis_nilIndex hA) (hasBasis_nilIndex hC) (nilZero hA) (nilZero hC)

include hA hC in
/-- The kernel of the projection consists of topologically nilpotent elements. -/
private theorem ker_reduceProj_le :
    RingHom.ker (reduceProj (R := R) (A := A) (C := C) hA hC) ≤
      topologicalNilradical
        (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) :=
  TopologicalRing.projectionKernel_le_topologicalNilradical (B := R) (A := A) (C := C)
    (fun i : NilIndex A => i.1) (fun j : NilIndex C => j.1)
    (hasBasis_nilIndex hA) (hasBasis_nilIndex hC) (nilZero hA) (nilZero hC) le_rfl le_rfl

include hA hC in
/-- The projection sends the canonical image of an element of the second factor to its
reduction. -/
private theorem reduceProj_algebraMap (c : C) :
    reduceProj (R := R) hA hC
        (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) c) =
      (Algebra.TensorProduct.includeRight : (C ⧸ topologicalNilradical C) →ₐ[R]
        (A ⧸ topologicalNilradical A) ⊗[R]
          (C ⧸ topologicalNilradical C)).toRingHom (Ideal.Quotient.mk _ c) := by
  change reduceProj (R := R) hA hC
    (((1 : A) ⊗ₜ[R] c : A ⊗[R] C) :
      TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) = _
  rw [reduceProj_coe hA hC]
  simp

include hA hC in
/-- The reduction of the completed tensor product is a quotient of the tensor product of the
reductions of the two factors, compatibly with the projection. -/
private theorem exists_surjective_reduction_lift :
    ∃ L : ((A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C)) →+*
        (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) ⧸
          topologicalNilradical
            (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)),
      Function.Surjective L ∧
        ∀ t : TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C),
          L (reduceProj (R := R) hA hC t) = Ideal.Quotient.mk _ t := by
  classical
  let eP : (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) ⧸
      RingHom.ker (reduceProj (R := R) hA hC) ≃+*
      (A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C) :=
    RingHom.quotientKerEquivOfSurjective (reduceProj_surjective (R := R) hA hC)
  let π : ((TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) ⧸
      RingHom.ker (reduceProj (R := R) hA hC)) →+*
      (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) ⧸
        topologicalNilradical
          (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) :=
    Ideal.Quotient.lift (RingHom.ker (reduceProj (R := R) hA hC)) (Ideal.Quotient.mk _)
      (fun _ ha => Ideal.Quotient.eq_zero_iff_mem.mpr (ker_reduceProj_le (R := R) hA hC ha))
  have hL (t : TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)) :
      π (eP.symm (reduceProj (R := R) hA hC t)) = Ideal.Quotient.mk _ t := by
    have hEP : eP.symm (reduceProj (R := R) hA hC t) =
        Ideal.Quotient.mk (RingHom.ker (reduceProj (R := R) hA hC)) t :=
      eP.symm_apply_eq.mpr rfl
    rw [hEP]
    exact Ideal.Quotient.lift_mk _ _ _
  refine ⟨π.comp eP.symm.toRingHom, ?_, hL⟩
  intro y
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective
    (I := topologicalNilradical
      (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C))) y
  exact ⟨reduceProj (R := R) hA hC t, hL t⟩

end

section

variable {R A C : Type u} [CommRing R] [CommRing A] [CommRing C]
  [TopologicalSpace A] [TopologicalSpace C] [IsLinearTopology A A] [IsLinearTopology C C]
  [Algebra R A] [Algebra R C]

/-- The tensor product of the reductions is of finite type over the reduction of the second
factor as soon as the reduction of the first factor is of finite type over the base. -/
private theorem includeRight_reduction_finiteType
    (hRA : (algebraMap R (A ⧸ topologicalNilradical A)).FiniteType) :
    ((Algebra.TensorProduct.includeRight : (C ⧸ topologicalNilradical C) →ₐ[R]
      (A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C)).toRingHom).FiniteType := by
  let e := Algebra.TensorProduct.comm R (C ⧸ topologicalNilradical C)
    (A ⧸ topologicalNilradical A)
  have hswap : ((Algebra.TensorProduct.includeRight :
      (C ⧸ topologicalNilradical C) →ₐ[R]
        (A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C)).toRingHom) =
      e.toRingEquiv.toRingHom.comp
        (Algebra.TensorProduct.includeLeft :
          (C ⧸ topologicalNilradical C) →ₐ[R]
            (C ⧸ topologicalNilradical C) ⊗[R] (A ⧸ topologicalNilradical A)).toRingHom := by
    ext x
    change ((1 : A ⧸ topologicalNilradical A) ⊗ₜ[R] (Ideal.Quotient.mk _ x)) =
      e ((Ideal.Quotient.mk _ x) ⊗ₜ[R] (1 : A ⧸ topologicalNilradical A))
    simp [e]
  have hbase :
      (algebraMap (C ⧸ topologicalNilradical C)
        ((C ⧸ topologicalNilradical C) ⊗[R] (A ⧸ topologicalNilradical A))).FiniteType := by
    have : Algebra.FiniteType R (A ⧸ topologicalNilradical A) :=
      RingHom.finiteType_algebraMap.mp hRA
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  rw [hswap]
  exact (RingHom.FiniteType.of_surjective e.toRingEquiv.toRingHom
    e.toRingEquiv.surjective).comp hbase

end

section

variable {R A C : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
  [IsLinearTopology R R] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
  [IsLinearTopology C C] [Algebra R A] [Algebra R C]

omit [IsTopologicalRing R] [IsTopologicalRing A] in
/-- The reduction of a continuous homomorphism of finite type on reductions is of finite type
even after reducing only the target: the source may be replaced by the base ring, because the
base ring maps onto its own reduction. -/
private theorem algebraMap_quotient_finiteType
    (hRA : Continuous (algebraMap R A))
    (hQ : Rig.IsFiniteTypeOnReductions (algebraMap R A) hRA) :
    (algebraMap R (A ⧸ topologicalNilradical A)).FiniteType := by
  let qR : R →+* R ⧸ topologicalNilradical R := Ideal.Quotient.mk _
  have hNRmap := topologicalNilradical_le_comap (algebraMap R A) hRA
  have hfactor : (algebraMap R (A ⧸ topologicalNilradical A)) =
      (Ideal.quotientMap (topologicalNilradical A) (algebraMap R A) hNRmap).comp qR := by
    ext r
    simp [qR, Ideal.quotientMap]
  rw [hfactor]
  exact hQ.comp (RingHom.FiniteType.of_surjective qR Ideal.Quotient.mk_surjective)

omit [IsTopologicalRing R] in
/-- **Base change of finite type on reductions.**  If `A` and `C` are linearly topologized
algebras over `R` with weak ideals of definition and `R → A` is of finite type on reductions,
then so is the canonical homomorphism from `C` into the completed tensor product
`A ⊗̂[R] C`. -/
public theorem isFiniteTypeOnReductions_completedTensorProduct_baseChange
    (hA : TopologicalRing.IsWeaklyPreAdmissible A)
    (hC : TopologicalRing.IsWeaklyPreAdmissible C)
    (hRA : Continuous (algebraMap R A))
    (hQ : Rig.IsFiniteTypeOnReductions (algebraMap R A) hRA)
    (hφ : Continuous
      (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)))) :
    Rig.IsFiniteTypeOnReductions
      (algebraMap C (TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)))
      hφ := by
  classical
  let T := TopologicalRing.CompletedTensorProduct (R := R) (M := A) (N := C)
  let cToD : (C ⧸ topologicalNilradical C) →+*
      (A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C) :=
    (Algebra.TensorProduct.includeRight : (C ⧸ topologicalNilradical C) →ₐ[R]
      (A ⧸ topologicalNilradical A) ⊗[R] (C ⧸ topologicalNilradical C)).toRingHom
  have hDfinite : cToD.FiniteType :=
    includeRight_reduction_finiteType (algebraMap_quotient_finiteType hRA hQ)
  let gCT := Ideal.quotientMap (topologicalNilradical T) (algebraMap C T)
    (topologicalNilradical_le_comap (algebraMap C T) hφ)
  obtain ⟨L, hLsurj, hL⟩ := exists_surjective_reduction_lift (R := R) hA hC
  have hCTfactor : L.comp cToD = gCT := by
    ext c
    change L (cToD (Ideal.Quotient.mk _ c)) = gCT (Ideal.Quotient.mk _ c)
    calc
      L (cToD (Ideal.Quotient.mk _ c)) =
          L (reduceProj (R := R) hA hC (algebraMap C T c)) := by
        rw [reduceProj_algebraMap (R := R) hA hC]
      _ = Ideal.Quotient.mk _ (algebraMap C T c) := hL _
      _ = gCT (Ideal.Quotient.mk _ c) := by rw [Ideal.quotientMap_mk]
  change gCT.FiniteType
  rw [← hCTfactor]
  exact (RingHom.FiniteType.of_surjective L hLsurj).comp hDfinite

end

end

section

universe u

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- Finite type on reductions is a local property of countably indexed weakly admissible rings
that is preserved by completed tensor-product base change. -/
@[stacks 0GC3]
public theorem isFiniteTypeOnReductions_stableUnderBaseChange :
    TopologicalRing.IsStableUnderBaseChange TopologicalRing.FiniteTypeOnReductionsProperty where
  isLocal := isFiniteTypeOnReductions_local
  baseChange := by
    intro B A C _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hA hC _ _ hP
    obtain ⟨hBA, hQ⟩ := hP
    intro _ _
    exact ⟨TopologicalRing.continuous_algebraMap_completedTensorProduct_right,
      isFiniteTypeOnReductions_completedTensorProduct_baseChange hA.1.1 hC.1.1 hBA hQ
        TopologicalRing.continuous_algebraMap_completedTensorProduct_right⟩

end

end Rig

end
