module

public import Mathlib.Algebra.BigOperators.Finsupp.Basic
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.Topology.Algebra.Algebra
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Algebra.AdicTopology.AdicRingMap
public import StacksFrontier.Topology.Algebra.AdicTopology.FiniteType

/-!
# Topological finite type is stable under composition

If `g : C →+* B` and `f : B →+* A` are continuous homomorphisms of topological rings that are
topologically of finite type, then so is `f.comp g`.  Concretely, a dense polynomial presentation
of `A` over `B` in `n` variables and one of `B` over `C` in `m` variables combine into a dense
polynomial presentation of `A` over `C` in `m + n` variables: the closure of the `C`-subalgebra
generated by the images of the `m + n` chosen elements contains the image of `B`, hence contains
the image of the `B`-presentation of `A`, hence is everything.

## Main results

* `TopologicalRing.isTopologicallyOfFiniteType_comp`: the composition of two continuous
  homomorphisms topologically of finite type is topologically of finite type.
* `TopologicalRing.isAdic_and_isTopologicallyOfFiniteType_comp`: the same for the conjunction
  of adicness and topological finite type.

## References

* [Stacks Project, Tag 0ANS](https://stacks.math.columbia.edu/tag/0ANS)
* [Stacks Project, Tag 0GBZ](https://stacks.math.columbia.edu/tag/0GBZ)
-/

@[expose] public section

namespace TopologicalRing

section

universe u

/-- The composition of two continuous homomorphisms of topological rings that are topologically
of finite type is again topologically of finite type. -/
public theorem isTopologicallyOfFiniteType_comp
    {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
    [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
    (f : B →+* A) (g : C →+* B) (hf_cont : Continuous f)
    (hf : TopologicalRing.IsTopologicallyOfFiniteType f)
    (hg : TopologicalRing.IsTopologicallyOfFiniteType g) :
    TopologicalRing.IsTopologicallyOfFiniteType (f.comp g) := by
  let : Algebra B A := f.toAlgebra
  let : Algebra C B := g.toAlgebra
  let : Algebra C A := (f.comp g).toAlgebra
  obtain ⟨n, F₀, hFcomp, hF_dense⟩ := hf
  obtain ⟨m, G₀, hGcomp, hG_dense⟩ := hg
  let F : MvPolynomial (Fin n) B →ₐ[B] A :=
    { toRingHom := F₀
      commutes' := fun b => by
        show F₀ (MvPolynomial.C b) = algebraMap B A b
        exact (DFunLike.congr_fun hFcomp b).trans
          (DFunLike.congr_fun (RingHom.algebraMap_toAlgebra f).symm b) }
  let G : MvPolynomial (Fin m) C →ₐ[C] B :=
    { toRingHom := G₀
      commutes' := fun c => by
        show G₀ (MvPolynomial.C c) = algebraMap C B c
        exact (DFunLike.congr_fun hGcomp c).trans
          (DFunLike.congr_fun (RingHom.algebraMap_toAlgebra g).symm c) }
  let vars : Fin m ⊕ Fin n → A :=
    Sum.elim (fun i => f (G (MvPolynomial.X i))) (fun i => F (MvPolynomial.X i))
  let Hsum : MvPolynomial (Fin m ⊕ Fin n) C →ₐ[C] A := MvPolynomial.aeval vars
  let S : Subalgebra C A := Hsum.range.topologicalClosure
  let L : MvPolynomial (Fin m) C →ₐ[C] MvPolynomial (Fin m ⊕ Fin n) C :=
    MvPolynomial.aeval (fun i => MvPolynomial.X (Sum.inl i))
  let Q : MvPolynomial (Fin m) C →ₐ[C] A :=
    { toRingHom := f.comp G.toRingHom
      commutes' := fun c => by
        show f (G (MvPolynomial.C c)) = algebraMap C A c
        calc
          f (G (MvPolynomial.C c)) = f (g c) := by
            congr 1
            show G₀ (MvPolynomial.C c) = g c
            exact DFunLike.congr_fun hGcomp c
          _ = algebraMap C A c :=
            (DFunLike.congr_fun (RingHom.algebraMap_toAlgebra (f.comp g)) c).symm }
  have hleft : Hsum.comp L = Q := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [Hsum, L, Q, vars]
  have hcoeff : ∀ b : B, f b ∈ S := by
    intro b
    have hfb : f b ∈ closure (f '' Set.range G) :=
      mem_closure_image hf_cont.continuousAt (hG_dense b)
    have himage : f '' Set.range G ⊆ (S : Set A) := by
      rintro x ⟨p, ⟨c, rfl⟩, rfl⟩
      have hval : f (G c) = Hsum (L c) := by
        simpa [Q] using (DFunLike.congr_fun hleft c).symm
      rw [hval]
      exact Hsum.range.le_topologicalClosure ⟨L c, rfl⟩
    exact closure_minimal himage Hsum.range.isClosed_topologicalClosure hfb
  have hvar : ∀ i : Fin n, F (MvPolynomial.X i) ∈ S := fun i =>
    Hsum.range.le_topologicalClosure ⟨MvPolynomial.X (Sum.inr i), by simp [Hsum, vars]⟩
  have hF_eq : F = MvPolynomial.aeval (fun i => F (MvPolynomial.X i)) := MvPolynomial.aeval_unique F
  have hF_mem : ∀ p : MvPolynomial (Fin n) B, F p ∈ S := by
    intro p
    induction p using MvPolynomial.induction_on' with
    | monomial d b =>
        rw [hF_eq, MvPolynomial.aeval_monomial]
        exact S.mul_mem (hcoeff b) (SubmonoidClass.finsuppProd_mem S d
          (fun i k => (F (MvPolynomial.X i)) ^ k) (fun i _ => S.pow_mem (hvar i) _))
    | add p q hp hq => simpa using S.add_mem hp hq
  have hS_top : S = ⊤ := by
    apply top_unique
    intro a ha
    exact closure_minimal (by rintro x ⟨p, rfl⟩; exact hF_mem p)
      Hsum.range.isClosed_topologicalClosure (hF_dense a)
  let e : Fin m ⊕ Fin n ≃ Fin (m + n) := finSumFinEquiv
  let H : MvPolynomial (Fin (m + n)) C →ₐ[C] A :=
    Hsum.comp (MvPolynomial.renameEquiv C e.symm).toAlgHom
  have hH_range : Set.range (H : MvPolynomial (Fin (m + n)) C → A) =
      Set.range (Hsum : MvPolynomial (Fin m ⊕ Fin n) C → A) :=
    (MvPolynomial.renameEquiv C e.symm).surjective.range_comp Hsum
  refine ⟨m + n, H.toRingHom, ?_, ?_⟩
  · ext c
    simp [H, RingHom.algebraMap_toAlgebra]
  · show DenseRange (H : MvPolynomial (Fin (m + n)) C → A)
    rw [denseRange_iff_closure_range, hH_range]
    simpa [S, Subalgebra.topologicalClosure_coe] using
      congrArg (fun T : Subalgebra C A => (T : Set A)) hS_top

/-- **Composition of adic morphisms of topological finite type.**  The composition of two
continuous homomorphisms of topological rings that are adic and topologically of finite type is
again adic and topologically of finite type. -/
public theorem isAdic_and_isTopologicallyOfFiniteType_comp
    {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
    [IsTopologicalRing A] [IsTopologicalRing B] [IsTopologicalRing C]
    (f : B →+* A) (g : C →+* B) (hf_cont : Continuous f) (hg_cont : Continuous g)
    (hf : RingHom.IsAdic f ∧ TopologicalRing.IsTopologicallyOfFiniteType f)
    (hg : RingHom.IsAdic g ∧ TopologicalRing.IsTopologicallyOfFiniteType g) :
    RingHom.IsAdic (f.comp g) ∧
      TopologicalRing.IsTopologicallyOfFiniteType (f.comp g) :=
  ⟨RingHom.isAdic_comp g f hg_cont hf_cont hg.1 hf.1,
    isTopologicallyOfFiniteType_comp f g hf_cont hf.2 hg.2⟩

end

end TopologicalRing

end
