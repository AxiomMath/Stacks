module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.TopologicalSheaf
public import StacksFrontier.CategoryTheory.Sites.Point.ElementColimitSkyscraper

/-!
# Stalks of sheaves of topological spaces at a point of a site

Let `p` be a point of a site `C` given by a functor `u : C ⥤ Sets` (Stacks 00Y5). This file
records the last part of Stacks 0AI4: for a topological space `M` the presheaf
`U ↦ Map(u(U), M)` with the product topology is a sheaf of topological spaces, and taking the
stalk at `p` commutes with the sheafification of presheaves of topological spaces of
`CategoryTheory.TopologicalSheaf.hasWeakSheafify_topCat`.

Both are stated for a functor `u` satisfying conditions (1) and (2) of Stacks 00Y5, on a small
site whose topology is generated by a precoverage with fibre products, stable under base
change; condition (3) of 00Y5 and cofilteredness of the category of neighbourhoods are not
assumed.

## References

* [Stacks Project, Tag 0AI4](https://stacks.math.columbia.edu/tag/0AI4)
-/

@[expose] public section

namespace CategoryTheory.TopologicalSheaf

section

open CategoryTheory Opposite Limits

universe w

variable {C : Type w} [SmallCategory C] {K : Precoverage C} [K.HasPullbacks]
  [K.IsStableUnderBaseChange] {u : C ⥤ Type w}

variable (u) in
/-- The presheaf of topological spaces `U ↦ Map(u(U), M) = ∏_{x ∈ u(U)} M`, with the product
topology, attached to a functor `u : C ⥤ Type w` and a topological space `M`. -/
abbrev mappingPresheaf (M : TopCat.{w}) : Cᵒᵖ ⥤ TopCat.{w} where
  obj U := TopCat.of (u.obj U.unop → M)
  map f := TopCat.ofHom ⟨fun g => g ∘ u.map f.unop,
    continuous_pi fun _ => continuous_apply _⟩
  map_id _ := by
    ext g y
    simp
  map_comp _ _ := by
    ext g y
    simp

variable (u) in
/-- `Map(u(U), M)` with the product topology is the categorical product `∏_{x ∈ u(U)} M` in
`TopCat`, naturally in `U`. -/
noncomputable def mappingPresheafIso (M : TopCat.{w}) :
    mappingPresheaf u M ≅ ElementColimit.skyscraperPresheaf u M :=
  NatIso.ofComponents (fun U => (TopCat.piIsoPi.{w, w} fun _ : u.obj U.unop => M).symm)
    fun {U V} f => by
      refine Pi.hom_ext _ _ fun y => ?_
      simp only [Iso.symm_hom]
      rw [Category.assoc, TopCat.piIsoPi_inv_π, Category.assoc, Pi.lift_comp_π,
        TopCat.piIsoPi_inv_π]
      rfl

/-- **Stacks 0AI4** (the sheaf `U ↦ Map(u(U), M)`). Let `p` be a point of the site `C` given by
a functor `u : C ⥤ Sets` (Stacks 00Y5). For a topological space `M`, the presheaf
`U ↦ Map(u(U), M) = ∏_{x ∈ u(U)} M`, with the product topology, is a sheaf of topological
spaces.

The site is the small category `C` with the topology generated by a precoverage `K` that has
the fibre products of its coverings and is stable under base change, and `h₁`, `h₂` are
conditions (1) and (2) of Stacks 00Y5 for `u`; condition (3) is not needed. The general form,
for any category with products, is `CategoryTheory.ElementColimit.isSheaf_skyscraperPresheaf`. -/
@[stacks 0AI4 "point_mapping_sheaf"]
theorem isSheaf_mappingPresheaf
    (h₁ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x)
    (h₂ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ ⦃Y Z : C⦄ (f : Y ⟶ X), R f →
      ∀ (g : Z ⟶ X) [HasPullback f g], Function.Bijective (pullbackComparison u f g))
    (M : TopCat.{w}) :
    Presheaf.IsSheaf K.toGrothendieck (mappingPresheaf u M) :=
  (Presheaf.isSheaf_of_iso_iff (mappingPresheafIso u M)).2
    (ElementColimit.isSheaf_skyscraperPresheaf h₁ h₂ M)

/-- **Stacks 0AI4** (sheafification commutes with taking stalks at a point). Let `p` be a point
of the site `C` given by a functor `u : C ⥤ Sets` (Stacks 00Y5), and let `F` be a presheaf of
topological spaces on `C`. Then the canonical map `F_p ⟶ (F^#)_p` is an isomorphism of
topological spaces, where `F_p = colim_{(U, x) ∈ Nbh(p)ᵒᵖ} F(U)` is the colimit in `TopCat`
(`CategoryTheory.elementColimit`) and `F^#` is the sheafification of `hasWeakSheafify_topCat`.

The site is the small category `C` with the topology generated by a precoverage `K` that has
the fibre products of its coverings and is stable under base change, and `h₁`, `h₂` are
conditions (1) and (2) of Stacks 00Y5 for `u`; condition (3) is not needed. No cofilteredness
of the category of neighbourhoods is assumed, so this does not go through Mathlib's
`GrothendieckTopology.Point`. The general form, for any category with products, colimits and
sheafification, is `CategoryTheory.ElementColimit.isIso_elementColimit_map_toSheafify`. -/
@[stacks 0AI4 "stalk_preservation"]
theorem isIso_elementColimit_map_toSheafify_topCat
    (h₁ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x)
    (h₂ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ ⦃Y Z : C⦄ (f : Y ⟶ X), R f →
      ∀ (g : Z ⟶ X) [HasPullback f g], Function.Bijective (pullbackComparison u f g))
    (F : Cᵒᵖ ⥤ TopCat.{w}) :
    IsIso ((elementColimit u TopCat.{w}).map (toSheafify K.toGrothendieck F)) :=
  ElementColimit.isIso_elementColimit_map_toSheafify h₁ h₂ F

end

end CategoryTheory.TopologicalSheaf

end
