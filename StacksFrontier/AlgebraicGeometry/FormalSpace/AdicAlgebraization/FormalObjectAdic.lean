/-!
# The morphism `x̂` of the proof of Stacks 0GI8 is adic

Let `x̂ : (Spec R)_{/V(I)} ⟶ W` be the morphism attached to a formal object of a locally
Noetherian formal algebraic space `W` (`AlgebraicGeometry.FormalSpace.formalObjectCompletion`).
Its base change along the inclusion of the `k`-th infinitesimal neighbourhood `W_k ⊆ W` of
`W_red` is `Spec(R/Iᵏ⁺¹)`: over an affine `U`, a point `φ : U ⟶ Spec R` of the completion maps
into `W_k` exactly when the `(k+1)`st power of the ideal of `U ×_W W_red`, generated by the image
of `I`, vanishes, i.e. when `φ` kills `Iᵏ⁺¹`. This file proves that the square

```
Spec(R/Iᵏ⁺¹) ⟶ W_k
     ↓           ↓
 (Spec R)_{/V(I)} ⟶ W
```

is cartesian.

## Main results

* `AlgebraicGeometry.FormalSpace.isPullback_formalObjectCompletion`: the square above.

## References

* [Stacks Project, Tag 0GI8](https://stacks.math.columbia.edu/tag/0GI8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite IsLocalRing

universe u

namespace AlgebraicGeometry.FormalSpace

open Deformation.Artin

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {W Wred : FppfSheaf B S hS} {i : Wred ⟶ W} (hW : IsLocallyNoetherian B S hS W)
  (hred : IsReduction B S hS W Wred i) (A : FormalBase S) (hA : ∀ n, B.Contains (A.truncation n))
  (w : ∀ n, W.obj.obj (op (truncationOver B S hS A hA n)))
  (hw : ∀ n, W.obj.map (truncationOverSucc B S hS A hA n).op (w (n + 1)) = w n)

/-- `Spec(R/Iᵏ⁺¹)`, as an object of the site. -/
abbrev formalObjectNeighbourhood (k : ℕ) : BigFppfOver B S hS :=
  idealNeighbourhood (hS := hS) (hA := A.contains_spec_of_contains_truncation hA) (f := A.toS)
    (formalObjectIdeal hred A hA w) k

/-- `Spec(R/Iᵏ⁺¹)`, as an fppf sheaf. -/
abbrev formalObjectNeighbourhoodSheaf (k : ℕ) : FppfSheaf B S hS :=
  ⟨uliftYoneda.{u + 1}.obj (formalObjectNeighbourhood hred A hA w k),
    (Space.isAlgebraicSpaceULift_uliftYoneda.{u + 1} B S hS _).isSheaf⟩

/-- The closed immersion `Spec(R/Iᵏ⁺¹) ⟶ Spec R` has image in the zero locus `V(I)`. -/
theorem hasImageIn_formalObjectNeighbourhood (k : ℕ) :
    Space.HasImageIn B S hS _ (formalObjectZeroLocus hred A hA w)
      (formalObjectNeighbourhood hred A hA w k) (idealNeighbourhoodι _ k) := by
  have := A.noetherian
  refine Artin.ContractionSituation.hasImageIn_zeroLocusPoints_of_pow _ _ k fun a ha => ?_
  rw [← RingHom.mem_ker, Artin.ContractionSituation.ker_chartRing_quotientToAffineOver]
  exact ha

/-- The inclusion `Spec(R/Iᵏ⁺¹) ⟶ (Spec R)_{/V(I)}`. -/
def formalObjectNeighbourhoodIncl (k : ℕ) :
    formalObjectNeighbourhoodSheaf hred A hA w k ⟶
      Space.completionSheaf B S hS _ (formalObjectZeroLocus hred A hA w) :=
  ⟨uliftYonedaEquiv.symm (((BigFppfOver.topology B S hS).toSheafify
    (Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)).toFunctor).app _
      ⟨ULift.up (idealNeighbourhoodι _ k), hasImageIn_formalObjectNeighbourhood hred A hA w k⟩)⟩

/-- `ξ'_k : Spec(R/Iᵏ⁺¹) ⟶ W_k`. -/
def formalObjectNeighbourhoodMap (k : ℕ) :
    formalObjectNeighbourhoodSheaf hred A hA w k ⟶ reductionNeighbourhoodSheaf i k :=
  ⟨uliftYonedaEquiv.symm (formalObjectAlgebraization hW hred A hA w hw k)⟩

/-- The value of `formalObjectNeighbourhoodIncl` on a point `l : T ⟶ Spec(R/Iᵏ⁺¹)` is the image
in the sheafified completion of the composite `T ⟶ Spec(R/Iᵏ⁺¹) ⟶ Spec R`. -/
theorem formalObjectNeighbourhoodIncl_app {k : ℕ} {T : BigFppfOver B S hS}
    (l : T ⟶ formalObjectNeighbourhood hred A hA w k) :
    (formalObjectNeighbourhoodIncl hred A hA w k).hom.app (op T) (ULift.up l) =
      ((BigFppfOver.topology B S hS).toSheafify
        (Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)).toFunctor).app _
        ⟨ULift.up (l ≫ idealNeighbourhoodι _ k),
          (Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)).map l.op
            (hasImageIn_formalObjectNeighbourhood hred A hA w k)⟩ := by
  change (Space.completionSheaf B S hS _ _).obj.map l.op _ = _
  exact (NatTrans.naturality_apply ((BigFppfOver.topology B S hS).toSheafify
    (Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)).toFunctor) l.op
    (⟨ULift.up (idealNeighbourhoodι _ k), hasImageIn_formalObjectNeighbourhood hred A hA w k⟩ :
      (Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)).toFunctor.obj
        (op (formalObjectNeighbourhood hred A hA w k)))).symm

/-- The square formed by `ξ'_k : Spec(R/Iᵏ⁺¹) ⟶ W_k`, the inclusion `W_k ⟶ W`, the inclusion
`Spec(R/Iᵏ⁺¹) ⟶ (Spec R)_{/V(I)}` and `x̂` commutes. -/
theorem formalObjectNeighbourhoodMap_comp :
    ∀ k, formalObjectNeighbourhoodMap hW hred A hA w hw k ≫ reductionNeighbourhoodι i k =
      formalObjectNeighbourhoodIncl hred A hA w k ≫ formalObjectCompletion hW hred A hA w hw := by
  intro k
  have := A.noetherian
  apply (sheafToPresheaf _ _).map_injective
  change uliftYonedaEquiv.symm _ ≫ (reductionNeighbourhoodι i k).hom =
    uliftYonedaEquiv.symm _ ≫ (formalObjectCompletion hW hred A hA w hw).hom
  rw [uliftYonedaEquiv_symm_comp]
  refine Eq.trans ?_ (uliftYonedaEquiv_symm_comp _ _).symm
  congr 1
  refine Eq.trans ?_ (zeroLocusCompletionLift_apply
    (fun k => (formalObjectAlgebraization hW hred A hA w hw k).1)
    (fun _ _ h => formalObjectAlgebraization_compatible hW hred A hA w hw h)
    (idealNeighbourhoodι _ k) (hasImageIn_formalObjectNeighbourhood hred A hA w k) (𝟙 _)
    (Category.id_comp _)).symm
  rw [op_id, Functor.map_id_apply]
  rfl

/-- The inclusion `Spec(R/Iᵏ⁺¹) ⟶ (Spec R)_{/V(I)}` is a monomorphism of presheaves. -/
theorem mono_formalObjectNeighbourhoodIncl (k : ℕ) :
    Mono (formalObjectNeighbourhoodIncl hred A hA w k).hom := by
  have := A.noetherian
  have := Space.mono_quotientToAffineOver B S hS A.toS (A.contains_spec_of_contains_truncation hA)
    (formalObjectIdeal hred A hA w ^ (k + 1))
  let J := BigFppfOver.topology B S hS
  let P := Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)
  let Q := yoneda.obj (affineOver B S hS (A.contains_spec_of_contains_truncation hA) A.toS) ⋙
    uliftFunctor.{u + 1}
  have hQ : Presheaf.IsSheaf J Q :=
    (Space.isAlgebraicSpaceULift_uliftYoneda.{u + 1} B S hS _).isSheaf
  have := GrothendieckTopology.isIso_toSheafify J hQ
  refine (NatTrans.mono_iff_mono_app _).2 fun T => (mono_iff_injective _).2 fun a b hab => ?_
  obtain ⟨a⟩ := a
  obtain ⟨b⟩ := b
  rw [formalObjectNeighbourhoodIncl_app, formalObjectNeighbourhoodIncl_app] at hab
  have h1 := congrArg ((J.sheafifyMap P.ι).app T) hab
  have nat := J.toSheafify_naturality P.ι
  have key (c : T.unop ⟶ formalObjectNeighbourhood hred A hA w k) :=
    congrArg (fun φ => φ.app T ⟨ULift.up (c ≫ idealNeighbourhoodι _ k),
      (P.map c.op (hasImageIn_formalObjectNeighbourhood hred A hA w k))⟩) nat
  have h2 : (J.toSheafify Q).app T (ULift.up (a ≫ idealNeighbourhoodι _ k)) =
      (J.toSheafify Q).app T (ULift.up (b ≫ idealNeighbourhoodι _ k)) :=
    (key a).trans (h1.trans (key b).symm)
  have hiso : IsIso ((J.toSheafify Q).app T) := NatIso.isIso_app_of_isIso _ T
  have h3 := ((isIso_iff_bijective _).1 hiso).1 h2
  have h4 : a ≫ idealNeighbourhoodι _ k = b ≫ idealNeighbourhoodι _ k :=
    congrArg ULift.down h3
  exact congrArg ULift.up ((cancel_mono _).1 h4)

/-- **The base change of `x̂` along `W_k ⟶ W` is `Spec(R/Iᵏ⁺¹)`.** -/
theorem isPullback_formalObjectCompletion (k : ℕ) :
    IsPullback (formalObjectNeighbourhoodMap hW hred A hA w hw k)
      (formalObjectNeighbourhoodIncl hred A hA w k) (reductionNeighbourhoodι i k)
      (formalObjectCompletion hW hred A hA w hw) := by
  classical
  have := A.noetherian
  let Jt := BigFppfOver.topology B S hS
  let P := Space.completionSubfunctor B S hS _ (formalObjectZeroLocus hred A hA w)
  let fst := formalObjectNeighbourhoodMap hW hred A hA w hw k
  let snd := formalObjectNeighbourhoodIncl hred A hA w k
  let xh := formalObjectCompletion hW hred A hA w hw
  have hcomm := formalObjectNeighbourhoodMap_comp hW hred A hA w hw k
  refine isPullback_of_mono_of_local_lift B S hS _ _ _ _ hcomm
    (mono_formalObjectNeighbourhoodIncl hred A hA w k) fun T x y hxy => ?_
  let P' : Sieve T :=
    { arrows := fun T' h => ∃ z : (formalObjectNeighbourhoodSheaf hred A hA w k).obj.obj (op T'),
        fst.hom.app (op T') z = (reductionNeighbourhoodSheaf i k).obj.map h.op x ∧
          snd.hom.app (op T') z = (Space.completionSheaf B S hS _ _).obj.map h.op y
      downward_closed := by
        rintro T' T'' h ⟨z, hz₁, hz₂⟩ g
        refine ⟨(formalObjectNeighbourhoodSheaf hred A hA w k).obj.map g.op z, ?_, ?_⟩
        · rw [NatTrans.naturality_apply, hz₁, op_comp, Functor.map_comp_apply]
        · rw [NatTrans.naturality_apply, hz₂, op_comp, Functor.map_comp_apply] }
  refine ⟨P', mem_topology_of_affine (Presheaf.imageSieve_mem Jt (Jt.toSheafify P.toFunctor) y)
    (fun V g hV hg => ?_), fun T' h hh => hh⟩
  have := hV
  obtain ⟨⟨⟨φ⟩, hφ⟩, hs⟩ := hg
  have hnat := (NatTrans.naturality_apply (reductionNeighbourhoodι i k).hom g.op x).trans
    ((congrArg (W.obj.map g.op) hxy).trans (NatTrans.naturality_apply xh.hom g.op y).symm)
  have hxg : ((reductionNeighbourhoodSheaf i k).obj.map g.op x).1 =
      xh.hom.app (op V) ((Jt.toSheafify P.toFunctor).app (op V) ⟨ULift.up φ, hφ⟩) := by
    rw [hs]
    exact hnat
  have hK := isReductionIdeal_formalObjectCompletion hW hred A hA w hw φ hφ
  rw [← hxg] at hK
  have hmem := (mem_reductionNeighbourhood_iff k hK).1
    ((reductionNeighbourhoodSheaf i k).obj.map g.op x).2
  have hle : formalObjectIdeal hred A hA w ^ (k + 1) ≤ RingHom.ker (chartRing φ) := by
    rw [← Ideal.map_eq_bot_iff_le_ker, Ideal.map_pow]
    exact hmem
  obtain ⟨l, hl⟩ := exists_factor_idealNeighbourhoodι φ hle
  have hsnd : snd.hom.app (op V) (ULift.up l) =
      (Space.completionSheaf B S hS _ _).obj.map g.op y := by
    refine (formalObjectNeighbourhoodIncl_app hred A hA w l).trans (Eq.trans ?_ hs)
    subst hl
    rfl
  refine ⟨ULift.up l, Subtype.ext ?_, hsnd⟩
  have e := congrArg (fun φ => φ.hom.app (op V) (ULift.up l)) hcomm
  change (reductionNeighbourhoodι i k).hom.app _ (fst.hom.app _ (ULift.up l)) =
    xh.hom.app _ (snd.hom.app _ (ULift.up l)) at e
  change (reductionNeighbourhoodι i k).hom.app _ (fst.hom.app _ (ULift.up l)) =
    (reductionNeighbourhoodι i k).hom.app _ ((reductionNeighbourhoodSheaf i k).obj.map g.op x)
  rw [e, hsnd, hnat]

/-- **Over an affine scheme point of `W`, the base change of `x̂` is a scheme**: the point factors
through some `W_k`, and over `W_k` the base change is that of `Spec(R/Iᵏ⁺¹) ⟶ W_k`, a morphism
from a scheme to an algebraic space. -/
theorem isAlgebraicSpaceULift_pullback_formalObjectCompletion_of_isAffine
    {U : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj U)]
    (ξ : uliftYoneda.{u + 1}.obj U ⟶ W.obj) :
    Space.IsAlgebraicSpaceULift.{u + 1} B S hS
      (pullback ξ (formalObjectCompletion hW hred A hA w hw).hom) := by
  classical
  let : HasColimitsOfSize.{u + 1, u + 1} (FppfSheaf B S hS) := Sheaf.instHasColimitsOfSize
  let Jt := BigFppfOver.topology B S hS
  let F : ULift.{u + 1} ℕ ⥤ ℕ := Monotone.functor (f := ULift.down) fun _ _ h => h
  let G : ℕ ⥤ ULift.{u + 1} ℕ := Monotone.functor (f := ULift.up) fun _ _ h => h
  let eq : ULift.{u + 1} ℕ ≌ ℕ :=
    { functor := F, inverse := G
      unitIso := NatIso.ofComponents (fun _ => Iso.refl _)
      counitIso := NatIso.ofComponents (fun _ => Iso.refl _) }
  have : F.IsEquivalence := eq.isEquivalence_functor
  have : F.Final := inferInstance
  let E := F ⋙ reductionNeighbourhoodDiagram i
  have hc : IsColimit ((reductionNeighbourhoodCocone i).whisker F) :=
    (Functor.Final.isColimitWhiskerEquiv F _).symm (isColimit_reductionNeighbourhoodCocone hW hred)
  let e : W ≅ colimit E := hc.coconePointUniqueUpToIso (colimit.isColimit E)
  have hmono : ∀ ⦃a b : ULift.{u + 1} ℕ⦄ (g : a ⟶ b), Mono (E.map g) := fun a b g =>
    (sheafToPresheaf _ _).mono_of_mono_map
      (inferInstanceAs (Mono (Subfunctor.homOfLe
        (reductionNeighbourhood_mono i (leOfHom (F.map g))))))
  let ξS : Jt.uliftYoneda.{u + 1}.obj U ⟶ W := ⟨ξ⟩
  obtain ⟨⟨k⟩, ξ', hξ'⟩ := exists_factor_through_stage_of_compact B S hS E hmono U (ξS ≫ e.hom)
  have hξ : ξS = ξ' ≫ reductionNeighbourhoodι i k := by
    have h1 : colimit.ι E ⟨k⟩ ≫ e.inv = reductionNeighbourhoodι i k :=
      hc.comp_coconePointUniqueUpToIso_inv (colimit.isColimit E) ⟨k⟩
    rw [← h1, ← Category.assoc, ← hξ', Category.assoc, Iso.hom_inv_id, Category.comp_id]
  -- the base change of `Spec(R/Iᵏ⁺¹) ⟶ W_k` along `ξ'` is represented
  have hWk := isAlgebraicSpaceULift_reductionNeighbourhood hW hred k
  obtain ⟨a, snd', fst', hrep⟩ := Functor.relativelyRepresentable.of_diag hWk.diagonal_representable
    (formalObjectNeighbourhoodMap hW hred A hA w hw k).hom ξ'.hom
  have hA' := (isPullback_formalObjectCompletion hW hred A hA w hw k).map
    (sheafToPresheaf Jt (Type (u + 1)))
  have hsq := hrep.flip.paste_vert hA'
  have hξh : ξ = ξ'.hom ≫ (reductionNeighbourhoodι i k).hom :=
    congrArg (fun φ : Jt.uliftYoneda.{u + 1}.obj U ⟶ W => φ.hom) hξ
  rw [hξh]
  exact Space.isAlgebraicSpaceULift_of_iso B S hS hsq.isoPullback
    (Space.isAlgebraicSpaceULift_uliftYoneda.{u + 1} B S hS a)

/-- The completion `(Spec R)_{/V(I)}` is an affine formal algebraic space. -/
theorem isAffineFormalAlgebraicSpace_formalObjectCompletionSource :
    IsAffineFormalAlgebraicSpace B S hS
      (Space.completionSheaf B S hS _ (formalObjectZeroLocus hred A hA w)) := by
  have := A.noetherian
  obtain ⟨e⟩ := nonempty_completionAlongIdealIsoCompletionSheaf B S hS
    (A.contains_spec_of_contains_truncation hA) A.toS (formalObjectIdeal hred A hA w)
    (formalObjectIdeal hred A hA w).fg_of_isNoetherianRing
  exact isAffineFormalAlgebraicSpace_of_iso B S hS e
    (isAffineFormalAlgebraicSpace_completionAlongIdeal B S hS A.toS _ _)

attribute [local instance] sheaf_hasColimits in
/-- **`x̂ : (Spec R)_{/V(I)} ⟶ W` is adic**, i.e. representable by algebraic spaces. Over an
arbitrary scheme point `T ⟶ W` the base change is covered by its base changes along an affine
étale covering of `T`, which are algebraic spaces by the affine case. -/
theorem isRepresentableByAlgebraicSpacesULift_formalObjectCompletion :
    Space.IsRepresentableByAlgebraicSpacesULift.{u + 1} B S hS
      (formalObjectCompletion hW hred A hA w hw).hom := by
  classical
  intro T ξ
  let Jt := BigFppfOver.topology B S hS
  let xh := formalObjectCompletion hW hred A hA w hw
  let ξS : Jt.uliftYoneda.{u + 1}.obj T ⟶ W := ⟨ξ⟩
  let f' := pullback.fst ξS xh
  have hC := isAffineFormalAlgebraicSpace_formalObjectCompletionSource hred A hA w
  have hY := isFormalAlgebraicSpace_uliftYoneda B S hS T
  have hX : SatisfiesSetTheoreticCondition B S hS (pullback ξS xh) :=
    satisfiesSetTheoreticCondition_pullback' B S hS ξS xh
      (hasRepresentableRelativeProducts_of_isFormalAlgebraicSpace B S hS hW.1)
      (satisfiesSetTheoreticCondition_uliftYoneda B S hS T)
      (hasRepresentableRelativeProducts_of_isFormalAlgebraicSpace B S hS hY)
      hC.1 (hasRepresentableRelativeProducts_of_isAffineFormalAlgebraicSpace B S hS hC)
  obtain ⟨K, V, a, -, ha, hsurj⟩ := exists_isAffineEtaleCover_of_isAlgebraicSpaceULift B S hS
    (Jt.uliftYoneda.{u + 1}.obj T) (Space.isAlgebraicSpaceULift_uliftYoneda.{u + 1} B S hS T)
  have hUk (k : K) : Space.IsAlgebraicSpaceULift.{u + 1} B S hS (pullback (a k) f').obj := by
    have : IsAffine ((BigFppfOver.toScheme B S hS).obj
        ((BigAffineFppf.inclusion B S hS).obj (V k))) := (V k).2
    have h1 := isAlgebraicSpaceULift_pullback_formalObjectCompletion_of_isAffine hW hred A hA w hw
      ((a k ≫ ξS).hom)
    have hsq := (((IsPullback.of_hasPullback (a k) f').flip.paste_horiz
      (IsPullback.of_hasPullback ξS xh).flip).flip).map (sheafToPresheaf Jt (Type (u + 1)))
    exact Space.isAlgebraicSpaceULift_of_iso B S hS hsq.isoPullback.symm h1
  have hf' := isRepresentableByAlgebraicSpacesULift_of_etaleCover_comp B S hS f' hX hY
    (fun k => pullback (a k) f') (fun k => pullback.snd (a k) f')
    (fun k => isRepresentableEtale_pullback_snd B S hS (a k) f' (ha k))
    (Sheaf.isLocallySurjective_sigmaDesc_pullback_snd f' a hsurj)
    (fun k => isRepresentableByAlgebraicSpacesULift_of_isAlgebraicSpaceULift_of_isFormal B S hS
      _ (hUk k) hY)
  have h0 := hf' T (𝟙 _)
  have hpb : IsPullback (pullback.fst ξS xh).hom (pullback.snd ξS xh).hom ξ xh.hom :=
    (IsPullback.of_hasPullback ξS xh).map (sheafToPresheaf Jt (Type (u + 1)))
  exact Space.isAlgebraicSpaceULift_of_iso B S hS
    (asIso (pullback.snd (𝟙 _) f'.hom) ≪≫ hpb.isoPullback) h0

end AlgebraicGeometry.FormalSpace

end
