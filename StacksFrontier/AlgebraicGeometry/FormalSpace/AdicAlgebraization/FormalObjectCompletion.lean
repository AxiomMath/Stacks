module

public import
  StacksFrontier.AlgebraicGeometry.FormalSpace.AdicAlgebraization.FormalObjectAlgebraization
public import StacksFrontier.AlgebraicGeometry.FormalSpace.AffineCompletionTypes

/-!
# The morphism `x̂ : (Spec R)_{/V(I)} ⟶ W` of a formal object

Let `W` be a locally Noetherian formal algebraic space with reduction `i : W_red ⟶ W`, `(R, w_n)`
a formal object of `W` and `I ⊆ R` the ideal of `Spf R ×_W W_red`. The compatible morphisms
`ξ'_k : Spec(R/Iᵏ⁺¹) ⟶ W` (`AlgebraicGeometry.FormalSpace.formalObjectAlgebraization`) define
`x̂ = (ξ'_k) : V_{/Z} ⟶ W` for `V = Spec R` and `Z = V(I)`. This file shows that `Z` is closed and
contains the closed point, that `x̂` restricts to `w_n` on `Spec(R/𝔪ⁿ⁺¹)`, and that over an affine
`U ⟶ V_{/Z}` the ideal of `U ×_W W_red` is generated by the image of `I`.

## Main definitions

* `AlgebraicGeometry.FormalSpace.formalObjectCompletion`: the morphism `x̂`.

## Main results

* `AlgebraicGeometry.FormalSpace.formalObjectCompletion_thickeningSection`: `x̂` restricts to
  `w_n`.
* `AlgebraicGeometry.FormalSpace.isReductionIdeal_formalObjectCompletion`: the ideal of
  `U ×_W W_red` along an affine point of `V_{/Z}`.

## References

* [Stacks Project, Tag 0GI8](https://stacks.math.columbia.edu/tag/0GI8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite IsLocalRing

universe u

namespace AlgebraicGeometry.FormalSpace

open Deformation.Artin

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {W Wred : FppfSheaf B S hS} {i : Wred ⟶ W} (hW : IsLocallyNoetherian B S hS W)
  (hred : IsReduction B S hS W Wred i) (A : FormalBase S) (hA : ∀ n, B.Contains (A.truncation n))
  (w : ∀ n, W.obj.obj (op (truncationOver B S hS A hA n)))
  (hw : ∀ n, W.obj.map (truncationOverSucc B S hS A hA n).op (w (n + 1)) = w n)

/-- The closed subset `Z = V(I)` of `|Spec R|`. -/
abbrev formalObjectZeroLocus :
    Set (Space.points B S hS (yoneda.obj (affineOver B S hS
      (A.contains_spec_of_contains_truncation hA) A.toS))) :=
  zeroLocusPoints B S hS (A.contains_spec_of_contains_truncation hA) A.toS
    (formalObjectIdeal hred A hA w)

/-- The subset `Z = V(I)` of `|Spec R|` is closed. -/
theorem isClosed_formalObjectZeroLocus :
    @IsClosed _ (Space.pointTopology B S hS _) (formalObjectZeroLocus hred A hA w) := by
  rw [Space.isClosed_pointTopology_yoneda_iff_isClosed_image, formalObjectZeroLocus,
    zeroLocusPoints_eq_preimage_pointsToScheme]
  have e := Set.image_preimage_eq
    (PrimeSpectrum.zeroLocus (formalObjectIdeal hred A hA w : Set A.R) :
      Set ((BigFppfOver.toScheme B S hS).obj
        (affineOver B S hS (A.contains_spec_of_contains_truncation hA) A.toS)))
    (Space.surjective_pointsToScheme B S hS
      (affineOver B S hS (A.contains_spec_of_contains_truncation hA) A.toS))
  exact (congrArg IsClosed e).mpr (PrimeSpectrum.isClosed_zeroLocus _)

/-- The point `Spec(R/𝔪ⁿ⁺¹) ⟶ Spec R` has image in `Z = V(I)`. -/
theorem hasImageIn_formalObjectZeroLocus (n : ℕ) :
    Space.HasImageIn B S hS _ (formalObjectZeroLocus hred A hA w) (truncationOver B S hS A hA n)
      (truncationToChart hS A hA n) := by
  have := A.noetherian
  refine Artin.ContractionSituation.hasImageIn_zeroLocusPoints_of_pow _ _ n fun a ha => ?_
  rw [← RingHom.mem_ker, ker_chartRing_truncationToChart]
  exact Ideal.pow_right_mono (formalObjectIdeal_le_maximalIdeal hred A hA w) (n + 1) ha

/-- The morphism `x̂ = (ξ'_k) : (Spec R)_{/V(I)} ⟶ W` given by the compatible morphisms
`ξ'_k : Spec(R/Iᵏ⁺¹) ⟶ W`. -/
def formalObjectCompletion :
    Space.completionSheaf B S hS _ (formalObjectZeroLocus hred A hA w) ⟶ W :=
  haveI := A.noetherian
  zeroLocusCompletionLift (fun k => (formalObjectAlgebraization hW hred A hA w hw k).1)
    fun _ _ h => formalObjectAlgebraization_compatible hW hred A hA w hw h

section Section

variable (hS) {L : Ideal A.R} {n : ℕ} (hLm : L ≤ maximalIdeal A.R ^ (n + 1))

/-- The ring map `(R/L)/𝔪ⁿ⁺¹ ⟶ R/𝔪ⁿ⁺¹` for `L ⊆ 𝔪ⁿ⁺¹`, inverse to
`AlgebraicGeometry.FormalSpace.quotientTruncationRingHom`. -/
abbrev truncationSectionRingHom :
    (A.R ⧸ L) ⧸ quotientBaseStage A L n →+* A.R ⧸ maximalIdeal A.R ^ (n + 1) :=
  Ideal.Quotient.lift _ (Ideal.Quotient.factor hLm) fun _ ha =>
    (by rw [quotientBaseStage, Ideal.map_le_iff_le_comap, RingHom.comap_ker,
        Ideal.Quotient.factor_comp_mk, Ideal.mk_ker] :
      quotientBaseStage A L n ≤ RingHom.ker (Ideal.Quotient.factor hLm)) ha

/-- The isomorphism `Spec(R/𝔪ⁿ⁺¹) ⟶ Spec((R/L)/𝔪ⁿ⁺¹)` for `L ⊆ 𝔪ⁿ⁺¹`. -/
def truncationSection : truncationOver B S hS A hA n ⟶ quotientTruncation hS A hA L n :=
  Over.homMk (ObjectProperty.homMk (Spec.map (CommRingCat.ofHom (truncationSectionRingHom A hLm))))
    (by
      apply ObjectProperty.hom_ext
      change Spec.map (CommRingCat.ofHom (truncationSectionRingHom A hLm)) ≫
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (quotientBaseStage A L n))) ≫
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk L)) ≫ A.toS)) =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (maximalIdeal A.R ^ (n + 1)))) ≫ A.toS
      rw [← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp]
      congr 2)

/-- `truncationSection` is a section of `quotientTruncationToTruncation`: the composite
`Spec(R/𝔪ⁿ⁺¹) ⟶ Spec((R/L)/𝔪ⁿ⁺¹) ⟶ Spec(R/𝔪ⁿ⁺¹)` is the identity. -/
theorem truncationSection_comp_toTruncation :
    truncationSection hS A hA hLm ≫ quotientTruncationToTruncation hS A hA L n = 𝟙 _ := by
  apply (BigFppfOver.toScheme B S hS).map_injective
  rw [Functor.map_comp, CategoryTheory.Functor.map_id]
  change Spec.map _ ≫ Spec.map _ = 𝟙 (Spec _)
  rw [← Spec.map_comp, ← Spec.map_id]
  congr 1
  ext
  rfl

end Section

include hw in
/-- **`x̂` restricts to `w_n` on `Spec(R/𝔪ⁿ⁺¹)`.** -/
theorem formalObjectCompletion_thickeningSection (n : ℕ) :
    (formalObjectCompletion hW hred A hA w hw).hom.app (op (truncationOver B S hS A hA n))
      (((BigFppfOver.topology B S hS).toSheafify (Space.completionSubfunctor B S hS _
        (formalObjectZeroLocus hred A hA w)).toFunctor).app (op _)
          ⟨ULift.up (truncationToChart hS A hA n),
            hasImageIn_formalObjectZeroLocus hred A hA w n⟩) =
      w n := by
  have := A.noetherian
  have hLm : formalObjectIdeal hred A hA w ^ (n + 1) ≤ maximalIdeal A.R ^ (n + 1) :=
    Ideal.pow_right_mono (formalObjectIdeal_le_maximalIdeal hred A hA w) (n + 1)
  have hl : (truncationSection hS A hA hLm ≫ quotientTruncationι hS A hA _ n) ≫
      quotientBaseToChart hS A hA _ = truncationToChart hS A hA n := by
    rw [Category.assoc, ← quotientTruncationToTruncation_comp, ← Category.assoc,
      truncationSection_comp_toTruncation, Category.id_comp]
  refine (zeroLocusCompletionLift_apply _ _ _ _ _ hl).trans ?_
  rw [op_comp, Functor.map_comp_apply, formalObjectAlgebraization_restrict,
    ← Functor.map_comp_apply, ← op_comp, truncationSection_comp_toTruncation, op_id,
    Functor.map_id_apply]

/-- **The ideal of `U ×_W W_red` along an affine point of `V_{/Z}`** is generated by the image of
`I`. -/
theorem isReductionIdeal_formalObjectCompletion {U : BigFppfOver B S hS}
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U)]
    (φ : U ⟶ affineOver B S hS (A.contains_spec_of_contains_truncation hA) A.toS)
    (hφ : Space.HasImageIn B S hS _ (formalObjectZeroLocus hred A hA w) U φ) :
    IsReductionIdeal i ((formalObjectCompletion hW hred A hA w hw).hom.app (op U)
      (((BigFppfOver.topology B S hS).toSheafify (Space.completionSubfunctor B S hS _
        (formalObjectZeroLocus hred A hA w)).toFunctor).app (op U) ⟨ULift.up φ, hφ⟩))
      (Ideal.map (chartRing φ) (formalObjectIdeal hred A hA w)) := by
  have := A.noetherian
  obtain ⟨N, l, hl⟩ := exists_factor_idealNeighbourhood φ hφ
  change IsReductionIdeal i ((zeroLocusCompletionLift _ _).hom.app _ _) _
  rw [zeroLocusCompletionLift_apply _ _ φ hφ l hl]
  have h2 := (isReductionIdeal_formalObjectAlgebraization hW hred A hA w hw N).map l
  rw [Ideal.map_map] at h2
  convert h2 using 2
  ext a
  change chartRing φ a = chartRing (l ≫ quotientBaseToChart hS A hA _) a
  rw [← hl]

end AlgebraicGeometry.FormalSpace

end
