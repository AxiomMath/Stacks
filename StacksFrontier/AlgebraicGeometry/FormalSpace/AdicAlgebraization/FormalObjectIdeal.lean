module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.AdicAlgebraization.CompletionLift
public import StacksFrontier.AlgebraicGeometry.FormalSpace.InfinitesimalNeighbourhood.NeighbourhoodIdeal
public import StacksFrontier.Deformation.Artin.FormalObject.BaseContains

/-!
# The ideal cutting out `Spf R ×_W W_red`

Let `W` be an fppf sheaf with a reduction `i : W_red ⟶ W`, and let `(R, w_n)` be a formal object
of `W`: a Noetherian complete local `S`-algebra `R` and compatible sections
`w_n ∈ W(Spec(R/𝔪ⁿ⁺¹))`. In the proof of Stacks 0GI8 the source lets `I ⊆ R` be the ideal of the
formal closed subspace `Spf(R) ×_{ξ, W} W_red ⊆ Spf(R)`. Here `I` is constructed from the ideals
`K_n ⊆ Γ(Spec(R/𝔪ⁿ⁺¹))` of the reductions `Spec(R/𝔪ⁿ⁺¹) ×_W W_red`
(`AlgebraicGeometry.FormalSpace.IsReductionIdeal`): their preimages `J_n ⊆ R` satisfy
`J_n = J_{n+1} + 𝔪ⁿ⁺¹`, and `I = ⋂ J_n` then satisfies `I + 𝔪ⁿ⁺¹ = J_n` by completeness of `R`.
So `K_n` is generated by the image of `I`, and `I ⊆ 𝔪`.

## Main definitions

* `AlgebraicGeometry.FormalSpace.formalObjectIdeal`: the ideal `I`.

## Main results

* `Ideal.iInf_sup_pow_eq_of_eq_sup_pow`: the commutative algebra above.
* `AlgebraicGeometry.FormalSpace.isReductionIdeal_formalObjectIdeal`: `K_n` is generated by the
  image of `I`.
* `AlgebraicGeometry.FormalSpace.formalObjectIdeal_le_maximalIdeal`: `I ⊆ 𝔪`.

## References

* [Stacks Project, Tag 0GI8](https://stacks.math.columbia.edu/tag/0GI8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite IsLocalRing

universe u

/-- **A decreasing system of ideals with `J_n = J_{n+1} + 𝔪ⁿ⁺¹` is cut out by its
intersection.** Let `R` be `𝔪`-adically complete and let `J_n ⊇ 𝔪ⁿ⁺¹` be ideals with
`J_n = J_{n+1} + 𝔪ⁿ⁺¹`. Then `(⋂ J_k) + 𝔪ⁿ⁺¹ = J_n`: an element of `J_n` is corrected step by
step into `J_{n+1}, J_{n+2}, …`, and the limit of the corrections lies in every `J_k`. -/
theorem Ideal.iInf_sup_pow_eq_of_eq_sup_pow {R : Type*} [CommRing R] {m : Ideal R}
    [IsPrecomplete m R] {J : ℕ → Ideal R} (hJ : ∀ n, m ^ (n + 1) ≤ J n)
    (hsucc : ∀ n, J n = J (n + 1) ⊔ m ^ (n + 1)) (n : ℕ) :
    (⨅ k, J k) ⊔ m ^ (n + 1) = J n := by
  classical
  have hanti : ∀ k, J (k + 1) ≤ J k := fun k => (hsucc k).ge.trans' le_sup_left
  have hanti' : Antitone J := antitone_nat_of_succ_le hanti
  refine le_antisymm (sup_le (iInf_le _ n) (hJ n)) fun x hx => ?_
  -- the corrections
  have step : ∀ k (a : R), a ∈ J (n + k) → ∃ b ∈ J (n + k + 1), a - b ∈ m ^ (n + k + 1) := by
    intro k a ha
    rw [hsucc (n + k), Submodule.mem_sup] at ha
    obtain ⟨b, hb, c, hc, rfl⟩ := ha
    exact ⟨b, hb, by simpa using hc⟩
  choose nxt hnxt hsub using step
  let seq : (k : ℕ) → { a : R // a ∈ J (n + k) } := fun k =>
    Nat.rec (motive := fun k => { a : R // a ∈ J (n + k) }) ⟨x, hx⟩
      (fun k a => ⟨nxt k a.1 a.2, hnxt k a.1 a.2⟩) k
  let g : ℕ → R := fun k => (seq k).1
  have hg : ∀ k, g k ∈ J (n + k) := fun k => (seq k).2
  have hg0 : g 0 = x := rfl
  have hgsucc : ∀ k, g k - g (k + 1) ∈ m ^ (n + k + 1) := fun k =>
    hsub k (g k) (hg k)
  -- telescoping the corrections
  have htele : ∀ {a b : ℕ}, a ≤ b → g a - g b ∈ m ^ (n + a + 1) := by
    intro a b hab
    induction b, hab using Nat.le_induction with
    | base => simp
    | succ b hab ih =>
      have := Ideal.pow_le_pow_right (show n + a + 1 ≤ n + b + 1 by omega) (hgsucc b)
      rw [show g a - g (b + 1) = (g a - g b) + (g b - g (b + 1)) by ring]
      exact add_mem ih this
  -- the sequence `g` is Cauchy
  have hcauchy : ∀ {a b : ℕ}, a ≤ b → g a ≡ g b [SMOD (m ^ a • ⊤ : Submodule R R)] := by
    intro a b hab
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    exact Ideal.pow_le_pow_right (by omega) (htele hab)
  obtain ⟨y, hy⟩ := IsPrecomplete.prec' (I := m) g hcauchy
  have hy' : ∀ k, g k - y ∈ m ^ k := fun k => by
    have := hy k
    rwa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] at this
  -- the limit lies in every `J_k`
  have hyJ : y ∈ ⨅ k, J k := by
    refine Submodule.mem_iInf _ |>.2 fun k => ?_
    have h1 : g (k + 1) ∈ J k :=
      hanti' (show k ≤ n + (k + 1) by omega) (hg (k + 1))
    have h2 : g (k + 1) - y ∈ J k := hJ k (hy' (k + 1))
    have : y = g (k + 1) - (g (k + 1) - y) := by ring
    rw [this]
    exact sub_mem h1 h2
  have hxy : x - y ∈ m ^ (n + 1) := by
    have h0 : g 0 - g (n + 1) ∈ m ^ (n + 1) := by simpa using htele (Nat.zero_le (n + 1))
    rw [← hg0, show g 0 - y = (g 0 - g (n + 1)) + (g (n + 1) - y) by ring]
    exact add_mem h0 (hy' (n + 1))
  have : x = y + (x - y) := by ring
  rw [this]
  exact Submodule.add_mem_sup hyJ hxy

namespace AlgebraicGeometry.FormalSpace

open Deformation.Artin

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

section Truncation

variable (hS) (A : FormalBase S) (hA : ∀ n, B.Contains (A.truncation n))

/-- The truncation `Spec(R/𝔪ⁿ⁺¹)` is an affine scheme. -/
instance isAffine_toScheme_truncationOver (n : ℕ) :
    IsAffine ((BigFppfOver.toScheme B S hS).obj (truncationOver B S hS A hA n)) :=
  inferInstanceAs (IsAffine (Spec (.of (A.R ⧸ maximalIdeal A.R ^ (n + 1)))))

/-- The truncation `Spec(R/𝔪ⁿ⁺¹) ⟶ Spec R`, as a morphism into the affine chart `Spec R`. -/
abbrev truncationToChart (n : ℕ) :
    truncationOver B S hS A hA n ⟶
      affineOver B S hS (A.contains_spec_of_contains_truncation hA) A.toS :=
  restrictionToBase B S hS A (A.contains_spec_of_contains_truncation hA) hA n

/-- On global sections, the truncation `Spec(R/𝔪ⁿ⁺¹) ⟶ Spec R` is the quotient map
`R → R/𝔪ⁿ⁺¹`. -/
theorem chartRing_truncationToChart (n : ℕ) (a : A.R) :
    chartRing (truncationToChart hS A hA n) a =
      (Scheme.ΓSpecIso (.of (A.R ⧸ maximalIdeal A.R ^ (n + 1)))).inv
        (Ideal.Quotient.mk _ a) :=
  (congrArg (fun g => g.hom a)
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (Ideal.Quotient.mk
      (maximalIdeal A.R ^ (n + 1)))))).symm

/-- The map `R → Γ(Spec(R/𝔪ⁿ⁺¹))` induced by the truncation is surjective. -/
theorem surjective_chartRing_truncationToChart (n : ℕ) :
    Function.Surjective (chartRing (truncationToChart hS A hA n)) := by
  intro b
  obtain ⟨c, rfl⟩ := (Scheme.ΓSpecIso
    (.of (A.R ⧸ maximalIdeal A.R ^ (n + 1)))).commRingCatIsoToRingEquiv.symm.surjective b
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  exact ⟨a, chartRing_truncationToChart hS A hA n a⟩

/-- The kernel of `R → Γ(Spec(R/𝔪ⁿ⁺¹))` is `𝔪ⁿ⁺¹`. -/
theorem ker_chartRing_truncationToChart (n : ℕ) :
    RingHom.ker (chartRing (truncationToChart hS A hA n)) = maximalIdeal A.R ^ (n + 1) := by
  have e : chartRing (truncationToChart hS A hA n) =
      (Scheme.ΓSpecIso (.of (A.R ⧸ maximalIdeal A.R ^ (n + 1)))).inv.hom.comp
        (Ideal.Quotient.mk _) := RingHom.ext (chartRing_truncationToChart hS A hA n)
  rw [e]
  exact (RingHom.ker_comp_of_injective _
    (Scheme.ΓSpecIso
      (.of (A.R ⧸ maximalIdeal A.R ^ (n + 1)))).commRingCatIsoToRingEquiv.symm.injective).trans
    Ideal.mk_ker

/-- The truncations into `Spec R` are compatible with the transition maps
`Spec(R/𝔪ⁿ⁺¹) ⟶ Spec(R/𝔪ⁿ⁺²)`. -/
theorem truncationOverSucc_comp_truncationToChart (n : ℕ) :
    truncationOverSucc B S hS A hA n ≫ truncationToChart hS A hA (n + 1) =
      truncationToChart hS A hA n :=
  restrictionToBase_succ B S hS A _ hA n

end Truncation

variable {W Wred : FppfSheaf B S hS} {i : Wred ⟶ W} (hred : IsReduction B S hS W Wred i)
  (A : FormalBase S) (hA : ∀ n, B.Contains (A.truncation n))
  (w : ∀ n, W.obj.obj (op (truncationOver B S hS A hA n)))

/-- The ideal `K_n` of `Spec(R/𝔪ⁿ⁺¹) ×_W W_red` in `Γ(Spec(R/𝔪ⁿ⁺¹))`. -/
def truncationReductionIdeal (n : ℕ) :
    Ideal Γ((BigFppfOver.toScheme B S hS).obj (truncationOver B S hS A hA n), ⊤) :=
  (hred.exists_isReductionIdeal (w n)).choose

/-- `K_n` is the ideal of the reduction `Spec(R/𝔪ⁿ⁺¹) ×_W W_red`. -/
theorem isReductionIdeal_truncationReductionIdeal (n : ℕ) :
    IsReductionIdeal i (w n) (truncationReductionIdeal hred A hA w n) :=
  (hred.exists_isReductionIdeal (w n)).choose_spec

/-- The preimage `J_n ⊆ R` of `K_n`. -/
def formalObjectIdealStage (n : ℕ) : Ideal A.R :=
  Ideal.comap (chartRing (truncationToChart hS A hA n)) (truncationReductionIdeal hred A hA w n)

/-- `K_n` is the image of its preimage `J_n`, as `R → Γ(Spec(R/𝔪ⁿ⁺¹))` is surjective. -/
private theorem truncationReductionIdeal_eq_map_stage (n : ℕ) :
    truncationReductionIdeal hred A hA w n =
      Ideal.map (chartRing (truncationToChart hS A hA n)) (formalObjectIdealStage hred A hA w n) :=
  (Ideal.map_comap_of_surjective _ (surjective_chartRing_truncationToChart hS A hA n) _).symm

/-- **The ideal `I ⊆ R` of `Spf R ×_W W_red`**, as `⋂ J_n`. -/
def formalObjectIdeal : Ideal A.R :=
  ⨅ n, formalObjectIdealStage hred A hA w n

/-- `𝔪ⁿ⁺¹ ⊆ J_n`. -/
theorem pow_le_formalObjectIdealStage (n : ℕ) :
    maximalIdeal A.R ^ (n + 1) ≤ formalObjectIdealStage hred A hA w n := by
  rw [← ker_chartRing_truncationToChart hS A hA n]
  exact Ideal.comap_mono bot_le

variable (hw : ∀ n, W.obj.map (truncationOverSucc B S hS A hA n).op (w (n + 1)) = w n)

include hw in
/-- `J_n = J_{n+1} + 𝔪ⁿ⁺¹`. -/
theorem formalObjectIdealStage_eq_sup (n : ℕ) :
    formalObjectIdealStage hred A hA w n =
      formalObjectIdealStage hred A hA w (n + 1) ⊔ maximalIdeal A.R ^ (n + 1) := by
  set ψ := chartRing (truncationToChart hS A hA n)
  set ψ' := chartRing (truncationToChart hS A hA (n + 1))
  set σ := ((BigFppfOver.toScheme B S hS).map (truncationOverSucc B S hS A hA n)).appTop.hom
  have hψ : ψ = σ.comp ψ' := by
    ext a
    show chartRing (truncationToChart hS A hA n) a =
      chartRing (truncationOverSucc B S hS A hA n ≫ truncationToChart hS A hA (n + 1)) a
    rw [truncationOverSucc_comp_truncationToChart]
  have hK : truncationReductionIdeal hred A hA w n =
      Ideal.map σ (truncationReductionIdeal hred A hA w (n + 1)) := by
    refine (isReductionIdeal_truncationReductionIdeal hred A hA w n).unique ?_
    have := (isReductionIdeal_truncationReductionIdeal hred A hA w (n + 1)).map
      (truncationOverSucc B S hS A hA n)
    rwa [hw n] at this
  show Ideal.comap ψ (truncationReductionIdeal hred A hA w n) = _
  rw [hK, truncationReductionIdeal_eq_map_stage hred A hA w (n + 1), Ideal.map_map, ← hψ,
    Ideal.comap_map_of_surjective' _ (surjective_chartRing_truncationToChart hS A hA n),
    ker_chartRing_truncationToChart]

include hw in
/-- `I + 𝔪ⁿ⁺¹ = J_n`. -/
theorem formalObjectIdeal_sup_pow (n : ℕ) :
    formalObjectIdeal hred A hA w ⊔ maximalIdeal A.R ^ (n + 1) =
      formalObjectIdealStage hred A hA w n := by
  have : IsAdicComplete (maximalIdeal A.R) A.R := A.complete
  exact Ideal.iInf_sup_pow_eq_of_eq_sup_pow (pow_le_formalObjectIdealStage hred A hA w)
    (formalObjectIdealStage_eq_sup hred A hA w hw) n

include hw in
/-- **The ideal of `Spec(R/𝔪ⁿ⁺¹) ×_W W_red` is generated by the image of `I`.** -/
theorem isReductionIdeal_formalObjectIdeal (n : ℕ) :
    IsReductionIdeal i (w n)
      (Ideal.map (chartRing (truncationToChart hS A hA n)) (formalObjectIdeal hred A hA w)) := by
  have h := isReductionIdeal_truncationReductionIdeal hred A hA w n
  have e : truncationReductionIdeal hred A hA w n =
      Ideal.map (chartRing (truncationToChart hS A hA n)) (formalObjectIdeal hred A hA w) := by
    rw [truncationReductionIdeal_eq_map_stage hred A hA w n,
      ← formalObjectIdeal_sup_pow hred A hA w hw n, Ideal.map_sup,
      (Ideal.map_eq_bot_iff_le_ker _).2 (ker_chartRing_truncationToChart hS A hA n).ge, sup_bot_eq]
  rwa [e] at h

/-- **`I ⊆ 𝔪`**: the closed point of `Spec(R/𝔪)` maps into `W_red`, `Spec(R/𝔪)` being reduced. -/
theorem formalObjectIdeal_le_maximalIdeal :
    formalObjectIdeal hred A hA w ≤ maximalIdeal A.R := by
  refine (iInf_le _ 0).trans ?_
  have hred0 : IsReduced ((BigFppfOver.toScheme B S hS).obj (truncationOver B S hS A hA 0)) := by
    show IsReduced (Spec (.of (A.R ⧸ maximalIdeal A.R ^ (0 + 1))))
    have : _root_.IsReduced (A.R ⧸ maximalIdeal A.R ^ (0 + 1)) :=
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by simpa using (maximalIdeal.isMaximal A.R).isPrime.isRadical)
    infer_instance
  obtain ⟨r, hr⟩ := (hred.bijective_app _ hred0).2 (w 0)
  have hK := (isReductionIdeal_truncationReductionIdeal hred A hA w 0 _ (𝟙 _)).1
    ⟨r, by rw [hr, op_id, Functor.map_id_apply]⟩
  have hK0 : truncationReductionIdeal hred A hA w 0 = ⊥ := by
    rw [eq_bot_iff]
    refine hK.trans fun ξ hξ => ?_
    simpa using hξ
  show Ideal.comap _ (truncationReductionIdeal hred A hA w 0) ≤ _
  rw [hK0, ← RingHom.ker_eq_comap_bot, ker_chartRing_truncationToChart, zero_add, pow_one]

end AlgebraicGeometry.FormalSpace

end
