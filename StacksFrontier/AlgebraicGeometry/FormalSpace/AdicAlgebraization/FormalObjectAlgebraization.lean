module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.AdicAlgebraization.FormalObjectTruncations
public import
  StacksFrontier.AlgebraicGeometry.FormalSpace.InfinitesimalNeighbourhood.NeighbourhoodOrder

/-!
# The morphisms `ξ'_k : Spec(R/Iᵏ⁺¹) ⟶ W` of the proof of Stacks 0GI8

Let `W` be a locally Noetherian formal algebraic space with reduction `i : W_red ⟶ W`, `(R, w_n)`
a formal object of `W` and `I ⊆ R` the ideal of `Spf R ×_W W_red`
(`AlgebraicGeometry.FormalSpace.formalObjectIdeal`). On the truncations `Spec((R/Iᵏ⁺¹)/𝔪ⁿ⁺¹)` the
restrictions of `w_n` lie in `W_k`, since there the ideal of the reduction, generated by the image
of `I`, has vanishing `(k+1)`st power; Stacks 0AQH for the algebraic space `W_k` algebraizes them
to `ξ'_k ∈ W(Spec(R/Iᵏ⁺¹))`.

## Main definitions

* `AlgebraicGeometry.FormalSpace.formalObjectAlgebraization`: `ξ'_k`.

## Main results

* `AlgebraicGeometry.FormalSpace.formalObjectAlgebraization_restrict`: `ξ'_k` restricts to the
  formal object on the truncations of `R/Iᵏ⁺¹`.
* `AlgebraicGeometry.FormalSpace.formalObjectAlgebraization_compatible`: the `ξ'_k` are
  compatible.
* `AlgebraicGeometry.FormalSpace.isReductionIdeal_formalObjectAlgebraization`: the ideal of
  `Spec(R/Iᵏ⁺¹) ×_W W_red` is generated by the image of `I`.

## References

* [Stacks Project, Tag 0GI8](https://stacks.math.columbia.edu/tag/0GI8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite IsLocalRing

universe u

namespace AlgebraicGeometry.FormalSpace

open Deformation.Artin

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {W Wred : FppfSheaf B S hS} {i : Wred ⟶ W} (hW : IsLocallyNoetherian B S hS W)
  (hred : IsReduction B S hS W Wred i) (A : FormalBase S) (hA : ∀ n, B.Contains (A.truncation n))
  (w : ∀ n, W.obj.obj (op (truncationOver B S hS A hA n)))
  (hw : ∀ n, W.obj.map (truncationOverSucc B S hS A hA n).op (w (n + 1)) = w n)

/-- The ring map of the composite `Spec((R/L)/𝔪ⁿ⁺¹) ⟶ Spec(R/L) ⟶ Spec R` factors through
`R ⟶ R/L`. -/
theorem chartRing_quotientTruncationι_comp (L : Ideal A.R) (n : ℕ) (a : A.R) :
    chartRing (quotientTruncationι hS A hA L n ≫ quotientBaseToChart hS A hA L) a =
      chartRing (quotientTruncationι hS A hA L n) (Ideal.Quotient.mk L a) := by
  rw [chartRing_comp]
  exact congrArg (fun b => ((BigFppfOver.toScheme B S hS).map
    (quotientTruncationι hS A hA L n)).appTop b)
    (chartRing_quotientToAffineOver (B := B) (hS := hS) (f := A.toS)
      (hA := A.contains_spec_of_contains_truncation hA) L a)

include hw in
/-- The restriction of `w_n` to `Spec((R/L)/𝔪ⁿ⁺¹)` has ideal of the reduction generated by the
image of `I`. -/
theorem isReductionIdeal_restrict_quotientTruncation (L : Ideal A.R) (n : ℕ) :
    IsReductionIdeal i (W.obj.map (quotientTruncationToTruncation hS A hA L n).op (w n))
      (Ideal.map (chartRing (quotientTruncationι hS A hA L n ≫ quotientBaseToChart hS A hA L))
        (formalObjectIdeal hred A hA w)) := by
  have h := (isReductionIdeal_formalObjectIdeal hred A hA w hw n).map
    (quotientTruncationToTruncation hS A hA L n)
  rw [Ideal.map_map] at h
  convert h using 2
  ext a
  show _ = chartRing (quotientTruncationToTruncation hS A hA L n ≫ truncationToChart hS A hA n) a
  rw [quotientTruncationToTruncation_comp]

/-- The truncation `Spec((R/L)/𝔪ⁿ⁺¹)` is an affine scheme. -/
instance isAffine_toScheme_quotientTruncation (L : Ideal A.R) (n : ℕ) :
    IsAffine ((BigFppfOver.toScheme B S hS).obj (quotientTruncation hS A hA L n)) :=
  (quotientOver B S hS (quotientBaseStr A L) (contains_spec_quotientBase A hA L)
    (quotientBaseStage A L n)).2

/-- The powers `Iᵏ⁺¹` of the ideal of the formal object lie in the maximal ideal of `R`. -/
theorem formalObjectIdeal_pow_le (k : ℕ) :
    formalObjectIdeal hred A hA w ^ (k + 1) ≤ maximalIdeal A.R :=
  (Ideal.pow_le_self (Nat.succ_ne_zero k)).trans (formalObjectIdeal_le_maximalIdeal hred A hA w)

include hw in
/-- On the truncations of `R/Iᵏ⁺¹` the formal object lies in `W_k`. -/
theorem restrict_mem_reductionNeighbourhood (k n : ℕ) :
    W.obj.map (quotientTruncationToTruncation hS A hA (formalObjectIdeal hred A hA w ^ (k + 1))
        n).op (w n) ∈ (reductionNeighbourhood i k).obj
      (op (quotientTruncation hS A hA (formalObjectIdeal hred A hA w ^ (k + 1)) n)) := by
  refine (mem_reductionNeighbourhood_iff k
    (isReductionIdeal_restrict_quotientTruncation hred A hA w hw _ n)).2 ?_
  rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
  intro a ha
  rw [RingHom.mem_ker, chartRing_quotientTruncationι_comp, Ideal.Quotient.eq_zero_iff_mem.2 ha,
    map_zero]

/-- The compatible family of sections of `W_k` on the truncations of `R/Iᵏ⁺¹`. -/
def restrictFamily (k n : ℕ) : (reductionNeighbourhood i k).toFunctor.obj
    (op (quotientTruncation hS A hA (formalObjectIdeal hred A hA w ^ (k + 1)) n)) :=
  ⟨_, restrict_mem_reductionNeighbourhood hred A hA w hw k n⟩

/-- The sections `AlgebraicGeometry.FormalSpace.restrictFamily` are compatible along the
transition maps of the truncations. -/
theorem restrictFamily_succ (k n : ℕ) :
    (reductionNeighbourhood i k).toFunctor.map (quotientTruncationSucc hS A hA _ n).op
      (restrictFamily hred A hA w hw k (n + 1)) = restrictFamily hred A hA w hw k n := by
  apply Subtype.ext
  show W.obj.map _ (W.obj.map _ (w (n + 1))) = W.obj.map _ (w n)
  rw [← Functor.map_comp_apply, ← op_comp, quotientTruncationSucc_comp_toTruncation,
    op_comp, Functor.map_comp_apply, hw]

/-- **The morphism `ξ'_k : Spec(R/Iᵏ⁺¹) ⟶ W`**, as a section of `W_k`: the section whose
restriction to each truncation of `R/Iᵏ⁺¹` is the restriction of the formal object. -/
def formalObjectAlgebraization (k : ℕ) : (reductionNeighbourhood i k).toFunctor.obj
    (op (quotientBase hS A hA (formalObjectIdeal hred A hA w ^ (k + 1)))) :=
  (existsUnique_reductionNeighbourhood_quotientTruncations hW hred A hA
    (formalObjectIdeal_pow_le hred A hA w k) k (restrictFamily hred A hA w hw k)
    (restrictFamily_succ hred A hA w hw k)).exists.choose

/-- `ξ'_k` restricts to the formal object on the truncations of `R/Iᵏ⁺¹`. -/
theorem formalObjectAlgebraization_restrict (k n : ℕ) :
    W.obj.map (quotientTruncationι hS A hA _ n).op
        (formalObjectAlgebraization hW hred A hA w hw k).1 =
      W.obj.map (quotientTruncationToTruncation hS A hA
        (formalObjectIdeal hred A hA w ^ (k + 1)) n).op (w n) :=
  congrArg Subtype.val ((existsUnique_reductionNeighbourhood_quotientTruncations hW hred A hA
    (formalObjectIdeal_pow_le hred A hA w k) k (restrictFamily hred A hA w hw k)
    (restrictFamily_succ hred A hA w hw k)).exists.choose_spec n)

/-- **The `ξ'_k` are compatible.** -/
theorem formalObjectAlgebraization_compatible {k m : ℕ} (h : k ≤ m) :
    W.obj.map (idealNeighbourhoodTransition (hS := hS)
        (hA := A.contains_spec_of_contains_truncation hA) (f := A.toS)
        (formalObjectIdeal hred A hA w) h).op (formalObjectAlgebraization hW hred A hA w hw m).1 =
      (formalObjectAlgebraization hW hred A hA w hw k).1 := by
  have hle : formalObjectIdeal hred A hA w ^ (m + 1) ≤ formalObjectIdeal hred A hA w ^ (k + 1) :=
    Ideal.pow_le_pow_right (Nat.succ_le_succ h)
  have hmono := reductionNeighbourhood_mono i h
  have key := existsUnique_reductionNeighbourhood_quotientTruncations hW hred A hA
    (formalObjectIdeal_pow_le hred A hA w k) m
    (fun n => ⟨_, hmono _ (restrict_mem_reductionNeighbourhood hred A hA w hw k n)⟩)
    (fun n => Subtype.ext (congrArg (fun x : (reductionNeighbourhood i k).toFunctor.obj _ => x.1)
      (restrictFamily_succ hred A hA w hw k n)))
  have hy₂ : W.obj.map (idealNeighbourhoodTransition (hS := hS)
        (hA := A.contains_spec_of_contains_truncation hA) (f := A.toS)
        (formalObjectIdeal hred A hA w) h).op (formalObjectAlgebraization hW hred A hA w hw m).1 ∈
      (reductionNeighbourhood i m).obj _ :=
    (reductionNeighbourhood i m).map _ (formalObjectAlgebraization hW hred A hA w hw m).2
  have h1 := key.unique (y₁ := ⟨(formalObjectAlgebraization hW hred A hA w hw k).1,
      hmono _ (formalObjectAlgebraization hW hred A hA w hw k).2⟩)
    (y₂ := ⟨_, hy₂⟩)
    (fun n => Subtype.ext (formalObjectAlgebraization_restrict hW hred A hA w hw k n))
    (fun n => Subtype.ext (by
      show W.obj.map _ (W.obj.map _ _) = _
      rw [← Functor.map_comp_apply, ← op_comp]
      have e := quotientTruncationMap_comp_ι hS A hA hle n
      show W.obj.map (quotientTruncationι hS A hA _ n ≫ _).op _ = _
      rw [← e, op_comp, Functor.map_comp_apply,
        formalObjectAlgebraization_restrict hW hred A hA w hw m n,
        ← Functor.map_comp_apply, ← op_comp, quotientTruncationMap_comp_toTruncation]))
  exact (congrArg Subtype.val h1).symm

/-- The kernel of the ring map of `Spec((R/L)/𝔪ⁿ⁺¹) ⟶ Spec R` is `L + 𝔪ⁿ⁺¹`. -/
theorem ker_chartRing_quotientTruncationι_comp (L : Ideal A.R) (n : ℕ) :
    RingHom.ker (chartRing (quotientTruncationι hS A hA L n ≫ quotientBaseToChart hS A hA L)) =
      L ⊔ maximalIdeal A.R ^ (n + 1) := by
  have := A.noetherian
  have e : chartRing (quotientTruncationι hS A hA L n ≫ quotientBaseToChart hS A hA L) =
      (chartRing (quotientTruncationι hS A hA L n)).comp (Ideal.Quotient.mk L) :=
    RingHom.ext (chartRing_quotientTruncationι_comp A hA L n)
  rw [e, ← RingHom.comap_ker, Artin.ContractionSituation.ker_chartRing_quotientToAffineOver,
    Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker, sup_comm]

/-- The ring map of `Spec((R/L)/𝔪ⁿ⁺¹) ⟶ Spec R` is surjective. -/
theorem surjective_chartRing_quotientTruncationι_comp (L : Ideal A.R) (n : ℕ) :
    Function.Surjective
      (chartRing (quotientTruncationι hS A hA L n ≫ quotientBaseToChart hS A hA L)) := by
  intro b
  obtain ⟨c, rfl⟩ := surjective_chartRing_quotientToAffineOver (f := quotientBaseStr A L)
    (hA := contains_spec_quotientBase A hA L) (quotientBaseStage A L n) b
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  exact ⟨a, chartRing_quotientTruncationι_comp A hA L n a⟩

/-- **The ideal of `Spec(R/Iᵏ⁺¹) ×_W W_red` is generated by the image of `I`.** -/
theorem isReductionIdeal_formalObjectAlgebraization (k : ℕ) :
    IsReductionIdeal i (formalObjectAlgebraization hW hred A hA w hw k).1
      (Ideal.map (chartRing (quotientBaseToChart hS A hA (formalObjectIdeal hred A hA w ^ (k + 1))))
        (formalObjectIdeal hred A hA w)) := by
  have := A.noetherian
  have : IsAffine ((BigFppfOver.toScheme B S hS).obj
      (quotientBase hS A hA (formalObjectIdeal hred A hA w ^ (k + 1)))) :=
    (quotientOver B S hS A.toS (A.contains_spec_of_contains_truncation hA) _).2
  set I := formalObjectIdeal hred A hA w with hI
  set L := I ^ (k + 1) with hL
  set θ := chartRing (quotientBaseToChart hS A hA L) with hθ
  have hθs : Function.Surjective θ := surjective_chartRing_quotientToAffineOver (f := A.toS)
    (hA := A.contains_spec_of_contains_truncation hA) L
  have hθk : RingHom.ker θ = L := Artin.ContractionSituation.ker_chartRing_quotientToAffineOver L
  have hLI : L ≤ I := Ideal.pow_le_self (Nat.succ_ne_zero k)
  obtain ⟨K', hK'⟩ :=
    hred.exists_isReductionIdeal (formalObjectAlgebraization hW hred A hA w hw k).1
  suffices e : K' = Ideal.map θ I by rwa [← e]
  have hn : ∀ n, Ideal.map (chartRing (quotientTruncationι hS A hA L n ≫
      quotientBaseToChart hS A hA L)) (Ideal.comap θ K') =
      Ideal.map (chartRing (quotientTruncationι hS A hA L n ≫
        quotientBaseToChart hS A hA L)) I := by
    intro n
    have hψ : chartRing (quotientTruncationι hS A hA L n ≫ quotientBaseToChart hS A hA L) =
        ((BigFppfOver.toScheme B S hS).map (quotientTruncationι hS A hA L n)).appTop.hom.comp θ :=
      RingHom.ext fun a => chartRing_comp _ _ a
    rw [hψ, ← Ideal.map_map, Ideal.map_comap_of_surjective _ hθs]
    have h1 := hK'.map (quotientTruncationι hS A hA L n)
    rw [formalObjectAlgebraization_restrict hW hred A hA w hw k n] at h1
    have h2 := isReductionIdeal_restrict_quotientTruncation hred A hA w hw L n
    rw [hψ] at h2
    exact h1.unique h2
  have hJ : Ideal.comap θ K' = I := by
    rw [← Ideal.iInf_sup_maximalIdeal_pow (Ideal.comap θ K'),
      ← Ideal.iInf_sup_maximalIdeal_pow I]
    refine iInf_congr fun n => ?_
    cases n with
    | zero => simp
    | succ n =>
      have h := congrArg (Ideal.comap (chartRing (quotientTruncationι hS A hA L n ≫
        quotientBaseToChart hS A hA L))) (hn n)
      simp only [Ideal.comap_map_of_surjective' _
        (surjective_chartRing_quotientTruncationι_comp A hA L n),
        ker_chartRing_quotientTruncationι_comp, ← sup_assoc,
        sup_eq_left.2 (hθk.ge.trans (Ideal.ker_le_comap (K := K') θ)), sup_eq_left.2 hLI] at h
      exact h
  rw [← hJ, Ideal.map_comap_of_surjective _ hθs]

end AlgebraicGeometry.FormalSpace

end
