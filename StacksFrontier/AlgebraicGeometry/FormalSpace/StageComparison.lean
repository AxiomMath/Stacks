module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.StageLiftAlgebra
public import StacksFrontier.AlgebraicGeometry.FormalSpace.CompletionStageBelow
public import StacksFrontier.Topology.Algebra.AdicTopology.EtaleLiftWeakIdealOfDefinition

/-!
# The comparison of the quotients of the étale lift with the stage models

Let `R` be a topological ring presenting an affine formal algebraic space `Spf R` over `S`, let
`v : V ⟶ Spf R` be a morphism from an affine formal algebraic space which is representable by
algebraic spaces and étale, let `J₀ ⊆ R` be a weak ideal of definition and let
`A = stageLiftAlgebra` be the chosen étale `R`-algebra with `A ⧸ J₀A ≅ Ā_{J₀}`. This file
constructs, for every weak ideal of definition `J ⊆ J₀`, the comparison isomorphism

`φ_J : A ⧸ JA ≅ Ā_J`

of `R ⧸ J`-algebras, the unique isomorphism reducing to the chosen identification modulo `J₀`,
and shows that the family `φ_J` is compatible with the stage transitions.

## Main definitions

* `CommRingCat.quotientEquivOfIsPushout`: the pushout of a surjection `ψ` of commutative rings
  along a ring map `φ` is the quotient of the target of `φ` by the ideal generated by the image
  of the kernel of `ψ`.
* `AlgebraicGeometry.FormalSpace.stageNilIdeal`: the image `J₀ ⧸ J` of `J₀` in the stage `R ⧸ J`.
* `AlgebraicGeometry.FormalSpace.stageBaseChangeRingReductionEquiv`: the identification
  `Ā_J ⧸ (J₀ ⧸ J)Ā_J ≅ Ā_{J₀}`.
* `AlgebraicGeometry.FormalSpace.stageLiftReduction`: the `R ⧸ J`-algebra `A ⧸ JA`.
* `AlgebraicGeometry.FormalSpace.stageLiftReductionEquiv`: the identification
  `(A ⧸ JA) ⧸ (J₀ ⧸ J)(A ⧸ JA) ≅ Ā_{J₀}`.
* `AlgebraicGeometry.FormalSpace.stageComparison`: the comparison `φ_J : A ⧸ JA ≅ Ā_J`.

## Main results

* `AlgebraicGeometry.FormalSpace.stageNilIdeal_le_nilradical`: `J₀ ⧸ J` is nilpotent in `R ⧸ J`.
* `AlgebraicGeometry.FormalSpace.etale_stageLiftReduction`: `A ⧸ JA` is étale over `R ⧸ J`.
* `AlgebraicGeometry.FormalSpace.stageComparison_spec` and
  `AlgebraicGeometry.FormalSpace.stageComparison_unique`: `φ_J` reduces to the chosen
  identification modulo `J₀ ⧸ J`, and is the only isomorphism that does.
* `AlgebraicGeometry.FormalSpace.stageComparison_naturality`: the family `φ_J` is compatible
  with the stage transitions.

## References

* [Stacks Project, Tag 0AN8](https://stacks.math.columbia.edu/tag/0AN8)
* [Stacks Project, Tag 0ALI](https://stacks.math.columbia.edu/tag/0ALI)
* [Stacks Project, Tag 04D1](https://stacks.math.columbia.edu/tag/04D1)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace CommRingCat

namespace PushoutQuotient

variable {Rb Ab R0 A0 : CommRingCat.{u}} {φ : Rb ⟶ Ab} {ψ : Rb ⟶ R0} {θ : Ab ⟶ A0}
  {ρ : R0 ⟶ A0} (hsq : IsPushout φ ψ θ ρ) {K : Ideal Rb} (hK : RingHom.ker ψ.hom = K)
  (hψ : Function.Surjective ψ.hom)

include hsq in
/-- The commutativity of a pushout square of rings, read on elements. -/
theorem apply_eq (x : Rb) : θ.hom (φ.hom x) = ρ.hom (ψ.hom x) :=
  ConcreteCategory.congr_hom hsq.w x

include hsq hK in
/-- The right-hand edge of the square kills the extension of the kernel of the bottom edge. -/
theorem map_le_ker : K.map φ.hom ≤ RingHom.ker θ.hom := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  have hx0 : ψ.hom x = 0 := RingHom.mem_ker.mp (by rw [hK]; exact hx)
  simp only [Ideal.mem_comap, RingHom.mem_ker, apply_eq hsq x, hx0, map_zero]

include hsq hK in
/-- The map from the quotient by the extended kernel to the pushout corner, induced by the
right-hand edge of the square. -/
noncomputable def hom : (Ab ⧸ K.map φ.hom) →+* A0 :=
  Ideal.Quotient.lift _ θ.hom (map_le_ker hsq hK)

include hsq hK in
/-- The map `hom` sends the class of `a` to `θ a`. -/
@[simp]
theorem hom_mk (a : Ab) : hom hsq hK (Ideal.Quotient.mk (K.map φ.hom) a) = θ.hom a :=
  Ideal.Quotient.lift_mk _ _ _

include hK hψ in
/-- A surjection with kernel `K` identifies its target with the quotient by `K`. -/
noncomputable def baseEquiv : (Rb ⧸ K) ≃+* R0 :=
  (Ideal.quotEquivOfEq hK.symm).trans (RingHom.quotientKerEquivOfSurjective hψ)

include hK hψ in
/-- The identification `baseEquiv` sends the class of `x` to `ψ x`. -/
theorem baseEquiv_mk (x : Rb) : baseEquiv hK hψ (Ideal.Quotient.mk K x) = ψ.hom x := by
  rw [baseEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
  exact RingHom.quotientKerEquivOfSurjective_apply_mk _ _

include hK hψ in
/-- The second cocone leg of the quotient square: the map from the target of the surjection into
the quotient by the extended kernel. -/
noncomputable def inr : R0 →+* (Ab ⧸ K.map φ.hom) :=
  (Ideal.quotientMap (K.map φ.hom) φ.hom Ideal.le_comap_map).comp
    ((baseEquiv hK hψ).symm : R0 →+* (Rb ⧸ K))

include hK hψ in
/-- The map `inr` sends `ψ x` to the class of `φ x`. -/
theorem inr_apply (x : Rb) :
    inr hK hψ (ψ.hom x) = Ideal.Quotient.mk (K.map φ.hom) (φ.hom x) := by
  have h : (baseEquiv hK hψ).symm (ψ.hom x) = Ideal.Quotient.mk K x :=
    (RingEquiv.symm_apply_eq _).mpr (baseEquiv_mk hK hψ x).symm
  rw [inr, RingHom.comp_apply, RingEquiv.coe_toRingHom, h, Ideal.quotientMap_mk]

include hK hψ in
/-- The quotient by the extended kernel is a cocone on the same span. -/
theorem square :
    φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (K.map φ.hom)) =
      ψ ≫ CommRingCat.ofHom (inr hK hψ) := by
  ext x
  exact (inr_apply hK hψ x).symm

include hsq hK hψ in
/-- The map from the pushout corner to the quotient by the extended kernel, by the universal
property of the pushout. -/
noncomputable def inv : A0 ⟶ CommRingCat.of (Ab ⧸ K.map φ.hom) :=
  hsq.desc (CommRingCat.ofHom (Ideal.Quotient.mk (K.map φ.hom)))
    (CommRingCat.ofHom (inr hK hψ)) (square hK hψ)

include hsq hK hψ in
/-- The map `inv` sends `θ a` to the class of `a`. -/
theorem inv_theta (a : Ab) :
    (inv hsq hK hψ).hom (θ.hom a) = Ideal.Quotient.mk (K.map φ.hom) a :=
  ConcreteCategory.congr_hom (hsq.inl_desc _ _ (square hK hψ)) a

include hsq hK hψ in
/-- The map `inv` agrees with `inr` on the image of `ρ`. -/
theorem inv_rho (r : R0) : (inv hsq hK hψ).hom (ρ.hom r) = inr hK hψ r :=
  ConcreteCategory.congr_hom (hsq.inr_desc _ _ (square hK hψ)) r

include hsq hK hψ in
/-- The map `hom` sends `inr r` to `ρ r`. -/
theorem hom_inr (r : R0) : hom hsq hK (inr hK hψ r) = ρ.hom r := by
  obtain ⟨x, rfl⟩ := hψ r
  rw [inr_apply hK hψ x]
  exact (hom_mk hsq hK (φ.hom x)).trans (apply_eq hsq x)

include hsq hK hψ in
/-- The composite of `inv` followed by `hom` is the identity of the pushout corner. -/
theorem inv_comp_hom :
    inv hsq hK hψ ≫ CommRingCat.ofHom (hom hsq hK) = CategoryStruct.id A0 := by
  refine hsq.hom_ext ?_ ?_
  · ext a
    change hom hsq hK ((inv hsq hK hψ).hom (θ.hom a)) = θ.hom a
    rw [inv_theta hsq hK hψ a]
    exact hom_mk hsq hK a
  · ext r
    change hom hsq hK ((inv hsq hK hψ).hom (ρ.hom r)) = ρ.hom r
    rw [inv_rho hsq hK hψ r]
    exact hom_inr hsq hK hψ r

end PushoutQuotient

open PushoutQuotient in
/-- **A pushout of a surjection of commutative rings is the quotient by the extended kernel.**
If

```
Rb --φ--> Ab
|          |
ψ          θ
v          v
R0 --ρ--> A0
```

is a pushout square of commutative rings and `ψ` is surjective with kernel `K`, then `θ`
identifies `A0` with `Ab ⧸ K·Ab`. -/
noncomputable def quotientEquivOfIsPushout {Rb Ab R0 A0 : CommRingCat.{u}} {φ : Rb ⟶ Ab}
    {ψ : Rb ⟶ R0} {θ : Ab ⟶ A0} {ρ : R0 ⟶ A0} (hsq : IsPushout φ ψ θ ρ) {K : Ideal Rb}
    (hK : RingHom.ker ψ.hom = K) (hψ : Function.Surjective ψ.hom) :
    (Ab ⧸ K.map φ.hom) ≃+* A0 :=
  RingEquiv.ofRingHom (hom hsq hK) (inv hsq hK hψ).hom
    (RingHom.ext fun y => congrArg (fun f : A0 ⟶ A0 => f.hom y) (inv_comp_hom hsq hK hψ))
    (Ideal.Quotient.ringHom_ext (RingHom.ext fun a => by
      change (inv hsq hK hψ).hom (hom hsq hK (Ideal.Quotient.mk _ a)) = _
      rw [hom_mk hsq hK a, inv_theta hsq hK hψ a]
      rfl))

/-- The identification `quotientEquivOfIsPushout` sends the class of `a` to `θ a`. -/
@[simp]
theorem quotientEquivOfIsPushout_mk {Rb Ab R0 A0 : CommRingCat.{u}} {φ : Rb ⟶ Ab}
    {ψ : Rb ⟶ R0} {θ : Ab ⟶ A0} {ρ : R0 ⟶ A0} (hsq : IsPushout φ ψ θ ρ) {K : Ideal Rb}
    (hK : RingHom.ker ψ.hom = K) (hψ : Function.Surjective ψ.hom) (a : Ab) :
    quotientEquivOfIsPushout hsq hK hψ (Ideal.Quotient.mk (K.map φ.hom) a) = θ.hom a :=
  PushoutQuotient.hom_mk hsq hK a

end CommRingCat

namespace AlgebraicGeometry.FormalSpace

attribute [local instance] sheaf_hasColimits

section Index

variable {R : Type u} [CommRing R] [TopologicalSpace R]
  {J₀ : TopologicalRing.WeakIdealOfDefinitionIndex R}

/-- The transition morphism `J₀ ⟶ J` of the reverse-inclusion order on weak ideals of
definition attached to a weak ideal of definition `J ⊆ J₀`. -/
abbrev weakIdealsBelowTransition (J : WeakIdealsBelow R J₀) :
    (OrderDual.toDual J₀ : WeakIdeals R) ⟶ J.1 :=
  homOfLE J.2

/-- The image `J₀ ⧸ J` of `J₀` in the stage `R ⧸ J`, for a weak ideal of definition
`J ⊆ J₀`. -/
abbrev stageNilIdeal (J : WeakIdealsBelow R J₀) : Ideal (R ⧸ (OrderDual.ofDual J.1).1) :=
  J₀.1.map (Ideal.Quotient.mk (OrderDual.ofDual J.1).1)

/-- **The image of `J₀` in a stage `R ⧸ J` below it is nilpotent.** -/
theorem stageNilIdeal_le_nilradical (J : WeakIdealsBelow R J₀) :
    stageNilIdeal J ≤ nilradical (R ⧸ (OrderDual.ofDual J.1).1) :=
  TopologicalRing.map_quotient_le_nilradical_of_isWeakIdealOfDefinition J₀.2
    (OrderDual.ofDual J.1).2.1

/-- A transition of weak ideals of definition below `J₀`, read at the level of ideals: the
target of a morphism of the reverse-inclusion order is the *smaller* ideal. -/
theorem le_of_weakIdealsBelowHom {J K : WeakIdealsBelow R J₀} (g : J ⟶ K) :
    (OrderDual.ofDual K.1).1 ≤ (OrderDual.ofDual J.1).1 :=
  leOfHom g

/-- A transition of weak ideals of definition below `J₀`, as a morphism of all weak ideals of
definition. -/
abbrev weakIdealsBelowMap {J K : WeakIdealsBelow R J₀} (g : J ⟶ K) :
    (J.1 : WeakIdeals R) ⟶ K.1 :=
  homOfLE (leOfHom g)

end Index

variable {𝔅 : BigFppfSite.{u}} {S : Scheme.{u}} {hS : 𝔅.Contains S}
  {R : Type u} [CommRing R] [TopologicalSpace R] (D : QuotientSystem 𝔅 S hS R)
  {V : FppfSheaf 𝔅 S hS} (v : V ⟶ formalSpectrum D)
  (hY : IsAffineFormalAlgebraicSpace 𝔅 S hS (formalSpectrum D))
  (hV : IsAffineFormalAlgebraicSpace 𝔅 S hS V) (hv : IsRepresentableEtale 𝔅 S hS v)
  (J₀ : TopologicalRing.WeakIdealOfDefinitionIndex R)

/-- The stage model `Ā_{J₀}` as an algebra over a *smaller* stage `R ⧸ J`, through the stage
transition `R ⧸ J → R ⧸ J₀`. -/
@[instance_reducible]
noncomputable def algebraStageBaseChangeRingTop (J : WeakIdealsBelow R J₀) :
    Algebra (R ⧸ (OrderDual.ofDual J.1).1)
      (stageBaseChangeRing D v hY hV hv (OrderDual.toDual J₀)) :=
  ((stageBaseChangeRingHom D v hY hV hv (OrderDual.toDual J₀)).comp
    (Ideal.Quotient.factor J.2)).toAlgebra

attribute [local instance] algebraStageBaseChangeRingTop

/-- **The stage models base change along the stage transitions**, in quotient form: `Ā_J`
reduces modulo the image of `J₀` to `Ā_{J₀}`. -/
noncomputable def stageBaseChangeRingReductionEquiv (J : WeakIdealsBelow R J₀) :
    (stageBaseChangeRing D v hY hV hv J.1 ⧸
        (stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
          (stageBaseChangeRing D v hY hV hv J.1)))
      ≃ₐ[R ⧸ (OrderDual.ofDual J.1).1]
        stageBaseChangeRing D v hY hV hv (OrderDual.toDual J₀) := by
  have hsq := isPushout_stageBaseChangeRingHom D v hY hV hv (weakIdealsBelowTransition J)
  refine AlgEquiv.ofRingEquiv
    (f := CommRingCat.quotientEquivOfIsPushout hsq (Ideal.Quotient.factor_ker J.2)
      (Ideal.Quotient.factor_surjective J.2)) fun r => ?_
  exact (CommRingCat.quotientEquivOfIsPushout_mk hsq (Ideal.Quotient.factor_ker J.2)
    (Ideal.Quotient.factor_surjective J.2) _).trans
      (CommRingCat.PushoutQuotient.apply_eq hsq r)

/-- The reduction `A ⧸ JA` of the chosen étale lift `A` modulo a weak ideal of definition
`J ⊆ J₀`. -/
abbrev stageLiftReduction (J : WeakIdealsBelow R J₀) : Type u :=
  stageLiftAlgebra D v hY hV hv J₀ ⧸
    Ideal.map (algebraMap R (stageLiftAlgebra D v hY hV hv J₀)) (OrderDual.ofDual J.1).1

/-- **The reduction of the chosen étale lift at a stage is étale over that stage.** -/
instance etale_stageLiftReduction (J : WeakIdealsBelow R J₀) :
    Algebra.Etale (R ⧸ (OrderDual.ofDual J.1).1) (stageLiftReduction D v hY hV hv J₀ J) :=
  Algebra.Etale.of_equiv
    (tensorQuotientAlgEquiv R (OrderDual.ofDual J.1).1 (stageLiftAlgebra D v hY hV hv J₀))

/-- The ideal of `A ⧸ JA` generated by the image of `J₀ ⧸ J` is the image of `J₀A`. -/
theorem map_stageNilIdeal_stageLiftReduction (J : WeakIdealsBelow R J₀) :
    (stageNilIdeal J).map
        (algebraMap (R ⧸ (OrderDual.ofDual J.1).1) (stageLiftReduction D v hY hV hv J₀ J)) =
      Ideal.map
        (Ideal.Quotient.mk (Ideal.map (algebraMap R (stageLiftAlgebra D v hY hV hv J₀))
          (OrderDual.ofDual J.1).1))
        (Ideal.map (algebraMap R (stageLiftAlgebra D v hY hV hv J₀)) J₀.1) := by
  have h : (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
          (stageLiftReduction D v hY hV hv J₀ J)).comp
        (Ideal.Quotient.mk (OrderDual.ofDual J.1).1) =
      (Ideal.Quotient.mk (Ideal.map (algebraMap R (stageLiftAlgebra D v hY hV hv J₀))
        (OrderDual.ofDual J.1).1)).comp (algebraMap R (stageLiftAlgebra D v hY hV hv J₀)) :=
    RingHom.ext fun _ => rfl
  rw [Ideal.map_map, Ideal.map_map, h]

/-- **The reduction of the chosen étale lift at a stage `J ⊆ J₀` reduces modulo `J₀ ⧸ J` to
`Ā_{J₀}`**: the third isomorphism theorem identifies `(A ⧸ JA) ⧸ (J₀ ⧸ J)(A ⧸ JA)` with
`A ⧸ J₀A`, which is `Ā_{J₀}` by the chosen identification
`AlgebraicGeometry.FormalSpace.stageLiftAlgebraEquiv`. -/
noncomputable def stageLiftReductionEquiv (J : WeakIdealsBelow R J₀) :
    (stageLiftReduction D v hY hV hv J₀ J ⧸
        (stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
          (stageLiftReduction D v hY hV hv J₀ J)))
      ≃ₐ[R ⧸ (OrderDual.ofDual J.1).1]
        stageBaseChangeRing D v hY hV hv (OrderDual.toDual J₀) := by
  refine AlgEquiv.ofRingEquiv
    (f := ((Ideal.quotEquivOfEq (map_stageNilIdeal_stageLiftReduction D v hY hV hv J₀ J)).trans
      (DoubleQuot.quotQuotEquivQuotOfLE (Ideal.map_mono J.2))).trans
        (stageLiftAlgebraEquiv D v hY hV hv J₀)) fun r => ?_
  obtain ⟨r₀, rfl⟩ := Ideal.Quotient.mk_surjective r
  exact congrArg (fun f : (R ⧸ J₀.1) →+* _ => f (Ideal.Quotient.mk J₀.1 r₀))
    (stageLiftAlgebraEquiv_comp_quotientMap D v hY hV hv J₀)

/-- The chosen identification `(A ⧸ JA) ⧸ (J₀ ⧸ J)(A ⧸ JA) ≅ Ā_{J₀}` on the image of an element
of `A`: it is the projection `A → A ⧸ J₀A` followed by the identification
`A ⧸ J₀A ≅ Ā_{J₀}`. -/
theorem stageLiftReductionEquiv_mk_mk (J : WeakIdealsBelow R J₀)
    (z : stageLiftAlgebra D v hY hV hv J₀) :
    stageLiftReductionEquiv D v hY hV hv J₀ J
        (Ideal.Quotient.mk ((stageNilIdeal J).map
            (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
              (stageLiftReduction D v hY hV hv J₀ J)))
          (Ideal.Quotient.mk (Ideal.map (algebraMap R (stageLiftAlgebra D v hY hV hv J₀))
            (OrderDual.ofDual J.1).1) z)) =
      stageLiftAlgebraEquiv D v hY hV hv J₀
        (Ideal.Quotient.mk (Ideal.map (algebraMap R (stageLiftAlgebra D v hY hV hv J₀)) J₀.1)
          z) :=
  rfl

/-- The isomorphism of the reductions of `A ⧸ JA` and `Ā_J` modulo the nilpotent ideal
`J₀ ⧸ J`, both being `Ā_{J₀}`. -/
noncomputable def stageComparisonReduction (J : WeakIdealsBelow R J₀) :
    (stageLiftReduction D v hY hV hv J₀ J ⧸
        (stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
          (stageLiftReduction D v hY hV hv J₀ J)))
      ≃ₐ[R ⧸ (OrderDual.ofDual J.1).1]
        (stageBaseChangeRing D v hY hV hv J.1 ⧸
          (stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
            (stageBaseChangeRing D v hY hV hv J.1))) :=
  (stageLiftReductionEquiv D v hY hV hv J₀ J).trans
    (stageBaseChangeRingReductionEquiv D v hY hV hv J₀ J).symm

/-- **The comparison `φ_J : A ⧸ JA ≅ Ā_J` of the quotients of the chosen étale lift with the
stage models**, for a weak ideal of definition `J ⊆ J₀`: the unique isomorphism of
`R ⧸ J`-algebras whose reduction modulo the nilpotent ideal `J₀ ⧸ J` is
`AlgebraicGeometry.FormalSpace.stageComparisonReduction`. -/
noncomputable def stageComparison (J : WeakIdealsBelow R J₀) :
    stageLiftReduction D v hY hV hv J₀ J ≃ₐ[R ⧸ (OrderDual.ofDual J.1).1]
      stageBaseChangeRing D v hY hV hv J.1 :=
  (Algebra.Etale.existsUnique_algEquiv_of_le_nilradical (stageNilIdeal J)
    (stageNilIdeal_le_nilradical J) (stageComparisonReduction D v hY hV hv J₀ J)).choose

/-- The comparison `φ_J` reduces to the chosen identification of the reductions. -/
theorem stageComparison_spec (J : WeakIdealsBelow R J₀) :
    (Ideal.Quotient.mkₐ (R ⧸ (OrderDual.ofDual J.1).1)
          ((stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
            (stageBaseChangeRing D v hY hV hv J.1)))).comp
        (stageComparison D v hY hV hv J₀ J :
          stageLiftReduction D v hY hV hv J₀ J →ₐ[R ⧸ (OrderDual.ofDual J.1).1]
            stageBaseChangeRing D v hY hV hv J.1) =
      (stageComparisonReduction D v hY hV hv J₀ J :
          _ →ₐ[R ⧸ (OrderDual.ofDual J.1).1] _).comp
        (Ideal.Quotient.mkₐ (R ⧸ (OrderDual.ofDual J.1).1)
          ((stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
            (stageLiftReduction D v hY hV hv J₀ J)))) :=
  (Algebra.Etale.existsUnique_algEquiv_of_le_nilradical (stageNilIdeal J)
    (stageNilIdeal_le_nilradical J) (stageComparisonReduction D v hY hV hv J₀ J)).choose_spec.1

/-- **The comparison `φ_J` is the only isomorphism reducing to the chosen identification.** -/
theorem stageComparison_unique (J : WeakIdealsBelow R J₀)
    (χ : stageLiftReduction D v hY hV hv J₀ J ≃ₐ[R ⧸ (OrderDual.ofDual J.1).1]
      stageBaseChangeRing D v hY hV hv J.1)
    (hχ : (Ideal.Quotient.mkₐ (R ⧸ (OrderDual.ofDual J.1).1)
            ((stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
              (stageBaseChangeRing D v hY hV hv J.1)))).comp
          (χ : stageLiftReduction D v hY hV hv J₀ J →ₐ[R ⧸ (OrderDual.ofDual J.1).1]
            stageBaseChangeRing D v hY hV hv J.1) =
        (stageComparisonReduction D v hY hV hv J₀ J :
            _ →ₐ[R ⧸ (OrderDual.ofDual J.1).1] _).comp
          (Ideal.Quotient.mkₐ (R ⧸ (OrderDual.ofDual J.1).1)
            ((stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
              (stageLiftReduction D v hY hV hv J₀ J))))) :
    χ = stageComparison D v hY hV hv J₀ J :=
  (Algebra.Etale.existsUnique_algEquiv_of_le_nilradical (stageNilIdeal J)
    (stageNilIdeal_le_nilradical J)
    (stageComparisonReduction D v hY hV hv J₀ J)).choose_spec.2 χ hχ


/-- The reduction `A ⧸ KA → A ⧸ JA` along a transition `J ⟶ K`, for `K ⊆ J ⊆ J₀`. -/
noncomputable abbrev stageLiftReductionMap {J K : WeakIdealsBelow R J₀} (g : J ⟶ K) :
    stageLiftReduction D v hY hV hv J₀ K →+* stageLiftReduction D v hY hV hv J₀ J :=
  Ideal.Quotient.factor (Ideal.map_mono (le_of_weakIdealsBelowHom g))

/-- The transition `Ā_K → Ā_J` of the chosen stage models along a transition `J ⟶ K`. -/
noncomputable abbrev stageBaseChangeRingMap {J K : WeakIdealsBelow R J₀} (g : J ⟶ K) :
    stageBaseChangeRing D v hY hV hv K.1 →+* stageBaseChangeRing D v hY hV hv J.1 :=
  ((BigFppfOver.toScheme 𝔅 S hS).map
    (stageBaseChangeModelMap D v hY hV hv (weakIdealsBelowMap g))).appTop.hom

/-- **The transitions of the chosen stage models compose**, on global sections. -/
theorem appTop_stageBaseChangeModelMap_comp {I J K : WeakIdeals R} (g : I ⟶ J) (h : J ⟶ K) :
    ((BigFppfOver.toScheme 𝔅 S hS).map (stageBaseChangeModelMap D v hY hV hv h)).appTop ≫
        ((BigFppfOver.toScheme 𝔅 S hS).map (stageBaseChangeModelMap D v hY hV hv g)).appTop =
      ((BigFppfOver.toScheme 𝔅 S hS).map
        (stageBaseChangeModelMap D v hY hV hv (g ≫ h))).appTop := by
  have hmap : stageBaseChangeModelMap D v hY hV hv g ≫ stageBaseChangeModelMap D v hY hV hv h =
      stageBaseChangeModelMap D v hY hV hv (g ≫ h) :=
    ((stageBaseChangeModelDiagram D v hY hV hv).map_comp g h).symm
  rw [← Scheme.Hom.comp_appTop, ← Functor.map_comp, hmap]

/-- **The identifications `Ā_J ⧸ (J₀ ⧸ J)Ā_J ≅ Ā_{J₀}` are compatible with the stage
transitions.** -/
theorem stageBaseChangeRingReductionEquiv_naturality {J K : WeakIdealsBelow R J₀} (g : J ⟶ K)
    (a : stageBaseChangeRing D v hY hV hv K.1) :
    stageBaseChangeRingReductionEquiv D v hY hV hv J₀ J
        (Ideal.Quotient.mk ((stageNilIdeal J).map
          (algebraMap (R ⧸ (OrderDual.ofDual J.1).1) (stageBaseChangeRing D v hY hV hv J.1)))
          (stageBaseChangeRingMap D v hY hV hv J₀ g a)) =
      stageBaseChangeRingReductionEquiv D v hY hV hv J₀ K
        (Ideal.Quotient.mk ((stageNilIdeal K).map
          (algebraMap (R ⧸ (OrderDual.ofDual K.1).1) (stageBaseChangeRing D v hY hV hv K.1)))
          a) := by
  have hfun := appTop_stageBaseChangeModelMap_comp D v hY hV hv
    (weakIdealsBelowTransition J) (weakIdealsBelowMap g)
  have hid : weakIdealsBelowTransition J ≫ weakIdealsBelowMap g = weakIdealsBelowTransition K :=
    Subsingleton.elim _ _
  rw [hid] at hfun
  exact ConcreteCategory.congr_hom hfun a

/-- The comparison `φ_J` identified on reductions: applying the chosen identification
`Ā_J ⧸ (J₀ ⧸ J)Ā_J ≅ Ā_{J₀}` to the reduction of `φ_J` gives the chosen identification
`(A ⧸ JA) ⧸ (J₀ ⧸ J)(A ⧸ JA) ≅ Ā_{J₀}`. -/
theorem stageBaseChangeRingReductionEquiv_mk_stageComparison (J : WeakIdealsBelow R J₀)
    (y : stageLiftReduction D v hY hV hv J₀ J) :
    stageBaseChangeRingReductionEquiv D v hY hV hv J₀ J
        (Ideal.Quotient.mk ((stageNilIdeal J).map
          (algebraMap (R ⧸ (OrderDual.ofDual J.1).1) (stageBaseChangeRing D v hY hV hv J.1)))
          (stageComparison D v hY hV hv J₀ J y)) =
      stageLiftReductionEquiv D v hY hV hv J₀ J
        (Ideal.Quotient.mk ((stageNilIdeal J).map
          (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
            (stageLiftReduction D v hY hV hv J₀ J))) y) := by
  have h := AlgHom.congr_fun (stageComparison_spec D v hY hV hv J₀ J) y
  rw [show (Ideal.Quotient.mk ((stageNilIdeal J).map
        (algebraMap (R ⧸ (OrderDual.ofDual J.1).1) (stageBaseChangeRing D v hY hV hv J.1))))
      (stageComparison D v hY hV hv J₀ J y) =
      stageComparisonReduction D v hY hV hv J₀ J
        (Ideal.Quotient.mk ((stageNilIdeal J).map
          (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
            (stageLiftReduction D v hY hV hv J₀ J))) y) from h]
  exact (stageBaseChangeRingReductionEquiv D v hY hV hv J₀ J).apply_symm_apply _

/-- **The identifications `(A ⧸ JA) ⧸ (J₀ ⧸ J)(A ⧸ JA) ≅ Ā_{J₀}` are compatible with the stage
transitions.** -/
theorem stageLiftReductionEquiv_naturality {J K : WeakIdealsBelow R J₀} (g : J ⟶ K)
    (a : stageLiftReduction D v hY hV hv J₀ K) :
    stageLiftReductionEquiv D v hY hV hv J₀ J
        (Ideal.Quotient.mk ((stageNilIdeal J).map
          (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
            (stageLiftReduction D v hY hV hv J₀ J)))
          (stageLiftReductionMap D v hY hV hv J₀ g a)) =
      stageLiftReductionEquiv D v hY hV hv J₀ K
        (Ideal.Quotient.mk ((stageNilIdeal K).map
          (algebraMap (R ⧸ (OrderDual.ofDual K.1).1)
            (stageLiftReduction D v hY hV hv J₀ K))) a) := by
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective a
  exact (stageLiftReductionEquiv_mk_mk D v hY hV hv J₀ J z).trans
    (stageLiftReductionEquiv_mk_mk D v hY hV hv J₀ K z).symm

/-- **The comparison family `φ_J` is compatible with the stage transitions.** For a transition
`J ⟶ K` of weak ideals of definition below `J₀` the square

```
A ⧸ KA  --φ_K-->  Ā_K
  |                 |
  v                 v
A ⧸ JA  --φ_J-->  Ā_J
```

commutes. -/
theorem stageComparison_naturality {J K : WeakIdealsBelow R J₀} (g : J ⟶ K) :
    (stageBaseChangeRingMap D v hY hV hv J₀ g).comp
        (stageComparison D v hY hV hv J₀ K : stageLiftReduction D v hY hV hv J₀ K →+*
          stageBaseChangeRing D v hY hV hv K.1) =
      (stageComparison D v hY hV hv J₀ J : stageLiftReduction D v hY hV hv J₀ J →+*
          stageBaseChangeRing D v hY hV hv J.1).comp
        (stageLiftReductionMap D v hY hV hv J₀ g) := by
  have hsq := isPushout_stageBaseChangeRingHom D v hY hV hv (weakIdealsBelowMap g)
  let instT : Algebra (R ⧸ (OrderDual.ofDual K.1).1) (stageBaseChangeRing D v hY hV hv J.1) :=
    ((stageBaseChangeRingHom D v hY hV hv J.1).comp
      (Ideal.Quotient.factor (le_of_weakIdealsBelowHom g))).toAlgebra
  have hnil : ((stageNilIdeal J).map (algebraMap (R ⧸ (OrderDual.ofDual J.1).1)
      (stageBaseChangeRing D v hY hV hv J.1))).IsLocallyNilpotent := fun x hx =>
    Ideal.IsLocallyNilpotent0544.map _ _
      (fun _ hy => mem_nilradical.mp (stageNilIdeal_le_nilradical J hy)) x hx
  let f₁ : stageLiftReduction D v hY hV hv J₀ K →ₐ[R ⧸ (OrderDual.ofDual K.1).1]
      stageBaseChangeRing D v hY hV hv J.1 :=
    { toRingHom := (stageBaseChangeRingMap D v hY hV hv J₀ g).comp
        (stageComparison D v hY hV hv J₀ K : _ →+* _)
      commutes' := fun r => by
        change stageBaseChangeRingMap D v hY hV hv J₀ g
            ((stageComparison D v hY hV hv J₀ K) (algebraMap _ _ r)) = _
        rw [AlgEquiv.commutes]
        exact CommRingCat.PushoutQuotient.apply_eq hsq r }
  let f₂ : stageLiftReduction D v hY hV hv J₀ K →ₐ[R ⧸ (OrderDual.ofDual K.1).1]
      stageBaseChangeRing D v hY hV hv J.1 :=
    { toRingHom := (stageComparison D v hY hV hv J₀ J : _ →+* _).comp
        (stageLiftReductionMap D v hY hV hv J₀ g)
      commutes' := fun r => by
        obtain ⟨r₀, rfl⟩ := Ideal.Quotient.mk_surjective r
        exact (stageComparison D v hY hV hv J₀ J).commutes
          (Ideal.Quotient.mk (OrderDual.ofDual J.1).1 r₀) }
  have hf : f₁ = f₂ := by
    refine AlgHom.ext_of_isLocallyNilpotent hnil (AlgHom.ext fun y => ?_)
    change Ideal.Quotient.mk _ (stageBaseChangeRingMap D v hY hV hv J₀ g
        ((stageComparison D v hY hV hv J₀ K) y)) =
      Ideal.Quotient.mk _ ((stageComparison D v hY hV hv J₀ J)
        (stageLiftReductionMap D v hY hV hv J₀ g y))
    refine (stageBaseChangeRingReductionEquiv D v hY hV hv J₀ J).injective ?_
    rw [stageBaseChangeRingReductionEquiv_naturality,
      stageBaseChangeRingReductionEquiv_mk_stageComparison,
      stageBaseChangeRingReductionEquiv_mk_stageComparison,
      stageLiftReductionEquiv_naturality]
  exact congrArg AlgHom.toRingHom hf

end AlgebraicGeometry.FormalSpace

