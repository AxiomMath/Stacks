/-!
# Finite type algebra systems from cartesian diagrams

Let `J` be an ideal basis of a topological ring `A`. An inverse system of rings over the quotients
`A ⧸ J.ideal i`, with finite type structure maps and transition squares that become cartesian after
`Spec`, is a `FiniteTypeAlgebraSystem`; likewise a diagram of affine schemes over the spectra of
these quotients, with locally of finite type structure morphisms and cartesian transition squares,
is the diagram of spectra of a `FiniteTypeAlgebraSystem`.

## Main definitions

* `FiniteTypeAlgebraSystem.ofCartesianSpecDiagram`: The algebra system of an inverse system of
  finite type algebras whose transition squares are cartesian after `Spec`.
* `FiniteTypeAlgebraSystem.ofAffineSchemeDiagram`: The algebra system of global sections of a
  cartesian diagram of affine schemes locally of finite type over the quotients.

## Main results

* `FiniteTypeAlgebraSystem.transition_surjective_and_ker_of_isPullback_spec`: If a transition
  square is cartesian after `Spec`, the transition map is surjective with kernel generated by the
  kernel of the corresponding map of quotients.
* `FiniteTypeAlgebraSystem.specMap_algebraMap_ofAffineSchemeDiagram`: The spectrum of each
  structure map of `ofAffineSchemeDiagram` is the given structure morphism, up to `isoSpec`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.FormalSpace

open CartesianColimit

universe u v w

namespace FiniteTypeAlgebraSystem

attribute [local instance] bigFppfOver_subcanonical

attribute [local instance] Sheaf.sheafifiedYoneda_full Sheaf.sheafifiedYoneda_faithful

attribute [local instance] idealBasisFunctor_final

/-- The transition maps of an inverse system of rings over the quotients of an ideal basis whose
transition squares become cartesian after `Spec` are surjective, with kernel generated by the
kernel of the transition map of the quotients. -/
theorem transition_surjective_and_ker_of_isPullback_spec
    {A : Type u} [CommRing A] [TopologicalSpace A]
    {I : Type v} [Preorder I] (J : IdealBasis A I)
    (R : Iᵒᵖ ⥤ CommRingCat.{u})
    (a : ∀ i, A ⧸ J.ideal i →+* R.obj (Opposite.op i))
    {i j : I} (h : i ≤ j)
    (hcart : IsPullback (Spec.map (CommRingCat.ofHom (a i)))
        (Spec.map (R.map (homOfLE h).op))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (J.antitone h))))
        (Spec.map (CommRingCat.ofHom (a j)))) :
    Function.Surjective (R.map (homOfLE h).op).hom ∧
      RingHom.ker (R.map (homOfLE h).op).hom =
        (RingHom.ker (CommRingCat.ofHom (Ideal.Quotient.factor (J.antitone h))).hom).map
          (CommRingCat.ofHom (a j)).hom := by
  have hcart' : IsPullback (R.map (homOfLE h).op).op
      (CommRingCat.ofHom (a i)).op (CommRingCat.ofHom (a j)).op
      (CommRingCat.ofHom (Ideal.Quotient.factor (J.antitone h))).op :=
    IsPullback.of_map_of_faithful Scheme.Spec hcart.flip
  exact surjective_and_ker_eq_of_isPushout hcart'.unop (by
    intro x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨Ideal.Quotient.mk _ b, Ideal.Quotient.factor_mk (J.antitone h) b⟩)

/-- The `FiniteTypeAlgebraSystem` given by an inverse system of rings over the quotients of an
ideal basis whose structure maps are of finite type and whose transition squares become
cartesian after `Spec`. -/
noncomputable def ofCartesianSpecDiagram
    {A : Type u} [CommRing A] [TopologicalSpace A]
    {I : Type v} [Preorder I] (J : IdealBasis A I)
    (R : Iᵒᵖ ⥤ CommRingCat.{u})
    (a : ∀ i, A ⧸ J.ideal i →+* R.obj (Opposite.op i))
    (hft : ∀ i, (a i).FiniteType)
    (hcart : ∀ ⦃i j : I⦄ (h : i ≤ j),
      IsPullback (Spec.map (CommRingCat.ofHom (a i)))
        (Spec.map (R.map (homOfLE h).op))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (J.antitone h))))
        (Spec.map (CommRingCat.ofHom (a j)))) :
    FiniteTypeAlgebraSystem A I J where
  B := R
  algebraMap := a
  finiteType := hft
  compatible := fun {i j} h => congrArg CommRingCat.Hom.hom
    ((IsPullback.of_map_of_faithful Scheme.Spec (hcart h).flip).unop.w.symm)
  transition_surjective := fun {i j} h =>
    (transition_surjective_and_ker_of_isPullback_spec J R a h (hcart h)).1
  transition_ker := fun {i j} h => by
    simpa only [CommRingCat.hom_ofHom, Ideal.Quotient.factor_ker, Ideal.map_map]
      using (transition_surjective_and_ker_of_isPullback_spec J R a h (hcart h)).2

/-- The `FiniteTypeAlgebraSystem` of global sections of a diagram of affine schemes over the
spectra of the quotients of an ideal basis, with locally of finite type structure morphisms and
cartesian transition squares. -/
noncomputable def ofAffineSchemeDiagram
    {A : Type u} [CommRing A] [TopologicalSpace A]
    {I : Type v} [Preorder I] (J : IdealBasis A I)
    (D : I ⥤ Scheme.{u}) (hD : ∀ i, IsAffine (D.obj i))
    (a : ∀ i, D.obj i ⟶ Spec (CommRingCat.of (A ⧸ J.ideal i)))
    (hft : ∀ i, LocallyOfFiniteType (a i))
    (hcart : ∀ ⦃i j : I⦄ (h : i ≤ j),
      IsPullback (a i) (D.map (homOfLE h))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (J.antitone h)))) (a j)) :
    FiniteTypeAlgebraSystem A I J := by
  letI : ∀ i, IsAffine (D.obj i) := hD
  let R := D.op ⋙ Scheme.Γ
  let b (i : I) : A ⧸ J.ideal i →+* R.obj (Opposite.op i) :=
    (Scheme.Spec.preimage ((D.obj i).isoSpec.inv ≫ a i)).unop.hom
  have hb (i : I) : Spec.map (CommRingCat.ofHom (b i)) =
      (D.obj i).isoSpec.inv ≫ a i :=
    Scheme.Spec.map_preimage _
  have ht {i j : I} (g : i ⟶ j) : Spec.map (R.map g.op) =
      (D.obj i).isoSpec.inv ≫ D.map g ≫ (D.obj j).isoSpec.hom := by
    change Spec.map (D.map g).appTop = _
    have h := congrArg (fun k => (D.obj i).isoSpec.inv ≫ k)
      (Scheme.toSpecΓ_naturality (D.map g))
    simpa only [Category.assoc, ← Scheme.isoSpec_hom, Iso.inv_hom_id_assoc] using h.symm
  refine ofCartesianSpecDiagram J R b (fun i => ?_) (fun {i j} h => ?_)
  · have : LocallyOfFiniteType (a i) := hft i
    apply (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType.{u})
      (φ := CommRingCat.ofHom (b i))).mp
    have hfi : LocallyOfFiniteType ((D.obj i).isoSpec.inv ≫ a i) := inferInstance
    rw [hb]
    exact hfi
  · apply (hcart h).of_iso (D.obj i).isoSpec (Iso.refl _)
      (D.obj j).isoSpec (Iso.refl _)
    · rw [hb]
      simp
    · rw [ht]
      simp
    · simp
    · rw [hb]
      simp

/-- The structure homomorphism of the algebra system recovered from a cartesian diagram of
affine finite type schemes is the one the affine anti-equivalence attaches to the structure
morphism of the diagram. -/
theorem specMap_algebraMap_ofAffineSchemeDiagram
    {A : Type u} [CommRing A] [TopologicalSpace A]
    {I : Type v} [Preorder I] (J : IdealBasis A I)
    (D : I ⥤ Scheme.{u}) (hD : ∀ i, IsAffine (D.obj i))
    (a : ∀ i, D.obj i ⟶ Spec (CommRingCat.of (A ⧸ J.ideal i)))
    (hft : ∀ i, LocallyOfFiniteType (a i))
    (hcart : ∀ ⦃i j : I⦄ (h : i ≤ j),
      IsPullback (a i) (D.map (homOfLE h))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (J.antitone h)))) (a j))
    (i : I) :
    letI := hD i
    Spec.map (CommRingCat.ofHom ((ofAffineSchemeDiagram J D hD a hft hcart).algebraMap i)) =
      (D.obj i).isoSpec.inv ≫ a i :=
  Scheme.Spec.map_preimage _

end FiniteTypeAlgebraSystem

