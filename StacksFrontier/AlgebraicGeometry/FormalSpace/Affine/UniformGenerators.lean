module

public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Ideal.Quotient.PowTransition
public import Mathlib.Topology.Algebra.TopologicallyNilpotent
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.FormalSpace.Affine.FiniteTypeClassification
public import StacksFrontier.RingTheory.Nilpotent.Descent

/-!
# A uniform generator bound for an inverse system of finite type algebras

Let `A` be a weakly admissible topological ring and let `(I_λ)` be a fundamental system of weak
ideals of definition of `A`, so that `X = Spf(A)` is a McQuillan affine formal algebraic space.
A morphism `f : Y → X` of affine formal algebraic spaces which is of finite type presents `Y` as
`colim Spec(B_λ)` for an inverse system `(B_λ)` of finite type `A / I_λ`-algebras whose
transitions induce isomorphisms `B_μ / I_λ B_μ ≅ B_λ`; that is Stacks 0AL1, and such a system is
an object of `AlgebraicGeometry.FormalSpace.FiniteTypeAlgebraSystem`.

Each `B_λ` is then of finite type over `A / I_λ`, so each is generated by *some* finite number of
elements. This file proves the sharper statement that the number of generators can be chosen
**uniformly**: there is a single integer `r`, independent of `λ`, such that every `B_λ` is
generated by `r` elements over `A / I_λ`. This is the assertion made in part (3) of Stacks 0AJK,
whose proof the source locates in the argument for (1) ⟹ (2) of Stacks 0ANT.

The bound propagates in both directions along the index. Downwards it is the quotient map: if
`B_μ` is generated by `r` elements and `I_μ ⊆ I_λ`, then `B_λ = B_μ / I_λ B_μ` is generated by
the images of those elements. Upwards it is descent of surjectivity along a locally nilpotent
ideal, Stacks 07RD: the ideal `I_λ` becomes locally nilpotent in `A / I_μ` because a weak ideal
of definition consists of topologically nilpotent elements and `I_μ` is open, so a family of `r`
elements of `B_μ` generating `B_μ / I_λ B_μ` already generates `B_μ`. Fixing one index `i₀` to
supply `r` and comparing an arbitrary index with it through a common upper bound gives the
uniform statement.

## Main definitions

* `AlgebraicGeometry.FormalSpace.FiniteTypeAlgebraSystem.GeneratedBy`: the `i`-th member of a
  finite type algebra system is generated by `r` elements over `A / I_i`, expressed as the
  existence of a surjection onto it from the polynomial ring in `r` variables which restricts
  to the structure homomorphism on constants.

## Main results

* `AlgebraicGeometry.FormalSpace.FiniteTypeAlgebraSystem.exists_uniform_generatedBy`: a single
  `r` works for every member of the system. This is the assertion of part (3) of Stacks 0AJK.

## What part (3) of Stacks 0AJK leaves open

Part (3) of the remark pairs the assertion proved here with a question, which is *not*
formalized anywhere: the projections `lim B_λ → B_λ` are not known to be surjective, so `Y` is
not known to be McQuillan, and the source asks whether there is an example in which `Y` fails to
be McQuillan. A question is not a statement, and nothing here answers it or asserts that it has
an answer.

## References

* [Stacks Project, Tag 0AJK](https://stacks.math.columbia.edu/tag/0AJK)
* [Stacks Project, Tag 0AL1](https://stacks.math.columbia.edu/tag/0AL1)
* [Stacks Project, Tag 0ANT](https://stacks.math.columbia.edu/tag/0ANT)
* [Stacks Project, Tag 07RD](https://stacks.math.columbia.edu/tag/07RD)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.FormalSpace

universe u v

variable {A : Type u} [CommRing A] [TopologicalSpace A]
  {I : Type v} [Preorder I] {J : IdealBasis A I}

/-- The `i`-th member of a finite type algebra system is *generated by `r` elements* over
`A / J.ideal i` when there is a surjection onto it from the polynomial ring in `r` variables
over `A / J.ideal i` which restricts to the structure homomorphism on the constants. -/
def FiniteTypeAlgebraSystem.GeneratedBy (P : FiniteTypeAlgebraSystem A I J) (r : ℕ) (i : I) :
    Prop :=
  ∃ g : MvPolynomial (Fin r) (A ⧸ J.ideal i) →+* P.B.obj (Opposite.op i),
    g.comp MvPolynomial.C = P.algebraMap i ∧ Function.Surjective g

namespace FiniteTypeAlgebraSystem

/-- A weak ideal of definition becomes locally nilpotent modulo any open ideal: its elements are
topologically nilpotent, so a high enough power of each lands in the open ideal. -/
@[ega "0 7.1.3" "(i)"]
private theorem isLocallyNilpotent_map_mk {K L : Ideal A}
    (hK : ∀ x ∈ K, IsTopologicallyNilpotent x) (hL : IsOpen (L : Set A)) :
    (K.map (Ideal.Quotient.mk L)).IsLocallyNilpotent := by
  intro y hy
  obtain ⟨x, hx, rfl⟩ :=
    Ideal.mem_image_of_mem_map_of_surjective _ Ideal.Quotient.mk_surjective hy
  have hmem : (L : Set A) ∈ nhds (0 : A) := hL.mem_nhds L.zero_mem
  obtain ⟨n, hn⟩ := (hK x hx).exists_pow_mem_of_mem_nhds hmem
  exact ⟨n, by
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hn⟩

/-- An algebra map out of a polynomial ring restricts on constants to the structure map. -/
private theorem comp_C_eq_algebraMap {R S σ : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (g : MvPolynomial σ R →ₐ[R] S) : g.toRingHom.comp MvPolynomial.C = Algebra.algebraMap R S := by
  ext a
  simp

/-- The square formed by two presentations of consecutive members of a finite type algebra system
and the transition map commutes as soon as it commutes on the variables. -/
private theorem comp_map_eq_transition_comp (P : FiniteTypeAlgebraSystem A I J) {r : ℕ} {i k : I}
    (h : i ≤ k) {f : MvPolynomial (Fin r) (A ⧸ J.ideal k) →+* P.B.obj (Opposite.op k)}
    {g : MvPolynomial (Fin r) (A ⧸ J.ideal i) →+* P.B.obj (Opposite.op i)}
    (hf : f.comp MvPolynomial.C = P.algebraMap k) (hg : g.comp MvPolynomial.C = P.algebraMap i)
    (hX : ∀ j, g (MvPolynomial.X j) = (P.B.map (homOfLE h).op).hom (f (MvPolynomial.X j))) :
    g.comp (MvPolynomial.map (Ideal.Quotient.factor (J.antitone h))) =
      (P.B.map (homOfLE h).op).hom.comp f := by
  refine MvPolynomial.ringHom_ext (fun a => ?_) (fun j => ?_)
  · have h1 := DFunLike.congr_fun hf a
    have h2 := DFunLike.congr_fun hg (Ideal.Quotient.factor (J.antitone h) a)
    simp only [RingHom.comp_apply, MvPolynomial.map_C] at h1 h2 ⊢
    rw [h1, h2]
    exact (DFunLike.congr_fun (P.compatible h) a).symm
  · simpa using hX j

/-- Descent of the generator bound to a finer index. If `i₀ ≤ k`, so that `J.ideal k ⊆
J.ideal i₀` and `B_k / (J.ideal i₀) B_k = B_{i₀}`, then `r` generators of `B_{i₀}` lift to `r`
generators of `B_k`: the lifts generate modulo a locally nilpotent ideal, hence generate, by
Stacks 07RD. -/
private theorem generatedBy_of_le_source (P : FiniteTypeAlgebraSystem A I J) {r : ℕ} {i₀ k : I}
    (h : i₀ ≤ k) (hi₀ : P.GeneratedBy r i₀) : P.GeneratedBy r k := by
  classical
  obtain ⟨g₀, hg₀C, hg₀surj⟩ := hi₀
  let : Algebra (A ⧸ J.ideal k) (P.B.obj (Opposite.op k)) := (P.algebraMap k).toAlgebra
  -- the transition homomorphism `B_k → B_{i₀}` and the reduction `A / I_k → A / I_{i₀}`
  set t : P.B.obj (Opposite.op k) →+* P.B.obj (Opposite.op i₀) :=
    (P.B.map (homOfLE h).op).hom with ht
  have htsurj : Function.Surjective t := P.transition_surjective h
  set π : A ⧸ J.ideal k →+* A ⧸ J.ideal i₀ := Ideal.Quotient.factor (J.antitone h) with hπ
  have hπsurj : Function.Surjective π := by
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨Ideal.Quotient.mk _ a, rfl⟩
  -- lift the chosen generators of `B_{i₀}` through the transition
  have hlift : ∀ j : Fin r, ∃ b : P.B.obj (Opposite.op k), t b = g₀ (MvPolynomial.X j) :=
    fun j => htsurj _
  choose b hb using hlift
  set g : MvPolynomial (Fin r) (A ⧸ J.ideal k) →ₐ[A ⧸ J.ideal k] P.B.obj (Opposite.op k) :=
    MvPolynomial.aeval b with hg
  have hgC : g.toRingHom.comp MvPolynomial.C = P.algebraMap k := comp_C_eq_algebraMap g
  -- the square `t ∘ g = g₀ ∘ map π` commutes, so `t ∘ g` is surjective
  have hsquare : t.comp g.toRingHom = g₀.comp (MvPolynomial.map π) :=
    (comp_map_eq_transition_comp P h hgC hg₀C fun j => by simpa [hg] using (hb j).symm).symm
  have htgsurj : Function.Surjective (t.comp g.toRingHom) := by
    rw [hsquare]
    exact hg₀surj.comp (MvPolynomial.map_surjective π hπsurj)
  -- the extended ideal is the kernel of the transition
  set Kloc : Ideal (A ⧸ J.ideal k) := (J.ideal i₀).map (Ideal.Quotient.mk (J.ideal k)) with hKloc
  have hKlocnil : Kloc.IsLocallyNilpotent :=
    isLocallyNilpotent_map_mk (J.weak i₀).2 (J.weak k).1
  have hext : extendedIdeal Kloc (P.B.obj (Opposite.op k)) = RingHom.ker t := by
    rw [P.transition_ker h, extendedIdeal, hKloc, Ideal.map_map, RingHom.algebraMap_toAlgebra]
  -- surjectivity modulo that ideal, from surjectivity of `t ∘ g`
  have hmod : Function.Surjective
      ((Ideal.Quotient.mk (extendedIdeal Kloc (P.B.obj (Opposite.op k)))).comp g.toRingHom) := by
    intro y
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p, hp⟩ := htgsurj (t c)
    refine ⟨p, ?_⟩
    have : g p - c ∈ extendedIdeal Kloc (P.B.obj (Opposite.op k)) := by
      rw [hext, RingHom.mem_ker, map_sub, sub_eq_zero]
      exact hp
    simpa using (Ideal.Quotient.eq.mpr this)
  have hft : Algebra.FiniteType (A ⧸ J.ideal k) (P.B.obj (Opposite.op k)) := P.finiteType k
  exact ⟨g.toRingHom, hgC,
    surjective_of_surjective_mod_locallyNilpotent Kloc hKlocnil g hmod hft⟩

/-- Transport of the generator bound to a coarser index. If `i ≤ k` then `B_i` is a quotient of
`B_k`, so the images of `r` generators of `B_k` generate `B_i`. -/
private theorem generatedBy_of_le_target (P : FiniteTypeAlgebraSystem A I J) {r : ℕ} {i k : I}
    (h : i ≤ k) (hk : P.GeneratedBy r k) : P.GeneratedBy r i := by
  classical
  obtain ⟨gk, hgkC, hgksurj⟩ := hk
  let : Algebra (A ⧸ J.ideal i) (P.B.obj (Opposite.op i)) := (P.algebraMap i).toAlgebra
  set u : P.B.obj (Opposite.op k) →+* P.B.obj (Opposite.op i) :=
    (P.B.map (homOfLE h).op).hom with hu
  have husurj : Function.Surjective u := P.transition_surjective h
  set π : A ⧸ J.ideal k →+* A ⧸ J.ideal i := Ideal.Quotient.factor (J.antitone h) with hπ
  set g : MvPolynomial (Fin r) (A ⧸ J.ideal i) →ₐ[A ⧸ J.ideal i] P.B.obj (Opposite.op i) :=
    MvPolynomial.aeval (fun j => u (gk (MvPolynomial.X j))) with hg
  have hgC : g.toRingHom.comp MvPolynomial.C = P.algebraMap i := comp_C_eq_algebraMap g
  have hsquare : g.toRingHom.comp (MvPolynomial.map π) = u.comp gk :=
    comp_map_eq_transition_comp P h hgkC hgC fun j => by simp [hg, hu]
  have : Function.Surjective (g.toRingHom.comp (MvPolynomial.map π)) := by
    rw [hsquare]
    exact husurj.comp hgksurj
  exact ⟨g.toRingHom, hgC, Function.Surjective.of_comp this⟩

/-- **Stacks 0AJK, part (3): the uniform generator bound.** For an inverse system `(B_λ)` of
finite type algebras over the quotients of `A` by a fundamental system of weak ideals of
definition — the system Stacks 0AL1 attaches to a finite type morphism `Y → Spf(A)` of affine
formal algebraic spaces — there is a single integer `r`, independent of `λ`, such that `B_λ` is
generated by `r` elements over `A / I_λ` for every `λ`.

The index `r` is produced from one member of the system, chosen using nonemptiness of the index,
and transported to an arbitrary member through a common upper bound. -/
@[stacks 0AJK "part (3), the asserted sentence: for the inverse system `(B_λ)` of finite type \
`A / I_λ`-algebras that Stacks 0AL1 attaches to a finite type morphism `Y → X = Spf(A)` of \
affine formal algebraic spaces, there is a fixed integer `r` such that `B_λ` is generated by \
`r` elements over `A / I_λ` for all `λ`. The clause of part (3) citing Stacks 0AL1 for the \
presentation `Y = colim Spec(B_λ)` is covered by the anti-equivalence itself; the question \
part (3) goes on to ask, whether there is an example in which `Y` is not McQuillan, is a \
question and is not asserted anywhere."]
theorem exists_uniform_generatedBy [Nonempty I] [IsDirected I (· ≤ ·)]
    (P : FiniteTypeAlgebraSystem A I J) :
    ∃ r : ℕ, ∀ i : I, P.GeneratedBy r i := by
  classical
  obtain ⟨i₀⟩ := ‹Nonempty I›
  let : Algebra (A ⧸ J.ideal i₀) (P.B.obj (Opposite.op i₀)) := (P.algebraMap i₀).toAlgebra
  have hft : Algebra.FiniteType (A ⧸ J.ideal i₀) (P.B.obj (Opposite.op i₀)) := P.finiteType i₀
  obtain ⟨r, g₀, hg₀surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
  have hg₀C : g₀.toRingHom.comp MvPolynomial.C = P.algebraMap i₀ := comp_C_eq_algebraMap g₀
  have hbase : P.GeneratedBy r i₀ := ⟨g₀.toRingHom, hg₀C, hg₀surj⟩
  refine ⟨r, fun i => ?_⟩
  obtain ⟨k, hik, hi₀k⟩ := directed_of (· ≤ ·) i i₀
  exact generatedBy_of_le_target P hik (generatedBy_of_le_source P hi₀k hbase)

end FiniteTypeAlgebraSystem

add_to_stacks 0AJK "part (3), the clause citing Stacks 0AL1: a morphism `f : Y → X = Spf(A)` \
of affine formal algebraic spaces which is of finite type corresponds to an object `(B_λ)` of \
the category `𝒞`, so that `Y = colim Spec(B_λ)`. The uniform bound part (3) asserts next, that \
one integer `r` generates every `B_λ` over `A/I_λ`, is \
`AlgebraicGeometry.FormalSpace.FiniteTypeAlgebraSystem.exists_uniform_generatedBy` in this \
file. The question part (3) closes with, whether there is an example in which `Y` is not \
McQuillan, is a question and is asserted nowhere."
  finiteTypeAlgebraSystemAntiEquivalence

end AlgebraicGeometry.FormalSpace

end
