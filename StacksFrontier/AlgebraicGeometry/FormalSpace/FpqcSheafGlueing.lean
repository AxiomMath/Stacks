module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.FormalSpace.AtlasChartBaseChange
public import StacksFrontier.AlgebraicGeometry.FormalSpace.FpqcSheafExistence
public import StacksFrontier.AlgebraicGeometry.FormalSpace.FpqcSheafReduction
public import StacksFrontier.AlgebraicGeometry.Spaces.ZariskiCoveringPoints

/-!
# A formal algebraic space is an fpqc sheaf

Let `S` be a scheme contained in a big fppf site `B`. **Stacks 0AQD** says that a formal
algebraic space `X` over `S` satisfies the sheaf property for the fpqc topology. This file
assembles the proof.

* `AlgebraicGeometry.FormalSpace.isSheaf_fpqc_of_isSheafFor_singleton_affine_of_formal`
  reduces the statement to the presieve generated by one surjective, flat, quasi-compact
  morphism `f : T' ⟶ T` of the site, and supplies uniqueness.
* For a section `c` of `X` over `T'` whose two pullbacks to `T' ×_T T'` agree, and a point `t`
  of `T`, choose a preimage `t'` of `t` and an atlas member `U ⟶ X` whose base change
  `V ⟶ T'` along `c` contains `t'` in its image
  (`AlgebraicGeometry.FormalSpace.exists_isPullback_etale_isSeparated_mem_range`). That base
  change is étale and separated, and the descent argument of the source
  (`AlgebraicGeometry.FormalSpace.exists_descended_section_of_chart`, through **Stacks 0APK**)
  produces an étale `W ⟶ T` whose image contains `t` and a section of `X` over `W` that
  agrees with `c` over `T' ×_T W`.
* These étale morphisms, one for each point of `T`, form an fppf covering of `T`. The local
  sections agree on overlaps because `X` is separated for fpqc coverings, so they glue, `X`
  being an fppf sheaf. The glued section restricts to `c`, again by separatedness.

The source picks one chart whose image contains the image of `c`, which needs a finite
subcover and a finite coproduct of charts. The family used here has one chart per point, and
gluing the descended neighbourhoods replaces both.

## Main results

* `AlgebraicGeometry.FormalSpace.isSheafFor_singleton_of_isFormalAlgebraicSpace`: a formal
  algebraic space satisfies the sheaf condition for one surjective, flat, quasi-compact
  morphism of the site.
* `AlgebraicGeometry.FormalSpace.isSheaf_fpqc`: **Stacks 0AQD**.

## References

* [Stacks Project, Tag 0AQD](https://stacks.math.columbia.edu/tag/0AQD)
* [Stacks Project, Tag 0APK](https://stacks.math.columbia.edu/tag/0APK)
* [Stacks Project, Tag 0AIM](https://stacks.math.columbia.edu/tag/0AIM)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.FormalSpace

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- A surjective, flat, quasi-compact morphism of the site generates an fpqc covering presieve. -/
private theorem singleton_mem_fpqc {T T' : BigFppfOver B S hS} (f : T' ⟶ T)
    (hfs : Surjective ((BigFppfOver.toScheme B S hS).map f))
    (hff : Flat ((BigFppfOver.toScheme B S hS).map f))
    (hfq : QuasiCompact ((BigFppfOver.toScheme B S hS).map f)) :
    Presieve.singleton f ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) T := by
  rw [Precoverage.mem_comap_iff, ← Presieve.ofArrows_pUnit.{0}, Presieve.map_ofArrows,
    Presieve.ofArrows_pUnit]
  exact Scheme.Hom.singleton_mem_fpqcPrecoverage _

/-- The base change of a surjective, flat, quasi-compact morphism of the site along any
morphism of the site generates an fpqc covering presieve. -/
theorem singleton_pullbackSnd_mem_fpqc {T T' Z : BigFppfOver B S hS} (f : T' ⟶ T) (h : Z ⟶ T)
    (hfs : Surjective ((BigFppfOver.toScheme B S hS).map f))
    (hff : Flat ((BigFppfOver.toScheme B S hS).map f))
    (hfq : QuasiCompact ((BigFppfOver.toScheme B S hS).map f)) :
    Presieve.singleton (pullback.snd f h) ∈
      Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) Z := by
  let q := BigFppfOver.toScheme B S hS
  let : PreservesLimitsOfShape WalkingCospan q := comp_preservesLimitsOfShape _ _
  have sq : IsPullback (q.map (pullback.fst f h)) (q.map (pullback.snd f h)) (q.map f)
      (q.map h) := (IsPullback.of_hasPullback f h).map q
  have : Surjective (q.map (pullback.snd f h)) :=
    MorphismProperty.of_isPullback (P := @Surjective) sq hfs
  have : Flat (q.map (pullback.snd f h)) := MorphismProperty.of_isPullback (P := @Flat) sq hff
  have : QuasiCompact (q.map (pullback.snd f h)) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) sq hfq
  exact singleton_mem_fpqc _ ‹_› ‹_› ‹_›

/-- **The existence half of Stacks 0AQD, for one morphism.** A formal algebraic space over `S`
satisfies the sheaf condition for the presieve generated by a morphism `f : T' ⟶ T` of the
site whose underlying morphism of schemes is surjective, flat and quasi-compact. -/
theorem isSheafFor_singleton_of_isFormalAlgebraicSpace {X : FppfSheaf B S hS}
    (hX : IsFormalAlgebraicSpace B S hS X) {T T' : BigFppfOver B S hS} (f : T' ⟶ T)
    (hfs : Surjective ((BigFppfOver.toScheme B S hS).map f))
    (hff : Flat ((BigFppfOver.toScheme B S hS).map f))
    (hfq : QuasiCompact ((BigFppfOver.toScheme B S hS).map f)) :
    Presieve.IsSheafFor X.obj (Presieve.singleton f) := by
  classical
  let JT := BigFppfOver.topology B S hS
  let yo := fppfYoneda B S hS
  let q := BigFppfOver.toScheme B S hS
  have hXsheaf : Presieve.IsSheaf JT X.obj := (isSheaf_iff_isSheaf_of_type _ _).1 X.property
  -- uniqueness along base changes of `f`
  have hsep : ∀ {Z : BigFppfOver B S hS} (h : Z ⟶ T),
      Function.Injective (X.obj.map (pullback.snd f h).op) := fun h ↦
    Presieve.isSeparatedFor_singleton.1 (isSeparatedFor_fpqc_of_isFormalAlgebraicSpace hX
      (singleton_pullbackSnd_mem_fpqc f h hfs hff hfq))
  have hinj : Function.Injective (X.obj.map f.op) := by
    exact Presieve.isSeparatedFor_singleton.1 (isSeparatedFor_fpqc_of_isFormalAlgebraicSpace hX
      (singleton_mem_fpqc f hfs hff hfq))
  refine Presieve.isSheafFor_singleton.2 fun s hs ↦ ?_
  let c : yo.obj T' ⟶ X := (Sheaf.sectionEquiv JT).symm s
  have hcs : Sheaf.sectionEquiv JT c = s := Equiv.apply_symm_apply _ s
  have hcc : yo.map (pullback.fst f f) ≫ c = yo.map (pullback.snd f f) ≫ c := by
    apply (Sheaf.sectionEquiv JT).injective
    rw [Sheaf.sectionEquiv_map_comp, Sheaf.sectionEquiv_map_comp, hcs]
    exact hs _ _ pullback.condition
  -- an étale neighbourhood of every point of `T` carrying a descended section
  have hloc : ∀ t : q.obj T, ∃ (W : BigFppfOver B S hS) (w : W ⟶ T) (x : yo.obj W ⟶ X),
      Etale (q.map w) ∧ yo.map (pullback.snd f w) ≫ x = yo.map (pullback.fst f w) ≫ c ∧
        t ∈ Set.range (q.map w) := by
    intro t
    obtain ⟨t', rfl⟩ := hfs.surj t
    obtain ⟨U, u, V, p, qU, hU, sq, hpe, hps, ht'⟩ :=
      exists_isPullback_etale_isSeparated_mem_range B S hS hX c t'
    obtain ⟨W, w, x, hwe, hx, hrange⟩ :=
      exists_descended_section_of_chart f hfs hff hfq hU u hcc sq hpe hps
    exact ⟨W, w, x, hwe, hx, hrange ⟨t', ht', rfl⟩⟩
  choose W w x hwe hx hrange using hloc
  -- the restriction of a local section to the base change of `f` is the restriction of `c`
  have hres : ∀ (t : q.obj T) {Z : BigFppfOver B S hS} (g : Z ⟶ W t) (k : Z ⟶ T),
      g ≫ w t = k → yo.map (pullback.snd f k) ≫ yo.map g ≫ x t =
        yo.map (pullback.fst f k) ≫ c := by
    rintro t Z g k rfl
    let ℓ : pullback f (g ≫ w t) ⟶ pullback f (w t) :=
      pullback.lift (pullback.fst f (g ≫ w t)) (pullback.snd f (g ≫ w t) ≫ g)
        (by rw [pullback.condition, Category.assoc])
    have h1 : pullback.snd f (g ≫ w t) ≫ g = ℓ ≫ pullback.snd f (w t) :=
      (pullback.lift_snd _ _ _).symm
    have h2 : pullback.fst f (g ≫ w t) = ℓ ≫ pullback.fst f (w t) :=
      (pullback.lift_fst _ _ _).symm
    rw [← Category.assoc, ← yo.map_comp, h1, yo.map_comp, Category.assoc, hx t, ← Category.assoc,
      ← yo.map_comp, ← h2]
  -- the étale neighbourhoods form an fppf covering of `T`
  let Wi : ULift.{u + 1} (q.obj T) → BigFppfOver B S hS := fun i ↦ W i.down
  let wi : ∀ i, Wi i ⟶ T := fun i ↦ w i.down
  have hcov : Sieve.generate (Presieve.ofArrows Wi wi) ∈ JT T := by
    refine Space.generated_over_fppf_family_mem_topology B S hS Wi wi ?_
    rw [Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
    refine ⟨fun t ↦ ⟨⟨t⟩, hrange t⟩, fun i ↦ ?_⟩
    have : Etale (q.map (wi i)) := hwe i.down
    exact ⟨inferInstanceAs (Flat (q.map (wi i))),
      inferInstanceAs (LocallyOfFinitePresentation (q.map (wi i)))⟩
  obtain ⟨a, ha, -⟩ := (Presieve.isSheafFor_arrows_iff _ _).1
      ((Presieve.isSheafFor_iff_generate _).2 (hXsheaf _ hcov))
      (fun i ↦ Sheaf.sectionEquiv JT (x i.down)) fun i j Z gi gj hij ↦ hsep (gi ≫ wi i) (by
        show X.obj.map _ (X.obj.map gi.op (Sheaf.sectionEquiv JT (x i.down))) =
          X.obj.map _ (X.obj.map gj.op (Sheaf.sectionEquiv JT (x j.down)))
        rw [← Sheaf.sectionEquiv_map_comp JT gi, ← Sheaf.sectionEquiv_map_comp JT gj,
          ← Sheaf.sectionEquiv_map_comp JT, ← Sheaf.sectionEquiv_map_comp JT,
          hres i.down gi (gi ≫ wi i) rfl, hres j.down gj (gi ≫ wi i) hij.symm])
  -- the glued section restricts to `c`
  have hfa : X.obj.map f.op a = s := by
    refine (hXsheaf _ (JT.pullback_stable f hcov)).isSeparatedFor.ext fun Z g hg ↦ ?_
    obtain ⟨Z', k, g', ⟨i⟩, hkg⟩ := hg
    have hgf : g ≫ f = k ≫ wi i := hkg.symm
    let ℓ : Z ⟶ pullback f (wi i) := pullback.lift g k hgf
    have hk : k = ℓ ≫ pullback.snd f (wi i) := (pullback.lift_snd _ _ _).symm
    have hg' : g = ℓ ≫ pullback.fst f (wi i) := (pullback.lift_fst _ _ _).symm
    rw [← Functor.map_comp_apply, ← op_comp, hgf, op_comp, Functor.map_comp_apply, ha i]
    show X.obj.map k.op (Sheaf.sectionEquiv JT (x i.down)) = X.obj.map g.op s
    rw [← hcs, ← Sheaf.sectionEquiv_map_comp JT, ← Sheaf.sectionEquiv_map_comp JT, hk, hg',
      yo.map_comp, yo.map_comp, Category.assoc, Category.assoc, hx i.down]
  exact ⟨a, hfa, fun z hz ↦ hinj (hz.trans hfa.symm)⟩

/-- **Stacks 0AQD.** A formal algebraic space `X` over a scheme `S` contained in a big fppf site
`B` satisfies the sheaf property for the fpqc topology of the big fppf site of `S`.

By `AlgebraicGeometry.FormalSpace.isSheaf_fpqc_of_isSheafFor_singleton_affine_of_formal` it is
enough to check the sheaf condition for one surjective, flat, quasi-compact morphism of the
site, which is `AlgebraicGeometry.FormalSpace.isSheafFor_singleton_of_isFormalAlgebraicSpace`. -/
@[stacks 0AQD]
theorem isSheaf_fpqc {X : FppfSheaf B S hS}
    (hX : IsFormalAlgebraicSpace B S hS X) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) X.obj :=
  isSheaf_fpqc_of_isSheafFor_singleton_affine_of_formal hX
    fun {_ _} f _ _ hfs hff hfq ↦ isSheafFor_singleton_of_isFormalAlgebraicSpace hX f hfs hff hfq

end AlgebraicGeometry.FormalSpace

end
