module

public import StacksFrontier.AlgebraicGeometry.FormalSpace.QuasiCompactQuasiSeparatedStageSheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.AffineEtaleCover
public import StacksFrontier.CategoryTheory.Sites.QuasiCompact.ObjectsAndColimits

/-!
# A quasi-compact quasi-separated formal algebraic space is the colimit of its stages

Let `S` be a scheme contained in a big fppf site `B`, let `X` be an fppf sheaf over `S`, and let
`c : A ⟶ X` be a surjection of sheaves from an affine formal algebraic space presented as
`colim A_i`, with a system `(Z_i)` of invariant closed subschemes of `A` through which the
stages `A_i` factor, as `AlgebraicGeometry.FormalSpace.exists_invariantStageSystem` produces. The
subsheaves of `X` generated by the `Z_i` form a directed diagram of subsheaves, and `X` is its
colimit.

## Main definitions

* `AlgebraicGeometry.FormalSpace.stageSubsheafDiagram`: the diagram of stage subsheaves of `X`,
  with the inclusions of subsheaves as transition morphisms.
* `AlgebraicGeometry.FormalSpace.stageSubsheafCocone`: the cocone on that diagram with vertex `X`.

## Main results

* `AlgebraicGeometry.FormalSpace.isLocallySurjective_of_stageImages`: the stage subsheaves cover
  `X`: a section of `X` is locally the image of a section of `A`, over an affine piece that
  section factors through a stage `A_i` of the presentation, and `A_i` factors through `Z_i`.
* `AlgebraicGeometry.FormalSpace.nonempty_iso_colimit_stageSubsheafDiagram`: `X` is the colimit
  of the diagram of its stage subsheaves.

## Implementation notes

The comparison `κ : colim X_i ⟶ X` is an isomorphism because it is locally bijective
(`CategoryTheory.Sheaf.isLocallyBijective_iff_isIso`). Local surjectivity is the geometric
statement above. Local injectivity is checked on an affine covering of the test object: over an
affine — a quasi-compact object of the site — the sections of a filtered colimit of sheaves with
monomorphic transitions are the colimit of the sections, which is **Stacks 0738** part (3),
`CategoryTheory.Sheaf.injective_and_bijective_colimit_post_sheafSections`; two sections
therefore come from one stage, where the inclusion into `X` is injective on sections.

Nothing here is formed as a sheafification of a colimit of presheaves, which is why the
identification of the sheaf colimit with the sheafified presheaf colimit — and with it any
comparison of sheafification with universe lifting — is not needed.

## References

* [Stacks Project, Tag 0738](https://stacks.math.columbia.edu/tag/0738)
* [Stacks Project, Tag 0AJE](https://stacks.math.columbia.edu/tag/0AJE)
-/

@[expose] public section

open Opposite CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.FormalSpace

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

section Colimit

variable {I : Type (u + 1)} [Preorder I] [Nonempty I] [IsDirected I (· ≤ ·)]
  (D : I ⥤ BigAffineFppf B S hS)
  (hD : ∀ ⦃i j : I⦄ (g : i ⟶ j),
    Stacks.Thickenings.IsThickening ((BigAffineFppf.toScheme B S hS).map (D.map g)))
  {A X : FppfSheaf B S hS}
  (e : A ≅ colimit (D ⋙ BigAffineFppf.inclusion B S hS ⋙ fppfYoneda B S hS))
  (c : A ⟶ X)
  (Z : I → BigFppfOver B S hS) (z : ∀ i, (fppfYoneda B S hS).obj (Z i) ⟶ A)
  (hle : ∀ ⦃i j : I⦄, (i ⟶ j) →
    (Subfunctor.range (z i ≫ c).hom).sheafify (BigFppfOver.topology B S hS) ≤
      (Subfunctor.range (z j ≫ c).hom).sheafify (BigFppfOver.topology B S hS))

/-- The diagram `i ↦ image (z i ≫ c)` of stage subsheaves of `X`, whose transition morphisms are
the inclusions of subsheaves. -/
noncomputable def stageSubsheafDiagram : I ⥤ FppfSheaf B S hS where
  obj i := Sheaf.image (z i ≫ c)
  map {_ _} g := ⟨Subfunctor.homOfLe (hle g)⟩
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The object of `stageSubsheafDiagram` at `i` is the image subsheaf of `z i ≫ c`. -/
@[simp]
theorem stageSubsheafDiagram_obj (i : I) :
    (stageSubsheafDiagram B S hS c Z z hle).obj i = Sheaf.image (z i ≫ c) := rfl

/-- The transition morphisms of `stageSubsheafDiagram` commute with the inclusions of the stage
subsheaves into `X`. -/
theorem stageSubsheafDiagram_map_comp_imageι {i j : I} (g : i ⟶ j) :
    (stageSubsheafDiagram B S hS c Z z hle).map g ≫ Sheaf.imageι (z j ≫ c) =
      Sheaf.imageι (z i ≫ c) :=
  Sheaf.hom_ext (Subfunctor.homOfLe_ι (hle g))

/-- The transition morphisms of `stageSubsheafDiagram` are monomorphisms. -/
theorem mono_stageSubsheafDiagram_map {i j : I} (g : i ⟶ j) :
    Mono ((stageSubsheafDiagram B S hS c Z z hle).map g) := by
  refine (sheafToPresheaf (BigFppfOver.topology B S hS) (Type (u + 1))).mono_of_mono_map
    (f := (stageSubsheafDiagram B S hS c Z z hle).map g) ?_
  show Mono (Subfunctor.homOfLe (hle g))
  infer_instance

/-- The cocone on the diagram of stage subsheaves whose vertex is `X`. -/
noncomputable def stageSubsheafCocone : Cocone (stageSubsheafDiagram B S hS c Z z hle) where
  pt := X
  ι := { app := fun i => Sheaf.imageι (z i ≫ c)
         naturality := fun i j g => by
           simpa using stageSubsheafDiagram_map_comp_imageι B S hS c Z z hle g }

/-- A sieve on `V` is covering as soon as it contains every morphism from an object with compact
underlying scheme. -/
private theorem sieve_mem_of_forall_compact (V : BigFppfOver B S hS) (R : Sieve V)
    (h : ∀ (W : BigFppfOver B S hS) (f : W ⟶ V),
      CompactSpace ((BigFppfOver.toScheme B S hS).obj W) → R f) :
    R ∈ (BigFppfOver.topology B S hS) V := by
  obtain ⟨I', V', π', haff, -, hcov, -⟩ := BigFppfOver.exists_affine_open_cover' B S hS V
  refine (BigFppfOver.topology B S hS).superset_covering ?_ hcov
  rw [Sieve.generate_le_iff]
  rintro W f ⟨k⟩
  have := haff k
  exact h _ _ inferInstance

/-- Applying a factorization `f ≫ g = h` of morphisms of sheaves to a section. -/
private theorem hom_app_comp_apply {F G H : FppfSheaf B S hS} (f : F ⟶ G) (g : G ⟶ H) (h : F ⟶ H)
    (hfg : f ≫ g = h) (W : (BigFppfOver B S hS)ᵒᵖ) (y : F.obj.obj W) :
    g.hom.app W (f.hom.app W y) = h.hom.app W y := by
  subst hfg
  rfl

include hD in
/-- Over an affine object, the image in `X` of a section of `A` comes from some stage `Z_i`. -/
theorem exists_mem_range_stage_of_compactSpace
    (hfac : ∀ i, ∃ si : stageObj B S hS D i ⟶ Z i,
      (fppfYoneda B S hS).map si ≫ z i = stageMap' B S hS D e i)
    (W : BigFppfOver B S hS) [hW : CompactSpace ((BigFppfOver.toScheme B S hS).obj W)]
    (y : A.obj.obj (op W)) :
    ∃ m, c.hom.app (op W) y ∈ Set.range ((z m ≫ c).hom.app (op W)) := by
  obtain ⟨m, a, ha⟩ := exists_factor_stageMap B S hS D hD e hW
    (sheafHomOfUliftYonedaHom B S hS (uliftYonedaEquiv.{u + 1}.symm y))
  obtain ⟨si, hsi⟩ := hfac m
  have hgk : (fppfYoneda B S hS).map (a ≫ si) ≫ (z m ≫ c) =
      sheafHomOfUliftYonedaHom B S hS (uliftYonedaEquiv.{u + 1}.symm y) ≫ c := by
    rw [Functor.map_comp, ← ha, ← hsi]
    simp only [Category.assoc]
  have hgk2 := congrArg (uliftYonedaHom B S hS) hgk
  rw [uliftYonedaHom_map_comp,
    uliftYonedaHom_comp B S hS (sheafHomOfUliftYonedaHom B S hS
      (uliftYonedaEquiv.{u + 1}.symm y)) c,
    uliftYonedaHom_sheafHomOfUliftYonedaHom] at hgk2
  have hgk3 := congrArg (uliftYonedaEquiv.{u + 1}) hgk2
  rw [uliftYonedaEquiv_comp, uliftYonedaEquiv_comp, Equiv.apply_symm_apply] at hgk3
  refine ⟨m, ((fppfYonedaCompSheafToPresheaf' B S hS).app (Z m)).inv.app (op W)
    (uliftYonedaEquiv.{u + 1} ((uliftYoneda.{u + 1}).map (a ≫ si))), ?_⟩
  rw [← hgk3]
  rfl

include hD in
/-- **The stage subsheaves cover `X`.** -/
theorem isLocallySurjective_of_stageImages {T : FppfSheaf B S hS} (κ : T ⟶ X)
    (ν : ∀ i, Sheaf.image (z i ≫ c) ⟶ T)
    (hν : ∀ i, ν i ≫ κ = Sheaf.imageι (z i ≫ c))
    (hcs : Sheaf.IsLocallySurjective c)
    (hfac : ∀ i, ∃ si : stageObj B S hS D i ⟶ Z i,
      (fppfYoneda B S hS).map si ≫ z i = stageMap' B S hS D e i) :
    Sheaf.IsLocallySurjective κ := by
  classical
  have _ : Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS) c.hom := hcs
  constructor
  intro U x
  refine (BigFppfOver.topology B S hS).transitive
    (Presheaf.imageSieve_mem (BigFppfOver.topology B S hS) c.hom x) _ ?_
  rintro V g ⟨y, hy⟩
  refine sieve_mem_of_forall_compact B S hS V _ fun W' π' hW' => ?_
  obtain ⟨m, hmem⟩ := exists_mem_range_stage_of_compactSpace B S hS D hD e c Z z hfac W'
    (A.obj.map π'.op y)
  have hx : c.hom.app (op W') (A.obj.map π'.op y) =
      X.obj.map (π' ≫ g).op x := by
    rw [NatTrans.naturality_apply, hy, ← Functor.map_comp_apply, ← op_comp]
  rw [hx] at hmem
  have hmem2 : X.obj.map (π' ≫ g).op x ∈
      ((Subfunctor.range (z m ≫ c).hom).sheafify
        (BigFppfOver.topology B S hS)).obj (op W') :=
    Subfunctor.le_sheafify (J := BigFppfOver.topology B S hS)
      (G := Subfunctor.range (z m ≫ c).hom) _ hmem
  refine ⟨(ν m).hom.app (op W') ⟨X.obj.map (π' ≫ g).op x, hmem2⟩, ?_⟩
  exact hom_app_comp_apply B S hS _ _ _ (hν m) _ _

/-- Over an affine object, a comparison `colim X_i ⟶ X` restricting to the inclusions of the
stage subsheaves is injective on sections. -/
theorem injective_app_of_colimit_ι_comp
    [HasColimitsOfSize.{u + 1, u + 1} (FppfSheaf B S hS)]
    (κ : colimit (stageSubsheafDiagram B S hS c Z z hle) ⟶ X)
    (hι : ∀ i, colimit.ι (stageSubsheafDiagram B S hS c Z z hle) i ≫ κ =
      Sheaf.imageι (z i ≫ c))
    (W : BigFppfOver B S hS) [CompactSpace ((BigFppfOver.toScheme B S hS).obj W)] :
    Function.Injective (κ.hom.app (op W)) := by
  classical
  intro a b hab
  let E := stageSubsheafDiagram B S hS c Z z hle
  obtain ⟨-, -, hbij, -⟩ :=
    Sheaf.injective_and_bijective_colimit_post_sheafSections (BigFppfOver.topology B S hS) E W
  have hpost := hbij (isQuasiCompactObject_over_of_compact_scheme B S hS W)
    (fun i j g => mono_stageSubsheafDiagram_map B S hS c Z z hle g)
  set G := E ⋙ (sheafSections (BigFppfOver.topology B S hS) (Type (u + 1))).obj (op W)
  obtain ⟨α, hα⟩ := hpost.2 a
  obtain ⟨β, hβ⟩ := hpost.2 b
  obtain ⟨i, xa, hxa⟩ := Types.jointly_surjective' α
  obtain ⟨j, xb, hxb⟩ := Types.jointly_surjective' β
  set l := IsFiltered.max i j
  set ya := G.map (IsFiltered.leftToMax i j) xa with hya
  set yb := G.map (IsFiltered.rightToMax i j) xb with hyb
  have hαl : colimit.ι G l ya = α := by
    rw [hya, ← hxa]
    exact congrArg (fun t => t xa)
      (congrArg (fun t : G.obj i ⟶ colimit G => (ConcreteCategory.hom t))
        (colimit.w G (IsFiltered.leftToMax i j)))
  have hβl : colimit.ι G l yb = β := by
    rw [hyb, ← hxb]
    exact congrArg (fun t => t xb)
      (congrArg (fun t : G.obj j ⟶ colimit G => (ConcreteCategory.hom t))
        (colimit.w G (IsFiltered.rightToMax i j)))
  have hpostι (y : G.obj l) :
      colimit.post E ((sheafSections (BigFppfOver.topology B S hS) (Type (u + 1))).obj
          (op W)) (colimit.ι G l y) = (colimit.ι E l).hom.app (op W) y :=
    congrArg (fun t => t y) (congrArg (fun t : G.obj l ⟶ (colimit E).obj.obj (op W) =>
      (ConcreteCategory.hom t))
      (colimit.ι_post E ((sheafSections (BigFppfOver.topology B S hS)
        (Type (u + 1))).obj (op W)) l))
  have hax : (colimit.ι E l).hom.app (op W) ya = a := by
    rwa [← hpostι ya, hαl]
  have hbx : (colimit.ι E l).hom.app (op W) yb = b := by
    rwa [← hpostι yb, hβl]
  have hκι (y : (E.obj l).obj.obj (op W)) :
      κ.hom.app (op W) ((colimit.ι E l).hom.app (op W) y) =
        (Sheaf.imageι (z l ≫ c)).hom.app (op W) y :=
    hom_app_comp_apply B S hS _ _ _ (hι l) _ y
  rw [← hax, ← hbx, hκι, hκι] at hab
  rw [← hax, ← hbx]
  exact congrArg _ (Subtype.ext hab)

include hD in
/-- **`X` is the colimit of its stage subsheaves.** -/
theorem nonempty_iso_colimit_stageSubsheafDiagram
    [HasColimitsOfSize.{u + 1, u + 1} (FppfSheaf B S hS)]
    (hcs : Sheaf.IsLocallySurjective c)
    (hfac : ∀ i, ∃ si : stageObj B S hS D i ⟶ Z i,
      (fppfYoneda B S hS).map si ≫ z i = stageMap' B S hS D e i) :
    Nonempty (X ≅ colimit (stageSubsheafDiagram B S hS c Z z hle)) := by
  classical
  set E := stageSubsheafDiagram B S hS c Z z hle
  set κ : colimit E ⟶ X := colimit.desc E (stageSubsheafCocone B S hS c Z z hle)
  have hι (i : I) : colimit.ι E i ≫ κ = Sheaf.imageι (z i ≫ c) := colimit.ι_desc _ i
  have hsurj : Sheaf.IsLocallySurjective κ :=
    isLocallySurjective_of_stageImages B S hS D hD e c Z z κ (fun i => colimit.ι E i) hι
      hcs hfac
  have hinj : Sheaf.IsLocallyInjective κ := by
    constructor
    intro U a b hab
    refine sieve_mem_of_forall_compact B S hS U.unop _ fun W' π' hW' => ?_
    have h : κ.hom.app (op W') ((colimit E).obj.map π'.op a) =
        κ.hom.app (op W') ((colimit E).obj.map π'.op b) := by
      rw [NatTrans.naturality_apply, NatTrans.naturality_apply, hab]
    exact injective_app_of_colimit_ι_comp B S hS c Z z hle κ hι W' h
  have _ := (Sheaf.isLocallyBijective_iff_isIso κ).1 ⟨hinj, hsurj⟩
  exact ⟨(asIso κ).symm⟩

end Colimit

end AlgebraicGeometry.FormalSpace

end
