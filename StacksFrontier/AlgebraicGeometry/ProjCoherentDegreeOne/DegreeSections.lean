module

public import StacksFrontier.AlgebraicGeometry.Blowup.ProjectiveAmbientSections
public import StacksFrontier.AlgebraicGeometry.Blowup.ProjectivePushforwardStep
public import StacksFrontier.AlgebraicGeometry.Limits.ProjGradedSurjection01N0
public import StacksFrontier.AlgebraicGeometry.ProjCoherentDegreeOne.Setup
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.Cohomology.TwistSectionsDegreeOne

/-!
# `A_q ⟶ Γ(Proj A, 𝒪(q))` is surjective in large degrees

Let `A` be a graded ring with `A₀` Noetherian, generated by `x₀, …, xₙ ∈ A₁` over `A₀`, and let
`X = Proj A`. This file proves that the canonical map

`A_q ⟶ Γ(X, 𝒪_X(q))`

of [Stacks, Tag 0AG2] is surjective once `q` is large. It is the one statement about `X` that
cannot be proved on `X`: Serre's computation of the sections of the twisting sheaves is available
only on projective space, and on `X` it *is* the statement being proved.

The route is the one `StacksFrontier/AlgebraicGeometry/Blowup/ProjectiveAmbientSections.lean` takes
for the blowup of an affine scheme, and every step of it is already available for an arbitrary
graded surjection whose `Proj` is a closed immersion. The evaluation map
`ψ : A₀[T₀, …, Tₙ] → A`, `Tⱼ ↦ xⱼ`, is a surjection of graded rings, so `i = Proj ψ` is a closed
immersion; the ideal-sheaf sequence `0 ⟶ ℐ ⟶ 𝒪_𝐏 ⟶ i_*𝒪_X ⟶ 0` on `𝐏 = ℙⁿ_{A₀}` is short exact
with `ℐ` coherent, so `H¹(𝐏, ℐ(q)) = 0` for large `q` and every global section of `(i_*𝒪_X)(q)`
lifts to `𝐏`; the degreewise comparison `(i_*𝒪_X)(q) ≅ i_*(𝒪_X(q))` is an isomorphism on
sections; and on `𝐏` every global section of `𝒪_𝐏(q)` is the canonical section of a homogeneous
polynomial of degree `q`.

## Main results

All in the namespace `Stacks.ProjCoherentDegreeOne`.

* `surjective_evalHom`, `projMap`, `isClosedImmersion_projMap`: the graded surjection and the
  closed immersion it induces, in the `AlgebraicGeometry.Proj.map` spelling that the comparison
  machinery is stated at.
* `quotientMap`, `epi_quotientMap`, `isCoherent_kernel_quotientMap`: the ideal-sheaf sequence.
* `exists_forall_surjective_twistedSectionsAddHom`: every global section of `(i_*𝒪_X)(q)` lifts
  to `𝐏` for `q` large.
* `exists_forall_surjective_degreeSection`: **the conclusion.**

## Implementation notes

The closed immersion is `AlgebraicGeometry.Proj.map`, the spelling at which the comparison
machinery of `StacksFrontier/AlgebraicGeometry/Blowup/ProjectivePushforwardStep.lean` is stated.
It is the only place in this development where the embedding into projective space is needed:
assertion (2) of [Stacks, Tag 0AG6] goes through the proper-mapping theorem instead, and
assertions (1) and (3) through ampleness of `𝒪(1)` on `X` itself.

The grading index type is taken in the same universe as the ring, as everywhere on this import
surface; see the implementation notes of
`StacksFrontier/AlgebraicGeometry/Blowup/ProjectivePushforwardStep.lean`.

## References

* [Stacks Project, Tag 0AG6](https://stacks.math.columbia.edu/tag/0AG6)
* [Stacks Project, Tag 0AG2](https://stacks.math.columbia.edu/tag/0AG2)
* [Stacks Project, Tag 01YS](https://stacks.math.columbia.edu/tag/01YS)
* [Stacks Project, Tag 087T](https://stacks.math.columbia.edu/tag/087T)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep (twistedSectionsAddHom)
open Stacks.AlgebraicGeometry.RelativeProjChain

universe u

namespace Stacks.ProjCoherentDegreeOne

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing (𝒜 0)] {m : ℕ} (x : Fin (m + 1 + 1) → A)
  (hx : ∀ i, x i ∈ 𝒜 1) (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

/-- The grading of `A₀[T₀, …, T_k]` by total degree, the one `ℙᵏ_{A₀}` is the `Proj` of. -/
abbrev polyGrading (k : ℕ) : ℕ → Submodule (𝒜 0) (MvPolynomial (Fin (k + 1)) (𝒜 0)) :=
  MvPolynomial.homogeneousSubmodule (Fin (k + 1)) (𝒜 0)

/-- The evaluation map `A₀[T₀, …, Tₙ] → A`, `Tⱼ ↦ xⱼ`, as a homomorphism of graded rings. -/
abbrev evalHom : polyGrading 𝒜 (m + 1) →+*ᵍ 𝒜 :=
  polyGradedHom 𝒜 (R := (𝒜 0)) (fun r => r.2) x hx

include hgen

omit [IsNoetherianRing (𝒜 0)] in
/-- **The evaluation map is surjective**: the `xⱼ` generate `A` as an `A₀`-algebra. -/
theorem surjective_evalHom :
    Function.Surjective ((evalHom 𝒜 x hx : polyGrading 𝒜 (m + 1) →+*ᵍ 𝒜) :
      MvPolynomial (Fin (m + 1 + 1)) (𝒜 0) → A) := by
  intro s
  have hmem : s ∈ (MvPolynomial.aeval (R := (𝒜 0)) x).range := by
    rw [← Algebra.adjoin_range_eq_range_aeval, hgen]
    trivial
  exact hmem

/-- **The closed immersion `Proj A ⟶ ℙⁿ_{A₀}`**, in the `AlgebraicGeometry.Proj.map` spelling. -/
abbrev projMap : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Proj (polyGrading 𝒜 (m + 1)) :=
  AlgebraicGeometry.Proj.map (evalHom 𝒜 x hx)
    (AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective _ (surjective_evalHom 𝒜 x hx hgen))

/-- The morphism `Proj A ⟶ ℙⁿ_{A₀}` induced by the surjection `evalHom` is a closed immersion. -/
instance isClosedImmersion_projMap : IsClosedImmersion (projMap 𝒜 x hx hgen) :=
  AlgebraicGeometry.Proj.isClosedImmersion_map_of_surjective' (evalHom 𝒜 x hx)
    (surjective_evalHom 𝒜 x hx hgen)

/-- **The canonical restriction `𝒪_𝐏 ⟶ i_*𝒪_X`.** Its kernel is the ideal sheaf of `X` in
`ℙⁿ_{A₀}`. -/
abbrev quotientMap :
    SheafOfModules.unit (AlgebraicGeometry.Proj (polyGrading 𝒜 (m + 1))).ringCatSheaf ⟶
      (Scheme.Modules.pushforward (projMap 𝒜 x hx hgen)).obj
        (SheafOfModules.unit (AlgebraicGeometry.Proj 𝒜).ringCatSheaf) :=
  SheafOfModules.unitToPushforwardObjUnit (projMap 𝒜 x hx hgen).toRingCatSheafHom

include hx

omit [IsNoetherianRing (𝒜 0)] in
/-- **`𝒪_𝐏 ⟶ i_*𝒪_X` is an epimorphism**, `i` being a closed immersion. -/
theorem epi_quotientMap : Epi (quotientMap 𝒜 x hx hgen) :=
  Stacks.AlgebraicGeometry.ClosedImmersionTFAE.epi_unitToPushforwardObjUnit_of_isClosedImmersion
    (projMap 𝒜 x hx hgen)

omit hx in
/-- **`Proj A` is locally Noetherian.** -/
theorem isLocallyNoetherian_proj : IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
  have := isNoetherianRing 𝒜 x hgen
  have := isNoetherian_proj 𝒜 x hgen
  inferInstance

/-- **The direct image of the structure sheaf of `Proj A` is coherent on `ℙⁿ_{A₀}`**, by
[Stacks, Tag 087T]. -/
theorem isCoherent_pushforward_unit :
    _root_.SheafOfModules.IsCoherent
      ((Scheme.Modules.pushforward (projMap 𝒜 x hx hgen)).obj
        (SheafOfModules.unit (AlgebraicGeometry.Proj 𝒜).ringCatSheaf)) :=
  have := isLocallyNoetherian_proj 𝒜 x hgen
  have : _root_.SheafOfModules.IsCoherent
      (SheafOfModules.unit (AlgebraicGeometry.Proj 𝒜).ringCatSheaf) :=
    Stacks.AlgebraicGeometry.CoherentTFAE.isCoherent_unit (AlgebraicGeometry.Proj 𝒜)
  isCoherent_pushforward_of_isClosedImmersion (projMap 𝒜 x hx hgen)
    (SheafOfModules.unit (AlgebraicGeometry.Proj 𝒜).ringCatSheaf)

/-- **The ideal sheaf of `Proj A` inside `ℙⁿ_{A₀}` is coherent**, being the kernel of a map of
coherent modules. -/
theorem isCoherent_kernel_quotientMap :
    _root_.SheafOfModules.IsCoherent (kernel (quotientMap 𝒜 x hx hgen)) :=
  have : _root_.SheafOfModules.IsCoherent
      (SheafOfModules.unit (AlgebraicGeometry.Proj (polyGrading 𝒜 (m + 1))).ringCatSheaf) :=
    Stacks.AlgebraicGeometry.CoherentTFAE.isCoherent_unit
      (AlgebraicGeometry.Proj (polyGrading 𝒜 (m + 1)))
  have := isCoherent_pushforward_unit 𝒜 x hx hgen
  AlgebraicGeometry.CoherentAbelian.isCoherent_kernel (quotientMap 𝒜 x hx hgen)

/-- **Every global section of `(i_*𝒪_X)(q)` lifts to `ℙⁿ_{A₀}` for `q` large.** The twisted
ideal-sheaf sequence is short exact and the first cohomology of the coherent ideal sheaf's twists
vanishes in large degrees, by [Stacks, Tag 01YS] clause (4). -/
theorem exists_forall_surjective_twistedSectionsAddHom :
    ∃ q₀ : ℤ, ∀ q : ℤ, q₀ ≤ q →
      Function.Surjective
        (twistedSectionsAddHom (polyGrading 𝒜 (m + 1)) (quotientMap 𝒜 x hx hgen) q) := by
  obtain ⟨q₀, hq₀⟩ :=
    Stacks.ProjectiveSpace.SerreVanishing.exists_isZero_Hgroup_twist_of_isCoherent (𝒜 0) (m + 1)
      1 Nat.one_pos (kernel (quotientMap 𝒜 x hx hgen)) (isCoherent_kernel_quotientMap 𝒜 x hx hgen)
  exact ⟨q₀, fun q hq =>
    @Stacks.ProjectiveSpace.Cohomology.surjective_twistedSectionsAddHom_of_isZero_firstCohomology
      (𝒜 0) _ (m + 1) _ _ (quotientMap 𝒜 x hx hgen) (epi_quotientMap 𝒜 x hx hgen) q
      (hq₀ q hq)⟩

/-- **`A_q ⟶ Γ(Proj A, 𝒪(q))` is surjective for all large `q`.** Every global section of
`𝒪_X(q)` comes from `ℙⁿ_{A₀}`, where it is the canonical section of a homogeneous polynomial of
degree `q`; the image of that polynomial under the evaluation map is the required homogeneous
element of `A`. -/
theorem exists_forall_surjective_degreeSection :
    ∃ q₀ : ℕ, ∀ q : ℕ, q₀ ≤ q → Function.Surjective (degreeSection 𝒜 q) := by
  have := isClosedImmersion_projMap 𝒜 x hx hgen
  obtain ⟨q₀, hq₀⟩ := exists_forall_surjective_twistedSectionsAddHom 𝒜 x hx hgen
  refine ⟨q₀.toNat, fun q hq => ?_⟩
  have hq' : q₀ ≤ (q : ℤ) := by omega
  have hirr := AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective _
    (surjective_evalHom 𝒜 x hx hgen)
  have hsurj := surjective_evalHom 𝒜 x hx hgen
  have hadj := MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin (m + 1 + 1)) (𝒜 0)
  exact Stacks.Blowup.surjective_degreeSection_of_surjective_comp
    (polyGrading 𝒜 (m + 1)) 𝒜 (evalHom 𝒜 x hx) hirr hsurj hadj q
    (Function.Surjective.comp
      (Stacks.Blowup.twistedSectionsUnitMap_surjective (polyGrading 𝒜 (m + 1)) 𝒜
        (evalHom 𝒜 x hx) hirr hsurj hadj (q : ℤ))
      (hq₀ (q : ℤ) hq'))
    (Stacks.ProjectiveSpace.Cohomology.surjective_degreeSection (𝒜 0) (m + 1) q)

end Stacks.ProjCoherentDegreeOne

end
