module

public import StacksFrontier.AlgebraicGeometry.AmpleTwistAcyclicity.Basic
public import StacksFrontier.AlgebraicGeometry.PowerFamilyBridge.Ample
public import StacksFrontier.AlgebraicGeometry.ProjCoherentDegreeOne.Setup
public import StacksFrontier.AlgebraicGeometry.ProjRepresentsF1.TwistPowers
public import StacksFrontier.AlgebraicGeometry.ProjSerreDevissage.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Serre vanishing on `Proj A` for a graded ring generated in degree one

Let `A` be a graded ring with `A₀` Noetherian, generated by finitely many elements of `A₁` over
`A₀`, and let `X = Proj A`. This file proves assertion (3) of [Stacks, Tag 0AG6]: for `p > 0` and
every coherent `𝒪_X`-module `ℱ`,

`H^p(X, ℱ(d)) = 0` for all `d` large enough.

Two inputs meet here. The twisting sheaf `𝒪(1)` is ample and `X` is proper over the affine
Noetherian `Spec A₀`, so [Stacks, Tag 02O1] over an affine base
(`Stacks.AlgebraicGeometry.AmpleTwistAcyclicity.twistAcyclicityOverAffineBase`) makes the twists
`𝒪(q)` themselves acyclic in positive degrees for `q` large, with one bound serving every
positive cohomological degree. That is the hypothesis `HasEventuallyAcyclicTwists` of the
dévissage of `../ProjSerreDevissage/Basic.lean`, whose other hypothesis — a presentation of a
coherent module by a finite direct sum of twists — is assertion (1), proved in
`../ProjCoherentDegreeOne/Setup.lean`. The dévissage then carries the vanishing from the twists
to every coherent module.

## Main results

All in the namespace `Stacks.ProjCoherentDegreeOne`.

* `exists_forall_isZero_Hgroup_twistingSheaf`: Serre vanishing for the twists themselves.
* `hasEventuallyAcyclicTwists`, `hasTwistQuotients`, `hasCoherentTwistPresentation`: the two
  hypotheses of the dévissage.
* `exists_isZero_Hgroup_twist_of_isCoherent`: **assertion (3) of [Stacks, Tag 0AG6]**.

## Implementation notes

`Stacks.AlgebraicGeometry.AmpleTwistAcyclicity.twistAcyclicityOverAffineBase` is stated for the
integral tensor powers `M ^⊗ q` of an ample invertible module at natural-number exponents;
`Stacks.AlgebraicGeometry.ProjTwistPowers.tensorPowModuleIsoTwistingSheaf` identifies those with
the twisting sheaves, and
`Stacks.AlgebraicGeometry.ProjRepresentsF1.isIso_twistMultiplicationMap_of_adjoin` identifies
`𝒪(k)(d)` with `𝒪(k + d)`, which is what turns the natural-number statement into the
integer-indexed `HasEventuallyAcyclicTwists`.

No `stacks` attribute is attached here; see `../ProjCoherentDegreeOne/Main.lean`.

## References

* [Stacks Project, Tag 0AG6](https://stacks.math.columbia.edu/tag/0AG6)
* [Stacks Project, Tag 02O1](https://stacks.math.columbia.edu/tag/02O1)
* [Stacks Project, Tag 0B5Q](https://stacks.math.columbia.edu/tag/0B5Q)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjSerreDevissage
open Stacks.AlgebraicGeometry.ProjTwistFunctor (projRingSheaf)

universe u w

namespace Stacks.ProjCoherentDegreeOne

attribute [local instance 10000] HasDerivedCategory.standard

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing (𝒜 0)] {n : ℕ} (x : Fin (n + 1) → A)
  (hx : ∀ i, x i ∈ 𝒜 1) (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

include hx hgen

/-- **Serre vanishing for the twisting sheaves on `Proj A`.** One bound `q₀` serves every
positive cohomological degree: `H^p(X, 𝒪(q)) = 0` for `p > 0` and `q ≥ q₀`.

`X` is proper over the affine Noetherian `Spec A₀` and `𝒪(1)` is ample and invertible, so this is
[Stacks, Tag 02O1] over an affine base; the tensor powers of `𝒪(1)` are the twists. -/
@[ega "III 2.2.2" "(iii), special case"]
theorem exists_forall_isZero_Hgroup_twistingSheaf :
    ∃ q₀ : ℕ, ∀ q : ℕ, q₀ ≤ q → ∀ p : ℕ, 0 < p →
      IsZero (Hgroup (AlgebraicGeometry.Proj 𝒜).ringCatSheaf ⊤ p
        (twistingSheaf 𝒜 (q : ℤ))) := by
  have := isInvertibleModule_twistingSheaf 𝒜 x hx hgen 1
  have := finiteType 𝒜 x hgen
  have hnoeth : IsLocallyNoetherian (Spec (CommRingCat.of (𝒜 0))) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
  obtain ⟨q₀, hq₀⟩ :=
    Stacks.AlgebraicGeometry.AmpleTwistAcyclicity.twistAcyclicityOverAffineBase
      (AlgebraicGeometry.Proj 𝒜) (Spec (CommRingCat.of (𝒜 0)))
      (AlgebraicGeometry.Proj.toSpecZero 𝒜) inferInstance hnoeth inferInstance
      (twistingSheaf 𝒜 1) (isAmple_twistingSheaf_one 𝒜 x hx hgen)
  refine ⟨q₀, fun q hq p hp => (hq₀ q hq p hp).of_iso ?_⟩
  exact (Hfunctor (AlgebraicGeometry.Proj 𝒜).ringCatSheaf ⊤ p).mapIso
    (Stacks.AlgebraicGeometry.ProjTwistPowers.tensorPowModuleIsoTwistingSheaf 𝒜
      (adjoin_degreeOne_eq_top 𝒜 x hx hgen) (q : ℤ)).symm

/-- **The hypothesis `HasEventuallyAcyclicTwists` of the dévissage**, for `Proj A`: for every `k`
the twists `𝒪(k)(d)` are acyclic in positive degrees once `d` is large.

`𝒪(k)(d) ≅ 𝒪(k + d)`, and `k + d` is a large natural number once `d ≥ q₀ - k`. -/
theorem hasEventuallyAcyclicTwists : HasEventuallyAcyclicTwists 𝒜 ⊤ := by
  obtain ⟨q₀, hq₀⟩ := exists_forall_isZero_Hgroup_twistingSheaf 𝒜 x hx hgen
  intro k
  refine ⟨(q₀ : ℤ) - k, fun d hd m hm => ?_⟩
  have hkd : ((k + d).toNat : ℤ) = k + d := Int.toNat_of_nonneg (by omega)
  have hle : q₀ ≤ (k + d).toNat := by omega
  have hiso : twistSheafOfModules 𝒜 (twistingSheaf 𝒜 k) d ≅
      twistingSheaf 𝒜 (((k + d).toNat : ℕ) : ℤ) := by
    refine @asIso _ _ _ _
      (Stacks.AlgebraicGeometry.ProjInvertibleLocus.twistMultiplicationMap 𝒜 k d)
      (Stacks.AlgebraicGeometry.ProjRepresentsF1.isIso_twistMultiplicationMap_of_adjoin 𝒜
        (adjoin_degreeOne_eq_top 𝒜 x hx hgen) k d) ≪≫ ?_
    exact eqToIso (by rw [hkd])
  exact (hq₀ _ hle m hm).of_iso ((Hfunctor (projRingSheaf 𝒜) ⊤ m).mapIso hiso)

omit [IsNoetherianRing ↥(𝒜 0)] in
/-- **Assertion (1) of [Stacks, Tag 0AG6] in the bicone spelling the dévissage consumes.** -/
theorem hasTwistQuotients : HasTwistQuotients 𝒜 := by
  intro F hF
  obtain ⟨r, d, φ, hφ⟩ := exists_epi_coproduct_twistingSheaf 𝒜 x hx hgen F hF
  let _ : HasBiproduct (fun j : Fin r => twistingSheaf 𝒜 (d j)) :=
    HasBiproduct.of_hasCoproduct _
  refine ⟨r, d, biproduct.bicone _, biproduct.isBilimit _,
    (biproduct.isoCoproduct _).hom ≫ φ, ?_⟩
  have := hφ
  exact epi_comp _ _

/-- Assertion (1) packaged as the short exact sequence the dévissage consumes. -/
theorem hasCoherentTwistPresentation : HasCoherentTwistPresentation 𝒜 :=
  hasCoherentTwistPresentation_of_hasTwistQuotients 𝒜 (hasTwistQuotients 𝒜 x hx hgen)
    (isCoherent_twistingSheaf 𝒜 x hx hgen)

/-- **Assertion (3) of [Stacks, Tag 0AG6].** For `p > 0` and `ℱ` coherent on `X = Proj A`, the
cohomology `H^p(X, ℱ(d))` vanishes for all `d` large enough. -/
theorem exists_isZero_Hgroup_twist_of_isCoherent (p : ℕ) (hp : 0 < p)
    (F : (AlgebraicGeometry.Proj 𝒜).Modules) (hF : _root_.SheafOfModules.IsCoherent F) :
    ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d →
      IsZero (Hgroup (projRingSheaf 𝒜) ⊤ p (twistSheafOfModules 𝒜 F d)) :=
  have := isNoetherianRing 𝒜 x hx hgen
  exists_isZero_hgroup_twist_of_presentation_of_adjoin_degree_one 𝒜
    (by
      rw [Stacks.AlgebraicGeometry.ProjTwistMono.range_coe_degree_one 𝒜]
      exact adjoin_degreeOne_eq_top 𝒜 x hx hgen)
    (hasCoherentTwistPresentation 𝒜 x hx hgen) (hasEventuallyAcyclicTwists 𝒜 x hx hgen) p hp F hF

end Stacks.ProjCoherentDegreeOne

end
