module

public import StacksFrontier.AlgebraicGeometry.Blowup.ProjectivePushforwardTruncation
public import StacksFrontier.AlgebraicGeometry.ProjCoherentDegreeOne.DegreeSections
public import StacksFrontier.AlgebraicGeometry.ProjCoherentDegreeOne.Finiteness
public import StacksFrontier.AlgebraicGeometry.ProjCoherentDegreeOne.Vanishing
public import StacksFrontier.AlgebraicGeometry.ProjCoherentII.TruncationFinite
public import StacksFrontier.AlgebraicGeometry.ProjEulerSequence.StructureMorphism
public import StacksFrontier.AlgebraicGeometry.ProjTwistDegreeOneStep.Devissage
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.Cohomology.TwistSectionsCoeffAction

/-!
# The graded module of twisted global sections on `Proj A` is a finite `A`-module

Let `A` be a graded ring with `A₀` Noetherian, generated by finitely many elements of `A₁` over
`A₀`, let `X = Proj A` and let `ℱ` be a coherent `𝒪_X`-module. This file proves assertion (4) of
[Stacks, Tag 0AG6]: for every `k ∈ ℤ` the graded `A`-module

`⨁_{d ≥ k} H⁰(X, ℱ(d))`

is a finite `A`-module.

The sandwich is the source's, in the form
`Stacks.AlgebraicGeometry.ProjTwistedSections.moduleFinite_twistedGlobalSectionsTruncation`
takes it. Its two hypotheses are supplied here:

* each homogeneous piece `Γ(X, ℱ(d))` is a finite `A₀`-module, by assertion (2) at `p = 0`, so
  it spans a finitely generated `A`-submodule — the coefficients acting through the global
  functions `A₀ ⟶ Γ(X, 𝒪_X)` of the structure morphism;
* above some degree every piece lies in the `A`-span of the piece one below, by the dévissage of
  `../ProjTwistDegreeOneStep/Devissage.lean`, whose three inputs are assertion (1), assertion (3)
  and the surjectivity of `A_q ⟶ Γ(X, 𝒪_X(q))` in large degrees of
  `../ProjCoherentDegreeOne/DegreeSections.lean`.

## Main results

All in the namespace `Stacks.ProjCoherentDegreeOne`.

* `coeffScalar`, `coeffScalar_val`, `coeffScalar_smul_of`: the degree-zero part of `A` acting on
  the twisted sections as global functions on `X`.
* `moduleFinite_twistedSectionsComponent`: `Γ(X, ℱ(d))` is a finite `A₀`-module.
* `exists_forall_mem_degreeOneSections`: the degree-one generation of the high degrees.
* `moduleFinite_truncation`: **assertion (4) of [Stacks, Tag 0AG6]**.

## References

* [Stacks Project, Tag 0AG6](https://stacks.math.columbia.edu/tag/0AG6)
* [Stacks Project, Tag 01YS](https://stacks.math.columbia.edu/tag/01YS)
* [Stacks Project, Tag 03GK](https://stacks.math.columbia.edu/tag/03GK)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite DirectSum
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTwistFunctor (projRingSheaf)
open Stacks.AlgebraicGeometry.ProjTwistedSections
open Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep
open Stacks.AlgebraicGeometry.ProjStalkGlobalSections (degreeZeroToGlobalSections)
open Stacks.Cohomology.CechSheaf (SectionRing)

universe u

namespace Stacks.ProjCoherentDegreeOne

attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance] HasDerivedCategory.standard
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose AlgebraicGeometry.Proj
  Stacks.SheafOfModules.TensorSheafification.structureSheaf

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **The degree-zero part of `A` as global functions on `Proj A`**: the ring homomorphism
`A₀ ⟶ Γ(X, 𝒪_X)` obtained from the structure morphism `X ⟶ Spec A₀` by identifying `A₀` with the
global sections of `Spec A₀`. -/
def coeffScalar : (𝒜 0) →+* SectionRing (projRingSheaf 𝒜) ⊤ :=
  ((Scheme.ΓSpecIso (CommRingCat.of (𝒜 0))).inv ≫
    (AlgebraicGeometry.Proj.toSpecZero 𝒜).appTop).hom

/-- **A degree-zero element pulls back to the constant fraction.** -/
theorem coeffScalar_val (a : 𝒜 0) (y : ProjectiveSpectrum.top 𝒜) :
    HomogeneousLocalization.val ((coeffScalar 𝒜 a).1 ⟨y, trivial⟩) =
      algebraMap A (Localization y.asHomogeneousIdeal.toIdeal.primeCompl) (a : A) :=
  Stacks.AlgebraicGeometry.ProjEulerSequence.toSpecZero_appTop_val 𝒜 a y

/-- **Surjectivity of the map of [Stacks, Tag 01MP] above a threshold**, from surjectivity of
`AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection` in the natural degrees above it.

This is the degree-bounded form of `surjective_degreeZeroToGlobalSections_of_degreeSection`, which
asks for surjectivity in *every* natural degree. Only the bounded form is available here:
`Stacks.ProjCoherentDegreeOne.exists_forall_surjective_degreeSection` produces a `q₀` above which
the degree sections are surjective and says nothing below it. -/
theorem surjective_degreeZeroToGlobalSections_of_le (q₀ : ℕ)
    (h : ∀ q : ℕ, q₀ ≤ q → Function.Surjective (degreeSection 𝒜 q))
    (b : ℤ) (hb : (q₀ : ℤ) ≤ b) :
    Function.Surjective (degreeZeroToGlobalSections 𝒜 (twistGrading (S := A) 𝒜 b)) := by
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, b = (k : ℤ) :=
    ⟨b.toNat, (Int.toNat_of_nonneg ((Int.natCast_nonneg q₀).trans hb)).symm⟩
  intro s
  obtain ⟨a, ha⟩ := h k (by exact_mod_cast hb) s
  exact ⟨⟨(a : A), Stacks.AlgebraicGeometry.ProjTwistSections.mem_twistGrading_zero 𝒜 a⟩, ha⟩

variable (F : SheafOfModules.{u} (projRingSheaf 𝒜))

/-- **The degree-zero graded action is the action of the coefficients.** For the graded
`A`-module structure on `⨁_{n ∈ ℤ} Γ(X, ℱ(n))`, a degree-zero element acts on the degree-`n`
summand as the global function it pulls back to along `X ⟶ Spec A₀`.

This is the hypothesis `hι` of
`Stacks.AlgebraicGeometry.ProjTwistedSections.fg_span_twistedGlobalSectionsGrading_of_span_eq_top`
for `ι` the inclusion of the degree-zero part. -/
theorem coeffScalar_smul_of (D : TwistedGlobalSectionsModule 𝒜 F) (a : 𝒜 0) (n : ℤ)
    (s : twistedSectionsComponent 𝒜 F n) :
    letI := D.moduleInst
    ((a : 𝒜 0) : A) •
        (DirectSum.of (fun k : ℤ => twistedSectionsComponent 𝒜 F k) n s :
          twistedGlobalSections 𝒜 F) =
      DirectSum.of (fun k : ℤ => twistedSectionsComponent 𝒜 F k) n (coeffScalar 𝒜 a • s) :=
  let := D.moduleInst
  (D.smul_homogeneous 0 n a s).trans
    (DirectSum.of_eq_of_heq (twistedDegree_zero n)
      ((cast_heq (congrArg (twistedSectionsComponent 𝒜 F) (twistedDegree_zero n)) _).symm.trans
        (heq_of_eq
          (Stacks.AlgebraicGeometry.ProjTwistedSections.cast_homogeneousScalarTwistedSections_zero
            𝒜 F n a (coeffScalar 𝒜 a) (fun y => coeffScalar_val 𝒜 a y) s))))

variable [IsNoetherianRing (𝒜 0)] {m : ℕ} (x : Fin (m + 1 + 1) → A) (hx : ∀ i, x i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

include hx hgen

/-- **`Γ(X, ℱ(d))` is a finite `A₀`-module** for `ℱ` coherent: the twist is coherent, and
assertion (2) of [Stacks, Tag 0AG6] at `p = 0` applies to it, sections over an open being left
exact so that their zeroth right derived functor is themselves. -/
theorem moduleFinite_twistedSectionsComponent
    (hF : _root_.SheafOfModules.IsCoherent F) (d : ℤ) :
    Module.Finite (𝒜 0)
      ((ModuleCat.restrictScalars.{u} (coeffScalar 𝒜)).obj
        ((Stacks.Cohomology.sectionsFunctor (AlgebraicGeometry.Proj 𝒜) ⊤).obj
          (twistSheafOfModules 𝒜 F d))) :=
  have hcoh : _root_.SheafOfModules.IsCoherent (twistSheafOfModules 𝒜 F d) :=
    AlgebraicGeometry.ProjectiveSpectrum.Proj.isCoherent_twistSheafOfModules 𝒜
      (adjoin_degreeOne_eq_top 𝒜 x hx hgen) F hF d
  have : Module.Finite (𝒜 0)
      ((ModuleCat.restrictScalars.{u} (coeffScalar 𝒜)).obj
        (((Stacks.Cohomology.sectionsFunctor (AlgebraicGeometry.Proj 𝒜) ⊤).rightDerived 0).obj
          (twistSheafOfModules 𝒜 F d))) :=
    moduleFinite_cohomology_of_isCoherent 𝒜 x hgen (twistSheafOfModules 𝒜 F d) hcoh 0
  Module.Finite.equiv
    (((ModuleCat.restrictScalars.{u} (coeffScalar 𝒜)).mapIso
      ((Stacks.Cohomology.sectionsFunctor
        (AlgebraicGeometry.Proj 𝒜) ⊤).rightDerivedZeroIsoSelf.app
          (twistSheafOfModules 𝒜 F d))).toLinearEquiv)

/-- **The degree-`d` homogeneous piece of `⨁_{n ∈ ℤ} Γ(X, ℱ(n))` spans a finitely generated
`A`-submodule.** The piece is `Γ(X, ℱ(d))`, a finite `A₀`-module, and a degree-zero coefficient
acts through the global functions. -/
theorem fg_span_twistedGlobalSectionsGrading (hF : _root_.SheafOfModules.IsCoherent F)
    (D : TwistedGlobalSectionsModule 𝒜 F) (d : ℤ) :
    letI := D.moduleInst
    (Submodule.span A (twistedGlobalSectionsGrading 𝒜 F d :
      Set (twistedGlobalSections 𝒜 F))).FG := by
  let := D.moduleInst
  let : Module (𝒜 0) (twistedSectionsComponent 𝒜 F d) :=
    ((ModuleCat.restrictScalars.{u} (coeffScalar 𝒜)).obj
      ((Stacks.Cohomology.sectionsFunctor (AlgebraicGeometry.Proj 𝒜) ⊤).obj
        (twistSheafOfModules 𝒜 F d))).isModule
  exact Stacks.Blowup.fg_span_twistedGlobalSectionsGrading_of_moduleFinite 𝒜 F d (𝒜 0)
    (fun r => (r : A)) (fun r s => coeffScalar_smul_of 𝒜 F D r d s)
    (moduleFinite_twistedSectionsComponent 𝒜 F x hx hgen hF d)

/-- **The twisted global sections of a coherent module on `Proj A` are generated in degree one in
all large degrees.** This is the dévissage of
`../ProjTwistDegreeOneStep/Devissage.lean`, whose three inputs are assertion (1) of
[Stacks, Tag 0AG6], assertion (3), and the surjectivity in large degrees of
`A_q ⟶ Γ(X, 𝒪_X(q))`. -/
theorem exists_forall_mem_degreeOneSections (hF : _root_.SheafOfModules.IsCoherent F) :
    ∃ B : ℤ, ∀ d : ℤ, B ≤ d →
      ∀ s : twistedSectionsComponent 𝒜 F ((1 : ℤ) + d),
        s ∈ degreeOneSections 𝒜 F d := by
  obtain ⟨q₀, hq₀⟩ := exists_forall_surjective_degreeSection 𝒜 x hx hgen
  have := isNoetherianRing 𝒜 x hgen
  exact exists_forall_mem_degreeOneSections_of_hasTwistQuotients 𝒜 (q₀ : ℤ)
    (adjoin_degreeOne_eq_top 𝒜 x hx hgen)
    (fun b hb => surjective_degreeZeroToGlobalSections_of_le 𝒜 q₀ hq₀ b hb)
    (isCoherent_twistingSheaf 𝒜 x hx hgen)
    (hasTwistQuotients 𝒜 x hx hgen)
    (fun G hG => exists_isZero_Hgroup_twist_of_isCoherent 𝒜 x hx hgen 1 Nat.one_pos G hG)
    F hF

/-- **Assertion (4) of [Stacks, Tag 0AG6].** For `ℱ` coherent on `X = Proj A` and every `k ∈ ℤ`
the graded `A`-module `⨁_{d ≥ k} H⁰(X, ℱ(d))` is a finite `A`-module. -/
theorem moduleFinite_truncation (hF : _root_.SheafOfModules.IsCoherent F)
    (D : TwistedGlobalSectionsModule 𝒜 F) (k : ℤ) :
    letI := D.moduleInst
    Module.Finite A (TwistedGlobalSectionsModule.truncation 𝒜 F D k) := by
  let := D.moduleInst
  obtain ⟨B, hB⟩ := exists_forall_mem_degreeOneSections 𝒜 F x hx hgen hF
  exact moduleFinite_twistedGlobalSectionsTruncation 𝒜 F D.smul_homogeneous k B
    (fun d => fg_span_twistedGlobalSectionsGrading 𝒜 F x hx hgen hF D d)
    (Stacks.ProjectiveSpace.Cohomology.subset_span_grading_of_forall_mem_degreeOneSections
      𝒜 F D B hB)

end Stacks.ProjCoherentDegreeOne

end
