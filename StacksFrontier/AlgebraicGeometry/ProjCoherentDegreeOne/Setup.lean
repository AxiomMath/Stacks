module

public import StacksFrontier.AlgebraicGeometry.AmpleLocalGeneration.FromExtension
public import StacksFrontier.AlgebraicGeometry.ProjNoetherian.Basic
public import StacksFrontier.AlgebraicGeometry.ProjTwistCoherence.Basic
public import StacksFrontier.AlgebraicGeometry.ProjTwistPowers.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.AmpleTwistingSheaf
public import StacksFrontier.AlgebraicGeometry.RelativeProjChain.PolynomialSurjection
import StacksCore.Tactic.EgaSgaAttribute

/-!
# `Proj` of a graded ring generated by finitely many degree-one elements: the standing data

[Stacks, Tag 0AG6] studies `X = Proj A` for a graded ring `A` whose degree-zero part `A₀` is
Noetherian and which is generated by finitely many elements of `A₁` over `A₀`. This file collects
the consequences of that hypothesis which the four assertions of the tag are proved from, and
proves the first of them.

The generating family is carried as data `x : Fin (n + 1) → A` with `x i ∈ 𝒜 1` and
`Algebra.adjoin (𝒜 0) (Set.range x) = ⊤`; the empty family is not excluded, since a family
indexed by `Fin (n + 1)` may repeat `0`.

## Main results

All in the namespace `Stacks.ProjCoherentDegreeOne`.

* `finiteType`, `isNoetherianRing`: `A` is a finitely generated `A₀`-algebra, hence Noetherian.
* `adjoin_degreeOne_eq_top`: `A₀[A₁] = A`, the hypothesis the degree-one machinery is stated at.
* `isInvertibleModule_twistingSheaf`, `compactSpace`, `isAmple_twistingSheaf_one`: `𝒪(1)` is an
  ample invertible module on `X`.
* `isNoetherian_proj`: **`X` is a Noetherian scheme**, the first assertion of [Stacks, Tag 0AG6].
* `isCoherent_twistingSheaf`: every twist `𝒪(d)` is coherent.
* `exists_epi_coproduct_twistingSheaf`: **assertion (1) of [Stacks, Tag 0AG6]**, a surjection
  `⨁_{j = 1, …, r} 𝒪(d_j) ⟶ ℱ` onto a coherent module.

## Implementation notes

No `stacks` attribute is attached in this file. The assertions of [Stacks, Tag 0AG6] are stated
together, as one conjunction, in
`StacksFrontier/AlgebraicGeometry/ProjCoherentDegreeOne/Main.lean`, which is where the attribute
lives; a file proving one assertion is not a covering set for the tag.

## References

* [Stacks Project, Tag 0AG6](https://stacks.math.columbia.edu/tag/0AG6)
* [Stacks Project, Tag 0B5Q](https://stacks.math.columbia.edu/tag/0B5Q)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.ProjectiveSpectrum.Proj

universe u w

namespace Stacks.ProjCoherentDegreeOne

section Pad

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **The generating family may be assumed to have at least two members.** Padding it with
zeroes changes neither the degree-one condition nor the subalgebra it generates, and it is what
lets the statements of [Stacks, Tag 01YS] — which are proved on `ℙⁿ` for `n ≥ 1` — be applied.

The family is allowed to be empty, which is the case `A = A₀` and `Proj A = ∅`. -/
theorem exists_two_le_generators {n : ℕ} (x : Fin n → A) (hx : ∀ i, x i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤) :
    ∃ (m : ℕ) (y : Fin (m + 1 + 1) → A),
      (∀ i, y i ∈ 𝒜 1) ∧ Algebra.adjoin (𝒜 0) (Set.range y) = ⊤ := by
  refine ⟨n, Fin.snoc (Fin.snoc x 0) 0, fun i => ?_,
    top_le_iff.mp (hgen.ge.trans (Algebra.adjoin_mono ?_))⟩
  · induction i using Fin.lastCases with
    | last => simp
    | cast j =>
      induction j using Fin.lastCases with
      | last => simp
      | cast i => simpa using hx i
  · rintro - ⟨i, rfl⟩
    exact ⟨i.castSucc.castSucc, by simp⟩

end Pad


variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {n : ℕ} (x : Fin (n + 1) → A) (hx : ∀ i, x i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

include hgen

/-- **`A` is a finitely generated `A₀`-algebra**: the chosen degree-one family generates it. -/
theorem finiteType : Algebra.FiniteType (𝒜 0) A := by
  classical
  refine ⟨⟨Finset.univ.image x, ?_⟩⟩
  rw [← hgen]
  congr 1
  simp

include hx

omit hx in
/-- **`A` is Noetherian** when `A₀` is: it is a finitely generated `A₀`-algebra, so the Hilbert
basis theorem applies. -/
theorem isNoetherianRing [IsNoetherianRing (𝒜 0)] : IsNoetherianRing A :=
  have := finiteType 𝒜 x hgen
  Algebra.FiniteType.isNoetherianRing (𝒜 0) A

omit hgen [CommRing A] [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- The chosen generators lie in the degree-one part, read as a subset inclusion. -/
theorem range_subset_degreeOne : Set.range x ⊆ (𝒜 1 : Set A) := by
  rintro - ⟨i, rfl⟩
  exact hx i

/-- **`A` is generated by the whole of `A₁` over `A₀`.** This is the hypothesis at which the
degree-one machinery of the library is stated, and it is weaker than the tag's. -/
theorem adjoin_degreeOne_eq_top : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤ :=
  top_le_iff.mp (hgen.ge.trans (Algebra.adjoin_mono (range_subset_degreeOne 𝒜 x hx)))

/-- **The standard opens of the chosen generators cover `Proj A`.** -/
theorem iSup_basicOpen_eq_top : (⨆ i, AlgebraicGeometry.Proj.basicOpen 𝒜 (x i)) = ⊤ :=
  AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 x (fun i => ⟨1, hx i⟩) hgen

omit hx in
/-- **`Proj A` is quasi-compact**: the structure morphism to `Spec A₀` is quasi-compact, `A`
being a finitely generated `A₀`-algebra, and `Spec A₀` is quasi-compact. -/
theorem compactSpace : CompactSpace (AlgebraicGeometry.Proj 𝒜) :=
  have := finiteType 𝒜 x hgen
  QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)

/-- **Every twist `𝒪(d)` is invertible on `Proj A`**: this is [Stacks, Tag 01MW] for a graded
ring generated in degree one. -/
@[ega "II 2.6.1" "special case",
  ega "II 3.2.5" "Second assertion",
  ega "II 8.6.4" "partial",
  ega "III 2.3.4" "(i)"]
theorem isInvertibleModule_twistingSheaf (d : ℤ) :
    Stacks.Ample.IsInvertibleModule (AlgebraicGeometry.Proj 𝒜) (twistingSheaf 𝒜 d) :=
  Stacks.AlgebraicGeometry.TwistMapsInvertible.isInvertibleModule_twistingSheaf_of_adjoin 𝒜
    (adjoin_degreeOne_eq_top 𝒜 x hx hgen) d

/-- The chosen generators as a common-degree cover of `Proj A` in degree one. -/
def commonDegreeCover : AlgebraicGeometry.Proj.CommonDegreeCover 𝒜 ⊤ :=
  letI : DecidableEq A := Classical.decEq _
  { degree := 1
    degree_pos := Nat.one_pos
    sections := Finset.univ.image x
    sections_mem := fun f hf => by
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hf
      exact hx i
    iSup_basicOpen_inf_eq :=
      le_antisymm le_top
        ((iSup_basicOpen_eq_top 𝒜 x hx hgen).ge.trans
          (iSup_le fun i => le_iSup_of_le (x i)
            (le_iSup_of_le (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)
              (le_inf le_rfl le_top)))) }

/-- The common-degree cover `commonDegreeCover` has degree one. -/
@[simp]
theorem commonDegreeCover_degree : (commonDegreeCover 𝒜 x hx hgen).degree = 1 := rfl

/-- **`𝒪(1)` is ample on `Proj A`.** The generators cover in degree one, and `𝒪(1)` is
invertible. -/
theorem isAmple_twistingSheaf_one :
    letI := isInvertibleModule_twistingSheaf 𝒜 x hx hgen 1
    Stacks.Ample.IsAmple (AlgebraicGeometry.Proj 𝒜) (twistingSheaf 𝒜 1) :=
  let := isInvertibleModule_twistingSheaf 𝒜 x hx hgen 1
  let := compactSpace 𝒜 x hgen
  Stacks.ProjectiveSpace.isAmple_twistingSheaf_of_commonDegreeCover 𝒜
    (commonDegreeCover 𝒜 x hx hgen) (by norm_num)

/-- **`𝒪(1)` resolves coherent modules**, in the form the ample machine states it. -/
theorem isQuotientOfNegativeTwists :
    letI := isInvertibleModule_twistingSheaf 𝒜 x hx hgen 1
    Stacks.AmpleGlobalGeneration.IsQuotientOfNegativeTwists (AlgebraicGeometry.Proj 𝒜)
      (twistingSheaf 𝒜 1) :=
  let := isInvertibleModule_twistingSheaf 𝒜 x hx hgen 1
  Stacks.AmpleLocalGeneration.isQuotientOfNegativeTwists_of_isAmple
    (X := AlgebraicGeometry.Proj 𝒜) (twistingSheaf 𝒜 1)
    (isAmple_twistingSheaf_one 𝒜 x hx hgen)

omit hx in
/-- **`Proj A` is a Noetherian scheme**, the opening assertion of [Stacks, Tag 0AG6]. -/
theorem isNoetherian_proj [IsNoetherianRing (𝒜 0)] :
    AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) :=
  have := isNoetherianRing 𝒜 x hgen
  Stacks.AlgebraicGeometry.Proj.isNoetherian_proj 𝒜

/-- **Every twist `𝒪(d)` is coherent**: it is the sheaf associated with the finite graded module
`A(d)` on `Proj` of a Noetherian graded ring. -/
@[ega "III 2.3.4" "special case"]
theorem isCoherent_twistingSheaf [IsNoetherianRing (𝒜 0)] (d : ℤ) :
    _root_.SheafOfModules.IsCoherent (twistingSheaf 𝒜 d) :=
  have := isNoetherianRing 𝒜 x hgen
  AlgebraicGeometry.ProjectiveSpectrum.Proj.isCoherent_twistingSheaf 𝒜
    (adjoin_degreeOne_eq_top 𝒜 x hx hgen) d

/-- **Assertion (1) of [Stacks, Tag 0AG6].** Every coherent `𝒪_X`-module on `X = Proj A` is the
target of an epimorphism from a finite direct sum `⨁_{j = 1, …, r} 𝒪(d_j)` of twisting sheaves.

The ample machine supplies this for `𝒪(1)` ample and invertible, and the tensor powers of `𝒪(1)`
are the twisting sheaves. -/
theorem exists_epi_coproduct_twistingSheaf
    (F : (AlgebraicGeometry.Proj 𝒜).Modules) (hF : _root_.SheafOfModules.IsCoherent F) :
    ∃ (r : ℕ) (d : Fin r → ℤ),
      ∃ φ : (∐ fun j : Fin r => twistingSheaf 𝒜 (d j)) ⟶ F, Epi φ :=
  let := isInvertibleModule_twistingSheaf 𝒜 x hx hgen 1
  open Stacks.AlgebraicGeometry.ProjTwistPowers in
  exists_epi_coproduct_twistingSheaf_of_isCoherent_of_adjoin 𝒜
    (adjoin_degreeOne_eq_top 𝒜 x hx hgen) (isQuotientOfNegativeTwists 𝒜 x hx hgen) F hF

end Stacks.ProjCoherentDegreeOne

end
