-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.ProjectiveSpectrum.Proj (twistingSheaf twistSheafOfModules)
open Stacks.AlgebraicGeometry.ProjTwistFunctor (projRingSheaf)
open Stacks.AlgebraicGeometry.ProjTwistedSections (TwistedGlobalSectionsModule
  twistedGlobalSectionsModule)
open Stacks.Cohomology.AffineBase (moduleGlobalSections)

universe u

namespace Stacks.ProjCoherentDegreeOne

attribute [local instance] HasDerivedCategory.standard

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing (𝒜 0)] {n : ℕ} (x : Fin n → A)
  (hx : ∀ i, x i ∈ 𝒜 1) (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

include hx hgen

/-- **[Stacks, Tag 0AG6].** Let `A` be a graded ring such that `A₀` is Noetherian and `A` is
generated by finitely many elements of `A₁` over `A₀`. Set `X = Proj A`. Then `X` is a Noetherian
scheme, and for every coherent `𝒪_X`-module `ℱ`:

1. there exist an `r ≥ 0`, integers `d₁, …, d_r` and a surjection
   `⨁_{j = 1, …, r} 𝒪_X(d_j) ⟶ ℱ`;
2. for every `p` the cohomology group `H^p(X, ℱ)` is a finite `A₀`-module;
3. if `p > 0` then `H^p(X, ℱ(d)) = 0` for all `d` large enough;
4. for every `k ∈ ℤ` the graded `A`-module `⨁_{d ≥ k} H⁰(X, ℱ(d))` is a finite `A`-module. -/
@[stacks 0AG6, ega "III 2.2.2"]
theorem proj_isNoetherian_and_forall_isCoherent :
    AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) ∧
      ∀ F : SheafOfModules.{u} (projRingSheaf 𝒜), _root_.SheafOfModules.IsCoherent F →
        (∃ (r : ℕ) (d : Fin r → ℤ),
            ∃ φ : (∐ fun j : Fin r => twistingSheaf 𝒜 (d j)) ⟶ F, Epi φ) ∧
          (∀ p : ℕ, Module.Finite (𝒜 0)
            ((ModuleCat.restrictScalars ((Scheme.ΓSpecIso (.of (𝒜 0))).inv ≫
                (AlgebraicGeometry.Proj.toSpecZero 𝒜).appTop).hom).obj
              (((moduleGlobalSections (AlgebraicGeometry.Proj 𝒜)).rightDerived p).obj F))) ∧
          (∀ p : ℕ, 0 < p → ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d →
            IsZero (Hgroup (projRingSheaf 𝒜) ⊤ p (twistSheafOfModules 𝒜 F d))) ∧
          (∀ k : ℤ,
            letI := (twistedGlobalSectionsModule 𝒜 F).moduleInst
            Module.Finite A (TwistedGlobalSectionsModule.truncation 𝒜 F
              (twistedGlobalSectionsModule 𝒜 F) k)) := by
  obtain ⟨m, y, hy, hygen⟩ := exists_two_le_generators 𝒜 x hx hgen
  refine ⟨isNoetherian_proj 𝒜 y hygen, fun F hF => ⟨?_, ?_, ?_, ?_⟩⟩
  · exact exists_epi_coproduct_twistingSheaf 𝒜 y hy hygen F hF
  · exact moduleFinite_cohomology_of_isCoherent 𝒜 y hygen F hF
  · exact fun p hp => exists_isZero_Hgroup_twist_of_isCoherent 𝒜 y hy hygen p hp F hF
  · exact moduleFinite_truncation 𝒜 F y hy hygen hF (twistedGlobalSectionsModule 𝒜 F)

end Stacks.ProjCoherentDegreeOne

end
