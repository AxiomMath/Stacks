module

public import StacksFrontier.AlgebraicGeometry.AffineBaseChangeIso.Transpose

/-!
# Free modules of rank one and extension of scalars

Let `γ : A ⟶ A'` be a homomorphism of commutative rings.  This file proves one statement: an
`A`-linear map `u` from `A` itself to an `A'`-module `P` with its scalars restricted along `γ`,
whose transpose under extension of scalars is invertible, exhibits `P` as a free `A'`-module of
rank one on the image of `1`.

## Main definitions

* `Stacks.LimitSectionsIdentification.spanOne`: the `R`-linear map `R ⟶ N` sending `r` to `r • n`.
* `Stacks.LimitSectionsIdentification.tmulOne`: the map `a ↦ a ⊗ 1` from `A'` to the extension of
  scalars of `A` along `γ`.

## Main results

* `Stacks.LimitSectionsIdentification.bijective_tmulOne`: `a ↦ a ⊗ 1` is a bijection.
* `Stacks.LimitSectionsIdentification.bijective_spanOne_of_isIso_transposeExtend`: if the
  transpose of an `A`-linear map `u : A ⟶ P` is invertible, then `a ↦ a • u 1` is a bijection
  from `A'` onto `P`.

## Implementation notes

Every linear map here is built with `spanOne`, whose module argument is a *variable* of type
`ModuleCat R`.  Writing such a map inline does not elaborate: the coercion of
`(ModuleCat.extendScalars γ).obj M` to a type reduces to a `TensorProduct`, and the `Module`
instance that the extension of scalars carries is then no longer found by instance synthesis.
For the same reason the scalar multiplications are never written out in a goal unless the module
is a variable; where a concrete one is unavoidable the step is `change` against the definitional
unfolding of the two scalar actions.

## References

* [The Stacks Project, Tag 01I9](https://stacks.math.columbia.edu/tag/01I9)
-/

@[expose] public section

noncomputable section

open CategoryTheory
open Stacks.AlgebraicGeometry.AffineBaseChangeIso
open scoped ChangeOfRings

universe u

namespace Stacks.LimitSectionsIdentification

section SpanOne

variable {R : CommRingCat.{u}}

/-- The `R`-linear map out of `R` itself determined by the image of `1`. -/
def spanOne (N : ModuleCat.{u} R) (n : N) : ModuleCat.of R ↑R ⟶ N :=
  ModuleCat.ofHom (LinearMap.toSpanSingleton ↑R ↑N n)

/-- `spanOne N n` sends `r` to `r • n`. -/
theorem spanOne_apply (N : ModuleCat.{u} R) (n : N) (r : R) : spanOne N n r = r • n := rfl

/-- Composing with a linear map moves the generator. -/
theorem spanOne_comp {N P : ModuleCat.{u} R} (n : N) (f : N ⟶ P) :
    spanOne N n ≫ f = spanOne P (f n) := by
  refine ModuleCat.hom_ext (LinearMap.ext fun r => ?_)
  show f (r • n) = r • f n
  exact map_smul _ _ _

/-- **Every linear map out of `R` is `spanOne` of its value at `1`.** -/
theorem spanOne_eq {N : ModuleCat.{u} R} (f : ModuleCat.of R ↑R ⟶ N) :
    f = spanOne N (f (1 : R)) := by
  refine ModuleCat.hom_ext (LinearMap.ext fun r => ?_)
  show f r = r • f 1
  rw [← map_smul]
  show f r = f (r * 1)
  rw [mul_one]

end SpanOne

variable {A A' : CommRingCat.{u}} (γ : A ⟶ A')

/-- The map `a ↦ a ⊗ 1` from `A'` to the extension of scalars of `A` along `γ`. -/
def tmulOne : ModuleCat.of A' ↑A' ⟶ (ModuleCat.extendScalars γ.hom).obj (ModuleCat.of A ↑A) :=
  spanOne _ ((1 : A') ⊗ₜ[A, γ.hom] (1 : A))

/-- `γ` itself, read as an `A`-linear map from `A` to `A'` with its scalars restricted. -/
def gammaLin : ModuleCat.of A ↑A ⟶ (ModuleCat.restrictScalars γ.hom).obj (ModuleCat.of A' ↑A') :=
  spanOne _ (1 : A')

/-- `tmulOne γ` sends `a` to `a ⊗ 1`. -/
theorem tmulOne_apply (a : A') : tmulOne γ a = (a ⊗ₜ[A, γ.hom] (1 : A)) := by
  show ((a * 1 : A') ⊗ₜ[A, γ.hom] (1 : A)) = _
  rw [mul_one]

/-- `gammaLin γ` sends `a` to `γ a`. -/
theorem gammaLin_apply (a : A) : gammaLin γ a = γ.hom a := by
  show γ.hom a * 1 = _
  rw [mul_one]

/-- In the extension of scalars of `A` along `γ`, the scalar `m` can be
moved from the right-hand factor to the left. -/
theorem one_tmul_eq (m : A) :
    ((1 : A') ⊗ₜ[A, γ.hom] m) = ((γ.hom m : A') ⊗ₜ[A, γ.hom] (1 : A)) := by
  have h := congr($(spanOne_eq
    ((ModuleCat.extendRestrictScalarsAdj γ.hom).unit.app (ModuleCat.of A ↑A))).hom m)
  rw [ModuleCat.extendRestrictScalarsAdj_unit_app_apply] at h
  refine h.trans ?_
  show ((γ.hom m * 1 : A') ⊗ₜ[A, γ.hom] (1 : A)) = _
  rw [mul_one]

/-- The transpose of `gammaLin γ` sends `1 ⊗ m` to `γ m`. -/
theorem transposeExtend_gammaLin_one_tmul (m : A) :
    transposeExtend γ (gammaLin γ) ((1 : A') ⊗ₜ[A, γ.hom] m) = γ.hom m := by
  rw [transposeExtend_one_tmul, gammaLin_apply]

/-- Precomposing a transpose with `tmulOne γ` gives the `A'`-linear map generated by `u 1`. -/
private theorem tmulOne_comp_transposeExtend_eq {P : ModuleCat.{u} A'}
    (u : ModuleCat.of A ↑A ⟶ (ModuleCat.restrictScalars γ.hom).obj P) :
    tmulOne γ ≫ transposeExtend γ u = spanOne P (u (1 : A)) :=
  (spanOne_comp _ _).trans (congrArg (spanOne P) (transposeExtend_one_tmul γ u (1 : A)))

/-- The transpose of `gammaLin γ` is a left inverse of `tmulOne γ`. -/
theorem tmulOne_comp_transposeExtend :
    tmulOne γ ≫ transposeExtend γ (gammaLin γ) = 𝟙 _ := by
  have h : gammaLin γ (1 : A) = (1 : A') := by rw [gammaLin_apply, map_one]
  exact (tmulOne_comp_transposeExtend_eq γ _).trans
    ((congrArg (spanOne (ModuleCat.of A' ↑A')) h).trans
      (spanOne_eq (𝟙 (ModuleCat.of A' ↑A'))).symm)

/-- The transpose of `gammaLin γ` is a right inverse of `tmulOne γ`. -/
theorem transposeExtend_comp_tmulOne :
    transposeExtend γ (gammaLin γ) ≫ tmulOne γ = 𝟙 _ := by
  refine ModuleCat.ExtendScalars.hom_ext fun m => ?_
  show tmulOne γ (transposeExtend γ (gammaLin γ) ((1 : A') ⊗ₜ[A, γ.hom] m)) =
    ((1 : A') ⊗ₜ[A, γ.hom] m)
  rw [transposeExtend_gammaLin_one_tmul, tmulOne_apply, ← one_tmul_eq]

/-- **`a ↦ a ⊗ 1` is a bijection from `A'` onto the extension of scalars of `A` along `γ`.** -/
theorem bijective_tmulOne : Function.Bijective (tmulOne γ) :=
  Function.bijective_iff_has_inverse.mpr
    ⟨transposeExtend γ (gammaLin γ),
      fun x => congr($(tmulOne_comp_transposeExtend γ).hom x),
      fun x => congr($(transposeExtend_comp_tmulOne γ).hom x)⟩

/-- **An `A`-linear map out of `A` whose transpose under extension of scalars is invertible
exhibits its target as a free `A'`-module of rank one** on the image of `1`. -/
theorem bijective_spanOne_of_isIso_transposeExtend {P : ModuleCat.{u} A'}
    (u : ModuleCat.of A ↑A ⟶ (ModuleCat.restrictScalars γ.hom).obj P)
    (h : IsIso (transposeExtend γ u)) :
    Function.Bijective (spanOne P (u (1 : A))) := by
  have key := tmulOne_comp_transposeExtend_eq γ u
  have hb : Function.Bijective (transposeExtend γ u) := ConcreteCategory.bijective_of_isIso _
  have hb2 := hb.comp (bijective_tmulOne γ)
  have heq : ∀ a : A', spanOne P (u (1 : A)) a = transposeExtend γ u (tmulOne γ a) :=
    fun a => congr($(key.symm).hom a)
  refine ⟨fun a b hab => hb2.injective (((heq a).symm.trans hab).trans (heq b)), fun p => ?_⟩
  obtain ⟨a, ha⟩ := hb2.surjective p
  exact ⟨a, (heq a).trans ha⟩

/-- An `A`-linear map `u` out of `A` whose transpose under extension of scalars is invertible
exhibits its target as a free `A'`-module of rank one on any `n` with `u 1 = n`.  The generator
is named separately so that it can be given by a definition of its own and the unfolding stays
on the hypothesis. -/
theorem bijective_spanOne_of_isIso_transposeExtend' {P : ModuleCat.{u} A'}
    (u : ModuleCat.of A ↑A ⟶ (ModuleCat.restrictScalars γ.hom).obj P)
    (h : IsIso (transposeExtend γ u)) (n : P) (hn : u (1 : A) = n) :
    Function.Bijective (spanOne P n) :=
  hn ▸ bijective_spanOne_of_isIso_transposeExtend γ u h

end Stacks.LimitSectionsIdentification

end
