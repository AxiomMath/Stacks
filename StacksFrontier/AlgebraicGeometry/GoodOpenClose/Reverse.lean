module

public import StacksFrontier.AlgebraicGeometry.GoodOpenClose.Pointwise
public import StacksFrontier.AlgebraicGeometry.TwistTensor.Basic

/-!
# The locus where the twists are invertible is the ratio locus

Let `S` be a graded ring, `X = Proj(S)` and `d` a natural number. The largest open
`whereInvertible 𝒮 d` on which the `d`-divisible twists are invertible with isomorphic
multiplication maps is contained in the ratio locus `ratioLocus 𝒮 d`, the union of the standard
opens `D₊(fg)` with `deg f = deg g + d`; with
`Stacks.AlgebraicGeometry.TwistTensor.ratioLocus_le_whereInvertible` the two opens are equal.

## Main results

* `Stacks.AlgebraicGeometry.GoodOpenClose.whereInvertible_le_ratioLocus`: the inclusion.
* `Stacks.AlgebraicGeometry.GoodOpenClose.whereInvertible_eq_ratioLocus` and
  `Stacks.AlgebraicGeometry.GoodOpenClose.whereInvertible_eq_iSup_basicOpen_mul`: the identity,
  the second in the indexed-supremum form.

## Implementation notes

Only the multiplication clause of `IsGoodOpen` is used, at the twists `n = 1`, `m = -1`.
Invertibility of `𝒪(1)` alone does not suffice: for `S = k[α, β]` with `deg α = 1`,
`deg β = 2` and `x` the homogeneous prime `(α)`, the degree-one part of the graded localization
at `x` is free of rank one over the local ring, generated by `α/1`, yet `x` lies in no `D₊(fg)`
with `deg f = deg g + 1`, since such `f` and `g` would have degrees of opposite parity while both
must be even. At that point the product of the degree-one and degree-`(-1)` parts lands in the
maximal ideal.

The local `implicit_reducible` attributes on `TopCat.Sheaf`, `sheafCompose` and
`Stacks.SheafOfModules.TensorSheafification.structureSheaf`, and the local `instance_reducible`
attribute on `ProjectiveSpectrum.top`, make the two spellings of the carrier of `Proj 𝒮`
interchangeable for `rw`.

## References

* [Stacks Project, Tag 01MU](https://stacks.math.columbia.edu/tag/01MU)
* [Stacks Project, Tag 01MO](https://stacks.math.columbia.edu/tag/01MO)
* [Stacks Project, Tag 01CA](https://stacks.math.columbia.edu/tag/01CA)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjInvertibleLocus
open scoped TensorProduct

namespace Stacks.AlgebraicGeometry.GoodOpenClose

universe u w

/-! ### Two facts with no `Proj` in them -/

/-- The sheafification unit of a presheaf of abelian groups on a topological space is locally
surjective. -/
theorem isLocallySurjective_toSheafify_opens (T : TopCat.{u})
    (Q : (Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u}) :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology T)
      (CategoryTheory.toSheafify (Opens.grothendieckTopology T) Q) :=
  inferInstance

/-- A morphism of modules on a scheme whose restriction to an open subscheme is an isomorphism is
bijective on the sections over every open contained in that open. -/
theorem bijective_app_of_isIso_restrictFunctor {X : Scheme.{u}} {M N : X.Modules} (φ : M ⟶ N)
    (U : X.Opens) (h : IsIso ((Scheme.Modules.restrictFunctor U.ι).map φ))
    {W : X.Opens} (hWU : W ≤ U) :
    Function.Bijective (((Scheme.Modules.toPresheaf X).map φ).app (op W)).hom := by
  have h2 : IsIso ((Scheme.Modules.toPresheaf U.toScheme).map
      ((Scheme.Modules.restrictFunctor U.ι).map φ)) := by
    have := h
    infer_instance
  rw [NatTrans.isIso_iff_isIso_app] at h2
  have heq : U.ι ''ᵁ (U.ι ⁻¹ᵁ W) = W := by
    simp only [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr hWU
  have h4 : IsIso (((Scheme.Modules.toPresheaf X).map φ).app
      (op (U.ι ''ᵁ (U.ι ⁻¹ᵁ W)))) := h2 (op (U.ι ⁻¹ᵁ W))
  rw [heq] at h4
  exact ConcreteCategory.bijective_of_isIso _

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

/-- The ideal underlying a point of the projective spectrum is prime. -/
local instance instIsPrimeOfPoint (x : ProjectiveSpectrum.top 𝒮) :
    x.asHomogeneousIdeal.toIdeal.IsPrime :=
  x.isPrime

/-! ### The unit section of an untwisted twist -/

/-- The constant function `1` is a section of `𝒪(c)` for every `c` that is zero: it is the
degree-zero fraction `1/1`. -/
theorem one_mem_moduleSections {c : ℤ} (hc : c = 0) (W : Opens (ProjectiveSpectrum.top 𝒮)) :
    (fun _ => 1) ∈ moduleSections 𝒮 (twistGrading (S := S) 𝒮 c) W := by
  intro y
  refine ⟨W, y.2, 𝟙 _, 0, 1, 1, ?_, SetLike.one_mem_graded 𝒮,
    fun z => z.1.isPrime.one_notMem, fun z =>
      (Localization.mk_self ⟨(1 : S), z.1.isPrime.one_notMem⟩).symm⟩
  have hgrad : twistGrading (S := S) 𝒮 c ((0 : ℕ) : ℤ) = homogeneousSubmodule (S := S) 𝒮 0 := by
    rw [twistGrading_apply, hc]
    simpa using integerGrading_natCast (S := S) 𝒮 0
  rw [hgrad]
  exact SetLike.one_mem_graded 𝒮

/-- The section `1` of `𝒪(c)` over `W`, for `c` zero. -/
def oneSection {c : ℤ} (hc : c = 0) (W : Opens (ProjectiveSpectrum.top 𝒮)) :
    moduleSections 𝒮 (twistGrading (S := S) 𝒮 c) W :=
  ⟨fun _ => 1, one_mem_moduleSections 𝒮 hc W⟩

/-- The section `oneSection` takes the value `1` at every point of its domain. -/
@[simp] theorem oneSection_apply {c : ℤ} (hc : c = 0) (W : Opens (ProjectiveSpectrum.top 𝒮))
    (y : W) : (oneSection 𝒮 hc W).1 y = 1 := rfl

/-! ### Evaluating the multiplication map on the presheaf tensor product -/

/-- Evaluation of a section of `𝒪(c)` at a point of its domain, as an additive map. -/
def twistEvalHom (c : ℤ) (W : Opens (ProjectiveSpectrum.top 𝒮)) (y : W) :
    moduleSections 𝒮 (twistGrading (S := S) 𝒮 c) W →+ ModuleFiber (M := S) 𝒮 y.1 where
  toFun s := s.1 y
  map_zero' := rfl
  map_add' _ _ := rfl


/-- The value at a point of the image of an element of the presheaf tensor product under the
sheafification unit followed by the multiplication map, as an additive map. -/
def multEvalHom (a b : ℤ) (W : Opens (ProjectiveSpectrum.top 𝒮)) (y : W) :
    ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val)).obj (op W) →+ ModuleFiber (M := S) 𝒮 y.1 :=
  (twistEvalHom 𝒮 (a + b) W y).comp
    ((((twistMultiplicationMap 𝒮 a b).val.app (op W)).hom.toAddMonoidHom).comp
      ((Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyUnit (AlgebraicGeometry.Proj
        𝒮).toRingedSpace
        ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val))).app (op W)).hom.toAddMonoidHom)

/-- On a pure tensor the value of `multEvalHom` is the product of the two local values. -/
theorem multEvalHom_tmul (a b : ℤ) (W : Opens (ProjectiveSpectrum.top 𝒮)) (y : W)
    (ς : moduleSections 𝒮 (twistGrading (S := S) 𝒮 a) W)
    (τ : moduleSections 𝒮 (twistGrading (S := S) 𝒮 b) W) :
    multEvalHom 𝒮 a b W y (ς ⊗ₜ[_] τ) = ς.1 y * τ.1 y :=
  TwistTensor.twistMultiplicationMap_tmul 𝒮 a b W ς τ y

/-- `multEvalHom` commutes with finite sums. -/
theorem multEvalHom_sum (a b : ℤ) (W : Opens (ProjectiveSpectrum.top 𝒮)) (y : W)
    {ι : Type*} (F : Finset ι) (f : ι →
      ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val)).obj (op W)) :
    multEvalHom 𝒮 a b W y (∑ i ∈ F, f i) = ∑ i ∈ F, multEvalHom 𝒮 a b W y (f i) :=
  map_sum _ _ _

/-- The multiplication map takes an element of the presheaf tensor product whose image under the
sheafification unit is the restriction of a preimage of the section `1` to a section whose value
at every point is `1`. -/
theorem multEvalHom_eq_one {a b : ℤ} (hab : a + b = 0)
    {U W : Opens (ProjectiveSpectrum.top 𝒮)} (i : W ⟶ U)
    (z : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨(((AlgebraicGeometry.Proj
      𝒮).toRingedSpace)).presheaf, (((AlgebraicGeometry.Proj
      𝒮).toRingedSpace)).IsSheaf⟩).obj ((twistingSheaf 𝒮 a))).obj
        ((twistingSheaf 𝒮 b)))).val.obj (op U))
    (t : ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val)).obj (op W))
    (ht : PresheafOfModules.Hom.app (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyUnit
        (AlgebraicGeometry.Proj 𝒮).toRingedSpace
          ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val))) (op W) t
      = ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨(((AlgebraicGeometry.Proj
        𝒮).toRingedSpace)).presheaf, (((AlgebraicGeometry.Proj
        𝒮).toRingedSpace)).IsSheaf⟩).obj ((twistingSheaf 𝒮 a))).obj
          ((twistingSheaf 𝒮 b)))).val.map i.op z)
    (hz : PresheafOfModules.Hom.app (twistMultiplicationMap 𝒮 a b).val (op U) z
      = oneSection 𝒮 hab U) (y : W) :
    multEvalHom 𝒮 a b W y t = 1 := by
  have hstep : PresheafOfModules.Hom.app (twistMultiplicationMap 𝒮 a b).val (op W)
      (PresheafOfModules.Hom.app (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyUnit
        (AlgebraicGeometry.Proj 𝒮).toRingedSpace
          ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val))) (op W) t)
      = (twistingSheaf 𝒮 (a + b)).val.map i.op (oneSection 𝒮 hab U) := by
    rw [ht]
    exact (PresheafOfModules.naturality_apply (twistMultiplicationMap 𝒮 a b).val i.op z).trans
      (congrArg (fun s => (twistingSheaf 𝒮 (a + b)).val.map i.op s) hz)
  exact congrArg
    (fun s : moduleSections 𝒮 (twistGrading (S := S) 𝒮 (a + b)) W => s.1 y) hstep

/-- If `a = d` and the value at `x` under `multEvalHom` of an element of the presheaf tensor
product is `1`, then `x` lies in the ratio locus for `d`. -/
theorem mem_ratioLocus_of_multEvalHom_eq_one {d : ℕ} {a b : ℤ} (ha : a = (d : ℤ))
    {W : Opens (ProjectiveSpectrum.top 𝒮)} {x : ProjectiveSpectrum.top 𝒮} (hxW : x ∈ W)
    (t : ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val)).obj (op W))
    (hval : multEvalHom 𝒮 a b W ⟨x, hxW⟩ t = 1) :
    x ∈ ProjShared.ratioLocus 𝒮 d := by
  obtain ⟨F, hF⟩ := TensorProduct.exists_finset t
  rw [hF] at hval
  have hsum : (∑ p ∈ F, multEvalHom 𝒮 a b W ⟨x, hxW⟩ (p.1 ⊗ₜ[_] p.2)) = 1 :=
    (multEvalHom_sum 𝒮 a b W ⟨x, hxW⟩ F (fun p => p.1 ⊗ₜ[_] p.2)).symm.trans hval
  exact mem_ratioLocus_of_sum_eq_one 𝒮 ha hxW F (fun p => p.1) (fun p => p.2)
    ((Finset.sum_congr rfl fun p (_ : p ∈ F) =>
      (multEvalHom_tmul 𝒮 a b W ⟨x, hxW⟩ p.1 p.2).symm).trans hsum)

/-! ### The reverse inclusion -/

/-- If the multiplication map `𝒪(a) ⊗ 𝒪(b) ⟶ 𝒪(a+b)` becomes an isomorphism on the open
subscheme `U`, where `a = d` and `a + b = 0`, then every point of `U` lies in the ratio locus
for `d`. -/
theorem mem_ratioLocus_of_isIso_mul {d : ℕ} {a b : ℤ} (ha : a = (d : ℤ)) (hab : a + b = 0)
    {U : (AlgebraicGeometry.Proj 𝒮).Opens}
    (hmul : IsIso ((Scheme.Modules.restrictFunctor U.ι).map (twistMultiplicationMap 𝒮 a b)))
    {x : ProjectiveSpectrum.top 𝒮} (hx : x ∈ U) :
    x ∈ ProjShared.ratioLocus 𝒮 d := by
  obtain ⟨z, hz⟩ :=
    (bijective_app_of_isIso_restrictFunctor (twistMultiplicationMap 𝒮 a b) U hmul
      (le_refl U)).2 (oneSection 𝒮 hab U)
  have hsurj : Presheaf.IsLocallySurjective
      (Opens.grothendieckTopology ↑(AlgebraicGeometry.Proj 𝒮).toRingedSpace.toPresheafedSpace)
      ((PresheafOfModules.toPresheaf _).map
        (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyUnit (AlgebraicGeometry.Proj
          𝒮).toRingedSpace
          ((PresheafOfModules.tensorObj (O := (AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
      (twistingSheaf 𝒮 a).val (twistingSheaf 𝒮 b).val)))) := by
    exact isLocallySurjective_toSheafify_opens _ _
  obtain ⟨W, i, ⟨t, ht⟩, hxW⟩ :=
    (Opens.mem_grothendieckTopology _).1 (hsurj.imageSieve_mem z) x hx
  exact mem_ratioLocus_of_multEvalHom_eq_one 𝒮 ha hxW t
    (multEvalHom_eq_one 𝒮 hab i z t ht hz ⟨x, hxW⟩)

/-- A point of a good open lies in the ratio locus. -/
theorem mem_ratioLocus_of_isGoodOpen (d : ℕ) {U : (AlgebraicGeometry.Proj 𝒮).Opens}
    (hU : IsGoodOpen 𝒮 d U) {x : ProjectiveSpectrum.top 𝒮} (hx : x ∈ U) :
    x ∈ ProjShared.ratioLocus 𝒮 d :=
  mem_ratioLocus_of_isIso_mul 𝒮 (mul_one (d : ℤ)) (by ring) (hU.2 1 (-1)) hx

/-- The open `whereInvertible 𝒮 d` is contained in the ratio locus for `d`. -/
theorem whereInvertible_le_ratioLocus (d : ℕ) :
    whereInvertible 𝒮 d ≤ ProjShared.ratioLocus 𝒮 d := by
  intro x hx
  obtain ⟨V, hV, hxV⟩ := Opens.mem_sSup.mp hx
  exact mem_ratioLocus_of_isGoodOpen 𝒮 d hV hxV

/-- The largest open on which the
`d`-divisible twists are invertible with isomorphic multiplication maps is the union of the
standard opens `D₊(fg)` with `deg f = deg g + d`. -/
theorem whereInvertible_eq_ratioLocus (d : ℕ) :
    whereInvertible 𝒮 d = ProjShared.ratioLocus 𝒮 d :=
  le_antisymm (whereInvertible_le_ratioLocus 𝒮 d) (TwistTensor.ratioLocus_le_whereInvertible 𝒮 d)

/-- `whereInvertible 𝒮 d` is the union of the standard opens `D₊(fg)` with `f` homogeneous of
degree `e + d` and `g` homogeneous of degree `e`. -/
theorem whereInvertible_eq_iSup_basicOpen_mul (d : ℕ) :
    whereInvertible 𝒮 d =
      ⨆ (e : ℕ) (f : 𝒮 (e + d)) (g : 𝒮 e),
        AlgebraicGeometry.Proj.basicOpen 𝒮 ((f : S) * (g : S)) :=
  (whereInvertible_eq_ratioLocus 𝒮 d).trans (iSup_basicOpen_mul_eq_ratioLocus 𝒮 d).symm

end Stacks.AlgebraicGeometry.GoodOpenClose

end
