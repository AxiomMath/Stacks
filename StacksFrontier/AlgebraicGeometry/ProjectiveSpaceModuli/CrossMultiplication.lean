/-!
# The cross-multiplication criterion for maps to projective space

Let `X` be a scheme and let `(L, (s₀, …, sₙ))` and `(L', (s'₀, …, s'ₙ))` be two invertible
`𝒪_X`-modules, each with `n + 1` global sections generating it. By [Stacks, Tag 01NE] each pair
determines a morphism `X ⟶ ℙⁿ_ℤ`, and the two morphisms agree exactly when there is an
isomorphism `L ≅ L'` carrying `sᵢ` to `s'ᵢ`. This file gives the practical test for that: the two
pairs are identified as soon as they *cross-multiply*,

  `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` in `L ⊗ L'` for all `i, j`,

the way two vectors of homogeneous coordinates define the same point when their two-by-two
minors vanish. Conversely two identified pairs cross-multiply, so the condition characterizes the
identification of Tag 01NE.

The proof compares charts. On `X_{sᵢ}` the section `sᵢ` is a basis of `L`, so tensoring with it is
injective, and the cross-multiplication `sᵢ ⊗ s'ₖ = sₖ ⊗ s'ᵢ = sᵢ ⊗ (sₖ/sᵢ) s'ᵢ` gives
`s'ₖ = (sₖ/sᵢ) s'ᵢ` there. As the `s'ₖ` generate `L'`, this forces `X_{sᵢ} ⊆ X_{s'ᵢ}`; by symmetry
the two charts agree, the two ratio families agree on them, and so the morphism pinned by the first
pair is pinned by the second.

From the criterion and the naturality of Tag 01NE one gets the **glueing statement**: morphisms
to `ℙⁿ_ℤ` given on the members of an open cover by generating tuples that cross-multiply on the
overlaps glue to a unique morphism on `X`.

## Main definitions

* `Stacks.ProjectiveSpaceModuli.CrossMultiplies`: two families of global sections
  cross-multiply, read on the stalks: `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` in `L_x ⊗_{𝒪_{X,x}} L'_x` at every
  point `x`.

## Main results

* `Stacks.ProjectiveSpaceModuli.crossMultiplies_of_tensorSectionsAt` and
  `crossMultiplies_of_tensorSection`: cross-multiplication of global sections in `L ⊗ L'`, for
  either of the two tensor products of `𝒪_X`-modules, implies the stalkwise condition.
* `Stacks.ProjectiveSpaceModuli.isomorphic_of_crossMultiplies`: **the criterion**, two
  generating tuples that cross-multiply are identified by an isomorphism `L ≅ L'` matching the
  sections; `crossMultiplies_iff_isomorphic` adds the converse.
* `Stacks.ProjectiveSpaceModuli.toProjectiveSpaceAtUniverse_eq_of_crossMultiplies`: **the two
  induced morphisms `X ⟶ ℙⁿ_ℤ` are equal.** `isomorphic_of_tensorSectionsAt` and
  `toProjectiveSpaceAtUniverse_eq_of_tensorSectionsAt` are the two statements with the
  hypothesis written in `L ⊗ L'`.
* `Stacks.ProjectiveSpaceModuli.exists_unique_hom_of_crossMultiplies`: **the glueing statement.**

## Implementation notes

The condition is stated on stalks rather than on global sections of a chosen tensor product
sheaf. The repository has two tensor products of `𝒪_X`-modules — the sheafified sectionwise one,
`AlgebraicGeometry.Scheme.Modules.tensorObj`, and the localized monoidal structure of
`Stacks.SectionTensorFormula` — and both have the stalk of `L ⊗ L'` at `x` equal to
`L_x ⊗ L'_x` with the germ of a pure tensor of sections the pure tensor of the germs. The
stalkwise condition is what the proof uses, and the global form for either tensor product implies
it (`crossMultiplies_of_tensorSectionsAt`, `crossMultiplies_of_tensorSection`).

## References

* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped TensorProduct
open Stacks.ProjectiveFromSections

universe u

namespace TensorProduct

/-- **Tensoring with a basis of a free module of rank one is injective**: if `r ↦ r • e` is a
bijection `R ≃ M`, then `n ↦ e ⊗ n` is injective, `M ⊗ N` being `N` through `e`. -/
theorem injective_tmul_of_bijective_smul {R M N : Type*} [CommSemiring R] [AddCommMonoid M]
    [Module R M] [AddCommMonoid N] [Module R N] {e : M}
    (he : Function.Bijective fun r : R => r • e) :
    Function.Injective fun n : N => e ⊗ₜ[R] n := by
  let φ : M ≃ₗ[R] R := (LinearEquiv.ofBijective (LinearMap.toSpanSingleton R M e) he).symm
  have hφ : φ e = 1 := (LinearEquiv.symm_apply_eq _).2 (one_smul R e).symm
  intro n n' h
  have := congrArg ((TensorProduct.lid R N).toLinearMap ∘ₗ
    TensorProduct.map φ.toLinearMap LinearMap.id) h
  simpa [hφ] using this

/-- **In a cyclic module the two pairings through a linear map agree**: if `M` is generated by
one element, then `m ⊗ f m' = m' ⊗ f m` in `M ⊗ N` for every linear `f : M → N`. -/
theorem tmul_apply_comm_of_surjective_smul {R M N : Type*} [CommSemiring R] [AddCommMonoid M]
    [Module R M] [AddCommMonoid N] [Module R N] {e : M}
    (he : Function.Surjective fun r : R => r • e) (f : M →ₗ[R] N) (m m' : M) :
    m ⊗ₜ[R] f m' = m' ⊗ₜ[R] f m := by
  obtain ⟨a, rfl⟩ := he m
  obtain ⟨b, rfl⟩ := he m'
  simp only [map_smul, TensorProduct.tmul_smul, ← TensorProduct.smul_tmul']
  exact smul_comm b a _

end TensorProduct

namespace Stacks.ProjectiveSpaceModuli

variable {X : Scheme.{u}} {n : ℕ} {ι : Type*} {L L' : X.Modules}

/-! ### The cross-multiplication condition -/

/-- **Two families of global sections cross-multiply**: `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` for all `i, j`,
read in the tensor product `L_x ⊗_{𝒪_{X,x}} L'_x` of the stalks at every point `x`. -/
def CrossMultiplies (s : ι → Γ(L, ⊤)) (s' : ι → Γ(L', ⊤)) : Prop :=
  ∀ (x : X) (i j : ι),
    (L.presheaf.Γgerm x).hom (s i) ⊗ₜ[X.presheaf.stalk x] (L'.presheaf.Γgerm x).hom (s' j) =
      (L.presheaf.Γgerm x).hom (s j) ⊗ₜ[X.presheaf.stalk x] (L'.presheaf.Γgerm x).hom (s' i)

/-- Cross-multiplication is symmetric in the two families. -/
theorem CrossMultiplies.symm {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)} (h : CrossMultiplies s s') :
    CrossMultiplies s' s := fun x i j => by
  simpa using congrArg (TensorProduct.comm _ _ _) (h x j i)

/-- **Cross-multiplication in `L ⊗ L'`**: if `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` as global sections of
`AlgebraicGeometry.Scheme.Modules.tensorObj L L'`, the two families cross-multiply. The stalk of
the tensor product is the tensor product of the stalks (Tag 01CB), compatibly with germs. -/
theorem crossMultiplies_of_tensorSectionsAt {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)}
    (h : ∀ i j,
      Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) L L'
          (s i) (s' j) =
        Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) L L'
          (s j) (s' i)) :
    CrossMultiplies s s' := fun x i j =>
  (tensorStalkEquiv_germ L L' x ⊤ trivial (s i) (s' j)).symm.trans
    ((congrArg (fun z => tensorStalkEquiv L L' x
        ((Scheme.Modules.tensorObj L L').presheaf.germ ⊤ x trivial z)) (h i j)).trans
      (tensorStalkEquiv_germ L L' x ⊤ trivial (s j) (s' i)))

section Localized

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso Stacks.SheafInternalHom.isLocalization_sheafify
  Stacks.SheafInternalHom.monoidalCategory Stacks.SheafInternalHom.sheafifyMonoidal
  Stacks.SheafInternalHom.braidedCategory Stacks.SheafInternalHom.schemeMonoidalCategory

/-- **The two products of sections detect the same equalities.** Two pure tensors of sections
over `U` agree in the localized monoidal product `L ⊗ L'` of `Stacks.SectionTensorFormula` exactly
when they agree in the sheafified sectionwise one: the former is the latter read through the
isomorphism `Stacks.SectionTensorFormula.tensorSheafIsoTensorObj`. This is the direction used. -/
theorem tensorSectionsAt_eq_of_tensorSection_eq {U : X.Opens} {m m' : Γ(L, U)}
    {p p' : Γ(L', U)}
    (h : Stacks.SectionTensorFormula.tensorSection L L' m p =
      Stacks.SectionTensorFormula.tensorSection L L' m' p') :
    Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op U) L L' m p =
      Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op U) L L'
        m' p' := by
  set e := Stacks.SectionTensorFormula.tensorSheafIsoTensorObj X.presheaf
    (Stacks.SectionTensorFormula.schemeSheafCondition X) L L'
  have key : ∀ z, e.inv.val.app (op U) (e.hom.val.app (op U) z) = z := fun z => by
    show ((e.hom ≫ e.inv).val.app (op U)) z = z
    rw [e.hom_inv_id]
    rfl
  exact (key _).symm.trans ((congrArg (e.inv.val.app (op U)) h).trans (key _))

/-- **Cross-multiplication in the localized `L ⊗ L'`**: if `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` as global
sections of the monoidal product of `Stacks.SectionTensorFormula`, the two families
cross-multiply. -/
theorem crossMultiplies_of_tensorSection {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)}
    (h : ∀ i j, Stacks.SectionTensorFormula.tensorSection L L' (s i) (s' j) =
      Stacks.SectionTensorFormula.tensorSection L L' (s j) (s' i)) :
    CrossMultiplies s s' :=
  crossMultiplies_of_tensorSectionsAt fun i j => tensorSectionsAt_eq_of_tensorSection_eq (h i j)

end Localized

/-! ### Comparison of the charts and of the ratios -/

variable [Stacks.Ample.IsInvertibleModule X L]

/-- The germ of `sᵢ` is a basis of the stalk of `L` at any point of `X_{sᵢ}`. -/
private theorem bijective_smul_Γgerm_of_mem_nvCover {s : ι → Γ(L, ⊤)} {x : X} {i : ι}
    (hx : x ∈ nvCover s i) :
    Function.Bijective fun r : X.presheaf.stalk x => r • (L.presheaf.Γgerm x).hom (s i) :=
  Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus L (s i)
    ((Stacks.NonvanishingOpen.mem_nonvanishingOpen X L (s i) x).1 hx)

/-- **The ratios transfer at a stalk.** Where `sᵢ` does not vanish, a germ `a` with
`a sᵢ = sₖ` also satisfies `a s'ᵢ = s'ₖ`: the germ of `sᵢ` is a basis, so tensoring with it is
injective, and `sᵢ ⊗ s'ₖ = sₖ ⊗ s'ᵢ = sᵢ ⊗ a s'ᵢ`. -/
theorem smul_Γgerm_eq_of_crossMultiplies {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)}
    (h : CrossMultiplies s s') {x : X} {i : ι} (hx : x ∈ nvCover s i) (k : ι)
    {a : X.presheaf.stalk x}
    (ha : a • (L.presheaf.Γgerm x).hom (s i) = (L.presheaf.Γgerm x).hom (s k)) :
    a • (L'.presheaf.Γgerm x).hom (s' i) = (L'.presheaf.Γgerm x).hom (s' k) := by
  apply TensorProduct.injective_tmul_of_bijective_smul (bijective_smul_Γgerm_of_mem_nvCover hx)
  dsimp only
  rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', ha, h x i k]

/-- The germ at `x ∈ W` of `a • resT W m` is the germ of `a` times the germ of `m`. -/
private theorem germ_smul_resT {M : X.Modules} {W : X.Opens} {x : X} (hx : x ∈ W) (a : Γ(X, W))
    (m : Γ(M, ⊤)) :
    M.presheaf.germ W x hx (a • resT W m) =
      X.presheaf.germ W x hx a • (M.presheaf.Γgerm x).hom m := by
  rw [Scheme.Modules.germ_smul, M.presheaf.germ_res_apply]
  rfl

/-- **The ratios transfer on an open inside `X_{sᵢ}`**: if `a sᵢ = sₖ` there, then
`a s'ᵢ = s'ₖ` there. -/
theorem smul_resT_eq_of_crossMultiplies {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)}
    (h : CrossMultiplies s s') {i k : ι} {W : X.Opens} (hW : W ≤ nvCover s i) {a : Γ(X, W)}
    (ha : a • resT W (s i) = resT W (s k)) :
    a • resT W (s' i) = resT W (s' k) := by
  refine TopCat.Presheaf.section_ext ⟨L'.presheaf, L'.isSheaf⟩ W _ _ fun x hx => ?_
  have hga := congrArg (L.presheaf.germ W x hx) ha
  rw [germ_smul_resT, L.presheaf.germ_res_apply] at hga
  change L'.presheaf.germ W x hx _ = L'.presheaf.germ W x hx _
  rw [germ_smul_resT, L'.presheaf.germ_res_apply]
  exact smul_Γgerm_eq_of_crossMultiplies h (hW hx) k hga

/-- **The charts are nested**: if the two families cross-multiply and the second generates `L'`,
then `X_{sᵢ} ⊆ X_{s'ᵢ}`. On `X_{sᵢ}` every `s'ₖ` is a multiple of `s'ᵢ`, so `s'ᵢ` generates the
stalks of `L'` there. -/
theorem nvCover_le_of_crossMultiplies [Stacks.Ample.IsInvertibleModule X L']
    {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)} (h : CrossMultiplies s s')
    (hs' : GeneratesStalks s') (i : ι) : nvCover s i ≤ nvCover s' i := by
  intro x hx
  show x ∈ Stacks.NonvanishingOpen.nonvanishingOpen X L' (s' i)
  rw [Stacks.NonvanishingOpen.mem_nonvanishingOpen, Stacks.Ample.mem_nonvanishingLocus_iff]
  intro hmem
  obtain ⟨w, hw⟩ := Stacks.SectionProduct.exists_notMem_maximalSmul L' x
  obtain ⟨T, r, hwr⟩ := hs' x w
  refine hw (hwr ▸ Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ ?_)
  have hga := congrArg (L.presheaf.germ (nvCover s i) x hx) (ratio_smul s i k)
  rw [germ_smul_resT, L.presheaf.germ_res_apply] at hga
  rw [← smul_Γgerm_eq_of_crossMultiplies h hx k hga]
  exact Submodule.smul_mem _ _ hmem

/-- **The ratios agree**: on a chart `X_{s'ᵢ} ⊆ X_{sᵢ}` the ratio `s'ₖ/s'ᵢ` is the restriction of
`sₖ/sᵢ`. -/
theorem ratio_eq_resO_ratio_of_crossMultiplies [Stacks.Ample.IsInvertibleModule X L']
    {s : ι → Γ(L, ⊤)} {s' : ι → Γ(L', ⊤)} (h : CrossMultiplies s s') {i : ι}
    (hle : nvCover s' i ≤ nvCover s i) (k : ι) :
    ratio s' i k = resO hle (ratio s i k) :=
  (eq_div (s' i) le_rfl (smul_resT_eq_of_crossMultiplies h hle (resO_ratio_smul s hle k))).symm

/-- **The chart morphisms agree**: if a morphism restricts on `X_{sᵢ}` to the morphism of the
ratios `sₖ/sᵢ`, it restricts on `X_{s'ᵢ} ⊆ X_{sᵢ}` to the morphism of the ratios `s'ₖ/s'ᵢ`. -/
theorem ι_comp_eq_of_crossMultiplies [Stacks.Ample.IsInvertibleModule X L']
    {s : Fin (n + 1) → Γ(L, ⊤)} {s' : Fin (n + 1) → Γ(L', ⊤)} (h : CrossMultiplies s s')
    {i : Fin (n + 1)} (hle : nvCover s' i ≤ nvCover s i)
    (g : X ⟶ projectiveSpaceAtUniverse.{u} n)
    (hg : (nvCover s i).ι ≫ g =
      SectionsToProjectiveSpace.toProjectiveSpaceAtUniverse (chartRatio s i)
        (span_range_chartRatio s i)) :
    (nvCover s' i).ι ≫ g =
      SectionsToProjectiveSpace.toProjectiveSpaceAtUniverse (chartRatio s' i)
        (span_range_chartRatio s' i) := by
  have hfam : (fun k => (X.homOfLE hle).appTop (chartRatio s i k)) = chartRatio s' i := by
    funext k
    rw [chartRatio, homOfLE_appTop_topIso_inv, chartRatio,
      ratio_eq_resO_ratio_of_crossMultiplies h hle k]
  rw [← X.homOfLE_ι hle, Category.assoc, hg,
    Stacks.ProjGlobalSectionsAppTop.hasPullbackNaturality (X.homOfLE hle) _ _
      (hfam ▸ span_range_chartRatio s' i)]
  exact SectionsToProjectiveSpace.toProjectiveSpaceAtUniverse_congr hfam _ _

/-! ### The criterion -/

/-- **A morphism pinned by one pair is pinned by every pair cross-multiplying with it.** -/
theorem isPinned_of_crossMultiplies {t t' : GeneratingTuple X n}
    (h : CrossMultiplies t.coord t'.coord) {g : X ⟶ projectiveSpaceAtUniverse.{u} n}
    (hg : IsPinned t g) : IsPinned t' g := fun i =>
  ι_comp_eq_of_crossMultiplies h (nvCover_le_of_crossMultiplies h.symm t.generates i) g (hg i)

/-- **The cross-multiplication criterion.** Two invertible modules with generating tuples
`(L, (sᵢ))` and `(L', (s'ᵢ))` satisfying `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` are identified in the sense of
Tag 01NE: there is an isomorphism `L ≅ L'` carrying each `sᵢ` to `s'ᵢ`. -/
theorem isomorphic_of_crossMultiplies {t t' : GeneratingTuple X n}
    (h : CrossMultiplies t.coord t'.coord) : Isomorphic t t' := by
  obtain ⟨g, hg⟩ := pointsOfHom_surjective (⟦t⟧ : Points X n)
  have hp : IsPinned t g := isPinned_of_isomorphic (Quotient.exact hg) (isPinned_tautological g)
  exact isomorphic_trans (isomorphic_symm (isomorphic_tautological_of_isPinned hp))
    (isomorphic_tautological_of_isPinned (isPinned_of_crossMultiplies h hp))

/-- **The converse**: two identified pairs cross-multiply. The stalks of an invertible module are
free of rank one, and in a cyclic module `m ⊗ β m' = m' ⊗ β m`. -/
theorem crossMultiplies_of_isomorphic {t t' : GeneratingTuple X n} (h : Isomorphic t t') :
    CrossMultiplies t.coord t'.coord := by
  obtain ⟨β, hβ⟩ := h
  intro x i j
  obtain ⟨k, hk⟩ := exists_mem_nvCover_of_generatesStalks t.coord t.generates x
  let f : t.bundle.presheaf.stalk x →ₗ[X.presheaf.stalk x] t'.bundle.presheaf.stalk x :=
    { toFun := Stacks.ModuleStalk.mapFun β.hom x
      map_add' := Stacks.ModuleStalk.mapFun_add β.hom x
      map_smul' := Stacks.ModuleStalk.mapFun_smul β.hom x }
  have hf : ∀ l, (t'.bundle.presheaf.Γgerm x).hom (t'.coord l) =
      f ((t.bundle.presheaf.Γgerm x).hom (t.coord l)) := fun l => by
    rw [← hβ l]
    exact (Stacks.ModuleStalk.mapFun_Γgerm β.hom x (t.coord l)).symm
  rw [hf j, hf i]
  exact TensorProduct.tmul_apply_comm_of_surjective_smul
    (bijective_smul_Γgerm_of_mem_nvCover hk).2 f _ _

/-- **Cross-multiplication is the identification of Tag 01NE.** -/
theorem crossMultiplies_iff_isomorphic {t t' : GeneratingTuple X n} :
    CrossMultiplies t.coord t'.coord ↔ Isomorphic t t' :=
  ⟨isomorphic_of_crossMultiplies, crossMultiplies_of_isomorphic⟩

/-- Cross-multiplication is preserved by pullback along any morphism of schemes. -/
theorem CrossMultiplies.pullbackTuple {Y : Scheme.{u}} (f : Y ⟶ X) {t t' : GeneratingTuple X n}
    (h : CrossMultiplies t.coord t'.coord) :
    CrossMultiplies (pullbackTuple f t).coord (pullbackTuple f t').coord :=
  crossMultiplies_of_isomorphic (pullbackTuple_isomorphic f (isomorphic_of_crossMultiplies h))

/-- **The two classifying morphisms agree**: cross-multiplying pairs have the same class under
the bijection of Tag 01NE. -/
theorem pointsEquiv_symm_eq_of_crossMultiplies {t t' : GeneratingTuple X n}
    (h : CrossMultiplies t.coord t'.coord) :
    (pointsEquiv X n).symm ⟦t⟧ = (pointsEquiv X n).symm ⟦t'⟧ :=
  congrArg _ (Quotient.sound (isomorphic_of_crossMultiplies h))

/-- **The two induced morphisms `X ⟶ ℙⁿ_ℤ` are equal**: the morphisms glued from the ratios of
two cross-multiplying generating families coincide. -/
theorem toProjectiveSpaceAtUniverse_eq_of_crossMultiplies [Stacks.Ample.IsInvertibleModule X L']
    {s : Fin (n + 1) → Γ(L, ⊤)} (hs : GeneratesStalks s) {s' : Fin (n + 1) → Γ(L', ⊤)}
    (hs' : GeneratesStalks s') (h : CrossMultiplies s s') :
    ProjectiveFromSections.toProjectiveSpaceAtUniverse s hs =
      ProjectiveFromSections.toProjectiveSpaceAtUniverse s' hs' := by
  let t : GeneratingTuple X n := ⟨L, inferInstance, s, hs⟩
  let t' : GeneratingTuple X n := ⟨L', inferInstance, s', hs'⟩
  exact eq_of_isPinned (isPinned_of_crossMultiplies (t := t) (t' := t') h
    (ι_toProjectiveSpaceAtUniverse s hs)) (ι_toProjectiveSpaceAtUniverse s' hs')

/-- **The criterion with the hypothesis in `L ⊗ L'`**: if `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` as global
sections of `AlgebraicGeometry.Scheme.Modules.tensorObj L L'`, there is an isomorphism
`L ≅ L'` carrying each `sᵢ` to `s'ᵢ`. -/
theorem isomorphic_of_tensorSectionsAt {t t' : GeneratingTuple X n}
    (h : ∀ i j,
      Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤)
          t.bundle t'.bundle (t.coord i) (t'.coord j) =
        Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤)
          t.bundle t'.bundle (t.coord j) (t'.coord i)) :
    Isomorphic t t' :=
  isomorphic_of_crossMultiplies (crossMultiplies_of_tensorSectionsAt h)

/-- **The morphisms agree, with the hypothesis in `L ⊗ L'`**: if `sᵢ ⊗ s'ⱼ = sⱼ ⊗ s'ᵢ` as global
sections of `AlgebraicGeometry.Scheme.Modules.tensorObj L L'`, the two morphisms `X ⟶ ℙⁿ_ℤ`
induced by the two generating families are equal. -/
theorem toProjectiveSpaceAtUniverse_eq_of_tensorSectionsAt [Stacks.Ample.IsInvertibleModule X L']
    {s : Fin (n + 1) → Γ(L, ⊤)} (hs : GeneratesStalks s) {s' : Fin (n + 1) → Γ(L', ⊤)}
    (hs' : GeneratesStalks s')
    (h : ∀ i j,
      Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) L L'
          (s i) (s' j) =
        Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) L L'
          (s j) (s' i)) :
    ProjectiveFromSections.toProjectiveSpaceAtUniverse s hs =
      ProjectiveFromSections.toProjectiveSpaceAtUniverse s' hs' :=
  toProjectiveSpaceAtUniverse_eq_of_crossMultiplies hs hs' (crossMultiplies_of_tensorSectionsAt h)

/-! ### Glueing -/

/-- **Morphisms to `ℙⁿ_ℤ` given by cross-multiplying generating tuples on an open cover glue.**
Let `(U a)` be an open cover of `X` and, on each `U a`, let `t a` be an invertible module with
`n + 1` generating global sections. If on each overlap `U a ×_X U b` the restrictions of `t a`
and `t b` cross-multiply, there is a unique morphism `g : X ⟶ ℙⁿ_ℤ` whose restriction to each
`U a` is the morphism attached to `t a` by Tag 01NE. -/
theorem exists_unique_hom_of_crossMultiplies {σ : Type*} (U : σ → X.Opens) (hU : IsOpenCover U)
    (t : ∀ a, GeneratingTuple (U a).toScheme n)
    (h : ∀ a b, CrossMultiplies (pullbackTuple (pullback.fst (U a).ι (U b).ι) (t a)).coord
      (pullbackTuple (pullback.snd (U a).ι (U b).ι) (t b)).coord) :
    ∃! g : X ⟶ projectiveSpaceAtUniverse.{u} n, ∀ a, pointsOfHom ((U a).ι ≫ g) = ⟦t a⟧ := by
  let 𝒰 := X.openCoverOfIsOpenCover U hU
  let f : ∀ a, (U a).toScheme ⟶ projectiveSpaceAtUniverse.{u} n := fun a =>
    (pointsEquiv _ n).symm ⟦t a⟧
  have hf : ∀ a, pointsOfHom (f a) = ⟦t a⟧ := fun a => (pointsEquiv _ n).apply_symm_apply _
  have hglue : ∀ a b : σ,
      pullback.fst (U a).ι (U b).ι ≫ f a = pullback.snd (U a).ι (U b).ι ≫ f b := fun a b => by
    apply pointsOfHom_injective
    rw [pointsOfHom_comp, pointsOfHom_comp, hf, hf, pullbackPoints_mk, pullbackPoints_mk]
    exact Quotient.sound (isomorphic_of_crossMultiplies (h a b))
  refine ⟨𝒰.glueMorphisms f hglue, fun a => ?_, fun g hg => ?_⟩
  · exact (congrArg pointsOfHom (𝒰.ι_glueMorphisms f hglue a)).trans (hf a)
  · refine 𝒰.hom_ext _ _ fun a => ?_
    rw [𝒰.ι_glueMorphisms f hglue a]
    exact pointsOfHom_injective ((hg a).trans (hf a).symm)

end Stacks.ProjectiveSpaceModuli

end
