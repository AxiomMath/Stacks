module

public import Mathlib.Algebra.Algebra.Subalgebra.Directed
public import StacksFrontier.AlgebraicGeometry.FiniteTypeSubalgebra.Sections

/-!
# An algebra is the directed colimit of its finite type subalgebras

Let `A` be a commutative algebra over a commutative ring `R`.  Its finite type `R`-subalgebras
form a directed system whose supremum is all of `A`, and `A` is their colimit: a compatible
family of `R`-algebra maps out of the finite type subalgebras extends uniquely to `A`.

This is the affine case of Stacks Tag 05JT, which asserts the same for the quasi-coherent
subalgebras of finite type of a quasi-coherent algebra on a quasi-compact and quasi-separated
scheme.  Over an affine open the quasi-coherent subalgebras of finite type are exactly the
subalgebras of finite type of the sections, so the statements here are the fibrewise content of
both halves of that tag: `directed` is directedness and `lift` with `algHom_ext` is the colimit.

## Main definitions

* `Stacks.RingTheory.FiniteTypeSubalgebra.Index`: the finite type `R`-subalgebras of `A`, as an
  index type ordered by inclusion.
* `Stacks.RingTheory.FiniteTypeSubalgebra.lift`: the morphism out of `A` determined by a
  compatible family of morphisms out of its finite type subalgebras.

## Main results

* `Stacks.RingTheory.FiniteTypeSubalgebra.exists_mem`: every element of `A` lies in a finite type
  subalgebra.
* `Stacks.RingTheory.FiniteTypeSubalgebra.directed`: the finite type subalgebras are directed.
* `Stacks.RingTheory.FiniteTypeSubalgebra.iSup_eq_top`: their supremum is everything.
* `Stacks.RingTheory.FiniteTypeSubalgebra.lift_coe` and
  `Stacks.RingTheory.FiniteTypeSubalgebra.algHom_ext`: the two halves of the colimit property,
  existence of the extension and its uniqueness.

## Implementation notes

Mathlib has every ingredient and none of the statements.  `Subalgebra.iSupLift` already performs
the directed-union construction, so `lift` is that applied to this particular family, with the
hypothesis `⊤ ≤ ⨆ S, S` supplied by `iSup_eq_top` and the result transported along
`Subalgebra.topEquiv`.  Directedness is `Stacks.RingTheory.FiniteTypeSubalgebra.finiteType_sup`,
already proved for this tag, and the two witnesses are the inclusions into the join.

`algHom_ext` needs neither directedness nor the supremum: two morphisms out of `A` that agree on
every finite type subalgebra agree at each element `a`, because `Algebra.adjoin R {a}` is itself
one.  So uniqueness in the colimit property is strictly cheaper than existence, and is stated
separately rather than as a field of a bundled universal property.

`Index` is `Nonempty` because the bottom subalgebra is of finite type, generated by the empty
set; `Subalgebra.iSupLift` requires this and it is not automatic from `A` being a ring.

## References

* [The Stacks Project, Tag 05JT](https://stacks.math.columbia.edu/tag/05JT)
-/

@[expose] public section

namespace Stacks.RingTheory.FiniteTypeSubalgebra

section Index

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]

/-- The finite type `R`-subalgebras of `A`, as an index type.  It carries the order induced from
`Subalgebra R A`, under which it is directed. -/
abbrev Index : Type _ := {S : Subalgebra R A // Algebra.FiniteType R S}

/-- There is a finite type `R`-subalgebra of `A`, namely the bottom subalgebra `⊥`. -/
instance : Nonempty (Index R A) :=
  ⟨⊥, (Subalgebra.fg_iff_finiteType _).1 ⟨∅, by simp⟩⟩

end Index

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Every element of an algebra lies in a finite type subalgebra, namely the one it generates. -/
theorem exists_mem (a : A) : ∃ S : Index R A, a ∈ (S : Subalgebra R A) :=
  ⟨⟨Algebra.adjoin R {a}, finiteType_adjoin_singleton a⟩,
    Algebra.self_mem_adjoin_singleton R a⟩

/-- **The directedness half of Stacks Tag 05JT, affine case.**  Two finite type subalgebras are
both contained in a third, namely their join, which is of finite type. -/
theorem directed : Directed (· ≤ ·) (fun S : Index R A => (S : Subalgebra R A)) := fun S T =>
  ⟨⟨(S : Subalgebra R A) ⊔ (T : Subalgebra R A), finiteType_sup _ _ S.2 T.2⟩,
    le_sup_left, le_sup_right⟩

/-- The finite type subalgebras of `A` have supremum `A`. -/
theorem iSup_eq_top : ⨆ S : Index R A, (S : Subalgebra R A) = ⊤ :=
  Algebra.eq_top_iff.2 fun a => by
    obtain ⟨S, hS⟩ := exists_mem (R := R) a
    exact le_iSup (fun S : Index R A => (S : Subalgebra R A)) S hS

variable {B : Type*} [CommRing B] [Algebra R B]
variable (f : ∀ S : Index R A, (S : Subalgebra R A) →ₐ[R] B)
  (hf : ∀ (S T : Index R A) (h : (S : Subalgebra R A) ≤ (T : Subalgebra R A)),
    f S = (f T).comp (Subalgebra.inclusion h))

/-- **The colimit half of Stacks Tag 05JT, affine case.**  A family of morphisms out of the
finite type subalgebras of `A`, compatible with the inclusions, extends to a morphism out of
`A`. -/
noncomputable def lift : A →ₐ[R] B :=
  (Subalgebra.iSupLift _ directed f hf ⊤ iSup_eq_top.ge).comp
    (Subalgebra.topEquiv (R := R) (A := A)).symm.toAlgHom

/-- The extension restricts on each finite type subalgebra to the morphism it came from.  Taken
together with `Stacks.RingTheory.FiniteTypeSubalgebra.algHom_ext` this is the statement that the
cocone of the finite type subalgebras over `A` is colimiting. -/
@[simp]
theorem lift_coe (S : Index R A) (x : (S : Subalgebra R A)) :
    lift f hf (x : A) = f S x :=
  Subalgebra.iSupLift_mk (dir := directed) (hf := hf) _ x _

/-- Two morphisms out of `A` that agree on every finite type subalgebra are equal: each element
generates one. -/
theorem algHom_ext {g h : A →ₐ[R] B}
    (H : ∀ (S : Index R A) (x : (S : Subalgebra R A)), g (x : A) = h (x : A)) : g = h := by
  ext a
  obtain ⟨S, hS⟩ := exists_mem (R := R) a
  exact H S ⟨a, hS⟩

/-- The extension produced by `Stacks.RingTheory.FiniteTypeSubalgebra.lift` is the only one
restricting to the given family. -/
theorem eq_lift (g : A →ₐ[R] B)
    (hg : ∀ (S : Index R A) (x : (S : Subalgebra R A)), g (x : A) = f S x) : g = lift f hf :=
  algHom_ext fun S x => by rw [hg S x, lift_coe]

end Stacks.RingTheory.FiniteTypeSubalgebra
