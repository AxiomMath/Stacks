module

public import StacksFrontier.AlgebraicGeometry.KerDetected.IdealComap
public import StacksFrontier.RingTheory.LocalCohomology.UniformCohomologyBound
public import Mathlib.AlgebraicGeometry.Pullbacks
import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic

/-!
# The subscheme cut out by a power of a principal ideal pulled back from the base

Let `g : X ⟶ Spec A` be a morphism of schemes and `I` an ideal of `A`. The ideal sheaf
`I 𝒪_X` of `Stacks.Cohomology.FormalFunctions.baseIdealSheaf` is the kernel of the base change
of the closed immersion `Spec(A/I) ⟶ Spec A` along `g`, so the closed subscheme it cuts out is
canonically the fibre product `X ×_{Spec A} Spec(A/I)`.

For a principal ideal `I = fA` this identifies the closed subscheme cut out by `(f𝒪_X)^n` with
`X ×_{Spec A} Spec(A/f^nA)`.

## Main definitions

* `Stacks.PuncturedSpectrumPicard.baseIdealSubschemeIsoPullback`: the subscheme cut out by
  `I 𝒪_X` is `X ×_{Spec A} Spec(A/I)`.
* `Stacks.PuncturedSpectrumPicard.principalPowerSubschemeIsoPullback`: the subscheme cut out by
  `(f𝒪_X)^n` is `X ×_{Spec A} Spec(A/f^nA)`.

## Main results

* `Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_ker_pullback_fst`: `I 𝒪_X` is the kernel of
  the base change of `Spec(A/I) ⟶ Spec A` along `g`.
* `Stacks.PuncturedSpectrumPicard.baseIdealSubschemeIsoPullback_hom_fst` and
  `Stacks.PuncturedSpectrumPicard.principalPowerSubschemeIsoPullback_hom_fst`: both isomorphisms
  are compatible with the two maps down to `X`.

## References

* [Stacks Project, Tag 0F2D](https://stacks.math.columbia.edu/tag/0F2D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped AlgebraicGeometry

universe u

namespace Stacks.PuncturedSpectrumPicard

open Stacks.Cohomology.FormalFunctions (baseIdealSheaf baseIdealSheaf_pow)

variable (A : Type u) [CommRing A] (I : Ideal A) {X : Scheme.{u}} (g : X ⟶ Spec (.of A))

/-- The ideal sheaf `I 𝒪_X` is the pullback along `g` of the quasi-coherent ideal sheaf on
`Spec A` generated by `I`. -/
theorem baseIdealSheaf_eq_comap :
    baseIdealSheaf A I g =
      (Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap g := by
  classical
  apply Scheme.IdealSheafData.ext
  ext U
  let J : (Spec (.of A)).IdealSheafData :=
    Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)
  rw [Stacks.IdealSheaf.ideal_comap_appLE J g
    ⟨⊤, isAffineOpen_top _⟩ U (by simp)]
  simp [baseIdealSheaf, Stacks.Cohomology.FormalFunctions.baseIdeal, J, Ideal.map_map,
    Scheme.Hom.appLE, Scheme.Hom.appTop]
  rfl

/-- Forming `I 𝒪_X` commutes with pulling back along a morphism: the ideal sheaf generated by
`I` on a scheme over `X` is the inverse image of the one on `X`. -/
theorem baseIdealSheaf_comap {Y : Scheme.{u}} (h : Y ⟶ X) :
    (baseIdealSheaf A I g).comap h = baseIdealSheaf A I (h ≫ g) := by
  rw [baseIdealSheaf_eq_comap, baseIdealSheaf_eq_comap, Scheme.IdealSheafData.comap_comp]

/-- The kernel ideal sheaf of `Spec(A/I) ⟶ Spec A` is the quasi-coherent ideal sheaf generated
by `I` on global sections. -/
theorem quotientSpec_ker :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).ker =
      Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (.of A)).inv.hom) := by
  rw [Scheme.ker_of_isAffine]
  congr 1
  rw [← RingHom.ker_equiv_comp _ (Scheme.ΓSpecIso (.of (A ⧸ I))).commRingCatIsoToRingEquiv,
    RingEquiv.toRingHom_eq_coe, Iso.commRingCatIsoToRingEquiv_toRingHom,
    ← CommRingCat.hom_comp, Scheme.ΓSpecIso_naturality, CommRingCat.hom_comp, ← RingHom.comap_ker]
  show (RingHom.ker (Ideal.Quotient.mk I)).comap
    (Scheme.ΓSpecIso (.of A)).hom.hom = _
  rw [Ideal.mk_ker]
  exact Ideal.comap_symm (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv

/-- `I 𝒪_X` is the kernel of the base change of `Spec(A/I) ⟶ Spec A` along `g`. -/
theorem baseIdealSheaf_eq_ker_pullback_fst :
    baseIdealSheaf A I g =
      (pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).ker := by
  let := IsClosedImmersion.spec_of_quotient_mk (R := .of A) I
  rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, quotientSpec_ker,
    baseIdealSheaf_eq_comap]

/-- The closed subscheme of `X` cut out by `I 𝒪_X` is the fibre product
`X ×_{Spec A} Spec(A/I)`. -/
def baseIdealSubschemeIsoPullback :
    (baseIdealSheaf A I g).subscheme ≅
      pullback g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
  letI := IsClosedImmersion.spec_of_quotient_mk (R := .of A) I
  eqToIso (congrArg Scheme.IdealSheafData.subscheme
      (baseIdealSheaf_eq_ker_pullback_fst A I g)) ≪≫
    (asIso (pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).toImage).symm

/-- Relabelling the ideal sheaf relabels its subscheme compatibly with the closed immersion
into the ambient scheme. -/
theorem subscheme_eqToHom_comp_subschemeι {Y : Scheme.{u}}
    (J K : Y.IdealSheafData) (h : J = K) :
    eqToHom (congrArg Scheme.IdealSheafData.subscheme h) ≫ K.subschemeι = J.subschemeι := by
  subst K
  simp

/-- `Stacks.PuncturedSpectrumPicard.baseIdealSubschemeIsoPullback` is compatible with the two
closed immersions into `X`. -/
theorem baseIdealSubschemeIsoPullback_hom_fst :
    (baseIdealSubschemeIsoPullback A I g).hom ≫
      pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) =
        (baseIdealSheaf A I g).subschemeι := by
  let : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_quotient_mk (R := .of A) I
  let p := pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
  show (eqToHom (congrArg Scheme.IdealSheafData.subscheme
    (baseIdealSheaf_eq_ker_pullback_fst A I g)) ≫ inv p.toImage) ≫ p = _
  conv_lhs => rhs; rw [← p.toImage_imageι]
  simp only [Category.assoc, IsIso.inv_hom_id_assoc]
  exact subscheme_eqToHom_comp_subschemeι _ _ (baseIdealSheaf_eq_ker_pullback_fst A I g)

variable (f : A)

/-- The closed subscheme of `X` cut out by the `n`th power of `f𝒪_X` is the fibre product
`X ×_{Spec A} Spec(A/f^nA)`. -/
def principalPowerSubschemeIsoPullback (n : ℕ) :
    ((baseIdealSheaf A (Ideal.span {f}) g) ^ n).subscheme ≅
      pullback g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f ^ n})))) :=
  eqToIso (congrArg Scheme.IdealSheafData.subscheme
      (by rw [← baseIdealSheaf_pow, Ideal.span_singleton_pow])) ≪≫
    baseIdealSubschemeIsoPullback A (Ideal.span {f ^ n}) g

/-- `Stacks.PuncturedSpectrumPicard.principalPowerSubschemeIsoPullback` is compatible with the
two closed immersions into `X`. -/
theorem principalPowerSubschemeIsoPullback_hom_fst (n : ℕ) :
    (principalPowerSubschemeIsoPullback A g f n).hom ≫
      pullback.fst g
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f ^ n})))) =
          ((baseIdealSheaf A (Ideal.span {f}) g) ^ n).subschemeι := by
  dsimp only [principalPowerSubschemeIsoPullback, Iso.trans_hom, eqToIso.hom]
  rw [Category.assoc, baseIdealSubschemeIsoPullback_hom_fst]
  exact subscheme_eqToHom_comp_subschemeι _ _
    (by rw [← baseIdealSheaf_pow, Ideal.span_singleton_pow])

end Stacks.PuncturedSpectrumPicard

end
