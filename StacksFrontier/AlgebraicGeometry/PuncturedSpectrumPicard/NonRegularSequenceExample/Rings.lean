/-!
# The rings of the non-regular-sequence example and their depths

The power-series rings `k⟦x_1, …, x_n⟧` and the quotients
`A₁ = k⟦a,b,x,y,z⟧/(a³, b³, xa² + yab + zb²)`, `A₀ = k⟦a,b,x,y,z,u,v⟧/(a³, b³, xa² + yab + zb²)`
and `A = k⟦a,b,x,y,z,u,v,w⟧/(a³, b³, xa² + yab + zb², w²)` of [Stacks, Tag 0F9L], their
nontriviality and locality, the socle element `a²b²` of `A₁` with `depth A₁ = 0` and
`depth A₀ = 2`, and the regularity and dimension of the ambient ring `k⟦a,b,x,y,z,u,v,w⟧`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open Stacks.MvPowerSeries.RegularParameters

namespace Stacks.PuncturedSpectrumPicard.NonRegularSequence

universe u

private theorem natCast_le_ringKrullDim_finiteMvPowerSeries
    (k : Type u) [Field k] (n : ℕ) :
    (n : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin n) k) := by
  induction n with
  | zero => exact (zero_le_ringKrullDim_iff_nontrivial).mpr inferInstance
  | succ n ih =>
      calc
        ((n + 1 : ℕ) : WithBot ℕ∞) = (n : WithBot ℕ∞) + 1 := by norm_num
        _ ≤ ringKrullDim (MvPowerSeries (Fin n) k) + 1 := by gcongr
        _ ≤ ringKrullDim (PowerSeries (MvPowerSeries (Fin n) k)) :=
          ringKrullDim_succ_le_ringKrullDim_powerseries
        _ = ringKrullDim (MvPowerSeries (Fin (n + 1)) k) :=
          (ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv k n).toRingEquiv).symm

/-- The maximal ideal of `k⟦x_1, …, x_n⟧` is generated by the variables.  This is
`MvPowerSeries.maximalIdeal_eq_span_range_X`, at this file's own name for it. -/
private theorem maximalIdeal_finiteMvPowerSeries_eq_span_X
    (k : Type u) [Field k] (n : ℕ) :
    IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k) =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k)) :=
  MvPowerSeries.maximalIdeal_eq_span_range_X k n

private theorem spanFinrank_maximalIdeal_finiteMvPowerSeries_le
    (k : Type u) [Field k] (n : ℕ) :
    (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k)).spanFinrank ≤ n := by
  rw [MvPowerSeries.maximalIdeal_eq_span_range_X]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
  simpa [← Set.image_univ] using
    Set.ncard_image_le (f := (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))
      Set.finite_univ

private theorem quotient_nontrivial_of_constantCoeff_zero_generators
    {k : Type u} [Field k] {n : ℕ} (s : Set (MvPowerSeries (Fin n) k))
    (hs : ∀ x ∈ s, MvPowerSeries.constantCoeff (R := k) x = 0) :
    Nontrivial (MvPowerSeries (Fin n) k ⧸ Ideal.span s) := by
  let I : Ideal (MvPowerSeries (Fin n) k) := Ideal.span s
  have hI : I ≤ RingHom.ker (MvPowerSeries.constantCoeff (R := k)) :=
    Ideal.span_le.2 hs
  refine ⟨⟨0, 1, fun h => ?_⟩⟩
  have hq : Ideal.Quotient.mk I (1 : MvPowerSeries (Fin n) k) = 0 := by simpa using h.symm
  simpa using hI (Ideal.Quotient.eq_zero_iff_mem.1 hq)

/-- The formal power-series ring in `n` variables over `k`. -/
public abbrev powerSeriesRing (k : Type u) [Field k] (n : ℕ) :=
  MvPowerSeries (Fin n) k

/-- The five-variable ideal `(a³, b³, xa² + yab + zb²)`. -/
public def fiveVariableIdeal (k : Type u) [Field k] :
    Ideal (powerSeriesRing k 5) :=
  Ideal.span ({(MvPowerSeries.X (0 : Fin 5)) ^ 3,
    (MvPowerSeries.X (1 : Fin 5)) ^ 3,
    MvPowerSeries.X (2 : Fin 5) * (MvPowerSeries.X (0 : Fin 5)) ^ 2 +
      MvPowerSeries.X (3 : Fin 5) * MvPowerSeries.X (0 : Fin 5) *
        MvPowerSeries.X (1 : Fin 5) +
      MvPowerSeries.X (4 : Fin 5) * (MvPowerSeries.X (1 : Fin 5)) ^ 2} :
    Set (powerSeriesRing k 5))

/-- The five-variable quotient used to calculate the depth. -/
public abbrev socleRing (k : Type u) [Field k] :=
  (powerSeriesRing k 5) ⧸ fiveVariableIdeal k

/-- **Stacks 0F9L** (nontrivial five-variable quotient).
The ring `A₁ = k⟦a,b,x,y,z⟧/(a³, b³, xa² + yab + zb²)` is nonzero. -/
@[stacks 0F9L "nontrivial five-variable quotient"]
public theorem socleRing_nontrivial (k : Type u) [Field k] :
    Nontrivial (socleRing k) := by
  refine quotient_nontrivial_of_constantCoeff_zero_generators _ ?_
  rintro x (rfl | rfl | rfl) <;> simp

/-- The five-variable quotient `A₁` is a local ring. -/
public instance (k : Type u) [Field k] : IsLocalRing (socleRing k) :=
  letI : Nontrivial (socleRing k) := socleRing_nontrivial k
  IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- The seven-variable ideal `(a³, b³, xa² + yab + zb²)`. -/
public def sevenVariableIdeal (k : Type u) [Field k] :
    Ideal (powerSeriesRing k 7) :=
  Ideal.span ({(MvPowerSeries.X (0 : Fin 7)) ^ 3,
    (MvPowerSeries.X (1 : Fin 7)) ^ 3,
    MvPowerSeries.X (2 : Fin 7) * (MvPowerSeries.X (0 : Fin 7)) ^ 2 +
      MvPowerSeries.X (3 : Fin 7) * MvPowerSeries.X (0 : Fin 7) *
        MvPowerSeries.X (1 : Fin 7) +
      MvPowerSeries.X (4 : Fin 7) * (MvPowerSeries.X (1 : Fin 7)) ^ 2} :
    Set (powerSeriesRing k 7))

/-- The quotient `A₀` in the example. -/
public abbrev intermediateRing (k : Type u) [Field k] :=
  (powerSeriesRing k 7) ⧸ sevenVariableIdeal k

/-- **Stacks 0F9L** (nontrivial seven-variable quotient).
The ring `A₀ = k⟦a,b,x,y,z,u,v⟧/(a³, b³, xa² + yab + zb²)` is nonzero. -/
@[stacks 0F9L "nontrivial seven-variable quotient"]
public theorem intermediateRing_nontrivial (k : Type u) [Field k] :
    Nontrivial (intermediateRing k) := by
  refine quotient_nontrivial_of_constantCoeff_zero_generators _ ?_
  rintro x (rfl | rfl | rfl) <;> simp

/-- The seven-variable quotient `A₀` is a local ring. -/
public instance (k : Type u) [Field k] : IsLocalRing (intermediateRing k) :=
  letI : Nontrivial (intermediateRing k) := intermediateRing_nontrivial k
  IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- The eight-variable ideal `(a³, b³, xa² + yab + zb², w²)`. -/
public def eightVariableIdeal (k : Type u) [Field k] :
    Ideal (powerSeriesRing k 8) :=
  Ideal.span ({(MvPowerSeries.X (0 : Fin 8)) ^ 3,
    (MvPowerSeries.X (1 : Fin 8)) ^ 3,
    MvPowerSeries.X (2 : Fin 8) * (MvPowerSeries.X (0 : Fin 8)) ^ 2 +
      MvPowerSeries.X (3 : Fin 8) * MvPowerSeries.X (0 : Fin 8) *
        MvPowerSeries.X (1 : Fin 8) +
      MvPowerSeries.X (4 : Fin 8) * (MvPowerSeries.X (1 : Fin 8)) ^ 2,
    (MvPowerSeries.X (7 : Fin 8)) ^ 2} : Set (powerSeriesRing k 8))

/-- The quotient `A` in the example. -/
public abbrev exampleRing (k : Type u) [Field k] :=
  (powerSeriesRing k 8) ⧸ eightVariableIdeal k

/-- **Stacks 0F9L** (nontrivial eight-variable quotient).
The ring `A = k⟦a,b,x,y,z,u,v,w⟧/(a³, b³, xa² + yab + zb², w²)` is nonzero. -/
@[stacks 0F9L "nontrivial eight-variable quotient"]
public theorem exampleRing_nontrivial (k : Type u) [Field k] :
    Nontrivial (exampleRing k) := by
  refine quotient_nontrivial_of_constantCoeff_zero_generators _ ?_
  rintro x (rfl | rfl | rfl | rfl) <;> simp

/-- The eight-variable quotient `A` is a local ring. -/
public instance (k : Type u) [Field k] : IsLocalRing (exampleRing k) :=
  letI : Nontrivial (exampleRing k) := exampleRing_nontrivial k
  IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- The class of `a²b²` in the five-variable quotient. -/
public def socleElement (k : Type u) [Field k] : socleRing k :=
  Ideal.Quotient.mk (fiveVariableIdeal k)
    ((MvPowerSeries.X (0 : Fin 5)) ^ 2 * (MvPowerSeries.X (1 : Fin 5)) ^ 2)

/-- **Stacks 0F9L** (nonzero socle element).
The class of `a²b²` in `A₁ = k⟦a,b,x,y,z⟧/(a³, b³, xa² + yab + zb²)` is nonzero. -/
@[stacks 0F9L "nonzero socle element"]
public theorem socleElement_ne_zero (k : Type u) [Field k] :
    socleElement k ≠ 0 := by
  classical
  let a : MvPowerSeries (Fin 5) k := MvPowerSeries.X 0
  let b : MvPowerSeries (Fin 5) k := MvPowerSeries.X 1
  let x : MvPowerSeries (Fin 5) k := MvPowerSeries.X 2
  let y : MvPowerSeries (Fin 5) k := MvPowerSeries.X 3
  let z : MvPowerSeries (Fin 5) k := MvPowerSeries.X 4
  let β : Fin 5 →₀ ℕ := Finsupp.single 0 2 + Finsupp.single 1 2
  let I : Ideal (MvPowerSeries (Fin 5) k) := fiveVariableIdeal k
  have hβ (i : Fin 5) : β i = if i = 0 ∨ i = 1 then 2 else 0 := by
    fin_cases i <;> simp [β]
  have hn (v : Fin 5 →₀ ℕ) (i : Fin 5) (hi : β i < v i) : ¬ v ≤ β :=
    fun h => absurd (h i) (not_le.2 hi)
  have hgen : ∀ r ∈ ({a ^ 3, b ^ 3,
      x * a ^ 2 + y * a * b + z * b ^ 2} : Set (MvPowerSeries (Fin 5) k)),
      ∀ q, MvPowerSeries.coeff β (q * r) = 0 := by
    intro r hr q
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
    rcases hr with hr | hr | hr
    · subst r
      rw [MvPowerSeries.X_pow_eq, MvPowerSeries.coeff_mul_monomial]
      simp [hn (Finsupp.single 0 3) 0 (by simp [hβ])]
    · subst r
      rw [MvPowerSeries.X_pow_eq, MvPowerSeries.coeff_mul_monomial]
      simp [hn (Finsupp.single 1 3) 1 (by simp [hβ])]
    · subst r
      have hx : x * a ^ 2 = MvPowerSeries.monomial
          (Finsupp.single 2 1 + Finsupp.single 0 2) (1 : k) := by
        dsimp [x, a]
        rw [← pow_one (MvPowerSeries.X (2 : Fin 5)),
          MvPowerSeries.X_pow_eq (2 : Fin 5) 1,
          MvPowerSeries.X_pow_eq (0 : Fin 5) 2,
          MvPowerSeries.monomial_mul_monomial]
        simp
      have hy : y * a * b = MvPowerSeries.monomial
          (Finsupp.single 3 1 + Finsupp.single 0 1 + Finsupp.single 1 1) (1 : k) := by
        dsimp [y, a, b]
        rw [← pow_one (MvPowerSeries.X (3 : Fin 5)),
          ← pow_one (MvPowerSeries.X (0 : Fin 5)),
          ← pow_one (MvPowerSeries.X (1 : Fin 5)),
          MvPowerSeries.X_pow_eq (3 : Fin 5) 1,
          MvPowerSeries.X_pow_eq (0 : Fin 5) 1,
          MvPowerSeries.X_pow_eq (1 : Fin 5) 1,
          MvPowerSeries.monomial_mul_monomial,
          MvPowerSeries.monomial_mul_monomial]
        simp [add_assoc]
      have hz : z * b ^ 2 = MvPowerSeries.monomial
          (Finsupp.single 4 1 + Finsupp.single 1 2) (1 : k) := by
        dsimp [z, b]
        rw [← pow_one (MvPowerSeries.X (4 : Fin 5)),
          MvPowerSeries.X_pow_eq (4 : Fin 5) 1,
          MvPowerSeries.X_pow_eq (1 : Fin 5) 2,
          MvPowerSeries.monomial_mul_monomial]
        simp
      rw [hx, hy, hz]
      simp only [mul_add, map_add]
      have hn₁ := hn (Finsupp.single 2 1 + Finsupp.single 0 2) 2 (by simp [hβ])
      have hn₂ := hn (Finsupp.single 3 1 + Finsupp.single 0 1 + Finsupp.single 1 1) 3
        (by simp [hβ])
      have hn₃ := hn (Finsupp.single 4 1 + Finsupp.single 1 2) 4 (by simp [hβ])
      simp only [MvPowerSeries.coeff_mul_monomial]
      simp [hn₁, hn₂, hn₃]
  have hmem : ∀ r ∈ I, ∀ q, MvPowerSeries.coeff β (q * r) = 0 := by
    intro r hr
    change r ∈ Ideal.span
      ({a ^ 3, b ^ 3, x * a ^ 2 + y * a * b + z * b ^ 2} :
        Set (MvPowerSeries (Fin 5) k)) at hr
    induction hr using Submodule.span_induction with
    | mem r hr => exact hgen r hr
    | zero => intro q; simp
    | add r s hr hs ih₁ ih₂ =>
        intro q
        rw [mul_add, map_add, ih₁ q, ih₂ q, add_zero]
    | smul c r hr ih =>
        intro q
        have hmul : q * (c * r) = (q * c) * r := by ring
        simp only [smul_eq_mul]
        rw [hmul]
        exact ih (q * c)
  intro hz
  have hclass : Ideal.Quotient.mk I (a ^ 2 * b ^ 2) = 0 := by
    simpa [socleElement, a, b, I] using hz
  have hquot : a ^ 2 * b ^ 2 ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hclass
  have hzero := hmem (a ^ 2 * b ^ 2) hquot 1
  have hcoeff : MvPowerSeries.coeff β (a ^ 2 * b ^ 2) = 1 := by
    dsimp [a, b]
    rw [MvPowerSeries.X_pow_eq (0 : Fin 5) 2,
      MvPowerSeries.X_pow_eq (1 : Fin 5) 2,
      MvPowerSeries.monomial_mul_monomial]
    simp [β]
  rw [one_mul, hcoeff] at hzero
  exact (one_ne_zero hzero)

/-- **Stacks 0F9L** (socle element annihilated by all five variables).
The class of `a²b²` in `A₁ = k⟦a,b,x,y,z⟧/(a³, b³, xa² + yab + zb²)` is killed by each of
the five variables `a, b, x, y, z`. -/
@[stacks 0F9L "socle element annihilated by all five variables"]
public theorem socleElement_mul_variable (k : Type u) [Field k] (i : Fin 5) :
    socleElement k * Ideal.Quotient.mk (fiveVariableIdeal k) (MvPowerSeries.X i) = 0 := by
  classical
  let a : MvPowerSeries (Fin 5) k := MvPowerSeries.X 0
  let b : MvPowerSeries (Fin 5) k := MvPowerSeries.X 1
  let x : MvPowerSeries (Fin 5) k := MvPowerSeries.X 2
  let y : MvPowerSeries (Fin 5) k := MvPowerSeries.X 3
  let z : MvPowerSeries (Fin 5) k := MvPowerSeries.X 4
  let I : Ideal (MvPowerSeries (Fin 5) k) := fiveVariableIdeal k
  have ha3 : a ^ 3 ∈ I := Ideal.subset_span (by simp [a])
  have hb3 : b ^ 3 ∈ I := Ideal.subset_span (by simp [b])
  have hrel : x * a ^ 2 + y * a * b + z * b ^ 2 ∈ I :=
    Ideal.subset_span (by simp [a, b, x, y, z])
  show Ideal.Quotient.mk I (a ^ 2 * b ^ 2 * MvPowerSeries.X i) = 0
  rw [Ideal.Quotient.eq_zero_iff_mem]
  fin_cases i
  · show a ^ 2 * b ^ 2 * a ∈ I
    convert I.mul_mem_right (b ^ 2) ha3 using 1
    ring
  · show a ^ 2 * b ^ 2 * b ∈ I
    convert I.mul_mem_right (a ^ 2) hb3 using 1
    ring
  · have hy : y * a * b ^ 3 ∈ I := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using I.mul_mem_right (y * a) hb3
    have hz : (z * b) * b ^ 3 ∈ I := I.mul_mem_left (z * b) hb3
    have hprod : (x * a ^ 2 + y * a * b + z * b ^ 2) * b ^ 2 ∈ I :=
      I.mul_mem_right (b ^ 2) hrel
    show a ^ 2 * b ^ 2 * x ∈ I
    convert I.sub_mem (I.sub_mem hprod hy) hz using 1
    ring_nf
  · have hx : x * a ^ 3 * b ∈ I := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using I.mul_mem_right (x * b) ha3
    have hz : z * a * b ^ 3 ∈ I := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using I.mul_mem_right (z * a) hb3
    have hprod : (x * a ^ 2 + y * a * b + z * b ^ 2) * (a * b) ∈ I :=
      I.mul_mem_right (a * b) hrel
    show a ^ 2 * b ^ 2 * y ∈ I
    convert I.sub_mem (I.sub_mem hprod hx) hz using 1
    ring_nf
  · have hx : (x * a) * a ^ 3 ∈ I := I.mul_mem_left (x * a) ha3
    have hy : y * a ^ 3 * b ∈ I := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using I.mul_mem_right (y * b) ha3
    have hprod : (x * a ^ 2 + y * a * b + z * b ^ 2) * a ^ 2 ∈ I :=
      I.mul_mem_right (a ^ 2) hrel
    show a ^ 2 * b ^ 2 * z ∈ I
    convert I.sub_mem (I.sub_mem hprod hx) hy using 1
    ring_nf

/-- **Stacks 0F9L** (depth of the five-variable quotient).
The ring `A₁ = k⟦a,b,x,y,z⟧/(a³, b³, xa² + yab + zb²)` has depth `0` along its maximal
ideal. -/
@[stacks 0F9L "depth of the five-variable quotient"]
public theorem socleRing_depth (k : Type u) [Field k] :
    Module.depth (socleRing k) (IsLocalRing.maximalIdeal (socleRing k))
      (socleRing k) = 0 := by
  classical
  let A := socleRing k
  let : Nontrivial A := socleRing_nontrivial k
  let π : MvPowerSeries (Fin 5) k →+* A := Ideal.Quotient.mk (fiveVariableIdeal k)
  have hmax : IsLocalRing.maximalIdeal A =
      Ideal.span (Set.range (fun i : Fin 5 => π (MvPowerSeries.X i))) := by
    have hmap := IsLocalRing.map_maximalIdeal_of_surjective π Ideal.Quotient.mk_surjective
    have hspan : (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 5) k)).map π =
        Ideal.span (Set.range (fun i : Fin 5 => π (MvPowerSeries.X i))) := by
      rw [MvPowerSeries.maximalIdeal_eq_span_range_X, Ideal.map_span]
      congr 1
      ext q
      simp
    exact hmap.symm.trans hspan
  have hkill : ∀ r ∈ IsLocalRing.maximalIdeal A, r * socleElement k = 0 := by
    intro r hr
    rw [hmax] at hr
    induction hr using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        simpa [π, socleElement, mul_comm] using socleElement_mul_variable k i
    | zero => simp
    | add x y hx hy ihx ihy => rw [add_mul, ihx, ihy, zero_add]
    | smul c x hx ih =>
        rw [smul_eq_mul, mul_assoc, ih, mul_zero]
  have hsat :
      IsLocalRing.maximalIdeal A • (⊤ : Submodule A A) ≠ ⊤ := by
    intro h
    exact top_ne_bot (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot
      (IsLocalRing.maximalIdeal A) ⊤ Module.Finite.fg_top (by rw [h])
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top]))
  have hno : ∀ rs : List A,
      (∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal A) →
      RingTheory.Sequence.IsRegular A rs → rs = [] := by
    intro rs hmem hreg
    cases rs with
    | nil => rfl
    | cons f rest =>
        have hfreg := (RingTheory.Sequence.isRegular_cons_iff A f rest).mp hreg |>.1
        have hzero : f • socleElement k = 0 := by
          show f * socleElement k = 0
          exact hkill f (hmem f (by simp))
        exact False.elim (socleElement_ne_zero k (hfreg (by simpa using hzero)))
  rw [Module.depth, if_neg hsat]
  refine le_antisymm (iSup₂_le fun rs hrs => ?_) bot_le
  simp [hno rs hrs.1 hrs.2]

open scoped Pointwise


/-- The self-depth of a local ring along its maximal ideal is invariant under a ring
isomorphism.  This is `Module.depth_self_eq_of_ringEquiv`, at this file's own name for it. -/
private alias depth_eq_of_ringEquiv := Module.depth_self_eq_of_ringEquiv


lemma depth_quotient_add_one (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (x : R) (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hreg : IsSMulRegular R x)
    [IsLocalRing (R ⧸ Ideal.span {x})] :
    Module.depth (R ⧸ Ideal.span {x}) (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x}))
      (R ⧸ Ideal.span {x}) + 1 = Module.depth R (IsLocalRing.maximalIdeal R) R := by
  let Q := R ⧸ Ideal.span {x}
  have hspan : (x • (⊤ : Submodule R R) : Submodule R R) = Ideal.span {x} := by
    rw [← Submodule.ideal_span_singleton_smul]
    simp
  let e : QuotSMulTop x R ≃ₗ[R] Q := Submodule.quotEquivOfEq _ _ hspan
  have hdrop := (Module.depth_quotSMulTop_succ_eq_depth_and_exists_isRegular_append
    (IsLocalRing.maximalIdeal R) R).1 x hx hreg
  rwa [Module.depth_eq_depth_of_linearEquiv _ e,
    Module.depth_eq_depth_map_algebraMap (A := R) (B := Q) Ideal.Quotient.mk_surjective,
    IsLocalRing.map_maximalIdeal_of_surjective (algebraMap R Q)
      (show Function.Surjective (algebraMap R Q) from Ideal.Quotient.mk_surjective)] at hdrop

lemma depth_powerSeries (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] :
    Module.depth (PowerSeries R) (IsLocalRing.maximalIdeal (PowerSeries R))
      (PowerSeries R) = Module.depth R (IsLocalRing.maximalIdeal R) R + 1 := by
  have hker : RingHom.ker (PowerSeries.constantCoeff : PowerSeries R →+* R) =
      Ideal.span {(PowerSeries.X : PowerSeries R)} := by
    ext f
    simp only [RingHom.mem_ker, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff]
  let e : (PowerSeries R ⧸ Ideal.span {(PowerSeries.X : PowerSeries R)}) ≃+* R :=
    (Ideal.quotEquivOfEq hker).symm.trans
      (RingHom.quotientKerEquivOfSurjective PowerSeries.constantCoeff_surj)
  have := e.toEquiv.nontrivial
  let : IsLocalRing (PowerSeries R ⧸ Ideal.span {(PowerSeries.X : PowerSeries R)}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have hx : (PowerSeries.X : PowerSeries R) ∈ IsLocalRing.maximalIdeal (PowerSeries R) := by
    show ¬ IsUnit (PowerSeries.X : PowerSeries R)
    simp [PowerSeries.isUnit_iff_constantCoeff]
  rw [← depth_quotient_add_one _ _ hx PowerSeries.X_mul_injective,
    Module.depth_self_eq_of_ringEquiv e]

private noncomputable def powerSeriesQuotientEquiv (R : Type*) [CommRing R]
    (I : Ideal R) (hI : I.FG) :
    (PowerSeries R ⧸ Ideal.map PowerSeries.C I) ≃+* PowerSeries (R ⧸ I) := by
  have hker : RingHom.ker (PowerSeries.map (Ideal.Quotient.mk I)) =
      Ideal.map PowerSeries.C I := by
    change RingHom.ker (MvPowerSeries.map (σ := Unit) (Ideal.Quotient.mk I)) =
      Ideal.map MvPowerSeries.C I
    rw [MvPowerSeries.ker_map_of_fg]
    · simp
    · simpa using hI
  exact (Ideal.quotEquivOfEq hker).symm.trans
    (RingHom.quotientKerEquivOfSurjective
      (PowerSeries.map_surjective _ Ideal.Quotient.mk_surjective))

private def extendedSocleIdeal (k : Type*) [Field k] (n : ℕ) :
    Ideal (MvPowerSeries (Fin (n + 5)) k) :=
  Ideal.span {MvPowerSeries.X 0 ^ 3, MvPowerSeries.X 1 ^ 3,
    MvPowerSeries.X 2 * MvPowerSeries.X 0 ^ 2 +
      MvPowerSeries.X 3 * MvPowerSeries.X 0 * MvPowerSeries.X 1 +
      MvPowerSeries.X 4 * MvPowerSeries.X 1 ^ 2}

private abbrev extendedSocleRing (k : Type*) [Field k] (n : ℕ) :=
  MvPowerSeries (Fin (n + 5)) k ⧸ extendedSocleIdeal k n

private theorem extendedSocleRing_nontrivial (k : Type*) [Field k] (n : ℕ) :
    Nontrivial (extendedSocleRing k n) := by
  refine quotient_nontrivial_of_constantCoeff_zero_generators _ ?_
  rintro x (rfl | rfl | rfl) <;> simp

private theorem extendedSocleRing_isLocalRing (k : Type*) [Field k] (n : ℕ) :
    IsLocalRing (extendedSocleRing k n) := by
  have := extendedSocleRing_nontrivial k n
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

attribute [local instance] extendedSocleRing_isLocalRing

private noncomputable def extendedSocleRing_succ_equiv (k : Type*) [Field k] (n : ℕ) :
    extendedSocleRing k (n + 1) ≃+* PowerSeries (extendedSocleRing k n) := by
  let E : MvPowerSeries (Fin (n + 6)) k ≃+* PowerSeries (MvPowerSeries (Fin (n + 5)) k) :=
    ((MvPowerSeries.renameEquiv k (finRotate (n + 6))).trans
      (MvPowerSeries.finSuccEquiv k (n + 5))).toRingEquiv
  have hX (i : Fin (n + 5)) : E (MvPowerSeries.X i.castSucc) =
      PowerSeries.C (MvPowerSeries.X i) := by
    change MvPowerSeries.finSuccEquiv k (n + 5)
      (MvPowerSeries.rename (finRotate (n + 6)) (MvPowerSeries.X i.castSucc)) = _
    rw [MvPowerSeries.rename_X]
    have hi : finRotate (n + 6) i.castSucc = i.succ := finRotate_of_lt i.isLt
    rw [hi, MvPowerSeries.finSuccEquiv_X_succ]
  have hmap : Ideal.map E.toRingHom (extendedSocleIdeal k (n + 1)) =
      Ideal.map PowerSeries.C (extendedSocleIdeal k n) := by
    rw [extendedSocleIdeal, extendedSocleIdeal, Ideal.map_span, Ideal.map_span]
    have h0 : E.toRingHom (MvPowerSeries.X 0) = PowerSeries.C (MvPowerSeries.X 0) := hX 0
    have h1 : E.toRingHom (MvPowerSeries.X 1) = PowerSeries.C (MvPowerSeries.X 1) := hX 1
    have h2 : E.toRingHom (MvPowerSeries.X 2) = PowerSeries.C (MvPowerSeries.X 2) := hX 2
    have h3 : E.toRingHom (MvPowerSeries.X 3) = PowerSeries.C (MvPowerSeries.X 3) := hX 3
    have h4 : E.toRingHom (MvPowerSeries.X 4) = PowerSeries.C (MvPowerSeries.X 4) := hX 4
    simp only [Set.image_insert_eq, Set.image_singleton, map_pow, map_add, map_mul,
      h0, h1, h2, h3, h4]
  exact (Ideal.quotientEquiv _ _ E hmap.symm).trans
    (powerSeriesQuotientEquiv _ _ (IsNoetherian.noetherian _))

private theorem extendedSocleRing_depth (k : Type*) [Field k] (n : ℕ) :
    Module.depth (extendedSocleRing k n) (IsLocalRing.maximalIdeal (extendedSocleRing k n))
      (extendedSocleRing k n) =
    Module.depth (extendedSocleRing k 0) (IsLocalRing.maximalIdeal (extendedSocleRing k 0))
      (extendedSocleRing k 0) + n := by
  induction n with
  | zero => simp
  | succ n ih =>
    let : IsNoetherianRing (MvPowerSeries (Fin (n + 5)) k) := inferInstance
    let : IsNoetherianRing (extendedSocleRing k n) :=
      isNoetherianRing_of_surjective _ _ (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    rw [Module.depth_self_eq_of_ringEquiv (extendedSocleRing_succ_equiv k n), depth_powerSeries,
      ih]
    simp [Nat.cast_add, add_assoc]


/-- **Stacks 0F9L** (depth of the seven-variable quotient).
The ring `A₀ = k⟦a,b,x,y,z,u,v⟧/(a³, b³, xa² + yab + zb²)` has depth `2` along its maximal
ideal. -/
@[stacks 0F9L "depth of the seven-variable quotient"]
public theorem intermediateRing_depth (k : Type u) [Field k] :
    Module.depth (intermediateRing k) (IsLocalRing.maximalIdeal (intermediateRing k))
      (intermediateRing k) = 2 := by
  show Module.depth (extendedSocleRing k 2)
    (IsLocalRing.maximalIdeal (extendedSocleRing k 2)) (extendedSocleRing k 2) = 2
  rw [extendedSocleRing_depth]
  show Module.depth (socleRing k) (IsLocalRing.maximalIdeal (socleRing k))
    (socleRing k) + 2 = 2
  rw [socleRing_depth, zero_add]

/-- The ambient power-series ring is regular. -/
@[stacks 0F9L "regular ambient ring"]
public theorem powerSeriesRing_isRegularLocalRing (k : Type u) [Field k] :
    IsRegularLocalRing (powerSeriesRing k 8) := by
  show IsRegularLocalRing (MvPowerSeries (Fin 8) k)
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have hspan : (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 8) k)).spanFinrank ≤
      (8 : WithBot ℕ∞) := by
    exact_mod_cast spanFinrank_maximalIdeal_finiteMvPowerSeries_le k 8
  exact hspan.trans (natCast_le_ringKrullDim_finiteMvPowerSeries k 8)

/-- **Stacks 0F9L** (dimension of the ambient ring).
The power-series ring `k⟦a,b,x,y,z,u,v,w⟧` has Krull dimension `8`. -/
@[stacks 0F9L "dimension of the ambient ring"]
public theorem powerSeriesRing_dimension (k : Type u) [Field k] :
    ringKrullDim (powerSeriesRing k 8) = 8 := by
  show ringKrullDim (MvPowerSeries (Fin 8) k) = 8
  have hle : ringKrullDim (MvPowerSeries (Fin 8) k) ≤ (8 : WithBot ℕ∞) :=
    (ringKrullDim_le_spanFinrank_maximalIdeal _).trans
      (by exact_mod_cast spanFinrank_maximalIdeal_finiteMvPowerSeries_le k 8)
  have hge := natCast_le_ringKrullDim_finiteMvPowerSeries k 8
  exact_mod_cast le_antisymm hle hge

end Stacks.PuncturedSpectrumPicard.NonRegularSequence
