module

public import StacksFrontier.AlgebraicGeometry.RelativeProjBridge.SectionRing

/-!
# Generation in degree one, from the graded algebra to its rings of sections

For a quasi-coherent graded `𝒪_S`-algebra and an open `U` of the base, the graded ring of
homogeneous sections over `U`,
`Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra.sectionRing`, is generated over
its degree-zero part by its degree-one part as soon as the sheaf of graded algebras is generated
in degree one over `U`: every additive subgroup of the degree-`1 + n` sections over `U` which
contains all products of a degree-one section with a degree-`n` one is everything.

## Main definitions

* `…SheafGradedAlgebra.IsGeneratedInDegreeOneAt`: the sheaf of graded algebras is generated in
  degree one over an open of the base.

## Main results

* `…SheafGradedAlgebra.adjoin_grading_one_eq_top`: the ring of sections over an open is
  generated by its degree-one part over its degree-zero part, as soon as the algebra is
  generated in degree one over that open.

## Implementation notes

Generation in degree one is stated in additive-subgroup form, since the degree-`1 + n` piece of a
sheaf of graded algebras has no ambient object in which to write a span. The result is not
deducible from `Stacks.RelativeProj.Situation.adjoin_sectionRingGrading_one_eq_top`, nor
conversely: the carriers of the two section rings agree but their `CommRing` instances do not.

The transport between the degrees `1 + n` and `n + 1` is the additive equivalence
`pieceCastAux`, not a `rewrite`, since a motive mentioning the section group of a sheaf of
modules does not typecheck at `instance` transparency.

## References

* [Stacks Project, Tag 01NN](https://stacks.math.columbia.edu/tag/01NN)
* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open DirectSum

namespace Stacks.AlgebraicGeometry.RelativeProjBridge

universe u

namespace SheafGradedAlgebra

variable {S : Scheme.{u}} (A : SheafGradedAlgebra S) (U : S.Opens)

/-- **The algebra is generated in degree one over an open of the base.** Every additive subgroup
of the degree-`1 + n` sections over that open which contains every product of a degree-one section
with a degree-`n` one is the whole group. -/
public def IsGeneratedInDegreeOneAt : Prop :=
  ∀ (n : ℕ) (P : AddSubgroup Γ(A.piece (1 + (n : ℤ)), U)),
    (∀ (x : Γ(A.piece 1, U)) (y : Γ(A.piece (n : ℤ), U)),
      (A.mul 1 (n : ℤ)).app U x y ∈ P) → P = ⊤

/-- Transport of a homogeneous section along an equality of degrees, as an additive equivalence. -/
private noncomputable def pieceCastAux {i j : ℤ} (h : i = j) :
    Γ(A.piece i, U) ≃+ Γ(A.piece j, U) := by
  subst h; exact AddEquiv.refl _

private theorem pieceCastAux_heq {i j : ℤ} (h : i = j) (x : Γ(A.piece i, U)) :
    pieceCastAux A U h x ≍ x := by
  subst h; rfl

/-- The product in the section ring of a degree-one and a degree-`n` homogeneous section is their
product in the graded algebra, placed in the degree-`n + 1` summand. -/
private theorem of_mul_of_degree_one (n : ℕ) (x : A.sectionPieces U 1) (y : A.sectionPieces U n) :
    DirectSum.of (A.sectionPieces U) (n + 1)
        (pieceCastAux A U (show (1 : ℤ) + (n : ℤ) = ((n + 1 : ℕ) : ℤ) by omega)
          ((A.mul 1 (n : ℤ)).app U x y)) =
      DirectSum.of (A.sectionPieces U) 1 x * DirectSum.of (A.sectionPieces U) n y := by
  rw [DirectSum.of_mul_of]
  refine DirectSum.of_eq_of_gradedMonoid_eq (Sigma.ext (Nat.add_comm n 1) ?_)
  exact (pieceCastAux_heq A U _ _).trans (heq_of_eq (A.gMul_def U x y)).symm

/-- **The ring of sections over an open is generated by its degree-one part over its degree-zero
part**, as soon as the graded algebra is generated in degree one over that open. -/
public theorem adjoin_grading_one_eq_top (hgen : A.IsGeneratedInDegreeOneAt U) :
    Algebra.adjoin (A.grading U 0) (A.grading U 1 : Set (A.sectionRing U)) = ⊤ := by
  set D := Algebra.adjoin (A.grading U 0) (A.grading U 1 : Set (A.sectionRing U))
  have hone (x : A.sectionPieces U 1) : DirectSum.of (A.sectionPieces U) 1 x ∈ D :=
    Algebra.subset_adjoin ⟨x, rfl⟩
  have hmem (n : ℕ) (x : A.sectionPieces U n) :
      DirectSum.of (A.sectionPieces U) n x ∈ D := by
    induction n with
    | zero => exact D.algebraMap_mem ⟨_, ⟨x, rfl⟩⟩
    | succ n ih =>
        set c := pieceCastAux A U (show (1 : ℤ) + (n : ℤ) = ((n + 1 : ℕ) : ℤ) by omega)
        set P := D.toSubring.toAddSubgroup.comap
          ((DirectSum.of (A.sectionPieces U) (n + 1)).comp c.toAddMonoidHom)
        have hP : P = ⊤ := hgen n P fun z w => by
          change DirectSum.of (A.sectionPieces U) (n + 1)
            (c ((A.mul 1 (n : ℤ)).app U z w)) ∈ D
          rw [of_mul_of_degree_one A U n z w]
          exact D.mul_mem (hone z) (ih w)
        obtain ⟨w, rfl⟩ := c.surjective x
        exact show w ∈ P from hP.symm ▸ AddSubgroup.mem_top w
  refine top_unique fun x _ => ?_
  induction x using DirectSum.induction_on with
  | zero => exact D.zero_mem
  | of n x => exact hmem n x
  | add x y hx hy => exact D.add_mem (hx trivial) (hy trivial)

end SheafGradedAlgebra

end Stacks.AlgebraicGeometry.RelativeProjBridge

end
