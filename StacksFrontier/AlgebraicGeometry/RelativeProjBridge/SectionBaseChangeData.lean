/-!
# The graded rings of sections of a quasi-coherent graded algebra under base change

For a quasi-coherent graded `𝒪_S`-algebra `A` (Situation 01NN, as
`Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra`) the graded rings of sections
`Γ(U, A)` over affine opens compare in three ways, and each is a graded base change in the sense
of `Stacks.GradedBaseChange.IsGradedBaseChange`, killing as an identification
`Γ(U', A') = Γ(U') ⊗_{Γ(U)} Γ(U, A)` does (`Stacks.GradedBaseChange.Kills`):

* restriction `Γ(U, A) ⟶ Γ(V, A)` for affine opens `V ⊆ U`;
* pullback `Γ(U, A) ⟶ Γ(U', g^*A)` for a morphism `g : S' ⟶ S` and affine opens `U' ⊆ g⁻¹U`;
* a homomorphism of graded algebras which is an isomorphism in every degree.

The input in the first two cases is Stacks 01I9: the sections of a quasi-coherent module over an
affine open base change along restriction to a smaller affine open, and along pullback to an
affine open lying over it.

## Main results

* `Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra.isGradedBaseChange_res`,
  `…kills_res`: restriction.
* `…isGradedBaseChange_pullback`, `…kills_pullback`: pullback.
* `…isGradedBaseChange_ofUnitalHom`: an isomorphism.

## References

* [Stacks Project, Tag 01I9](https://stacks.math.columbia.edu/tag/01I9)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace
open scoped TensorProduct

universe u

namespace Stacks.GradedBaseChange

/-- **The two properties of a base change `M' = R' ⊗_R M` along `φ : R ⟶ R'` used for descent**:
`M'` is additively generated by the `r' • ρ m`, and an `R`-semilinear map out of `M` into an
`R'`-module extends along `ρ` to an `R'`-linear map out of `M'`. -/
def PieceBaseChange {R R' M M' : Type u} [CommRing R] [CommRing R'] [AddCommGroup M]
    [Module R M] [AddCommGroup M'] [Module R' M'] (φ : R →+* R') (ρ : M →+ M') : Prop :=
  (∀ y : M', y ∈ AddSubgroup.closure {z | ∃ (r' : R') (m : M), z = r' • ρ m}) ∧
  ∀ (T : Type u) [AddCommGroup T] [Module R' T] (l : M →+ T), (∀ r m, l (r • m) = φ r • l m) →
    ∃ ψ : M' →+ T, (∀ (r' : R') y, ψ (r' • y) = r' • ψ y) ∧ ∀ m, ψ (ρ m) = l m

/-- An `IsBaseChange` gives the two properties of `PieceBaseChange`. -/
theorem pieceBaseChange_of_isBaseChange {R R' M M' : Type u} [CommRing R] [CommRing R']
    [Algebra R R'] [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R' M'] [Module R M']
    [IsScalarTower R R' M'] {ρ : M →ₗ[R] M'} (h : IsBaseChange R' ρ) :
    PieceBaseChange (algebraMap R R') ρ.toAddMonoidHom := by
  refine ⟨fun y => ?_, fun T _ _ l hl => ?_⟩
  · refine h.inductionOn y _ (zero_mem _) (fun m => ?_) (fun s n hn => ?_)
      (fun _ _ h₁ h₂ => add_mem h₁ h₂)
    · exact AddSubgroup.subset_closure ⟨1, m, by simp⟩
    · induction hn using AddSubgroup.closure_induction with
      | mem z hz =>
        obtain ⟨r', m, rfl⟩ := hz
        exact AddSubgroup.subset_closure ⟨s * r', m, by rw [mul_smul]⟩
      | zero => simp
      | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
      | neg x _ hx => rw [smul_neg]; exact neg_mem hx
  · let : Module R T := Module.compHom T (algebraMap R R')
    have : IsScalarTower R R' T := ⟨fun x y z => by
      rw [Algebra.smul_def]
      exact mul_smul (algebraMap R R' x) y z⟩
    let l' : M →ₗ[R] T :=
      { toFun := l
        map_add' := map_add l
        map_smul' := fun r m => hl r m }
    exact ⟨(h.lift l').toAddMonoidHom, fun r' y => map_smul (h.lift l') r' y,
      fun m => h.lift_eq l' m⟩

end Stacks.GradedBaseChange

namespace Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra

open Stacks.GradedBaseChange
open Stacks.AlgebraicGeometry.RelativeProjMapDomain
open Stacks.AlgebraicGeometry.RelativeProjQcohSheaf (situationAlgebra)

/-! ### Graded base changes from degreewise base changes -/

section Pieces

variable {S S' : Scheme.{u}} (A : SheafGradedAlgebra S) (A' : SheafGradedAlgebra S')
  {U : S.Opens} {U' : S'.Opens} (φ : Γ(S, U) →+* Γ(S', U')) (Φ : A.grading U →+*ᵍ A'.grading U')
  (ρ : ∀ n, A.sectionPieces U n →+ A'.sectionPieces U' n)

/-- **A graded ring map of sections which is a base change in every degree is a graded base
change.** -/
theorem isGradedBaseChange_of_pieces
    (hΦ : ∀ n a, Φ (DirectSum.of (A.sectionPieces U) n a) =
      DirectSum.of (A'.sectionPieces U') n (ρ n a))
    (hρ : ∀ n (r : Γ(S, U)) a, ρ n (r • a) = φ r • ρ n a)
    (hone : ρ 0 (A.one U) = A'.one U')
    (hbc : ∀ n, PieceBaseChange φ (ρ n)) :
    IsGradedBaseChange (A.strHom U) (A'.strHom U') φ Φ where
  σ_mem := A.strHom_mem U
  σ'_mem := A'.strHom_mem U'
  comm r := by rw [A.strHom_apply, hΦ, hρ, hone, A'.strHom_apply]
  mem_spanVia y := by
    induction y using DirectSum.induction_on with
    | zero => exact zero_mem _
    | of n y =>
      have hy := (hbc n).1 y
      induction hy using AddSubgroup.closure_induction with
      | mem z hz =>
        obtain ⟨r', m, rfl⟩ := hz
        rw [← A'.strHom_mul_of, ← hΦ]
        exact smul_mem_spanVia _ ⟨_, rfl⟩
      | zero => simp
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | neg x _ hx => rw [map_neg]; exact neg_mem hx
    | add x y hx hy => exact add_mem hx hy

/-- **A graded ring map of sections which is a base change in every degree kills as an
identification `Γ(U', A') = Γ(U') ⊗_{Γ(U)} Γ(U, A)` does.** -/
theorem kills_of_pieces
    (hΦ : ∀ n a, Φ (DirectSum.of (A.sectionPieces U) n a) =
      DirectSum.of (A'.sectionPieces U') n (ρ n a))
    (hbc : ∀ n, PieceBaseChange φ (ρ n)) :
    Kills (A.strHom U) (A'.strHom U') φ Φ.toRingHom := by
  classical
  let : Module Γ(S, U) (A.sectionRing U) := Module.compHom _ (A.strHom U)
  let := φ.toAlgebra
  intro N b hb
  let Q := A.sectionRing U ⧸ N
  let T := Γ(S', U') ⊗[Γ(S, U)] Q
  let l : ∀ n, A.sectionPieces U n →+ T := fun n =>
    (TensorProduct.mk Γ(S, U) Γ(S', U') Q 1).toAddMonoidHom.comp
      (N.mkQ.toAddMonoidHom.comp (DirectSum.of (A.sectionPieces U) n))
  have hl : ∀ n (r : Γ(S, U)) (a : A.sectionPieces U n), l n (r • a) = φ r • l n a := by
    intro n r a
    have key : N.mkQ (A.strHom U r * DirectSum.of (A.sectionPieces U) n a) =
        r • N.mkQ (DirectSum.of (A.sectionPieces U) n a) :=
      N.mkQ.map_smul r _
    simp only [l, AddMonoidHom.comp_apply, LinearMap.toAddMonoidHom_coe, TensorProduct.mk_apply]
    rw [← A.strHom_mul_of, key, TensorProduct.tmul_smul, ← algebraMap_smul Γ(S', U') r]
    rfl
  choose ψ hψsmul hψρ using fun n => (hbc n).2 T (l n) (hl n)
  let Ψ : A'.sectionRing U' →+ T := DirectSum.toAddMonoid ψ
  have hΨΦ : ∀ x : A.sectionRing U, Ψ (Φ x) = (1 : Γ(S', U')) ⊗ₜ N.mkQ x := by
    intro x
    induction x using DirectSum.induction_on with
    | zero => simp
    | of n a =>
      rw [hΦ, DirectSum.toAddMonoid_of, hψρ]
      rfl
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, TensorProduct.tmul_add]
  have hΨσ : ∀ (r' : Γ(S', U')) y, Ψ (A'.strHom U' r' * y) = r' • Ψ y := by
    intro r' y
    induction y using DirectSum.induction_on with
    | zero => simp
    | of n y => rw [A'.strHom_mul_of, DirectSum.toAddMonoid_of, DirectSum.toAddMonoid_of, hψsmul]
    | add x y hx hy => rw [mul_add, map_add, map_add, hx, hy, smul_add]
  have hker : spanVia (A'.strHom U') (Φ '' (N : Set (A.sectionRing U))) ≤ Ψ.ker :=
    spanVia_le fun r' _ ⟨x, hx, e⟩ => by
      subst e
      have hx0 : N.mkQ x = 0 := (Submodule.Quotient.mk_eq_zero N).2 hx
      rw [AddMonoidHom.mem_ker, hΨσ, hΨΦ, hx0, TensorProduct.tmul_zero, smul_zero]
  have h0 := hker hb
  rw [AddMonoidHom.mem_ker] at h0
  rw [← hΨΦ]
  exact h0

end Pieces

/-! ### Restriction -/

section Restriction

variable {S : Scheme.{u}} (A : SheafGradedAlgebra S) {U V : S.Opens}

/-- Restriction of homogeneous sections between affine opens is a base change (Stacks 01I9). -/
theorem pieceBaseChange_res (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ U) (n : ℕ) :
    PieceBaseChange (S.presheaf.map (homOfLE h).op).hom (A.resPiece h n) := by
  let : Algebra Γ(S, U) Γ(S, V) := (S.presheaf.map (homOfLE h).op).hom.toAlgebra
  let : Module Γ(S, U) Γ(A.piece (n : ℤ), V) :=
    Module.compHom _ (S.presheaf.map (homOfLE h).op).hom
  have : IsScalarTower Γ(S, U) Γ(S, V) Γ(A.piece (n : ℤ), V) :=
    ⟨fun x y z => mul_smul ((S.presheaf.map (homOfLE h).op).hom x) y z⟩
  let ρl : Γ(A.piece (n : ℤ), U) →ₗ[Γ(S, U)] Γ(A.piece (n : ℤ), V) :=
    { toFun := A.resPiece h n
      map_add' := map_add _
      map_smul' := A.resPiece_smul h n }
  have key := pieceBaseChange_of_isBaseChange
    (AlgebraicGeometry.isBaseChange_restrict_of_isAffineOpen (A.piece (n : ℤ)) hU hV h
      (fun _ => rfl) ρl (fun _ => rfl))
  exact key

/-- **Restriction of sections between affine opens is a graded base change.** -/
theorem isGradedBaseChange_res (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ U) :
    IsGradedBaseChange (A.strHom U) (A.strHom V) (S.presheaf.map (homOfLE h).op).hom
      (A.res h) :=
  isGradedBaseChange_of_pieces A A _ (A.res h) (fun n => A.resPiece h n)
    (fun _ a => A.resRingHom_of h a) (fun n r a => A.resPiece_smul h n r a) (A.resPiece_one h)
    (pieceBaseChange_res A hU hV h)

/-- **Restriction of sections between affine opens kills as a base change does.** -/
theorem kills_res (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ U) :
    Kills (A.strHom U) (A.strHom V) (S.presheaf.map (homOfLE h).op).hom (A.res h).toRingHom :=
  kills_of_pieces A A _ (A.res h) (fun n => A.resPiece h n) (fun _ a => A.resRingHom_of h a)
    (pieceBaseChange_res A hU hV h)

end Restriction

/-! ### Pullback -/

section Pullback

variable {S S' : Scheme.{u}} (A : SheafGradedAlgebra S) (g : S' ⟶ S) {U : S.Opens}
  {U' : S'.Opens}

/-- **Pulling back the unit.** The unit of `g^*A` is the pullback of the unit of `A`. -/
theorem pullbackSection_one (h : U' ≤ g ⁻¹ᵁ U) :
    Scheme.Modules.pullbackSection g (A.piece 0) U U' h (A.one U) = (A.pullback g).one U' := by
  have e1 := Stacks.AlgebraicGeometry.ModuleLimits.pullbackSection_shrink g (A.piece 0) U
    (g ⁻¹ᵁ U) U' le_rfl h h (A.one U)
  have e2 : (Stacks.Conormal.gradedPullback g (situationAlgebra A)).one.eval (op (g ⁻¹ᵁ U)) =
      Scheme.Modules.pullbackSection g (A.piece 0) U (g ⁻¹ᵁ U) le_rfl (A.one U) :=
    Stacks.Conormal.gradedPullback_one_eval g (situationAlgebra A) U
  rw [← e1, ← e2]
  exact (Stacks.Conormal.gradedPullback g (situationAlgebra A)).one.property (homOfLE h).op

/-- Pullback of homogeneous sections to an affine open lying over an affine open is a base change
(Stacks 01I9). -/
theorem pieceBaseChange_pullback (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
    (h : U' ≤ g ⁻¹ᵁ U) (n : ℕ) :
    PieceBaseChange (g.appLE U U' h).hom
      (Scheme.Modules.pullbackSectionₗ g (A.piece (n : ℤ)) U U' h).toAddMonoidHom := by
  let : Algebra Γ(S, U) Γ(S', U') := (g.appLE U U' h).hom.toAlgebra
  let := Scheme.Modules.pullbackSectionsModule g (A.piece (n : ℤ)) U U' h
  have : IsScalarTower Γ(S, U) Γ(S', U')
      Γ((Scheme.Modules.pullback g).obj (A.piece (n : ℤ)), U') :=
    ⟨fun x y z => mul_smul ((g.appLE U U' h).hom x) y z⟩
  exact pieceBaseChange_of_isBaseChange
    (AlgebraicGeometry.isBaseChange_pullbackSection_of_isAffineOpen g (A.piece (n : ℤ)) hU hU' h
      (fun _ => rfl) (Scheme.Modules.pullbackSectionₗ g (A.piece (n : ℤ)) U U' h) (fun _ => rfl))

/-- **Pullback of sections to an affine open lying over an affine open is a graded base
change.** -/
theorem isGradedBaseChange_pullback (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
    (h : U' ≤ g ⁻¹ᵁ U) :
    IsGradedBaseChange (A.strHom U) ((A.pullback g).strHom U') (g.appLE U U' h).hom
      (Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.sectionBaseChange A g ⟨U, hU⟩
        ⟨U', hU'⟩ h) :=
  isGradedBaseChange_of_pieces A (A.pullback g) _ _
    (fun n => (Scheme.Modules.pullbackSectionₗ g (A.piece (n : ℤ)) U U' h).toAddMonoidHom)
    (fun n a => Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.sectionBaseChange_of A g
      ⟨U, hU⟩ ⟨U', hU'⟩ h n a)
    (fun n r a => Stacks.RelativeProj.Situation.pullbackSection_smul_appLE g (A.piece (n : ℤ))
      U U' h r a)
    (pullbackSection_one A g h) (pieceBaseChange_pullback A g hU hU' h)

/-- **Pullback of sections to an affine open lying over an affine open kills as a base change
does.** -/
theorem kills_pullback (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U' ≤ g ⁻¹ᵁ U) :
    Kills (A.strHom U) ((A.pullback g).strHom U') (g.appLE U U' h).hom
      (Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.sectionBaseChange A g ⟨U, hU⟩
        ⟨U', hU'⟩ h).toRingHom :=
  kills_of_pieces A (A.pullback g) _ _
    (fun n => (Scheme.Modules.pullbackSectionₗ g (A.piece (n : ℤ)) U U' h).toAddMonoidHom)
    (fun n a => Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.sectionBaseChange_of A g
      ⟨U, hU⟩ ⟨U', hU'⟩ h n a)
    (pieceBaseChange_pullback A g hU hU' h)

end Pullback

/-! ### Isomorphisms -/

section Iso

variable {S : Scheme.{u}} {A A' : SheafGradedAlgebra S}

/-- A unital homomorphism of the underlying sheaves of graded algebras is a homomorphism of the
graded algebra data of Situation 01NN: the same morphisms in each degree. -/
def ofUnitalHom (ψ : SheafOfModules.GradedAlgebra.UnitalHom (situationAlgebra A)
    (situationAlgebra A')) : SheafGradedAlgebraHom A A' where
  app n := ψ.app n
  app_mul i j U a b := ψ.map_mul i j (op U) a b
  app_one U := ψ.map_one (op U)

/-- **A homomorphism of graded algebras which is an isomorphism in every degree is a graded base
change on the sections over every open**, over the identity of `Γ(S, U)`. -/
theorem isGradedBaseChange_ofUnitalHom
    (ψ : SheafOfModules.GradedAlgebra.UnitalHom (situationAlgebra A) (situationAlgebra A'))
    [∀ n, IsIso (ψ.app n)] (U : S.Opens) :
    IsGradedBaseChange (A.strHom U) (A'.strHom U) (RingHom.id _)
      ((ofUnitalHom ψ).sectionHom U) := by
  have hsmul : ∀ (r : Γ(S, U)) n (a : A.sectionPieces U n),
      (ofUnitalHom ψ).sectionPieceHom U n (r • a) =
        r • (ofUnitalHom ψ).sectionPieceHom U n a := fun r n a =>
    Scheme.Modules.Hom.app_smul ((ofUnitalHom ψ).app (n : ℤ)) r a
  have hpiece : ∀ n (y : A'.sectionPieces U n),
      (ofUnitalHom ψ).sectionPieceHom U n ((ofUnitalHom ψ.inverse).sectionPieceHom U n y) = y :=
    fun n y => SheafOfModules.GradedAlgebra.app_inv_app_apply ψ (n : ℤ) (op U) y
  refine isGradedBaseChange_of_surjective (A.strHom_mem U) (A'.strHom_mem U) (fun r => ?_)
    (fun y => ?_)
  · rw [A.strHom_apply, SheafGradedAlgebraHom.sectionHom_of, hsmul,
      SheafGradedAlgebraHom.sectionPieceHom_one, A'.strHom_apply]
  · induction y using DirectSum.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | of n y =>
      exact ⟨DirectSum.of _ n ((ofUnitalHom ψ.inverse).sectionPieceHom U n y), by
        rw [SheafGradedAlgebraHom.sectionHom_of, hpiece]⟩
    | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, map_add _ a b⟩

end Iso

end Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra

