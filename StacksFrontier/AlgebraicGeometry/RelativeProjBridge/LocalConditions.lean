/-!
# The finiteness conditions on a quasi-coherent graded algebra are étale local on the base

For a quasi-coherent graded `𝒪_S`-algebra `A` on a scheme `S`, the hypotheses of Stacks 07ZX,
07ZY and 07ZZ are read over the affine opens `U` of `S` on the graded ring of sections
`Γ(U, A)`:

* `A` is of finite type over `A₀`
  (`Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra.IsFiniteTypeOverDegreeZero`);
* `𝒪_S ⟶ A₀` is integral (`…SheafGradedAlgebra.IsIntegralInDegreeZero`);
* `A` is generated by a finite type `A₁` over `A₀`
  (`…SheafGradedAlgebra.IsFinitelyGeneratedInDegreeOne`);
* `A₊` is locally nilpotent modulo a finite type part
  (`…SheafGradedAlgebra.HasNilpotentPositiveQuotient`);
* `A` is of finite type over `𝒪_S` (`Stacks.AlgebraicGeometry.RelativeProjFiniteType.IsFiniteType`,
  read on a neighbourhood of every point).

Each of them holds for the pullback `g^*A` along every morphism `g : S' ⟶ S` when it holds for
`A`, and holds for `A` when it holds for `g^*A` along one surjective étale `g`; and each is
unchanged by an isomorphism of graded algebras. These are the properties that make the conditions
meaningful for a quasi-coherent graded algebra on an algebraic space: they are local in the étale
topology. The proof reduces to commutative algebra over the affine opens through Stacks 01I9 (the
sections over an affine open lying over an affine open are a base change) and faithfully flat
descent along the finite family of affine opens of the source covering an affine open of the
target.

## Main definitions

* `Stacks.AlgebraicGeometry.RelativeProjBridge.SectionCondition`: a condition on graded rings
  stable under graded base change and descending along faithfully flat families, and
  `SectionCondition.OnAffines`: the condition on the graded rings of sections over all affine
  opens.

## Main results

* `Stacks.AlgebraicGeometry.RelativeProjBridge.SectionCondition.onAffines_pullback`: stability
  under pullback along any morphism of schemes.
* `Stacks.AlgebraicGeometry.RelativeProjBridge.SectionCondition.onAffines_of_pullback`: descent
  along a surjective étale morphism.
* `Stacks.AlgebraicGeometry.RelativeProjBridge.SectionCondition.onAffines_iff_of_unitalHom`:
  invariance under isomorphism.
* `Stacks.AlgebraicGeometry.RelativeProjBridge.SectionCondition.onAffines_iff_local`: the
  condition over all affine opens is the condition on an affine neighbourhood of every point.
* `Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra.isFiniteType_iff_onAffines`
  and `…isFiniteTypeOverDegreeZero_iff_onAffines`: each of the five conditions on a
  `SheafGradedAlgebra` is `SectionCondition.OnAffines` for one of the five section conditions.

## References

* [Stacks Project, Tag 01I9](https://stacks.math.columbia.edu/tag/01I9)
* [Stacks Project, Tag 07ZX](https://stacks.math.columbia.edu/tag/07ZX)
* [Stacks Project, Tag 07ZY](https://stacks.math.columbia.edu/tag/07ZY)
* [Stacks Project, Tag 07ZZ](https://stacks.math.columbia.edu/tag/07ZZ)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace
open Stacks.GradedBaseChange

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjBridge

/-! ### Affine coverings and faithfully flat families of sections -/

section Coverings

/-- **The sections over a finite family of affine opens covering an affine open, through a flat
morphism, are jointly faithfully flat.** -/
theorem faithfullyFlat_pi_appLE {X Y : Scheme.{u}} (f : X ⟶ Y) [Flat f] {U : Y.Opens}
    (hU : IsAffineOpen U) {ι : Type u} [Finite ι] (V : ι → X.Opens)
    (hV : ∀ i, IsAffineOpen (V i)) (e : ∀ i, V i ≤ f ⁻¹ᵁ U)
    (hcov : ∀ x ∈ U, ∃ i, ∃ y ∈ V i, f y = x) :
    (RingHom.pi fun i => (f.appLE U (V i) (e i)).hom).FaithfullyFlat := by
  refine RingHom.FaithfullyFlat.pi _ (fun i => Flat.flat_appLE f hU (hV i) (e i)) fun p => ?_
  have hp : hU.fromSpec p ∈ U := by
    change hU.fromSpec p ∈ (U : Set Y)
    rw [← hU.range_fromSpec]
    exact Set.mem_range_self _
  obtain ⟨i, y, hy, hfy⟩ := hcov _ hp
  refine ⟨i, (hV i).primeIdealOf ⟨y, hy⟩, ?_⟩
  rw [IsAffineOpen.comap_primeIdealOf_appLE U hU (V i) (hV i) (e i) hy]
  exact hU.fromSpec.isOpenEmbedding.injective (by rwa [hU.fromSpec_primeIdealOf])

/-- **The restrictions to a finite family of affine opens covering an affine open are jointly
faithfully flat.** -/
theorem faithfullyFlat_pi_res {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U) {ι : Type u}
    [Finite ι] (V : ι → X.Opens) (hV : ∀ i, IsAffineOpen (V i)) (e : ∀ i, V i ≤ U)
    (hcov : ∀ x ∈ U, ∃ i, x ∈ V i) :
    (RingHom.pi fun i => (X.presheaf.map (homOfLE (e i)).op).hom).FaithfullyFlat :=
  faithfullyFlat_pi_appLE (𝟙 X) hU V hV (fun i => e i) fun x hx => by
    obtain ⟨i, hi⟩ := hcov x hx
    exact ⟨i, x, hi, rfl⟩

/-- **An affine open is covered by finitely many affine opens refining a given neighbourhood of
each of its points.** -/
theorem exists_finite_affine_refinement {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    (O : X → X.Opens) (hO : ∀ x ∈ U, x ∈ O x) :
    ∃ (ι : Type u) (_ : Finite ι) (V : ι → X.Opens) (c : ι → X),
      (∀ i, IsAffineOpen (V i)) ∧ (∀ i, V i ≤ U) ∧ (∀ i, V i ≤ O (c i)) ∧
        ∀ x ∈ U, ∃ i, x ∈ V i := by
  classical
  have hex : ∀ x : U, ∃ W : X.Opens, IsAffineOpen W ∧ (x : X) ∈ W ∧ W.1 ⊆ U ⊓ O x :=
    fun x => exists_isAffineOpen_mem_and_subset (U := U ⊓ O x) ⟨x.2, hO x x.2⟩
  choose W hW hxW hWU using hex
  obtain ⟨t, ht⟩ := hU.isCompact.elim_finite_subcover (fun x : U => (W x : Set X))
    (fun x => (W x).2) fun x hx => Set.mem_iUnion.2 ⟨⟨x, hx⟩, hxW ⟨x, hx⟩⟩
  refine ⟨t, inferInstance, fun i => W i.1, fun i => i.1.1, fun i => hW i.1,
    fun i _ hy => (hWU i.1 hy).1, fun i _ hy => (hWU i.1 hy).2, ?_⟩
  intro x hx
  obtain ⟨i, hit, hx'⟩ := Set.mem_iUnion₂.1 (ht hx)
  exact ⟨⟨i, hit⟩, hx'⟩

/-- **An affine open of the target of a surjective étale morphism is covered by the images of
finitely many affine opens of its preimage.** -/
theorem exists_finite_affine_cover_image {X Y : Scheme.{u}} (f : X ⟶ Y) [Etale f]
    (hsurj : Function.Surjective f.base) {U : Y.Opens} (hU : IsAffineOpen U) :
    ∃ (ι : Type u) (_ : Finite ι) (V : ι → X.Opens),
      (∀ i, IsAffineOpen (V i)) ∧ (∀ i, V i ≤ f ⁻¹ᵁ U) ∧
        ∀ x ∈ U, ∃ i, ∃ y ∈ V i, f y = x := by
  classical
  have hex : ∀ x : U, ∃ W : X.Opens, IsAffineOpen W ∧ (hsurj x).choose ∈ W ∧ W.1 ⊆ f ⁻¹ᵁ U :=
    fun x => exists_isAffineOpen_mem_and_subset (U := f ⁻¹ᵁ U)
      (show f (hsurj x).choose ∈ U by rw [(hsurj x).choose_spec]; exact x.2)
  choose W hW hyW hWU using hex
  obtain ⟨t, ht⟩ := hU.isCompact.elim_finite_subcover (fun x : U => f.base '' (W x : Set X))
    (fun x => f.isOpenMap _ (W x).2) fun x hx =>
      Set.mem_iUnion.2 ⟨⟨x, hx⟩, ⟨_, hyW ⟨x, hx⟩, (hsurj x).choose_spec⟩⟩
  refine ⟨t, inferInstance, fun i => W i.1, fun i => hW i.1, fun i => hWU i.1, ?_⟩
  intro x hx
  obtain ⟨i, hit, y, hy, hfy⟩ := Set.mem_iUnion₂.1 (ht hx)
  exact ⟨⟨i, hit⟩, y, hy, hfy⟩

end Coverings

/-! ### Conditions on the graded rings of sections -/

/-- **A condition on graded rings over a base ring which is local in the faithfully flat
topology**: it passes to graded base changes and descends along faithfully flat families. -/
structure SectionCondition : Type (u + 1) where
  /-- The condition on a graded ring `B` with a ring map `R ⟶ B₀`. -/
  Q : ∀ {R B : Type u} [CommRing R] [CommRing B] (𝒜 : ℕ → AddSubgroup B) [GradedRing 𝒜],
    (R →+* B) → Prop
  /-- The condition passes to a graded base change. -/
  bc : ∀ {R B R' B' : Type u} [CommRing R] [CommRing B] [CommRing R'] [CommRing B']
    {𝒜 : ℕ → AddSubgroup B} [GradedRing 𝒜] {𝒜' : ℕ → AddSubgroup B'} [GradedRing 𝒜']
    {σ : R →+* B} {σ' : R' →+* B'} {φ : R →+* R'} {Φ : 𝒜 →+*ᵍ 𝒜'},
    IsGradedBaseChange σ σ' φ Φ → Q 𝒜 σ → Q 𝒜' σ'
  /-- The condition descends along a faithfully flat family. -/
  desc : ∀ {R B : Type u} [CommRing R] [CommRing B] {𝒜 : ℕ → AddSubgroup B} [GradedRing 𝒜]
    {σ : R →+* B} {ι : Type u} [Finite ι] {R'' B'' : ι → Type u} [∀ i, CommRing (R'' i)]
    [∀ i, CommRing (B'' i)] {𝒜'' : ∀ i, ℕ → AddSubgroup (B'' i)} [∀ i, GradedRing (𝒜'' i)]
    {σ'' : ∀ i, R'' i →+* B'' i} {φ'' : ∀ i, R →+* R'' i} {Φ'' : ∀ i, 𝒜 →+*ᵍ 𝒜'' i},
    IsGradedDescentFamily σ σ'' φ'' Φ'' → (∀ i, Q (𝒜'' i) (σ'' i)) → Q 𝒜 σ

namespace SectionCondition

variable (c : SectionCondition.{u})

/-- The condition on the graded rings of sections over every affine open. -/
def OnAffines {S : Scheme.{u}} (A : SheafGradedAlgebra S) : Prop :=
  ∀ U : S.Opens, IsAffineOpen U → c.Q (A.grading U) (A.strHom U)

/-- **Descent from finitely many affine opens covering an affine open.** -/
theorem of_res {S : Scheme.{u}} (A : SheafGradedAlgebra S) {U : S.Opens} (hU : IsAffineOpen U)
    {ι : Type u} [Finite ι] (V : ι → S.Opens) (hV : ∀ i, IsAffineOpen (V i)) (e : ∀ i, V i ≤ U)
    (hcov : ∀ x ∈ U, ∃ i, x ∈ V i) (h : ∀ i, c.Q (A.grading (V i)) (A.strHom (V i))) :
    c.Q (A.grading U) (A.strHom U) :=
  c.desc (σ'' := fun i => A.strHom (V i))
    (φ'' := fun i => (S.presheaf.map (homOfLE (e i)).op).hom) (Φ'' := fun i => A.res (e i))
    ⟨A.strHom_mem U, fun i => SheafGradedAlgebra.isGradedBaseChange_res A hU (hV i) (e i),
      faithfullyFlat_pi_res hU V hV e hcov,
      fun i => SheafGradedAlgebra.kills_res A hU (hV i) (e i)⟩ h

/-- The condition on an affine open follows from it on every affine open inside the open
and inside a chosen neighbourhood of each of its points. -/
private theorem of_nbhd {S : Scheme.{u}} (A : SheafGradedAlgebra S) {U : S.Opens}
    (hU : IsAffineOpen U) (O : S → S.Opens) (hO : ∀ x ∈ U, x ∈ O x)
    (h : ∀ x (V : S.Opens), IsAffineOpen V → V ≤ U → V ≤ O x →
      c.Q (A.grading V) (A.strHom V)) :
    c.Q (A.grading U) (A.strHom U) := by
  obtain ⟨ι, _, V, x, hV, hVU, hVO, hcov⟩ := exists_finite_affine_refinement hU O hO
  exact c.of_res A hU V hV hVU hcov fun i => h _ _ (hV i) (hVU i) (hVO i)

/-- **The condition is stable under pullback along any morphism of schemes.** -/
theorem onAffines_pullback {S S' : Scheme.{u}} (A : SheafGradedAlgebra S) (g : S' ⟶ S)
    (h : c.OnAffines A) : c.OnAffines (A.pullback g) := by
  intro U' hU'
  have hex : ∀ x : S', ∃ W : S.Opens, IsAffineOpen W ∧ g x ∈ W ∧ W.1 ⊆ ⊤ :=
    fun x => exists_isAffineOpen_mem_and_subset (U := ⊤) trivial
  choose W hW hxW _ using hex
  exact c.of_nbhd (A.pullback g) hU' (fun x => g ⁻¹ᵁ W x) (fun x _ => hxW x) fun x _ hV _ hVW =>
    c.bc (SheafGradedAlgebra.isGradedBaseChange_pullback A g (hW x) hV hVW) (h _ (hW x))

/-- **The condition descends along a surjective étale morphism of schemes.** -/
theorem onAffines_of_pullback {S S' : Scheme.{u}} (A : SheafGradedAlgebra S) (g : S' ⟶ S)
    [Etale g] (hsurj : Function.Surjective g.base) (h : c.OnAffines (A.pullback g)) :
    c.OnAffines A := by
  intro U hU
  obtain ⟨ι, _, V, hV, hVU, hcov⟩ := exists_finite_affine_cover_image g hsurj hU
  exact c.desc (σ'' := fun i => (A.pullback g).strHom (V i))
    (φ'' := fun i => (g.appLE U (V i) (hVU i)).hom)
    (Φ'' := fun i => Stacks.AlgebraicGeometry.RelativeProjBaseChangeTwist.sectionBaseChange A g
      ⟨U, hU⟩ ⟨V i, hV i⟩ (hVU i))
    ⟨A.strHom_mem U, fun i => SheafGradedAlgebra.isGradedBaseChange_pullback A g hU (hV i) (hVU i),
      faithfullyFlat_pi_appLE g hU V hV hVU hcov,
      fun i => SheafGradedAlgebra.kills_pullback A g hU (hV i) (hVU i)⟩
    fun i => h _ (hV i)

/-- **The condition is unchanged by an isomorphism of graded algebras.** -/
theorem onAffines_iff_of_unitalHom {S : Scheme.{u}} {A A' : SheafGradedAlgebra S}
    (ψ : SheafOfModules.GradedAlgebra.UnitalHom
      (Stacks.AlgebraicGeometry.RelativeProjQcohSheaf.situationAlgebra A)
      (Stacks.AlgebraicGeometry.RelativeProjQcohSheaf.situationAlgebra A'))
    [∀ n, IsIso (ψ.app n)] : c.OnAffines A ↔ c.OnAffines A' := by
  have : ∀ n, IsIso (ψ.inverse.app n) := fun n => by
    rw [SheafOfModules.GradedAlgebra.UnitalHom.inverse_app]
    infer_instance
  exact ⟨fun h U hU => c.bc (SheafGradedAlgebra.isGradedBaseChange_ofUnitalHom ψ U) (h U hU),
    fun h U hU => c.bc (SheafGradedAlgebra.isGradedBaseChange_ofUnitalHom ψ.inverse U) (h U hU)⟩

/-- **The condition over all affine opens is the condition over an affine neighbourhood of every
point.** -/
theorem onAffines_iff_local {S : Scheme.{u}} (A : SheafGradedAlgebra S) :
    c.OnAffines A ↔
      ∀ x : S, ∃ U : S.Opens, IsAffineOpen U ∧ x ∈ U ∧ c.Q (A.grading U) (A.strHom U) := by
  refine ⟨fun h x => ?_, fun h U hU => ?_⟩
  · obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    exact ⟨U, hU, hxU, h U hU⟩
  · choose W hW hxW hQW using h
    exact c.of_nbhd A hU W (fun x _ => hxW x) fun x _ hV _ hVW =>
      c.bc (SheafGradedAlgebra.isGradedBaseChange_res A (hW x) hV hVW) (hQW x)

end SectionCondition

/-! ### The five conditions -/

/-- `B` is of finite type over `B₀`. -/
def finiteTypeOverDegreeZeroCondition : SectionCondition.{u} where
  Q {_ B} _ _ 𝒜 _ _ := Algebra.FiniteType (𝒜 0) B
  bc h hq := finiteType_zero_of_isGradedBaseChange h hq
  desc hfam h := finiteType_zero_of_isGradedDescentFamily hfam h

/-- `R ⟶ B₀` is integral. -/
def integralInDegreeZeroCondition : SectionCondition.{u} where
  Q 𝒜 _ σ := ((GradedRing.projZeroRingHom' 𝒜).comp σ).IsIntegral
  bc h hq := isIntegral_zero_of_isGradedBaseChange h hq
  desc hfam h := isIntegral_zero_of_isGradedDescentFamily hfam h

/-- `B` is of finite type over `R`. -/
def finiteTypeCondition : SectionCondition.{u} where
  Q _ _ σ := σ.FiniteType
  bc h hq := finiteType_of_isGradedBaseChange h hq
  desc hfam h := finiteType_of_isGradedDescentFamily hfam h

/-- `B` is generated over `B₀` by a finite `B₀`-module `B₁`. -/
def finitelyGeneratedInDegreeOneCondition : SectionCondition.{u} where
  Q {_ B} _ _ 𝒜 _ _ := Algebra.adjoin (𝒜 0) (𝒜 1 : Set B) = ⊤ ∧ ∃ t : Finset B,
      (t : Set B) ⊆ (𝒜 1 : Set B) ∧
        (𝒜 1 : Set B) ⊆ (Submodule.span (𝒜 0) (t : Set B) : Set B)
  bc h hq := finitelyGeneratedInDegreeOne_of_isGradedBaseChange h hq
  desc hfam h := finitelyGeneratedInDegreeOne_of_isGradedDescentFamily hfam h

/-- `B₊` is nil modulo the ideal generated by a finitely generated `B₀`-submodule of `B₊`. -/
def nilpotentPositiveQuotientCondition : SectionCondition.{u} where
  Q {_ B} _ _ 𝒜 _ _ := ∃ F : Submodule (𝒜 0) B,
      (F : Set B) ⊆ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ∧ F.FG ∧
      ∀ x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal, ∃ n : ℕ, x ^ n ∈ Ideal.span (F : Set B)
  bc h hq := hasNilpotentPositiveQuotient_of_isGradedBaseChange h hq
  desc hfam h := hasNilpotentPositiveQuotient_of_isGradedDescentFamily hfam h

namespace SheafGradedAlgebra

variable {S S' : Scheme.{u}} (A : SheafGradedAlgebra S)

/-- **`A` is of finite type over `A₀` if and only if `Γ(U, A)` is of finite type over `Γ(U, A₀)`
for every affine open `U`.** -/
theorem isFiniteTypeOverDegreeZero_iff_onAffines :
    A.IsFiniteTypeOverDegreeZero ↔ finiteTypeOverDegreeZeroCondition.OnAffines A :=
  Iff.rfl

/-- **`𝒪_S ⟶ A₀` is integral if and only if `Γ(U, 𝒪_S) ⟶ Γ(U, A₀)` is integral for every
affine open `U`.** -/
theorem isIntegralInDegreeZero_iff_onAffines :
    A.IsIntegralInDegreeZero ↔ integralInDegreeZeroCondition.OnAffines A :=
  Iff.rfl

/-- **`A` is generated over `A₀` by a finite type `A₁` if and only if, for every affine open
`U`, `Γ(U, A)` is generated over `Γ(U, A₀)` by the finite `Γ(U, A₀)`-module `Γ(U, A₁)`.** -/
theorem isFinitelyGeneratedInDegreeOne_iff_onAffines :
    A.IsFinitelyGeneratedInDegreeOne ↔ finitelyGeneratedInDegreeOneCondition.OnAffines A :=
  Iff.rfl

/-- **`A₊` is locally nilpotent modulo a finite type part if and only if, for every affine open
`U`, `Γ(U, A₊)` is nil modulo the ideal generated by a finitely generated `Γ(U, A₀)`-submodule
of `Γ(U, A₊)`.** -/
theorem hasNilpotentPositiveQuotient_iff_onAffines :
    A.HasNilpotentPositiveQuotient ↔ nilpotentPositiveQuotientCondition.OnAffines A :=
  Iff.rfl

/-- **Finite type over `𝒪_S`, read on a neighbourhood of every point, is finite type over every
affine open.** -/
theorem isFiniteType_iff_onAffines :
    Stacks.AlgebraicGeometry.RelativeProjFiniteType.IsFiniteType A ↔
      finiteTypeCondition.OnAffines A :=
  (finiteTypeCondition.onAffines_iff_local A).symm

end SheafGradedAlgebra

end Stacks.AlgebraicGeometry.RelativeProjBridge

end
