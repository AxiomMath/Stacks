module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.CoherentFinitePresentation
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GlobalTypesOfModules
public import StacksFrontier.AlgebraicGeometry.AmpleLocalGeneration.FromExtension
public import StacksFrontier.AlgebraicGeometry.AmplePullbackPart1.TensorPowerTensor
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTwistTensorPow
public import StacksFrontier.AlgebraicGeometry.Variety.EulerChar.ProjectiveTwist
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Twisting a sheaf on `ℙⁿ_R` is tensoring by a tensor power of the hyperplane sheaf

`AlgebraicGeometry.projectiveTwist n ℱ d` is the twist `ℱ(d)` of a module sheaf on
`ℙⁿ_R = AlgebraicGeometry.projectiveSpaceOverRing n R`: the tensor product of `ℱ` with the
pullback along `ℙⁿ_R ⟶ ℙⁿ_ℤ` of the degree-`d` twisting sheaf of the integral model. It is
isomorphic to `ℱ ⊗ 𝒪(1)^{⊗ d}`, with `𝒪(1)` the hyperplane sheaf
`Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf` and the power taken in
`Stacks.Ample.tensorPowModule`, the integer tensor powers of [Stacks, Tag 01CU]. Consequently the
twists of a finite-type quasi-coherent sheaf on `ℙⁿ_R` are generated by global sections for all
`d ≫ 0`.

## Main definitions

* `Stacks.ProjectiveSpace.projectiveTwistIsoTensorPowModule`: `ℱ(d) ≅ ℱ ⊗ 𝒪(1)^{⊗ d}` on
  `ℙⁿ_R`, for every integer `d`.
* `Stacks.ProjectiveSpace.projectiveTwistAddIso`: `(ℱ(a))(b) ≅ ℱ(a + b)`, in every pair of
  integer degrees.

## Main results

* `Stacks.ProjectiveSpace.projectiveTwist_eq_tensorModules`: the twist `ℱ(d)` is the tensor
  product of `ℱ` with the pulled-back integral twist.
* `Stacks.ProjectiveSpace.exists_isGeneratedByGlobalSections_projectiveTwist`: for `d ≫ 0` the
  twist `ℱ(d)` of a quasi-coherent sheaf of finite type on `ℙⁿ_R` is generated by global
  sections.
* `Stacks.ProjectiveSpace.exists_isGeneratedByGlobalSections_projectiveTwist_of_isCoherent`: the
  same for `ℱ` coherent.

## References

* [Stacks Project, Tag 01CU](https://stacks.math.columbia.edu/tag/01CU)
* [Stacks Project, Tag 01MU](https://stacks.math.columbia.edu/tag/01MU)
* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
* [Stacks Project, Tag 03DE](https://stacks.math.columbia.edu/tag/03DE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open AlgebraicGeometry
open Stacks.Ample Stacks.AmpleProjectiveImmersion Stacks.RelativeVeryAmple
open Stacks.AlgebraicGeometry.ProjTwistTensorPow

universe u

namespace Stacks.ProjectiveSpace

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

variable {R : Type u} [CommRing R] (n : ℕ)

/-! ### The dictionary -/

/-- The twist `ℱ(d)` on `ℙⁿ_R` is, by definition, the tensor product of `ℱ` with the pullback
of the degree-`d` twisting sheaf of the integral model. -/
theorem projectiveTwist_eq_tensorModules (F : (projectiveSpaceOverRing n (.of R)).Modules)
    (d : ℤ) :
    projectiveTwist n F d =
      tensorModules (projectiveSpaceOverRing n (.of R)) F (twistOver n (Spec (.of R)) d) :=
  rfl

/-- The twist `ℱ(d)` on `ℙⁿ_R` is isomorphic to the tensor product of `ℱ` with the `d`-th
integer tensor power ([Stacks, Tag 01CU]) of the hyperplane sheaf `𝒪(1)`, for every integer
`d`. -/
def projectiveTwistIsoTensorPowModule
    (F : (projectiveSpaceOverRing n (.of R)).Modules) (d : ℤ) :
    projectiveTwist n F d ≅
      (F ⊗ tensorPowModule (projectiveSpaceOverRing n (.of R))
        (projectiveSpaceTwistingSheaf n (Spec (.of R))) d) :=
  (Stacks.AmplePullbackPart1.tensorIsoTensorModules (projectiveSpaceOverRing n (.of R)) F
      (tensorPowModule (projectiveSpaceOverRing n (.of R))
        (projectiveSpaceTwistingSheaf n (Spec (.of R))) d) ≪≫
    tensorModulesMapIso (projectiveSpaceOverRing n (.of R)) (Iso.refl F)
      (tensorPowModuleProjectiveTwistIso n (Spec (.of R)) d)).symm

/-- Twisting a sheaf on `ℙⁿ_R` by `a` and then by `b` is isomorphic to twisting it by `a + b`,
for all integers `a` and `b`. -/
def projectiveTwistAddIso (F : (projectiveSpaceOverRing n (.of R)).Modules) (a b : ℤ) :
    projectiveTwist n (projectiveTwist n F a) b ≅ projectiveTwist n F (a + b) :=
  (Stacks.AmplePullbackPart1.tensorIsoTensorModules (projectiveSpaceOverRing n (.of R))
        (projectiveTwist n F a) (twistOver n (Spec (.of R)) b)).symm ≪≫
    ((Stacks.AmplePullbackPart1.tensorIsoTensorModules (projectiveSpaceOverRing n (.of R)) F
        (twistOver n (Spec (.of R)) a)).symm ⊗ᵢ
      Iso.refl (twistOver n (Spec (.of R)) b)) ≪≫
    α_ F (twistOver n (Spec (.of R)) a) (twistOver n (Spec (.of R)) b) ≪≫
    whiskerLeftIso F
      (Stacks.AmplePullbackPart1.tensorIsoTensorModules (projectiveSpaceOverRing n (.of R))
          (twistOver n (Spec (.of R)) a) (twistOver n (Spec (.of R)) b) ≪≫
        twistOverMulIso n (Spec (.of R)) a b) ≪≫
    Stacks.AmplePullbackPart1.tensorIsoTensorModules (projectiveSpaceOverRing n (.of R)) F
      (twistOver n (Spec (.of R)) (a + b))

/-! ### Global generation of the twists -/

/-- For `ℱ` a quasi-coherent sheaf of finite type on `ℙⁿ_R`, the twist `ℱ(d)` is generated by
global sections for all `d ≫ 0`. -/
@[ega "III 5.2.4" "special case", sga "6 VI 6.1" "for n large"]
theorem exists_isGeneratedByGlobalSections_projectiveTwist
    (F : (projectiveSpaceOverRing n (.of R)).Modules) (hFqc : F.IsQuasicoherent)
    (hFft : SheafOfModules.IsFiniteType.{u, u, u} F) :
    ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d →
      SheafOfModules.IsGeneratedByGlobalSections (projectiveTwist n F d) := by
  obtain ⟨d₀, hd₀⟩ := Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple
    (projectiveSpaceTwistingSheaf n (Spec (.of R)))
    (isAmple_projectiveSpaceTwistingSheaf n (Spec (.of R))) F hFqc hFft
  exact ⟨d₀, fun d hd ↦ (hd₀ d hd).elim fun σ _ ↦
    ⟨SheafOfModules.GeneratingSections.equivOfIso (projectiveTwistIsoTensorPowModule n F d).symm σ⟩⟩

/-- For `ℱ` a coherent sheaf on `ℙⁿ_R`, the twist `ℱ(d)` is generated by global sections for
all `d ≫ 0`. -/
theorem exists_isGeneratedByGlobalSections_projectiveTwist_of_isCoherent
    (F : (projectiveSpaceOverRing n (.of R)).Modules) (hFc : F.IsCoherent) :
    ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d →
      SheafOfModules.IsGeneratedByGlobalSections (projectiveTwist n F d) :=
  let := hFc
  exists_isGeneratedByGlobalSections_projectiveTwist n F
    (isQuasicoherent_of_isCoherent F) (IsCoherent.toIsFiniteType F)

end Stacks.ProjectiveSpace

end
