module

public import StacksFrontier.AlgebraicGeometry.HomogeneousQuotient.Basic
public import StacksFrontier.AlgebraicGeometry.Blowup.ProjBaseChangeGlobal
public import StacksFrontier.AlgebraicGeometry.Blowup.ProjRegrading
public import StacksFrontier.AlgebraicGeometry.Blowup.RelativeProj
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import StacksFrontier.AlgebraicGeometry.RelativeProjFinitePresentation.GradedBaseChange

/-!
# The universal family of projective schemes cut out by `M` forms of degree `m`

Fix integers `n`, `M` and `m`. A closed subscheme of `ℙⁿ` cut out by `M` homogeneous forms of
degree `m` is determined by the coefficients of the forms, and all of them are fibres of one
*universal* family: over the polynomial ring `R = ℤ[a_{j,E}]` in one variable for each form
`j < M` and each monomial `T^E` of degree `m`, the universal forms `f_j = ∑_E a_{j,E} T^E` cut out
`Z = Proj (R[T₀, …, Tₙ] ⧸ (f_1, …, f_M))`, and the fibre of `Z ⟶ Spec R` at the point
`a_{j,E} ↦ λ_{j,E}` of `Spec R` with values in a ring `K` is `Proj (K[T₀, …, Tₙ] ⧸ (s_1, …, s_M))`
for the forms `s_j = ∑_E λ_{j,E} T^E`. This is the parameter space of the proof of
Stacks 0DPA, for quotients of `𝒪` rather than of `𝒪^{⊕r}`, presented by homogeneous ideals.

## Main definitions

* `Stacks.UniversalForms.CoeffRing`: the coefficient ring `ℤ[a_{j,E}]`.
* `Stacks.UniversalForms.form`: the universal forms.
* `Stacks.UniversalForms.ideal`: the homogeneous ideal they generate.
* `Stacks.UniversalForms.specialize`: the point of `Spec R` with values in `K` at which the
  universal forms become prescribed forms over `K`.

## Main results

* `Stacks.UniversalForms.isHomogeneous_form`: the universal forms are homogeneous of degree `m`.
* `Stacks.UniversalForms.map_specialize_form`: at the specializing point they become the
  prescribed forms.

## References

* [Stacks Project, Tag 0DPA](https://stacks.math.columbia.edu/tag/0DPA)
* [Stacks Project, Tag 01N2](https://stacks.math.columbia.edu/tag/01N2)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TensorProduct

universe u

namespace Stacks.UniversalForms

attribute [local instance] MvPolynomial.gradedAlgebra

variable (n M m : ℕ)

/-- The exponents of the monomials of degree `m` in the `n + 1` homogeneous coordinates. -/
abbrev Exponents : Finset (Fin (n + 1) →₀ ℕ) := Finset.finsuppAntidiag Finset.univ m

/-- The indices of the coefficients of `M` forms of degree `m`: a form and a monomial. -/
abbrev CoeffIndex : Type := Fin M × Exponents n m

/-- **The coefficient ring** `ℤ[a_{j,E}]`, in the universe `u`. -/
abbrev CoeffRing : Type u := MvPolynomial (CoeffIndex n M m) (ULift.{u} ℤ)

/-- **The universal form** `f_j = ∑_E a_{j,E} T^E` of degree `m`. -/
def form (j : Fin M) : MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m) :=
  ∑ E : Exponents n m, MvPolynomial.monomial (E : Fin (n + 1) →₀ ℕ) (MvPolynomial.X (j, E))

/-- An exponent in `Stacks.UniversalForms.Exponents` has total degree `m`. -/
theorem degree_of_mem_exponents {E : Fin (n + 1) →₀ ℕ} (hE : E ∈ Exponents n m) :
    E.degree = m := by
  rw [Finsupp.degree_eq_sum]
  exact (Finset.mem_finsuppAntidiag.mp hE).1

/-- The universal forms are homogeneous of degree `m`. -/
theorem isHomogeneous_form (j : Fin M) : (form.{u} n M m j).IsHomogeneous m :=
  MvPolynomial.IsHomogeneous.sum _ _ _ fun E _ =>
    MvPolynomial.isHomogeneous_monomial _ (degree_of_mem_exponents n m E.2)

/-- **The universal homogeneous ideal**, generated by the universal forms. -/
def ideal : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1))
    (CoeffRing.{u} n M m)) :=
  ⟨Ideal.span (Set.range (form.{u} n M m)), Ideal.homogeneous_span _ _ (by
    rintro _ ⟨j, rfl⟩
    exact ⟨m, isHomogeneous_form n M m j⟩)⟩

/-- The universal quotient ring `R[T₀, …, Tₙ] ⧸ (f_1, …, f_M)`. -/
abbrev UnivQuot : Type u :=
  MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m) ⧸ (ideal.{u} n M m).toIdeal

/-- The class of a polynomial in the universal quotient ring. -/
abbrev univMk (p : MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m)) : UnivQuot.{u} n M m :=
  Ideal.Quotient.mk (ideal.{u} n M m).toIdeal p

/-- The grading of the universal quotient `R[T₀, …, Tₙ] ⧸ (f_1, …, f_M)`. -/
abbrev univGrading : ℕ → Submodule (CoeffRing.{u} n M m) (UnivQuot.{u} n M m) :=
  Stacks.RingTheory.HomogeneousQuotient.quotientGrading
    (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (CoeffRing.{u} n M m))
    (ideal n M m)

variable {n M m}
variable (K : Type u) [CommRing K]

/-- **The specializing point.** Given `M` polynomials over `K`, the ring homomorphism
`ℤ[a_{j,E}] → K` sending `a_{j,E}` to the coefficient of `T^E` in the `j`-th polynomial. -/
def specialize (s : Fin M → MvPolynomial (Fin (n + 1)) K) : CoeffRing.{u} n M m →+* K :=
  MvPolynomial.eval₂Hom ((Int.castRingHom K).comp ULift.ringEquiv.toRingHom)
    fun i => (s i.1).coeff (i.2 : Fin (n + 1) →₀ ℕ)

/-- **At the specializing point the universal forms become the prescribed forms**, provided these
are homogeneous of degree `m`: a homogeneous polynomial of degree `m` is the sum of its monomials
of degree `m`. -/
theorem map_specialize_form (s : Fin M → MvPolynomial (Fin (n + 1)) K)
    (hs : ∀ j, (s j).IsHomogeneous m) (j : Fin M) :
    MvPolynomial.map (specialize K s) (form n M m j) = s j := by
  classical
  rw [form, map_sum]
  simp only [MvPolynomial.map_monomial, specialize, MvPolynomial.eval₂Hom_X']
  rw [Finset.sum_coe_sort (Exponents n m) (fun E => MvPolynomial.monomial E ((s j).coeff E))]
  conv_rhs => rw [(s j).as_sum]
  symm
  refine Finset.sum_subset (fun d hd => ?_) (fun d _ hd => ?_)
  · rw [Finset.mem_finsuppAntidiag]
    refine ⟨?_, Finset.subset_univ _⟩
    rw [← Finsupp.degree_eq_sum, Finsupp.degree_eq_weight_one]
    exact hs j (MvPolynomial.mem_support_iff.mp hd)
  · rw [MvPolynomial.notMem_support_iff.mp hd, MvPolynomial.monomial_zero]

/-! ### The fibre of the universal family at a specializing point -/

section Fibre

open Stacks.RingTheory.HomogeneousQuotient

variable (s : Fin M → MvPolynomial (Fin (n + 1)) K) (hs : ∀ j, (s j).IsHomogeneous m)

/-- The homogeneous ideal of `K[T₀, …, Tₙ]` generated by `M` forms of degree `m`. -/
def formsIdeal : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
  ⟨Ideal.span (Set.range s), Ideal.homogeneous_span _ _ (by
    rintro _ ⟨j, rfl⟩
    exact ⟨m, hs j⟩)⟩

include hs in
/-- The ideal generated by the forms over `K` is the image of the universal ideal. -/
theorem map_specialize_ideal :
    (ideal n M m).toIdeal.map (MvPolynomial.map (specialize K s)) =
      (formsIdeal K s hs).toIdeal := by
  change (Ideal.span (Set.range (form n M m))).map _ = Ideal.span (Set.range s)
  rw [Ideal.map_span, ← Set.range_comp]
  congr 1
  ext p
  simp [map_specialize_form K s hs]

end Fibre

/-! ### The base change of the universal quotient -/

section BaseChange

open Stacks.RingTheory.HomogeneousQuotient HomogeneousIdeal

variable (n M m) [Algebra (CoeffRing.{u} n M m) K]

/-- The universal forms base changed to an algebra `K` over the coefficient ring. -/
abbrev baseForms (j : Fin M) : MvPolynomial (Fin (n + 1)) K :=
  MvPolynomial.map (algebraMap (CoeffRing.{u} n M m) K) (form n M m j)

/-- The base changed universal forms are homogeneous of degree `m`. -/
theorem isHomogeneous_baseForms (j : Fin M) : (baseForms n M m K j).IsHomogeneous m :=
  (isHomogeneous_form n M m j).map _

/-- The homogeneous ideal generated by the base changed universal forms. -/
abbrev baseIdeal : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
  formsIdeal K (baseForms n M m K) (isHomogeneous_baseForms n M m K)

/-- The quotient ring `K[T₀, …, Tₙ] ⧸ (f_1, …, f_M)`. -/
abbrev BaseQuot : Type u := MvPolynomial (Fin (n + 1)) K ⧸ (baseIdeal n M m K).toIdeal

/-- The grading of `K[T₀, …, Tₙ] ⧸ (f_1, …, f_M)`. -/
abbrev baseGrading : ℕ → Submodule K (BaseQuot n M m K) :=
  quotientGrading (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (baseIdeal n M m K)

/-- Evaluating the base change of a polynomial at the classes of the variables in
`K ⊗ R[T] ⧸ I` is the class of the polynomial. -/
theorem aeval_map_algebraMap (p : MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m)) :
    MvPolynomial.aeval
      (fun i => (1 : K) ⊗ₜ[CoeffRing.{u} n M m] univMk.{u} n M m (MvPolynomial.X i))
      (MvPolynomial.map (algebraMap (CoeffRing.{u} n M m) K) p) =
      (1 : K) ⊗ₜ[CoeffRing.{u} n M m] univMk.{u} n M m p := by
  let φ₁ : MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m) →ₐ[CoeffRing.{u} n M m]
      K ⊗[CoeffRing.{u} n M m] UnivQuot.{u} n M m :=
    ((MvPolynomial.aeval fun i => (1 : K) ⊗ₜ[CoeffRing.{u} n M m]
        univMk.{u} n M m (MvPolynomial.X i)).restrictScalars (CoeffRing.{u} n M m)).comp
      (MvPolynomial.mapAlgHom (Algebra.ofId (CoeffRing.{u} n M m) K))
  let φ₂ : MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m) →ₐ[CoeffRing.{u} n M m]
      K ⊗[CoeffRing.{u} n M m] UnivQuot.{u} n M m :=
    Algebra.TensorProduct.includeRight.comp
      (Ideal.Quotient.mkₐ (CoeffRing.{u} n M m) (ideal.{u} n M m).toIdeal)
  have h : φ₁ = φ₂ := MvPolynomial.algHom_ext fun i => by
    simp [φ₁, φ₂]
  exact DFunLike.congr_fun h p

/-- The class of a polynomial in `K[T₀, …, Tₙ] ⧸ (f_1, …, f_M)`. -/
abbrev baseMk (p : MvPolynomial (Fin (n + 1)) K) : BaseQuot n M m K :=
  Ideal.Quotient.mk (baseIdeal n M m K).toIdeal p

/-- The base change map `R[T] ⧸ I → K[T] ⧸ IK[T]`, as an `R`-algebra homomorphism. -/
def baseChangeAlgHom : UnivQuot.{u} n M m →ₐ[CoeffRing.{u} n M m] BaseQuot n M m K :=
  Ideal.Quotient.liftₐ (ideal.{u} n M m).toIdeal
    ((Ideal.Quotient.mkₐ (CoeffRing.{u} n M m) (baseIdeal n M m K).toIdeal).comp
      (MvPolynomial.mapAlgHom (Algebra.ofId (CoeffRing.{u} n M m) K))) (by
    intro a ha
    have hle : (ideal.{u} n M m).toIdeal ≤ RingHom.ker
        ((Ideal.Quotient.mkₐ (CoeffRing.{u} n M m) (baseIdeal n M m K).toIdeal).comp
          (MvPolynomial.mapAlgHom (Algebra.ofId (CoeffRing.{u} n M m) K))) := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    exact hle ha)

/-- The base change map sends the class of `p` to the class of the base change of `p`. -/
theorem baseChangeAlgHom_univMk (p : MvPolynomial (Fin (n + 1)) (CoeffRing.{u} n M m)) :
    baseChangeAlgHom n M m K (univMk.{u} n M m p) =
      baseMk n M m K (MvPolynomial.map (algebraMap (CoeffRing.{u} n M m) K) p) := rfl

/-- The base change map is graded. -/
def baseChangeGradedAlgHom : univGrading.{u} n M m →ₐᵍ[CoeffRing.{u} n M m]
    (baseGrading n M m K · |>.restrictScalars (CoeffRing.{u} n M m)) where
  __ := baseChangeAlgHom n M m K
  map_mem {i x} hx := by
    obtain ⟨a, ha, rfl⟩ := (mem_quotientGrading_iff
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (CoeffRing.{u} n M m))
      (ideal.{u} n M m)).1 hx
    exact (mem_quotientGrading_iff (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      (baseIdeal n M m K)).2 ⟨MvPolynomial.map (algebraMap (CoeffRing.{u} n M m) K) a,
        (MvPolynomial.mem_homogeneousSubmodule _ _).2
          (((MvPolynomial.mem_homogeneousSubmodule _ _).1 ha).map _), rfl⟩

/-- The comparison `K ⊗[R] (R[T] ⧸ I) → K[T] ⧸ IK[T]`, a graded `K`-algebra homomorphism. -/
def tensorGradedAlgHom :
    (univGrading.{u} n M m · |>.baseChange K) →ₐᵍ[K] baseGrading n M m K :=
  GradedAlgHom.liftEquiv _ _ (baseChangeGradedAlgHom n M m K)

/-- The inverse comparison `K[T] ⧸ IK[T] → K ⊗[R] (R[T] ⧸ I)`. -/
def tensorInvAlgHom : BaseQuot n M m K →ₐ[K] K ⊗[CoeffRing.{u} n M m] UnivQuot.{u} n M m :=
  Ideal.Quotient.liftₐ (baseIdeal n M m K).toIdeal
    (MvPolynomial.aeval fun i => (1 : K) ⊗ₜ[CoeffRing.{u} n M m]
      univMk.{u} n M m (MvPolynomial.X i)) (by
    intro a ha
    have hle : (baseIdeal n M m K).toIdeal ≤ RingHom.ker (MvPolynomial.aeval fun i =>
        (1 : K) ⊗ₜ[CoeffRing.{u} n M m] univMk.{u} n M m (MvPolynomial.X i)) := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker]
      change MvPolynomial.aeval _ (MvPolynomial.map _ (form n M m j)) = 0
      rw [aeval_map_algebraMap, show univMk.{u} n M m (form n M m j) = 0 from
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩), TensorProduct.tmul_zero]
    exact hle ha)

/-- The inverse comparison sends the class of `p` to the evaluation of `p` at the elements
`1 ⊗ T_i` of `K ⊗[R] (R[T] ⧸ I)`. -/
theorem tensorInvAlgHom_baseMk (p : MvPolynomial (Fin (n + 1)) K) :
    tensorInvAlgHom n M m K (baseMk n M m K p) = MvPolynomial.aeval (fun i =>
      (1 : K) ⊗ₜ[CoeffRing.{u} n M m] univMk.{u} n M m (MvPolynomial.X i)) p := rfl

/-- The comparison sends `k ⊗ y` to `k` times the base change of `y`. -/
theorem tensorGradedAlgHom_tmul (k : K) (y : UnivQuot.{u} n M m) :
    tensorGradedAlgHom n M m K (k ⊗ₜ[CoeffRing.{u} n M m] y) =
      k • baseChangeAlgHom n M m K y := rfl

/-- The comparison sends `1 ⊗ T_i` to the class of `T_i`. -/
private theorem tensorGradedAlgHom_one_tmul_X (i : Fin (n + 1)) :
    tensorGradedAlgHom n M m K ((1 : K) ⊗ₜ[CoeffRing.{u} n M m]
      univMk.{u} n M m (MvPolynomial.X i)) = baseMk n M m K (MvPolynomial.X i) := by
  rw [tensorGradedAlgHom_tmul, one_smul, baseChangeAlgHom_univMk, MvPolynomial.map_X]

/-- The inverse comparison sends the class of `T_i` to `1 ⊗ T_i`. -/
private theorem tensorInvAlgHom_baseMk_X (i : Fin (n + 1)) :
    tensorInvAlgHom n M m K (baseMk n M m K (MvPolynomial.X i)) =
      (1 : K) ⊗ₜ[CoeffRing.{u} n M m] univMk.{u} n M m (MvPolynomial.X i) := by
  rw [tensorInvAlgHom_baseMk, MvPolynomial.aeval_X]

/-- The inverse comparison is a left inverse of the comparison. -/
theorem tensorInvAlgHom_comp :
    (tensorInvAlgHom n M m K).comp (tensorGradedAlgHom n M m K).toAlgHom = AlgHom.id K _ := by
  apply Algebra.TensorProduct.ext
  · ext
  · apply Ideal.Quotient.algHom_ext
    apply MvPolynomial.algHom_ext
    intro i
    exact (congrArg _ (tensorGradedAlgHom_one_tmul_X n M m K i)).trans
      (tensorInvAlgHom_baseMk_X n M m K i)

/-- The inverse comparison is a right inverse of the comparison. -/
theorem tensorGradedAlgHom_comp :
    (tensorGradedAlgHom n M m K).toAlgHom.comp (tensorInvAlgHom n M m K) = AlgHom.id K _ := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro i
  exact (congrArg _ (tensorInvAlgHom_baseMk_X n M m K i)).trans
    (tensorGradedAlgHom_one_tmul_X n M m K i)

/-- The comparison `K ⊗[R] (R[T] ⧸ I) ≅ K[T] ⧸ IK[T]` as a ring isomorphism. -/
def tensorRingEquiv : K ⊗[CoeffRing.{u} n M m] UnivQuot.{u} n M m ≃+* BaseQuot n M m K :=
  RingEquiv.ofRingHom (tensorGradedAlgHom n M m K).toAlgHom.toRingHom
    (tensorInvAlgHom n M m K).toRingHom
    (RingHom.ext fun x => DFunLike.congr_fun (tensorGradedAlgHom_comp n M m K) x)
    (RingHom.ext fun x => DFunLike.congr_fun (tensorInvAlgHom_comp n M m K) x)

/-- The comparison, as a homomorphism of graded rings. -/
abbrev tensorGradedRingHom :
    Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K →+*ᵍ baseGrading n M m K :=
  (tensorGradedAlgHom n M m K).toGradedRingHom

/-- The inverse comparison `K[T] ⧸ IK[T] → K ⊗[R] (R[T] ⧸ I)`, as a homomorphism of graded
rings. -/
def tensorInvGradedRingHom :
    baseGrading n M m K →+*ᵍ Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K where
  __ := (tensorInvAlgHom n M m K).toRingHom
  map_mem {i b} hb := by
    exact Stacks.GradedTransport.symm_mem
      (Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K)
      (baseGrading n M m K) (tensorRingEquiv n M m K)
      (fun _ _ hx => (tensorGradedAlgHom n M m K).map_mem hx) hb

/-- The inverse comparison is a left inverse of the comparison, as graded ring homomorphisms. -/
theorem tensorInvGradedRingHom_comp :
    (tensorInvGradedRingHom n M m K).comp (tensorGradedRingHom n M m K) =
      GradedRingHom.id _ :=
  GradedRingHom.ext fun x => DFunLike.congr_fun (tensorInvAlgHom_comp n M m K) x

/-- The inverse comparison is a right inverse of the comparison, as graded ring homomorphisms. -/
theorem tensorGradedRingHom_comp :
    (tensorGradedRingHom n M m K).comp (tensorInvGradedRingHom n M m K) =
      GradedRingHom.id _ :=
  GradedRingHom.ext fun x => DFunLike.congr_fun (tensorGradedAlgHom_comp n M m K) x

/-- The base change map `R[T] ⧸ I → K[T] ⧸ IK[T]` as a homomorphism of graded rings. -/
abbrev baseChangeGradedRingHom : univGrading.{u} n M m →+*ᵍ baseGrading n M m K :=
  (tensorGradedRingHom n M m K).comp (Stacks.ProjBaseChange.includeRight _ K)

/-- The irrelevant ideal of `K[T] ⧸ IK[T]` is contained in the image of the irrelevant ideal of
`K ⊗[R] (R[T] ⧸ I)` under the comparison. -/
theorem irrelevant_le_map_tensorGradedRingHom :
    HomogeneousIdeal.irrelevant (baseGrading n M m K) ≤
      (HomogeneousIdeal.irrelevant
        (Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K)).map
          (tensorGradedRingHom n M m K) :=
  Stacks.GradedRegrading.irrelevant_le_map_of_comp_eq_id (tensorGradedRingHom_comp n M m K)

/-- The irrelevant ideal of `K ⊗[R] (R[T] ⧸ I)` is contained in the image of the irrelevant ideal
of `K[T] ⧸ IK[T]` under the inverse comparison. -/
theorem irrelevant_le_map_tensorInvGradedRingHom :
    HomogeneousIdeal.irrelevant
        (Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K) ≤
      (HomogeneousIdeal.irrelevant (baseGrading n M m K)).map
          (tensorInvGradedRingHom n M m K) :=
  Stacks.GradedRegrading.irrelevant_le_map_of_comp_eq_id (tensorInvGradedRingHom_comp n M m K)

/-- The irrelevant ideal of `K[T] ⧸ IK[T]` is contained in the image of the irrelevant ideal of
`R[T] ⧸ I` under the base change map. -/
theorem irrelevant_le_map_baseChangeGradedRingHom :
    HomogeneousIdeal.irrelevant (baseGrading n M m K) ≤
      (HomogeneousIdeal.irrelevant (univGrading.{u} n M m)).map
        (baseChangeGradedRingHom n M m K) :=
  HomogeneousIdeal.irrelevant_le_map_comp (Stacks.ProjBaseChange.irrelevant_le_map _ K)
    (irrelevant_le_map_tensorGradedRingHom n M m K)

/-- The structure morphism of the universal family `Proj (R[T] ⧸ I) ⟶ Spec R`. -/
abbrev univToBase : Proj (univGrading.{u} n M m) ⟶ Spec (.of (CoeffRing.{u} n M m)) :=
  Proj.toSpecZero (univGrading.{u} n M m) ≫
    Spec.map (CommRingCat.ofHom (algebraMap (CoeffRing.{u} n M m) ↥(univGrading.{u} n M m 0)))

/-- The structure morphism `Proj (K[T] ⧸ IK[T]) ⟶ Spec K`. -/
abbrev baseToSpec : Proj (baseGrading n M m K) ⟶ Spec (.of K) :=
  Proj.toSpecZero (baseGrading n M m K) ≫
    Spec.map (CommRingCat.ofHom (algebraMap K ↥(baseGrading n M m K 0)))

/-- The comparison `Proj (K[T] ⧸ IK[T]) ≅ Proj (K ⊗[R] (R[T] ⧸ I))` lies over `Spec K`. -/
theorem proj_map_tensorGradedRingHom_comp :
    Proj.map (tensorGradedRingHom n M m K) (irrelevant_le_map_tensorGradedRingHom n M m K) ≫
        Proj.toSpecZero (Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K
            ↥(Stacks.ProjBaseChange.grading (univGrading.{u} n M m) K 0))) =
      baseToSpec n M m K := by
  rw [Proj.map_toSpecZero_assoc, ← Spec.map_comp]
  congr 2
  ext k
  exact (tensorGradedAlgHom n M m K).toAlgHom.commutes k

/-- **The fibre of the universal family.** The square formed by
`Proj (K[T] ⧸ IK[T]) ⟶ Proj (R[T] ⧸ I)`, the two structure morphisms and `Spec K ⟶ Spec R` is
cartesian (Stacks 01N2, `Stacks.ProjBaseChange.isPullback_map_of_baseChange`). -/
theorem isPullback_univToBase :
    IsPullback (Proj.map (baseChangeGradedRingHom n M m K)
        (irrelevant_le_map_baseChangeGradedRingHom n M m K))
      (baseToSpec n M m K) (univToBase.{u} n M m)
      (Spec.map (CommRingCat.ofHom (algebraMap (CoeffRing.{u} n M m) K))) := by
  have h := Stacks.ProjBaseChange.isPullback_map_of_baseChange (univGrading.{u} n M m) K
    (f := baseChangeGradedRingHom n M m K) (irrelevant_le_map_baseChangeGradedRingHom n M m K)
    (e := tensorGradedRingHom n M m K) (irrelevant_le_map_tensorGradedRingHom n M m K)
    (e' := tensorInvGradedRingHom n M m K) (irrelevant_le_map_tensorInvGradedRingHom n M m K)
    (tensorInvGradedRingHom_comp n M m K) (tensorGradedRingHom_comp n M m K) rfl
  rwa [proj_map_tensorGradedRingHom_comp] at h

end BaseChange

end Stacks.UniversalForms
