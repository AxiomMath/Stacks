module

public import StacksFrontier.AlgebraicGeometry.MayerVietorisHgroup.TwoAffineCoverVanishing
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Cover
public import StacksFrontier.AlgebraicGeometry.ProjAmple.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.Cohomology.CoherentSerreVanishing
public import StacksFrontier.AlgebraicGeometry.ProjEulerSequence.ZeroTwist
public import StacksFrontier.AlgebraicGeometry.TopDegreeBaseChange.OneDimensionalFibres
public import StacksFrontier.AlgebraicGeometry.TopDegreeBaseChange.SituationProjective

/-!
# `H¹` of a globally generated module on the projective line

Let `R` be any commutative ring and `ℙ¹_R = Proj R[T₀, T₁]`. Then

`H¹(ℙ¹_R, ℱ) = 0`

for every quasi-coherent `𝒪`-module `ℱ` generated by global sections.

## Main results

All in the namespace `Stacks.ProjectiveSpace.Cohomology`.

* `sup_basicOpen_X_eq_top`, `isAffineOpen_basicOpen_X_inf`: the two standard charts `D₊(T₀)`,
  `D₊(T₁)` cover `ℙ¹_R`, and their intersection `D₊(T₀T₁)` is affine.
* `isZero_hgroup_line_of_two_le`: `Hᵖ(ℙ¹_R, ℱ) = 0` for `p ≥ 2` and `ℱ` quasi-coherent — the
  cohomological dimension of `ℙ¹_R` is at most one.
* `isZero_hgroup_line_unit_one`: `H¹(ℙ¹_R, 𝒪) = 0`, in the Čech `Hgroup` spelling.
* `isZero_cohomology_one_of_generatingSections_line`: `H¹(ℙ¹_R, ℱ) = 0` for `ℱ` quasi-coherent
  and generated by global sections.

## References

* [Stacks Project, Tag 01XB](https://stacks.math.columbia.edu/tag/01XB)
* [Stacks Project, Tag 01FF](https://stacks.math.columbia.edu/tag/01FF)
* [Stacks Project, Tag 0E7H](https://stacks.math.columbia.edu/tag/0E7H)
* [Stacks Project, Tag 0EXD](https://stacks.math.columbia.edu/tag/0EXD)
-/
@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.Cohomology Stacks.Cohomology.AmbientMayerVietoris
open Stacks.AlgebraicGeometry.ProjPolyChart

universe u

namespace Stacks.ProjectiveSpace.Cohomology

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance 100000] HasDerivedCategory.standard

variable (R : Type u) [CommRing R]

/-- The two standard charts cover the projective line: `ℙ¹_R = D₊(T₀) ∪ D₊(T₁)`. -/
public theorem sup_basicOpen_X_eq_top :
    AlgebraicGeometry.Proj.basicOpen (polyGrading R 1) (MvPolynomial.X 0) ⊔
        AlgebraicGeometry.Proj.basicOpen (polyGrading R 1) (MvPolynomial.X 1) = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← iSup_basicOpen_X_eq_top R 1]
  exact iSup_le fun i => by fin_cases i <;> [exact le_sup_left; exact le_sup_right]

/-- The intersection `D₊(T₀) ∩ D₊(T₁)` of the two standard charts of the projective line is
affine. -/
public theorem isAffineOpen_basicOpen_X_inf :
    IsAffineOpen (AlgebraicGeometry.Proj.basicOpen (polyGrading R 1) (MvPolynomial.X 0) ⊓
      AlgebraicGeometry.Proj.basicOpen (polyGrading R 1) (MvPolynomial.X 1)) := by
  have hmul : AlgebraicGeometry.Proj.basicOpen (polyGrading R 1)
        (MvPolynomial.X 0 * MvPolynomial.X 1)
      = AlgebraicGeometry.Proj.basicOpen (polyGrading R 1) (MvPolynomial.X 0) ⊓
        AlgebraicGeometry.Proj.basicOpen (polyGrading R 1) (MvPolynomial.X 1) :=
    AlgebraicGeometry.Proj.basicOpen_mul _ _ _
  exact hmul ▸ AlgebraicGeometry.Proj.isAffineOpen_basicOpen _ _
    (SetLike.mul_mem_graded (X_mem_one R 1 0) (X_mem_one R 1 1)) (by omega)

/-- The projective line has cohomological dimension at most one: `Hᵖ(ℙ¹_R, ℱ) = 0` for every
quasi-coherent `ℱ` and every `p ≥ 2`, over an arbitrary commutative ring `R`. -/
public theorem isZero_hgroup_line_of_two_le
    (F : (AlgebraicGeometry.Proj (polyGrading R 1)).Modules) [F.IsQuasicoherent]
    (p : ℕ) (hp : 2 ≤ p) :
    IsZero (Hgroup (AlgebraicGeometry.Proj (polyGrading R 1)).ringCatSheaf ⊤ p F) :=
  isZero_hgroup_of_two_affine_cover_of_two_le _ _ _
    (AlgebraicGeometry.Proj.isAffineOpen_basicOpen _ _ (X_mem_one R 1 0) Nat.one_pos)
    (AlgebraicGeometry.Proj.isAffineOpen_basicOpen _ _ (X_mem_one R 1 1) Nat.one_pos)
    (isAffineOpen_basicOpen_X_inf R) (sup_basicOpen_X_eq_top R) F p hp

/-- `H¹(ℙ¹_R, 𝒪) = 0` over an arbitrary commutative ring `R`, in the Čech `Hgroup` spelling. -/
public theorem isZero_hgroup_line_unit_one :
    IsZero (Hgroup (AlgebraicGeometry.Proj (polyGrading R 1)).ringCatSheaf ⊤ 1
      (SheafOfModules.unit (AlgebraicGeometry.Proj (polyGrading R 1)).ringCatSheaf)) :=
  (Stacks.ProjectiveSpace.SerreVanishing.isZero_Hgroup_twistingSheaf_of_pos R 1 0 le_rfl 1
    Nat.one_pos).of_iso
      ((Hfunctor (Stacks.ProjectiveSpace.Cohomology.projRingSheaf R 1) ⊤ 1).mapIso
        (Stacks.AlgebraicGeometry.ProjEulerSequence.twistingSheafZeroIsoUnit
          (polyGrading R 1)).symm)

/-- `H¹(ℙ¹_R, ℱ) = 0` for every quasi-coherent module `ℱ` generated by global sections, over an
arbitrary commutative ring `R`. -/
public theorem isZero_cohomology_one_of_generatingSections_line
    (F : (AlgebraicGeometry.Proj (polyGrading R 1)).Modules) [F.IsQuasicoherent]
    (σ : SheafOfModules.GeneratingSections F) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections
      (AlgebraicGeometry.Proj (polyGrading R 1))).rightDerivedPlus 1).obj F) := by
  have : CompactSpace (AlgebraicGeometry.Proj (polyGrading R 1)) := compactSpace_proj R 1
  have : QuasiSeparatedSpace (AlgebraicGeometry.Proj (polyGrading R 1)) :=
    Stacks.ProjAmple.quasiSeparatedSpace_proj_polyGrading R 1
  exact AlgebraicGeometry.TopDegreeBaseChange.isZero_rightDerivedPlus_one_of_generatingSections
    F σ ((AffineBase.isZero_rightDerivedPlus_moduleGlobalSections_iff_isZero_Hgroup _ _ 1).2
      (isZero_hgroup_line_unit_one R)) fun G _ =>
    (AffineBase.isZero_rightDerivedPlus_moduleGlobalSections_iff_isZero_Hgroup _ G 2).2
      (isZero_hgroup_line_of_two_le R G 2 le_rfl)

end Stacks.ProjectiveSpace.Cohomology

end
