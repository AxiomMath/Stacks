/-!
# `𝒪 ⊕ 𝒪(-1) ⊕ ⋯ ⊕ 𝒪(-n)` generates `D_QCoh(𝒪_X)` for `X = P^n_A`

The twists `𝒪_X(-m)`, `m ≥ 0`, lie in the subcategory generated by
`E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)`
(`StacksFrontier.AlgebraicGeometry.ProjectiveSpace.ExampleGenerator.Koszul`), and they detect the zero
object of `D_QCoh(𝒪_X)` ([Stacks, Tag 0BQR]). This file combines the two: `E` is a generator of
`D_QCoh(𝒪_X)`.

## Main results

* `Stacks.AlgebraicGeometry.ExampleGenerator.isWeakTriangulatedGenerator_twistSumDerivedQCoh` —
  **[Stacks, Tag 0A9V]**: for `X = P^n_A`, `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)` is a generator of
  `D_QCoh(𝒪_X)`.
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for `R`-modules.
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] ModuleCat.hasDerivedCategory
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open AlgebraicGeometry AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTrivialization
open Stacks.AlgebraicGeometry.ProjPolyChart
open Stacks.AlgebraicGeometry.ProjKoszulComplex
open Stacks.TriangulatedGenerators
open StacksDraft.StupidTruncation
open HomologicalComplex

namespace Stacks.AlgebraicGeometry.ExampleGenerator

universe u

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
attribute [local instance_reducible] ProjectiveSpectrum.top

variable (A : Type u) [CommRing A] (n : ℕ)

/-! ### From the twists to `E` -/

/-- **What the twists detect, `E` detects.** Let `P` be a property of objects of `D(𝒪_X)` such
that an object satisfying `P` and receiving only zero maps from the shifts of all the twists
`𝒪_X(-m)`, `m ≥ 0`, is zero. Then an object satisfying `P` and receiving only zero maps from the
shifts of `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)` is zero.

By [Stacks, Tag 09SK] the vanishing of `Hom(E, K⟦i⟧)` for all `i` propagates to every object of
`⟨E⟩`, and `⟨E⟩` contains all the twists by
`Stacks.AlgebraicGeometry.ExampleGenerator.twist_neg_mem_gen`. -/
theorem isZero_of_forall_hom_twistSum_eq_zero
    (P : ObjectProperty (DerivedCategory (Mods A n)))
    (hP : ∀ K : DerivedCategory (Mods A n), P K →
      (∀ (m : ℕ) (i : ℤ) (f : (shiftFunctor (DerivedCategory (Mods A n)) i).obj
        (twist A n (-(m : ℤ))) ⟶ K), f = 0) → IsZero K)
    (K : DerivedCategory (Mods A n)) (hK : P K)
    (hvan : ∀ (j : ℤ) (g : twistSum A n ⟶ (shiftFunctor (DerivedCategory (Mods A n)) j).obj K),
      g = 0) :
    IsZero K :=
  hP K hK fun m i f =>
    (hom_vanishing_iff_gen (twistSum A n) K).1 hvan _
      (shift_mem_gen_of_mem i (twist_neg_mem_gen A n m)) f

/-! ### `D_QCoh(𝒪_X)` and the vanishing criterion of Tag 0BQR -/

/-- `D_QCoh(𝒪_X)`: the objects of the derived category of `𝒪_X`-modules whose cohomology sheaves
are quasi-coherent. -/
abbrev derivedQCoh : ObjectProperty (DerivedCategory (Mods A n)) :=
  DerivedCategoryB.derivedCategoryB
    (SheafOfModules.isQuasicoherent (projRingSheaf (polyGrading A n)))

/-- `D_QCoh(𝒪_X)` is a triangulated subcategory of `D(𝒪_X)` ([Stacks, Tag 06UQ]). -/
instance isTriangulated_derivedQCoh : (derivedQCoh A n).IsTriangulated :=
  Stacks.AlgebraicGeometry.QuasicoherentDerived.isTriangulated_derivedQuasicoherent
    (AlgebraicGeometry.Proj (polyGrading A n))

/-- **[Stacks, Tag 0BQR] for `𝒪_X(1)` on `X = P^n_A`, in the shape the proof of Tag 0A9V uses.**
An object `K` of `D_QCoh(𝒪_X)` receiving only zero maps from the shifts of the twists
`𝒪_X(-m)`, `m ≥ 0`, is zero. -/
theorem isZero_of_derivedQCoh_of_forall_hom_twist_eq_zero (K : DerivedCategory (Mods A n))
    (hK : derivedQCoh A n K)
    (hvan : ∀ (m : ℕ) (i : ℤ) (f : (shiftFunctor (DerivedCategory (Mods A n)) i).obj
      (twist A n (-(m : ℤ))) ⟶ K), f = 0) :
    IsZero K := by
  refine Stacks.ProjectiveSpace.isZero_of_forall_hom_twistingSheaf_neg_eq_zero A n K hK
    fun p j φ => ?_
  let e := ((DerivedCategory.singleFunctors (Mods A n)).shiftIso (-j) j 0 (by simp)).app
    (twistingSheaf (polyGrading A n) (-(p : ℤ)))
  exact ((Iso.eq_inv_comp e).2 (hvan p (-j) (e.hom ≫ φ))).trans comp_zero

/-- **The object `E` lies in `D_QCoh(𝒪_X)`**: each twist `𝒪_X(-i)` is quasi-coherent, and
`D_QCoh(𝒪_X)` is closed under finite direct sums. -/
theorem twistSum_mem_derivedQCoh : derivedQCoh A n (twistSum A n) := by
  have : (derivedQCoh A n).IsClosedUnderIsomorphisms :=
    ⟨fun e h => DerivedCategoryB.derivedCategoryB_isClosedUnderIsomorphisms _
      (Stacks.AlgebraicGeometry.QuasicoherentWeakSerre.isQuasicoherent_isWeakSerre
        (AlgebraicGeometry.Proj (polyGrading A n))) |>.of_iso e h⟩
  refine (derivedQCoh A n).prop_of_iso
    (biproduct.isoProduct fun i : Fin (n + 1) => twist A n (-(i : ℤ))).symm
    ((derivedQCoh A n).prop_limit _ fun i => ?_)
  exact Stacks.Duality.DerivedPushforward.derivedCategoryB_singleFunctor_obj
    (X := AlgebraicGeometry.Proj (polyGrading A n)) _
    (Stacks.AlgebraicGeometry.TwistChartLocality.isQuasicoherent_twistingSheaf _ _)

/-- **[Stacks, Tag 0A9V] in `D(𝒪_X)`.** For `X = P^n_A` an object of `D_QCoh(𝒪_X)` receiving only
zero maps from the shifts of `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)` is zero.

The vanishing of `Hom(E, K⟦i⟧)` for all `i` propagates to every object of `⟨E⟩`
([Stacks, Tag 09SK]), `⟨E⟩` contains every twist `𝒪_X(-m)`, `m ≥ 0`
(`Stacks.AlgebraicGeometry.ExampleGenerator.twist_neg_mem_gen`, from [Stacks, Tag 0BQS]), and the
twists detect the zero object of `D_QCoh(𝒪_X)`
(`Stacks.AlgebraicGeometry.ExampleGenerator.isZero_of_derivedQCoh_of_forall_hom_twist_eq_zero`,
[Stacks, Tag 0BQR] for the ample sheaf `𝒪_X(1)`). -/
theorem isZero_of_quasiCoherentHomology_of_forall_hom_twistSum_eq_zero
    (K : DerivedCategory (Mods A n)) (hK : derivedQCoh A n K)
    (hvan : ∀ (j : ℤ) (g : twistSum A n ⟶ (shiftFunctor (DerivedCategory (Mods A n)) j).obj K),
      g = 0) :
    IsZero K :=
  isZero_of_forall_hom_twistSum_eq_zero A n _
    (isZero_of_derivedQCoh_of_forall_hom_twist_eq_zero A n) K hK hvan

/-- The object `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)` of `D_QCoh(𝒪_X)`. -/
def twistSumDerivedQCoh : (derivedQCoh A n).FullSubcategory :=
  ⟨twistSum A n, twistSum_mem_derivedQCoh A n⟩

/-- Let `A` be a ring and `X = P^n_A`. Then `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)` is a generator
of `D_QCoh(𝒪_X)` in the sense of [Stacks, Tag 09SJ]: every object of `D_QCoh(𝒪_X)` receiving
only zero maps from the shifts of `E` is zero. -/
@[stacks 0A9V]
theorem isWeakTriangulatedGenerator_twistSumDerivedQCoh :
    (ObjectProperty.singleton (twistSumDerivedQCoh A n)).IsWeakTriangulatedGenerator := by
  rw [ObjectProperty.isWeakTriangulatedGenerator_iff]
  intro K hK
  by_contra! hc
  refine hK ?_
  have hz : IsZero K.obj := isZero_of_quasiCoherentHomology_of_forall_hom_twistSum_eq_zero A n
    K.obj K.property fun j g => by
      let e := ((derivedQCoh A n).ι.commShiftIso j).app K
      have h1 := congrArg (derivedQCoh A n).ι.map (hc _ ((ObjectProperty.singleton_iff _ _).2 rfl)
        j ((derivedQCoh A n).fullyFaithfulι.preimage (g ≫ e.inv)))
      rw [Functor.FullyFaithful.map_preimage, Functor.map_zero] at h1
      exact ((Iso.comp_inv_eq e).1 h1).trans zero_comp
  rw [IsZero.iff_id_eq_zero]
  refine (derivedQCoh A n).fullyFaithfulι.map_injective ?_
  rw [CategoryTheory.Functor.map_id, Functor.map_zero]
  exact hz.eq_of_src _ _

end Stacks.AlgebraicGeometry.ExampleGenerator

end
