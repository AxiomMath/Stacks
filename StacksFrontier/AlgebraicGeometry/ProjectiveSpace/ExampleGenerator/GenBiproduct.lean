module

public import StacksFrontier.CategoryTheory.Triangulated.IteratedCone
public import StacksFrontier.CategoryTheory.Triangulated.OperationsOnFullSubcategories

/-!
# Finite direct sums of objects of `⟨E⟩`

The subcategory `⟨E⟩` of [Stacks, Tag 09SI] generated by an object `E` of a triangulated
category is closed under finite direct sums. This is immediate from the two closure properties
already recorded for it in `StacksFrontier/CategoryTheory/Triangulated/IteratedCone.lean` — it is
closed under extensions and it contains the zero object — because a binary biproduct sits in the
split distinguished triangle `X ⟶ X ⊞ Y ⟶ Y ⟶ X⟦1⟧`.

The form actually needed downstream is the one for a *constant* family indexed by an arbitrary
finite type: the terms of the Koszul complex on projective space are direct sums of copies of a
single twisting sheaf, indexed by the subsets of the coordinates of a given cardinality.

## Main results

* `Stacks.TriangulatedGenerators.biprod_mem_gen` — `⟨E⟩` is closed under binary biproducts.
* `Stacks.TriangulatedGenerators.finConst_mem_gen` — a direct sum of `k` copies of an object of
  `⟨E⟩` lies in `⟨E⟩`.
* `Stacks.TriangulatedGenerators.constBiproduct_mem_gen` — the same for a constant family
  indexed by any finite type.

## References

* [Stacks Project, Tag 09SI](https://stacks.math.columbia.edu/tag/09SI)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

namespace Stacks.TriangulatedGenerators

universe v u

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasShift D ℤ] [HasZeroObject D]
  [∀ k : ℤ, (shiftFunctor D k).Additive] [Pretriangulated D] [IsTriangulated D]
  [HasFiniteBiproducts D]

/-- **`⟨E⟩` is closed under binary direct sums.** A binary biproduct is the middle term of the
split distinguished triangle `X ⟶ X ⊞ Y ⟶ Y ⟶ X⟦1⟧`, and `⟨E⟩` is closed under extensions. -/
theorem biprod_mem_gen {E X Y : D} (hX : X ∈ gen E) (hY : Y ∈ gen E) :
    (X ⊞ Y) ∈ gen E :=
  mem_gen₂_of_distTriang (binaryBiproductTriangle X Y)
    (binaryBiproductTriangle_distinguished X Y) hX hY

/-- A zero object lies in `⟨E⟩`. -/
theorem isZero_mem_gen {E X : D} (hX : IsZero X) : X ∈ gen E :=
  (genProp_iff E X).1 (ObjectProperty.prop_of_isZero (genProp E) hX)

omit [IsTriangulated D] in
/-- `E` itself lies in `⟨E⟩`, being its own shift by zero. -/
theorem self_mem_gen (E : D) : E ∈ gen E :=
  mem_gen_of_iso ((shiftFunctorZero D ℤ).app E) (shift_mem_gen E 0)

omit [IsTriangulated D] in
/-- **`⟨E⟩` is closed under retracts**, in particular under passing to a direct summand. -/
theorem mem_gen_of_retract {E X Y : D} (r : Retract X Y) (hY : Y ∈ gen E) : X ∈ gen E :=
  (genProp_iff E X).1 (ObjectProperty.prop_of_retract (genProp E) r ((genProp_iff E Y).2 hY))

omit [IsTriangulated D] in
/-- **A direct summand of `E` lies in `⟨E⟩`.** The `i`-th factor of a finite direct sum is a
retract of the sum, via the inclusion and the projection. -/
theorem biproduct_summand_mem_gen {J : Type} [Finite J] (f : J → D) (i : J) :
    f i ∈ gen (⨁ f) :=
  mem_gen_of_retract ⟨biproduct.ι f i, biproduct.π f i, by simp⟩ (self_mem_gen _)

/-- **A direct sum of `k` copies of an object of `⟨E⟩` lies in `⟨E⟩`.** Induction on `k`: the
empty sum is a zero object, and the sum over `Fin (k + 1)` splits, along
`finSumFinEquiv`, as the binary biproduct of the sum over `Fin k` and the sum over `Fin 1`. -/
theorem finConst_mem_gen {E Y : D} (hY : Y ∈ gen E) (k : ℕ) :
    (⨁ fun _ : Fin k => Y) ∈ gen E := by
  induction k with
  | zero =>
    refine isZero_mem_gen ?_
    rw [IsZero.iff_id_eq_zero]
    exact biproduct.hom_ext' _ _ fun i => i.elim0
  | succ k ih =>
    have e : (⨁ fun _ : Fin (k + 1) => Y) ≅
        (⨁ fun _ : Fin k => Y) ⊞ (⨁ fun _ : Fin 1 => Y) := by
      refine biproduct.whiskerEquiv (f := fun _ : Fin (k + 1) => Y)
        (g := Sum.elim (fun _ : Fin k => Y) (fun _ : Fin 1 => Y))
        (finSumFinEquiv (m := k) (n := 1)).symm ?_ ≪≫
          biproductSumIso k 1 (fun _ : Fin k => Y) (fun _ : Fin 1 => Y)
      intro j
      rcases h : (finSumFinEquiv (m := k) (n := 1)).symm j with i | i <;> exact Iso.refl Y
    exact mem_gen_of_iso e.symm
      (biprod_mem_gen ih (mem_gen_of_iso (biproductUniqueIso _).symm hY))

/-- **A direct sum of copies of an object of `⟨E⟩`, indexed by any finite type, lies in `⟨E⟩`.**
Reindexing along `Fintype.equivFin` reduces this to `finConst_mem_gen`; the family being
constant, the reindexing isomorphism is the identity in each component. -/
theorem constBiproduct_mem_gen {E Y : D} (hY : Y ∈ gen E) (J : Type) [Finite J] :
    (⨁ fun _ : J => Y) ∈ gen E := by
  let _ := Fintype.ofFinite J
  exact mem_gen_of_iso
    (biproduct.whiskerEquiv (f := fun _ : J => Y) (g := fun _ : Fin (Fintype.card J) => Y)
      (Fintype.equivFin J) fun _ => Iso.refl Y).symm
    (finConst_mem_gen hY (Fintype.card J))

end Stacks.TriangulatedGenerators

end
