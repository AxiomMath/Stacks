/-!
# An example generator: the twists `𝒪, 𝒪(-1), …, 𝒪(-n)` on `P^n_A`

Let `A` be a ring and let `X = P^n_A = Proj A[T₀, …, Tₙ]`. With

`E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)`

placed in degree zero of the derived category of `𝒪_X`-modules, this file proves that **every**
twist `𝒪_X(-m)`, `m ≥ 0`, lies in the subcategory `⟨E⟩` of [Stacks, Tag 09SI] generated by `E`.
Together with [Stacks, Tag 0BQR] for `𝒪_X(1)` this gives [Stacks, Tag 0A9V],
`Stacks.AlgebraicGeometry.ExampleGenerator.isWeakTriangulatedGenerator_twistSumDerivedQCoh` of
`StacksFrontier/AlgebraicGeometry/ProjectiveSpace/ExampleGenerator/KoszulQuasiCoherent.lean`.

The argument is the source's. For `m ≤ n` the twist is a direct summand of `E`. For larger `m`
one runs the Koszul complex of [Stacks, Tag 0BQS] at `a = -m`,

`0 ⟶ 𝒪_X(-m) ⟶ 𝒪_X(-m+1)^{⊕ binom(n+1,1)} ⟶ ⋯ ⟶ 𝒪_X(-m+n+1) ⟶ 0`,

which is exact and concentrated in degrees `0, …, n+1`. Its stupid filtration therefore exhibits
the degree-zero term `𝒪_X(-m)` as an iterated extension of shifts of the terms in degrees
`1, …, n+1`, each of which is a finite direct sum of copies of a twist `𝒪_X(-m+p)` with
`0 ≤ m - p < m`; those lie in `⟨E⟩` by induction on `m`.

## Main definitions

* `Stacks.AlgebraicGeometry.ExampleGenerator.twist` — `𝒪_X(d)` in degree zero of `D(𝒪_X)`.
* `Stacks.AlgebraicGeometry.ExampleGenerator.twistSum` — the object `E` displayed above.

## Main results

* `Stacks.AlgebraicGeometry.ExampleGenerator.twist_mem_gen_of_shift_mem_gen` — the one-step
  Koszul descent: if `𝒪_X(a+1), …, 𝒪_X(a+n+1)` lie in `⟨E⟩` then so does `𝒪_X(a)`. This is the
  step of [Stacks, Tag 0A9V] that consumes [Stacks, Tag 0BQS].
* `Stacks.AlgebraicGeometry.ExampleGenerator.twist_neg_mem_gen` — `𝒪_X(-m) ∈ ⟨E⟩` for every
  `m : ℕ`.
* `Stacks.AlgebraicGeometry.ExampleGenerator.isWeakTriangulatedGenerator_twistSum_of_twists` —
  `E` generates `D(𝒪_X)` as soon as the twists detect its zero objects.

## Implementation notes

`X = Proj A[T₀, …, Tₙ]` is a scheme and `Stacks.AlgebraicGeometry.ProjTrivialization.projRingSheaf`
is its sheaf of rings (`ringCatSheaf_eq`), so the category
`SheafOfModules (projRingSheaf (polyGrading A n))` in which the Koszul complex of
`StacksFrontier/AlgebraicGeometry/ProjKoszulComplex/` lives *is* the category `X.Modules` of
`𝒪_X`-modules, and its twisting sheaves are the Serre twists of Tag 01MN. No base change to
`AlgebraicGeometry.projectiveSpaceOverRing` is needed, and the relative twists
`Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver` — which are pullbacks of the twists of
the *integral* model — do not appear.

The derived category is the locally small model of
`StacksFrontier/Homology/DerivedCategory/LocallySmall.lean`, whose global instance
`SheafOfModules.hasDerivedCategory` applies to `projRingSheaf` with no further hypothesis;
`CategoryTheory.HasDerivedCategory.standard` is not used.

## References

* [Stacks Project, Tag 0A9V](https://stacks.math.columbia.edu/tag/0A9V)
* [Stacks Project, Tag 0BQS](https://stacks.math.columbia.edu/tag/0BQS)
* [Stacks Project, Tag 09SI](https://stacks.math.columbia.edu/tag/09SI)
* [Stacks Project, Tag 09SJ](https://stacks.math.columbia.edu/tag/09SJ)
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for sheaves of modules on a small site.
attribute [local instance] SheafOfModules.hasDerivedCategory

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open AlgebraicGeometry AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTrivialization
open Stacks.AlgebraicGeometry.ProjPolyChart
open Stacks.AlgebraicGeometry.ProjKoszulComplex
open Stacks.TriangulatedGenerators
open StacksDraft.StupidTruncation
open HomologicalComplex

namespace Stacks.AlgebraicGeometry.ExampleGenerator

universe u

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
attribute [local instance_reducible] ProjectiveSpectrum.top

variable (A : Type u) [CommRing A] (n : ℕ)

/-- The category of `𝒪_X`-modules for `X = P^n_A = Proj A[T₀, …, Tₙ]`. By
`Stacks.AlgebraicGeometry.ProjTrivialization.ringCatSheaf_eq` this is `X.Modules`. -/
abbrev Mods := SheafOfModules.{u} (projRingSheaf (polyGrading A n))

/-- The category of `𝒪_X`-modules has finite biproducts, since it has finite products. -/
local instance hasFiniteBiproducts_mods : HasFiniteBiproducts (Mods A n) :=
  HasFiniteBiproducts.of_hasFiniteProducts

/-- `𝒪_X(d)`, read in degree zero of the derived category of `𝒪_X`-modules. -/
def twist (d : ℤ) : DerivedCategory (Mods A n) :=
  (DerivedCategory.singleFunctor (Mods A n) 0).obj (twistingSheaf (polyGrading A n) d)

/-- **The object `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)`** of [Stacks, Tag 0A9V], in degree zero of
the derived category of `𝒪_X`-modules. -/
def twistSum : DerivedCategory (Mods A n) := ⨁ fun i : Fin (n + 1) => twist A n (-(i : ℤ))

/-- Each of the `n + 1` displayed twists is a direct summand of `E`, hence lies in `⟨E⟩`. -/
@[stacks 0A9V "each of the twists O, O(-1), …, O(-n) lies in the subcategory generated by E"]
theorem twist_mem_gen_of_le (i : Fin (n + 1)) :
    twist A n (-(i : ℤ)) ∈ gen (twistSum A n) :=
  biproduct_summand_mem_gen (fun i : Fin (n + 1) => twist A n (-(i : ℤ))) i

/-! ### The Koszul complex is concentrated in degrees `0, …, n+1` -/

/-- Outside the range `0 ≤ j ≤ n + 1` the index type of the `j`-th Koszul term is empty: a
subset of the `n + 1` coordinates has between `0` and `n + 1` elements. -/
theorem isEmpty_koszulIndex (j : ℤ) (hj : j < 0 ∨ (n : ℤ) + 1 < j) :
    IsEmpty (koszulIndex (n + 1) j) :=
  ⟨fun s => by
    have h1 := s.2
    have h2 : s.1.card ≤ n + 1 := by simpa using Finset.card_le_univ s.1
    omega⟩

/-- Outside the range `0 ≤ j ≤ n + 1` the `j`-th Koszul term is a direct sum over an empty index
type, hence zero. -/
theorem isZero_koszulComplex_X (a j : ℤ) (hj : j < 0 ∨ (n : ℤ) + 1 < j) :
    IsZero ((koszulComplex A n a).X j) := by
  have hempty := isEmpty_koszulIndex n j hj
  have h : IsZero (⨁ koszulFamily A n a j) := by
    rw [IsZero.iff_id_eq_zero]
    exact biproduct.hom_ext' _ _ fun i => hempty.elim i
  exact h

/-- The Koszul complex is strictly concentrated in degrees `≥ 0`. -/
instance isStrictlyGE_koszulComplex (a : ℤ) : (koszulComplex A n a).IsStrictlyGE 0 := by
  rw [CochainComplex.isStrictlyGE_iff]
  exact fun i hi => isZero_koszulComplex_X A n a i (Or.inl hi)

/-- The Koszul complex is strictly concentrated in degrees `≤ n + 1`. -/
instance isStrictlyLE_koszulComplex (a : ℤ) :
    (koszulComplex A n a).IsStrictlyLE ((n : ℤ) + 1) := by
  rw [CochainComplex.isStrictlyLE_iff]
  exact fun i hi => isZero_koszulComplex_X A n a i (Or.inr hi)

/-! ### The two ends of the stupid filtration -/

/-- The degree-zero index type of the Koszul complex has exactly one element, the empty subset. -/
instance uniqueKoszulIndexZero : Unique (koszulIndex (n + 1) (0 : ℤ)) where
  default := ⟨∅, by simp⟩
  uniq := fun s => Subtype.ext (Finset.card_eq_zero.1 (by have := s.2; omega))

/-- **The bottom of the stupid filtration of the Koszul complex is `𝒪_X(a)`.** The complex is
concentrated in degrees `≥ 0`, so `σ^{≤0}` of it is its degree-zero term placed in degree zero,
and that term is the direct sum of copies of `𝒪_X(a)` indexed by the empty subset alone. -/
def stupidFiltrationZeroIso (a : ℤ) :
    stupidFiltration (koszulComplex A n a) 0 ≅ twist A n a :=
  (DerivedCategory.Q.mapIso
      (asIso (stupidTruncLEι (koszulComplex A n a) 0))).symm ≪≫
    DerivedCategory.Q.mapIso ((single (Mods A n) (.up ℤ) 0).mapIso
      (biproductUniqueIso (koszulFamily A n a 0) ≪≫
        eqToIso (congrArg (twistingSheaf (polyGrading A n)) (add_zero a))))

/-- **The top of the stupid filtration of the Koszul complex is zero.** The complex is
concentrated in degrees `≤ n+1`, so `σ^{≤n+1}` of it is the whole complex, which is acyclic by
[Stacks, Tag 0BQS] and therefore a zero object of the derived category. -/
theorem isZero_stupidFiltration_top (a : ℤ) :
    IsZero (stupidFiltration (koszulComplex A n a) (n + 1)) := by
  have hiso : (koszulComplex A n a) ≅
      (koszulComplex A n a).stupidTrunc (ComplexShape.embeddingUpIntLE ((n : ℤ) + 1)) :=
    asIso ((koszulComplex A n a).πStupidTrunc
      (ComplexShape.embeddingUpIntLE ((n : ℤ) + 1)))
  have hac : IsZero (DerivedCategory.Q.obj (koszulComplex A n a)) :=
    DerivedCategory.isZero_Q_obj_of_acyclic _ (acyclic_koszulComplex A n a)
  have h : IsZero (DerivedCategory.Q.obj
      ((koszulComplex A n a).stupidTrunc
        (ComplexShape.embeddingUpIntLE (((n + 1 : ℕ) : ℤ))))) := by
    have he : (((n + 1 : ℕ) : ℤ)) = (n : ℤ) + 1 := by push_cast; ring
    rw [he]
    exact hac.of_iso (DerivedCategory.Q.mapIso hiso.symm)
  exact h

/-! ### The Koszul descent -/

/-- **One step of the Koszul descent of [Stacks, Tag 0A9V].** If the `n + 1` twists
`𝒪_X(a+1), …, 𝒪_X(a+n+1)` lie in `⟨E⟩`, then so does `𝒪_X(a)`.

This is the step of the source's proof that consumes [Stacks, Tag 0BQS]: the Koszul complex at
`a` is exact and concentrated in degrees `0, …, n+1`, its degree-`p` term is a finite direct sum
of copies of `𝒪_X(a+p)`, and the triangles of its stupid filtration exhibit the degree-zero
term `𝒪_X(a)` as an iterated extension of shifts of the terms in degrees `1, …, n+1`. -/
theorem twist_mem_gen_of_shift_mem_gen (E : DerivedCategory (Mods A n)) (a : ℤ)
    (h : ∀ p : ℕ, 0 < p → p ≤ n + 1 → twist A n (a + (p : ℤ)) ∈ gen E) :
    twist A n a ∈ gen E := by
  refine mem_gen_of_iso (stupidFiltrationZeroIso A n a)
    (mem_gen_of_isZero_of_stupidFiltration E
      (U := stupidFiltration (koszulComplex A n a))
      (B := fun p : ℕ => ((DerivedCategory.singleFunctor (Mods A n) 0).obj
        ((koszulComplex A n a).X (p : ℤ)))⟦(1 - (p : ℤ) : ℤ)⟧)
      (n + 1) (fun p hp _ => exists_distTriang_stupidFiltration _ p hp)
      (isZero_stupidFiltration_top A n a) ?_)
  intro p hp hpM
  refine shift_mem_gen_of_mem _ ?_
  -- The degree-`p` term is a finite direct sum of copies of `𝒪_X(a+p)`; the single functor is
  -- additive, so its image is the direct sum of copies of `twist A n (a+p)`.
  refine mem_gen_of_iso
    (Functor.mapBiproduct (DerivedCategory.singleFunctor (Mods A n) 0)
      (koszulFamily A n a (p : ℤ))).symm ?_
  exact constBiproduct_mem_gen (h p hp hpM) (koszulIndex (n + 1) (p : ℤ))

/-! ### The generation step of Tag 0A9V -/

/-- **Every twist `𝒪_X(-m)`, `m ≥ 0`, lies in `⟨E⟩`.** For `X = P^n_A` and
`E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)`, every twist `𝒪_X(-m)` with `m ≥ 0` lies in the subcategory
`⟨E⟩` of [Stacks, Tag 09SI] generated by `E`.

Strong induction on `m`. For `m ≤ n` the twist is a direct summand of `E`. For `m ≥ n + 1` the
one-step descent `twist_mem_gen_of_shift_mem_gen` at `a = -m` reduces the claim to the twists
`𝒪_X(-m+p)` for `1 ≤ p ≤ n + 1`, and `-m + p = -(m - p)` with `m - p < m`. -/
@[stacks 0A9V "the subcategory generated by E contains every twist O(-m), m ≥ 0"]
theorem twist_neg_mem_gen (m : ℕ) : twist A n (-(m : ℤ)) ∈ gen (twistSum A n) := by
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    by_cases hm : m ≤ n
    · have := twist_mem_gen_of_le A n ⟨m, by omega⟩
      simpa using this
    · refine twist_mem_gen_of_shift_mem_gen A n _ _ fun p hp hpM => ?_
      have hlt : m - p < m := by omega
      have key : twist A n (-((m - p : ℕ) : ℤ)) ∈ gen (twistSum A n) := ih (m - p) hlt
      have heq : -((m - p : ℕ) : ℤ) = -(m : ℤ) + (p : ℤ) := by
        rw [Nat.cast_sub (by omega : p ≤ m)]
        ring
      exact mem_gen_of_iso (eqToIso (congrArg (twist A n) heq)) key

/-- **`E` generates `D(𝒪_X)` as soon as the twists detect its zero objects.** If every object
of `D(𝒪_X)` receiving only zero maps from the shifts of the twists `𝒪_X(-m)`, `m ≥ 0`, is zero,
then `E = 𝒪_X ⊕ 𝒪_X(-1) ⊕ ⋯ ⊕ 𝒪_X(-n)` is a generator of `D(𝒪_X)` in the sense of
[Stacks, Tag 09SJ]. -/
theorem isWeakTriangulatedGenerator_twistSum_of_twists
    (hvanish : ∀ K : DerivedCategory (Mods A n),
      (∀ (m : ℕ) (i : ℤ) (f : (shiftFunctor (DerivedCategory (Mods A n)) i).obj
        (twist A n (-(m : ℤ))) ⟶ K), f = 0) → IsZero K) :
    (ObjectProperty.singleton (twistSum A n)).IsWeakTriangulatedGenerator := by
  rw [ObjectProperty.isWeakTriangulatedGenerator_iff]
  intro K hK
  by_contra hc
  simp only [not_exists, not_and, not_not] at hc
  refine hK (hvanish K fun m i f => ?_)
  have hsing : ObjectProperty.singleton (twistSum A n) (twistSum A n) :=
    (ObjectProperty.singleton_iff _ _).2 rfl
  exact (hom_vanishing_iff_gen (twistSum A n) K).1 (fun j g => hc _ hsing j g) _
    (shift_mem_gen_of_mem i (twist_neg_mem_gen A n m)) f

end Stacks.AlgebraicGeometry.ExampleGenerator

end
