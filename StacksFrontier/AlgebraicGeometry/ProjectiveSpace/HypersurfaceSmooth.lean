module

public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.RingTheory.MvPolynomial.EulerIdentity
public import StacksFrontier.Algebra.MvPolynomial.PDerivAeval
public import StacksFrontier.AlgebraicGeometry.ProjIdealSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveChart.HypersurfaceFinitePresentation
public import StacksFrontier.RingTheory.Smooth.AffineHypersurface

/-!
# The Jacobian criterion for a hypersurface in projective space

Let `k` be a field, let `F ∈ k[T₀, …, Tₙ]` be homogeneous of degree `d` and let
`i : Z ⟶ ℙⁿ_k` be a closed immersion whose ideal sheaf is the zero scheme of the section of
`𝒪(d)` attached to `F`. If `F` and its partial derivatives `∂F/∂T₀, …, ∂F/∂Tₙ` have no common zero
in `ℙⁿ_k` — in the algebraic form used here: for every `j` some power of `Tⱼ` lies in the ideal
they generate — then `Z` is smooth over `k`.

On the standard chart `D₊(Tⱼ)` the subscheme is the affine hypersurface `k[Y₁, …, Yₙ] ⧸ (f)`,
with `f = F(Tⱼ = 1)` the dehomogenization. Dehomogenization commutes with the partial derivatives
in the remaining variables, `∂f/∂Y_a = (∂F/∂T_{j.succAbove a})(Tⱼ = 1)`, and Euler's identity
`∑ᵢ Tᵢ ∂F/∂Tᵢ = d F` dehomogenizes to

`(∂F/∂Tⱼ)(Tⱼ = 1) = d f - ∑_a Y_a ∂f/∂Y_a`,

so the dehomogenization of every element of `(F, ∂F/∂T₀, …, ∂F/∂Tₙ)` lies in
`(f, ∂f/∂Y₁, …, ∂f/∂Yₙ)`. The dehomogenization of `Tⱼ ^ N` is `1`, so the latter ideal is the unit
ideal, and the affine Jacobian criterion `Stacks.AffineHypersurface.smooth_quotient_of_span_eq_top`
applies on each chart. No hypothesis on the characteristic of `k` is needed: Euler's identity is
used only in the direction above, which holds for every `d`.

## Main results

* `Stacks.ProjectiveChart.pderiv_dehomCoeff`: dehomogenization at `Tⱼ` commutes with the partial
  derivatives in the remaining variables.
* `Stacks.ProjectiveChart.dehomCoeff_pderiv_self`: the dehomogenized Euler identity.
* `Stacks.ProjectiveChart.span_dehomCoeff_eq_top`: the affine Jacobian ideal of a chart is the
  unit ideal.
* `Stacks.ProjectiveChart.ker_app_basicOpen_X_of_ker_eq_zeroScheme`: the kernel of `i` over
  `D₊(Tⱼ)` is generated by the dehomogenization of `F`, for `i` with ideal sheaf the zero scheme
  of `F`.
* `Stacks.ProjectiveChart.smooth_of_ker_eq_zeroScheme`: **the projective Jacobian criterion** —
  the structure morphism `Z ⟶ Spec k` is smooth.

## References

* [Stacks Project, Tag 00TE](https://stacks.math.columbia.edu/tag/00TE)
* [Stacks Project, Tag 01V5](https://stacks.math.columbia.edu/tag/01V5)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial
open AlgebraicGeometry.ProjectiveSpectrum.Proj (twistingSheafModule degreeSection)
open Stacks.AlgebraicGeometry.ProjPolyChart (polyGrading projToSpecCoeff)

namespace Stacks.ProjectiveChart

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

section Dehomogenization

variable (R : Type u) [CommRing R] {n : ℕ}

/-- Dehomogenization at `Tⱼ` sends `Tⱼ` to `1`. -/
theorem dehomCoeff_X_self (j : Fin (n + 1)) : dehomCoeff R j (X j) = 1 := by
  simp [dehomCoeff_eq_aeval]

/-- Dehomogenization at `Tⱼ` sends `T_{j.succAbove a}` to `Y_a`. -/
theorem dehomCoeff_X_succAbove (j : Fin (n + 1)) (a : Fin n) :
    dehomCoeff R j (X (j.succAbove a)) = X a := by
  simp [dehomCoeff_eq_aeval]

/-- **Dehomogenization commutes with partial derivatives.** The derivative of `F(Tⱼ = 1)` in
`Y_a` is the dehomogenization of `∂F/∂T_{j.succAbove a}`. -/
theorem pderiv_dehomCoeff (j : Fin (n + 1)) (a : Fin n) (F : MvPolynomial (Fin (n + 1)) R) :
    pderiv a (dehomCoeff R j F) = dehomCoeff R j (pderiv (j.succAbove a) F) := by
  classical
  rw [dehomCoeff_eq_aeval, pderiv_aeval, Fin.sum_univ_succAbove _ j]
  simp only [finSuccEquiv'_at, Option.elim_none, pderiv_one, mul_zero, zero_add,
    finSuccEquiv'_succAbove, Option.elim_some, pderiv_X]
  rw [Finset.sum_eq_single a (fun b _ hb => by simp [hb]) (by simp)]
  simp [dehomCoeff_eq_aeval]

/-- **The dehomogenized Euler identity.** For `F` homogeneous of degree `d`,
`(∂F/∂Tⱼ)(Tⱼ = 1) = d f - ∑_a Y_a ∂f/∂Y_a` with `f = F(Tⱼ = 1)`. -/
theorem dehomCoeff_pderiv_self (j : Fin (n + 1)) {d : ℕ} {F : MvPolynomial (Fin (n + 1)) R}
    (hF : F.IsHomogeneous d) :
    dehomCoeff R j (pderiv j F) =
      d • dehomCoeff R j F - ∑ a : Fin n, X a * pderiv a (dehomCoeff R j F) := by
  have h := congrArg (dehomCoeff R j) hF.sum_X_mul_pderiv
  rw [map_sum, map_nsmul, Fin.sum_univ_succAbove _ j] at h
  simp only [map_mul, dehomCoeff_X_self, one_mul, dehomCoeff_X_succAbove,
    ← pderiv_dehomCoeff] at h
  exact eq_sub_of_add_eq h

/-- **Dehomogenization carries the projective Jacobian ideal into the affine one.** For `F`
homogeneous, the dehomogenization at `Tⱼ` of every element of `(F, ∂F/∂T₀, …, ∂F/∂Tₙ)` lies in
`(f, ∂f/∂Y₁, …, ∂f/∂Yₙ)`, where `f = F(Tⱼ = 1)`. -/
theorem dehomCoeff_mem_span_pderiv (j : Fin (n + 1)) {d : ℕ}
    {F : MvPolynomial (Fin (n + 1)) R} (hF : F.IsHomogeneous d) {G : MvPolynomial (Fin (n + 1)) R}
    (hG : G ∈ Ideal.span (insert F (Set.range fun l => pderiv l F))) :
    dehomCoeff R j G ∈
      Ideal.span (insert (dehomCoeff R j F) (Set.range fun a => pderiv a (dehomCoeff R j F))) := by
  set J := Ideal.span (insert (dehomCoeff R j F) (Set.range fun a => pderiv a (dehomCoeff R j F)))
  have hf : dehomCoeff R j F ∈ J := Ideal.subset_span (Set.mem_insert _ _)
  have hd : ∀ a : Fin n, pderiv a (dehomCoeff R j F) ∈ J := fun a =>
    Ideal.subset_span (Set.mem_insert_of_mem _ ⟨a, rfl⟩)
  have hle : Ideal.map (dehomCoeff R j) (Ideal.span (insert F (Set.range fun l => pderiv l F)))
      ≤ J := by
    rw [Ideal.map_span]
    refine Ideal.span_le.2 ?_
    rintro _ ⟨G, hG | ⟨l, rfl⟩, rfl⟩
    · rw [hG]
      exact hf
    · change dehomCoeff R j (pderiv l F) ∈ (J : Set (MvPolynomial (Fin n) R))
      obtain hl | ⟨a, rfl⟩ := Fin.eq_self_or_eq_succAbove j l
      · rw [hl, SetLike.mem_coe, dehomCoeff_pderiv_self R j hF]
        exact J.sub_mem (nsmul_mem hf d) (J.sum_mem fun a _ => J.mul_mem_left _ (hd a))
      · rw [SetLike.mem_coe, ← pderiv_dehomCoeff]
        exact hd a
  exact hle (Ideal.mem_map_of_mem _ hG)

/-- **The affine Jacobian ideal of a chart is the unit ideal.** If `F` is homogeneous and some
power of `Tⱼ` lies in `(F, ∂F/∂T₀, …, ∂F/∂Tₙ)`, then `f = F(Tⱼ = 1)` and its partial derivatives
generate the unit ideal of `R[Y₁, …, Yₙ]`. -/
theorem span_dehomCoeff_eq_top (j : Fin (n + 1)) {d : ℕ} {F : MvPolynomial (Fin (n + 1)) R}
    (hF : F.IsHomogeneous d)
    (hjac : ∃ N : ℕ, X j ^ N ∈ Ideal.span (insert F (Set.range fun l => pderiv l F))) :
    Ideal.span (insert (dehomCoeff R j F) (Set.range fun a => pderiv a (dehomCoeff R j F))) =
      ⊤ := by
  obtain ⟨N, hN⟩ := hjac
  have h := dehomCoeff_mem_span_pderiv R j hF hN
  rwa [map_pow, dehomCoeff_X_self, one_pow, ← Ideal.eq_top_iff_one] at h

end Dehomogenization

section Kernel

variable (R : Type u) [CommRing R] {n d : ℕ}

/-- **The affine equation of a hypersurface on a chart, from its ideal sheaf.** If the ideal
sheaf of `i : Z ⟶ ℙⁿ_R` is the zero scheme of the section of `𝒪(d)` attached to a homogeneous
`F` of degree `d`, then the kernel of `i` over `D₊(Tⱼ)` is generated by the image of the
dehomogenization `F(Tⱼ = 1)` under the chart identification. -/
theorem ker_app_basicOpen_X_of_ker_eq_zeroScheme (F : polyGrading R n d) {Z : Scheme.{u}}
    (i : Z ⟶ Proj (polyGrading R n)) [IsClosedImmersion i]
    (hker : i.ker = zeroScheme (Proj (polyGrading R n)) (twistingSheafModule (polyGrading R n)
      (d : ℤ)) (degreeSection (polyGrading R n) d F)) (j : Fin (n + 1)) :
    RingHom.ker (i.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
      (X j))).hom = Ideal.span {sectionsChartEquiv R j (dehomCoeff R j F)} := by
  have hF : (F : MvPolynomial (Fin (n + 1)) R) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R (d • 1) := by
    rw [smul_eq_mul, mul_one]
    exact F.2
  rw [sectionsChartEquiv_dehomCoeff R j d _ hF]
  have h := ProjectiveSpectrum.Proj.zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq
    (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) (X_mem_degree_one R j) Nat.one_pos d
    (by simp) F hF
  rw [← hker, Scheme.Hom.ker_apply] at h
  exact h

end Kernel

/-- **The Jacobian criterion for a hypersurface in projective space.** Let `k` be a field, `F` a
homogeneous polynomial of degree `d` in `k[T₀, …, Tₙ]`, and `i : Z ⟶ ℙⁿ_k` a closed immersion
whose ideal sheaf is the zero scheme of the section of `𝒪(d)` attached to `F`. If for every `j`
some power of `Tⱼ` lies in the ideal generated by `F` and its partial derivatives — that is, `F`,
`∂F/∂T₀, …, ∂F/∂Tₙ` have no common zero in `ℙⁿ_k` — then `Z ⟶ Spec k` is smooth. -/
theorem smooth_of_ker_eq_zeroScheme {k : Type u} [Field k] {n d : ℕ} (F : polyGrading k n d)
    {Z : Scheme.{u}} (i : Z ⟶ Proj (polyGrading k n)) [IsClosedImmersion i]
    (hker : i.ker = zeroScheme (Proj (polyGrading k n)) (twistingSheafModule (polyGrading k n)
      (d : ℤ)) (degreeSection (polyGrading k n) d F))
    (hjac : ∀ j : Fin (n + 1), ∃ N : ℕ, X j ^ N ∈
      Ideal.span (insert (F : MvPolynomial (Fin (n + 1)) k)
        (Set.range fun l => pderiv l (F : MvPolynomial (Fin (n + 1)) k)))) :
    Smooth (i ≫ projToSpecCoeff k n) := by
  have hFh : (F : MvPolynomial (Fin (n + 1)) k).IsHomogeneous d :=
    (mem_homogeneousSubmodule _ _).1 F.2
  refine HasRingHomProperty.of_iSup_eq_top (P := @Smooth) (Q := RingHom.Smooth)
    (fun l : Fin (n + 1) => ⟨subschemeChart i l, isAffineOpen_subschemeChart i l⟩)
    (iSup_subschemeChart_eq_top i) fun l => ?_
  set ψ := ((i ≫ projToSpecCoeff k n).appLE ⊤ (subschemeChart i l) le_top).hom
  set e : k ≃+* Γ(Spec (CommRingCat.of k), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv
  have hcomp : ψ.comp e.toRingHom = (chartPresentation i l).comp MvPolynomial.C := by
    ext r
    exact (chartPresentation_C i l r).symm
  have hk := ker_chartPresentation_of_ker_app i l _
    (ker_app_basicOpen_X_of_ker_eq_zeroScheme k F i hker l)
  have h1 : RingHom.Smooth ((chartPresentation i l).comp MvPolynomial.C) := by
    let : Algebra k Γ(Z, subschemeChart i l) :=
      ((chartPresentation i l).comp MvPolynomial.C).toAlgebra
    let eq : (MvPolynomial (Fin n) k ⧸ Ideal.span {dehomCoeff k l F}) ≃ₐ[k]
        Γ(Z, subschemeChart i l) :=
      { (Ideal.quotEquivOfEq hk.symm).trans
          (RingHom.quotientKerEquivOfSurjective (chartPresentation_surjective i l)) with
        commutes' := fun _ => rfl }
    have := Stacks.AffineHypersurface.smooth_quotient_of_span_eq_top
      (span_dehomCoeff_eq_top k l hFh (hjac l))
    exact Algebra.Smooth.of_equiv eq
  have h2 := RingHom.Smooth.respectsIso.2 (ψ.comp e.toRingHom) e.symm (hcomp ▸ h1)
  rwa [RingHom.comp_assoc, show e.toRingHom.comp e.symm.toRingHom = RingHom.id _ from
    RingHom.ext e.apply_symm_apply, RingHom.comp_id] at h2

end Stacks.ProjectiveChart

end
