module

public import StacksFrontier.AlgebraicGeometry.ProjChartKernel.Localization

/-!
# The ideal sheaf of a hypersurface in `Proj`

Let `S = ⨁_{n ≥ 0} 𝒮 n` be a Noetherian graded ring generated in degree one over `𝒮 0` and let
`i : Z ⟶ Proj 𝒮` be a closed immersion whose homogeneous ideal `I(Z)` is the principal ideal of a
homogeneous element `F` of degree `d`. This file identifies the ideal sheaf of `Z` with the ideal
sheaf of the zero scheme of the canonical section of `𝒪(d)` attached to `F`: a closed subscheme
cut out by one homogeneous equation is the zero locus of that equation read as a twisted section.

The argument is the one `Stacks.ProjectiveSpace.ker_projMap_eq_zeroScheme` runs in degree one.
Over the standard open `D₊(f)` of a degree-one element the chart comparison of Tag 0801
(`AlgebraicGeometry.ProjectiveSpectrum.Proj.mem_ker_app_basicOpen_iff`) writes every element of
`Ker(i.app D₊(f))` as `c / f ^ m` with `c ∈ I(Z) = (F)` homogeneous; padding the numerator by
`f ^ d` makes its degree `m + d`, so the homogeneous cofactor lemma below produces `e` of degree
`m` with `f ^ d c = F e`, and `c / f ^ m = (F / f ^ d)(e / f ^ m)`. Hence that kernel is the
principal ideal of `F / f ^ d`, which is also the local equation of the zero scheme of the twisted
section of `F`. The standard opens of the degree-one elements cover `Proj 𝒮`, so the two ideal
sheaves agree.

## Main results

* `Stacks.GradedRing.exists_mem_mul_eq_of_mem_span_singleton`: a homogeneous element of degree
  `D + d` divisible by a homogeneous element of degree `d` has a homogeneous cofactor of degree
  `D`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.awayMk_homogeneous_mul` and
  `chartFraction_eq_mul_of_mul_eq`: the product `(F / f ^ d)(c / f ^ (k + n))` is `a / f ^ n` as
  soon as `F c = f ^ (k + d) a`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.ker_app_basicOpen_of_idealOfClosedSubscheme_eq_span`:
  **the kernel on a standard chart** — for `I(Z) = (F)` with `F` homogeneous of degree `d`, the
  kernel of `i` over `D₊(f)` is generated by `F / f ^ d`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span`:
  **the ideal sheaf of a hypersurface** — it is the zero scheme of the degree-`d` section of
  `𝒪(d)` attached to `F`, and its projective-space form
  `projectiveSpace_ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span`.

## Implementation notes

The degree-one case of all of this is
`StacksFrontier/AlgebraicGeometry/ProjectiveSpace/HyperplaneIsProjectiveSpace.lean`, which presents
the subscheme as `Proj` of a graded quotient. That packaging is not needed: the chart comparison
`mem_ker_app_basicOpen_iff` speaks about an arbitrary closed immersion, so the statements here
take one, and the hypothesis is the equality of homogeneous ideals rather than a graded surjection
with a prescribed kernel.

Degree indices are kept in the form `k • 1` demanded by the indexing of
`AlgebraicGeometry.ProjectiveSpectrum.Proj.chartFraction`; the factorization of a chart function
is applied with the padding exponent `k = 0`, which is left unsimplified so that the degree of the
cofactor stays a variable.

## References

* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
-/

@[expose] public noncomputable section

open CategoryTheory HomogeneousLocalization TopologicalSpace

namespace Stacks.GradedRing

universe u w

variable {S : Type u} [CommRing S] {σ : Type w} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [_root_.GradedRing 𝒮]

/-- Multiplying on the left by a homogeneous element of degree `d` adds `d` to the degree. -/
private theorem mul_mem_graded_add_right {F y : S} {d i : ℕ} (hF : F ∈ 𝒮 d) (hy : y ∈ 𝒮 i) :
    F * y ∈ 𝒮 (i + d) := by
  rw [mul_comm]
  exact SetLike.mul_mem_graded hy hF

/-- **A homogeneous multiple of a homogeneous element has a homogeneous cofactor.** If `F` is
homogeneous of degree `d` and `x` is homogeneous of degree `D + d` and divisible by `F`, then
`x = F * c` for a homogeneous `c` of degree `D`. -/
theorem exists_mem_mul_eq_of_mem_span_singleton {F : S} {d : ℕ} (hF : F ∈ 𝒮 d) {D : ℕ} {x : S}
    (hx : x ∈ 𝒮 (D + d)) (hmem : x ∈ Ideal.span ({F} : Set S)) :
    ∃ c ∈ 𝒮 D, x = F * c := by
  classical
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hmem
  refine ⟨(DirectSum.decompose 𝒮 a D : S), (DirectSum.decompose 𝒮 a D).2, ?_⟩
  have hxa : x = F * a := by rw [← ha]; ring
  have hmul : ∀ i : ℕ, F * (DirectSum.decompose 𝒮 a i : S) ∈ 𝒮 (i + d) := fun i =>
    mul_mem_graded_add_right 𝒮 hF (DirectSum.decompose 𝒮 a i).2
  have hkey : ∑ i ∈ (DirectSum.decompose 𝒮 a).support,
        (DirectSum.decompose 𝒮 (F * (DirectSum.decompose 𝒮 a i : S)) (D + d) : S)
      = F * (DirectSum.decompose 𝒮 a D : S) := by
    refine (Finset.sum_eq_single D (fun i _ hi => ?_) fun hD => ?_).trans ?_
    · exact DirectSum.decompose_of_mem_ne 𝒮 (hmul i) (by omega)
    · have h0 : (DirectSum.decompose 𝒮 a) D = 0 := DFinsupp.notMem_support_iff.mp hD
      rw [h0]
      simp
    · exact DirectSum.decompose_of_mem_same 𝒮 (hmul D)
  calc x = (DirectSum.decompose 𝒮 x (D + d) : S) :=
        (DirectSum.decompose_of_mem_same 𝒮 hx).symm
    _ = (DirectSum.decompose 𝒮 (F * a) (D + d) : S) := by rw [hxa]
    _ = (DirectSum.decompose 𝒮
          (∑ i ∈ (DirectSum.decompose 𝒮 a).support,
            F * (DirectSum.decompose 𝒮 a i : S)) (D + d) : S) := by
        rw [← Finset.mul_sum, DirectSum.sum_support_decompose 𝒮 a]
    _ = ∑ i ∈ (DirectSum.decompose 𝒮 a).support,
          (DirectSum.decompose 𝒮 (F * (DirectSum.decompose 𝒮 a i : S)) (D + d) : S) := by
        simp
    _ = F * (DirectSum.decompose 𝒮 a D : S) := hkey

end Stacks.GradedRing

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open AlgebraicGeometry

universe u w

variable {S : Type u} [CommRing S] {σ : Type w} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- The product of the fractions `F / f ^ d` and `c / f ^ (k + n)` is `a / f ^ n` as soon as
`F * c = f ^ (k + d) * a`, for `f` of degree one. -/
theorem awayMk_homogeneous_mul {f : S} (hf : f ∈ 𝒮 1) {d : ℕ} {F : S} (hF : F ∈ 𝒮 (d • 1))
    {k n : ℕ} {c a : S} (hc : c ∈ 𝒮 ((k + n) • 1)) (ha : a ∈ 𝒮 (n • 1))
    (h : F * c = f ^ (k + d) * a) :
    Away.mk 𝒮 hf d F hF * Away.mk 𝒮 hf (k + n) c hc = Away.mk 𝒮 hf n a ha := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, Away.val_mk, Away.val_mk, Away.val_mk,
    Localization.mk_mul, Localization.mk_eq_mk_iff]
  refine Localization.r_of_eq ?_
  change f ^ n * (F * c) = f ^ d * f ^ (k + n) * a
  rw [h]
  ring

/-- The chart function `a / f ^ n` factors as the product of `F / f ^ d` and `c / f ^ (k + n)` as
soon as `F * c = f ^ (k + d) * a`, for `f` of degree one. -/
theorem chartFraction_eq_mul_of_mul_eq {f : S} (hf : f ∈ 𝒮 1) {d : ℕ} (F : 𝒮 (d • 1))
    {k n : ℕ} (c : 𝒮 ((k + n) • 1)) (a : 𝒮 (n • 1))
    (h : (F : S) * (c : S) = f ^ (k + d) * (a : S)) :
    chartFraction 𝒮 hf n a = chartFraction 𝒮 hf d F * chartFraction 𝒮 hf (k + n) c :=
  Eq.trans (congrArg (Proj.awayToSection 𝒮 f).hom
    (awayMk_homogeneous_mul 𝒮 hf F.2 c.2 a.2 h).symm) (map_mul _ _ _)

/-- **The kernel of a closed immersion on a standard chart, for a principal homogeneous ideal.**
Over a Noetherian graded ring generated in degree one, if the homogeneous ideal of a closed
subscheme `Z ⊆ Proj 𝒮` is generated by a homogeneous `F` of degree `d`, then over the standard
open of a degree-one element `f` the kernel of `i` on sections is generated by `F / f ^ d`. -/
theorem ker_app_basicOpen_of_idealOfClosedSubscheme_eq_span [IsNoetherianRing S]
    (hgen : Algebra.adjoin (𝒮 0) ((𝒮 1 : Set S)) = ⊤) {f : S} (hf : f ∈ 𝒮 1)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] {d : ℕ} (F : 𝒮 (d • 1))
    (hideal : idealOfClosedSubscheme 𝒮 i = Ideal.span {(F : S)}) :
    RingHom.ker (i.app (Proj.basicOpen 𝒮 f)).hom = Ideal.span {chartFraction 𝒮 hf d F} := by
  have inst : ∀ m : ℤ, SheafOfModules.IsInvertible (Proj 𝒮).sheaf.obj
      (Proj 𝒮).ringCatSheaf.property (twistingSheaf 𝒮 m) :=
    algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen
  have hFd : (F : S) ∈ 𝒮 d := by simpa using F.2
  have hfd : f ^ d ∈ 𝒮 d := by simpa using SetLike.pow_mem_graded (A := 𝒮) d hf
  obtain ⟨t, ht1, hcov⟩ := exists_finite_degreeOne_cover 𝒮 hgen
  refine le_antisymm (fun s hs => ?_) (Ideal.span_le.mpr ?_)
  · obtain ⟨m, c, hc, rfl⟩ := (mem_ker_app_basicOpen_iff 𝒮 Nat.one_pos
      (fun j : {x : S // x ∈ t} => (j : S)) (fun j => ht1 _ j.2) hcov hf i s).1 hs
    rw [hideal] at hc
    have hcm : (c : S) ∈ 𝒮 m := by simpa using c.2
    obtain ⟨e, he, hFe⟩ := Stacks.GradedRing.exists_mem_mul_eq_of_mem_span_singleton 𝒮 hFd
      (Stacks.GradedRing.mul_mem_graded_add_right 𝒮 hfd hcm) (Ideal.mul_mem_left _ _ hc)
    have he0 : e ∈ 𝒮 ((0 + m) • 1) := by simpa using he
    rw [chartFraction_eq_mul_of_mul_eq 𝒮 hf F ⟨e, he0⟩ c
      (show (F : S) * e = f ^ (0 + d) * (c : S) by rw [Nat.zero_add]; exact hFe.symm)]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    rw [SetLike.mem_coe]
    exact chartFraction_mem_ker_app_of_mem_idealOfClosedSubscheme 𝒮 hf Nat.one_pos i d F
      (hideal ▸ Ideal.mem_span_singleton_self (F : S))

section ZeroScheme

-- The same last resort as in `StacksFrontier/AlgebraicGeometry/ProjChartKernel/Basic.lean`, whose
-- spellings this section consumes: the two descriptions of the structure sheaf of `Proj 𝒮` agree
-- only up to unfolding, so without these the instance search and unification that the
-- invertibility class `AlgebraicGeometry.zeroScheme` asks for sets off inside this section are
-- prohibitively expensive. The class itself can be stated at `twistingSheaf` without them, and
-- is, as
-- `AlgebraicGeometry.ProjectiveSpectrum.Proj.algebraicGeometry_isInvertible_twistingSheaf` of
-- `StacksFrontier/AlgebraicGeometry/ProjIdealSheaf/Basic.lean`, a file carrying no reducibility
-- attribute.
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

/-- **The ideal sheaf of a hypersurface in `Proj`.** Over a Noetherian graded ring generated in
degree one, a closed subscheme whose homogeneous ideal is generated by a homogeneous `F` of
degree `d` is the zero scheme of the canonical section of `𝒪(d)` attached to `F`.

Both ideal sheaves are generated by `F / f ^ d` over the standard open of a degree-one `f`, and
those opens cover. -/
theorem ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span [IsNoetherianRing S]
    (hgen : Algebra.adjoin (𝒮 0) ((𝒮 1 : Set S)) = ⊤)
    {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] {d : ℕ} (F : 𝒮 d)
    (hideal : idealOfClosedSubscheme 𝒮 i = Ideal.span {(F : S)})
    [SheafOfModules.IsInvertible (Proj 𝒮).sheaf.obj (Proj 𝒮).ringCatSheaf.property
      (twistingSheafModule 𝒮 (d : ℤ))] :
    i.ker = zeroScheme (Proj 𝒮) (twistingSheafModule 𝒮 (d : ℤ)) (degreeSection 𝒮 d F) := by
  have hF : (F : S) ∈ 𝒮 (d • 1) := by simp
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun g : 𝒮 1 => (⟨Proj.basicOpen 𝒮 (g : S),
      Proj.isAffineOpen_basicOpen 𝒮 (g : S) g.2 Nat.one_pos⟩ : (Proj 𝒮).affineOpens))
    (Stacks.AlgebraicGeometry.ProjDegreeOne.iSup_basicOpen_degreeOne_eq_top 𝒮 hgen) fun g => ?_
  rw [Scheme.Hom.ker_apply,
    ker_app_basicOpen_of_idealOfClosedSubscheme_eq_span 𝒮 hgen g.2 i ⟨(F : S), hF⟩ hideal,
    zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq 𝒮 g.2 Nat.one_pos d (by simp) F hF]

section ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] [IsNoetherianRing R] (e : ℕ)

/-- **The ideal sheaf of a hypersurface in projective space.** A closed subscheme of
`P^{e-1}_R` over a Noetherian ring whose homogeneous ideal is generated by a homogeneous
polynomial `F` of degree `d` is the zero scheme of the section of `𝒪(d)` determined by `F`.

The degree-one generation hypothesis of the general statement holds for a polynomial ring. -/
theorem projectiveSpace_ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span {Z : Scheme.{u}}
    (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin e) R)) [IsClosedImmersion i] {d : ℕ}
    (F : MvPolynomial.homogeneousSubmodule (Fin e) R d)
    (hideal : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i
      = Ideal.span {(F : MvPolynomial (Fin e) R)}) :
    i.ker = zeroScheme (Proj (MvPolynomial.homogeneousSubmodule (Fin e) R))
      (twistingSheafModule (MvPolynomial.homogeneousSubmodule (Fin e) R) (d : ℤ))
      (degreeSection (MvPolynomial.homogeneousSubmodule (Fin e) R) d F) :=
  ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span _
    (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin e) R) i F hideal

end ProjectiveSpace

end ZeroScheme

end AlgebraicGeometry.ProjectiveSpectrum.Proj

end
