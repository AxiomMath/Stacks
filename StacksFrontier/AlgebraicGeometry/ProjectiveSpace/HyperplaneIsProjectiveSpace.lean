universe u

/-! ### Two lemmas on graded rings -/

variable {S B σ τ : Type u} [CommRing S] [CommRing B] [SetLike σ S] [AddSubgroupClass σ S]
  [SetLike τ B] [AddSubgroupClass τ B]
  (𝒮 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒮] [GradedRing ℬ]

/-- **A homogeneous multiple of a degree-one element has a homogeneous cofactor.** If `l` is
homogeneous of degree one and `x` is homogeneous of degree `D + 1` and divisible by `l`, then
`x = l * c` for a homogeneous `c` of degree `D`. -/
theorem exists_mem_mul_eq_of_mem_span_degreeOne {l : S} (hl : l ∈ 𝒮 1) {D : ℕ} {x : S}
    (hx : x ∈ 𝒮 (D + 1)) (hmem : x ∈ Ideal.span ({l} : Set S)) :
    ∃ c ∈ 𝒮 D, x = l * c := by
  classical
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hmem
  refine ⟨(DirectSum.decompose 𝒮 a D : S), (DirectSum.decompose 𝒮 a D).2, ?_⟩
  have hxa : x = l * a := by rw [← ha]; ring
  have hmul : ∀ i : ℕ, l * (DirectSum.decompose 𝒮 a i : S) ∈ 𝒮 (i + 1) := fun i => by
    have := SetLike.mul_mem_graded hl (DirectSum.decompose 𝒮 a i).2
    rwa [Nat.add_comm] at this
  have hkey : ∑ i ∈ (DirectSum.decompose 𝒮 a).support,
        (DirectSum.decompose 𝒮 (l * (DirectSum.decompose 𝒮 a i : S)) (D + 1) : S)
      = l * (DirectSum.decompose 𝒮 a D : S) := by
    refine (Finset.sum_eq_single D (fun i _ hi => ?_) fun hD => ?_).trans ?_
    · exact DirectSum.decompose_of_mem_ne 𝒮 (hmul i) (by omega)
    · simp [DFinsupp.notMem_support_iff.mp hD]
    · exact DirectSum.decompose_of_mem_same 𝒮 (hmul D)
  calc x = (DirectSum.decompose 𝒮 x (D + 1) : S) :=
        (DirectSum.decompose_of_mem_same 𝒮 hx).symm
    _ = (DirectSum.decompose 𝒮 (l * a) (D + 1) : S) := by rw [hxa]
    _ = (DirectSum.decompose 𝒮
          (∑ i ∈ (DirectSum.decompose 𝒮 a).support,
            l * (DirectSum.decompose 𝒮 a i : S)) (D + 1) : S) := by
        rw [← Finset.mul_sum, DirectSum.sum_support_decompose 𝒮 a]
    _ = ∑ i ∈ (DirectSum.decompose 𝒮 a).support,
          (DirectSum.decompose 𝒮 (l * (DirectSum.decompose 𝒮 a i : S)) (D + 1) : S) := by
        simp
    _ = l * (DirectSum.decompose 𝒮 a D : S) := hkey

omit [GradedRing 𝒮] in
/-- A graded ring homomorphism surjective in every degree is surjective. -/
theorem surjective_of_gradedAddHom_surjective (ψ : 𝒮 →+*ᵍ ℬ)
    (h : ∀ d, Function.Surjective (GradedRingHom.gradedAddHom ψ d)) :
    Function.Surjective (ψ : S → B) := by
  classical
  intro y
  choose x hx using fun d => h d (DirectSum.decompose ℬ y d)
  refine ⟨∑ d ∈ (DirectSum.decompose ℬ y).support, ((x d : S)), ?_⟩
  calc (ψ (∑ d ∈ (DirectSum.decompose ℬ y).support, ((x d : S))) : B)
      = ∑ d ∈ (DirectSum.decompose ℬ y).support, (ψ (x d : S) : B) := map_sum _ _ _
    _ = ∑ d ∈ (DirectSum.decompose ℬ y).support, ((DirectSum.decompose ℬ y d : B)) :=
        Finset.sum_congr rfl fun d _ => by simpa using congrArg Subtype.val (hx d)
    _ = y := DirectSum.sum_support_decompose ℬ y

/-! ### The kernel of `Proj ψ` on a standard chart -/

/-- The chart function `l / f` of a degree-one element `l`, on the standard open of a degree-one
element `f`. -/
def degreeOneChartFraction {f : S} (hf : f ∈ 𝒮 1) {l : S} (hl : l ∈ 𝒮 1) :
    Γ(AlgebraicGeometry.Proj 𝒮, Proj.basicOpen 𝒮 f) :=
  chartFraction 𝒮 hf 1 ⟨l, by simpa using hl⟩

/-- The product of the fractions `l / f` and `c / f ^ (k + n)` is `a / f ^ n` as soon as
`l * c = f ^ (k + 1) * a`. -/
theorem awayMk_degreeOne_mul {f : S} (hf : f ∈ 𝒮 1) {l : S} (hl : l ∈ 𝒮 (1 • 1))
    {k n : ℕ} {c a : S} (hc : c ∈ 𝒮 ((k + n) • 1)) (ha : a ∈ 𝒮 (n • 1))
    (h : l * c = f ^ (k + 1) * a) :
    Away.mk 𝒮 hf 1 l hl * Away.mk 𝒮 hf (k + n) c hc = Away.mk 𝒮 hf n a ha := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, Away.val_mk, Away.val_mk, Away.val_mk,
    Localization.mk_mul, Localization.mk_eq_mk_iff]
  refine Localization.r_of_eq ?_
  show f ^ n * (l * c) = f ^ 1 * f ^ (k + n) * a
  rw [h]
  ring

/-- **The kernel of `Proj ψ` on a standard chart.** If the kernel of a graded homomorphism `ψ` is
the ideal generated by a degree-one element `l`, then over the standard open of a degree-one
element `f` the kernel of `Proj ψ` on sections is generated by the single fraction `l / f`. -/
theorem ker_app_projMap_basicOpen (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    {l : S} (hl : l ∈ 𝒮 1) (hker : RingHom.ker (ψ : S →+* B) = Ideal.span {l})
    {f : S} (hf : f ∈ 𝒮 1) :
    RingHom.ker ((Proj.map ψ hψ).app (Proj.basicOpen 𝒮 f)).hom
      = Ideal.span {degreeOneChartFraction 𝒮 hf hl} := by
  have hl' : l ∈ 𝒮 (1 • 1) := by simpa using hl
  have hiso : IsIso (Proj.awayToSection 𝒮 f) :=
    Stacks.ProjQuotientChartIdeal.isIso_awayToSection hf Nat.one_pos
  have hchart : degreeOneChartFraction 𝒮 hf hl
      = (Proj.awayToSection 𝒮 f).hom (Away.mk 𝒮 hf 1 l hl') := rfl
  refine le_antisymm (fun x hx => ?_) (Ideal.span_le.mpr ?_)
  · obtain ⟨z, rfl⟩ := (ConcreteCategory.bijective_of_isIso (Proj.awayToSection 𝒮 f)).2 x
    have hz := (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
      ψ hψ hf Nat.one_pos z).1 hx
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒮 hf z
    obtain ⟨k, hk⟩ :=
      (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff ψ hf n a ha).1 hz
    rw [hker] at hk
    have hk1 : f ^ (k + 1) * a ∈ Ideal.span ({l} : Set S) := by
      rw [show f ^ (k + 1) * a = f * (f ^ k * a) by ring]
      exact Ideal.mul_mem_left _ _ hk
    have ha' : a ∈ 𝒮 n := by simpa using ha
    have hdeg : f ^ (k + 1) * a ∈ 𝒮 (k + n + 1) := by
      have h1 : f ^ (k + 1) ∈ 𝒮 (k + 1) := by simpa using SetLike.pow_mem_graded (k + 1) hf
      have h2 := SetLike.mul_mem_graded h1 ha'
      rwa [show k + 1 + n = k + n + 1 by omega] at h2
    obtain ⟨c, hc, hceq⟩ := exists_mem_mul_eq_of_mem_span_degreeOne 𝒮 hl hdeg hk1
    have hc' : c ∈ 𝒮 ((k + n) • 1) := by simpa using hc
    rw [← awayMk_degreeOne_mul 𝒮 hf hl' hc' ha hceq.symm, map_mul, hchart]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rintro _ rfl
    rw [SetLike.mem_coe, hchart]
    refine (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
      ψ hψ hf Nat.one_pos _).2 ?_
    refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      ψ hf 1 l hl').2 ⟨0, ?_⟩
    rw [pow_zero, one_mul, hker]
    exact Ideal.mem_span_singleton_self l

/-! ### The twists -/

/-- **The twists pull back along `Proj ψ`.** For a graded surjection `ψ : 𝒮 → ℬ` with `𝒮`
generated in degree one, the pullback of `𝒪_{Proj 𝒮}(n)` along `Proj ψ` is `𝒪_{Proj ℬ}(n)`.

This is [Stacks, Tag 01N1] part (3), transported from the domain of definition `U(ψ)` — which
part (1) of the same tag identifies with all of `Proj ℬ` — to `Proj ℬ` itself. -/
theorem nonempty_pullbackTwist_projMap (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    (hsurj : Function.Surjective (ψ : S → B))
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤) (n : ℤ) :
    Nonempty ((Scheme.Modules.pullback (Proj.map ψ hψ)).obj (twistingSheafModule 𝒮 n)
      ≅ twistingSheafModule ℬ n) := by
  have hev : ∀ᶠ d : ℕ in atTop, Function.Surjective (GradedRingHom.gradedAddHom ψ d) :=
    Eventually.of_forall fun d => Proj.gradedAddHom_surjective_of_surjective ψ hsurj d
  have hdom : mapDomain 𝒮 ℬ ψ = ⊤ :=
    Stacks.AlgebraicGeometry.RelativeProjChain.mapDomain_eq_top_of_eventually_surjective 𝒮 ℬ ψ hev
  have htw : IsIso (twistMap 𝒮 ℬ ψ n) :=
    Stacks.AlgebraicGeometry.ProjTwistMono.isIso_projMapData_twistMap 𝒮 ℬ ψ hev hgen n
  set e : AlgebraicGeometry.Proj ℬ ⟶ (mapDomain 𝒮 ℬ ψ).toScheme :=
    (Scheme.topIso _).inv ≫ ((AlgebraicGeometry.Proj ℬ).isoOfEq hdom.symm).hom with he
  have he1 : e ≫ mapHom 𝒮 ℬ ψ = Proj.map ψ hψ := by
    rw [← Stacks.AlgebraicGeometry.RelativeProj.mapHomOfTop_eq_map 𝒮 ℬ ψ hψ hdom,
      Stacks.AlgebraicGeometry.RelativeProj.mapHomOfTop, he, Category.assoc]
  have he2 : e ≫ (mapDomain 𝒮 ℬ ψ).ι = 𝟙 _ := by
    rw [he, Category.assoc]
    exact Stacks.AlgebraicGeometry.RelativeProj.topIso_inv_isoOfEq_hom_ι 𝒮 ℬ ψ hdom
  exact ⟨(eqToIso (by rw [he1]) : (Scheme.Modules.pullback (Proj.map ψ hψ)).obj
        (twistingSheafModule 𝒮 n) ≅ (Scheme.Modules.pullback (e ≫ mapHom 𝒮 ℬ ψ)).obj
        (twistingSheafModule 𝒮 n)) ≪≫
      ((Scheme.Modules.pullbackComp e (mapHom 𝒮 ℬ ψ)).app (twistingSheafModule 𝒮 n)).symm ≪≫
      (Scheme.Modules.pullback e).mapIso (asIso (twistMap 𝒮 ℬ ψ n)) ≪≫
      (Scheme.Modules.pullbackComp e (mapDomain 𝒮 ℬ ψ).ι).app (twistingSheafModule ℬ n) ≪≫
      (eqToIso (by rw [he2]) : (Scheme.Modules.pullback (e ≫ (mapDomain 𝒮 ℬ ψ).ι)).obj
        (twistingSheafModule ℬ n) ≅ (Scheme.Modules.pullback (𝟙 _)).obj
        (twistingSheafModule ℬ n)) ≪≫
      (Scheme.Modules.pullbackId _).app (twistingSheafModule ℬ n)⟩

/-! ### The zero scheme of a degree-one section -/

section ZeroScheme

-- A last resort, as in `StacksFrontier/AlgebraicGeometry/ProjChartKernel/Basic.lean`, whose
-- spellings this section consumes: the two descriptions of the structure sheaf of `Proj 𝒮` agree
-- only up to unfolding, so without these the instance search and unification that the
-- invertibility class `AlgebraicGeometry.zeroScheme` asks for sets off inside this section are
-- prohibitively expensive. The class itself can be stated at `twistingSheaf` without them, and
-- is, as
-- `AlgebraicGeometry.ProjectiveSpectrum.Proj.algebraicGeometry_isInvertible_twistingSheaf` of
-- `StacksFrontier/AlgebraicGeometry/ProjIdealSheaf/Basic.lean`, a file carrying no reducibility
-- attribute.
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

variable [AlgebraicGeometry.SheafOfModules.IsInvertible (AlgebraicGeometry.Proj 𝒮).sheaf.obj
  (AlgebraicGeometry.Proj 𝒮).ringCatSheaf.property (twistingSheaf 𝒮 ((1 : ℕ) : ℤ))]

/-- **The ideal sheaf of `Proj ℬ` in `Proj 𝒮` is the zero scheme of `l`.** For a graded surjection
`ψ` whose kernel is generated by a degree-one element `l`, and `𝒮` generated in degree one, the
closed immersion `Proj ψ` cuts out the zero scheme of the global section of `𝒪(1)` attached to
`l`. Both ideal sheaves are generated by `l / f` over the standard open of a degree-one `f`, and
those opens cover. -/
@[sga "6 VII 4.2" "special case"]
theorem ker_projMap_eq_zeroScheme (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    (hsurj : Function.Surjective (ψ : S → B))
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (l : 𝒮 1) (hker : RingHom.ker (ψ : S →+* B) = Ideal.span {(l : S)}) :
    (Proj.map ψ hψ).ker
      = AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj 𝒮)
          (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 l) := by
  have hcl : IsClosedImmersion (Proj.map ψ hψ) :=
    Proj.isClosedImmersion_map_of_surjective' ψ hsurj
  have hl' : (l : S) ∈ 𝒮 (1 • 1) := by simp [l.2]
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun g : 𝒮 1 => (⟨Proj.basicOpen 𝒮 (g : S),
      Proj.isAffineOpen_basicOpen 𝒮 (g : S) g.2 Nat.one_pos⟩ :
        (AlgebraicGeometry.Proj 𝒮).affineOpens)) ?_ fun g => ?_
  · refine Proj.iSup_basicOpen_eq_top' 𝒮 (fun g : 𝒮 1 => (g : S)) (fun g => ⟨1, g.2⟩) ?_
    rw [show Set.range (fun g : 𝒮 1 => (g : S)) = (𝒮 1 : Set S) from Subtype.range_coe]
    exact hgen
  · rw [Scheme.Hom.ker_apply, ker_app_projMap_basicOpen 𝒮 ℬ ψ hψ l.2 hker g.2,
      zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq 𝒮 g.2 Nat.one_pos 1
        (by simp) l hl']
    rfl

/-- **A closed subscheme of `Proj 𝒮` cut out by one degree-one equation is a `Proj`.** If a graded
surjection `ψ` onto `ℬ` has kernel the ideal generated by a degree-one element `l`, then `Proj ℬ`
is isomorphic over `Proj 𝒮` to the zero scheme of the global section of `𝒪(1)` attached to `l`. -/
theorem exists_iso_zeroScheme_subscheme (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    (hsurj : Function.Surjective (ψ : S → B))
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (l : 𝒮 1) (hker : RingHom.ker (ψ : S →+* B) = Ideal.span {(l : S)}) :
    ∃ φ : AlgebraicGeometry.Proj ℬ ≅
        (AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj 𝒮)
          (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 l)).subscheme,
      φ.hom ≫ (AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj 𝒮)
        (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 l)).subschemeι
        = Proj.map ψ hψ := by
  have hcl : IsClosedImmersion (Proj.map ψ hψ) :=
    Proj.isClosedImmersion_map_of_surjective' ψ hsurj
  have hker2 : (AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj 𝒮)
      (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 l)).subschemeι.ker
      = (Proj.map ψ hψ).ker := by
    rw [Scheme.IdealSheafData.ker_subschemeι, ker_projMap_eq_zeroScheme 𝒮 ℬ ψ hψ hsurj hgen l hker]
  have hi := IsClosedImmersion.isIso_lift (AlgebraicGeometry.zeroScheme
    (AlgebraicGeometry.Proj 𝒮) (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ))
      (degreeSection 𝒮 1 l)).subschemeι (Proj.map ψ hψ) hker2
  exact ⟨asIso (IsClosedImmersion.lift _ _ hker2.le), IsClosedImmersion.lift_fac _ _ _⟩

/-- **The zero scheme of a degree-one section is a `Proj`, compatibly with the twists.** The two
previous results combined. -/
theorem exists_iso_zeroScheme_subscheme_pullbackTwist (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    (hsurj : Function.Surjective (ψ : S → B))
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (l : 𝒮 1) (hker : RingHom.ker (ψ : S →+* B) = Ideal.span {(l : S)}) (n : ℤ) :
    ∃ φ : AlgebraicGeometry.Proj ℬ ≅
        (AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj 𝒮)
          (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 l)).subscheme,
      Nonempty ((Scheme.Modules.pullback (φ.hom ≫
          (AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj 𝒮)
            (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 l)).subschemeι)).obj
        (twistingSheafModule 𝒮 n) ≅ twistingSheafModule ℬ n) := by
  obtain ⟨φ, hφ⟩ := exists_iso_zeroScheme_subscheme 𝒮 ℬ ψ hψ hsurj hgen l hker
  refine ⟨φ, ?_⟩
  rw [hφ]
  exact nonempty_pullbackTwist_projMap 𝒮 ℬ ψ hψ hsurj hgen n

end ZeroScheme

/-! ### The graded surjection attached to a degree-one form -/

section Polynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {m : ℕ}

/-- The ideal generated by the image of a line is generated by the image of a spanning vector. -/
theorem rangeIdeal_toSpanSingleton {V : Type u} [AddCommGroup V] [Module k V] (w : V) :
    SymPow.rangeIdeal (LinearMap.toSpanSingleton k V w)
      = Ideal.span {SymmetricAlgebra.ι k V w} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨a, rfl⟩
    rw [SetLike.mem_coe]
    show SymmetricAlgebra.ι k V (LinearMap.toSpanSingleton k V w a)
      ∈ Ideal.span {SymmetricAlgebra.ι k V w}
    rw [LinearMap.toSpanSingleton_apply, map_smul, Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rintro _ rfl
    exact Ideal.subset_span ⟨1, by
      show SymmetricAlgebra.ι k V (LinearMap.toSpanSingleton k V w 1)
        = SymmetricAlgebra.ι k V w
      rw [LinearMap.toSpanSingleton_apply, one_smul]⟩

/-- **The graded surjection cut out by a nonzero degree-one form.** A nonzero homogeneous form `l`
of degree one in `n + 1 = m + 2` variables is the kernel of a graded surjection of
`k[T₀, …, Tₙ]` onto a polynomial ring in `n` variables.

Read through a basis, `l` is a nonzero vector `w` of `k^{n+1}`, and the quotient by the line it
spans is a surjection of `k`-vector spaces whose symmetric algebra has kernel the ideal generated
by `w`; the quotient space has dimension `n`, so its symmetric algebra is a polynomial ring in `n`
variables.

The surjection is a **`k`-algebra** homomorphism: every map in the chain that builds it — the two
comparisons of a symmetric algebra with a polynomial ring and the symmetric algebra of a linear
quotient map — is one. That is the last conjunct, stated on the degree-zero parts because that is
the shape `AlgebraicGeometry.Proj.map_toSpecZero` consumes, and it is what makes the resulting
morphism of `Proj`s a morphism over `Spec k`. -/
theorem exists_gradedHom_ker_span_degreeOne
    (l : MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k 1)
    (hl : (l : MvPolynomial (Fin (m + 2)) k) ≠ 0) :
    ∃ ψ : MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k,
      Function.Surjective (ψ : MvPolynomial (Fin (m + 2)) k → MvPolynomial (Fin (m + 1)) k) ∧
        RingHom.ker (ψ : MvPolynomial (Fin (m + 2)) k →+* MvPolynomial (Fin (m + 1)) k)
          = Ideal.span {(l : MvPolynomial (Fin (m + 2)) k)} ∧
        ψ.gradedZeroRingHom.comp
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k 0)) =
          algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k 0) := by
  classical
  let V : Type u := Fin (m + 2) → k
  let b : Module.Basis (Fin (m + 2)) k V := Pi.basisFun k (Fin (m + 2))
  let I := SymPow.gradedMvPolynomialInv b
  have hIinj : Function.Injective ⇑I := (SymmetricAlgebra.equivMvPolynomial b).symm.injective
  have hIsurj : Function.Surjective ⇑I := (SymmetricAlgebra.equivMvPolynomial b).symm.surjective
  obtain ⟨w, hw⟩ : ∃ w : V, SymmetricAlgebra.ι k V w = I (l : MvPolynomial (Fin (m + 2)) k) := by
    have hmem := I.map_mem l.2
    rwa [show SymPow.symmetricPower 1 k V = LinearMap.range (SymmetricAlgebra.ι k V) by
      show LinearMap.range (SymmetricAlgebra.ι k V) ^ 1 = _
      rw [pow_one]] at hmem
  have hw0 : w ≠ 0 := fun h0 => hl (hIinj (by rw [← hw, h0, map_zero, map_zero]))
  let W : Submodule k V := k ∙ w
  let π : V →ₗ[k] V ⧸ W := W.mkQ
  have hπ : Function.Surjective π := W.mkQ_surjective
  have hfin : Module.finrank k (V ⧸ W) = m + 1 := by
    have h1 := Submodule.finrank_quotient_add_finrank W
    rw [show Module.finrank k W = 1 from finrank_span_singleton hw0,
      show Module.finrank k V = m + 2 from Module.finrank_fin_fun k] at h1
    omega
  let b' : Module.Basis (Fin (m + 1)) k (V ⧸ W) := Module.finBasisOfFinrankEq k _ hfin
  let H := SymPow.gradedMvPolynomialHom b'
  let Ψ := SymPow.gradedSymAlgMap π
  have hHinj : Function.Injective ⇑H := (SymmetricAlgebra.equivMvPolynomial b').injective
  have hHsurj : Function.Surjective ⇑H := (SymmetricAlgebra.equivMvPolynomial b').surjective
  have hΨdeg : ∀ d, Function.Surjective (GradedRingHom.gradedAddHom Ψ d) := by
    intro d y
    have hy : (y : SymmetricAlgebra k (V ⧸ W)) ∈
        Submodule.map (SymPow.symAlgMap π).toLinearMap (SymPow.symmetricPower d k V) := by
      rw [SymPow.symmetricPower_map_eq d π hπ]
      exact y.2
    obtain ⟨x, hx, hxy⟩ := hy
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  have hΨsurj : Function.Surjective
      (Ψ : SymmetricAlgebra k V → SymmetricAlgebra k (V ⧸ W)) :=
    surjective_of_gradedAddHom_surjective _ _ Ψ hΨdeg
  have hkerΨ : ∀ z : SymmetricAlgebra k V,
      Ψ z = 0 ↔ z ∈ Ideal.span {SymmetricAlgebra.ι k V w} := by
    intro z
    rw [← rangeIdeal_toSpanSingleton (k := k) w]
    refine ⟨fun hz => SymPow.ker_symAlgMap_le_rangeIdeal (LinearMap.toSpanSingleton k V w) π hπ
      (by rw [Submodule.ker_mkQ]; exact le_of_eq (LinearMap.span_singleton_eq_range k V w))
      hz, fun hz => ?_⟩
    rw [rangeIdeal_toSpanSingleton (k := k) w] at hz
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hz
    have hzero : Ψ (SymmetricAlgebra.ι k V w) = 0 := by
      show SymPow.symAlgMap π (SymmetricAlgebra.ι k V w) = 0
      rw [SymPow.symAlgMap_ι]
      have hπw : π w = 0 := by
        show W.mkQ w = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact Submodule.mem_span_singleton_self w
      rw [hπw, map_zero]
    rw [← hc, map_mul, hzero, mul_zero]
  refine ⟨H.comp (Ψ.comp I), hHsurj.comp (hΨsurj.comp hIsurj), ?_, ?_⟩
  · ext x
    simp only [RingHom.mem_ker]
    refine ⟨fun hx => ?_, fun hx => ?_⟩
    · have h1 : Ψ (I x) = 0 := hHinj (by rw [map_zero]; exact hx)
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ((hkerΨ _).1 h1)
      obtain ⟨c', hc'⟩ := hIsurj c
      exact Ideal.mem_span_singleton'.mpr ⟨c', hIinj (by rwa [map_mul, hc', ← hw])⟩
    · obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hx
      show H (Ψ (I x)) = 0
      rw [← hc, map_mul, map_mul, ← hw,
        (hkerΨ (SymmetricAlgebra.ι k V w)).2 (Ideal.mem_span_singleton_self _), mul_zero,
        map_zero]
  · refine RingHom.ext fun r => Subtype.ext ?_
    show SymmetricAlgebra.equivMvPolynomial b' (SymPow.symAlgMap π
      ((SymmetricAlgebra.equivMvPolynomial b).symm (algebraMap k _ r))) = algebraMap k _ r
    rw [AlgEquiv.commutes, AlgHom.commutes, AlgEquiv.commutes]

end Polynomial

/-! ### The hyperplane -/

section Hyperplane

-- The same last resort as in the `ZeroScheme` section above.
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {m n : ℕ}

/-- **The hyperplane of a degree-one form.** The zero scheme, in the sense of
[Stacks, Tag 02OQ], of the global section of `𝒪(1)` on `ℙⁿ_k = Proj k[T₀, …, Tₙ]` determined by a
homogeneous form of degree one. -/
def hyperplane (l : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k 1) :
    (AlgebraicGeometry.Proj
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)).IdealSheafData :=
  AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k))
    (twistingSheafModule (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) ((1 : ℕ) : ℤ))
    (degreeSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) 1 l)

/-- **The hyperplane of a global section of `𝒪(1)`.** The zero scheme, in the sense of
[Stacks, Tag 02OQ], of an arbitrary global section of `𝒪(1)` on `ℙⁿ_k = Proj k[T₀, …, Tₙ]`.
This is the source's own presentation of a hyperplane. -/
def hyperplaneOfSection
    (s : twistGlobalSections (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) 1) :
    (AlgebraicGeometry.Proj
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)).IdealSheafData :=
  AlgebraicGeometry.zeroScheme (AlgebraicGeometry.Proj
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k))
    (twistingSheafModule (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) ((1 : ℕ) : ℤ)) s

/-- The hyperplane of the section of a degree-one form is the hyperplane of that form. -/
theorem hyperplaneOfSection_degreeSection
    (l : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k 1) :
    hyperplaneOfSection
        (degreeSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) 1 l)
      = hyperplane l :=
  rfl

/-- **A hyperplane in `ℙⁿ_k` is `ℙ^{n-1}_k`, and `𝒪(1)` pulls back to `𝒪(1)`.**

For a nonzero homogeneous form `l` of degree one on `ℙⁿ_k = Proj k[T₀, …, Tₙ]` with `n = m + 1`,
there is an isomorphism `φ : ℙ^{n-1}_k ⟶ H` onto the hyperplane `H = Z(l)` under which the
pullback of `𝒪(1)` along `φ` composed with the inclusion `i : H ⟶ ℙⁿ_k` is `𝒪(1)`.

The last clause says that `φ` composed with the inclusion is a morphism **over `Spec k`**: it
carries the structure morphism of `ℙⁿ_k` to that of `ℙ^{n-1}_k`, both written as
`AlgebraicGeometry.Proj.toSpecZero` followed by `Spec` of the inclusion of the constants. This is
`Stacks.ProjectiveCohomology.projModelToSpec` in the spelling of that file, unfolded here so that
no import of it is needed; it holds because `φ.hom` composed with the inclusion *is* `Proj` of the
graded surjection of `Stacks.ProjectiveSpace.exists_gradedHom_ker_span_degreeOne`, which is a
`k`-algebra map. Without it the identification of the hyperplane with `ℙ^{n-1}_k` says nothing
about `k`-vector-space dimensions of cohomology, so no Euler characteristic can be transported
across it. -/
@[stacks 089Z "for the hyperplane presented by a nonzero degree-one form"]
theorem exists_iso_projectiveSpace_hyperplane
    (l : MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k 1)
    (hl : (l : MvPolynomial (Fin (m + 2)) k) ≠ 0) :
    ∃ φ : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
        ≅ (hyperplane l).subscheme,
      Nonempty ((Scheme.Modules.pullback (φ.hom ≫ (hyperplane l).subschemeι)).obj
          (twistingSheafModule (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) ((1 : ℕ) : ℤ))
        ≅ twistingSheafModule
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) ((1 : ℕ) : ℤ)) ∧
      φ.hom ≫ (hyperplane l).subschemeι ≫
          Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) ≫
            Spec.map (CommRingCat.ofHom (algebraMap k
              ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k 0))) =
        Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) ≫
          Spec.map (CommRingCat.ofHom (algebraMap k
            ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k 0))) := by
  obtain ⟨ψ, hsurj, hker, hzero⟩ := exists_gradedHom_ker_span_degreeOne l hl
  have hirr := Proj.irrelevant_le_map_of_surjective ψ hsurj
  have hgen := MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin (m + 2)) k
  obtain ⟨φ, hφ⟩ :
      ∃ φ : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
          ≅ (hyperplane l).subscheme, φ.hom ≫ (hyperplane l).subschemeι = Proj.map ψ hirr :=
    exists_iso_zeroScheme_subscheme _ _ ψ hirr hsurj hgen l hker
  refine ⟨φ, ?_, ?_⟩
  · rw [hφ]
    exact nonempty_pullbackTwist_projMap _ _ ψ hirr hsurj hgen ((1 : ℕ) : ℤ)
  · rw [← Category.assoc, hφ, Proj.map_toSpecZero_assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, hzero]

/-- **A hyperplane in `ℙⁿ_k` is `ℙ^{n-1}_k`, and `𝒪(1)` pulls back to `𝒪(1)`.**

A hyperplane in `ℙⁿ_k = Proj k[T₀, …, Tₙ]`, with `n = m + 1`, is the zero scheme `H = Z(s)` of a
nonzero global section `s` of `𝒪(1)`. There is an isomorphism `φ : ℙ^{n-1}_k ⟶ H` under which the
pullback of `𝒪(1)` along `φ` composed with the inclusion `i : H ⟶ ℙⁿ_k` is `𝒪(1)`, and `φ`
composed with that inclusion is a morphism over `Spec k`.

Such an `s` is the section of a nonzero homogeneous form of degree one, by
`Stacks.ProjectiveSpace.Cohomology.exists_degreeSection_eq`, so this is
`Stacks.ProjectiveSpace.exists_iso_projectiveSpace_hyperplane` with the form produced from the
section.

The over-`Spec k` clause is carried because the consumers of this tag in the hyperplane
restriction data of [Stacks, Tag 08A7] need the identification to respect the base: without it
the pushforward along `H ⟶ ℙⁿ_k` cannot be compared with one over `Spec k`. -/
@[stacks 089Z]
theorem exists_iso_projectiveSpace_hyperplaneOfSection
    (s : twistGlobalSections (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) 1)
    (hs : s ≠ 0) :
    ∃ φ : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
        ≅ (hyperplaneOfSection s).subscheme,
      Nonempty ((Scheme.Modules.pullback (φ.hom ≫ (hyperplaneOfSection s).subschemeι)).obj
          (twistingSheafModule (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) ((1 : ℕ) : ℤ))
        ≅ twistingSheafModule
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) ((1 : ℕ) : ℤ)) ∧
        φ.hom ≫ (hyperplaneOfSection s).subschemeι ≫
            Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) ≫
              Spec.map (CommRingCat.ofHom (algebraMap k
                ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k 0))) =
          Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) ≫
            Spec.map (CommRingCat.ofHom (algebraMap k
              ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k 0))) := by
  obtain ⟨l, rfl⟩ := Cohomology.exists_degreeSection_eq (A := k) (m + 1) 1 s
  have hl : (l : MvPolynomial (Fin (m + 2)) k) ≠ 0 := fun h => hs (by
    rw [show l = 0 from Subtype.ext h]
    exact map_zero (Cohomology.degreeSectionLinear k (m + 1) 1))
  rw [hyperplaneOfSection_degreeSection]
  exact exists_iso_projectiveSpace_hyperplane l hl

end Hyperplane

end Stacks.ProjectiveSpace

end
