module

public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.Combinatorics.Pigeonhole
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.Ideal.Operations

/-!
# Extending a compatible family of fractions to a map out of a power of an ideal

Let `A` be a commutative ring, `M` an `A`-module and `f : ι → A` a finite family generating an
ideal `I`. Suppose given `x : ι → M` and an exponent `n` satisfying the cross relation

`f j ^ n • x i = f i ^ n • x j`

for all `i, j`, the relation satisfied by the numerators of a family of fractions `x i / f i ^ n`
that agree pairwise up to torsion. This file produces from such a family an `A`-linear map

`I ^ (card ι * n + 1) ⟶ M / T`

sending `f i ^ n` to the class of `x i`, where `T` is the submodule
`Submodule.torsionBySet A M (Set.range fun i => f i ^ n)` of elements killed by every `f i ^ n`.

## Main results

* `span_pow_eq_span_setPow` — a power of the ideal generated by a set is generated by the
  pointwise power of that set.
* `span_range_pow_le_span_range_pow` — `I ^ (card ι * n + 1)` is contained in the ideal
  generated by the `n`-th powers `f i ^ n`.
* `exists_hom_of_compatible_pow_smul` — the map out of the ideal generated by the `f i ^ n`,
  with its value on each generator.
* `exists_hom_idealPow_of_compatible_pow_smul` — the same map restricted to
  `I ^ (card ι * n + 1)`, together with its value on `f i ^ (card ι * n + 1)`.
* `torsionBySet_range_pow_le_torsionBySet_idealPow` — the torsion quotiented out above is
  contained in the `I ^ (card ι * n + 1)`-torsion.

## References

* [Stacks Project, Tag 01PM](https://stacks.math.columbia.edu/tag/01PM)
-/

@[expose] public section

open scoped Pointwise

universe u v w

namespace Stacks.AlgebraicGeometry.IdealPowerSections

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M] {ι : Type w}

/-- A power of the ideal generated by a set is generated by the pointwise power of that set. -/
public lemma span_pow_eq_span_setPow (S : Set A) (k : ℕ) :
    Ideal.span S ^ k = Ideal.span (S ^ k) := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ, ih, Ideal.span_mul_span, pow_succ]

/-- For a family `f` indexed by a finite type, the `(card ι * n + 1)`-st power of the ideal
generated by the `f i` is contained in the ideal generated by the `n`-th powers `f i ^ n`. -/
public lemma span_range_pow_le_span_range_pow [Fintype ι] (f : ι → A) (n : ℕ) :
    Ideal.span (Set.range f) ^ (Fintype.card ι * n + 1) ≤
      Ideal.span (Set.range fun i => f i ^ n) := by
  classical
  rw [span_pow_eq_span_setPow, Ideal.span_le]
  intro a ha
  obtain ⟨g, hg, rfl⟩ := Set.mem_pow_iff_prod.mp ha
  choose w hw using hg
  have hcard : (Finset.univ : Finset ι).card * n <
      (Finset.univ : Finset (Fin (Fintype.card ι * n + 1))).card := by
    simp
  obtain ⟨i₀, -, hi₀⟩ :=
    Finset.exists_lt_card_fiber_of_mul_lt_card_of_maps_to
      (f := w) (fun k _ => Finset.mem_univ (w k)) hcard
  obtain ⟨S, hS, hScard⟩ :=
    Finset.exists_subset_card_eq (s := {k ∈ Finset.univ | w k = i₀}) (n := n) hi₀.le
  have hw0 : ∀ k ∈ S, w k = i₀ := fun k hk => (Finset.mem_filter.mp (hS hk)).2
  have hSprod : (∏ k ∈ S, f (w k)) = f i₀ ^ n := by
    rw [Finset.prod_congr rfl fun k hk => by rw [hw0 k hk], Finset.prod_const, hScard]
  have hrw : (∏ k, g k) = f i₀ ^ n * ∏ k ∈ Sᶜ, f (w k) := by
    rw [Finset.prod_congr rfl fun k _ => (hw k).symm, ← Finset.prod_mul_prod_compl S, hSprod]
  rw [SetLike.mem_coe, hrw]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i₀, rfl⟩)

/-- The submodule of elements killed by every `f i ^ n` is contained in the submodule killed by
the whole of `I ^ (card ι * n + 1)`, where `I` is the ideal generated by the `f i`. -/
public lemma torsionBySet_range_pow_le_torsionBySet_idealPow [Fintype ι] (f : ι → A) (n : ℕ) :
    Submodule.torsionBySet A M (Set.range fun i => f i ^ n) ≤
      Submodule.torsionBySet A M
        (Ideal.span (Set.range f) ^ (Fintype.card ι * n + 1) : Ideal A) := by
  rw [Submodule.torsionBySet_eq_torsionBySet_span]
  exact Submodule.torsionBySet_le_torsionBySet_of_subset
    (span_range_pow_le_span_range_pow f n)

/-- A family `x i` satisfying the cross relation `f j ^ n • x i = f i ^ n • x j` determines an
`A`-linear map out of the ideal generated by the `n`-th powers `f i ^ n`, sending each `f i ^ n`
to the class of `x i` modulo the elements killed by every `f j ^ n`. -/
public theorem exists_hom_of_compatible_pow_smul (f : ι → A) (n : ℕ) (x : ι → M)
    (hx : ∀ i j, f j ^ n • x i = f i ^ n • x j) :
    ∃ φ : ↥(Ideal.span (Set.range fun i => f i ^ n)) →ₗ[A]
        M ⧸ Submodule.torsionBySet A M (Set.range fun i => f i ^ n),
      ∀ i, φ ⟨f i ^ n, Ideal.subset_span ⟨i, rfl⟩⟩ =
        (Submodule.torsionBySet A M (Set.range fun i => f i ^ n)).mkQ (x i) := by
  classical
  set K := Submodule.torsionBySet A M (Set.range fun i => f i ^ n) with hK
  set p : (ι →₀ A) →ₗ[A] A := Finsupp.linearCombination A fun i => f i ^ n with hp
  set q : (ι →₀ A) →ₗ[A] M ⧸ K := Finsupp.linearCombination A fun i => K.mkQ (x i) with hq
  have hpapp : ∀ a : ι →₀ A, p a = a.sum fun i c => c * f i ^ n := fun a => by
    simp [hp, Finsupp.linearCombination_apply, smul_eq_mul]
  have hrange : Ideal.span (Set.range fun i => f i ^ n) = LinearMap.range p := by
    rw [hp, Finsupp.range_linearCombination, Ideal.submodule_span_eq]
  have hker : LinearMap.ker p ≤ LinearMap.ker q := by
    intro a ha
    have ha' : (a.sum fun i c => c * f i ^ n) = 0 := (hpapp a).symm.trans ha
    have hmem : (a.sum fun i c => c • x i) ∈ K := by
      rw [hK, Submodule.mem_torsionBySet_iff]
      rintro ⟨b, j, rfl⟩
      show f j ^ n • (a.sum fun i c => c • x i) = 0
      calc f j ^ n • (a.sum fun i c => c • x i)
          = a.sum fun i c => (c * f i ^ n) • x j := by
            rw [Finsupp.smul_sum]
            exact Finsupp.sum_congr fun i _ => by rw [smul_comm, hx i j, mul_smul]
        _ = LinearMap.toSpanSingleton A M (x j) (a.sum fun i c => c * f i ^ n) :=
            (map_finsuppSum (LinearMap.toSpanSingleton A M (x j)) a _).symm
        _ = 0 := by rw [ha', map_zero]
    have hqa : q a = K.mkQ (a.sum fun i c => c • x i) := by
      rw [hq, Finsupp.linearCombination_apply, map_finsuppSum]
      exact Finsupp.sum_congr fun i _ => (map_smul K.mkQ _ _).symm
    rw [LinearMap.mem_ker, hqa]
    exact (Submodule.Quotient.mk_eq_zero K).mpr hmem
  refine ⟨((LinearMap.ker p).liftQ q hker) ∘ₗ p.quotKerEquivRange.symm.toLinearMap ∘ₗ
      Submodule.inclusion (le_of_eq hrange), fun i => ?_⟩
  have hpsingle : p (Finsupp.single i (1 : A)) = f i ^ n := by
    rw [hp, Finsupp.linearCombination_single, one_smul]
  have hstep : p.quotKerEquivRange.symm
      (Submodule.inclusion (le_of_eq hrange) ⟨f i ^ n, Ideal.subset_span ⟨i, rfl⟩⟩) =
      Submodule.Quotient.mk (Finsupp.single i (1 : A)) := by
    rw [LinearEquiv.symm_apply_eq]
    exact Subtype.ext hpsingle.symm
  rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearEquiv.coe_coe, hstep,
    Submodule.liftQ_apply, hq, Finsupp.linearCombination_single, one_smul]

/-- A family `x i` satisfying the cross relation `f j ^ n • x i = f i ^ n • x j` determines an
`A`-linear map out of `I ^ (card ι * n + 1)`, where `I` is the ideal generated by the `f i`,
whose value on `f i ^ (card ι * n + 1)` is the class of `f i ^ (card ι * n + 1 - n) • x i`
modulo the elements killed by every `f j ^ n`. -/
public theorem exists_hom_idealPow_of_compatible_pow_smul [Fintype ι] (f : ι → A) (n : ℕ)
    (x : ι → M) (hx : ∀ i j, f j ^ n • x i = f i ^ n • x j) :
    ∃ φ : ↥(Ideal.span (Set.range f) ^ (Fintype.card ι * n + 1)) →ₗ[A]
        M ⧸ Submodule.torsionBySet A M (Set.range fun i => f i ^ n),
      ∀ i, φ ⟨f i ^ (Fintype.card ι * n + 1),
          Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _⟩ =
        (Submodule.torsionBySet A M (Set.range fun i => f i ^ n)).mkQ
          (f i ^ (Fintype.card ι * n + 1 - n) • x i) := by
  obtain ⟨ψ, hψ⟩ := exists_hom_of_compatible_pow_smul (M := M) f n x hx
  refine ⟨ψ ∘ₗ Submodule.inclusion (span_range_pow_le_span_range_pow f n), fun i => ?_⟩
  have hn : n ≤ Fintype.card ι * n + 1 :=
    Nat.le_succ_of_le (Nat.le_mul_of_pos_left n (Fintype.card_pos_iff.mpr ⟨i⟩))
  have hsplit : f i ^ (Fintype.card ι * n + 1) =
      f i ^ (Fintype.card ι * n + 1 - n) * f i ^ n := by
    rw [← pow_add, Nat.sub_add_cancel hn]
  have hcoe : (Submodule.inclusion (span_range_pow_le_span_range_pow f n))
      ⟨f i ^ (Fintype.card ι * n + 1),
        Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _⟩ =
      f i ^ (Fintype.card ι * n + 1 - n) •
        (⟨f i ^ n, Ideal.subset_span (Set.mem_range_self i)⟩ :
          ↥(Ideal.span (Set.range fun i => f i ^ n))) :=
    Subtype.ext (by simpa [smul_eq_mul] using hsplit)
  rw [LinearMap.coe_comp, Function.comp_apply, hcoe, map_smul, hψ i, ← map_smul]

end Stacks.AlgebraicGeometry.IdealPowerSections
