module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FiniteTypeExtension
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FiniteTypeKernel
public import StacksFrontier.AlgebraicGeometry.Divisors.AssociatedPoints.Quasicoherent
public import StacksFrontier.AlgebraicGeometry.FiniteTypeSubmodule.Affine
public import StacksFrontier.AlgebraicGeometry.FiniteTypeSubmodule.RestrictEpi
public import StacksFrontier.AlgebraicGeometry.FiniteTypeSubmodule.SpanRestrict

/-!
# The affine case of the finite type extension lemma

Let `Y` be an affine scheme, `M` a quasi-coherent `𝒪_Y`-module and `V ⊆ Y` a quasi-compact open
on which `M` is of finite type. Then `M` has a quasi-coherent submodule of finite type whose
inclusion becomes an isomorphism after restriction to `V`.

This is the third paragraph of the proof of [Stacks Project, Tag 01PF]. There the source writes
`Y = Spec R` and `M = Ñ`, covers `V` by finitely many basic opens `D(a_i)` on which `N_{a_i}` is
a finite module, takes the submodule `N' ⊆ N` generated by numerators of generators of the
`N_{a_i}`, and observes that `Ñ' ⊆ M` agrees with `M` over `V` because `N'_{a_i} = N_{a_i}`. The
cover, the submodule `N'` and the saturation `a_i^k x ∈ N'` are supplied by
`Stacks.AlgebraicGeometry.FiniteTypeSubmodule.exists_finite_basicOpen_cover_and_fg_submodule` and
`mem_span_restrict_image_of_forall_exists_pow_smul_mem` in the same namespace; what this file
adds is the passage from that algebra to a submodule of `M`.

Note that `Y` is an abstract affine scheme rather than a spectrum, so a consumer may apply this
at the subscheme of an affine open of any scheme with no identification with a spectrum.

## Main results

* `Stacks.AlgebraicGeometry.FiniteTypeSubmodule.exists_isFiniteType_submodule_isIso_restrict`:
  the statement above, with the submodule presented as a monomorphism into `M`.
* `exists_finiteTypeQuasicoherentSubobject_isIso_restrict`, in the same namespace: the same
  statement with the submodule presented as a `CategoryTheory.Subobject`, which is the shape the
  global form of the tag asks for.

## Implementation notes

The submodule is the image of a morphism out of a free module on a finite index set: the finitely
generated submodule `N'` of the sections of `M` over `Y` is spanned by a finite set `T`, and the
elements of `T`, read as global sections of `M`, assemble into `φ : 𝒪_Y^T ⟶ M` through
`SheafOfModules.freeHomEquiv`. Its image is quasi-coherent because the image of a morphism of
quasi-coherent modules is (`AlgebraicGeometry.isQuasicoherent_image`), and of finite type because
it is a quotient of a free module on a finite index set.

That the restriction of the image's inclusion to `V` is an isomorphism is reduced to `φ` itself
being an epimorphism after restriction to `V`, and that is checked with
`Stacks.AlgebraicGeometry.FiniteTypeSubmodule.epi_restrict_of_forall_exists_lift`: for a section
of `M` over an open `O ⊆ V` and a point of `O`, a basic open `D(g) ⊆ O ⊓ D(a_i)` around the point
is produced by `AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le`, and over `D(g)` the section
lies in the span of the restrictions of `T`, hence in the range of `φ` over `D(g)`, because the
range of a morphism of sheaves of modules evaluated at an open is a submodule containing those
restrictions.

Two spelling points. The morphism is named at the `Y.Modules` spelling through a `let`-bound
abbreviation of `SheafOfModules.free`, and the `Epi`/`Category` instances of `Y.Modules` are
reached with the repository's `attribute [local implicit_reducible]` idiom, the module universes
of `SheafOfModules.IsFiniteType` being written out because they are not determined by the
module in an existential statement.

## References

* [Stacks Project, Tag 01PF](https://stacks.math.columbia.edu/tag/01PF)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasicoherentBaseChange

universe u

namespace Stacks.AlgebraicGeometry.FiniteTypeSubmodule

/-- A section of a sheaf of modules over the whole scheme, read as a global section. -/
noncomputable def sectionOfTop {Y : Scheme.{u}} (M : Y.Modules) (x : Γ(M, ⊤)) : M.sections :=
  (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M
    (Limits.isTerminalTop (α := Y.Opens))).symm x

/-- The global section `sectionOfTop M x` takes the value `x` over the whole scheme. -/
@[simp]
theorem sectionOfTop_eval_top {Y : Scheme.{u}} (M : Y.Modules) (x : Γ(M, ⊤)) :
    (sectionOfTop M x).eval (op ⊤) = x :=
  (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M
    (Limits.isTerminalTop (α := Y.Opens))).apply_symm_apply x

/-- The value of a global section over an open is the restriction of its value over the whole
scheme. -/
theorem sectionOfTop_eval {Y : Scheme.{u}} (M : Y.Modules) (x : Γ(M, ⊤)) (W : Y.Opens) :
    (sectionOfTop M x).eval (op W) = (M.presheaf.map (homOfLE (le_top (a := W))).op).hom x := by
  have h := PresheafOfModules.sections_property (sectionOfTop M x) (homOfLE (le_top (a := W))).op
  exact h.symm.trans
    (congrArg (fun z : Γ(M, ⊤) => (M.presheaf.map (homOfLE (le_top (a := W))).op).hom z)
      (sectionOfTop_eval_top M x))

/-- A morphism out of a free module sends the `i`-th basis section to the `i`-th section it was
built from, over every open. -/
theorem app_freeSection_eval {Y : Scheme.{u}} (M : Y.Modules) {I : Type u}
    (σ : I → M.sections) (W : Y.Opens) (i : I) :
    ((M.freeHomEquiv.symm σ).val.app (op W)).hom
        ((SheafOfModules.freeSection i).eval (op W)) = (σ i).eval (op W) :=
  congrArg (fun s : M.sections => s.eval (op W))
    (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection σ i)

attribute [local implicit_reducible] AlgebraicGeometry.Scheme.Modules
  AlgebraicGeometry.Scheme.Modules.Hom AlgebraicGeometry.Scheme.Modules.instCategory in
/-- **The affine case of [Stacks Project, Tag 01PF].** A quasi-coherent module on an affine
scheme which is of finite type on a quasi-compact open `V` has a quasi-coherent submodule of
finite type whose inclusion restricts to an isomorphism over `V`. -/
theorem exists_isFiniteType_submodule_isIso_restrict {Y : Scheme.{u}} [IsAffine Y]
    (M : Y.Modules) [M.IsQuasicoherent] {V : Y.Opens} (hV : IsCompact V.1)
    (hft : (M.restrict V.ι).IsFiniteType) :
    ∃ (A : Y.Modules) (ι : A ⟶ M), A.IsQuasicoherent ∧
      SheafOfModules.IsFiniteType.{u, u, u} A ∧ Mono ι ∧
      IsIso ((Scheme.Modules.restrictFunctor V.ι).map ι) := by
  classical
  obtain ⟨J, hJ, a, N', hle, hcov, hfg, hpow⟩ :=
    exists_finite_basicOpen_cover_and_fg_submodule M (isAffineOpen_top Y) le_top hV hft
  obtain ⟨T, hT⟩ := hfg
  let I : Type u := {x : Γ(M, ⊤) // x ∈ T}
  have : Finite I := inferInstance
  let σ : I → M.sections := fun i => sectionOfTop M i.1
  let FI : Y.Modules := SheafOfModules.free I
  let φ : FI ⟶ M := M.freeHomEquiv.symm σ
  have hFIft : FI.IsFiniteType := Stacks.SheafOfModules.isFiniteType_free I
  refine ⟨image φ, image.ι φ, isQuasicoherent_image φ, ?_, inferInstance, ?_⟩
  · exact Stacks.SheafOfModules.isFiniteType_of_epi.{u, u, u} (factorThruImage φ) hFIft
  · have hepi : Epi ((Scheme.Modules.restrictFunctor V.ι).map φ) := by
      refine epi_restrict_of_forall_exists_lift φ V ?_
      intro O hOV t x hx
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.1 (hcov (hOV hx))
      obtain ⟨g, hgle, hxg⟩ := (isAffineOpen_top Y).exists_basicOpen_le
        (⟨x, ⟨hx, hi⟩⟩ : ((O ⊓ Y.basicOpen (a i) : Y.Opens) : Type u)) trivial
      refine ⟨Y.basicOpen g, hgle.trans inf_le_left, hxg, ?_⟩
      let := algebraOfLE Y (Y.basicOpen_le g)
      let := moduleOfLE M (Y.basicOpen_le g)
      have hspan := mem_span_restrict_image_of_forall_exists_pow_smul_mem M
        (isAffineOpen_top Y) (a i) g (hgle.trans inf_le_right) (T : Set Γ(M, ⊤))
        (fun z => by
          obtain ⟨k, hk⟩ := hpow i z
          exact ⟨k, hT ▸ hk⟩)
        ((M.presheaf.map (homOfLE (hgle.trans inf_le_left)).op).hom t)
      have hrange : Submodule.span Γ(Y, Y.basicOpen g)
            (restrictₗ M (Y.basicOpen_le g) '' (T : Set Γ(M, ⊤)))
          ≤ LinearMap.range (φ.val.app (op (Y.basicOpen g))).hom := by
        refine Submodule.span_le.2 ?_
        rintro z ⟨τ, hτ, rfl⟩
        refine ⟨(SheafOfModules.freeSection (⟨τ, hτ⟩ : I)).eval (op (Y.basicOpen g)), ?_⟩
        rw [app_freeSection_eval]
        exact (sectionOfTop_eval M τ (Y.basicOpen g)).symm
      obtain ⟨s, hs⟩ := hrange hspan
      exact ⟨s, hs⟩
    have hepiι : Epi ((Scheme.Modules.restrictFunctor V.ι).map (image.ι φ)) := by
      have hcomp : (Scheme.Modules.restrictFunctor V.ι).map (factorThruImage φ) ≫
          (Scheme.Modules.restrictFunctor V.ι).map (image.ι φ) =
          (Scheme.Modules.restrictFunctor V.ι).map φ := by
        rw [← Functor.map_comp, image.fac]
      exact @epi_of_epi_fac _ _ _ _ _ _ _ _ hepi hcomp
    exact isIso_restrictFunctor_map_of_mono_of_epi _ V hepiι

attribute [local implicit_reducible] AlgebraicGeometry.Scheme.Modules
  AlgebraicGeometry.Scheme.Modules.Hom AlgebraicGeometry.Scheme.Modules.instCategory in
/-- **The affine case of [Stacks Project, Tag 01PF], as a subobject.** The same statement as
`Stacks.AlgebraicGeometry.FiniteTypeSubmodule.exists_isFiniteType_submodule_isIso_restrict` with
the submodule presented as a `CategoryTheory.Subobject`, which is the shape the global statement
of the tag asks for. -/
theorem exists_finiteTypeQuasicoherentSubobject_isIso_restrict {Y : Scheme.{u}} [IsAffine Y]
    (M : Y.Modules) [M.IsQuasicoherent] {V : Y.Opens} (hV : IsCompact V.1)
    (hft : (M.restrict V.ι).IsFiniteType) :
    ∃ A : Subobject M, (A : Y.Modules).IsQuasicoherent ∧
      SheafOfModules.IsFiniteType.{u, u, u} (A : Y.Modules) ∧
      IsIso ((Scheme.Modules.restrictFunctor V.ι).map A.arrow) := by
  obtain ⟨A₀, ι, hqc, hftA, hmono, hiso⟩ :=
    exists_isFiniteType_submodule_isIso_restrict M hV hft
  have := hmono
  refine ⟨Subobject.mk ι, ?_, ?_, ?_⟩
  · exact (SheafOfModules.isQuasicoherent Y.ringCatSheaf).prop_of_iso
      (Subobject.underlyingIso ι).symm hqc
  · have : SheafOfModules.IsFiniteType.{u, u, u} A₀ := hftA
    exact Stacks.SheafOfModules.isFiniteType_of_iso.{u} (Subobject.underlyingIso ι).symm
  · have harrow : (Subobject.mk ι).arrow = (Subobject.underlyingIso ι).hom ≫ ι := by
      rw [← Subobject.underlyingIso_hom_comp_eq_mk]
    rw [harrow, Functor.map_comp]
    have := hiso
    infer_instance

end Stacks.AlgebraicGeometry.FiniteTypeSubmodule

end
