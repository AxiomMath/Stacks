module

public import Mathlib.RingTheory.GradedAlgebra.Radical
public import StacksFrontier.AlgebraicGeometry.Divisors.ProjPrincipalCodimOne

/-!
# A principal homogeneous ideal is generated by a homogeneous element

In a graded domain a principal ideal that happens to be homogeneous is already generated by a
*homogeneous* element. Consequently the ideal of a closed subscheme of `Proj` which is known to be
principal — for instance by
`AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme_isPrincipal_of_height_eq_one` —
is cut out by a single homogeneous equation, which is the form in which the source states the
conclusion for projective space and the form its consumers use.

The argument is degree bookkeeping. Write `f` for a generator and let `M` and `m` be the top and
bottom degrees occurring in `f`. Homogeneity of `(f)` puts the top component of `f` in `(f)`, say
`f_M = g * f`. In a graded *domain* the top component of a product is the product of the top
components, and likewise for bottom components, so comparing degrees on both sides of
`f_M = g * f` forces the top degree of `g` to be `0` and the bottom degree of `g` plus `m` to be
`M`. Since the bottom degree of `g` is at most its top degree, `M ≤ m`, hence `m = M` and `f` is
homogeneous.

## Main results

* `Stacks.GradedRing.proj_mul_of_unique_pair`: the component of a product in a degree which is
  attained by exactly one pair of degrees of the factors.
* `Stacks.GradedRing.exists_proj_ne_zero_isTop` and
  `Stacks.GradedRing.exists_proj_ne_zero_isBot`: a nonzero element of a graded ring has a top and
  a bottom degree.
* `Stacks.GradedRing.isHomogeneousElem_of_span_singleton_isHomogeneous`: in a graded domain, a
  nonzero element generating a homogeneous ideal is homogeneous.
* `Stacks.GradedRing.exists_isHomogeneousElem_span_singleton_eq`: a homogeneous principal ideal of
  a graded domain has a homogeneous generator.
* In `AlgebraicGeometry.ProjectiveSpectrum.Proj`:
  `exists_homogeneous_eq_idealOfClosedSubscheme` and its projective-space form
  `projectiveSpace_exists_homogeneous_eq_idealOfClosedSubscheme`: the ideal of a closed subscheme
  of `Proj` whose associated primes all have height one is generated by one homogeneous element —
  a single homogeneous equation.

## Implementation notes

The extremal degrees are produced as existence statements, `proj 𝒜 p a ≠ 0` together with the
vanishing of `proj 𝒜 i a` above (respectively below) `p`, rather than as a definition such as
`(DirectSum.decompose 𝒜 a).support.max'`. A definition would need the decidability instance
`∀ i (x : 𝒜 i), Decidable (x ≠ 0)` in every statement mentioning it, whereas the existential form
confines that instance to the proofs, where `classical` supplies it.

`Stacks.GradedRing.proj_mul_of_unique_pair` takes the collapsing of the antidiagonal as a
hypothesis about degrees, so that the top-degree and bottom-degree applications are two
instantiations of one lemma; the order arguments they need are
`Stacks.GradedRing.pair_eq_of_add_eq_of_le` and `Stacks.GradedRing.pair_eq_of_add_eq_of_ge`.

The namespace `Stacks.GradedRing` is the one already used for graded-ring lemmas
(`StacksFrontier/AlgebraicGeometry/GradedPrimeAvoidance/Basic.lean`). Inside it the class
`GradedRing` is written `_root_.GradedRing`, since the bare name would otherwise be read as the
enclosing namespace.

## References

* [Stacks Project, Tag 0BXL](https://stacks.math.columbia.edu/tag/0BXL)
* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
-/

@[expose] public section

open DirectSum SetLike GradedRing

namespace Stacks.GradedRing

variable {ι σ A : Type*} [CommRing A] [AddCommMonoid ι] [LinearOrder ι]
  [IsOrderedCancelAddMonoid ι] [SetLike σ A] [AddSubmonoidClass σ A] {𝒜 : ι → σ}
  [_root_.GradedRing 𝒜]

omit [IsOrderedCancelAddMonoid ι] in
/-- **The component of a product in a degree attained by a unique pair.** If the only pair of
degrees `(i, j)` with `proj 𝒜 i a ≠ 0`, `proj 𝒜 j b ≠ 0` and `i + j = p + q` is `(p, q)`, then the
degree-`(p + q)` component of `a * b` is the product of the degree-`p` component of `a` and the
degree-`q` component of `b`. -/
theorem proj_mul_of_unique_pair (a b : A) (p q : ι)
    (h : ∀ i j : ι, proj 𝒜 i a ≠ 0 → proj 𝒜 j b ≠ 0 → i + j = p + q → i = p ∧ j = q)
    (hp : proj 𝒜 p a ≠ 0) (hq : proj 𝒜 q b ≠ 0) :
    proj 𝒜 (p + q) (a * b) = proj 𝒜 p a * proj 𝒜 q b := by
  classical
  simp only [proj_apply, DirectSum.decompose_mul, DirectSum.coe_mul_apply 𝒜]
  refine Finset.sum_eq_single_of_mem (p, q) ?_ ?_
  · simp only [Finset.mem_filter, Finset.mem_product]
    exact ⟨⟨(mem_support_iff 𝒜 a p).2 hp, (mem_support_iff 𝒜 b q).2 hq⟩, trivial⟩
  · rintro ⟨i, j⟩ hij hne
    simp only [Finset.mem_filter, Finset.mem_product, mem_support_iff] at hij
    obtain ⟨⟨hi, hj⟩, hsum⟩ := hij
    obtain ⟨rfl, rfl⟩ := h i j hi hj hsum
    exact absurd rfl hne

omit [IsOrderedCancelAddMonoid ι] in
/-- A nonzero element of a graded ring has a largest degree in which it has a nonzero
component. -/
theorem exists_proj_ne_zero_isTop (a : A) (ha : a ≠ 0) :
    ∃ p, proj 𝒜 p a ≠ 0 ∧ ∀ i, p < i → proj 𝒜 i a = 0 := by
  classical
  have hne : (decompose 𝒜 a).support.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro he
    exact ha (by rw [← DirectSum.sum_support_decompose 𝒜 a, he, Finset.sum_empty])
  refine ⟨(decompose 𝒜 a).support.max' hne, (mem_support_iff 𝒜 a _).1 (Finset.max'_mem _ hne),
    fun i hi => ?_⟩
  by_contra hc
  exact absurd (Finset.le_max' _ i ((mem_support_iff 𝒜 a i).2 hc)) (not_le.2 hi)

omit [IsOrderedCancelAddMonoid ι] in
/-- A nonzero element of a graded ring has a smallest degree in which it has a nonzero
component. -/
theorem exists_proj_ne_zero_isBot (a : A) (ha : a ≠ 0) :
    ∃ p, proj 𝒜 p a ≠ 0 ∧ ∀ i, i < p → proj 𝒜 i a = 0 := by
  classical
  have hne : (decompose 𝒜 a).support.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro he
    exact ha (by rw [← DirectSum.sum_support_decompose 𝒜 a, he, Finset.sum_empty])
  refine ⟨(decompose 𝒜 a).support.min' hne, (mem_support_iff 𝒜 a _).1 (Finset.min'_mem _ hne),
    fun i hi => ?_⟩
  by_contra hc
  exact absurd (Finset.min'_le _ i ((mem_support_iff 𝒜 a i).2 hc)) (not_le.2 hi)

/-- Two degrees bounded above by `p` and `q` whose sum is `p + q` are `p` and `q`. -/
theorem pair_eq_of_add_eq_of_le {i j p q : ι} (hi : i ≤ p) (hj : j ≤ q)
    (hsum : i + j = p + q) : i = p ∧ j = q := by
  have hip : i = p := by_contra fun h => (add_lt_add_of_lt_of_le (hi.lt_of_ne h) hj).ne hsum
  subst hip
  exact ⟨rfl, add_left_cancel hsum⟩

/-- Two degrees bounded below by `p` and `q` whose sum is `p + q` are `p` and `q`. -/
theorem pair_eq_of_add_eq_of_ge {i j p q : ι} (hi : p ≤ i) (hj : q ≤ j)
    (hsum : i + j = p + q) : i = p ∧ j = q := by
  have hip : i = p :=
    by_contra fun h => (add_lt_add_of_lt_of_le (hi.lt_of_ne (Ne.symm h)) hj).ne hsum.symm
  subst hip
  exact ⟨rfl, add_left_cancel hsum⟩

/-- **A nonzero generator of a homogeneous ideal of a graded domain is homogeneous.** -/
theorem isHomogeneousElem_of_span_singleton_isHomogeneous [IsDomain A] {f : A} (hf : f ≠ 0)
    (h : Ideal.IsHomogeneous 𝒜 (Ideal.span {f})) : IsHomogeneousElem 𝒜 f := by
  classical
  obtain ⟨M, hM, hMtop⟩ := exists_proj_ne_zero_isTop (𝒜 := 𝒜) f hf
  obtain ⟨m, hm, hmbot⟩ := exists_proj_ne_zero_isBot (𝒜 := 𝒜) f hf
  obtain ⟨g, hg⟩ : ∃ g, g * f = proj 𝒜 M f :=
    Ideal.mem_span_singleton'.1 (h M (Ideal.mem_span_singleton_self f))
  have hgne : g ≠ 0 := by rintro rfl; exact hM (by simpa using hg.symm)
  obtain ⟨P, hP, hPtop⟩ := exists_proj_ne_zero_isTop (𝒜 := 𝒜) g hgne
  obtain ⟨Q, hQ, hQbot⟩ := exists_proj_ne_zero_isBot (𝒜 := 𝒜) g hgne
  have hmM : m ≤ M := not_lt.1 fun hlt => hM (hmbot M hlt)
  have hQP : Q ≤ P := not_lt.1 fun hlt => hQ (hPtop Q hlt)
  have hzero : ∀ j, j ≠ M → proj 𝒜 j (g * f) = 0 := fun j hj => by
    rw [hg, proj_apply]
    exact DirectSum.decompose_of_mem_ne 𝒜 (SetLike.coe_mem _) (Ne.symm hj)
  have htop : P + M = M := by
    by_contra hc
    refine mul_ne_zero hP hM ?_
    rw [← proj_mul_of_unique_pair g f P M (fun i j hi hj hsum =>
      pair_eq_of_add_eq_of_le (not_lt.1 fun hlt => hi (hPtop i hlt))
        (not_lt.1 fun hlt => hj (hMtop j hlt)) hsum) hP hM, hzero _ hc]
  have hbot : Q + m = M := by
    by_contra hc
    refine mul_ne_zero hQ hm ?_
    rw [← proj_mul_of_unique_pair g f Q m (fun i j hi hj hsum =>
      pair_eq_of_add_eq_of_ge (not_lt.1 fun hlt => hi (hQbot i hlt))
        (not_lt.1 fun hlt => hj (hmbot j hlt)) hsum) hQ hm, hzero _ hc]
  have hP0 : P = 0 := add_right_cancel (htop.trans (zero_add M).symm)
  have hMm : M ≤ m := by
    have h1 : Q + m ≤ 0 + m := add_le_add_left (hP0 ▸ hQP) m
    rw [zero_add, hbot] at h1
    exact h1
  have hmMeq : m = M := le_antisymm hmM hMm
  have hsupp : (decompose 𝒜 f).support = {M} := by
    refine Finset.eq_singleton_iff_unique_mem.2 ⟨(mem_support_iff 𝒜 f M).2 hM, fun x hx => ?_⟩
    have hx' := (mem_support_iff 𝒜 f x).1 hx
    exact le_antisymm (not_lt.1 fun hlt => hx' (hMtop x hlt))
      (hmMeq ▸ not_lt.1 fun hlt => hx' (hmbot x hlt))
  refine ⟨M, ?_⟩
  have hfeq : f = (decompose 𝒜 f M : A) := by
    conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 f]
    rw [hsupp, Finset.sum_singleton]
  rw [hfeq]
  exact SetLike.coe_mem _

/-- **A homogeneous principal ideal of a graded domain has a homogeneous generator.** -/
theorem exists_isHomogeneousElem_span_singleton_eq [IsDomain A] {I : Ideal A}
    (hhom : Ideal.IsHomogeneous 𝒜 I) (hprin : I.IsPrincipal) :
    ∃ f : A, IsHomogeneousElem 𝒜 f ∧ I = Ideal.span {f} := by
  obtain ⟨f, hf0⟩ := hprin
  have hf : I = Ideal.span {f} := hf0
  by_cases hfz : f = 0
  · exact ⟨0, ⟨0, zero_mem _⟩, by rw [hf, hfz]⟩
  · exact ⟨f, isHomogeneousElem_of_span_singleton_isHomogeneous hfz (hf ▸ hhom), hf⟩

end Stacks.GradedRing

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open AlgebraicGeometry CategoryTheory

universe u w

/-- **A single homogeneous equation for a closed subscheme of `Proj`.** If the graded ring `S` is a
Noetherian unique factorization domain and all associated primes of the ideal of a closed
subscheme `Z ⊆ Proj S` have height one, that ideal is generated by one homogeneous element.

This is `idealOfClosedSubscheme_isPrincipal_of_height_eq_one` together with the gradedness of the
ideal: a homogeneous principal ideal of a graded domain has a homogeneous generator. -/
theorem exists_homogeneous_eq_idealOfClosedSubscheme {S : Type u} {σ : Type w} [CommRing S]
    [IsDomain S] [IsNoetherianRing S] [UniqueFactorizationMonoid S] [SetLike σ S]
    [AddSubgroupClass σ S] (𝒮 : ℕ → σ) [GradedRing 𝒮] {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    [IsClosedImmersion i]
    (h : ∀ p ∈ Submodule.associatedPrimes (idealOfClosedSubscheme 𝒮 i), p.height = 1) :
    ∃ (n : ℕ) (f : S), f ∈ 𝒮 n ∧ idealOfClosedSubscheme 𝒮 i = Ideal.span {f} := by
  obtain ⟨f, ⟨n, hfn⟩, hspan⟩ := Stacks.GradedRing.exists_isHomogeneousElem_span_singleton_eq
    (idealOfClosedSubscheme_isHomogeneous 𝒮 i)
    (idealOfClosedSubscheme_isPrincipal_of_height_eq_one 𝒮 i h)
  exact ⟨n, f, hfn, hspan⟩

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **Stacks 0BXL, final step, with a homogeneous equation.** For a closed subscheme `Z` of
`P^n_R = Proj R[T₀, …, Tₙ]` over a Noetherian unique factorization domain `R`, if every associated
prime of the homogeneous ideal of `Z` has height one then that ideal is generated by a single
homogeneous polynomial.

The remaining geometric input — that `Z` having no embedded points with every irreducible
component of codimension one forces the height-one condition — is not proved here but is proved
in `StacksFrontier/AlgebraicGeometry/CodimOneSubscheme/ProjHeightOne.lean`, where this lemma is
instantiated at it to give Tag 0BXL in the form of a single homogeneous equation. -/
theorem projectiveSpace_exists_homogeneous_eq_idealOfClosedSubscheme (R : Type u) [CommRing R]
    [IsDomain R] [IsNoetherianRing R] [UniqueFactorizationMonoid R] (n : ℕ) {Z : Scheme.{u}}
    (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)) [IsClosedImmersion i]
    (h : ∀ p ∈ Submodule.associatedPrimes
        (idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) i),
      p.height = 1) :
    ∃ (d : ℕ) (F : MvPolynomial (Fin (n + 1)) R),
      F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R d ∧
        idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) i =
          Ideal.span {F} :=
  exists_homogeneous_eq_idealOfClosedSubscheme _ i h

end AlgebraicGeometry.ProjectiveSpectrum.Proj

end
