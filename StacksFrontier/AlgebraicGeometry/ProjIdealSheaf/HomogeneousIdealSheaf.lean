module

public import StacksFrontier.AlgebraicGeometry.ProjChartKernel.Localization
public import StacksFrontier.AlgebraicGeometry.ProjSaturation.VPlus
public import StacksFrontier.AlgebraicGeometry.Scheme.QuasiCoherent.FiniteTypeIdealSheaf

/-!
# The quasi-coherent ideal sheaf of a homogeneous ideal on `Proj`

Let `S = ⨁_{n ≥ 0} 𝒮 n` be a graded ring and `I ⊆ S` a homogeneous ideal. The closed subscheme
`V₊(I) = Proj (𝒮 ⧸ I) ⟶ Proj 𝒮` of Stacks Tag 01N0 has a quasi-coherent ideal sheaf, its kernel,
and this file names that ideal sheaf and computes it on the standard charts: over `D₊(f)`, for
`f` homogeneous of positive degree `d`, it is the degree-zero localization

`I₍f₎ = { b / f ^ n | n ≥ 0, b ∈ I homogeneous of degree n · d }`

of `I`, as Stacks Tag 01MX / 01N0 describe the ideal sheaf `Ĩ` of a homogeneous ideal.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpectrum.Proj.homogeneousIdealSheaf`: the ideal sheaf of `V₊(I)`
  in `Proj 𝒮`, as a `Scheme.IdealSheafData`.

## Main results

* `AlgebraicGeometry.ProjectiveSpectrum.Proj.chartFraction_mem_homogeneousIdealSheaf_iff`: a chart
  function `b / f ^ n` lies in the ideal over `D₊(f)` exactly when some `f ^ k · b` lies in `I`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.homogeneousIdealSheaf_ideal_basicOpen`: **the chart
  formula** — the ideal over `D₊(f)` is generated by the chart functions `b / f ^ n` of the
  homogeneous elements `b ∈ I` of degree `n · d`, i.e. it is `I₍f₎`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.homogeneousIdealSheaf_ideal_basicOpen_eq_span_range`:
  if `I` is generated by finitely many homogeneous `v j` of degrees `m j · d`, the ideal over
  `D₊(f)` is generated by the finitely many chart functions `v j / f ^ (m j)`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.isFiniteType_homogeneousIdealSheaf`: so if the
  standard opens of elements of degree `d` cover `Proj 𝒮`, the ideal sheaf of a homogeneous ideal
  generated by finitely many elements of degrees divisible by `d` is of finite type.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.supportSet_homogeneousIdealSheaf`: its support is
  `V₊(I) = { x | I ⊆ x }`.
* `AlgebraicGeometry.Scheme.IdealSheafData.isFiniteType_of_iSup_eq_top`: an ideal sheaf whose
  ideals over the members of an affine open cover are finitely generated is of finite type.

## Implementation notes

The ideal sheaf is *defined* as the kernel `(Proj.map (quotientMk I) _).ker` of the closed
immersion `V₊(I) ⟶ Proj 𝒮` rather than glued from the chart ideals `I₍f₎`; the gluing would need
the compatibility of the `I₍f₎` along inclusions `D₊(g) ⊆ D₊(f)`, which the kernel supplies for
free. The chart computation is then `Scheme.Hom.ker_apply` followed by the chart-kernel lemma
`AlgebraicGeometry.ProjectiveSpectrum.Proj.chartFraction_mem_ker_app_projMap_quotientMk_iff`.

The finite-generation statement is restricted to generators whose degrees are multiples of the
degree `d` of the chart. This is the case needed on projective space (`d = 1`), and it is not an
artefact of the method: for a grading with generators of coprime degrees the ideal `I₍f₎` is
generated by `v j · (𝒮_f)_{-deg v j}`, and `(𝒮_f)_{-e}` need not be cyclic over `(𝒮_f)_0`.

## References

* [Stacks Project, Tag 01N0](https://stacks.math.columbia.edu/tag/01N0)
* [Stacks Project, Tag 01MX](https://stacks.math.columbia.edu/tag/01MX)
* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite HomogeneousLocalization
open AlgebraicGeometry
open Stacks.HomogeneousIdeal

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- **Finite type of an ideal sheaf is checked on an affine open cover.** If the ideals of `I`
over the members of a family of affine opens covering `X` are finitely generated, then `I` is of
finite type. -/
theorem isFiniteType_of_iSup_eq_top {X : Scheme.{u}} (I : X.IdealSheafData) {ι : Type*}
    (U : ι → X.affineOpens) (hU : ⨆ i, (U i : X.Opens) = ⊤) (hfg : ∀ i, (I.ideal (U i)).FG) :
    I.IsFiniteType := by
  refine isFiniteType_of_forall_exists_basicOpen _ fun W x hx ↦ ?_
  have hx' : x ∈ ⨆ i, (U i : X.Opens) := hU ▸ trivial
  obtain ⟨i, hxi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
  obtain ⟨f, g, e, hxf⟩ := exists_basicOpen_le_affine_inter W.2 (U i).2 x ⟨hx, hxi⟩
  have he : X.affineBasicOpen f = X.affineBasicOpen g := Subtype.ext e
  refine ⟨f, hxf, ?_⟩
  rw [he, ← I.map_ideal_basicOpen (U i) g]
  exact (hfg i).map _

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
attribute [local instance_reducible] ProjectiveSpectrum.top

-- `V₊(I) ⟶ Proj 𝒮` is a closed immersion, hence quasi-compact; made an instance here so that
-- `Scheme.Hom.ker_apply` applies to it.
attribute [local instance] AlgebraicGeometry.Proj.isClosedImmersion_map_quotientMk

variable {S σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮] (I : HomogeneousIdeal 𝒮)

/-- **The quasi-coherent ideal sheaf of a homogeneous ideal `I` on `Proj 𝒮`**: the kernel of the
closed immersion `V₊(I) = Proj (𝒮 ⧸ I) ⟶ Proj 𝒮` of Stacks Tag 01N0. Over a standard open
`D₊(f)` its ideal is the degree-zero localization `I₍f₎`
(`homogeneousIdealSheaf_ideal_basicOpen`). -/
def homogeneousIdealSheaf : (Proj 𝒮).IdealSheafData :=
  (Proj.map (quotientMk I)
    (Proj.irrelevant_le_map_of_surjective (quotientMk I) (surjective_quotientMk I))).ker

/-- The ideal of `homogeneousIdealSheaf 𝒮 I` over an affine open is the kernel of the closed
immersion `V₊(I) ⟶ Proj 𝒮` on sections there. -/
theorem homogeneousIdealSheaf_ideal (U : (Proj 𝒮).affineOpens) :
    (homogeneousIdealSheaf 𝒮 I).ideal U =
      RingHom.ker ((Proj.map (quotientMk I)
        (Proj.irrelevant_le_map_of_surjective (quotientMk I) (surjective_quotientMk I))).app
          U).hom :=
  Scheme.Hom.ker_apply _ U

variable {f : S} {d : ℕ}

/-- **Membership of a chart function in the ideal sheaf of `I`.** Over `D₊(f)`, for `f`
homogeneous of positive degree `d`, the chart function `b / f ^ n` of a homogeneous `b` of degree
`n · d` lies in the ideal of `homogeneousIdealSheaf 𝒮 I` exactly when some `f ^ k · b` lies in
`I`. -/
theorem chartFraction_mem_homogeneousIdealSheaf_iff (hf : f ∈ 𝒮 d) (hd : 0 < d) (n : ℕ)
    (b : 𝒮 (n • d)) :
    chartFraction 𝒮 hf n b ∈ (homogeneousIdealSheaf 𝒮 I).ideal
        ⟨Proj.basicOpen 𝒮 f, Proj.isAffineOpen_basicOpen 𝒮 f hf hd⟩ ↔
      ∃ k : ℕ, f ^ k * (b : S) ∈ I.toIdeal := by
  rw [homogeneousIdealSheaf_ideal]
  exact chartFraction_mem_ker_app_projMap_quotientMk_iff 𝒮 I _ hf hd n b

/-- The chart function of an element of `I` lies in the ideal sheaf of `I`. -/
theorem chartFraction_mem_homogeneousIdealSheaf (hf : f ∈ 𝒮 d) (hd : 0 < d) (n : ℕ)
    (b : 𝒮 (n • d)) (hb : (b : S) ∈ I.toIdeal) :
    chartFraction 𝒮 hf n b ∈ (homogeneousIdealSheaf 𝒮 I).ideal
        ⟨Proj.basicOpen 𝒮 f, Proj.isAffineOpen_basicOpen 𝒮 f hf hd⟩ :=
  (chartFraction_mem_homogeneousIdealSheaf_iff 𝒮 I hf hd n b).mpr ⟨0, by simpa using hb⟩

/-- **The chart formula for the ideal sheaf of a homogeneous ideal.** Over the standard open
`D₊(f)` of a homogeneous `f` of positive degree `d`, the ideal of `homogeneousIdealSheaf 𝒮 I` is
generated by the chart functions `b / f ^ n` of the homogeneous elements `b ∈ I` of degree
`n · d`: it is the degree-zero localization `I₍f₎`. -/
theorem homogeneousIdealSheaf_ideal_basicOpen (hf : f ∈ 𝒮 d) (hd : 0 < d) :
    (homogeneousIdealSheaf 𝒮 I).ideal
        ⟨Proj.basicOpen 𝒮 f, Proj.isAffineOpen_basicOpen 𝒮 f hf hd⟩ =
      Ideal.span {a | ∃ (n : ℕ) (b : 𝒮 (n • d)), (b : S) ∈ I.toIdeal ∧
        a = chartFraction 𝒮 hf n b} := by
  apply le_antisymm
  · intro x hx
    obtain ⟨n, b, rfl⟩ := exists_chartFraction_eq 𝒮 hf hd x
    obtain ⟨k, hk⟩ := (chartFraction_mem_homogeneousIdealSheaf_iff 𝒮 I hf hd n b).mp hx
    have hmem : f ^ k * (b : S) ∈ 𝒮 ((k + n) • d) := by
      rw [add_smul]
      exact SetLike.mul_mem_graded (SetLike.pow_mem_graded k hf) b.2
    exact Ideal.subset_span
      ⟨k + n, ⟨_, hmem⟩, hk, (chartFraction_pow_mul_left 𝒮 hf k n b ⟨_, hmem⟩ rfl).symm⟩
  · rw [Ideal.span_le]
    rintro _ ⟨n, b, hb, rfl⟩
    exact chartFraction_mem_homogeneousIdealSheaf 𝒮 I hf hd n b hb

/-! ### Finite generation over a chart -/

/-- Chart functions add: `b / f ^ n + c / f ^ n = (b + c) / f ^ n`. -/
theorem chartFraction_add (hf : f ∈ 𝒮 d) (n : ℕ) (b c : 𝒮 (n • d)) :
    chartFraction 𝒮 hf n (b + c) = chartFraction 𝒮 hf n b + chartFraction 𝒮 hf n c := by
  refine Eq.trans (congrArg (Proj.awayToSection 𝒮 f).hom
    (HomogeneousLocalization.val_injective (Submonoid.powers f) ?_)) (map_add _ _ _)
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_add,
    HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
    Localization.add_mk_self]
  rfl

/-- The chart function of `0` is `0`. -/
theorem chartFraction_zero (hf : f ∈ 𝒮 d) (n : ℕ) : chartFraction 𝒮 hf n 0 = 0 := by
  have h := chartFraction_add 𝒮 hf n 0 0
  rw [add_zero] at h
  simpa using h

/-- Chart functions add over a finite sum of numerators. -/
theorem chartFraction_sum (hf : f ∈ 𝒮 d) (n : ℕ) {ι : Type*} (s : Finset ι)
    (b : ι → 𝒮 (n • d)) :
    chartFraction 𝒮 hf n (∑ i ∈ s, b i) = ∑ i ∈ s, chartFraction 𝒮 hf n (b i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using chartFraction_zero 𝒮 hf n
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, chartFraction_add, ih]

/-- **The ideal sheaf of a finitely generated homogeneous ideal on a chart.** If `I` is generated
by finitely many homogeneous `v j` of degrees `m j · d`, then over `D₊(f)`, `f` of degree
`d > 0`, the ideal of `homogeneousIdealSheaf 𝒮 I` is generated by the chart functions
`v j / f ^ (m j)`. -/
theorem homogeneousIdealSheaf_ideal_basicOpen_eq_span_range (hf : f ∈ 𝒮 d) (hd : 0 < d)
    {ι : Type*} [Finite ι] (v : ι → S) (m : ι → ℕ) (hv : ∀ j, v j ∈ 𝒮 (m j • d))
    (hI : I.toIdeal = Ideal.span (Set.range v)) :
    (homogeneousIdealSheaf 𝒮 I).ideal
        ⟨Proj.basicOpen 𝒮 f, Proj.isAffineOpen_basicOpen 𝒮 f hf hd⟩ =
      Ideal.span (Set.range fun j => chartFraction 𝒮 hf (m j) ⟨v j, hv j⟩) := by
  classical
  have := Fintype.ofFinite ι
  apply le_antisymm
  · rw [homogeneousIdealSheaf_ideal_basicOpen 𝒮 I hf hd, Ideal.span_le]
    rintro _ ⟨n, b, hb, rfl⟩
    rw [hI] at hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
    -- the degree-`n • d` component of each summand `c j * v j`
    let t : ι → 𝒮 (n • d) := fun j => DirectSum.decompose 𝒮 (c j * v j) (n • d)
    have hbt : b = ∑ j, t j := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finsetSum, (DirectSum.decompose_of_mem_same 𝒮 b.2).symm, ← hc,
        DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum]
    rw [hbt, chartFraction_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    by_cases hle : m j ≤ n
    · obtain ⟨r, rfl⟩ : ∃ r, n = r + m j := ⟨n - m j, (Nat.sub_add_cancel hle).symm⟩
      have hdeg : (r + m j) • d - m j • d = r • d := by
        simp only [smul_eq_mul]
        rw [Nat.add_mul, Nat.add_sub_cancel]
      let c' : 𝒮 (r • d) :=
        ⟨DirectSum.decompose 𝒮 (c j) ((r + m j) • d - m j • d), hdeg ▸ Subtype.prop _⟩
      have hle' : m j • d ≤ (r + m j) • d := by
        simp only [smul_eq_mul]
        exact Nat.mul_le_mul_right d (Nat.le_add_left _ _)
      have ht : chartFraction 𝒮 hf (r + m j) (t j) =
          chartFraction 𝒮 hf r c' * chartFraction 𝒮 hf (m j) ⟨v j, hv j⟩ :=
        chartFraction_mul 𝒮 hf r (m j) c' ⟨v j, hv j⟩ (t j)
          (DirectSum.coe_decompose_mul_of_right_mem_of_le 𝒮 (hv j) hle')
      rw [ht]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    · have hnle : ¬ m j • d ≤ n • d := by
        simp only [smul_eq_mul]
        exact fun h => hle (Nat.le_of_mul_le_mul_right h hd)
      rw [show t j = 0 from
        Subtype.ext (DirectSum.coe_decompose_mul_of_right_mem_of_not_le 𝒮 (hv j) hnle),
        chartFraction_zero]
      exact zero_mem _
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    refine chartFraction_mem_homogeneousIdealSheaf 𝒮 I hf hd (m j) ⟨v j, hv j⟩ ?_
    rw [hI]
    exact Ideal.subset_span ⟨j, rfl⟩

/-- **The ideal sheaf of a finitely generated homogeneous ideal is of finite type.** If the
standard opens of a family of homogeneous elements of one positive degree `d` cover `Proj 𝒮`,
and `I` is generated by finitely many homogeneous elements of degrees divisible by `d`, then
`homogeneousIdealSheaf 𝒮 I` is of finite type. -/
theorem isFiniteType_homogeneousIdealSheaf (hd : 0 < d) {κ : Type*} (fam : κ → S)
    (hfam : ∀ i, fam i ∈ 𝒮 d) (hcov : ⨆ i, Proj.basicOpen 𝒮 (fam i) = ⊤)
    {ι : Type*} [Finite ι] (v : ι → S) (m : ι → ℕ) (hv : ∀ j, v j ∈ 𝒮 (m j • d))
    (hI : I.toIdeal = Ideal.span (Set.range v)) :
    (homogeneousIdealSheaf 𝒮 I).IsFiniteType := by
  refine Scheme.IdealSheafData.isFiniteType_of_iSup_eq_top _
    (fun i => ⟨Proj.basicOpen 𝒮 (fam i), Proj.isAffineOpen_basicOpen 𝒮 (fam i) (hfam i) hd⟩)
    hcov fun i => ?_
  rw [homogeneousIdealSheaf_ideal_basicOpen_eq_span_range 𝒮 I (hfam i) hd v m hv hI]
  exact Submodule.fg_span (Set.finite_range _)

/-! ### The support -/

/-- **The points of `V₊(I)`.** A point of `Proj 𝒮` lies in the image of the closed immersion
`V₊(I) = Proj (𝒮 ⧸ I) ⟶ Proj 𝒮` exactly when its homogeneous prime contains `I`. -/
theorem mem_range_map_quotientMk_iff (x : Proj 𝒮) :
    x ∈ Set.range (Proj.map (quotientMk I)
      (Proj.irrelevant_le_map_of_surjective (quotientMk I) (surjective_quotientMk I))) ↔
      I.toIdeal ≤ x.asHomogeneousIdeal.toIdeal := by
  constructor
  · rintro ⟨z, rfl⟩ a ha
    change quotientMk I a ∈ z.asHomogeneousIdeal
    rw [quotientMk_apply, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
    exact zero_mem _
  · intro hIx
    set q := quotientMk I
    have hsurj : Function.Surjective q := surjective_quotientMk I
    have hkery : RingHom.ker (q : S →+* S ⧸ I.toIdeal) ≤ x.asHomogeneousIdeal.toIdeal :=
      fun a ha => hIx (Ideal.Quotient.eq_zero_iff_mem.mp ha)
    have hcomap : (x.asHomogeneousIdeal.toIdeal.map (q : S →+* S ⧸ I.toIdeal)).comap
        (q : S →+* S ⧸ I.toIdeal) = x.asHomogeneousIdeal.toIdeal := by
      refine (Ideal.comap_map_of_surjective (q : S →+* S ⧸ I.toIdeal) hsurj _).trans ?_
      rw [← RingHom.ker_eq_comap_bot]
      exact sup_eq_left.2 hkery
    have : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
    have hprime : (x.asHomogeneousIdeal.toIdeal.map (q : S →+* S ⧸ I.toIdeal)).IsPrime :=
      Ideal.map_isPrime_of_surjective hsurj hkery
    have hirr : (HomogeneousIdeal.irrelevant 𝒮).toIdeal ≤
        ((HomogeneousIdeal.irrelevant (quotientGrading I)).toIdeal).comap
          (q : S →+* S ⧸ I.toIdeal) :=
      (HomogeneousIdeal.toIdeal_irrelevant_le _).2 fun i hi y hy =>
        HomogeneousIdeal.mem_irrelevant_of_mem _ hi (GradedRingHom.map_mem q hy)
    let z : ProjectiveSpectrum (quotientGrading I) :=
      { asHomogeneousIdeal := x.asHomogeneousIdeal.map q
        isPrime := hprime
        not_irrelevant_le := fun hle => x.not_irrelevant_le fun a ha => by
          have h : a ∈ (x.asHomogeneousIdeal.toIdeal.map (q : S →+* S ⧸ I.toIdeal)).comap
              (q : S →+* S ⧸ I.toIdeal) := Ideal.comap_mono hle (hirr ha)
          rwa [hcomap] at h }
    exact ⟨z, ProjectiveSpectrum.ext (HomogeneousIdeal.ext hcomap)⟩

/-- **The support of the ideal sheaf of `I` is `V₊(I)`**: the points of `Proj 𝒮` whose
homogeneous prime contains `I`. -/
theorem supportSet_homogeneousIdealSheaf :
    (homogeneousIdealSheaf 𝒮 I).supportSet =
      {x : Proj 𝒮 | I.toIdeal ≤ x.asHomogeneousIdeal.toIdeal} := by
  have h := Scheme.Hom.support_ker (Proj.map (quotientMk I)
    (Proj.irrelevant_le_map_of_surjective (quotientMk I) (surjective_quotientMk I)))
  have hcl : IsClosed (Set.range (Proj.map (quotientMk I)
      (Proj.irrelevant_le_map_of_surjective (quotientMk I) (surjective_quotientMk I)))) :=
    (Proj.map (quotientMk I) _).isClosedEmbedding.isClosed_range
  rw [hcl.closure_eq] at h
  ext x
  change x ∈ ((homogeneousIdealSheaf 𝒮 I).support : Set (Proj 𝒮)) ↔ _
  rw [homogeneousIdealSheaf, h]
  exact mem_range_map_quotientMk_iff 𝒮 I x

/-- A point lies in the support of the ideal sheaf of `I` exactly when its homogeneous prime
contains `I`. -/
theorem mem_supportSet_homogeneousIdealSheaf_iff (x : Proj 𝒮) :
    x ∈ (homogeneousIdealSheaf 𝒮 I).supportSet ↔
      I.toIdeal ≤ x.asHomogeneousIdeal.toIdeal := by
  rw [supportSet_homogeneousIdealSheaf]
  rfl

end AlgebraicGeometry.ProjectiveSpectrum.Proj

end
