module

public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.TautologicalMap
public import StacksFrontier.AlgebraicGeometry.RelativeProjDegreeOne.Epi
public import StacksFrontier.AlgebraicGeometry.SymmetricSituation.DegreeOnePiece
public import StacksFrontier.AlgebraicGeometry.SheafSymmetricAlgebra.GeneratedInDegreeOne

/-!
# The tautological map of a projective bundle is an epimorphism

`Stacks.ProjectiveBundleSplitting.tautologicalMap` is the map `π^*ℰ ⟶ 𝒪_{𝐏(ℰ)}(1)` that
`Stacks.Divisors.BundleSplittingDatum.quot` asks for. Its file records that surjectivity "is not
asserted here", and that it holds exactly when the twists are generated by the degree-one
sections. This file supplies that: the graded algebra `Sym(ℰ)` is generated in degree one, so
`Stacks.AlgebraicGeometry.RelativeProjDegreeOne.epi_psiTranspose` applies to its canonical twist
datum, and the remaining factor `π^*ℰ ⟶ π^*Sym¹(ℰ)` is an isomorphism.

## Main results

* `Stacks.ProjectiveBundleSplitting.epi_tautologicalTwistMap_one`: **the transpose of the
  degree-one homogeneous-section map of the projective bundle is an epimorphism.**
* `Stacks.ProjectiveBundleSplitting.epi_tautologicalMap`: **the tautological map
  `π^*ℰ ⟶ 𝒪_{𝐏(ℰ)}(1)` is an epimorphism.**
* `Stacks.ProjectiveBundleSplitting.tautologicalTwistMap_eq`: the tautological twist map is the
  general transpose of this repository's twist-datum machinery, by `rfl`; recorded so that it is
  visible that nothing special to the symmetric algebra enters the surjectivity argument.

## Implementation notes

**`epi_comp` is applied with its instance arguments by hand.** The codomain of
`tautologicalTwistMap E hqc 1` is `(projectiveBundleTwistData E hqc).algebra.piece ((1 : ℕ) : ℤ)`
and the codomain of `tautologicalMap E hqc` is `tautologicalTwist E hqc`, which is that same
object written with the degree as an integer literal. The two are definitionally equal and not
syntactically equal, so instance search — which matches syntactically — does not find the
epimorphism hypothesis of `epi_comp` from a `have` stated at the other spelling. Fixing the
codomain in the `have` with `@Epi` and passing the instances positionally is the whole fix.

## References

* [Stacks Project, Tag 0AYP](https://stacks.math.columbia.edu/tag/0AYP)
* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
* [Stacks Project, Tag 01NR](https://stacks.math.columbia.edu/tag/01NR)
* [Stacks Project, Tag 01CG](https://stacks.math.columbia.edu/tag/01CG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjTwists
open Stacks.SymGraded

namespace Stacks.ProjectiveBundleSplitting

universe u

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

variable {X : Scheme.{u}} (E : X.Modules) (hqc : IsQuasicoherentPieces E)

/-- The tautological twist map is the transpose of the canonical twist datum's degree-one
homogeneous-section map. -/
public theorem tautologicalTwistMap_eq (n : ℕ) :
    tautologicalTwistMap E hqc n =
      Stacks.AlgebraicGeometry.RelativeProjDegreeOne.psiTranspose
        (projectiveBundleTwistData E hqc) n :=
  rfl

/-- **The tautological twist map is an epimorphism in degree one.** -/
public theorem epi_tautologicalTwistMap_one [E.IsQuasicoherent] :
    Epi (tautologicalTwistMap E hqc 1) :=
  Stacks.AlgebraicGeometry.RelativeProjDegreeOne.epi_psiTranspose
    (projectiveBundleTwistData E hqc)
    (isGeneratedInDegreeOne_schemeSheafGradedAlgebra E hqc)

/-- **The tautological map `π^*ℰ ⟶ 𝒪_{𝐏(ℰ)}(1)` is an epimorphism.** -/
public theorem epi_tautologicalMap [E.IsQuasicoherent] :
    Epi (tautologicalMap E hqc) := by
  have : IsIso ((Scheme.Modules.pullback
      (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase).map
        (Scheme.Modules.symmetricAlgebraGen X E)) :=
    ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase).mapIso
      (Scheme.Modules.symmetricAlgebraGenIso X E)).isIso_hom
  have hepi : @Epi _ _ _ (tautologicalTwist E hqc) (tautologicalTwistMap E hqc 1) :=
    epi_tautologicalTwistMap_one E hqc
  exact @epi_comp _ _ _ _ _ _ inferInstance _ hepi

end Stacks.ProjectiveBundleSplitting

end
