module

public import StacksFrontier.Algebra.Homology.StrictlyPerfectRestriction
public import StacksFrontier.AlgebraicGeometry.Modules.StalkSupport

/-!
# Restriction of global sections along a morphism, and generation by global sections

For a morphism of schemes `i : E ⟶ X` and an `𝒪_X`-module `N`, the unit of the
pullback–pushforward adjunction restricts a global section of `N` to a global section of
`i^*N`. This file records that restriction, its compatibility with morphisms of modules, and the
criterion by which a family of global sections generating a module makes a morphism onto that
module an epimorphism.

## Main definitions

* `AlgebraicGeometry.Scheme.Modules.restrictSections`: the restriction of a global section
  along `i`.

## Main results

* `AlgebraicGeometry.Scheme.Modules.sectionsMap_restrictSections`: restriction commutes with a
  morphism of `𝒪_X`-modules.
* `AlgebraicGeometry.Scheme.Modules.epi_of_sections_lift`: a morphism onto `N` is an
  epimorphism as soon as every member of some generating family of global sections of `N` is the
  image of a global section.
* `AlgebraicGeometry.Scheme.Modules.exists_sections_eq_of_surjective_app_top`: a surjection on
  global sections over the whole space lifts global sections.

## Implementation notes

A global section of a module on a space is a compatible family over all opens, but the family is
determined by its value over the whole space
(`Stacks.PresheafOfModules.sections_ext_top`), and any value over the whole space extends
(`Stacks.PresheafOfModules.sectionOfTop`). Everything below is therefore proved by comparing
values over the whole space. In particular the restriction along `i` is defined by transporting
the value over the whole space of the image of the section under the adjunction unit, using that
the sections of `i_*ℱ` over the whole space of `X` are the sections of `ℱ` over the whole space
of `E`.

`AlgebraicGeometry.Scheme.Modules` carries its own copies of the categorical instances of
`SheafOfModules`, so an `Epi` in one reading is invisible to instance search in the other;
`AlgebraicGeometry.Scheme.Modules.epi_sheafOfModules` transports one way and
`AlgebraicGeometry.Scheme.Modules.epi_of_epi_sheafOfModules` the other.

## References

* [Stacks Project, Tag 01AH](https://stacks.math.columbia.edu/tag/01AH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X E : Scheme.{u}}

/-- An epimorphism of modules on a scheme read back from the category of sheaves of modules over
the structure sheaf, the converse transport of
`AlgebraicGeometry.Scheme.Modules.epi_sheafOfModules`. -/
public theorem epi_of_epi_sheafOfModules {M N : X.Modules} (f : M ⟶ N)
    (h : @Epi (SheafOfModules.{u} X.ringCatSheaf) inferInstance M N f) : Epi f :=
  ⟨fun g h' hcomp => h.left_cancellation g h' hcomp⟩

/-! ### Generation by global sections -/

/-- **A morphism onto a module generated by global sections, all of which lift, is an
epimorphism.** The lifts assemble into a morphism out of the free module whose composite with
the given morphism is the generating epimorphism. -/
public theorem epi_of_sections_lift {M N : X.Modules} (φ : M ⟶ N)
    (G : SheafOfModules.GeneratingSections N) (s : G.I → SheafOfModules.sections M)
    (hs : ∀ j, SheafOfModules.sectionsMap φ (s j) = G.s j) : Epi φ := by
  refine epi_of_epi_sheafOfModules φ ?_
  have hfac := (SheafOfModules.freeHomEquiv_symm_comp (I := G.I) s φ).trans
    (congrArg N.freeHomEquiv.symm (funext hs))
  exact @epi_of_epi_fac _ _ _ _ _ _ _ _ G.epi hfac

/-- The image of `sectionOfTop M m` under a morphism of modules has value `φ m` over the whole
space. -/
private theorem sectionsMap_sectionOfTop_val_top {M N : X.Modules} (φ : M ⟶ N)
    (m : M.val.obj (op ⊤)) :
    (SheafOfModules.sectionsMap φ (Stacks.PresheafOfModules.sectionOfTop M.val m)).val (op ⊤) =
      φ.val.app (op ⊤) m := by
  rw [show (SheafOfModules.sectionsMap φ (Stacks.PresheafOfModules.sectionOfTop M.val m)).val
    (op ⊤) = φ.val.app (op ⊤) ((Stacks.PresheafOfModules.sectionOfTop M.val m).val (op ⊤))
    from rfl, Stacks.PresheafOfModules.sectionOfTop_val_top]

/-- **A surjection on sections over the whole space lifts global sections.** The preimage of the
value over the whole space extends to a global section, and two global sections agreeing over
the whole space are equal. -/
public theorem exists_sections_eq_of_surjective_app_top {M N : X.Modules} (φ : M ⟶ N)
    (hφ : Function.Surjective (φ.val.app (op ⊤))) (t : SheafOfModules.sections N) :
    ∃ s : SheafOfModules.sections M, SheafOfModules.sectionsMap φ s = t := by
  obtain ⟨m, hm⟩ := hφ (t.val (op ⊤))
  exact ⟨Stacks.PresheafOfModules.sectionOfTop _ m, Stacks.PresheafOfModules.sections_ext_top
    (by rw [sectionsMap_sectionOfTop_val_top, hm])⟩

/-! ### Restriction of global sections along a morphism -/

/-- **The restriction of a global section along a morphism of schemes.** The unit of the
pullback–pushforward adjunction carries a global section of `N` to a global section of `i_*i^*N`,
whose value over the whole space of `X` is a section of `i^*N` over the whole space of `E`. -/
public def restrictSections (i : E ⟶ X) (N : X.Modules) (s : SheafOfModules.sections N) :
    SheafOfModules.sections ((Scheme.Modules.pullback i).obj N) :=
  Stacks.PresheafOfModules.sectionOfTop _
    ((SheafOfModules.sectionsMap
      ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app N) s).val (op ⊤))

/-- The value of a restricted section over the whole space is the value of the image of the
section under the adjunction unit. -/
public theorem restrictSections_val_top (i : E ⟶ X) (N : X.Modules)
    (s : SheafOfModules.sections N) :
    (restrictSections i N s).val (op ⊤) =
      (SheafOfModules.sectionsMap
        ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app N) s).val (op ⊤) :=
  Stacks.PresheafOfModules.sectionOfTop_val_top _ _

/-- **Restriction of global sections commutes with a morphism of modules.** Both sides have, as
their value over the whole space, the value of the image of the section under the naturality
square of the adjunction unit. -/
public theorem sectionsMap_restrictSections (i : E ⟶ X) {M N : X.Modules} (φ : M ⟶ N)
    (s : SheafOfModules.sections M) :
    SheafOfModules.sectionsMap ((Scheme.Modules.pullback i).map φ) (restrictSections i M s) =
      restrictSections i N (SheafOfModules.sectionsMap φ s) := by
  have hnat : φ ≫ (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app N =
      (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M ≫
        (Scheme.Modules.pushforward i).map ((Scheme.Modules.pullback i).map φ) :=
    (Scheme.Modules.pullbackPushforwardAdjunction i).unit.naturality φ
  have key : SheafOfModules.sectionsMap
        ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app N)
        (SheafOfModules.sectionsMap φ s) =
      SheafOfModules.sectionsMap
        ((Scheme.Modules.pushforward i).map ((Scheme.Modules.pullback i).map φ))
        (SheafOfModules.sectionsMap
          ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M) s) :=
    (SheafOfModules.sectionsMap_comp φ _ s).symm.trans
      ((congrArg (fun ψ : M ⟶ (Scheme.Modules.pushforward i).obj
          ((Scheme.Modules.pullback i).obj N) => SheafOfModules.sectionsMap ψ s) hnat).trans
        (SheafOfModules.sectionsMap_comp _ _ s))
  refine Stacks.PresheafOfModules.sections_ext_top ?_
  rw [restrictSections_val_top, key]
  exact congrArg (fun x => ((Scheme.Modules.pullback i).map φ).val.app (op ⊤) x)
    (restrictSections_val_top i M s)

/-- **Global sections of `i^*N` lift to global sections of `N`** as soon as the adjunction unit
is surjective on sections over the whole space. The sections of `i_*i^*N` over the whole space of
`X` are the sections of `i^*N` over the whole space of `E`. -/
public theorem exists_restrictSections_eq (i : E ⟶ X) (N : X.Modules)
    (h : Function.Surjective
      (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app N).val.app (op ⊤)))
    (t : SheafOfModules.sections ((Scheme.Modules.pullback i).obj N)) :
    ∃ s : SheafOfModules.sections N, restrictSections i N s = t := by
  obtain ⟨m, hm⟩ := h (t.val (op ⊤))
  refine ⟨Stacks.PresheafOfModules.sectionOfTop N.val m,
    Stacks.PresheafOfModules.sections_ext_top ?_⟩
  rw [restrictSections_val_top]
  exact (sectionsMap_sectionOfTop_val_top _ m).trans hm

end AlgebraicGeometry.Scheme.Modules

end
