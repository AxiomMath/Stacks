module

public import StacksFrontier.AlgebraicGeometry.ProjectiveSpaceModuli.CrossMultiplication
public import StacksFrontier.AlgebraicGeometry.PullbackSections.Qcqs
public import StacksFrontier.AlgebraicGeometry.SectionProduct.Tensor

/-!
# Coordinates of global sections of an invertible module at a point

Let `X` be a scheme, `M` an invertible `𝒪_X`-module and `e` a global section of `M` which does
not vanish at a point `x`. Then the germ of `e` is a basis of the free rank-one
`𝒪_{X,x}`-module `M_x`, so every global section `s` has a *coordinate* at `x` relative to `e`:
the unique `a ∈ 𝒪_{X,x}` with `s_x = a e_x`. Identities between sections of tensor products of
invertible modules can then be checked at stalks as identities between elements of the local
rings, the way one computes with homogeneous coordinates.

The coordinates behave as expected under the operations of the calculus:

* they are additive in the section, and the coordinate of `e` itself is `1`;
* a section vanishes at `x` (its germ is zero) exactly when its coordinate is zero, and it does not
  vanish at `x` in the sense of `Stacks.Ample.nonvanishingLocus` exactly when its coordinate is a
  unit;
* the coordinate of a product `s ⊗ t` relative to `e ⊗ e'` is the product of the coordinates;
* the coordinate at `y` of the pullback `f^* s` along a morphism `f : Y ⟶ X`, relative to `f^* e`,
  is the image of the coordinate at `f y` under `f^♯ : 𝒪_{X, f y} → 𝒪_{Y, y}`;
* an isomorphism of modules preserves coordinates.

The cross-multiplication condition `Stacks.ProjectiveSpaceModuli.CrossMultiplies` of two
families of sections reads, in coordinates, as the vanishing of the two-by-two minors.

## Main definitions

* `Stacks.InvertibleStalk.stalkCoord`: the coordinate at `x`, relative to a global section `e`
  not vanishing at `x`, of a global section.

## Main results

* `Stacks.InvertibleStalk.stalkCoord_smul_Γgerm`: `s_x = (stalkCoord s) • e_x`.
* `Stacks.InvertibleStalk.Γgerm_eq_zero_iff_stalkCoord_eq_zero` and
  `Stacks.InvertibleStalk.mem_nonvanishingLocus_iff_isUnit_stalkCoord`.
* `Stacks.InvertibleStalk.stalkCoord_tensorSectionsAt`: coordinates of products multiply.
* `Stacks.InvertibleStalk.Γgerm_pullbackGlobalSections_eq_smul` and
  `Stacks.InvertibleStalk.stalkCoord_pullbackGlobalSections`: coordinates of pullbacks.
* `Stacks.InvertibleStalk.stalkCoord_app_hom`: isomorphisms preserve coordinates.
* `Stacks.InvertibleStalk.tmul_eq_tmul_iff_stalkCoord`: cross-multiplication in coordinates.

## Implementation notes

Coordinates are taken relative to *global* sections, which is all that is needed for modules
generated by their global sections; this keeps every frame a section that can be pulled back
along an arbitrary morphism. The pullback formula is proved on sections: near `f y` the section
`s` is `a • e` for a local function `a`, and the unit of `f^* ⊣ f_*` is semilinear along `f^♯`.

## References

* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
* [Stacks Project, Tag 01CB](https://stacks.math.columbia.edu/tag/01CB)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open scoped TensorProduct

universe u

namespace Stacks.InvertibleStalk

variable {X : Scheme.{u}}

/-! ### The pullback of a section near a point -/

section Pullback

variable {Y : Scheme.{u}} (f : Y ⟶ X) (M : X.Modules)

open Stacks.AlgebraicGeometry.SectionsBaseChange in
/-- The germ of a pulled-back global section is the germ of the section of `f^* M` over
`f⁻¹ W` attached by the unit of `f^* ⊣ f_*` to its restriction to `W`, for any open `W ∋ f y`. -/
theorem Γgerm_pullbackGlobalSections {y : Y} {W : X.Opens} (hW : y ∈ f ⁻¹ᵁ W) (s : Γ(M, ⊤)) :
    (((Scheme.Modules.pullback f).obj M).presheaf.Γgerm y).hom (pullbackGlobalSections f M s) =
      (((Scheme.Modules.pullback f).obj M).presheaf.germ (f ⁻¹ᵁ W) y hW).hom
        (pullbackUnitSections f M W (M.presheaf.map (homOfLE le_top).op s)) := by
  rw [pullbackUnitSections_naturality]
  refine (TopCat.Presheaf.germ_res_apply _ _ y (show y ∈ (⊤ : Y.Opens) from trivial) _).trans ?_
  exact (TopCat.Presheaf.germ_res_apply _ _ y hW _).symm

open Stacks.AlgebraicGeometry.SectionsBaseChange in
/-- **The pullback of a section is semilinear along `f^♯`, at the level of germs.** If
`s_{f y} = a • e_{f y}` for global sections `s`, `e` of `M`, then
`(f^* s)_y = f^♯(a) • (f^* e)_y`. -/
theorem Γgerm_pullbackGlobalSections_eq_smul {y : Y} {s e : Γ(M, ⊤)}
    {a : X.presheaf.stalk (f y)}
    (h : (M.presheaf.Γgerm (f y)).hom s = a • (M.presheaf.Γgerm (f y)).hom e) :
    (((Scheme.Modules.pullback f).obj M).presheaf.Γgerm y).hom (pullbackGlobalSections f M s) =
      (f.stalkMap y).hom a •
        (((Scheme.Modules.pullback f).obj M).presheaf.Γgerm y).hom
          (pullbackGlobalSections f M e) := by
  obtain ⟨V, hV, b, rfl⟩ := X.presheaf.germ_exist a
  have h' : (M.presheaf.germ ⊤ (f y) trivial).hom s =
      (M.presheaf.germ V (f y) hV).hom (b • M.presheaf.map (homOfLE le_top).op e) := by
    rw [Scheme.Modules.germ_smul, M.presheaf.germ_res_apply]
    exact h
  obtain ⟨W, hW, iU, iV, hUV⟩ :=
    M.presheaf.germ_eq (f y) (show f y ∈ (⊤ : X.Opens) from trivial) hV s _ h'
  have hyW : y ∈ f ⁻¹ᵁ W := hW
  rw [Γgerm_pullbackGlobalSections f M hyW s, Γgerm_pullbackGlobalSections f M hyW e,
    show (homOfLE le_top : W ⟶ ⊤) = iU from Subsingleton.elim _ _, hUV,
    Scheme.Modules.map_smul, pullbackUnitSections_smul, Scheme.Modules.germ_smul]
  have e₁ : M.presheaf.map iV.op (M.presheaf.map (homOfLE le_top : V ⟶ ⊤).op e) =
      M.presheaf.map iU.op e := by
    rw [← ConcreteCategory.comp_apply, ← M.presheaf.map_comp]
    rfl
  have e₂ : (Y.presheaf.germ (f ⁻¹ᵁ W) y hyW).hom ((f.app W).hom (X.presheaf.map iV.op b)) =
      (f.stalkMap y).hom ((X.presheaf.germ V (f y) hV).hom b) := by
    rw [← X.presheaf.germ_res_apply iV (f y) hW b]
    exact (Scheme.Hom.germ_stalkMap_apply f W y hW _).symm
  rw [e₁, e₂]

end Pullback

/-! ### Coordinates relative to a nonvanishing global section -/

section Coordinate

variable (M : X.Modules) [Stacks.Ample.IsInvertibleModule X M]

/-- **The coordinate at `x` of a global section `s` relative to `e`**, for a global section `e`
not vanishing at `x`: the unique `a ∈ 𝒪_{X,x}` with `s_x = a • e_x`. -/
def stalkCoord {e : Γ(M, ⊤)} {x : X} (he : x ∈ Stacks.Ample.nonvanishingLocus M e)
    (s : Γ(M, ⊤)) : X.presheaf.stalk x :=
  (Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus M e he).coord
    ((M.presheaf.Γgerm x).hom s)

variable {M} {e : Γ(M, ⊤)} {x : X} (he : x ∈ Stacks.Ample.nonvanishingLocus M e)

/-- **The defining property of the coordinate**: `s_x = (stalkCoord s) • e_x`. -/
theorem stalkCoord_smul_Γgerm (s : Γ(M, ⊤)) :
    stalkCoord M he s • (M.presheaf.Γgerm x).hom e = (M.presheaf.Γgerm x).hom s :=
  (Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus M e he).smul_coord _

/-- The coordinate is the only scalar with the defining property. -/
theorem stalkCoord_eq_of_smul_Γgerm {s : Γ(M, ⊤)} {a : X.presheaf.stalk x}
    (h : a • (M.presheaf.Γgerm x).hom e = (M.presheaf.Γgerm x).hom s) :
    stalkCoord M he s = a := by
  unfold stalkCoord
  rw [← h]
  exact (Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus M e
    he).coord_smul a

/-- The coordinate of `e` relative to itself is `1`. -/
@[simp] theorem stalkCoord_self : stalkCoord M he e = 1 :=
  (Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus M e he).coord_self

@[simp] theorem stalkCoord_add (s t : Γ(M, ⊤)) :
    stalkCoord M he (s + t) = stalkCoord M he s + stalkCoord M he t := by
  simp [stalkCoord]

@[simp] theorem stalkCoord_neg (s : Γ(M, ⊤)) : stalkCoord M he (-s) = -stalkCoord M he s := by
  simp [stalkCoord]

@[simp] theorem stalkCoord_sub (s t : Γ(M, ⊤)) :
    stalkCoord M he (s - t) = stalkCoord M he s - stalkCoord M he t := by
  simp [stalkCoord]

@[simp] theorem stalkCoord_zero : stalkCoord M he 0 = 0 := by
  simp [stalkCoord]

@[simp] theorem stalkCoord_zsmul (n : ℤ) (s : Γ(M, ⊤)) :
    stalkCoord M he (n • s) = n • stalkCoord M he s := by
  simp [stalkCoord]

/-- The coordinate of a finite sum of sections is the sum of their coordinates. -/
theorem stalkCoord_sum {ι : Type*} (t : Finset ι) (s : ι → Γ(M, ⊤)) :
    stalkCoord M he (∑ i ∈ t, s i) = ∑ i ∈ t, stalkCoord M he (s i) := by
  simp [stalkCoord]

/-- **A section vanishes at `x` exactly when its coordinate is zero.** -/
theorem Γgerm_eq_zero_iff_stalkCoord_eq_zero (s : Γ(M, ⊤)) :
    (M.presheaf.Γgerm x).hom s = 0 ↔ stalkCoord M he s = 0 := by
  unfold stalkCoord
  exact (LinearEquiv.map_eq_zero_iff _).symm

/-- **A section does not vanish at `x` exactly when its coordinate is a unit.** -/
theorem mem_nonvanishingLocus_iff_isUnit_stalkCoord (s : Γ(M, ⊤)) :
    x ∈ Stacks.Ample.nonvanishingLocus M s ↔ IsUnit (stalkCoord M he s) := by
  rw [Stacks.Ample.mem_nonvanishingLocus_iff, ← stalkCoord_smul_Γgerm he s,
    Stacks.ModuleStalk.smul_mem_maximalSmul_iff]
  have he' : (M.presheaf.Γgerm x).hom e ∉ Stacks.ModuleStalk.maximalSmul M x := he
  tauto

/-- **A global section all of whose coordinates vanish is zero.** -/
theorem eq_zero_of_forall_stalkCoord_eq_zero (s : Γ(M, ⊤))
    (h : ∀ x : X, ∃ (e : Γ(M, ⊤)) (he : x ∈ Stacks.Ample.nonvanishingLocus M e),
      stalkCoord M he s = 0) : s = 0 := by
  refine TopCat.Presheaf.section_ext ⟨M.presheaf, M.isSheaf⟩ ⊤ _ _ fun x _ => ?_
  obtain ⟨e, he, hs⟩ := h x
  rw [map_zero]
  exact (Γgerm_eq_zero_iff_stalkCoord_eq_zero he s).2 hs

end Coordinate

/-! ### Coordinates of products, pullbacks and images under isomorphisms -/

section Calculus

variable {M N : X.Modules} [Stacks.Ample.IsInvertibleModule X M]
  [Stacks.Ample.IsInvertibleModule X N]

/-- The germ of a product of global sections is the product of the germs. -/
theorem Γgerm_tensorSectionsAt (x : X) (s : Γ(M, ⊤)) (t : Γ(N, ⊤)) :
    ((Scheme.Modules.tensorObj M N).presheaf.Γgerm x).hom
        (Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) M N
          s t) =
      tensorStalkTmul M N x ((M.presheaf.Γgerm x).hom s) ((N.presheaf.Γgerm x).hom t) :=
  (tensorStalkEquiv M N x).injective
    ((Stacks.SectionProduct.tensorStalkEquiv_germ_tensorSectionsAt M N x ⊤ trivial s t).trans
      (tensorStalkEquiv_tensorStalkTmul M N x _ _).symm)

/-- A product of sections not vanishing at `x` does not vanish at `x`. -/
theorem mem_nonvanishingLocus_tensorSectionsAt {e : Γ(M, ⊤)} {e' : Γ(N, ⊤)} {x : X}
    (he : x ∈ Stacks.Ample.nonvanishingLocus M e)
    (he' : x ∈ Stacks.Ample.nonvanishingLocus N e') :
    x ∈ Stacks.Ample.nonvanishingLocus (Scheme.Modules.tensorObj M N)
      (Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) M N
        e e') := by
  rw [Stacks.SectionProduct.nonvanishingLocus_tensorSectionsAt]
  exact ⟨he, he'⟩

/-- **Coordinates of products multiply**: relative to `e ⊗ e'`, the coordinate of `s ⊗ t` is the
product of the coordinates of `s` relative to `e` and of `t` relative to `e'`. -/
theorem stalkCoord_tensorSectionsAt {e : Γ(M, ⊤)} {e' : Γ(N, ⊤)} {x : X}
    (he : x ∈ Stacks.Ample.nonvanishingLocus M e)
    (he' : x ∈ Stacks.Ample.nonvanishingLocus N e') (s : Γ(M, ⊤)) (t : Γ(N, ⊤)) :
    stalkCoord (Scheme.Modules.tensorObj M N) (mem_nonvanishingLocus_tensorSectionsAt he he')
        (Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op ⊤) M N
          s t) =
      stalkCoord M he s * stalkCoord N he' t := by
  refine stalkCoord_eq_of_smul_Γgerm _ ?_
  rw [Γgerm_tensorSectionsAt, Γgerm_tensorSectionsAt, ← tensorStalkTmul_smul_smul,
    stalkCoord_smul_Γgerm, stalkCoord_smul_Γgerm]

/-- **Cross-multiplication in coordinates.** For global sections `sᵢ` of `M` and `tᵢ` of `N`,
`s₁ ⊗ t₁ = s₂ ⊗ t₂` in `M_x ⊗ N_x` exactly when the coordinates satisfy the same identity. -/
theorem tmul_eq_tmul_iff_stalkCoord {e : Γ(M, ⊤)} {e' : Γ(N, ⊤)} {x : X}
    (he : x ∈ Stacks.Ample.nonvanishingLocus M e)
    (he' : x ∈ Stacks.Ample.nonvanishingLocus N e') (s₁ s₂ : Γ(M, ⊤)) (t₁ t₂ : Γ(N, ⊤)) :
    (M.presheaf.Γgerm x).hom s₁ ⊗ₜ[X.presheaf.stalk x] (N.presheaf.Γgerm x).hom t₁ =
        (M.presheaf.Γgerm x).hom s₂ ⊗ₜ[X.presheaf.stalk x] (N.presheaf.Γgerm x).hom t₂ ↔
      stalkCoord M he s₁ * stalkCoord N he' t₁ = stalkCoord M he s₂ * stalkCoord N he' t₂ := by
  rw [← stalkCoord_smul_Γgerm he s₁, ← stalkCoord_smul_Γgerm he s₂,
    ← stalkCoord_smul_Γgerm he' t₁, ← stalkCoord_smul_Γgerm he' t₂,
    TensorProduct.smul_tmul_smul, TensorProduct.smul_tmul_smul]
  exact (TensorProduct.bijective_smul_tmul
    (Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus M e he)
    (Stacks.EnriquesSeveriZariski.isStalkBasis_Γgerm_of_mem_nonvanishingLocus N e'
      he')).injective.eq_iff

/-- **The cross-multiplication condition in coordinates**: at a point `x`, two families
cross-multiply exactly when the two-by-two minors of their coordinates vanish. -/
theorem crossMultiplies_at_iff_stalkCoord {ι : Type*} {e : Γ(M, ⊤)} {e' : Γ(N, ⊤)} {x : X}
    (he : x ∈ Stacks.Ample.nonvanishingLocus M e)
    (he' : x ∈ Stacks.Ample.nonvanishingLocus N e') (s : ι → Γ(M, ⊤)) (t : ι → Γ(N, ⊤)) :
    (∀ i j : ι, (M.presheaf.Γgerm x).hom (s i) ⊗ₜ[X.presheaf.stalk x] (N.presheaf.Γgerm x).hom
        (t j) = (M.presheaf.Γgerm x).hom (s j) ⊗ₜ[X.presheaf.stalk x]
          (N.presheaf.Γgerm x).hom (t i)) ↔
      ∀ i j : ι, stalkCoord M he (s i) * stalkCoord N he' (t j) =
        stalkCoord M he (s j) * stalkCoord N he' (t i) :=
  forall₂_congr fun i j => tmul_eq_tmul_iff_stalkCoord he he' _ _ _ _

/-- **Isomorphisms preserve coordinates**: for an isomorphism `β : M ≅ N`, the coordinate of
`β s` relative to `β e` is the coordinate of `s` relative to `e`. -/
theorem stalkCoord_app_hom (β : M ≅ N) {e : Γ(M, ⊤)} {x : X}
    (he : x ∈ Stacks.Ample.nonvanishingLocus M e)
    (he' : x ∈ Stacks.Ample.nonvanishingLocus N (Scheme.Modules.Hom.app β.hom ⊤ e))
    (s : Γ(M, ⊤)) :
    stalkCoord N he' (Scheme.Modules.Hom.app β.hom ⊤ s) = stalkCoord M he s := by
  refine stalkCoord_eq_of_smul_Γgerm _ ?_
  rw [← Stacks.ModuleStalk.mapFun_Γgerm, ← Stacks.ModuleStalk.mapFun_Γgerm,
    ← Stacks.ModuleStalk.mapFun_smul, stalkCoord_smul_Γgerm]

/-- An isomorphism carries a section not vanishing at `x` to one not vanishing at `x`. -/
theorem mem_nonvanishingLocus_app_hom_iff (β : M ≅ N) (s : Γ(M, ⊤)) (x : X) :
    x ∈ Stacks.Ample.nonvanishingLocus N (Scheme.Modules.Hom.app β.hom ⊤ s) ↔
      x ∈ Stacks.Ample.nonvanishingLocus M s := by
  rw [Stacks.Ample.mem_nonvanishingLocus_iff, Stacks.Ample.mem_nonvanishingLocus_iff,
    ← Stacks.ModuleStalk.mapFun_Γgerm]
  exact (not_congr (Stacks.NonvanishingPullback.mem_ideal_smul_top_iff_of_linearEquiv _
    (Stacks.ModuleStalk.equivOfIso β x) _)).symm

end Calculus

section PullbackCoordinate

variable {Y : Scheme.{u}} (f : Y ⟶ X) {M : X.Modules} [Stacks.Ample.IsInvertibleModule X M]

/-- The pullback of a section not vanishing at `f y` does not vanish at `y`. -/
theorem mem_nonvanishingLocus_pullbackGlobalSections {e : Γ(M, ⊤)} {y : Y}
    (he : f y ∈ Stacks.Ample.nonvanishingLocus M e) :
    y ∈ Stacks.Ample.nonvanishingLocus ((Scheme.Modules.pullback f).obj M)
      (pullbackGlobalSections f M e) :=
  Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections f M e he

/-- **Coordinates of pullbacks**: the coordinate at `y` of `f^* s` relative to `f^* e` is the
image under `f^♯ : 𝒪_{X, f y} → 𝒪_{Y, y}` of the coordinate of `s` relative to `e`. -/
theorem stalkCoord_pullbackGlobalSections {e : Γ(M, ⊤)} {y : Y}
    (he : f y ∈ Stacks.Ample.nonvanishingLocus M e) (s : Γ(M, ⊤)) :
    stalkCoord ((Scheme.Modules.pullback f).obj M) (mem_nonvanishingLocus_pullbackGlobalSections
        f he) (pullbackGlobalSections f M s) =
      (f.stalkMap y).hom (stalkCoord M he s) :=
  stalkCoord_eq_of_smul_Γgerm _
    (Γgerm_pullbackGlobalSections_eq_smul f M (stalkCoord_smul_Γgerm he s).symm).symm

end PullbackCoordinate

end Stacks.InvertibleStalk

end
