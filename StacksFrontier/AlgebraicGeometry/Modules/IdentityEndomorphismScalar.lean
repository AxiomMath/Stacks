module

public import Mathlib.Algebra.Category.Grp.EpiMono
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.AlgebraicGeometry.Modules.Sheaf

/-!
# A natural endomorphism of the identity functor is multiplication by a global section

Let `X` be a scheme. An endomorphism `f` of the identity functor of
`SheafOfModules X.ringCatSheaf` is nothing but multiplication by a global section of the
structure sheaf. Indeed the component of `f` at the unit module `𝒪_X` sends `1` to a compatible
family `scalarSection f` of local sections of `𝒪_X`, and this file shows that `f` then acts on
every local section of every module by multiplication by the corresponding local scalar.

This is the converse of `Stacks.SheafOfModules.globalSectionToEnd`, and it is what allows a
result stated for an abstract `f : End (𝟭 (SheafOfModules R))` to be analysed through the ideal
sheaf generated by a genuine global section.

## Main definitions

* `Stacks.SheafOfModules.scalarSection` — the compatible family of local sections of `𝒪_X`
  underlying `f`.
* `Stacks.SheafOfModules.scalarAt` — its value over an open `U`.

## Main results

* `Stacks.SheafOfModules.scalarActionLocal` — `f` acts on `Γ(M, U)` as multiplication by
  `scalarAt f U`.

## Implementation notes

A section `x ∈ Γ(M, U)` need not extend to a global section of `M`, so the statement over `U` is
deduced from the statement for global sections applied to the pushforward along `U ↪ X` of the
restriction of `M` to `U`: the unit of `Scheme.Modules.restrictAdjunction` is injective on
sections over `U`, and `x` becomes a global section of that pushforward. Naturality of `f`
transports the identity back to `M`.

The statement for a global section `p` is in turn obtained by writing `p` as a morphism
`𝒪_X ⟶ M` out of the unit module and using naturality of `f` along it together with linearity.

## References

* [Stacks Project, Tag 0EH9](https://stacks.math.columbia.edu/tag/0EH9)
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

namespace Stacks.SheafOfModules

variable {X : Scheme.{u}}

/-! ### A bridging instance for the scalar action on sections

The module structure on the sections of a module over a scheme is declared for the sections
spelled `Γ(M, U)`, while `PresheafOfModules.sections` spells them through the forgetful functor
to abelian groups; instance search does not identify the two. The instance below is the existing
one restated at the second spelling, so nothing new is assumed. -/

local instance moduleForgetfulSections (M : X.Modules) (U : X.Opens) :
    Module Γ(X, U) ((PresheafOfModules.presheaf ((Scheme.Modules.toPresheafOfModules X).obj M)
      ⋙ forget Ab).obj (op U)) :=
  inferInstanceAs (Module Γ(X, U) Γ(M, U))

/-- The morphism `𝒪_X ⟶ M` of sheaves of modules on a scheme determined by a global section
of `M`. -/
noncomputable def sectionHom (M : X.Modules)
    (p : ((Scheme.Modules.toPresheafOfModules X).obj M).sections) :
    _root_.SheafOfModules.unit X.ringCatSheaf ⟶ M :=
  Scheme.Modules.fullyFaithfulToPresheafOfModules.preimage
    (((Scheme.Modules.toPresheafOfModules X).obj M).unitHomEquiv.symm p)

/-- The morphism determined by a global section sends `1` to that section. -/
theorem sectionHom_app (M : X.Modules)
    (p : ((Scheme.Modules.toPresheafOfModules X).obj M).sections) (U : X.Opens) :
    (Scheme.Modules.Hom.app (sectionHom M p) U)
        (1 : X.ringCatSheaf.obj.obj (.op U)) = p.val (.op U) := by
  have h := ((Scheme.Modules.toPresheafOfModules X).obj M).unitHomEquiv.apply_symm_apply p
  exact congrArg (fun q => q.val (.op U)) h

/-- The compatible family of local sections of `𝒪_X` underlying a natural endomorphism of the
identity functor: the image of `1` under the component of `f` at the unit module. -/
noncomputable def scalarSection (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf))) :
    (_root_.SheafOfModules.unit X.ringCatSheaf).sections :=
  (_root_.SheafOfModules.unit X.ringCatSheaf).unitHomEquiv
    (f.app (_root_.SheafOfModules.unit X.ringCatSheaf))

/-- The local scalar by which a natural endomorphism of the identity functor acts over an
open `U`. -/
noncomputable def scalarAt (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf)))
    (U : X.Opens) : Γ(X, U) := (scalarSection f).val (.op U)

/-- The local scalar is the image of `1` under the component of `f` at the unit module. -/
theorem scalarAt_apply (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf))) (U : X.Opens) :
    scalarAt f U = (f.app (_root_.SheafOfModules.unit X.ringCatSheaf)).val.app (.op U)
      (1 : X.ringCatSheaf.obj.obj (.op U)) := rfl

/-- The local scalars of a natural endomorphism are compatible with restriction. -/
theorem scalarAt_res (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf)))
    {U V : X.Opens} (i : V ⟶ U) :
    scalarAt f V = X.presheaf.map i.op (scalarAt f U) :=
  ((scalarSection f).property i.op).symm

/-- A natural endomorphism of the identity functor commutes with the maps on sections induced by
any morphism of modules. -/
private theorem app_naturality (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf)))
    {M N : X.Modules} (α : M ⟶ N) (U : X.Opens) (x : Γ(M, U)) :
    (Scheme.Modules.Hom.app (f.app N) U) ((Scheme.Modules.Hom.app α U) x) =
      (Scheme.Modules.Hom.app α U) ((Scheme.Modules.Hom.app (f.app M) U) x) := by
  have h : α ≫ f.app N = f.app M ≫ α := f.naturality α
  exact congrArg (fun q => (Scheme.Modules.Hom.app q U) x) h

/-- On a global section of `M`, a natural endomorphism of the identity functor acts as
multiplication by the local scalar. -/
theorem scalarActionGlobal (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf)))
    (M : X.Modules) (p : ((Scheme.Modules.toPresheafOfModules X).obj M).sections)
    (U : X.Opens) :
    (Scheme.Modules.Hom.app (f.app M) U) (p.val (.op U)) =
      scalarAt f U • p.val (.op U) := by
  have h := app_naturality f (sectionHom M p) U
    (1 : X.ringCatSheaf.obj.obj (.op U))
  rw [sectionHom_app] at h
  rw [h]
  let r : X.ringCatSheaf.obj.obj (.op U) := scalarAt f U
  have hlin := (((Scheme.Modules.toPresheafOfModules X).map (sectionHom M p)).app
    (.op U)).hom.map_smul r (1 : X.ringCatSheaf.obj.obj (.op U))
  have hone : r • (1 : X.ringCatSheaf.obj.obj (.op U)) = r := by
    simp only [smul_eq_mul, mul_one]
  exact (congrArg _ hone.symm).trans (hlin.trans (congrArg (r • ·) (sectionHom_app M p U)))

/-- A section of `M` over `U`, viewed as a global section of the pushforward along `U ↪ X` of
the restriction of `M` to `U`. -/
noncomputable def pushedSection (M : X.Modules) (U : X.Opens) (x : Γ(M, U)) :
    (((Scheme.Modules.toPresheafOfModules X).obj
      ((Scheme.Modules.pushforward U.ι).obj
        ((Scheme.Modules.restrictFunctor U.ι).obj M))).sections) := by
  let j : U.toScheme ⟶ X := U.ι
  let MU : U.toScheme.Modules := (Scheme.Modules.restrictFunctor j).obj M
  let N : X.Modules := (Scheme.Modules.pushforward j).obj MU
  let P := (Scheme.Modules.toPresheafOfModules X).obj N
  have hsub (V : X.Opens) : j ''ᵁ (j ⁻¹ᵁ V) ≤ U := by
    change U.ι ''ᵁ (U.ι ⁻¹ᵁ V) ≤ U
    calc U.ι ''ᵁ (U.ι ⁻¹ᵁ V) ≤ U.ι ''ᵁ ⊤ := U.ι.image_mono le_top
      _ = U := U.ι_image_top
  refine P.sectionsMk (fun V => ?_) ?_
  · exact M.presheaf.map (homOfLE (hsub V.unop)).op x
  · intro V W i
    have hpre : j ⁻¹ᵁ W.unop ≤ j ⁻¹ᵁ V.unop := j.preimage_mono (leOfHom i.unop)
    have himage : j ''ᵁ (j ⁻¹ᵁ W.unop) ≤ j ''ᵁ (j ⁻¹ᵁ V.unop) := j.image_mono hpre
    have hmap : M.presheaf.map (homOfLE (hsub V.unop)).op ≫
        M.presheaf.map (homOfLE himage).op =
      M.presheaf.map (homOfLE (hsub W.unop)).op := by
      rw [← Functor.map_comp]
      congr 1
    exact congrArg (fun g => g x) hmap

/-- Over `U` itself, the pushed section is the image of `x` under the unit of the
restriction adjunction. -/
theorem pushedSection_unit (M : X.Modules) (U : X.Opens) (x : Γ(M, U)) :
    (pushedSection M U x).val (.op U) =
      (((Scheme.Modules.restrictAdjunction U.ι).unit.app M).app U) x := by
  simp [pushedSection, Scheme.Modules.restrictAdjunction_unit_app_app]
  rfl

/-- A natural endomorphism of the identity functor acts on any local section as multiplication
by the local scalar. -/
theorem scalarActionLocal (f : End (𝟭 (_root_.SheafOfModules X.ringCatSheaf)))
    (M : X.Modules) (U : X.Opens) (x : Γ(M, U)) :
    (Scheme.Modules.Hom.app (f.app M) U) x = scalarAt f U • x := by
  let η := (Scheme.Modules.restrictAdjunction U.ι).unit.app M
  let N : X.Modules := (Scheme.Modules.restrictFunctor U.ι ⋙
    Scheme.Modules.pushforward U.ι).obj M
  let p := pushedSection M U x
  have hp : p.val (.op U) = (η.app U) x := pushedSection_unit M U x
  have hglob := scalarActionGlobal f N p U
  have hnat' := app_naturality f η U x
  have hglob'' : (Scheme.Modules.Hom.app (f.app N) U) ((Scheme.Modules.Hom.app η U) x) =
      scalarAt f U • ((Scheme.Modules.Hom.app η U) x) := by
    rwa [hp] at hglob
  have hη : Function.Injective (Scheme.Modules.Hom.app η U) := by
    intro a b hab
    have hs : U.ι ''ᵁ U.ι ⁻¹ᵁ U = U := by
      rw [U.ι.image_preimage_eq_opensRange_inf]
      simp
    have hmor : homOfLE (U.ι.image_preimage_le U) = eqToHom hs := Subsingleton.elim _ _
    have hmapiso : IsIso (M.presheaf.map (homOfLE (U.ι.image_preimage_le U)).op) := by
      rw [hmor]
      infer_instance
    have hmapmono : Mono (M.presheaf.map (homOfLE (U.ι.image_preimage_le U)).op) := inferInstance
    have hinj : Function.Injective
        (M.presheaf.map (homOfLE (U.ι.image_preimage_le U)).op) :=
      (AddCommGrpCat.mono_iff_injective _).mp hmapmono
    exact hinj (congrArg (M.restrictAppIso U.ι (U.ι ⁻¹ᵁ U)).hom hab)
  apply hη
  calc
    (Scheme.Modules.Hom.app η U) ((Scheme.Modules.Hom.app (f.app M) U) x) =
        (Scheme.Modules.Hom.app (f.app N) U) ((Scheme.Modules.Hom.app η U) x) := hnat'.symm
    _ = scalarAt f U • ((Scheme.Modules.Hom.app η U) x) := hglob''
    _ = (Scheme.Modules.Hom.app η U) (scalarAt f U • x) :=
        (((Scheme.Modules.toPresheafOfModules X).map η |>.app (.op U)).hom.map_smul
          (scalarAt f U) x).symm

end Stacks.SheafOfModules
