module

public import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Scheme.Separation.DoubledOrigin

/-!
# An open immersion which is not quasi-compact

Over a field `k`, the complement of the origin in the spectrum of the polynomial ring
`k[X₀, X₁, …]` is an open subscheme whose inclusion is not quasi-compact.

## Main results

* `AlgebraicGeometry.puncturedInfiniteAffineSpace_carrier`: the open subscheme is the complement
  of the point corresponding to the ideal generated by all the variables.
* `AlgebraicGeometry.puncturedInfiniteAffineSpace_ι_not_quasiCompact`: its inclusion is not
  quasi-compact.

## Implementation notes

The open subscheme is the union of the basic opens `D(Xᵢ)`. Its inclusion is an open immersion
by the general instance for `Scheme.Opens.ι`. The first result identifies this union with the
punctured spectrum of the source; the second is the counterexample to quasi-compactness of open
immersions.

## References

* [Stacks Project, Tag 01K8](https://stacks.math.columbia.edu/tag/01K8)
-/

public section

namespace AlgebraicGeometry

universe u

/-- The ideal generated by all the variables is the kernel of evaluation at the origin. -/
private lemma span_range_X_eq_ker_constantCoeff (k : Type u) [Field k] :
    Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) =
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial ℕ k →+* k) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp
  · intro f hf
    rw [RingHom.mem_ker] at hf
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hmne : m ≠ 0 := by
      rintro rfl
      simp_all [MvPolynomial.mem_support_iff, MvPolynomial.constantCoeff_eq]
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hmne
    exact ⟨i, Set.mem_univ _, hi⟩

/-- The ideal generated by all the variables is maximal. -/
private lemma span_range_X_isMaximal (k : Type u) [Field k] :
    (Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k))).IsMaximal := by
  rw [span_range_X_eq_ker_constantCoeff]
  exact RingHom.ker_isMaximal_of_surjective _ (fun a => ⟨MvPolynomial.C a, by simp⟩)

/-- A point lies in the basic open of `Xᵢ` exactly when its prime does not contain `Xᵢ`. -/
private lemma mem_basicOpen_X_iff (k : Type u) [Field k] (p : infiniteAffineSpace k) (i : ℕ) :
    p ∈ (infiniteAffineSpace k).basicOpen
        ((Scheme.ΓSpecIso (.of (MvPolynomial ℕ k))).inv (MvPolynomial.X i)) ↔
      MvPolynomial.X i ∉ p.asIdeal := by
  rw [basicOpen_eq_of_affine]
  exact PrimeSpectrum.mem_basicOpen _ _

/-- A prime equal to the ideal generated by all the variables contains each variable. -/
private lemma X_mem_asIdeal_of_eq_span (k : Type u) [Field k] {p : PrimeSpectrum (MvPolynomial ℕ k)}
    (heq : p.asIdeal = Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k))) (i : ℕ) :
    MvPolynomial.X i ∈ p.asIdeal :=
  heq ▸ Ideal.subset_span ⟨i, rfl⟩

/-- The union of the coordinate basic opens is precisely the complement of the origin. -/
@[stacks 01K8 "the punctured spectrum"]
public theorem puncturedInfiniteAffineSpace_carrier (k : Type u) [Field k] :
    (puncturedInfiniteAffineSpace k : Set (infiniteAffineSpace k)) =
      {p : PrimeSpectrum (MvPolynomial ℕ k) |
        p.asIdeal ≠ Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k))} := by
  classical
  ext p
  simp only [puncturedInfiniteAffineSpace, TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
  constructor
  · rintro ⟨i, hi⟩ heq
    exact (mem_basicOpen_X_iff k p i).mp hi (X_mem_asIdeal_of_eq_span k heq i)
  · intro hne
    by_contra h
    exact hne ((span_range_X_isMaximal k).eq_of_le p.isPrime.ne_top
      (Ideal.span_le.mpr (Set.range_subset_iff.mpr fun i =>
        not_not.mp fun hi => h ⟨i, (mem_basicOpen_X_iff k p i).mpr hi⟩))).symm

/-- The open immersion of the punctured infinite-dimensional affine space is not
quasi-compact. -/
@[stacks 01K8 "not quasi-compact"]
public theorem puncturedInfiniteAffineSpace_ι_not_quasiCompact (k : Type u) [Field k] :
    ¬ QuasiCompact (puncturedInfiniteAffineSpace k).ι := by
  classical
  let U := puncturedInfiniteAffineSpace k
  let X := infiniteAffineSpace k
  intro hqc
  have hcompact : IsCompact (Set.univ : Set U.toScheme) := by
    simpa [U, X] using hqc.isCompact_preimage (Set.univ : Set X) isOpen_univ isCompact_univ
  let D : ℕ → X.Opens := fun i =>
    X.basicOpen ((Scheme.ΓSpecIso (.of (MvPolynomial ℕ k))).inv (MvPolynomial.X i))
  let B : ℕ → Set U.toScheme := fun i => Subtype.val ⁻¹' (D i : Set X)
  have hopen : ∀ i, IsOpen (B i) := fun i => (D i).isOpen.preimage continuous_subtype_val
  have hcover : (Set.univ : Set U.toScheme) ⊆ ⋃ i, B i := fun x _ =>
    Set.mem_iUnion.mpr (TopologicalSpace.Opens.mem_iSup.mp x.2)
  obtain ⟨s, hs⟩ := hcompact.elim_finite_subcover B hopen hcover
  obtain ⟨j, -, hj⟩ := Set.infinite_univ.exists_notMem_finset s
  let ev : MvPolynomial ℕ k →+* k :=
    MvPolynomial.eval₂Hom (RingHom.id k) (fun i => if i ∈ s then 0 else 1)
  let p : PrimeSpectrum (MvPolynomial ℕ k) :=
    ⟨RingHom.ker ev, RingHom.ker_isPrime ev⟩
  have hpne : p.asIdeal ≠ Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) := by
    intro heq
    have hzero : ev (MvPolynomial.X j) = 0 :=
      RingHom.mem_ker.mp (X_mem_asIdeal_of_eq_span k heq j)
    simp [ev, hj] at hzero
  have hpU : p ∈ (U : Set X) := by
    simpa [U] using (puncturedInfiniteAffineSpace_carrier k ▸ hpne)
  obtain ⟨i, his, hpi⟩ := Set.mem_iUnion₂.mp (hs (Set.mem_univ (⟨p, hpU⟩ : U.toScheme)))
  change p ∈ (D i : Set X) at hpi
  exact (mem_basicOpen_X_iff k p i).mp hpi (RingHom.mem_ker.mpr (by simp [ev, his]))

end AlgebraicGeometry

end
