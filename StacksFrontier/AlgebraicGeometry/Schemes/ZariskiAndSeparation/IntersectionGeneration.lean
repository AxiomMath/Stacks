module

public import Mathlib.AlgebraicGeometry.Limits
public import StacksFrontier.AlgebraicGeometry.Schemes.ZariskiAndSeparation.Separated
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Sections over an intersection of affine opens are generated by sections over the pieces

For a separated scheme `X` and finitely many affine opens `U_0, …, U_n`, the ring of sections
`Γ(X, U_0 ∩ ⋯ ∩ U_n)` is generated, as a subring, by the images of the restriction maps from the
`Γ(X, U_j)`.

For two opens this is a reformulation of the surjectivity of the multiplication map
`Γ(X, U) ⊗_ℤ Γ(X, V) → Γ(X, U ∩ V)`, which is
`AlgebraicGeometry.sectionTensorMap_surjective_of_isSeparated` — part (1)(b) of
[Stacks, Tag 01KP] — read through
`Algebra.TensorProduct.closure_range_union_range_eq_top`, the statement that a tensor product is
generated by its two factors. The general case is the induction on the number of opens, each
step applying the two-open case to `(U_0 ∩ ⋯ ∩ U_{n-1}, U_n)`; the left factor is affine by
`AlgebraicGeometry.IsAffineOpen.iInf`.

## Main definitions

* `AlgebraicGeometry.sectionsRestrict` — the restriction map `Γ(X, U) → Γ(X, V)` for `V ≤ U`, as a
  ring homomorphism.

## Main results

* `AlgebraicGeometry.closure_range_union_range_sectionsRestrict_eq_top_of_isSeparated` — the
  two-open statement for a separated morphism, with the opens affine over an affine open of the
  base.
* `AlgebraicGeometry.closure_range_union_range_sectionsRestrict_eq_top` — the two-open statement
  for a separated scheme.
* `AlgebraicGeometry.closure_iUnion_range_sectionsRestrict_eq_top` — **the statement for any
  finite nonempty family of affine opens of a separated scheme**.

## Implementation notes

Each of the three takes the intersection as a separate open `Y` together with the equation
identifying it, rather than writing `U ⊓ V` or `⨅ j, U j` in the conclusion. The equation
determines `Y`, and this form lets the induction step apply the two-open case at
`Y := ⨅ j, U j` without transporting sections along an equality of opens.

## References

* [Stacks Project, Tag 01KP](https://stacks.math.columbia.edu/tag/01KP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open scoped TensorProduct

namespace AlgebraicGeometry

universe u

variable {X : Scheme.{u}}

/-- **The restriction map `Γ(X, U) → Γ(X, V)` on sections** of a scheme, for `V ≤ U`, as a ring
homomorphism. -/
abbrev sectionsRestrict {U V : X.Opens} (h : V ≤ U) : Γ(X, U) →+* Γ(X, V) :=
  (X.presheaf.map (homOfLE h).op).hom

/-- Restriction maps compose. -/
theorem sectionsRestrict_comp {U V W : X.Opens} (h₁ : V ≤ U) (h₂ : W ≤ V) (x : Γ(X, U)) :
    sectionsRestrict h₂ (sectionsRestrict h₁ x) = sectionsRestrict (h₂.trans h₁) x := by
  have h : X.presheaf.map (homOfLE h₁).op ≫ X.presheaf.map (homOfLE h₂).op =
      X.presheaf.map (homOfLE (h₂.trans h₁)).op := by
    rw [← X.presheaf.map_comp, ← op_comp, homOfLE_comp]
  exact congrArg (fun k : Γ(X, U) ⟶ Γ(X, W) => k.hom x) h

/-- **Restriction between two opens that are equal is surjective** — it is the identity. -/
theorem surjective_sectionsRestrict_of_eq {U V : X.Opens} (he : U = V) (h : V ≤ U) :
    Function.Surjective (sectionsRestrict h) := by
  subst he
  have h0 : (homOfLE h : U ⟶ U) = 𝟙 U := homOfLE_refl h
  have hid : (X.presheaf.map (homOfLE h).op).hom = RingHom.id Γ(X, U) := by
    rw [h0, op_id, X.presheaf.map_id]
    rfl
  rw [show sectionsRestrict h = (X.presheaf.map (homOfLE h).op).hom from rfl, hid]
  exact Function.surjective_id

/-- **Sections over the intersection of two affine opens are generated by the sections over the
two**, for a separated morphism `f` and opens affine over an affine open of the base.

This is part (1)(b) of [Stacks, Tag 01KP] —
`AlgebraicGeometry.sectionTensorMap_surjective_of_isSeparated` — read through the statement that
a tensor product is generated as a ring by its two factors. -/
@[ega "I 5.5.6" "necessity"]
theorem closure_range_union_range_sectionsRestrict_eq_top_of_isSeparated
    {S : Scheme.{u}} (f : X ⟶ S) [IsSeparated f] (U V : X.Opens)
    (hU : IsAffineOpen U) (hV : IsAffineOpen V) (W : S.Opens) (hW : IsAffineOpen W)
    (hUW : U ≤ f ⁻¹ᵁ W) (hVW : V ≤ f ⁻¹ᵁ W)
    {Y : X.Opens} (hY : Y = U ⊓ V) (hYU : Y ≤ U) (hYV : Y ≤ V) :
    Subring.closure (Set.range (sectionsRestrict hYU) ∪ Set.range (sectionsRestrict hYV)) = ⊤ := by
  subst hY
  have hsurj := sectionTensorMap_surjective_of_isSeparated f U V hU hV W hW hUW hVW
  refine eq_top_iff.mpr fun x hx => ?_
  clear hx
  obtain ⟨z, rfl⟩ := hsurj x
  induction z with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul a b =>
    have h : sectionTensorMap X U V (a ⊗ₜ b) =
        sectionsRestrict (inf_le_left : U ⊓ V ≤ U) a *
          sectionsRestrict (inf_le_right : U ⊓ V ≤ V) b := by
      simp [sectionTensorMap]
    rw [h]
    exact mul_mem (Subring.subset_closure (Or.inl ⟨a, rfl⟩))
      (Subring.subset_closure (Or.inr ⟨b, rfl⟩))
  | add z w hz hw => rw [map_add]; exact add_mem hz hw

/-- **Sections over the intersection of two affine opens of a separated scheme are generated by
the sections over the two.** -/
theorem closure_range_union_range_sectionsRestrict_eq_top [X.IsSeparated] (U V : X.Opens)
    (hU : IsAffineOpen U) (hV : IsAffineOpen V)
    {Y : X.Opens} (hY : Y = U ⊓ V) (hYU : Y ≤ U) (hYV : Y ≤ V) :
    Subring.closure (Set.range (sectionsRestrict hYU) ∪ Set.range (sectionsRestrict hYV)) = ⊤ :=
  closure_range_union_range_sectionsRestrict_eq_top_of_isSeparated (terminal.from X) U V hU hV
    ⊤ (isAffineOpen_top _) le_top le_top hY hYU hYV

/-- A restricted section lies in the subring generated by the restrictions of all the families. -/
private theorem sectionsRestrict_mem_closure_iUnion {ι : Type*} {U : ι → X.Opens} {Y : X.Opens}
    (hYU : ∀ j, Y ≤ U j) (j : ι) (w : Γ(X, U j)) :
    sectionsRestrict (hYU j) w ∈ Subring.closure (⋃ j, Set.range (sectionsRestrict (hYU j))) :=
  Subring.subset_closure (Set.mem_iUnion.mpr ⟨j, w, rfl⟩)

/-- **Sections over the intersection of a finite nonempty family of affine opens of a separated
scheme are generated by the sections over the members of the family.**

The induction on the number of opens: the step applies
`AlgebraicGeometry.closure_range_union_range_sectionsRestrict_eq_top` to the pair consisting of
the intersection of the first `n` opens — affine by `AlgebraicGeometry.IsAffineOpen.iInf` — and
the last one, and then rewrites the generators of the left factor using the inductive
hypothesis. -/
theorem closure_iUnion_range_sectionsRestrict_eq_top [X.IsSeparated] :
    ∀ (n : ℕ) (U : Fin (n + 1) → X.Opens), (∀ j, IsAffineOpen (U j)) →
      ∀ (Y : X.Opens), Y = ⨅ j, U j → ∀ hYU : ∀ j, Y ≤ U j,
        Subring.closure (⋃ j, Set.range (sectionsRestrict (hYU j))) = ⊤ := by
  intro n
  induction n with
  | zero =>
    intro U _ Y hY hYU
    have hY0 : Y = U 0 := by
      rw [hY]
      exact le_antisymm (iInf_le _ 0) (le_iInf (Fin.cases le_rfl fun i => i.elim0))
    have hsurj := surjective_sectionsRestrict_of_eq hY0.symm (hYU 0)
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨y, rfl⟩ := hsurj x
    exact sectionsRestrict_mem_closure_iUnion hYU 0 y
  | succ n ih =>
    intro U hU Y hY hYU
    set U' : Fin (n + 1) → X.Opens := fun j => U j.castSucc with hU'def
    set Y' : X.Opens := ⨅ j, U' j with hY'def
    have hU'aff : ∀ j, IsAffineOpen (U' j) := fun j => hU _
    have hY'aff : IsAffineOpen Y' := IsAffineOpen.iInf hU'aff
    have hYY' : Y ≤ Y' := hY ▸ le_iInf fun j => iInf_le _ j.castSucc
    have hsplit : Y = Y' ⊓ U (Fin.last (n + 1)) := by
      rw [hY, hY'def]
      refine le_antisymm (le_inf (le_iInf fun j => iInf_le _ _) (iInf_le _ _)) (le_iInf ?_)
      refine Fin.lastCases inf_le_right fun j => ?_
      exact inf_le_left.trans (iInf_le _ j)
    have h2 := closure_range_union_range_sectionsRestrict_eq_top Y' (U (Fin.last (n + 1)))
      hY'aff (hU _) hsplit hYY' (hYU _)
    have ih' := ih U' hU'aff Y' rfl (fun j => iInf_le _ j)
    refine eq_top_iff.mpr ?_
    rw [← h2, Subring.closure_le]
    rintro x (⟨y, rfl⟩ | ⟨y, rfl⟩)
    · have hy : y ∈ Subring.closure (⋃ j, Set.range (sectionsRestrict (iInf_le U' j))) :=
        ih' ▸ Subring.mem_top y
      have hsub : (⋃ j, Set.range (sectionsRestrict (iInf_le U' j))) ⊆
          ↑((Subring.closure (⋃ j, Set.range (sectionsRestrict (hYU j)))).comap
            (sectionsRestrict hYY')) := by
        rintro z hz
        obtain ⟨j, w, rfl⟩ := Set.mem_iUnion.mp hz
        rw [SetLike.mem_coe, Subring.mem_comap, sectionsRestrict_comp]
        exact sectionsRestrict_mem_closure_iUnion hYU j.castSucc w
      exact Subring.mem_comap.mp (Subring.closure_le.mpr hsub hy)
    · exact sectionsRestrict_mem_closure_iUnion hYU _ y

end AlgebraicGeometry

end
