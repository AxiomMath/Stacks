module

public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.ClosedSubspaceExistence
public import StacksFrontier.AlgebraicGeometry.Schemes.ClosedImmersions.FactorizationExistence

/-!
# Tag 01HP for the closed subspace cut out by a locally generated ideal sheaf

Let `X` and `Y` be locally ringed spaces and let `j : J ⟶ 𝒪_X` be a monomorphism of sheaves of
modules exhibiting `J` as a sheaf of ideals which is locally generated by sections. The closed
subspace `i : Z ⟶ X` associated to `J` then exists, and a morphism `f : Y ⟶ X` factors through
`i` exactly when the canonical map `f^* J ⟶ 𝒪_Y` vanishes; such a factorization is unique.

## Main results

* `Stacks.ClosedImmersion.factorsThrough_closedSubspace_of_localGenerators_iff`: the
  factorization criterion.
* `Stacks.ClosedImmersion.subsingleton_factorizations_closedSubspace_of_localGenerators`: the
  uniqueness of the factorization.

## Implementation notes

The mathematics is `Stacks.ClosedImmersion.factorsThrough_closedSubspace_iff` and
`Stacks.ClosedImmersion.subsingleton_factorizations_closedSubspace`, both of which take as a
hypothesis the data `Stacks.ClosedImmersion.ClosedSubspaceData` of the associated closed
subspace. This file records the two statements in the shape Tag 01HP has them: the hypothesis is
that `J` is locally generated by sections, and the closed subspace is the one Tag 01HN produces
from that hypothesis, `Stacks.ClosedImmersion.closedSubspace`. Nothing is reproved; the point is
that neither statement presupposes the existence of the closed subspace.

## References

* [Stacks Project, Tag 01HN](https://stacks.math.columbia.edu/tag/01HN)
* [Stacks Project, Tag 01HP](https://stacks.math.columbia.edu/tag/01HP)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.ClosedImmersion

/-- A morphism `f : Y ⟶ X` of locally ringed spaces factors through the closed subspace cut out
by a sheaf of ideals `j : J ⟶ 𝒪_X` which is locally generated by sections exactly when the
canonical map `f^* J ⟶ 𝒪_Y` vanishes. -/
@[stacks 01HP "factorization criterion"]
theorem factorsThrough_closedSubspace_of_localGenerators_iff {X Y : LocallyRingedSpace.{u}}
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) [Mono j]
    (hJ : Nonempty (SheafOfModules.LocalGeneratorsData.{u} J)) (f : Y ⟶ X) :
    (∃ g : Y ⟶ (closedSubspace X J j hJ).space,
        g ≫ (closedSubspace X J j hJ).inclusion = f) ↔ pullbackIdealMap f J j = 0 :=
  factorsThrough_closedSubspace_iff (closedSubspace X J j hJ) f

/-- A factorization of a morphism of locally ringed spaces through the closed subspace cut out by
a sheaf of ideals which is locally generated by sections, when it exists, is unique. -/
@[stacks 01HP "uniqueness"]
theorem subsingleton_factorizations_closedSubspace_of_localGenerators
    {X Y : LocallyRingedSpace.{u}}
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) [Mono j]
    (hJ : Nonempty (SheafOfModules.LocalGeneratorsData.{u} J)) (f : Y ⟶ X) :
    Subsingleton {g : Y ⟶ (closedSubspace X J j hJ).space //
      g ≫ (closedSubspace X J j hJ).inclusion = f} :=
  subsingleton_factorizations_closedSubspace J j (closedSubspace X J j hJ) f

end Stacks.ClosedImmersion

end
