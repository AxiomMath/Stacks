module

public import StacksFrontier.AlgebraicGeometry.SegreEmbedding.SegreRing
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.Order.Filter.AtTopBot.Basic

/-!
# The Segre presentation: the polynomial ring on `X × Y` surjects onto the Segre product

The Segre product `Stacks.RingTheory.SegreProduct.segre R X Y` of the two polynomial rings
`R[x_i]` and `R[y_j]` is generated by the products `x_i * y_j`. This file defines the graded ring
homomorphism from the polynomial ring on `X × Y` sending the variable `z_{ij}` to `x_i * y_j`,
and shows that it is surjective in every degree.

## Main definitions

* `Stacks.RingTheory.SegreProduct.gen`: the generator `x_i * y_j` attached to a pair `(i, j)`.
* `Stacks.RingTheory.SegreProduct.presentationAlgHom`: the algebra homomorphism from the
  polynomial ring on `X × Y` to the Segre product sending `z_{ij}` to `x_i * y_j`.
* `Stacks.RingTheory.SegreProduct.presentation`: the same map as a graded ring homomorphism, from
  the total-degree grading to `Stacks.RingTheory.SegreProduct.grading R X Y`.

## Main results

* `Stacks.RingTheory.SegreProduct.exists_list_prod_eq_monomial`: a monomial of degree `d` in the
  `x` variables and degree `d` in the `y` variables is a product of exactly `d` generators.
* `Stacks.RingTheory.SegreProduct.surjective_gradedAddHom`: the presentation is surjective in
  every degree.
* `Stacks.RingTheory.SegreProduct.eventually_surjective_gradedAddHom`: the presentation is
  surjective in all sufficiently large degrees.
-/

@[expose] public section

open MvPolynomial Finsupp

namespace Stacks.RingTheory.SegreProduct

/-- In a commutative additive monoid, `a + b + g = g + b + a`. -/
public theorem add_add_eq_right_comm {M : Type*} [AddCommMonoid M] (a b g : M) :
    a + b + g = g + b + a := by
  rw [add_comm a b, add_comm (b + a) g, ← add_assoc]

variable (R : Type*) [CommRing R] (X Y : Type*)

/-! ### The generators -/

/-- The generator of the Segre product attached to a pair of variables: the product `x_i * y_j`. -/
public noncomputable def gen (p : X × Y) : MvPolynomial (X ⊕ Y) R :=
  MvPolynomial.X (Sum.inl p.1) * MvPolynomial.X (Sum.inr p.2)

/-- The generator attached to `p` is `X (Sum.inl p.1) * X (Sum.inr p.2)`. -/
public theorem gen_eq (p : X × Y) :
    gen R X Y p =
      MvPolynomial.X (Sum.inl p.1) * MvPolynomial.X (Sum.inr p.2) :=
  rfl

/-- Each generator lies in the degree-one piece of the Segre product. -/
public theorem gen_mem (p : X × Y) : gen R X Y p ∈ gradePiece R X Y 1 := by
  rw [gen_eq]
  refine ⟨?_, ?_⟩
  · simpa using (isWeightedHomogeneous_X R (weightLeft X Y) (Sum.inl p.1)).mul
      (isWeightedHomogeneous_X R (weightLeft X Y) (Sum.inr p.2))
  · simpa using (isWeightedHomogeneous_X R (weightRight X Y) (Sum.inl p.1)).mul
      (isWeightedHomogeneous_X R (weightRight X Y) (Sum.inr p.2))

/-- Each generator lies in the Segre product. -/
public theorem gen_mem_segre (p : X × Y) : gen R X Y p ∈ segre R X Y :=
  mem_segre_of_mem_gradePiece R X Y (gen_mem R X Y p)

/-- The generator attached to `(i, j)` is the monomial with exponent
`single (Sum.inl i) 1 + single (Sum.inr j) 1` and coefficient `1`. -/
public theorem gen_eq_monomial (i : X) (j : Y) :
    gen R X Y (i, j) =
      monomial (Finsupp.single (Sum.inl i) 1 + Finsupp.single (Sum.inr j) 1) (1 : R) := by
  rw [gen_eq, MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul]

/-! ### Peeling off one variable from each group -/

/-- If the weight of `α` is nonzero, some variable of nonzero weight occurs in `α`. -/
private theorem exists_ne_zero_of_weight_ne_zero {σ : Type*} (w : σ → ℕ) {α : σ →₀ ℕ}
    (h : weight w α ≠ 0) : ∃ k, α k ≠ 0 ∧ w k ≠ 0 := by
  by_contra hcon
  refine h ?_
  rw [Finsupp.weight_apply, Finsupp.sum]
  exact Finset.sum_eq_zero fun k hk => by
    by_cases hw : w k = 0 <;> simp_all

/-- If the weight of `α` in the `x` variables is nonzero, some `x` variable occurs in `α`. -/
public theorem exists_inl_of_weightLeft_ne_zero {α : (X ⊕ Y) →₀ ℕ}
    (h : weight (weightLeft X Y) α ≠ 0) : ∃ i : X, α (Sum.inl i) ≠ 0 := by
  obtain ⟨k | j, hk, hw⟩ := exists_ne_zero_of_weight_ne_zero _ h
  · exact ⟨k, hk⟩
  · simp at hw

/-- If the weight of `α` in the `y` variables is nonzero, some `y` variable occurs in `α`. -/
public theorem exists_inr_of_weightRight_ne_zero {α : (X ⊕ Y) →₀ ℕ}
    (h : weight (weightRight X Y) α ≠ 0) : ∃ j : Y, α (Sum.inr j) ≠ 0 := by
  obtain ⟨i | k, hk, hw⟩ := exists_ne_zero_of_weight_ne_zero _ h
  · simp at hw
  · exact ⟨k, hk⟩

/-! ### A monomial of the degree-`d` piece is a product of `d` generators -/

/-- A monomial of degree `d` in the `x` variables and degree `d` in the `y` variables is the
product of a list of exactly `d` generators. -/
public theorem exists_list_prod_eq_monomial (d : ℕ) :
    ∀ α : (X ⊕ Y) →₀ ℕ, weight (weightLeft X Y) α = d → weight (weightRight X Y) α = d →
      ∃ l : List (X × Y), l.length = d ∧
        (monomial α (1 : R) : MvPolynomial (X ⊕ Y) R) = (l.map (gen R X Y)).prod := by
  classical
  induction d with
  | zero =>
    intro α hL hR
    have hα : α = 0 := by
      refine Finsupp.ext fun k => ?_
      cases k with
      | inl i => simpa [hL] using Finsupp.le_weight (weightLeft X Y) (s := Sum.inl i) (by simp) α
      | inr j => simpa [hR] using Finsupp.le_weight (weightRight X Y) (s := Sum.inr j) (by simp) α
    exact ⟨[], rfl, by simp [hα]⟩
  | succ n ih =>
    intro α hL hR
    obtain ⟨i, hi⟩ := exists_inl_of_weightLeft_ne_zero X Y (by rw [hL]; exact Nat.succ_ne_zero n)
    obtain ⟨j, hj⟩ := exists_inr_of_weightRight_ne_zero X Y (by rw [hR]; exact Nat.succ_ne_zero n)
    have hjβ : ((α - Finsupp.single (Sum.inl i) 1 : (X ⊕ Y) →₀ ℕ)) (Sum.inr j) ≠ 0 := by
      rw [Finsupp.tsub_apply, Finsupp.single_eq_of_ne (by simp)]
      simpa using hj
    have hsub : ∀ (w : X ⊕ Y → ℕ) (β : (X ⊕ Y) →₀ ℕ) (k : X ⊕ Y), β k ≠ 0 →
        weight w (β - Finsupp.single k 1) = weight w β - w k := fun w β k hk => by
      have := Finsupp.weight_sub_single_add (w := w) hk
      omega
    obtain ⟨l, hlen, hl⟩ := ih _
      (by rw [hsub _ _ _ hjβ, hsub _ _ _ hi, hL]; simp)
      (by rw [hsub _ _ _ hjβ, hsub _ _ _ hi, hR]; simp)
    have hαeq : (Finsupp.single (Sum.inl i) (1 : ℕ) + Finsupp.single (Sum.inr j) 1) +
        (α - Finsupp.single (Sum.inl i) 1 - Finsupp.single (Sum.inr j) 1) = α := by
      rw [add_add_eq_right_comm, Finsupp.sub_add_single_one_cancel hjβ,
        Finsupp.sub_add_single_one_cancel hi]
    refine ⟨(i, j) :: l, by simp [hlen], ?_⟩
    rw [List.map_cons, List.prod_cons, ← hl, gen_eq_monomial, MvPolynomial.monomial_mul_monomial,
      one_mul, hαeq]

/-! ### The presentation -/

/-- The Segre presentation as an algebra homomorphism: the polynomial ring on `X × Y` mapped to
the Segre product by `z_{ij} ↦ x_i * y_j`. -/
public noncomputable def presentationAlgHom :
    MvPolynomial (X × Y) R →ₐ[R] segre R X Y :=
  MvPolynomial.aeval fun p : X × Y => (⟨gen R X Y p, gen_mem_segre R X Y p⟩ : segre R X Y)

/-- Composed with the inclusion of the Segre product, the presentation is
`MvPolynomial.aeval (gen R X Y)`. -/
public theorem val_comp_presentationAlgHom :
    (segre R X Y).val.comp (presentationAlgHom R X Y) =
      MvPolynomial.aeval (gen R X Y) := by
  rw [presentationAlgHom, MvPolynomial.comp_aeval]
  rfl

/-- The image of `q` under the presentation, viewed in the ambient polynomial ring, is
`MvPolynomial.aeval (gen R X Y) q`. -/
public theorem val_presentationAlgHom (q : MvPolynomial (X × Y) R) :
    ((presentationAlgHom R X Y q : segre R X Y) : MvPolynomial (X ⊕ Y) R) =
      MvPolynomial.aeval (gen R X Y) q :=
  AlgHom.congr_fun (val_comp_presentationAlgHom R X Y) q

/-! ### The presentation respects the gradings -/

/-- A polynomial lies in a submodule if each of its monomial terms does. -/
private theorem mem_of_monomial_mem {σ : Type*} {S : Submodule R (MvPolynomial σ R)}
    {q : MvPolynomial σ R} (h : ∀ e ∈ q.support, monomial e (q.coeff e) ∈ S) :
    q ∈ S := by
  classical
  rw [q.as_sum]
  exact Submodule.sum_mem _ h

/-- The product of the generators `gen R X Y p ^ e p` lies in the piece of the Segre product
whose degree is the total degree of `e`. -/
public theorem prod_gen_pow_mem (e : (X × Y) →₀ ℕ) :
    (e.prod fun p k => gen R X Y p ^ k) ∈ gradePiece R X Y e.degree := by
  rw [Finsupp.prod, Finsupp.degree_apply]
  refine ⟨MvPolynomial.IsWeightedHomogeneous.prod _ _ _ fun p _ => ?_,
    MvPolynomial.IsWeightedHomogeneous.prod _ _ _ fun p _ => ?_⟩
  · simpa using ((gen_mem R X Y p).1).pow (e p)
  · simpa using ((gen_mem R X Y p).2).pow (e p)

/-- `MvPolynomial.aeval (gen R X Y)` maps a homogeneous polynomial of degree `i` on `X × Y` into
the degree-`i` piece of the Segre product. -/
public theorem aeval_gen_mem_gradePiece {i : ℕ} {q : MvPolynomial (X × Y) R}
    (hq : q ∈ MvPolynomial.homogeneousSubmodule (X × Y) R i) :
    MvPolynomial.aeval (gen R X Y) q ∈ gradePiece R X Y i := by
  refine mem_of_monomial_mem (R := R) (S := (gradePiece R X Y i).comap
    (MvPolynomial.aeval (gen R X Y)).toLinearMap) fun e he => ?_
  have hdeg : e.degree = i := by
    rw [Finsupp.degree_eq_weight_one]
    exact hq (MvPolynomial.mem_support_iff.mp he)
  rw [Submodule.mem_comap, AlgHom.toLinearMap_apply, MvPolynomial.aeval_monomial,
    MvPolynomial.algebraMap_eq, ← hdeg, ← MvPolynomial.smul_eq_C_mul]
  exact Submodule.smul_mem _ _ (prod_gen_pow_mem R X Y e)

/-- The Segre presentation as a graded ring homomorphism, from the total-degree grading of the
polynomial ring on `X × Y` to the grading of the Segre product. -/
public noncomputable def presentation :
    MvPolynomial.homogeneousSubmodule (X × Y) R →+*ᵍ grading R X Y where
  toRingHom := (presentationAlgHom R X Y).toRingHom
  map_mem {_ _} hx := by
    rw [mem_grading]
    change ((presentationAlgHom R X Y _ : segre R X Y) : MvPolynomial (X ⊕ Y) R) ∈ _
    rw [val_presentationAlgHom]
    exact aeval_gen_mem_gradePiece R X Y hx

/-- The graded presentation agrees with `presentationAlgHom` on elements. -/
@[simp] public theorem presentation_apply (q : MvPolynomial (X × Y) R) :
    presentation R X Y q = presentationAlgHom R X Y q :=
  rfl

/-! ### Surjectivity in every degree -/

/-- The product of a list of variables of the polynomial ring on `X × Y` is homogeneous of degree
the length of the list. -/
public theorem isHomogeneous_list_prod_X (l : List (X × Y)) :
    MvPolynomial.IsHomogeneous
      ((l.map fun p => (MvPolynomial.X p : MvPolynomial (X × Y) R)).prod) l.length := by
  induction l with
  | nil => simpa using MvPolynomial.isHomogeneous_one (X × Y) R
  | cons p l ih =>
    simpa [add_comm] using (MvPolynomial.isHomogeneous_X R p).mul ih

/-- `MvPolynomial.aeval (gen R X Y)` sends the product of a list of variables to the product of
the corresponding generators. -/
public theorem aeval_gen_list_prod_X (l : List (X × Y)) :
    MvPolynomial.aeval (gen R X Y)
        (l.map fun p => (MvPolynomial.X p : MvPolynomial (X × Y) R)).prod =
      (l.map (gen R X Y)).prod := by
  rw [map_list_prod, List.map_map]
  simp [Function.comp_def]

/-- The degree-`d` piece of the Segre product is contained in the image of the degree-`d` part of
the polynomial ring on `X × Y`. -/
public theorem gradePiece_le_map (d : ℕ) :
    gradePiece R X Y d ≤
      Submodule.map (MvPolynomial.aeval (gen R X Y)).toLinearMap
        (MvPolynomial.homogeneousSubmodule (X × Y) R d) := by
  intro a ha
  refine mem_of_monomial_mem (R := R) fun α hα => ?_
  have hne := MvPolynomial.mem_support_iff.mp hα
  obtain ⟨l, hlen, hl⟩ := exists_list_prod_eq_monomial R X Y d α (ha.1 hne) (ha.2 hne)
  refine ⟨MvPolynomial.C (a.coeff α) *
    (l.map fun p => (MvPolynomial.X p : MvPolynomial (X × Y) R)).prod, ?_, ?_⟩
  · simpa [hlen] using (MvPolynomial.isHomogeneous_C (X × Y) (a.coeff α)).mul
      (isHomogeneous_list_prod_X R X Y l)
  · rw [AlgHom.toLinearMap_apply, map_mul, aeval_gen_list_prod_X, ← hl,
      MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.C_mul_monomial, mul_one]

/-- The Segre presentation is surjective in every degree. -/
public theorem surjective_gradedAddHom (d : ℕ) :
    Function.Surjective ((presentation R X Y).gradedAddHom d) := by
  intro y
  obtain ⟨q, hq, hqe⟩ := gradePiece_le_map R X Y d y.2
  refine ⟨⟨q, hq⟩, Subtype.ext (Subtype.ext ?_)⟩
  rwa [GradedRingHom.gradedAddHom_apply_coe, presentation_apply, val_presentationAlgHom]

/-- The Segre presentation is surjective in all sufficiently large degrees. -/
public theorem eventually_surjective_gradedAddHom :
    ∀ᶠ d : ℕ in Filter.atTop,
      Function.Surjective ((presentation R X Y).gradedAddHom d) :=
  Filter.Eventually.of_forall (surjective_gradedAddHom R X Y)

end Stacks.RingTheory.SegreProduct

end
