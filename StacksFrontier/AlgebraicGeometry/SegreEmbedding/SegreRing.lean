module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.Algebra.DirectSum.Decomposition

/-!
# The Segre product of two polynomial rings, as a graded ring

Let `R` be a commutative ring and let `X` and `Y` be two index types. Inside the polynomial ring
`R[x_i, y_j]` on the disjoint union `X ⊕ Y`, the *Segre product* is the subalgebra spanned by the
monomials whose degree in the `x` variables equals their degree in the `y` variables. It is
graded by that common degree, and its degree-`n` component is spanned by the monomials
`x^α y^β` with `|α| = |β| = n`.

## Main definitions

* `Stacks.RingTheory.SegreProduct.weightLeft`, `Stacks.RingTheory.SegreProduct.weightRight`: the
  two weights on `X ⊕ Y` recording the degree in each group of variables.
* `Stacks.RingTheory.SegreProduct.gradePiece`: the degree-`n` piece inside the ambient polynomial
  ring, the intersection of the two weighted homogeneous submodules of weight `n`.
* `Stacks.RingTheory.SegreProduct.segre`: the Segre product, the supremum
  `⨆ n, gradePiece R X Y n` as a subalgebra.
* `Stacks.RingTheory.SegreProduct.grading`: the degree-`n` component of the Segre product.
* `Stacks.RingTheory.SegreProduct.gradingGradedAlgebra`: the graded algebra structure on the
  Segre product given by these components.

## Main results

* `Stacks.RingTheory.SegreProduct.gradePiece_mul_le`: the product of the pieces of degrees `a`
  and `b` lies in the piece of degree `a + b`.
* `Stacks.RingTheory.SegreProduct.grading_isInternal`: the Segre product is the internal direct
  sum of its components.

## Implementation notes

The two weights take values in `ℕ` rather than the single weight `X ⊕ Y → ℕ × ℕ` taking a
monomial to its bidegree. The two formulations describe the same submodules, but with `ℕ`-valued
weights the degree-`n` piece is literally an intersection of two of Mathlib's weighted
homogeneous submodules, so `MvPolynomial.IsWeightedHomogeneous.mul` and
`MvPolynomial.IsWeightedHomogeneous.coeff_eq_zero` apply to each factor with no translation.

The Segre product is defined as the supremum of its degree pieces rather than as the subalgebra
generated by the products `x_i * y_j`, so that every element is a finite sum of homogeneous
components by definition.

`grading` is a family of `Submodule R` of the subalgebra rather than of `AddSubgroup`, so the
structure obtained is a `GradedAlgebra`, which is Mathlib's abbreviation for `GradedRing` on a
family of submodules.
-/

@[expose] public section

open MvPolynomial Finsupp DirectSum

namespace Stacks.RingTheory.SegreProduct

/-- The weight on `X ⊕ Y` recording the degree in the first group of variables. -/
public def weightLeft (X Y : Type*) : X ⊕ Y → ℕ := Sum.elim (fun _ => 1) (fun _ => 0)

/-- The weight on `X ⊕ Y` recording the degree in the second group of variables. -/
public def weightRight (X Y : Type*) : X ⊕ Y → ℕ := Sum.elim (fun _ => 0) (fun _ => 1)

/-- The left weight of a variable of the first group is `1`. -/
@[simp] public theorem weightLeft_inl {X Y : Type*} (i : X) :
    weightLeft X Y (Sum.inl i) = 1 := rfl

/-- The left weight of a variable of the second group is `0`. -/
@[simp] public theorem weightLeft_inr {X Y : Type*} (j : Y) :
    weightLeft X Y (Sum.inr j) = 0 := rfl

/-- The right weight of a variable of the first group is `0`. -/
@[simp] public theorem weightRight_inl {X Y : Type*} (i : X) :
    weightRight X Y (Sum.inl i) = 0 := rfl

/-- The right weight of a variable of the second group is `1`. -/
@[simp] public theorem weightRight_inr {X Y : Type*} (j : Y) :
    weightRight X Y (Sum.inr j) = 1 := rfl

variable (R : Type*) [CommRing R] (X Y : Type*)

/-! ### The degree pieces inside the ambient polynomial ring -/

/-- The degree-`n` piece of the Segre product, inside the polynomial ring on `X ⊕ Y`: the
polynomials all of whose monomials have degree `n` in the `x` variables and degree `n` in the
`y` variables. -/
public noncomputable def gradePiece (n : ℕ) : Submodule R (MvPolynomial (X ⊕ Y) R) :=
  weightedHomogeneousSubmodule R (weightLeft X Y) n ⊓
    weightedHomogeneousSubmodule R (weightRight X Y) n

/-- A polynomial lies in the degree-`n` piece exactly when it is weighted homogeneous of weight
`n` for both weights. -/
public theorem mem_gradePiece {n : ℕ} {p : MvPolynomial (X ⊕ Y) R} :
    p ∈ gradePiece R X Y n ↔
      p.IsWeightedHomogeneous (weightLeft X Y) n ∧
        p.IsWeightedHomogeneous (weightRight X Y) n :=
  Iff.rfl

/-- The polynomial `1` lies in the degree-`0` piece. -/
public theorem one_mem_gradePiece : (1 : MvPolynomial (X ⊕ Y) R) ∈ gradePiece R X Y 0 :=
  ⟨isWeightedHomogeneous_one R _, isWeightedHomogeneous_one R _⟩

/-- The product of the pieces of degrees `a` and `b` lies in the piece of degree `a + b`. -/
public theorem gradePiece_mul_le (a b : ℕ) :
    gradePiece R X Y a * gradePiece R X Y b ≤ gradePiece R X Y (a + b) :=
  Submodule.mul_le.mpr fun _ hx _ hy => ⟨hx.1.mul hy.1, hx.2.mul hy.2⟩

/-! ### The Segre product as a subalgebra -/

/-- The Segre product of the two polynomial rings, as a subalgebra of the polynomial ring on
`X ⊕ Y`: the span of the monomials whose degree in the `x` variables equals their degree in the
`y` variables. -/
public noncomputable def segre : Subalgebra R (MvPolynomial (X ⊕ Y) R) :=
  Submodule.toSubalgebra (⨆ n : ℕ, gradePiece R X Y n)
    (Submodule.mem_iSup_of_mem 0 (one_mem_gradePiece R X Y))
    (by
      have h : (⨆ n : ℕ, gradePiece R X Y n) * (⨆ n : ℕ, gradePiece R X Y n) ≤
          ⨆ n : ℕ, gradePiece R X Y n := by
        rw [Submodule.iSup_mul]
        refine iSup_le fun a => ?_
        rw [Submodule.mul_iSup]
        refine iSup_le fun b => ?_
        exact (gradePiece_mul_le R X Y a b).trans (le_iSup _ (a + b))
      exact fun x y hx hy => Submodule.mul_le.mp h x hx y hy)

/-- A polynomial lies in the Segre product exactly when it lies in the supremum of the degree
pieces. -/
public theorem mem_segre_iff {p : MvPolynomial (X ⊕ Y) R} :
    p ∈ segre R X Y ↔ p ∈ ⨆ n : ℕ, gradePiece R X Y n :=
  Iff.rfl

/-- Each degree piece is contained in the Segre product. -/
public theorem gradePiece_le_segre (n : ℕ) :
    gradePiece R X Y n ≤ (segre R X Y).toSubmodule :=
  le_iSup _ n

/-- An element of a degree piece lies in the Segre product. -/
public theorem mem_segre_of_mem_gradePiece {n : ℕ} {p : MvPolynomial (X ⊕ Y) R}
    (hp : p ∈ gradePiece R X Y n) : p ∈ segre R X Y :=
  gradePiece_le_segre R X Y n hp

/-! ### The grading of the Segre product -/

/-- The degree-`n` component of the Segre product. -/
public noncomputable def grading (n : ℕ) : Submodule R (segre R X Y) :=
  (gradePiece R X Y n).comap (segre R X Y).val.toLinearMap

/-- An element of the Segre product lies in its degree-`n` component exactly when, as a
polynomial, it lies in the degree-`n` piece. -/
@[simp] public theorem mem_grading {n : ℕ} {x : segre R X Y} :
    x ∈ grading R X Y n ↔ (x : MvPolynomial (X ⊕ Y) R) ∈ gradePiece R X Y n :=
  Iff.rfl

/-- The components of the Segre product form a graded monoid. -/
public instance gradingGradedMonoid : SetLike.GradedMonoid (grading R X Y) where
  one_mem := one_mem_gradePiece R X Y
  mul_mem _ _ _ _ hx hy := gradePiece_mul_le R X Y _ _ (Submodule.mul_mem_mul hx hy)

/-- The Segre product is the internal direct sum of its components. -/
public theorem grading_isInternal : DirectSum.IsInternal (grading R X Y) := by
  classical
  constructor
  · rw [injective_iff_map_eq_zero]
    intro z hz
    refine DFinsupp.ext fun n₀ => ?_
    by_cases hmem : n₀ ∈ z.support
    · have hsum : ∑ n ∈ z.support, ((z n : segre R X Y) : MvPolynomial (X ⊕ Y) R) = 0 := by
        have := congrArg (fun v : segre R X Y => (v : MvPolynomial (X ⊕ Y) R))
          ((DirectSum.sum_support_of z).symm ▸ hz)
        simpa [map_sum] using this
      have key : ((z n₀ : segre R X Y) : MvPolynomial (X ⊕ Y) R) = 0 := by
        refine MvPolynomial.ext _ _ fun α => ?_
        rw [AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
        by_cases hα : weight (weightLeft X Y) α = n₀
        · have hc := congrArg (fun p : MvPolynomial (X ⊕ Y) R => p.coeff α) hsum
          rw [coeff_sum, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
            Finset.sum_eq_single_of_mem n₀ hmem ?_] at hc
          · exact hc
          · intro n _ hne
            exact MvPolynomial.IsWeightedHomogeneous.coeff_eq_zero (z n).2.1 α
              (by rw [hα]; exact Ne.symm hne)
        · exact MvPolynomial.IsWeightedHomogeneous.coeff_eq_zero (z n₀).2.1 α hα
      exact Subtype.ext (Subtype.ext key)
    · simpa using DFinsupp.notMem_support_iff.mp hmem
  · intro y
    obtain ⟨w, hw⟩ := Submodule.iSup_induction (motive := fun a : MvPolynomial (X ⊕ Y) R =>
        ∃ w : ⨁ n, grading R X Y n,
          ((DirectSum.coeAddMonoidHom (grading R X Y) w : segre R X Y) :
            MvPolynomial (X ⊕ Y) R) = a)
        (gradePiece R X Y) ((mem_segre_iff R X Y).mp y.2)
        (fun n a ha =>
          ⟨DirectSum.of _ n ⟨⟨a, mem_segre_of_mem_gradePiece R X Y ha⟩, ha⟩, by simp⟩)
        ⟨0, by simp⟩ (by rintro a b ⟨wa, rfl⟩ ⟨wb, rfl⟩; exact ⟨wa + wb, by simp⟩)
    exact ⟨w, Subtype.ext hw⟩

/-- The Segre product is a graded algebra, with degree-`n` component the span of the monomials
of degree `n` in each group of variables. -/
@[instance_reducible]
public noncomputable def gradingGradedAlgebra : GradedAlgebra (grading R X Y) :=
  letI := (grading_isInternal R X Y).chooseDecomposition
  { __ := gradingGradedMonoid R X Y
    __ := (grading_isInternal R X Y).chooseDecomposition }

end Stacks.RingTheory.SegreProduct

end
