/-!
# Quasi-coherent modules supported on the support of a finitely presented module

On a quasi-compact and quasi-separated scheme, the quasi-coherent modules whose support is
contained in that of a fixed finitely presented module are precisely the objects generated by
that module under Serre operations and arbitrary direct sums.

## Main definitions

* `AlgebraicGeometry.IsSupportedOn` expresses containment of supports by nonvanishing of stalks.
* `AlgebraicGeometry.serreCoproductClosure` is the smallest class containing an object and
  closed under zero objects, subobjects, quotients, extensions, and arbitrary coproducts.

## Main results

* `AlgebraicGeometry.supportContained_eq_serreCoproductClosure` identifies this generated class
  with the quasi-coherent modules supported on the support of the given module.

## Implementation notes

The smallest subcategory is expressed by its universal intersection: an object belongs to it
exactly when it belongs to every Serre class closed under arbitrary discrete colimits and
containing the generator.  This avoids choosing a construction of the generated subcategory.

The proof runs an induction over a finite affine cover.  At each affine chart the unit of the
restriction adjunction has a kernel supported on the remaining charts, and when that kernel
vanishes the affine case [Stacks, Tag 0GPF] supplies a nonzero map from the generator, which is
pulled back along the unit.

## References

* [Stacks Project, Lemma 56.2.2 (Tag 0GPG)](https://stacks.math.columbia.edu/tag/0GPG)
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits
open ZeroObject

namespace AlgebraicGeometry

open Scheme.Modules

private instance quasicoherentInclusion_preservesZeroMorphisms (X : Scheme.{u}) :
    (SheafOfModules.isQuasicoherent X.ringCatSheaf).ι.PreservesZeroMorphisms :=
  ⟨fun _ _ => rfl⟩

/-- A module sheaf `E` is set-theoretically supported on the support of `F` when every point
where the stalk of `E` is nonzero is also a point where the stalk of `F` is nonzero.  This is
the support containment of [Stacks, Tag 0GPG]. -/
public def IsSupportedOn {X : Scheme.{u}} (E F : X.Modules) : Prop :=
  ∀ x : X,
    (∃ a : ((Scheme.Modules.toPresheaf X).obj E).stalk x, a ≠ 0) →
      ∃ a : ((Scheme.Modules.toPresheaf X).obj F).stalk x, a ≠ 0

private theorem isSupportedOn_self {X : Scheme.{u}} (F : X.Modules) : IsSupportedOn F F :=
  fun _ h ↦ h

private instance stalkAddCommGroup_preservesZeroMorphisms {X : Scheme.{u}} (x : X) :
    (SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x).PreservesZeroMorphisms := ⟨by
  intro Y Z
  change (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
    ((PresheafOfModules.toPresheaf X.ringCatSheaf.obj).map
      ((SheafOfModules.forget X.ringCatSheaf).map (0 : Y ⟶ Z))) = 0
  rw [Functor.map_zero, Functor.map_zero, Functor.map_zero]⟩

/-- The stalk of a module at `x` is zero exactly when it has no nonzero element. -/
private theorem isZero_stalk_iff {X : Scheme.{u}} (E : X.Modules) (x : X) :
    IsZero ((SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x).obj E) ↔
      ¬ ∃ a : ((Scheme.Modules.toPresheaf X).obj E).stalk x, a ≠ 0 := by
  rw [AddCommGrpCat.isZero_iff_subsingleton, subsingleton_iff_forall_eq 0]
  simp only [not_exists, not_not]
  rfl

private theorem isSupportedOn_iff_stalk_zero (X : Scheme.{u}) (E F : X.Modules) :
    IsSupportedOn E F ↔ ∀ x : X,
      IsZero ((SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x).obj F) →
      IsZero ((SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x).obj E) := by
  simp only [IsSupportedOn, isZero_stalk_iff]
  exact forall_congr' fun x ↦ not_imp_not.symm

private theorem supportedOn_middle_of_exact (X : Scheme.{u}) (F : X.Modules)
    (S : ShortComplex X.Modules) (hS : S.Exact)
    (h₁ : IsSupportedOn S.X₁ F) (h₃ : IsSupportedOn S.X₃ F) :
    IsSupportedOn S.X₂ F := by
  intro x hx
  by_contra hF
  have hF0 := (isZero_stalk_iff F x).2 hF
  have h1zero := (isSupportedOn_iff_stalk_zero X S.X₁ F).mp h₁ x hF0
  have h3zero := (isSupportedOn_iff_stalk_zero X S.X₃ F).mp h₃ x hF0
  have hex : (SheafOfModules.stalkShortComplex X.ringCatSheaf S x).Exact :=
    (SheafOfModules.exact_iff_stalkShortComplex_exact X.ringCatSheaf S).mp hS x
  exact (isZero_stalk_iff _ x).1 (hex.isZero_of_both_isZero h1zero h3zero) hx

/-- A zero module is supported on the support of any module. -/
private theorem supportedOn_of_isZero (X : Scheme.{u}) (F : X.Modules) {E : X.Modules}
    (hE : IsZero E) : IsSupportedOn E F := fun x hx ↦
  absurd hx ((isZero_stalk_iff E x).1 (Functor.map_isZero _ hE))

private theorem stalkAddCommGroup_preservesColimits {X : Scheme.{u}} (x : X) :
    PreservesColimits (SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x) := by
  let F := SheafOfModules.stalkFunctor X.ringCatSheaf x
  let G := forget₂ (ModuleCat.{u}
    (TopCat.Presheaf.stalk (C := RingCat.{u}) X.ringCatSheaf.obj x)) AddCommGrpCat.{u}
  change PreservesColimits (F ⋙ G)
  have hF : PreservesColimits F :=
    SheafOfModules.stalkFunctor_preservesColimits X.ringCatSheaf x
  have hG : PreservesColimits G := inferInstance
  exact comp_preservesColimits F G

private theorem supportedOn_of_isColimit (X : Scheme.{u}) (F : X.Modules)
    (ι : Type u) (D : Discrete ι ⥤ X.Modules)
    (c : Cocone D) (hc : IsColimit c)
    (hE : ∀ i, IsSupportedOn (D.obj i) F)
    (hpres : ∀ x : X, PreservesColimit D
      (SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x)) :
    IsSupportedOn c.pt F := by
  intro x hx
  by_contra hF
  have hF0 := (isZero_stalk_iff F x).2 hF
  let T := SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x
  let TD : Discrete ι ⥤ AddCommGrpCat := D ⋙ T
  have hTD : IsZero TD := Functor.isZero TD (fun i =>
    (isSupportedOn_iff_stalk_zero X (D.obj i) F).mp (hE i) x hF0)
  have hTC : IsColimit (T.mapCocone c) :=
    @isColimitOfPreserves _ _ _ _ _ _ D T c hc (hpres x)
  have hzero : IsZero (T.obj c.pt) := hTC.isZero_pt hTD
  exact (isZero_stalk_iff _ x).1 hzero hx

private theorem isZero_of_all_stalks_isZero (X : Scheme.{u}) (E : X.Modules)
    (h : ∀ x : X, IsZero ((SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x).obj E)) :
    IsZero E := by
  let F := SheafOfModules.toSheaf X.ringCatSheaf
  let f : E ⟶ 0 := (isZero_zero X.Modules).from_ E
  have hf : IsIso (F.map f) := by
    apply (TopCat.Presheaf.isIso_iff_stalkFunctor_map_iso
      (F.map f)).2
    intro x
    let T := SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x
    have hT0 : IsZero (T.obj (0 : X.Modules)) :=
      Functor.map_isZero T (isZero_zero X.Modules)
    change IsIso (T.map f)
    exact isIso_of_source_target_iso_zero _ (h x).isoZero hT0.isoZero
  have : IsIso f := Functor.ReflectsIsomorphisms.reflects F f
  exact (isZero_zero X.Modules).of_iso (asIso f)

private theorem exists_nonzero_stalk_of_not_isZero (X : Scheme.{u}) (E : X.Modules)
    (hE : ¬ IsZero E) :
    ∃ x : X, ∃ a : E.presheaf.stalk x, a ≠ 0 := by
  by_contra h
  apply hE
  apply isZero_of_all_stalks_isZero X E
  intro x
  exact (isZero_stalk_iff E x).2 fun ⟨a, ha⟩ ↦ h ⟨x, a, ha⟩

private theorem preservesFiniteLimits_restrictFunctor {X Y : Scheme.{u}}
    (j : X ⟶ Y) [IsOpenImmersion j] :
    PreservesFiniteLimits (Scheme.Modules.restrictFunctor j) := by
  have : PreservesLimitsOfSize.{0, 0} (Scheme.Modules.toPresheaf Y) :=
    preservesLimitsOfSize_shrink _
  have : PreservesFiniteLimits (Scheme.Modules.toPresheaf Y) := inferInstance
  have : PreservesFiniteLimits
      ((Functor.whiskeringLeft _ _ Ab.{u}).obj j.opensFunctor.op) := inferInstance
  have e : Scheme.Modules.restrictFunctor j ⋙ Scheme.Modules.toPresheaf X ≅
      Scheme.Modules.toPresheaf Y ⋙
        (Functor.whiskeringLeft _ _ _).obj j.opensFunctor.op := Iso.refl _
  have : PreservesFiniteLimits
      (Scheme.Modules.restrictFunctor j ⋙ Scheme.Modules.toPresheaf X) :=
    preservesFiniteLimits_of_natIso e.symm
  exact preservesFiniteLimits_of_reflects_of_preserves _ (Scheme.Modules.toPresheaf X)

private theorem isIso_restrict_unit {X : Scheme.{u}} {U : X.Opens}
    (j : U.toScheme ⟶ X)
    [IsOpenImmersion j] (E : X.Modules) :
    IsIso ((Scheme.Modules.restrictFunctor j).map
      ((Scheme.Modules.restrictAdjunction j).unit.app E)) := by
  let L := Scheme.Modules.restrictFunctor j
  let adj := Scheme.Modules.restrictAdjunction j
  let c := adj.counit.app (L.obj E)
  have : IsIso c := inferInstance
  have htri : L.map (adj.unit.app E) ≫ c = 𝟙 (L.obj E) := adj.left_triangle_components E
  have heq : L.map (adj.unit.app E) = inv c := by
    apply (cancel_mono c).1
    rw [htri]
    simp
  rw [heq]
  infer_instance

private theorem isZero_kernel_stalk_of_isIso_restriction {X : Scheme.{u}}
    (U : X.Opens)
    (E P : X.Modules) (η : E ⟶ P)
    (hη : IsIso ((Scheme.Modules.restrictFunctor U.ι).map η))
    (x : X) (hx : x ∈ U) :
    IsZero ((Scheme.Modules.presheaf (kernel η)).stalk x) := by
  let j := U.ι
  let L := Scheme.Modules.restrictFunctor j
  have : PreservesFiniteLimits L := preservesFiniteLimits_restrictFunctor j
  have : IsIso (L.map η) := hη
  let eK := PreservesKernel.iso L η
  have hK : IsZero (kernel (L.map η)) :=
    isZero_kernel_of_mono (L.map η)
  have hLK : IsZero (L.obj (kernel η)) := hK.of_iso eK
  let xU : U.toScheme := ⟨x, hx⟩
  have hLStalk : IsZero
      ((Scheme.Modules.restrictFunctor j ⋙ Scheme.Modules.toPresheaf U.toScheme ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} xU).obj (kernel η)) := by
    change IsZero
      ((SheafOfModules.stalkAddCommGroupFunctor U.toScheme.ringCatSheaf xU).obj
        (L.obj (kernel η)))
    exact Functor.map_isZero _ hLK
  have hglobal : IsZero
      ((Scheme.Modules.toPresheaf X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} (j xU)).obj
        (kernel η)) :=
    hLStalk.of_iso ((Scheme.Modules.restrictStalkNatIso j xU).app (kernel η)).symm
  simpa [L, j, xU] using hglobal

private theorem supportedOn_of_mono (X : Scheme.{u}) (F : X.Modules)
    {E G : X.Modules} (i : E ⟶ G) [Mono i] (hG : IsSupportedOn G F) :
    IsSupportedOn E F := by
  let S : ShortComplex X.Modules := ShortComplex.mk (0 : (0 : X.Modules) ⟶ E) i (by simp)
  have hS : S.Exact := (ShortComplex.exact_iff_mono _ rfl).2 inferInstance
  simpa [S] using
    supportedOn_middle_of_exact X F S hS (supportedOn_of_isZero X F (isZero_zero _)) hG

private theorem supportedOn_of_epi (X : Scheme.{u}) (F : X.Modules)
    {E G : X.Modules} (p : E ⟶ G) [Epi p] (hE : IsSupportedOn E F) :
    IsSupportedOn G F := by
  let S : ShortComplex X.Modules := ShortComplex.mk p (0 : G ⟶ (0 : X.Modules)) (by simp)
  have hS : S.Exact := (ShortComplex.exact_iff_epi _ rfl).2 inferInstance
  simpa [S] using
    supportedOn_middle_of_exact X F S hS hE (supportedOn_of_isZero X F (isZero_zero _))

/-- The smallest class containing `F` which is a Serre subcategory and is closed under
arbitrary direct sums.  It is presented as the intersection of all such classes, and is the
generated subcategory of [Stacks, Tag 0GPG]. -/
public def serreCoproductClosure {C : Type (u + 1)} [Category.{u} C] [Preadditive C]
    (F : C) : ObjectProperty C :=
  fun E ↦ ∀ P : ObjectProperty C,
    P F →
    P.ContainsZero →
    P.IsClosedUnderSubobjects →
    P.IsClosedUnderQuotients →
    P.IsClosedUnderExtensions →
    (∀ (ι : Type u), P.IsClosedUnderColimitsOfShape (Discrete ι)) →
    P E

private instance serreCoproductClosure_containsZero {C : Type (u + 1)}
    [Category.{u} C] [Preadditive C] [HasZeroObject C] (F : C) :
    (serreCoproductClosure (C := C) F).ContainsZero := by
  refine ⟨0, isZero_zero C, ?_⟩
  intro P hF hzero hsub hquot hext hcop
  exact P.prop_of_isZero (isZero_zero C)

private instance serreCoproductClosure_isClosedUnderSubobjects {C : Type (u + 1)}
    [Category.{u} C] [Preadditive C] (F : C) :
    (serreCoproductClosure (C := C) F).IsClosedUnderSubobjects := by
  constructor
  intro E G f _ hG P hF hzero hsub hquot hext hcop
  exact P.prop_of_mono f (hG P hF hzero hsub hquot hext hcop)

private instance serreCoproductClosure_isClosedUnderQuotients {C : Type (u + 1)}
    [Category.{u} C] [Preadditive C] (F : C) :
    (serreCoproductClosure (C := C) F).IsClosedUnderQuotients := by
  constructor
  intro E G f _ hE P hF hzero hsub hquot hext hcop
  exact P.prop_of_epi f (hE P hF hzero hsub hquot hext hcop)

private instance serreCoproductClosure_isClosedUnderExtensions {C : Type (u + 1)}
    [Category.{u} C] [Abelian C] (F : C) :
    (serreCoproductClosure (C := C) F).IsClosedUnderExtensions := by
  constructor
  intro S hS h₁ h₃ P hF hzero hsub hquot hext hcop
  exact P.prop_X₂_of_shortExact hS (h₁ P hF hzero hsub hquot hext hcop)
    (h₃ P hF hzero hsub hquot hext hcop)

private instance serreCoproductClosure_isClosedUnderDiscreteColimits
    {C : Type (u + 1)} [Category.{u} C] [Preadditive C] (F : C) (ι : Type u) :
  (serreCoproductClosure (C := C) F).IsClosedUnderColimitsOfShape (Discrete ι) := by
  apply ObjectProperty.IsClosedUnderColimitsOfShape.mk'
  rintro E ⟨D, hD⟩
  intro P hF hzero hsub hquot hext hcop
  have := hcop ι
  exact P.prop_colimit D (fun i => hD i P hF hzero hsub hquot hext hcop)

private lemma prop_sSup_of_serre_coprod {C : Type (u + 1)} [Category.{u} C] [Abelian C]
    [LocallySmall.{u} C] [WellPowered.{u} C] [HasCoproducts.{u} C] [HasImages C]
    (P : ObjectProperty C) [P.IsClosedUnderQuotients]
    (hcoprod : ∀ (ι : Type u), P.IsClosedUnderColimitsOfShape (Discrete ι))
    {E : C} (s : Set (Subobject E)) (hs : ∀ S ∈ s, P (S : C)) :
    P ((Subobject.sSup s : Subobject E) : C) := by
  classical
  let I : Type u := equivShrink (Subobject E) '' s
  let D : Discrete I ⥤ C :=
    Discrete.functor fun i => (((equivShrink (Subobject E)).symm i) : C)
  have hD : ∀ i, P (D.obj i) := by
    intro i
    rcases i.as.property with ⟨S, hS, hEq⟩
    have hEq' : S = (equivShrink (Subobject E)).symm i.as := by
      simpa using congrArg (equivShrink (Subobject E)).symm hEq
    subst S
    exact hs _ hS
  have := hcoprod I
  have hc : P (colimit D) := P.prop_colimit D hD
  let f : (colimit D) ⟶ E := Subobject.smallCoproductDesc s
  have hIm : P (image f) := P.prop_of_epi (factorThruImage f) hc
  have hImg : P ((Subobject.mk (image.ι f) : Subobject E) : C) :=
    P.prop_of_iso (Subobject.underlyingIso (image.ι f)).symm hIm
  simpa [Subobject.sSup, f] using hImg

private theorem exists_maximal_subobject_of_quotients_and_coproducts
    {C : Type (u + 1)} [Category.{u} C] [Abelian C]
    [LocallySmall.{u} C] [WellPowered.{u} C] [HasCoproducts.{u} C]
    (P : ObjectProperty C) [P.IsClosedUnderQuotients]
    (hcoprod : ∀ (ι : Type u), P.IsClosedUnderColimitsOfShape (Discrete ι)) (E : C) :
    ∃ S : Subobject E, P (S : C) ∧ ∀ T : Subobject E, P (T : C) → T ≤ S :=
  ⟨Subobject.sSup {T | P (T : C)}, prop_sSup_of_serre_coprod P hcoprod _ fun _ hT ↦ hT,
    fun T hT ↦ Subobject.le_sSup _ T hT⟩

private theorem exists_maximal_generated_subobject (X : Scheme.{u})
    (F E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory) :
    ∃ S : Subobject E,
      serreCoproductClosure F
          (S : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory) ∧
        ∀ T : Subobject E,
          serreCoproductClosure F
            (T : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory) → T ≤ S :=
  exists_maximal_subobject_of_quotients_and_coproducts
    (serreCoproductClosure
      (C := (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory) F)
    (fun _ => inferInstance) E

/-- The inclusion of the quasi-coherent modules into all modules is left exact. -/
private lemma preservesFiniteLimits_quasicoherentι (X : Scheme.{u}) :
    PreservesFiniteLimits (SheafOfModules.isQuasicoherent X.ringCatSheaf).ι := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let : Q.IsClosedUnderKernels := inferInstance
  let : HasBinaryBiproducts Q.FullSubcategory := HasBinaryBiproducts.of_hasBinaryProducts
  let : ∀ {A B : Q.FullSubcategory} (f : A ⟶ B),
      PreservesLimit (parallelPair f 0) Q.ι := fun f => Q.preservesKernels_ι f
  exact Functor.preservesFiniteLimits_of_preservesKernels Q.ι

/-- The inclusion of the quasi-coherent modules into all modules is right exact. -/
private lemma preservesFiniteColimits_quasicoherentι (X : Scheme.{u}) :
    PreservesFiniteColimits (SheafOfModules.isQuasicoherent X.ringCatSheaf).ι := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let : Q.IsClosedUnderCokernels := inferInstance
  let : HasBinaryBiproducts Q.FullSubcategory := HasBinaryBiproducts.of_hasBinaryProducts
  let : ∀ {A B : Q.FullSubcategory} (f : A ⟶ B),
      PreservesColimit (parallelPair f 0) Q.ι := fun f => Q.preservesCokernels_ι f
  exact Functor.preservesFiniteColimits_of_preservesCokernels Q.ι


/-- Every nonzero quasi-coherent module supported on the support of `F` receives a nonzero map
from an object generated by `F` under Serre operations and direct sums.  This is the inductive
heart of [Stacks, Tag 0GPG], run over a finite affine cover of `X`. -/
private theorem exists_nonzero_hom_from_generator (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X] (F : X.Modules)
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) F]
    (E' : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory)
    (hE' : IsSupportedOn E'.obj F) (hne : ¬ IsZero E') :
    ∃ G : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory,
      serreCoproductClosure
          (C := (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory)
        ⟨F, by
          constructor
          exact ⟨(SheafOfModules.IsFinitePresentation.exists_quasicoherentData F).choose⟩⟩ G ∧
        ∃ f : G ⟶ E', f ≠ 0 := by
  classical
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  have hPresLim : PreservesFiniteLimits Q.ι := preservesFiniteLimits_quasicoherentι X
  let Fgen : Q.FullSubcategory := ⟨F, by
    constructor
    exact ⟨(SheafOfModules.IsFinitePresentation.exists_quasicoherentData F).choose⟩⟩
  let B := serreCoproductClosure (C := Q.FullSubcategory) Fgen
  have : B.IsClosedUnderSubobjects := inferInstance
  have : B.IsClosedUnderQuotients := inferInstance
  have : B.IsClosedUnderExtensions := inferInstance
  have hBcop (ι : Type u) : B.IsClosedUnderColimitsOfShape (Discrete ι) := inferInstance
  have hBgen : B Fgen := by
    intro R hRF hzero hsub hquot hext hcop
    exact hRF
  obtain ⟨s, hs, hcover⟩ :=
    (isCompact_iff_finite_and_eq_biUnion_affineOpens (X := X) (U := ⊤)).mp
      isCompact_univ
  have haux : ∀ (s : Set X.affineOpens), s.Finite →
      ∀ (A : Q.FullSubcategory), IsSupportedOn A.obj F →
        (∀ x : X, (∃ a : (Scheme.Modules.presheaf A.obj).stalk x, a ≠ 0) →
          x ∈ ⋃ i ∈ s, (i : X.Opens)) →
        ¬ IsZero A →
        ∃ G : Q.FullSubcategory, B G ∧ ∃ f : G ⟶ A, f ≠ 0 := by
    intro s hs
    induction s, hs using Set.Finite.induction_on with
    | empty =>
        intro A hA hcov hne
        obtain ⟨x, a, ha⟩ := exists_nonzero_stalk_of_not_isZero X A.obj
          fun h ↦ hne (IsZero.of_full_of_faithful_of_isZero Q.ι A h)
        have hx := hcov x ⟨a, ha⟩
        simp at hx
    | @insert a s ha hs ih =>
        intro A hA hcov hne
        let U : X.Opens := a
        have hU : IsAffineOpen U := a.property
        let j := U.ι
        have : IsOpenImmersion j := by dsimp [j, U]; infer_instance
        have : A.obj.IsQuasicoherent := by simpa [Q] using A.property
        let EU := (Scheme.Modules.restrictFunctor j).obj A.obj
        have : EU.IsQuasicoherent :=
          Scheme.Modules.isQuasicoherent_restrictFunctor j A.obj
        let Praw := (Scheme.Modules.pushforward j).obj EU
        have : QuasiCompact j := by infer_instance
        have : QuasiSeparated j := by infer_instance
        have : Praw.IsQuasicoherent := inferInstance
        let adj := Scheme.Modules.restrictAdjunction j
        let ηraw := adj.unit.app A.obj
        have hId : (𝟭 X.Modules).obj A.obj = A.obj := rfl
        let η : A.obj ⟶ Praw := hId ▸ ηraw
        have hηU : IsIso ((Scheme.Modules.restrictFunctor j).map η) := by
          change IsIso ((Scheme.Modules.restrictFunctor j).map ηraw)
          exact isIso_restrict_unit j A.obj
        have hKqc : (kernel η).IsQuasicoherent :=
          Stacks.AlgebraicGeometry.QcohLimits.isQuasicoherent_kernel η
        let K : Q.FullSubcategory := ⟨kernel η, hKqc⟩
        let kc := Fork.ofι (kernel.ι η)
          ((kernel.condition η).trans comp_zero.symm)
        have hkc : IsLimit kc := kernelIsKernel η
        have hMonoK : Mono kc.ι := Fork.IsLimit.mono hkc
        have hKsupport : IsSupportedOn K.obj F :=
          @supportedOn_of_mono X F K.obj A.obj kc.ι hMonoK hA
        have hKsubA : IsSupportedOn K.obj A.obj :=
          @supportedOn_of_mono X A.obj K.obj A.obj kc.ι hMonoK
            (isSupportedOn_self A.obj)
        have hKcover : ∀ x : X,
            (∃ z : (Scheme.Modules.presheaf K.obj).stalk x, z ≠ 0) →
              x ∈ ⋃ i ∈ s, (i : X.Opens) := by
          intro x hx
          by_cases hxU : x ∈ U
          · rcases hx with ⟨z, hz⟩
            exact ((isZero_stalk_iff _ x).1
              (isZero_kernel_stalk_of_isIso_restriction U A.obj Praw η hηU x hxU) ⟨z, hz⟩).elim
          · have hxA := hKsubA x hx
            have hxOld := hcov x hxA
            simp only [Set.mem_iUnion] at hxOld ⊢
            rcases hxOld with ⟨i, hi⟩
            rcases hi with ⟨his, hxi⟩
            rcases Set.mem_insert_iff.mp his with hia | his
            · subst i
              exact (hxU hxi).elim
            · exact ⟨i, ⟨his, hxi⟩⟩
        by_cases hKzero : IsZero K
        · have hKraw : IsZero (kernel η) := by
            have h := Functor.map_isZero Q.ι hKzero
            simpa [K] using h
          have : Mono η := Preadditive.mono_of_isZero_kernel η hKraw
          have hEU : ¬ IsZero EU := by
            intro hEU0
            have hP0 : IsZero Praw := Functor.map_isZero
              (Scheme.Modules.pushforward j) hEU0
            exact hne (IsZero.of_full_of_faithful_of_isZero Q.ι A (IsZero.of_mono η hP0))
          let FU := (Scheme.Modules.restrictFunctor j).obj F
          have : FU.IsFinitePresentation := by
            have hp := @Stacks.SheafOfModules.modulePullback_isFinitePresentation _ _
              j.toLRSHom.toShHom F (inferInstance : F.IsFinitePresentation)
            exact (SheafOfModules.isFinitePresentation U.toScheme.ringCatSheaf).prop_of_iso
              ((Scheme.Modules.restrictFunctorIsoPullback j).app F).symm hp
          have hsuppU :
              {y : U.toScheme | ∃ z : (Scheme.Modules.presheaf EU).stalk y, z ≠ 0} ⊆
              {y : U.toScheme | ∃ z : (Scheme.Modules.presheaf FU).stalk y, z ≠ 0} := by
            intro y hy
            let eE := (Scheme.Modules.restrictStalkNatIso j y).app A.obj
            let eF := (Scheme.Modules.restrictStalkNatIso j y).app F
            have hyE : ∃ z : (Scheme.Modules.presheaf A.obj).stalk (j y), z ≠ 0 :=
              (exists_nonzero_iff_of_addCommGrpCat_iso eE).mp hy
            have hyF := hA (j y) hyE
            exact (exists_nonzero_iff_of_addCommGrpCat_iso eF).mpr hyF
          let : IsAffine U.toScheme := hU
          obtain ⟨f, hf⟩ :=
            exists_nonzero_hom_of_supp_subset U.toScheme FU EU hEU hsuppU
          let Pobj : Q.FullSubcategory := ⟨Praw, inferInstance⟩
          let ηq : A ⟶ Pobj := Q.homMk η
          let gRaw : F ⟶ Praw := (adj.homEquiv F EU) f
          let gq : Fgen ⟶ Pobj := Q.homMk gRaw
          have hfg : (Scheme.Modules.restrictFunctor j).map gRaw ≫
              (adj.counit.app EU) = f := by
            change (adj.homEquiv F EU).symm gRaw = f
            exact (adj.homEquiv F EU).symm_apply_apply f
          let : Mono ηq := Q.ι.mono_of_mono_map (by simpa [ηq] using ‹Mono η›)
          let : HasPullback ηq gq := by infer_instance
          let G : Q.FullSubcategory := pullback ηq gq
          have hG : B G := by
            let : Mono (pullback.snd ηq gq) := pullback.snd_of_mono
            exact B.prop_of_mono (pullback.snd ηq gq) hBgen
          let L := Scheme.Modules.restrictFunctor j
          let R := Q.ι ⋙ L
          have : PreservesFiniteLimits Q.ι := hPresLim
          have hLlim : PreservesFiniteLimits L := preservesFiniteLimits_restrictFunctor j
          have : R.PreservesZeroMorphisms := ⟨fun _ _ => rfl⟩
          have : PreservesFiniteLimits R :=
            @comp_preservesFiniteLimits _ _ _ _ _ _ Q.ι L hPresLim hLlim
          have : PreservesLimit (cospan ηq gq) R := inferInstance
          let e := PreservesPullback.iso R ηq gq
          have hηR : IsIso (R.map ηq) := by
            change IsIso (L.map η)
            exact hηU
          let gR := R.map gq
          let ηR := R.map ηq
          have : IsIso ηR := hηR
          have : IsIso (L.map η) := hηU
          have hInv : adj.counit.app EU = inv (L.map η) :=
            IsIso.eq_inv_of_hom_inv_id (adj.left_triangle_components A.obj)
          have hnonzero : gR ≫ inv ηR ≠ 0 := by
            intro hz
            apply hf
            have hgR : gR = L.map gRaw := by rfl
            have hηR' : ηR = L.map η := by rfl
            have hz' : (L.map gRaw) ≫ inv (L.map η) = 0 := by
              simpa [hgR, hηR'] using hz
            have : (L.map gRaw) ≫ adj.counit.app EU = 0 := by
              simpa [hInv] using hz'
            rw [← hfg]
            exact this
          let φ := pullback.lift (f := ηR) (g := gR)
            (gR ≫ inv ηR) (𝟙 (L.obj F)) (by
              calc
                (gR ≫ inv ηR) ≫ ηR = gR := by simp [Category.assoc]
                _ = 𝟙 (L.obj F) ≫ gR := by simp)
          have hφ : φ ≫ pullback.fst ηR gR = gR ≫ inv ηR :=
            pullback.lift_fst _ _ _
          have hfst : pullback.fst ηq gq ≠ 0 := by
            intro hz
            have hzR : R.map (pullback.fst ηq gq) = 0 := by
              rw [hz, Functor.map_zero]
            have hzφ : (φ ≫ e.inv) ≫ R.map (pullback.fst ηq gq) =
                gR ≫ inv ηR := by
              rw [Category.assoc, PreservesPullback.iso_inv_fst, hφ]
            exact hnonzero (by rw [hzR, comp_zero] at hzφ; exact hzφ.symm)
          exact ⟨G, hG, pullback.fst ηq gq, hfst⟩
        · let κraw : K.obj ⟶ A.obj := kc.ι
          let κ : K ⟶ A := Q.homMk κraw
          have : Mono κ := Q.ι.mono_of_mono_map (by simpa [κ] using hMonoK)
          obtain ⟨G, hG, f, hf⟩ := ih K hKsupport hKcover hKzero
          refine ⟨G, hG, f ≫ κ, ?_⟩
          intro hcomp
          apply hf
          exact (cancel_mono κ).1 (by simpa using hcomp)
  have hcoverX : ∀ x : X, x ∈ ⋃ i ∈ s, (i : X.Opens) := by
    intro x
    have hxTop : x ∈ (⊤ : X.Opens) := Set.mem_univ x
    rw [hcover] at hxTop
    rw [TopologicalSpace.Opens.mem_iSup] at hxTop
    rcases hxTop with ⟨i, hi⟩
    rw [TopologicalSpace.Opens.mem_iSup] at hi
    rcases hi with ⟨his, hxi⟩
    exact Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨his, hxi⟩⟩
  exact haux s hs E' hE' (fun x hx => hcoverX x) hne


/-- The zero module is supported on the support of `F`. -/
private lemma containsZero_isSupportedOn (X : Scheme.{u}) (F : X.Modules) :
    ObjectProperty.ContainsZero
      (fun E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ↦
        IsSupportedOn E.obj F) := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  let : Q.ι.PreservesZeroMorphisms := quasicoherentInclusion_preservesZeroMorphisms X
  change P.ContainsZero
  exact ⟨0, isZero_zero _, supportedOn_of_isZero X F (Functor.map_isZero Q.ι (isZero_zero _))⟩

/-- A quasi-coherent submodule of a module supported on the support of `F` is supported
there too. -/
private lemma isClosedUnderSubobjects_isSupportedOn (X : Scheme.{u}) (F : X.Modules) :
    ObjectProperty.IsClosedUnderSubobjects
      (fun E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ↦
        IsSupportedOn E.obj F) := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  change P.IsClosedUnderSubobjects
  have hPresLim : PreservesFiniteLimits Q.ι := preservesFiniteLimits_quasicoherentι X
  constructor
  intro E G f _ hG
  exact @supportedOn_of_mono X F _ _ (Q.ι.map f) (Functor.map_mono Q.ι f) hG

/-- A quasi-coherent quotient of a module supported on the support of `F` is supported there
too. -/
private lemma isClosedUnderQuotients_isSupportedOn (X : Scheme.{u}) (F : X.Modules) :
    ObjectProperty.IsClosedUnderQuotients
      (fun E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ↦
        IsSupportedOn E.obj F) := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  change P.IsClosedUnderQuotients
  have hPresColim : PreservesFiniteColimits Q.ι := preservesFiniteColimits_quasicoherentι X
  constructor
  intro E G f _ hE
  exact @supportedOn_of_epi X F _ _ (Q.ι.map f) (Functor.map_epi Q.ι f) hE

/-- An extension of modules supported on the support of `F` is supported there too. -/
private lemma isClosedUnderExtensions_isSupportedOn (X : Scheme.{u}) (F : X.Modules) :
    ObjectProperty.IsClosedUnderExtensions
      (fun E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ↦
        IsSupportedOn E.obj F) := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  change P.IsClosedUnderExtensions
  have hPresLim : PreservesFiniteLimits Q.ι := preservesFiniteLimits_quasicoherentι X
  have hPresColim : PreservesFiniteColimits Q.ι := preservesFiniteColimits_quasicoherentι X
  constructor
  intro S hS h1 h3
  let S' := S.map Q.ι
  have hS' : S'.Exact := by
    let : PreservesFiniteLimits Q.ι := hPresLim
    let : PreservesFiniteColimits Q.ι := hPresColim
    exact (ShortComplex.ShortExact.map_of_exact hS Q.ι).exact
  exact supportedOn_middle_of_exact X F S' hS' h1 h3

/-- A direct sum of quasi-coherent modules supported on the support of `F` is supported
there too. -/
private lemma isClosedUnderDiscreteColimits_isSupportedOn (X : Scheme.{u}) (F : X.Modules)
    (ι : Type u) :
    ObjectProperty.IsClosedUnderColimitsOfShape
      (fun E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ↦
        IsSupportedOn E.obj F) (Discrete ι) := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  change P.IsClosedUnderColimitsOfShape (Discrete ι)
  have : P.IsClosedUnderSubobjects := isClosedUnderSubobjects_isSupportedOn X F
  apply ObjectProperty.IsClosedUnderColimitsOfShape.mk'
  rintro E ⟨D, hD⟩
  let : Q.IsClosedUnderColimitsOfShape (Discrete ι) :=
    Stacks.AlgebraicGeometry.QuasicoherentColimits.isClosedUnderColimitsOfShape X
  let : CreatesColimitsOfShape (Discrete ι) Q.ι :=
    createsColimitsOfShapeFullSubcategoryInclusion _ Q
  let : PreservesColimitsOfShape (Discrete ι) Q.ι :=
    preservesColimitOfShape_of_createsColimitsOfShape_and_hasColimitsOfShape Q.ι
  let D' : Discrete ι ⥤ X.Modules := D ⋙ Q.ι
  let c' := Q.ι.mapCocone (colimit.cocone D)
  have hc' : IsColimit c' := isColimitOfPreserves Q.ι (colimit.isColimit D)
  have hpres (x : X) : PreservesColimit D'
      (SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x) := by
    let T := SheafOfModules.stalkAddCommGroupFunctor X.ringCatSheaf x
    have : PreservesColimits T := stalkAddCommGroup_preservesColimits x
    exact (PreservesColimitsOfSize.preservesColimitsOfShape (F := T)
      (J := Discrete ι)).preservesColimit
  exact supportedOn_of_isColimit X F ι D' c' hc' hD hpres

/-- If `S` is the largest subobject of `E` belonging to a class `B` closed under subobjects,
quotients and extensions, then every morphism to `E ⧸ S` out of an object of `B` vanishes:
its image would enlarge `S`. -/
private theorem eq_zero_of_hom_to_cokernel_of_isMax {A : Type (u + 1)} [Category.{u} A]
    [Abelian A] [WellPowered.{u} A] [HasCoproducts.{u} A]
    (B : ObjectProperty A) [B.IsClosedUnderSubobjects] [B.IsClosedUnderQuotients]
    [B.IsClosedUnderExtensions] {E : A} (S : Subobject E) (hS : B (S : A))
    (hmax : ∀ T : Subobject E, B (T : A) → T ≤ S) {G : A} (hG : B G)
    (g : G ⟶ cokernel S.arrow) : g = 0 := by
  classical
  by_contra hg
  let q := cokernel.π S.arrow
  let H : A := pullback q g
  let fst : H ⟶ E := pullback.fst q g
  let snd : H ⟶ G := pullback.snd q g
  have : Epi q := inferInstance
  have : Epi snd := inferInstance
  let i : (S : A) ⟶ H := pullback.lift S.arrow 0 (by simp [q])
  have hifst : i ≫ fst = S.arrow := pullback.lift_fst _ _ _
  have hisnd : i ≫ snd = 0 := pullback.lift_snd _ _ _
  have : Mono i := by
    constructor
    intro Z a b hab
    apply (cancel_mono S.arrow).1
    have h := congrArg (fun f => f ≫ fst) hab
    simpa [Category.assoc, hifst] using h
  have hLift : ∀ {Z : A} (k : Z ⟶ H) (hk : k ≫ snd = 0),
      {l : Z ⟶ (S : A) // l ≫ i = k} := by
    intro Z k hk
    have hkq : (k ≫ fst) ≫ q = 0 := by
      rw [Category.assoc, pullback.condition, ← Category.assoc, hk, zero_comp]
    let l := Abelian.monoLift S.arrow (k ≫ fst) hkq
    refine ⟨l, ?_⟩
    apply pullback.hom_ext (f := q) (g := g)
    · rw [Category.assoc]
      change l ≫ i ≫ fst = k ≫ fst
      rw [hifst]
      exact Abelian.monoLift_comp S.arrow (k ≫ fst) hkq
    · rw [Category.assoc]
      change l ≫ i ≫ snd = k ≫ snd
      rw [hisnd, comp_zero, hk]
  have hi : IsLimit (KernelFork.ofι i hisnd) :=
    KernelFork.IsLimit.ofι' i hisnd hLift
  let eKS : kernel snd ≅ (S : A) :=
    IsLimit.conePointUniqueUpToIso (kernelIsKernel snd) hi
  have hK : B (kernel snd) := B.prop_of_iso eKS.symm hS
  let T : ShortComplex A :=
    ShortComplex.mk (kernel.ι snd) snd (by simp)
  have hT : T.ShortExact := by
    apply ShortComplex.ShortExact.mk'
    · exact ShortComplex.exact_kernel snd
    · infer_instance
    · infer_instance
  have hH : B H := B.prop_X₂_of_shortExact hT hK hG
  let I : Subobject E := Subobject.mk (image.ι fst)
  have hI : B (I : A) := by
    have hIm := B.prop_of_epi (factorThruImage fst) hH
    exact B.prop_of_iso (Subobject.underlyingIso (image.ι fst)).symm hIm
  have hIS : I ≤ S := hmax I hI
  let v : H ⟶ S := factorThruImage fst ≫
    (Subobject.underlyingIso (image.ι fst)).symm.hom ≫ Subobject.ofLE I S hIS
  have hv : v ≫ S.arrow = fst := by
    simp [v, I]
  have hzeroq : fst ≫ q = 0 := by
    rw [← hv, Category.assoc, cokernel.condition, comp_zero]
  have hsg : snd ≫ g = snd ≫ 0 := by
    rw [comp_zero, ← pullback.condition, hzeroq]
  exact hg ((cancel_epi snd).1 hsg)

/-- A quasi-coherent module supported on the support of `F` lies in the smallest Serre
subcategory containing `F` and closed under direct sums; the substantial half of
[Stacks, Tag 0GPG]. -/
private theorem mem_serreCoproductClosure_of_isSupportedOn (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X] (F : X.Modules)
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) F]
    (E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory)
    (hE : IsSupportedOn E.obj F) :
    serreCoproductClosure
        (C := (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory)
      ⟨F, by
        constructor
        exact ⟨(SheafOfModules.IsFinitePresentation.exists_quasicoherentData F).choose⟩⟩ E := by
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  have hquot : P.IsClosedUnderQuotients := isClosedUnderQuotients_isSupportedOn X F
  let Fgen : Q.FullSubcategory := ⟨F, by
    constructor
    exact ⟨(SheafOfModules.IsFinitePresentation.exists_quasicoherentData F).choose⟩⟩
  let B := serreCoproductClosure (C := Q.FullSubcategory) Fgen
  obtain ⟨S, hS, hmax⟩ := exists_maximal_generated_subobject X Fgen E
  have hQsupport : IsSupportedOn (cokernel S.arrow).obj F :=
    P.prop_of_epi (cokernel.π S.arrow) hE
  by_cases hQzero : IsZero (cokernel S.arrow)
  · have := (Preadditive.epi_iff_isZero_cokernel S.arrow).2 hQzero
    have := isIso_of_mono_of_epi S.arrow
    exact B.prop_of_iso (asIso S.arrow) hS
  · obtain ⟨G, hG, g, hg⟩ :=
      exists_nonzero_hom_from_generator X F (cokernel S.arrow) hQsupport hQzero
    exact (hg (eq_zero_of_hom_to_cokernel_of_isMax B S hS hmax hG g)).elim

/-- **Stacks Project, Tag 0GPG.** On a quasi-compact and quasi-separated scheme, the
quasi-coherent modules supported on the support of a finitely presented module are exactly
the smallest Serre subcategory containing it and closed under arbitrary direct sums. -/
@[stacks 0GPG]
theorem supportContained_eq_serreCoproductClosure (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X] (F : X.Modules)
    [SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) F] :
    (fun E : (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ↦
        IsSupportedOn E.obj F) =
      serreCoproductClosure
          (C := (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory)
        ⟨F, by
        constructor
        exact ⟨(SheafOfModules.IsFinitePresentation.exists_quasicoherentData F).choose⟩⟩ := by
  classical
  let Q := SheafOfModules.isQuasicoherent X.ringCatSheaf
  let P : ObjectProperty Q.FullSubcategory := fun E ↦ IsSupportedOn E.obj F
  have hgen : P
      ⟨F, by
        constructor
        exact ⟨(SheafOfModules.IsFinitePresentation.exists_quasicoherentData F).choose⟩⟩ :=
    isSupportedOn_self F
  have hzero : P.ContainsZero := containsZero_isSupportedOn X F
  have hsub : P.IsClosedUnderSubobjects := isClosedUnderSubobjects_isSupportedOn X F
  have hquot : P.IsClosedUnderQuotients := isClosedUnderQuotients_isSupportedOn X F
  have hext : P.IsClosedUnderExtensions := isClosedUnderExtensions_isSupportedOn X F
  have hcop (ι : Type u) : P.IsClosedUnderColimitsOfShape (Discrete ι) :=
    isClosedUnderDiscreteColimits_isSupportedOn X F ι
  ext E
  constructor
  · exact mem_serreCoproductClosure_of_isSupportedOn X F E
  · intro hE
    simpa [P] using hE P hgen hzero hsub hquot hext hcop

end AlgebraicGeometry
