module

public import StacksFrontier.AlgebraicGeometry.RelativeDifferentialStalkMap.Scheme
public import StacksFrontier.AlgebraicGeometry.SmoothAtJacobian.Conditions

/-!
# The comparison in part (4) of Tag 01V9 is determined by its specification

Condition (4) of Stacks Tag 01V9 carries a displayed equality between two relative cotangent
spaces at a point `x` of the source of a morphism `f : X ⟶ S`: the residue-field fibre
`κ(x) ⊗ Ω_{X/S,x}` of the stalk of the sheaf of relative differentials of `f`, and the
corresponding space `κ(x) ⊗ Ω_{X_s/κ(s),x}` computed on the scheme-theoretic fibre through `x`.
`Stacks.SmoothAtJacobian.IsFiberDifferentialsTensorEquiv` is the specification such a comparison
has to satisfy: it must carry the germ of the universal relative differential of every local
section of `𝒪_X` to the germ of the universal relative differential of the pullback of that
section to the fibre.

This file proves that the specification has at most one solution.

## Main definitions

* `Stacks.FiberCotangentIdentification.germDifferentials`: the germs at `x` of the universal
  relative differentials of the local sections of `𝒪_X`, inside the stalk of the sheaf of
  relative differentials.
* `Stacks.FiberCotangentIdentification.tmulGermDifferentials`: their images `1 ⊗ germ_x(d a)` in
  the relative cotangent space, which is exactly the set the specification constrains.

## Main results

* `Stacks.FiberCotangentIdentification.span_tmul_one_eq_top`: a generating set of a module stays
  generating after an extension of scalars, once each generator is prefixed with `1 ⊗ -`.
* `Stacks.FiberCotangentIdentification.span_germDifferentials_eq_top`: the germs of universal
  relative differentials generate the stalk of the sheaf of relative differentials over
  `𝒪_{X,x}`.
* `Stacks.FiberCotangentIdentification.span_tmulGermDifferentials_eq_top`: the elements
  `1 ⊗ germ_x(d a)` generate the relative cotangent space over `κ(x)`.
* `Stacks.FiberCotangentIdentification.eq_of_isFiberDifferentialsTensorEquiv`: two comparisons
  satisfying the specification are equal.

## References

* [Stacks Project, Tag 01V9](https://stacks.math.columbia.edu/tag/01V9)
-/

@[expose] public section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry AlgebraicGeometry.SheafOfModules
open Stacks.RelativeDifferentialStalk Stacks.RelativeDifferentialStalkMap
open Stacks.SmoothAtJacobian
open scoped TensorProduct

universe u

namespace Stacks.FiberCotangentIdentification

/-- **A generating set stays generating after an extension of scalars.**  If a `B`-module `M` is
generated by `s`, then `κ ⊗[B] M` is generated over `κ` by the elements `1 ⊗ m` for `m ∈ s`. -/
public theorem span_tmul_one_eq_top {B : Type*} [CommRing B] {κ : Type*} [CommRing κ]
    [Algebra B κ] {M : Type*} [AddCommGroup M] [Module B M] {s : Set M}
    (hs : Submodule.span B s = ⊤) :
    Submodule.span κ ((fun m => (1 : κ) ⊗ₜ[B] m) '' s) = ⊤ := by
  have h := Submodule.baseChange_span (R := B) (M := M) κ s
  rw [hs, Submodule.baseChange_top] at h
  exact h.symm

variable {X S : Scheme.{u}} (f : X ⟶ S) (x : X)

/-- The germs at `x` of the universal relative differentials of the local sections of `𝒪_X`,
inside the stalk at `x` of the sheaf of relative differentials of `f`. -/
public noncomputable def germDifferentials :
    Set (ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
      (Scheme.Hom.relativeDifferentials f).val.presheaf x)) :=
  {m | ∃ (U : X.Opens) (hxU : x ∈ U) (a : ToType (X.presheaf.obj (op U))),
    (TopCat.Presheaf.germ (C := AddCommGrpCat.{u})
      (moduleOfDifferentials (inverseImageStructureMap f)).val.presheaf U x hxU).hom
      ((universalDerivation (inverseImageStructureMap f)).d a) = m}

/-- **The germs of the universal relative differentials generate the stalk of the sheaf of
relative differentials** over the local ring `𝒪_{X,x}`. -/
public theorem span_germDifferentials_eq_top :
    Submodule.span (ToType (X.sheaf.presheaf.stalk x)) (germDifferentials f x) = ⊤ := by
  classical
  let := algebraStalkMap f x
  set E := relativeDifferentialsStalkKaehlerEquiv f x with hE
  have hsub : Set.range (KaehlerDifferential.D (ToType (S.presheaf.stalk (f x)))
      (ToType (X.sheaf.presheaf.stalk x))) ⊆ (E : _ → _) '' germDifferentials f x := by
    rintro y ⟨b, rfl⟩
    obtain ⟨U, hxU, a, ha⟩ := TopCat.Presheaf.exists_germ_eq X.sheaf.presheaf b
    refine ⟨_, ⟨U, hxU, a, rfl⟩, ?_⟩
    exact (relativeDifferentialsStalkKaehlerEquiv_germ_d f x
      (OrderDual.toDual (⟨U, hxU⟩ : OpenNhds x)) a).trans (congrArg _ ha)
  have himage : Submodule.span (ToType (X.sheaf.presheaf.stalk x))
      ((E : _ → _) '' germDifferentials f x) = ⊤ := by
    refine top_unique ?_
    rw [← KaehlerDifferential.span_range_derivation (ToType (S.presheaf.stalk (f x)))
      (ToType (X.sheaf.presheaf.stalk x))]
    exact Submodule.span_mono hsub
  have hmap : Submodule.map (E : _ →ₗ[ToType (X.sheaf.presheaf.stalk x)] _)
      (Submodule.span (ToType (X.sheaf.presheaf.stalk x)) (germDifferentials f x))
      = Submodule.span (ToType (X.sheaf.presheaf.stalk x))
        ((E : _ → _) '' germDifferentials f x) :=
    Submodule.map_span _ _
  exact Submodule.map_eq_top_iff.mp (hmap.trans himage)

/-- The elements `1 ⊗ germ_x(d a)` of the relative cotangent space at `x`, for `a` a local
section of `𝒪_X` near `x`.  This is exactly the set of elements that
`Stacks.SmoothAtJacobian.IsFiberDifferentialsTensorEquiv` constrains a comparison on. -/
public noncomputable def tmulGermDifferentials : Set (relativeCotangentSpace f x) :=
  (fun m => by
    let := relativeDifferentialStalkModule f x
    let : Algebra (ToType (X.presheaf.stalk x)) (ToType (X.residueField x)) :=
      (X.residue x).hom.toAlgebra
    exact TensorProduct.tmul (ToType (X.presheaf.stalk x)) (1 : ToType (X.residueField x)) m) ''
      germDifferentials f x

/-- **The elements `1 ⊗ germ_x(d a)` generate the relative cotangent space** over `κ(x)`. -/
public theorem span_tmulGermDifferentials_eq_top :
    Submodule.span (ToType (X.residueField x)) (tmulGermDifferentials f x) = ⊤ := by
  let : Module (ToType (X.presheaf.stalk x)) (ToType (TopCat.Presheaf.stalk
      (C := AddCommGrpCat.{u}) (Scheme.Hom.relativeDifferentials f).val.presheaf x)) :=
    relativeDifferentialStalkModule f x
  let : Algebra (ToType (X.presheaf.stalk x)) (ToType (X.residueField x)) :=
    (X.residue x).hom.toAlgebra
  exact span_tmul_one_eq_top
    (B := ToType (X.presheaf.stalk x))
    (M := ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
      (Scheme.Hom.relativeDifferentials f).val.presheaf x))
    (span_germDifferentials_eq_top f x)

/-- **The specification of the comparison in part (4) of the source has at most one solution.**
Two comparisons of the relative cotangent space with the cotangent space of the fibre that both
carry germs of universal relative differentials to germs of universal relative differentials are
equal. -/
public theorem eq_of_isFiberDifferentialsTensorEquiv
    (e e' : relativeCotangentSpace f x ≅ fiberRelativeCotangentSpace f x)
    (he : IsFiberDifferentialsTensorEquiv f x e)
    (he' : IsFiberDifferentialsTensorEquiv f x e') : e = e' := by
  refine Iso.ext (ModuleCat.hom_ext
    (LinearMap.ext_on (span_tmulGermDifferentials_eq_top f x) ?_))
  rintro y ⟨ω, ⟨U, hxU, a, rfl⟩, rfl⟩
  exact (he U hxU a).trans (he' U hxU a).symm

end Stacks.FiberCotangentIdentification

end
