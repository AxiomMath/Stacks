module

public import StacksFrontier.AlgebraicGeometry.DeRham.KatzOdaGaussManin

/-!
# Wedging with a pulled-back form, on pulled-back forms

Let `f : X ⟶ Y` be a morphism of schemes over `S`, `U ⊆ Y` open and `ω` a `p`-form on `U`. This
file proves that left multiplication by `ρ(f⁻¹ω)` on `Ω^•_{X/S}|_{f⁻¹(U)}` is compatible with the
pull back of forms: for any `𝒪_Y`-module `E` and morphisms `a : E ⟶ Ω^k_{Y/S}`,
`b : E ⟶ Ω^{k+p}_{Y/S}` with `b = ω ∧ a` over `U`, one has `ρ(f⁻¹ω) ∧ ρ(f⁻¹a(-)) = ρ(f⁻¹b(-))`
(`Stacks.DeRhamSmooth.restrictedLeftMulCochain_comp_pulledBack`), and the same on the wedge
summands `f⁻¹E ⊗ Ω^q_{X/S} ⟶ Ω^n_{X/S}` of the step of the filtration of Section 50.12
(`Stacks.DeRhamSmooth.restrictedLeftMulCochain_comp_summand_pulledBack`).

The mathematical input is that the pull back of forms is multiplicative on the pullback-unit
sections: it is the transpose of the homomorphism of graded algebras of Tag 07HX
(`Stacks.DeRhamSmooth.deRhamPullbackChain_f_unit_apply`). Morphisms out of the restriction of a
pullback are determined on the restrictions of pullback-unit sections
(`Stacks.DeRhamSmooth.restricted_modulePullback_hom_ext`). No `@[stacks]` attribute is attached
here.

## References

* [Stacks Project, Tag 0FMN](https://stacks.math.columbia.edu/tag/0FMN)
* [Stacks Project, Tag 07HX](https://stacks.math.columbia.edu/tag/07HX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace AlgebraicGeometry Opposite
open RingedSpaceModuleAdjunction
open Stacks.Cohomology.HigherDirectImage

universe u

attribute [local implicit_reducible] structureSheafRing CategoryTheory.sheafCompose
  Stacks.SheafOfModules.Tensor.ringSheaf
attribute [local instance_reducible] AlgebraicGeometry.SheafedSpace.sheaf
attribute [-instance] Stacks.Cohomology.SpectralLimit.hasSheafifyOpensMax

namespace Stacks.DeRhamSmooth

open Stacks.DeRhamDirectImage

section Transport

variable {C₀ : Type*} [Category C₀] {J₀ : GrothendieckTopology C₀} {R₀ : Sheaf J₀ RingCat.{u}}

/-- Restricting a homogeneous local section of a sheaf of graded algebras does not see the name of
its degree, up to `HEq`. -/
theorem gradedAlgebra_piece_map_heq (A : SheafOfModules.GradedAlgebra.{u, u} R₀) {i j : ℤ}
    (h : i = j) {V V' : C₀ᵒᵖ} (r : V ⟶ V') {x : (A.piece i).val.obj V} {y : (A.piece j).val.obj V}
    (hxy : x ≍ y) : (A.piece i).val.map r x ≍ (A.piece j).val.map r y := by
  subst h
  cases hxy
  rfl

/-- A homomorphism of sheaves of graded algebras does not see the name of the degree of a local
section, up to `HEq`. -/
theorem unitalHom_app_heq {A B : SheafOfModules.GradedAlgebra.{u, u} R₀} (Φ : A.UnitalHom B)
    {i j : ℤ} (h : i = j) (V : C₀ᵒᵖ) {x : (A.piece i).val.obj V} {y : (A.piece j).val.obj V}
    (hxy : x ≍ y) : (Φ.app i).val.app V x ≍ (Φ.app j).val.app V y := by
  subst h
  cases hxy
  rfl

/-- The graded multiplication is congruent in its first degree, up to `HEq`. -/
theorem gradedMul_heq_left (A : SheafOfModules.GradedAlgebra.{u, u} R₀) {i i' : ℤ}
    (h : i = i') (j : ℤ) (V : C₀ᵒᵖ) {x : (A.piece i).val.obj V} {x' : (A.piece i').val.obj V}
    (hx : x ≍ x') (y : (A.piece j).val.obj V) :
    (A.mul i j).app V x y ≍ (A.mul i' j).app V x' y := by
  subst h
  cases hx
  rfl

end Transport

section Restricted

variable {Xr Yr : RingedSpace.{u, u}} (h : Xr ⟶ Yr) (U : Opens Yr)

/-- **Two morphisms out of the restriction of a pullback `h^*M` to `h⁻¹(U)` agree as soon as they
agree on the restrictions of the pullback-unit sections of the sections of `M` over the opens
inside `U`.** The pullback is locally generated by the pullback-unit sections
(`Stacks.PullbackUnitGenerators.spanSieve_mem`); a pullback-unit section over `h⁻¹(V)` restricts,
on an open inside `h⁻¹(U)`, to the pullback-unit section of the restriction of the section to
`V ∩ U`, and the target is separated. -/
theorem restricted_modulePullback_hom_ext {M : SheafOfModules.{u} (structureSheafRing Yr)}
    {C : SheafOfModules.{u} (structureSheafRing Xr)}
    (ψ₁ ψ₂ : (moduleRestriction Xr ((Opens.map h.hom.base).obj U)).obj
        ((modulePullback h).obj M) ⟶ (moduleRestriction Xr ((Opens.map h.hom.base).obj U)).obj C)
    (hψ : ∀ (WY : Opens ((Opens.toTopCat (Yr : TopCat)).obj U))
      (W : Opens ((Opens.toTopCat (Xr : TopCat)).obj ((Opens.map h.hom.base).obj U)))
      (hW : openOfRestrict ((Opens.map h.hom.base).obj U) W ≤
        (Opens.map h.hom.base).obj (openOfRestrict U WY))
      (s : M.val.obj (op (openOfRestrict U WY))),
      ψ₁.val.app (op W) (((modulePullback h).obj M).val.map (homOfLE hW).op
        (PullbackUnitGenerators.pullbackUnitSection h M (op (openOfRestrict U WY)) s)) =
      ψ₂.val.app (op W) (((modulePullback h).obj M).val.map (homOfLE hW).op
        (PullbackUnitGenerators.pullbackUnitSection h M (op (openOfRestrict U WY)) s))) :
    ψ₁ = ψ₂ := by
  ext W t
  obtain ⟨W⟩ := W
  refine (Presheaf.IsSheaf.isSeparated C.isSheaf) (openOfRestrict _ W)
    (SheafOfModules.spanSieve ((modulePullback h).obj M) (PullbackUnitGenerators.unitSections h M)
      (X := op (openOfRestrict _ W)) t)
    (PullbackUnitGenerators.spanSieve_mem h M (op (openOfRestrict _ W)) t) _ _ ?_
  intro Y' i hi
  have hY : Y' ≤ (Opens.map h.hom.base).obj U :=
    (leOfHom i).trans (openOfRestrict_le _ W)
  obtain ⟨Y₀, rfl⟩ := exists_openOfRestrict_eq _ hY
  have hle : Y₀ ≤ W := fun z hz => by
    obtain ⟨w, hw, hwz⟩ := leOfHom i ⟨z, hz, rfl⟩
    exact (Subtype.ext hwz : w = z) ▸ hw
  have hi' : i = ((Opens.map h.hom.base).obj U).isOpenEmbedding.functor.map (homOfLE hle) :=
    Subsingleton.elim _ _
  subst hi'
  have hspan := (SheafOfModules.spanSieve_arrows (X := op (openOfRestrict _ W)) t _).1 hi
  refine (PresheafOfModules.naturality_apply ψ₁.val (homOfLE hle).op t).symm.trans
    (Eq.trans ?_ (PresheafOfModules.naturality_apply ψ₂.val (homOfLE hle).op t))
  have key : ∀ x : ((modulePullback h).obj M).val.obj
      (op (openOfRestrict ((Opens.map h.hom.base).obj U) Y₀)),
      x ∈ (SheafOfModules.spanSubmodule ((modulePullback h).obj M)
        (PullbackUnitGenerators.unitSections h M)).obj
          (op (openOfRestrict ((Opens.map h.hom.base).obj U) Y₀)) →
      ψ₁.val.app (op Y₀) x = ψ₂.val.app (op Y₀) x := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨Z, gZ, z', hz', rfl⟩ := hz
      obtain ⟨V₁, k₁, s, rfl⟩ := hz'
      obtain ⟨V₁⟩ := V₁
      have hV : openOfRestrict _ Y₀ ≤ (Opens.map h.hom.base).obj (V₁ ⊓ U) :=
        fun z hz => ⟨leOfHom (k₁ ≫ gZ).unop hz, hY hz⟩
      obtain ⟨WY, hWY⟩ := exists_openOfRestrict_eq U (inf_le_right : V₁ ⊓ U ≤ U)
      have hW : openOfRestrict _ Y₀ ≤ (Opens.map h.hom.base).obj (openOfRestrict U WY) :=
        hWY ▸ hV
      have hWV : openOfRestrict U WY ≤ V₁ := hWY ▸ inf_le_left
      have e : ((modulePullback h).obj M).val.map gZ (((modulePullback h).obj M).val.map k₁
          (PullbackUnitGenerators.pullbackUnitSection h M (op V₁) s)) =
          ((modulePullback h).obj M).val.map (homOfLE hW).op
            (PullbackUnitGenerators.pullbackUnitSection h M (op (openOfRestrict U WY))
              (M.val.map (homOfLE hWV).op s)) := by
        rw [PullbackUnitGenerators.pullbackUnitSection_naturality,
          ← PresheafOfModules.map_comp_apply, ← PresheafOfModules.map_comp_apply]
        have hk : k₁ ≫ gZ = (RingedSpaceModuleAdjunction.opensMap h).op.map (homOfLE hWV).op ≫
            (homOfLE hW).op := Subsingleton.elim _ _
        rw [hk]
      rw [e]
      exact hψ WY Y₀ hW _
    | zero =>
      refine ((ψ₁.val.app (op Y₀)).hom.map_zero).trans ?_
      exact ((ψ₂.val.app (op Y₀)).hom.map_zero).symm
    | add a b _ _ ha hb =>
      refine ((ψ₁.val.app (op Y₀)).hom.map_add a b).trans ?_
      refine (congrArg₂ (· + ·) ha hb).trans ?_
      exact ((ψ₂.val.app (op Y₀)).hom.map_add a b).symm
    | smul r z _ hz =>
      refine ((ψ₁.val.app (op Y₀)).hom.map_smul r z).trans ?_
      refine (congrArg (r • ·) hz).trans ?_
      exact ((ψ₂.val.app (op Y₀)).hom.map_smul r z).symm
  exact key _ hspan

/-- Two morphisms between the restrictions to `V` of sheaves of modules `N` and `C` are equal
if they agree on the image of a locally surjective map `η : R ⟶ N.val.presheaf`. -/
theorem restricted_hom_ext_of_isLocallySurjective (V : Opens Xr)
    {N C : SheafOfModules.{u} (structureSheafRing Xr)}
    (ψ₁ ψ₂ : (moduleRestriction Xr V).obj N ⟶ (moduleRestriction Xr V).obj C)
    {R : (Opens Xr)ᵒᵖ ⥤ AddCommGrpCat.{u}} (η : R ⟶ N.val.presheaf)
    [Presheaf.IsLocallySurjective (Opens.grothendieckTopology Xr) η]
    (hη : ∀ (W : Opens ((Opens.toTopCat (Xr : TopCat)).obj V))
      (r : R.obj (op (openOfRestrict V W))),
      ψ₁.val.app (op W) (η.app (op (openOfRestrict V W)) r) =
        ψ₂.val.app (op W) (η.app (op (openOfRestrict V W)) r)) : ψ₁ = ψ₂ :=
  sub_eq_zero.mp (restricted_hom_eq_zero_of_isLocallySurjective V (ψ₁ - ψ₂) η
    fun W r => sub_eq_zero.mpr (hη W r))

end Restricted

variable {X Y S : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ S)

/-- **The pull back of forms on a pullback-unit section is the canonical map of Tag 07HX**:
`ρ(f⁻¹m) = f^*m`, the degree-`n` component of
`AlgebraicGeometry.Scheme.Hom.deRhamFormsPushforwardHom` on `m`. -/
theorem deRhamPullbackChain_f_unit_apply (n : ℕ) (V : Y.Opens)
    (m : ((Scheme.Hom.deRhamComplex g).X n).val.obj (op V)) :
    ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f n).val.app
        ((opensMap (relativeBase f g)).op.obj (op V))
      (((_root_.pullbackPushforwardAdjunction (relativeBase f g)).unit.app
        ((Scheme.Hom.deRhamComplex g).X n)).val.app (op V) m) =
      ((Stacks.DeRhamPullback.formsPushforwardComponent f g n).val.app (op V) m) := by
  have h2 : (_root_.pullbackPushforwardAdjunction (relativeBase f g)).unit.app
        ((Scheme.Hom.deRhamComplex g).X n) ≫
      (_root_.pushforward (relativeBase f g)).map
        ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f n) =
      Stacks.DeRhamPullback.formsPushforward f g n :=
    ((_root_.pullbackPushforwardAdjunction (relativeBase f g)).homEquiv_unit _ _
      ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f n)).symm.trans
      (congrArg (fun φ => HomologicalComplex.Hom.f φ n)
        (Equiv.apply_symm_apply (((_root_.pullbackPushforwardAdjunction
          (relativeBase f g)).mapHomologicalComplex (ComplexShape.up ℕ)).homEquiv _ _)
          (Stacks.DeRhamPullback.deRhamPushforwardChain f g)))
  have h3 := Stacks.DeRhamPullback.pushforwardSquareIso_inv_val_app f g
    (Scheme.Hom.relativeDifferentialForms (f ≫ g) (n : ℤ)) (op V)
    ((Stacks.DeRhamPullback.formsPushforwardComponent f g n).val.app (op V) m)
  exact (congrArg (fun φ => φ.val.app (op V) m) h2).trans h3

section Transpose

variable (U : Y.Opens)

/-- **`ρ(f⁻¹ω)` is the canonical map of Tag 07HX on `ω`**, restricted to an open inside `f⁻¹(U)`
and read in `Ω^p_{X/S}`. -/
theorem pulledBackForm_res_heq_formsPushforward (p : ℕ)
    (ω : ((Scheme.Hom.deRhamComplex g).X p).val.obj (op U))
    (W : Opens ((Opens.toTopCat (inverseImageBase (f ≫ g) : TopCat)).obj
      (pulledBackOpen f g U))) :
    ((deRhamDGA f g).complex.X (p : ℤ)).val.map
        (homOfLE (openOfRestrict_le (pulledBackOpen f g U) W)).op (pulledBackForm f g U p ω) ≍
      (Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val.map
        (homOfLE (openOfRestrict_le (pulledBackOpen f g U) W)).op
        ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω) := by
  have e1 : pulledBackForm f g U p ω = (deRhamSmoothExtendXIso f g p).inv.val.app
      (op (pulledBackOpen f g U))
      ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω) :=
    congrArg (fun t => (deRhamSmoothExtendXIso f g p).inv.val.app
      (op (pulledBackOpen f g U)) t) (deRhamPullbackChain_f_unit_apply f g p U ω)
  have e2 := PresheafOfModules.naturality_apply (deRhamSmoothExtendXIso f g p).inv.val
    (homOfLE (openOfRestrict_le (pulledBackOpen f g U) W)).op
    ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω)
  rw [e1]
  exact (heq_of_eq e2.symm).trans (extendXIso_inv_val_app_heq _ _ _ _)

/-- Left multiplication by `ρ(f⁻¹ω)` on a local section `x` of the de Rham complex of `X/S` is the
wedge product with the form `f^*ω`, up to `HEq`. -/
private theorem restrictedLeftMulCochain_v_app_heq_formProduct (p n n' : ℕ) (h : p + n = n')
    (ω : ((Scheme.Hom.deRhamComplex g).X p).val.obj (op U))
    (W : Opens ((Opens.toTopCat (inverseImageBase (f ≫ g) : TopCat)).obj
      (pulledBackOpen f g U)))
    (x : ((deRhamDGA f g).complex.X (n : ℤ)).val.obj
      (op (openOfRestrict (pulledBackOpen f g U) W)))
    (x' : ((Scheme.Hom.deRhamAlgebras (f ≫ g)).exteriorPower n).val.obj
      (op (openOfRestrict (pulledBackOpen f g U) W))) (hx : x ≍ x') :
    ((SheafOfModules.DifferentialGradedAlgebra.restrictedLeftMulCochain
        (X := inverseImageBase (f ≫ g)) (pulledBackOpen f g U) (deRhamDGA f g)
        (pulledBackForm f g U p ω)).v (n : ℤ) (n' : ℤ) (by omega)).val.app (op W) x ≍
      AlgebraicGeometry.SheafOfModules.formProduct (Scheme.Hom.deRhamAlgebras (f ≫ g)) p n
        (op (openOfRestrict (pulledBackOpen f g U) W))
        ((Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val.map
          (homOfLE (openOfRestrict_le (pulledBackOpen f g U) W)).op
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω)) x' :=
  (heq_of_eq (cochain_v_app_eq f g U p ω (n : ℤ) (n' : ℤ) (by omega) W x)).trans
    ((XIsoOfEq_hom_val_app_heq (deRhamDGA f g).complex
      (show (p : ℤ) + (n : ℤ) = (n' : ℤ) by omega) _ _).trans
      (AlgebraicGeometry.SheafOfModules.deRhamDifferentialGradedAlgebra_mul
        (Scheme.Hom.deRhamAlgebras (f ≫ g))
        (AlgebraicGeometry.SheafOfModules.deRhamDifferential
          (Scheme.Hom.deRhamAlgebras (f ≫ g))) p n _ _ _ _ _
        (pulledBackForm_res_heq_formsPushforward f g U p ω W) hx))

/-- **Left multiplication by `ρ(f⁻¹ω)` on pulled-back forms is the pull back of left
multiplication by `ω`**, on the restriction to `f⁻¹(U)` of `f⁻¹E` for any `𝒪_Y`-module `E`: if
`b = ω ∧ a` over `U` for two morphisms `a : E ⟶ Ω^k_{Y/S}` and `b : E ⟶ Ω^{k'}_{Y/S}`, then
`ρ(f⁻¹ω) ∧ ρ(f⁻¹a(-)) = ρ(f⁻¹b(-))`. The pull back of forms is multiplicative, being the
transpose of the homomorphism of graded algebras of Tag 07HX. -/
theorem restrictedLeftMulCochain_comp_pulledBack (p k k' : ℕ) (hk : p + k = k')
    (ω : ((Scheme.Hom.deRhamComplex g).X p).val.obj (op U)) {E : Modules Y.toRingedSpace}
    (a : E ⟶ Scheme.Hom.relativeDifferentialForms g (k : ℤ))
    (b : E ⟶ Scheme.Hom.relativeDifferentialForms g (k' : ℤ))
    (hab : (moduleRestriction Y.toRingedSpace U).map b =
      (moduleRestriction Y.toRingedSpace U).map a ≫
        restrictedFormsWedge g U ω (k : ℤ) (k' : ℤ) (by omega)) :
    (moduleRestriction (inverseImageBase (f ≫ g)) (pulledBackOpen f g U)).map
        ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map a) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k ≫
            (deRhamSmoothExtendXIso f g k).inv) ≫
      (SheafOfModules.DifferentialGradedAlgebra.restrictedLeftMulCochain
        (X := inverseImageBase (f ≫ g)) (pulledBackOpen f g U) (deRhamDGA f g)
        (pulledBackForm f g U p ω)).v (k : ℤ) (k' : ℤ) (by omega) =
    (moduleRestriction (inverseImageBase (f ≫ g)) (pulledBackOpen f g U)).map
        ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map b) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k' ≫
            (deRhamSmoothExtendXIso f g k').inv) := by
  refine restricted_modulePullback_hom_ext (relativeBase f g) U _ _ ?_
  intro WY W hW s
  -- the global morphisms, on the pullback-unit section `u(s)`
  have hA : ∀ (k₀ : ℕ) (c : E ⟶ Scheme.Hom.relativeDifferentialForms g (k₀ : ℤ)),
      ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map c) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k₀ ≫
            (deRhamSmoothExtendXIso f g k₀).inv).val.app
        (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY)))
        (PullbackUnitGenerators.pullbackUnitSection (relativeBase f g)
          ((pushforward (toInverseImageBase g)).obj E) (op (openOfRestrict U WY)) s) =
      (deRhamSmoothExtendXIso f g k₀).inv.val.app
        (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY)))
        ((Stacks.DeRhamPullback.formsPushforwardComponent f g k₀).val.app
          (op (openOfRestrict U WY)) (c.val.app (op (openOfRestrict U WY)) s)) := by
    intro k₀ c
    have e1 := pullback_map_unit_apply (relativeBase f g)
      ((pushforward (toInverseImageBase g)).map c) (openOfRestrict U WY) s
    have e2 := deRhamPullbackChain_f_unit_apply f g k₀ (openOfRestrict U WY)
      (c.val.app (op (openOfRestrict U WY)) s)
    exact (congrArg (fun t => (deRhamSmoothExtendXIso f g k₀).inv.val.app
      (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY)))
      (((Stacks.DeRhamPullback.deRhamPullbackChain f g).f k₀).val.app
        (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY))) t)) e1).trans
      (congrArg (fun t => (deRhamSmoothExtendXIso f g k₀).inv.val.app
        (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY))) t) e2)
  -- the global morphisms, on the restriction of the pullback-unit section `u(s)`
  have hE : ∀ (k₀ : ℕ) (c : E ⟶ Scheme.Hom.relativeDifferentialForms g (k₀ : ℤ)),
      ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map c) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k₀ ≫
            (deRhamSmoothExtendXIso f g k₀).inv).val.app
        (op (openOfRestrict ((Opens.map (relativeBase f g).hom.base).obj U) W))
        (((modulePullback (relativeBase f g)).obj
          ((pushforward (toInverseImageBase g)).obj E)).val.map (homOfLE hW).op
          (PullbackUnitGenerators.pullbackUnitSection (relativeBase f g)
            ((pushforward (toInverseImageBase g)).obj E) (op (openOfRestrict U WY)) s)) =
      (deRhamSmoothExtendXIso f g k₀).inv.val.app
        (op (openOfRestrict ((Opens.map (relativeBase f g).hom.base).obj U) W))
        ((Scheme.Hom.relativeDifferentialForms (f ≫ g) (k₀ : ℤ)).val.map (homOfLE hW).op
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g k₀).val.app
            (op (openOfRestrict U WY)) (c.val.app (op (openOfRestrict U WY)) s))) := by
    intro k₀ c
    have e1 := PresheafOfModules.naturality_apply
      ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map c) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k₀ ≫
            (deRhamSmoothExtendXIso f g k₀).inv).val (homOfLE hW).op
      (PullbackUnitGenerators.pullbackUnitSection (relativeBase f g)
            ((pushforward (toInverseImageBase g)).obj E) (op (openOfRestrict U WY)) s)
    have e2 := PresheafOfModules.naturality_apply (deRhamSmoothExtendXIso f g k₀).inv.val
      (homOfLE hW).op ((Stacks.DeRhamPullback.formsPushforwardComponent f g k₀).val.app
        (op (openOfRestrict U WY)) (c.val.app (op (openOfRestrict U WY)) s))
    rw [hA k₀ c] at e1
    exact e1.trans e2.symm
  -- `b(s) = ω ∧ a(s)` over `U`
  have hb : b.val.app (op (openOfRestrict U WY)) s ≍
      ((Scheme.Hom.relativeDifferentialFormsAlgebra g).mul (p : ℤ) (k : ℤ)).app
        (op (openOfRestrict U WY))
        ((Scheme.Hom.relativeDifferentialForms g (p : ℤ)).val.map
          (homOfLE (openOfRestrict_le U WY)).op ω)
        (a.val.app (op (openOfRestrict U WY)) s) := by
    have e := congrArg (fun φ => φ.val.app (op WY) s) hab
    have e1 : ((moduleRestriction Y.toRingedSpace U).map a ≫
        restrictedFormsWedge g U ω (k : ℤ) (k' : ℤ) (by omega)).val.app (op WY) s =
        ((moduleRestriction Y.toRingedSpace U).map (eqToHom (congrArg
          (AlgebraicGeometry.Scheme.Hom.relativeDifferentialFormsAlgebra g).piece
            (show (p : ℤ) + (k : ℤ) = (k' : ℤ) by omega)))).val.app (op WY)
          ((restrictedLeftMul U ((AlgebraicGeometry.Scheme.Hom.relativeDifferentialFormsAlgebra
            g).mul (p : ℤ) (k : ℤ)) ω).val.app (op WY) (a.val.app (op (openOfRestrict U WY)) s)) :=
      rfl
    refine (heq_of_eq (e.trans e1)).trans ((map_eqToHom_val_app_heq
      (moduleRestriction Y.toRingedSpace U) _ (op WY) _).trans ?_)
    exact heq_of_eq (restrictedLeftMul_app U _ ω WY _)
  -- the canonical map of Tag 07HX is multiplicative
  have hΦb : (Stacks.DeRhamPullback.formsPushforwardComponent f g k').val.app
        (op (openOfRestrict U WY)) (b.val.app (op (openOfRestrict U WY)) s) ≍
      ((Scheme.Hom.relativeDifferentialFormsAlgebra (f ≫ g)).mul (p : ℤ) (k : ℤ)).app
        (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY)))
        ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app
          (op (openOfRestrict U WY))
          ((Scheme.Hom.relativeDifferentialForms g (p : ℤ)).val.map
            (homOfLE (openOfRestrict_le U WY)).op ω))
        ((Stacks.DeRhamPullback.formsPushforwardComponent f g k).val.app
          (op (openOfRestrict U WY)) (a.val.app (op (openOfRestrict U WY)) s)) :=
    (unitalHom_app_heq (Scheme.Hom.deRhamFormsPushforwardHom f g (f ≫ g) (𝟙 S)
      ((Category.comp_id (f ≫ g)).symm)) (show ((k' : ℕ) : ℤ) = (p : ℤ) + (k : ℤ) by omega)
      (op (openOfRestrict U WY)) hb).trans
      (heq_of_eq ((Scheme.Hom.deRhamFormsPushforwardHom f g (f ≫ g) (𝟙 S)
        ((Category.comp_id (f ≫ g)).symm)).map_mul (p : ℤ) (k : ℤ) (op (openOfRestrict U WY))
          _ _))
  -- the right-hand side
  have hR : ((moduleRestriction (inverseImageBase (f ≫ g)) (pulledBackOpen f g U)).map
        ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map b) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k' ≫
            (deRhamSmoothExtendXIso f g k').inv)).val.app (op W)
        (((modulePullback (relativeBase f g)).obj
          ((pushforward (toInverseImageBase g)).obj E)).val.map (homOfLE hW).op
          (PullbackUnitGenerators.pullbackUnitSection (relativeBase f g)
            ((pushforward (toInverseImageBase g)).obj E) (op (openOfRestrict U WY)) s)) ≍
      ((Scheme.Hom.relativeDifferentialFormsAlgebra (f ≫ g)).piece ((p : ℤ) + (k : ℤ))).val.map
        (homOfLE hW).op
        (((Scheme.Hom.relativeDifferentialFormsAlgebra (f ≫ g)).mul (p : ℤ) (k : ℤ)).app
          (op ((Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY)))
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app
            (op (openOfRestrict U WY))
            ((Scheme.Hom.relativeDifferentialForms g (p : ℤ)).val.map
              (homOfLE (openOfRestrict_le U WY)).op ω))
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g k).val.app
            (op (openOfRestrict U WY)) (a.val.app (op (openOfRestrict U WY)) s))) := by
    refine (heq_of_eq (hE k' b)).trans ?_
    refine (extendXIso_inv_val_app_heq _ _ _ _).trans ?_
    exact gradedAlgebra_piece_map_heq (Scheme.Hom.relativeDifferentialFormsAlgebra (f ≫ g))
      (show ((k' : ℕ) : ℤ) = (p : ℤ) + (k : ℤ) by omega) (homOfLE hW).op hΦb
  -- the pulled-back form `ρ(f⁻¹ω)` is the canonical map of Tag 07HX on `ω`
  have hW' : openOfRestrict ((Opens.map (relativeBase f g).hom.base).obj U) W ≤
      (Opens.map (relativeBase f g).hom.base).obj U :=
    openOfRestrict_le _ W
  -- the left-hand side
  have hL : ((moduleRestriction (inverseImageBase (f ≫ g)) (pulledBackOpen f g U)).map
        ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map a) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k ≫
            (deRhamSmoothExtendXIso f g k).inv) ≫
      (SheafOfModules.DifferentialGradedAlgebra.restrictedLeftMulCochain
        (X := inverseImageBase (f ≫ g)) (pulledBackOpen f g U) (deRhamDGA f g)
        (pulledBackForm f g U p ω)).v (k : ℤ) (k' : ℤ) (by omega)).val.app (op W)
        (((modulePullback (relativeBase f g)).obj
          ((pushforward (toInverseImageBase g)).obj E)).val.map (homOfLE hW).op
          (PullbackUnitGenerators.pullbackUnitSection (relativeBase f g)
            ((pushforward (toInverseImageBase g)).obj E) (op (openOfRestrict U WY)) s)) ≍
      AlgebraicGeometry.SheafOfModules.formProduct (Scheme.Hom.deRhamAlgebras (f ≫ g)) p k
        (op (openOfRestrict ((Opens.map (relativeBase f g).hom.base).obj U) W))
        ((Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val.map (homOfLE hW').op
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω))
        ((Scheme.Hom.relativeDifferentialForms (f ≫ g) (k : ℤ)).val.map (homOfLE hW).op
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g k).val.app
            (op (openOfRestrict U WY)) (a.val.app (op (openOfRestrict U WY)) s))) := by
    refine (heq_of_eq (congrArg (fun t =>
      ((SheafOfModules.DifferentialGradedAlgebra.restrictedLeftMulCochain
        (X := inverseImageBase (f ≫ g)) (pulledBackOpen f g U) (deRhamDGA f g)
        (pulledBackForm f g U p ω)).v (k : ℤ) (k' : ℤ) (by omega)).val.app (op W) t)
      (hE k a))).trans ?_
    exact restrictedLeftMulCochain_v_app_heq_formProduct f g U p k k' (by omega) ω W _ _
      (extendXIso_inv_val_app_heq _ _ _ _)
  -- the two sides agree, by naturality of the wedge product and of the map of Tag 07HX
  have hΦω := PresheafOfModules.naturality_apply
    (Stacks.DeRhamPullback.formsPushforwardComponent f g p).val
    (homOfLE (openOfRestrict_le U WY)).op ω
  have hres : (Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val.map (homOfLE hW).op
      ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app
        (op (openOfRestrict U WY))
        ((Scheme.Hom.relativeDifferentialForms g (p : ℤ)).val.map
          (homOfLE (openOfRestrict_le U WY)).op ω)) =
      (Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val.map (homOfLE hW').op
        ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω) := by
    rw [hΦω]
    have h1 : (Opens.map (relativeBase f g).hom.base).obj (openOfRestrict U WY) ≤
        (Opens.map (relativeBase f g).hom.base).obj U :=
      fun x hx => openOfRestrict_le U WY hx
    exact (PresheafOfModules.map_comp_apply
      (Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val (homOfLE h1).op (homOfLE hW).op
      ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω)).symm
  have hmid :=
    ((Scheme.Hom.relativeDifferentialFormsAlgebra (f ≫ g)).mul (p : ℤ) (k : ℤ)).naturality
    (homOfLE hW).op
    ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app
      (op (openOfRestrict U WY))
      ((Scheme.Hom.relativeDifferentialForms g (p : ℤ)).val.map
        (homOfLE (openOfRestrict_le U WY)).op ω))
    ((Stacks.DeRhamPullback.formsPushforwardComponent f g k).val.app
      (op (openOfRestrict U WY)) (a.val.app (op (openOfRestrict U WY)) s))
  rw [hres] at hmid
  exact eq_of_heq (hL.trans ((heq_of_eq hmid).symm.trans hR.symm))

/-- `Stacks.DeRhamSmooth.restrictedLeftMulCochain_comp_pulledBack` on a local section, read as a
wedge product of forms. -/
theorem formProduct_pulledBack_heq (p k k' : ℕ) (hk : p + k = k')
    (ω : ((Scheme.Hom.deRhamComplex g).X p).val.obj (op U)) {E : Modules Y.toRingedSpace}
    (a : E ⟶ Scheme.Hom.relativeDifferentialForms g (k : ℤ))
    (b : E ⟶ Scheme.Hom.relativeDifferentialForms g (k' : ℤ))
    (hab : (moduleRestriction Y.toRingedSpace U).map b =
      (moduleRestriction Y.toRingedSpace U).map a ≫
        restrictedFormsWedge g U ω (k : ℤ) (k' : ℤ) (by omega))
    (W : Opens ((Opens.toTopCat (inverseImageBase (f ≫ g) : TopCat)).obj
      (pulledBackOpen f g U)))
    (x : ((_root_.pullback (relativeBase f g)).obj
      ((pushforward (toInverseImageBase g)).obj E)).val.obj
        (op (openOfRestrict (pulledBackOpen f g U) W))) :
    AlgebraicGeometry.SheafOfModules.formProduct (Scheme.Hom.deRhamAlgebras (f ≫ g)) p k
        (op (openOfRestrict (pulledBackOpen f g U) W))
        ((Scheme.Hom.relativeDifferentialForms (f ≫ g) (p : ℤ)).val.map
          (homOfLE (openOfRestrict_le (pulledBackOpen f g U) W)).op
          ((Stacks.DeRhamPullback.formsPushforwardComponent f g p).val.app (op U) ω))
        (((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map a) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k).val.app
            (op (openOfRestrict (pulledBackOpen f g U) W)) x) ≍
      ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map b) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f k').val.app
            (op (openOfRestrict (pulledBackOpen f g U) W)) x := by
  have e := congrArg (fun φ => φ.val.app (op W) x)
    (restrictedLeftMulCochain_comp_pulledBack f g U p k k' hk ω a b hab)
  refine (restrictedLeftMulCochain_v_app_heq_formProduct f g U p k k' hk ω W _ _
    (extendXIso_inv_val_app_heq _ _ _ _)).symm.trans ((heq_of_eq e).trans ?_)
  exact extendXIso_inv_val_app_heq _ _ _ _

section Summand

attribute [local instance] AlgebraicGeometry.SheafOfModules.hasSheafifyOpens
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijectiveOpens

/-- **Left multiplication by `ρ(f⁻¹ω)` on the wedge summand of pulled-back forms**: on
`f⁻¹E ⊗ Ω^q_{X/S}`, read in `Ω^n_{X/S}` by `x ⊗ y ↦ ρ(f⁻¹a(x)) ∧ y`, left multiplication by
`ρ(f⁻¹ω)` is the same summand for `b`, if `b = ω ∧ a` over `U`: the exterior algebra of
`Ω_{X/S}` is associative (`Stacks.DeRhamSmooth.formProduct_pulledBack_heq`). -/
theorem restrictedLeftMulCochain_comp_summand_pulledBack (p k k' q n n' : ℕ) (hk : p + k = k')
    (hn : k + q = n) (hn' : k' + q = n')
    (ω : ((Scheme.Hom.deRhamComplex g).X p).val.obj (op U)) {E : Modules Y.toRingedSpace}
    (a : E ⟶ Scheme.Hom.relativeDifferentialForms g (k : ℤ))
    (b : E ⟶ Scheme.Hom.relativeDifferentialForms g (k' : ℤ))
    (hab : (moduleRestriction Y.toRingedSpace U).map b =
      (moduleRestriction Y.toRingedSpace U).map a ≫
        restrictedFormsWedge g U ω (k : ℤ) (k' : ℤ) (by omega)) :
    (moduleRestriction (inverseImageBase (f ≫ g)) (pulledBackOpen f g U)).map
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
            ((_root_.pullback (relativeBase f g)).map
              ((pushforward (toInverseImageBase g)).map a))).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q) ≫
          ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
              ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f k)).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q) ≫
          AlgebraicGeometry.SheafOfModules.exteriorProductComponent
            (Scheme.Hom.deRhamAlgebras (f ≫ g)) k q ≫
          ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).XIsoOfEq hn).hom ≫
          (deRhamSmoothExtendXIso f g n).inv) ≫
      (SheafOfModules.DifferentialGradedAlgebra.restrictedLeftMulCochain
        (X := inverseImageBase (f ≫ g)) (pulledBackOpen f g U) (deRhamDGA f g)
        (pulledBackForm f g U p ω)).v (n : ℤ) (n' : ℤ) (by omega) =
    (moduleRestriction (inverseImageBase (f ≫ g)) (pulledBackOpen f g U)).map
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
            ((_root_.pullback (relativeBase f g)).map
              ((pushforward (toInverseImageBase g)).map b))).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q) ≫
          ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
              ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f k')).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q) ≫
          AlgebraicGeometry.SheafOfModules.exteriorProductComponent
            (Scheme.Hom.deRhamAlgebras (f ≫ g)) k' q ≫
          ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).XIsoOfEq hn').hom ≫
          (deRhamSmoothExtendXIso f g n').inv) := by
  refine @restricted_hom_ext_of_isLocallySurjective _ (pulledBackOpen f g U) _ _ _ _ _
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
      (PresheafOfModules.tensorObj
        ((_root_.pullback (relativeBase f g)).obj ((pushforward (toInverseImageBase g)).obj E)).val
        ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
          (AlgebraicGeometry.SheafOfModules.deRhamDifferential
            (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q).val).presheaf)
    (Presheaf.isLocallySurjective_toSheafify' (Opens.grothendieckTopology X) _) ?_
  intro W r
  induction r using TensorProduct.induction_on with
  | zero => exact (congrArg _ (map_zero _)).trans ((map_zero _).trans
      ((congrArg _ (map_zero _)).trans (map_zero _)).symm)
  | add a b ha hb => exact (congrArg _ (map_add _ a b)).trans ((map_add _ _ _).trans
      ((congrArg₂ (· + ·) ha hb).trans ((congrArg _ (map_add _ a b)).trans
        (map_add _ _ _)).symm))
  | tmul x y =>
    have hM : ∀ (c m : ℕ) (hcm : c + q = m)
        (d : E ⟶ Scheme.Hom.relativeDifferentialForms g (c : ℤ)),
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
            ((_root_.pullback (relativeBase f g)).map
              ((pushforward (toInverseImageBase g)).map d))).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex
              (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q) ≫
          ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
              ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f c)).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex
              (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q) ≫
          AlgebraicGeometry.SheafOfModules.exteriorProductComponent
            (Scheme.Hom.deRhamAlgebras (f ≫ g)) c q ≫
          ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).XIsoOfEq hcm).hom ≫
            (deRhamSmoothExtendXIso f g m).inv).val.app
            (op (openOfRestrict (pulledBackOpen f g U) W))
          (((PresheafOfModules.sheafificationAdjunction
            (R := Stacks.SheafOfModules.Tensor.ringSheaf
              ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf))
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf
              ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).obj)).unit.app
            (PresheafOfModules.tensorObj
              ((_root_.pullback (relativeBase f g)).obj
                ((pushforward (toInverseImageBase g)).obj E)).val
              ((AlgebraicGeometry.SheafOfModules.deRhamComplex
                (Scheme.Hom.deRhamAlgebras (f ≫ g))
                (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                  (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q).val)).app
            (op (openOfRestrict (pulledBackOpen f g U) W)) (x ⊗ₜ y)) =
        (deRhamSmoothExtendXIso f g m).inv.val.app (op (openOfRestrict (pulledBackOpen f g U) W))
          (((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).XIsoOfEq hcm).hom.val.app
              (op (openOfRestrict (pulledBackOpen f g U) W))
            (AlgebraicGeometry.SheafOfModules.formProduct (Scheme.Hom.deRhamAlgebras (f ≫ g)) c q
              (op (openOfRestrict (pulledBackOpen f g U) W))
              (((_root_.pullback (relativeBase f g)).map
                ((pushforward (toInverseImageBase g)).map d) ≫
                  (Stacks.DeRhamPullback.deRhamPullbackChain f g).f c).val.app
                (op (openOfRestrict (pulledBackOpen f g U) W)) x) y)) := by
      intro c m hcm d
      have e1 := AlgebraicGeometry.SheafOfModules.tensorFunctor_map_unit_apply
        (N := (AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q)
        ((_root_.pullback (relativeBase f g)).map ((pushforward (toInverseImageBase g)).map d))
        (op (openOfRestrict (pulledBackOpen f g U) W)) x y
      have e2 := AlgebraicGeometry.SheafOfModules.tensorFunctor_map_unit_apply
        (N := (AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q)
        ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f c)
        (op (openOfRestrict (pulledBackOpen f g U) W))
        (((_root_.pullback (relativeBase f g)).map
          ((pushforward (toInverseImageBase g)).map d)).val.app
          (op (openOfRestrict (pulledBackOpen f g U) W)) x) y
      have e3 := AlgebraicGeometry.SheafOfModules.exteriorProductComponent_unit_apply
        (Scheme.Hom.deRhamAlgebras (f ≫ g)) c q (op (openOfRestrict (pulledBackOpen f g U) W))
        (((_root_.pullback (relativeBase f g)).map
            ((pushforward (toInverseImageBase g)).map d) ≫
          (Stacks.DeRhamPullback.deRhamPullbackChain f g).f c).val.app
            (op (openOfRestrict (pulledBackOpen f g U) W)) x) y
      refine congrArg (fun z => (deRhamSmoothExtendXIso f g m).inv.val.app
        (op (openOfRestrict (pulledBackOpen f g U) W))
        (((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).XIsoOfEq hcm).hom.val.app
          (op (openOfRestrict (pulledBackOpen f g U) W)) z)) ?_
      refine (congrArg (fun z => (AlgebraicGeometry.SheafOfModules.exteriorProductComponent
        (Scheme.Hom.deRhamAlgebras (f ≫ g)) c q).val.app
          (op (openOfRestrict (pulledBackOpen f g U) W))
          ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            ((TopCat.Sheaf.pullback CommRingCat.{u} (f ≫ g).base).obj S.sheaf)).map
              ((Stacks.DeRhamPullback.deRhamPullbackChain f g).f c)).app
            ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X q)).val.app
            (op (openOfRestrict (pulledBackOpen f g U) W)) z)) e1).trans ?_
      refine (congrArg (fun z => (AlgebraicGeometry.SheafOfModules.exteriorProductComponent
        (Scheme.Hom.deRhamAlgebras (f ≫ g)) c q).val.app
          (op (openOfRestrict (pulledBackOpen f g U) W)) z) e2).trans ?_
      exact e3
    have hX : ∀ (m m' : ℕ) (h : m = m')
        (z : ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).X m).val.obj
                  (op (openOfRestrict (pulledBackOpen f g U) W))),
        ((AlgebraicGeometry.SheafOfModules.deRhamComplex (Scheme.Hom.deRhamAlgebras (f ≫ g))
              (AlgebraicGeometry.SheafOfModules.deRhamDifferential
                (Scheme.Hom.deRhamAlgebras (f ≫ g)))).XIsoOfEq h).hom.val.app
          (op (openOfRestrict (pulledBackOpen f g U) W)) z ≍ z := by
      intro m m' h z
