module

public import StacksFrontier.AlgebraicGeometry.Blowup.IsoOffCentre
public import StacksFrontier.AlgebraicGeometry.Blowup.SecondCentreChartCover
public import StacksFrontier.AlgebraicGeometry.DeRham.BlowupDifferentialFormsComparison
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CoordinateBlowupSmooth

/-!
# The standard charts of the coordinate blowup and their intersections

Fix a ring `R` and integers `m, n`, let `A = R[x₁, …, x_m, y₁, …, y_n]`, `X = Spec A`, and let
`b : L ⟶ X` be the blowing up of `X` along the coordinate subspace `y₁ = ⋯ = y_n = 0`. For each
`j` the standard affine chart `L_j ⊆ L` of [Stacks, Tag 0804] at the section `y_j` of the centre
is the open on which `y_j` generates the exceptional ideal. This file records the facts about
these charts that a Čech computation on `L` needs:

* the `n` charts cover `L`;
* on `L_j` the pullback of `y_k` is the pullback of `y_j` times a section `t_{jk}`, and
  `L_j ∩ L_k` is the basic open of `t_{jk}` in `L_j`; hence every finite intersection of charts is
  a basic open of one of them, in particular an affine open;
* the open `W₀ = b⁻¹(D(y₁ ⋯ y_n))` lies in every chart, and `b` identifies the functions on `W₀`
  with those on `D(y₁ ⋯ y_n)`.

## Main definitions

* `Stacks.DeRham.CoordinateCech.chart`: the chart `L_j`.
* `Stacks.DeRham.CoordinateCech.ratio`: the section `t_{jk}` of `𝒪_L` over `L_j`.
* `Stacks.DeRham.CoordinateCech.punctured`: the open `W₀`.

## Main results

* `Stacks.DeRham.CoordinateCech.iSup_chart`: the charts cover the blowup.
* `Stacks.DeRham.CoordinateCech.chart_inf_chart`: `L_j ∩ L_k` is the basic open of `t_{jk}`.
* `Stacks.DeRham.CoordinateCech.isAffineOpen_iInf_chart`: every nonempty finite intersection of
  charts is affine.
* `Stacks.DeRham.CoordinateCech.punctured_le_chart`: `W₀` lies in every chart.

## References

* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
* [Stacks Project, Tag 0BFL](https://stacks.math.columbia.edu/tag/0BFL)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.DeRham.CoordinateCech

variable (R : Type u) [CommRing R] (m n : ℕ)

/-- The coordinate `y_j`, as a section of the centre of the blowup over the whole of `X`. -/
abbrev centreSection (j : Fin n) :
    (Stacks.MoreMorphisms.coordinateIdeal R m n).ideal
      (Stacks.MoreMorphisms.topAffineOpen R m n) :=
  ⟨Stacks.MoreMorphisms.coordinateSection R m n j,
    Stacks.MoreMorphisms.coordinateSection_mem R m n j⟩

/-- **The standard chart `L_j`** of the coordinate blowup at the coordinate `y_j`. -/
abbrev chart (j : Fin n) : (coordinateBlowup R m n).Opens :=
  (blowUpChartOpen (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j)).1

/-- The chart `L_j` is an affine open. -/
theorem isAffineOpen_chart (j : Fin n) : IsAffineOpen (chart R m n j) :=
  (blowUpChartOpen (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j)).2

/-- Pulling a function on `X` back to the chart `L_j`. -/
abbrev chartMap (j : Fin n) :
    Γ(coordinateAmbient R m n, ⊤) ⟶ Γ(coordinateBlowup R m n, chart R m n j) :=
  blowUpChartMap (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j)

/-- The coordinate `y_j` as a global function on `X`. -/
abbrev coord (j : Fin n) : Γ(coordinateAmbient R m n, ⊤) :=
  Stacks.MoreMorphisms.coordinateSection R m n j

/-- The ideal of the centre on the whole of `X` is generated by the coordinates `y_j`. -/
theorem ideal_top_eq_span :
    (Stacks.MoreMorphisms.coordinateIdeal R m n).ideal (Stacks.MoreMorphisms.topAffineOpen R m n)
      = Ideal.span (Set.range (coord R m n)) := by
  rw [Stacks.MoreMorphisms.coordinateIdeal_ideal_top, Stacks.MoreMorphisms.coordinateRingIdeal,
    Ideal.map_span, ← Set.range_comp]
  rfl

/-- **The `n` standard charts cover the blowup**, as soon as there is at least one of them. -/
theorem iSup_chart (hn : 0 < n) : ⨆ j, chart R m n j = ⊤ := by
  classical
  have h := iSup_blowUpChartOpen (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (Finset.univ.image (centreSection R m n))
    (Finset.univ_nonempty_iff.2 ⟨⟨0, hn⟩⟩ |>.image _) (by
      refine Eq.trans ?_ (ideal_top_eq_span R m n).symm
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, ← Set.range_comp]
      rfl)
  rw [Finset.iSup_finset_image] at h
  refine eq_top_iff.2 ?_
  have htop : (⊤ : (coordinateBlowup R m n).Opens) ≤
      blowUpToBase (Stacks.MoreMorphisms.coordinateIdeal R m n) ⁻¹ᵁ
        (Stacks.MoreMorphisms.topAffineOpen R m n).1 := fun _ _ => trivial
  exact htop.trans (h.symm.le.trans (iSup_le fun j => iSup_le fun _ =>
    le_iSup (fun j => chart R m n j) j))

/-! ### The ratios of the coordinates on a chart -/

/-- Every coordinate lies in the ideal of the centre on `X`. -/
theorem coord_mem (k : Fin n) :
    coord R m n k ∈ (Stacks.MoreMorphisms.coordinateIdeal R m n).ideal
      (Stacks.MoreMorphisms.topAffineOpen R m n) ^ 1 := by
  simpa using Stacks.MoreMorphisms.coordinateSection_mem R m n k

/-- **The ratio `t_{jk} = y_k / y_j`** on the chart `L_j`: a section of `𝒪_L` over `L_j` whose
product with the pullback of `y_j` is the pullback of `y_k`. -/
def ratio (j k : Fin n) : Γ(coordinateBlowup R m n, chart R m n j) :=
  (exists_mul_eq_blowUpChartMap_of_mem_pow (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j) (coord_mem R m n k)).choose

/-- The defining property of the ratio: `y_k = y_j · t_{jk}` on `L_j`. -/
theorem chartMap_coord_eq (j k : Fin n) :
    (chartMap R m n j).hom (coord R m n k) =
      ratio R m n j k * (chartMap R m n j).hom (coord R m n j) :=
  (exists_mul_eq_blowUpChartMap_of_mem_pow (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j)
    (coord_mem R m n k)).choose_spec.trans ((congrArg (· * _) (pow_one _)).trans (mul_comm _ _))

/-- The pullback of `y_j` to its own chart is a nonzerodivisor. -/
theorem chartMap_coord_self_mem_nonZeroDivisors (j : Fin n) :
    (chartMap R m n j).hom (coord R m n j) ∈
      nonZeroDivisors Γ(coordinateBlowup R m n, chart R m n j) :=
  blowUpChartMap_self_mem_nonZeroDivisors (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j)

/-- The basic open of the ratio `t_{jk}` lies in the chart `L_k`. -/
theorem basicOpen_ratio_le (j k : Fin n) :
    (coordinateBlowup R m n).basicOpen (ratio R m n j k) ≤ chart R m n k :=
  basicOpen_le_blowUpChartOpen (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j) (centreSection R m n k)
    (ratio R m n j k) (chartMap_coord_eq R m n j k)

/-- The germ at a point of `L_j` of the pullback of `y_j` is a nonzerodivisor of the local
ring there. -/
theorem germ_chartMap_coord_mem_nonZeroDivisors (j : Fin n) (x : coordinateBlowup R m n)
    (hx : x ∈ chart R m n j) :
    (coordinateBlowup R m n).presheaf.germ (chart R m n j) x hx
        ((chartMap R m n j).hom (coord R m n j)) ∈
      nonZeroDivisors ((coordinateBlowup R m n).presheaf.stalk x) := by
  let := (coordinateBlowup R m n).presheaf.algebra_section_stalk ⟨x, hx⟩
  have := (isAffineOpen_chart R m n j).isLocalization_stalk ⟨x, hx⟩
  exact IsLocalization.map_nonZeroDivisors_le
    ((isAffineOpen_chart R m n j).primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl _
    (Submonoid.mem_map_of_mem _ (chartMap_coord_self_mem_nonZeroDivisors R m n j))

/-- If `g` is a nonzerodivisor and `t * g` generates the same principal ideal as `g`, then `t` is
a unit. -/
theorem isUnit_of_span_singleton_mul_eq {A : Type*} [CommRing A] {g t : A}
    (hg : g ∈ nonZeroDivisors A) (h : Ideal.span {t * g} = Ideal.span {g}) : IsUnit t := by
  have hmem : g ∈ Ideal.span {t * g} := by
    rw [h]
    exact Ideal.mem_span_singleton_self g
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hmem
  exact IsUnit.of_mul_eq_one_right c (sub_eq_zero.1 (mem_nonZeroDivisors_iff_right.1 hg _
    (by rw [sub_mul, one_mul, mul_assoc, hc, sub_self])))

/-- **On the intersection of two charts the ratio is invertible.** At a point of `L_j ∩ L_k`
both `y_j` and `y_k` generate the stalk of the exceptional ideal ([Stacks, Tag 0BFL]), so their
quotient `t_{jk}` is a unit there. -/
theorem chart_inf_chart_le_basicOpen (j k : Fin n) :
    chart R m n j ⊓ chart R m n k ≤ (coordinateBlowup R m n).basicOpen (ratio R m n j k) := by
  rintro x ⟨hxj, hxk⟩
  have hxU : blowUpToBase (Stacks.MoreMorphisms.coordinateIdeal R m n) x ∈
      (Stacks.MoreMorphisms.topAffineOpen R m n).1 := trivial
  have hj := (mem_blowUpChartOpen_iff (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j) x hxU).1 hxj
  have hk := (mem_blowUpChartOpen_iff (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n k) x hxU).1 hxk
  rw [(coordinateBlowup R m n).mem_basicOpen _ x hxj]
  set gj := (coordinateBlowup R m n).presheaf.germ (chart R m n j) x hxj
    ((chartMap R m n j).hom (coord R m n j))
  set t := (coordinateBlowup R m n).presheaf.germ (chart R m n j) x hxj (ratio R m n j k)
  have hgk : (coordinateBlowup R m n).presheaf.germ (chart R m n j) x hxj
      ((chartMap R m n j).hom (coord R m n k)) = t * gj := by
    rw [chartMap_coord_eq R m n j k, map_mul]
  rw [← germ_blowUpChartMap (Stacks.MoreMorphisms.coordinateIdeal R m n)
    (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j) x hxj] at hj hk
  change _ = Ideal.span {gj} at hj
  change _ = Ideal.span (singleton ((coordinateBlowup R m n).presheaf.germ (chart R m n j) x hxj
      ((chartMap R m n j).hom (coord R m n k)))) at hk
  rw [hgk] at hk
  exact isUnit_of_span_singleton_mul_eq (germ_chartMap_coord_mem_nonZeroDivisors R m n j x hxj)
    (hk.symm.trans hj)

/-- **The intersection of two charts is a basic open of the first.** -/
theorem chart_inf_chart (j k : Fin n) :
    chart R m n j ⊓ chart R m n k = (coordinateBlowup R m n).basicOpen (ratio R m n j k) :=
  le_antisymm (chart_inf_chart_le_basicOpen R m n j k)
    (le_inf ((coordinateBlowup R m n).basicOpen_le _) (basicOpen_ratio_le R m n j k))

/-- The basic open of a finite product of sections is the intersection of the basic opens. -/
theorem basicOpen_prod {Y : Scheme.{u}} {V : Y.Opens} {ι : Type*} (s : Finset ι)
    (f : ι → Γ(Y, V)) :
    Y.basicOpen (∏ k ∈ s, f k) = V ⊓ ⨅ k ∈ s, Y.basicOpen (f k) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Scheme.basicOpen_mul, ih, Finset.iInf_insert]
    exact inf_left_comm _ _ _

/-- The product of the ratios selecting the members of a tuple of chart indices. -/
def tupleRatio {p : ℕ} (x : Fin (p + 1) → Fin n) : Γ(coordinateBlowup R m n, chart R m n (x 0)) :=
  ∏ k, ratio R m n (x 0) (x k)

/-- **A nonempty finite intersection of charts is a basic open of its first member.** -/
theorem iInf_chart {p : ℕ} (x : Fin (p + 1) → Fin n) :
    ⨅ k, chart R m n (x k) = (coordinateBlowup R m n).basicOpen (tupleRatio R m n x) := by
  rw [tupleRatio, basicOpen_prod]
  simp only [Finset.mem_univ, iInf_true]
  refine le_antisymm (le_inf (iInf_le _ 0) (le_iInf fun k => ?_)) (le_iInf fun k => ?_)
  · rw [← chart_inf_chart]
    exact le_inf (iInf_le _ 0) (iInf_le _ k)
  · exact inf_le_right.trans ((iInf_le _ k).trans (basicOpen_ratio_le R m n (x 0) (x k)))

/-- **Every nonempty finite intersection of charts is affine.** -/
theorem isAffineOpen_iInf_chart {p : ℕ} (x : Fin (p + 1) → Fin n) :
    IsAffineOpen (⨅ k, chart R m n (x k)) := by
  rw [iInf_chart]
  exact (isAffineOpen_chart R m n (x 0)).basicOpen _

/-! ### The open `W₀ = b⁻¹(D(y₁ ⋯ y_n))` -/

/-- The product `y₁ ⋯ y_n` of the coordinates, as a global function on `X`. -/
abbrev coordProd : Γ(coordinateAmbient R m n, ⊤) := ∏ j, coord R m n j

/-- **The open `W₀`**: the inverse image in the blowup of the locus `D(y₁ ⋯ y_n) ⊆ X` where every
coordinate `y_j` is invertible. -/
abbrev punctured : (coordinateBlowup R m n).Opens :=
  coordinateBlowupToAmbient R m n ⁻¹ᵁ (coordinateAmbient R m n).basicOpen (coordProd R m n)

/-- At a point of `D(y₁ ⋯ y_n)` each coordinate is invertible. -/
theorem isUnit_germ_coord {z : coordinateAmbient R m n}
    (hz : z ∈ (coordinateAmbient R m n).basicOpen (coordProd R m n)) (k : Fin n) :
    IsUnit ((coordinateAmbient R m n).presheaf.germ ⊤ z trivial (coord R m n k)) := by
  have h := ((coordinateAmbient R m n).mem_basicOpen (U := ⊤) (coordProd R m n) z trivial).1 hz
  rw [coordProd, map_prod] at h
  exact IsUnit.prod_univ_iff.1 h k

/-- **`W₀` lies in every chart.** A point of `W₀` lies on some chart `L_k`; there
`y_j = t_{kj} · y_k`, and `y_j` is invertible at the point, hence so is `t_{kj}`, and the basic
open of `t_{kj}` lies in `L_j`. -/
theorem punctured_le_chart (hn : 0 < n) (j : Fin n) : punctured R m n ≤ chart R m n j := by
  intro x hx
  have hxtop : x ∈ ⨆ k, chart R m n k := by
    rw [iSup_chart R m n hn]
    trivial
  obtain ⟨k, hxk⟩ := Opens.mem_iSup.1 hxtop
  refine basicOpen_ratio_le R m n k j ?_
  rw [(coordinateBlowup R m n).mem_basicOpen _ x hxk]
  have hj : IsUnit ((coordinateBlowup R m n).presheaf.germ (chart R m n k) x hxk
      ((chartMap R m n k).hom (coord R m n j))) := by
    rw [germ_blowUpChartMap (Stacks.MoreMorphisms.coordinateIdeal R m n)
      (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n k) x hxk]
    exact (isUnit_germ_coord R m n hx j).map _
  rw [chartMap_coord_eq R m n k j, map_mul] at hj
  exact isUnit_of_mul_isUnit_left hj

/-- `D(y₁ ⋯ y_n)` misses the centre of the blowup. -/
theorem basicOpen_coordProd_le_compl_support (hn : 0 < n) :
    (coordinateAmbient R m n).basicOpen (coordProd R m n) ≤
      (Stacks.MoreMorphisms.coordinateIdeal R m n).support.compl := by
  intro z hz hzs'
  have hzs := (Scheme.IdealSheafData.mem_support_iff_of_mem
    (U := Stacks.MoreMorphisms.topAffineOpen R m n) trivial).1 hzs'
  rw [Scheme.mem_zeroLocus_iff] at hzs
  exact hzs _ (Stacks.MoreMorphisms.coordinateSection_mem R m n ⟨0, hn⟩)
    (((coordinateAmbient R m n).mem_basicOpen (U := ⊤) (coord R m n ⟨0, hn⟩) z trivial).2
      (isUnit_germ_coord R m n hz ⟨0, hn⟩))

/-- **The blowup identifies the functions on `W₀` with those on `D(y₁ ⋯ y_n)`.** The blowup is
an isomorphism away from its centre ([Stacks, Tag 02OS] (1)). -/
theorem isIso_app_basicOpen_coordProd (hn : 0 < n) :
    IsIso ((coordinateBlowupToAmbient R m n).app
      ((coordinateAmbient R m n).basicOpen (coordProd R m n))) := by
  let U : (coordinateAmbient R m n).Opens :=
    (Stacks.MoreMorphisms.coordinateIdeal R m n).support.compl
  have hD : U.ι ''ᵁ (U.ι ⁻¹ᵁ (coordinateAmbient R m n).basicOpen (coordProd R m n)) =
      (coordinateAmbient R m n).basicOpen (coordProd R m n) := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.2 (basicOpen_coordProd_le_compl_support R m n hn)
  have h : IsIso ((blowUpToBase (Stacks.MoreMorphisms.coordinateIdeal R m n) ∣_ U).app
        (U.ι ⁻¹ᵁ (coordinateAmbient R m n).basicOpen (coordProd R m n))) :=
    inferInstance
  rw [morphismRestrict_app] at h
  have h2 : IsIso (Scheme.Hom.app (blowUpToBase (Stacks.MoreMorphisms.coordinateIdeal R m n))
      (U.ι ''ᵁ U.ι ⁻¹ᵁ (coordinateAmbient R m n).basicOpen (coordProd R m n))) :=
    @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (Functor.map_isIso _ _) h
  rwa [hD] at h2

/-- The ring of functions on `D(y₁ ⋯ y_n)`, in which every coordinate is invertible. -/
abbrev Frac : CommRingCat.{u} := Γ(coordinateAmbient R m n,
  (coordinateAmbient R m n).basicOpen (coordProd R m n))

/-- Restricting a global function on `X` to `D(y₁ ⋯ y_n)`. -/
abbrev toFrac : Γ(coordinateAmbient R m n, ⊤) →+* Frac R m n :=
  ((coordinateAmbient R m n).presheaf.map (homOfLE le_top).op).hom

/-- **The functions on `W₀`, read on `D(y₁ ⋯ y_n)`**: the inverse of the isomorphism induced by
the blowup. -/
def puncturedEquiv (hn : 0 < n) : Γ(coordinateBlowup R m n, punctured R m n) ≃+* Frac R m n :=
  haveI := isIso_app_basicOpen_coordProd R m n hn
  (asIso ((coordinateBlowupToAmbient R m n).app
    ((coordinateAmbient R m n).basicOpen (coordProd R m n)))).commRingCatIsoToRingEquiv.symm

/-- Restricting a function from an open containing `W₀` to `W₀`. -/
abbrev resPunctured {V : (coordinateBlowup R m n).Opens} (h : punctured R m n ≤ V) :
    Γ(coordinateBlowup R m n, V) →+* Γ(coordinateBlowup R m n, punctured R m n) :=
  ((coordinateBlowup R m n).presheaf.map (homOfLE h).op).hom

/-- The pullback of a function on `X` to a chart, read on `D(y₁ ⋯ y_n)`, is the function itself. -/
theorem puncturedEquiv_resPunctured_chartMap (hn : 0 < n) (j : Fin n)
    (r : Γ(coordinateAmbient R m n, ⊤)) :
    puncturedEquiv R m n hn (resPunctured R m n (punctured_le_chart R m n hn j)
      ((chartMap R m n j).hom r)) = toFrac R m n r := by
  rw [puncturedEquiv, RingEquiv.symm_apply_eq]
  show _ = ((coordinateBlowupToAmbient R m n).app _).hom (toFrac R m n r)
  rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map,
    Scheme.Hom.app_eq_appLE, Scheme.Hom.map_appLE]

/-- Every coordinate is invertible on `D(y₁ ⋯ y_n)`. -/
theorem isUnit_toFrac_coord (k : Fin n) : IsUnit (toFrac R m n (coord R m n k)) := by
  have h : IsUnit (toFrac R m n (coordProd R m n)) :=
    (coordinateAmbient R m n).toRingedSpace.isUnit_res_basicOpen (coordProd R m n)
  rw [coordProd, map_prod] at h
  exact IsUnit.prod_univ_iff.1 h k

/-! ### The functions on an intersection of charts, read on `D(y₁ ⋯ y_n)` -/

/-- The product `y₁ ⋯ y_n` is a nonzerodivisor of the coordinate ring. -/
theorem coordProd_mem_nonZeroDivisors :
    coordProd R m n ∈ nonZeroDivisors Γ(coordinateAmbient R m n, ⊤) := by
  have h : ∀ k : Fin n, IsRegular (coord R m n k) := fun k => by
    set e := Stacks.MoreMorphisms.gammaEquiv R m n
    have hX : IsRegular (MvPolynomial.X (Sum.inr k) : MvPolynomial (Fin m ⊕ Fin n) R) :=
      MvPolynomial.isRegular_X
    refine ⟨fun u v huv => e.symm.injective (hX.1 ?_),
      fun u v huv => e.symm.injective (hX.2 ?_)⟩ <;>
      have := congrArg e.symm huv <;>
      rwa [map_mul, map_mul, RingEquiv.symm_apply_apply] at this
  rw [← isRegular_iff_mem_nonZeroDivisors, coordProd]
  exact IsRegular.prod fun k _ => h k

/-- Restricting a global function on `X` to `D(y₁ ⋯ y_n)` is injective. -/
theorem toFrac_injective : Function.Injective (toFrac R m n) := by
  have := (isAffineOpen_top (coordinateAmbient R m n)).isLocalization_basicOpen (coordProd R m n)
  exact IsLocalization.injective (M := Submonoid.powers (coordProd R m n)) _
    (Submonoid.powers_le.2 (coordProd_mem_nonZeroDivisors R m n))

/-- **The functions on an open `V ⊇ W₀`, read on `D(y₁ ⋯ y_n)`.** -/
def toFracOf {V : (coordinateBlowup R m n).Opens} (hn : 0 < n) (h : punctured R m n ≤ V) :
    Γ(coordinateBlowup R m n, V) →+* Frac R m n :=
  (puncturedEquiv R m n hn).toRingHom.comp (resPunctured R m n h)

/-- Reading a function on `D(y₁ ⋯ y_n)` is compatible with restriction. -/
theorem toFracOf_res {V V' : (coordinateBlowup R m n).Opens} (hn : 0 < n)
    (h : punctured R m n ≤ V') (hVV' : V' ≤ V) (z : Γ(coordinateBlowup R m n, V)) :
    toFracOf R m n hn h (((coordinateBlowup R m n).presheaf.map (homOfLE hVV').op).hom z) =
      toFracOf R m n hn (h.trans hVV') z := by
  simp only [toFracOf, RingHom.comp_apply, resPunctured, ← CommRingCat.comp_apply,
    ← Functor.map_comp]
  rfl

/-- The pullback of a function on `X` to a chart, read on `D(y₁ ⋯ y_n)`, is the function. -/
theorem toFracOf_chartMap (hn : 0 < n) (j : Fin n) (r : Γ(coordinateAmbient R m n, ⊤)) :
    toFracOf R m n hn (punctured_le_chart R m n hn j) ((chartMap R m n j).hom r) =
      toFrac R m n r :=
  puncturedEquiv_resPunctured_chartMap R m n hn j r

/-- A chart equation `w · y_jᴺ = a`, read on `D(y₁ ⋯ y_n)`. -/
theorem toFracOf_chart_mul_pow_eq (hn : 0 < n) (j : Fin n) {N : ℕ}
    {w : Γ(coordinateBlowup R m n, chart R m n j)} {a : Γ(coordinateAmbient R m n, ⊤)}
    (h : w * (chartMap R m n j).hom (coord R m n j) ^ N = (chartMap R m n j).hom a) :
    toFracOf R m n hn (punctured_le_chart R m n hn j) w * toFrac R m n (coord R m n j) ^ N =
      toFrac R m n a := by
  have := congrArg (toFracOf R m n hn (punctured_le_chart R m n hn j)) h
  rwa [map_mul, map_pow, toFracOf_chartMap, toFracOf_chartMap] at this

/-- `t_{jk} = y_k / y_j` on `D(y₁ ⋯ y_n)`. -/
theorem toFracOf_ratio (hn : 0 < n) (j k : Fin n) :
    toFracOf R m n hn (punctured_le_chart R m n hn j) (ratio R m n j k) *
      toFrac R m n (coord R m n j) = toFrac R m n (coord R m n k) := by
  rw [← toFracOf_chartMap R m n hn j (coord R m n k), chartMap_coord_eq R m n j k, map_mul,
    toFracOf_chartMap]

/-- **A function on a chart is a fraction `a / y_jᴺ` with `a ∈ Iᴺ`**, on `D(y₁ ⋯ y_n)`. -/
theorem exists_toFracOf_chart (hn : 0 < n) (j : Fin n)
    (z : Γ(coordinateBlowup R m n, chart R m n j)) :
    ∃ (N : ℕ) (a : Γ(coordinateAmbient R m n, ⊤)),
      a ∈ (Stacks.MoreMorphisms.coordinateIdeal R m n).ideal
        (Stacks.MoreMorphisms.topAffineOpen R m n) ^ N ∧
      z * (chartMap R m n j).hom (coord R m n j) ^ N = (chartMap R m n j).hom a ∧
      toFracOf R m n hn (punctured_le_chart R m n hn j) z * toFrac R m n (coord R m n j) ^ N =
        toFrac R m n a := by
  obtain ⟨N, a, ha, hz⟩ := exists_mem_pow_mul_eq_blowUpChartMap
    (Stacks.MoreMorphisms.coordinateIdeal R m n) (Stacks.MoreMorphisms.topAffineOpen R m n)
    (centreSection R m n j) z
  exact ⟨N, a, ha, hz, toFracOf_chart_mul_pow_eq R m n hn j hz⟩

/-- The product of the coordinates selected by a tuple of indices. -/
abbrev tupleCoord {p : ℕ} (x : Fin (p + 1) → Fin n) : Γ(coordinateAmbient R m n, ⊤) :=
  ∏ k, coord R m n (x k)

/-- **The fractions describing the functions on an intersection of charts**: an element `f` of
the functions on `D(y₁ ⋯ y_n)` with `f · y_jᴺ · y_xʳ = a · y_j^{r(p+1)}` for some `a ∈ Iᴺ`, where
`j = x₀` and `y_x` is the product of the coordinates selected by `x`. -/
def IsChartFraction {p : ℕ} (x : Fin (p + 1) → Fin n) (f : Frac R m n) : Prop :=
  ∃ (N r : ℕ) (a : Γ(coordinateAmbient R m n, ⊤)),
    a ∈ (Stacks.MoreMorphisms.coordinateIdeal R m n).ideal
      (Stacks.MoreMorphisms.topAffineOpen R m n) ^ N ∧
    f * toFrac R m n (coord R m n (x 0)) ^ N * toFrac R m n (tupleCoord R m n x) ^ r =
      toFrac R m n a * toFrac R m n (coord R m n (x 0)) ^ (r * (p + 1))

/-- The product of the ratios of a tuple, read on `D(y₁ ⋯ y_n)`. -/
theorem toFracOf_tupleRatio (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    toFracOf R m n hn (punctured_le_chart R m n hn (x 0)) (tupleRatio R m n x) *
        toFrac R m n (coord R m n (x 0)) ^ (p + 1) = toFrac R m n (tupleCoord R m n x) := by
  have h := Finset.prod_mul_pow_card (s := (Finset.univ : Finset (Fin (p + 1))))
    (f := fun k => toFracOf R m n hn (punctured_le_chart R m n hn (x 0)) (ratio R m n (x 0) (x k)))
    (b := toFrac R m n (coord R m n (x 0)))
  rw [Finset.card_univ, Fintype.card_fin] at h
  rw [tupleRatio, map_prod, tupleCoord, map_prod, h]
  exact Finset.prod_congr rfl fun k _ => toFracOf_ratio R m n hn (x 0) (x k)

/-- The product of the coordinates of a tuple is invertible on `D(y₁ ⋯ y_n)`. -/
theorem isUnit_toFrac_tupleCoord {p : ℕ} (x : Fin (p + 1) → Fin n) :
    IsUnit (toFrac R m n (tupleCoord R m n x)) := by
  rw [tupleCoord, map_prod]
  exact IsUnit.prod_univ_iff.2 fun k => isUnit_toFrac_coord R m n (x k)

/-- `W₀` lies in every nonempty intersection of charts. -/
theorem punctured_le_iInf_chart (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    punctured R m n ≤ ⨅ k, chart R m n (x k) :=
  le_iInf fun k => punctured_le_chart R m n hn (x k)

/-- `W₀` lies in the basic open of the product of the ratios of a tuple. -/
theorem punctured_le_basicOpen_tupleRatio (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    punctured R m n ≤ (coordinateBlowup R m n).basicOpen (tupleRatio R m n x) :=
  iInf_chart R m n x ▸ punctured_le_iInf_chart R m n hn x

/-- Every function on an intersection of charts is a fraction of a function on the first chart by
a power of the product of the ratios. -/
theorem exists_mul_tupleRatio_pow_eq {p : ℕ} (x : Fin (p + 1) → Fin n)
    (z : Γ(coordinateBlowup R m n, (coordinateBlowup R m n).basicOpen (tupleRatio R m n x))) :
    ∃ (z0 : Γ(coordinateBlowup R m n, chart R m n (x 0))) (r : ℕ),
      z * algebraMap _ _ (tupleRatio R m n x) ^ r = algebraMap _ _ z0 := by
  have := (isAffineOpen_chart R m n (x 0)).isLocalization_basicOpen (tupleRatio R m n x)
  obtain ⟨⟨z0, ⟨_, r, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (tupleRatio R m n x)) z
  exact ⟨z0, r, by simpa using hz⟩

/-- Reading a function on the first chart on `D(y₁ ⋯ y_n)` is compatible with restricting it to
an intersection of charts. -/
theorem toFracOf_algebraMap_tupleRatio (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (w : Γ(coordinateBlowup R m n, chart R m n (x 0))) :
    toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)
        (algebraMap _ Γ(coordinateBlowup R m n,
          (coordinateBlowup R m n).basicOpen (tupleRatio R m n x)) w) =
      toFracOf R m n hn (punctured_le_chart R m n hn (x 0)) w :=
  toFracOf_res R m n hn _ ((coordinateBlowup R m n).basicOpen_le _) w

/-- The product of the ratios of a tuple, restricted to the intersection of its charts and read
on `D(y₁ ⋯ y_n)`. -/
theorem toFracOf_algebraMap_tupleRatio_mul (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)
        (algebraMap _ Γ(coordinateBlowup R m n,
          (coordinateBlowup R m n).basicOpen (tupleRatio R m n x)) (tupleRatio R m n x)) *
        toFrac R m n (coord R m n (x 0)) ^ (p + 1) = toFrac R m n (tupleCoord R m n x) := by
  rw [toFracOf_algebraMap_tupleRatio, toFracOf_tupleRatio]

/-- A function `z` on an intersection of charts is `z₀ / Tʳ` with `z₀ = a / y_jᴺ` on the first
chart, `a ∈ Iᴺ`; here the resulting equation is read on `D(y₁ ⋯ y_n)`. -/
private theorem exists_toFracOf_basicOpen_tupleRatio (hn : 0 < n) {p : ℕ}
    (x : Fin (p + 1) → Fin n)
    (z : Γ(coordinateBlowup R m n, (coordinateBlowup R m n).basicOpen (tupleRatio R m n x))) :
    ∃ (z0 : Γ(coordinateBlowup R m n, chart R m n (x 0))) (r N : ℕ)
        (a : Γ(coordinateAmbient R m n, ⊤)),
      a ∈ (Stacks.MoreMorphisms.coordinateIdeal R m n).ideal
        (Stacks.MoreMorphisms.topAffineOpen R m n) ^ N ∧
      z * algebraMap _ _ (tupleRatio R m n x) ^ r = algebraMap _ _ z0 ∧
      z0 * (chartMap R m n (x 0)).hom (coord R m n (x 0)) ^ N = (chartMap R m n (x 0)).hom a ∧
      toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x) z *
          toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)
            (algebraMap _ _ (tupleRatio R m n x)) ^ r *
          toFrac R m n (coord R m n (x 0)) ^ N = toFrac R m n a := by
  obtain ⟨z0, r, hz0⟩ := exists_mul_tupleRatio_pow_eq R m n x z
  obtain ⟨N, a, ha, hza, hfa⟩ := exists_toFracOf_chart R m n hn (x 0) z0
  refine ⟨z0, r, N, a, ha, hz0, hza, ?_⟩
  have h1 := congrArg (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)) hz0
  rw [map_mul, map_pow, toFracOf_algebraMap_tupleRatio R m n hn x z0] at h1
  rwa [h1]

/-- Reading the functions on an intersection of charts on `D(y₁ ⋯ y_n)` is injective. -/
theorem toFracOf_basicOpen_tupleRatio_injective (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    Function.Injective (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)) := by
  intro u u' huu'
  have := (isAffineOpen_chart R m n (x 0)).isLocalization_basicOpen (tupleRatio R m n x)
  rw [← sub_eq_zero, ← map_sub] at huu'
  rw [← sub_eq_zero]
  obtain ⟨z0, r, N, a, -, hz0, hza, hfa⟩ := exists_toFracOf_basicOpen_tupleRatio R m n hn x (u - u')
  rw [huu', zero_mul, zero_mul] at hfa
  obtain rfl : a = 0 := toFrac_injective R m n (hfa.symm.trans (map_zero _).symm)
  rw [map_zero] at hza
  obtain rfl : z0 = 0 := (mem_nonZeroDivisors_iff_right.1
    (pow_mem (chartMap_coord_self_mem_nonZeroDivisors R m n (x 0)) N)) z0 hza
  rw [map_zero] at hz0
  exact (IsUnit.mul_left_eq_zero ((IsLocalization.Away.algebraMap_isUnit _).pow r)).1 hz0

/-- A function on an intersection of charts, read on `D(y₁ ⋯ y_n)`, is a chart fraction. -/
theorem isChartFraction_toFracOf_basicOpen_tupleRatio (hn : 0 < n) {p : ℕ}
    (x : Fin (p + 1) → Fin n)
    (z : Γ(coordinateBlowup R m n, (coordinateBlowup R m n).basicOpen (tupleRatio R m n x))) :
    IsChartFraction R m n x
      (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x) z) := by
  obtain ⟨-, r, N, a, ha, -, -, hfa⟩ := exists_toFracOf_basicOpen_tupleRatio R m n hn x z
  refine ⟨N, r, a, ha, ?_⟩
  rw [← hfa, ← toFracOf_algebraMap_tupleRatio_mul R m n hn x, mul_pow, ← pow_mul]
  ring

/-- Every chart fraction is a function on the intersection of the charts, read on
`D(y₁ ⋯ y_n)`. -/
theorem mem_range_toFracOf_basicOpen_tupleRatio (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n)
    {f : Frac R m n} (hf : IsChartFraction R m n x f) :
    f ∈ Set.range (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)) := by
  obtain ⟨N, r, a, ha, hf⟩ := hf
  have := (isAffineOpen_chart R m n (x 0)).isLocalization_basicOpen (tupleRatio R m n x)
  set B := (coordinateBlowup R m n).basicOpen (tupleRatio R m n x)
  set e : Γ(coordinateBlowup R m n, B) →+* Frac R m n :=
    toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)
  have hT : IsUnit (algebraMap Γ(coordinateBlowup R m n, chart R m n (x 0))
      Γ(coordinateBlowup R m n, B) (tupleRatio R m n x)) := IsLocalization.Away.algebraMap_isUnit _
  obtain ⟨w, hw⟩ := exists_mul_eq_blowUpChartMap_of_mem_pow
    (Stacks.MoreMorphisms.coordinateIdeal R m n) (Stacks.MoreMorphisms.topAffineOpen R m n)
    (centreSection R m n (x 0)) ha
  have hew : e (algebraMap _ _ w) * toFrac R m n (coord R m n (x 0)) ^ N = toFrac R m n a := by
    rw [toFracOf_algebraMap_tupleRatio]
    exact toFracOf_chart_mul_pow_eq R m n hn (x 0) (hw.trans (mul_comm _ _)).symm
  set z := algebraMap _ _ w * ((hT.unit⁻¹ : Γ(coordinateBlowup R m n, B)ˣ) :
    Γ(coordinateBlowup R m n, B)) ^ r with hz
  have key : e z * e (algebraMap _ _ (tupleRatio R m n x)) ^ r = e (algebraMap _ _ w) := by
    rw [← map_pow, ← map_mul, hz, mul_assoc, ← mul_pow, hT.val_inv_mul, one_pow, mul_one]
  refine ⟨z, (((isUnit_toFrac_coord R m n (x 0)).pow N).mul
    ((isUnit_toFrac_tupleCoord R m n x).pow r)).mul_right_cancel ?_⟩
  calc e z * (toFrac R m n (coord R m n (x 0)) ^ N * toFrac R m n (tupleCoord R m n x) ^ r)
      = (e z * e (algebraMap _ _ (tupleRatio R m n x)) ^ r) *
          toFrac R m n (coord R m n (x 0)) ^ N *
          toFrac R m n (coord R m n (x 0)) ^ (r * (p + 1)) := by
        rw [← toFracOf_algebraMap_tupleRatio_mul R m n hn x, mul_pow, ← pow_mul, mul_comm (p + 1) r]
        ring
    _ = f * (toFrac R m n (coord R m n (x 0)) ^ N * toFrac R m n (tupleCoord R m n x) ^ r) := by
        rw [key, hew, ← mul_assoc, hf]

/-- **The functions on an intersection of charts embed into the functions on
`D(y₁ ⋯ y_n)`, with image the chart fractions.** The intersection is the basic open `B` of the
product `T` of the ratios in the chart `L_j`, `j = x₀`, so its functions are the fractions
`z₀ / Tʳ` with `z₀` a function on `L_j`, and a function on `L_j` is a fraction `a / y_jᴺ` with
`a ∈ Iᴺ`. -/
theorem toFracOf_basicOpen_tupleRatio (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    Function.Injective (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)) ∧
      ∀ f, f ∈ Set.range (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)) ↔
        IsChartFraction R m n x f :=
  ⟨toFracOf_basicOpen_tupleRatio_injective R m n hn x, fun _ =>
    ⟨fun ⟨z, hz⟩ => hz ▸ isChartFraction_toFracOf_basicOpen_tupleRatio R m n hn x z,
      mem_range_toFracOf_basicOpen_tupleRatio R m n hn x⟩⟩

end Stacks.DeRham.CoordinateCech
