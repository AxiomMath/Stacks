/-!
# A double cover with no trace map on one-forms

Let `B = ℂ[x,y]` and let `A ⊆ B` be the subring of invariants of the involution negating both
variables; it is generated by `x²`, `xy` and `y²`. Then `A` is a normal domain of finite type over
`ℂ` and `B` is finite over `A`. The one-form `x dy` is invariant under the involution, yet twice
that form does not lie in the `B`-span of the differentials of `x²`, `xy`, `y²` — so it does not
come from `Ω_{A/ℂ}`. Hence there is no trace map on one-forms for this double cover.

## Main definitions

* `AlgebraicGeometry.NoTraceOnOneForms.B` is `ℂ[x,y]` and `AlgebraicGeometry.NoTraceOnOneForms.A`
  is its subalgebra generated by the three quadratic monomials.
* `AlgebraicGeometry.NoTraceOnOneForms.flip` is the involution negating both variables.

## Main results

* `AlgebraicGeometry.NoTraceOnOneForms.mem_A_iff_flip_eq` identifies `A` with the invariants.
* `AlgebraicGeometry.NoTraceOnOneForms.A_normal` and
  `AlgebraicGeometry.NoTraceOnOneForms.A_finiteType` give its ring properties.
* `AlgebraicGeometry.NoTraceOnOneForms.x_dy_flip_invariant` records invariance of the one-form.
* `AlgebraicGeometry.NoTraceOnOneForms.two_mul_x_dy_not_mem_span` is the obstruction, and
  `AlgebraicGeometry.NoTraceOnOneForms.two_mul_x_dy_not_mem_range` its consequence for the
  differential map from `A`.

## Implementation notes

The involution is evaluation at the negatives of both variables, so the invariants are exactly
the polynomials supported on monomials of even total degree, which is how `mem_A_iff_flip_eq` is
proved. Normality of `A` is obtained by descending integrality along the inclusion of fraction
fields and using that `B` is a polynomial ring, hence integrally closed.

The obstruction is computed in the basis of `Ω_{B⁄ℂ}` given by `dx` and `dy`: the coefficient of
`dy` in `2 x dy` is `2x`, which has nonzero constant term in the relevant coordinate, while every
element of the span has a coefficient with zero constant term there. The stronger form
`two_mul_x_dy_not_mem_span` allows coefficients in all of `B`, as in the source, and the
consequence for the differential map from `A` follows because the image of that map lands in the
span.

These names live in a namespace of their own because they are deliberately short, single-letter
names for the objects of one counterexample.

## References

* [Stacks Project, Tag 0FK7](https://stacks.math.columbia.edu/tag/0FK7)
-/

@[expose] public noncomputable section

namespace AlgebraicGeometry.NoTraceOnOneForms

/-- The polynomial ring `ℂ[x,y]` in two variables. -/
abbrev B := MvPolynomial (Fin 2) ℂ

/-- The first variable `x` of `B`. -/
abbrev x : B := MvPolynomial.X 0
/-- The second variable `y` of `B`. -/
abbrev y : B := MvPolynomial.X 1

/-- The subalgebra of `B` generated by `x²`, `xy` and `y²`. -/
abbrev A : Subalgebra ℂ B :=
  Algebra.adjoin ℂ ({x * x, x * y, y * y} : Set B)

/-- The `ℂ`-algebra involution of `B` sending `x ↦ -x` and `y ↦ -y`. -/
abbrev flip : B →ₐ[ℂ] B :=
  MvPolynomial.aeval (fun i : Fin 2 => -(MvPolynomial.X i : B))

private lemma finTwo_prod (d : Fin 2 →₀ ℕ) (f : Fin 2 → B) :
    d.prod (fun i e => f i ^ e) = f 0 ^ d 0 * f 1 ^ d 1 := by
  rw [Finsupp.prod, Finset.prod_subset (Finset.subset_univ d.support) (by
    intro i hi his
    have hd : d i = 0 := by simpa only [Finsupp.mem_support_iff, ne_eq, not_not] using his
    simp [hd])]
  simp [Fin.prod_univ_two]

private lemma flip_monomial (d : Fin 2 →₀ ℕ) (c : ℂ) :
    flip (MvPolynomial.monomial d c) =
      (-1 : ℂ) ^ (d 0 + d 1) • MvPolynomial.monomial d c := by
  rw [flip, MvPolynomial.aeval_monomial, MvPolynomial.monomial_eq, finTwo_prod, finTwo_prod,
    Algebra.smul_def]
  simp only [MvPolynomial.algebraMap_eq, map_pow, map_neg, map_one]
  rw [pow_add, neg_pow, neg_pow]
  ring

private lemma monomial_mem_A_of_even (d : Fin 2 →₀ ℕ) (c : ℂ)
    (hd : Even (d 0 + d 1)) : MvPolynomial.monomial d c ∈ A := by
  have hxx : x * x ∈ A := Algebra.subset_adjoin (by simp [x])
  have hyy : y * y ∈ A := Algebra.subset_adjoin (by simp [y])
  have hxy : x * y ∈ A := Algebra.subset_adjoin (by simp [x, y])
  obtain ⟨k, hk⟩ | ⟨k, hk⟩ := Nat.even_or_odd (d 0)
  · obtain ⟨l, hl⟩ | ⟨l, hl⟩ := Nat.even_or_odd (d 1)
    · have hmono : MvPolynomial.monomial d c =
          MvPolynomial.C c * (x * x) ^ k * (y * y) ^ l := by
        rw [MvPolynomial.monomial_eq, finTwo_prod, hk, hl, pow_add, pow_add, mul_pow, mul_pow]
        ring
      rw [hmono]
      exact A.mul_mem (A.mul_mem (A.algebraMap_mem c) (A.pow_mem hxx k)) (A.pow_mem hyy l)
    · obtain ⟨m, hm⟩ := hd
      omega
  · obtain ⟨l, hl⟩ | ⟨l, hl⟩ := Nat.even_or_odd (d 1)
    · obtain ⟨m, hm⟩ := hd
      omega
    · have hmono : MvPolynomial.monomial d c =
          MvPolynomial.C c * (x * y) * (x * x) ^ k * (y * y) ^ l := by
        rw [MvPolynomial.monomial_eq, finTwo_prod, hk, hl, pow_add, pow_add, mul_pow, mul_pow]
        ring
      rw [hmono]
      exact A.mul_mem (A.mul_mem (A.mul_mem (A.algebraMap_mem c) hxy) (A.pow_mem hxx k))
        (A.pow_mem hyy l)

private lemma flip_coeff (d : Fin 2 →₀ ℕ) (p : B) :
    MvPolynomial.coeff d (flip p) =
      (-1 : ℂ) ^ (d 0 + d 1) * MvPolynomial.coeff d p := by
  induction p using MvPolynomial.induction_on' with
  | monomial e c =>
      rw [flip_monomial]
      simp only [MvPolynomial.coeff_smul, MvPolynomial.coeff_monomial]
      split_ifs <;> simp [*]
  | add p q hp hq =>
      simp only [map_add, MvPolynomial.coeff_add, hp, hq]
      ring

private lemma flip_comp_flip : flip.comp flip = AlgHom.id ℂ B := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [flip]

private lemma flip_injective : Function.Injective flip := by
  intro p q hpq
  simpa only [← AlgHom.comp_apply, flip_comp_flip, AlgHom.id_apply] using congrArg flip hpq

private noncomputable def fracInclusion : FractionRing A →+* FractionRing B :=
  IsFractionRing.map (j := algebraMap A B) (fun _ _ h => Subtype.ext h)

private noncomputable def fracFlip : FractionRing B →+* FractionRing B :=
  IsFractionRing.map (j := (flip : B →+* B)) flip_injective

private lemma fracInclusion_algebraMap (a : A) :
    fracInclusion (algebraMap A (FractionRing A) a) =
      algebraMap B (FractionRing B) (a : B) := by
  simp [fracInclusion, IsFractionRing.map]

private lemma fracFlip_algebraMap (b : B) :
    fracFlip (algebraMap B (FractionRing B) b) =
      algebraMap B (FractionRing B) (flip b) := by
  simp [fracFlip, IsFractionRing.map]

private lemma fracInclusion_map_integral {z : FractionRing A} (hz : IsIntegral A z) :
    IsIntegral B (fracInclusion z) := by
  apply IsIntegral.map_of_comp_eq (algebraMap A B) fracInclusion ?_ hz
  ext a
  simp [fracInclusion_algebraMap]

private abbrev diffBasis := KaehlerDifferential.mvPolynomialBasis ℂ (Fin 2)

private lemma diffBasis_repr_D_xx :
    diffBasis.repr (KaehlerDifferential.D ℂ B (x * x)) =
      Finsupp.single 0 x + Finsupp.single 0 x + Finsupp.single 1 0 := by
  rw [Derivation.leibniz]
  ext i
  fin_cases i <;>
    simp [diffBasis, x]

private lemma diffBasis_repr_D_xy :
    diffBasis.repr (KaehlerDifferential.D ℂ B (x * y)) =
      Finsupp.single 0 y + Finsupp.single 1 x := by
  rw [Derivation.leibniz]
  ext i
  fin_cases i <;>
    simp [diffBasis, x, y]

private lemma diffBasis_repr_D_yy :
    diffBasis.repr (KaehlerDifferential.D ℂ B (y * y)) =
      Finsupp.single 0 0 + Finsupp.single 1 y + Finsupp.single 1 y := by
  rw [Derivation.leibniz]
  ext i
  fin_cases i <;>
    simp [diffBasis, y]

private lemma diffBasis_repr_two_x_dy :
    diffBasis.repr ((2 : B) • (x • KaehlerDifferential.D ℂ B y)) =
      Finsupp.single 1 (x + x) := by
  ext i
  fin_cases i <;> simp [diffBasis, x, y, two_mul]

/-- The three quadratic monomials generate precisely the simultaneous-negation invariants. -/
@[stacks 0FK7 "invariant ring"]
theorem mem_A_iff_flip_eq (p : B) : p ∈ A ↔ flip p = p := by
  constructor
  · intro hp
    induction hp using Algebra.adjoin_induction with
    | mem q hq =>
        change q ∈ {x * x, x * y, y * y} at hq
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
        rcases hq with rfl | rfl | rfl <;> simp [flip, x, y]
    | algebraMap c => simp [flip]
    | add q r hq hr ihq ihr => rw [map_add, ihq, ihr]
    | mul q r hq hr ihq ihr => rw [map_mul, ihq, ihr]
  · intro hfix
    have hcoeffzero (d : Fin 2 →₀ ℕ) (hd : Odd (d 0 + d 1)) :
        MvPolynomial.coeff d p = 0 := by
      have h := flip_coeff d p
      rw [hfix] at h
      rcases hd with ⟨k, hk⟩
      have hpow : (-1 : ℂ) ^ (d 0 + d 1) = -1 := by
        rw [hk, pow_add]
        simp
      rw [hpow] at h
      have hzero : (2 : ℂ) * MvPolynomial.coeff d p = 0 := by linear_combination h
      exact (mul_eq_zero.mp hzero).resolve_left (by norm_num)
    have hmono (d : Fin 2 →₀ ℕ) (hd : d ∈ p.support) :
        MvPolynomial.monomial d (MvPolynomial.coeff d p) ∈ A :=
      monomial_mem_A_of_even d _ ((Nat.even_or_odd _).resolve_right
        fun ho => MvPolynomial.mem_support_iff.mp hd (hcoeffzero d ho))
    rw [p.as_sum]
    exact Submodule.sum_mem A.toSubmodule hmono

private lemma fracInclusion_fixed (z : FractionRing A) :
    fracFlip (fracInclusion z) = fracInclusion z := by
  obtain ⟨a, d, hd, hz⟩ := IsFractionRing.div_surjective A z
  rw [← hz]
  show fracFlip (fracInclusion
      (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) d)) =
    fracInclusion (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) d)
  rw [map_div₀ fracInclusion, map_div₀ fracFlip, fracInclusion_algebraMap, fracFlip_algebraMap,
    fracInclusion_algebraMap, fracFlip_algebraMap]
  congr 1 <;> exact congrArg (algebraMap B (FractionRing B))
    ((mem_A_iff_flip_eq _).1 (SetLike.coe_mem _))

/-- The invariant ring is a normal domain. -/
@[stacks 0FK7 "normal domain"]
theorem A_normal : IsNormalDomain A := by
  refine ⟨inferInstance, (isIntegrallyClosed_iff (FractionRing A)).2 ?_⟩
  intro z hz
  obtain ⟨b, hb⟩ := (IsIntegrallyClosed.isIntegral_iff (R := B) (K := FractionRing B)).mp
    (fracInclusion_map_integral hz)
  have hfixB : algebraMap B (FractionRing B) (flip b) = algebraMap B (FractionRing B) b := by
    rw [← fracFlip_algebraMap, hb, fracInclusion_fixed]
  refine ⟨⟨b, (mem_A_iff_flip_eq b).2 (IsFractionRing.injective B (FractionRing B) hfixB)⟩,
    fracInclusion.injective ?_⟩
  rwa [fracInclusion_algebraMap]

/-- The invariant ring is of finite type over `ℂ`. -/
@[stacks 0FK7 "finite type"]
theorem A_finiteType : Algebra.FiniteType ℂ A :=
  Algebra.FiniteType.adjoin_of_finite (by simp : ({x * x, x * y, y * y} : Set B).Finite)

/-- Simultaneously negating the variables fixes `x dy`. -/
@[stacks 0FK7 "invariant one-form"]
theorem x_dy_flip_invariant :
    flip x • KaehlerDifferential.D ℂ B (flip y) =
      x • KaehlerDifferential.D ℂ B y := by
  simp [flip, x, y]

/-- The form `2 x dy` does not lie in the `B`-span of the differentials of `x²`, `xy` and `y²`. -/
@[stacks 0FK7 "failure of descent for one-forms"]
theorem two_mul_x_dy_not_mem_span :
    (2 : B) • (x • KaehlerDifferential.D ℂ B y) ∉
      Submodule.span B
        ({KaehlerDifferential.D ℂ B (x * x),
          KaehlerDifferential.D ℂ B (x * y),
          KaehlerDifferential.D ℂ B (y * y)} : Set Ω[B⁄ℂ]) := by
  intro hspan
  let s : Set Ω[B⁄ℂ] :=
    {KaehlerDifferential.D ℂ B (x * x), KaehlerDifferential.D ℂ B (x * y),
      KaehlerDifferential.D ℂ B (y * y)}
  have hcoord : diffBasis.repr ((2 : B) • (x • KaehlerDifferential.D ℂ B y)) ∈
      Submodule.span B
        ({diffBasis.repr (KaehlerDifferential.D ℂ B (x * x)),
          diffBasis.repr (KaehlerDifferential.D ℂ B (x * y)),
          diffBasis.repr (KaehlerDifferential.D ℂ B (y * y))} : Set (Fin 2 →₀ B)) := by
    have hm : diffBasis.repr ((2 : B) • (x • KaehlerDifferential.D ℂ B y)) ∈
        (Submodule.span B s).map diffBasis.repr.toLinearMap := ⟨_, hspan, rfl⟩
    rw [Submodule.map_span] at hm
    simpa [s] using hm
  rw [Submodule.mem_span_triple] at hcoord
  obtain ⟨a, b, c, hcoord⟩ := hcoord
  have hx := congrArg (fun f : Fin 2 →₀ B => f 0) hcoord
  have hy := congrArg (fun f : Fin 2 →₀ B => f 1) hcoord
  rw [diffBasis_repr_D_xx, diffBasis_repr_D_xy, diffBasis_repr_D_yy,
    diffBasis_repr_two_x_dy] at hx hy
  have hc0 : MvPolynomial.coeff 0 b = 0 := by
    have h := congrArg (MvPolynomial.coeff (Finsupp.single 1 1)) hx
    simpa [MvPolynomial.coeff_add, MvPolynomial.coeff_mul_X',
      MvPolynomial.coeff_X_mul', x, y] using h
  have h := congrArg (MvPolynomial.coeff (Finsupp.single 0 1)) hy
  have h' : MvPolynomial.coeff 0 b = 1 + 1 := by
    simpa [MvPolynomial.coeff_add, MvPolynomial.coeff_mul_X',
      MvPolynomial.coeff_X_mul', x, y] using h
  rw [hc0] at h'
  norm_num at h'

private lemma D_mem_quadratic_span (a : A) :
    KaehlerDifferential.D ℂ B (a : B) ∈
      Submodule.span B
        ({KaehlerDifferential.D ℂ B (x * x), KaehlerDifferential.D ℂ B (x * y),
          KaehlerDifferential.D ℂ B (y * y)} : Set Ω[B⁄ℂ]) := by
  refine Algebra.adjoin_induction
    (p := fun q _ => KaehlerDifferential.D ℂ B q ∈
      Submodule.span B
        ({KaehlerDifferential.D ℂ B (x * x), KaehlerDifferential.D ℂ B (x * y),
          KaehlerDifferential.D ℂ B (y * y)} : Set Ω[B⁄ℂ]))
    ?_ ?_ ?_ ?_ a.property
  · intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl | rfl <;>
      exact Submodule.subset_span (by simp)
  · intro r
    simp
  · intro q r hq hr ihq ihr
    rw [map_add]
    exact Submodule.add_mem _ ihq ihr
  · intro q r hq hr ihq ihr
    exact (Derivation.leibniz (KaehlerDifferential.D ℂ B) q r) ▸
      Submodule.add_mem _ (Submodule.smul_mem _ q ihr) (Submodule.smul_mem _ r ihq)

private lemma differentialMap_range_le_quadratic_span :
    LinearMap.range (KaehlerDifferential.map ℂ ℂ A B) ≤
      (Submodule.span B
        ({KaehlerDifferential.D ℂ B (x * x), KaehlerDifferential.D ℂ B (x * y),
          KaehlerDifferential.D ℂ B (y * y)} : Set Ω[B⁄ℂ])).restrictScalars A := by
  rintro w ⟨z, rfl⟩
  have hz : z ∈ Submodule.span A (Set.range (KaehlerDifferential.D ℂ A)) := by
    rw [KaehlerDifferential.span_range_derivation]
    trivial
  induction hz using Submodule.span_induction with
  | mem w hw =>
      rcases hw with ⟨a, rfl⟩
      rw [KaehlerDifferential.map_D]
      show KaehlerDifferential.D ℂ B (a : B) ∈ _
      exact D_mem_quadratic_span a
  | zero => exact Submodule.zero_mem _
  | add w₁ w₂ hw₁ hw₂ ih₁ ih₂ =>
      rw [map_add]
      exact Submodule.add_mem _ ih₁ ih₂
  | smul r w hw ih =>
      rw [map_smul]
      exact Submodule.smul_mem _ r ih

/-- Twice the invariant one-form does not come from the invariant ring. -/
@[stacks 0FK7 "failure of the differential map to capture the invariant form"]
theorem two_mul_x_dy_not_mem_range :
    (2 : B) • (x • KaehlerDifferential.D ℂ B y) ∉
      LinearMap.range (KaehlerDifferential.map ℂ ℂ A B) :=
  fun h => two_mul_x_dy_not_mem_span (differentialMap_range_le_quadratic_span h)

end AlgebraicGeometry.NoTraceOnOneForms
