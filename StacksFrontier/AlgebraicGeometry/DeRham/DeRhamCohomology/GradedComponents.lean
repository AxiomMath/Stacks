module

public import Mathlib.LinearAlgebra.ExteriorPower.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Kaehler.Defs

/-!
# Graded components of differential forms

Let `A` be a commutative `R`-algebra whose underlying `R`-module is graded by an additive
commutative monoid `G`. The degree-`g` part of the `p`-forms is the `R`-submodule generated by
the forms `a₀ ⋅ da₁ ∧ ⋯ ∧ daₚ` for homogeneous `aᵢ` whose degrees sum to `g`. Taking `p = 1` and
transporting along the canonical degree-one exterior-power equivalence gives the corresponding
grading of the module of Kähler differentials itself.

## Main definitions

* `KaehlerDifferential.gradedDifferentialFormComponent` is the degree-`g` component of the module
  of `p`-forms.
* `KaehlerDifferential.gradedDifferentialComponent` is its degree-one version, regarded as a
  submodule of the module of Kähler differentials.

## Main results

* `KaehlerDifferential.homogeneousDifferentialForm_mem_gradedDifferentialFormComponent` says that
  each homogeneous generator belongs to its component.
* `KaehlerDifferential.gradedDifferentialFormComponent_le_iff` characterizes containment of a
  component by containment of all of its homogeneous generators.
* `KaehlerDifferential.exteriorPower_oneEquiv_mem_gradedDifferentialComponent` identifies
  membership in the degree-one component under the canonical equivalence.

## Implementation notes

The construction is meaningful for any family of `R`-submodules, so the direct-sum and
multiplicative grading hypotheses are imposed by the results which use it, rather than by the
definition. Clients can introduce homogeneous generators with
`homogeneousDifferentialForm_mem_gradedDifferentialFormComponent`, prove an inclusion using
`gradedDifferentialFormComponent_le_iff`, and move degree-one membership across the canonical
equivalence by simplification.

## References

* [Stacks Project, Tag 0FU9](https://stacks.math.columbia.edu/tag/0FU9)
-/

@[expose] public section

open scoped BigOperators

namespace KaehlerDifferential

universe u v w

/-- The degree-`g` component of the `p`-forms of `A` over `R`, generated over
`R` by `a₀ ⋅ da₁ ∧ ⋯ ∧ daₚ` for homogeneous elements whose degrees sum
to `g`. -/
@[stacks 0FU9 "graded_differential_form_components"]
noncomputable def gradedDifferentialFormComponent
    {G : Type u} {R : Type v} {A : Type w}
    [AddCommMonoid G] [CommRing R] [CommRing A] [Algebra R A]
    (gr : G → Submodule R A) (p : ℕ) (g : G) :
    Submodule R (⋀[A]^p (KaehlerDifferential R A)) :=
  Submodule.span R {x | ∃ (degree : Fin (p + 1) → G)
      (a : ∀ i, gr (degree i)),
    g = ∑ i, degree i ∧
      x = (a 0 : A) • exteriorPower.ιMulti A p
        (fun i ↦ KaehlerDifferential.D R A (a i.succ : A))}

/-- The degree-`g` component of the Kähler differentials of `A` over `R`.

This is the degree-one differential-form component, viewed in
`KaehlerDifferential R A` through the canonical degree-one exterior-power
equivalence. -/
@[stacks 0FU9 "graded_differential_form_components"]
noncomputable def gradedDifferentialComponent
    {G : Type u} {R : Type v} {A : Type w}
    [AddCommMonoid G] [CommRing R] [CommRing A] [Algebra R A]
    (gr : G → Submodule R A) (g : G) :
    Submodule R (KaehlerDifferential R A) :=
  (gradedDifferentialFormComponent gr 1 g).map
    ((exteriorPower.oneEquiv A (KaehlerDifferential R A)).toLinearMap.restrictScalars R)

/-- A differential monomial in homogeneous elements belongs to the component
whose degree is the sum of their degrees. -/
theorem homogeneousDifferentialForm_mem_gradedDifferentialFormComponent
    {G : Type u} {R : Type v} {A : Type w}
    [AddCommMonoid G] [CommRing R] [CommRing A] [Algebra R A]
    (gr : G → Submodule R A) (p : ℕ) (degree : Fin (p + 1) → G)
    (a : ∀ i, gr (degree i)) (g : G) (hg : g = ∑ i, degree i) :
    (a 0 : A) • exteriorPower.ιMulti A p
        (fun i ↦ KaehlerDifferential.D R A (a i.succ : A)) ∈
      gradedDifferentialFormComponent gr p g :=
  Submodule.subset_span ⟨degree, a, hg, rfl⟩

/-- The component generated by the homogeneous differential monomials is
contained in `N` exactly when every such monomial is in `N`. -/
theorem gradedDifferentialFormComponent_le_iff
    {G : Type u} {R : Type v} {A : Type w}
    [AddCommMonoid G] [CommRing R] [CommRing A] [Algebra R A]
    (gr : G → Submodule R A) (p : ℕ) (g : G)
    (N : Submodule R (⋀[A]^p (KaehlerDifferential R A))) :
    gradedDifferentialFormComponent gr p g ≤ N ↔
      ∀ (degree : Fin (p + 1) → G) (a : ∀ i, gr (degree i)),
        g = ∑ i, degree i →
          (a 0 : A) • exteriorPower.ιMulti A p
              (fun i ↦ KaehlerDifferential.D R A (a i.succ : A)) ∈ N := by
  rw [gradedDifferentialFormComponent, Submodule.span_le]
  exact ⟨fun h degree a hg => h ⟨degree, a, hg, rfl⟩,
    fun h x hx => by rcases hx with ⟨degree, a, hg, rfl⟩; exact h degree a hg⟩

/-- Membership in the degree-one component is transported by the canonical
equivalence between first exterior powers and Kähler differentials. -/
@[simp]
theorem exteriorPower_oneEquiv_mem_gradedDifferentialComponent
    {G : Type u} {R : Type v} {A : Type w}
    [AddCommMonoid G] [CommRing R] [CommRing A] [Algebra R A]
    (gr : G → Submodule R A) (g : G)
    (x : ⋀[A]^1 (KaehlerDifferential R A)) :
    exteriorPower.oneEquiv A (KaehlerDifferential R A) x ∈
        gradedDifferentialComponent gr g ↔
      x ∈ gradedDifferentialFormComponent gr 1 g := by
  simp [gradedDifferentialComponent, Submodule.mem_map]

end KaehlerDifferential
