module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ExteriorPresentationExact
public import StacksFrontier.AlgebraicGeometry.DeRham.Gysin.EquationsCutOutStalk
public import StacksFrontier.AlgebraicGeometry.DeRham.Gysin.GysinMap
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The presentation of the exterior powers of the pulled-back differentials

Let `π : X ⟶ S` be a morphism of schemes and `i : Z ⟶ X` a closed immersion cut out by global
functions `f j`. Writing `M₁ = i^*Ω_{X/S}` and `M = Ω_{Z/S}`, the canonical map
`p : M₁ ⟶ M` of [Stacks, Tag 01UV] is an epimorphism whose kernel is generated by the pulled-back
differentials `d (f j)` — that is exactness of the conormal sequence of [Stacks, Tag 01UZ] at its
middle term, `Stacks.ConormalSequenceRight.equationDifferentialsComplexOver_exact`. Feeding that
presentation to the exterior clause of [Stacks, Tag 01CJ],
`SheafOfModules.ExtPresentation.exteriorPresentation_exact`, presents the kernel of
`⋀^{k+1}(M₁) ⟶ ⋀^{k+1}(M)`.

This file names the data of that application and records the four identifications that make it
line up with the sheaves the Gysin map of [Stacks, Tag 0G83] is built from. All four hold by
`rfl`; they are stated because the two sides are spelled differently and nothing else in the
library records that they agree.

## Main definitions

* `Stacks.Gysin.pulledBackDifferentials`, `Stacks.Gysin.pullbackFormsAlgebra`,
  `Stacks.Gysin.pullbackFormsGenerator`: `i^*Ω_{X/S}`, its exterior algebra `⋀(i^*Ω_{X/S})`, and
  the degree-one generator.
* `Stacks.Gysin.differentialsRestriction`: the canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` of
  [Stacks, Tag 01UV], the second map of the conormal sequence.
* `Stacks.Gysin.equationsPresentation`: the three-term complex of [Stacks, Tag 01CJ] in degree
  `k + 1` attached to the presentation of `Ω_{Z/S}` by the equations.

## Main results

* `Stacks.Gysin.equationsPresentation_exact`: **the presentation is exact at its middle term and
  its second map is an epimorphism** — Tag 01CJ fed with Tag 01UZ.
* `Stacks.Gysin.extDesc_eq` and `Stacks.Gysin.equationsPresentation_g`: the second map of that
  complex **is** the comparison `⋀ⁿ(i^*Ω_{X/S}) ⟶ Ω^n_{Z/S}` on differential forms, i.e. the
  second factor of `AlgebraicGeometry.Scheme.Hom.relativeDifferentialFormsMap`.
* `Stacks.Gysin.relativeDifferentialFormsMap_eq`: `f^*Ω^n_{X/S} ⟶ Ω^n_{Z/S}` is the comparison of
  [Stacks, Tag 01CI] followed by that map.
* `Stacks.Gysin.pullbackUnit_eq`: the section-level pullback unit
  `Stacks.RingedSpace.pullbackUnit`, in which [Stacks, Tag 01CI] for the exterior algebra is
  stated, is the unit of `i^* ⊣ i_*` used by `AlgebraicGeometry.Scheme.Hom.formRestriction`.

## Implementation notes

The index type of the equations is `ULift (Fin c)`: `Stacks.ConormalSequenceRight.IsCutOutBy`
and `SheafOfModules.free` want an index in the universe of the schemes, while the Gysin
construction counts its equations by `Fin c`.

`Epi` for the second map of the conormal sequence has to be supplied by hand at the
`SheafOfModules.{u} (CategoryTheory.Sheaf.toRingCat …)` spelling of the category of modules:
`AlgebraicGeometry.Scheme.Modules` is a `def` with its own `Category` instance, so an `Epi`
instance found for `Z.Modules` is not transported to the spelling Tag 01CJ is stated in, although
the two are equal by `rfl`.

## References

* [Stacks Project, Tag 0G83](https://stacks.math.columbia.edu/tag/0G83)
* [Stacks Project, Tag 01CJ](https://stacks.math.columbia.edu/tag/01CJ)
* [Stacks Project, Tag 01CI](https://stacks.math.columbia.edu/tag/01CI)
* [Stacks Project, Tag 01UZ](https://stacks.math.columbia.edu/tag/01UZ)
* [Stacks Project, Tag 01UV](https://stacks.math.columbia.edu/tag/01UV)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open SheafOfModules.GradedAlgebra

universe u

namespace Stacks.Gysin

variable {X Z S : Scheme.{u}} (i : Z ⟶ X) (π : X ⟶ S)

/-- The pullback `i^*Ω_{X/S}` of the sheaf of relative differentials along `i`, the middle term
of the conormal sequence of [Stacks, Tag 01UZ]. -/
abbrev pulledBackDifferentials : Z.Modules :=
  (Scheme.Modules.pullback i).obj (Scheme.Hom.relativeDifferentials π)

/-- The exterior algebra `⋀(i^*Ω_{X/S})` of the pulled-back differentials. -/
abbrev pullbackFormsAlgebra :
    SheafOfModules.GradedAlgebra.{u, u} (Stacks.RingedSpace.structureRingSheaf Z.toRingedSpace) :=
  Scheme.Modules.exteriorAlgebra (pulledBackDifferentials i π)

/-- The degree-one generator of `⋀(i^*Ω_{X/S})`. -/
abbrev pullbackFormsGenerator :
    pulledBackDifferentials i π ⟶ (pullbackFormsAlgebra i π).piece 1 :=
  Scheme.Modules.exteriorGenerator (pulledBackDifferentials i π)

/-- The degree-one generator of `Ω^•_{Z/S}`. -/
abbrev formsGenerator :
    Scheme.Hom.relativeDifferentials (i ≫ π) ⟶
      (Scheme.Hom.relativeDifferentialFormsAlgebra (i ≫ π)).piece 1 :=
  Scheme.Modules.exteriorGenerator (Scheme.Hom.relativeDifferentials (i ≫ π))

/-- The canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` of [Stacks, Tag 01UV], the second map of the
conormal sequence. -/
abbrev differentialsRestriction :
    pulledBackDifferentials i π ⟶ Scheme.Hom.relativeDifferentials (i ≫ π) :=
  Scheme.Hom.relativeDifferentialsMap i π (i ≫ π) (𝟙 S) (by simp)

/-- `⋀(i^*Ω_{X/S})` is an exterior algebra on its degree-one generator. -/
theorem isExteriorAlgebra_pullbackFormsAlgebra :
    IsExteriorAlgebra (pullbackFormsAlgebra i π) (pullbackFormsGenerator i π) :=
  Scheme.Modules.isExteriorAlgebra_exteriorAlgebra _

/-- `Ω^•_{Z/S}` is an exterior algebra on its degree-one generator. -/
@[ega "IV 16.6.1" "Ω•_{X/S} = ∧(Ω^1_{X/S})"]
theorem isExteriorAlgebra_relativeDifferentialFormsAlgebra :
    IsExteriorAlgebra (Scheme.Hom.relativeDifferentialFormsAlgebra (i ≫ π)) (formsGenerator i π) :=
  Scheme.Modules.isExteriorAlgebra_exteriorAlgebra _

/-- **The comparison homomorphism of [Stacks, Tag 01CJ] is the comparison of graded algebras on
differential forms.** The unital homomorphism `⋀(i^*Ω_{X/S}) ⟶ Ω^•_{Z/S}` which Tag 01CJ induces
from the canonical map `i^*Ω_{X/S} ⟶ Ω_{Z/S}` is
`AlgebraicGeometry.Scheme.Hom.relativeDifferentialFormsComparison`: both are the extension of that
canonical map supplied by the universal property of the source. -/
theorem extDesc_eq :
    SheafOfModules.ExtPresentation.extDesc (pullbackFormsGenerator i π) (formsGenerator i π)
        (isExteriorAlgebra_pullbackFormsAlgebra i π)
        (isExteriorAlgebra_relativeDifferentialFormsAlgebra i π) (differentialsRestriction i π) =
      Scheme.Hom.relativeDifferentialFormsComparison i π (i ≫ π) (𝟙 S) (by simp) :=
  rfl

/-- **The canonical map on differential forms is the comparison of [Stacks, Tag 01CI] followed by
the comparison of [Stacks, Tag 01CJ].** -/
theorem relativeDifferentialFormsMap_eq (n : ℤ) :
    Scheme.Hom.relativeDifferentialFormsMap i π (i ≫ π) (𝟙 S) (by simp) n =
      ((Stacks.PullbackExteriorAlgebra.exteriorAlgebraPullbackIso i.toLRSHom.toShHom
          (Scheme.Hom.relativeDifferentialFormsAlgebra π)
          (Scheme.Modules.exteriorGenerator (Scheme.Hom.relativeDifferentials π))
          (pullbackFormsAlgebra i π) (pullbackFormsGenerator i π)
          (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra _)
          (isExteriorAlgebra_pullbackFormsAlgebra i π)).app n).hom ≫
        (Scheme.Hom.relativeDifferentialFormsComparison i π (i ≫ π) (𝟙 S) (by simp)).app n :=
  rfl

/-- **The section-level pullback unit is the unit of `i^* ⊣ i_*`.**
`Stacks.RingedSpace.pullbackUnit`, in which the compatibilities of the comparison of
[Stacks, Tag 01CI] are stated, and
`AlgebraicGeometry.Scheme.Modules.pullbackPushforwardAdjunction`, through which
`AlgebraicGeometry.Scheme.Hom.formRestriction` is defined, give the same map on local
sections. -/
theorem pullbackUnit_eq (M : X.Modules) (U : X.Opensᵒᵖ) (x : M.val.obj U) :
    Stacks.RingedSpace.pullbackUnit i.toLRSHom.toShHom M U x =
      ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M).val.app U x :=
  rfl

variable {c : ℕ} {f : ULift.{u} (Fin c) → Γ(X, ⊤)}

/-- **Exactness of the conormal sequence at its middle term** ([Stacks, Tag 01UZ]), in the shape
of a short complex `⊕_j 𝒪_Z ⟶ i^*Ω_{X/S} ⟶ Ω_{Z/S}`. -/
theorem conormal_exact [IsClosedImmersion i]
    (hf : Stacks.ConormalSequenceRight.IsCutOutBy i f) :
    (ShortComplex.mk (Stacks.ConormalSequenceRight.equationDifferentialsMap i π f)
        (differentialsRestriction i π)
        (Stacks.ConormalSequenceRight.equationDifferentialsMap_comp i π (by simp) hf)).Exact :=
  Stacks.ConormalSequenceRight.equationDifferentialsComplexOver_exact i π f hf

/-- The three-term complex of [Stacks, Tag 01CJ] in degree `k + 1` attached to the presentation of
`Ω_{Z/S}` by the equations: `(⊕_j 𝒪_Z) ⊗ ⋀^k(i^*Ω_{X/S}) ⟶ ⋀^{k+1}(i^*Ω_{X/S}) ⟶ Ω^{k+1}_{Z/S}`. -/
abbrev equationsPresentation (hf : Stacks.ConormalSequenceRight.IsCutOutBy i f) (k : ℕ) :
    ShortComplex (SheafOfModules.{u}
      (CategoryTheory.Sheaf.toRingCat (Opens.grothendieckTopology ↥Z) Z.sheaf)) :=
  SheafOfModules.ExtPresentation.extComplex (pullbackFormsGenerator i π) (formsGenerator i π)
    (isExteriorAlgebra_pullbackFormsAlgebra i π)
    (isExteriorAlgebra_relativeDifferentialFormsAlgebra i π) (differentialsRestriction i π)
    (Stacks.ConormalSequenceRight.equationDifferentialsMap i π f)
    (Stacks.ConormalSequenceRight.equationDifferentialsMap_comp i π (by simp) hf) k

/-- **The second map of the presentation is the comparison on differential forms.** -/
theorem equationsPresentation_g (hf : Stacks.ConormalSequenceRight.IsCutOutBy i f) (k : ℕ) :
    (equationsPresentation i π hf k).g =
      (Scheme.Hom.relativeDifferentialFormsComparison i π (i ≫ π) (𝟙 S) (by simp)).app
        ((k + 1 : ℕ) : ℤ) :=
  rfl

/-- **The exterior clause of [Stacks, Tag 01CJ] applied to the conormal sequence of
[Stacks, Tag 01UZ]**: the kernel of `⋀^{k+1}(i^*Ω_{X/S}) ⟶ Ω^{k+1}_{Z/S}` is the image of
`m ⊗ ω ↦ d(f_j)(m) ∧ ω`, and that second map is an epimorphism. -/
theorem equationsPresentation_exact [IsClosedImmersion i]
    (hf : Stacks.ConormalSequenceRight.IsCutOutBy i f) (k : ℕ) :
    (equationsPresentation i π hf k).Exact ∧ Epi (equationsPresentation i π hf k).g := by
  let : Epi (C := SheafOfModules.{u}
      (CategoryTheory.Sheaf.toRingCat (Opens.grothendieckTopology ↥Z) Z.sheaf))
      (differentialsRestriction i π) :=
    Stacks.ConormalSequenceRight.differentialsMapOver_epi i π
  exact SheafOfModules.ExtPresentation.exteriorPresentation_exact (pullbackFormsGenerator i π)
    (formsGenerator i π) (isExteriorAlgebra_pullbackFormsAlgebra i π)
    (isExteriorAlgebra_relativeDifferentialFormsAlgebra i π) (differentialsRestriction i π) _ _
    (conormal_exact i π hf) k

end Stacks.Gysin

end
