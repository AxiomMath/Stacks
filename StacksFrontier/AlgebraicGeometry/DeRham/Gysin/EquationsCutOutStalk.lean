module

public import StacksFrontier.AlgebraicGeometry.ConormalSequenceRight.Middle
public import StacksFrontier.AlgebraicGeometry.DeRham.Gysin.EquationsQuotient

/-!
# The equations cut out the closed subscheme, read on stalks

`Stacks.Gysin.IsCutOutByEquations` says that the ideal sheaf of a closed immersion `i : Z ⟶ X`
is generated by global functions `f₁, …, f_c`: the restrictions of the `f j` to `Z` vanish, and a
function vanishing on `Z` is in a neighbourhood of every point a combination of them. The
conormal sequence of [Stacks, Tag 01UZ] consumes the same condition in the stalkwise form
`Stacks.ConormalSequenceRight.IsCutOutBy`: at every point of `Z` the kernel of the stalk map of
`i` is the ideal generated by the germs of the `f j`. This file proves that the first implies the
second.

## Main results

* `Stacks.Gysin.exists_preimage_eq`: **every open subset of the source of a closed immersion is
  the preimage of an open subset of the target**, because a closed embedding is inducing.
* `Stacks.Gysin.isCutOutBy_of_isCutOutByEquations`: **the sectionwise condition implies the
  stalkwise one.**

## Implementation notes

The only subtlety is that a germ which dies in the stalk of `Z` vanishes on *some* open
neighbourhood in `Z`, whereas `IsCutOutByEquations` is a statement about opens of `X`. The two
are reconciled by `exists_preimage_eq`: the opens of `Z` are exactly the preimages of the opens
of `X`, because `i` is a closed — hence inducing — embedding. That is the one place the
hypothesis `IsClosedImmersion i` is used; an immersion would do just as well.

## References

* [Stacks Project, Tag 01UZ](https://stacks.math.columbia.edu/tag/01UZ)
* [Stacks Project, Tag 0G83](https://stacks.math.columbia.edu/tag/0G83)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.Gysin

variable {X Z : Scheme.{u}}

/-- **Every open subset of the source of a closed immersion is the preimage of an open subset of
the target.** A closed embedding is inducing, so the topology of `Z` is the one induced from
`X`. -/
theorem exists_preimage_eq (i : Z ⟶ X) [IsClosedImmersion i] (W : Z.Opens) :
    ∃ V : X.Opens, i ⁻¹ᵁ V = W := by
  obtain ⟨V, hV, hVW⟩ :=
    (i.isClosedEmbedding.isInducing.isOpen_iff (s := (W : Set Z))).1 W.2
  exact ⟨⟨V, hV⟩, Opens.ext hVW⟩

/-- Restriction maps of the structure sheaf only depend on the pair of opens. -/
private theorem presheaf_map_apply_congr {A B : (Opens Z)ᵒᵖ} (g g' : A ⟶ B)
    (s : Z.presheaf.obj A) : Z.presheaf.map g s = Z.presheaf.map g' s := by
  rw [Subsingleton.elim g g']

/-- The restriction of a section of `𝒪_X` whose image on `Z` vanishes on an open subset of `Z`
has vanishing image on every open subset of `X` whose preimage is contained in that subset. -/
theorem app_eq_zero_of_res_eq_zero (i : Z ⟶ X) {U U' : X.Opens} (hU' : U' ≤ U) (a : Γ(X, U))
    {W : Z.Opens} (hW : i ⁻¹ᵁ U' ≤ W) (hiW : W ≤ i ⁻¹ᵁ U)
    (hres : Z.presheaf.map (homOfLE hiW).op ((i.app U).hom a) = 0) :
    (i.app U').hom (X.presheaf.map (homOfLE hU').op a) = 0 := by
  have hnat := congrArg (fun φ : Γ(X, U) ⟶ Γ(Z, i ⁻¹ᵁ U') => ConcreteCategory.hom φ a)
    (i.naturality (U' := U) (U := U') (homOfLE hU').op)
  simp only [ConcreteCategory.comp_apply] at hnat
  refine hnat.trans ?_
  refine (presheaf_map_apply_congr _ ((homOfLE hiW).op ≫ (homOfLE hW).op) _).trans ?_
  rw [Z.presheaf.map_comp, ConcreteCategory.comp_apply, hres]
  exact map_zero _

/-- **The sectionwise condition that the equations cut out the closed subscheme implies the
stalkwise one.** A germ in the kernel of the stalk map is represented by a section whose image on
`Z` dies in the stalk of `Z`, hence vanishes on an open neighbourhood of the point in `Z`; that
neighbourhood is the preimage of an open of `X`, where `IsCutOutByEquations` writes the section
as a combination of the equations. -/
theorem isCutOutBy_of_isCutOutByEquations (i : Z ⟶ X) [IsClosedImmersion i]
    {I : Type u} [Fintype I] {f : I → Γ(X, ⊤)} (hcut : IsCutOutByEquations i f) :
    Stacks.ConormalSequenceRight.IsCutOutBy i f := by
  classical
  intro x
  refine le_antisymm ?_ ?_
  · intro t ht
    obtain ⟨U, hxU, a, rfl⟩ := X.presheaf.exists_germ_eq t
    have hxiU : x ∈ i ⁻¹ᵁ U := hxU
    have ht0 : Z.presheaf.germ (i ⁻¹ᵁ U) x hxiU ((i.app U).hom a) = 0 := by
      refine Eq.trans (Scheme.Hom.germ_stalkMap_apply i U x hxU a).symm ?_
      exact RingHom.mem_ker.1 ht
    obtain ⟨W, hxW, iW, iW', hres⟩ :=
      Z.presheaf.germ_eq x hxiU hxiU ((i.app U).hom a) 0 (ht0.trans (map_zero _).symm)
    obtain ⟨V₁, hV₁⟩ := exists_preimage_eq i W
    have hxV₁ : i.base x ∈ V₁ := by
      have hmem : x ∈ i ⁻¹ᵁ V₁ := by rw [hV₁]; exact hxW
      exact hmem
    set U' : X.Opens := V₁ ⊓ U with hU'def
    have hU'U : U' ≤ U := inf_le_right
    have hxU' : i.base x ∈ U' := ⟨hxV₁, hxU⟩
    have hWU : W ≤ i ⁻¹ᵁ U := iW.le
    have hpre : i ⁻¹ᵁ U' ≤ W := by
      intro z hz
      have hmem : z ∈ i ⁻¹ᵁ V₁ := hz.1
      rw [hV₁] at hmem
      exact hmem
    have hres0 : Z.presheaf.map (homOfLE hWU).op ((i.app U).hom a) = 0 := by
      exact (presheaf_map_apply_congr _ iW.op _).trans (hres.trans (map_zero _))
    have h0 : (i.app U').hom (X.presheaf.map (homOfLE hU'U).op a) = 0 :=
      app_eq_zero_of_res_eq_zero i hU'U a hpre hWU hres0
    obtain ⟨V₀, hV₀U', hxV₀, c, hc⟩ :=
      hcut.exists_eq_sum U' (X.presheaf.map (homOfLE hU'U).op a) h0 (i.base x) hxU'
    have hgerm : X.presheaf.germ U (i.base x) hxU a =
        X.presheaf.germ V₀ (i.base x) hxV₀
          (X.presheaf.map (homOfLE hV₀U').op (X.presheaf.map (homOfLE hU'U).op a)) := by
      rw [X.presheaf.germ_res_apply, X.presheaf.germ_res_apply]
    rw [hgerm, hc, map_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [map_mul]
    refine Ideal.mul_mem_left _ _ ?_
    refine Set.mem_of_eq_of_mem ?_ (Ideal.subset_span ⟨j, rfl⟩)
    exact X.presheaf.germ_res_apply _ _ _ _
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    refine SetLike.mem_coe.2 (RingHom.mem_ker.2 ?_)
    refine Eq.trans (Scheme.Hom.germ_stalkMap_apply i ⊤ x trivial (f j)) ?_
    rw [hcut.appTop_eq_zero j]
    exact map_zero _

end Stacks.Gysin

end
