module

public import StacksFrontier.AlgebraicGeometry.ClosedPushforward.Basic
public import StacksFrontier.AlgebraicGeometry.ConormalSequenceRight.Middle
public import StacksFrontier.AlgebraicGeometry.Perfect.SupportClosedSubset.FractionClassMap

/-!
# The quotient by the equations is the restriction to the closed subscheme

Let `i : Z ⟶ X` be the closed subscheme of a scheme cut out by global functions
`f₁, …, f_c ∈ Γ(X, 𝒪_X)`, and let `ℱ` be an `𝒪_X`-module. Then

`ℱ / (f₁, …, f_c)ℱ ⟶ i_*i^*ℱ`

is an isomorphism: the unit of `i^* ⊣ i_*` **is** the cokernel of the map
`Stacks.Perfect.FractionClass.equationsMap`, which multiplies the `c` summands of `ℱ^{⊕c}` by
the equations. Equivalently, the kernel of `ℱ ⟶ i_*i^*ℱ` is generated by the sections `f_j ω`.

That `i_*i^*ℱ` is the quotient of `ℱ` by the ideal of the closed subscheme is
[Stacks, Tag 08KS]; what is added here is that the ideal is the one generated by the equations,
which is the only place the hypothesis that `Z` is cut out by `f₁, …, f_c` enters.

## Main definitions

* `Stacks.Gysin.IsCutOutByEquations`: the equations cut out the closed subscheme — their
  restrictions to `Z` vanish, and a function vanishing on `Z` is locally a combination of them.
  This is the ideal sheaf of `i` being generated by `f₁, …, f_c`.

## Main results

* `Stacks.Gysin.smulHom_cokernel_equationsMap_eq_zero`: the equations act as zero on
  `ℱ/(f₁, …, f_c)ℱ`.
* `Stacks.Gysin.isIso_cokernelDescUnit`: **the unit `ℱ ⟶ i_*i^*ℱ` is a cokernel of
  `equationsMap`.**
* `Stacks.Gysin.exists_comp_unit_eq`: the consumer form — a morphism out of `ℱ` killing every
  `f_j ω` factors through the restriction `ℱ ⟶ i_*i^*ℱ`, uniquely.

## Implementation notes

The proof is the two halves of a map being mono and epi. The comparison `θ` out of the cokernel
`Q = ℱ/(f₁, …, f_c)ℱ` is epi because the unit is (`Stacks.ClosedImmersion.epi_unit_app`). It is
mono because `Q` is annihilated by the ideal of `Z` — the equations act as zero on it, since they
do so after the epimorphism `ℱ ⟶ Q`, and a function vanishing on `Z` is locally a combination of
the equations, so it annihilates `Q` locally and therefore annihilates it — whence the unit of
`Q` is an isomorphism by [Stacks, Tag 08KS] in the form
`Stacks.ClosedImmersion.isIso_unit_app_of_smul_eq_zero`, and `θ` followed by a map is that
isomorphism.

`IsCutOutByEquations` is stated on sections rather than on stalks because that is the form in
which the annihilation of `Q` is needed; it is the same condition as the stalkwise
`Stacks.ConormalSequenceRight.IsCutOutBy` read at every point of `X` rather than only at the
points of `Z`, which is what makes it the statement that the *ideal sheaf* of `i` is generated by
the equations.

## References

* [Stacks Project, Tag 08KS](https://stacks.math.columbia.edu/tag/08KS)
* [Stacks Project, Tag 0G83](https://stacks.math.columbia.edu/tag/0G83)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.Perfect.FractionClass

universe u

namespace Stacks.Gysin

variable {X Z : Scheme.{u}}

/-- **The equations cut out the closed subscheme.** The ideal sheaf of `i : Z ⟶ X` is generated
by the global functions `f j`: each restricts to zero on `Z`, and a function on an open `U`
restricting to zero on `Z` is, in a neighbourhood of every point of `U`, a combination of
them. -/
structure IsCutOutByEquations (i : Z ⟶ X) {I : Type*} [Fintype I] (f : I → Γ(X, ⊤)) : Prop where
  /-- The equations vanish on the closed subscheme. -/
  appTop_eq_zero : ∀ j, (i.app ⊤).hom (f j) = 0
  /-- A function vanishing on the closed subscheme is locally a combination of the equations. -/
  exists_eq_sum : ∀ (U : X.Opens) (a : Γ(X, U)), (i.app U).hom a = 0 → ∀ x ∈ U,
    ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧ ∃ c : I → Γ(X, V),
      X.presheaf.map (homOfLE hVU).op a =
        ∑ j, c j * X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (f j)

/-- The restriction of a global function vanishing on the closed subscheme vanishes on the
closed subscheme over every open subset. -/
theorem app_resTop_eq_zero (i : Z ⟶ X) {r : Γ(X, ⊤)} (hr : (i.app ⊤).hom r = 0) (V : X.Opens) :
    (i.app V).hom (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op r) = 0 := by
  have h := congrArg (fun φ : Γ(X, ⊤) ⟶ Γ(Z, i ⁻¹ᵁ V) => ConcreteCategory.hom φ r)
    (i.naturality (U' := (⊤ : X.Opens)) (U := V) (homOfLE (le_top : V ≤ ⊤)).op)
  simp only [ConcreteCategory.comp_apply] at h
  refine h.trans ?_
  rw [hr]
  exact map_zero _

/-- **Multiplication by a global function vanishing on the closed subscheme is zero** on a module
annihilated by the ideal of that subscheme. -/
theorem smulHom_eq_zero_of_annihilated (i : Z ⟶ X) (M : X.Modules) {r : Γ(X, ⊤)}
    (hr : (i.app ⊤).hom r = 0)
    (hM : ∀ (U : X.Opens) (a : Γ(X, U)), (i.app U).hom a = 0 → ∀ m : Γ(M, U), a • m = 0) :
    smulHom r M = 0 := by
  refine Scheme.Modules.hom_ext _ _ fun V => ?_
  refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun x => ?_)
  rw [smulHom_app_apply]
  exact (hM V _ (app_resTop_eq_zero i hr V) x).trans (by simp)

variable (i : Z ⟶ X) [IsClosedImmersion i] {I : Type*} [Fintype I] (f : I → Γ(X, ⊤))

/-- The restriction `ℱ ⟶ i_*i^*ℱ` to the closed subscheme, the unit of `i^* ⊣ i_*`. -/
abbrev restrictionHom (M : X.Modules) :
    M ⟶ (Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M) :=
  (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M

omit [Fintype I] in
/-- **The equations act as zero on the restriction to the closed subscheme**: `i_*i^*ℱ` is
annihilated by the ideal of `Z`, by [Stacks, Tag 08KS], and the equations lie in that ideal. -/
theorem smulHom_restriction_eq_zero (hf : ∀ j, (i.app ⊤).hom (f j) = 0) (M : X.Modules) (j : I) :
    smulHom (f j) ((Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M)) = 0 :=
  smulHom_eq_zero_of_annihilated i _ (hf j)
    ((Stacks.ClosedImmersion.pushforward_essImage_iff i _).mp
      ((Scheme.Modules.pushforward i).obj_mem_essImage ((Scheme.Modules.pullback i).obj M)))

/-- The `j`-th summand of `ℱ^{⊕c}` maps to multiplication by the `j`-th equation. -/
private theorem ι_comp_equationsMap {c : ℕ} (g : Fin c → Γ(X, ⊤)) (M : X.Modules) (j : Fin c) :
    Sigma.ι (fun _ : Fin c => M) j ≫ equationsMap g M = smulHom (g j) M :=
  Limits.Sigma.ι_comp_desc _ j

/-- A morphism out of `ℱ` killing every `f_j ω` kills the image of `equationsMap`. -/
private theorem equationsMap_comp_eq_zero {c : ℕ} (g : Fin c → Γ(X, ⊤)) (M : X.Modules)
    {T : X.Modules} (ψ : M ⟶ T) (h : ∀ j, smulHom (g j) M ≫ ψ = 0) :
    equationsMap g M ≫ ψ = 0 := by
  refine Limits.Sigma.hom_ext _ _ fun j => ?_
  rw [comp_zero, ← Category.assoc, ι_comp_equationsMap, h j]

/-- The restriction to the closed subscheme kills the multiples of the equations. -/
theorem equationsMap_comp_restrictionHom_eq_zero {c : ℕ} (g : Fin c → Γ(X, ⊤))
    (hg : ∀ j, (i.app ⊤).hom (g j) = 0) (M : X.Modules) :
    equationsMap g M ≫ restrictionHom i M = 0 := by
  refine equationsMap_comp_eq_zero g M _ fun j => ?_
  rw [smulHom_naturality, smulHom_restriction_eq_zero i g hg M j, comp_zero]

/-- **The equations act as zero on `ℱ/(f₁, …, f_c)ℱ`**: they do so after the epimorphism
`ℱ ⟶ ℱ/(f₁, …, f_c)ℱ`, by the very definition of the quotient. -/
theorem smulHom_cokernel_equationsMap_eq_zero {c : ℕ} (g : Fin c → Γ(X, ⊤))
    (M : X.Modules) (j : Fin c) :
    smulHom (g j) (cokernel (equationsMap g M)) = 0 := by
  have hπ : smulHom (g j) M ≫ cokernel.π (equationsMap g M) = 0 := by
    rw [← ι_comp_equationsMap, Category.assoc, cokernel.condition, comp_zero]
  refine (cancel_epi (cokernel.π (equationsMap g M))).1 ?_
  rw [comp_zero, ← smulHom_naturality, hπ]

/-- **The quotient by the equations is annihilated by the ideal of the closed subscheme.** A
function vanishing on `Z` is locally a combination of the equations, each of which acts as zero,
and a section of a sheaf vanishing locally vanishes. -/
theorem smul_cokernel_eq_zero_of_eq_sum {c : ℕ} (g : Fin c → Γ(X, ⊤)) (M : X.Modules)
    (V : X.Opens) (r : Γ(X, V)) (b : Fin c → Γ(X, V))
    (hr : r = ∑ j, b j * X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (g j))
    (y : Γ(cokernel (equationsMap g M), V)) : r • y = 0 := by
  classical
  have hzero : ∀ j : Fin c,
      X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (g j) • y = 0 := by
    intro j
    have h := congrArg (fun φ : cokernel (equationsMap g M) ⟶ cokernel (equationsMap g M) =>
        (φ.app V).hom y)
      (smulHom_cokernel_equationsMap_eq_zero g M j)
    simpa [smulHom_app_apply] using h
  rw [hr, Finset.sum_smul]
  exact Finset.sum_eq_zero fun j _ => by rw [mul_smul, hzero j, smul_zero]

omit [IsClosedImmersion i] in
/-- **The quotient by the equations is annihilated by the ideal of the closed subscheme.** -/
theorem annihilated_cokernel_equationsMap {c : ℕ} {g : Fin c → Γ(X, ⊤)}
    (hcut : IsCutOutByEquations i g) (M : X.Modules) (U : X.Opens) (a : Γ(X, U))
    (ha : (i.app U).hom a = 0) (m : Γ(cokernel (equationsMap g M), U)) : a • m = 0 := by
  classical
  refine (cokernel (equationsMap g M)).isSheaf.isSeparated U
    { arrows := fun V h => ∃ b : Fin c → Γ(X, V),
        X.presheaf.map h.op a =
          ∑ j, b j * X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (g j)
      downward_closed := by
        rintro V W h ⟨b, hb⟩ k
        refine ⟨fun j => X.presheaf.map k.op (b j), ?_⟩
        have hk := congrArg (fun z : Γ(X, V) => X.presheaf.map k.op z) hb
        simp only [map_sum, map_mul] at hk
        have hcomp : X.presheaf.map (k ≫ h).op a =
            X.presheaf.map k.op (X.presheaf.map h.op a) := by
          rw [← ConcreteCategory.comp_apply, ← X.presheaf.map_comp]
          exact congrArg (fun m : (op U : X.Opensᵒᵖ) ⟶ op W => (X.presheaf.map m).hom a)
            (Subsingleton.elim _ _)
        have hres : ∀ j, X.presheaf.map k.op
              (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (g j)) =
            X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (g j) := by
          intro j
          rw [← ConcreteCategory.comp_apply, ← X.presheaf.map_comp]
          exact congrArg (fun m : (op ⊤ : X.Opensᵒᵖ) ⟶ op W => (X.presheaf.map m).hom (g j))
            (Subsingleton.elim _ _)
        refine hcomp.trans (hk.trans (Finset.sum_congr rfl fun j _ => ?_))
        exact congrArg (fun z => X.presheaf.map k.op (b j) * z) (hres j) }
    ?_ (a • m) 0 ?_
  · intro x hx
    obtain ⟨V, hVU, hxV, b, hb⟩ := hcut.exists_eq_sum U a ha x hx
    exact ⟨V, homOfLE hVU, ⟨b, hb⟩, hxV⟩
  · rintro V h ⟨b, hb⟩
    refine Eq.trans ((cokernel (equationsMap g M)).val.map_smul h.op a m) ?_
    refine Eq.trans ?_ (map_zero _).symm
    exact smul_cokernel_eq_zero_of_eq_sum g M V _ b hb _

/-- The comparison `ℱ/(f₁, …, f_c)ℱ ⟶ i_*i^*ℱ` out of the quotient by the equations. -/
def cokernelDescUnit {c : ℕ} (g : Fin c → Γ(X, ⊤))
    (hg : ∀ j, (i.app ⊤).hom (g j) = 0) (M : X.Modules) :
    cokernel (equationsMap g M) ⟶
      (Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M) :=
  cokernel.desc _ (restrictionHom i M) (equationsMap_comp_restrictionHom_eq_zero i g hg M)

/-- The projection `ℱ ⟶ ℱ/(f₁, …, f_c)ℱ` followed by the comparison `cokernelDescUnit` is the
restriction `ℱ ⟶ i_*i^*ℱ`. -/
@[simp]
theorem cokernelπ_comp_cokernelDescUnit {c : ℕ} (g : Fin c → Γ(X, ⊤))
    (hg : ∀ j, (i.app ⊤).hom (g j) = 0) (M : X.Modules) :
    cokernel.π (equationsMap g M) ≫ cokernelDescUnit i g hg M = restrictionHom i M :=
  cokernel.π_desc _ _ _

/-- **The restriction `ℱ ⟶ i_*i^*ℱ` is a cokernel of the equations map**: the comparison out of
`ℱ/(f₁, …, f_c)ℱ` is an isomorphism.

It is an epimorphism because the unit is one, by [Stacks, Tag 08KS]. It is a monomorphism
because the quotient is annihilated by the ideal of `Z`, so that its own unit is an isomorphism,
again by [Stacks, Tag 08KS], and that isomorphism factors through the comparison. -/
theorem isIso_cokernelDescUnit {c : ℕ} {g : Fin c → Γ(X, ⊤)}
    (hcut : IsCutOutByEquations i g) (M : X.Modules) :
    IsIso (cokernelDescUnit i g hcut.appTop_eq_zero M) := by
  set Q := cokernel (equationsMap g M) with hQ
  set θ := cokernelDescUnit i g hcut.appTop_eq_zero M with hθ
  have hQiso : IsIso (restrictionHom i Q) :=
    Stacks.ClosedImmersion.isIso_unit_app_of_smul_eq_zero i Q
      (annihilated_cokernel_equationsMap i hcut M)
  have hfac : θ ≫ ((Scheme.Modules.pullback i ⋙ Scheme.Modules.pushforward i).map
      (cokernel.π (equationsMap g M))) = restrictionHom i Q := by
    refine (cancel_epi (cokernel.π (equationsMap g M))).1 ?_
    rw [← Category.assoc, cokernelπ_comp_cokernelDescUnit]
    exact ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.naturality
      (cokernel.π (equationsMap g M))).symm
  have : IsIso (restrictionHom i Q) := hQiso
  have hmono : Mono θ := by
    have h2 : Mono (θ ≫ (Scheme.Modules.pullback i ⋙ Scheme.Modules.pushforward i).map
        (cokernel.π (equationsMap g M))) := by
      rw [hfac]
      infer_instance
    exact mono_of_mono θ ((Scheme.Modules.pullback i ⋙ Scheme.Modules.pushforward i).map
      (cokernel.π (equationsMap g M)))
  have hepi : Epi θ := by
    have hu : Epi (cokernel.π (equationsMap g M) ≫ θ) := by
      rw [cokernelπ_comp_cokernelDescUnit]
      exact Stacks.ClosedImmersion.epi_unit_app i M
    exact epi_of_epi (cokernel.π (equationsMap g M)) θ
  exact isIso_of_mono_of_epi θ

/-- **A morphism killing the multiples of the equations factors through the restriction to the
closed subscheme.** This is the elimination form of `isIso_cokernelDescUnit`. -/
theorem exists_comp_unit_eq {c : ℕ} {g : Fin c → Γ(X, ⊤)}
    (hcut : IsCutOutByEquations i g) (M : X.Modules) {T : X.Modules} (ψ : M ⟶ T)
    (hψ : ∀ j, smulHom (g j) M ≫ ψ = 0) :
    ∃ ψ' : (Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M) ⟶ T,
      restrictionHom i M ≫ ψ' = ψ := by
  have h0 := equationsMap_comp_eq_zero g M ψ hψ
  have := isIso_cokernelDescUnit i hcut M
  refine ⟨inv (cokernelDescUnit i g hcut.appTop_eq_zero M) ≫
    cokernel.desc (equationsMap g M) ψ h0, ?_⟩
  rw [← cokernelπ_comp_cokernelDescUnit i g hcut.appTop_eq_zero M, Category.assoc,
    ← Category.assoc (cokernelDescUnit i g hcut.appTop_eq_zero M),
    IsIso.hom_inv_id, Category.id_comp, cokernel.π_desc]

end Stacks.Gysin

end
