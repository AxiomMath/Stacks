module

public import StacksFrontier.AlgebraicGeometry.DeRham.LogPoles.LogFormsEval
public import StacksFrontier.AlgebraicGeometry.DeRham.LogPoles.KernelLocalGeneration
public import StacksFrontier.AlgebraicGeometry.DeRham.LogPoles.IdealTrivializationCover

/-!
# The differential of the de Rham complex of log poles

Let `f : X ⟶ S` be a morphism of schemes and `Y ⊆ X` an effective Cartier divisor, cut out by
`I`, for which the de Rham complex of log poles is defined ([Stacks, Tag 0FMV]). This file
constructs the differential `d : Ω^p_{X/S}(log Y) ⟶ Ω^{p+1}_{X/S}(log Y)` of [Stacks, Tag 0FMW].

Recall `Ω^p_{X/S}(log Y) = SheafHom(ℐ, 𝒦^p)`, `𝒦^p` the forms vanishing on `Y`
(`AlgebraicGeometry.Scheme.Hom.logPolesForms`); a form with log poles is thought of as `ω` with
`φ(a) = a ω`. The differential of `φ` is characterised, equation-free, by the Leibniz rule
`a · (dφ)(b) = a · d(φ b) - db ∧ φ(a)` for local sections `a, b` of `ℐ`
(`AlgebraicGeometry.Scheme.Hom.LeibnizRel`): with `φ(a) = a ω` the right-hand side is
`a (db ∧ ω + b dω) - db ∧ a ω = a b dω`.

* The relation has at most one solution, because locally `ℐ` is generated by a local equation `t`,
  which is a nonzerodivisor on the forms (`AlgebraicGeometry.Scheme.Hom.LeibnizRel.unique`).
* It has a solution locally: on an open where `ℐ` is trivialized with local equation `t` and
  `φ(t) = t α + ε` with `dt ∧ ε = 0` — which is the local shape of a form vanishing on `Y` —
  the solution is `θ(b) (t dα + dε)` (`Stacks.Divisors.IdealTrivialization.leibnizRel_logOfCoord`).
  This is the computation `d(t⁻¹ (t α + dt ∧ β)) = t⁻¹ (t dα - dt ∧ dβ)` of the source.

So the local solutions glue (`TopCat.Sheaf.exists_of_local`), and the glued values form a section
of `Ω^{p+1}_{X/S}(log Y)`.

## References

* [Stacks Project, Tag 0FMW](https://stacks.math.columbia.edu/tag/0FMW)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData}

/-! ### Local sections of the ideal sheaf, as functions -/

/-- A local section of the ideal sheaf, as a local function. -/
abbrev idealFn {V : X.Opens} (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) : Γ(X, V) :=
  negativeTwistSection I V a

/-- Restriction of local sections of the ideal sheaf. -/
abbrev idealRes {V V' : X.Opens} (h : V' ≤ V)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    (Stacks.Divisors.negativeTwist I).val.obj (op V') :=
  (Stacks.Divisors.negativeTwist I).val.map (homOfLE h).op a

/-- The function of a restricted section of the ideal sheaf is the restricted function. -/
theorem idealFn_res {V V' : X.Opens} (h : V' ≤ V)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealFn (idealRes h a) = X.presheaf.map (homOfLE h).op (idealFn a) :=
  PresheafOfModules.naturality_apply (Stacks.Divisors.idealInclusion I).val (homOfLE h).op a

/-- The function of a sum of sections of the ideal sheaf is the sum of the functions. -/
theorem idealFn_add {V : X.Opens} (a a' : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealFn (a + a') = idealFn a + idealFn a' :=
  map_add (negativeTwistInclusion I V) a a'

/-- The function of `r • a` is `r` times the function of `a`. -/
theorem idealFn_smul {V : X.Opens} (r : Γ(X, V))
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealFn (toIdealScalar r • a) = r * idealFn a :=
  (negativeTwistInclusion I V).map_smul r a

/-- Restricting a section of the ideal sheaf twice is restricting it once. -/
theorem idealRes_idealRes {V V' V'' : X.Opens} (h : V' ≤ V) (h' : V'' ≤ V')
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealRes h' (idealRes h a) = idealRes (h'.trans h) a := by
  rw [idealRes, idealRes, ← PresheafOfModules.map_comp_apply]
  rfl

/-- Restricting a section of the ideal sheaf to the same open is the identity. -/
theorem idealRes_refl {V : X.Opens} (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealRes (le_refl V) a = a := by
  rw [idealRes, show homOfLE (le_refl V) = 𝟙 V from Subsingleton.elim _ _, op_id,
    PresheafOfModules.map_id]
  rfl

/-- Restriction of sections of the ideal sheaf is additive. -/
theorem idealRes_add {V V' : X.Opens} (h : V' ≤ V)
    (a a' : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealRes h (a + a') = idealRes h a + idealRes h a' :=
  map_add _ a a'

/-- Restricting the value of a logarithmic form is evaluating it at the restricted section. -/
theorem map_logEval {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' W'' : X.Opens} (h : W' ≤ W) (h' : W'' ≤ W')
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h').op (logEval f I φ h a) =
      logEval f I φ (h'.trans h) (idealRes h' a) :=
  (logEval_map φ h h' a).symm

/-- **`a · φ(b) = b · φ(a)`** for a form `φ` with logarithmic poles: both are `φ(a b)`. -/
theorem idealFn_smul_logEval_comm {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (h : W' ≤ W) (a b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    idealFn a • logEval f I φ h b = idealFn b • logEval f I φ h a := by
  rw [← logEval_smul, ← logEval_smul]
  exact congrArg (logEval f I φ h) (negativeTwistInclusion_smul_comm I W' a b)

/-- A local section of the ideal sheaf vanishes on `Y`, as a function. -/
theorem app_idealFn {V : X.Opens} (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    (I.subschemeι.app V).hom (idealFn a) = 0 :=
  structureSheafHom_negativeTwistSection I V a

/-- A multiple of a local section of the ideal sheaf vanishes on `Y`. -/
theorem formRes_idealFn_smul {n : ℤ} {V : X.Opens}
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V))
    (x : Γ(relativeDifferentialForms f n, V)) :
    formRes I.subschemeι n V (idealFn a • x) = 0 := by
  rw [formRes_smul, app_idealFn, zero_smul]

/-- `da ∧ β` vanishes on `Y` for a local section `a` of the ideal sheaf. -/
theorem formRes_exactWedge_idealFn {p : ℕ} {V : X.Opens}
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V))
    (β : Γ(relativeDifferentialForms f (p : ℤ), V)) :
    formRes I.subschemeι ((p + 1 : ℕ) : ℤ) V (exactWedge f p V (idealFn a) β) = 0 := by
  rw [formRes, formRestriction_exactWedge, app_idealFn]
  exact exactWedge_zero_left p _ _

/-- Restriction to `Y` commutes with restriction to smaller opens. -/
theorem formRes_map {n : ℤ} {V V' : X.Opens} (h : V' ≤ V)
    (x : Γ(relativeDifferentialForms f n, V)) :
    formRes I.subschemeι n V' ((relativeDifferentialForms f n).presheaf.map (homOfLE h).op x) =
      ((Scheme.Modules.pushforward I.subschemeι).obj
          (relativeDifferentialForms (I.subschemeι ≫ f) n)).presheaf.map (homOfLE h).op
        (formRes I.subschemeι n V x) :=
  PresheafOfModules.naturality_apply (formRestriction I.subschemeι f n).val (homOfLE h).op x

/-! ### The Leibniz relation -/

/-- The right-hand side `a · d(φ b) - db ∧ φ(a)` of the Leibniz relation, over an open
`V' ≤ W'`, for a local section `b` of the ideal sheaf over `W'` and `a` over `V'`. -/
def leibnizRHS {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W)) {W' : X.Opens}
    (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) {V' : X.Opens}
    (hV' : V' ≤ W') (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V') :=
  idealFn a • deRhamD f p V' (logEval f I φ (hV'.trans hW') (idealRes hV' b)) -
    exactWedge f p V' (idealFn (idealRes hV' b)) (logEval f I φ (hV'.trans hW') a)

/-- Restriction of sections of the ideal sheaf is compatible with scalar multiplication. -/
theorem idealRes_smul {V V' : X.Opens} (h : V' ≤ V) (r : Γ(X, V))
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    idealRes h (toIdealScalar r • a) =
      toIdealScalar (X.presheaf.map (homOfLE h).op r) • idealRes h a :=
  (Stacks.Divisors.negativeTwist I).val.map_smul (homOfLE h).op r a

/-- The right-hand side of the Leibniz relation is additive in `b`. -/
theorem leibnizRHS_add {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b b' : (Stacks.Divisors.negativeTwist I).val.obj (op W'))
    {V' : X.Opens} (hV' : V' ≤ W') (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    leibnizRHS φ hW' (b + b') hV' a = leibnizRHS φ hW' b hV' a + leibnizRHS φ hW' b' hV' a := by
  rw [leibnizRHS, leibnizRHS, leibnizRHS, idealRes_add, logEval_add_right, deRhamD_add,
    idealFn_add, exactWedge_add_left]
  module

/-- The right-hand side of the Leibniz relation is additive in `φ`. -/
theorem leibnizRHS_add_left {p : ℕ} {W : X.Opens} (φ φ' : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W'))
    {V' : X.Opens} (hV' : V' ≤ W') (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    leibnizRHS (φ + φ') hW' b hV' a = leibnizRHS φ hW' b hV' a + leibnizRHS φ' hW' b hV' a := by
  rw [leibnizRHS, leibnizRHS, leibnizRHS, logEval_add, logEval_add, deRhamD_add,
    exactWedge_add_right]
  module

/-- The right-hand side of the Leibniz relation is `𝒪`-linear in `b`. This is where `φ` being
linear on the ideal sheaf is used, through `a · φ(b) = b · φ(a)`. -/
theorem leibnizRHS_smul {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (r : Γ(X, W'))
    (b : (Stacks.Divisors.negativeTwist I).val.obj (op W'))
    {V' : X.Opens} (hV' : V' ≤ W') (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    leibnizRHS φ hW' (toIdealScalar r • b) hV' a =
      X.presheaf.map (homOfLE hV').op r • leibnizRHS φ hW' b hV' a := by
  have key : idealFn a • exactWedge f p V' (X.presheaf.map (homOfLE hV').op r)
        (logEval f I φ (hV'.trans hW') (idealRes hV' b)) =
      idealFn (idealRes hV' b) • exactWedge f p V' (X.presheaf.map (homOfLE hV').op r)
        (logEval f I φ (hV'.trans hW') a) := by
    rw [← exactWedge_smul_right, ← exactWedge_smul_right, idealFn_smul_logEval_comm]
  rw [leibnizRHS, leibnizRHS, idealRes_smul, logEval_smul, deRhamD_smul, idealFn_smul,
    exactWedge_mul_left]
  linear_combination (norm := module) key

/-- The right-hand side of the Leibniz relation for a restricted section `b`. -/
theorem leibnizRHS_idealRes {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' W'' : X.Opens} (hW' : W' ≤ W) (h'' : W'' ≤ W')
    (b : (Stacks.Divisors.negativeTwist I).val.obj (op W'))
    {V' : X.Opens} (hV' : V' ≤ W'') (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    leibnizRHS φ (h''.trans hW') (idealRes h'' b) hV' a = leibnizRHS φ hW' b (hV'.trans h'') a := by
  rw [leibnizRHS, leibnizRHS, idealRes_idealRes]

/-- The right-hand side of the Leibniz relation commutes with restriction. -/
theorem leibnizRHS_res {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W'))
    {V' V'' : X.Opens} (hV' : V' ≤ W') (h : V'' ≤ V')
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE h).op
        (leibnizRHS φ hW' b hV' a) =
      leibnizRHS φ hW' b (h.trans hV') (idealRes h a) := by
  rw [leibnizRHS, leibnizRHS, map_sub, forms_map_smul, ← idealFn_res, deRhamD_res,
    exactWedge_res, ← idealFn_res, map_logEval, map_logEval, idealRes_idealRes]

/-- **The Leibniz relation** characterising the value `ψ` over `V ≤ W'` of the differential of a
form `φ` with logarithmic poles at a local section `b` of the ideal sheaf over `W'`:
`a · ψ = a · d(φ b) - db ∧ φ(a)` over every open `V' ≤ V` and for every local section `a`
of the ideal sheaf there. -/
def LeibnizRel {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W)) {W' : X.Opens}
    (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) (V : X.Opens)
    (hV : V ≤ W') (ψ : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)) : Prop :=
  ∀ (V' : X.Opens) (hV' : V' ≤ V) (a : (Stacks.Divisors.negativeTwist I).val.obj (op V')),
    idealFn a • (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE hV').op ψ =
      leibnizRHS φ hW' b (hV'.trans hV) a

/-- **The Leibniz relation has at most one solution**: near every point the ideal sheaf has a
basis element whose function is a local equation `t`, and `t` is a nonzerodivisor on the forms
when the de Rham complex of log poles is defined. -/
theorem LeibnizRel.unique (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p : ℕ} {W : X.Opens}
    {φ : (logPolesForms f I p).val.obj (op W)} {W' : X.Opens} {hW' : W' ≤ W}
    {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')} {V : X.Opens} {hV : V ≤ W'}
    {ψ ψ' : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)}
    (hψ : LeibnizRel φ hW' b V hV ψ) (hψ' : LeibnizRel φ hW' b V hV ψ') : ψ = ψ' := by
  refine TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf _) fun x hx => ?_
  obtain ⟨Ux, hxU, ⟨e⟩⟩ := Stacks.Divisors.IdealTrivialization.exists_mem_nonempty hI x
  refine ⟨V ⊓ Ux, inf_le_left, ⟨hx, hxU⟩, ?_⟩
  have h1 := hψ (V ⊓ Ux) inf_le_left (e.basisLE inf_le_right)
  have h2 := hψ' (V ⊓ Ux) inf_le_left (e.basisLE inf_le_right)
  rw [← h2] at h1
  have h3 : e.equationAt (inf_le_right : V ⊓ Ux ≤ Ux) •
      ((relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
          (homOfLE (inf_le_left : V ⊓ Ux ≤ V)).op ψ -
        (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
          (homOfLE (inf_le_left : V ⊓ Ux ≤ V)).op ψ') = 0 := by
    rw [smul_sub]
    exact sub_eq_zero.mpr h1
  exact sub_eq_zero.mp (e.eq_zero_of_equationAt_smul_eq_zero hlog inf_le_right (p + 1) _ h3)

/-- **The Leibniz relation is local.** -/
theorem LeibnizRel.of_local {p : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {W' : X.Opens} {hW' : W' ≤ W} {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {V : X.Opens} {hV : V ≤ W'} {ψ : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)}
    (hloc : ∀ x ∈ V, ∃ (V₁ : X.Opens) (h₁ : V₁ ≤ V), x ∈ V₁ ∧
      LeibnizRel φ hW' b V₁ (h₁.trans hV)
        ((relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE h₁).op ψ)) :
    LeibnizRel φ hW' b V hV ψ := by
  intro V' hV' a
  refine TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf _) fun y hy => ?_
  obtain ⟨V₁, h₁, hy₁, hrel⟩ := hloc y (hV' hy)
  refine ⟨V' ⊓ V₁, inf_le_left, ⟨hy, hy₁⟩, ?_⟩
  have key := hrel (V' ⊓ V₁) inf_le_right (idealRes inf_le_left a)
  rw [forms_map_map] at key
  show (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
      (homOfLE (inf_le_left : V' ⊓ V₁ ≤ V')).op
      (idealFn a • (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
        (homOfLE hV').op ψ) =
    (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
      (homOfLE (inf_le_left : V' ⊓ V₁ ≤ V')).op (leibnizRHS φ hW' b (hV'.trans hV) a)
  rw [forms_map_smul, ← idealFn_res, forms_map_map, leibnizRHS_res]
  exact key

/-- The Leibniz relation restricts to smaller opens. -/
theorem LeibnizRel.res {p : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {W' : X.Opens} {hW' : W' ≤ W} {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {V : X.Opens} {hV : V ≤ W'} {ψ : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)}
    (hψ : LeibnizRel φ hW' b V hV ψ) {V₂ : X.Opens} (h₂ : V₂ ≤ V) :
    LeibnizRel φ hW' b V₂ (h₂.trans hV)
      ((relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE h₂).op ψ) := by
  intro V' hV' a
  rw [forms_map_map]
  exact hψ V' (hV'.trans h₂) a


/-- Solutions of the Leibniz relation for `b` and `b'` add to a solution for `b + b'`. -/
theorem LeibnizRel.add {p : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {W' : X.Opens} {hW' : W' ≤ W} {b b' : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {V : X.Opens} {hV : V ≤ W'} {ψ ψ' : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)}
    (hψ : LeibnizRel φ hW' b V hV ψ) (hψ' : LeibnizRel φ hW' b' V hV ψ') :
    LeibnizRel φ hW' (b + b') V hV (ψ + ψ') := by
  intro V' hV' a
  rw [map_add, smul_add, hψ V' hV' a, hψ' V' hV' a, leibnizRHS_add]

/-- Solutions of the Leibniz relation for `φ` and `φ'` add to a solution for `φ + φ'`. -/
theorem LeibnizRel.add_left {p : ℕ} {W : X.Opens} {φ φ' : (logPolesForms f I p).val.obj (op W)}
    {W' : X.Opens} {hW' : W' ≤ W} {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {V : X.Opens} {hV : V ≤ W'} {ψ ψ' : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)}
    (hψ : LeibnizRel φ hW' b V hV ψ) (hψ' : LeibnizRel φ' hW' b V hV ψ') :
    LeibnizRel (φ + φ') hW' b V hV (ψ + ψ') := by
  intro V' hV' a
  rw [map_add, smul_add, hψ V' hV' a, hψ' V' hV' a, leibnizRHS_add_left]

/-- If `ψ` solves the Leibniz relation for `b`, then `r • ψ` solves it for `r • b`. -/
theorem LeibnizRel.smul {p : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {W' : X.Opens} {hW' : W' ≤ W} {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {ψ : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), W')}
    (hψ : LeibnizRel φ hW' b W' le_rfl ψ) (r : Γ(X, W')) :
    LeibnizRel φ hW' (toIdealScalar r • b) W' le_rfl (r • ψ) := by
  intro V' hV' a
  rw [forms_map_smul, smul_comm, hψ V' hV' a, leibnizRHS_smul]

/-- The Leibniz relation for `b` at `V ≤ W''` is the Leibniz relation for `b|_{W''}`. -/
theorem LeibnizRel.idealRes {p : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {W' W'' : X.Opens} {hW' : W' ≤ W} (h'' : W'' ≤ W')
    {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {V : X.Opens} {hV : V ≤ W''} {ψ : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V)}
    (hψ : LeibnizRel φ hW' b V (hV.trans h'') ψ) :
    LeibnizRel φ (h''.trans hW') (idealRes h'' b) V hV ψ := by
  intro V' hV' a
  rw [leibnizRHS_idealRes]
  exact hψ V' hV' a

end AlgebraicGeometry.Scheme.Hom

namespace Stacks.Divisors.IdealTrivialization

open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData} {U : X.Opens}
  (e : IdealTrivialization I U)

/-- The coordinates of local sections of the ideal sheaf are compatible with restriction. -/
theorem coordLE_res {W W' : X.Opens} (h : W ≤ U) (h' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W)) :
    e.coordLE (h'.trans h) (idealRes h' a) = X.presheaf.map (homOfLE h').op (e.coordLE h a) :=
  e.θ_naturality (homOfLE h) (homOfLE h') a

/-- A local section of the ideal sheaf, as a function, is its coordinate times the local
equation. -/
theorem idealFn_eq_mul {W : X.Opens} (h : W ≤ U)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W)) :
    idealFn a = e.coordLE h a * e.equationAt h :=
  e.negativeTwistSection_eq_mul h a

/-- A local section of the ideal sheaf is its coordinate times the basis element. -/
theorem eq_coord_smul_basisLE {W : X.Opens} (h : W ≤ U)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W)) :
    a = toIdealScalar (e.coordLE h a) • e.basisLE h :=
  e.eq_smul_basisLE h a

/-- The value of a form with logarithmic poles at a local section of the ideal sheaf over a
chart: the coordinate of the section times the value at the basis element. -/
theorem logEval_eq_coord_smul {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (h : W' ≤ W) (hU : W' ≤ U)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    logEval f I φ h a = e.coordLE hU a • logEval f I φ h (e.basisLE hU) := by
  conv_lhs => rw [e.eq_coord_smul_basisLE hU a]
  exact logEval_smul φ h _ _

/-- The values at the basis elements of a chart are compatible with restriction. -/
theorem logEval_basisLE_res {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' W'' : X.Opens} (h : W' ≤ W) (hU : W' ≤ U) (h' : W'' ≤ W') :
    logEval f I φ (h'.trans h) (e.basisLE (h'.trans hU)) =
      (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h').op
        (logEval f I φ h (e.basisLE hU)) := by
  rw [← e.basisLE_res hU h']
  exact logEval_map φ h h' _

/-- **The local solution of the Leibniz relation.** On a chart, write `κ = φ(b₀)` for the value
of `φ` at the basis element. If `z` solves `t z = t dκ - dt ∧ κ` — that is, `z = t d(t⁻¹ κ)` —
then `θ(b) z` satisfies the Leibniz relation for the differential of `φ` at `b`. -/
theorem leibnizRel_coord_smul {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W'))
    {V : X.Opens} (hV : V ≤ W') (hVU : V ≤ U)
    (z : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), V))
    (hz : e.equationAt hVU • z =
      e.equationAt hVU • deRhamD f p V (logEval f I φ (hV.trans hW') (e.basisLE hVU)) -
        exactWedge f p V (e.equationAt hVU) (logEval f I φ (hV.trans hW') (e.basisLE hVU))) :
    LeibnizRel φ hW' b V hV (e.coordLE hVU (idealRes hV b) • z) := by
  intro V' hV' a
  rw [leibnizRHS]
  set κ := logEval f I φ (hV.trans hW') (e.basisLE hVU) with hκ
  set t := e.equationAt (hV'.trans hVU) with ht
  set κ' := (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE hV').op κ with hκ'
  set z' := (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE hV').op z
    with hz'
  set ca := e.coordLE (hV'.trans hVU) a with hca
  set cb := e.coordLE (hV'.trans hVU) (idealRes (hV'.trans hV) b) with hcb
  have hres : t • z' = t • deRhamD f p V' κ' - exactWedge f p V' t κ' := by
    have h1 := congrArg ((relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
      (homOfLE hV').op) hz
    rw [forms_map_smul, map_sub, forms_map_smul, deRhamD_res, exactWedge_res,
      e.equationAt_res hVU hV'] at h1
    exact h1
  have hcb' : X.presheaf.map (homOfLE hV').op (e.coordLE hVU (idealRes hV b)) = cb := by
    rw [hcb, ← idealRes_idealRes hV hV', e.coordLE_res hVU hV']
  have hφ : ∀ c : (Stacks.Divisors.negativeTwist I).val.obj (op V'),
      logEval f I φ ((hV'.trans hV).trans hW') c = e.coordLE (hV'.trans hVU) c • κ' := fun c => by
    rw [e.logEval_eq_coord_smul φ _ (hV'.trans hVU), e.logEval_basisLE_res φ (hV.trans hW') hVU hV']
  rw [forms_map_smul, hcb', hφ, hφ, e.idealFn_eq_mul (hV'.trans hVU) a,
    e.idealFn_eq_mul (hV'.trans hVU) (idealRes (hV'.trans hV) b), deRhamD_smul,
    exactWedge_smul_right, exactWedge_mul_left]
  linear_combination (norm := module) (ca * cb) • hres

/-- **A chart decomposition** `κ = t α + ε` of a local form over an open `V ≤ U`, `t` the local
equation, with `dt ∧ ε = 0`, `dt ∧ dε = 0` and `dε` vanishing on `Y`. For a form vanishing on
`Y` this is the shape `t α + dt ∧ β` (or `t α` in degree `0`). -/
def IsChartDecomp {p : ℕ} {V : X.Opens} (hV : V ≤ U)
    (κ α ε : Γ(relativeDifferentialForms f (p : ℤ), V)) : Prop :=
  κ = e.equationAt hV • α + ε ∧ exactWedge f p V (e.equationAt hV) ε = 0 ∧
    exactWedge f (p + 1) V (e.equationAt hV) (deRhamD f p V ε) = 0 ∧
    formRes I.subschemeι ((p + 1 : ℕ) : ℤ) V (deRhamD f p V ε) = 0

/-- **`t d(t⁻¹ κ) = t dα + dε`** for a chart decomposition `κ = t α + ε`: the form `t dα + dε`
solves `t z = t dκ - dt ∧ κ`. -/
theorem IsChartDecomp.solves {p : ℕ} {V : X.Opens} {hV : V ≤ U}
    {κ α ε : Γ(relativeDifferentialForms f (p : ℤ), V)} (hd : e.IsChartDecomp hV κ α ε) :
    e.equationAt hV • (e.equationAt hV • deRhamD f p V α + deRhamD f p V ε) =
      e.equationAt hV • deRhamD f p V κ - exactWedge f p V (e.equationAt hV) κ := by
  obtain ⟨hκ, hw, -, -⟩ := hd
  rw [hκ, deRhamD_add, deRhamD_smul, exactWedge_add_right, exactWedge_smul_right, hw]
  module

/-- The form `t dα + dε` of a chart decomposition has again a chart decomposition. -/
theorem IsChartDecomp.next {p : ℕ} {V : X.Opens} {hV : V ≤ U}
    {κ α ε : Γ(relativeDifferentialForms f (p : ℤ), V)} (hd : e.IsChartDecomp hV κ α ε) :
    e.IsChartDecomp hV (e.equationAt hV • deRhamD f p V α + deRhamD f p V ε)
      (deRhamD f p V α) (deRhamD f p V ε) := by
  obtain ⟨-, -, hw', hr⟩ := hd
  refine ⟨rfl, hw', ?_, ?_⟩
  · rw [deRhamD_deRhamD]
    exact exactWedge_zero_right _ _ _
  · rw [deRhamD_deRhamD]
    exact formRes_zero _ _ _

/-- The form `t dα + dε` of a chart decomposition vanishes on `Y`. -/
theorem IsChartDecomp.formRes_next {p : ℕ} {V : X.Opens} {hV : V ≤ U}
    {κ α ε : Γ(relativeDifferentialForms f (p : ℤ), V)} (hd : e.IsChartDecomp hV κ α ε) :
    formRes I.subschemeι ((p + 1 : ℕ) : ℤ) V
      (e.equationAt hV • deRhamD f p V α + deRhamD f p V ε) = 0 := by
  rw [formRes_add]
  refine (congrArg₂ (· + ·) (formRes_idealFn_smul (e.basisLE hV) _) hd.2.2.2).trans (add_zero 0)

/-- **Every form vanishing on `Y` has chart decompositions near every point.** -/
theorem exists_isChartDecomp {p : ℕ} {W : X.Opens} (hW : W ≤ U)
    (κ : Γ(relativeDifferentialForms f (p : ℤ), W))
    (hκ : formRes I.subschemeι (p : ℤ) W κ = 0) (x : X) (hx : x ∈ W) :
    ∃ (V : X.Opens) (hV : V ≤ W), x ∈ V ∧ ∃ α ε, e.IsChartDecomp (hV.trans hW)
      ((relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE hV).op κ) α ε := by
  cases p with
  | zero =>
    obtain ⟨V, hV, hxV, α, hα⟩ := e.exists_local_eq_smul hW κ hκ x hx
    refine ⟨V, hV, hxV, α, 0, ?_, exactWedge_zero_right _ _ _, ?_, ?_⟩
    · rw [add_zero]; exact hα
    · rw [show deRhamD f 0 V (0 : Γ(relativeDifferentialForms f ((0 : ℕ) : ℤ), V)) = 0 from
        map_zero _]
      exact exactWedge_zero_right _ _ _
    · rw [show deRhamD f 0 V (0 : Γ(relativeDifferentialForms f ((0 : ℕ) : ℤ), V)) = 0 from
        map_zero _]
      exact map_zero _
  | succ q =>
    obtain ⟨V, hV, hxV, α, β, hαβ⟩ := e.exists_local_eq_smul_add_exactWedge hW q κ hκ x hx
    refine ⟨V, hV, hxV, α, exactWedge f q V (e.equationAt (hV.trans hW)) β, hαβ,
      exactWedge_exactWedge_self _ _ _ _, ?_, ?_⟩
    · rw [deRhamD_exactWedge, exactWedge_neg_right, exactWedge_exactWedge_self, neg_zero]
    · rw [deRhamD_exactWedge, formRes_neg]
      exact (congrArg Neg.neg (formRes_exactWedge_idealFn (e.basisLE (hV.trans hW)) _)).trans
        neg_zero

/-- Chart decompositions restrict to smaller opens. -/
theorem IsChartDecomp.res {p : ℕ} {V : X.Opens} {hV : V ≤ U}
    {κ α ε : Γ(relativeDifferentialForms f (p : ℤ), V)} (hd : e.IsChartDecomp hV κ α ε)
    {V' : X.Opens} (h : V' ≤ V) :
    e.IsChartDecomp (h.trans hV)
      ((relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h).op κ)
      ((relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h).op α)
      ((relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h).op ε) := by
  obtain ⟨hκ, hw, hw', hr⟩ := hd
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hκ, map_add, forms_map_smul, e.equationAt_res hV h]
  · rw [← e.equationAt_res hV h, ← exactWedge_res, hw]
    exact map_zero _
  · rw [← e.equationAt_res hV h, ← deRhamD_res, ← exactWedge_res, hw']
    exact map_zero _
  · rw [← deRhamD_res, formRes_map, hr]
    exact map_zero _

/-- Near every point of a chart, the value of `φ` at the basis element has a chart decomposition. -/
private theorem exists_isChartDecomp_logEval {p : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W) (hU : W' ≤ U)
    (x : X) (hx : x ∈ W') :
    ∃ (V : X.Opens) (hV : V ≤ W'), x ∈ V ∧ ∃ α ε, e.IsChartDecomp (hV.trans hU)
      (logEval f I φ (hV.trans hW') (e.basisLE (hV.trans hU))) α ε := by
  obtain ⟨V, hV, hxV, α, ε, hd⟩ := e.exists_isChartDecomp hU
    (logEval f I φ hW' (e.basisLE hU)) (formRestriction_logEval φ _ _) x hx
  rw [← e.logEval_basisLE_res φ hW' hU hV] at hd
  exact ⟨V, hV, hxV, α, ε, hd⟩

end Stacks.Divisors.IdealTrivialization

namespace AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData}

/-- **The value of the differential at a local section of the ideal sheaf exists**: there is a
form over `W'` satisfying the Leibniz relation on all of `W'` and vanishing on `Y`. -/
theorem exists_leibnizRel (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    ∃ s : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), W'),
      LeibnizRel φ hW' b W' le_rfl s ∧ formRes I.subschemeι ((p + 1 : ℕ) : ℤ) W' s = 0 := by
  obtain ⟨s, hs⟩ := TopCat.Sheaf.exists_of_local
    (N := (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).val)
    (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).isSheaf W'
    (fun V s => ∃ hV : V ≤ W', LeibnizRel φ hW' b V hV s ∧
      formRes I.subschemeι ((p + 1 : ℕ) : ℤ) V s = 0)
    (fun {V₁ V₂} h s _ ⟨hV, hrel, hres⟩ => ⟨h.trans hV, hrel.res h, by
      rw [PresheafOfModules.resLE_apply]
      exact (formRes_map h s).trans (by rw [hres]; exact map_zero _)⟩)
    (fun {V} s s' _ ⟨hV, hrel, _⟩ ⟨hV', hrel', _⟩ => LeibnizRel.unique hI hlog hrel hrel')
    (fun x hx => by
      obtain ⟨Ux, hxU, ⟨e⟩⟩ := Stacks.Divisors.IdealTrivialization.exists_mem_nonempty hI x
      have h0W : W' ⊓ Ux ≤ W' := inf_le_left
      have h0U : W' ⊓ Ux ≤ Ux := inf_le_right
      obtain ⟨V, hV, hxV, α, ε, hd⟩ :=
        e.exists_isChartDecomp_logEval φ (h0W.trans hW') h0U x ⟨hx, hxU⟩
      refine ⟨V, hV.trans h0W, hxV, e.coordLE (hV.trans h0U) (idealRes (hV.trans h0W) b) •
        (e.equationAt (hV.trans h0U) • deRhamD f p V α + deRhamD f p V ε),
        hV.trans h0W, ?_, ?_⟩
      · exact e.leibnizRel_coord_smul φ hW' b (hV.trans h0W) (hV.trans h0U) _ hd.solves
      · rw [formRes_smul, hd.formRes_next, smul_zero])
  refine ⟨s, LeibnizRel.of_local fun x hx => ?_, ?_⟩
  · obtain ⟨V, hV, hxV, hV', hrel, -⟩ := hs x hx
    exact ⟨V, hV, hxV, hrel⟩
  · refine TopCat.Presheaf.IsSheaf.section_ext
      (F := ((Scheme.Modules.pushforward I.subschemeι).obj
        (relativeDifferentialForms (I.subschemeι ≫ f) ((p + 1 : ℕ) : ℤ))).presheaf)
      (U := op W') (Scheme.Modules.isSheaf _) fun x hx => ?_
    obtain ⟨V, hV, hxV, hV', -, hres⟩ := hs x hx
    refine ⟨V, hV, hxV, ?_⟩
    rw [PresheafOfModules.resLE_apply] at hres
    exact (formRes_map hV s).symm.trans (hres.trans (map_zero _).symm)

variable (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) (hlog : f.HasLogPolesDeRhamComplex I)

/-- **The value of the differential** of a form `φ` with logarithmic poles at a local section `b`
of the ideal sheaf: the unique form satisfying the Leibniz relation. -/
def logDValue {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W)) {W' : X.Opens}
    (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), W') :=
  (exists_leibnizRel hI hlog φ hW' b).choose

/-- The value of the differential satisfies the Leibniz relation. -/
theorem leibnizRel_logDValue {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    LeibnizRel φ hW' b W' le_rfl (logDValue hI hlog φ hW' b) :=
  (exists_leibnizRel hI hlog φ hW' b).choose_spec.1

/-- The value of the differential vanishes on `Y`. -/
theorem formRes_logDValue {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    formRes I.subschemeι ((p + 1 : ℕ) : ℤ) W' (logDValue hI hlog φ hW' b) = 0 :=
  (exists_leibnizRel hI hlog φ hW' b).choose_spec.2

/-- The value of the differential is characterised by the Leibniz relation. -/
theorem logDValue_eq {p : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {W' : X.Opens} {hW' : W' ≤ W} {b : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {ψ : Γ(relativeDifferentialForms f ((p + 1 : ℕ) : ℤ), W')}
    (hψ : LeibnizRel φ hW' b W' le_rfl ψ) : logDValue hI hlog φ hW' b = ψ :=
  LeibnizRel.unique hI hlog (leibnizRel_logDValue hI hlog φ hW' b) hψ

/-- **The differential `dφ` of a form with logarithmic poles**, as a form with logarithmic
poles of one degree more. -/
def logD {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W)) :
    (logPolesForms f I (p + 1)).val.obj (op W) :=
  logPolesFormsMk (fun _ h b => logDValue hI hlog φ h b)
    (fun _ h b b' => (logDValue_eq hI hlog ((leibnizRel_logDValue hI hlog φ h b).add
      (leibnizRel_logDValue hI hlog φ h b'))))
    (fun _ h r b => logDValue_eq hI hlog ((leibnizRel_logDValue hI hlog φ h b).smul r))
    (fun _ _ h h' b => logDValue_eq hI hlog
      (LeibnizRel.idealRes h' ((leibnizRel_logDValue hI hlog φ h b).res h')))
    (fun _ h b => formRes_logDValue hI hlog φ h b)

/-- The value of `dφ` at a local section `b` of the ideal sheaf is `logDValue` at `b`. -/
theorem logEval_logD {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    logEval f I (logD hI hlog φ) hW' b = logDValue hI hlog φ hW' b :=
  rfl

/-- `dφ` is characterised by the Leibniz relation. -/
theorem logD_eq {p : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I (p + 1)).val.obj (op W))
    (hψ : ∀ (W' : X.Opens) (hW' : W' ≤ W) (b : (Stacks.Divisors.negativeTwist I).val.obj (op W')),
      LeibnizRel φ hW' b W' le_rfl (logEval f I ψ hW' b)) :
    logD hI hlog φ = ψ :=
  logEval_ext fun W' hW' b => logDValue_eq hI hlog (hψ W' hW' b)

/-- `d` is additive. -/
theorem logD_add {p : ℕ} {W : X.Opens} (φ φ' : (logPolesForms f I p).val.obj (op W)) :
    logD hI hlog (φ + φ') = logD hI hlog φ + logD hI hlog φ' :=
  logD_eq hI hlog _ _ fun W' hW' b => by
    rw [logEval_add]
    exact (leibnizRel_logDValue hI hlog φ hW' b).add_left (leibnizRel_logDValue hI hlog φ' hW' b)

/-- `d` commutes with restriction to smaller opens. -/
theorem logD_res {p : ℕ} {W W₁ : X.Opens} (h₁ : W₁ ≤ W) (φ : (logPolesForms f I p).val.obj (op W)) :
    logD hI hlog ((logPolesForms f I p).val.map (homOfLE h₁).op φ) =
      (logPolesForms f I (p + 1)).val.map (homOfLE h₁).op (logD hI hlog φ) :=
  logD_eq hI hlog _ _ fun W' hW' b => by
    rw [logEval_res]
    exact leibnizRel_logDValue hI hlog φ (hW'.trans h₁) b

end AlgebraicGeometry.Scheme.Hom


namespace Stacks.Divisors.IdealTrivialization

open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData} {U : X.Opens}
  (e : IdealTrivialization I U)

/-- **The differential on a chart.** If the value `κ` of `φ` at the basis element over `V` has
a chart decomposition `κ = t α + ε`, then `d(φ|_V) = t⁻¹ (t dα + dε)`. -/
theorem logD_map_eq_logOfCoord (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W)) {V : X.Opens} (hVW : V ≤ W) (hVU : V ≤ U)
    {α ε : Γ(relativeDifferentialForms f (p : ℤ), V)}
    (hd : e.IsChartDecomp hVU (logEval f I φ hVW (e.basisLE hVU)) α ε) :
    logD hI hlog ((logPolesForms f I p).val.map (homOfLE hVW).op φ) =
      e.logOfCoord hVU (e.equationAt hVU • deRhamD f p V α + deRhamD f p V ε) hd.formRes_next := by
  refine logD_eq hI hlog _ _ fun W' hW' b => ?_
  show LeibnizRel _ hW' b W' le_rfl (e.coordLE (hW'.trans hVU) b •
    (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE hW').op
      (e.equationAt hVU • deRhamD f p V α + deRhamD f p V ε))
  have hd' := IsChartDecomp.res e hd hW'
  rw [← e.logEval_basisLE_res φ hVW hVU hW'] at hd'
  have key := e.leibnizRel_coord_smul ((logPolesForms f I p).val.map (homOfLE hVW).op φ) hW' b
    le_rfl (hW'.trans hVU) _ hd'.solves
  rw [idealRes_refl] at key
  refine (congrArg _ ?_ : _).mpr key
  rw [map_add, forms_map_smul, e.equationAt_res hVU hW', deRhamD_res, deRhamD_res]

/-- The coordinate of the basis element is `1`. -/
theorem coordLE_basisLE {W : X.Opens} (h : W ≤ U) : e.coordLE h (e.basisLE h) = 1 :=
  e.θ_basisAt (homOfLE h)

/-- Restricting a form to the same open is the identity. -/
theorem forms_map_refl {n : ℤ} {W : X.Opens} (z : Γ(relativeDifferentialForms f n, W)) :
    (relativeDifferentialForms f n).presheaf.map (homOfLE (le_refl W)).op z = z := by
  rw [show homOfLE (le_refl W) = 𝟙 W from Subsingleton.elim _ _, op_id,
    CategoryTheory.Functor.map_id]
  rfl

/-- The value of `t⁻¹ z` at the basis element is `z`. -/
theorem logEval_logOfCoord_basisLE {p : ℕ} {W : X.Opens} (hW : W ≤ U)
    (z : Γ(relativeDifferentialForms f (p : ℤ), W))
    (hz : formRes I.subschemeι (p : ℤ) W z = 0) :
    logEval f I (e.logOfCoord hW z hz) (le_refl W) (e.basisLE hW) = z := by
  show e.coordLE ((le_refl W).trans hW) (e.basisLE hW) •
    (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE (le_refl W)).op z = z
  rw [coordLE_basisLE, forms_map_refl, one_smul]

/-- The form with logarithmic poles `t⁻¹ 0` is `0`. -/
theorem logOfCoord_zero {p : ℕ} {W : X.Opens} (hW : W ≤ U)
    (hz : formRes I.subschemeι (p : ℤ) W 0 = 0) :
    e.logOfCoord hW (0 : Γ(relativeDifferentialForms f (p : ℤ), W)) hz = 0 := by
  refine logEval_ext fun W' h a => ?_
  show e.coordLE (h.trans hW) a •
    (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h).op 0 = logEval f I 0 h a
  rw [map_zero, smul_zero, logEval_zero]

/-- `t⁻¹ z` depends only on the form `z`, not on the proof that it vanishes on `Y`. -/
theorem logOfCoord_congr {p : ℕ} {W : X.Opens} (hW : W ≤ U)
    {z z' : Γ(relativeDifferentialForms f (p : ℤ), W)} (hzz : z = z')
    (hz : formRes I.subschemeι (p : ℤ) W z = 0) (hz' : formRes I.subschemeι (p : ℤ) W z' = 0) :
    e.logOfCoord hW z hz = e.logOfCoord hW z' hz' := by
  subst hzz
  rfl

/-- **`d ∘ d = 0` on a chart.** -/
theorem logD_logD_map (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W)) {V : X.Opens} (hVW : V ≤ W) (hVU : V ≤ U)
    {α ε : Γ(relativeDifferentialForms f (p : ℤ), V)}
    (hd : e.IsChartDecomp hVU (logEval f I φ hVW (e.basisLE hVU)) α ε) :
    (logPolesForms f I (p + 1 + 1)).val.map (homOfLE hVW).op (logD hI hlog (logD hI hlog φ)) =
      0 := by
  set μ := e.equationAt hVU • deRhamD f p V α + deRhamD f p V ε with hμ
  have h1 : (logPolesForms f I (p + 1 + 1)).val.map (homOfLE hVW).op
      (logD hI hlog (logD hI hlog φ)) =
        logD hI hlog (logD hI hlog ((logPolesForms f I p).val.map (homOfLE hVW).op φ)) :=
    ((logD_res hI hlog hVW _).symm.trans (congrArg (logD hI hlog) (logD_res hI hlog hVW φ).symm))
  have h2 : logD hI hlog ((logPolesForms f I p).val.map (homOfLE hVW).op φ) =
      e.logOfCoord hVU μ hd.formRes_next :=
    e.logD_map_eq_logOfCoord hI hlog φ hVW hVU hd
  have hd₂ : e.IsChartDecomp hVU
      (logEval f I (e.logOfCoord hVU μ hd.formRes_next) (le_refl V) (e.basisLE hVU))
      (deRhamD f p V α) (deRhamD f p V ε) := by
    rw [logEval_logOfCoord_basisLE]
    exact IsChartDecomp.next e hd
  have hmap : (logPolesForms f I (p + 1)).val.map (homOfLE (le_refl V)).op
      (e.logOfCoord hVU μ hd.formRes_next) = e.logOfCoord hVU μ hd.formRes_next :=
    logEval_ext fun W' h a => logEval_res (le_refl V) _ h a
  have h3 : logD hI hlog (e.logOfCoord hVU μ hd.formRes_next) =
      e.logOfCoord hVU (e.equationAt hVU • deRhamD f (p + 1) V (deRhamD f p V α) +
        deRhamD f (p + 1) V (deRhamD f p V ε)) (IsChartDecomp.formRes_next e hd₂) :=
    (congrArg (logD hI hlog) hmap.symm).trans
      (e.logD_map_eq_logOfCoord hI hlog _ (le_refl V) hVU hd₂)
  have h0 : e.equationAt hVU • deRhamD f (p + 1) V (deRhamD f p V α) +
      deRhamD f (p + 1) V (deRhamD f p V ε) = 0 := by
    rw [deRhamD_deRhamD, deRhamD_deRhamD, smul_zero, add_zero]
  refine h1.trans ((congrArg (logD hI hlog) h2).trans (h3.trans ?_))
  exact (e.logOfCoord_congr hVU h0 _ (formRes_zero _ _ _)).trans (e.logOfCoord_zero hVU _)

end Stacks.Divisors.IdealTrivialization

namespace AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData}

/-- **`d ∘ d = 0`** for the differential of forms with logarithmic poles. -/
theorem logD_logD (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W)) :
    logD hI hlog (logD hI hlog φ) = 0 := by
  refine logEval_ext fun W' hW' b => ?_
  rw [logEval_zero]
  refine TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf _) fun x hx => ?_
  obtain ⟨Ux, hxU, ⟨e⟩⟩ := Stacks.Divisors.IdealTrivialization.exists_mem_nonempty hI x
  have h0W : W' ⊓ Ux ≤ W' := inf_le_left
  have h0U : W' ⊓ Ux ≤ Ux := inf_le_right
  obtain ⟨V, hV, hxV, α, ε, hd⟩ :=
    e.exists_isChartDecomp_logEval φ (h0W.trans hW') h0U x ⟨hx, hxU⟩
  refine ⟨V, hV.trans h0W, hxV, ?_⟩
  have hz := e.logD_logD_map hI hlog φ ((hV.trans h0W).trans hW') (hV.trans h0U) hd
  rw [map_logEval, map_zero]
  refine (logEval_res ((hV.trans h0W).trans hW') _ (le_refl V) _).symm.trans ?_
  rw [hz]
  exact logEval_zero _ _

/-- The form with logarithmic poles attached to a form `ω` with no pole is `a ↦ a ω`. -/
theorem logEval_logPolesFormsInclusion {p : ℕ} {W : X.Opens}
    (ω : Γ(relativeDifferentialForms f (p : ℤ), W)) {W' : X.Opens} (h : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    logEval f I ((logPolesFormsInclusion f I p).val.app (op W) ω) h a =
      idealFn a • (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE h).op ω := by
  refine (logEval_res h _ (le_refl W') a).symm.trans ?_
  rw [← PresheafOfModules.naturality_apply (logPolesFormsInclusion f I p).val (homOfLE h).op ω]
  exact logPolesFormsInclusion_app_apply f I p W' _ a

/-- **The inclusion of forms with no pole commutes with the differentials**:
`d(ι ω) = ι(dω)`. -/
theorem logD_logPolesFormsInclusion (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p : ℕ} {W : X.Opens}
    (ω : Γ(relativeDifferentialForms f (p : ℤ), W)) :
    logD hI hlog ((logPolesFormsInclusion f I p).val.app (op W) ω) =
      (logPolesFormsInclusion f I (p + 1)).val.app (op W) (deRhamD f p W ω) := by
  refine logD_eq hI hlog _ _ fun W' hW' b V' hV' a => ?_
  rw [logEval_logPolesFormsInclusion, forms_map_smul, forms_map_map, leibnizRHS,
    logEval_logPolesFormsInclusion, logEval_logPolesFormsInclusion, deRhamD_smul,
    exactWedge_smul_right, ← idealFn_res, deRhamD_res]
  module

end AlgebraicGeometry.Scheme.Hom

