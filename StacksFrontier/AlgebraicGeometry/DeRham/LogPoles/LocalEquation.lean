/-!
# Differentials along a local equation of a smooth quotient

Let `A → B → R` be a tower of commutative rings, let `R'` be a quotient of `R` as a `B`-algebra
and suppose the kernel of `R ⟶ R'` is generated by a single nonzerodivisor `t`.  Assume `R` and
`R'` are both formally smooth over `B` and that `R'` is flat over `B`.  Then:

* the map `R → Ω[R⁄A]`, `g ↦ g · dt`, is a split injection when `R` is local;
* multiplication by `t` is injective on `⋀ᵖ Ω[R⁄A]` for every `p`, when `Ω[R⁄B]` is free of finite
  rank.

## Main results

* `Stacks.LogPoles.isSMulRegular_tensorProduct`: multiplication by `t` is injective on `R ⊗_B Q`
  for every `B`-module `Q`.
* `Stacks.LogPoles.exists_linearMap_apply_D_relative_eq_one`: a functional on `Ω[R⁄B]` taking
  the value `1` on `dt`.
* `Stacks.LogPoles.exists_linearMap_apply_D_eq_one`: a functional on `Ω[R⁄A]` taking the value `1`
  on `dt`.
* `Stacks.LogPoles.nonempty_kaehlerDifferentialEquivBaseChange`: `Ω[R⁄A]` is the base change
  along `B → R` of the `B`-module `Ω[B⁄A] × (ι → B)`, for `ι` indexing a basis of `Ω[R⁄B]`.
* `Stacks.LogPoles.isSMulRegular_exteriorPower_kaehlerDifferential`: multiplication by `t` is
  injective on `⋀ᵖ Ω[R⁄A]`.

## References

* [Stacks Project, Tag 0FMY](https://stacks.math.columbia.edu/tag/0FMY)
* [Stacks Project, Tag 031K](https://stacks.math.columbia.edu/tag/031K)
* [Stacks Project, Tag 058M](https://stacks.math.columbia.edu/tag/058M)
* [Stacks Project, Tag 06A6](https://stacks.math.columbia.edu/tag/06A6)
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u

namespace Stacks.LogPoles

/-! ### Multiplication by the local equation on a base change -/

section Tensor

variable {B R R' : Type u} [CommRing B] [CommRing R] [CommRing R']
  [Algebra B R] [Algebra B R'] [Algebra R R'] [IsScalarTower B R R']

/-- Multiplication by `t` on `R ⊗_B Q` is the base change of multiplication by `t` on `R`. -/
theorem rTensor_mulLeft_apply (t : R) (Q : Type u) [AddCommGroup Q] [Module B Q]
    (z : R ⊗[B] Q) : (LinearMap.mulLeft B t).rTensor Q z = t • z := by
  induction z using TensorProduct.inductionOn with
  | tmul r q => simp [LinearMap.mulLeft_apply, TensorProduct.smul_tmul']
  | add x y hx hy => simp [hx, hy]

/-- If the kernel of `R ⟶ R'` is generated by the nonzerodivisor `t` and `R'` is flat over `B`,
then `t` acts injectively on `R ⊗_B Q` for every `B`-module `Q`. -/
@[ega "0 15.1.15" "special case"]
theorem isSMulRegular_tensorProduct [Module.Flat B R'] {t : R} (ht : t ∈ nonZeroDivisors R)
    (hsurj : Function.Surjective (algebraMap R R'))
    (hker : RingHom.ker (algebraMap R R') = Ideal.span {t})
    (Q : Type u) [AddCommGroup Q] [Module B Q] : IsSMulRegular (R ⊗[B] Q) t := by
  have hreg : ∀ a : R, a * t = 0 → a = 0 := (mem_nonZeroDivisors_iff.mp ht).2
  have key : Function.Injective ((LinearMap.mulLeft B t).rTensor Q) := by
    refine (Stacks.UniversalInjectivity.FlatCriterion.solution (R := B) (M := R')).mp
      inferInstance (LinearMap.mulLeft B t) (Algebra.linearMap R R') ?_ ?_ hsurj Q
    · intro a b hab
      have h0 : (a - b) * t = 0 := by
        simp only [sub_mul]
        simpa [LinearMap.mulLeft_apply, mul_comm] using sub_eq_zero.2 hab
      simpa using sub_eq_zero.1 (hreg _ h0)
    · intro x
      refine ⟨fun hx => ?_, ?_⟩
      · have hx' : x ∈ Ideal.span {t} := hker ▸ hx
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hx'
        exact ⟨c, by simp [LinearMap.mulLeft_apply, mul_comm]⟩
      · rintro ⟨c, rfl⟩
        have hmem : t * c ∈ RingHom.ker (algebraMap R R') :=
          hker ▸ Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self t)
        exact hmem
  exact fun x y hxy ↦ key (by simpa only [rTensor_mulLeft_apply] using hxy)

end Tensor

/-! ### A functional on the conormal module of a principal ideal -/

section Conormal

variable {R R' : Type u} [CommRing R] [CommRing R'] [Algebra R R']

/-- Multiplication by a nonzerodivisor `t` is injective on an ideal containing it. -/
private theorem toSpanSingleton_injective {t : R} (ht : t ∈ nonZeroDivisors R) {I : Ideal R}
    (htI : t ∈ I) : Function.Injective (LinearMap.toSpanSingleton R ↥I ⟨t, htI⟩) := by
  intro a b hab
  have h0 : (a - b) * t = 0 := by
    have hz : (a - b) • (⟨t, htI⟩ : ↥I) = 0 := by
      simp only [sub_smul]
      simpa only [LinearMap.toSpanSingleton_apply] using sub_eq_zero.2 hab
    simpa using congrArg Subtype.val hz
  simpa using sub_eq_zero.1 ((mem_nonZeroDivisors_iff.mp ht).2 _ h0)

/-- Multiplication by `t` is surjective onto the ideal generated by `t`. -/
private theorem toSpanSingleton_surjective {t : R} {I : Ideal R} (hI : I = Ideal.span {t})
    (htI : t ∈ I) : Function.Surjective (LinearMap.toSpanSingleton R ↥I ⟨t, htI⟩) := by
  intro x
  have hx : (x : R) ∈ Ideal.span {t} := hI ▸ x.2
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hx
  refine ⟨c, Subtype.ext ?_⟩
  simpa only [LinearMap.toSpanSingleton_apply, SetLike.val_smul, smul_eq_mul] using hc

/-- Multiplication by a nonzerodivisor `t` is an isomorphism from `R` onto the ideal it
generates. -/
private def equivSpanSingleton {t : R} (ht : t ∈ nonZeroDivisors R) {I : Ideal R}
    (hI : I = Ideal.span {t}) (htI : t ∈ I) : R ≃ₗ[R] ↥I :=
  LinearEquiv.ofBijective (LinearMap.toSpanSingleton R ↥I ⟨t, htI⟩)
    ⟨toSpanSingleton_injective ht htI, toSpanSingleton_surjective hI htI⟩

/-- `Stacks.LogPoles.equivSpanSingleton` is multiplication by `t`. -/
private theorem equivSpanSingleton_apply {t : R} (ht : t ∈ nonZeroDivisors R) {I : Ideal R}
    (hI : I = Ideal.span {t}) (htI : t ∈ I) (a : R) :
    (equivSpanSingleton ht hI htI a : R) = a * t := by
  change ((LinearMap.toSpanSingleton R ↥I ⟨t, htI⟩ a : ↥I) : R) = a * t
  simp only [LinearMap.toSpanSingleton_apply, SetLike.val_smul, smul_eq_mul]

/-- The functional on the conormal module `I/I²` of the kernel `I` of `R ⟶ R'` induced by the
inverse of the isomorphism `R ≃ I`, `a ↦ a t`, for a nonzerodivisor generator `t` of `I`,
followed by `R ⟶ R'`. -/
private def conormalFunctional {t : R} (ht : t ∈ nonZeroDivisors R)
    (hker : RingHom.ker (algebraMap R R') = Ideal.span {t})
    (htI : t ∈ RingHom.ker (algebraMap R R')) :
    (RingHom.ker (algebraMap R R')).Cotangent →ₗ[R] R' := by
  refine Submodule.liftQ _ (Algebra.linearMap R R' ∘ₗ
    (equivSpanSingleton ht hker htI).symm.toLinearMap) ?_
  refine Submodule.smul_le.2 fun r hr n _ => ?_
  have hnr : (equivSpanSingleton ht hker htI).symm (r • n) =
      r * (equivSpanSingleton ht hker htI).symm n := by
    rw [map_smul]; exact Algebra.smul_def _ _
  simp only [LinearMap.mem_ker, LinearMap.comp_apply, LinearEquiv.coe_coe, hnr,
    Algebra.linearMap_apply, map_mul, RingHom.mem_ker.1 hr, zero_mul]

/-- The functional of `Stacks.LogPoles.conormalFunctional` takes the value `1` on the class of
the generator `t`. -/
private theorem conormalFunctional_toCotangent {t : R} (ht : t ∈ nonZeroDivisors R)
    (hker : RingHom.ker (algebraMap R R') = Ideal.span {t})
    (htI : t ∈ RingHom.ker (algebraMap R R')) :
    conormalFunctional ht hker htI
        ((RingHom.ker (algebraMap R R')).toCotangent ⟨t, htI⟩) = 1 := by
  have hone : (equivSpanSingleton ht hker htI) 1 = ⟨t, htI⟩ :=
    Subtype.ext <| (equivSpanSingleton_apply ht hker htI 1).trans (one_mul t)
  have hsymm : (equivSpanSingleton ht hker htI).symm ⟨t, htI⟩ = 1 :=
    (LinearEquiv.symm_apply_eq _).2 hone.symm
  change Algebra.linearMap R R' ((equivSpanSingleton ht hker htI).symm ⟨t, htI⟩) = 1
  simp [hsymm]

end Conormal

/-! ### The split injection -/

section Tower

variable {A B R R' : Type u} [CommRing A] [CommRing B] [CommRing R] [CommRing R']
  [Algebra A B] [Algebra B R] [Algebra A R] [IsScalarTower A B R]
  [Algebra B R'] [Algebra R R'] [IsScalarTower B R R']

/-- If the kernel of `R ⟶ R'` is generated by a nonzerodivisor `t` and `R'` is formally smooth
over `B`, then there is an `R`-linear functional `Ω[R⁄B] → R'` taking the value `1` on `dt`. -/
theorem exists_linearMap_apply_D_relative_eq_one [Algebra.FormallySmooth B R']
    {t : R} (ht : t ∈ nonZeroDivisors R) (hsurj : Function.Surjective (algebraMap R R'))
    (hker : RingHom.ker (algebraMap R R') = Ideal.span {t}) :
    ∃ μ : Ω[R⁄B] →ₗ[R] R', μ (KaehlerDifferential.D B R t) = 1 := by
  obtain ⟨l, hl⟩ := KaehlerDifferential.exists_retraction_kerCotangentToTensor B R R' hsurj
  have htI : t ∈ RingHom.ker (algebraMap R R') := hker ▸ Ideal.mem_span_singleton_self t
  refine ⟨conormalFunctional ht hker htI ∘ₗ l ∘ₗ TensorProduct.mk R R' Ω[R⁄B] 1, ?_⟩
  have hmap : l (1 ⊗ₜ[R] KaehlerDifferential.D B R t) =
      (RingHom.ker (algebraMap R R')).toCotangent ⟨t, htI⟩ := by
    simpa only [LinearMap.comp_apply, LinearMap.id_coe, id_eq,
      KaehlerDifferential.kerCotangentToTensor_toCotangent] using
      LinearMap.congr_fun hl ((RingHom.ker (algebraMap R R')).toCotangent ⟨t, htI⟩)
  simpa only [LinearMap.comp_apply, TensorProduct.mk_apply, hmap] using
    conormalFunctional_toCotangent ht hker htI

/-- If `R` is local, the kernel of `R ⟶ R'` is generated by a nonzerodivisor `t`, and `R` and
`R'` are formally smooth over `B`, then the map `g ↦ g · dt` into `Ω[R⁄A]` is a split injection:
there is an `R`-linear functional on `Ω[R⁄A]` taking the value `1` on `dt`. -/
theorem exists_linearMap_apply_D_eq_one [IsLocalRing R] [Nontrivial R']
    [Algebra.FormallySmooth B R] [Algebra.FormallySmooth B R']
    {t : R} (ht : t ∈ nonZeroDivisors R) (hsurj : Function.Surjective (algebraMap R R'))
    (hker : RingHom.ker (algebraMap R R') = Ideal.span {t}) :
    ∃ r : Ω[R⁄A] →ₗ[R] R, r (KaehlerDifferential.D A R t) = 1 := by
  obtain ⟨μ, hμ⟩ := exists_linearMap_apply_D_relative_eq_one (B := B) (R' := R')
    ht hsurj hker
  obtain ⟨lift, hlift⟩ := Module.projective_lifting_property (Algebra.linearMap R R') μ hsurj
  have hval : algebraMap R R' (lift (KaehlerDifferential.D B R t)) = 1 := by
    simpa only [LinearMap.comp_apply, Algebra.linearMap_apply, hμ] using
      LinearMap.congr_fun hlift (KaehlerDifferential.D B R t)
  have hmax : Ideal.span {t} ≤ IsLocalRing.maximalIdeal R :=
    IsLocalRing.le_maximalIdeal (hker ▸ RingHom.ker_ne_top _)
  have hunit : IsUnit (lift (KaehlerDifferential.D B R t)) := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hmem
    have hsub : lift (KaehlerDifferential.D B R t) - 1 ∈ IsLocalRing.maximalIdeal R := by
      refine hmax (hker ▸ ?_)
      rw [RingHom.mem_ker, map_sub, hval, map_one, sub_self]
    have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
      simpa using (IsLocalRing.maximalIdeal R).sub_mem hmem hsub
    exact (IsLocalRing.maximalIdeal R).ne_top_iff_one.1
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top h1
  obtain ⟨u, hu⟩ := hunit
  refine ⟨(↑u⁻¹ : R) • (lift ∘ₗ KaehlerDifferential.map A B R R), ?_⟩
  have hD : KaehlerDifferential.map A B R R (KaehlerDifferential.D A R t) =
      KaehlerDifferential.D B R t := by
    simp [KaehlerDifferential.map_D A B R R t]
  simpa only [LinearMap.smul_apply, LinearMap.comp_apply, hD, smul_eq_mul, ← hu] using
    Units.inv_mul u

/-! ### `Ω[R⁄A]` as a base change -/

/-- If `R` is formally smooth over `B` and `Ω[R⁄B]` has a basis indexed by a finite `ι`, then
`Ω[R⁄A] ≃ R ⊗_B (Ω[B⁄A] × (ι → B))`. -/
theorem nonempty_kaehlerDifferentialEquivBaseChange [Algebra.FormallySmooth B R]
    {ι : Type u} [Finite ι] (b : Module.Basis ι R Ω[R⁄B]) :
    Nonempty (Ω[R⁄A] ≃ₗ[R] R ⊗[B] (Ω[B⁄A] × (ι → B))) := by
  classical
  have : Fintype ι := Fintype.ofFinite ι
  obtain ⟨r, hr⟩ := KaehlerDifferential.exists_retraction_mapBaseChange A B R
  have hexact := KaehlerDifferential.exact_mapBaseChange_map A B R
  have hsplit : Ω[R⁄A] ≃ₗ[R] (R ⊗[B] Ω[B⁄A]) × Ω[R⁄B] := by
    have hfst : ∀ z : Ω[R⁄A],
        ((LinearMap.prod r (KaehlerDifferential.map A B R R)) z).1 = r z := fun _ => rfl
    have hsnd : ∀ z : Ω[R⁄A], ((LinearMap.prod r (KaehlerDifferential.map A B R R)) z).2 =
        KaehlerDifferential.map A B R R z := fun _ => rfl
    refine LinearEquiv.ofBijective
      (LinearMap.prod r (KaehlerDifferential.map A B R R)) ⟨?_, ?_⟩
    · intro z w hzw
      have h1 : r (z - w) = 0 := by rw [map_sub, ← hfst z, ← hfst w, hzw, sub_self]
      have h2 : KaehlerDifferential.map A B R R (z - w) = 0 := by
        rw [map_sub, ← hsnd z, ← hsnd w, hzw, sub_self]
      obtain ⟨v, hv⟩ := (hexact _).1 h2
      have hv0 : v = 0 := by
        simpa only [LinearMap.comp_apply, LinearMap.id_coe, id_eq, hv, h1] using
          (LinearMap.congr_fun hr v).symm
      exact sub_eq_zero.1 (by rw [← hv, hv0, map_zero])
    · rintro ⟨a, c⟩
      obtain ⟨z, hz⟩ := KaehlerDifferential.map_surjective A B R c
      refine ⟨KaehlerDifferential.mapBaseChange A B R (a - r z) + z, Prod.ext_iff.2 ⟨?_, ?_⟩⟩
      · rw [hfst]
        have hra : r (KaehlerDifferential.mapBaseChange A B R (a - r z)) = a - r z := by
          simpa only [LinearMap.comp_apply, LinearMap.id_coe, id_eq] using
            LinearMap.congr_fun hr (a - r z)
        rw [map_add, hra, sub_add_cancel]
      · rw [hsnd]
        have hzero : KaehlerDifferential.map A B R R
            (KaehlerDifferential.mapBaseChange A B R (a - r z)) = 0 :=
          hexact.apply_apply_eq_zero _
        rw [map_add, hzero, zero_add, hz]
  exact ⟨hsplit.trans
    ((((LinearEquiv.refl R (R ⊗[B] Ω[B⁄A])).prodCongr b.equivFun)).trans
      ((TensorProduct.prodRight B R R Ω[B⁄A] (ι → B)).trans
        ((LinearEquiv.refl R _).prodCongr (TensorProduct.piScalarRight B R R ι))).symm)⟩

/-! ### Regularity on the exterior powers -/

/-- If the kernel of `R ⟶ R'` is generated by a nonzerodivisor `t`, `R'` is flat over `B`, `R` is
formally smooth over `B` and `Ω[R⁄B]` is free of finite rank, then multiplication by `t` is
injective on every exterior power of `Ω[R⁄A]`. -/
theorem isSMulRegular_exteriorPower_kaehlerDifferential [Module.Flat B R']
    [Algebra.FormallySmooth B R] [Module.Free R Ω[R⁄B]] [Module.Finite R Ω[R⁄B]]
    {t : R} (ht : t ∈ nonZeroDivisors R) (hsurj : Function.Surjective (algebraMap R R'))
    (hker : RingHom.ker (algebraMap R R') = Ideal.span {t}) (p : ℕ) :
    IsSMulRegular ↥(⋀[R]^p Ω[R⁄A]) t := by
  classical
  obtain ⟨e⟩ := nonempty_kaehlerDifferentialEquivBaseChange (A := A)
    (Module.Free.chooseBasis R Ω[R⁄B])
  refine IsSMulRegular.of_injective
    ((ExteriorAlgebra.exteriorPowerBaseChange B R
        (Ω[B⁄A] × (Module.Free.ChooseBasisIndex R Ω[R⁄B] → B)) p).symm.toLinearMap ∘ₗ
      exteriorPower.map p e.toLinearMap) ?_ ?_
  · exact (ExteriorAlgebra.exteriorPowerBaseChange B R _ p).symm.injective.comp
      (exteriorPower.map_injective e.symm.toLinearMap (LinearMap.ext e.symm_apply_apply))
  · exact isSMulRegular_tensorProduct (R' := R') ht hsurj hker
      ↥(⋀[B]^p (Ω[B⁄A] × (Module.Free.ChooseBasisIndex R Ω[R⁄B] → B)))

end Tower

end Stacks.LogPoles

end
