/-!
# Log poles along a divisor smooth over an intermediate base

Let `X ⟶ T ⟶ S` be morphisms of schemes and let `Y ⊆ X` be an effective Cartier divisor.  If
both `X ⟶ T` and `Y ⟶ T` are smooth, then the de Rham complex of log poles
`Ω^•_{X/S}(log Y)` is defined for `Y ⊆ X` over `S`:  at every point `y` of `Y` and for every
local equation `t` of `Y` there, the map `𝒪_{X,y} → Ω_{X/S,y}`, `g ↦ g · dt`, is a split
injection and `Ω^p_{X/S,y}` is `t`-torsion free for every `p`.

The two conditions are statements about the local ring `R = 𝒪_{X,y}` and the module of Kähler
differentials `Ω[R⁄A]` of the map to `A = 𝒪_{S}`, because differentials and exterior powers both
commute with taking stalks.  Written that way, with `B = 𝒪_{T}` and `R' = 𝒪_{Y,y}`, they are
`Stacks.LogPoles.exists_linearMap_apply_D_eq_one` and
`Stacks.LogPoles.isSMulRegular_exteriorPower_kaehlerDifferential`, whose hypotheses are that
`B → R` and `B → R'` are formally smooth, that `R'` is flat over `B`, that `Ω[R⁄B]` is free of
finite rank, and that the kernel of `R → R'` is generated by the nonzerodivisor `t`.  All of
these come from the two smoothness hypotheses and from `Y` being an effective Cartier divisor.

## Main results

* `AlgebraicGeometry.germ_mem_nonZeroDivisors_of_isEffectiveCartierDivisor`: a local equation of
  an effective Cartier divisor is a nonzerodivisor in the local ring of the ambient scheme.
* `AlgebraicGeometry.Scheme.Hom.hasLogPolesDeRhamComplex_of_smooth`: **Stacks tag 0FMY.**

## Implementation notes

The stalk of `Ω_{X/S}` at `y` is identified with `Ω[𝒪_{X,y}⁄𝒪_{S,y}]` by
`Stacks.RelativeDifferentialStalkMap.relativeDifferentialsStalkKaehlerEquiv`, which also pins
the germ of `dt` to `d` of the germ of `t`, and the stalk of `Ω^p_{X/S}` is identified with the
`p`-th exterior power of that by `SheafOfModules.exteriorPowerStalkEquiv`.  Only injectivity of
the second identification is used, so `exteriorPower.map_injective` suffices in place of a
functorial equivalence of exterior powers.

Freeness of `Ω[𝒪_{X,y}⁄𝒪_{T,y}]` over `𝒪_{X,y}` is the stalk of
`AlgebraicGeometry.Scheme.Hom.isFiniteLocallyFree_relativeDifferentials` for the smooth
`X ⟶ T`, transported along the same identification by
`Stacks.StalkFreeBridge.freeAndFinite_stalk_of_isFiniteLocallyFree`.  Formal smoothness of the
stalk maps is `AlgebraicGeometry.Scheme.Hom.smoothLocus_eq_top`, and flatness of `𝒪_{Y,y}` over
`𝒪_{T,y}` is `AlgebraicGeometry.Flat.stalkMap` for the smooth `Y ⟶ T`.

The `Algebra` instances on the four local rings are the stalk maps, named by
`Stacks.RelativeDifferentialStalkMap.algebraStalkMap`, with their types ascribed so that the
image points of a composite morphism are spelled the same way on both sides of a scalar tower;
the `Module` instances on the stalks of `Ω_{X/S}` and `Ω^p_{X/S}` have to be named for the same
reason, instance search not unfolding the sheaf of relative differentials.

## References

* [Stacks Project, Tag 0FMY](https://stacks.math.columbia.edu/tag/0FMY)
* [Stacks Project, Tag 0FMV](https://stacks.math.columbia.edu/tag/0FMV)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open Stacks.RelativeDifferentialStalkMap

universe u

namespace AlgebraicGeometry

/-- A functional taking the value `1` on a vector exhibits the map `g ↦ g · v` as a split
injection. -/
private theorem comp_toSpanSingleton_eq_id {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] (phi : M →ₗ[R] R) (v : M) (hv : phi v = 1) :
    phi ∘ₗ LinearMap.toSpanSingleton R M v = LinearMap.id :=
  LinearMap.ext fun a => by
    simp only [LinearMap.comp_apply, LinearMap.toSpanSingleton_apply, map_smul, hv,
      smul_eq_mul, mul_one, LinearMap.id_coe, id_eq]

/-- **A local equation of an effective Cartier divisor is a nonzerodivisor.** If the kernel of
`𝒪_{X,y} ⟶ 𝒪_{Y,y}` is generated by the germ of a section `t`, and `Y` is an effective Cartier
divisor, then that germ is a nonzerodivisor in `𝒪_{X,y}`.

By the forward direction of Stacks tag 01WS the divisor is cut out on an affine open
neighbourhood by a nonzerodivisor, whose germ generates the same stalk ideal and is again a
nonzerodivisor; a generator of a principal ideal with one nonzerodivisor generator is itself a
nonzerodivisor. -/
theorem germ_mem_nonZeroDivisors_of_isEffectiveCartierDivisor
    {X : Scheme.{u}} {I : X.IdealSheafData}
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) (y : I.subscheme)
    {U : X.Opens} (hy : I.subschemeι y ∈ U) (t : Γ(X, U))
    (ht : RingHom.ker (I.subschemeι.stalkMap y).hom =
      Ideal.span {(X.presheaf.germ U (I.subschemeι y) hy).hom t}) :
    (X.presheaf.germ U (I.subschemeι y) hy).hom t ∈
      nonZeroDivisors (X.presheaf.stalk (I.subschemeι y)) := by
  obtain ⟨V, hxV, f, hf, hgen⟩ :=
    Stacks.CartierAffineLocal.exists_affineOpen_nonZeroDivisor I hI (I.subschemeι y)
  have hW : IsAffineOpen (I.subschemeι ⁻¹ᵁ (V : X.Opens)) := V.2.preimage I.subschemeι
  have hsurj : Function.Surjective
      (I.subschemeι.appLE (V : X.Opens) (I.subschemeι ⁻¹ᵁ (V : X.Opens)) le_rfl).hom := by
    rw [Scheme.Hom.appLE_eq_app]
    exact Scheme.Hom.app_surjective _ (V : X.Opens) V.2
  have hVker : RingHom.ker (I.subschemeι.stalkMap y).hom =
      Ideal.span {(X.presheaf.germ (V : X.Opens) (I.subschemeι y) hxV).hom f} := by
    rw [Stacks.Flatness.ker_stalkMap_eq_map_germ I.subschemeι V.2 hW le_rfl hxV hxV hsurj,
      Scheme.Hom.appLE_eq_app, I.ker_subschemeι_app V, hgen, Ideal.map_span,
      Set.image_singleton]
  exact Stacks.Divisors.mem_nonZeroDivisors_of_span_singleton_eq (ht.symm.trans hVker)
    (Stacks.Divisors.germ_mem_nonZeroDivisors V.2
      (isRegular_iff_mem_nonZeroDivisors.mpr hf) _ hxV)

/-- The stalk maps of a smooth morphism are formally smooth. -/
private theorem formallySmooth_stalkMap_of_smooth {X Y : Scheme.{u}} (f : X ⟶ Y) [Smooth f]
    (x : X) : (f.stalkMap x).hom.FormallySmooth := by
  have hmem : x ∈ f.smoothLocus := by
    rw [f.smoothLocus_eq_top]
    trivial
  exact hmem

namespace Scheme.Hom

/-- **Stacks Project, Tag 0FMY.** Let `X ⟶ T ⟶ S` be morphisms of schemes and let `Y ⊆ X` be an
effective Cartier divisor, recorded by its ideal sheaf `I`.  If both `X ⟶ T` and `Y ⟶ T` are
smooth, then the de Rham complex of log poles is defined for `Y ⊆ X` over `S`. -/
@[stacks 0FMY]
theorem hasLogPolesDeRhamComplex_of_smooth {X T S : Scheme.{u}} (h : X ⟶ T) (g : T ⟶ S)
    (I : X.IdealSheafData) (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    [Smooth h] [Smooth (I.subschemeι ≫ h)] :
    (h ≫ g).HasLogPolesDeRhamComplex I := by
  classical
  intro y U hy t ht
  let : DecidableEq (OrderDual (TopologicalSpace.OpenNhds (I.subschemeι y))) :=
    Classical.decEq _
  let modD : Module (ToType (X.presheaf.stalk (I.subschemeι y)))
      (ToType ((Scheme.Hom.relativeDifferentials (h ≫ g)).presheaf.stalk (I.subschemeι y))) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) (Scheme.Hom.relativeDifferentials (h ≫ g)).val (I.subschemeι y)
  let algAB : Algebra (ToType (S.presheaf.stalk ((h ≫ g).base (I.subschemeι y))))
      (ToType (T.presheaf.stalk (h.base (I.subschemeι y)))) :=
    algebraStalkMap g (h.base (I.subschemeι y))
  let algBR : Algebra (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (X.presheaf.stalk (I.subschemeι y))) := algebraStalkMap h (I.subschemeι y)
  let algAR : Algebra (ToType (S.presheaf.stalk ((h ≫ g).base (I.subschemeι y))))
      (ToType (X.presheaf.stalk (I.subschemeι y))) := algebraStalkMap (h ≫ g) (I.subschemeι y)
  let algBR' : Algebra (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (I.subscheme.presheaf.stalk y)) := algebraStalkMap (I.subschemeι ≫ h) y
  let algRR' : Algebra (ToType (X.presheaf.stalk (I.subschemeι y)))
      (ToType (I.subscheme.presheaf.stalk y)) := (I.subschemeι.stalkMap y).hom.toAlgebra
  have towerABR : IsScalarTower (ToType (S.presheaf.stalk ((h ≫ g).base (I.subschemeι y))))
      (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (X.presheaf.stalk (I.subschemeι y))) :=
    IsScalarTower.of_algebraMap_eq fun a => by
      show ((h ≫ g).stalkMap (I.subschemeι y)).hom a =
        (h.stalkMap (I.subschemeι y)).hom ((g.stalkMap (h.base (I.subschemeι y))).hom a)
      rw [Scheme.Hom.stalkMap_comp]
      rfl
  have towerBRR' : IsScalarTower (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (X.presheaf.stalk (I.subschemeι y))) (ToType (I.subscheme.presheaf.stalk y)) :=
    IsScalarTower.of_algebraMap_eq fun a => by
      show ((I.subschemeι ≫ h).stalkMap y).hom a =
        (I.subschemeι.stalkMap y).hom ((h.stalkMap (I.subschemeι y)).hom a)
      rw [Scheme.Hom.stalkMap_comp]
      rfl
  have fsBR : Algebra.FormallySmooth (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (X.presheaf.stalk (I.subschemeι y))) :=
    formallySmooth_stalkMap_of_smooth h (I.subschemeι y)
  have fsBR' : Algebra.FormallySmooth (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (I.subscheme.presheaf.stalk y)) :=
    formallySmooth_stalkMap_of_smooth (I.subschemeι ≫ h) y
  have flatBR' : Module.Flat (ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (ToType (I.subscheme.presheaf.stalk y)) :=
    AlgebraicGeometry.Flat.stalkMap (I.subschemeι ≫ h) y
  have := Scheme.Hom.isFiniteLocallyFree_relativeDifferentials h
  obtain ⟨hfree, hfin⟩ := Stacks.StalkFreeBridge.freeAndFinite_stalk_of_isFiniteLocallyFree
    (Scheme.Hom.relativeDifferentials h) (I.subschemeι y)
  have EΩT : ToType (TopCat.Presheaf.stalk
        (Scheme.Hom.relativeDifferentials h).val.presheaf (I.subschemeι y))
      ≃ₗ[ToType (X.presheaf.stalk (I.subschemeι y))]
      Ω[ToType (X.presheaf.stalk (I.subschemeι y))⁄
        ToType (T.presheaf.stalk (h.base (I.subschemeι y)))] :=
    relativeDifferentialsStalkKaehlerEquiv h (I.subschemeι y)
  have freeBR : Module.Free (ToType (X.presheaf.stalk (I.subschemeι y)))
      Ω[ToType (X.presheaf.stalk (I.subschemeι y))⁄
        ToType (T.presheaf.stalk (h.base (I.subschemeι y)))] := Module.Free.of_equiv EΩT
  have finBR : Module.Finite (ToType (X.presheaf.stalk (I.subschemeι y)))
      Ω[ToType (X.presheaf.stalk (I.subschemeι y))⁄
        ToType (T.presheaf.stalk (h.base (I.subschemeι y)))] := Module.Finite.equiv EΩT
  have hsurj : Function.Surjective (algebraMap (ToType (X.presheaf.stalk (I.subschemeι y)))
      (ToType (I.subscheme.presheaf.stalk y))) := I.subschemeι.stalkMap_surjective y
  have htnzd := germ_mem_nonZeroDivisors_of_isEffectiveCartierDivisor hI y hy t ht
  have hgermd : (relativeDifferentialsStalkKaehlerEquiv (h ≫ g) (I.subschemeι y))
        ((Scheme.Hom.relativeDifferentials (h ≫ g)).presheaf.germ U (I.subschemeι y) hy
          ((Scheme.Hom.universalRelativeDerivation (h ≫ g)).d t)) =
      KaehlerDifferential.D _ _ ((X.presheaf.germ U (I.subschemeι y) hy).hom t) :=
    relativeDifferentialsStalkKaehlerEquiv_germ_d (h ≫ g) (I.subschemeι y)
      (OrderDual.toDual (⟨U, hy⟩ : TopologicalSpace.OpenNhds (I.subschemeι y))) t
  obtain ⟨r, hr⟩ := Stacks.LogPoles.exists_linearMap_apply_D_eq_one
    (A := ToType (S.presheaf.stalk ((h ≫ g).base (I.subschemeι y))))
    (B := ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
    (R' := ToType (I.subscheme.presheaf.stalk y)) htnzd hsurj ht
  have hv : r ((relativeDifferentialsStalkKaehlerEquiv (h ≫ g) (I.subschemeι y))
      ((Scheme.Hom.relativeDifferentials (h ≫ g)).presheaf.germ U (I.subschemeι y) hy
        ((Scheme.Hom.universalRelativeDerivation (h ≫ g)).d t))) = 1 :=
    (congrArg r hgermd).trans hr
  refine ⟨⟨r ∘ₗ (relativeDifferentialsStalkKaehlerEquiv (h ≫ g)
      (I.subschemeι y)).toLinearMap, comp_toSpanSingleton_eq_id _ _ hv⟩, ?_⟩
  intro p
  let modP : Module (ToType (X.presheaf.stalk (I.subschemeι y)))
      (ToType ((Scheme.Hom.relativeDifferentialForms (h ≫ g) (p : ℤ)).presheaf.stalk
        (I.subschemeι y))) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) (Scheme.Hom.relativeDifferentialForms (h ≫ g) (p : ℤ)).val
      (I.subschemeι y)
  let EXT := SheafOfModules.exteriorPowerStalkEquiv
    (Scheme.Modules.exteriorAlgebra (Scheme.Hom.relativeDifferentials (h ≫ g)))
    (Scheme.Modules.exteriorGenerator _)
    (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra _) p (I.subschemeι y)
  let F : ToType ((Scheme.Hom.relativeDifferentialForms (h ≫ g) (p : ℤ)).presheaf.stalk
        (I.subschemeι y)) →ₗ[ToType (X.presheaf.stalk (I.subschemeι y))]
      ↥(⋀[ToType (X.presheaf.stalk (I.subschemeι y))]^p
        Ω[ToType (X.presheaf.stalk (I.subschemeι y))⁄
          ToType (S.presheaf.stalk ((h ≫ g).base (I.subschemeι y)))]) :=
    exteriorPower.map p (relativeDifferentialsStalkKaehlerEquiv (h ≫ g)
      (I.subschemeι y)).toLinearMap ∘ₗ EXT.toLinearMap
  have hFinj : Function.Injective F := fun a b hab =>
    EXT.injective (exteriorPower.map_injective
      (relativeDifferentialsStalkKaehlerEquiv (h ≫ g) (I.subschemeι y)).symm.toLinearMap
      (LinearMap.ext fun z => (relativeDifferentialsStalkKaehlerEquiv (h ≫ g)
        (I.subschemeι y)).symm_apply_apply z) hab)
  exact IsSMulRegular.of_injective F hFinj
    (Stacks.LogPoles.isSMulRegular_exteriorPower_kaehlerDifferential
      (A := ToType (S.presheaf.stalk ((h ≫ g).base (I.subschemeι y))))
      (B := ToType (T.presheaf.stalk (h.base (I.subschemeι y))))
      (R' := ToType (I.subscheme.presheaf.stalk y)) htnzd hsurj ht p)

end Scheme.Hom

end AlgebraicGeometry

end
