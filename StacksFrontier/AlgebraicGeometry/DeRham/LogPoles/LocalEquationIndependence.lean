module

public import StacksFrontier.RingTheory.DeRham.PolynomialQuasiIso

/-!
# Independence of the logarithmic forms from the choice of local equation

Let `A → R` be a commutative algebra and let `t ∈ R` cut out a divisor. The de Rham complex of
log poles is built, over an open on which the ideal of the divisor is generated by `t`, from the
`𝒪`-submodule of `Ω^p(Y)` generated by `Ω^p` and `dlog(t) ∧ Ω^{p-1}`, where
`dlog(t) = t⁻¹ dt`. For that submodule to glue, it must not depend on which generator `t` of the
ideal is used, and the source checks this by the computation
`dlog(ut) - dlog(t) = dlog(u) = u⁻¹ du`, a section of `Ω^1` with no pole.

This file proves that independence without leaving `⋀^p Ω[R⁄A]`. Multiplying the submodule of
`Ω^p(Y)` through by `t` turns it into

`t · ⋀^{p+1} Ω[R⁄A] + dt ∧ ⋀^p Ω[R⁄A]`,

a submodule of the untwisted forms, and the assertion to prove becomes that this is unchanged
when `t` is replaced by `ut` for a unit `u`. No module of forms with a pole, and no localization,
is needed to state or to prove it.

## Main results

* `Stacks.LogPoles.wedgeLeft_D_unit_mul`: the Leibniz rule in the form
  `d(ut) ∧ η = u · (dt ∧ η) + t · (du ∧ η)`.
* `Stacks.LogPoles.range_wedgeLeft_D_sup_smul_top_eq_of_unit`: **the independence**, that
  `dt ∧ ⋀^p + t · ⋀^{p+1}` depends only on the ideal `(t)` and not on its generator.
* `Stacks.LogPoles.logSubmodule`: the same submodule written as a function of the ideal, with no
  generator chosen, so that it is defined whether or not the ideal is principal.
* `Stacks.LogPoles.logSubmodule_span_singleton`: that the two agree where a generator exists.

## Implementation notes

The statement is an equality of submodules of `⋀^{p+1} Ω[R⁄A]` rather than of `Ω^p(Y)`, which is
what makes it elementary: the twisted module and the inclusion `Ω^p ⊆ Ω^p(Y)` are supplied by
`Stacks.IdealTorsion.Eta.idealPowerTerm` and `idealPowerIncl` and are not needed here, and
multiplication by `t` is injective on the forms under the hypothesis of Tag 0FMV, so nothing is
lost in passing between the two descriptions.

The multiple of the whole module is written `Ideal.span {t} • ⊤` rather than as the range of
multiplication by `t`, so that the two sides of the independence are literally the same
submodule there — `Ideal.span {u * t} = Ideal.span {t}` for a unit `u` — and only the wedge
summand has to be compared.

One inclusion is proved and applied twice, the second time with `t` replaced by `ut` and `u` by
`u⁻¹`, which is why the auxiliary inclusion is stated for a general unit rather than specialised.

## References

* [Stacks Project, Tag 0FMW](https://stacks.math.columbia.edu/tag/0FMW), whose proof checks this
  independence in order to glue the local submodules
-/

@[expose] public noncomputable section

universe u

namespace Stacks.LogPoles

section Independence

variable {A R : Type u} [CommRing A] [CommRing R] [Algebra A R]

/-- Wedging with `d(a * t)` is wedging with `dt` scaled by `a`, plus `t` times wedging with `da`. -/
private theorem wedgeLeft_D_mul (t a : R) (p : ℕ) (η : ⋀[R]^p (Ω[R⁄A])) :
    exteriorPower.wedgeLeft (KaehlerDifferential.D A R (a * t)) p η =
      a • exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p η +
        t • exteriorPower.wedgeLeft (KaehlerDifferential.D A R a) p η := by
  rw [Derivation.leibniz, exteriorPower.wedgeLeft_add, LinearMap.add_apply,
    exteriorPower.wedgeLeft_smul, exteriorPower.wedgeLeft_smul, LinearMap.smul_apply,
    LinearMap.smul_apply]

/-- **The Leibniz rule, wedged.** For a unit `u` and an element `t`, wedging with `d(ut)` is
wedging with `dt` scaled by `u`, plus `t` times wedging with `du`. -/
theorem wedgeLeft_D_unit_mul (t : R) (u : Rˣ) (p : ℕ)
    (η : ⋀[R]^p (Ω[R⁄A])) :
    exteriorPower.wedgeLeft (KaehlerDifferential.D A R ((u : R) * t)) p η =
      (u : R) • exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p η +
        t • exteriorPower.wedgeLeft (KaehlerDifferential.D A R (u : R)) p η :=
  wedgeLeft_D_mul t u p η

/-- Wedging with `d(ut)` lands in the submodule generated by wedging with `dt` together with the
multiples of `t`. -/
theorem range_wedgeLeft_D_unit_mul_le (t : R) (u : Rˣ) (p : ℕ) :
    LinearMap.range
        (exteriorPower.wedgeLeft (KaehlerDifferential.D A R ((u : R) * t)) p) ≤
      LinearMap.range (exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p) ⊔
        (Ideal.span {t} • (⊤ : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])))) := by
  rintro x ⟨η, rfl⟩
  rw [wedgeLeft_D_unit_mul]
  exact Submodule.add_mem_sup ⟨(u : R) • η, by rw [map_smul]⟩
    (Submodule.smul_mem_smul (Ideal.mem_span_singleton_self t) Submodule.mem_top)

/-- **The logarithmic submodule does not depend on the choice of local equation.** Replacing the
generator `t` by `ut` for a unit `u` leaves `dt ∧ ⋀^p + t · ⋀^{p+1}` unchanged. This is the
computation `dlog(ut) - dlog(t) = u⁻¹ du`, cleared of denominators. -/
theorem range_wedgeLeft_D_sup_smul_top_eq_of_unit (t : R) (u : Rˣ) (p : ℕ) :
    LinearMap.range
        (exteriorPower.wedgeLeft (KaehlerDifferential.D A R ((u : R) * t)) p) ⊔
        (Ideal.span {t} • (⊤ : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])))) =
      LinearMap.range (exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p) ⊔
        (Ideal.span {t} • (⊤ : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])))) := by
  have hspan : Ideal.span {(u : R) * t} = Ideal.span {t} :=
    Ideal.span_singleton_mul_left_unit u.isUnit t
  have hback := range_wedgeLeft_D_unit_mul_le (A := A) ((u : R) * t) u⁻¹ p
  rw [hspan, show ((u⁻¹ : Rˣ) : R) * ((u : R) * t) = t by
    rw [← mul_assoc, Units.inv_mul, one_mul]] at hback
  exact le_antisymm (sup_le (range_wedgeLeft_D_unit_mul_le t u p) le_sup_right)
    (sup_le hback le_sup_right)

end Independence

section IdealForm

variable (A R : Type u) [CommRing A] [CommRing R] [Algebra A R]

/-- **The logarithmic submodule attached to an ideal.** It is spanned by `dt ∧ η` for every `t`
in the ideal, together with the ideal multiples of every form. No generator is chosen, so this
is defined for every ideal on every open, which is what a subsheaf can be glued from. -/
def logSubmodule (I : Ideal R) (p : ℕ) : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])) :=
  Submodule.span R
      {ω | ∃ t ∈ I, ∃ η : ⋀[R]^p (Ω[R⁄A]),
        exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p η = ω} ⊔
    I • (⊤ : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])))

variable {A R}

/-- **The generator description.** Where the ideal is principal the logarithmic submodule is the
one the source writes down, `dt ∧ ⋀^p + t · ⋀^{p+1}`. Together with the definition's manifest
dependence on the ideal alone, this is the independence of the choice of local equation. -/
theorem logSubmodule_span_singleton (t : R) (p : ℕ) :
    logSubmodule A R (Ideal.span {t}) p =
      LinearMap.range (exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p) ⊔
        (Ideal.span {t} • (⊤ : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])))) := by
  refine le_antisymm (sup_le (Submodule.span_le.mpr ?_) le_sup_right) (sup_le ?_ le_sup_right)
  · rintro ω ⟨s, hs, η, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hs
    rw [wedgeLeft_D_mul]
    exact Submodule.add_mem_sup ⟨a • η, by rw [map_smul]⟩
      (Submodule.smul_mem_smul (Ideal.mem_span_singleton_self t) Submodule.mem_top)
  · rintro x ⟨η, rfl⟩
    exact Submodule.mem_sup_left
      (Submodule.subset_span ⟨t, Ideal.mem_span_singleton_self t, η, rfl⟩)

/-- The logarithmic submodule of a principal ideal, written with the ideal rather than with a
chosen generator on the right. -/
theorem logSubmodule_eq_of_span_eq {I : Ideal R} {t : R} (hI : I = Ideal.span {t}) (p : ℕ) :
    logSubmodule A R I p =
      LinearMap.range (exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p) ⊔
        (I • (⊤ : Submodule R (⋀[R]^(p + 1) (Ω[R⁄A])))) := by
  subst hI
  exact logSubmodule_span_singleton t p

/-- The logarithmic submodule is monotone in the ideal. -/
theorem logSubmodule_mono {I J : Ideal R} (h : I ≤ J) (p : ℕ) :
    logSubmodule A R I p ≤ logSubmodule A R J p := by
  refine sup_le_sup (Submodule.span_mono ?_) (Submodule.smul_mono h le_rfl)
  rintro ω ⟨t, ht, η, rfl⟩
  exact ⟨t, h ht, η, rfl⟩

end IdealForm

end Stacks.LogPoles

end
