module

public import StacksFrontier.AlgebraicGeometry.DeRham.LogPoles.WedgeCalculus

/-!
# The wedge product of forms with logarithmic poles

Let `f : X ⟶ S` be a morphism of schemes and `Y ⊆ X` an effective Cartier divisor, cut out by `I`,
for which the de Rham complex of log poles is defined ([Stacks, Tag 0FMV]). A section of
`Ω^p_{X/S}(log Y) = SheafHom(ℐ, 𝒦^p)` (`AlgebraicGeometry.Scheme.Hom.logPolesForms`) is thought
of as a form `ω` with `φ(a) = a ω`. This file constructs the wedge product

`Ω^p_{X/S}(log Y) × Ω^q_{X/S}(log Y) → Ω^{p+q}_{X/S}(log Y)`

of [Stacks, Tag 0FUP] (1), equation-free, and proves that it is the unique `𝒪_X`-bilinear
extension of the wedge product of forms with no pole.

The value of `φ ∧ ψ` at a local section `a` of the ideal sheaf is characterised by the *wedge
relation* `b · (φ ∧ ψ)(a) = φ(a) ∧ ψ(b)` for all local sections `b` of `ℐ`
(`AlgebraicGeometry.Scheme.Hom.WedgeRel`): with `φ(a) = a ω` and `ψ(b) = b η` the solution is
`a (ω ∧ η)`.

* The relation has at most one solution, because locally `ℐ` is generated by a local equation `t`,
  which is a nonzerodivisor on the forms (`AlgebraicGeometry.Scheme.Hom.WedgeRel.unique`).
* It has solutions locally: on a chart with local equation `t`, writing `κ₁ = φ(b₀)` and
  `κ₂ = ψ(b₀)` for the values at the basis element, both vanish on `Y`, so locally
  `κᵢ = t αᵢ + dt ∧ βᵢ`, and `κ₁ ∧ κ₂` is divisible by `t` with a quotient again vanishing on `Y`
  (`Stacks.Divisors.IdealTrivialization.exists_local_formWedge_eq_smul`).

So the local solutions glue, exactly as for the differential of forms with logarithmic poles.

## Main definitions

* `AlgebraicGeometry.Scheme.Hom.logFormsWedge`: the wedge product of two forms with logarithmic
  poles over an open.
* `AlgebraicGeometry.Scheme.Hom.logFormsWedgeMap`: the wedge product as an `𝒪_X`-bilinear map of
  sheaves.

## Main results

* `AlgebraicGeometry.Scheme.Hom.logFormsWedge_logPolesFormsInclusion`: `ι ω ∧ ι η = ι (ω ∧ η)`.
* `AlgebraicGeometry.Scheme.Hom.idealFn_smul_eq_logPolesFormsInclusion`: `a · φ = ι(φ(a))`, a form
  with logarithmic poles times a local section of the ideal sheaf has no pole.
* `Stacks.Divisors.IdealTrivialization.logForms_eq_zero_of_equationAt_smul_eq_zero`: the local
  equation is a nonzerodivisor on the forms with logarithmic poles.
* `AlgebraicGeometry.Scheme.Hom.eq_logFormsWedgeMap`: **uniqueness**: every `𝒪_X`-bilinear
  extension of the wedge product of forms with no pole is `logFormsWedgeMap`; no Leibniz rule is
  needed.

## References

* [Stacks Project, Tag 0FUP](https://stacks.math.columbia.edu/tag/0FUP)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

attribute [local instance] AlgebraicGeometry.SheafOfModules.gradedFormsGOne
  AlgebraicGeometry.SheafOfModules.gradedFormsGMul AlgebraicGeometry.SheafOfModules.gradedFormsGRing

universe u

namespace Stacks.LogPoles

/-- `d b d g = 0` in a ring where `d² = 0` and `b d = ± d b`. -/
theorem mul_mul_eq_zero_of_mul_self_eq_zero {R : Type*} [Ring R] (d b g : R) (s : ℤ)
    (hb : b * d = s • (d * b)) (hd : d * d = 0) : d * b * (d * g) = 0 := by
  rw [mul_assoc, ← mul_assoc b, hb, smul_mul_assoc, mul_smul_comm, ← mul_assoc, ← mul_assoc, hd,
    zero_mul, zero_mul, smul_zero]

/-- Cancelling a twice repeated nonzerodivisor. -/
theorem eq_of_smul_smul_eq {R M : Type*} [Ring R] [AddCommGroup M] [Module R M] (t : R)
    (x y c : M) (hx : t • t • x = c) (hy : t • t • y = c) (h : ∀ z : M, t • z = 0 → z = 0) :
    x = y :=
  sub_eq_zero.mp (h _ (h _ (by rw [smul_sub, smul_sub, hx, hy, sub_self])))

end Stacks.LogPoles

namespace AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData}

/-- `AlgebraicGeometry.Scheme.Hom.logEval_smul_left`, for a scalar in the spelling of the scalars
of the sections of an `X.Modules`. -/
theorem logEval_smul_left' {p : ℕ} {W : X.Opens} (r : X.ringCatSheaf.obj.obj (op W))
    (φ : (logPolesForms f I p).val.obj (op W)) {W' : X.Opens} (h : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    logEval f I (r • φ) h a = X.presheaf.map (homOfLE h).op (r : Γ(X, W)) • logEval f I φ h a :=
  logEval_smul_left r φ h a

/-- Restricting a section of the structure sheaf along `V'' ≤ V' ≤ V` in two steps is restricting
it along `V'' ≤ V`. -/
theorem structurePresheaf_map_map_apply {V V' V'' : X.Opens} (h : V' ≤ V) (h' : V'' ≤ V')
    (r : Γ(X, V)) :
    X.presheaf.map (homOfLE h').op (X.presheaf.map (homOfLE h).op r) =
      X.presheaf.map (homOfLE (h'.trans h)).op r := by
  rw [← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

/-! ### The wedge relation -/

/-- The right-hand side `φ(a) ∧ ψ(b)` of the wedge relation, over an open `V' ≤ W'`, for a local
section `a` of the ideal sheaf over `W'` and `b` over `V'`. -/
def wedgeRHS {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) {V' : X.Opens} (hV' : V' ≤ W')
    (b : (Stacks.Divisors.negativeTwist I).val.obj (op V')) :
    Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V') :=
  formWedge f p q V' (logEval f I φ (hV'.trans hW') (idealRes hV' a))
    (logEval f I ψ (hV'.trans hW') b)

section wedgeRHS

variable {p q : ℕ} {W : X.Opens} (φ φ' : (logPolesForms f I p).val.obj (op W))
  (ψ ψ' : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
  (a a' : (Stacks.Divisors.negativeTwist I).val.obj (op W')) {V' : X.Opens} (hV' : V' ≤ W')
  (b : (Stacks.Divisors.negativeTwist I).val.obj (op V'))

/-- The restriction of `φ(a) ∧ ψ(b)` to `V'' ≤ V'` is `φ(a) ∧ ψ(b|_{V''})`. -/
theorem wedgeRHS_res {V'' : X.Opens} (h : V'' ≤ V') :
    (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map (homOfLE h).op
        (wedgeRHS φ ψ hW' a hV' b) =
      wedgeRHS φ ψ hW' a (h.trans hV') (idealRes h b) := by
  rw [wedgeRHS, wedgeRHS, formWedge_res, map_logEval, map_logEval, idealRes_idealRes]

/-- `φ(a + a') ∧ ψ(b) = φ(a) ∧ ψ(b) + φ(a') ∧ ψ(b)`. -/
theorem wedgeRHS_add : wedgeRHS φ ψ hW' (a + a') hV' b =
    wedgeRHS φ ψ hW' a hV' b + wedgeRHS φ ψ hW' a' hV' b := by
  rw [wedgeRHS, wedgeRHS, wedgeRHS, idealRes_add, logEval_add_right, formWedge_add_left]

/-- `φ(r a) ∧ ψ(b) = r · (φ(a) ∧ ψ(b))` for a section `r` of the structure sheaf. -/
theorem wedgeRHS_smul (r : Γ(X, W')) :
    wedgeRHS φ ψ hW' (toIdealScalar r • a) hV' b =
      X.presheaf.map (homOfLE hV').op r • wedgeRHS φ ψ hW' a hV' b := by
  rw [wedgeRHS, wedgeRHS, idealRes_smul, logEval_smul, formWedge_smul_left]

/-- `φ(a) ∧ ψ(b)` is unchanged when `a` is first restricted to an open `W''` with
`V' ≤ W'' ≤ W'`. -/
theorem wedgeRHS_idealRes {W'' : X.Opens} (h'' : W'' ≤ W') (hV'' : V' ≤ W'') :
    wedgeRHS φ ψ (h''.trans hW')
        (idealRes h'' a) hV'' b = wedgeRHS φ ψ hW' a (hV''.trans h'') b := by
  rw [wedgeRHS, wedgeRHS, idealRes_idealRes]

/-- `(φ + φ')(a) ∧ ψ(b) = φ(a) ∧ ψ(b) + φ'(a) ∧ ψ(b)`. -/
theorem wedgeRHS_add_left : wedgeRHS (φ + φ') ψ hW' a hV' b =
    wedgeRHS φ ψ hW' a hV' b + wedgeRHS φ' ψ hW' a hV' b := by
  rw [wedgeRHS, wedgeRHS, wedgeRHS, logEval_add, formWedge_add_left]

/-- `φ(a) ∧ (ψ + ψ')(b) = φ(a) ∧ ψ(b) + φ(a) ∧ ψ'(b)`. -/
theorem wedgeRHS_add_right : wedgeRHS φ (ψ + ψ') hW' a hV' b =
    wedgeRHS φ ψ hW' a hV' b + wedgeRHS φ ψ' hW' a hV' b := by
  rw [wedgeRHS, wedgeRHS, wedgeRHS, logEval_add, formWedge_add_right]

/-- `(r φ)(a) ∧ ψ(b) = r · (φ(a) ∧ ψ(b))` for a section `r` of the structure sheaf. -/
theorem wedgeRHS_smul_left (r : X.ringCatSheaf.obj.obj (op W)) :
    wedgeRHS (r • φ) ψ hW' a hV' b =
      X.presheaf.map (homOfLE (hV'.trans hW')).op (r : Γ(X, W)) • wedgeRHS φ ψ hW' a hV' b := by
  rw [wedgeRHS, wedgeRHS, logEval_smul_left', formWedge_smul_left]

/-- `φ(a) ∧ (r ψ)(b) = r · (φ(a) ∧ ψ(b))` for a section `r` of the structure sheaf. -/
theorem wedgeRHS_smul_right (r : X.ringCatSheaf.obj.obj (op W)) :
    wedgeRHS φ (r • ψ) hW' a hV' b =
      X.presheaf.map (homOfLE (hV'.trans hW')).op (r : Γ(X, W)) • wedgeRHS φ ψ hW' a hV' b := by
  rw [wedgeRHS, wedgeRHS, logEval_smul_left', formWedge_smul_right]

end wedgeRHS

/-- **The wedge relation** characterising the value `ζ` over `V ≤ W'` of the wedge product of two
forms `φ`, `ψ` with logarithmic poles at a local section `a` of the ideal sheaf over `W'`:
`b · ζ = φ(a) ∧ ψ(b)` over every open `V' ≤ V` and for every local section `b` of the ideal sheaf
there. Thinking of `φ(a) = a ω` and `ψ(b) = b η`, the solution is `ζ = a (ω ∧ η)`. -/
def WedgeRel {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) (V : X.Opens) (hV : V ≤ W')
    (ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)) : Prop :=
  ∀ (V' : X.Opens) (hV' : V' ≤ V) (b : (Stacks.Divisors.negativeTwist I).val.obj (op V')),
    idealFn b • (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map (homOfLE hV').op ζ =
      wedgeRHS φ ψ hW' a (hV'.trans hV) b

section WedgeRel

variable {p q : ℕ} {W : X.Opens} {φ φ' : (logPolesForms f I p).val.obj (op W)}
  {ψ ψ' : (logPolesForms f I q).val.obj (op W)} {W' : X.Opens} {hW' : W' ≤ W}
  {a a' : (Stacks.Divisors.negativeTwist I).val.obj (op W')}

/-- **The wedge relation has at most one solution.** -/
theorem WedgeRel.unique (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {V : X.Opens} {hV : V ≤ W'}
    {ζ ζ' : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hζ : WedgeRel φ ψ hW' a V hV ζ) (hζ' : WedgeRel φ ψ hW' a V hV ζ') : ζ = ζ' := by
  refine TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf _) fun x hx => ?_
  obtain ⟨Ux, hxU, ⟨e⟩⟩ := Stacks.Divisors.IdealTrivialization.exists_mem_nonempty hI x
  refine ⟨V ⊓ Ux, inf_le_left, ⟨hx, hxU⟩, ?_⟩
  have h1 := hζ (V ⊓ Ux) inf_le_left (e.basisLE inf_le_right)
  have h2 := hζ' (V ⊓ Ux) inf_le_left (e.basisLE inf_le_right)
  rw [← h2] at h1
  have h3 : e.equationAt (inf_le_right : V ⊓ Ux ≤ Ux) •
      ((relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map
          (homOfLE (inf_le_left : V ⊓ Ux ≤ V)).op ζ -
        (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map
          (homOfLE (inf_le_left : V ⊓ Ux ≤ V)).op ζ') = 0 := by
    rw [smul_sub]
    exact sub_eq_zero.mpr h1
  exact sub_eq_zero.mp (e.eq_zero_of_equationAt_smul_eq_zero hlog inf_le_right (p + q) _ h3)

/-- **The wedge relation is local.** -/
theorem WedgeRel.of_local {V : X.Opens} {hV : V ≤ W'}
    {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hloc : ∀ x ∈ V, ∃ (V₁ : X.Opens) (h₁ : V₁ ≤ V), x ∈ V₁ ∧
      WedgeRel φ ψ hW' a V₁ (h₁.trans hV)
        ((relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map (homOfLE h₁).op ζ)) :
    WedgeRel φ ψ hW' a V hV ζ := by
  intro V' hV' b
  refine TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf _) fun y hy => ?_
  obtain ⟨V₁, h₁, hy₁, hrel⟩ := hloc y (hV' hy)
  refine ⟨V' ⊓ V₁, inf_le_left, ⟨hy, hy₁⟩, ?_⟩
  have key := hrel (V' ⊓ V₁) inf_le_right (idealRes inf_le_left b)
  rw [forms_map_map] at key
  show (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map
      (homOfLE (inf_le_left : V' ⊓ V₁ ≤ V')).op
      (idealFn b • (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map
        (homOfLE hV').op ζ) =
    (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map
      (homOfLE (inf_le_left : V' ⊓ V₁ ≤ V')).op (wedgeRHS φ ψ hW' a (hV'.trans hV) b)
  rw [forms_map_smul, ← idealFn_res, forms_map_map, wedgeRHS_res]
  exact key

/-- The restriction of a solution of the wedge relation to a smaller open is a solution there. -/
theorem WedgeRel.res {V : X.Opens} {hV : V ≤ W'}
    {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)} (hζ : WedgeRel φ ψ hW' a V hV ζ)
    {V₂ : X.Opens} (h₂ : V₂ ≤ V) :
    WedgeRel φ ψ hW' a V₂ (h₂.trans hV)
      ((relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map (homOfLE h₂).op ζ) := by
  intro V' hV' b
  rw [forms_map_map]
  exact hζ V' (hV'.trans h₂) b

/-- Solutions of the wedge relation for additively related data add up. -/
private theorem WedgeRel.add_of_rhs {φ₁ φ₂ φ₃ : (logPolesForms f I p).val.obj (op W)}
    {ψ₁ ψ₂ ψ₃ : (logPolesForms f I q).val.obj (op W)}
    {a₁ a₂ a₃ : (Stacks.Divisors.negativeTwist I).val.obj (op W')} {V : X.Opens} {hV : V ≤ W'}
    {ζ ζ' : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hζ : WedgeRel φ₁ ψ₁ hW' a₁ V hV ζ) (hζ' : WedgeRel φ₂ ψ₂ hW' a₂ V hV ζ')
    (h : ∀ (V' : X.Opens) (hV' : V' ≤ V) (b : (Stacks.Divisors.negativeTwist I).val.obj (op V')),
      wedgeRHS φ₃ ψ₃ hW' a₃ (hV'.trans hV) b =
        wedgeRHS φ₁ ψ₁ hW' a₁ (hV'.trans hV) b + wedgeRHS φ₂ ψ₂ hW' a₂ (hV'.trans hV) b) :
    WedgeRel φ₃ ψ₃ hW' a₃ V hV (ζ + ζ') := by
  intro V' hV' b
  rw [map_add, smul_add, hζ V' hV' b, hζ' V' hV' b, h V' hV' b]

/-- If `ζ` solves the wedge relation at `a` and `ζ'` at `a'`, then `ζ + ζ'` solves it at
`a + a'`. -/
theorem WedgeRel.add {V : X.Opens} {hV : V ≤ W'}
    {ζ ζ' : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hζ : WedgeRel φ ψ hW' a V hV ζ) (hζ' : WedgeRel φ ψ hW' a' V hV ζ') :
    WedgeRel φ ψ hW' (a + a') V hV (ζ + ζ') :=
  hζ.add_of_rhs hζ' fun _ _ _ => wedgeRHS_add ..

/-- If `ζ` solves the wedge relation for `φ` and `ζ'` for `φ'`, then `ζ + ζ'` solves it for
`φ + φ'`. -/
theorem WedgeRel.add_left {V : X.Opens} {hV : V ≤ W'}
    {ζ ζ' : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hζ : WedgeRel φ ψ hW' a V hV ζ) (hζ' : WedgeRel φ' ψ hW' a V hV ζ') :
    WedgeRel (φ + φ') ψ hW' a V hV (ζ + ζ') :=
  hζ.add_of_rhs hζ' fun _ _ _ => wedgeRHS_add_left ..

/-- If `ζ` solves the wedge relation for `ψ` and `ζ'` for `ψ'`, then `ζ + ζ'` solves it for
`ψ + ψ'`. -/
theorem WedgeRel.add_right {V : X.Opens} {hV : V ≤ W'}
    {ζ ζ' : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hζ : WedgeRel φ ψ hW' a V hV ζ) (hζ' : WedgeRel φ ψ' hW' a V hV ζ') :
    WedgeRel φ (ψ + ψ') hW' a V hV (ζ + ζ') :=
  hζ.add_of_rhs hζ' fun _ _ _ => wedgeRHS_add_right ..

/-- If `ζ` solves the wedge relation at `a` on `W'`, then `r ζ` solves it at `r a`. -/
theorem WedgeRel.smul {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W')}
    (hζ : WedgeRel φ ψ hW' a W' le_rfl ζ) (r : Γ(X, W')) :
    WedgeRel φ ψ hW' (toIdealScalar r • a) W' le_rfl (r • ζ) := by
  intro V' hV' b
  rw [forms_map_smul, smul_comm, hζ V' hV' b, wedgeRHS_smul]

/-- Scaling a solution of the wedge relation on `W'` by `r|_{W'}` solves it for data whose
right-hand side is scaled by `r`. -/
private theorem WedgeRel.smul_of_rhs {φ' : (logPolesForms f I p).val.obj (op W)}
    {ψ' : (logPolesForms f I q).val.obj (op W)}
    {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W')}
    (hζ : WedgeRel φ ψ hW' a W' le_rfl ζ) (r : Γ(X, W))
    (h : ∀ (V' : X.Opens) (hV' : V' ≤ W')
      (b : (Stacks.Divisors.negativeTwist I).val.obj (op V')),
      wedgeRHS φ' ψ' hW' a hV' b =
        X.presheaf.map (homOfLE (hV'.trans hW')).op r • wedgeRHS φ ψ hW' a hV' b) :
    WedgeRel φ' ψ' hW' a W' le_rfl (X.presheaf.map (homOfLE hW').op r • ζ) := by
  intro V' hV' b
  rw [forms_map_smul, smul_comm, hζ V' hV' b, h V' hV' b]
  exact congrArg (· • _) (structurePresheaf_map_map_apply hW' hV' r)

/-- If `ζ` solves the wedge relation for `φ` on `W'`, then `r|_{W'} ζ` solves it for `r φ`. -/
theorem WedgeRel.smul_left {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W')}
    (hζ : WedgeRel φ ψ hW' a W' le_rfl ζ) (r : X.ringCatSheaf.obj.obj (op W)) :
    WedgeRel (r • φ) ψ hW' a W' le_rfl (X.presheaf.map (homOfLE hW').op (r : Γ(X, W)) • ζ) :=
  hζ.smul_of_rhs _ fun _ _ _ => wedgeRHS_smul_left ..

/-- If `ζ` solves the wedge relation for `ψ` on `W'`, then `r|_{W'} ζ` solves it for `r ψ`. -/
theorem WedgeRel.smul_right {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W')}
    (hζ : WedgeRel φ ψ hW' a W' le_rfl ζ) (r : X.ringCatSheaf.obj.obj (op W)) :
    WedgeRel φ (r • ψ) hW' a W' le_rfl (X.presheaf.map (homOfLE hW').op (r : Γ(X, W)) • ζ) :=
  hζ.smul_of_rhs _ fun _ _ _ => wedgeRHS_smul_right ..

/-- A solution of the wedge relation at `a` over `V ≤ W'' ≤ W'` is a solution at the restriction
of `a` to `W''`. -/
theorem WedgeRel.idealRes {W'' : X.Opens} (h'' : W'' ≤ W') {V : X.Opens} {hV : V ≤ W''}
    {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V)}
    (hζ : WedgeRel φ ψ hW' a V (hV.trans h'') ζ) :
    WedgeRel φ ψ (h''.trans hW') (idealRes h'' a) V hV ζ := by
  intro V' hV' b
  rw [wedgeRHS_idealRes]
  exact hζ V' hV' b

end WedgeRel

/-! ### The local solution -/

/-- `dc ∧ β ∧ dc ∧ γ = 0`. -/
theorem formWedge_exactWedge_exactWedge (p q : ℕ) (V : X.Opens) (c : Γ(X, V))
    (β : Γ(relativeDifferentialForms f (p : ℤ), V))
    (γ : Γ(relativeDifferentialForms f (q : ℤ), V)) :
    formWedge f (p + 1) (q + 1) V (exactWedge f p V c β) (exactWedge f q V c γ) = 0 := by
  refine totForm_injective (p + 1 + (q + 1)) V
    (((totForm_formWedge _ _ V _ _).trans ?_).trans (map_zero _).symm)
  rw [totForm_exactWedge, totForm_exactWedge]
  exact Stacks.LogPoles.mul_mul_eq_zero_of_mul_self_eq_zero
    (R := SheafOfModules.totalForms (SheafOfModules.differentialAlgebras
      (inverseImageStructureMap f)) (op V)) _ _ _ _
    (totForm_mul_totExact p V β c) (totExact_mul_self V c)

/-- The restriction of a form vanishing on `Y` still vanishes on `Y`. -/
theorem formRes_map_eq_zero {n : ℤ} {V V' : X.Opens} (h : V' ≤ V)
    {κ : Γ(relativeDifferentialForms f n, V)} (hκ : formRes I.subschemeι n V κ = 0) :
    formRes I.subschemeι n V' ((relativeDifferentialForms f n).presheaf.map (homOfLE h).op κ) =
      0 :=
  (formRes_map h κ).trans ((congrArg _ hκ).trans (map_zero _))

end AlgebraicGeometry.Scheme.Hom

namespace Stacks.Divisors.IdealTrivialization

open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData} {U : X.Opens}
  (e : IdealTrivialization I U)

/-- **The product of two forms vanishing on `Y` is divisible by the local equation**, near every
point, with a quotient again vanishing on `Y`: writing `κ₁ = t α₁ + dt ∧ β₁` and
`κ₂ = t α₂ + dt ∧ β₂`, the quotient is `κ₁ ∧ α₂ + α₁ ∧ dt ∧ β₂`. -/
theorem exists_local_formWedge_eq_smul {p q : ℕ} {W : X.Opens} (hW : W ≤ U)
    (κ₁ : Γ(relativeDifferentialForms f (p : ℤ), W))
    (κ₂ : Γ(relativeDifferentialForms f (q : ℤ), W))
    (h₁ : formRes I.subschemeι (p : ℤ) W κ₁ = 0) (h₂ : formRes I.subschemeι (q : ℤ) W κ₂ = 0)
    (x : X) (hx : x ∈ W) :
    ∃ (V : X.Opens) (hV : V ≤ W), x ∈ V ∧ ∃ ξ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V),
      e.equationAt (hV.trans hW) • ξ =
        formWedge f p q V ((relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE hV).op κ₁)
          ((relativeDifferentialForms f (q : ℤ)).presheaf.map (homOfLE hV).op κ₂) ∧
      formRes I.subschemeι ((p + q : ℕ) : ℤ) V ξ = 0 := by
  cases q with
  | zero =>
    obtain ⟨V, hV, hxV, α, hα⟩ := e.exists_local_eq_smul hW κ₂ h₂ x hx
    refine ⟨V, hV, hxV, formWedge f p 0 V
      ((relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE hV).op κ₁) α, ?_, ?_⟩
    · rw [← formWedge_smul_right]
      exact congrArg _ hα.symm
    · rw [formRes_formWedge, formRes_map_eq_zero hV h₁]
      exact formWedge_zero_left _ _ _ _
  | succ q =>
    cases p with
    | zero =>
      obtain ⟨V, hV, hxV, α, hα⟩ := e.exists_local_eq_smul hW κ₁ h₁ x hx
      refine ⟨V, hV, hxV, formWedge f 0 (q + 1) V α
        ((relativeDifferentialForms f ((q + 1 : ℕ) : ℤ)).presheaf.map (homOfLE hV).op κ₂), ?_, ?_⟩
      · rw [← formWedge_smul_left]
        exact congrArg (fun z => formWedge f 0 (q + 1) V z _) hα.symm
      · rw [formRes_formWedge, formRes_map_eq_zero hV h₂]
        exact formWedge_zero_right _ _ _ _
    | succ p =>
      obtain ⟨V₁, hV₁, hxV₁, α₁, β₁, hd₁⟩ := e.exists_local_eq_smul_add_exactWedge hW p κ₁ h₁ x hx
      obtain ⟨V, hV, hxV, α₂, β₂, hd₂⟩ := e.exists_local_eq_smul_add_exactWedge (hV₁.trans hW) q
        ((relativeDifferentialForms f ((q + 1 : ℕ) : ℤ)).presheaf.map (homOfLE hV₁).op κ₂)
        (formRes_map_eq_zero hV₁ h₂) x hxV₁
      rw [forms_map_map] at hd₂
      set t := e.equationAt ((hV.trans hV₁).trans hW) with ht
      set α₁' := (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE hV).op α₁
      set β₁' := (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE hV).op β₁
      have hd₁' : (relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
          (homOfLE (hV.trans hV₁)).op κ₁ = t • α₁' + exactWedge f p V t β₁' := by
        rw [← forms_map_map hV₁ hV, hd₁, map_add, forms_map_smul, exactWedge_res,
          e.equationAt_res (hV₁.trans hW) hV]
      refine ⟨V, hV.trans hV₁, hxV,
        formWedge f (p + 1) (q + 1) V ((relativeDifferentialForms f ((p + 1 : ℕ) : ℤ)).presheaf.map
          (homOfLE (hV.trans hV₁)).op κ₁) α₂ +
        formWedge f (p + 1) (q + 1) V α₁' (exactWedge f q V t β₂), ?_, ?_⟩
      · rw [hd₂, hd₁', smul_add, ← formWedge_smul_right, ← formWedge_smul_left,
          formWedge_add_right, formWedge_add_left, formWedge_add_left,
          formWedge_exactWedge_exactWedge, add_zero]
      · rw [formRes_add, formRes_formWedge, formRes_formWedge,
          formRes_map_eq_zero (hV.trans hV₁) h₁, formWedge_zero_left, zero_add]
        exact (congrArg _ (formRes_exactWedge_idealFn (e.basisLE
            ((hV.trans hV₁).trans hW)) β₂)).trans
          (formWedge_zero_right _ _ _ _)

/-- **The local solution of the wedge relation.** On a chart, write `κ₁ = φ(b₀)` and
`κ₂ = ψ(b₀)` for the values at the basis element. If `ξ` solves `t ξ = κ₁ ∧ κ₂`, then `θ(a) ξ`
satisfies the wedge relation for the value at `a`. -/
theorem wedgeRel_coord_smul {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) {V : X.Opens} (hV : V ≤ W')
    (hVU : V ≤ U) (ξ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), V))
    (hξ : e.equationAt hVU • ξ = formWedge f p q V
      (logEval f I φ (hV.trans hW') (e.basisLE hVU)) (logEval f I ψ (hV.trans hW')
          (e.basisLE hVU))) :
    WedgeRel φ ψ hW' a V hV (e.coordLE hVU (idealRes hV a) • ξ) := by
  intro V' hV' b
  rw [wedgeRHS]
  set κ₁ := logEval f I φ (hV.trans hW') (e.basisLE hVU)
  set κ₂ := logEval f I ψ (hV.trans hW') (e.basisLE hVU)
  set t := e.equationAt (hV'.trans hVU) with ht
  set κ₁' := (relativeDifferentialForms f (p : ℤ)).presheaf.map (homOfLE hV').op κ₁ with hκ₁'
  set κ₂' := (relativeDifferentialForms f (q : ℤ)).presheaf.map (homOfLE hV').op κ₂ with hκ₂'
  set ξ' := (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map (homOfLE hV').op ξ
    with hξ'
  set ca := e.coordLE (hV'.trans hVU) (idealRes (hV'.trans hV) a) with hca
  set cb := e.coordLE (hV'.trans hVU) b with hcb
  have hres : t • ξ' = formWedge f p q V' κ₁' κ₂' := by
    have h1 := congrArg ((relativeDifferentialForms f ((p + q : ℕ) : ℤ)).presheaf.map
      (homOfLE hV').op) hξ
    rw [forms_map_smul, formWedge_res, e.equationAt_res hVU hV'] at h1
    exact h1
  have hca' : X.presheaf.map (homOfLE hV').op (e.coordLE hVU (idealRes hV a)) = ca := by
    rw [hca, ← idealRes_idealRes hV hV', e.coordLE_res hVU hV']
  have hφa : logEval f I φ ((hV'.trans hV).trans hW') (idealRes (hV'.trans hV) a) = ca • κ₁' := by
    rw [e.logEval_eq_coord_smul φ _ (hV'.trans hVU), e.logEval_basisLE_res φ (hV.trans hW') hVU hV']
  have hψb : logEval f I ψ ((hV'.trans hV).trans hW') b = cb • κ₂' := by
    rw [e.logEval_eq_coord_smul ψ _ (hV'.trans hVU), e.logEval_basisLE_res ψ (hV.trans hW') hVU hV']
  rw [forms_map_smul, hca', hφa, hψb, e.idealFn_eq_mul (hV'.trans hVU) b, formWedge_smul_left,
    formWedge_smul_right, ← hres]
  module

end Stacks.Divisors.IdealTrivialization

namespace AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData}

/-- **The value of the wedge product at a local section of the ideal sheaf exists**: there is a
form over `W'` satisfying the wedge relation on all of `W'` and vanishing on `Y`. -/
theorem exists_wedgeRel (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p q : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W)) (ψ : (logPolesForms f I q).val.obj (op W))
    {W' : X.Opens} (hW' : W' ≤ W) (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    ∃ s : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W'),
      WedgeRel φ ψ hW' a W' le_rfl s ∧ formRes I.subschemeι ((p + q : ℕ) : ℤ) W' s = 0 := by
  obtain ⟨s, hs⟩ := TopCat.Sheaf.exists_of_local
    (N := (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).val)
    (relativeDifferentialForms f ((p + q : ℕ) : ℤ)).isSheaf W'
    (fun V s => ∃ hV : V ≤ W', WedgeRel φ ψ hW' a V hV s ∧
      formRes I.subschemeι ((p + q : ℕ) : ℤ) V s = 0)
    (fun {V₁ V₂} h s _ ⟨hV, hrel, hres⟩ => ⟨h.trans hV, hrel.res h, by
      rw [PresheafOfModules.resLE_apply]
      exact formRes_map_eq_zero h hres⟩)
    (fun {V} s s' _ ⟨hV, hrel, _⟩ ⟨hV', hrel', _⟩ => WedgeRel.unique hI hlog hrel hrel')
    (fun x hx => by
      obtain ⟨Ux, hxU, ⟨e⟩⟩ := Stacks.Divisors.IdealTrivialization.exists_mem_nonempty hI x
      have h0W : W' ⊓ Ux ≤ W' := inf_le_left
      have h0U : W' ⊓ Ux ≤ Ux := inf_le_right
      obtain ⟨V, hV, hxV, ξ, hξ, hres⟩ := e.exists_local_formWedge_eq_smul h0U
        (logEval f I φ (h0W.trans hW') (e.basisLE h0U))
        (logEval f I ψ (h0W.trans hW') (e.basisLE h0U))
        (formRestriction_logEval φ _ _) (formRestriction_logEval ψ _ _) x ⟨hx, hxU⟩
      rw [← e.logEval_basisLE_res φ (h0W.trans hW') h0U hV,
        ← e.logEval_basisLE_res ψ (h0W.trans hW') h0U hV] at hξ
      refine ⟨V, hV.trans h0W, hxV, e.coordLE (hV.trans h0U) (idealRes (hV.trans h0W) a) • ξ,
        hV.trans h0W, ?_, ?_⟩
      · exact e.wedgeRel_coord_smul φ ψ hW' a (hV.trans h0W) (hV.trans h0U) ξ hξ
      · rw [formRes_smul, hres, smul_zero])
  refine ⟨s, WedgeRel.of_local fun x hx => ?_, ?_⟩
  · obtain ⟨V, hV, hxV, hV', hrel, -⟩ := hs x hx
    exact ⟨V, hV, hxV, hrel⟩
  · refine TopCat.Presheaf.IsSheaf.section_ext
      (F := ((Scheme.Modules.pushforward I.subschemeι).obj
        (relativeDifferentialForms (I.subschemeι ≫ f) ((p + q : ℕ) : ℤ))).presheaf)
      (U := op W') (Scheme.Modules.isSheaf _) fun x hx => ?_
    obtain ⟨V, hV, hxV, hV', -, hres⟩ := hs x hx
    refine ⟨V, hV, hxV, ?_⟩
    rw [PresheafOfModules.resLE_apply] at hres
    exact (formRes_map hV s).symm.trans (hres.trans (map_zero _).symm)

variable (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) (hlog : f.HasLogPolesDeRhamComplex I)

/-- **The value of the wedge product** of `φ` and `ψ` at a local section `a` of the ideal sheaf:
the unique form satisfying the wedge relation. -/
def logWedgeValue {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W') :=
  (exists_wedgeRel hI hlog φ ψ hW' a).choose

/-- `logWedgeValue` satisfies the wedge relation on all of `W'`. -/
theorem wedgeRel_logWedgeValue {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    WedgeRel φ ψ hW' a W' le_rfl (logWedgeValue hI hlog φ ψ hW' a) :=
  (exists_wedgeRel hI hlog φ ψ hW' a).choose_spec.1

/-- `logWedgeValue` vanishes on `Y`. -/
theorem formRes_logWedgeValue {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    formRes I.subschemeι ((p + q : ℕ) : ℤ) W' (logWedgeValue hI hlog φ ψ hW' a) = 0 :=
  (exists_wedgeRel hI hlog φ ψ hW' a).choose_spec.2

/-- Every form satisfying the wedge relation on all of `W'` is `logWedgeValue`. -/
theorem logWedgeValue_eq {p q : ℕ} {W : X.Opens} {φ : (logPolesForms f I p).val.obj (op W)}
    {ψ : (logPolesForms f I q).val.obj (op W)} {W' : X.Opens} {hW' : W' ≤ W}
    {a : (Stacks.Divisors.negativeTwist I).val.obj (op W')}
    {ζ : Γ(relativeDifferentialForms f ((p + q : ℕ) : ℤ), W')}
    (hζ : WedgeRel φ ψ hW' a W' le_rfl ζ) : logWedgeValue hI hlog φ ψ hW' a = ζ :=
  WedgeRel.unique hI hlog (wedgeRel_logWedgeValue hI hlog φ ψ hW' a) hζ

/-- **The wedge product `φ ∧ ψ` of two forms with logarithmic poles**, of degree `p + q`. -/
def logFormsWedge {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) : (logPolesForms f I (p + q)).val.obj (op W) :=
  logPolesFormsMk (fun _ h a => logWedgeValue hI hlog φ ψ h a)
    (fun _ h a a' => logWedgeValue_eq hI hlog ((wedgeRel_logWedgeValue hI hlog φ ψ h a).add
      (wedgeRel_logWedgeValue hI hlog φ ψ h a')))
    (fun _ h r a => logWedgeValue_eq hI hlog ((wedgeRel_logWedgeValue hI hlog φ ψ h a).smul r))
    (fun _ _ h h' a => logWedgeValue_eq hI hlog
      (WedgeRel.idealRes h' ((wedgeRel_logWedgeValue hI hlog φ ψ h a).res h')))
    (fun _ h a => formRes_logWedgeValue hI hlog φ ψ h a)

/-- The value of `φ ∧ ψ` at a local section `a` of the ideal sheaf is `logWedgeValue`. -/
theorem logEval_logFormsWedge {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) {W' : X.Opens} (hW' : W' ≤ W)
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')) :
    logEval f I (logFormsWedge hI hlog φ ψ) hW' a = logWedgeValue hI hlog φ ψ hW' a :=
  rfl

/-- The wedge product is characterised by the wedge relation. -/
theorem logFormsWedge_eq {p q : ℕ} {W : X.Opens} (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) (χ : (logPolesForms f I (p + q)).val.obj (op W))
    (hχ : ∀ (W' : X.Opens) (hW' : W' ≤ W) (a : (Stacks.Divisors.negativeTwist I).val.obj (op W')),
      WedgeRel φ ψ hW' a W' le_rfl (logEval f I χ hW' a)) :
    logFormsWedge hI hlog φ ψ = χ :=
  logEval_ext fun W' hW' a => logWedgeValue_eq hI hlog (hχ W' hW' a)

section bilinear

variable {p q : ℕ} {W : X.Opens} (φ φ' : (logPolesForms f I p).val.obj (op W))
  (ψ ψ' : (logPolesForms f I q).val.obj (op W))

/-- `(φ + φ') ∧ ψ = φ ∧ ψ + φ' ∧ ψ`. -/
theorem logFormsWedge_add_left :
    logFormsWedge hI hlog (φ + φ') ψ = logFormsWedge hI hlog φ ψ + logFormsWedge hI hlog φ' ψ :=
  logFormsWedge_eq hI hlog _ _ _ fun W' hW' a => by
    rw [logEval_add]
    exact (wedgeRel_logWedgeValue hI hlog φ ψ hW' a).add_left
      (wedgeRel_logWedgeValue hI hlog φ' ψ hW' a)

/-- `φ ∧ (ψ + ψ') = φ ∧ ψ + φ ∧ ψ'`. -/
theorem logFormsWedge_add_right :
    logFormsWedge hI hlog φ (ψ + ψ') = logFormsWedge hI hlog φ ψ + logFormsWedge hI hlog φ ψ' :=
  logFormsWedge_eq hI hlog _ _ _ fun W' hW' a => by
    rw [logEval_add]
    exact (wedgeRel_logWedgeValue hI hlog φ ψ hW' a).add_right
      (wedgeRel_logWedgeValue hI hlog φ ψ' hW' a)

/-- `(r φ) ∧ ψ = r (φ ∧ ψ)` for a section `r` of the structure sheaf. -/
theorem logFormsWedge_smul_left (r : X.ringCatSheaf.obj.obj (op W)) :
    logFormsWedge hI hlog (r • φ) ψ = r • logFormsWedge hI hlog φ ψ :=
  logFormsWedge_eq hI hlog _ _ _ fun W' hW' a => by
    rw [logEval_smul_left']
    exact (wedgeRel_logWedgeValue hI hlog φ ψ hW' a).smul_left r

/-- `φ ∧ (r ψ) = r (φ ∧ ψ)` for a section `r` of the structure sheaf. -/
theorem logFormsWedge_smul_right (r : X.ringCatSheaf.obj.obj (op W)) :
    logFormsWedge hI hlog φ (r • ψ) = r • logFormsWedge hI hlog φ ψ :=
  logFormsWedge_eq hI hlog _ _ _ fun W' hW' a => by
    rw [logEval_smul_left']
    exact (wedgeRel_logWedgeValue hI hlog φ ψ hW' a).smul_right r

/-- The wedge product commutes with restriction to smaller opens. -/
theorem logFormsWedge_res {W₁ : X.Opens} (h₁ : W₁ ≤ W) :
    logFormsWedge hI hlog ((logPolesForms f I p).val.map (homOfLE h₁).op φ)
        ((logPolesForms f I q).val.map (homOfLE h₁).op ψ) =
      (logPolesForms f I (p + q)).val.map (homOfLE h₁).op (logFormsWedge hI hlog φ ψ) :=
  logFormsWedge_eq hI hlog _ _ _ fun W' hW' a => by
    rw [logEval_res]
    exact wedgeRel_logWedgeValue hI hlog φ ψ (hW'.trans h₁) a

end bilinear

/-- **The wedge product of forms with logarithmic poles**, as an `𝒪_X`-bilinear map of sheaves
`Ω^p_{X/S}(log Y) × Ω^q_{X/S}(log Y) → Ω^{p+q}_{X/S}(log Y)`. -/
def logFormsWedgeMap (p q : ℕ) :
    _root_.SheafOfModules.BilinearMap (logPolesForms f I p) (logPolesForms f I q)
      (logPolesForms f I (p + q)) where
  app U := AddMonoidHom.mk' (fun φ => AddMonoidHom.mk' (logFormsWedge hI hlog φ)
    (logFormsWedge_add_right hI hlog φ)) fun φ φ' => AddMonoidHom.ext fun ψ =>
      logFormsWedge_add_left hI hlog φ φ' ψ
  map_smul_left U r φ ψ := logFormsWedge_smul_left hI hlog (W := U.unop) φ ψ r
  map_smul_right U r φ ψ := logFormsWedge_smul_right hI hlog (W := U.unop) φ ψ r
  naturality {U V} g φ ψ := by
    rw [show g = (homOfLE (leOfHom g.unop)).op from rfl]
    exact (logFormsWedge_res hI hlog φ ψ (leOfHom g.unop)).symm

/-- The bilinear map `logFormsWedgeMap` sends `(φ, ψ)` over `W` to `φ ∧ ψ`. -/
theorem logFormsWedgeMap_app {p q : ℕ} (W : X.Opens) (φ : (logPolesForms f I p).val.obj (op W))
    (ψ : (logPolesForms f I q).val.obj (op W)) :
    (logFormsWedgeMap hI hlog p q).app (op W) φ ψ = logFormsWedge hI hlog φ ψ :=
  rfl

/-! ### Extension of the wedge product of forms with no pole -/

/-- **The wedge product of forms with logarithmic poles extends the wedge product of forms**:
`ι ω ∧ ι η = ι (ω ∧ η)`. -/
theorem logFormsWedge_logPolesFormsInclusion {p q : ℕ} {W : X.Opens}
    (ω : Γ(relativeDifferentialForms f (p : ℤ), W))
    (η : Γ(relativeDifferentialForms f (q : ℤ), W)) :
    logFormsWedge hI hlog ((logPolesFormsInclusion f I p).val.app (op W) ω)
        ((logPolesFormsInclusion f I q).val.app (op W) η) =
      (logPolesFormsInclusion f I (p + q)).val.app (op W) (formWedge f p q W ω η) := by
  refine logFormsWedge_eq hI hlog _ _ _ fun W' hW' a V' hV' b => ?_
  rw [wedgeRHS, logEval_logPolesFormsInclusion, logEval_logPolesFormsInclusion,
    logEval_logPolesFormsInclusion, forms_map_smul, forms_map_map, idealFn_res,
    formWedge_smul_left, formWedge_smul_right, formWedge_res]
  exact smul_comm _ _ _

/-! ### Uniqueness of the extension -/

/-- A local section of the ideal sheaf, as a scalar of the sections of an `X.Modules`. -/
abbrev idealFnR {V : X.Opens} (a : (Stacks.Divisors.negativeTwist I).val.obj (op V)) :
    X.ringCatSheaf.obj.obj (op V) :=
  idealFn a

/-- **A local section of the ideal sheaf times a form with logarithmic poles has no pole**:
`a · φ = ι(φ(a))`. -/
theorem idealFn_smul_eq_logPolesFormsInclusion {p : ℕ} {W : X.Opens}
    (φ : (logPolesForms f I p).val.obj (op W))
    (a : (Stacks.Divisors.negativeTwist I).val.obj (op W)) :
    idealFnR a • φ =
      (logPolesFormsInclusion f I p).val.app (op W) (logEval f I φ le_rfl a) := by
  refine logEval_ext fun W' h b => ?_
  rw [logEval_smul_left', logEval_logPolesFormsInclusion, map_logEval, ← idealFn_res]
  exact idealFn_smul_logEval_comm φ h (idealRes h a) b

end AlgebraicGeometry.Scheme.Hom

namespace Stacks.Divisors.IdealTrivialization

open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData} {U : X.Opens}
  (e : IdealTrivialization I U)

/-- **The local equation is a nonzerodivisor on the forms with logarithmic poles.** -/
theorem logForms_eq_zero_of_equationAt_smul_eq_zero (hlog : f.HasLogPolesDeRhamComplex I)
    {V : X.Opens} (hV : V ≤ U) {p : ℕ} (χ : (logPolesForms f I p).val.obj (op V))
    (hχ : e.equationAtR hV • χ = 0) : χ = 0 := by
  refine logEval_ext fun W' h a => ?_
  have h1 : logEval f I (e.equationAtR hV • χ) h a = logEval f I 0 h a :=
    congrArg (fun z => logEval f I z h a) hχ
  rw [logEval_smul_left', logEval_zero, e.equationAt_res hV h] at h1
  rw [logEval_zero]
  exact e.eq_zero_of_equationAt_smul_eq_zero hlog (h.trans hV) p _ h1

/-- The local equation times a form with logarithmic poles has no pole: `t · φ = ι(φ(b₀))`. -/
theorem equationAt_smul_eq_logPolesFormsInclusion {V : X.Opens} (hV : V ≤ U) {p : ℕ}
    (φ : (logPolesForms f I p).val.obj (op V)) :
    e.equationAtR hV • φ =
      (logPolesFormsInclusion f I p).val.app (op V) (logEval f I φ le_rfl (e.basisLE hV)) :=
  idealFn_smul_eq_logPolesFormsInclusion φ (e.basisLE hV)

/-- On a chart, an extension `m` of the wedge product of forms with no pole is pinned down after
multiplying by `t²`: `t² m(φ, ψ) = ι(φ(b₀) ∧ ψ(b₀))`. -/
theorem bilinearMap_smul_smul_eq {p q : ℕ}
    (m : _root_.SheafOfModules.BilinearMap (logPolesForms f I p) (logPolesForms f I q)
      (logPolesForms f I (p + q)))
    (hm : ∀ (W : X.Opens) (ω : Γ(relativeDifferentialForms f (p : ℤ), W))
      (η : Γ(relativeDifferentialForms f (q : ℤ), W)),
      m.app (op W) ((logPolesFormsInclusion f I p).val.app (op W) ω)
          ((logPolesFormsInclusion f I q).val.app (op W) η) =
        (logPolesFormsInclusion f I (p + q)).val.app (op W) (formWedge f p q W ω η))
    {V : X.Opens} (hV : V ≤ U) (φ : (logPolesForms f I p).val.obj (op V))
    (ψ : (logPolesForms f I q).val.obj (op V)) :
    e.equationAtR hV • e.equationAtR hV • m.app (op V) φ ψ =
      (logPolesFormsInclusion f I (p + q)).val.app (op V)
        (formWedge f p q V (logEval f I φ le_rfl (e.basisLE hV))
          (logEval f I ψ le_rfl (e.basisLE hV))) := by
  refine Eq.trans ?_ ((congrArg₂ (fun x y => m.app (op V) x y)
    (e.equationAt_smul_eq_logPolesFormsInclusion hV φ)
    (e.equationAt_smul_eq_logPolesFormsInclusion hV ψ)).trans (hm V _ _))
  rw [m.map_smul_left, m.map_smul_right]

end Stacks.Divisors.IdealTrivialization

namespace AlgebraicGeometry.Scheme.Hom

variable {X S : Scheme.{u}} {f : X ⟶ S} {I : X.IdealSheafData}

/-- A form with logarithmic poles is determined by its restrictions to the opens of a cover. -/
theorem logPolesForms_ext_of_local {p : ℕ} {W : X.Opens}
    {χ χ' : (logPolesForms f I p).val.obj (op W)}
    (h : ∀ x ∈ W, ∃ (V : X.Opens) (hV : V ≤ W), x ∈ V ∧
      (logPolesForms f I p).val.map (homOfLE hV).op χ =
        (logPolesForms f I p).val.map (homOfLE hV).op χ') : χ = χ' := by
  refine logEval_ext fun W' hW' a => ?_
  refine TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf _) fun x hx => ?_
  obtain ⟨V, hV, hxV, hχ⟩ := h x (hW' hx)
  refine ⟨W' ⊓ V, inf_le_left, ⟨hx, hxV⟩, ?_⟩
  have e1 := logEval_res hV χ (inf_le_right : W' ⊓ V ≤ V) (idealRes inf_le_left a)
  have e2 := logEval_res hV χ' (inf_le_right : W' ⊓ V ≤ V) (idealRes inf_le_left a)
  rw [hχ] at e1
  rw [map_logEval, map_logEval]
  exact e1.symm.trans e2

/-- **Uniqueness of the extension.** Two `𝒪_X`-bilinear maps
`Ω^p_{X/S}(log Y) × Ω^q_{X/S}(log Y) → Ω^{p+q}_{X/S}(log Y)` which both extend the wedge product
of forms with no pole are equal. No Leibniz rule is needed: locally `t` times a form with
logarithmic poles has no pole, and `t` is a nonzerodivisor on the forms with logarithmic poles. -/
theorem bilinearMap_ext_of_logPolesFormsInclusion (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p q : ℕ}
    (m m' : _root_.SheafOfModules.BilinearMap (logPolesForms f I p) (logPolesForms f I q)
      (logPolesForms f I (p + q)))
    (hm : ∀ (W : X.Opens) (ω : Γ(relativeDifferentialForms f (p : ℤ), W))
      (η : Γ(relativeDifferentialForms f (q : ℤ), W)),
      m.app (op W) ((logPolesFormsInclusion f I p).val.app (op W) ω)
          ((logPolesFormsInclusion f I q).val.app (op W) η) =
        (logPolesFormsInclusion f I (p + q)).val.app (op W) (formWedge f p q W ω η))
    (hm' : ∀ (W : X.Opens) (ω : Γ(relativeDifferentialForms f (p : ℤ), W))
      (η : Γ(relativeDifferentialForms f (q : ℤ), W)),
      m'.app (op W) ((logPolesFormsInclusion f I p).val.app (op W) ω)
          ((logPolesFormsInclusion f I q).val.app (op W) η) =
        (logPolesFormsInclusion f I (p + q)).val.app (op W) (formWedge f p q W ω η)) :
    m = m' := by
  refine Stacks.BilinearMap.ext fun U φ ψ => ?_
  induction U using Opposite.rec with | op W => ?_
  refine logPolesForms_ext_of_local fun x hx => ?_
  obtain ⟨Ux, hxU, ⟨e⟩⟩ := Stacks.Divisors.IdealTrivialization.exists_mem_nonempty hI x
  refine ⟨W ⊓ Ux, inf_le_left, ⟨hx, hxU⟩, ?_⟩
  have hn := m.naturality (homOfLE (inf_le_left : W ⊓ Ux ≤ W)).op φ ψ
  have hn' := m'.naturality (homOfLE (inf_le_left : W ⊓ Ux ≤ W)).op φ ψ
  have e1 := e.bilinearMap_smul_smul_eq m hm (inf_le_right : W ⊓ Ux ≤ Ux)
    ((logPolesForms f I p).val.map (homOfLE (inf_le_left : W ⊓ Ux ≤ W)).op φ)
    ((logPolesForms f I q).val.map (homOfLE (inf_le_left : W ⊓ Ux ≤ W)).op ψ)
  have e2 := e.bilinearMap_smul_smul_eq m' hm' (inf_le_right : W ⊓ Ux ≤ Ux)
    ((logPolesForms f I p).val.map (homOfLE (inf_le_left : W ⊓ Ux ≤ W)).op φ)
    ((logPolesForms f I q).val.map (homOfLE (inf_le_left : W ⊓ Ux ≤ W)).op ψ)
  have h3 := Stacks.LogPoles.eq_of_smul_smul_eq _ _ _ _ e1 e2
    fun z hz => e.logForms_eq_zero_of_equationAt_smul_eq_zero hlog inf_le_right z hz
  exact hn.trans (h3.trans hn'.symm)

/-- **Stacks Project, Tag 0FUP, clause (1), uniqueness:** the wedge product
`AlgebraicGeometry.Scheme.Hom.logFormsWedgeMap` is the only `𝒪_X`-bilinear extension of the wedge
product of forms with no pole. -/
theorem eq_logFormsWedgeMap (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (hlog : f.HasLogPolesDeRhamComplex I) {p q : ℕ}
    (m : _root_.SheafOfModules.BilinearMap (logPolesForms f I p) (logPolesForms f I q)
      (logPolesForms f I (p + q)))
    (hm : ∀ (W : X.Opens) (ω : Γ(relativeDifferentialForms f (p : ℤ), W))
      (η : Γ(relativeDifferentialForms f (q : ℤ), W)),
      m.app (op W) ((logPolesFormsInclusion f I p).val.app (op W) ω)
          ((logPolesFormsInclusion f I q).val.app (op W) η) =
        (logPolesFormsInclusion f I (p + q)).val.app (op W) (formWedge f p q W ω η)) :
    m = logFormsWedgeMap hI hlog p q :=
  bilinearMap_ext_of_logPolesFormsInclusion hI hlog m _ hm
    fun _ ω η => logFormsWedge_logPolesFormsInclusion hI hlog ω η

end AlgebraicGeometry.Scheme.Hom


end
