/-!
# The graded differential forms of the total space of a line bundle

Let `f : X ⟶ S` be a morphism of schemes, `L` an invertible `𝒪_X`-module and `π : 𝕃 ⟶ X` the
total space of `L`, the relative spectrum of `Sym(L) = ⨁_{k ≥ 0} Symᵏ(L)`. The grading of
`π_*𝒪_𝕃 = Sym(L)` grades the pushed-forward relative differential forms,

`π_* Ω^p_{𝕃/S} = ⨁_{n ≥ 0} Ω^p_{𝕃/S, n}`,

where, following Remark 0FU9 of the source, `Ω^p_{𝕃/S, n}` is generated by the forms
`a₀ d a₁ ∧ ⋯ ∧ d aₚ` with each `aᵢ` homogeneous and the degrees summing to `n`.

## Main definitions

* `Stacks.LineBundle.Situation.totalFormsPushforward`: the `𝒪_X`-module `π_* Ω^p_{𝕃/S}`.
* `Stacks.LineBundle.Situation.totalFunction`: the homogeneous function of degree `k` on `π⁻¹W`
  attached to a local section of `Symᵏ(L)` over an open `W` of `X`.
* `Stacks.LineBundle.Situation.IsHomogeneousTotalForm`: the homogeneous generators
  `a₀ d a₁ ∧ ⋯ ∧ d aₚ` of total degree `n`.
* `Stacks.LineBundle.Situation.gradedTotalForms`: **the degree-`n` part `Ω^p_{𝕃/S, n}`**, the
  sub-`𝒪_X`-module sheaf of `π_* Ω^p_{𝕃/S}` generated by the homogeneous forms of degree `n`.
* `Stacks.LineBundle.Situation.formsPullback`: the pullback of forms `Ω^p_{X/S} ⟶ π_*Ω^p_{𝕃/S}`.

## Main results

* `Stacks.LineBundle.Situation.totalFunction_map`, `IsHomogeneousTotalForm.map`: homogeneous
  functions and forms restrict to homogeneous functions and forms.
* `Stacks.LineBundle.Situation.gradedTotalForms_le_iff`: `Ω^p_{𝕃/S, n}` is the smallest
  submodule sheaf containing the homogeneous forms of degree `n`.
* `Stacks.LineBundle.Situation.formsPullback_mem_gradedTotalForms_zero`: the forms pulled back
  from `X` have degree zero.

## Implementation notes

The homogeneous functions are defined over an *arbitrary* open of `X`, through the universal
algebra map `Sym(L) ⟶ π_*𝒪_𝕃` of Tag 01LX, so that they commute with restriction on the nose.
The degree-`n` part is `Stacks.SheafOfModules.localSpan` of the homogeneous forms: its sections
are the forms which locally are `𝒪_X`-combinations of homogeneous forms, which is the subsheaf
generated by them.

## References

* [Stacks Project, Tag 0FU9](https://stacks.math.columbia.edu/tag/0FU9)
* [Stacks Project, Tag 0FUH](https://stacks.math.columbia.edu/tag/0FUH)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace AlgebraicGeometry Opposite

universe u

namespace Stacks.AlgebraicGeometry.AffineOpenDeRham

variable {Y S : Scheme.{u}} (q : Y ⟶ S) {W : Y.Opens} {V : S.Opens}
  (hW : IsAffineOpen W) (hV : IsAffineOpen V) (e : W ≤ q ⁻¹ᵁ V)

include hW hV e in
/-- **Over an affine open lying over an affine open of the base, the relative `p`-forms are
spanned by the exact wedges** `d c₁ ∧ ⋯ ∧ d c_p` of functions there. -/
theorem mem_span_homogeneousProdLeft (p : ℕ)
    (ω : Γ(Scheme.Hom.relativeDifferentialForms q (p : ℤ), W)) :
    ω ∈ Submodule.span Γ(Y, W) (Set.range fun c : Fin p → Γ(Y, W) =>
      id (α := Γ(Scheme.Hom.relativeDifferentialForms q (p : ℤ), W))
        ((Scheme.Hom.deRhamAlgebras q).exterior.toPresheafGradedAlgebra.homogeneousProdLeft
          (op W) p fun i =>
            _root_.AlgebraicGeometry.SheafOfModules.exactOne (Scheme.Hom.deRhamAlgebras q)
              (op W) (c i))) := by
  let _ := (q.appLE V W e).hom.toAlgebra
  have hle : Submodule.span Γ(Y, W) (Set.range fun c : Fin p → Γ(Y, W) =>
        exteriorPower.ιMulti Γ(Y, W) p fun i => CommRingCat.KaehlerDifferential.d (c i)) ≤
      (Submodule.span Γ(Y, W) (Set.range fun c : Fin p → Γ(Y, W) =>
        id (α := Γ(Scheme.Hom.relativeDifferentialForms q (p : ℤ), W))
          ((Scheme.Hom.deRhamAlgebras q).exterior.toPresheafGradedAlgebra.homogeneousProdLeft
            (op W) p fun i =>
              _root_.AlgebraicGeometry.SheafOfModules.exactOne (Scheme.Hom.deRhamAlgebras q)
                (op W) (c i)))).comap (formsSectionsIso q hW hV e p).inv.hom := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨c, rfl⟩
    exact Submodule.subset_span ⟨c, (formsSectionsIso_inv_ιMulti_d q hW hV e p c).symm⟩
  have htop : Submodule.span Γ(Y, W) (Set.range fun c : Fin p → Γ(Y, W) =>
        exteriorPower.ιMulti Γ(Y, W) p fun i => CommRingCat.KaehlerDifferential.d (c i)) = ⊤ :=
    Crystalline.span_range_ιMulti_eq_top (KaehlerDifferential.D ↑Γ(S, V) ↑Γ(Y, W))
      (KaehlerDifferential.span_range_derivation ↑Γ(S, V) ↑Γ(Y, W)) p
  have h := hle (htop.symm ▸ Submodule.mem_top (x := (formsSectionsIso q hW hV e p).hom ω))
  rwa [Submodule.mem_comap, (formsSectionsIso q hW hV e p).hom_inv_id_apply ω] at h

include hW hV in
/-- **The degreewise comparison on a generator** `a₀ · (d c₁ ∧ ⋯ ∧ d c_p)`: it is carried to
`a₀ · (d c₁ ∧ ⋯ ∧ d c_p)` in the exterior power of the Kähler differentials. -/
theorem formsSectionsIso_hom_smul_homogeneousProdLeft (p : ℕ) (a₀ : Γ(Y, W))
    (c : Fin p → Γ(Y, W)) :
    (formsSectionsIso q hW hV e p).hom
        (a₀ • id (α := Γ(Scheme.Hom.relativeDifferentialForms q (p : ℤ), W))
          ((Scheme.Hom.deRhamAlgebras q).exterior.toPresheafGradedAlgebra.homogeneousProdLeft
            (op W) p fun i =>
              _root_.AlgebraicGeometry.SheafOfModules.exactOne (Scheme.Hom.deRhamAlgebras q)
                (op W) (c i))) =
      a₀ • exteriorPower.ιMulti Γ(Y, W) p fun i => CommRingCat.KaehlerDifferential.d (c i) := by
  rw [map_smul]
  congr 1
  rw [← formsSectionsIso_inv_ιMulti_d q hW hV e p c]
  exact (formsSectionsIso q hW hV e p).inv_hom_id_apply _

include hW hV in
/-- `Stacks.AlgebraicGeometry.AffineOpenDeRham.formsSectionsIso_hom_smul_homogeneousProdLeft`
read backwards, with the Kähler differential written as `KaehlerDifferential.D`. -/
theorem formsSectionsIso_inv_smul_ιMulti_D (p : ℕ) (a₀ : Γ(Y, W)) (c : Fin p → Γ(Y, W)) :
    letI := (q.appLE V W e).hom.toAlgebra
    (formsSectionsIso q hW hV e p).inv
        (a₀ • exteriorPower.ιMulti Γ(Y, W) p fun i => KaehlerDifferential.D Γ(S, V) Γ(Y, W) (c i)) =
      a₀ • id (α := Γ(Scheme.Hom.relativeDifferentialForms q (p : ℤ), W))
          ((Scheme.Hom.deRhamAlgebras q).exterior.toPresheafGradedAlgebra.homogeneousProdLeft
            (op W) p fun i =>
              _root_.AlgebraicGeometry.SheafOfModules.exactOne (Scheme.Hom.deRhamAlgebras q)
                (op W) (c i)) := by
  let := (q.appLE V W e).hom.toAlgebra
  have h := formsSectionsIso_hom_smul_homogeneousProdLeft q hW hV e p a₀ c
  have h' := congrArg (formsSectionsIso q hW hV e p).inv.hom h
  rw [Iso.hom_inv_id_apply] at h'
  exact h'.symm

end Stacks.AlgebraicGeometry.AffineOpenDeRham

namespace Stacks.LineBundle

variable (D : Situation.{u})

/-- The structure morphism `𝕃 ⟶ S` of the total space over the base of the situation. -/
abbrev Situation.totalToBase : D.totalSpace ⟶ D.S :=
  D.totalSpaceToBase ≫ D.f

/-- The sheaf `Ω^p_{𝕃/S}` of relative differential `p`-forms of the total space. -/
abbrev Situation.totalForms (p : ℕ) : D.totalSpace.Modules :=
  Scheme.Hom.relativeDifferentialForms D.totalToBase (p : ℤ)

/-- The pushforward `π_* Ω^p_{𝕃/S}`, an `𝒪_X`-module. -/
def Situation.totalFormsPushforward (p : ℕ) : D.X.Modules :=
  (Scheme.Modules.pushforward D.totalSpaceToBase).obj (D.totalForms p)

/-- The homogeneous function of degree `k` on `π⁻¹W` attached to a local section of `Symᵏ(L)`
over an open `W` of `X`. -/
def Situation.totalFunction (k : ℕ) (W : D.X.Opens)
    (x : (D.symmetricAlgebra.piece (k : ℤ)).val.obj (op W)) :
    Γ(D.totalSpace, D.totalSpaceToBase ⁻¹ᵁ W) :=
  ((Stacks.RelativeSpec.universalAlgebraMap D.relativeSpecSituation).right.app (op W)).hom
    (D.algebraSheafIncl k W x)

/-- **The homogeneous relative differential forms of degree `n` on `π⁻¹W`**: the forms
`a₀ d a₁ ∧ ⋯ ∧ d aₚ` whose coefficients `aᵢ` are homogeneous functions of degrees summing to
`n`. -/
def Situation.IsHomogeneousTotalForm (W : D.X.Opens) (p n : ℕ)
    (ω : Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W)) : Prop :=
  ∃ (deg : Fin (p + 1) → ℕ) (a : Fin (p + 1) → Γ(D.totalSpace, D.totalSpaceToBase ⁻¹ᵁ W)),
    (∀ i, ∃ x, D.totalFunction (deg i) W x = a i) ∧ n = ∑ i, deg i ∧
    ω = a 0 • id (α := Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W))
      ((Scheme.Hom.deRhamAlgebras D.totalToBase).exterior.toPresheafGradedAlgebra
          |>.homogeneousProdLeft (op (D.totalSpaceToBase ⁻¹ᵁ W)) p fun i =>
            SheafOfModules.exactOne (Scheme.Hom.deRhamAlgebras D.totalToBase) _ (a i.succ))

/-- **The degree-`n` part `Ω^p_{𝕃/S, n}` of the pushed-forward relative differential forms of the
total space of a line bundle**: the sub-`𝒪_X`-module sheaf of `π_* Ω^p_{𝕃/S}` generated by the
homogeneous forms of degree `n`, that is, the sections which are locally `𝒪_X`-combinations of
homogeneous forms. This is the sheaf-level counterpart of the graded components of Tag 0FU9. -/
def Situation.gradedTotalForms (p n : ℕ) : (D.totalFormsPushforward p).Submodule :=
  Stacks.SheafOfModules.localSpan (D.totalFormsPushforward p)
    fun W => {ω | D.IsHomogeneousTotalForm W.unop p n ω}

/-! ### Homogeneous functions -/

/-- **The inclusion of a homogeneous section of `Sym(L)` is linear over the structure map.** -/
theorem Situation.algebraSheafIncl_smul (U : D.X.Opens) (n : ℤ)
    (a : D.X.ringCatSheaf.obj.obj (op U)) (y : (D.symmetricAlgebra.piece n).val.obj (op U)) :
    D.algebraSheafIncl n U (a • y) =
      (D.algebraSheaf.hom.hom.app (op U)).hom a * D.algebraSheafIncl n U y := by
  have h1 : Stacks.GradedAlgebra.structureMap D.symmetricAlgebra.toPresheafGradedAlgebra
        (op U) a * D.symmetricAlgebra.toPresheafGradedAlgebra.incl n y =
      a • D.symmetricAlgebra.toPresheafGradedAlgebra.incl n y := by
    show a • (1 : D.symmetricAlgebra.toPresheafGradedAlgebra.Total (op U)) * _ = _
    rw [Stacks.GradedAlgebra.smul_mul_eq, one_mul]
  refine (congrArg (Stacks.RelativeSpec.ungradedCommUnit D.X D.symmetricAlgebra
    D.symmetricAlgebra_mul_comm U).hom ?_).trans (map_mul _ _ _)
  exact (D.symmetricAlgebra.toPresheafGradedAlgebra.incl_smul n a y).trans h1.symm

/-- **The structure map of the algebra sheaf of the line bundle is the inclusion of degree
zero**: it carries `r` to the image of `r • 1`. -/
theorem Situation.algebraSheaf_hom_eq_incl (U : D.X.Opens) (r : D.X.ringCatSheaf.obj.obj (op U)) :
    (D.algebraSheaf.hom.hom.app (op U)).hom r =
      D.algebraSheafIncl 0 U (r • D.symmetricAlgebra.one.eval (op U)) := by
  refine congrArg (Stacks.RelativeSpec.ungradedCommUnit D.X D.symmetricAlgebra
    D.symmetricAlgebra_mul_comm U).hom ?_
  show r • (1 : D.symmetricAlgebra.toPresheafGradedAlgebra.Total (op U)) = _
  rw [Stacks.GradedAlgebra.one_eq_incl, ← Stacks.GradedAlgebra.incl_smul]
  rfl

/-- The homogeneous functions are additive. -/
theorem Situation.totalFunction_add (k : ℕ) (W : D.X.Opens)
    (x y : (D.symmetricAlgebra.piece (k : ℤ)).val.obj (op W)) :
    D.totalFunction k W (x + y) = D.totalFunction k W x + D.totalFunction k W y :=
  (congrArg (fun z => ((Stacks.RelativeSpec.universalAlgebraMap
      D.relativeSpecSituation).right.app (op W)).hom
        ((Stacks.RelativeSpec.ungradedCommUnit D.X D.symmetricAlgebra
          D.symmetricAlgebra_mul_comm W).hom z))
      (D.symmetricAlgebra.toPresheafGradedAlgebra.incl_add (k : ℤ) x y)).trans
    ((congrArg (fun z => ((Stacks.RelativeSpec.universalAlgebraMap
      D.relativeSpecSituation).right.app (op W)).hom z) (map_add _ _ _)).trans (map_add _ _ _))

/-- **The homogeneous functions multiply by adding degrees.** -/
theorem Situation.totalFunction_mul (i j : ℕ) (W : D.X.Opens)
    (x : (D.symmetricAlgebra.piece (i : ℤ)).val.obj (op W))
    (y : (D.symmetricAlgebra.piece (j : ℤ)).val.obj (op W)) :
    D.totalFunction i W x * D.totalFunction j W y =
      D.totalFunction (i + j) W ((D.symmetricAlgebra.mul (i : ℤ) (j : ℤ)).app (op W) x y) :=
  (map_mul _ _ _).symm.trans
    (congrArg (fun z => ((Stacks.RelativeSpec.universalAlgebraMap
      D.relativeSpecSituation).right.app (op W)).hom z) (D.algebraSheafIncl_mul _ _ W x y))

/-- **The homogeneous function of `r • 1` in degree zero is the pullback of `r` along `π`.** -/
theorem Situation.totalFunction_smul_one (W : D.X.Opens) (r : Γ(D.X, W)) :
    D.totalFunction 0 W (id (α := D.X.ringCatSheaf.obj.obj (op W)) r •
        D.symmetricAlgebra.one.eval (op W)) =
      (D.totalSpaceToBase.app W).hom r := by
  refine (congrArg (fun z => ((Stacks.RelativeSpec.universalAlgebraMap
      D.relativeSpecSituation).right.app (op W)).hom z)
      (D.algebraSheaf_hom_eq_incl W r).symm).trans ?_
  exact (congrArg (fun k => k.hom r)
    (Stacks.RelativeSpec.toBase_app D.relativeSpecSituation W)).symm

/-- **Every homogeneous function of degree zero is pulled back from `X`.** -/
theorem Situation.exists_totalFunction_zero (W : D.X.Opens)
    (x : (D.symmetricAlgebra.piece ((0 : ℕ) : ℤ)).val.obj (op W)) :
    ∃ r : Γ(D.X, W), D.totalFunction 0 W x = (D.totalSpaceToBase.app W).hom r := by
  refine ⟨(D.symmetricPieceZeroIso.hom.val.app (op W) x : D.X.ringCatSheaf.obj.obj (op W)), ?_⟩
  refine (congrArg (D.totalFunction 0 W) ?_).trans (D.totalFunction_smul_one W _)
  exact (SheafOfModules.GradedAlgebra.eq_smul_one_of_isoUnit D.symmetricAlgebra
    D.symmetricPieceZeroIso (D.symmetricPieceZeroIso_hom_one) (op W) x _ rfl).symm

/-- Every pullback along `π` is a homogeneous function of degree zero. -/
theorem Situation.exists_totalFunction_eq_app (W : D.X.Opens) (r : Γ(D.X, W)) :
    ∃ x, D.totalFunction 0 W x = (D.totalSpaceToBase.app W).hom r :=
  ⟨_, D.totalFunction_smul_one W r⟩

/-- **Homogeneous functions commute with restriction**: the restriction of the homogeneous
function of a local section of `Symᵏ(L)` to the inverse image of a smaller open is the homogeneous
function of the restricted section. -/
theorem Situation.totalFunction_map (k : ℕ) {W W' : D.X.Opens} (h : W' ≤ W)
    (x : (D.symmetricAlgebra.piece (k : ℤ)).val.obj (op W))
    (g : op (D.totalSpaceToBase ⁻¹ᵁ W) ⟶ op (D.totalSpaceToBase ⁻¹ᵁ W')) :
    (D.totalSpace.sheaf.obj.map g).hom (D.totalFunction k W x) =
      D.totalFunction k W' ((D.symmetricAlgebra.piece (k : ℤ)).val.map (homOfLE h).op x) := by
  obtain rfl : g = ((Opens.map D.totalSpaceToBase.base).map (homOfLE h)).op :=
    Subsingleton.elim _ _
  refine (ConcreteCategory.congr_hom
    ((Stacks.RelativeSpec.universalAlgebraMap D.relativeSpecSituation).right.naturality
      (homOfLE h).op) (D.algebraSheafIncl k W x)).symm.trans ?_
  refine congrArg (fun z => ((Stacks.RelativeSpec.universalAlgebraMap
    D.relativeSpecSituation).right.app (op W')).hom z) ?_
  refine (ConcreteCategory.congr_hom
    (((sheafificationAdjunction (Opens.grothendieckTopology (D.X : TopCat))
      CommRingCat.{u}).unit.app (Stacks.RelativeSpec.ungradedCommPresheaf D.X D.symmetricAlgebra
        D.symmetricAlgebra_mul_comm)).naturality (homOfLE h).op)
    (D.symmetricAlgebra.toPresheafGradedAlgebra.incl (k : ℤ) x)).symm.trans ?_
  exact congrArg (Stacks.RelativeSpec.ungradedCommUnit D.X D.symmetricAlgebra
    D.symmetricAlgebra_mul_comm W').hom
    (D.symmetricAlgebra.toPresheafGradedAlgebra.totalRestrict_incl (homOfLE h).op (k : ℤ) x)

/-- **Homogeneous forms restrict to homogeneous forms.** -/
theorem Situation.IsHomogeneousTotalForm.map {W W' : D.X.Opens} (h : W' ≤ W) {p n : ℕ}
    {ω : Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W)} (hω : D.IsHomogeneousTotalForm W p n ω) :
    D.IsHomogeneousTotalForm W' p n
      ((D.totalFormsPushforward p).val.map (homOfLE h).op ω) := by
  obtain ⟨deg, a, ha, hn, rfl⟩ := hω
  let g : op (D.totalSpaceToBase ⁻¹ᵁ W) ⟶ op (D.totalSpaceToBase ⁻¹ᵁ W') :=
    ((Opens.map D.totalSpaceToBase.base).map (homOfLE h)).op
  refine ⟨deg, fun i => D.totalSpace.sheaf.obj.map g (a i), fun i => ?_, hn, ?_⟩
  · obtain ⟨x, hx⟩ := ha i
    exact ⟨_, (D.totalFunction_map (deg i) h x g).symm.trans (congrArg _ hx)⟩
  · refine (PresheafOfModules.map_smul (D.totalForms p).val g (a 0) _).trans ?_
    refine congrArg (fun z => D.totalSpace.sheaf.obj.map g (a 0) • z) ?_
    refine ((Scheme.Hom.deRhamAlgebras D.totalToBase).exterior.toPresheafGradedAlgebra
      |>.homogeneousProdLeft_naturality g p _).trans ?_
    exact congrArg (fun z =>
      (Scheme.Hom.deRhamAlgebras D.totalToBase).exterior.toPresheafGradedAlgebra
        |>.homogeneousProdLeft _ p z)
      (funext fun i => AlgebraicGeometry.SheafOfModules.exactOne_map _ g (a i.succ))

/-! ### The graded pieces -/

/-- **Every homogeneous form of degree `n` is a section of `Ω^p_{𝕃/S, n}`.** -/
theorem Situation.mem_gradedTotalForms {p n : ℕ} {W : D.X.Opens}
    {ω : Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W)} (hω : D.IsHomogeneousTotalForm W p n ω) :
    ω ∈ (D.gradedTotalForms p n).obj (op W) :=
  Stacks.SheafOfModules.mem_localSpan (N := D.totalFormsPushforward p) (T := fun W =>
    {ω | D.IsHomogeneousTotalForm W.unop p n ω}) (X := op W) hω

/-- The span of the homogeneous forms of degree `n` and their restrictions over `W` lies in any
submodule containing the restrictions of all homogeneous forms. -/
private theorem Situation.spanSubmodule_obj_le {p n : ℕ} {W : D.X.Opens}
    (P : Submodule (D.X.ringCatSheaf.obj.obj (op W)) ((D.totalFormsPushforward p).val.obj (op W)))
    (h : ∀ (Z : D.X.Opensᵒᵖ) (g : Z ⟶ op W) (z : (D.totalFormsPushforward p).val.obj Z),
      D.IsHomogeneousTotalForm Z.unop p n z → (D.totalFormsPushforward p).val.map g z ∈ P) :
    (Stacks.SheafOfModules.spanSubmodule (D.totalFormsPushforward p)
      (fun W => {ω | D.IsHomogeneousTotalForm W.unop p n ω})).obj (op W) ≤ P := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨Z, g, z, hz, rfl⟩
  exact h Z g z hz

/-- **`Ω^p_{𝕃/S, n}` is the smallest submodule sheaf containing the homogeneous forms of degree
`n`.** -/
theorem Situation.gradedTotalForms_le_iff {p n : ℕ} (N : (D.totalFormsPushforward p).Submodule) :
    D.gradedTotalForms p n ≤ N ↔
      ∀ (W : D.X.Opens) (ω : Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W)),
        D.IsHomogeneousTotalForm W p n ω → ω ∈ N.obj (op W) := by
  refine ⟨fun h W ω hω => h (op W) (D.mem_gradedTotalForms hω), fun h V s hs => ?_⟩
  refine N.isSheaf s (GrothendieckTopology.superset_covering _ ?_
    ((Stacks.SheafOfModules.mem_localSpan_iff (N := D.totalFormsPushforward p)
      (T := fun W => {ω | D.IsHomogeneousTotalForm W.unop p n ω}) s).1 hs))
  intro W i hi
  exact D.spanSubmodule_obj_le (N.obj (op W)) (fun _ g z hz => N.map g (h _ z hz)) hi

/-! ### Charts -/

/-- **Charts inside an arbitrary open**: every point of an open `W` of `X` has an affine open
neighbourhood inside `W` which lies over an affine open of `S` and over which `L` is trivial. -/
theorem Situation.exists_chart_le {W : D.X.Opens} {x : D.X} (hx : x ∈ W) :
    ∃ (U : D.X.Opens) (V : D.S.Opens), x ∈ U ∧ U ≤ W ∧ IsAffineOpen U ∧ IsAffineOpen V ∧
      U ≤ D.f ⁻¹ᵁ V ∧ Nonempty (D.L.over U ≅ SheafOfModules.unit (D.X.ringCatSheaf.over U)) := by
  obtain ⟨U₀, hxU₀, ⟨t⟩⟩ := D.exists_trivializing_affineOpen x
  obtain ⟨V, hV, hxV, -⟩ :=
    Opens.isBasis_iff_nbhd.1 D.S.isBasis_affineOpens (show D.f x ∈ (⊤ : D.S.Opens) from trivial)
  obtain ⟨U, hU, hxU, hUW⟩ := Opens.isBasis_iff_nbhd.1 D.X.isBasis_affineOpens
    (show x ∈ W ⊓ U₀.1 ⊓ D.f ⁻¹ᵁ V from ⟨⟨hx, hxU₀⟩, hxV⟩)
  exact ⟨U, V, hxU, fun y hy => (hUW hy).1.1, hU, hV, fun y hy => (hUW hy).2,
    ⟨Stacks.SheafOfModules.isoUnitOverOfHom D.L (homOfLE fun y hy => (hUW hy).1.2) t⟩⟩

/-- **Membership in a submodule sheaf of a module on `X` may be tested on charts.** -/
theorem Situation.mem_of_forall_chart {M : D.X.Modules} (N : M.Submodule) {W : D.X.Opens}
    (s : Γ(M, W))
    (h : ∀ (U : D.X.Opens) (V : D.S.Opens) (hUW : U ≤ W), IsAffineOpen U → IsAffineOpen V →
      U ≤ D.f ⁻¹ᵁ V → Nonempty (D.L.over U ≅ SheafOfModules.unit (D.X.ringCatSheaf.over U)) →
      M.val.map (homOfLE hUW).op s ∈ N.obj (op U)) :
    s ∈ N.obj (op W) := by
  refine N.isSheaf s fun x hx => ?_
  obtain ⟨U, V, hxU, hUW, hU, hV, e, ht⟩ := D.exists_chart_le hx
  exact ⟨U, homOfLE hUW, h U V hUW hU hV e ht, hxU⟩

/-! ### Forms pulled back from `X` have degree zero -/

/-- **The pullback of forms along `π`**, `Ω^p_{X/S} ⟶ π_* Ω^p_{𝕃/S}`: the degree-`p` component of
the canonical map of de Rham complexes of the square of `π` over `S`. -/
def Situation.formsPullback (p : ℕ) :
    Scheme.Hom.relativeDifferentialForms D.f (p : ℤ) ⟶ D.totalFormsPushforward p :=
  (Scheme.Hom.deRhamFormsPushforwardHom D.totalSpaceToBase D.f D.totalToBase (𝟙 D.S)
    D.totalSpaceToBase_comp).app (p : ℤ)

/-- The pullback of an exact wedge of functions on `X` is a homogeneous form of degree zero. -/
theorem Situation.isHomogeneousTotalForm_formsPullback (p : ℕ) (U : D.X.Opens)
    (c : Fin p → Γ(D.X, U)) :
    D.IsHomogeneousTotalForm U p 0 ((D.formsPullback p).app U
      ((Scheme.Hom.deRhamAlgebras D.f).exterior.toPresheafGradedAlgebra.homogeneousProdLeft
        (op U) p fun i =>
          _root_.AlgebraicGeometry.SheafOfModules.exactOne (Scheme.Hom.deRhamAlgebras D.f)
            (op U) (c i))) := by
  refine ⟨fun _ => 0, Fin.cons 1 fun i => (D.totalSpaceToBase.app U).hom (c i), fun i => ?_,
    by simp, ?_⟩
  · refine Fin.cases ?_ (fun i => ?_) i
    · obtain ⟨x, hx⟩ := D.exists_totalFunction_eq_app U 1
      exact ⟨x, hx.trans (map_one _)⟩
    · exact D.exists_totalFunction_eq_app U (c i)
  · refine (Scheme.Hom.deRhamFormsPushforwardHom_homogeneousProdLeft D.totalSpaceToBase D.f
      D.totalToBase (𝟙 D.S) D.totalSpaceToBase_comp (op U) p c).trans ?_
    exact (one_smul (D.totalSpace.ringCatSheaf.obj.obj (op (D.totalSpaceToBase ⁻¹ᵁ U)))
      (id (α := (D.totalForms p).val.obj (op (D.totalSpaceToBase ⁻¹ᵁ U))) _)).symm

/-- A morphism of modules on a scheme carries the span of a set of sections into a submodule
sheaf as soon as it carries the set there. -/
theorem _root_.AlgebraicGeometry.Scheme.Modules.Hom.app_mem_of_mem_span {Y : Scheme.{u}}
    {M N : Y.Modules} (φ : M ⟶ N) (N' : N.Submodule) (U : Y.Opens) (T : Set Γ(M, U))
    (hT : ∀ t ∈ T, φ.app U t ∈ N'.obj (op U)) {z : Γ(M, U)}
    (hz : z ∈ Submodule.span Γ(Y, U) T) : φ.app U z ∈ N'.obj (op U) := by
  induction hz using Submodule.span_induction with
  | mem x hx => exact hT x hx
  | zero =>
      exact (congrArg (fun t => t ∈ N'.obj (op U)) (map_zero (φ.val.app (op U)).hom)).mpr
        (Submodule.zero_mem _)
  | add x y _ _ hx hy =>
      exact (congrArg (fun t => t ∈ N'.obj (op U)) (map_add (φ.val.app (op U)).hom x y)).mpr
        (Submodule.add_mem _ hx hy)
  | smul a x _ hx =>
      exact (congrArg (fun t => t ∈ N'.obj (op U))
        (map_smul (φ.val.app (op U)).hom (id (α := Y.ringCatSheaf.obj.obj (op U)) a)
          (id (α := M.val.obj (op U)) x))).mpr (Submodule.smul_mem _ _ hx)

/-- **Every form pulled back from `X` is a section of `Ω^p_{𝕃/S, 0}`.** Over a chart the forms of
`X` are spanned by exact wedges of functions, whose pullbacks are homogeneous of degree zero. -/
theorem Situation.formsPullback_mem_gradedTotalForms_zero (p : ℕ) (W : D.X.Opens)
    (ω : Γ(Scheme.Hom.relativeDifferentialForms D.f (p : ℤ), W)) :
    (D.formsPullback p).app W ω ∈ (D.gradedTotalForms p 0).obj (op W) := by
  refine D.mem_of_forall_chart _ _ fun U V hUW hU hV e _ => ?_
  refine (congrArg (· ∈ (D.gradedTotalForms p 0).obj (op U))
    (PresheafOfModules.naturality_apply (D.formsPullback p).val (homOfLE hUW).op ω)).mp ?_
  refine Scheme.Modules.Hom.app_mem_of_mem_span (D.formsPullback p) _ U _ ?_
    (Stacks.AlgebraicGeometry.AffineOpenDeRham.mem_span_homogeneousProdLeft D.f hU hV e p
      ((Scheme.Hom.relativeDifferentialForms D.f (p : ℤ)).val.map (homOfLE hUW).op ω))
  rintro _ ⟨c, rfl⟩
  exact D.mem_gradedTotalForms (D.isHomogeneousTotalForm_formsPullback p U c)

/-- The `𝒪_X(W)`-span of the homogeneous forms of degree `n` over `π⁻¹W`, as a submodule of the
sections of `π_* Ω^p_{𝕃/S}` over `W`. -/
def Situation.homogeneousSpan (p n : ℕ) (W : D.X.Opens) :
    Submodule (D.X.ringCatSheaf.obj.obj (op W)) ((D.totalFormsPushforward p).val.obj (op W)) :=
  Submodule.span (D.X.ringCatSheaf.obj.obj (op W)) {ω | D.IsHomogeneousTotalForm W p n ω}

/-- The span of the homogeneous forms is stable under restriction. -/
theorem Situation.homogeneousSpan_map {p n : ℕ} {W W' : D.X.Opens} (h : W' ≤ W)
    {x : (D.totalFormsPushforward p).val.obj (op W)} (hx : x ∈ D.homogeneousSpan p n W) :
    (D.totalFormsPushforward p).val.map (homOfLE h).op x ∈ D.homogeneousSpan p n W' := by
  induction hx using Submodule.span_induction with
  | mem y hy => exact Submodule.subset_span (Situation.IsHomogeneousTotalForm.map D h hy)
  | zero =>
      rw [map_zero]
      exact Submodule.zero_mem _
  | add y z _ _ hy hz =>
      rw [map_add]
      exact Submodule.add_mem _ hy hz
  | smul a y _ hy =>
      rw [PresheafOfModules.map_smul]
      exact Submodule.smul_mem _ _ hy

/-- **A section of `Ω^p_{𝕃/S, n}` is, around every point, on a chart, an `𝒪_X`-combination of
homogeneous forms of degree `n`.** -/
theorem Situation.exists_chart_mem_homogeneousSpan {p n : ℕ} {W : D.X.Opens}
    {x : (D.totalFormsPushforward p).val.obj (op W)}
    (hx : x ∈ (D.gradedTotalForms p n).obj (op W)) {y : D.X} (hy : y ∈ W) :
    ∃ (U : D.X.Opens) (V : D.S.Opens) (hUW : U ≤ W), y ∈ U ∧ IsAffineOpen U ∧
      IsAffineOpen V ∧ U ≤ D.f ⁻¹ᵁ V ∧
      Nonempty (D.L.over U ≅ SheafOfModules.unit (D.X.ringCatSheaf.over U)) ∧
      (D.totalFormsPushforward p).val.map (homOfLE hUW).op x ∈ D.homogeneousSpan p n U := by
  obtain ⟨W', i, hi, hyW'⟩ := (Stacks.SheafOfModules.mem_localSpan_iff
    (N := D.totalFormsPushforward p)
    (T := fun W => {ω | D.IsHomogeneousTotalForm W.unop p n ω}) x).1 hx y hy
  obtain ⟨U, V, hyU, hUW', hU, hV, e, ht⟩ := D.exists_chart_le hyW'
  have hle := D.spanSubmodule_obj_le (D.homogeneousSpan p n W') fun _ g z hz => by
    rw [show g = (homOfLE (leOfHom g.unop)).op from Subsingleton.elim _ _]
    exact Submodule.subset_span (Situation.IsHomogeneousTotalForm.map D _ hz)
  refine ⟨U, V, hUW'.trans (leOfHom i), hyU, hU, hV, e, ht, ?_⟩
  have h := D.homogeneousSpan_map hUW' (hle hi)
  rwa [← PresheafOfModules.map_comp_apply, ← op_comp,
    show homOfLE hUW' ≫ i = homOfLE (hUW'.trans (leOfHom i)) from Subsingleton.elim _ _] at h

/-- The sections of `π_* Ω^p_{𝕃/S}` over `W` are the forms on `π⁻¹W`; this is that identity, as
an additive map from the first spelling to the second. -/
def Situation.toForms (p : ℕ) (W : D.X.Opens) :
    (D.totalFormsPushforward p).val.obj (op W) →+ Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W) where
  toFun x := x
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The inverse of `Stacks.LineBundle.Situation.toForms`. -/
def Situation.ofForms (p : ℕ) (W : D.X.Opens) :
    Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W) →+ (D.totalFormsPushforward p).val.obj (op W) where
  toFun x := x
  map_zero' := rfl
  map_add' _ _ := rfl

/-- `toForms` is the identity on underlying elements. -/
theorem Situation.toForms_apply (p : ℕ) (W : D.X.Opens)
    (x : (D.totalFormsPushforward p).val.obj (op W)) :
    D.toForms p W x = id (α := Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W)) x :=
  rfl

/-- `toForms` carries the action of a section `c` of `𝒪_X` over `W` to the action of its pullback
along `π`. -/
theorem Situation.toForms_smul (p : ℕ) (W : D.X.Opens) (c : D.X.ringCatSheaf.obj.obj (op W))
    (x : (D.totalFormsPushforward p).val.obj (op W)) :
    D.toForms p W (c • x) = (D.totalSpaceToBase.app W).hom c • D.toForms p W x :=
  rfl

/-- `ofForms` carries the action of the pullback along `π` of a section `c` of `𝒪_X` over `W` to
the action of `c`. -/
theorem Situation.ofForms_smul (p : ℕ) (W : D.X.Opens) (c : Γ(D.X, W))
    (x : Γ(D.totalForms p, D.totalSpaceToBase ⁻¹ᵁ W)) :
    D.ofForms p W ((D.totalSpaceToBase.app W).hom c • x) =
      id (α := D.X.ringCatSheaf.obj.obj (op W)) c • D.ofForms p W x :=
  rfl

end Stacks.LineBundle

end
