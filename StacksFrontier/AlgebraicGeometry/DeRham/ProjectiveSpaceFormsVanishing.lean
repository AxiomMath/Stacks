module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ExteriorPowerShortExact
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ExteriorStalkUngraded
public import StacksFrontier.AlgebraicGeometry.DeRham.Complex.DifferentialForms
public import StacksFrontier.AlgebraicGeometry.ProjEulerSequence.Exactness
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Cover

/-!
# Vanishing of the differential forms of projective space above the relative dimension

Let `A` be a commutative ring, let `n = m + 1 ≥ 1`, and write `ℙⁿ_A = Proj A[T₀, …, Tₙ]` with its
structure morphism `ℙⁿ_A ⟶ Spec A`. The sheaf `Ωᵖ_{ℙⁿ_A/A} = ⋀ᵖ Ω_{ℙⁿ_A/A}` of relative
differential `p`-forms is a zero object for every `p > n`.

The vanishing is checked on stalks. A point `x` lies on one of the standard opens `D₊(Tᵢ)`, since
those cover `ℙⁿ_A`, and there the differentials `d(Tⱼ/Tᵢ)` of the `n` affine coordinates `Tⱼ/Tᵢ`,
`j ≠ i`, generate the stalk of `Ω_{ℙⁿ_A/A}` at `x`. A module generated by `n` elements has a
one-element `p`-th exterior power as soon as `p > n`, and the stalk of `⋀ᵖ Ω_{ℙⁿ_A/A}` is the
`p`-th exterior power of the stalk of `Ω_{ℙⁿ_A/A}`, so every stalk of `Ωᵖ_{ℙⁿ_A/A}` has a single
element. A sheaf of modules with that property has vanishing identity, hence is a zero object.

## Main results

* `Stacks.AlgebraicGeometry.ProjectiveSpaceForms.isZero_relativeDifferentialForms_of_lt`:
  `Ωᵖ_{ℙⁿ_A/A} = 0` for `p > n`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Stacks.AlgebraicGeometry.ProjectiveSpaceForms

open Stacks.AlgebraicGeometry.ProjEulerSequence
open Stacks.AlgebraicGeometry.ProjPolyChart

/-- **The relative differential `p`-forms of `ℙⁿ_A` over `A` vanish for `p > n`**, where
`n = m + 1`. The stalk of `Ω_{ℙⁿ_A/A}` at a point of the chart `D₊(Tᵢ)` is generated by the `n`
differentials `d(Tⱼ/Tᵢ)`, `j ≠ i`, so its `p`-th exterior power — the stalk of `Ωᵖ_{ℙⁿ_A/A}` —
has a single element. -/
theorem isZero_relativeDifferentialForms_of_lt {A : Type u} [CommRing A] (m : ℕ) (p : ℕ)
    (hp : m + 1 < p) :
    IsZero (Scheme.Hom.relativeDifferentialForms (projToSpecCoeff A (m + 1)) (p : ℤ)) := by
  rw [IsZero.iff_id_eq_zero]
  refine Stacks.SheafOfModules.TopWedge.id_eq_zero_of_subsingleton_stalk _ fun x => ?_
  obtain ⟨i, hxi⟩ : ∃ i : Fin (m + 1 + 1),
      x ∈ ProjectiveSpectrum.basicOpen (polyGrading A (m + 1)) (MvPolynomial.X i) := by
    have hx : x ∈ ⨆ i : Fin (m + 1 + 1),
        Proj.basicOpen (polyGrading A (m + 1)) (MvPolynomial.X i) := by
      rw [iSup_basicOpen_X_eq_top]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx
    exact hx
  have hcard : Nat.card {j : Fin (m + 1 + 1) // j ≠ i} < p := by
    simp only [Nat.card_eq_fintype_card, Fintype.card_subtype_compl, Fintype.card_fin,
      Fintype.card_subtype_eq]
    omega
  refine @Equiv.subsingleton _ _
    (SheafOfModules.exteriorPowerStalkEquiv
      (Scheme.Hom.relativeDifferentialFormsAlgebra (projToSpecCoeff A (m + 1)))
      (Scheme.Modules.exteriorGenerator
        (Scheme.Hom.relativeDifferentials (projToSpecCoeff A (m + 1))))
      (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra _) p x).toEquiv ?_
  exact @exteriorPower.subsingleton_of_span_eq_top_of_card_lt
    (projStalk A (m + 1) x) _ _ _ (moduleStalkProjDifferentials A (m + 1) x)
    {j : Fin (m + 1 + 1) // j ≠ i} _ _
    (fun j => chartDiffGerm A (m + 1) x i hxi j.1)
    (span_range_chartDiffGerm_eq_top A (m + 1) x i hxi hxi) p hcard

end Stacks.AlgebraicGeometry.ProjectiveSpaceForms

end
