module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalDifferentials
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesComparison
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjAndSpecZeroSectionCartesian
public import StacksFrontier.AlgebraicGeometry.DeRham.CoordinateBlowupCone
public import StacksFrontier.AlgebraicGeometry.DeRham.CoordinateBlowupFormsGlobalSections
public import StacksFrontier.AlgebraicGeometry.DeRham.CoordinateBlowupFormsExtension
public import StacksFrontier.AlgebraicGeometry.DeRham.CoordinateConeFormsDirectImage
public import StacksFrontier.AlgebraicGeometry.DeRham.BlowupFormsEtaleLocal
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The zero section of the cone is the exceptional divisor of the coordinate blowup

In the standard situation of Section 50.16 of the source — `A = R[x₁, …, x_m, y₁, …, y_n]`
graded by `deg yⱼ = 1`, `X = Spec A`, the centre `Z = Spec(A₀)` and the cone
`L = Proj(⨁_d A_{≥ d})` with zero section `0 : P = Proj(A) ⟶ L` — the source states that the
image of the zero section is the exceptional divisor of the blowup `L ⟶ X` along `Z`. This
file proves the scheme-theoretic form of that statement: the square

```
P --0--> L
|        |
Z -----> X
```

is cartesian (`isPullback_coneZeroSection`), the kernel of `τ` in degree `d` being
`A_{≥ d+1} = A₊ · A_{≥ d}`. It then compares the centre `Z = Spec A₀` with the coordinate centre
`Spec R[x₁, …, x_m]` of `Stacks.MoreMorphisms.coordinateEmbedding`, and the zero section with the
exceptional divisor of `Stacks.Blowup.blowUp` along that centre.

## Main results

* `Stacks.DeRham.CoordinateCone.isPullback_coneZeroSection`: `P = L ×_X Z`.
* `Stacks.DeRham.CoordinateCone.coneCentreIso`: `Spec R[x₁, …, x_m] ≅ Spec A₀` over `X`.
* `Stacks.DeRham.CoordinateCone.exists_iso_exceptionalDivisor`: the exceptional divisor of the
  blowup of `X` along `Spec R[x₁, …, x_m]` is `P`, compatibly with the projections to the centre
  and with the inclusions into the blowup.

## References

* [Stacks Project, Tag 0FUB](https://stacks.math.columbia.edu/tag/0FUB)
* [Stacks Project, Tag 0EKG](https://stacks.math.columbia.edu/tag/0EKG)
-/

@[expose] public noncomputable section

open MvPolynomial AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open Stacks.Truncation Stacks.AlgebraicGeometry.ProjAndSpec
open Stacks.AlgebraicGeometry.ProjAndSpecTruncation

universe u

attribute [-instance] CategoryTheory.catToReflQuiver

namespace Stacks.DeRham.CoordinateCone

variable (R : Type u) [CommRing R] (m n : ℕ)

/-! ### The kernel of `τ` -/

/-- The ideal of the centre consists of elements of `A₊`. -/
theorem coordinateRingIdeal_le_irrelevant :
    Stacks.MoreMorphisms.coordinateRingIdeal R m n ≤
      (HomogeneousIdeal.irrelevant (yGrading R m n)).toIdeal := by
  intro x hx
  have h1 : x ∈ truncation (yGrading R m n) 1 :=
    (mem_coordinateRingIdeal_pow_iff R m n 1 x).1 (by rwa [pow_one])
  show x ∈ HomogeneousIdeal.irrelevant (yGrading R m n)
  rw [HomogeneousIdeal.mem_irrelevant_iff]
  exact (mem_truncation_iff (yGrading R m n)).1 h1 0 one_pos

/-- **The kernel of `τ` is generated by `σ(A₊)`** in the truncation algebra of `A`: an element
`a⁽ᵈ⁾` killed by `τ` has `a ∈ A_{≥ d+1} = A₊ · A_{≥ d}`. -/
theorem mem_span_of_tau_eq_zero : ∀ (d : ℕ) (b : TruncationRing (yGrading R m n)),
    b ∈ grading (yGrading R m n) d → (truncationConeData (yGrading R m n)).tau b = 0 →
      b ∈ Ideal.span ((fun a => ((truncationConeData (yGrading R m n)).sigma a :
        TruncationRing (yGrading R m n))) ''
          (HomogeneousIdeal.irrelevant (yGrading R m n)).toIdeal) := by
  intro d b hb hτ
  obtain ⟨a, rfl⟩ := (mem_grading_iff (yGrading R m n)).1 hb
  have hproj : GradedRing.proj (yGrading R m n) d (a : MvPolynomial (Fin m ⊕ Fin n) R) = 0 := by
    rwa [← tau_apply (yGrading R m n) d (a : MvPolynomial (Fin m ⊕ Fin n) R) a.2]
  have ha1 : (a : MvPolynomial (Fin m ⊕ Fin n) R) ∈
      Stacks.MoreMorphisms.coordinateRingIdeal R m n *
        Stacks.MoreMorphisms.coordinateRingIdeal R m n ^ d := by
    have := sub_proj_mem_truncation_succ (yGrading R m n) a.2
    rwa [hproj, sub_zero, ← mem_coordinateRingIdeal_pow_iff, pow_succ'] at this
  have hT : ∀ x ∈ Stacks.MoreMorphisms.coordinateRingIdeal R m n *
      Stacks.MoreMorphisms.coordinateRingIdeal R m n ^ d, x ∈ truncation (yGrading R m n) d :=
    fun x hx => truncation_le_truncation (yGrading R m n) (Nat.le_succ d)
      ((mem_coordinateRingIdeal_pow_iff R m n (d + 1) x).1 (by rwa [pow_succ']))
  have key : ∀ x (hx : x ∈ Stacks.MoreMorphisms.coordinateRingIdeal R m n *
      Stacks.MoreMorphisms.coordinateRingIdeal R m n ^ d),
      degElt (yGrading R m n) d x (hT x hx) ∈ Ideal.span ((fun a =>
        ((truncationConeData (yGrading R m n)).sigma a : TruncationRing (yGrading R m n))) ''
          (HomogeneousIdeal.irrelevant (yGrading R m n)).toIdeal) := by
    intro x hx
    induction hx using Submodule.mul_induction_on' with
    | mem_mul_mem y hy z hz =>
      have hz' : z ∈ truncation (yGrading R m n) d :=
        (mem_coordinateRingIdeal_pow_iff R m n d z).1 hz
      rw [degElt_congr (yGrading R m n) (zero_add d).symm rfl _
        (mul_mem_truncation (yGrading R m n) (mem_truncation_zero R m n y) hz'),
        ← degElt_mul (yGrading R m n) 0 d y z (mem_truncation_zero R m n y) hz',
        ← coe_sigma_eq_degElt]
      exact Ideal.mul_mem_right _ _
        (Ideal.subset_span ⟨y, coordinateRingIdeal_le_irrelevant R m n hy, rfl⟩)
    | add x hx₁ y hy₁ ihx ihy =>
      rw [degElt_add (yGrading R m n) d x y (hT x hx₁) (hT y hy₁)]
      exact add_mem ihx ihy
  have := key a ha1
  rwa [degElt_eq_of] at this

/-- **The zero section of the cone is the fibre product `L ×_X Z`**: the exceptional divisor of
the blowup of `X = Spec A` along `Z = Spec A₀` is the zero section of the cone. -/
theorem isPullback_coneZeroSection :
    IsPullback (zeroSection (truncationConeData (yGrading R m n))) (coneBundleToCentre R m n)
      (coneToAmbient R m n) (coneCentreToAmbient R m n) :=
  Stacks.AlgebraicGeometry.ProjAndSpec.isPullback_zeroSection _ (mem_span_of_tau_eq_zero R m n)

/-! ### The centre `Spec A₀` is the coordinate centre `Spec R[x₁, …, x_m]` -/

/-- The degree-zero part `A₀` of `A`, as a ring. -/
abbrev coneCentreRing : Type u := yGrading R m n 0

/-- The inclusion `A₀ ⟶ A`. -/
abbrev coneCentreIncl : coneCentreRing R m n →+* MvPolynomial (Fin m ⊕ Fin n) R :=
  algebraMap (coneCentreRing R m n) (MvPolynomial (Fin m ⊕ Fin n) R)

/-- Each variable `xᵢ` lies in the degree-zero part `A₀`. -/
theorem X_inl_mem_yGrading_zero (i : Fin m) :
    (X (Sum.inl i) : MvPolynomial (Fin m ⊕ Fin n) R) ∈ yGrading R m n 0 :=
  isWeightedHomogeneous_X R (yWeight m n) (Sum.inl i)

/-- Each constant `C r` lies in the degree-zero part `A₀`. -/
theorem C_mem_yGrading_zero (r : R) :
    (C r : MvPolynomial (Fin m ⊕ Fin n) R) ∈ yGrading R m n 0 :=
  isWeightedHomogeneous_C (yWeight m n) r

/-- The projection `A ⟶ A₀` kills each variable `yⱼ`. -/
theorem projZeroRingHom'_X_inr (j : Fin n) :
    GradedRing.projZeroRingHom' (yGrading R m n) (X (Sum.inr j)) = 0 := by
  refine Subtype.ext ?_
  rw [ZeroMemClass.coe_zero]
  show GradedRing.proj (yGrading R m n) 0 (X (Sum.inr j)) = 0
  rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne (yGrading R m n)
    (X_inr_mem_yGrading R m n j) one_ne_zero]

/-- The projection `A ⟶ A₀` fixes each constant `C r`. -/
theorem projZeroRingHom'_C (r : R) :
    (GradedRing.projZeroRingHom' (yGrading R m n) (C r) : MvPolynomial (Fin m ⊕ Fin n) R) = C r :=
  congrArg Subtype.val (GradedRing.projZeroRingHom'_apply_coe (yGrading R m n)
    ⟨C r, C_mem_yGrading_zero R m n r⟩)

/-- The projection `A ⟶ A₀` fixes each variable `xᵢ`. -/
theorem projZeroRingHom'_X_inl (i : Fin m) :
    (GradedRing.projZeroRingHom' (yGrading R m n) (X (Sum.inl i)) :
      MvPolynomial (Fin m ⊕ Fin n) R) = X (Sum.inl i) :=
  congrArg Subtype.val (GradedRing.projZeroRingHom'_apply_coe (yGrading R m n)
    ⟨X (Sum.inl i), X_inl_mem_yGrading_zero R m n i⟩)

/-- The coordinate projection `A ⟶ R[x₁, …, x_m]` sends `C r` to `C r`. -/
theorem coordinateProjection_C (r : R) :
    Stacks.MoreMorphisms.coordinateProjection R m n (C r) = C r := by
  simp [Stacks.MoreMorphisms.coordinateProjection]

/-- The coordinate projection `A ⟶ R[x₁, …, x_m]` sends `xᵢ` to `xᵢ`. -/
theorem coordinateProjection_X_inl (i : Fin m) :
    Stacks.MoreMorphisms.coordinateProjection R m n (X (Sum.inl i)) = X i := by
  simp [Stacks.MoreMorphisms.coordinateProjection]

/-- The coordinate projection `A ⟶ R[x₁, …, x_m]` sends `yⱼ` to `0`. -/
theorem coordinateProjection_X_inr (j : Fin n) :
    Stacks.MoreMorphisms.coordinateProjection R m n (X (Sum.inr j)) = 0 := by
  simp [Stacks.MoreMorphisms.coordinateProjection]

/-- Killing the `y`'s and reading the result in `A` is the projection onto `A₀`: both are ring
maps `A ⟶ A` agreeing on the variables. -/
theorem rename_comp_coordinateProjection :
    (rename Sum.inl : MvPolynomial (Fin m) R →ₐ[R] MvPolynomial (Fin m ⊕ Fin n) R).toRingHom.comp
        (Stacks.MoreMorphisms.coordinateProjection R m n) =
      (coneCentreIncl R m n).comp (GradedRing.projZeroRingHom' (yGrading R m n)) := by
  refine MvPolynomial.ringHom_ext (fun r => ?_) (fun s => ?_)
  · show rename Sum.inl (Stacks.MoreMorphisms.coordinateProjection R m n (C r)) =
      (GradedRing.projZeroRingHom' (yGrading R m n) (C r) : MvPolynomial (Fin m ⊕ Fin n) R)
    rw [coordinateProjection_C, rename_C, projZeroRingHom'_C]
  · rcases s with i | j
    · show rename Sum.inl (Stacks.MoreMorphisms.coordinateProjection R m n (X (Sum.inl i))) =
        (GradedRing.projZeroRingHom' (yGrading R m n) (X (Sum.inl i)) :
          MvPolynomial (Fin m ⊕ Fin n) R)
      rw [coordinateProjection_X_inl, rename_X, projZeroRingHom'_X_inl]
    · show rename Sum.inl (Stacks.MoreMorphisms.coordinateProjection R m n (X (Sum.inr j))) =
        (GradedRing.projZeroRingHom' (yGrading R m n) (X (Sum.inr j)) :
          MvPolynomial (Fin m ⊕ Fin n) R)
      rw [coordinateProjection_X_inr, map_zero, projZeroRingHom'_X_inr, ZeroMemClass.coe_zero]

/-- Killing the `y`'s after renaming is the identity of `R[x₁, …, x_m]`. -/
theorem coordinateProjection_comp_rename :
    (Stacks.MoreMorphisms.coordinateProjection R m n).comp
        (rename Sum.inl : MvPolynomial (Fin m) R →ₐ[R] MvPolynomial (Fin m ⊕ Fin n) R).toRingHom =
      RingHom.id _ := by
  refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
  · show Stacks.MoreMorphisms.coordinateProjection R m n (rename Sum.inl (C r)) = C r
    rw [rename_C, coordinateProjection_C]
  · show Stacks.MoreMorphisms.coordinateProjection R m n (rename Sum.inl (X i)) = X i
    rw [rename_X, coordinateProjection_X_inl]

/-- **`R[x₁, …, x_m] ≃ A₀`**, by `p ↦ p(x)` read in degree zero, with inverse the restriction of
the coordinate projection `A ⟶ R[x₁, …, x_m]`. -/
def coneCentreRingEquiv : MvPolynomial (Fin m) R ≃+* coneCentreRing R m n where
  toFun p := GradedRing.projZeroRingHom' (yGrading R m n) (rename Sum.inl p)
  invFun a := Stacks.MoreMorphisms.coordinateProjection R m n (coneCentreIncl R m n a)
  left_inv p := by
    have h := RingHom.congr_fun (rename_comp_coordinateProjection R m n) (rename Sum.inl p)
    have h₂ : ∀ q, Stacks.MoreMorphisms.coordinateProjection R m n (rename Sum.inl q) = q :=
      fun q => RingHom.congr_fun (coordinateProjection_comp_rename R m n) q
    change Stacks.MoreMorphisms.coordinateProjection R m n
      (((coneCentreIncl R m n).comp (GradedRing.projZeroRingHom' (yGrading R m n)))
        (rename Sum.inl p)) = p
    rw [← h]
    change Stacks.MoreMorphisms.coordinateProjection R m n
      (rename Sum.inl (Stacks.MoreMorphisms.coordinateProjection R m n (rename Sum.inl p))) = p
    rw [h₂, h₂]
  right_inv a := by
    have h := RingHom.congr_fun (rename_comp_coordinateProjection R m n) (coneCentreIncl R m n a)
    change ((rename Sum.inl :
        MvPolynomial (Fin m) R →ₐ[R] MvPolynomial (Fin m ⊕ Fin n) R).toRingHom.comp
        (Stacks.MoreMorphisms.coordinateProjection R m n)) (coneCentreIncl R m n a) = _ at h
    change GradedRing.projZeroRingHom' (yGrading R m n)
      (((rename Sum.inl :
          MvPolynomial (Fin m) R →ₐ[R] MvPolynomial (Fin m ⊕ Fin n) R).toRingHom.comp
        (Stacks.MoreMorphisms.coordinateProjection R m n)) (coneCentreIncl R m n a)) = a
    rw [h]
    exact (congrArg (GradedRing.projZeroRingHom' (yGrading R m n))
      (congrArg Subtype.val (GradedRing.projZeroRingHom'_apply_coe (yGrading R m n) a))).trans
      (GradedRing.projZeroRingHom'_apply_coe (yGrading R m n) a)
  map_mul' p q := by
    change GradedRing.projZeroRingHom' _ (rename Sum.inl (p * q)) =
      GradedRing.projZeroRingHom' _ (rename Sum.inl p) *
        GradedRing.projZeroRingHom' _ (rename Sum.inl q)
    rw [map_mul, map_mul]
  map_add' p q := by
    change GradedRing.projZeroRingHom' _ (rename Sum.inl (p + q)) =
      GradedRing.projZeroRingHom' _ (rename Sum.inl p) +
        GradedRing.projZeroRingHom' _ (rename Sum.inl q)
    rw [map_add, map_add]

/-! ### The centre, the blowup and the exceptional divisor -/

attribute [local instance] Stacks.MoreMorphisms.coordinateEmbedding_isClosedImmersion

/-- **The centre `Spec A₀` is the coordinate centre**: `Spec R[x₁, …, x_m] ≅ Spec A₀`. -/
def coneCentreIso : Stacks.DeRham.coordinateBlowupCentre R m ≅ coneCentre R m n where
  hom := Spec.map (CommRingCat.ofHom (coneCentreRingEquiv R m n).symm.toRingHom)
  inv := Spec.map (CommRingCat.ofHom (coneCentreRingEquiv R m n).toRingHom)
  hom_inv_id := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext1
    exact RingHom.ext fun x => (coneCentreRingEquiv R m n).symm_apply_apply x
  inv_hom_id := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext1
    exact RingHom.ext fun x => (coneCentreRingEquiv R m n).apply_symm_apply x

/-- The identification of the two centres is one over `X`. -/
theorem coneCentreIso_hom_comp :
    (coneCentreIso R m n).hom ≫ coneCentreToAmbient R m n =
      Stacks.MoreMorphisms.coordinateEmbedding R m n := by
  show Spec.map (CommRingCat.ofHom (coneCentreRingEquiv R m n).symm.toRingHom) ≫
    Spec.map (CommRingCat.ofHom (GradedRing.projZeroRingHom' (yGrading R m n))) =
      Spec.map (CommRingCat.ofHom (Stacks.MoreMorphisms.coordinateProjection R m n))
  rw [← Spec.map_comp]
  congr 1
  ext1
  refine RingHom.ext fun x => ?_
  show Stacks.MoreMorphisms.coordinateProjection R m n
    (coneCentreIncl R m n (GradedRing.projZeroRingHom' (yGrading R m n) x)) =
      Stacks.MoreMorphisms.coordinateProjection R m n x
  have h := RingHom.congr_fun (rename_comp_coordinateProjection R m n) x
  change rename Sum.inl (Stacks.MoreMorphisms.coordinateProjection R m n x) =
    coneCentreIncl R m n (GradedRing.projZeroRingHom' (yGrading R m n) x) at h
  rw [← h]
  exact RingHom.congr_fun (coordinateProjection_comp_rename R m n) _

/-- **The cone is the blowup** `Stacks.Blowup.blowUp` of `X` along the coordinate centre. -/
def coneStacksBlowupIso : AlgebraicGeometry.Proj (grading (yGrading R m n)) ≅
    Stacks.Blowup.blowUp (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker :=
  coneBlowupIso R m n ≪≫ AlgebraicGeometry.blowUpIso (Stacks.MoreMorphisms.coordinateIdeal R m n)

/-- The isomorphism `coneStacksBlowupIso` is one over `X`. -/
theorem coneStacksBlowupIso_hom_comp :
    (coneStacksBlowupIso R m n).hom ≫
        Stacks.Blowup.blowUpToBase (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker =
      coneToAmbient R m n :=
  (congrArg ((coneBlowupIso R m n).hom ≫ ·) (AlgebraicGeometry.blowUpIso_hom_blowUpToBase
    (Stacks.MoreMorphisms.coordinateIdeal R m n))).trans (coneBlowupIso_hom_comp R m n)

/-- **The exceptional divisor of the coordinate blowup is the zero section of the cone**: the
square of the zero section `P ⟶ L ≅ X'`, the projection `P ⟶ Spec A₀ ≅ Spec R[x₁, …, x_m]`,
the blowing-up morphism and the coordinate centre is cartesian. -/
@[sga "6 VII 3.7" "special case"]
theorem isPullback_coneZeroSection_blowUp :
    IsPullback (zeroSection (truncationConeData (yGrading R m n)) ≫ (coneStacksBlowupIso R m n).hom)
      (coneBundleToCentre R m n ≫ (coneCentreIso R m n).inv)
      (Stacks.Blowup.blowUpToBase (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker)
      (Stacks.MoreMorphisms.coordinateEmbedding R m n) :=
  (isPullback_coneZeroSection R m n).of_iso (Iso.refl _) (coneStacksBlowupIso R m n)
    (coneCentreIso R m n).symm (Iso.refl _) (by simp) (by simp)
    (by rw [Iso.refl_hom, Category.comp_id, coneStacksBlowupIso_hom_comp])
    (by rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, Iso.eq_inv_comp,
      coneCentreIso_hom_comp])

/-- **The identification `P ≅ E`** of the projective bundle `P = Proj(A)` with the exceptional
divisor of the blowup of `X` along the coordinate centre. -/
def coneExceptionalIso : coneBundle R m n ≅
    Stacks.Blowup.exceptionalDivisor (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker :=
  (isPullback_coneZeroSection_blowUp R m n).isoIsPullback _ _
    (Stacks.Blowup.isPullback_exceptionalToCentre (Stacks.MoreMorphisms.coordinateEmbedding R m n))

/-- The identification `P ≅ E` is one over the centre. -/
theorem coneExceptionalIso_hom_comp_toCentre :
    (coneExceptionalIso R m n).hom ≫
        Stacks.Blowup.exceptionalToCentre (Stacks.MoreMorphisms.coordinateEmbedding R m n) =
      coneBundleToCentre R m n ≫ (coneCentreIso R m n).inv :=
  IsPullback.isoIsPullback_hom_snd _ _ (isPullback_coneZeroSection_blowUp R m n)
    (Stacks.Blowup.isPullback_exceptionalToCentre (Stacks.MoreMorphisms.coordinateEmbedding R m n))

/-- The identification `P ≅ E` carries the zero section to the inclusion of the exceptional
divisor. -/
theorem coneExceptionalIso_hom_comp_ι :
    (coneExceptionalIso R m n).hom ≫
        (Stacks.Blowup.exceptionalIdeal
          (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker).subschemeι =
      zeroSection (truncationConeData (yGrading R m n)) ≫ (coneStacksBlowupIso R m n).hom :=
  IsPullback.isoIsPullback_hom_fst _ _ (isPullback_coneZeroSection_blowUp R m n)
    (Stacks.Blowup.isPullback_exceptionalToCentre (Stacks.MoreMorphisms.coordinateEmbedding R m n))

/-! ### Clauses (1) and (2) of Stacks 0FUR for the coordinate centre -/

/-- The blowing-up morphism of the coordinate centre is quasi-compact. -/
theorem quasiCompact_blowUpToBase_coordinateEmbedding :
    QuasiCompact (Stacks.Blowup.blowUpToBase
      (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker) :=
  Stacks.Blowup.quasiCompact_blowUpToBase_of_fg _ (Stacks.DeRham.isFiniteType_coordinateIdeal R m n)

/-- **Clause (1) of [Stacks, Tag 0FUR] for `Stacks.Blowup.blowUp` along the coordinate centre**:
`Ω^a_{X/S} ⟶ b_*Ω^a_{X'/S}` is an isomorphism, for `n ≥ 1`. -/
theorem isIso_blowupFormsDirectImage_coordinateEmbedding (hn : 1 ≤ n) (a : ℕ) :
    IsIso (blowupFormsDirectImage (Stacks.MoreMorphisms.coordinateEmbedding R m n)
      (Stacks.DeRham.coordinateAmbientToBase R m n) (a : ℤ)) := by
  have := Stacks.DeRham.isIso_coordinateBlowupFormsDirectImage R m n hn a
  have H : IsPullback (AlgebraicGeometry.blowUpIso (Stacks.MoreMorphisms.coordinateIdeal R m n)).inv
      (Stacks.Blowup.blowUpToBase (Stacks.MoreMorphisms.coordinateEmbedding R m n).ker)
      (Stacks.DeRham.coordinateBlowupToAmbient R m n) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨((Iso.inv_comp_eq _).2
      (AlgebraicGeometry.blowUpIso_hom_blowUpToBase _).symm).trans (Category.comp_id _).symm⟩
  rw [blowupFormsDirectImage_eq]
  exact Scheme.Hom.isIso_formsDirectImageComparison_of_isPullback H
    (Stacks.DeRham.coordinateAmbientToBase R m n) (Stacks.DeRham.coordinateAmbientToBase R m n)
    (𝟙 _) (by simp) a

/-- **Clause (2) of [Stacks, Tag 0FUR] for the exceptional divisor of `Stacks.Blowup.blowUp`
along the coordinate centre**: `Ω^a_{Z/S} ⟶ p_*Ω^a_{E/S}` is an isomorphism, for `n ≥ 1`. -/
theorem isIso_exceptionalFormsDirectImage_coordinateEmbedding (hn : 1 ≤ n) (a : ℕ) :
    IsIso (exceptionalFormsDirectImage (Stacks.MoreMorphisms.coordinateEmbedding R m n)
      (Stacks.DeRham.coordinateAmbientToBase R m n) (a : ℤ)) := by
  have := isIso_coneBundleFormsDirectImage R m n hn a
  have := quasiCompact_blowUpToBase_coordinateEmbedding R m n
  have := quasiCompact_exceptionalToCentre (Stacks.MoreMorphisms.coordinateEmbedding R m n)
  have H : IsPullback (coneExceptionalIso R m n).hom (coneBundleToCentre R m n)
      (Stacks.Blowup.exceptionalToCentre (Stacks.MoreMorphisms.coordinateEmbedding R m n))
      (coneCentreIso R m n).inv :=
    IsPullback.of_horiz_isIso ⟨coneExceptionalIso_hom_comp_toCentre R m n⟩
  have he : (coneCentreIso R m n).inv ≫ (Stacks.MoreMorphisms.coordinateEmbedding R m n ≫
      Stacks.DeRham.coordinateAmbientToBase R m n) = coneCentreToBase R m n ≫ 𝟙 _ := by
    have h : (coneCentreIso R m n).inv ≫ Stacks.MoreMorphisms.coordinateEmbedding R m n =
        coneCentreToAmbient R m n := by
      rw [Iso.inv_comp_eq, coneCentreIso_hom_comp]
    rw [Category.comp_id, ← Category.assoc, h]
  have := Scheme.Hom.isIso_pullback_map_formsDirectImageComparison_of_isPullback H
    (Stacks.MoreMorphisms.coordinateEmbedding R m n ≫ Stacks.DeRham.coordinateAmbientToBase R m n)
    (coneCentreToBase R m n) (𝟙 _) he a
  have := isEquivalence_pullback_of_isIso (coneCentreIso R m n).inv
  rw [exceptionalFormsDirectImage_eq]
  exact isIso_of_reflects_iso _ (Scheme.Modules.pullback (coneCentreIso R m n).inv)

end Stacks.DeRham.CoordinateCone

