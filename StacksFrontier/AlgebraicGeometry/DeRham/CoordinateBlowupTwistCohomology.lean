module

public import StacksFrontier.AlgebraicGeometry.DeRham.CoordinateBlowupLaurent
public import StacksFrontier.AlgebraicGeometry.Divisors.CanonicalSectionZeroScheme
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafSections
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.Topology.Sheaves.Cohomology.CechOfSheavesOfModules.RestrictionExactness
public import StacksFrontier.AlgebraicGeometry.ProjectiveCohomology.CechCohomologyIso
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeData
public import StacksFrontier.AlgebraicGeometry.DivisorSum.Basic

/-!
# The cohomology of `𝒪_L(iE)` on the coordinate blowup

Fix a ring `R`, integers `m, n`, the blowup `b : L ⟶ X = 𝐀^{m+n}_R` along `y₁ = ⋯ = y_n = 0`
and its exceptional divisor `E`. This file computes the cohomology of `𝒪_L(iE)` for
`0 ≤ i ≤ n - 1` with the Čech complex of the `n` standard charts of `L`.

Every section of `𝒪_L(iE)` over an intersection of charts is determined by its restriction to
the open `W₀ = b⁻¹(D(y₁ ⋯ y_n))`, where `𝒪_L(iE)` is trivialized by the canonical section and
the functions are the Laurent polynomials in the `y`'s. The restrictions of the sections over
the intersection selected by a tuple of chart indices are exactly the Laurent polynomials
supported on that tuple, in the sense of `Stacks.CechFinsupp.supported`, so the Čech complex is
exact in positive degrees by `Stacks.CechFinsupp.exists_cechCoboundary_eq`.

## Main definitions

* `Stacks.DeRham.CoordinateCech.twistSheaf`: `𝒪_L(iE)`.
* `Stacks.DeRham.CoordinateCech.puncturedValue`: a section of `𝒪_L(iE)` over `W₀`, read as a
  Laurent polynomial.

## Main results

* `Stacks.DeRham.CoordinateCech.range_puncturedValue_res`: the restrictions to `W₀` of the
  sections over an intersection of charts are the supported Laurent polynomials.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.DeRham.CoordinateCech

open Stacks.Divisors

variable (R : Type u) [CommRing R] (m n : ℕ)

/-! ### The exceptional ideal on an intersection of charts and on `W₀` -/

/-- An intersection of charts, as an affine open: the basic open of the product of the ratios in
the first chart of the tuple. -/
abbrev tupleOpen {p : ℕ} (x : Fin (p + 1) → Fin n) : (coordinateBlowup R m n).affineOpens :=
  ⟨(coordinateBlowup R m n).basicOpen (tupleRatio R m n x),
    (isAffineOpen_chart R m n (x 0)).basicOpen _⟩

/-- The local equation of the exceptional divisor on an intersection of charts: the pullback of
the coordinate `y_j` of the first chart `j = x₀` of the tuple. -/
def tupleGen {p : ℕ} (x : Fin (p + 1) → Fin n) : Γ(coordinateBlowup R m n, (tupleOpen R m n x).1) :=
  ((coordinateBlowup R m n).presheaf.map
    (homOfLE ((coordinateBlowup R m n).basicOpen_le (tupleRatio R m n x))).op).hom
    ((chartMap R m n (x 0)).hom (coord R m n (x 0)))

/-- Restricting the pullback of a function from the first chart is pulling it back. -/
theorem appLE_tupleOpen {p : ℕ} (x : Fin (p + 1) → Fin n) (r : Γ(coordinateAmbient R m n, ⊤)) :
    ((coordinateBlowupToAmbient R m n).appLE ⊤ (tupleOpen R m n x).1 le_top).hom r =
      ((coordinateBlowup R m n).presheaf.map
        (homOfLE ((coordinateBlowup R m n).basicOpen_le (tupleRatio R m n x))).op).hom
        ((chartMap R m n (x 0)).hom r) := by
  rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]

/-- **On an intersection of charts the exceptional ideal is generated by `y_{x₀}`.** -/
theorem ideal_tupleOpen {p : ℕ} (x : Fin (p + 1) → Fin n) :
    (coordinateExceptional R m n).ideal (tupleOpen R m n x) =
      Ideal.span {tupleGen R m n x} := by
  rw [coordinateExceptional, exceptionalIdeal,
    Stacks.IdealSheaf.ideal_comap_appLE _ _ (Stacks.MoreMorphisms.topAffineOpen R m n)
      (tupleOpen R m n x) le_top, ideal_top_eq_span, Ideal.map_span]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
    refine Ideal.mem_span_singleton'.2 ⟨((coordinateBlowup R m n).presheaf.map
      (homOfLE ((coordinateBlowup R m n).basicOpen_le (tupleRatio R m n x))).op).hom
        (ratio R m n (x 0) k), ?_⟩
    show _ = ((coordinateBlowupToAmbient R m n).appLE ⊤ (tupleOpen R m n x).1 le_top).hom _
    rw [appLE_tupleOpen, chartMap_coord_eq, map_mul]
    rfl
  · rintro _ rfl
    exact Ideal.subset_span ⟨_, ⟨x 0, rfl⟩, (appLE_tupleOpen R m n x _).trans rfl⟩

/-- The local equation `y_{x₀}` of the exceptional divisor is a nonzerodivisor on an
intersection of charts. -/
theorem tupleGen_mem_nonZeroDivisors {p : ℕ} (x : Fin (p + 1) → Fin n) :
    tupleGen R m n x ∈ nonZeroDivisors Γ(coordinateBlowup R m n, (tupleOpen R m n x).1) := by
  have := (isAffineOpen_chart R m n (x 0)).isLocalization_basicOpen (tupleRatio R m n x)
  show _ ∈ nonZeroDivisors Γ(coordinateBlowup R m n,
    (coordinateBlowup R m n).basicOpen (tupleRatio R m n x))
  exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers (tupleRatio R m n x)) _
    (Submonoid.mem_map_of_mem _ (chartMap_coord_self_mem_nonZeroDivisors R m n (x 0)))

/-- `W₀` is the basic open in the chart `L_j` of the pullback of `y₁ ⋯ y_n`. -/
theorem punctured_eq_basicOpen (hn : 0 < n) (j : Fin n) :
    punctured R m n = (coordinateBlowup R m n).basicOpen
      ((chartMap R m n j).hom (coordProd R m n)) := by
  ext x
  show x ∈ punctured R m n ↔ x ∈ (coordinateBlowup R m n).basicOpen _
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · have hxj := punctured_le_chart R m n hn j hx
    rw [(coordinateBlowup R m n).mem_basicOpen _ x hxj,
      germ_blowUpChartMap (Stacks.MoreMorphisms.coordinateIdeal R m n)
        (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j) x hxj]
    exact (((coordinateAmbient R m n).mem_basicOpen (U := ⊤) _ _ trivial).1 hx).map _
  · have hxj : x ∈ chart R m n j := (coordinateBlowup R m n).basicOpen_le _ hx
    rw [(coordinateBlowup R m n).mem_basicOpen _ x hxj,
      germ_blowUpChartMap (Stacks.MoreMorphisms.coordinateIdeal R m n)
        (Stacks.MoreMorphisms.topAffineOpen R m n) (centreSection R m n j) x hxj] at hx
    exact ((coordinateAmbient R m n).mem_basicOpen (U := ⊤) _ _ trivial).2
      (isUnit_of_map_unit _ _ hx)

/-- `W₀`, as an affine open. -/
abbrev puncturedAffine (hn : 0 < n) : (coordinateBlowup R m n).affineOpens :=
  ⟨punctured R m n, punctured_eq_basicOpen R m n hn ⟨0, hn⟩ ▸
    (isAffineOpen_chart R m n ⟨0, hn⟩).basicOpen _⟩

/-- Pulling a function on `X` back to `W₀` and reading it on `D(y₁ ⋯ y_n)` gives the function. -/
theorem puncturedEquiv_appLE (hn : 0 < n) (r : Γ(coordinateAmbient R m n, ⊤)) :
    puncturedEquiv R m n hn (((coordinateBlowupToAmbient R m n).appLE ⊤ (punctured R m n)
      le_top).hom r) = toFrac R m n r := by
  rw [puncturedEquiv, RingEquiv.symm_apply_eq]
  show _ = ((coordinateBlowupToAmbient R m n).app _).hom (toFrac R m n r)
  rw [← CommRingCat.comp_apply, Scheme.Hom.app_eq_appLE, Scheme.Hom.map_appLE]

/-- **The exceptional ideal is the unit ideal on `W₀`.** -/
theorem ideal_puncturedAffine (hn : 0 < n) :
    (coordinateExceptional R m n).ideal (puncturedAffine R m n hn) = ⊤ := by
  rw [coordinateExceptional, exceptionalIdeal,
    Stacks.IdealSheaf.ideal_comap_appLE _ _ (Stacks.MoreMorphisms.topAffineOpen R m n)
      (puncturedAffine R m n hn) le_top]
  refine Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _
    (Stacks.MoreMorphisms.coordinateSection_mem R m n ⟨0, hn⟩)) ?_
  have h := (isUnit_toFrac_coord R m n ⟨0, hn⟩).map (puncturedEquiv R m n hn).symm
  rwa [← puncturedEquiv_appLE R m n hn, RingEquiv.symm_apply_apply] at h

/-! ### `𝒪_L(iE)` and its trivializations -/

/-- **The sheaf `𝒪_L(iE)`.** -/
abbrev twistSheaf (i : ℕ) :
    SheafOfModules.{u} (structureSheafRing (coordinateBlowup R m n).toRingedSpace) :=
  invertibleSheaf' (coordinateExceptional R m n ^ i)

/-- The trivialization of the ideal of `iE` on an intersection of charts, by `y_{x₀}ⁱ`. -/
def tupleBasis (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n) :=
  dualBasisOneOfPrincipal (coordinateExceptional R m n ^ i) (tupleOpen R m n x)
    (by rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, ideal_tupleOpen,
      Ideal.span_singleton_pow])
    (pow_mem (tupleGen_mem_nonZeroDivisors R m n x) i)

/-- The trivialization of the ideal of `iE` on `W₀`, where it is the unit ideal. -/
def puncturedBasis (hn : 0 < n) (i : ℕ) :=
  dualBasisOneOfPrincipal (coordinateExceptional R m n ^ i) (puncturedAffine R m n hn)
    (f := 1) (by
      rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, ideal_puncturedAffine, Ideal.top_pow,
        Ideal.span_singleton_one])
    (Submonoid.one_mem _)

/-- The trivializing section of the ideal of `iE` on an intersection of charts is `y_{x₀}ⁱ`. -/
theorem idealSheafSection_tupleBasis_e (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    idealSheafSection _ (tupleBasis R m n i x).e = tupleGen R m n x ^ i := by
  unfold tupleBasis dualBasisOneOfPrincipal
  exact Exists.choose_spec ((mem_ideal_iff_exists_idealSheafSection _ (tupleOpen R m n x) _).1
    (by
      rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, ideal_tupleOpen,
        Ideal.span_singleton_pow]
      exact Ideal.mem_span_singleton_self _))

/-- The trivializing section of the ideal of `iE` on `W₀` is `1`. -/
theorem idealSheafSection_puncturedBasis_e (hn : 0 < n) (i : ℕ) :
    idealSheafSection _ (puncturedBasis R m n hn i).e = 1 := by
  unfold puncturedBasis dualBasisOneOfPrincipal
  exact Exists.choose_spec ((mem_ideal_iff_exists_idealSheafSection _ (puncturedAffine R m n hn)
    _).1 (by
      rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, ideal_puncturedAffine, Ideal.top_pow]
      exact Submodule.mem_top))

/-- `W₀` lies in every intersection of charts. -/
theorem punctured_le_tupleOpen (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    punctured R m n ≤ (tupleOpen R m n x).1 :=
  punctured_le_basicOpen_tupleRatio R m n hn x

/-- Restricting a section of `𝒪_L(iE)` from an intersection of charts to `W₀`. -/
abbrev resTwist (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    (twistSheaf R m n i).val.obj (op (tupleOpen R m n x).1) →
      (twistSheaf R m n i).val.obj (op (punctured R m n)) :=
  ((twistSheaf R m n i).val.map (homOfLE (punctured_le_tupleOpen R m n hn x)).op).hom

/-- **A section of `𝒪_L(iE)` over `W₀`, read as a Laurent polynomial**: the trivialization by the
canonical section, then the identification of the functions on `W₀` with Laurent polynomials. -/
def puncturedFrac (hn : 0 < n) (i : ℕ)
    (ν : (twistSheaf R m n i).val.obj (op (punctured R m n))) : Frac R m n :=
  puncturedEquiv R m n hn (@id Γ(coordinateBlowup R m n, punctured R m n)
    (Stacks.SheafOfModules.dualEval ν (puncturedBasis R m n hn i).e))

/-- A section of `𝒪_L(iE)` over `W₀`, as a Laurent polynomial. -/
def puncturedValue (hn : 0 < n) (i : ℕ)
    (ν : (twistSheaf R m n i).val.obj (op (punctured R m n))) :
    AddMonoidAlgebra R ((Fin m ⊕ Fin n) →₀ ℤ) :=
  laurent R m n (puncturedFrac R m n hn i ν)

/-- Restricting a function from an intersection of charts to `W₀`. -/
abbrev resFun (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    Γ(coordinateBlowup R m n, (tupleOpen R m n x).1) →+*
      Γ(coordinateBlowup R m n, punctured R m n) :=
  ((coordinateBlowup R m n).presheaf.map (homOfLE (punctured_le_tupleOpen R m n hn x)).op).hom

/-- The functions on an open of the blowup, in the spelling of the sheaf of rings that sheaves
of modules are written over. -/
abbrev Fn (W : (coordinateBlowup R m n).Opens) : Type u :=
  (Stacks.SheafOfModules.TensorSheafification.structureSheaf (coordinateBlowup R m n).presheaf
    (structureSheafRing (coordinateBlowup R m n).toRingedSpace).property).obj.obj (op W)

/-- The restriction of the trivializing section of the ideal of `iE` from an intersection of
charts to `W₀` is `y_{x₀}ⁱ` times the trivializing section there. -/
theorem res_tupleBasis_e (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    ((idealSheafOfModules (coordinateExceptional R m n ^ i)).val.map
        (homOfLE (punctured_le_tupleOpen R m n hn x)).op).hom (tupleBasis R m n i x).e =
      Stacks.SheafOfModules.smulSectionMap (𝒪 := (coordinateBlowup R m n).sheaf.obj)
        (h𝒪 := (structureSheafRing (coordinateBlowup R m n).toRingedSpace).property)
        (puncturedBasis R m n hn i).e (resFun R m n hn x (tupleGen R m n x) ^ i) := by
  refine idealSheafSection_injective (coordinateExceptional R m n ^ i)
    (V := punctured R m n) ?_
  have h1 := idealSheafSection_resSection (coordinateExceptional R m n ^ i)
    (op (Over.mk (homOfLE (punctured_le_tupleOpen R m n hn x)))) (tupleBasis R m n i x).e
  have h2 := idealSheafSection_smulSectionMap (coordinateExceptional R m n ^ i)
    (V := punctured R m n) (puncturedBasis R m n hn i).e
    (resFun R m n hn x (tupleGen R m n x) ^ i)
  refine h1.trans (Eq.trans ?_ (h2.trans ((congrArg (_ * ·)
    (idealSheafSection_puncturedBasis_e R m n hn i)).trans (mul_one _))).symm)
  exact (congrArg _ (idealSheafSection_tupleBasis_e R m n i x)).trans (map_pow _ _ _)

/-- **The trivializations on an intersection of charts and on `W₀` differ by `y_{x₀}ⁱ`.**
For a section `μ` of `𝒪_L(iE)` over an intersection of charts, its coordinate on `W₀` times the
restriction of `y_{x₀}ⁱ` is the restriction of its coordinate on the intersection. -/
theorem dualEval_resTwist (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (μ : (twistSheaf R m n i).val.obj (op (tupleOpen R m n x).1)) :
    resFun R m n hn x (tupleGen R m n x) ^ i *
        @id Γ(coordinateBlowup R m n, punctured R m n)
          (Stacks.SheafOfModules.dualEval (resTwist R m n hn i x μ)
            (puncturedBasis R m n hn i).e) =
      resFun R m n hn x (@id Γ(coordinateBlowup R m n, (tupleOpen R m n x).1)
        (Stacks.SheafOfModules.dualEval μ (tupleBasis R m n i x).e)) := by
  have hnat := Stacks.SheafOfModules.evalSection_naturality (coordinateBlowup R m n).presheaf
    (idealSheafOfModules (coordinateExceptional R m n ^ i)).val
    (SheafOfModules.unit (Stacks.SheafOfModules.TensorSheafification.structureSheaf
      (coordinateBlowup R m n).presheaf
      (structureSheafRing (coordinateBlowup R m n).toRingedSpace).property)).val
    (homOfLE (punctured_le_tupleOpen R m n hn x)).op μ (tupleBasis R m n i x).e
  have hsmul := Stacks.SheafOfModules.evalSection_smul_right (coordinateBlowup R m n).presheaf
    (idealSheafOfModules (coordinateExceptional R m n ^ i)).val
    (SheafOfModules.unit (Stacks.SheafOfModules.TensorSheafification.structureSheaf
      (coordinateBlowup R m n).presheaf
      (structureSheafRing (coordinateBlowup R m n).toRingedSpace).property)).val
    (op (punctured R m n)) (resFun R m n hn x (tupleGen R m n x) ^ i)
    (resTwist R m n hn i x μ) (puncturedBasis R m n hn i).e
  have hres := congrArg (Stacks.SheafOfModules.evalSection (coordinateBlowup R m n).presheaf
    (idealSheafOfModules (coordinateExceptional R m n ^ i)).val
    (SheafOfModules.unit (Stacks.SheafOfModules.TensorSheafification.structureSheaf
      (coordinateBlowup R m n).presheaf
      (structureSheafRing (coordinateBlowup R m n).toRingedSpace).property)).val
    (op (punctured R m n)) (resTwist R m n hn i x μ)) (res_tupleBasis_e R m n hn i x)
  exact hsmul.symm.trans (hres.symm.trans hnat)

/-- `y_{x₀}` restricted to `W₀` and read on `D(y₁ ⋯ y_n)` is `y_{x₀}`. -/
theorem puncturedEquiv_resFun_tupleGen (hn : 0 < n) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    puncturedEquiv R m n hn (resFun R m n hn x (tupleGen R m n x)) =
      toFrac R m n (coord R m n (x 0)) := by
  have := toFracOf_res R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)
    ((coordinateBlowup R m n).basicOpen_le (tupleRatio R m n x))
    ((chartMap R m n (x 0)).hom (coord R m n (x 0)))
  rwa [toFracOf_chartMap] at this

/-- **The comparison of the two trivializations, read on `D(y₁ ⋯ y_n)`.** -/
theorem puncturedEquiv_dualEval_resTwist (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (μ : (twistSheaf R m n i).val.obj (op (tupleOpen R m n x).1)) :
    puncturedFrac R m n hn i (resTwist R m n hn i x μ) * toFrac R m n (coord R m n (x 0)) ^ i =
      toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x)
        (@id Γ(coordinateBlowup R m n, (tupleOpen R m n x).1)
          (Stacks.SheafOfModules.dualEval μ (tupleBasis R m n i x).e)) := by
  have h := congrArg (puncturedEquiv R m n hn) (dualEval_resTwist R m n hn i x μ)
  rwa [map_mul, map_pow, puncturedEquiv_resFun_tupleGen, mul_comm] at h

/-- The section `z` times the trivializing coordinate on an intersection of charts. -/
def tupleSection (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (z : Γ(coordinateBlowup R m n, (tupleOpen R m n x).1)) :
    (twistSheaf R m n i).val.obj (op (tupleOpen R m n x).1) :=
  Stacks.SheafOfModules.smulSectionMap (𝒪 := (coordinateBlowup R m n).presheaf)
    (h𝒪 := (structureSheafRing (coordinateBlowup R m n).toRingedSpace).property)
    (L := twistSheaf R m n i) (tupleBasis R m n i x).lam z

/-- The coordinate of `tupleSection R m n i x z` in the trivialization on the intersection of
charts is `z`. -/
theorem dualEval_tupleSection (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (z : Γ(coordinateBlowup R m n, (tupleOpen R m n x).1)) :
    @id Γ(coordinateBlowup R m n, (tupleOpen R m n x).1)
      (Stacks.SheafOfModules.dualEval (tupleSection R m n i x z) (tupleBasis R m n i x).e) = z :=
  (Stacks.SheafOfModules.evalSection_smul_left _ _ _ _ z _ _).trans
    ((congrArg (z * ·) (tupleBasis R m n i x).eval_self).trans (mul_one z))

/-- **The restriction to `W₀` of a section over an intersection of charts is a supported Laurent
polynomial.** -/
theorem coeff_puncturedValue_resTwist_mem (hn : 0 < n) (i : ℕ) {p : ℕ}
    (x : Fin (p + 1) → Fin n) (μ : (twistSheaf R m n i).val.obj (op (tupleOpen R m n x).1)) :
    (puncturedValue R m n hn i (resTwist R m n hn i x μ)).coeff ∈
      Stacks.CechFinsupp.supported (twistOk m n i) (negSet.{u} m n)
        (Set.range (ULift.up ∘ x)) :=
  coeff_laurent_mem_supported R m n i x ((congrArg (IsChartFraction R m n x)
    (puncturedEquiv_dualEval_resTwist R m n hn i x μ)).mpr
      (((toFracOf_basicOpen_tupleRatio R m n hn x).2 _).1 ⟨_, rfl⟩))

/-- **Every supported Laurent polynomial is the restriction to `W₀` of a section over the
intersection of charts.** -/
theorem exists_coeff_puncturedValue_resTwist_eq (hn : 0 < n) (i : ℕ) {p : ℕ}
    (x : Fin (p + 1) → Fin n) (g : ((Fin m ⊕ Fin n) →₀ ℤ) →₀ R)
    (hg : g ∈ Stacks.CechFinsupp.supported (twistOk m n i) (negSet.{u} m n)
      (Set.range (ULift.up ∘ x))) :
    ∃ μ, (puncturedValue R m n hn i (resTwist R m n hn i x μ)).coeff = g := by
  obtain ⟨h, hlg, hh⟩ := exists_laurent_eq R m n i x g hg
  obtain ⟨z, hz⟩ := ((toFracOf_basicOpen_tupleRatio R m n hn x).2 _).2 hh
  refine ⟨tupleSection R m n i x z, ?_⟩
  have key := (puncturedEquiv_dualEval_resTwist R m n hn i x (tupleSection R m n i x z)).trans
    ((congrArg (toFracOf R m n hn (punctured_le_basicOpen_tupleRatio R m n hn x))
      (dualEval_tupleSection R m n i x z)).trans hz)
  have hu : IsUnit (toFrac R m n (coord R m n (x 0)) ^ i) := (isUnit_toFrac_coord R m n _).pow i
  exact (congrArg (fun t => (laurent R m n t).coeff) (hu.mul_left_inj.1 key)).trans hlg

/-- **Restriction to `W₀` is injective on the sections over an intersection of charts.** -/
theorem resTwist_injective (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    Function.Injective (resTwist R m n hn i x) := by
  intro μ μ' hμμ'
  have key := puncturedEquiv_dualEval_resTwist R m n hn i x
  have h1 := (key μ).symm.trans (hμμ' ▸ key μ')
  exact dualEval_injective_of_dualBasisOne _ (tupleBasis R m n i x)
    ((toFracOf_basicOpen_tupleRatio R m n hn x).1 h1)

/-- The coordinate of a section over `W₀` in the trivialization there, as an additive map. -/
def puncturedCoord (hn : 0 < n) (i : ℕ) :
    (twistSheaf R m n i).val.obj (op (punctured R m n)) →+
      Γ(coordinateBlowup R m n, punctured R m n) :=
  AddMonoidHom.mk' (fun ν => @id Γ(coordinateBlowup R m n, punctured R m n)
      (Stacks.SheafOfModules.dualEval ν (puncturedBasis R m n hn i).e))
    (fun ν ν' => Stacks.SheafOfModules.evalSection_add_left _ _ _ _ ν ν' _)

/-- Reading a section of `𝒪_L(iE)` over `W₀` as a Laurent polynomial, as an additive map. -/
def puncturedValueHom (hn : 0 < n) (i : ℕ) :
    (twistSheaf R m n i).val.obj (op (punctured R m n)) →+ (((Fin m ⊕ Fin n) →₀ ℤ) →₀ R) :=
  (AddMonoidAlgebra.coeffAddEquiv.toAddMonoidHom.comp (laurent R m n).toAddMonoidHom).comp
    ((puncturedEquiv R m n hn).toAddMonoidHom.comp (puncturedCoord R m n hn i))

/-- `puncturedValueHom` sends a section to the coefficients of its Laurent polynomial. -/
theorem puncturedValueHom_apply (hn : 0 < n) (i : ℕ)
    (ν : (twistSheaf R m n i).val.obj (op (punctured R m n))) :
    puncturedValueHom R m n hn i ν = (puncturedValue R m n hn i ν).coeff := rfl

/-- **Reading a section over `W₀` as a Laurent polynomial is injective.** -/
theorem puncturedValueHom_injective (hn : 0 < n) (i : ℕ) :
    Function.Injective (puncturedValueHom R m n hn i) := by
  intro ν ν' h
  have h1 : laurent R m n (puncturedFrac R m n hn i ν) =
      laurent R m n (puncturedFrac R m n hn i ν') :=
    AddMonoidAlgebra.coeffAddEquiv.injective h
  exact dualEval_injective_of_dualBasisOne _ (puncturedBasis R m n hn i)
    ((puncturedEquiv R m n hn).injective (laurent_injective R m n h1))

/-! ### The Čech complex of the standard charts -/

section Cech

open Stacks.CategoryTheory.CechComplex Stacks.Cohomology.CechSheaf
open Stacks.Cohomology.Basis (res res_res res_id)
open CategoryTheory.Limits

/-- The `n` standard charts, indexed in the universe of the blowup. -/
abbrev chartCover : ULift.{u} (Fin n) → (coordinateBlowup R m n).Opens :=
  fun k => chart R m n k.down

/-- The standard charts cover the blowup. -/
theorem iSup_chartCover (hn : 0 < n) :
    (⊤ : (coordinateBlowup R m n).Opens) = ⨆ k, chartCover R m n k := by
  rw [iSup_ulift]
  exact (iSup_chart R m n hn).symm

/-- The intersection of charts selected by a tuple is the intersection open of the tuple. -/
theorem inter_chartCover {p : ℕ} (x : Fin (p + 1) → ULift.{u} (Fin n)) :
    inter (chartCover R m n) x = (tupleOpen R m n (fun a => (x a).down)).1 := by
  rw [inter_eq_iInf]
  exact iInf_chart R m n (fun a => (x a).down)

/-- Restriction to `W₀` in the sheaf of abelian groups underlying `𝒪_L(iE)` is `resTwist`. -/
theorem res_eq_resTwist (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (μ : (twistSheaf R m n i).val.obj (op (tupleOpen R m n x).1)) :
    res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
      (punctured_le_tupleOpen R m n hn x) μ = resTwist R m n hn i x μ := rfl

/-- `W₀` lies in every standard chart. -/
theorem punctured_le_chartCover (hn : 0 < n) (k : ULift.{u} (Fin n)) :
    punctured R m n ≤ chartCover R m n k :=
  punctured_le_chart R m n hn k.down

/-- Restricting from an intersection of charts to `W₀` passes through the intersection open. -/
theorem res_inter_punctured (hn : 0 < n) (i : ℕ) {r : ℕ} (x : Fin (r + 1) → ULift.{u} (Fin n))
    (s : ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (inter (chartCover R m n) x)))) :
    res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
        (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) x) s =
      res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
        (punctured_le_tupleOpen R m n hn (fun a => (x a).down))
        (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
          (inter_chartCover R m n x).ge s) :=
  (Stacks.Cohomology.Basis.res_res
    (abSections (divisorSheaf (coordinateExceptional R m n ^ i))) _ _ s).symm

/-- Restricting to the intersection open and back is the identity. -/
theorem res_inter_back (i : ℕ) {r : ℕ} (x : Fin (r + 1) → ULift.{u} (Fin n))
    (s : ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (inter (chartCover R m n) x)))) :
    res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
        (inter_chartCover R m n x).le
        (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
          (inter_chartCover R m n x).ge s) = s :=
  (Stacks.Cohomology.Basis.res_res _ _ _ s).trans (Stacks.Cohomology.Basis.res_id _ s)

/-- The range of `ULift.up ∘ fun a => (y a).down` is the range of `y`. -/
theorem range_up_down {r : ℕ} (y : Fin (r + 1) → ULift.{u} (Fin n)) :
    Set.range (ULift.up ∘ fun a => (y a).down) = Set.range y := rfl

/-- `puncturedValueHom`, on the sections of the underlying sheaf of abelian groups. -/
def puncturedValueAb (hn : 0 < n) (i : ℕ) :
    ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (punctured R m n))) →+ (((Fin m ⊕ Fin n) →₀ ℤ) →₀ R) where
  toFun ν := puncturedValueHom R m n hn i ν
  map_zero' := (puncturedValueHom R m n hn i).map_zero
  map_add' a b := (puncturedValueHom R m n hn i).map_add a b

/-- `puncturedValueAb` is injective. -/
theorem puncturedValueAb_injective (hn : 0 < n) (i : ℕ) :
    Function.Injective (puncturedValueAb R m n hn i) :=
  puncturedValueHom_injective R m n hn i

/-- The supports of the restrictions to `W₀`, in the spelling of the sheaf of abelian groups. -/
theorem puncturedValueAb_tuple_mem (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (t : ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (tupleOpen R m n x).1))) :
    puncturedValueAb R m n hn i (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
      (punctured_le_tupleOpen R m n hn x) t) ∈
      Stacks.CechFinsupp.supported (twistOk m n i) (negSet.{u} m n) (Set.range (ULift.up ∘ x)) :=
  coeff_puncturedValue_resTwist_mem R m n hn i x t

/-- Every supported Laurent polynomial is read off a restriction to `W₀`, in the spelling of the
sheaf of abelian groups. -/
theorem exists_puncturedValueAb_tuple (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n)
    (g : ((Fin m ⊕ Fin n) →₀ ℤ) →₀ R)
    (hg : g ∈ Stacks.CechFinsupp.supported (twistOk m n i) (negSet.{u} m n)
      (Set.range (ULift.up ∘ x))) :
    ∃ t : ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (tupleOpen R m n x).1)),
      puncturedValueAb R m n hn i (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
        (punctured_le_tupleOpen R m n hn x) t) = g := by
  obtain ⟨μ, hμ⟩ := exists_coeff_puncturedValue_resTwist_eq R m n hn i x g hg
  exact ⟨μ, hμ⟩

/-- Restriction to `W₀` is injective, in the spelling of the sheaf of abelian groups. -/
theorem res_tuple_injective (hn : 0 < n) (i : ℕ) {p : ℕ} (x : Fin (p + 1) → Fin n) :
    Function.Injective (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
      (punctured_le_tupleOpen R m n hn x)) :=
  resTwist_injective R m n hn i x

/-- Restricting from an intersection of charts to `W₀` is injective. -/
theorem res_inter_injective (hn : 0 < n) (i : ℕ) {r : ℕ} (x : Fin (r + 1) → ULift.{u} (Fin n)) :
    Function.Injective (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
      (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) x)) := by
  intro s s' hss'
  rw [res_inter_punctured R m n hn i x s, res_inter_punctured R m n hn i x s'] at hss'
  have h2 := congrArg (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
    (inter_chartCover R m n x).le) (res_tuple_injective R m n hn i _ hss')
  exact (res_inter_back R m n i x s).symm.trans (h2.trans (res_inter_back R m n i x s'))

/-- The restriction to `W₀` of a section over an intersection of charts, read as a Laurent
polynomial, is supported on the tuple. -/
theorem puncturedValueAb_res_mem (hn : 0 < n) (i : ℕ) {r : ℕ}
    (y : Fin (r + 1) → ULift.{u} (Fin n))
    (s : ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (inter (chartCover R m n) y)))) :
    puncturedValueAb R m n hn i
        (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
          (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) y) s) ∈
      Stacks.CechFinsupp.supported (twistOk m n i) (negSet.{u} m n) (Set.range y) := by
  rw [res_inter_punctured R m n hn i y s, ← range_up_down]
  exact puncturedValueAb_tuple_mem R m n hn i _ _

/-- Every supported Laurent polynomial is read off the restriction to `W₀` of a section over
the intersection of charts. -/
theorem exists_puncturedValueAb_res_eq (hn : 0 < n) (i : ℕ) {r : ℕ}
    (y : Fin (r + 1) → ULift.{u} (Fin n)) (g : ((Fin m ⊕ Fin n) →₀ ℤ) →₀ R)
    (hg : g ∈ Stacks.CechFinsupp.supported (twistOk m n i) (negSet.{u} m n) (Set.range y)) :
    ∃ s : ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
      (op (inter (chartCover R m n) y))),
      puncturedValueAb R m n hn i
        (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
          (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) y) s) =
        g := by
  rw [← range_up_down] at hg
  obtain ⟨t, ht⟩ := exists_puncturedValueAb_tuple R m n hn i _ g hg
  refine ⟨res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
    (inter_chartCover R m n y).le t, ?_⟩
  rwa [Stacks.Cohomology.Basis.res_res]

/-- Additive maps commute with the Čech coboundary. -/
private theorem map_cechCoboundary {ι G H : Type*} [AddCommGroup G] [AddCommGroup H] (f : G →+ H)
    {p : ℕ} (b : (Fin (p + 1) → ι) → G) (x : Fin (p + 2) → ι) :
    f (Stacks.CechFinsupp.cechCoboundary b x) =
      Stacks.CechFinsupp.cechCoboundary (fun y => f (b y)) x := by
  simp only [Stacks.CechFinsupp.cechCoboundary, map_sum, map_zsmul]

/-- **The combinatorial exactness of the Čech complex of `𝒪_L(iE)`, read on `W₀`.** -/
theorem exists_cechCoboundary_res (hn : 0 < n) (i : ℕ) (hi : i < n) (p : ℕ)
    (c : (Fin (p + 2) → ULift.{u} (Fin n)) →
      ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
        (op (punctured R m n))))
    (hc : ∀ x, c x ∈ Set.range (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
      (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) x)))
    (hcoc : ∀ y : Fin (p + 3) → ULift.{u} (Fin n), Stacks.CechFinsupp.cechCoboundary c y = 0) :
    ∃ b : (Fin (p + 1) → ULift.{u} (Fin n)) →
        ToType ((abSections (divisorSheaf (coordinateExceptional R m n ^ i))).obj
          (op (punctured R m n))),
      (∀ x, b x ∈ Set.range (res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
        (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) x))) ∧
      ∀ x, Stacks.CechFinsupp.cechCoboundary b x = c x := by
  have hΦ : ∀ y, puncturedValueAb R m n hn i (c y) ∈ Stacks.CechFinsupp.supported
      (twistOk m n i) (negSet.{u} m n) (Set.range y) := fun y => by
    obtain ⟨s, hs⟩ := hc y
    rw [← hs]
    exact puncturedValueAb_res_mem R m n hn i y s
  have hΦcoc : ∀ z : Fin (p + 3) → ULift.{u} (Fin n),
      Stacks.CechFinsupp.cechCoboundary (fun y => puncturedValueAb R m n hn i (c y)) z = 0 :=
    fun z => by
      rw [← map_cechCoboundary (puncturedValueAb R m n hn i) c z, hcoc, map_zero]
  obtain ⟨b', hb', hb'c⟩ := Stacks.CechFinsupp.exists_cechCoboundary_eq
    (fun e he => exists_not_mem_negSet m n hi he) _ hΦ hΦcoc
  choose s hs using fun x : Fin (p + 1) → ULift.{u} (Fin n) =>
    exists_puncturedValueAb_res_eq R m n hn i x (b' x) (hb' x)
  refine ⟨fun x => res (abSections (divisorSheaf (coordinateExceptional R m n ^ i)))
    (le_inter_of_forall_le (chartCover R m n) (punctured_le_chartCover R m n hn) x) (s x),
    fun x => ⟨s x, rfl⟩, fun x => puncturedValueAb_injective R m n hn i ?_⟩
  rw [map_cechCoboundary, show (fun y => puncturedValueAb R m n hn i _) = b' from funext hs]
  exact hb'c x

/-- **The higher cohomology of `𝒪_L(iE)` vanishes for `0 ≤ i ≤ n - 1`.** -/
theorem isZero_rightDerived_twistSheaf (hn : 0 < n) (i : ℕ) (hi : i < n) (q : ℕ) (hq : 0 < q) :
    IsZero (((Stacks.Cohomology.sectionsFunctor (coordinateBlowup R m n) ⊤).rightDerived q).obj
      (divisorSheaf (coordinateExceptional R m n ^ i))) := by
  have : IsEffectiveCartierDivisor (coordinateExceptional R m n ^ i) :=
    isEffectiveCartierDivisor_pow inferInstance i
  have : (divisorSheaf (coordinateExceptional R m n ^ i)).IsQuasicoherent :=
    isQuasicoherent_of_isInvertible _
  refine (Stacks.Cohomology.CechIso.cechHomologyIsoRightDerived (coordinateBlowup R m n) ⊤
    (chartCover R m n) (iSup_chartCover R m n hn)
    (fun r s => isAffineOpen_iInf_chart R m n (fun k => (s k).down)) _ q).isZero_iff.2 ?_
  obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 := ⟨q - 1, by omega⟩
  exact isZero_cechComplex_homology_of_res_injective ⊤ (chartCover R m n)
    (iSup_chartCover R m n hn) _ (punctured_le_chartCover R m n hn) p
    (fun r x => res_inter_injective R m n hn i x) (exists_cechCoboundary_res R m n hn i hi p)

end Cech

end Stacks.DeRham.CoordinateCech

end
