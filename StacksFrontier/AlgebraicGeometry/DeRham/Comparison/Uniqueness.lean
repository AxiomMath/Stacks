/-!
# Uniqueness of the maps of Section 0FL7 along a base change

Consider a commutative square of schemes

```
Y' --b--> Y
|f'       |f
X' --a--> X
```

which induces an isomorphism of `Y'` with an open subscheme of `X' ×_X Y`. Lemma 0H9G of the
Stacks project says that, given maps `c^p : Ω^p_{Y/ℤ} ⟶ f^*Ω^p_{X/ℤ} ⊗ det(NL_{Y/X})` satisfying
conditions (0H9C) and (0H9D), there is at most one collection of maps
`c'^p : Ω^p_{Y'/ℤ} ⟶ f'^*Ω^p_{X'/ℤ} ⊗ det(NL_{Y'/X'})` satisfying (0H9C) and (0H9D) and compatible
with `c` through the square. This file proves it.

## Main definitions

* `AlgebraicGeometry.Scheme.absoluteDifferentials`, `absoluteFormsGenerator` and
  `Hom.absoluteDifferentialsMap`: the sheaf `Ω_{Y/ℤ}`, the generator `Ω_{Y/ℤ} ⟶ Ω^1_{Y/ℤ}` and the
  canonical map `g^*Ω_{X/ℤ} ⟶ Ω_{Y/ℤ}`.
* `AlgebraicGeometry.Scheme.Hom.baseChangeDifferentialsGenerators`: the local sections of
  `Ω_{Y'/ℤ}` coming from `X'` or from `Y`.
* `AlgebraicGeometry.Scheme.Hom.IsBaseChangeWord` and `baseChangeWordSpan`: the wedges
  `ω₁ ∧ ⋯ ∧ ω_k ∧ b^*η`, and their span.

## Main results

* `AlgebraicGeometry.Scheme.Hom.isIso_relativeDifferentialsMap_of_isOpenImmersion_lift`:
  `b^*Ω_{Y/X} ≅ Ω_{Y'/X'}`.
* `AlgebraicGeometry.Scheme.Hom.relativeDifferentials_hom_ext_of_isOpenImmersion_lift` and
  `exists_mem_span_baseChangeDifferentialsGenerators`: `Ω_{Y'/ℤ}` is generated by the images of
  `f'^*Ω_{X'/ℤ}` and `b^*Ω_{Y/ℤ}`, as a statement about morphisms and locally on sections.
* `AlgebraicGeometry.Scheme.Hom.exists_map_mem_baseChangeWordSpan`: every local section of
  `Ω^n_{Y'/ℤ}` is locally in the span of the wedges.
* `AlgebraicGeometry.Scheme.Hom.GarelMaps.eq_of_isMultiplicative_of_isCompatible`: the
  uniqueness, for arbitrary `𝒪`-modules `L`, `L'` and an arbitrary map `b^*L ⟶ L'`.
* `AlgebraicGeometry.Scheme.Hom.GarelMaps.subsingleton_isCompatible_detNLPullbackIso`:
  **Lemma 0H9G** as the source states it.

## Implementation notes

Neither condition (0H9C) on the collections `c'`, nor anything about `c`, nor any hypothesis on
`f` is used by the proof: the general statement drops them, and the statement of the source is
its instance at `L = det(NL_{Y/X})`, `L' = det(NL_{Y'/X'})` and the identification of Section
0FKB.

## References

* [Stacks Project, Tag 0H9G](https://stacks.math.columbia.edu/tag/0H9G)
* [Stacks Project, Section 0FL7](https://stacks.math.columbia.edu/tag/0FL7)
-/

@[expose] public section

open CategoryTheory Limits TopologicalSpace Opposite
open Stacks.Tag01VSPullbackTensor

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' S : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

/-- For a commutative square inducing an open immersion of `Y'` into `X' ×_X Y`, the base change
map `b^*Ω_{Y/X} ⟶ Ω_{Y'/X'}` is an isomorphism. -/
theorem isIso_relativeDifferentialsMap_of_isOpenImmersion_lift (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] :
    IsIso (relativeDifferentialsMap b f f' a w) := by
  have hP : IsPullback (pullback.fst f a) (pullback.snd f a) f a := IsPullback.of_hasPullback f a
  have : IsIso (relativeDifferentialsMap (pullback.fst f a) f (pullback.snd f a) a hP.w) :=
    isIso_relativeDifferentialsMap_of_isPullback _ _ _ _ hP
  have hj : pullback.lift b f' w ≫ pullback.snd f a = f' ≫ 𝟙 X' := by
    rw [pullback.lift_snd, Category.comp_id]
  have : IsIso (relativeDifferentialsMap (pullback.lift b f' w) (pullback.snd f a) f' (𝟙 X')
      hj) :=
    isIso_relativeDifferentialsMap_of_isOpenImmersion _ _ _ _ hj
  have h3 := ((isRelativeDifferentialsMap_relativeDifferentialsMap _ _ _ _ hP.w).comp
    (isRelativeDifferentialsMap_relativeDifferentialsMap _ _ _ _ hj)).congr_left
    (pullback.lift_fst b f' w)
  rw [← h3.eq_relativeDifferentialsMap a w]
  infer_instance

/-- **The sheaf `Ω_{Y'/S}` is generated by the images of `f'^*Ω_{X'/S}` and `b^*Ω_{Y/S}`**, for a
commutative square inducing an open immersion of `Y'` into `X' ×_X Y` and compatible morphisms
to a base `S`, in the form: two morphisms out of `Ω_{Y'/S}` agreeing on both images are equal. -/
theorem relativeDifferentials_hom_ext_of_isOpenImmersion_lift (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] {pX' : X' ⟶ S} {pY : Y ⟶ S} {pY' : Y' ⟶ S}
    (hf' : f' ≫ pX' = pY' ≫ 𝟙 S) (hb : b ≫ pY = pY' ≫ 𝟙 S) {T : Y'.Modules}
    {k₁ k₂ : relativeDifferentials pY' ⟶ T}
    (h₁ : relativeDifferentialsMap f' pX' pY' (𝟙 S) hf' ≫ k₁ =
      relativeDifferentialsMap f' pX' pY' (𝟙 S) hf' ≫ k₂)
    (h₂ : relativeDifferentialsMap b pY pY' (𝟙 S) hb ≫ k₁ =
      relativeDifferentialsMap b pY pY' (𝟙 S) hb ≫ k₂) :
    k₁ = k₂ := by
  obtain rfl : pY' = f' ≫ pX' := by simpa using hf'.symm
  rw [← sub_eq_zero]
  set k := k₁ - k₂ with hkdef
  have hα : relativeDifferentialsMap f' pX' (f' ≫ pX') (𝟙 S) hf' ≫ k = 0 := by
    rw [hkdef, Preadditive.comp_sub, h₁, sub_self]
  have hβ : relativeDifferentialsMap b pY (f' ≫ pX') (𝟙 S) hb ≫ k = 0 := by
    rw [hkdef, Preadditive.comp_sub, h₂, sub_self]
  obtain ⟨hz, hex⟩ := toRelativeDifferentials_exact f' pX'
  have := toRelativeDifferentials_epi f' pX'
  have hk := hex.g_desc k hα
  set kb := hex.desc k hα
  suffices hkb : kb = 0 by
    rw [← hk]
    exact (congrArg (fun φ => f'.toRelativeDifferentials pX' ≫ φ) hkb).trans comp_zero
  have := isIso_relativeDifferentialsMap_of_isOpenImmersion_lift w
  rw [← cancel_epi (relativeDifferentialsMap b f f' a w), comp_zero]
  refine ((Scheme.Modules.pullbackPushforwardAdjunction b).homEquiv _ _).injective ?_
  refine relativeDifferentials_hom_ext fun U s => ?_
  have e₁ : ((((Scheme.Modules.pullbackPushforwardAdjunction b).homEquiv _ _)
      (relativeDifferentialsMap b f f' a w ≫ kb)).val.app (op U)).hom
        ((universalRelativeDerivation f).d s) =
      (kb.val.app (op (b ⁻¹ᵁ U))).hom
        ((universalRelativeDerivation f').d ((b.app U).hom s)) := by
    rw [Adjunction.homEquiv_naturality_right]
    exact congrArg (kb.val.app (op (b ⁻¹ᵁ U))).hom
      (relativeDifferentialsMap_app_d (f := b) (p := f) (p' := f') a w U s)
  have e₂ : (kb.val.app (op (b ⁻¹ᵁ U))).hom
        ((universalRelativeDerivation f').d ((b.app U).hom s)) =
      (k.val.app (op (b ⁻¹ᵁ U))).hom
        ((universalRelativeDerivation (f' ≫ pX')).d ((b.app U).hom s)) := by
    rw [← toRelativeDifferentials_val_app_d f' pX' (b ⁻¹ᵁ U) ((b.app U).hom s), ← hk]
    rfl
  have e₃ : (k.val.app (op (b ⁻¹ᵁ U))).hom
        ((universalRelativeDerivation (f' ≫ pX')).d ((b.app U).hom s)) =
      ((((Scheme.Modules.pullbackPushforwardAdjunction b).homEquiv _ _)
      (relativeDifferentialsMap b pY (f' ≫ pX') (𝟙 S) hb ≫ k)).val.app (op U)).hom
        ((universalRelativeDerivation pY).d s) := by
    rw [Adjunction.homEquiv_naturality_right]
    exact (congrArg (k.val.app (op (b ⁻¹ᵁ U))).hom
      (relativeDifferentialsMap_app_d (f := b) (p := pY) (p' := f' ≫ pX') (𝟙 S) hb U s)).symm
  rw [e₁, e₂, e₃, hβ]
  rfl

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.Scheme

/-- The sheaf `Ω_{Y/ℤ}` of absolute differentials of a scheme. -/
noncomputable abbrev absoluteDifferentials (Y : Scheme.{u}) : Y.Modules :=
  Hom.relativeDifferentials Y.toSpecZ

/-- The degree-one generator `Ω_{Y/ℤ} ⟶ Ω^1_{Y/ℤ}` of the algebra of absolute differential
forms. -/
noncomputable abbrev absoluteFormsGenerator (Y : Scheme.{u}) :
    Y.absoluteDifferentials ⟶ absoluteDifferentialForms Y 1 :=
  Scheme.Modules.exteriorGenerator _

/-- The canonical map `g^*Ω_{X/ℤ} ⟶ Ω_{Y/ℤ}` of a morphism of schemes `g : Y ⟶ X`. -/
noncomputable abbrev Hom.absoluteDifferentialsMap {X Y : Scheme.{u}} (g : Y ⟶ X) :
    (Scheme.Modules.pullback g).obj X.absoluteDifferentials ⟶ Y.absoluteDifferentials :=
  relativeDifferentialsMap g X.toSpecZ Y.toSpecZ (𝟙 _) (comp_toSpecZ g)

namespace Hom

variable {X Y : Scheme.{u}}

/-- Pulling back the image of a local absolute differential `t` under the degree-one generator
gives the image under the generator of the pullback of `t`. -/
theorem absoluteFormsPullback_generator (g : Y ⟶ X) (U : X.Opens)
    (t : X.absoluteDifferentials.val.obj (op U)) :
    g.absoluteFormsPullback 1 U (X.absoluteFormsGenerator.val.app (op U) t) =
      Y.absoluteFormsGenerator.val.app (op (g ⁻¹ᵁ U))
        (g.absoluteDifferentialsMap.val.app (op (g ⁻¹ᵁ U))
          (((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app _).val.app (op U) t)) :=
  Eq.trans
    (congrArg
      (((relativeDifferentialFormsComparison g X.toSpecZ Y.toSpecZ (𝟙 _)
        (comp_toSpecZ g)).app 1).val.app (op (g ⁻¹ᵁ U)))
      ((relativeDifferentialFormsPullbackIso g X.toSpecZ).map_generator (op U) t))
    (_root_.SheafOfModules.hom_congr_app_apply
      (relativeDifferentialFormsComparison_generator g X.toSpecZ Y.toSpecZ (𝟙 _)
        (comp_toSpecZ g)) (op (g ⁻¹ᵁ U))
      (modulesPullbackUnit g (relativeDifferentials X.toSpecZ) U t))

/-- **The canonical map on absolute forms in degree one is the canonical map on absolute
differentials**, read through the two degree-one generators. -/
theorem pullback_map_absoluteFormsGenerator_comp (g : Y ⟶ X) :
    (Scheme.Modules.pullback g).map X.absoluteFormsGenerator ≫ g.absoluteFormsMap 1 =
      g.absoluteDifferentialsMap ≫ Y.absoluteFormsGenerator := by
  refine Stacks.PullbackTensorCoherence.pullback_hom_ext g.toLRSHom.toShHom fun U x => ?_
  refine (congrArg ((g.absoluteFormsMap 1).val.app (op (g ⁻¹ᵁ U.unop)))
    (Scheme.Modules.unit_app_val_app_naturality g X.absoluteFormsGenerator U.unop x)).trans ?_
  exact absoluteFormsPullback_generator g U.unop x

end Hom

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

variable (f' b) in
/-- The local sections of `Ω_{Y'/ℤ}` over `W` which come from `f'^*Ω_{X'/ℤ}` or are images of
pullbacks along `b` of local sections of `Ω_{Y/ℤ}`. -/
def baseChangeDifferentialsGenerators (W : Y'.Opens) :
    Set (Y'.absoluteDifferentials.val.obj (op W)) :=
  {m | (∃ s, f'.absoluteDifferentialsMap.val.app (op W) s = m) ∨
    ∃ (W₀ : Y.Opens) (h : W ≤ b ⁻¹ᵁ W₀) (t : Y.absoluteDifferentials.val.obj (op W₀)),
      b.absoluteDifferentialsMap.val.app (op W)
        (Scheme.Modules.pullbackSection b _ W₀ W h t) = m}

/-- The generators are stable under restriction. -/
theorem map_mem_baseChangeDifferentialsGenerators {W V : Y'.Opens} (hVW : V ≤ W)
    {m : Y'.absoluteDifferentials.val.obj (op W)}
    (hm : m ∈ baseChangeDifferentialsGenerators f' b W) :
    Y'.absoluteDifferentials.val.map (homOfLE hVW).op m ∈
      baseChangeDifferentialsGenerators f' b V := by
  rcases hm with ⟨s, rfl⟩ | ⟨W₀, h, t, rfl⟩
  · exact Or.inl ⟨_, PresheafOfModules.naturality_apply _ _ s⟩
  · refine Or.inr ⟨W₀, hVW.trans h, t, ?_⟩
    refine (congrArg (b.absoluteDifferentialsMap.val.app (op V))
      (Stacks.Conormal.pullbackSection_restrict_target b _ W₀ W V h hVW t).symm).trans ?_
    exact PresheafOfModules.naturality_apply _ _ _

/-- **Local generation of `Ω_{Y'/ℤ}`.** For a commutative square inducing an open immersion of
`Y'` into `X' ×_X Y`, every local section of `Ω_{Y'/ℤ}` is, near every point, a linear combination
of sections coming from `f'^*Ω_{X'/ℤ}` and images of pullbacks of local sections of `Ω_{Y/ℤ}`. -/
theorem exists_mem_span_baseChangeDifferentialsGenerators (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] (W : Y'.Opens)
    (m : Y'.absoluteDifferentials.val.obj (op W)) (y : Y') (hy : y ∈ W) :
    ∃ (V : Y'.Opens) (hVW : V ≤ W), y ∈ V ∧
      Y'.absoluteDifferentials.val.map (homOfLE hVW).op m ∈
        Submodule.span (Y'.ringCatSheaf.obj.obj (op V))
          (baseChangeDifferentialsGenerators f' b V) := by
  let T : ∀ V : Y'.Opensᵒᵖ, Set (Y'.absoluteDifferentials.val.obj V) :=
    fun V => baseChangeDifferentialsGenerators f' b V.unop
  have : Epi (Stacks.SheafOfModules.localSpan Y'.absoluteDifferentials T).ι := by
    refine Preadditive.epi_of_cancel_zero _ fun {Z} g hg => ?_
    have hT : ∀ (V : Y'.Opensᵒᵖ) (m : Y'.absoluteDifferentials.val.obj V), m ∈ T V →
        g.val.app V m = 0 := fun V m hm =>
      Stacks.SheafOfModules.apply_eq_zero_of_mem_localSpan g hg
        (Stacks.SheafOfModules.mem_localSpan hm)
    refine relativeDifferentials_hom_ext_of_isOpenImmersion_lift w (comp_toSpecZ f')
      (comp_toSpecZ b) ?_ ?_
    · ext V s
      exact hT (op V) _ (Or.inl ⟨s, rfl⟩)
    · refine Stacks.PullbackTensorCoherence.pullback_hom_ext b.toLRSHom.toShHom fun U x => ?_
      refine (hT _ _ (Or.inr ⟨U.unop, le_rfl, x, ?_⟩)).trans rfl
      rw [Stacks.Conormal.pullbackSection_self]
      rfl
  obtain ⟨V, i, hi, hyV⟩ := (Stacks.SheafOfModules.mem_localSpan_iff m).1
    (Stacks.SheafOfModules.mem_localSpan_of_epi_ι (T := T) m) y hy
  refine ⟨V, leOfHom i, hyV, ?_⟩
  have key : (Stacks.SheafOfModules.spanSubmodule Y'.absoluteDifferentials T).obj (op V) ≤
      Submodule.span (Y'.ringCatSheaf.obj.obj (op V))
        (baseChangeDifferentialsGenerators f' b V) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨Z, g, z, hz, rfl⟩
    exact Submodule.subset_span (map_mem_baseChangeDifferentialsGenerators (leOfHom g.unop) hz)
  exact key hi

end AlgebraicGeometry.Scheme.Hom

/-! ### Words in pulled-back forms -/

namespace AlgebraicGeometry.Scheme

variable {Y : Scheme.{u}}

/-- Images of local absolute differentials under the degree-one generator anticommute. -/
theorem absoluteFormsGenerator_mul_comm (W : Y.Opens)
    (m m' : Y.absoluteDifferentials.val.obj (op W)) :
    ((absoluteDifferentialFormsAlgebra Y).mul 1 1).app (op W)
        (Y.absoluteFormsGenerator.val.app (op W) m) (Y.absoluteFormsGenerator.val.app (op W) m') =
      -((absoluteDifferentialFormsAlgebra Y).mul 1 1).app (op W)
        (Y.absoluteFormsGenerator.val.app (op W) m')
        (Y.absoluteFormsGenerator.val.app (op W) m) := by
  have hsq := (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra Y.absoluteDifferentials).1
  set μ := ((absoluteDifferentialFormsAlgebra Y).mul 1 1).app (op W)
  have hadd : ∀ x y z, μ (x + y) z = μ x z + μ y z := fun x y z => by rw [map_add]; rfl
  have h0 := hsq (op W) (m + m')
  have h1 : μ (Y.absoluteFormsGenerator.val.app (op W) m)
      (Y.absoluteFormsGenerator.val.app (op W) m) = 0 := hsq (op W) m
  have h2 : μ (Y.absoluteFormsGenerator.val.app (op W) m')
      (Y.absoluteFormsGenerator.val.app (op W) m') = 0 := hsq (op W) m'
  change μ (Y.absoluteFormsGenerator.val.app (op W) (m + m'))
    (Y.absoluteFormsGenerator.val.app (op W) (m + m')) = 0 at h0
  rw [map_add, hadd, map_add, map_add, h1, h2, zero_add, add_zero] at h0
  exact eq_neg_of_add_eq_zero_left h0

/-- Negation respects a heterogeneous equality of sections of two pieces of equal degree of a
sheaf of graded algebras. -/
theorem _root_.SheafOfModules.GradedAlgebra.heq_neg {C : Type*} [Category C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
    (A : SheafOfModules.GradedAlgebra.{u, u} R) (V : Cᵒᵖ) {i j : ℤ} (h : i = j)
    {x : (A.piece i).val.obj V} {y : (A.piece j).val.obj V} (hxy : HEq x y) :
    HEq (-x) (-y) := by
  subst h
  cases hxy
  rfl

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

variable (f' b) in
/-- **Words in pulled-back forms** over an open `W` of `Y'`: the restrictions to `W` of the
pullbacks along `b` of local forms on `Y`, and the products `ι(α) ∧ w` of a word `w` with the
image `ι(α)` of a section `α` of `f'^*Ω_{X'/ℤ}` under the canonical map to `Ω_{Y'/ℤ}`. -/
inductive IsBaseChangeWord (W : Y'.Opens) :
    (d : ℤ) → (absoluteDifferentialForms Y' d).val.obj (op W) → Prop
  | pullback (d : ℤ) (hd : 0 ≤ d) (W₀ : Y.Opens) (h : W ≤ b ⁻¹ᵁ W₀)
      (θ : (absoluteDifferentialForms Y d).val.obj (op W₀)) :
      IsBaseChangeWord W d
        ((absoluteDifferentialForms Y' d).val.map (homOfLE h).op (b.absoluteFormsPullback d W₀ θ))
  | cons (d : ℤ) (s : ((Scheme.Modules.pullback f').obj X'.absoluteDifferentials).val.obj (op W))
      (w : (absoluteDifferentialForms Y' d).val.obj (op W)) (hw : IsBaseChangeWord W d w) :
      IsBaseChangeWord W (1 + d)
        (((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
          (Y'.absoluteFormsGenerator.val.app (op W) (f'.absoluteDifferentialsMap.val.app (op W) s))
          w)

namespace IsBaseChangeWord

/-- Words have nonnegative degree. -/
theorem nonneg {W : Y'.Opens} {d : ℤ} {w : (absoluteDifferentialForms Y' d).val.obj (op W)}
    (hw : IsBaseChangeWord f' b W d w) : 0 ≤ d := by
  induction hw with
  | pullback d hd => exact hd
  | cons d s w hw ih => omega

/-- Words are stable under restriction. -/
theorem restrict {W V : Y'.Opens} (hVW : V ≤ W) {d : ℤ}
    {w : (absoluteDifferentialForms Y' d).val.obj (op W)} (hw : IsBaseChangeWord f' b W d w) :
    IsBaseChangeWord f' b V d ((absoluteDifferentialForms Y' d).val.map (homOfLE hVW).op w) := by
  induction hw with
  | pullback d hd W₀ h θ =>
    have e : (absoluteDifferentialForms Y' d).val.map (homOfLE hVW).op
        ((absoluteDifferentialForms Y' d).val.map (homOfLE h).op
          (b.absoluteFormsPullback d W₀ θ)) =
        (absoluteDifferentialForms Y' d).val.map (homOfLE (hVW.trans h)).op
          (b.absoluteFormsPullback d W₀ θ) :=
      (PresheafOfModules.map_comp_apply _ _ _ _).symm
    rw [e]
    exact pullback d hd W₀ (hVW.trans h) θ
  | cons d s w hw ih =>
    have e : (absoluteDifferentialForms Y' (1 + d)).val.map (homOfLE hVW).op
        (((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
          (Y'.absoluteFormsGenerator.val.app (op W) (f'.absoluteDifferentialsMap.val.app (op W) s))
          w) =
        ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op V)
          (Y'.absoluteFormsGenerator.val.app (op V) (f'.absoluteDifferentialsMap.val.app (op V)
            (((Scheme.Modules.pullback f').obj X'.absoluteDifferentials).val.map (homOfLE hVW).op
              s)))
          ((absoluteDifferentialForms Y' d).val.map (homOfLE hVW).op w) := by
      refine ((absoluteDifferentialFormsAlgebra Y').mul 1 d).naturality _ _ _ |>.trans ?_
      refine congrArg (fun z => ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op V) z _) ?_
      refine (PresheafOfModules.naturality_apply Y'.absoluteFormsGenerator.val (homOfLE hVW).op
        _).symm.trans ?_
      exact congrArg _ (PresheafOfModules.naturality_apply f'.absoluteDifferentialsMap.val
        (homOfLE hVW).op s).symm
    rw [e]
    exact cons d _ _ ih

end IsBaseChangeWord

end AlgebraicGeometry.Scheme.Hom

/-! ### Spans of words -/

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

variable (f' b) in
/-- The `Γ(Y', W)`-span of the words of degree `d` over `W`. -/
noncomputable abbrev baseChangeWordSpan (W : Y'.Opens) (d : ℤ) :
    Submodule (Y'.ringCatSheaf.obj.obj (op W)) ((absoluteDifferentialForms Y' d).val.obj (op W)) :=
  Submodule.span _ {w | IsBaseChangeWord f' b W d w}

/-- The restriction of a section of a presheaf of modules lying in a span lies in the span of
the restricted generators, as soon as the restriction of each generator does. -/
private theorem map_mem_span_of_forall_mem {M : _root_.PresheafOfModules Y'.ringCatSheaf.obj}
    {W V : Y'.Opens} (hVW : V ≤ W) (S : ∀ U : Y'.Opens, Set (M.obj (op U)))
    (hS : ∀ x ∈ S W,
      M.map (homOfLE hVW).op x ∈ Submodule.span (Y'.ringCatSheaf.obj.obj (op V)) (S V))
    {z : M.obj (op W)} (hz : z ∈ Submodule.span (Y'.ringCatSheaf.obj.obj (op W)) (S W)) :
    M.map (homOfLE hVW).op z ∈ Submodule.span (Y'.ringCatSheaf.obj.obj (op V)) (S V) := by
  induction hz using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul r x _ hx => rw [PresheafOfModules.map_smul]; exact Submodule.smul_mem _ _ hx

/-- The span of words is stable under restriction. -/
theorem map_mem_baseChangeWordSpan {W V : Y'.Opens} (hVW : V ≤ W) {d : ℤ}
    {z : (absoluteDifferentialForms Y' d).val.obj (op W)} (hz : z ∈ baseChangeWordSpan f' b W d) :
    (absoluteDifferentialForms Y' d).val.map (homOfLE hVW).op z ∈ baseChangeWordSpan f' b V d := by
  exact map_mem_span_of_forall_mem hVW (fun U => {w | IsBaseChangeWord f' b U d w})
    (fun _ hx => Submodule.subset_span (IsBaseChangeWord.restrict hVW hx)) hz

/-- The span of words is stable under transport along an equality of degrees. -/
theorem degCast_mem_baseChangeWordSpan {W : Y'.Opens} {d d' : ℤ} (h : d = d')
    {z : (absoluteDifferentialForms Y' d).val.obj (op W)} (hz : z ∈ baseChangeWordSpan f' b W d) :
    Stacks.degCast (F := fun k : ℤ => ((absoluteDifferentialForms Y' k).val.obj (op W) : Type u))
      h z ∈ baseChangeWordSpan f' b W d' := by
  subst h
  exact hz

/-- Wedging on the left with the image of a section of `f'^*Ω_{X'/ℤ}` preserves the span of
words. -/
theorem mul_mem_baseChangeWordSpan_of_left {W : Y'.Opens} {d : ℤ}
    (s : ((Scheme.Modules.pullback f').obj X'.absoluteDifferentials).val.obj (op W))
    {z : (absoluteDifferentialForms Y' d).val.obj (op W)} (hz : z ∈ baseChangeWordSpan f' b W d) :
    ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
        (Y'.absoluteFormsGenerator.val.app (op W) (f'.absoluteDifferentialsMap.val.app (op W) s))
        z ∈ baseChangeWordSpan f' b W (1 + d) := by
  let φ : (absoluteDifferentialForms Y' d).val.obj (op W) →ₗ[Y'.ringCatSheaf.obj.obj (op W)]
      (absoluteDifferentialForms Y' (1 + d)).val.obj (op W) :=
    { toFun := ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
        (Y'.absoluteFormsGenerator.val.app (op W) (f'.absoluteDifferentialsMap.val.app (op W) s))
      map_add' := map_add _
      map_smul' := fun r x =>
        ((absoluteDifferentialFormsAlgebra Y').mul 1 d).map_smul_right (op W) r _ x }
  have key : baseChangeWordSpan f' b W d ≤ (baseChangeWordSpan f' b W (1 + d)).comap φ :=
    Submodule.span_le.mpr fun x hx => Submodule.subset_span (IsBaseChangeWord.cons d s x hx)
  exact key hz

/-- The restriction of a pulled-back form may be computed after first restricting on the
target. -/
theorem map_absoluteFormsPullback_eq (g : Y' ⟶ Y) (d : ℤ) {W : Y'.Opens} {W₀ W₂ : Y.Opens}
    (h : W ≤ g ⁻¹ᵁ W₀) (h₂ : W ≤ g ⁻¹ᵁ W₂) (hle : W₂ ≤ W₀)
    (θ : (absoluteDifferentialForms Y d).val.obj (op W₀)) :
    (absoluteDifferentialForms Y' d).val.map (homOfLE h).op (g.absoluteFormsPullback d W₀ θ) =
      (absoluteDifferentialForms Y' d).val.map (homOfLE h₂).op
        (g.absoluteFormsPullback d W₂
          ((absoluteDifferentialForms Y d).val.map (homOfLE hle).op θ)) := by
  have e := relativeDifferentialFormsPullback_map g Y.toSpecZ Y'.toSpecZ (𝟙 _) (comp_toSpecZ g) d
    hle θ
  refine Eq.trans ?_ (congrArg ((absoluteDifferentialForms Y' d).val.map (homOfLE h₂).op) e).symm
  exact PresheafOfModules.map_comp_apply _ _ _ _

/-- The image under the generator of a pulled-back differential is the restriction of a pulled-back
form of degree one. -/
theorem absoluteFormsGenerator_absoluteDifferentialsMap_pullbackSection (g : Y' ⟶ Y)
    {W : Y'.Opens} {W₀ : Y.Opens} (h : W ≤ g ⁻¹ᵁ W₀) (t : Y.absoluteDifferentials.val.obj (op W₀)) :
    Y'.absoluteFormsGenerator.val.app (op W)
        (g.absoluteDifferentialsMap.val.app (op W) (Scheme.Modules.pullbackSection g _ W₀ W h t)) =
      (absoluteDifferentialForms Y' 1).val.map (homOfLE h).op
        (g.absoluteFormsPullback 1 W₀ (Y.absoluteFormsGenerator.val.app (op W₀) t)) := by
  rw [absoluteFormsPullback_generator]
  refine Eq.trans ?_ (PresheafOfModules.naturality_apply Y'.absoluteFormsGenerator.val _ _)
  exact congrArg _ (PresheafOfModules.naturality_apply g.absoluteDifferentialsMap.val _ _)

/-- **Wedging a word on the left with the image of a pullback of a local differential on `Y`
lands in the span of words.** -/
theorem mul_mem_baseChangeWordSpan_of_isBaseChangeWord {W : Y'.Opens} {d : ℤ}
    {w : (absoluteDifferentialForms Y' d).val.obj (op W)} (hw : IsBaseChangeWord f' b W d w)
    {W₁ : Y.Opens} (h₁ : W ≤ b ⁻¹ᵁ W₁) (t : Y.absoluteDifferentials.val.obj (op W₁)) :
    ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
        (Y'.absoluteFormsGenerator.val.app (op W)
          (b.absoluteDifferentialsMap.val.app (op W)
            (Scheme.Modules.pullbackSection b _ W₁ W h₁ t)))
        w ∈ baseChangeWordSpan f' b W (1 + d) := by
  induction hw with
  | pullback d hd W₀ h θ =>
    have h₂ : W ≤ b ⁻¹ᵁ (W₀ ⊓ W₁) := fun y hy => ⟨h hy, h₁ hy⟩
    have e₁ := (absoluteFormsGenerator_absoluteDifferentialsMap_pullbackSection b h₁ t).trans
      (map_absoluteFormsPullback_eq b 1 h₁ h₂ inf_le_right _)
    have e₂ := map_absoluteFormsPullback_eq b d h h₂ inf_le_left θ
    have e := (congrArg₂ (fun u v => ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W) u v)
      e₁ e₂).trans ((((absoluteDifferentialFormsAlgebra Y').mul 1 d).naturality _ _ _).symm.trans
        (congrArg ((absoluteDifferentialForms Y' (1 + d)).val.map (homOfLE h₂).op)
          (relativeDifferentialFormsPullback_mul b Y.toSpecZ Y'.toSpecZ (𝟙 _) (comp_toSpecZ b)
            1 d (W₀ ⊓ W₁) _ _).symm))
    exact e.symm ▸ Submodule.subset_span (IsBaseChangeWord.pullback (1 + d) (by omega) _ h₂ _)
  | cons d s w hw ih =>
    set y := Y'.absoluteFormsGenerator.val.app (op W)
      (b.absoluteDifferentialsMap.val.app (op W) (Scheme.Modules.pullbackSection b _ W₁ W h₁ t))
    set x := Y'.absoluteFormsGenerator.val.app (op W) (f'.absoluteDifferentialsMap.val.app (op W) s)
    have hassoc₁ := (absoluteDifferentialFormsAlgebra Y').mul_assoc 1 1 d (op W) y x w
    have hassoc₂ := (absoluteDifferentialFormsAlgebra Y').mul_assoc 1 1 d (op W) x y w
    have hcomm : ((absoluteDifferentialFormsAlgebra Y').mul 1 1).app (op W) y x =
        -((absoluteDifferentialFormsAlgebra Y').mul 1 1).app (op W) x y :=
      absoluteFormsGenerator_mul_comm W _ _
    have hneg : ((absoluteDifferentialFormsAlgebra Y').mul (1 + 1) d).app (op W)
        (((absoluteDifferentialFormsAlgebra Y').mul 1 1).app (op W) y x) w =
        -((absoluteDifferentialFormsAlgebra Y').mul (1 + 1) d).app (op W)
          (((absoluteDifferentialFormsAlgebra Y').mul 1 1).app (op W) x y) w := by
      rw [hcomm, map_neg]
      rfl
    have key : ((absoluteDifferentialFormsAlgebra Y').mul 1 (1 + d)).app (op W) y
        (((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W) x w) =
        -((absoluteDifferentialFormsAlgebra Y').mul 1 (1 + d)).app (op W) x
          (((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W) y w) :=
      eq_of_heq (hassoc₁.symm.trans ((heq_of_eq hneg).trans
        (SheafOfModules.GradedAlgebra.heq_neg _ (op W) (by omega) hassoc₂)))
    exact key.symm ▸ neg_mem (mul_mem_baseChangeWordSpan_of_left s ih)

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

/-- Wedging on the left with the image under the generator of a fixed section of `Ω^1_{Y'/ℤ}`, as a
linear map. -/
noncomputable def wedgeLeftLinear (W : Y'.Opens) (d : ℤ)
    (x : (absoluteDifferentialForms Y' 1).val.obj (op W)) :
    (absoluteDifferentialForms Y' d).val.obj (op W) →ₗ[Y'.ringCatSheaf.obj.obj (op W)]
      (absoluteDifferentialForms Y' (1 + d)).val.obj (op W) where
  toFun := ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W) x
  map_add' := map_add _
  map_smul' := fun r z =>
    ((absoluteDifferentialFormsAlgebra Y').mul 1 d).map_smul_right (op W) r x z

/-- Wedging on the right with a fixed section of `Ω^d_{Y'/ℤ}`, precomposed with the generator, as a
linear map out of `Ω_{Y'/ℤ}`. -/
noncomputable def wedgeRightLinear (W : Y'.Opens) (d : ℤ)
    (z : (absoluteDifferentialForms Y' d).val.obj (op W)) :
    Y'.absoluteDifferentials.val.obj (op W) →ₗ[Y'.ringCatSheaf.obj.obj (op W)]
      (absoluteDifferentialForms Y' (1 + d)).val.obj (op W) where
  toFun m := ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
    (Y'.absoluteFormsGenerator.val.app (op W) m) z
  map_add' m m' := by
    rw [map_add, map_add]
    rfl
  map_smul' r m := by
    rw [map_smul]
    exact ((absoluteDifferentialFormsAlgebra Y').mul 1 d).map_smul_left (op W) r _ z

/-- Wedging a section of the span of words on the left with the image of a pullback of a local
differential on `Y` lands in the span of words. -/
theorem mul_mem_baseChangeWordSpan_of_pullbackSection {W : Y'.Opens} {d : ℤ}
    {z : (absoluteDifferentialForms Y' d).val.obj (op W)} (hz : z ∈ baseChangeWordSpan f' b W d)
    {W₁ : Y.Opens} (h₁ : W ≤ b ⁻¹ᵁ W₁) (t : Y.absoluteDifferentials.val.obj (op W₁)) :
    ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
        (Y'.absoluteFormsGenerator.val.app (op W)
          (b.absoluteDifferentialsMap.val.app (op W)
            (Scheme.Modules.pullbackSection b _ W₁ W h₁ t)))
        z ∈ baseChangeWordSpan f' b W (1 + d) := by
  have key : baseChangeWordSpan f' b W d ≤ (baseChangeWordSpan f' b W (1 + d)).comap
      (wedgeLeftLinear W d (Y'.absoluteFormsGenerator.val.app (op W)
        (b.absoluteDifferentialsMap.val.app (op W)
          (Scheme.Modules.pullbackSection b _ W₁ W h₁ t)))) :=
    Submodule.span_le.mpr fun x hx => mul_mem_baseChangeWordSpan_of_isBaseChangeWord hx h₁ t
  exact key hz

/-- **The span of words is stable under wedging on the left with the image of a section of
`Ω_{Y'/ℤ}` lying in the span of the generators.** -/
theorem mul_mem_baseChangeWordSpan {W : Y'.Opens} {d : ℤ}
    {m : Y'.absoluteDifferentials.val.obj (op W)}
    (hm : m ∈ Submodule.span (Y'.ringCatSheaf.obj.obj (op W))
      (baseChangeDifferentialsGenerators f' b W))
    {z : (absoluteDifferentialForms Y' d).val.obj (op W)} (hz : z ∈ baseChangeWordSpan f' b W d) :
    ((absoluteDifferentialFormsAlgebra Y').mul 1 d).app (op W)
        (Y'.absoluteFormsGenerator.val.app (op W) m) z ∈ baseChangeWordSpan f' b W (1 + d) := by
  have key : Submodule.span (Y'.ringCatSheaf.obj.obj (op W))
      (baseChangeDifferentialsGenerators f' b W) ≤
        (baseChangeWordSpan f' b W (1 + d)).comap (wedgeRightLinear W d z) := by
    refine Submodule.span_le.mpr ?_
    rintro _ (⟨s, rfl⟩ | ⟨W₁, h₁, t, rfl⟩)
    · exact mul_mem_baseChangeWordSpan_of_left s hz
    · exact mul_mem_baseChangeWordSpan_of_pullbackSection hz h₁ t
  exact key hm

end AlgebraicGeometry.Scheme.Hom

/-! ### Local generation of `Ω^n_{Y'/ℤ}` by words -/

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

/-- The span of the generators of `Ω_{Y'/ℤ}` is stable under restriction. -/
theorem map_mem_span_baseChangeDifferentialsGenerators {W V : Y'.Opens} (hVW : V ≤ W)
    {m : Y'.absoluteDifferentials.val.obj (op W)}
    (hm : m ∈ Submodule.span (Y'.ringCatSheaf.obj.obj (op W))
      (baseChangeDifferentialsGenerators f' b W)) :
    Y'.absoluteDifferentials.val.map (homOfLE hVW).op m ∈
      Submodule.span (Y'.ringCatSheaf.obj.obj (op V))
        (baseChangeDifferentialsGenerators f' b V) := by
  exact map_mem_span_of_forall_mem hVW (baseChangeDifferentialsGenerators f' b)
    (fun _ hx => Submodule.subset_span (map_mem_baseChangeDifferentialsGenerators hVW hx)) hm

/-- **Products of images of local differentials are locally in the span of words.** Near every
point, the ordered product of the images under the generator of `n` local sections of
`Ω_{Y'/ℤ}` restricts into the span of the words of degree `n`. -/
theorem exists_map_homogeneousProd_mem_baseChangeWordSpan (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] (n : ℕ) :
    ∀ (W : Y'.Opens) (v : Fin n → Y'.absoluteDifferentials.val.obj (op W)) (y : Y'), y ∈ W →
      ∃ (V : Y'.Opens) (hVW : V ≤ W), y ∈ V ∧
        (absoluteDifferentialForms Y' n).val.map (homOfLE hVW).op
          ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W) n
            fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i)) ∈
          baseChangeWordSpan f' b V n := by
  induction n with
  | zero =>
    intro W v y hy
    refine ⟨W, le_rfl, hy, Submodule.subset_span ?_⟩
    have hW : W ≤ b ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have e : (absoluteDifferentialForms Y' ((0 : ℕ) : ℤ)).val.map (homOfLE (le_refl W)).op
        ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W) 0
          fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i)) =
        (absoluteDifferentialForms Y' 0).val.map (homOfLE hW).op
          (b.absoluteFormsPullback 0 ⊤ ((absoluteDifferentialFormsAlgebra Y).one.eval (op ⊤))) :=
      (PresheafOfModules.sections_property (absoluteDifferentialFormsAlgebra Y').one _).trans
        ((PresheafOfModules.sections_property (absoluteDifferentialFormsAlgebra Y').one
          (homOfLE hW).op).symm.trans (congrArg _
            (relativeDifferentialFormsPullback_one b Y.toSpecZ Y'.toSpecZ (𝟙 _) (comp_toSpecZ b)
              ⊤).symm))
    exact e ▸ IsBaseChangeWord.pullback 0 le_rfl ⊤ hW _
  | succ n ih =>
    intro W v y hy
    obtain ⟨V₁, h₁, hy₁, hV₁⟩ := ih W (fun i => v i.succ) y hy
    obtain ⟨V₂, h₂, hy₂, hV₂⟩ :=
      exists_mem_span_baseChangeDifferentialsGenerators w W (v 0) y hy
    have hk : (1 : ℤ) + (n : ℤ) = ((n + 1 : ℕ) : ℤ) := by omega
    have hV : V₁ ⊓ V₂ ≤ W := inf_le_left.trans h₁
    refine ⟨V₁ ⊓ V₂, hV, ⟨hy₁, hy₂⟩, ?_⟩
    have e₀ := Stacks.GradedAlgebra.homogeneousProd_succ
      (absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra (op W) n hk
      fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i)
    have e₁ := SheafOfModules.degCast_restrict (absoluteDifferentialForms Y') hk (homOfLE hV).op
      (((absoluteDifferentialFormsAlgebra Y').mul 1 n).app (op W)
      (Y'.absoluteFormsGenerator.val.app (op W) (v 0))
      ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W) n
        fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i.succ)))
    have e₂ := ((absoluteDifferentialFormsAlgebra Y').mul 1 n).naturality (homOfLE hV).op
      (Y'.absoluteFormsGenerator.val.app (op W) (v 0))
      ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W) n
        fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i.succ))
    let m₂ : Y'.absoluteDifferentials.val.obj (op V₂) :=
      Y'.absoluteDifferentials.val.map (homOfLE h₂).op (v 0)
    let P₁ : (absoluteDifferentialForms Y' n).val.obj (op V₁) :=
      (absoluteDifferentialForms Y' n).val.map (homOfLE h₁).op
        ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W) n
          fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i.succ))
    have e₃ : (absoluteDifferentialForms Y' 1).val.map (homOfLE hV).op
        (Y'.absoluteFormsGenerator.val.app (op W) (v 0)) =
        Y'.absoluteFormsGenerator.val.app (op (V₁ ⊓ V₂))
          (Y'.absoluteDifferentials.val.map (homOfLE inf_le_right).op m₂) :=
      (PresheafOfModules.naturality_apply Y'.absoluteFormsGenerator.val _ _).symm.trans
        (congrArg _ (PresheafOfModules.map_comp_apply _ _ _ _))
    have e₄ : (absoluteDifferentialForms Y' n).val.map (homOfLE hV).op
        ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W) n
          fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i.succ)) =
        (absoluteDifferentialForms Y' n).val.map (homOfLE inf_le_left).op P₁ :=
      PresheafOfModules.map_comp_apply _ _ _ _
    have hmem := mul_mem_baseChangeWordSpan
      (map_mem_span_baseChangeDifferentialsGenerators (m := m₂) inf_le_right hV₂)
      (map_mem_baseChangeWordSpan (z := P₁) inf_le_left hV₁)
    have hmem' := degCast_mem_baseChangeWordSpan hk hmem
    have e : (absoluteDifferentialForms Y' ((n + 1 : ℕ) : ℤ)).val.map (homOfLE hV).op
        ((absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd (op W)
          (n + 1) fun i => Y'.absoluteFormsGenerator.val.app (op W) (v i)) =
        Stacks.degCast (F := fun k : ℤ =>
          ((absoluteDifferentialForms Y' k).val.obj (op (V₁ ⊓ V₂)) : Type u)) hk
          (((absoluteDifferentialFormsAlgebra Y').mul 1 n).app (op (V₁ ⊓ V₂))
            (Y'.absoluteFormsGenerator.val.app (op (V₁ ⊓ V₂))
              (Y'.absoluteDifferentials.val.map (homOfLE inf_le_right).op m₂))
            ((absoluteDifferentialForms Y' n).val.map (homOfLE inf_le_left).op P₁)) :=
      (congrArg _ e₀).trans (e₁.trans (congrArg _ (e₂.trans (congrArg₂
        (fun u v => ((absoluteDifferentialFormsAlgebra Y').mul 1 n).app (op (V₁ ⊓ V₂)) u v)
        e₃ e₄))))
    exact e ▸ hmem'

end AlgebraicGeometry.Scheme.Hom

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

variable (f' b) in
/-- The local sections of `Ω^d_{Y'/ℤ}` which near every point restrict into the span of words. -/
noncomputable def baseChangeWordLocalSpan (W : Y'.Opens) (d : ℤ) :
    Submodule (Y'.ringCatSheaf.obj.obj (op W)) ((absoluteDifferentialForms Y' d).val.obj (op W))
    where
  carrier := {z | ∀ y ∈ W, ∃ (V : Y'.Opens) (hVW : V ≤ W), y ∈ V ∧
    (absoluteDifferentialForms Y' d).val.map (homOfLE hVW).op z ∈ baseChangeWordSpan f' b V d}
  zero_mem' := fun y hy => by
    refine ⟨W, le_rfl, hy, ?_⟩
    rw [map_zero]
    exact zero_mem _
  add_mem' := by
    intro z z' hz hz' y hy
    obtain ⟨V, hV, hyV, hzV⟩ := hz y hy
    obtain ⟨V', hV', hyV', hzV'⟩ := hz' y hy
    have h₁ := map_mem_baseChangeWordSpan (inf_le_left : V ⊓ V' ≤ V) hzV
    have h₂ := map_mem_baseChangeWordSpan (inf_le_right : V ⊓ V' ≤ V') hzV'
    refine ⟨V ⊓ V', inf_le_left.trans hV, ⟨hyV, hyV'⟩, ?_⟩
    let z₁ : (absoluteDifferentialForms Y' d).val.obj (op (V ⊓ V')) :=
      (absoluteDifferentialForms Y' d).val.map (homOfLE (inf_le_left : V ⊓ V' ≤ V)).op
        ((absoluteDifferentialForms Y' d).val.map (homOfLE hV).op z)
    let z₂ : (absoluteDifferentialForms Y' d).val.obj (op (V ⊓ V')) :=
      (absoluteDifferentialForms Y' d).val.map (homOfLE (inf_le_right : V ⊓ V' ≤ V')).op
        ((absoluteDifferentialForms Y' d).val.map (homOfLE hV').op z')
    have e : (absoluteDifferentialForms Y' d).val.map (homOfLE (inf_le_left.trans hV)).op
        (z + z') = z₁ + z₂ :=
      (map_add _ _ _).trans (congrArg₂ (· + ·) (PresheafOfModules.map_comp_apply _ _ _ _)
        (PresheafOfModules.map_comp_apply _ _ _ _))
    rw [e]
    exact add_mem h₁ h₂
  smul_mem' := by
    intro r z hz y hy
    obtain ⟨V, hV, hyV, hzV⟩ := hz y hy
    refine ⟨V, hV, hyV, ?_⟩
    rw [PresheafOfModules.map_smul]
    exact Submodule.smul_mem _ _ hzV

/-- **Every local section of `Ω^n_{Y'/ℤ}` is locally in the span of words**, for a commutative
square inducing an open immersion of `Y'` into `X' ×_X Y`. -/
theorem exists_map_mem_baseChangeWordSpan (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] (n : ℕ) (W : Y'.Opens)
    (η : (absoluteDifferentialForms Y' n).val.obj (op W)) (y : Y') (hy : y ∈ W) :
    ∃ (V : Y'.Opens) (hVW : V ≤ W), y ∈ V ∧
      (absoluteDifferentialForms Y' n).val.map (homOfLE hVW).op η ∈
        baseChangeWordSpan f' b V n := by
  obtain ⟨W₁, i, hy₁, N, c, v, hsum⟩ :=
    SheafOfModules.TensorExteriorSymmetricAlgebras.exists_res_eq_sum_homogeneousProd
      (SheafOfModules.algebras _ Y'.absoluteDifferentials) y n hy η
  have hsum' : (absoluteDifferentialForms Y' n).val.map i.op η =
      ∑ j, c j • (absoluteDifferentialFormsAlgebra Y').toPresheafGradedAlgebra.homogeneousProd
        (op W₁) n fun k => Y'.absoluteFormsGenerator.val.app (op W₁) (v j k) := hsum
  have hloc : (absoluteDifferentialForms Y' n).val.map i.op η ∈
      baseChangeWordLocalSpan f' b W₁ n := by
    rw [hsum']
    exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _
      (exists_map_homogeneousProd_mem_baseChangeWordSpan w n W₁ (v j))
  obtain ⟨V, hVW₁, hyV, hV⟩ := hloc y hy₁
  refine ⟨V, hVW₁.trans (leOfHom i), hyV, ?_⟩
  have e : (absoluteDifferentialForms Y' n).val.map (homOfLE (hVW₁.trans (leOfHom i))).op η =
      (absoluteDifferentialForms Y' n).val.map (homOfLE hVW₁).op
        ((absoluteDifferentialForms Y' n).val.map i.op η) :=
    PresheafOfModules.map_comp_apply _ _ _ _
  rw [e]
  exact hV

end AlgebraicGeometry.Scheme.Hom

/-! ### The uniqueness -/

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

/-- **Stacks Project, Lemma 0H9G, in the generality its proof gives.** Consider a commutative
square `b ≫ f = f' ≫ a` of schemes inducing an open immersion of `Y'` into `X' ×_X Y`, an
`𝒪_Y`-module `L`, an `𝒪_{Y'}`-module `L'`, an arbitrary map `e : b^*L ⟶ L'` and an arbitrary
family `c^p : Ω^p_{Y/ℤ} ⟶ f^*Ω^p_{X/ℤ} ⊗ L`. Then there is at most one family
`c'^p : Ω^p_{Y'/ℤ} ⟶ f'^*Ω^p_{X'/ℤ} ⊗ L'` satisfying condition (0H9D) and compatible with `c`
through the square. -/
theorem GarelMaps.eq_of_isMultiplicative_of_isCompatible (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] {L : Y.Modules} {L' : Y'.Modules}
    (e : (Scheme.Modules.pullback b).obj L ⟶ L') {c : f.GarelMaps L} {c' c'' : f'.GarelMaps L'}
    (hc' : c'.IsMultiplicative) (hc'' : c''.IsMultiplicative)
    (h' : GarelMaps.IsCompatible w e c c') (h'' : GarelMaps.IsCompatible w e c c'') :
    c' = c'' := by
  have hword : ∀ (W : Y'.Opens) (d : ℤ) (z : (absoluteDifferentialForms Y' d).val.obj (op W)),
      IsBaseChangeWord f' b W d z → ∀ (n : ℕ) (hn : (n : ℤ) = d),
        (c' n).val.app (op W) (Stacks.degCast (F := fun k : ℤ =>
          ((absoluteDifferentialForms Y' k).val.obj (op W) : Type u)) hn.symm z) =
        (c'' n).val.app (op W) (Stacks.degCast (F := fun k : ℤ =>
          ((absoluteDifferentialForms Y' k).val.obj (op W) : Type u)) hn.symm z) := by
    intro W d z hz
    induction hz with
    | pullback d hd W₀ h θ =>
      intro n hn
      subst hn
      have hb : b.absoluteFormsMap n ≫ c' n = b.absoluteFormsMap n ≫ c'' n :=
        (h' n).symm.trans (h'' n)
      have e₁ := (absoluteFormsMap_pullbackSection b n W₀ W h θ).symm
      exact (congrArg ((c' n).val.app (op W)) e₁).trans
        ((SheafOfModules.Hom.congr_val_app hb (op W) _).trans
          (congrArg ((c'' n).val.app (op W)) e₁.symm))
    | cons d s z hz ih =>
      intro n hn
      obtain ⟨p, rfl⟩ := Int.eq_ofNat_of_zero_le hz.nonneg
      obtain rfl : n = 1 + p := by omega
      let ω : (f'.pullbackForms ((1 : ℕ) : ℤ)).val.obj (op W) :=
        ((Scheme.Modules.pullback f').map X'.absoluteFormsGenerator).val.app (op W) s
      have hx : (f'.absoluteFormsMap ((1 : ℕ) : ℤ)).val.app (op W) ω =
          Y'.absoluteFormsGenerator.val.app (op W) (f'.absoluteDifferentialsMap.val.app (op W) s) :=
        SheafOfModules.Hom.congr_val_app (pullback_map_absoluteFormsGenerator_comp f') (op W) s
      have hact : (f'.absoluteFormsAction 1 p).val.app (op W)
          (Stacks.PullbackTensorCoherence.tmul Y'.toRingedSpace (f'.pullbackForms ((1 : ℕ) : ℤ))
            (absoluteDifferentialForms Y' p) (op W) ω z) =
          Stacks.degCast (F := fun k : ℤ =>
            ((absoluteDifferentialForms Y' k).val.obj (op W) : Type u)) hn.symm
            (((absoluteDifferentialFormsAlgebra Y').mul 1 p).app (op W)
              (Y'.absoluteFormsGenerator.val.app (op W)
                (f'.absoluteDifferentialsMap.val.app (op W) s)) z) :=
        (absoluteFormsAction_tmul f' 1 p W ω z).trans
          ((Stacks.RegularSequence.eqToHom_val_app_eq_degCast (absoluteDifferentialForms Y') _
            (op W) _).trans
            (congrArg (fun t => Stacks.degCast (F := fun k : ℤ =>
              ((absoluteDifferentialForms Y' k).val.obj (op W) : Type u)) (Nat.cast_add 1 p).symm
                (((absoluteDifferentialFormsAlgebra Y').mul ((1 : ℕ) : ℤ) p).app (op W) t z)) hx))
      have h₁ := (GarelMaps.isMultiplicative_iff c').1 hc' 1 p W ω z
      have h₂ := (GarelMaps.isMultiplicative_iff c'').1 hc'' 1 p W ω z
      have h₃ : (c' p).val.app (op W) z = (c'' p).val.app (op W) z := ih p rfl
      refine (congrArg ((c' (1 + p)).val.app (op W)) hact.symm).trans ?_
      refine h₁.trans ?_
      refine Eq.trans ?_ (h₂.symm.trans (congrArg ((c'' (1 + p)).val.app (op W)) hact))
      exact congrArg (fun t => (f'.twistedPullbackFormsMul L' 1 p).val.app (op W)
        (Stacks.PullbackTensorCoherence.tmul Y'.toRingedSpace (f'.pullbackForms ((1 : ℕ) : ℤ))
          (f'.twistedPullbackForms L' p) (op W) ω t)) h₃
  have hspan : ∀ (W : Y'.Opens) (n : ℕ) (z : (absoluteDifferentialForms Y' n).val.obj (op W)),
      z ∈ baseChangeWordSpan f' b W n → (c' n).val.app (op W) z = (c'' n).val.app (op W) z := by
    intro W n z hz
    have key : baseChangeWordSpan f' b W n ≤
        LinearMap.eqLocus ((c' n).val.app (op W)).hom ((c'' n).val.app (op W)).hom :=
      Submodule.span_le.mpr fun x hx => hword W n x hx n rfl
    exact key hz
  funext n
  refine Scheme.Modules.hom_ext (c' n) (c'' n) fun O => ?_
  ext z
  choose V hVO hxV hV using fun x : O => exists_map_mem_baseChangeWordSpan w n O z x x.2
  have key : ∀ (x : O) (g : absoluteDifferentialForms Y' n ⟶ f'.twistedPullbackForms L' n),
      (f'.twistedPullbackForms L' n).val.map (homOfLE (hVO x)).op (g.val.app (op O) z) =
        g.val.app (op (V x)) ((absoluteDifferentialForms Y' n).val.map (homOfLE (hVO x)).op z) :=
    fun x g => (PresheafOfModules.naturality_apply g.val (homOfLE (hVO x)).op z).symm
  exact TopCat.Sheaf.eq_of_locally_eq' ((SheafOfModules.toSheaf _).obj
      (f'.twistedPullbackForms L' n)) V O (fun x => homOfLE (hVO x))
    (fun x hx => Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxV _⟩) _ _
    fun x => (key x (c' n)).trans ((hspan _ n _ (hV x)).trans (key x (c'' n)).symm)

end AlgebraicGeometry.Scheme.Hom

/-! ### The statement of the source -/

namespace AlgebraicGeometry.Scheme.Hom

variable {X X' Y Y' : Scheme.{u}} {f : Y ⟶ X} {a : X' ⟶ X} {f' : Y' ⟶ X'} {b : Y' ⟶ Y}

/-- In a commutative square inducing an open immersion of `Y'` into `X' ×_X Y`, the left edge is
syntomic as soon as the right edge is. -/
theorem syntomic_of_isOpenImmersion_lift (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] (hf : Syntomic f) : Syntomic f' := by
  rw [← pullback.lift_snd b f' w]
  exact MorphismProperty.comp_mem _ _ _ (syntomic_of_isOpenImmersion _)
    (MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @Syntomic.{u})
      (IsPullback.of_hasPullback f a) hf)

/-- In a commutative square inducing an open immersion of `Y'` into `X' ×_X Y`, the left edge is
locally quasi-finite as soon as the right edge is. -/
@[sga "3 VIB 2.8" "(i) ⇒ (ii), partial"]
theorem locallyQuasiFinite_of_isOpenImmersion_lift (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] [LocallyQuasiFinite f] : LocallyQuasiFinite f' := by
  rw [← pullback.lift_snd b f' w]
  infer_instance

/-- **Stacks Project, Lemma 0H9G.** Consider a commutative square `b ≫ f = f' ≫ a` of schemes
which induces an isomorphism of `Y'` with an open subscheme of `X' ×_X Y`, with `f` locally
quasi-finite and syntomic (so that `f'` is too), and maps
`c^p : Ω^p_{Y/ℤ} ⟶ f^*Ω^p_{X/ℤ} ⊗ det(NL_{Y/X})` satisfying (0H9C) and (0H9D). Then there is at
most one collection of maps `c'^p : Ω^p_{Y'/ℤ} ⟶ f'^*Ω^p_{X'/ℤ} ⊗ det(NL_{Y'/X'})` satisfying
(0H9C) and (0H9D) for which the squares of the lemma commute, the right-hand vertical arrows
using the maps `b^*Ω^p_{Y/ℤ} ⟶ Ω^p_{Y'/ℤ}` and `a^*Ω^p_{X/ℤ} ⟶ Ω^p_{X'/ℤ}` of Section 07HX and the
identification `b^*det(NL_{Y/X}) = det(NL_{Y'/X'})` of Section 0FKB. -/
@[stacks 0H9G "at most one collection c'^p satisfying 0H9C and 0H9D compatible with c through \
the square, using the 07HX maps and the 0FKB identification b^*det(NL_{Y/X}) = det(NL_{Y'/X'})"]
theorem GarelMaps.subsingleton_isCompatible_detNLPullbackIso (w : b ≫ f = f' ≫ a)
    [IsOpenImmersion (pullback.lift b f' w)] (hf : Syntomic f) [LocallyQuasiFinite f]
    (c : f.GarelMaps (f.detNL hf)) :
    haveI := locallyQuasiFinite_of_isOpenImmersion_lift w
    c.IsNormalized (f.deltaNL hf) → c.IsMultiplicative →
      {c' : f'.GarelMaps (f'.detNL (syntomic_of_isOpenImmersion_lift w hf)) |
        c'.IsNormalized (f'.deltaNL (syntomic_of_isOpenImmersion_lift w hf)) ∧
          c'.IsMultiplicative ∧
          GarelMaps.IsCompatible w
            (detNLPullbackIso w hf (syntomic_of_isOpenImmersion_lift w hf)).hom c c'}.Subsingleton
    :=
  fun _ _ _ hc' _ hc'' =>
    GarelMaps.eq_of_isMultiplicative_of_isCompatible w _ hc'.2.1 hc''.2.1 hc'.2.2 hc''.2.2

end AlgebraicGeometry.Scheme.Hom
