module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ExteriorPowerFiniteType
public import StacksFrontier.AlgebraicGeometry.AffineDifferentials.SpecKaehlerEquiv
public import StacksFrontier.AlgebraicGeometry.DeRham.Complex.AffineFormsMapSections
public import StacksFrontier.AlgebraicGeometry.Descent.SectionsPullbackComparison.GeneratingFamily
public import StacksFrontier.AlgebraicGeometry.Modules.MonoAffineCriterion

/-!
# Monomorphy of the canonical map on differential forms of a morphism of affine schemes

Let `R ⟶ A ⟶ C` be a tower of commutative rings and consider the commutative square of affine
schemes

```
Spec C --> Spec A
  |          |
  v          v
Spec R === Spec R
```

all of whose arrows are `Spec` of the structure maps. **This file shows that the canonical map

`(Spec C → Spec A)^* Ω^a_{Spec A/Spec R} ⟶ Ω^a_{Spec C/Spec R}`

of [Stacks, Tag 0FL5] is a monomorphism as soon as the `a`-th exterior power of
`KaehlerDifferential.mapBaseChange R A C` is injective** — that is, as soon as the purely
ring-theoretic statement holds.

## Main results

* `exists_pullbackDifferentialsΓBaseChange`: the global sections of `f^*Ω_{Spec A/Spec R}` are
  generated by the base change `C ⊗[A] Ω[A⁄R]`, compatibly with universal differentials.
* `mono_relativeDifferentialFormsMap_of_injective`: the abstract criterion, for arbitrary
  comparisons `T` and `E` on the two sides.
* `mono_relativeDifferentialFormsMap_specTower`: for a tower of rings the canonical map on
  `a`-forms of the square above is a monomorphism as soon as
  `exteriorPower.map a (KaehlerDifferential.mapBaseChange R A C)` is injective.

## References

* [Stacks Project, Tag 0FL5](https://stacks.math.columbia.edu/tag/0FL5)
* [Stacks Project, Tag 01UT](https://stacks.math.columbia.edu/tag/01UT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open Stacks.AffineExteriorPower (quasicoherentExteriorPowerΓIso)
open scoped TensorProduct

universe u

open Stacks.AlgebraicGeometry.AffineBaseChange
  (isQuasicoherent_pullback mono_of_mono_moduleSpecΓ)

namespace Stacks.AlgebraicGeometry.AffineDifferentialForms

/-! ### The abstract criterion -/

section Criterion

variable {R A C : CommRingCat.{u}} [Algebra ↥R ↥A] [Algebra ↥A ↥C] [Algebra ↥R ↥C]
  [IsScalarTower ↥R ↥A ↥C] {p : Spec A ⟶ Spec R} {p' : Spec C ⟶ Spec R}
  (f : Spec C ⟶ Spec A) (hf : f = Spec.map (CommRingCat.ofHom (algebraMap ↥A ↥C)))
  (hcomm : f ≫ p = p' ≫ 𝟙 (Spec R)) (a : ℕ)
  (T : ↥C ⊗[↥A] Ω[↥A⁄↥R] →ₗ[↥C]
    ↥(moduleSpecΓFunctor.obj
      ((Scheme.Modules.pullback f).obj (Scheme.Hom.relativeDifferentials p))))
  (E : Ω[↥C⁄↥R] →ₗ[↥C] ↥(moduleSpecΓFunctor.obj (Scheme.Hom.relativeDifferentials p')))
  (hT : ∀ b : ↥A, T ((1 : ↥C) ⊗ₜ KaehlerDifferential.D ↥R ↥A b) =
    pullbackSectionHom f (Scheme.Hom.relativeDifferentials p) ⊤ ⊤ le_top
      ((Scheme.Hom.universalRelativeDerivation p).d ((Scheme.ΓSpecIso A).inv.hom b)))
  (hE : ∀ c : ↥C, E (KaehlerDifferential.D ↥R ↥C c) =
    (Scheme.Hom.universalRelativeDerivation p').d ((Scheme.ΓSpecIso C).inv.hom c))

include hf hcomm hT hE in
/-- **The abstract affine criterion for monomorphy of the canonical map on `a`-forms.** In the
situation of the global-sections dictionary
`relativeDifferentialFormsMap_Γ_comp_eq_exteriorPower_map_mapBaseChange`, if the comparison `T`
on the source is surjective, the comparison `E` on the target has a left inverse, and the
`a`-th exterior power of `KaehlerDifferential.mapBaseChange R A C` is injective, then the
canonical map on `a`-forms is a monomorphism. -/
theorem mono_relativeDifferentialFormsMap_of_injective
    (hTsurj : Function.Surjective T)
    (ret : ↥(moduleSpecΓFunctor.obj (Scheme.Hom.relativeDifferentials p')) →ₗ[↥C] Ω[↥C⁄↥R])
    (hret : ret ∘ₗ E = LinearMap.id)
    (hinj : Function.Injective
      (exteriorPower.map a (KaehlerDifferential.mapBaseChange ↥R ↥A ↥C))) :
    Mono (Scheme.Hom.relativeDifferentialFormsMap f p p' (𝟙 (Spec R)) hcomm (a : ℤ)) := by
  have hqcA : (Scheme.Hom.relativeDifferentialForms p (a : ℤ)).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_exteriorPower (Scheme.Hom.relativeDifferentials p) a
  have hqcS : ((Scheme.Modules.pullback f).obj
      (Scheme.Hom.relativeDifferentialForms p (a : ℤ))).IsQuasicoherent :=
    isQuasicoherent_pullback f _
  have hqcT : (Scheme.Hom.relativeDifferentialForms p' (a : ℤ)).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_exteriorPower (Scheme.Hom.relativeDifferentials p') a
  refine mono_of_mono_moduleSpecΓ _ (ConcreteCategory.mono_of_injective _ ?_)
  have heq := relativeDifferentialFormsMap_Γ_comp_eq_exteriorPower_map_mapBaseChange
    f hcomm a hf T E hT hE
  have hEinj : Function.Injective (exteriorPower.map a E) :=
    exteriorPower.map_injective ret hret
  have hs : Function.Surjective
      (((formsPullbackΓIso f p a).inv.hom ∘ₗ exteriorPower.map a T : _ →ₗ[↥C] _)) :=
    (ConcreteCategory.bijective_of_isIso (formsPullbackΓIso f p a).inv).2.comp
      (exteriorPower.map_surjective hTsurj)
  have hpt : ∀ z, (quasicoherentExteriorPowerΓIso (Scheme.Hom.relativeDifferentials p')
          (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra _) a).hom.hom
        ((moduleSpecΓFunctor.map
            (Scheme.Hom.relativeDifferentialFormsMap f p p' (𝟙 (Spec R)) hcomm (a : ℤ))).hom
          (((formsPullbackΓIso f p a).inv.hom ∘ₗ exteriorPower.map a T) z)) =
      exteriorPower.map a E
        (exteriorPower.map a (KaehlerDifferential.mapBaseChange ↥R ↥A ↥C) z) :=
    LinearMap.congr_fun heq
  intro x y hxy
  obtain ⟨x', hx'⟩ := hs x
  obtain ⟨y', hy'⟩ := hs y
  have hchain : exteriorPower.map a E
        (exteriorPower.map a (KaehlerDifferential.mapBaseChange ↥R ↥A ↥C) x') =
      exteriorPower.map a E
        (exteriorPower.map a (KaehlerDifferential.mapBaseChange ↥R ↥A ↥C) y') := by
    rw [← hpt x', ← hpt y', hx', hy', hxy]
  rw [← hx', ← hy', hinj (hEinj hchain)]

end Criterion

/-! ### The base change of the global sections of the differentials -/

section SpecTower

/-- The upper edge `Spec C ⟶ Spec A` of the square attached to a tower of rings. -/
abbrev specTowerTop (A C : CommRingCat.{u}) [Algebra ↥A ↥C] : Spec C ⟶ Spec A :=
  Spec.map (CommRingCat.ofHom (algebraMap ↥A ↥C))

/-- The right-hand edge `Spec A ⟶ Spec R` of the square attached to a tower of rings. -/
abbrev specTowerMid (R A : CommRingCat.{u}) [Algebra ↥R ↥A] : Spec A ⟶ Spec R :=
  Spec.map (CommRingCat.ofHom (algebraMap ↥R ↥A))

/-- The left-hand edge `Spec C ⟶ Spec R` of the square attached to a tower of rings. -/
abbrev specTowerBase (R C : CommRingCat.{u}) [Algebra ↥R ↥C] : Spec C ⟶ Spec R :=
  Spec.map (CommRingCat.ofHom (algebraMap ↥R ↥C))

/-- The inverse image along the upper edge of the sheaf of relative differentials of the
right-hand edge of the square attached to a tower of rings. -/
abbrev specTowerPullbackDifferentials (R A C : CommRingCat.{u}) [Algebra ↥R ↥A]
    [Algebra ↥A ↥C] : (Spec C).Modules :=
  (Scheme.Modules.pullback (specTowerTop A C)).obj
    (Scheme.Hom.relativeDifferentials (specTowerMid R A))

variable (R A C : CommRingCat.{u}) [Algebra ↥R ↥A] [Algebra ↥A ↥C] [Algebra ↥R ↥C]
  [IsScalarTower ↥R ↥A ↥C]

/-- The square attached to a tower of rings commutes, with identity bottom edge. -/
theorem specTowerComm :
    specTowerTop A C ≫ specTowerMid R A = specTowerBase R C ≫ 𝟙 (Spec R) := by
  have h : CommRingCat.ofHom (algebraMap ↥R ↥A) ≫ CommRingCat.ofHom (algebraMap ↥A ↥C) =
      CommRingCat.ofHom (algebraMap ↥R ↥C) := by
    rw [← CommRingCat.ofHom_comp]
    exact congrArg CommRingCat.ofHom (IsScalarTower.algebraMap_eq ↥R ↥A ↥C).symm
  rw [Category.comp_id, ← Spec.map_comp, h]

/-- The `A`-action on sections over `⊤` of a module on `Spec A` agrees with the action of the
image of `b` under the inverse of `ΓSpecIso A`. -/
private theorem inv_hom_smul_Spec_top {A : CommRingCat.{u}} {M : (Spec A).Modules} (b : ↥A)
    (s : Γ(M, ⊤)) : (Scheme.ΓSpecIso A).inv.hom b • s = b • s :=
  (AffineDifferentialsIso.smul_Spec_top _ s).symm.trans
    (congrArg (· • s) (Iso.inv_hom_id_apply (Scheme.ΓSpecIso A) b))

omit [Algebra ↥R ↥C] [IsScalarTower ↥R ↥A ↥C] in
/-- **The global sections of the inverse image of the relative differentials are generated by
the base change of the Kähler differentials.** There is a surjective `C`-linear map from
`C ⊗[A] Ω[A⁄R]` to the global sections of `f^*Ω_{Spec A/Spec R}` carrying `1 ⊗ d b` to the
pullback of the universal relative differential of the global function attached to `b`. -/
theorem exists_pullbackDifferentialsΓBaseChange :
    ∃ T : ↥C ⊗[↥A] Ω[↥A⁄↥R] →ₗ[↥C]
        ↥(moduleSpecΓFunctor.obj (specTowerPullbackDifferentials R A C)),
      Function.Surjective T ∧
        ∀ b : ↥A, T ((1 : ↥C) ⊗ₜ KaehlerDifferential.D ↥R ↥A b) =
          pullbackSectionHom (specTowerTop A C)
            (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top
            ((Scheme.Hom.universalRelativeDerivation (specTowerMid R A)).d
              ((Scheme.ΓSpecIso A).inv.hom b)) := by
  obtain ⟨eA, heA⟩ :=
    AffineDifferentials.exists_specKaehlerEquiv (CommRingCat.ofHom (algebraMap ↥R ↥A)) rfl
  let : Module ↥A Γ(specTowerPullbackDifferentials R A C, (⊤ : (Spec C).Opens)) :=
    Module.compHom _ (algebraMap ↥A ↥C)
  have : IsScalarTower ↥A ↥C Γ(specTowerPullbackDifferentials R A C, (⊤ : (Spec C).Opens)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hsmul : ∀ (b : ↥A) (s : Γ(Scheme.Hom.relativeDifferentials (specTowerMid R A),
        (⊤ : (Spec A).Opens))),
      pullbackSectionHom (specTowerTop A C)
          (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top (b • s) =
        b • pullbackSectionHom (specTowerTop A C)
          (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top s := by
    intro b s
    have h1 := pullbackSectionHom_smul (specTowerTop A C)
      (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top
      ((Scheme.ΓSpecIso A).inv.hom b) s
    have h2 : ((specTowerTop A C).appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso A).inv.hom b) =
        (Scheme.ΓSpecIso C).inv.hom (algebraMap ↥A ↥C b) :=
      specMap_appLE_ΓSpecIso_inv (specTowerTop A C) rfl b
    rw [← inv_hom_smul_Spec_top, h1, h2, inv_hom_smul_Spec_top]
    rfl
  let t : Ω[↥A⁄↥R] →ₗ[↥A]
      Γ(specTowerPullbackDifferentials R A C, (⊤ : (Spec C).Opens)) :=
    { toFun := fun ω => pullbackSectionHom (specTowerTop A C)
        (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top (eA ω)
      map_add' := fun ω ω' =>
        (congrArg (fun z => pullbackSectionHom (specTowerTop A C)
            (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top z)
          (map_add eA ω ω')).trans (map_add _ _ _)
      map_smul' := fun b ω =>
        (congrArg (fun z => pullbackSectionHom (specTowerTop A C)
            (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top z)
          (map_smul eA b ω)).trans (hsmul b (eA ω)) }
  refine ⟨t.liftBaseChange ↥C, ?_, fun b => ?_⟩
  · have hspan := span_pullbackSection_eq_top (specTowerTop A C)
      (Scheme.Hom.relativeDifferentials (specTowerMid R A)) (isAffineOpen_top (Spec A))
      (isAffineOpen_top (Spec C)) (le_top (a := (⊤ : (Spec C).Opens)))
    intro x
    have hx : x ∈ Submodule.span ↥Γ(Spec C, ⊤)
        (Set.range fun s => pullbackSectionHom (specTowerTop A C)
          (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top s) := by
      rw [hspan]; trivial
    induction hx using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨s, rfl⟩ := hz
        exact ⟨(1 : ↥C) ⊗ₜ eA.symm s, (LinearMap.liftBaseChange_one_tmul ↥C t (eA.symm s)).trans
          (congrArg (fun w => pullbackSectionHom (specTowerTop A C)
            (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top w)
            (eA.apply_symm_apply s))⟩
    | zero => exact ⟨0, map_zero _⟩
    | add z w _ _ ihz ihw =>
        obtain ⟨u, hu⟩ := ihz
        obtain ⟨v, hv⟩ := ihw
        exact ⟨u + v, (map_add _ u v).trans (congrArg₂ (fun x y => x + y) hu hv)⟩
    | smul r z _ ihz =>
        obtain ⟨u, hu⟩ := ihz
        exact ⟨(Scheme.ΓSpecIso C).hom.hom r • u,
          (map_smul (t.liftBaseChange ↥C) ((Scheme.ΓSpecIso C).hom.hom r) u).trans
            ((congrArg (fun w => (Scheme.ΓSpecIso C).hom.hom r • w) hu).trans
              (AffineDifferentialsIso.smul_Spec_top r z))⟩
  · exact (LinearMap.liftBaseChange_one_tmul ↥C t (KaehlerDifferential.D ↥R ↥A b)).trans
      (congrArg (fun w => pullbackSectionHom (specTowerTop A C)
        (Scheme.Hom.relativeDifferentials (specTowerMid R A)) ⊤ ⊤ le_top w) (heA b))

/-- **The canonical map on `a`-forms of the square attached to a tower of rings is a
monomorphism as soon as the `a`-th exterior power of `KaehlerDifferential.mapBaseChange` is
injective.** -/
theorem mono_relativeDifferentialFormsMap_specTower (a : ℕ)
    (hinj : Function.Injective
      (exteriorPower.map a (KaehlerDifferential.mapBaseChange ↥R ↥A ↥C))) :
    Mono (Scheme.Hom.relativeDifferentialFormsMap (specTowerTop A C) (specTowerMid R A)
      (specTowerBase R C) (𝟙 (Spec R)) (specTowerComm R A C) (a : ℤ)) := by
  obtain ⟨T, hTsurj, hT⟩ := exists_pullbackDifferentialsΓBaseChange R A C
  obtain ⟨eC, heC⟩ :=
    AffineDifferentials.exists_specKaehlerEquiv (CommRingCat.ofHom (algebraMap ↥R ↥C)) rfl
  exact mono_relativeDifferentialFormsMap_of_injective _ rfl (specTowerComm R A C) a T
    eC.toLinearMap hT heC hTsurj eC.symm.toLinearMap (LinearMap.ext eC.symm_apply_apply) hinj

end SpecTower

end Stacks.AlgebraicGeometry.AffineDifferentialForms

