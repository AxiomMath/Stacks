module

public import Mathlib.RingTheory.Ideal.MinimalPrime.Localization
public import Mathlib.RingTheory.Localization.LocalizationLocalization
public import Mathlib.RingTheory.Spectrum.Prime.Topology
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The total quotient ring as a product of localizations at the minimal primes

Let `R` be a commutative ring with finitely many minimal primes `p i`, and suppose that the
nonzerodivisors of `R` are exactly the elements lying outside all of them. Then the total
quotient ring of `R` is the product of the localizations of `R` at the `p i`.

This is the commutative-algebra content of the generic-point decomposition of the sheaf of
meromorphic functions (Stacks Tags 0EMF, 02OW, 0EMH): at a point `x` of a scheme the minimal
primes of the local ring correspond to the generic points specializing to `x`, and the
hypothesis on the nonzerodivisors is the statement that the weakly associated points of the
scheme are generic points.

## Main definitions

* `Stacks.AlgebraicGeometry.GenericPointGluing.specEquiv`: the index set of the family of
  minimal primes is in bijection with the prime spectrum of the total quotient ring.
* `Stacks.AlgebraicGeometry.GenericPointGluing.totalQuotientAlgEquivPi`: the resulting
  `R`-algebra isomorphism from the total quotient ring to the product.

## Main results

* `Stacks.AlgebraicGeometry.GenericPointGluing.isLocalization_nonZeroDivisors_pi`: the product
  of the localizations is a localization of `R` at its nonzerodivisors.

## Implementation notes

The hard half of the decomposition is Mathlib's
`PrimeSpectrum.toPiLocalizationEquiv`, which writes a ring whose prime spectrum is discrete as
the product of its localizations at its primes. The work here is to verify that hypothesis for
the total quotient ring `Localization R⁰`: its primes are exactly the extensions of the `p i`,
by prime avoidance applied to a prime disjoint from the nonzerodivisors, and they are pairwise
incomparable, so each of them is maximal.

The transport of an `IsLocalization.AtPrime` instance along an equality of primes is done with
an explicit `cast`, because `Ideal.primeCompl` takes the primality of its argument as an
instance argument and so `rw` produces an ill-typed motive.
-/

@[expose] public section

open scoped nonZeroDivisors

universe u v w

namespace Stacks.AlgebraicGeometry.GenericPointGluing

variable {R : Type u} [CommRing R] {ι : Type v} [Finite ι]
  (p : ι → Ideal R) [∀ i, (p i).IsPrime]

omit [Finite ι] [∀ i, (p i).IsPrime] in
/-- Each member of the family is disjoint from the nonzerodivisors. -/
theorem disjoint_nonZeroDivisors (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) (i : ι) :
    Disjoint ((R⁰ : Submonoid R) : Set R) ((p i : Ideal R) : Set R) :=
  Set.disjoint_left.2 fun _ hr hri ↦ (hzd _).1 hr i hri

/-- A prime disjoint from the nonzerodivisors is one of the `p i`. -/
theorem exists_eq_of_isPrime_disjoint
    (hmin : ∀ i, p i ∈ minimalPrimes R)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i)
    (q : Ideal R) (hq : q.IsPrime)
    (hdisj : Disjoint ((R⁰ : Submonoid R) : Set R) ((q : Ideal R) : Set R)) :
    ∃ i, q = p i := by
  rcases isEmpty_or_nonempty ι with hι | ⟨⟨j⟩⟩
  · have h0 : (0 : R) ∈ R⁰ := (hzd 0).2 fun i ↦ (IsEmpty.false i).elim
    have h1 : (1 : R) = 0 := (mem_nonZeroDivisors_iff.1 h0).1 1 (zero_mul 1)
    exact absurd ((Ideal.eq_top_iff_one q).2 (h1 ▸ q.zero_mem)) hq.ne_top
  · cases nonempty_fintype ι
    have hsub : (q : Set R) ⊆ ⋃ i ∈ (Finset.univ : Finset ι), ((p i : Ideal R) : Set R) := by
      intro r hr
      have hnr : r ∉ R⁰ := fun hr' ↦ Set.disjoint_left.1 hdisj hr' hr
      obtain ⟨i, hi⟩ := not_forall.1 fun H ↦ hnr ((hzd r).2 H)
      exact Set.mem_biUnion (Finset.mem_univ i) (not_not.1 hi)
    obtain ⟨i, -, hle⟩ := (Ideal.subset_union_prime j j fun i _ _ _ ↦ inferInstance).1 hsub
    exact ⟨i, le_antisymm hle ((hmin i).2 ⟨hq, bot_le⟩ hle)⟩

/-- Every prime of the total quotient ring contracts to one of the `p i`. -/
private theorem exists_under_eq_of_isPrime
    (hmin : ∀ i, p i ∈ minimalPrimes R)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i)
    (Q : Ideal (Localization R⁰)) (hQ : Q.IsPrime) : ∃ i, Q.under R = p i :=
  let h := (IsLocalization.isPrime_iff_isPrime_disjoint R⁰ _ Q).1 hQ
  exists_eq_of_isPrime_disjoint p hmin hzd _ h.1 h.2

/-- The prime of the total quotient ring generated by `p i`. -/
def specOf (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) (i : ι) :
    PrimeSpectrum (Localization R⁰) :=
  ⟨(p i).map (algebraMap R (Localization R⁰)),
    IsLocalization.isPrime_of_isPrime_disjoint R⁰ _ (p i) inferInstance
      (disjoint_nonZeroDivisors p hzd i)⟩

omit [Finite ι] in
/-- The contraction to `R` of the prime `specOf p hzd i` is `p i`. -/
@[simp] theorem under_specOf (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) (i : ι) :
    (specOf p hzd i).asIdeal.under R = p i :=
  IsLocalization.under_map_of_isPrime_disjoint R⁰ _ inferInstance
    (disjoint_nonZeroDivisors p hzd i)

/-- If the `p i` are pairwise distinct minimal primes, then `specOf p hzd` is a bijection from
`ι` onto the prime spectrum of the total quotient ring. -/
theorem specOf_bijective
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) :
    Function.Bijective (specOf p hzd) := by
  refine ⟨fun i j hij ↦ hpinj ?_, fun Q ↦ ?_⟩
  · rw [← under_specOf p hzd i, ← under_specOf p hzd j, hij]
  obtain ⟨i, hi⟩ := exists_under_eq_of_isPrime p hmin hzd _ Q.2
  refine ⟨i, PrimeSpectrum.ext ?_⟩
  rw [show (specOf p hzd i).asIdeal = (p i).map (algebraMap R (Localization R⁰)) from rfl,
    ← hi, IsLocalization.map_under R⁰ (Localization R⁰)]

/-- The index set of the family of minimal primes is in bijection with the prime spectrum of
the total quotient ring. -/
noncomputable def specEquiv
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) :
    ι ≃ PrimeSpectrum (Localization R⁰) :=
  Equiv.ofBijective _ (specOf_bijective p hmin hpinj hzd)

/-- The contraction to `R` of the prime `specEquiv p hmin hpinj hzd i` is `p i`. -/
theorem under_specEquiv
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) (i : ι) :
    Ideal.under R (specEquiv p hmin hpinj hzd i).asIdeal = p i := under_specOf p hzd i

omit [Finite ι] [∀ i, (p i).IsPrime] in
/-- Equal primes have equal complements. -/
theorem primeCompl_congr {P Q : Ideal R} [P.IsPrime] [Q.IsPrime] (h : P = Q) :
    P.primeCompl = Q.primeCompl := by
  subst h
  rfl

/-- The prime spectrum of the total quotient ring of `R` is finite. -/
theorem finite_primeSpectrum
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) :
    Finite (PrimeSpectrum (Localization R⁰)) :=
  Finite.of_equiv _ (specEquiv p hmin hpinj hzd)

/-- Every prime of the total quotient ring is maximal. -/
theorem isMaximal_of_isPrime
    (hmin : ∀ i, p i ∈ minimalPrimes R)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i)
    (Q : Ideal (Localization R⁰)) (hQ : Q.IsPrime) : Q.IsMaximal := by
  obtain ⟨M, hM, hQM⟩ := Q.exists_le_maximal hQ.ne_top
  obtain ⟨i, hi⟩ := exists_under_eq_of_isPrime p hmin hzd Q hQ
  obtain ⟨j, hj⟩ := exists_under_eq_of_isPrime p hmin hzd M hM.isPrime
  have hle : p i ≤ p j := by
    rw [← hi, ← hj]
    exact Ideal.comap_mono hQM
  have hQeq : Q = M := by
    rw [← IsLocalization.map_under R⁰ (Localization R⁰) Q,
      ← IsLocalization.map_under R⁰ (Localization R⁰) M, hi, hj,
      le_antisymm hle ((hmin j).2 ⟨inferInstance, bot_le⟩ hle)]
  exact hQeq ▸ hM

/-- The prime spectrum of the total quotient ring is discrete. -/
theorem discreteTopology_primeSpectrum
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) :
    DiscreteTopology (PrimeSpectrum (Localization R⁰)) :=
  PrimeSpectrum.discreteTopology_iff_finite_and_krullDimLE_zero.2
    ⟨finite_primeSpectrum p hmin hpinj hzd,
      Ring.KrullDimLE.mk₀ (isMaximal_of_isPrime p hmin hzd)⟩

variable (A : ι → Type w) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)]
  [∀ i, IsLocalization.AtPrime (A i) (p i)]

/-- The total quotient ring of `R` is the product of the localizations of `R` at the `p i`. -/
noncomputable def totalQuotientAlgEquivPi
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) :
    Localization R⁰ ≃ₐ[R] ∀ i, A i := by
  haveI := discreteTopology_primeSpectrum p hmin hpinj hzd
  haveI hat : ∀ i, IsLocalization.AtPrime
      (Localization (specEquiv p hmin hpinj hzd i).asIdeal.primeCompl) (p i) := by
    intro i
    have h' : IsLocalization
        (Ideal.under R (specEquiv p hmin hpinj hzd i).asIdeal).primeCompl
        (Localization (specEquiv p hmin hpinj hzd i).asIdeal.primeCompl) :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization R⁰ _
        (specEquiv p hmin hpinj hzd i).asIdeal
    change IsLocalization (p i).primeCompl _
    exact cast (congrArg (fun M ↦ IsLocalization M
      (Localization (specEquiv p hmin hpinj hzd i).asIdeal.primeCompl))
      (primeCompl_congr (under_specEquiv p hmin hpinj hzd i))) h'
  exact ((PrimeSpectrum.toPiLocalizationEquiv (Localization R⁰)).restrictScalars R).trans
    (((AlgEquiv.piCongrLeft R (fun Q : PrimeSpectrum (Localization R⁰) ↦
        Localization Q.asIdeal.primeCompl) (specEquiv p hmin hpinj hzd)).symm).trans
      (AlgEquiv.piCongrRight fun i ↦
        IsLocalization.algEquiv (p i).primeCompl _ (A i)))

/-- If the minimal primes of `R` are finite in number and the nonzerodivisors of `R` are
exactly the elements outside all of them, then the product of the localizations of `R` at the
minimal primes is a localization of `R` at its nonzerodivisors, that is, a total quotient
ring of `R`. -/
theorem isLocalization_nonZeroDivisors_pi
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hzd : ∀ r : R, r ∈ R⁰ ↔ ∀ i, r ∉ p i) :
    IsLocalization R⁰ (∀ i, A i) :=
  IsLocalization.isLocalization_of_algEquiv R⁰
    (totalQuotientAlgEquivPi p A hmin hpinj hzd)

section Reduced

variable (R) in
/-- In a reduced ring the nonzerodivisors are exactly the elements lying in no minimal prime. -/
@[ega "IV 20.1.3.1" "special case"]
theorem mem_nonZeroDivisors_iff_forall_notMem_minimalPrimes [IsReduced R] (r : R) :
    r ∈ R⁰ ↔ ∀ q ∈ minimalPrimes R, r ∉ q := by
  refine ⟨fun hr q hq hrq ↦ notMem_nonZeroDivisors_of_mem_mem_minimalPrimes hrq hq hr,
    fun hr ↦ ?_⟩
  have key : ∀ s : R, r * s = 0 → s = 0 := fun s hs ↦ by
    have hsInf : s ∈ sInf (minimalPrimes R) := Ideal.mem_sInf.2 fun q hq ↦
      (hq.1.1.mem_or_mem (by simp [hs])).resolve_left (hr q hq)
    rwa [show minimalPrimes R = (⊥ : Ideal R).minimalPrimes from rfl,
      Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced, Ideal.mem_bot] at hsInf
  exact mem_nonZeroDivisors_iff.2 ⟨key, fun s hs ↦ key s (by rwa [mul_comm])⟩

/-- If a finite family of pairwise distinct primes enumerates exactly the minimal primes of a
reduced ring `R`, then the product of the localizations of `R` at them is a localization of `R`
at its nonzerodivisors. -/
@[ega "IV 20.1.3.1" "special case"]
theorem isLocalization_nonZeroDivisors_pi_of_isReduced [IsReduced R]
    (hmin : ∀ i, p i ∈ minimalPrimes R) (hpinj : Function.Injective p)
    (hsurj : ∀ q ∈ minimalPrimes R, ∃ i, p i = q) :
    IsLocalization R⁰ (∀ i, A i) :=
  isLocalization_nonZeroDivisors_pi p A hmin hpinj fun r ↦
    ⟨fun hr i ↦ (mem_nonZeroDivisors_iff_forall_notMem_minimalPrimes R r).1 hr _ (hmin i),
      fun hr ↦ (mem_nonZeroDivisors_iff_forall_notMem_minimalPrimes R r).2 fun q hq hrq ↦
        (hsurj q hq).elim fun i hi ↦ hr i (hi ▸ hrq)⟩

end Reduced

end Stacks.AlgebraicGeometry.GenericPointGluing
