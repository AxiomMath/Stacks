module

public import StacksFrontier.CategoryTheory.Triangulated.BoundedWindows
public import StacksFrontier.CategoryTheory.Triangulated.Generators

/-!
# Carrying one diagonal presentation through a family of exact functors with a uniform window

Let `C` and `D` be pretriangulated categories, let `box` and `diag` be objects of `C` with `diag`
in the triangulated subcategory `⟨box⟩` generated by `box`, and let `G` be an object of `D`.
Suppose a family of exact functors `Ψ i : C ⥤ D` sends `box` into
`smd(add(G[c, d]))` for one window `[c, d]` independent of `i`. Then there are `m, n ≥ 1` such
that every `Ψ i (diag)` lies in `smd(add(G[-m, m])^{⋆ n})`, with `m` and `n` independent of `i`.

This is the uniformity argument of the proof of [Stacks, Tag 0FZ7], isolated from the geometry:
there `C = D(𝒪_{X × X})`, `D = D(𝒪_X)`, `box = ℰ ⊠ 𝒢`, `diag = 𝒪_Δ`, the family is indexed by
the coherent `𝒪_X`-modules `ℱ` with `Ψ_ℱ = R pr_{2,*}(L pr_1^* ℱ ⊗^𝐋 −)`, and `Ψ_ℱ(𝒪_Δ) ≅ ℱ`.

## The mechanism

The level `n₀` and the half-width `m₀` are read off the single object `diag` by
[Stacks, Tag 0ATG] and [Stacks, Tag 0FX9]; this per-object existential is harmless because there
is only one object. The window `[-m₀, m₀]` and the level `n₀` are then carried along each `Ψ i`
unchanged by [Stacks, Tag 0FX5]
(`retractClosure_extensionProductIter_biSup_shift_inverseImage_of_le`), the nested `smd(add(−))`
is absorbed with the two windows adding up
(`retractClosure_extensionProductIter_biSup_shift_retractClosure_le`, [Stacks, Tag 0FX2] and
[Stacks, Tag 0FX4]), and the result is widened to a symmetric window and a level at least one.

## Main results

* `exists_uniform_retractClosure_extensionProductIter_of_triangEnvelope`: the uniform transfer
  described above.

## References

* [Stacks Project, Tag 0FZ7](https://stacks.math.columbia.edu/tag/0FZ7)
* [Stacks Project, Tag 0ATG](https://stacks.math.columbia.edu/tag/0ATG)
* [Stacks Project, Tag 0FX2](https://stacks.math.columbia.edu/tag/0FX2)
* [Stacks Project, Tag 0FX4](https://stacks.math.columbia.edu/tag/0FX4)
* [Stacks Project, Tag 0FX5](https://stacks.math.columbia.edu/tag/0FX5)
* [Stacks Project, Tag 0FX9](https://stacks.math.columbia.edu/tag/0FX9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

namespace Stacks.TriangulatedGenerators

variable {C D : Type*} [Category C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  [Category D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

/-- The subcategory `smd(add(E[c, d])^{⋆ n})` grows with the window and with the number of
extensions, as soon as the larger window contains an object: widening `[c, d]` is monotonicity
of the closure operations, and raising `n` uses that `smd(add(E[c₀, d₀]))` then contains a zero
object. -/
theorem retractClosure_extensionProductIter_biSup_shift_mono (E : ObjectProperty D)
    {c d c₀ d₀ : ℤ} (hc : c₀ ≤ c) (hd : d ≤ d₀) {n n₀ : ℕ} (hn : n ≤ n₀)
    (hne : (⨆ i ∈ Set.Icc c₀ d₀, E.isoClosure.shift i).Nonempty) :
    ((⨆ i ∈ Set.Icc c d, E.isoClosure.shift i).binaryProductsClosure.extensionProductIter n
      ).retractClosure ≤
      ((⨆ i ∈ Set.Icc c₀ d₀, E.isoClosure.shift i).binaryProductsClosure.extensionProductIter n₀
        ).retractClosure := by
  have := hne
  have hwin : (⨆ i ∈ Set.Icc c d, E.isoClosure.shift i) ≤
      ⨆ i ∈ Set.Icc c₀ d₀, E.isoClosure.shift i :=
    iSup₂_le fun i hi => le_iSup₂_of_le i (Set.Icc_subset_Icc hc hd hi) le_rfl
  refine (monotone_retractClosure (monotone_extensionProductIter
    (limitsClosure_monotone _ hwin) n)).trans ?_
  rw [← retractClosure_extensionProductIter_retractClosure,
    ← retractClosure_extensionProductIter_retractClosure (n := n₀)]
  exact monotone_retractClosure (monotone'_extensionProductIter _ hn)

/-- **A diagonal presentation carried through a family of exact functors, with a uniform
window.** Let `diag` lie in the triangulated subcategory generated by `box`, and let
`Ψ i : C ⥤ D` be exact functors, each sending `box` into `smd(add(G[c, d]))` for one window
`[c, d]` not depending on `i`. If `Y i ≅ Ψ i (diag)` for each `i`, then there are `m, n ≥ 1`,
not depending on `i`, with every `Y i` in `smd(add(G[-m, m])^{⋆ n})`.

This is the uniformity step of [Stacks, Tag 0FZ7]. The level and the half-width are read off
the single object `diag` ([Stacks, Tag 0ATG], [Stacks, Tag 0FX9]) and transported along each
`Ψ i` with the window kept fixed ([Stacks, Tag 0FX5]). -/
theorem exists_uniform_retractClosure_extensionProductIter_of_triangEnvelope
    {ι : Type*} (Ψ : ι → C ⥤ D) [∀ i, (Ψ i).CommShift ℤ] [∀ i, (Ψ i).IsTriangulated]
    (box diag : C) (hdiag : (ObjectProperty.singleton box).triangEnvelope diag)
    (G : D) (c d : ℤ) (Y : ι → D) (hY : ∀ i, Nonempty ((Ψ i).obj diag ≅ Y i))
    (hbox : ∀ i, ((⨆ j ∈ Set.Icc c d,
      (ObjectProperty.singleton G).isoClosure.shift j).binaryProductsClosure).retractClosure
        ((Ψ i).obj box)) :
    ∃ m n : ℕ, 1 ≤ m ∧ 1 ≤ n ∧ ∀ i,
      ((⨆ j ∈ Set.Icc (-(m : ℤ)) (m : ℤ), (ObjectProperty.singleton G).isoClosure.shift j
        ).binaryProductsClosure.extensionProductIter n).retractClosure (Y i) := by
  -- The level `n₀` and the half-width `m₀`, read off the single object `diag`.
  obtain ⟨n₀, hn₀⟩ := ((ObjectProperty.singleton box).prop_triangEnvelope_iff diag).1 hdiag
  rw [ObjectProperty.triangEnvelopeIter_eq_iSup_retractClosure_extensionProductIter,
    ObjectProperty.prop_iSup_iff] at hn₀
  obtain ⟨m₀, hm₀⟩ := hn₀
  set t : ℕ := max c.natAbs d.natAbs
  have hct : -(t : ℤ) ≤ c := by omega
  have hdt : d ≤ (t : ℤ) := by omega
  refine ⟨max 1 (m₀ + t), max 1 n₀, le_max_left _ _, le_max_left _ _, fun i => ?_⟩
  -- Every window around zero contains `G` itself.
  have hne : (⨆ j ∈ Set.Icc (-((max 1 (m₀ + t) : ℕ) : ℤ)) ((max 1 (m₀ + t) : ℕ) : ℤ),
      (ObjectProperty.singleton G).isoClosure.shift j).Nonempty := by
    refine ObjectProperty.nonempty_of_prop (X := G) ((prop_iSup_iff _ _).2 ⟨0,
      (prop_iSup_iff _ _).2 ⟨Set.mem_Icc.2 ⟨by omega, by omega⟩, ?_⟩⟩)
    exact ⟨G, (ObjectProperty.singleton_iff _ _).2 rfl, ⟨(shiftFunctorZero _ ℤ).app G⟩⟩
  -- Carry `diag ∈ smd(add(box[-m₀, m₀])^{⋆ n₀})` along `Ψ i`, keeping window and level.
  have hK := retractClosure_extensionProductIter_biSup_shift_inverseImage_of_le (Ψ i)
      (P := ObjectProperty.singleton box)
      (Q := ((⨆ j ∈ Set.Icc c d,
        (ObjectProperty.singleton G).isoClosure.shift j).binaryProductsClosure).retractClosure)
      (fun Z hZ => by
        obtain rfl := (ObjectProperty.singleton_iff _ _).1 hZ
        exact hbox i)
      (-(m₀ : ℤ)) (m₀ : ℤ) n₀ _ hm₀
  -- Absorb the nested `smd(add(−))`; the windows add up to `[c - m₀, d + m₀]`.
  have hcollapse := retractClosure_extensionProductIter_biSup_shift_retractClosure_le
      (ObjectProperty.singleton G) c d (-(m₀ : ℤ)) (m₀ : ℤ) n₀ _ hK
  have hwide := retractClosure_extensionProductIter_biSup_shift_mono
    (ObjectProperty.singleton G)
    (c := c + -(m₀ : ℤ)) (d := d + (m₀ : ℤ))
    (c₀ := -((max 1 (m₀ + t) : ℕ) : ℤ)) (d₀ := ((max 1 (m₀ + t) : ℕ) : ℤ))
    (by omega) (by omega) (n := n₀) (n₀ := max 1 n₀) (le_max_right _ _) hne _ hcollapse
  exact ObjectProperty.prop_of_iso _ (hY i).some hwide

end Stacks.TriangulatedGenerators

end
