namespace Stacks.TriangulatedGenerators

/-! ### The stages of the triangulated envelope along an exact functor -/

section Transfer

variable {C D : Type*} [Category C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  [Category D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

/-- The zeroth stage `⟨Q⟩₀ = smd(add(Q[-∞, ∞]))` of the triangulated envelope is closed under
binary products. -/
private lemma isClosedUnderBinaryProducts_triangEnvelopeIter_zero (Q : ObjectProperty D) :
    (Q.triangEnvelopeIter 0).IsClosedUnderBinaryProducts := by
  have h := isClosedUnderBinaryProducts_retractClosure (Q.shiftClosure ℤ).binaryProductsClosure
  rwa [← Q.triangEnvelopeIter_zero] at h

variable (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]

/-- **The stages of the triangulated envelope are functorial along an exact functor.** Let
`F : C ⥤ D` be an exact functor of pretriangulated categories, `P` a property of objects of `C`
and `Q` one of `D`. If `F` carries every object satisfying `P` into the zeroth stage
`⟨Q⟩₀ = smd(add(Q[-∞, ∞]))`, then it carries the `n`-th stage `⟨P⟩ₙ` into `⟨Q⟩ₙ`, for every `n`.

This is the functoriality of `smd(add(−)^{⋆ n})` used in [Stacks, Tag 0FZ6] and recorded in the
source as Derived Categories, Remark 13.35.5 ([Stacks, Tag 0FX5]). -/
theorem triangEnvelopeIter_inverseImage_of_le {P : ObjectProperty C} {Q : ObjectProperty D}
    (h : P ≤ (Q.triangEnvelopeIter 0).inverseImage F) (n : ℕ) :
    P.triangEnvelopeIter n ≤ (Q.triangEnvelopeIter n).inverseImage F := by
  have hret : ∀ m : ℕ, ((Q.triangEnvelopeIter m).inverseImage F).IsStableUnderRetracts :=
    fun m => isStableUnderRetracts_inverseImage _ F
  have base : P.triangEnvelopeIter 0 ≤ (Q.triangEnvelopeIter 0).inverseImage F := by
    have := hret 0
    have := isClosedUnderBinaryProducts_triangEnvelopeIter_zero Q
    have := isClosedUnderBinaryProducts_inverseImage F (Q.triangEnvelopeIter 0)
    rw [triangEnvelopeIter_zero, retractClosure_le_iff]
    exact limitsClosure_le (by rwa [shiftClosure_le_iff])
  induction n with
  | zero => exact base
  | succ n ih =>
    have := hret (n + 1)
    rw [triangEnvelopeIter_succ, retractClosure_le_iff]
    rintro Z ⟨A, B, a, b, c, hT, hA, hB⟩
    have hA0 : P.triangEnvelopeIter 0 A := by rwa [triangEnvelopeIter_zero]
    have hFA : (Q.triangEnvelopeIter 0) (F.obj A) := base A hA0
    have hFB : (Q.triangEnvelopeIter n) (F.obj B) := ih B hB
    have hFT := F.map_distinguished _ hT
    rw [prop_inverseImage_iff, triangEnvelopeIter_succ]
    exact le_retractClosure _ _
      ⟨F.obj A, F.obj B, F.map a, F.map b, _, hFT, by rwa [← triangEnvelopeIter_zero], hFB⟩

end Transfer

/-! ### The conclusion rejects the zero object -/

section Degenerate

variable {C : Type*} [Category C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- **Only a zero category is strongly generated by its zero object.** If the singleton of a zero
object of `C` is a strong generator — indeed already if it is a classical generator — then every
object of `C` is zero. So the conclusion of [Stacks, Tag 0FZ6] is not met by the degenerate
witness `𝒢 = 0` unless `D_perf(𝒪_X)` itself vanishes. -/
theorem isZero_of_isStrongTriangulatedGenerator_zero
    (h : (ObjectProperty.singleton (0 : C)).IsStrongTriangulatedGenerator) (K : C) : IsZero K := by
  refine IsClassicalTriangulatedGenerator.isZero_of_rightOrthogonal_shiftClosure
    h.isClassicalTriangulatedGenerator ?_
  intro Z g hZ
  obtain ⟨W, A, e, hW⟩ := hZ
  obtain rfl := (ObjectProperty.singleton_iff _ _).1 hW
  exact ((Functor.map_isZero (shiftFunctor C A) (isZero_zero C)).of_iso e).eq_of_src g 0

end Degenerate

end Stacks.TriangulatedGenerators

namespace AlgebraicGeometry

open Stacks.Cohomology.PerfectComplexes

/-- **Perfect objects of the locally small derived category of `𝒪_X`-modules form a triangulated
subcategory.** This is the ringed-space statement
`Stacks.Cohomology.PerfectTriangulatedSubcategory.isTriangulated_isPerfect`, read on the ringed
space underlying `X` at the locally small localization universe at which
`AlgebraicGeometry.perfectDerived` is formed. The universe arguments are written out because the
level of the derived-category instance is not something unification will read off the value. -/
theorem isTriangulated_isPerfect_locallySmall (X : Scheme.{u}) :
    ObjectProperty.IsTriangulated
      (fun K : DerivedCategory X.Modules => IsPerfect (X := X.toRingedSpace) K) :=
  @Stacks.Cohomology.PerfectTriangulatedSubcategory.isTriangulated_isPerfect.{u, u}
    X.toRingedSpace inferInstance

attribute [local instance] isTriangulated_isPerfect_locallySmall

/-- **[Stacks, Tag 0FZ6].** Let `k` be a field and let `X` be a scheme proper and smooth over
`k`. Then `D_perf(𝒪_X)` has a strong generator.

The two external inputs of the source's proof are carried. `hdiag` is the conclusion of
[Stacks, Tag 0FZ5]: the structure sheaf `𝒪_Δ` of the diagonal lies in the triangulated
subcategory generated by a single external tensor product `ℰ ⊠ 𝒢` of finite locally free modules,
here abstracted to objects `diag` and `box` of `D(𝒪_{X × X})`. The family `Φ` with `hdiagΦ` and
`hboxΦ` is the Fourier–Mukai functor `Φ_K = R pr_{2,*}(L pr_1^* K ⊗^𝐋 −)` together with the two
computations the source makes with it: `Φ_K(𝒪_Δ) = K` and `Φ_K(ℰ ⊠ 𝒢) = RΓ(X, K ⊗^𝐋 ℰ) ⊗_k 𝒢`,
the latter already recorded as membership in `⟨𝒢⟩₀`, which is where properness of `X` enters
through the finite dimensionality of the cohomology.

What is proved here is the rest: that these inputs make `𝒢` a *strong* generator, with a level
`n` independent of the perfect complex `K` because it is read off the single object `𝒪_Δ`. -/
@[stacks 0FZ6 "the source's proof with its two external inputs carried, and its uniformity \
argument proved. Carried: (1) `hdiag`, the conclusion of Stacks 0FZ5 — proved as \
`AlgebraicGeometry.exists_externalTensor_triangEnvelope_diagonal`, \
itself carrying six hypotheses — with \
`box` for `ℰ ⊠ 𝒢` and `diag` for `𝒪_Δ`; (2) `Φ`, `hdiagΦ`, `hboxΦ`: the Fourier–Mukai family \
`R pr_{2,*}(L pr_1^* K ⊗^𝐋 −)` with `Φ_K(𝒪_Δ) ≅ K` and `Φ_K(ℰ ⊠ 𝒢) ∈ ⟨𝒢⟩₀`, neither of which \
the library has — Stacks 0FYV as formalized (base-only) explicitly does \
NOT cover `Φ_{𝒪_Δ} = id`, which needs Stacks 0B55 for a projection, proved only for closed \
embeddings, and Stacks 08EU as formalized (StacksFrontier/Topology/Sheaves/Cohomology/\
DerivedPushforward/ProjectionFormulaInvertibility.lean:249, base-only) \
covers only the base case `K = 𝒪_Y[0]`. Claimed: that `𝒢` is a STRONG generator, Stacks \
09SJ(2), with the level uniform in `K` because it is read off the single object `𝒪_Δ`; and the \
functoriality of the stages `⟨−⟩ₙ` along an exact functor, the content of Stacks 0FX5, proved \
here as `Stacks.TriangulatedGenerators.triangEnvelopeIter_inverseImage_of_le`. Disclaimed: the \
construction of `ℰ`, `𝒢`, `Φ` and the two identities; accordingly this proof consumes neither \
properness nor smoothness directly — both enter only through the carried hypotheses"]
theorem isStrongTriangulatedGenerator_of_diagonalEnvelope {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f] [Smooth f] (G : perfectDerived X)
    (box diag : DerivedCategory (pullback f f).Modules)
    (hdiag : (ObjectProperty.singleton box).triangEnvelope diag)
    (Φ : perfectDerived X → DerivedCategory (pullback f f).Modules ⥤ perfectDerived X)
    [∀ K, (Φ K).CommShift ℤ] [∀ K, (Φ K).IsTriangulated]
    (hdiagΦ : ∀ K, (Φ K).obj diag ≅ K)
    (hboxΦ : ∀ K, ((ObjectProperty.singleton G).triangEnvelopeIter 0) ((Φ K).obj box)) :
    (ObjectProperty.singleton G).IsStrongTriangulatedGenerator := by
  -- The level is read off the single object `𝒪_Δ`, once and for all.
  obtain ⟨n, hn⟩ := ((ObjectProperty.singleton box).prop_triangEnvelope_iff diag).1 hdiag
  refine ⟨n, le_antisymm le_top fun K _ => ?_⟩
  -- Push the membership `𝒪_Δ ∈ ⟨ℰ ⊠ 𝒢⟩ₙ` forward along the exact functor `Φ_K`.
  have hK : ((ObjectProperty.singleton G).triangEnvelopeIter n) ((Φ K).obj diag) :=
    Stacks.TriangulatedGenerators.triangEnvelopeIter_inverseImage_of_le (Φ K)
      (P := ObjectProperty.singleton box) (Q := ObjectProperty.singleton G)
      (fun Y hY => by
        obtain rfl := (ObjectProperty.singleton_iff _ _).1 hY
        exact hboxΦ K) n diag hn
  exact ObjectProperty.prop_of_iso _ (hdiagΦ K) hK

end AlgebraicGeometry

