module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Finite, finitely presented approximations of an integral algebra

Let `R → S` be a ring map.  This file proves the commutative-algebra content of the
approximation theorem for integral algebras: the statement that the sheaf-theoretic
approximation theorem of Stacks tag 0817 reduces to on an affine open.

Two things are proved.

* The `R`-subalgebras of `S` generated by finite sets are directed, their supremum is `⊤`, and
  each of them is a finite `R`-module as soon as `S` is integral over `R`.  This is the affine
  form of part (1) of tag 0817.
* Every such subalgebra is the image of an `R`-algebra which is *simultaneously* a finite
  `R`-module and of finite presentation over `R`, and the approximating algebra may in addition
  be required to satisfy any prescribed finite set of relations that already hold in `S`.  This
  is the affine form of part (2) of tag 0817, and of tag 086N.

The approximating algebra is `R[X_1, …, X_n]` modulo the ideal generated by one monic relation
`p_i(X_i)` for each chosen generator, together with the prescribed extra relations.  The ideal is
finitely generated, which gives finite presentation; the monic relations make the images of the
variables integral, which gives module-finiteness.

The second bullet is stated in the form
`exists_fg_ideal_approximation`, which is what makes the approximating family *cofinal*: the
freedom to absorb prescribed relations is exactly the statement that the kernels of the maps
`T → S` are exhausted, i.e. that the colimit of the approximating system is `S` and not merely a
ring surjecting onto it.

## Main results

* `Stacks.RingTheory.IntegralApproximation.exists_fg_ideal_approximation`: the approximation with
  prescribed relations, by an explicit quotient `MvPolynomial (Fin n) R ⧸ I` with `I` finitely
  generated.
* `Stacks.RingTheory.IntegralApproximation.exists_moduleFinite_finitePresentation_approximation`:
  the same with the approximating algebra left unspecified.
* `Stacks.RingTheory.IntegralApproximation.exists_moduleFinite_finitePresentation_range_eq_adjoin`
  and `..._finset`: the special case of no prescribed relations.
* `Stacks.RingTheory.IntegralApproximation.directed_adjoin_finset`,
  `Stacks.RingTheory.IntegralApproximation.iSup_adjoin_finset` and
  `Stacks.RingTheory.IntegralApproximation.moduleFinite_adjoin_finset`: the module-finite
  subalgebras of an integral algebra are directed with supremum `⊤`.

## Implementation notes

The approximating algebra is produced as an explicit quotient of a polynomial algebra rather
than as an iterated `AdjoinRoot`, so that finite presentation is immediate from
`Algebra.FinitePresentation.quotient`, while module-finiteness follows from
`Algebra.finite_adjoin_of_finite_of_isIntegral` applied to the images of the variables.  No new
definition is introduced: the relation ideal occurs only inside the proofs.

## References

* [Stacks Project, Tag 0817](https://stacks.math.columbia.edu/tag/0817)
* [Stacks Project, Tag 086N](https://stacks.math.columbia.edu/tag/086N)
-/

@[expose] public section

namespace Stacks.RingTheory.IntegralApproximation

universe u v

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- The `R`-subalgebra of `S` generated by a finite family of integral elements is a finite
`R`-module. -/
@[ega "0 1.0.5" "more general", ega "II 6.1.2" "more general", ega "II 6.3.1" "special case"]
theorem moduleFinite_adjoin_range {n : ℕ} (g : Fin n → S) (hg : ∀ i, IsIntegral R (g i)) :
    Module.Finite R (Algebra.adjoin R (Set.range g)) :=
  Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range g) <| by
    rintro _ ⟨i, rfl⟩; exact hg i

/-- **Approximation of an integral algebra, affine form.**  Let `g : Fin n → S` be a finite
family of elements of `S` which are integral over `R`, and let `t` be a finite set of polynomial
relations which hold between them in `S`.  Then there is a finitely generated ideal `I` of
`R[X_1, …, X_n]`, containing `t` and contained in the kernel of the evaluation map, such that the
quotient `R[X_1, …, X_n] ⧸ I` is a finite `R`-module, is of finite presentation over `R`, and maps
onto the `R`-subalgebra of `S` generated by the family.

The ideal is generated by `t` together with one monic relation for each member of the family;
this is the construction used in the proof of [Stacks, Tag 086N] on an affine open.  Allowing an
arbitrary finite `t` is what makes the resulting family of approximations cofinal: any relation
which holds in `S` is already imposed on some member of the family. -/
theorem exists_fg_ideal_approximation
    {n : ℕ} (g : Fin n → S) (hg : ∀ i, IsIntegral R (g i))
    (t : Finset (MvPolynomial (Fin n) R))
    (ht : ∀ F ∈ t, (MvPolynomial.aeval g : MvPolynomial (Fin n) R →ₐ[R] S) F = 0) :
    ∃ I : Ideal (MvPolynomial (Fin n) R), I.FG ∧
      (t : Set (MvPolynomial (Fin n) R)) ⊆ (I : Set (MvPolynomial (Fin n) R)) ∧
      I ≤ RingHom.ker (MvPolynomial.aeval g : MvPolynomial (Fin n) R →ₐ[R] S) ∧
      Module.Finite R (MvPolynomial (Fin n) R ⧸ I) ∧
      Algebra.FinitePresentation R (MvPolynomial (Fin n) R ⧸ I) ∧
      ∃ f : (MvPolynomial (Fin n) R ⧸ I) →ₐ[R] S,
        f.comp (Ideal.Quotient.mkₐ R I) = MvPolynomial.aeval g ∧
        f.range = Algebra.adjoin R (Set.range g) := by
  classical
  choose p hpm hpz using hg
  -- `q i` is the monic relation `p i (X i)` inside the polynomial algebra.
  set q : Fin n → MvPolynomial (Fin n) R := fun i =>
    Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin n) R) (p i) with hqdef
  set I : Ideal (MvPolynomial (Fin n) R) :=
    Ideal.span (Set.range q ∪ (t : Set (MvPolynomial (Fin n) R))) with hIdef
  have hqI : ∀ i, q i ∈ I := fun i => Ideal.subset_span (Or.inl ⟨i, rfl⟩)
  have htI : (t : Set (MvPolynomial (Fin n) R)) ⊆ (I : Set (MvPolynomial (Fin n) R)) :=
    fun _ hF => Ideal.subset_span (Or.inr hF)
  -- Evaluating the variables at `g` kills every generator, hence the whole ideal.
  have hker : I ≤ RingHom.ker (MvPolynomial.aeval g : MvPolynomial (Fin n) R →ₐ[R] S) := by
    rw [hIdef, Ideal.span_le]
    rintro F (⟨i, rfl⟩ | hF)
    · simp only [SetLike.mem_coe, RingHom.mem_ker, hqdef]
      rw [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
      exact hpz i
    · exact ht F hF
  have hkill : ∀ a ∈ I, (MvPolynomial.aeval g : MvPolynomial (Fin n) R →ₐ[R] S) a = 0 :=
    fun _ ha => hker ha
  have hIfg : I.FG := Submodule.fg_span ((Set.finite_range q).union t.finite_toSet)
  have : Algebra.FinitePresentation R (MvPolynomial (Fin n) R) :=
    Algebra.FinitePresentation.mvPolynomial_of_finitePresentation (A := R) (Fin n)
  refine ⟨I, hIfg, htI, hker, ?_, Algebra.FinitePresentation.quotient hIfg,
    Ideal.Quotient.liftₐ I _ hkill, Ideal.Quotient.liftₐ_comp I _ hkill, ?_⟩
  · -- Module-finiteness: the quotient is generated as an `R`-algebra by the images of the
    -- variables, and each of these is integral because the monic `p i` kills it.
    have hXint : ∀ i, IsIntegral R ((Ideal.Quotient.mkₐ R I) (MvPolynomial.X i)) := by
      intro i
      refine ⟨p i, hpm i, ?_⟩
      rw [← Polynomial.aeval_def, Polynomial.aeval_algHom_apply]
      exact (Ideal.Quotient.eq_zero_iff_mem).2 (hqI i)
    have htop :
        Algebra.adjoin R
          (Set.range fun i => (Ideal.Quotient.mkₐ R I) (MvPolynomial.X i)) = ⊤ := by
      have h := AlgHom.map_adjoin (Ideal.Quotient.mkₐ R I)
        (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) R))
      rw [MvPolynomial.adjoin_range_X, Algebra.map_top] at h
      simp only [← Set.range_comp, Function.comp_def] at h
      rw [← h, AlgHom.range_eq_top]
      exact Ideal.Quotient.mkₐ_surjective R I
    have hfin : Module.Finite R
        (Algebra.adjoin R
          (Set.range fun i => (Ideal.Quotient.mkₐ R I) (MvPolynomial.X i))) :=
      moduleFinite_adjoin_range _ hXint
    rw [htop] at hfin
    exact Module.Finite.equiv (Subalgebra.topEquiv (R := R)
      (A := MvPolynomial (Fin n) R ⧸ I)).toLinearEquiv
  · -- The image: the lift has the same image as the evaluation map itself.
    have h := congrArg AlgHom.range (Ideal.Quotient.liftₐ_comp I (MvPolynomial.aeval g) hkill)
    rwa [AlgHom.range_comp, (AlgHom.range_eq_top _).2 (Ideal.Quotient.mkₐ_surjective R I),
      Algebra.map_top, ← Algebra.adjoin_range_eq_range_aeval] at h

/-- **Approximation of an integral algebra, affine form**, with the approximating algebra left
unspecified: a finite family of integral elements of `S`, together with a finite set of relations
holding between them, is approximated by an `R`-algebra `T` which is simultaneously a finite
`R`-module and of finite presentation over `R`, mapping onto the subalgebra the family generates
and already satisfying the prescribed relations.

This is the commutative-algebra content of [Stacks, Tag 0817] (2) and [Stacks, Tag 086N]. -/
theorem exists_moduleFinite_finitePresentation_approximation
    {n : ℕ} (g : Fin n → S) (hg : ∀ i, IsIntegral R (g i))
    (t : Finset (MvPolynomial (Fin n) R))
    (ht : ∀ F ∈ t, (MvPolynomial.aeval g : MvPolynomial (Fin n) R →ₐ[R] S) F = 0) :
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T),
      Module.Finite R T ∧ Algebra.FinitePresentation R T ∧
        ∃ (π : MvPolynomial (Fin n) R →ₐ[R] T) (f : T →ₐ[R] S),
          Function.Surjective π ∧ f.comp π = MvPolynomial.aeval g ∧
          (∀ F ∈ t, π F = 0) ∧ f.range = Algebra.adjoin R (Set.range g) := by
  obtain ⟨I, hIfg, htI, hker, hIfin, hIfp, f, hfcomp, hf⟩ :=
    exists_fg_ideal_approximation g hg t ht
  refine ⟨MvPolynomial (Fin n) R ⧸ I, inferInstance, inferInstance, hIfin, hIfp,
    Ideal.Quotient.mkₐ R I, f, Ideal.Quotient.mkₐ_surjective R I, hfcomp, ?_, hf⟩
  intro F hF
  exact (Ideal.Quotient.eq_zero_iff_mem).2 (htI hF)

/-- The case of no prescribed relations: a finite family of integral elements of `S` generates a
subalgebra which is the image of a module-finite, finitely presented `R`-algebra. -/
@[ega "0 1.0.5" "more general"]
theorem exists_moduleFinite_finitePresentation_range_eq_adjoin
    {n : ℕ} (g : Fin n → S) (hg : ∀ i, IsIntegral R (g i)) :
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T),
      Module.Finite R T ∧ Algebra.FinitePresentation R T ∧
        ∃ f : T →ₐ[R] S, f.range = Algebra.adjoin R (Set.range g) := by
  obtain ⟨I, hIfg, -, -, hIfin, hIfp, f, -, hf⟩ :=
    exists_fg_ideal_approximation g hg ∅ (by simp)
  exact ⟨MvPolynomial (Fin n) R ⧸ I, inferInstance, inferInstance, hIfin, hIfp, f, hf⟩

/-- Every finitely generated `R`-subalgebra of an integral `R`-algebra `S` is the image of a
module-finite, finitely presented `R`-algebra. -/
@[ega "0 1.0.5" "more general"]
theorem exists_moduleFinite_finitePresentation_range_eq_adjoin_finset
    [Algebra.IsIntegral R S] (s : Finset S) :
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T),
      Module.Finite R T ∧ Algebra.FinitePresentation R T ∧
        ∃ f : T →ₐ[R] S, f.range = Algebra.adjoin R (s : Set S) := by
  classical
  obtain ⟨T, _, _, hfin, hfp, f, hf⟩ :=
    exists_moduleFinite_finitePresentation_range_eq_adjoin
      (R := R) (S := S) (n := s.card) (fun i => ((s.equivFin.symm i : {x // x ∈ s}) : S))
      (fun _ => Algebra.IsIntegral.isIntegral _)
  refine ⟨T, inferInstance, inferInstance, hfin, hfp, f, ?_⟩
  rw [hf]
  congr 1
  rw [show (fun i => ((s.equivFin.symm i : {x // x ∈ s}) : S)) =
      (Subtype.val ∘ s.equivFin.symm) from rfl, Set.range_comp, Equiv.range_eq_univ,
    Set.image_univ, Subtype.range_coe_subtype]
  rfl

/-- The subalgebras generated by finite subsets of `S` are directed. -/
theorem directed_adjoin_finset :
    Directed (· ≤ ·) fun s : Finset S => Algebra.adjoin R (s : Set S) := by
  classical
  intro s t
  refine ⟨s ∪ t, Algebra.adjoin_mono ?_, Algebra.adjoin_mono ?_⟩
  · exact_mod_cast Finset.subset_union_left
  · exact_mod_cast Finset.subset_union_right

/-- Every element of `S` lies in the subalgebra generated by a finite subset of `S`. -/
theorem iSup_adjoin_finset :
    ⨆ s : Finset S, Algebra.adjoin R (s : Set S) = ⊤ := by
  classical
  refine le_antisymm le_top fun x _ => ?_
  exact le_iSup (fun s : Finset S => Algebra.adjoin R (s : Set S)) ({x} : Finset S)
    (Algebra.subset_adjoin (by simp))

/-- Each subalgebra `Algebra.adjoin R s`, for `s` a finite subset of an integral algebra `S`, is
a finite `R`-module.  Together with `directed_adjoin_finset` and `iSup_adjoin_finset` this is the
affine form of [Stacks, Tag 0817] (1): an integral algebra is the directed union of its
module-finite subalgebras. -/
@[ega "0 1.0.5"]
theorem moduleFinite_adjoin_finset [Algebra.IsIntegral R S] (s : Finset S) :
    Module.Finite R (Algebra.adjoin R (s : Set S)) :=
  Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
    fun x _ => Algebra.IsIntegral.isIntegral x

end Stacks.RingTheory.IntegralApproximation
