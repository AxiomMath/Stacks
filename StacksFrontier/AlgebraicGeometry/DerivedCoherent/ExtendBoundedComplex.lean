/-!
# Extending a bounded complex of coherent modules across an open immersion

Let `X` be a Noetherian scheme, `U ⊆ X` an open subscheme with inclusion `j : U ⟶ X`, and `ℱ` a
bounded complex of coherent `𝒪_U`-modules. This file constructs a complex `𝒢` of coherent
`𝒪_X`-modules with the same strict bounds, together with an isomorphism `𝒢|_U ≅ ℱ`.

The complex `𝒢` is built inside the degreewise direct image of `ℱ`. Each `j_*ℱ^i` is
quasi-coherent because `j` is quasi-compact and quasi-separated, so [Stacks, Tag 01PF] produces a
coherent subobject `𝒜^i ⊆ j_*ℱ^i` whose restriction to `U` is `ℱ^i`, compatibly with the
inclusions. The terms of `𝒢` are then the images
`𝒢^i = Im(𝒜^i ⊕ 𝒜^(i-1) ⟶ j_*ℱ^i)`,
the second summand entering through the differential of `j_*ℱ`. Adding that second summand is
what makes the family stable under the differential, so that `𝒢` is a subcomplex of `j_*ℱ`; it
changes nothing over `U`, where the first summand already surjects onto `ℱ^i`; and it costs
nothing in coherence, since the image of a coherent module in a quasi-coherent module on a
locally Noetherian scheme is again coherent. Because `d ∘ d = 0` no further summands are needed,
so the construction is a closed formula in the chosen family and involves no recursion over the
degrees.

## Main results

* `Stacks.AlgebraicGeometry.ExtendBoundedComplex.exists_bounded_isCoherent_complex_restrict_iso`:
  a bounded complex of coherent modules on an open subscheme of a Noetherian scheme is the
  restriction of a bounded complex of coherent modules on the whole scheme.

## References

* [Stacks Project, Tag 0G48](https://stacks.math.columbia.edu/tag/0G48)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe v u' u

namespace Stacks.AlgebraicGeometry.ExtendBoundedComplex

/-! ### The subcomplex generated in each degree by two chosen pieces -/

section Abstract

variable {C : Type u'} [Category.{v} C] [Abelian C]

/-- A map out of a binary biproduct whose second component is annihilated by `d : M ⟶ N` induces,
on images, a map compatible with `d` into the image of any map out of a biproduct whose second
component is the first component of the original composed with `d`. -/
theorem exists_image_hom {A₁ A₂ A₃ M N : C} (a₁ : A₁ ⟶ M) (a₂ : A₂ ⟶ M) (a₃ : A₃ ⟶ N)
    (d : M ⟶ N) (h : a₂ ≫ d = 0) :
    ∃ w : image (biprod.desc a₁ a₂) ⟶ image (biprod.desc a₃ (a₁ ≫ d)),
      w ≫ image.ι (biprod.desc a₃ (a₁ ≫ d)) = image.ι (biprod.desc a₁ a₂) ≫ d := by
  have hsq : biprod.desc (biprod.inr : A₁ ⟶ A₃ ⊞ A₁) (0 : A₂ ⟶ A₃ ⊞ A₁) ≫
      biprod.desc a₃ (a₁ ≫ d) = biprod.desc a₁ a₂ ≫ d := by
    refine biprod.hom_ext' _ _ ?_ ?_ <;> simp [h]
  exact ⟨image.map (Arrow.homMk' _ _ hsq), image.map_homMk'_ι hsq⟩

/-- The map `A i ⊞ A (i-1) ⟶ P i` whose image is the `i`-th term of the subcomplex of `P`
generated by the family `α`. -/
def gen (P : ℤ → C) (Pd : ∀ i j : ℤ, P i ⟶ P j) (A : ℤ → C) (α : ∀ i, A i ⟶ P i) (i : ℤ) :
    (A i ⊞ A (i - 1)) ⟶ P i :=
  biprod.desc (α i) (α (i - 1) ≫ Pd (i - 1) i)

/-- The first summand of `gen` is the chosen piece in degree `i`. -/
theorem gen_inl (P : ℤ → C) (Pd : ∀ i j : ℤ, P i ⟶ P j) (A : ℤ → C) (α : ∀ i, A i ⟶ P i)
    (i : ℤ) : biprod.inl ≫ gen P Pd A α i = α i :=
  biprod.inl_desc _ _

/-- The factorization of `Pd i (i+1)` through the images in degrees `i` and `i+1`, with the
predecessor of `i+1` supplied as a variable together with an equation. -/
theorem exists_gen_hom_succ (P : ℤ → C) (Pd : ∀ i j : ℤ, P i ⟶ P j)
    (hdd : ∀ i j k : ℤ, Pd i j ≫ Pd j k = 0) (A : ℤ → C) (α : ∀ i, A i ⟶ P i) (i p : ℤ)
    (hp : p = i) :
    ∃ w : image (gen P Pd A α i) ⟶ image (biprod.desc (α (i + 1)) (α p ≫ Pd p (i + 1))),
      w ≫ image.ι (biprod.desc (α (i + 1)) (α p ≫ Pd p (i + 1)))
        = image.ι (gen P Pd A α i) ≫ Pd i (i + 1) := by
  subst hp
  exact exists_image_hom (α p) (α (p - 1) ≫ Pd (p - 1) p) (α (p + 1)) (Pd p (p + 1))
    (by rw [Category.assoc, hdd (p - 1) p (p + 1), comp_zero])

/-- Every differential of `P` factors through the images, so the images form a subcomplex. -/
theorem exists_gen_hom (P : ℤ → C) (Pd : ∀ i j : ℤ, P i ⟶ P j)
    (hshape : ∀ i j : ℤ, i + 1 ≠ j → Pd i j = 0) (hdd : ∀ i j k : ℤ, Pd i j ≫ Pd j k = 0)
    (A : ℤ → C) (α : ∀ i, A i ⟶ P i) (i j : ℤ) :
    ∃ w : image (gen P Pd A α i) ⟶ image (gen P Pd A α j),
      w ≫ image.ι (gen P Pd A α j) = image.ι (gen P Pd A α i) ≫ Pd i j := by
  by_cases h : i + 1 = j
  · subst h
    exact exists_gen_hom_succ P Pd hdd A α i (i + 1 - 1) (add_sub_cancel_right i 1)
  · exact ⟨0, by rw [hshape i j h, comp_zero, zero_comp]⟩

/-- The subcomplex of `P` whose term in degree `i` is the image of `A i ⊞ A (i-1) ⟶ P i`. -/
def subComplex (P : ℤ → C) (Pd : ∀ i j : ℤ, P i ⟶ P j)
    (hshape : ∀ i j : ℤ, i + 1 ≠ j → Pd i j = 0) (hdd : ∀ i j k : ℤ, Pd i j ≫ Pd j k = 0)
    (A : ℤ → C) (α : ∀ i, A i ⟶ P i) : CochainComplex C ℤ where
  X i := image (gen P Pd A α i)
  d i j := (exists_gen_hom P Pd hshape hdd A α i j).choose
  shape i j hij := by
    rw [← cancel_mono (image.ι (gen P Pd A α j)),
      (exists_gen_hom P Pd hshape hdd A α i j).choose_spec, hshape i j hij, comp_zero, zero_comp]
  d_comp_d' i j k _ _ := by
    rw [← cancel_mono (image.ι (gen P Pd A α k)), Category.assoc,
      (exists_gen_hom P Pd hshape hdd A α j k).choose_spec, ← Category.assoc,
      (exists_gen_hom P Pd hshape hdd A α i j).choose_spec, Category.assoc, hdd, comp_zero,
      zero_comp]

variable (P : ℤ → C) (Pd : ∀ i j : ℤ, P i ⟶ P j)
  (hshape : ∀ i j : ℤ, i + 1 ≠ j → Pd i j = 0) (hdd : ∀ i j k : ℤ, Pd i j ≫ Pd j k = 0)
  (A : ℤ → C) (α : ∀ i, A i ⟶ P i)

/-- The `i`-th term of the subcomplex is the image of `gen`. -/
theorem subComplex_X (i : ℤ) :
    (subComplex P Pd hshape hdd A α).X i = image (gen P Pd A α i) :=
  rfl

/-- The inclusion of the `i`-th term of the subcomplex into `P i`. -/
def subComplexι (i : ℤ) : (subComplex P Pd hshape hdd A α).X i ⟶ P i :=
  image.ι (gen P Pd A α i)

/-- The inclusion of the `i`-th term of the subcomplex is a monomorphism. -/
theorem mono_subComplexι (i : ℤ) : Mono (subComplexι P Pd hshape hdd A α i) :=
  inferInstanceAs (Mono (image.ι (gen P Pd A α i)))

/-- The canonical map onto the `i`-th term of the subcomplex. -/
def subComplexπ (i : ℤ) : (A i ⊞ A (i - 1)) ⟶ (subComplex P Pd hshape hdd A α).X i :=
  factorThruImage (gen P Pd A α i)

/-- The canonical map onto the `i`-th term followed by the inclusion is `gen`. -/
theorem subComplexπ_comp_ι (i : ℤ) :
    subComplexπ P Pd hshape hdd A α i ≫ subComplexι P Pd hshape hdd A α i = gen P Pd A α i :=
  image.fac _

/-- The differential of the subcomplex is compatible with the inclusions into `P`. -/
theorem subComplex_d_comp_ι (i j : ℤ) :
    (subComplex P Pd hshape hdd A α).d i j ≫ subComplexι P Pd hshape hdd A α j
      = subComplexι P Pd hshape hdd A α i ≫ Pd i j :=
  (exists_gen_hom P Pd hshape hdd A α i j).choose_spec

/-- A term of the subcomplex vanishes as soon as the corresponding term of `P` does. -/
theorem subComplex_isZero_X (i : ℤ) (h : IsZero (P i)) :
    IsZero ((subComplex P Pd hshape hdd A α).X i) :=
  have := mono_subComplexι P Pd hshape hdd A α i
  IsZero.of_mono_eq_zero (subComplexι P Pd hshape hdd A α i) (h.eq_zero_of_tgt _)

end Abstract

/-! ### The coherent pieces over a Noetherian scheme -/

/-- The counit of the adjunction between restriction and direct image along the inclusion of an
open subscheme: the restriction of `j_*M` to `U` is `M`. -/
def counitHom {X : Scheme.{u}} (U : X.Opens) (M : U.toScheme.Modules) :
    (Scheme.Modules.restrictFunctor U.ι).obj ((Scheme.Modules.pushforward U.ι).obj M) ⟶ M :=
  ((Scheme.Modules.restrictFunctorAdjCounitIso U.ι).app M).hom

/-- The counit `counitHom U M` is an isomorphism. -/
instance isIso_counitHom {X : Scheme.{u}} (U : X.Opens) (M : U.toScheme.Modules) :
    IsIso (counitHom U M) :=
  inferInstanceAs (IsIso ((Scheme.Modules.restrictFunctorAdjCounitIso U.ι).app M).hom)

/-- The counit is natural in `M`. -/
theorem counitHom_naturality {X : Scheme.{u}} (U : X.Opens) {M N : U.toScheme.Modules}
    (g : M ⟶ N) :
    (Scheme.Modules.restrictFunctor U.ι).map ((Scheme.Modules.pushforward U.ι).map g) ≫
        counitHom U N = counitHom U M ≫ g :=
  (Scheme.Modules.restrictFunctorAdjCounitIso U.ι).hom.naturality g

/-- The direct image along the inclusion of an open subscheme of a locally Noetherian scheme
preserves quasi-coherence: that inclusion is quasi-compact and quasi-separated. -/
theorem isQuasicoherent_pushforward_obj {X : Scheme.{u}} [IsLocallyNoetherian X] (U : X.Opens)
    (M : U.toScheme.Modules) (hM : M.IsQuasicoherent) :
    ((Scheme.Modules.pushforward U.ι).obj M).IsQuasicoherent :=
  have := hM
  AlgebraicGeometry.pushforward_isQuasicoherent U.ι M

/-- **[Stacks, Tag 01PF] for a coherent module on an open subscheme.** A coherent `𝒪_U`-module
`M` is the restriction of a coherent subobject of `j_*M`, where `j : U ⟶ X` is the inclusion of
an open subscheme of a Noetherian scheme; the identification of the restriction with `M` is
induced by the inclusion itself. -/
theorem exists_isCoherent_subobject {X : Scheme.{u}} [IsNoetherian X] (U : X.Opens)
    (M : U.toScheme.Modules) (hM : M.IsCoherent) :
    ∃ (A : X.Modules) (α : A ⟶ (Scheme.Modules.pushforward U.ι).obj M), Mono α ∧ A.IsCoherent ∧
      IsIso ((Scheme.Modules.restrictFunctor U.ι).map α ≫ counitHom U M) := by
  have := hM
  have hMqc : M.IsQuasicoherent := isQuasicoherent_of_isCoherent M
  have := isQuasicoherent_pushforward_obj U M hMqc
  obtain ⟨G, hu, harrow⟩ : ∃ G : Subobject ((Scheme.Modules.restrictFunctor U.ι).obj
      ((Scheme.Modules.pushforward U.ι).obj M)), ∃ hu : (G : U.toScheme.Modules) ≅ M,
        G.arrow ≫ counitHom U M = hu.hom := by
    refine ⟨Subobject.mk (inv (counitHom U M)), Subobject.underlyingIso _, ?_⟩
    rw [← Subobject.underlyingIso_hom_comp_eq_mk (inv (counitHom U M)), Category.assoc,
      IsIso.inv_hom_id, Category.comp_id]
  have : (G : U.toScheme.Modules).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent U.toScheme.ringCatSheaf).prop_of_iso hu.symm hMqc
  have := hM.isFiniteType
  have : (G : U.toScheme.Modules).IsFiniteType :=
    Stacks.SheafOfModules.isFiniteType_of_iso.{u} hu.symm
  obtain ⟨G', hG'qc, hG'ft, f, hf⟩ :=
    AlgebraicGeometry.exists_finiteTypeQuasicoherentSubobject_extension
      ((Scheme.Modules.pushforward U.ι).obj M) U
      (TopologicalSpace.NoetherianSpace.isCompact (U : Set X)) G
  have := hG'qc
  have := hG'ft
  refine ⟨(G' : X.Modules), G'.arrow, inferInstance,
    CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType _,
    ?_⟩
  rw [hf, Category.assoc, harrow]
  infer_instance

/-! ### Extension of a bounded complex -/

/-- **A bounded complex of coherent modules on an open subscheme of a Noetherian scheme extends
to the whole scheme.** Given a complex `ℱ` of coherent `𝒪_U`-modules which is strictly supported
in degrees `[a, b]`, there is a complex `𝒢` of coherent `𝒪_X`-modules, strictly supported in the
same degrees, whose restriction to `U` is isomorphic to `ℱ`. -/
theorem exists_bounded_isCoherent_complex_restrict_iso {X : Scheme.{u}} [IsNoetherian X]
    (U : X.Opens) (a b : ℤ) (ℱ : CochainComplex U.toScheme.Modules ℤ)
    (hcoh : ∀ i, (ℱ.X i).IsCoherent) (hGE : ℱ.IsStrictlyGE a) (hLE : ℱ.IsStrictlyLE b) :
    ∃ 𝒢 : CochainComplex X.Modules ℤ, (∀ i, (𝒢.X i).IsCoherent) ∧ 𝒢.IsStrictlyGE a ∧
      𝒢.IsStrictlyLE b ∧
      Nonempty (((Scheme.Modules.restrictFunctor U.ι).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj 𝒢 ≅ ℱ) := by
  classical
  have := hGE
  have := hLE
  have hFqc : ∀ i, (ℱ.X i).IsQuasicoherent := fun i =>
    have := hcoh i
    isQuasicoherent_of_isCoherent _
  let Pobj : ℤ → X.Modules := fun i => (Scheme.Modules.pushforward U.ι).obj (ℱ.X i)
  let Pdif : ∀ i j : ℤ, Pobj i ⟶ Pobj j := fun i j =>
    (Scheme.Modules.pushforward U.ι).map (ℱ.d i j)
  have hPqc : ∀ i : ℤ, (Pobj i).IsQuasicoherent := fun i =>
    isQuasicoherent_pushforward_obj U (ℱ.X i) (hFqc i)
  have hshape : ∀ i j : ℤ, i + 1 ≠ j → Pdif i j = 0 := by
    intro i j h
    change (Scheme.Modules.pushforward U.ι).map (ℱ.d i j) = 0
    rw [ℱ.shape i j h, Functor.map_zero]
  have hdd : ∀ i j k : ℤ, Pdif i j ≫ Pdif j k = 0 := by
    intro i j k
    change (Scheme.Modules.pushforward U.ι).map (ℱ.d i j) ≫
      (Scheme.Modules.pushforward U.ι).map (ℱ.d j k) = 0
    rw [← Functor.map_comp, ℱ.d_comp_d, Functor.map_zero]
  obtain ⟨A, α, hmonoα, hAcoh, hAiso⟩ :
      ∃ (A : ℤ → X.Modules) (α : ∀ i, A i ⟶ Pobj i),
        (∀ i, Mono (α i)) ∧ (∀ i, (A i).IsCoherent) ∧
          ∀ i, IsIso ((Scheme.Modules.restrictFunctor U.ι).map (α i) ≫
            counitHom U (ℱ.X i)) := by
    choose A α h₁ h₂ h₃ using fun i : ℤ => exists_isCoherent_subobject U (ℱ.X i) (hcoh i)
    exact ⟨A, α, h₁, h₂, h₃⟩
  have hzero : ∀ i, IsZero (ℱ.X i) → IsZero ((subComplex Pobj Pdif hshape hdd A α).X i) :=
    fun i h => subComplex_isZero_X Pobj Pdif hshape hdd A α i
      (Functor.map_isZero (Scheme.Modules.pushforward U.ι) h)
  refine ⟨subComplex Pobj Pdif hshape hdd A α, ?_, ?_, ?_, ?_⟩
  · -- every term is the image of a coherent module in a quasi-coherent one, hence coherent
    intro i
    have : (Pobj i).IsQuasicoherent := hPqc i
    have : (A i ⊞ A (i - 1)).IsCoherent :=
      AlgebraicGeometry.SheafOfModules.isCoherent_biprod _ _ (hAcoh i) (hAcoh (i - 1))
    rw [subComplex_X Pobj Pdif hshape hdd A α i]
    exact CoherenceCriteria.isCoherent_image_of_isCoherent_of_isQuasicoherent
      (gen Pobj Pdif A α i)
  · -- the lower bound is inherited from `ℱ`
    rw [CochainComplex.isStrictlyGE_iff]
    exact fun i hi => hzero i (ℱ.isZero_of_isStrictlyGE a i hi)
  · -- the upper bound is inherited from `ℱ`
    rw [CochainComplex.isStrictlyLE_iff]
    exact fun i hi => hzero i (ℱ.isZero_of_isStrictlyLE b i hi)
  · -- the restriction of the subcomplex to `U` is `ℱ`
    have hnat : ∀ i j : ℤ, (Scheme.Modules.restrictFunctor U.ι).map (Pdif i j) ≫
        counitHom U (ℱ.X j) = counitHom U (ℱ.X i) ≫ ℱ.d i j := fun i j =>
      counitHom_naturality U (ℱ.d i j)
    have hisoφ : ∀ i : ℤ, IsIso ((Scheme.Modules.restrictFunctor U.ι).map
        (subComplexι Pobj Pdif hshape hdd A α i) ≫ counitHom U (ℱ.X i)) := by
      intro i
      have := mono_subComplexι Pobj Pdif hshape hdd A α i
      have := AlgebraicGeometry.Modules.preservesFiniteLimits_restrictFunctor U.ι
      have : Mono ((Scheme.Modules.restrictFunctor U.ι).map
          (subComplexι Pobj Pdif hshape hdd A α i)) := preserves_mono_of_preservesLimit _ _
      have : Mono ((Scheme.Modules.restrictFunctor U.ι).map
          (subComplexι Pobj Pdif hshape hdd A α i) ≫ counitHom U (ℱ.X i)) := mono_comp _ _
      have := hAiso i
      have hfac : (Scheme.Modules.restrictFunctor U.ι).map
            (biprod.inl ≫ subComplexπ Pobj Pdif hshape hdd A α i) ≫
            ((Scheme.Modules.restrictFunctor U.ι).map
              (subComplexι Pobj Pdif hshape hdd A α i) ≫ counitHom U (ℱ.X i))
          = (Scheme.Modules.restrictFunctor U.ι).map (α i) ≫ counitHom U (ℱ.X i) := by
        rw [← Category.assoc, ← Functor.map_comp, Category.assoc,
          subComplexπ_comp_ι Pobj Pdif hshape hdd A α i, gen_inl Pobj Pdif A α i]
      have := epi_of_epi_fac hfac
      exact isIso_of_mono_of_epi _
    have hcomm : ∀ i j : ℤ, (ComplexShape.up ℤ).Rel i j →
        ((Scheme.Modules.restrictFunctor U.ι).map (subComplexι Pobj Pdif hshape hdd A α i) ≫
            counitHom U (ℱ.X i)) ≫ ℱ.d i j
          = (Scheme.Modules.restrictFunctor U.ι).map
              ((subComplex Pobj Pdif hshape hdd A α).d i j) ≫
            ((Scheme.Modules.restrictFunctor U.ι).map
              (subComplexι Pobj Pdif hshape hdd A α j) ≫ counitHom U (ℱ.X j)) := by
      intro i j _
      rw [Category.assoc, ← hnat i j, ← Category.assoc, ← Functor.map_comp,
        ← subComplex_d_comp_ι Pobj Pdif hshape hdd A α i j, Functor.map_comp, Category.assoc]
    let Φ : (((Scheme.Modules.restrictFunctor U.ι).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj (subComplex Pobj Pdif hshape hdd A α)) ⟶ ℱ :=
      { f := fun i => (Scheme.Modules.restrictFunctor U.ι).map
          (subComplexι Pobj Pdif hshape hdd A α i) ≫ counitHom U (ℱ.X i)
        comm' := hcomm }
    have : ∀ i : ℤ, IsIso (Φ.f i) := hisoφ
    have : IsIso Φ := HomologicalComplex.Hom.isIso_of_components Φ
    exact ⟨asIso Φ⟩

end Stacks.AlgebraicGeometry.ExtendBoundedComplex

end
