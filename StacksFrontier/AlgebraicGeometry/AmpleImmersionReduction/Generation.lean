module

public import StacksFrontier.AlgebraicGeometry.ProjectiveFromSections.Ratio
public import StacksFrontier.AlgebraicGeometry.SectionExtension.Ample

/-!
# A generating family of global sections of one tensor power, from ampleness

`Stacks.ProjectiveFromSections.GeneratesStalks` is the hypothesis of Stacks Tag 01NE: the germs of
a family of global sections of an invertible `𝒪_X`-module generate every stalk. This file shows
that, for an invertible module, this is equivalent to the nonvanishing opens of the family
covering `X`, and produces such a family in one tensor power from ampleness.

## The two steps

1. **Generation is exactly the nonvanishing cover, for an invertible module**
   (`generatesStalks_iff_forall_exists_mem`). One direction is
   `Stacks.ProjectiveFromSections.exists_mem_nvCover_of_generatesStalks`. The other is Nakayama at
   a rank-one stalk: `Stacks.SectionProduct.exists_smul_Γgerm` says that the germ at `x` of a
   global section not vanishing at `x` generates the whole stalk, so a *single* member of the
   family suffices at each point and the generating combination is a one-term sum.

2. **Ampleness gives such a family in one degree**
   (`exists_generating_family_of_isAmple`).
   `Stacks.SectionExtension.exists_common_degree_affine_cover` produces, from ampleness, a single
   degree `N ≥ 1` and a *finite* family of homogeneous elements of the section ring of that degree
   whose nonvanishing loci are affine and cover `X`;
   `Stacks.FinGenFromCover.exists_global_nonvanishingLocus_eq` turns each of those into a global
   section of `Stacks.Ample.tensorPowModule X L N` with the same nonvanishing locus. The family is
   then reindexed from a `Finset` onto `Fin (n + 1)`, the index of Tag 01NE's `n`-dimensional
   projective space.

## Two generation predicates

There are two notions of "generated by global sections" for an `𝒪_X`-module:
`Stacks.ProjectiveFromSections.GeneratesStalks`, the stalkwise condition of Tag 01NE, and
`Stacks.AmpleEventualGeneration.IsFinGen`, which asks for a `SheafOfModules.GeneratingSections`
with a finite index. `Stacks.FinGenFromCover.isFinGen_of_nonvanishingCover` derives the second
from a nonvanishing cover, and `generatesStalks_of_forall_exists_mem` below derives the first. The
two predicates are compared in `Stacks.StalkwiseGeneration.generatesStalks_iff_span_eq_top`
together with [Stacks, Tag 01AN].

## Main results

* `Stacks.AmpleImmersionReduction.generatesStalks_of_forall_exists_mem`,
  `Stacks.AmpleImmersionReduction.generatesStalks_iff_forall_exists_mem`: **generation is the
  nonvanishing cover.**
* `Stacks.AmpleImmersionReduction.exists_generating_family_of_isAmple`: **from ampleness, one
  degree `N ≥ 1` and a family `Fin (n + 1) → Γ(L ^⊗ N, ⊤)` that generates `L ^⊗ N` and whose
  nonvanishing opens are affine.**

## Implementation notes

**The padding index.** Tag 01NE's family is indexed by `Fin (n + 1)`, which is nonempty, while the
`Finset` the cover is cut down to may be empty (when `X` is). The family below is the cover on
`Fin.castSucc` and the *zero* section on `Fin.last`; the zero section's nonvanishing open is `⊥`,
which is affine by `AlgebraicGeometry.isAffineOpen_bot`, so the affineness clause survives the
padding and the cover clause is untouched by adding a member.

## References

* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
* [Stacks Project, Tag 01PS](https://stacks.math.columbia.edu/tag/01PS)
* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open Stacks.Ample Stacks.ProjectiveFromSections

universe u

namespace Stacks.AmpleImmersionReduction

/-! ### Generation is the nonvanishing cover -/

section Generation

variable {X : Scheme.{u}} {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L]

/-- **A family of global sections of an invertible module generates every stalk as soon as its
nonvanishing opens cover `X`.** -/
theorem generatesStalks_of_forall_exists_mem {ι : Type*} (s : ι → Γ(L, ⊤))
    (h : ∀ x : X, ∃ i, x ∈ nvCover s i) : GeneratesStalks s := by
  classical
  intro x w
  obtain ⟨i, hi⟩ := h x
  obtain ⟨r, hr⟩ := Stacks.SectionProduct.exists_smul_Γgerm L (s i)
    ((Stacks.NonvanishingOpen.mem_nonvanishingOpen X L (s i) x).mp hi) w
  refine ⟨{i}, fun j => if j = i then r else 0, ?_⟩
  simpa using hr

/-- **For an invertible module, generation of the stalks by a family of global sections is exactly
the statement that the nonvanishing opens of the family cover `X`.** -/
theorem generatesStalks_iff_forall_exists_mem {ι : Type*} (s : ι → Γ(L, ⊤)) :
    GeneratesStalks s ↔ ∀ x : X, ∃ i, x ∈ nvCover s i :=
  ⟨fun hs x => exists_mem_nvCover_of_generatesStalks s hs x,
    generatesStalks_of_forall_exists_mem s⟩

/-- **A family of global sections of an invertible module whose nonvanishing opens form an open
cover (`IsOpenCover`) generates every stalk.** -/
theorem generatesStalks_of_isOpenCover {ι : Type*} (s : ι → Γ(L, ⊤))
    (h : IsOpenCover (nvCover s)) : GeneratesStalks s :=
  generatesStalks_of_forall_exists_mem s fun x =>
    TopologicalSpace.Opens.mem_iSup.mp (h ▸ Opens.mem_top x)

end Generation

/-! ### The generating family from ampleness -/

section FromAmple

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- **From ampleness: one degree, and a generating family of global sections of that power whose
nonvanishing opens are affine.**

This is the hypothesis of Stacks Tag 01NE, obtained from Stacks Tag 01PS. The degree is
`Stacks.SectionExtension.exists_common_degree_affine_cover`'s, the generation is
`generatesStalks_of_forall_exists_mem`, and the final index of `Fin (n + 1)` carries the zero
section, whose nonvanishing open is `⊥`. -/
theorem exists_generating_family_of_isAmple (hL : IsAmple X L) :
    ∃ (N : ℕ) (n : ℕ) (s : Fin (n + 1) → Γ(tensorPowModule X L (N : ℤ), ⊤)),
      1 ≤ N ∧ GeneratesStalks s ∧ ∀ i, IsAffineOpen (nvCover s i) := by
  classical
  obtain ⟨N, _, F, c, hN, -, -, hcaff, hcover⟩ :=
    Stacks.SectionExtension.exists_common_degree_affine_cover L hL (n := 1) le_rfl 0
  choose t ht using fun i =>
    Stacks.FinGenFromCover.exists_global_nonvanishingLocus_eq L N (c i)
  have hnv : ∀ i, nvOpen (tensorPowModule X L (N : ℤ)) (t i)
      = Stacks.AmpleFiniteAvoidance.nvOpen L (c i) := fun i =>
    TopologicalSpace.Opens.ext <| by
      rw [Stacks.NonvanishingOpen.coe_nonvanishingOpen,
        Stacks.AmpleFiniteAvoidance.coe_nvOpen, ht i]
  set eqv := F.equivFin with heqv
  refine ⟨N, F.card, Fin.lastCases 0 fun j => t (eqv.symm j), hN, ?_, ?_⟩
  · refine generatesStalks_of_forall_exists_mem _ fun x => ?_
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcover (Opens.mem_top x))
    refine ⟨(eqv i).castSucc, ?_⟩
    rw [nvCover, Fin.lastCases_castSucc, Equiv.symm_apply_apply, hnv]
    exact hi
  · refine Fin.lastCases ?_ fun j => ?_
    · rw [nvCover, Fin.lastCases_last]
      refine (?_ : nvOpen (tensorPowModule X L (N : ℤ)) 0 = ⊥) ▸ isAffineOpen_bot X
      refine TopologicalSpace.Opens.ext ?_
      rw [Stacks.NonvanishingOpen.coe_nonvanishingOpen, nonvanishingLocus_zero]
      rfl
    · rw [nvCover, Fin.lastCases_castSucc, hnv]
      exact hcaff _

end FromAmple

end Stacks.AmpleImmersionReduction

end
