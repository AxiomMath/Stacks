module

public import Mathlib.AlgebraicGeometry.PullbackCarrier
public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.AlgebraicGeometry.Restrict

/-!
# The ring of functions on a product of two affine opens of a fibre product

Let `f : X ⟶ Z` and `g : Y ⟶ Z` be morphisms of schemes with `Z` **affine**, and let `U ⊆ X` and
`V ⊆ Y` be affine opens. `StacksFrontier/AlgebraicGeometry/Segre/ChartAffine.lean` shows that the
open `pr₁⁻¹U ⊓ pr₂⁻¹V` of `X ×_Z Y` is affine. This file computes the ring of functions on it:
**it is generated, as a ring, by the two restriction images `Γ(X, U) → Γ(pr₁⁻¹U ⊓ pr₂⁻¹V)` and
`Γ(Y, V) → Γ(pr₁⁻¹U ⊓ pr₂⁻¹V)`** — which is the surjectivity half of
`Γ(U) ⊗_{Γ(Z)} Γ(V) ≅ Γ(U ×_Z V)`, stated in the form a consumer uses and with no tensor-product
algebra exposed in the statement.

This is the **ring half** of the chart criterion for the Segre morphism, the second of the two
hypotheses of `AlgebraicGeometry.Segre.mono_segreMorphism_of_chart`; the first (affineness) is
`AlgebraicGeometry.Segre.isAffineOpen_nonvanishingChart_segreSections`.

## Main results

* `Stacks.AlgebraicGeometry.subring_eq_top_of_isPullback`: **in a pullback square of schemes with
  all three of `X`, `Y`, `Z` affine, a subring of `Γ(X ×_Z Y, ⊤)` containing the images of
  `Γ(X, ⊤)` and `Γ(Y, ⊤)` is everything.**
* `Stacks.AlgebraicGeometry.subring_eq_top_of_pullback_inf`: the same for the open
  `pr₁⁻¹U ⊓ pr₂⁻¹V` of `X ×_Z Y`, with `Z` affine and `U`, `V` affine opens, and with the two
  maps spelled as `AlgebraicGeometry.Scheme.Hom.appLE`.

## Implementation notes

The whole content is Mathlib's `AlgebraicGeometry.pullbackSpecIso`, which identifies
`Spec S ×_{Spec R} Spec T` with `Spec (S ⊗[R] T)`. Three remarks on making it apply.

* **No `Algebra` instance is needed in the input data.** `(Scheme.Hom.appTop f).hom.toAlgebra`
  supplies one, and `CommRingCat.ofHom (algebraMap Γ(Z, ⊤) Γ(X, ⊤)) = Scheme.Hom.appTop f` is then
  `rfl`, so the comparison squares are `AlgebraicGeometry.Scheme.isoSpec_hom_naturality` verbatim.
* The comparison morphism is an isomorphism by `CategoryTheory.Limits.pullback.map_isIso`, which
  is an instance, so `asIso` suffices and no limit is re-computed.
* Everything downstream is done at the level of the **composite ring homomorphism**
  `Γ(X, ⊤) ⊗ Γ(Y, ⊤) ⟶ Γ(W, ⊤)` rather than elementwise: `CommRingCat.comp_apply` only splits one
  composition per rewrite here, so the two identifications `a ⊗ 1 ↦ pr₁^* a` and `1 ⊗ b ↦ pr₂^* b`
  are proved as equalities of morphisms and extracted at an element exactly once.

`Stacks.AlgebraicGeometry.subring_eq_top_of_pullback_inf` takes the open as a variable together
with an equation, rather than literally as `pr₁⁻¹U ⊓ pr₂⁻¹V`: a consumer that knows its chart
equals that intersection only up to a proved equality cannot rewrite under the dependent type
`Subring Γ(X ×_Z Y, W)`, and `subst` on the equation is what removes the need to.

REPO-TIER: like `Stacks.AlgebraicGeometry.isAffineOpen_pullback_inf`, which it is the companion of,
this is generic scheme theory with no projective geometry in it and belongs beside Mathlib's
`AlgebraicGeometry.pullbackSpecIso`; it is here only because that is where its consumer is.

No `@[stacks ...]` attribute is attached: this is the statement of no tag.
-/

@[expose] public section

open CategoryTheory Opposite Limits TopologicalSpace AlgebraicGeometry
open scoped TensorProduct

universe u

namespace Stacks.AlgebraicGeometry

/-- **In a pullback square of schemes with `X`, `Y` and `Z` affine, the ring of global functions
on the fibre product is generated by the two pullbacks.** A subring of `Γ(X ×_Z Y, ⊤)` containing
the image of `Γ(X, ⊤)` under `pr₁^*` and the image of `Γ(Y, ⊤)` under `pr₂^*` is the whole ring.

This is the surjectivity of `Γ(X, ⊤) ⊗_{Γ(Z, ⊤)} Γ(Y, ⊤) → Γ(X ×_Z Y, ⊤)`, which is an
isomorphism by `AlgebraicGeometry.pullbackSpecIso`; only surjectivity is recorded, because an
elementary tensor `a ⊗ b` is the product `(a ⊗ 1) · (1 ⊗ b)` and that is all a generation
statement needs. -/
theorem subring_eq_top_of_isPullback {W X Y Z : Scheme.{u}}
    [IsAffine X] [IsAffine Y] [IsAffine Z]
    {p : W ⟶ X} {q : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z} (hpb : IsPullback p q f g)
    (T : Subring Γ(W, ⊤))
    (h₁ : ∀ a, (Scheme.Hom.appTop p).hom a ∈ T)
    (h₂ : ∀ b, (Scheme.Hom.appTop q).hom b ∈ T) :
    T = ⊤ := by
  let _ : Algebra (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u) := (Scheme.Hom.appTop f).hom.toAlgebra
  let _ : Algebra (Γ(Z, ⊤) : Type u) (Γ(Y, ⊤) : Type u) := (Scheme.Hom.appTop g).hom.toAlgebra
  have sqf : f ≫ Z.isoSpec.hom
      = X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u))) :=
    (Scheme.isoSpec_hom_naturality f).symm
  have sqg : g ≫ Z.isoSpec.hom
      = Y.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (Γ(Z, ⊤) : Type u) (Γ(Y, ⊤) : Type u))) :=
    (Scheme.isoSpec_hom_naturality g).symm
  set il : Γ(X, ⊤) ⟶ CommRingCat.of
      (TensorProduct (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u) (Γ(Y, ⊤) : Type u)) :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := (Γ(Z, ⊤) : Type u)) (A := (Γ(X, ⊤) : Type u)) (B := (Γ(Y, ⊤) : Type u))) with hil
  set ir : Γ(Y, ⊤) ⟶ CommRingCat.of
      (TensorProduct (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u) (Γ(Y, ⊤) : Type u)) :=
    CommRingCat.ofHom (RingHomClass.toRingHom (Algebra.TensorProduct.includeRight
      (R := (Γ(Z, ⊤) : Type u)) (A := (Γ(X, ⊤) : Type u)) (B := (Γ(Y, ⊤) : Type u)))) with hir
  set e : W ≅ Spec (CommRingCat.of
      (TensorProduct (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u) (Γ(Y, ⊤) : Type u))) :=
    hpb.isoPullback ≪≫
      asIso (pullback.map f g _ _ X.isoSpec.hom Y.isoSpec.hom Z.isoSpec.hom sqf sqg) ≪≫
      pullbackSpecIso (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u) (Γ(Y, ⊤) : Type u) with he
  set ψ : CommRingCat.of
      (TensorProduct (Γ(Z, ⊤) : Type u) (Γ(X, ⊤) : Type u) (Γ(Y, ⊤) : Type u)) ⟶ Γ(W, ⊤) :=
    (Scheme.ΓSpecIso _).inv ≫ Scheme.Hom.appTop e.hom with hψ
  have efst : e.hom ≫ Spec.map il = p ≫ X.isoSpec.hom := by
    rw [he, hil]
    simp only [Iso.trans_hom, asIso_hom, Category.assoc, pullbackSpecIso_hom_fst]
    rw [pullback.lift_fst, ← Category.assoc, hpb.isoPullback_hom_fst]
  have esnd : e.hom ≫ Spec.map ir = q ≫ Y.isoSpec.hom := by
    rw [he, hir]
    simp only [Iso.trans_hom, asIso_hom, Category.assoc, pullbackSpecIso_hom_snd]
    rw [pullback.lift_snd, ← Category.assoc, hpb.isoPullback_hom_snd]
  have keyfc : il ≫ ψ = Scheme.Hom.appTop p := by
    rw [hψ, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
      ← Scheme.Hom.comp_appTop, efst, Scheme.Hom.comp_appTop, ← Category.assoc,
      Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop, Iso.inv_hom_id, Category.id_comp]
  have keysc : ir ≫ ψ = Scheme.Hom.appTop q := by
    rw [hψ, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
      ← Scheme.Hom.comp_appTop, esnd, Scheme.Hom.comp_appTop, ← Category.assoc,
      Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop, Iso.inv_hom_id, Category.id_comp]
  have keyf : ∀ a : (Γ(X, ⊤) : Type u),
      ψ.hom (a ⊗ₜ[(Γ(Z, ⊤) : Type u)] (1 : (Γ(Y, ⊤) : Type u))) = (Scheme.Hom.appTop p).hom a :=
    fun a => congrArg (fun φ : Γ(X, ⊤) ⟶ Γ(W, ⊤) => φ.hom a) keyfc
  have keyg : ∀ b : (Γ(Y, ⊤) : Type u),
      ψ.hom ((1 : (Γ(X, ⊤) : Type u)) ⊗ₜ[(Γ(Z, ⊤) : Type u)] b) = (Scheme.Hom.appTop q).hom b :=
    fun b => congrArg (fun φ : Γ(Y, ⊤) ⟶ Γ(W, ⊤) => φ.hom b) keysc
  have hχ : (Scheme.Hom.appTop e.inv ≫ (Scheme.ΓSpecIso _).hom) ≫ ψ = 𝟙 Γ(W, ⊤) := by
    rw [hψ, Category.assoc, ← Category.assoc (Scheme.ΓSpecIso _).hom, Iso.hom_inv_id,
      Category.id_comp, ← Scheme.Hom.comp_appTop, e.hom_inv_id, Scheme.Hom.id_appTop]
  refine top_unique fun x _ => ?_
  obtain ⟨z, hz⟩ : ∃ z, ψ.hom z = x := by
    refine ⟨(Scheme.Hom.appTop e.inv ≫ (Scheme.ΓSpecIso _).hom).hom x, ?_⟩
    rw [← CommRingCat.comp_apply, hχ, CommRingCat.id_apply]
  rw [← hz]
  clear hz
  induction z using TensorProduct.inductionOn with
  | tmul a b =>
      rw [show a ⊗ₜ[(Γ(Z, ⊤) : Type u)] b
          = (a ⊗ₜ[(Γ(Z, ⊤) : Type u)] (1 : (Γ(Y, ⊤) : Type u)))
            * ((1 : (Γ(X, ⊤) : Type u)) ⊗ₜ[(Γ(Z, ⊤) : Type u)] b) by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]]
      rw [map_mul, keyf, keyg]
      exact T.mul_mem (h₁ a) (h₂ b)
  | add z w hz hw => rw [map_add]; exact T.add_mem hz hw

/-- Restricting a morphism to `Wo ⟶ U` and taking global sections agrees with `appLE`, up to
`Wo.topIso`. -/
private theorem topIso_appTop_resLE {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (Wo : X.Opens)
    (h : Wo ≤ f ⁻¹ᵁ U) (a : Γ(U, ⊤)) :
    Wo.topIso.hom.hom ((Scheme.Hom.appTop (f.resLE U Wo h)).hom a) =
      (f.appLE U Wo h).hom (U.topIso.hom.hom a) := by
  rw [Scheme.Hom.appTop, Scheme.Hom.resLE_app_top, CommRingCat.comp_apply,
    CommRingCat.comp_apply, ← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]

/-- **The ring of functions on `pr₁⁻¹U ⊓ pr₂⁻¹V` is generated by the functions coming from `U`
and from `V`**, for `Z` affine and `U`, `V` affine opens.

The open is taken as a variable `Wo` together with an equation, so that a consumer whose chart is
only *provably* equal to the intersection can use it: the type `Subring Γ(X ×_Z Y, Wo)` depends on
`Wo`, so rewriting is not available and `subst` is.

The two maps are `AlgebraicGeometry.Scheme.Hom.appLE`, i.e. pull back along the projection and
restrict; `AlgebraicGeometry.Scheme.Hom.resLE_app_top` is what carries that spelling to the
`appTop` of the restricted morphism which `subring_eq_top_of_isPullback` consumes. The pullback
square for the restricted projections is Mathlib's open immersion
`U ×_Z V ⟶ X ×_Z Y` — the same one that proves the chart affine — transported by
`AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq`. -/
theorem subring_eq_top_of_pullback_inf {X Y Z : Scheme.{u}} [IsAffine Z]
    (f : X ⟶ Z) (g : Y ⟶ Z) {U : X.Opens} (hU : IsAffineOpen U) {V : Y.Opens}
    (hV : IsAffineOpen V) {Wo : (pullback f g).Opens}
    (hWo : Wo = pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V)
    (le₁ : Wo ≤ pullback.fst f g ⁻¹ᵁ U) (le₂ : Wo ≤ pullback.snd f g ⁻¹ᵁ V)
    (T : Subring Γ(pullback f g, Wo))
    (h₁ : ∀ a : Γ(X, U), ((pullback.fst f g).appLE U Wo le₁).hom a ∈ T)
    (h₂ : ∀ b : Γ(Y, V), ((pullback.snd f g).appLE V Wo le₂).hom b ∈ T) :
    T = ⊤ := by
  subst hWo
  have : IsAffine U.toScheme := hU
  have : IsAffine V.toScheme := hV
  have e₁ : (U.ι ≫ f) ≫ (𝟙 Z) = U.ι ≫ f := Category.comp_id _
  have e₂ : (V.ι ≫ g) ≫ (𝟙 Z) = V.ι ≫ g := Category.comp_id _
  have hrange0 : (pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z) e₁ e₂).opensRange
      = pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V := by
    refine TopologicalSpace.Opens.ext ?_
    rw [Scheme.Hom.coe_opensRange, Scheme.Pullback.range_map]
    simp [Scheme.Opens.range_ι]
  set ε := IsOpenImmersion.isoOfRangeEq
    (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).ι
    (pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z) e₁ e₂)
    (by rw [Scheme.Opens.range_ι, ← Scheme.Hom.coe_opensRange, hrange0]) with hε
  have hfac : ε.hom ≫ pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z) e₁ e₂
      = (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).ι := by
    rw [hε]; exact IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
  have hq₁ι : (pullback.fst f g).resLE U _ inf_le_left ≫ U.ι
      = (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).ι ≫ pullback.fst f g :=
    Scheme.Hom.resLE_comp_ι _ _
  have hq₂ι : (pullback.snd f g).resLE V _ inf_le_right ≫ V.ι
      = (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).ι ≫ pullback.snd f g :=
    Scheme.Hom.resLE_comp_ι _ _
  have w₁ : ε.hom ≫ pullback.fst (U.ι ≫ f) (V.ι ≫ g)
      = (pullback.fst f g).resLE U _ inf_le_left := by
    rw [← cancel_mono U.ι, Category.assoc, hq₁ι,
      show pullback.fst (U.ι ≫ f) (V.ι ≫ g) ≫ U.ι
        = pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z) e₁ e₂ ≫ pullback.fst f g from
        (pullback.lift_fst _ _ _).symm, ← Category.assoc, hfac]
  have w₂ : ε.hom ≫ pullback.snd (U.ι ≫ f) (V.ι ≫ g)
      = (pullback.snd f g).resLE V _ inf_le_right := by
    rw [← cancel_mono V.ι, Category.assoc, hq₂ι,
      show pullback.snd (U.ι ≫ f) (V.ι ≫ g) ≫ V.ι
        = pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z) e₁ e₂ ≫ pullback.snd f g from
        (pullback.lift_snd _ _ _).symm, ← Category.assoc, hfac]
  have sq : CommSq ((pullback.fst f g).resLE U _ inf_le_left)
      ((pullback.snd f g).resLE V _ inf_le_right) (U.ι ≫ f) (V.ι ≫ g) := by
    refine ⟨?_⟩
    rw [← Category.assoc, hq₁ι, ← Category.assoc, hq₂ι, Category.assoc, Category.assoc,
      pullback.condition]
  have hpb : IsPullback ((pullback.fst f g).resLE U _ inf_le_left)
      ((pullback.snd f g).resLE V _ inf_le_right) (U.ι ≫ f) (V.ι ≫ g) :=
    IsPullback.of_iso_pullback sq ε w₁ w₂
  have hcomap := subring_eq_top_of_isPullback hpb
    (T.comap (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).topIso.hom.hom) ?_ ?_
  · refine top_unique fun y _ => ?_
    obtain ⟨y', rfl⟩ : ∃ y',
        (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).topIso.hom.hom y' = y :=
      ⟨(pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).topIso.inv.hom y, by
        rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]⟩
    have hy : y' ∈ T.comap
        (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V).topIso.hom.hom := by
      rw [hcomap]; trivial
    exact hy
  · intro a
    rw [Subring.mem_comap, topIso_appTop_resLE _ _ _ inf_le_left]
    exact h₁ _
  · intro b
    rw [Subring.mem_comap, topIso_appTop_resLE _ _ _ inf_le_right]
    exact h₂ _

end Stacks.AlgebraicGeometry

end
