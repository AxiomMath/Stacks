module

public import StacksFrontier.AlgebraicGeometry.Segre.CoordinateNonvanishing
public import StacksFrontier.AlgebraicGeometry.Segre.MonoResidue

/-!
# The Segre chart is affine, and `Mono (segreMorphism n m)` is down to one hypothesis

`StacksFrontier/AlgebraicGeometry/Segre/MonoResidue.lean` reduces
`CategoryTheory.Mono (AlgebraicGeometry.Segre.segreMorphism n m)` — and with it [Stacks, Tag 01WD]
and Chow's lemma over a Noetherian base — to two statements about the Segre chart: that it is
**affine**, and that its ring is generated by the ratios `Z_{ab} / Z_{ij}`. This file **proves the
first**, so only the ring statement is left.

The proof is possible only because
`StacksFrontier/AlgebraicGeometry/Segre/CoordinateNonvanishing.lean` identifies the chart with
`pr₁⁻¹D₊(Xᵢ) ⊓ pr₂⁻¹D₊(Yⱼ)`: a nonvanishing locus is not visibly affine, and a product of
standard opens is. What makes it affine is a general fact with no projective geometry in it —
in a fibre product over an **affine** base, the intersection of the preimages of two affine opens
is affine, because it is the range of the open immersion
`U ×_Z V ⟶ X ×_Z Y` and a fibre product of affines over an affine is affine.

## Main results

* `Stacks.AlgebraicGeometry.isAffineOpen_pullback_inf`: **`pr₁⁻¹U ⊓ pr₂⁻¹V` is an affine open of
  `X ×_Z Y` for affine opens `U`, `V` and affine `Z`.** Generic; see the note below on where it
  belongs.
* `AlgebraicGeometry.Segre.isAffineOpen_nonvanishingChart_segreSections`: **every Segre chart is
  an affine open**, which is the first hypothesis of
  `AlgebraicGeometry.Segre.mono_segreMorphism_of_chart`.
* `AlgebraicGeometry.Segre.mono_segreMorphism_of_chartHom_surjective` and
  `AlgebraicGeometry.Segre.hasSegreMonoZ_of_chartHom_surjective`: **`Mono (segreMorphism n m)`,
  and hence Chow's lemma over a Noetherian base, from the single remaining hypothesis** that the
  chart ring homomorphism is surjective.

## Implementation notes

`Stacks.AlgebraicGeometry.isAffineOpen_pullback_inf` is the affine analogue of Mathlib's
`AlgebraicGeometry.IsAffineOpen.isCompact_pullback_inf` and is proved the same way: the
comparison map is `pullback.map` along `U.ι`, `V.ι` and `𝟙 Z`, its range is computed by
`AlgebraicGeometry.Scheme.Pullback.range_map` (which needs only `Mono (𝟙 Z)`), it is an open
immersion by `AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion`, and its source is affine by
`AlgebraicGeometry.isAffine_of_isAffine_isAffine_isAffine`. The base map is *not* required to be
affine and the two opens are arbitrary affine opens, so nothing here is special to projective
space; REPO-TIER: it belongs beside Mathlib's lemma rather than under `Segre/`, and is here only
because that is this file's boundary.

The Segre product is a fibre product over `⊤_ Scheme`, whose affineness is Mathlib's instance in
`Mathlib/AlgebraicGeometry/Limits.lean`; no identification of the terminal scheme with `Spec ℤ` is
needed, and none is performed.

`AlgebraicGeometry.Segre.segreFst` and `segreSnd` are definitionally `pullback.fst` and
`pullback.snd`, so the general lemma applies to the chart by a bare term application with no
transport.

No `@[stacks 01WD]` attribute is attached anywhere: everything here is still conditional on the
surjectivity of the chart ring homomorphism.

## References

* [Stacks Project, Tag 01WD](https://stacks.math.columbia.edu/tag/01WD)
* [Stacks Project, Tag 0200](https://stacks.math.columbia.edu/tag/0200)
-/

@[expose] public section

open CategoryTheory Opposite Limits TopologicalSpace AlgebraicGeometry

universe u

namespace Stacks.AlgebraicGeometry

/-- **In a fibre product over an affine base, the intersection of the preimages of two affine
opens is affine.** It is the range of the open immersion `U ×_Z V ⟶ X ×_Z Y`, whose source is a
fibre product of affines over an affine. -/
theorem isAffineOpen_pullback_inf {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) [IsAffine Z]
    {U : X.Opens} (hU : IsAffineOpen U) {V : Y.Opens} (hV : IsAffineOpen V) :
    IsAffineOpen (pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V) := by
  have : IsAffine U.toScheme := hU
  have : IsAffine V.toScheme := hV
  have hrange : (pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z)
        (by simp) (by simp)).opensRange
      = pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V := by
    refine TopologicalSpace.Opens.ext ?_
    rw [Scheme.Hom.coe_opensRange, Scheme.Pullback.range_map]
    simp [Scheme.Opens.range_ι]
  rw [← hrange]
  exact isAffineOpen_opensRange _

end Stacks.AlgebraicGeometry

namespace AlgebraicGeometry.Segre

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The standard open of a homogeneous coordinate is an affine open of `ℙⁿ_ℤ`: it is
`Spec` of the degree-zero part of the localization, the coordinate having degree one. -/
theorem isAffineOpen_basicOpen_X (n : ℕ) (i : Fin (n + 1)) :
    IsAffineOpen (Proj.basicOpen (coordinateGrading.{u} n) (MvPolynomial.X i)) :=
  Proj.isAffineOpen_basicOpen _ _ (Stacks.ProjectiveChart.X_mem_degree_one _ i) Nat.one_pos

/-- **Every Segre chart is an affine open of `ℙⁿ_ℤ ×_{Spec ℤ} ℙᵐ_ℤ`.** It is
`pr₁⁻¹D₊(Xᵢ) ⊓ pr₂⁻¹D₊(Yⱼ)` by
`AlgebraicGeometry.Segre.nonvanishingChart_segreSections_eq_inf_basicOpen`, the two standard
opens are affine, and the base is the terminal scheme, which is affine. -/
theorem isAffineOpen_nonvanishingChart_segreSections (n m : ℕ)
    (k : Fin (n * m + n + m + 1)) :
    IsAffineOpen (Stacks.ProjectiveSpaceSections.nonvanishingChart (segreModule.{u} n m)
      (segreSections.{u} n m k)) := by
  rw [nonvanishingChart_segreSections_eq_inf_basicOpen.{u} n m k]
  exact Stacks.AlgebraicGeometry.isAffineOpen_pullback_inf _ _
    (isAffineOpen_basicOpen_X.{u} n (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1)
    (isAffineOpen_basicOpen_X.{u} m (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2)

/-- **`Mono (segreMorphism n m)` from the single hypothesis that the chart ring homomorphism is
surjective**: the affineness hypothesis of
`AlgebraicGeometry.Segre.mono_segreMorphism_of_chart` is now a theorem. -/
theorem mono_segreMorphism_of_chartHom_surjective (n m : ℕ)
    (hsurj : ∀ k, Function.Surjective
      (Stacks.ProjectiveSpaceSections.chartHom (segreModule.{u} n m)
        (segreSections.{u} n m) k)) :
    CategoryTheory.Mono (segreMorphism.{u} n m) :=
  mono_segreMorphism_of_chart.{u} n m
    (fun k => isAffineOpen_nonvanishingChart_segreSections.{u} n m k) hsurj

/-- **Chow's lemma over a Noetherian base, dense-open clause included, from the single
hypothesis that the Segre chart ring homomorphisms are surjective**: this feeds
`AlgebraicGeometry.hasDenseChowModification_of_hasSegreMonoZ`. -/
theorem hasSegreMonoZ_of_chartHom_surjective
    (hsurj : ∀ (n m : ℕ) k, Function.Surjective
      (Stacks.ProjectiveSpaceSections.chartHom (segreModule.{u} n m)
        (segreSections.{u} n m) k)) :
    HasSegreMonoZ.{u} :=
  hasSegreMonoZ_of_mono.{u} fun n m =>
    mono_segreMorphism_of_chartHom_surjective.{u} n m (hsurj n m)

end AlgebraicGeometry.Segre

end
