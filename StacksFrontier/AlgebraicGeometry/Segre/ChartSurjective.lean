/-!
# The Segre chart ring homomorphism is surjective, and Chow's lemma over a Noetherian base

We prove that the Segre chart ring homomorphism
`Stacks.ProjectiveSpaceSections.chartHom (segreModule n m) (segreSections n m) k` is surjective,
and deduce that the Segre morphism `ℙⁿ_ℤ ×_{Spec ℤ} ℙᵐ_ℤ ⟶ ℙ^{nm+n+m}_ℤ` is a monomorphism and a
closed immersion, that the Segre embedding exists over every base ([Stacks, Tag 01WD]), and
Chow's lemma over a Noetherian base.

The chart is `pr₁⁻¹D₊(Xᵢ) ⊓ pr₂⁻¹D₊(Yⱼ)` inside `ℙⁿ_ℤ ×_{Spec ℤ} ℙᵐ_ℤ`, so its ring is
`Aᵢ ⊗_ℤ Bⱼ`, and the ratios `Z_{ab} / Z_{ij}` are the products `(X_a/Xᵢ)(Y_b/Yⱼ)`. Setting `b = j`
gives `X_a/Xᵢ` and setting `a = i` gives `Y_b/Yⱼ`, so the ratios generate each factor; and each
factor's ring is generated by *its* ratios, which is the chart computation of [Stacks, Tag 01NG].

## Main results

* `Stacks.SheafOfModules.divBySection_modulePullbackSection_of_le`: the ratio of two pulled-back
  sections of an invertible module, on any open inside the preimage of an open `U` contained in
  the nonvanishing locus, is the image of their ratio on `U`.
* `AlgebraicGeometry.Segre.divBySection_segreSection_fst` and
  `AlgebraicGeometry.Segre.divBySection_segreSection_snd`: the Segre chart ratios
  `Z_{aj}/Z_{ij}` and `Z_{ib}/Z_{ij}` are the pullbacks of `X_a/Xᵢ` and `Y_b/Yⱼ`.
* `AlgebraicGeometry.Segre.surjective_chartHom_segreSections`: the Segre chart ring homomorphism
  is surjective.
* `AlgebraicGeometry.Segre.mono_segreMorphism`: the Segre morphism is a monomorphism.
* `AlgebraicGeometry.Segre.isClosedImmersion_segreMorphism` and
  `AlgebraicGeometry.Segre.hasSegreEmbeddingSharp`: [Stacks, Tag 01WD], the Segre embedding
  `ℙⁿ_S ×_S ℙᵐ_S ⟶ ℙ^{nm+n+m}_S` is a closed immersion, for the integral models and over every
  base.
* `AlgebraicGeometry.hasDenseChowModification` and `AlgebraicGeometry.hasChowModification`:
  [Stacks, Tag 0200], Chow's lemma over a Noetherian base, including the clause that the
  modification is an isomorphism over a dense open subscheme.

## Implementation notes

The nonvanishing locus of the coordinate section equals `D₊(Xᵢ)`
(`AlgebraicGeometry.Segre.nonvanishingOpen_coordinateSection_eq_basicOpen`), but the subring type
`Subring Γ(ℙⁿ, U)` depends on `U`, so the generation statement is restated at the
nonvanishing-locus spelling of the open in
`AlgebraicGeometry.Segre.sectionsSubring_eq_top_of_divBySection_mem'`.

## References

* [Stacks Project, Tag 01WD](https://stacks.math.columbia.edu/tag/01WD)
* [Stacks Project, Tag 0200](https://stacks.math.columbia.edu/tag/0200)
* [Stacks Project, Tag 01NF](https://stacks.math.columbia.edu/tag/01NF)
* [Stacks Project, Tag 01NG](https://stacks.math.columbia.edu/tag/01NG)
-/

@[expose] public section

open CategoryTheory Opposite Limits TopologicalSpace AlgebraicGeometry
open Stacks.SheafOfModules.TensorStalkRingedSpace
open Stacks.SheafOfModules Stacks.ProjTwistSection Stacks.ProjectiveSpaceSections

universe u

namespace Stacks.SheafOfModules

/-- For a morphism of schemes `φ : X ⟶ Y`, an invertible module `L` on `Y`, sections `s t` of `L`
and opens `V ≤ φ ⁻¹ᵁ U` with `U` inside the nonvanishing locus of `s`, the ratio `φ^* t / φ^* s`
on `V` is the image under `φ.appLE U V` of the ratio `t / s` on `U`. -/
theorem divBySection_modulePullbackSection_of_le {X Y : Scheme.{u}} (φ : X ⟶ Y) (L : Y.Modules)
    [hL : IsInvertible Y.presheaf (structureSheafRing Y.toRingedSpace).property L]
    (s t : L.sections) {U : Y.Opens}
    (hU : U ≤ nonvanishingOpen (X := Y.toRingedSpace) L s) {V : X.Opens}
    (hV : V ≤ φ ⁻¹ᵁ U) :
    letI : IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property
        ((RingedSpaceModuleAdjunction.modulePullback φ.toLRSHom.toShHom).obj L) :=
      @Stacks.RingedSpace.isInvertible_modulePullback X.toRingedSpace Y.toRingedSpace
        φ.toLRSHom.toShHom L hL
    divBySection ((RingedSpaceModuleAdjunction.modulePullback φ.toLRSHom.toShHom).obj L)
        (modulePullbackSection φ.toLRSHom L s)
        ((hV.trans (fun _ hx => hU hx)).trans (le_of_eq (preimage_nonvanishingOpen φ L s)))
        ((modulePullbackSection φ.toLRSHom L t).eval (op V))
      = (φ.appLE U V hV).hom (divBySection L s hU (t.eval (op U))) := by
  have hmap : divBySection L s hU (t.eval (op U))
      = (Y.presheaf.map (homOfLE hU).op).hom
          (divBySection L s le_rfl
            (t.eval (op (nonvanishingOpen (X := Y.toRingedSpace) L s)))) :=
    ((map_divBySection L s hU le_rfl
        (t.eval (op (nonvanishingOpen (X := Y.toRingedSpace) L s)))).trans
      (congrArg (divBySection L s (hU.trans le_rfl))
        (secRestr_sections_eval L t hU))).symm
  rw [hmap, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  exact divBySection_modulePullbackSection φ L s t _

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Segre

attribute [local instance] MvPolynomial.gradedAlgebra

section Factors

variable (n m : ℕ) (i : Fin (n + 1)) (j : Fin (m + 1))

private theorem isInvertible_pullFst : IsInvertible (segreProduct.{u} n m).presheaf
    (structureSheafRing (segreProduct.{u} n m).toRingedSpace).property
    ((Scheme.Modules.pullback (segreFst.{u} n m)).obj
      (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)) :=
  Stacks.Modules.isInvertible_pullback _ _

private theorem isInvertible_pullSnd : IsInvertible (segreProduct.{u} n m).presheaf
    (structureSheafRing (segreProduct.{u} n m).toRingedSpace).property
    ((Scheme.Modules.pullback (segreSnd.{u} n m)).obj
      (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)) :=
  Stacks.Modules.isInvertible_pullback _ _

/-- The Segre chart ratio `Z_{ab} / Z_{ij}` is the product of the pullbacks of `X_a / Xᵢ` and
`Y_b / Yⱼ`. -/
private theorem divBySection_segreSection_eq_mul (a : Fin (n + 1)) (b : Fin (m + 1))
    (hle : nonvanishingOpen (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j)
      ≤ segreFst.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i))
    (hleG : nonvanishingOpen (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j)
      ≤ segreSnd.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j)) :
    divBySection (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j) le_rfl
        ((segreSection.{u} n m a b).eval (op (nonvanishingOpen (segreModule.{u} n m)
          (segreSection.{u} n m i j))))
      = ((segreFst.{u} n m).appLE _ _ hle).hom
          (divBySection (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
            (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i) le_rfl
            ((coordinateSection.{u} n a).eval (op (nonvanishingOpen
              (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)
              (coordinateSection.{u} n i)))))
        * ((segreSnd.{u} n m).appLE _ _ hleG).hom
          (divBySection (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
            (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j) le_rfl
            ((coordinateSection.{u} m b).eval (op (nonvanishingOpen
              (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)
              (coordinateSection.{u} m j))))) := by
  have hF := isInvertible_pullFst.{u} n m
  have hG := isInvertible_pullSnd.{u} n m
  have hF' : IsInvertible (segreProduct.{u} n m).toRingedSpace.presheaf
      (structureSheafRing (segreProduct.{u} n m).toRingedSpace).property
      ((RingedSpaceModuleAdjunction.modulePullback
        (segreFst.{u} n m).toLRSHom.toShHom).obj
        (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)) := hF
  have hG' : IsInvertible (segreProduct.{u} n m).toRingedSpace.presheaf
      (structureSheafRing (segreProduct.{u} n m).toRingedSpace).property
      ((RingedSpaceModuleAdjunction.modulePullback
        (segreSnd.{u} n m).toLRSHom.toShHom).obj
        (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)) := hG
  have hVF := hle.trans (le_of_eq (preimage_nonvanishingOpen (segreFst.{u} n m)
    (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i)))
  have hVG := hleG.trans (le_of_eq (preimage_nonvanishingOpen (segreSnd.{u} n m)
    (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j)))
  refine Eq.trans (divBySection_tensorSections
    ((Scheme.Modules.pullback (segreFst.{u} n m)).obj
      (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1))
    ((Scheme.Modules.pullback (segreSnd.{u} n m)).obj
      (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1))
    (modulePullbackSection (segreFst.{u} n m).toLRSHom _ (coordinateSection.{u} n i))
    (modulePullbackSection (segreFst.{u} n m).toLRSHom _ (coordinateSection.{u} n a))
    (modulePullbackSection (segreSnd.{u} n m).toLRSHom _ (coordinateSection.{u} m j))
    (modulePullbackSection (segreSnd.{u} n m).toLRSHom _ (coordinateSection.{u} m b))
    hVF hVG) ?_
  exact congrArg₂ (· * ·)
    (divBySection_modulePullbackSection_of_le (segreFst.{u} n m)
      (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i)
      (coordinateSection.{u} n a) le_rfl hle)
    (divBySection_modulePullbackSection_of_le (segreSnd.{u} n m)
      (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j)
      (coordinateSection.{u} m b) le_rfl hleG)

/-- **The Segre chart ratio `Z_{aj} / Z_{ij}` is the pullback of the ratio `X_a / Xᵢ`.** -/
theorem divBySection_segreSection_fst (a : Fin (n + 1))
    (hle : nonvanishingOpen (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j)
      ≤ segreFst.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i))
    (hleG : nonvanishingOpen (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j)
      ≤ segreSnd.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j)) :
    divBySection (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j) le_rfl
        ((segreSection.{u} n m a j).eval (op (nonvanishingOpen (segreModule.{u} n m)
          (segreSection.{u} n m i j))))
      = ((segreFst.{u} n m).appLE _ _ hle).hom
          (divBySection (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
            (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i) le_rfl
            ((coordinateSection.{u} n a).eval (op (nonvanishingOpen
              (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)
              (coordinateSection.{u} n i))))) := by
  refine (divBySection_segreSection_eq_mul n m i j a j hle hleG).trans ?_
  exact (congrArg _ ((congrArg _ (divBySection_self _ _ le_rfl)).trans (map_one _))).trans
    (mul_one _)

/-- **The Segre chart ratio `Z_{ib} / Z_{ij}` is the pullback of the ratio `Y_b / Yⱼ`.** -/
theorem divBySection_segreSection_snd (b : Fin (m + 1))
    (hle : nonvanishingOpen (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j)
      ≤ segreFst.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i))
    (hleG : nonvanishingOpen (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j)
      ≤ segreSnd.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j)) :
    divBySection (X := (segreProduct.{u} n m).toRingedSpace) (segreModule.{u} n m)
        (segreSection.{u} n m i j) le_rfl
        ((segreSection.{u} n m i b).eval (op (nonvanishingOpen (segreModule.{u} n m)
          (segreSection.{u} n m i j))))
      = ((segreSnd.{u} n m).appLE _ _ hleG).hom
          (divBySection (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
            (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1) (coordinateSection.{u} m j) le_rfl
            ((coordinateSection.{u} m b).eval (op (nonvanishingOpen
              (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)
              (coordinateSection.{u} m j))))) := by
  refine (divBySection_segreSection_eq_mul n m i j i b hle hleG).trans ?_
  exact (congrArg (· * _) ((congrArg _ (divBySection_self _ _ le_rfl)).trans (map_one _))).trans
    (one_mul _)
end Factors

/-- **`Γ(ℙⁿ_ℤ, X_{Xᵢ})` is generated by the ratios `X_a / Xᵢ`**, at the nonvanishing-locus
spelling of the open. -/
theorem sectionsSubring_eq_top_of_divBySection_mem'
    (n : ℕ) (i : Fin (n + 1))
    {O : (projectiveSpaceAtUniverse.{u} n).Opens}
    (hO : O = Proj.basicOpen (coordinateGrading.{u} n) (MvPolynomial.X i))
    (hle : O ≤ nonvanishingOpen (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
      (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i))
    (T : Subring Γ(projectiveSpaceAtUniverse.{u} n, O))
    (h : ∀ a : Fin (n + 1), divBySection
      (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
      (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1) (coordinateSection.{u} n i) hle
      ((coordinateSection.{u} n a).eval (op O)) ∈ T) :
    T = ⊤ := by
  subst hO
  exact Stacks.ProjTwistSection.sectionsSubring_eq_top_of_divBySection_mem.{u} n i T h

/-- **The Segre chart ring homomorphism is surjective.** -/
theorem surjective_chartHom_segreSections (n m : ℕ) (k : Fin (n * m + n + m + 1)) :
    Function.Surjective (chartHom (segreModule.{u} n m) (segreSections.{u} n m) k) := by
  have hWo : nonvanishingChart (segreModule.{u} n m) (segreSections.{u} n m k)
      = segreFst.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)
          (coordinateSection.{u} n (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1)
        ⊓ segreSnd.{u} n m ⁻¹ᵁ nonvanishingOpen
          (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
          (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)
          (coordinateSection.{u} m (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2) :=
    nonvanishingOpen_segreSection.{u} n m _ _
  have le₁ := hWo.le.trans inf_le_left
  have le₂ := hWo.le.trans inf_le_right
  have hU : IsAffineOpen (nonvanishingOpen
      (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
      (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)
      (coordinateSection.{u} n (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1)) := by
    rw [nonvanishingOpen_coordinateSection_eq_basicOpen.{u} n
        (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1]
    exact isAffineOpen_basicOpen_X.{u} n _
  have hV : IsAffineOpen (nonvanishingOpen
      (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
      (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)
      (coordinateSection.{u} m (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2)) := by
    rw [nonvanishingOpen_coordinateSection_eq_basicOpen.{u} m
        (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2]
    exact isAffineOpen_basicOpen_X.{u} m _
  have hT : ((chartHom (segreModule.{u} n m) (segreSections.{u} n m) k).range.comap
      (nonvanishingChart (segreModule.{u} n m) (segreSections.{u} n m k)).topIso.inv.hom)
      = ⊤ := by
    refine Stacks.AlgebraicGeometry.subring_eq_top_of_pullback_inf _ _ hU hV hWo le₁ le₂ _ ?_ ?_
    · intro a
      have hgen : Subring.comap ((segreFst.{u} n m).appLE _ _ le₁).hom
          ((chartHom (segreModule.{u} n m) (segreSections.{u} n m) k).range.comap
            (nonvanishingChart (segreModule.{u} n m)
              (segreSections.{u} n m k)).topIso.inv.hom) = ⊤ := by
        refine sectionsSubring_eq_top_of_divBySection_mem'.{u} n
          (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1
          (nonvanishingOpen_coordinateSection_eq_basicOpen.{u} n
            (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1)
          le_rfl _ ?_
        intro b
        rw [Subring.mem_comap, Subring.mem_comap, RingHom.mem_range]
        refine ⟨MvPolynomial.X ((Stacks.ProductFamilyTwist.segreIndexEquiv n m).symm
          (b, (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2)), ?_⟩
        rw [chartHom_X]
        have hsl : segreSections.{u} n m ((Stacks.ProductFamilyTwist.segreIndexEquiv n m).symm
            (b, (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2))
            = segreSection.{u} n m b (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2 := by
          simp only [segreSections, Equiv.apply_symm_apply]
        have hchain : divBySection (X := (segreProduct.{u} n m).toRingedSpace)
            (segreModule.{u} n m) (segreSections.{u} n m k) le_rfl
            ((segreSections.{u} n m ((Stacks.ProductFamilyTwist.segreIndexEquiv n m).symm
              (b, (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2))).eval
              (op (nonvanishingChart (segreModule.{u} n m) (segreSections.{u} n m k))))
            = ((segreFst.{u} n m).appLE _ _ le₁).hom
              (divBySection (X := (projectiveSpaceAtUniverse.{u} n).toRingedSpace)
                (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)
                (coordinateSection.{u} n (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1) le_rfl
                ((coordinateSection.{u} n b).eval (op (nonvanishingOpen
                  (projectiveSpaceAtUniverseTwistingSheaf.{u} n 1)
                  (coordinateSection.{u} n
                    (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1))))) := by
          rw [hsl]
          exact divBySection_segreSection_fst.{u} n m
            (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1
            (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2 b le₁ le₂
        exact congrArg (fun x => (nonvanishingChart (segreModule.{u} n m)
          (segreSections.{u} n m k)).topIso.inv.hom x) hchain
      exact Subring.mem_comap.1 (hgen.ge trivial)
    · intro a
      have hgen : Subring.comap ((segreSnd.{u} n m).appLE _ _ le₂).hom
          ((chartHom (segreModule.{u} n m) (segreSections.{u} n m) k).range.comap
            (nonvanishingChart (segreModule.{u} n m)
              (segreSections.{u} n m k)).topIso.inv.hom) = ⊤ := by
        refine sectionsSubring_eq_top_of_divBySection_mem'.{u} m
          (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2
          (nonvanishingOpen_coordinateSection_eq_basicOpen.{u} m
            (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2)
          le_rfl _ ?_
        intro b
        rw [Subring.mem_comap, Subring.mem_comap, RingHom.mem_range]
        refine ⟨MvPolynomial.X ((Stacks.ProductFamilyTwist.segreIndexEquiv n m).symm
          ((Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1, b)), ?_⟩
        rw [chartHom_X]
        have hsl : segreSections.{u} n m ((Stacks.ProductFamilyTwist.segreIndexEquiv n m).symm
            ((Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1, b))
            = segreSection.{u} n m (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1 b := by
          simp only [segreSections, Equiv.apply_symm_apply]
        have hchain : divBySection (X := (segreProduct.{u} n m).toRingedSpace)
            (segreModule.{u} n m) (segreSections.{u} n m k) le_rfl
            ((segreSections.{u} n m ((Stacks.ProductFamilyTwist.segreIndexEquiv n m).symm
              ((Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1, b))).eval
              (op (nonvanishingChart (segreModule.{u} n m) (segreSections.{u} n m k))))
            = ((segreSnd.{u} n m).appLE _ _ le₂).hom
              (divBySection (X := (projectiveSpaceAtUniverse.{u} m).toRingedSpace)
                (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)
                (coordinateSection.{u} m (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2) le_rfl
                ((coordinateSection.{u} m b).eval (op (nonvanishingOpen
                  (projectiveSpaceAtUniverseTwistingSheaf.{u} m 1)
                  (coordinateSection.{u} m
                    (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2))))) := by
          rw [hsl]
          exact divBySection_segreSection_snd.{u} n m
            (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).1
            (Stacks.ProductFamilyTwist.segreIndexEquiv n m k).2 b le₁ le₂
        exact congrArg (fun x => (nonvanishingChart (segreModule.{u} n m)
          (segreSections.{u} n m k)).topIso.inv.hom x) hchain
      exact Subring.mem_comap.1 (hgen.ge trivial)
  intro z
  have hz : (nonvanishingChart (segreModule.{u} n m) (segreSections.{u} n m k)).topIso.hom.hom z
      ∈ ((chartHom (segreModule.{u} n m) (segreSections.{u} n m) k).range.comap
        (nonvanishingChart (segreModule.{u} n m) (segreSections.{u} n m k)).topIso.inv.hom) := by
    rw [hT]; trivial
  rw [Subring.mem_comap, ← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply] at hz
  exact hz

/-- **`Mono (segreMorphism n m)`.** -/
theorem mono_segreMorphism (n m : ℕ) : Mono (segreMorphism.{u} n m) :=
  mono_segreMorphism_of_chartHom_surjective.{u} n m (surjective_chartHom_segreSections.{u} n m)

/-- **The Segre morphism of the integral models is a closed immersion.** -/
@[stacks 01WD "the integral models", ega "II 4.3.3" "over Spec ℤ"]
theorem isClosedImmersion_segreMorphism (n m : ℕ) :
    IsClosedImmersion (segreMorphism.{u} n m) :=
  have := mono_segreMorphism.{u} n m
  isClosedImmersion_of_mono_projectiveSpaceZ.{u} (segreMorphism.{u} n m)

/-- For all `n m`, there is a monomorphism `ℙⁿ_ℤ ×_{Spec ℤ} ℙᵐ_ℤ ⟶ ℙ^{nm + n + m}_ℤ`. -/
theorem hasSegreMonoZSharp : HasSegreMonoZSharp.{u} :=
  hasSegreMonoZSharp_of_mono.{u} mono_segreMorphism.{u}

/-- For all `n m`, there is a monomorphism `ℙⁿ_ℤ ×_{Spec ℤ} ℙᵐ_ℤ ⟶ ℙᴺ_ℤ` for some `N`. -/
theorem hasSegreMonoZ : HasSegreMonoZ.{u} := hasSegreMonoZSharp.{u}.hasSegreMonoZ

/-- For all `n m`, there is a closed immersion `ℙⁿ_ℤ ×_{Spec ℤ} ℙᵐ_ℤ ⟶ ℙ^{nm + n + m}_ℤ`. -/
theorem hasSegreEmbeddingZSharp : HasSegreEmbeddingZSharp.{u} :=
  hasSegreEmbeddingZSharp_of_hasSegreMonoZSharp.{u} hasSegreMonoZSharp.{u}

/-- **[Stacks, Tag 01WD] over an arbitrary base.** For every scheme `S` and all `n m`, there is a
closed immersion `ℙⁿ_S ×_S ℙᵐ_S ⟶ ℙ^{nm + n + m}_S` over `S`. -/
@[stacks 01WD "over an arbitrary base", ega "II 4.3.3"]
theorem hasSegreEmbeddingSharp (S : Scheme.{u}) : HasSegreEmbeddingSharp S :=
  hasSegreEmbeddingSharp_of_hasSegreEmbeddingZSharp.{u} hasSegreEmbeddingZSharp.{u} S

/-- For every scheme `S` and all `n m`, there is a closed immersion `ℙⁿ_S ×_S ℙᵐ_S ⟶ ℙᴺ_S` over
`S` for some `N`. -/
theorem hasSegreEmbedding (S : Scheme.{u}) : HasSegreEmbedding S :=
  (hasSegreEmbeddingSharp.{u} S).hasSegreEmbedding

end AlgebraicGeometry.Segre

namespace AlgebraicGeometry

/-- **Chow's lemma over a Noetherian base.** -/
@[stacks 0200,
  sga "4 XVII 7.0.6" "Noetherian base",
  sga "4 XII 7.1" "Noetherian case",
  ega "II 5.6.1" "(a); (i),(ii)", sga "4½ Arcata 3.4.3" "Chow's lemma step"]
theorem hasDenseChowModification {X S : Scheme.{u}} (f : X ⟶ S) [IsNoetherian S]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    HasDenseChowModification f :=
  hasDenseChowModification_of_hasSegreMonoZ.{u} Segre.hasSegreMonoZ.{u} f

/-- **Chow's lemma over a Noetherian base.** For a separated, quasi-compact morphism `f : X ⟶ S`
locally of finite type with `S` Noetherian, there are a proper surjective `π : X' ⟶ X` and an
immersion `X' ⟶ ℙⁿ_S` compatible with the maps to `S`. -/
theorem hasChowModification {X S : Scheme.{u}} (f : X ⟶ S) [IsNoetherian S]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    HasChowModification f :=
  (hasDenseChowModification.{u} f).hasChowModification

end AlgebraicGeometry

