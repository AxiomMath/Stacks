module

public import StacksFrontier.AlgebraicGeometry.Smooth.SqZeroAlgebra
public import StacksFrontier.Topology.Sheaves.Modules.SquareZeroExtension
public import StacksFrontier.AlgebraicGeometry.Smooth.CotangentSheafAffine

/-!
# The square-zero extension of the structure sheaf by a sheaf of modules

For a scheme `X` and a sheaf of `𝒪_X`-modules `M`, the sections of `𝒪_X` and of `M` over an open
`U` assemble into the trivial square-zero extension `Γ(X, U) ⋉ Γ(M, U)`, and these form a sheaf of
commutative rings on `X`. This file constructs that sheaf and uses it for one purpose: to convert
a relative derivation of `𝒪_X` over the *pushforward* presentation `f^♯ : 𝒪_S ⟶ f_*𝒪_X` of a
morphism of schemes `f : X ⟶ S` into a relative derivation over the *inverse image* presentation
`f⁻¹𝒪_S ⟶ 𝒪_X`, which is the one the sheaf of relative differentials `Ω_{X/S}` is built from.

That conversion is the content of `Stacks.Smooth.apply_inverseImageStructureApp_eq_zero`. It is
exactly the step that Mathlib leaves as a TODO in
`Mathlib/Algebra/Category/ModuleCat/Differentials/Presheaf.lean`, where
`PresheafOfModules.Derivation` is defined for a morphism `S ⟶ F.op ⋙ R` of presheaves of
commutative rings and the identification of those derivations with the ones for the pullback of
`S` along `F` is deferred.

## Main definitions

* `Stacks.Smooth.sqZeroRingHom` presents a map satisfying the Leibniz rule relative to a ring
  homomorphism as a ring homomorphism into a trivial square-zero extension, and
  `Stacks.Smooth.sqZeroMap` is the functoriality of the square-zero extension.
* `Stacks.Smooth.sqZeroPresheaf` and `Stacks.Smooth.sqZeroSheaf` are the sheaf of commutative
  rings `𝒪_X ⋉ M` on `X`.
* `Stacks.Smooth.sqZeroInverseImageHom` is the morphism of sheaves of rings
  `f⁻¹𝒪_S ⟶ 𝒪_X ⋉ M` attached to a compatible family of maps `Γ(X, V₀) → Γ(M, V₀)` satisfying
  the Leibniz rule.

## Main results

* `Stacks.Smooth.sqZeroPresheaf_isSheaf`: the square-zero extension of the structure sheaf is a
  sheaf, because a section of it is a pair of sections and restriction acts componentwise.
* `Stacks.Smooth.apply_inverseImageStructureApp_eq_zero`: a compatible family of additive maps
  `Γ(X, V₀) → Γ(M, V₀)` satisfying the Leibniz rule and killing the image of `Γ(S, V')` in
  `Γ(X, f ⁻¹ᵁ V')` for every open `V'` of `S` kills the image of the structure map
  `f⁻¹𝒪_S ⟶ 𝒪_X` over every open of `X`.

## Implementation notes

The vanishing statement is proved by adjunction rather than by a local computation. Both
`t ↦ (σ t, d (σ t))` and `t ↦ (σ t, 0)` are morphisms of sheaves of commutative rings from
`f⁻¹𝒪_S` to `𝒪_X ⋉ M` — the first one is a ring homomorphism precisely because `d` satisfies the
Leibniz rule — and by `f⁻¹ ⊣ f_*` a morphism out of `f⁻¹𝒪_S` into a *sheaf* of rings is
determined by its composite with the unit `𝒪_S ⟶ f_*f⁻¹𝒪_S`. On that composite the two morphisms
agree by hypothesis, by
`Stacks.Smooth.inverseImageStructureMap_inverseImageSection`. The alternative, showing directly
that `f⁻¹𝒪_S` is locally generated by the images of the `Γ(S, V')`, would mean unfolding the left
Kan extension and the sheafification that define `TopCat.Sheaf.pullback`; the price paid here
instead is the sheaf condition for `𝒪_X ⋉ M`, which is elementary.

Mathlib's `TrivSqZeroExt.commRing` asks for an action of the opposite ring, which for a
commutative ring is not an instance; `Stacks.Smooth.moduleMulOpposite` supplies it and is a local
instance of this file only.

## References

* [Stacks Project, Tag 01UM](https://stacks.math.columbia.edu/tag/01UM)
* [Stacks Project, Tag 04BL](https://stacks.math.columbia.edu/tag/04BL)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace
open Stacks.Sheaves.RingedSpaceDifferentials

attribute [local instance] Stacks.Smooth.moduleMulOpposite

universe u

namespace Stacks.Smooth

/-! ### The square-zero extension of the structure sheaf -/

section Sheaf

variable {X : Scheme.{u}} (M : X.Modules)

/-- The presheaf of commutative rings on `X` whose sections over an open `U` are the trivial
square-zero extension of `Γ(X, U)` by `Γ(M, U)`. -/
noncomputable def sqZeroPresheaf : (X.Opens)ᵒᵖ ⥤ CommRingCat.{u} where
  obj U := CommRingCat.of (TrivSqZeroExt Γ(X, U.unop) Γ(M, U.unop))
  map {_ _} h := CommRingCat.ofHom (sqZeroMap (X.presheaf.map h).hom
    (M.presheaf.map h).hom fun r m ↦ Scheme.Modules.map_smul M h.unop r m)
  map_id _ := CommRingCat.hom_ext (RingHom.ext fun x ↦ by
    refine TrivSqZeroExt.ext ?_ ?_ <;> simp)
  map_comp _ _ := CommRingCat.hom_ext (RingHom.ext fun x ↦ by
    refine TrivSqZeroExt.ext ?_ ?_ <;> simp)

/-- The first component of a restriction in `Stacks.Smooth.sqZeroPresheaf`. -/
@[simp]
theorem sqZeroPresheaf_map_fst {U U' : (X.Opens)ᵒᵖ} (h : U ⟶ U')
    (x : (sqZeroPresheaf M).obj U) :
    (((sqZeroPresheaf M).map h).hom x).fst = (X.presheaf.map h).hom x.fst :=
  sqZeroMap_fst _ _ (fun r m ↦ Scheme.Modules.map_smul M h.unop r m) x

/-- The second component of a restriction in `Stacks.Smooth.sqZeroPresheaf`. -/
@[simp]
theorem sqZeroPresheaf_map_snd {U U' : (X.Opens)ᵒᵖ} (h : U ⟶ U')
    (x : (sqZeroPresheaf M).obj U) :
    (((sqZeroPresheaf M).map h).hom x).snd = (M.presheaf.map h).hom x.snd :=
  sqZeroMap_snd _ _ (fun r m ↦ Scheme.Modules.map_smul M h.unop r m) x

/-- **The square-zero extension of the structure sheaf is a sheaf.** Sections of
`Stacks.Smooth.sqZeroPresheaf` are pairs of a section of `𝒪_X` and a section of `M`, and
restriction acts componentwise, so a compatible family glues componentwise and uniquely. -/
theorem sqZeroPresheaf_isSheaf : TopCat.Presheaf.IsSheaf (sqZeroPresheaf M) :=
  AlgebraicGeometry.SheafOfModules.sqZeroPresheaf_isSheaf X.sheaf M

/-- The square-zero extension of the structure sheaf of `X` by a sheaf of modules `M`, as a sheaf
of commutative rings on `X`. -/
noncomputable def sqZeroSheaf : TopCat.Sheaf CommRingCat.{u} X :=
  ⟨sqZeroPresheaf M, sqZeroPresheaf_isSheaf M⟩

end Sheaf

/-! ### From vanishing on the base to vanishing on the inverse image sheaf -/

section Bridge

variable {X S : Scheme.{u}} (f : X ⟶ S) (M : X.Modules)
  (d : (V₀ : X.Opens) → Γ(X, V₀) →+ Γ(M, V₀))
  (hmul : ∀ (V₀ : X.Opens) (x y : Γ(X, V₀)), d V₀ (x * y) = x • d V₀ y + y • d V₀ x)
  (hmap : ∀ {V₀ V₁ : (X.Opens)ᵒᵖ} (h : V₀ ⟶ V₁) (x : Γ(X, V₀.unop)),
    (M.presheaf.map h).hom (d V₀.unop x) = d V₁.unop ((X.presheaf.map h).hom x))

/-- The structure map `f⁻¹𝒪_S ⟶ 𝒪_X` of a morphism of schemes, on sections over an open of
`X`. -/
noncomputable def inverseImageStructureApp (V₀ : (X.Opens)ᵒᵖ) :
    (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀ ⟶ Γ(X, V₀.unop) :=
  (inverseImageStructureMap (ringedSpaceHom f)).hom.app V₀

/-- Naturality of the structure map `f⁻¹𝒪_S ⟶ 𝒪_X` on sections. -/
theorem inverseImageStructureApp_naturality {V₀ V₁ : (X.Opens)ᵒᵖ} (h : V₀ ⟶ V₁)
    (t : (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀) :
    (X.presheaf.map h).hom ((inverseImageStructureApp f V₀).hom t)
      = (inverseImageStructureApp f V₁).hom
        (((inverseImageSheaf (ringedSpaceHom f)).obj.map h).hom t) :=
  (congr($((inverseImageStructureMap (ringedSpaceHom f)).hom.naturality h).hom t)).symm

/-- The composite of the family with the structure map `f⁻¹𝒪_S ⟶ 𝒪_X`, as an additive map. -/
noncomputable def inverseImageD (V₀ : (X.Opens)ᵒᵖ) :
    (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀ →+ Γ(M, V₀.unop) :=
  (d V₀.unop).comp (inverseImageStructureApp f V₀).hom.toAddMonoidHom

include hmul in
/-- The Leibniz rule for `Stacks.Smooth.inverseImageD`, relative to the structure map. -/
theorem inverseImageD_mul (V₀ : (X.Opens)ᵒᵖ)
    (t t' : (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀) :
    inverseImageD f M d V₀ (t * t')
      = (inverseImageStructureApp f V₀).hom t • inverseImageD f M d V₀ t'
        + (inverseImageStructureApp f V₀).hom t' • inverseImageD f M d V₀ t := by
  change d V₀.unop ((inverseImageStructureApp f V₀).hom (t * t'))
      = _ • d V₀.unop ((inverseImageStructureApp f V₀).hom t')
        + _ • d V₀.unop ((inverseImageStructureApp f V₀).hom t)
  rw [map_mul]
  exact hmul _ _ _

/-- **A sectionwise derivation of `𝒪_X`, read as a ring homomorphism into the square-zero
extension.** On an open `V₀` of `X`, this is `t ↦ (σ t, d (σ t))` for `σ` the structure map
`f⁻¹𝒪_S ⟶ 𝒪_X`. -/
noncomputable def sqZeroInverseImageApp (V₀ : (X.Opens)ᵒᵖ) :
    (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀ ⟶ (sqZeroPresheaf M).obj V₀ :=
  CommRingCat.ofHom (sqZeroRingHom (inverseImageStructureApp f V₀).hom
    (inverseImageD f M d V₀) (inverseImageD_mul f M d hmul V₀))

/-- The first component of `Stacks.Smooth.sqZeroInverseImageApp` is the structure map. -/
theorem sqZeroInverseImageApp_fst (V₀ : (X.Opens)ᵒᵖ)
    (t : (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀) :
    ((sqZeroInverseImageApp f M d hmul V₀).hom t).fst
      = (inverseImageStructureApp f V₀).hom t :=
  sqZeroRingHom_fst _ _ (inverseImageD_mul f M d hmul V₀) t

/-- The second component of `Stacks.Smooth.sqZeroInverseImageApp` is the given family applied to
the image of the structure map. -/
theorem sqZeroInverseImageApp_snd (V₀ : (X.Opens)ᵒᵖ)
    (t : (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀) :
    ((sqZeroInverseImageApp f M d hmul V₀).hom t).snd
      = d V₀.unop ((inverseImageStructureApp f V₀).hom t) :=
  sqZeroRingHom_snd _ _ (inverseImageD_mul f M d hmul V₀) t

/-- **A sectionwise derivation of `𝒪_X`, read as a morphism of sheaves of rings into the
square-zero extension.** A compatible family of additive maps `Γ(X, V₀) → Γ(M, V₀)` satisfying
the Leibniz rule gives a morphism of sheaves of commutative rings from `f⁻¹𝒪_S` to the
square-zero extension of `𝒪_X` by `M`. -/
noncomputable def sqZeroInverseImageHom :
    inverseImageSheaf (ringedSpaceHom f) ⟶ sqZeroSheaf M :=
  ⟨{ app := sqZeroInverseImageApp f M d hmul
     naturality := fun V₀ V₁ h ↦ CommRingCat.hom_ext (RingHom.ext fun t ↦ by
      change (sqZeroInverseImageApp f M d hmul V₁).hom
            (((inverseImageSheaf (ringedSpaceHom f)).obj.map h).hom t)
          = ((sqZeroPresheaf M).map h).hom ((sqZeroInverseImageApp f M d hmul V₀).hom t)
      refine TrivSqZeroExt.ext ?_ ?_
      · rw [sqZeroPresheaf_map_fst, sqZeroInverseImageApp_fst, sqZeroInverseImageApp_fst,
          inverseImageStructureApp_naturality]
      · rw [sqZeroPresheaf_map_snd, sqZeroInverseImageApp_snd, sqZeroInverseImageApp_snd,
          hmap h]
        exact congrArg (d V₁.unop) (inverseImageStructureApp_naturality f h t).symm) }⟩

/-- The components of `Stacks.Smooth.sqZeroInverseImageHom`. -/
theorem sqZeroInverseImageHom_app (V₀ : (X.Opens)ᵒᵖ) :
    (sqZeroInverseImageHom f M d hmul hmap).hom.app V₀
      = sqZeroInverseImageApp f M d hmul V₀ :=
  rfl

/-- The structure map `f⁻¹𝒪_S ⟶ 𝒪_X` carries the canonical section of `f⁻¹𝒪_S` attached to a
section `r` of `𝒪_S` over `V'` to the image of `r` under `f.app V'`. -/
theorem inverseImageStructureApp_unit (V' : S.Opens) (r : Γ(S, V')) :
    (inverseImageStructureApp f (op (f ⁻¹ᵁ V'))).hom
        (((inverseImageUnit f).hom.app (op V')).hom r)
      = (f.app V').hom r := by
  have h0 : inverseImageSection f (f ⁻¹ᵁ V') le_rfl r
      = ((inverseImageUnit f).hom.app (op V')).hom r := by
    change ((inverseImageSheaf (ringedSpaceHom f)).obj.map
      (homOfLE (le_refl (f ⁻¹ᵁ V'))).op).hom _ = _
    rw [show homOfLE (le_refl (f ⁻¹ᵁ V')) = 𝟙 _ from rfl, op_id,
      CategoryTheory.Functor.map_id]
    rfl
  rw [← h0]
  exact (inverseImageStructureMap_inverseImageSection f (f ⁻¹ᵁ V') le_rfl r).trans
    (congr($(Scheme.Hom.app_eq_appLE f (U := V')) r)).symm

include hmul hmap in
/-- **From vanishing on the base to vanishing on the inverse image sheaf.** A compatible family
of additive maps `Γ(X, V₀) → Γ(M, V₀)` satisfying the Leibniz rule and killing the image of
`Γ(S, V')` in `Γ(X, f ⁻¹ᵁ V')` for every open `V'` of `S` kills the image of the structure map
`f⁻¹𝒪_S ⟶ 𝒪_X` over every open of `X`.

Both `t ↦ (σ t, d (σ t))` and `t ↦ (σ t, 0)` are morphisms of sheaves of commutative rings from
`f⁻¹𝒪_S` to the square-zero extension of `𝒪_X` by `M`, and by the adjunction `f⁻¹ ⊣ f_*` such a
morphism is determined by its composite with the unit `𝒪_S ⟶ f_*f⁻¹𝒪_S`, on which the two agree
by hypothesis. This is the step that Mathlib's `PresheafOfModules.Derivation` leaves open: it
turns a derivation relative to `f^♯ : 𝒪_S ⟶ f_*𝒪_X` into one relative to `f⁻¹𝒪_S ⟶ 𝒪_X`. -/
theorem apply_inverseImageStructureApp_eq_zero
    (hbase : ∀ (V' : S.Opens) (r : Γ(S, V')), d (f ⁻¹ᵁ V') ((f.app V').hom r) = 0)
    (V₀ : (X.Opens)ᵒᵖ) (t : (inverseImageSheaf (ringedSpaceHom f)).obj.obj V₀) :
    d V₀.unop ((inverseImageStructureApp f V₀).hom t) = 0 := by
  have hzmul : ∀ (V₁ : X.Opens) (x y : Γ(X, V₁)),
      (0 : Γ(X, V₁) →+ Γ(M, V₁)) (x * y)
        = x • (0 : Γ(X, V₁) →+ Γ(M, V₁)) y + y • (0 : Γ(X, V₁) →+ Γ(M, V₁)) x := by
    intro V₁ x y
    simp
  have hzmap : ∀ {V₁ V₂ : (X.Opens)ᵒᵖ} (h : V₁ ⟶ V₂) (x : Γ(X, V₁.unop)),
      (M.presheaf.map h).hom ((0 : Γ(X, V₁.unop) →+ Γ(M, V₁.unop)) x)
        = (0 : Γ(X, V₂.unop) →+ Γ(M, V₂.unop)) ((X.presheaf.map h).hom x) := by
    intro V₁ V₂ h x
    simp
  have hαβ : sqZeroInverseImageHom f M d hmul hmap
      = sqZeroInverseImageHom f M (fun _ ↦ 0) hzmul hzmap := by
    refine ((sheafAdjunction (ringedSpaceHom f)).homEquiv S.sheaf (sqZeroSheaf M)).injective ?_
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit]
    refine Sheaf.hom_ext_iff.mpr (NatTrans.ext (funext fun V' ↦ CommRingCat.hom_ext
      (RingHom.ext fun r ↦ ?_)))
    have hchange : ∀ α : inverseImageSheaf (ringedSpaceHom f) ⟶ sqZeroSheaf M,
        (((sheafAdjunction (ringedSpaceHom f)).unit.app S.sheaf ≫
            (TopCat.Sheaf.pushforward CommRingCat.{u} (ringedSpaceHom f).hom.base).map α).hom.app
              V').hom r
          = (α.hom.app (op (f ⁻¹ᵁ V'.unop))).hom (((inverseImageUnit f).hom.app V').hom r) :=
      fun _ ↦ rfl
    rw [hchange, hchange]
    refine TrivSqZeroExt.ext ?_ ?_
    · exact (sqZeroInverseImageApp_fst f M d hmul _ _).trans
        (sqZeroInverseImageApp_fst f M (fun _ ↦ 0) hzmul _ _).symm
    · refine (sqZeroInverseImageApp_snd f M d hmul _ _).trans
        (Eq.trans ?_ (sqZeroInverseImageApp_snd f M (fun _ ↦ 0) hzmul _ _).symm)
      rw [AddMonoidHom.zero_apply]
      exact (congrArg (d (f ⁻¹ᵁ V'.unop)) (inverseImageStructureApp_unit f V'.unop r)).trans
        (hbase V'.unop r)
  have e1 := sqZeroInverseImageApp_snd f M d hmul V₀ t
  have e2 := sqZeroInverseImageApp_snd f M (fun _ ↦ (0 : Γ(X, _) →+ Γ(M, _))) hzmul V₀ t
  rw [← e1, show sqZeroInverseImageApp f M d hmul V₀
      = (sqZeroInverseImageHom f M d hmul hmap).hom.app V₀ from rfl, hαβ]
  exact e2.trans (AddMonoidHom.zero_apply _)

end Bridge

end Stacks.Smooth

end
