module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Differentials.ChartBoxLocalSectionOperator

/-!
# The sections of a box product over a chart are generated by external tensor sections

Let `a : X ⟶ S` and `b : Y ⟶ S`, let `F` and `G` be quasi-coherent modules on `X` and on `Y`, and
let `c` be a chart of `X ×_S Y` with `R = Γ(S, W)`, `A = Γ(X, U)`, `B = Γ(Y, V)`. The sections of
`F` on `Spec A` are exactly the sections of `F` on `U`, so every global section of the inverse
image of `F` along the chart's first structure map comes from a section of `F` over `U`. Since the
sections of `F ⊠ G` over the chart are `Γ(Spec A, F) ⊗_R Γ(Spec B, G)`, which is additively
generated by pure tensors, the sections of `F ⊠ G` over the chart are additively generated by the
sections attached to a pair of sections of `F` over `U` and of `G` over `V`.

## Main results

* `Stacks.FibreProductAffineChart.Chart.preimage_fromSpecLeft_left`: the chart's first factor pulls
  back to everything along the chart's first structure map.
* `Stacks.FibreProductAffineChart.Chart.surjective_modulesPullbackUnitTop_left`: every global
  section of the inverse image of a module along the chart's first structure map comes from a
  section over the chart's first factor.
* `Stacks.FibreProductAffineChart.Chart.boxSectionOfTensor`: the section of `F ⊠ G` over the image
  of a chart attached to an element of `Γ(Spec A, F) ⊗_R Γ(Spec B, G)`, with
  `Stacks.FibreProductAffineChart.Chart.boxSectionOfTensor_surjective`,
  `Chart.boxSectionOfTensor_zero`, `Chart.boxSectionOfTensor_add` and
  `Chart.boxSectionOfTensor_tmul`.
* `Stacks.FibreProductAffineChart.Chart.ext_of_externalTensorSection`: **two additive maps out of
  the sections of `F ⊠ G` over a chart which agree on the external tensor sections of pairs of
  sections over the chart's two factors are equal.**

## References

* [Stacks Project, Tag 0G45](https://stacks.math.columbia.edu/tag/0G45)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct TopologicalSpace
open CommRingCat
open Stacks.Tag01VSPullbackTensor

universe u

namespace Stacks.Tag01VSPullbackTensor

open _root_.AlgebraicGeometry

/-- Restriction of a section of a sheaf of modules along an endomorphism of an open is the
identity. -/
theorem presheaf_map_self {X : Scheme.{u}} (M : X.Modules) {U : X.Opens} (i : U ⟶ U)
    (y : Γ(M, U)) : M.presheaf.map i.op y = y := by
  rw [show i = CategoryTheory.CategoryStruct.id U from Subsingleton.elim _ _,
    CategoryTheory.op_id, CategoryTheory.Functor.map_id]
  rfl

/-- Two restrictions of a section of a sheaf of modules between two equal opens compose to the
identity. -/
theorem presheaf_map_map_self {X : Scheme.{u}} (M : X.Modules) {U V : X.Opens} (i : V ⟶ U)
    (i' : U ⟶ V) (y : Γ(M, U)) : M.presheaf.map i'.op (M.presheaf.map i.op y) = y :=
  (presheaf_map_map M i i' (CategoryTheory.CategoryStruct.id U) y).trans
    (presheaf_map_self M _ y)

end Stacks.Tag01VSPullbackTensor

attribute [local instance] Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback

namespace Stacks.FibreProductAffineChart

open _root_.AlgebraicGeometry RingHomClass

attribute [local instance] Algebra.TensorProduct.rightAlgebra

namespace Chart

variable {X Y S : Scheme.{u}} {a : X ⟶ S} {b : Y ⟶ S} (c : Chart a b)

/-! ### The sections over a factor of a chart -/

/-- The first factor of a chart pulls back to everything along the chart's first structure map. -/
theorem preimage_fromSpecLeft_left : c.fromSpecLeft ⁻¹ᵁ c.left = ⊤ :=
  c.isAffineOpen_left.fromSpec_preimage_self

/-- The second factor of a chart pulls back to everything along the chart's second structure
map. -/
theorem preimage_fromSpecRight_right : c.fromSpecRight ⁻¹ᵁ c.right = ⊤ :=
  c.isAffineOpen_right.fromSpec_preimage_self

/-- The image of the first factor of a chart is that factor. -/
theorem image_fromSpecLeft_top :
    c.fromSpecLeft ''ᵁ (⊤ : (Spec Γ(X, c.left)).Opens) = c.left :=
  have : IsOpenImmersion c.fromSpecLeft := c.isAffineOpen_left.isOpenImmersion_fromSpec
  (Scheme.Hom.image_top_eq_opensRange c.fromSpecLeft).trans
    c.isAffineOpen_left.opensRange_fromSpec

/-- The image of the second factor of a chart is that factor. -/
theorem image_fromSpecRight_top :
    c.fromSpecRight ''ᵁ (⊤ : (Spec Γ(Y, c.right)).Opens) = c.right :=
  have : IsOpenImmersion c.fromSpecRight := c.isAffineOpen_right.isOpenImmersion_fromSpec
  (Scheme.Hom.image_top_eq_opensRange c.fromSpecRight).trans
    c.isAffineOpen_right.opensRange_fromSpec

/-- Every global section of the inverse image of a module along an open immersion whose image is
`U` comes from a section over `U`. -/
private theorem surjective_modulesPullbackUnitTop_of_image_top {Z W : Scheme.{u}} (j : Z ⟶ W)
    [IsOpenImmersion j] (M : W.Modules) (U : W.Opens) (hU : j ⁻¹ᵁ U = ⊤)
    (himg : j ''ᵁ (⊤ : Z.Opens) = U) : Function.Surjective (modulesPullbackUnitTop j M U hU) :=
  fun x ↦
    ⟨M.presheaf.map (homOfLE himg.ge).op
        (Scheme.Modules.Hom.app ((Scheme.Modules.restrictFunctorIsoPullback j).app M).inv ⊤ x),
      (modulesPullbackUnitTop_restrictFunctorIsoPullback j M U hU _ himg.le).trans
        ((congrArg (fun z ↦ Scheme.Modules.Hom.app
            ((Scheme.Modules.restrictFunctorIsoPullback j).app M).hom ⊤ z)
            (presheaf_map_map_self M (homOfLE himg.ge) (homOfLE himg.le) _)).trans
          (congrArg (fun φ : (Scheme.Modules.pullback j).obj M ⟶ (Scheme.Modules.pullback j).obj M ↦
              Scheme.Modules.Hom.app φ ⊤ x)
            ((Scheme.Modules.restrictFunctorIsoPullback j).app M).inv_hom_id))⟩

/-- **Every global section of the inverse image of a module along the chart's first structure map
comes from a section over the chart's first factor.** -/
theorem surjective_modulesPullbackUnitTop_left (F : X.Modules) :
    Function.Surjective
      (modulesPullbackUnitTop c.fromSpecLeft F c.left c.preimage_fromSpecLeft_left) :=
  have : IsOpenImmersion c.fromSpecLeft := c.isAffineOpen_left.isOpenImmersion_fromSpec
  surjective_modulesPullbackUnitTop_of_image_top _ F _ _ c.image_fromSpecLeft_top

/-- **Every global section of the inverse image of a module along the chart's second structure map
comes from a section over the chart's second factor.** -/
theorem surjective_modulesPullbackUnitTop_right (G : Y.Modules) :
    Function.Surjective
      (modulesPullbackUnitTop c.fromSpecRight G c.right c.preimage_fromSpecRight_right) :=
  have : IsOpenImmersion c.fromSpecRight := c.isAffineOpen_right.isOpenImmersion_fromSpec
  surjective_modulesPullbackUnitTop_of_image_top _ G _ _ c.image_fromSpecRight_top

/-! ### Generation of the sections of a box product over a chart -/

attribute [local instance] leftModuleAlg leftModuleBase leftTower
attribute [local instance] rightModuleAlg rightModuleBase rightTower
attribute [local instance] Stacks.TensorProductPushout.rightModule
  Stacks.TensorProductPushout.rightModule_isScalarTower
  Stacks.TensorProductPushout.smulCommClass_right
  Stacks.TensorProductPushout.pushoutModule
  Stacks.TensorProductPushout.pushoutModule_isScalarTower
attribute [local instance] boxModuleAlg boxModuleBase boxTower

variable [Algebra Γ(S, c.base) Γ(X, c.left)] [Algebra Γ(S, c.base) Γ(Y, c.right)]
  (hl : ofHom (algebraMap Γ(S, c.base) Γ(X, c.left)) = c.leftHom)
  (hr : ofHom (algebraMap Γ(S, c.base) Γ(Y, c.right)) = c.rightHom)
  (F : X.Modules) (G : Y.Modules) [F.IsQuasicoherent] [G.IsQuasicoherent]

/-- The section of `F ⊠ G` over the image of a chart attached to an element of
`Γ(Spec A, F) ⊗_R Γ(Spec B, G)`: the inverse of the chart identification, read across the
comparison of the restriction along the chart with the inverse image along it. -/
noncomputable def boxSectionOfTensor
    (z : Γ((Scheme.Modules.pullback c.fromSpecLeft).obj F, ⊤) ⊗[Γ(S, c.base)]
      Γ((Scheme.Modules.pullback c.fromSpecRight).obj G, ⊤)) :
    Γ(externalTensorProduct a b F G, ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤) :=
  Scheme.Modules.Hom.app
    ((Scheme.Modules.restrictFunctorIsoPullback
      ((c.specIso hl hr).inv ≫ c.ι)).app (externalTensorProduct a b F G)).inv ⊤
    ((c.boxSectionsEquiv hl hr F G).symm z)

/-- `Stacks.FibreProductAffineChart.Chart.boxSectionOfTensor` carries `0` to `0`. -/
theorem boxSectionOfTensor_zero : c.boxSectionOfTensor hl hr F G 0 = 0 :=
  (congrArg
    (fun y ↦ Scheme.Modules.Hom.app
      ((Scheme.Modules.restrictFunctorIsoPullback
        ((c.specIso hl hr).inv ≫ c.ι)).app (externalTensorProduct a b F G)).inv ⊤ y)
    (map_zero (c.boxSectionsEquiv hl hr F G).symm)).trans (map_zero _)

/-- `Stacks.FibreProductAffineChart.Chart.boxSectionOfTensor` is additive. -/
theorem boxSectionOfTensor_add
    (z₁ z₂ : Γ((Scheme.Modules.pullback c.fromSpecLeft).obj F, ⊤) ⊗[Γ(S, c.base)]
      Γ((Scheme.Modules.pullback c.fromSpecRight).obj G, ⊤)) :
    c.boxSectionOfTensor hl hr F G (z₁ + z₂) =
      c.boxSectionOfTensor hl hr F G z₁ + c.boxSectionOfTensor hl hr F G z₂ :=
  (congrArg
    (fun y ↦ Scheme.Modules.Hom.app
      ((Scheme.Modules.restrictFunctorIsoPullback
        ((c.specIso hl hr).inv ≫ c.ι)).app (externalTensorProduct a b F G)).inv ⊤ y)
    (map_add (c.boxSectionsEquiv hl hr F G).symm z₁ z₂)).trans (map_add _ _ _)

/-- `Stacks.FibreProductAffineChart.Chart.boxSectionOfTensor` carries the pure tensor of the
sections attached to `s` and `t` to the external tensor section of `s` and `t`. -/
theorem boxSectionOfTensor_tmul
    (h₁ : ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ (⊤ : (Spec (.of (Γ(X, c.left) ⊗[Γ(S, c.base)]
        Γ(Y, c.right)))).Opens) ≤ pullback.fst a b ⁻¹ᵁ c.left)
    (h₂ : ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ (⊤ : (Spec (.of (Γ(X, c.left) ⊗[Γ(S, c.base)]
        Γ(Y, c.right)))).Opens) ≤ pullback.snd a b ⁻¹ᵁ c.right)
    (s : Γ(F, c.left)) (t : Γ(G, c.right)) :
    c.boxSectionOfTensor hl hr F G
        (modulesPullbackUnitTop c.fromSpecLeft F c.left c.preimage_fromSpecLeft_left s
          ⊗ₜ[Γ(S, c.base)]
          modulesPullbackUnitTop c.fromSpecRight G c.right c.preimage_fromSpecRight_right t) =
      externalTensorSection a b F G s t (((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤) h₁ h₂ :=
  (congrArg
    (fun y ↦ Scheme.Modules.Hom.app
      ((Scheme.Modules.restrictFunctorIsoPullback
        ((c.specIso hl hr).inv ≫ c.ι)).app (externalTensorProduct a b F G)).inv ⊤ y)
    ((c.boxSectionsEquiv hl hr F G).symm_apply_eq.2
      (c.boxSectionsEquiv_boxSectionLocal hl hr F G c.left c.right
        c.preimage_fromSpecLeft_left c.preimage_fromSpecRight_right s t).symm)).trans
    (c.restrictFunctorIsoPullback_inv_boxSectionLocal hl hr F G c.left c.right
      c.preimage_fromSpecLeft_left c.preimage_fromSpecRight_right s t h₁ h₂)

/-- **Every section of `F ⊠ G` over the image of a chart comes from
`Γ(Spec A, F) ⊗_R Γ(Spec B, G)`.** -/
theorem boxSectionOfTensor_surjective :
    Function.Surjective (c.boxSectionOfTensor hl hr F G) := fun w ↦
  ⟨c.boxSectionsEquiv hl hr F G
      (Scheme.Modules.Hom.app
        ((Scheme.Modules.restrictFunctorIsoPullback
          ((c.specIso hl hr).inv ≫ c.ι)).app (externalTensorProduct a b F G)).hom ⊤ w),
    (congrArg
      (fun y ↦ Scheme.Modules.Hom.app
        ((Scheme.Modules.restrictFunctorIsoPullback
          ((c.specIso hl hr).inv ≫ c.ι)).app (externalTensorProduct a b F G)).inv ⊤ y)
      ((c.boxSectionsEquiv hl hr F G).symm_apply_apply _)).trans
      (c.restrictFunctorIsoPullback_app_inv_hom hl hr (externalTensorProduct a b F G) w)⟩

section Ext

variable {A : Type*} [AddCommGroup A]
  (h₁ : ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ (⊤ : (Spec (.of (Γ(X, c.left) ⊗[Γ(S, c.base)]
      Γ(Y, c.right)))).Opens) ≤ pullback.fst a b ⁻¹ᵁ c.left)
  (h₂ : ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ (⊤ : (Spec (.of (Γ(X, c.left) ⊗[Γ(S, c.base)]
      Γ(Y, c.right)))).Opens) ≤ pullback.snd a b ⁻¹ᵁ c.right)
  (φ ψ : Γ(externalTensorProduct a b F G, ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤) →+ A)
  (h : ∀ (s : Γ(F, c.left)) (t : Γ(G, c.right)),
    φ (externalTensorSection a b F G s t (((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤) h₁ h₂) =
      ψ (externalTensorSection a b F G s t (((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤) h₁ h₂))

include h in
/-- Two additive maps out of the sections of `F ⊠ G` over a chart which agree on the external
tensor sections agree on every pure tensor of `Γ(Spec A, F) ⊗_R Γ(Spec B, G)`. -/
theorem apply_boxSectionOfTensor_tmul_eq
    (ms : Γ((Scheme.Modules.pullback c.fromSpecLeft).obj F, ⊤))
    (mt : Γ((Scheme.Modules.pullback c.fromSpecRight).obj G, ⊤)) :
    φ (c.boxSectionOfTensor hl hr F G (ms ⊗ₜ[Γ(S, c.base)] mt)) =
      ψ (c.boxSectionOfTensor hl hr F G (ms ⊗ₜ[Γ(S, c.base)] mt)) := by
  obtain ⟨s, hs⟩ := c.surjective_modulesPullbackUnitTop_left F ms
  obtain ⟨t, ht⟩ := c.surjective_modulesPullbackUnitTop_right G mt
  have e0 : c.boxSectionOfTensor hl hr F G (ms ⊗ₜ[Γ(S, c.base)] mt) =
      externalTensorSection a b F G s t (((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤) h₁ h₂ :=
    (congrArg (c.boxSectionOfTensor hl hr F G)
      (congrArg₂ (fun u v ↦ u ⊗ₜ[Γ(S, c.base)] v) hs.symm ht.symm)).trans
      (c.boxSectionOfTensor_tmul hl hr F G h₁ h₂ s t)
  exact (congrArg φ e0).trans ((h s t).trans (congrArg ψ e0).symm)

include h in
/-- Two additive maps out of the sections of `F ⊠ G` over a chart which agree on the external
tensor sections agree on every section coming from `Γ(Spec A, F) ⊗_R Γ(Spec B, G)`. -/
theorem apply_boxSectionOfTensor_eq
    (z : Γ((Scheme.Modules.pullback c.fromSpecLeft).obj F, ⊤) ⊗[Γ(S, c.base)]
      Γ((Scheme.Modules.pullback c.fromSpecRight).obj G, ⊤)) :
    φ (c.boxSectionOfTensor hl hr F G z) = ψ (c.boxSectionOfTensor hl hr F G z) := by
  induction z using TensorProduct.inductionOn with
  | tmul ms mt => exact c.apply_boxSectionOfTensor_tmul_eq hl hr F G h₁ h₂ φ ψ h ms mt
  | add z₁ z₂ ih₁ ih₂ =>
    have e := c.boxSectionOfTensor_add hl hr F G z₁ z₂
    exact (congrArg φ e).trans ((map_add φ _ _).trans
      ((congrArg₂ (fun u v ↦ u + v) ih₁ ih₂).trans
        ((map_add ψ _ _).symm.trans (congrArg ψ e).symm)))

include h in
/-- **Two additive maps out of the sections of `F ⊠ G` over a chart which agree on the sections
attached to a pair of sections of `F` and of `G` over the chart's two factors are equal.** -/
theorem ext_of_externalTensorSection
    (w : Γ(externalTensorProduct a b F G, ((c.specIso hl hr).inv ≫ c.ι) ''ᵁ ⊤)) :
    φ w = ψ w := by
  obtain ⟨z, rfl⟩ := c.boxSectionOfTensor_surjective hl hr F G w
  exact c.apply_boxSectionOfTensor_eq hl hr F G h₁ h₂ φ ψ h z

end Ext

end Chart

end Stacks.FibreProductAffineChart

end
