module

public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiSeparated
public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.Topology.Constructible
public import StacksFrontier.AlgebraicGeometry.RetrocompactOneDimensional.LocalAlgebra
import StacksCore.Tactic.StacksAttribute

/-!
# A retrocompact open of a one-dimensional scheme is an affine morphism

Let `X` be a scheme all of whose local rings are Noetherian of Krull dimension at most one, and
let `U ⊆ X` be a retrocompact open subscheme. Then `U.ι : U ⟶ X` is an affine morphism.

## Main results

* `Stacks.RetrocompactOneDimensional.basicOpen_le_iSup_of_mem_span`: a section in the ideal
  generated by a family of sections has its non-vanishing locus inside the union of theirs.
* `Stacks.RetrocompactOneDimensional.basicOpen_le_basicOpen_of_pow_eq_mul`: if `h ^ n = a * c`
  then `X_h ≤ X_a`.
* `Stacks.RetrocompactOneDimensional.isAffineHom_ι_of_isRetrocompact`: the inclusion of a
  retrocompact open is an affine morphism.
* `Stacks.RetrocompactOneDimensional.isAffineOpen_of_isCompact`: a quasi-compact open of an affine
  scheme whose local rings are Noetherian of dimension at most one is affine.
-/

@[expose] public section

open CategoryTheory TopologicalSpace AlgebraicGeometry

universe u

namespace Stacks.RetrocompactOneDimensional

variable {X : Scheme.{u}}

/-- If a section `a` of `𝒪_X` over `V` lies in the ideal generated by `s ⊆ Γ(X, V)`, then
`X_a ≤ ⨆ b ∈ s, X_b`. -/
theorem basicOpen_le_iSup_of_mem_span {V : X.Opens} (s : Set Γ(X, V)) {a : Γ(X, V)}
    (ha : a ∈ Ideal.span s) : X.basicOpen a ≤ ⨆ b ∈ s, X.basicOpen b := by
  intro y hy
  have hyV : y ∈ V := X.basicOpen_le a hy
  rw [Scheme.mem_basicOpen X a y hyV] at hy
  by_contra hcon
  have hle : Ideal.span s ≤ Ideal.comap (X.presheaf.germ V y hyV).hom
      (IsLocalRing.maximalIdeal (X.presheaf.stalk y)) := by
    rw [Ideal.span_le]
    intro b hb
    simp only [SetLike.mem_coe, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hbu
    exact hcon (Opens.mem_iSup.2 ⟨b, Opens.mem_iSup.2
      ⟨hb, (Scheme.mem_basicOpen X b y hyV).2 hbu⟩⟩)
  have hmem := hle ha
  simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmem
  exact hmem hy

/-- If `h ^ n = a * c` in `Γ(X, V)` then `X_h ≤ X_a`. -/
theorem basicOpen_le_basicOpen_of_pow_eq_mul {V : X.Opens} {h a c : Γ(X, V)} {n : ℕ}
    (hn : h ^ n = a * c) : X.basicOpen h ≤ X.basicOpen a := by
  intro y hy
  have hyV : y ∈ V := X.basicOpen_le h hy
  rw [Scheme.mem_basicOpen X h y hyV] at hy
  rw [Scheme.mem_basicOpen X a y hyV]
  have hpow := hy.pow n
  rw [← map_pow, hn, map_mul] at hpow
  exact isUnit_of_mul_isUnit_left hpow

/-- **The inclusion of a retrocompact open of a scheme whose local rings are Noetherian of
dimension at most one is an affine morphism.** -/
theorem isAffineHom_ι_of_isRetrocompact (X : Scheme.{u}) (U : X.Opens)
    (hU : IsRetrocompact (U : Set X))
    (hnoeth : ∀ x : X, IsNoetherianRing (X.presheaf.stalk x))
    (hdim : ∀ x : X, Ring.KrullDimLE 1 (X.presheaf.stalk x)) :
    IsAffineHom U.ι := by
  classical
  refine isAffineHom_of_forall_exists_isAffineOpen _ fun x => ?_
  obtain ⟨V, hV, hxV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := x) (Opens.mem_top x)
  have hcpt : IsCompact ((U : Set X) ∩ (V : Set X)) := hU hV.isCompact V.2
  have hcover : ((U : Set X) ∩ (V : Set X)) ⊆
      ⋃ a : {a : Γ(X, V) // X.basicOpen a ≤ U}, (X.basicOpen a.1 : Set X) := by
    rintro y ⟨hyU, hyV⟩
    obtain ⟨a, ha₁, ha₂⟩ := hV.exists_basicOpen_le (⟨y, hyU⟩ : U) hyV
    exact Set.mem_iUnion.2 ⟨⟨a, ha₁⟩, ha₂⟩
  obtain ⟨t, ht⟩ := hcpt.elim_finite_subcover
    (fun a : {a : Γ(X, V) // X.basicOpen a ≤ U} => (X.basicOpen a.1 : Set X))
    (fun a => (X.basicOpen a.1).2) hcover
  have : IsNoetherianRing (X.presheaf.stalk x) := hnoeth x
  have : Ring.KrullDimLE 1 (X.presheaf.stalk x) := hdim x
  let : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxV⟩ : V)
  have hlocal : IsLocalization.AtPrime (X.presheaf.stalk x)
      (hV.primeIdealOf (⟨x, hxV⟩ : V)).asIdeal := hV.isLocalization_stalk ⟨x, hxV⟩
  obtain ⟨f, hfmem, hf⟩ := exists_mem_isPrime_mem_iff_le
    (Ideal.map (algebraMap Γ(X, V) (X.presheaf.stalk x))
      (Ideal.span ((fun a : {a : Γ(X, V) // X.basicOpen a ≤ U} => a.1) '' (t : Set _))))
  obtain ⟨⟨⟨a₀, ha₀⟩, s₀⟩, hs₀⟩ := (IsLocalization.mem_map_algebraMap_iff
    (hV.primeIdealOf (⟨x, hxV⟩ : V)).asIdeal.primeCompl (X.presheaf.stalk x)).mp hfmem
  have ha₀le : X.basicOpen a₀ ≤ U :=
    (basicOpen_le_iSup_of_mem_span _ ha₀).trans (iSup₂_le <| by rintro _ ⟨a, -, rfl⟩; exact a.2)
  have hrad : Ideal.map (algebraMap Γ(X, V) (X.presheaf.stalk x))
        (Ideal.span ((fun a : {a : Γ(X, V) // X.basicOpen a ≤ U} => a.1) '' (t : Set _))) ≤
      (Ideal.span {algebraMap Γ(X, V) (X.presheaf.stalk x) a₀}).radical := by
    rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro p ⟨hp₁, hp₂⟩
    refine (hf p hp₂).1 ?_
    have hmem : f * algebraMap Γ(X, V) (X.presheaf.stalk x) (s₀ : Γ(X, V)) ∈ p := by
      rw [hs₀]
      exact hp₁ (Ideal.mem_span_singleton_self _)
    exact (hp₂.mem_or_mem hmem).resolve_right fun h =>
      hp₂.ne_top (p.eq_top_of_isUnit_mem h (IsLocalization.map_units _ s₀))
  have key : ∀ a : {a : Γ(X, V) // X.basicOpen a ≤ U}, ∃ (n : ℕ) (w c : Γ(X, V)),
      w ∈ (hV.primeIdealOf (⟨x, hxV⟩ : V)).asIdeal.primeCompl ∧
        (a ∈ t → a.1 ^ (n + 1) * w = a₀ * c) := by
    intro a
    by_cases ha : a ∈ t
    · have hmem : algebraMap Γ(X, V) (X.presheaf.stalk x) a.1 ∈
          Ideal.map (algebraMap Γ(X, V) (X.presheaf.stalk x))
            (Ideal.span ((fun b : {b : Γ(X, V) // X.basicOpen b ≤ U} => b.1) '' (t : Set _))) :=
        Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨a, ha, rfl⟩)
      obtain ⟨n, hn⟩ := hrad hmem
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hn
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj
        (M := (hV.primeIdealOf (⟨x, hxV⟩ : V)).asIdeal.primeCompl) d
      have hdown : algebraMap Γ(X, V) (X.presheaf.stalk x) (a.1 ^ n * (s : Γ(X, V))) =
          algebraMap Γ(X, V) (X.presheaf.stalk x) (b * a₀) := by
        rw [map_mul, map_mul, map_pow, ← hd, ← hbs]
        ring
      obtain ⟨u, hu⟩ := (IsLocalization.eq_iff_exists
        (hV.primeIdealOf (⟨x, hxV⟩ : V)).asIdeal.primeCompl (X.presheaf.stalk x)).mp hdown
      exact ⟨n, (u : Γ(X, V)) * (s : Γ(X, V)), a.1 * ((u : Γ(X, V)) * b),
        Submonoid.mul_mem _ u.2 s.2, fun _ => by linear_combination a.1 * hu⟩
    · exact ⟨0, 1, 0, Submonoid.one_mem _, fun h => absurd h ha⟩
  choose n w c hw heq using key
  have hgmem : (∏ a ∈ t, w a) ∈ (hV.primeIdealOf (⟨x, hxV⟩ : V)).asIdeal.primeCompl :=
    Submonoid.prod_mem _ fun a _ => hw a
  have hxg : x ∈ X.basicOpen (∏ a ∈ t, w a) := by
    rw [Scheme.mem_basicOpen X _ x hxV]
    exact (IsLocalization.map_units _ ⟨_, hgmem⟩ :
      IsUnit (algebraMap Γ(X, V) (X.presheaf.stalk x) (∏ a ∈ t, w a)))
  have hbound : ∀ a ∈ t, X.basicOpen (a.1 * ∏ b ∈ t, w b) ≤ X.basicOpen a₀ := by
    intro a ha
    obtain ⟨Q, hQ⟩ : ∃ Q, (∏ b ∈ t, w b) = w a * Q :=
      ⟨∏ b ∈ t.erase a, w b, (Finset.mul_prod_erase t w ha).symm⟩
    rw [hQ]
    exact basicOpen_le_basicOpen_of_pow_eq_mul (n := n a + 1) (c := c a * Q * (w a * Q) ^ n a)
      (by linear_combination Q * (w a * Q) ^ n a * heq a ha)
  refine ⟨X.basicOpen (∏ a ∈ t, w a), hxg, hV.basicOpen _, ?_⟩
  rw [← U.ι.isAffineOpen_iff_of_isOpenImmersion, Scheme.Hom.image_preimage_eq_opensRange_inf,
    Scheme.Opens.opensRange_ι]
  have hEq : U ⊓ X.basicOpen (∏ a ∈ t, w a) = X.basicOpen (a₀ * ∏ a ∈ t, w a) := by
    rw [Scheme.basicOpen_mul]
    refine le_antisymm ?_ (inf_le_inf_right _ ha₀le)
    rintro y ⟨hyU, hyg⟩
    obtain ⟨a, ha, hya⟩ := Set.mem_iUnion₂.mp (ht ⟨hyU, X.basicOpen_le _ hyg⟩)
    exact ⟨hbound a ha (by rw [Scheme.basicOpen_mul]; exact ⟨hya, hyg⟩), hyg⟩
  exact hEq ▸ hV.basicOpen _

/-- A quasi-compact open subset of an affine scheme is affine when every local ring is Noetherian
and has Krull dimension at most one. -/
@[stacks 09N9]
theorem isAffineOpen_of_isCompact (X : Scheme.{u}) [IsAffine X]
    (h_noetherian : ∀ x : X, IsNoetherianRing (X.presheaf.stalk x))
    (h_dim : ∀ x : X, Ring.KrullDimLE 1 (X.presheaf.stalk x))
    (U : X.Opens) (hU : IsCompact (U : Set X)) : IsAffineOpen U := by
  have hretro : IsRetrocompact (U : Set X) := fun _ hK hKopen =>
    QuasiSeparatedSpace.inter_isCompact (U : Set X) _ U.2 hU hKopen hK
  have := isAffineHom_ι_of_isRetrocompact X U hretro h_noetherian h_dim
  exact isAffine_of_isAffineHom U.ι

end Stacks.RetrocompactOneDimensional

end
