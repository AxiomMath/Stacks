/-!
# Local dimension along a smooth relative curve

This file collects the local dimension theory used to recognize the relative effective Cartier
divisors on a smooth relative curve. The two computations that drive everything are: the
pointwise fibre dimension of a morphism smooth of relative dimension `n` is `n`, read off a
standard smooth chart through `fiberDimensionAt_eq_card_sub_card`; and at a closed point of a
scheme of finite type over a field the topological Krull dimension agrees with the Krull
dimension of the stalk, because the residue field there is algebraic over the base field and so
contributes no transcendence degree. Combining them, a scheme smooth of relative dimension one
over a field has Krull dimension one at every point, and the stalk at a closed point of such a
scheme is a one-dimensional regular local ring, hence a discrete valuation ring. Every nonzero
ideal of such a ring is generated by a single regular element, which is the local principality
that an effective Cartier divisor requires.

## Main results

* `AlgebraicGeometry.fiberDimensionAt_eq_of_smoothOfRelativeDimension` — the pointwise fibre
  dimension of a morphism smooth of relative dimension `n` equals `n`.
* `AlgebraicGeometry.localKrullDim_fiber_eq_of_smoothOfRelativeDimension` and
  `AlgebraicGeometry.topologicalKrullDim_fiber_le_of_smoothOfRelativeDimension` — every fibre has
  dimension `n` at each of its points, hence dimension at most `n`.
* `AlgebraicGeometry.fiberDimension_eq_of_smoothOfRelativeDimension` — the same statement for the
  dimension of a whole nonempty fibre.
* `AlgebraicGeometry.topologicalKrullDimAt_eq_ringKrullDim_stalk_of_closed_point` — at a closed
  point of a scheme locally of finite type over a field, topological Krull dimension agrees with
  the Krull dimension of the stalk.
* `AlgebraicGeometry.topologicalKrullDimAt_eq_one_of_smoothOfRelativeDimension_one` — a scheme
  smooth of relative dimension one over a field has Krull dimension one at every point.
* `IsRegularLocalRing.exists_isRegular_and_span_singleton_eq` — in a one-dimensional regular
  local ring every nonzero ideal is generated by a regular element.
* `AlgebraicGeometry.IsRegular.isRegularLocalRing_stalk` — the stalks of a regular scheme are
  regular local rings.
* `locallyQuasiFinite_flat_locallyOfFinitePresentation_iff_of_isLocallyNoetherian` — over a
  locally Noetherian base, local finite presentation is automatic for a locally quasi-finite
  morphism locally of finite type.

## Implementation notes

The dimension at a point is `topologicalKrullDimAt`, valued in `WithBot ℕ∞`, and the dimension
of the fibre of `f` at `x` is `topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x)`. Transporting
such a dimension from a standard smooth chart to the scheme itself is done by
`fiberDimensionAt_eq_of_open_square`, which moves the fibre dimension across a commutative
square of open immersions.

## References

* [Stacks Project, Tag 0B9D](https://stacks.math.columbia.edu/tag/0B9D)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u


namespace IsRegularLocalRing

/-- In a regular local ring of Krull dimension one every nonzero ideal is generated by a single
regular element. Such a ring is a discrete valuation ring, since its cotangent space is
one-dimensional over the residue field, hence a principal ideal domain; a generator of a nonzero
ideal is then a nonzero element of a domain, so a regular element. -/
@[ega "0 17.1.4" "partial"]
theorem exists_isRegular_and_span_singleton_eq
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    (hdim : ringKrullDim R = 1) (J : Ideal R) (hJ : J ≠ ⊥) :
    ∃ a : R, IsRegular a ∧ J = Ideal.span {a} := by
  have : IsDomain R := IsRegularLocalRing.isDomain R
  have hcot : Module.finrank (IsLocalRing.ResidueField R)
      (IsLocalRing.CotangentSpace R) = 1 := by
    have hreg := (IsRegularLocalRing.iff_finrank_cotangentSpace R).mp
      (inferInstance : IsRegularLocalRing R)
    rw [hdim] at hreg
    exact_mod_cast hreg
  have : IsDiscreteValuationRing R :=
    (IsLocalRing.finrank_CotangentSpace_eq_one_iff).mp hcot
  obtain ⟨a, ha⟩ := (IsPrincipalIdealRing.principal J).1
  have ha0 : a ≠ 0 := by
    intro hz
    apply hJ
    rw [ha, hz]
    simp
  exact ⟨a, ⟨mul_right_injective₀ ha0, mul_left_injective₀ ha0⟩, ha⟩


end IsRegularLocalRing

namespace AlgebraicGeometry

/-- **Stacks Project, Tag 0B9D.** For a morphism smooth of relative dimension `n`, the dimension
of the fibre through any point of the source is `n` at that point. A standard smooth chart
through the point presents the morphism as a relative global complete intersection, whose fibre
dimension is the number of variables minus the number of relations; that is `n` by the chart, and
the chart computes the dimension on the scheme itself because the chart maps are open
immersions. -/
@[sga "3 VIB 4.4" "special case"]
theorem fiberDimensionAt_eq_of_smoothOfRelativeDimension
    {X S : Scheme.{u}} (f : X ⟶ S) (n : ℕ)
    [SmoothOfRelativeDimension n f] (x : X) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) = (n : WithBot ℕ∞) := by
  classical
  obtain ⟨U, hU, V, hV, hxV, hVU, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := f) x
  let A := ToType Γ(S, U)
  let B := ToType Γ(X, V)
  let : Algebra A B := (f.appLE U V hVU).hom.toAlgebra
  let hs : Algebra.IsStandardSmoothOfRelativeDimension n A B := hstd.toAlgebra
  obtain ⟨ι, σ, _, _, P, hPn⟩ := hs.out
  let : Fintype ι := Fintype.ofFinite ι
  let : Fintype σ := Fintype.ofFinite σ
  let g : Spec (.of B) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (f.appLE U V hVU).hom)
  let j : Spec (.of B) ⟶ X := hV.fromSpec
  let i : Spec (.of A) ⟶ S := hU.fromSpec
  have : IsOpenImmersion j := hV.isOpenImmersion_fromSpec
  have : IsOpenImmersion i := hU.isOpenImmersion_fromSpec
  have hcomp : j ≫ f = g ≫ i := (IsAffineOpen.SpecMap_appLE_fromSpec f hU hV hVU).symm
  let q : Spec (.of B) := hV.primeIdealOf ⟨x, hxV⟩
  have hq : j q = x := hV.fromSpec_primeIdealOf ⟨x, hxV⟩
  let : P.toPresentation.IsRelativeGlobalCompleteIntersection :=
    P.isRelativeGlobalCompleteIntersection
  have hdimChart := fiberDimensionAt_eq_card_sub_card P.toPresentation q
  calc
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) =
        topologicalKrullDimAt (f.fiber (f (j q))) (f.asFiber (j q)) := by rw [hq]
    _ = topologicalKrullDimAt (g.fiber (g q)) (g.asFiber q) :=
      (fiberDimensionAt_eq_of_open_square j f g i hcomp q).symm
    _ = (n : WithBot ℕ∞) := by
      change _ = ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) at hdimChart
      rw [← hPn]
      exact hdimChart

/-- The dimension of the fibre at `f x` at the point `f.asFiber x` is the dimension of the
preimage `f ⁻¹' {f x}` at `x`. -/
private theorem topologicalKrullDimAt_fiber_asFiber
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) =
      topologicalKrullDimAt (f ⁻¹' {f x}) ⟨x, rfl⟩ := by
  have hpoint : (f.fiberHomeo (f x)) (f.asFiber x) = ⟨x, rfl⟩ := by
    apply Subtype.ext
    simp [Scheme.Hom.asFiber]
  have hh := topologicalKrullDimAt_eq_of_homeomorph (f.fiberHomeo (f x)) (f.asFiber x)
  rwa [hpoint] at hh

/-- **The fibres of a morphism smooth of relative dimension `n` have dimension `n` at every
point**: the dimension of the fibre `f⁻¹(t)` at a point `z` is the fibre dimension of `f` at the
image of `z` in `X`, which is `n` by
`AlgebraicGeometry.fiberDimensionAt_eq_of_smoothOfRelativeDimension`. -/
theorem localKrullDim_fiber_eq_of_smoothOfRelativeDimension
    {X S : Scheme.{u}} (n : ℕ) (f : X ⟶ S) [SmoothOfRelativeDimension n f] (t : S)
    (z : f.fiber t) : TopologicalSpace.localKrullDim (f.fiber t) z = (n : WithBot ℕ∞) := by
  rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim]
  let y := f.fiberι t z
  have hsets : f ⁻¹' {f y} = f ⁻¹' {t} := congrArg (fun s => f ⁻¹' {s}) (f.fiberHomeo t z).property
  have hpoint : (Homeomorph.setCongr hsets) ⟨y, rfl⟩ = f.fiberHomeo t z := by
    apply Subtype.ext
    simp [Homeomorph.setCongr, Scheme.Hom.fiberHomeo_apply, y]
  have htrans := topologicalKrullDimAt_eq_of_homeomorph (Homeomorph.setCongr hsets) ⟨y, rfl⟩
  rw [hpoint] at htrans
  exact (topologicalKrullDimAt_eq_of_homeomorph (f.fiberHomeo t) z).trans
    (htrans.symm.trans ((topologicalKrullDimAt_fiber_asFiber f y).symm.trans
      (fiberDimensionAt_eq_of_smoothOfRelativeDimension f n y)))


/-- **A nonempty fibre of a morphism smooth of relative dimension `n` has dimension `n`.** The
dimension of a space is the supremum of its dimensions at its points, and
`AlgebraicGeometry.fiberDimensionAt_eq_of_smoothOfRelativeDimension` evaluates each of those to
`n`; the supremum of the constant family is `n` because the fibre is nonempty. -/
theorem fiberDimension_eq_of_smoothOfRelativeDimension
    {X S : Scheme.{u}} (n : ℕ) (f : X ⟶ S) [SmoothOfRelativeDimension n f]
    [∀ t : S, Nonempty (f.fiber t)] :
    ∀ t : S, topologicalKrullDim (f.fiber t) = (n : WithBot ℕ∞) := by
  intro t
  rw [TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim,
    iSup_congr fun z => localKrullDim_fiber_eq_of_smoothOfRelativeDimension n f t z, iSup_const]

/-- **Every fibre of a morphism smooth of relative dimension `n` has dimension at most `n`**,
empty fibres included: the dimension at each point of the fibre is `n`. -/
theorem topologicalKrullDim_fiber_le_of_smoothOfRelativeDimension
    {X S : Scheme.{u}} (n : ℕ) (f : X ⟶ S) [SmoothOfRelativeDimension n f] (t : S) :
    topologicalKrullDim (f.fiber t) ≤ (n : WithBot ℕ∞) := by
  rw [TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
  exact iSup_le fun z ↦ (localKrullDim_fiber_eq_of_smoothOfRelativeDimension n f t z).le


/-- The topological Krull dimension of a scheme at a point can be computed on the prime spectrum
of the sections over any affine open neighbourhood of that point. -/
theorem topologicalKrullDimAt_eq_localKrullDim_affineOpen
    {X : Scheme.{u}} (x : X) (U : X.Opens) (hx : x ∈ U) (hU : IsAffineOpen U) :
    topologicalKrullDimAt X x =
      TopologicalSpace.localKrullDim (PrimeSpectrum Γ(X, U))
        (hU.primeIdealOf ⟨x, hx⟩) := by
  rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim]
  exact ((IsOpen.isOpenEmbedding_subtypeVal U.2).topologicalKrullDimAt_eq ⟨x, hx⟩).trans
    (topologicalKrullDimAt_eq_of_homeomorph hU.isoSpec.hom.homeomorph ⟨x, hx⟩)


/-- The stalks of a regular scheme are regular local rings: the stalk at a point is a localization
of the regular ring of sections on an affine open neighbourhood. -/
theorem IsRegular.isRegularLocalRing_stalk
    {X : Scheme.{u}} (hX : IsRegular X) (x : X) :
    IsRegularLocalRing (X.presheaf.stalk x) := by
  obtain ⟨U, hxU, hreg⟩ := hX x
  let p := U.2.primeIdealOf ⟨x, hxU⟩
  let A := Γ(X, U)
  let R := X.presheaf.stalk x
  let : Algebra A R := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  have : IsLocalization.AtPrime R p.asIdeal := U.2.isLocalization_stalk ⟨x, hxU⟩
  have : IsRegularRing A := hreg
  let e : Localization.AtPrime p.asIdeal ≃+* R :=
    (IsLocalization.algEquiv p.asIdeal.primeCompl (Localization.AtPrime p.asIdeal) R).toRingEquiv
  have : IsRegularLocalRing (Localization.AtPrime p.asIdeal) :=
    IsRegularRing.isRegularLocalRing_localization p.asIdeal
  exact IsRegularLocalRing.of_ringEquiv e


/-- If the closed subscheme cut out by an ideal sheaf is discrete, then every point of its support
is closed in the ambient scheme, being the image of a closed point under a closed immersion. -/
theorem Scheme.IdealSheafData.isClosed_singleton_of_discreteTopology_subscheme
    {Y : Scheme.{u}} (J : Y.IdealSheafData) [DiscreteTopology J.subscheme]
    (x : Y) (hx : x ∈ J.support) : IsClosed ({x} : Set Y) := by
  obtain ⟨z, rfl⟩ : x ∈ Set.range J.subschemeι := by rwa [J.range_subschemeι]
  rw [← Set.image_singleton]
  exact J.subschemeι.isClosedEmbedding.isClosedMap _ (isClosed_discrete _)


/-- At a closed point of a scheme locally of finite type over a field, the topological Krull
dimension agrees with the Krull dimension of the stalk. On an affine open neighbourhood the local
dimension splits as the height of the corresponding prime plus the transcendence degree of its
residue field over the base field; the point being closed makes that prime maximal, so its
residue field is a finite, hence algebraic, extension and the transcendence degree vanishes. -/
@[ega "IV 13.3.4" "special case",
  ega "IV 17.15.8" "special case",
  ega "IV 5.2.3" "closed points",
  sga "1 II 5.8" "special case",
  sga "1 II 5.9" "n = p at closed points"]
theorem topologicalKrullDimAt_eq_ringKrullDim_stalk_of_closed_point
    {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [LocallyOfFiniteType f] (x : X) (hx : IsClosed ({x} : Set X)) :
    topologicalKrullDimAt X x = ringKrullDim (X.presheaf.stalk x) := by
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
  let p := hU.primeIdealOf ⟨x, hxU⟩
  let : Algebra k Γ(X, U) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ U (by simp)).hom.toAlgebra
  have hftA : RingHom.FiniteType (algebraMap k Γ(X, U)) := by
    show (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ U (by simp)).hom).FiniteType
    exact (f.finiteType_appLE (isAffineOpen_top _) hU (by simp)).comp
      (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso (.of k)).symm.commRingCatIsoToRingEquiv.surjective)
  have : Algebra.FiniteType k Γ(X, U) :=
    (RingHom.finiteType_algebraMap).mp hftA
  have hpre : hU.fromSpec ⁻¹' ({x} : Set X) = {p} := by
    ext q
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨fun hqx => hU.fromSpec.isOpenEmbedding.injective
      (hqx.trans (hU.fromSpec_primeIdealOf ⟨x, hxU⟩).symm),
      by rintro rfl; exact hU.fromSpec_primeIdealOf ⟨x, hxU⟩⟩
  have : p.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mp
    (hpre ▸ hx.preimage hU.fromSpec.continuous :)
  have hftK : RingHom.FiniteType (algebraMap Γ(X, U) p.asIdeal.ResidueField) :=
    RingHom.FiniteType.of_surjective _ p.asIdeal.algebraMap_residueField_surjective
  have : Algebra.FiniteType Γ(X, U) p.asIdeal.ResidueField :=
    (RingHom.finiteType_algebraMap).mp hftK
  have : IsScalarTower k Γ(X, U) p.asIdeal.ResidueField :=
    .of_algebraMap_eq fun _ => rfl
  have : Algebra.FiniteType k p.asIdeal.ResidueField :=
    Algebra.FiniteType.trans ((RingHom.finiteType_algebraMap).mp hftA) inferInstance
  have : Algebra.IsAlgebraic k p.asIdeal.ResidueField := by
    have : Module.Finite k p.asIdeal.ResidueField :=
      finite_of_finite_type_of_isJacobsonRing _ _
    exact Algebra.IsAlgebraic.of_finite _ _
  rw [topologicalKrullDimAt_eq_localKrullDim_affineOpen x U hxU hU,
    hU.ringKrullDim_stalk_eq_height x hxU,
    PrimeSpectrum.localKrullDim_eq_height_add_trdeg_residueField k p]
  simp [trdeg_eq_zero, p]


/-- **Stacks Project, Tag 0B9D.** A scheme smooth of relative dimension one over a field has
topological Krull dimension one at every point: the structure morphism has a single fibre, which
is the scheme itself, and the fibre dimension of a morphism smooth of relative dimension one is
one. -/
theorem topologicalKrullDimAt_eq_one_of_smoothOfRelativeDimension_one
    {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 f] (x : X) :
    topologicalKrullDimAt X x = 1 := by
  have hpre : f ⁻¹' {f x} = Set.univ := Set.eq_univ_of_forall fun _ => Subsingleton.elim _ _
  have hdim := topologicalKrullDimAt_eq_of_homeomorph
    ((Homeomorph.setCongr hpre).trans (Homeomorph.Set.univ X)) ⟨x, rfl⟩
  have hfiber := fiberDimensionAt_eq_of_smoothOfRelativeDimension f 1 x
  rw [topologicalKrullDimAt_fiber_asFiber] at hfiber
  exact (hdim.symm.trans hfiber).trans Nat.cast_one


/-- **Stacks Project, Tag 0B9D.** If a closed subscheme is locally quasi-finite and locally of
finite type over the base, then each of its fibres is discrete: the fibre is isomorphic to the
fibre of the structure morphism of the subscheme, which is locally Artinian and so discrete. -/
@[ega "II 6.1.7" "partial"]
theorem Scheme.IdealSheafData.discreteTopology_subscheme_comap_fiberι
    {X S : Scheme.{u}} (f : X ⟶ S) (I : X.IdealSheafData)
    [LocallyOfFiniteType (I.subschemeι ≫ f)] [LocallyQuasiFinite (I.subschemeι ≫ f)]
    (s : S) : DiscreteTopology ((I.comap (f.fiberι s)).subscheme) := by
  let g := S.fromSpecResidueField s
  let h := I.subschemeι ≫ f
  let J := I.comap (f.fiberι s)
  let e₁ := I.comapIso (f.fiberι s)
  let e₂ := pullbackSymmetry (f.fiberι s) I.subschemeι
  let e₃ := pullbackRightPullbackFstIso f g I.subschemeι
  let e : J.subscheme ≅ h.fiber s := e₁ ≪≫ e₂ ≪≫ e₃
  have : IsLocallyArtinian (h.fiber s) := inferInstance
  have : DiscreteTopology (h.fiber s) := inferInstance
  exact e.hom.homeomorph.symm.discreteTopology


/-- **Stacks Project, Tag 0B9D (3) iff (4).** Over a locally Noetherian base, a morphism locally of
finite type is automatically locally of finite presentation, so the finite presentation conjunct
may be dropped from the characterization of relative effective Cartier divisors. -/
@[stacks 0B9D "(3) iff (4) when S is locally Noetherian"]
theorem locallyQuasiFinite_flat_locallyOfFinitePresentation_iff_of_isLocallyNoetherian
    {D S : Scheme.{u}} (g : D ⟶ S) [IsLocallyNoetherian S] :
    (LocallyOfFiniteType g ∧ LocallyQuasiFinite g ∧ Flat g ∧
      LocallyOfFinitePresentation g) ↔
    (LocallyOfFiniteType g ∧ LocallyQuasiFinite g ∧ Flat g) :=
  ⟨fun h => ⟨h.1, h.2.1, h.2.2.1⟩, fun ⟨hlft, hqf, hflat⟩ => ⟨hlft, hqf, hflat,
    instLocallyOfFinitePresentationOfIsLocallyNoetherianOfLocallyOfFiniteType g⟩⟩

end AlgebraicGeometry

