module

public import Mathlib.AlgebraicGeometry.AffineSpace
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.AffineTarget
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.Module
public import StacksFrontier.AlgebraicGeometry.Perfect.SupportClosedSubset.EquationsBaseChange
public import StacksFrontier.AlgebraicGeometry.Picard.HilbertFunctorRepresentableLocal
public import StacksFrontier.RingTheory.Polynomial.MonicGeneratorOfLocallyFreeQuotient

/-!
# Families of points on the affine line

Let `S` be a scheme and `T` an `S`-scheme. The affine line `𝔸¹_S ×_S T` over `T` carries the
coordinate function `x`, and a polynomial `P` with coefficients in `Γ(T, 𝒪_T)` defines the closed
subscheme `V(P) ⊆ 𝔸¹_S ×_S T` cut out by the function `P(x)`. This file shows that the degree-`d`
Hilbert families in `𝔸¹_S` over `T` are, locally on `T`, exactly the zero schemes of monic
polynomials of degree `d`:

* the zero scheme of a monic polynomial of degree `d` is finite locally free of rank `d` over `T`;
* over an affine `T`, every closed subscheme which is finite locally free of rank `d` over `T` is
  the zero scheme of exactly one monic polynomial of degree `d`.

## Main definitions

* `Stacks.Hilbert.AffineLine.line` — the affine line `𝔸¹_S` as an `S`-scheme.
* `Stacks.Hilbert.AffineLine.ambient` — its base change `𝔸¹_S ×_S T`.
* `Stacks.Hilbert.AffineLine.evalPoly` — `P ↦ P(x)`, from polynomials over `Γ(T, 𝒪_T)` to
  functions on `𝔸¹_S ×_S T`.
* `Stacks.Hilbert.AffineLine.zeroIdeal` — the ideal sheaf generated by `P(x)`.
* `Stacks.Hilbert.AffineLine.monicFamily` — the degree-`d` Hilbert family cut out by the monic
  polynomial `monicOfCoeffs c`.

## Main results

* `Stacks.Hilbert.AffineLine.bijective_evalPoly` — over an affine base, `P ↦ P(x)` identifies the
  polynomial ring with the functions on the affine line.
* `Stacks.Hilbert.AffineLine.existsUnique_eq_monicFamily` — over an affine base a degree-`d` family
  is cut out by exactly one monic polynomial of degree `d`.
* `Stacks.Hilbert.AffineLine.comap_zeroIdeal` — zero schemes are compatible with base change.

## Implementation notes

The algebra is `Polynomial.existsUnique_eq_span_monicOfCoeffs`. Over an affine base `T` the
ambient scheme is affine, an ideal sheaf on it is determined by its ideal of global sections, and
the global sections of the closed subscheme are the quotient of the global sections of the
ambient scheme (`AlgebraicGeometry.Scheme.IdealSheafData.subschemeι_app_surjective`). The
identification of the global sections of `𝔸¹_S ×_S T` with `Γ(T, 𝒪_T)[X]` is transported from
Mathlib's `AlgebraicGeometry.AffineSpace.isoOfIsAffine` along the canonical isomorphism of
`𝔸¹_S ×_S T` with `𝔸¹_T` (`AlgebraicGeometry.AffineSpace.isPullback_map`).
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Polynomial

universe u

namespace Stacks.Hilbert.AffineLine

variable {S : Scheme.{u}}

/-- The affine line over `S`, as an `S`-scheme. -/
abbrev line (S : Scheme.{u}) : Over S := Over.mk (𝔸(PUnit.{u + 1}; S) ↘ S)

/-- The affine line over an `S`-scheme `T`: the fibre product `𝔸¹_S ×_S T`. -/
abbrev ambient (T : Over S) : Scheme.{u} := ((Over.pullback T.hom).obj (line S)).left

/-- The projection of `𝔸¹_S ×_S T` to `T`. -/
abbrev proj (T : Over S) : ambient T ⟶ T.left := ((Over.pullback T.hom).obj (line S)).hom

/-- The coordinate function `x` on `𝔸¹_S ×_S T`. -/
def coordX (T : Over S) : Γ(ambient T, ⊤) :=
  (pullback.fst (𝔸(PUnit.{u + 1}; S) ↘ S) T.hom).appTop (AffineSpace.coord S PUnit.unit)

/-- Evaluation at the coordinate: a polynomial `P` over `Γ(T, 𝒪_T)` gives the function `P(x)` on
`𝔸¹_S ×_S T`. -/
def evalPoly (T : Over S) : Γ(T.left, ⊤)[X] →+* Γ(ambient T, ⊤) :=
  eval₂RingHom (proj T).appTop.hom (coordX T)

/-- A constant polynomial `C r` evaluates to the pullback of `r` along the projection to `T`. -/
theorem evalPoly_C (T : Over S) (r : Γ(T.left, ⊤)) :
    evalPoly T (C r) = (proj T).appTop r := by
  simp [evalPoly]

/-- The polynomial `X` evaluates to the coordinate function `x`. -/
theorem evalPoly_X (T : Over S) : evalPoly T X = coordX T := by
  simp [evalPoly]

/-- The ideal sheaf of the zero scheme `V(P) ⊆ 𝔸¹_S ×_S T`. -/
def zeroIdeal (T : Over S) (P : Γ(T.left, ⊤)[X]) : (ambient T).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (Ideal.span {evalPoly T P})

/-! ### Base change -/

/-- The base change map `𝔸¹_S ×_S T' ⟶ 𝔸¹_S ×_S T` pulls the coordinate `x` back to the coordinate
`x`. -/
theorem familyBaseChangeMap_appTop_coordX {T' T : Over S} (g : T' ⟶ T) :
    (familyBaseChangeMap (line S) g).appTop (coordX T) = coordX T' := by
  have h : familyBaseChangeMap (line S) g ≫ pullback.fst (𝔸(PUnit.{u + 1}; S) ↘ S) T.hom =
      pullback.fst (𝔸(PUnit.{u + 1}; S) ↘ S) T'.hom := by
    simp only [familyBaseChangeMap, pullback.map, Category.comp_id]
    exact pullback.lift_fst _ _ _
  rw [coordX, coordX, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, h]

/-- The base change map `𝔸¹_S ×_S T' ⟶ 𝔸¹_S ×_S T` lies over `g : T' ⟶ T`. -/
theorem familyBaseChangeMap_comp_proj {T' T : Over S} (g : T' ⟶ T) :
    familyBaseChangeMap (line S) g ≫ proj T = proj T' ≫ g.left := by
  simp only [familyBaseChangeMap, pullback.map, Category.comp_id]
  exact pullback.lift_snd _ _ _

/-- The base change map along `g : T' ⟶ T` pulls `P(x)` back to `Q(x)`, where `Q` is `P` with its
coefficients pulled back along `g`. -/
theorem familyBaseChangeMap_appTop_evalPoly {T' T : Over S} (g : T' ⟶ T)
    (P : Γ(T.left, ⊤)[X]) :
    (familyBaseChangeMap (line S) g).appTop (evalPoly T P) =
      evalPoly T' (P.map g.left.appTop.hom) := by
  rw [evalPoly, evalPoly, coe_eval₂RingHom, coe_eval₂RingHom, hom_eval₂, eval₂_map,
    familyBaseChangeMap_appTop_coordX]
  congr 1
  rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop,
    ← Scheme.Hom.comp_appTop, familyBaseChangeMap_comp_proj]

/-- **Zero schemes are compatible with base change.** -/
theorem comap_zeroIdeal {T' T : Over S} (g : T' ⟶ T) (P : Γ(T.left, ⊤)[X]) :
    (zeroIdeal T P).comap (familyBaseChangeMap (line S) g) =
      zeroIdeal T' (P.map g.left.appTop.hom) := by
  rw [zeroIdeal, zeroIdeal, Stacks.IdealSheaf.comap_ofIdealTop, Ideal.map_span,
    Set.image_singleton, familyBaseChangeMap_appTop_evalPoly]

/-! ### Over an affine base -/

/-- The affine line over `T`, compared with Mathlib's `𝔸¹_T`. -/
def ambientIso (T : Over S) : 𝔸(PUnit.{u + 1}; T.left) ≅ ambient T :=
  (AffineSpace.isPullback_map (n := PUnit.{u + 1}) T.hom).isoPullback

/-- Under the isomorphism `𝔸¹_T ≅ 𝔸¹_S ×_S T`, the function `P(x)` corresponds to the evaluation
of `P`, viewed as a polynomial in one variable indexed by `PUnit`, at the coordinate of `𝔸¹_T`. -/
theorem ambientIso_hom_appTop_evalPoly (T : Over S) (P : Γ(T.left, ⊤)[X]) :
    (ambientIso T).hom.appTop (evalPoly T P) =
      MvPolynomial.eval₂Hom (𝔸(PUnit.{u + 1}; T.left) ↘ T.left).appTop.hom
        (AffineSpace.coord T.left) ((MvPolynomial.uniqueAlgEquiv _ PUnit.{u + 1}).symm P) := by
  induction P using Polynomial.induction_on' with
  | add p q hp hq => simp only [map_add, hp, hq]
  | monomial k a =>
    have hsymm : (MvPolynomial.uniqueAlgEquiv Γ(T.left, ⊤) PUnit.{u + 1}).symm (C a * X ^ k) =
        MvPolynomial.C a * MvPolynomial.X PUnit.unit ^ k := by
      simp [MvPolynomial.uniqueAlgEquiv_symm_apply]
    rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, evalPoly_C, evalPoly_X, map_mul, map_pow,
      hsymm, map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
      ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, coordX, ← CommRingCat.comp_apply,
      ← Scheme.Hom.comp_appTop]
    have hs : (ambientIso T).hom ≫ proj T = 𝔸(PUnit.{u + 1}; T.left) ↘ T.left :=
      IsPullback.isoPullback_hom_snd _
    have hf : (ambientIso T).hom ≫ pullback.fst (𝔸(PUnit.{u + 1}; S) ↘ S) T.hom =
        AffineSpace.map PUnit.{u + 1} T.hom :=
      IsPullback.isoPullback_hom_fst _
    rw [hs, hf, AffineSpace.map_appTop_coord]

/-- The ring map induced by an isomorphism of schemes on global sections is bijective. -/
theorem bijective_appTop_of_isIso {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    Function.Bijective f.appTop := by
  have : IsIso f.appTop := inferInstanceAs (IsIso (Scheme.Γ.map f.op))
  exact ConcreteCategory.bijective_of_isIso f.appTop

/-- **Polynomials are the functions on the affine line over an affine base.** -/
theorem bijective_evalPoly (T : Over S) [IsAffine T.left] : Function.Bijective (evalPoly T) := by
  set φ := MvPolynomial.eval₂Hom (𝔸(PUnit.{u + 1}; T.left) ↘ T.left).appTop.hom
    (AffineSpace.coord T.left)
  have h2 : Function.Bijective φ := by
    have h := bijective_appTop_of_isIso (AffineSpace.isoOfIsAffine PUnit.{u + 1} T.left).hom
    rw [AffineSpace.isoOfIsAffine_hom_appTop] at h
    exact (Function.Bijective.of_comp_iff φ
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso _).hom)).mp h
  have h4 : Function.Bijective ((ambientIso T).hom.appTop.hom.comp (evalPoly T)) := by
    have h3 : (ambientIso T).hom.appTop.hom.comp (evalPoly T) =
        φ.comp (MvPolynomial.uniqueAlgEquiv _ PUnit.{u + 1}).symm.toRingEquiv.toRingHom :=
      RingHom.ext fun P ↦ ambientIso_hom_appTop_evalPoly T P
    rw [h3]
    exact h2.comp (MvPolynomial.uniqueAlgEquiv _ PUnit.{u + 1}).symm.bijective
  exact (Function.Bijective.of_comp_iff' (bijective_appTop_of_isIso _) _).mp h4

/-- The affine line over an affine base is affine. -/
instance (T : Over S) [IsAffine T.left] : IsAffine (ambient T) :=
  inferInstanceAs (IsAffine (pullback (𝔸(PUnit.{u + 1}; S) ↘ S) T.hom))

/-! ### Global sections of closed subschemes of the affine line over an affine base -/

/-- The ideal of polynomials vanishing on a closed subscheme of the affine line over an affine
base. -/
def polyIdeal (T : Over S) [IsAffine T.left] (I : (ambient T).IdealSheafData) :
    Ideal Γ(T.left, ⊤)[X] :=
  (I.ideal ⟨⊤, isAffineOpen_top _⟩).comap (evalPoly T)

/-- The `Γ(T, 𝒪_T)`-algebra structure on the global sections of a closed subscheme of the
affine line over `T`. -/
abbrev subschemeAlgebra (T : Over S) (I : (ambient T).IdealSheafData) :
    Algebra Γ(T.left, ⊤) Γ(I.subscheme, ⊤) :=
  (I.subschemeι ≫ proj T).appTop.hom.toAlgebra

/-- Restricting polynomials to a closed subscheme of the affine line over an affine base, as a
homomorphism of algebras over the base. -/
def restrictPoly (T : Over S) [IsAffine T.left] (I : (ambient T).IdealSheafData) :
    letI := subschemeAlgebra T I
    Γ(T.left, ⊤)[X] →ₐ[Γ(T.left, ⊤)] Γ(I.subscheme, ⊤) :=
  letI := subschemeAlgebra T I
  { toRingHom := I.subschemeι.appTop.hom.comp (evalPoly T)
    commutes' := fun r ↦ by
      change I.subschemeι.appTop (evalPoly T (C r)) = (I.subschemeι ≫ proj T).appTop r
      rw [evalPoly_C, Scheme.Hom.comp_appTop, CommRingCat.comp_apply] }

/-- Over an affine base, every global function on a closed subscheme of the affine line is the
restriction of a polynomial. -/
theorem restrictPoly_surjective (T : Over S) [IsAffine T.left] (I : (ambient T).IdealSheafData) :
    Function.Surjective (restrictPoly T I) :=
  (I.subschemeι_app_surjective ⟨⊤, isAffineOpen_top _⟩).comp (bijective_evalPoly T).2

/-- The kernel of restricting polynomials to a closed subscheme of the affine line is the ideal of
polynomials vanishing on it. -/
theorem ker_restrictPoly (T : Over S) [IsAffine T.left] (I : (ambient T).IdealSheafData) :
    RingHom.ker (restrictPoly T I) = polyIdeal T I := by
  show RingHom.ker (I.subschemeι.appTop.hom.comp (evalPoly T)) = _
  rw [← RingHom.comap_ker, polyIdeal]
  congr 1
  exact I.ker_subschemeι_app ⟨⊤, isAffineOpen_top _⟩

/-- Over an affine base, the global sections of a closed subscheme of the affine line are the
quotient of the polynomial ring by the polynomials vanishing on it, as a module over the base. -/
def subschemeLinearEquiv (T : Over S) [IsAffine T.left] (I : (ambient T).IdealSheafData) :
    letI := subschemeAlgebra T I
    (Γ(T.left, ⊤)[X] ⧸ polyIdeal T I) ≃ₗ[Γ(T.left, ⊤)] Γ(I.subscheme, ⊤) :=
  letI := subschemeAlgebra T I
  ((Ideal.quotientEquivAlgOfEq Γ(T.left, ⊤) (ker_restrictPoly T I).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (restrictPoly_surjective T I))).toLinearEquiv

/-- Over an affine base, a closed subscheme of the affine line is finite locally free of rank `d`
exactly when the quotient of the polynomial ring by the polynomials vanishing on it is a finite
locally free module of rank `d`. -/
theorem isFiniteLocallyFreeOfRank_iff (T : Over S) [IsAffine T.left]
    (I : (ambient T).IdealSheafData) (d : ℕ) :
    Stacks.Morphisms.IsFiniteLocallyFreeOfRank (I.subschemeι ≫ proj T) d ↔
      Module.IsFiniteLocallyFreeOfRank Γ(T.left, ⊤) (Γ(T.left, ⊤)[X] ⧸ polyIdeal T I) d := by
  let := subschemeAlgebra T I
  have : IsAffineHom (proj T) := isAffineHom_of_isAffine _
  rw [Stacks.Morphisms.isFiniteLocallyFreeOfRank_iff_module_of_isAffine _ d rfl]
  exact ⟨fun h ↦ h.of_linearEquiv (subschemeLinearEquiv T I).symm,
    fun h ↦ h.of_linearEquiv (subschemeLinearEquiv T I)⟩

/-- Over an affine base, the ideal of global sections of `zeroIdeal T P` is generated by
`P(x)`. -/
theorem zeroIdeal_ideal_top (T : Over S) [IsAffine T.left] (P : Γ(T.left, ⊤)[X]) :
    (zeroIdeal T P).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {evalPoly T P} := by
  rw [zeroIdeal, Scheme.IdealSheafData.ofIdealTop_ideal,
    show (homOfLE (le_top (a := (⊤ : (ambient T).Opens)))) = 𝟙 _ from rfl]
  simp

/-- Over an affine base, the polynomials vanishing on the zero scheme `V(P)` form the ideal
generated by `P`. -/
theorem polyIdeal_zeroIdeal (T : Over S) [IsAffine T.left] (P : Γ(T.left, ⊤)[X]) :
    polyIdeal T (zeroIdeal T P) = Ideal.span {P} := by
  rw [polyIdeal, zeroIdeal_ideal_top, ← Set.image_singleton, ← Ideal.map_span]
  exact Ideal.comap_map_of_bijective _ (bijective_evalPoly T)

/-- Over an affine base, the zero scheme of `monicOfCoeffs c` is finite locally free of rank
`d`. -/
theorem isFiniteLocallyFreeOfRank_zeroIdeal_of_isAffine (T : Over S) [IsAffine T.left] {d : ℕ}
    (c : Fin d → Γ(T.left, ⊤)) :
    Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((zeroIdeal T (monicOfCoeffs c)).subschemeι ≫ proj T) d := by
  rw [isFiniteLocallyFreeOfRank_iff, polyIdeal_zeroIdeal]
  exact isFiniteLocallyFreeOfRank_quotient_monicOfCoeffs c

/-- Mapping the coefficients of `monicOfCoeffs c` along a ring homomorphism `f` gives
`monicOfCoeffs (f ∘ c)`. -/
theorem map_monicOfCoeffs {R R' : Type*} [CommRing R] [CommRing R'] (f : R →+* R') {d : ℕ}
    (c : Fin d → R) : (monicOfCoeffs c).map f = monicOfCoeffs (fun i ↦ f (c i)) := by
  simp [monicOfCoeffs, Polynomial.map_sum]

/-- **The zero scheme of a monic polynomial of degree `d` is a degree-`d` family.** -/
theorem isFiniteLocallyFreeOfRank_zeroIdeal (T : Over S) {d : ℕ} (c : Fin d → Γ(T.left, ⊤)) :
    Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((zeroIdeal T (monicOfCoeffs c)).subschemeι ≫ proj T) d := by
  refine isFiniteLocallyFreeOfRank_of_restrict (line S) _ d T.left.affineCover fun i ↦ ?_
  rw [comap_zeroIdeal, map_monicOfCoeffs]
  have : IsAffine (Over.mk (T.left.affineCover.f i ≫ T.hom)).left :=
    inferInstanceAs (IsAffine (Spec _))
  exact isFiniteLocallyFreeOfRank_zeroIdeal_of_isAffine
    (Over.mk (T.left.affineCover.f i ≫ T.hom)) _

/-- The degree-`d` Hilbert family in the affine line cut out by the monic polynomial
`monicOfCoeffs c`. -/
def monicFamily (T : Over S) {d : ℕ} (c : Fin d → Γ(T.left, ⊤)) : HilbertFamily (line S) T d where
  ideal := zeroIdeal T (monicOfCoeffs c)
  isFiniteLocallyFreeOfRank := isFiniteLocallyFreeOfRank_zeroIdeal T c

/-- The base change of `monicFamily T c` along `g : T' ⟶ T` is the family cut out by the monic
polynomial whose coefficients are those of `c` pulled back along `g`. -/
theorem baseChange_monicFamily {T' T : Over S} (g : T' ⟶ T) {d : ℕ}
    (c : Fin d → Γ(T.left, ⊤)) :
    baseChange (line S) g (monicFamily T c) = monicFamily T' (fun i ↦ g.left.appTop (c i)) := by
  refine HilbertFamily.ext ?_
  rw [baseChange_ideal, monicFamily, monicFamily, comap_zeroIdeal, map_monicOfCoeffs]

/-- **Classification over an affine base.** Over an affine base, a degree-`d` Hilbert family in
the affine line is cut out by exactly one monic polynomial of degree `d`. -/
theorem existsUnique_eq_monicFamily (T : Over S) [IsAffine T.left] {d : ℕ}
    (D : HilbertFamily (line S) T d) : ∃! c : Fin d → Γ(T.left, ⊤), monicFamily T c = D := by
  have hmod := (isFiniteLocallyFreeOfRank_iff T D.ideal d).mp D.isFiniteLocallyFreeOfRank
  obtain ⟨c, hc, huniq⟩ := existsUnique_eq_span_monicOfCoeffs _ d hmod
  have key : ∀ c' : Fin d → Γ(T.left, ⊤), monicFamily T c' = D ↔
      polyIdeal T D.ideal = Ideal.span {monicOfCoeffs c'} := by
    refine fun c' ↦ ⟨?_, fun h ↦ ?_⟩
    · rintro rfl
      exact polyIdeal_zeroIdeal T _
    · refine HilbertFamily.ext (Scheme.IdealSheafData.ext_of_isAffine ?_)
      show (zeroIdeal T _).ideal ⟨⊤, isAffineOpen_top _⟩ = D.ideal.ideal ⟨⊤, isAffineOpen_top _⟩
      have hD : D.ideal.ideal ⟨⊤, isAffineOpen_top _⟩ =
          Ideal.map (evalPoly T) (polyIdeal T D.ideal) :=
        (Ideal.map_comap_of_surjective _ (bijective_evalPoly T).2 _).symm
      rw [zeroIdeal_ideal_top, hD, h, Ideal.map_span, Set.image_singleton]
  exact ⟨c, (key c).mpr hc, fun c' hc' ↦ huniq c' ((key c').mp hc')⟩

/-! ### The Hilbert scheme of points of the affine line -/

/-- Affine `d`-space over `S`, as an `S`-scheme. -/
abbrev space (S : Scheme.{u}) (d : ℕ) : Over S := Over.mk (𝔸(ULift.{u} (Fin d); S) ↘ S)

/-- The coefficients classified by a morphism to affine `d`-space. -/
def coeffsOf {T : Over S} {d : ℕ} (g : T ⟶ space S d) : Fin d → Γ(T.left, ⊤) :=
  fun i ↦ g.left.appTop (AffineSpace.coord S ⟨i⟩)

/-- The morphism to affine `d`-space classifying given coefficients. -/
def homOfCoeffs (T : Over S) {d : ℕ} (c : Fin d → Γ(T.left, ⊤)) : T ⟶ space S d :=
  Over.homMk (AffineSpace.homOfVector T.hom fun i ↦ c i.down) (AffineSpace.homOfVector_over _ _)

/-- The coefficients classified by `homOfCoeffs T c` are `c`. -/
@[simp]
theorem coeffsOf_homOfCoeffs (T : Over S) {d : ℕ} (c : Fin d → Γ(T.left, ⊤)) :
    coeffsOf (homOfCoeffs T c) = c := by
  funext i
  exact AffineSpace.homOfVector_appTop_coord _ _ _

/-- Two morphisms to affine `d`-space over `S` with the same coefficients are equal. -/
theorem hom_ext_of_coeffsOf {T : Over S} {d : ℕ} {g g' : T ⟶ space S d}
    (h : coeffsOf g = coeffsOf g') : g = g' := by
  refine Over.OverMorphism.ext (AffineSpace.hom_ext ?_ fun i ↦ congrFun h i.down)
  show g.left ≫ (space S d).hom = g'.left ≫ (space S d).hom
  rw [Over.w g, Over.w g']

/-- The coefficients classified by `f ≫ g` are those classified by `g`, pulled back along `f`. -/
theorem coeffsOf_comp {T' T : Over S} {d : ℕ} (f : T' ⟶ T) (g : T ⟶ space S d) :
    coeffsOf (f ≫ g) = fun i ↦ f.left.appTop (coeffsOf g i) := by
  funext i
  simp only [coeffsOf, Over.comp_left, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]

/-- The universal degree-`d` family in the affine line: the zero scheme of the monic polynomial
whose coefficients are the coordinates of affine `d`-space. -/
def universalFamily (S : Scheme.{u}) (d : ℕ) : HilbertFamily (line S) (space S d) d :=
  monicFamily (space S d) fun i ↦ AffineSpace.coord S ⟨i⟩

/-- The base change of the universal family along `g : T ⟶ 𝔸^d_S` is the family cut out by the
monic polynomial with the coefficients classified by `g`. -/
theorem baseChange_universalFamily {T : Over S} {d : ℕ} (g : T ⟶ space S d) :
    baseChange (line S) g (universalFamily S d) = monicFamily T (coeffsOf g) :=
  baseChange_monicFamily g _

/-- Every point of a scheme has an affine open neighbourhood. -/
theorem exists_isAffineOpen_mem (Y : Scheme.{u}) (y : Y) :
    ∃ V : Y.Opens, IsAffineOpen V ∧ y ∈ V := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hyV, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
  exact ⟨V, hV, hyV⟩

/-- Every point of an open of a scheme has an affine open neighbourhood inside it. -/
theorem exists_isAffineOpen_mem_le (Y : Scheme.{u}) (U : Y.Opens) (y : Y) (hy : y ∈ U) :
    ∃ V : Y.Opens, IsAffineOpen V ∧ y ∈ V ∧ V ≤ U := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hyV, hVU⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open hy U.2
  exact ⟨V, hV, hyV, hVU⟩

/-- **The Hilbert scheme of `d` points on the affine line is affine `d`-space.** A closed
subscheme of `𝔸¹_T` which is finite locally free of rank `d` over `T` is the zero scheme of a
unique monic polynomial of degree `d` with coefficients in `Γ(T, 𝒪_T)`, and such polynomials are
the morphisms `T ⟶ 𝔸^d_S` over `S`. -/
def representsHilbertFunctorOfRank (S : Scheme.{u}) (d : ℕ) :
    RepresentsHilbertFunctorOfRank (line S) (space S d) d :=
  RepresentsHilbertFunctorOfRank.ofUniversal (line S) (universalFamily S d)
    (bijective_baseChange_of_local (line S) (universalFamily S d)
      (fun T g g' hgg' t ↦ by
        obtain ⟨V, hV, htV⟩ := exists_isAffineOpen_mem T.left t
        refine ⟨V, htV, hom_ext_of_coeffsOf ?_⟩
        have : IsAffine (Over.restrict T V).left := hV
        have h := congrArg (baseChange (line S) (Over.restrictι T V)) hgg'
        rw [← baseChange_comp, ← baseChange_comp, baseChange_universalFamily,
          baseChange_universalFamily] at h
        obtain ⟨c, -, hc⟩ := existsUnique_eq_monicFamily (Over.restrict T V)
          (monicFamily (Over.restrict T V) (coeffsOf (Over.restrictι T V ≫ g')))
        exact (hc _ h).trans (hc _ rfl).symm)
      (fun T D t ↦ by
        obtain ⟨V, hV, htV⟩ := exists_isAffineOpen_mem T.left t
        have : IsAffine (Over.restrict T V).left := hV
        obtain ⟨c, hc, -⟩ := existsUnique_eq_monicFamily (Over.restrict T V)
          (baseChange (line S) (Over.restrictι T V) D)
        exact ⟨Over.restrict T V, Over.restrictι T V, inferInstanceAs (IsOpenImmersion V.ι),
          ⟨t, htV⟩, rfl, homOfCoeffs _ c, by
            rw [baseChange_universalFamily, coeffsOf_homOfCoeffs, hc]⟩))

end Stacks.Hilbert.AffineLine

end
