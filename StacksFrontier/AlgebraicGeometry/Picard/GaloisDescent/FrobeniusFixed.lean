module

public import StacksFrontier.AlgebraicGeometry.Picard.GaloisDescent.FiniteStageFixed
public import StacksFrontier.AlgebraicGeometry.Picard.GaloisDescent.TorsionFixingExtension
public import Mathlib.FieldTheory.Finite.GaloisField

/-!
# A Picard class fixed by the Frobenius is fixed by the whole Galois group

Let `k` be a finite field with `q` elements, let `K/k` be a Galois extension (an algebraic
closure, in the application), and let `X` be a quasi-compact, quasi-separated scheme over `k`.
The Frobenius `F : x ↦ x ^ q` of `K/k` acts on `Pic(X_K)` by pullback along `id_X × Spec(F)`.

**A class fixed by `F` is fixed by every element of `Gal(K/k)`.** The class descends to a finite
stage `E/k` (Tag 0B8W (2), `Stacks.Picard.exists_finiteSubextension_schemePullbackClass_eq`), so it
is fixed by `Gal(K/E)`. The group `Gal(E/k)` of the finite field `E` is generated by the
restriction of `F`, so every `τ ∈ Gal(K/k)` is a power of `F` times an element of `Gal(K/E)`.

The comparison of the Galois actions on `X_K` and on the base change `(X_E)_K` of an
intermediate stage, `Stacks.Picard.stageBaseChangeIso` and
`Stacks.Picard.galoisTwist_restrictScalars_comp_stageBaseChangeIso_hom`, is in
`StacksFrontier.AlgebraicGeometry.Picard.GaloisDescent.TorsionFixingExtension`, imported here.

## Main results

* `Stacks.Picard.restrictNormal_frobeniusAlgEquivOfAlgebraic`: the Frobenius of `K/k` restricts
  to the Frobenius of a finite intermediate field.
* `Stacks.Picard.galoisFixed_of_frobenius_fixed`: a class fixed by the Frobenius is fixed by
  `Gal(K/k)`.
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry

universe u

namespace Stacks.Picard

section Frobenius

variable {k K : Type u} [Field k] [Fintype k] [Field K] [Algebra k K] [IsGalois k K]

/-- **The Frobenius restricts to the Frobenius.** On a finite intermediate field `E` of `K/k`,
the restriction of `x ↦ x ^ q` is `x ↦ x ^ q`. -/
theorem restrictNormal_frobeniusAlgEquivOfAlgebraic (E : IntermediateField k K) [Finite E] :
    (FiniteField.frobeniusAlgEquivOfAlgebraic k K).restrictNormal E =
      FiniteField.frobeniusAlgEquivOfAlgebraic k E := by
  ext x
  have h := AlgEquiv.restrictNormal_commutes (FiniteField.frobeniusAlgEquivOfAlgebraic k K) E x
  rw [IntermediateField.algebraMap_apply, IntermediateField.algebraMap_apply] at h
  rw [h]
  simp

/-- **A Picard class fixed by the Frobenius is fixed by the Galois group.** Let `X` be a
quasi-compact, quasi-separated scheme over the finite field `k` and `K/k` a Galois extension. If
a class of `Pic(X_K)` is fixed by the twist `id_X × Spec(F)` along the Frobenius `F` of `K/k`,
then it is fixed by the twist along every `τ ∈ Gal(K/k)`. -/
theorem galoisFixed_of_frobenius_fixed (X : Over (Spec (.of k))) [CompactSpace X.left]
    [QuasiSeparatedSpace X.left] (x : ofScheme (SchemeOver.baseChange k K X))
    (hx : schemePullbackClass (galoisTwist k K X (FiniteField.frobeniusAlgEquivOfAlgebraic k K))
      x = x) :
    x ∈ galoisFixedClasses k K X := by
  let := galoisPicardAction k K X
  intro τ
  show τ • x = x
  obtain ⟨E, hE, p, y, hp₁, hp₂, hpy⟩ := exists_finiteSubextension_schemePullbackClass_eq X x
  have hle := fixingSubgroup_le_stabilizer_galoisPicardAction X E p hp₁ hp₂ y
  rw [hpy] at hle
  have : Finite E := Module.finite_of_finite k
  set F := FiniteField.frobeniusAlgEquivOfAlgebraic k K with hF
  have hFx : F ∈ MulAction.stabilizer (K ≃ₐ[k] K) x := hx
  obtain ⟨n, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow k E).2
    (τ.restrictNormal E)
  have hρ : F ^ (-(n.1 : ℤ)) * τ ∈ E.fixingSubgroup := by
    have hres : AlgEquiv.restrictNormalHom E (F ^ (-(n.1 : ℤ)) * τ) = 1 := by
      rw [map_mul, map_zpow]
      show (F.restrictNormal E) ^ (-(n.1 : ℤ)) * τ.restrictNormal E = 1
      rw [restrictNormal_frobeniusAlgEquivOfAlgebraic, ← hn, zpow_neg, zpow_natCast,
        inv_mul_cancel]
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro e he
    have h1 := AlgEquiv.restrictNormal_commutes (F ^ (-(n.1 : ℤ)) * τ) E ⟨e, he⟩
    have h2 : (F ^ (-(n.1 : ℤ)) * τ).restrictNormal E = 1 := hres
    rw [h2] at h1
    simpa using h1.symm
  have hmem : τ ∈ MulAction.stabilizer (K ≃ₐ[k] K) x := by
    have h1 : F ^ (n.1 : ℤ) ∈ MulAction.stabilizer (K ≃ₐ[k] K) x := zpow_mem hFx _
    have h2 := hle hρ
    have : τ = F ^ (n.1 : ℤ) * (F ^ (-(n.1 : ℤ)) * τ) := by group
    rw [this]
    exact mul_mem h1 h2
  exact hmem

end Frobenius

end Stacks.Picard

end
