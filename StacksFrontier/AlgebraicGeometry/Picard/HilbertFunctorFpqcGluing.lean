module

public import StacksFrontier.AlgebraicGeometry.Descent.ClosedImmersionFpqcDescent
public import StacksFrontier.AlgebraicGeometry.Descent.FpqcLocalAtTarget
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFree.FpqcLocalAtTarget
public import StacksFrontier.AlgebraicGeometry.Limits.DescendingMorphisms.FiniteLocallyFreeRank
public import StacksFrontier.AlgebraicGeometry.Picard.HilbertFunctorFpqcSheaf

/-!
# The Hilbert functor of points is a sheaf for the fpqc topology

Let `X` be a scheme over `S` and let `d` be a natural number. The degree-`d` Hilbert functor of
points `Stacks.Hilbert.hilbertFunctorOfRank` sends an `S`-scheme `T` to the closed subschemes of
`X ×_S T` which are finite locally free of rank `d` over `T`. This file proves that it satisfies
the sheaf property for the fpqc topology on the schemes over `S`, which is Stacks Tag 0B95.

## Main definitions

* `Stacks.Hilbert.familyDatum` — the descent datum, relative to the base change of an fpqc
  covering of `T` to `X ×_S T`, carried by a compatible family of degree-`d` Hilbert families.

## Main results

* `Stacks.Hilbert.exists_hilbertFamily_baseChange_eq` — **the gluing clause**: a family of
  degree-`d` Hilbert families over the members of an fpqc covering of `T` whose base changes to
  the pairwise fibre products agree comes from a degree-`d` Hilbert family over `T`.
* `Stacks.Hilbert.isSheaf_fpqcTopology_hilbertFunctorOfRank` — **Stacks Tag 0B95**: the
  degree-`d` Hilbert functor of points is an fpqc sheaf on the schemes over `S`.

## Implementation notes

*The route is the source's.* Given an fpqc covering `{T_i ⟶ T}` and families `Z_i` over `T_i`
agreeing on the overlaps, the base changes `X_i = X ×_S T_i ⟶ X_T` again form an fpqc covering,
by stability of `AlgebraicGeometry.Scheme.fpqcPrecoverage` under base change applied to
`Stacks.Hilbert.isPullback_familyBaseChangeMap`. The `Z_i` assemble into a descent datum relative
to that covering whose components are closed immersions, so
`AlgebraicGeometry.DescentData.isFamilyEffective_of_isClosedImmersion` — Stacks 03I0, which is
unconditional — produces a scheme `U` over `X_T` whose base change to `X_i` is `Z_i`. Being a
closed immersion is fpqc local on the base (Stacks 02L6,
`Stacks.Descent.isClosedImmersion_isLocalAtTarget_fpqc`), so `U ⟶ X_T` is a closed immersion and
its kernel ideal sheaf is the glued family; being finite locally free of rank `d` is fpqc local
on the base (Stacks 02VO,
`Stacks.Morphisms.isFiniteLocallyFreeOfRank_isLocalAtTarget_fpqc`), so the glued subscheme is
finite locally free of rank `d` over `T`.

*Why the cocycle condition is free.* The components of the descent datum are closed subschemes,
so the two objects the gluing isomorphism compares — `Z_i ×_{X_T} X_j` and `X_i ×_{X_T} Z_j` —
are closed subschemes of `X_i ×_{X_T} X_j` with the same ideal sheaf, and the isomorphism between
them is the unique one over the ambient scheme, `AlgebraicGeometry.IsClosedImmersion.lift`. The
cocycle identity is then an identity of morphisms into a product whose last factor has a
monomorphic structure map, so it is checked on the three projections.

*From the sieve to a covering family.* The fpqc topology on the schemes over `S` is generated by
the preimage of `AlgebraicGeometry.Scheme.fpqcPrecoverage` under `CategoryTheory.Over.forget`,
by `CategoryTheory.over_toGrothendieck_eq_toGrothendieck_comap_forget`, and that preimage is
stable under base change and has pullbacks, so the sheaf condition may be tested on covering
families rather than on covering sieves. The separatedness half is
`Stacks.Hilbert.hilbertFamily_ext_of_baseChange_eq`, which only needs the members of the family
to be flat and jointly surjective.

## References

* [Stacks Project, Tag 0B95](https://stacks.math.columbia.edu/tag/0B95)
* [Stacks Project, Tag 03I0](https://stacks.math.columbia.edu/tag/03I0)
* [Stacks Project, Tag 02L6](https://stacks.math.columbia.edu/tag/02L6)
* [Stacks Project, Tag 02VO](https://stacks.math.columbia.edu/tag/02VO)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe v u

namespace Stacks.Hilbert

/-- The kernel of the base change of a closed immersion is the pullback of its kernel. -/
theorem ker_of_isPullback {P A B D : Scheme.{u}} {p₁ : P ⟶ A} {p₂ : P ⟶ B}
    {f : A ⟶ D} {g : B ⟶ D} (sq : IsPullback p₁ p₂ f g) [IsClosedImmersion g] :
    p₁.ker = g.ker.comap f := by
  rw [← sq.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]

section Products

variable {W : Scheme.{u}}

/-- The product of two `W`-schemes is, on underlying schemes, their fibre product over `W`. -/
private theorem isPullback_prod_fst_snd (A B : Over W) :
    IsPullback (prod.fst (X := A) (Y := B)).left (prod.snd (X := A) (Y := B)).left A.hom B.hom :=
  Over.isPullback_of_binaryFan_isLimit (BinaryFan.mk prod.fst prod.snd) (prodIsProd A B)

/-- Multiplying a morphism of `W`-schemes by the identity of a second one is, on underlying
schemes, the base change of that morphism along the first projection. -/
theorem isPullback_prodMap_left_fst {A' A B : Over W} (a : A' ⟶ A) :
    IsPullback (prod.map a (𝟙 B)).left (prod.fst (X := A') (Y := B)).left
      (prod.fst (X := A) (Y := B)).left a.left := by
  have hA := isPullback_prod_fst_snd A B
  have hA' := isPullback_prod_fst_snd A' B
  have hsnd : (prod.map a (𝟙 B)).left ≫ (prod.snd (X := A) (Y := B)).left =
      (prod.snd (X := A') (Y := B)).left := by
    rw [← Over.comp_left, prod.map_snd, Over.comp_left]
    simp
  refine (IsPullback.of_bot ?_ ?_ hA).flip
  · rw [hsnd, Over.w a]
    exact hA'
  · rw [← Over.comp_left, ← Over.comp_left, prod.map_fst]

/-- Multiplying a morphism of `W`-schemes by the identity of a second one, on the right. -/
theorem isPullback_prodMap_left_snd {A B' B : Over W} (b : B' ⟶ B) :
    IsPullback (prod.map (𝟙 A) b).left (prod.snd (X := A) (Y := B')).left
      (prod.snd (X := A) (Y := B)).left b.left := by
  have hB := (isPullback_prod_fst_snd A B).flip
  have hB' := (isPullback_prod_fst_snd A B').flip
  have hfst : (prod.map (𝟙 A) b).left ≫ (prod.fst (X := A) (Y := B)).left =
      (prod.fst (X := A) (Y := B')).left := by
    rw [← Over.comp_left, prod.map_fst, Over.comp_left]
    simp
  refine (IsPullback.of_bot ?_ ?_ hB).flip
  · rw [hfst, Over.w b]
    exact hB'
  · rw [← Over.comp_left, ← Over.comp_left, prod.map_snd]

end Products

section Datum

variable {S : Scheme.{u}} {X T : Over S} {d : ℕ} {ι : Type v} {Y : ι → Over S}
  (g : ∀ i, Y i ⟶ T) (Z : ∀ i, HilbertFamily X (Y i) d)

/-- The `i`-th member of the base change of the covering to `X ×_S T`. -/
abbrev covMap (i : ι) :
    ((Over.pullback (Y i).hom).obj X).left ⟶ ((Over.pullback T.hom).obj X).left :=
  familyBaseChangeMap X (g i)

/-- The `i`-th member of the base change of the covering, as a scheme over `X ×_S T`. -/
abbrev datumAmb (i : ι) : Over (((Over.pullback T.hom).obj X).left) := Over.mk (covMap g i)

/-- The closed subscheme of `X ×_S Y i` cut out by the `i`-th member of the family. -/
abbrev datumObj (i : ι) : Over (((Over.pullback (Y i).hom).obj X).left) :=
  Over.mk (Z i).ideal.subschemeι

/-- The inclusion of `Z i ×_{X_T} X_j` into `X_i ×_{X_T} X_j`. -/
abbrev datumU (i j : ι) :
    (Over.map (covMap g i)).obj (datumObj Z i) ⨯ datumAmb g j ⟶ datumAmb g i ⨯ datumAmb g j :=
  prod.map (structureMap (covMap g i) (datumObj Z i)) (𝟙 _)

/-- The inclusion of `X_i ×_{X_T} Z j` into `X_i ×_{X_T} X_j`. -/
abbrev datumV (i j : ι) :
    datumAmb g i ⨯ (Over.map (covMap g j)).obj (datumObj Z j) ⟶ datumAmb g i ⨯ datumAmb g j :=
  prod.map (𝟙 _) (structureMap (covMap g j) (datumObj Z j))

/-- The structure map of `Z i` to `X ×_S Y i` is a closed immersion. -/
instance isClosedImmersion_structureMap_datumObj (i : ι) :
    IsClosedImmersion (structureMap (covMap g i) (datumObj Z i)).left :=
  inferInstanceAs (IsClosedImmersion (Z i).ideal.subschemeι)

/-- The kernel of the structure map of `Z i` to `X ×_S Y i` is the ideal sheaf of `Z i`. -/
theorem ker_structureMap_datumObj (i : ι) :
    (structureMap (covMap g i) (datumObj Z i)).left.ker = (Z i).ideal :=
  Scheme.IdealSheafData.ker_subschemeι _

/-- The inclusion of `Z i ×_{X_T} X_j` into `X_i ×_{X_T} X_j` is a closed immersion. -/
instance isClosedImmersion_datumU (i j : ι) : IsClosedImmersion (datumU g Z i j).left :=
  MorphismProperty.IsStableUnderBaseChange.of_isPullback
    (isPullback_prodMap_left_fst (B := datumAmb g j)
      (structureMap (covMap g i) (datumObj Z i))).flip
    (inferInstanceAs (IsClosedImmersion (Z i).ideal.subschemeι))

/-- The inclusion of `X_i ×_{X_T} Z j` into `X_i ×_{X_T} X_j` is a closed immersion. -/
instance isClosedImmersion_datumV (i j : ι) : IsClosedImmersion (datumV g Z i j).left :=
  MorphismProperty.IsStableUnderBaseChange.of_isPullback
    (isPullback_prodMap_left_snd (A := datumAmb g i)
      (structureMap (covMap g j) (datumObj Z j))).flip
    (inferInstanceAs (IsClosedImmersion (Z j).ideal.subschemeι))

/-- The ideal sheaf of `Z i ×_{X_T} X_j` in `X_i ×_{X_T} X_j` is the pullback of that of `Z i`
along the first projection. -/
theorem ker_datumU (i j : ι) : (datumU g Z i j).left.ker =
    (Z i).ideal.comap (prod.fst (X := datumAmb g i) (Y := datumAmb g j)).left := by
  rw [ker_of_isPullback (isPullback_prodMap_left_fst (B := datumAmb g j)
    (structureMap (covMap g i) (datumObj Z i))), ker_structureMap_datumObj]

/-- The ideal sheaf of `X_i ×_{X_T} Z j` in `X_i ×_{X_T} X_j` is the pullback of that of `Z j`
along the second projection. -/
theorem ker_datumV (i j : ι) : (datumV g Z i j).left.ker =
    (Z j).ideal.comap (prod.snd (X := datumAmb g i) (Y := datumAmb g j)).left := by
  rw [ker_of_isPullback (isPullback_prodMap_left_snd (A := datumAmb g i)
    (structureMap (covMap g j) (datumObj Z j))), ker_structureMap_datumObj]

/-- The base change of an fpqc covering of `T` to `X ×_S T` is an fpqc covering. -/
theorem ofArrows_covMap_mem_fpqcPrecoverage (X : Over S)
    (hcov : Presieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (g i).left) ∈
      Scheme.fpqcPrecoverage T.left) :
    Presieve.ofArrows (fun i ↦ ((Over.pullback (Y i).hom).obj X).left) (covMap (X := X) g) ∈
      Scheme.fpqcPrecoverage ((Over.pullback T.hom).obj X).left :=
  Precoverage.mem_coverings_of_isPullback (fun i ↦ (g i).left) hcov
    ((Over.pullback T.hom).obj X).hom _ (fun i ↦ ((Over.pullback (Y i).hom).obj X).hom)
    fun i ↦ isPullback_familyBaseChangeMap X (g i)

variable (hc : ∀ i j, (Z i).ideal.comap (prod.fst (X := datumAmb g i) (Y := datumAmb g j)).left =
  (Z j).ideal.comap (prod.snd (X := datumAmb g i) (Y := datumAmb g j)).left)

include hc

/-- If the families agree on the overlaps, then `Z i ×_{X_T} X_j` and `X_i ×_{X_T} Z j` have the
same ideal sheaf in `X_i ×_{X_T} X_j`. -/
theorem ker_datumV_eq_ker_datumU (i j : ι) :
    (datumV g Z i j).left.ker = (datumU g Z i j).left.ker := by
  rw [ker_datumU, ker_datumV, hc i j]

/-- The gluing isomorphism `Z i ×_{X_T} X_j ≅ X_i ×_{X_T} Z j`, on underlying schemes. -/
def datumGluingLeft (i j : ι) :
    ((Over.map (covMap g i)).obj (datumObj Z i) ⨯ datumAmb g j).left ⟶
      (datumAmb g i ⨯ (Over.map (covMap g j)).obj (datumObj Z j)).left :=
  IsClosedImmersion.lift (datumV g Z i j).left (datumU g Z i j).left
    (ker_datumV_eq_ker_datumU g Z hc i j).le

/-- The gluing morphism `datumGluingLeft` commutes with the inclusions into
`X_i ×_{X_T} X_j`. -/
@[reassoc]
theorem datumGluingLeft_comp (i j : ι) :
    datumGluingLeft g Z hc i j ≫ (datumV g Z i j).left = (datumU g Z i j).left :=
  IsClosedImmersion.lift_fac _ _ _

/-- The gluing morphism `datumGluingLeft` is an isomorphism. -/
instance isIso_datumGluingLeft (i j : ι) : IsIso (datumGluingLeft g Z hc i j) :=
  IsClosedImmersion.isIso_lift _ _ (ker_datumV_eq_ker_datumU g Z hc i j)

/-- The gluing isomorphism as an isomorphism of schemes over `X ×_S T`. -/
def datumGluingOver (i j : ι) :
    (Over.map (covMap g i)).obj (datumObj Z i) ⨯ datumAmb g j ≅
      datumAmb g i ⨯ (Over.map (covMap g j)).obj (datumObj Z j) :=
  Over.isoMk (asIso (datumGluingLeft g Z hc i j)) (by
    rw [← Over.w (datumV g Z i j)]
    exact (datumGluingLeft_comp_assoc g Z hc i j _).trans (Over.w (datumU g Z i j)))

/-- The gluing isomorphism `datumGluingOver` commutes with the inclusions into
`X_i ×_{X_T} X_j`. -/
@[reassoc (attr := simp)]
theorem datumGluingOver_comp_datumV (i j : ι) :
    (datumGluingOver g Z hc i j).hom ≫ datumV g Z i j = datumU g Z i j :=
  Over.OverMorphism.ext (datumGluingLeft_comp g Z hc i j)

/-- The gluing isomorphism `datumGluingOver` followed by the first projection to `X_i` is the
first projection to `Z i` followed by its inclusion into `X_i`. -/
@[reassoc (attr := simp)]
theorem datumGluingOver_hom_fst (i j : ι) :
    (datumGluingOver g Z hc i j).hom ≫ prod.fst =
      prod.fst ≫ structureMap (covMap g i) (datumObj Z i) := by
  simpa using datumGluingOver_comp_datumV_assoc g Z hc i j prod.fst

/-- The gluing isomorphism `datumGluingOver` followed by the second projection to `Z j` and its
inclusion into `X_j` is the second projection to `X_j`. -/
@[reassoc (attr := simp)]
theorem datumGluingOver_hom_snd (i j : ι) :
    (datumGluingOver g Z hc i j).hom ≫ prod.snd ≫
        structureMap (covMap g j) (datumObj Z j) = prod.snd := by
  simpa using datumGluingOver_comp_datumV_assoc g Z hc i j prod.snd

/-- The gluing isomorphism as an isomorphism over `X_i ×_{X_T} X_j`. -/
def datumGluing (i j : ι) : Over.mk (datumU g Z i j) ≅ Over.mk (datumV g Z i j) :=
  Over.isoMk (datumGluingOver g Z hc i j) (datumGluingOver_comp_datumV g Z hc i j)

/-- The structure map of `Z i` to `X_i`, as a morphism of schemes over `X ×_S T`, is a
monomorphism. -/
instance mono_structureMap_datumObj (i : ι) :
    Mono (structureMap (covMap g i) (datumObj Z i)) :=
  (Over.forget _).mono_of_mono_map
    (inferInstanceAs (Mono (Z i).ideal.subschemeι))

/-- The descent datum, relative to the base change of the covering to `X ×_S T`, carried by a
compatible family of degree-`d` Hilbert families. -/
def familyDatum : AlgebraicGeometry.DescentData (fun i ↦ covMap (X := X) g i) where
  obj i := datumObj Z i
  gluing i j := datumGluing g Z hc i j
  cocycle i j k := by
    change prod.map (datumGluingOver g Z hc i j).hom (𝟙 (datumAmb g k)) ≫
        prodMapLastTwo (datumGluingOver g Z hc j k).hom =
      prodMapFirstThird (datumGluingOver g Z hc i k).hom
    refine prod.hom_ext (prod.hom_ext ?_ ?_)
      ((cancel_mono (structureMap (covMap g k) (datumObj Z k))).mp ?_) <;>
    simp only [prod.associator_hom, prod.associator_inv, prod.braiding_hom, Category.assoc,
      prod.comp_lift, prod.comp_lift_assoc, prod.lift_fst, prod.lift_snd, prod.lift_fst_assoc,
      prod.lift_snd_assoc, prod.map_fst, prod.map_snd, prod.map_fst_assoc, prod.map_snd_assoc,
      Category.comp_id, prodMapLastTwo, prodMapFirstThird, datumGluingOver_hom_fst,
      datumGluingOver_hom_snd]

variable (hcov : Presieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (g i).left) ∈
  Scheme.fpqcPrecoverage T.left)

include hcov

/-- **The gluing clause of the fpqc sheaf property of the Hilbert functor.** A family of
degree-`d` Hilbert families over the members of an fpqc covering of `T` whose base changes to
the pairwise fibre products agree is the base change of a single degree-`d` Hilbert family
over `T`. -/
theorem exists_hilbertFamily_baseChange_eq :
    ∃ V : HilbertFamily X T d, ∀ i, baseChange X (g i) V = Z i := by
  obtain ⟨U, ⟨e⟩⟩ := AlgebraicGeometry.DescentData.isFamilyEffective_of_isClosedImmersion
    (covMap (X := X) g) (ofArrows_covMap_mem_fpqcPrecoverage g X hcov) (familyDatum g Z hc)
    fun i ↦ inferInstanceAs (IsClosedImmersion (Z i).ideal.subschemeι)
  have ecomp : ∀ i, (Over.pullback (covMap (X := X) g i)).obj U ≅ datumObj Z i :=
    fun i ↦ (AlgebraicGeometry.DescentData.evaluation
      (f := fun i ↦ covMap (X := X) g i) i).mapIso e
  have ehom : ∀ i, (ecomp i).hom.left ≫ (Z i).ideal.subschemeι =
      pullback.snd U.hom (covMap (X := X) g i) := fun i ↦ Over.w (ecomp i).hom
  have eiso : ∀ i, IsIso (ecomp i).hom.left := fun i ↦
    inferInstanceAs (IsIso ((Over.forget _).mapIso (ecomp i)).hom)
  have hU : IsClosedImmersion U.hom := by
    refine MorphismProperty.IsLocalAtTarget.of_forall_pullbackSnd
      (K := Scheme.fpqcPrecoverage) (ofArrows_covMap_mem_fpqcPrecoverage g X hcov) ?_
    rintro _ _ _ ⟨i⟩
    have := eiso i
    rw [← ehom i]
    infer_instance
  have hcomap : ∀ i, U.hom.ker.comap (covMap (X := X) g i) = (Z i).ideal := fun i ↦ by
    have := eiso i
    rw [← ker_of_isPullback (IsPullback.of_hasPullback U.hom (covMap (X := X) g i)).flip,
      ← ehom i, Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_subschemeι]
  refine ⟨⟨U.hom.ker, ?_⟩, fun i ↦ HilbertFamily.ext (by rw [baseChange_ideal, hcomap i])⟩
  refine MorphismProperty.IsLocalAtTarget.of_forall_pullbackSnd
    (P := Stacks.Morphisms.IsFiniteLocallyFreeOfRank.property d)
    (K := Scheme.fpqcPrecoverage) hcov ?_
  rintro _ _ _ ⟨i⟩
  refine (AlgebraicGeometry.prop_iff_of_isPullback
    (Stacks.Morphisms.IsFiniteLocallyFreeOfRank.property d)
    (isPullback_familyBaseChangeMap_subschemeι X (g i) U.hom.ker)
    (IsPullback.of_hasPullback _ _)).mp ?_
  rw [Stacks.Morphisms.IsFiniteLocallyFreeOfRank.property_iff, hcomap i]
  exact (Z i).isFiniteLocallyFreeOfRank

omit hc hcov in
/-- A family of Hilbert families whose base changes to the pairwise fibre products over `T`
agree satisfies the hypothesis of `Stacks.Hilbert.familyDatum`. -/
theorem comap_prod_fst_eq_comap_prod_snd
    (hb : ∀ (i j : ι) (N : Over S) (a : N ⟶ Y i) (b : N ⟶ Y j), a ≫ g i = b ≫ g j →
      baseChange X a (Z i) = baseChange X b (Z j)) (i j : ι) :
    (Z i).ideal.comap (prod.fst (X := datumAmb g i) (Y := datumAmb g j)).left =
      (Z j).ideal.comap (prod.snd (X := datumAmb g i) (Y := datumAmb g j)).left := by
  have hw : pullback.snd (g i).left (g j).left ≫ (Y j).hom =
      pullback.fst (g i).left (g j).left ≫ (Y i).hom := by
    rw [← Over.w (g j), ← Over.w (g i), ← Category.assoc, ← Category.assoc, pullback.condition]
  let N : Over S := Over.mk (pullback.fst (g i).left (g j).left ≫ (Y i).hom)
  let a : N ⟶ Y i := Over.homMk (pullback.fst (g i).left (g j).left) rfl
  let b : N ⟶ Y j := Over.homMk (pullback.snd (g i).left (g j).left) hw
  have hab : a ≫ g i = b ≫ g j := Over.OverMorphism.ext pullback.condition
  have sqab : IsPullback (familyBaseChangeMap X a) (familyBaseChangeMap X b)
      (covMap (X := X) g i) (covMap (X := X) g j) := by
    refine IsPullback.of_bot ?_ ?_ (isPullback_familyBaseChangeMap X (g j))
    · rw [(isPullback_familyBaseChangeMap X b).w, (isPullback_familyBaseChangeMap X (g i)).w]
      exact (isPullback_familyBaseChangeMap X a).paste_vert
        (IsPullback.of_hasPullback (g i).left (g j).left)
    · rw [← familyBaseChangeMap_comp, ← familyBaseChangeMap_comp, hab]
  have hP := isPullback_prod_fst_snd (W := ((Over.pullback T.hom).obj X).left)
    (datumAmb g i) (datumAmb g j)
  have key : ((Z i).ideal.comap (prod.fst (X := datumAmb g i) (Y := datumAmb g j)).left).comap
        (sqab.isoIsPullback _ _ hP).hom =
      ((Z j).ideal.comap (prod.snd (X := datumAmb g i) (Y := datumAmb g j)).left).comap
        (sqab.isoIsPullback _ _ hP).hom := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
      sqab.isoIsPullback_hom_fst _ _ hP, sqab.isoIsPullback_hom_snd _ _ hP,
      ← baseChange_ideal, ← baseChange_ideal, hb i j N a b hab]
  simpa only [← Scheme.IdealSheafData.comap_comp, Iso.inv_hom_id_assoc] using
    congrArg (fun I : ((Over.pullback N.hom).obj X).left.IdealSheafData ↦
      I.comap (sqab.isoIsPullback _ _ hP).inv) key

end Datum

/-- **Stacks Project, Tag 0B95.** The degree-`d` Hilbert functor of points of `X` over `S`
satisfies the sheaf property for the fpqc topology on the schemes over `S`. -/
@[stacks 0B95]
theorem isSheaf_fpqcTopology_hilbertFunctorOfRank {S : Scheme.{u}} (X : Over S) (d : ℕ) :
    Presheaf.IsSheaf (Scheme.fpqcTopology.over S) (hilbertFunctorOfRank X d) := by
  rw [isSheaf_iff_isSheaf_of_type,
    CategoryTheory.over_toGrothendieck_eq_toGrothendieck_comap_forget Scheme.fpqcPrecoverage S,
    Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]
  intro T R hR
  obtain ⟨ι, Y, g, rfl⟩ := R.exists_eq_ofArrows
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hR
  have hR' : Presieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (g i).left) ∈
      Scheme.fpqcPrecoverage T.left := hR
  have hdata := (Scheme.presieve₀_mem_precoverage_iff (P := @Flat)
      (⟨ι, fun i ↦ (Y i).left, fun i ↦ (g i).left⟩ : PreZeroHypercover T.left)).mp
    (Scheme.propQCPrecoverage_le_precoverage (P := @Flat) T.left hR')
  rw [← Presieve.isSeparatedFor_and_exists_isAmalgamation_iff_isSheafFor]
  refine ⟨fun x t₁ t₂ h₁ h₂ ↦ hilbertFamily_ext_of_baseChange_eq X g (fun i ↦ hdata.2 i)
    (fun t ↦ hdata.1 t) fun i ↦ (h₁ _ ⟨i⟩).trans (h₂ _ ⟨i⟩).symm, fun x hx ↦ ?_⟩
  obtain ⟨V, hV⟩ := exists_hilbertFamily_baseChange_eq g (fun i ↦ x (g i) ⟨i⟩)
    (comap_prod_fst_eq_comap_prod_snd g _ fun i j N a b hab ↦ hx a b ⟨i⟩ ⟨j⟩ hab) hR'
  exact ⟨V, fun _ _ ⟨i⟩ ↦ hV i⟩

end Stacks.Hilbert

