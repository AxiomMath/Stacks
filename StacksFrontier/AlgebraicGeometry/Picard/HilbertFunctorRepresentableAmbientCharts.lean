module

public import Mathlib.AlgebraicGeometry.ResidueField
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksFrontier.AlgebraicGeometry.NonAffineMorphism.Basic
public import StacksFrontier.AlgebraicGeometry.Scheme.Glueing.DoubledOriginNotSeparated
public import StacksFrontier.AlgebraicGeometry.Scheme.Glueing.DoubledOriginPoints

/-!
# The charts of the doubled origin, and the preimage of the punctured base

Affine `n`-space with its origin doubled is covered by its two affine charts, and the coordinate
morphism restricts to the identity on each of them. This file identifies the preimage of the
punctured base — affine `n`-space with the origin removed — under the coordinate morphism with
the overlap of the two charts.

The two inclusions agree exactly over the punctured base: away from the origin the gluing
identifies the two copies, so a point of the punctured base has a single preimage, lying in both
chart ranges; over the origin the two chart origins stay distinct, so neither lies in the range
of the other chart.

## Main results

* `AlgebraicGeometry.preimage_puncturedAffineSpace_coordinateMorphism` — the preimage of the
  punctured base under the coordinate morphism is the intersection of the two chart ranges.
* `AlgebraicGeometry.puncturedAffineSpace_one` — in dimension one the punctured base is the
  standard open of the single coordinate.

That the two charts cover is `AlgebraicGeometry.iSup_opensRange_chartInclusion`, already
available from `StacksFrontier.AlgebraicGeometry.NonAffineMorphism.Basic`.

## Implementation notes

Both inclusions `≤` and `≥` reduce to the pointwise behaviour of the coordinate morphism on a
chart, `coordinateMorphism_chartInclusion_apply`, which is `coordinateMorphismData` read at a
point.

For `≥` the only input beyond that is `AlgebraicGeometry.chartInclusion_origin_ne`: a point of
the overlap whose image missed the punctured base would be the origin, and the two chart origins
are distinct. Identifying it as the origin is the one piece of algebra here — a prime of the
polynomial ring containing every coordinate contains the kernel of `MvPolynomial.constantCoeff`,
which is maximal because that homomorphism is surjective onto the field.

For `≤` the point is lifted along `AlgebraicGeometry.comp_chartInclusion_eq` applied to
`AlgebraicGeometry.Scheme.fromSpecResidueField`, whose range is the single point, so the two
chart inclusions agree there and the point lies in both chart ranges.

## References

* [Stacks Project, Tag 01JD](https://stacks.math.columbia.edu/tag/01JD)
-/

@[expose] public section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

section Helpers

/-- The coordinate morphism undoes a chart inclusion on points: the two composites are the
identity by `AlgebraicGeometry.coordinateMorphismData`. -/
private theorem coordinateMorphism_chartInclusion_apply (k : Type u) [Field k] (n : ℕ)
    (i : Fin 2) (a : Spec (.of (MvPolynomial (Fin n) k))) :
    coordinateMorphism k n (chartInclusion k n i a) = a := by
  have h := congrArg
    (fun g : Spec (.of (MvPolynomial (Fin n) k)) ⟶ Spec (.of (MvPolynomial (Fin n) k)) => g a)
    ((coordinateMorphismData k n).property i)
  simpa [Scheme.Hom.comp_apply] using h

/-- The kernel of `MvPolynomial.constantCoeff` is generated by the coordinates. -/
private theorem ker_constantCoeff_eq_span (k : Type u) [Field k] (n : ℕ) :
    RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin n) k →+* k) =
      Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) k)) := by
  ext p
  rw [RingHom.mem_ker, ← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  refine ⟨fun hp m hm ↦ ?_, fun hp ↦ ?_⟩
  · by_contra h
    obtain rfl : m = 0 := by
      refine Finsupp.ext fun i ↦ ?_
      by_contra hi
      exact h ⟨i, Set.mem_univ i, hi⟩
    exact (MvPolynomial.mem_support_iff.mp hm) (by simpa [MvPolynomial.constantCoeff] using hp)
  · by_contra hp0
    obtain ⟨i, -, hi0⟩ := hp 0 (MvPolynomial.mem_support_iff.mpr
      (by simpa [MvPolynomial.constantCoeff] using hp0))
    exact hi0 (by simp)

/-- **A point of affine space outside the punctured base is the origin**: its prime ideal
contains every coordinate, hence the maximal ideal of the origin. -/
theorem eq_affineOrigin_of_notMem_puncturedAffineSpace (k : Type u) [Field k] (n : ℕ)
    {x : Spec (.of (MvPolynomial (Fin n) k))} (hx : x ∉ puncturedAffineSpace k n) :
    x = affineOrigin k n := by
  have hxi : ∀ i : Fin n, (MvPolynomial.X i : MvPolynomial (Fin n) k) ∈ x.asIdeal := fun i ↦ by
    by_contra hnot
    exact hx (Opens.mem_iSup.mpr
      ⟨i, (PrimeSpectrum.mem_basicOpen (MvPolynomial.X i) x).mpr hnot⟩)
  have hle : (affineOrigin k n).asIdeal ≤ x.asIdeal := by
    rw [show (affineOrigin k n).asIdeal =
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin n) k →+* k) from rfl,
      ker_constantCoeff_eq_span k n, Ideal.span_le, Set.range_subset_iff]
    exact hxi
  have hmax : (affineOrigin k n).asIdeal.IsMaximal :=
    RingHom.ker_isMaximal_of_surjective
      (MvPolynomial.constantCoeff : MvPolynomial (Fin n) k →+* k)
      fun a ↦ ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C (Fin n) a⟩
  exact PrimeSpectrum.ext (hmax.eq_of_le x.2.ne_top hle).symm

/-- Over the punctured base the two chart inclusions agree on points: the inclusion of the
residue field of such a point has range that single point, so
`AlgebraicGeometry.comp_chartInclusion_eq` applies to it. -/
private theorem chartInclusion_apply_eq_of_mem_puncturedAffineSpace (k : Type u) [Field k]
    (n : ℕ) {a : Spec (.of (MvPolynomial (Fin n) k))} (ha : a ∈ puncturedAffineSpace k n) :
    chartInclusion k n 0 a = chartInclusion k n 1 a := by
  set g := (Spec (.of (MvPolynomial (Fin n) k))).fromSpecResidueField a
  have hrange : Set.range g.base = {a} := Scheme.range_fromSpecResidueField a
  have hsub : Set.range g.base ⊆ (puncturedAffineSpace k n : Set _) := by
    rw [hrange]
    simpa using ha
  obtain ⟨s, hs⟩ : a ∈ Set.range g.base := by rw [hrange]; rfl
  have h := congrArg
    (fun f : Spec ((Spec (.of (MvPolynomial (Fin n) k))).residueField a) ⟶
      affineSpaceWithDoubledZero k n => f s) (comp_chartInclusion_eq k n g hsub)
  simpa [Scheme.Hom.comp_apply, hs] using h

end Helpers

/-- **Stacks Project, Tag 01JD.** The preimage of the punctured affine space under the
coordinate morphism of affine space with doubled origin is the overlap of the two charts. -/
theorem preimage_puncturedAffineSpace_coordinateMorphism (k : Type u) [Field k] (n : ℕ) :
    coordinateMorphism k n ⁻¹ᵁ puncturedAffineSpace k n =
      (chartInclusion k n 0).opensRange ⊓ (chartInclusion k n 1).opensRange := by
  refine le_antisymm (fun x hx ↦ ?_) (fun x hx ↦ ?_)
  · obtain ⟨⟨i⟩, a, rfl⟩ := (doubledZeroGlueData k n).ι_jointly_surjective x
    have ha : a ∈ puncturedAffineSpace k n := by
      rwa [← coordinateMorphism_chartInclusion_apply k n i a]
    have hagree := chartInclusion_apply_eq_of_mem_puncturedAffineSpace k n ha
    refine ⟨⟨a, ?_⟩, ⟨a, ?_⟩⟩ <;> fin_cases i
    · rfl
    · exact hagree
    · exact hagree.symm
    · rfl
  · obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hx
    obtain rfl : a = b := by
      rw [← coordinateMorphism_chartInclusion_apply k n 0 a,
        ← coordinateMorphism_chartInclusion_apply k n 1 b, ha, hb]
    show coordinateMorphism k n x ∈ puncturedAffineSpace k n
    rw [← ha, coordinateMorphism_chartInclusion_apply k n 0 a]
    by_contra hna
    rw [eq_affineOrigin_of_notMem_puncturedAffineSpace k n hna] at ha hb
    exact chartInclusion_origin_ne k n (ha.trans hb.symm)

/-- In dimension one the punctured affine space is the standard open of the single
coordinate. -/
theorem puncturedAffineSpace_one (k : Type u) [Field k] :
    puncturedAffineSpace k 1 = PrimeSpectrum.basicOpen (MvPolynomial.X (0 : Fin 1)) :=
  iSup_unique _

end AlgebraicGeometry

end
