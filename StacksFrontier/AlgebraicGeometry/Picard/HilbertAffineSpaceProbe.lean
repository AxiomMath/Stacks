module

public import Mathlib.AlgebraicGeometry.AffineSpace
public import StacksFrontier.AlgebraicGeometry.Picard.HilbertFunctorFpqcSheaf
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.AffineTarget
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.Module

/-!
# Closed subschemes of an affine space over an affine test scheme

Let `S` be a scheme and `n` a type. For a ring `A` and a morphism `s : Spec A ⟶ S`, the base change
of the affine space `𝔸(n; S)` to `Spec A` is the spectrum of `A[x_i; i ∈ n]`. Its closed subschemes
therefore correspond bijectively to ideals `J ⊂ A[x_i]`, and such a closed subscheme is finite
locally free of rank `d` over `Spec A` exactly when `A[x_i] ⧸ J` is a finite locally free
`A`-module of rank `d`. This correspondence is compatible with base change along ring maps `A ⟶ B`.
It is the translation the source's proof of [Stacks, Tag 0B99] uses implicitly when it works
with `Spec(B) ⊂ X_T` for an affine `T = Spec(A)`.

## Main definitions

* `Stacks.Hilbert.AffineSpaceProbe.polyHom`: the comparison map `A[x_i] → Γ(𝔸(n; S) ×_S Spec A)`.
* `Stacks.Hilbert.AffineSpaceProbe.polyEquiv`: `polyHom` as a ring isomorphism.
* `Stacks.Hilbert.AffineSpaceProbe.probeIdeal`: the ideal of `A[x_i]` of a closed subscheme.

## Main results

* `Stacks.Hilbert.AffineSpaceProbe.polyHom_bijective`: the comparison map is bijective.
* `Stacks.Hilbert.AffineSpaceProbe.probeIdeal_injective`,
  `Stacks.Hilbert.AffineSpaceProbe.probeIdeal_surjective`: closed subschemes correspond bijectively
  to ideals of `A[x_i]`.
* `Stacks.Hilbert.AffineSpaceProbe.isFiniteLocallyFreeOfRank_subschemeι_iff`: a closed subscheme is
  finite locally free of rank `d` over `Spec A` if and only if the quotient of `A[x_i]` by its
  ideal is a finite locally free `A`-module of rank `d`.
* `Stacks.Hilbert.AffineSpaceProbe.probeIdeal_comap`: base change along `Spec B ⟶ Spec A`
  corresponds to extension of ideals along `A[x_i] → B[x_i]`.
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_eq_ofIdealTop_of_isAffine`: the pullback of an
  ideal sheaf along a morphism of affine schemes is generated by the image of its global ideal.

## References

* [Stacks Project, Tag 0B99](https://stacks.math.columbia.edu/tag/0B99)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MvPolynomial Opposite

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- The global ideal of `ofIdealTop J` on an affine scheme is `J`. -/
private theorem ideal_ofIdealTop_top {X : Scheme.{u}} [IsAffine X] (J : Ideal Γ(X, ⊤)) :
    (ofIdealTop J).ideal ⟨⊤, isAffineOpen_top X⟩ = J :=
  (equivOfIsAffine (X := X)).apply_symm_apply J

/-- **The pullback of an ideal sheaf along a morphism of affine schemes** is the ideal sheaf of the
extension of its global ideal. -/
theorem comap_eq_ofIdealTop_of_isAffine {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (I : Y.IdealSheafData) (f : X ⟶ Y) :
    I.comap f = ofIdealTop ((I.ideal ⟨⊤, isAffineOpen_top Y⟩).map f.appTop.hom) := by
  have htop (K : X.IdealSheafData) : (K.map f).ideal ⟨⊤, isAffineOpen_top Y⟩ =
      (K.ideal ⟨⊤, isAffineOpen_top X⟩).comap f.appTop.hom :=
    ideal_map_of_isAffineHom K f ⟨⊤, isAffineOpen_top Y⟩
  apply le_antisymm
  · rw [← le_map_iff_comap_le]
    apply le_of_isAffine
    rw [htop, ideal_ofIdealTop_top]
    exact Ideal.le_comap_map
  · apply le_of_isAffine
    rw [ideal_ofIdealTop_top, Ideal.map_le_iff_le_comap, ← htop]
    exact (le_map_comap I f) ⟨⊤, isAffineOpen_top Y⟩

end AlgebraicGeometry.Scheme.IdealSheafData

namespace Stacks.Hilbert.AffineSpaceProbe

variable {S : Scheme.{u}} (n : Type u)

/-- The affine space over `S`, as a scheme over `S`. -/
abbrev ambient : Over S := Over.mk (𝔸(n; S) ↘ S)

section Probe

variable {A : CommRingCat.{u}} (s : Spec A ⟶ S)

/-- The base change of the affine space over `S` along `Spec A ⟶ S` is affine. -/
instance isAffine_pullback : IsAffine (pullback (𝔸(n; S) ↘ S) s) :=
  isAffine_of_isAffineHom (pullback.snd (𝔸(n; S) ↘ S) s)

/-- The comparison map from the polynomial ring over `A` to the global sections of the base change
of the affine space to `Spec A`. -/
def polyHom : MvPolynomial n A →+* Γ(pullback (𝔸(n; S) ↘ S) s, ⊤) :=
  eval₂Hom ((Scheme.ΓSpecIso A).inv ≫ (pullback.snd (𝔸(n; S) ↘ S) s).appTop).hom
    (fun i ↦ (pullback.fst (𝔸(n; S) ↘ S) s).appTop (AffineSpace.coord S i))

/-- `polyHom` sends a constant `a` to the pullback of `a` along the projection to `Spec A`. -/
@[simp]
theorem polyHom_C (a : A) :
    polyHom n s (C a) = (pullback.snd (𝔸(n; S) ↘ S) s).appTop ((Scheme.ΓSpecIso A).inv a) :=
  eval₂Hom_C _ _ _

/-- `polyHom` sends the variable `X i` to the pullback of the `i`-th coordinate function. -/
@[simp]
theorem polyHom_X (i : n) :
    polyHom n s (X i) = (pullback.fst (𝔸(n; S) ↘ S) s).appTop (AffineSpace.coord S i) :=
  eval₂Hom_X' _ _ _

/-- The comparison map `polyHom` is bijective. -/
theorem polyHom_bijective : Function.Bijective (polyHom n s) := by
  let h := (AffineSpace.isPullback_map (n := n) s).isoPullback
  have key : h.hom.appTop.hom.comp (polyHom n s) =
      ((Scheme.ΓSpecIso _).inv ≫ (AffineSpace.SpecIso n A).hom.appTop).hom := by
    rw [AffineSpace.SpecIso_hom_appTop, Iso.inv_hom_id_assoc, CommRingCat.hom_ofHom]
    apply MvPolynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply, polyHom_C, eval₂Hom_C, ← CommRingCat.comp_apply,
        ← Scheme.Hom.comp_appTop, IsPullback.isoPullback_hom_snd]
      rfl
    · intro i
      rw [RingHom.comp_apply, polyHom_X, eval₂Hom_X', ← CommRingCat.comp_apply,
        ← Scheme.Hom.comp_appTop, IsPullback.isoPullback_hom_fst, AffineSpace.map_appTop_coord]
  have : IsIso h.hom.appTop := inferInstanceAs (IsIso (Scheme.Γ.map h.hom.op))
  have : IsIso (AffineSpace.SpecIso n A).hom.appTop :=
    inferInstanceAs (IsIso (Scheme.Γ.map (AffineSpace.SpecIso n A).hom.op))
  have hiso : Function.Bijective h.hom.appTop.hom := ConcreteCategory.bijective_of_isIso _
  have hc : Function.Bijective (h.hom.appTop.hom.comp (polyHom n s)) := by
    rw [key]
    exact ConcreteCategory.bijective_of_isIso _
  exact (Function.Bijective.of_comp_iff' hiso _).mp hc

/-- `polyHom` as a ring isomorphism. -/
def polyEquiv : MvPolynomial n A ≃+* Γ(pullback (𝔸(n; S) ↘ S) s, ⊤) :=
  RingEquiv.ofBijective (polyHom n s) (polyHom_bijective n s)

/-- `polyEquiv` acts as `polyHom`. -/
@[simp]
theorem polyEquiv_apply (p : MvPolynomial n A) : polyEquiv n s p = polyHom n s p := rfl

/-- The ideal of `A[x_i]` cutting out a closed subscheme of the base change of the affine space to
`Spec A`. -/
def probeIdeal (I : (pullback (𝔸(n; S) ↘ S) s).IdealSheafData) : Ideal (MvPolynomial n A) :=
  (I.ideal ⟨⊤, isAffineOpen_top _⟩).comap (polyHom n s)

/-- A closed subscheme of the base change of the affine space to `Spec A` is determined by its
ideal in `A[x_i]`. -/
theorem probeIdeal_injective : Function.Injective (probeIdeal n s) := by
  intro I I' h
  apply Scheme.IdealSheafData.ext_of_isAffine
  have hm := congrArg (Ideal.map (polyHom n s)) h
  simp only [probeIdeal] at hm
  rwa [Ideal.map_comap_of_surjective _ (polyHom_bijective n s).2,
    Ideal.map_comap_of_surjective _ (polyHom_bijective n s).2] at hm

/-- Every ideal of `A[x_i]` is the ideal of a closed subscheme of the base change of the affine
space to `Spec A`. -/
theorem probeIdeal_surjective : Function.Surjective (probeIdeal n s) := by
  intro J
  refine ⟨Scheme.IdealSheafData.ofIdealTop (J.map (polyHom n s)), ?_⟩
  rw [probeIdeal, Scheme.IdealSheafData.ideal_ofIdealTop_top]
  exact Ideal.comap_map_of_bijective _ (polyHom_bijective n s)

/-- **Finite local freeness of a closed subscheme of the affine space over `Spec A`** is finite
local freeness of the quotient of `A[x_i]` by its ideal. -/
theorem isFiniteLocallyFreeOfRank_subschemeι_iff
    (I : (pullback (𝔸(n; S) ↘ S) s).IdealSheafData) (d : ℕ) :
    Stacks.Morphisms.IsFiniteLocallyFreeOfRank (I.subschemeι ≫ pullback.snd _ _) d ↔
      Module.IsFiniteLocallyFreeOfRank A (MvPolynomial n A ⧸ probeIdeal n s I) d := by
  let g := I.subschemeι ≫ pullback.snd (𝔸(n; S) ↘ S) s
  let : Algebra A Γ(I.subscheme, ⊤) := ((Scheme.ΓSpecIso A).inv ≫ g.appTop).hom.toAlgebra
  rw [Stacks.Morphisms.isFiniteLocallyFreeOfRank_iff, and_iff_right (inferInstance :
    IsAffineHom g), Stacks.Morphisms.sheafOfModules_isFiniteLocallyFreeOfRank_iff_module g d]
  let ψ : MvPolynomial n A →ₐ[A] Γ(I.subscheme, ⊤) :=
    { toRingHom := I.subschemeι.appTop.hom.comp (polyHom n s)
      commutes' := fun a ↦ by
        change I.subschemeι.appTop (polyHom n s (C a)) = _
        rw [polyHom_C]
        change _ = ((Scheme.ΓSpecIso A).inv ≫ g.appTop) a
        simp only [g, Scheme.Hom.comp_appTop, CommRingCat.comp_apply] }
  have hsurj : Function.Surjective ψ :=
    (I.subschemeι_app_surjective ⟨⊤, isAffineOpen_top _⟩).comp (polyHom_bijective n s).2
  have hker : RingHom.ker ψ.toRingHom = probeIdeal n s I := by
    change RingHom.ker (I.subschemeι.appTop.hom.comp (polyHom n s)) = _
    rw [← RingHom.comap_ker]
    exact congrArg (Ideal.comap (polyHom n s)) (I.ker_subschemeι_app ⟨⊤, isAffineOpen_top _⟩)
  let e : (MvPolynomial n A ⧸ probeIdeal n s I) ≃ₐ[A] Γ(I.subscheme, ⊤) :=
    (Ideal.quotientEquivAlgOfEq A hker.symm).trans (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  exact ⟨fun h ↦ h.of_linearEquiv e.symm.toLinearEquiv, fun h ↦ h.of_linearEquiv e.toLinearEquiv⟩

end Probe

section BaseChange

variable {A B : CommRingCat.{u}} (s : Spec A ⟶ S) (φ : A ⟶ B)

/-- The base-change map from the affine space over `Spec B` to the affine space over `Spec A`. -/
abbrev probeMap :
    pullback (𝔸(n; S) ↘ S) (Spec.map φ ≫ s) ⟶ pullback (𝔸(n; S) ↘ S) s :=
  pullback.map _ _ _ _ (𝟙 _) (Spec.map φ) (𝟙 _) (by simp) (by simp)

/-- The comparison maps `polyHom` commute with base change: on global sections, `probeMap` after
`polyHom` over `A` is `polyHom` over `B` after `MvPolynomial.map φ`. -/
theorem probeMap_appTop_polyHom :
    (probeMap n s φ).appTop.hom.comp (polyHom n s) =
      (polyHom n (Spec.map φ ≫ s)).comp (MvPolynomial.map φ.hom) := by
  apply MvPolynomial.ringHom_ext
  · intro a
    simp only [RingHom.comp_apply, polyHom_C, map_C]
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, pullback.lift_snd,
      Scheme.Hom.comp_appTop, CommRingCat.comp_apply, ← CommRingCat.comp_apply
        (Scheme.ΓSpecIso A).inv, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
  · intro i
    simp only [RingHom.comp_apply, polyHom_X, map_X]
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, pullback.lift_fst,
      Category.comp_id]

/-- **Base change of a closed subscheme is extension of its ideal.** -/
theorem probeIdeal_comap (I : (pullback (𝔸(n; S) ↘ S) s).IdealSheafData) :
    probeIdeal n (Spec.map φ ≫ s) (I.comap (probeMap n s φ)) =
      (probeIdeal n s I).map (MvPolynomial.map φ.hom) := by
  have hI : I.ideal ⟨⊤, isAffineOpen_top _⟩ = (probeIdeal n s I).map (polyHom n s) :=
    (Ideal.map_comap_of_surjective _ (polyHom_bijective n s).2 _).symm
  rw [probeIdeal, Scheme.IdealSheafData.comap_eq_ofIdealTop_of_isAffine]
  rw [Scheme.IdealSheafData.ideal_ofIdealTop_top, hI]
  change Ideal.comap (polyHom n (Spec.map φ ≫ s)) (Ideal.map (probeMap n s φ).appTop.hom
    (Ideal.map (polyHom n s) (probeIdeal n s I))) = _
  rw [Ideal.map_map, probeMap_appTop_polyHom, ← Ideal.map_map]
  exact Ideal.comap_map_of_bijective _ (polyHom_bijective n _)

end BaseChange

end Stacks.Hilbert.AffineSpaceProbe

end
