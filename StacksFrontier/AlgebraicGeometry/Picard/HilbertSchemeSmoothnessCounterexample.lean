module

public import Mathlib.Data.ZMod.Basic
public import StacksFrontier.AlgebraicGeometry.Picard.HilbertSchemeDoubledLineRepresentable
public import StacksFrontier.AlgebraicGeometry.Picard.HilbertSchemeSmoothness

/-!
# The Hilbert schemes of points of a non-separated smooth curve need not be smooth

Stacks Tag 0B9H asserts that for a smooth morphism `X ⟶ S` of relative dimension one all of whose
Hilbert functors of points `Hilb^d_{X/S}` are representable, the representing schemes are smooth
over `S` of relative dimension `d`. This file shows that the statement fails without a
separation hypothesis on `X ⟶ S`.

## The counterexample

Let `A = ∏_{n ∈ ℕ} 𝔽₂`, `S = Spec A`, `eₙ ∈ A` the coordinate idempotents, `S' = ⋃ₙ D(eₙ)` and
`Z = Spec(A ⧸ (eₙ)ₙ)`, a closed subscheme with underlying set `S ∖ S'`. Let `X` be two copies of
`𝔸¹_S` glued along `𝔸¹_{S'}`. Then `X ⟶ S` is smooth of relative dimension one. For every
`S`-scheme `T` and every degree-`d` family `D ⊆ X_T` with `d ≥ 1`, the inverse image `T'` of `S'`
in `T` is open and closed, and over `T ∖ T'` the morphism `T ⟶ S` factors through `Z` (an
idempotent function vanishing at every point is zero). Hence

  `Hilb^d_{X/S} = 𝔸^d_{S'} ⊔ ∐_{a + b = d} (𝔸^a × 𝔸^b)_Z`,

using that `Hilb^d` of the affine line is affine `d`-space (monic polynomials of degree `d`) and
that over `Z` the scheme `X` is the disjoint union of two affine lines. But `Z` has empty interior
in `S`, so the open pieces over `Z` cannot have open image in `S`, and a smooth morphism is open.
So `Hilb^d_{X/S}` is not smooth over `S` for any `d ≥ 1`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Stacks.Hilbert.NonSeparated

/-! ### The base -/

/-- The ring `∏_{n ∈ ℕ} 𝔽₂`. -/
abbrev baseRing : Type u := ULift.{u} ℕ → ZMod 2

/-- The base `S = Spec ∏_{n ∈ ℕ} 𝔽₂`. -/
abbrev base : Scheme.{u} := Spec (CommRingCat.of baseRing.{u})

/-- The coordinate idempotents of `∏_{n ∈ ℕ} 𝔽₂`. -/
def idem (n : ULift.{u} ℕ) : baseRing.{u} := Pi.single n 1

/-- The coordinate idempotents are idempotent. -/
private theorem isIdempotentElem_idem (n : ULift.{u} ℕ) : IsIdempotentElem (idem n) := by
  unfold IsIdempotentElem
  ext m
  by_cases h : m = n <;> simp [idem, h]

/-- The open subscheme `S' = ⋃ₙ D(eₙ)`. -/
def overlap : base.{u}.Opens := ⨆ n, PrimeSpectrum.basicOpen (idem n)

/-- The ideal generated by the coordinate idempotents. -/
def idealI : Ideal baseRing.{u} := Ideal.span (Set.range idem)

/-- The closed subscheme `Z = Spec (A ⧸ (eₙ)ₙ)`. -/
abbrev closedPart : Scheme.{u} := Spec (CommRingCat.of (baseRing.{u} ⧸ idealI))

/-- The inclusion of `Z` into `S`. -/
def closedι : closedPart.{u} ⟶ base.{u} :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk idealI))

/-- The inclusion `Z ⟶ S` is a closed immersion. -/
instance : IsClosedImmersion closedι.{u} :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- A point of `S` lies in `S'` iff some coordinate idempotent `eₙ` is not in its prime. -/
theorem mem_overlap {x : base.{u}} : x ∈ overlap ↔ ∃ n, idem n ∉ x.asIdeal :=
  TopologicalSpace.Opens.mem_iSup.trans (exists_congr fun _ ↦ PrimeSpectrum.mem_basicOpen _ _)

/-- No point of `Z` maps into `S'`. -/
theorem closedι_not_mem (z : closedPart.{u}) : closedι z ∉ overlap := by
  rw [mem_overlap]
  rintro ⟨n, hn⟩
  apply hn
  have h : Ideal.Quotient.mk idealI (idem n) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self n))
  change idem n ∈ Ideal.comap (Ideal.Quotient.mk idealI) _
  rw [Ideal.mem_comap, h]
  exact Ideal.zero_mem _

/-- An idempotent function on a scheme whose basic open is empty vanishes. -/
theorem eq_zero_of_isIdempotentElem {T : Scheme.{u}} {s : Γ(T, ⊤)} (hs : IsIdempotentElem s)
    (h : T.basicOpen s = ⊥) : s = 0 := by
  refine TopCat.Presheaf.section_ext T.sheaf ⊤ s 0 fun x hx ↦ ?_
  have hnu : ¬ IsUnit (T.presheaf.germ ⊤ x hx s) := fun hu ↦ by
    simpa [h] using (T.mem_basicOpen s x hx).mpr hu
  rw [map_zero]
  have hmul : T.presheaf.germ ⊤ x hx s * (1 - T.presheaf.germ ⊤ x hx s) = 0 := by
    rw [mul_sub, mul_one, (hs.map _ : IsIdempotentElem (T.presheaf.germ ⊤ x hx s)).eq, sub_self]
  exact ((IsLocalRing.isUnit_or_isUnit_one_sub_self _).resolve_left hnu).mul_left_eq_zero.mp hmul

/-- **A morphism to `S` missing `S'` factors through `Z`.** The coordinate idempotents pull back
to idempotent functions vanishing at every point, which are zero. -/
theorem exists_factor_closedι {T : Scheme.{u}} (f : T ⟶ base.{u}) (hf : ∀ t, f t ∉ overlap) :
    ∃ g : T ⟶ closedPart.{u}, g ≫ closedι = f := by
  let φ : baseRing.{u} →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso _).inv ≫ f.appTop).hom
  have hφ : ∀ n, φ (idem n) = 0 := by
    intro n
    refine eq_zero_of_isIdempotentElem ((isIdempotentElem_idem n).map φ) ?_
    refine eq_bot_iff.mpr fun t ht ↦ hf t (mem_overlap.mpr ⟨n, ?_⟩)
    have : t ∈ f ⁻¹ᵁ (base.{u}.basicOpen ((Scheme.ΓSpecIso _).inv (idem n))) := by
      rwa [Scheme.preimage_basicOpen_top]
    rw [basicOpen_eq_of_affine] at this
    exact (PrimeSpectrum.mem_basicOpen _ _).mp this
  have hI : idealI.{u} ≤ RingHom.ker φ := Ideal.span_le.mpr (Set.range_subset_iff.mpr hφ)
  refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.lift _ φ hI)), ?_⟩
  have hf' : f = T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso _).inv ≫ f.appTop) := by
    rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  rw [hf', Category.assoc, closedι, ← Spec.map_comp]
  congr 2

/-- The basic open of a coordinate idempotent is nonempty. -/
private theorem basicOpen_idem_ne_bot (n : ULift.{u} ℕ) : PrimeSpectrum.basicOpen (idem n) ≠ ⊥ := by
  rw [Ne, PrimeSpectrum.basicOpen_eq_bot_iff]
  rintro ⟨k, hk⟩
  have : idem n ^ k = idem n := by
    rcases k with _ | k
    · simp at hk
    · exact (isIdempotentElem_idem n).pow_succ_eq k
  rw [this] at hk
  simpa [idem] using congrFun hk n

/-- **`S'` is dense in `S`.** Every nonempty open of `S` meets `S'`. -/
theorem exists_mem_overlap (U : base.{u}.Opens) (x : base.{u}) (hx : x ∈ U) :
    ∃ y ∈ U, y ∈ overlap := by
  obtain ⟨_, ⟨_, ⟨a, rfl⟩, rfl⟩, hxa, haU⟩ :=
    PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open hx U.2
  have ha : a ≠ 0 := by
    rintro rfl
    exact (PrimeSpectrum.mem_basicOpen (0 : baseRing.{u}) x).mp hxa (Ideal.zero_mem _)
  obtain ⟨n, hn⟩ : ∃ n, a n ≠ 0 := Function.ne_iff.mp ha
  have han : a n = 1 := by
    revert hn
    generalize a n = z
    decide +revert
  have hmul : a * idem n = idem n := by
    ext m
    by_cases hm : m = n <;> simp [idem, hm, han]
  have hne : PrimeSpectrum.basicOpen (a * idem n) ≠ ⊥ := by
    rw [hmul]
    exact basicOpen_idem_ne_bot n
  obtain ⟨y, hy⟩ := Set.nonempty_iff_ne_empty.mpr fun h ↦
    hne (TopologicalSpace.Opens.coe_eq_empty.mp h)
  rw [PrimeSpectrum.basicOpen_mul] at hy
  exact ⟨y, haU hy.1, TopologicalSpace.Opens.mem_iSup.mpr ⟨n, hy.2⟩⟩

/-- The finitely supported functions form an ideal of `∏_{n ∈ ℕ} 𝔽₂` containing the coordinate
idempotents. -/
def finiteSupportIdeal : Ideal baseRing.{u} where
  carrier := {f | (Function.support f).Finite}
  add_mem' {f g} hf hg := (hf.union hg).subset (Function.support_add f g)
  zero_mem' := by simp
  smul_mem' c {f} hf := hf.subset (by
    intro n hn
    simp only [Function.mem_support, smul_eq_mul, Pi.mul_apply] at hn ⊢
    exact right_ne_zero_of_mul hn)

/-- The ideal generated by the coordinate idempotents is proper. -/
theorem idealI_ne_top : idealI.{u} ≠ ⊤ := by
  intro h
  have hle : idealI.{u} ≤ finiteSupportIdeal := by
    rw [idealI, Ideal.span_le]
    rintro _ ⟨n, rfl⟩
    exact (Set.finite_singleton n).subset Pi.support_single_subset
  have h1 : (1 : baseRing.{u}) ∈ finiteSupportIdeal := hle (h ▸ Submodule.mem_top)
  change (Function.support (1 : baseRing.{u})).Finite at h1
  rw [Function.support_one] at h1
  exact Set.infinite_univ (α := ULift.{u} ℕ) h1

/-- The closed subscheme `Z` is nonempty. -/
instance : Nonempty closedPart.{u} := by
  have : Nontrivial (baseRing.{u} ⧸ idealI) := Ideal.Quotient.nontrivial_iff.mpr idealI_ne_top
  exact inferInstanceAs (Nonempty (PrimeSpectrum _))

/-! ### The counterexample -/

open DoubledLine

/-- **The curve `X`**: two copies of `𝔸¹_S` glued along `𝔸¹_{S'}`. -/
abbrev curve : Over base.{u} := doubledLine overlap

/-- The curve `X` is smooth of relative dimension one over `S`. -/
instance : SmoothOfRelativeDimension 1 curve.{u}.hom :=
  smoothOfRelativeDimension_doubledLine overlap

/-- The representing schemes of the Hilbert functors of points of `X`. -/
def hilbertSchemes : ℕ → Over base.{u}
  | 0 => Over.mk (𝟙 base.{u})
  | d + 1 => hilb overlap closedι (d + 1)

/-- **Every Hilbert functor of points of `X` is representable.** -/
def representsHilbertSchemes :
    ∀ d, RepresentsHilbertFunctorOfRank curve.{u} (hilbertSchemes d) d
  | 0 => representsHilbertFunctorOfRankZero curve
  | d + 1 => DoubledLine.representsHilbertFunctorOfRank overlap closedι
      exists_factor_closedι closedι_not_mem (d + 1) (Nat.succ_pos d)

/-- **No Hilbert scheme of points of `X` of positive degree is smooth over `S`.** -/
theorem not_smooth_hilbertSchemes (d : ℕ) (hd : 0 < d) : ¬ Smooth (hilbertSchemes.{u} d).hom := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hd
  exact not_smooth_hilb overlap closedι closedι_not_mem exists_mem_overlap _

/-- **A counterexample to Stacks Tag 0B9H without separatedness.** There is a smooth morphism
`X ⟶ S` of relative dimension one all of whose Hilbert functors of points are representable, such
that none of the representing schemes of positive degree is smooth over `S`. -/
theorem exists_not_smooth_hilbertScheme :
    ∃ (S : Scheme.{u}) (X : Over S), SmoothOfRelativeDimension 1 X.hom ∧
      ∃ H : ℕ → Over S, Nonempty (∀ d, RepresentsHilbertFunctorOfRank X (H d) d) ∧
        ∀ d, 0 < d → ¬ Smooth (H d).hom :=
  ⟨base, curve, inferInstance, hilbertSchemes, ⟨representsHilbertSchemes⟩,
    not_smooth_hilbertSchemes⟩

/-- **Stacks Project, Tag 0B9H, as printed, is false.** The statement "for a smooth morphism of
schemes `X ⟶ S` of relative dimension `1` such that the functors `Hilb^d_{X/S}` are representable,
the schemes `Hilb^d_{X/S}` are smooth over `S` of relative dimension `d`" fails without a
separation hypothesis on `X ⟶ S`: for `S = Spec ∏_{n ∈ ℕ} 𝔽₂` and `X` two copies of `𝔸¹_S` glued
along the inverse image of the dense open `⋃ₙ D(eₙ)`, every `Hilb^d_{X/S}` is representable and
none with `d ≥ 1` is smooth. The tag holds for a separated `X ⟶ S`:
`Stacks.Hilbert.smoothOfRelativeDimension_of_represents`. -/
@[stacks 0B9H "the statement as printed is false: without separatedness of X → S it fails \
(this is the negation of the printed statement); the separated case is \
Stacks.Hilbert.smoothOfRelativeDimension_of_represents"]
theorem not_forall_smoothOfRelativeDimension_of_represents :
    ¬ ∀ (S : Scheme.{u}) (X : Over S) [SmoothOfRelativeDimension 1 X.hom] (H : ℕ → Over S),
      (∀ d, RepresentsHilbertFunctorOfRank X (H d) d) →
        ∀ d, SmoothOfRelativeDimension d (H d).hom := fun h ↦
  not_smooth_hilbertSchemes 1 one_pos
    (h base.{u} curve hilbertSchemes representsHilbertSchemes 1).smooth

/-- **Stacks Project, Tag 0B9H, as printed, is false: the concrete counterexample.**

The tag reads: "Let `X → S` be a smooth morphism of schemes of relative dimension `1` such that
the functors `Hilb^d_{X/S}` are representable. The schemes `Hilb^d_{X/S}` are smooth over `S` of
relative dimension `d`." This theorem exhibits `S`, `X` and the failure, with every degree
`d ≥ 1` failing.

* `S = Spec A` with `A = ∏_{n ∈ ℕ} 𝔽₂` (the ring `ULift ℕ → ZMod 2`).
* `S' = ⋃ₙ D(eₙ) ⊆ S`, where `eₙ = Pi.single n 1` is the `n`-th coordinate idempotent; `S'` is a
  dense open whose complement `V((eₙ)ₙ)` is nonempty.
* `X = Stacks.Hilbert.DoubledLine.doubledLine S'`: two copies of `𝔸¹_S` glued along `𝔸¹_{S'}`,
  that is, the total space of `Stacks.Examples.doubleSectionCover 𝔸¹_S 𝔸¹_{S'}`, covered by two
  open charts `𝔸¹_S ⟶ X` which agree exactly over `S'`, with structure map to `S` given on
  each chart by the projection `𝔸¹_S ⟶ S`.

The conclusion records, in this order: `X ⟶ S` is smooth of relative dimension `1` (the tag's
hypothesis); `X ⟶ S` is *not* separated (the hypothesis the source uses implicitly, through
`Hilb^1_{X/S} = X` and Tag 0B9G); for every `d` the functor `Hilb^d_{X/S}` is representable (the
tag's other hypothesis); and for every `d ≥ 1`, *every* scheme representing `Hilb^d_{X/S}` fails
to be smooth over `S`, so in particular is not smooth of relative dimension `d`.

The definitions the statement relies on:

* `Stacks.Hilbert.HilbertFamily X T d` (Stacks Section 0B94, the value `Hilb^d_{X/S}(T)`): an
  ideal sheaf `ideal` on `X ×_S T` together with the proof that `ideal.subschemeι ≫ (X ×_S T ⟶ T)`
  is `Stacks.Morphisms.IsFiniteLocallyFreeOfRank _ d`, i.e. affine with direct image of the
  structure sheaf finite locally free of rank `d` (Stacks Tag 02KA). A closed subscheme is
  recorded by its ideal sheaf, so two families are equal iff their ideals are.
* `Stacks.Hilbert.RepresentsHilbertFunctorOfRank X H d` (`H` represents `Hilb^d_{X/S}`): a
  bijection `family : (T ⟶ H) ≃ HilbertFamily X T d` for every `S`-scheme `T`, natural in `T`:
  `(family (g ≫ f)).ideal = (family f).ideal.comap (X ×_S T' ⟶ X ×_S T)`, where `comap` is the
  ideal of the scheme-theoretic inverse image (Mathlib `Scheme.IdealSheafData.comap`), i.e. the
  base change of the closed subscheme.
* `AlgebraicGeometry.SmoothOfRelativeDimension`, `AlgebraicGeometry.Smooth`,
  `AlgebraicGeometry.IsSeparated`: Mathlib's.

Why it fails: a family of positive degree splits any base `T` into the open and closed parts over
`S'` and over `S ∖ S'`, and over the latter `T ⟶ S` factors through `Z = V((eₙ)ₙ)`; so
`Hilb^d_{X/S} ≅ 𝔸^d_{S'} ⊔ ∐_{a + b = d} (𝔸^a × 𝔸^b)_Z`. The pieces over `Z` are open and map
into `S ∖ S'`, which has empty interior, whereas a smooth morphism is open.

The corrected statement, with `X ⟶ S` separated, is
`Stacks.Hilbert.smoothOfRelativeDimension_of_represents`; the bare negation of the printed
statement is `Stacks.Hilbert.NonSeparated.not_forall_smoothOfRelativeDimension_of_represents`. -/
@[stacks 0B9H "the statement as printed is false: this is an explicit counterexample, a smooth \
non-separated relative curve over Spec of a product of copies of F_2 with every Hilb^d \
representable and no Hilb^d with d >= 1 smooth. The source needs X -> S separated (it uses \
Hilb^1 = X and Tag 0B9G); the corrected statement is \
Stacks.Hilbert.smoothOfRelativeDimension_of_represents"]
theorem not_smooth_hilbertScheme_doubledLine :
    let S : Scheme.{u} := Spec (CommRingCat.of (ULift.{u} ℕ → ZMod 2))
    let S' : S.Opens :=
      ⨆ n : ULift.{u} ℕ, PrimeSpectrum.basicOpen (Pi.single n 1 : ULift.{u} ℕ → ZMod 2)
    let X : Over S := DoubledLine.doubledLine S'
    SmoothOfRelativeDimension 1 X.hom ∧ ¬ IsSeparated X.hom ∧
      (∀ d : ℕ, ∃ H : Over S, Nonempty (RepresentsHilbertFunctorOfRank X H d)) ∧
      ∀ d : ℕ, 0 < d → ∀ H : Over S, RepresentsHilbertFunctorOfRank X H d → ¬ Smooth H.hom := by
  intro S S' X
  change SmoothOfRelativeDimension 1 curve.{u}.hom ∧ ¬ IsSeparated curve.{u}.hom ∧
      (∀ d : ℕ, ∃ H : Over base.{u}, Nonempty (RepresentsHilbertFunctorOfRank curve H d)) ∧
      ∀ d : ℕ, 0 < d → ∀ H : Over base.{u}, RepresentsHilbertFunctorOfRank curve H d →
        ¬ Smooth H.hom
  refine ⟨inferInstance, fun hsep ↦ ?_, fun d ↦ ⟨hilbertSchemes d, ⟨representsHilbertSchemes d⟩⟩,
    fun d hd H hH hsm ↦ ?_⟩
  · exact not_smooth_hilbertSchemes 1 one_pos
      (smoothOfRelativeDimension_of_represents hilbertSchemes representsHilbertSchemes 1).smooth
  · let e := hH.isoOver (representsHilbertSchemes d)
    have : IsIso e.inv.left := (Over.forget _).map_isIso e.inv
    have hcomp : Smooth (e.inv.left ≫ H.hom) := inferInstance
    rw [Over.w e.inv] at hcomp
    exact not_smooth_hilbertSchemes d hd hcomp

end Stacks.Hilbert.NonSeparated

end
