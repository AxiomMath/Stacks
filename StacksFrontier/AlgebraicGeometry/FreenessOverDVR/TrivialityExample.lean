attribute [local instance] HasDerivedCategory.standard

/-! ### Modules with at most one element -/

section Subsingleton

variable {R M N : Type u} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- Any two modules with at most one element are linearly equivalent, both being zero. -/
private def linearEquivOfSubsingleton (M N : Type u) [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] [Subsingleton M] [Subsingleton N] : M ≃ₗ[R] N where
  toFun _ := 0
  invFun _ := 0
  map_add' _ _ := Subsingleton.elim _ _
  map_smul' _ _ := Subsingleton.elim _ _
  left_inv _ := Subsingleton.elim _ _
  right_inv _ := Subsingleton.elim _ _

/-- A module with at most one element is a finite module, being generated by the empty set. -/
private theorem finite_of_subsingleton (h : Subsingleton M) : Module.Finite R M :=
  ⟨by
    rw [(Submodule.eq_bot_iff ⊤).2 fun x _ => h.elim x 0]
    exact Submodule.fg_bot⟩

/-- A submodule of a module with at most one element has at most one element. -/
private theorem subsingleton_submodule (h : Subsingleton M) (p : Submodule R M) :
    Subsingleton p :=
  ⟨fun _ _ => Subtype.ext (h.elim _ _)⟩

end Subsingleton

/-! ### The free rank -/

section FreeRank

variable {R M N : Type u} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- A linear equivalence carries the torsion submodule onto the torsion submodule. -/
private theorem map_torsion_eq (e : M ≃ₗ[R] N) :
    Submodule.map (e : M →ₗ[R] N) (Submodule.torsion R M) = Submodule.torsion R N := by
  ext y
  simp only [Submodule.mem_map, Submodule.mem_torsion_iff]
  constructor
  · rintro ⟨x, ⟨a, ha⟩, rfl⟩
    refine ⟨a, ?_⟩
    rw [Submonoid.smul_def] at ha ⊢
    rw [LinearEquiv.coe_coe, ← map_smul, ha, map_zero]
  · rintro ⟨a, ha⟩
    refine ⟨e.symm y, ⟨a, ?_⟩, by simp⟩
    rw [Submonoid.smul_def] at ha ⊢
    rw [← map_smul, ha, map_zero]

/-- The free rank is an invariant of the isomorphism class of a module. -/
private theorem freeRank_congr (e : M ≃ₗ[R] N) : freeRank R M = freeRank R N :=
  LinearEquiv.finrank_eq (Submodule.Quotient.equiv _ _ e (map_torsion_eq e))

end FreeRank

/-! ### Restriction of scalars along a ring isomorphism -/

section RestrictScalars

variable {R S : Type u} [CommRing R] [CommRing S]

/-- Restriction of scalars along a ring isomorphism `φ` with inverse `g` identifies the
`S`-module `S^r` with the `R`-module `R^r`, coordinatewise through `g`. -/
private def piRestrictScalarsEquiv (φ : R →+* S) (g : S →+* R) (hgφ : ∀ a, g (φ a) = a)
    (hφg : ∀ x, φ (g x) = x) (r : ℕ) :
    ((ModuleCat.restrictScalars φ).obj (ModuleCat.of S (Fin r → S))) ≃ₗ[R] (Fin r → R) where
  toFun x i := g (x i)
  invFun y i := φ (y i)
  map_add' _ _ := funext fun _ => map_add g _ _
  map_smul' a x := funext fun i => by
    change g (φ a * x i) = a * g (x i)
    rw [map_mul, hgφ]
  left_inv x := funext fun i => hφg (x i)
  right_inv y := funext fun i => hgφ (y i)

/-- Restriction of scalars along a ring isomorphism `φ` with inverse `g` identifies `S` as an
`S`-module with `R` as an `R`-module. -/
private def ringRestrictScalarsEquiv (φ : R →+* S) (g : S →+* R) (hgφ : ∀ a, g (φ a) = a)
    (hφg : ∀ x, φ (g x) = x) :
    ((ModuleCat.restrictScalars φ).obj (ModuleCat.of S S)) ≃ₗ[R] R where
  toFun x := g x
  invFun y := φ y
  map_add' _ _ := map_add g _ _
  map_smul' a x := by
    rw [ModuleCat.restrictScalars.smul_def (M := ModuleCat.of S S), smul_eq_mul, map_mul, hgφ,
      smul_eq_mul]
    rfl
  left_inv x := hφg x
  right_inv y := hgφ y

end RestrictScalars

/-! ### Freeness from a point with no proper open neighbourhood -/

/-- On a scheme with a point `x` whose only open neighbourhood is the whole space, a finite
locally free module is free of finite rank: its local trivialization at `x` is global. -/
theorem isFreeOfFiniteRank_of_isFiniteLocallyFree {X : Scheme.{u}} (x : X)
    (hx : ∀ U : X.Opens, x ∈ U → U = ⊤) (E : X.Modules)
    (hE : E.IsFiniteLocallyFree) : IsFreeOfFiniteRank E := by
  obtain ⟨U, hxU, I, hI, ⟨iso⟩⟩ := hE x
  obtain rfl := hx U hxU
  obtain ⟨r, ⟨e⟩⟩ := Finite.exists_equiv_fin I
  have hpres : PreservesColimitsOfShape (Discrete I)
      (Scheme.Modules.restrictFunctor (X.topIso.inv)) := inferInstance
  let α : Scheme.Modules.restrictFunctor (𝟙 X) ≅
      Scheme.Modules.restrictFunctor (⊤ : X.Opens).ι ⋙
        Scheme.Modules.restrictFunctor (X.topIso.inv) :=
    Scheme.Modules.restrictFunctorCongr (Scheme.toIso_inv_ι X).symm ≪≫
      Scheme.Modules.restrictFunctorComp _ _
  refine ⟨r, ⟨(Scheme.Modules.restrictFunctorId.app E).symm ≪≫ α.app E ≪≫
    (Scheme.Modules.restrictFunctor (X.topIso.inv)).mapIso iso ≪≫
    (@SheafOfModules.mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _
      (Scheme.Modules.restrictFunctor (X.topIso.inv)) I hpres
      (Scheme.Modules.restrictUnitIso (X.topIso.inv)).symm).symm ≪≫
    (SheafOfModules.freeFunctor (R := X.ringCatSheaf)).mapIso
      (e.trans Equiv.ulift.symm).toIso⟩⟩

/-- The global sections of the free module of rank `r` on a scheme `X` are `Γ(X, ⊤)^r`: the
free module is a finite biproduct of copies of `𝒪_X`, and global sections, being additive,
turn that biproduct into a product. -/
def moduleGlobalSectionsFreeIso (X : Scheme.{u}) (r : ℕ) :
    (moduleGlobalSections X).obj (SheafOfModules.free.{u} (ULift.{u} (Fin r))) ≅
      ModuleCat.of Γ(X, ⊤) (Fin r → Γ(X, ⊤)) := by
  have h0 : HasFiniteBiproducts (SheafOfModules.{u} X.ringCatSheaf) :=
    HasFiniteBiproducts.of_hasFiniteProducts
  have h1 : HasBiproduct (fun _ : ULift.{u} (Fin r) => SheafOfModules.unit X.ringCatSheaf) :=
    inferInstance
  have h2 : HasBiproduct (fun _ : Fin r => SheafOfModules.unit X.ringCatSheaf) := inferInstance
  have e1 : SheafOfModules.free.{u} (R := X.ringCatSheaf) (ULift.{u} (Fin r)) ≅
      ⨁ (fun _ : ULift.{u} (Fin r) => SheafOfModules.unit X.ringCatSheaf) :=
    (biproduct.isoCoproduct _).symm
  have e2 : ⨁ (fun _ : ULift.{u} (Fin r) => SheafOfModules.unit X.ringCatSheaf) ≅
      ⨁ (fun _ : Fin r => SheafOfModules.unit X.ringCatSheaf) :=
    biproduct.whiskerEquiv (f := fun _ : ULift.{u} (Fin r) => SheafOfModules.unit X.ringCatSheaf)
      (g := fun _ : Fin r => SheafOfModules.unit X.ringCatSheaf) Equiv.ulift
      (fun _ => Iso.refl _)
  exact (SheafOfModules.evaluation X.ringCatSheaf (op ⊤)).mapIso (e1 ≪≫ e2) ≪≫
    (SheafOfModules.evaluation X.ringCatSheaf (op ⊤)).mapBiproduct
      (fun _ : Fin r => SheafOfModules.unit X.ringCatSheaf) ≪≫
    ModuleCat.biproductIsoPi (fun _ : Fin r =>
      (SheafOfModules.evaluation X.ringCatSheaf (op ⊤)).obj
        (SheafOfModules.unit X.ringCatSheaf))

/-! ### The cohomology of the identity of `Spec A` -/

section SpecId

variable (A : Type u) [CommRing A]

/-- The scalars of the cohomology over the identity of `Spec A` are restricted along the
canonical isomorphism `A ≅ Γ(Spec A, ⊤)`, the identity contributing nothing. -/
private theorem specIdAppTop :
    ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        Scheme.Hom.appTop (𝟙 (Spec (CommRingCat.of A)))) =
      (Scheme.ΓSpecIso (CommRingCat.of A)).inv := by
  simp

/-- The isomorphism `Γ(Spec A, ⊤) ≅ A` inverts the scalars of the cohomology over the identity
of `Spec A`. -/
private theorem specIdLeftInv (a : A) :
    (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
        (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          Scheme.Hom.appTop (𝟙 (Spec (CommRingCat.of A)))).hom a) = a := by
  rw [specIdAppTop]
  exact congrArg (fun z : CommRingCat.of A ⟶ CommRingCat.of A => z.hom a)
    (Scheme.ΓSpecIso (CommRingCat.of A)).inv_hom_id

/-- The scalars of the cohomology over the identity of `Spec A` invert the isomorphism
`Γ(Spec A, ⊤) ≅ A`. -/
private theorem specIdRightInv (x : Γ(Spec (CommRingCat.of A), ⊤)) :
    (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        Scheme.Hom.appTop (𝟙 (Spec (CommRingCat.of A)))).hom)
      ((Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom x) = x := by
  rw [specIdAppTop]
  exact congrArg (fun z : Γ(Spec (CommRingCat.of A), ⊤) ⟶ Γ(Spec (CommRingCat.of A), ⊤) => z.hom x)
    (Scheme.ΓSpecIso (CommRingCat.of A)).hom_inv_id

/-- On the affine scheme `Spec A` the cohomology of a quasi-coherent module vanishes in positive
degrees, by [Stacks, Tag 01XB]. -/
private theorem subsingleton_cohomologyOver (F : (Spec (CommRingCat.of A)).Modules)
    [F.IsQuasicoherent] (i : ℕ) :
    Subsingleton (cohomologyOver A (𝟙 (Spec (CommRingCat.of A))) (i + 1) F) := by
  change Subsingleton
    (((moduleGlobalSections (Spec (CommRingCat.of A))).rightDerived (i + 1)).obj F)
  rw [← ModuleCat.isZero_iff_subsingleton]
  exact (Stacks.DerivedIndexing.rightAcyclic_iff_forall_nat _ F).1
    (rightAcyclic_moduleGlobalSections (Spec (CommRingCat.of A)) F) (i + 1) i.succ_pos

/-- The zeroth cohomology of a module which is free of rank `r` on `Spec A` is `A^r`: in degree
zero the right derived functor of global sections is global sections itself. -/
private def cohomologyZeroEquivOfIsoFree {E : (Spec (CommRingCat.of A)).Modules} {r : ℕ}
    (isoE : E ≅ SheafOfModules.free.{u} (ULift.{u} (Fin r))) :
    cohomologyOver A (𝟙 (Spec (CommRingCat.of A))) 0 E ≃ₗ[A] (Fin r → A) :=
  (((ModuleCat.restrictScalars _).mapIso
    ((moduleGlobalSections (Spec (CommRingCat.of A))).rightDerivedZeroIsoSelf.app E ≪≫
      (moduleGlobalSections (Spec (CommRingCat.of A))).mapIso isoE ≪≫
      moduleGlobalSectionsFreeIso (Spec (CommRingCat.of A)) r)).toLinearEquiv).trans
    (piRestrictScalarsEquiv _ (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom (specIdLeftInv A)
      (specIdRightInv A) r)

/-- The zeroth cohomology of the structure sheaf of `Spec A` is `A`. -/
private def cohomologyZeroUnitEquiv :
    cohomologyOver A (𝟙 (Spec (CommRingCat.of A))) 0
        (SheafOfModules.unit (Spec (CommRingCat.of A)).ringCatSheaf) ≃ₗ[A] A :=
  (((ModuleCat.restrictScalars _).mapIso
    ((moduleGlobalSections (Spec (CommRingCat.of A))).rightDerivedZeroIsoSelf.app _)
      ).toLinearEquiv).trans
    (ringRestrictScalarsEquiv _ (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom (specIdLeftInv A)
      (specIdRightInv A))

end SpecId

/-! ### The input of Tag 0EXF is inhabited -/

/-- **The structure `TrivialityInput` is inhabited.** For a local domain `A` and any `π` the
identity of `Spec A` satisfies every field. Every finite locally free module on `Spec A` is free,
because the closed point lies in every nonempty open; its zeroth cohomology is the module of
global sections, hence `A^r`; and the higher cohomology vanishes because `Spec A` is affine, so
every torsion term of the comparison is zero and the evaluation `φ` may be taken to be the
isomorphism `H⁰(𝓔) ≅ A^r` itself. -/
theorem trivialityInput_id (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A] (π : A) :
    TrivialityInput A (𝟙 (Spec (CommRingCat.of A))) π := by
  have hfree : ∀ E : (Spec (CommRingCat.of A)).Modules, E.IsFiniteLocallyFree →
      ∃ r : ℕ, Nonempty (E ≅ SheafOfModules.free.{u} (ULift.{u} (Fin r))) := fun E hE =>
    isFreeOfFiniteRank_of_isFiniteLocallyFree (IsLocalRing.closedPoint A)
      (fun U hU => (IsLocalRing.closedPoint_mem_iff U).1 hU) E hE
  have hQC : ∀ (E : (Spec (CommRingCat.of A)).Modules) (r : ℕ),
      (E ≅ SheafOfModules.free.{u} (ULift.{u} (Fin r))) → E.IsQuasicoherent := fun E _ e =>
    (SheafOfModules.isQuasicoherent (Spec (CommRingCat.of A)).ringCatSheaf).prop_of_iso e.symm
      inferInstance
  refine ⟨?_, ?_, ⟨0, ?_⟩⟩
  · intro E hE i
    obtain ⟨r, ⟨e⟩⟩ := hfree E hE
    match i with
    | 0 => exact Module.Finite.equiv (cohomologyZeroEquivOfIsoFree A e).symm
    | (i + 1) =>
      have := hQC E r e
      exact finite_of_subsingleton (subsingleton_cohomologyOver A E i)
  · intro i
    match i with
    | 0 => exact Module.Finite.equiv (cohomologyZeroUnitEquiv A).symm
    | (i + 1) =>
      exact finite_of_subsingleton (subsingleton_cohomologyOver A (SheafOfModules.unit _) i)
  · intro m _ E hE _ _
    obtain ⟨r, ⟨e⟩⟩ := hfree E hE
    have hEQC := hQC E r e
    have hL : ∀ i : ℕ, cohomologyOver A (𝟙 (Spec (CommRingCat.of A))) i E ≃ₗ[A]
        (Fin r → cohomologyOver A (𝟙 (Spec (CommRingCat.of A))) i
          (SheafOfModules.unit (Spec (CommRingCat.of A)).ringCatSheaf)) := by
      intro i
      match i with
      | 0 =>
        exact (cohomologyZeroEquivOfIsoFree A e).trans
          (LinearEquiv.piCongrRight fun _ => (cohomologyZeroUnitEquiv A).symm)
      | (i + 1) =>
        have := subsingleton_cohomologyOver A E i
        have := subsingleton_cohomologyOver A (SheafOfModules.unit _) i
        exact linearEquivOfSubsingleton _ _
    refine ⟨r, (cohomologyZeroEquivOfIsoFree A e).toLinearMap, 0, fun _ => ⟨r, ⟨e⟩⟩,
      fun i => freeRank_congr (hL i), fun i => ⟨?_⟩, ?_⟩
    · have h1 := subsingleton_submodule (subsingleton_cohomologyOver A E i) (cohomologyTorsion A
        (𝟙 (Spec (CommRingCat.of A))) π m (i + 1) E)
      have h2 := subsingleton_cohomologyOver A (SheafOfModules.unit _) i
      have h3 := subsingleton_submodule (inferInstance : Subsingleton (Fin r → _))
        (Submodule.torsionBy A (Fin r → cohomologyOver A (𝟙 (Spec (CommRingCat.of A))) (i + 1)
          (SheafOfModules.unit (Spec (CommRingCat.of A)).ringCatSheaf)) (π ^ m))
      exact LinearEquiv.prodCongr
        (Submodule.Quotient.equiv _ _ (hL i) (by
          rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]))
        (linearEquivOfSubsingleton _ _)
    · have hsurj : Function.Surjective ((Ideal.span {π} ^ m).mkQ.compLeft (Fin r) ∘ₗ
          (cohomologyZeroEquivOfIsoFree A e).toLinearMap) := by
        intro y
        choose x hx using fun i => Submodule.mkQ_surjective (Ideal.span {π} ^ m) (y i)
        refine ⟨(cohomologyZeroEquivOfIsoFree A e).symm x, ?_⟩
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
        exact funext hx
      rw [LinearMap.range_eq_top.2 hsurj, top_sup_eq]

/-! ### The witness satisfies the geometric hypotheses of the source -/

/-- The identity of a scheme has geometrically connected fibres: in a pullback square over
`𝟙 X` the projection to `Spec K` is an isomorphism, and the spectrum of a field is a
one-point space. -/
theorem geometricallyConnected_id (X : Scheme.{u}) : GeometricallyConnected (𝟙 X) := by
  refine ⟨fun K _ y Z fst snd h => ?_⟩
  have : IsIso snd := h.isIso_snd_of_isIso
  exact (asIso snd).hom.homeomorph.connectedSpace_iff.mpr inferInstance

/-! ### The conclusion of Tag 0EXF, with no hypothesis left -/

/-- **The conclusion of [Stacks, Tag 0EXF] for the identity of the spectrum of a discrete
valuation ring.** No hypothesis remains: the identity is proper by Mathlib's instances, has
geometrically connected fibres by `geometricallyConnected_id`, and satisfies `TrivialityInput` by
`trivialityInput_id`, so the thickening exponent exists outright. -/
theorem exists_thickening_exponent_free_specId (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] {π : A} (hπ : Irreducible π) :
    ∃ n : ℕ, 0 < n ∧ ∀ E : (Spec (CommRingCat.of A)).Modules, E.IsFiniteLocallyFree →
      IsFreeOfFiniteRank (genericFibreRestrict A (𝟙 (Spec (CommRingCat.of A))) E) →
      IsFreeOfFiniteRank (thickeningRestrict A (𝟙 (Spec (CommRingCat.of A))) n E) →
      IsFreeOfFiniteRank E :=
  exists_thickening_exponent_free_of_free_generic_and_thickening A _ hπ
    (trivialityInput_id A π)

/-- **A concrete instance of [Stacks, Tag 0EXF]**, over the discrete valuation ring `k⟦X⟧` of
formal power series in one variable over a field, with the variable as uniformizer. -/
theorem exists_thickening_exponent_free_specPowerSeries (k : Type u) [Field k] :
    ∃ n : ℕ, 0 < n ∧ ∀ E : (Spec (CommRingCat.of (PowerSeries k))).Modules,
      E.IsFiniteLocallyFree →
      IsFreeOfFiniteRank (genericFibreRestrict (PowerSeries k)
        (𝟙 (Spec (CommRingCat.of (PowerSeries k)))) E) →
      IsFreeOfFiniteRank (thickeningRestrict (PowerSeries k)
        (𝟙 (Spec (CommRingCat.of (PowerSeries k)))) n E) →
      IsFreeOfFiniteRank E :=
  exists_thickening_exponent_free_specId (PowerSeries k) PowerSeries.X_irreducible

end Stacks.AlgebraicGeometry.FreenessOverDVR
