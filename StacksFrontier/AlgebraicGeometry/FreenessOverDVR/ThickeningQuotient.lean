module

public import StacksFrontier.AlgebraicGeometry.AffineQcohEquivalence.Basic
public import StacksFrontier.AlgebraicGeometry.BaseAdicFiltration.GradedPiece
public import StacksFrontier.AlgebraicGeometry.Flatness.Devissage.Complete.Transport
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFullyFaithful.SectionsComplete
public import StacksFrontier.AlgebraicGeometry.FreenessOverDVR.Triviality
public import StacksFrontier.AlgebraicGeometry.PuncturedSpectrumPicard.PrincipalPowerSubscheme

/-!
# The thickening `Xₙ` and the quotient `F / πⁿ F`

Let `A` be a local ring whose maximal ideal is generated by `π`, and `f : X ⟶ Spec A`. The
thickening `Xₙ = X ×_{Spec A} Spec (A ⧸ 𝔪ⁿ)` is the closed subscheme of `X` cut out by the ideal
sheaf `(π 𝒪_X)ⁿ`, so by [Stacks, Tag 0EL1] the direct image of the restriction of a
quasi-coherent module `F` to `Xₙ` is `F / πⁿ F`. In particular a module whose restriction to `Xₙ`
is free has `F / πⁿ F ≅ 𝒪_X^r / πⁿ 𝒪_X^r`.

## Main results

The elided prefix is `Stacks.AlgebraicGeometry.FreenessOverDVR`.

* `ker_thickening`: the ideal sheaf of `Xₙ ⊆ X` is `(π 𝒪_X)ⁿ`.
* `adicQuotientIsoOfThickeningIso`: an isomorphism of the restrictions to `Xₙ` gives an
  isomorphism of the quotients by `πⁿ`.
* `adicQuotientIsoFreeOfThickening`: the case of a module free on `Xₙ`.

## References

* [Stacks Project, Tag 0EXF](https://stacks.math.columbia.edu/tag/0EXF)
* [Stacks Project, Tag 0EL1](https://stacks.math.columbia.edu/tag/0EL1)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open Stacks.BaseAdicFiltration Stacks.Algebraization

universe u

namespace Stacks.AlgebraicGeometry.FreenessOverDVR

variable (A : Type u) [CommRing A] [IsLocalRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
  {π : A} (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})

include hπ in
/-- **The ideal sheaf of the thickening `Xₙ ⊆ X` is `(π 𝒪_X)ⁿ`.** -/
theorem ker_thickening (n : ℕ) :
    (pullback.fst f (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n))))).ker =
        baseIdeal f (Ideal.span {π}) ^ n := by
  rw [← Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_ker_pullback_fst,
    Stacks.Cohomology.FormalFunctions.baseIdealSheaf_pow,
    Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_comap, hπ]
  rfl

/-- The thickening `Xₙ ⟶ X` is a closed immersion. -/
instance isClosedImmersion_thickening (n : ℕ) :
    IsClosedImmersion (pullback.fst f (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n))))) :=
  haveI := IsClosedImmersion.spec_of_quotient_mk (R := .of A) (IsLocalRing.maximalIdeal A ^ n)
  inferInstance

include hπ in
/-- **An isomorphism of the restrictions to `Xₙ` gives `F / πⁿ F ≅ G / πⁿ G`**, by
[Stacks, Tag 0EL1]. -/
def adicQuotientIsoOfThickeningIso (n : ℕ) {F G : X.Modules} [F.IsQuasicoherent]
    [G.IsQuasicoherent] (e : thickeningRestrict A f n F ≅ thickeningRestrict A f n G) :
    adicQuotient f (Ideal.span {π}) n F ≅ adicQuotient f (Ideal.span {π}) n G :=
  idealQuotientPushforwardIso (baseIdeal f (Ideal.span {π})) n F _ (ker_thickening A f hπ n) ≪≫
    (Scheme.Modules.pushforward _).mapIso e ≪≫
      (idealQuotientPushforwardIso (baseIdeal f (Ideal.span {π})) n G _
        (ker_thickening A f hπ n)).symm

include hπ in
/-- **A module free of rank `r` on `Xₙ` has `F / πⁿ F ≅ 𝒪_X^r / πⁿ 𝒪_X^r`.** -/
def adicQuotientIsoFreeOfThickening (n : ℕ) {F : X.Modules} [F.IsQuasicoherent] {r : ℕ}
    (e : thickeningRestrict A f n F ≅ SheafOfModules.free.{u} (ULift.{u} (Fin r))) :
    adicQuotient f (Ideal.span {π}) n F ≅
      adicQuotient f (Ideal.span {π}) n (SheafOfModules.free.{u} (ULift.{u} (Fin r))) :=
  haveI := Stacks.AlgebraicGeometry.AffineQcohEquivalence.isQuasicoherent_free (X := X)
    (ULift.{u} (Fin r))
  adicQuotientIsoOfThickeningIso A f hπ n
    (e ≪≫ (Scheme.Modules.pullbackFreeIso _ (ULift.{u} (Fin r))).symm)

end Stacks.AlgebraicGeometry.FreenessOverDVR
