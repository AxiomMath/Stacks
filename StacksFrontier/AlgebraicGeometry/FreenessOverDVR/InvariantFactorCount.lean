module

public import Mathlib.Algebra.Module.PID
public import Mathlib.LinearAlgebra.Dimension.Torsion.Basic
public import Mathlib.LinearAlgebra.Quotient.Pi
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.SimpleModule.Basic

/-!
# Counting the invariant factors of a module over a discrete valuation ring

Let `A` be a discrete valuation ring with uniformizer `π`. A finite `A`-module `N` is isomorphic
to `A ^ β × ∏ᵢ A ⧸ (π ^ lᵢ)`, and the lengths of its torsion submodules recover the multiset of
exponents: the length of `N[π ^ k]` is `∑ᵢ min lᵢ k`, while the length of the `π ^ k`-torsion of
`N ⧸ π ^ m N` is `k * β + ∑ᵢ min lᵢ k` as soon as `k ≤ m`. Both counts are additive in finite
products, so applying them at `k = m` and at `k = m - 1` to an isomorphism
`(H ⧸ π ^ m H) × H'[π ^ m] ≃ (G ⧸ π ^ m G) × G'[π ^ m]` of finite modules with `H` and `G` of
equal free rank transfers the bound `π ^ (m - 1) · G[π ^ m] = 0`, `π ^ (m - 1) · G'[π ^ m] = 0`
to `H` and `H'`: the number of invariant factors of exponent at least `m` is zero on the right,
hence zero on the left, where it is a sum of the counts for `H` and for `H'`.

## Main results

The elided prefix is `Stacks.AlgebraicGeometry.FreenessOverDVR`.

* `torsionLength`: the length of the submodule annihilated by `π ^ k`.
* `exists_invariantFactors`: exponents `l i` computing `torsionLength π k N` for every `k`, and
  the matching computation for the reduction `N ⧸ π ^ m N`.
* `pow_smul_torsionBy_eq_bot_iff_le`: annihilation of the `π ^ m`-torsion by `π ^ e` is an
  inclusion of torsion submodules.
* `pow_smul_torsionBy_eq_bot_iff_torsionLength_eq`: `π ^ (m - 1)` annihilates the `π ^ m`-torsion
  of a finite module exactly when the `π ^ m`- and `π ^ (m - 1)`-torsion have equal length.
* `pow_smul_torsionBy_eq_bot_of_linearEquiv_mod_pow`: the transfer of the exponent bound along
  the isomorphism above.

## Implementation notes

The invariant is `Module.length` over `A` rather than a dimension over the residue field `A ⧸ π`:
length is invariant under `A`-linear isomorphisms and additive in finite products and in short
exact sequences, whereas the residue-field structure on `N ⧸ π N` would have to be carried through
every isomorphism. Free rank is `Module.finrank A (N ⧸ Submodule.torsion A N)`, which is the free
rank `β` of the decomposition because the torsion submodule of `A ^ β × T` with `T` torsion is the
kernel of the first projection.

Direct sums are replaced by products over a `Fintype`, which is where `Submodule.quotientPi` and
`Module.length_pi_of_fintype` apply; the decomposition itself comes from Mathlib's structure
theorem `Module.equiv_free_prod_directSum` for principal ideal domains, after replacing each prime
occurring there by `π`, to which it is associated.

## References

* [Stacks Project, Tag 0EXF](https://stacks.math.columbia.edu/tag/0EXF)
* [Stacks Project, Tag 0ASP](https://stacks.math.columbia.edu/tag/0ASP)
-/

@[expose] public section

universe u v w

namespace Stacks.AlgebraicGeometry.FreenessOverDVR

open scoped Pointwise

variable {A : Type u} [CommRing A]

section Pointwise

variable (r : A)

/-- Scaling the unit submodule of `A` by `r` gives the ideal generated by `r`. -/
private lemma smul_top_self : r • (⊤ : Submodule A A) = Ideal.span {r} := by
  ext x
  simp [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton, smul_eq_mul,
    dvd_def, eq_comm]

/-- Scaling the unit submodule of `A ⧸ J` by `r` gives the image of the ideal `(r)`. -/
private lemma smul_top_quotient (J : Ideal A) :
    r • (⊤ : Submodule A (A ⧸ J)) = Submodule.map J.mkQ (Ideal.span {r}) := by
  rw [← smul_top_self r, Submodule.map_pointwise_smul, Submodule.map_top,
    Submodule.range_mkQ]

/-- Scaling the unit submodule of a product by `r` is done factorwise. -/
private lemma smul_top_prod (M : Type v) [AddCommGroup M] [Module A M]
    (N : Type w) [AddCommGroup N] [Module A N] :
    r • (⊤ : Submodule A (M × N)) =
      (r • (⊤ : Submodule A M)).prod (r • (⊤ : Submodule A N)) := by
  ext x
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_prod, Submodule.mem_top,
    true_and, Prod.exists]
  constructor
  · rintro ⟨a, b, rfl⟩
    exact ⟨⟨a, rfl⟩, ⟨b, rfl⟩⟩
  · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    exact ⟨a, b, by rw [Prod.smul_mk, ha, hb]⟩

/-- Scaling the unit submodule of a product by `r` is done componentwise. -/
private lemma smul_top_pi {ι : Type v} (M : ι → Type w) [∀ i, AddCommGroup (M i)]
    [∀ i, Module A (M i)] :
    r • (⊤ : Submodule A (∀ i, M i)) =
      Submodule.pi Set.univ (fun i => r • (⊤ : Submodule A (M i))) := by
  ext x
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_pi, Submodule.mem_top,
    true_and, Set.mem_univ, forall_const]
  constructor
  · rintro ⟨y, rfl⟩ i
    exact ⟨y i, rfl⟩
  · intro h
    choose y hy using h
    exact ⟨y, funext hy⟩

end Pointwise

variable {M : Type v} [AddCommGroup M] [Module A M] {N : Type w} [AddCommGroup N] [Module A N]

/-- A submodule of a product which is a product of submodules splits as a product. -/
private def prodSubmoduleEquiv (p : Submodule A M) (q : Submodule A N) :
    ↥(p.prod q) ≃ₗ[A] ↥p × ↥q where
  toFun x := (⟨x.1.1, x.2.1⟩, ⟨x.1.2, x.2.2⟩)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun y := ⟨(y.1.1, y.2.1), y.1.2, y.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The quotient of a product by a product of submodules is the product of the quotients. -/
private noncomputable def quotientProdEquiv (p : Submodule A M) (q : Submodule A N) :
    ((M × N) ⧸ p.prod q) ≃ₗ[A] (M ⧸ p) × (N ⧸ q) :=
  Submodule.quotEquivOfEq _ _ (by simp) ≪≫ₗ
    LinearMap.quotKerEquivOfSurjective (p.mkQ.prodMap q.mkQ)
      (LinearMap.range_eq_top.1 (by simp [LinearMap.range_prodMap]))

/-- A submodule of a product which is a product of submodules splits as a product. -/
private def piSubmoduleEquiv {ι : Type v} {P : ι → Type w} [∀ i, AddCommGroup (P i)]
    [∀ i, Module A (P i)] (p : ∀ i, Submodule A (P i)) :
    ↥(Submodule.pi Set.univ p) ≃ₗ[A] ∀ i, ↥(p i) where
  toFun x i := ⟨x.1 i, x.2 i (Set.mem_univ i)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun y := ⟨fun i => (y i).1, fun i _ => (y i).2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The `a`-torsion of a product is the product of the `a`-torsions. -/
private lemma torsionBy_prod (a : A) :
    Submodule.torsionBy A (M × N) a =
      (Submodule.torsionBy A M a).prod (Submodule.torsionBy A N a) := by
  ext x
  simp [Submodule.mem_torsionBy_iff, Prod.ext_iff]

/-- The `a`-torsion of a product is the product of the `a`-torsions. -/
private lemma torsionBy_pi {ι : Type v} {P : ι → Type w} [∀ i, AddCommGroup (P i)]
    [∀ i, Module A (P i)] (a : A) :
    Submodule.torsionBy A (∀ i, P i) a =
      Submodule.pi Set.univ (fun i => Submodule.torsionBy A (P i) a) := by
  ext x
  simp [Submodule.mem_torsionBy_iff, funext_iff]

/-- A submodule contained in `q` is the same module whether viewed inside `M` or inside `q`. -/
private def comapSubtypeEquiv {p q : Submodule A M} (h : p ≤ q) :
    ↥(p.comap q.subtype) ≃ₗ[A] ↥p where
  toFun x := ⟨x.1.1, x.2⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun y := ⟨⟨y.1, h y.2⟩, y.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The `a`-torsion of a submodule `q` of `M` is cut out by the `a`-torsion of `M`. -/
private lemma torsionBy_coe_submodule (q : Submodule A M) (a : A) :
    Submodule.torsionBy A ↥q a = (Submodule.torsionBy A M a).comap q.subtype := by
  ext x
  simp [Submodule.mem_torsionBy_iff, ← Submodule.coe_eq_zero]

/-- An isomorphism of modules carries `a`-torsion onto `a`-torsion. -/
private lemma map_torsionBy (e : M ≃ₗ[A] N) (a : A) :
    Submodule.map (e : M →ₗ[A] N) (Submodule.torsionBy A M a) = Submodule.torsionBy A N a := by
  ext y
  simp only [Submodule.mem_map, Submodule.mem_torsionBy_iff, LinearEquiv.coe_coe]
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [← LinearEquiv.map_smul, hx, map_zero]
  · intro hy
    refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
    rw [← LinearEquiv.map_smul e.symm, hy, map_zero]

/-- An isomorphism of modules carries torsion onto torsion. -/
private lemma map_torsion (e : M ≃ₗ[A] N) :
    Submodule.map (e : M →ₗ[A] N) (Submodule.torsion A M) = Submodule.torsion A N := by
  ext y
  simp only [Submodule.mem_map, Submodule.mem_torsion_iff, LinearEquiv.coe_coe]
  constructor
  · rintro ⟨x, ⟨a, ha⟩, rfl⟩
    exact ⟨a, by rw [Submonoid.smul_def, ← LinearEquiv.map_smul, ← Submonoid.smul_def, ha,
      map_zero]⟩
  · rintro ⟨a, ha⟩
    refine ⟨e.symm y, ⟨a, ?_⟩, e.apply_symm_apply y⟩
    rw [Submonoid.smul_def, ← LinearEquiv.map_smul e.symm, ← Submonoid.smul_def, ha, map_zero]

/-- Two nested submodules of the same finite length coincide. -/
private lemma eq_of_le_of_length_eq {p q : Submodule A M} (hpq : p ≤ q)
    (h : Module.length A p = Module.length A q) (hne : Module.length A q ≠ ⊤) : p = q := by
  refine le_antisymm hpq fun z hz => ?_
  have hex := Module.length_eq_add_of_exact (Submodule.inclusion hpq)
    (LinearMap.range (Submodule.inclusion hpq)).mkQ (Submodule.inclusion_injective hpq)
    (Submodule.mkQ_surjective _) (LinearMap.exact_map_mkQ_range _)
  rw [h] at hex
  have h0 : Module.length A (↥q ⧸ LinearMap.range (Submodule.inclusion hpq)) = 0 :=
    (WithTop.add_left_cancel hne ((add_zero _).trans hex)).symm
  have hS : LinearMap.range (Submodule.inclusion hpq) = ⊤ :=
    Submodule.Quotient.subsingleton_iff.1 (Module.length_eq_zero_iff.1 h0)
  obtain ⟨x, hx⟩ := LinearMap.range_eq_top.1 hS (⟨z, hz⟩ : ↥q)
  have hxz : (x : M) = z := congrArg Subtype.val hx
  exact hxz ▸ x.2

/-- The length of the submodule of `N` annihilated by `π ^ k`. For a finite module over a
discrete valuation ring with uniformizer `π` and invariant factors `π ^ l i` this is
`∑ i, min (l i) k`. -/
noncomputable def torsionLength (π : A) (k : ℕ) (N : Type v) [AddCommGroup N] [Module A N] : ℕ∞ :=
  Module.length A (Submodule.torsionBy A N (π ^ k))

variable {π : A}

/-- The image of `A` under multiplication by `π ^ j` followed by reduction modulo `π ^ L`. -/
private lemma range_mkQ_comp_lsmul (L j : ℕ) :
    LinearMap.range ((Ideal.span {π ^ L}).mkQ ∘ₗ LinearMap.lsmul A A (π ^ j)) =
      Submodule.map (Ideal.span {π ^ L}).mkQ (Ideal.span {π ^ j}) := by
  ext x
  simp only [LinearMap.mem_range, LinearMap.coe_comp, Function.comp_apply, LinearMap.lsmul_apply,
    Submodule.mkQ_apply, Submodule.mem_map, Ideal.mem_span_singleton, smul_eq_mul]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨π ^ j * a, ⟨a, rfl⟩, rfl⟩
  · rintro ⟨y, ⟨c, rfl⟩, rfl⟩
    exact ⟨c, rfl⟩

/-- The ideal generated by `π ^ l` and `π ^ m` is generated by `π ^ min l m`. -/
private lemma span_pow_sup_span_pow (l m : ℕ) :
    Ideal.span {π ^ l} ⊔ Ideal.span {π ^ m} = Ideal.span {π ^ min l m} := by
  rcases le_total l m with h | h
  · rw [min_eq_left h, sup_eq_left, Ideal.span_singleton_le_span_singleton]
    exact pow_dvd_pow π h
  · rw [min_eq_right h, sup_eq_right, Ideal.span_singleton_le_span_singleton]
    exact pow_dvd_pow π h

/-- Scaling by the ideal `(π) ^ m` is scaling by the element `π ^ m`. -/
private lemma span_pow_smul_top (m : ℕ) (P : Type v) [AddCommGroup P] [Module A P] :
    Ideal.span {π} ^ m • (⊤ : Submodule A P) = (π ^ m) • (⊤ : Submodule A P) := by
  rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul]

/-- Reducing `A ⧸ (π ^ l)` modulo `π ^ m` gives `A ⧸ (π ^ min l m)`. -/
private noncomputable def quotSMulCyclicEquiv (l m : ℕ) :
    ((A ⧸ Ideal.span {π ^ l}) ⧸ (π ^ m) • (⊤ : Submodule A (A ⧸ Ideal.span {π ^ l}))) ≃ₗ[A]
      A ⧸ Ideal.span {π ^ min l m} :=
  Submodule.quotEquivOfEq _ _ (smul_top_quotient _ _) ≪≫ₗ
    Submodule.quotientQuotientEquivQuotientSup _ _ ≪≫ₗ
      Submodule.quotEquivOfEq _ _ (span_pow_sup_span_pow l m)

/-- Reducing a free module of rank `β` modulo `π ^ m` gives `β` copies of `A ⧸ (π ^ m)`. -/
private noncomputable def quotSMulFreeEquiv (β m : ℕ) :
    ((Fin β → A) ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A (Fin β → A))) ≃ₗ[A]
      (Fin β → A ⧸ Ideal.span {π ^ m}) :=
  Submodule.quotEquivOfEq _ _ ((span_pow_smul_top m _).trans (smul_top_pi _ _)) ≪≫ₗ
    Submodule.quotientPi _ ≪≫ₗ
      LinearEquiv.piCongrRight fun _ => Submodule.quotEquivOfEq _ _ (smul_top_self _)

/-- Reducing a product of cyclic modules modulo `π ^ m` truncates each exponent at `m`. -/
private noncomputable def quotSMulPiEquiv {ι : Type u} [Fintype ι] [DecidableEq ι]
    (l : ι → ℕ) (m : ℕ) :
    ((∀ i : ι, A ⧸ Ideal.span {π ^ l i}) ⧸
        Ideal.span {π} ^ m • (⊤ : Submodule A (∀ i : ι, A ⧸ Ideal.span {π ^ l i}))) ≃ₗ[A]
      (∀ i : ι, A ⧸ Ideal.span {π ^ min (l i) m}) :=
  Submodule.quotEquivOfEq _ _ ((span_pow_smul_top m _).trans (smul_top_pi _ _)) ≪≫ₗ
    Submodule.quotientPi _ ≪≫ₗ LinearEquiv.piCongrRight fun i => quotSMulCyclicEquiv (l i) m

/-- Reducing a product modulo `π ^ m` is done factorwise. -/
private noncomputable def quotSMulProdEquiv (m : ℕ) :
    ((M × N) ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A (M × N))) ≃ₗ[A]
      ((M ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A M)) ×
        (N ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A N))) :=
  Submodule.quotEquivOfEq _ _ ((span_pow_smul_top m _).trans (smul_top_prod _ _ _)) ≪≫ₗ
    quotientProdEquiv _ _ ≪≫ₗ
      LinearEquiv.prodCongr (Submodule.quotEquivOfEq _ _ (span_pow_smul_top m M).symm)
        (Submodule.quotEquivOfEq _ _ (span_pow_smul_top m N).symm)

/-- `π` raised to the largest exponent annihilates a finite product of cyclic modules. -/
private lemma pow_sup_smul_pi_cyclic {ι : Type u} [Fintype ι] (l : ι → ℕ)
    (y : ∀ i : ι, A ⧸ Ideal.span {π ^ l i}) : π ^ Finset.univ.sup l • y = 0 := by
  funext i
  obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective (Ideal.span {π ^ l i}) (y i)
  rw [Pi.smul_apply, ← ha, ← Submodule.Quotient.mk_smul, Pi.zero_apply,
    Submodule.Quotient.mk_eq_zero, Ideal.mem_span_singleton, smul_eq_mul]
  exact (pow_dvd_pow π (Finset.le_sup (Finset.mem_univ i))).mul_right a

/-- The length of the `π ^ k`-torsion is unchanged by an isomorphism of modules. -/
private lemma torsionLength_congr (e : M ≃ₗ[A] N) (k : ℕ) :
    torsionLength π k M = torsionLength π k N := by
  rw [torsionLength, torsionLength,
    (e.submoduleMap (Submodule.torsionBy A M (π ^ k))).length_eq, map_torsionBy]

/-- The length of the `π ^ k`-torsion is additive in products. -/
private lemma torsionLength_prod (k : ℕ) :
    torsionLength π k (M × N) = torsionLength π k M + torsionLength π k N := by
  rw [torsionLength, (LinearEquiv.ofEq _ _ (torsionBy_prod (π ^ k))).length_eq,
    (prodSubmoduleEquiv _ _).length_eq, Module.length_prod, torsionLength, torsionLength]

/-- The length of the `π ^ k`-torsion is additive in finite products. -/
private lemma torsionLength_pi {ι : Type v} [Fintype ι] (P : ι → Type w)
    [∀ i, AddCommGroup (P i)] [∀ i, Module A (P i)] (k : ℕ) :
    torsionLength π k (∀ i, P i) = ∑ i, torsionLength π k (P i) := by
  rw [torsionLength, (LinearEquiv.ofEq _ _ (torsionBy_pi (π ^ k))).length_eq,
    (piSubmoduleEquiv _).length_eq, Module.length_pi_of_fintype]
  rfl

/-- Passing to the `π ^ m`-torsion does not change the `π ^ k`-torsion when `k ≤ m`. -/
private lemma torsionLength_torsionBy {k m : ℕ} (hkm : k ≤ m) :
    torsionLength π k (Submodule.torsionBy A M (π ^ m)) = torsionLength π k M := by
  rw [torsionLength, torsionBy_coe_submodule,
    (comapSubtypeEquiv (Submodule.torsionBy_le_torsionBy_of_dvd (π ^ k) (π ^ m)
      (pow_dvd_pow π hkm))).length_eq, torsionLength]

/-- Annihilation of the `π ^ m`-torsion by `π ^ e` is containment of torsion submodules. -/
theorem pow_smul_torsionBy_eq_bot_iff_le (P : Type v) [AddCommGroup P] [Module A P] (e m : ℕ) :
    Ideal.span {π} ^ e • Submodule.torsionBy A P (π ^ m) = ⊥ ↔
      Submodule.torsionBy A P (π ^ m) ≤ Submodule.torsionBy A P (π ^ e) := by
  rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul, eq_bot_iff]
  constructor
  · intro h x hx
    rw [Submodule.mem_torsionBy_iff]
    exact (Submodule.mem_bot A).1 (h (Submodule.smul_mem_pointwise_smul x _ _ hx))
  · intro h y hy
    obtain ⟨x, hx, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hy
    rw [Submodule.mem_bot]
    exact (Submodule.mem_torsionBy_iff _ _).1 (h hx)

section Domain

variable [IsDomain A]

/-- In a domain, `π ^ a` divides `π ^ b * x` exactly when `π ^ (a - b)` divides `x`. -/
private lemma pow_dvd_pow_mul_iff (hπ : π ≠ 0) (a b : ℕ) (x : A) :
    π ^ a ∣ π ^ b * x ↔ π ^ (a - b) ∣ x := by
  rcases le_total a b with h | h
  · rw [Nat.sub_eq_zero_of_le h, pow_zero]
    exact iff_of_true ((pow_dvd_pow π h).mul_right x) (one_dvd x)
  · obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le h
    rw [Nat.add_sub_cancel_left, pow_add, mul_dvd_mul_iff_left (pow_ne_zero b hπ)]

/-- Multiplication by `π ^ j` into `A ⧸ (π ^ L)` kills exactly the multiples of `π ^ (L - j)`. -/
private lemma ker_mkQ_comp_lsmul (hπ : π ≠ 0) (L j : ℕ) :
    LinearMap.ker ((Ideal.span {π ^ L}).mkQ ∘ₗ LinearMap.lsmul A A (π ^ j)) =
      Ideal.span {π ^ (L - j)} := by
  ext a
  simp only [LinearMap.mem_ker, LinearMap.coe_comp, Function.comp_apply, LinearMap.lsmul_apply,
    Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Ideal.mem_span_singleton, smul_eq_mul]
  rw [pow_dvd_pow_mul_iff hπ]

/-- The `π ^ m`-torsion of `A ⧸ (π ^ l)` is the image of multiplication by `π ^ (l - m)`. -/
private lemma range_mkQ_comp_lsmul_eq_torsionBy (hπ : π ≠ 0) (l m : ℕ) :
    LinearMap.range ((Ideal.span {π ^ l}).mkQ ∘ₗ LinearMap.lsmul A A (π ^ (l - m))) =
      Submodule.torsionBy A (A ⧸ Ideal.span {π ^ l}) (π ^ m) := by
  ext x
  constructor
  · rintro ⟨a, rfl⟩
    simp only [Submodule.mem_torsionBy_iff, LinearMap.coe_comp, Function.comp_apply,
      LinearMap.lsmul_apply, Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero, Ideal.mem_span_singleton, smul_eq_mul]
    rw [← mul_assoc, ← pow_add]
    exact (pow_dvd_pow π (by omega)).mul_right a
  · intro hx
    obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rw [Submodule.mem_torsionBy_iff, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero, Ideal.mem_span_singleton, smul_eq_mul,
      pow_dvd_pow_mul_iff hπ] at hx
    obtain ⟨c, rfl⟩ := hx
    exact ⟨c, by simp [smul_eq_mul]⟩

/-- The `π ^ m`-torsion of `A ⧸ (π ^ l)` is a copy of `A ⧸ (π ^ min l m)`. -/
private noncomputable def torsionByCyclicEquiv (hπ : π ≠ 0) (l m : ℕ) :
    (A ⧸ Ideal.span {π ^ min l m}) ≃ₗ[A]
      Submodule.torsionBy A (A ⧸ Ideal.span {π ^ l}) (π ^ m) :=
  Submodule.quotEquivOfEq _ _
      (by rw [ker_mkQ_comp_lsmul hπ, show l - (l - m) = min l m by omega]) ≪≫ₗ
    LinearMap.quotKerEquivRange _ ≪≫ₗ
      LinearEquiv.ofEq _ _ (range_mkQ_comp_lsmul_eq_torsionBy hπ l m)

/-- A nonzero element of a domain has no torsion in the ring itself. -/
private lemma torsionLength_self (hπ : π ≠ 0) (k : ℕ) : torsionLength π k A = 0 := by
  have h : Submodule.torsionBy A A (π ^ k) = ⊥ := by
    ext a
    simp [Submodule.mem_torsionBy_iff, smul_eq_mul, pow_ne_zero k hπ]
  rw [torsionLength, h, Module.length_bot]

/-- The torsion of `A ^ β` times a product of cyclic modules is the kernel of the projection
onto `A ^ β`. -/
private lemma torsion_prod_pi_cyclic {β : ℕ} {ι : Type u} [Finite ι] (hπ : π ≠ 0) (l : ι → ℕ) :
    Submodule.torsion A ((Fin β → A) × (∀ i : ι, A ⧸ Ideal.span {π ^ l i})) =
      LinearMap.ker (LinearMap.fst A (Fin β → A) (∀ i : ι, A ⧸ Ideal.span {π ^ l i})) := by
  cases nonempty_fintype ι
  ext x
  simp only [Submodule.mem_torsion_iff, LinearMap.mem_ker, LinearMap.fst_apply]
  constructor
  · rintro ⟨a, ha⟩
    have h1 : (a : A) • x.1 = 0 := congrArg Prod.fst ha
    funext i
    have h2 := congrFun h1 i
    rw [Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at h2
    exact (mul_eq_zero.1 h2).resolve_left (mem_nonZeroDivisors_iff_ne_zero.1 a.2)
  · intro hx
    refine ⟨⟨π ^ Finset.univ.sup l,
      mem_nonZeroDivisors_iff_ne_zero.2 (pow_ne_zero _ hπ)⟩, ?_⟩
    have h1 : π ^ Finset.univ.sup l • x.1 = 0 := by rw [hx, smul_zero]
    rw [Submonoid.smul_def]
    exact Prod.ext h1 (pow_sup_smul_pi_cyclic l x.2)

/-- The free rank of `A ^ β` times a product of cyclic modules is `β`. -/
private lemma finrank_quotient_torsion_prod_pi {β : ℕ} {ι : Type u} [Finite ι] (hπ : π ≠ 0)
    (l : ι → ℕ) :
    Module.finrank A
        (((Fin β → A) × (∀ i : ι, A ⧸ Ideal.span {π ^ l i})) ⧸
          Submodule.torsion A ((Fin β → A) × (∀ i : ι, A ⧸ Ideal.span {π ^ l i}))) = β := by
  rw [(Submodule.quotEquivOfEq _ _ (torsion_prod_pi_cyclic hπ l) ≪≫ₗ
    LinearMap.quotKerEquivOfSurjective _ Prod.fst_surjective).finrank_eq,
    Module.finrank_pi A, Fintype.card_fin]

end Domain

section DiscreteValuationRing

variable [IsDomain A] [IsDiscreteValuationRing A]

/-- The residue field of a discrete valuation ring is a simple module over the ring. -/
private lemma isSimpleModule_quotient_span_singleton (hπ : Irreducible π) :
    IsSimpleModule A (A ⧸ Ideal.span {π}) := by
  have h : (Ideal.span {π} : Ideal A).IsMaximal := by
    rw [← hπ.maximalIdeal_eq]
    exact IsLocalRing.maximalIdeal.isMaximal A
  exact isSimpleModule_iff_quot_maximal.mpr ⟨_, h, ⟨LinearEquiv.refl _ _⟩⟩

/-- The cyclic module `A ⧸ (π ^ l)` has length `l`. -/
private lemma length_quotient_span_pow (hπ : Irreducible π) (l : ℕ) :
    Module.length A (A ⧸ Ideal.span {π ^ l}) = l := by
  induction l with
  | zero =>
    have : Subsingleton (A ⧸ Ideal.span {π ^ 0}) :=
      Submodule.Quotient.subsingleton_iff.2 (by simp)
    simp
  | succ l ih =>
    have := isSimpleModule_quotient_span_singleton hπ
    set S := LinearMap.range ((Ideal.span {π ^ (l + 1)}).mkQ ∘ₗ LinearMap.lsmul A A (π ^ l))
      with hS
    have h1 : Module.length A S = 1 := by
      rw [hS, ← (LinearMap.quotKerEquivRange _).length_eq, ker_mkQ_comp_lsmul hπ.ne_zero,
        show l + 1 - l = 1 by omega, pow_one]
      exact Module.length_eq_one A _
    have h2 : Module.length A ((A ⧸ Ideal.span {π ^ (l + 1)}) ⧸ S) = l := by
      rw [hS, range_mkQ_comp_lsmul, (Submodule.quotientQuotientEquivQuotientSup _ _).length_eq,
        (Submodule.quotEquivOfEq _ _ (span_pow_sup_span_pow (π := π) (l + 1) l)).length_eq,
        show min (l + 1) l = l by omega, ih]
    rw [Module.length_eq_add_of_exact S.subtype S.mkQ (Submodule.subtype_injective _)
      (Submodule.mkQ_surjective _) (LinearMap.exact_subtype_mkQ _), h1, h2]
    push_cast
    exact add_comm 1 (l : ℕ∞)

/-- The `π ^ k`-torsion of `A ⧸ (π ^ l)` has length `min l k`. -/
private lemma torsionLength_cyclic (hπ : Irreducible π) (l k : ℕ) :
    torsionLength π k (A ⧸ Ideal.span {π ^ l}) = min l k := by
  rw [torsionLength, ← (torsionByCyclicEquiv hπ.ne_zero l k).length_eq,
    length_quotient_span_pow hπ]

/-- A finite module over a discrete valuation ring is a free module times a finite product of
cyclic modules `A ⧸ (π ^ l i)`. -/
private lemma exists_pi_decomposition (hπ : Irreducible π) (P : Type v) [AddCommGroup P]
    [Module A P] [Module.Finite A P] :
    ∃ (β : ℕ) (ι : Type u) (_ : Fintype ι) (l : ι → ℕ),
      Nonempty (P ≃ₗ[A] (Fin β → A) × (∀ i : ι, A ⧸ Ideal.span {π ^ l i})) := by
  obtain ⟨n, ι, hι, p, hp, e, ⟨f⟩⟩ := Module.equiv_free_prod_directSum A P
  refine ⟨n, ι, hι, e, ⟨f ≪≫ₗ LinearEquiv.prodCongr (Finsupp.linearEquivFunOnFinite A A (Fin n))
    (DirectSum.linearEquivFunOnFintype A ι _ ≪≫ₗ LinearEquiv.piCongrRight fun i => ?_)⟩⟩
  exact Submodule.quotEquivOfEq _ _ (Ideal.span_singleton_eq_span_singleton.2
    ((IsDiscreteValuationRing.associated_of_irreducible A (hp i) hπ).pow_pow))

/-- The invariant factors of a finite module over a discrete valuation ring: exponents `l i` whose
truncations `min (l i) k` sum to the length of the `π ^ k`-torsion of `P`, and, after adding
`k` times the free rank of `P`, to the length of the `π ^ k`-torsion of `P ⧸ π ^ m P` for
`k ≤ m`. -/
theorem exists_invariantFactors (hπ : Irreducible π) (P : Type v) [AddCommGroup P]
    [Module A P] [Module.Finite A P] :
    ∃ (ι : Type u) (_ : Fintype ι) (l : ι → ℕ),
      (∀ k : ℕ, torsionLength π k P = ((∑ i, min (l i) k : ℕ) : ℕ∞)) ∧
      ∀ k m : ℕ, k ≤ m →
        torsionLength π k (P ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A P)) =
          ((k * Module.finrank A (P ⧸ Submodule.torsion A P) + ∑ i, min (l i) k : ℕ) : ℕ∞) := by
  classical
  obtain ⟨β, ι, hι, l, ⟨e⟩⟩ := exists_pi_decomposition hπ P
  have hβ : Module.finrank A (P ⧸ Submodule.torsion A P) = β := by
    rw [(Submodule.Quotient.equiv _ _ e (map_torsion e)).finrank_eq,
      finrank_quotient_torsion_prod_pi hπ.ne_zero l]
  refine ⟨ι, hι, l, fun k => ?_, fun k m hkm => ?_⟩
  · rw [torsionLength_congr e k, torsionLength_prod, torsionLength_pi (fun _ : Fin β => A),
      torsionLength_pi]
    simp [torsionLength_self hπ.ne_zero, torsionLength_cyclic hπ]
  · rw [torsionLength_congr (Submodule.Quotient.equiv
        (Ideal.span {π} ^ m • (⊤ : Submodule A P)) (Ideal.span {π} ^ m • ⊤) e
        (by rw [Submodule.map_smul'', Submodule.map_top,
          LinearMap.range_eq_top.2 e.surjective])) k, hβ,
      torsionLength_congr (quotSMulProdEquiv (π := π) m) k, torsionLength_prod,
      torsionLength_congr (quotSMulFreeEquiv (π := π) β m) k,
      torsionLength_congr (quotSMulPiEquiv (π := π) l m) k, torsionLength_pi, torsionLength_pi]
    simp only [torsionLength_cyclic hπ, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      min_eq_right hkm]
    have hmin : ∀ i : ι, min (min (l i) m) k = min (l i) k := fun i => by omega
    simp only [hmin]
    push_cast
    ring

/-- For a finite module over a discrete valuation ring, `π ^ (m - 1)` annihilates the
`π ^ m`-torsion exactly when the `π ^ m`- and `π ^ (m - 1)`-torsion have the same length. -/
theorem pow_smul_torsionBy_eq_bot_iff_torsionLength_eq (hπ : Irreducible π) (P : Type v)
    [AddCommGroup P] [Module A P] [Module.Finite A P] {m : ℕ} (hm : 1 ≤ m) :
    Ideal.span {π} ^ (m - 1) • Submodule.torsionBy A P (π ^ m) = ⊥ ↔
      torsionLength π m P = torsionLength π (m - 1) P := by
  rw [pow_smul_torsionBy_eq_bot_iff_le]
  have hle : Submodule.torsionBy A P (π ^ (m - 1)) ≤ Submodule.torsionBy A P (π ^ m) :=
    Submodule.torsionBy_le_torsionBy_of_dvd _ _ (pow_dvd_pow π (by omega))
  refine ⟨fun h => by rw [torsionLength, torsionLength, le_antisymm hle h], fun h => ?_⟩
  obtain ⟨ι, hι, l, hT, -⟩ := exists_invariantFactors hπ P
  have hne : Module.length A (Submodule.torsionBy A P (π ^ m)) ≠ ⊤ := by
    rw [← torsionLength, hT]
    exact ENat.natCast_ne_top _
  exact (eq_of_le_of_length_eq hle h.symm hne).ge

/-- For a finite module with invariant factors `l`, `π ^ (m - 1)` annihilates the `π ^ m`-torsion
exactly when the truncations of the exponents at `m` and `m - 1` have the same sum. -/
private lemma pow_smul_torsionBy_eq_bot_iff_sum_min_eq (hπ : Irreducible π) (P : Type v)
    [AddCommGroup P] [Module A P] [Module.Finite A P] {m : ℕ} (hm : 1 ≤ m) {ι : Type u}
    [Fintype ι] {l : ι → ℕ} (hT : ∀ k : ℕ, torsionLength π k P = ((∑ i, min (l i) k : ℕ) : ℕ∞)) :
    Ideal.span {π} ^ (m - 1) • Submodule.torsionBy A P (π ^ m) = ⊥ ↔
      ∑ i, min (l i) m = ∑ i, min (l i) (m - 1) := by
  rw [pow_smul_torsionBy_eq_bot_iff_torsionLength_eq hπ P hm, hT, hT, Nat.cast_inj]

/-- **Transfer of a torsion exponent across a mod `π ^ m` comparison.** If the reduction of `H`
modulo `π ^ m` paired with the `π ^ m`-torsion of `H'` is isomorphic to the same pairing for `G`
and `G'`, if `H` and `G` have the same free rank, and if `π ^ (m - 1)` annihilates the
`π ^ m`-torsion of `G` and of `G'`, then it annihilates the `π ^ m`-torsion of `H` and of `H'`. -/
theorem pow_smul_torsionBy_eq_bot_of_linearEquiv_mod_pow (hπ : Irreducible π)
    {H H' G G' : Type*}
    [AddCommGroup H] [Module A H] [Module.Finite A H]
    [AddCommGroup H'] [Module A H'] [Module.Finite A H']
    [AddCommGroup G] [Module A G] [Module.Finite A G]
    [AddCommGroup G'] [Module A G'] [Module.Finite A G']
    {m : ℕ} (hm : 1 ≤ m)
    (hG : Ideal.span {π} ^ (m - 1) • Submodule.torsionBy A G (π ^ m) = ⊥)
    (hG' : Ideal.span {π} ^ (m - 1) • Submodule.torsionBy A G' (π ^ m) = ⊥)
    (hrank : Module.finrank A (H ⧸ Submodule.torsion A H) =
      Module.finrank A (G ⧸ Submodule.torsion A G))
    (hiso : Nonempty (((H ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A H)) ×
          Submodule.torsionBy A H' (π ^ m)) ≃ₗ[A]
        ((G ⧸ Ideal.span {π} ^ m • (⊤ : Submodule A G)) ×
          Submodule.torsionBy A G' (π ^ m)))) :
    Ideal.span {π} ^ (m - 1) • Submodule.torsionBy A H (π ^ m) = ⊥ ∧
      Ideal.span {π} ^ (m - 1) • Submodule.torsionBy A H' (π ^ m) = ⊥ := by
  obtain ⟨e⟩ := hiso
  obtain ⟨ιH, hιH, lH, hTH, hQH⟩ := exists_invariantFactors hπ H
  obtain ⟨ιH', hιH', lH', hTH', -⟩ := exists_invariantFactors hπ H'
  obtain ⟨ιG, hιG, lG, hTG, hQG⟩ := exists_invariantFactors hπ G
  obtain ⟨ιG', hιG', lG', hTG', -⟩ := exists_invariantFactors hπ G'
  have key : ∀ k : ℕ, k ≤ m →
      (∑ i, min (lH i) k) + (∑ i, min (lH' i) k)
        = (∑ i, min (lG i) k) + (∑ i, min (lG' i) k) := by
    intro k hk
    have hL := torsionLength_congr (π := π) e k
    rw [torsionLength_prod, torsionLength_prod, hQH k m hk, hQG k m hk,
      torsionLength_torsionBy hk, torsionLength_torsionBy hk, hTH' k, hTG' k,
      ← Nat.cast_add, ← Nat.cast_add, Nat.cast_inj, hrank, add_assoc, add_assoc] at hL
    exact Nat.add_left_cancel hL
  have e1 := key m le_rfl
  have e2 := key (m - 1) (by omega)
  have mono : ∀ {ι : Type u} [Fintype ι] (l : ι → ℕ),
      ∑ i, min (l i) (m - 1) ≤ ∑ i, min (l i) m :=
    fun l => Finset.sum_le_sum fun i _ => by omega
  have mH := mono lH
  have mH' := mono lH'
  have hGs := (pow_smul_torsionBy_eq_bot_iff_sum_min_eq hπ G hm hTG).1 hG
  have hG's := (pow_smul_torsionBy_eq_bot_iff_sum_min_eq hπ G' hm hTG').1 hG'
  exact ⟨(pow_smul_torsionBy_eq_bot_iff_sum_min_eq hπ H hm hTH).2 (by omega),
    (pow_smul_torsionBy_eq_bot_iff_sum_min_eq hπ H' hm hTH').2 (by omega)⟩

end DiscreteValuationRing

end Stacks.AlgebraicGeometry.FreenessOverDVR
