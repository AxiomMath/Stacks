module

public import Mathlib.RingTheory.QuasiFinite.Basic
public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# An algebra generated by one root of a polynomial with a unit coefficient is quasi-finite

Let `S` be an `R`-algebra generated by a single element `s`, and suppose `s` is a root of a
polynomial `P ∈ R[X]` one of whose coefficients is a unit. Then `S` is quasi-finite over `R`: in
each fibre `κ(p) ⊗_R S` the element `1 ⊗ s` is a root of the image of `P`, which is a nonzero
polynomial over the field `κ(p)` because the unit coefficient stays nonzero, so the fibre is
generated by one algebraic element and is finite-dimensional.

The polynomial need not be monic, so `S` need not be finite over `R`; this is exactly the shape
of a chart of a finite morphism that misses part of the fibre, such as the chart `x ≠ 0` of the
morphism `ℙ¹ × ℙⁿ ⟶ ℙⁿ⁺¹` multiplying binary forms.

## Main results

* `Algebra.QuasiFinite.of_adjoin_singleton_of_isUnit_coeff`: the statement above.
-/

@[expose] public section

open Polynomial TensorProduct

namespace Algebra.QuasiFinite

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- **An algebra generated by one root of a polynomial with a unit coefficient is
quasi-finite.** -/
theorem of_adjoin_singleton_of_isUnit_coeff (s : S) (hs : Algebra.adjoin R {s} = ⊤)
    (P : R[X]) (i : ℕ) (hi : IsUnit (P.coeff i)) (hP : aeval s P = 0) :
    Algebra.QuasiFinite R S := by
  refine ⟨fun p _ => ?_⟩
  set κ := p.ResidueField
  have hadj : Algebra.adjoin κ {(1 : κ) ⊗ₜ[R] s} = ⊤ := by
    have h := Algebra.TensorProduct.adjoin_one_tmul_image_eq_top (A := κ) ({s} : Set S) hs
    simpa using h
  have hne : P.map (algebraMap R κ) ≠ 0 := by
    intro h0
    have hc := congrArg (fun Q => Q.coeff i) h0
    simp only [coeff_map, coeff_zero] at hc
    exact (hi.map (algebraMap R κ)).ne_zero hc
  have hroot : aeval ((1 : κ) ⊗ₜ[R] s) (P.map (algebraMap R κ)) = 0 := by
    rw [aeval_map_algebraMap]
    have := aeval_algHom_apply (Algebra.TensorProduct.includeRight : S →ₐ[R] κ ⊗[R] S) s P
    rw [Algebra.TensorProduct.includeRight_apply, hP, map_zero] at this
    exact this
  have hint : IsIntegral κ ((1 : κ) ⊗ₜ[R] s) := _root_.IsAlgebraic.isIntegral ⟨_, hne, hroot⟩
  have hfg := hint.fg_adjoin_singleton
  rw [hadj, Algebra.top_toSubmodule] at hfg
  exact ⟨hfg⟩

end Algebra.QuasiFinite
