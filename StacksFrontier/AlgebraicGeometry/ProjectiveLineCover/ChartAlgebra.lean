module

public import StacksFrontier.AlgebraicGeometry.ProjectiveLineCover.Multiplication
public import StacksFrontier.AlgebraicGeometry.ProjectiveLineCover.QuasiFiniteAlgebra
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Away

/-!
# The charts of the multiplication of binary forms are quasi-finite

On the chart `D₊(c_k)` of `ℙⁿ⁺¹_ℤ`, the substitution `c_m ↦ a_m + t a_{m-1}` of
`Stacks.ProjectiveLineCover.mulHom` induces the map of degree-zero localizations
`ℤ[c]_{(c_k)} → B[a]_{(ℓ)}`, `ℓ = a_k + t a_{k-1}`. Writing `τ_m = c_m / c_k` and
`w_j = a_j / ℓ`, the relations `τ_m ↦ w_m + t w_{m-1}` solve recursively for every `w_j` as a
polynomial in `t` over the image of `ℤ[c]_{(c_k)}`, and the vanishing of `w_{n+1}` says that
`t` is a root of `Σ_m τ_m (-T)^{n+1-m}`, a polynomial whose coefficient `±τ_k = ±1` is a unit.
When `B` is generated by `t`, the target is therefore generated by `t` over the source, and
`Algebra.QuasiFinite.of_adjoin_singleton_of_isUnit_coeff` makes the map quasi-finite.

## Main results

* `Stacks.ProjectiveLineCover.mem_adjoin_and_aeval_eq_zero`: the recursion, for an arbitrary
  ring homomorphism.
* `Stacks.ProjectiveLineCover.quasiFinite_awayMap_mulHom_one_left` and
  `Stacks.ProjectiveLineCover.quasiFinite_awayMap_mulHom_one_right`: the chart maps of the two
  substitutions `(1, t)` and `(σ, 1)` are quasi-finite.
-/

@[expose] public noncomputable section

open Polynomial

namespace Stacks.ProjectiveLineCover

section Recursion

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The closed form of the recursion `φ(τ_{m+1}) = w_{m+1} + s w_m`, `φ(τ_0) = w_0`. -/
theorem eq_sum_of_recursion (φ : R →+* S) (s : S) (w : ℕ → S) (τ : ℕ → R) (h0 : φ (τ 0) = w 0)
    (hrec : ∀ m, φ (τ (m + 1)) = w (m + 1) + s * w m) (j : ℕ) :
    w j = ∑ m ∈ Finset.range (j + 1), φ (τ m) * (-s) ^ (j - m) := by
  induction j with
  | zero => simp [h0]
  | succ j ih =>
    rw [Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one, hrec j, ih, Finset.mul_sum]
    have : ∀ m ∈ Finset.range (j + 1),
        φ (τ m) * (-s) ^ (j + 1 - m) = -(s * (φ (τ m) * (-s) ^ (j - m))) := by
      intro m hm
      rw [Finset.mem_range] at hm
      rw [show j + 1 - m = (j - m) + 1 by omega, pow_succ]
      ring
    rw [Finset.sum_congr rfl this, Finset.sum_neg_distrib]
    ring

/-- **The recursion.** Under `φ(τ_0) = w_0`, `φ(τ_{m+1}) = w_{m+1} + s w_m` and `w_N = 0`, every
`w_j` lies in the subalgebra generated by `s` over `R`, and `s` is a root of
`Σ_{m ≤ N} τ_m (-X)^{N-m}`. -/
theorem mem_adjoin_and_aeval_eq_zero [Algebra R S] (w : ℕ → S) (τ : ℕ → R) (s : S)
    (h0 : algebraMap R S (τ 0) = w 0)
    (hrec : ∀ m, algebraMap R S (τ (m + 1)) = w (m + 1) + s * w m) (N : ℕ) (hN : w N = 0) :
    (∀ j, w j ∈ Algebra.adjoin R {s}) ∧
      Polynomial.aeval s
        (∑ m ∈ Finset.range (N + 1), Polynomial.C (τ m) * (-Polynomial.X) ^ (N - m)) = 0 := by
  refine ⟨fun j => ?_, ?_⟩
  · rw [eq_sum_of_recursion (algebraMap R S) s w τ h0 hrec j]
    refine Subalgebra.sum_mem _ fun m _ => Subalgebra.mul_mem _ ?_ ?_
    · exact Subalgebra.algebraMap_mem _ (τ m)
    · exact Subalgebra.pow_mem _
        (Subalgebra.neg_mem _ (Algebra.subset_adjoin (Set.mem_singleton s))) _
  · rw [map_sum, ← hN, eq_sum_of_recursion (algebraMap R S) s w τ h0 hrec N]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [map_mul, map_pow, map_neg, Polynomial.aeval_C, Polynomial.aeval_X]

/-- The coefficient of `X ^ (N - k)` in `Σ_{m ≤ N} τ_m (-X)^{N-m}` is `± τ_k`. -/
theorem coeff_sum_neg_X_pow (τ : ℕ → R) (N k : ℕ) (hk : k ≤ N) :
    (∑ m ∈ Finset.range (N + 1),
        Polynomial.C (τ m) * (-Polynomial.X : Polynomial R) ^ (N - m)).coeff (N - k) =
      τ k * (-1) ^ (N - k) := by
  have hterm : ∀ m, Polynomial.C (τ m) * (-Polynomial.X : Polynomial R) ^ (N - m) =
      Polynomial.C (τ m * (-1) ^ (N - m)) * Polynomial.X ^ (N - m) := by
    intro m
    rw [neg_pow, map_mul, map_pow, map_neg, map_one]
    ring
  simp only [hterm, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_eq_single k]
  · rw [if_pos rfl]
  · intro m hm hmk
    rw [Finset.mem_range] at hm
    rw [if_neg]
    omega
  · intro hk'
    simp at hk'
    omega

end Recursion

section Chart

open HomogeneousLocalization MvPolynomial Stacks.AlgebraicGeometry.ProjPolyChart

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {B : Type u} [CommRing B] (n : ℕ)

/-- The image of a coefficient in a degree-zero localization of `B[a₀, …, aₙ]`. -/
def coeffAt {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1) :
    B →+* Away (polyGrading B n) ℓ :=
  (fromZeroRingHom (polyGrading B n) _).comp (algebraMap B (polyGrading B n 0))

/-- The fraction `x / ℓ` of a form `x` of degree one. -/
def frac {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1)
    (x : MvPolynomial (Fin (n + 1)) B) (hx : x ∈ polyGrading B n 1) :
    Away (polyGrading B n) ℓ :=
  Away.mk (polyGrading B n) hℓ 1 x (by simpa using hx)

/-- The comparison `B[Y₀, …, Yₙ] → B[a]_{(ℓ)}`, `Y_j ↦ a_j / ℓ`. -/
def fracHom {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1) :
    MvPolynomial (Fin (n + 1)) B →+* Away (polyGrading B n) ℓ :=
  eval₂Hom (coeffAt n hℓ) fun j => frac n hℓ (X j) (X_mem_one B n j)

/-- `fracHom` sends a monomial `∏ₖ X_k ^ e_k` of total degree `a` to the fraction
`(∏ₖ a_k ^ e_k) / ℓ ^ a`. -/
theorem fracHom_prod_X {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1)
    (ak : Fin (n + 1) → ℕ) (a : ℕ) (hsum : ∑ k, ak k = a)
    (ha : (∏ k, (X k : MvPolynomial (Fin (n + 1)) B) ^ ak k) ∈ polyGrading B n (a • 1)) :
    fracHom n hℓ (∏ k, X k ^ ak k) = Away.mk (polyGrading B n) hℓ a (∏ k, X k ^ ak k) ha := by
  rw [map_prod]
  simp only [map_pow, fracHom, eval₂Hom_X', frac]
  rw [HomogeneousLocalization.ext_iff_val]
  rw [show (∏ k, Away.mk (polyGrading B n) hℓ 1 (X k)
        (by simpa using X_mem_one B n k) ^ ak k).val
      = algebraMap (Away (polyGrading B n) ℓ) (Localization (Submonoid.powers ℓ))
          (∏ k, Away.mk (polyGrading B n) hℓ 1 (X k) (by simpa using X_mem_one B n k) ^ ak k)
      from (HomogeneousLocalization.algebraMap_apply _).symm, map_prod]
  simp only [map_pow, HomogeneousLocalization.algebraMap_apply, Away.val_mk,
    Localization.mk_pow, Localization.mk_prod]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul, SubmonoidClass.coe_pow, pow_one,
    Finset.prod_pow_eq_pow_sum, hsum]

/-- **Every element of `B[a]_{(ℓ)}` is a polynomial over `B` in the fractions `a_j / ℓ`.** -/
theorem fracHom_surjective {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1) :
    Function.Surjective (fracHom n hℓ) := by
  intro z
  have hspan := HomogeneousLocalization.Away.span_mk_prod_pow_eq_top
      (𝒜 := polyGrading B n) hℓ (ι' := Fin (n + 1)) MvPolynomial.X
      (adjoin_range_X_eq_top B n) (fun _ => 1) (fun j => X_mem_one B n j)
  have hz : z ∈ (⊤ : Submodule (polyGrading B n 0) (Away (polyGrading B n) ℓ)) :=
    Submodule.mem_top
  rw [← hspan] at hz
  induction hz using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨b, ak, hai, rfl⟩ := hx
      exact ⟨∏ k, X k ^ ak k, fracHom_prod_X n hℓ ak b (by simpa using hai) _⟩
  | zero => exact ⟨0, map_zero _⟩
  | add x y hx hy ihx ihy =>
      obtain ⟨p, hp⟩ := ihx
      obtain ⟨q, hq⟩ := ihy
      exact ⟨p + q, by rw [map_add, hp, hq]⟩
  | smul r₀ x hx ih =>
      obtain ⟨p, hp⟩ := ih
      obtain ⟨r, hr⟩ := exists_algebraMap_eq B n r₀
      refine ⟨MvPolynomial.C r * p, ?_⟩
      rw [map_mul, hp, Algebra.smul_def, ← hr]
      simp [fracHom, coeffAt]
      rfl

/-- The fraction `(x + y) / ℓ` is `x / ℓ + y / ℓ`. -/
theorem frac_add {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1)
    (x y : MvPolynomial (Fin (n + 1)) B) (hx : x ∈ polyGrading B n 1)
    (hy : y ∈ polyGrading B n 1) :
    frac n hℓ (x + y) (add_mem hx hy) = frac n hℓ x hx + frac n hℓ y hy := by
  ext
  simp only [frac, val_add, Away.val_mk, Localization.add_mk_self]

/-- The fraction `(b x) / ℓ` is the image of `b` times `x / ℓ`. -/
theorem frac_C_mul {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1) (b : B)
    (x : MvPolynomial (Fin (n + 1)) B) (hx : x ∈ polyGrading B n 1)
    (hbx : MvPolynomial.C b * x ∈ polyGrading B n 1) :
    frac n hℓ (MvPolynomial.C b * x) hbx = coeffAt n hℓ b * frac n hℓ x hx := by
  ext
  simp only [frac, val_mul, Away.val_mk, coeffAt, RingHom.comp_apply, val_fromZeroRingHom,
    SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
  rw [Localization.mk_mul, one_mul]

/-- The fraction `0 / ℓ` is zero. -/
theorem frac_zero {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1)
    (h0 : (0 : MvPolynomial (Fin (n + 1)) B) ∈ polyGrading B n 1) : frac n hℓ 0 h0 = 0 := by
  ext
  simp [frac, Away.val_mk, Localization.mk_zero]

/-- Equal forms have equal fractions. -/
theorem frac_congr {ℓ : MvPolynomial (Fin (n + 1)) B} (hℓ : ℓ ∈ polyGrading B n 1)
    {x y : MvPolynomial (Fin (n + 1)) B} (hx : x ∈ polyGrading B n 1) (h : x = y) :
    frac n hℓ x hx = frac n hℓ y (h ▸ hx) := by
  subst h; rfl

/-- The affine coordinate `c_m / c_k` on the chart `D₊(c_k)` of `ℙⁿ⁺¹_ℤ`. -/
def tau (k : Fin (n + 2)) (m : ℕ) : Away (polyGrading (ULift.{u} ℤ) (n + 1)) (X k) :=
  Away.mk _ (X_mem_one (ULift.{u} ℤ) (n + 1) k) 1 (var (n + 1) m)
    (by simpa using var_mem (B := ULift.{u} ℤ) (n + 1) m)

/-- The coordinate `c_k / c_k` on the chart `D₊(c_k)` is one. -/
theorem tau_self (k : Fin (n + 2)) : tau.{u} n k k = 1 := by
  ext
  simp [tau, var, Away.val_mk, k.2]

/-- **The recursion criterion for quasi-finiteness of a chart map.** Let
`ψ : ℤ[c₀, …, c_{n+1}] → B[a₀, …, aₙ]` be graded with `B` generated by `t` as a ring, and suppose
there are forms `num m` of degree one in the `c` and `W j` of degree one in the `a` with
`ψ(num 0) = W 0`, `ψ(num (m+1)) = W (m+1) + t W m`, `W (n+1) = 0`, `num j₀ = c_k`, and every `a_j`
among the `W`. Then the chart map at `c_k` is quasi-finite. -/
theorem quasiFinite_awayMap_of_recursion
    (ψ : Stacks.ProjectiveCohomology.polyGrading (ULift.{u} ℤ) (n + 1) →+*ᵍ
      Stacks.ProjectiveCohomology.polyGrading B n)
    (t : B) (hB : ∀ b : B, b ∈ Subring.closure {t}) (k : Fin (n + 2))
    (num : ℕ → MvPolynomial (Fin (n + 2)) (ULift.{u} ℤ))
    (hnum : ∀ m, num m ∈ polyGrading (ULift.{u} ℤ) (n + 1) 1)
    (W : ℕ → MvPolynomial (Fin (n + 1)) B) (hW : ∀ j, W j ∈ polyGrading B n 1)
    (h0 : ψ (num 0) = W 0) (hrec : ∀ m, ψ (num (m + 1)) = W (m + 1) + MvPolynomial.C t * W m)
    (hN : W (n + 1) = 0) (j₀ : ℕ) (hj₀ : j₀ ≤ n + 1) (hnumk : num j₀ = X k)
    (hgen : ∀ j : Fin (n + 1), ∃ m, W m = X j) :
    (Away.map ψ (X k)).QuasiFinite := by
  have hℓ : ψ (X k) ∈ polyGrading B n 1 := ψ.2 (X_mem_one (ULift.{u} ℤ) (n + 1) k)
  let := (Away.map ψ (X k)).toAlgebra
  let τ : ℕ → Away (Stacks.ProjectiveCohomology.polyGrading (ULift.{u} ℤ) (n + 1)) (X k) :=
    fun m => Away.mk _ (X_mem_one (ULift.{u} ℤ) (n + 1) k) 1 (num m) (by simpa using hnum m)
  have hτ : ∀ m, algebraMap _ (Away (polyGrading B n) (ψ (X k))) (τ m) =
      frac n hℓ (ψ (num m)) (ψ.2 (hnum m)) := by
    intro m
    rw [RingHom.algebraMap_toAlgebra, Away.map_mk]
    rfl
  set s : Away (polyGrading B n) (ψ (X k)) := coeffAt n hℓ t
  set w : ℕ → Away (polyGrading B n) (ψ (X k)) := fun j => frac n hℓ (W j) (hW j)
  have hw0 : algebraMap _ _ (τ 0) = w 0 := by
    rw [hτ, frac_congr n hℓ _ h0]
  have hwrec : ∀ m, algebraMap _ _ (τ (m + 1)) = w (m + 1) + s * w m := by
    intro m
    rw [hτ, frac_congr n hℓ _ (hrec m), frac_add n hℓ _ _ (hW (m + 1)),
      frac_C_mul n hℓ t _ (hW m)]
    simpa using SetLike.mul_mem_graded
      ((MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_C _ t)) (hW m)
  have hwN : w (n + 1) = 0 := by
    show frac n hℓ (W (n + 1)) (hW (n + 1)) = 0
    rw [frac_congr n hℓ _ hN, frac_zero]
  obtain ⟨hw, hP⟩ := mem_adjoin_and_aeval_eq_zero
    (R := Away (Stacks.ProjectiveCohomology.polyGrading (ULift.{u} ℤ) (n + 1)) (X k))
    w τ s hw0 hwrec (n + 1) hwN
  refine Algebra.QuasiFinite.of_adjoin_singleton_of_isUnit_coeff
    (R := Away (Stacks.ProjectiveCohomology.polyGrading (ULift.{u} ℤ) (n + 1)) (X k))
    s ?_ _ (n + 1 - j₀) ?_ hP
  · rw [eq_top_iff]
    rintro z -
    obtain ⟨p, rfl⟩ := fracHom_surjective n hℓ z
    induction p using MvPolynomial.induction_on with
    | C b =>
      rw [show fracHom n hℓ (MvPolynomial.C b) = coeffAt n hℓ b from eval₂Hom_C _ _ _]
      refine Subring.closure_induction (p := fun b _ => coeffAt n hℓ b ∈ Algebra.adjoin _ {s})
        ?_ ?_ ?_ ?_ ?_ ?_ (hB b)
      · rintro x rfl; exact Algebra.subset_adjoin rfl
      · rw [map_zero]; exact zero_mem _
      · rw [map_one]; exact one_mem _
      · intro x y _ _ hx hy; rw [map_add]; exact add_mem hx hy
      · intro x _ hx; rw [map_neg]; exact neg_mem hx
      · intro x y _ _ hx hy; rw [map_mul]; exact mul_mem hx hy
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p j hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      obtain ⟨m, hm⟩ := hgen j
      have hX : fracHom n hℓ (X j) = w m := by
        simp only [fracHom, eval₂Hom_X', w]
        exact frac_congr n hℓ _ hm.symm
      rw [hX]
      exact hw m
  · rw [coeff_sum_neg_X_pow _ _ _ hj₀]
    have hτk : τ j₀ = 1 := by
      ext
      simp [τ, hnumk, Away.val_mk]
    rw [hτk, one_mul]
    exact (isUnit_one.neg).pow _

/-- The variable `var n j` is zero past the end. -/
private theorem var_eq_zero (j : ℕ) (h : n < j) : var (B := B) n j = 0 := by
  simp [var]; omega

/-- **The chart maps of the substitution `(1, t)` are quasi-finite**, when `B` is generated by
`t` as a ring. -/
theorem quasiFinite_awayMap_mulHom_one_left (t : B) (hB : ∀ b : B, b ∈ Subring.closure {t})
    (k : Fin (n + 2)) : (Away.map (mulHom n 1 t) (X k)).QuasiFinite := by
  refine quasiFinite_awayMap_of_recursion n (mulHom n 1 t) t hB k (var (n + 1))
    (fun m => by simpa using var_mem (B := ULift.{u} ℤ) (n + 1) m) (var n) (var_mem n)
    ?_ ?_ (by simp [var]) k (by omega) (by simp [var, k.2]) fun j => ⟨j, by simp [var, j.2]⟩
  · rw [show var (B := ULift.{u} ℤ) (n + 1) 0 = X 0 by simp [var], mulHom_X]
    simp [mulForm]
  · intro m
    by_cases hm : m + 1 < n + 2
    · rw [show var (B := ULift.{u} ℤ) (n + 1) (m + 1) = X ⟨m + 1, hm⟩ by simp [var, hm],
        mulHom_X]
      simp [mulForm]
    · rw [var_eq_zero (n + 1) (m + 1) (by omega), map_zero, var_eq_zero n (m + 1) (by omega),
        var_eq_zero n m (by omega)]
      simp

/-- The variables of `B[a₀, …, aₙ]` in reverse order, read as zero past the end. -/
def rvar (j : ℕ) : MvPolynomial (Fin (n + 1)) B := if j ≤ n then var n (n - j) else 0

/-- Each `rvar n j` is a form of degree one. -/
theorem rvar_mem (j : ℕ) : rvar (B := B) n j ∈ polyGrading B n 1 := by
  unfold rvar; split_ifs
  · exact var_mem n _
  · exact zero_mem _

/-- The variable `rvar n j` is zero past the end. -/
private theorem rvar_eq_zero (j : ℕ) (h : n < j) : rvar (B := B) n j = 0 := by
  simp [rvar]; omega

/-- **The chart maps of the substitution `(σ, 1)` are quasi-finite**, when `B` is generated by
`σ` as a ring: the recursion runs from the top coefficient down. -/
theorem quasiFinite_awayMap_mulHom_one_right (σ : B) (hB : ∀ b : B, b ∈ Subring.closure {σ})
    (k : Fin (n + 2)) : (Away.map (mulHom n σ 1) (X k)).QuasiFinite := by
  refine quasiFinite_awayMap_of_recursion n (mulHom n σ 1) σ hB k (rvar (n + 1))
    (fun m => by simpa using rvar_mem (B := ULift.{u} ℤ) (n + 1) m) (rvar n) (rvar_mem n)
    ?_ ?_ (by simp [rvar]) (n + 1 - k) (by omega) ?_ fun j => ⟨n - j, ?_⟩
  · rw [show rvar (B := ULift.{u} ℤ) (n + 1) 0 = X (Fin.last (n + 1)) by
      simp [rvar, var, Fin.last], mulHom_X]
    simp [mulForm, rvar, var, Fin.last]
  · intro m
    by_cases hm : m + 1 ≤ n + 1
    · rw [show rvar (B := ULift.{u} ℤ) (n + 1) (m + 1) = X ⟨n - m, by omega⟩ by
        simp [rvar, var, hm, show n - m < n + 2 by omega], mulHom_X]
      by_cases hm' : m + 1 ≤ n
      · simp [mulForm, rvar, var, hm', show m ≤ n by omega,
          show n - m - 1 = n - (m + 1) by omega, show n - m ≠ 0 by omega]
        ring
      · have hmn : m = n := by omega
        subst hmn
        simp [mulForm, rvar, var]
    · rw [rvar_eq_zero (n + 1) (m + 1) (by omega), map_zero, rvar_eq_zero n (m + 1) (by omega),
        rvar_eq_zero n m (by omega)]
      simp
  · simp [rvar, var, show n + 1 - k ≤ n + 1 by omega, show n + 1 - (n + 1 - (k : ℕ)) = k by omega,
      k.2]
  · simp [rvar, var, show n - (j : ℕ) ≤ n by omega, show n - (n - (j : ℕ)) = j by omega, j.2]

end Chart

end Stacks.ProjectiveLineCover
