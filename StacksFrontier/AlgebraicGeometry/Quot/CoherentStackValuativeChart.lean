-/

@[expose] public section

open scoped nonZeroDivisors

namespace StacksDraft.CoherentGenericFibre

universe u v w x

variable {R : Type u} [CommRing R]
  {A : Type v} [CommRing A] [Algebra R A]
  (AK : Type w) [CommRing AK] [Algebra A AK]
    [IsLocalization (Algebra.algebraMapSubmonoid A R⁰) AK]
  {N : Type x} [AddCommGroup N] [Module R N] [Module A N] [IsScalarTower R A N]
    [Module AK N] [IsScalarTower A AK N]

/-- **Stacks 0539.**  A torsion free module over a valuation ring is flat.  Mathlib proves the
equivalence of flatness with the vanishing of the torsion submodule over a Bézout domain, and a
valuation ring is a Bézout domain.

This is `StacksDraft.GenericFibre.flat_of_isTorsionFree`; see the implementation notes. -/
@[ega "0 6.3.4" "local case: A a DVR", sga "1 IV 1.3" "(ii)"]
private theorem flat_of_isTorsionFree [IsDomain R] [ValuationRing R] (P : Type*)
    [AddCommGroup P] [Module R P] (h : Module.IsTorsionFree R P) : Module.Flat R P := by
  rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
    ← Submodule.isTorsionFree_iff_torsion_eq_bot]
  exact h

omit [IsLocalization (Algebra.algebraMapSubmonoid A R⁰) AK] in
/-- The `R`-action on the generic fibre is the `A_K`-action along the two structure maps: this is
the chart-level statement that the `R`-module structure of `j_*F_K` is the restriction of its
`𝒪_{X_K}`-module structure. -/
private theorem smul_eq_algebraMap_smul (r : R) (y : N) :
    r • y = (algebraMap A AK (algebraMap R A r)) • y := by
  rw [IsScalarTower.algebraMap_smul AK, IsScalarTower.algebraMap_smul A]

include A AK in
/-- A nonzero element of `R` acts bijectively on the generic fibre: it becomes a unit in the
chart `A_K` of the generic fibre, which is a localization of `A` at the image of the nonzero
elements of `R`. -/
private theorem bijective_smul (s : R⁰) : Function.Bijective fun y : N => (s : R) • y := by
  have hmem : algebraMap R A (s : R) ∈ Algebra.algebraMapSubmonoid A R⁰ := ⟨(s : R), s.2, rfl⟩
  obtain ⟨v, hv⟩ := (IsLocalization.map_units AK
    (⟨algebraMap R A (s : R), hmem⟩ : Algebra.algebraMapSubmonoid A R⁰)).exists_left_inv
  have hleft : ∀ y : N, v • ((s : R) • y) = y := fun y => by
    rw [smul_eq_algebraMap_smul (R := R) (A := A) AK (N := N) (s : R) y, smul_smul, hv, one_smul]
  have hright : ∀ y : N, (s : R) • (v • y) = y := fun y => by
    rw [smul_eq_algebraMap_smul (R := R) (A := A) AK (N := N) (s : R) (v • y), smul_smul,
      mul_comm _ v, hv, one_smul]
  exact Function.bijective_iff_has_inverse.2 ⟨fun y => v • y, hleft, hright⟩

include A AK in
/-- The generic fibre is torsion free over the valuation ring.  This is the source's step that
`j_*F_K`, being a sheaf of `K`-vector spaces, is flat over `R`: on the chart it says that the
nonzero elements of `R` act injectively, because they act bijectively. -/
theorem isTorsionFree_of_isLocalization [IsDomain R] : Module.IsTorsionFree R N := by
  rw [Module.isTorsionFree_iff_smul_eq_zero]
  intro r y hry
  rcases eq_or_ne r 0 with h | h
  · exact Or.inl h
  exact Or.inr ((bijective_smul (A := A) AK ⟨r, mem_nonZeroDivisors_of_ne_zero h⟩).injective
    (by simpa using hry))

include A AK in
/-- **The flatness step of Stacks 0DM0, which is Stacks 0539.**  Every `A`-submodule of the
generic fibre is flat over the valuation ring: it is torsion free, being a submodule of a
torsion free module, and over a valuation ring torsion free modules are flat.  In the source
this is applied to the finite type quasi-coherent submodules `F_i` of `j_*F_K`. -/
theorem flat_of_submodule [IsDomain R] [ValuationRing R] (M : Submodule A N) :
    Module.Flat R M := by
  have : Module.IsTorsionFree R N := isTorsionFree_of_isLocalization (A := A) AK
  exact flat_of_isTorsionFree _
    (Function.Injective.moduleIsTorsionFree (R := R) (fun m : M => (m : N))
      Subtype.val_injective fun _ _ => rfl)

/-- Denominator clearing in the scalar direction: if a nonzero multiple of `y` lies in an
`A`-submodule `M`, then so does some nonzero multiple of any `A_K`-multiple of `y`.  Writing the
scalar as a fraction `a / d` with `d` the image of `t ∈ R⁰`, the element `t • (c • y)` is `a • y`,
and `M` absorbs both `a` and the original denominator. -/
private theorem exists_smul_smul_mem (M : Submodule A N) (c : AK) {y : N} {s : R⁰}
    (hs : (s : R) • y ∈ M) : ∃ t : R⁰, (t : R) • (c • y) ∈ M := by
  obtain ⟨⟨a, d⟩, rfl⟩ := IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid A R⁰) c
  obtain ⟨t₀, ht₀, hd⟩ := d.2
  refine ⟨s * ⟨t₀, ht₀⟩, ?_⟩
  have key : (t₀ : R) • (IsLocalization.mk' AK a d • y) = a • y := by
    rw [smul_eq_algebraMap_smul (R := R) (A := A) AK (N := N) t₀, hd, smul_smul,
      IsLocalization.mk'_spec', IsScalarTower.algebraMap_smul AK]
  rw [Submonoid.coe_mul, mul_smul, key, smul_comm]
  exact M.smul_mem _ hs

include A AK in
/-- Every element of the generic fibre has a nonzero multiple in the `A`-submodule generated by
an `A_K`-generating family.  This is the chart-level form of the source's step that
`F_K = colim j^*F_i`: the `A`-span of the family is already large enough after clearing
denominators. -/
private theorem exists_smul_mem_span (T : Finset N) (hT : Submodule.span AK (T : Set N) = ⊤)
    (y : N) : ∃ s : R⁰, (s : R) • y ∈ Submodule.span A (T : Set N) := by
  have hy : y ∈ Submodule.span AK (T : Set N) := hT ▸ Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem x hx => exact ⟨1, by simpa using Submodule.subset_span hx⟩
  | zero => exact ⟨1, by simp⟩
  | add x z _ _ hx hz =>
    obtain ⟨s₁, h₁⟩ := hx
    obtain ⟨s₂, h₂⟩ := hz
    refine ⟨s₁ * s₂, ?_⟩
    rw [Submonoid.coe_mul, smul_add]
    refine Submodule.add_mem _ ?_ ?_
    · rw [mul_comm, mul_smul]
      exact Submodule.smul_of_tower_mem _ _ h₁
    · rw [mul_smul]
      exact Submodule.smul_of_tower_mem _ _ h₂
  | smul c x _ hx =>
    obtain ⟨s, hs⟩ := hx
    exact exists_smul_smul_mem AK _ c hs

/-- **Stacks 0DM0, on an affine chart over a valuation ring.**  Let `R` be a valuation ring, `A`
an `R`-algebra and `A_K` the localization of `A` at the nonzero elements of `R`, that is, the
chart of the generic fibre.  Let `N` be an `A_K`-module of finite type, the coherent module on
the generic fibre.  Then there is an `A`-submodule `M` of `N` which is of finite type over `A`,
flat over `R`, and whose generic fibre is `N`, in that `N` is the localization of `M` at the
nonzero elements of `R`.

This is the chart-wise content of the source's proof: `M` is generated over `A` by a finite
`A_K`-generating family of `N`, it is flat over `R` because it is torsion free and `R` is a
valuation ring (Stacks 0539), and its generic fibre is all of `N` because denominators can be
cleared. -/
@[stacks 0DM0 "the affine-chart case: over a valuation ring a module of finite type on the \
chart of the generic fibre is the generic fibre of a module of finite type on the chart which is \
flat over the valuation ring, its flatness being Stacks 0539 and its generic fibre being \
identified by a localization; the base-change reduction of the first step, the gluing of the \
chart-wise extensions over Stacks 0829, the proper support, the finite presentation of \
Stacks 0DLR, and hence the statement for the 1-morphism Cohstack_{X/B} -> B in the sense of \
Stacks 0CLK are not covered"]
theorem exists_submodule_finite_flat_isLocalizedModule [IsDomain R] [ValuationRing R]
    [Module.Finite AK N] :
    ∃ M : Submodule A N, Module.Finite A M ∧ Module.Flat R M ∧
      IsLocalizedModule R⁰ (LinearMap.restrictScalars R M.subtype) := by
  obtain ⟨T, hT⟩ := Module.finite_def.mp (inferInstance : Module.Finite AK N)
  refine ⟨Submodule.span A (T : Set N), Module.Finite.iff_fg.2 (Submodule.fg_span T.finite_toSet),
    flat_of_submodule AK _, ?_⟩
  refine ⟨fun s => (Module.End.isUnit_iff _).2 ?_, fun y => ?_, fun {x₁ x₂} h => ⟨1, ?_⟩⟩
  · have he : ⇑((algebraMap R (Module.End R N)) (s : R)) = fun y : N => (s : R) • y := rfl
    rw [he]
    exact bijective_smul (A := A) AK (N := N) s
  · obtain ⟨s, hs⟩ := exists_smul_mem_span (R := R) (A := A) AK T hT y
    exact ⟨⟨⟨(s : R) • y, hs⟩, s⟩, rfl⟩
  · rw [Subtype.ext h]

/-! ### The hypotheses are satisfiable

The standing hypotheses are those of a chart of `X` together with the corresponding chart of the
generic fibre, and they are met in the smallest case, `X = Spec(R)` with its own fraction field
as the generic fibre.  This is recorded so that the quantification over the chart of the generic
fibre above is visibly not empty. -/

example (R : Type u) [CommRing R] [IsDomain R] :
    IsLocalization (Algebra.algebraMapSubmonoid R R⁰) (FractionRing R) := by
  rw [show Algebra.algebraMapSubmonoid R R⁰ = R⁰ from by
    simp [Algebra.algebraMapSubmonoid, Submonoid.ext_iff]]
  infer_instance

example (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] :
    letI : IsLocalization (Algebra.algebraMapSubmonoid R R⁰) (FractionRing R) := by
      rw [show Algebra.algebraMapSubmonoid R R⁰ = R⁰ from by
        simp [Algebra.algebraMapSubmonoid, Submonoid.ext_iff]]
      infer_instance
    ∃ M : Submodule R (FractionRing R), Module.Finite R M ∧ Module.Flat R M ∧
      IsLocalizedModule R⁰ (LinearMap.restrictScalars R M.subtype) :=
  exists_submodule_finite_flat_isLocalizedModule (A := R) (FractionRing R)

end StacksDraft.CoherentGenericFibre

end
