namespace C1764Prereq

open Stacks.SheafOfModules.Invertible (tensorPower tensorPower_isInvertible)

/-- Let `Y` be a proper curve over a field `k` with `H⁰(Y, 𝒪_Y) = k`, at-worst-nodal singularities,
genus `g ≥ 2` and no rational tail. For `m ≥ 2` the power `ω_Y^{⊗ m}` of its dualizing sheaf is
generated by global sections and has `H¹(Y, ω_Y^{⊗ m}) = 0`. -/
theorem isGeneratedByGlobalSections_and_isZero_cohomology_one_of_two_le_genus (k : Type u)
    [Field k] {Y : Scheme.{u}} [Y.Over (Spec (.of k))] [IsProper (Y ↘ Spec (.of k))]
    (hdim : topologicalKrullDim Y = 1)
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ (Y ↘ Spec (.of k)).appTop)]
    (hnodal : Stacks.Curves.HasAtWorstNodalSingularities k Y)
    (htail : ∀ C : Y.IdealSheafData, ¬ IsRationalTail k Y C)
    (hg : 2 ≤ genus (Y ↘ Spec (.of k))) (m : ℕ) (hm : 2 ≤ m) :
    haveI := connectedSpace_of_isIso_globalSections k (Y ↘ Spec (.of k))
    letI := isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities k Y hdim hnodal
    SheafOfModules.IsGeneratedByGlobalSections (tensorPower Y.presheaf Y.ringCatSheaf.2
        (Stacks.Duality.dualizingSheafOverField (Y ↘ Spec (.of k))) m) ∧
      IsZero (cohomologyOverField k (Y ↘ Spec (.of k)) (tensorPower Y.presheaf Y.ringCatSheaf.2
        (Stacks.Duality.dualizingSheafOverField (Y ↘ Spec (.of k))) m) 1) := by
  have := connectedSpace_of_isIso_globalSections k (Y ↘ Spec (.of k))
  let := isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities k Y hdim hnodal
  have hgen :=
    isGeneratedByGlobalSections_tensorPower_dualizingSheafOverField_of_forall_not_isRationalTail
      hdim hnodal htail hg m hm
  refine ⟨hgen, ?_⟩
  have : IsReduced Y := Stacks.Curves.isReduced_of_hasAtWorstNodalSingularities k Y hnodal
  have hequi := equidimensional_of_isIso_globalSections_of_dimension_one k (Y ↘ Spec (.of k)) hdim
  let S : CohenMacaulayCurveSituation.{u} := ⟨k, Y, Y ↘ Spec (.of k), hdim⟩
  have hdeg := invertibleCurveDegree_dualizingSheafOverField_of_isInvertible k (Y ↘ Spec (.of k))
    hdim.le
  have hpos : 0 < invertibleCurveDegree S.k S.f S.dimension_one.le
      (Stacks.Duality.dualizingSheafOverField S.f) := by
    show 0 < invertibleCurveDegree k (Y ↘ Spec (.of k)) hdim.le
      (Stacks.Duality.dualizingSheafOverField (Y ↘ Spec (.of k)))
    rw [hdeg]
    omega
  exact S.isZero_cohomologyOverField_one_dualizingSheafOverField_tensorPower hequi hpos
    (m := (m : ℤ)) (by exact_mod_cast hm) hgen.some

/-- Let `Y` be a proper curve over a field `k` with `H⁰(Y, 𝒪_Y) = k` and at-worst-nodal
singularities. If `ω_Y^{⊗ m}` is generated by global sections for some `m ≥ 1`, then `Y` has no
rational tail. -/
theorem forall_not_isRationalTail_of_isGeneratedByGlobalSections (k : Type u)
    [Field k] {Y : Scheme.{u}} [Y.Over (Spec (.of k))] [IsProper (Y ↘ Spec (.of k))]
    (hdim : topologicalKrullDim Y = 1)
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ (Y ↘ Spec (.of k)).appTop)]
    (hnodal : Stacks.Curves.HasAtWorstNodalSingularities k Y) (m : ℕ) (hm : 0 < m)
    (hgen : haveI := connectedSpace_of_isIso_globalSections k (Y ↘ Spec (.of k))
      letI := isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities k Y hdim hnodal
      SheafOfModules.IsGeneratedByGlobalSections (tensorPower Y.presheaf Y.ringCatSheaf.2
        (Stacks.Duality.dualizingSheafOverField (Y ↘ Spec (.of k))) m)) :
    ∀ C : Y.IdealSheafData, ¬ IsRationalTail k Y C := by
  intro C hC
  have := connectedSpace_of_isIso_globalSections k (Y ↘ Spec (.of k))
  let := isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities k Y hdim hnodal
  have hneg := invertibleCurveDegree_pullback_dualizingSheafOverField_neg_of_isRationalTail hdim
    hnodal C hC
  have : IsIntegral C.subscheme := hC.isIntegral
  have hnn := invertibleCurveDegree_pullback_nonneg_of_isGeneratedByGlobalSections k
    (C.subschemeι ≫ (Y ↘ Spec (.of k)))
    (Stacks.Curves.topologicalKrullDim_subscheme_eq_one_of_isRationalTail k Y hdim C hC).le
    C.subschemeι _ m hm hgen
  exact absurd hneg (not_lt.2 hnn)

end C1764Prereq

namespace CurveFamily

open Stacks.SheafOfModules.Invertible (tensorPower tensorPower_isInvertible)

/-- Let `f : X → S` be a prestable family of curves of genus `g ≥ 1`, with relative dualizing
complex `ω^•_{X/S}` and relative dualizing sheaf `ω_{X/S} = H^{-1}(ω^•_{X/S})`. Let `s ∈ S` and
`m ≥ 2`. The fibre `X_s` has no rational tail if and only if `f^*f_*ω_{X/S}^{⊗ m} ⟶ ω_{X/S}^{⊗ m}`
is surjective over `f⁻¹(U)` for some open `U ∋ s`. -/
@[stacks 0E6Y]
theorem hasNoRationalTailFibre_iff_isCounitSurjectiveAbove (X : CurveFamily B hZ)
    (hX : IsPrestableCurveFamily B hZ X) {g : ℕ} (hg : X.HasGenus B hZ g) (hg1 : 1 ≤ g)
    (D : Space.RelativeDualizingComplex B.contains_terminal X.toBase X.proper X.flat
      X.finitePresentation)
    (s : (BigFppfOver.toScheme B integerBase hZ).obj X.base) {m : ℕ} (hm : 2 ≤ m) :
    X.HasNoRationalTailFibre B hZ (X.residueFieldPoint s) ↔
      X.IsCounitSurjectiveAbove
        (@Space.invertibleTensorPower B integerBase hZ X.total.1 X.total.2
          (X.dualizingSheafOfComplex D) (isInvertible_dualizingSheafOfComplex hX D) m) s := by
  have hω := isInvertible_dualizingSheafOfComplex hX D
  set ω := X.dualizingSheafOfComplex D
  set L := Space.invertibleTensorPower B integerBase hZ X.total.1 X.total.2 ω m
  have hLinv : Stacks.SheafOfModules.IsInvertible
      (Space.structurePresheaf B integerBase hZ X.total.1) ((Stacks.SheafOfModules.Tensor.ringSheaf
        (Space.smallEtaleRingedSite B integerBase hZ X.total.1 X.total.2).O)).property L :=
    inferInstance
  have hLq : L.IsQuasicoherentOnSite :=
    Space.isQuasicoherentOnSite_of_isInvertibleModule X.total L hLinv
  have hLft : SheafOfModules.IsFiniteTypeOnSite L := by
    have := Space.isFinitePresentationOnSite_of_isInvertibleModule L hLinv
    infer_instance
  have hgen : X.HasFibresOfGenus g :=
    (C1590Private.hasGenus_iff_hasFibresOfGenus_of (C1590Private.hasEtaleLocalSchemeCharts B hZ)
      X hX g).1 hg
  have hfib : ∀ {V : BigFppfOver B integerBase hZ} (v : V ⟶ (X.residueFieldPoint s).siteObject)
      (q : yoneda.obj V ⟶ X.total.obj),
      IsPullback q (yoneda.map v) X.toBase.hom (yonedaEquiv.symm (X.residueFieldPoint s).value) →
      CurveFamily.IsFibrePresentation B hZ X s v q := fun v q h => by
    rw [C1590Private.yonedaEquiv_symm_value] at h
    exact h
  constructor
  · rintro ⟨V, v, q, hpb, htail⟩
    have hq := hfib v q hpb
    have hgV : genus (CurveFamily.fibreMap B hZ X s v) = g := (hgen _).genus_eq v q hpb
    obtain ⟨hprop, hdim, hiso, hnodal⟩ :=
      C1590Private.fibre_properties_of_isPrestableCurveFamily hX (X.residueFieldPoint s) v q hpb
    rcases Nat.lt_or_ge g 2 with hg2 | hg2
    · exact C1764Prereq.isCounitSurjectiveAbove_of_genus_eq_one hX D s hq (by omega) htail m
    have := hq.isProper
    obtain ⟨e⟩ := C1764Prereq.isDualizingOnFibres_dualizingSheafOfComplex hX D s V v q hq
    let : Scheme.Over ((BigFppfOver.toScheme B integerBase hZ).obj V)
        (Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s))) :=
      ⟨CurveFamily.fibreMap B hZ X s v⟩
    have : IsProper (((BigFppfOver.toScheme B integerBase hZ).obj V) ↘
        Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s))) := hprop
    have : IsIso ((Scheme.ΓSpecIso
        (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s))).inv ≫
        (((BigFppfOver.toScheme B integerBase hZ).obj V) ↘
          Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField
            s))).appTop) :=
      hiso
    have hnodal : Stacks.Curves.HasAtWorstNodalSingularities
        (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s)
        ((BigFppfOver.toScheme B integerBase hZ).obj V) := hnodal
    have := connectedSpace_of_isIso_globalSections _
      (((BigFppfOver.toScheme B integerBase hZ).obj V) ↘
        Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s)))
    let := isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities _ _ hdim hnodal
    have : SheafOfModules.IsInvertible ((BigFppfOver.toScheme B integerBase hZ).obj V).presheaf
        ((BigFppfOver.toScheme B integerBase hZ).obj V).ringCatSheaf.2
        (Stacks.Duality.dualizingSheafOverField (CurveFamily.fibreMap B hZ X s v)) :=
      isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities _ _ hdim hnodal
    obtain ⟨hgenω, hH1⟩ :=
      C1764Prereq.isGeneratedByGlobalSections_and_isZero_cohomology_one_of_two_le_genus _ hdim
        hnodal htail (hgV ▸ hg2) m hm
    obtain ⟨eL⟩ := C1764Prereq.nonempty_baseChangeModule_invertibleTensorPower_iso ω V q _ e m
      (by omega)
    have hgenL : SheafOfModules.IsGeneratedByGlobalSections
        (Space.baseChangeModule B integerBase hZ L V q) :=
      ⟨SheafOfModules.GeneratingSections.equivOfIso eL.symm hgenω.some⟩
    have hH1L := hH1.of_iso
      (Stacks.FibreCohomology.cohomologyOverFieldMapIso _ (CurveFamily.fibreMap B hZ X s v) eL 1)
    have hβ := C1764Prereq.epi_moduleBaseChangeMap_fibre_of_isZero_cohomology_one X L hLinv s hq
      hH1L
    exact (C1764Prereq.isCounitSurjectiveAbove_iff_epi_fibre X L hLq hLft s hq).2
      (C1764Prereq.epi_fibre_of_epi_moduleBaseChangeMap X L hLq s hq hβ hgenL)
  · intro h
    obtain ⟨V, v, q, hpb⟩ := C1590Private.exists_presentation_of_fieldValuedPoint X
      (X.residueFieldPoint s)
    have hq := hfib v q hpb
    obtain ⟨hprop, hdim, hiso, hnodal⟩ :=
      C1590Private.fibre_properties_of_isPrestableCurveFamily hX (X.residueFieldPoint s) v q hpb
    refine ⟨V, v, q, hpb, ?_⟩
    have hepi := (C1764Prereq.isCounitSurjectiveAbove_iff_epi_fibre X L hLq hLft s hq).1 h
    have hgenV := C1764Prereq.isGeneratedByGlobalSections_baseChangeModule_of_epi_fibre X L hLq s
      hq hepi
    have := hq.isProper
    obtain ⟨e⟩ := C1764Prereq.isDualizingOnFibres_dualizingSheafOfComplex hX D s V v q hq
    let : Scheme.Over ((BigFppfOver.toScheme B integerBase hZ).obj V)
        (Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s))) :=
      ⟨CurveFamily.fibreMap B hZ X s v⟩
    have : IsProper (((BigFppfOver.toScheme B integerBase hZ).obj V) ↘
        Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s))) := hprop
    have : IsIso ((Scheme.ΓSpecIso
        (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s))).inv ≫
        (((BigFppfOver.toScheme B integerBase hZ).obj V) ↘
          Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField
            s))).appTop) :=
      hiso
    have hnodal : Stacks.Curves.HasAtWorstNodalSingularities
        (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s)
        ((BigFppfOver.toScheme B integerBase hZ).obj V) := hnodal
    have := connectedSpace_of_isIso_globalSections _
      (((BigFppfOver.toScheme B integerBase hZ).obj V) ↘
        Spec (.of (((BigFppfOver.toScheme B integerBase hZ).obj X.base).residueField s)))
    let := isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities _ _ hdim hnodal
    have : SheafOfModules.IsInvertible ((BigFppfOver.toScheme B integerBase hZ).obj V).presheaf
        ((BigFppfOver.toScheme B integerBase hZ).obj V).ringCatSheaf.2
        (Stacks.Duality.dualizingSheafOverField (CurveFamily.fibreMap B hZ X s v)) :=
      isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities _ _ hdim hnodal
    obtain ⟨eL⟩ := C1764Prereq.nonempty_baseChangeModule_invertibleTensorPower_iso ω V q _ e m
      (by omega)
    have hfinal := C1764Prereq.forall_not_isRationalTail_of_isGeneratedByGlobalSections _ hdim
      hnodal m (by omega) ⟨SheafOfModules.GeneratingSections.equivOfIso eL hgenV.some⟩
    exact hfinal

end CurveFamily

end AlgebraicGeometry
