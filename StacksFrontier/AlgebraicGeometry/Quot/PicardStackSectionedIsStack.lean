module

public import StacksFrontier.AlgebraicGeometry.Quot.PicardStackIsStack
public import StacksFrontier.AlgebraicGeometry.Quot.PicardStackModuleHomDescent
public import StacksFrontier.AlgebraicGeometry.Quot.PicardSectionTransportCoherence
public import StacksFrontier.CategoryTheory.Sites.Stack.FaithfulGroupoidDescent

/-!
# The Picard stack rigidified by a section is a stack in groupoids (Stacks 0D29)

In Situation 0D25, given a section `σ` of `f : X ⟶ B`, the category `Picardstack_{X/B, σ}` of
quadruples `(T, h, L, α)`, with `α : 𝒪_T ≅ σ_T^*L` a trivialisation along the section, is a
stack in groupoids over `(Sch/S)_fppf`.

## Main results

* `AlgebraicGeometry.Space.PicardSituation.eq_of_transportTrivialization_eq`: a trivialisation
  is determined by its transports along an fppf covering family of morphisms of
  `Picardstack_{X/B}`.
* `AlgebraicGeometry.Space.PicardSituation.exists_trivialization_of_compatible`: trivialisations
  of the sources of an fppf covering family which agree on the overlaps are the transports of a
  trivialisation of the target.
* `AlgebraicGeometry.Space.sectionedPicardBasedCategory_isStack`: `Picardstack_{X/B, σ}` is a
  stack over the big fppf site of `S` in the sense of Stacks 026F.
* `AlgebraicGeometry.Space.sectionedPicardCFG_isStackInGroupoids`: **Stacks 0D29**,
  `Picardstack_{X/B, σ}` is a stack in groupoids over `(Sch/S)_fppf`.

## Implementation notes

The functor `Picardstack_{X/B, σ} ⟶ Picardstack_{X/B}` forgetting the trivialisation is faithful,
and `Picardstack_{X/B}` is a stack in groupoids (Stacks 04WN,
`AlgebraicGeometry.Space.picardBasedCategory_isStack`). Descent for the trivialisations is
Descent, Proposition 023T for homomorphisms of quasi-coherent modules
(`AlgebraicGeometry.Space.existsUnique_modulePullback_map_eq_of_moduleHomFamilyCompatible`),
applied to `𝒪_T` and `σ_T^*L`, both quasi-coherent because they are invertible. The criterion
`CategoryTheory.Functor.isStack_of_faithful_of_isSheaf` (Stacks 0CKJ) then assembles these.

A trivialisation `β` of the target of `c : Z ⟶ A` transports to `α` exactly when the inverse
image `c^*β` is the *local form* `c^*𝒪_A ≅ 𝒪_Z ⟶ σ_Z^*L_Z ≅ c^*σ_A^*L_A` of `α`
(`AlgebraicGeometry.Space.PicardSituation.localForm`). The local forms of compatible
trivialisations form a compatible family of homomorphisms, glued by Proposition 023T. The
category itself uses the pseudofunctoriality of the direct images of Stacks 03LU
(`AlgebraicGeometry.Space.modulePushforwardCoherence`) and the coherence of the restriction
along the section (`AlgebraicGeometry.Space.sectionTransportCoherence`).
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor

universe w u

/-! ### Transporting a trivialisation, abstractly -/

namespace CategoryTheory.Functor

variable {𝒜 𝒵 𝒲 : Type*} [Category* 𝒜] [Category* 𝒵] [Category* 𝒲]

/-- **The local form of a transported trivialisation is natural.** Abstractly: for comparisons
`spi`, `sti` along `c` and `d` and along the composite, satisfying the two coherences of the
structure sheaf and of the section square, conjugating the local form along `c` by the
comparison of the composite is the local form along the composite of the transport along `d`. -/
theorem conjHom_localForm {Pc : 𝒜 ⥤ 𝒵} {Pd : 𝒵 ⥤ 𝒲} {Pdc : 𝒜 ⥤ 𝒲} (tri : Pdc ≅ Pc ⋙ Pd)
    {OA LA : 𝒜} {OZ LZ : 𝒵} {OW LW : 𝒲} (spic : OZ ≅ Pc.obj OA) (spid : OW ≅ Pd.obj OZ)
    (spidc : OW ≅ Pdc.obj OA) (stic : Pc.obj LA ≅ LZ) (stid : Pd.obj LZ ≅ LW)
    (stidc : Pdc.obj LA ≅ LW)
    (hspi : spidc.symm = tri.app OA ≪≫ Pd.mapIso spic.symm ≪≫ spid.symm)
    (hsti : stidc = tri.app LA ≪≫ Pd.mapIso stic ≪≫ stid) (α : OZ ⟶ LZ) :
    conjHom tri (spic.inv ≫ α ≫ stic.inv) =
      spidc.inv ≫ (spid.hom ≫ Pd.map α ≫ stid.hom) ≫ stidc.inv := by
  have h₁ : spidc.inv = tri.hom.app OA ≫ Pd.map spic.inv ≫ spid.inv := by
    simpa using congrArg Iso.hom hspi
  have h₂ : stidc.inv = stid.inv ≫ Pd.map stic.inv ≫ tri.inv.app LA := by
    simpa using congrArg Iso.inv hsti
  rw [h₁, h₂]
  simp [conjHom]

end CategoryTheory.Functor

namespace CategoryTheory.Sieve

variable {𝒳 𝒞 : Type*} [Category* 𝒳] [Category* 𝒞]

/-- The image of a morphism lifting `g` is `g` up to the identification of the source. -/
private theorem map_eq_eqToHom_comp_of_isHomLift (p : 𝒳 ⥤ 𝒞) {a b : 𝒳} {R : 𝒞}
    (g : R ⟶ p.obj b) (φ : a ⟶ b) [p.IsHomLift g φ] :
    p.map φ = eqToHom (IsHomLift.domain_eq p g φ) ≫ g := by
  rw [IsHomLift.fac' p g φ]
  simp

/-- A sieve each of whose arrows is lifted by a morphism of a family into `b` is contained in the
sieve generated by the images of the family. -/
theorem le_ofArrows_of_isHomLift (p : 𝒳 ⥤ 𝒞) {b : 𝒳} (R : Sieve (p.obj b)) {ι : Type*}
    {a : ι → 𝒳} (c : ∀ i, a i ⟶ b)
    (hc : ∀ ⦃W : 𝒞⦄ (g : W ⟶ p.obj b), R g → ∃ i, p.IsHomLift g (c i)) :
    R ≤ Sieve.ofArrows (fun i ↦ p.obj (a i)) (fun i ↦ p.map (c i)) := by
  intro W g hg
  obtain ⟨i, hi⟩ := hc g hg
  have := hi
  have hg' : g = eqToHom (IsHomLift.domain_eq p g (c i)).symm ≫ p.map (c i) := by
    rw [map_eq_eqToHom_comp_of_isHomLift p g (c i)]
    simp
  rw [hg']
  exact Sieve.downward_closed _ (Sieve.ofArrows_mk _ _ i) _

end CategoryTheory.Sieve

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- A morphism over `g ≫ h` factors through a strongly cartesian morphism over `h` by a morphism
over `g`. -/
private theorem exists_isHomLift_comp_eq {𝒳 𝒞 : Type*} [Category* 𝒳] [Category* 𝒞]
    (p : 𝒳 ⥤ 𝒞) {R R' S : 𝒞} {a a' b : 𝒳} (h : R ⟶ S) (φ' : a ⟶ b)
    [p.IsStronglyCartesian h φ'] {g : R' ⟶ R} {f' : R' ⟶ S} (hf' : f' = g ≫ h) (φ : a' ⟶ b)
    [p.IsHomLift f' φ] : ∃ c : a' ⟶ a, p.IsHomLift g c ∧ c ≫ φ' = φ :=
  ⟨IsStronglyCartesian.map p h φ' hf' φ, inferInstance, IsStronglyCartesian.fac _ _ _ _ _⟩

/-- **Homomorphisms of quasi-coherent modules are determined on a covering family**, the
uniqueness half of Descent, Proposition 023T. -/
theorem modulePullback_map_injective_of_mem {V : BigFppfOver B S hS}
    {M N : Modules.{u, u} B S hS ((schemeSpaceFunctor B S hS).obj V).1
      ((schemeSpaceFunctor B S hS).obj V).2}
    (hM : M.IsQuasicoherentOnSite) (hN : N.IsQuasicoherentOnSite)
    {ι : Type*} {U : ι → BigFppfOver B S hS} (r : ∀ i, U i ⟶ V)
    (hr : Sieve.generate (Presieve.ofArrows U r) ∈ BigFppfOver.topology B S hS V)
    (v w : M ⟶ N)
    (h : ∀ i, (modulePullback B S hS ((schemeSpaceFunctor B S hS).map (r i))).map v =
      (modulePullback B S hS ((schemeSpaceFunctor B S hS).map (r i))).map w) : v = w := by
  obtain ⟨b, -, hu⟩ := existsUnique_modulePullback_map_eq_of_moduleHomFamilyCompatible V M N hM hN
    U r hr (fun i ↦ (modulePullback B S hS ((schemeSpaceFunctor B S hS).map (r i))).map w)
    (moduleHomFamilyCompatible_map M N (fun i ↦ (schemeSpaceFunctor B S hS).map (r i)) w)
  exact (hu v h).trans (hu w fun _ ↦ rfl).symm

namespace PicardSituation

variable {s : PicardSituation B S hS} (σ : s.base ⟶ s.X) (hσ : σ ≫ s.f = 𝟙 s.base)

/-- **The local form of a trivialisation along a morphism of the Picard category**: for
`c : Z ⟶ A` and a trivialisation `α` of `Z`, the homomorphism `c^*𝒪_A ⟶ c^*σ_A^*L_A` which the
inverse image of a trivialisation `β` of `A` must be for `β` to transport to `α`. -/
def localForm {Z A : PicardObject s} (c : PicardHom Z A)
    (α : structureModule (s.baseSpaceAt Z.T) ⟶ (sectionPullback σ hσ Z.T).obj Z.lineBundle) :
    (modulePullback B S hS ((schemeSpaceFunctor B S hS).map c.base.left)).obj
        (structureModule (s.baseSpaceAt A.T)) ⟶
      (modulePullback B S hS ((schemeSpaceFunctor B S hS).map c.base.left)).obj
        ((sectionPullback σ hσ A.T).obj A.lineBundle) :=
  (structureModulePullbackIso ((schemeSpaceFunctor B S hS).map c.base.left)).inv ≫ α ≫
    (sectionTransportIso σ hσ c).inv

/-- A trivialisation transports to `α` exactly when its inverse image is the local form of `α`. -/
theorem transportTrivialization_eq_iff {Z A : PicardObject s} (c : PicardHom Z A)
    (α : structureModule (s.baseSpaceAt Z.T) ⟶ (sectionPullback σ hσ Z.T).obj Z.lineBundle)
    (β : structureModule (s.baseSpaceAt A.T) ⟶ (sectionPullback σ hσ A.T).obj A.lineBundle) :
    transportTrivialization (σ := σ) (hσ := hσ) c β = α ↔
      (modulePullback B S hS ((schemeSpaceFunctor B S hS).map c.base.left)).map β =
        localForm σ hσ c α := by
  rw [transportTrivialization_eq_sectionTransportIso, localForm]
  constructor
  · rintro rfl
    rw [Category.assoc, Category.assoc, Iso.inv_hom_id_assoc, Iso.hom_inv_id, Category.comp_id]
  · intro h
    rw [h, Category.assoc, Category.assoc, Iso.hom_inv_id_assoc, Iso.inv_hom_id,
      Category.comp_id]

/-- **The local form is natural**: along `d : W ⟶ Z`, the restriction of the local form of `α`
along `c` is the local form along `d ≫ c` of the transport of `α` along `d`. -/
theorem restrictPullbackHom_localForm (hc : ModulePushforwardCoherence B S hS)
    {W Z A : PicardObject s} (d : PicardHom W Z) (c : PicardHom Z A)
    (α : structureModule (s.baseSpaceAt Z.T) ⟶ (sectionPullback σ hσ Z.T).obj Z.lineBundle) :
    restrictPullbackHom ((schemeSpaceFunctor B S hS).map d.base.left)
        (schemeSpaceFunctor_map_comp_base d c) (localForm σ hσ c α) =
      localForm σ hσ (d.comp c) (transportTrivialization (σ := σ) (hσ := hσ) d α) := by
  rw [transportTrivialization_eq_sectionTransportIso]
  exact Functor.conjHom_localForm _ _ _ _ _ _ _
    (ModulePushforwardCoherence.structureModulePullbackIso_symm_of_comp _ _
      (schemeSpaceFunctor_map_comp_base d c))
    (sectionTransportIso_comp σ hσ hc d c) α

/-- The local form of an isomorphism is an isomorphism. -/
instance isIso_localForm {Z A : PicardObject s} (c : PicardHom Z A)
    (α : structureModule (s.baseSpaceAt Z.T) ⟶ (sectionPullback σ hσ Z.T).obj Z.lineBundle)
    [IsIso α] : IsIso (localForm σ hσ c α) := by
  rw [localForm]
  infer_instance

/-- The local form depends only on the morphism and the trivialisation, through equalities. -/
theorem restrictPullbackHom_localForm_congr {Z A : PicardObject s} {m m' : PicardHom Z A}
    (em : m = m')
    {α α' : structureModule (s.baseSpaceAt Z.T) ⟶ (sectionPullback σ hσ Z.T).obj Z.lineBundle}
    (eα : α = α') {Y : AlgebraicSpaces B S hS} (e : Y ⟶ s.baseSpaceAt Z.T)
    {k : Y ⟶ s.baseSpaceAt A.T}
    (hk : e ≫ (schemeSpaceFunctor B S hS).map m.base.left = k)
    (hk' : e ≫ (schemeSpaceFunctor B S hS).map m'.base.left = k) :
    restrictPullbackHom e hk (localForm σ hσ m α) =
      restrictPullbackHom e hk' (localForm σ hσ m' α') := by
  subst em eα
  rfl

/-- The structure module of an algebraic space is quasi-coherent. -/
theorem structureModule_isQuasicoherentOnSite (Z : AlgebraicSpaces B S hS) :
    (structureModule Z).IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_of_isInvertibleModule _ _ (isInvertibleModule_structureModule Z)

/-- The restriction along the section of the line bundle of an object of the Picard category is
quasi-coherent. -/
theorem sectionPullback_isQuasicoherentOnSite (A : PicardObject s) :
    ((sectionPullback σ hσ A.T).obj A.lineBundle).IsQuasicoherentOnSite :=
  isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS _ _
    (isQuasicoherentOnSite_of_isInvertibleModule _ _ A.invertible)

/-- **A trivialisation is determined by its transports along a covering family.** -/
theorem eq_of_transportTrivialization_eq {A : PicardObject s} {ι : Type*}
    {Z : ι → PicardObject s} (c : ∀ i, PicardHom (Z i) A)
    (hcov : Sieve.ofArrows (fun i ↦ (Z i).T.left) (fun i ↦ (c i).base.left) ∈
      BigFppfOver.topology B S hS A.T.left)
    {β β' : structureModule (s.baseSpaceAt A.T) ⟶ (sectionPullback σ hσ A.T).obj A.lineBundle}
    (h : ∀ i, transportTrivialization (σ := σ) (hσ := hσ) (c i) β =
      transportTrivialization (σ := σ) (hσ := hσ) (c i) β') : β = β' := by
  refine modulePullback_map_injective_of_mem (structureModule_isQuasicoherentOnSite _)
    (sectionPullback_isQuasicoherentOnSite σ hσ A) (fun i ↦ (c i).base.left) hcov β β'
      fun i ↦ ?_
  have hi0 := h i
  rw [transportTrivialization_eq_sectionTransportIso,
    transportTrivialization_eq_sectionTransportIso] at hi0
  exact (Iso.cancel_iso_hom_right _ _ _).1 ((Iso.cancel_iso_hom_left _ _ _).1 hi0)

/-- **Trivialisations glue along a covering family**: compatible trivialisations of the sources
of a covering family of morphisms into `A`, compatible on the overlaps, are the transports of a
trivialisation of `A`. -/
theorem exists_trivialization_of_compatible (hc : ModulePushforwardCoherence B S hS)
    {A : PicardObject s} {ι : Type*} {Z : ι → PicardObject s} (c : ∀ i, PicardHom (Z i) A)
    (hcov : Sieve.ofArrows (fun i ↦ (Z i).T.left) (fun i ↦ (c i).base.left) ∈
      BigFppfOver.topology B S hS A.T.left)
    (α : ∀ i, structureModule (s.baseSpaceAt (Z i).T) ≅
      (sectionPullback σ hσ (Z i).T).obj (Z i).lineBundle)
    (Q : ι → ι → PicardObject s) (d₁ : ∀ i j, PicardHom (Q i j) (Z i))
    (d₂ : ∀ i j, PicardHom (Q i j) (Z j))
    (hd : ∀ i j, (d₁ i j).comp (c i) = (d₂ i j).comp (c j))
    (hpb : ∀ i j, IsPullback (d₁ i j).base.left (d₂ i j).base.left (c i).base.left
      (c j).base.left)
    (hα : ∀ i j, transportTrivialization (σ := σ) (hσ := hσ) (d₁ i j) (α i).hom =
      transportTrivialization (σ := σ) (hσ := hσ) (d₂ i j) (α j).hom) :
    ∃ β : structureModule (s.baseSpaceAt A.T) ≅ (sectionPullback σ hσ A.T).obj A.lineBundle,
      ∀ i, transportTrivialization (σ := σ) (hσ := hσ) (c i) β.hom = (α i).hom := by
  have hM := structureModule_isQuasicoherentOnSite (s.baseSpaceAt A.T)
  have hN := sectionPullback_isQuasicoherentOnSite σ hσ A
  have hδiso : ∀ i, IsIso (localForm σ hσ (c i) (α i).hom) := fun i ↦
    isIso_localForm σ hσ (c i) (α i).hom
  have hcompat : ModuleHomFamilyCompatible (structureModule (s.baseSpaceAt A.T))
      ((sectionPullback σ hσ A.T).obj A.lineBundle)
      (fun i ↦ (schemeSpaceFunctor B S hS).map (c i).base.left)
      (fun i ↦ localForm σ hσ (c i) (α i).hom) := by
    intro Y i j a b hab
    have hX := isPullback_schemeSpaceFunctor_map (hpb i j)
    obtain ⟨e, he₁, he₂⟩ : ∃ e, e ≫ (schemeSpaceFunctor B S hS).map (d₁ i j).base.left = a ∧
        e ≫ (schemeSpaceFunctor B S hS).map (d₂ i j).base.left = b :=
      ⟨hX.lift a b hab, hX.lift_fst _ _ _, hX.lift_snd _ _ _⟩
    have hk₁ : e ≫ (schemeSpaceFunctor B S hS).map ((d₁ i j).comp (c i)).base.left =
        a ≫ (schemeSpaceFunctor B S hS).map (c i).base.left := by
      rw [← schemeSpaceFunctor_map_comp_base, ← Category.assoc, he₁]
    have hk₂ : e ≫ (schemeSpaceFunctor B S hS).map ((d₂ i j).comp (c j)).base.left =
        a ≫ (schemeSpaceFunctor B S hS).map (c i).base.left := by
      rw [← schemeSpaceFunctor_map_comp_base, ← Category.assoc, he₂]
      exact hab.symm
    show restrictPullbackHom a rfl (localForm σ hσ (c i) (α i).hom) =
      restrictPullbackHom b hab.symm (localForm σ hσ (c j) (α j).hom)
    rw [restrictPullbackHom_congr he₁.symm rfl (by rw [he₁]),
      restrictPullbackHom_congr he₂.symm hab.symm (by rw [he₂]; exact hab.symm),
      restrictPullbackHom_comp _ (schemeSpaceFunctor_map_comp_base (d₁ i j) (c i)) e hk₁,
      restrictPullbackHom_comp _ (schemeSpaceFunctor_map_comp_base (d₂ i j) (c j)) e hk₂]
    rw [restrictPullbackHom_localForm σ hσ hc (d₁ i j) (c i),
      restrictPullbackHom_localForm σ hσ hc (d₂ i j) (c j)]
    exact restrictPullbackHom_localForm_congr σ hσ (hd i j) (hα i j) e hk₁ hk₂
  have glue := fun {P P' : Modules.{u, u} B S hS (s.baseSpaceAt A.T).1 (s.baseSpaceAt A.T).2}
      (hP : P.IsQuasicoherentOnSite) (hP' : P'.IsQuasicoherentOnSite)
      (γ : ∀ i, (modulePullback B S hS ((schemeSpaceFunctor B S hS).map (c i).base.left)).obj P ⟶
        (modulePullback B S hS ((schemeSpaceFunctor B S hS).map (c i).base.left)).obj P')
      (hγ : ModuleHomFamilyCompatible P P'
        (fun i ↦ (schemeSpaceFunctor B S hS).map (c i).base.left) γ) ↦
    existsUnique_modulePullback_map_eq_of_moduleHomFamilyCompatible (Comma.left A.T) P P' hP hP'
      (fun i ↦ Comma.left (Z i).T) (fun i ↦ (c i).base.left) hcov γ hγ
  obtain ⟨b, hb, -⟩ := glue hM hN _ hcompat
  obtain ⟨b', hb', -⟩ := glue hN hM _ (hcompat.inv hδiso)
  obtain ⟨i₁, -, hid₁⟩ := glue hM hM (fun i ↦ 𝟙 _) (moduleHomFamilyCompatible_id _ _)
  obtain ⟨i₂, -, hid₂⟩ := glue hN hN (fun i ↦ 𝟙 _) (moduleHomFamilyCompatible_id _ _)
  refine ⟨⟨b, b', (hid₁ _ fun i ↦ ?_).trans (hid₁ _ fun i ↦ ?_).symm,
    (hid₂ _ fun i ↦ ?_).trans (hid₂ _ fun i ↦ ?_).symm⟩, fun i ↦ ?_⟩
  · have := hδiso i
    rw [CategoryTheory.Functor.map_comp, hb i, hb' i, IsIso.hom_inv_id]
  · exact CategoryTheory.Functor.map_id _ _
  · have := hδiso i
    rw [CategoryTheory.Functor.map_comp, hb' i, hb i, IsIso.inv_hom_id]
  · exact CategoryTheory.Functor.map_id _ _
  · exact (transportTrivialization_eq_iff σ hσ (c i) _ b).2 (hb i)

end PicardSituation

open PicardSituation

section Assembly

variable {s : PicardSituation B S hS} {σ : s.base ⟶ s.X} {hσ : σ ≫ s.f = 𝟙 s.base}

attribute [local instance] BigFppfSite.hasPullbacks_schemes in
/-- **`Picardstack_{X/B, σ}` is a stack over the big fppf site of `S`** in the sense of Stacks
026F. -/
theorem sectionedPicardBasedCategory_isStack
    (ht : SectionTransportCoherence (modulePushforwardCoherence B S hS) σ hσ) :
    (sectionedPicardBasedCategory (modulePushforwardCoherence B S hS) ht).p.IsStack
      (BigFppfOver.topology B S hS) := by
  have hq := picardBasedCategory_isFiberedInGroupoids (modulePushforwardCoherence B S hS) s
  have hlift_eq : ∀ {R R' : BigFppfOver B S hS} {f f' : R ⟶ R'}
      {a b : (picardBasedCategory (modulePushforwardCoherence B S hS) s).obj} (φ : a ⟶ b),
      f = f' → (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsHomLift f φ →
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsHomLift f' φ :=
    fun _ e h ↦ e ▸ h
  have hFlift : ∀ {R R' : BigFppfOver B S hS}
      {a b : (sectionedPicardBasedCategory (modulePushforwardCoherence B S hS) ht).obj}
      (f : R ⟶ R') (c : a ⟶ b),
      (sectionedPicardBasedCategory (modulePushforwardCoherence B S hS) ht).p.IsHomLift f c ↔
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsHomLift f
        ((forgetTrivializationBased (modulePushforwardCoherence B S hS) ht).toFunctor.map c) :=
    fun f c ↦ ⟨fun hc ↦ IsHomLift.of_fac' _ f _
        (IsHomLift.domain_eq (sectionedPicardBasedCategory _ ht).p f c)
        (IsHomLift.codomain_eq (sectionedPicardBasedCategory _ ht).p f c)
        (IsHomLift.fac' (sectionedPicardBasedCategory _ ht).p f c),
      fun hc ↦ IsHomLift.of_fac' (sectionedPicardBasedCategory _ ht).p f c
        (@IsHomLift.domain_eq _ _ _ _ (picardBasedCategory _ s).p _ _ _ _ f
          ((forgetTrivializationBased _ ht).toFunctor.map c) hc)
        (@IsHomLift.codomain_eq _ _ _ _ (picardBasedCategory _ s).p _ _ _ _ f
          ((forgetTrivializationBased _ ht).toFunctor.map c) hc)
        (@IsHomLift.fac' _ _ _ _ (picardBasedCategory _ s).p _ _ _ _ f
          ((forgetTrivializationBased _ ht).toFunctor.map c) hc)⟩
  refine Functor.isStack_of_faithful_of_isSheaf
    (sectionedPicardProjection_isFiberedInGroupoids _ ht) hq
    (forgetTrivializationBased (modulePushforwardCoherence B S hS) ht).w
    (picardBasedCategory_isStack s)
    (fun U ↦ by
      have := forgetTrivializationBased_faithful (modulePushforwardCoherence B S hS) ht
      infer_instance) ?_ ?_
  · intro y V h R hR x x' φ φ' hφ hφ' hloc
    have hV := IsHomLift.domain_eq (picardBasedCategory (modulePushforwardCoherence B S hS) s).p h φ
    subst hV
    have : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsHomLift h φ := hφ
    have := hφ'
    have : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsStronglyCartesian
        h φ' := hq.isStronglyCartesian_homLift h φ'
