module

public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.KernelTwistCounit
public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.TwistAdd
public import StacksFrontier.AlgebraicGeometry.AmpleLocalGeneration.FromExtension
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.AmpleTwistingSheaf

/-!
# A module of finite type on `ℙⁿ` over an affine base is a quotient of `𝒪(-d)^{⊕ r}`

Over an affine scheme `S` the twisting sheaf `𝒪(1)` on `ℙⁿ_S` is ample
(`Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf`), so by clause (7) of
Stacks 01Q3 (`Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple`) every
quasi-coherent module `𝒢` of finite type has `𝒢(d)` generated by finitely many global sections
for `d ≫ 0`.  Untwisting, `𝒢` is a quotient of `𝒪(-d)^{⊕ r}`, and one may take `r ≥ 1`.  This is
the surjection `𝒪_X^{⊕ r} ⟶ ℱ ⊗ L^{⊗ r'}` of the proof of Stacks 0DPB, in the form in which it
is used there.

## Main results

* `AlgebraicGeometry.ProjectiveQuotOverSpace.twistIsoTensorPowModule`:
  `𝒢(d) ≅ 𝒢 ⊗ 𝒪(1)^{⊗ d}` over an arbitrary base.
* `AlgebraicGeometry.ProjectiveQuotOverSpace.exists_epi_twist_freeModule`: the surjection
  `𝒪(-d)^{⊕ r} ⟶ 𝒢` with `r ≥ 1`.

## References

* [Stacks Project, Tag 0DPB](https://stacks.math.columbia.edu/tag/0DPB)
* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory

namespace AlgebraicGeometry.ProjectiveQuotOverSpace

open ProjectiveQuot
open Stacks.Ample Stacks.AmpleProjectiveImmersion Stacks.RelativeVeryAmple
open Stacks.AlgebraicGeometry.ProjTwistTensorPow

universe u

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory

variable {n : ℕ}

/-- **`𝒢(d) ≅ 𝒢 ⊗ 𝒪(1)^{⊗ d}` on `ℙⁿ_S`**, over an arbitrary base scheme `S`. -/
def twistIsoTensorPowModule {S : Scheme.{u}} (d : ℤ) (G : (projectiveSpaceOver n S).Modules) :
    twist d G ≅
      (G ⊗ tensorPowModule (projectiveSpaceOver n S) (projectiveSpaceTwistingSheaf n S) d) :=
  (Stacks.AmplePullbackPart1.tensorIsoTensorModules (projectiveSpaceOver n S) G
      (tensorPowModule (projectiveSpaceOver n S) (projectiveSpaceTwistingSheaf n S) d) ≪≫
    Stacks.RelativeVeryAmple.tensorModulesMapIso (projectiveSpaceOver n S) (Iso.refl G)
      (Stacks.AlgebraicGeometry.ProjTwistTensorPow.tensorPowModuleProjectiveTwistIso n S d)).symm

/-- A module generated by finitely many global sections is a quotient of `𝒪^{⊕ r}` for some
`r ≥ 1`. -/
theorem exists_epi_freeModule_of_generatingSections {S : Scheme.{u}}
    {M : (projectiveSpaceOver n S).Modules} (σ : M.GeneratingSections) [Finite σ.I] :
    ∃ r : ℕ, 1 ≤ r ∧ ∃ q : freeModule n r S ⟶ M, Epi q := by
  classical
  have := Fintype.ofFinite σ.I
  let e : Option σ.I ≃ Fin (Fintype.card (Option σ.I)) := Fintype.equivFin _
  let q : freeModule n (Fintype.card (Option σ.I)) S ⟶ M :=
    Sigma.desc fun k => match e.symm k with
      | none => 0
      | some i => Sigma.ι (fun _ : σ.I => SheafOfModules.unit _) i ≫ M.freeHomEquiv.symm σ.s
  have hfac : (Sigma.desc fun i : σ.I =>
      Sigma.ι (fun _ : Fin (Fintype.card (Option σ.I)) => Scheme.unitModule
        (projectiveSpaceOver n S)) (e (some i))) ≫ q = M.freeHomEquiv.symm σ.s := by
    refine Sigma.hom_ext _ _ fun i => ?_
    simp only [q, Sigma.ι_desc_assoc, Sigma.ι_desc, Equiv.symm_apply_apply]
    rfl
  refine ⟨Fintype.card (Option σ.I), Fintype.card_pos, q, ?_⟩
  refine ⟨fun g₁ g₂ hg => σ.epi.left_cancellation _ _ ?_⟩
  rw [← hfac]
  exact (Category.assoc _ _ _).trans
    ((congrArg (fun k => _ ≫ k) hg).trans (Category.assoc _ _ _).symm)

/-- **Over an affine base, a twist `𝒢(d)` with `d ≥ 0` of a quasi-coherent module of finite type is
a quotient of `𝒪^{⊕ r}`** for some `r ≥ 1` (Stacks 01Q3, clause (7)): the surjection
`𝒪_X^{⊕ r} ⟶ ℱ ⊗ L^{⊗ r'}` of the proof of Stacks 0DPB. -/
theorem exists_epi_freeModule_twist {S : Scheme.{u}} [IsAffine S]
    (G : (projectiveSpaceOver n S).Modules) (hqc : G.IsQuasicoherent)
    (hft : SheafOfModules.IsFiniteType.{u, u, u} G) :
    ∃ (d : ℕ) (r : ℕ), 1 ≤ r ∧ ∃ q : freeModule n r S ⟶ twist (d : ℤ) G, Epi q := by
  obtain ⟨d₀, hd₀⟩ := Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple
    (projectiveSpaceTwistingSheaf n S)
    (Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf (n := n) (S := S)) G hqc hft
  obtain ⟨σ, hσ⟩ := hd₀ (d₀.toNat : ℤ) (Int.self_le_toNat d₀)
  let σ' := SheafOfModules.GeneratingSections.equivOfIso (twistIsoTensorPowModule _ G).symm σ
  have : Finite σ'.I := hσ
  exact ⟨d₀.toNat, exists_epi_freeModule_of_generatingSections σ'⟩

/-- **A quasi-coherent module of finite type on `ℙⁿ` over an affine base is a quotient of
`𝒪(-d)^{⊕ r}`** for some `d ≥ 0` and `r ≥ 1` (Stacks 01Q3, clause (7), untwisted). -/
theorem exists_epi_twist_freeModule {S : Scheme.{u}} [IsAffine S]
    (G : (projectiveSpaceOver n S).Modules) (hqc : G.IsQuasicoherent)
    (hft : SheafOfModules.IsFiniteType.{u, u, u} G) :
    ∃ (d : ℕ) (r : ℕ), 1 ≤ r ∧ ∃ q : twist (-(d : ℤ)) (freeModule n r S) ⟶ G, Epi q := by
  obtain ⟨d, r, hr, q, hq⟩ := exists_epi_freeModule_twist G hqc hft
  have := epi_twistMap (-(d : ℤ)) q
  exact ⟨d, r, hr, twistMap (-(d : ℤ)) q ≫ (twistNegTwistIso S _ G).hom, epi_comp _ _⟩

end AlgebraicGeometry.ProjectiveQuotOverSpace

end
