module

public import StacksFrontier.AlgebraicGeometry.Quot.CurvesIsAlgebraic
public import StacksFrontier.AlgebraicGeometry.Quot.CurvesSmoothLocusDeformation
public import StacksFrontier.AlgebraicGeometry.Stacks.SmoothLocus

/-!
# The smooth locus of the stack of curves (Stacks 0DZU)

Let `k` be a field, `X` a proper scheme of dimension at most one over `k` and `Λ` a Cohen ring for
`k`. The classifying morphism `Spec(k) → Curves` of `X` factors through the open substack where
`Curves → Spec(ℤ)` is smooth exactly when the deformation category `Def_X` over `𝒞_Λ` is
unobstructed.

The stack `Curves` is algebraic (`AlgebraicGeometry.curvesFiberedCategory_isAlgebraicStack`,
Stacks 0D5A) and locally of finite presentation over `Spec(ℤ)`
(`AlgebraicGeometry.curvesAlgebraicStack_isLocallyOfFinitePresentation`, Stacks 0DSS), and its
smooth locus is the maximal open substack of Stacks 0DZR on which `Curves → Spec(ℤ)` is smooth.

## Main definitions

* `AlgebraicGeometry.curvesSmoothLocus`: the open substack of `Curves` where `Curves → Spec(ℤ)`
  is smooth.

## Main results

* `AlgebraicGeometry.isSmoothLocus_curvesSmoothLocus`: `AlgebraicGeometry.curvesSmoothLocus` is
  the open substack where `Curves → Spec(ℤ)` is smooth.
* `AlgebraicGeometry.curvesSmoothLocus_property_iff_isSmooth_schemeDeformation`: the classifying
  morphism of `X` factors through the smooth locus if and only if `Def_X` is unobstructed.

## References

* [Stacks Project, Tag 0DZU](https://stacks.math.columbia.edu/tag/0DZU)
* [Stacks Project, Tag 0DZR](https://stacks.math.columbia.edu/tag/0DZR)
-/

@[expose] public noncomputable section

open CategoryTheory Deformation Deformation.Artin Deformation.Examples

universe u w

namespace AlgebraicGeometry

variable (B : BigFppfSite.{u}) (hZ : B.Contains integerBase)

/-- **The smooth locus of `Curves → Spec(ℤ)`.** The maximal open substack of the stack of curves
on which its structure morphism to `Spec(ℤ)` is smooth; it exists and is unique by Stacks 0DZR
(`AlgebraicGeometry.Stack.smoothLocus`). -/
def curvesSmoothLocus :
    Stack.OpenSubstack
      (curvesAlgebraicStack.{u, w} B hZ (curvesFiberedCategory_isAlgebraicStack B hZ)) :=
  (Stack.smoothLocus B integerBase hZ (Stack.structureMorphism B integerBase hZ
    (curvesAlgebraicStack B hZ (curvesFiberedCategory_isAlgebraicStack B hZ)))).1.exists.choose

/-- `AlgebraicGeometry.curvesSmoothLocus` is the open substack where `Curves → Spec(ℤ)` is
smooth. -/
theorem isSmoothLocus_curvesSmoothLocus :
    Stack.IsSmoothLocus B integerBase hZ (Stack.structureMorphism B integerBase hZ
      (curvesAlgebraicStack.{u, w} B hZ (curvesFiberedCategory_isAlgebraicStack B hZ)))
      (curvesSmoothLocus B hZ) :=
  (Stack.smoothLocus B integerBase hZ (Stack.structureMorphism B integerBase hZ
    (curvesAlgebraicStack B hZ (curvesFiberedCategory_isAlgebraicStack B hZ)))).1.exists.choose_spec

/-- Let `k` be a field, let `X` be a proper scheme of dimension at most one over `k`, and let `Λ`
be a Cohen ring for `k`: a complete discrete valuation ring whose maximal ideal is generated by a
prime number `p` (`IsCohenRing`), with a surjection `Λ → k`, so that `k` is its residue field.
Then the following are equivalent:

1. the classifying morphism `Spec(k) → Curves` of `X` factors through the open substack where
   `Curves → Spec(ℤ)` is smooth;
2. the deformation category `Def_X` of `X` over `𝒞_Λ` is unobstructed.

The stack `Curves` is read on its small model `AlgebraicGeometry.curvesAlgebraicStack`, the
presentation at which it is an object of the 2-category of algebraic stacks; the classifying
morphism of `X` is the object `AlgebraicGeometry.curvesSmallPoint` over `Spec(k)`, and it factors
through an open substack exactly when it is an object of that substack. The open substack where
`Curves → Spec(ℤ)` is smooth is the maximal one of Stacks 0DZR,
`AlgebraicGeometry.curvesSmoothLocus`. Unobstructedness of `Def_X` is smoothness of its
projection to `𝒞_Λ` (Stacks 06HG). -/
@[stacks 0DZU]
theorem curvesSmoothLocus_property_iff_isSmooth_schemeDeformation
    {k Λ : Type u} [Field k] [CommRing Λ] [IsDomain Λ] [IsCohenRing Λ] [Algebra Λ k]
    (hsurj : Function.Surjective (algebraMap Λ k))
    (X : Over (Spec (.of k))) [IsProper X.hom] (hk : B.Contains (Spec (.of k)))
    (hdim : topologicalKrullDim X.left ≤ 1) :
    (curvesSmoothLocus.{u, w} B hZ).property (curvesSmallPoint B hZ X hk hdim) ↔
      IsSmooth (baseProjection (schemeDeformationCategoryProjection (Λ := Λ) X)) :=
  smoothLocus_property_curvesSmallPoint_iff_of_isCohenRing B hZ X hk hdim _
    (curvesAlgebraicStack_isLocallyOfFinitePresentation B hZ) (isSmoothLocus_curvesSmoothLocus B hZ)
    hsurj

end AlgebraicGeometry

end
