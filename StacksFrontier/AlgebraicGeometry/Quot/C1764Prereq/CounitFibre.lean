/-!
# The counit `f^*f_*𝓛 ⟶ 𝓛` near a fibre of a family of curves

Let `f : X ⟶ S` be a family of curves, `𝓛` a quasi-coherent `𝒪_X`-module and `s ∈ S`, and let
`V` present the fibre `X_s` by a cartesian square over `Spec κ(s) ⟶ S`. This file proves the
steps of the proof of Stacks 0E6Y that relate condition (2) there — the counit
`f^*f_*𝓛 ⟶ 𝓛` is surjective over `f⁻¹(U)` for an open `U ∋ s` — to the fibre:

* for `𝓛` of finite type, condition (2) at `s` holds exactly when the counit is surjective on
  `V` (both say that `s` is not in the closed image of the support of the cokernel);
* if the counit is surjective on `V`, then `𝓛|_V` is generated by global sections (the pullback
  of `f^*f_*𝓛` to `V` is pulled back from the quasi-coherent, hence free, module `(f_*𝓛)|_{κ(s)}`);
* conversely, if the base change map `(f_*𝓛)|_{κ(s)} ⟶ H⁰(V, 𝓛|_V)` is surjective and `𝓛|_V` is
  generated by global sections, the counit is surjective on `V`;
* condition (2) descends along a morphism of families over an étale morphism of bases.

## Main results

* `AlgebraicGeometry.C1764Prereq.isCounitSurjectiveAbove_iff_epi_fibre`.
* `AlgebraicGeometry.C1764Prereq.isGeneratedByGlobalSections_baseChangeModule_of_epi_fibre`.
* `AlgebraicGeometry.C1764Prereq.epi_fibre_of_epi_moduleBaseChangeMap`.
* `AlgebraicGeometry.C1764Prereq.isCounitSurjectiveAbove_of_hom_of_etale`.

## References

* [Stacks Project, Tag 0E6Y](https://stacks.math.columbia.edu/tag/0E6Y)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

namespace AlgebraicGeometry

attribute [local instance] HasDerivedCategory.standard
attribute [local instance 5000] SheafOfModules.instAbelian

variable {B : BigFppfSite.{u}} {hZ : B.Contains integerBase}

namespace C1764Prereq

open Space

/-- Surjectivity of `f^*f_*𝓛 ⟶ 𝓛` over `f⁻¹(U)` for some open `U ∋ s` is surjectivity of
its pullback to a presentation of the fibre `X_s`. -/
theorem isCounitSurjectiveAbove_iff_epi_fibre (X : CurveFamily B hZ)
    (L : Space.Modules.{u, u} B integerBase hZ X.total.1 X.total.2)
    (hL : L.IsQuasicoherentOnSite) (hLft : SheafOfModules.IsFiniteTypeOnSite L)
    (s : (BigFppfOver.toScheme B integerBase hZ).obj X.base) {V : BigFppfOver B integerBase hZ}
    {v : V ⟶ CurveFamily.residuePoint B hZ X s} {q : yoneda.obj V ⟶ X.total.obj}
    (hq : CurveFamily.IsFibrePresentation B hZ X s v q) :
    X.IsCounitSurjectiveAbove L s ↔
      Epi ((Space.modulePullback B integerBase hZ
        (ObjectProperty.homMk q : schemeSpace V ⟶ X.total)).map (X.pushforwardCounit L)) :=
  (isCounitSurjectiveAbove_iff_notMem X L hL hLft s).trans
    (epi_fibre_iff_notMem X L hL hLft s hq).symm

/-- If the pullback of `f^*f_*𝓛 ⟶ 𝓛` to a presentation `V` of the fibre `X_s` is surjective,
then the restriction of `𝓛` to the scheme `V` is generated by global sections. -/
theorem isGeneratedByGlobalSections_baseChangeModule_of_epi_fibre (X : CurveFamily B hZ)
    (L : Space.Modules.{u, u} B integerBase hZ X.total.1 X.total.2)
    (hL : L.IsQuasicoherentOnSite)
    (s : (BigFppfOver.toScheme B integerBase hZ).obj X.base) {V : BigFppfOver B integerBase hZ}
    {v : V ⟶ CurveFamily.residuePoint B hZ X s} {q : yoneda.obj V ⟶ X.total.obj}
    (hq : CurveFamily.IsFibrePresentation B hZ X s v q)
    (h : Epi ((Space.modulePullback B integerBase hZ
        (ObjectProperty.homMk q : schemeSpace V ⟶ X.total)).map (X.pushforwardCounit L))) :
    SheafOfModules.IsGeneratedByGlobalSections (Space.baseChangeModule B integerBase hZ L V q) := by
  have hw := (isPullback_fibre hq).w
  have hN : ((modulePullback B integerBase hZ
      (schemeSpaceMap (CurveFamily.residuePointMap B hZ X s))).obj
        ((modulePushforward B integerBase hZ X.toBase).obj L)).IsQuasicoherentOnSite :=
    isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B integerBase hZ _ _
      (isQuasicoherentOnSite_modulePushforward_of_qcqs B integerBase hZ X.toBase
        X.finitePresentation.2.1 X.finitePresentation.2.2 L hL)
  have hvN := isGeneratedByGlobalSections_modulePullback (schemeSpaceMap v)
    (isGeneratedByGlobalSections_of_isQuasicoherentOnSite_residueFieldObject X.base s _ hN)
  have e := (modulePullbackSquareComparison X.toBase
    (schemeSpaceMap (CurveFamily.residuePointMap B hZ X s)) (schemeSpaceMap v)
    (ObjectProperty.homMk q : schemeSpace V ⟶ X.total) hw).app
      ((modulePushforward B integerBase hZ X.toBase).obj L)
  have hgen : ((modulePullback B integerBase hZ
      (ObjectProperty.homMk q : schemeSpace V ⟶ X.total)).obj L).IsGeneratedByGlobalSections :=
    ⟨(_root_.SheafOfModules.GeneratingSections.equivOfIso e.symm hvN.some).ofEpi
      ((modulePullback B integerBase hZ
        (ObjectProperty.homMk q : schemeSpace V ⟶ X.total)).map (X.pushforwardCounit L))⟩
  exact (isGeneratedByGlobalSections_iff_restrictToChartScheme V _
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B integerBase hZ _ L hL)).1 hgen

/-- If the base change map `s^*f_*𝓛 ⟶ f_{V,*}(𝓛|_V)` to a presentation `V` of the fibre
`X_s` is surjective and `𝓛|_V` is generated by global sections, then the pullback of
`f^*f_*𝓛 ⟶ 𝓛` to `V` is surjective. -/
theorem epi_fibre_of_epi_moduleBaseChangeMap (X : CurveFamily B hZ)
    (L : Space.Modules.{u, u} B integerBase hZ X.total.1 X.total.2)
    (hL : L.IsQuasicoherentOnSite)
    (s : (BigFppfOver.toScheme B integerBase hZ).obj X.base) {V : BigFppfOver B integerBase hZ}
    {v : V ⟶ CurveFamily.residuePoint B hZ X s} {q : yoneda.obj V ⟶ X.total.obj}
    (hq : CurveFamily.IsFibrePresentation B hZ X s v q)
    (hβ : Epi ((Space.moduleBaseChangeMap X.toBase
      (schemeSpaceMap (CurveFamily.residuePointMap B hZ X s)) (schemeSpaceMap v)
      (ObjectProperty.homMk q : schemeSpace V ⟶ X.total) (isPullback_fibre hq).w).app L))
    (hgen : SheafOfModules.IsGeneratedByGlobalSections
      (Space.baseChangeModule B integerBase hZ L V q)) :
    Epi ((Space.modulePullback B integerBase hZ
        (ObjectProperty.homMk q : schemeSpace V ⟶ X.total)).map (X.pushforwardCounit L)) :=
  epi_modulePullback_map_counit X.toBase (schemeSpaceMap (CurveFamily.residuePointMap B hZ X s))
    (schemeSpaceMap v) (ObjectProperty.homMk q : schemeSpace V ⟶ X.total) (isPullback_fibre hq).w L
    hβ (epi_counit_of_isGeneratedByGlobalSections (schemeSpaceMap v)
      ((isGeneratedByGlobalSections_iff_restrictToChartScheme V _
        (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B integerBase hZ _ L
          hL)).2 hgen))

/-- Condition (2) of Stacks 0E6Y descends along an étale morphism of bases: if, for a
morphism of families `φ : X' ⟶ X` over an étale morphism of bases, the counit of `X'` for the
pullback of `𝓛` is surjective above `t`, then the counit of `X` for `𝓛` is surjective above the
image of `t`. -/
theorem isCounitSurjectiveAbove_of_hom_of_etale {X X' : CurveFamily B hZ} (φ : X' ⟶ X)
    (hφ : Etale ((BigFppfOver.toScheme B integerBase hZ).map φ.baseMap))
    (L : Space.Modules.{u, u} B integerBase hZ X.total.1 X.total.2)
    (hL : L.IsQuasicoherentOnSite) (hLft : SheafOfModules.IsFiniteTypeOnSite L)
    (t : (BigFppfOver.toScheme B integerBase hZ).obj X'.base)
    (h : X'.IsCounitSurjectiveAbove ((Space.modulePullback B integerBase hZ φ.totalMap).obj L) t) :
    X.IsCounitSurjectiveAbove L ((BigFppfOver.toScheme B integerBase hZ).map φ.baseMap t) := by
  have hL' := isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B integerBase hZ
    φ.totalMap L hL
  have hLft' := isFiniteTypeOnSite_modulePullback B integerBase hZ φ.totalMap L hLft
  rw [isCounitSurjectiveAbove_iff_notMem X' _ hL' hLft'] at h
  rw [isCounitSurjectiveAbove_iff_notMem X L hL hLft]
  rintro ⟨_, ⟨x, hx, rfl⟩, hxt⟩
  obtain ⟨w, hw⟩ := surjective_pointsToScheme B integerBase hZ X'.base t
  have hxw : pointsMap B integerBase hZ X.total.1 X.toBase.hom x =
      pointsMap B integerBase hZ _ (yoneda.map φ.baseMap) w :=
    injective_pointsToScheme B integerBase hZ X.base
      (hxt.trans (by rw [pointsToScheme_pointsMap_yoneda, hw]))
  obtain ⟨x', hx'1, hx'2⟩ := exists_points_of_isPullback B integerBase hZ
    (AlgebraicSpaces.isPullback_hom B integerBase hZ φ.cartesian) x w hxw
  exact h ⟨_, ⟨x', mem_cokernelSupport_of_hom φ hφ L hL hLft hL' x' (hx'1 ▸ hx), rfl⟩,
    (congrArg (pointsToScheme B integerBase hZ X'.base) hx'2).trans hw⟩

end C1764Prereq

end AlgebraicGeometry
