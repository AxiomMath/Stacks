module

public import StacksFrontier.AlgebraicGeometry.Quot.RelativeHomGeneratedBelow
public import StacksFrontier.AlgebraicGeometry.Spaces.Properness.ProperSupport
public import StacksFrontier.AlgebraicGeometry.Spaces.NoetherianSpaces
public import StacksFrontier.AlgebraicGeometry.Spaces.MapDescent

/-!
# The relative Hom space from its case over affine bases of finite type over `ℤ`

In Situation 08JT let `f` be of finite presentation and `G` of finite presentation, flat over the
base, with support proper over the base. This file states as a proposition the case of Stacks 08JY
where the base is an affine scheme of finite type over `ℤ` and all the data are of finite
presentation, and derives both assertions of Stacks 08K6 from it, with the support of `G` proper in
the sense of the underlying abelian sheaf.

All names are in the namespace `AlgebraicGeometry.Space.HomSituation`.

## Main definitions

* `AffineFiniteTypeStageRepresentability`: the relative Hom functor is an algebraic space affine
  and of finite presentation over the base for every situation over `Spec ℤ` with base an affine
  scheme of finite type over `ℤ`, `f`, `F`, `G` of finite presentation, `G` flat over the base
  with support proper over it.

## Main results

* `isAffineFinitePresentationAlgebraicSpaceOverBase_of_affineFiniteTypeStages`: the second
  assertion of Stacks 08K6 from the affine finite type case.
* `isAffineAlgebraicSpaceOverBase_of_affineFiniteTypeStages`: the first assertion of Stacks 08K6
  from the affine finite type case, for a source module étale-locally generated by fewer than `μ`
  sections, `μ` below the cutoff of the site.
* `isNoetherian_schemeSpace_of_locallyOfFiniteType`: an affine scheme of finite type over `ℤ` is a
  Noetherian algebraic space.

## References

* [Stacks Project, Tag 08K6](https://stacks.math.columbia.edu/tag/08K6)
* [Stacks Project, Tag 08JY](https://stacks.math.columbia.edu/tag/08JY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Space.HomSituation

open CoherentSituation

/-- **The relative Hom space over affine bases of finite type over `ℤ`.** For every relative Hom
situation over `Spec ℤ` whose base is an affine scheme of finite type over `ℤ`, with `f` of finite
presentation, `F` and `G` of finite presentation, and `G` flat over the base with support proper
over it, the relative Hom functor is an algebraic space affine and of finite presentation over the
base. This is a case of Stacks 08JY. -/
def AffineFiniteTypeStageRepresentability (B : BigFppfSite.{u}) : Prop :=
  ∀ (T₀ : BigAffineFppf B (⊤_ Scheme.{u}) B.contains_terminal),
    LocallyOfFiniteType (terminal.from ((BigAffineFppf.toScheme _ _ _).obj T₀)) →
    ∀ (v : HomSituation B (⊤_ Scheme.{u}) B.contains_terminal),
      v.base = (schemeSpaceFunctor B _ _).obj ((BigAffineFppf.inclusion _ _ _).obj T₀) →
      IsFinitePresentation B _ _ v.f.hom → v.F.IsFinitePresentationOnSite →
      v.G.IsFinitePresentationOnSite → IsFlatOver B _ _ v.X.2 v.f.hom v.G →
      HasProperSupportOver v.f v.G →
      v.IsAffineFinitePresentationAlgebraicSpaceOverBase
        (modulePushforwardCoherence B _ B.contains_terminal)

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- Proper support of the underlying abelian sheaf is proper support over the target. -/
theorem hasProperSupportOver_of_hasProperSupport (s : HomSituation B S hS)
    (hp : IsLocallyOfFiniteType B S hS s.f.hom)
    (h : HasProperSupport B S hS s.X.2 s.base.2 s.f.hom hp
      ((SheafOfModules.toSheaf _).obj s.G)) :
    HasProperSupportOver s.f s.G :=
  ⟨hp, h⟩

/-- **The second assertion of Stacks 08K6, from the affine finite type case.** In Situation 08JT
let `f` be of finite presentation and `F`, `G` of finite presentation, `G` flat over the base with
support proper over the base. If the relative Hom space exists over the affine bases of finite type
over `ℤ`, then `Hom(F, G)` is an algebraic space affine and of finite presentation over the
base. -/
theorem isAffineFinitePresentationAlgebraicSpaceOverBase_of_affineFiniteTypeStages
    (hstage : AffineFiniteTypeStageRepresentability B) (s : HomSituation B S hS)
    (hc : ModulePushforwardCoherence B S hS) (hfp : IsFinitePresentation B S hS s.f.hom)
    (hF : s.F.IsFinitePresentationOnSite) (hG : s.G.IsFinitePresentationOnSite)
    (hGflat : IsFlatOver B S hS s.X.2 s.f.hom s.G)
    (hGsupp : HasProperSupport B S hS s.X.2 s.base.2 s.f.hom
      (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B S hS hfp.1)
      ((SheafOfModules.toSheaf _).obj s.G)) :
    s.IsAffineFinitePresentationAlgebraicSpaceOverBase hc :=
  isAffineFinitePresentationAlgebraicSpaceOverBase_of_stages_of_isFinitePresentation
    B.contains_terminal hstage s hc hfp hF hG hGflat
    (s.hasProperSupportOver_of_hasProperSupport _ hGsupp)

/-- **The first assertion of Stacks 08K6, from the affine finite type case.** In Situation 08JT
let `f` be of finite presentation and `G` of finite presentation, flat over the base with support
proper over the base, and let `F` be étale-locally generated by fewer than `μ` sections for some
cardinal `μ` below the cutoff of the site. If the relative Hom space exists over the affine bases
of finite type over `ℤ`, then `Hom(F, G)` is an algebraic space affine over the base. -/
theorem isAffineAlgebraicSpaceOverBase_of_affineFiniteTypeStages
    (hstage : AffineFiniteTypeStageRepresentability B) (s : HomSituation B S hS)
    (hc : ModulePushforwardCoherence B S hS) (hfp : IsFinitePresentation B S hS s.f.hom)
    (hG : s.G.IsFinitePresentationOnSite) (hGflat : IsFlatOver B S hS s.X.2 s.f.hom s.G)
    (hGsupp : HasProperSupport B S hS s.X.2 s.base.2 s.f.hom
      (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B S hS hfp.1)
      ((SheafOfModules.toSheaf _).obj s.G))
    (hF : ∃ μ < B.cutoff, IsEtaleLocallyGeneratedBelow B S hS μ s.F) :
    s.IsAffineAlgebraicSpaceOverBase hc :=
  isAffineAlgebraicSpaceOverBase_of_isEtaleLocallyGeneratedBelow
    (fun v hv hvF hvG hvflat hvsupp =>
      isAffineFinitePresentationAlgebraicSpaceOverBase_of_stages_of_isFinitePresentation
        B.contains_terminal hstage v _ hv hvF hvG hvflat hvsupp)
    s hc hfp hG hGflat (s.hasProperSupportOver_of_hasProperSupport _ hGsupp) hF

/-! ### The bases of the stages are Noetherian -/

/-- **An affine scheme of finite type over `ℤ` is a Noetherian algebraic space** (Stacks 03EA). -/
theorem isNoetherian_schemeSpace_of_locallyOfFiniteType
    (T₀ : BigAffineFppf B (⊤_ Scheme.{u}) B.contains_terminal)
    (hT₀ : LocallyOfFiniteType (terminal.from ((BigAffineFppf.toScheme _ _ _).obj T₀))) :
    IsNoetherian B _ _ B.contains_terminal
      ((schemeSpaceFunctor B _ _).obj ((BigAffineFppf.inclusion _ _ _).obj T₀)).1 := by
  have hl : IsLocallyNoetherian ((BigAffineFppf.toScheme _ _ _).obj T₀) := by
    have e : (⊤_ Scheme.{u}) ≅ Spec (CommRingCat.of (ULift.{u} ℤ)) :=
      (specULiftZIsTerminal.{u}.uniqueUpToIso terminalIsTerminal).symm
    have : IsNoetherianRing (ULift.{u} ℤ) :=
      isNoetherianRing_of_ringEquiv ℤ ULift.ringEquiv.symm
    have : IsLocallyNoetherian (⊤_ Scheme.{u}) := LocallyOfFiniteType.isLocallyNoetherian e.hom
    exact LocallyOfFiniteType.isLocallyNoetherian (terminal.from _)
  have hEt : ∀ {P : MorphismProperty Scheme.{u}} [P.IsMultiplicative] [P.IsStableUnderBaseChange],
      (P.inverseImage (BigFppfOver.toScheme B (⊤_ Scheme.{u}) B.contains_terminal)).presheaf
        (𝟙 (yoneda.obj ((BigAffineFppf.inclusion _ _ _).obj T₀))) := by
    intro P _ _
    have := MorphismProperty.IsStableUnderBaseChange.respectsIso (P := P)
    exact presheaf_of_isIso B _ _ (MorphismProperty.RespectsIso.inverseImage _ _)
      (fun U => by simpa using MorphismProperty.id_mem P ((BigFppfOver.toScheme B _ _).obj U)) _
  exact ⟨isQuasiCompactSpace_yoneda_of_isAffine B _ _ _ T₀.property,
    isAbsolutelyQuasiSeparated_of_isAffineSpace B _ _ B.contains_terminal
      ⟨(BigAffineFppf.inclusion _ _ _).obj T₀, T₀.property, ⟨Iso.refl _⟩⟩,
    ⟨(BigAffineFppf.inclusion _ _ _).obj T₀, 𝟙 _, hEt, hEt, hl⟩⟩

end AlgebraicGeometry.Space.HomSituation

end
