module

public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.PresentationCokernelFinitePresentation
public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.FibreNakayama
public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.FlatQuotientBaseChange
public import StacksFrontier.AlgebraicGeometry.Descent.FlatBaseChangeComparison
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SliceRestrictionFiniteKernel
public import StacksFrontier.AlgebraicGeometry.CoherentTFAE.Basic

/-!
# `π^* π_* 𝒦(m) ⟶ 𝒦(m)` is surjective for `K ∈ Quot^P(T)`

Let `K ∈ Quot^P(T)` with quotient `𝒬 = 𝒪^{⊕ r}/K` on `π : ℙⁿ_T ⟶ T`, and let
`m = AlgebraicGeometry.ProjectiveQuot.regularityIndex n r P`. The inverse image of `K ⊆ 𝒪^{⊕ r}`
along every base change `ℙⁿ_{T'} ⟶ ℙⁿ_T` stays a monomorphism, `𝒬` being flat over `T`
(`AlgebraicGeometry.ProjectiveQuot.mono_pullback_map_arrow_of_mem_families`). Then:

* the twist `0 ⟶ 𝒦(m) ⟶ 𝒪^{⊕ r}(m) ⟶ 𝒬(m) ⟶ 0` is exact, and so is
  `0 ⟶ π_*𝒦(m) ⟶ π_*𝒪^{⊕ r}(m) ⟶ π_*𝒬(m)`; hence the kernel of the Grassmannian presentation
  `𝒪_T^{⊕ N} ≅ π_*𝒪^{⊕ r}(m) ⟶ π_*𝒬(m)` of `K` is `π_*𝒦(m)`, and the map
  `u_m : π^* ker(q) ⟶ 𝒪^{⊕ r}(m)` of `AlgebraicGeometry.ProjectiveQuot.presentationTwistMap`
  factors as `π^* ker(q) ≅ π^*π_*𝒦(m) ⟶ 𝒦(m) ⟶ 𝒪^{⊕ r}(m)`;
* the base-change morphism `(π_*𝒦(m))_t ⟶ H^0(ℙⁿ_{κ(t)}, 𝒦_t(m))` is onto at every point `t`
  (a diagram chase in the base change of the sequence above);
* `𝒦_t(m)` is generated by global sections on the fibre (the choice of `m`), so the counit
  `π^*π_*𝒦(m) ⟶ 𝒦(m)` is onto on every fibre, hence onto by Nakayama's lemma, `𝒦(m)` being of
  finite type (Stacks 01BP).

This is the step "`π^* π_* 𝒦(m) ⟶ 𝒦(m)` is surjective" in the proof of Stacks 0DPA.

## Main results

* `AlgebraicGeometry.ProjectiveQuot.twistShortComplex_exact`.
* `AlgebraicGeometry.ProjectiveQuot.kernelGrassmannianPresentationIso`: `ker(q) ≅ π_*𝒦(m)`.
* `AlgebraicGeometry.ProjectiveQuot.presentationKernelCounit_comp_twistMap`: the factorization of
  `u_m`.
* `AlgebraicGeometry.ProjectiveQuot.epi_baseChangeNatTrans_twist_subobject`.
* `AlgebraicGeometry.ProjectiveQuot.epi_counit_app_twist_subobject`.
* `AlgebraicGeometry.ProjectiveQuot.epi_presentationKernelCounit`.

## References

* [Stacks Project, Tag 0DPA](https://stacks.math.columbia.edu/tag/0DPA)
* [Stacks Project, Tag 01BP](https://stacks.math.columbia.edu/tag/01BP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open Stacks.AlgebraicGeometry.AffinePushforward (baseChangeNatTrans)

universe u

namespace AlgebraicGeometry.ProjectiveQuot

/-- Two kernels, of `g` and of `f = e.hom ≫ g` with `e` an isomorphism, have isomorphic sources. -/
def isoOfIsKernelComp {C : Type*} [Category* C] [HasZeroMorphisms C] {A B B' Z K : C}
    (e : B ≅ B') {f : B ⟶ Z} {g : B' ⟶ Z} (hf : f = e.hom ≫ g) {i : A ⟶ B'} {wi : i ≫ g = 0}
    (hi : IsLimit (KernelFork.ofι i wi)) {k : K ⟶ B} {wk : k ≫ f = 0}
    (hk : IsLimit (KernelFork.ofι k wk)) : K ≅ A where
  hom := hi.lift (KernelFork.ofι (k ≫ e.hom) (by rw [Category.assoc, ← hf]; exact wk))
  inv := hk.lift (KernelFork.ofι (i ≫ e.inv)
    (by rw [Category.assoc, hf, e.inv_hom_id_assoc]; exact wi))
  hom_inv_id := Fork.IsLimit.hom_ext hk (by
    have h₁ : hk.lift (KernelFork.ofι (i ≫ e.inv) (by
        rw [Category.assoc, hf, e.inv_hom_id_assoc]; exact wi)) ≫ k = i ≫ e.inv :=
      Fork.IsLimit.lift_ι hk
    have h₂ : hi.lift (KernelFork.ofι (k ≫ e.hom) (by rw [Category.assoc, ← hf]; exact wk)) ≫ i =
        k ≫ e.hom := Fork.IsLimit.lift_ι hi
    simp only [KernelFork.ι_ofι, Category.assoc, Category.id_comp]
    rw [h₁, reassoc_of% h₂, e.hom_inv_id, Category.comp_id])
  inv_hom_id := Fork.IsLimit.hom_ext hi (by
    have h₁ : hk.lift (KernelFork.ofι (i ≫ e.inv) (by
        rw [Category.assoc, hf, e.inv_hom_id_assoc]; exact wi)) ≫ k = i ≫ e.inv :=
      Fork.IsLimit.lift_ι hk
    have h₂ : hi.lift (KernelFork.ofι (k ≫ e.hom) (by rw [Category.assoc, ← hf]; exact wk)) ≫ i =
        k ≫ e.hom := Fork.IsLimit.lift_ι hi
    simp only [KernelFork.ι_ofι, Category.assoc, Category.id_comp]
    rw [h₂, reassoc_of% h₁, e.inv_hom_id, Category.comp_id])

/-- The isomorphism `isoOfIsKernelComp e hf hi hk` followed by `i` is `k ≫ e.hom`. -/
theorem isoOfIsKernelComp_hom_comp {C : Type*} [Category* C] [HasZeroMorphisms C]
    {A B B' Z K : C} (e : B ≅ B') {f : B ⟶ Z} {g : B' ⟶ Z} (hf : f = e.hom ≫ g) {i : A ⟶ B'}
    {wi : i ≫ g = 0} (hi : IsLimit (KernelFork.ofι i wi)) {k : K ⟶ B} {wk : k ≫ f = 0}
    (hk : IsLimit (KernelFork.ofι k wk)) :
    (isoOfIsKernelComp e hf hi hk).hom ≫ i = k ≫ e.hom :=
  Fork.IsLimit.lift_ι hi

variable {n r : ℕ}

section Twist

variable {T : Scheme.{u}} (d : ℤ) (K : Subobject (freeModule n r T))

/-- The twist preserves monomorphisms. -/
theorem mono_twistMap {F G : (projectiveSpaceOver n T).Modules} (φ : F ⟶ G) [Mono φ] :
    Mono (twistMap d φ) := by
  rw [twistMap_eq_twistFunctor_map]
  infer_instance

/-- The twist preserves epimorphisms. -/
theorem epi_twistMap {F G : (projectiveSpaceOver n T).Modules} (φ : F ⟶ G) [Epi φ] :
    Epi (twistMap d φ) := by
  rw [twistMap_eq_twistFunctor_map]
  infer_instance

/-- `0 ⟶ K ⟶ 𝒪^{⊕ r} ⟶ 𝒪^{⊕ r}/K ⟶ 0`. -/
abbrev baseShortComplex : ShortComplex (projectiveSpaceOver n T).Modules :=
  ShortComplex.mk K.arrow (quotientπ K) (cokernel.condition _)

/-- `0 ⟶ K ⟶ 𝒪^{⊕ r} ⟶ 𝒪^{⊕ r}/K ⟶ 0` is exact. -/
theorem baseShortComplex_exact : (baseShortComplex K).Exact :=
  ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel _)

/-- `0 ⟶ 𝒦(d) ⟶ 𝒪^{⊕ r}(d) ⟶ 𝒬(d) ⟶ 0`. -/
def twistShortComplex : ShortComplex (projectiveSpaceOver n T).Modules :=
  ShortComplex.mk (twistMap d K.arrow) (twistMap d (quotientπ K))
    ((congrArg₂ (· ≫ ·) (twistMap_eq_twistFunctor_map d K.arrow)
      (twistMap_eq_twistFunctor_map d (quotientπ K))).trans
      (((twistFunctor n T d).map_comp _ _).symm.trans
        ((congrArg (twistFunctor n T d).map (cokernel.condition K.arrow)).trans
          ((twistFunctor n T d).map_zero _ _))))

/-- The map `𝒦(d) ⟶ 𝒪^{⊕ r}(d)` is a monomorphism. -/
instance : Mono (twistShortComplex d K).f := mono_twistMap d K.arrow

/-- The map `𝒪^{⊕ r}(d) ⟶ 𝒬(d)` is an epimorphism. -/
instance : Epi (twistShortComplex d K).g := epi_twistMap d (quotientπ K)

/-- **The twist of `0 ⟶ K ⟶ 𝒪^{⊕ r} ⟶ 𝒬 ⟶ 0` is exact.** -/
theorem twistShortComplex_exact : (twistShortComplex d K).Exact := by
  have h := (baseShortComplex_exact K).map_of_epi_of_preservesCokernel (twistFunctor n T d)
    (inferInstanceAs (Epi (cokernel.π K.arrow))) inferInstance
  exact ShortComplex.exact_of_iso (ShortComplex.isoMk
    (S₁ := (baseShortComplex K).map (twistFunctor n T d)) (S₂ := twistShortComplex d K)
    (Iso.refl _) (Iso.refl _) (Iso.refl _)
    ((Category.id_comp _).trans ((twistMap_eq_twistFunctor_map d K.arrow).trans
      (Category.comp_id _).symm))
    ((Category.id_comp _).trans ((twistMap_eq_twistFunctor_map d (quotientπ K)).trans
      (Category.comp_id _).symm))) h

/-- Pullback of modules preserves colimits, being a left adjoint. -/
private instance preservesColimits_modules_pullback {X Y : Scheme.{u}} (f : X ⟶ Y) :
    PreservesColimitsOfSize.{0, 0} (Scheme.Modules.pullback f) :=
  (Scheme.Modules.pullbackPushforwardAdjunction _).leftAdjoint_preservesColimits

/-- Pushforward of modules preserves limits, being a right adjoint. -/
private instance preservesLimits_modules_pushforward {X Y : Scheme.{u}} (f : X ⟶ Y) :
    PreservesLimitsOfSize.{u, u} (Scheme.Modules.pushforward f) :=
  (Scheme.Modules.pullbackPushforwardAdjunction _).rightAdjoint_preservesLimits

/-- **`0 ⟶ π_*𝒦(d) ⟶ π_*𝒪^{⊕ r}(d) ⟶ π_*𝒬(d)` is exact**: `π_*` is a right adjoint. -/
theorem twistShortComplex_map_pushforward_exact :
    ((twistShortComplex d K).map
      (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T))).Exact :=
  (twistShortComplex_exact d K).map_of_mono_of_preservesKernel _ inferInstance inferInstance


/-- The map `π_*𝒦(d) ⟶ π_*𝒪^{⊕ r}(d)` is a monomorphism. -/
instance : Mono ((twistShortComplex d K).map
    (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T))).f := by
  let : PreservesLimitsOfSize.{0, 0}
      (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T)) :=
    (Scheme.Modules.pullbackPushforwardAdjunction _).rightAdjoint_preservesLimits
  have := mono_twistMap d K.arrow
  exact inferInstanceAs (Mono ((Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T)).map
    (twistMap d K.arrow)))

end Twist

section Presentation

variable {P : Polynomial ℚ}
  (hp : quotRank.{u} n r P ≤ freeRank.{u} n r (regularityIndex.{u} n r P))

/-- The map of the Grassmannian presentation of `K`. -/
theorem grassmannianPresentation_map {T : Scheme.{u}} {K : Subobject (freeModule n r T)}
    (hK : K ∈ hilbertFamilies n r P T) :
    (grassmannianPresentation hp hK).map =
      (pushforwardTwistFreeModuleIso (n := n) (r := r) T
          (regularityIndex.{u} n r P)).symm.hom ≫
        (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T)).map
          (twistMap (regularityIndex.{u} n r P : ℤ) (quotientπ K)) :=
  rfl

/-- **`ker(q) ≅ π_*𝒦(m)`** for the Grassmannian presentation
`q : 𝒪_T^{⊕ N} ≅ π_*𝒪^{⊕ r}(m) ⟶ π_*𝒬(m)` of `K ∈ Quot^P(T)`: both are kernels of `π_*(q(m))`. -/
def kernelGrassmannianPresentationIso {T : Scheme.{u}} {K : Subobject (freeModule n r T)}
    (hK : K ∈ hilbertFamilies n r P T) :
    kernel (grassmannianPresentation hp hK).map ≅
      (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T)).obj
        (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules)) :=
  isoOfIsKernelComp (pushforwardTwistFreeModuleIso (n := n) (r := r) T
      (regularityIndex.{u} n r P)).symm (grassmannianPresentation_map hp hK)
    (twistShortComplex_map_pushforward_exact (regularityIndex.{u} n r P : ℤ) K).fIsKernel
    (wk := kernel.condition _) (kernelIsKernel (grassmannianPresentation hp hK).map)

/-- The isomorphism `ker(q) ≅ π_*𝒦(m)` followed by `π_*𝒦(m) ⟶ π_*𝒪^{⊕ r}(m)` is the inclusion
`ker(q) ⟶ 𝒪_T^{⊕ N}` followed by `𝒪_T^{⊕ N} ≅ π_*𝒪^{⊕ r}(m)`. -/
theorem kernelGrassmannianPresentationIso_hom_comp {T : Scheme.{u}}
    {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T) :
    (kernelGrassmannianPresentationIso hp hK).hom ≫
        (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T)).map
          (twistMap (regularityIndex.{u} n r P : ℤ) K.arrow) =
      kernel.ι (grassmannianPresentation hp hK).map ≫
        (pushforwardTwistFreeModuleIso (n := n) (r := r) T (regularityIndex.{u} n r P)).inv :=
  isoOfIsKernelComp_hom_comp (pushforwardTwistFreeModuleIso (n := n) (r := r) T
      (regularityIndex.{u} n r P)).symm (grassmannianPresentation_map hp hK)
    (twistShortComplex_map_pushforward_exact (regularityIndex.{u} n r P : ℤ) K).fIsKernel
    (wk := kernel.condition _) (kernelIsKernel (grassmannianPresentation hp hK).map)

/-- The adjoint `π^* ker(q) ⟶ 𝒦(m)` of `ker(q) ≅ π_*𝒦(m)`. -/
def presentationKernelCounit {T : Scheme.{u}} {K : Subobject (freeModule n r T)}
    (hK : K ∈ hilbertFamilies n r P T) :
    (Scheme.Modules.pullback (projectiveSpaceOver n T ↘ T)).obj
        (kernel (grassmannianPresentation hp hK).map) ⟶
      twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules) :=
  ((Scheme.Modules.pullbackPushforwardAdjunction (projectiveSpaceOver n T ↘ T)).homEquiv _ _).symm
    (kernelGrassmannianPresentationIso hp hK).hom

/-- **`u_m` factors through `𝒦(m)`**: `u_m = (π^* ker(q) ⟶ 𝒦(m)) ≫ (𝒦(m) ⟶ 𝒪^{⊕ r}(m))`. -/
theorem presentationKernelCounit_comp_twistMap {T : Scheme.{u}}
    {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T) :
    presentationKernelCounit hp hK ≫ twistMap (regularityIndex.{u} n r P : ℤ) K.arrow =
      presentationTwistMap (regularityIndex.{u} n r P) (grassmannianPresentation hp hK) :=
  ((Scheme.Modules.pullbackPushforwardAdjunction
      (projectiveSpaceOver n T ↘ T)).homEquiv_naturality_right_symm _ _).symm.trans
    (congrArg ((Scheme.Modules.pullbackPushforwardAdjunction
      (projectiveSpaceOver n T ↘ T)).homEquiv _ _).symm
      (kernelGrassmannianPresentationIso_hom_comp hp hK))

/-- `π^* ker(q) ⟶ 𝒦(m)` is `π^*` of the isomorphism `ker(q) ≅ π_*𝒦(m)` followed by the counit. -/
theorem presentationKernelCounit_eq {T : Scheme.{u}}
    {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T) :
    presentationKernelCounit hp hK =
      (Scheme.Modules.pullback (projectiveSpaceOver n T ↘ T)).map
          (kernelGrassmannianPresentationIso hp hK).hom ≫
        (Scheme.Modules.pullbackPushforwardAdjunction (projectiveSpaceOver n T ↘ T)).counit.app
          (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules)) :=
  Adjunction.homEquiv_counit _ _ _ _

/-- `π^* ker(q) ⟶ 𝒦(m)` is an epimorphism once the counit `π^*π_*𝒦(m) ⟶ 𝒦(m)` is. -/
theorem epi_presentationKernelCounit_of_epi {T : Scheme.{u}}
    {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T)
    (h : Epi ((Scheme.Modules.pullbackPushforwardAdjunction
        (projectiveSpaceOver n T ↘ T)).counit.app
      (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules)))) :
    Epi (presentationKernelCounit hp hK) := by
  rw [presentationKernelCounit_eq]
  exact @epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom
    ((Scheme.Modules.pullback (projectiveSpaceOver n T ↘ T)).mapIso
      (kernelGrassmannianPresentationIso hp hK)))) _ h

end Presentation

section Fibre

/-- If the inverse image of `K ⊆ 𝒪^{⊕ r}` along `ℙⁿ_{T'} ⟶ ℙⁿ_T` is a monomorphism, so is that of
its twist `𝒦(d) ⟶ 𝒪^{⊕ r}(d)`. -/
theorem mono_pullback_map_twistMap_arrow {T' T : Scheme.{u}} (g : T' ⟶ T) (d : ℤ)
    (K : Subobject (freeModule n r T))
    (h : Mono ((Scheme.Modules.pullback (projectiveSpaceOverMap n g)).map K.arrow)) :
    Mono ((Scheme.Modules.pullback (projectiveSpaceOverMap n g)).map (twistMap d K.arrow)) := by
  have hnat := twistPullbackIso_hom_naturality g d K.arrow
  have := mono_twistMap d ((Scheme.Modules.pullback (projectiveSpaceOverMap n g)).map K.arrow)
  have h₁ : Mono ((twistPullbackIso g d (K : (projectiveSpaceOver n T).Modules)).hom ≫
      (Scheme.Modules.pullback (projectiveSpaceOverMap n g)).map (twistMap d K.arrow)) := by
    rw [← hnat]
    exact @mono_comp _ _ _ _ _ _ inferInstance _
      (@IsIso.mono_of_iso _ _ _ _ _ (Iso.isIso_hom (twistPullbackIso g d (freeModule n r T))))
  rw [← Iso.inv_hom_id_assoc (twistPullbackIso g d (K : (projectiveSpaceOver n T).Modules))
    ((Scheme.Modules.pullback (projectiveSpaceOverMap n g)).map (twistMap d K.arrow))]
  exact @mono_comp _ _ _ _ _ _ (@IsIso.mono_of_iso _ _ _ _ _
    (Iso.isIso_inv (twistPullbackIso g d (K : (projectiveSpaceOver n T).Modules)))) _ h₁

variable {P : Polynomial ℚ}

/-- **The base change of `π_*𝒦(m)` to a point `t` is onto `π_{t*}(𝒦_t(m))`**: a diagram chase in
the base change of `0 ⟶ π_*𝒦(m) ⟶ π_*𝒪^{⊕ r}(m) ⟶ π_*𝒬(m) ⟶ 0` (the right map is onto), where
the base-change morphisms of `𝒪^{⊕ r}(m)` and `𝒬(m)` are isomorphisms and
`0 ⟶ 𝒦_t(m) ⟶ 𝒪^{⊕ r}(m) ⟶ 𝒬_t(m)` stays exact (Tor vanishing for the flat `𝒬`). -/
theorem epi_baseChangeNatTrans_twist_subobject
    {T : Scheme.{u}} {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T)
    (t : T) :
    Epi ((baseChangeNatTrans
      (isPullback_projectiveSpaceOverMap n (T.fromSpecResidueField t)).w).app
        (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules))) := by
  have hsq := isPullback_projectiveSpaceOverMap n (T.fromSpecResidueField t)
  let β := baseChangeNatTrans hsq.w
  let S := twistShortComplex (regularityIndex.{u} n r P : ℤ) K
  have h₁ : ((S.map (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T))).map
      (Scheme.Modules.pullback (T.fromSpecResidueField t))).Exact :=
    (twistShortComplex_map_pushforward_exact _ K).map_of_epi_of_preservesCokernel _
      (epi_pushforward_twistMap_quotientπ hK) inferInstance
  have hS₂ : (S.map (Scheme.Modules.pullback
      (projectiveSpaceOverMap n (T.fromSpecResidueField t)))).Exact :=
    (twistShortComplex_exact _ K).map_of_epi_of_preservesCokernel _ inferInstance inferInstance
  have hm : Mono (S.map (Scheme.Modules.pullback
      (projectiveSpaceOverMap n (T.fromSpecResidueField t)))).f :=
    mono_pullback_map_twistMap_arrow _ _ K (mono_pullback_map_arrow_of_mem_families _ hK.1)
  have h₂ : ((S.map (Scheme.Modules.pullback
      (projectiveSpaceOverMap n (T.fromSpecResidueField t)))).map (Scheme.Modules.pushforward
        (projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t)))).Exact :=
    hS₂.map_of_mono_of_preservesKernel _ hm inferInstance
  have : Mono ((S.map (Scheme.Modules.pullback
      (projectiveSpaceOverMap n (T.fromSpecResidueField t)))).map (Scheme.Modules.pushforward
        (projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t)))).f :=
    inferInstanceAs (Mono ((Scheme.Modules.pushforward
      (projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t))).map
        (S.map (Scheme.Modules.pullback
          (projectiveSpaceOverMap n (T.fromSpecResidueField t)))).f))
  let φ : (S.map (Scheme.Modules.pushforward (projectiveSpaceOver n T ↘ T))).map
        (Scheme.Modules.pullback (T.fromSpecResidueField t)) ⟶
      (S.map (Scheme.Modules.pullback
        (projectiveSpaceOverMap n (T.fromSpecResidueField t)))).map (Scheme.Modules.pushforward
          (projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t))) :=
    { τ₁ := β.app S.X₁
      τ₂ := β.app S.X₂
      τ₃ := β.app S.X₃
      comm₁₂ := (β.naturality S.f).symm
      comm₂₃ := (β.naturality S.g).symm }
  have : IsIso φ.τ₂ := isIso_baseChangeNatTrans_twist_freeModule n r (T.fromSpecResidueField t)
    (regularityIndex.{u} n r P)
  have : IsIso φ.τ₃ := isIso_baseChangeNatTrans_twist_quotient hK _ _ _ hsq
  exact epi_τ₁_of_exact φ h₁ h₂

/-- **`𝒦(d)` is of finite type** for `K ∈ Quot(T)`: it is the kernel of the surjection
`𝒪^{⊕ r}(d) ⟶ 𝒬(d)` of a module of finite type onto one of finite presentation (Stacks 01BP). -/
theorem isFiniteType_twist_subobject {T : Scheme.{u}} {K : Subobject (freeModule n r T)}
    (hK : K ∈ families n r T) (d : ℤ) :
    (twist d (K : (projectiveSpaceOver n T).Modules)).IsFiniteType := by
  have : (twist d (quotient K)).IsFinitePresentation := isFinitePresentation_twist _ _ hK.1
  have : (twist d (freeModule n r T)).IsFiniteType :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isFinitePresentation _
      (isFinitePresentation_twist _ _ (isFinitePresentation_freeModule T))).2
  have : @Epi (SheafOfModules (projectiveSpaceOver n T).ringCatSheaf) _ _ _
      (twistMap d (quotientπ K)) := epi_twistMap _ _
  exact Stacks.SheafOfModules.Intrinsic.isFiniteType_of_iso
    ((twistShortComplex_exact d K).fIsKernel.conePointUniqueUpToIso (kernelIsKernel _)).symm
    (Stacks.SheafOfModules.SliceFinite.isFiniteType_kernel_of_epi (twistMap d (quotientπ K)))

/-- **On the fibre over `t`, the counit at `𝒦_t(m)` is onto**: `𝒦_t(m)` is the twist of the kernel
of the fibre quotient `𝒪^{⊕ r} ⟶ 𝒬_t` (Tor vanishing for the flat `𝒬`), which is generated by
global sections by the choice of `m` (`AlgebraicGeometry.ProjectiveQuot.regularityIndex_spec`). -/
theorem epi_counit_app_pullback_fibreMap_twist_subobject
    {T : Scheme.{u}} {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T)
    (t : T) :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction
      (projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t))).counit.app
        ((Scheme.Modules.pullback (fibreMap n t)).obj
          (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules)))) := by
  obtain ⟨hcoh, hval⟩ := hK.2 t
  let q : freeModules (T.residueField t) n r ⟶ fibre t (quotient K) :=
    baseChangeQuotientMap (T.fromSpecResidueField t) K
  have : Epi q := inferInstanceAs (Epi (baseChangeQuotientMap (T.fromSpecResidueField t) K))
  obtain ⟨-, -, -, -, hgen⟩ := regularityIndex_spec n r P (T.residueField t)
    (fibre t (quotient K)) q hval
  have hS := (baseShortComplex_exact K).map_of_epi_of_preservesCokernel
    (Scheme.Modules.pullback (fibreMap n t)) (inferInstanceAs (Epi (cokernel.π K.arrow)))
    inferInstance
  have : Mono ((baseShortComplex K).map (Scheme.Modules.pullback (fibreMap n t))).f :=
    mono_pullback_map_arrow_of_mem_families (T.fromSpecResidueField t) hK.1
  let eK : kernel q ≅ (Scheme.Modules.pullback (fibreMap n t)).obj
      (K : (projectiveSpaceOver n T).Modules) :=
    isoOfIsKernelComp (freeModulePullbackIso n r (T.fromSpecResidueField t)).symm
      (f := q) (g := (Scheme.Modules.pullback (fibreMap n t)).map (quotientπ K)) rfl
      hS.fIsKernel (wk := kernel.condition q) (kernelIsKernel q)
  let e : projectiveTwist n (kernel q) (regularityIndex.{u} n r P) ≅
      (Scheme.Modules.pullback (fibreMap n t)).obj
        (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules)) :=
    (twistFunctor n (Spec (T.residueField t)) (regularityIndex.{u} n r P : ℤ)).mapIso eK ≪≫
      twistPullbackIso (T.fromSpecResidueField t) (regularityIndex.{u} n r P : ℤ)
        (K : (projectiveSpaceOver n T).Modules)
  let σ := hgen.some
  have := σ.epi
  let f' := projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t)
  have : (TopologicalSpace.Opens.map f'.base).Final := CategoryTheory.final_of_representablyFlat _
  have : (SheafOfModules.pushforward (Scheme.Hom.toRingCatSheafHom f')).IsRightAdjoint :=
    ⟨_, ⟨Scheme.Modules.pullbackPushforwardAdjunction f'⟩⟩
  let eF := SheafOfModules.pullbackObjFreeIso f'.toRingCatSheafHom σ.I
  exact @epi_counit_app_of_epi _ _ _ _ _ _ (Scheme.Modules.pullbackPushforwardAdjunction f') _ _
    (eF.hom ≫ (projectiveTwist n (kernel q) (regularityIndex.{u} n r P)).freeHomEquiv.symm σ.s ≫
      e.hom)
    (@epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom eF)) _
      (@epi_comp _ _ _ _ _ _ σ.epi _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom e))))

/-- **`π^* π_* 𝒦(m) ⟶ 𝒦(m)` is an epimorphism** for `K ∈ Quot^P(T)`: it is onto on
every fibre (base change of `π_*𝒦(m)` onto the fibre sections, which generate), and `𝒦(m)` is of
finite type, so Nakayama's lemma applies. -/
theorem epi_counit_app_twist_subobject
    {T : Scheme.{u}} {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T) :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction (projectiveSpaceOver n T ↘ T)).counit.app
      (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules))) := by
  refine epi_of_forall_epi_pullback_fibre (projectiveSpaceOver n T ↘ T) _
    (isFiniteType_twist_subobject hK.1 _)
    (fun t => projectiveSpaceOver n (Spec (T.residueField t))) (fun t => fibreMap n t)
    (fun t => projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t))
    (fun t => isPullback_projectiveSpaceOverMap n (T.fromSpecResidueField t)) fun t => ?_
  have hsq := isPullback_projectiveSpaceOverMap n (T.fromSpecResidueField t)
  have key := Stacks.Modules.pullback_map_baseChangeNatTrans_app_comp_counit hsq.w
    (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules))
  have := epi_baseChangeNatTrans_twist_subobject hK t
  have h₂ := @epi_comp _ _ _ _ _ _ (Functor.map_epi (Scheme.Modules.pullback
      (projectiveSpaceOver n (Spec (T.residueField t)) ↘ Spec (T.residueField t)))
      ((baseChangeNatTrans hsq.w).app
        (twist (regularityIndex.{u} n r P : ℤ) (K : (projectiveSpaceOver n T).Modules)))) _
    (epi_counit_app_pullback_fibreMap_twist_subobject hK t)
  exact @epi_of_epi_fac _ _ _ _ _ _ _ _ h₂ key.symm

end Fibre

