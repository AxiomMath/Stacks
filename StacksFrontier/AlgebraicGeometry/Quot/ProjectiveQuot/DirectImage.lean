module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Proper.Projective
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.PseudoCoherentThree.PseudoCoherentByPseudoCoherentTwists
public import StacksFrontier.AlgebraicGeometry.Perfect.ProperFlatDegreeZeroFibres
public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.Twist
public import StacksFrontier.AlgebraicGeometry.TwoAffineCech.FibreDims
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.QuotientTwistCohomology

/-!
# The direct image of `𝒬(m)` for a family in `Quot^P`

Let `n ≥ 0`, `r ≥ 1` and `P ∈ ℚ[t]`, and let `m` be the integer of
`AlgebraicGeometry.exists_twist_cohomology_of_hilbertPolynomial` (from Stacks 08AG). For every
scheme `T` and every member `K` of `Quot^P_{𝒪^{⊕ r}/ℙⁿ/ℤ}(T)`, with quotient `𝒬 = 𝒪^{⊕ r}/K` and
`π : ℙⁿ_T ⟶ T`, the derived direct image `Rπ'_*(𝒬(m))'` is a finite locally free module of rank
`P(m)` placed in degree zero after every base change `T' ⟶ T`. This is the cohomology and base
change step of the proof of Stacks 0DPA, which produces the point of the Grassmannian attached to
`K`.

## Main definitions

* `AlgebraicGeometry.ProjectiveQuot.regularityIndex n r P`: the integer `m`.

## Main results

* `AlgebraicGeometry.ProjectiveQuot.hasDerivedPushforwardRank_twist_quotient`: the derived direct
  image of `𝒬(m)` after any base change is finite locally free of rank `P(m)` in degree zero.

## References

* [Stacks Project, Tag 0DPA](https://stacks.math.columbia.edu/tag/0DPA)
* [Stacks Project, Tag 08AG](https://stacks.math.columbia.edu/tag/08AG)
* [Stacks Project, Tag 0B91](https://stacks.math.columbia.edu/tag/0B91)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.ProjectiveQuot

variable (n r : ℕ) (P : Polynomial ℚ)

/-- The integer `m` of the proof of Stacks 0DPA: for every field `k`, every quotient of
`𝒪^{⊕ r}` on `ℙⁿ_k` with Hilbert polynomial `P` has `m`-th twist without higher cohomology and
with `P(m)`-dimensional global sections, and so on
(`AlgebraicGeometry.exists_twist_cohomology_of_hilbertPolynomial`). -/
def regularityIndex : ℕ :=
  Classical.choose (exists_twist_cohomology_of_hilbertPolynomial.{u} n r P)

/-- For every field `k` and every epimorphism `q : 𝒪^{⊕ r} ⟶ 𝒬` onto a coherent module on `ℙⁿ_k`
with Hilbert polynomial `P`, and `m = regularityIndex n r P`: the twists `(ker q)(m)` and
`𝒬(m)` have vanishing higher cohomology, `H⁰(𝒬(m))` has dimension `P(m)`, the map
`H⁰(𝒪^{⊕ r}(m)) ⟶ H⁰(𝒬(m))` is surjective, and `(ker q)(m)` is generated by global sections. -/
theorem regularityIndex_spec :
    ∀ (k : Type u) [Field k]
      (Q : (projectiveSpaceOverRing n (.of k)).Modules) [Q.IsCoherent]
      (q : freeModules k n r ⟶ Q) [Epi q],
      (∀ d : ℤ, (hilbertPolynomial k n Q d : ℚ) = P.eval (d : ℚ)) →
      (∀ i : ℕ, 0 < i → IsZero (cohomologyOverField k
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k))
          (projectiveTwist n (kernel q) (regularityIndex.{u} n r P)) i)) ∧
      (∀ i : ℕ, 0 < i → IsZero (cohomologyOverField k
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k))
          (projectiveTwist n Q (regularityIndex.{u} n r P)) i)) ∧
      (Module.finrank k (cohomologyOverField k
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k))
          (projectiveTwist n Q (regularityIndex.{u} n r P)) 0) : ℚ) =
        P.eval ((regularityIndex.{u} n r P : ℕ) : ℚ) ∧
      Function.Surjective (cohomologyOverFieldMap k
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k))
          ((twistFunctorModules k n (regularityIndex.{u} n r P)).map q) 0) ∧
      SheafOfModules.IsGeneratedByGlobalSections
        (projectiveTwist n (kernel q) (regularityIndex.{u} n r P)) :=
  Classical.choose_spec (exists_twist_cohomology_of_hilbertPolynomial.{u} n r P)

/-- The structure morphism `ℙⁿ_T ⟶ T` is of finite presentation. -/
theorem finitePresentation_projectiveSpaceOver (T : Scheme.{u}) :
    FinitePresentation (projectiveSpaceOver n T ↘ T) :=
  ⟨inferInstance, inferInstance, inferInstance⟩

variable {n r P}

/-- **Cohomology and base change for `Quot^P`.** For `K ∈ Quot^P_{𝒪^{⊕ r}/ℙⁿ/ℤ}(T)` with quotient
`𝒬`, and `m = regularityIndex n r P`, the derived direct image of `𝒬(m)` along the base change
`π' : Y' ⟶ T'` of `ℙⁿ_T ⟶ T` along any `T' ⟶ T` is finite locally free of rank `P(m)` in degree
zero. -/
theorem hasDerivedPushforwardRank_twist_quotient {T : Scheme.{u}}
    {K : Subobject (freeModule n r T)} (hK : K ∈ hilbertFamilies n r P T)
    {Y' T' : Scheme.{u}} (h : T' ⟶ T) (π' : Y' ⟶ T') (h' : Y' ⟶ projectiveSpaceOver n T)
    (hsq : IsPullback h' π' (projectiveSpaceOver n T ↘ T) h) :
    ProperFlatFibreEulerCharacteristic.HasDerivedPushforwardRank π'
      ((Scheme.Modules.pullback h').obj
        (twist (regularityIndex.{u} n r P : ℤ) (quotient K))) 0
      ⌊P.eval ((regularityIndex.{u} n r P : ℕ) : ℚ)⌋₊ := by
  obtain ⟨⟨hfp, hflat⟩, hP⟩ := hK
  set m := regularityIndex.{u} n r P
  have := isProper_projectiveSpaceOver n T
  refine ProperFlatFibreEulerCharacteristic.hasDerivedPushforwardRank_zero_of_fibres _
    (finitePresentation_projectiveSpaceOver n T) _ (isFinitePresentation_twist _ _ hfp)
    (isFlatOver_twist _ _ _ hflat) _ (fun t => ?_) h π' h' hsq
  obtain ⟨hcoh, hval⟩ := hP t
  let q : freeModules (T.residueField t) n r ⟶ fibre t (quotient K) :=
    baseChangeQuotientMap (T.fromSpecResidueField t) K
  have : Epi q := inferInstanceAs (Epi (baseChangeQuotientMap (T.fromSpecResidueField t) K))
  obtain ⟨-, hvan, h0, -, -⟩ := regularityIndex_spec n r P (T.residueField t)
    (fibre t (quotient K)) q hval
  let e : (Scheme.Modules.pullback (fibreMap n t)).obj (twist (m : ℤ) (quotient K)) ≅
      projectiveTwist n (fibre t (quotient K)) m :=
    (twistPullbackIso (T.fromSpecResidueField t) (m : ℤ) (quotient K)).symm
  let f := projectiveSpaceOverRing n (.of (T.residueField t)) ↘ Spec (.of (T.residueField t))
  have hfinrank := fun j => (Stacks.FibreCohomology.cohomologyOverFieldMapIso _ f e
    j).toLinearEquiv.finrank_eq
  refine ⟨_, f, fibreMap n t, isPullback_projectiveSpaceOverMap n (T.fromSpecResidueField t),
    ?_, fun j hj => ?_⟩
  · rw [hfinrank 0, ← h0, Nat.floor_natCast]
  · have := ModuleCat.subsingleton_of_isZero (hvan j hj)
    rw [hfinrank j, Module.finrank_zero_of_subsingleton]

end AlgebraicGeometry.ProjectiveQuot

end
