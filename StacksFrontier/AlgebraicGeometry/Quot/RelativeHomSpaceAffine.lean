module

public import StacksFrontier.AlgebraicGeometry.Quot.RelativeHomStageRepresentable

/-!
# The relative Hom space: Stacks 08K6

In Situation 08JT let `f : X ⟶ B` be of finite presentation and `G` a finitely presented
`𝒪_X`-module, flat over `B`, with support proper over `B`.  Stacks 08K6: `Hom(F, G)` is an
algebraic space affine over `B`, and if `F` is of finite presentation it is of finite presentation
over `B`.

## Main results

* `HomSituation.isAffineFinitePresentationAlgebraicSpaceOverBase_of_isFinitePresentation`: the
  second assertion.
* `HomSituation.isAffineAlgebraicSpaceOverBase_of_isFinitePresentation`: the first assertion, for
  `F` étale-locally generated by fewer sections than the cutoff of the site.  As printed, for every
  quasi-coherent `F`, it is false on the size-bounded site.

## Implementation notes

"Support proper over `B`" is `AlgebraicGeometry.Space.CoherentSituation.HasProperSupportOver`:
`f` is locally of finite type and the support of `G`, a closed subset of `|X|`, is proper over
`B` (Stacks 0CZD).  The functor `Hom(F, G)` is the one of Stacks 08JT,
`AlgebraicGeometry.Space.HomSituation.homFunctor`, formed with
`AlgebraicGeometry.Space.modulePushforwardCoherence`: the pseudofunctoriality of the direct images
(Stacks 03LU) that makes pullback of homomorphisms functorial in the test scheme.

## References

* [Stacks Project, Tag 08K6](https://stacks.math.columbia.edu/tag/08K6)
* [Stacks Project, Tag 08JY](https://stacks.math.columbia.edu/tag/08JY)
* [Stacks Project, Tag 08JT](https://stacks.math.columbia.edu/tag/08JT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space.HomSituation

open CoherentSituation

variable {B : BigFppfSite.{u}}

variable {S : Scheme.{u}} {hS : B.Contains S}

/-- In Situation 08JT let `f : X ⟶ B` be of finite presentation and let `G` be an `𝒪_X`-module of
finite presentation, flat over `B`, with support proper over `B`.  If `F` is of finite
presentation, then `Hom(F, G)` is an algebraic space affine and of finite presentation over `B`. -/
@[stacks 08K6 "second assertion: for F of finite presentation, Hom(F, G) is an algebraic space \
affine and of finite presentation over B"]
theorem isAffineFinitePresentationAlgebraicSpaceOverBase_of_isFinitePresentation
    (s : HomSituation B S hS)
    (hf : IsFinitePresentation B S hS s.f.hom) (hF : s.F.IsFinitePresentationOnSite)
    (hG : s.G.IsFinitePresentationOnSite) (hflat : IsFlatOver B S hS s.X.2 s.f.hom s.G)
    (hproper : HasProperSupportOver s.f s.G) :
    s.IsAffineFinitePresentationAlgebraicSpaceOverBase (modulePushforwardCoherence B S hS) :=
  isAffineFinitePresentationAlgebraicSpaceOverBase_of_stages_of_isFinitePresentation
    B.contains_terminal (fun T₀ hT₀ v hv hvf hvF hvG hvflat hvproper =>
      affineFiniteTypeStageRepresentability T₀ hT₀ v hv hvf hvF hvG hvflat hvproper)
    s _ hf hF hG hflat hproper

/-- In Situation 08JT let `f : X ⟶ B` be of finite presentation and let `G` be an `𝒪_X`-module of
finite presentation, flat over `B`, with support proper over `B`.  Then `Hom(F, G)` is an
algebraic space affine over `B`, for every quasi-coherent `F` étale-locally generated by fewer
than `μ` sections for one cardinal `μ` below the cutoff of the site (every module of finite type
is).

Without the bound on `F` the statement is false on a size-bounded site: for `X = B = Spec k` with
`Spec k` in the site, `G = 𝒪_X` and `F = ⊕_{i ∈ I} 𝒪_X` with `#I` at least the cutoff, `Hom(F, G)`
takes the value `A^I` at `Spec A`, and an affine scheme `Spec R` representing it has its universal
element `(r_i)_{i ∈ I}` with pairwise distinct coordinates, so `#R ≥ #I`, impossible for an object
of the site. -/
@[stacks 08K6 "first assertion: Hom(F, G) is an algebraic space affine over B, for F \
étale-locally generated by fewer sections than the cutoff of the site (Stacks erratum)"]
theorem isAffineAlgebraicSpaceOverBase_of_isFinitePresentation
    (s : HomSituation B S hS)
    (hf : IsFinitePresentation B S hS s.f.hom)
    (hG : s.G.IsFinitePresentationOnSite) (hflat : IsFlatOver B S hS s.X.2 s.f.hom s.G)
    (hproper : HasProperSupportOver s.f s.G)
    (hF : ∃ μ < B.cutoff, IsEtaleLocallyGeneratedBelow B S hS μ s.F) :
    s.IsAffineAlgebraicSpaceOverBase (modulePushforwardCoherence B S hS) :=
  isAffineAlgebraicSpaceOverBase_of_isEtaleLocallyGeneratedBelow
    (fun v hvf hvF hvG hvflat hvproper =>
      v.isAffineFinitePresentationAlgebraicSpaceOverBase_of_isFinitePresentation hvf hvF hvG
        hvflat hvproper)
    s _ hf hG hflat hproper hF

end AlgebraicGeometry.Space.HomSituation

end
