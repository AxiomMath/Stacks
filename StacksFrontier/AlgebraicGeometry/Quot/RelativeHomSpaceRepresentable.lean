module

public import StacksFrontier.AlgebraicGeometry.Quot.RelativeHomStageRepresentable
public import StacksFrontier.AlgebraicGeometry.Quot.RelativeHomUnboundedSource

/-!
# The relative Hom space is affine over the base

Stacks 08K6: in Situation 08JT let `f : X ⟶ B` be of finite presentation and `𝒢` a finitely
presented `𝒪_X`-module, flat over `B`, with support proper over `B`. Then `Hom(𝓕, 𝒢)` is an
algebraic space affine over `B`, and if `𝓕` is of finite presentation it is of finite
presentation over `B`.

## Main results

In the namespace `AlgebraicGeometry`:

* `Space.HomSituation.isAffineFinitePresentationAlgebraicSpaceOverBase_of_finitePresentation`:
  the second assertion, for `𝓕` of finite presentation, as printed.
* `Space.HomSituation.isAffineAlgebraicSpaceOverBase_of_finitePresentation`:
  the first assertion, for `𝓕` étale-locally generated by fewer than `μ` sections, `μ` below the
  cutoff of the site. This covers every `𝓕` of finite type. As printed, for every quasi-coherent
  `𝓕`, the first assertion is false on the size-bounded site
  (`AlgebraicGeometry.Space.not_forall_isAffineAlgebraicSpaceOverBase`): a free module of rank
  the cutoff has a relative Hom functor represented by no affine object of the site.

Both are deduced in `StacksFrontier/AlgebraicGeometry/Quot/RelativeHomSpaceStages.lean` from the
case of an affine base of finite type over `ℤ`, which is
`AlgebraicGeometry.Space.HomSituation.affineFiniteTypeStageRepresentability` (the proof of
Stacks 08JY).

## References

* [Stacks Project, Tag 08K6](https://stacks.math.columbia.edu/tag/08K6)
* [Stacks Project, Tag 08JY](https://stacks.math.columbia.edu/tag/08JY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Space.HomSituation

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **Stacks 08K6, the second assertion.** In Situation 08JT let `f` be of finite presentation,
`𝓕` of finite presentation and `𝒢` of finite presentation, flat over the base, with support
proper over the base. Then `Hom(𝓕, 𝒢)` is an algebraic space affine and of finite presentation
over the base. -/
theorem isAffineFinitePresentationAlgebraicSpaceOverBase_of_finitePresentation
    (s : HomSituation B S hS) (hfp : IsFinitePresentation B S hS s.f.hom)
    (hF : s.F.IsFinitePresentationOnSite) (hG : s.G.IsFinitePresentationOnSite)
    (hGflat : IsFlatOver B S hS s.X.2 s.f.hom s.G)
    (hGsupp : HasProperSupport B S hS s.X.2 s.base.2 s.f.hom
      (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B S hS hfp.1)
      ((SheafOfModules.toSheaf _).obj s.G)) :
    s.IsAffineFinitePresentationAlgebraicSpaceOverBase (modulePushforwardCoherence B S hS) :=
  isAffineFinitePresentationAlgebraicSpaceOverBase_of_affineFiniteTypeStages
    affineFiniteTypeStageRepresentability s _ hfp hF hG hGflat hGsupp

/-- **Stacks 08K6, the first assertion.** In Situation 08JT let `f` be of finite presentation and
`𝒢` of finite presentation, flat over the base, with support proper over the base, and let `𝓕`
be étale-locally generated by fewer than `μ` sections for some cardinal `μ` below the cutoff of the
site (for instance `𝓕` of finite type). Then `Hom(𝓕, 𝒢)` is an algebraic space affine over the
base. Without the bound on `𝓕` the assertion is false on the size-bounded site:
`AlgebraicGeometry.Space.not_forall_isAffineAlgebraicSpaceOverBase`. -/
theorem isAffineAlgebraicSpaceOverBase_of_finitePresentation
    (s : HomSituation B S hS) (hc : ModulePushforwardCoherence B S hS)
    (hfp : IsFinitePresentation B S hS s.f.hom)
    (hG : s.G.IsFinitePresentationOnSite) (hGflat : IsFlatOver B S hS s.X.2 s.f.hom s.G)
    (hGsupp : HasProperSupport B S hS s.X.2 s.base.2 s.f.hom
      (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B S hS hfp.1)
      ((SheafOfModules.toSheaf _).obj s.G))
    (hF : ∃ μ < B.cutoff, IsEtaleLocallyGeneratedBelow B S hS μ s.F) :
    s.IsAffineAlgebraicSpaceOverBase hc :=
  isAffineAlgebraicSpaceOverBase_of_affineFiniteTypeStages
    affineFiniteTypeStageRepresentability s hc hfp hG hGflat hGsupp hF

end AlgebraicGeometry.Space.HomSituation

end
