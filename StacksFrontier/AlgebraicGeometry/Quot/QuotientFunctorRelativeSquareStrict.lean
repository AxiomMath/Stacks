module

public import StacksFrontier.AlgebraicGeometry.Quot.QuotientFunctorRelativeSquare
public import StacksFrontier.Deformation.ToposThickening.MorphismOfThickeningsIdealMap
public import StacksFrontier.Deformation.ToposThickening.FlatLiftObstruction
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.AlgebraicGeometry.Spaces.LocallyPrincipalPullback
public import StacksFrontier.AlgebraicGeometry.Spaces.ChartPullbackInverseImageSection
public import StacksFrontier.AlgebraicGeometry.Spaces.Thickenings.SmallEtaleFirstOrderThickeningIdeal
public import StacksFrontier.Deformation.ToposThickening.FlatLiftBaseRingComparison

/-!
# The relative square of Remark 0CZU is strict

In Situation 082M let `h : T ⟶ T'` be a first order thickening of schemes over `Y`. Remark 0CZU
uses that `X_T ⊂ X_{T'}` is a first order thickening whose ideal `I` is a quotient of `f_T^*𝒥`,
`𝒥` the ideal of `T` in `T'`: in the language of Stacks 08M9, the morphism of first order
thickenings `(X_T ⊂ X_{T'}) ⟶ (T ⊂ T')` is strict. This file proves this for the relative
square of `AlgebraicGeometry.Space.QuotientSituation.relativeSquare_comm`, where the base is read
on the small étale topos of `X_{T'}` through the thickening `t̃ = (id, f'⁻¹t^♯)` of
`f'⁻¹𝒪_{T'}`.

The argument has a topos-theoretic and a geometric half.

* For the relative square of `Deformation.ToposThickening.relBase_comm` (any ringed topoi), the
  map of ideals `f̃'^*J̃ ⟶ I` carries the image of a section `s` of `f'⁻¹O_{ℬ'}` killed by the
  reduction to `f̃'^♯(s)` (`Deformation.ToposThickening.exists_idealMap_eq_relBaseRight`), so it is
  an epimorphism as soon as every local section of `I` is, locally, in the ideal generated by
  such images (`Deformation.ToposThickening.isStrict_relBase_of_imageSieve_mem`).
* On an affine étale chart `W` of `X_{T'}` lying over an affine étale chart `U` of `T'`, the ideal
  of `X_T` is the extension of the ideal of `T` (Stacks 09ZX read on charts,
  `AlgebraicGeometry.Space.definingIdealAt_preimage_eq_map`), and the pullback of a function `j`
  in the ideal of `T` is `f̃'^♯` of the section of `f'⁻¹𝒪_{T'}` attached to `j`
  (`AlgebraicGeometry.Space.exists_inverseImageBaseReduction_eq_zero`), which the reduction kills
  because `t^♯` kills `j`.

## Main results

* `AlgebraicGeometry.Space.QuotientSituation.isStrict_relativeSquare`: the morphism of first order
  thickenings of the relative square is strict (Stacks 08M9).
* `AlgebraicGeometry.Space.QuotientSituation.relBaseIsStrict_relativeSquare`: the same, through
  `Deformation.ToposThickening.RelBaseIsStrict`.

## Implementation notes

The statements on the relative square pin their universe levels: left to unification, the levels
of the auxiliary ringed topoi `relBaseTop` and `relBaseBottom` default to zero and the instance
problems on their sites do not resolve.

## References

* [Stacks Project, Tag 0CZU](https://stacks.math.columbia.edu/tag/0CZU)
* [Stacks Project, Tag 08M7](https://stacks.math.columbia.edu/tag/08M7)
* [Stacks Project, Tag 08M9](https://stacks.math.columbia.edu/tag/08M9)
* [Stacks Project, Tag 09ZX](https://stacks.math.columbia.edu/tag/09ZX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry (RingedTopos RingedToposHom)
open Stacks.Sheaves.ToposPushforward (pushforwardCommRingFunctor inverseImageCommRingFunctor
  commRingImageAdjunction)
open Stacks.Sheaves.ToposPullback (pullbackCommRingSheafFunctorId)

universe v u w v' u' vS uS wS vS' uS'

namespace Deformation.ToposThickening

section RelativeBaseStrict

variable {X : RingedTopos.{v, u, w}} {X' : RingedTopos.{v', u', w}}
  {S : RingedTopos.{vS, uS, w}} {S' : RingedTopos.{vS', uS', w}}
  [X.J.HasSheafCompose (forget RingCat.{w})] [X'.J.HasSheafCompose (forget RingCat.{w})]
  [S.J.HasSheafCompose (forget RingCat.{w})] [S'.J.HasSheafCompose (forget RingCat.{w})]
  [X.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [X'.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [S.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [S'.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [X.J.HasSheafCompose (forget AddCommGrpCat.{w})]
  [X'.J.HasSheafCompose (forget AddCommGrpCat.{w})]
  [S'.J.HasSheafCompose (forget AddCommGrpCat.{w})]
  [HasSheafify X'.J AddCommGrpCat.{w}] [X'.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
  [HasWeakSheafify X'.J AddCommGrpCat.{w}]
  {i : RingedToposHom X X'} {t : RingedToposHom S S'} {f' : RingedToposHom X' S'}
  {p : RingedToposHom X S}
  {θ : (pushforwardCommRingFunctor f'.toToposHom).obj
      ((pushforwardCommRingFunctor i.toToposHom).obj X.O) ≅
    (pushforwardCommRingFunctor t.toToposHom).obj
      ((pushforwardCommRingFunctor p.toToposHom).obj X.O)}
  (hi : FirstOrderThickening i) (ht : FirstOrderThickening t)
  (comm : (relBaseRight f').comp i = (relBaseThickening t f').comp (relBaseLeft i t f' p θ))

/-- **The morphism of thickenings of the relative square** `(f̃, f̃')` from `i` to `t̃`
(Stacks 08M7), with the square-zero ideals of `i` and of `t̃`. -/
noncomputable abbrev relBaseMorphism :
    MorphismOfThickenings X X' (relBaseBottom t f') (relBaseTop f') :=
  (MorphismOfThickenings.ofFirstOrderThickenings i (relBaseThickening t f')
        (relBaseLeft i t f' p θ) (relBaseRight f') hi (relBaseThickeningFirstOrderThickening ht)
        comm)

/-- **Strictness of the relative square** (Stacks 08M9): the morphism of thickenings
`Deformation.ToposThickening.relBaseMorphism` is strict, that is, its map of ideals
`f̃'^*J̃ ⟶ I` is an epimorphism. Stated with the instances of the thickened topos, which is also
the site of the two base topoi. -/
abbrev RelBaseIsStrict : Prop := (relBaseMorphism hi ht comm).IsStrict

/-- **A local section of `f'⁻¹O_{ℬ'}` killed by the reduction gives a section of `f̃'^*J̃`** whose
image under the map of ideals, read in `O'`, is `f̃'^♯` of the section: the map of ideals is the
adjoint transpose of `J̃ ⟶ f'⁻¹O_{ℬ'} ⟶ O'` (Stacks 08M7), and the direct image along the
identity morphism of topoi does not change sections. -/
theorem exists_idealMap_eq_relBaseRight (V : X'.Cᵒᵖ)
    (s : (inverseImageBaseRing f').obj.obj V)
    (hs : (inverseImageBaseReduction t f').hom.app V s = 0) :
    ∃ z : (((relBaseMorphism hi ht comm).f'.toModulesHom.pullbackModules).obj
        (relBaseMorphism hi ht comm).idealJ.I).val.obj V,
      hi.incl.val.app V ((relBaseMorphism hi ht comm).idealMap.val.app V z) =
        (relBaseRight f').fSharp.hom.app V s := by
  have h0 : (relBaseThickening t f').fSharp.hom.app V s = 0 :=
    (congrArg (((pullbackCommRingSheafFunctorId X'.J).inv.app
      (inverseImageReducedBaseRing t f')).hom.app V).hom hs).trans (map_zero _)
  obtain ⟨b, hb⟩ := (relBaseThickeningFirstOrderThickening ht).exists_ideal_section V s h0
  have key := congrArg (fun g => g.val.app V b)
    (MorphismOfThickenings.homEquiv_idealMap_comp_incl
      (relBaseMorphism hi ht comm))
  rw [Adjunction.homEquiv_unit] at key
  refine ⟨_, key.trans ?_⟩
  refine (comp_val_app (relBaseMorphism hi ht comm).idealJ.incl
    (AlgebraicGeometry.RingedToposHom.unitStructureMap
          (relBaseRight f')) V b).trans ?_
  refine (AlgebraicGeometry.RingedToposHom.unitStructureMap_val_app (relBaseRight f') V
    ((relBaseThickeningFirstOrderThickening ht).incl.val.app V b)).trans ?_
  exact congrArg ((relBaseRight f').fSharp.hom.app V) hb

/-- Every element of the ideal of `O'` generated by the images under `f̃'^♯` of the local
sections of `f'⁻¹O_{ℬ'}` killed by the reduction is, read in `O'`, the image of a section of
`f̃'^*J̃` under the map of ideals. -/
theorem exists_idealMap_eq_of_mem_span (V : X'.Cᵒᵖ) (y : X'.O.obj.obj V)
    (hy : y ∈ Ideal.span {y' : X'.O.obj.obj V | ∃ s : (inverseImageBaseRing f').obj.obj V,
      (inverseImageBaseReduction t f').hom.app V s = 0 ∧
        (relBaseRight f').fSharp.hom.app V s = y'}) :
    ∃ z : (((relBaseMorphism hi ht comm).f'.toModulesHom.pullbackModules).obj
        (relBaseMorphism hi ht comm).idealJ.I).val.obj V,
      (relBaseMorphism hi ht comm).idealI.incl.val.app V
        ((relBaseMorphism hi ht comm).idealMap.val.app V z) = y := by
  induction hy using Submodule.span_induction with
  | mem y' hy' =>
    obtain ⟨s, hs, rfl⟩ := hy'
    exact exists_idealMap_eq_relBaseRight hi ht comm V s hs
  | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
  | add a b _ _ ha hb =>
    obtain ⟨za, hza⟩ := ha
    obtain ⟨zb, hzb⟩ := hb
    exact ⟨za + zb, by rw [map_add, map_add, hza, hzb]; rfl⟩
  | smul c a _ ha =>
    obtain ⟨za, hza⟩ := ha
    refine ⟨(show (Stacks.SheafOfModules.Tensor.ringSheaf X'.O).obj.obj V from c) • za, ?_⟩
    rw [map_smul, map_smul, hza]
    rfl

/-- The sieve of the arrows `W ⟶ V` on which a local section `x` of `O'` becomes, read in `O'`,
the image of a section of `f̃'^*J̃` under the map of ideals of the relative square. -/
def relBaseImageSieve (V : X'.Cᵒᵖ) (x : X'.O.obj.obj V) : Sieve V.unop where
  arrows W g := ∃ z : (((relBaseMorphism hi ht comm).f'.toModulesHom.pullbackModules).obj
      (relBaseMorphism hi ht comm).idealJ.I).val.obj (Opposite.op W),
    (relBaseMorphism hi ht comm).idealI.incl.val.app (Opposite.op W)
        ((relBaseMorphism hi ht comm).idealMap.val.app (Opposite.op W) z) =
      X'.O.obj.map g.op x
  downward_closed := by
    rintro W W' g ⟨z, hz⟩ g'
    refine ⟨(((relBaseMorphism hi ht comm).f'.toModulesHom.pullbackModules).obj
      (relBaseMorphism hi ht comm).idealJ.I).val.map g'.op z, ?_⟩
    refine (congrArg ((relBaseMorphism hi ht comm).idealI.incl.val.app (Opposite.op W'))
      (PresheafOfModules.naturality_apply (relBaseMorphism hi ht comm).idealMap.val g'.op
        z)).trans ?_
    refine (PresheafOfModules.naturality_apply (relBaseMorphism hi ht comm).idealI.incl.val g'.op
      _).trans ?_
    refine (congrArg (X'.O.obj.map g'.op) hz).trans ?_
    rw [op_comp, Functor.map_comp]
    rfl

/-- An arrow lies in `Deformation.ToposThickening.relBaseImageSieve` as soon as the restriction
of the section lies in the ideal generated by the images under `f̃'^♯` of the sections killed by
the reduction. -/
theorem relBaseImageSieve_of_mem_span (V : X'.Cᵒᵖ) (x : X'.O.obj.obj V) {W : X'.C}
    (g : W ⟶ V.unop)
    (hy : X'.O.obj.map g.op x ∈ Ideal.span {y' : X'.O.obj.obj (Opposite.op W) |
      ∃ s : (inverseImageBaseRing f').obj.obj (Opposite.op W),
        (inverseImageBaseReduction t f').hom.app (Opposite.op W) s = 0 ∧
          (relBaseRight f').fSharp.hom.app (Opposite.op W) s = y'}) :
    relBaseImageSieve hi ht comm V x g :=
  exists_idealMap_eq_of_mem_span hi ht comm (Opposite.op W) _ hy

/-- **A criterion for strictness of the relative square** (Stacks 08M9): the square is strict as
soon as, for every local section `x` of `O'` killed by `i^♯`, the arrows on which `x` comes from
the map of ideals form a covering sieve. -/
theorem isStrict_relBase_of_imageSieve_mem
    (hloc : ∀ (V : X'.Cᵒᵖ) (x : X'.O.obj.obj V), i.fSharp.hom.app V x = 0 →
      relBaseImageSieve hi ht comm V x ∈ X'.J V.unop) :
    RelBaseIsStrict hi ht comm := by
  show Epi (relBaseMorphism hi ht comm).idealMap
  refine Stacks.SheafOfModules.EpiMono.epi_of_isLocallySurjective _ ⟨fun {U} x => ?_⟩
  refine X'.J.superset_covering ?_ (hloc (Opposite.op U)
    ((relBaseMorphism hi ht comm).idealI.incl.val.app (Opposite.op U) x)
    ((relBaseMorphism hi ht comm).idealI.fSharp_incl_apply (Opposite.op U) x))
  rintro W g ⟨z, hz⟩
  refine ⟨z, (relBaseMorphism hi ht comm).idealI.injective (Opposite.op W) ?_⟩
  refine hz.trans ?_
  exact (PresheafOfModules.naturality_apply (relBaseMorphism hi ht comm).idealI.incl.val g.op
    x).symm

end RelativeBaseStrict

end Deformation.ToposThickening

namespace AlgebraicGeometry.Space

section ChartSection

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)

/-- The arrow into the cartesian base change `X ×_Y U` attached to a morphism of étale scheme
charts `p : W ⟶ U` lying over `f`. -/
noncomputable abbrev chartArrowOfMap (W : SmallEtale B S hS X.1) (U : SmallEtale B S hS Y.1)
    (p : W.1.left ⟶ U.1.left) (hp : W.1.hom ≫ f.hom = yoneda.map p ≫ U.1.hom) :
    StructuredArrow (Opposite.op (chartBaseChange B S hS f U)) (comparisonFunctor B S hS X).op :=
  StructuredArrow.mk (Y := Opposite.op W) (baseChangeArrowOfChartDiagram B S hS f ⟨W, U, p, hp⟩).op

/-- **The inverse-image form of the structure map carries the section attached to a regular
function on a chart of the target to its pullback along the morphism of charts.** -/
theorem fSharpInverseImage_chartPullbackInverseImageSection (W : SmallEtale B S hS X.1)
    (U : SmallEtale B S hS Y.1) (p : W.1.left ⟶ U.1.left)
    (hp : W.1.hom ≫ f.hom = yoneda.map p ≫ U.1.hom)
    (b : (smallEtaleRingedTopos B S hS Y).O.obj.obj (Opposite.op U)) :
    (smallEtaleRingedToposHom B S hS f).fSharpInverseImage.hom.app (Opposite.op W)
        ((chartPullbackInverseImageSection B S hS f U (chartArrowOfMap B S hS f W U p hp)).hom b) =
      (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map p).op).hom b := by
  have h1 := Deformation.ToposThickening.forget_map_homEquiv_symm
    (smallEtaleRingedToposHom B S hS f).toToposHom (smallEtaleRingedTopos B S hS Y).O
    (smallEtaleRingedTopos B S hS X).O (smallEtaleRingedToposHom B S hS f).fSharp
  have h2 : (sheafCompose (SmallEtale.topology B S hS Y.1) (forget CommRingCat.{u})).map
      (smallEtaleRingedToposHom B S hS f).fSharp = structureSharpSet B S hS f :=
    congrArg (sheafCompose (SmallEtale.topology B S hS Y.1) (forget RingCat.{u})).map
      (forgetCommRingSheaf_map_fSharp B S hS f)
  have h3 := congrArg (fun m => m.hom.app (Opposite.op W)
    ((chartPullbackInverseImageSection B S hS f U (chartArrowOfMap B S hS f W U p hp)).hom b))
    (h1.trans (congrArg _ h2))
  refine h3.trans ?_
  refine (directImageChartProjection_map B S hS f U (chartArrowOfMap B S hS f W U p hp)
    (((smallEtaleRingedToposHom B S hS f).toToposHom.adj.homEquiv _ _).symm
      (structureSharpSet B S hS f))
    (((smallEtaleRingedToposHom B S hS f).toToposHom.adj.unit.app _).hom.app (Opposite.op U)
      b)).symm.trans ?_
  have h4 := congrArg (fun m => m.hom.app (Opposite.op U) b)
    ((((smallEtaleRingedToposHom B S hS f).toToposHom.adj.homEquiv_unit _ _ _).symm).trans
      (((smallEtaleRingedToposHom B S hS f).toToposHom.adj.homEquiv _ _).apply_symm_apply
        (structureSharpSet B S hS f)))
  refine (congrArg ((directImageChartProjection B S hS f U
    (chartArrowOfMap B S hS f W U p hp)).app (structureSetSheaf B S hS X)) h4).trans ?_
  exact directImageChartProjection_structureSharpSet_chartDiagram B S hS f ⟨W, U, p, hp⟩ b

set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 800000 in
set_option synthInstance.maxHeartbeats 400000 in
/-- **The ring map `R(V) ⟶ (f⁻¹R)(W)` attached to an étale chart `W` of `X` above
`X ×_Y V`**, for an arbitrary sheaf of rings `R` on the small étale site of `Y`: the unit of
`f⁻¹ ⊣ f_*` followed by the chart projection.
`AlgebraicGeometry.Space.chartPullbackInverseImageSection` is its value at the structure
sheaf. -/
noncomputable def chartInverseImageSectionHom (V : SmallEtale B S hS Y.1)
    (j : StructuredArrow (Opposite.op (chartBaseChange B S hS f V)) (comparisonFunctor B S hS X).op)
    (R : Sheaf (SmallEtale.topology B S hS Y.1) RingCat.{u}) :
    R.obj.obj (Opposite.op V) ⟶
      (Stacks.Sheaves.ToposPullback.pullbackRingSheaf.{u, u, u, u + 1, u, u + 1}
        (SmallEtale.topology B S hS X.1) (smallToposMorphismTypeU B S hS f).inverseImage R).obj.obj
          j.right :=
  (Stacks.Sheaves.ToposPushforward.ringUnit (smallToposMorphismTypeU B S hS f) R).hom.app
      (Opposite.op V) ≫
    Stacks.Sheaves.ToposPullback.pullbackRingSectionsHom (SmallEtale.topology B S hS Y.1)
      (SmallEtale.topology B S hS X.1) (smallEtaleDirectImage B S hS f)
      (Stacks.Sheaves.ToposPullback.pullbackRingSheaf.{u, u, u, u + 1, u, u + 1}
        (SmallEtale.topology B S hS X.1) (smallToposMorphismTypeU B S hS f).inverseImage R)
      (Opposite.op V) j.right (directImageChartProjection B S hS f V j)

/-- **A map of sheaves of commutative rings killing a regular function kills its attached
section**, read in the inverse image: the inverse image of the map carries the section attached
to `b` to the section attached to the image of `b`, which is zero. -/
theorem inverseImage_map_chartPullbackInverseImageSection_eq_zero (W : SmallEtale B S hS X.1)
    (U : SmallEtale B S hS Y.1) (p : W.1.left ⟶ U.1.left)
    (hp : W.1.hom ≫ f.hom = yoneda.map p ≫ U.1.hom)
    {N : Sheaf (SmallEtale.topology B S hS Y.1) CommRingCat.{u}}
    (φ : (smallEtaleRingedTopos B S hS Y).O ⟶ N)
    (b : (smallEtaleRingedTopos B S hS Y).O.obj.obj (Opposite.op U))
    (hb : φ.hom.app (Opposite.op U) b = 0) :
    ((inverseImageCommRingFunctor (smallEtaleRingedToposHom B S hS f).toToposHom).map φ).hom.app
        (Opposite.op W)
        ((chartPullbackInverseImageSection B S hS f U (chartArrowOfMap B S hS f W U p hp)).hom b) =
      0 := by
  have h1 := congrArg (fun m => m.hom.app (Opposite.op W)
    ((chartPullbackInverseImageSection B S hS f U (chartArrowOfMap B S hS f W U p hp)).hom b))
    (Deformation.ToposThickening.forget_map_inverseImage_map
      (smallEtaleRingedToposHom B S hS f).toToposHom φ)
  refine h1.trans ?_
  refine (directImageChartProjection_map B S hS f U (chartArrowOfMap B S hS f W U p hp)
    ((smallEtaleRingedToposHom B S hS f).toToposHom.inverseImage.map
      ((sheafCompose (SmallEtale.topology B S hS Y.1) (forget CommRingCat.{u})).map φ))
    (((smallEtaleRingedToposHom B S hS f).toToposHom.adj.unit.app _).hom.app (Opposite.op U)
      b)).symm.trans ?_
  have h2 := congrArg (fun m => m.hom.app (Opposite.op U) b)
    ((smallEtaleRingedToposHom B S hS f).toToposHom.adj.unit.naturality
      ((sheafCompose (SmallEtale.topology B S hS Y.1) (forget CommRingCat.{u})).map φ)).symm
  refine (congrArg ((directImageChartProjection B S hS f U
    (chartArrowOfMap B S hS f W U p hp)).app _) h2).trans ?_
  have h3 := congrArg (fun y : N.obj.obj (Opposite.op U) =>
    ((smallEtaleRingedToposHom B S hS f).toToposHom.adj.unit.app
      ((sheafCompose (SmallEtale.topology B S hS Y.1) (forget CommRingCat.{u})).obj N)).hom.app
        (Opposite.op U) y) hb
  refine (congrArg ((directImageChartProjection B S hS f U
    (chartArrowOfMap B S hS f W U p hp)).app _) h3).trans ?_
  exact map_zero (chartInverseImageSectionHom B S hS f U (chartArrowOfMap B S hS f W U p hp)
    (Stacks.SheafOfModules.Tensor.ringSheaf N)).hom

/-- The structure map of `f̃' = (id, f^♯)` is the inverse-image form of the structure map of `f`
on sections: the identification of the inverse image along the identity is the identity on
underlying sets. -/
theorem relBaseRight_fSharp_app (V : (SmallEtale B S hS X.1)ᵒᵖ)
    (y : (Deformation.ToposThickening.inverseImageBaseRing
      (smallEtaleRingedToposHom B S hS f)).obj.obj V) :
    (Deformation.ToposThickening.relBaseRight (smallEtaleRingedToposHom B S hS f)).fSharp.hom.app
        V y =
      (smallEtaleRingedToposHom B S hS f).fSharpInverseImage.hom.app V y := by
  have hid :=
    Stacks.Sheaves.ToposPullback.forget_map_pullbackCommRingSheafFunctorId_hom_app.{u, u, u + 1}
    (SmallEtale.topology B S hS X.1) (smallEtaleRingedTopos B S hS X).O
  have hz : ∀ z, ((pullbackCommRingSheafFunctorId.{u, u, u + 1}
      (SmallEtale.topology B S hS X.1)).hom.app
      (smallEtaleRingedTopos B S hS X).O).hom.app V z = z := fun z =>
    congrArg (fun m => m.hom.app V z) hid
  exact (hz _).symm.trans (Deformation.ToposThickening.Sheaf.commRingIso_hom_inv_app_apply
    ((pullbackCommRingSheafFunctorId.{u, u, u + 1} (SmallEtale.topology B S hS X.1)).app
      (smallEtaleRingedTopos B S hS X).O) V _)

/-- **A regular function on a chart of the target killed by the structure map of a thickening
`t` of the target gives, on a chart of the source lying over it, a section of `f⁻¹𝒪_Y` killed by
the reduction `f⁻¹t^♯` whose image under `f̃'^♯` is the pullback of the function.** -/
theorem exists_inverseImageBaseReduction_eq_zero {S₀ : RingedTopos.{u, u + 1, u}}
    [S₀.J.HasSheafCompose (forget RingCat.{u})]
    [S₀.J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
    (t : RingedToposHom S₀ (smallEtaleRingedTopos B S hS Y)) (W : SmallEtale B S hS X.1)
    (U : SmallEtale B S hS Y.1) (p : W.1.left ⟶ U.1.left)
    (hp : W.1.hom ≫ f.hom = yoneda.map p ≫ U.1.hom)
    (b : (smallEtaleRingedTopos B S hS Y).O.obj.obj (Opposite.op U))
    (hb : t.fSharp.hom.app (Opposite.op U) b = 0) :
    ∃ s : (Deformation.ToposThickening.inverseImageBaseRing
        (smallEtaleRingedToposHom B S hS f)).obj.obj (Opposite.op W),
      (Deformation.ToposThickening.inverseImageBaseReduction t
        (smallEtaleRingedToposHom B S hS f)).hom.app (Opposite.op W) s = 0 ∧
      (Deformation.ToposThickening.relBaseRight (smallEtaleRingedToposHom B S hS f)).fSharp.hom.app
        (Opposite.op W) s = (Scheme.Γ.map ((BigFppfOver.toScheme B S hS).map p).op).hom b :=
  ⟨_, inverseImage_map_chartPullbackInverseImageSection_eq_zero B S hS f W U p hp t.fSharp b hb,
    (relBaseRight_fSharp_app B S hS f _ _).trans
      (fSharpInverseImage_chartPullbackInverseImageSection B S hS f W U p hp b)⟩

end ChartSection

section ChartsOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Affine charts of the source lying over affine charts of the target, around every point.**
Every point of an étale chart `V` of `X` lies in the image of an affine étale chart `W ⟶ V` of `X`
which maps, over `f`, to an affine étale chart `U` of `Y`. -/
theorem exists_affine_chart_over (Y X : AlgebraicSpaces B S hS) (f : X ⟶ Y)
    (V : SmallEtale B S hS X.1)
    (z : (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj V)) :
    ∃ (W : SmallEtale B S hS X.1) (g : W ⟶ V) (U : SmallEtale B S hS Y.1)
      (p : W.1.left ⟶ U.1.left),
      IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) ∧
      IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left) ∧
      yoneda.map p ≫ U.1.hom = W.1.hom ≫ f.hom ∧
      ∃ z' : (BigFppfOver.toScheme B S hS).obj ((SmallEtale.toOver B S hS X.1).obj W),
        (BigFppfOver.toScheme B S hS).map ((SmallEtale.toOver B S hS X.1).map g) z' = z := by
  obtain ⟨A₀, g₀, hg₀S, hg₀E⟩ := Y.2.exists_atlas
  obtain ⟨V₁, π₁, q₁, hq₁, z₁, hz₁⟩ := exists_chart_over B S hS f V
    ⟨CostructuredArrow.mk g₀, hg₀E⟩ hg₀S z
  obtain ⟨U'', ι', hU''aff, y'', hy''⟩ := exists_affine_chart_at B S hS _
    ⟨CostructuredArrow.mk g₀, hg₀E⟩ (((BigFppfOver.toScheme B S hS).map q₁) z₁)
  obtain ⟨T₂, π₂, p₂, hp₂, -, w₂, hw₂, -⟩ := exists_chart_pullback B S hS f V₁
    q₁ hq₁ ι' z₁ y'' hy''.symm
  obtain ⟨T₃, π₃, hT₃aff, w₃, hw₃⟩ := exists_affine_chart_at B S hS _ T₂ w₂
  refine ⟨T₃, π₃ ≫ π₂ ≫ π₁, U'', (SmallEtale.toOver B S hS X.1).map π₃ ≫ p₂, hT₃aff, hU''aff,
    ?_, w₃, ?_⟩
  · rw [Functor.map_comp, Category.assoc, hp₂, ← Category.assoc]
    exact congrArg (fun φ => φ ≫ f.hom) (CostructuredArrow.w (π₃.hom))
  · rw [Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply,
      Functor.map_comp, Functor.map_comp, Scheme.Hom.comp_apply, hw₃, hw₂, hz₁]

/-- **A sieve containing every affine chart lying over an affine chart of the target is a
covering sieve** of the small étale site. -/
theorem sieve_mem_of_affine_chart_over (Y X : AlgebraicSpaces B S hS) (f : X ⟶ Y)
    (V : (smallEtaleRingedTopos B S hS X).C) (R : Sieve V)
    (hR : ∀ (W : (smallEtaleRingedTopos B S hS X).C) (g : W ⟶ V) (U : SmallEtale B S hS Y.1)
      (p : W.1.left ⟶ U.1.left),
      IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left) →
      IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left) →
      yoneda.map p ≫ U.1.hom = W.1.hom ≫ f.hom → R g) :
    R ∈ (smallEtaleRingedTopos B S hS X).J V := by
  refine smallEtale_sieve_of_pointwise_covering B S hS X.1 V R (fun z => ?_)
  obtain ⟨W, g, U, p, hW, hU, hp, z', hz'⟩ := exists_affine_chart_over B S hS Y X f V z
  exact ⟨W, g, hR W g U p hW hU hp, z', hz'⟩

end ChartsOver


end AlgebraicGeometry.Space

namespace AlgebraicGeometry.Space.QuotientSituation

open Deformation.ToposThickening

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  (D : QuotientSituation B S hS) {T T' : SchemesOver D.Y} (h : T ⟶ T')
  (hh : Stacks.Thickenings.IsFirstOrderThickening ((BigFppfOver.toScheme B S hS).map h.left))

include hh in
/-- `X_T ⟶ X_{T'}` is a thickening of algebraic spaces. -/
theorem isThickeningHom_relativeMap : IsThickeningHom B S hS (D.relativeMap h) :=
  have := D.mono_relativeMap h hh
  ⟨inferInstance, (D.isFirstOrderThickening_range_relativeMap h hh).1⟩

include hh in
/-- `T ⟶ T'` is a thickening of algebraic spaces. -/
theorem isThickeningHom_testScheme :
    IsThickeningHom B S hS ((schemeSpaceFunctor B S hS).map h.left) :=
  have : Mono ((schemeSpaceFunctor B S hS).map h.left).hom :=
    mono_yoneda_map_of_isClosedImmersion h.left hh.1
  ⟨inferInstance, (isFirstOrderThickening_range_yoneda_map B S hS h.left hh).1⟩

/-- **On an affine chart of `X_{T'}` lying over an affine chart of `T'`, the ideal of `X_T` is
generated by the images under `f̃'^♯` of the sections of `f'⁻¹𝒪_{T'}` killed by the reduction**:
it is the extension of the ideal of `T` in `T'` (Stacks 09ZX, read on charts), and every pullback
of a function in that ideal is such an image. -/
theorem mem_span_of_mem_definingIdealAt_relativeMap (W : SmallEtale B S hS (D.space T').1)
    (U : SmallEtale B S hS ((schemeSpaceFunctor B S hS).obj T'.left).1) (p : W.1.left ⟶ U.1.left)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    (hp : yoneda.map p ≫ U.1.hom = W.1.hom ≫ (D.projection T').hom)
    (y : (smallEtaleRingedTopos B S hS (D.space T')).O.obj.obj (Opposite.op W))
    (hy : y ∈ definingIdealAt B S hS (D.space T')
      ⟨Subfunctor.range (D.relativeMap h).hom, (D.isThickeningHom_relativeMap h hh).2.1⟩
        (Opposite.op W)) :
    y ∈ Ideal.span {y' : (smallEtaleRingedTopos B S hS (D.space T')).O.obj.obj (Opposite.op W) |
      ∃ s : (inverseImageBaseRing (smallEtaleRingedToposHom B S hS (D.projection T'))).obj.obj
          (Opposite.op W),
        (inverseImageBaseReduction
          (smallEtaleRingedToposHom B S hS ((schemeSpaceFunctor B S hS).map h.left))
          (smallEtaleRingedToposHom B S hS (D.projection T'))).hom.app (Opposite.op W) s = 0 ∧
        (relBaseRight (smallEtaleRingedToposHom B S hS (D.projection T'))).fSharp.hom.app
          (Opposite.op W) s = y'} := by
  have hi := D.isThickeningHom_relativeMap h hh
  have ht := D.isThickeningHom_testScheme h hh
  have hZ : (⟨Subfunctor.range (D.relativeMap h).hom, hi.2.1⟩ :
      ClosedSubspaces B S hS (D.space T').1) =
      ⟨(Subfunctor.range ((schemeSpaceFunctor B S hS).map h.left).hom).preimage
        (D.projection T').hom, isClosedSubspace_preimage B S hS (D.projection T').hom
          (Subfunctor.range ((schemeSpaceFunctor B S hS).map h.left).hom)
          ((schemeSpaceFunctor B S hS).obj T'.left).2 (D.space T').2 ht.2.1⟩ :=
    Subtype.ext (D.range_relativeMap h)
  have ht2 : IsThickening B S hS ((schemeSpaceFunctor B S hS).obj T'.left)
      (Subfunctor.range ((schemeSpaceFunctor B S hS).map h.left).hom) := ht.2
  rw [hZ, definingIdealAt_preimage_eq_map B S hS (D.projection T')
    ⟨Subfunctor.range ((schemeSpaceFunctor B S hS).map h.left).hom, ht2.1⟩ U W p hp] at hy
  refine (Ideal.map_le_iff_le_comap.mpr ?_) hy
  intro j hj
  exact Ideal.subset_span (exists_inverseImageBaseReduction_eq_zero B S hS (D.projection T')
    (smallEtaleRingedToposHom B S hS ((schemeSpaceFunctor B S hS).map h.left)) W U p hp.symm j
    ((fSharp_eq_zero_iff_mem_definingIdealAt B S hS _ ht (Opposite.op U) j).2 hj))

include hh in
/-- **A local section of `𝒪_{X_{T'}}` killed by `𝒪_{X_{T'}} ⟶ 𝒪_{X_T}` lies, on every affine
chart over an affine chart of `T'`, in the ideal generated by the images under `f̃'^♯` of the
sections of `f'⁻¹𝒪_{T'}` killed by the reduction.** -/
theorem mem_span_of_fSharp_eq_zero_relativeMap
    (V : (smallEtaleRingedTopos B S hS (D.space T')).Cᵒᵖ)
    (x : (smallEtaleRingedTopos B S hS (D.space T')).O.obj.obj V)
    (hx : (smallEtaleRingedToposHom B S hS (D.relativeMap h)).fSharp.hom.app V x = 0)
    (W : (smallEtaleRingedTopos B S hS (D.space T')).C) (g : W ⟶ V.unop)
    (U : SmallEtale B S hS ((schemeSpaceFunctor B S hS).obj T'.left).1) (p : W.1.left ⟶ U.1.left)
    [IsAffine ((BigFppfOver.toScheme B S hS).obj W.1.left)]
    [IsAffine ((BigFppfOver.toScheme B S hS).obj U.1.left)]
    (hp : yoneda.map p ≫ U.1.hom = W.1.hom ≫ (D.projection T').hom) :
    (smallEtaleRingedTopos B S hS (D.space T')).O.obj.map g.op x ∈
      Ideal.span {y' : (smallEtaleRingedTopos B S hS (D.space T')).O.obj.obj (Opposite.op W) |
      ∃ s : (inverseImageBaseRing (smallEtaleRingedToposHom B S hS (D.projection T'))).obj.obj
          (Opposite.op W),
        (inverseImageBaseReduction
          (smallEtaleRingedToposHom B S hS ((schemeSpaceFunctor B S hS).map h.left))
          (smallEtaleRingedToposHom B S hS (D.projection T'))).hom.app (Opposite.op W) s = 0 ∧
        (relBaseRight (smallEtaleRingedToposHom B S hS (D.projection T'))).fSharp.hom.app
          (Opposite.op W) s = y'} :=
  D.mem_span_of_mem_definingIdealAt_relativeMap h hh W U p hp _
    (definingIdealAt_map B S hS (D.space T') _ g.op x
      ((fSharp_eq_zero_iff_mem_definingIdealAt B S hS (D.relativeMap h)
        (D.isThickeningHom_relativeMap h hh) V x).1 hx))

include hh in
/-- **The local sections of `𝒪_{X_{T'}}` killed by `𝒪_{X_{T'}} ⟶ 𝒪_{X_T}` come, locally, from the
map of ideals of the relative square.** -/
theorem relBaseImageSieve_mem_relativeMap
    (V : (smallEtaleRingedTopos B S hS (D.space T')).Cᵒᵖ)
    (x : (smallEtaleRingedTopos B S hS (D.space T')).O.obj.obj V)
    (hx : (smallEtaleRingedToposHom B S hS (D.relativeMap h)).fSharp.hom.app V x = 0) :
    relBaseImageSieve.{u, u + 1, u, u, u + 1, u, u + 1, u, u + 1}
      (i := smallEtaleRingedToposHom B S hS (D.relativeMap h))
      (t := smallEtaleRingedToposHom B S hS ((schemeSpaceFunctor B S hS).map h.left))
      (f' := smallEtaleRingedToposHom B S hS (D.projection T'))
      (p := smallEtaleRingedToposHom B S hS (D.projection T)) (θ := D.relativeSquareIso h)
      (D.relativeMapFirstOrderThickening h hh) (D.testSchemeFirstOrderThickening h hh)
      (D.relativeSquare_comm h) V x ∈ (smallEtaleRingedTopos B S hS (D.space T')).J V.unop :=
  sieve_mem_of_affine_chart_over B S hS _ _ (D.projection T') V.unop _
    (fun W g U p _ _ hp =>
      relBaseImageSieve_of_mem_span.{u, u + 1, u, u, u + 1, u, u + 1, u, u + 1}
        (D.relativeMapFirstOrderThickening h hh) (D.testSchemeFirstOrderThickening h hh)
        (D.relativeSquare_comm h) V x g
        (D.mem_span_of_fSharp_eq_zero_relativeMap h hh V x hx W g U p hp))

/-- **The relative square of Remark 0CZU is strict** (Stacks 08M9), in the form
`Deformation.ToposThickening.RelBaseIsStrict`: the ideal of `X_T` in `X_{T'}` is generated by the
inverse image of the ideal of `T` in `T'`. -/
theorem relBaseIsStrict_relativeSquare :
    RelBaseIsStrict.{u, u + 1, u, u, u + 1, u, u + 1, u, u + 1}
      (i := smallEtaleRingedToposHom B S hS (D.relativeMap h))
      (t := smallEtaleRingedToposHom B S hS ((schemeSpaceFunctor B S hS).map h.left))
      (f' := smallEtaleRingedToposHom B S hS (D.projection T'))
      (p := smallEtaleRingedToposHom B S hS (D.projection T)) (θ := D.relativeSquareIso h)
      (D.relativeMapFirstOrderThickening h hh) (D.testSchemeFirstOrderThickening h hh)
      (D.relativeSquare_comm h) :=
  isStrict_relBase_of_imageSieve_mem.{u, u + 1, u, u, u + 1, u, u + 1, u, u + 1}
    (D.relativeMapFirstOrderThickening h hh)
    (D.testSchemeFirstOrderThickening h hh) (D.relativeSquare_comm h)
    (D.relBaseImageSieve_mem_relativeMap h hh)

/-- **Remark 0CZU: the ideal `I` of `X_T ⊂ X_{T'}` is a quotient of `f_T^*𝒥`.** The relative
square is strict (Stacks 08M9): the map of ideals `f̃'^*(f'⁻¹𝒥) ⟶ I` of the morphism of
thickenings of Stacks 08M7, built from the first order thickenings `X_T ⊂ X_{T'}` and
`t̃ = (id, f'⁻¹t^♯)` and the commutative square `f̃' ∘ i = t̃ ∘ f̃`, is an epimorphism. -/
@[stacks 0CZU]
theorem isStrict_relativeSquare :
    MorphismOfThickenings.IsStrict.{u, u + 1, u, u, u + 1, u, u, u + 1, u, u, u + 1, u}
      (MorphismOfThickenings.ofFirstOrderThickenings.{u, u + 1, u, u, u + 1, u, u + 1, u, u,
          u + 1, u}
        (smallEtaleRingedToposHom B S hS (D.relativeMap h)) (D.relativeSquareThickening h)
        (D.relativeSquareLeft h) (relBaseRight (smallEtaleRingedToposHom B S hS (D.projection T')))
        (D.relativeMapFirstOrderThickening h hh)
        (D.relativeSquareThickeningFirstOrderThickening h hh) (D.relativeSquare_comm h)) :=
  D.relBaseIsStrict_relativeSquare h hh

end AlgebraicGeometry.Space.QuotientSituation
