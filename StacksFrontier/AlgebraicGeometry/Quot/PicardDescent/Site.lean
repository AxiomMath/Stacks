module

public import Mathlib.CategoryTheory.Sites.Descent.Precoverage
public import StacksFrontier.AlgebraicGeometry.Descent.Parasitic.FlatVanishing
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.FibreProducts

/-!
# The topology of the big fppf site over `S` as the topology of a precoverage

The topology `AlgebraicGeometry.BigFppfOver.topology` of the big fppf site over a scheme `S` is
the localisation at `S` of the topology generated by the site's selected covering families.  It
is also the topology generated by the fppf precoverage of schemes pulled back along the functor
`AlgebraicGeometry.BigFppfOver.toScheme` to all schemes, and that precoverage contains the
isomorphisms and is stable under base change and composition.  These are the hypotheses of
`CategoryTheory.Pseudofunctor.IsStack.of_precoverage`, which reduces the stack condition for a
pseudofunctor on the site to the covering families of the precoverage.

## Main definitions

* `AlgebraicGeometry.BigFppfOver.fppfComap`: the fppf precoverage pulled back to the site.

## Main results

* `AlgebraicGeometry.BigFppfOver.topology_eq_fppfComap_toGrothendieck`: the identification of the
  two topologies.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The fppf precoverage of schemes, pulled back to the big fppf site over `S` along the functor
to all schemes: a family of the site covers when its family of underlying morphisms of schemes
is an fppf covering. -/
abbrev fppfComap : Precoverage (BigFppfOver B S hS) :=
  Scheme.fppfPrecoverage.comap (toScheme B S hS)

/-- The fppf precoverage of schemes contains the isomorphisms. -/
instance fppfPrecoverage_hasIsos : Scheme.fppfPrecoverage.{u}.HasIsos where
  mem_coverings_of_isIso f _ :=
    Scheme.zariskiPrecoverage_le_fppfPrecoverage _ (Precoverage.mem_coverings_of_isIso f)

/-- The inclusion of a big fppf site into all schemes creates fibre products: it is fully
faithful and preserves them. -/
@[instance_reducible]
noncomputable def inclusionCreatesPullbacks :
    CreatesLimitsOfShape WalkingCospan B.inclusion :=
  ⟨fun {_} => createsLimitOfFullyFaithfulOfPreserves⟩

/-- The precoverage `fppfComap B S hS` contains the isomorphisms. -/
instance fppfComap_hasIsos : (fppfComap B S hS).HasIsos := inferInstance

/-- The precoverage `fppfComap B S hS` is stable under base change. -/
instance fppfComap_isStableUnderBaseChange : (fppfComap B S hS).IsStableUnderBaseChange :=
  inferInstance

/-- The precoverage `fppfComap B S hS` is stable under composition. -/
instance fppfComap_isStableUnderComposition : (fppfComap B S hS).IsStableUnderComposition :=
  inferInstance

/-- **The topology of the big fppf site over `S` is generated by the fppf precoverage** pulled
back along the functor to all schemes. -/
theorem topology_eq_fppfComap_toGrothendieck :
    topology B S hS = (fppfComap B S hS).toGrothendieck := by
  let : CreatesLimitsOfShape WalkingCospan B.inclusion := inclusionCreatesPullbacks B
  let : B.precoverage.IsStableUnderBaseChange := by
    rw [AlgebraicGeometry.bigFppf_precoverage_eq]
    infer_instance
  rw [topology, BigFppfSite.topology, over_toGrothendieck_eq_toGrothendieck_comap_forget,
    AlgebraicGeometry.bigFppf_precoverage_eq, ← Precoverage.comap_comp]

end AlgebraicGeometry.BigFppfOver

end
