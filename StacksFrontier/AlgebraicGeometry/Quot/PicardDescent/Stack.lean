variable (s)

/-- **The pullback pseudofunctor of `Picardstack_{X/B}` is a stack for the big fppf topology.**
The topology is generated by the fppf precoverage pulled back from all schemes, which has
isomorphisms and is stable under base change and composition, so it suffices to see that the
functor to descent data relative to an fppf covering family is an equivalence: it is faithful,
full and essentially surjective by the three statements above, the family being an fpqc
covering of the represented algebraic spaces. -/
theorem picardBasedCategory_pullbackPseudofunctor_isStack :
    (Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).IsStack
        (BigFppfOver.topology B S hS) := by
  rw [BigFppfOver.topology_eq_fppfComap_toGrothendieck]
  refine Pseudofunctor.IsStack.of_precoverage fun U R hR => ?_
  obtain ⟨ι, Y, f, rfl⟩ := Presieve.exists_eq_ofArrows R
  rw [Pseudofunctor.isStackFor_ofArrows_iff]
  have hfppf : Presieve.ofArrows (fun i => (BigFppfOver.toScheme B S hS).obj (Y i))
      (fun i => (BigFppfOver.toScheme B S hS).map (f i)) ∈
        Scheme.fppfPrecoverage ((BigFppfOver.toScheme B S hS).obj U) := by
    rwa [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hR
  have hf := represented_fpqc_family B S hS ι Y f
    (Scheme.fppfPrecoverage_le_fpqcPrecoverage _ hfppf)
  have hf' : Sieve.ofArrows Y f ∈ BigFppfOver.topology B S hS U := by
    rw [BigFppfOver.topology_eq_fppfComap_toGrothendieck]
    exact Precoverage.generate_mem_toGrothendieck hR
  have : ((Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).Faithful :=
    ⟨fun h => toDescentData_map_injective_picard f hf h⟩
  have : ((Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).Full :=
    ⟨fun Ψ => toDescentData_map_surjective_picard f hf hf' Ψ⟩
  have : ((Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).EssSurj :=
    ⟨fun D => exists_iso_toDescentData_picard f hf hf' D⟩
  exact { }

/-- **`Picardstack_{X/B}` is a stack over the big fppf site of `S`** in the sense of Stacks 026F:
it is fibred, its presheaves of morphisms are sheaves, and descent data are effective. -/
theorem picardBasedCategory_isStack :
    (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsStack
      (BigFppfOver.topology B S hS) :=
  (Functor.isStack_pullbackPseudofunctor_iff _ _).1
    (picardBasedCategory_pullbackPseudofunctor_isStack s)

