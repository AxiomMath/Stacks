/-!
# Descent in `Picardstack_{X/B}`

Let `p : Picardstack_{X/B} ⟶ (Sch/S)_fppf` be the projection of Section 0372, for the category
built from the pseudofunctoriality of the direct images of Stacks 03LU.  This file proves that the
pullback pseudofunctor of `p` is a stack for the big fppf topology of `S`, which is the content
of Stacks 04WN beyond condition (1) of Stacks 02ZI.

The topology is generated by the fppf precoverage of schemes pulled back to the site, so it is
enough to show that, for an fppf covering family `{f i : U i ⟶ U}`, the functor from the fibre
over `U` to the descent data of the family is an equivalence.  The argument is the source's:

* *faithfulness*: two morphisms over `U` agreeing over each `U i` have the same base map, and
  their comparisons of modules agree after inverse image along the fpqc covering
  `{X_{U_i} ⟶ X_U}`, hence agree (the injectivity half of Stacks 04W8);
* *fullness*: the structure morphisms to the base agree because they agree over each `U i` and the
  base is a sheaf, and the comparisons of modules glue along `{X_{U_i} ⟶ X_U}` (Stacks 04W8);
* *effectivity*: the structure morphisms of the members glue to a morphism `U ⟶ B`, the invertible
  modules of the members glue along `{X_{U_i} ⟶ X_U}` to a module which is invertible because its
  inverse images are, and the morphisms from the members to the glued object are cartesian, `p`
  being fibred in groupoids.

## Main results

* `AlgebraicGeometry.Space.toDescentData_map_injective_picard`,
  `AlgebraicGeometry.Space.toDescentData_map_surjective_picard` and
  `AlgebraicGeometry.Space.exists_iso_toDescentData_picard`: the functor to descent data relative
  to a covering family is faithful, full and essentially surjective.
* `AlgebraicGeometry.Space.picardBasedCategory_pullbackPseudofunctor_isStack` and
  `AlgebraicGeometry.Space.picardBasedCategory_isStack`: `Picardstack_{X/B}` is a stack over the
  big fppf site of `S`.

## Implementation notes

The objects of the fibred category are spelled `(picardBasedCategory _ s).obj`, which is
`AlgebraicGeometry.Space.PicardObject s` only after unfolding; the statements about base maps
are therefore made for `AlgebraicGeometry.Space.PicardObject` and
`AlgebraicGeometry.Space.PicardHom` (for instance
`AlgebraicGeometry.Space.schemeSpaceFunctor_map_comp_hom_of_base_left_eq`), and are applied to
morphisms of the fibred category through `AlgebraicGeometry.Space.picardHom_base_left_eq`, which
reads the base map of a morphism lying over a morphism of the site.

## References

* [Stacks Project, Tag 04WN](https://stacks.math.columbia.edu/tag/04WN)
* [Stacks Project, Tag 04W8](https://stacks.math.columbia.edu/tag/04W8)
* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v u

namespace CategoryTheory.Pseudofunctor.DescentData

variable {𝒮 : Type*} [Category* 𝒮] {𝒳 : Type*} [Category* 𝒳] {p : 𝒳 ⥤ 𝒮} [p.IsFibered]
  {U : 𝒮} {ι : Type*} {X : ι → 𝒮} {f : ∀ i, X i ⟶ U}

/-- The gluing morphism of a descent datum followed by the chosen cartesian lift does not depend
on the name of the second morphism. -/
theorem homF_pullbackLift_congr (D : (Functor.IsFibered.pullbackPseudofunctor p).DescentData f)
    {T : 𝒮} (q : T ⟶ U) {i₁ i₂ : ι} (f₁ : T ⟶ X i₁) {g g' : T ⟶ X i₂} (e : g = g')
    (h₁ : f₁ ≫ f i₁ = q) (hg : g ≫ f i₂ = q) (hg' : g' ≫ f i₂ = q) :
    Functor.Fiber.fiberInclusion.map (D.homF q f₁ g h₁ hg) ≫
        Functor.pullbackLift (D.objF i₂) g =
      Functor.Fiber.fiberInclusion.map (D.homF q f₁ g' h₁ hg') ≫
        Functor.pullbackLift (D.objF i₂) g' := by
  subst e
  rfl

end CategoryTheory.Pseudofunctor.DescentData

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- A square conjugated by equalities of its objects is cartesian when the square is. -/
theorem isPullback_of_eq_eqToHom {C : Type*} [Category* C] {P X Y Z P' X' Y' Z' : C}
    {a : P ⟶ X} {b : P ⟶ Y} {c : X ⟶ Z} {d : Y ⟶ Z} (h : IsPullback a b c d)
    (eP : P' = P) (eX : X' = X) (eY : Y' = Y) (eZ : Z' = Z)
    {a' : P' ⟶ X'} {b' : P' ⟶ Y'} {c' : X' ⟶ Z'} {d' : Y' ⟶ Z'}
    (ha : a' = eqToHom eP ≫ a ≫ eqToHom eX.symm) (hb : b' = eqToHom eP ≫ b ≫ eqToHom eY.symm)
    (hc : c' = eqToHom eX ≫ c ≫ eqToHom eZ.symm) (hd : d' = eqToHom eY ≫ d ≫ eqToHom eZ.symm) :
    IsPullback a' b' c' d' := by
  subst eP eX eY eZ
  simp only [eqToHom_refl, Category.id_comp, Category.comp_id] at ha hb hc hd
  subst ha hb hc hd
  exact h

/-- A family of morphisms of the site represented by an fpqc covering stays one after
conjugation by equalities of objects. -/
theorem isFpqcCovering_yoneda_map_eqToHom {I : Type v} {U U' : BigFppfOver B S hS}
    {Y Y' : I → BigFppfOver B S hS} (eY : ∀ i, Y' i = Y i) (e : U = U') (f : ∀ i, Y i ⟶ U)
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i)) :
    IsFpqcCovering B S hS fun i => yoneda.map (eqToHom (eY i) ≫ f i ≫ eqToHom e) := by
  subst e
  have h := isFpqcCovering_isoComp B S hS (fun i => yoneda.map (eqToHom (eY i))) _ hf
  simpa only [eqToHom_refl, Category.comp_id, CategoryTheory.Functor.map_comp] using h

namespace PicardHom

variable {s : PicardSituation B S hS}

/-- The comparison of two equal morphisms is the transport along the equality of their base
maps. -/
theorem theta_eq_eqToIso_of_eq {P C : PicardObject s} {x y : PicardHom P C} (h : x = y) :
    theta x y = eqToIso (congrArg (fun k : P.T ⟶ C.T =>
      (modulePullback B S hS (baseChangeMap s.f k)).obj C.lineBundle)
        (congrArg PicardHom.base h)) := by
  subst h
  rw [theta_self, eqToIso_refl]

/-- **Morphisms of `Picardstack_{X/B}` over the same base map are equal as soon as they agree
after composition with morphisms whose base changes form an fpqc covering.**  This is the
injectivity half of Stacks 04W8 applied to the comparisons of modules. -/
theorem eq_of_comp_eq_of_isFpqcCovering {I : Type v} {P : I → PicardObject s}
    {C C' : PicardObject s} (r : ∀ i, PicardHom (P i) C)
    (hcov : IsFpqcCovering B S hS fun i => (baseChangeMap s.f (r i).base).hom)
    {m n : PicardHom C C'} (hb : m.base = n.base) (h : ∀ i, (r i).comp m = (r i).comp n) :
    m = n := by
  obtain ⟨mb, mf, mi⟩ := m
  obtain ⟨nb, nf, ni⟩ := n
  obtain rfl : mb = nb := hb
  have key : mf ≫ inv nf = 𝟙 _ := by
    refine QuasiCoherentDescent.modulePullback_map_injective_of_isFpqcCovering B S hS
      (QuasiCoherentDescent.reprFpqcHomInjective.{u, v} B S hS) _ _ hcov _ _ fun i => ?_
    have e1 := theta_eq_eqToIso_of_eq (h i)
    rw [theta_comp] at e1
    have e2 : QuasiCoherentDescent.readIso (baseChangeMap s.f (r i).base)
        (baseChangeMap_comp_base (r i) ⟨mb, mf, mi⟩) (baseChangeMap_comp_base (r i) ⟨mb, nf, ni⟩)
        (Iso.refl ((modulePullback B S hS (baseChangeMap s.f mb)).obj C'.lineBundle)) =
          eqToIso (congrArg (fun k : (P i).T ⟶ C'.T =>
            (modulePullback B S hS (baseChangeMap s.f k)).obj C'.lineBundle)
              (congrArg PicardHom.base (h i))) := by
      simp only [QuasiCoherentDescent.readIso, Functor.mapIso_refl, Iso.refl_trans]
      exact QuasiCoherentDescent.pullbackComparison_trans_symm _ _ _ _ _ _ _
    have hmap : (modulePullback B S hS (baseChangeMap s.f (r i).base)).mapIso
        (theta ⟨mb, mf, mi⟩ ⟨mb, nf, ni⟩) =
        (modulePullback B S hS (baseChangeMap s.f (r i).base)).mapIso (Iso.refl _) := by
      have h' := congrArg (fun e => (QuasiCoherentDescent.pullbackComparison B S hS
          (baseChangeMap s.f (r i).base) (baseChangeMap s.f mb) _
          (baseChangeMap_comp_base (r i) ⟨mb, mf, mi⟩) C'.lineBundle).symm ≪≫ e ≪≫
        QuasiCoherentDescent.pullbackComparison B S hS (baseChangeMap s.f (r i).base)
          (baseChangeMap s.f mb) _ (baseChangeMap_comp_base (r i) ⟨mb, nf, ni⟩)
          C'.lineBundle) (e1.trans e2.symm)
      simpa only [QuasiCoherentDescent.readIso, Iso.trans_assoc, Iso.symm_self_id_assoc,
        Iso.symm_self_id, Iso.trans_refl] using h'
    simpa only [theta, Functor.mapIso_hom, Iso.trans_hom, asIso_hom, Iso.symm_hom, asIso_inv,
      Iso.refl_hom] using congrArg Iso.hom hmap
  obtain rfl : mf = nf := (comp_inv_eq_id nf).1 key
  rfl

end PicardHom

variable (s : PicardSituation B S hS)

/-- `Picardstack_{X/B}` is a fibred category over the big fppf site of `S`. -/
instance picardBasedCategory_isFibered :
    (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsFibered :=
  Functor.IsFiberedInGroupoids.isFibered
    (picardBasedCategory_isFiberedInGroupoids (modulePushforwardCoherence B S hS) s)

variable {s}

/-- The morphism of test schemes underlying a morphism of `Picardstack_{X/B}` lying over a
morphism of the site is that morphism, up to the identifications of the objects. -/
theorem picardHom_base_left_eq {R T : BigFppfOver B S hS}
    {a b : (picardBasedCategory (modulePushforwardCoherence B S hS) s).obj} (g : R ⟶ T)
    (φ : a ⟶ b) [(picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsHomLift g φ] :
    (φ : PicardHom a b).base.left =
      eqToHom (IsHomLift.domain_eq (picardBasedCategory (modulePushforwardCoherence B S hS) s).p
          g φ) ≫ g ≫
        eqToHom (IsHomLift.codomain_eq
          (picardBasedCategory (modulePushforwardCoherence B S hS) s).p g φ).symm :=
  IsHomLift.fac' (picardBasedCategory (modulePushforwardCoherence B S hS) s).p g φ

/-- The structure morphisms to the base of the source and target of a morphism of
`Picardstack_{X/B}` lying over a morphism `g` of the site, read on the schemes of the site, are
intertwined by `g`. -/
theorem schemeSpaceFunctor_map_comp_hom_of_base_left_eq {a b : PicardObject s}
    (m : PicardHom a b) {R T : BigFppfOver B S hS} (g : R ⟶ T) (d : a.T.left = R)
    (c : b.T.left = T) (hm : m.base.left = eqToHom d ≫ g ≫ eqToHom c.symm) :
    (schemeSpaceFunctor B S hS).map g ≫ (schemeSpaceFunctor B S hS).map (eqToHom c.symm) ≫
        b.T.hom =
      (schemeSpaceFunctor B S hS).map (eqToHom d.symm) ≫ a.T.hom := by
  have w := CostructuredArrow.w m.base
  rw [hm] at w
  rw [← w, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp]
  simp only [eqToHom_map, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]

/-- Two morphisms of `Picardstack_{X/B}` with a common source, lying over morphisms `g₁`, `g₂` of
the site out of the same scheme, give equal composites of `g₁`, `g₂` with the structure morphisms
of their targets. -/
private theorem schemeSpaceFunctor_map_comp_eq_of_base_left_eq {a b₁ b₂ : PicardObject s}
    (m₁ : PicardHom a b₁) (m₂ : PicardHom a b₂) {R T₁ T₂ : BigFppfOver B S hS} (g₁ : R ⟶ T₁)
    (g₂ : R ⟶ T₂) (d : a.T.left = R) (c₁ : b₁.T.left = T₁) (c₂ : b₂.T.left = T₂)
    (h₁ : m₁.base.left = eqToHom d ≫ g₁ ≫ eqToHom c₁.symm)
    (h₂ : m₂.base.left = eqToHom d ≫ g₂ ≫ eqToHom c₂.symm) :
    (schemeSpaceFunctor B S hS).map g₁ ≫ (schemeSpaceFunctor B S hS).map (eqToHom c₁.symm) ≫
        b₁.T.hom =
      (schemeSpaceFunctor B S hS).map g₂ ≫ (schemeSpaceFunctor B S hS).map (eqToHom c₂.symm) ≫
        b₂.T.hom :=
  (schemeSpaceFunctor_map_comp_hom_of_base_left_eq m₁ g₁ d c₁ h₁).trans
    (schemeSpaceFunctor_map_comp_hom_of_base_left_eq m₂ g₂ d c₂ h₂).symm

/-- The base changes of morphisms of test schemes lying over the members of a family of
morphisms of the site which represents an fpqc covering form an fpqc covering. -/
theorem isFpqcCovering_baseChangeMap_of_left_eq {I : Type v} {U : BigFppfOver B S hS}
    {Y : I → BigFppfOver B S hS} (f : ∀ i, Y i ⟶ U)
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i)) {a : I → s.SchemesOver}
    {b : s.SchemesOver} (m : ∀ i, a i ⟶ b) (eY : ∀ i, (a i).left = Y i) (hb : b.left = U)
    (hm : ∀ i, (m i).left = eqToHom (eY i) ≫ f i ≫ eqToHom hb.symm) :
    IsFpqcCovering B S hS fun i => (baseChangeMap s.f (m i)).hom := by
  refine isFpqcCovering_baseChangeMap s.f m ?_
  have e : (fun i => ((schemeSpaceFunctor B S hS).map (m i).left).hom) =
      fun i => yoneda.map (eqToHom (eY i) ≫ f i ≫ eqToHom hb.symm) :=
    funext fun i => congrArg yoneda.map (hm i)
  rw [e]
  exact isFpqcCovering_yoneda_map_eqToHom eY hb.symm f hf

/-- The base changes of morphisms of `Picardstack_{X/B}` lying over the members of a family of
morphisms of the site which represents an fpqc covering form an fpqc covering. -/
theorem isFpqcCovering_baseChangeMap_of_base_left_eq {I : Type v} {U : BigFppfOver B S hS}
    {Y : I → BigFppfOver B S hS} (f : ∀ i, Y i ⟶ U)
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i)) {a : I → PicardObject s}
    {b : PicardObject s} (m : ∀ i, PicardHom (a i) b) (eY : ∀ i, (a i).T.left = Y i)
    (hb : b.T.left = U) (hm : ∀ i, (m i).base.left = eqToHom (eY i) ≫ f i ≫ eqToHom hb.symm) :
    IsFpqcCovering B S hS fun i => (baseChangeMap s.f (m i).base).hom :=
  isFpqcCovering_baseChangeMap_of_left_eq f hf (fun i => (m i).base) eY hb hm

/-- The morphism of test schemes between two objects of `Picardstack_{X/B}` lying over the same
scheme `U` of the site with the same structure morphism to the base. -/
def PicardObject.baseHomOfEq (a b : PicardObject s) {U : BigFppfOver B S hS} (ea : a.T.left = U)
    (eb : b.T.left = U)
    (h : (schemeSpaceFunctor B S hS).map (eqToHom ea.symm) ≫ a.T.hom =
      (schemeSpaceFunctor B S hS).map (eqToHom eb.symm) ≫ b.T.hom) : a.T ⟶ b.T :=
  CostructuredArrow.homMk (eqToHom (ea.trans eb.symm)) (by
    subst ea
    simp only [eqToHom_refl, CategoryTheory.Functor.map_id, Category.id_comp] at h
    rw [h])

/-- The underlying morphism of schemes of `PicardObject.baseHomOfEq a b ea eb h` is the
`eqToHom` of the equality `a.T.left = b.T.left`. -/
@[simp]
theorem PicardObject.baseHomOfEq_left (a b : PicardObject s) {U : BigFppfOver B S hS}
    (ea : a.T.left = U) (eb : b.T.left = U)
    (h : (schemeSpaceFunctor B S hS).map (eqToHom ea.symm) ≫ a.T.hom =
      (schemeSpaceFunctor B S hS).map (eqToHom eb.symm) ≫ b.T.hom) :
    (PicardObject.baseHomOfEq a b ea eb h).left = eqToHom (ea.trans eb.symm) :=
  rfl

/-- Two morphisms of `Picardstack_{X/B}` with a common source lying over the same morphism
`g` of the site differ, on base maps, by the morphism of test schemes between their targets
over the identity. -/
theorem PicardHom.base_eq_comp_of_base_left_eq {a b c : PicardObject s} (r : PicardHom a b)
    (ρ : PicardHom a c) {R U : BigFppfOver B S hS} (g : R ⟶ U) (d : a.T.left = R)
    (eb : b.T.left = U) (ec : c.T.left = U) (hr : r.base.left = eqToHom d ≫ g ≫ eqToHom eb.symm)
    (hρ : ρ.base.left = eqToHom d ≫ g ≫ eqToHom ec.symm) (β : b.T ⟶ c.T)
    (hβ : β.left = eqToHom (eb.trans ec.symm)) : ρ.base = r.base ≫ β := by
  refine CostructuredArrow.hom_ext _ _ ?_
  rw [CostructuredArrow.comp_left, hρ, hr, hβ]
  simp only [Category.assoc, eqToHom_trans]

/-- A morphism of `Picardstack_{X/B}` whose base map is a morphism of test schemes over the
identity of `U` lies over the identity of `U`. -/
theorem PicardHom.base_left_eq_of_base_eq {a b : PicardObject s} (m : PicardHom a b)
    {U : BigFppfOver B S hS} (ea : a.T.left = U) (eb : b.T.left = U) {β : a.T ⟶ b.T}
    (hm : m.base = β) (hβ : β.left = eqToHom (ea.trans eb.symm)) :
    m.base.left = eqToHom ea ≫ 𝟙 U ≫ eqToHom eb.symm := by
  rw [hm, hβ]
  simp only [Category.id_comp, eqToHom_trans]

/-- The structure morphism to the base of an object of `Picardstack_{X/B}` factors through a
morphism `f` of the site out of its scheme as soon as the composite with `f` does. -/
theorem schemeSpaceFunctor_map_eqToHom_comp_comp_eq (a : PicardObject s)
    {Y U : BigFppfOver B S hS} (e : a.T.left = Y) (f : Y ⟶ U)
    (c : (schemeSpaceFunctor B S hS).obj U ⟶ s.base)
    (h : (schemeSpaceFunctor B S hS).map f ≫ c =
      (schemeSpaceFunctor B S hS).map (eqToHom e.symm) ≫ a.T.hom) :
    (schemeSpaceFunctor B S hS).map (eqToHom e ≫ f) ≫ c = a.T.hom := by
  subst e
  simpa only [eqToHom_refl, CategoryTheory.Functor.map_id, Category.id_comp] using h

/-- The morphism of test schemes from the scheme of an object of `Picardstack_{X/B}` to a scheme
`U` of the site with a structure morphism to the base, along a morphism of the site. -/
theorem costructuredArrow_homMk_left_eq (a : PicardObject s) {Y U : BigFppfOver B S hS}
    (e : a.T.left = Y) (f : Y ⟶ U) (c : (schemeSpaceFunctor B S hS).obj U ⟶ s.base)
    (w : (schemeSpaceFunctor B S hS).map (eqToHom e ≫ f) ≫ c = a.T.hom) :
    (CostructuredArrow.homMk (eqToHom e ≫ f) w : a.T ⟶ CostructuredArrow.mk c).left =
      eqToHom e ≫ f ≫ eqToHom (rfl : (CostructuredArrow.mk c).left = U).symm := by
  simp only [CostructuredArrow.homMk_left, eqToHom_refl, Category.comp_id]

/-- Two morphisms of `Picardstack_{X/B}` lying over the two projections of a fibre product of the
site, followed by morphisms of test schemes over the two factors of the fibre product, agree. -/
theorem PicardHom.base_comp_eq_of_left_eq {q a₁ a₂ : PicardObject s} {T : s.SchemesOver}
    (m₁ : PicardHom q a₁) (m₂ : PicardHom q a₂) (g₁ : a₁.T ⟶ T) (g₂ : a₂.T ⟶ T)
    {Q Y₁ Y₂ U : BigFppfOver B S hS} (u₁ : Q ⟶ Y₁) (u₂ : Q ⟶ Y₂) (f₁ : Y₁ ⟶ U) (f₂ : Y₂ ⟶ U)
    (huf : u₁ ≫ f₁ = u₂ ≫ f₂) (eq : q.T.left = Q) (e₁ : a₁.T.left = Y₁) (e₂ : a₂.T.left = Y₂)
    (eT : T.left = U) (hm₁ : m₁.base.left = eqToHom eq ≫ u₁ ≫ eqToHom e₁.symm)
    (hm₂ : m₂.base.left = eqToHom eq ≫ u₂ ≫ eqToHom e₂.symm)
    (hg₁ : g₁.left = eqToHom e₁ ≫ f₁ ≫ eqToHom eT.symm)
    (hg₂ : g₂.left = eqToHom e₂ ≫ f₂ ≫ eqToHom eT.symm) :
    m₁.base ≫ g₁ = m₂.base ≫ g₂ := by
  refine CostructuredArrow.hom_ext _ _ ?_
  rw [CostructuredArrow.comp_left, CostructuredArrow.comp_left, hm₁, hm₂, hg₁, hg₂]
  simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  rw [reassoc_of% huf]

section Descent

variable {U : BigFppfOver B S hS} {ι : Type w} {Y : ι → BigFppfOver B S hS} (f : ∀ i, Y i ⟶ U)

/-- The base changes of the chosen cartesian lifts of an object of the fibre over `U` along the
members of a family representing an fpqc covering form an fpqc covering. -/
private theorem isFpqcCovering_baseChangeMap_pullbackLift
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i))
    (x : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.Fiber U) :
    IsFpqcCovering B S hS fun i =>
      (baseChangeMap s.f (Functor.pullbackLift x (f i) : PicardHom _ _).base).hom :=
  isFpqcCovering_baseChangeMap_of_base_left_eq f hf (fun i => Functor.pullbackLift x (f i))
    (fun i => (Functor.pullbackFiber _ x (f i)).2) x.2
    (fun i => picardHom_base_left_eq (f i) (Functor.pullbackLift x (f i)))

/-- **Faithfulness of the functor to descent data.**  Two morphisms of the fibre of
`Picardstack_{X/B}` over `U` with the same image in the descent data relative to a family
representing an fpqc covering are equal. -/
theorem toDescentData_map_injective_picard
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i))
    {x y : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.Fiber U} {φ ψ : x ⟶ y}
    (h : ((Functor.IsFibered.pullbackPseudofunctor
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).map φ =
      ((Functor.IsFibered.pullbackPseudofunctor
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).map ψ) :
    φ = ψ := by
  refine Functor.Fiber.hom_ext ?_
  exact PicardHom.eq_of_comp_eq_of_isFpqcCovering (fun i => Functor.pullbackLift x (f i))
    (isFpqcCovering_baseChangeMap_pullbackLift f hf x)
    (CostructuredArrow.hom_ext _ _
      ((picardHom_base_left_eq (𝟙 U) (Functor.Fiber.fiberInclusion.map φ)).trans
        (picardHom_base_left_eq (𝟙 U) (Functor.Fiber.fiberInclusion.map ψ)).symm))
    (Functor.pullbackLift_comp_eq_of_toDescentData_map_eq h)

/-- **Fullness of the functor to descent data.**  Every morphism between the descent data of
two objects of the fibre of `Picardstack_{X/B}` over `U`, relative to a covering family, comes
from a morphism of the fibre. -/
theorem toDescentData_map_surjective_picard
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i))
    (hf' : Sieve.ofArrows Y f ∈ BigFppfOver.topology B S hS U)
    {x y : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.Fiber U}
    (Ψ : ((Functor.IsFibered.pullbackPseudofunctor
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).obj x ⟶
      ((Functor.IsFibered.pullbackPseudofunctor
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).obj y) :
    ∃ m : x ⟶ y, ((Functor.IsFibered.pullbackPseudofunctor
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).map m =
      Ψ := by
  have hr := fun i => picardHom_base_left_eq (f i) (Functor.pullbackLift x (f i))
  have hρ := fun i => picardHom_base_left_eq (f i)
    (Functor.Fiber.fiberInclusion.map (Functor.descentDataHomF Ψ i) ≫ Functor.pullbackLift y (f i))
  have hpt : (schemeSpaceFunctor B S hS).map (eqToHom x.2.symm) ≫ x.1.T.hom =
      (schemeSpaceFunctor B S hS).map (eqToHom y.2.symm) ≫ y.1.T.hom :=
    schemeSpace_hom_ext_of_mem_topology f hf' _ _ fun i =>
      schemeSpaceFunctor_map_comp_eq_of_base_left_eq _ _ (f i) (f i) _ x.2 y.2 (hr i) (hρ i)
  obtain ⟨m, hmb, hm⟩ := PicardHom.exists_comp_eq_of_isFpqcCovering
    (PicardObject.baseHomOfEq x.1 y.1 x.2 y.2 hpt) (fun i => Functor.pullbackLift x (f i))
    (fun i => Functor.Fiber.fiberInclusion.map (Functor.descentDataHomF Ψ i) ≫
      Functor.pullbackLift y (f i))
    (fun i => PicardHom.base_eq_comp_of_base_left_eq _ _ (f i) _ x.2 y.2 (hr i) (hρ i) _
      (PicardObject.baseHomOfEq_left _ _ _ _ _))
    (isFpqcCovering_baseChangeMap_pullbackLift f hf x)
    (fun i j => (Functor.pullbackFiber _ (Functor.pullbackFiber _ x (f i))
      (pullback.fst (f i) (f j))).1)
    (fun i j => Functor.pullbackLift (Functor.pullbackFiber _ x (f i)) (pullback.fst (f i) (f j)))
    (fun i j => Functor.Fiber.fiberInclusion.map (Functor.toDescentDataHomF f x
        (pullback.fst (f i) (f j) ≫ f i) (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j))
        rfl pullback.condition.symm) ≫
      Functor.pullbackLift (Functor.pullbackFiber _ x (f j)) (pullback.snd (f i) (f j)))
    (fun i j => ((Category.assoc _ _ _).trans (Functor.toDescentDataHomF_pullbackLift x
      (pullback.fst (f i) (f j) ≫ f i) (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j))
        rfl pullback.condition.symm)).symm)
    (fun i j => (Functor.toDescentData_hom_comm_cartesian Ψ (pullback.fst (f i) (f j) ≫ f i)
      (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j)) rfl
        pullback.condition.symm).trans (Category.assoc _ _ _).symm)
    (fun i j => isPullback_baseChangeMap_of_isPullback s.f
      (isPullback_of_eq_eqToHom (IsPullback.of_hasPullback (f i) (f j))
        (Functor.pullbackFiber _ (Functor.pullbackFiber _ x (f i)) (pullback.fst (f i) (f j))).2
        (Functor.pullbackFiber _ x (f i)).2 (Functor.pullbackFiber _ x (f j)).2 x.2
        (picardHom_base_left_eq (pullback.fst (f i) (f j))
          (Functor.pullbackLift (Functor.pullbackFiber _ x (f i)) (pullback.fst (f i) (f j))))
        (picardHom_base_left_eq (pullback.snd (f i) (f j))
          (Functor.Fiber.fiberInclusion.map (Functor.toDescentDataHomF f x
            (pullback.fst (f i) (f j) ≫ f i) (pullback.fst (f i) (f j))
            (pullback.snd (f i) (f j)) rfl pullback.condition.symm) ≫
          Functor.pullbackLift (Functor.pullbackFiber _ x (f j)) (pullback.snd (f i) (f j))))
        (hr i) (hr j)))
  refine ⟨⟨m, ?_⟩, ?_⟩
  · exact IsHomLift.of_fac' _ (𝟙 U) _ x.2 y.2 (PicardHom.base_left_eq_of_base_eq m x.2 y.2 hmb
      (PicardObject.baseHomOfEq_left _ _ _ _ _))
  · exact Functor.toDescentData_map_eq_of_cartesian Ψ _ hm

/-- The comparison `homF` of a descent datum, transported along `p`, composes with the lift
through the first projection to the comparison along `p ≫ snd`. -/
private theorem homF_pullbackLiftComp_comp
    (D : (Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).DescentData f)
    {T : BigFppfOver B S hS} {i₀ a b : ι} (r : T ⟶ Y i₀) (p : T ⟶ pullback (f a) (f b))
    (ea : (p ≫ pullback.fst (f a) (f b)) ≫ f a = r ≫ f i₀)
    (eb : (p ≫ pullback.snd (f a) (f b)) ≫ f b = r ≫ f i₀) :
    (Functor.Fiber.fiberInclusion.map (D.homF _ _ (p ≫ pullback.fst (f a) (f b)) rfl ea) ≫
        Functor.pullbackLiftComp (D.objF a) (pullback.fst (f a) (f b)) p) ≫
      (Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f a) (f b) ≫ f a)
          (pullback.fst (f a) (f b)) (pullback.snd (f a) (f b)) rfl pullback.condition.symm) ≫
        Functor.pullbackLift (D.objF b) (pullback.snd (f a) (f b))) =
      Functor.Fiber.fiberInclusion.map (D.homF _ _ (p ≫ pullback.snd (f a) (f b)) rfl eb) ≫
        Functor.pullbackLift (D.objF b) (p ≫ pullback.snd (f a) (f b)) := by
  rw [Category.assoc, ← D.homF_pull p (pullback.fst (f a) (f b) ≫ f a) _ _ rfl
    pullback.condition.symm, ← Category.assoc, ← CategoryTheory.Functor.map_comp,
    D.homF_congr_base (p ≫ pullback.fst (f a) (f b) ≫ f a) (r ≫ f i₀) _ _ _ _ ea eb, D.homF_comp]

/-- **The triple overlaps of a descent datum of `Picardstack_{X/B}`.**  Over a cartesian square
`T = (X i ×_U X j) ×_{X j} (X j ×_U X k)` the descent datum provides an object with morphisms to
the three members and to the three chosen pullbacks over the double overlaps, compatible with the
two projections of each double overlap; the compatibility over `X i ×_U X k` is the cocycle
condition of the descent datum. -/
theorem exists_tripleOverlap_picard
    (D : (Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).DescentData f)
    {i j k : ι} {T : BigFppfOver B S hS} (p₁₂ : T ⟶ pullback (f i) (f j))
    (p₂₃ : T ⟶ pullback (f j) (f k)) (p₁₃ : T ⟶ pullback (f i) (f k))
    (h₁₂₃ : p₁₂ ≫ pullback.snd (f i) (f j) = p₂₃ ≫ pullback.fst (f j) (f k))
    (h₁₃a : p₁₃ ≫ pullback.fst (f i) (f k) = p₁₂ ≫ pullback.fst (f i) (f j))
    (h₁₃b : p₁₃ ≫ pullback.snd (f i) (f k) = p₂₃ ≫ pullback.snd (f j) (f k))
    (hT : IsPullback p₁₂ p₂₃ (pullback.snd (f i) (f j)) (pullback.fst (f j) (f k))) :
    ∃ (R : (picardBasedCategory (modulePushforwardCoherence B S hS) s).obj)
      (σ₁ : R ⟶ Functor.Fiber.fiberInclusion.obj (D.objF i))
      (σ₂ : R ⟶ Functor.Fiber.fiberInclusion.obj (D.objF j))
      (σ₃ : R ⟶ Functor.Fiber.fiberInclusion.obj (D.objF k))
      (ρ₁₂ : R ⟶ Functor.Fiber.fiberInclusion.obj
        (Functor.pullbackFiber _ (D.objF i) (pullback.fst (f i) (f j))))
      (ρ₂₃ : R ⟶ Functor.Fiber.fiberInclusion.obj
        (Functor.pullbackFiber _ (D.objF j) (pullback.fst (f j) (f k))))
      (ρ₁₃ : R ⟶ Functor.Fiber.fiberInclusion.obj
        (Functor.pullbackFiber _ (D.objF i) (pullback.fst (f i) (f k)))),
      ρ₁₂ ≫ Functor.pullbackLift (D.objF i) (pullback.fst (f i) (f j)) = σ₁ ∧
      ρ₁₂ ≫ (Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f i) (f j) ≫ f i)
          (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j)) rfl pullback.condition.symm) ≫
        Functor.pullbackLift (D.objF j) (pullback.snd (f i) (f j))) = σ₂ ∧
      ρ₂₃ ≫ Functor.pullbackLift (D.objF j) (pullback.fst (f j) (f k)) = σ₂ ∧
      ρ₂₃ ≫ (Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f j) (f k) ≫ f j)
          (pullback.fst (f j) (f k)) (pullback.snd (f j) (f k)) rfl pullback.condition.symm) ≫
        Functor.pullbackLift (D.objF k) (pullback.snd (f j) (f k))) = σ₃ ∧
      ρ₁₃ ≫ Functor.pullbackLift (D.objF i) (pullback.fst (f i) (f k)) = σ₁ ∧
      ρ₁₃ ≫ (Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f i) (f k) ≫ f i)
          (pullback.fst (f i) (f k)) (pullback.snd (f i) (f k)) rfl pullback.condition.symm) ≫
        Functor.pullbackLift (D.objF k) (pullback.snd (f i) (f k))) = σ₃ ∧
      IsPullback (baseChangeMap s.f (ρ₁₂ : PicardHom _ _).base)
        (baseChangeMap s.f (ρ₂₃ : PicardHom _ _).base)
        (baseChangeMap s.f (Functor.Fiber.fiberInclusion.map (D.homF
          (pullback.fst (f i) (f j) ≫ f i) (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j))
            rfl pullback.condition.symm) ≫
          Functor.pullbackLift (D.objF j) (pullback.snd (f i) (f j)) : PicardHom _ _).base)
        (baseChangeMap s.f (Functor.pullbackLift (D.objF j) (pullback.fst (f j) (f k)) :
          PicardHom _ _).base) := by
  have e₂ : (p₁₂ ≫ pullback.snd (f i) (f j)) ≫ f j = (p₁₂ ≫ pullback.fst (f i) (f j)) ≫ f i := by
    rw [Category.assoc, Category.assoc, pullback.condition]
  have e₂' : (p₂₃ ≫ pullback.fst (f j) (f k)) ≫ f j =
      (p₁₂ ≫ pullback.fst (f i) (f j)) ≫ f i := by
    rw [← h₁₂₃, e₂]
  have e₃ : (p₂₃ ≫ pullback.snd (f j) (f k)) ≫ f k =
      (p₁₂ ≫ pullback.fst (f i) (f j)) ≫ f i := by
    rw [Category.assoc, ← pullback.condition, ← Category.assoc, e₂']
  have e₁' : (p₁₃ ≫ pullback.fst (f i) (f k)) ≫ f i = (p₁₂ ≫ pullback.fst (f i) (f j)) ≫ f i := by
    rw [h₁₃a]
  have e₃' : (p₁₃ ≫ pullback.snd (f i) (f k)) ≫ f k = (p₁₂ ≫ pullback.fst (f i) (f j)) ≫ f i := by
    rw [h₁₃b, e₃]
  refine ⟨Functor.Fiber.fiberInclusion.obj
      (Functor.pullbackFiber _ (D.objF i) (p₁₂ ≫ pullback.fst (f i) (f j))),
    Functor.pullbackLift (D.objF i) (p₁₂ ≫ pullback.fst (f i) (f j)),
    Functor.Fiber.fiberInclusion.map (D.homF _ _ (p₁₂ ≫ pullback.snd (f i) (f j)) rfl e₂) ≫
      Functor.pullbackLift (D.objF j) (p₁₂ ≫ pullback.snd (f i) (f j)),
    Functor.Fiber.fiberInclusion.map (D.homF _ _ (p₂₃ ≫ pullback.snd (f j) (f k)) rfl e₃) ≫
      Functor.pullbackLift (D.objF k) (p₂₃ ≫ pullback.snd (f j) (f k)),
    Functor.pullbackLiftComp (D.objF i) (pullback.fst (f i) (f j)) p₁₂,
    Functor.Fiber.fiberInclusion.map (D.homF _ _ (p₂₃ ≫ pullback.fst (f j) (f k)) rfl e₂') ≫
      Functor.pullbackLiftComp (D.objF j) (pullback.fst (f j) (f k)) p₂₃,
    Functor.Fiber.fiberInclusion.map (D.homF _ _ (p₁₃ ≫ pullback.fst (f i) (f k)) rfl e₁') ≫
      Functor.pullbackLiftComp (D.objF i) (pullback.fst (f i) (f k)) p₁₃,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (Functor.pullbackLift_comp _ _ _).symm
  · rw [← D.homF_pull p₁₂ (pullback.fst (f i) (f j) ≫ f i) _ _ rfl pullback.condition.symm]
    exact congrArg (fun φ => Functor.Fiber.fiberInclusion.map φ ≫
      Functor.pullbackLift (D.objF j) (p₁₂ ≫ pullback.snd (f i) (f j)))
      (D.homF_congr_base _ _ _ _ _ _ _ _)
  · rw [Category.assoc, ← Functor.pullbackLift_comp]
    exact D.homF_pullbackLift_congr _ _ h₁₂₃.symm _ _ _
  · exact homF_pullbackLiftComp_comp f D _ p₂₃ e₂' e₃
  · rw [Category.assoc, ← Functor.pullbackLift_comp,
      D.homF_pullbackLift_congr _ _ h₁₃a _ _ rfl, D.homF_self,
      CategoryTheory.Functor.map_id, Category.id_comp]
  · refine (homF_pullbackLiftComp_comp f D _ p₁₃ e₁' e₃').trans ?_
    exact D.homF_pullbackLift_congr _ _ h₁₃b _ _ _
  · exact isPullback_baseChangeMap_of_isPullback s.f
      (isPullback_of_eq_eqToHom hT
        (Functor.pullbackFiber _ (D.objF i) (p₁₂ ≫ pullback.fst (f i) (f j))).2
        (Functor.pullbackFiber _ (D.objF i) (pullback.fst (f i) (f j))).2
        (Functor.pullbackFiber _ (D.objF j) (pullback.fst (f j) (f k))).2 (D.objF j).2
        (picardHom_base_left_eq p₁₂
          (Functor.pullbackLiftComp (D.objF i) (pullback.fst (f i) (f j)) p₁₂))
        (picardHom_base_left_eq p₂₃
          (Functor.Fiber.fiberInclusion.map (D.homF _ _ (p₂₃ ≫ pullback.fst (f j) (f k)) rfl e₂') ≫
            Functor.pullbackLiftComp (D.objF j) (pullback.fst (f j) (f k)) p₂₃))
        (picardHom_base_left_eq (pullback.snd (f i) (f j))
          (Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f i) (f j) ≫ f i)
            (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j)) rfl
              pullback.condition.symm) ≫
            Functor.pullbackLift (D.objF j) (pullback.snd (f i) (f j))))
        (picardHom_base_left_eq (pullback.fst (f j) (f k))
          (Functor.pullbackLift (D.objF j) (pullback.fst (f j) (f k)))))

/-- **Effectivity of descent data in `Picardstack_{X/B}`.**  Every descent datum relative to a
family of morphisms of the site which is an fppf covering is isomorphic to the canonical descent
datum of an object of the fibre over `U`.

The structure morphisms of the members glue to a morphism `U ⟶ B` (the base is a sheaf), the
invertible modules glue along the fpqc covering `{X_{U_i} ⟶ X_U}` by Stacks 04W8 with the
descended module invertible, and the morphisms to the glued object are cartesian, the projection
being fibred in groupoids. -/
theorem exists_iso_toDescentData_picard
    (hf : IsFpqcCovering B S hS fun i => yoneda.map (f i))
    (hf' : Sieve.ofArrows Y f ∈ BigFppfOver.topology B S hS U)
    (D : (Functor.IsFibered.pullbackPseudofunctor
      (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).DescentData f) :
    ∃ x : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.Fiber U,
      Nonempty (((Functor.IsFibered.pullbackPseudofunctor
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p).toDescentData f).obj x ≅
          D) := by
  have hfst := fun i j => picardHom_base_left_eq (pullback.fst (f i) (f j))
    (Functor.pullbackLift (D.objF i) (pullback.fst (f i) (f j)))
  have hsnd := fun i j => picardHom_base_left_eq (pullback.snd (f i) (f j))
    (Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f i) (f j) ≫ f i)
      (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j)) rfl pullback.condition.symm) ≫
      Functor.pullbackLift (D.objF j) (pullback.snd (f i) (f j)))
  have hb : ∀ i j, (schemeSpaceFunctor B S hS).map (pullback.fst (f i) (f j)) ≫
      ((schemeSpaceFunctor B S hS).map (eqToHom (D.objF i).2.symm) ≫ (D.objF i).1.T.hom) =
      (schemeSpaceFunctor B S hS).map (pullback.snd (f i) (f j)) ≫
      ((schemeSpaceFunctor B S hS).map (eqToHom (D.objF j).2.symm) ≫ (D.objF j).1.T.hom) :=
    fun i j => schemeSpaceFunctor_map_comp_eq_of_base_left_eq _ _ (pullback.fst (f i) (f j))
      (pullback.snd (f i) (f j)) _ (D.objF i).2 (D.objF j).2 (hfst i j) (hsnd i j)
  obtain ⟨c, hc⟩ := exists_schemeSpace_hom_of_mem_topology f hf' _ hb
  have hw := fun i => schemeSpaceFunctor_map_eqToHom_comp_comp_eq (D.objF i).1 (D.objF i).2
    (f i) c (hc i)
  have hgl := fun i => costructuredArrow_homMk_left_eq (D.objF i).1 (D.objF i).2 (f i) c (hw i)
  choose R σ₁ σ₂ σ₃ ρ₁₂ ρ₂₃ ρ₁₃ h12a h12b h23a h23b h13a h13b hR using fun i j k =>
    exists_tripleOverlap_picard f D (i := i) (j := j) (k := k)
      (pullback.fst (pullback.snd (f i) (f j)) (pullback.fst (f j) (f k)))
      (pullback.snd (pullback.snd (f i) (f j)) (pullback.fst (f j) (f k)))
      (pullback.lift (pullback.fst (pullback.snd (f i) (f j)) (pullback.fst (f j) (f k)) ≫
          pullback.fst (f i) (f j))
        (pullback.snd (pullback.snd (f i) (f j)) (pullback.fst (f j) (f k)) ≫
          pullback.snd (f j) (f k)) (by
        rw [Category.assoc, pullback.condition, ← Category.assoc, pullback.condition,
          Category.assoc, Category.assoc, pullback.condition]))
      pullback.condition (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback _ _)
  obtain ⟨L, hL, κ, hκb, hκ⟩ := PicardHom.exists_picardObject_of_isFpqcCovering
    (A := fun i => (D.objF i).1)
    (fun i => (CostructuredArrow.homMk (eqToHom (D.objF i).2 ≫ f i) (hw i) :
      (D.objF i).1.T ⟶ CostructuredArrow.mk c))
    (fun i j => (Functor.pullbackFiber _ (D.objF i) (pullback.fst (f i) (f j))).1)
    (fun i j => Functor.pullbackLift (D.objF i) (pullback.fst (f i) (f j)))
    (fun i j => Functor.Fiber.fiberInclusion.map (D.homF (pullback.fst (f i) (f j) ≫ f i)
        (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j)) rfl pullback.condition.symm) ≫
      Functor.pullbackLift (D.objF j) (pullback.snd (f i) (f j)))
    (fun i j => isPullback_baseChangeMap_of_isPullback s.f
      (isPullback_of_eq_eqToHom (IsPullback.of_hasPullback (f i) (f j))
        (Functor.pullbackFiber _ (D.objF i) (pullback.fst (f i) (f j))).2 (D.objF i).2
        (D.objF j).2 rfl (hfst i j) (hsnd i j) (hgl i) (hgl j)))
    R σ₁ σ₂ σ₃ ρ₁₂ ρ₂₃ ρ₁₃ h12a h12b h23a h23b h13a h13b hR
    (isFpqcCovering_baseChangeMap_of_left_eq f hf _ (fun i => (D.objF i).2) rfl hgl)
    (fun i j => PicardHom.base_comp_eq_of_left_eq _ _ _ _ (pullback.fst (f i) (f j))
      (pullback.snd (f i) (f j)) (f i) (f j) pullback.condition
      (Functor.pullbackFiber _ (D.objF i) (pullback.fst (f i) (f j))).2 (D.objF i).2
      (D.objF j).2 rfl (hfst i j) (hsnd i j) (hgl i) (hgl j))
  let x : (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.Fiber U :=
    ⟨(⟨CostructuredArrow.mk c, L, hL⟩ : PicardObject s), rfl⟩
  have hκl : ∀ i, (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsHomLift (f i)
      (κ i : Functor.Fiber.fiberInclusion.obj (D.objF i) ⟶ Functor.Fiber.fiberInclusion.obj x) :=
    fun i => IsHomLift.of_fac' _ (f i) _ (D.objF i).2 rfl
      ((congrArg CommaMorphism.left (hκb i)).trans (hgl i))
  have hκc : ∀ i, (picardBasedCategory (modulePushforwardCoherence B S hS) s).p.IsCartesian (f i)
      (κ i : Functor.Fiber.fiberInclusion.obj (D.objF i) ⟶ Functor.Fiber.fiberInclusion.obj x) :=
    fun i => by
