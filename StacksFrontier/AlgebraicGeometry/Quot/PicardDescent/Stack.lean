      have := Functor.IsFiberedInGroupoids.isStronglyCartesian_homLift
        (picardBasedCategory_isFiberedInGroupoids (modulePushforwardCoherence B S hS) s) (f i)
        (κ i : Functor.Fiber.fiberInclusion.obj (D.objF i) ⟶ Functor.Fiber.fiberInclusion.obj x)
      exact Functor.IsStronglyCartesian.isCartesian_of_isStronglyCartesian
        (picardBasedCategory (modulePushforwardCoherence B S hS) s).p (f i)
        (κ i : Functor.Fiber.fiberInclusion.obj (D.objF i) ⟶ Functor.Fiber.fiberInclusion.obj x)
  exact ⟨x, Functor.nonempty_iso_toDescentData_of_cartesian_pullback D x (fun i => κ i) hκc
    fun i j => (Category.assoc _ _ _).symm.trans (hκ i j).symm⟩

