module

public import StacksFrontier.AlgebraicGeometry.Quot.PolarizedStackLineBundleDescent
public import StacksFrontier.AlgebraicGeometry.Descent.RelativeAmpleFpqcLocalOnBaseFull
public import StacksFrontier.AlgebraicGeometry.RelativeVeryAmple.TensorPower
public import StacksFrontier.CategoryTheory.Sites.Stack.EffectiveDescentGenerators
public import StacksFrontier.AlgebraicGeometry.Descent.QuasiCoherent.ZariskiEssSurj
