/-!
# Effective descent for polarized families, once the total space has descended (Stacks 0D40)

Let `D` be a descent datum of polarized families relative to the sieve generated by a covering
family `{f i : V i ⟶ U}` of the big fppf site, with members `x i`, and suppose the family of
total spaces has descended to a scheme `Z` over `U` (`AlgebraicGeometry.PolarizedDescentScheme`),
with morphisms `t i` from the total space of `x i` to `Z`. This file descends the polarization
along the `t i` (Stacks 023T), shows that the descended module is invertible and relatively ample
over `U` (Stacks 0D2P), and concludes that `D` is effective.

## Main definitions

* `AlgebraicGeometry.PolarizedDescentScheme.descendedFamily`: the polarized family over `U`
  with total space `Z` and polarization a module `M` on `Z` whose canonical descent datum is
  that of the polarizations of the members.
* `AlgebraicGeometry.PolarizedDescentScheme.toDescended`: the morphism from the `i`-th member
  of `D` to the descended family, over `f i`.

## Main results

* `AlgebraicGeometry.PolarizedDescentScheme.glue_toDescended`: the morphisms to the descended
  family are compatible with the gluing isomorphisms of `D`.
* `AlgebraicGeometry.PolarizedDescentScheme.isEffective`: **a descent datum of polarized families
  whose family of total spaces has descended to a scheme is effective.**

## References

* [Stacks Project, Tag 0D40](https://stacks.math.columbia.edu/tag/0D40)
* [Stacks Project, Tag 023T](https://stacks.math.columbia.edu/tag/023T)
* [Stacks Project, Tag 0D2P](https://stacks.math.columbia.edu/tag/0D2P)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Functor (Fiber IsPreFibered pullbackFiber)

universe w u

namespace AlgebraicGeometry

/-- The comparison `f^* t^* M ⟶ q^* M` at `f ≫ t = q`, followed by its inverse spelled through
the reversed equation. -/
theorem pullbackCompHom_comp_pullbackCongr_symm {X Y Z : Scheme.{u}} (g : X ⟶ Y) (t : Y ⟶ Z)
    (q : X ⟶ Z) (e : g ≫ t = q) (M : Z.Modules) :
    Stacks.Descent.pullbackCompHom g t q e M ≫ (Scheme.Modules.pullbackCongr e.symm).hom.app M ≫
      (Scheme.Modules.pullbackComp g t).inv.app M = 𝟙 _ := by
  subst e
  show ((Scheme.Modules.pullbackComp g t).hom.app M ≫ 𝟙 _) ≫ 𝟙 _ ≫
    (Scheme.Modules.pullbackComp g t).inv.app M = 𝟙 _
  simp only [Category.comp_id, Category.id_comp, Iso.hom_inv_id_app]

variable {B : BigFppfSite.{u}}

/-- Relative ampleness for the structure morphism of a polarized family followed by an
identification of its base. -/
theorem PolarizedFamily.isRelativelyAmple_toBase_comp_eqToHom {V : B.Schemes}
    {x : PolarizedFamily B} (h : x.base = V) (L : x.total.Modules)
    [Stacks.Ample.IsInvertibleModule x.total L]
    (hx : Stacks.RelativeAmple.IsRelativelyAmple x.toBase L) :
    Stacks.RelativeAmple.IsRelativelyAmple (x.toBase ≫ B.inclusion.map (eqToHom h)) L := by
  subst h
  rw [eqToHom_refl, CategoryTheory.Functor.map_id, Category.comp_id]
  exact hx

/-- A cartesian square for the structure morphism of a polarized family followed by an
identification of its base is a cartesian square for the structure morphism itself. -/
theorem PolarizedFamily.isPullback_of_comp_eqToHom {V W : B.Schemes} {x : PolarizedFamily B}
    (h : x.base = V) {Z : Scheme.{u}} {t : x.total ⟶ Z} {π : Z ⟶ B.inclusion.obj W}
    {g : V ⟶ W}
    (hsq : IsPullback t (x.toBase ≫ B.inclusion.map (eqToHom h)) π (B.inclusion.map g)) :
    IsPullback t x.toBase π (B.inclusion.map (eqToHom h ≫ g)) := by
  subst h
  simpa only [eqToHom_refl, CategoryTheory.Functor.map_id, Category.comp_id, Category.id_comp]
    using hsq

namespace PolarizedDescentScheme

attribute [local implicit_reducible] Fiber Fiber.fiberInclusion

variable {U : B.Schemes} {I : Type w} {V : I → B.Schemes} {f : ∀ i, V i ⟶ U}
  {D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)}
  (S : PolarizedDescentScheme D)
  {M : (SheafOfModules.isQuasicoherent S.total.ringCatSheaf).FullSubcategory}
  (E : (canonicalDescentFunctor S.totalMap).obj M ≅ S.lineBundleDescentData)

/-- The component at the `i`-th member of an isomorphism from the canonical descent datum of a
module `M` on the descended scheme to the descent datum of the polarizations: an isomorphism from
the pullback of `M` to the polarization of the `i`-th member. -/
def componentIso (i : I) :
    (Scheme.Modules.pullback (S.totalMap i)).obj M.obj ≅ (member D i).1.lineBundle where
  hom := E.hom.hom.hom i
  inv := E.inv.hom.hom i
  hom_inv_id := congrArg (fun φ => φ.hom.hom i) E.hom_inv_id
  inv_hom_id := congrArg (fun φ => φ.hom.hom i) E.inv_hom_id

/-- The family of morphisms from the total spaces of the members to the descended scheme, as a
covering of the fpqc precoverage. -/
def memberFpqcCover
    (hf : Presieve.ofArrows (fun i => B.inclusion.obj (V i)) (fun i => B.inclusion.map (f i)) ∈
      Scheme.fpqcPrecoverage (B.inclusion.obj U)) :
    S.total.Cover.{w} Scheme.fpqcPrecoverage :=
  ⟨S.memberCover, S.ofArrows_totalMap_mem_fpqcPrecoverage hf⟩

/-- The pullback of the descended module to the total space of the `i`-th member is invertible,
being isomorphic to the polarization of the member. -/
private theorem isInvertible_pullback_descended {i : I}
    (e : (Scheme.Modules.pullback (S.totalMap i)).obj M.obj ≅ (member D i).1.lineBundle) :
    SheafOfModules.IsInvertible (member D i).1.total.presheaf
      (member D i).1.total.ringCatSheaf.2 ((Scheme.Modules.pullback (S.totalMap i)).obj M.obj) :=
  Stacks.Picard.isInvertible_of_iso e.symm
    ((Stacks.InvertiblePullback.stacksIsInvertible_iff_algebraicGeometryIsInvertible _ _
      _).mpr (member D i).1.invertible)

variable (hf : Presieve.ofArrows (fun i => B.inclusion.obj (V i))
  (fun i => B.inclusion.map (f i)) ∈ Scheme.fpqcPrecoverage (B.inclusion.obj U))

include hf E in
/-- **The descended polarization is invertible**: its pullbacks to the members of the fpqc
covering by the total spaces of the members are the polarizations of the members. -/
theorem isInvertible_descended :
    SheafOfModules.IsInvertible S.total.presheaf S.total.ringCatSheaf.2 M.obj :=
  (Stacks.InvertiblePullback.stacksIsInvertible_iff_algebraicGeometryIsInvertible _ _ _).mp
    (Stacks.Picard.isInvertible_of_pullback_fpqcCover M.obj M.property (S.memberFpqcCover hf)
      fun i => S.isInvertible_pullback_descended (S.componentIso E i))

include hf E in
/-- **The descended polarization is relatively ample** over the base (Stacks 0D2P): its pullbacks
along the base changes of the descended family by the covering family of the site are the
polarizations of the members, which are relatively ample. -/
@[sga "1 VIII 5.10" "special case"]
theorem isRelativelyAmple_descended :
    letI := S.isInvertible_descended E hf
    Stacks.RelativeAmple.IsRelativelyAmple S.toBase M.obj := by
  let := S.isInvertible_descended E hf
  refine (Stacks.Descent.isRelativelyAmple_iff_forall_of_fpqcCover hf S.toBase M.obj
    S.isPullback).mpr fun i => ?_
  have : Stacks.Ample.IsInvertibleModule (member D i).1.total (member D i).1.lineBundle :=
    (member D i).1.invertible
  have : Stacks.Ample.IsInvertibleModule (member D i).1.total
      (Stacks.AmpleLocallyClosed.pullbackModule (S.totalMap i) M.obj) :=
    (Stacks.InvertiblePullback.stacksIsInvertible_iff_algebraicGeometryIsInvertible _ _ _).mp
      (S.isInvertible_pullback_descended (S.componentIso E i))
  have : Stacks.Ample.IsInvertibleModule (member D i).1.total
      ((Scheme.Modules.pullback (S.totalMap i)).obj M.obj) :=
    (inferInstance : Stacks.Ample.IsInvertibleModule (member D i).1.total
      (Stacks.AmpleLocallyClosed.pullbackModule (S.totalMap i) M.obj))
  exact (Stacks.RelativeVeryAmple.isRelativelyAmple_congr _ _ _ (S.componentIso E i)).mpr
    (PolarizedFamily.isRelativelyAmple_toBase_comp_eqToHom (member D i).2 _
      (member D i).1.relativelyAmple)

/-- **The descended polarized family**: total space the descended scheme, polarization the
descended module. -/
def descendedFamily : PolarizedFamily B where
  base := U
  total := S.total
  toBase := S.toBase
  proper := S.isProper_toBase hf
  flat := S.flat_toBase hf
  finitePresentation := S.finitePresentation_toBase hf
  lineBundle := M.obj
  invertible := S.isInvertible_descended E hf
  relativelyAmple := S.isRelativelyAmple_descended E hf

/-- **The morphism from the `i`-th member to the descended family**, over `f i`: the morphism of
total spaces `t i`, with the component of `E` as comparison of polarizations. -/
def toDescended (i : I) : (member D i).1 ⟶ S.descendedFamily E hf where
  baseMap := eqToHom (member D i).2 ≫ f i
  totalMap := S.totalMap i
  cartesian := PolarizedFamily.isPullback_of_comp_eqToHom (member D i).2 (S.isPullback i)
  lineBundleIso := S.componentIso E i

/-- The morphism from the `i`-th member to the descended family lies over `f i`. -/
instance isHomLift_toDescended (i : I) :
    (polarizedProjection B).IsHomLift (f i) (S.toDescended E hf i) :=
  IsHomLift.of_fac' _ _ _ (member D i).2 rfl (by simp; rfl)

/-- An identity of morphisms in a category, deduced from a commuting square and identities between
composites of isomorphisms. -/
private theorem glue_aux {C : Type*} [Category C] {X₀ X₁ Q B' Y₀ Y₁ W : C} (a : X₀ ⟶ X₁)
    (T : X₁ ⟶ Y₁) (Cn : X₀ ⟶ Y₀) (b : Y₀ ⟶ Y₁) (u : X₁ ≅ W) (v : Y₁ ≅ W) (K1 : X₀ ⟶ Q)
    (K2 : Y₀ ⟶ Q) (X1 : X₀ ⟶ Q) (X2 : Q ⟶ B') (Y0 : B' ⟶ B') (X3 : B' ⟶ Y₀) (n : B' ≅ W)
    (comm : a ≫ T = Cn ≫ b) (hT : T = u.hom ≫ v.inv) (hC : Cn ≫ K2 = K1) (hK1 : K1 = X1)
    (hK : K2 ≫ X2 ≫ X3 = 𝟙 _) (hY0 : Y0 = 𝟙 _) (hn : n.hom = Y0 ≫ X3 ≫ b ≫ v.hom) :
    a = X1 ≫ X2 ≫ n.hom ≫ u.inv := by
  subst hT hK1 hY0
  rw [hn, ← hC, ← cancel_mono u.hom]
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id, Category.id_comp]
  rw [← cancel_mono v.inv]
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  rw [comm, reassoc_of% hK]

/-- **The morphisms to the descended family are compatible with the gluing isomorphisms of
`D`.** Over a scheme `W` of the site with `α ≫ f i = β ≫ f j`, the morphism from the pullback of
the `i`-th member along `α` to the descended family through the `i`-th member agrees with the one
through the gluing isomorphism of `D` at `(α, β)` and the `j`-th member. -/
theorem glue_toDescended (i j : I) {W : B.Schemes} (α : W ⟶ V i) (β : W ⟶ V j)
    (h : α ≫ f i = β ≫ f j) :
    glueMap D i j α β h ≫ S.toDescended E hf j =
      pullbackMemberMap D i α ≫ S.toDescended E hf i := by
  have hb : (pullbackMemberMap D i α).baseMap ≫ (S.toDescended E hf i).baseMap =
      (glueMap D i j α β h ≫ S.toDescended E hf j).baseMap := by
    have : (polarizedProjection B).IsHomLift β (pullbackMemberMap D j β) := inferInstance
    have : (polarizedProjection B).IsHomLift β (glueMap D i j α β h) :=
      have : (polarizedProjection B).IsHomLift (𝟙 W)
          (Fiber.fiberInclusion.map
            (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) α β h).hom) :=
        (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) α β h).hom.2
      IsHomLift.comp_lift_id_left' (p := polarizedProjection B) W _ β _
    have i1 : (polarizedProjection B).IsHomLift (α ≫ f i)
        (pullbackMemberMap D i α ≫ S.toDescended E hf i) := inferInstance
    rw [h] at i1
    have h1 := IsHomLift.fac' (polarizedProjection B) (β ≫ f j)
      (pullbackMemberMap D i α ≫ S.toDescended E hf i)
    have h2 := IsHomLift.fac' (polarizedProjection B) (β ≫ f j)
      (glueMap D i j α β h ≫ S.toDescended E hf j)
    exact h1.trans h2.symm
  have htot : (pullbackMemberMap D i α).totalMap ≫ (S.toDescended E hf i).totalMap =
      (glueMap D i j α β h ≫ S.toDescended E hf j).totalMap :=
    (S.totalMap_glue i j α β h).symm
  refine ((PolarizedFamily.comp_eq_iff _ _ _ hb htot).mpr ?_).symm
  have comm := E.hom.hom.comm ((pullbackMemberMap D i α).totalMap ≫ S.totalMap i)
    (pullbackMemberMap D i α).totalMap (glueMap D i j α β h).totalMap rfl
    (S.totalMap_glue i j α β h)
  exact glue_aux _ _ _ _ _ _ _ _ _ _ _ _ _ comm (S.lineBundleDescentData_hom_glue i j α β h)
    (Stacks.Descent.ofObj_hom_comp_pullbackCompHom M.obj _ _ _ rfl (S.totalMap_glue i j α β h))
    (Category.comp_id _)
    (pullbackCompHom_comp_pullbackCongr_symm _ _ _ (S.totalMap_glue i j α β h) M.obj) rfl
    (PolarizedFamily.comp_lineBundleIso_hom' _ _)

include hf S in
/-- **A descent datum of polarized families whose family of total spaces has descended to a
scheme is effective.** The polarizations descend along the morphisms to the descended scheme
(Stacks 023T); the descended module is invertible and relatively ample (Stacks 0D2P), so the
descended scheme carries a polarized family over `U`, and the morphisms to it from the members of
`D` are compatible with the gluing isomorphisms of `D`
(`AlgebraicGeometry.PolarizedDescentScheme.glue_toDescended`). -/
@[sga "1 VIII 5.10" "special case"]
theorem isEffective : D.IsEffective := by
  obtain ⟨M, ⟨E⟩⟩ := S.exists_iso_lineBundleDescentData hf
  refine D.isEffective_of_generators
    (⟨S.descendedFamily E hf, rfl⟩ : (polarizedProjection B).Fiber U) (S.toDescended E hf)
    (fun i => ?_) (fun i j => ?_)
  · have :=
      (polarizedProjection_isFiberedInGroupoids_unconditional (B := B)).isStronglyCartesian_homLift
        (f i) (S.toDescended E hf i)
    infer_instance
  · exact (Category.assoc _ _ _).symm.trans (S.glue_toDescended E hf i j _ _ _)

end PolarizedDescentScheme

end AlgebraicGeometry

end
