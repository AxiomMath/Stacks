module

public import StacksFrontier.AlgebraicGeometry.Quot.QuotToCoherentRepresentable
public import StacksFrontier.AlgebraicGeometry.Spaces.EtaleLocalGenerationBound

/-!
# The hypotheses of Stacks 08K6 for the relative Hom functors in the proof of Stacks 09TU

The proof of Stacks 09TU applies Stacks 08K6 to the relative Hom functor `Hom(F_T, 𝒢)` of every
object `(T, 𝒢)` of `Coh_{X/B}`. In a size-bounded big fppf site Stacks 08K6 asks the source module
to be étale-locally generated by fewer sections than the cutoff of the site
(`AlgebraicGeometry.Space.IsEtaleLocallyGeneratedBelow`); this file records that the source module
`F_T` of each of these Hom functors inherits that bound from `F`, and that the structure sheaf,
being of finite type, satisfies it — the case `F = 𝒪_X` of the Hilbert functor.

## Main results

* `AlgebraicGeometry.Space.QuotSituation.isEtaleLocallyGeneratedBelow_fibreHomSituation_F`: the
  source module of the relative Hom functor of an object of `Coh_{X/B}` is étale-locally generated
  by fewer than `κ` sections when `F` is.
* `AlgebraicGeometry.Space.isEtaleLocallyGeneratedBelow_structureSheafModule`: the structure sheaf
  is étale-locally generated by finitely many sections.

## References

* [Stacks Project, Tag 09TU](https://stacks.math.columbia.edu/tag/09TU)
* [Stacks Project, Tag 08K6](https://stacks.math.columbia.edu/tag/08K6)
-/

@[expose] public noncomputable section

open CategoryTheory Cardinal

universe u

attribute [local implicit_reducible] AlgebraicGeometry.Space.QuotSituation.toCoherentSituation

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- The structure sheaf of an algebraic space is étale-locally generated by finitely many
sections. -/
theorem isEtaleLocallyGeneratedBelow_structureSheafModule (X : AlgebraicSpaces B S hS) :
    IsEtaleLocallyGeneratedBelow B S hS ℵ₀ (structureSheafModule B S hS X) :=
  isEtaleLocallyGeneratedBelow_aleph0_of_isFiniteTypeOnSite X _
    (@SheafOfModules.isFiniteTypeOnSite_of_isFinitePresentationOnSite _ _ _ _ _
      (show (structureSheafModule B S hS X).IsFinitePresentationOnSite from
        SheafOfModules.isFinitePresentationOnSite_unit))

namespace QuotSituation

variable (D : QuotSituation B S hS)

/-- **The source module `F_T` of the relative Hom functor of an object `(T, 𝒢)` of `Coh_{X/B}`
inherits the bound on local generation of `F`**: it is the pullback of `F` along `X_T ⟶ X`. -/
theorem isEtaleLocallyGeneratedBelow_fibreHomSituation_F {κ : Cardinal.{u}}
    (hF : IsEtaleLocallyGeneratedBelow B S hS κ D.F)
    (A : CoherentObject D.toCoherentSituation) :
    IsEtaleLocallyGeneratedBelow B S hS κ (D.fibreHomSituation A).F :=
  hF.modulePullback (D.sourceProjection A.T)

end QuotSituation

end AlgebraicGeometry.Space

end
