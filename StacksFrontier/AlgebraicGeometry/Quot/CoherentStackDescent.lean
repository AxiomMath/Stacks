module

public import StacksFrontier.AlgebraicGeometry.Quot.CoherentStackDiagramDescent
public import StacksFrontier.AlgebraicGeometry.Quot.CoherentStackMorSheaf
public import StacksFrontier.CategoryTheory.Sites.Stack.SieveDescentDatumPairCocone

/-!
# Descent data for `Coh_{X/Y}` over an fpqc covering family are effective

Let `D` be the standing datum of Stacks 08KB and `p : Coh_{X/Y} ⟶ (Sch/S)_fppf` the projection.
This file proves the half of Stacks 08KC on descent data, for a covering family whose members,
read on algebraic spaces, form an fpqc covering.

A descent datum relative to the sieve generated by `{f l : V l ⟶ U}` provides the objects
`ξ_l` over the `V l`, the objects over the chosen pairwise and triple fibre products, and the
transports between them (`CategoryTheory.Functor.SieveDescentDatum.transportMap`), which are
cartesian over the projections of the fibre products.  These form a descent diagram
(`AlgebraicGeometry.Space.CoherentDescentDiagram`), whose cocone
(`AlgebraicGeometry.Space.CoherentDescentDiagram.exists_cocone`, which is where Stacks 04P2,
04W8, 05VY, 060V and 0422 enter) is an object over `U` receiving morphisms from the `ξ_l`
equalized on the pairwise fibre products: by
`CategoryTheory.Functor.SieveDescentDatum.isEffective_of_pairCocone` the descent datum is
effective.

## Main results

* `AlgebraicGeometry.Space.CoherentSituation.isEffective_of_isFpqcCovering`: a descent datum
  relative to the sieve generated by a family forming an fpqc covering is effective.

## References

* [Stacks Project, Tag 08KC](https://stacks.math.columbia.edu/tag/08KC)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe v u

attribute [local instance] AlgebraicGeometry.Space.pointTopology

/-- A cartesian square conjugated by identifications of its four corners is cartesian. -/
theorem CategoryTheory.IsPullback.of_eqToHom_conj {C : Type*} [Category C]
    {P X Y Z P' X' Y' Z' : C} (eP : P = P') (eX : X = X') (eY : Y = Y') (eZ : Z = Z')
    {a₁ : P' ⟶ X'} {a₂ : P' ⟶ Y'} {a₃ : X' ⟶ Z'} {a₄ : Y' ⟶ Z'} (h : IsPullback a₁ a₂ a₃ a₄) :
    IsPullback (eqToHom eP ≫ a₁ ≫ eqToHom eX.symm) (eqToHom eP ≫ a₂ ≫ eqToHom eY.symm)
      (eqToHom eX ≫ a₃ ≫ eqToHom eZ.symm) (eqToHom eY ≫ a₄ ≫ eqToHom eZ.symm) := by
  subst eP eX eY eZ
  simpa using h

/-- A cartesian square conjugated by identifications of three of its corners is cartesian. -/
theorem CategoryTheory.IsPullback.of_eqToHom_conj' {C : Type*} [Category C]
    {P X Y P' X' Y' Z : C} (eP : P = P') (eX : X = X') (eY : Y = Y')
    {a₁ : P' ⟶ X'} {a₂ : P' ⟶ Y'} {a₃ : X' ⟶ Z} {a₄ : Y' ⟶ Z} (h : IsPullback a₁ a₂ a₃ a₄) :
    IsPullback (eqToHom eP ≫ a₁ ≫ eqToHom eX.symm) (eqToHom eP ≫ a₂ ≫ eqToHom eY.symm)
      (eqToHom eX ≫ a₃) (eqToHom eY ≫ a₄) := by
  subst eP eX eY
  simpa using h

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace CoherentSituation

/-- The category structure of Stacks 08KB on `Coh_{X/Y}`, as a local instance. -/
@[instance_reducible]
def localCategory (D : CoherentSituation B S hS) : Category.{u + 1} (CoherentObject D) :=
  D.categoryData.category

attribute [local instance] localCategory

/-- The projection of `Coh_{X/Y}` to the site is fibred (Stacks 08W5), as a local instance. -/
theorem localIsFibered (D : CoherentSituation B S hS) :
    (coherentSiteProjection D.categoryData).IsFibered :=
  D.isFiberedInGroupoids_siteProjection.isFibered

attribute [local instance] localIsFibered

variable (D : CoherentSituation B S hS)

section Diagram

open Functor

variable {U : BigFppfOver B S hS} {L : Type v} {V : L → BigFppfOver B S hS}
  (f : ∀ l, V l ⟶ U)

local notation "𝒫" => coherentSiteProjection D.categoryData

/-- The membership of the members of a family in the sieve it generates. -/
theorem ofArrows_mem (l : L) : (Sieve.ofArrows V f).arrows (f l) := Sieve.ofArrows_mk V f l

/-- The membership of the first projection of a pairwise fibre product, followed by the member. -/
theorem ofArrows_mem₂ (l m : L) :
    (Sieve.ofArrows V f).arrows (pullback.fst (f l) (f m) ≫ f l) :=
  (Sieve.ofArrows V f).downward_closed (ofArrows_mem f l) _

/-- The arrow of a triple fibre product to the base. -/
abbrev tripleArrow (l m n : L) :
    pullback (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n)) ⟶ U :=
  pullback.fst _ _ ≫ pullback.fst (f l) (f m) ≫ f l

/-- The arrow of a triple fibre product to the base lies in the sieve generated by the family. -/
theorem ofArrows_mem₃ (l m n : L) : (Sieve.ofArrows V f).arrows (tripleArrow f l m n) :=
  (Sieve.ofArrows V f).downward_closed (ofArrows_mem₂ f l m) _

/-- The arrow of a triple fibre product to the base factors through its projection to the
fibre product of the last two factors. -/
theorem tripleArrow_eq₂₃ (l m n : L) :
    pullback.snd (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n)) ≫
      pullback.fst (f m) (f n) ≫ f m = tripleArrow f l m n := by
  rw [← Category.assoc, ← pullback.condition, Category.assoc, ← pullback.condition]

/-- The projections of a triple fibre product to the first and the last member agree over the
base. -/
theorem tripleLift_w (l m n : L) :
    (pullback.fst (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n)) ≫
        pullback.fst (f l) (f m)) ≫ f l =
      (pullback.snd (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n)) ≫
        pullback.snd (f m) (f n)) ≫ f n := by
  rw [Category.assoc, Category.assoc, ← pullback.condition (f := f m)]
  exact (tripleArrow_eq₂₃ f l m n).symm

/-- The arrow of a triple fibre product to the outer pairwise fibre product. -/
abbrev tripleLift (l m n : L) :
    pullback (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n)) ⟶ pullback (f l) (f n) :=
  pullback.lift _ _ (tripleLift_w f l m n)

/-- The arrow of a triple fibre product to the base factors through its arrow to the outer
pairwise fibre product. -/
theorem tripleArrow_eq₁₃ (l m n : L) :
    tripleLift f l m n ≫ pullback.fst (f l) (f n) ≫ f l = tripleArrow f l m n := by
  rw [← Category.assoc, pullback.lift_fst, Category.assoc]

variable {D}

/-- The transport of a descent datum depends only on the factorization. -/
theorem transportMap_congr
    (E : SieveDescentDatum 𝒫 (Sieve.ofArrows V f))
    {W W' : BigFppfOver B S hS} {g : W ⟶ U} (hg : (Sieve.ofArrows V f).arrows g)
    {g' : W' ⟶ U} (hg' : (Sieve.ofArrows V f).arrows g') (a a' : W' ⟶ W) (e : a = a')
    (ha : a ≫ g = g') (ha' : a' ≫ g = g') :
    E.transportMap hg hg' a ha = E.transportMap hg hg' a' ha' := by
  subst e
  rfl

/-- The base map of a morphism of `Coh_{X/Y}` lying over a morphism of the site. -/
theorem base_left_eq_of_isHomLift {x y : CoherentObject D} {R R' : BigFppfOver B S hS}
    (g : R ⟶ R') (φ : CoherentHom x y)
    [(𝒫).IsHomLift g φ] :
    φ.base.left = eqToHom (IsHomLift.domain_eq (𝒫) g φ) ≫ g ≫
      eqToHom (IsHomLift.codomain_eq (𝒫) g φ).symm :=
  IsHomLift.fac' (𝒫) g φ

section Datum

variable (E : SieveDescentDatum (coherentSiteProjection D.categoryData) (Sieve.ofArrows V f))

include E in
/-- The objects of the datum at the members lie over the members. -/
theorem obj_left (l : L) :
    (E.obj (f l) (ofArrows_mem f l)).1.T.left = V l :=
  (E.obj (f l) (ofArrows_mem f l)).2

/-- The transport to the first factor of a pairwise fibre product. -/
abbrev transport₁ (l m : L) :
    CoherentHom (E.obj _ (ofArrows_mem₂ f l m)).1 (E.obj (f l) (ofArrows_mem f l)).1 :=
  E.transportMap (ofArrows_mem f l) (ofArrows_mem₂ f l m) (pullback.fst (f l) (f m)) rfl

/-- The transport to the second factor of a pairwise fibre product. -/
abbrev transport₂ (l m : L) :
    CoherentHom (E.obj _ (ofArrows_mem₂ f l m)).1 (E.obj (f m) (ofArrows_mem f m)).1 :=
  E.transportMap (ofArrows_mem f m) (ofArrows_mem₂ f l m) (pullback.snd (f l) (f m))
    pullback.condition.symm

/-- The transport from a triple fibre product to the first two factors. -/
abbrev transport₁₂ (l m n : L) :
    CoherentHom (E.obj _ (ofArrows_mem₃ f l m n)).1 (E.obj _ (ofArrows_mem₂ f l m)).1 :=
  E.transportMap (ofArrows_mem₂ f l m) (ofArrows_mem₃ f l m n) (pullback.fst _ _) rfl

/-- The transport from a triple fibre product to the last two factors. -/
abbrev transport₂₃ (l m n : L) :
    CoherentHom (E.obj _ (ofArrows_mem₃ f l m n)).1 (E.obj _ (ofArrows_mem₂ f m n)).1 :=
  E.transportMap (ofArrows_mem₂ f m n) (ofArrows_mem₃ f l m n) (pullback.snd _ _)
    (tripleArrow_eq₂₃ f l m n)

/-- The transport from a triple fibre product to the outer two factors. -/
abbrev transport₁₃ (l m n : L) :
    CoherentHom (E.obj _ (ofArrows_mem₃ f l m n)).1 (E.obj _ (ofArrows_mem₂ f l n)).1 :=
  E.transportMap (ofArrows_mem₂ f l n) (ofArrows_mem₃ f l m n) (tripleLift f l m n)
    (tripleArrow_eq₁₃ f l m n)

/-- The transport of a descent datum lies over the factorization. -/
private instance isHomLift_transportMap {X Y : BigFppfOver B S hS} {x : X ⟶ U} (hx : _)
    {y : Y ⟶ U} (hy : _) (a : Y ⟶ X) (ha : a ≫ x = y) :
    (𝒫).IsHomLift a (E.transportMap hx hy a ha) :=
  E.transportMap_isHomLift hx hy a ha

/-- The base maps of the two transports out of a pairwise fibre product form a cartesian square
over the members. -/
theorem isPullback_transport (l m : L) :
    IsPullback (transport₁ f E l m).base.left (transport₂ f E l m).base.left
      (eqToHom (obj_left f E l) ≫ f l) (eqToHom (obj_left f E m) ≫ f m) := by
  rw [base_left_eq_of_isHomLift (pullback.fst (f l) (f m)) (transport₁ f E l m),
    base_left_eq_of_isHomLift (pullback.snd (f l) (f m)) (transport₂ f E l m)]
  exact IsPullback.of_eqToHom_conj' _ _ _ (IsPullback.of_hasPullback (f l) (f m))

/-- The base maps of the transports from a triple fibre product to the first two and to the last
two factors form a cartesian square over the transports to the middle member. -/
theorem isPullback_transport₃ (l m n : L) :
    IsPullback (transport₁₂ f E l m n).base.left (transport₂₃ f E l m n).base.left
      (transport₂ f E l m).base.left (transport₁ f E m n).base.left := by
  rw [base_left_eq_of_isHomLift
      (pullback.fst (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n))) (transport₁₂ f E l m n),
    base_left_eq_of_isHomLift
      (pullback.snd (pullback.snd (f l) (f m)) (pullback.fst (f m) (f n))) (transport₂₃ f E l m n),
    base_left_eq_of_isHomLift (pullback.snd (f l) (f m)) (transport₂ f E l m),
    base_left_eq_of_isHomLift (pullback.fst (f m) (f n)) (transport₁ f E m n)]
  exact IsPullback.of_eqToHom_conj _ _ _ (obj_left f E m) (IsPullback.of_hasPullback _ _)

/-- Two composites of transports with the same source and target agree when the composites of
the factorizations do. -/
private theorem transport_comp_eq {X Y Y' Z : BigFppfOver B S hS} {x : X ⟶ U} {y : Y ⟶ U}
    {y' : Y' ⟶ U} {z : Z ⟶ U} (hx : (Sieve.ofArrows V f).arrows x)
    (hy : (Sieve.ofArrows V f).arrows y) (hy' : (Sieve.ofArrows V f).arrows y')
    (hz : (Sieve.ofArrows V f).arrows z) (a : Y ⟶ X) (a' : Z ⟶ Y) (c : Y' ⟶ X) (c' : Z ⟶ Y')
    (ha : a ≫ x = y) (ha' : a' ≫ y = z) (hc : c ≫ x = y') (hc' : c' ≫ y' = z)
    (h : a' ≫ a = c' ≫ c) :
    (E.transportMap hy hz a' ha').comp (E.transportMap hx hy a ha) =
      (E.transportMap hy' hz c' hc').comp (E.transportMap hx hy' c hc) :=
  (E.transportMap_comp _ _ _ _ _ _ _).trans ((transportMap_congr f E _ _ _ _ h _ _).trans
    (E.transportMap_comp _ _ _ _ _ _ _).symm)

/-- The transports from a triple fibre product to the first member, through the first two and
through the outer two factors, agree. -/
theorem transport_comp₁ (l m n : L) :
    (transport₁₂ f E l m n).comp (transport₁ f E l m) =
      (transport₁₃ f E l m n).comp (transport₁ f E l n) :=
  transport_comp_eq f E _ _ _ _ _ _ _ _ _ _ _ _ (pullback.lift_fst _ _ _).symm

/-- The transports from a triple fibre product to the middle member, through the first two and
through the last two factors, agree. -/
theorem transport_comp₂ (l m n : L) :
    (transport₁₂ f E l m n).comp (transport₂ f E l m) =
      (transport₂₃ f E l m n).comp (transport₁ f E m n) :=
  transport_comp_eq f E _ _ _ _ _ _ _ _ _ _ _ _ pullback.condition

/-- The transports from a triple fibre product to the last member, through the last two and
through the outer two factors, agree. -/
theorem transport_comp₃ (l m n : L) :
    (transport₂₃ f E l m n).comp (transport₂ f E m n) =
      (transport₁₃ f E l m n).comp (transport₂ f E l n) :=
  transport_comp_eq f E _ _ _ _ _ _ _ _ _ _ _ _ (pullback.lift_snd _ _ _).symm

/-- **The descent diagram of a descent datum.**  The objects of the datum at the members of the
family, at the first projections of the chosen pairwise fibre products and at the chosen triple
fibre products, with the transports between them. -/
def descentDiagram : CoherentDescentDiagram D U L where
  P l := (E.obj (f l) (ofArrows_mem f l)).1
  fP l := eqToHom (obj_left f E l) ≫ f l
  Q l m := (E.obj _ (ofArrows_mem₂ f l m)).1
  c := transport₁ f E
  e := transport₂ f E
  sq₂ := isPullback_transport f E
  T l m n := (E.obj _ (ofArrows_mem₃ f l m n)).1
  b₁₂ := transport₁₂ f E
  b₂₃ := transport₂₃ f E
  b₁₃ := transport₁₃ f E
  sq₃ := isPullback_transport₃ f E
  hc₁ := transport_comp₁ f E
  hc₂ := transport_comp₂ f E
  hc₃ := transport_comp₃ f E

end Datum

/-- A descent datum for `Coh_{X/Y}` relative to the sieve generated by a covering family whose
members, read on algebraic spaces, form an fpqc covering is effective. -/
theorem isEffective_of_isFpqcCovering
    (hcov : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (hfpqc : IsFpqcCovering B S hS fun l => ((schemeSpaceFunctor B S hS).map (f l)).hom)
    (E : SieveDescentDatum 𝒫 (Sieve.ofArrows V f)) :
    E.IsEffective := by
  let Δ := descentDiagram f E
  have heP : ∀ l, (Δ.P l).T.left = V l := obj_left f E
  have hsieve : Sieve.ofArrows (fun l => (Δ.P l).T.left) Δ.fP ∈
      BigFppfOver.topology B S hS U := by
    refine (BigFppfOver.topology B S hS).superset_covering (fun W g hg => ?_) hcov
    obtain ⟨l, a, rfl⟩ := Functor.exists_factorization_of_ofArrows hg
    refine (Sieve.mem_ofArrows_iff _ _ _).2 ⟨l, a ≫ eqToHom (heP l).symm, ?_⟩
    show a ≫ f l = (a ≫ eqToHom (heP l).symm) ≫ eqToHom (heP l) ≫ f l
    simp
  have hfpqc' : IsFpqcCovering B S hS fun l => ((schemeSpaceFunctor B S hS).map (Δ.fP l)).hom := by
    have key : ∀ (W : L → BigFppfOver B S hS) (e : ∀ l, W l = V l),
        IsFpqcCovering B S hS fun l =>
          ((schemeSpaceFunctor B S hS).map (eqToHom (e l) ≫ f l)).hom := by
      intro W e
      obtain rfl : W = V := funext e
      simpa using hfpqc
    exact key _ heP
  obtain ⟨A, hA, ζ, hζb, hζc⟩ := Δ.exists_cocone hsieve hfpqc'
  refine SieveDescentDatum.isEffective_of_pairCocone f D.isFiberedInGroupoids_siteProjection E
    ⟨A, hA⟩ ζ (fun l => ?_) hζc
  refine IsHomLift.of_fac' (p := coherentSiteProjection D.categoryData) _ _ (heP l) hA ?_
  show (ζ l).base.left = _
  rw [hζb l]
  exact Category.assoc _ _ _

end Diagram

end CoherentSituation

end AlgebraicGeometry.Space

end
