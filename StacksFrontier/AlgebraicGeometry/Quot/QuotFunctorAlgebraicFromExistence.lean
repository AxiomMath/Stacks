module

public import StacksFrontier.AlgebraicGeometry.Quot.CoherentStackAlgebraic
public import StacksFrontier.AlgebraicGeometry.Quot.QuotFibreHomSizeBound
public import StacksFrontier.AlgebraicGeometry.Quot.QuotFunctorLimitPreserving
public import StacksFrontier.AlgebraicGeometry.Quot.QuotToCoherentRepresentable

/-!
# The Quot functor is an algebraic space, given Grothendieck's existence theorem (Stacks 09TU)

Let `f : X ⟶ B` be a morphism of algebraic spaces over a scheme `S` which is of finite
presentation and separated, and `F` a quasi-coherent `𝒪_X`-module. Stacks 09TU says that
`Quot_{F/X/B}` is an algebraic space, locally of finite presentation over `B` when `F` is of
finite presentation. This file proves both assertions with Grothendieck's existence theorem for
algebraic spaces (Stacks 0CXB) as the only hypothesis, `h0CXB`:

* the 1-morphism `Quot_{F/X/B} ⟶ Coh_{X/B}` is representable by algebraic spaces once the relative
  Hom functors `Hom(F_T, 𝒢)` are algebraic spaces
  (`AlgebraicGeometry.Space.QuotSitePresheafModel.isAlgebraicSpace_of_homRepresentations`), and
  they are, by the first assertion of Stacks 08K6
  (`AlgebraicGeometry.Space.HomSituation.isAffineAlgebraicSpaceOverBase_of_finitePresentation`);
* `Coh_{X/B}` is an algebraic stack by Stacks 09DS, which is
  `AlgebraicGeometry.Space.CoherentSituation.isAlgebraicStack_coherentCFG_of_existence` from
  `h0CXB`;
* the second assertion follows from the first by
  `AlgebraicGeometry.Space.QuotSitePresheafModel.isLocallyOfFinitePresentation_toBase`.

## Main results

* `AlgebraicGeometry.Space.QuotSituation.isAlgebraicSpace_quotSitePresheafModel_of_existence`:
  the first assertion of Stacks 09TU, for `F` étale-locally generated by fewer than `μ` sections
  with `μ` below the cutoff of the site, from Stacks 0CXB.
* `AlgebraicGeometry.Space.QuotSituation.isLocallyOfFinitePresentation_toBase_of_existence`:
  the second assertion of Stacks 09TU, for `F` of finite presentation, from Stacks 0CXB.

Neither carries an `@[stacks]` attribute: their hypothesis `h0CXB` is the conclusion of
Stacks 0CXB.

## Implementation notes

**The first assertion is stated for `F` étale-locally generated by fewer than `μ` sections, `μ`
below the cutoff of the site.** On the size-bounded site the assertion for an arbitrary
quasi-coherent `F` fails for the reason the first assertion of Stacks 08K6 does
(`AlgebraicGeometry.Space.not_forall_isAffineAlgebraicSpaceOverBase`): for `X = B = Spec k` and
`F = 𝒪^{⊕ I}` with `#I` at least the cutoff, the rank one quotients of `F` form the projective
space on `I`, whose charts `Spec k[x_i : i ∈ I]` have residue fields of cardinality `#I`, so no
étale atlas by schemes of the site exists. Every `F` of finite type satisfies the bound
(`AlgebraicGeometry.Space.exists_isEtaleLocallyGeneratedBelow_lt_cutoff_of_isFiniteTypeOnSite`),
which covers every application of Stacks 09TU in the source, among them 0D01 for `𝒪_X`.

## References

* [Stacks Project, Tag 09TU](https://stacks.math.columbia.edu/tag/09TU)
* [Stacks Project, Tag 09DS](https://stacks.math.columbia.edu/tag/09DS)
* [Stacks Project, Tag 08K6](https://stacks.math.columbia.edu/tag/08K6)
* [Stacks Project, Tag 0CXB](https://stacks.math.columbia.edu/tag/0CXB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.GrothendieckExistence (limitBase baseAt)

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

attribute [local implicit_reducible] AlgebraicGeometry.Space.QuotSituation.toCoherentSituation

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace QuotSituation

variable (D : QuotSituation B S hS)

/-- **The relative Hom functor `Hom(F_T, 𝒢)` of an object `(T, 𝒢)` of `Coh_{X/B}` is an algebraic
space**, by the first assertion of Stacks 08K6, when `F` is étale-locally generated by fewer than
`μ` sections with `μ` below the cutoff of the site. -/
theorem hasHomRepresentation_of_isEtaleLocallyGeneratedBelow
    (hF : ∃ μ < B.cutoff, IsEtaleLocallyGeneratedBelow B S hS μ D.F)
    (A : CoherentObject D.toCoherentSituation) : D.HasHomRepresentation A := by
  obtain ⟨μ, hμ, hgen⟩ := hF
  obtain ⟨_, hU, hP⟩ := A.properSupport
  obtain ⟨H, p, -, hc⟩ :=
    (D.fibreHomSituation A).isAffineAlgebraicSpaceOverBase_of_finitePresentation
      (modulePushforwardCoherence B S hS)
      (D.toCoherentSituation.isFinitePresentation_projection A.T) A.finitePresentation A.flat
      ⟨hU, hP⟩ ⟨μ, hμ, D.isEtaleLocallyGeneratedBelow_fibreHomSituation_F hgen A⟩
  exact ⟨H, p, hc⟩

/-- **Stacks 09TU, the first assertion, from Stacks 0CXB.** Let `f : X ⟶ B` be a morphism of
algebraic spaces over `S` which is of finite presentation (a field of the standing datum `D` of
Situation 09TR) and separated, and let `F` be a quasi-coherent `𝒪_X`-module étale-locally generated
by fewer than `μ` sections for some `μ` below the cutoff of the site (for instance `F` of finite
type). Then every model of `Quot_{F/X/B}` in the universe of the site is an algebraic space, given
Grothendieck's existence theorem for algebraic spaces, Stacks 0CXB (`h0CXB`): in Situation 0CX4
there is a finitely presented module on `X`, flat over `A`, with support proper over `A`,
restricting to the `Fₙ` compatibly with the `φₙ`. A model exists by
`AlgebraicGeometry.Space.QuotSituation.exists_quotSitePresheafModel`. -/
theorem isAlgebraicSpace_quotSitePresheafModel_of_existence
    (hsep : IsSeparated B S hS D.f.hom)
    (hF : ∃ μ < B.cutoff, IsEtaleLocallyGeneratedBelow B S hS μ D.F)
    (h0CXB : ∀ s : InverseSystemExistenceSituation.{u},
      ∃ F : Modules.{u, u} s.B (limitBase s.system) s.containsLimitBase s.X.left.1 s.X.left.2,
          F.IsFinitePresentationOnSite ∧
            IsFlatOver s.B (limitBase s.system) s.containsLimitBase s.X.left.2 s.X.hom.hom F ∧
            ∃ hcl : IsClosed (supportOfSheaf s.B (limitBase s.system) s.containsLimitBase s.X.left.1
                ((SheafOfModules.toSheaf _).obj F)),
              IsProperOver s.B (limitBase s.system) s.containsLimitBase s.X.left.2
                (schemeSpace (limitBaseObject s.system s.B s.containsLimitBase)).2 s.X.hom.hom
                (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation s.B (limitBase s.system)
                  s.containsLimitBase s.finitePresentation.1)
                (supportOfSheaf s.B (limitBase s.system) s.containsLimitBase s.X.left.1
                  ((SheafOfModules.toSheaf _).obj F)) hcl ∧
              ∃ α : ∀ n : ℕ, (modulePullback s.B (limitBase s.system) s.containsLimitBase
                  (spaceProjection s.system s.B s.containsLimitBase s.containsBaseAt s.X n)).obj F ≅
                    (s.sheaf n).obj,
                ∀ n : ℕ,
                  (modulePullback s.B (limitBase s.system) s.containsLimitBase
                      (transitionSpace s.system s.B s.containsLimitBase s.containsBaseAt s.X n)).map
                        (α (n + 1)).hom ≫ (s.φ n).hom =
                    (modulePullbackCompIso s.B (limitBase s.system) s.containsLimitBase
                        (transitionSpace s.system s.B s.containsLimitBase s.containsBaseAt s.X n)
                        (spaceProjection s.system s.B s.containsLimitBase s.containsBaseAt s.X
                          (n + 1))).hom.app F ≫
                      eqToHom (congrArg (fun g => (modulePullback s.B (limitBase s.system)
                        s.containsLimitBase g).obj F)
                        (transitionSpace_spaceProjection s.system s.B s.containsLimitBase
                          s.containsBaseAt s.X n)) ≫
                      (α n).hom)
    (N : QuotSitePresheafModel D) :
    IsAlgebraicSpace B S hS N.presheaf :=
  N.isAlgebraicSpace_of_homRepresentations.{u, u}
    (D.hasHomRepresentation_of_isEtaleLocallyGeneratedBelow hF)
    (D.toCoherentSituation.isAlgebraicStack_coherentCFG_of_existence.{u, u} hsep h0CXB)

/-- **Stacks 09TU, the second assertion, from Stacks 0CXB.** Let `f : X ⟶ B` be of finite
presentation and separated and `F` a quasi-coherent `𝒪_X`-module of finite presentation. Then
every model of `Quot_{F/X/B}` in the universe of the site is an algebraic space whose morphism to
`B` is locally of finite presentation, given Grothendieck's existence theorem for algebraic spaces,
Stacks 0CXB (`h0CXB`, as in
`AlgebraicGeometry.Space.QuotSituation.isAlgebraicSpace_quotSitePresheafModel_of_existence`). -/
theorem isLocallyOfFinitePresentation_toBase_of_existence
    (hsep : IsSeparated B S hS D.f.hom) (hF : D.F.IsFinitePresentationOnSite)
    (h0CXB : ∀ s : InverseSystemExistenceSituation.{u},
      ∃ F : Modules.{u, u} s.B (limitBase s.system) s.containsLimitBase s.X.left.1 s.X.left.2,
          F.IsFinitePresentationOnSite ∧
            IsFlatOver s.B (limitBase s.system) s.containsLimitBase s.X.left.2 s.X.hom.hom F ∧
            ∃ hcl : IsClosed (supportOfSheaf s.B (limitBase s.system) s.containsLimitBase s.X.left.1
                ((SheafOfModules.toSheaf _).obj F)),
              IsProperOver s.B (limitBase s.system) s.containsLimitBase s.X.left.2
                (schemeSpace (limitBaseObject s.system s.B s.containsLimitBase)).2 s.X.hom.hom
                (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation s.B (limitBase s.system)
                  s.containsLimitBase s.finitePresentation.1)
                (supportOfSheaf s.B (limitBase s.system) s.containsLimitBase s.X.left.1
                  ((SheafOfModules.toSheaf _).obj F)) hcl ∧
              ∃ α : ∀ n : ℕ, (modulePullback s.B (limitBase s.system) s.containsLimitBase
                  (spaceProjection s.system s.B s.containsLimitBase s.containsBaseAt s.X n)).obj F ≅
                    (s.sheaf n).obj,
                ∀ n : ℕ,
                  (modulePullback s.B (limitBase s.system) s.containsLimitBase
                      (transitionSpace s.system s.B s.containsLimitBase s.containsBaseAt s.X n)).map
                        (α (n + 1)).hom ≫ (s.φ n).hom =
                    (modulePullbackCompIso s.B (limitBase s.system) s.containsLimitBase
                        (transitionSpace s.system s.B s.containsLimitBase s.containsBaseAt s.X n)
                        (spaceProjection s.system s.B s.containsLimitBase s.containsBaseAt s.X
                          (n + 1))).hom.app F ≫
                      eqToHom (congrArg (fun g => (modulePullback s.B (limitBase s.system)
                        s.containsLimitBase g).obj F)
                        (transitionSpace_spaceProjection s.system s.B s.containsLimitBase
                          s.containsBaseAt s.X n)) ≫
                      (α n).hom)
    (N : QuotSitePresheafModel D) :
    IsAlgebraicSpace B S hS N.presheaf ∧ IsLocallyOfFinitePresentation B S hS N.toBase :=
  have hN := D.isAlgebraicSpace_quotSitePresheafModel_of_existence hsep
    (exists_isEtaleLocallyGeneratedBelow_lt_cutoff_of_isFiniteTypeOnSite D.X D.F
      (@SheafOfModules.isFiniteTypeOnSite_of_isFinitePresentationOnSite _ _ _ _ _ hF))
    h0CXB N
  ⟨hN, N.isLocallyOfFinitePresentation_toBase hN hF⟩

end QuotSituation

end AlgebraicGeometry.Space

end
