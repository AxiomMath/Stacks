/-!
# Effectivity of formal curves: representability of the levels and flatness from thickenings

The second part of the tower of rebased levels (local Noetherianity, absolute separatedness,
dimension at most one, properness of the closed level, representability of every level), followed
by flatness from the adic thickenings, fibre-dimension bounds, Yoneda transfers, isomorphisms of
formal objects from their components, and the comparison of represented pullbacks with scheme
pullbacks.

The file `StacksFrontier/AlgebraicGeometry/Quot/CurvesFormalEffective.lean` re-exports this part. -/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits IsLocalRing Cardinal

namespace AlgebraicGeometry

universe u v w

attribute [local instance] MorphismProperty.IsStableUnderBaseChange.respectsIso
  MorphismProperty.RespectsIso.inverseImage
  MorphismProperty.IsMultiplicative.toContainsIdentities
  MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  MorphismProperty.IsStableUnderComposition.inverseImage
  MorphismProperty.relative_isStableUnderComposition
  MorphismProperty.relative_isMultiplicative
  CategoryTheory.Functor.map_isIso

section Tower

variable (B : AlgebraicGeometry.BigFppfSite.{u})
  (hZ : B.Contains AlgebraicGeometry.integerBase)
  (ξ : Deformation.Artin.FormalObject B AlgebraicGeometry.integerBase hZ
    (curvesProjectionOver B hZ))
  (hA : B.Contains (Spec (.of ξ.base.R)))

/-- The spectrum of the `(n + 1)`-st adic thickening of a Noetherian local ring is locally
Noetherian. -/
private theorem isLocallyNoetherian_spec_adicQuotient (A : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] (n : ℕ) :
    IsLocallyNoetherian (Spec (.of (A ⧸ maximalIdeal A ^ (n + 1)))) :=
  isLocallyNoetherian_Spec.mpr inferInstance

/-- An algebraic space of locally finite type over a representable one with locally Noetherian
scheme has the étale-local property of being locally Noetherian. -/
private theorem hasEtaleLocalProperty_isLocallyNoetherian_of_locallyOfFiniteType
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F)
    (T : AlgebraicGeometry.BigFppfOver B S hS) (q : F ⟶ yoneda.obj T)
    (hq : AlgebraicGeometry.Space.IsLocallyOfFiniteType B S hS q)
    (hT : IsLocallyNoetherian ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).obj T)) :
    AlgebraicGeometry.Space.HasEtaleLocalProperty B S hS F
      (fun X : Scheme.{u} => IsLocallyNoetherian X) :=
  AlgebraicGeometry.Space.isLocallyNoetherian_of_isLocallyOfFiniteType B S hS hF
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS T) q hq
    ((AlgebraicGeometry.Space.exists_atlas_iff_of_representable B S hS (yoneda.obj T)
      (fun X : Scheme.{u} => IsLocallyNoetherian X) T (Iso.refl _)).2 hT)

private theorem level_isLocallyNoetherian (n : ℕ) :
    AlgebraicGeometry.Space.HasEtaleLocalProperty B AlgebraicGeometry.integerBase hZ
      (ξ.level n).total.1 (fun X : Scheme.{u} => IsLocallyNoetherian X) := by
  refine hasEtaleLocalProperty_isLocallyNoetherian_of_locallyOfFiniteType B
    AlgebraicGeometry.integerBase hZ (ξ.level n).total.property (ξ.level n).base
    (ξ.level n).toBase.hom
    (isLocallyOfFiniteType_of_finitePresentation B AlgebraicGeometry.integerBase hZ
      (ξ.level n).finitePresentation) ?_
  change IsLocallyNoetherian
    (((curvesProjectionOver B hZ).obj (ξ.level n)).left.1)
  rw [ξ.level_eq n]
  let : IsNoetherianRing ξ.base.R := ξ.base.noetherian
  exact isLocallyNoetherian_spec_adicQuotient _ n

private theorem rebasedLevel_isLocallyNoetherian (n : ℕ) :
    AlgebraicGeometry.Space.HasEtaleLocalProperty B (Spec (.of ξ.base.R)) hA
      (rebasedLevel B hZ ξ hA n)
      (fun X : Scheme.{u} => IsLocallyNoetherian X) := by
  refine hasEtaleLocalProperty_isLocallyNoetherian_of_locallyOfFiniteType B
    (Spec (.of ξ.base.R)) hA (rebasedLevel_isAlgebraicSpace B hZ ξ hA n)
    (thickeningOver B hZ ξ hA n) (rebasedLevelProjection B hZ ξ hA n)
    (rebasedLevel_isLocallyOfFiniteType B hZ ξ hA n) ?_
  let : IsNoetherianRing ξ.base.R := ξ.base.noetherian
  exact isLocallyNoetherian_spec_adicQuotient _ n

private theorem closedLevel_dimension_le_one :
    AlgebraicGeometry.Space.dimension B AlgebraicGeometry.integerBase hZ
      (ξ.level 0).total.1 (ξ.level 0).total.property ≤ 1 := by
  let k := ξ.base.R ⧸ maximalIdeal ξ.base.R ^ (0 + 1)
  have : (maximalIdeal ξ.base.R ^ (0 + 1)).IsMaximal := by
    simpa only [zero_add, pow_one] using (maximalIdeal.isMaximal ξ.base.R)
  let : Field k := Ideal.Quotient.field _
  let p : AlgebraicGeometry.Space.FieldValuedPoint B AlgebraicGeometry.integerBase hZ
      (yoneda.obj (ξ.level 0).base) := {
    carrier := k
    contained := ξ.contains 0
    toBase := ξ.base.truncationToS 0
    value := eqToHom (ξ.level_eq 0).symm }
  let f : (ξ.level 0).total.1 ⟶ yoneda.obj (ξ.level 0).base :=
    (ξ.level 0).toBase.hom
  let a := yonedaEquiv.symm p.value
  have : IsIso a := by
    change IsIso (yoneda.map (eqToHom (ξ.level_eq 0).symm))
    infer_instance
  have : IsIso (pullback.snd a f) := inferInstance
  have hP := AlgebraicGeometry.isAlgebraicSpace_pullback B AlgebraicGeometry.integerBase hZ a f
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B AlgebraicGeometry.integerBase hZ
      (p.siteObject B AlgebraicGeometry.integerBase hZ _))
    (ξ.level 0).total.property
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B AlgebraicGeometry.integerBase hZ (ξ.level 0).base)
  rw [← dimension_eq_of_iso B AlgebraicGeometry.integerBase hZ hP (ξ.level 0).total.property
    (asIso (pullback.snd a f))]
  rw [← (AlgebraicGeometry.Space.fiberDimension_eq_dimension_pullback B
    AlgebraicGeometry.integerBase hZ f (ξ.level 0).total.property
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B AlgebraicGeometry.integerBase hZ (ξ.level 0).base)
    (ξ.level 0).proper.2.1 p).1]
  exact fiberDimension_le_of_relativeDimensionLE B AlgebraicGeometry.integerBase hZ f 1
    (ξ.level 0).relativeDimensionLE _

private theorem level_isAbsolutelySeparated (n : ℕ) :
    AlgebraicGeometry.Space.IsAbsolutelySeparated B AlgebraicGeometry.integerBase hZ
      (terminal_mem_of_integerBase_mem B hZ) (ξ.level n).total.1 := by
  apply AlgebraicGeometry.Space.isAbsolutelySeparated_of_isSeparated B
    AlgebraicGeometry.integerBase hZ (terminal_mem_of_integerBase_mem B hZ)
    (f := (ξ.level n).toBase.hom)
  · apply isSeparated_yoneda_of_isSeparated
    change (((curvesProjectionOver B hZ).obj (ξ.level n)).left.1).IsSeparated
    rw [ξ.level_eq n]
    change (Spec (.of (ξ.base.R ⧸ maximalIdeal ξ.base.R ^ (n + 1)))).IsSeparated
    infer_instance
  · exact (ξ.level n).proper.1

private theorem closedLevel_isRepresentable
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u}) :
    (ξ.level 0).total.1.IsRepresentable :=
  isRepresentable_of_separated_locallyNoetherian_dimension_le_one
    h0ADD B AlgebraicGeometry.integerBase hZ (terminal_mem_of_integerBase_mem B hZ)
    (ξ.level 0).total.1 (ξ.level 0).total.property
    (level_isAbsolutelySeparated B hZ ξ 0) (level_isLocallyNoetherian B hZ ξ 0)
    (closedLevel_dimension_le_one B hZ ξ)

private theorem rebasedClosedLevel_dimension_le_one :
    AlgebraicGeometry.Space.dimension B (Spec (.of ξ.base.R)) hA
      (rebasedLevel B hZ ξ hA 0) (rebasedLevel_isAlgebraicSpace B hZ ξ hA 0) ≤ 1 :=
  (dimension_rebase_le B AlgebraicGeometry.integerBase (Spec (.of ξ.base.R)) hZ hA
    (completeBaseArrow B hZ ξ hA) (levelOverCompleteBase B hZ ξ hA 0)
    (ξ.level 0).total.property (rebasedLevel_isAlgebraicSpace B hZ ξ hA 0)).trans
    (closedLevel_dimension_le_one B hZ ξ)

/-- **Every level of the tower has dimension at most one.** The transition `X_n ⟶ X_{n+1}` is
the base change of the closed immersion `Spec(A/𝔪^{n+1}) ⟶ Spec(A/𝔪^{n+2})`, which is a
surjective integral morphism, so it preserves the dimension (Stacks 0EDB), and the closed level
has dimension at most one. -/
private theorem rebasedLevel_dimension_le_one (n : ℕ) :
    AlgebraicGeometry.Space.dimension B (Spec (.of ξ.base.R)) hA
      (rebasedLevel B hZ ξ hA n) (rebasedLevel_isAlgebraicSpace B hZ ξ hA n) ≤ 1 := by
  induction n with
  | zero => exact rebasedClosedLevel_dimension_le_one B hZ ξ hA
  | succ n ih =>
    have hsq := (rebasedLevel_isPullback B hZ ξ hA n).flip
    have hT (m : ℕ) := AlgebraicGeometry.isAlgebraicSpace_yoneda B (Spec (.of ξ.base.R)) hA
      (thickeningOver B hZ ξ hA m)
    have hint : AlgebraicGeometry.Space.IsIntegralHom B (Spec (.of ξ.base.R)) hA
        (yoneda.map (thickeningTransition B hZ ξ hA n)) :=
      AlgebraicGeometry.Space.isIntegralHom_yoneda_map B _ hA _
        (show _root_.AlgebraicGeometry.IsIntegralHom
          (adicThickeningSucc ξ.base.R (maximalIdeal ξ.base.R) n) from inferInstance)
    have hsurj : AlgebraicGeometry.Space.IsSurjective B (Spec (.of ξ.base.R)) hA
        (yoneda.map (thickeningTransition B hZ ξ hA n)) :=
      AlgebraicGeometry.Space.isSurjective_yoneda_map B _ hA _
        (show _root_.AlgebraicGeometry.Surjective
          (adicThickeningSucc ξ.base.R (maximalIdeal ξ.base.R) n) from inferInstance)
    rw [← AlgebraicGeometry.Space.dimension_eq_of_isIntegralHom_of_isSurjective B _ hA
      (rebasedLevel_isAlgebraicSpace B hZ ξ hA n) (rebasedLevel_isAlgebraicSpace B hZ ξ hA (n + 1))
      (rebasedLevelTransition B hZ ξ hA n)
      (AlgebraicGeometry.Space.isIntegralHom_of_isPullback B _ hA hsq hint)
      (AlgebraicGeometry.Space.isSurjective_of_isPullback_presheaf (hT n)
        (rebasedLevel_isAlgebraicSpace B hZ ξ hA (n + 1)) (hT (n + 1)) hsq hsurj)]
    exact ih

private theorem rebasedClosedLevel_isProper
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u}) :
    AlgebraicGeometry.Space.IsProper B (Spec (.of ξ.base.R)) hA
      (rebasedLevelProjection B hZ ξ hA 0) := by
  have := closedLevel_isRepresentable B hZ ξ h0ADD
  let P := MorphismProperty.inverseImage (@IsProper.{u}) B.inclusion
  have hrep := relativelyRepresentable_of_representable_source B AlgebraicGeometry.integerBase hZ
    (ξ.level 0).toBase.hom
  have hproper := (isProper_iff_presheaf B AlgebraicGeometry.integerBase hZ
    (ξ.level 0).total.property
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B AlgebraicGeometry.integerBase hZ (ξ.level 0).base)
    (ξ.level 0).toBase.hom hrep).mp (ξ.level 0).proper
  have hproj : (P.inverseImage (Over.forget (B.obj hZ))).presheaf
      (levelOverCompleteBaseProjection B hZ ξ hA 0).left :=
    MorphismProperty.RespectsIso.postcomp _
      (yoneda.map (levelBaseIso B hZ ξ hA 0).hom) _ hproper
  have hreb := Rebase.relative_rebase (completeBaseArrow B hZ ξ hA) P
    (levelOverCompleteBaseProjection B hZ ξ hA 0) hproj
  have hq : (P.inverseImage (Over.forget (B.obj hA))).presheaf
      (rebasedLevelProjection B hZ ξ hA 0) :=
    MorphismProperty.RespectsIso.postcomp _
      (Rebase.representedRebaseIso (completeBaseArrow B hZ ξ hA)
        (thickeningOver B hZ ξ hA 0)).hom _ hreb
  exact (isProper_iff_presheaf B (Spec (.of ξ.base.R)) hA
    (rebasedLevel_isAlgebraicSpace B hZ ξ hA 0)
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B (Spec (.of ξ.base.R)) hA
      (thickeningOver B hZ ξ hA 0)) (rebasedLevelProjection B hZ ξ hA 0) hq.rep).mpr hq

private theorem rebasedLevel_isAbsolutelySeparated (n : ℕ) :
    AlgebraicGeometry.Space.IsAbsolutelySeparated B (Spec (.of ξ.base.R)) hA
      (terminal_mem_of_integerBase_mem B hZ) (rebasedLevel B hZ ξ hA n) := by
  apply AlgebraicGeometry.Space.isAbsolutelySeparated_of_isSeparated B (Spec (.of ξ.base.R)) hA
    (terminal_mem_of_integerBase_mem B hZ) (f := rebasedLevelProjection B hZ ξ hA n)
  · apply isSeparated_yoneda_of_isSeparated
    change (Spec (.of (ξ.base.R ⧸ maximalIdeal ξ.base.R ^ (n + 1)))).IsSeparated
    infer_instance
  · exact rebasedLevel_isSeparated B hZ ξ hA n

private theorem rebasedLevel_isRepresentable_of_dimension_le_one
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u}) (n : ℕ)
    (hsep : AlgebraicGeometry.Space.IsAbsolutelySeparated B (Spec (.of ξ.base.R)) hA
      (terminal_mem_of_integerBase_mem B hZ) (rebasedLevel B hZ ξ hA n))
    (hdim : AlgebraicGeometry.Space.dimension B (Spec (.of ξ.base.R)) hA
      (rebasedLevel B hZ ξ hA n)
      (rebasedLevel_isAlgebraicSpace B hZ ξ hA n) ≤ (1 : WithBot ℕ∞)) :
    (rebasedLevel B hZ ξ hA n).IsRepresentable :=
  isRepresentable_of_separated_locallyNoetherian_dimension_le_one
    h0ADD B (Spec (.of ξ.base.R)) hA
    (terminal_mem_of_integerBase_mem B hZ)
    (rebasedLevel B hZ ξ hA n)
    (rebasedLevel_isAlgebraicSpace B hZ ξ hA n) hsep
    (rebasedLevel_isLocallyNoetherian B hZ ξ hA n) hdim

/-- **Every level of the tower is a scheme, granted Stacks 0ADD.** Each level is separated and
locally Noetherian, and of dimension at most one by `rebasedLevel_dimension_le_one`. -/
private theorem rebasedLevel_isRepresentable
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u}) (n : ℕ) :
    (rebasedLevel B hZ ξ hA n).IsRepresentable :=
  rebasedLevel_isRepresentable_of_dimension_le_one B hZ ξ hA h0ADD n
    (rebasedLevel_isAbsolutelySeparated B hZ ξ hA n) (rebasedLevel_dimension_le_one B hZ ξ hA n)

end Tower

private lemma comap_pow_equiv {R T : Type u} [CommRing R] [CommRing T]
    (e : R ≃+* T) (I : Ideal T) (n : ℕ) :
    (I ^ n).comap e = (I.comap e) ^ n := by
  have h := Ideal.map_pow (e.symm : T →+* R) I n
  rw [Ideal.map_comap_of_equiv, Ideal.map_comap_of_equiv] at h
  exact h

private lemma ker_adicThickeningι (R : Type u) [CommRing R] (I : Ideal R) (n : ℕ) :
    (AlgebraicGeometry.adicThickeningι R I n).ker =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).ker ^ (n + 1) := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  simp only [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply]
  rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
  change RingHom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I ^ (n + 1))))).appTop.hom =
    RingHom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).appTop.hom ^ (n + 1)
  rw [Stacks.Smooth.ker_specMap_appTop, Stacks.Smooth.ker_specMap_appTop]
  change (RingHom.ker (Ideal.Quotient.mk (I ^ (n + 1)))).comap _ =
    ((RingHom.ker (Ideal.Quotient.mk I)).comap _) ^ (n + 1)
  rw [Ideal.mk_ker, Ideal.mk_ker]
  exact comap_pow_equiv (Scheme.ΓSpecIso (.of R)).commRingCatIsoToRingEquiv _ _

private lemma ker_pow_le_nthOrderToBase {X Y : Scheme.{u}}
    (i : X ⟶ Y) [IsClosedImmersion i] (n : ℕ) :
    i.ker ^ (n + 1) ≤ (Stacks.Thickenings.nthOrderToBase i n).ker := by
  have hi : i.coborderRange = ⊤ := by
    ext x
    change x ∈ coborder (Set.range i) ↔ x ∈ (Set.univ : Set Y)
    rw [i.isClosedEmbedding.isClosed_range.coborder_eq]
  have : IsIso i.coborderRange.ι := by
    apply isIso_of_isOpenImmersion_of_opensRange_eq_top
    simpa using hi
  rw [Stacks.Thickenings.nthOrderToBase, Scheme.Hom.ker_comp,
    Scheme.IdealSheafData.ker_subschemeι]
  conv_lhs => rw [← i.liftCoborder_ι, Scheme.Hom.ker_comp]
  apply Scheme.IdealSheafData.le_def.mpr
  intro U
  simp only [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply,
    Scheme.IdealSheafData.ideal_map _ _ U (U.2.preimage _)]
  exact Ideal.le_comap_pow _ _

private lemma flat_pullback_comp {X S T U : Scheme.{u}} (f : X ⟶ S)
    (g : T ⟶ S) (h : U ⟶ T) [Flat (pullback.snd f g)] :
    Flat (pullback.snd f (h ≫ g)) := by
  have H := (IsPullback.of_hasPullback f (h ≫ g)).of_right'
    (IsPullback.of_hasPullback f g)
  exact MorphismProperty.of_isPullback (P := @Flat) H inferInstance

private lemma flat_nthOrder_of_flat_adic
    (R : CommRingCat.{u}) (I : Ideal R) {X : Scheme.{u}} (f : X ⟶ Spec R)
    (n : ℕ) (hf : Flat (pullback.snd f (AlgebraicGeometry.adicThickeningι R I n))) :
    Flat (pullback.snd f (Stacks.Thickenings.nthOrderToBase
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) n)) := by
  have : IsClosedImmersion (AlgebraicGeometry.adicThickeningι R I n) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  let k := AlgebraicGeometry.adicThickeningι R I n
  let g := Stacks.Thickenings.nthOrderToBase
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) n
  have hker : k.ker ≤ g.ker := by
    rw [ker_adicThickeningι]
    exact ker_pow_le_nthOrderToBase _ _
  let l := IsClosedImmersion.lift k g hker
  have hl : l ≫ k = g := IsClosedImmersion.lift_fac _ _ _
  have : Flat (pullback.snd f k) := hf
  have H := flat_pullback_comp f k l
  rwa [hl] at H

/-- The schemes of size below the cutoff of `B` are closed under isomorphisms. -/
local instance schemeCutoff_isClosedUnderIsomorphisms
    (B : AlgebraicGeometry.BigFppfSite.{u}) :
    ObjectProperty.IsClosedUnderIsomorphisms
      (fun T : Scheme.{u} ↦ T.size < B.cutoff) where
  of_iso {T T'} e h := by
    change T.size < B.cutoff at h
    rwa [← Scheme.size_congr e]

/-- The schemes of size below the cutoff of `B` are closed under pullbacks. -/
local instance schemeCutoff_isClosedUnderPullbacks
    (B : AlgebraicGeometry.BigFppfSite.{u}) :
    ObjectProperty.IsClosedUnderLimitsOfShape
      (fun T : Scheme.{u} ↦ T.size < B.cutoff) WalkingCospan :=
  .mk' (by
    rintro _ ⟨F, hF⟩
    rw [Scheme.size_congr (HasLimit.isoOfNatIso (diagramIsoCospan F))]
    exact Scheme.size_pullback_lt _ _ (hF .left) (hF .right))

private lemma flat_pullback_of_formal_iso
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U V W : AlgebraicGeometry.BigFppfOver B S hS} (f : U ⟶ W) (g : V ⟶ W)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (q : F ⟶ yoneda.obj V)
    (e : F ≅ pullback (yoneda.map f) (yoneda.map g))
    (he : e.hom ≫ pullback.snd (yoneda.map f) (yoneda.map g) = q)
    (hq : AlgebraicGeometry.Space.IsFlat B S hS q) :
    Flat (pullback.snd ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map f)
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map g)) := by
  let T := AlgebraicGeometry.BigFppfOver.toScheme B S hS
  let e' : yoneda.obj (pullback f g) ≅ F := PreservesPullback.iso yoneda f g ≪≫ e.symm
  have hchart : (MorphismProperty.inverseImage (@Etale.{u}) T).presheaf e'.hom := by
    exact Space.presheaf_etale_of_isIso B S hS _
  have hid : (MorphismProperty.inverseImage (@Etale.{u}) T).presheaf
      (𝟙 (yoneda.obj V)) := Space.presheaf_etale_of_isIso B S hS _
  have hflat : Flat (T.map (pullback.snd f g)) := hq
    (pullback f g) V e'.hom (𝟙 _) (pullback.snd f g) hchart hid (by
      dsimp [e']
      rw [← he]
      simp)
  let e'' := (IsPullback.of_hasPullback f g).map T
  rw [← e''.isoPullback_inv_snd]
  have : Flat (T.map (pullback.snd f g)) := hflat
  infer_instance


private theorem forall_of_isOpen_of_closed_fiber
    {R : Type u} [CommRing R] [IsLocalRing R]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of R)) [UniversallyClosed f]
    (P : X → Prop) (hP : IsOpen {x | P x})
    (hfiber : ∀ x, f x = closedPoint R → P x) : ∀ x, P x := by
  intro x
  by_contra hx
  have hC := f.isClosedMap _ hP.isClosed_compl
  have hmem : closedPoint R ∈ f '' {x | P x}ᶜ :=
    (specializes_closedPoint (f x)).mem_closed hC ⟨x, hx, rfl⟩
  obtain ⟨y, hy, hfy⟩ := hmem
  exact hy (hfiber y hfy)

private theorem flat_of_flat_infinitesimalNeighborhoods
    {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    {X Z : Scheme.{u}} [IsLocallyNoetherian X]
    (f : X ⟶ Spec (.of R)) [UniversallyClosed f] [LocallyOfFiniteType f]
    (i : Z ⟶ Spec (.of R)) [IsClosedImmersion i]
    (hi : closedPoint R ∈ Set.range i)
    (hflat : ∀ n : ℕ, Flat (pullback.snd f (Stacks.Thickenings.nthOrderToBase i n))) : Flat f := by
  apply Flat.of_stalkMap
  apply forall_of_isOpen_of_closed_fiber f
    (fun x => AlgebraicGeometry.IsFlatAt f.toLRSHom.toShHom x)
    (AlgebraicGeometry.isOpen_setOf_isFlatAt_of_isLocallyNoetherian f)
  intro x hx
  exact AlgebraicGeometry.isFlatAt_of_flat_infinitesimalNeighbourhoods f i hflat x (hx ▸ hi)

private theorem flat_of_flat_adicThickenings
    (R : CommRingCat.{u}) [IsLocalRing R] [IsNoetherianRing R]
    {X : Scheme.{u}} [IsLocallyNoetherian X]
    (f : X ⟶ Spec R) [UniversallyClosed f] [LocallyOfFiniteType f]
    (hf : ∀ n, Flat (pullback.snd f
      (AlgebraicGeometry.adicThickeningι R (maximalIdeal R) n))) : Flat f := by
  let i : Spec (.of (R ⧸ maximalIdeal R)) ⟶ Spec R :=
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (maximalIdeal R)))
  have : IsClosedImmersion i :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  apply flat_of_flat_infinitesimalNeighborhoods f i
  · let : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
    have : IsLocalHom (Ideal.Quotient.mk (maximalIdeal R)) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    exact ⟨closedPoint (R ⧸ maximalIdeal R), Spec_closedPoint⟩
  · intro n
    exact flat_nthOrder_of_flat_adic R (maximalIdeal R) f n (hf n)

private theorem fiberDimension_le_of_closedFiber
    {R : Type u} [CommRing R] [IsLocalRing R]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of R)) [IsProper f] [Flat f]
    (hfp : AlgebraicGeometry.FinitePresentation f) {d : WithBot ℕ∞}
    (hd : AlgebraicGeometry.Scheme.Hom.fiberDimension f (closedPoint R) ≤ d) :
    ∀ y, AlgebraicGeometry.Scheme.Hom.fiberDimension f y ≤ d := by
  intro y
  have heq : AlgebraicGeometry.Scheme.Hom.fiberDimension f y =
      AlgebraicGeometry.Scheme.Hom.fiberDimension f (closedPoint R) :=
    (specializes_closedPoint y).mem_open
      ((AlgebraicGeometry.isLocallyConstant_fiberDimension f hfp).isOpen_fiber
        (AlgebraicGeometry.Scheme.Hom.fiberDimension f (closedPoint R))) rfl
  exact heq ▸ hd

private alias localDimension_le_dimension := _root_.topologicalKrullDimAt_le_topologicalKrullDim

private lemma exists_nat_localDimension_of_le {T : Type*} [TopologicalSpace T]
    (x : T) (d : ℕ) (hd : topologicalKrullDimAt T x ≤ (d : WithBot ℕ∞)) :
    ∃ e : ℕ, e ≤ d ∧ topologicalKrullDimAt T x = (e : WithBot ℕ∞) := by
  have hne : topologicalKrullDimAt T x ≠ ⊥ := by
    obtain ⟨⟨U, hxU, _, hdim⟩, _⟩ := topologicalKrullDimAt_isLeast T x
    intro hbot
    have hU : topologicalKrullDim U = ⊥ := hdim.symm.trans hbot
    exact ((topologicalKrullDim_eq_bot_iff_isEmpty U).mp hU).false ⟨x, hxU⟩
  obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp hne
  have he' : e ≤ (d : ℕ∞) := WithBot.coe_le_coe.mp (he ▸ hd)
  have hn : e ≠ ⊤ := ne_top_of_le_ne_top (by simp) he'
  obtain ⟨n, rfl⟩ := ENat.ne_top_iff_exists.mp hn
  exact ⟨n, ENat.natCast_le_natCast.mp he', he.symm⟩

private lemma dimension_scheme_le_of_yoneda_iso
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (U : AlgebraicGeometry.BigFppfOver B S hS)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F) (e : yoneda.obj U ≅ F) :
    topologicalKrullDim U.left.obj ≤ AlgebraicGeometry.Space.dimension B S hS F hF := by
  rw [TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
  apply iSup_le
  intro x
  have : QuasiCompact (U.left.obj.fromSpecResidueField x) := by
    rw [quasiCompact_iff_forall_isAffineOpen]
    intro W hW
    exact (Set.toFinite _).isCompact
  let hK : B.Contains (Spec (U.left.obj.residueField x)) :=
    Scheme.size_lt_of_mono_quasiCompact (U.left.obj.fromSpecResidueField x) U.left.property
  let p : AlgebraicGeometry.Space.FieldValuedPoint B S hS (yoneda.obj U) := {
    carrier := U.left.obj.residueField x
    contained := hK
    toBase := U.left.obj.fromSpecResidueField x ≫ U.hom.hom
    value := Over.homMk (ObjectProperty.homMk (U.left.obj.fromSpecResidueField x)) rfl }
  let y := AlgebraicGeometry.Space.pointsMap B S hS (yoneda.obj U) e.hom (p.class B S hS _)
  have h := AlgebraicGeometry.Space.dimensionAtPoint_eq_of_etale_chart B S hS F hF y U e.hom
    (Space.presheaf_etale_of_isIso B S hS _) p rfl
  have hp : AlgebraicGeometry.Space.schemePoint B S hS U p = x :=
    Scheme.fromSpecResidueField_apply _ _
  rw [hp, TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim] at h
  exact h.symm.le.trans (le_iSup _ y)

/-- The étale chart of `yoneda.map f` at a field-valued point of its source given by the
identity presentations of source and target. -/
private def etaleChartOfIdentity
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U V : AlgebraicGeometry.BigFppfOver B S hS} (f : U ⟶ V)
    (p : AlgebraicGeometry.Space.FieldValuedPoint B S hS (yoneda.obj U)) :
    AlgebraicGeometry.Space.EtaleChartAtPoint B S hS (yoneda.map f)
      (p.class B S hS (yoneda.obj U)) where
  U := U
  V := V
  a := 𝟙 _
  b := 𝟙 _
  h := f
  a_etale := Space.presheaf_etale_of_isIso B S hS _
  b_etale := Space.presheaf_etale_of_isIso B S hS _
  comm := by simp
  representative := p
  point := closedPoint p.carrier
  maps_to := by rfl

/-- A morphism of schemes locally of finite type all of whose fibres have dimension at most
`d` has, at any point, germ fibre dimension some natural number at most `d`.

This is the fibre-dimension analogue of
`AlgebraicGeometry.exists_hasFiberDimensionAt_ofSchemeHom`, which bounds the dimension of the
source instead; the representative is the same, the restriction to the top open. -/
private lemma exists_hasFiberDimensionAt_of_fiberDimension_le {X Y : Scheme.{u}} (g : X ⟶ Y)
    [LocallyOfFiniteType g] (x : X) (d : ℕ)
    (hd : ∀ y, AlgebraicGeometry.Scheme.Hom.fiberDimension g y ≤ (d : WithBot ℕ∞)) :
    ∃ e : ℕ, e ≤ d ∧
      AlgebraicGeometry.HasFiberDimensionAt (e : ℕ∞)
        (AlgebraicGeometry.MorphismOfGerms.ofSchemeHom g x) := by
  set h : ((⊤ : X.Opens) : Scheme.{u}) ⟶ Y := X.topIso.hom ≫ g with hh
  set z : ((⊤ : X.Opens) : Scheme.{u}) := ⟨x, by simp⟩ with hz
  have hpb : IsPullback X.topIso.hom h g (𝟙 Y) := IsPullback.of_horiz_isIso ⟨by simp [hh]⟩
  have hpt : X.topIso.hom z = x := by simp [hz]
  have heq : topologicalKrullDimAt (h.fiber (h z)) (h.asFiber z) =
      topologicalKrullDimAt (g.fiber (g x)) (g.asFiber x) := by
    have h0 := AlgebraicGeometry.topologicalKrullDimAt_fiber_eq_of_isPullback hpb z
    rw [hpt] at h0
    exact h0
  have hle : topologicalKrullDimAt (h.fiber (h z)) (h.asFiber z) ≤ (d : WithBot ℕ∞) :=
    heq ▸ ((localDimension_le_dimension _).trans (hd (g x)))
  obtain ⟨e, hen, hee⟩ := exists_nat_localDimension_of_le (h.asFiber z) d hle
  exact ⟨e, hen, { source := ⊤
                   mem_source := by simp
                   hom := h
                   map_point := rfl }, rfl, hee⟩

private lemma relativeDimensionLE_yoneda_of_fiberDimension_le
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U V : AlgebraicGeometry.BigFppfOver B S hS} (f : U ⟶ V)
    [LocallyOfFiniteType f.left.hom] (d : ℕ)
    (hd : ∀ y, AlgebraicGeometry.Scheme.Hom.fiberDimension f.left.hom y ≤ (d : WithBot ℕ∞)) :
    AlgebraicGeometry.Space.HasRelativeDimensionLE d B S hS (yoneda.map f) := by
  intro x
  obtain ⟨e, hen, hee⟩ := exists_hasFiberDimensionAt_of_fiberDimension_le f.left.hom
    (AlgebraicGeometry.Space.pointsToScheme B S hS U x) d hd
  exact ⟨e, hen, (AlgebraicGeometry.Space.holdsOnEveryEtaleChartAtPoint_yoneda_map_iff B S hS
    (@AlgebraicGeometry.HasFiberDimensionAt.{u} (e : ℕ∞))
    (AlgebraicGeometry.fiberDimensionAt_isEtaleLocalOnSourceAndTarget (e : ℕ∞)) f x).2 hee⟩

private lemma fiberDimension_le_dimension {X Y : Scheme.{u}} (f : X ⟶ Y) (y : Y) :
    AlgebraicGeometry.Scheme.Hom.fiberDimension f y ≤ topologicalKrullDim X := by
  change topologicalKrullDim (f.fiber y) ≤ _
  rw [(f.fiberHomeo y).isHomeomorph.topologicalKrullDim_eq]
  exact Topology.IsInducing.topologicalKrullDim_le
    (Topology.IsEmbedding.subtypeVal.isInducing)

private lemma holdsOnEveryEtaleChart_yoneda_map
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (P : MorphismProperty Scheme.{u})
    (hP : AlgebraicGeometry.IsEtaleLocalOnSourceAndTarget P)
    {U V : AlgebraicGeometry.BigFppfOver B S hS} (f : U ⟶ V) (hf : P f.left.hom) :
    AlgebraicGeometry.Space.HoldsOnEveryEtaleChart B S hS P (yoneda.map f) := by
  apply (AlgebraicGeometry.Space.holdsOnEveryEtaleChart_iff_surjectiveChart B S hS P hP
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS U)
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS V) _).2
  refine ⟨U, V, 𝟙 _, 𝟙 _, f, Space.presheaf_etale_of_isIso B S hS _,
    Space.presheaf_etale_of_isIso B S hS _, ?_, by simp, hf⟩
  refine ⟨Functor.relativelyRepresentable.of_isIso yoneda _, ?_⟩
  intro W W' g fst snd sq
  have : IsIso (yoneda.map snd) := sq.isIso_snd_of_isIso
  have : IsIso snd := Yoneda.fullyFaithful.isIso_of_isIso_map _
  change Surjective ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map snd)
  infer_instance

private lemma etale_of_presheaf_yoneda_map
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U V : AlgebraicGeometry.BigFppfOver B S hS} (f : U ⟶ V)
    (hf : (MorphismProperty.inverseImage (@Etale.{u})
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf (yoneda.map f)) :
    Etale f.left.hom :=
  hf.property (𝟙 _) (𝟙 _) f (IsPullback.of_horiz_isIso ⟨by simp⟩)

private lemma locallyOfFinitePresentation_yoneda_map
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U V : AlgebraicGeometry.BigFppfOver B S hS} [IsLocallyNoetherian V.left.obj]
    (f : U ⟶ V) [LocallyOfFiniteType f.left.hom] :
    AlgebraicGeometry.Space.IsLocallyOfFinitePresentation B S hS (yoneda.map f) := by
  have hft := holdsOnEveryEtaleChart_yoneda_map B S hS (@LocallyOfFiniteType)
    AlgebraicGeometry.isEtaleLocalOnSourceAndTarget_locallyOfFiniteType
    f inferInstance
  intro U' V' a b g ha hb hc
  have hb' := hb
  rw [← yoneda.map_preimage b] at hb'
  have := etale_of_presheaf_yoneda_map B S hS (yoneda.preimage b) hb'
  have : IsLocallyNoetherian V'.left.obj :=
    LocallyOfFiniteType.isLocallyNoetherian (yoneda.preimage b).left.hom
  have : LocallyOfFiniteType g.left.hom := hft U' V' a b g ha hb hc
  change LocallyOfFinitePresentation g.left.hom
  infer_instance

private lemma hom_ext_of_fiberedInGroupoids
    {D E : Type*} [Category D] [Category E] (p : D ⥤ E)
    (hp : p.IsFiberedInGroupoids) {x y z : D} (r : y ⟶ x) {f g : z ⟶ y}
    (hbase : p.map f = p.map g) (hcomp : f ≫ r = g ≫ r) : f = g := by
  have H := hp.unique_lift r (g ≫ r) (p.map g) (by simp)
  exact H.unique ⟨hbase, hcomp⟩ ⟨rfl, rfl⟩

private lemma exists_iso_of_baseIso_of_fiberedInGroupoids
    {D E : Type*} [Category D] [Category E] (p : D ⥤ E)
    (hp : p.IsFiberedInGroupoids) {x y z : D} (r : y ⟶ x) (s : z ⟶ x)
    (b : p.obj y ≅ p.obj z) (hb : b.hom ≫ p.map s = p.map r) :
    ∃ e : y ≅ z, p.map e.hom = b.hom ∧ e.hom ≫ s = r := by
  obtain ⟨f, hf, _⟩ := hp.unique_lift s r b.hom hb
  obtain ⟨g, hg, _⟩ := hp.unique_lift r s b.inv (by rw [← hb]; simp)
  refine ⟨⟨f, g, ?_, ?_⟩, hf⟩
  · apply hom_ext_of_fiberedInGroupoids p hp r
    · simp [hf.1, hg.1]
    · simp [Category.assoc, hg.2, hf.2]
  · apply hom_ext_of_fiberedInGroupoids p hp s
    · simp [hf.1, hg.1]
    · simp [Category.assoc, hg.2, hf.2]

private def formalObjectIsoOfComponents
    {B : AlgebraicGeometry.BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : Type v} [Category.{w} F] {p : F ⥤ AlgebraicGeometry.BigFppfOver B S hS}
    {ξ η : Deformation.Artin.FormalObject B S hS p}
    (e : ∀ n, ξ.level n ≅ η.level n)
    (he : ∀ n, ξ.transition n ≫ (e (n + 1)).hom = (e n).hom ≫ η.transition n) :
    ξ ≅ η where
  hom := { app := fun n => (e n).hom, naturality := he }
  inv := {
    app := fun n => (e n).inv
    naturality := by
      intro n
      apply (cancel_epi (e n).hom).mp
      simp only [← Category.assoc, Iso.hom_inv_id, Category.id_comp]
      rw [← he n, Category.assoc, Iso.hom_inv_id, Category.comp_id] }
  hom_inv_id := by
    apply Deformation.Artin.FormalObject.Hom.ext
    intro n
    exact (e n).hom_inv_id
  inv_hom_id := by
    apply Deformation.Artin.FormalObject.Hom.ext
    intro n
    exact (e n).inv_hom_id

private lemma exists_adicThickeningIso
    (R T : CommRingCat.{u}) [IsLocalRing R] [IsLocalRing T]
    (a : Spec R ≅ Spec T) (n : ℕ) :
    ∃ e : AlgebraicGeometry.adicThickening R (maximalIdeal R) n ≅
        AlgebraicGeometry.adicThickening T (maximalIdeal T) n,
      e.hom ≫ AlgebraicGeometry.adicThickeningι T (maximalIdeal T) n =
        AlgebraicGeometry.adicThickeningι R (maximalIdeal R) n ≫ a.hom := by
  let ρ : T ≅ R := {
    hom := Spec.preimage a.hom
    inv := Spec.preimage a.inv
    hom_inv_id := by apply Spec.map_injective; simp
    inv_hom_id := by apply Spec.map_injective; simp }
  let r := ρ.commRingCatIsoToRingEquiv
  have hm : maximalIdeal R ^ (n + 1) = (maximalIdeal T ^ (n + 1)).map r := by
    rw [Ideal.map_pow, map_ringEquiv_maximalIdeal]
  let q := Ideal.quotientEquiv (maximalIdeal T ^ (n + 1))
    (maximalIdeal R ^ (n + 1)) r hm
  let e := Scheme.Spec.mapIso q.toCommRingCatIso.op
  refine ⟨e, ?_⟩
  change Spec.map (CommRingCat.ofHom q.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (maximalIdeal T ^ (n + 1)))) =
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1)))) ≫ a.hom
  rw [← Spec.map_preimage a.hom, ← Spec.map_comp, ← Spec.map_comp]
  congr 1

private lemma baseOver_congr
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {A A' : Deformation.Artin.FormalBase S} (h : A = A')
    (hA : B.Contains (Spec (.of A.R))) (hA' : B.Contains (Spec (.of A'.R))) :
    Deformation.Artin.baseOver B S hS A hA = Deformation.Artin.baseOver B S hS A' hA' := by
  cases h
  rfl

private lemma formalObject_iso_of_cones
    {B : AlgebraicGeometry.BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {F : Type v} [Category.{w} F] (p : F ⥤ AlgebraicGeometry.BigFppfOver B S hS)
    (hp : p.IsFiberedInGroupoids)
    {ξ η : Deformation.Artin.FormalObject B S hS p} {x : F}
    (r : ∀ n, ξ.level n ⟶ x) (s : ∀ n, η.level n ⟶ x)
    (hr : ∀ n, ξ.transition n ≫ r (n + 1) = r n)
    (hs : ∀ n, η.transition n ≫ s (n + 1) = s n)
    (b : ∀ n, p.obj (ξ.level n) ≅ p.obj (η.level n))
    (hb : ∀ n, (b n).hom ≫ p.map (s n) = p.map (r n))
    (hm : ∀ n, Mono (p.map (s n))) : Nonempty (ξ ≅ η) := by
  choose e he hcomp using fun n =>
    exists_iso_of_baseIso_of_fiberedInGroupoids p hp (r n) (s n) (b n) (hb n)
  refine ⟨formalObjectIsoOfComponents e (fun n => ?_)⟩
  apply hom_ext_of_fiberedInGroupoids p hp (s (n + 1))
  · have := hm (n + 1)
    apply (cancel_mono (p.map (s (n + 1)))).mp
    simp only [← p.map_comp, Category.assoc, hcomp, hs, hr]
  · simp only [Category.assoc, hcomp, hs, hr]

/-! ### Stacks 0E7R for a tower of representable levels -/

private theorem isPullback_of_yoneda_isPullback
    {C : Type (u + 1)} [Category.{u, u + 1} C]
    {P X Y Z : C} {fst : P ⟶ X} {snd : P ⟶ Y}
    {f : X ⟶ Z} {g : Y ⟶ Z}
    (h : IsPullback (yoneda.map fst) (yoneda.map snd)
      (yoneda.map f) (yoneda.map g)) :
    IsPullback fst snd f g := by
  have hw : fst ≫ f = snd ≫ g := by
    apply Functor.map_injective yoneda
    simpa only [Functor.map_comp] using h.w
  exact (IsPullback.map_iff (F := yoneda) hw).mp h

private theorem represented_pullback_is_scheme_pullback
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F G : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    [F.IsRepresentable] [G.IsRepresentable]
    {T T' : AlgebraicGeometry.BigFppfOver B S hS}
    (q : F ⟶ yoneda.obj T) (r : G ⟶ yoneda.obj T')
    (t : T ⟶ T') (i : F ⟶ G)
    (h : IsPullback i q r (yoneda.map t)) :
    IsPullback
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map
        (yoneda.preimage (F.reprW.hom ≫ i ≫ G.reprW.inv)))
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map
        (yoneda.preimage (F.reprW.hom ≫ q)))
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map
        (yoneda.preimage (G.reprW.hom ≫ r)))
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map t) := by
  have hi' : yoneda.map (yoneda.preimage (F.reprW.hom ≫ i ≫ G.reprW.inv)) =
      F.reprW.hom ≫ i ≫ G.reprW.inv := Functor.map_preimage _ _
  have hq' : yoneda.map (yoneda.preimage (F.reprW.hom ≫ q)) = F.reprW.hom ≫ q :=
    Functor.map_preimage _ _
  have hr' : yoneda.map (yoneda.preimage (G.reprW.hom ≫ r)) = G.reprW.hom ≫ r :=
    Functor.map_preimage _ _
  have h' : IsPullback (yoneda.map (yoneda.preimage (F.reprW.hom ≫ i ≫ G.reprW.inv)))
      (yoneda.map (yoneda.preimage (F.reprW.hom ≫ q)))
      (yoneda.map (yoneda.preimage (G.reprW.hom ≫ r))) (yoneda.map t) := by
    apply IsPullback.of_iso h F.reprW.symm G.reprW.symm (Iso.refl _) (Iso.refl _)
    · rw [hi']
      simp
    · rw [hq']
      simp
    · rw [hr']
      simp
    · simp
  exact IsPullback.map (AlgebraicGeometry.BigFppfOver.toScheme B S hS)
    (isPullback_of_yoneda_isPullback h')

private theorem represented_morphism_isProper
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F) [F.IsRepresentable]
    (T : AlgebraicGeometry.BigFppfOver B S hS) (q : F ⟶ yoneda.obj T)
    (hq : AlgebraicGeometry.Space.IsProper B S hS q) :
    IsProper ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map
      (yoneda.preimage (F.reprW.hom ≫ q))) := by
  let q' := yoneda.preimage (F.reprW.hom ≫ q)
  have hq' : yoneda.map q' = F.reprW.hom ≫ q := yoneda.map_preimage _
  have hrel : yoneda.relativelyRepresentable q := by
    have hr := Functor.relativelyRepresentable.map yoneda q'
    have hr' := MorphismProperty.RespectsIso.precomp
      yoneda.relativelyRepresentable F.reprW.inv (yoneda.map q') hr
    simpa [hq'] using hr'
  have hp := (isProper_iff_presheaf B S hS hF
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS T) q hrel).mp hq
  apply hp.property (𝟙 _) F.reprW.hom q'
  exact IsPullback.of_horiz_isIso ⟨by simp [hq']⟩

