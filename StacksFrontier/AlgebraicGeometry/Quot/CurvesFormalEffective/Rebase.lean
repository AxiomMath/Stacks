namespace AlgebraicGeometry.Space


/-- **The statement of Stacks 0ADD.** A point of a separated, locally Noetherian algebraic
space at which the local ring has dimension at most one lies in an open subspace which is a
scheme.

It is stated here, quantified over every big fppf site and every base scheme, so that it can be
carried as a single hypothesis; it is proved as
`AlgebraicGeometry.Space.schemeNeighbourhoodsInCodimensionOne`, from Stacks 0ADD at
`AlgebraicGeometry.Space.exists_isOpenSubspace_isRepresentable_of_localRingDimension_le_one`. -/
public def SchemeNeighbourhoodsInCodimensionOne : Prop :=
  ∀ (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))
    (F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (_ : IsAlgebraicSpace B S hS F),
    IsAbsolutelySeparated B S hS hZ F →
    HasEtaleLocalProperty B S hS F (fun X : Scheme.{u} => IsLocallyNoetherian X) →
    ∀ x : points B S hS F, localRingDimension B S hS x ≤ 1 →
    ∃ G : Subfunctor F, IsOpenSubspace B S hS G ∧ G.toFunctor.IsRepresentable ∧
      x ∈ Set.range (pointsMap B S hS G.toFunctor G.ι)

/-- **The statement of Stacks 0E7R.** A cartesian tower of algebraic spaces over the
infinitesimal thickenings of a Noetherian complete local ring, whose closed member is proper of
dimension at most one, is the system of adic fibres of a projective morphism of schemes over
the spectrum of that ring.

This library does not prove it: the source's argument goes through Grothendieck's algebraization
theorem, Stacks 089A, of which only the level-one projective embedding step is available, and
through the H-projectivity of a proper curve, Stacks 0A26, which *is* registered, with nothing
carried, at
`Stacks.HQuasiProjectiveDimensionOne.isProjectiveMorphism_of_isProper_of_topologicalKrullDim_le_one`
in `StacksFrontier/AlgebraicGeometry/HQuasiProjectiveDimensionOne/Basic.lean`. It is stated here so
that it can be carried as a single hypothesis.

Properness of the closed member is asked explicitly, where the source leaves it to the ambient
conventions of its section on Grothendieck's algebraization theorem; so this `Prop` is no
stronger than Stacks 0E7R, and anything conditional on it is conditional on no more than that
tag. -/
public def FormalProjectiveAlgebraizationDimLEOne : Prop :=
  ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [IsAdicComplete (maximalIdeal A) A]
    (B : BigFppfSite.{u}) (hS : B.Contains (Spec (.of A)))
    (hSn : ∀ n, B.Contains (adicThickening A (maximalIdeal A) n))
    (F : ℕ → (BigFppfOver B (Spec (.of A)) hS)ᵒᵖ ⥤ Type u)
    (hF : ∀ n, IsAlgebraicSpace B (Spec (.of A)) hS (F n))
    (q : ∀ n, F n ⟶ yoneda.obj (adicThickeningObject A (maximalIdeal A) B hS hSn n))
    (i : ∀ n, F n ⟶ F (n + 1)),
    (∀ n, IsPullback (i n) (q n) (q (n + 1))
      (yoneda.map (adicThickeningSuccMap A (maximalIdeal A) B hS hSn n))) →
    IsProper B (Spec (.of A)) hS (q 0) →
    dimension B (Spec (.of A)) hS (F 0) (hF 0) ≤ 1 →
    ∃ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)),
      IsProjective f ∧
      ∃ hX : B.Contains X,
        let Xobj : BigFppfOver B (Spec (.of A)) hS :=
          Over.mk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hS)
        let fX : yoneda.obj Xobj ⟶ yoneda.obj (baseObject A B hS) :=
          yoneda.map (Over.homMk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hS))
        ∃ e : ∀ n, F n ≅ adicFibre A (maximalIdeal A) B hS hSn fX n,
          (∀ n, (e n).hom ≫ pullback.snd fX
            (yoneda.map (adicThickeningMap A (maximalIdeal A) B hS hSn n)) = q n) ∧
          (∀ n, i n ≫ (e (n + 1)).hom =
            (e n).hom ≫ adicFibreSucc A (maximalIdeal A) B hS hSn fX n)

end AlgebraicGeometry.Space

end


