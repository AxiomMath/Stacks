private theorem terminal_mem_of_integerBase_mem
    (B : AlgebraicGeometry.BigFppfSite.{u})
    (hZ : B.Contains AlgebraicGeometry.integerBase) :
    B.Contains (⊤_ Scheme.{u}) := by
  change (⊤_ Scheme.{u}).size < B.cutoff
  have e : (⊤_ Scheme.{u}) ≅ AlgebraicGeometry.integerBase :=
    IsTerminal.uniqueUpToIso terminalIsTerminal specULiftZIsTerminal
  rw [Scheme.size_congr e]
  exact hZ

private theorem fiberDimension_le_of_relativeDimensionLE
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (f : X ⟶ Y) (d : ℕ)
    (h : AlgebraicGeometry.Space.HasRelativeDimensionLE d B S hS f)
    (y : AlgebraicGeometry.Space.points B S hS Y) :
    AlgebraicGeometry.Space.fiberDimension B S hS f y ≤ (d : WithBot ℕ∞) := by
  apply sInf_le
  intro x hx
  obtain ⟨e, he, hdim⟩ := h x
  refine ⟨e, hdim, ?_⟩
  exact_mod_cast he

private theorem dimension_eq_of_iso
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F G : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F)
    (hG : AlgebraicGeometry.IsAlgebraicSpace B S hS G) (e : F ≅ G) :
    AlgebraicGeometry.Space.dimension B S hS F hF =
      AlgebraicGeometry.Space.dimension B S hS G hG := by
  apply AlgebraicGeometry.Space.dimension_eq_of_isEtale_of_isSurjective
    B S hS hF hG e.hom
  · intro U a ha
    exact MorphismProperty.RespectsIso.postcomp _ e.hom a ha
  · intro y
    refine ⟨AlgebraicGeometry.Space.pointsMap B S hS G e.inv y, ?_⟩
    induction y using Quot.inductionOn with
    | h p =>
      change (AlgebraicGeometry.Space.FieldValuedPoint.map B S hS G e.inv p |>.map
        B S hS F e.hom).class B S hS G = p.class B S hS G
      have hp : e.hom.app _ (e.inv.app _ p.value) = p.value :=
        congrArg (fun f => f.app _ p.value) e.inv_hom_id
      change (AlgebraicGeometry.Space.FieldValuedPoint.mk p.carrier p.contained p.toBase
        (e.hom.app _ (e.inv.app _ p.value))).class B S hS G = p.class B S hS G
      rw [hp]

namespace Rebase

variable {C : Type u} [Category.{v} C] {S A : C} (a : A ⟶ S)

@[implicit_reducible]
private def sectionMap : yoneda.obj (Over.mk (𝟙 A)) ⟶
    (Over.map a).op ⋙ yoneda.obj (Over.mk a) where
  app W := ↾fun _ => Over.homMk W.unop.hom (by simp)
  naturality := by intros; ext; apply Over.OverMorphism.ext; simp

@[implicit_reducible]
private def rebase : Over (yoneda.obj (Over.mk a)) ⥤ ((Over A)ᵒᵖ ⥤ Type v) :=
  Over.post (OverShriek.relocalizeRestrict a) ⋙
    Over.pullback (sectionMap a) ⋙ Over.forget _

private theorem rebase_preservesPullbacks :
    PreservesLimitsOfShape WalkingCospan (rebase a) := by
  dsimp [rebase]
  have : PreservesLimitsOfShape WalkingCospan
      (Over.post (X := yoneda.obj (Over.mk a)) (OverShriek.relocalizeRestrict a)) := by
    infer_instance
  have : PreservesLimitsOfShape WalkingCospan (Over.pullback (sectionMap a)) := by
    infer_instance
  have : PreservesLimitsOfShape WalkingCospan
      (Over.forget (yoneda.obj (Over.mk (𝟙 A)))) := by
    infer_instance
  infer_instance

@[implicit_reducible]
private def representedToBase (b : Over A) : (Over.map a).obj b ⟶ Over.mk a :=
  Over.homMk b.hom rfl

@[implicit_reducible]
private def representedOverBase (b : Over A) : Over (yoneda.obj (Over.mk a)) :=
  Over.mk (yoneda.map (representedToBase a b))

@[implicit_reducible]
private def representedRestrictionMap (b : Over A) :
    yoneda.obj b ⟶ (Over.map a).op ⋙ yoneda.obj ((Over.map a).obj b) where
  app W := ↾fun f => (Over.map a).map f
  naturality := by intros; ext; apply Over.OverMorphism.ext; rfl

@[implicit_reducible]
private def representedTerminalMap (b : Over A) :
    yoneda.obj b ⟶ yoneda.obj (Over.mk (𝟙 A)) :=
  yoneda.map (Over.homMk b.hom (by simp))

private theorem represented_rebase_isPullback (b : Over A) :
    IsPullback (representedRestrictionMap a b) (representedTerminalMap b)
      ((OverShriek.relocalizeRestrict a).map (yoneda.map (representedToBase a b)))
      (sectionMap a) := by
  have hc : representedRestrictionMap a b ≫
        (OverShriek.relocalizeRestrict a).map (yoneda.map (representedToBase a b)) =
      representedTerminalMap b ≫ sectionMap a := by
    ext W f
    apply Over.OverMorphism.ext
    exact f.w
  refine IsPullback.of_isLimit (PullbackCone.IsLimit.mk hc (fun t => ?_) ?_ ?_ ?_)
  · refine { app := fun W => ↾fun x => Over.homMk ((t.fst.app W x).left) ?_
             naturality := ?_ }
    · have h := congrArg (fun e => (e.app W x).left) t.condition
      exact h
    · intro W W' g
      ext x
      apply Over.OverMorphism.ext
      change (t.fst.app W' (t.pt.map g x)).left = g.unop.left ≫ (t.fst.app W x).left
      exact congrArg (fun f : (Over.map a).obj W'.unop ⟶ (Over.map a).obj b => f.left)
        (NatTrans.naturality_apply t.fst g x)
  · intro t
    ext W x
    apply Over.OverMorphism.ext
    rfl
  · intro t
    ext W x
    apply Over.OverMorphism.ext
    change (t.fst.app W x).left ≫ b.hom = (t.snd.app W x).left
    have h := congrArg (fun e => (e.app W x).left) t.condition
    change (t.fst.app W x).left ≫ b.hom = W.unop.hom at h
    exact h.trans (by simpa using (t.snd.app W x).w.symm)
  · intro t m hm₁ hm₂
    ext W x
    apply Over.OverMorphism.ext
    exact congrArg (fun e => (e.app W x).left) hm₁

@[implicit_reducible]
private def representedRebaseIso (b : Over A) :
    (rebase a).obj (representedOverBase a b) ≅ yoneda.obj b :=
  (represented_rebase_isPullback a b).isoPullback.symm

@[implicit_reducible]
private def representedOverBaseMap {b c : Over A} (k : b ⟶ c) :
    representedOverBase a b ⟶ representedOverBase a c :=
  Over.homMk (yoneda.map ((Over.map a).map k)) (by
    change yoneda.map ((Over.map a).map k) ≫ yoneda.map (representedToBase a c) =
      yoneda.map (representedToBase a b)
    rw [← yoneda.map_comp]
    congr 1
    apply Over.OverMorphism.ext
    exact k.w)


private theorem representedRebaseIso_hom_restriction (b : Over A) :
    (representedRebaseIso a b).hom ≫ representedRestrictionMap a b =
      pullback.fst
        ((OverShriek.relocalizeRestrict a).map (yoneda.map (representedToBase a b)))
        (sectionMap a) :=
  (represented_rebase_isPullback a b).isoPullback_inv_fst

private theorem representedRestrictionMap_naturality {b c : Over A} (k : b ⟶ c) :
    yoneda.map k ≫ representedRestrictionMap a c =
      representedRestrictionMap a b ≫
        (OverShriek.relocalizeRestrict a).map (yoneda.map ((Over.map a).map k)) := by
  ext W x
  apply Over.OverMorphism.ext
  rfl

private theorem representedTerminal_hom_ext {F : (Over A)ᵒᵖ ⥤ Type v}
    (f g : F ⟶ yoneda.obj (Over.mk (𝟙 A))) : f = g := by
  ext W x
  apply Over.OverMorphism.ext
  simpa using (f.app W x).w.trans (g.app W x).w.symm

private theorem rebase_map_fst {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T') :
    (rebase a).map f ≫
        pullback.fst (((Over.post (OverShriek.relocalizeRestrict a)).obj T').hom) (sectionMap a) =
      pullback.fst (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom) (sectionMap a) ≫
        (OverShriek.relocalizeRestrict a).map f.left := by
  exact pullback.lift_fst _ _ _

private theorem representedRebaseIso_naturality {b c : Over A} (k : b ⟶ c) :
    (rebase a).map (representedOverBaseMap a k) ≫ (representedRebaseIso a c).hom =
      (representedRebaseIso a b).hom ≫ yoneda.map k := by
  apply (represented_rebase_isPullback a c).hom_ext
  · simp only [Category.assoc, representedRebaseIso_hom_restriction,
      representedRestrictionMap_naturality]
    rw [← Category.assoc, representedRebaseIso_hom_restriction]
    exact rebase_map_fst a (representedOverBaseMap a k)
  · exact representedTerminal_hom_ext _ _

/-- `rebase` sends pullback squares of `Over (yoneda.obj (Over.mk a))`, detected on the
underlying presheaves, to pullback squares. -/
private theorem rebase_map_isPullback
    {X Y Z W : Over (yoneda.obj (Over.mk a))} {fst : W ⟶ X} {snd : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
    (h : IsPullback fst.left snd.left f.left g.left) :
    IsPullback ((rebase a).map fst) ((rebase a).map snd) ((rebase a).map f) ((rebase a).map g) :=
  let := rebase_preservesPullbacks a
  (IsPullback.of_map_of_faithful (Over.forget (yoneda.obj (Over.mk a))) h).map (rebase a)

private theorem rebase_isPullback
    {T₁ T₂ : Over (yoneda.obj (Over.mk a))} {b c : Over A}
    (f : T₁ ⟶ T₂) (p : T₁ ⟶ representedOverBase a b)
    (q : T₂ ⟶ representedOverBase a c) (k : b ⟶ c)
    (h : IsPullback f.left p.left q.left (yoneda.map ((Over.map a).map k))) :
    IsPullback ((rebase a).map f)
      ((rebase a).map p ≫ (representedRebaseIso a b).hom)
      ((rebase a).map q ≫ (representedRebaseIso a c).hom) (yoneda.map k) := by
  exact (rebase_map_isPullback a (g := representedOverBaseMap a k) h).of_iso
    (Iso.refl _) (Iso.refl _)
    (representedRebaseIso a b) (representedRebaseIso a c)
    (by simp) (by simp) (by simp) (representedRebaseIso_naturality a k)

@[implicit_reducible]
private def chartOver {T : Over (yoneda.obj (Over.mk a))} {b : Over A}
    (c : yoneda.obj b ⟶ (rebase a).obj T) : representedOverBase a b ⟶ T := by
  let z : T.left.obj (Opposite.op ((Over.map a).obj b)) :=
    (pullback.fst (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom)
      (sectionMap a)).app (Opposite.op b) (c.app (Opposite.op b) (𝟙 b))
  refine Over.homMk (yonedaEquiv.symm z) ?_
  change (yonedaEquiv.symm z : yoneda.obj ((Over.map a).obj b) ⟶ T.left) ≫ T.hom =
    yoneda.map (representedToBase a b)
  apply yonedaEquiv.injective
  rw [yonedaEquiv_comp, Equiv.apply_symm_apply, yonedaEquiv_yoneda_map]
  change ((((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom).app (Opposite.op b))
    ((c ≫ pullback.fst _ _).app (Opposite.op b) (𝟙 b)) = _
  have h := congrArg (fun e => e.app (Opposite.op b) (𝟙 b))
    (Category.assoc c (pullback.fst
      (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom) (sectionMap a))
      (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom))
  rw [pullback.condition] at h
  exact h

private theorem chartOver_restriction {T : Over (yoneda.obj (Over.mk a))} {b : Over A}
    (c : yoneda.obj b ⟶ (rebase a).obj T) :
    representedRestrictionMap a b ≫ (OverShriek.relocalizeRestrict a).map
        (chartOver a c).left =
      c ≫ pullback.fst (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom)
        (sectionMap a) := by
  apply yonedaEquiv.injective
  change (yonedaEquiv.symm
    ((pullback.fst (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom) (sectionMap a)).app
      (Opposite.op b) (c.app (Opposite.op b) (𝟙 b))) :
      yoneda.obj ((Over.map a).obj b) ⟶ T.left).app
    (Opposite.op ((Over.map a).obj b)) ((Over.map a).map (𝟙 b)) = _
  rw [CategoryTheory.Functor.map_id]
  exact Equiv.apply_symm_apply yonedaEquiv _

private theorem chartOver_rebase {T : Over (yoneda.obj (Over.mk a))} {b : Over A}
    (c : yoneda.obj b ⟶ (rebase a).obj T) :
    (representedRebaseIso a b).inv ≫ (rebase a).map (chartOver a c) = c := by
  refine (IsPullback.of_hasPullback
    (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom) (sectionMap a)).hom_ext ?_ ?_
  · rw [Category.assoc, rebase_map_fst]
    have hf : (representedRebaseIso a b).inv ≫
        pullback.fst (((Over.post (OverShriek.relocalizeRestrict a)).obj
          (representedOverBase a b)).hom) (sectionMap a) =
        representedRestrictionMap a b :=
      (represented_rebase_isPullback a b).isoPullback_hom_fst
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (fun t => t ≫ (OverShriek.relocalizeRestrict a).map
        (Over.Hom.left (chartOver a c))) hf).trans (chartOver_restriction a c))
  · exact representedTerminal_hom_ext _ _

private theorem rebase_isPullback_of_represented_left
    {T T' : Over (yoneda.obj (Over.mk a))} {b c : Over A}
    (f : T ⟶ T') (j : representedOverBase a b ⟶ T)
    (q : representedOverBase a c ⟶ T') (k : b ⟶ c)
    (h : IsPullback j.left (yoneda.map ((Over.map a).map k)) f.left q.left) :
    IsPullback ((representedRebaseIso a b).inv ≫ (rebase a).map j)
      (yoneda.map k) ((rebase a).map f)
      ((representedRebaseIso a c).inv ≫ (rebase a).map q) := by
  exact (rebase_map_isPullback a (snd := representedOverBaseMap a k) h).of_iso
    (representedRebaseIso a b) (Iso.refl _)
    (representedRebaseIso a c) (Iso.refl _)
    (by simp) (representedRebaseIso_naturality a k) (by simp) (by simp)

private theorem relative_rebase
    (P : MorphismProperty C) [P.RespectsIso]
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hf : (P.inverseImage (Over.forget S)).presheaf f.left) :
    (P.inverseImage (Over.forget A)).presheaf ((rebase a).map f) := by
  apply MorphismProperty.relative.of_exists
  intro b g
  let q := chartOver a g
  let W := hf.rep.pullback q.left
  let p : W ⟶ (Over.map a).obj b := hf.rep.snd q.left
  let c : Over A := Over.mk (p.left ≫ b.hom)
  let k : c ⟶ b := Over.homMk p.left rfl
  let e : (Over.map a).obj c ≅ W := Over.isoMk (Iso.refl _) (by
    change (𝟙 W.left) ≫ W.hom = (p.left ≫ b.hom) ≫ a
    rw [Category.id_comp, Category.assoc]
    exact p.w.symm)
  let j : yoneda.obj ((Over.map a).obj c) ⟶ T.left :=
    yoneda.map e.hom ≫ hf.rep.fst q.left
  have hj : j ≫ T.hom = yoneda.map (representedToBase a c) := by
    change (yoneda.map e.hom ≫ hf.rep.fst q.left) ≫ T.hom = _
    rw [Category.assoc, ← f.w,
      ← Category.assoc (hf.rep.fst q.left) f.left T'.hom, (hf.rep.isPullback q.left).w]
    rw [Category.assoc, q.w]
    change yoneda.map e.hom ≫ yoneda.map p ≫ yoneda.map (representedToBase a b) = _
    rw [← yoneda.map_comp, ← yoneda.map_comp]
    congr 1
    apply Over.OverMorphism.ext
    simp [e, representedToBase, c]
  let j' : representedOverBase a c ⟶ T := Over.homMk j hj
  have hc : IsPullback j (yoneda.map ((Over.map a).map k)) f.left q.left := by
    refine (hf.rep.isPullback q.left).of_iso (yoneda.mapIso e).symm (Iso.refl _)
      (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [j]
    · change yoneda.map p ≫ 𝟙 _ = yoneda.map e.inv ≫ yoneda.map ((Over.map a).map k)
      rw [Category.comp_id, ← yoneda.map_comp]
      congr 1
      apply Over.OverMorphism.ext
      simp [e, k, c]
    · simp
    · simp
  refine ⟨c, (representedRebaseIso a c).inv ≫ (rebase a).map j', k, ?_, ?_⟩
  · simpa only [q, chartOver_rebase] using
      rebase_isPullback_of_represented_left a f j' q k hc
  · exact hf.property_snd q.left

private theorem relative_diagonal_rebase
    (P : MorphismProperty C) [P.RespectsIso]
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hf : (P.inverseImage (Over.forget S)).presheaf (pullback.diagonal f.left)) :
    (P.inverseImage (Over.forget A)).presheaf (pullback.diagonal ((rebase a).map f)) := by
  let D : Over (yoneda.obj (Over.mk a)) :=
    Over.mk (pullback.fst f.left f.left ≫ T.hom)
  let l : D ⟶ T := Over.homMk (pullback.fst f.left f.left) rfl
  let r : D ⟶ T := Over.homMk (pullback.snd f.left f.left) (by
    change pullback.snd f.left f.left ≫ T.hom = pullback.fst f.left f.left ≫ T.hom
    rw [← f.w, ← Category.assoc, ← Category.assoc, pullback.condition])
  let d : T ⟶ D := Over.homMk (pullback.diagonal f.left) (by
    change pullback.diagonal f.left ≫ (pullback.fst f.left f.left ≫ T.hom) = T.hom
    simp)
  have hD : IsPullback ((rebase a).map l) ((rebase a).map r) ((rebase a).map f)
      ((rebase a).map f) := rebase_map_isPullback a (IsPullback.of_hasPullback f.left f.left)
  let e := hD.isoPullback
  have hl : d ≫ l = 𝟙 T := by
    apply Over.OverMorphism.ext
    exact pullback.diagonal_fst f.left
  have hr : d ≫ r = 𝟙 T := by
    apply Over.OverMorphism.ext
    exact pullback.diagonal_snd f.left
  have hd : (rebase a).map d ≫ e.hom = pullback.diagonal ((rebase a).map f) := by
    apply pullback.hom_ext
    · rw [Category.assoc, hD.isoPullback_hom_fst,
        ← CategoryTheory.Functor.map_comp, hl, CategoryTheory.Functor.map_id]
      simp
    · rw [Category.assoc, hD.isoPullback_hom_snd,
        ← CategoryTheory.Functor.map_comp, hr, CategoryTheory.Functor.map_id]
      simp
  rw [← hd]
  exact MorphismProperty.RespectsIso.postcomp _ e.hom _ (relative_rebase a P d hf)

private theorem exists_rebased_chart
    {T : Over (yoneda.obj (Over.mk a))} (U : Over S) (j : yoneda.obj U ⟶ T.left) :
    ∃ (b : Over A) (e : (Over.map a).obj b ≅ U)
      (k : representedOverBase a b ⟶ T), k.left = yoneda.map e.hom ≫ j := by
  let α : U ⟶ Over.mk a := yoneda.preimage (j ≫ T.hom)
  let b : Over A := Over.mk α.left
  let e : (Over.map a).obj b ≅ U := Over.isoMk (Iso.refl _) (by
    change (𝟙 U.left) ≫ U.hom = α.left ≫ a
    rw [Category.id_comp]
    exact α.w.symm)
  refine ⟨b, e, Over.homMk (yoneda.map e.hom ≫ j) ?_, rfl⟩
  change (yoneda.map e.hom ≫ j) ≫ T.hom = yoneda.map (representedToBase a b)
  rw [Category.assoc, ← yoneda.map_preimage (j ≫ T.hom), ← yoneda.map_comp]
  congr 1
  apply Over.OverMorphism.ext
  simp [e, representedToBase, b, α]

private theorem relative_rebased_chart
    (P : MorphismProperty C) [P.RespectsIso]
    {T : Over (yoneda.obj (Over.mk a))} {b : Over A}
    (k : representedOverBase a b ⟶ T)
    (hk : (P.inverseImage (Over.forget S)).presheaf k.left) :
    (P.inverseImage (Over.forget A)).presheaf
      ((representedRebaseIso a b).inv ≫ (rebase a).map k) :=
  MorphismProperty.RespectsIso.precomp _ _ _ (relative_rebase a P k hk)

private theorem property_diagonal_comp_iso [HasPullbacks C]
    (P : MorphismProperty C) [P.RespectsIso] {X Y Z : C}
    (f : X ⟶ Y) (g : Y ⟶ Z) (hg : IsIso g) (hf : P (pullback.diagonal f)) :
    P (pullback.diagonal (f ≫ g)) := by
  have := hg
  have h : IsPullback (pullback.fst f f) (pullback.snd f f) (f ≫ g) (f ≫ g) :=
    (IsPullback.of_hasPullback f f).of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _)
      (asIso g) (by simp) (by simp) (by simp) (by simp)
  have hd : pullback.diagonal f ≫ h.isoPullback.hom = pullback.diagonal (f ≫ g) := by
    apply pullback.hom_ext
    · simp
    · simp
  rw [← hd]
  exact MorphismProperty.RespectsIso.postcomp P _ _ hf

private theorem rebased_chart_comm
    {T T' : Over (yoneda.obj (Over.mk a))} {b c : Over A}
    (f : T ⟶ T') (j : representedOverBase a b ⟶ T)
    (k : representedOverBase a c ⟶ T') (l : b ⟶ c)
    (h : yoneda.map ((Over.map a).map l) ≫ k.left = j.left ≫ f.left) :
    yoneda.map l ≫ ((representedRebaseIso a c).inv ≫ (rebase a).map k) =
      ((representedRebaseIso a b).inv ≫ (rebase a).map j) ≫ (rebase a).map f := by
  have h' : representedOverBaseMap a l ≫ k = j ≫ f := Over.OverMorphism.ext h
  apply (cancel_epi (representedRebaseIso a b).hom).mp
  simp only [← Category.assoc, Iso.hom_inv_id, Category.id_comp]
  rw [← representedRebaseIso_naturality]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  rw [← CategoryTheory.Functor.map_comp, h', CategoryTheory.Functor.map_comp]

private theorem exists_rebased_chart_diagram
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (U V : Over S) (j : yoneda.obj U ⟶ T.left) (k : yoneda.obj V ⟶ T'.left)
    (h : U ⟶ V) (comm : yoneda.map h ≫ k = j ≫ f.left) :
    ∃ (b c : Over A) (eU : (Over.map a).obj b ≅ U) (eV : (Over.map a).obj c ≅ V)
      (j' : representedOverBase a b ⟶ T) (k' : representedOverBase a c ⟶ T')
      (l : b ⟶ c),
      j'.left = yoneda.map eU.hom ≫ j ∧ k'.left = yoneda.map eV.hom ≫ k ∧
      (Over.map a).map l = eU.hom ≫ h ≫ eV.inv ∧
      yoneda.map l ≫ ((representedRebaseIso a c).inv ≫ (rebase a).map k') =
        ((representedRebaseIso a b).inv ≫ (rebase a).map j') ≫ (rebase a).map f := by
  obtain ⟨b, eU, j', hj⟩ := exists_rebased_chart a U j
  obtain ⟨c, eV, k', hk⟩ := exists_rebased_chart a V k
  let m := eU.hom ≫ h ≫ eV.inv
  have hm : yoneda.map m ≫ k'.left = j'.left ≫ f.left := by
    rw [hk, hj]
    simp only [m, CategoryTheory.Functor.map_comp, Category.assoc]
    rw [← Category.assoc (yoneda.map eV.inv) (yoneda.map eV.hom) k,
      ← CategoryTheory.Functor.map_comp, Iso.inv_hom_id,
      CategoryTheory.Functor.map_id, Category.id_comp, comm]
  have hmBase : m ≫ representedToBase a c = representedToBase a b := by
    apply yoneda.map_injective
    rw [CategoryTheory.Functor.map_comp]
    change yoneda.map m ≫ (representedOverBase a c).hom = (representedOverBase a b).hom
    rw [← k'.w, ← Category.assoc, hm, Category.assoc, f.w, j'.w]
  let l : b ⟶ c := Over.homMk m.left (congrArg (fun g => g.left) hmBase)
  have hl : (Over.map a).map l = m := Over.OverMorphism.ext rfl
  refine ⟨b, c, eU, eV, j', k', l, hj, hk, hl, ?_⟩
  apply rebased_chart_comm a f j' k' l
  rwa [hl]

@[implicit_reducible]
private def rebaseEquivalence :
    Over (yoneda.obj (Over.mk a)) ≌ ((Over A)ᵒᵖ ⥤ Type v) :=
  (OverShriek.presheafEquivalence (U := Over.mk a)).symm.trans
    (Over.iteratedSliceEquiv (Over.mk a)).op.congrLeft

@[implicit_reducible]
private def fiberInclusion (T : Over (yoneda.obj (Over.mk a))) :
    (rebaseEquivalence a).functor.obj T ⟶
      (OverShriek.relocalizeRestrict a).obj T.left where
  app W := ↾fun s => s.1
  naturality := by intros; rfl

@[implicit_reducible]
private def fiberTerminalMap (T : Over (yoneda.obj (Over.mk a))) :
    (rebaseEquivalence a).functor.obj T ⟶ yoneda.obj (Over.mk (𝟙 A)) where
  app W := ↾fun _ => Over.homMk W.unop.hom (by simp)
  naturality := by intros; ext; apply Over.OverMorphism.ext; simp

private theorem fiber_isPullback (T : Over (yoneda.obj (Over.mk a))) :
    IsPullback (fiberInclusion a T) (fiberTerminalMap a T)
      (((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom) (sectionMap a) := by
  have hc : fiberInclusion a T ≫ ((Over.post (OverShriek.relocalizeRestrict a)).obj T).hom =
      fiberTerminalMap a T ≫ sectionMap a := by
    ext W s
    exact s.2
  refine IsPullback.of_isLimit (PullbackCone.IsLimit.mk hc (fun t => ?_) ?_ ?_ ?_)
  · refine { app := fun W => ↾fun x => ⟨t.fst.app W x, ?_⟩
             naturality := ?_ }
    · exact congrArg (fun e => e.app W x) t.condition
    · intro W W' g
      ext x
      apply Subtype.ext
      exact NatTrans.naturality_apply t.fst g x
  · intro t
    ext W x
    rfl
  · intro t
    exact representedTerminal_hom_ext _ _
  · intro t m hm₁ hm₂
    ext W x
    apply Subtype.ext
    exact congrArg (fun e => e.app W x) hm₁

@[implicit_reducible]
private def rebaseIso : (rebaseEquivalence a).functor ≅ rebase a :=
  NatIso.ofComponents (fun T => (fiber_isPullback a T).isoPullback) (by
    intro T T' f
    refine (IsPullback.of_hasPullback
      (((Over.post (OverShriek.relocalizeRestrict a)).obj T').hom) (sectionMap a)).hom_ext ?_ ?_
    · refine Eq.trans ((Category.assoc _ _ _).trans
        (congrArg (fun t => (rebaseEquivalence a).functor.map f ≫ t)
          (fiber_isPullback a T').isoPullback_hom_fst)) ?_
      refine Eq.trans (rfl : (rebaseEquivalence a).functor.map f ≫ fiberInclusion a T' =
        fiberInclusion a T ≫ (OverShriek.relocalizeRestrict a).map (Over.Hom.left f)) ?_
      exact ((Category.assoc _ _ _).trans
        ((congrArg (fun t => (fiber_isPullback a T).isoPullback.hom ≫ t)
            (rebase_map_fst a f)).trans
          ((Category.assoc _ _ _).symm.trans
            (congrArg (fun t => t ≫ (OverShriek.relocalizeRestrict a).map (Over.Hom.left f))
              (fiber_isPullback a T).isoPullback_hom_fst)))).symm
    · exact representedTerminal_hom_ext _ _)

private theorem rebase_isEquivalence : (rebase a).IsEquivalence :=
  Functor.isEquivalence_of_iso (rebaseIso a)

private theorem isPullback_of_rebase
    {T₁ T₂ : Over (yoneda.obj (Over.mk a))} {b c : Over A}
    (f : T₁ ⟶ T₂) (p : T₁ ⟶ representedOverBase a b)
    (q : T₂ ⟶ representedOverBase a c) (k : b ⟶ c)
    (h : IsPullback ((rebase a).map f)
      ((rebase a).map p ≫ (representedRebaseIso a b).hom)
      ((rebase a).map q ≫ (representedRebaseIso a c).hom) (yoneda.map k)) :
    IsPullback f.left p.left q.left (yoneda.map ((Over.map a).map k)) := by
  let := rebase_isEquivalence a
  have hr : IsPullback f p q (representedOverBaseMap a k) := by
    apply IsPullback.of_map_of_faithful (rebase a)
    exact h.of_iso (Iso.refl _) (Iso.refl _)
      (representedRebaseIso a b).symm (representedRebaseIso a c).symm
      (by simp) (by simp) (by simp) (by
        have hn := representedRebaseIso_naturality a k
        simpa only [Category.assoc, Iso.hom_inv_id, Iso.inv_hom_id_assoc,
          Iso.symm_hom, Category.comp_id] using
          (congrArg (fun t => (representedRebaseIso a b).inv ≫ t ≫
            (representedRebaseIso a c).inv) hn).symm)
  exact hr.map (Over.forget _)

end Rebase

end AlgebraicGeometry

