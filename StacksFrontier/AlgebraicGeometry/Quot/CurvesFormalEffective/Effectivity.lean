/-!
# Effectivity of formal curves: the main theorems

Stacks 0E7R for a tower of representable levels, and the effectivity of formal objects of the
stack of curves (Stacks 0D58), first conditional on the algebraization statement and then on the
existence of scheme neighbourhoods in codimension one.

The file `StacksFrontier/AlgebraicGeometry/Quot/CurvesFormalEffective.lean` re-exports this part. -/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits IsLocalRing Cardinal

namespace AlgebraicGeometry

universe u v w

attribute [local instance] MorphismProperty.IsStableUnderBaseChange.respectsIso
  MorphismProperty.RespectsIso.inverseImage
  MorphismProperty.IsMultiplicative.toContainsIdentities
  MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  MorphismProperty.IsStableUnderComposition.inverseImage
  MorphismProperty.relative_isStableUnderComposition
  MorphismProperty.relative_isMultiplicative
  CategoryTheory.Functor.map_isIso

set_option synthInstance.maxHeartbeats 400000 in
-- instance search for `HasPullbacks` of presheaves on the big fppf site times out by default
/-- Pullbacks of presheaves on the big fppf site over `S` (instance search times out
without this shortcut). -/
local instance hasPullbacks_presheaf_Effectivity (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) : HasPullbacks ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) := inferInstance

local instance (priority := high) hasPullback_presheaf_Effectivity
    {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

/-- **[Stacks, Tag 0E7R] for a tower of representable levels.** Let `A` be a complete local
Noetherian ring and let `Fₙ` be algebraic spaces over the thickenings `Spec (A / 𝔪ⁿ⁺¹)` with
cartesian squares, `F₀` proper of dimension at most one. If every `Fₙ` is representable, then the
conclusion of `AlgebraicGeometry.Space.FormalProjectiveAlgebraizationDimLEOne` holds for the
tower: there is a projective `X ⟶ Spec A` in the site whose adic fibres are the `Fₙ`, compatibly
with the structure maps and the transitions.

The tower is read on the representing schemes, where the scheme case of the tag,
`Stacks.AdicTowerDimOneAlgebraization.exists_isProjectiveMorphism_of_topologicalKrullDim_le_one`,
applies with no carried input; its cartesian squares are then carried back along Yoneda. What
the source adds to this is that the levels *are* representable: the closed level by
Stacks 0ADD, and then every level by Stacks 05ZR. -/
public theorem formalProjectiveAlgebraization_of_isRepresentable
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [IsAdicComplete (maximalIdeal A) A]
    (B : AlgebraicGeometry.BigFppfSite.{u}) (hS : B.Contains (Spec (.of A)))
    (hSn : ∀ n, B.Contains (adicThickening A (maximalIdeal A) n))
    (F : ℕ → (AlgebraicGeometry.BigFppfOver B (Spec (.of A)) hS)ᵒᵖ ⥤ Type u)
    (hF : ∀ n, AlgebraicGeometry.IsAlgebraicSpace B (Spec (.of A)) hS (F n))
    (q : ∀ n, F n ⟶ yoneda.obj
      (AlgebraicGeometry.Space.adicThickeningObject A (maximalIdeal A) B hS hSn n))
    (i : ∀ n, F n ⟶ F (n + 1))
    (hcart : ∀ n, IsPullback (i n) (q n) (q (n + 1))
      (yoneda.map (AlgebraicGeometry.Space.adicThickeningSuccMap A (maximalIdeal A) B hS hSn n)))
    (hproper : AlgebraicGeometry.Space.IsProper B (Spec (.of A)) hS (q 0))
    (hdim : AlgebraicGeometry.Space.dimension B (Spec (.of A)) hS (F 0) (hF 0) ≤ 1)
    (hrep : ∀ n, (F n).IsRepresentable) :
    ∃ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)),
      IsProjective f ∧
      ∃ hX : B.Contains X,
        let Xobj : AlgebraicGeometry.BigFppfOver B (Spec (.of A)) hS :=
          Over.mk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hS)
        let fX : yoneda.obj Xobj ⟶ yoneda.obj (AlgebraicGeometry.Space.baseObject A B hS) :=
          yoneda.map (Over.homMk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hS))
        ∃ e : ∀ n, F n ≅ AlgebraicGeometry.Space.adicFibre A (maximalIdeal A) B hS hSn fX n,
          (∀ n, (e n).hom ≫ pullback.snd fX
            (yoneda.map (AlgebraicGeometry.Space.adicThickeningMap A (maximalIdeal A) B hS hSn
              n)) = q n) ∧
          (∀ n, i n ≫ (e (n + 1)).hom =
            (e n).hom ≫
              AlgebraicGeometry.Space.adicFibreSucc A (maximalIdeal A) B hS hSn fX n) := by
  let toS := AlgebraicGeometry.BigFppfOver.toScheme B (Spec (.of A)) hS
  let Xn (n : ℕ) := toS.obj (F n).reprX
  let qn (n : ℕ) : Xn n ⟶ adicThickening A (maximalIdeal A) n :=
    toS.map (yoneda.preimage ((F n).reprW.hom ≫ q n))
  let jn (n : ℕ) : Xn n ⟶ Xn (n + 1) :=
    toS.map (yoneda.preimage ((F n).reprW.hom ≫ i n ≫ (F (n + 1)).reprW.inv))
  have hcartn (n : ℕ) : IsPullback (jn n) (qn n) (qn (n + 1))
      (adicThickeningSucc A (maximalIdeal A) n) :=
    represented_pullback_is_scheme_pullback B (Spec (.of A)) hS (q n) (q (n + 1))
      (AlgebraicGeometry.Space.adicThickeningSuccMap A (maximalIdeal A) B hS hSn n)
      (i n) (hcart n)
  have hp0 : IsProper (qn 0) := represented_morphism_isProper
    B (Spec (.of A)) hS (hF 0) _ (q 0) hproper
  have hd0 : topologicalKrullDim (Xn 0 : Type u) ≤ 1 :=
    (dimension_scheme_le_of_yoneda_iso B (Spec (.of A)) hS (F 0).reprX (hF 0)
      (F 0).reprW).trans hdim
  obtain ⟨X, f, hproj, j, hj, hpb⟩ :=
    Stacks.AdicTowerDimOneAlgebraization.exists_isProjectiveMorphism_of_topologicalKrullDim_le_one
      A (maximalIdeal A) inferInstance qn jn hcartn hp0 hd0
  have hX : B.Contains X :=
    AlgebraicGeometry.Space.contains_of_isProjectiveMorphism B (Spec (.of A)) hS
      (D := AlgebraicGeometry.Space.baseObject A B hS) f hproj
  refine ⟨X, f, hproj.isProjective, hX, ?_⟩
  let Xobj : AlgebraicGeometry.BigFppfOver B (Spec (.of A)) hS :=
    Over.mk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hS)
  let fSite : Xobj ⟶ AlgebraicGeometry.Space.baseObject A B hS :=
    Over.homMk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hS)
  let qSite (n : ℕ) := yoneda.preimage ((F n).reprW.hom ≫ q n)
  have hqSite (n : ℕ) : yoneda.map (qSite n) = (F n).reprW.hom ≫ q n :=
    yoneda.map_preimage _
  let jSite (n : ℕ) : (F n).reprX ⟶ Xobj :=
    Over.homMk (ObjectProperty.homMk (j n)) (by
      apply ObjectProperty.hom_ext
      change j n ≫ f = _
      rw [(hpb n).w]
      exact congrArg (fun k => k.hom) (qSite n).w)
  have hpbSite (n : ℕ) : IsPullback (jSite n) (qSite n) fSite
      (AlgebraicGeometry.Space.adicThickeningMap A (maximalIdeal A) B hS hSn n) := by
    apply (IsPullback.map_iff (F := toS)
      (by
        apply Functor.map_injective toS
        exact (hpb n).w)).mp
    exact hpb n
  let g (n : ℕ) : F n ⟶ yoneda.obj Xobj :=
    (F n).reprW.inv ≫ yoneda.map (jSite n)
  have hpbF (n : ℕ) : IsPullback (g n) (q n) (yoneda.map fSite)
      (yoneda.map (AlgebraicGeometry.Space.adicThickeningMap A (maximalIdeal A) B hS hSn n)) := by
    apply IsPullback.of_iso ((hpbSite n).map yoneda) (F n).reprW
      (Iso.refl _) (Iso.refl _) (Iso.refl _)
    · simp [g]
    · simp [hqSite]
    · simp
    · simp
  have hg (n : ℕ) : i n ≫ g (n + 1) = g n := by
    apply (cancel_epi (F n).reprW.hom).mp
    let k := yoneda.preimage ((F n).reprW.hom ≫ i n ≫ (F (n + 1)).reprW.inv)
    have hk : yoneda.map k = (F n).reprW.hom ≫ i n ≫ (F (n + 1)).reprW.inv :=
      yoneda.map_preimage _
    have hkSite : k ≫ jSite (n + 1) = jSite n := by
      apply Functor.map_injective toS
      exact hj n
    have hmap := congrArg (fun a => yoneda.map a) hkSite
    rw [Functor.map_comp, hk] at hmap
    simpa only [g, Category.assoc, Iso.hom_inv_id_assoc] using hmap
  change ∃ e : ∀ n, F n ≅ AlgebraicGeometry.Space.adicFibre A (maximalIdeal A) B hS hSn
      (yoneda.map fSite) n, _
  refine ⟨fun n => (hpbF n).isoPullback, ?_, ?_⟩
  · intro n
    exact (hpbF n).isoPullback_hom_snd
  · intro n
    apply pullback.hom_ext
    · simp only [Category.assoc, AlgebraicGeometry.Space.adicFibreSucc, pullback.lift_fst]
      rw [(hpbF (n + 1)).isoPullback_hom_fst, (hpbF n).isoPullback_hom_fst]
      exact hg n
    · simp only [Category.assoc, AlgebraicGeometry.Space.adicFibreSucc, pullback.lift_snd]
      rw [(hpbF (n + 1)).isoPullback_hom_snd,
        (hpbF n).isoPullback_hom_snd_assoc]
      exact (hcart n).w

/-- The part of Stacks 0D58 after the algebraization: a projective model of the rebased tower of
a formal object makes it effective. -/
private theorem isEffective_of_rebasedLevel_algebraization
    (B : AlgebraicGeometry.BigFppfSite.{u})
    (hZ : B.Contains AlgebraicGeometry.integerBase)
    (ξ : Deformation.Artin.FormalObject B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ))
    [IsNoetherianRing ξ.base.R] [IsAdicComplete (maximalIdeal ξ.base.R) ξ.base.R]
    (hA : B.Contains (Spec (.of ξ.base.R)))
    (halg : ∃ (X : Scheme.{u}) (f : X ⟶ Spec (.of ξ.base.R)),
      IsProjective f ∧
      ∃ hX : B.Contains X,
        let Xobj : AlgebraicGeometry.BigFppfOver B (Spec (.of ξ.base.R)) hA :=
          Over.mk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hA)
        let fX : yoneda.obj Xobj ⟶ yoneda.obj
            (AlgebraicGeometry.Space.baseObject ξ.base.R B hA) :=
          yoneda.map (Over.homMk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hA))
        ∃ e : ∀ n, rebasedLevel B hZ ξ hA n ≅ AlgebraicGeometry.Space.adicFibre ξ.base.R
            (maximalIdeal ξ.base.R) B hA ξ.contains fX n,
          (∀ n, (e n).hom ≫ pullback.snd fX
            (yoneda.map (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R
              (maximalIdeal ξ.base.R) B hA ξ.contains n)) = rebasedLevelProjection B hZ ξ hA n) ∧
          (∀ n, rebasedLevelTransition B hZ ξ hA n ≫ (e (n + 1)).hom =
            (e n).hom ≫ AlgebraicGeometry.Space.adicFibreSucc ξ.base.R (maximalIdeal ξ.base.R)
              B hA ξ.contains fX n)) :
    Deformation.Artin.FormalObject.IsEffective B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ)
      (Functor.IsFiberedInGroupoids.of_comp_over
        (B.obj hZ) (AlgebraicGeometry.curvesProjection B hZ)
        (curvesProjectionOver B hZ) (by rfl)
        (AlgebraicGeometry.curvesProjection_isFiberedInGroupoids B hZ)) ξ := by
  let F := rebasedLevel B hZ ξ hA
  let q := rebasedLevelProjection B hZ ξ hA
  let i := rebasedLevelTransition B hZ ξ hA
  have hF : ∀ n, AlgebraicGeometry.IsAlgebraicSpace B (Spec (.of ξ.base.R)) hA (F n) :=
    rebasedLevel_isAlgebraicSpace B hZ ξ hA
  obtain ⟨X, f, hprojective, hX, e, he, hcompat⟩ := halg
  have : IsProper f := hprojective.isProper
  have hfp : AlgebraicGeometry.FinitePresentation f :=
    AlgebraicGeometry.finitePresentation_of_finiteType f
  let Xobj : AlgebraicGeometry.BigFppfOver B (Spec (.of ξ.base.R)) hA :=
    Over.mk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hA)
  let m : Xobj ⟶ AlgebraicGeometry.Space.baseObject ξ.base.R B hA :=
    Over.homMk (ObjectProperty.homMk f : B.obj hX ⟶ B.obj hA)
  have hflat_n (n : ℕ) : Flat (pullback.snd f
      (AlgebraicGeometry.adicThickeningι ξ.base.R (maximalIdeal ξ.base.R) n)) :=
    flat_pullback_of_formal_iso B (Spec (.of ξ.base.R)) hA m
      (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R)
        B hA ξ.contains n) (q n) (e n) (he n)
      (rebasedLevel_isFlat B hZ ξ hA n)
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : Flat f := flat_of_flat_adicThickenings (.of ξ.base.R) f hflat_n
  let g := AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R)
    B hA ξ.contains 0
  let P := pullback m g
  let eP : yoneda.obj P ≅ F 0 := PreservesPullback.iso yoneda m g ≪≫ (e 0).symm
  have hdimP : topologicalKrullDim P.left.obj ≤ 1 :=
    (dimension_scheme_le_of_yoneda_iso B (Spec (.of ξ.base.R)) hA P (hF 0) eP).trans
      (rebasedClosedLevel_dimension_le_one B hZ ξ hA)
  let eQ := ((IsPullback.of_hasPullback m g).map
    (AlgebraicGeometry.BigFppfOver.toScheme B (Spec (.of ξ.base.R)) hA)).isoPullback
  have hdimQ : topologicalKrullDim (pullback f g.left.hom : Scheme.{u}) ≤ 1 := by
    have h : topologicalKrullDim P.left.obj =
        topologicalKrullDim (pullback f g.left.hom : Scheme.{u}) :=
      eQ.hom.homeomorph.isHomeomorph.topologicalKrullDim_eq
    exact h ▸ hdimP
  let k := ξ.base.R ⧸ maximalIdeal ξ.base.R ^ (0 + 1)
  have : (maximalIdeal ξ.base.R ^ (0 + 1)).IsMaximal := by
    simpa only [zero_add, pow_one] using maximalIdeal.isMaximal ξ.base.R
  let : Field k := Ideal.Quotient.field _
  have : IsLocalHom (Ideal.Quotient.mk (maximalIdeal ξ.base.R ^ (0 + 1))) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hcp : g.left.hom (closedPoint k) = closedPoint ξ.base.R := Spec_closedPoint
  have hdimClosed : AlgebraicGeometry.Scheme.Hom.fiberDimension f (closedPoint ξ.base.R) ≤ 1 := by
    have h := congrFun (AlgebraicGeometry.Scheme.Hom.fiberDimension_pullback_snd f g.left.hom)
      (closedPoint k)
    change AlgebraicGeometry.Scheme.Hom.fiberDimension (pullback.snd f g.left.hom) (closedPoint k) =
      AlgebraicGeometry.Scheme.Hom.fiberDimension f (g.left.hom (closedPoint k)) at h
    rw [hcp] at h
    rw [← h]
    exact (fiberDimension_le_dimension _ _).trans hdimQ
  have hdim := fiberDimension_le_of_closedFiber f hfp hdimClosed
  let a := completeBaseArrow B hZ ξ hA
  let U := (Over.map a).obj Xobj
  let V := (Over.map a).obj (AlgebraicGeometry.Space.baseObject ξ.base.R B hA)
  let fZ : U ⟶ V := (Over.map a).map m
  have : IsProper fZ.left.hom := (show IsProper f from inferInstance)
  have : Flat fZ.left.hom := (show Flat f from inferInstance)
  have : IsLocallyNoetherian V.left.obj :=
    (show IsLocallyNoetherian (Spec (.of ξ.base.R)) from inferInstance)
  have hproperZ := isProper_yoneda_map B AlgebraicGeometry.integerBase hZ fZ
    (show IsProper fZ.left.hom from inferInstance)
  let C : AlgebraicGeometry.CurveFamily B hZ := {
    base := V
    total := AlgebraicGeometry.schemeSpace U
    toBase := AlgebraicGeometry.schemeSpaceMap fZ
    flat := holdsOnEveryEtaleChart_yoneda_map B AlgebraicGeometry.integerBase hZ (@Flat)
      AlgebraicGeometry.Flat.isEtaleLocalOnSourceAndTarget fZ inferInstance
    proper := hproperZ
    finitePresentation := ⟨locallyOfFinitePresentation_yoneda_map
      B AlgebraicGeometry.integerBase hZ fZ, hproperZ.2.1.2,
      AlgebraicGeometry.Space.isQuasiSeparated_of_isSeparated B AlgebraicGeometry.integerBase hZ
        hproperZ.1⟩
    relativeDimensionLE := relativeDimensionLE_yoneda_of_fiberDimension_le
      B AlgebraicGeometry.integerBase hZ fZ 1 hdim }
  let R := Rebase.rebase a
  let : R.IsEquivalence := Rebase.rebase_isEquivalence a
  let j (n : ℕ) : levelOverCompleteBase B hZ ξ hA n ⟶
      Rebase.representedOverBase a Xobj :=
    R.preimage ((e n).hom ≫ pullback.fst _ _ ≫ (Rebase.representedRebaseIso a Xobj).inv)
  have hj (n : ℕ) : R.map (j n) =
      (e n).hom ≫ pullback.fst _ _ ≫ (Rebase.representedRebaseIso a Xobj).inv :=
    R.map_preimage _
  have hcartZ (n : ℕ) : IsPullback (j n).left (levelProjection B hZ ξ hA n)
      (yoneda.map fZ) (yoneda.map ((Over.map a).map
        (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R) B hA ξ.contains
          n))) := by
    apply Rebase.isPullback_of_rebase a (j n)
      (levelOverCompleteBaseProjection B hZ ξ hA n)
      (Rebase.representedOverBaseMap a m)
    have H := IsPullback.of_hasPullback (yoneda.map m)
      (yoneda.map (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R)
        B hA ξ.contains n))
    refine H.of_iso (e n).symm (Rebase.representedRebaseIso a Xobj).symm
      (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · change _ = (e n).inv ≫ R.map (j n)
      rw [hj]
      simp
      rfl
    · change _ = (e n).inv ≫ q n
      exact ((Iso.inv_comp_eq (e n)).2 (he n).symm).symm
    · have hn := Rebase.representedRebaseIso_naturality a m
      simpa only [Category.assoc, Iso.inv_hom_id_assoc, Iso.refl_hom,
        Iso.symm_hom, Category.comp_id] using
        (congrArg (fun t => (Rebase.representedRebaseIso a Xobj).inv ≫ t) hn).symm
    · simp
  have hjnat (n : ℕ) : levelOverCompleteBaseTransition B hZ ξ hA n ≫ j (n + 1) = j n := by
    apply R.map_injective
    rw [R.map_comp, hj, hj]
    change i n ≫ ((e (n + 1)).hom ≫ _ ≫ _) = _
    rw [← Category.assoc, hcompat n]
    simp [AlgebraicGeometry.Space.adicFibreSucc, Category.assoc]
  let r (n : ℕ) : ξ.level n ⟶ C := {
    baseMap := (levelBaseIso B hZ ξ hA n).hom ≫ (Over.map a).map
      (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R) B hA ξ.contains n)
    totalMap := ObjectProperty.homMk (j n).left
    cartesian := by
      apply IsPullback.of_map_of_faithful (ObjectProperty.ι (AlgebraicGeometry.IsAlgebraicSpace B
        AlgebraicGeometry.integerBase hZ))
      change IsPullback (j n).left (ξ.level n).toBase.hom (yoneda.map fZ)
        (yoneda.map ((levelBaseIso B hZ ξ hA n).hom ≫ (Over.map a).map
          (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R) B hA
            ξ.contains n)))
      have H := hcartZ n
      exact H.of_iso (Iso.refl _) (Iso.refl _)
        (yoneda.mapIso (levelBaseIso B hZ ξ hA n)).symm (Iso.refl _)
        (by simp) (by
          have he : yoneda.map (levelBaseIso B hZ ξ hA n).hom ≫
              yoneda.map (levelBaseIso B hZ ξ hA n).inv = 𝟙 _ := by
            rw [← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
              CategoryTheory.Functor.map_id]
          simp only [levelProjection, Iso.symm_hom, Functor.mapIso_inv, Iso.refl_hom]
          exact ((Category.assoc _ _ _).trans
            ((congrArg (fun t => (ξ.level n).toBase.hom ≫ t) he).trans
              (Category.comp_id _))).trans (Category.id_comp _).symm)
        (by simp)
        (by
          have he' : yoneda.map (levelBaseIso B hZ ξ hA n).inv ≫
              yoneda.map (levelBaseIso B hZ ξ hA n).hom = 𝟙 _ := by
            rw [← CategoryTheory.Functor.map_comp, Iso.inv_hom_id,
              CategoryTheory.Functor.map_id]
          exact ((Category.id_comp _).symm.trans
            (congrArg (fun t => t ≫ yoneda.map ((Over.map a).map
              (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R) B hA
                ξ.contains n))) he'.symm)).trans (Category.assoc _ _ _)) }
  have hrnat (n : ℕ) : ξ.transition n ≫ r (n + 1) = r n := by
    apply AlgebraicGeometry.CurveFamily.Hom.ext
    · change (ξ.transition n).baseMap ≫
          ((levelBaseIso B hZ ξ hA (n + 1)).hom ≫ _) = _
      rw [← Category.assoc, levelTransition_base, Category.assoc, ← Functor.map_comp]
      congr 2
      apply Over.OverMorphism.ext
      apply ObjectProperty.hom_ext
      exact AlgebraicGeometry.adicThickeningSucc_ι _ _ n
    · apply ObjectProperty.hom_ext
      exact congrArg Over.Hom.left (hjnat n)
  let p := curvesProjectionOver B hZ
  let hp : p.IsFiberedInGroupoids := Functor.IsFiberedInGroupoids.of_comp_over
    (B.obj hZ) (AlgebraicGeometry.curvesProjection B hZ) p (by rfl)
    (AlgebraicGeometry.curvesProjection_isFiberedInGroupoids B hZ)
  have hCV : p.obj C = Deformation.Artin.baseOver B AlgebraicGeometry.integerBase hZ ξ.base hA := by
    change Over.mk ((𝟙 (B.obj hA)) ≫ a) = Over.mk a
    rw [Category.id_comp]
  let x : Deformation.Artin.CompleteLocalObjects B AlgebraicGeometry.integerBase hZ p :=
    ⟨⟨C, ξ.base, hA, hCV⟩⟩
  let G := Deformation.Artin.approximationFunctor B AlgebraicGeometry.integerBase hZ p hp
  let η := G.obj x
  obtain ⟨s, hbase, hcart, hsnat, hsnatural, hsbase⟩ :=
    (Deformation.Artin.approximationFunctorData B AlgebraicGeometry.integerBase hZ p hp).property
  have hηA : B.Contains (Spec (.of η.base.R)) := by
    change B.Contains (Spec (.of (G.obj x).base.R))
    rw [hbase x]
    exact Deformation.Artin.chosenContains B AlgebraicGeometry.integerBase hZ p x.obj
  let hchosen := Deformation.Artin.chosenBase_eq B AlgebraicGeometry.integerBase hZ p x.obj
  let hchange := baseOver_congr B AlgebraicGeometry.integerBase hZ (hbase x) hηA
    (Deformation.Artin.chosenContains B AlgebraicGeometry.integerBase hZ p x.obj)
  let eBase : Deformation.Artin.baseOver B AlgebraicGeometry.integerBase hZ η.base hηA ≅
      Deformation.Artin.baseOver B AlgebraicGeometry.integerBase hZ ξ.base hA :=
    eqToIso hchange ≪≫ (eqToIso hchosen).symm ≪≫ eqToIso hCV
  let T := AlgebraicGeometry.BigFppfOver.toScheme B AlgebraicGeometry.integerBase hZ
  let aBase : Spec (.of η.base.R) ≅ Spec (.of ξ.base.R) := T.mapIso eBase
  have haBase : aBase.hom ≫ ξ.base.toS = η.base.toS :=
    congrArg (fun t => t.hom) eBase.hom.w
  choose en hen using exists_adicThickeningIso (.of η.base.R) (.of ξ.base.R) aBase
  let bn (n : ℕ) :
      Deformation.Artin.truncationOver B AlgebraicGeometry.integerBase hZ η.base η.contains n ≅
      Deformation.Artin.truncationOver B AlgebraicGeometry.integerBase hZ ξ.base ξ.contains n :=
    Over.isoMk (ObjectProperty.isoMk _ (en n)) (by
      apply ObjectProperty.hom_ext
      change (en n).hom ≫ (AlgebraicGeometry.adicThickeningι ξ.base.R (maximalIdeal ξ.base.R) n ≫
        ξ.base.toS) =
          AlgebraicGeometry.adicThickeningι η.base.R (maximalIdeal η.base.R) n ≫ η.base.toS
      rw [← Category.assoc, hen n, Category.assoc, haBase])
  let b (n : ℕ) : p.obj (η.level n) ≅ p.obj (ξ.level n) :=
    eqToIso (η.level_eq n) ≪≫ bn n ≪≫ (eqToIso (ξ.level_eq n)).symm
  have hsn (n : ℕ) : T.map (eqToHom (η.level_eq n).symm ≫ p.map (s x n) ≫
      eqToHom hCV) = AlgebraicGeometry.adicThickeningι η.base.R (maximalIdeal η.base.R) n ≫
        aBase.hom := by
    have h0 : T.map (eqToHom (η.level_eq n).symm ≫ p.map (s x n) ≫ eqToHom hchosen) =
        AlgebraicGeometry.adicThickeningι η.base.R (maximalIdeal η.base.R) n ≫ eqToHom
          (congrArg
            (fun A : Deformation.Artin.FormalBase AlgebraicGeometry.integerBase => Spec (.of A.R))
            (hbase x)) := hsbase x n
    have h := (congrArg (fun t => t ≫ T.map (eqToHom hchosen.symm ≫ eqToHom hCV)) h0).trans
      (Category.assoc _ _ _)
    simp only [aBase, eBase, Functor.mapIso_hom, Iso.trans_hom, eqToIso.hom,
      Iso.symm_hom, eqToIso.inv, Functor.map_comp, Category.assoc, eqToHom_map,
      eqToHom_trans] at h ⊢
    exact h.trans (congrArg (fun t => AlgebraicGeometry.adicThickeningι η.base.R
      (maximalIdeal η.base.R) n ≫ t) (eqToHom_trans _ _))
  have hrn (n : ℕ) : T.map (eqToHom (ξ.level_eq n).symm ≫ p.map (r n) ≫
      eqToHom hCV) = AlgebraicGeometry.adicThickeningι ξ.base.R (maximalIdeal ξ.base.R) n := by
    have h2 : T.map (p.map (r n)) = T.map (levelBaseIso B hZ ξ hA n).hom ≫
        T.map ((Over.map a).map (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R
          (maximalIdeal ξ.base.R) B hA ξ.contains n)) := by
      rw [← CategoryTheory.Functor.map_comp]
      rfl
    have h3 : T.map (levelBaseIso B hZ ξ hA n).hom =
        eqToHom (congrArg T.obj (ξ.level_eq n)) := eqToHom_map T (ξ.level_eq n)
    have h4 : T.map (eqToHom (ξ.level_eq n).symm) =
        eqToHom (congrArg T.obj (ξ.level_eq n).symm) := eqToHom_map T (ξ.level_eq n).symm
    have h5 : T.map (eqToHom hCV) = eqToHom (congrArg T.obj hCV) := eqToHom_map T hCV
    rw [T.map_comp, T.map_comp, h2, h3, h4, h5]
    have hC0 : eqToHom (congrArg T.obj hCV) = 𝟙 _ := rfl
    have e12 : eqToHom (congrArg T.obj (ξ.level_eq n).symm) ≫
        eqToHom (congrArg T.obj (ξ.level_eq n)) = 𝟙 _ := (eqToHom_trans _ _).trans rfl
    have key : T.map ((Over.map a).map (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R
          (maximalIdeal ξ.base.R) B hA ξ.contains n)) ≫ eqToHom (congrArg T.obj hCV) =
        AlgebraicGeometry.adicThickeningι ξ.base.R (maximalIdeal ξ.base.R) n :=
      (congrArg (fun t => T.map ((Over.map a).map
        (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R) B hA
          ξ.contains n)) ≫ t) hC0).trans (Category.comp_id _)
    exact (congrArg (fun t => eqToHom (congrArg T.obj (ξ.level_eq n).symm) ≫ t)
        (Category.assoc _ _ _)).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ (T.map ((Over.map a).map
            (AlgebraicGeometry.Space.adicThickeningMap ξ.base.R (maximalIdeal ξ.base.R) B hA
              ξ.contains n)) ≫ eqToHom (congrArg T.obj hCV))) e12).trans
          ((Category.id_comp _).trans key)))
  have hb (n : ℕ) : (b n).hom ≫ p.map (r n) = p.map (s x n) := by
    apply (cancel_epi (eqToHom (η.level_eq n).symm)).mp
    apply (cancel_mono (eqToHom hCV)).mp
    apply T.map_injective
    have hl : eqToHom (η.level_eq n).symm ≫ ((b n).hom ≫ p.map (r n)) ≫ eqToHom hCV =
        (bn n).hom ≫ (eqToHom (ξ.level_eq n).symm ≫ p.map (r n) ≫ eqToHom hCV) := by
      simp [b, Category.assoc]
    simp only [Category.assoc] at hl ⊢
    rw [hl, T.map_comp, hrn, hsn]
    exact hen n
  have hm (n : ℕ) : Mono (p.map (r n)) := by
    have hi :
        IsClosedImmersion (AlgebraicGeometry.adicThickeningι ξ.base.R (maximalIdeal ξ.base.R) n) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    have hn := hrn n
    have : Mono (T.map (eqToHom (ξ.level_eq n).symm ≫ p.map (r n) ≫ eqToHom hCV)) :=
      hn.symm ▸ (inferInstance : Mono (AlgebraicGeometry.adicThickeningι ξ.base.R
        (maximalIdeal ξ.base.R) n))
    have : Mono (eqToHom (ξ.level_eq n).symm ≫ p.map (r n) ≫ eqToHom hCV) :=
      T.mono_of_mono_map inferInstance
    have : Mono (p.map (r n) ≫ eqToHom hCV) :=
      (mono_comp_iff_of_isIso (eqToHom (ξ.level_eq n).symm) _).mp inferInstance
    exact mono_of_mono (p.map (r n)) (eqToHom hCV)
  exact ⟨x, formalObject_iso_of_cones p hp (fun n => s x n) r
    (hsnat x) hrnat b hb hm⟩

/-- **Stacks 0D58, with Stacks 0E7R and Stacks 0ADD carried as hypotheses.** Every formal
object of the stack `Curves` of families of curves over `Spec(ℤ)` is effective: it comes, up
to isomorphism of formal objects, from a family of curves over the spectrum of its complete
local base.

This is the source's whole argument for Stacks 0D58, with everything specific to families of
curves discharged. The two inputs it is conditional on are the two the source quotes and this
library does not prove: `h0E7R` is Stacks 0E7R, the projective algebraization of a cartesian
tower of algebraic spaces whose closed member is proper of dimension at most one, and `h0ADD`
is Stacks 0ADD, the existence of a schematic open neighbourhood of a codimension-at-most-one
point of a separated locally Noetherian algebraic space, which enters only through 0E7R's
hypothesis that the closed member of the tower is a scheme.

Both carried inputs are *other tags'* results, neither being this tag's own assertion nor any
part of it: each speaks only of algebraic spaces over a complete local ring, and mentions no
stack, no formal object and no effectivity. Stacks 0ADD is a citation of Stacks 0E7R's proof
rather than of this tag's; see the module docstring for why the rendering used here hoists it.
The tag itself is registered, unconditionally, at
`AlgebraicGeometry.curvesFormalObject_isEffective`.
-/
public theorem curvesFormalObject_isEffective_of_algebraization
    (h0E7R : AlgebraicGeometry.Space.FormalProjectiveAlgebraizationDimLEOne.{u})
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u})
    (B : AlgebraicGeometry.BigFppfSite.{u})
    (hZ : B.Contains AlgebraicGeometry.integerBase)
    (ξ : Deformation.Artin.FormalObject B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ)) :
    Deformation.Artin.FormalObject.IsEffective B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ)
      (Functor.IsFiberedInGroupoids.of_comp_over
        (B.obj hZ) (AlgebraicGeometry.curvesProjection B hZ)
        (curvesProjectionOver B hZ) (by rfl)
        (AlgebraicGeometry.curvesProjection_isFiberedInGroupoids B hZ)) ξ := by
  let hA := formalBase_spec_mem B AlgebraicGeometry.integerBase ξ.base ξ.contains
  have : IsNoetherianRing ξ.base.R := ξ.base.noetherian
  have : IsAdicComplete (maximalIdeal ξ.base.R) ξ.base.R := ξ.base.complete
  exact isEffective_of_rebasedLevel_algebraization B hZ ξ hA (h0E7R
    ξ.base.R B hA ξ.contains _ (rebasedLevel_isAlgebraicSpace B hZ ξ hA) _ _
    (rebasedLevel_isPullback B hZ ξ hA)
    (rebasedClosedLevel_isProper B hZ ξ hA h0ADD)
    (rebasedClosedLevel_dimension_le_one B hZ ξ hA))


/-- **Stacks 0D58, from Stacks 0ADD alone.** Every formal object of the stack `Curves` over
`Spec(ℤ)` is effective, granted Stacks 0ADD in the form
`AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne`.

This is the source's argument with Stacks 0E7R discharged: every level of the tower of the
formal object is a scheme — it is separated, locally Noetherian and of dimension at most one
(`rebasedLevel_dimension_le_one`), so Stacks 0ADD applies at each of its points — and for a
tower of schemes Stacks 0E7R is
`AlgebraicGeometry.formalProjectiveAlgebraization_of_isRepresentable`. The input `h0ADD` is the
only one left; this declaration carries no tag. -/
public theorem curvesFormalObject_isEffective_of_schemeNeighbourhoods
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u})
    (B : AlgebraicGeometry.BigFppfSite.{u})
    (hZ : B.Contains AlgebraicGeometry.integerBase)
    (ξ : Deformation.Artin.FormalObject B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ)) :
    Deformation.Artin.FormalObject.IsEffective B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ)
      (Functor.IsFiberedInGroupoids.of_comp_over
        (B.obj hZ) (AlgebraicGeometry.curvesProjection B hZ)
        (curvesProjectionOver B hZ) (by rfl)
        (AlgebraicGeometry.curvesProjection_isFiberedInGroupoids B hZ)) ξ := by
  let hA := formalBase_spec_mem B AlgebraicGeometry.integerBase ξ.base ξ.contains
  have : IsNoetherianRing ξ.base.R := ξ.base.noetherian
  have : IsAdicComplete (maximalIdeal ξ.base.R) ξ.base.R := ξ.base.complete
  exact isEffective_of_rebasedLevel_algebraization B hZ ξ hA
    (formalProjectiveAlgebraization_of_isRepresentable
      ξ.base.R B hA ξ.contains _ (rebasedLevel_isAlgebraicSpace B hZ ξ hA) _ _
      (rebasedLevel_isPullback B hZ ξ hA)
      (rebasedClosedLevel_isProper B hZ ξ hA h0ADD)
      (rebasedClosedLevel_dimension_le_one B hZ ξ hA)
      (rebasedLevel_isRepresentable B hZ ξ hA h0ADD))

