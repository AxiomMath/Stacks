private theorem isSeparated_rebase
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hf : AlgebraicGeometry.Space.IsSeparated B S hS f.left) :
    AlgebraicGeometry.Space.IsSeparated B A hA ((Rebase.rebase a).map f) :=
  Rebase.relative_diagonal_rebase a
    (MorphismProperty.inverseImage
      (@IsClosedImmersion.{u} : MorphismProperty Scheme.{u}) B.inclusion) f hf

private theorem surjectiveEtaleChart_rebase
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    (P : MorphismProperty Scheme.{u}) [P.RespectsIso]
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hf : AlgebraicGeometry.Space.HoldsOnSurjectiveEtaleChart B S hS P f.left) :
    AlgebraicGeometry.Space.HoldsOnSurjectiveEtaleChart B A hA P ((Rebase.rebase a).map f) := by
  obtain ⟨U, V, j, k, h, hj, hk, hjs, comm, hp⟩ := hf
  obtain ⟨b, c, eU, eV, j', k', l, hj', hk', hl, hcomm⟩ :=
    Rebase.exists_rebased_chart_diagram a f U V j k h comm
  refine ⟨b, c, (Rebase.representedRebaseIso a b).inv ≫ (Rebase.rebase a).map j',
    (Rebase.representedRebaseIso a c).inv ≫ (Rebase.rebase a).map k', l,
    ?_, ?_, ?_, hcomm, ?_⟩
  · apply Rebase.relative_rebased_chart a
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u}) B.inclusion)
    rw [hj']
    exact MorphismProperty.RespectsIso.precomp _ _ _ hj
  · apply Rebase.relative_rebased_chart a
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u}) B.inclusion)
    rw [hk']
    exact MorphismProperty.RespectsIso.precomp _ _ _ hk
  · apply Rebase.relative_rebased_chart a
      (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u}) B.inclusion)
    rw [hj']
    exact MorphismProperty.RespectsIso.precomp _ _ _ hjs
  · change P ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map ((Over.map a).map l))
    rw [hl, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp]
    apply MorphismProperty.RespectsIso.precomp
    exact MorphismProperty.RespectsIso.postcomp _ _ _ hp

private theorem holdsOnEveryEtaleChart_rebase
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    (P : MorphismProperty Scheme.{u}) [P.RespectsIso]
    (hP : AlgebraicGeometry.IsEtaleLocalOnSourceAndTarget P)
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hT : AlgebraicGeometry.IsAlgebraicSpace B S hS T.left)
    (hT' : AlgebraicGeometry.IsAlgebraicSpace B S hS T'.left)
    (hR : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T))
    (hR' : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T'))
    (hf : AlgebraicGeometry.Space.HoldsOnEveryEtaleChart B S hS P f.left) :
    AlgebraicGeometry.Space.HoldsOnEveryEtaleChart B A hA P ((Rebase.rebase a).map f) := by
  apply (AlgebraicGeometry.Space.holdsOnEveryEtaleChart_iff_surjectiveChart
    B A hA P hP hR hR' _).2
  apply surjectiveEtaleChart_rebase B S A hS hA a P f
  exact (AlgebraicGeometry.Space.holdsOnEveryEtaleChart_iff_surjectiveChart
    B S hS P hP hT hT' f.left).1 hf

private theorem isLocallyOfFiniteType_rebase
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hT : AlgebraicGeometry.IsAlgebraicSpace B S hS T.left)
    (hT' : AlgebraicGeometry.IsAlgebraicSpace B S hS T'.left)
    (hR : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T))
    (hR' : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T'))
    (hf : AlgebraicGeometry.Space.IsLocallyOfFiniteType B S hS f.left) :
    AlgebraicGeometry.Space.IsLocallyOfFiniteType B A hA ((Rebase.rebase a).map f) := by
  apply (AlgebraicGeometry.Space.holdsOnEveryEtaleChart_iff_surjectiveChart
    B A hA (@LocallyOfFiniteType : MorphismProperty Scheme.{u})
    AlgebraicGeometry.isEtaleLocalOnSourceAndTarget_locallyOfFiniteType
    hR hR' _).2
  apply surjectiveEtaleChart_rebase B S A hS hA a _ f
  exact (AlgebraicGeometry.Space.holdsOnEveryEtaleChart_iff_surjectiveChart
    B S hS (@LocallyOfFiniteType : MorphismProperty Scheme.{u})
    AlgebraicGeometry.isEtaleLocalOnSourceAndTarget_locallyOfFiniteType
    hT hT' f.left).1 hf

private theorem quasiCompact_rebase
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    (T : Over (yoneda.obj (Over.mk a)))
    (hT : AlgebraicGeometry.Space.IsQuasiCompactSpace B S hS T.left) :
    AlgebraicGeometry.Space.IsQuasiCompactSpace B A hA ((Rebase.rebase a).obj T) := by
  obtain ⟨U, j, hU, hjSurj, hjEtale⟩ := hT
  let PE := MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
    (AlgebraicGeometry.BigFppfOver.toScheme B S hS)
  have : PE.ContainsIdentities := containsIdentities_inverseImage_toScheme_etale B S hS
  have hjE : PE.presheaf j := by
    simpa using hjEtale U (𝟙 _) (CategoryTheory.MorphismProperty.presheaf_id PE _)
  obtain ⟨b, e, k, hk⟩ := Rebase.exists_rebased_chart a U j
  let kb := (Rebase.representedRebaseIso a b).inv ≫ (Rebase.rebase a).map k
  have hkE : PE.presheaf k.left := by
    rw [hk]
    exact MorphismProperty.RespectsIso.precomp _ _ _ hjE
  have hkbE := Rebase.relative_rebased_chart a
    (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u}) B.inclusion) k hkE
  refine ⟨b, kb, ?_, ?_, ?_⟩
  · let : CompactSpace ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).obj U) := hU
    exact (Scheme.homeoOfIso
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).mapIso e)).symm.compactSpace
  · apply Rebase.relative_rebased_chart a
      (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u}) B.inclusion) k
    rw [hk]
    exact MorphismProperty.RespectsIso.precomp _ _ _ hjSurj
  · intro V φ hφ
    exact MorphismProperty.comp_mem _ _ _ hφ hkbE

private theorem dimension_rebase_le
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    (T : Over (yoneda.obj (Over.mk a)))
    (hT : AlgebraicGeometry.IsAlgebraicSpace B S hS T.left)
    (hR : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T)) :
    AlgebraicGeometry.Space.dimension B A hA ((Rebase.rebase a).obj T) hR ≤
      AlgebraicGeometry.Space.dimension B S hS T.left hT := by
  obtain ⟨U, j, hjs, hje⟩ := hT.exists_atlas
  obtain ⟨b, e, k, hk⟩ := Rebase.exists_rebased_chart a U j
  let kb := (Rebase.representedRebaseIso a b).inv ≫ (Rebase.rebase a).map k
  have hke : (MorphismProperty.inverseImage (@Etale.{u})
      (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf k.left := by
    rw [hk]
    exact MorphismProperty.RespectsIso.precomp _ _ _ hje
  have hkbe : (MorphismProperty.inverseImage (@Etale.{u})
      (AlgebraicGeometry.BigFppfOver.toScheme B A hA)).presheaf kb :=
    Rebase.relative_rebased_chart a
      (MorphismProperty.inverseImage (@Etale.{u}) B.inclusion) k hke
  have hkbs : (MorphismProperty.inverseImage (@Surjective.{u})
      (AlgebraicGeometry.BigFppfOver.toScheme B A hA)).presheaf kb := by
    apply Rebase.relative_rebased_chart a
      (MorphismProperty.inverseImage (@Surjective.{u}) B.inclusion) k
    rw [hk]
    exact MorphismProperty.RespectsIso.precomp _ _ _ hjs
  have hsurj := (AlgebraicGeometry.Space.presheafSurjective_iff_isSurjective_yoneda B A hA
    ((Rebase.rebase a).obj T) hR b kb).mp hkbs
  apply iSup_le
  intro x
  obtain ⟨z, hz⟩ := hsurj x
  obtain ⟨q, rfl⟩ := Quot.exists_rep z
  let q' : AlgebraicGeometry.Space.FieldValuedPoint B S hS (yoneda.obj ((Over.map a).obj b)) := {
    carrier := q.carrier
    contained := q.contained
    toBase := q.toBase ≫ a.hom
    value := (Over.map a).map q.value }
  rw [AlgebraicGeometry.Space.dimensionAtPoint_eq_of_etale_chart B A hA
    ((Rebase.rebase a).obj T) hR x b kb hkbe q hz]
  let y := AlgebraicGeometry.Space.pointsMap B S hS (yoneda.obj ((Over.map a).obj b)) k.left
    (q'.class B S hS _)
  calc
    _ = AlgebraicGeometry.Space.dimensionAtPoint B S hS T.left hT y :=
      (AlgebraicGeometry.Space.dimensionAtPoint_eq_of_etale_chart B S hS T.left hT y
        ((Over.map a).obj b) k.left hke q' rfl).symm
    _ ≤ _ := le_iSup _ y

private theorem formalBase_spec_mem
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u})
    (A : Deformation.Artin.FormalBase S)
    (htrunc : ∀ n, B.Contains (A.truncation n)) :
    B.Contains (Spec (.of A.R)) := by
  let R := A.R
  let I := maximalIdeal R
  let Q : ℕ → Type u := fun n => R ⧸ I ^ (n + 1)
  have hQ (n : ℕ) : Cardinal.mk (Q n) < B.cutoff := by
    have hn : (AlgebraicGeometry.adicThickening R I n).size < B.cutoff := htrunc n
    rw [Scheme.size_Spec] at hn
    exact lt_of_le_of_lt (le_max_right ℵ₀ _) hn
  let s : Cardinal.{u} := ⨆ n : ULift.{u} ℕ, Cardinal.mk (Q n.down)
  have hs : s < B.cutoff := by
    change (⨆ n : ULift.{u} ℕ, Cardinal.mk (Q n.down)) < B.cutoff
    apply Cardinal.iSup_lt_of_lt_cof_ord
    · simpa using B.aleph0_lt_cutoff_cof
    · intro n
      exact hQ n.down
  let : IsAdicComplete I R := A.complete
  have hInj : Function.Injective (fun x : R => fun n : ℕ =>
      Ideal.Quotient.mk (I ^ (n + 1)) x) := by
    intro x y h
    apply (IsHausdorff.eq_iff_smodEq (I := I) (M := R)).2
    intro n
    rw [SModEq.sub_mem]
    have hm : x - y ∈ I ^ (n + 1) :=
      (Ideal.Quotient.mk_eq_mk_iff_sub_mem x y).1 (congrFun h n)
    simpa [smul_eq_mul, Ideal.mul_top] using
      (Ideal.pow_le_pow_right (I := I) (Nat.le_succ n)) hm
  have hprod : Cardinal.mk (∀ n, Q n) ≤ s ^ ℵ₀ := by
    rw [Cardinal.mk_pi]
    calc
      Cardinal.prod (fun n : ℕ => Cardinal.mk (Q n)) ≤
          Cardinal.prod (fun _ : ℕ => s) :=
        Cardinal.prod_le_prod _ _ (fun n =>
          le_ciSup Cardinal.bddAbove_of_small (ULift.up n))
      _ = s ^ ℵ₀ := by simp [Cardinal.prod_const, s]
  have hRle : Cardinal.mk R ≤ Cardinal.mk (∀ n, Q n) :=
    Cardinal.mk_le_of_injective hInj
  have hR : Cardinal.mk R < B.cutoff := by
    apply lt_of_le_of_lt (le_trans hRle hprod)
    exact Cardinal.power_aleph0_lt_of_isStrongPrelimit
      B.aleph0_lt_cutoff B.cutoff_isStrongPrelimit hs
  change (Spec (.of R)).size < B.cutoff
  rw [Scheme.size_Spec]
  exact max_lt B.aleph0_lt_cutoff hR



private theorem formalCurveLevelTransition_overBase
    (B : AlgebraicGeometry.BigFppfSite.{u})
    (hZ : B.Contains AlgebraicGeometry.integerBase)
    (ξ : Deformation.Artin.FormalObject B AlgebraicGeometry.integerBase hZ
      (curvesProjectionOver B hZ)) (n : ℕ) :
    eqToHom (ξ.level_eq n).symm ≫
        (curvesProjectionOver B hZ).map (ξ.transition n) ≫
        eqToHom (ξ.level_eq (n + 1)) =
      Deformation.Artin.truncationOverSucc B AlgebraicGeometry.integerBase hZ
        ξ.base ξ.contains n := by
  let : (curvesProjectionOver B hZ).IsHomLift
      (R := Deformation.Artin.truncationOver B AlgebraicGeometry.integerBase hZ
        ξ.base ξ.contains n)
      (S := Deformation.Artin.truncationOver B AlgebraicGeometry.integerBase hZ
        ξ.base ξ.contains (n + 1))
      (a := ξ.level n) (b := ξ.level (n + 1))
      (Deformation.Artin.truncationOverSucc B AlgebraicGeometry.integerBase hZ
        ξ.base ξ.contains n) (ξ.transition n) := ξ.transition_lift n
  rw [IsHomLift.fac' (curvesProjectionOver B hZ)
    (Deformation.Artin.truncationOverSucc B AlgebraicGeometry.integerBase hZ
      ξ.base ξ.contains n) (ξ.transition n)]
  simp

private theorem isPullback_presheaf_of_isPullback
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {W X Y Z : AlgebraicGeometry.AlgebraicSpaces B S hS}
    {i : W ⟶ X} {j : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
    (h : IsPullback i j f g) : IsPullback i.hom j.hom f.hom g.hom := by
  let h' := AlgebraicGeometry.AlgebraicSpaces.isPullback_fiberProduct B S hS f g
  let e := h.isLimit.conePointUniqueUpToIso h'.isLimit
  let inc := ObjectProperty.ι (AlgebraicGeometry.IsAlgebraicSpace B S hS)
  refine IsPullback.of_iso_pullback ⟨congrArg (fun k => k.hom) h.w⟩
    (inc.mapIso e) ?_ ?_
  · exact congrArg (fun k => k.hom)
      (IsLimit.conePointUniqueUpToIso_hom_comp h.isLimit h'.isLimit WalkingCospan.left)
  · exact congrArg (fun k => k.hom)
      (IsLimit.conePointUniqueUpToIso_hom_comp h.isLimit h'.isLimit WalkingCospan.right)

private theorem isLocallyOfFiniteType_of_finitePresentation
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F G : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {f : F ⟶ G} (hf : AlgebraicGeometry.Space.IsFinitePresentation B S hS f) :
    AlgebraicGeometry.Space.IsLocallyOfFiniteType B S hS f := by
  intro U V a b k ha hb hk
  let : LocallyOfFinitePresentation
      ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map k) :=
    hf.1 U V a b k ha hb hk
  infer_instance

private theorem isUniversallyClosed_iff_presheaf
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : AlgebraicGeometry.IsAlgebraicSpace B S hS X)
    (hY : AlgebraicGeometry.IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (hf : yoneda.relativelyRepresentable f) :
    AlgebraicGeometry.Space.UniversallyClosed B S hS f ↔
      (MorphismProperty.inverseImage (@UniversallyClosed.{u} : MorphismProperty Scheme.{u})
        (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf f :=
  (AlgebraicGeometry.Space.presheaf_universallyClosed_iff B S hS hX hY hf).symm

private theorem isProper_iff_presheaf
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {X Y : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hX : AlgebraicGeometry.IsAlgebraicSpace B S hS X)
    (hY : AlgebraicGeometry.IsAlgebraicSpace B S hS Y) (f : X ⟶ Y)
    (hf : yoneda.relativelyRepresentable f) :
    AlgebraicGeometry.Space.IsProper B S hS f ↔
      (MorphismProperty.inverseImage (@IsProper.{u} : MorphismProperty Scheme.{u})
        (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf f := by
  have hsep := AlgebraicGeometry.Space.isSeparated_iff_presheaf
    B S hS f hX hY hf
  let : MorphismProperty.IsLocalAtTarget (@LocallyOfFiniteType :
      MorphismProperty Scheme.{u}) Scheme.fppfPrecoverage :=
    Stacks.Descent.locallyOfFiniteType_isLocalAtTarget_fppf
  have hlft := AlgebraicGeometry.Space.holdsOnEveryEtaleChart_iff_relative B S hS
    (@LocallyOfFiniteType : MorphismProperty Scheme.{u})
    AlgebraicGeometry.isEtaleLocalOnSourceAndTarget_locallyOfFiniteType
    hX hY f hf
  have huc := isUniversallyClosed_iff_presheaf B S hS hX hY f hf
  constructor
  · intro hp
    refine ⟨hf, ?_⟩
    intro A C g fst snd hpb
    change IsProper ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map snd)
    rw [AlgebraicGeometry.isProper_iff]
    exact ⟨(hsep.mp hp.1).property g fst snd hpb,
      (huc.mp hp.2.2).property g fst snd hpb,
      (hlft.mp hp.2.1.1).property g fst snd hpb⟩
  · intro hp
    have hrep := hp.1
    have hparts (U V : AlgebraicGeometry.BigFppfOver B S hS)
        (g : yoneda.obj U ⟶ Y) (fst : yoneda.obj V ⟶ X) (snd : V ⟶ U)
        (hpb : IsPullback fst (yoneda.map snd) f g) :=
      (AlgebraicGeometry.isProper_iff (f :=
        (AlgebraicGeometry.BigFppfOver.toScheme B S hS).map snd)).mp
        (hp.property g fst snd hpb)
    have hsep' := hsep.mpr ⟨hrep, fun U V g fst snd hpb => (hparts U V g fst snd hpb).1⟩
    have hlft' := hlft.mpr ⟨hrep, fun U V g fst snd hpb => (hparts U V g fst snd hpb).2.2⟩
    have huc' := huc.mpr ⟨hrep, fun U V g fst snd hpb => (hparts U V g fst snd hpb).2.1⟩
    refine ⟨hsep', ⟨hlft',
      AlgebraicGeometry.Space.isQuasiCompact_of_universallyClosed B S hS hX hY f huc'⟩, huc'⟩

private theorem isProper_rebase_of_representable
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A)
    (a : B.obj hA ⟶ B.obj hS)
    {T T' : Over (yoneda.obj (Over.mk a))} (f : T ⟶ T')
    (hT : AlgebraicGeometry.IsAlgebraicSpace B S hS T.left)
    (hT' : AlgebraicGeometry.IsAlgebraicSpace B S hS T'.left)
    (hR : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T))
    (hR' : AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T'))
    (hrep : yoneda.relativelyRepresentable f.left)
    (hf : AlgebraicGeometry.Space.IsProper B S hS f.left) :
    AlgebraicGeometry.Space.IsProper B A hA ((Rebase.rebase a).map f) := by
  let P := MorphismProperty.inverseImage (@IsProper.{u} : MorphismProperty Scheme.{u})
    B.inclusion
  have hproper : (P.inverseImage (Over.forget (B.obj hS))).presheaf f.left :=
    (isProper_iff_presheaf B S hS hT hT' f.left hrep).mp hf
  have hreb := Rebase.relative_rebase a P f hproper
  exact (isProper_iff_presheaf B A hA hR hR' ((Rebase.rebase a).map f)
    hreb.rep).mpr hreb

private theorem relativelyRepresentable_of_representable_source
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u} [F.IsRepresentable]
    {V : AlgebraicGeometry.BigFppfOver B S hS} (f : F ⟶ yoneda.obj V) :
    yoneda.relativelyRepresentable f := by
  let e := F.reprW
  have h : yoneda.relativelyRepresentable (e.hom ≫ f) := by
    rw [← yoneda.map_preimage (e.hom ≫ f)]
    exact Functor.relativelyRepresentable.map yoneda _
  have h' := MorphismProperty.RespectsIso.precomp
    yoneda.relativelyRepresentable e.inv _ h
  simpa only [← Category.assoc, Iso.inv_hom_id, Category.id_comp] using h'

private theorem isProper_yoneda_map
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U V : AlgebraicGeometry.BigFppfOver B S hS} (f : U ⟶ V)
    (hf : IsProper ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).map f)) :
    AlgebraicGeometry.Space.IsProper B S hS (yoneda.map f) := by
  let P := MorphismProperty.inverseImage (@IsProper.{u})
    (AlgebraicGeometry.BigFppfOver.toScheme B S hS)
  have : P.IsStableUnderBaseChange := ⟨by
    intro X Y Z W fst snd left right hpb hright
    exact MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @IsProper.{u}) (hpb.map (AlgebraicGeometry.BigFppfOver.toScheme B S hS)) hright⟩
  have hp : P.presheaf (yoneda.map f) :=
    (MorphismProperty.relative_map_iff (F := yoneda) (P := P)).2 hf
  exact (isProper_iff_presheaf B S hS
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS U)
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS V) (yoneda.map f) hp.rep).2 hp

private theorem isRepresentable_of_open_scheme_neighborhoods
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F)
    (hneighborhood : ∀ x : AlgebraicGeometry.Space.points B S hS F,
      ∃ U : Subfunctor F,
        AlgebraicGeometry.Space.IsOpenSubspace B S hS U ∧ U.toFunctor.IsRepresentable ∧
          x ∈ Set.range (AlgebraicGeometry.Space.pointsMap B S hS U.toFunctor U.ι)) :
    F.IsRepresentable := by
  classical
  let W := AlgebraicGeometry.Space.schematicLocus B S hS F
  obtain ⟨hW, hWrep⟩ :=
    AlgebraicGeometry.Space.isOpenSubspace_and_isRepresentable_schematicLocus_of_isAlgebraicSpace
      B S hS hF
  have hpoints (x : AlgebraicGeometry.Space.points B S hS F) :
      x ∈ Set.range (AlgebraicGeometry.Space.pointsMap B S hS W.toFunctor W.ι) := by
    obtain ⟨G, hG, hGrep, y, hy⟩ := hneighborhood x
    let k := Subfunctor.homOfLe
      (AlgebraicGeometry.Space.le_schematicLocus B S hS F G hG hGrep)
    refine ⟨AlgebraicGeometry.Space.pointsMap B S hS G.toFunctor k y, ?_⟩
    have hcomp : AlgebraicGeometry.Space.pointsMap B S hS W.toFunctor W.ι
        (AlgebraicGeometry.Space.pointsMap B S hS G.toFunctor k y) =
        AlgebraicGeometry.Space.pointsMap B S hS G.toFunctor G.ι y := by
      induction y using Quot.inductionOn with
      | h p => rfl
    exact hcomp.trans hy
  apply AlgebraicGeometry.Space.isRepresentable_of_isZariskiCover B S hS F hF
    PUnit.{u + 1} (fun _ => W)
  · apply (AlgebraicGeometry.Space.isZariskiCover_iff_iUnion_points
      B S hS F hF PUnit.{u + 1} (fun _ => W) (fun _ => hW)).2
    ext x
    constructor
    · intro _
      trivial
    · intro _
      exact Set.mem_iUnion.mpr ⟨PUnit.unit, hpoints x⟩
  · exact fun _ => hWrep

private theorem isRepresentable_of_separated_locallyNoetherian_dim_le_one
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u})
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))
    (F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F)
    (hsep : AlgebraicGeometry.Space.IsAbsolutelySeparated B S hS hZ F)
    (hnoeth : AlgebraicGeometry.Space.HasEtaleLocalProperty B S hS F
      (fun X : Scheme.{u} => IsLocallyNoetherian X))
    (hdim : ∀ x : AlgebraicGeometry.Space.points B S hS F,
      AlgebraicGeometry.Space.localRingDimension B S hS x ≤ 1) : F.IsRepresentable := by
  apply isRepresentable_of_open_scheme_neighborhoods B S hS F hF
  intro x
  exact h0ADD B S hS hZ F hF hsep hnoeth x (hdim x)

private theorem localRingDimension_le_of_dimension_le
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F)
    (d : ℕ∞)
    (hdim : AlgebraicGeometry.Space.dimension B S hS F hF ≤ (d : WithBot ℕ∞))
    (x : AlgebraicGeometry.Space.points B S hS F) :
    AlgebraicGeometry.Space.localRingDimension B S hS x ≤ d := by
  have hx : (AlgebraicGeometry.Space.localRingDimension B S hS x : WithBot ℕ∞) ≤
      (d : WithBot ℕ∞) := by
    calc
      _ ≤ ⨆ y : AlgebraicGeometry.Space.points B S hS F,
          (AlgebraicGeometry.Space.localRingDimension B S hS y : WithBot ℕ∞) := le_iSup _ x
      _ = AlgebraicGeometry.Space.dimension B S hS F hF :=
        (AlgebraicGeometry.Space.dimension_eq_iSup_localRingDimension B S hS F hF).symm
      _ ≤ _ := hdim
  exact WithBot.coe_le_coe.mp hx

theorem isRepresentable_of_separated_locallyNoetherian_dimension_le_one
    (h0ADD : AlgebraicGeometry.Space.SchemeNeighbourhoodsInCodimensionOne.{u})
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u}))
    (F : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
    (hF : AlgebraicGeometry.IsAlgebraicSpace B S hS F)
    (hsep : AlgebraicGeometry.Space.IsAbsolutelySeparated B S hS hZ F)
    (hnoeth : AlgebraicGeometry.Space.HasEtaleLocalProperty B S hS F
      (fun X : Scheme.{u} => IsLocallyNoetherian X))
    (hdim : AlgebraicGeometry.Space.dimension B S hS F hF ≤ (1 : WithBot ℕ∞)) :
    F.IsRepresentable := by
  apply isRepresentable_of_separated_locallyNoetherian_dim_le_one
    h0ADD B S hS hZ F hF hsep hnoeth
  intro x
  exact localRingDimension_le_of_dimension_le B S hS F hF 1 hdim x

private theorem holdsOnEveryEtaleChart_comp_iso
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (P : MorphismProperty Scheme.{u})
    {F G H : (AlgebraicGeometry.BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (f : F ⟶ G) (e : G ≅ H)
    (hf : AlgebraicGeometry.Space.HoldsOnEveryEtaleChart B S hS P f) :
    AlgebraicGeometry.Space.HoldsOnEveryEtaleChart B S hS P (f ≫ e.hom) := by
  let Et := (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
    (AlgebraicGeometry.BigFppfOver.toScheme B S hS)).presheaf
  intro U V j k l hj hk hcomm
  apply hf U V j (k ≫ e.inv) l hj
  · exact (Et.cancel_right_of_respectsIso k e.inv).2 hk
  · simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id] using
      congrArg (fun t => t ≫ e.inv) hcomm

private theorem separated_over_iso
    (C : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : C.Contains S)
    {F G : (AlgebraicGeometry.BigFppfOver C S hS)ᵒᵖ ⥤ Type u} (e : F ≅ G)
    (h : AlgebraicGeometry.Space.IsSeparatedOver C S hS F) :
    AlgebraicGeometry.Space.IsSeparatedOver C S hS G := by
  let P := (MorphismProperty.inverseImage (@IsClosedImmersion : MorphismProperty Scheme.{u})
    (AlgebraicGeometry.BigFppfOver.toScheme C S hS)).presheaf
  have hn : diag F ≫ prod.map e.hom e.hom = e.hom ≫ diag G := by
    apply prod.hom_ext <;> simp
  have h' := MorphismProperty.RespectsIso.postcomp P (prod.map e.hom e.hom) _ h
  rw [hn] at h'
  have := MorphismProperty.RespectsIso.precomp P e.inv _ h'
  simpa using this


private theorem isSeparated_yoneda_of_isSeparated
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u})) (U : AlgebraicGeometry.BigFppfOver B S hS)
    (hU : ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).obj U).IsSeparated) :
    AlgebraicGeometry.Space.IsAbsolutelySeparated B S hS hZ (yoneda.obj U) := by
  let g : B.obj hS ⟶ B.obj hZ := ⟨terminal.from S⟩
  let V : AlgebraicGeometry.BigFppfOver B (⊤_ Scheme.{u}) hZ := Over.mk (U.hom ≫ g)
  let T : AlgebraicGeometry.BigFppfOver B (⊤_ Scheme.{u}) hZ := Over.mk (𝟙 (B.obj hZ))
  let p : V ⟶ T := Over.homMk V.hom (by simp [T])
  have hT : AlgebraicGeometry.Space.IsSeparatedOver B (⊤_ Scheme.{u}) hZ (yoneda.obj T) := by
    have ht : IsSubterminal (yoneda.obj T) := by
      intro F first second
      ext W element
      exact (Over.mkIdTerminal : IsTerminal T).hom_ext _ _
    have : IsIso (diag (yoneda.obj T)) := ht.isIso_diag
    refine ⟨Functor.relativelyRepresentable.of_isIso yoneda _, ?_⟩
    intro A A' a b c sq
    have : IsIso (yoneda.map c) := sq.isIso_snd_of_isIso
    have : IsIso c := Yoneda.fullyFaithful.isIso_of_isIso_map c
    change IsClosedImmersion ((AlgebraicGeometry.BigFppfOver.toScheme B _ hZ).map c)
    infer_instance
  have hp : AlgebraicGeometry.Space.IsSeparated B (⊤_ Scheme.{u}) hZ (yoneda.map p) := by
    apply (AlgebraicGeometry.Space.isSeparated_yoneda_map_iff B _ hZ p).mpr
    have heq : (AlgebraicGeometry.BigFppfOver.toScheme B (⊤_ Scheme.{u}) hZ).map p =
        terminal.from ((AlgebraicGeometry.BigFppfOver.toScheme B S hS).obj U) :=
      terminal.hom_ext _ _
    rw [heq]
    exact hU.isSeparated_terminal_from
  exact separated_over_iso B _ hZ
    (Space.relocalizedYonedaRepresentableBy' B S _ hS hZ g U).toIso
    (AlgebraicGeometry.Space.isSeparatedOver_of_isSeparated B _ hZ hT hp)

/-- The rebasing of an object over an algebraic space is an algebraic space. -/
private theorem isAlgebraicSpace_rebase
    (B : AlgebraicGeometry.BigFppfSite.{u}) (S A : Scheme.{u})
    (hS : B.Contains S) (hA : B.Contains A) (a : B.obj hA ⟶ B.obj hS)
    (T : Over (yoneda.obj (Over.mk a)))
    (hT : AlgebraicGeometry.IsAlgebraicSpace B S hS T.left) :
    AlgebraicGeometry.IsAlgebraicSpace B A hA ((Rebase.rebase a).obj T) :=
  AlgebraicGeometry.isAlgebraicSpace_pullback B A hA
    ((OverShriek.relocalizeRestrict a).map T.hom) (Rebase.sectionMap a)
    (AlgebraicGeometry.isAlgebraicSpace_relocalizeRestrict B A S hA hS a T.left hT)
    (AlgebraicGeometry.isAlgebraicSpace_yoneda B A hA (Over.mk (𝟙 (B.obj hA))))
    (AlgebraicGeometry.isAlgebraicSpace_relocalizeRestrict B A S hA hS a
      (yoneda.obj (Over.mk a)) (AlgebraicGeometry.isAlgebraicSpace_yoneda B S hS (Over.mk a)))

section Tower

variable (B : AlgebraicGeometry.BigFppfSite.{u})
  (hZ : B.Contains AlgebraicGeometry.integerBase)
  (ξ : Deformation.Artin.FormalObject B AlgebraicGeometry.integerBase hZ
    (curvesProjectionOver B hZ))
  (hA : B.Contains (Spec (.of ξ.base.R)))

private abbrev completeBaseArrow : B.obj hA ⟶ B.obj hZ :=
  ObjectProperty.homMk ξ.base.toS

private abbrev thickeningOver (n : ℕ) :
    AlgebraicGeometry.BigFppfOver B (Spec (.of ξ.base.R)) hA :=
  AlgebraicGeometry.Space.adicThickeningObject ξ.base.R (maximalIdeal ξ.base.R) B hA ξ.contains n

private theorem thickeningOver_map (n : ℕ) :
    (Over.map (completeBaseArrow B hZ ξ hA)).obj (thickeningOver B hZ ξ hA n) =
      Deformation.Artin.truncationOver B AlgebraicGeometry.integerBase hZ ξ.base ξ.contains n := rfl

private def levelBaseIso (n : ℕ) :
    (ξ.level n).base ≅
      (Over.map (completeBaseArrow B hZ ξ hA)).obj (thickeningOver B hZ ξ hA n) :=
  eqToIso (ξ.level_eq n)

private def levelProjection (n : ℕ) :
    (ξ.level n).total.1 ⟶
      yoneda.obj ((Over.map (completeBaseArrow B hZ ξ hA)).obj
        (thickeningOver B hZ ξ hA n)) :=
  (ξ.level n).toBase.hom ≫ yoneda.map (levelBaseIso B hZ ξ hA n).hom

private abbrev thickeningTransition (n : ℕ) :
    thickeningOver B hZ ξ hA n ⟶ thickeningOver B hZ ξ hA (n + 1) :=
  AlgebraicGeometry.Space.adicThickeningSuccMap ξ.base.R (maximalIdeal ξ.base.R) B hA ξ.contains n

private theorem levelTransition_base (n : ℕ) :
    (ξ.transition n).baseMap ≫ (levelBaseIso B hZ ξ hA (n + 1)).hom =
      (levelBaseIso B hZ ξ hA n).hom ≫
        (Over.map (completeBaseArrow B hZ ξ hA)).map
          (thickeningTransition B hZ ξ hA n) := by
  have h := formalCurveLevelTransition_overBase B hZ ξ n
  change (levelBaseIso B hZ ξ hA n).inv ≫ (ξ.transition n).baseMap ≫
    (levelBaseIso B hZ ξ hA (n + 1)).hom = _ at h
  change (levelBaseIso B hZ ξ hA n).inv ≫ (ξ.transition n).baseMap ≫
    (levelBaseIso B hZ ξ hA (n + 1)).hom =
      (Over.map (completeBaseArrow B hZ ξ hA)).map
        (thickeningTransition B hZ ξ hA n) at h
  exact (Iso.inv_comp_eq (levelBaseIso B hZ ξ hA n)).mp h

private theorem levelProjection_isPullback (n : ℕ) :
    IsPullback (ξ.transition n).totalMap.hom (levelProjection B hZ ξ hA n)
      (levelProjection B hZ ξ hA (n + 1))
      (yoneda.map ((Over.map (completeBaseArrow B hZ ξ hA)).map
        (thickeningTransition B hZ ξ hA n))) := by
  have h := isPullback_presheaf_of_isPullback B AlgebraicGeometry.integerBase hZ
    (ξ.transition n).cartesian
  refine h.of_iso (Iso.refl _) (Iso.refl _)
    (yoneda.mapIso (levelBaseIso B hZ ξ hA n))
    (yoneda.mapIso (levelBaseIso B hZ ξ hA (n + 1))) ?_ ?_ ?_ ?_
  · simp
  · rfl
  · rfl
  · change yoneda.map (ξ.transition n).baseMap ≫
      yoneda.map (levelBaseIso B hZ ξ hA (n + 1)).hom =
        yoneda.map (levelBaseIso B hZ ξ hA n).hom ≫
          yoneda.map ((Over.map (completeBaseArrow B hZ ξ hA)).map
            (thickeningTransition B hZ ξ hA n))
    rw [← yoneda.map_comp, ← yoneda.map_comp, levelTransition_base]

private def levelOverCompleteBase (n : ℕ) :
    Over (yoneda.obj (Over.mk (completeBaseArrow B hZ ξ hA))) :=
  Over.mk (levelProjection B hZ ξ hA n ≫
    yoneda.map (Rebase.representedToBase (completeBaseArrow B hZ ξ hA)
      (thickeningOver B hZ ξ hA n)))

private def levelOverCompleteBaseProjection (n : ℕ) :
    levelOverCompleteBase B hZ ξ hA n ⟶
      Rebase.representedOverBase (completeBaseArrow B hZ ξ hA)
        (thickeningOver B hZ ξ hA n) :=
  Over.homMk (levelProjection B hZ ξ hA n) rfl

private def levelOverCompleteBaseTransition (n : ℕ) :
    levelOverCompleteBase B hZ ξ hA n ⟶ levelOverCompleteBase B hZ ξ hA (n + 1) :=
  Over.homMk (ξ.transition n).totalMap.hom (by
    change (ξ.transition n).totalMap.hom ≫
        (levelProjection B hZ ξ hA (n + 1) ≫ _) = levelProjection B hZ ξ hA n ≫ _
    rw [← Category.assoc, (levelProjection_isPullback B hZ ξ hA n).w, Category.assoc,
      ← yoneda.map_comp]
    congr 2
    apply Over.OverMorphism.ext
    exact (thickeningTransition B hZ ξ hA n).w)

private def rebasedLevel (n : ℕ) :
    (AlgebraicGeometry.BigFppfOver B (Spec (.of ξ.base.R)) hA)ᵒᵖ ⥤ Type u :=
  (Rebase.rebase (completeBaseArrow B hZ ξ hA)).obj (levelOverCompleteBase B hZ ξ hA n)

private def rebasedLevelProjection (n : ℕ) :
    rebasedLevel B hZ ξ hA n ⟶ yoneda.obj (thickeningOver B hZ ξ hA n) :=
  (Rebase.rebase (completeBaseArrow B hZ ξ hA)).map
    (levelOverCompleteBaseProjection B hZ ξ hA n) ≫
      (Rebase.representedRebaseIso (completeBaseArrow B hZ ξ hA)
        (thickeningOver B hZ ξ hA n)).hom

private def rebasedLevelTransition (n : ℕ) :
    rebasedLevel B hZ ξ hA n ⟶ rebasedLevel B hZ ξ hA (n + 1) :=
  (Rebase.rebase (completeBaseArrow B hZ ξ hA)).map
    (levelOverCompleteBaseTransition B hZ ξ hA n)

private theorem rebasedLevel_isPullback (n : ℕ) :
    IsPullback (rebasedLevelTransition B hZ ξ hA n) (rebasedLevelProjection B hZ ξ hA n)
      (rebasedLevelProjection B hZ ξ hA (n + 1))
      (yoneda.map (thickeningTransition B hZ ξ hA n)) :=
  Rebase.rebase_isPullback (completeBaseArrow B hZ ξ hA)
    (levelOverCompleteBaseTransition B hZ ξ hA n)
    (levelOverCompleteBaseProjection B hZ ξ hA n)
    (levelOverCompleteBaseProjection B hZ ξ hA (n + 1))
    (thickeningTransition B hZ ξ hA n) (levelProjection_isPullback B hZ ξ hA n)

private theorem rebasedLevel_isAlgebraicSpace (n : ℕ) :
    AlgebraicGeometry.IsAlgebraicSpace B (Spec (.of ξ.base.R)) hA (rebasedLevel B hZ ξ hA n) :=
  isAlgebraicSpace_rebase B AlgebraicGeometry.integerBase (Spec (.of ξ.base.R)) hZ hA
    (completeBaseArrow B hZ ξ hA) _ (ξ.level n).total.property

private theorem rebasedLevel_isSeparated (n : ℕ) :
    AlgebraicGeometry.Space.IsSeparated B (Spec (.of ξ.base.R)) hA
      (rebasedLevelProjection B hZ ξ hA n) := by
  have hsep : AlgebraicGeometry.Space.IsSeparated B AlgebraicGeometry.integerBase hZ
      (levelProjection B hZ ξ hA n) :=
    Rebase.property_diagonal_comp_iso
      ((MorphismProperty.inverseImage (@IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
        (AlgebraicGeometry.BigFppfOver.toScheme B AlgebraicGeometry.integerBase hZ)).presheaf)
      (ξ.level n).toBase.hom (yoneda.map (levelBaseIso B hZ ξ hA n).hom)
      (yoneda.mapIso (levelBaseIso B hZ ξ hA n)).isIso_hom
      (ξ.level n).proper.1
  have hreb := isSeparated_rebase B AlgebraicGeometry.integerBase (Spec (.of ξ.base.R))
    hZ hA (completeBaseArrow B hZ ξ hA)
    (levelOverCompleteBaseProjection B hZ ξ hA n) hsep
  exact Rebase.property_diagonal_comp_iso
    ((MorphismProperty.inverseImage (@IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
      (AlgebraicGeometry.BigFppfOver.toScheme B (Spec (.of ξ.base.R)) hA)).presheaf)
    _ _ inferInstance hreb

private theorem rebasedLevel_isLocallyOfFiniteType (n : ℕ) :
    AlgebraicGeometry.Space.IsLocallyOfFiniteType B (Spec (.of ξ.base.R)) hA
      (rebasedLevelProjection B hZ ξ hA n) := by
  let a := completeBaseArrow B hZ ξ hA
  let b := thickeningOver B hZ ξ hA n
  let T := levelOverCompleteBase B hZ ξ hA n
  let T' := Rebase.representedOverBase a b
  let f := levelOverCompleteBaseProjection B hZ ξ hA n
  have hT' : AlgebraicGeometry.IsAlgebraicSpace B AlgebraicGeometry.integerBase hZ T'.left :=
    AlgebraicGeometry.isAlgebraicSpace_yoneda B AlgebraicGeometry.integerBase hZ
      ((Over.map a).obj b)
  have hR' : AlgebraicGeometry.IsAlgebraicSpace B (Spec (.of ξ.base.R)) hA
      ((Rebase.rebase a).obj T') :=
    isAlgebraicSpace_rebase B AlgebraicGeometry.integerBase (Spec (.of ξ.base.R)) hZ hA a T' hT'
  have hlft :
      AlgebraicGeometry.Space.IsLocallyOfFiniteType B AlgebraicGeometry.integerBase hZ f.left := by
    apply holdsOnEveryEtaleChart_comp_iso B AlgebraicGeometry.integerBase hZ
      (@LocallyOfFiniteType : MorphismProperty Scheme.{u})
      (ξ.level n).toBase.hom (yoneda.mapIso (levelBaseIso B hZ ξ hA n))
    exact isLocallyOfFiniteType_of_finitePresentation B AlgebraicGeometry.integerBase hZ
      (ξ.level n).finitePresentation
  have hreb := isLocallyOfFiniteType_rebase B AlgebraicGeometry.integerBase
    (Spec (.of ξ.base.R)) hZ hA a f (ξ.level n).total.property hT'
    (rebasedLevel_isAlgebraicSpace B hZ ξ hA n) hR' hlft
  exact holdsOnEveryEtaleChart_comp_iso B (Spec (.of ξ.base.R)) hA
    (@LocallyOfFiniteType : MorphismProperty Scheme.{u}) _
    (Rebase.representedRebaseIso a b) hreb

private theorem rebasedLevel_isFlat (n : ℕ) :
    AlgebraicGeometry.Space.IsFlat B (Spec (.of ξ.base.R)) hA
      (rebasedLevelProjection B hZ ξ hA n) := by
  let a := completeBaseArrow B hZ ξ hA
  let b := thickeningOver B hZ ξ hA n
  let T := levelOverCompleteBase B hZ ξ hA n
  let T' := Rebase.representedOverBase a b
  let f := levelOverCompleteBaseProjection B hZ ξ hA n
  have hT' : AlgebraicGeometry.IsAlgebraicSpace B AlgebraicGeometry.integerBase hZ T'.left :=
    AlgebraicGeometry.isAlgebraicSpace_yoneda B AlgebraicGeometry.integerBase hZ
      ((Over.map a).obj b)
  have hR' : AlgebraicGeometry.IsAlgebraicSpace B (Spec (.of ξ.base.R)) hA
      ((Rebase.rebase a).obj T') :=
    isAlgebraicSpace_rebase B AlgebraicGeometry.integerBase (Spec (.of ξ.base.R)) hZ hA a T' hT'
  have hlft : AlgebraicGeometry.Space.IsFlat B AlgebraicGeometry.integerBase hZ f.left := by
    apply holdsOnEveryEtaleChart_comp_iso B AlgebraicGeometry.integerBase hZ
      (@Flat : MorphismProperty Scheme.{u})
      (ξ.level n).toBase.hom (yoneda.mapIso (levelBaseIso B hZ ξ hA n))
    exact (ξ.level n).flat
  have hreb := holdsOnEveryEtaleChart_rebase B AlgebraicGeometry.integerBase
    (Spec (.of ξ.base.R)) hZ hA a (@Flat)
    AlgebraicGeometry.Flat.isEtaleLocalOnSourceAndTarget f (ξ.level n).total.property hT'
    (rebasedLevel_isAlgebraicSpace B hZ ξ hA n) hR' hlft
  exact holdsOnEveryEtaleChart_comp_iso B (Spec (.of ξ.base.R)) hA
    (@Flat : MorphismProperty Scheme.{u}) _
    (Rebase.representedRebaseIso a b) hreb

