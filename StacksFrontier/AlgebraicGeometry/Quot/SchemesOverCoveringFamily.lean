module

public import StacksFrontier.AlgebraicGeometry.Quot.RelativeHom
public import StacksFrontier.AlgebraicGeometry.Spaces.CoproductInclusion
public import StacksFrontier.AlgebraicGeometry.Spaces.CoveringComparison
public import StacksFrontier.AlgebraicGeometry.Spaces.CoveringSieveStepOne
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedFppfCovering
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.SieveToFamily

/-!
# Covering sieves of the test schemes over an algebraic space contain fpqc families

Let `Y` be an algebraic space over a scheme `S` of a big fppf site.  The test schemes over `Y`
(`AlgebraicGeometry.Space.SchemesOver Y`) carry the fppf topology restricted along the
projection to the big fppf site of `S`: a sieve covers when it lies in the topology generated by
the sieves whose image in the big fppf site covers.  A covering sieve of a test scheme contains a
family of test schemes whose underlying morphisms of algebraic spaces form an fpqc covering.

## Main definitions

* `AlgebraicGeometry.Space.SchemesOver.proj`: the projection of the test schemes over `Y` to the
  big fppf site of `S`.
* `AlgebraicGeometry.Space.SchemesOver.topology`: the fppf topology on the test schemes over `Y`,
  restricted along `proj`.

## Main results

* `AlgebraicGeometry.Space.SchemesOver.functorPushforward_mem_of_mem_restrictedTopology`: the
  projection to the big fppf site carries a covering sieve of the restricted topology to a
  covering sieve.
* `AlgebraicGeometry.Space.SchemesOver.exists_isFpqcCovering_of_mem_restrictedTopology`: a
  covering sieve of a test scheme contains a family of test schemes whose underlying morphisms
  of algebraic spaces form an fpqc covering.
* `exists_isFpqcCovering_ofArrows_mem_of_mem_restrictedTopology`: such a family can be chosen to
  generate a covering sieve.

## References

* [Stacks Project, Tag 0D25](https://stacks.math.columbia.edu/tag/0D25)
* [Stacks Project, Tag 021S](https://stacks.math.columbia.edu/tag/021S)
* [Stacks Project, Tag 03Y8](https://stacks.math.columbia.edu/tag/03Y8)
* [Stacks Project, Tag 0DFQ](https://stacks.math.columbia.edu/tag/0DFQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Space.SchemesOver

universe u

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {Y : AlgebraicSpaces B S hS}

/-- The projection of the test schemes over `Y` to the big fppf site of `S`. -/
abbrev proj (Y : AlgebraicSpaces B S hS) : SchemesOver Y ⥤ BigFppfOver B S hS :=
  CostructuredArrow.proj (schemeSpaceFunctor B S hS) Y

/-- The fppf topology on the test schemes over `Y`, restricted along the projection to the big
fppf site of `S`. -/
abbrev topology (Y : AlgebraicSpaces B S hS) : GrothendieckTopology (SchemesOver Y) :=
  (proj Y).restrictedTopology (BigFppfOver.topology B S hS)

/-- A morphism of the big fppf site into the scheme of a test scheme `T`, read as a morphism of
test schemes: its source inherits the composite structure morphism. -/
abbrev liftHom (T : SchemesOver Y) {Z : BigFppfOver B S hS} (h : Z ⟶ T.left) :
    CostructuredArrow.mk ((schemeSpaceFunctor B S hS).map h ≫ T.hom) ⟶ T :=
  CostructuredArrow.homMk' T h

/-- The pullback of a sieve along a morphism of test schemes has, as its image, at least the
pullback of the image sieve. -/
theorem functorPushforward_pullback_le {X T : SchemesOver Y} (R : Sieve T) (f : X ⟶ T) :
    (R.functorPushforward (proj Y)).pullback ((proj Y).map f) ≤
      (R.pullback f).functorPushforward (proj Y) := by
  rintro Z h ⟨W, g, k, hg, hk⟩
  refine ⟨CostructuredArrow.mk ((schemeSpaceFunctor B S hS).map h ≫ X.hom), liftHom X h, 𝟙 _,
    ?_, by simp⟩
  have hk' : h ≫ f.left = k ≫ g.left := hk
  let m : CostructuredArrow.mk ((schemeSpaceFunctor B S hS).map h ≫ X.hom) ⟶ W :=
    CostructuredArrow.homMk k (by
      rw [← CostructuredArrow.w g, ← Category.assoc, ← Functor.map_comp, ← hk',
        Functor.map_comp, Category.assoc, CostructuredArrow.w f]
      rfl)
  have e : liftHom X h ≫ f = m ≫ g := CostructuredArrow.hom_ext _ _ (by simpa [m] using hk')
  rw [Sieve.pullback_apply, e]
  exact R.downward_closed hg _

/-- The image of the pullback of a sieve `R` along a member `s` of a sieve lies in the pullback
of the image of `R` along the projection of `s`. -/
theorem functorPushforward_pullback_le' {X T : SchemesOver Y} (R : Sieve T) (s : X ⟶ T) :
    (R.pullback s).functorPushforward (proj Y) ≤
      (R.functorPushforward (proj Y)).pullback ((proj Y).map s) := by
  rintro Z h ⟨W, g, k, hg, rfl⟩
  exact ⟨W, g ≫ s, k, hg, by simp⟩

/-- **The projection carries covering sieves of the restricted topology to covering sieves.** -/
theorem functorPushforward_mem_of_mem_restrictedTopology {T : SchemesOver Y} {R : Sieve T}
    (hR : R ∈ topology Y T) :
    R.functorPushforward (proj Y) ∈ BigFppfOver.topology B S hS ((proj Y).obj T) := by
  change (Precoverage.comap (proj Y) (BigFppfOver.topology B S hS).toPrecoverage).Saturate T R
    at hR
  induction hR with
  | of X P hP =>
      rw [← Sieve.generate_map_eq_functorPushforward]
      exact hP
  | top X =>
      rw [Sieve.functorPushforward_top]
      exact GrothendieckTopology.top_mem _ _
  | pullback X R _ Z f ih =>
      exact GrothendieckTopology.superset_covering _ (functorPushforward_pullback_le R f)
        (GrothendieckTopology.pullback_stable _ _ ih)
  | transitive X R R' _ _ ihR ihR' =>
      refine GrothendieckTopology.transitive _ ihR _ ?_
      rintro Z h ⟨W, s, k, hs, rfl⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ _
        (GrothendieckTopology.superset_covering _ (functorPushforward_pullback_le' R' s)
          (ihR' hs))

/-- If a covering family `E` of the big fppf site factors through members `g i` of test schemes,
the induced family of test schemes underlies an fpqc covering of algebraic spaces. -/
private theorem isFpqcCovering_liftHom_comp_of_isCovering {T : SchemesOver Y}
    {E : PreZeroHypercover.{u + 1} ((proj Y).obj T)} (hE : BigFppfOver.IsCovering B S hS ⟨_, E⟩)
    {W : E.I₀ → SchemesOver Y} (g : ∀ i, W i ⟶ T) (k : ∀ i, E.X i ⟶ (W i).left)
    (hk : ∀ i, E.f i = k i ≫ (g i).left) :
    IsFpqcCovering B S hS fun i ↦
      ((schemeSpaceFunctor B S hS).map (liftHom (W i) (k i) ≫ g i).left).hom := by
  have hfam : (fun i ↦ ((schemeSpaceFunctor B S hS).map
      (liftHom (W i) (k i) ≫ g i).left).hom) = fun i ↦ yoneda.map (E.f i) := by
    funext i
    rw [hk i]
    rfl
  rw [hfam]
  obtain ⟨hsurj, hgeom⟩ :=
    BigFppfSite.jointlySurjective_flat_locallyOfFinitePresentation_of_isCovering B hE
  exact isFpqcCovering_of_isFppfCovering B S hS _ _
    (isFppfCovering_yoneda_map B S hS E.X E.f (fun i ↦ (hgeom i).1) (fun i ↦ (hgeom i).2) hsurj)

/-- **A covering sieve of a test scheme contains an fpqc family.**  For a covering sieve `R` of
a test scheme `T` over `Y` in the restricted fppf topology there are test schemes `U i` and
members `g i : U i ⟶ T` of `R` whose underlying morphisms of algebraic spaces form an fpqc
covering of the algebraic space represented by `T`. -/
theorem exists_isFpqcCovering_of_mem_restrictedTopology {T : SchemesOver Y} {R : Sieve T}
    (hR : R ∈ topology Y T) :
    ∃ (I : Type (u + 1)) (U : I → SchemesOver Y) (g : ∀ i, U i ⟶ T), (∀ i, R (g i)) ∧
      IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom := by
  obtain ⟨E, hE, hle⟩ := BigFppfOver.exists_isCovering_sieve₀_le B S hS
    (functorPushforward_mem_of_mem_restrictedTopology hR)
  choose W g k hg hk using fun i ↦ hle _ (E.sieve₀_f i)
  refine ⟨E.I₀, fun i ↦ CostructuredArrow.mk ((schemeSpaceFunctor B S hS).map (k i) ≫ (W i).hom),
    fun i ↦ liftHom (W i) (k i) ≫ g i, fun i ↦ R.downward_closed (hg i) _, ?_⟩
  exact isFpqcCovering_liftHom_comp_of_isCovering hE g k hk

/-- **A covering sieve of a test scheme contains an fpqc family which generates a covering
sieve.**  The family of `exists_isFpqcCovering_of_mem_restrictedTopology`, together with the
fact that the sieve it generates is itself covering. -/
theorem exists_isFpqcCovering_ofArrows_mem_of_mem_restrictedTopology {T : SchemesOver Y}
    {R : Sieve T} (hR : R ∈ topology Y T) :
    ∃ (I : Type (u + 1)) (U : I → SchemesOver Y) (g : ∀ i, U i ⟶ T), (∀ i, R (g i)) ∧
      IsFpqcCovering B S hS (fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom) ∧
      Sieve.ofArrows U g ∈ topology Y T := by
  obtain ⟨E, hE, hle⟩ := BigFppfOver.exists_isCovering_sieve₀_le B S hS
    (functorPushforward_mem_of_mem_restrictedTopology hR)
  choose W g k hg hk using fun i ↦ hle _ (E.sieve₀_f i)
  have hleft : ∀ i, (liftHom (W i) (k i) ≫ g i).left = E.f i := fun i ↦ (hk i).symm
  refine ⟨E.I₀, fun i ↦ CostructuredArrow.mk ((schemeSpaceFunctor B S hS).map (k i) ≫ (W i).hom),
    fun i ↦ liftHom (W i) (k i) ≫ g i, fun i ↦ R.downward_closed (hg i) _, ?_, ?_⟩
  · exact isFpqcCovering_liftHom_comp_of_isCovering hE g k hk
  · refine Functor.mem_restrictedTopology_of_functorPushforward_mem ?_
    have hEcov : Sieve.ofArrows E.X E.f ∈ BigFppfOver.topology B S hS T.left := by
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
      exact B.generate_mem_topology_of_isFppfCovering _ (B.isFppfCovering_of_isCovering hE)
    refine GrothendieckTopology.superset_covering _ ?_ hEcov
    rw [Sieve.ofArrows, Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro i
    exact ⟨_, _, 𝟙 _, Sieve.ofArrows_mk _ _ i, by rw [Category.id_comp]; exact (hleft i).symm⟩

end AlgebraicGeometry.Space.SchemesOver

end
