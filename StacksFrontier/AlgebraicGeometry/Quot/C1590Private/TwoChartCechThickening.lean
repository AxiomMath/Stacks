module

public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.RingTheory.Smooth.Quotient
import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
import StacksFrontier.Algebra.Module.TwoTermComplex.Noetherian

/-!
# The Čech complex of a two-open cover along a square-zero thickening

Let `R' → R` be a surjection with square-zero kernel `I`, and consider rings `P_U`, `P_V`, `P_W`
over `R'` with restriction maps `P_U → P_W ← P_V`, mapping onto rings `Q_U`, `Q_V`, `Q_W` with
kernels `I P_U`, `I P_V`, `I P_W` (this is what the sections of a scheme flat over `R'` over two
affine opens and their intersection do, along the closed subscheme cut out by `I`). Fix `β ∈ P_U`
and `k`. The *twisted Čech differential* is `(x, y) ↦ x - β^k y` (restrictions to `P_W` implied);
it is the Čech differential of the `k`-th power of the line bundle with transition function `β`.

This file contains the commutative algebra behind lifting a two-chart datum along the thickening:

* `AlgebraicGeometry.C1590Private.IsCechThickening.exists_cech_eq_of_mem`: an element of `I P_W`
  is a twisted Čech difference of elements of `I P_U` and `I P_V` as soon as the differential is
  surjective downstairs;
* `AlgebraicGeometry.C1590Private.IsCechThickening.exists_cech_eq`: hence the twisted differential
  is surjective upstairs as soon as it is downstairs;
* `AlgebraicGeometry.C1590Private.IsCechThickening.exists_lift_cocycle`: every cocycle downstairs
  (a section of the line bundle) lifts to a cocycle upstairs;
* `AlgebraicGeometry.C1590Private.IsCechThickening.exists_lift_mul_eq_one`: a pair of functions
  `b`, `a` on `U`, `V` with `a b = 1` on `W` lifts to a pair with the same property, using the
  surjectivity of the differential for `k = 2`;

and three statements about modules over `R'`, used for the section modules:

* `AlgebraicGeometry.C1590Private.finite_of_surjective_of_ker_le_smul`: a module whose reduction
  modulo the square-zero ideal is finite is finite;
* `AlgebraicGeometry.C1590Private.finitePresentation_of_flat_of_ker_le_smul`: a finite flat
  module whose reduction is finitely presented over `R` is finitely presented over `R'`;
* `AlgebraicGeometry.C1590Private.projective_of_flat_of_ker_le_smul`: hence projective, when the
  reduction is finite projective over `R`.
-/

@[expose] public noncomputable section

namespace AlgebraicGeometry.C1590Private

section CechAlgebra

variable {R' PU PV PW QU QV QW : Type*} [CommRing R'] [CommRing PU] [CommRing PV] [CommRing PW]
  [CommRing QU] [CommRing QV] [CommRing QW]

/-- The hypotheses on the sections of a scheme flat over `R'` over two affine opens `U`, `V` and
their intersection `W`, compared with the sections of its reduction modulo a square-zero ideal
`I ⊆ R'`: `σU`, `σV` are the structure maps, `rU'`, `rV'` (upstairs) and `rU`, `rV` (downstairs)
the restrictions to `W`, and `ρU`, `ρV`, `ρW` the reductions, which are onto with kernels
generated by `I`. -/
structure IsCechThickening (σU : R' →+* PU) (σV : R' →+* PV) (rU' : PU →+* PW)
    (rV' : PV →+* PW) (ρU : PU →+* QU) (ρV : PV →+* QV) (ρW : PW →+* QW) (rU : QU →+* QW)
    (rV : QV →+* QW) (I : Ideal R') : Prop where
  comp_σ : rU'.comp σU = rV'.comp σV
  comp_U : ρW.comp rU' = rU.comp ρU
  comp_V : ρW.comp rV' = rV.comp ρV
  surjective_U : Function.Surjective ρU
  surjective_V : Function.Surjective ρV
  surjective_W : Function.Surjective ρW
  map_le_ker_U : I.map σU ≤ RingHom.ker ρU
  map_le_ker_V : I.map σV ≤ RingHom.ker ρV
  ker_le_W : RingHom.ker ρW ≤ I.map (rU'.comp σU)
  sq_eq_bot : I ^ 2 = ⊥

namespace IsCechThickening

variable {σU : R' →+* PU} {σV : R' →+* PV} {rU' : PU →+* PW} {rV' : PV →+* PW}
  {ρU : PU →+* QU} {ρV : PV →+* QV} {ρW : PW →+* QW} {rU : QU →+* QW} {rV : QV →+* QW}
  {I : Ideal R'} (h : IsCechThickening σU σV rU' rV' ρU ρV ρW rU rV I)
include h

/-- The ideal `I P_W` is square-zero. -/
theorem mul_eq_zero {x y : PW} (hx : x ∈ I.map (rU'.comp σU)) (hy : y ∈ I.map (rU'.comp σU)) :
    x * y = 0 := by
  have hmem := Ideal.mul_mem_mul hx hy
  rwa [← Ideal.map_mul, ← pow_two, h.sq_eq_bot, Ideal.map_bot] at hmem

omit [CommRing PV] [CommRing QU] [CommRing QV] [CommRing QW] h in
/-- The image of `I P_U` in `P_W` lies in `I P_W`. -/
theorem map_U_le : (I.map σU).map rU' ≤ I.map (rU'.comp σU) := by
  rw [Ideal.map_map]

/-- The image of `I P_V` in `P_W` lies in `I P_W`. -/
theorem map_V_le : (I.map σV).map rV' ≤ I.map (rU'.comp σU) := by
  rw [Ideal.map_map, h.comp_σ]

omit [CommRing PV] [CommRing QU] [CommRing QV] [CommRing QW] h in
/-- The restriction to `W` of an element of `I P_U` lies in `I P_W`. -/
theorem rU'_mem {x : PU} (hx : x ∈ I.map σU) : rU' x ∈ I.map (rU'.comp σU) :=
  map_U_le (Ideal.mem_map_of_mem _ hx)

/-- The restriction to `W` of an element of `I P_V` lies in `I P_W`. -/
theorem rV'_mem {y : PV} (hy : y ∈ I.map σV) : rV' y ∈ I.map (rU'.comp σU) :=
  h.map_V_le (Ideal.mem_map_of_mem _ hy)

/-- Reducing the restriction of `x ∈ P_U` to `W` is restricting the reduction of `x`. -/
theorem ρW_rU' (x : PU) : ρW (rU' x) = rU (ρU x) :=
  congrArg (fun φ : PU →+* QW => φ x) h.comp_U

/-- Reducing the restriction of `y ∈ P_V` to `W` is restricting the reduction of `y`. -/
theorem ρW_rV' (y : PV) : ρW (rV' y) = rV (ρV y) :=
  congrArg (fun φ : PV →+* QW => φ y) h.comp_V

/-- If `x`, `y` reduce to a solution of `x - b^k y = ρW c`, then `c - (x - β^k y)` reduces to
zero in `Q_W`. -/
private theorem sub_cech_mem_ker (k : ℕ) (β : PU) {c : PW} {x : PU} {y : PV}
    (hxy : rU (ρU x) - rU (ρU β) ^ k * rV (ρV y) = ρW c) :
    c - (rU' x - rU' β ^ k * rV' y) ∈ RingHom.ker ρW := by
  rw [RingHom.mem_ker, map_sub, map_sub, map_mul, map_pow, h.ρW_rU', h.ρW_rU', h.ρW_rV', hxy,
    sub_self]

/-- **Correction terms.** If the twisted Čech differential `(x, y) ↦ x - b^k y` is onto
downstairs, with `b` the reduction of `β`, then every element of `I P_W` is a twisted Čech
difference `x - β^k y` of elements `x ∈ I P_U`, `y ∈ I P_V`. -/
theorem exists_cech_eq_of_mem (k : ℕ) (β : PU)
    (hsurj : ∀ w : QW, ∃ (x : QU) (y : QV), rU x - rU (ρU β) ^ k * rV y = w)
    {z : PW} (hz : z ∈ I.map (rU'.comp σU)) :
    ∃ x ∈ I.map σU, ∃ y ∈ I.map σV, rU' x - rU' β ^ k * rV' y = z := by
  let S : Set PW := {z | ∃ x ∈ I.map σU, ∃ y ∈ I.map σV, rU' x - rU' β ^ k * rV' y = z}
  have hS0 : (0 : PW) ∈ S := ⟨0, zero_mem _, 0, zero_mem _, by simp⟩
  have hSadd : ∀ {z₁ z₂}, z₁ ∈ S → z₂ ∈ S → z₁ + z₂ ∈ S := by
    rintro _ _ ⟨x₁, hx₁, y₁, hy₁, rfl⟩ ⟨x₂, hx₂, y₂, hy₂, rfl⟩
    exact ⟨x₁ + x₂, add_mem hx₁ hx₂, y₁ + y₂, add_mem hy₁ hy₂, by simp only [map_add]; ring⟩
  have hgen : ∀ (c : PW) (i : R'), i ∈ I → c * (rU'.comp σU) i ∈ S := by
    intro c i hi
    obtain ⟨xb, yb, hxy⟩ := hsurj (ρW c)
    obtain ⟨x₁, rfl⟩ := h.surjective_U xb
    obtain ⟨y₁, rfl⟩ := h.surjective_V yb
    have hεi : (c - (rU' x₁ - rU' β ^ k * rV' y₁)) * (rU'.comp σU) i = 0 :=
      h.mul_eq_zero (h.ker_le_W (h.sub_cech_mem_ker k β hxy)) (Ideal.mem_map_of_mem _ hi)
    refine ⟨x₁ * σU i, Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hi),
      y₁ * σV i, Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hi), ?_⟩
    have hσ : rV' (σV i) = rU' (σU i) := (congrArg (fun φ : R' →+* PW => φ i) h.comp_σ).symm
    simp only [map_mul, hσ, RingHom.comp_apply] at hεi ⊢
    linear_combination -hεi
  suffices H : ∀ c : PW, c * z ∈ S by rw [← one_mul z]; exact H 1
  induction hz using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨i, hi, rfl⟩ := hw
    exact fun c => hgen c i hi
  | zero => exact fun c => by rwa [mul_zero]
  | add w₁ w₂ _ _ h₁ h₂ => exact fun c => by rw [mul_add]; exact hSadd (h₁ c) (h₂ c)
  | smul d w _ hw => exact fun c => by rw [smul_eq_mul, ← mul_assoc]; exact hw (c * d)

/-- **Surjectivity of the twisted differential lifts.** If `(x, y) ↦ x - b^k y` is onto
downstairs, then `(x, y) ↦ x - β^k y` is onto upstairs. -/
theorem exists_cech_eq (k : ℕ) (β : PU)
    (hsurj : ∀ w : QW, ∃ (x : QU) (y : QV), rU x - rU (ρU β) ^ k * rV y = w) (z : PW) :
    ∃ (x : PU) (y : PV), rU' x - rU' β ^ k * rV' y = z := by
  obtain ⟨xb, yb, hxy⟩ := hsurj (ρW z)
  obtain ⟨x₁, rfl⟩ := h.surjective_U xb
  obtain ⟨y₁, rfl⟩ := h.surjective_V yb
  obtain ⟨x₂, -, y₂, -, hx₂⟩ :=
    h.exists_cech_eq_of_mem k β hsurj (h.ker_le_W (h.sub_cech_mem_ker k β hxy))
  exact ⟨x₁ + x₂, y₁ + y₂, by simp only [map_add]; linear_combination hx₂⟩

/-- **Cocycles lift.** If `(x, y) ↦ x - b^k y` is onto downstairs, every `(xb, yb)` with
`xb = b^k yb` on `W` is the reduction of some `(x, y)` with `x = β^k y` on `W`. -/
theorem exists_lift_cocycle (k : ℕ) (β : PU)
    (hsurj : ∀ w : QW, ∃ (x : QU) (y : QV), rU x - rU (ρU β) ^ k * rV y = w)
    (xb : QU) (yb : QV) (hxy : rU xb - rU (ρU β) ^ k * rV yb = 0) :
    ∃ (x : PU) (y : PV), ρU x = xb ∧ ρV y = yb ∧ rU' x - rU' β ^ k * rV' y = 0 := by
  obtain ⟨x₁, rfl⟩ := h.surjective_U xb
  obtain ⟨y₁, rfl⟩ := h.surjective_V yb
  have hε := h.sub_cech_mem_ker k β (c := 0) (x := x₁) (y := y₁) (by rw [hxy, map_zero])
  rw [zero_sub, neg_mem_iff] at hε
  obtain ⟨x₂, hx₂, y₂, hy₂, he⟩ := h.exists_cech_eq_of_mem k β hsurj (h.ker_le_W hε)
  refine ⟨x₁ - x₂, y₁ - y₂, ?_, ?_, ?_⟩
  · rw [map_sub, h.map_le_ker_U hx₂, sub_zero]
  · rw [map_sub, h.map_le_ker_V hy₂, sub_zero]
  · simp only [map_sub]
    linear_combination -he

/-- **Transition functions lift.** If `(x, y) ↦ x - b² y` is onto downstairs, with `b` the
reduction of `β₀`, and `a b = 1` on `W` for the reduction `a` of `α₀`, then there are `β`, `α`
with the same reductions and `α β = 1` on `W`. -/
theorem exists_lift_mul_eq_one (β₀ : PU) (α₀ : PV)
    (hsurj : ∀ w : QW, ∃ (x : QU) (y : QV), rU x - rU (ρU β₀) ^ 2 * rV y = w)
    (hab : rU (ρU β₀) * rV (ρV α₀) = 1) :
    ∃ (β : PU) (α : PV), ρU β = ρU β₀ ∧ ρV α = ρV α₀ ∧ rU' β * rV' α = 1 := by
  set ε := rU' β₀ * rV' α₀ - 1 with hεdef
  have hε : ε ∈ RingHom.ker ρW := by
    rw [RingHom.mem_ker, hεdef, map_sub, map_mul, h.ρW_rU', h.ρW_rV', hab, map_one, sub_self]
  have hεJ := h.ker_le_W hε
  have hz : -(rU' β₀ * ε) ∈ I.map (rU'.comp σU) := neg_mem (Ideal.mul_mem_left _ _ hεJ)
  obtain ⟨x, hx, y, hy, hxy⟩ := h.exists_cech_eq_of_mem 2 β₀ hsurj hz
  refine ⟨β₀ + x, α₀ - y, ?_, ?_, ?_⟩
  · rw [map_add, h.map_le_ker_U hx, add_zero]
  · rw [map_sub, h.map_le_ker_V hy, sub_zero]
  · have hXY : rU' x * rV' y = 0 := h.mul_eq_zero (rU'_mem hx) (h.rV'_mem hy)
    have hεY : ε * rV' y = 0 := h.mul_eq_zero hεJ (h.rV'_mem hy)
    have hεε : ε * ε = 0 := h.mul_eq_zero hεJ hεJ
    simp only [map_add, map_sub]
    linear_combination rV' α₀ * hxy - hXY + rU' β₀ * hεY - hεε +
      (1 + rU' β₀ * rV' y - ε) * hεdef

end IsCechThickening

end CechAlgebra

section ModuleAlgebra

variable {R' M : Type*} [CommRing R'] [AddCommGroup M] [Module R' M] {I : Ideal R'}

/-- **Nakayama's lemma for a square-zero ideal.** If `N ≤ N' + I N` with `I² = 0`, then
`N ≤ N'`. -/
theorem le_of_le_sup_smul_of_sq_eq_bot (hI : I ^ 2 = ⊥) {N N' : Submodule R' M}
    (h : N ≤ N' ⊔ I • N) : N ≤ N' :=
  h.trans <| sup_le le_rfl <|
    calc I • N ≤ I • (N' ⊔ I • N) := Submodule.smul_mono le_rfl h
      _ = I • N' ⊔ I • I • N := Submodule.smul_sup _ _ _
      _ = I • N' := by rw [← Submodule.mul_smul, ← pow_two, hI, Submodule.bot_smul, sup_bot_eq]
      _ ≤ N' := Submodule.smul_le_right

/-- **Finiteness lifts along a square-zero ideal.** If `φ : M → P` is onto with kernel inside
`I M`, `I² = 0` and `P` is finite, then `M` is finite. -/
theorem finite_of_surjective_of_ker_le_smul (hI : I ^ 2 = ⊥) {P : Type*} [AddCommGroup P]
    [Module R' P] [Module.Finite R' P] (φ : M →ₗ[R'] P) (hφ : Function.Surjective φ)
    (hker : LinearMap.ker φ ≤ I • ⊤) : Module.Finite R' M := by
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := R') (M := P)
  let N := Submodule.span R' (Function.surjInv hφ '' s)
  have hmap : Submodule.map φ N = ⊤ := by
    rw [Submodule.map_span, Set.image_image]
    simpa only [Function.surjInv_eq hφ, Set.image_id'] using hs
  have hN : (⊤ : Submodule R' M) ≤ N ⊔ I • ⊤ := by
    intro m _
    obtain ⟨n, hn, hnm⟩ := (Submodule.mem_map).1 (hmap ▸ Submodule.mem_top : φ m ∈ _)
    refine Submodule.mem_sup.2 ⟨n, hn, m - n, hker ?_, by abel⟩
    rw [LinearMap.mem_ker, map_sub, hnm, sub_self]
  rw [Module.finite_def, Submodule.fg_def]
  exact ⟨_, s.finite_toSet.image _, le_antisymm le_top (le_of_le_sup_smul_of_sq_eq_bot hI hN)⟩

variable {R : Type*} [CommRing R] [Algebra R' R] {P : Type*} [AddCommGroup P] [Module R P]
  [Module R' P] [IsScalarTower R' R P]

/-- The kernel of the reduction `R'ⁿ → Rⁿ` is `I R'ⁿ`. -/
theorem ker_compLeft_le_smul_top (n : ℕ) :
    LinearMap.ker ((Algebra.linearMap R' R).compLeft (Fin n)) ≤
      RingHom.ker (algebraMap R' R) • (⊤ : Submodule R' (Fin n → R')) := by
  intro f hf
  rw [pi_eq_sum_univ f]
  exact Submodule.sum_mem _ fun j _ =>
    Submodule.smul_mem_smul (congrFun (LinearMap.mem_ker.1 hf) j) Submodule.mem_top

/-- **Finite presentation lifts along a square-zero ideal, for flat modules.** Let `R' → R` be
onto with square-zero kernel `I`, `M` a finite flat `R'`-module and `φ : M → P` an `R'`-linear
surjection onto a finitely presented `R`-module, with kernel inside `I M`. Then `M` is finitely
presented over `R'`. -/
theorem finitePresentation_of_flat_of_ker_le_smul (hg : Function.Surjective (algebraMap R' R))
    (hI : RingHom.ker (algebraMap R' R) ^ 2 = ⊥) [Module.Finite R' M] [Module.Flat R' M]
    [Module.FinitePresentation R P] (φ : M →ₗ[R'] P) (hφ : Function.Surjective φ)
    (hker : LinearMap.ker φ ≤ RingHom.ker (algebraMap R' R) • ⊤) :
    Module.FinitePresentation R' M := by
  set I := RingHom.ker (algebraMap R' R) with hIdef
  obtain ⟨n, ψ, hψ⟩ := Module.Finite.exists_fin' R' M
  let v : Fin n → P := fun j => φ (ψ (Pi.single j 1))
  let ψb : (Fin n → R) →ₗ[R] P := Fintype.linearCombination R v
  let red : (Fin n → R') →ₗ[R'] (Fin n → R) := (Algebra.linearMap R' R).compLeft (Fin n)
  have hcomm : (ψb.restrictScalars R').comp red = φ.comp ψ := by
    refine LinearMap.pi_ext fun j x => ?_
    have hred1 : red (Pi.single j x) = Pi.single j (algebraMap R' R x) := by
      ext i
      by_cases hij : i = j
      · subst hij
        simp [red]
      · simp [red, Pi.single_eq_of_ne hij]
    have hsingle : (Pi.single j x : Fin n → R') = x • Pi.single j 1 := by
      rw [← Pi.single_smul, smul_eq_mul, mul_one]
    rw [LinearMap.comp_apply, LinearMap.restrictScalars_apply, hred1, LinearMap.comp_apply,
      Fintype.linearCombination_apply_single, hsingle, map_smul, map_smul, algebraMap_smul]
  have hcomm' : ∀ u, ψb (red u) = φ (ψ u) := fun u => LinearMap.congr_fun hcomm u
  have hred : Function.Surjective red := fun w =>
    ⟨fun j => Function.surjInv hg (w j), funext fun j => Function.surjInv_eq hg (w j)⟩
  have hψb : Function.Surjective ψb := fun p => by
    obtain ⟨m, rfl⟩ := hφ p
    obtain ⟨u, rfl⟩ := hψ m
    exact ⟨red u, hcomm' u⟩
  obtain ⟨s, hs⟩ := Module.FinitePresentation.fg_ker ψb hψb
  have hredI : I • (⊤ : Submodule R' (Fin n → R')) ≤ LinearMap.ker red := by
    refine Submodule.smul_le.2 fun i hi f _ => ?_
    rw [LinearMap.mem_ker, map_smul, ← algebraMap_smul R i, (RingHom.mem_ker).1 hi, zero_smul]
  have hmapI : Submodule.map ψ (I • ⊤) = I • ⊤ := by
    rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.2 hψ]
  have hlift : ∀ w ∈ s, ∃ κ ∈ LinearMap.ker ψ, red κ = w := by
    intro w hw
    obtain ⟨u, rfl⟩ := hred w
    have hw' : red u ∈ LinearMap.ker ψb := hs ▸ Submodule.subset_span hw
    have hu : ψ u ∈ LinearMap.ker φ := by
      rwa [LinearMap.mem_ker, ← hcomm']
    obtain ⟨e, he, hee⟩ := (Submodule.mem_map).1 (hmapI ▸ hker hu)
    refine ⟨u - e, ?_, ?_⟩
    · rw [LinearMap.mem_ker, map_sub, hee, sub_self]
    · rw [map_sub, LinearMap.mem_ker.1 (hredI he), sub_zero]
  choose κ hκK hκred using hlift
  let K' : Submodule R' (Fin n → R') :=
    Submodule.span R' (Set.range fun w : s => κ w.1 w.2)
  have hK'le : K' ≤ LinearMap.ker ψ :=
    Submodule.span_le.2 (Set.range_subset_iff.2 fun w => hκK w.1 w.2)
  have hspan : ((Submodule.span R (s : Set (Fin n → R))).restrictScalars R') ≤
      Submodule.map red K' := by
    rw [Submodule.restrictScalars_span R' R hg, Submodule.span_le]
    intro w hw
    exact ⟨κ w hw, Submodule.subset_span ⟨⟨w, hw⟩, rfl⟩, hκred w hw⟩
  have hle : LinearMap.ker ψ ≤ K' ⊔ I • LinearMap.ker ψ := by
    intro x hx
    have hx' : red x ∈ LinearMap.ker ψb := by
      rw [LinearMap.mem_ker, hcomm', LinearMap.mem_ker.1 hx, map_zero]
    rw [← hs] at hx'
    obtain ⟨y, hy, hyx⟩ := (Submodule.mem_map).1 (hspan hx')
    have hxy : x - y ∈ LinearMap.ker ψ ⊓ I • ⊤ := by
      refine ⟨sub_mem hx (hK'le hy), ker_compLeft_le_smul_top n ?_⟩
      rw [LinearMap.mem_ker]
      change red (x - y) = 0
      rw [map_sub, hyx, sub_self]
    rw [LinearMap.ker_inf_smul_top_eq_smul_of_flat I ψ hψ] at hxy
    exact Submodule.mem_sup.2 ⟨y, hy, x - y, hxy, by abel⟩
  have hK : LinearMap.ker ψ = K' := le_antisymm (le_of_le_sup_smul_of_sq_eq_bot hI hle) hK'le
  exact Module.finitePresentation_of_surjective ψ hψ (hK ▸ Submodule.fg_span (Set.finite_range _))

/-- **Projectivity lifts along a square-zero ideal, for flat modules.** In the situation of
`AlgebraicGeometry.C1590Private.finitePresentation_of_flat_of_ker_le_smul`, with `P` finite
projective over `R`, the module `M` is projective over `R'`. -/
theorem projective_of_flat_of_ker_le_smul (hg : Function.Surjective (algebraMap R' R))
