/-!
# Two-chart data along flat square-zero thickenings: piece (D)

Let `R' → R` be a surjection with square-zero kernel `I`, `X' ⟶ Spec R'` flat and
`X = X' ×_{R'} R`, so that `i : X ⟶ X'` is a first order thickening. This file proves the two
statements of piece (D) of the special-tower route to the effectivity input of Stacks 0D5A:

* `AlgebraicGeometry.C1590Private.twoChartDatumLifts`: a good two-chart datum on `X` lifts to a
  two-chart datum on `X'` with the same opens;
* `AlgebraicGeometry.C1590Private.twoChartGoodOfThickening`: such a lift is good, its section
  modules `Γ(X', L'^{⊗ k})` are finite projective over `R'`, and they reduce onto the section
  modules `Γ(X, L^{⊗ k})` with kernel `I · Γ(X', L'^{⊗ k})`.

## The argument

On an affine open `W'` of `X'` with preimage `W`, the square of global sections is a pushout of
rings (`AlgebraicGeometry.isIso_pushoutSection_of_isAffineOpen`), so `Γ(X', W') → Γ(X, W)` is onto
with kernel `I Γ(X', W')` (`AlgebraicGeometry.C1590Private.surjective_and_ker_eq_of_isPushout`).
Applied to the two opens and their intersection this gives the hypotheses
`AlgebraicGeometry.C1590Private.IsCechThickening` of the commutative algebra of
`StacksFrontier/AlgebraicGeometry/Quot/C1590Private/TwoChartCechThickening.lean`, which lifts the
transition functions (using `H¹(X, L^{⊗ 2}) = 0`), the surjectivity of the Čech differentials and
the cocycles. Flatness of `X'` enters only through the kernel of the reduction of sections, which
is `I · Γ(X', L'^{⊗ k})` because the Čech differential is a surjection onto a flat module
(`LinearMap.ker_inf_smul_top_eq_smul_of_flat`), and through projectivity.

## Main definitions

* `AlgebraicGeometry.C1590Private.TwoChartDatum.baseOfSpecOn`: the structure map
  `R → Γ(X, W)` of an open of a scheme over `Spec R`.
* `AlgebraicGeometry.C1590Private.TwoChartDatum.cechDiffLinear`: the Čech differential as a
  linear map over the base ring.

## Main results

* `AlgebraicGeometry.C1590Private.twoChartDatumLifts`: (D), lifting.
* `AlgebraicGeometry.C1590Private.twoChartGoodOfThickening`: (D), goodness and base change.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.C1590Private

/-! ### A pushout of rings along a surjection is a quotient -/

/-- **A pushout of commutative rings along a surjection is a quotient.** In a pushout square
`f ≫ h = g ≫ i` with `g` onto, `h` is onto with kernel generated by the image of `Ker g`. -/
theorem surjective_and_ker_eq_of_isPushout {A B C D : CommRingCat.{u}} {f : A ⟶ B} {g : A ⟶ C}
    {h : B ⟶ D} {i : C ⟶ D} (H : IsPushout f g h i) (hg : Function.Surjective g.hom) :
    Function.Surjective h.hom ∧ RingHom.ker h.hom = (RingHom.ker g.hom).map f.hom := by
  set J := (RingHom.ker g.hom).map f.hom with hJ
  have hJg : RingHom.ker g.hom ≤ RingHom.ker ((Ideal.Quotient.mk J).comp f.hom) := fun a ha => by
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ ha
  let h₀ : B ⟶ CommRingCat.of (B ⧸ J) := CommRingCat.ofHom (Ideal.Quotient.mk J)
  let i₀ : C ⟶ CommRingCat.of (B ⧸ J) :=
    CommRingCat.ofHom (g.hom.liftOfSurjective hg ⟨(Ideal.Quotient.mk J).comp f.hom, hJg⟩)
  have hw : f ≫ h₀ = g ≫ i₀ := by
    ext a
    simp [h₀, i₀, RingHom.liftOfSurjective_comp_apply]
  have hJh : J ≤ RingHom.ker h.hom := by
    rw [hJ, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, ← CommRingCat.comp_apply, H.w, CommRingCat.comp_apply,
      (RingHom.mem_ker).1 ha, map_zero]
  have hw' : ∀ a, h (f a) = i (g a) := fun a => by
    rw [← CommRingCat.comp_apply, H.w, CommRingCat.comp_apply]
  let u : D ⟶ CommRingCat.of (B ⧸ J) := H.desc h₀ i₀ hw
  let v : CommRingCat.of (B ⧸ J) ⟶ D :=
    CommRingCat.ofHom (Ideal.Quotient.lift J h.hom fun a ha => hJh ha)
  have huv : u ≫ v = 𝟙 D := by
    refine H.hom_ext ?_ ?_
    · rw [IsPushout.inl_desc_assoc, Category.comp_id]
      ext b
      rfl
    · rw [IsPushout.inr_desc_assoc, Category.comp_id]
      ext c
      obtain ⟨a, rfl⟩ := hg c
      simp only [i₀, v, CommRingCat.comp_apply, CommRingCat.hom_ofHom,
        RingHom.liftOfSurjective_comp_apply, RingHom.comp_apply]
      exact (Ideal.Quotient.lift_mk J _ _).trans (hw' a)
  refine ⟨fun d => ?_, le_antisymm (fun b hb => ?_) hJh⟩
  · obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u d)
    refine ⟨b, ?_⟩
    have := congrArg (fun φ : D ⟶ D => φ d) huv
    simp only [CommRingCat.comp_apply, CommRingCat.id_apply] at this
    rw [← this, ← hb]
    rfl
  · have : h₀ b = u (h b) := by
      rw [← CommRingCat.comp_apply, IsPushout.inl_desc]
    rw [(RingHom.mem_ker).1 hb, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.1 this

/-! ### Sections over the opens of a scheme over `Spec R` -/

namespace TwoChartDatum

/-- The structure map `R → Γ(X, W)` of an open `W` of a scheme `X` over `Spec R`. -/
abbrev baseOfSpecOn {X : Scheme.{u}} {R : Type u} [CommRing R] (π : X ⟶ Spec (.of R))
    (W : X.Opens) : R →+* Γ(X, W) :=
  (X.presheaf.map (homOfLE le_top : W ⟶ ⊤).op).hom.comp (baseOfSpec π)

/-- The structure map `R → Γ(X, W)` is `π.appLE ⊤ W` composed with `R ≅ Γ(Spec R, ⊤)`. -/
theorem baseOfSpecOn_eq_appLE {X : Scheme.{u}} {R : Type u} [CommRing R]
    (π : X ⟶ Spec (.of R)) (W : X.Opens) :
    baseOfSpecOn π W =
      (π.appLE ⊤ W (by simp)).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom :=
  rfl

/-- For `W' ≤ W`, restriction `Γ(X, W) → Γ(X, W')` carries the structure map of `W` to that
of `W'`. -/
theorem res_comp_baseOfSpecOn {X : Scheme.{u}} {R : Type u} [CommRing R]
    (π : X ⟶ Spec (.of R)) {W W' : X.Opens} (hWW' : W' ≤ W) :
    (X.presheaf.map (homOfLE hWW').op).hom.comp (baseOfSpecOn π W) = baseOfSpecOn π W' := by
  rw [baseOfSpecOn, ← RingHom.comp_assoc, ← CommRingCat.hom_comp, ← Functor.map_comp]
  rfl

end TwoChartDatum

open TwoChartDatum

section Thickening

variable {R R' : Type u} [CommRing R] [CommRing R'] {g : R' →+* R}
  {X X' : Scheme.{u}} {π : X ⟶ Spec (.of R)} {π' : X' ⟶ Spec (.of R')} {i : X ⟶ X'}

/-- The spectrum of a surjection with square-zero kernel is a thickening. -/
theorem isThickening_specMap_of_sq_eq_bot (hg : Function.Surjective g)
    (hI : RingHom.ker g ^ 2 = ⊥) :
    Stacks.Thickenings.IsThickening (Spec.map (CommRingCat.ofHom g)) := by
  refine ⟨IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom g) hg, ?_⟩
  show Function.Surjective (PrimeSpectrum.comap g)
  intro p
  have hp : p ∈ PrimeSpectrum.zeroLocus (RingHom.ker g : Set R') := fun x hx =>
    p.isPrime.mem_of_pow_mem 2 (by
      have : x ^ 2 ∈ RingHom.ker g ^ 2 := Ideal.pow_mem_pow hx 2
      rw [hI] at this
      rw [(Ideal.mem_bot).1 this]
      exact p.asIdeal.zero_mem)
  rwa [← _root_.range_comap_of_surjective _ g hg] at hp

/-- `Γ(Spec R', ⊤) → Γ(Spec R, ⊤)` is `g`, up to the identifications with `R'` and `R`. -/
theorem ΓSpecIso_inv_comp_specMap_appLE (g : R' →+* R)
    (hle : (⊤ : (Spec (.of R)).Opens) ≤ Spec.map (CommRingCat.ofHom g) ⁻¹ᵁ ⊤) :
    (Scheme.ΓSpecIso (.of R')).inv ≫ (Spec.map (CommRingCat.ofHom g)).appLE ⊤ ⊤ hle =
      CommRingCat.ofHom g ≫ (Scheme.ΓSpecIso (.of R)).inv := by
  rw [Scheme.ΓSpecIso_inv_naturality, Scheme.Hom.appLE]
  rfl

/-- A ring map identified with `g` by isomorphisms is onto with kernel the image of `Ker g`,
when `g` is onto. -/
theorem surjective_and_ker_of_inv_comp_eq {A B : CommRingCat.{u}} (e' : A ≅ .of R')
    (e : B ≅ .of R) (ψ : A ⟶ B) (hψ : e'.inv ≫ ψ = CommRingCat.ofHom g ≫ e.inv)
    (hg : Function.Surjective g) :
    Function.Surjective ψ.hom ∧ RingHom.ker ψ.hom = (RingHom.ker g).map e'.inv.hom := by
  have hpt : ∀ r, ψ (e'.inv r) = e.inv (g r) := fun r => by
    rw [← CommRingCat.comp_apply, hψ, CommRingCat.comp_apply]
    rfl
  have hpt' : ∀ y, ψ y = e.inv (g (e'.hom y)) := fun y => by
    rw [← hpt, Iso.hom_inv_id_apply]
  refine ⟨fun z => ?_, le_antisymm (fun y hy => ?_) ?_⟩
  · obtain ⟨r, hr⟩ := hg (e.hom z)
    exact ⟨e'.inv r, by rw [hpt, hr, Iso.hom_inv_id_apply]⟩
  · have hy' : g (e'.hom y) = 0 := by
      have h1 := congrArg e.hom ((hpt' y).symm.trans ((RingHom.mem_ker).1 hy))
      rwa [Iso.inv_hom_id_apply, map_zero] at h1
    have := Ideal.mem_map_of_mem e'.inv.hom ((RingHom.mem_ker).2 hy')
    rwa [CommRingCat.Hom.hom, Iso.hom_inv_id_apply] at this
  · rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker, hpt, (RingHom.mem_ker).1 hr, map_zero]

/-- **Sections along the thickening.** For an affine open `W'` of `X'` with preimage `W` in
`X = X' ×_{R'} R`, restriction `Γ(X', W') → Γ(X, W)` is onto with kernel `I Γ(X', W')`. -/
theorem surjective_appLE_and_ker_of_isPullback (hg : Function.Surjective g)
    (H : IsPullback i π π' (Spec.map (CommRingCat.ofHom g))) {W' : X'.Opens}
    (hW' : IsAffineOpen W') {W : X.Opens} (hW : i ⁻¹ᵁ W' = W) :
    Function.Surjective (i.appLE W' W hW.ge).hom ∧
      RingHom.ker (i.appLE W' W hW.ge).hom = (RingHom.ker g).map (baseOfSpecOn π' W') := by
  have hUST : (⊤ : (Spec (.of R)).Opens) ≤ Spec.map (CommRingCat.ofHom g) ⁻¹ᵁ ⊤ := le_top
  have hUSX : W' ≤ π' ⁻¹ᵁ ⊤ := by simp
  have hUY : W = i ⁻¹ᵁ W' ⊓ π ⁻¹ᵁ ⊤ := by simp [hW]
  have hP := (isIso_pushoutSection_iff H hUST hUSX hUY).1
    (isIso_pushoutSection_of_isAffineOpen H hUST hUSX hUY (isAffineOpen_top _)
      (isAffineOpen_top _) hW')
  obtain ⟨hsurj, hker⟩ := surjective_and_ker_of_inv_comp_eq (Scheme.ΓSpecIso (.of R'))
    (Scheme.ΓSpecIso (.of R)) _ (ΓSpecIso_inv_comp_specMap_appLE g hUST) hg
  obtain ⟨h1, h2⟩ := surjective_and_ker_eq_of_isPushout hP hsurj
  refine ⟨h1, ?_⟩
  rw [h2, hker, Ideal.map_map]
  rfl

/-- An open of `X'` whose preimage under a thickening is affine is affine. -/
theorem isAffineOpen_of_isThickening (hi : Stacks.Thickenings.IsThickening i) {W' : X'.Opens}
    (hW : IsAffineOpen (i ⁻¹ᵁ W')) : IsAffineOpen W' :=
  have : IsAffine (i ⁻¹ᵁ W') := hW
  Stacks.Thickenings.isAffine_of_isThickening (hi.morphismRestrict W')

/-- Along a thickening, the non-vanishing locus of a section is determined by that of its
restriction. -/
theorem basicOpen_eq_of_isThickening (hi : Stacks.Thickenings.IsThickening i) {W' T' : X'.Opens}
    {W : X.Opens} (hW : i ⁻¹ᵁ W' = W) (s : Γ(X', W'))
    (hs : X.basicOpen (i.appLE W' W hW.ge s) = i ⁻¹ᵁ T') : X'.basicOpen s = T' := by
  rw [Scheme.basicOpen_appLE, ← hW, ← Scheme.Hom.preimage_inf,
    inf_eq_right.2 (X'.basicOpen_le s)] at hs
  rw [← hi.opensCongr_preimage (X'.basicOpen s), hs, hi.opensCongr_preimage]

/-- Every open of `Y` lies in the preimage of the whole of `Z`. -/
theorem le_top_preimage {Y Z : Scheme.{u}} (f : Y ⟶ Z) (W : Y.Opens) : W ≤ f ⁻¹ᵁ ⊤ := by
  simp

/-- Restriction along `i` intertwines the structure maps with `g`. -/
theorem appLE_comp_baseOfSpecOn (H : IsPullback i π π' (Spec.map (CommRingCat.ofHom g)))
    {W' : X'.Opens} {W : X.Opens} (hWW : W ≤ i ⁻¹ᵁ W') :
    (i.appLE W' W hWW).hom.comp (baseOfSpecOn π' W') = (baseOfSpecOn π W).comp g := by
  have hw : (i ≫ π').appLE ⊤ W (le_top_preimage _ _) =
      (π ≫ Spec.map (CommRingCat.ofHom g)).appLE ⊤ W
      (le_top_preimage _ _) := by
    rw [H.w]
  have h : (Scheme.ΓSpecIso (.of R')).inv ≫ π'.appLE ⊤ W' (le_top_preimage _ _) ≫ i.appLE W' W hWW =
      CommRingCat.ofHom g ≫ (Scheme.ΓSpecIso (.of R)).inv ≫ π.appLE ⊤ W (le_top_preimage _ _) := by
    rw [Scheme.Hom.appLE_comp_appLE, hw,
      ← Scheme.Hom.appLE_comp_appLE _ _ ⊤ ⊤ W (le_top_preimage _ _)
      (le_top_preimage _ _), ← Category.assoc, ΓSpecIso_inv_comp_specMap_appLE, Category.assoc]
  exact congrArg CommRingCat.Hom.hom h

/-- Sections of a flat scheme over an affine open are flat over the base. -/
theorem flat_baseOfSpecOn (hπ' : Flat π') {W' : X'.Opens} (hW' : IsAffineOpen W') :
    (baseOfSpecOn π' W').Flat := by
  rw [baseOfSpecOn_eq_appLE]
  exact RingHom.Flat.comp
    (RingHom.Flat.of_bijective (Scheme.ΓSpecIso (.of R')).symm.commRingCatIsoToRingEquiv.bijective)
    (HasRingHomProperty.appLE @Flat π' hπ' ⟨⊤, isAffineOpen_top _⟩ ⟨W', hW'⟩ (by simp))

/-- **The Čech hypotheses along the thickening.** For affine opens `U'`, `V'` of `X'` with affine
intersection, and their preimages `U`, `V` in `X`, the sections over `U'`, `V'`, `U' ∩ V'` and
their reductions satisfy `AlgebraicGeometry.C1590Private.IsCechThickening`. -/
theorem isCechThickening_of_isPullback (hg : Function.Surjective g)
    (hI : RingHom.ker g ^ 2 = ⊥) (H : IsPullback i π π' (Spec.map (CommRingCat.ofHom g)))
    {U' V' : X'.Opens} (hU'a : IsAffineOpen U') (hV'a : IsAffineOpen V')
    (hUV'a : IsAffineOpen (U' ⊓ V')) {U V : X.Opens} (hU : i ⁻¹ᵁ U' = U) (hV : i ⁻¹ᵁ V' = V)
    (hUV : i ⁻¹ᵁ (U' ⊓ V') = U ⊓ V) :
    IsCechThickening (baseOfSpecOn π' U') (baseOfSpecOn π' V')
      (X'.presheaf.map (homOfLE inf_le_left : U' ⊓ V' ⟶ U').op).hom
      (X'.presheaf.map (homOfLE inf_le_right : U' ⊓ V' ⟶ V').op).hom
      (i.appLE U' U hU.ge).hom (i.appLE V' V hV.ge).hom (i.appLE (U' ⊓ V') (U ⊓ V) hUV.ge).hom
      (X.presheaf.map (homOfLE inf_le_left : U ⊓ V ⟶ U).op).hom
      (X.presheaf.map (homOfLE inf_le_right : U ⊓ V ⟶ V).op).hom (RingHom.ker g) := by
  have hSU := surjective_appLE_and_ker_of_isPullback hg H hU'a hU
  have hSV := surjective_appLE_and_ker_of_isPullback hg H hV'a hV
  have hSW := surjective_appLE_and_ker_of_isPullback hg H hUV'a hUV
  exact
    { comp_σ := by rw [res_comp_baseOfSpecOn, res_comp_baseOfSpecOn]
      comp_U := by
        rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE,
          Scheme.Hom.appLE_map]
      comp_V := by
        rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE,
          Scheme.Hom.appLE_map]
      surjective_U := hSU.1
      surjective_V := hSV.1
      surjective_W := hSW.1
      map_le_ker_U := hSU.2.ge
      map_le_ker_V := hSV.2.ge
      ker_le_W := by rw [hSW.2, res_comp_baseOfSpecOn]
      sq_eq_bot := hI }

end Thickening

/-! ### The Čech differential as a linear map -/

namespace TwoChartDatum

variable {X : Scheme.{u}} (D : TwoChartDatum X) {R : Type u} [CommRing R] (σ : R →+* Γ(X, ⊤))

/-- The Čech differential sends `(x, y)` to `x|_{U ∩ V} - b^k y|_{U ∩ V}`. -/
theorem cechDiff_apply (k : ℕ) (q : Γ(X, D.U) × Γ(X, D.V)) :
    D.cechDiff k q = D.resU q.1 - D.resU D.b ^ k * D.resV q.2 :=
  rfl

/-- `Γ(X, U ∩ V)` as an algebra over the base ring `R`, through `σ : R → Γ(X, X)`. -/
abbrev algebraUV : Algebra R Γ(X, D.U ⊓ D.V) :=
  ((X.presheaf.map (homOfLE le_top : D.U ⊓ D.V ⟶ ⊤).op).hom.comp σ).toAlgebra

/-- Restricting a global section to `U` and then to `U ∩ V` is restricting it to `U ∩ V`. -/
theorem resU_res_top (r : Γ(X, ⊤)) :
    D.resU ((X.presheaf.map (homOfLE le_top : D.U ⟶ ⊤).op).hom r) =
      (X.presheaf.map (homOfLE le_top : D.U ⊓ D.V ⟶ ⊤).op).hom r := by
  rw [resU, ← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
  rfl

/-- Restricting a global section to `V` and then to `U ∩ V` is restricting it to `U ∩ V`. -/
theorem resV_res_top (r : Γ(X, ⊤)) :
    D.resV ((X.presheaf.map (homOfLE le_top : D.V ⟶ ⊤).op).hom r) =
      (X.presheaf.map (homOfLE le_top : D.U ⊓ D.V ⟶ ⊤).op).hom r := by
  rw [resV, ← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
  rfl

/-- The Čech differential `(x, y) ↦ x - b^k y` of `L^{⊗ k}`, as an `R`-linear map. -/
def cechDiffLinear (k : ℕ) :
    letI := D.algebraU σ
    letI := D.algebraV σ
    letI := D.algebraUV σ
    Γ(X, D.U) × Γ(X, D.V) →ₗ[R] Γ(X, D.U ⊓ D.V) :=
  letI := D.algebraU σ
  letI := D.algebraV σ
  letI := D.algebraUV σ
  { toFun := D.cechDiff k
    map_add' := map_add _
    map_smul' := fun r q => by
      simp only [cechDiff_apply, Prod.smul_fst, Prod.smul_snd, RingHom.id_apply]
      simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, RingHom.comp_apply, map_mul,
        resU_res_top, resV_res_top]
      ring }

/-- The `R`-linear Čech differential agrees with `TwoChartDatum.cechDiff` pointwise. -/
theorem cechDiffLinear_apply (k : ℕ) (q : Γ(X, D.U) × Γ(X, D.V)) :
    D.cechDiffLinear σ k q = D.cechDiff k q :=
  rfl

/-- The `R`-module `Γ(X, L^{⊗ k})` is the kernel of the Čech differential. -/
theorem sections_eq_ker (k : ℕ) :
    letI := D.algebraU σ
    letI := D.algebraV σ
    letI := D.algebraUV σ
    D.sections σ k = LinearMap.ker (D.cechDiffLinear σ k) :=
  let := D.algebraU σ
  let := D.algebraV σ
  let := D.algebraUV σ
  Submodule.ext fun _ => Iff.rfl

end TwoChartDatum

/-! ### (D) -/

section MainResults

variable {R R' : Type u} [CommRing R] [CommRing R'] {g : R' →+* R}
  {X X' : Scheme.{u}} {π : X ⟶ Spec (.of R)} {π' : X' ⟶ Spec (.of R')} {i : X ⟶ X'}

/-- The surjectivity of the Čech differential of a datum, in the shape consumed by
`AlgebraicGeometry.C1590Private.IsCechThickening`. -/
theorem exists_cechDiff_eq {D : TwoChartDatum X} {k : ℕ}
    (hk : Function.Surjective (D.cechDiff k)) (w : Γ(X, D.U ⊓ D.V)) :
    ∃ (x : Γ(X, D.U)) (y : Γ(X, D.V)), D.resU x - D.resU D.b ^ k * D.resV y = w := by
  obtain ⟨⟨x, y⟩, hxy⟩ := hk w
  exact ⟨x, y, hxy⟩

/-- The surjectivity of the Čech differential, for a lift `b` of the transition function. -/
private theorem exists_cechDiff_appLE_eq {D : TwoChartDatum X} {k : ℕ}
    (hk : Function.Surjective (D.cechDiff k)) {U' : X'.Opens} (hU : i ⁻¹ᵁ U' = D.U)
    {b : Γ(X', U')} (hb : (i.appLE U' D.U hU.ge).hom b = D.b) (w : Γ(X, D.U ⊓ D.V)) :
    ∃ (x : Γ(X, D.U)) (y : Γ(X, D.V)),
      D.resU x - D.resU ((i.appLE U' D.U hU.ge).hom b) ^ k * D.resV y = w := by
  rw [hb]
  exact exists_cechDiff_eq hk w

/-- **(D), goodness and base change.** A two-chart datum on `X'` restricting to a good datum on
`X = X' ×_{R'} R` is good, with finite projective section modules reducing onto those of the
datum on `X` with kernel `Ker(R' → R) · Γ(X', L'^{⊗ k})`. -/
theorem twoChartGoodOfThickening : TwoChartGoodOfThickening.{u} := by
  intro R R' _ _ g hg hI X X' π π' i H hπ' D D' hU hV hU' hV' hb ha hD
  have hUV' : IsAffineOpen (D'.U ⊓ D'.V) := D'.basicOpen_b ▸ D'.isAffineOpen_U.basicOpen D'.b
  have hUV : i ⁻¹ᵁ (D'.U ⊓ D'.V) = D.U ⊓ D.V := by rw [Scheme.Hom.preimage_inf, hU', hV']
  have hC := isCechThickening_of_isPullback hg hI H D'.isAffineOpen_U D'.isAffineOpen_V hUV' hU'
    hV' hUV
  have hbk := fun k hk => exists_cechDiff_appLE_eq (hD.1 k hk) hU' hb
  have hsurj' : ∀ k, 1 ≤ k → Function.Surjective (D'.cechDiff k) := fun k hk z => by
    obtain ⟨x, y, hxy⟩ := hC.exists_cech_eq k D'.b (hbk k hk) z
    exact ⟨(x, y), hxy⟩
  -- the module structures
  let σ := TwoChartDatum.baseOfSpec π
  let σ' := TwoChartDatum.baseOfSpec π'
  let := D.algebraU σ
  let := D.algebraV σ
  let := D.algebraUV σ
  let := D'.algebraU σ'
  let := D'.algebraV σ'
  let := D'.algebraUV σ'
  let : Algebra R' R := g.toAlgebra
  have hflatU : Module.Flat R' Γ(X', D'.U) := flat_baseOfSpecOn hπ' D'.isAffineOpen_U
  have hflatV : Module.Flat R' Γ(X', D'.V) := flat_baseOfSpecOn hπ' D'.isAffineOpen_V
  have hflatUV : Module.Flat R' Γ(X', D'.U ⊓ D'.V) := flat_baseOfSpecOn hπ' hUV'
  have hflatUxV : Module.Flat R' (Γ(X', D'.U) × Γ(X', D'.V)) := Stacks.TwoTermComplex.flat_prod
  -- restriction intertwines the structure maps
  have hρU : ∀ r : R', (i.appLE D'.U D.U hU'.ge).hom (algebraMap R' Γ(X', D'.U) r) =
      algebraMap R Γ(X, D.U) (g r) := fun r =>
    congrArg (fun φ : R' →+* Γ(X, D.U) => φ r) (appLE_comp_baseOfSpecOn H hU'.ge)
  have hρV : ∀ r : R', (i.appLE D'.V D.V hV'.ge).hom (algebraMap R' Γ(X', D'.V) r) =
      algebraMap R Γ(X, D.V) (g r) := fun r =>
    congrArg (fun φ : R' →+* Γ(X, D.V) => φ r) (appLE_comp_baseOfSpecOn H hV'.ge)
  have hmain : ∀ k, 1 ≤ k →
      (Module.Finite R' (D'.sections σ' k) ∧ Module.Projective R' (D'.sections σ' k)) ∧
      (∀ q ∈ D.sections σ k, ∃ q' ∈ D'.sections σ' k,
        (i.appLE D'.U D.U hU q'.1, i.appLE D'.V D.V hV q'.2) = q) ∧
      (∀ q' ∈ D'.sections σ' k,
        (i.appLE D'.U D.U hU q'.1, i.appLE D'.V D.V hV q'.2) = 0 →
          q' ∈ RingHom.ker g • D'.sections σ' k) := by
    intro k hk
    -- flatness of the section module
    have hc' : Function.Surjective (D'.cechDiffLinear σ' k) := hsurj' k hk
    have hflatS : Module.Flat R' (D'.sections σ' k) := by
      have := Stacks.TwoTermComplex.flat_ker_of_surjective _ hc'
      rwa [← TwoChartDatum.sections_eq_ker] at this
    -- the reduction of sections
    have hred : ∀ q' ∈ D'.sections σ' k,
        ((i.appLE D'.U D.U hU q'.1, i.appLE D'.V D.V hV q'.2) : Γ(X, D.U) × Γ(X, D.V)) ∈
          D.sections σ k := by
      rintro ⟨x, y⟩ hq
      have hq' : D'.cechDiff k (x, y) = 0 := hq
      show D.cechDiff k _ = 0
      have := congrArg (i.appLE (D'.U ⊓ D'.V) (D.U ⊓ D.V) hUV.ge).hom hq'
      rw [TwoChartDatum.cechDiff_apply, map_zero, map_sub, map_mul, map_pow] at this
      rw [TwoChartDatum.cechDiff_apply, ← this, ← hb]
      simp only [TwoChartDatum.resU, TwoChartDatum.resV]
      rw [hC.ρW_rU', hC.ρW_rU', hC.ρW_rV']
    -- the kernel of reduction, in the ambient module
    have hker : ∀ q' ∈ D'.sections σ' k,
        (i.appLE D'.U D.U hU q'.1, i.appLE D'.V D.V hV q'.2) = 0 →
          q' ∈ RingHom.ker g • D'.sections σ' k := by
      rintro ⟨x, y⟩ hq h0
      simp only [Prod.mk_eq_zero] at h0
      have hside : ∀ {W' : X'.Opens} (hW' : IsAffineOpen W') {W : X.Opens} (hW : i ⁻¹ᵁ W' = W)
          {z : Γ(X', W')}, (i.appLE W' W hW.ge).hom z = 0 →
            z ∈ (RingHom.ker g).map (baseOfSpecOn π' W') := fun {_} hW' {_} hW {_} h => by
        rw [← (surjective_appLE_and_ker_of_isPullback hg H hW' hW).2]
        exact h
      have hx : x ∈ (RingHom.ker g).map (algebraMap R' Γ(X', D'.U)) :=
        hside D'.isAffineOpen_U hU' h0.1
      have hy : y ∈ (RingHom.ker g).map (algebraMap R' Γ(X', D'.V)) :=
        hside D'.isAffineOpen_V hV' h0.2
      rw [← Submodule.restrictScalars_mem R', ← Ideal.smul_top_eq_map] at hx hy
      have hinc : ∀ {M : Type u} [AddCommGroup M] [Module R' M]
          (f : M →ₗ[R'] Γ(X', D'.U) × Γ(X', D'.V)) {m : M},
          m ∈ RingHom.ker g • (⊤ : Submodule R' M) →
            f m ∈ RingHom.ker g • (⊤ : Submodule R' (Γ(X', D'.U) × Γ(X', D'.V))) :=
        fun f m hm => by
        have h1 := Submodule.mem_map_of_mem (f := f) hm
        rw [Submodule.map_smul''] at h1
        exact Submodule.smul_mono le_rfl le_top h1
      have hxy : ((x, y) : Γ(X', D'.U) × Γ(X', D'.V)) ∈
          RingHom.ker g • (⊤ : Submodule R' (Γ(X', D'.U) × Γ(X', D'.V))) := by
        simpa using add_mem (hinc (LinearMap.inl R' _ _) hx) (hinc (LinearMap.inr R' _ _) hy)
      have hmem : ((x, y) : Γ(X', D'.U) × Γ(X', D'.V)) ∈
          LinearMap.ker (D'.cechDiffLinear σ' k) ⊓
            RingHom.ker g • (⊤ : Submodule R' (Γ(X', D'.U) × Γ(X', D'.V))) := ⟨hq, hxy⟩
      rwa [LinearMap.ker_inf_smul_top_eq_smul_of_flat _ _ hc', ← TwoChartDatum.sections_eq_ker]
        at hmem
    -- the reduction as a linear map
    let : Module R' (D.sections σ k) := Module.compHom _ (algebraMap R' R)
    have : IsScalarTower R' R (D.sections σ k) :=
      IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    let φ : D'.sections σ' k →ₗ[R'] D.sections σ k :=
      { toFun := fun q' => ⟨_, hred q'.1 q'.2⟩
        map_add' := fun q₁ q₂ => by
          ext <;> simp
        map_smul' := fun r q' => by
          ext
          · show (i.appLE D'.U D.U hU).hom (algebraMap R' Γ(X', D'.U) r * q'.1.1) =
              algebraMap R Γ(X, D.U) (g r) * (i.appLE D'.U D.U hU).hom q'.1.1
            rw [map_mul, hρU]
          · show (i.appLE D'.V D.V hV).hom (algebraMap R' Γ(X', D'.V) r * q'.1.2) =
              algebraMap R Γ(X, D.V) (g r) * (i.appLE D'.V D.V hV).hom q'.1.2
            rw [map_mul, hρV] }
    have hφ : Function.Surjective φ := by
      rintro ⟨⟨xb, yb⟩, hq⟩
      have hq' : D.cechDiff k (xb, yb) = 0 := hq
      rw [TwoChartDatum.cechDiff_apply, ← hb] at hq'
      obtain ⟨x, y, hx, hy, hxy⟩ := hC.exists_lift_cocycle k D'.b (hbk k hk) xb yb hq'
      exact ⟨⟨(x, y), hxy⟩, Subtype.ext (Prod.ext hx hy)⟩
    have hφker : LinearMap.ker φ ≤ RingHom.ker (algebraMap R' R) • ⊤ := by
      intro q' hq'
      have h0 : (i.appLE D'.U D.U hU q'.1.1, i.appLE D'.V D.V hV q'.1.2) = 0 :=
        congrArg Subtype.val (LinearMap.mem_ker.1 hq')
      exact (Submodule.mem_smul_top_iff _ _ _).2 (hker q'.1 q'.2 h0)
    have hgA : Function.Surjective (algebraMap R' R) := hg
    have hIA : RingHom.ker (algebraMap R' R) ^ 2 = ⊥ := hI
    have : Module.Finite R' R := Module.Finite.of_surjective (Algebra.linearMap R' R) hg
    obtain ⟨hfin, hproj⟩ := hD.2 k hk
    have : Module.Finite R' (D.sections σ k) := Module.Finite.trans R _
    have : Module.Finite R' (D'.sections σ' k) :=
      finite_of_surjective_of_ker_le_smul hIA φ hφ hφker
    refine ⟨⟨this, projective_of_flat_of_ker_le_smul hgA hIA φ hφ hφker⟩, fun q hq => ?_, hker⟩
    obtain ⟨q', hq'⟩ := hφ ⟨q, hq⟩
    exact ⟨q'.1, q'.2, congrArg Subtype.val hq'⟩
  refine ⟨⟨hsurj', fun k hk => (hmain k hk).1⟩, fun k hk => ⟨(hmain k hk).1.2, (hmain k hk).2⟩⟩

/-- **(D), lifting.** A good two-chart datum on `X = X' ×_{R'} R` lifts to a two-chart datum on
`X'` with the same opens. The opens are transported along the homeomorphism `X ⟶ X'` and are
affine (Stacks 06AD); the transition functions `b`, `a` lift with `a b = 1` because
`H¹(X, L^{⊗ 2}) = 0` (`AlgebraicGeometry.C1590Private.IsCechThickening.exists_lift_mul_eq_one`). -/
theorem twoChartDatumLifts : TwoChartDatumLifts.{u} := by
  intro R R' _ _ g hg hI X X' π π' i H _ D hD
  have hthick : Stacks.Thickenings.IsThickening i :=
    Stacks.Thickenings.isThickening_of_isPullback H (isThickening_specMap_of_sq_eq_bot hg hI)
  set U' := hthick.opensCongr D.U with hU'def
  set V' := hthick.opensCongr D.V with hV'def
  have hU' : i ⁻¹ᵁ U' = D.U := hthick.preimage_opensCongr D.U
  have hV' : i ⁻¹ᵁ V' = D.V := hthick.preimage_opensCongr D.V
  have hU'a : IsAffineOpen U' := isAffineOpen_of_isThickening hthick (hU' ▸ D.isAffineOpen_U)
  have hV'a : IsAffineOpen V' := isAffineOpen_of_isThickening hthick (hV' ▸ D.isAffineOpen_V)
  have hUV : i ⁻¹ᵁ (U' ⊓ V') = D.U ⊓ D.V := by rw [Scheme.Hom.preimage_inf, hU', hV']
  obtain ⟨β₀, hβ₀⟩ := (surjective_appLE_and_ker_of_isPullback hg H hU'a hU').1 D.b
  obtain ⟨α₀, hα₀⟩ := (surjective_appLE_and_ker_of_isPullback hg H hV'a hV').1 D.a
  have hbo : X'.basicOpen β₀ = U' ⊓ V' :=
    basicOpen_eq_of_isThickening hthick hU' β₀ (by
      rw [show (i.appLE U' D.U hU'.ge) β₀ = D.b from hβ₀, D.basicOpen_b, hUV])
  have hUV'a : IsAffineOpen (U' ⊓ V') := hbo ▸ hU'a.basicOpen β₀
  have hC := isCechThickening_of_isPullback hg hI H hU'a hV'a hUV'a hU' hV' hUV
  have hsurj2 := exists_cechDiff_appLE_eq (hD.1 2 (by norm_num)) hU' hβ₀
  have hab : (X.presheaf.map (homOfLE inf_le_left : D.U ⊓ D.V ⟶ D.U).op).hom
        ((i.appLE U' D.U hU'.ge).hom β₀) *
      (X.presheaf.map (homOfLE inf_le_right : D.U ⊓ D.V ⟶ D.V).op).hom
        ((i.appLE V' D.V hV'.ge).hom α₀) = 1 := by
    rw [hβ₀, hα₀]
    exact D.mul_eq_one
  obtain ⟨β, α, hβ, hα, hβα⟩ := hC.exists_lift_mul_eq_one β₀ α₀ hsurj2 hab
  have hβ' : (i.appLE U' D.U hU'.ge).hom β = D.b := hβ.trans hβ₀
  have hα' : (i.appLE V' D.V hV'.ge).hom α = D.a := hα.trans hα₀
  refine ⟨{ U := U'
            V := V'
            isAffineOpen_U := hU'a
            isAffineOpen_V := hV'a
            sup_eq_top := by
              rw [hU'def, hV'def, ← map_sup, D.sup_eq_top, map_top]
            b := β
            a := α
            basicOpen_b := basicOpen_eq_of_isThickening hthick hU' β (by
              rw [show (i.appLE U' D.U hU'.ge) β = D.b from hβ', D.basicOpen_b, hUV])
            basicOpen_a := basicOpen_eq_of_isThickening hthick hV' α (by
              rw [show (i.appLE V' D.V hV'.ge) α = D.a from hα', D.basicOpen_a, hUV])
            mul_eq_one := hβα }, hU'.ge, hV'.ge, hU', hV', hβ', hα'⟩

end MainResults

