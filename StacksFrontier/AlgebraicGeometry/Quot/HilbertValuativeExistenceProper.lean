module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Quot.HilbertQuotFunctorEquality
public import StacksFrontier.AlgebraicGeometry.Quot.HilbertValuativeExistence
public import StacksFrontier.AlgebraicGeometry.Quot.QuotValuativeExistence
public import StacksFrontier.AlgebraicGeometry.Spaces.DefiningIdealFiniteTypeOfQuotient

/-!
# The valuative criterion for `Hilb_{X/B} ⟶ B`, existence part (Stacks 0DM8)

Let `f : X ⟶ B` be a morphism of algebraic spaces over a scheme `S` of a big fppf site which is
proper as well as of finite presentation.  Stacks 0DM8 asserts that `Hilb_{X/B} ⟶ B` satisfies
the existence part of the valuative criterion of Morphisms of Spaces, Definition 03IX.  It follows
from `Hilb_{X/B} = Quot_{𝒪_X/X/B}` (Quot, Lemma 0D00) and the existence part for
`Quot_{F/X/B} ⟶ B` for every quasi-coherent `F` of finite type (Lemma 0DM4).

## Main definitions

* `AlgebraicGeometry.Space.HilbertPresheafModel.toQuotSitePresheafModel`: a model of the Hilbert
  presheaf of `f` read, through the isomorphism of Stacks 0D00, as a model of the Quot presheaf
  of the structure sheaf of `X`.

## Main results

* `AlgebraicGeometry.Space.HilbertPresheafModel.toBase_toQuotSitePresheafModel`: the two models
  have the same morphism to the base.
* `AlgebraicGeometry.Space.isFiniteTypeOnSite_structureSheafQuotSituation`: the module of the
  Quot situation of the structure sheaf is of finite type, which is the hypothesis on `F` of
  Lemma 0DM4.
* `AlgebraicGeometry.Space.HilbertPresheafModel.valuativeCriterionExistence_toBase`: Stacks 0DM8,
  the existence part of the valuative criterion for the morphism to the base of every model of the
  Hilbert presheaf.

## Implementation notes

A section of the Hilbert presheaf over a scheme of the site is a closed subfunctor of a base
change of `X`, so it lives one universe above the sections of an algebraic space, while the
existence part of Stacks 03IX is stated for morphisms of presheaves of `Type u`.  The statement
is therefore about the canonical morphism to the base of an arbitrary
`AlgebraicGeometry.Space.HilbertPresheafModel`, exactly as for Stacks 0D01; by
`AlgebraicGeometry.Space.valuativeCriterionExistence_toBase_of_model` the property does not
depend on the model.  A model of the Hilbert presheaf is turned into a model of the Quot
presheaf of `𝒪_X` by composing its identifying isomorphism with
`AlgebraicGeometry.Space.hilbertPresheafIsoQuotSitePresheaf`; the two presheaves are then the
same, and the compatibility of that isomorphism with the morphisms to the base makes the two
morphisms to the base equal.

## References

* [Stacks Project, Tag 0DM8](https://stacks.math.columbia.edu/tag/0DM8)
* [Stacks Project, Tag 0DM4](https://stacks.math.columbia.edu/tag/0DM4)
* [Stacks Project, Tag 0D00](https://stacks.math.columbia.edu/tag/0D00)
* [Stacks Project, Tag 03IX](https://stacks.math.columbia.edu/tag/03IX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

-- Left in place, this instance is selected ahead of `SheafOfModules.instAbelian` and leaves the
-- module universe of every subobject and cokernel below unsolved.
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian

namespace AlgebraicGeometry.Space

universe u

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {X Y : AlgebraicSpaces B S hS}

namespace HilbertPresheafModel

variable {f : X ⟶ Y} (M : HilbertPresheafModel f) (hf : IsFinitePresentation B S hS f.hom)

/-- A model of the Hilbert presheaf of `f` is a model of the Quot presheaf of the structure sheaf
of `X`: the same presheaf, identified with the Quot presheaf through the isomorphism
`AlgebraicGeometry.Space.hilbertPresheafIsoQuotSitePresheaf` of Stacks 0D00. -/
def toQuotSitePresheafModel :
    QuotSitePresheafModel (structureSheafQuotSituation f hf) where
  presheaf := M.presheaf
  iso := M.iso ≪≫ hilbertPresheafIsoQuotSitePresheaf f hf

/-- The Quot model of the structure sheaf built from a model of the Hilbert presheaf has the same
morphism to the base: the isomorphism of Stacks 0D00 lies over the base. -/
theorem toBase_toQuotSitePresheafModel :
    (M.toQuotSitePresheafModel hf).toBase = M.toBase := by
  ext T z
  exact congrArg ULift.down (types_congr_hom (congrArg NatTrans.app
    (hilbertPresheafIsoQuotSitePresheaf_hom_comp_quotSitePresheafToBase f hf) ▸ rfl :
      ((hilbertPresheafIsoQuotSitePresheaf f hf).hom ≫
        (structureSheafQuotSituation f hf).quotSitePresheafToBase).app T =
          (hilbertPresheafToBase f).app T) (M.iso.hom.app T ⟨z⟩))

end HilbertPresheafModel

/-- The module of the Quot situation of the structure sheaf, namely `𝒪_X`, is of finite type: it
is generated by its unit section. -/
theorem isFiniteTypeOnSite_structureSheafQuotSituation (f : X ⟶ Y)
    (hf : IsFinitePresentation B S hS f.hom) :
    SheafOfModules.IsFiniteTypeOnSite (structureSheafQuotSituation f hf).F :=
  isFiniteTypeOnSite_unit_structureRingSheaf B S hS X

/-! ### Stacks 0DM8 -/

/-- Let `f : X ⟶ Y` be a morphism of algebraic spaces over `S` which is proper
as well as of finite presentation.  Then `Hilb_{X/Y} ⟶ Y` satisfies the existence part of the
valuative criterion (Stacks 03IX): for every model of the Hilbert presheaf of `f`, its canonical
morphism to `Y` has it. -/
@[stacks 0DM8]
theorem HilbertPresheafModel.valuativeCriterionExistence_toBase {f : X ⟶ Y}
    (hproper : IsProper B S hS f.hom) (hf : IsFinitePresentation B S hS f.hom)
    (M : HilbertPresheafModel f) : ValuativeCriterion.Existence M.toBase :=
  M.toBase_toQuotSitePresheafModel hf ▸
    QuotSitePresheafModel.valuativeCriterionExistence_toBase (structureSheafQuotSituation f hf)
      hproper (isFiniteTypeOnSite_structureSheafQuotSituation f hf) (M.toQuotSitePresheafModel hf)

end AlgebraicGeometry.Space

end
