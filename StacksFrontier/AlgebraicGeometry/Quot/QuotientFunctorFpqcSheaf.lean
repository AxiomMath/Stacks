@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace QuotientSituation

variable (D : QuotientSituation B S hS)

/-- The pullback of a quotient along a morphism of test schemes is its restriction over `X`
along the induced morphism of base changes. -/
theorem quotientPullback_eq_quotientRestrictOver {T' T : SchemesOver D.Y} (h : T' ⟶ T)
    (K : Subobject (D.baseChangeModule T)) :
    D.quotientPullback h K =
      quotientRestrictOver (D.relativeMap h) (baseChangeMap_comp_projection D.f h) D.F K :=
  rfl

variable {I : Type v} {T : SchemesOver D.Y} {U : I → SchemesOver D.Y} (g : ∀ i, U i ⟶ T)

/-- **The descent of quotients along an fpqc covering of test schemes.**  For an fpqc covering
`{g i : U i ⟶ T}` of test schemes over `Y`, a family of quotients of the `F_{U i}`, each
quasi-coherent and flat over `U i`, whose pullbacks to the overlaps `U i ×_T U j` agree is the
family of pullbacks of a quotient of `F_T` which is quasi-coherent and flat over `T`. -/
theorem exists_mem_quotients_quotientPullback_eq
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom)
    (K : ∀ i, Subobject (D.baseChangeModule (U i))) (hK : ∀ i, K i ∈ D.quotients (U i))
    (hcompat : ∀ i j,
      D.quotientPullback (D.toHomSituation.overlapTestFst (g i) (g j)) (K i) =
        D.quotientPullback (D.toHomSituation.overlapTestSnd (g i) (g j)) (K j)) :
    ∃ K₀ ∈ D.quotients T, ∀ i, D.quotientPullback (g i) K₀ = K i := by
  have hc := modulePushforwardCoherence B S hS
  set s := D.toHomSituation
  set c : ∀ i, D.space (U i) ⟶ D.space T := fun i ↦ D.relativeMap (g i)
  have hp : ∀ i, c i ≫ D.sourceProjection T = D.sourceProjection (U i) :=
    fun i ↦ baseChangeMap_comp_projection D.f (g i)
  have hcov : IsFpqcCovering B S hS fun i ↦ (c i).hom := isFpqcCovering_baseChangeMap D.f g hg
  have h₁ : ∀ i j, overlapSnd c i j ≫ D.sourceProjection (U j) =
      overlapFst c i j ≫ D.sourceProjection (U i) :=
    overlapSnd_comp_eq (D.sourceProjection T) c (fun i ↦ D.sourceProjection (U i)) hp
  obtain ⟨K₀, hK₀, hres⟩ := descendsQuotientsAlongFpqcCovering_of_isQuasicoherentOnSite'
    (aP := fun i j ↦ overlapFst c i j ≫ D.sourceProjection (U i)) c (overlapFst c) (overlapSnd c)
    hp (fun _ _ ↦ rfl) h₁ hcov
    (fun i j ↦ AlgebraicSpaces.isPullback_fiberProduct B S hS (c i) (c j)) D.F D.quasicoherent
    K (fun i ↦ (hK i).1) fun i j ↦ by
      set σ := s.overlapTestComparison (g i) (g j)
      have hσ : σ ≫ D.sourceProjection (s.overlapTest (g i) (g j)) =
          overlapFst c i j ≫ D.sourceProjection (U i) :=
        s.overlapTestComparison_comp_projection (g i) (g j)
      have hk₀ : σ ≫ D.relativeMap (s.overlapTestFst (g i) (g j)) = overlapFst c i j :=
        s.overlapTestComparison_comp_baseChangeMap_fst (g i) (g j)
      have hk₁ : σ ≫ D.relativeMap (s.overlapTestSnd (g i) (g j)) = overlapSnd c i j :=
        s.overlapTestComparison_comp_baseChangeMap_snd (g i) (g j)
      have e : quotientRestrictOver σ hσ D.F
            (quotientRestrictOver (D.relativeMap (s.overlapTestFst (g i) (g j)))
              (baseChangeMap_comp_projection D.f _) D.F (K i)) =
          quotientRestrictOver σ hσ D.F
            (quotientRestrictOver (D.relativeMap (s.overlapTestSnd (g i) (g j)))
              (baseChangeMap_comp_projection D.f _) D.F (K j)) :=
        congrArg (quotientRestrictOver σ hσ D.F) (hcompat i j)
      exact (quotientRestrictOver_comp hc hk₀ _ hσ rfl D.F (K i)).symm.trans
        (e.trans (quotientRestrictOver_comp hc hk₁ _ hσ (h₁ i j) D.F (K j)))
  refine ⟨K₀, ⟨hK₀, ?_⟩, hres⟩
  have : (cokernel K₀.arrow).IsQuasicoherentOnSite := hK₀
  refine (isFlatOver_iff_forall_isFlatOverAtPoint B S hS (D.projection T) _ hK₀).2 fun y ↦ ?_
  obtain ⟨i, x, rfl⟩ := (isJointlySurjective_iff B S hS _ _).1
    (isJointlySurjective_of_isFpqcCovering B S hS _ hcov) y
  have hflat : IsFlatOver B S hS (D.space (U i)).2 (D.projection (U i)).hom
      ((modulePullback B S hS (c i)).obj (cokernel K₀.arrow)) := by
    have h := (hK i).2
    rw [← hres i] at h
    exact IsFlatOver.of_iso B S hS _ (quotientRestrictOverCokernelIso (c i) (hp i) D.F K₀) h
  have hx := (isFlatOver_iff_forall_isFlatOverAtPoint B S hS (D.projection (U i)) _
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS (c i) _ hK₀)).1
      hflat x
  exact (isFlatOverAtPoint_baseChange B S hS (isPullback_baseChangeMap D.f (g i))
    (cokernel K₀.arrow)).2.1 x (isFlatAt_of_isFlat B S hS _ (hg.1 i) _) hx

/-- **A quotient over a test scheme is determined by its pullbacks along an fpqc covering.** -/
theorem eq_of_quotientPullback_eq
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom)
    {K K' : Subobject (D.baseChangeModule T)} (hK : K ∈ D.quotients T)
    (hK' : K' ∈ D.quotients T)
    (h : ∀ i, D.quotientPullback (g i) K = D.quotientPullback (g i) K') : K = K' := by
  have hF := isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS
    (D.sourceProjection T) D.F D.quasicoherent
  exact eq_of_quotientRestrictOver_eq reflectsZeroAlongFpqcCovering.{u, v}
    (fun i ↦ D.relativeMap (g i)) (fun i ↦ baseChangeMap_comp_projection D.f (g i))
    (isFpqcCovering_baseChangeMap D.f g hg) D.F
    (kernelQuasicoherent _ hF K hK.1) (kernelQuasicoherent _ hF K' hK'.1) hK.1 hK'.1 h

/-- **Finite presentation of a quotient descends along an fpqc covering of test schemes.** -/
theorem isFinitePresentationOnSite_of_quotientPullback
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom)
    {K : Subobject (D.baseChangeModule T)} (hK : K ∈ D.quotients T)
    (hfp : ∀ i, (D.quotientModule (U i) (D.quotientPullback (g i) K)).IsFinitePresentationOnSite) :
    (D.quotientModule T K).IsFinitePresentationOnSite :=
  finitePresentationOnSiteDescendsAlongFpqcCovering.{u, v} (fun i ↦ D.relativeMap (g i))
    (isFpqcCovering_baseChangeMap D.f g hg) _ hK.1 fun i ↦
      SheafOfModules.IsFinitePresentationOnSite.of_iso (D.quotientPullbackCokernelIso (g i) K)
        (hfp i)

/-- In Situation 082M the functor of quotients satisfies the
sheaf property for the fpqc topology: for every fpqc covering `{U i ⟶ T}` of schemes over `Y`,
every compatible family of quotients of the `F_{U i}`, quasi-coherent and flat over `U i`, has a
unique amalgamation, a quotient of `F_T` quasi-coherent and flat over `T`. -/
@[stacks 082P]
theorem isSheafFor_quotientsFunctor_of_isFpqcCovering
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom) :
    Presieve.IsSheafFor D.quotientsFunctor (Presieve.ofArrows U g) := by
  intro x hx
  set s := D.toHomSituation
  set K : ∀ i, Subobject (D.baseChangeModule (U i)) := fun i ↦ (x (g i) ⟨i⟩).1
  have key : ∀ i j, D.quotientPullback (s.overlapTestFst (g i) (g j)) (K i) =
      D.quotientPullback (s.overlapTestSnd (g i) (g j)) (K j) := fun i j ↦
    congrArg Subtype.val (hx (s.overlapTestFst (g i) (g j)) (s.overlapTestSnd (g i) (g j))
      ⟨i⟩ ⟨j⟩ (s.overlapTest_condition (g i) (g j)))
  obtain ⟨K₀, hK₀, hres⟩ :=
    D.exists_mem_quotients_quotientPullback_eq g hg K (fun i ↦ (x (g i) ⟨i⟩).2) key
  refine ⟨⟨K₀, hK₀⟩, ?_, fun t ht ↦ Subtype.ext ?_⟩
  · rintro _ _ ⟨i⟩
    exact Subtype.ext (hres i)
  · exact D.eq_of_quotientPullback_eq g hg t.2 hK₀ fun i ↦
      (congrArg Subtype.val (ht (g i) ⟨i⟩)).trans (hres i).symm

/-- In Situation 082M the finite-presentation subfunctor of the functor of quotients satisfies
the sheaf property for the fpqc topology: for every fpqc covering `{U i ⟶ T}` of schemes over `Y`,
every compatible family of finitely presented quotients of the `F_{U i}`, flat over `U i`, has a
unique amalgamation, a finitely presented quotient of `F_T` flat over `T`. -/
@[stacks 082P]
theorem isSheafFor_finitePresentationQuotientsFunctor_of_isFpqcCovering
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom) :
    Presieve.IsSheafFor D.finitePresentationQuotientsFunctor (Presieve.ofArrows U g) := by
  intro x hx
  set s := D.toHomSituation
  set K : ∀ i, Subobject (D.baseChangeModule (U i)) := fun i ↦ (x (g i) ⟨i⟩).1
  have key : ∀ i j, D.quotientPullback (s.overlapTestFst (g i) (g j)) (K i) =
      D.quotientPullback (s.overlapTestSnd (g i) (g j)) (K j) := fun i j ↦
    congrArg Subtype.val (hx (s.overlapTestFst (g i) (g j)) (s.overlapTestSnd (g i) (g j))
      ⟨i⟩ ⟨j⟩ (s.overlapTest_condition (g i) (g j)))
  obtain ⟨K₀, hK₀, hres⟩ :=
    D.exists_mem_quotients_quotientPullback_eq g hg K (fun i ↦ (x (g i) ⟨i⟩).2.1) key
  have hfp : (D.quotientModule T K₀).IsFinitePresentationOnSite :=
    D.isFinitePresentationOnSite_of_quotientPullback g hg hK₀ fun i ↦ hres i ▸ (x (g i) ⟨i⟩).2.2
  refine ⟨⟨K₀, hK₀, hfp⟩, ?_, fun t ht ↦ Subtype.ext ?_⟩
  · rintro _ _ ⟨i⟩
    exact Subtype.ext (hres i)
  · exact D.eq_of_quotientPullback_eq g hg t.2.1 hK₀ fun i ↦
      (congrArg Subtype.val (ht (g i) ⟨i⟩)).trans (hres i).symm

end QuotientSituation

end AlgebraicGeometry.Space

end
