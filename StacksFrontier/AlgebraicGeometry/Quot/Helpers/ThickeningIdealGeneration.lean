module

public import StacksFrontier.AlgebraicGeometry.Quot.Helpers.ThickeningIdealTilde
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorProductRightExact

/-!
# Maps out of `𝒢 ⊗ p^*t^*𝒥` are determined on the sections `ā`

Let `t : U ⟶ U'` be an affine first order thickening of objects of the site with ideal `𝒥`,
`J = Ker(Γ(U') ⟶ Γ(U))`, and `p : X ⟶ U` a morphism of algebraic spaces. The global sections
`ā : 𝒪_U ⟶ t^*𝒥`, `a ∈ J` (`AlgebraicGeometry.Space.thickeningIdealSection`), generate
`t^*𝒥 ≅ J^~`; since `p^*` and `- ⊗ 𝒢` preserve colimits, the maps `𝒢 ⊗ p^*ā` are jointly
epimorphic onto `𝒢 ⊗ p^*t^*𝒥`.

## Main results

* `AlgebraicGeometry.Space.hom_ext_of_preservesColimits_homFromSelfOfElement`: maps out of the
  image of a module under a colimit-preserving functor are determined by its elements.
* `AlgebraicGeometry.Space.tensorPullbackThickeningIdeal_hom_ext`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance 2000] CategoryTheory.instHasWeakSheafifyOfHasSheafify

universe u

namespace AlgebraicGeometry.Space

/-- **Maps out of the image of a module under a colimit-preserving functor are determined by its
elements**: two maps `F M ⟶ X` agreeing after `F (r ↦ r m)` for every `m ∈ M` are equal, since
`⊕_{m ∈ M} R ⟶ M` is an epimorphism and `F` preserves it and the coproduct. -/
theorem hom_ext_of_preservesColimits_homFromSelfOfElement {R : Type u} [CommRing R] {C : Type*}
    [Category* C] (F : ModuleCat.{u} R ⥤ C) [PreservesColimitsOfSize.{u, u} F]
    {M : ModuleCat.{u} R} {X : C} {φ ψ : F.obj M ⟶ X}
    (h : ∀ m : M, F.map (homFromSelfOfElement M m) ≫ φ = F.map (homFromSelfOfElement M m) ≫ ψ) :
    φ = ψ := by
  let π : ∐ (fun _ : M => ModuleCat.of R R) ⟶ M := Sigma.desc fun m => homFromSelfOfElement M m
  have : Epi π := by
    refine (ModuleCat.epi_iff_surjective π).2 fun m =>
      ⟨(Sigma.ι (fun _ : M => ModuleCat.of R R) m).hom 1, ?_⟩
    show (Sigma.ι (fun _ : M => ModuleCat.of R R) m ≫ π).hom 1 = m
    rw [Sigma.ι_desc]
    exact homFromSelfOfElement_one M m
  have : PreservesColimitsOfSize.{0, 0} F := preservesColimitsOfSize_shrink F
  refine (cancel_epi (F.map π)).1 <| (isColimitOfPreserves F
    (colimit.isColimit (Discrete.functor fun _ : M => ModuleCat.of R R))).hom_ext fun ⟨m⟩ => ?_
  show F.map (Sigma.ι (fun _ : M => ModuleCat.of R R) m) ≫ F.map π ≫ φ =
    F.map (Sigma.ι (fun _ : M => ModuleCat.of R R) m) ≫ F.map π ≫ ψ
  rw [← Functor.map_comp_assoc, ← Functor.map_comp_assoc, Sigma.ι_desc]
  exact h m

/-- **Maps out of the image of a module generated by sections.** Let `G₁` be a colimit-preserving
functor out of `R`-modules, `I ≅ G₁ M`, and `sₘ : 1 ⟶ I` the sections corresponding to the
elements `m ∈ M` through `G₁ R ≅ 1`. For a colimit-preserving `G₂`, maps out of `G₂ I` are
determined by their composites with the `G₂ sₘ`. -/
theorem hom_ext_of_preservesColimits_sections {R : Type u} [CommRing R] {C D : Type*}
    [Category* C] [Category* D] (G₁ : ModuleCat.{u} R ⥤ C) [PreservesColimitsOfSize.{u, u} G₁]
    (G₂ : C ⥤ D) [PreservesColimitsOfSize.{u, u} G₂] {M : ModuleCat.{u} R} {I one : C}
    (t : I ≅ G₁.obj M) (e : G₁.obj (ModuleCat.of R R) ≅ one) (s : M → (one ⟶ I))
    (hs : ∀ m, s m ≫ t.hom = e.inv ≫ G₁.map (homFromSelfOfElement M m)) {N : D}
    {φ ψ : G₂.obj I ⟶ N} (H : ∀ m, G₂.map (s m) ≫ φ = G₂.map (s m) ≫ ψ) : φ = ψ := by
  refine (Iso.cancel_iso_hom_left (G₂.mapIso t.symm) φ ψ).1 ?_
  refine hom_ext_of_preservesColimits_homFromSelfOfElement (G₁ ⋙ G₂) fun m => ?_
  have hF : G₁.map (homFromSelfOfElement M m) ≫ t.inv = e.hom ≫ s m := by
    rw [Iso.comp_inv_eq, Category.assoc, hs, Iso.hom_inv_id_assoc]
  show G₂.map (G₁.map (homFromSelfOfElement M m)) ≫ G₂.map t.inv ≫ φ =
    G₂.map (G₁.map (homFromSelfOfElement M m)) ≫ G₂.map t.inv ≫ ψ
  rw [← Functor.map_comp_assoc, ← Functor.map_comp_assoc, hF, Functor.map_comp_assoc,
    Functor.map_comp_assoc, H m]

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {X : AlgebraicSpaces B S hS} {U U' : BigFppfOver B S hS}
  [IsAffine ((BigFppfOver.toScheme B S hS).obj U)] [IsAffine ((BigFppfOver.toScheme B S hS).obj U')]
  (h : U ⟶ U') (hiso : IsIso (Subfunctor.toRange ((schemeSpaceFunctor B S hS).map h).hom))
  (hfo : IsFirstOrderThickening B S hS ((schemeSpaceFunctor B S hS).obj U')
    (Subfunctor.range ((schemeSpaceFunctor B S hS).map h).hom))
  (hh : Stacks.Thickenings.IsFirstOrderThickening ((BigFppfOver.toScheme B S hS).map h))
  (p : X ⟶ (schemeSpaceFunctor B S hS).obj U)
  (𝒢 : SheafOfModules.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedTopos B S hS X).O))

include hh in
/-- **Maps out of `𝒢 ⊗ p^*t^*𝒥` are determined by the sections `𝒢 ⊗ p^*ā`, `a ∈ J`.** -/
theorem tensorPullbackThickeningIdeal_hom_ext {N : SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (smallEtaleRingedTopos B S hS X).O)}
    (φ ψ : ((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
        (smallEtaleRingedTopos B S hS X).O).flip.obj 𝒢).obj
        ((smallEtaleRingedToposHom B S hS p).toRingedToposModulesHom.pullbackModules.obj
          ((smallEtaleRingedToposHom B S hS
            ((schemeSpaceFunctor B S hS).map h)).toRingedToposModulesHom.pullbackModules.obj
          (smallEtaleRingedToposHomFirstOrderThickening B S hS ((schemeSpaceFunctor B S hS).map h)
            hiso hfo).idealOfThickening.I)) ⟶ N)
    (H : ∀ a, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
        (smallEtaleRingedTopos B S hS X).O).flip.obj 𝒢).map
          ((smallEtaleRingedToposHom B S hS p).toRingedToposModulesHom.pullbackModules.map
            (thickeningIdealSection h hiso hfo a)) ≫ φ =
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
        (smallEtaleRingedTopos B S hS X).O).flip.obj 𝒢).map
          ((smallEtaleRingedToposHom B S hS p).toRingedToposModulesHom.pullbackModules.map
            (thickeningIdealSection h hiso hfo a)) ≫ ψ) :
    φ = ψ := by
  have : PreservesColimitsOfSize.{u, u} (schemeAssociatedFunctor U) :=
    (representedAffineAssociatedAdjunction B S hS U).leftAdjoint_preservesColimits
  have : PreservesColimitsOfSize.{u, u}
      (smallEtaleRingedToposHom B S hS p).toRingedToposModulesHom.pullbackModules :=
    (Stacks.Sheaves.RingedToposModules.pullbackAdjPushforwardModules
      (smallEtaleRingedToposHom B S hS p).toRingedToposModulesHom).leftAdjoint_preservesColimits
  have : PreservesColimitsOfSize.{u, u}
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
        (smallEtaleRingedTopos B S hS X).O).flip.obj 𝒢) :=
    Stacks.SheafOfModules.TensorLocalProperties.preservesColimits_tensorSheafLeft _ _ 𝒢
  exact hom_ext_of_preservesColimits_sections (schemeAssociatedFunctor U)
    ((smallEtaleRingedToposHom B S hS p).toRingedToposModulesHom.pullbackModules ⋙
      (Stacks.SheafOfModules.Tensor.sheafTensor.{u + 1, u, u, u, u}
        (smallEtaleRingedTopos B S hS X).O).flip.obj 𝒢)
    (thickeningIdealTildeIso h hiso hfo hh) (schemeAssociatedUnitIso U)
    (thickeningIdealSection h hiso hfo) (thickeningIdealSection_comp_tildeIso_hom h hiso hfo hh) H

end AlgebraicGeometry.Space

end
