module

public import StacksFrontier.AlgebraicGeometry.Quot.HilbertFromQuotAlgebraic
public import StacksFrontier.AlgebraicGeometry.Quot.QuotFunctorAlgebraicFromExistence

/-!
# The Hilbert functor is an algebraic space, given Grothendieck's existence theorem (Stacks 0D01)

Let `f : X ⟶ B` be a morphism of algebraic spaces over a scheme `S` which is of finite
presentation and separated. Stacks 0D01 says that `Hilb_{X/B}` is an algebraic space locally of
finite presentation over `B`. Its proof is the deduction
`AlgebraicGeometry.Space.exists_hilbertPresheafModel_isAlgebraicSpace` from Stacks 0D00 and
Stacks 09TU, which `AlgebraicGeometry.Space.exists_hilbertPresheafModel_of_quotAlgebraic` feeds
with Stacks 0D00 and the second clause of Stacks 09TU, leaving the first clause of Stacks 09TU for
`𝒪_X` as its input. This file supplies that input by
`AlgebraicGeometry.Space.QuotSituation.isAlgebraicSpace_quotSitePresheafModel_of_existence`,
`𝒪_X` being étale-locally generated by finitely many sections, so that Grothendieck's existence
theorem for algebraic spaces (Stacks 0CXB) is the only hypothesis left.

## Main results

* `AlgebraicGeometry.Space.exists_hilbertPresheafModel_isAlgebraicSpace_of_existence`:
  Stacks 0D01 from Stacks 0CXB. It carries no `@[stacks]` attribute: its hypothesis `h0CXB` is
  the conclusion of Stacks 0CXB.

## References

* [Stacks Project, Tag 0D01](https://stacks.math.columbia.edu/tag/0D01)
* [Stacks Project, Tag 09TU](https://stacks.math.columbia.edu/tag/09TU)
* [Stacks Project, Tag 0D00](https://stacks.math.columbia.edu/tag/0D00)
* [Stacks Project, Tag 0CXB](https://stacks.math.columbia.edu/tag/0CXB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Cardinal
open AlgebraicGeometry.GrothendieckExistence (limitBase baseAt)

universe u

namespace AlgebraicGeometry.Space

attribute [local instance] pointTopology

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **Stacks 0D01 from Stacks 0CXB.** For a morphism `f : X ⟶ Y` of algebraic spaces over `S`
which is of finite presentation and separated, the Hilbert functor `Hilb_{X/Y}` of Stacks 0CZY has
a model in the universe of the site which is an algebraic space whose canonical morphism to `Y` is
locally of finite presentation, given Grothendieck's existence theorem for algebraic spaces,
Stacks 0CXB (`h0CXB`, as in
`AlgebraicGeometry.Space.QuotSituation.isAlgebraicSpace_quotSitePresheafModel_of_existence`). -/
theorem exists_hilbertPresheafModel_isAlgebraicSpace_of_existence {X Y : AlgebraicSpaces B S hS}
    (f : X ⟶ Y) (hfp : IsFinitePresentation B S hS f.hom) (hsep : IsSeparated B S hS f.hom)
    (h0CXB : ∀ s : InverseSystemExistenceSituation.{u},
      ∃ F : Modules.{u, u} s.B (limitBase s.system) s.containsLimitBase s.X.left.1 s.X.left.2,
          F.IsFinitePresentationOnSite ∧
            IsFlatOver s.B (limitBase s.system) s.containsLimitBase s.X.left.2 s.X.hom.hom F ∧
            ∃ hcl : IsClosed (supportOfSheaf s.B (limitBase s.system) s.containsLimitBase s.X.left.1
                ((SheafOfModules.toSheaf _).obj F)),
              IsProperOver s.B (limitBase s.system) s.containsLimitBase s.X.left.2
                (schemeSpace (limitBaseObject s.system s.B s.containsLimitBase)).2 s.X.hom.hom
                (isLocallyOfFiniteType_of_isLocallyOfFinitePresentation s.B (limitBase s.system)
                  s.containsLimitBase s.finitePresentation.1)
                (supportOfSheaf s.B (limitBase s.system) s.containsLimitBase s.X.left.1
                  ((SheafOfModules.toSheaf _).obj F)) hcl ∧
              ∃ α : ∀ n : ℕ, (modulePullback s.B (limitBase s.system) s.containsLimitBase
                  (spaceProjection s.system s.B s.containsLimitBase s.containsBaseAt s.X n)).obj F ≅
                    (s.sheaf n).obj,
                ∀ n : ℕ,
                  (modulePullback s.B (limitBase s.system) s.containsLimitBase
                      (transitionSpace s.system s.B s.containsLimitBase s.containsBaseAt s.X n)).map
                        (α (n + 1)).hom ≫ (s.φ n).hom =
                    (modulePullbackCompIso s.B (limitBase s.system) s.containsLimitBase
                        (transitionSpace s.system s.B s.containsLimitBase s.containsBaseAt s.X n)
                        (spaceProjection s.system s.B s.containsLimitBase s.containsBaseAt s.X
                          (n + 1))).hom.app F ≫
                      eqToHom (congrArg (fun g => (modulePullback s.B (limitBase s.system)
                        s.containsLimitBase g).obj F)
                        (transitionSpace_spaceProjection s.system s.B s.containsLimitBase
                          s.containsBaseAt s.X n)) ≫
                      (α n).hom) :
    ∃ M : HilbertPresheafModel f,
      IsAlgebraicSpace B S hS M.presheaf ∧ IsLocallyOfFinitePresentation B S hS M.toBase :=
  exists_hilbertPresheafModel_of_quotAlgebraic f hfp hsep fun N =>
    (structureSheafQuotSituation f hfp).isAlgebraicSpace_quotSitePresheafModel_of_existence hsep
      ⟨ℵ₀, B.aleph0_lt_cutoff, isEtaleLocallyGeneratedBelow_structureSheafModule X⟩ h0CXB N

end AlgebraicGeometry.Space

end
