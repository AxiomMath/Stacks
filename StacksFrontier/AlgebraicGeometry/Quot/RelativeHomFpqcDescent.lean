@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace CategoryTheory.Functor

/-- **Conjugation by a comparison is injective.**  Two morphisms between the values of `P₁`
with equal conjugates by `e : P₂ ≅ P₁ ⋙ L` have equal images under `L`: the conjugate composes
the image with two components of `e`, and those are isomorphisms. -/
theorem map_eq_of_conjHom_eq {C D₁ D₂ : Type*} [Category* C] [Category* D₁] [Category* D₂]
    {P₁ : C ⥤ D₁} {P₂ : C ⥤ D₂} {L : D₁ ⥤ D₂} (e : P₂ ≅ P₁ ⋙ L) {M N : C}
    (α β : P₁.obj M ⟶ P₁.obj N) (h : conjHom e α = conjHom e β) : L.map α = L.map β := by
  have h' : e.hom.app M ≫ L.map α ≫ e.inv.app N = e.hom.app M ≫ L.map β ≫ e.inv.app N := h
  exact (cancel_mono (e.inv.app N)).1 ((cancel_epi (e.hom.app M)).1 h')

end CategoryTheory.Functor

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- Pullbacks of presheaves on the big fppf site over `S` (instance search times out without
this shortcut). -/
local instance (priority := high) hasPullback_presheaf_RelativeHomFpqcDescent
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

/-! ### Restriction of a homomorphism of inverse images -/

section Restrict

variable {V V' W X Z : AlgebraicSpaces B S hS}

/-- The associativity coherence of the comparison of inverse images of Stacks 03LU, solved for
the comparison along the triple composite.  This is
`AlgebraicGeometry.Space.modulePullbackTriangle_assoc` in the shape
`CategoryTheory.Functor.conjHom_comp` consumes. -/
theorem modulePullbackTriangle_assoc' {f : V ⟶ W} {g : W ⟶ X} {p : X ⟶ Z} {k : V ⟶ X}
    {q : W ⟶ Z} {r : V ⟶ Z} (hk : f ≫ g = k) (hq : g ≫ p = q) (hr : f ≫ q = r)
    (hkr : k ≫ p = r) :
    modulePullbackTriangle B S hS hkr =
      (modulePullbackTriangle B S hS hr ≪≫
          Functor.isoWhiskerRight (modulePullbackTriangle B S hS hq) (modulePullback B S hS f) ≪≫
          Functor.associator (modulePullback B S hS p) (modulePullback B S hS g)
            (modulePullback B S hS f)) ≪≫
        (Functor.isoWhiskerLeft (modulePullback B S hS p)
          (modulePullbackTriangle B S hS hk)).symm := by
  rw [← modulePullbackTriangle_assoc B S hS hk hq hr hkr, Iso.trans_assoc, Iso.self_symm_id,
    Iso.trans_refl]

/-- **The restriction of a homomorphism of inverse images along a further morphism.**  Given
`a : V ⟶ Z` with `a ≫ p = q`, a homomorphism `p^*M ⟶ p^*N` has an inverse image along `a`, read
through the comparison `q^* ≅ a^* ∘ p^*` of Stacks 03LU as a homomorphism `q^*M ⟶ q^*N`. -/
def restrictPullbackHom {p : Z ⟶ W} {q : V ⟶ W} (a : V ⟶ Z) (ha : a ≫ p = q)
    {M N : Modules.{u, u} B S hS W.1 W.2}
    (α : (modulePullback B S hS p).obj M ⟶ (modulePullback B S hS p).obj N) :
    (modulePullback B S hS q).obj M ⟶ (modulePullback B S hS q).obj N :=
  Functor.conjHom (modulePullbackTriangle B S hS ha) α

/-- **Restriction is functorial.**  Restricting along `a` and then along `b` is restricting
along the composite `b ≫ a`.  This is the associativity coherence of Stacks 03LU and carries no
hypothesis. -/
theorem restrictPullbackHom_comp {p : Z ⟶ W} {q : V ⟶ W} {r : V' ⟶ W} (a : V ⟶ Z)
    (ha : a ≫ p = q) (b : V' ⟶ V) (hb : b ≫ q = r) (hba : (b ≫ a) ≫ p = r)
    {M N : Modules.{u, u} B S hS W.1 W.2}
    (α : (modulePullback B S hS p).obj M ⟶ (modulePullback B S hS p).obj N) :
    restrictPullbackHom (b ≫ a) hba α =
      restrictPullbackHom b hb (restrictPullbackHom a ha α) :=
  Functor.conjHom_comp (modulePullbackTriangle B S hS ha) (modulePullbackTriangle B S hS hb)
    (modulePullbackTriangle B S hS hba) (modulePullbackTriangle B S hS rfl)
    (modulePullbackTriangle_assoc' rfl ha hb hba) α

/-- Restriction along equal morphisms is the same restriction: the proof that the composite is
the given morphism plays no part, by proof irrelevance. -/
theorem restrictPullbackHom_congr {p : Z ⟶ W} {q : V ⟶ W} {a a' : V ⟶ Z} (haa : a = a')
    (ha : a ≫ p = q) (ha' : a' ≫ p = q) {M N : Modules.{u, u} B S hS W.1 W.2}
    (α : (modulePullback B S hS p).obj M ⟶ (modulePullback B S hS p).obj N) :
    restrictPullbackHom a ha α = restrictPullbackHom a' ha' α := by
  subst haa
  rfl

/-- The inverse image of a homomorphism under a morphism along which its restriction is taken
is determined by that restriction. -/
theorem modulePullback_map_eq_of_restrictPullbackHom_eq {p : Z ⟶ W} {q : V ⟶ W} (a : V ⟶ Z)
    (ha : a ≫ p = q) {M N : Modules.{u, u} B S hS W.1 W.2}
    (α β : (modulePullback B S hS p).obj M ⟶ (modulePullback B S hS p).obj N)
    (h : restrictPullbackHom a ha α = restrictPullbackHom a ha β) :
    (modulePullback B S hS a).map α = (modulePullback B S hS a).map β :=
  Functor.map_eq_of_conjHom_eq (modulePullbackTriangle B S hS ha) α β h

/-- **A homomorphism of inverse images is determined by its restrictions along an fpqc
covering.**  This is the faithfulness half of the full-faithfulness clause of Stacks 04W8,
which is available in this development, granted its own hypothesis
`AlgebraicGeometry.Space.QuasiCoherentDescent.ReprFpqcHomInjective`. -/
theorem eq_of_restrictPullbackHom_eq_of_isFpqcCovering
    (hrepr : QuasiCoherentDescent.ReprFpqcHomInjective.{u, v} B S hS) {I : Type v}
    {Zi : I → AlgebraicSpaces B S hS} {p : Z ⟶ W} {r : ∀ i, Zi i ⟶ W} (c : ∀ i, Zi i ⟶ Z)
    (hr : ∀ i, c i ≫ p = r i) (hc : IsFpqcCovering B S hS fun i ↦ (c i).hom)
    {M N : Modules.{u, u} B S hS W.1 W.2}
    (α β : (modulePullback B S hS p).obj M ⟶ (modulePullback B S hS p).obj N)
    (h : ∀ i, restrictPullbackHom (c i) (hr i) α = restrictPullbackHom (c i) (hr i) β) :
    α = β :=
  QuasiCoherentDescent.modulePullback_map_injective_of_isFpqcCovering B S hS hrepr Zi c hc α β
    fun i ↦ modulePullback_map_eq_of_restrictPullbackHom_eq (c i) (hr i) α β (h i)

/-- If two restrictions along `a₁` and `a₂` agree, then so do their restrictions along the
composites `m ≫ a₁` and `m ≫ a₂` through a common morphism `m`. -/
private theorem restrictPullbackHom_eq_of_comp_eq {Z₁ Z₂ W : AlgebraicSpaces B S hS}
    {p₁ : Z₁ ⟶ W} {p₂ : Z₂ ⟶ W} {q : V ⟶ W} {r : V' ⟶ W} (a₁ : V ⟶ Z₁) (ha₁ : a₁ ≫ p₁ = q)
    (a₂ : V ⟶ Z₂) (ha₂ : a₂ ≫ p₂ = q) (m : V' ⟶ V) (hm : m ≫ q = r) {e₁ : V' ⟶ Z₁}
    {e₂ : V' ⟶ Z₂} (he₁ : m ≫ a₁ = e₁) (he₂ : m ≫ a₂ = e₂) (he₁' : e₁ ≫ p₁ = r)
    (he₂' : e₂ ≫ p₂ = r) {M N : Modules.{u, u} B S hS W.1 W.2}
    (α₁ : (modulePullback B S hS p₁).obj M ⟶ (modulePullback B S hS p₁).obj N)
    (α₂ : (modulePullback B S hS p₂).obj M ⟶ (modulePullback B S hS p₂).obj N)
    (h : restrictPullbackHom a₁ ha₁ α₁ = restrictPullbackHom a₂ ha₂ α₂) :
    restrictPullbackHom e₁ he₁' α₁ = restrictPullbackHom e₂ he₂' α₂ := by
  subst he₁ he₂
  rw [restrictPullbackHom_comp a₁ ha₁ m hm he₁', restrictPullbackHom_comp a₂ ha₂ m hm he₂', h]

end Restrict

/-- The two projections of the base change of a morphism along a test scheme agree over the
target: the defining square is cartesian. -/
theorem baseChangeProjection_comp {X Y : AlgebraicSpaces B S hS} (f : X ⟶ Y)
    (T : SchemesOver Y) :
    baseChangeProjection f T ≫ f = baseChangeInclusion f T ≫ T.hom :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS f T.hom).w

/-! ### The overlaps of a covering family, and the condition on a family of homomorphisms -/

section Overlap

variable {X W : AlgebraicSpaces B S hS} {I : Type v} {Zi : I → AlgebraicSpaces B S hS}

/-- The first projection of the chosen fibre product of two algebraic spaces. -/
abbrev fiberFst {A D : AlgebraicSpaces B S hS} (f : A ⟶ W) (g : D ⟶ W) :
    AlgebraicSpaces.fiberProduct B S hS f g ⟶ A :=
  ObjectProperty.homMk (pullback.fst f.hom g.hom)

/-- The second projection of the chosen fibre product of two algebraic spaces. -/
abbrev fiberSnd {A D : AlgebraicSpaces B S hS} (f : A ⟶ W) (g : D ⟶ W) :
    AlgebraicSpaces.fiberProduct B S hS f g ⟶ D :=
  ObjectProperty.homMk (pullback.snd f.hom g.hom)

/-- The overlap `Z i ×_W Z j` of two members of a family of morphisms to `W`. -/
abbrev overlapSpace (c : ∀ i, Zi i ⟶ W) (i j : I) : AlgebraicSpaces B S hS :=
  AlgebraicSpaces.fiberProduct B S hS (c i) (c j)

/-- The first projection `Z i ×_W Z j ⟶ Z i` of an overlap. -/
def overlapFst (c : ∀ i, Zi i ⟶ W) (i j : I) : overlapSpace c i j ⟶ Zi i :=
  fiberFst (c i) (c j)

/-- The second projection `Z i ×_W Z j ⟶ Z j` of an overlap. -/
def overlapSnd (c : ∀ i, Zi i ⟶ W) (i j : I) : overlapSpace c i j ⟶ Zi j :=
  fiberSnd (c i) (c j)

/-- The two projections of an overlap agree over `W`. -/
theorem overlapFst_comp_eq (c : ∀ i, Zi i ⟶ W) (i j : I) :
    overlapFst c i j ≫ c i = overlapSnd c i j ≫ c j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (c i) (c j)).w

/-- The two projections of an overlap agree over any `X` the family maps to through `W`. -/
theorem overlapSnd_comp_eq (w : W ⟶ X) (c : ∀ i, Zi i ⟶ W) (q : ∀ i, Zi i ⟶ X)
    (hq : ∀ i, c i ≫ w = q i) (i j : I) :
    overlapSnd c i j ≫ q j = overlapFst c i j ≫ q i := by
  rw [← hq i, ← hq j, ← Category.assoc, ← Category.assoc, overlapFst_comp_eq]

/-- **The overlap condition on a family of local homomorphisms.**  For a family
`(c i : Z i ⟶ W)` whose members map to `X` through `w` by `q i`, and two `𝒪_X`-modules, a family
of homomorphisms `α i : (q i)^*F ⟶ (q i)^*G` *agrees on the overlaps* when for every pair `i, j`
the restrictions of `α i` and `α j` to `Z i ×_W Z j` are the same homomorphism.

This is the equalizer condition of Stacks 08JV and of Stacks 08K3. -/
def RestrictionsAgree (w : W ⟶ X) (c : ∀ i, Zi i ⟶ W) (q : ∀ i, Zi i ⟶ X)
    (hq : ∀ i, c i ≫ w = q i) {F G : Modules.{u, u} B S hS X.1 X.2}
    (α : ∀ i, (modulePullback B S hS (q i)).obj F ⟶ (modulePullback B S hS (q i)).obj G) :
    Prop :=
  ∀ i j, restrictPullbackHom (overlapFst c i j) (rfl : overlapFst c i j ≫ q i = _) (α i) =
    restrictPullbackHom (overlapSnd c i j) (overlapSnd_comp_eq w c q hq i j) (α j)

/-- **The overlap condition may be checked on a covering of each overlap.**  If every overlap
`Z i ×_W Z j` carries an fpqc covering along which the restrictions of `α i` and `α j` agree,
then they agree on the overlap itself: a homomorphism of inverse images is determined by its
restrictions along an fpqc covering. -/
theorem restrictionsAgree_of_refinement
    (hrepr : QuasiCoherentDescent.ReprFpqcHomInjective.{u, v} B S hS)
    (w : W ⟶ X) (c : ∀ i, Zi i ⟶ W) (q : ∀ i, Zi i ⟶ X) (hq : ∀ i, c i ≫ w = q i)
    {K : I → I → Type v} {D : ∀ i j, K i j → AlgebraicSpaces B S hS}
    (d : ∀ i j (k : K i j), D i j k ⟶ overlapSpace c i j)
    (hd : ∀ i j, IsFpqcCovering B S hS fun k ↦ (d i j k).hom)
    {F G : Modules.{u, u} B S hS X.1 X.2}
    (α : ∀ i, (modulePullback B S hS (q i)).obj F ⟶ (modulePullback B S hS (q i)).obj G)
    (hα : ∀ i j k, restrictPullbackHom (d i j k ≫ overlapFst c i j)
        (rfl : (d i j k ≫ overlapFst c i j) ≫ q i = _) (α i) =
      restrictPullbackHom (d i j k ≫ overlapSnd c i j)
        (by rw [Category.assoc, Category.assoc, overlapSnd_comp_eq w c q hq i j]) (α j)) :
    RestrictionsAgree w c q hq α := by
  intro i j
  refine eq_of_restrictPullbackHom_eq_of_isFpqcCovering hrepr (d i j) (fun _ ↦ rfl) (hd i j)
    _ _ fun k ↦ ?_
  rw [← restrictPullbackHom_comp (overlapFst c i j) rfl (d i j k) rfl,
    ← restrictPullbackHom_comp (overlapSnd c i j) (overlapSnd_comp_eq w c q hq i j) (d i j k) rfl]
  exact hα i j k

end Overlap

/-! ### The gluing half of Stacks 04W8 -/

/-- **The gluing half of the full-faithfulness clause of Stacks 04W8**, in the form the
relative Hom functor consumes: given an fpqc covering `(c i : Z i ⟶ W)` of algebraic spaces over
`S`, a morphism `w : W ⟶ X` with composites `q i`, and two `𝒪_X`-modules whose inverse images
along `w` are quasi-coherent, a family of homomorphisms `(q i)^*F ⟶ (q i)^*G` agreeing on the
overlaps comes from a unique homomorphism `w^*F ⟶ w^*G`.

Up to the comparisons of Stacks 03LU this is the assertion that the canonical descent functor of
Stacks 04W5 for the covering `(c i)` is full and faithful on the Hom set of the two
quasi-coherent modules `w^*F` and `w^*G`.  Both halves are theorems of this development — the
faithfulness half is
`AlgebraicGeometry.Space.QuasiCoherentDescent.modulePullback_map_injective_of_isFpqcCovering`
and the fullness half is
`AlgebraicGeometry.Space.QuasiCoherentDescent.exists_modulePullback_map_eq_of_isFpqcCovering`
at `AlgebraicGeometry.Space.QuasiCoherentDescent.reprFpqcHomSurjective` — so this predicate
holds, by `AlgebraicGeometry.Space.existsUnique_restrictPullbackHom_eq_of_isFpqcCovering`
below.  It is kept as a
named predicate because it is the exact shape the descent statements of Stacks 08JV and
Stacks 08K3 apply. -/
def GluesModuleHomAlongFpqcCovering (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) : Prop :=
  ∀ {I : Type v} {X W : AlgebraicSpaces B S hS} {Zi : I → AlgebraicSpaces B S hS}
    (w : W ⟶ X) (c : ∀ i, Zi i ⟶ W) (q : ∀ i, Zi i ⟶ X) (hq : ∀ i, c i ≫ w = q i),
    IsFpqcCovering B S hS (fun i ↦ (c i).hom) →
    ∀ F G : Modules.{u, u} B S hS X.1 X.2,
      ((modulePullback B S hS w).obj F).IsQuasicoherentOnSite →
      ((modulePullback B S hS w).obj G).IsQuasicoherentOnSite →
    ∀ α : ∀ i, (modulePullback B S hS (q i)).obj F ⟶ (modulePullback B S hS (q i)).obj G,
      RestrictionsAgree w c q hq α →
      ∃! β : (modulePullback B S hS w).obj F ⟶ (modulePullback B S hS w).obj G,
        ∀ i, restrictPullbackHom (c i) (hq i) β = α i

open QuasiCoherentDescent in
/-- The restriction of a homomorphism of inverse images along a further morphism is its
restricted reading through the comparison of Stacks 03LU. -/
theorem restrictPullbackHom_eq_restrictForm_of_comp_eq {V Z W : AlgebraicSpaces B S hS}
    {p : Z ⟶ W} {q : V ⟶ W} (a : V ⟶ Z) (ha : a ≫ p = q)
    {M N : Modules.{u, u} B S hS W.1 W.2}
    (α : (modulePullback B S hS p).obj M ⟶ (modulePullback B S hS p).obj N) :
    restrictPullbackHom a ha α = restrictForm B S hS a p q ha α := by
  subst ha
  rw [restrictForm_eq, factorForm_eq, pullbackComparison_rfl, pullbackComparison_rfl]
  simp only [restrictPullbackHom, Functor.conjHom, modulePullbackTriangle_rfl]
  rfl

open QuasiCoherentDescent in
/-- **The gluing half of the full-faithfulness clause of Stacks 04W8**, as a theorem: given an
fpqc covering `(c i : Z i ⟶ W)` of algebraic spaces, a morphism `w : W ⟶ X` with composites
`q i`, and two `𝒪_X`-modules whose inverse images along `w` are quasi-coherent, a family of
homomorphisms `(q i)^*F ⟶ (q i)^*G` agreeing on the overlaps comes from a unique homomorphism
`w^*F ⟶ w^*G`.

The family is read through the comparisons of Stacks 03LU as a family of homomorphisms of the
inverse images along `c i` of `w^*F` and `w^*G`; the overlap condition is then the pairwise
condition of Stacks 04W3 for that family, which descends by the fullness half of Stacks 04W8,
`AlgebraicGeometry.Space.QuasiCoherentDescent.exists_modulePullback_map_eq_of_isFpqcCovering`
at `AlgebraicGeometry.Space.QuasiCoherentDescent.reprFpqcHomSurjective`, uniquely by its
faithfulness half,
`AlgebraicGeometry.Space.QuasiCoherentDescent.modulePullback_map_injective_of_isFpqcCovering`
at `AlgebraicGeometry.Space.QuasiCoherentDescent.reprFpqcHomInjective`. -/
theorem existsUnique_restrictPullbackHom_eq_of_isFpqcCovering :
    GluesModuleHomAlongFpqcCovering.{u, v} B S hS := by
  intro I X W Zi w c q hq hc F G hF hG α hα
  -- the family read on the inverse images along `c i` of `w^*F` and `w^*G`
  choose x hx using fun i => exists_factorForm_eq B S hS (c i) w (q i) (hq i) (α i)
  have hcompat : IsPairwiseCompatible B S hS Zi c x := by
    intro i j
    have hr : pairFst B S hS Zi c i j ≫ c i = pairFst B S hS Zi c i j ≫ c i := rfl
    have hr' : pairSnd B S hS Zi c i j ≫ c j = pairFst B S hS Zi c i j ≫ c i :=
      (pair_condition B S hS Zi c i j).symm
    refine canonicalComparison_naturality_of_restrictForm_eq B S hS _ _ (c i) (c j)
      (pairFst B S hS Zi c i j ≫ c i) hr hr' _ (x i) (x j) ?_
    refine factorForm_injective B S hS (pairFst B S hS Zi c i j ≫ c i) w
      (pairFst B S hS Zi c i j ≫ q i) (by rw [Category.assoc, hq i]) ?_
    have h1 := restrictForm_factorForm B S hS (pairFst B S hS Zi c i j) (c i) w (q i) (hq i)
      (pairFst B S hS Zi c i j ≫ c i) hr (pairFst B S hS Zi c i j ≫ q i) rfl
      (by rw [Category.assoc, hq i]) (x i)
    have h2 := restrictForm_factorForm B S hS (pairSnd B S hS Zi c i j) (c j) w (q j) (hq j)
      (pairFst B S hS Zi c i j ≫ c i) hr' (pairFst B S hS Zi c i j ≫ q i)
      (by simp only [← hq, ← Category.assoc, pair_condition])
      (by rw [Category.assoc, hq i]) (x j)
    rw [← h1, ← h2, hx i, hx j]
    have hα' := hα i j
    rw [restrictPullbackHom_eq_restrictForm_of_comp_eq,
      restrictPullbackHom_eq_restrictForm_of_comp_eq] at hα'
    exact hα'
  obtain ⟨β, hβ⟩ := exists_modulePullback_map_eq_of_isFpqcCovering B S hS
    (reprFpqcHomSurjective.{u, v} B S hS) Zi c hc x hcompat hF hG
  have key : ∀ (γ : (modulePullback B S hS w).obj F ⟶ (modulePullback B S hS w).obj G) i,
      restrictPullbackHom (c i) (hq i) γ =
        factorForm B S hS (c i) w (q i) (hq i) ((modulePullback B S hS (c i)).map γ) :=
    fun γ i => restrictPullbackHom_eq_restrictForm_of_comp_eq (c i) (hq i) γ
  refine ⟨β, fun i => by rw [key, hβ i, hx i], fun γ hγ => ?_⟩
  refine modulePullback_map_injective_of_isFpqcCovering B S hS
    (reprFpqcHomInjective.{u, v} B S hS) Zi c hc γ β fun i => ?_
  refine factorForm_injective B S hS (c i) w (q i) (hq i) ?_
  rw [← key, hγ i, hβ i, hx i]

namespace HomSituation

variable (s : HomSituation B S hS)

/-! ### Stacks 08JV: the sheaf property for the fpqc topology -/

/-- The restriction of a section of the relative Hom functor along a morphism of test schemes
is its restriction along the induced morphism of base changes: the comparison of the two base
changes is the comparison of Stacks 03LU for `X_U ⟶ X_T ⟶ X`. -/
theorem restrictPullbackHom_baseChangeMap {U T : s.SchemesOver} (g : U ⟶ T) (α : s.homAt T) :
    restrictPullbackHom (baseChangeMap s.f g) (baseChangeMap_comp_projection s.f g)
        (s.toModuleHom α) =
      s.toModuleHom (s.homMap g α) :=
  rfl

/-- **Stacks 08JV.**  In the standing data of Stacks 08JT the relative Hom functor
`Hom(F, G)` satisfies the sheaf property for the fpqc topology: for an fpqc covering
`{U i ⟶ T}` of test schemes over the base, a family of homomorphisms `F_{U i} ⟶ G_{U i}` whose
restrictions agree on the overlaps `X_{U i} ×_{X_T} X_{U j}` comes from a unique
homomorphism `F_T ⟶ G_T`.

This is the proof of the source.  The base changes `{X_{U i} ⟶ X_T}` form an fpqc covering of
`X_T` by Stacks 03MR, part (3), in the form of
`AlgebraicGeometry.Space.isFpqcCovering_baseChangeMap`, and a compatible family of
homomorphisms of the inverse images of two quasi-coherent modules along an fpqc covering glues
uniquely, which is the gluing half of Stacks 04W8,
`AlgebraicGeometry.Space.existsUnique_restrictPullbackHom_eq_of_isFpqcCovering`.  The
base-changed modules `F_T`,
`G_T` are quasi-coherent by Stacks 03GA,
`AlgebraicGeometry.Space.isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite`. -/
@[stacks 08JV "the sheaf property elementwise, for an fpqc covering of test schemes; the same \
property as CategoryTheory.Presieve.IsSheafFor is isSheafFor_homFunctor"]
theorem existsUnique_homMap_of_restrictionsAgree
    {I : Type v} {T : s.SchemesOver} {U : I → s.SchemesOver} (g : ∀ i, U i ⟶ T)
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom)
    (α : ∀ i, s.homAt (U i))
    (hα : RestrictionsAgree (s.projection T) (fun i ↦ baseChangeMap s.f (g i))
      (fun i ↦ s.projection (U i)) (fun i ↦ baseChangeMap_comp_projection s.f (g i))
      (fun i ↦ s.toModuleHom (α i))) :
    ∃! β : s.homAt T, ∀ i, s.homMap (g i) β = α i := by
  obtain ⟨β, hβ, huniq⟩ := existsUnique_restrictPullbackHom_eq_of_isFpqcCovering.{u, v}
    (s.projection T) (fun i ↦ baseChangeMap s.f (g i))
    (fun i ↦ s.projection (U i)) (fun i ↦ baseChangeMap_comp_projection s.f (g i))
    (isFpqcCovering_baseChangeMap s.f g hg) s.F s.G
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS (s.projection T)
      s.F s.quasicoherent_F)
    (isQuasicoherentOnSite_modulePullback_of_isQuasicoherentOnSite B S hS (s.projection T)
      s.G s.quasicoherent_G) (fun i ↦ s.toModuleHom (α i)) hα
  refine ⟨β, fun i ↦ ?_, fun γ hγ ↦ huniq γ fun i ↦ ?_⟩
  · exact (s.restrictPullbackHom_baseChangeMap (g i) β).symm.trans (hβ i)
  · exact (s.restrictPullbackHom_baseChangeMap (g i) γ).trans (congrArg s.toModuleHom (hγ i))


/-! ### Stacks 08JV in the form of the sheaf condition for a presieve -/

section SheafCondition

/-- Fibre products of the schemes of the big fppf site over `S`, from the fibre products of the
schemes of the site itself. -/
private instance hasPullbacks_bigFppfOver : HasPullbacks (BigFppfOver B S hS) :=
  letI := B.hasPullbacks_schemes
  inferInstance

/-- **The algebraic space represented by a fibre product of schemes of the site is the fibre
product of the represented spaces.**  The Yoneda embedding preserves fibre products and the
algebraic spaces are a full subcategory of the presheaves, so the represented square is
cartesian. -/
theorem isPullback_schemeSpaceFunctor {V W Y : BigFppfOver B S hS} (p : V ⟶ Y) (q : W ⟶ Y) :
    IsPullback ((schemeSpaceFunctor B S hS).map (pullback.fst p q))
      ((schemeSpaceFunctor B S hS).map (pullback.snd p q))
      ((schemeSpaceFunctor B S hS).map p) ((schemeSpaceFunctor B S hS).map q) := by
  refine IsPullback.of_map_of_faithful (ObjectProperty.ι _) ?_
  exact (IsPullback.of_hasPullback p q).map yoneda

variable {T U U' : s.SchemesOver}

/-- The overlap `U ×_T U'` of two test schemes over a third, as a test scheme over the base:
the fibre product of the two schemes of the site, with the structure morphism inherited from the
first factor. -/
abbrev overlapTest (g : U ⟶ T) (g' : U' ⟶ T) : s.SchemesOver :=
  CostructuredArrow.mk ((schemeSpaceFunctor B S hS).map (pullback.fst g.left g'.left) ≫ U.hom)

/-- The first projection `U ×_T U' ⟶ U` of the overlap of two test schemes. -/
def overlapTestFst (g : U ⟶ T) (g' : U' ⟶ T) : s.overlapTest g g' ⟶ U :=
  CostructuredArrow.homMk (pullback.fst g.left g'.left) rfl

/-- The second projection `U ×_T U' ⟶ U'` of the overlap of two test schemes. -/
def overlapTestSnd (g : U ⟶ T) (g' : U' ⟶ T) : s.overlapTest g g' ⟶ U' :=
  CostructuredArrow.homMk (pullback.snd g.left g'.left)
    (by
      have e : (schemeSpaceFunctor B S hS).map (pullback.snd g.left g'.left ≫ g'.left) =
          (schemeSpaceFunctor B S hS).map (pullback.fst g.left g'.left ≫ g.left) :=
        congrArg _ pullback.condition.symm
      rw [Functor.map_comp, Functor.map_comp] at e
      rw [CostructuredArrow.mk_hom_eq_self, ← CostructuredArrow.w g, ← CostructuredArrow.w g',
        ← Category.assoc, ← Category.assoc, e])

/-- The two projections of the overlap of two test schemes agree over the common target. -/
theorem overlapTest_condition (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestFst g g' ≫ g = s.overlapTestSnd g g' ≫ g' :=
  CostructuredArrow.hom_ext _ _ pullback.condition

/-- The first projection of the overlap is the first projection of the fibre product of the two
schemes of the site. -/
theorem overlapTestFst_left (g : U ⟶ T) (g' : U' ⟶ T) :
    (s.overlapTestFst g g').left = pullback.fst g.left g'.left := rfl

/-- The second projection of the overlap is the second projection of the fibre product of the
two schemes of the site. -/
theorem overlapTestSnd_left (g : U ⟶ T) (g' : U' ⟶ T) :
    (s.overlapTestSnd g g').left = pullback.snd g.left g'.left := rfl

/-- The morphism from the fibre product of two base changes of test schemes to the algebraic
space represented by their overlap, given by the two projections to the test schemes. -/
def overlapTestLift (g : U ⟶ T) (g' : U' ⟶ T) :
    AlgebraicSpaces.fiberProduct B S hS (baseChangeMap s.f g) (baseChangeMap s.f g') ⟶
      (schemeSpaceFunctor B S hS).obj (s.overlapTest g g').left :=
  (isPullback_schemeSpaceFunctor g.left g'.left).lift
    (fiberFst (baseChangeMap s.f g) (baseChangeMap s.f g') ≫ baseChangeInclusion s.f U)
    (fiberSnd (baseChangeMap s.f g) (baseChangeMap s.f g') ≫ baseChangeInclusion s.f U')
    (by
      rw [Category.assoc, Category.assoc, ← baseChangeMap_comp_inclusion s.f g,
        ← baseChangeMap_comp_inclusion s.f g', ← Category.assoc, ← Category.assoc,
        (AlgebraicSpaces.isPullback_fiberProduct B S hS
          (baseChangeMap s.f g) (baseChangeMap s.f g')).w])

/-- The morphism to the represented overlap, followed by the first projection. -/
@[reassoc]
theorem overlapTestLift_comp_fst (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestLift g g' ≫ (schemeSpaceFunctor B S hS).map (pullback.fst g.left g'.left) =
      fiberFst (baseChangeMap s.f g) (baseChangeMap s.f g') ≫ baseChangeInclusion s.f U :=
  (isPullback_schemeSpaceFunctor g.left g'.left).lift_fst _ _ _

/-- The morphism to the represented overlap, followed by the second projection. -/
@[reassoc]
theorem overlapTestLift_comp_snd (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestLift g g' ≫ (schemeSpaceFunctor B S hS).map (pullback.snd g.left g'.left) =
      fiberSnd (baseChangeMap s.f g) (baseChangeMap s.f g') ≫ baseChangeInclusion s.f U' :=
  (isPullback_schemeSpaceFunctor g.left g'.left).lift_snd _ _ _

/-- **The fibre product of two base changes maps to the base change of the overlap.**  The base
change `X_{U ×_T U'}` of the overlap of two test schemes receives the fibre product
`X_U ×_{X_T} X_{U'}`, by its projections to `X` and to the represented overlap. -/
def overlapTestComparison (g : U ⟶ T) (g' : U' ⟶ T) :
    AlgebraicSpaces.fiberProduct B S hS (baseChangeMap s.f g) (baseChangeMap s.f g') ⟶
      baseChangeSpace s.f (s.overlapTest g g') :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS s.f (s.overlapTest g g').hom).lift
    (fiberFst (baseChangeMap s.f g) (baseChangeMap s.f g') ≫ baseChangeProjection s.f U)
    (s.overlapTestLift g g')
    (by
      rw [Category.assoc, baseChangeProjection_comp, ← s.overlapTestLift_comp_fst_assoc g g',
        CostructuredArrow.mk_hom_eq_self])

/-- The comparison, followed by the projection to `X`. -/
@[reassoc]
theorem overlapTestComparison_comp_projection (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestComparison g g' ≫ baseChangeProjection s.f (s.overlapTest g g') =
      fiberFst (baseChangeMap s.f g) (baseChangeMap s.f g') ≫ baseChangeProjection s.f U :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS s.f (s.overlapTest g g').hom).lift_fst _ _ _

/-- The comparison, followed by the projection to the represented overlap. -/
@[reassoc]
theorem overlapTestComparison_comp_inclusion (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestComparison g g' ≫ baseChangeInclusion s.f (s.overlapTest g g') =
      s.overlapTestLift g g' :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS s.f (s.overlapTest g g').hom).lift_snd _ _ _

/-- **The comparison carries the base change of the first projection of the overlap to the
first projection of the fibre product of the base changes.** -/
theorem overlapTestComparison_comp_baseChangeMap_fst (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestComparison g g' ≫ baseChangeMap s.f (s.overlapTestFst g g') =
      fiberFst (baseChangeMap s.f g) (baseChangeMap s.f g') := by
  refine baseChange_hom_ext s.f ?_ ?_
  · rw [Category.assoc, baseChangeMap_comp_projection,
      s.overlapTestComparison_comp_projection g g']
  · rw [Category.assoc, baseChangeMap_comp_inclusion, s.overlapTestFst_left g g',
      s.overlapTestComparison_comp_inclusion_assoc g g', s.overlapTestLift_comp_fst g g']

/-- **The comparison carries the base change of the second projection of the overlap to the
second projection of the fibre product of the base changes.** -/
theorem overlapTestComparison_comp_baseChangeMap_snd (g : U ⟶ T) (g' : U' ⟶ T) :
    s.overlapTestComparison g g' ≫ baseChangeMap s.f (s.overlapTestSnd g g') =
      fiberSnd (baseChangeMap s.f g) (baseChangeMap s.f g') := by
  refine baseChange_hom_ext s.f ?_ ?_
  · rw [Category.assoc, baseChangeMap_comp_projection,
      s.overlapTestComparison_comp_projection g g',
      ← baseChangeMap_comp_projection s.f g, ← baseChangeMap_comp_projection s.f g',
      ← Category.assoc, ← Category.assoc,
      (AlgebraicSpaces.isPullback_fiberProduct B S hS
        (baseChangeMap s.f g) (baseChangeMap s.f g')).w]
  · rw [Category.assoc, baseChangeMap_comp_inclusion, s.overlapTestSnd_left g g',
      s.overlapTestComparison_comp_inclusion_assoc g g', s.overlapTestLift_comp_snd g g']

/-- **Stacks 08JV, as the sheaf condition for a presieve.**  In the standing data of
Stacks 08JT the relative Hom functor `Hom(F, G)` is a sheaf for the presieve generated by an
fpqc covering `{U i ⟶ T}` of test schemes over the base: every compatible family of sections
has a unique amalgamation.

This is `AlgebraicGeometry.Space.HomSituation.existsUnique_homMap_of_restrictionsAgree` with
the compatibility of the family transported to the overlaps `X_{U i} ×_{X_T} X_{U j}` of the
base changes.  That transport is the content added here: the overlap `U i ×_T U j` of two test
schemes is again a test scheme, so a compatible family restricts compatibly to it, and the
fibre product of the two base changes maps to the base change of that overlap by
`AlgebraicGeometry.Space.HomSituation.overlapTestComparison`, which carries the two projections
of the fibre product to the base changes of the two projections of the overlap.

This is the form of the sheaf property that Stacks 08K8 consumes, as the hypothesis `hHom` of
`AlgebraicGeometry.Space.HomSituation.isSheafFor_isomFunctor`. -/
@[stacks 08JV "the sheaf property for the presieve of an fpqc covering of test schemes"]
theorem isSheafFor_homFunctor (hc : ModulePushforwardCoherence B S hS)
    {I : Type v} {T : s.SchemesOver} {U : I → s.SchemesOver} (g : ∀ i, U i ⟶ T)
    (hg : IsFpqcCovering B S hS fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom) :
    Presieve.IsSheafFor (s.homFunctor hc) (Presieve.ofArrows U g) := by
  intro x hx
  have e : ∀ {A B : s.SchemesOver} (m : A ⟶ B),
      (s.homFunctor hc).map m.op = TypeCat.ofHom (s.homMap m) := fun m ↦ s.homFunctor_map hc m
  set α : ∀ i, s.homAt (U i) := fun i ↦ x (g i) (Presieve.ofArrows.mk i) with hαdef
  have key : ∀ i j, s.homMap (s.overlapTestFst (g i) (g j)) (α i) =
      s.homMap (s.overlapTestSnd (g i) (g j)) (α j) := by
    intro i j
    have h := hx (s.overlapTestFst (g i) (g j)) (s.overlapTestSnd (g i) (g j))
      (Presieve.ofArrows.mk i) (Presieve.ofArrows.mk j) (s.overlapTest_condition (g i) (g j))
    rw [e, e] at h
    exact h
  have hα : RestrictionsAgree (s.projection T) (fun i ↦ baseChangeMap s.f (g i))
      (fun i ↦ s.projection (U i)) (fun i ↦ baseChangeMap_comp_projection s.f (g i))
      (fun i ↦ s.toModuleHom (α i)) := by
    intro i j
    have hcc : s.overlapTestComparison (g i) (g j) ≫
          baseChangeProjection s.f (s.overlapTest (g i) (g j)) =
        fiberFst (baseChangeMap s.f (g i)) (baseChangeMap s.f (g j)) ≫
          baseChangeProjection s.f (U i) := by
      rw [← baseChangeMap_comp_projection s.f (s.overlapTestFst (g i) (g j)), ← Category.assoc,
        s.overlapTestComparison_comp_baseChangeMap_fst (g i) (g j)]
    refine restrictPullbackHom_eq_of_comp_eq _
      (baseChangeMap_comp_projection s.f (s.overlapTestFst (g i) (g j))) _
      (baseChangeMap_comp_projection s.f (s.overlapTestSnd (g i) (g j)))
      (s.overlapTestComparison (g i) (g j)) hcc
      (s.overlapTestComparison_comp_baseChangeMap_fst (g i) (g j))
      (s.overlapTestComparison_comp_baseChangeMap_snd (g i) (g j)) _ _ _ _ ?_
    rw [s.restrictPullbackHom_baseChangeMap (s.overlapTestFst (g i) (g j)) (α i),
      s.restrictPullbackHom_baseChangeMap (s.overlapTestSnd (g i) (g j)) (α j), key i j]
  obtain ⟨β, hβ, huniq⟩ := s.existsUnique_homMap_of_restrictionsAgree g hg α hα
  refine ⟨β, ?_, fun γ hγ ↦ huniq γ fun i ↦ ?_⟩
  · intro Y f hf
    obtain ⟨i⟩ := hf
    rw [e]
    exact hβ i
  · have h := hγ (g i) (Presieve.ofArrows.mk i)
    rw [e] at h
    exact h

end SheafCondition

/-! ### Stacks 08K3: descent along a covering of the source -/

section SourceCovering

variable {I : Type v} {Xi : I → AlgebraicSpaces B S hS} (a : ∀ i, Xi i ⟶ s.X)
  (T : s.SchemesOver)

/-- The base change `X_{i, T} = X_i ×_X X_T = X_i ×_{base} T` of a member of a covering of the
source along a test scheme over the base. -/
abbrev memberSpace (i : I) : AlgebraicSpaces B S hS :=
  AlgebraicSpaces.fiberProduct B S hS (a i) (s.projection T)

/-- The projection `X_{i, T} ⟶ X_i`. -/
def memberProjection (i : I) : s.memberSpace a T i ⟶ Xi i :=
  fiberFst (a i) (s.projection T)

/-- The projection `X_{i, T} ⟶ X_T`. -/
def memberInclusion (i : I) : s.memberSpace a T i ⟶ s.baseChange T :=
  fiberSnd (a i) (s.projection T)

/-- The structure morphism `X_{i, T} ⟶ X`, along which `F` and `G` are pulled back to give the
base changes to `T` of the restrictions `F_i` and `G_i` to the member. -/
def memberToSource (i : I) : s.memberSpace a T i ⟶ s.X :=
  s.memberProjection a T i ≫ a i

/-- A morphism into the base change of a member is determined by its two projections. -/
theorem member_hom_ext {V : AlgebraicSpaces B S hS} {i : I}
    {k l : V ⟶ s.memberSpace a T i}
    (h₁ : k ≫ s.memberProjection a T i = l ≫ s.memberProjection a T i)
    (h₂ : k ≫ s.memberInclusion a T i = l ≫ s.memberInclusion a T i) : k = l :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (s.projection T)).hom_ext h₁ h₂

/-- The projection to `X_T` followed by `X_T ⟶ X` is the structure morphism to `X`. -/
theorem memberInclusion_comp (i : I) :
    s.memberInclusion a T i ≫ s.projection T = s.memberToSource a T i :=
  ((AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (s.projection T)).w).symm

/-- **The base changes of a covering of the source cover the base change of the source.**  The
family `{X_{i, T} ⟶ X_T}` is the family `{X_i ⟶ X}` pulled back along `X_T ⟶ X`, so it is an
fpqc covering by Stacks 03MR, part (3). -/
theorem isFpqcCovering_memberInclusion (ha : IsFpqcCovering B S hS fun i ↦ (a i).hom) :
    IsFpqcCovering B S hS fun i ↦ (s.memberInclusion a T i).hom :=
  isFpqcCovering_pullback B S hS a (s.projection T) ha

variable {K : I → I → Type v} {Xijk : ∀ i j, K i j → AlgebraicSpaces B S hS}
  (b : ∀ i j (k : K i j), Xijk i j k ⟶ overlapSpace a i j)

/-- The structure morphism `X_{ijk} ⟶ X` of a member of a chosen covering of an overlap of the
covering of the source. -/
def tripleToSource (i j : I) (k : K i j) : Xijk i j k ⟶ s.X :=
  b i j k ≫ overlapFst a i j ≫ a i

/-- The structure morphism of `X_{ijk}` read through the second projection of the overlap: the
two projections of `X_i ×_X X_j` agree over `X`. -/
theorem tripleToSource_eq (i j : I) (k : K i j) :
    b i j k ≫ overlapSnd a i j ≫ a j = s.tripleToSource a b i j k := by
  rw [tripleToSource, overlapFst_comp_eq a i j]

/-- The base change `X_{ijk, T} = X_{ijk} ×_X X_T` of a member of a chosen covering of an
overlap. -/
abbrev tripleSpace (i j : I) (k : K i j) : AlgebraicSpaces B S hS :=
  AlgebraicSpaces.fiberProduct B S hS (s.tripleToSource a b i j k) (s.projection T)

/-- The projection `X_{ijk, T} ⟶ X_{ijk}`. -/
def tripleProjection (i j : I) (k : K i j) : s.tripleSpace a T b i j k ⟶ Xijk i j k :=
  fiberFst (s.tripleToSource a b i j k) (s.projection T)

/-- The projection `X_{ijk, T} ⟶ X_T`. -/
def tripleInclusion (i j : I) (k : K i j) : s.tripleSpace a T b i j k ⟶ s.baseChange T :=
  fiberSnd (s.tripleToSource a b i j k) (s.projection T)

/-- The structure morphism `X_{ijk, T} ⟶ X`, along which `F` and `G` are pulled back to give the
base changes to `T` of the restrictions `F_{ijk}` and `G_{ijk}`. -/
def tripleToX (i j : I) (k : K i j) : s.tripleSpace a T b i j k ⟶ s.X :=
  s.tripleProjection a T b i j k ≫ s.tripleToSource a b i j k

/-- A morphism into the base change of a member of a covering of an overlap is determined by its
two projections. -/
theorem triple_hom_ext {V : AlgebraicSpaces B S hS} {i j : I} {k : K i j}
    {m l : V ⟶ s.tripleSpace a T b i j k}
    (h₁ : m ≫ s.tripleProjection a T b i j k = l ≫ s.tripleProjection a T b i j k)
    (h₂ : m ≫ s.tripleInclusion a T b i j k = l ≫ s.tripleInclusion a T b i j k) : m = l :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS
    (s.tripleToSource a b i j k) (s.projection T)).hom_ext h₁ h₂

/-- The projection to `X_T` followed by `X_T ⟶ X` is the structure morphism to `X`. -/
theorem tripleInclusion_comp (i j : I) (k : K i j) :
    s.tripleInclusion a T b i j k ≫ s.projection T = s.tripleToX a T b i j k :=
  ((AlgebraicSpaces.isPullback_fiberProduct B S hS
    (s.tripleToSource a b i j k) (s.projection T)).w).symm

/-- The morphism `X_{ijk, T} ⟶ X_{i, T}` induced by `X_{ijk} ⟶ X_i ×_X X_j ⟶ X_i`.  Restriction
along it is the first of the two parallel arrows of Stacks 08K3. -/
def tripleToMemberFst (i j : I) (k : K i j) :
    s.tripleSpace a T b i j k ⟶ s.memberSpace a T i :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (s.projection T)).lift
    (s.tripleProjection a T b i j k ≫ b i j k ≫ overlapFst a i j)
    (s.tripleInclusion a T b i j k)
    (by
      rw [Category.assoc, Category.assoc, ← tripleToSource,
        s.tripleInclusion_comp a T b i j k, tripleToX])

/-- The morphism `X_{ijk, T} ⟶ X_{j, T}` induced by `X_{ijk} ⟶ X_i ×_X X_j ⟶ X_j`.  Restriction
along it is the second of the two parallel arrows of Stacks 08K3. -/
def tripleToMemberSnd (i j : I) (k : K i j) :
    s.tripleSpace a T b i j k ⟶ s.memberSpace a T j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a j) (s.projection T)).lift
    (s.tripleProjection a T b i j k ≫ b i j k ≫ overlapSnd a i j)
    (s.tripleInclusion a T b i j k)
    (by
      rw [Category.assoc, Category.assoc, s.tripleToSource_eq a b i j k,
        s.tripleInclusion_comp a T b i j k, tripleToX])

/-- The first parallel arrow, on the projections to the member. -/
@[reassoc]
theorem tripleToMemberFst_comp_projection (i j : I) (k : K i j) :
    s.tripleToMemberFst a T b i j k ≫ s.memberProjection a T i =
      s.tripleProjection a T b i j k ≫ b i j k ≫ overlapFst a i j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (s.projection T)).lift_fst _ _ _

/-- The second parallel arrow, on the projections to the member. -/
@[reassoc]
theorem tripleToMemberSnd_comp_projection (i j : I) (k : K i j) :
    s.tripleToMemberSnd a T b i j k ≫ s.memberProjection a T j =
      s.tripleProjection a T b i j k ≫ b i j k ≫ overlapSnd a i j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a j) (s.projection T)).lift_fst _ _ _

/-- The first parallel arrow is a morphism over `X_T`. -/
@[reassoc]
theorem tripleToMemberFst_comp_inclusion (i j : I) (k : K i j) :
    s.tripleToMemberFst a T b i j k ≫ s.memberInclusion a T i =
      s.tripleInclusion a T b i j k :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (s.projection T)).lift_snd _ _ _

/-- The second parallel arrow is a morphism over `X_T`. -/
@[reassoc]
theorem tripleToMemberSnd_comp_inclusion (i j : I) (k : K i j) :
    s.tripleToMemberSnd a T b i j k ≫ s.memberInclusion a T j =
      s.tripleInclusion a T b i j k :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a j) (s.projection T)).lift_snd _ _ _

/-- The first parallel arrow is a morphism over `X`. -/
theorem tripleToMemberFst_comp (i j : I) (k : K i j) :
    s.tripleToMemberFst a T b i j k ≫ s.memberToSource a T i = s.tripleToX a T b i j k := by
  rw [memberToSource, ← Category.assoc, s.tripleToMemberFst_comp_projection a T b i j k,
    tripleToX, tripleToSource, Category.assoc, Category.assoc]

/-- The second parallel arrow is a morphism over `X`. -/
theorem tripleToMemberSnd_comp (i j : I) (k : K i j) :
    s.tripleToMemberSnd a T b i j k ≫ s.memberToSource a T j = s.tripleToX a T b i j k := by
  rw [memberToSource, ← Category.assoc, s.tripleToMemberSnd_comp_projection a T b i j k,
    Category.assoc, Category.assoc, s.tripleToSource_eq a b i j k, tripleToX]

/-- **The overlap condition of Stacks 08K3 on a family of local homomorphisms.**  A family of
homomorphisms `α i : F_i ⟶ G_i` over the base changes `X_{i, T}` is *compatible* when for all
`i`, `j` and every member `X_{ijk}` of the chosen covering of `X_i ×_X X_j` the restrictions of
`α i` and `α j` to `X_{ijk, T}` agree.

This says that the two parallel arrows of the diagram of Stacks 08K3 take the family to the
same element of `∏_{ijk} Hom(F_{ijk}, G_{ijk})(T)`. -/
def TripleRestrictionsAgree
    (α : ∀ i, (modulePullback B S hS (s.memberToSource a T i)).obj s.F ⟶
      (modulePullback B S hS (s.memberToSource a T i)).obj s.G) : Prop :=
  ∀ i j (k : K i j),
    restrictPullbackHom (s.tripleToMemberFst a T b i j k)
        (s.tripleToMemberFst_comp a T b i j k) (α i) =
      restrictPullbackHom (s.tripleToMemberSnd a T b i j k)
        (s.tripleToMemberSnd_comp a T b i j k) (α j)

/-- The comparison `X_{i, T} ×_{X_T} X_{j, T} ⟶ X_i ×_X X_j` of overlaps, induced by the two
projections to the members. -/
def overlapComparison (i j : I) :
    overlapSpace (s.memberInclusion a T) i j ⟶ overlapSpace a i j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (a j)).lift
    (overlapFst (s.memberInclusion a T) i j ≫ s.memberProjection a T i)
    (overlapSnd (s.memberInclusion a T) i j ≫ s.memberProjection a T j)
    (by
      rw [Category.assoc, Category.assoc, ← memberToSource, ← memberToSource,
        ← s.memberInclusion_comp a T i, ← s.memberInclusion_comp a T j, ← Category.assoc,
        ← Category.assoc, overlapFst_comp_eq (s.memberInclusion a T) i j])

/-- The comparison of overlaps commutes with the first projections. -/
@[reassoc]
theorem overlapComparison_comp_fst (i j : I) :
    s.overlapComparison a T i j ≫ overlapFst a i j =
      overlapFst (s.memberInclusion a T) i j ≫ s.memberProjection a T i :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (a j)).lift_fst _ _ _

/-- The comparison of overlaps commutes with the second projections. -/
@[reassoc]
theorem overlapComparison_comp_snd (i j : I) :
    s.overlapComparison a T i j ≫ overlapSnd a i j =
      overlapSnd (s.memberInclusion a T) i j ≫ s.memberProjection a T j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (a i) (a j)).lift_snd _ _ _

/-- The refinement `X_{ijk} ×_{X_i ×_X X_j} (X_{i, T} ×_{X_T} X_{j, T})` of an overlap of the
base-changed covering by a member of the chosen covering of the overlap of the covering of the
source. -/
abbrev refinementSpace (i j : I) (k : K i j) : AlgebraicSpaces B S hS :=
  AlgebraicSpaces.fiberProduct B S hS (b i j k) (s.overlapComparison a T i j)

/-- The projection of the refinement to the member of the covering of the overlap. -/
def refinementProjection (i j : I) (k : K i j) :
    s.refinementSpace a T b i j k ⟶ Xijk i j k :=
  fiberFst (b i j k) (s.overlapComparison a T i j)

/-- The projection of the refinement to the overlap of the base-changed covering. -/
def refinementInclusion (i j : I) (k : K i j) :
    s.refinementSpace a T b i j k ⟶ overlapSpace (s.memberInclusion a T) i j :=
  fiberSnd (b i j k) (s.overlapComparison a T i j)

/-- The two projections of the refinement agree over the overlap of the covering of the
source. -/
@[reassoc]
theorem refinementProjection_comp (i j : I) (k : K i j) :
    s.refinementProjection a T b i j k ≫ b i j k =
      s.refinementInclusion a T b i j k ≫ s.overlapComparison a T i j :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS (b i j k)
    (s.overlapComparison a T i j)).w

/-- **The refinements cover the overlaps of the base-changed covering**, being the chosen
coverings of the overlaps of the covering of the source pulled back along the comparison of
overlaps.  This is Stacks 03MR, part (3), again. -/
theorem isFpqcCovering_refinementInclusion
    (hb : ∀ i j, IsFpqcCovering B S hS fun k ↦ (b i j k).hom) (i j : I) :
    IsFpqcCovering B S hS fun k ↦ (s.refinementInclusion a T b i j k).hom :=
  isFpqcCovering_pullback B S hS (b i j) (s.overlapComparison a T i j) (hb i j)

/-- The morphism of the refinement into the base change `X_{ijk, T}`, through which the overlap
condition of Stacks 08K3 is read on the overlaps of the base-changed covering. -/
def refinementToTriple (i j : I) (k : K i j) :
    s.refinementSpace a T b i j k ⟶ s.tripleSpace a T b i j k :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS
      (s.tripleToSource a b i j k) (s.projection T)).lift
    (s.refinementProjection a T b i j k)
    (s.refinementInclusion a T b i j k ≫ overlapFst (s.memberInclusion a T) i j ≫
      s.memberInclusion a T i)
    (by
      simp only [Category.assoc, s.memberInclusion_comp a T i, memberToSource, tripleToSource,
        s.refinementProjection_comp_assoc a T b i j k,
        s.overlapComparison_comp_fst_assoc a T i j])

/-- The morphism into the base change `X_{ijk, T}`, on the projection to `X_{ijk}`. -/
@[reassoc]
theorem refinementToTriple_comp_projection (i j : I) (k : K i j) :
    s.refinementToTriple a T b i j k ≫ s.tripleProjection a T b i j k =
      s.refinementProjection a T b i j k :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS
    (s.tripleToSource a b i j k) (s.projection T)).lift_fst _ _ _

/-- The morphism into the base change `X_{ijk, T}`, on the projection to `X_T`. -/
@[reassoc]
theorem refinementToTriple_comp_inclusion (i j : I) (k : K i j) :
    s.refinementToTriple a T b i j k ≫ s.tripleInclusion a T b i j k =
      s.refinementInclusion a T b i j k ≫ overlapFst (s.memberInclusion a T) i j ≫
        s.memberInclusion a T i :=
  (AlgebraicSpaces.isPullback_fiberProduct B S hS
    (s.tripleToSource a b i j k) (s.projection T)).lift_snd _ _ _

/-- **The refinement maps to the first member of the overlap in one way only.**  Going through
the base change `X_{ijk, T}` and the first parallel arrow is going through the overlap of the
base-changed covering and its first projection. -/
theorem refinementToTriple_comp_fst (i j : I) (k : K i j) :
    s.refinementToTriple a T b i j k ≫ s.tripleToMemberFst a T b i j k =
      s.refinementInclusion a T b i j k ≫ overlapFst (s.memberInclusion a T) i j := by
  refine s.member_hom_ext a T ?_ ?_
  · simp only [Category.assoc, s.tripleToMemberFst_comp_projection a T b i j k,
      s.refinementToTriple_comp_projection_assoc a T b i j k,
      s.refinementProjection_comp_assoc a T b i j k, s.overlapComparison_comp_fst a T i j]
  · simp only [Category.assoc, s.tripleToMemberFst_comp_inclusion a T b i j k,
      s.refinementToTriple_comp_inclusion a T b i j k]

/-- **The refinement maps to the second member of the overlap in one way only.**  Going through
the base change `X_{ijk, T}` and the second parallel arrow is going through the overlap of the
base-changed covering and its second projection. -/
theorem refinementToTriple_comp_snd (i j : I) (k : K i j) :
    s.refinementToTriple a T b i j k ≫ s.tripleToMemberSnd a T b i j k =
      s.refinementInclusion a T b i j k ≫ overlapSnd (s.memberInclusion a T) i j := by
  refine s.member_hom_ext a T ?_ ?_
  · simp only [Category.assoc, s.tripleToMemberSnd_comp_projection a T b i j k,
      s.refinementToTriple_comp_projection_assoc a T b i j k,
      s.refinementProjection_comp_assoc a T b i j k, s.overlapComparison_comp_snd a T i j]
  · simp only [Category.assoc, s.tripleToMemberSnd_comp_inclusion a T b i j k,
      s.refinementToTriple_comp_inclusion a T b i j k,
      overlapFst_comp_eq (s.memberInclusion a T) i j]

/-- **The overlap condition of Stacks 08K3 implies the overlap condition on the overlaps
themselves.**  The refinements cover each overlap `X_{i, T} ×_{X_T} X_{j, T}` of the
base-changed covering, and a homomorphism of inverse images is determined by its restrictions
along an fpqc covering, so agreement on the members `X_{ijk, T}` is agreement on the overlap. -/
theorem restrictionsAgree_of_tripleRestrictionsAgree
    (hrepr : QuasiCoherentDescent.ReprFpqcHomInjective.{u, v} B S hS)
    (hb : ∀ i j, IsFpqcCovering B S hS fun k ↦ (b i j k).hom)
    (α : ∀ i, (modulePullback B S hS (s.memberToSource a T i)).obj s.F ⟶
      (modulePullback B S hS (s.memberToSource a T i)).obj s.G)
    (hα : s.TripleRestrictionsAgree a T b α) :
    RestrictionsAgree (s.projection T) (s.memberInclusion a T) (s.memberToSource a T)
      (s.memberInclusion_comp a T) α := by
  refine restrictionsAgree_of_refinement hrepr (s.projection T) (s.memberInclusion a T)
    (s.memberToSource a T) (s.memberInclusion_comp a T) (s.refinementInclusion a T b)
    (s.isFpqcCovering_refinementInclusion a T b hb) α fun i j k ↦ ?_
  have hR : s.refinementToTriple a T b i j k ≫ s.tripleToX a T b i j k =
      (s.refinementInclusion a T b i j k ≫ overlapFst (s.memberInclusion a T) i j) ≫
        s.memberToSource a T i := by
    rw [← s.tripleToMemberFst_comp a T b i j k, ← Category.assoc,
      s.refinementToTriple_comp_fst a T b i j k]
  exact restrictPullbackHom_eq_of_comp_eq _ (s.tripleToMemberFst_comp a T b i j k) _
    (s.tripleToMemberSnd_comp a T b i j k) _ hR (s.refinementToTriple_comp_fst a T b i j k)
    (s.refinementToTriple_comp_snd a T b i j k) _ _ _ _ (hα i j k)

/-- **Stacks 08K3, the first half of the exactness.**  The restrictions of a global
homomorphism `F_T ⟶ G_T` to the base changes `X_{i, T}` of the members of a covering of the
source satisfy the overlap condition: the two parallel arrows of the diagram agree on the image
of the first arrow.

Both restrictions are the restriction of the global homomorphism along the projection
`X_{ijk, T} ⟶ X_T`, because both parallel arrows are morphisms over `X_T`. -/
@[stacks 08K3 "the two parallel arrows agree on the image of the first arrow"]
theorem tripleRestrictionsAgree_restrict (β : s.homAt T) :
    s.TripleRestrictionsAgree a T b
      (fun i ↦ restrictPullbackHom (s.memberInclusion a T i) (s.memberInclusion_comp a T i)
        (s.toModuleHom β)) := by
  intro i j k
  have hfst : (s.tripleToMemberFst a T b i j k ≫ s.memberInclusion a T i) ≫ s.projection T =
      s.tripleToX a T b i j k := by
    rw [s.tripleToMemberFst_comp_inclusion a T b i j k, s.tripleInclusion_comp a T b i j k]
  have hsnd : (s.tripleToMemberSnd a T b i j k ≫ s.memberInclusion a T j) ≫ s.projection T =
      s.tripleToX a T b i j k := by
    rw [s.tripleToMemberSnd_comp_inclusion a T b i j k, s.tripleInclusion_comp a T b i j k]
  rw [← restrictPullbackHom_comp (s.memberInclusion a T i) (s.memberInclusion_comp a T i)
      (s.tripleToMemberFst a T b i j k) (s.tripleToMemberFst_comp a T b i j k) hfst,
    ← restrictPullbackHom_comp (s.memberInclusion a T j) (s.memberInclusion_comp a T j)
      (s.tripleToMemberSnd a T b i j k) (s.tripleToMemberSnd_comp a T b i j k) hsnd,
    restrictPullbackHom_congr (s.tripleToMemberFst_comp_inclusion a T b i j k) hfst
      (s.tripleInclusion_comp a T b i j k),
    restrictPullbackHom_congr (s.tripleToMemberSnd_comp_inclusion a T b i j k) hsnd
      (s.tripleInclusion_comp a T b i j k)]

/-- **Stacks 08K3, the second half of the exactness.**  In the standing data of Stacks 08JT let
`{X_i ⟶ X}` be an fppf covering and for all `i`, `j` let `{X_{ijk} ⟶ X_i ×_X X_j}` be an fppf
covering.  For every test scheme `T` over the base, a family of homomorphisms
`F_i ⟶ G_i` over the base changes `X_{i, T}` whose restrictions agree on the `X_{ijk, T}` comes
from a unique homomorphism `F_T ⟶ G_T`.

Together with `AlgebraicGeometry.Space.HomSituation.tripleRestrictionsAgree_restrict` this is
the exactness of the diagram displayed by the source: the first arrow lands in the equalizer of
the other two, is injective, and hits every element of that equalizer.

This is the proof of the source.  The base change of an fppf covering is an fppf covering, so
`{X_{i, T} ⟶ X_T}` and `{X_{ijk, T} ⟶ X_{i, T} ×_{X_T} X_{j, T}}` are fppf, hence fpqc,
coverings — Stacks 03Y9 and Stacks 03MR, part (3).  Applying Stacks 04W8 to the second reduces
the overlap condition to the overlaps themselves, and applying it to the first, in the form
