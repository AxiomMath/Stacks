module

public import StacksFrontier.AlgebraicGeometry.Quot.PolarizedStackDescentEffective
public import StacksFrontier.AlgebraicGeometry.Quot.PolarizedStack

/-!
# Polarized families form a stack once descended algebraic spaces are schemes (Stacks 0D40)

Let `D` be a descent datum of polarized families relative to the sieve generated by a covering
family `{f i : V i ⟶ U}` of the big fppf site. Forgetting the polarizations, `D` becomes a
descent datum of finitely presented, flat and proper families of algebraic spaces, which is
effective (Stacks 0D1G): it descends to a family `y` of algebraic spaces over `U`. This file
shows that `D` is effective as soon as the algebraic space of `y` is a scheme: the scheme then
carries the descended family of total spaces (`AlgebraicGeometry.PolarizedDescentScheme`), and
the polarization descends along it
(`AlgebraicGeometry.PolarizedDescentScheme.isEffective`).

So the stack condition for polarized families over the big fppf site, and with it both
assertions of Stacks 0D40, reduces to the statement that the algebraic space descended from a
descent datum of polarized families is a scheme. In the source that is the ampleness of the
descended polarization, Stacks 0D3C, read through Stacks 0D32.

## Main results

* `AlgebraicGeometry.SieveDescentDatum.isEffective_of_isRepresentable_descended`: a descent datum
  of polarized families relative to a covering family is effective when the algebraic space
  descended from it is a scheme.
* `AlgebraicGeometry.polarizedProjection_isStack_of_isRepresentable_descended`: polarized
  families form a stack over the big fppf site when every such descended algebraic space is a
  scheme.
* `AlgebraicGeometry.polarizedSpacesForget_isStackInGroupoids_of_isRepresentable_descended`: the
  first assertion of Stacks 0D40 under the same condition.

## References

* [Stacks Project, Tag 0D40](https://stacks.math.columbia.edu/tag/0D40)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Functor (Fiber IsPreFibered)

universe w u

namespace AlgebraicGeometry

variable {B : BigFppfSite.{u}}

/-- The condition that the algebraic space descended from a descent datum of polarized families
relative to a covering family is a scheme: for every finitely presented, flat and proper family
`y` of algebraic spaces over `U` with morphisms `ζ i` over `f i` from the families underlying the
members of `D`, compatible with the images of the gluing isomorphisms of `D`, the algebraic space
of `y` is represented by a scheme of the site. -/
def PolarizedDescendedIsRepresentable {U : B.Schemes} (E : PreZeroHypercover.{u + 1} U)
    (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows E.X E.f)) : Prop :=
  ∀ (y : (polarizedFamiliesProperFlatProjection B).Fiber U)
    (ζ : ∀ i, (forgetPolarization B).obj (D.obj (E.f i) (Sieve.ofArrows_mk E.X E.f i)).1 ⟶ y.1),
    (∀ i, (polarizedFamiliesProperFlatProjection B).IsHomLift (E.f i) (ζ i)) →
    (∀ (i j : E.I₀) ⦃W : B.Schemes⦄ (b : W ⟶ E.X i) (b' : W ⟶ E.X j)
        (h : b ≫ E.f i = b' ≫ E.f j), (forgetPolarization B).map
          (Fiber.fiberInclusion.map
            (D.iso (Sieve.ofArrows_mk E.X E.f i) (Sieve.ofArrows_mk E.X E.f j) b b' h).hom ≫
          IsPreFibered.pullbackMap (D.obj (E.f j) (Sieve.ofArrows_mk E.X E.f j)).2 b') ≫ ζ j =
        (forgetPolarization B).map
          (IsPreFibered.pullbackMap (D.obj (E.f i) (Sieve.ofArrows_mk E.X E.f i)).2 b) ≫ ζ i) →
    ∃ Z : BigFppfOver B integerBase B.contains_integerBase,
      Nonempty (yoneda.obj Z ≅ y.1.obj.obj.left.1)

/-- **A descent datum of polarized families relative to a covering family is effective once the
algebraic space descended from it (Stacks 0D1G) is a scheme.** -/
theorem SieveDescentDatum.isEffective_of_isRepresentable_descended {U : B.Schemes}
    (E : PreZeroHypercover.{u + 1} U) (hE : B.IsCovering ⟨U, E⟩)
    (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows E.X E.f))
    (hrep : PolarizedDescendedIsRepresentable E D) : D.IsEffective := by
  have := (polarizedFamiliesProperFlatProjection_isStack B).isFibered
  obtain ⟨y, ζ, hcart, hglue⟩ := isEffective_mapF_forgetPolarization B
    (Precoverage.generate_mem_toGrothendieck ⟨E, rfl, hE⟩) D
  have hζ : ∀ i, (polarizedFamiliesProperFlatProjection B).IsHomLift (E.f i)
      (ζ (E.f i) (Sieve.ofArrows_mk E.X E.f i)) := fun i =>
    (hcart (E.f i) (Sieve.ofArrows_mk E.X E.f i)).toIsHomLift
  have hglue' : ∀ (i j : E.I₀) ⦃W : B.Schemes⦄ (b : W ⟶ E.X i) (b' : W ⟶ E.X j)
      (h : b ≫ E.f i = b' ≫ E.f j), (forgetPolarization B).map
        (Fiber.fiberInclusion.map
          (D.iso (Sieve.ofArrows_mk E.X E.f i) (Sieve.ofArrows_mk E.X E.f j) b b' h).hom ≫
        IsPreFibered.pullbackMap (D.obj (E.f j) (Sieve.ofArrows_mk E.X E.f j)).2 b') ≫
          ζ (E.f j) (Sieve.ofArrows_mk E.X E.f j) =
      (forgetPolarization B).map
        (IsPreFibered.pullbackMap (D.obj (E.f i) (Sieve.ofArrows_mk E.X E.f i)).2 b) ≫
          ζ (E.f i) (Sieve.ofArrows_mk E.X E.f i) := fun i j _ b b' h =>
    Functor.SieveDescentDatum.map_comp_eq_of_mapF (forgetPolarization_isFibredOneMorphism B) D
      _ _ b b' h _ _ (hglue _ _ b b' h)
  obtain ⟨Z, ⟨e⟩⟩ := hrep y (fun i => ζ (E.f i) (Sieve.ofArrows_mk E.X E.f i)) hζ hglue'
  exact (PolarizedDescentScheme.ofRepresented y _ hζ hglue' e).isEffective
    (BigFppfSite.ofArrows_inclusion_mem_fpqcPrecoverage hE)

variable (B)

/-- **Polarized families form a stack over the big fppf site once descended algebraic spaces are
schemes.** If, for every covering family of the site and every descent datum of polarized
families relative to it, the algebraic space descended from the datum is a scheme, then
`AlgebraicGeometry.polarizedProjection` is a stack over the big fppf site: this is the second
assertion of Stacks 0D40 under that condition. -/
theorem polarizedProjection_isStack_of_isRepresentable_descended
    (hrep : ∀ ⦃U : B.Schemes⦄ (E : PreZeroHypercover.{u + 1} U), B.IsCovering ⟨U, E⟩ →
      ∀ D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows E.X E.f),
        PolarizedDescendedIsRepresentable E D) :
    (polarizedProjection B).IsStack B.topology :=
  polarizedProjection_isStack_of_isEffective B fun _ E hE D =>
    SieveDescentDatum.isEffective_of_isRepresentable_descended E hE D (hrep E hE D)

/-- **The first assertion of Stacks 0D40 once descended algebraic spaces are schemes**: the
replacement category of polarized families is a stack in groupoids over
`Spaces'_{fp, flat, proper}` with the topology inherited from the big fppf site. -/
theorem polarizedSpacesForget_isStackInGroupoids_of_isRepresentable_descended
    (hrep : ∀ ⦃U : B.Schemes⦄ (E : PreZeroHypercover.{u + 1} U), B.IsCovering ⟨U, E⟩ →
      ∀ D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows E.X E.f),
        PolarizedDescendedIsRepresentable E D) :
    (polarizedSpacesForget B).IsStackInGroupoids.{w}
      ((polarizedFamiliesProperFlatProjection B).inheritedTopology B.topology) :=
  polarizedSpacesForget_isStackInGroupoids_of_isStack B
    (polarizedProjection_isStack_of_isRepresentable_descended B hrep)

end AlgebraicGeometry

end
