module

public import StacksFrontier.AlgebraicGeometry.Quot.PolarizedStackDescentScheme
public import StacksFrontier.AlgebraicGeometry.PicardScheme.PicardSequenceSplitExact

/-!
# Effective descent for polarized families: descending the polarization (Stacks 0D40)

Let `D` be a descent datum of polarized families relative to the sieve generated by a covering
family `{f i : V i ⟶ U}` of the big fppf site, with members `x i`, and suppose the family of
total spaces has descended to a scheme `Z` over `U` (`AlgebraicGeometry.PolarizedDescentScheme`),
with morphisms `t i` from the total space of `x i` to `Z`. This file builds the descent datum
for quasi-coherent modules relative to the family `{t i}` whose components are the
polarizations of the `x i`, from the gluing isomorphisms of `D`.

## Main definitions

* `AlgebraicGeometry.PolarizedFamily.lineBundleTransfer`: for two morphisms `m : w ⟶ x`,
  `n : w ⟶ y` of polarized families out of a common source, the identification of the pullbacks
  of the two polarizations through the polarization of `w`.
* `AlgebraicGeometry.commaChosenPullback`: componentwise chosen fibre products in
  `Comma (𝟭 C) R`.
* `AlgebraicGeometry.PolarizedDescentScheme.transition`: over a family of schemes over the site
  mapping to two members, the transfer of polarizations through the gluing isomorphism of `D`.
* `AlgebraicGeometry.PolarizedDescentScheme.lineBundleDescentData`: the quasi-coherent descent
  datum of the polarizations relative to the morphisms `t i`.

## Main results

* `AlgebraicGeometry.PolarizedFamily.pullHom_lineBundleTransfer`: the transfer is natural along
  morphisms of polarized families.
* `AlgebraicGeometry.PolarizedDescentScheme.transition_self`, `transition_comp`,
  `transition_pull`: the identity, cocycle and base-change laws of the transitions, from those of
  `D`.
* `AlgebraicGeometry.PolarizedDescentScheme.lineBundleDescentData_hom_glue`: the descent datum,
  read at the gluing maps of `D`, is the transfer of polarizations.
* `AlgebraicGeometry.PolarizedDescentScheme.exists_iso_lineBundleDescentData`: the descent datum
  is effective (Stacks 023T).

## Implementation notes

The datum is produced by `Stacks.Picard.diagramDescentData` over the category
`Comma (𝟭 Scheme) B.inclusion` of schemes over schemes of the site, so that a transition is
needed only over a test family with a base in the site: there the gluing isomorphisms of `D` are
available, and the three laws are the identity, cocycle and base-change axioms of `D`.

## References

* [Stacks Project, Tag 0D40](https://stacks.math.columbia.edu/tag/0D40)
* [Stacks Project, Tag 023T](https://stacks.math.columbia.edu/tag/023T)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Functor (Fiber IsPreFibered pullbackFiber)
open CategoryTheory.Pseudofunctor.LocallyDiscreteOpToCat (pullHom)

universe w u

namespace CategoryTheory.Functor.SieveDescentDatum

attribute [local implicit_reducible] Fiber Fiber.fiberInclusion

variable {𝒞 : Type*} [Category 𝒞] {𝒳 : Type*} [Category 𝒳] {p : 𝒳 ⥤ 𝒞} [p.IsFibered]

/-- **The gluing morphism of a descent datum, pulled back.** The chosen pullback along `γ` of
the gluing morphism at `(ε, ε')` (the gluing isomorphism followed by the chosen cartesian lift of
`ε'`), read from the chosen pullback along `γ ≫ ε`, is the gluing morphism at
`(γ ≫ ε, γ ≫ ε')`. This is `CategoryTheory.Functor.SieveDescentDatum.iso_pullback` composed
with the chosen cartesian lifts. -/
lemma pullbackFiberCompIso_inv_glue {U : 𝒞} {R : Sieve U} (D : SieveDescentDatum p R)
    ⦃V W Z Z' : 𝒞⦄ ⦃f : V ⟶ U⦄ (hf : R f) ⦃g : W ⟶ U⦄ (hg : R g) (ε : Z ⟶ V) (ε' : Z ⟶ W)
    (heq : ε ≫ f = ε' ≫ g) (γ : Z' ⟶ Z) :
    Fiber.fiberInclusion.map (pullbackFiberCompIso (D.obj f hf) ε γ).inv ≫
        IsPreFibered.pullbackMap (pullbackFiber p (D.obj f hf) ε).2 γ ≫
        Fiber.fiberInclusion.map (D.iso hf hg ε ε' heq).hom ≫
        IsPreFibered.pullbackMap (D.obj g hg).2 ε' =
      Fiber.fiberInclusion.map (D.iso hf hg (γ ≫ ε) (γ ≫ ε')
          (by rw [Category.assoc, Category.assoc, heq])).hom ≫
        IsPreFibered.pullbackMap (D.obj g hg).2 (γ ≫ ε') := by
  rw [← D.iso_pullback hf hg ε ε' heq γ]
  simp only [Functor.map_comp, Category.assoc, pullbackFiberIso_hom]
  rw [pullbackFiberCompIso_hom_fac, pullbackFiberHom_fac_assoc]

end CategoryTheory.Functor.SieveDescentDatum

namespace AlgebraicGeometry

/-- `pullHom` for the pseudofunctor of sheaves of modules, along `g`, at the composites with
`g`, is the conjugate of the pullback along `g` by the composition comparisons. -/
theorem pullHom_modulePullback_comp {Y Z₁ Z₂ Y' : Scheme.{u}} {f₁ : Y ⟶ Z₁} {f₂ : Y ⟶ Z₂}
    {M : Z₁.Modules} {N : Z₂.Modules}
    (φ : (Scheme.Modules.pullback f₁).obj M ⟶ (Scheme.Modules.pullback f₂).obj N)
    (g : Y' ⟶ Y) :
    pullHom (F := modulePullbackPseudofunctor) φ g (g ≫ f₁) (g ≫ f₂) rfl rfl =
      (Scheme.Modules.pullbackComp g f₁).inv.app M ≫ (Scheme.Modules.pullback g).map φ ≫
        (Scheme.Modules.pullbackComp g f₂).hom.app N :=
  rfl

variable {B : BigFppfSite.{u}}

namespace PolarizedFamily

/-- **Transfer of polarizations through a common source.** For morphisms `m : w ⟶ x` and
`n : w ⟶ y` of polarized families, the pullbacks of the polarizations of `x` and `y` to the
total space of `w` are both identified with the polarization of `w`. -/
def lineBundleTransfer {w x y : PolarizedFamily B} (m : w ⟶ x) (n : w ⟶ y) :
    (Scheme.Modules.pullback m.totalMap).obj x.lineBundle ≅
      (Scheme.Modules.pullback n.totalMap).obj y.lineBundle :=
  m.lineBundleIso ≪≫ n.lineBundleIso.symm

/-- The transfer from a morphism to itself is the identity. -/
theorem lineBundleTransfer_self {w x : PolarizedFamily B} (m : w ⟶ x) :
    (lineBundleTransfer m m).hom = 𝟙 _ :=
  m.lineBundleIso.hom_inv_id

/-- Transfers compose. -/
theorem lineBundleTransfer_comp {w x y z : PolarizedFamily B} (m : w ⟶ x) (n : w ⟶ y)
    (k : w ⟶ z) :
    (lineBundleTransfer m n).hom ≫ (lineBundleTransfer n k).hom =
      (lineBundleTransfer m k).hom := by
  simp only [lineBundleTransfer, Iso.trans_hom, Iso.symm_hom, Category.assoc,
    Iso.inv_hom_id_assoc]

/-- **The transfer is natural along morphisms of polarized families.** Its restriction along the
morphism of total spaces of `k : w' ⟶ w` is the transfer between `k ≫ m` and `k ≫ n`. -/
theorem pullHom_lineBundleTransfer {w w' x y : PolarizedFamily B} (m : w ⟶ x) (n : w ⟶ y)
    (k : w' ⟶ w) :
    pullHom (F := modulePullbackPseudofunctor) (lineBundleTransfer m n).hom k.totalMap
        (k.totalMap ≫ m.totalMap) (k.totalMap ≫ n.totalMap) rfl rfl =
      (lineBundleTransfer (k ≫ m) (k ≫ n)).hom := by
  have aux : ∀ {C : Type (u + 1)} [Category.{u} C] {X₀ X₁ X₂ X₃ X₄ X₅ : C} (a : X₀ ⟶ X₁)
      (b : X₁ ⟶ X₂) (e : X₂ ≅ X₃) (c : X₂ ⟶ X₄) (d : X₄ ⟶ X₅),
      a ≫ (b ≫ c) ≫ d = (a ≫ b ≫ e.hom) ≫ e.inv ≫ c ≫ d := by
    intros; simp
  have h1 := pullHom_modulePullback_comp (lineBundleTransfer m n).hom k.totalMap
  have h2 : (Scheme.Modules.pullback k.totalMap).map (lineBundleTransfer m n).hom =
      (Scheme.Modules.pullback k.totalMap).map m.lineBundleIso.hom ≫
        (Scheme.Modules.pullback k.totalMap).map n.lineBundleIso.inv :=
    Functor.map_comp _ _ _
  rw [h2] at h1
  exact h1.trans (aux _ _ k.lineBundleIso _ _)

/-- **A morphism of polarized families over a morphism of the site is a cartesian square over
it.** For `φ : a ⟶ b` lying over `g : V ⟶ W`, with the bases of `a` and `b` identified with `V`
and `W`, the square formed by the morphism of total spaces, the two structure morphisms and `g`
is cartesian. -/
theorem Hom.isPullback_of_isHomLift {V W : B.Schemes} {a b : PolarizedFamily B} (ha : a.base = V)
    (hb : b.base = W) (g : V ⟶ W) (φ : a ⟶ b) [hφ : (polarizedProjection B).IsHomLift g φ] :
    IsPullback φ.totalMap (a.toBase ≫ B.inclusion.map (eqToHom ha))
      (b.toBase ≫ B.inclusion.map (eqToHom hb)) (B.inclusion.map g) := by
  have hfac := IsHomLift.fac' (polarizedProjection B) g φ
  have hbase : (polarizedProjection B).map φ ≫
      eqToHom (show (polarizedProjection B).obj b = W from hb) =
      eqToHom (show (polarizedProjection B).obj a = V from ha) ≫ g := by
    rw [hfac, Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id]
  refine IsPullback.of_iso φ.cartesian (Iso.refl _) (Iso.refl _)
    (B.inclusion.mapIso (eqToIso ha)) (B.inclusion.mapIso (eqToIso hb)) ?_ ?_ ?_ ?_
  · exact (Category.comp_id _).trans (Category.id_comp _).symm
  · exact (Category.id_comp _).symm
  · exact (Category.id_comp _).symm
  · exact (B.inclusion.map_comp _ _).symm.trans
      ((congrArg B.inclusion.map hbase).trans (B.inclusion.map_comp _ _))

/-- The cartesian square of the chosen pullback of a polarized family along a morphism of the
site. -/
theorem isPullback_pullbackMap {T W : B.Schemes} (y : (polarizedProjection B).Fiber T)
    (α : W ⟶ T) :
    IsPullback (IsPreFibered.pullbackMap y.2 α).totalMap
      ((pullbackFiber (polarizedProjection B) y α).1.toBase ≫
        B.inclusion.map (eqToHom (pullbackFiber (polarizedProjection B) y α).2))
      (y.1.toBase ≫ B.inclusion.map (eqToHom y.2)) (B.inclusion.map α) :=
  Hom.isPullback_of_isHomLift _ _ α _

/-- A morphism of a fibre of polarized families commutes with the structure morphisms. -/
theorem fiberHom_totalMap_w {W : B.Schemes} {y y' : (polarizedProjection B).Fiber W}
    (φ : y ⟶ y') :
    (Fiber.fiberInclusion.map φ).totalMap ≫ (y'.1.toBase ≫ B.inclusion.map (eqToHom y'.2)) =
      y.1.toBase ≫ B.inclusion.map (eqToHom y.2) :=
  ((Hom.isPullback_of_isHomLift y.2 y'.2 (𝟙 W) _ (hφ := φ.2)).w).trans
    ((congrArg (fun k => _ ≫ k) (B.inclusion.map_id W)).trans (Category.comp_id _))

/-- `pullHom` of a transfer only depends on the two morphisms, not on how they are written. -/
theorem pullHom_lineBundleTransfer_congr {w x y : PolarizedFamily B} {m m' : w ⟶ x}
    {n n' : w ⟶ y} (hm : m = m') (hn : n = n') {Y : Scheme.{u}} (c : Y ⟶ w.total)
    (a : Y ⟶ x.total) (b : Y ⟶ y.total) (ha : c ≫ m.totalMap = a) (hb : c ≫ n.totalMap = b)
    (ha' : c ≫ m'.totalMap = a) (hb' : c ≫ n'.totalMap = b) :
    pullHom (F := modulePullbackPseudofunctor) (lineBundleTransfer m n).hom c a b ha hb =
      pullHom (F := modulePullbackPseudofunctor) (lineBundleTransfer m' n').hom c a b ha' hb' := by
  subst hm hn
  rfl

/-- The restriction of a transfer along a morphism of total spaces of a morphism `k` of
polarized families, read at a further morphism `c`. -/
theorem pullHom_lineBundleTransfer_comp {w w' x y : PolarizedFamily B} (m : w ⟶ x) (n : w ⟶ y)
    (k : w' ⟶ w) {Y : Scheme.{u}} (c : Y ⟶ w'.total) (a : Y ⟶ x.total) (b : Y ⟶ y.total)
    (ha : c ≫ (k ≫ m).totalMap = a) (hb : c ≫ (k ≫ n).totalMap = b) :
    pullHom (F := modulePullbackPseudofunctor) (lineBundleTransfer (k ≫ m) (k ≫ n)).hom c a b
        ha hb =
      pullHom (F := modulePullbackPseudofunctor) (lineBundleTransfer m n).hom (c ≫ k.totalMap)
        a b ((Category.assoc _ _ _).trans ha) ((Category.assoc _ _ _).trans hb) :=
  (congrArg (fun φ => pullHom (F := modulePullbackPseudofunctor) φ c a b ha hb)
    (pullHom_lineBundleTransfer m n k).symm).trans
    (Pseudofunctor.LocallyDiscreteOpToCat.pullHom_pullHom _ _ _ _ _ _ _ rfl rfl ha hb)

end PolarizedFamily

/-! ### Chosen fibre products of families of schemes over the site -/

section CommaPullback

variable {C : Type*} [Category C] {C' : Type*} [Category C'] {R : C' ⥤ C}
  [HasPullbacks C] [HasPullbacks C'] [PreservesLimitsOfShape WalkingCospan R]

/-- The structure morphism of the componentwise fibre product in `Comma (𝟭 C) R`. -/
def commaPullbackHom {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) :
    pullback a.left b.left ⟶ R.obj (pullback a.right b.right) :=
  ((IsPullback.of_hasPullback a.right b.right).map R).lift
    (pullback.fst a.left b.left ≫ X.hom) (pullback.snd a.left b.left ≫ Y.hom) (by
      rw [Category.assoc, Category.assoc, ← a.w, ← b.w]
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ T.hom) pullback.condition).trans (Category.assoc _ _ _)))

/-- The componentwise fibre product in `Comma (𝟭 C) R`, as an object. -/
def commaPullbackObj {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) : Comma (𝟭 C) R :=
  ⟨pullback a.left b.left, pullback a.right b.right, commaPullbackHom a b⟩

/-- The first projection of the componentwise fibre product. -/
def commaPullbackFst {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) :
    commaPullbackObj a b ⟶ X :=
  ⟨pullback.fst a.left b.left, pullback.fst a.right b.right,
    (((IsPullback.of_hasPullback a.right b.right).map R).lift_fst _ _ _).symm⟩

/-- The second projection of the componentwise fibre product. -/
def commaPullbackSnd {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) :
    commaPullbackObj a b ⟶ Y :=
  ⟨pullback.snd a.left b.left, pullback.snd a.right b.right,
    (((IsPullback.of_hasPullback a.right b.right).map R).lift_snd _ _ _).symm⟩

/-- The square of the componentwise fibre product commutes. -/
theorem commaPullback_condition {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) :
    commaPullbackFst a b ≫ a = commaPullbackSnd a b ≫ b :=
  Comma.hom_ext _ _ pullback.condition pullback.condition

/-- **The chosen fibre product in `Comma (𝟭 C) R`**, computed componentwise: the two
projections to `C` and `C'` jointly reflect the limit
(`CategoryTheory.Comma.fstSndJointlyReflectLimit`), `R` preserving fibre products. -/
def commaChosenPullback {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) : ChosenPullback a b :=
  ⟨commaPullbackObj a b, commaPullbackFst a b, commaPullbackSnd a b, commaPullback_condition a b,
    Comma.fstSndJointlyReflectLimit
      ((isLimitMapConePullbackConeEquiv (Comma.fst _ _) (commaPullback_condition a b)).symm
        (IsPullback.of_hasPullback a.left b.left).isLimit)
      ((isLimitMapConePullbackConeEquiv (Comma.snd _ _) (commaPullback_condition a b)).symm
        (IsPullback.of_hasPullback a.right b.right).isLimit),
    commaPullbackFst a b ≫ a, rfl⟩

/-- The chosen fibre product in `Comma (𝟭 C) R` is a fibre product of the first components. -/
theorem isPullback_fst_commaChosenPullback {X Y T : Comma (𝟭 C) R} (a : X ⟶ T) (b : Y ⟶ T) :
    IsPullback ((Comma.fst (𝟭 C) R).map (commaChosenPullback a b).p₁)
      ((Comma.fst (𝟭 C) R).map (commaChosenPullback a b).p₂)
      ((Comma.fst (𝟭 C) R).map a) ((Comma.fst (𝟭 C) R).map b) :=
  IsPullback.of_hasPullback a.left b.left

end CommaPullback

/-! ### The families of schemes of a descent datum with a descended scheme -/

/-- If `pb ≫ xb = Qb ≫ β` and `e ≫ Qb = Pb`, then `(l ≫ e ≫ pb) ≫ xb = (l ≫ Pb) ≫ β`. -/
private theorem comp_comp_comp_eq_of_squares {C : Type*} [Category C] {A P Q X W' Wb : C}
    (l : A ⟶ P) (e : P ⟶ Q) (pb : Q ⟶ X) (xb : X ⟶ Wb) (Pb : P ⟶ W') (Qb : Q ⟶ W')
    (β : W' ⟶ Wb) (h1 : pb ≫ xb = Qb ≫ β) (h2 : e ≫ Qb = Pb) :
    (l ≫ e ≫ pb) ≫ xb = (l ≫ Pb) ≫ β := by
  rw [Category.assoc, Category.assoc, h1, ← Category.assoc e, h2, Category.assoc]

namespace PolarizedDescentScheme

variable {U : B.Schemes} {I : Type w} {V : I → B.Schemes} {f : ∀ i, V i ⟶ U}

/-- The object of a descent datum of polarized families at the `i`-th member of the generating
family. -/
abbrev member (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)) (i : I) :
    (polarizedProjection B).Fiber (V i) :=
  D.obj (f i) (Sieve.ofArrows_mk V f i)

variable {D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)}

/-- The chosen pullback of the `i`-th member along a morphism `α` of the site. -/
abbrev pullbackMember (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f))
    (i : I) {W : B.Schemes} (α : W ⟶ V i) : (polarizedProjection B).Fiber W :=
  pullbackFiber (polarizedProjection B) (member D i) α

/-- The chosen cartesian morphism from the pullback of the `i`-th member along `α`. -/
abbrev pullbackMemberMap (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f))
    (i : I) {W : B.Schemes} (α : W ⟶ V i) : (pullbackMember D i α).1 ⟶ (member D i).1 :=
  IsPreFibered.pullbackMap (member D i).2 α

/-- The morphism from the pullback of the `i`-th member along `α` to the `j`-th member through
the gluing isomorphism of `D` at `(α, β)`. -/
abbrev glueMap (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f))
    (i j : I) {W : B.Schemes} (α : W ⟶ V i) (β : W ⟶ V j) (h : α ≫ f i = β ≫ f j) :
    (pullbackMember D i α).1 ⟶ (member D j).1 :=
  Fiber.fiberInclusion.map
      (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) α β h).hom ≫
    pullbackMemberMap D j β

/-- The cartesian square of the chosen pullback of a member. -/
theorem isPullback_pullbackMemberMap
    (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)) (i : I) {W : B.Schemes}
    (α : W ⟶ V i) :
    IsPullback (pullbackMemberMap D i α).totalMap
      ((pullbackMember D i α).1.toBase ≫ B.inclusion.map (eqToHom (pullbackMember D i α).2))
      ((member D i).1.toBase ≫ B.inclusion.map (eqToHom (member D i).2)) (B.inclusion.map α) :=
  PolarizedFamily.isPullback_pullbackMap (member D i) α

/-- The square of the gluing isomorphism of `D`, over the identity. -/
theorem gluingIso_w (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f))
    (i j : I) {W : B.Schemes} (α : W ⟶ V i) (β : W ⟶ V j) (h : α ≫ f i = β ≫ f j) :
    (Fiber.fiberInclusion.map
        (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) α β h).hom).totalMap ≫
      ((pullbackMember D j β).1.toBase ≫ B.inclusion.map (eqToHom (pullbackMember D j β).2)) =
      (pullbackMember D i α).1.toBase ≫ B.inclusion.map (eqToHom (pullbackMember D i α).2) :=
  PolarizedFamily.fiberHom_totalMap_w _

variable (S : PolarizedDescentScheme D)

/-- The family of schemes over the site underlying the `i`-th member. -/
def memberFamily (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)) (i : I) :
    Comma (𝟭 Scheme.{u}) B.inclusion :=
  ⟨(member D i).1.total, V i, (member D i).1.toBase ≫ B.inclusion.map (eqToHom (member D i).2)⟩

/-- The descended family of schemes. -/
def targetFamily : Comma (𝟭 Scheme.{u}) B.inclusion := ⟨S.total, U, S.toBase⟩

/-- The morphism from the family of the `i`-th member to the descended family. -/
def memberFamilyMap (i : I) : memberFamily D i ⟶ S.targetFamily :=
  ⟨S.totalMap i, f i, (S.isPullback i).w⟩

/-- The morphism into the chosen pullback of the `i`-th member along the base map of a morphism
`a` of families into the `i`-th member. -/
def liftToPullback {Y : Comma (𝟭 Scheme.{u}) B.inclusion} {i : I} (a : Y ⟶ memberFamily D i) :
    Y.left ⟶ (pullbackMember D i a.right).1.total :=
  (isPullback_pullbackMemberMap D i a.right).lift a.left Y.hom a.w

/-- The morphism into the chosen pullback of the `i`-th member, followed by the projection to the
member, is the morphism of total spaces of `a`. -/
theorem liftToPullback_fst {Y : Comma (𝟭 Scheme.{u}) B.inclusion} {i : I}
    (a : Y ⟶ memberFamily D i) :
    liftToPullback a ≫ (pullbackMemberMap D i a.right).totalMap = a.left :=
  IsPullback.lift_fst _ _ _ _

/-- The morphism into the chosen pullback of the `i`-th member, followed by the structure morphism
of the pullback, is the structure morphism of `Y`. -/
theorem liftToPullback_snd {Y : Comma (𝟭 Scheme.{u}) B.inclusion} {i : I}
    (a : Y ⟶ memberFamily D i) :
    liftToPullback a ≫ ((pullbackMember D i a.right).1.toBase ≫
      B.inclusion.map (eqToHom (pullbackMember D i a.right).2)) = Y.hom :=
  IsPullback.lift_snd _ _ _ _

/-- **The gluing map recovers the second morphism.** For morphisms `a`, `b` of families into the
`i`-th and the `j`-th member agreeing over the descended family, the morphism into the pullback
of the `i`-th member followed by the gluing map at the two base maps is the morphism of total
spaces of `b`. -/
theorem liftToPullback_glueMap {Y : Comma (𝟭 Scheme.{u}) B.inclusion} {i j : I}
    (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (hab : a ≫ S.memberFamilyMap i = b ≫ S.memberFamilyMap j) :
    liftToPullback a ≫ (glueMap D i j a.right b.right
      (congrArg CommaMorphism.right hab : a.right ≫ f i = b.right ≫ f j)).totalMap = b.left := by
  have hr : a.right ≫ f i = b.right ≫ f j := congrArg CommaMorphism.right hab
  have hl : a.left ≫ S.totalMap i = b.left ≫ S.totalMap j := congrArg CommaMorphism.left hab
  refine (S.isPullback j).hom_ext ?_ ?_
  · refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (fun k => liftToPullback a ≫ k)
      (S.totalMap_glue i j a.right b.right hr)).trans ?_
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ S.totalMap i) (liftToPullback_fst a)).trans hl)
  · exact (comp_comp_comp_eq_of_squares _ _ _ _ _ _ _ (isPullback_pullbackMemberMap D j b.right).w
      (gluingIso_w D i j a.right b.right hr)).trans
      ((congrArg (· ≫ B.inclusion.map b.right) (liftToPullback_snd a)).trans b.w.symm)

/-- The morphism into the pullback of the `j`-th member is the morphism into the pullback of the
`i`-th member followed by the gluing isomorphism. -/
theorem liftToPullback_eq {Y : Comma (𝟭 Scheme.{u}) B.inclusion} {i j : I}
    (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (hab : a ≫ S.memberFamilyMap i = b ≫ S.memberFamilyMap j) :
    liftToPullback b = liftToPullback a ≫ (Fiber.fiberInclusion.map
      (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) a.right b.right
        (congrArg CommaMorphism.right hab : a.right ≫ f i = b.right ≫ f j)).hom).totalMap :=
  (isPullback_pullbackMemberMap D j b.right).hom_ext
    ((liftToPullback_fst b).trans
      ((S.liftToPullback_glueMap a b hab).symm.trans (Category.assoc _ _ _).symm))
    ((liftToPullback_snd b).trans ((liftToPullback_snd a).symm.trans
      ((congrArg (fun k => liftToPullback a ≫ k) (gluingIso_w D i j a.right b.right
        (congrArg CommaMorphism.right hab))).symm.trans (Category.assoc _ _ _).symm)))

/-- **The transition isomorphisms of the polarizations.** Over a family `Y` with morphisms `a`,
`b` to the families of the `i`-th and `j`-th members, agreeing over the descended family: the
transfer of polarizations between the chosen pullback of the `i`-th member along the base map
of `a` and the `j`-th member through the gluing isomorphism of `D`, restricted along the
morphism into that pullback. -/
def transition {Y : Comma (𝟭 Scheme.{u}) B.inclusion} (q : Y ⟶ S.targetFamily) {i j : I}
    (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (ha : a ≫ S.memberFamilyMap i = q) (hb : b ≫ S.memberFamilyMap j = q) :
    (modulePullbackPseudofunctor.map a.left.op.toLoc).toFunctor.obj (member D i).1.lineBundle ⟶
      (modulePullbackPseudofunctor.map b.left.op.toLoc).toFunctor.obj (member D j).1.lineBundle :=
  pullHom (F := modulePullbackPseudofunctor)
    (PolarizedFamily.lineBundleTransfer (pullbackMemberMap D i a.right)
      (glueMap D i j a.right b.right (congrArg CommaMorphism.right (ha.trans hb.symm)))).hom
    (liftToPullback a) a.left b.left (liftToPullback_fst a)
    (S.liftToPullback_glueMap a b (ha.trans hb.symm))

/-- The transition from a morphism to itself is the identity (the gluing isomorphism of `D` of
an arrow with itself is the identity). -/
theorem transition_self {Y : Comma (𝟭 Scheme.{u}) B.inclusion} (q : Y ⟶ S.targetFamily) {i : I}
    (a : Y ⟶ memberFamily D i) (ha : a ≫ S.memberFamilyMap i = q) :
    S.transition q a a ha ha = 𝟙 _ := by
  have hg : glueMap D i i a.right a.right (congrArg CommaMorphism.right (ha.trans ha.symm)) =
      pullbackMemberMap D i a.right := by
    refine (congrArg (· ≫ pullbackMemberMap D i a.right)
      ((congrArg Fiber.fiberInclusion.map (D.iso_self _ _ _)).trans
        (CategoryTheory.Functor.map_id _ _))).trans ?_
    exact Category.id_comp _
  refine (PolarizedFamily.pullHom_lineBundleTransfer_congr rfl hg _ _ _ _ _
    (liftToPullback_fst a) (liftToPullback_fst a)).trans ?_
  rw [PolarizedFamily.lineBundleTransfer_self]
  exact pullHom_one _ _ _

/-- **The cocycle condition of the transitions**, from the cocycle condition of `D`. -/
theorem transition_comp {Y : Comma (𝟭 Scheme.{u}) B.inclusion} (q : Y ⟶ S.targetFamily)
    {i j k : I} (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (c : Y ⟶ memberFamily D k) (ha : a ≫ S.memberFamilyMap i = q)
    (hb : b ≫ S.memberFamilyMap j = q) (hc : c ≫ S.memberFamilyMap k = q) :
    S.transition q a b ha hb ≫ S.transition q b c hb hc = S.transition q a c ha hc := by
  have hab : a.right ≫ f i = b.right ≫ f j := congrArg CommaMorphism.right (ha.trans hb.symm)
  have hbc : b.right ≫ f j = c.right ≫ f k := congrArg CommaMorphism.right (hb.trans hc.symm)
  have hac : a.right ≫ f i = c.right ≫ f k := congrArg CommaMorphism.right (ha.trans hc.symm)
  have P : liftToPullback a ≫
      ((Fiber.fiberInclusion.map (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j)
        a.right b.right hab).hom) ≫ glueMap D j k b.right c.right hbc).totalMap =
      c.left :=
    (Category.assoc _ _ _).symm.trans (((congrArg (· ≫ (glueMap D j k b.right c.right
      hbc).totalMap) (S.liftToPullback_eq a b (ha.trans hb.symm))).symm).trans
      (S.liftToPullback_glueMap b c (hb.trans hc.symm)))
  have h2 : S.transition q b c hb hc = pullHom (F := modulePullbackPseudofunctor)
      (PolarizedFamily.lineBundleTransfer (glueMap D i j a.right b.right hab)
        ((Fiber.fiberInclusion.map (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j)
      a.right b.right hab).hom) ≫ glueMap D j k b.right c.right hbc)).hom
      (liftToPullback a) b.left c.left (S.liftToPullback_glueMap a b (ha.trans hb.symm)) P :=
    (pullHom_congr_mor _ (S.liftToPullback_eq a b (ha.trans hb.symm)) _ _ _ _ _ _).trans
      (PolarizedFamily.pullHom_lineBundleTransfer_comp _ _ _ _ _ _ _ _).symm
  have hcoc : (Fiber.fiberInclusion.map (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j)
      a.right b.right hab).hom) ≫ glueMap D j k b.right c.right hbc =
      glueMap D i k a.right c.right hac :=
    (Category.assoc _ _ _).symm.trans (congrArg (· ≫ pullbackMemberMap D k c.right)
      ((Fiber.fiberInclusion.map_comp _ _).symm.trans (congrArg Fiber.fiberInclusion.map
        (D.cocycle (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) (Sieve.ofArrows_mk V f k)
          a.right b.right c.right hab hbc hac))))
  have h5 : S.transition q a b ha hb = pullHom (F := modulePullbackPseudofunctor)
      (PolarizedFamily.lineBundleTransfer (pullbackMemberMap D i a.right)
        (glueMap D i j a.right b.right hab)).hom (liftToPullback a) a.left b.left
      (liftToPullback_fst a) (S.liftToPullback_glueMap a b (ha.trans hb.symm)) := rfl
  rw [h2, h5]
  refine (pullHom_comp _ _ _ _ _ _ _ _ _).symm.trans ?_
  refine (congrArg (fun φ => pullHom (F := modulePullbackPseudofunctor) φ (liftToPullback a)
    a.left c.left (liftToPullback_fst a) P) (PolarizedFamily.lineBundleTransfer_comp
      (pullbackMemberMap D i a.right) (glueMap D i j a.right b.right hab) _)).trans ?_
  exact PolarizedFamily.pullHom_lineBundleTransfer_congr rfl hcoc (liftToPullback a) a.left
    c.left (liftToPullback_fst a) P (liftToPullback_fst a)
    (S.liftToPullback_glueMap a c (ha.trans hc.symm))

/-- The comparison from the chosen pullback of the `i`-th member along a composite `ρ ≫ α` to
its chosen pullback along `α`: the inverse of the comparison with the iterated pullback, followed
by the chosen cartesian lift of `ρ`. -/
abbrev pullbackCompMap (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f))
    (i : I) {W W' : B.Schemes} (α : W ⟶ V i) (ρ : W' ⟶ W) :
    (pullbackMember D i (ρ ≫ α)).1 ⟶ (pullbackMember D i α).1 :=
  Fiber.fiberInclusion.map (Functor.pullbackFiberCompIso (member D i) α ρ).inv ≫
    IsPreFibered.pullbackMap (pullbackMember D i α).2 ρ

/-- The comparison `AlgebraicGeometry.PolarizedDescentScheme.pullbackCompMap` followed by the
chosen cartesian morphism along `α` is the chosen cartesian morphism along `ρ ≫ α`. -/
theorem pullbackCompMap_comp_pullbackMemberMap
    (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)) (i : I)
    {W W' : B.Schemes} (α : W ⟶ V i) (ρ : W' ⟶ W) :
    pullbackCompMap D i α ρ ≫ pullbackMemberMap D i α = pullbackMemberMap D i (ρ ≫ α) :=
  (Category.assoc _ _ _).trans (Functor.pullbackFiberCompIso_inv_fac (member D i) α ρ)

/-- The comparison `AlgebraicGeometry.PolarizedDescentScheme.pullbackCompMap` followed by the
gluing map at `(α, β)` is the gluing map at `(ρ ≫ α, ρ ≫ β)`. -/
theorem pullbackCompMap_comp_glueMap
    (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f)) (i j : I)
    {W W' : B.Schemes} (α : W ⟶ V i) (β : W ⟶ V j) (h : α ≫ f i = β ≫ f j) (ρ : W' ⟶ W) :
    pullbackCompMap D i α ρ ≫ glueMap D i j α β h = glueMap D i j (ρ ≫ α) (ρ ≫ β)
      ((Category.assoc _ _ _).trans ((congrArg (fun k => ρ ≫ k) h).trans
        (Category.assoc _ _ _).symm)) :=
  (Category.assoc _ _ _).trans (D.pullbackFiberCompIso_inv_glue (Sieve.ofArrows_mk V f i)
    (Sieve.ofArrows_mk V f j) α β h ρ)

/-- The morphism into the pullback of a member along a composite base map, followed by the
comparison with the pullback along the second factor, is the composite of the two morphisms into
pullbacks. -/
theorem liftToPullback_comp {Y Y' : Comma (𝟭 Scheme.{u}) B.inclusion} (r : Y' ⟶ Y) {i : I}
    (a : Y ⟶ memberFamily D i) :
    liftToPullback (r ≫ a) ≫ (pullbackCompMap D i a.right r.right).totalMap =
      r.left ≫ liftToPullback a := by
  refine (isPullback_pullbackMemberMap D i a.right).hom_ext ?_ ?_
  · refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (fun k => liftToPullback (r ≫ a) ≫ PolarizedFamily.Hom.totalMap k)
      (pullbackCompMap_comp_pullbackMemberMap D i a.right r.right)).trans ?_
    exact (liftToPullback_fst (r ≫ a)).trans
      ((congrArg (fun k => r.left ≫ k) (liftToPullback_fst a)).symm.trans
        (Category.assoc _ _ _).symm)
  · exact (comp_comp_comp_eq_of_squares _ _ _ _ _ _ _
      (PolarizedFamily.isPullback_pullbackMap (pullbackMember D i a.right) r.right).w
      (PolarizedFamily.fiberHom_totalMap_w _)).trans
      ((congrArg (· ≫ B.inclusion.map r.right) (liftToPullback_snd (r ≫ a))).trans
        (r.w.symm.trans ((congrArg (fun k => r.left ≫ k) (liftToPullback_snd a)).symm.trans
          (Category.assoc _ _ _).symm)))

/-- The restriction of a transition along a morphism of families, read on the morphism into the
pullback of the first member. -/
theorem pullHom_transition {Y Y' : Comma (𝟭 Scheme.{u}) B.inclusion} (r : Y' ⟶ Y)
    (q : Y ⟶ S.targetFamily) {i j : I} (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (ha : a ≫ S.memberFamilyMap i = q) (hb : b ≫ S.memberFamilyMap j = q) :
    pullHom (F := modulePullbackPseudofunctor) (S.transition q a b ha hb) r.left
        (r ≫ a).left (r ≫ b).left rfl rfl =
      pullHom (F := modulePullbackPseudofunctor)
        (PolarizedFamily.lineBundleTransfer (pullbackMemberMap D i a.right)
          (glueMap D i j a.right b.right (congrArg CommaMorphism.right (ha.trans hb.symm)))).hom
        (liftToPullback (r ≫ a) ≫ (pullbackCompMap D i a.right r.right).totalMap)
        (r ≫ a).left (r ≫ b).left
        ((congrArg (· ≫ (pullbackMemberMap D i a.right).totalMap)
          (liftToPullback_comp r a)).trans ((Category.assoc _ _ _).trans
          (congrArg (fun k => r.left ≫ k) (liftToPullback_fst a))))
        ((congrArg (· ≫ (glueMap D i j a.right b.right
          (congrArg CommaMorphism.right (ha.trans hb.symm))).totalMap)
          (liftToPullback_comp r a)).trans ((Category.assoc _ _ _).trans
          (congrArg (fun k => r.left ≫ k) (S.liftToPullback_glueMap a b (ha.trans hb.symm))))) :=
  (Pseudofunctor.LocallyDiscreteOpToCat.pullHom_pullHom _ _ _ _ _ _ _ _ _ _ _).trans
    (pullHom_congr_mor _ (liftToPullback_comp r a).symm _ _ _ _ _ _)

/-- The transition at the restricted morphisms, read on the morphism into the pullback of the
first member. -/
theorem transition_comp_eq {Y Y' : Comma (𝟭 Scheme.{u}) B.inclusion} (r : Y' ⟶ Y)
    (q : Y ⟶ S.targetFamily) {i j : I} (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (ha : a ≫ S.memberFamilyMap i = q) (hb : b ≫ S.memberFamilyMap j = q)
    (hab : a.right ≫ f i = b.right ≫ f j)
    (p1 : liftToPullback (r ≫ a) ≫ (pullbackCompMap D i a.right r.right ≫
      pullbackMemberMap D i a.right).totalMap = (r ≫ a).left)
    (p2 : liftToPullback (r ≫ a) ≫ (pullbackCompMap D i a.right r.right ≫
      glueMap D i j a.right b.right hab).totalMap = (r ≫ b).left) :
    S.transition (r ≫ q) (r ≫ a) (r ≫ b) ((Category.assoc _ _ _).trans
        (congrArg (fun k => r ≫ k) ha)) ((Category.assoc _ _ _).trans
        (congrArg (fun k => r ≫ k) hb)) =
      pullHom (F := modulePullbackPseudofunctor)
        (PolarizedFamily.lineBundleTransfer (pullbackMemberMap D i a.right)
          (glueMap D i j a.right b.right hab)).hom
        (liftToPullback (r ≫ a) ≫ (pullbackCompMap D i a.right r.right).totalMap)
        (r ≫ a).left (r ≫ b).left ((Category.assoc _ _ _).trans p1)
        ((Category.assoc _ _ _).trans p2) :=
  (PolarizedFamily.pullHom_lineBundleTransfer_congr
    (pullbackCompMap_comp_pullbackMemberMap D i a.right r.right)
    (pullbackCompMap_comp_glueMap D i j a.right b.right hab r.right) _ _ _ p1 p2 _ _).symm.trans
    (PolarizedFamily.pullHom_lineBundleTransfer_comp _ _ _ _ _ _ p1 p2)

/-- **The transitions are compatible with restriction**, from the compatibility of the gluing
isomorphisms of `D` with base change. -/
theorem transition_pull {Y Y' : Comma (𝟭 Scheme.{u}) B.inclusion} (r : Y' ⟶ Y)
    (q : Y ⟶ S.targetFamily) {i j : I} (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (ha : a ≫ S.memberFamilyMap i = q) (hb : b ≫ S.memberFamilyMap j = q) :
    pullHom (F := modulePullbackPseudofunctor) (S.transition q a b ha hb) r.left
        (r ≫ a).left (r ≫ b).left rfl rfl =
      S.transition (r ≫ q) (r ≫ a) (r ≫ b) ((Category.assoc _ _ _).trans
        (congrArg (fun k => r ≫ k) ha)) ((Category.assoc _ _ _).trans
        (congrArg (fun k => r ≫ k) hb)) :=
  (S.pullHom_transition r q a b ha hb).trans (S.transition_comp_eq r q a b ha hb _
    ((congrArg (fun m => liftToPullback (r ≫ a) ≫ PolarizedFamily.Hom.totalMap m)
      (pullbackCompMap_comp_pullbackMemberMap D i a.right r.right)).trans
      (liftToPullback_fst (r ≫ a)))
    ((congrArg (fun m => liftToPullback (r ≫ a) ≫ PolarizedFamily.Hom.totalMap m)
      (pullbackCompMap_comp_glueMap D i j a.right b.right _ r.right)).trans
      (S.liftToPullback_glueMap (r ≫ a) (r ≫ b) ((Category.assoc _ _ _).trans
        ((congrArg (r ≫ ·) (ha.trans hb.symm)).trans (Category.assoc _ _ _).symm))))).symm

/-- The chosen fibre products of two member families over the descended family. -/
abbrev memberSq (i j : I) : ChosenPullback (S.memberFamilyMap i) (S.memberFamilyMap j) :=
  commaChosenPullback _ _

/-- The chosen wide fibre products of three member families over the descended family. -/
abbrev memberSq₃ (i j k : I) : ChosenPullback₃ (S.memberSq i j) (S.memberSq j k) (S.memberSq i k) :=
  Stacks.Limits.chosenPullback₃OfChosenPullback _ _ _
    (commaChosenPullback (S.memberSq i j).p₂ (S.memberSq j k).p₁)

/-- **The descent datum of the polarizations**, in the presentation by transitions over chosen
fibre products: relative to the family of morphisms `t i` from the total spaces of the members
to the descended scheme, with components the polarizations of the members and transitions
`AlgebraicGeometry.PolarizedDescentScheme.transition`. -/
noncomputable def lineBundleDescentData' :
    modulePullbackPseudofunctor.DescentData'
      (fun i j => Stacks.Picard.mapChosenPullback (Comma.fst (𝟭 Scheme.{u}) B.inclusion)
        (S.memberSq i j) (isPullback_fst_commaChosenPullback _ _))
      (Stacks.Picard.mapChosenPullback₃ (Comma.fst (𝟭 Scheme.{u}) B.inclusion) S.memberSq
        S.memberSq₃ (fun _ _ => isPullback_fst_commaChosenPullback _ _)
        (fun _ _ _ => isPullback_fst_commaChosenPullback _ _)) :=
  Stacks.Picard.diagramDescentData (F := modulePullbackPseudofunctor)
    (Comma.fst (𝟭 Scheme.{u}) B.inclusion) S.memberSq S.memberSq₃
    (fun _ _ => isPullback_fst_commaChosenPullback _ _)
    (fun _ _ _ => isPullback_fst_commaChosenPullback _ _)
    (fun i => (member D i).1.lineBundle)
    (fun {_} q {_ _} a b ha hb => S.transition q a b ha hb)
    (fun {_} q {_} a ha => S.transition_self q a ha)
    (fun {_} q {_ _ _} a b c ha hb hc => S.transition_comp q a b c ha hb hc)
    (fun {_ _} r q {_ _} a b ha hb => S.transition_pull r q a b ha hb)

/-- **The quasi-coherent descent datum of the polarizations** relative to the family of
morphisms from the total spaces of the members to the descended scheme. -/
noncomputable def lineBundleDescentData : QuasicoherentDescentData S.totalMap :=
  ⟨S.lineBundleDescentData'.descentData,
    fun i => Stacks.Picard.isQuasicoherent_of_isInvertible _ (member D i).1.invertible⟩

/-- The transitions of the quasi-coherent descent datum of the polarizations are those of its
presentation over chosen fibre products, read through the lifts into them. -/
theorem lineBundleDescentData_obj_hom {Y : Scheme.{u}} (q : Y ⟶ S.total) {i₁ i₂ : I}
    (f₁ : Y ⟶ (member D i₁).1.total) (f₂ : Y ⟶ (member D i₂).1.total)
    (hf₁ : f₁ ≫ S.totalMap i₁ = q) (hf₂ : f₂ ≫ S.totalMap i₂ = q) :
    S.lineBundleDescentData.obj.hom q f₁ f₂ hf₁ hf₂ =
      Pseudofunctor.DescentData'.pullHom' S.lineBundleDescentData'.hom q f₁ f₂ hf₁ hf₂ :=
  Pseudofunctor.DescentData'.descentData_hom _ _ _ _ _ _ _ _ _

/-- The morphisms from the total spaces of the members to the descended scheme form an fpqc
covering family: they are the base changes of the covering family of the site. -/
theorem ofArrows_totalMap_mem_fpqcPrecoverage
    (hf : Presieve.ofArrows (fun i => B.inclusion.obj (V i)) (fun i => B.inclusion.map (f i)) ∈
      Scheme.fpqcPrecoverage (B.inclusion.obj U)) :
    Presieve.ofArrows (fun i => (member D i).1.total) S.totalMap ∈
      Scheme.fpqcPrecoverage S.total :=
  Precoverage.mem_coverings_of_isPullback _ hf S.toBase _ _ S.isPullback

/-- The square of a gluing map. -/
theorem glueMap_w (D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows V f))
    (i j : I) {W : B.Schemes} (α : W ⟶ V i) (β : W ⟶ V j) (h : α ≫ f i = β ≫ f j) :
    (glueMap D i j α β h).totalMap ≫
        ((member D j).1.toBase ≫ B.inclusion.map (eqToHom (member D j).2)) =
      ((pullbackMember D i α).1.toBase ≫ B.inclusion.map (eqToHom (pullbackMember D i α).2)) ≫
        B.inclusion.map β := by
  have := comp_comp_comp_eq_of_squares (𝟙 _) _ _ _ _ _ _
    (isPullback_pullbackMemberMap D j β).w (gluingIso_w D i j α β h)
  erw [Category.id_comp, Category.id_comp] at this
  exact this

/-- The transition, restricted along a morphism of families, at morphisms equal to the
composites. -/
theorem pullHom_transition_of_eq {Y Y' : Comma (𝟭 Scheme.{u}) B.inclusion} (r : Y' ⟶ Y)
    (q : Y ⟶ S.targetFamily) {i j : I} (a : Y ⟶ memberFamily D i) (b : Y ⟶ memberFamily D j)
    (ha : a ≫ S.memberFamilyMap i = q) (hb : b ≫ S.memberFamilyMap j = q)
    (a' : Y' ⟶ memberFamily D i) (b' : Y' ⟶ memberFamily D j) (hra : r ≫ a = a')
    (hrb : r ≫ b = b') (h₁ : r.left ≫ a.left = a'.left) (h₂ : r.left ≫ b.left = b'.left)
    (ha' : a' ≫ S.memberFamilyMap i = r ≫ q) (hb' : b' ≫ S.memberFamilyMap j = r ≫ q) :
    pullHom (F := modulePullbackPseudofunctor) (S.transition q a b ha hb) r.left a'.left b'.left
        h₁ h₂ = S.transition (r ≫ q) a' b' ha' hb' := by
  subst hra hrb
  exact S.transition_pull r q a b ha hb

/-- **The descent datum of the polarizations, read at the gluing maps of `D`.** Over the total
space of the pullback of the `i`-th member along `α`, at its morphisms to the `i`-th member and,
through the gluing isomorphism of `D` at `(α, β)`, to the `j`-th member, the transition of the
descent datum of the polarizations is the transfer of polarizations between these two morphisms. -/
theorem lineBundleDescentData_hom_glue (i j : I) {W : B.Schemes} (α : W ⟶ V i) (β : W ⟶ V j)
    (h : α ≫ f i = β ≫ f j) :
    S.lineBundleDescentData.obj.hom ((pullbackMemberMap D i α).totalMap ≫ S.totalMap i)
        (pullbackMemberMap D i α).totalMap (glueMap D i j α β h).totalMap rfl
        (S.totalMap_glue i j α β h) =
      (PolarizedFamily.lineBundleTransfer (pullbackMemberMap D i α) (glueMap D i j α β h)).hom := by
  let Wc : Comma (𝟭 Scheme.{u}) B.inclusion := ⟨(pullbackMember D i α).1.total, W,
    (pullbackMember D i α).1.toBase ≫ B.inclusion.map (eqToHom (pullbackMember D i α).2)⟩
  let a' : Wc ⟶ memberFamily D i :=
    ⟨(pullbackMemberMap D i α).totalMap, α, (isPullback_pullbackMemberMap D i α).w⟩
  let b' : Wc ⟶ memberFamily D j := ⟨(glueMap D i j α β h).totalMap, β, glueMap_w D i j α β h⟩
  have hab : a' ≫ S.memberFamilyMap i = b' ≫ S.memberFamilyMap j :=
    Comma.hom_ext _ _ (S.totalMap_glue i j α β h).symm h
  let r : Wc ⟶ (S.memberSq i j).pullback := (S.memberSq i j).isPullback.lift a' b' hab
  have hr₁ : r ≫ (S.memberSq i j).p₁ = a' := (S.memberSq i j).isPullback.lift_fst _ _ _
  have hr₂ : r ≫ (S.memberSq i j).p₂ = b' := (S.memberSq i j).isPullback.lift_snd _ _ _
  have hlift : liftToPullback a' = 𝟙 _ :=
    (isPullback_pullbackMemberMap D i α).hom_ext
      ((liftToPullback_fst a').trans (Category.id_comp _).symm)
      ((liftToPullback_snd a').trans (Category.id_comp _).symm)
  refine (S.lineBundleDescentData_obj_hom _ _ _ _ _).trans ?_
  refine (Pseudofunctor.DescentData'.pullHom'_eq_pullHom _ _ _ _ r.left _ _
    (congrArg CommaMorphism.left hr₁) (congrArg CommaMorphism.left hr₂)).trans ?_
  refine (S.pullHom_transition_of_eq r (S.memberSq i j).p _ _ (S.memberSq i j).hp₁
    (S.memberSq i j).hp₂ a' b' hr₁ hr₂ _ _
    ((hr₁ =≫ S.memberFamilyMap i).symm.trans ((Category.assoc _ _ _).trans
      (congrArg (r ≫ ·) (S.memberSq i j).hp₁)))
    ((hr₂ =≫ S.memberFamilyMap j).symm.trans ((Category.assoc _ _ _).trans
      (congrArg (r ≫ ·) (S.memberSq i j).hp₂)))).trans ?_
  refine (pullHom_congr_mor _ hlift _ _ _ _ (Category.id_comp _) (Category.id_comp _)).trans ?_
  exact Pseudofunctor.LocallyDiscreteOpToCat.pullHom_id _

/-- The family of morphisms from the total spaces of the members to the descended scheme, as a
`0`-hypercover. -/
def memberCover : PreZeroHypercover.{w} S.total where
  I₀ := I
  X i := (member D i).1.total
  f := S.totalMap

/-- **The polarizations descend** (Stacks 023T): the quasi-coherent descent datum of the
polarizations relative to the fpqc covering family of the morphisms to the descended scheme is
effective, so it is isomorphic to the canonical datum of a quasi-coherent module on the descended
scheme. -/
theorem exists_iso_lineBundleDescentData
    (hf : Presieve.ofArrows (fun i => B.inclusion.obj (V i)) (fun i => B.inclusion.map (f i)) ∈
      Scheme.fpqcPrecoverage (B.inclusion.obj U)) :
    ∃ M : (SheafOfModules.isQuasicoherent S.total.ringCatSheaf).FullSubcategory,
      Nonempty ((canonicalDescentFunctor S.totalMap).obj M ≅ S.lineBundleDescentData) :=
  QuasicoherentDescentData.isEffective_fpqcPrecoverage S.memberCover
    (S.ofArrows_totalMap_mem_fpqcPrecoverage hf) S.lineBundleDescentData

end PolarizedDescentScheme

