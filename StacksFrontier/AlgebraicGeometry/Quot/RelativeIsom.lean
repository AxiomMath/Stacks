-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace CategoryTheory

/-- **The conjugate of a morphism is an isomorphism exactly when its image under the further
functor is.**  Conjugation by a comparison `e : P₂ ≅ P₁ ⋙ L` composes `L.map α` with two
components of `e`, both of which are isomorphisms, so it neither creates nor destroys
invertibility. -/
theorem Functor.isIso_conjHom_iff {C D₁ D₂ : Type*} [Category* C] [Category* D₁]
    [Category* D₂] {P₁ : C ⥤ D₁} {P₂ : C ⥤ D₂} {L : D₁ ⥤ D₂} (e : P₂ ≅ P₁ ⋙ L) {M N : C}
    (α : P₁.obj M ⟶ P₁.obj N) : IsIso (Functor.conjHom e α) ↔ IsIso (L.map α) := by
  show IsIso (e.hom.app M ≫ L.map α ≫ e.inv.app N) ↔ IsIso (L.map α)
  rw [isIso_comp_left_iff (e.hom.app M) (L.map α ≫ e.inv.app N),
    isIso_comp_right_iff (L.map α) (e.inv.app N)]

/-- **The sheaf property passes to a local subfunctor.**  Let `G` be a subfunctor of a presheaf
`F` of types which is a sheaf for a presieve `R` on `X`, and suppose that membership of `G` is
local for `R`: a section of `F` on `X` all of whose restrictions along the members of `R` lie in
`G` lies itself in `G`.  Then `G` is a sheaf for `R`.

Separatedness is inherited because the inclusion of `G` is injective on sections, and a
compatible family of sections of `G` is in particular one of `F`, so it has a unique
amalgamation in `F`; locality of membership is exactly what puts that amalgamation back into
`G`. -/
theorem Subfunctor.isSheafFor_of_local {C : Type*} [Category* C] {F : Cᵒᵖ ⥤ Type w}
    (G : Subfunctor F) {X : C} {R : Presieve X} (hF : Presieve.IsSheafFor F R)
    (hloc : ∀ x : F.obj (op X),
      (∀ ⦃Y : C⦄ (f : Y ⟶ X), R f → F.map f.op x ∈ G.obj (op Y)) → x ∈ G.obj (op X)) :
    Presieve.IsSheafFor G.toFunctor R := by
  intro y hy
  let x : Presieve.FamilyOfElements F R := fun _ f hf ↦ (y f hf).1
  have hxc : x.Compatible := fun _ _ _ g₁ g₂ _ _ h₁ h₂ e ↦
    congrArg Subtype.val (hy g₁ g₂ h₁ h₂ e)
  obtain ⟨t, ht, ht'⟩ := hF x hxc
  have htG : t ∈ G.obj (op X) := hloc t fun Y f hf ↦ by
    rw [ht f hf]
    exact (y f hf).2
  refine ⟨⟨t, htG⟩, fun Y f hf ↦ Subtype.ext (ht f hf), fun z hz ↦ Subtype.ext ?_⟩
  exact ht' z.1 fun _ f hf ↦ congrArg Subtype.val (hz f hf)

end CategoryTheory

namespace AlgebraicGeometry.Space

/-! ### The base changes of a covering family of test schemes -/

section BaseChangeCovering

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- Pullbacks of presheaves on the big fppf site (instance search times out without this
shortcut). -/
local instance (priority := high) hasPullbacks_presheaf_relativeIsom :
    HasPullbacks ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) :=
  Limits.functorCategoryHasLimitsOfShape

local instance (priority := high) hasPullback_presheaf_relativeIsom
    {P Q R : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (a : P ⟶ R) (b : Q ⟶ R) :
    HasLimit (cospan a b) :=
  (hasPullbacks_presheaf_relativeIsom (B := B) (S := S) (hS := hS)).has_limit _

variable {X Y : AlgebraicSpaces B S hS}

/-- **The base change of a test scheme is the chosen fibre product.**  The base change `X_U` of
`f : X ⟶ Y` along a test scheme `U` over `Y` mapping to a test scheme `T` is identified with the
chosen fibre product `U ×_T X_T` of Stacks 02X2, both being cartesian over the same cospan: the
first by the pasting of `AlgebraicGeometry.Space.isPullback_baseChangeMap`, the second by
`AlgebraicGeometry.AlgebraicSpaces.isPullback_fiberProduct`. -/
def baseChangeMapIso (f : X ⟶ Y) {U T : SchemesOver Y} (g : U ⟶ T) :
    baseChangeSpace f U ≅
      AlgebraicSpaces.fiberProduct B S hS ((schemeSpaceFunctor B S hS).map g.left)
        (baseChangeInclusion f T) :=
  (isPullback_baseChangeMap f g).flip.isoIsPullback _ _
    (AlgebraicSpaces.isPullback_fiberProduct B S hS
      ((schemeSpaceFunctor B S hS).map g.left) (baseChangeInclusion f T))

/-- The identification of `X_U` with the chosen fibre product carries the second projection of
the fibre product to the morphism `X_U ⟶ X_T` of base changes. -/
theorem baseChangeMapIso_hom_comp_snd (f : X ⟶ Y) {U T : SchemesOver Y} (g : U ⟶ T) :
    (baseChangeMapIso f g).hom.hom ≫
        pullback.snd ((schemeSpaceFunctor B S hS).map g.left).hom
          (baseChangeInclusion f T).hom =
      (baseChangeMap f g).hom := by
  have h := (isPullback_baseChangeMap f g).flip.isoIsPullback_hom_snd _ _
    (AlgebraicSpaces.isPullback_fiberProduct B S hS
      ((schemeSpaceFunctor B S hS).map g.left) (baseChangeInclusion f T))
  rw [← h]
  rfl

/-- **Stacks 03MR, part (3), at the base changes of a covering family of test schemes.**  Let
`f : X ⟶ Y` be a morphism of algebraic spaces and let `(g i : U i ⟶ T)` be a family of
morphisms of test schemes over `Y` whose underlying family of algebraic spaces is an fpqc
covering.  Then the induced family `X_{U i} ⟶ X_T` of base changes is an fpqc covering of
`X_T`.

The family `{X_{U i} ⟶ X_T}` is the family `{U i ⟶ T}` pulled back along the projection
`X_T ⟶ T`: that is the cartesian square of
`AlgebraicGeometry.Space.isPullback_baseChangeMap`.  Part (3) of Stacks 03MR,
`AlgebraicGeometry.Space.isFpqcCovering_pullback`, gives the fpqc condition for the chosen
fibre products of Stacks 02X2, and the identification
`AlgebraicGeometry.Space.baseChangeMapIso` transports it to the base changes,
`AlgebraicGeometry.Space.isFpqcCovering_isoComp` absorbing the isomorphism. -/
theorem isFpqcCovering_baseChangeMap (f : X ⟶ Y) {I : Type v} {T : SchemesOver Y}
    {U : I → SchemesOver Y} (g : ∀ i, U i ⟶ T)
    (hg : IsFpqcCovering B S hS
      fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom) :
    IsFpqcCovering B S hS fun i ↦ (baseChangeMap f (g i)).hom := by
  have hpb := isFpqcCovering_pullback B S hS
    (fun i ↦ (schemeSpaceFunctor B S hS).map (g i).left) (baseChangeInclusion f T) hg
  have hiso : ∀ i, IsIso (baseChangeMapIso f (g i)).hom.hom := fun i ↦
    ⟨⟨(baseChangeMapIso f (g i)).inv.hom, by simp, by simp⟩⟩
  have hfam : (fun i ↦ (baseChangeMap f (g i)).hom) =
      fun i ↦ (baseChangeMapIso f (g i)).hom.hom ≫
        pullback.snd ((schemeSpaceFunctor B S hS).map (g i).left).hom
          (baseChangeInclusion f T).hom :=
    funext fun i ↦ (baseChangeMapIso_hom_comp_snd f (g i)).symm
  rw [hfam]
  exact isFpqcCovering_isoComp B S hS (fun i ↦ (baseChangeMapIso f (g i)).hom.hom) _ hpb

end BaseChangeCovering

/-! ### Fpqc descent of invertibility, carried -/

/-- **The full-faithfulness clause of Stacks 04W8**, in the form the relative Isom functor
consumes: given an fpqc covering `(p i : Z i ⟶ W)` of algebraic spaces over `S` and two
quasi-coherent `𝒪_W`-modules, a homomorphism between them whose inverse images along the members
of the covering are all isomorphisms is itself an isomorphism.

This is the statement that the functor from quasi-coherent modules on `W` to descent data for
the covering is faithful and full on isomorphisms, read on one morphism.  It is not available in
this development, so it is carried as a hypothesis wherever it is needed. -/
def ReflectsIsoAlongFpqcCovering (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    Prop :=
  ∀ {I : Type v} {W : AlgebraicSpaces B S hS} {Z : I → AlgebraicSpaces B S hS}
    (p : ∀ i, Z i ⟶ W), IsFpqcCovering B S hS (fun i ↦ (p i).hom) →
    ∀ M N : Modules.{u, u} B S hS W.1 W.2, M.IsQuasicoherentOnSite → N.IsQuasicoherentOnSite →
    ∀ φ : M ⟶ N, (∀ i, IsIso ((modulePullback B S hS (p i)).map φ)) → IsIso φ

namespace HomSituation

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    (s : HomSituation B S hS)

/-! ### The relative Isom functor -/

/-- A section of the relative Hom functor at a test scheme, read as the homomorphism
`F_T ⟶ G_T` of base-changed modules that it is.  The two are the same by definition; the
accessor exists so that no statement below asks the unifier to unfold
`AlgebraicGeometry.Space.HomSituation.homAt`. -/
def toModuleHom {T : s.SchemesOver} (α : s.homAt T) :
    s.baseChangedModule T s.F ⟶ s.baseChangedModule T s.G :=
  α

/-- **The invertible sections of the relative Hom functor.**  A section `α` of `Hom(F, G)` at a
test scheme `T` over the base is invertible when the `𝒪_{X_T}`-module homomorphism
`F_T ⟶ G_T` that it is, is an isomorphism. -/
def IsIsomAt {T : s.SchemesOver} (α : s.homAt T) : Prop :=
  IsIso (s.toModuleHom α)

/-- A section of the relative Hom functor is invertible exactly when it is an isomorphism of the
base-changed modules.  This is the definition, recorded so that a consumer need not unfold it. -/
theorem isIsomAt_iff {T : s.SchemesOver} (α : s.homAt T) :
    s.IsIsomAt α ↔ IsIso (s.toModuleHom α) :=
  Iff.rfl

/-- **Pullback of a homomorphism is conjugation of the module homomorphism.**  The homomorphism
of base-changed modules underlying the pullback of `α` along a morphism `g : U ⟶ T` of test
schemes is the conjugate, by the comparison of the two base changes, of the homomorphism
underlying `α`.  This is the definition of
`AlgebraicGeometry.Space.HomSituation.homMap`, recorded at the level of module homomorphisms so
that invertibility can be read off from it. -/
theorem toModuleHom_homMap {U T : s.SchemesOver} (g : U ⟶ T) (α : s.homAt T) :
    s.toModuleHom (s.homMap g α) =
      Functor.conjHom (s.baseChangeComparison g) (s.toModuleHom α) :=
  rfl

/-- **Invertibility of a pullback is invertibility of the inverse image.**  The pullback of a
homomorphism along a morphism `g : U ⟶ T` of test schemes is its inverse image along
`X_U ⟶ X_T`, read through the comparison of the two base changes; since that comparison is an
isomorphism of functors, the pullback is invertible exactly when the inverse image is.

This is the identification that turns the descent problem for `Isom(F, G)` into the descent
problem of Stacks 04W8 for a homomorphism of modules. -/
theorem isIsomAt_homMap_iff {U T : s.SchemesOver} (g : U ⟶ T) (α : s.homAt T) :
    s.IsIsomAt (s.homMap g α) ↔
      IsIso ((modulePullback B S hS (baseChangeMap s.f g)).map (s.toModuleHom α)) := by
  rw [s.isIsomAt_iff (s.homMap g α), s.toModuleHom_homMap g α]
  exact Functor.isIso_conjHom_iff (L := modulePullback B S hS (baseChangeMap s.f g))
    (M := s.F) (N := s.G) (s.baseChangeComparison g) (s.toModuleHom α)

/-- **Invertibility is stable under pullback along a morphism of test schemes.**  The inverse
image of an isomorphism is an isomorphism, so the pullback of an invertible homomorphism is
invertible. -/
theorem isIsomAt_homMap {U T : s.SchemesOver} (g : U ⟶ T) {α : s.homAt T}
    (hα : s.IsIsomAt α) : s.IsIsomAt (s.homMap g α) := by
  rw [s.isIsomAt_homMap_iff g α]
  have := (s.isIsomAt_iff α).mp hα
  infer_instance

/-- **Stacks 08K7.**  The relative Isom functor `Isom(F, G) ⊆ Hom(F, G)` as a subfunctor of the
relative Hom functor of Stacks 08JT: its sections at a test scheme `T` over the base are the
invertible `𝒪_{X_T}`-homomorphisms `F_T ⟶ G_T`.

It is a subfunctor because invertibility is stable under pullback,
`AlgebraicGeometry.Space.HomSituation.isIsomAt_homMap`.  The ambient relative Hom functor is
taken at the pseudofunctoriality of the direct images of Stacks 03LU,
`AlgebraicGeometry.Space.modulePushforwardCoherence`. -/
@[stacks 08K7 "the Isom functor as a subfunctor of the Hom functor"]
def isomSubfunctor : Subfunctor (s.homFunctor (modulePushforwardCoherence B S hS)) where
  obj V := {α : (s.homFunctor (modulePushforwardCoherence B S hS)).obj V |
    s.IsIsomAt (show s.homAt V.unop from α)}
  map {V W} i α hα := by
    have e : (s.homFunctor (modulePushforwardCoherence B S hS)).map i =
        TypeCat.ofHom (s.homMap i.unop) := by
      rw [← Quiver.Hom.op_unop i]
      exact s.homFunctor_map (modulePushforwardCoherence B S hS) i.unop
    change s.IsIsomAt (show s.homAt W.unop from
      (s.homFunctor (modulePushforwardCoherence B S hS)).map i α)
    rw [e]
    exact s.isIsomAt_homMap i.unop hα

/-- **Stacks 08K7.**  The relative Isom functor `Isom(F, G) : (Sch/base)ᵒᵖ ⥤ Sets`, whose value
at a test scheme `T` over the base is the set of invertible `𝒪_{X_T}`-homomorphisms
`F_T ⟶ G_T` and whose action on a morphism of test schemes is pullback of homomorphisms.  Its
inclusion into the relative Hom functor is `CategoryTheory.Subfunctor.ι`. -/
@[stacks 08K7 "the Isom functor"]
def isomFunctor : (s.SchemesOver)ᵒᵖ ⥤ Type (u + 1) :=
  s.isomSubfunctor.toFunctor

/-- A section of the relative Isom functor at a test scheme is an invertible section of the
relative Hom functor there. -/
theorem isomFunctor_obj (T : s.SchemesOver) :
    s.isomFunctor.obj (op T) = {α : s.homAt T // s.IsIsomAt α} :=
  rfl

/-! ### Descent of invertibility along a covering of test schemes -/

/-- **The point the proof of Stacks 08K8 isolates.**  Let `(g i : U i ⟶ T)` be an fpqc covering
family of test schemes over the base and let `α : F_T ⟶ G_T` be a homomorphism whose pullbacks
`α_{U i}` are all isomorphisms.  Then `α` is an isomorphism.

The base changes `{X_{U i} ⟶ X_T}` form an fpqc covering of `X_T` by Stacks 03MR, part (3), in
the form of `AlgebraicGeometry.Space.isFpqcCovering_baseChangeMap`; the pullback of `α` along
`g i` is invertible exactly when its inverse image along `X_{U i} ⟶ X_T` is, by
`AlgebraicGeometry.Space.HomSituation.isIsomAt_homMap_iff`; and a homomorphism of quasi-coherent
modules whose inverse images along an fpqc covering are isomorphisms is an isomorphism, which is
the carried full-faithfulness clause of Stacks 04W8. -/
theorem isIsomAt_of_isFpqcCovering
    (hdesc : ReflectsIsoAlongFpqcCovering.{u, v} B S hS)
    {I : Type v} {T : s.SchemesOver} {U : I → s.SchemesOver} (g : ∀ i, U i ⟶ T)
    (hg : IsFpqcCovering B S hS
      fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom)
    (hF : (s.baseChangedModule T s.F).IsQuasicoherentOnSite)
    (hG : (s.baseChangedModule T s.G).IsQuasicoherentOnSite)
    (α : s.homAt T) (hα : ∀ i, s.IsIsomAt (s.homMap (g i) α)) : s.IsIsomAt α :=
  hdesc (fun i ↦ baseChangeMap s.f (g i)) (isFpqcCovering_baseChangeMap s.f g hg)
    (s.baseChangedModule T s.F) (s.baseChangedModule T s.G) hF hG (s.toModuleHom α)
    fun i ↦ (s.isIsomAt_homMap_iff (g i) α).mp (hα i)

/-! ### The sheaf property of the relative Isom functor, Stacks 08K8 -/

/-- **Stacks 08K8.**  In the standing data of Stacks 08JT the relative Isom functor
`Isom(F, G)` satisfies the sheaf property for the fpqc topology: for every fpqc covering
`{U i ⟶ T}` of test schemes over the base, every compatible family of invertible
`𝒪_{X_{U i}}`-homomorphisms `F_{U i} ⟶ G_{U i}` has a unique amalgamation, again invertible.

This is the proof of the source.  The relative Hom functor already satisfies the sheaf property,
so the family glues to a unique homomorphism `F_T ⟶ G_T`; what remains is that it is invertible,
and that is `AlgebraicGeometry.Space.HomSituation.isIsomAt_of_isFpqcCovering`, which produces
the fpqc covering `{X_{U i} ⟶ X_T}` of `X_T` by Stacks 03MR, part (3), and descends
invertibility along it.  The passage from the sheaf property of `Hom(F, G)` to that of its
subfunctor is `CategoryTheory.Subfunctor.isSheafFor_of_local`. -/
@[stacks 08K8 "conditional on the sheaf property of the relative Hom functor (Stacks 08JV), on \
the full-faithfulness clause of the fpqc descent of quasi-coherent modules (Stacks 04W8), and \
on the quasi-coherence of the two base-changed modules (Stacks 03GA)"]
theorem isSheafFor_isomFunctor
    (hdesc : ReflectsIsoAlongFpqcCovering.{u, v} B S hS)
    {I : Type v} {T : s.SchemesOver} {U : I → s.SchemesOver} (g : ∀ i, U i ⟶ T)
    (hg : IsFpqcCovering B S hS
      fun i ↦ ((schemeSpaceFunctor B S hS).map (g i).left).hom)
    (hF : (s.baseChangedModule T s.F).IsQuasicoherentOnSite)
    (hG : (s.baseChangedModule T s.G).IsQuasicoherentOnSite)
    (hHom : Presieve.IsSheafFor (s.homFunctor (modulePushforwardCoherence B S hS))
      (Presieve.ofArrows U g)) :
    Presieve.IsSheafFor s.isomFunctor (Presieve.ofArrows U g) := by
  refine s.isomSubfunctor.isSheafFor_of_local hHom fun α hα ↦ ?_
  refine s.isIsomAt_of_isFpqcCovering hdesc g hg hF hG α fun i ↦ ?_
  have h := hα (g i) (Presieve.ofArrows.mk i)
  have e : (s.homFunctor (modulePushforwardCoherence B S hS)).map (g i).op =
      TypeCat.ofHom (s.homMap (g i)) :=
    s.homFunctor_map (modulePushforwardCoherence B S hS) (g i)
  rw [e] at h
  exact h

end HomSituation

end AlgebraicGeometry.Space

