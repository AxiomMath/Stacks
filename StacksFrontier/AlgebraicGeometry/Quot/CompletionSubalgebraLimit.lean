module

public import StacksFrontier.AlgebraicGeometry.Quot.CurveFamilyOverField
public import StacksFrontier.AlgebraicGeometry.Spaces.PrimeResidueFieldSite
public import StacksFrontier.AlgebraicGeometry.Size.CompleteLocalRing
public import StacksFrontier.RingTheory.AdicCompletion.QuotientCompletionMap
public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import StacksFrontier.AlgebraicGeometry.Topologies.FppfAdicCompletion

/-!
# The completion of a local ring as a limit of finitely generated subalgebras

For a ring `T` whose spectrum lies in a big fppf site `B` and any ring `R₀` mapping to `T` (in the
application, `T` is the completion `Λ^∧` of a Noetherian local ring, or an arbitrary ring and
`R₀ = ℤ`), `Spec T` is the limit, in the big affine fppf site of `Spec(ℤ)`, of the spectra of the
finitely generated `R₀`-subalgebras of `T`.

## Main results

* `AlgebraicGeometry.CompletionSubalgebra.diagram`, `AlgebraicGeometry.CompletionSubalgebra.cone`
  and `AlgebraicGeometry.CompletionSubalgebra.isLimit`: the cofiltered system of the spectra of
  the subalgebras `R₀[s] ⊆ T` generated by finite subsets `s`, and its limit `Spec T`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry

variable {Λ : Type u} [CommRing Λ] [IsLocalRing Λ] [IsNoetherianRing Λ]

namespace CompletionSubalgebra

variable (Λ)

/-- The completion `Λ^∧`. -/
abbrev Completion : Type u := AdicCompletion (maximalIdeal Λ) Λ

variable (T : Type u) [CommRing T] (R₀ : Type*) [CommRing R₀] [Algebra R₀ T]

/-- The `R₀`-subalgebra of `T` generated by a finite subset. -/
abbrev sub (s : Finset (T)) : Subalgebra R₀ (T) :=
  Algebra.adjoin R₀ (s : Set (T))

/-- The diagram of the finitely generated subalgebras `R₀[s] ⊆ T`, indexed by finite subsets. -/
def ringDiagram : Finset (T) ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (sub T R₀ s)
  map h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom h)))).toRingHom

/-- The cocone of the inclusions `R₀[s] ⊆ T`. -/
def ringCocone : Cocone (ringDiagram T R₀) where
  pt := CommRingCat.of (T)
  ι := { app := fun s ↦ CommRingCat.ofHom (sub T R₀ s).val.toRingHom }

/-- **`T` is the filtered colimit of its finitely generated `R₀`-subalgebras.** -/
def ringIsColimit : IsColimit (ringCocone T R₀) := by
  classical
  let := reflectsColimit_of_reflectsIsomorphisms (ringDiagram T R₀) (forget CommRingCat)
  exact isColimitOfReflects (forget CommRingCat) <| Types.FilteredColimit.isColimitOf' _ _
    (fun x ↦ ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_singleton_self x)⟩, rfl⟩)
    fun i x y h ↦ ⟨i, 𝟙 i, by rw [Subtype.ext h]⟩

variable (B : BigFppfSite.{u}) (hZ : B.Contains integerBase)
  (hT : B.Contains (Spec (.of (T))))

include hT in
/-- If `B` contains `Spec T`, then it contains the spectrum of each subalgebra `R₀[s] ⊆ T`. -/
theorem contains_sub (s : Finset (T)) : B.Contains (Spec (.of (sub T R₀ s))) :=
  BigFppfSite.contains_spec_of_mk_lt_cutoff B
    ((Cardinal.mk_subtype_le _).trans_lt (BigFppfSite.mk_lt_cutoff_of_contains_spec B hT))

/-- The spectrum of `R₀[s]` as an object of the big affine fppf site of `Spec(ℤ)`. -/
abbrev siteObj (s : Finset (T)) : BigAffineFppf B integerBase hZ :=
  ⟨integerSiteObject B hZ (contains_sub T R₀ B hT s), inferInstanceAs (IsAffine (Spec _))⟩

/-- The cofiltered system of the spectra of the finitely generated subalgebras of `T`. -/
def diagram : (Finset (T))ᵒᵖ ⥤ BigAffineFppf B integerBase hZ where
  obj s := siteObj T R₀ B hZ hT s.unop
  map {s t} h :=
    ObjectProperty.homMk (integerSiteMap B hZ _ _ (Spec.map ((ringDiagram T R₀).map h.unop)))
  map_id s := by
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    change Spec.map ((ringDiagram T R₀).map (𝟙 s.unop)) = 𝟙 _
    rw [CategoryTheory.Functor.map_id, Spec.map_id]
  map_comp {s t r} h k := by
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    change Spec.map ((ringDiagram T R₀).map (k.unop ≫ h.unop)) =
      Spec.map ((ringDiagram T R₀).map h.unop) ≫ Spec.map ((ringDiagram T R₀).map k.unop)
    rw [CategoryTheory.Functor.map_comp, Spec.map_comp]

/-- `Spec T` as an object of the big affine fppf site of `Spec(ℤ)`. -/
abbrev vertex : BigAffineFppf B integerBase hZ :=
  ⟨integerSiteObject B hZ hT, inferInstanceAs (IsAffine (Spec _))⟩

/-- The cone of the morphisms `Spec T ⟶ Spec R₀[s]`. -/
def cone : Cone (diagram T R₀ B hZ hT) where
  pt := vertex T B hZ hT
  π :=
    { app := fun s ↦ ObjectProperty.homMk
        (integerSiteMap B hZ _ _ (Spec.map ((ringCocone T R₀).ι.app s.unop)))
      naturality := by
        intro s t h
        apply ObjectProperty.hom_ext
        apply Over.OverMorphism.ext
        apply ObjectProperty.hom_ext
        change 𝟙 _ ≫ Spec.map ((ringCocone T R₀).ι.app t.unop) =
          Spec.map ((ringCocone T R₀).ι.app s.unop) ≫ Spec.map ((ringDiagram T R₀).map h.unop)
        rw [Category.id_comp, ← Spec.map_comp, (ringCocone T R₀).w h.unop] }

/-- **`Spec T` is the limit of the spectra of the finitely generated subalgebras of `T`**:
`Spec` turns the filtered colimit `T = colim R₀[s]` into a limit of schemes. -/
def isLimit : IsLimit ((BigAffineFppf.toScheme B integerBase hZ).mapCone (cone T R₀ B hZ hT)) :=
  isLimitOfPreserves Scheme.Spec (ringIsColimit T R₀).op

end CompletionSubalgebra

end AlgebraicGeometry

end
