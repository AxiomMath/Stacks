module

public import StacksFrontier.AlgebraicGeometry.Quot.PolarizedPushout
public import StacksFrontier.AlgebraicGeometry.Quot.PolarizedStackIsom
public import StacksFrontier.AlgebraicGeometry.Spaces.RepresentedStronglyCartesian
public import StacksFrontier.CategoryTheory.Sites.Stack.EffectiveDescentRefinement
public import StacksFrontier.CategoryTheory.Sites.Stack.FibredOneMorphismPullback
public import StacksFrontier.CategoryTheory.Sites.Stack.StackBridge.MorSheafFromIsom

/-!
# Effective descent for polarized families: the formal reductions (Stacks 0D40)

The second assertion of Stacks 0D40 is that the category `Polarized` of polarized families of
Stacks 0D1M is a stack over the big fppf site. Its three conditions (Stacks 026F) are: that it
is fibred (Stacks 0D3Z), that its morphism presheaves are sheaves, and that descent data are
effective. This file proves the second condition and reduces the third to two inputs:

* the covering may be refined first, so a descent datum need only be shown effective relative
  to a *chosen* covering family of the site, whose members are flat, locally of finite
  presentation and jointly surjective;
* the image of a descent datum under the forgetful functor of Stacks 0D3Y is a descent datum of
  finitely presented, flat and proper families of algebraic spaces, and it is effective by
  Stacks 0D1G. This produces the algebraic space `X` over the base which the source's proof
  then shows to carry the descended polarization.

## Main results

* `AlgebraicGeometry.polarizedProjection_isMorSheaf`: condition (2) of Stacks 026F for
  `Polarized`, from the `Isom` condition of Stacks 02ZI proved in
  `StacksFrontier/AlgebraicGeometry/Quot/PolarizedStackIsom.lean`.
* `AlgebraicGeometry.polarizedProjection_isStack_of_isEffective`: `Polarized` is a stack over
  the big fppf site as soon as descent data relative to chosen covering families are effective.
* `AlgebraicGeometry.forgetPolarization_isFibredOneMorphism`: the forgetful functor of
  Stacks 0D3Y is a 1-morphism of fibred categories over the site.
* `AlgebraicGeometry.isEffective_mapF_forgetPolarization`: the family of algebraic spaces
  underlying a descent datum of polarized families descends (Stacks 0D1G).
* `AlgebraicGeometry.PolarizedFamily.isPullback_of_forgetPolarization_hom`: once the descended
  algebraic space is represented by a scheme, each morphism into it from the family underlying a
  polarized family is a cartesian square of schemes.

## References

* [Stacks Project, Tag 0D40](https://stacks.math.columbia.edu/tag/0D40)
* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
* [Stacks Project, Tag 0D1G](https://stacks.math.columbia.edu/tag/0D1G)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

variable (B : BigFppfSite.{u})

/-- **Condition (2) of Stacks 026F for polarized families.** The presheaves of morphisms between
two polarized families over a scheme of the big fppf site are sheaves. This is the `Isom`
condition of Stacks 02ZI, `AlgebraicGeometry.polarizedProjection_isomIsSheafFor`, read through
`CategoryTheory.Functor.isMorSheaf_of_isomIsSheaf`, the category being fibred in groupoids. -/
theorem polarizedProjection_isMorSheaf (U : B.Schemes) (x y : (polarizedProjection B).Fiber U) :
    (polarizedProjection B).IsMorSheaf B.topology U x y :=
  Functor.isMorSheaf_of_isomIsSheaf polarizedProjection_isFiberedInGroupoids_unconditional
    (fun a b ha hb _ V g hg Vij pr₁ pr₂ hVij ar br arij brij =>
      polarizedProjection_isomIsSheafFor a b ha hb V g hg Vij pr₁ pr₂ hVij ar br arij brij)
    U x y

/-- **Effectivity may be checked on chosen covering families.** Polarized families form a stack
over the big fppf site as soon as every descent datum relative to the sieve generated by a
chosen covering family of the site is effective.

Every covering sieve contains a chosen covering family
(`AlgebraicGeometry.exists_covering_le_of_mem_topology`), and since the morphism
presheaves are sheaves (`AlgebraicGeometry.polarizedProjection_isMorSheaf`) a descent datum is
effective as soon as its restriction to a covering refinement is
(`CategoryTheory.Functor.hasEffectiveDescent_of_familyRefinements`). -/
theorem polarizedProjection_isStack_of_isEffective
    (heff : ∀ ⦃U : B.Schemes⦄ (E : PreZeroHypercover.{u + 1} U), B.IsCovering ⟨U, E⟩ →
      ∀ D : (polarizedProjection B).SieveDescentDatum (Sieve.ofArrows E.X E.f), D.IsEffective) :
    (polarizedProjection B).IsStack B.topology where
  isFibered := inferInstance
  isMorSheaf := polarizedProjection_isMorSheaf B
  hasEffectiveDescent := by
    refine Functor.hasEffectiveDescent_of_familyRefinements (polarizedProjection_isMorSheaf B)
      fun U R hR => ?_
    obtain ⟨E, hE, hle⟩ := exists_covering_le_of_mem_topology B hR
    exact ⟨E.I₀, E.X, E.f, fun i => hle _ _ (Presieve.ofArrows.mk i),
      Precoverage.generate_mem_toGrothendieck ⟨E, rfl, hE⟩, heff E hE⟩

/-- The forgetful functor of Stacks 0D3Y is a 1-morphism of fibred categories over the big fppf
site: it is strictly over the site, and every morphism of its target is strongly cartesian, the
target being fibred in groupoids (Stacks 0D1E). -/
theorem forgetPolarization_isFibredOneMorphism :
    Functor.IsFibredOneMorphism (polarizedProjection B) (polarizedFamiliesProperFlatProjection B)
      (forgetPolarization B) where
  comp_eq := forgetPolarization_comp_polarizedFamiliesProperFlatProjection B
  map_isStronglyCartesian {_ _} f _ _ φ hφ := by
    have : (polarizedFamiliesProperFlatProjection B).IsHomLift f ((forgetPolarization B).map φ) :=
      Functor.isHomLift_map_of_comp_eq
        (forgetPolarization_comp_polarizedFamiliesProperFlatProjection B) f φ
    exact (polarizedFamiliesProperFlatProjection_isFiberedInGroupoids B).isStronglyCartesian_homLift
      f _

/-- **The family of algebraic spaces underlying a descent datum of polarized families descends.**
The image of a descent datum of polarized families under the forgetful functor of Stacks 0D3Y
is a descent datum of finitely presented, flat and proper families of algebraic spaces over the
terminal scheme, and it is effective because these form a stack over the big fppf site
(Stacks 0D1G, `AlgebraicGeometry.polarizedFamiliesProperFlatProjection_isStack`). -/
theorem isEffective_mapF_forgetPolarization {U : B.Schemes} {R : Sieve U} (hR : R ∈ B.topology U)
    (D : (polarizedProjection B).SieveDescentDatum R) :
    haveI := (polarizedFamiliesProperFlatProjection_isStack B).isFibered
    (D.mapF (forgetPolarization_isFibredOneMorphism B)).IsEffective :=
  have := (polarizedFamiliesProperFlatProjection_isStack B).isFibered
  (polarizedFamiliesProperFlatProjection_isStack B).hasEffectiveDescent R hR _

/-- **A morphism into a represented family is a cartesian square of schemes.** Let `x` be a
polarized family, `y` a finitely presented, flat and proper family of algebraic spaces over the
terminal scheme whose algebraic space is represented, through `e`, by a scheme `Z` of the site,
and `φ` a morphism from the family underlying `x` to `y`. Then the morphism of schemes
underlying the morphism of total spaces of `φ`, the structure morphism of `x`, the structure
morphism of `Z` and the morphism of bases of `φ` form a cartesian square.

This is `AlgebraicGeometry.isPullback_toScheme_preimage_of_isStronglyCartesian` at the identity
representation of the total space of `x`; the structure morphism of `x` is recovered from its
image under the Yoneda embedding. -/
theorem PolarizedFamily.isPullback_of_forgetPolarization_hom {x : PolarizedFamily B}
    {y : CartesianProperFlatSpaces B integerBase B.contains_integerBase}
    (φ : (forgetPolarization B).obj x ⟶ y) {Z : BigFppfOver B integerBase B.contains_integerBase}
    (e : yoneda.obj Z ≅ y.obj.obj.left.1) :
    IsPullback
      ((BigFppfOver.toScheme B integerBase B.contains_integerBase).map
        (Yoneda.fullyFaithful.preimage (φ.1.hom.left.hom ≫ e.inv)))
      x.toBase
      ((BigFppfOver.toScheme B integerBase B.contains_integerBase).map
        (Yoneda.fullyFaithful.preimage (e.hom ≫ y.obj.obj.hom)))
      ((BigFppfOver.toScheme B integerBase B.contains_integerBase).map φ.1.hom.right) := by
  have h := isPullback_toScheme_preimage_of_isStronglyCartesian φ.1.hom φ.2
    (Iso.refl (yoneda.obj ((schemeOverIntegers B).obj x.totalObj))) e
  have h₁ : Yoneda.fullyFaithful.preimage
      ((Iso.refl (yoneda.obj ((schemeOverIntegers B).obj x.totalObj))).hom ≫
        φ.1.hom.left.hom ≫ e.inv) = Yoneda.fullyFaithful.preimage (φ.1.hom.left.hom ≫ e.inv) := by
    rw [Iso.refl_hom, Category.id_comp]
  have h₂ : (BigFppfOver.toScheme B integerBase B.contains_integerBase).map
      (Yoneda.fullyFaithful.preimage
        ((Iso.refl (yoneda.obj ((schemeOverIntegers B).obj x.totalObj))).hom ≫
          ((forgetPolarization B).obj x).obj.obj.hom)) = x.toBase := by
    rw [Iso.refl_hom]
    exact congrArg (BigFppfOver.toScheme B integerBase B.contains_integerBase).map
      ((congrArg Yoneda.fullyFaithful.preimage (Category.id_comp _)).trans
        (Yoneda.fullyFaithful.preimage_map x.structureMapOverIntegers))
  refine IsPullback.of_iso h (Iso.refl _) (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_
    (by simp only [Iso.refl_hom, Category.comp_id]; exact (Category.id_comp _).symm)
    (by simp only [Iso.refl_hom, Category.comp_id]; exact (Category.id_comp _).symm)
  · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    exact congrArg (BigFppfOver.toScheme B integerBase B.contains_integerBase).map h₁
  · simp only [Iso.refl_hom]
    exact h₂

end AlgebraicGeometry

end
