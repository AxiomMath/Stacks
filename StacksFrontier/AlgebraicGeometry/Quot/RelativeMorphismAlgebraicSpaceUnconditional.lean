/-!
# The relative morphism functor is an algebraic space

Let `z : Z ⟶ Q` and `x : X ⟶ Q` be morphisms of algebraic spaces over a scheme `S` of a big fppf
site, with `x` of finite presentation and separated and `z` of finite presentation, flat and
proper. Then `Mor_Q(Z, X)` is an algebraic space whose projection to `Q` is locally of finite
presentation.

`Mor_Q(Z, X)` is an open subspace of the Hilbert functor of `Z ×_Q X` over `Q`. Over any algebraic
space `Q`, the Hilbert functor of a morphism `W ⟶ Q` of finite presentation and separated is an
algebraic space locally of finite presentation over `Q`: it is the Quot functor of `𝒪_W`, and
`𝒪_W` is étale-locally generated by finitely many sections.

## Main results

* `AlgebraicGeometry.Space.hasHilbertModelsOver`: for an algebraic space `Q`, every morphism
  `W ⟶ Q` of finite presentation and separated has a model of its Hilbert presheaf which is an
  algebraic space, with projection to `Q` locally of finite presentation.
* `AlgebraicGeometry.Space.isAlgebraicSpace_relativeHom_and_isLocallyOfFinitePresentation`:
  `Mor_Q(Z, X)` is an algebraic space, locally of finite presentation over `Q`.

## References

* [Stacks Project, Tag 0D1C](https://stacks.math.columbia.edu/tag/0D1C)
* [Stacks Project, Tag 0D1B](https://stacks.math.columbia.edu/tag/0D1B)
* [Stacks Project, Tag 0D01](https://stacks.math.columbia.edu/tag/0D01)
* [Stacks Project, Tag 09TU](https://stacks.math.columbia.edu/tag/09TU)
-/

@[expose] public section

open CategoryTheory Cardinal

universe u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- For an algebraic space `Q`, every morphism `W ⟶ Q` of finite presentation and separated has a
model of its Hilbert presheaf which is an algebraic space over `S`, with projection to `Q` locally
of finite presentation (Stacks 0D01 over `Q`). This is
`AlgebraicGeometry.Space.hasHilbertModelsOver_of_isAlgebraicSpace`. -/
alias hasHilbertModelsOver := hasHilbertModelsOver_of_isAlgebraicSpace

/-- Let `z : Z ⟶ Q` and `x : X ⟶ Q` be morphisms of algebraic spaces over `S`. Assume `x` is of
finite presentation and separated, and `z` is of finite presentation, flat and proper. Then
`Mor_Q(Z, X)` is an algebraic space, and its projection to `Q` is locally of finite
presentation. -/
@[stacks 0D1C]
theorem isAlgebraicSpace_relativeHom_and_isLocallyOfFinitePresentation
    {Z X Q : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (z : Z ⟶ Q) (x : X ⟶ Q)
    (hZ : IsAlgebraicSpace B S hS Z) (hX : IsAlgebraicSpace B S hS X)
    (hQ : IsAlgebraicSpace B S hS Q)
    (hx_fp : IsFinitePresentation B S hS x) (hx_sep : IsSeparated B S hS x)
    (hz_fp : IsFinitePresentation B S hS z) (hz_flat : IsFlat B S hS z)
    (hz_proper : IsProper B S hS z) :
    IsAlgebraicSpace B S hS (relativeHom B S hS Z X Q z x hZ hX hQ) ∧
      IsLocallyOfFinitePresentation B S hS
        (relativeHomProjection B S hS Z X Q z x hZ hX hQ) :=
  ⟨isAlgebraicSpace_relativeHom z x hZ hX hQ hx_fp hx_sep hz_fp hz_flat hz_proper,
    isLocallyOfFinitePresentation_relativeHomProjection z x hZ hX hQ hx_fp hx_sep hz_fp hz_flat
      hz_proper⟩

end AlgebraicGeometry.Space

end
