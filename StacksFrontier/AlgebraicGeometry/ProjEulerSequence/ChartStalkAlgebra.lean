module

public import StacksFrontier.AlgebraicGeometry.ProjEulerSequence.StructureMorphism
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Differentials
public import StacksFrontier.AlgebraicGeometry.RelativeDifferentialStalkMap.Scheme

/-!
# The local ring of projective space as a localization of a standard chart

Grade `R[T₀, …, Tₙ]` by total degree, write `X = Proj R[T]` for projective `n`-space over `R`
with structure morphism `f : X ⟶ Spec R`, and let `x` be a point of `X` lying in the standard
chart `D₊(Tᵢ)`. The local ring `𝒪_{X,x}` is then a localization of the chart ring
`B = R[T]_{(Tᵢ)}`, at the prime of `B` corresponding to `x`. Consequently the differentials of
`𝒪_{X,x}` over the base are generated by the differentials of the affine coordinates
`T_j / T_i`, `j ≠ i`.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjPolyChart.projStalk`: the local ring `𝒪_{X,x}`.
* `Stacks.AlgebraicGeometry.ProjPolyChart.chartToStalk`: the comparison `B → 𝒪_{X,x}`.
* `Stacks.AlgebraicGeometry.ProjPolyChart.chartPrimeCompl`: the multiplicative set of `B` that
  is inverted.

## Main results

* `Stacks.AlgebraicGeometry.ProjPolyChart.isLocalization_chartToStalk`: the local ring of
  projective space at `x` is the localization of the chart ring at the prime of `x`.
* `Stacks.AlgebraicGeometry.ProjPolyChart.span_range_D_chartToStalk_eq_top`: the differentials
  of the affine coordinates generate the differentials of `𝒪_{X,x}` over the stalk of
  `f⁻¹𝒪_{Spec R}`.

## Implementation notes

None of the algebra structures below can be a global instance: they all depend on the chosen
variable `Tᵢ` and on the point `x`. They are therefore plain definitions, introduced with `letI`
wherever they are needed, including inside the statements of the theorems.

## References

* [Stacks Project, Tag 01MR](https://stacks.math.columbia.edu/tag/01MR)
* [Stacks Project, Tag 0FMH](https://stacks.math.columbia.edu/tag/0FMH)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite AlgebraicGeometry HomogeneousLocalization

namespace Stacks.AlgebraicGeometry.ProjPolyChart

universe u

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local instance 0] HomogeneousLocalization.instSMul

variable (R : Type u) [CommRing R] (n : ℕ) (i : Fin (n + 1))
  (x : ProjectiveSpectrum.top (polyGrading R n))

/-- The homogeneous prime ideal underlying a point of `Proj R[T₀, …, Tₙ]` is prime. -/
local instance isPrime_toIdeal : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime

/-- The local ring of projective `n`-space over `R` at a point `x`, namely the stalk at `x` of
the structure sheaf of `Proj R[T₀, …, Tₙ]`. -/
abbrev projStalk : Type u :=
  ToType ((AlgebraicGeometry.Proj (polyGrading R n)).sheaf.presheaf.stalk x)

variable (hx : (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) R) ∉ x.asHomogeneousIdeal)

/-- **The chart ring maps to the local ring at a point of the chart.** The composite of the
inclusion `R[T]_{(Tᵢ)} → R[T]_{(x)}` of degree-zero homogeneous localizations with the
identification of the latter with the stalk at `x`. -/
def chartToStalk : Away (polyGrading R n) (MvPolynomial.X i) →+* projStalk R n x :=
  (AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x).symm.toRingHom.comp
    (HomogeneousLocalization.mapId (polyGrading R n) (Submonoid.powers_le.mpr hx))

/-- The local ring at a point of the chart, as an algebra over the chart ring. -/
@[instance_reducible] def algebraChartStalk :
    Algebra (Away (polyGrading R n) (MvPolynomial.X i)) (projStalk R n x) :=
  (chartToStalk R n i x hx).toAlgebra

/-- Read through the identification of the stalk with the degree-zero homogeneous localization at
`x`, the comparison of the chart ring with the local ring is the inclusion of homogeneous
localizations. -/
theorem stalkIso'_chartToStalk (c : Away (polyGrading R n) (MvPolynomial.X i)) :
    AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x (chartToStalk R n i x hx c) =
      HomogeneousLocalization.mapId (polyGrading R n) (Submonoid.powers_le.mpr hx) c :=
  (AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x).apply_symm_apply _

/-- **The value of the image of a constant.** A coefficient `r : R` goes to the element of the
local ring at `x` whose value in the localization of `R[T]` at `x` is the constant `C r`. -/
theorem val_stalkIso'_chartToStalk_coeffToAway (r : R) :
    HomogeneousLocalization.val (AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x
        (chartToStalk R n i x hx (coeffToAway R n i r))) =
      algebraMap (MvPolynomial (Fin (n + 1)) R)
        (Localization x.asHomogeneousIdeal.toIdeal.primeCompl) (MvPolynomial.C r) := by
  rw [stalkIso'_chartToStalk, coeffToAway_eq_mk,
    show HomogeneousLocalization.mapId (polyGrading R n) (Submonoid.powers_le.mpr hx)
      (Away.mk (polyGrading R n) (X_mem_one R n i) 0 (MvPolynomial.C r) (C_mem_zero R n r)) =
      HomogeneousLocalization.mk ⟨0 • 1, ⟨MvPolynomial.C r, C_mem_zero R n r⟩,
        ⟨(MvPolynomial.X i : MvPolynomial (Fin (n + 1)) R) ^ 0,
          SetLike.pow_mem_graded 0 (X_mem_one R n i)⟩,
        Submonoid.powers_le.mpr hx ⟨0, rfl⟩⟩ from rfl, HomogeneousLocalization.val_mk,
    ← Localization.mk_one_eq_algebraMap, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp⟩

/-- The prime of the chart ring `R[T]_{(Tᵢ)}` cut out by a point `x` of the chart, namely the
image of `x` under the identification of the chart with `Spec R[T]_{(Tᵢ)}`. -/
abbrev chartSpecPoint : PrimeSpectrum (Away (polyGrading R n) (MvPolynomial.X i)) :=
  (AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec (polyGrading R n) (MvPolynomial.X i)).base
    ⟨x, (ProjectiveSpectrum.mem_basicOpen _ _ _).mpr hx⟩

/-- The multiplicative set of the chart ring that the local ring at `x` inverts: the complement
of the prime of the chart corresponding to `x`. -/
abbrev chartPrimeCompl : Submonoid (Away (polyGrading R n) (MvPolynomial.X i)) :=
  (chartSpecPoint R n i x hx).asIdeal.primeCompl

/-- **The local ring of projective space at a point of a standard chart is a localization of the
chart ring**, at the prime of the chart ring corresponding to that point. -/
theorem isLocalization_chartToStalk :
    letI := algebraChartStalk R n i x hx
    IsLocalization (chartPrimeCompl R n i x hx) (projStalk R n x) := by
  let := algebraChartStalk R n i x hx
  let : Algebra (Away (polyGrading R n) (MvPolynomial.X i))
      (AtPrime (polyGrading R n) x.asHomogeneousIdeal.toIdeal) :=
    (HomogeneousLocalization.mapId (polyGrading R n) (Submonoid.powers_le.mpr hx)).toAlgebra
  have h := AlgebraicGeometry.ProjectiveSpectrum.Proj.isLocalization_atPrime
    (polyGrading R n) (MvPolynomial.X i)
    ⟨x, (ProjectiveSpectrum.mem_basicOpen _ _ _).mpr hx⟩
    (X_mem_one R n i) Nat.one_pos
  exact (IsLocalization.isLocalization_iff_of_ringEquiv _
    (AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x).symm).mp h

/-- The local ring at a point of the chart, as an algebra over the coefficient ring. -/
@[instance_reducible] def algebraRStalk : Algebra R (projStalk R n x) :=
  ((chartToStalk R n i x hx).comp (coeffToAway R n i)).toAlgebra

/-- `R → R[T]_{(Tᵢ)} → 𝒪_{X,x}` is a tower of algebras. -/
theorem isScalarTower_R_chart_stalk :
    letI := algebraChartStalk R n i x hx
    letI := algebraRStalk R n i x hx
    IsScalarTower R (Away (polyGrading R n) (MvPolynomial.X i)) (projStalk R n x) :=
  let := algebraChartStalk R n i x hx
  let := algebraRStalk R n i x hx
  IsScalarTower.of_algebraMap_eq fun _ => rfl

/-- The coefficient ring maps to the local ring of `Spec R` at the image of `x` under the
structure morphism: a coefficient is a global function on `Spec R`, and one takes its germ. -/
def coeffToSpecStalk :
    R →+* ToType ((Spec (CommRingCat.of R)).presheaf.stalk ((projToSpecCoeff R n) x)) :=
  ((Spec (CommRingCat.of R)).presheaf.germ ⊤ ((projToSpecCoeff R n) x) trivial).hom.comp
    (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom

/-- The stalk at `x` of `f⁻¹𝒪_{Spec R}`, as an algebra over the coefficient ring: a coefficient
goes to its germ at `f x`, read through the identification of that stalk with
`𝒪_{Spec R, f x}`. -/
@[instance_reducible] def algebraRInverseImage :
    Algebra R (Stacks.RelativeDifferentialStalkMap.inverseImageStalk (projToSpecCoeff R n) x) :=
  ((Stacks.SheafifyStalk.stalkInverseImageStructureSheafIso (projToSpecCoeff R n) x).inv.hom.comp
    (coeffToSpecStalk R n x)).toAlgebra

/-- **The stalk of the structure morphism carries the germ of a constant to that constant.** The
germ at `f x` of a coefficient `r : R`, viewed as a function on `Spec R`, maps under the stalk
map of `f` to the image of `r` in the local ring of projective space at `x`. -/
theorem stalkMap_coeffToSpecStalk (r : R) :
    letI := algebraRStalk R n i x hx
    ((projToSpecCoeff R n).stalkMap x).hom (coeffToSpecStalk R n x r) =
      algebraMap R (projStalk R n x) r := by
  let := algebraRStalk R n i x hx
  refine (AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x).injective
    (HomogeneousLocalization.val_injective _ ?_)
  rw [show algebraMap R (projStalk R n x) r =
      chartToStalk R n i x hx (coeffToAway R n i r) from rfl,
    val_stalkIso'_chartToStalk_coeffToAway]
  refine Eq.trans (congrArg (fun z : projStalk R n x =>
    HomogeneousLocalization.val
      (AlgebraicGeometry.Proj.stalkIso' (polyGrading R n) x z))
    (AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply (projToSpecCoeff R n) ⊤ x trivial
      ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r))) ?_
  refine Eq.trans (congrArg HomogeneousLocalization.val
    (AlgebraicGeometry.Proj.stalkIso'_germ (polyGrading R n) ⊤ x trivial
      (((projToSpecCoeff R n).appTop).hom
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)))) ?_
  exact Stacks.AlgebraicGeometry.ProjEulerSequence.projToSpecCoeff_appTop_val R n r x

/-- `R → (f⁻¹𝒪_{Spec R})_x → 𝒪_{X,x}` is a tower of algebras: the composite of the germ of a
constant with the stalk map of `f` is the coefficient inclusion of the local ring at `x`. -/
theorem isScalarTower_R_inverseImage_stalk :
    letI := algebraRStalk R n i x hx
    letI := algebraRInverseImage R n x
    letI := Stacks.RelativeDifferentialStalk.algebraStalk
      (AlgebraicGeometry.inverseImageStructureMap (projToSpecCoeff R n)).hom x
    IsScalarTower R
      (Stacks.RelativeDifferentialStalkMap.inverseImageStalk (projToSpecCoeff R n) x)
      (projStalk R n x) := by
  let := algebraRStalk R n i x hx
  let := algebraRInverseImage R n x
  let := Stacks.RelativeDifferentialStalk.algebraStalk
    (AlgebraicGeometry.inverseImageStructureMap (projToSpecCoeff R n)).hom x
  let := Stacks.RelativeDifferentialStalkMap.algebraStalkMap (projToSpecCoeff R n) x
  let := Stacks.RelativeDifferentialStalkMap.algebraStalkInverseImage (projToSpecCoeff R n) x
  let := Stacks.RelativeDifferentialStalkMap.isScalarTower_stalk (projToSpecCoeff R n) x
  refine IsScalarTower.of_algebraMap_eq fun r => ?_
  refine Eq.trans (stalkMap_coeffToSpecStalk R n i x hx r).symm ?_
  exact IsScalarTower.algebraMap_apply
    (ToType ((Spec (CommRingCat.of R)).presheaf.stalk ((projToSpecCoeff R n) x)))
    (Stacks.RelativeDifferentialStalkMap.inverseImageStalk (projToSpecCoeff R n) x)
    (projStalk R n x) (coeffToSpecStalk R n x r)

/-- **The differentials of the local ring of projective space at a point of a standard chart are
generated by the differentials of the affine coordinates.** Over the stalk of `f⁻¹𝒪_{Spec R}` at
`x`, the module `Ω[𝒪_{X,x}⁄(f⁻¹𝒪_{Spec R})_x]` is spanned by the `n` differentials
`d(T_j / T_i)`, `j ≠ i`. -/
theorem span_range_D_chartToStalk_eq_top :
    letI := algebraChartStalk R n i x hx
    letI := algebraRStalk R n i x hx
    letI := isLocalization_chartToStalk R n i x hx
    letI := isScalarTower_R_chart_stalk R n i x hx
    letI := algebraRInverseImage R n x
    letI := Stacks.RelativeDifferentialStalk.algebraStalk
      (AlgebraicGeometry.inverseImageStructureMap (projToSpecCoeff R n)).hom x
    letI := isScalarTower_R_inverseImage_stalk R n i x hx
    Submodule.span (projStalk R n x)
        (Set.range fun j : {j : Fin (n + 1) // j ≠ i} =>
          KaehlerDifferential.D
            (Stacks.RelativeDifferentialStalkMap.inverseImageStalk (projToSpecCoeff R n) x)
            (projStalk R n x) (chartToStalk R n i x hx (chartCoord R n i j))) = ⊤ := by
  let := algebraChartStalk R n i x hx
  let := algebraRStalk R n i x hx
  let := isLocalization_chartToStalk R n i x hx
  let := isScalarTower_R_chart_stalk R n i x hx
  let := algebraRInverseImage R n x
  let := Stacks.RelativeDifferentialStalk.algebraStalk
    (AlgebraicGeometry.inverseImageStructureMap (projToSpecCoeff R n)).hom x
  let := isScalarTower_R_inverseImage_stalk R n i x hx
  exact span_range_D_chartCoord_localization R n i (chartPrimeCompl R n i x hx)
    (projStalk R n x)
    (Stacks.RelativeDifferentialStalkMap.inverseImageStalk (projToSpecCoeff R n) x)

end Stacks.AlgebraicGeometry.ProjPolyChart

end
