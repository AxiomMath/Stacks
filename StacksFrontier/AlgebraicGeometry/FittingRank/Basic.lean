/-!
# Fitting ideals and finite locally free modules

A finite type quasi-coherent module on a scheme is finite locally free of a fixed rank
precisely when its Fitting ideals jump from the zero ideal sheaf to the unit ideal sheaf at
that rank.

## Main definitions

There are no new definitions.

## Main results

* `AlgebraicGeometry.finiteLocallyFreeOfRank_tfae_fittingIdeal` gives the three equivalent
  characterizations in terms of finite local freeness and Fitting ideals.

## Implementation notes

The three entries of `List.TFAE` are the three numbered conditions in the source. Fitting
ideals here have natural-number indices. Accordingly, the source's condition at index `r - 1`
is automatic when `r = 0`, in accordance with the convention that Fitting ideals at negative
indices vanish.

The scheme-level statement is reduced to the module-level one, Tag 07ZD
(`finiteLocallyFreeOfRank_fittingIdeal_tfae`), on each affine open: both sides of the
equivalence are affine-local, and on an affine open the Fitting ideal sheaf
`AlgebraicGeometry.fittingIdeal` is the Fitting ideal of the module of sections, while finite
local freeness of a fixed rank is that of the module of sections.

The module-theoretic Fitting ideal `_root_.fittingIdeal` presupposes a finiteness instance on
the module, which is not available while the Fitting conditions are still being assumed. The
private `AlgebraicGeometry.moduleFittingIdeal` therefore spells out the same ideal — the span of
the maximal minors of the relation matrices of all finite free presentations — for an arbitrary
module, and `AlgebraicGeometry.cardFit_eq_stdFit` identifies the two as soon as the module is
finite.

## References

* [Stacks Project, Tag 0C3G](https://stacks.math.columbia.edu/tag/0C3G)
-/

@[expose] public section

universe u v

open CategoryTheory

namespace AlgebraicGeometry

/-- The ideal generated by the `(n - k)`-minors of the relation matrices of all finite free
presentations of a module. It agrees with `_root_.fittingIdeal` as soon as the module is finite,
but unlike `_root_.fittingIdeal` it is defined without a finiteness hypothesis. -/
@[sga "7 VI 4.16"]
private noncomputable def moduleFittingIdeal (R : Type u) (M : Type v)
    [CommRing R] [AddCommGroup M] [Module R M] (k : ℕ) : Ideal R :=
  Ideal.span {x | ∃ (n : ℕ) (g : (Fin n → R) →ₗ[R] M),
    Function.Surjective g ∧ ∃ (rows : Fin (n - k) → Fin n)
      (cols : Fin (n - k) → LinearMap.ker g), Function.Injective rows ∧
        Function.Injective cols ∧
          x = Matrix.det (fun i j => (cols j : Fin n → R) (rows i))}

/-- The relation matrix of a finite free presentation: its columns are indexed by the kernel. -/
private def relMat {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M]
    [Module R M] {n : ℕ} (f : (Fin n → R) →ₗ[R] M) : Matrix (Fin n) (LinearMap.ker f) R :=
  fun i j => j.1 i

private lemma relSpan {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M]
    [Module R M] {n : ℕ} (f : (Fin n → R) →ₗ[R] M) :
    Submodule.span R (Set.range fun j : LinearMap.ker f => fun i : Fin n => (relMat f) i j) =
      LinearMap.ker f := by
  refine le_antisymm (Submodule.span_le.2 ?_) fun x hx => Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
  rintro x ⟨j, rfl⟩
  exact j.2

private noncomputable def relQuotEquiv {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M) (hf : Function.Surjective f) :
    ((Fin n → R) ⧸ Submodule.span R
      (Set.range fun j : LinearMap.ker f => fun i : Fin n => (relMat f) i j)) ≃ₗ[R] M :=
  (Submodule.Quotient.equiv _ _ (LinearEquiv.refl R _) (by simpa using relSpan f)).trans
    (LinearMap.quotKerEquivOfSurjective f hf)

private lemma cardFit_eq_stdFit {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] (r : ℕ) :
    moduleFittingIdeal R M r = _root_.fittingIdeal (R := R) (M := M) (r : ℤ) := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  let A := relMat f
  have hfq := relQuotEquiv f hf
  have hstd : _root_.fittingIdeal (R := R) (M := M) (r : ℤ) = minorIdeal A (n - r) :=
    fittingIdeal_eq_minorIdeal_of_presentation A r hfq
  rw [hstd]
  apply le_antisymm
  · rw [moduleFittingIdeal, Ideal.span_le]
    rintro x ⟨m, g, hg, rows, cols, hr, hc, rfl⟩
    rw [← minorIdeal_eq_of_quotientLinearEquiv (relMat g) A r
      ((relQuotEquiv g hg).trans hfq.symm), minorIdeal]
    exact Ideal.subset_span ⟨rows, cols, rfl⟩
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨rows, cols, rfl⟩
    by_cases hr : Function.Injective rows
    · by_cases hc : Function.Injective cols
      · rw [moduleFittingIdeal]
        exact Ideal.subset_span ⟨n, f, hf, rows, cols, hr, hc, rfl⟩
      · obtain ⟨i, j, hcols, hij⟩ := Function.not_injective_iff.mp hc
        have hdet : (A.submatrix rows cols).det = 0 :=
          Matrix.det_zero_of_column_eq hij fun k => by simp [Matrix.submatrix, hcols]
        rw [hdet]
        exact Ideal.zero_mem _
    · obtain ⟨i, j, hrows, hij⟩ := Function.not_injective_iff.mp hr
      have hdet : (A.submatrix rows cols).det = 0 :=
        Matrix.det_zero_of_row_eq hij (by ext k; simp [Matrix.submatrix, hrows])
      rw [hdet]
      exact Ideal.zero_mem _

private lemma moduleTFAE {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] (r : ℕ) :
    List.TFAE [
      Module.IsFiniteLocallyFreeOfRank R M r,
      (r = 0 ∨ moduleFittingIdeal R M (r - 1) = ⊥) ∧
        moduleFittingIdeal R M r = ⊤,
      (∀ k < r, moduleFittingIdeal R M k = ⊥) ∧
        (∀ k, r ≤ k → moduleFittingIdeal R M k = ⊤)] := by
  let P2 := _root_.fittingIdeal (R := R) (M := M) ((r : ℤ) - 1) = ⊥ ∧
    _root_.fittingIdeal (R := R) (M := M) (r : ℤ) = ⊤
  let P3 := (∀ k : ℤ, k < r → _root_.fittingIdeal (R := R) (M := M) k = ⊥) ∧
    (∀ k : ℤ, (r : ℤ) ≤ k → _root_.fittingIdeal (R := R) (M := M) k = ⊤)
  have hpair : P2 ↔
      ((r = 0 ∨ moduleFittingIdeal R M (r - 1) = ⊥) ∧
        moduleFittingIdeal R M r = ⊤) := by
    constructor
    · rintro ⟨hpred, hr⟩
      refine ⟨or_iff_not_imp_left.mpr fun hzero => ?_,
        (cardFit_eq_stdFit (R := R) (M := M) r).trans hr⟩
      have hindex : ((r : ℤ) - 1) = ((r - 1 : ℕ) : ℤ) := by omega
      exact (cardFit_eq_stdFit (R := R) (M := M) (r - 1)).trans (by simpa [hindex] using hpred)
    · rintro ⟨hpred, hr⟩
      refine ⟨?_, (cardFit_eq_stdFit (R := R) (M := M) r).symm.trans hr⟩
      by_cases hzero : r = 0
      · subst r
        simp [_root_.fittingIdeal]
      · have hindex : ((r : ℤ) - 1) = ((r - 1 : ℕ) : ℤ) := by omega
        rw [hindex, ← cardFit_eq_stdFit (R := R) (M := M) (r - 1)]
        exact hpred.resolve_left hzero
  have hall : P3 ↔
      ((∀ k < r, moduleFittingIdeal R M k = ⊥) ∧
        (∀ k, r ≤ k → moduleFittingIdeal R M k = ⊤)) := by
    constructor
    · rintro ⟨hbot, htop⟩
      refine ⟨fun k hk => ?_, fun k hk => ?_⟩ <;> rw [cardFit_eq_stdFit]
      · exact hbot (k : ℤ) (by exact_mod_cast hk)
      · exact htop (k : ℤ) (by exact_mod_cast hk)
    · rintro ⟨hbot, htop⟩
      refine ⟨fun k hk => ?_, fun k hk => ?_⟩
      · by_cases hk0 : 0 ≤ k
        · rw [← Int.toNat_of_nonneg hk0, ← cardFit_eq_stdFit]
          exact hbot k.toNat (by omega)
        · simp [_root_.fittingIdeal, show k < 0 by omega]
      · rw [← Int.toNat_of_nonneg (show 0 ≤ k by omega), ← cardFit_eq_stdFit]
        exact htop k.toNat (by omega)
  have hstd := finiteLocallyFreeOfRank_fittingIdeal_tfae (R := R) (M := M) r
  tfae_have 1 ↔ 2 := (hstd.out 1 2).trans hpair
  tfae_have 2 ↔ 3 := hpair.symm.trans ((hstd.out 2 3).trans hall)
  tfae_finish

/-- Over the zero ring every module is finite. -/
private lemma moduleFinite_of_subsingleton (R : Type u) (M : Type v) [CommRing R]
    [AddCommGroup M] [Module R M] [Subsingleton R] : Module.Finite R M := by
  have := Module.subsingleton R M
  infer_instance

private lemma moduleFinite_of_cardFit_top {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] (r : ℕ)
    (hfit : moduleFittingIdeal R M r = ⊤) : Module.Finite R M := by
  classical
  rcases subsingleton_or_nontrivial R with _ | _
  · exact moduleFinite_of_subsingleton R M
  · let S : Set R := {x | ∃ (n : ℕ) (g : (Fin n → R) →ₗ[R] M),
      Function.Surjective g ∧ ∃ (rows : Fin (n - r) → Fin n)
        (cols : Fin (n - r) → LinearMap.ker g), Function.Injective rows ∧
        Function.Injective cols ∧ x = Matrix.det (fun i j => (cols j : Fin n → R) (rows i))}
    have hfit' : Ideal.span S = (⊤ : Ideal R) := by
      simpa [S, moduleFittingIdeal] using hfit
    have hne : Ideal.span S ≠ (⊥ : Ideal R) := hfit' ▸ top_ne_bot
    obtain ⟨_, n, g, hg, _⟩ : S.Nonempty :=
      Set.nonempty_iff_ne_empty.mpr fun h => hne (by rw [h, Ideal.span_empty])
    exact Module.Finite.of_surjective g hg

private lemma moduleFinite_of_isFiniteLocallyFreeOfRank {R : Type u} {M : Type v}
    [CommRing R] [AddCommGroup M] [Module R M] (r : ℕ)
    (h : Module.IsFiniteLocallyFreeOfRank R M r) : Module.Finite R M := by
  obtain ⟨ι, f, hspan, hbasis⟩ := h
  refine Module.Finite.of_localizationSpan (Set.range f) hspan ?_
  rintro ⟨_, i, rfl⟩
  exact Module.Finite.of_basis (hbasis i).some


/-- The free sheaf of modules on an open subscheme is the image of the free sheaf on the
slice over that open. -/
private noncomputable def freeOverEquivIsoX
    (X : Scheme.{u}) (U : X.Opens) (I : Type u) :
    SheafOfModules.free (R := (U : Scheme).ringCatSheaf) I ≅
      (AlgebraicGeometry.Scheme.Modules.overEquiv U).functor.obj
        (SheafOfModules.free (R := X.ringCatSheaf.over U) I) := by
  let F := (AlgebraicGeometry.Scheme.Modules.overEquiv U).functor
  haveI : Limits.PreservesColimitsOfShape.{u, u} (Discrete I) F :=
    Functor.instPreservesColimitsOfShapeOfIsLeftAdjoint.{u, u, u, u + 1, u, u + 1} F
  exact @SheafOfModules.mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _ F I this (Iso.refl _)

/-- Reindexing the basis of a free sheaf of modules along an equivalence of index types. -/
private noncomputable def freeReindexIso
    {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{u}} [HasWeakSheafify J AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}] {I K : Type u} (e : I ≃ K) :
    SheafOfModules.free (R := R) I ≅ SheafOfModules.free K where
  hom := SheafOfModules.freeMap e
  inv := SheafOfModules.freeMap e.symm
  hom_inv_id := by
    apply (SheafOfModules.freeHomEquiv (SheafOfModules.free (R := R) I)).injective
    funext i
    rw [SheafOfModules.freeHomEquiv_comp_apply,
      SheafOfModules.freeHomEquiv_freeMap,
      Function.comp_apply, SheafOfModules.sectionMap_freeMap_freeSection]
    simp [SheafOfModules.freeSection]
  inv_hom_id := by
    apply (SheafOfModules.freeHomEquiv (SheafOfModules.free (R := R) K)).injective
    funext i
    rw [SheafOfModules.freeHomEquiv_comp_apply,
      SheafOfModules.freeHomEquiv_freeMap,
      Function.comp_apply, SheafOfModules.sectionMap_freeMap_freeSection]
    simp [SheafOfModules.freeSection]

private lemma schemeRank_to_cardRank
    (X : Scheme.{u}) (F : X.Modules) (r : ℕ)
    (h : Scheme.Modules.IsFiniteLocallyFreeOfRank F r) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank
      (C := TopologicalSpace.Opens X) (J := Opens.grothendieckTopology X) F r := by
  classical
  choose U hx e using h
  let q : F.LocalGeneratorsData.{u} :=
    { I := X
      X := U
      coversTop := by
        rw [Opens.coversTop_iff, TopologicalSpace.IsOpenCover, eq_top_iff]
        intro x _
        simp only [TopologicalSpace.Opens.mem_iSup]
        exact ⟨x, hx x⟩
      generators := fun x ↦ by
        let T := (AlgebraicGeometry.Scheme.Modules.overEquiv (U x)).functor
        let eFree : SheafOfModules.free (R := ((U x : X.Opens) : Scheme).ringCatSheaf)
            (ULift (Fin r)) ≅ T.obj (SheafOfModules.free
              (R := X.ringCatSheaf.over (U x)) (ULift (Fin r))) :=
          freeOverEquivIsoX X (U x) (ULift (Fin r))
        let eOver : SheafOfModules.free (R := X.ringCatSheaf.over (U x)) (ULift (Fin r)) ≅
            F.over (U x) :=
          T.preimageIso (eFree.symm ≪≫ (e x).some.symm ≪≫
            ((AlgebraicGeometry.Scheme.Modules.overFunctorEquiv (U x)).app F).symm)
        exact (SheafOfModules.free.generatingSections (ULift (Fin r))).equivOfIso eOver }
  have hfree : q.IsLocallyFreeData := by
    refine { isIso := ?_ }
    intro i
    dsimp [q]
    apply Stacks.FiniteLocallyFree.ModuleTFAE.isIso_generatingSections_equivOfIso
  refine AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.mk.{u, u}
    (C := TopologicalSpace.Opens X)
    (J := Opens.grothendieckTopology X) (R := X.ringCatSheaf) (M := F) (r := r)
    ⟨q, hfree, fun _ => ⟨Equiv.ulift⟩⟩

private lemma cardRank_to_schemeRank
    (X : Scheme.{u}) (F : X.Modules) (r : ℕ)
    (h : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank
      (C := TopologicalSpace.Opens X) (J := Opens.grothendieckTopology X) F r) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank F r := by
  classical
  obtain ⟨q, hfree, hrank⟩ := h.exists_isFiniteLocallyFreeOfRankData
  intro x
  have hc := q.coversTop
  rw [Opens.coversTop_iff] at hc
  have hx : x ∈ ⨆ i, q.X i := by rw [hc]; trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  let T := (AlgebraicGeometry.Scheme.Modules.overEquiv (q.X i)).functor
  let eReindex : SheafOfModules.free (R := X.ringCatSheaf.over (q.X i))
      (q.generators i).I ≅ SheafOfModules.free (R := X.ringCatSheaf.over (q.X i))
      (ULift (Fin r)) :=
    freeReindexIso (R := X.ringCatSheaf.over (q.X i))
      ((hrank i).some.trans Equiv.ulift.symm)
  let eFree := freeOverEquivIsoX X (q.X i) (ULift (Fin r))
  let : IsIso (q.generators i).π := hfree.isIso i
  exact ⟨q.X i, hi, ⟨(eFree ≪≫ T.mapIso eReindex.symm ≪≫
    T.mapIso (asIso (q.generators i).π) ≪≫
    (AlgebraicGeometry.Scheme.Modules.overFunctorEquiv (q.X i)).app F).symm⟩⟩

private lemma schemeRank_iso {X : Scheme.{u}} (F G : X.Modules) (r : ℕ)
    (e : F ≅ G) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank F r ↔
      Scheme.Modules.IsFiniteLocallyFreeOfRank G r := by
  refine ⟨fun h x => ?_, fun h x => ?_⟩ <;> obtain ⟨U, hx, ⟨eU⟩⟩ := h x
  · exact ⟨U, hx, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso e.symm ≪≫ eU⟩⟩
  · exact ⟨U, hx, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso e ≪≫ eU⟩⟩

/-- The free sheaf of modules on an open subscheme is the restriction of the free sheaf. -/
private noncomputable def freeRestrictIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (I : Type u) :
    SheafOfModules.free (R := X.ringCatSheaf) I ≅
      (Scheme.Modules.restrictFunctor f).obj (SheafOfModules.free (R := Y.ringCatSheaf) I) := by
  let G := Scheme.Modules.restrictFunctor f
  haveI : Limits.PreservesColimitsOfShape.{u, u} (Discrete I) G :=
    Functor.instPreservesColimitsOfShapeOfIsLeftAdjoint.{u, u, u, u + 1, u, u + 1} G
  exact @SheafOfModules.mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _ G I this
    (Scheme.Modules.restrictUnitIso f).symm

private lemma schemeRank_pullback_of_openImmersion
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (F : Y.Modules) (r : ℕ)
    (h : Scheme.Modules.IsFiniteLocallyFreeOfRank F r) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank ((Scheme.Modules.pullback f).obj F) r := by
  intro x
  obtain ⟨U, hx, ⟨eRank⟩⟩ := h (f x)
  let V := f ⁻¹ᵁ U
  let g := f ∣_ U
  let p : V.toScheme.Modules := ((Scheme.Modules.pullback f).obj F).restrict V.ι
  refine ⟨V, hx, ?_⟩
  let e0 := (Scheme.Modules.restrictFunctorIsoPullback V.ι).app ((Scheme.Modules.pullback f).obj F)
  have hEq : V.ι ≫ f = g ≫ U.ι := (morphismRestrict_ι f U).symm
  have : IsOpenImmersion g := inferInstance
  let e01 := (Scheme.Modules.restrictFunctorIsoPullback f).app F
  let e12 := (Scheme.Modules.restrictFunctorComp V.ι f).app F
  let e23 := Scheme.Modules.restrictFunctorCongr hEq
  let e34 := (Scheme.Modules.restrictFunctorComp g U.ι).app F
  let eFree := freeRestrictIso g (ULift (Fin r))
  let e : p ≅ (Scheme.Modules.restrictFunctor g).obj
      ((Scheme.Modules.restrictFunctor U.ι).obj F) :=
    e0 ≪≫ ((Scheme.Modules.restrictFunctorIsoPullback V.ι).app _).symm ≪≫
      (Scheme.Modules.restrictFunctor V.ι).mapIso e01.symm ≪≫
      e12.symm ≪≫ (e23.app F) ≪≫ e34
  exact ⟨e ≪≫ (Scheme.Modules.restrictFunctor g).mapIso eRank ≪≫ eFree.symm⟩

private lemma schemeRank_pullback_of_iso {X Y : Scheme.{u}} (e : X ≅ Y)
    (F : X.Modules) (r : ℕ) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank F r ↔
      Scheme.Modules.IsFiniteLocallyFreeOfRank ((Scheme.Modules.pullback e.inv).obj F) r := by
  refine ⟨schemeRank_pullback_of_openImmersion e.inv F r, fun h => ?_⟩
  let e' := (Scheme.Modules.pullbackComp e.hom e.inv).app F ≪≫
    (Scheme.Modules.pullbackCongr e.hom_inv_id).app F ≪≫
    (Scheme.Modules.pullbackId X).app F
  exact (schemeRank_iso _ _ r e').mp (schemeRank_pullback_of_openImmersion e.hom _ r h)

private lemma moduleRank_of_linearEquiv {R : Type u} {M N : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) (r : ℕ) :
    Module.IsFiniteLocallyFreeOfRank R M r →
      Module.IsFiniteLocallyFreeOfRank R N r := by
  rintro ⟨ι, f, hcover, hbasis⟩
  refine ⟨ι, f, hcover, fun i ↦ ?_⟩
  let S := Submonoid.powers (f i)
  let eLoc : LocalizedModule S M ≃ₗ[Localization S] LocalizedModule S N :=
    LinearEquiv.ofBijective (LocalizedModule.map S e.toLinearMap)
      ⟨LocalizedModule.map_injective S e.toLinearMap e.injective,
        LocalizedModule.map_surjective S e.toLinearMap e.surjective⟩
  exact ⟨(hbasis i).some.map eLoc⟩

private lemma moduleRank_iso {R : Type u} {M N : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) (r : ℕ) :
    Module.IsFiniteLocallyFreeOfRank R M r ↔
      Module.IsFiniteLocallyFreeOfRank R N r :=
  ⟨moduleRank_of_linearEquiv e r, moduleRank_of_linearEquiv e.symm r⟩

private lemma schemeRank_at_of_restrict
    {X : Scheme.{u}} (F : X.Modules) (U : X.Opens) [IsOpenImmersion U.ι]
    (x : X) (hx : x ∈ U) (r : ℕ)
    (h : Scheme.Modules.IsFiniteLocallyFreeOfRank
      ((Scheme.Modules.restrictFunctor U.ι).obj F) r) :
    ∃ V : X.Opens, x ∈ V ∧ Nonempty (F.restrict V.ι ≅
      SheafOfModules.free (R := V.toScheme.ringCatSheaf) (ULift (Fin r))) := by
  let FU := (Scheme.Modules.restrictFunctor U.ι).obj F
  let xU : U.toScheme := ⟨x, hx⟩
  obtain ⟨W, hxW, ⟨eFreeWitness⟩⟩ := h xU
  let w : W.toScheme := ⟨xU, hxW⟩
  let j := W.ι ≫ U.ι
  let V := j.opensRange
  have : IsOpenImmersion W.ι := inferInstance
  have : IsOpenImmersion j := inferInstance
  let eRange : W.toScheme ≅ V.toScheme := j.isoOpensRange
  have hmem : x ∈ V := ⟨w, rfl⟩
  let eComp := (Scheme.Modules.restrictFunctorComp W.ι U.ι).app F
  let hfac : eRange.hom ≫ V.ι = j := Scheme.Hom.isoOpensRange_hom_ι j
  let eCongr := (Scheme.Modules.restrictFunctorCongr hfac.symm).app F
  let eCompRange := (Scheme.Modules.restrictFunctorComp eRange.hom V.ι).app F
  let eNested : (F.restrict V.ι).restrict eRange.hom ≅ FU.restrict W.ι :=
    (eCongr ≪≫ eCompRange).symm ≪≫ eComp
  let ePullId := (Scheme.Modules.restrictFunctorCongr eRange.inv_hom_id).app
      (F.restrict V.ι) ≪≫
    (Scheme.Modules.restrictFunctorId).app (F.restrict V.ι)
  let ePullComp := (Scheme.Modules.restrictFunctorComp eRange.inv eRange.hom).app
    (F.restrict V.ι)
  let eRestore : F.restrict V.ι ≅
      (Scheme.Modules.restrictFunctor eRange.inv).obj
        ((Scheme.Modules.restrictFunctor eRange.hom).obj (F.restrict V.ι)) :=
    ePullId.symm ≪≫ ePullComp
  let eResult : F.restrict V.ι ≅
      SheafOfModules.free (R := V.toScheme.ringCatSheaf) (ULift (Fin r)) := by
    let eOnW : (F.restrict V.ι).restrict eRange.hom ≅
        SheafOfModules.free (R := W.toScheme.ringCatSheaf) (ULift (Fin r)) :=
      eNested ≪≫ eFreeWitness
    exact eRestore ≪≫ (Scheme.Modules.restrictFunctor eRange.inv).mapIso eOnW ≪≫
      (freeRestrictIso eRange.inv (ULift (Fin r))).symm
  exact ⟨V, hmem, ⟨eResult⟩⟩

private lemma schemeRank_spec_iff_moduleSections
    {R : Type u} [CommRing R] (G : (Spec (CommRingCat.of R)).Modules)
    [G.IsQuasicoherent] (r : ℕ) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank G r ↔
      Module.IsFiniteLocallyFreeOfRank R
        (AlgebraicGeometry.moduleSpecΓFunctor.obj G) r := by
  have : IsIso G.fromTildeΓ := Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent G
  let M := AlgebraicGeometry.moduleSpecΓFunctor.obj G
  exact (schemeRank_iso G (AlgebraicGeometry.tilde M) r (asIso G.fromTildeΓ).symm).trans
    (tilde_isFiniteLocallyFreeOfRank_iff R (↑M) r)

private lemma schemeRank_restrict_affineOpen_iff_sections
    {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent]
    (U : X.affineOpens) (r : ℕ) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank
        ((Scheme.Modules.restrictFunctor U.1.ι).obj F) r ↔
      Module.IsFiniteLocallyFreeOfRank Γ(X, U.1) Γ(F, U.1) r := by
  let f := U.2.fromSpec
  have : IsOpenImmersion f := U.2.isOpenImmersion_fromSpec
  let G := (Scheme.Modules.restrictFunctor f).obj F
  have : G.IsQuasicoherent := inferInstance
  let e : Spec (CommRingCat.of Γ(X, U.1)) ≅ U.1.toScheme :=
    IsOpenImmersion.isoOfRangeEq f U.1.ι
      (U.2.range_fromSpec.trans U.1.range_ι.symm)
  have hfac : e.hom ≫ U.1.ι = f :=
    IsOpenImmersion.isoOfRangeEq_hom_fac f U.1.ι _
  let eComp := (Scheme.Modules.restrictFunctorComp e.hom U.1.ι).app F
  let eCongr := (Scheme.Modules.restrictFunctorCongr hfac).app F
  let eGE : G ≅ (Scheme.Modules.restrictFunctor e.hom).obj
      ((Scheme.Modules.restrictFunctor U.1.ι).obj F) := eCongr.symm ≪≫ eComp
  let ePull := (Scheme.Modules.restrictFunctorIsoPullback e.hom).app
      ((Scheme.Modules.restrictFunctor U.1.ι).obj F)
  have hRankU : Scheme.Modules.IsFiniteLocallyFreeOfRank
        ((Scheme.Modules.restrictFunctor U.1.ι).obj F) r ↔
      Scheme.Modules.IsFiniteLocallyFreeOfRank G r :=
    (schemeRank_pullback_of_iso e.symm
      ((Scheme.Modules.restrictFunctor U.1.ι).obj F) r).trans
      (schemeRank_iso G ((Scheme.Modules.pullback e.hom).obj
        ((Scheme.Modules.restrictFunctor U.1.ι).obj F)) r
        (eGE ≪≫ ePull)).symm
  let eSect := affineSectionsLinearEquiv F U.2
  let M := AlgebraicGeometry.moduleSpecΓFunctor.obj G
  have hSect : Module.IsFiniteLocallyFreeOfRank Γ(X, U.1) M r ↔
      Module.IsFiniteLocallyFreeOfRank Γ(X, U.1) Γ(F, U.1) r :=
    moduleRank_iso eSect r
  exact hRankU.trans ((schemeRank_spec_iff_moduleSections G r).trans hSect)

/-- The second condition of Tag 0C3G for a module: the Fitting ideals jump from zero to the
unit ideal at `r`. -/
private def moduleCondition2 {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] (r : ℕ) : Prop :=
  (r = 0 ∨ moduleFittingIdeal R M (r - 1) = ⊥) ∧
    moduleFittingIdeal R M r = ⊤

/-- The third condition of Tag 0C3G for a module: the Fitting ideals vanish below `r` and are
the unit ideal from `r` onwards. -/
private def moduleCondition3 {R : Type u} {M : Type v} [CommRing R]
    [AddCommGroup M] [Module R M] (r : ℕ) : Prop :=
  (∀ k < r, moduleFittingIdeal R M k = ⊥) ∧
    (∀ k, r ≤ k → moduleFittingIdeal R M k = ⊤)

private lemma moduleFinite_of_fittingComponent_top
    {X : Scheme.{u}} (F : X.Modules) (U : X.affineOpens) (k : ℤ)
    (h : (AlgebraicGeometry.fittingIdeal F k).ideal U = ⊤) :
    Module.Finite Γ(X, U.1) Γ(F, U.1) := by
  classical
  let R := Γ(X, U.1)
  let M := Γ(F, U.1)
  rcases subsingleton_or_nontrivial R with _ | _
  · exact moduleFinite_of_subsingleton R M
  · by_contra hfinite
    have hle : (AlgebraicGeometry.fittingIdeal F k).ideal U ≤ (⊥ : Ideal R) := by
      have hle' := Scheme.IdealSheafData.ideal_ofIdeals_le
        (fun V : X.affineOpens =>
          if hV : Module.Finite Γ(X, V.1) Γ(F, V.1) then
            have := hV
            _root_.fittingIdeal (M := Γ(F, V.1)) k
          else ⊥) U
      simpa [AlgebraicGeometry.fittingIdeal, hfinite] using hle'
    exact bot_ne_top ((le_antisymm hle bot_le).symm.trans h)

private lemma affine_component_fit_eq
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (U : X.affineOpens) [Module.Finite Γ(X, U.1) Γ(F, U.1)] (k : ℕ) :
    (AlgebraicGeometry.fittingIdeal F (k : ℤ)).ideal U =
      moduleFittingIdeal Γ(X, U.1) Γ(F, U.1) k := by
  rw [AlgebraicGeometry.fittingIdeal_ideal]
  exact (cardFit_eq_stdFit (R := Γ(X, U.1)) (M := Γ(F, U.1)) k).symm

/-- If the `r`-th Fitting ideal sheaf is trivial on `U`, then the module Fitting ideals of the
sections over `U` are the sections of the Fitting ideal sheaves. -/
private lemma moduleFit_eq_of_sheaf_eq
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (U : X.affineOpens) (r k : ℕ) {I : Ideal Γ(X, U.1)}
    (hr : (AlgebraicGeometry.fittingIdeal F (r : ℤ)).ideal U = ⊤)
    (h : (AlgebraicGeometry.fittingIdeal F (k : ℤ)).ideal U = I) :
    moduleFittingIdeal Γ(X, U.1) Γ(F, U.1) k = I := by
  let : Module.Finite Γ(X, U.1) Γ(F, U.1) := moduleFinite_of_fittingComponent_top F U r hr
  exact (affine_component_fit_eq F U k).symm.trans h

/-- If the `r`-th module Fitting ideal of the sections over `U` is trivial, then the Fitting
ideal sheaves on `U` are the module Fitting ideals of the sections. -/
private lemma sheaf_eq_of_moduleFit_eq
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (U : X.affineOpens) (r k : ℕ) {I : Ideal Γ(X, U.1)}
    (hr : moduleFittingIdeal Γ(X, U.1) Γ(F, U.1) r = ⊤)
    (h : moduleFittingIdeal Γ(X, U.1) Γ(F, U.1) k = I) :
    (AlgebraicGeometry.fittingIdeal F (k : ℤ)).ideal U = I := by
  let : Module.Finite Γ(X, U.1) Γ(F, U.1) := moduleFinite_of_cardFit_top r hr
  exact (affine_component_fit_eq F U k).trans h

private lemma schemeRank_iff_affineModuleRank
    {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent] (r : ℕ) :
    Scheme.Modules.IsFiniteLocallyFreeOfRank F r ↔
      ∀ U : X.affineOpens,
        Module.IsFiniteLocallyFreeOfRank Γ(X, U.1) Γ(F, U.1) r := by
  refine ⟨fun h U => ?_, fun h x => ?_⟩
  · exact (schemeRank_restrict_affineOpen_iff_sections F U r).mp
      ((schemeRank_iso _ _ r ((Scheme.Modules.restrictFunctorIsoPullback U.1.ι).app F)).mpr
        (schemeRank_pullback_of_openImmersion U.1.ι F r h))
  · obtain ⟨_, ⟨U, hU, rfl⟩, hxU, _⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    obtain ⟨V, hxV, e⟩ := schemeRank_at_of_restrict F U x hxU r
      ((schemeRank_restrict_affineOpen_iff_sections F ⟨U, hU⟩ r).mpr (h ⟨U, hU⟩))
    exact ⟨V, hxV, e⟩

private lemma fittingCondition2_iff_affineModules
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    ((r = 0 ∨ AlgebraicGeometry.fittingIdeal F (r - 1) = ⊥) ∧
      AlgebraicGeometry.fittingIdeal F r = ⊤) ↔
    ∀ U : X.affineOpens,
      moduleCondition2 (R := Γ(X, U.1)) (M := Γ(F, U.1)) r := by
  constructor
  · rintro ⟨hpred, htop⟩ U
    have htopU : (AlgebraicGeometry.fittingIdeal F (r : ℤ)).ideal U = ⊤ := by simp [htop]
    refine ⟨or_iff_not_imp_left.mpr fun hr => ?_, moduleFit_eq_of_sheaf_eq F U r r htopU htopU⟩
    refine moduleFit_eq_of_sheaf_eq F U r (r - 1) htopU ?_
    rw [Nat.cast_pred (Nat.pos_of_ne_zero hr)]
    simp [hpred.resolve_left hr]
  · intro h
    refine ⟨or_iff_not_imp_left.mpr fun hr => Scheme.IdealSheafData.ext (funext fun U => ?_),
      Scheme.IdealSheafData.ext (funext fun U => ?_)⟩
    · have := sheaf_eq_of_moduleFit_eq F U r (r - 1) (h U).2 ((h U).1.resolve_left hr)
      rwa [Nat.cast_pred (Nat.pos_of_ne_zero hr)] at this
    · exact sheaf_eq_of_moduleFit_eq F U r r (h U).2 (h U).2

private lemma fittingCondition3_iff_affineModules
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    ((∀ k < r, AlgebraicGeometry.fittingIdeal F (k : ℤ) = ⊥) ∧
      (∀ k, r ≤ k → AlgebraicGeometry.fittingIdeal F (k : ℤ) = ⊤)) ↔
    ∀ U : X.affineOpens,
      moduleCondition3 (R := Γ(X, U.1)) (M := Γ(F, U.1)) r := by
  constructor
  · rintro ⟨hbot, htop⟩ U
    have htopU : (AlgebraicGeometry.fittingIdeal F (r : ℤ)).ideal U = ⊤ := by
      simp [htop r le_rfl]
    exact ⟨fun k hk => moduleFit_eq_of_sheaf_eq F U r k htopU (by simp [hbot k hk]),
      fun k hk => moduleFit_eq_of_sheaf_eq F U r k htopU (by simp [htop k hk])⟩
  · intro h
    exact ⟨fun k hk => Scheme.IdealSheafData.ext (funext fun U =>
        sheaf_eq_of_moduleFit_eq F U r k ((h U).2 r le_rfl) ((h U).1 k hk)),
      fun k hk => Scheme.IdealSheafData.ext (funext fun U =>
        sheaf_eq_of_moduleFit_eq F U r k ((h U).2 r le_rfl) ((h U).2 k hk))⟩

/-- **Stacks Project, Tag 0C3G.** A finite type quasicoherent module is finite
locally free of rank `r` if and only if its Fitting ideals vanish below `r`
and are the unit ideal from `r` onward. -/
@[stacks 0C3G]
public lemma finiteLocallyFreeOfRank_tfae_fittingIdeal
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    List.TFAE [
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank F r,
      (r = 0 ∨ AlgebraicGeometry.fittingIdeal F (r - 1) = ⊥) ∧
        AlgebraicGeometry.fittingIdeal F r = ⊤,
      (∀ k < r, AlgebraicGeometry.fittingIdeal F k = ⊥) ∧
        (∀ k, r ≤ k → AlgebraicGeometry.fittingIdeal F k = ⊤)] := by
  let P1 : X.affineOpens → Prop := fun U =>
    Module.IsFiniteLocallyFreeOfRank Γ(X, U.1) Γ(F, U.1) r
  let P2 : X.affineOpens → Prop := fun U =>
    moduleCondition2 (R := Γ(X, U.1)) (M := Γ(F, U.1)) r
  let P3 : X.affineOpens → Prop := fun U =>
    moduleCondition3 (R := Γ(X, U.1)) (M := Γ(F, U.1)) r
  have h1 : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank F r ↔ ∀ U, P1 U :=
    ⟨fun h => (schemeRank_iff_affineModuleRank F r).mp (cardRank_to_schemeRank X F r h),
      fun h => schemeRank_to_cardRank X F r ((schemeRank_iff_affineModuleRank F r).mpr h)⟩
  have h2 :
      ((r = 0 ∨ AlgebraicGeometry.fittingIdeal F (r - 1) = ⊥) ∧
        AlgebraicGeometry.fittingIdeal F r = ⊤) ↔ ∀ U, P2 U :=
    fittingCondition2_iff_affineModules F r
  have h3 :
      ((∀ k < r, AlgebraicGeometry.fittingIdeal F k = ⊥) ∧
        (∀ k, r ≤ k → AlgebraicGeometry.fittingIdeal F k = ⊤)) ↔ ∀ U, P3 U :=
    fittingCondition3_iff_affineModules F r
  have h12 : (∀ U, P1 U) ↔ (∀ U, P2 U) := by
    refine ⟨fun h U => ?_, fun h U => ?_⟩
    · let : Module.Finite Γ(X, U.1) Γ(F, U.1) := moduleFinite_of_isFiniteLocallyFreeOfRank r (h U)
      exact ((moduleTFAE (R := Γ(X, U.1)) (M := Γ(F, U.1)) r).out 1 2).mp (h U)
    · let : Module.Finite Γ(X, U.1) Γ(F, U.1) := moduleFinite_of_cardFit_top r (h U).2
      exact ((moduleTFAE (R := Γ(X, U.1)) (M := Γ(F, U.1)) r).out 1 2).mpr (h U)
  have h23 : (∀ U, P2 U) ↔ (∀ U, P3 U) := by
    refine ⟨fun h U => ?_, fun h U => ?_⟩
    · let : Module.Finite Γ(X, U.1) Γ(F, U.1) := moduleFinite_of_cardFit_top r (h U).2
      exact ((moduleTFAE (R := Γ(X, U.1)) (M := Γ(F, U.1)) r).out 2 3).mp (h U)
    · let : Module.Finite Γ(X, U.1) Γ(F, U.1) :=
        moduleFinite_of_cardFit_top r ((h U).2 r le_rfl)
      exact ((moduleTFAE (R := Γ(X, U.1)) (M := Γ(F, U.1)) r).out 2 3).mpr (h U)
  have hLocal : List.TFAE [∀ U, P1 U, ∀ U, P2 U, ∀ U, P3 U] := by
    tfae_have 1 ↔ 2 := h12
    tfae_have 2 ↔ 3 := h23
    tfae_finish
  tfae_have 1 ↔ 2 := h1.trans ((hLocal.out 1 2).trans h2.symm)
  tfae_have 2 ↔ 3 := h2.trans ((hLocal.out 2 3).trans h3.symm)
  tfae_finish

end AlgebraicGeometry

end
