-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open AlgebraicGeometry.Proj (degreeOpen)
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTwistSections

namespace Stacks.AlgebraicGeometry.MorphismsIntoProj

universe u w

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A]
  [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-! ### The open `U_d` -/

/-- The standard open of a homogeneous element of degree `d` lies in `U_d`, stated with the
degree-`d` element bundled as an element of `𝒜 d`. -/
theorem basicOpen_le_degreeOpen {d : ℕ} (f : 𝒜 d) :
    AlgebraicGeometry.Proj.basicOpen 𝒜 (f : A) ≤ degreeOpen 𝒜 d :=
  AlgebraicGeometry.Proj.basicOpen_le_degreeOpen 𝒜 f.2

/-- `U_d` lies in Tag 01MU's invertible locus `W_d`: each `D₊(f)` with `f` of degree `d` is one
of the opens `D₊(f g)` with `deg f = deg g + d`, taking `g = 1`. -/
theorem degreeOpen_le_whereInvertible (d : ℕ) :
    degreeOpen 𝒜 d ≤ ProjInvertibleLocus.whereInvertible 𝒜 d := by
  rw [GoodOpenClose.whereInvertible_eq_iSup_basicOpen_mul 𝒜 d]
  refine iSup_le fun f ↦ ?_
  let f' : 𝒜 (0 + d) := ⟨(f : A), by simp⟩
  let g : 𝒜 0 := ⟨1, SetLike.one_mem_graded 𝒜⟩
  calc
    AlgebraicGeometry.Proj.basicOpen 𝒜 (f : A)
        = AlgebraicGeometry.Proj.basicOpen 𝒜 ((f' : A) * (g : A)) := by simp [f', g]
    _ ≤ ⨆ (e : ℕ) (x : 𝒜 (e + d)) (y : 𝒜 e),
        AlgebraicGeometry.Proj.basicOpen 𝒜 ((x : A) * (y : A)) :=
      le_iSup_of_le 0 <| le_iSup_of_le f' <| le_iSup_of_le g le_rfl

/-- **The twists behave on `U_d`.** `U_d` is a good open in the sense of Tag 01MU: every twist
`𝒪(nd)` restricts to an invertible sheaf on it and every multiplication map between such
twists restricts to an isomorphism. -/
theorem isGoodOpen_degreeOpen (d : ℕ) :
    ProjInvertibleLocus.IsGoodOpen 𝒜 d (degreeOpen 𝒜 d) :=
  (GoodOpenClose.isGoodOpen_iff_le_whereInvertible 𝒜 d _).mpr
    (degreeOpen_le_whereInvertible 𝒜 d)

/-- The twist `𝒪_{U_d}(nd)` is an invertible sheaf on `U_d`. -/
theorem isInvertible_pullback_twistingSheaf_degreeOpen (d : ℕ) (n : ℤ) :
    SheafOfModules.IsInvertible (degreeOpen 𝒜 d).toScheme.presheaf
      (degreeOpen 𝒜 d).toScheme.ringCatSheaf.2
      ((Scheme.Modules.pullback (degreeOpen 𝒜 d).ι).obj
        (twistingSheaf 𝒜 ((d : ℤ) * n))) :=
  (isGoodOpen_degreeOpen 𝒜 d).1 n

/-- The multiplication map `𝒪(nd) ⊗ 𝒪(md) → 𝒪(nd + md)` restricts to an isomorphism on
`U_d`. -/
theorem isIso_restrict_twistMultiplicationMap_degreeOpen (d : ℕ) (n m : ℤ) :
    IsIso ((Scheme.Modules.restrictFunctor (degreeOpen 𝒜 d).ι).map
      (ProjInvertibleLocus.twistMultiplicationMap 𝒜 ((d : ℤ) * n) ((d : ℤ) * m))) :=
  (isGoodOpen_degreeOpen 𝒜 d).2 n m

/-! ### The pullback of the canonical graded map -/

section Pullback

variable {Y : Scheme.{u}} {d : ℕ}

/-- A morphism into the open subscheme `U_d`, read as a morphism into `Proj(S)`. -/
abbrev toProj (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) : Y ⟶ AlgebraicGeometry.Proj 𝒜 :=
  φ ≫ (degreeOpen 𝒜 d).ι

/-- The pullback `φ⁎𝒪_X(m)` of a twist along a morphism through `U_d`. -/
abbrev pullbackTwist (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (m : ℤ) : Y.Modules :=
  (Scheme.Modules.pullback (toProj 𝒜 φ)).obj (twistingSheaf 𝒜 m)

/-- **Equation 27.12.0.3, in degree `n`.** The degree-`n` component of `ψ^d_φ`: a homogeneous
element of `S` of degree `nd` is sent to the pullback along `φ` of the global section of
`𝒪_X(nd)` it defines. -/
def psiPullbackHom (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ) :
    𝒜 (n * d) →+ (pullbackTwist 𝒜 φ ((n * d : ℕ) : ℤ)).val.obj (op (⊤ : Y.Opens)) :=
  AddMonoidHom.mk'
    (fun a => pullbackSectionHom (toProj 𝒜 φ) (twistingSheaf 𝒜 ((n * d : ℕ) : ℤ)) ⊤ ⊤
      (by simp) (degreeSection 𝒜 (n * d) a))
    (fun a b => by
      rw [show degreeSection 𝒜 (n * d) (a + b) =
          degreeSection 𝒜 (n * d) a + degreeSection 𝒜 (n * d) b from
        map_add (degreeSectionHom 𝒜 (n * d)) a b]
      exact map_add _ _ _)

/-- The value of `ψ^d_φ` on a homogeneous element is the pullback of the corresponding global
section of `𝒪_X(nd)`. -/
theorem psiPullbackHom_apply (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ) (a : 𝒜 (n * d)) :
    psiPullbackHom 𝒜 φ n a =
      pullbackSectionHom (toProj 𝒜 φ) (twistingSheaf 𝒜 ((n * d : ℕ) : ℤ)) ⊤ ⊤ (by simp)
        (degreeSection 𝒜 (n * d) a) :=
  rfl

/-- The degree-`n` piece of the Veronese subring `S^{(d)}` consists of degree-`nd` elements
of `S`. -/
def veroneseToGrade (d n : ℕ) : Stacks.Veronese.veroneseGrading 𝒜 d n →+ 𝒜 (n * d) where
  toFun x := ⟨((x : Stacks.Veronese.veroneseSubring 𝒜 d) : A),
    Stacks.Veronese.mem_veroneseGrading 𝒜 |>.mp x.2⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- **Equation 27.12.0.3, in degree `n`, on the Veronese subring.** The degree-`n` component
of `ψ^d_φ : S^{(d)} ⟶ Γ_*(Y, φ⁎𝒪_X(d))`, sending a degree-`n` element of `S^{(d)}` to the
pullback along `φ` of the global section of `𝒪_X(nd)` it defines. -/
def psiPullbackVeroneseHom (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ) :
    Stacks.Veronese.veroneseGrading 𝒜 d n →+
      (pullbackTwist 𝒜 φ ((n * d : ℕ) : ℤ)).val.obj (op (⊤ : Y.Opens)) :=
  (psiPullbackHom 𝒜 φ n).comp (veroneseToGrade 𝒜 d n)

/-! ### Global generation of `φ⁎𝒪_X(d)` by the degree-one image -/

/-- The restriction map along `φ⁻¹⊤ = ⊤` that `AlgebraicGeometry.pullbackSectionHom` interposes
is the identity, so pulling a global section back to `⊤` is the map that the nonvanishing-locus
theory of Tag 0H78 is stated for. -/
private theorem pullbackSectionHom_top_eq_pullbackGlobalSection {X' X : Scheme.{u}} (f : X' ⟶ X)
    (M : X.Modules) (h : (⊤ : X'.Opens) ≤ f ⁻¹ᵁ (⊤ : X.Opens)) (s : Γ(M, ⊤)) :
    pullbackSectionHom f M ⊤ ⊤ h s =
      Stacks.NonvanishingPullback.pullbackGlobalSection f M s := by
  have key : ∀ (a : op (⊤ : X'.Opens) ⟶ op (⊤ : X'.Opens))
      (t : Γ((Scheme.Modules.pullback f).obj M, ⊤)),
      ((Scheme.Modules.pullback f).obj M).presheaf.map a t = t := fun a t => by
    rw [Subsingleton.elim a (𝟙 _),
      ((Scheme.Modules.pullback f).obj M).presheaf.map_id, ConcreteCategory.id_apply]
  change ((Scheme.Modules.pullback f).obj M).presheaf.map (homOfLE h).op
      (Stacks.NonvanishingPullback.pullbackGlobalSection f M s) = _
  exact key _ _

/-- **Tag 0H78 for `AlgebraicGeometry.pullbackSectionHom`.** The nonvanishing locus of the
pullback of a global section is the inverse image of its nonvanishing locus. -/
private theorem nonvanishingLocus_pullbackSectionHom {X' X : Scheme.{u}} (f : X' ⟶ X)
    (M : X.Modules) (h : (⊤ : X'.Opens) ≤ f ⁻¹ᵁ (⊤ : X.Opens)) (s : Γ(M, ⊤)) :
    Stacks.Ample.nonvanishingLocus ((Scheme.Modules.pullback f).obj M)
        (pullbackSectionHom f M ⊤ ⊤ h s) =
      f.base ⁻¹' Stacks.Ample.nonvanishingLocus M s := by
  rw [pullbackSectionHom_top_eq_pullbackGlobalSection]
  exact (Stacks.NonvanishingPullback.preimage_nonvanishingLocus f M s).symm

/-- **The nonvanishing locus of a degree-one value of `ψ^d_φ`.** For `f` homogeneous of degree
`d` the section `ψ^d_φ(f)` of `φ⁎𝒪_X(d)` is nonvanishing exactly on the inverse image of the
standard open `D₊(f)`: by Tag 0H78 that locus is the inverse image of the nonvanishing locus of
the global section of `𝒪_X(d)` attached to `f`, which is `D₊(f)` by Tag 01MV because `φ` lands in
the invertible locus of `d`. -/
theorem nonvanishingLocus_psiPullbackHom_one (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme)
    (f : 𝒜 (1 * d)) :
    Stacks.Ample.nonvanishingLocus (pullbackTwist 𝒜 φ ((1 * d : ℕ) : ℤ))
        (psiPullbackHom 𝒜 φ 1 f) =
      (toProj 𝒜 φ).base ⁻¹'
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (f : A) : Set (AlgebraicGeometry.Proj 𝒜)) :=
  Eq.trans
    (nonvanishingLocus_pullbackSectionHom (toProj 𝒜 φ)
      (twistingSheaf 𝒜 ((1 * d : ℕ) : ℤ)) (by simp) (degreeSection 𝒜 (1 * d) f))
    (Set.ext fun y =>
      Stacks.AlgebraicGeometry.CommonDegreeTwist.mem_nonvanishingLocus_degreeSection_iff'
        𝒜 d 1 f (degreeOpen_le_whereInvertible 𝒜 d (φ.base y).2))

/-- A homogeneous element of degree `d`, read as an element of degree one of the Veronese
subring `S^{(d)}`. -/
private def veroneseOfDegreeOne (d : ℕ) (f : 𝒜 (1 * d)) :
    Stacks.Veronese.veroneseGrading 𝒜 d 1 :=
  ⟨⟨(f : A), Subring.subset_closure (Set.mem_iUnion.mpr ⟨1, SetLike.mem_coe.mpr f.2⟩)⟩, f.2⟩

/-- **The degree-one image of `ψ^d_φ` has no common zero.** The nonvanishing loci of the sections
`ψ^d_φ(x)`, for `x` of Veronese degree one, cover `Y`: a point of `Y` maps into
`U_d = ⋃_{f ∈ S_d} D₊(f)`, and the section attached to such an `f` does not vanish on the inverse
image of `D₊(f)`. -/
theorem iUnion_nonvanishingLocus_psiPullbackVeroneseHom_one
    (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    ⋃ x : ↥(Stacks.Veronese.veroneseGrading 𝒜 d 1),
        Stacks.Ample.nonvanishingLocus (pullbackTwist 𝒜 φ ((1 * d : ℕ) : ℤ))
          (psiPullbackVeroneseHom 𝒜 φ 1 x) = Set.univ := by
  refine Set.eq_univ_of_forall fun y => ?_
  obtain ⟨g, hg⟩ := TopologicalSpace.Opens.mem_iSup.mp (φ.base y).2
  let f : 𝒜 (1 * d) := ⟨(g : A), by rw [one_mul]; exact g.2⟩
  exact Set.mem_iUnion.mpr ⟨veroneseOfDegreeOne 𝒜 d f,
    (nonvanishingLocus_psiPullbackHom_one 𝒜 φ f).ge hg⟩

/-- **`φ⁎𝒪_X(d)` is an invertible `𝒪_Y`-module.** The twist `𝒪_{U_d}(d)` is invertible on `U_d`
because `U_d` is a good open for `d`, and the inverse image of an invertible module is invertible
by Tag 0B8L; the two pullbacks are composed by the canonical comparison of inverse images along a
composite, and invertibility only depends on the isomorphism class. -/
theorem isInvertibleModule_pullbackTwist_one (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    Stacks.Ample.IsInvertibleModule Y (pullbackTwist 𝒜 φ ((1 * d : ℕ) : ℤ)) := by
  have hdeg : ((1 * d : ℕ) : ℤ) = (d : ℤ) * 1 := by push_cast; ring
  have h1 : Stacks.Ample.IsInvertibleModule (degreeOpen 𝒜 d).toScheme
      ((Scheme.Modules.pullback (degreeOpen 𝒜 d).ι).obj
        (twistingSheaf 𝒜 ((1 * d : ℕ) : ℤ))) := by
    rw [hdeg]
    exact isInvertible_pullback_twistingSheaf_degreeOpen 𝒜 d 1
  have h2 : Stacks.Ample.IsInvertibleModule Y
      ((Scheme.Modules.pullback (degreeOpen 𝒜 d).ι ⋙ Scheme.Modules.pullback φ).obj
        (twistingSheaf 𝒜 ((1 * d : ℕ) : ℤ))) :=
    Stacks.InvertiblePullback.isInvertibleModule_pullback φ _
  exact Stacks.SheafOfModules.isInvertible_of_iso _ _
    ((Scheme.Modules.pullbackComp φ (degreeOpen 𝒜 d).ι).app
      (twistingSheaf 𝒜 ((1 * d : ℕ) : ℤ)))

/-- **Stacks Project, Equation 27.12.0.3, global generation.** The invertible sheaf
`φ⁎𝒪_X(d)` is generated by the global sections in the image of the degree-one component
`(S^{(d)})_1 = S_d ⟶ Γ(Y, φ⁎𝒪_X(d))` of `ψ^d_φ`: every element of every stalk is an
`𝒪_{Y,y}`-combination of their germs. -/
theorem generatesStalks_psiPullbackVeroneseHom_one (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    Stacks.ProjectiveFromSections.GeneratesStalks
      (L := pullbackTwist 𝒜 φ ((1 * d : ℕ) : ℤ))
      (fun x : ↥(Stacks.Veronese.veroneseGrading 𝒜 d 1) =>
        psiPullbackVeroneseHom 𝒜 φ 1 x) := by
  have hinv : Stacks.Ample.IsInvertibleModule Y (pullbackTwist 𝒜 φ ((1 * d : ℕ) : ℤ)) :=
    isInvertibleModule_pullbackTwist_one 𝒜 φ
  intro y w
  obtain ⟨x, hx⟩ := Set.mem_iUnion.mp
    ((iUnion_nonvanishingLocus_psiPullbackVeroneseHom_one 𝒜 φ).symm.subset (Set.mem_univ y))
  obtain ⟨r, hr⟩ := Stacks.SectionProduct.exists_smul_Γgerm
    (pullbackTwist 𝒜 φ ((1 * d : ℕ) : ℤ)) (psiPullbackVeroneseHom 𝒜 φ 1 x) hx w
  exact ⟨{x}, fun _ => r, by rw [Finset.sum_singleton]; exact hr⟩

end Pullback

