module

public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Tactic.Abel

/-!
# Comparing abelian groups modulo `ℓ` and on `ℓ`-torsion

Elementary statements used to compare divisor class groups under extension of the base field:

* `AddMonoidHom.exists_sub_nsmul_eq_of_closure_eq_top`: if `G` is generated by elements of
  degree one which are congruent modulo `ℓ`, every element is congruent to a multiple of one of
  them;
* `AddMonoidHom.nsmul_comparison_of_degree`: a degree-preserving map between two such groups is
  bijective modulo `ℓ`;
* `AddMonoidHom.nsmul_torsion_comparison_of_quotient`: passing to quotients by a subgroup and its
  image preserves injectivity and surjectivity on `ℓ`-torsion.
-/

@[expose] public section

namespace AddMonoidHom

variable {G G' : Type*} [AddCommGroup G] [AddCommGroup G']

/-- **Generation by congruent elements of degree one.** If `G` is generated by a set `S` of
elements of degree one, all congruent to `x₀` modulo `ℓ`, then every `c` is congruent to
`deg c • x₀` modulo `ℓ`. -/
theorem exists_sub_nsmul_eq_of_closure_eq_top (deg : G →+ ℤ) (ℓ : ℕ) {S : Set G}
    (hS : AddSubgroup.closure S = ⊤) (x₀ : G) (hdeg : ∀ s ∈ S, deg s = 1)
    (hcong : ∀ s ∈ S, ∃ d, s - x₀ = ℓ • d) (c : G) : ∃ d, c - deg c • x₀ = ℓ • d := by
  let P : AddSubgroup G :=
    { carrier := {c | ∃ d, c - deg c • x₀ = ℓ • d}
      add_mem' := by
        rintro a b ⟨da, ha⟩ ⟨db, hb⟩
        refine ⟨da + db, ?_⟩
        rw [map_add, add_zsmul, nsmul_add, ← ha, ← hb]
        abel
      zero_mem' := ⟨0, by simp⟩
      neg_mem' := by
        rintro a ⟨d, hd⟩
        refine ⟨-d, ?_⟩
        rw [map_neg, neg_zsmul, neg_nsmul, ← hd]
        abel }
  have hle : S ⊆ P := fun s hs => by
    obtain ⟨d, hd⟩ := hcong s hs
    exact ⟨d, by rw [hdeg s hs, one_zsmul, hd]⟩
  have hc : c ∈ P := by
    have := (AddSubgroup.closure_le P).2 hle
    rw [hS] at this
    exact this (AddSubgroup.mem_top c)
  exact hc

/-- **A degree-preserving map is bijective modulo `ℓ`** between two groups in which every element
is congruent modulo `ℓ` to its degree times a fixed element of degree one (the second fixed element
being the image of the first). -/
theorem nsmul_comparison_of_degree (φ : G →+ G') (deg : G →+ ℤ) (deg' : G' →+ ℤ) (ℓ : ℕ)
    (hφ : ∀ c, deg' (φ c) = deg c) (x₀ : G)
    (hG : ∀ c, ∃ d, c - deg c • x₀ = ℓ • d) (hG' : ∀ c', ∃ d', c' - deg' c' • φ x₀ = ℓ • d') :
    (∀ c c', ℓ • c' = φ c → ∃ d, ℓ • d = c) ∧ (∀ c', ∃ c d', c' = φ c + ℓ • d') := by
  refine ⟨fun c c' h => ?_, fun c' => ?_⟩
  · obtain ⟨d, hd⟩ := hG c
    have hdeg : deg c = (ℓ : ℤ) * deg' c' := by
      rw [← hφ, ← h, map_nsmul, nsmul_eq_mul]
    refine ⟨deg' c' • x₀ + d, ?_⟩
    rw [nsmul_add, ← hd, hdeg, mul_zsmul, natCast_zsmul]
    abel
  · obtain ⟨d', hd'⟩ := hG' c'
    exact ⟨deg' c' • x₀, d', by rw [map_zsmul, ← hd']; abel⟩

/-- **Quotients preserve the comparison on `ℓ`-torsion.** Let `φ̄ : G → G'` be injective, injective
modulo `ℓ`, and surjective on `ℓ`-torsion, let `π : G → H` and `π' : G' → H'` be surjective with
kernels `N` and `φ̄(N)`, and `φ : H → H'` with `φ ∘ π = π' ∘ φ̄`. Then `φ` is injective, and
surjective on `ℓ`-torsion. -/
theorem nsmul_torsion_comparison_of_quotient {H H' : Type*} [AddCommGroup H] [AddCommGroup H']
    (φ' : G →+ G') (π : G →+ H) (π' : G' →+ H') (φ : H →+ H') (ℓ : ℕ) (N : AddSubgroup G)
    (hinj : Function.Injective φ') (hQ : ∀ c c', ℓ • c' = φ' c → ∃ d, ℓ • d = c)
    (hT : ∀ c', ℓ • c' = 0 → ∃ c, ℓ • c = 0 ∧ φ' c = c')
    (hπ : Function.Surjective π) (hπ' : Function.Surjective π') (hker : π.ker = N)
    (hker' : π'.ker = N.map φ') (hcomm : ∀ c, φ (π c) = π' (φ' c)) :
    Function.Injective φ ∧ ∀ h', ℓ • h' = 0 → ∃ h, ℓ • h = 0 ∧ φ h = h' := by
  refine ⟨(injective_iff_map_eq_zero φ).2 fun h hh => ?_, fun h' hh' => ?_⟩
  · obtain ⟨g, rfl⟩ := hπ h
    have hg : φ' g ∈ N.map φ' := by rw [← hker', mem_ker, ← hcomm, hh]
    obtain ⟨n, hn, hng⟩ := hg
    rw [← hinj hng, ← mem_ker, hker]
    exact hn
  · obtain ⟨g', rfl⟩ := hπ' h'
    have hg' : ℓ • g' ∈ N.map φ' := by rw [← hker', mem_ker, map_nsmul, hh']
    obtain ⟨n, hn, hng⟩ := hg'
    obtain ⟨m, rfl⟩ := hQ n g' hng.symm
    obtain ⟨t, ht, htg⟩ := hT (g' - φ' m) (by rw [nsmul_sub, ← map_nsmul, hng, sub_self])
    refine ⟨π (m + t), ?_, ?_⟩
    · rw [← map_nsmul, nsmul_add, ht, add_zero, ← mem_ker, hker]
      exact hn
    · rw [hcomm, map_add, htg, add_sub_cancel]

end AddMonoidHom
