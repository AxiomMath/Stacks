module

public import Mathlib.GroupTheory.FiniteAbelian.Basic
public import Mathlib.GroupTheory.Torsion

/-!
# Divisibility and torsion of a quotient by a finitely generated subgroup

Let `φ : A → B` be a surjective homomorphism of abelian groups and `ℓ` a natural number. This
file records how three properties pass from `A` to `B`; they are the group theory of the passage
from the divisor class group of a smooth projective curve to that of an open subcurve, whose
class group is the quotient by the classes of the finitely many missing points.

* If `A` is generated by a family `e` whose members are congruent modulo `ℓ A`, and some member
  is killed by `φ`, then `B` is `ℓ`-divisible.
* If `A` is generated by a family whose members are congruent modulo `ℓ A`, then `B / ℓ B` is
  finite.
* If the `ℓ`-torsion of `A` is finite and the kernel of `φ` is finitely generated, then the
  `ℓ`-torsion of `B` is finite.

## Main results

* `AddMonoidHom.exists_nsmul_eq_of_surjective_of_forall_sub_mem`
* `AddMonoidHom.finite_quotient_nsmul_range_of_surjective_of_forall_sub_mem`
* `AddMonoidHom.finite_nsmul_torsion_of_surjective_of_fg_ker`
-/

@[expose] public section

namespace AddMonoidHom

variable {A B : Type*} [AddCommGroup A] [AddCommGroup B]

/-- If `A` is generated by the family `e`, a subgroup containing every `e i` is the whole group. -/
private theorem mem_of_closure_range_eq_top {ι : Type*} {e : ι → A}
    (he : AddSubgroup.closure (Set.range e) = ⊤) (H : AddSubgroup A) (h : ∀ i, e i ∈ H) (a : A) :
    a ∈ H := by
  have ha : a ∈ AddSubgroup.closure (Set.range e) := he ▸ trivial
  exact (AddSubgroup.closure_le H).2 (by rintro _ ⟨i, rfl⟩; exact h i) ha

/-- Every class in `A ⧸ ℓ A` is killed by `ℓ`. -/
private theorem nsmul_mk_eq_zero (ℓ : ℕ) (a : A) :
    ℓ • (QuotientAddGroup.mk a : A ⧸ (nsmulAddMonoidHom ℓ : A →+ A).range) = 0 := by
  rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
  exact ⟨a, rfl⟩

/-- `B / ℓ B` is finite as soon as it is the image of `A / ℓ A` and `A` is generated by a family
whose members are congruent modulo `ℓ A`: then `A / ℓ A` is cyclic and killed by `ℓ`. -/
theorem finite_quotient_nsmul_range_of_forall_sub_mem {ℓ : ℕ} (hℓ : ℓ ≠ 0) {ι : Type*}
    (e : ι → A) (he : AddSubgroup.closure (Set.range e) = ⊤)
    (hsub : ∀ i j, ∃ b, e i - e j = ℓ • b) :
    Finite (A ⧸ (nsmulAddMonoidHom ℓ : A →+ A).range) := by
  rcases isEmpty_or_nonempty ι with hι | ⟨⟨i₀⟩⟩
  · have : Subsingleton A := ⟨fun a b => by
      rw [(AddSubgroup.mem_bot.1 (mem_of_closure_range_eq_top he ⊥ hι.elim a)),
        (AddSubgroup.mem_bot.1 (mem_of_closure_range_eq_top he ⊥ hι.elim b))]⟩
    infer_instance
  let N : AddSubgroup A := (nsmulAddMonoidHom ℓ : A →+ A).range
  let q : A ⧸ N := QuotientAddGroup.mk (e i₀)
  have hq : ℓ • q = 0 := nsmul_mk_eq_zero ℓ _
  have hgen : ∀ a : A, ∃ n : ℤ, n • q = QuotientAddGroup.mk a := fun a =>
    AddSubgroup.mem_zmultiples_iff.1 (mem_of_closure_range_eq_top he
      ((AddSubgroup.zmultiples q).comap (QuotientAddGroup.mk' N)) (fun i => by
        obtain ⟨b, hb⟩ := hsub i i₀
        refine AddSubgroup.mem_zmultiples_iff.2 ⟨1, ?_⟩
        rw [one_zsmul]
        change q = QuotientAddGroup.mk (e i)
        rw [QuotientAddGroup.eq]
        exact ⟨b, by rw [nsmulAddMonoidHom_apply, ← hb]; abel⟩) a)
  refine Finite.of_surjective (fun n : Fin ℓ => (n : ℕ) • q) fun y => ?_
  induction y using QuotientAddGroup.induction_on with
  | H a =>
    obtain ⟨n, hn⟩ := hgen a
    refine ⟨⟨(n % (ℓ : ℤ)).toNat, ?_⟩, ?_⟩
    · have h1 := Int.emod_lt_of_pos n (Int.natCast_pos.mpr (Nat.pos_of_ne_zero hℓ))
      omega
    · rw [← hn]
      change ((n % (ℓ : ℤ)).toNat : ℕ) • q = n • q
      rw [← natCast_zsmul, Int.toNat_of_nonneg (Int.emod_nonneg n (Int.natCast_ne_zero.mpr hℓ)),
        Int.emod_def, sub_zsmul, mul_comm, mul_zsmul, natCast_zsmul, hq, zsmul_zero, neg_zero,
        add_zero]

/-- **`B / ℓ B` is finite** for a surjection `φ : A → B` from a group generated by a family whose
members are congruent modulo `ℓ A`. -/
theorem finite_quotient_nsmul_range_of_surjective_of_forall_sub_mem (φ : A →+ B)
    (hφ : Function.Surjective φ) {ℓ : ℕ} (hℓ : ℓ ≠ 0) {ι : Type*} (e : ι → A)
    (he : AddSubgroup.closure (Set.range e) = ⊤) (hsub : ∀ i j, ∃ b, e i - e j = ℓ • b) :
    Finite (B ⧸ (nsmulAddMonoidHom ℓ : B →+ B).range) := by
  have := finite_quotient_nsmul_range_of_forall_sub_mem hℓ e he hsub
  refine Finite.of_surjective (QuotientAddGroup.map (nsmulAddMonoidHom ℓ : A →+ A).range
    (nsmulAddMonoidHom ℓ : B →+ B).range φ ?_) ?_
  · rintro _ ⟨a, rfl⟩
    exact ⟨φ a, by simp⟩
  · rintro ⟨b⟩
    obtain ⟨a, rfl⟩ := hφ b
    exact ⟨a, rfl⟩

/-- **`B` is `ℓ`-divisible** for a surjection `φ : A → B` from a group generated by a family whose
members are congruent modulo `ℓ A`, one of which is killed by `φ`. -/
theorem exists_nsmul_eq_of_surjective_of_forall_sub_mem (φ : A →+ B)
    (hφ : Function.Surjective φ) {ℓ : ℕ} {ι : Type*} (e : ι → A)
    (he : AddSubgroup.closure (Set.range e) = ⊤) (hsub : ∀ i j, ∃ b, e i - e j = ℓ • b)
    (i₀ : ι) (hi₀ : φ (e i₀) = 0) (c : B) : ∃ d, ℓ • d = c := by
  obtain ⟨a, rfl⟩ := hφ c
  refine mem_of_closure_range_eq_top he ((nsmulAddMonoidHom ℓ : B →+ B).range.comap φ)
    (fun i => ?_) a
  obtain ⟨b, hb⟩ := hsub i i₀
  refine ⟨φ b, ?_⟩
  rw [nsmulAddMonoidHom_apply, ← map_nsmul, ← hb, map_sub, hi₀, sub_zero]

/-- **The `ℓ`-torsion of `B` is finite** for a surjection `φ : A → B` with finitely generated
kernel from a group with finite `ℓ`-torsion: a torsion element of `B` lifts to `a` with
`ℓ a ∈ ker φ`, and the class of `ℓ a` in the finite group `ker φ / ℓ ker φ` determines the
element up to the image of the `ℓ`-torsion of `A`. -/
theorem finite_nsmul_torsion_of_surjective_of_fg_ker (φ : A →+ B)
    (hφ : Function.Surjective φ) (hK : φ.ker.FG) {ℓ : ℕ}
    (hA : Finite {a : A // ℓ • a = 0}) : Finite {b : B // ℓ • b = 0} := by
  classical
  rcases eq_or_ne ℓ 0 with rfl | hℓ
  · have : Finite A := by
      simp only [zero_smul] at hA
      exact Finite.of_equiv _ (Equiv.subtypeUnivEquiv fun _ => trivial)
    have : Finite B := Finite.of_surjective φ hφ
    infer_instance
  let K := φ.ker
  have : AddGroup.FG K := (AddGroup.fg_iff_addSubgroup_fg K).2 hK
  let Q := K ⧸ (nsmulAddMonoidHom ℓ : K →+ K).range
  have : AddGroup.FG Q := AddGroup.fg_of_surjective (QuotientAddGroup.mk'_surjective _)
  have : Finite Q := by
    refine AddCommGroup.finite_of_fg_isAddTorsion _ fun q => ?_
    induction q using QuotientAddGroup.induction_on with
    | H k =>
      refine isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨ℓ, Nat.pos_of_ne_zero hℓ, ?_⟩
      exact nsmul_mk_eq_zero ℓ k
  let s := Function.surjInv hφ
  have hs : ∀ b, φ (s b) = b := Function.surjInv_eq hφ
  let ψ : {b : B // ℓ • b = 0} → Q := fun b =>
    ((⟨ℓ • s b.1, by rw [AddMonoidHom.mem_ker, map_nsmul, hs, b.2]⟩ : K) : Q)
  let T : Set B := φ '' {a : A | ℓ • a = 0}
  have hfib : ∀ b b' : {b : B // ℓ • b = 0}, ψ b = ψ b' → b.1 - b'.1 ∈ T := by
    intro b b' h
    obtain ⟨k, hk⟩ := QuotientAddGroup.eq.mp h.symm
    have hk' : ℓ • (k : A) = -(ℓ • s b'.1) + ℓ • s b.1 := congrArg Subtype.val hk
    refine ⟨s b.1 - s b'.1 - k, ?_, ?_⟩
    · change ℓ • (s b.1 - s b'.1 - (k : A)) = 0
      rw [nsmul_sub, nsmul_sub, hk']
      abel
    · rw [map_sub, map_sub, hs, hs, AddMonoidHom.mem_ker.mp k.2, sub_zero]
  have : Nonempty {b : B // ℓ • b = 0} := ⟨⟨0, nsmul_zero ℓ⟩⟩
  have : Finite T := ((Set.finite_coe_iff.mp hA).image φ).to_subtype
  refine Finite.of_injective (fun b => (ψ b, (⟨b.1 - (Function.invFun ψ (ψ b)).1,
    hfib _ _ (Function.invFun_eq ⟨b, rfl⟩).symm⟩ : T))) fun b b' h => ?_
  simp only [Prod.mk.injEq, Subtype.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  rw [h1] at h2
  exact Subtype.ext (sub_left_injective h2)

end AddMonoidHom
