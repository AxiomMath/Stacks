module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.Algebra.Module.ZMod
public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.Data.ZMod.QuotientRing

/-!
# Recognising `(ℤ/nℤ)^r` from the cardinalities of the torsion subgroups

Let `H` be an abelian group and let `n ≥ 1`.  If for every divisor `d` of `n` the `d`-torsion
subgroup of `H` is finite with exactly `d ^ r` elements, then the `n`-torsion subgroup of `H` is
isomorphic to `(ℤ/nℤ)^r`.

The cardinality hypothesis for *every* divisor is what makes the conclusion true: a finite
abelian group of order `n ^ r` killed by `n` need not be `(ℤ/nℤ)^r` — take `n = 4`, `r = 1` and
the group `(ℤ/2ℤ)^2` — and it is the count at the primes dividing `n` that rules this out.

The proof is in two steps.  At a prime power `p ^ e` the quotient `G ⧸ p • G` has as many
elements as the `p`-torsion of `G`, namely `p ^ r`; a finite abelian group of order `p ^ r`
killed by `p` is generated by `r` elements, and lifting such a generating family to `G` gives
`r` elements which generate `G` because `p ^ e` kills `G`.  Counting then turns the resulting
surjection `(ℤ/p^eℤ)^r → G` into an isomorphism.  A general `n` is assembled from its prime
powers by the primary decomposition of a torsion module together with the Chinese remainder
theorem.

## Main results

* `AddCommGroup.exists_closure_range_eq_top_of_card_eq_prime_pow`: a finite abelian group of
  order `p ^ r` killed by the prime `p` is generated by `r` elements.
* `AddCommGroup.nonempty_addEquiv_pi_zmod_of_card_torsionBy_primePow`: the prime power case.
* `AddCommGroup.nonempty_addEquiv_pi_zmod_of_card_torsionBy`: a group killed by `n` all of whose
  `d`-torsion subgroups (`d ∣ n`) have `d ^ r` elements is `(ℤ/nℤ)^r`.
* `AddCommGroup.nonempty_torsionBy_addEquiv_pi_zmod`: the same with no hypothesis on the ambient
  group beyond the cardinalities of its torsion subgroups, which is the form used in practice.

## Implementation notes

The prime power case is done by the elementary generator induction of
`exists_closure_range_eq_top_of_card_eq_prime_pow` rather than by giving `G ⧸ p • G` its
`ZMod p`-vector space structure and lifting a basis: for a *variable* prime `p` the type `ZMod p`
is a stuck `match`, so `Module.Free (ZMod p) _`, `Module.Finite (ZMod p) _` and even
`Top (Submodule (ZMod (p ^ e)) _)` leave typeclass search stuck, which was confirmed on isolated
probes before this route was chosen.  For the same reason the surjection out of `(ℤ/p^eℤ)^r` is
the hand-built `zmodCombination` rather than `Fintype.linearCombination`.

This module is the group-theoretic half of the prime-to-characteristic clause of Stacks Tag
03RP; it is applied in
`StacksFrontier/AlgebraicGeometry/GroupScheme/OverField/AbelianVarietyTorsionStructure.lean`.
-/

@[expose] public section

open scoped DirectSum

universe v

namespace AddCommGroup

variable {H : Type*} [AddCommGroup H]

/-- For `d ∣ n`, the `d`-torsion of the `n`-torsion subgroup of `H` is the `d`-torsion of `H`. -/
def torsionByTorsionByAddEquiv {d n : ℤ} (hdn : d ∣ n) :
    Submodule.torsionBy ℤ (Submodule.torsionBy ℤ H n) d ≃+ Submodule.torsionBy ℤ H d where
  toFun x := ⟨x.1.1, by
    have h : d • (x.1 : Submodule.torsionBy ℤ H n) = 0 :=
      (Submodule.mem_torsionBy_iff (R := ℤ) (a := d) x.1).mp x.2
    exact (Submodule.mem_torsionBy_iff (R := ℤ) (a := d) (x.1.1 : H)).mpr
      (congrArg (fun y : Submodule.torsionBy ℤ H n => (y : H)) h)⟩
  invFun x := ⟨⟨x.1, Submodule.torsionBy_le_torsionBy_of_dvd d n hdn x.2⟩, by
    refine (Submodule.mem_torsionBy_iff (R := ℤ) (a := d) _).mpr (Subtype.ext ?_)
    exact (Submodule.mem_torsionBy_iff (R := ℤ) (a := d) (x.1 : H)).mp x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- The `d`-torsion of the `n`-torsion subgroup of `H` has as many elements as the `d`-torsion
of `H`, for every divisor `d` of `n`. -/
theorem card_torsionBy_torsionBy {d n : ℤ} (hdn : d ∣ n) :
    Nat.card (Submodule.torsionBy ℤ (Submodule.torsionBy ℤ H n) d)
      = Nat.card (Submodule.torsionBy ℤ H d) :=
  Nat.card_congr (torsionByTorsionByAddEquiv (H := H) hdn).toEquiv

section Nsmul

variable {G : Type*} [AddCommGroup G]

/-- Multiplication by `m` on an abelian group, as an additive endomorphism. -/
def nsmulEndo (G : Type*) [AddCommGroup G] (m : ℕ) : G →+ G :=
  AddMonoidHom.mk' (fun x => m • x) fun a b => nsmul_add a b m

/-- `nsmulEndo G m` sends `x` to `m • x`. -/
@[simp]
theorem nsmulEndo_apply (m : ℕ) (x : G) : nsmulEndo G m x = m • x := rfl

/-- The kernel of multiplication by `m` is the `m`-torsion subgroup of `G`. -/
theorem ker_nsmulEndo (m : ℕ) :
    (nsmulEndo G m).ker = (Submodule.torsionBy ℤ G (m : ℤ)).toAddSubgroup := by
  ext x
  simp only [AddMonoidHom.mem_ker, nsmulEndo_apply, Submodule.mem_toAddSubgroup,
    Submodule.mem_torsionBy_iff, natCast_zsmul]

/-- The quotient of `G` by `m • G` has as many elements as the `m`-torsion of `G`: both measure
the failure of multiplication by `m` to be bijective. -/
theorem card_quotient_range_nsmulEndo [Finite G] (m : ℕ) :
    Nat.card (G ⧸ (nsmulEndo G m).range) = Nat.card (Submodule.torsionBy ℤ G (m : ℤ)) := by
  have h₁ : Nat.card ((nsmulEndo G m).ker) * Nat.card ((nsmulEndo G m).range) = Nat.card G := by
    rw [← Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (nsmulEndo G m)).toEquiv,
      ← AddSubgroup.index_eq_card]
    exact AddSubgroup.card_mul_index _
  have h₂ : Nat.card ((nsmulEndo G m).range) * Nat.card (G ⧸ (nsmulEndo G m).range)
      = Nat.card G := by
    rw [← AddSubgroup.index_eq_card]
    exact AddSubgroup.card_mul_index _
  have hpos : 0 < Nat.card ((nsmulEndo G m).range) := Nat.card_pos
  have h₃ : Nat.card ((nsmulEndo G m).range) * Nat.card (G ⧸ (nsmulEndo G m).range)
      = Nat.card ((nsmulEndo G m).range) * Nat.card ((nsmulEndo G m).ker) := by
    rw [h₂, ← h₁, mul_comm]
  rw [Nat.eq_of_mul_eq_mul_left hpos h₃, ker_nsmulEndo]
  exact Nat.card_congr (Equiv.refl _)

/-- The quotient of `G` by `m • G` is killed by `m`. -/
theorem nsmul_quotient_range_nsmulEndo_eq_zero (m : ℕ) (x : G ⧸ (nsmulEndo G m).range) :
    m • x = 0 := by
  obtain ⟨z, rfl⟩ := QuotientAddGroup.mk_surjective x
  rw [← QuotientAddGroup.mk_nsmul]
  exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨z, rfl⟩

end Nsmul

/-- In a group killed by `m`, a natural multiple of an element depends only on the multiplier
modulo `m`. -/
theorem nsmul_eq_of_mod_eq {G : Type*} [AddCommGroup G] {m : ℕ} (hG : ∀ g : G, m • g = 0)
    {a b : ℕ} (h : a % m = b % m) (g : G) : a • g = b • g := by
  rw [nsmul_eq_mod_nsmul a (hG g), h, ← nsmul_eq_mod_nsmul b (hG g)]

/-- The additive map `(ℤ/mℤ)^r → G` sending `c` to `∑ i, c i • x i`, for a family `x` in an
abelian group killed by `m`.  It is well defined precisely because `m` kills `G`. -/
def zmodCombination {G : Type*} [AddCommGroup G] {m r : ℕ} [NeZero m]
    (hG : ∀ g : G, m • g = 0) (x : Fin r → G) : (Fin r → ZMod m) →+ G where
  toFun c := ∑ i, (c i).val • x i
  map_zero' := by simp
  map_add' c c' := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← add_nsmul]
    exact nsmul_eq_of_mod_eq hG (by simp [ZMod.val_add]) (x i)

/-- `zmodCombination hG x` sends `c` to `∑ i, (c i).val • x i`. -/
@[simp]
theorem zmodCombination_apply {G : Type*} [AddCommGroup G] {m r : ℕ} [NeZero m]
    (hG : ∀ g : G, m • g = 0) (x : Fin r → G) (c : Fin r → ZMod m) :
    zmodCombination hG x c = ∑ i, (c i).val • x i := rfl

/-- `zmodCombination hG x` sends the `i`-th standard basis vector to `x i`. -/
theorem zmodCombination_single {G : Type*} [AddCommGroup G] {m r : ℕ} [NeZero m]
    [Fact (1 < m)] (hG : ∀ g : G, m • g = 0) (x : Fin r → G) (i : Fin r) :
    zmodCombination hG x (Pi.single i 1) = x i := by
  classical
  rw [zmodCombination_apply, Finset.sum_eq_single i]
  · simp [ZMod.val_one]
  · intro j _ hj
    simp [Pi.single_eq_of_ne hj]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- If the images of a family `z` in `Q ⧸ S` generate the quotient, every `x` lies in `T` modulo
`S`, for any subgroup `T` containing the family. -/
private theorem exists_mem_sub_mem_of_closure_range_eq_top {Q : Type*} [AddCommGroup Q]
    (S T : AddSubgroup Q) {r : ℕ} {y : Fin r → Q ⧸ S} {z : Fin r → Q}
    (hy : AddSubgroup.closure (Set.range y) = ⊤) (hz : ∀ i, z i ∈ T)
    (hzy : ∀ i, QuotientAddGroup.mk' S (z i) = y i) (x : Q) : ∃ t ∈ T, x - t ∈ S := by
  have hmap : AddSubgroup.map (QuotientAddGroup.mk' S) T = ⊤ := by
    rw [eq_top_iff, ← hy]
    refine (AddSubgroup.closure_le _).mpr ?_
    rintro w ⟨i, rfl⟩
    exact ⟨z i, hz i, hzy i⟩
  have hx : QuotientAddGroup.mk' S x ∈ AddSubgroup.map (QuotientAddGroup.mk' S) T := by
    rw [hmap]; exact AddSubgroup.mem_top _
  obtain ⟨t, ht, hxt⟩ := hx
  exact ⟨t, ht, QuotientAddGroup.eq_iff_sub_mem.mp hxt.symm⟩

/-- A finite abelian group of order `p ^ r` killed by a prime `p` is generated by `r` elements.

Split off the cyclic subgroup generated by a nonzero element — it has order `p`, since `p` is
prime — and induct on `r` through the quotient. -/
theorem exists_closure_range_eq_top_of_card_eq_prime_pow {p : ℕ} (hp : p.Prime) (r : ℕ) :
    ∀ (Q : Type v) [AddCommGroup Q], (∀ x : Q, p • x = 0) → Nat.card Q = p ^ r →
      ∃ y : Fin r → Q, AddSubgroup.closure (Set.range y) = ⊤ := by
  induction r with
  | zero =>
    intro Q _ _ hcard
    rw [pow_zero] at hcard
    have : Subsingleton Q := (Nat.card_eq_one_iff_unique.mp hcard).1
    refine ⟨Fin.elim0, eq_top_iff.mpr ?_⟩
    intro x _
    rw [Subsingleton.elim x 0]
    exact AddSubgroup.zero_mem _
  | succ r ih =>
    intro Q _ hQ hcard
    have : Finite Q :=
      Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero _ hp.ne_zero)
    have hne : Nat.card Q ≠ 1 := by
      have h1 : 1 < p ^ (r + 1) := Nat.one_lt_pow (Nat.succ_ne_zero r) hp.one_lt
      omega
    obtain ⟨y₀, hy₀⟩ : ∃ y₀ : Q, y₀ ≠ 0 := by
      by_contra hcon
      simp only [not_exists, not_not] at hcon
      exact hne (Nat.card_eq_one_iff_unique.mpr ⟨⟨fun a c => by rw [hcon a, hcon c]⟩, ⟨0⟩⟩)
    -- The cyclic subgroup generated by `y₀` has order `p`.
    have hordy : addOrderOf y₀ = p := by
      rcases hp.eq_one_or_self_of_dvd _ (addOrderOf_dvd_of_nsmul_eq_zero (hQ y₀)) with h | h
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hy₀
      · exact h
    have hcardS : Nat.card (AddSubgroup.zmultiples y₀) = p := by
      rw [Nat.card_zmultiples, hordy]
    have hcardQ' : Nat.card (Q ⧸ AddSubgroup.zmultiples y₀) = p ^ r := by
      have hmul := AddSubgroup.card_mul_index (AddSubgroup.zmultiples y₀)
      rw [AddSubgroup.index_eq_card, hcardS, hcard, pow_succ, mul_comm (p ^ r) p] at hmul
      exact Nat.eq_of_mul_eq_mul_left hp.pos hmul
    have hQ' : ∀ x : Q ⧸ AddSubgroup.zmultiples y₀, p • x = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := QuotientAddGroup.mk_surjective x
      rw [← QuotientAddGroup.mk_nsmul, hQ z]
      simp
    obtain ⟨y', hy'⟩ := ih (Q ⧸ AddSubgroup.zmultiples y₀) hQ' hcardQ'
    choose z hz using fun i : Fin r =>
      QuotientAddGroup.mk'_surjective (AddSubgroup.zmultiples y₀) (y' i)
    refine ⟨Fin.cons y₀ z, ?_⟩
    set T : AddSubgroup Q := AddSubgroup.closure (Set.range (Fin.cons y₀ z)) with hT
    have hy₀T : y₀ ∈ T := AddSubgroup.subset_closure ⟨0, Fin.cons_zero _ _⟩
    have hzT : ∀ i : Fin r, z i ∈ T := fun i =>
      AddSubgroup.subset_closure ⟨i.succ, Fin.cons_succ _ _ _⟩
    have hST : AddSubgroup.zmultiples y₀ ≤ T := AddSubgroup.zmultiples_le.mpr hy₀T
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨t, ht, hsub⟩ :=
      exists_mem_sub_mem_of_closure_range_eq_top _ T hy' hzT hz x
    simpa using T.add_mem ht (hST hsub)

section PrimePow

variable {G : Type*} [AddCommGroup G] {p e r : ℕ}

/-- **The prime power case.** An abelian group killed by `p ^ e` whose `p ^ j`-torsion has
`p ^ (j * r)` elements for every `j ≤ e` is isomorphic to `(ℤ/p^eℤ)^r`. -/
theorem nonempty_addEquiv_pi_zmod_of_card_torsionBy_primePow (hp : p.Prime)
    (hG : ∀ x : G, (p ^ e) • x = 0)
    (hcard : ∀ j ≤ e, Nat.card (Submodule.torsionBy ℤ G ((p ^ j : ℕ) : ℤ)) = p ^ (j * r)) :
    Nonempty (G ≃+ (Fin r → ZMod (p ^ e))) := by
  classical
  have : NeZero (p ^ e) := ⟨pow_ne_zero _ hp.ne_zero⟩
  -- `G` is finite with `p ^ (e * r)` elements.
  have htop : Submodule.torsionBy ℤ G ((p ^ e : ℕ) : ℤ) = ⊤ :=
    eq_top_iff.mpr fun y _ => by
      refine (Submodule.mem_torsionBy_iff (R := ℤ) (a := ((p ^ e : ℕ) : ℤ)) y).mpr ?_
      rw [natCast_zsmul]
      exact hG y
  have hcardG : Nat.card G = p ^ (e * r) := by
    have h := hcard e le_rfl
    rw [htop, Nat.card_congr (Submodule.topEquiv (R := ℤ) (M := G)).toEquiv] at h
    exact h
  have : Finite G :=
    Nat.finite_of_card_ne_zero (by rw [hcardG]; exact pow_ne_zero _ hp.ne_zero)
  rcases Nat.eq_zero_or_pos e with he | he
  · -- `p ^ 0 = 1` kills `G`, so both sides are trivial.
    subst he
    have : Subsingleton G := by
      refine ⟨fun a c => ?_⟩
      have ha := hG a
      have hc := hG c
      rw [pow_zero, one_nsmul] at ha hc
      rw [ha, hc]
    have : Subsingleton (ZMod (p ^ 0)) := ZMod.subsingleton_iff.2 (pow_zero p)
    exact ⟨{ toFun := fun _ => 0, invFun := fun _ => 0
             left_inv := fun _ => Subsingleton.elim _ _
             right_inv := fun _ => Subsingleton.elim _ _
             map_add' := fun _ _ => Subsingleton.elim _ _ }⟩
  -- `G ⧸ p • G` has `p ^ r` elements, hence is generated by `r` elements; lift them to `G`.
  have hcardQ : Nat.card (G ⧸ (nsmulEndo G p).range) = p ^ r := by
    rw [card_quotient_range_nsmulEndo p]
    have h := hcard 1 he
    simpa using h
  obtain ⟨y', hy'⟩ := exists_closure_range_eq_top_of_card_eq_prime_pow hp r
    (G ⧸ (nsmulEndo G p).range) (nsmul_quotient_range_nsmulEndo_eq_zero p) hcardQ
  choose x hx using fun i : Fin r =>
    QuotientAddGroup.mk'_surjective (nsmulEndo G p).range (y' i)
  set N : AddSubgroup G := AddSubgroup.closure (Set.range x) with hN
  have hxN : ∀ i : Fin r, x i ∈ N := fun i => AddSubgroup.subset_closure ⟨i, rfl⟩
  -- Every element of `G` lies in `N` modulo `p • G`.
  have step1 : ∀ y : G, ∃ a ∈ N, ∃ z : G, y = a + p • z := by
    intro y
    obtain ⟨a, ha, z, hz⟩ :=
      exists_mem_sub_mem_of_closure_range_eq_top _ N hy' hxN hx y
    exact ⟨a, ha, z, by rw [show p • z = y - a from hz]; abel⟩
  -- Iterating `step1` and using that `p ^ e` kills `G`, the `x i` generate `N = ⊤`.
  have step2 : ∀ (k : ℕ) (y : G), ∃ a ∈ N, ∃ z : G, y = a + (p ^ k) • z := by
    intro k
    induction k with
    | zero => exact fun y => ⟨0, N.zero_mem, y, by simp⟩
    | succ k ih =>
      intro y
      obtain ⟨a, ha, z, hz⟩ := ih y
      obtain ⟨a', ha', z', hz'⟩ := step1 z
      refine ⟨a + (p ^ k) • a', N.add_mem ha (nsmul_mem ha' _), z', ?_⟩
      rw [hz, hz', smul_add, smul_smul, ← pow_succ, add_assoc]
  have hNtop : N = ⊤ := by
    refine eq_top_iff.mpr ?_
    intro y _
    obtain ⟨a, ha, z, hz⟩ := step2 e y
    rw [hz, hG z, add_zero]
    exact ha
  -- The `r` generators give a surjection from `(ℤ/p^eℤ)^r`, injective by counting.
  have : Fact (1 < p ^ e) := ⟨by
    calc 1 < p ^ 1 := by simpa using hp.one_lt
      _ ≤ p ^ e := Nat.pow_le_pow_right hp.pos he⟩
  have hFtop : (zmodCombination hG x).range = ⊤ := by
    rw [eq_top_iff, ← hNtop, hN]
    refine (AddSubgroup.closure_le _).mpr ?_
    rintro _ ⟨i, rfl⟩
    exact ⟨Pi.single i 1, zmodCombination_single hG x i⟩
  have hcards : Nat.card (Fin r → ZMod (p ^ e)) = Nat.card G := by
    rw [hcardG, Nat.card_pi]
    simp [pow_mul]
  have hbij : Function.Bijective ((zmodCombination hG x : (Fin r → ZMod (p ^ e)) →+ G) :
      (Fin r → ZMod (p ^ e)) → G) :=
    (Nat.bijective_iff_surjective_and_card _).mpr
      ⟨AddMonoidHom.range_eq_top.mp hFtop, hcards⟩
  exact ⟨(AddEquiv.ofBijective (zmodCombination hG x) hbij).symm⟩

end PrimePow

section General

variable {G : Type*} [AddCommGroup G] {n r : ℕ}

/-- **The torsion-count criterion.** An abelian group killed by `n ≠ 0` whose `d`-torsion has
`d ^ r` elements for every divisor `d` of `n` is isomorphic to `(ℤ/nℤ)^r`.

The primary decomposition of a torsion module splits `G` into its `p`-primary parts for the
primes `p` dividing `n`; each is `(ℤ/p^{v_p(n)}ℤ)^r` by the prime power case, and the Chinese
remainder theorem puts the pieces back together. -/
theorem nonempty_addEquiv_pi_zmod_of_card_torsionBy (hn : n ≠ 0) (hG : ∀ x : G, n • x = 0)
    (hcard : ∀ d : ℕ, d ∣ n → Nat.card (Submodule.torsionBy ℤ G (d : ℤ)) = d ^ r) :
    Nonempty (G ≃+ (Fin r → ZMod n)) := by
  classical
  obtain ⟨q, hq⟩ : ∃ q : ℕ → ℤ, ∀ p : ℕ, q p = ((p ^ n.factorization p : ℕ) : ℤ) :=
    ⟨fun p => ((p ^ n.factorization p : ℕ) : ℤ), fun _ => rfl⟩
  have hcop : (↑n.primeFactors : Set ℕ).Pairwise (Function.onFun IsCoprime q) := by
    intro a ha b hb hab
    have ha' : a ∈ n.primeFactors := by simpa using ha
    have hb' : b ∈ n.primeFactors := by simpa using hb
    have hne : (⟨a, ha'⟩ : n.primeFactors) ≠ ⟨b, hb'⟩ := by simpa using hab
    simpa [hq, Function.onFun] using
      (Nat.pairwise_coprime_pow_primeFactors_factorization (n := n) hne).cast (R := ℤ)
  have hprod : ∏ p ∈ n.primeFactors, q p = (n : ℤ) := by
    have hcast : ∏ p ∈ n.primeFactors, q p
        = ((∏ p ∈ n.primeFactors, p ^ n.factorization p : ℕ) : ℤ) := by
      rw [Nat.cast_prod]
      exact Finset.prod_congr rfl fun p _ => hq p
    rw [hcast]
    exact congrArg (fun m : ℕ => (m : ℤ)) (Nat.prod_primeFactors_pow_factorization hn).symm
  have hM : Module.IsTorsionBy ℤ G (∏ p ∈ n.primeFactors, q p) := by
    rw [hprod]
    intro x
    rw [natCast_zsmul]
    exact hG x
  have hInternal := Submodule.torsionBy_isInternal (R := ℤ) (M := G)
    (S := n.primeFactors) (q := q) hcop hM
  -- Each primary part is `(ℤ/p^{v_p(n)}ℤ)^r`.
  have hcomp : ∀ p : n.primeFactors,
      Nonempty (Submodule.torsionBy ℤ G (q p.1) ≃+
        (Fin r → ZMod ((p : ℕ) ^ n.factorization (p : ℕ)))) := by
    intro p
    have hp : ((p : ℕ)).Prime := Nat.prime_of_mem_primeFactors p.2
    refine nonempty_addEquiv_pi_zmod_of_card_torsionBy_primePow hp ?_ ?_
    · intro y
      have hy := Submodule.torsionBy_isTorsionBy (R := ℤ) (M := G) (q p.1) (x := y)
      rw [← natCast_zsmul, ← hq ((p : ℕ))]
      exact hy
    · intro j hj
      have hdvdq : ((((p : ℕ) ^ j : ℕ)) : ℤ) ∣ q p.1 := by
        rw [hq ((p : ℕ))]
        exact_mod_cast pow_dvd_pow ((p : ℕ)) hj
      have hdn : ((p : ℕ) ^ j) ∣ n :=
        dvd_trans (pow_dvd_pow _ hj) (Nat.ordProj_dvd n (p : ℕ))
      rw [card_torsionBy_torsionBy hdvdq, hcard _ hdn, ← pow_mul]
  -- Assemble.
  have E : (⨁ p : n.primeFactors, Submodule.torsionBy ℤ G (q p.1)) ≃ₗ[ℤ] G :=
    LinearEquiv.ofBijective (DirectSum.coeLinearMap _) hInternal
  have e₄ : (∀ p : n.primeFactors, Fin r → ZMod ((p : ℕ) ^ n.factorization (p : ℕ))) ≃+
      (Fin r → ZMod n) :=
    { toFun := fun z j => (ZMod.equivPi n hn).symm (fun p => z p j)
      invFun := fun w p j => (ZMod.equivPi n hn) (w j) p
      left_inv := fun z => by funext p j; simp
      right_inv := fun w => by funext j; simp
      map_add' := fun z w => by funext j; exact map_add (ZMod.equivPi n hn).symm _ _ }
  exact ⟨((E.symm.toAddEquiv.trans
    (DirectSum.addEquivProd fun p : n.primeFactors => Submodule.torsionBy ℤ G (q p.1))).trans
      (AddEquiv.piCongrRight fun p => Classical.choice (hcomp p))).trans e₄⟩

/-- **The torsion-count criterion, with no hypothesis on the ambient group.** If for every
divisor `d` of `n ≠ 0` the `d`-torsion subgroup of `H` has exactly `d ^ r` elements, then the
`n`-torsion subgroup of `H` is isomorphic to `(ℤ/nℤ)^r`. -/
theorem nonempty_torsionBy_addEquiv_pi_zmod {H : Type*} [AddCommGroup H] {n r : ℕ} (hn : n ≠ 0)
    (hcard : ∀ d : ℕ, d ∣ n → Nat.card (Submodule.torsionBy ℤ H (d : ℤ)) = d ^ r) :
    Nonempty (Submodule.torsionBy ℤ H (n : ℤ) ≃+ (Fin r → ZMod n)) := by
  refine nonempty_addEquiv_pi_zmod_of_card_torsionBy hn ?_ ?_
  · intro y
    have hy := Submodule.torsionBy_isTorsionBy (R := ℤ) (M := H) ((n : ℕ) : ℤ) (x := y)
    rwa [natCast_zsmul] at hy
  · intro d hd
    rw [card_torsionBy_torsionBy (H := H) (d := (d : ℤ)) (n := (n : ℤ))
      (Int.natCast_dvd_natCast.mpr hd)]
    exact hcard d hd

end General

end AddCommGroup
