module

public import StacksFrontier.Topology.Noetherian.Defs
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A locally Noetherian space with no closed point (Stacks 02HZ)

A nonempty Kolmogorov Noetherian space always has a closed point: it is quasi-compact
(`TopologicalSpace.NoetherianSpace.compactSpace`), and a nonempty closed subset of a
quasi-compact Kolmogorov space contains a closed point by Stacks 005E
(`IsClosed.exists_closed_singleton`).

Stacks 02HZ shows that this fails for *locally* Noetherian spaces. The example is the set
`{1, 2, 3, …}` with the topology whose opens are `∅`, the initial segments, and the whole
space; we take it on `ℕ`, so `0`-indexed, with the topology generated by the intervals
`Set.Iic n`. Every point `x` has the finite — hence Noetherian — open neighbourhood
`Set.Iic x`, so the space is locally Noetherian. But every open set is a lower set, so
`x + 1` lies in the closure of `{x}` and no singleton is closed.

Together these exhibit a locally Noetherian space that is not the underlying space of any
Noetherian scheme; the source's closing cross-reference to Properties 02IL is not formalized.
-/

@[expose] public section

open TopologicalSpace

/-- **Stacks 02HZ.** Every nonempty Kolmogorov Noetherian topological space has a closed
point: it is quasi-compact, so Stacks 005E applies to the closed set `Set.univ`. -/
@[stacks 02HZ, ega "0 2.1.3" "special case"]
theorem TopologicalSpace.NoetherianSpace.exists_isClosed_singleton
    (X : Type*) [TopologicalSpace X] [Nonempty X] [NoetherianSpace X] [T0Space X] :
    ∃ x : X, IsClosed ({x} : Set X) :=
  (isClosed_univ.exists_closed_singleton Set.univ_nonempty).imp fun _ ⟨_, hx⟩ => hx

namespace Stacks.LocallyNoetherianNoClosedPoint

/-- The topology of Stacks 02HZ on `ℕ`: the opens are `∅`, the initial segments
`Set.Iic n = {0, …, n}`, and the whole space. (This is the space `X = {1, 2, 3, …}` of the
example, relabelled `0`-indexed.) -/
@[reducible]
def iicTopology : TopologicalSpace ℕ :=
  TopologicalSpace.generateFrom {U : Set ℕ | ∃ n : ℕ, U = Set.Iic n}

/-- Every open set of `iicTopology` is a lower set, the generating intervals being lower
sets and lower sets being closed under intersections and unions. -/
private lemma isLowerSet_of_isOpen {V : Set ℕ} (hV : @IsOpen ℕ iicTopology V) :
    IsLowerSet V := by
  induction hV with
  | basic _ hu =>
    obtain ⟨n, rfl⟩ := hu
    exact isLowerSet_Iic n
  | univ => exact isLowerSet_univ
  | inter _ _ _ _ ihu ihv => exact ihu.inter ihv
  | sUnion _ _ ihS => exact isLowerSet_sUnion ihS

/-- **Stacks 02HZ.** The space of Stacks 02HZ is locally Noetherian: for each `x`, the open
neighbourhood `Set.Iic x = {0, …, x}` is finite, hence Noetherian. -/
@[stacks 02HZ]
theorem isLocallyNoetherianSpace :
    letI : TopologicalSpace ℕ := iicTopology
    IsLocallyNoetherianSpace ℕ := by
  let : TopologicalSpace ℕ := iicTopology
  intro x
  refine ⟨Set.Iic x, TopologicalSpace.GenerateOpen.basic _ ⟨x, rfl⟩, le_refl x, ?_⟩
  have : Finite (Set.Iic x : Set ℕ) := Set.Finite.to_subtype (Set.finite_Iic x)
  infer_instance

/-- **Stacks 02HZ.** The space of Stacks 02HZ has no closed point: every open set is a lower
set, so `x + 1 ∈ closure {x}` while `x + 1 ≠ x`. -/
@[stacks 02HZ]
theorem not_isClosed_singleton :
    letI : TopologicalSpace ℕ := iicTopology
    ∀ x : ℕ, ¬ IsClosed ({x} : Set ℕ) := by
  let : TopologicalSpace ℕ := iicTopology
  intro x hclosed
  have hmem : x + 1 ∈ closure ({x} : Set ℕ) := mem_closure_iff.mpr fun U hU hxU =>
    ⟨x, isLowerSet_of_isOpen hU (Nat.le_succ x) hxU, rfl⟩
  rw [hclosed.closure_eq] at hmem
  exact Nat.succ_ne_self x (Set.mem_singleton_iff.mp hmem)

end Stacks.LocallyNoetherianNoClosedPoint
