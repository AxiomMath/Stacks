/-!
# Refining a finite constructible cover by a stratification

Let `X` be a topological space and let `T₁, …, Tₙ` be a finite family of constructible subsets of
`X` whose union is `X`. Then `X` carries a finite stratification `X = ⨆ Xᵢ` — a finite family of
pairwise disjoint subsets covering `X`, indexed by a partially ordered type and satisfying
`closure (Xⱼ) ⊆ ⋃_{i ≤ j} Xᵢ` — whose strata are constructible and of which each `Tₖ` is a union.

The strata are the *cells* of a finite family `U : Fin m → Set X` of retrocompact opens generating
all of the `Tₖ` inside the Boolean algebra of subsets of `X`: for a truth table `a : Fin m → Bool`
the cell of `a` is `⋂ i, (if a i then U i else (U i)ᶜ)`. Cells are pairwise disjoint, cover `X`,
are constructible, and, for the pointwise order on `Fin m → Bool`, satisfy the closure condition.

## Main definitions

* `FiniteStratification`: a finite family of pairwise disjoint subsets covering `X`, indexed by a
  partially ordered type and satisfying the closure condition.
* `cellOf`: the cell of a truth table for a finite family of subsets of `X`.
* `hasFinWit`: the elements of a Boolean algebra lying in the closure of some finite subfamily of
  a given set of generators.
* `unionsOfCells`: the subsets of `X` that are unions of cells.

## Main results

* `boolean_subalgebra_closure_finite_generation`: membership in `BooleanSubalgebra.closure S` is
  always witnessed by a finite subfamily of `S`.
* `exists_finite_retro_opens_for_family`: a finite family of constructible sets is generated by a
  single finite family of retrocompact opens.
* `exists_iUnion_cellOf_of_mem_closure`: every element of the Boolean subalgebra generated by
  `Set.range U` is a union of cells.
* `exists_finiteStratification_refining_constructible`: a finite constructible cover of
  `X` is refined by a finite stratification with constructible strata.
-/

@[expose] public section

open Set

variable {X : Type*} [TopologicalSpace X]

/-! ### Finite stratifications and the cell decomposition -/

/-- A *finite stratification* of a topological space `X` is the data of:

* a finite index type `ι` equipped with a partial order, and
* a function `S : ι → Set X` assigning to each index a subset (a *stratum*),

subject to the conditions that the strata are pairwise disjoint, cover all of
`X`, and for every `j : ι` the closure of `S j` is contained in the union of
the strata `S i` with `i ≤ j`.

These axioms force each stratum to be locally closed in `X`. -/
structure FiniteStratification (X : Type*) [TopologicalSpace X] where
  /-- The (finite) index type for the strata. -/
  ι : Type
  /-- The index type is finite. -/
  [fintype : Fintype ι]
  /-- The partial order on the index type. -/
  [partialOrder : PartialOrder ι]
  /-- The function assigning each index to its stratum. -/
  S : ι → Set X
  /-- Different strata are disjoint. -/
  disjoint : Pairwise (Function.onFun Disjoint S)
  /-- The strata cover `X`. -/
  iUnion_eq_univ : ⋃ i, S i = Set.univ
  /-- For every `j`, `closure (S j) ⊆ ⋃_{i ≤ j} S i`. -/
  closure_subset : ∀ j, closure (S j) ⊆ ⋃ i ∈ {i | i ≤ j}, S i

attribute [instance] FiniteStratification.fintype FiniteStratification.partialOrder

/-- The *cell* of the truth-table `a : Fin m → Bool` for a finite family
`U : Fin m → Set X` is the intersection over all `i` of either `U i`
(when `a i = true`) or its complement (otherwise). -/
def cellOf {m : ℕ} (U : Fin m → Set X) (a : Fin m → Bool) : Set X :=
  ⋂ i, (if a i then U i else (U i)ᶜ)

/-! ### Finite generation of `BooleanSubalgebra.closure`

Membership in `BooleanSubalgebra.closure S` already follows from membership in
`BooleanSubalgebra.closure (Set.range V)` for some finite family `V : Fin m → α` of elements
of `S`. -/

/-- The set of elements of a Boolean algebra `α` that admit a *finite witness*
in `S`: lying in the closure of some finite subfamily of `S`. -/
def hasFinWit {α : Type*} [BooleanAlgebra α] (S : Set α) : Set α :=
  { x | ∃ (m : ℕ) (V : Fin m → α),
        (∀ i, V i ∈ S) ∧ x ∈ BooleanSubalgebra.closure (Set.range V : Set α) }

/-- Every element of `S` admits a finite witness in `S`. -/
lemma subset_hasFinWit {α : Type*} [BooleanAlgebra α] (S : Set α) :
    S ⊆ hasFinWit S := fun s hs =>
  ⟨1, fun _ => s, fun _ => hs, BooleanSubalgebra.subset_closure ⟨0, rfl⟩⟩

/-- The bottom element admits a finite witness in `S`. -/
lemma bot_mem_hasFinWit {α : Type*} [BooleanAlgebra α] (S : Set α) :
    (⊥ : α) ∈ hasFinWit S :=
  ⟨0, Fin.elim0, fun i => i.elim0, (BooleanSubalgebra.closure _).bot_mem⟩

/-- `hasFinWit S` is closed under complements. -/
lemma compl_mem_hasFinWit {α : Type*} [BooleanAlgebra α] {S : Set α} {x : α}
    (hx : x ∈ hasFinWit S) : xᶜ ∈ hasFinWit S :=
  let ⟨m, V, hV, hxB⟩ := hx
  ⟨m, V, hV, (BooleanSubalgebra.closure _).compl_mem hxB⟩

/-- The ranges of two families are contained in the range of their concatenation. -/
private theorem range_subset_range_append {α : Type*} {m n : ℕ} (u : Fin m → α) (v : Fin n → α) :
    Set.range u ⊆ Set.range (Fin.append u v) ∧ Set.range v ⊆ Set.range (Fin.append u v) :=
  ⟨by rintro _ ⟨i, rfl⟩; exact ⟨Fin.castAdd n i, Fin.append_left u v i⟩,
    by rintro _ ⟨i, rfl⟩; exact ⟨Fin.natAdd m i, Fin.append_right u v i⟩⟩

/-- A property holding on two families holds on their concatenation. -/
private theorem forall_append {α : Type*} {m n : ℕ} {p : α → Prop} {u : Fin m → α} {v : Fin n → α}
    (hu : ∀ i, p (u i)) (hv : ∀ i, p (v i)) (i : Fin (m + n)) : p (Fin.append u v i) := by
  induction i using Fin.addCases with
  | left j => simpa [Fin.append_left] using hu j
  | right j => simpa [Fin.append_right] using hv j

/-- Two elements with finite witnesses in `S` lie in the closure of one common finite subfamily. -/
private theorem exists_finite_family_closure_of_mem_hasFinWit {α : Type*} [BooleanAlgebra α]
    {S : Set α} {x y : α} (hx : x ∈ hasFinWit S) (hy : y ∈ hasFinWit S) :
    ∃ (m : ℕ) (V : Fin m → α), (∀ i, V i ∈ S) ∧ x ∈ BooleanSubalgebra.closure (Set.range V) ∧
      y ∈ BooleanSubalgebra.closure (Set.range V) := by
  obtain ⟨m, Vx, hVx, hx⟩ := hx
  obtain ⟨n, Vy, hVy, hy⟩ := hy
  exact ⟨m + n, Fin.append Vx Vy, forall_append hVx hVy,
    BooleanSubalgebra.closure_mono (range_subset_range_append Vx Vy).1 hx,
    BooleanSubalgebra.closure_mono (range_subset_range_append Vx Vy).2 hy⟩

/-- `hasFinWit S` is closed under joins: the two witnessing families are concatenated. -/
lemma sup_mem_hasFinWit {α : Type*} [BooleanAlgebra α] {S : Set α} {x y : α}
    (hx : x ∈ hasFinWit S) (hy : y ∈ hasFinWit S) :
    x ⊔ y ∈ hasFinWit S :=
  let ⟨m, V, hV, hx, hy⟩ := exists_finite_family_closure_of_mem_hasFinWit hx hy
  ⟨m, V, hV, (BooleanSubalgebra.closure _).sup_mem hx hy⟩

/-- `hasFinWit S` is closed under meets: the two witnessing families are concatenated. -/
lemma inf_mem_hasFinWit {α : Type*} [BooleanAlgebra α] {S : Set α} {x y : α}
    (hx : x ∈ hasFinWit S) (hy : y ∈ hasFinWit S) :
    x ⊓ y ∈ hasFinWit S :=
  let ⟨m, V, hV, hx, hy⟩ := exists_finite_family_closure_of_mem_hasFinWit hx hy
  ⟨m, V, hV, (BooleanSubalgebra.closure _).inf_mem hx hy⟩

/-- Bundle `hasFinWit S` as a Boolean subalgebra of `α`. -/
def hasFinWitSubalgebra {α : Type*} [BooleanAlgebra α] (S : Set α) :
    BooleanSubalgebra α where
  carrier := hasFinWit S
  supClosed' := fun _ hx _ hy => sup_mem_hasFinWit hx hy
  infClosed' := fun _ hx _ hy => inf_mem_hasFinWit hx hy
  compl_mem' := compl_mem_hasFinWit
  bot_mem' := bot_mem_hasFinWit S

/-- Every element of `BooleanSubalgebra.closure S` is already in the closure of
some finite subfamily of `S`. -/
lemma boolean_subalgebra_closure_finite_generation
    {α : Type*} [BooleanAlgebra α] {S : Set α} {E : α}
    (hE : E ∈ BooleanSubalgebra.closure S) :
    ∃ (m : ℕ) (V : Fin m → α), (∀ i, V i ∈ S) ∧
      E ∈ BooleanSubalgebra.closure (Set.range V : Set α) :=
  (BooleanSubalgebra.closure_le.mpr (subset_hasFinWit S) :
    BooleanSubalgebra.closure S ≤ hasFinWitSubalgebra S) hE

/-! ### A single finite family of retrocompact opens generating every `T k` -/

/-- The range of `U'` is contained in the range of the concatenation `Fin.append U' V`. -/
lemma range_subset_range_append_left {Y : Type*} {m' mlast : ℕ}
    (U' : Fin m' → Set Y) (V : Fin mlast → Set Y) :
    (Set.range U' : Set (Set Y)) ⊆ (Set.range (Fin.append U' V) : Set (Set Y)) :=
  (range_subset_range_append U' V).1

/-- The range of `V` is contained in the range of the concatenation `Fin.append U' V`. -/
lemma range_subset_range_append_right {Y : Type*} {m' mlast : ℕ}
    (U' : Fin m' → Set Y) (V : Fin mlast → Set Y) :
    (Set.range V : Set (Set Y)) ⊆ (Set.range (Fin.append U' V) : Set (Set Y)) :=
  (range_subset_range_append U' V).2

/-- If a finite family `U'` of retrocompact opens generates each `T' k` and `Tlast` is
constructible, then a single finite family of retrocompact opens generates every `T' k` together
with `Tlast`. -/
lemma exists_finite_retro_opens_succ_step
    {Y : Type*} [TopologicalSpace Y] {n : ℕ}
    (T' : Fin n → Set Y) (Tlast : Set Y)
    (hTlast : Topology.IsConstructible Tlast)
    {m' : ℕ} (U' : Fin m' → Set Y)
    (hU'_open : ∀ i, IsOpen (U' i)) (hU'_retro : ∀ i, IsRetrocompact (U' i))
    (hT' : ∀ k, T' k ∈ BooleanSubalgebra.closure
              ((Set.range U') : Set (Set Y))) :
    ∃ (m : ℕ) (U : Fin m → Set Y),
      (∀ i, IsOpen (U i)) ∧
      (∀ i, IsRetrocompact (U i)) ∧
      (∀ k : Fin n, T' k ∈ BooleanSubalgebra.closure
              ((Set.range U) : Set (Set Y))) ∧
      Tlast ∈ BooleanSubalgebra.closure
              ((Set.range U) : Set (Set Y)) := by
  have hTlast' :
      Tlast ∈ BooleanSubalgebra.closure
        ({U | IsOpen U ∧ IsRetrocompact U} : Set (Set Y)) := hTlast
  obtain ⟨mlast, V, hV_mem, hTlast_mem⟩ :=
    boolean_subalgebra_closure_finite_generation hTlast'
  exact ⟨m' + mlast, Fin.append U' V, forall_append hU'_open fun j => (hV_mem j).1,
    forall_append hU'_retro fun j => (hV_mem j).2,
    fun k => BooleanSubalgebra.closure_mono (range_subset_range_append_left U' V) (hT' k),
    BooleanSubalgebra.closure_mono (range_subset_range_append_right U' V) hTlast_mem⟩

/-- Given any finite family `T : Fin n → Set X` of constructible subsets, there
exists a finite family `U : Fin m → Set X` of retrocompact open subsets such that
every `T k` lies in the Boolean subalgebra generated by `Set.range U`. -/
lemma exists_finite_retro_opens_for_family
    {n : ℕ} (T : Fin n → Set X)
    (hT : ∀ k, Topology.IsConstructible (T k)) :
    ∃ (m : ℕ) (U : Fin m → Set X),
      (∀ i, IsOpen (U i)) ∧
      (∀ i, IsRetrocompact (U i)) ∧
      (∀ k, T k ∈ BooleanSubalgebra.closure
              ((Set.range U) : Set (Set X))) := by
  induction n with
  | zero => exact ⟨0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, fun k => k.elim0⟩
  | succ n ih =>
    obtain ⟨m', U', hU'_open, hU'_retro, hT'_mem⟩ := ih (fun k => T k.castSucc) fun k => hT _
    obtain ⟨m, U, hU_open, hU_retro, hT'_mem', hTlast_mem⟩ :=
      exists_finite_retro_opens_succ_step (fun k => T k.castSucc) (T (Fin.last n)) (hT _)
        U' hU'_open hU'_retro hT'_mem
    exact ⟨m, U, hU_open, hU_retro, fun k => Fin.lastCases hTlast_mem hT'_mem' k⟩

/-! ### Properties of the cell decomposition -/

omit [TopologicalSpace X] in
/-- A point lies in the cell of `a` exactly when, for every `i`, it lies in `U i` if `a i` is
`true` and outside `U i` otherwise. -/
lemma mem_cellOf_iff {m : ℕ} (U : Fin m → Set X) (a : Fin m → Bool) (x : X) :
    x ∈ cellOf U a ↔ ∀ i, x ∈ (if a i then U i else (U i)ᶜ) := by
  simp [cellOf, Set.mem_iInter]

omit [TopologicalSpace X] in
/-- If `a i = true` then the cell of `a` is contained in `U i`. -/
lemma cellOf_subset_of_true {m : ℕ} (U : Fin m → Set X) (a : Fin m → Bool)
    (i : Fin m) (ha : a i = true) : cellOf U a ⊆ U i :=
  fun x hx => by simpa [ha] using (mem_cellOf_iff U a x).1 hx i

omit [TopologicalSpace X] in
/-- If `a i = false` then the cell of `a` is contained in the complement of `U i`. -/
lemma cellOf_subset_compl_of_false {m : ℕ} (U : Fin m → Set X) (a : Fin m → Bool)
    (i : Fin m) (ha : a i = false) : cellOf U a ⊆ (U i)ᶜ :=
  fun x hx => by simpa [ha] using (mem_cellOf_iff U a x).1 hx i

omit [TopologicalSpace X] in
/-- Distinct cells are disjoint. -/
lemma cellOf_disjoint {m : ℕ} (U : Fin m → Set X) :
    Pairwise (Function.onFun Disjoint (cellOf U)) := by
  intro a b hab
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hab
  refine Set.disjoint_left.mpr fun x hxa hxb => ?_
  have ha := (mem_cellOf_iff U a x).1 hxa i
  have hb := (mem_cellOf_iff U b x).1 hxb i
  cases h : a i <;> cases h' : b i <;> simp_all

omit [TopologicalSpace X] in
/-- The cells cover `X`. -/
lemma iUnion_cellOf_eq_univ {m : ℕ} (U : Fin m → Set X) :
    ⋃ a, cellOf U a = (Set.univ : Set X) := by
  classical
  refine Set.eq_univ_of_forall (fun x => ?_)
  refine Set.mem_iUnion.mpr ⟨fun i => decide (x ∈ U i), ?_⟩
  simp only [cellOf, Set.mem_iInter]
  intro i
  by_cases h : x ∈ U i <;> simp [h]

omit [TopologicalSpace X] in
/-- The truth-table function `fun i => decide (x ∈ U i)` puts `x` into the
corresponding cell. -/
lemma mem_cellOf_decide {m : ℕ} (U : Fin m → Set X) (x : X) :
    x ∈ cellOf U (fun i => @decide (x ∈ U i) (Classical.propDecidable _)) := by
  simp only [cellOf, mem_iInter]
  intro i
  by_cases h : x ∈ U i <;> simp [h]

/-- Pointwise Bool ordering: if `a i = false` whenever `b i = false`, then `a ≤ b`. -/
lemma le_of_false_imp_false {m : ℕ} (a b : Fin m → Bool)
    (h : ∀ i, b i = false → a i = false) : a ≤ b := by
  intro i
  cases hb : b i with
  | false => rw [h i hb]
  | true => exact Bool.le_true _

/-- For open `U i` with `b i = false`, the closure of the cell of `b` still lies in the
complement of `U i`. -/
lemma closure_cellOf_subset_compl_of_false {m : ℕ}
    (U : Fin m → Set X) (hU : ∀ i, IsOpen (U i))
    (b : Fin m → Bool) (i : Fin m) (hb : b i = false) :
    closure (cellOf U b) ⊆ (U i)ᶜ :=
  (hU i).isClosed_compl.closure_subset_iff.mpr (cellOf_subset_compl_of_false U b i hb)

/-- The closure of the cell of `b` is covered by the cells of the truth tables `a ≤ b`. -/
lemma closure_cellOf_subset {m : ℕ} (U : Fin m → Set X)
    (hU : ∀ i, IsOpen (U i)) (b : Fin m → Bool) :
    closure (cellOf U b) ⊆ ⋃ a ∈ {a : Fin m → Bool | a ≤ b}, cellOf U a := by
  intro x hx
  refine mem_iUnion₂.mpr
    ⟨fun i => @decide (x ∈ U i) (Classical.propDecidable _),
      le_of_false_imp_false _ _ fun i hbi => ?_, mem_cellOf_decide U x⟩
  exact @decide_eq_false (x ∈ U i) (Classical.propDecidable _)
    (closure_cellOf_subset_compl_of_false U hU b i hbi hx)

/-- A cell of a finite family of retrocompact opens is constructible. -/
lemma cellOf_isConstructible {m : ℕ} (U : Fin m → Set X)
    (hOpen : ∀ i, IsOpen (U i)) (hRetro : ∀ i, IsRetrocompact (U i))
    (a : Fin m → Bool) :
    Topology.IsConstructible (cellOf U a) := by
  unfold cellOf
  apply Topology.IsConstructible.iInter
  intro i
  have hUi := IsRetrocompact.isConstructible (hOpen i) (hRetro i)
  cases a i
  · simpa using hUi.compl
  · simpa using hUi

/-! ### Elements of `BooleanSubalgebra.closure (Set.range U)` as unions of cells -/

/-- The collection of subsets of `X` of the form `⋃ a ∈ I, cellOf U a`. -/
def unionsOfCells {m : ℕ} (U : Fin m → Set X) : Set (Set X) :=
  {E | ∃ I : Set (Fin m → Bool), E = ⋃ a ∈ I, cellOf U a}

/-- A point lying in the cells of `a` and `b` forces `a = b`. -/
private theorem eq_of_mem_cellOf {Y : Type*} {m : ℕ} {U : Fin m → Set Y} {a b : Fin m → Bool}
    {x : Y} (ha : x ∈ cellOf U a) (hb : x ∈ cellOf U b) : a = b :=
  not_not.mp fun hab => (cellOf_disjoint U hab).le_bot ⟨ha, hb⟩

omit [TopologicalSpace X] in
/-- The empty set is a union of cells. -/
lemma empty_mem_unionsOfCells {m : ℕ} (U : Fin m → Set X) :
    (∅ : Set X) ∈ unionsOfCells U :=
  ⟨∅, by simp⟩

omit [TopologicalSpace X] in
/-- Unions of cells are closed under pairwise union. -/
lemma unionsOfCells_supClosed {m : ℕ} (U : Fin m → Set X) :
    SupClosed (unionsOfCells U) := by
  rintro E ⟨I, rfl⟩ F ⟨J, rfl⟩
  exact ⟨I ∪ J, (Set.biUnion_union I J _).symm⟩

omit [TopologicalSpace X] in
/-- Unions of cells are closed under pairwise intersection. -/
lemma unionsOfCells_infClosed {m : ℕ} (U : Fin m → Set X) :
    InfClosed (unionsOfCells U) := by
  classical
  rintro E ⟨I, rfl⟩ F ⟨J, rfl⟩
  refine ⟨I ∩ J, ?_⟩
  ext x
  refine ⟨fun ⟨hxI, hxJ⟩ => ?_, fun hx => ?_⟩
  · obtain ⟨a, haI, hxa⟩ := Set.mem_iUnion₂.mp hxI
    obtain ⟨b, hbJ, hxb⟩ := Set.mem_iUnion₂.mp hxJ
    obtain rfl := eq_of_mem_cellOf hxa hxb
    exact Set.mem_iUnion₂.mpr ⟨a, ⟨haI, hbJ⟩, hxa⟩
  · obtain ⟨a, ⟨haI, haJ⟩, hxa⟩ := Set.mem_iUnion₂.mp hx
    exact ⟨Set.mem_iUnion₂.mpr ⟨a, haI, hxa⟩, Set.mem_iUnion₂.mpr ⟨a, haJ, hxa⟩⟩

omit [TopologicalSpace X] in
/-- The complement of a union of cells is a union of cells. -/
lemma unionsOfCells_compl_mem {m : ℕ} (U : Fin m → Set X)
    {E : Set X} (hE : E ∈ unionsOfCells U) :
    Eᶜ ∈ unionsOfCells U := by
  classical
  obtain ⟨I, rfl⟩ := hE
  refine ⟨Iᶜ, ?_⟩
  ext x
  refine ⟨fun hx => ?_, fun hx hxE => ?_⟩
  · have hxa := mem_cellOf_decide U x
    exact Set.mem_iUnion₂.mpr ⟨_, fun haI => hx (Set.mem_iUnion₂.mpr ⟨_, haI, hxa⟩), hxa⟩
  · obtain ⟨a, haIc, hxa⟩ := Set.mem_iUnion₂.mp hx
    obtain ⟨b, hbI, hxb⟩ := Set.mem_iUnion₂.mp hxE
    obtain rfl := eq_of_mem_cellOf hxa hxb
    exact haIc hbI

omit [TopologicalSpace X] in
/-- Each `U i` is the union of the cells whose truth table takes the value `true` at `i`. -/
lemma U_mem_unionsOfCells {m : ℕ} (U : Fin m → Set X) (i : Fin m) :
    U i ∈ unionsOfCells U := by
  classical
  refine ⟨{a | a i = true}, ?_⟩
  ext x
  refine ⟨fun hx => Set.mem_iUnion₂.mpr
      ⟨fun j => @decide (x ∈ U j) (Classical.propDecidable _),
        @decide_eq_true (x ∈ U i) (Classical.propDecidable _) hx, mem_cellOf_decide U x⟩,
    fun hx => ?_⟩
  obtain ⟨a, haTrue, hxa⟩ := Set.mem_iUnion₂.mp hx
  exact cellOf_subset_of_true U a i haTrue hxa

/-- Bundle the collection of unions of cells as a Boolean subalgebra of `Set X`. -/
def unionsOfCellsSubalgebra {m : ℕ} (U : Fin m → Set X) :
    BooleanSubalgebra (Set X) where
  carrier := unionsOfCells U
  supClosed' := unionsOfCells_supClosed U
  infClosed' := unionsOfCells_infClosed U
  compl_mem' := fun ha => unionsOfCells_compl_mem U ha
  bot_mem' := empty_mem_unionsOfCells U

omit [TopologicalSpace X] in
/-- Every element of the Boolean subalgebra generated by `Set.range U` is a union of cells. -/
lemma exists_iUnion_cellOf_of_mem_closure
    {m : ℕ} (U : Fin m → Set X) (E : Set X)
    (hE : E ∈ BooleanSubalgebra.closure ((Set.range U) : Set (Set X))) :
    ∃ I : Set (Fin m → Bool), E = ⋃ a ∈ I, cellOf U a :=
  (BooleanSubalgebra.closure_le.mpr (Set.range_subset_iff.2 (U_mem_unionsOfCells U)) :
    BooleanSubalgebra.closure (Set.range U) ≤ unionsOfCellsSubalgebra U) hE

/-! ### Main statement -/

/-- **Stacks 09Y4**.
If a topological space `X` is covered by a finite family `T₁, …, Tₙ` of
constructible subsets, then there exists a finite stratification `X = ⨆ Xᵢ` such
that each stratum is constructible and each `Tₖ` is a union of strata. -/
@[stacks 09Y4]
theorem exists_finiteStratification_refining_constructible
    {n : ℕ} (T : Fin n → Set X)
    (hT : ∀ k, Topology.IsConstructible (T k))
    (_hcover : ⋃ k, T k = Set.univ) :
    ∃ (𝒮 : FiniteStratification X),
      (∀ i, Topology.IsConstructible (𝒮.S i)) ∧
      (∀ k, ∃ I : Set 𝒮.ι, T k = ⋃ i ∈ I, 𝒮.S i) := by
  obtain ⟨m, U, hOpen, hRetro, hClosure⟩ := exists_finite_retro_opens_for_family T hT
  exact ⟨{
      ι := Fin m → Bool
      fintype := inferInstance
      partialOrder := inferInstance
      S := cellOf U
      disjoint := cellOf_disjoint U
      iUnion_eq_univ := iUnion_cellOf_eq_univ U
      closure_subset := closure_cellOf_subset U hOpen
    }, cellOf_isConstructible U hOpen hRetro,
    fun k => exists_iUnion_cellOf_of_mem_closure U (T k) (hClosure k)⟩

