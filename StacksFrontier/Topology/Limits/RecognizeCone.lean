module

public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.Topology.Category.TopCat.Limits.Basic

/-!
# Recognizing a limit cone of topological spaces

A cone on a cofiltered diagram of topological spaces is a limit cone as soon as it is one on
underlying sets and its topology is the one generated by the preimages of opens of the factors.
Both sides are compared as `TopologicalSpace.generateFrom` of the same family of preimages.

## Main results

* `TopCat.isLimit_of_basis_of_preimages` (Stacks 0A2Q): a cone `c` whose image under the forgetful
  functor is a limit cone and for which the preimages `c.π.app j ⁻¹' V` of opens form a topological
  basis of `c.pt` is a limit cone in `TopCat`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe v u w

namespace TopCat

/-- **Stacks 0A2Q.** Let `J` be a cofiltered category, let `F : J ⥤ TopCat` be a diagram of
topological spaces, and let `c` be a cone on `F`. Assume:
1. the underlying type-level cone `(forget).mapCone c` is a limit cone, so `c.pt` is the
   set-theoretic limit with projections `c.π.app j`, and
2. the family of preimages `c.π.app j ⁻¹' V`, for `j : J` and `V` open in `F.obj j`, is a
   topological basis for `c.pt`.

Then `c` is a limit cone in `TopCat`. -/
@[stacks 0A2Q]
theorem isLimit_of_basis_of_preimages
    {J : Type v} [Category.{w} J] [IsCofiltered J]
    {F : J ⥤ TopCat.{u}} (c : Cone F)
    (hForget : IsLimit ((CategoryTheory.forget TopCat.{u}).mapCone c))
    (hBasis : IsTopologicalBasis
      {U : Set c.pt | ∃ (j : J) (V : Set (F.obj j)), IsOpen V ∧ U = c.π.app j ⁻¹' V}) :
    Nonempty (IsLimit c) := by
  rw [nonempty_isLimit_iff_eq_induced c hForget]
  -- It suffices to show `c.pt.str = ⨅ j, induced (c.π.app j) (F.obj j).str`; both sides are
  -- `generateFrom` of the family of preimages of opens.
  have hgen_basis : c.pt.str =
      generateFrom {U : Set c.pt | ∃ (j : J) (V : Set (F.obj j)), IsOpen V ∧ U = c.π.app j ⁻¹' V} :=
    hBasis.eq_generateFrom
  have hiInf_gen :
      (⨅ j, (F.obj j).str.induced (c.π.app j)) =
        generateFrom
          {U : Set c.pt | ∃ (j : J) (V : Set (F.obj j)), IsOpen V ∧ U = c.π.app j ⁻¹' V} := by
    -- Each induced topology equals `generateFrom (preimage (c.π.app j) '' {V | IsOpen V})`.
    have h_each : ∀ j : J, (F.obj j).str.induced (c.π.app j) =
        generateFrom (Set.preimage (c.π.app j) '' {V : Set (F.obj j) | IsOpen V}) := by
      intro j
      conv_lhs => rw [show (F.obj j).str = generateFrom {V : Set (F.obj j) | IsOpen V} from
        isTopologicalBasis_opens.eq_generateFrom]
      exact induced_generateFrom_eq
    calc (⨅ j, (F.obj j).str.induced (c.π.app j))
        = ⨅ j : J, generateFrom
            (Set.preimage (c.π.app j) '' {V : Set (F.obj j) | IsOpen V}) := iInf_congr h_each
      _ = generateFrom
            (⋃ j : J, Set.preimage (c.π.app j) '' {V : Set (F.obj j) | IsOpen V}) := by
              rw [generateFrom_iUnion]
      _ = generateFrom
            {U : Set c.pt | ∃ (j : J) (V : Set (F.obj j)), IsOpen V ∧ U = c.π.app j ⁻¹' V} := by
              congr 1
              ext U
              simp only [Set.mem_iUnion, Set.mem_image, Set.mem_ofPred_eq]
              constructor
              · rintro ⟨j, V, hV, rfl⟩
                exact ⟨j, V, hV, rfl⟩
              · rintro ⟨j, V, hV, hU⟩
                exact ⟨j, V, hV, hU.symm⟩
  rw [hgen_basis, hiInf_gen]

end TopCat
