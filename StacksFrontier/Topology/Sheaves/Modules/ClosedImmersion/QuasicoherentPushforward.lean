/-!
# Pushforward of a quasi-coherent module along a closed immersion

Let `i : (Z, 𝒪_Z) ⟶ (X, 𝒪_X)` be a closed immersion of ringed spaces in the sense of Stacks
01C2 and let `F` be a quasi-coherent sheaf of `𝒪_Z`-modules. This file proves that `i_* F` is,
locally on `X`, the cokernel of a morphism of quasi-coherent sheaves of `𝒪_X`-modules.

## Shape of the argument

Quasi-coherence of a sheaf of modules is the existence, locally, of a presentation by free
sheaves of modules, so the statement is proved by producing such a presentation on a suitable
neighbourhood of each point of `X` and pushing it forward. Three ingredients are needed.

* Pushforward along `i`, restricted to an open `U` of `X`, preserves colimits. Over the closed
  subspace this is Stacks 01AZ
  (`ClosedImmersionSheaves.closedInclusionPushforward_preservesColimits`); the content here is
  to transport it along the factorisation of `i` through its image and along the equivalence
  between sheaves on an open `U` and sheaves on the over-site of `U`
  (`TopologicalSpace.Opens.sheafEquivOver`).
* A colimit-preserving functor carries a presentation of `M` to a presentation of its image,
  provided one knows a presentation of the image of the unit module. That is
  `exists_cokernel_of_presentations`, using that a free sheaf of modules is a coproduct of
  copies of the unit and that a copower of a presentation is a presentation.
* A presentation of `i_* 𝒪_Z` over `U`: the ideal sheaf of `i` is locally generated by
  sections, and `𝒪_X ⟶ i_* 𝒪_Z` is an epimorphism with that ideal sheaf as kernel, so on an
  open where the generators exist `i_* 𝒪_Z` is a cokernel of free sheaves
  (`presentationPushforwardUnit`).

Off the image of `i` the pushforward restricts to the zero sheaf
(`isZero_pushforward_over_compl_range`), and the zero sheaf is quasi-coherent, so the
complement of the image serves as the neighbourhood there.

## Main results

* `ClosedImmersionSheaves.exists_local_cokernel_presentation_pushforward`: **Stacks 01C3**, the
  local quasi-coherent cokernel presentation of the pushforward.

## Implementation notes

Locality is expressed pointwise by an open neighbourhood, and a module on that neighbourhood is
a sheaf of modules on the over-site of the open, as in Mathlib's restriction API; the cokernel
is identified with the restriction of the pushforward up to isomorphism rather than on the nose.
Everything is read at `RingedSpace.{u, u}`, as required by
`StacksFrontier/Topology/Sheaves/Functors/Module/RingedSpace.lean`.

## References

* [Stacks Project, Tag 01C3](https://stacks.math.columbia.edu/tag/01C3)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open RingedSpaceModuleAdjunction
open scoped ZeroObject

universe u

namespace ClosedImmersionSheaves

/-- The inverse-image functor on opens of a continuous map is continuous for the open-cover
topologies. -/
private theorem opensMap_isContinuous {Z X : TopCat.{u}} (i : Z ⟶ X) :
    (Opens.map i).IsContinuous (Opens.grothendieckTopology X)
      (Opens.grothendieckTopology Z) := inferInstance

/-- Pushforward of abelian sheaves along a closed embedding preserves all colimits: factor the
embedding as a homeomorphism onto its image followed by the inclusion of that image, and apply
Stacks 01AZ to the inclusion. -/
private theorem sheafPushforward_preservesColimits_of_closedEmbedding
    {Z X : TopCat.{u}} (i : Z ⟶ X) (hi : Topology.IsClosedEmbedding i.hom) :
    PreservesColimitsOfSize.{u, u} (TopCat.Sheaf.pushforward AddCommGrpCat.{u} i) := by
  let Z' : TopCat.{u} := TopCat.of (Set.range i.hom)
  let e : Z ≅ Z' := TopCat.isoOfHomeo (hi.isEmbedding.toHomeomorph)
  let j : Z' ⟶ X := TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩
  have hfac : e.hom ≫ j = i := by
    ext z
    rfl
  have : (Opens.mapMapIso e).functor.IsContinuous
      (Opens.grothendieckTopology Z') (Opens.grothendieckTopology Z) :=
    opensMap_isContinuous e.hom
  have : (Opens.mapMapIso e).inverse.IsContinuous
      (Opens.grothendieckTopology Z) (Opens.grothendieckTopology Z') :=
    opensMap_isContinuous e.inv
  have : (Opens.map j).IsContinuous (Opens.grothendieckTopology X)
      (Opens.grothendieckTopology Z') := opensMap_isContinuous j
  have : (Opens.map e.hom).IsContinuous (Opens.grothendieckTopology Z')
      (Opens.grothendieckTopology Z) := opensMap_isContinuous e.hom
  have he : PreservesColimitsOfSize.{u, u}
      (TopCat.Sheaf.pushforward AddCommGrpCat.{u} e.hom) :=
    ((Opens.mapMapIso e).toAdjunction.sheafPushforwardContinuous
      (Opens.grothendieckTopology Z') (Opens.grothendieckTopology Z)).leftAdjoint_preservesColimits
  have hj : PreservesColimitsOfSize.{u, u} (TopCat.Sheaf.pushforward AddCommGrpCat.{u} j) :=
    closedInclusionPushforward_preservesColimits (Set.range i.hom) hi.isClosed_range
  have hfacIso : TopCat.Sheaf.pushforward AddCommGrpCat.{u} i ≅
      TopCat.Sheaf.pushforward AddCommGrpCat.{u} e.hom ⋙
        TopCat.Sheaf.pushforward AddCommGrpCat.{u} j := by
    dsimp [TopCat.Sheaf.pushforward]
    rw [← hfac]
    exact (Functor.sheafPushforwardContinuousComp'
      (Opens.mapComp e.hom j).symm _ _ _ _).symm
  exact preservesColimits_of_natIso hfacIso.symm

/-- The functor on slice categories induced by the inverse-image functor on opens is continuous
for the over-topologies: the inverse-image functor on opens is flat, hence preserves finite
limits and one-hypercovers, and both properties are inherited by slices. -/
private theorem overPost_isContinuous {Z X : TopCat.{u}} (i : Z ⟶ X)
    (U : Opens X) :
    (Over.post (Opens.map i) (X := U)).IsContinuous
      ((Opens.grothendieckTopology X).over U)
      ((Opens.grothendieckTopology Z).over ((Opens.map i).obj U)) := by
  let G := Opens.map i
  have : PreservesFiniteLimits G := CategoryTheory.preservesFiniteLimits_of_flat G
  have : G.PreservesOneHypercovers (Opens.grothendieckTopology X)
      (Opens.grothendieckTopology Z) :=
    Functor.PreservesOneHypercovers.of_coverPreserving (coverPreserving_opens_map _)
  have : (Over.post G (X := U)).PreservesOneHypercovers
      ((Opens.grothendieckTopology X).over U)
      ((Opens.grothendieckTopology Z).over (G.obj U)) := inferInstance
  infer_instance

attribute [local instance] overPost_isContinuous

/-- Pushforward of abelian sheaves along a closed embedding, read on the over-sites of an open
`U` of the target and its preimage, preserves all colimits. Through
`TopologicalSpace.Opens.sheafEquivOver` it is the pushforward along the restriction of the
embedding to those two open subspaces, which is again a closed embedding. -/
private theorem sheafPushforwardOver_preservesColimits
    {Z X : TopCat.{u}} (i : Z ⟶ X) (hi : Topology.IsClosedEmbedding i.hom)
    (U : Opens X) :
    PreservesColimitsOfSize.{u, u}
      ((Over.post (Opens.map i) (X := U)).sheafPushforwardContinuous AddCommGrpCat.{u}
        ((Opens.grothendieckTopology X).over U)
        ((Opens.grothendieckTopology Z).over ((Opens.map i).obj U))) := by
  let V := (Opens.map i).obj U
  let j : TopCat.of V ⟶ TopCat.of U := TopCat.ofHom (i.hom.restrictPreimage U)
  have hj : Topology.IsClosedEmbedding j.hom :=
    Topology.IsClosedEmbedding.restrictPreimage (U : Set X) hi
  let T := (Over.post (Opens.map i) (X := U)).sheafPushforwardContinuous AddCommGrpCat.{u}
    ((Opens.grothendieckTopology X).over U) ((Opens.grothendieckTopology Z).over V)
  let e : U.overEquivalence.inverse ⋙ Over.post (Opens.map i) ≅
      Opens.map j ⋙ V.overEquivalence.inverse := by
    refine NatIso.ofComponents (fun W ↦ Over.isoMk (eqToIso ?_))
    ext z
    show (∃ y : U, y ∈ W ∧ y.val = i.hom z) ↔
      (∃ t : V, j.hom t ∈ W ∧ t.val = z)
    constructor
    · rintro ⟨y, hy, h⟩
      have hz : i.hom z ∈ U := h ▸ y.property
      refine ⟨⟨z, hz⟩, ?_, rfl⟩
      simpa only [show j.hom ⟨z, hz⟩ = y from Subtype.ext h.symm] using hy
    · rintro ⟨t, ht, rfl⟩
      exact ⟨j.hom t, ht, rfl⟩
  have : (Opens.map j).IsContinuous (Opens.grothendieckTopology U)
      (Opens.grothendieckTopology V) := opensMap_isContinuous j
  have : (U.overEquivalence.inverse ⋙ Over.post (Opens.map i)).IsContinuous
      (Opens.grothendieckTopology U) ((Opens.grothendieckTopology Z).over V) :=
    Functor.isContinuous_comp _ _ _ ((Opens.grothendieckTopology X).over U) _
  have : (Opens.map j ⋙ V.overEquivalence.inverse).IsContinuous
      (Opens.grothendieckTopology U) ((Opens.grothendieckTopology Z).over V) :=
    Functor.isContinuous_comp _ _ _ (Opens.grothendieckTopology V) _
  let E := U.sheafEquivOver (A := AddCommGrpCat.{u})
  let D := V.sheafEquivOver (A := AddCommGrpCat.{u})
  have eT : T ⋙ E.functor ≅ D.functor ⋙ TopCat.Sheaf.pushforward AddCommGrpCat.{u} j :=
    Functor.sheafPushforwardContinuousComp _ _ _ _ _ _ ≪≫
      Functor.sheafPushforwardContinuousIso e _ _ _ ≪≫
        (Functor.sheafPushforwardContinuousComp _ _ _ _ _ _).symm
  have hcomp : PreservesColimitsOfSize.{u, u}
      (D.functor ⋙ TopCat.Sheaf.pushforward AddCommGrpCat.{u} j) :=
    @comp_preservesColimits _ _ _ _ _ _ D.functor _ (by infer_instance)
      (sheafPushforward_preservesColimits_of_closedEmbedding j hj)
  have : PreservesColimitsOfSize.{u, u} (T ⋙ E.functor) :=
    @preservesColimits_of_natIso _ _ _ _ _ _ eT.symm hcomp
  exact preservesColimits_of_reflects_of_preserves T E.functor

/-- Pushforward of sheaves of modules along a morphism of ringed spaces, read on the over-site
of an open `U` of the target. -/
private noncomputable abbrev overPushforward
    {Z X : RingedSpace.{u, u}} (i : Z ⟶ X) (U : Opens X.carrier) :=
  SheafOfModules.pushforward.{u} (Stacks.SheafOfModules.overStructureSheafHom i U)

/-- Pushforward of sheaves of modules along a closed immersion, read on the over-site of an open
of the target, preserves all colimits: forgetting to abelian sheaves both preserves and reflects
colimits, and the composite is the abelian-sheaf pushforward. -/
private theorem overPushforward_preservesColimits
    {Z X : RingedSpace.{u, u}} (i : Z ⟶ X)
    (hi : Topology.IsClosedEmbedding i.hom.base) (U : Opens X.carrier) :
    PreservesColimitsOfSize.{u, u} (overPushforward i U) := by
  let G := SheafOfModules.toSheaf.{u} ((structureSheafRing X).over U)
  let H := SheafOfModules.toSheaf.{u} ((structureSheafRing Z).over ((Opens.map i.hom.base).obj U))
  let T := (Over.post (Opens.map i.hom.base) (X := U)).sheafPushforwardContinuous
    AddCommGrpCat.{u} ((Opens.grothendieckTopology X.carrier).over U)
      ((Opens.grothendieckTopology Z.carrier).over ((Opens.map i.hom.base).obj U))
  have : PreservesColimitsOfSize.{u, u} T :=
    sheafPushforwardOver_preservesColimits i.hom.base hi U
  have : PreservesColimitsOfSize.{u, u} (overPushforward i U ⋙ G) :=
    preservesColimits_of_natIso (Iso.refl (H ⋙ T))
  have : ReflectsColimitsOfSize.{u, u} G := reflectsColimits_of_reflectsIsomorphisms
  exact preservesColimits_of_reflects_of_preserves (overPushforward i U) G

section Presentations

open SheafOfModules

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{u}} [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- A cokernel presentation of `M` by two sheaves of modules that are free produces a
`SheafOfModules.Presentation` of `M`. -/
private noncomputable def presentationOfIsCokernel
    {A B M : SheafOfModules.{u} R} (f : A ⟶ B) (g : B ⟶ M)
    (h : f ≫ g = 0) (hc : IsColimit (CokernelCofork.ofπ g h))
    {I K : Type u} (a : free I ≅ A) (b : free K ≅ B) : M.Presentation := by
  let f' := a.hom ≫ f ≫ b.inv
  let g' := b.hom ≫ g
  refine presentationOfIsCokernelFree f' g' (by simp [f', g', h]) ?_
  refine IsColimit.equivOfNatIsoOfIso
    (parallelPairIsoMk a.symm b.symm (by simp [f']) (by simp)) _ _ ?_ hc
  exact Cocone.ext (Iso.refl _) (by rintro (_ | _) <;> simp [f', g', parallelPairIsoMk])

/-- A copower of a presented sheaf of modules is presented, by the corresponding copower of the
presentation. -/
private noncomputable def presentationCopower {M : SheafOfModules.{u} R}
    (P : M.Presentation) (I : Type u) :
    (∐ fun (_ : I) ↦ M).Presentation := by
  let T : SheafOfModules.{u} R ⥤ SheafOfModules.{u} R :=
    Functor.const (Discrete I) ⋙ colim
  have : PreservesColimitsOfSize.{u, u} T := by
    dsimp [T]
    infer_instance
  have : PreservesColimitsOfSize.{0, 0} T := preservesColimitsOfSize_shrink T
  let e (N : SheafOfModules.{u} R) : T.obj N ≅ ∐ fun (_ : I) ↦ N :=
    HasColimit.isoOfNatIso (Discrete.natIso fun _ ↦ Iso.refl _)
  let f := P.relations.π ≫ kernel.ι P.generators.π
  have h : f ≫ P.generators.π = 0 := by simp [f]
  apply Presentation.ofIsIso (e M).hom
  exact presentationOfIsCokernel (T.map f) (T.map P.generators.π)
    (by simp [← T.map_comp, h])
    (isColimitCoforkMapOfIsColimit' T h P.isColimit)
    ((sigmaSigmaIso (fun (_ : I) ↦ P.relations.I) (fun _ _ ↦ unit R)).symm ≪≫
      (e _).symm)
    ((sigmaSigmaIso (fun (_ : I) ↦ P.generators.I) (fun _ _ ↦ unit R)).symm ≪≫
      (e _).symm)

/-- The zero sheaf of modules is presented, by the empty free sheaf. -/
private noncomputable def presentationOfIsZero {M : SheafOfModules.{u} R}
    (hM : IsZero M) : M.Presentation :=
  presentationOfIsCokernelFree (𝟙 (free PEmpty.{u + 1}))
    (0 : free PEmpty.{u + 1} ⟶ M) (by simp)
    (CokernelCofork.IsColimit.ofEpiOfIsZero _ inferInstance hM)

end Presentations

/-- A family of opens that covers the whole space contains a member around every point. -/
private theorem exists_mem_of_coversTop {X : Type u} [TopologicalSpace X]
    {I : Type u} (U : I → Opens X)
    (hU : (Opens.grothendieckTopology X).CoversTop U) (x : X) :
    ∃ j, x ∈ U j := by
  have hTop : iSup U = ⊤ := by rwa [Opens.coversTop_iff] at hU
  simpa only [Opens.mem_iSup, Opens.mem_top, eq_iff_iff, iff_true] using
    congrArg (fun V : Opens X ↦ x ∈ V) hTop

/-- A presentation of a sheaf of modules over an open `V` restricts to a presentation over a
smaller open `U`. -/
private noncomputable def restrictPresentation
    {X : Type u} [TopologicalSpace X]
    {R : Sheaf (Opens.grothendieckTopology X) RingCat.{u}}
    {M : SheafOfModules.{u} R} {U V : Opens X} (h : U ≤ V)
    (P : (M.over V).Presentation) : (M.over U).Presentation :=
  ((P.map (SheafOfModules.overMap R (homOfLE h)) (Iso.refl _)).ofIsIso
    ((SheafOfModules.overFunctorMap R (homOfLE h)).hom.app M))

/-- Generating sections of a sheaf of modules over an open `V` restrict to generating sections
over a smaller open `U`. -/
private noncomputable def restrictGenerators
    {X : Type u} [TopologicalSpace X]
    {R : Sheaf (Opens.grothendieckTopology X) RingCat.{u}}
    {M : SheafOfModules.{u} R} {U V : Opens X} (h : U ≤ V)
    (P : (M.over V).GeneratingSections) : (M.over U).GeneratingSections :=
  (P.map (SheafOfModules.overMap R (homOfLE h)) (Iso.refl _)).ofEpi
    ((SheafOfModules.overFunctorMap R (homOfLE h)).hom.app M)

/-- A presentation of `i_* 𝒪_Z` over an open `U` of `X`, given generating sections of the ideal
sheaf of the closed immersion `i` there: the structure-sheaf map is an epimorphism, so `i_* 𝒪_Z`
is the cokernel of the inclusion of its kernel, and the generators present that kernel. -/
private noncomputable def presentationPushforwardUnit
    {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) [SheafOfModules.IsClosedImmersion i]
    (U : Opens X.carrier)
    (g : ((SheafOfModules.idealSheaf i).over U).GeneratingSections) :
    ((overPushforward i U).obj (SheafOfModules.unit
      ((structureSheafRing Z).over ((Opens.map i.hom.base).obj U)))).Presentation := by
  let q := SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)
  let G := SheafOfModules.overFunctor.{u} (structureSheafRing X) U
  change (G.obj ((SheafOfModules.pushforward (structureSheafHom i)).obj
    (SheafOfModules.unit (structureSheafRing Z)))).Presentation
  have : G.PreservesZeroMorphisms := by
    dsimp [G, SheafOfModules.overFunctor]
    infer_instance
  have : PreservesColimitsOfSize.{u, u} G := by
    dsimp [G, SheafOfModules.overFunctor]
    infer_instance
  have : PreservesColimitsOfSize.{0, 0} G := preservesColimitsOfSize_shrink G
  have : Epi q := inferInstance
  have : Epi g.π := g.epi
  have hc := isColimitCoforkMapOfIsColimit' G (kernel.condition q)
    (Abelian.epiIsCokernelOfKernel
      (KernelFork.ofι (kernel.ι q) (kernel.condition q)) (kernelIsKernel q))
  exact presentationOfIsCokernel (g.π ≫ G.map (kernel.ι q)) (G.map q)
    (by simp [Category.assoc, ← G.map_comp]) (isCokernelEpiComp hc g.π rfl)
    (Iso.refl _) (coproductUniqueIso
      (fun (_ : PUnit.{u + 1}) ↦ SheafOfModules.unit ((structureSheafRing X).over U)))

/-- A colimit-preserving functor between categories of sheaves of modules carries a presented
sheaf of modules to a cokernel of two quasi-coherent sheaves of modules, as soon as the image of
the unit module is presented: the image of a free sheaf is then a copower of that presentation,
hence quasi-coherent. -/
private theorem exists_cokernel_of_presentations
    {C D : Type u} [Category.{u} C] [Category.{u} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    {R : Sheaf J RingCat.{u}} {S : Sheaf K RingCat.{u}}
    [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    [HasSheafify K AddCommGrpCat.{u}] [K.WEqualsLocallyBijective AddCommGrpCat.{u}]
    [HasBinaryProducts D]
    [∀ X, HasSheafify (K.over X) AddCommGrpCat.{u}]
    [∀ X, (K.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]
    (T : SheafOfModules.{u} R ⥤ SheafOfModules.{u} S)
    [PreservesColimitsOfSize.{u, u} T]
    {M : SheafOfModules.{u} R} (P : M.Presentation)
    (Q : (T.obj (SheafOfModules.unit R)).Presentation) :
    ∃ (A B : SheafOfModules.{u} S), A.IsQuasicoherent ∧ B.IsQuasicoherent ∧
      ∃ (f : A ⟶ B), Nonempty (cokernel f ≅ T.obj M) := by
  have : PreservesColimitsOfSize.{0, 0} T := preservesColimitsOfSize_shrink T
  have h (I : Type u) : (T.obj (SheafOfModules.free (R := R) I)).IsQuasicoherent :=
    ((presentationCopower Q I).ofIsIso
      ((sigmaConstObjCompIso T (SheafOfModules.unit R)).app I).inv).isQuasicoherent
  let f := P.relations.π ≫ kernel.ι P.generators.π
  exact ⟨_, _, h P.relations.I, h P.generators.I, T.map f,
    ⟨(cokernelIsCokernel (T.map f)).coconePointUniqueUpToIso
      (isColimitCoforkMapOfIsColimit' T (by simp [f]) P.isColimit)⟩⟩

/-- Off the image of a closed embedding the pushforward of a sheaf of modules restricts to the
zero sheaf: every open of the complement has empty preimage. -/
private theorem isZero_pushforward_over_compl_range
    {X Z : RingedSpace.{u, u}} (i : Z ⟶ X)
    (hi : Topology.IsClosedEmbedding i.hom.base)
    (F : SheafOfModules.{u} (structureSheafRing Z)) :
    IsZero (((modulePushforward i).obj F).over
      ⟨(Set.range i.hom.base)ᶜ, hi.isClosed_range.isOpen_compl⟩) := by
  apply (IsZero.iff_id_eq_zero _).mpr
  ext W m
  have he : (Opens.map i.hom.base).obj W.unop.left = ⊥ :=
    le_bot_iff.mp fun z hz ↦ (leOfHom W.unop.hom hz ⟨z, rfl⟩).elim
  exact ConcreteCategory.congr_hom ((TopCat.Sheaf.isTerminalOfEqEmpty
    ((SheafOfModules.toSheaf (structureSheafRing Z)).obj F) he).hom_ext (𝟙 _) 0) m

/-- **Stacks Project, Tag 01C3.** The pushforward of a quasi-coherent module along a
closed immersion is locally a cokernel of quasi-coherent modules. -/
@[stacks 01C3]
theorem exists_local_cokernel_presentation_pushforward
    {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) [SheafOfModules.IsClosedImmersion i]
    (F : SheafOfModules.{u} (structureSheafRing Z)) [F.IsQuasicoherent] (x : X.carrier) :
    ∃ U : Opens X.carrier, x ∈ U ∧
      ∃ (A B : SheafOfModules.{u} ((structureSheafRing X).over U)),
        A.IsQuasicoherent ∧ B.IsQuasicoherent ∧
          ∃ (f : A ⟶ B), Nonempty (cokernel f ≅ ((modulePushforward i).obj F).over U) := by
  have hi := SheafOfModules.IsClosedImmersion.isClosedEmbedding (i := i)
  by_cases hx : x ∈ Set.range i.hom.base
  · obtain ⟨z, rfl⟩ := hx
    obtain ⟨P⟩ := SheafOfModules.IsQuasicoherent.nonempty_quasicoherentData (M := F)
    obtain ⟨a, ha⟩ := exists_mem_of_coversTop P.X P.coversTop z
    let V := P.X a
    let U₀ : Opens X.carrier :=
      ⟨(i.hom.base '' (V : Set Z.carrier)ᶜ)ᶜ,
        (hi.isClosedMap _ V.isOpen.isClosed_compl).isOpen_compl⟩
    have hz : i.hom.base z ∈ U₀ := by
      rintro ⟨z', hz', heq⟩
      obtain rfl := hi.injective heq
      exact hz' ha
    obtain ⟨D⟩ := SheafOfModules.IsClosedImmersion.kernel_locallyGenerated (i := i)
    obtain ⟨b, hb⟩ := exists_mem_of_coversTop D.X D.coversTop (i.hom.base z)
    let U := U₀ ⊓ D.X b
    have hUV : (Opens.map i.hom.base).obj U ≤ V := by
      intro t ht
      by_contra h
      exact ht.1 ⟨t, h, rfl⟩
    have : PreservesColimitsOfSize.{u, u} (overPushforward i U) :=
      overPushforward_preservesColimits i hi U
    exact ⟨U, ⟨hz, hb⟩, exists_cokernel_of_presentations (overPushforward i U)
      (restrictPresentation hUV (P.presentation a)) (presentationPushforwardUnit i U
        (restrictGenerators (show U ≤ D.X b from inf_le_right) (D.generators b)))⟩
  · let U : Opens X.carrier :=
      ⟨(Set.range i.hom.base)ᶜ, hi.isClosed_range.isOpen_compl⟩
    let A : SheafOfModules.{u} ((structureSheafRing X).over U) := 0
    have hA : A.IsQuasicoherent :=
      (presentationOfIsZero
        (isZero_zero (SheafOfModules.{u} ((structureSheafRing X).over U)))).isQuasicoherent
    exact ⟨U, hx, A, A, hA, hA, 𝟙 A,
      ⟨(isZero_cokernel_of_epi (𝟙 A)).iso (isZero_pushforward_over_compl_range i hi F)⟩⟩

end ClosedImmersionSheaves
