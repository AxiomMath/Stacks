module

public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.Topology.Sheaves.Module
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GlobalSectionSmul
public import StacksFrontier.Topology.Sheaves.Cohomology.InverseSystems.TorsionFreeAndDivisibleSystems

/-!
# Principal-adic inverse systems of sheaves of modules

This file packages the standing data of Stacks 0BLB: a Noetherian ring `A`, complete for the
ideal generated by a single element `f`, a sheaf of rings `R` on a topological space `X` with
a map from `A` to its global sections, and an inverse system `𝓕₁ ← 𝓕₂ ← ⋯` of sheaves of
`R`-modules satisfying condition (1) of Stacks 0H39 for multiplication by `f`, whose first
module of global sections is finite over `A`. The inverse limit of the global sections is the
module written `M` in the source.

## Main definitions

* `Stacks.Modules.PrincipalAdicInverseSystem`: the standing data and hypotheses.
* `Stacks.Modules.PrincipalAdicInverseSystem.globalSectionsSystem`: the induced inverse system
  of `A`-modules of global sections.
* `Stacks.Modules.PrincipalAdicInverseSystem.M`: its inverse limit.

## Main results

No results are proved here; the structure is the interface the subsequent 0BLB results
consume.

## Implementation notes

Sheaves of `A`-modules are represented by a sheaf of rings `R` together with a ring map from
`A` to its global sections; the intended instance is the constant sheaf with value `A`. Going
through a sheaf of rings rather than through `A` directly is what allows condition (1) of
Stacks 0H39 to be used verbatim, since that condition is stated for an endomorphism of the
identity functor of `SheafOfModules R`; the endomorphism here is multiplication by the global
section `scalarMap f`, i.e. `Stacks.SheafOfModules.terminalSectionToEnd`.

The tower is indexed from zero, with object `n` representing `𝓕ₙ₊₁`, matching the indexing of
`Stacks.Cohomology.InverseSystems.TorsionFreeDivisible.Condition1`.

The module universe is the universe of the space, and not independent of it: the
`Stacks.Cohomology.InverseSystems.TorsionFreeDivisible.Condition1` is stated for
  `SheafOfModules.{max u v}` over a site `C : Type u` with
`Category.{v} C`, and for the site `Opens X` of a space `X : Type u` one has `v = u`. So an
independent module universe does not elaborate against that condition, and the field `F` is
pinned to `SheafOfModules.{u} R`.

## References

* [Stacks Project, Tag 0BLB](https://stacks.math.columbia.edu/tag/0BLB)
-/

@[expose] public noncomputable section

open CategoryTheory Limits Opposite TopologicalSpace
open scoped IsMulCommutative

namespace Stacks.Modules

universe u w

/-- The principal-adic inverse-system situation of Stacks 0BLB. -/
structure PrincipalAdicInverseSystem where
  /-- The underlying topological space. -/
  X : Type u
  /-- Its topology. -/
  [topology : TopologicalSpace X]
  /-- The base ring. -/
  A : Type w
  /-- Its commutative ring structure. -/
  [commRing : CommRing A]
  /-- The base ring is Noetherian. -/
  noetherian : IsNoetherianRing A
  /-- The element at which the base ring is complete. -/
  f : A
  /-- Completeness of the base ring for the ideal generated by `f`. -/
  complete : IsAdicComplete (Ideal.span {f}) A
  /-- The sheaf of rings on `X` over which the modules are taken. -/
  R : Sheaf (Opens.grothendieckTopology X) RingCat.{w}
  /-- Its rings of sections are commutative. -/
  mulCommutative : ∀ U, IsMulCommutative (R.obj.obj U)
  /-- The map from the base ring to the global sections of `R`. -/
  scalarMap : A →+* R.obj.obj (op (⊤ : Opens X))
  /-- The inverse system of sheaves of modules, with object `n` representing `𝓕ₙ₊₁`. -/
  F : ℕ → SheafOfModules.{u} R
  /-- The transition maps of the inverse system. -/
  map : ∀ n, F (n + 1) ⟶ F n
  /-- The first module of global sections is finite over the base ring. -/
  finite_first : Module.Finite A
    ((ModuleCat.restrictScalars.{u} scalarMap).obj
      ((SheafOfModules.evaluation R (op (⊤ : Opens X))).obj (F 0)))
  /-- Condition (1) of Stacks 0H39 for multiplication by `f`. -/
  condition : letI : ∀ U, IsMulCommutative (R.obj.obj U) := mulCommutative
    Stacks.Cohomology.InverseSystems.TorsionFreeDivisible.Condition1
      (Stacks.SheafOfModules.terminalSectionToEnd R (⊤ : Opens X)
        (CategoryTheory.Limits.isTerminalTop) (scalarMap f)) F map

attribute [instance] PrincipalAdicInverseSystem.topology PrincipalAdicInverseSystem.commRing

namespace PrincipalAdicInverseSystem

/-- The inverse system of modules of global sections. -/
def globalSectionsSystem (S : PrincipalAdicInverseSystem.{u, w}) :
    ℕᵒᵖ ⥤ ModuleCat.{u} S.A :=
  Functor.ofOpSequence (X := fun n ↦ (ModuleCat.restrictScalars.{u} S.scalarMap).obj
    ((SheafOfModules.evaluation S.R (op (⊤ : Opens S.X))).obj (S.F n)))
    (fun n ↦ (ModuleCat.restrictScalars.{u} S.scalarMap).map
      ((SheafOfModules.evaluation S.R (op (⊤ : Opens S.X))).map (S.map n)))

/-- The inverse limit of the global sections of the sheaf tower. -/
def M (S : PrincipalAdicInverseSystem.{u, w}) :
    ModuleCat.{u} S.A :=
  limit S.globalSectionsSystem

end PrincipalAdicInverseSystem

end Stacks.Modules

end
