module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree
public import Mathlib.CategoryTheory.Adjunction.Limits
public import Mathlib.CategoryTheory.Sites.Spaces
public import Mathlib.Geometry.RingedSpace.OpenImmersion
public import Mathlib.Topology.Sheaves.Module
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Sheaves.Functors.Module.RingedSpace
public import StacksFrontier.Topology.Sheaves.Modules.FiniteType
public import StacksFrontier.Topology.Sheaves.RingedSpace.ModuleFunctors

/-!
# Pullback preserves modules locally generated by sections

A sheaf of modules on a ringed space is *locally generated by sections* when there is an open
cover of the space on each member of which the sheaf is generated by a family of sections,
i.e. when Mathlib's `SheafOfModules.LocalGeneratorsData` is nonempty. This file proves that
pullback along a morphism of ringed spaces preserves this property.

## Main results

* `Stacks.SheafOfModules.modulePullback_nonempty_localGeneratorsData`: pullback preserves local
  generation by sections.

## References

* [Stacks Project, Tag 01B3](https://stacks.math.columbia.edu/tag/01B3)
-/

@[expose] public section

universe u

open AlgebraicGeometry CategoryTheory TopologicalSpace
open RingedSpaceModuleAdjunction

namespace Stacks.SheafOfModules

/-- If a sheaf of modules `G` on `Y` is locally generated by sections, then so is its pullback
`f^* G` along a morphism of ringed spaces `f : X ⟶ Y`. -/
@[stacks 01B3]
lemma modulePullback_nonempty_localGeneratorsData
    {X Y : RingedSpace.{u, u}} (f : X ⟶ Y)
    (G : _root_.SheafOfModules.{u} (structureSheafRing Y))
    (hG : Nonempty G.LocalGeneratorsData) :
    Nonempty ((modulePullback f).obj G).LocalGeneratorsData.{u} := by
  let q := (Classical.choice hG).shrink
  refine ⟨{
    I := ULift q.I
    X := fun i => (Opens.map f.hom.base).obj (q.X i.down)
    coversTop := coversTop_preimage f q.X q.coversTop
    generators := ?_ }⟩
  intro i
  let V := q.X i.down
  let U := (Opens.map f.hom.base).obj V
  let eY := V.sheafOfModulesEquivOver (structureSheafRing Y)
  let σY := (q.generators i.down).map eY.functor
    (Opens.sheafOfModulesEquivOverUnit V (structureSheafRing Y))
  let g := (openPreimageFactorization f V).map
  let σX := modulePullbackGeneratingSections g (eY.functor.obj (G.over V)) σY
  let eX := U.sheafOfModulesEquivOver (structureSheafRing X)
  let σRest := σX.equivOfIso (modulePullbackOpenPreimageIso f V G).symm
  let hpres : Limits.PreservesColimitsOfSize.{u, u, u, u, u + 1, u + 1}
      eX.symm.functor := eX.symm.toAdjunction.leftAdjoint_preservesColimits
  let η := (Opens.sheafOfModulesEquivOverInverseUnit U (structureSheafRing X)).symm
  let σOver := @_root_.SheafOfModules.GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _
    σRest eX.symm.functor hpres η
  exact σOver.equivOfIso
    (eX.unitIso.app (((modulePullback f).obj G).over U)).symm

end Stacks.SheafOfModules
