module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Cohomology.GlobalGeneration.Stalks
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorStalkRingedSpace
public import StacksFrontier.Topology.Sheaves.Functors.Module.SemilinearStalk

/-!
# The tensor product of globally generated sheaves of modules

On a ringed space, the tensor product of two sheaves of modules generated by global sections is
again generated by global sections: the products of the given generators do the job.

The proof is pointwise on stalks. A family of global sections generates a sheaf of modules
exactly when its germs generate every stalk, and the stalk of the tensor product is the tensor
product of the stalks, so the assertion reduces to the fact that if `f` spans `M` and `g` spans
`N` then the elements `f i ⊗ g j` span `M ⊗ N`.

## Main definitions

No new definitions are introduced.

## Main results

* `Stacks.SheafOfModules.tensorSheafGeneratingSections`: generating global sections of the
  tensor product, built from generating global sections of the two factors.

## Implementation notes

Being generated by global sections is Mathlib's `SheafOfModules.GeneratingSections`. The tensor
product is `Stacks.SheafOfModules.TensorStalkRingedSpace.tensorSheaf`, the sheafification of the
pointwise tensor-product presheaf.

The stalk of the structure sheaf carries two ring structures — the `CommRingCat`-valued one and
the `RingCat`-valued one used by the abstract module API — and they are identified by
`SemilinearStalk.commStalkRingEquiv`. `Stacks.SheafOfModules.commStalk_smul_eq` records that the
two scalar actions on a stalk agree through that identification, and
`Stacks.SheafOfModules.span_eq_top_of_ringEquiv` transports a spanning statement along it.

## References

* [Stacks Project, Tag 01AO](https://stacks.math.columbia.edu/tag/01AO)
-/

@[expose] public section

universe u

namespace Stacks.SheafOfModules

open CategoryTheory TopologicalSpace Limits Opposite

/-- The `CommRingCat`-valued and `RingCat`-valued scalar actions on a stalk of a presheaf of
modules agree through `SemilinearStalk.commStalkRingEquiv`. -/
theorem commStalk_smul_eq
    (X : AlgebraicGeometry.RingedSpace.{u, u})
    (M : PresheafOfModules (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)) (x : X.carrier)
    (s : TopCat.Presheaf.stalk (C := RingCat.{u}) (X := X.carrier)
      (structureSheafRing X).obj x)
    (m : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X M x) :
    SemilinearStalk.commStalkRingEquiv X.presheaf x s • m = s • m := by
  obtain ⟨U₁, hU₁, r₀, hr⟩ := TopCat.Presheaf.exists_germ_eq
    (X := X.carrier) (structureSheafRing X).obj s
  obtain ⟨U₂, hU₂, m₀, hm⟩ := TopCat.Presheaf.exists_germ_eq
    (X := X.carrier) M.presheaf m
  have hmem : x ∈ U₁ ⊓ U₂ := ⟨hU₁, hU₂⟩
  have hr' : TopCat.Presheaf.germ (C := RingCat.{u}) (X := X.carrier)
      (X.presheaf ⋙ forget₂ CommRingCat RingCat)
      (U₁ ⊓ U₂) x hmem
      ((X.presheaf ⋙ forget₂ CommRingCat RingCat).map (homOfLE inf_le_left).op r₀) = s := by
    rw [TopCat.Presheaf.germ_res_apply (X.presheaf ⋙ forget₂ CommRingCat RingCat)
      (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)) x hmem r₀]
    exact hr
  have hm' : TopCat.Presheaf.germ M.presheaf (U₁ ⊓ U₂) x hmem
      (M.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op m₀) = m := by
    rw [TopCat.Presheaf.germ_res_apply M.presheaf
      (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)) x hmem m₀]
    exact hm
  let rr : X.presheaf.obj (op (U₁ ⊓ U₂)) :=
    (X.presheaf.map (homOfLE inf_le_left).op).hom r₀
  let mm : M.obj (op (U₁ ⊓ U₂)) :=
    (M.map (homOfLE inf_le_right).op).hom m₀
  have hrmap : ((X.presheaf ⋙ forget₂ CommRingCat RingCat).map
      (homOfLE inf_le_left).op).hom r₀ = rr := rfl
  have hmmap : (M.presheaf.map (homOfLE inf_le_right).op).hom m₀ = mm := rfl
  rw [hrmap] at hr'
  rw [hmmap] at hm'
  rw [← hr', ← hm', SemilinearStalk.commStalkRingEquiv_germ X.presheaf x (U₁ ⊓ U₂) hmem rr]
  change TensorStalkRingedSpace.ringGerm X x (U₁ ⊓ U₂) hmem rr •
      TensorStalkRingedSpace.grpGerm X M x (U₁ ⊓ U₂) hmem mm =
    (TopCat.Presheaf.germ (C := RingCat.{u}) (X := X.carrier)
      (X.presheaf ⋙ forget₂ CommRingCat RingCat) (U₁ ⊓ U₂) x hmem) rr •
      (TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) (X := X.carrier)
        M.presheaf (U₁ ⊓ U₂) x hmem) mm
  rw [← TensorStalkRingedSpace.stalkModule_germ_smul X M x (U₁ ⊓ U₂) hmem rr
    mm]
  rw [← PresheafOfModules.germ_ringCat_smul M x (U₁ ⊓ U₂) hmem rr mm]
  rfl

/-- If `f` spans `M` and `g` spans `N`, the pure tensors `f i ⊗ g j` span `M ⊗ N`. -/
lemma span_tmul_range_eq_top {R M N I J : Type*} [CommSemiring R]
    [AddCommMonoid M] [AddCommMonoid N] [Module R M] [Module R N]
    (f : I → M) (g : J → N)
    (hf : Submodule.span R (Set.range f) = ⊤)
    (hg : Submodule.span R (Set.range g) = ⊤) :
    Submodule.span R (Set.range (fun ij : I × J => f ij.1 ⊗ₜ[R] g ij.2)) = ⊤ := by
  have h : Set.range (fun ij : I × J => f ij.1 ⊗ₜ[R] g ij.2) =
      Set.image2 (fun m n => m ⊗ₜ[R] n) (Set.range f) (Set.range g) := by
    ext x
    aesop
  rw [h]
  change Submodule.span R (Set.image2 (fun m n => (TensorProduct.mk R M N) m n)
    (Set.range f) (Set.range g)) = ⊤
  rw [← Submodule.map₂_span_span, hf, hg, TensorProduct.map₂_mk_top_top_eq_top]

/-- A spanning family stays spanning when the scalars are transported along a ring isomorphism
whose action agrees with the original one.

The two module structures are explicit parameters rather than instance arguments, because at
the call sites they live at two spellings of the same stalk and instance synthesis is
syntactic. -/
lemma span_eq_top_of_ringEquiv
    {R S M I : Type*} [Semiring R] [Semiring S] [AddCommMonoid M]
    (instR : Module R M) (instS : Module S M) (e : R ≃+* S)
    (he : letI := instR; letI := instS; ∀ (r : R) (m : M), e r • m = r • m) (f : I → M)
    (hf : letI := instR; Submodule.span R (Set.range f) = ⊤) :
    letI := instS; Submodule.span S (Set.range f) = ⊤ := by
  let _ := instR
  let _ := instS
  refine top_unique fun m _ => ?_
  have hm' : m ∈ Submodule.span R (Set.range f) := by rw [hf]; trivial
  refine Submodule.span_induction (p := fun x _ => x ∈ Submodule.span S (Set.range f))
    ?_ ?_ ?_ ?_ hm'
  · rintro y ⟨i, rfl⟩
    exact Submodule.subset_span ⟨i, rfl⟩
  · exact Submodule.zero_mem _
  · intro y z _ _ hy hz
    exact Submodule.add_mem _ hy hz
  · intro a y _ hy
    rw [← he a y]
    exact Submodule.smul_mem _ (e a) hy

/-- **Stacks Project, Tag 01AO.** The tensor product of two globally generated sheaves of
modules on a ringed space is globally generated. -/
@[stacks 01AO]
noncomputable def tensorSheafGeneratingSections
    (X : AlgebraicGeometry.RingedSpace.{u, u})
    (F G : _root_.SheafOfModules.{u} (structureSheafRing X))
    (hF : F.GeneratingSections) (hG : G.GeneratingSections) :
    (((Stacks.SheafOfModules.Tensor.sheafTensor
      ⟨X.presheaf, X.IsSheaf⟩).obj F).obj G).GeneratingSections := by
  classical
  let T : _root_.SheafOfModules.{u} (structureSheafRing X) :=
    ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.presheaf, X.IsSheaf⟩).obj F).obj G
  let s : hF.I × hG.I → T.sections := fun ij =>
    PresheafOfModules.sectionsMk (fun U =>
      TensorStalkRingedSpace.toTensorSheafSection X F G U
        ((hF.s ij.1).eval U ⊗ₜ[X.presheaf.obj U] (hG.s ij.2).eval U)) (by
          intro U V f
          change ((T.val.map f).hom
            (TensorStalkRingedSpace.toTensorSheafSection X F G U
              ((hF.s ij.1).eval U ⊗ₜ[X.presheaf.obj U] (hG.s ij.2).eval U))) = _
          have h := (TensorStalkRingedSpace.sheafifyUnit X
            ((PresheafOfModules.tensorObj (O := (X).presheaf) (F.val) (G.val)))).naturality
              f
          have h' := congrArg (fun q => q.hom
            ((hF.s ij.1).eval U ⊗ₜ[X.presheaf.obj U] (hG.s ij.2).eval U)) h.symm
          have hFres := PresheafOfModules.sections_property (hF.s ij.1) f
          have hGres := PresheafOfModules.sections_property (hG.s ij.2) f
          change ((T.val.map f).hom
              (TensorStalkRingedSpace.toTensorSheafSection X F G U
                ((hF.s ij.1).eval U ⊗ₜ[X.presheaf.obj U] (hG.s ij.2).eval U))) =
            TensorStalkRingedSpace.toTensorSheafSection X F G V
              (F.val.restrictₛₗ f ((hF.s ij.1).eval U) ⊗ₜ[X.presheaf.obj V]
                G.val.restrictₛₗ f ((hG.s ij.2).eval U)) at h'
          change F.val.restrictₛₗ f ((hF.s ij.1).eval U) = _ at hFres
          change G.val.restrictₛₗ f ((hG.s ij.2).eval U) = _ at hGres
          rw [hFres, hGres] at h'
          exact h')
  refine ⟨hF.I × hG.I, s, ?_⟩
  refine (AlgebraicGeometry.generates_iff_stalkwise_generates
    (O_X := structureSheafRing X) (F := T) s).mpr ?_
  intro x
  let etens : TensorStalkRingedSpace.grpStalk X T.val x ≃ₗ[TensorStalkRingedSpace.ringStalk X x]
      TensorProduct (TensorStalkRingedSpace.ringStalk X x)
        (TensorStalkRingedSpace.grpStalk X F.val x)
        (TensorStalkRingedSpace.grpStalk X G.val x) :=
    TensorStalkRingedSpace.tensorStalkIso X x F G
  let f : hF.I → TensorStalkRingedSpace.grpStalk X F.val x := fun i =>
    TensorStalkRingedSpace.grpGerm X F.val x (⊤ : TopologicalSpace.Opens X.carrier) (by simp)
      ((hF.s i).eval (Opposite.op (⊤ : TopologicalSpace.Opens X.carrier)))
  let g : hG.I → TensorStalkRingedSpace.grpStalk X G.val x := fun j =>
    TensorStalkRingedSpace.grpGerm X G.val x (⊤ : TopologicalSpace.Opens X.carrier) (by simp)
      ((hG.s j).eval (Opposite.op (⊤ : TopologicalSpace.Opens X.carrier)))
  have hfRaw : Submodule.span
      (R := (TopCat.Presheaf.stalk (X := X.carrier)
        (structureSheafRing X).obj x : RingCat))
      (Set.range f) = ⊤ := by
    have h := (AlgebraicGeometry.generates_iff_stalkwise_generates
      (O_X := structureSheafRing X) (F := F) hF.s).mp
        hF.epi x
    simp only [TopCat.Presheaf.Γgerm] at h
    exact h
  have hgRaw : Submodule.span
      (R := (TopCat.Presheaf.stalk (X := X.carrier)
        (structureSheafRing X).obj x : RingCat))
      (Set.range g) = ⊤ := by
    have h := (AlgebraicGeometry.generates_iff_stalkwise_generates
      (O_X := structureSheafRing X) (F := G) hG.s).mp
        hG.epi x
    simp only [TopCat.Presheaf.Γgerm] at h
    exact h
  let ering := SemilinearStalk.commStalkRingEquiv X.presheaf x
  have heF : ∀ (r : TopCat.Presheaf.stalk (C := RingCat.{u}) (X := X.carrier)
      (structureSheafRing X).obj x) (m : TensorStalkRingedSpace.grpStalk X F.val x),
      ering r • m = r • m :=
    commStalk_smul_eq X F.val x
  have heG : ∀ (r : TopCat.Presheaf.stalk (C := RingCat.{u}) (X := X.carrier)
      (structureSheafRing X).obj x) (m : TensorStalkRingedSpace.grpStalk X G.val x),
      ering r • m = r • m :=
    commStalk_smul_eq X G.val x
  have hf := span_eq_top_of_ringEquiv _ _ ering heF f hfRaw
  have hg := span_eq_top_of_ringEquiv _ _ ering heG g hgRaw
  have hgen : (fun i => TensorStalkRingedSpace.grpGerm X T.val x ⊤ (by simp)
      ((s i).eval (Opposite.op ⊤))) =
      fun ij => etens.symm (f ij.1 ⊗ₜ[TensorStalkRingedSpace.ringStalk X x] g ij.2) := by
    funext ij
    apply etens.injective
    rw [etens.apply_symm_apply]
    exact TensorStalkRingedSpace.tensorStalkIso_germ X x F G ⊤ (by simp)
      ((hF.s ij.1).eval (Opposite.op (⊤ : TopologicalSpace.Opens X.carrier)))
      ((hG.s ij.2).eval (Opposite.op (⊤ : TopologicalSpace.Opens X.carrier)))
  have hTargetComm : Submodule.span (R := TensorStalkRingedSpace.ringStalk X x)
      (Set.range (fun i => TensorStalkRingedSpace.grpGerm X T.val x ⊤ (by simp)
        ((s i).eval (Opposite.op ⊤)))) = ⊤ := by
    rw [hgen, show Set.range (fun ij : hF.I × hG.I => etens.symm
      (f ij.1 ⊗ₜ[TensorStalkRingedSpace.ringStalk X x] g ij.2)) =
      etens.symm '' Set.range (fun ij : hF.I × hG.I =>
        f ij.1 ⊗ₜ[TensorStalkRingedSpace.ringStalk X x] g ij.2) from by
      simpa [Function.comp_def] using
        (Set.range_comp (g := etens.symm) (f := fun ij : hF.I × hG.I =>
          f ij.1 ⊗ₜ[TensorStalkRingedSpace.ringStalk X x] g ij.2))]
    rw [Submodule.span_image_linearEquiv etens.symm, span_tmul_range_eq_top f g hf hg]
    exact (Submodule.map_top etens.symm.toLinearMap).trans
      (LinearMap.range_eq_top.mpr etens.symm.surjective)
  have heRev : ∀ (r : TensorStalkRingedSpace.ringStalk X x)
      (m : TensorStalkRingedSpace.grpStalk X T.val x), ering.symm r • m = r • m := by
    intro r m
    have h := commStalk_smul_eq X T.val x (ering.symm r) m
    rw [ering.apply_symm_apply] at h
    exact h.symm
  change Submodule.span (R := (TopCat.Presheaf.stalk (C := RingCat.{u})
      (X := X.carrier) (structureSheafRing X).obj x : RingCat))
    (Set.range (fun i => TensorStalkRingedSpace.grpGerm X T.val x ⊤ (by simp)
      ((s i).eval (Opposite.op ⊤)))) = ⊤
  exact span_eq_top_of_ringEquiv _ _ ering.symm heRev _ hTargetComm

end Stacks.SheafOfModules

end
