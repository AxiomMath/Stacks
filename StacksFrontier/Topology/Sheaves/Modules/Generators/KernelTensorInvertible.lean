        ((g.π, (𝟙 L)) : (_root_.SheafOfModules.free (R := structureSheafRing X) g.I, L) ⟶
        (L, L)))).val.app U).hom ((koszulSection X L g i j).eval U) = 0 := by
  obtain ⟨U⟩ := U
