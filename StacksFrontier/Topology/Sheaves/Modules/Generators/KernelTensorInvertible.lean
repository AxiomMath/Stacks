  have hsymm : ∀ v w : grpStalk X L.val x,
      v ⊗ₜ[ringStalk X x] w = w ⊗ₜ[ringStalk X x] v :=
    Stacks.SelfBraidingInvertible.tmul_comm_of_rankOne (ι := Unit) (fun _ v => e v)
      (fun _ => e.symm 1) (fun _ => 1) (by simp) fun _ v => by
        rw [one_smul]
        exact e.injective (by simp)
  refine (tensorStalkIso X x L L).injective ?_
  rw [map_zero, toTensorSheafSection_sub, map_sub, map_sub, tensorStalkIso_germ,
    tensorStalkIso_germ, hsymm, sub_self]

/-- The Koszul section is killed by `π ⊗ 1_L`. -/
theorem app_tensorSheafMap_koszulSection
    [∀ x : X.carrier, IsLocalRing (ringStalk X x)]
