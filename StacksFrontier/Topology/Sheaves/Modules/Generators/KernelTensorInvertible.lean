/-- The Koszul section as a global section of `kernel (π ⊗ 1_L)`. -/
noncomputable def koszulKernelSection (g : L.GeneratingSections) (i j : g.I) :
    (kernel (((Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
