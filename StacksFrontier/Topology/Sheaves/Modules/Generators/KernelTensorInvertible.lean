/-! ### The Koszul sections -/


/-- The Koszul global section `e_i ⊗ s_j − e_j ⊗ s_i` of `O_X^{⊕I} ⊗ L`, where the `s_i` are the
given generating sections of `L` and the `e_i` are the tautological global sections of the free
sheaf `O_X^{⊕I}`. -/
noncomputable def koszulSection (g : L.GeneratingSections) (i j : g.I) :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
        (⟨X.presheaf, X.IsSheaf⟩ : Sheaf (JX X) CommRingCat.{u})).obj
        ((SheafOfModules.free (R := structureSheafRing X) g.I))).obj (L))).sections :=
  PresheafOfModules.sectionsMk
    (fun U => (tmulSection X _ L (SheafOfModules.freeSection i) (g.s j)).eval U
      - (tmulSection X _ L (SheafOfModules.freeSection j) (g.s i)).eval U)
    (by
      intro U V f
      rw [map_sub, PresheafOfModules.sections_property, PresheafOfModules.sections_property]
      rfl)

/-- Over an open `U`, the Koszul section `e_i ⊗ s_j − e_j ⊗ s_i` is the image of
`e_i|_U ⊗ s_j|_U − e_j|_U ⊗ s_i|_U` in `(O_X^{⊕I} ⊗ L)(U)`. -/
@[simp]
theorem koszulSection_eval (g : L.GeneratingSections) (i j : g.I)
    (U : (TopologicalSpace.Opens X.carrier)ᵒᵖ) :
    (koszulSection X L g i j).eval U
      = toTensorSheafSection X (SheafOfModules.free (R := structureSheafRing X) g.I) L U
        ((SheafOfModules.freeSection i).eval U ⊗ₜ[X.presheaf.obj U] (g.s j).eval U
          - (SheafOfModules.freeSection j).eval U ⊗ₜ[X.presheaf.obj U] (g.s i).eval U) :=
  (toTensorSheafSection_sub X _ L U _ _).symm

/-- **The Koszul section read in the tensor product of stalks.** Under the identification of the
stalk of `O_X^{⊕I} ⊗ L` with the tensor product of the stalks, the germ of the Koszul section
`e_i ⊗ s_j − e_j ⊗ s_i` is the Koszul element `e_i ⊗ s_j − e_j ⊗ s_i` built from the germs.

Split off from `Stacks.SheafOfModules.stalkMapL_kernel_ι_germ_koszulKernelSection` on the
cumulative-heartbeat ground recorded in the module docstring, and stated before the invertibility
hypotheses are introduced, since none of them is used. -/
private theorem tensorStalkIso_germ_koszulSection (g : L.GeneratingSections) (x : X.carrier)
    (i j : g.I) :
    tensorStalkIso X x (_root_.SheafOfModules.free (R := structureSheafRing X) g.I) L
        (grpGerm X ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
            (⟨X.presheaf, X.IsSheaf⟩ : Sheaf (JX X) CommRingCat.{u})).obj
            ((_root_.SheafOfModules.free (R := structureSheafRing X) g.I))).obj (L))).val x ⊤
            (by simp)
          ((koszulSection X L g i j).eval (Opposite.op ⊤)))
      = freeGerm X g.I x i ⊗ₜ[ringStalk X x] sGerm X L g x j
        - freeGerm X g.I x j ⊗ₜ[ringStalk X x] sGerm X L g x i := by
  rw [koszulSection_eval, toTensorSheafSection_sub, map_sub, map_sub, tensorStalkIso_germ,
    tensorStalkIso_germ]

/-- The morphism `π` out of the free sheaf sends the tautological section `e_i` to the generating
section `s_i`, sectionwise. -/
theorem app_pi_freeSection_eval (g : L.GeneratingSections) (i : g.I)
    (U : (TopologicalSpace.Opens X.carrier)ᵒᵖ) :
    (g.π.val.app U).hom ((SheafOfModules.freeSection i).eval U) = (g.s i).eval U :=
  app_eval_of_sectionsMap_eq X g.π
    (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection g.s i) U

/-- The section `a ⊗ b − b ⊗ a` of `L ⊗ L` vanishes for an invertible `L`: its stalks are free of
rank one, and the tensor square of a rank-one module is symmetric. -/
theorem toTensorSheafSection_tmul_antisymm_eq_zero
    [∀ x : X.carrier, IsLocalRing (ringStalk X x)]
    [IsInvertible X.presheaf (structureSheafRing X).property L]
    (U : TopologicalSpace.Opens X.carrier) (a b : L.val.obj (Opposite.op U)) :
    toTensorSheafSection X L L (Opposite.op U) (a ⊗ₜ[X.presheaf.obj (Opposite.op U)] b
