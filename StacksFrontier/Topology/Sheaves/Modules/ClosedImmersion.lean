module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.Defs
public import StacksFrontier.Topology.Sheaves.Functors.Module.RingedSpace
import StacksCore.Tactic.StacksAttribute

/-!
# Closed immersions of ringed spaces

A closed immersion of ringed spaces is a morphism `i : Z ⟶ X` whose underlying continuous map
is a closed embedding, whose map on structure sheaves is surjective, and whose kernel is
locally generated by sections. The kernel in question is the *ideal sheaf* of the immersion,
the kernel of `𝒪_X ⟶ i_* 𝒪_Z` read as a sheaf of `𝒪_X`-modules.

## Main definitions

* `AlgebraicGeometry.SheafOfModules.idealSheaf`: the kernel of the map from the structure sheaf
  of the target to the pushforward of the structure sheaf of the source.
* `AlgebraicGeometry.SheafOfModules.IsClosedImmersion`: the Stacks Project notion of a closed
  immersion of ringed spaces.

## Main results

* `AlgebraicGeometry.SheafOfModules.isClosedImmersion_iff`: the definition is equivalent to the
  conjunction of its three constituent conditions.

## Implementation notes

Both are abbreviations for `Stacks.ClosedImmersion.idealSheaf` and
`Stacks.ClosedImmersion.IsClosedImmersion`, which is where they are defined; this module
supplies the names under which the sheaf-theoretic development refers to them. Since they are
abbreviations the two spellings denote the same objects, so a closed immersion in either sense
is one in the other, and the three projections below are the projections of that one class.

The map of structure sheaves is regarded as a morphism of sheaves of modules via
`SheafOfModules.unitToPushforwardObjUnit`. Its surjectivity is expressed by `Epi`, and local
generation of its categorical kernel by the existence of
`SheafOfModules.LocalGeneratorsData`. Closed immersions may be constructed from the three
conditions using `isClosedImmersion_iff`; the projections expose the closed-embedding and
local-generation conditions, while typeclass inference supplies the epimorphism condition from
`Stacks.ClosedImmersion.epi_structureSheafHom`.

This is the notion for ringed spaces. The corresponding notion for schemes is Mathlib's
`AlgebraicGeometry.IsClosedImmersion`.

## References

* [Stacks Project, Tag 01C2](https://stacks.math.columbia.edu/tag/01C2)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits RingedSpaceModuleAdjunction

universe u

namespace AlgebraicGeometry.SheafOfModules

/-- The ideal sheaf associated to a morphism of ringed spaces: the kernel of
`𝒪_X ⟶ i_* 𝒪_Z`, regarded as a sheaf of `𝒪_X`-modules. -/
noncomputable abbrev idealSheaf {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) :
    _root_.SheafOfModules.{u} (structureSheafRing X) :=
  _root_.Stacks.ClosedImmersion.idealSheaf i

/-- **Stacks Project, Tag 01C2.** A morphism of ringed spaces is a closed immersion when its
underlying continuous map is a closed embedding, its map on structure sheaves is surjective,
and the kernel of that map is locally generated by sections. -/
@[stacks 01C2]
abbrev IsClosedImmersion {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) : Prop :=
  _root_.Stacks.ClosedImmersion.IsClosedImmersion i

namespace IsClosedImmersion

/-- The underlying continuous map of a closed immersion is a closed embedding. -/
theorem isClosedEmbedding {X Z : RingedSpace.{u, u}} {i : Z ⟶ X} [IsClosedImmersion i] :
    Topology.IsClosedEmbedding i.hom.base :=
  _root_.Stacks.ClosedImmersion.IsClosedImmersion.isClosedEmbedding

/-- The map on structure sheaves of a closed immersion is surjective. -/
theorem structureSheafMap_epi {X Z : RingedSpace.{u, u}} {i : Z ⟶ X} [IsClosedImmersion i] :
    Epi (_root_.SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)) :=
  _root_.Stacks.ClosedImmersion.IsClosedImmersion.structureSheafMap_epi

/-- The ideal sheaf of a closed immersion is locally generated by sections. -/
theorem kernel_locallyGenerated {X Z : RingedSpace.{u, u}} {i : Z ⟶ X} [IsClosedImmersion i] :
    Nonempty (_root_.SheafOfModules.LocalGeneratorsData.{u} (idealSheaf i)) :=
  _root_.Stacks.ClosedImmersion.IsClosedImmersion.kernel_locallyGenerated

end IsClosedImmersion

/-- A morphism of ringed spaces is a closed immersion exactly when it satisfies the three
conditions in the definition. -/
theorem isClosedImmersion_iff {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.hom.base ∧
        Epi (_root_.SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)) ∧
          Nonempty (_root_.SheafOfModules.LocalGeneratorsData.{u} (idealSheaf i)) :=
  _root_.Stacks.ClosedImmersion.isClosedImmersion_iff i

end AlgebraicGeometry.SheafOfModules
