module

public import Mathlib.CategoryTheory.Sites.LocallyInjective
public import Mathlib.CategoryTheory.Sites.LocallySurjective
public import Mathlib.CategoryTheory.Subobject.Limits
public import Mathlib.Topology.Sheaves.Abelian
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Sheaves.OpenImmersion.ExtensionByInitial
public import StacksFrontier.Topology.Sheaves.Sheaf.Abelian
public import StacksFrontier.Topology.Sheaves.Sheaf.Constant

/-!
# Finite filtrations of subsheaves of the constant sheaf of integers

Let `X` be a topological space on which the intersection of any two quasi-compact opens is
quasi-compact, and let `F ⊆ ℤ` be a subsheaf of the constant sheaf of integers which is generated
by finitely many sections over quasi-compact opens. Then `F` carries a finite filtration
`0 = F₀ ⊆ F₁ ⊆ ⋯ ⊆ F_n = F` by abelian subsheaves whose successive quotients each sit in a short
exact sequence `0 ⟶ j'_! ℤ_V ⟶ j_! ℤ_U ⟶ F_i / F_{i - 1} ⟶ 0`, where `j : U ⟶ X` and
`j' : V ⟶ X` are the inclusions of quasi-compact opens with `V ⊆ U`.

## Main definitions

* `integerConstantSheaf`: the constant sheaf with value `ℤ`.
* `integerExtensionByZero`: its extension by zero from an open subspace.
* `FinitelyGeneratedByCompactOpenSections`: generation of a subsheaf of the constant sheaf of
  integers by finitely many sections over quasi-compact opens.

## Main results

* `exists_filtration_of_finitelyGeneratedByCompactOpenSections`: the finite filtration and the
  short exact presentations of its successive quotients.

## Implementation notes

A subsheaf is a `CategoryTheory.Subobject` in the abelian category of sheaves of abelian groups,
and a quotient of two successive terms of the filtration is the cokernel of the canonical
inclusion between them. A section of a sheaf `H` over an open `U` is encoded, through the
`j_! ⊣ j^{-1}` adjunction of extension by zero, as a morphism `j_! ℤ_U ⟶ H`; so generation by
finitely many sections over quasi-compact opens says that the images of finitely many such
morphisms have supremum the given subobject.

The hypothesis on `X` is `TopologicalSpace.QuasiSeparatedSpace`, which is exactly the requirement
that the intersection of two quasi-compact opens be quasi-compact.

The filtration is indexed by the positive integer `n` such that `F_n` is generated by the constant
sections `m` over the quasi-compact opens on which some generator takes the value `m`, for
`0 < m ≤ n`. Closing the finite family of pairs (open, value) under intersections and greatest
common divisors makes the gcd of the values attained at a point be one of them, which is what makes
the successive quotients have the stated presentation.

## References

* [A. Grothendieck, *Sur quelques points d'algèbre homologique*, page 168][Tohoku]
* [Stacks Project, Tag 0A38](https://stacks.math.columbia.edu/tag/0A38)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopCat TopologicalSpace Opposite

namespace Stacks.Sheaves.ConstantIntegerSubsheaves

universe u

variable (X : TopCat.{u})

/-- The constant sheaf of integers on `X`. -/
noncomputable abbrev integerConstantSheaf : TopCat.Sheaf AddCommGrpCat.{u} X :=
  constantSheafOnSpace X AddCommGrpCat.{u} (AddCommGrpCat.of (ULift.{u} ℤ))

/-- The extension by zero to `X` of the constant sheaf of integers on the open subspace `U`. -/
@[sga "2 I 1.6" "special case"]
noncomputable abbrev integerExtensionByZero (U : Opens X) : TopCat.Sheaf AddCommGrpCat.{u} X :=
  (TopCat.Presheaf.extendByInitialSheaf U).obj
    (integerConstantSheaf (TopCat.of U))

/-- A subsheaf of the constant sheaf of integers is generated by finitely many sections over
quasi-compact opens when it is the supremum of the images of the finitely many morphisms
`j_! ℤ_{U i} ⟶ ℤ` corresponding to those sections. -/
def FinitelyGeneratedByCompactOpenSections
    (F : Subobject (integerConstantSheaf X)) : Prop :=
  ∃ (n : ℕ) (U : Fin n → Opens X),
    (∀ i, IsCompact (U i : Set X)) ∧
      ∃ s : ∀ i, integerExtensionByZero X (U i) ⟶ (F : TopCat.Sheaf AddCommGrpCat.{u} X),
        Finset.univ.sup (fun i => imageSubobject (s i ≫ F.arrow)) = F

/-- On a quasi-separated space the intersection of two quasi-compact opens is quasi-compact. -/
private lemma compact_open_inter [QuasiSeparatedSpace X]
    (U V : Opens X) (hU : IsCompact (U : Set X)) (hV : IsCompact (V : Set X)) :
    IsCompact ((U ⊓ V : Opens X) : Set X) := by
  show IsCompact ((U : Set X) ∩ (V : Set X))
  exact hU.inter_of_isOpen hV U.isOpen V.isOpen

/-- The union of two quasi-compact opens is quasi-compact. -/
private lemma compact_open_union (U V : Opens X)
    (hU : IsCompact (U : Set X)) (hV : IsCompact (V : Set X)) :
    IsCompact ((U ⊔ V : Opens X) : Set X) := by
  show IsCompact ((U : Set X) ∪ (V : Set X))
  exact hU.union hV

/-- A finite union of quasi-compact opens is quasi-compact. -/
private lemma compact_open_finset_union {ι : Type*} (s : Finset ι)
    (U : ι → Opens X) (hU : ∀ i ∈ s, IsCompact (U i : Set X)) :
    IsCompact ((s.sup U : Opens X) : Set X) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s his ih =>
      have hi : IsCompact (U i : Set X) := hU i (Finset.mem_insert_self i s)
      have hs : ∀ j ∈ s, IsCompact (U j : Set X) := by
        intro j hj
        exact hU j (Finset.mem_insert_of_mem hj)
      simpa only [Finset.sup_insert] using compact_open_union X (U i) (s.sup U) hi (ih hs)

/-- On a quasi-separated space the intersection of a finite nonempty family of quasi-compact
opens is quasi-compact. -/
private lemma compact_open_finset_inter [QuasiSeparatedSpace X]
    {ι : Type*} (s : Finset ι) (hs : s.Nonempty)
    (U : ι → Opens X) (hU : ∀ i ∈ s, IsCompact (U i : Set X)) :
    IsCompact ((s.inf U : Opens X) : Set X) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp at hs
  | @insert i s his ih =>
      have hi : IsCompact (U i : Set X) := hU i (Finset.mem_insert_self i s)
      by_cases hse : s = ∅
      · subst s
        simpa using hi
      · have hs' : s.Nonempty := Finset.nonempty_iff_ne_empty.mpr hse
        have hU' : ∀ j ∈ s, IsCompact (U j : Set X) := by
          intro j hj
          exact hU j (Finset.mem_insert_of_mem hj)
        simpa only [Finset.inf_insert] using
          compact_open_inter X (U i) (s.inf U) hi (ih hs' hU')

/-- A point lying in every member of a finite family of opens lies in their infimum. -/
private lemma mem_finset_inf {ι : Type*} (s : Finset ι)
    (U : ι → Opens X) (x : X) (h : ∀ i ∈ s, x ∈ U i) :
    x ∈ s.inf U := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.inf_insert, Opens.mem_inf]
      exact ⟨h i (Finset.mem_insert_self i s),
        ih (fun j hj => h j (Finset.mem_insert_of_mem hj))⟩

/-- A section of the constant sheaf of integers is, on some neighbourhood of any point of its
domain, the image of a constant. -/
private theorem integer_constant_section_locally_constant
    (U : Opens X) (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (x : X) (hx : x ∈ U) :
    ∃ (V : Opens X) (hVU : V ≤ U) (_hxV : x ∈ V) (a : ULift.{u} ℤ),
      (integerConstantSheaf X).obj.map (Opposite.op (homOfLE hVU)) s =
        (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
          (constantPresheafOnSpace X AddCommGrpCat.{u}
            (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op V) a := by
  let P := constantPresheafOnSpace X AddCommGrpCat.{u}
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let f := CategoryTheory.toSheafify (Opens.grothendieckTopology X) P
  have : CategoryTheory.Presheaf.IsLocallySurjective (Opens.grothendieckTopology X) f :=
    inferInstance
  have hcov := CategoryTheory.Presheaf.imageSieve_mem
    (Opens.grothendieckTopology X) f s
  obtain ⟨V, i, hi, hxV⟩ := hcov x hx
  obtain ⟨a, ha⟩ := hi
  exact ⟨V, i.le, hxV, a, ha.symm⟩

/-- Over an open containing a point, the unit of the sheafification of the constant presheaf of
integers is injective. -/
private theorem constant_integer_unit_injective_of_nonempty
    (U : Opens X) (x : X) (hx : x ∈ U) :
    Function.Injective
      ((CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op U)) := by
  intro a b hab
  let P := constantPresheafOnSpace X AddCommGrpCat.{u}
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let f := CategoryTheory.toSheafify (Opens.grothendieckTopology X) P
  have : CategoryTheory.Presheaf.IsLocallyInjective (Opens.grothendieckTopology X) f :=
    inferInstance
  have hcov := CategoryTheory.Presheaf.equalizerSieve_mem
    (Opens.grothendieckTopology X) f a b hab
  obtain ⟨V, i, hi, _⟩ := hcov x hx
  change P.map i.op a = P.map i.op b at hi
  change a = b at hi
  exact hi

/-- Restricting the constant section `c` over `U` to a smaller open `V` gives the constant
section `c` over `V`. -/
private theorem constant_unit_restrict (U V : Opens X) (hVU : V ≤ U) (c : ULift.{u} ℤ) :
    (integerConstantSheaf X).obj.map (op (homOfLE hVU))
        ((CategoryTheory.toSheafify (Opens.grothendieckTopology X)
          (constantPresheafOnSpace X AddCommGrpCat.{u}
            (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U) c) =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op V) c := by
  have hnat := NatTrans.naturality_apply
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
      (constantPresheafOnSpace X AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ)))) (op (homOfLE hVU)) c
  convert hnat.symm using 1; rfl

/-- Two constants representing one section of the constant sheaf of integers on neighbourhoods of
a common point are equal. -/
private theorem local_rep_unique (U V W : Opens X)
    (s : (constantSheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))).obj.obj (Opposite.op U))
    (hVU : V ≤ U) (hWU : W ≤ U) (x : X) (hxV : x ∈ V) (hxW : x ∈ W)
    (a b : ULift.{u} ℤ)
    (ha : (constantSheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))).obj.map
        (Opposite.op (homOfLE hVU)) s =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op V) a)
    (hb : (constantSheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))).obj.map
        (Opposite.op (homOfLE hWU)) s =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op W) b) :
    a = b := by
  let Z : Opens X := V ⊓ W
  have hZV : Z ≤ V := inf_le_left
  have hZW : Z ≤ W := inf_le_right
  have hxZ : x ∈ Z := ⟨hxV, hxW⟩
  apply constant_integer_unit_injective_of_nonempty X Z x hxZ
  rw [← constant_unit_restrict X V Z hZV a, ← constant_unit_restrict X W Z hZW b, ← ha, ← hb]
  simp only [← Functor.map_comp_apply]
  have hmor :
      (homOfLE hVU).op ≫ (homOfLE hZV).op =
      (homOfLE hWU).op ≫ (homOfLE hZW).op :=
    Subsingleton.elim _ _
  exact congrArg
    (fun q => (constantSheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))).obj.map q s) hmor

/-- `IsIntegerConstantOn X U V s a` says that the section `s` over `U` restricts on `V` to the
constant `a`. -/
private def IsIntegerConstantOn (U V : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U)) (a : ULift.{u} ℤ) : Prop :=
  ∃ hVU : V ≤ U,
    (integerConstantSheaf X).obj.map (Opposite.op (homOfLE hVU)) s =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op V) a

/-- The largest open on which a section of the constant sheaf of integers takes the constant
value `a`. -/
private noncomputable def integerSectionLocus (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) : Opens X :=
  ⨆ (V : Opens X), ⨆ (_ : IsIntegerConstantOn X U V s a), V

/-- A point lies in `integerSectionLocus X U s a` exactly when some open containing it carries
the constant value `a` of `s`. -/
private lemma mem_integerSectionLocus_iff (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) (x : X) :
    x ∈ integerSectionLocus X U s a ↔
      ∃ V : Opens X, IsIntegerConstantOn X U V s a ∧ x ∈ V := by
  simp only [integerSectionLocus, Opens.mem_iSup]
  aesop

/-- The locus where a section takes a given constant value is contained in its domain. -/
private lemma integerSectionLocus_le (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) : integerSectionLocus X U s a ≤ U := by
  intro x hx
  obtain ⟨V, ⟨hVU, _⟩, hxV⟩ := (mem_integerSectionLocus_iff X U s a x).mp hx
  exact hVU hxV

/-- Every point of the domain of a section lies in the locus of some constant value. -/
private lemma exists_integerSectionLocus_of_mem (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (x : X) (hx : x ∈ U) :
    ∃ a : ULift.{u} ℤ, x ∈ integerSectionLocus X U s a := by
  obtain ⟨V, hVU, hxV, a, ha⟩ :=
    integer_constant_section_locally_constant X U s x hx
  exact ⟨a, (mem_integerSectionLocus_iff X U s a x).mpr
    ⟨V, ⟨hVU, ha⟩, hxV⟩⟩

/-- The value of a section at a point is unique: the loci of two distinct constants are
disjoint. -/
private lemma integerSectionLocus_unique (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (x : X) {a b : ULift.{u} ℤ}
    (ha : x ∈ integerSectionLocus X U s a)
    (hb : x ∈ integerSectionLocus X U s b) : a = b := by
  obtain ⟨V, ⟨hVU, ha'⟩, hxV⟩ := (mem_integerSectionLocus_iff X U s a x).mp ha
  obtain ⟨W, ⟨hWU, hb'⟩, hxW⟩ := (mem_integerSectionLocus_iff X U s b x).mp hb
  exact local_rep_unique X U V W s hVU hWU x hxV hxW a b ha' hb'

/-- The union of the loci of all constant values other than `a`. -/
private noncomputable def integerSectionOtherLocus (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) : Opens X :=
  ⨆ (b : {b : ULift.{u} ℤ // b ≠ a}), integerSectionLocus X U s b.1

/-- A point lies in `integerSectionOtherLocus X U s a` exactly when `s` takes some constant value
other than `a` near it. -/
private lemma mem_integerSectionOtherLocus_iff (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) (x : X) :
    x ∈ integerSectionOtherLocus X U s a ↔
      ∃ b : ULift.{u} ℤ, b ≠ a ∧ x ∈ integerSectionLocus X U s b := by
  simp only [integerSectionOtherLocus, Opens.mem_iSup]
  constructor
  · rintro ⟨⟨b, hb⟩, hx⟩
    exact ⟨b, hb, hx⟩
  · rintro ⟨b, hb, hx⟩
    exact ⟨⟨b, hb⟩, hx⟩

/-- The locus of a constant value is the domain with the loci of all other values removed; in
particular it is closed in the domain. -/
private lemma integerSectionLocus_eq_inter_compl (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) :
    (integerSectionLocus X U s a : Set X) =
      (U : Set X) ∩ (integerSectionOtherLocus X U s a : Set X)ᶜ := by
  ext x
  simp only [Set.mem_inter_iff, Set.mem_compl_iff]
  constructor
  · intro hx
    refine ⟨integerSectionLocus_le X U s a hx, ?_⟩
    intro hother
    obtain ⟨b, hba, hb⟩ := (mem_integerSectionOtherLocus_iff X U s a x).mp hother
    exact hba (integerSectionLocus_unique X U s x hb hx)
  · rintro ⟨hxU, hnotOther⟩
    obtain ⟨b, hb⟩ := exists_integerSectionLocus_of_mem X U s x hxU
    by_cases hba : b = a
    · simpa [hba] using hb
    · exact False.elim (hnotOther ((mem_integerSectionOtherLocus_iff X U s a x).mpr
        ⟨b, hba, hb⟩))

/-- A section restricts to the constant `a` on the whole locus where it takes the value `a`. -/
private lemma integerSectionLocus_restrict_eq_constant (U : Opens X)
    (s : (integerConstantSheaf X).obj.obj (op U))
    (a : ULift.{u} ℤ) :
    (integerConstantSheaf X).obj.map
        (op (homOfLE (integerSectionLocus_le X U s a))) s =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (op (integerSectionLocus X U s a)) a := by
  let L := integerSectionLocus X U s a
  let I := {V : Opens X // IsIntegerConstantOn X U V s a}
  let W : I → Opens X := fun i => i.1
  have hWL : ∀ i : I, W i ≤ L := by
    rintro ⟨V, hV⟩
    show V ≤ integerSectionLocus X U s a
    intro x hx
    exact (mem_integerSectionLocus_iff X U s a x).mpr ⟨V, hV, hx⟩
  let iWL : ∀ i : I, W i ⟶ L := fun i => homOfLE (hWL i)
  have hcover : L ≤ ⨆ i, W i := by
    intro x hx
    obtain ⟨V, hV, hxV⟩ := (mem_integerSectionLocus_iff X U s a x).mp hx
    exact (Opens.mem_iSup).mpr ⟨⟨V, hV⟩, hxV⟩
  refine TopCat.Sheaf.eq_of_locally_eq' (integerConstantSheaf X) W L iWL hcover _ _ ?_
  rintro ⟨V, ⟨hVU, hval⟩⟩
  show (integerConstantSheaf X).obj.map (op (iWL ⟨V, ⟨hVU, hval⟩⟩))
      ((integerConstantSheaf X).obj.map
        (op (homOfLE (integerSectionLocus_le X U s a))) s) =
    (integerConstantSheaf X).obj.map (op (iWL ⟨V, ⟨hVU, hval⟩⟩))
      ((CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op L) a)
  have hfirst :
      (integerConstantSheaf X).obj.map (op (iWL ⟨V, ⟨hVU, hval⟩⟩))
          ((integerConstantSheaf X).obj.map
            (op (homOfLE (integerSectionLocus_le X U s a))) s) =
        (integerConstantSheaf X).obj.map (op (homOfLE hVU)) s := by
    simp only [← Functor.map_comp_apply]
    congr 1
  exact hfirst.trans (hval.trans (constant_unit_restrict X L _ (hWL ⟨V, ⟨hVU, hval⟩⟩) a).symm)

/-- The locus of a constant value inside a quasi-compact open is quasi-compact. -/
private lemma compact_integerSectionLocus (U : Opens X)
    (hU : IsCompact (U : Set X))
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U))
    (a : ULift.{u} ℤ) :
    IsCompact (integerSectionLocus X U s a : Set X) := by
  rw [integerSectionLocus_eq_inter_compl X U s a]
  exact hU.inter_right (integerSectionOtherLocus X U s a).isOpen.isClosed_compl

/-- A quasi-compact open is covered by finitely many of the loci on which a section over it is
constant. -/
private lemma exists_finite_integerSectionLocus_cover (U : Opens X)
    (hU : IsCompact (U : Set X))
    (s : (integerConstantSheaf X).obj.obj (Opposite.op U)) :
    ∃ t : Finset (ULift.{u} ℤ),
      U = t.sup (integerSectionLocus X U s) := by
  classical
  have hcover : (U : Set X) ⊆
      ⋃ a : ULift.{u} ℤ, (integerSectionLocus X U s a : Set X) := by
    intro x hx
    obtain ⟨a, ha⟩ := exists_integerSectionLocus_of_mem X U s x hx
    exact Set.mem_iUnion.mpr ⟨a, ha⟩
  obtain ⟨t, ht⟩ := hU.elim_finite_subcover
    (fun a : ULift.{u} ℤ => (integerSectionLocus X U s a : Set X))
    (fun a => (integerSectionLocus X U s a).isOpen) hcover
  refine ⟨t, le_antisymm ?_ ?_⟩
  · intro x hx
    obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp (ht hx)
    obtain ⟨ha, hxa⟩ := Set.mem_iUnion.mp hxa
    simp only [Finset.sup_eq_iSup, Opens.mem_iSup]
    exact ⟨a, ha, hxa⟩
  · exact Finset.sup_le fun a _ => integerSectionLocus_le X U s a

/-- Every stalk of the constant sheaf with value `A` is `A`. -/
private noncomputable def constantStalkIso (A : AddCommGrpCat.{u}) (x : X) :
    TopCat.Presheaf.stalk (constantSheafOnSpace X AddCommGrpCat.{u} A).obj x ≅ A := by
  let P := constantPresheafOnSpace X AddCommGrpCat.{u}
    A
  have hunit : IsIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X) P)) :=
    TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x AddCommGrpCat.{u} P
  letI : IsConnected (OpenNhds x)ᵒᵖ := IsFiltered.isConnected _
  exact (asIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X) P))).symm ≪≫
    ((isColimitConstCocone (OpenNhds x)ᵒᵖ A).coconePointUniqueUpToIso
      (colimit.isColimit ((OpenNhds.inclusion x).op ⋙ P))).symm

/-- At a point of `U`, the stalk of the extension by zero from `U` of the constant sheaf of
integers is `ℤ`. -/
private noncomputable def integerExtensionStalkIso
    (U : Opens X) (x : U) :
    TopCat.Presheaf.stalk
      ((TopCat.Presheaf.extendByInitialSheaf U).obj
        (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).presheaf
      (U.inclusion' x) ≅ AddCommGrpCat.of (ULift.{u} ℤ) :=
  TopCat.Presheaf.stalkExtendByInitialSheafifyIso
    (U := U) (F := (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))).obj) x ≪≫
    constantStalkIso (TopCat.of U) (AddCommGrpCat.of (ULift.{u} ℤ)) x

/-- Off `U`, the stalks of the extension by zero from `U` vanish. -/
private theorem integerExtensionStalk_isZero
    (U : Opens X) (x : X) (hx : x ∉ U) :
    IsZero ((integerExtensionByZero X U).presheaf.stalk x) :=
  TopCat.Presheaf.isZero_stalk_extendByInitialSheafify U
    (integerConstantSheaf (TopCat.of U)).obj hx

/-- The morphism from the constant presheaf of integers to a sheaf `H` sending the constant `n`
to `n` times a given global section of `H`. -/
private def constantPresheafMapOfSection (Y : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{u} Y)
    (s : H.obj.obj (op (⊤ : Opens Y))) :
    constantPresheafOnSpace Y AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ H.obj where
  app V := AddCommGrpCat.ofHom {
    toFun := fun n : ULift.{u} ℤ => n.down •
      H.obj.map (op (homOfLE (le_top : unop V ≤ ⊤))) s
    map_zero' := by simp
    map_add' := fun a b => by simp [add_zsmul] }
  naturality := by
    intro V W i
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro n
    change n.down • H.obj.map (op (homOfLE (le_top : unop W ≤ ⊤))) s =
      H.obj.map i (n.down • H.obj.map (op (homOfLE (le_top : unop V ≤ ⊤))) s)
    rw [map_zsmul, ← Functor.map_comp_apply]
    congr 1

/-- The morphism from the constant sheaf of integers to `H` determined by a global section
of `H`. -/
private noncomputable def constantSheafHomOfSection (Y : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{u} Y)
    (s : H.obj.obj (op (⊤ : Opens Y))) :
    constantSheafOnSpace Y AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ H :=
  ((sheafificationAdjunction (Opens.grothendieckTopology Y)
    AddCommGrpCat.{u}).homEquiv _ H).symm
      (constantPresheafMapOfSection Y H s)

/-- The morphism `j_! ℤ_U ⟶ H` determined by a section of `H` over `U`, through the sheafification
and extension-by-zero adjunctions. -/
private noncomputable def extensionHomOfSection
    (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (s : ((U.sheafRestrict).obj H).obj.obj (op (⊤ : Opens (TopCat.of U)))) :
    (TopCat.Presheaf.extendByInitialSheaf U).obj
      (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ H :=
  ((TopCat.Presheaf.extendByInitialSheafAdjunction U).homEquiv _ H).symm
    (constantSheafHomOfSection (TopCat.of U) ((U.sheafRestrict).obj H) s)

/-- The constant section with value `a` over `U`, read as a global section of the restriction of
the constant sheaf of integers to `U`. -/
private noncomputable def constantSectionOnOpen (U : Opens X) (a : ULift.{u} ℤ) :
    ((U.sheafRestrict).obj
      (constantSheafOnSpace X AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ)))).obj.obj
      (op (⊤ : Opens (TopCat.of U))) := by
  let v : (constantSheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))).obj.obj (op U) :=
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
      (constantPresheafOnSpace X AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ)))).app _ a
  change ↑((constantSheafOnSpace X AddCommGrpCat.{u}
    (AddCommGrpCat.of (ULift.{u} ℤ))).obj.obj
      (op (U.isOpenEmbedding.functor.obj ⊤)))
  simpa only [U.isOpenEmbedding_obj_top] using v

/-- The morphism `j_! ℤ_U ⟶ ℤ` determined by the constant section with value `a` over `U`. -/
private noncomputable def coefficientExtensionHom (U : Opens X) (a : ULift.{u} ℤ) :
    integerExtensionByZero X U ⟶ integerConstantSheaf X :=
  extensionHomOfSection X U
    (constantSheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)))
    (constantSectionOnOpen X U a)

/-- A morphism out of `ℤ` is determined by the image of `1`. -/
private theorem apply_eq_zsmul_one {M : AddCommGrpCat.{u}}
    (g : AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M) (z : ULift.{u} ℤ) :
    g z = z.down • g (ULift.up (1 : ℤ)) := by
  obtain ⟨n⟩ := z
  have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) :=
    congrArg ULift.up (by simp)
  exact (congrArg g hn).trans (g.hom.map_zsmul n _)

/-- Two morphisms out of the constant presheaf of integers are equal as soon as they agree on the
constant `1` over the whole space. -/
private theorem constantPresheafMap_ext_one (Y : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{u} Y)
    (α β : constantPresheafOnSpace Y AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ H.obj)
    (h : α.app (op (⊤ : Opens Y)) (ULift.up (1 : ℤ)) =
      β.app (op (⊤ : Opens Y)) (ULift.up (1 : ℤ))) : α = β := by
  have htop : ∀ n : ULift.{u} ℤ,
      α.app (op (⊤ : Opens Y)) n = β.app (op (⊤ : Opens Y)) n := fun n =>
    (apply_eq_zsmul_one (α.app _) n).trans
      ((congrArg (n.down • ·) h).trans (apply_eq_zsmul_one (β.app _) n).symm)
  ext V n
  let i : (op (⊤ : Opens Y)) ⟶ op V :=
    (homOfLE (le_top : V ≤ ⊤)).op
  have hα := NatTrans.naturality_apply α i n
  have hβ := NatTrans.naturality_apply β i n
  change α.app (op V) n = H.obj.map i (α.app (op (⊤ : Opens Y)) n) at hα
  change β.app (op V) n = H.obj.map i (β.app (op (⊤ : Opens Y)) n) at hβ
  rw [hα, hβ]
  exact congrArg (fun z => H.obj.map i z) (htop n)

/-- The section of `H` attached to a morphism `j_! ℤ_U ⟶ H`, as a global section of the
restriction of `H` to `U`. -/
private noncomputable def extensionSectionOnRestricted
    (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : (TopCat.Presheaf.extendByInitialSheaf U).obj
      (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ H) :
    ((U.sheafRestrict).obj H).obj.obj (op (⊤ : Opens (TopCat.of U))) :=
  ((sheafificationAdjunction (Opens.grothendieckTopology (TopCat.of U))
    AddCommGrpCat.{u}).homEquiv _ _
      ((TopCat.Presheaf.extendByInitialSheafAdjunction U).homEquiv _ _ f)).app
        (op (⊤ : Opens (TopCat.of U))) (ULift.up (1 : ℤ))

/-- A morphism `j_! ℤ_U ⟶ H` is recovered from its attached section. -/
private theorem extensionHomOfSection_extensionSectionOnRestricted
    (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : (TopCat.Presheaf.extendByInitialSheaf U).obj
      (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ H) :
    extensionHomOfSection X U H (extensionSectionOnRestricted X U H f) = f := by
  apply ((TopCat.Presheaf.extendByInitialSheafAdjunction U).homEquiv _ _).injective
  apply ((sheafificationAdjunction (Opens.grothendieckTopology (TopCat.of U))
    AddCommGrpCat.{u}).homEquiv _ _).injective
  let e₁ := (TopCat.Presheaf.extendByInitialSheafAdjunction U).homEquiv
    (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))) H
  let e₂ := (sheafificationAdjunction (Opens.grothendieckTopology (TopCat.of U))
    AddCommGrpCat.{u}).homEquiv
      (constantPresheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ((U.sheafRestrict).obj H)
  let p := constantPresheafMapOfSection (TopCat.of U) ((U.sheafRestrict).obj H)
    (extensionSectionOnRestricted X U H f)
  show e₂ (e₁ (e₁.symm (e₂.symm p))) = e₂ (e₁ f)
  calc
    e₂ (e₁ (e₁.symm (e₂.symm p))) = p :=
      (congrArg e₂ (e₁.apply_symm_apply _)).trans (e₂.apply_symm_apply _)
    _ = e₂ (e₁ f) := by
      apply constantPresheafMap_ext_one (TopCat.of U) ((U.sheafRestrict).obj H)
      show (1 : ℤ) • ((U.sheafRestrict.obj H).obj.map (𝟙 _))
          ((e₂ (e₁ f)).app (op ⊤) (ULift.up (1 : ℤ))) =
        (e₂ (e₁ f)).app (op ⊤) (ULift.up (1 : ℤ))
      simp


/-- The section attached to the morphism determined by a section is that section. -/
private theorem extensionSectionOnRestricted_extensionHomOfSection
    (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (s : ((U.sheafRestrict).obj H).obj.obj (op (⊤ : Opens (TopCat.of U)))) :
    extensionSectionOnRestricted X U H (extensionHomOfSection X U H s) = s := by
  let e₁ := (TopCat.Presheaf.extendByInitialSheafAdjunction U).homEquiv
    (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ))) H
  let e₂ := (sheafificationAdjunction (Opens.grothendieckTopology (TopCat.of U))
    AddCommGrpCat.{u}).homEquiv
      (constantPresheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ((U.sheafRestrict).obj H)
  let p := constantPresheafMapOfSection (TopCat.of U) ((U.sheafRestrict).obj H) s
  show (e₂ (e₁ (e₁.symm (e₂.symm p)))).app
    (op (⊤ : Opens (TopCat.of U))) (ULift.up (1 : ℤ)) = s
  have hcalc : e₂ (e₁ (e₁.symm (e₂.symm p))) = p :=
    (congrArg e₂ (e₁.apply_symm_apply _)).trans (e₂.apply_symm_apply _)
  calc
    (e₂ (e₁ (e₁.symm (e₂.symm p)))).app
        (op (⊤ : Opens (TopCat.of U))) (ULift.up (1 : ℤ)) =
      p.app (op (⊤ : Opens (TopCat.of U))) (ULift.up (1 : ℤ)) :=
        congrArg (fun q : constantPresheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ ((U.sheafRestrict).obj H).obj =>
            q.app (op (⊤ : Opens (TopCat.of U))) (ULift.up (1 : ℤ))) hcalc
    _ = s := by
      show (1 : ℤ) • ((U.sheafRestrict.obj H).obj.map (𝟙 _)) s = s
      simp

/-- The section attached to `f ≫ g` is the image under `g` of the section attached to `f`. -/
private theorem extensionSectionOnRestricted_comp
    (U : Opens X) (H K : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : (TopCat.Presheaf.extendByInitialSheaf U).obj
      (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ H)
    (g : H ⟶ K) :
    extensionSectionOnRestricted X U K (f ≫ g) =
      ((U.sheafRestrict).map g).hom.app (op (⊤ : Opens (TopCat.of U)))
        (extensionSectionOnRestricted X U H f) := by
  let ad := TopCat.Presheaf.extendByInitialSheafAdjunction (C := AddCommGrpCat.{u}) U
  let sh := sheafificationAdjunction (Opens.grothendieckTopology (TopCat.of U))
    AddCommGrpCat.{u}
  have h₁ := ad.homEquiv_naturality_right f g
  have h₂ := sh.homEquiv_naturality_right (ad.homEquiv _ H f) ((U.sheafRestrict).map g)
  dsimp [extensionSectionOnRestricted]
  let P := constantPresheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
    (AddCommGrpCat.of (ULift.{u} ℤ))
  have hmaps := (congrArg (fun q => (sh.homEquiv P ((U.sheafRestrict).obj K)) q) h₁).trans h₂
  exact congrArg
    (fun q : P ⟶ ((U.sheafRestrict).obj K).obj =>
      q.app (op (⊤ : Opens (TopCat.of U))) (ULift.up (1 : ℤ))) hmaps

/-- The section attached to `coefficientExtensionHom X U a` is the constant section `a`. -/
private lemma extensionSection_coefficientExtensionHom
    (U : Opens X) (a : ULift.{u} ℤ) :
    extensionSectionOnRestricted X U (integerConstantSheaf X)
      (coefficientExtensionHom X U a) = constantSectionOnOpen X U a :=
  extensionSectionOnRestricted_extensionHomOfSection X U
    (integerConstantSheaf X) (constantSectionOnOpen X U a)

/-- The section of `H` over `U` attached to a morphism `j_! ℤ_U ⟶ H`. -/
private noncomputable def sectionOfExtensionHomViaAdjunction
    (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : (TopCat.Presheaf.extendByInitialSheaf U).obj
      (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ H) : H.obj.obj (op U) := by
  let h : U.isOpenEmbedding.functor.obj ⊤ = U := U.isOpenEmbedding_obj_top
  exact Eq.mp (congrArg (fun V : Opens X => CategoryTheory.ToType (H.obj.obj (op V))) h)
    (extensionSectionOnRestricted X U H f)

/-- Applying a morphism of sheaves commutes with transporting a section along an equality of
opens. -/
private theorem cast_natTrans_app (H K : TopCat.Sheaf AddCommGrpCat.{u} X)
    (g : H ⟶ K) {V W : Opens X} (h : V = W)
    (s : H.obj.obj (op V)) :
    Eq.mp (congrArg (fun T : Opens X => CategoryTheory.ToType (K.obj.obj (op T))) h)
      (g.hom.app (op V) s) =
      g.hom.app (op W)
        (Eq.mp (congrArg (fun T : Opens X => CategoryTheory.ToType (H.obj.obj (op T))) h) s) := by
  cases h
  rfl

/-- Transporting a section along an equality of opens and back is the identity. -/
private theorem cast_cast_symm (H : TopCat.Sheaf AddCommGrpCat.{u} X) {V W : Opens X} (h : V = W)
    (s : H.obj.obj (op W)) :
    Eq.mp (congrArg (fun T : Opens X => CategoryTheory.ToType (H.obj.obj (op T))) h)
      (Eq.mp (congrArg (fun T : Opens X => CategoryTheory.ToType (H.obj.obj (op T))) h.symm) s) =
      s := by
  cases h
  rfl

/-- The section attached to `f ≫ g` is the image under `g` of the section attached to `f`. -/
private theorem sectionOfExtensionHomViaAdjunction_comp
    (U : Opens X) (H K : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : (TopCat.Presheaf.extendByInitialSheaf U).obj
      (constantSheafOnSpace (TopCat.of U) AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ H)
    (g : H ⟶ K) :
    sectionOfExtensionHomViaAdjunction X U K (f ≫ g) =
      g.hom.app (op U) (sectionOfExtensionHomViaAdjunction X U H f) := by
  unfold sectionOfExtensionHomViaAdjunction
  rw [extensionSectionOnRestricted_comp]
  exact cast_natTrans_app X H K g U.isOpenEmbedding_obj_top
    (extensionSectionOnRestricted X U H f)

/-- The section attached to `f` is the image of the tautological section under `f`. -/
private theorem sectionOfExtensionHom_eq_app (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : integerExtensionByZero X U ⟶ H) :
    sectionOfExtensionHomViaAdjunction X U H f =
      f.hom.app (op U)
        (sectionOfExtensionHomViaAdjunction X U (integerExtensionByZero X U) (𝟙 _)) := by
  have h := sectionOfExtensionHomViaAdjunction_comp X U _ H (𝟙 _) f
  rwa [Category.id_comp] at h

/-- A section of `H` over `U` whose restrictions to an open cover of `U` all lift to a subobject
`A` lifts to `A`. -/
private theorem subobject_section_glue
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    (U : Opens X) {ι : Type u} (V : ι → Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ iSup V)
    (s : H.obj.obj (op U))
    (t : ∀ i, (A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op (V i)))
    (ht : ∀ i, A.arrow.hom.app (op (V i)) (t i) =
      H.obj.map (op (homOfLE (hVU i))) s) :
    ∃ tU : (A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op U),
      A.arrow.hom.app (op U) tU = s := by
  have hinj (W : Opens X) : Function.Injective (A.arrow.hom.app (op W)) := by
    have hm : Mono (A.arrow.hom.app (op W)) :=
      (NatTrans.mono_iff_mono_app A.arrow.hom).mp
        ((CategoryTheory.Sheaf.Hom.mono_iff_presheaf_mono _ _ A.arrow).mp
          (Subobject.arrow_mono A))
          (op W)
    exact (ConcreteCategory.mono_iff_injective_of_preservesPullback _).mp hm
  have hcompat : TopCat.Presheaf.IsCompatible
      (A : TopCat.Sheaf AddCommGrpCat.{u} X).obj V t := by
    intro i j
    apply hinj (V i ⊓ V j)
    have hi := NatTrans.naturality_apply A.arrow.hom
      (op (Opens.infLELeft (V i) (V j))) (t i)
    have hj := NatTrans.naturality_apply A.arrow.hom
      (op (Opens.infLERight (V i) (V j))) (t j)
    show A.arrow.hom.app (op (V i ⊓ V j))
        ((A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.map
          (op (Opens.infLELeft (V i) (V j))) (t i)) =
      A.arrow.hom.app (op (V i ⊓ V j))
        ((A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.map
          (op (Opens.infLERight (V i) (V j))) (t j))
    calc
      _ = H.obj.map (op (Opens.infLELeft (V i) (V j)))
          (A.arrow.hom.app (op (V i)) (t i)) := hi
      _ = H.obj.map (op (Opens.infLERight (V i) (V j)))
          (A.arrow.hom.app (op (V j)) (t j)) := by
            rw [ht i, ht j]
            simp only [← ConcreteCategory.comp_apply, ← Functor.map_comp]
            congr 1
      _ = _ := hj.symm
  obtain ⟨tU, htU, _⟩ := (A : TopCat.Sheaf AddCommGrpCat.{u} X).existsUnique_gluing'
    V U (fun i => homOfLE (hVU i)) hcover t hcompat
  refine ⟨tU, ?_⟩
  apply H.eq_of_locally_eq' V U (fun i => homOfLE (hVU i)) hcover
  intro i
  show H.obj.map (op (homOfLE (hVU i)))
      (A.arrow.hom.app (op U) tU) = H.obj.map (op (homOfLE (hVU i))) s
  rw [← ht i, ← htU i]
  exact (NatTrans.naturality_apply A.arrow.hom
    (op (homOfLE (hVU i))) tU).symm

/-- A morphism `j_! ℤ_U ⟶ H` is determined by its attached section over `U`. -/
private theorem sectionOfExtensionHomViaAdjunction_injective
    (U : Opens X) (H : TopCat.Sheaf AddCommGrpCat.{u} X) :
    Function.Injective (sectionOfExtensionHomViaAdjunction X U H) := by
  intro f g h
  have h' : extensionSectionOnRestricted X U H f =
      extensionSectionOnRestricted X U H g := by
    unfold sectionOfExtensionHomViaAdjunction at h
    let e := Equiv.cast (congrArg
      (fun V : Opens X => CategoryTheory.ToType (H.obj.obj (op V)))
      U.isOpenEmbedding_obj_top)
    exact e.injective h
  calc
    f = extensionHomOfSection X U H (extensionSectionOnRestricted X U H f) :=
      (extensionHomOfSection_extensionSectionOnRestricted X U H f).symm
    _ = extensionHomOfSection X U H (extensionSectionOnRestricted X U H g) := by
      rw [h']
    _ = g := extensionHomOfSection_extensionSectionOnRestricted X U H g

/-- A morphism `j_! ℤ_U ⟶ H` factors through a subobject `A` as soon as its attached section
lifts to `A`. -/
private theorem extensionHom_factors_of_section_lift
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    (U : Opens X) (f : integerExtensionByZero X U ⟶ H)
    (t : (A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op U))
    (ht : A.arrow.hom.app (op U) t =
      sectionOfExtensionHomViaAdjunction X U H f) :
    ∃ g : integerExtensionByZero X U ⟶
        (A : TopCat.Sheaf AddCommGrpCat.{u} X), g ≫ A.arrow = f := by
  let t' : ((U.sheafRestrict).obj
      (A : TopCat.Sheaf AddCommGrpCat.{u} X)).obj.obj
      (op (⊤ : Opens (TopCat.of U))) :=
    Eq.mp (congrArg
      (fun V : Opens X => CategoryTheory.ToType
        ((A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op V)))
      U.isOpenEmbedding_obj_top.symm) t
  let g := extensionHomOfSection X U
    (A : TopCat.Sheaf AddCommGrpCat.{u} X) t'
  refine ⟨g, ?_⟩
  apply sectionOfExtensionHomViaAdjunction_injective X U H
  rw [sectionOfExtensionHomViaAdjunction_comp]
  have hg : sectionOfExtensionHomViaAdjunction X U
      (A : TopCat.Sheaf AddCommGrpCat.{u} X) g = t := by
    show Eq.mp (congrArg
      (fun V : Opens X => CategoryTheory.ToType
        ((A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op V)))
      U.isOpenEmbedding_obj_top)
      (extensionSectionOnRestricted X U
        (A : TopCat.Sheaf AddCommGrpCat.{u} X) g) = t
    rw [extensionSectionOnRestricted_extensionHomOfSection]
    exact cast_cast_symm X (A : TopCat.Sheaf AddCommGrpCat.{u} X) U.isOpenEmbedding_obj_top t
  rw [hg, ht]

/-- The section over `U` attached to `coefficientExtensionHom X U a` is the constant section
`a`. -/
private theorem sectionOf_coefficientExtensionHom
    (U : Opens X) (a : ULift.{u} ℤ) :
    sectionOfExtensionHomViaAdjunction X U (integerConstantSheaf X)
      (coefficientExtensionHom X U a) =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U) a := by
  unfold sectionOfExtensionHomViaAdjunction
  rw [extensionSection_coefficientExtensionHom]
  unfold constantSectionOnOpen
  exact cast_cast_symm X (integerConstantSheaf X) U.isOpenEmbedding_obj_top _

/-- A section of `H` over `U` which lifts to a subobject `A` locally on `U` lifts to `A`. -/
private theorem subobject_section_lift_of_local
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    (U : Opens X) (s : H.obj.obj (op U))
    (hlocal : ∀ x : U, ∃ V : Opens X, ∃ hVU : V ≤ U,
      (x : X) ∈ V ∧
        ∃ t : (A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op V),
          A.arrow.hom.app (op V) t = H.obj.map (op (homOfLE hVU)) s) :
    ∃ t : (A : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op U),
      A.arrow.hom.app (op U) t = s := by
  choose V hVU hxV t ht using hlocal
  have hcover : U ≤ iSup V := by
    intro x hx
    exact Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxV ⟨x, hx⟩⟩
  exact subobject_section_glue X H A U V hVU hcover s t ht

/-- A quasi-compact open is the union of finitely many quasi-compact loci on which the section
attached to a morphism `j_! ℤ_U ⟶ ℤ` is constant. -/
private theorem finite_compact_value_loci_viaAdjunction
    (U : Opens X) (hU : IsCompact (U : Set X))
    (f : integerExtensionByZero X U ⟶ integerConstantSheaf X) :
    ∃ t : Finset (ULift.{u} ℤ),
      U = t.sup (integerSectionLocus X U
        (sectionOfExtensionHomViaAdjunction X U (integerConstantSheaf X) f)) ∧
        ∀ a ∈ t,
          IsCompact (integerSectionLocus X U
            (sectionOfExtensionHomViaAdjunction X U (integerConstantSheaf X) f) a : Set X) := by
  obtain ⟨t, ht⟩ := exists_finite_integerSectionLocus_cover X U hU
    (sectionOfExtensionHomViaAdjunction X U (integerConstantSheaf X) f)
  exact ⟨t, ht, fun a _ => compact_integerSectionLocus X U hU
    (sectionOfExtensionHomViaAdjunction X U (integerConstantSheaf X) f) a⟩

/-- A short complex whose first map is invertible and whose third term vanishes is short exact. -/
private lemma shortExact_of_iso_f_zero_right
    {C : Type*} [Category C] [Abelian C]
    (S : ShortComplex C) [IsIso S.f] (h : IsZero S.X₃) : S.ShortExact where
  exact := (S.exact_iff_epi (h.eq_of_tgt _ _)).2 inferInstance
  mono_f := inferInstance
  epi_g := epi_of_target_iso_zero _ h.isoZero

/-- A short complex whose second map is invertible and whose first term vanishes is short exact. -/
private lemma shortExact_of_iso_g_zero_left
    {C : Type*} [Category C] [Abelian C]
    (S : ShortComplex C) [IsIso S.g] (h : IsZero S.X₁) : S.ShortExact where
  exact := (S.exact_iff_mono (h.eq_of_src _ _)).2 inferInstance
  mono_f := mono_of_source_iso_zero _ h.isoZero
  epi_g := inferInstance

/-- Short exactness checked separately on the three strata `V`, `U ∖ V` and the complement
of `U`. -/
private lemma shortExact_of_stalk_strata
    (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{u} X))
    (U V : Opens X)
    (hV : ∀ x : X, x ∈ V →
      let T := S.map (TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x)
      IsIso T.f ∧ IsZero T.X₃)
    (hUV : ∀ x : X, x ∈ U → x ∉ V →
      let T := S.map (TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x)
      IsIso T.g ∧ IsZero T.X₁)
    (hout : ∀ x : X, x ∉ U →
      let T := S.map (TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x)
      IsZero T.X₁ ∧ IsZero T.X₂ ∧ IsZero T.X₃) : S.ShortExact := by
  apply TopCat.Sheaf.shortExact_of_stalk S
  intro x
  let T := S.map (TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
    TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x)
  show T.ShortExact
  by_cases hxV : x ∈ V
  · obtain ⟨hf, hz⟩ := hV x hxV
    let _hfIso : IsIso T.f := hf
    exact shortExact_of_iso_f_zero_right T hz
  by_cases hxU : x ∈ U
  · obtain ⟨hg, hz⟩ := hUV x hxU hxV
    let _hgIso : IsIso T.g := hg
    exact shortExact_of_iso_g_zero_left T hz
  · obtain ⟨hz₁, hz₂, hz₃⟩ := hout x hxU
    let _hfIso : IsIso T.f := isIso_of_source_target_iso_zero T.f hz₁.isoZero hz₂.isoZero
    exact shortExact_of_iso_f_zero_right T hz₃

/-- An additive subgroup of `ℤ` containing two integers contains their greatest common divisor. -/
private lemma gcd_mem_addSubgroup (H : AddSubgroup ℤ) {a b : ℤ}
    (ha : a ∈ H) (hb : b ∈ H) : ((a.gcd b : ℕ) : ℤ) ∈ H := by
  rw [Int.gcd_eq_gcd_ab]
  have h₁ := H.zsmul_mem ha (a.gcdA b)
  have h₂ := H.zsmul_mem hb (a.gcdB b)
  simpa [zsmul_eq_mul, mul_comm] using H.add_mem h₁ h₂

/-- An additive subgroup of `ℤ` containing a finite family of integers contains the greatest
common divisor of their absolute values. -/
private lemma finset_gcd_natAbs_mem_addSubgroup {ι : Type*} (s : Finset ι)
    (a : ι → ℤ) (H : AddSubgroup ℤ) (h : ∀ i ∈ s, a i ∈ H) :
    ((s.gcd fun i => (a i).natAbs : ℕ) : ℤ) ∈ H := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s his ih =>
      have hi : a i ∈ H := h i (Finset.mem_insert_self i s)
      have hs : ∀ j ∈ s, a j ∈ H := by
        intro j hj
        exact h j (Finset.mem_insert_of_mem hj)
      simpa [Finset.gcd_insert, gcd_eq_nat_gcd, Int.gcd_eq_natAbs] using
        gcd_mem_addSubgroup H hi (ih hs)

/-- The additive subgroup of those integers `a` whose constant section `a` over `U` lifts to the
subsheaf `F`. -/
private noncomputable def liftableIntegerCoefficients
    (F : Subobject (integerConstantSheaf X)) (U : Opens X) : AddSubgroup ℤ :=
  let f := (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
    (constantPresheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U)
  (AddMonoidHom.range (F.arrow.hom.app (op U)).hom).comap
    { toFun := fun a => f (ULift.up a)
      map_zero' := by change f.hom (0 : ULift.{u} ℤ) = 0; exact f.hom.map_zero
      map_add' := by
        intro a b
        change f.hom (ULift.up (a + b)) = f.hom (ULift.up a) + f.hom (ULift.up b)
        exact f.hom.map_add _ _ }

/-- Liftable coefficients only grow as the open shrinks. -/
private lemma liftableIntegerCoefficients_mono
    (F : Subobject (integerConstantSheaf X)) {U V : Opens X} (hVU : V ≤ U) :
    liftableIntegerCoefficients X F U ≤ liftableIntegerCoefficients X F V := by
  rintro a ⟨s, hs⟩
  refine ⟨(F : TopCat.Sheaf AddCommGrpCat.{u} X).obj.map (op (homOfLE hVU)) s, ?_⟩
  have hF := NatTrans.naturality_apply F.arrow.hom (op (homOfLE hVU)) s
  show F.arrow.hom.app (op V)
      ((F : TopCat.Sheaf AddCommGrpCat.{u} X).obj.map (op (homOfLE hVU)) s) =
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
      (constantPresheafOnSpace X AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op V) (ULift.up a)
  rw [hF, hs]
  exact constant_unit_restrict X U V hVU (ULift.up a)

/-- A coefficient liftable locally on `U` is liftable on `U`. -/
private lemma liftableIntegerCoefficients_of_locally
    (F : Subobject (integerConstantSheaf X)) (U : Opens X) (a : ℤ)
    (hlocal : ∀ x : U, ∃ V : Opens X, ∃ _hVU : V ≤ U,
      (x : X) ∈ V ∧ a ∈ liftableIntegerCoefficients X F V) :
    a ∈ liftableIntegerCoefficients X F U := by
  let σ : (integerConstantSheaf X).obj.obj (op U) :=
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
      (constantPresheafOnSpace X AddCommGrpCat.{u}
        (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U) (ULift.up a)
  have hloc : ∀ x : U, ∃ V : Opens X, ∃ hVU : V ≤ U,
      (x : X) ∈ V ∧
        ∃ t : (F : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op V),
          F.arrow.hom.app (op V) t =
            (integerConstantSheaf X).obj.map (op (homOfLE hVU)) σ := by
    intro x
    obtain ⟨V, hVU, hxV, ha⟩ := hlocal x
    obtain ⟨t, ht⟩ := ha
    refine ⟨V, hVU, hxV, t, ?_⟩
    rw [ht]
    exact (constant_unit_restrict X U V hVU (ULift.up a)).symm
  exact subobject_section_lift_of_local X (integerConstantSheaf X) F U σ hloc

/-- If the coefficient `a` is liftable over `U`, then `coefficientExtensionHom X U a` factors
through `F`. -/
private theorem coefficientExtensionHom_factors
    (F : Subobject (integerConstantSheaf X)) (U : Opens X) (a : ℤ)
    (ha : a ∈ liftableIntegerCoefficients X F U) :
    ∃ q : integerExtensionByZero X U ⟶
        (F : TopCat.Sheaf AddCommGrpCat.{u} X),
      q ≫ F.arrow = coefficientExtensionHom X U (ULift.up a) := by
  obtain ⟨s, hs⟩ := ha
  apply extensionHom_factors_of_section_lift X (integerConstantSheaf X) F U
    (coefficientExtensionHom X U (ULift.up a)) s
  exact hs.trans (sectionOf_coefficientExtensionHom X U (ULift.up a)).symm

/-- If `a` and `b` are jointly epimorphic, then `b` followed by the cokernel of `a` is
an epimorphism. -/
private theorem epi_to_cokernel_of_joint_epi
    {C : Type*} [Category C] [Abelian C]
    {A E B : C} (a : A ⟶ B) (b : E ⟶ B)
    [Epi (coprod.desc a b)] : Epi (b ≫ cokernel.π a) := by
  constructor
  intro T f g h
  have h' : (coprod.desc a b) ≫ cokernel.π a ≫ f =
      (coprod.desc a b) ≫ cokernel.π a ≫ g := by
    apply coprod.hom_ext
    · simp only [← Category.assoc, coprod.inl_desc, cokernel.condition, zero_comp]
    · simpa only [← Category.assoc, coprod.inr_desc] using h
  have h'' : cokernel.π a ≫ f = cokernel.π a ≫ g :=
    (cancel_epi (coprod.desc a b)).mp (by simpa [Category.assoc] using h')
  exact (cancel_epi (cokernel.π a)).mp h''

/-- The subobject generated by a subobject `A` together with the image of a morphism `q`. -/
private noncomputable def adjoinImage
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    {E : TopCat.Sheaf AddCommGrpCat.{u} X} (q : E ⟶ H) : Subobject H :=
  imageSubobject (coprod.desc A.arrow q)

/-- A subobject is contained in the subobject it generates together with the image of `q`. -/
private lemma le_adjoinImage
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    {E : TopCat.Sheaf AddCommGrpCat.{u} X} (q : E ⟶ H) :
    A ≤ adjoinImage X H A q := by
  apply Subobject.le_of_comm
    (coprod.inl ≫ factorThruImageSubobject (coprod.desc A.arrow q))
  simp only [Category.assoc, imageSubobject_arrow_comp, coprod.inl_desc]

/-- The factorization of `q` through `adjoinImage X H A q`. -/
private noncomputable def adjoinImageFactor
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    {E : TopCat.Sheaf AddCommGrpCat.{u} X} (q : E ⟶ H) :
    E ⟶ (adjoinImage X H A q : TopCat.Sheaf AddCommGrpCat.{u} X) :=
  coprod.inr ≫ factorThruImageSubobject (coprod.desc A.arrow q)

/-- The factorization of `q` through `adjoinImage X H A q` composed with the inclusion is `q`. -/
private lemma adjoinImageFactor_arrow
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    {E : TopCat.Sheaf AddCommGrpCat.{u} X} (q : E ⟶ H) :
    adjoinImageFactor X H A q ≫ (adjoinImage X H A q).arrow = q := by
  simp only [adjoinImageFactor, adjoinImage, Category.assoc,
    imageSubobject_arrow_comp, coprod.inr_desc]

/-- The morphism `q` becomes an epimorphism onto the quotient of `adjoinImage X H A q` by `A`. -/
private lemma adjoinImage_cokernel_epi
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    {E : TopCat.Sheaf AddCommGrpCat.{u} X} (q : E ⟶ H) :
    Epi (adjoinImageFactor X H A q ≫
      cokernel.π (Subobject.ofLE A (adjoinImage X H A q)
        (le_adjoinImage X H A q))) := by
  let e := factorThruImageSubobject (coprod.desc A.arrow q)
  have he : coprod.desc
      (Subobject.ofLE A (adjoinImage X H A q) (le_adjoinImage X H A q))
      (adjoinImageFactor X H A q) = e := by
    apply coprod.hom_ext
    · rw [coprod.inl_desc]
      apply (cancel_mono (adjoinImage X H A q).arrow).mp
      rw [Subobject.ofLE_arrow]
      show A.arrow =
        (coprod.inl ≫ factorThruImageSubobject (coprod.desc A.arrow q)) ≫
          (imageSubobject (coprod.desc A.arrow q)).arrow
      simp only [Category.assoc, imageSubobject_arrow_comp, coprod.inl_desc]
    · rw [coprod.inr_desc]
      rfl
  have hepi : Epi e := by
    dsimp [e]
    infer_instance
  have : Epi (coprod.desc
      (Subobject.ofLE A (adjoinImage X H A q) (le_adjoinImage X H A q))
      (adjoinImageFactor X H A q)) := he ▸ hepi
  exact epi_to_cokernel_of_joint_epi
    (Subobject.ofLE A (adjoinImage X H A q) (le_adjoinImage X H A q))
    (adjoinImageFactor X H A q)

/-- Adjoining the image of `q` to `A` gives the supremum of `A` and the image of `q`. -/
private theorem adjoinImage_eq_sup
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    {E : TopCat.Sheaf AddCommGrpCat.{u} X} (q : E ⟶ H) :
    adjoinImage X H A q = A ⊔ imageSubobject q := by
  apply le_antisymm
  · let B := A ⊔ imageSubobject q
    apply imageSubobject_le (coprod.desc A.arrow q)
      (coprod.desc (Subobject.ofLE A B le_sup_left)
        (factorThruImageSubobject q ≫
          Subobject.ofLE (imageSubobject q) B le_sup_right))
    apply coprod.hom_ext
    · simp only [← Category.assoc, coprod.inl_desc, Subobject.ofLE_arrow]
    · rw [← Category.assoc, coprod.inr_desc,
        Category.assoc, Subobject.ofLE_arrow, imageSubobject_arrow_comp]
      rw [coprod.inr_desc]
  · apply sup_le
    · exact le_adjoinImage X H A q
    · exact imageSubobject_le q (adjoinImageFactor X H A q)
        (adjoinImageFactor_arrow X H A q)

/-- Under the stalkwise hypotheses, the quotient of `A ⊔ im q` by `A` is presented by a short exact
sequence `0 ⟶ j'_! ℤ_V ⟶ j_! ℤ_U ⟶ (A ⊔ im q) / A ⟶ 0`. -/
private theorem shortExact_adjoinImage
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) (A : Subobject H)
    (U V : Opens X) (hVU : V ≤ U)
    (q : integerExtensionByZero X U ⟶ H)
    (a : integerExtensionByZero X V ⟶ integerExtensionByZero X U)
    (haV : ∀ x : X, x ∈ V →
      IsIso ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map a))
    (hAq : ∀ x : X, x ∈ U → x ∉ V →
      IsZero ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).obj
          (A : TopCat.Sheaf AddCommGrpCat.{u} X)) ∧
      Mono ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map q))
    (hfac : ∃ r : integerExtensionByZero X V ⟶
      (A : TopCat.Sheaf AddCommGrpCat.{u} X),
      a ≫ q = r ≫ A.arrow) :
    let B := adjoinImage X H A q
    let hAB := le_adjoinImage X H A q
    let b := adjoinImageFactor X H A q ≫
      cokernel.π (Subobject.ofLE A B hAB)
    ∃ hab : a ≫ b = 0,
      (ShortComplex.mk a b hab).ShortExact := by
  dsimp
  let B := adjoinImage X H A q
  let hAB : A ≤ B := le_adjoinImage X H A q
  let inc : (A : TopCat.Sheaf AddCommGrpCat.{u} X) ⟶
      (B : TopCat.Sheaf AddCommGrpCat.{u} X) := Subobject.ofLE A B hAB
  let j : integerExtensionByZero X U ⟶
      (B : TopCat.Sheaf AddCommGrpCat.{u} X) := adjoinImageFactor X H A q
  let b := j ≫ cokernel.π inc
  have : Epi b := adjoinImage_cokernel_epi X H A q
  obtain ⟨r, hr⟩ := hfac
  have hja : a ≫ j = r ≫ inc := by
    apply (cancel_mono B.arrow).mp
    calc
      (a ≫ j) ≫ B.arrow = a ≫ q := by
        rw [Category.assoc, adjoinImageFactor_arrow]
      _ = r ≫ A.arrow := hr
      _ = (r ≫ inc) ≫ B.arrow := by
        rw [Category.assoc, Subobject.ofLE_arrow]
  have hab : a ≫ b = 0 := by
    dsimp [b]
    rw [← Category.assoc, hja, Category.assoc, cokernel.condition, comp_zero]
  refine ⟨hab, ?_⟩
  let S := ShortComplex.mk a b hab
  show S.ShortExact
  apply shortExact_of_stalk_strata X S U V
  · intro x hxV
    let L := TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
    have : IsIso (L.map a) := haV x hxV
    have : Epi (L.map b) := Functor.map_epi L b
    have hb0 : L.map b = 0 := by
      apply (cancel_epi (L.map a)).mp
      have h := congrArg (fun f => L.map f) hab
      simpa only [Functor.map_comp, Functor.map_zero, comp_zero] using h
    show IsIso (L.map a) ∧ IsZero (L.obj (cokernel inc))
    exact ⟨inferInstance, IsZero.of_epi_eq_zero (L.map b) hb0⟩
  · intro x hxU hxV
    let L := TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
    have hzV : IsZero (L.obj (integerExtensionByZero X V)) :=
      integerExtensionStalk_isZero X V x hxV
    obtain ⟨hzA, hqmono⟩ := hAq x hxU hxV
    have hjmono : Mono (L.map j) := by
      have hcomp : L.map j ≫ L.map B.arrow = L.map q := by
        rw [← Functor.map_comp, adjoinImageFactor_arrow]
      have : Mono (L.map q) := hqmono
      exact mono_of_mono_fac hcomp
    let R := ShortComplex.mk inc (cokernel.π inc) (cokernel.condition inc)
    have hR : R.Exact := ShortComplex.exact_cokernel inc
    have hRx : (R.map L).Exact :=
      (TopCat.Sheaf.exact_iff_stalkFunctor_map_exact R).mp hR x
    have hπmono : Mono (L.map (cokernel.π inc)) :=
      ((R.map L).exact_iff_mono (hzA.eq_of_src _ _)).mp hRx
    have : Mono (L.map b) := by
      dsimp only [b]
      rw [Functor.map_comp]
      let _hj := hjmono
      let _hpi := hπmono
      infer_instance
    have : Epi (L.map b) := Functor.map_epi L b
    have : IsIso (L.map b) := isIso_of_mono_of_epi _
    show IsIso (L.map b) ∧ IsZero (L.obj (integerExtensionByZero X V))
    exact ⟨inferInstance, hzV⟩
  · intro x hxU
    let L := TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
    have hzU : IsZero (L.obj (integerExtensionByZero X U)) :=
      integerExtensionStalk_isZero X U x hxU
    have hzV : IsZero (L.obj (integerExtensionByZero X V)) :=
      integerExtensionStalk_isZero X V x (fun hx => hxU (hVU hx))
    have : Epi (L.map b) := Functor.map_epi L b
    have hb0 : L.map b = 0 := hzU.eq_of_src _ _
    exact ⟨hzV, hzU, IsZero.of_epi_eq_zero (L.map b) hb0⟩

/-- A nonzero endomorphism of `ℤ` is injective. -/
private theorem integer_endomorphism_mono_of_nonzero
    (g : AddCommGrpCat.of (ULift.{u} ℤ) ⟶
      AddCommGrpCat.of (ULift.{u} ℤ))
    (hg : ∃ z : ULift.{u} ℤ, g z ≠ 0) : Mono g := by
  have h₁ : g (ULift.up (1 : ℤ)) ≠ 0 := by
    intro hzero
    obtain ⟨z, hz⟩ := hg
    apply hz
    rw [apply_eq_zsmul_one, hzero, smul_zero]
  apply (AddCommGrpCat.mono_iff_injective g).mpr
  intro a b hab
  rw [apply_eq_zsmul_one g a, apply_eq_zsmul_one g b] at hab
  have hmul : a.down * (g (ULift.up (1 : ℤ))).down =
      b.down * (g (ULift.up (1 : ℤ))).down := by
    simpa [zsmul_eq_mul] using congrArg ULift.down hab
  exact ULift.ext _ _ (mul_right_cancel₀ (fun h => h₁ (ULift.ext _ _ h)) hmul)

/-- A nonzero morphism between abelian groups isomorphic to `ℤ` is injective. -/
private theorem mono_of_nonzero_between_integer_stalks
    (A B : AddCommGrpCat.{u})
    (eA : A ≅ AddCommGrpCat.of (ULift.{u} ℤ))
    (eB : B ≅ AddCommGrpCat.of (ULift.{u} ℤ))
    (f : A ⟶ B) (hf : ∃ z : A, f z ≠ 0) : Mono f := by
  let g := eA.inv ≫ f ≫ eB.hom
  have hg : ∃ z : ULift.{u} ℤ, g z ≠ 0 := by
    obtain ⟨z, hz⟩ := hf
    refine ⟨eA.hom z, ?_⟩
    intro hzero
    have hzero' : eB.hom (f z) = 0 := by
      simpa [g] using hzero
    have hinj : Function.Injective eB.hom :=
      (AddCommGrpCat.mono_iff_injective eB.hom).mp inferInstance
    apply hz
    apply hinj
    simpa using hzero'
  have hginj : Function.Injective g :=
    (AddCommGrpCat.mono_iff_injective g).mp
      (integer_endomorphism_mono_of_nonzero g hg)
  apply (AddCommGrpCat.mono_iff_injective f).mpr
  intro x y hxy
  have hgy : g (eA.hom x) = g (eA.hom y) := by
    simpa [g] using congrArg eB.hom hxy
  have hinj : Function.Injective eA.hom :=
    (AddCommGrpCat.mono_iff_injective eA.hom).mp inferInstance
  exact hinj (hginj hgy)

/-- A nonzero constant has nonzero germ in the constant sheaf of integers. -/
private theorem constant_unit_germ_ne_zero
    (U : Opens X) (x : X) (hx : x ∈ U) (a : ULift.{u} ℤ)
    (ha : a ≠ 0) :
    (integerConstantSheaf X).presheaf.germ U x hx
      ((CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U) a) ≠ 0 := by
  let Z := integerConstantSheaf X
  let η := CategoryTheory.toSheafify (Opens.grothendieckTopology X)
    (constantPresheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)))
  intro hzero
  have hzero' : Z.presheaf.germ U x hx (η.app (op U) a) =
      Z.presheaf.germ U x hx (η.app (op U) 0) := by
    rw [hzero, (η.app (op U)).hom.map_zero]
    exact (Z.presheaf.germ U x hx).hom.map_zero.symm
  obtain ⟨W, hxW, i₁, i₂, hW⟩ :=
    Z.presheaf.germ_eq x hx hx (η.app (op U) a) (η.app (op U) 0) hzero'
  have hW' : η.app (op W) a = η.app (op W) 0 :=
    (constant_unit_restrict X U W i₁.le a).symm.trans
      (hW.trans (constant_unit_restrict X U W i₂.le 0))
  have hinj := constant_integer_unit_injective_of_nonempty X W x hxW
  exact ha (hinj hW')

/-- Every germ of the constant sheaf of integers at a point of `U` is the germ of a constant
section over `U`. -/
private theorem constant_unit_germ_surjective
    (U : Opens X) (x : X) (hx : x ∈ U)
    (z : (integerConstantSheaf X).presheaf.stalk x) :
    ∃ a : ULift.{u} ℤ,
      (integerConstantSheaf X).presheaf.germ U x hx
        ((CategoryTheory.toSheafify (Opens.grothendieckTopology X)
          (constantPresheafOnSpace X AddCommGrpCat.{u}
            (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U) a) = z := by
  let Z := integerConstantSheaf X
  let η := CategoryTheory.toSheafify (Opens.grothendieckTopology X)
    (constantPresheafOnSpace X AddCommGrpCat.{u}
      (AddCommGrpCat.of (ULift.{u} ℤ)))
  obtain ⟨W, hxW, s, hs⟩ := Z.presheaf.exists_germ_eq z
  let T : Opens X := W ⊓ U
  have hxT : x ∈ T := ⟨hxW, hx⟩
  let sT := Z.obj.map (op (homOfLE (inf_le_left : T ≤ W))) s
  obtain ⟨V, hVT, hxV, a, ha⟩ :=
    integer_constant_section_locally_constant X T sT x hxT
  have hVU : V ≤ U := hVT.trans inf_le_right
  refine ⟨a, ?_⟩
  rw [← hs]
  calc
    Z.presheaf.germ U x hx (η.app (op U) a) =
        Z.presheaf.germ V x hxV (η.app (op V) a) := by
      rw [← constant_unit_restrict X U V hVU a]
      exact (Z.presheaf.germ_res_apply (homOfLE hVU) x hxV _).symm
    _ = Z.presheaf.germ T x hxT sT := by
      rw [← ha]
      exact Z.presheaf.germ_res_apply (homOfLE hVT) x hxV sT
    _ = Z.presheaf.germ W x hxW s :=
      Z.presheaf.germ_res_apply (homOfLE (inf_le_left : T ≤ W)) x hxT s

/-- The morphism `coefficientExtensionHom X U a` sends the tautological section over `U` to the
constant section `a`. -/
private theorem coefficientExtensionHom_app_section (U : Opens X) (a : ULift.{u} ℤ) :
    (coefficientExtensionHom X U a).hom.app (op U)
        (sectionOfExtensionHomViaAdjunction X U (integerExtensionByZero X U) (𝟙 _)) =
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (constantPresheafOnSpace X AddCommGrpCat.{u}
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op U) a :=
  (sectionOfExtensionHom_eq_app X U _ _).symm.trans (sectionOf_coefficientExtensionHom X U a)

/-- For `a ≠ 0` and `x ∈ U`, the morphism `coefficientExtensionHom X U a` is injective on the
stalk at `x`. -/
private theorem coefficientExtensionHom_stalk_mono_of_ne_zero
    (U : Opens X) (a : ℤ) (ha : a ≠ 0)
    (x : X) (hx : x ∈ U) :
    Mono ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      (coefficientExtensionHom X U (ULift.up a))) := by
  let E := integerExtensionByZero X U
  let Z := integerConstantSheaf X
  let c := coefficientExtensionHom X U (ULift.up a)
  let σ := sectionOfExtensionHomViaAdjunction X U E (𝟙 E)
  let z : E.presheaf.stalk x := E.presheaf.germ U x hx σ
  have hmap : ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map c) z =
      Z.presheaf.germ U x hx (c.hom.app (op U) σ) :=
    TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx c.hom σ
  have hz : ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map c) z ≠ 0 := by
    rw [hmap, coefficientExtensionHom_app_section]
    exact constant_unit_germ_ne_zero X U x hx (ULift.up a) (by
      intro hzero
      exact ha (congrArg ULift.down hzero))
  exact mono_of_nonzero_between_integer_stalks
    (E.presheaf.stalk x) (Z.presheaf.stalk x)
    (integerExtensionStalkIso X U ⟨x, hx⟩)
    (constantStalkIso X (AddCommGrpCat.of (ULift.{u} ℤ)) x)
    ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map c) ⟨z, hz⟩

/-- For `x ∈ U`, the morphism `coefficientExtensionHom X U 1` is an isomorphism on the stalk
at `x`. -/
private theorem coefficientExtensionHom_one_stalk_iso
    (U : Opens X) (x : X) (hx : x ∈ U) :
    IsIso ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      (coefficientExtensionHom X U (ULift.up (1 : ℤ)))) := by
  let E := integerExtensionByZero X U
  let Z := integerConstantSheaf X
  let c := coefficientExtensionHom X U (ULift.up (1 : ℤ))
  let L := TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
    TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
  let σ := sectionOfExtensionHomViaAdjunction X U E (𝟙 E)
  have : Mono (L.map c) :=
    coefficientExtensionHom_stalk_mono_of_ne_zero X U 1 (by decide) x hx
  have : Epi (L.map c) := by
    apply (AddCommGrpCat.epi_iff_surjective (L.map c)).mpr
    intro z
    obtain ⟨a, ha⟩ := constant_unit_germ_surjective X U x hx z
    refine ⟨a.down • E.presheaf.germ U x hx σ, ?_⟩
    have hmap : (L.map c) (E.presheaf.germ U x hx σ) =
        Z.presheaf.germ U x hx (c.hom.app (op U) σ) :=
      TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx c.hom σ
    have hlinear : (L.map c) (a.down • E.presheaf.germ U x hx σ) =
        a.down • (L.map c) (E.presheaf.germ U x hx σ) :=
      (L.map c).hom.map_zsmul _ _
    rw [hlinear, hmap, coefficientExtensionHom_app_section]
    refine Eq.trans ?_ ha
    exact ((Z.presheaf.germ U x hx).hom.map_zsmul a.down _).symm.trans
      (congrArg (Z.presheaf.germ U x hx).hom (apply_eq_zsmul_one _ a).symm)
  exact isIso_of_mono_of_epi _

/-- The canonical morphism `j'_! ℤ_V ⟶ j_! ℤ_U` attached to an inclusion `V ≤ U` of opens. -/
private noncomputable def integerExtensionRestriction
    (U V : Opens X) (hVU : V ≤ U) :
    integerExtensionByZero X V ⟶ integerExtensionByZero X U :=
  let E := integerExtensionByZero X U
  let σ := sectionOfExtensionHomViaAdjunction X U E (𝟙 E)
  extensionHomOfSection X V E
    (Eq.mp (congrArg
      (fun T : Opens X => CategoryTheory.ToType (E.obj.obj (op T)))
      V.isOpenEmbedding_obj_top.symm)
      (E.obj.map (op (homOfLE hVU)) σ))

/-- The section attached to the canonical morphism `j'_! ℤ_V ⟶ j_! ℤ_U` is the restriction to `V`
of the tautological section over `U`. -/
private theorem sectionOf_integerExtensionRestriction
    (U V : Opens X) (hVU : V ≤ U) :
    sectionOfExtensionHomViaAdjunction X V (integerExtensionByZero X U)
      (integerExtensionRestriction X U V hVU) =
      (integerExtensionByZero X U).obj.map (op (homOfLE hVU))
        (sectionOfExtensionHomViaAdjunction X U (integerExtensionByZero X U)
          (𝟙 (integerExtensionByZero X U))) := by
  unfold sectionOfExtensionHomViaAdjunction integerExtensionRestriction
  rw [extensionSectionOnRestricted_extensionHomOfSection]
  exact cast_cast_symm X (integerExtensionByZero X U) V.isOpenEmbedding_obj_top _

/-- Precomposing with the canonical morphism `j'_! ℤ_V ⟶ j_! ℤ_U` restricts the attached section
from `U` to `V`. -/
private theorem integerExtensionRestriction_comp_section
    (U V : Opens X) (hVU : V ≤ U)
    (H : TopCat.Sheaf AddCommGrpCat.{u} X)
    (f : integerExtensionByZero X U ⟶ H) :
    sectionOfExtensionHomViaAdjunction X V H
      (integerExtensionRestriction X U V hVU ≫ f) =
      H.obj.map (op (homOfLE hVU))
        (sectionOfExtensionHomViaAdjunction X U H f) := by
  let E := integerExtensionByZero X U
  rw [sectionOfExtensionHomViaAdjunction_comp,
    sectionOf_integerExtensionRestriction]
  have hnat := NatTrans.naturality_apply f.hom (op (homOfLE hVU))
    (sectionOfExtensionHomViaAdjunction X U E (𝟙 E))
  rw [hnat]
  exact congrArg (fun s => H.obj.map (op (homOfLE hVU)) s)
    (sectionOfExtensionHom_eq_app X U H f).symm

/-- The canonical morphism `j'_! ℤ_V ⟶ j_! ℤ_U` is compatible with the constant-coefficient
morphisms to the constant sheaf of integers. -/
private theorem integerExtensionRestriction_comp_coefficient
    (U V : Opens X) (hVU : V ≤ U) (a : ULift.{u} ℤ) :
    integerExtensionRestriction X U V hVU ≫ coefficientExtensionHom X U a =
      coefficientExtensionHom X V a := by
  apply sectionOfExtensionHomViaAdjunction_injective X V (integerConstantSheaf X)
  rw [integerExtensionRestriction_comp_section,
    sectionOf_coefficientExtensionHom, sectionOf_coefficientExtensionHom]
  exact constant_unit_restrict X U V hVU a

/-- For `x ∈ V`, the canonical morphism `j'_! ℤ_V ⟶ j_! ℤ_U` is an isomorphism on the stalk
at `x`. -/
private theorem integerExtensionRestriction_stalk_iso
    (U V : Opens X) (hVU : V ≤ U) (x : X) (hxV : x ∈ V) :
    IsIso ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      (integerExtensionRestriction X U V hVU)) := by
  let L := TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
    TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
  let a := integerExtensionRestriction X U V hVU
  let cU := coefficientExtensionHom X U (ULift.up (1 : ℤ))
  let cV := coefficientExtensionHom X V (ULift.up (1 : ℤ))
  have : IsIso (L.map cU) := coefficientExtensionHom_one_stalk_iso X U x (hVU hxV)
  have : IsIso (L.map cV) := coefficientExtensionHom_one_stalk_iso X V x hxV
  have hcomp : L.map a ≫ L.map cU = L.map cV := by
    have h := congrArg (fun f => L.map f)
      (integerExtensionRestriction_comp_coefficient X U V hVU (ULift.up (1 : ℤ)))
    calc
      L.map a ≫ L.map cU = L.map (a ≫ cU) := (L.map_comp a cU).symm
      _ = L.map cV := h
  have : IsIso (L.map a ≫ L.map cU) := hcomp ▸ inferInstance
  exact IsIso.of_isIso_comp_right (L.map a) (L.map cU)

/-- An additive subgroup of `ℤ` containing `d` contains every multiple of `d`. -/
private lemma addSubgroup_mem_of_dvd (H : AddSubgroup ℤ)
    {d a : ℤ} (hd : d ∈ H) (hda : d ∣ a) : a ∈ H := by
  obtain ⟨c, rfl⟩ := hda
  have h := H.zsmul_mem hd c
  simpa [zsmul_eq_mul, mul_comm] using h

/-- A coefficient whose morphism to the constant sheaf of integers factors through `F` over `U` is
liftable over `U`. -/
private lemma liftable_of_coefficient_factor
    (F : Subobject (integerConstantSheaf X)) (U : Opens X) (d : ℤ)
    (q : integerExtensionByZero X U ⟶
      (F : TopCat.Sheaf AddCommGrpCat.{u} X))
    (hq : q ≫ F.arrow = coefficientExtensionHom X U (ULift.up d)) :
    d ∈ liftableIntegerCoefficients X F U := by
  refine ⟨sectionOfExtensionHomViaAdjunction X U
    (F : TopCat.Sheaf AddCommGrpCat.{u} X) q, ?_⟩
  have hcomp := sectionOfExtensionHomViaAdjunction_comp X U
    (F : TopCat.Sheaf AddCommGrpCat.{u} X)
    (integerConstantSheaf X) q F.arrow
  rw [← hcomp, hq, sectionOf_coefficientExtensionHom]
  rfl

/-- If locally on `U` some divisor of `a` is liftable, then `coefficientExtensionHom X U a` factors
through `F`. -/
private theorem coefficient_factor_of_local_divisibility
    (F : Subobject (integerConstantSheaf X)) (U : Opens X) (a : ℤ)
    (hlocal : ∀ x : U, ∃ W : Opens X, ∃ d : ℤ,
      (x : X) ∈ W ∧ d ∣ a ∧
        ∃ q : integerExtensionByZero X W ⟶
          (F : TopCat.Sheaf AddCommGrpCat.{u} X),
          q ≫ F.arrow = coefficientExtensionHom X W (ULift.up d)) :
    ∃ q : integerExtensionByZero X U ⟶
      (F : TopCat.Sheaf AddCommGrpCat.{u} X),
      q ≫ F.arrow = coefficientExtensionHom X U (ULift.up a) := by
  have ha : a ∈ liftableIntegerCoefficients X F U := by
    apply liftableIntegerCoefficients_of_locally X F U a
    intro x
    obtain ⟨W, d, hxW, hda, q, hq⟩ := hlocal x
    let V := U ⊓ W
    have hxV : (x : X) ∈ V := ⟨x.2, hxW⟩
    have hdW : d ∈ liftableIntegerCoefficients X F W :=
      liftable_of_coefficient_factor X F W d q hq
    have hdV : d ∈ liftableIntegerCoefficients X F V :=
      liftableIntegerCoefficients_mono X F (inf_le_right : V ≤ W) hdW
    exact ⟨V, inf_le_left, hxV,
      addSubgroup_mem_of_dvd (liftableIntegerCoefficients X F V) hdV hda⟩
  exact coefficientExtensionHom_factors X F U a ha

/-- The zero morphism `j_! ℤ_U ⟶ H` has zero attached section. -/
private lemma sectionOfExtensionHom_zero (U : Opens X)
    (H : TopCat.Sheaf AddCommGrpCat.{u} X) :
    sectionOfExtensionHomViaAdjunction X U H 0 = 0 := by
  exact (sectionOfExtensionHom_eq_app X U H 0).trans rfl

/-- The coefficient morphism of `0` is the zero morphism. -/
private lemma coefficientExtensionHom_zero (U : Opens X) :
    coefficientExtensionHom X U (ULift.up (0 : ℤ)) = 0 := by
  apply sectionOfExtensionHomViaAdjunction_injective X U (integerConstantSheaf X)
  rw [sectionOf_coefficientExtensionHom, sectionOfExtensionHom_zero]
  exact map_zero _

/-- If `coefficientExtensionHom X U a` factors through `A`, its image is contained in `A`. -/
private lemma coefficientImage_le_of_factor
    (A : Subobject (integerConstantSheaf X)) (U : Opens X) (a : ℤ)
    (h : ∃ q : integerExtensionByZero X U ⟶
      (A : TopCat.Sheaf AddCommGrpCat.{u} X),
      q ≫ A.arrow = coefficientExtensionHom X U (ULift.up a)) :
    imageSubobject (coefficientExtensionHom X U (ULift.up a)) ≤ A := by
  obtain ⟨q, hq⟩ := h
  exact imageSubobject_le _ q hq

/-- If the image of `coefficientExtensionHom X U a` is contained in `A`, the morphism factors
through `A`. -/
private lemma coefficient_factor_of_image_le
    (A : Subobject (integerConstantSheaf X)) (U : Opens X) (a : ℤ)
    (h : imageSubobject (coefficientExtensionHom X U (ULift.up a)) ≤ A) :
    ∃ q : integerExtensionByZero X U ⟶
      (A : TopCat.Sheaf AddCommGrpCat.{u} X),
      q ≫ A.arrow = coefficientExtensionHom X U (ULift.up a) := by
  refine ⟨factorThruImageSubobject _ ≫ Subobject.ofLE _ _ h, ?_⟩
  rw [Category.assoc, Subobject.ofLE_arrow, imageSubobject_arrow_comp]

/-- The image of a coefficient morphism grows with the open it is taken over. -/
private lemma coefficientImage_le_of_open_le
    (U V : Opens X) (hVU : V ≤ U) (a : ℤ) :
    imageSubobject (coefficientExtensionHom X V (ULift.up a)) ≤
      imageSubobject (coefficientExtensionHom X U (ULift.up a)) := by
  apply coefficientImage_le_of_factor
  refine ⟨integerExtensionRestriction X U V hVU ≫ factorThruImageSubobject _, ?_⟩
  rw [Category.assoc, imageSubobject_arrow_comp,
    integerExtensionRestriction_comp_coefficient]

/-- The image of the coefficient `a` over `V` is contained in the image of the coefficient `1`
over any larger open. -/
private lemma coefficientImage_le_support
    (U V : Opens X) (hVU : V ≤ U) (a : ℤ) :
    imageSubobject (coefficientExtensionHom X V (ULift.up a)) ≤
      imageSubobject (coefficientExtensionHom X U (ULift.up (1 : ℤ))) := by
  apply coefficientImage_le_of_factor
  apply coefficient_factor_of_local_divisibility
  intro x
  refine ⟨U, 1, hVU x.2, one_dvd a, ?_⟩
  exact ⟨factorThruImageSubobject _, imageSubobject_arrow_comp _⟩

/-- A subobject of the image of a coefficient morphism over `U` has vanishing stalks off `U`. -/
private lemma stalk_isZero_of_le_coefficientImage
    (A : Subobject (integerConstantSheaf X)) (U : Opens X) (a : ℤ)
    (hA : A ≤ imageSubobject (coefficientExtensionHom X U (ULift.up a)))
    (x : X) (hx : x ∉ U) :
    IsZero ((TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
      TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).obj
        (A : TopCat.Sheaf AddCommGrpCat.{u} X)) := by
  let L := TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
    TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x
  let q := coefficientExtensionHom X U (ULift.up a)
  have hE : IsZero (L.obj (integerExtensionByZero X U)) :=
    integerExtensionStalk_isZero X U x hx
  have hI : IsZero (L.obj (imageSubobject q : TopCat.Sheaf AddCommGrpCat.{u} X)) :=
    IsZero.of_epi_eq_zero (L.map (factorThruImageSubobject q)) (hE.eq_of_src _ _)
  exact IsZero.of_mono_eq_zero (L.map (Subobject.ofLE A (imageSubobject q) hA))
    (hI.eq_of_tgt _ _)

/-- A point lies in a finite supremum of opens exactly when it lies in one of them. -/
private lemma mem_finset_sup_iff {ι : Type*} (s : Finset ι)
    (U : ι → Opens X) (x : X) : x ∈ s.sup U ↔ ∃ i ∈ s, x ∈ U i := by
  classical
  simp only [Finset.sup_eq_iSup, Opens.mem_iSup]
  aesop

/-- Adjoining the nonzero coefficient `a` over `U` to a subobject `A` supported on `O` produces a
quotient presented by `0 ⟶ j'_! ℤ_{U ⊓ O} ⟶ j_! ℤ_U ⟶ (A ⊔ im) / A ⟶ 0`. -/
private theorem shortExact_coefficient_sup
    (A B : Subobject (integerConstantSheaf X)) (hAB : A ≤ B)
    (U O : Opens X) (a : ℤ) (ha : a ≠ 0)
    (hB : B = A ⊔ imageSubobject (coefficientExtensionHom X U (ULift.up a)))
    (hA : A ≤ imageSubobject (coefficientExtensionHom X O (ULift.up (1 : ℤ))))
    (hfac : ∃ r : integerExtensionByZero X (U ⊓ O) ⟶
      (A : TopCat.Sheaf AddCommGrpCat.{u} X),
      r ≫ A.arrow = coefficientExtensionHom X (U ⊓ O) (ULift.up a)) :
    ∃ (f : integerExtensionByZero X (U ⊓ O) ⟶ integerExtensionByZero X U)
      (g : integerExtensionByZero X U ⟶ cokernel (Subobject.ofLE A B hAB)),
      ∃ hfg : f ≫ g = 0, (ShortComplex.mk f g hfg).ShortExact := by
  rw [← adjoinImage_eq_sup] at hB
  subst B
  let f := integerExtensionRestriction X U (U ⊓ O) inf_le_left
  refine ⟨f, adjoinImageFactor X (integerConstantSheaf X) A
    (coefficientExtensionHom X U (ULift.up a)) ≫ cokernel.π _, ?_⟩
  apply shortExact_adjoinImage X (integerConstantSheaf X) A U (U ⊓ O) inf_le_left
  · intro x hx
    exact integerExtensionRestriction_stalk_iso X U (U ⊓ O) inf_le_left x hx
  · intro x hxU hxV
    refine ⟨stalk_isZero_of_le_coefficientImage X A O 1 hA x
      (fun hxO => hxV ⟨hxU, hxO⟩), ?_⟩
    exact coefficientExtensionHom_stalk_mono_of_ne_zero X U a ha x hxU
  · obtain ⟨r, hr⟩ := hfac
    exact ⟨r, (integerExtensionRestriction_comp_coefficient X U (U ⊓ O)
      inf_le_left (ULift.up a)).trans hr.symm⟩

/-- The filtration of a subsheaf generated by a finite family of constant coefficients over
quasi-compact opens, closed under gcd, by the subsheaves generated by the coefficients of size at
most `r`, together with the short exact presentations of its successive quotients. -/
private theorem coefficient_family_filtration [QuasiSeparatedSpace X]
    {ι : Type*} [Fintype ι] (W : ι → Opens X) (m : ι → ℕ)
    (hW : ∀ k, IsCompact (W k : Set X))
    (hgcd : ∀ i j x, 0 < m i → x ∈ W i → x ∈ W j →
      ∃ k, x ∈ W k ∧ 0 < m k ∧ m k ≤ m i ∧ m k ∣ m j)
    (F : Subobject (integerConstantSheaf X))
    (hF : Finset.univ.sup (fun k =>
      imageSubobject (coefficientExtensionHom X (W k) (ULift.up (m k : ℤ)))) = F) :
    ∃ (n : ℕ) (G : Fin (n + 1) → Subobject (integerConstantSheaf X))
      (hG : Monotone G),
      G 0 = ⊥ ∧ G (Fin.last n) = F ∧
        ∀ i : Fin n,
          ∃ (U V : Opens X),
            V ≤ U ∧ IsCompact (U : Set X) ∧ IsCompact (V : Set X) ∧
              ∃ (a : integerExtensionByZero X V ⟶ integerExtensionByZero X U)
                (b : integerExtensionByZero X U ⟶
                  cokernel (Subobject.ofLE (G i.castSucc) (G i.succ)
                    (hG i.castSucc_le_succ))),
                ∃ hab : a ≫ b = 0, (ShortComplex.mk a b hab).ShortExact := by
  classical
  let C : ι → Subobject (integerConstantSheaf X) := fun k =>
    imageSubobject (coefficientExtensionHom X (W k) (ULift.up (m k : ℤ)))
  let B : ℕ → Subobject (integerConstantSheaf X) := fun r =>
    Finset.univ.sup fun k => if 0 < m k ∧ m k ≤ r then C k else ⊥
  have hBmono : Monotone B := by
    intro r s hrs
    apply Finset.sup_mono_fun
    intro k hk
    split_ifs with hkr hks hks
    · exact le_rfl
    · exact False.elim (hks ⟨hkr.1, hkr.2.trans hrs⟩)
    · exact bot_le
    · exact le_rfl
  have hCB (k : ι) (r : ℕ) (hpos : 0 < m k) (hle : m k ≤ r) : C k ≤ B r := by
    calc
      C k = (if 0 < m k ∧ m k ≤ r then C k else ⊥) := by rw [ite_eq_left ⟨hpos, hle⟩]
      _ ≤ B r := Finset.le_sup (f := fun k =>
        if 0 < m k ∧ m k ≤ r then C k else ⊥) (Finset.mem_univ k)
  let M := Finset.univ.sup m
  let G : Fin (M + 1) → Subobject (integerConstantSheaf X) := fun i => B i.val
  have hG : Monotone G := fun i j hij => hBmono hij
  refine ⟨M, G, hG, ?_, ?_, ?_⟩
  · show B 0 = ⊥
    apply le_antisymm _ bot_le
    apply Finset.sup_le
    intro k hk
    split_ifs with h
    · omega
    · exact le_rfl
  · show B M = F
    rw [← hF]
    apply Finset.sup_congr rfl
    intro k hk
    have hle : m k ≤ M := Finset.le_sup (Finset.mem_univ k)
    by_cases hpos : 0 < m k
    · simp only [hpos, hle, and_self, ite_true]
      rfl
    · have hz : m k = 0 := Nat.eq_zero_of_not_pos hpos
      simp [hz, C, coefficientExtensionHom_zero]
  · intro i
    let r := i.val
    let T : Finset ι := Finset.univ.filter fun k => m k = r + 1
    let P : Finset ι := Finset.univ.filter fun k => 0 < m k ∧ m k ≤ r
    let U : Opens X := T.sup W
    let O : Opens X := P.sup W
    have hU : IsCompact (U : Set X) :=
      compact_open_finset_union X T W (fun k _ => hW k)
    have hO : IsCompact (O : Set X) :=
      compact_open_finset_union X P W (fun k _ => hW k)
    have hTU (k : ι) (hk : m k = r + 1) : W k ≤ U :=
      Finset.le_sup (Finset.mem_filter.mpr ⟨Finset.mem_univ k, hk⟩)
    have hPO (k : ι) (hk : 0 < m k ∧ m k ≤ r) : W k ≤ O :=
      Finset.le_sup (Finset.mem_filter.mpr ⟨Finset.mem_univ k, hk⟩)
    let q := coefficientExtensionHom X U (ULift.up ((r + 1 : ℕ) : ℤ))
    have hqB : imageSubobject q ≤ B (r + 1) := by
      apply coefficientImage_le_of_factor
      apply coefficient_factor_of_local_divisibility
      intro x
      obtain ⟨k, hk, hxk⟩ := (mem_finset_sup_iff X T W x).mp x.2
      have hmk : m k = r + 1 := (Finset.mem_filter.mp hk).2
      refine ⟨W k, (m k : ℤ), hxk, ?_,
        coefficient_factor_of_image_le X (B (r + 1)) (W k) (m k)
          (hCB k (r + 1) (by omega) (by omega))⟩
      rw [hmk]
    have hstep : B (r + 1) = B r ⊔ imageSubobject q := by
      apply le_antisymm
      · apply Finset.sup_le
        intro k hk
        split_ifs with hkr
        · by_cases hle : m k ≤ r
          · exact (hCB k r hkr.1 hle).trans le_sup_left
          · have heq : m k = r + 1 := by omega
            have hc : C k ≤ imageSubobject q := by
              have h := coefficientImage_le_of_open_le X U (W k) (hTU k heq) (m k)
              simpa only [C, q, heq] using h
            exact hc.trans le_sup_right
        · exact bot_le
      · exact sup_le (hBmono (Nat.le_succ r)) hqB
    have hsupport : B r ≤ imageSubobject
        (coefficientExtensionHom X O (ULift.up (1 : ℤ))) := by
      apply Finset.sup_le
      intro k hk
      split_ifs with hkr
      · exact coefficientImage_le_support X O (W k) (hPO k hkr) (m k)
      · exact bot_le
    have hfac : ∃ f : integerExtensionByZero X (U ⊓ O) ⟶
        (B r : TopCat.Sheaf AddCommGrpCat.{u} X),
        f ≫ (B r).arrow =
          coefficientExtensionHom X (U ⊓ O) (ULift.up ((r + 1 : ℕ) : ℤ)) := by
      apply coefficient_factor_of_local_divisibility
      intro x
      obtain ⟨j, hj, hxj⟩ := (mem_finset_sup_iff X T W x).mp x.2.1
      obtain ⟨k, hk, hxk⟩ := (mem_finset_sup_iff X P W x).mp x.2.2
      have hmj : m j = r + 1 := (Finset.mem_filter.mp hj).2
      have hmk : 0 < m k ∧ m k ≤ r := (Finset.mem_filter.mp hk).2
      obtain ⟨l, hxl, hlpos, hlk, hlj⟩ := hgcd k j x hmk.1 hxk hxj
      refine ⟨W l, (m l : ℤ), hxl, ?_,
        coefficient_factor_of_image_le X (B r) (W l) (m l)
          (hCB l r hlpos (hlk.trans hmk.2))⟩
      exact_mod_cast (hmj ▸ hlj)
    refine ⟨U, U ⊓ O, inf_le_left, hU, compact_open_inter X U O hU hO, ?_⟩
    exact shortExact_coefficient_sup X (B r) (B (r + 1))
      (hG i.castSucc_le_succ) U O ((r + 1 : ℕ) : ℤ)
      (by omega) hstep hsupport hfac

/-- A subsheaf of the constant sheaf of integers generated by finitely many sections over
quasi-compact opens, on a space whose quasi-compact opens are closed under intersection, has a
finite filtration `0 = F₀ ⊆ ⋯ ⊆ F_n = F` by abelian subsheaves whose successive quotients fit into
short exact sequences `0 ⟶ j'_! ℤ_V ⟶ j_! ℤ_U ⟶ F_i / F_{i - 1} ⟶ 0` with `V ⊆ U` quasi-compact
opens. -/
@[stacks 0A38]
theorem exists_filtration_of_finitelyGeneratedByCompactOpenSections [QuasiSeparatedSpace X]
    (F : Subobject (integerConstantSheaf X))
    (hF : FinitelyGeneratedByCompactOpenSections X F) :
    ∃ (n : ℕ) (G : Fin (n + 1) → Subobject (integerConstantSheaf X))
      (hG : Monotone G),
      G 0 = ⊥ ∧ G (Fin.last n) = F ∧
        ∀ i : Fin n,
          ∃ (U V : Opens X),
            V ≤ U ∧ IsCompact (U : Set X) ∧ IsCompact (V : Set X) ∧
              ∃ (a : integerExtensionByZero X V ⟶ integerExtensionByZero X U)
                (b : integerExtensionByZero X U ⟶
                  cokernel (Subobject.ofLE (G i.castSucc) (G i.succ)
                    (hG i.castSucc_le_succ))),
                ∃ hab : a ≫ b = 0, (ShortComplex.mk a b hab).ShortExact := by
  classical
  rcases hF with ⟨n, U, hU, s, hs⟩
  let f : ∀ i : Fin n, integerExtensionByZero X (U i) ⟶ integerConstantSheaf X :=
    fun i => s i ≫ F.arrow
  have hgen : ∀ i : Fin n,
      sectionOfExtensionHomViaAdjunction X (U i) (integerConstantSheaf X) (f i) =
        F.arrow.hom.app (op (U i))
          (sectionOfExtensionHomViaAdjunction X (U i) (F : TopCat.Sheaf AddCommGrpCat.{u} X)
            (s i)) := by
    intro i
    exact sectionOfExtensionHomViaAdjunction_comp X (U i) F
      (integerConstantSheaf X) (s i) F.arrow
  choose t hcover hcompact using
    (fun i => finite_compact_value_loci_viaAdjunction X (U i) (hU i) (f i))
  let J := Σ i : Fin n, {a : ULift.{u} ℤ // a ∈ t i}
  let _instJ : Fintype J := inferInstance
  let W : J → Opens X := fun j => integerSectionLocus X (U j.1)
    (sectionOfExtensionHomViaAdjunction X (U j.1) (integerConstantSheaf X) (f j.1)) j.2.1
  have hW : ∀ j : J, IsCompact (W j : Set X) := by
    rintro ⟨i, ⟨a, ha⟩⟩
    exact hcompact i a ha
  have hconst : ∀ j : J,
      (integerConstantSheaf X).obj.map
        (op (homOfLE (integerSectionLocus_le X (U j.1)
          (sectionOfExtensionHomViaAdjunction X (U j.1) (integerConstantSheaf X)
            (f j.1)) j.2.1)))
        (sectionOfExtensionHomViaAdjunction X (U j.1) (integerConstantSheaf X)
          (f j.1)) =
        (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
          (constantPresheafOnSpace X AddCommGrpCat.{u}
            (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op (W j)) j.2.1 := by
    rintro ⟨i, ⟨a, ha⟩⟩
    exact integerSectionLocus_restrict_eq_constant X (U i)
      (sectionOfExtensionHomViaAdjunction X (U i) (integerConstantSheaf X) (f i)) a
  have hLift : ∀ j : J,
      ∃ b : (F : TopCat.Sheaf AddCommGrpCat.{u} X).obj.obj (op (W j)),
        F.arrow.hom.app (op (W j)) b =
          (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
            (constantPresheafOnSpace X AddCommGrpCat.{u}
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app (op (W j)) j.2.1 := by
    rintro ⟨i, ⟨a, ha⟩⟩
    let σ := sectionOfExtensionHomViaAdjunction X (U i)
      (F : TopCat.Sheaf AddCommGrpCat.{u} X) (s i)
    let hWU := integerSectionLocus_le X (U i)
      (sectionOfExtensionHomViaAdjunction X (U i) (integerConstantSheaf X) (f i)) a
    refine ⟨(F : TopCat.Sheaf AddCommGrpCat.{u} X).obj.map
      (op (homOfLE hWU)) σ, ?_⟩
    have hnat := NatTrans.naturality_apply F.arrow.hom (op (homOfLE hWU)) σ
    change F.arrow.hom.app (op (W ⟨i, ⟨a, ha⟩⟩))
        ((F : TopCat.Sheaf AddCommGrpCat.{u} X).obj.map (op (homOfLE hWU)) σ) =
      (integerConstantSheaf X).obj.map (op (homOfLE hWU))
        (F.arrow.hom.app (op (U i)) σ) at hnat
    rw [hnat, ← hgen i]
    exact hconst ⟨i, ⟨a, ha⟩⟩
  let m : J → ℕ := fun j => j.2.1.down.natAbs
  let K := {s : Finset J // s.Nonempty}
  let _instK : Fintype K := inferInstance
  let W' : K → Opens X := fun k => k.1.inf W
  have hW' : ∀ k : K, IsCompact (W' k : Set X) := by
    intro k
    exact compact_open_finset_inter X k.1 k.2 W (fun j _ => hW j)
  let m' : K → ℕ := fun k => k.1.gcd m
  have hK (k : K) : ((m' k : ℕ) : ℤ) ∈
      liftableIntegerCoefficients X F (W' k) := by
    apply finset_gcd_natAbs_mem_addSubgroup k.1
      (fun j : J => j.2.1.down) (liftableIntegerCoefficients X F (W' k))
    intro j hj
    apply liftableIntegerCoefficients_mono X F (Finset.inf_le hj)
    obtain ⟨b, hb⟩ := hLift j
    exact ⟨b, hb⟩
  let q : ∀ k : K, integerExtensionByZero X (W' k) ⟶
      (F : TopCat.Sheaf AddCommGrpCat.{u} X) := fun k =>
    (coefficientExtensionHom_factors X F (W' k) (m' k) (hK k)).choose
  have hq (k : K) : q k ≫ F.arrow =
      coefficientExtensionHom X (W' k) (ULift.up (m' k : ℤ)) :=
    (coefficientExtensionHom_factors X F (W' k) (m' k) (hK k)).choose_spec
  have hq_le (k : K) : imageSubobject (q k ≫ F.arrow) ≤ F := by
    exact imageSubobject_le (q k ≫ F.arrow) (q k) rfl
  let A : Subobject (integerConstantSheaf X) := Finset.univ.sup fun k : K =>
    imageSubobject (coefficientExtensionHom X (W' k) (ULift.up (m' k : ℤ)))
  have hCA (k : K) :
      imageSubobject (coefficientExtensionHom X (W' k) (ULift.up (m' k : ℤ))) ≤ A :=
    Finset.le_sup (f := fun k : K =>
      imageSubobject (coefficientExtensionHom X (W' k) (ULift.up (m' k : ℤ))))
      (Finset.mem_univ k)
  have hAF : A = F := by
    apply le_antisymm
    · apply Finset.sup_le
      intro k hk
      rw [← hq k]
      exact hq_le k
    · rw [← hs]
      apply Finset.sup_le
      intro i hi
      obtain ⟨g, hg⟩ : ∃ g : integerExtensionByZero X (U i) ⟶
          (A : TopCat.Sheaf AddCommGrpCat.{u} X), g ≫ A.arrow = f i := by
        obtain ⟨sA, hsA⟩ := subobject_section_lift_of_local X
          (integerConstantSheaf X) A (U i)
          (sectionOfExtensionHomViaAdjunction X (U i) (integerConstantSheaf X) (f i)) (by
            intro x
            have hx : (x : X) ∈ (t i).sup (integerSectionLocus X (U i)
                (sectionOfExtensionHomViaAdjunction X (U i) (integerConstantSheaf X) (f i))) :=
              (hcover i) ▸ x.2
            obtain ⟨a, ha, hxa⟩ := (mem_finset_sup_iff X (t i) _ x).mp hx
            let j : J := ⟨i, a, ha⟩
            let k : K := ⟨{j}, Finset.singleton_nonempty j⟩
            have hmk : m' k = a.down.natAbs := by simp [m', k, m, j]
            have hWk : W' k = W j := by simp [W', k]
            have hcoef : (a.down.natAbs : ℤ) ∈ liftableIntegerCoefficients X A (W j) := by
              have h := coefficient_factor_of_image_le X A (W' k) (m' k) (hCA k)
              rw [hmk, hWk] at h
              obtain ⟨v, hv⟩ := h
              exact liftable_of_coefficient_factor X A (W j) _ v hv
            obtain ⟨v, hv⟩ := addSubgroup_mem_of_dvd
              (liftableIntegerCoefficients X A (W j))
              hcoef (Int.natAbs_dvd_self (a := a.down))
            refine ⟨W j, integerSectionLocus_le X (U i)
              (sectionOfExtensionHomViaAdjunction X (U i) (integerConstantSheaf X) (f i)) a,
              hxa, v, ?_⟩
            exact hv.trans (hconst j).symm)
        exact extensionHom_factors_of_section_lift X (integerConstantSheaf X) A
          (U i) (f i) sA hsA
      exact imageSubobject_le _ g hg
  have hpair : ∀ i j x, 0 < m' i → x ∈ W' i → x ∈ W' j →
      ∃ k, x ∈ W' k ∧ 0 < m' k ∧ m' k ≤ m' i ∧ m' k ∣ m' j := by
    intro i j x hmi hxi hxj
    let k : K := ⟨i.1 ∪ j.1, i.2.mono Finset.subset_union_left⟩
    have hmk : m' k = (m' i).gcd (m' j) := by
      exact Finset.gcd_union
    refine ⟨k, ?_, ?_, ?_, ?_⟩
    · apply mem_finset_inf X
      intro l hl
      rcases Finset.mem_union.mp hl with hl | hl
      · exact (Finset.inf_le hl : W' i ≤ W l) hxi
      · exact (Finset.inf_le hl : W' j ≤ W l) hxj
    · rw [hmk]
      exact Nat.gcd_pos_of_pos_left _ hmi
    · rw [hmk]
      exact Nat.le_of_dvd hmi (Nat.gcd_dvd_left _ _)
    · rw [hmk]
      exact Nat.gcd_dvd_right _ _
  exact coefficient_family_filtration X W' m' hW' hpair F hAF

end Stacks.Sheaves.ConstantIntegerSubsheaves
