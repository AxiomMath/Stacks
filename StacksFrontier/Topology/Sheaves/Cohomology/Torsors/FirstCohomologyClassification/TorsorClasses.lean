/-!
# Torsors under an abelian sheaf and their classes

For an abelian sheaf `H` on a topological space `X`, this file defines `H`-torsors, their
isomorphism classes and first sheaf cohomology, together with the bridge to the categorical
torsors of `Stacks.Cohomology.Torsors` and the structure bundling the classification of torsors
by first cohomology with its characterizing laws.

## Main definitions

* `Stacks.Cohomology.SheafTorsor.Torsor` packages a sheaf of sets, an action of an abelian sheaf,
  and the torsor condition.
* `Stacks.Cohomology.SheafTorsor.TorsorClass` is the type of isomorphism classes of torsors.
* `Stacks.Cohomology.SheafTorsor.sheafCohomologyOne` is first derived-functor sheaf cohomology.
* `Stacks.Cohomology.SheafTorsor.TorsorCohomologyClassification` bundles a bijection between
  torsor classes and first cohomology with its Čech, trivial-torsor and pairing laws.

## Main results

* `Stacks.Cohomology.SheafTorsor.TorsorCohomologyClassification.of_cocycle` extends the
  point-indexed Čech law of a classification to covers indexed by an arbitrary type.

## Implementation notes

The additive groups of sections of `H` are passed through `Multiplicative` in
order to use the multiplicative torsor interface of Tag 02FO.  Isomorphism
classes are quotiented by the equivalence relation generated by equivariant
isomorphisms.  Cohomology is represented by the first right-derived functor of
global sections.

A pairing of torsors is natural and equivariant in each variable; it
identifies its target with their contracted product. This formulation also
applies directly to tensor products of generator torsors. The construction is
specified on point-indexed covers, keeping the bijection independent of any
cover-index universe. Its Čech characterization for arbitrary index types is
proved by selecting a covering member at each point and reindexing the
injective-resolution representative of Tag 01EQ.

## References

* [Stacks Project, Tag 02FQ](https://stacks.math.columbia.edu/tag/02FQ)
-/

@[expose] public noncomputable section

open CategoryTheory Limits Opposite TopologicalSpace

universe u v w
universe z

namespace Stacks.Cohomology.SheafTorsor

/-- The multiplicative presheaf of groups underlying an abelian sheaf.

Reducible on purpose: its sections are literally `Multiplicative (H.presheaf.obj (op U))`, and
keeping that visible is what lets `rw` and `simp` act on a goal mentioning
`Multiplicative.ofAdd` of a section of `H`. -/
abbrev underlyingPresheafOfGroups (X : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{v} X) :
    Stacks.SpaceTorsor.PresheafOfGroups.{u, v} X where
  obj U := Multiplicative (H.presheaf.obj (op U))
  group U := inferInstance
  res {U V} h := (H.presheaf.map (homOfLE h).op).hom.toMultiplicative
  res_self U g := by simp
  res_comp hWV hVU g := by
    change H.presheaf.map (homOfLE hWV).op
        (H.presheaf.map (homOfLE hVU).op g.toAdd) =
      H.presheaf.map (homOfLE (hWV.trans hVU)).op g.toAdd
    rw [← ConcreteCategory.comp_apply, ← H.presheaf.map_comp]
    rfl

/-- A torsor under an abelian sheaf `H`: a sheaf of sets equipped with an
`H`-action satisfying the torsor condition of Tag 02FO. -/
structure Torsor (X : TopCat.{u}) (H : TopCat.Sheaf AddCommGrpCat.{v} X) where
  /-- The underlying sheaf of sets. -/
  F : Stacks.SpaceTorsor.SheafOfSets.{u, v} X
  /-- The action of `H` on the underlying sheaf. -/
  action : Stacks.SpaceTorsor.Action (underlyingPresheafOfGroups X H) F.toPresheafOfSets
  /-- The action is a torsor action. -/
  isTorsor : action.IsTorsor

/-- The equivalence relation on torsors generated by equivariant
isomorphisms. -/
def torsorSetoid (X : TopCat.{u}) (H : TopCat.Sheaf AddCommGrpCat.{v} X) :
    Setoid (Torsor X H) :=
  Relation.EqvGen.setoid
    (fun F G : Torsor X H => F.action.Iso G.action)

/-- Isomorphism classes of torsors under `H`. -/
abbrev TorsorClass (X : TopCat.{u}) (H : TopCat.Sheaf AddCommGrpCat.{v} X) :=
  Quotient (torsorSetoid X H)

/-- The action of a sum, written through `Multiplicative`.  The multiplication on
`underlyingPresheafOfGroups X H` is the addition of `H`, but the identification is behind a
structure projection, so it is recorded here once and used instead of rewriting with
`Action.mul_act`. -/
theorem act_ofAdd_add {X : TopCat.{u}} {H : TopCat.Sheaf AddCommGrpCat.{v} X}
    (F : Torsor X H) {U : Opens X} (g h : H.presheaf.obj (op U)) (s : F.F.obj U) :
    F.action.act (Multiplicative.ofAdd (g + h)) s =
      F.action.act (Multiplicative.ofAdd g) (F.action.act (Multiplicative.ofAdd h) s) :=
  F.action.mul_act (Multiplicative.ofAdd g) (Multiplicative.ofAdd h) s

/-- Restriction of an action, written through `Multiplicative`.  Recorded once for the same
reason as `act_ofAdd_add`: the identification of the two group laws sits behind a structure
projection. -/
theorem res_act_ofAdd {X : TopCat.{u}} {H : TopCat.Sheaf AddCommGrpCat.{v} X}
    (F : Torsor X H) {U V : Opens X} (hVU : V ≤ U) (g : H.presheaf.obj (op U))
    (s : F.F.obj U) :
    F.F.res hVU (F.action.act (Multiplicative.ofAdd g) s) =
      F.action.act (Multiplicative.ofAdd (H.presheaf.map (homOfLE hVU).op g))
        (F.F.res hVU s) :=
  F.action.res_act hVU (Multiplicative.ofAdd g) s

/-- Evaluation of an abelian sheaf on an open subset is additive. -/
instance sheafSections_additive (X : TopCat.{u}) (U : Opens X) :
    ((sheafSections (Opens.grothendieckTopology X) AddCommGrpCat.{v}).obj
      (op U)).Additive := by
  change (sheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{v} ⋙
    (evaluation (Opens X)ᵒᵖ AddCommGrpCat.{v}).obj (op U)).Additive
  infer_instance

/-- First sheaf cohomology, represented as the first right-derived functor of
global sections. -/
def sheafCohomologyOne (X : TopCat.{u})
    [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{max u v}]
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) : AddCommGrpCat.{max u v} := by
  letI : EnoughInjectives
      (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{max u v}) :=
    Stacks.Injectives.abelianSheaf_enoughInjectives X
  exact ((sheafSections (Opens.grothendieckTopology X) AddCommGrpCat.{max u v}).obj
    (op (⊤ : Opens X))).rightDerived 1 |>.obj H

private noncomputable def uliftZHomIso :
    preadditiveCoyoneda.obj (op (AddCommGrpCat.of (ULift.{w} ℤ))) ≅
      𝟭 AddCommGrpCat.{w} := by
  refine NatIso.ofComponents
    (fun G => (AddCommGrpCat.uliftZMultiplesAddEquiv.{w} G).toAddCommGrpIso) ?_
  intro G G' f
  ext g
  rfl

/-- A natural pairing, equivariant in each argument. For torsors, such a
pairing identifies `K` with the contracted product of `F` and `G`. -/
structure TorsorPairing {X : TopCat.{u}} {H : TopCat.Sheaf AddCommGrpCat.{v} X}
    (F G K : Torsor X H) where
  /-- The pairing on sections. -/
  app (U : Opens X) : F.F.obj U → G.F.obj U → K.F.obj U
  /-- The pairing commutes with restriction. -/
  naturality {U V : Opens X} (h : V ≤ U) (s : F.F.obj U) (t : G.F.obj U) :
    app V (F.F.res h s) (G.F.res h t) = K.F.res h (app U s t)
  /-- Equivariance in the first variable. -/
  map_act_left (U : Opens X) (h : (underlyingPresheafOfGroups X H).obj U)
      (s : F.F.obj U) (t : G.F.obj U) :
    app U (F.action.act h s) t = K.action.act h (app U s t)
  /-- Equivariance in the second variable. -/
  map_act_right (U : Opens X) (h : (underlyingPresheafOfGroups X H).obj U)
      (s : F.F.obj U) (t : G.F.obj U) :
    app U s (G.action.act h t) = K.action.act h (app U s t)

/-- The transition equation for a torsor's local sections: on an overlap,
the cocycle acts on the first section to give the second section. -/
def IsTransitionCocycle {X : TopCat.{u}} {H : TopCat.Sheaf AddCommGrpCat.{v} X}
    (F : Torsor X H) {I : Type w} (Ui : I → Opens X)
    (s : ∀ i, F.F.obj (Ui i)) (z : CechCochains.cocycles1 Ui H.presheaf) : Prop :=
  ∀ i : Fin 2 → I,
    F.action.act (Multiplicative.ofAdd (z.val i))
        (F.F.res (iInf_le (fun k ↦ Ui (i k)) 0) (s (i 0))) =
      F.F.res (iInf_le (fun k ↦ Ui (i k)) 1) (s (i 1))

/-! ### Bridge to categorical torsors

`Stacks.Cohomology.Torsors` formulates torsors as categorical sheaves on the site of opens. The
definitions above use the concrete unique-gluing presentation from Tag 02FO.
The following private maps make that change of presentation explicit.
-/

private def toCatPresheaf (X : TopCat.{u}) (F : Stacks.SpaceTorsor.SheafOfSets.{u, z} X) :
    (Opens X)ᵒᵖ ⥤ Type (max u z) where
  obj U := ULift.{max u z, z} (F.obj U.unop)
  map f := ↾(fun s => ⟨F.res f.unop.le s.down⟩)
  map_id := by
    intro U
    apply ConcreteCategory.hom_ext
    intro s
    cases s
    simp [F.res_self]
  map_comp := by
    intro U V W f g
    apply ConcreteCategory.hom_ext
    intro s
    cases s
    simp [F.res_comp]

private theorem toCatPresheaf_isSheaf (X : TopCat.{u}) (F : Stacks.SpaceTorsor.SheafOfSets.{u, z} X)
  :
    Presheaf.IsSheaf (Opens.grothendieckTopology X) (toCatPresheaf X F) := by
  apply (TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing (toCatPresheaf X F)).2
  intro ι U sf hsf
  let hU : ∀ i, U i ≤ ⨆ j, U j := fun i => le_iSup U i
  let cf : F.CompatibleFamily U := ⟨fun i => (sf i).down, by
    intro i j W hWi hWj
    show F.res hWi ((sf i).down) = F.res hWj ((sf j).down)
    have hij : F.res (inf_le_left : U i ⊓ U j ≤ U i) (sf i).down =
        F.res (inf_le_right : U i ⊓ U j ≤ U j) (sf j).down := by
      have hsfij := hsf i j
      change ULift.up (F.res (inf_le_left : U i ⊓ U j ≤ U i) (sf i).down) =
        ULift.up (F.res (inf_le_right : U i ⊓ U j ≤ U j) (sf j).down) at hsfij
      exact congrArg ULift.down hsfij
    rw [← F.res_comp (le_inf hWi hWj) inf_le_left,
      ← F.res_comp (le_inf hWi hWj) inf_le_right]
    exact congrArg (F.res (le_inf hWi hWj)) hij⟩
  have hbij := F.isSheaf (⨆ j, U j) ι U hU rfl
  obtain ⟨s, hs⟩ := hbij.2 cf
  have hglue : ∀ i, F.res (le_iSup U i) s = (sf i).down := by
    have h := congrArg Subtype.val hs
    intro i
    exact congrFun h i
  refine ⟨⟨s⟩, ?_, ?_⟩
  · intro i
    show ULift.up (F.res (le_iSup U i) s) = sf i
    exact congrArg ULift.up (hglue i)
  · intro t ht
    apply ULift.ext
    apply hbij.1
    apply Subtype.ext
    funext i
    show F.res (le_iSup U i) t.down = F.res (le_iSup U i) s
    have hti := ht i
    change ULift.up (F.res (le_iSup U i) t.down) = sf i at hti
    have hti' : F.res (le_iSup U i) t.down = (sf i).down := by
      simpa only [ULift.down_up] using congrArg ULift.down hti
    exact hti'.trans (hglue i).symm

private noncomputable def toCategoricalTorsor (X : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) (F : Torsor X H) :
    Stacks.Cohomology.Torsors.AbelianTorsor H := by
  let Q : PseudoTorsor (Stacks.Cohomology.Torsors.abelianSheafAsGroupSheaf H) := {
    presheaf := toCatPresheaf X F.F
    isSheaf := toCatPresheaf_isSheaf X F.F
    act := fun U g s => ULift.up (F.action.act g s.down)
    one_act := by
      intro U s
      apply ULift.ext
      exact F.action.one_act s.down
    mul_act := by
      intro U g h s
      apply ULift.ext
      exact F.action.mul_act g h s.down
    naturality := by
      intro U V f g s
      apply ULift.ext
      change F.F.res f.unop.le (F.action.act g s.down) =
        F.action.act ((underlyingPresheafOfGroups X H).res f.unop.le g)
          (F.F.res f.unop.le s.down)
      exact F.action.res_act f.unop.le g s.down
    simplyTransitive := by
      intro U h s t
      cases s with
      | up s =>
        cases t with
        | up t =>
          have h' : Nonempty (F.F.obj U.unop) := h.map ULift.down
          obtain ⟨g₀, hg₀, huniq⟩ := (F.isTorsor.1 U.unop h').2 s t
          refine ⟨g₀, ?_, ?_⟩
          · exact congrArg ULift.up hg₀
          · intro g hg
            apply huniq g
            exact congrArg ULift.down hg
  }
  refine ⟨Q, ?_⟩
  intro U
  let S : Sieve U := {
    arrows := fun {V} _ => Nonempty (F.F.obj V)
    downward_closed := by
      intro V W f hf g
      exact hf.map (F.F.res g.le)
  }
  refine ⟨S, ?_, ?_⟩
  · rw [Opens.mem_grothendieckTopology]
    intro x hx
    obtain ⟨W, hxW, hs⟩ := F.isTorsor.2 x
    let V : Opens X := W ⊓ U
    let f : V ⟶ U := homOfLE inf_le_right
    refine ⟨V, f, ?_, ?_⟩
    · exact ⟨F.F.res inf_le_left hs.some⟩
    · change x ∈ W ∧ x ∈ U
      exact ⟨hxW, hx⟩
  · intro V f hf
    exact hf.map ULift.up

private def toCategoricalTorsorHom {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) (F G : Torsor X H)
  (φ : Stacks.SpaceTorsor.TorsorHom F.action G.action) :
    (toCategoricalTorsor X H F).1.Hom (toCategoricalTorsor X H G).1 where
  hom := {
    app := fun U => ↾(fun s => ULift.up (φ.app U.unop s.down))
    naturality := by
      intro U V f
      ext s
      apply ULift.ext
      exact φ.naturality f.unop.le s.down }
  map_act := by
    intro U g s
    apply ULift.ext
    exact φ.map_act g s.down

/-- A morphism of pseudo-torsors that is bijective on every section set is an isomorphism. -/
private theorem hom_isIso_of_bijective {X : TopCat.{u}}
    {H : TopCat.Sheaf AddCommGrpCat.{max u v} X}
    {F G : Stacks.Cohomology.Torsors.AbelianTorsor H} (φ : F.1.Hom G.1)
    (h : ∀ U, Function.Bijective (φ.hom.app U)) : φ.IsIso := by
  rw [PseudoTorsor.Hom.IsIso, NatTrans.isIso_iff_isIso_app]
  exact fun U => (CategoryTheory.isIso_iff_bijective _).2 (h U)

private theorem toCategoricalTorsorHom_isIso {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) (F G : Torsor X H)
    (φ : Stacks.SpaceTorsor.TorsorHom F.action G.action) (hφ : φ.IsIso) :
    (toCategoricalTorsorHom H F G φ).IsIso := by
  refine hom_isIso_of_bijective _ fun U => ⟨fun s t h => ?_, fun t => ?_⟩
  · apply ULift.ext
    exact (hφ U.unop).1 (ULift.up_injective h)
  · obtain ⟨s, hs⟩ := (hφ U.unop).2 t.down
    exact ⟨ULift.up s, congrArg ULift.up hs⟩

private noncomputable def torsorClassToCategoricalClass (X : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) :
    TorsorClass X H → Stacks.Cohomology.Torsors.torsorIsoClasses H :=
  Quotient.lift (fun F => Quotient.mk (Stacks.Cohomology.Torsors.torsorSetoid H)
    (toCategoricalTorsor X H F)) (by
      intro F G h
      induction h with
      | rel F G hFG =>
          apply Quotient.sound
          obtain ⟨φ, hφ⟩ := hFG
          exact ⟨toCategoricalTorsorHom H F G φ,
            toCategoricalTorsorHom_isIso H F G φ hφ⟩
      | refl F => rfl
      | symm F G h ih => exact ih.symm
      | trans F G K hFG hGK h₁ h₂ => exact h₁.trans h₂)

private abbrev fromSitePresheaf (X : TopCat.{u})
    (Q : (Opens X)ᵒᵖ ⥤ Type (max u v)) :
    Stacks.SpaceTorsor.PresheafOfSets.{u, max u v} X where
  obj U := Q.obj (op U)
  res h := (Q.map (homOfLE h).op)
  res_self U s := by simp
  res_comp hWV hVU s := by
    rw [← ConcreteCategory.comp_apply, ← Q.map_comp]
    rfl

private theorem fromSitePresheaf_isSheaf (X : TopCat.{u})
    (Q : (Opens X)ᵒᵖ ⥤ Type (max u v))
    (hQ : Presheaf.IsSheaf (Opens.grothendieckTopology X) Q) :
    (fromSitePresheaf X Q).IsSheaf := by
  have hUnique := (TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing Q).1 hQ
  intro U ι V hV hcover
  subst U
  constructor
  · intro s t hst
    change Q.obj (op (⨆ i, V i)) at s t
    let sf : ∀ i, Q.obj (op (V i)) :=
      fun i => Q.map (homOfLE (le_iSup V i)).op s
    have hsf : TopCat.Presheaf.IsCompatible Q V sf := by
      intro i j
      dsimp [sf]
      show Q.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op
          (Q.map (homOfLE (le_iSup V i)).op s) =
        Q.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op
          (Q.map (homOfLE (le_iSup V j)).op s)
      rw [← ConcreteCategory.comp_apply, ← Q.map_comp,
        ← ConcreteCategory.comp_apply, ← Q.map_comp]
      congr 1
    obtain ⟨g, hg, hgunique⟩ := hUnique V sf hsf
    have hs : TopCat.Presheaf.IsGluing Q V sf s := fun _ => rfl
    have ht : TopCat.Presheaf.IsGluing Q V sf t := by
      intro i
      have hi := congrFun (congrArg Subtype.val hst) i
      change Q.map (homOfLE (le_iSup V i)).op s =
        Q.map (homOfLE (le_iSup V i)).op t at hi
      exact hi.symm
    exact (hgunique s hs).trans (hgunique t ht).symm
  · intro cf
    let sf : ∀ i, Q.obj (op (V i)) := cf.1
    have hsf : TopCat.Presheaf.IsCompatible Q V sf := by
      intro i j
      exact cf.2 i j (V i ⊓ V j) inf_le_left inf_le_right
    obtain ⟨s, hs, _⟩ := hUnique V sf hsf
    refine ⟨s, ?_⟩
    apply Subtype.ext
    funext i
    exact hs i

private noncomputable def fromCategoricalTorsor (X : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X)
    (F : Stacks.Cohomology.Torsors.AbelianTorsor H) : Torsor X H := by
  let P := fromSitePresheaf X F.1.presheaf
  let S : Stacks.SpaceTorsor.SheafOfSets.{u, max u v} X := {
    toPresheafOfSets := P
    isSheaf := fromSitePresheaf_isSheaf X F.1.presheaf F.1.isSheaf }
  let a : Stacks.SpaceTorsor.Action (underlyingPresheafOfGroups X H) P := {
    act := fun {U} g s => F.1.act (op U) g s
    one_act := by
      intro U s
      exact F.1.one_act (op U) s
    mul_act := by
      intro U g h s
      exact F.1.mul_act (op U) g h s
    res_act := by
      intro U V h g s
      exact F.1.naturality (homOfLE h).op g s }
  refine ⟨S, a, ?_⟩
  constructor
  · intro U hU
    exact ⟨hU, fun s t => F.1.simplyTransitive (op U) hU s t⟩
  · intro x
    obtain ⟨R, hR, hsections⟩ := F.2 (⊤ : Opens X)
    rw [Opens.mem_grothendieckTopology] at hR
    obtain ⟨V, f, hf, hxV⟩ := hR x (by trivial)
    exact ⟨V, hxV, hsections hf⟩

private def fromCategoricalTorsorHom {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X)
    (F G : Stacks.Cohomology.Torsors.AbelianTorsor H)
    (φ : F.1.Hom G.1) :
    Stacks.SpaceTorsor.TorsorHom (fromCategoricalTorsor X H F).action
      (fromCategoricalTorsor X H G).action where
  app U s := φ.hom.app (op U) s
  naturality := by
    intro U V h s
    change (φ.hom.app (op V))
        ((ConcreteCategory.hom ((F.1.presheaf.map (homOfLE h).op))) s) =
      (ConcreteCategory.hom (G.1.presheaf.map (homOfLE h).op))
        ((φ.hom.app (op U)) s)
    have hn := NatTrans.naturality φ.hom (homOfLE h).op
    have heq := CategoryTheory.types_congr_hom hn s
    change (ConcreteCategory.hom (φ.hom.app (op V)))
        ((ConcreteCategory.hom (F.1.presheaf.map (homOfLE h).op)) s) =
      (ConcreteCategory.hom (G.1.presheaf.map (homOfLE h).op))
        ((ConcreteCategory.hom (φ.hom.app (op U))) s) at heq
    exact heq
  map_act := by
    intro U g s
    exact φ.map_act (op U) g s

private theorem fromCategoricalTorsorHom_isIso {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X)
    (F G : Stacks.Cohomology.Torsors.AbelianTorsor H)
    (φ : F.1.Hom G.1) (hφ : φ.IsIso) :
    (fromCategoricalTorsorHom H F G φ).IsIso := by
  intro U
  let : IsIso φ.hom := hφ
  exact ConcreteCategory.bijective_of_isIso (φ.hom.app (op U))

private noncomputable def categoricalClassToTorsorClass (X : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) :
    Stacks.Cohomology.Torsors.torsorIsoClasses H → TorsorClass X H :=
  Quotient.lift (fun F => Quotient.mk (torsorSetoid X H)
    (fromCategoricalTorsor X H F)) (by
      intro F G hFG
      apply Quotient.sound
      obtain ⟨φ, hφ⟩ := hFG
      exact Relation.EqvGen.rel _ _ ⟨fromCategoricalTorsorHom H F G φ,
        fromCategoricalTorsorHom_isIso H F G φ hφ⟩)

private def nativeToCategoricalBackHom {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) (F : Torsor X H) :
    Stacks.SpaceTorsor.TorsorHom F.action
      (fromCategoricalTorsor X H (toCategoricalTorsor X H F)).action where
  app U s := ULift.up s
  naturality := by intro U V h s; rfl
  map_act := by intro U g s; rfl

private theorem nativeToCategoricalBackHom_isIso {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) (F : Torsor X H) :
    (nativeToCategoricalBackHom H F).IsIso := by
  intro U
  constructor
  · intro s t h
    exact ULift.up_injective h
  · intro t
    exact ⟨t.down, rfl⟩

private def categoricalBackHom {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X)
    (F : Stacks.Cohomology.Torsors.AbelianTorsor H) :
    (toCategoricalTorsor X H (fromCategoricalTorsor X H F)).1.Hom F.1 where
  hom := {
    app := fun U => ↾(fun s => s.down)
    naturality := by
      intro U V f
      ext s
      rfl }
  map_act := by
    intro U g s
    rfl

private theorem categoricalBackHom_isIso {X : TopCat.{u}}
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X)
    (F : Stacks.Cohomology.Torsors.AbelianTorsor H) :
    (categoricalBackHom H F).IsIso := by
  exact hom_isIso_of_bijective _ fun U => Equiv.ulift.bijective

private noncomputable def torsorClassesEquivCategorical (X : TopCat.{u})
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) :
    TorsorClass X H ≃ Stacks.Cohomology.Torsors.torsorIsoClasses H where
  toFun := torsorClassToCategoricalClass X H
  invFun := categoricalClassToTorsorClass X H
  left_inv := by
    intro x
    refine Quotient.inductionOn x ?_
    intro F
    apply Quotient.sound
    exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _
      ⟨nativeToCategoricalBackHom H F, nativeToCategoricalBackHom_isIso H F⟩)
  right_inv := by
    intro x
    refine Quotient.inductionOn x ?_
    intro F
    apply Quotient.sound
    exact ⟨categoricalBackHom H F, categoricalBackHom_isIso H F⟩

/-- The canonical torsor classification, including its normalization and
compatibility with contracted products. The Čech equation is the local
description of the extension-and-boundary construction in the proof of 02FQ
(as described explicitly in 0B8R). -/
structure TorsorCohomologyClassification (X : TopCat.{u})
    [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{max u v}]
    (H : TopCat.Sheaf AddCommGrpCat.{max u v} X) where
  /-- The bijection of isomorphism classes. -/
  equiv : TorsorClass X H ≃ sheafCohomologyOne X H
  /-- The point-indexed specification; `of_cocycle` gives the resulting law for
  covers indexed by any type in an independent universe. -/
  of_point_cocycle (F : Torsor X H) (Ui : X → Opens X)
      (hUi : (⊤ : Opens X) = ⨆ i, Ui i) (s : ∀ i, F.F.obj (Ui i))
      (z : CechCochains.cocycles1 Ui H.presheaf) (hz : IsTransitionCocycle F Ui s z) :
    equiv (Quotient.mk _ F) =
      CechOne.cechH1ToRightDerivedSections X ⊤ Ui hUi H (CechCochains.cls Ui H.presheaf z)
  /-- A trivial torsor has zero cohomology class. -/
  of_global_section (F : Torsor X H) (s : F.F.obj ⊤) :
    equiv (Quotient.mk _ F) = 0
  /-- Contracted products correspond to addition. -/
  pairing (F G K : Torsor X H) (p : TorsorPairing F G K) :
    equiv (Quotient.mk _ K) = equiv (Quotient.mk _ F) + equiv (Quotient.mk _ G)

/-- The canonical classification is computed by transition cocycles on any
open covering, independently of the universe of its index type. -/
theorem TorsorCohomologyClassification.of_cocycle {X : TopCat.{u}}
    [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{max u v}]
    {H : TopCat.Sheaf AddCommGrpCat.{max u v} X}
    (c : TorsorCohomologyClassification X H) (F : Torsor X H)
    {I : Type w} (Ui : I → Opens X) (hUi : (⊤ : Opens X) = ⨆ i, Ui i)
    (s : ∀ i, F.F.obj (Ui i)) (z : CechCochains.cocycles1 Ui H.presheaf)
    (hz : IsTransitionCocycle F Ui s z) :
    c.equiv (Quotient.mk _ F) =
      CechOne.cechH1ToRightDerivedSections X ⊤ Ui hUi H (CechCochains.cls Ui H.presheaf z) := by
  classical
  have hex (x : X) : ∃ i, x ∈ Ui i := by
    apply Opens.mem_iSup.mp
    rw [← hUi]
    trivial
  choose a ha using hex
  have hUa : (⊤ : Opens X) = ⨆ x, Ui (a x) := by
    apply le_antisymm
    · intro x _
      exact Opens.mem_iSup.mpr ⟨x, ha x⟩
    · exact le_top
  let za : CechCochains.cocycles1 (Ui ∘ a) H.presheaf :=
    ⟨fun i => z.val (a ∘ i), by
      show CechCochains.cechD (Ui ∘ a) H.presheaf 1 _ = 0
      funext i
      exact congrFun z.property (a ∘ i)⟩
  have hza : IsTransitionCocycle F (Ui ∘ a) (fun x => s (a x)) za :=
    fun i => hz (a ∘ i)
  rw [c.of_point_cocycle F (Ui ∘ a) hUa (fun x => s (a x)) za hza]
  let : EnoughInjectives
      (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{max u v}) :=
    Stacks.Injectives.abelianSheaf_enoughInjectives X
  let J := injectiveResolution H
  obtain ⟨r, hr⟩ := CechOne.exists_cechOneResolutionRepresentative X ⊤ Ui hUi H J z
  let ra : CechOne.CechOneResolutionRepresentative X ⊤ (Ui ∘ a) hUa H J za :=
    { b := fun i => r.b (a ∘ i)
      cycle := r.cycle
      coboundary := fun i => r.coboundary (a ∘ i)
      restriction := fun i => r.restriction (a ∘ i) }
  exact (CechOne.cechH1ToRightDerivedSections_apply X ⊤ (Ui ∘ a) hUa H J za ra).trans
    hr.symm

end Stacks.Cohomology.SheafTorsor
