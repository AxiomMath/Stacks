module

public import StacksFrontier.Topology.Sheaves.Cohomology.Torsors.GeneratorTorsorOfAnInvertibleModule
public import StacksFrontier.Topology.Sheaves.Cohomology.Torsors.TrivializationFromAGenerator

/-!
# Invertible modules with a trivial generator torsor

The generator torsor of an invertible module `L` on a ringed space with local stalks is
trivial exactly when `L` has a global trivializing section, that is, exactly when `L` is
isomorphic to the structure sheaf.  This is the injectivity half of the classification of
invertible modules by first cohomology.

## Main definitions

* `Stacks.Cohomology.Generators.unitGeneratorTorsorSection`: the global section of the
  generator torsor of the structure sheaf given by the unit section.

## Main results

* `Stacks.Cohomology.Generators.generatorTorsorClassOfInvertible_unit`: the generator-torsor
  class of the structure sheaf is zero.
* `Stacks.Cohomology.Generators.nonempty_globalSection_iff_of_rel`: isomorphic torsors have
  global sections together.
* `Stacks.Cohomology.Generators.nonempty_generatorSections_top_of_class_eq_zero`: an
  invertible module whose generator-torsor class vanishes has a global trivializing section.
* `Stacks.Cohomology.Generators.nonempty_iso_unit_of_class_eq_zero`: an invertible module
  whose generator-torsor class vanishes is isomorphic to the structure sheaf.

## References

* [Stacks Project, Tag 09NU](https://stacks.math.columbia.edu/tag/09NU)
* [Stacks Project, Tag 02FQ](https://stacks.math.columbia.edu/tag/02FQ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.Cohomology.Generators

/-- Two torsors related by the equivalence relation generated by equivariant isomorphisms have
global sections together. -/
theorem nonempty_globalSection_iff_of_rel {X : TopCat.{u}}
    {H : TopCat.Sheaf AddCommGrpCat.{u} X}
    {F G : Stacks.Cohomology.SheafTorsor.Torsor X H}
    (h : (Stacks.Cohomology.SheafTorsor.torsorSetoid X H).r F G) :
    Nonempty (F.F.obj ⊤) ↔ Nonempty (G.F.obj ⊤) := by
  change Relation.EqvGen
    (fun A B : Stacks.Cohomology.SheafTorsor.Torsor X H => A.action.Iso B.action) F G at h
  induction h with
  | rel A B hab =>
    obtain ⟨φ, hφ⟩ := hab
    exact ⟨fun ⟨s⟩ => ⟨φ.app ⊤ s⟩, fun ⟨t⟩ => ⟨((hφ ⊤).2 t).choose⟩⟩
  | refl A => exact Iff.rfl
  | symm A B _ ih => exact ih.symm
  | trans A B C _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The structure sheaf is an invertible module over itself. -/
theorem isInvertible_unit_structureSheaf (X : RingedSpace.{u, u}) :
    Stacks.SheafOfModules.IsInvertible X.sheaf.obj (structureSheaf X.sheaf).property
      (SheafOfModules.unit (structureSheaf X.sheaf)) :=
  Stacks.SheafOfModules.isInvertible_unit X.sheaf.obj (structureSheaf X.sheaf).property

variable (X : RingedSpace.{u, u}) [∀ x : X, IsLocalRing (X.presheaf.stalk x)]

/-- The unit section of the structure sheaf, as a global section of its generator torsor. -/
def unitGeneratorTorsorSection :
    (generatorTorsorOfInvertible X (SheafOfModules.unit (structureSheaf X.sheaf))
      (isInvertible_unit_structureSheaf X)).F.obj ⊤ :=
  ((generatorTorsorOfInvertible X (SheafOfModules.unit (structureSheaf X.sheaf))
    (isInvertible_unit_structureSheaf X)).sectionsEquiv ⊤).symm (generatorSections_unit X)

/-- The generator torsor of the structure sheaf is trivial: its class is zero. -/
theorem generatorTorsorClassOfInvertible_unit :
    generatorTorsorClassOfInvertible X (SheafOfModules.unit (structureSheaf X.sheaf))
      (isInvertible_unit_structureSheaf X) = 0 :=
  Stacks.Cohomology.SheafTorsor.torsorClass_eq_zero_of_global_section X (unitsSheaf X)
    (generatorTorsorOfInvertible X (SheafOfModules.unit (structureSheaf X.sheaf))
      (isInvertible_unit_structureSheaf X)).toTorsor (unitGeneratorTorsorSection X)

/-- An invertible module whose generator-torsor class vanishes has a global trivializing
section. -/
theorem nonempty_generatorSections_top_of_class_eq_zero
    (L : SheafOfModules.{u} (structureSheaf X.sheaf))
    (hL : Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      (structureSheaf X.sheaf).property L)
    (h : generatorTorsorClassOfInvertible X L hL = 0) :
    Nonempty (GeneratorSections X L ⊤) := by
  have hrel : (Stacks.Cohomology.SheafTorsor.torsorSetoid X (unitsSheaf X)).r
      (generatorTorsorOfInvertible X L hL).toTorsor
      (generatorTorsorOfInvertible X (SheafOfModules.unit (structureSheaf X.sheaf))
        (isInvertible_unit_structureSheaf X)).toTorsor :=
    Quotient.exact (h.trans (generatorTorsorClassOfInvertible_unit X).symm)
  exact ((nonempty_globalSection_iff_of_rel hrel).mpr ⟨unitGeneratorTorsorSection X⟩).map
    ((generatorTorsorOfInvertible X L hL).sectionsEquiv ⊤)

/-- An invertible module whose generator-torsor class vanishes is isomorphic to the structure
sheaf. -/
theorem nonempty_iso_unit_of_class_eq_zero (L : SheafOfModules.{u} (structureSheaf X.sheaf))
    (hL : Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      (structureSheaf X.sheaf).property L)
    (h : generatorTorsorClassOfInvertible X L hL = 0) :
    Nonempty (SheafOfModules.unit (structureSheaf X.sheaf) ≅ L) :=
  (nonempty_generatorSections_top_of_class_eq_zero X L hL h).map (moduleIsoOfGenerator X L)

end Stacks.Cohomology.Generators

end
