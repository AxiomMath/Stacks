module

public import StacksFrontier.Topology.Sheaves.Cohomology.PerfectComplexes.ExtensionByZeroClosure
public import StacksFrontier.Topology.Sheaves.OpenImmersion.ModuleExtensionByZeroExact

/-!
# The subcomplex generated by finitely many generators over an open

Let `P` be a cochain complex of sheaves of `O`-modules whose term `P^n` is a coproduct of the
modules `j_{U_α!} O_{U_α}`, and let `S` be a finite set of generators, all defined over an open
`Z`, whose differentials lie in the span of the generators of `S` of the next degree. This file
constructs the subcomplex of `P` whose term of degree `n` is the image of the sum of copies of
`j_{Z!} O_Z` indexed by the generators of degree `n`, and shows that its restriction to `Z` is
free of finite rank in each degree.

## Main definitions

* `subcomplex`: The subcomplex of `P` generated by the chosen generators over `Z`.
* `subcomplexι`: The inclusion of the subcomplex into `P`.
* `restrictImageIso`: Over `Z`, the term of degree `n` of the subcomplex is isomorphic to a
  finite sum of copies of the structure sheaf.

## Main results

* `exists_lift_of_inSpan`: A section in the span of the generators of degree `n` lifts to the
  subcomplex.
* `gMap_app_injective`: Over opens inside `Z`, the sum of copies of `j_{Z!} O_Z` maps injectively
  to `P^n`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite ExtensionByZeroModules

universe u

namespace Stacks.Cohomology.LeftDualPerfect

open Classical

variable {T : TopCat.{u}} (O : Sheaf (Opens.grothendieckTopology T) RingCat.{u})
  (P : CochainComplex (SheafOfModules.{u} O) ℤ) {I : ℤ → Type u} (U : ∀ n, I n → Opens T)
  (ιP : ∀ n α, extUnit O (U n α) ⟶ P.X n) (Z : Opens T) (S : Finset (Σ n, I n))

/-- The category of sheaves of `O`-modules has finite biproducts. -/
instance hasFiniteBiproducts_sheafOfModules : HasFiniteBiproducts (SheafOfModules.{u} O) :=
  Abelian.hasFiniteBiproducts

/-- The generator of index `α` of `P^n`, over the open `Z` read as the image of the whole of the
open subspace `Z`. -/
abbrev elemAt (n : ℤ) (α : I n) : (P.X n).val.obj (op (imTop Z)) :=
  elemSecD O (U n) (cofanP O P U ιP n) α (imTop Z)

/-- The sum of copies of `j_{Z!} O_Z` indexed by the generators of degree `n`. -/
abbrev srcObj (n : ℤ) : SheafOfModules.{u} O := ⨁ fun _ : Fin (fib S n).card => extUnit O Z

/-- The enumeration of the generators of degree `n`. -/
abbrev genIdx (n : ℤ) (k : Fin (fib S n).card) : I n := ((fib S n).equivFin.symm k).1

/-- The morphism from `srcObj` to `P^n` sending the generators to the chosen generators. -/
def gMap (n : ℤ) : srcObj O Z S n ⟶ P.X n :=
  biproduct.desc fun k => homOfSection O Z (elemAt O P U ιP Z n (genIdx S n k))

/-- The section of `srcObj` given by the generator in the summand `k`. -/
abbrev srcGen (n : ℤ) (k : Fin (fib S n).card) : (srcObj O Z S n).val.obj (op (imTop Z)) :=
  (biproduct.ι (fun _ : Fin (fib S n).card => extUnit O Z) k).val.app (op (imTop Z)) (extGen O Z)

/-- The inclusion of the summand `k` composed with `gMap` is the morphism of the generator. -/
private theorem ι_comp_gMap (n : ℤ) (k : Fin (fib S n).card) :
    biproduct.ι (fun _ : Fin (fib S n).card => extUnit O Z) k ≫ gMap O P U ιP Z S n =
      homOfSection O Z (elemAt O P U ιP Z n (genIdx S n k)) := biproduct.ι_desc _ _

/-- `gMap` sends the generator of the summand `k` to the generator of index `genIdx S n k`. -/
theorem gMap_srcGen (n : ℤ) (k : Fin (fib S n).card) :
    (gMap O P U ιP Z S n).val.app (op (imTop Z)) (srcGen O Z S n k) =
      elemAt O P U ιP Z n (genIdx S n k) := by
  have h := ι_comp_gMap O P U ιP Z S n k
  exact (congrArg (fun φ => φ.val.app (op (imTop Z)) (extGen O Z)) h).trans
    (homOfSection_extGen O Z _)

/-- `gMap` sends a linear combination of the generators of `srcObj` to the same linear
combination of the generators of degree `n` of `P`. -/
theorem gMap_sum_srcGen (n : ℤ) (c : I n → O.obj.obj (op (imTop Z))) :
    (gMap O P U ιP Z S n).val.app (op (imTop Z))
        (∑ k : Fin (fib S n).card, c (genIdx S n k) • srcGen O Z S n k) =
      ∑ β ∈ fib S n, c β • elemAt O P U ιP Z n β := by
  rw [map_sum, ← Finset.sum_coe_sort (fib S n) (fun β => c β • elemAt O P U ιP Z n β),
    ← (fib S n).equivFin.symm.sum_comp]
  refine Fintype.sum_congr _ _ fun k => ?_
  rw [map_smul, gMap_srcGen]

variable {O P U ιP Z S}

/-- The image of the whole of the open subspace `Z` is contained in `Z`. -/
theorem imTop_le_self : imTop Z ≤ Z := (imTop_eq Z).le

/-- If the differential of every generator of `S` lies over `Z` in the span of the generators of
`S` of the next degree, then so does the differential of `elemAt` over `imTop Z`. -/
theorem inSpan_d_elemAt (hS : ∀ x ∈ S, Z ≤ imTop (U x.1 x.2))
    (hd : ∀ n, ∀ α ∈ fib S n, InSpan O (U (n + 1)) (cofanP O P U ιP (n + 1)) Z (fib S (n + 1))
      ((P.d n (n + 1)).val.app (op Z) (elemSecD O (U n) (cofanP O P U ιP n) α Z)))
    (n : ℤ) (α : I n) (hα : α ∈ fib S n) :
    InSpan O (U (n + 1)) (cofanP O P U ιP (n + 1)) (imTop Z) (fib S (n + 1))
      ((P.d n (n + 1)).val.app (op (imTop Z)) (elemAt O P U ιP Z n α)) := by
  have hZα : Z ≤ imTop (U n α) := fib_le U hS n α hα
  have e : (P.d n (n + 1)).val.app (op (imTop Z)) (elemAt O P U ιP Z n α) =
      resS (P.X (n + 1)) imTop_le_self ((P.d n (n + 1)).val.app (op Z)
        (elemSecD O (U n) (cofanP O P U ιP n) α Z)) :=
    (congrArg ((P.d n (n + 1)).val.app (op (imTop Z)))
      (resS_elemSecD O (U n) (cofanP O P U ιP n) α imTop_le_self hZα).symm).trans
      (resS_app (P.d n (n + 1)) imTop_le_self _).symm
  rw [e]
  exact (hd n α hα).res O _ _ imTop_le_self

variable (hS : ∀ x ∈ S, Z ≤ imTop (U x.1 x.2))
  (hd : ∀ n, ∀ α ∈ fib S n, InSpan O (U (n + 1)) (cofanP O P U ιP (n + 1)) Z (fib S (n + 1))
    ((P.d n (n + 1)).val.app (op Z) (elemSecD O (U n) (cofanP O P U ιP n) α Z)))

/-- The coefficients of the differential of a generator in the generators of the next degree. -/
def coefD (n : ℤ) (k : Fin (fib S n).card) : I (n + 1) → O.obj.obj (op (imTop Z)) :=
  Classical.choose (inSpan_d_elemAt hS hd n (genIdx S n k) ((fib S n).equivFin.symm k).2).2

/-- The differential of the generator `genIdx S n k` is the linear combination, with
coefficients `coefD`, of the generators of the next degree. -/
theorem coefD_spec (n : ℤ) (k : Fin (fib S n).card) :
    (P.d n (n + 1)).val.app (op (imTop Z)) (elemAt O P U ιP Z n (genIdx S n k)) =
      ∑ β ∈ fib S (n + 1), coefD hS hd n k β • elemAt O P U ιP Z (n + 1) β :=
  Classical.choose_spec (inSpan_d_elemAt hS hd n (genIdx S n k) ((fib S n).equivFin.symm k).2).2

/-- The differential of the subcomplex, on the sums of copies of `j_{Z!} O_Z`. -/
def liftMap (n : ℤ) : srcObj O Z S n ⟶ srcObj O Z S (n + 1) :=
  biproduct.desc fun k => homOfSection O Z
    (∑ l : Fin (fib S (n + 1)).card, coefD hS hd n k (genIdx S (n + 1) l) • srcGen O Z S (n + 1) l)

/-- `liftMap` and the differential of `P` commute with `gMap`. -/
theorem liftMap_comm (n : ℤ) :
    liftMap hS hd n ≫ gMap O P U ιP Z S (n + 1) = gMap O P U ιP Z S n ≫ P.d n (n + 1) := by
  refine biproduct.hom_ext' _ _ fun α => ?_
  rw [liftMap, biproduct.ι_desc_assoc, homOfSection_comp, gMap_sum_srcGen, gMap,
    biproduct.ι_desc_assoc, homOfSection_comp, coefD_spec]

/-- The differential of the subcomplex generated by the chosen generators. -/
def subDiff (n : ℤ) : image (gMap O P U ιP Z S n) ⟶ image (gMap O P U ιP Z S (n + 1)) :=
  image.map (Arrow.homMk' (liftMap hS hd n) (P.d n (n + 1)) (liftMap_comm hS hd n))

/-- The inclusions of the images of `gMap` intertwine `subDiff` with the differential of `P`. -/
theorem subDiff_ι (n : ℤ) :
    subDiff hS hd n ≫ image.ι (gMap O P U ιP Z S (n + 1)) =
      image.ι (gMap O P U ιP Z S n) ≫ P.d n (n + 1) :=
  image.map_homMk'_ι _

/-- Two consecutive differentials of the subcomplex compose to zero. -/
theorem subDiff_subDiff (n : ℤ) : subDiff hS hd n ≫ subDiff hS hd (n + 1) = 0 := by
  rw [← cancel_mono (image.ι (gMap O P U ιP Z S (n + 1 + 1))), Category.assoc, subDiff_ι,
    ← Category.assoc, subDiff_ι, Category.assoc, HomologicalComplex.d_comp_d, comp_zero,
    zero_comp]

/-- **The subcomplex of `P` generated by the chosen generators over `Z`**: in degree `n`, the
image of the sum of copies of `j_{Z!} O_Z` indexed by the generators of degree `n`. -/
def subcomplex : CochainComplex (SheafOfModules.{u} O) ℤ :=
  CochainComplex.of (fun n => image (gMap O P U ιP Z S n)) (subDiff hS hd)
    (subDiff_subDiff hS hd)

/-- The inclusion of the subcomplex. -/
def subcomplexι : subcomplex hS hd ⟶ P where
  f n := image.ι (gMap O P U ιP Z S n)
  comm' i j hij := by
    obtain rfl : i + 1 = j := hij
    exact (subDiff_ι hS hd i).symm.trans (congrArg (· ≫ image.ι (gMap O P U ιP Z S (i + 1)))
      (CochainComplex.of_d (fun n => image (gMap O P U ιP Z S n)) (subDiff hS hd) i).symm)

/-- Each component of the inclusion of the subcomplex is a monomorphism. -/
instance mono_subcomplexι_f (n : ℤ) : Mono ((subcomplexι hS hd).f n) :=
  inferInstanceAs (Mono (image.ι _))

/-- Every section in the span of the generators of degree `n` over `Z` lifts to the
subcomplex. -/
theorem exists_lift_of_inSpan {n : ℤ} {x : (P.X n).val.obj (op (imTop Z))}
    (hx : InSpan O (U n) (cofanP O P U ιP n) (imTop Z) (fib S n) x) :
    ∃ y : ((subcomplex hS hd).X n).val.obj (op (imTop Z)),
      ((subcomplexι hS hd).f n).val.app (op (imTop Z)) y = x := by
  obtain ⟨-, c, hc⟩ := hx
  refine ⟨(factorThruImage (gMap O P U ιP Z S n)).val.app (op (imTop Z))
    (∑ k : Fin (fib S n).card, c (genIdx S n k) • srcGen O Z S n k), ?_⟩
  have h := congrArg (fun φ => φ.val.app (op (imTop Z))
    (∑ k : Fin (fib S n).card, c (genIdx S n k) • srcGen O Z S n k))
    (image.fac (gMap O P U ιP Z S n))
  exact h.trans ((gMap_sum_srcGen O P U ιP Z S n c).trans hc.symm)

omit hS hd in
/-- The sections of a finite sum of morphisms of sheaves of modules are the sum of the
sections. -/
theorem sum_val_app {A B : SheafOfModules.{u} O} {ι : Type*} (t : Finset ι) (f : ι → (A ⟶ B))
    (Z' : Opens T) (z : A.val.obj (op Z')) :
    (∑ j ∈ t, f j).val.app (op Z') z = ∑ j ∈ t, (f j).val.app (op Z') z := by
  classical
  induction t using Finset.induction_on with
  | empty => rfl
  | insert j t hj ih =>
    rw [Finset.sum_insert hj, Finset.sum_insert hj, ← ih]
    rfl

omit hS hd in
/-- A section of `srcObj` is the sum of its components in the summands. -/
theorem srcObj_eq_sum (n : ℤ) {Z' : Opens T} (z : (srcObj O Z S n).val.obj (op Z')) :
    z = ∑ k : Fin (fib S n).card,
      (biproduct.ι (fun _ : Fin (fib S n).card => extUnit O Z) k).val.app (op Z')
        ((biproduct.π (fun _ : Fin (fib S n).card => extUnit O Z) k).val.app (op Z') z) := by
  have h := congrArg (fun φ : srcObj O Z S n ⟶ srcObj O Z S n => φ.val.app (op Z') z)
    (biproduct.total : ∑ j, biproduct.π (fun _ : Fin (fib S n).card => extUnit O Z) j ≫
      biproduct.ι (fun _ : Fin (fib S n).card => extUnit O Z) j = 𝟙 _)
  exact (h.symm.trans (sum_val_app _ _ Z' z)).trans rfl

/-- The open `imTop Z` lies in the one of each enumerated generator of degree `n`. -/
private theorem imTop_le_imTop_genIdx (hS : ∀ x ∈ S, Z ≤ imTop (U x.1 x.2)) (n : ℤ)
    (k : Fin (fib S n).card) :
    imTop Z ≤ imTop (U n (genIdx S n k)) :=
  imTop_le_self.trans (fib_le U hS n _ ((fib S n).equivFin.symm k).2)

include hS in
/-- Over an open `Z'` inside `Z`, `gMap` sends `c` times the restricted generator of the
summand `k` to `c` times the generator of index `genIdx S n k` over `Z'`. -/
theorem gMap_ι_smul (n : ℤ) (k : Fin (fib S n).card) {Z' : Opens T} (hZ' : Z' ≤ imTop Z)
    (c : O.obj.obj (op Z')) :
    (gMap O P U ιP Z S n).val.app (op Z')
      ((biproduct.ι (fun _ : Fin (fib S n).card => extUnit O Z) k).val.app (op Z')
        (c • resS (extUnit O Z) hZ' (extGen O Z))) =
      c • elemSecD O (U n) (cofanP O P U ιP n) (genIdx S n k) Z' := by
  refine (congrArg (fun φ => φ.val.app (op Z') (c • resS (extUnit O Z) hZ' (extGen O Z)))
    (ι_comp_gMap O P U ιP Z S n k)).trans ?_
  rw [homOfSection_smul_res_extGen]
  exact congrArg (c • ·)
    (resS_elemSecD O (U n) (cofanP O P U ιP n) _ hZ' (imTop_le_imTop_genIdx hS n k))

omit hS hd in
/-- The projection of index `β` sends the generator of index `α` to the restricted generator
of `j_{U_α!} O_{U_α}` when `α = β`, and to zero otherwise. -/
theorem cofanProj_elemSecD (n : ℤ) (hc : IsColimit (cofanP O P U ιP n)) (α β : I n) {Z' : Opens T}
    (hZ' : Z' ≤ imTop (U n α)) :
    (Stacks.SheafOfModules.CoproductSheafification.cofanProj hc β).val.app (op Z')
      (elemSecD O (U n) (cofanP O P U ιP n) α Z') =
      if h : α = β then h ▸ resS (extUnit O (U n α)) hZ' (extGen O (U n α)) else 0 := by
  rw [elemSecD_of_le O (U n) (cofanP O P U ιP n) α hZ']
  have e := Stacks.SheafOfModules.CoproductSheafification.inj_cofanProj hc β α
  by_cases h : α = β
  · subst h
    simp only [dif_pos] at e ⊢
    exact congrArg (fun φ => φ.val.app (op Z') (resS (extUnit O (U n α)) hZ' (extGen O (U n α)))) e
  · simp only [h, dif_neg, not_false_eq_true] at e ⊢
    exact congrArg (fun φ => φ.val.app (op Z') (resS (extUnit O (U n α)) hZ' (extGen O (U n α)))) e

omit hS hd in
/-- The enumeration of the generators of degree `n` is injective. -/
theorem genIdx_injective (n : ℤ) : Function.Injective (genIdx S n) := fun _ _ h =>
  (fib S n).equivFin.symm.injective (Subtype.ext h)

include hS in
/-- **Over opens inside `Z`, the sum of copies of `j_{Z!} O_Z` maps injectively to `P^n`.** The
generators of distinct summands of `P^n` are independent over the structure sheaf. -/
theorem gMap_app_injective (n : ℤ) (hc : IsColimit (cofanP O P U ιP n)) {Z' : Opens T}
    (hZ' : Z' ≤ imTop Z) : Function.Injective ((gMap O P U ιP Z S n).val.app (op Z')) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  have hcoef : ∀ k : Fin (fib S n).card, ∃ c : O.obj.obj (op Z'),
      (biproduct.π (fun _ : Fin (fib S n).card => extUnit O Z) k).val.app (op Z') z =
        c • resS (extUnit O Z) hZ' (extGen O Z) := fun k =>
    exists_eq_smul_res_extGen O Z hZ' _
  choose c hc' using hcoef
  have hgz : (gMap O P U ιP Z S n).val.app (op Z') z =
      ∑ l : Fin (fib S n).card, c l • elemSecD O (U n) (cofanP O P U ιP n) (genIdx S n l) Z' := by
    conv_lhs => rw [srcObj_eq_sum n z]
    rw [map_sum]
    exact Fintype.sum_congr _ _ fun l => by rw [hc' l, gMap_ι_smul hS]
  have hU : ∀ l : Fin (fib S n).card, Z' ≤ imTop (U n (genIdx S n l)) := fun l =>
    hZ'.trans (imTop_le_imTop_genIdx hS n l)
  have hck : ∀ k, c k = 0 := by
    intro k
    have h0 := congrArg ((Stacks.SheafOfModules.CoproductSheafification.cofanProj (hc)
      (genIdx S n k)).val.app (op Z')) (hgz.symm.trans hz)
    rw [map_sum, map_zero, Finset.sum_eq_single k] at h0
    · rw [map_smul, cofanProj_elemSecD n hc _ _ (hU k), dif_pos rfl] at h0
      exact eq_zero_of_smul_res_extGen O (U n (genIdx S n k)) (hU k) _ h0
    · intro l _ hlk
      rw [map_smul, cofanProj_elemSecD n hc _ _ (hU l),
        dif_neg (fun h => hlk (genIdx_injective n h)), smul_zero]
    · intro h; exact absurd (Finset.mem_univ k) h
  rw [srcObj_eq_sum n z]
  refine Finset.sum_eq_zero fun k _ => ?_
  rw [hc' k, hck k, zero_smul, map_zero]

include hS in
/-- The restriction of `gMap` to `Z` is a monomorphism. -/
theorem mono_jStar_map_gMap (n : ℤ) (hc : IsColimit (cofanP O P U ιP n)) :
    Mono ((jStar Z O).map (gMap O P U ιP Z S n)) := by
  refine (SheafOfModules.forget _).mono_of_mono_map ?_
  exact PresheafOfModules.mono_of_injective fun T' =>
    gMap_app_injective hS n hc (imF_le_imTop Z T'.unop)

/-- Restriction to `Z` preserves epimorphisms. -/
instance : (jStar Z O).PreservesEpimorphisms :=
  have := (jStarAdjunction Z O).isLeftAdjoint
  Functor.preservesEpimorphisms_of_isLeftAdjoint _

include hS in
/-- The restriction to `Z` of the factorization of `gMap` through its image is an
isomorphism. -/
theorem isIso_jStar_map_factorThruImage (n : ℤ) (hc : IsColimit (cofanP O P U ιP n)) :
    IsIso ((jStar Z O).map (factorThruImage (gMap O P U ιP Z S n))) := by
  have hm := mono_jStar_map_gMap hS n hc
  rw [← image.fac (gMap O P U ιP Z S n), Functor.map_comp] at hm
  have : Mono ((jStar Z O).map (factorThruImage (gMap O P U ιP Z S n))) :=
    mono_of_mono _ ((jStar Z O).map (image.ι (gMap O P U ιP Z S n)))
  exact isIso_of_mono_of_epi _

include hS in
/-- **Over `Z`, the term of degree `n` of the subcomplex is free of finite rank.** -/
def restrictImageIso (n : ℤ) (hc : IsColimit (cofanP O P U ιP n)) :
    (jStar Z O).obj (image (gMap O P U ιP Z S n)) ≅
      ⨁ fun _ : Fin (fib S n).card => SheafOfModules.unit (resRing Z O) :=
  have := isIso_jStar_map_factorThruImage hS n hc
  (asIso ((jStar Z O).map (factorThruImage (gMap O P U ιP Z S n)))).symm ≪≫
    (jStar Z O).mapBiproduct _ ≪≫ biproduct.mapIso fun _ => (asIso (extUnitIso O Z)).symm

end Stacks.Cohomology.LeftDualPerfect
