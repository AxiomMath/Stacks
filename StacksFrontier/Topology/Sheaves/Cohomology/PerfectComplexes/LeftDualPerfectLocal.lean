module

public import StacksFrontier.Topology.Sheaves.Cohomology.PerfectComplexes.LeftDualSumResolution
public import StacksFrontier.Topology.Sheaves.Cohomology.PerfectComplexes.RetractOfAPerfectObject

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open ExtensionByZeroModules Stacks.SheafOfModules.DerivedMonoidal StrictlyPerfect
open CategoryTheory.MonoidalCategory

universe u

namespace Stacks.Cohomology.LeftDualPerfect

variable (X : RingedSpace.{u, u})

/-- The biproduct of a family of objects indexed by an empty finite type is a zero object. -/
theorem isZero_biproduct_of_isEmpty {C : Type*} [Category* C] [Preadditive C]
    [HasFiniteBiproducts C] {J : Type} [Fintype J] [IsEmpty J] (f : J → C) : IsZero (⨁ f) := by
  rw [IsZero.iff_id_eq_zero, ← biproduct.total]
  simp

/-- If `A ≅ B` in the derived category and `A` is concentrated in degrees `≤ n`, then so is
`B`. -/
theorem _root_.DerivedCategory.isLE_of_iso' {C : Type*} [Category* C] [Abelian C]
    [HasDerivedCategory C] {A B : DerivedCategory C} (e : A ≅ B) (n : ℤ) (h : A.IsLE n) :
    B.IsLE n := by
  rw [DerivedCategory.isLE_iff] at h ⊢
  exact fun i hi => (h i hi).of_iso ((DerivedCategory.homologyFunctor C i).mapIso e.symm)

/-- **The restriction to `Z` of the subcomplex generated by finitely many generators is strictly
perfect.** -/
theorem isStrictlyPerfect_restrict_subcomplex (L : Complexes X.sheaf) {I : ℤ → Type u}
    (U : ∀ n, I n → Opens X.carrier) (ιP : ∀ n α, extUnit (ringO X) (U n α) ⟶ L.X n)
    (hc : ∀ n, IsColimit (cofanP (ringO X) L U ιP n)) {Z : Opens X.carrier}
    {S : Finset (Σ n, I n)} (hS : ∀ x ∈ S, Z ≤ imTop (U x.1 x.2))
    (hd : ∀ n, ∀ α ∈ fib S n, InSpan (ringO X) (U (n + 1)) (cofanP (ringO X) L U ιP (n + 1)) Z
      (fib S (n + 1)) ((L.d n (n + 1)).val.app (op Z)
        (elemSecD (ringO X) (U n) (cofanP (ringO X) L U ιP n) α Z))) :
    IsStrictlyPerfect (((restrictMod X Z).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (subcomplex hS hd)) where
  bounded := by
    refine (S.image Sigma.fst).finite_toSet.subset fun i hi => ?_
    by_contra h
    apply hi
    have hfib : (fib S i).card = 0 := Finset.card_eq_zero.2
      (Finset.eq_empty_of_forall_notMem fun α hα =>
        h (Finset.mem_image.2 ⟨⟨i, α⟩, mem_fib.1 hα, rfl⟩))
    have : IsEmpty (Fin (fib S i).card) := by rw [hfib]; infer_instance
    exact (isZero_biproduct_of_isEmpty (C := SheafOfModules.{u} (resRing Z (ringO X)))
      (fun _ : Fin (fib S i).card => SheafOfModules.unit (resRing Z (ringO X)))).of_iso
        (restrictImageIso hS i (hc i))
  directSummand i :=
    isDirectSummandOfFiniteFree_of_iso (restrictImageIso hS i (hc i))
      ((isDirectSummandOfFiniteFree_iff_retract _).mpr ⟨_, ⟨Retract.refl _⟩⟩)

/-- A finite set of pairs `(i, j)` of integers with `i + j = 0` has a lower bound on the first
coordinates. -/
theorem exists_lower_bound_of_finset (S : Finset {ij : ℤ × ℤ // ij.1 + ij.2 = 0}) :
    ∃ c : ℤ, ∀ ij ∈ S, c ≤ ij.1.1 :=
  ⟨-(S.sum fun ij => |ij.1.1|), fun _ hij => neg_le.1 ((neg_le_abs _).trans
    (Finset.single_le_sum (f := fun ij : {ij : ℤ × ℤ // ij.1 + ij.2 = 0} => |ij.1.1|)
      (fun _ _ => abs_nonneg _) hij))⟩

universe d d' d''

open Stacks.Cohomology.MonoidalDerived Stacks.Cohomology.MonoidalComplexes in
/-- If `M` has a left dual in `D(O_X)` and is concentrated in degrees `≤ b`, then every point has
an open neighbourhood over which `M` is perfect. -/
theorem exists_isPerfect_restrict_of_isLE [HasDerivedCategory.{d} (Mod X.sheaf)]
    [instR : ∀ W : Opens X, HasDerivedCategory.{d'} (Mod (X.restrict W.isOpenEmbedding).sheaf)]
    [∀ (W : Opens X) (V : Opens (X.restrict W.isOpenEmbedding)),
      HasDerivedCategory.{d''} (OXMod ((X.restrict W.isOpenEmbedding).restrict V.isOpenEmbedding))]
    (M N : DerivedModules X.sheaf)
    (pair : letI := derivedCategoryMonoidalCategory X; ExactPairing M N) (b : ℤ) (hb : M.IsLE b)
    (x : X) :
    ∃ W : Opens X, x ∈ W ∧
      @Stacks.Cohomology.PerfectComplexes.IsPerfect.{u, u, d'} _ (instR W)
        ((restrictMod X W).mapDerivedCategory.obj M) := by
  have : (DerivedCategory.Q.objPreimage M).IsLE b :=
    (DerivedCategory.isLE_Q_obj_iff _ _).1
      (DerivedCategory.isLE_of_iso' (DerivedCategory.Q.objObjPreimageIso M).symm b hb)
  obtain ⟨L, f, hf, hP, hL⟩ :=
    (CochainComplex.exists_quasiIso_prop (IsSumExt X) (exists_epi_isSumExt X) b).2
      (DerivedCategory.Q.objPreimage M)
  choose I U ιP hc' using hP
  have hc : ∀ n, IsColimit (cofanP (ringO X) L U ιP n) := fun n => (hc' n).some
  have hLk : KFlat X.sheaf L :=
    AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.kFlat_of_boundedAbove_of_flat X L ⟨b, hL⟩
      fun n => isFlat_of_isSumExt X ⟨I n, U n, ιP n, hc' n⟩
  obtain ⟨Nc, pN, hNk, hNflat, hpN, -⟩ :=
    AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.exists_kFlatResolution X
      (DerivedCategory.Q.objPreimage N)
  obtain ⟨U₀, hxU₀, S₀, n₀, a, hR⟩ := exists_local_retract X M N pair L Nc
    (asIso (DerivedCategory.Q.map f) ≪≫ DerivedCategory.Q.objObjPreimageIso M)
    (asIso (DerivedCategory.Q.map pN) ≪≫ DerivedCategory.Q.objObjPreimageIso N) hLk hNk x
  obtain ⟨c, hcS⟩ := exists_lower_bound_of_finset S₀
  obtain ⟨Z, hZ, hxZ, S, hS, -, hfam, hd⟩ := exists_closed_span (ringO X) L U ιP hc b c
    (fun n hn => L.isZero_of_isStrictlyLE b n hn) x hxU₀
    (ι := Σ ij : S₀, Fin (n₀ ij)) (fun i => i.1.1.1.1) (fun i => a i.1 i.2)
    (fun i => hcS i.1.1 i.1.2)
  refine ⟨Z, hxZ, ?_⟩
  let := cochainComplexMonoidalCategory X
  have : Mono ((subcomplexι hS hd ▷ Nc).f 1) :=
    mono_mapBifunctorMap_f (R := X.sheaf) (subcomplexι hS hd) hNflat 1
  obtain ⟨r⟩ := hR Z hZ (subcomplex hS hd) (subcomplexι hS hd) fun ij k => by
    obtain ⟨y, hy⟩ := exists_lift_of_inSpan hS hd
      ((hfam ⟨ij, k⟩).res (ringO X) _ _ imTop_le_self)
    exact ⟨y, hy.trans (resS_resS _ _ _ _)⟩
  have hsp := isStrictlyPerfect_restrict_subcomplex X L U ιP hc hS hd
  let : HasDerivedCategory.{d'} (OXMod.{u, u} (X.restrict Z.isOpenEmbedding)) := instR Z
  obtain ⟨E, hE, ⟨e⟩⟩ :=
    Stacks.Cohomology.PerfectDirectSummands.isPerfect_Q_obj_of_isStrictlyPerfect _ hsp
  have hK : Stacks.Cohomology.PerfectComplexes.IsPerfect.{u, u, d'}
      ((restrictMod X Z).mapDerivedCategory.obj (DerivedCategory.Q.obj (subcomplex hS hd))) :=
    ⟨E, hE, ⟨Iso.trans (C := DerivedCategory (Mod (X.restrict Z.isOpenEmbedding).sheaf)) e
      ((restrictMod X Z).mapDerivedCategoryFactors.app (subcomplex hS hd)).symm⟩⟩
  exact Stacks.Cohomology.PerfectDirectSummands.isPerfect_of_retract r.i r.r r.retract hK

end Stacks.Cohomology.LeftDualPerfect
