module

public import StacksFrontier.Topology.Sheaves.Cohomology.InvertibleDerivedClauseThreeConverse
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Sheaves.Cohomology.InvertibleDerivedIdempotentSplitting
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.InvertibleRankOne.Converse
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.InvertibleRankOne.Unconditional

/-!
# Clause (3) of Stacks 0FPG implies clause (2)

Let `(X, 𝒪_X)` be a ringed space all of whose stalks are local rings, and let `M` be an object of
`D(𝒪_X)` which on each member `U_i` of an open covering is an invertible `𝒪_{U_i}`-module placed in
a degree `n_i`. Then two members with distinct degrees are disjoint, so the opens
`X_n = ⋃_{n_i = n} U_i` are disjoint and cover `X`; their indicator sections `e_n` are a locally
finite complete family of orthogonal idempotents of `Γ(X, 𝒪_X)`, `e_n` acts on `H^k(M)` as the
identity for `k = n` and as zero otherwise, and `H^n(M)` is an invertible module over
`𝒪_n = e_n 𝒪_X`. So `M = ⨁ H^n(M)[-n]` is as in clause (2).

## Main results

In the namespace `Stacks.Cohomology.InvertibleDerived`:

* `exists_smul_bijective_of_iso_restrict`: an `𝒪_X`-module whose restriction to `U` is invertible
  is, near every point of `U` at which the stalks are local, generated freely by a single section.
* `hasInvertibleModuleDecomposition_of_hasLocalInvertibleDegree`: the implication `(3) ⟹ (2)`.

## References

* [Stacks Project, Tag 0FPG](https://stacks.math.columbia.edu/tag/0FPG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
open StrictlyPerfect Stacks.SheafOfModules.DerivedMonoidal

universe u d

namespace Stacks.Cohomology.InvertibleDerived

variable {X : RingedSpace.{u, u}}

/-- The stalks of an open subspace are the stalks of the space. -/
public theorem isLocalRing_restrict_stalk (hloc : ∀ x : X.carrier, IsLocalRing (X.presheaf.stalk x))
    (U : Opens X.carrier) (y : (X.restrict U.isOpenEmbedding).carrier) :
    IsLocalRing ((X.restrict U.isOpenEmbedding).presheaf.stalk y) :=
  have : IsLocalRing (X.presheaf.stalk y.1) := hloc y.1
  (X.toPresheafedSpace.restrictStalkIso U.isOpenEmbedding y).symm.commRingCatIsoToRingEquiv
    |>.isLocalRing

/-- Bijectivity of multiplication against the restriction of a section does not depend on how
the open set is written. -/
public theorem bijective_smul_res_congr (F : Mod X.sheaf) {W : Opens X.carrier}
    (s : F.val.obj (op W)) {A B : Opens X.carrier} (hAB : A = B) (hA : A ≤ W) (hB : B ≤ W)
    (h : Function.Bijective fun c : X.presheaf.obj (op A) =>
      ringSec (U := op A) c • F.val.map (homOfLE hA).op s) :
    Function.Bijective fun c : X.presheaf.obj (op B) =>
      ringSec (U := op B) c • F.val.map (homOfLE hB).op s := by
  subst hAB
  exact h

/-- The image in `X` of the preimage in `U` of an open `W ≤ U` is `W`. -/
private theorem functor_obj_preimage_eq {U W : Opens X.carrier} (hW : W ≤ U) :
    U.isOpenEmbedding.isOpenMap.functor.obj
      ⟨Subtype.val ⁻¹' (W : Set X.carrier), W.isOpen.preimage continuous_subtype_val⟩ = W := by
  ext z
  constructor
  · rintro ⟨v, hv, rfl⟩
    exact hv
  · intro hz
    exact ⟨⟨z, hW hz⟩, hz, rfl⟩

/-- **A module which is invertible on `U` is, near each point of `U` with local stalks, freely
generated by one section.** If the restriction of `F` to `U` is isomorphic to an invertible
`𝒪_U`-module and all stalks of `𝒪_X` are local rings, then every point of `U` has an open
neighbourhood `W ≤ U` and a section `s` of `F` over `W` such that `c ↦ c • s|_{W'}` is a bijection
`𝒪_X(W') → F(W')` for every open `W' ≤ W`. -/
public theorem exists_smul_bijective_of_iso_restrict
    (hloc : ∀ x : X.carrier, IsLocalRing (X.presheaf.stalk x)) {U : Opens X.carrier}
    (F : Mod X.sheaf) {L : OXMod.{u, u} (X.restrict U.isOpenEmbedding)}
    (hL : IsInvertibleModule _ L) (φ : (restrictModules X U).obj F ≅ L) {x : X.carrier}
    (hx : x ∈ U) :
    ∃ W : Opens X.carrier, x ∈ W ∧ W ≤ U ∧ ∃ s : F.val.obj (op W), ∀ (W' : Opens X.carrier)
      (h : W' ≤ W), Function.Bijective fun c : X.presheaf.obj (op W') =>
        ringSec (U := op W') c • F.val.map (homOfLE h).op s := by
  let Y := X.restrict U.isOpenEmbedding
  have : ∀ y : Y.carrier, IsLocalRing (Y.presheaf.stalk y) := isLocalRing_restrict_stalk hloc U
  have : Stacks.SheafOfModules.IsInvertible Y.presheaf
      (_root_.structureSheafRing Y).property ((restrictModules X U).obj F) :=
    have : Stacks.SheafOfModules.IsInvertible Y.presheaf
      (_root_.structureSheafRing Y).property L := hL
    Stacks.SheafOfModules.isInvertible_of_iso _ _ φ.symm
  obtain ⟨I, Xs, hcov, hiso⟩ :=
    (Stacks.SheafOfModules.Invertible.isLocallyTrivial_of_isInvertible
      ((restrictModules X U).obj F)).exists_trivializing_cover
  obtain ⟨i, hi⟩ := ((Opens.coversTop_iff _ _).mp hcov).exists_mem (⟨x, hx⟩ : U)
  obtain ⟨e, he⟩ := Stacks.SheafOfModules.exists_smulSectionMap_bijective_of_over_iso_unit
    (hiso i).some
  refine ⟨U.isOpenEmbedding.isOpenMap.functor.obj (Xs i), ⟨⟨x, hx⟩, hi, rfl⟩,
    isOpenMap_functor_obj_le U (Xs i), e, fun W' hW' => ?_⟩
  let V : Opens Y.carrier := ⟨Subtype.val ⁻¹' (W' : Set X.carrier),
    (W'.isOpen.preimage continuous_subtype_val)⟩
  have hVX : V ≤ Xs i := by
    intro v hv
    obtain ⟨w, hw, hwv⟩ := hW' hv
    exact (Subtype.ext hwv : w = v) ▸ hw
  have hVW : U.isOpenEmbedding.isOpenMap.functor.obj V = W' :=
    functor_obj_preimage_eq (hW'.trans (isOpenMap_functor_obj_le U (Xs i)))
  exact bijective_smul_res_congr F e hVW (U.isOpenEmbedding.isOpenMap.functor.monotone hVX) hW'
    (he (op (Over.mk (homOfLE hVX))))

/-- Sections of a sheaf of `𝒪_X`-modules agree if they agree on the members of a covering. -/
public theorem mod_eq_of_locally_eq (F : Mod X.sheaf) {ι : Type*} (U : ι → Opens X.carrier)
    (V : Opens X.carrier) (iUV : ∀ i, U i ⟶ V) (hcover : V ≤ iSup U) (m m' : F.val.obj (op V))
    (h : ∀ i, F.val.map (iUV i).op m = F.val.map (iUV i).op m') : m = m' :=
  TopCat.Sheaf.eq_of_locally_eq' (⟨F.val.presheaf, F.isSheaf⟩ : TopCat.Sheaf AddCommGrpCat.{u} _)
    U V iUV hcover m m' h

/-- Sections of `𝒪_X` over an open set with no points are all equal. -/
public theorem presheaf_eq_of_isEmpty {V : Opens X.carrier} (hV : ∀ x, x ∉ V)
    (s t : X.presheaf.obj (op V)) : s = t :=
  presheaf_eq_of_locally_eq (ι := PEmpty.{1}) (fun i => i.elim) V (fun i => i.elim)
    (fun x hx => (hV x hx).elim) s t fun i => i.elim

/-- **Where the restriction of a module vanishes, so do its sections.** -/
public theorem eq_zero_of_isZero_restrict {U : Opens X.carrier} {F : Mod X.sheaf}
    (hF : IsZero ((restrictModules X U).obj F)) {W : Opens X.carrier} (hW : W ≤ U)
    (m : F.val.obj (op W)) : m = 0 := by
  let V : Opens (X.restrict U.isOpenEmbedding).carrier :=
    ⟨Subtype.val ⁻¹' (W : Set X.carrier), W.isOpen.preimage continuous_subtype_val⟩
  have hVW : U.isOpenEmbedding.isOpenMap.functor.obj V = W := functor_obj_preimage_eq hW
  have key : ∀ m' : F.val.obj (op (U.isOpenEmbedding.isOpenMap.functor.obj V)), m' = 0 :=
    fun m' => congrArg (fun f : (restrictModules X U).obj F ⟶ (restrictModules X U).obj F =>
      (f.val.app (op V)).hom m') (hF.eq_of_src (𝟙 _) 0)
  clear_value V
  subst hVW
  exact key m

/-- Where the restriction of a module vanishes, its sections form a subsingleton. -/
private theorem subsingleton_obj_of_isZero_restrict {U : Opens X.carrier} {F : Mod X.sheaf}
    (hF : IsZero ((restrictModules X U).obj F)) {W : Opens X.carrier} (hW : W ≤ U) :
    Subsingleton (F.val.obj (op W)) :=
  ⟨fun a b => (eq_zero_of_isZero_restrict hF hW a).trans (eq_zero_of_isZero_restrict hF hW b).symm⟩

/-! ### The degrees of clause (3) are locally constant -/

/-- **Members of the covering of clause (3) with distinct degrees are disjoint**, when the stalks
of `𝒪_X` are local rings: on the overlap the cohomology sheaf `H^{n_i}(E)` would be both the
invertible module of `U_i`, which is locally free of rank one, and zero. -/
public theorem not_mem_of_degree_ne (hloc : ∀ x : X.carrier, IsLocalRing (X.presheaf.stalk x))
    (E : CochainComplex (Mod X.sheaf) ℤ) {U U' : Opens X.carrier} {n n' : ℤ}
    {L : OXMod.{u, u} (X.restrict U.isOpenEmbedding)}
    {L' : OXMod.{u, u} (X.restrict U'.isOpenEmbedding)} (hL : IsInvertibleModule _ L)
    (f : (CochainComplex.singleFunctor _ n).obj L ⟶
      ((restrictModules X U).mapHomologicalComplex (ComplexShape.up ℤ)).obj E) [QuasiIso f]
    (f' : (CochainComplex.singleFunctor _ n').obj L' ⟶
      ((restrictModules X U').mapHomologicalComplex (ComplexShape.up ℤ)).obj E) [QuasiIso f']
    (hnn' : n ≠ n') {x : X.carrier} (hx : x ∈ U) : x ∉ U' := by
  intro hx'
  obtain ⟨φ⟩ := nonempty_restrictModules_homology_iso E f
  obtain ⟨W, hxW, -, s, hs⟩ := exists_smul_bijective_of_iso_restrict hloc _ hL φ hx
  have hz := isZero_restrictModules_homology_of_ne E f' hnn'
  have hsub : Subsingleton (X.presheaf.obj (op (W ⊓ U'))) :=
    ⟨fun _ _ => (hs (W ⊓ U') inf_le_left).injective
      (@Subsingleton.elim _ (subsingleton_obj_of_isZero_restrict hz inf_le_right) _ _)⟩
  exact not_subsingleton_sections_of_isLocalRing_stalk x (hloc x)
    (Opens.mem_inf.mpr ⟨hxW, hx'⟩) hsub

/-! ### The indicator idempotents of the degrees -/

section Indicator

variable {I : Type u} (U : I → Opens X.carrier) (hU : iSup U = ⊤) (deg : I → ℤ)
  (hdisj : ∀ i j, deg i ≠ deg j → ∀ x, x ∈ U i → x ∉ U j)

include hdisj in
/-- The sections `1` on the members of degree `n` and `0` on the others are compatible, since two
members of distinct degrees are disjoint. -/
public theorem isCompatible_indicator (n : ℤ) :
    TopCat.Presheaf.IsCompatible X.presheaf U fun i =>
      (if deg i = n then 1 else 0 : X.presheaf.obj (op (U i))) := by
  intro i j
  dsimp only
  by_cases hij : deg i = deg j
  · by_cases hi : deg i = n
    · rw [if_pos hi, if_pos (hij ▸ hi), map_one, map_one]
    · rw [if_neg hi, if_neg (fun h => hi (hij.trans h)), map_zero, map_zero]
  · exact presheaf_eq_of_isEmpty (fun x (hx : x ∈ U i ⊓ U j) =>
      hdisj i j hij x (Opens.mem_inf.mp hx).1 (Opens.mem_inf.mp hx).2) _ _

/-- The indicator section of the union of the members of degree `n`. -/
public def indicator (n : ℤ) : X.presheaf.obj (op ⊤) :=
  (presheaf_existsUnique_gluing U ⊤ (fun _ => homOfLE le_top) (hU ▸ le_rfl) _
    (isCompatible_indicator U deg hdisj n)).exists.choose

/-- The indicator of degree `n` restricts to `1` on the members of degree `n` and to `0` on the
others. -/
public theorem globalRes_indicator (n : ℤ) (i : I) :
    globalRes (indicator U hU deg hdisj n) (U i) = if deg i = n then 1 else 0 :=
  (presheaf_existsUnique_gluing U ⊤ (fun _ => homOfLE le_top) (hU ▸ le_rfl) _
    (isCompatible_indicator U deg hdisj n)).exists.choose_spec i

include hU in
/-- Global sections of `𝒪_X` which agree on every member of the covering are equal. -/
public theorem global_eq_of_res_eq {s t : X.presheaf.obj (op ⊤)}
    (h : ∀ i, globalRes s (U i) = globalRes t (U i)) : s = t :=
  presheaf_eq_of_locally_eq U ⊤ (fun _ => homOfLE le_top) (hU ▸ le_rfl) s t h

include hU in
/-- Every point of `X` lies in some member of the covering. -/
public theorem exists_mem_of_iSup_eq_top (x : X.carrier) : ∃ i, x ∈ U i :=
  Opens.mem_iSup.mp (hU ▸ (show x ∈ (⊤ : Opens X.carrier) from trivial))

/-- **The indicator sections of the degrees are a locally finite complete family of orthogonal
idempotents.** -/
public def indicatorIdempotents : LocallyFiniteIdempotents X where
  e := indicator U hU deg hdisj
  idem n := global_eq_of_res_eq U hU fun i => by
    rw [globalRes_mul, globalRes_indicator]
    split_ifs <;> simp
  ortho n m hnm := global_eq_of_res_eq U hU fun i => by
    rw [globalRes_mul, globalRes_indicator, globalRes_indicator, globalRes_zero]
    split_ifs with h1 h2
    · exact (hnm (h1.symm.trans h2)).elim
    all_goals simp
  locallyFinite x := by
    obtain ⟨i, hi⟩ := exists_mem_of_iSup_eq_top U hU x
    refine ⟨U i, {deg i}, hi, fun n hn => ?_, ?_⟩
    · rw [globalRes_indicator, if_neg (fun h => hn (Finset.mem_singleton.mpr h.symm))]
    · rw [Finset.sum_singleton, globalRes_indicator, if_pos rfl]

/-- The indicator of degree `n` restricts to `1` on an open contained in a member of degree `n`,
and to `0` on an open contained in a member of another degree. -/
public theorem globalRes_indicator_of_le (n : ℤ) {i : I} {V : Opens X.carrier} (h : V ≤ U i) :
    globalRes (indicator U hU deg hdisj n) V = if deg i = n then 1 else 0 := by
  rw [← map_globalRes _ (homOfLE h).op, globalRes_indicator]
  split_ifs
  · exact map_one _
  · exact map_zero _

/-- Restricting a multiple of a section by a global section. -/
public theorem res_smulHom (t : X.presheaf.obj (op ⊤)) (F : Mod X.sheaf) {W V : Opens X.carrier}
    (h : V ≤ W) (m : F.val.obj (op W)) :
    F.val.map (homOfLE h).op ((smulHom t F).val.app (op W) m) =
      ringSec (U := op V) (globalRes t V) • F.val.map (homOfLE h).op m :=
  (F.val.map_smul _ _ m).trans
    (congrArg (fun a : (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj (op V) =>
      a • F.val.map (homOfLE h).op m) (map_globalRes t (homOfLE h).op))

/-- Multiplying a section `m` by `if p then 1 else 0` gives `if p then m else 0`. -/
public theorem smul_ite_eq (F : Mod X.sheaf) {V : Opens X.carrier} (p : Prop) [Decidable p]
    (m : F.val.obj (op V)) :
    ringSec (U := op V) (if p then (1 : X.presheaf.obj (op V)) else 0) • m =
      if p then m else 0 := by
  split_ifs
  · exact one_smul ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj (op V)) m
  · exact zero_smul ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj (op V)) m

/-- **The indicator of degree `n` acts on `H^k(E)` as the identity for `k = n` and as zero
otherwise**, when `H^k(E)` vanishes on every member of the covering whose degree is not `k`. -/
public theorem actsOnHomology_indicator (E : CochainComplex (Mod X.sheaf) ℤ)
    (hz : ∀ i k, k ≠ deg i → IsZero ((restrictModules X (U i)).obj (E.homology k))) :
    ActsOnHomology (fun n => smulNatTrans ((indicatorIdempotents U hU deg hdisj).e n)) E := by
  intro n k
  rw [smulNatTrans_app]
  have hcov : ∀ W : Opens X.carrier, W ≤ iSup fun i => W ⊓ U i := fun W x hx =>
    Opens.mem_iSup.mpr ⟨(exists_mem_of_iSup_eq_top U hU x).choose,
      Opens.mem_inf.mpr ⟨hx, (exists_mem_of_iSup_eq_top U hU x).choose_spec⟩⟩
  have key : ∀ (W : Opens X.carrier) (m : (E.homology k).val.obj (op W)) (i : I),
      (E.homology k).val.map (homOfLE (inf_le_left : W ⊓ U i ≤ W)).op
        ((smulHom ((indicatorIdempotents U hU deg hdisj).e n) (E.homology k)).val.app (op W) m) =
      if deg i = n then (E.homology k).val.map (homOfLE (inf_le_left : W ⊓ U i ≤ W)).op m
        else 0 :=
    fun W m i => (res_smulHom _ _ _ m).trans
      ((congrArg (fun a => ringSec (U := op (W ⊓ U i)) a •
          (E.homology k).val.map (homOfLE (inf_le_left : W ⊓ U i ≤ W)).op m)
        (globalRes_indicator_of_le U hU deg hdisj n (inf_le_right : W ⊓ U i ≤ U i))).trans
        (smul_ite_eq _ _ _))
  have h0 : ∀ (W : Opens X.carrier) (m : (E.homology k).val.obj (op W)) (i : I), k ≠ deg i →
      (E.homology k).val.map (homOfLE (inf_le_left : W ⊓ U i ≤ W)).op m = 0 :=
    fun W m i hk => eq_zero_of_isZero_restrict (hz i k hk) inf_le_right _
  split_ifs with hkn <;> ext W m <;>
    refine mod_eq_of_locally_eq _ (fun i => W.unop ⊓ U i) W.unop (fun i => homOfLE inf_le_left)
      (hcov W.unop) _ _ fun i => (key W.unop m i).trans ?_ <;>
    split_ifs with hi
  · rfl
  · exact (h0 W.unop m i fun h => hi (h.symm.trans hkn)).symm
  · exact (h0 W.unop m i fun h => hkn (h.trans hi)).trans (map_zero _).symm
  · exact (map_zero _).symm

end Indicator

/-- The corner of the idempotent `1` is the whole ring. -/
public theorem bijective_val_corner_of_eq_one {R : Type*} [CommRing R] {e : R}
    (he : IsIdempotentElem e) (h1 : e = 1) : Function.Bijective (Subtype.val : he.Corner → R) :=
  ⟨Subtype.val_injective, fun r => ⟨⟨r, (mem_corner_iff_of_comm he).mpr (by rw [h1, one_mul])⟩,
    rfl⟩⟩

/-! ### The implication `(3) ⟹ (2)` -/

/-- **The implication `(3) ⟹ (2)` of Stacks 0FPG.** Let `(X, 𝒪_X)` be a ringed space all of whose
stalks are local rings. If `M` is, on each member of an open covering, an invertible module placed
in a single degree — clause (3) — then there is a locally finite direct product decomposition
`𝒪_X = ∏ 𝒪_n` and invertible `𝒪_n`-modules `ℋ^n` with `M = ⨁ ℋ^n[-n]` — clause (2).

The members of the covering with distinct degrees are disjoint (`not_mem_of_degree_ne`), so the
indicator sections of the degrees are a locally finite complete family of orthogonal idempotents
(`indicatorIdempotents`), which act on the cohomology sheaves as the degree projections
(`actsOnHomology_indicator`); `H^n(M)` is locally free of rank one over the `n`-th factor
(`exists_smul_bijective_of_iso_restrict`), and `hasInvertibleModuleDecomposition_of_idempotents`
assembles the decomposition, with `𝒪_n` the corner `e_n 𝒪_X` and `ℋ^n = H^n(M)`. -/
public theorem hasInvertibleModuleDecomposition_of_hasLocalInvertibleDegree
    [HasDerivedCategory.{d} (Mod X.sheaf)] (M : DerivedModules X.sheaf)
    (hM : HasLocalInvertibleDegree M)
    (hloc : ∀ x : X.carrier, IsLocalRing (X.presheaf.stalk x)) :
    HasInvertibleModuleDecomposition X M := by
  classical
  obtain ⟨E, ⟨I, U, hU, hdata⟩, ⟨eM⟩⟩ := hM
  choose deg L hL f hf using hdata
  have hdisj : ∀ i j, deg i ≠ deg j → ∀ x, x ∈ U i → x ∉ U j := fun i j hij x hx =>
    @not_mem_of_degree_ne X hloc E (U i) (U j) (deg i) (deg j) (L i) (L j) (hL i) (f i) (hf i)
      (f j) (hf j) hij x hx
  have hz : ∀ i k, k ≠ deg i → IsZero ((restrictModules X (U i)).obj (E.homology k)) :=
    fun i k hk => @isZero_restrictModules_homology_of_ne X E (U i) (deg i) (L i) (f i) (hf i) k hk
  have hK := actsOnHomology_indicator U hU deg hdisj E hz
  have hdec := hasInvertibleModuleDecomposition_of_idempotents hK fun n => by
    refine LocallyFiniteIdempotents.isInvertibleModule_factorModule _ fun x => ?_
    obtain ⟨i, hi⟩ := exists_mem_of_iSup_eq_top U hU x
    by_cases hin : deg i = n
    · subst hin
      obtain ⟨φ⟩ := @nonempty_restrictModules_homology_iso X E (U i) (deg i) (L i) (f i) (hf i)
      obtain ⟨W, hxW, hWU, t, ht⟩ := exists_smul_bijective_of_iso_restrict hloc _ (hL i) φ hi
      refine ⟨W, hxW, t, fun W' hW' => (ht W' hW').comp ?_⟩
      exact bijective_val_corner_of_eq_one
        ((indicatorIdempotents U hU deg hdisj).idem_res (deg i) W')
        ((globalRes_indicator_of_le U hU deg hdisj (deg i) (hW'.trans hWU)).trans (if_pos rfl))
    · refine ⟨U i, hi, 0, fun W' hW' => ⟨fun a b _ => LocallyFiniteIdempotents.Corner.ext _ ?_,
        fun y => ⟨0, ?_⟩⟩⟩
      · have h0 : globalRes ((indicatorIdempotents U hU deg hdisj).e n) W' = 0 :=
          (globalRes_indicator_of_le U hU deg hdisj n hW').trans (if_neg hin)
        exact (LocallyFiniteIdempotents.corner_val_eq_zero _ h0 a).trans
          (LocallyFiniteIdempotents.corner_val_eq_zero _ h0 b).symm
      · exact @Subsingleton.elim _ (subsingleton_obj_of_isZero_restrict (hz i n (Ne.symm hin)) hW')
          _ _
  obtain ⟨D, H, hH, ⟨e⟩⟩ := hdec
  exact ⟨D, H, hH, ⟨eM.symm ≪≫ e⟩⟩

/-- **Stacks 0FPG, the equivalence of clauses (2) and (3).** Let `(X, 𝒪_X)` be a ringed space all
of whose stalks `𝒪_{X,x}` are local rings, and let `M` be an object of `D(𝒪_X)`. Then `M` admits a
locally finite direct product decomposition `𝒪_X = ∏ 𝒪_n` with invertible `𝒪_n`-modules `ℋ^n` and
`M = ⨁ ℋ^n[-n]` — clause (2) — if and only if there is an open covering `X = ⋃ U_i` and integers
`n_i` such that `M|_{U_i}` is represented by an invertible `𝒪_{U_i}`-module placed in degree
`n_i` — clause (3). -/
@[stacks 0FPG "if every stalk of 𝒪_X is a local ring, clauses (2) and (3) are equivalent"]
public theorem hasInvertibleModuleDecomposition_iff_hasLocalInvertibleDegree
    [HasDerivedCategory.{d} (Mod X.sheaf)] (M : DerivedModules X.sheaf)
    (hloc : ∀ x : X.carrier, IsLocalRing (X.presheaf.stalk x)) :
    HasInvertibleModuleDecomposition X M ↔ HasLocalInvertibleDegree M :=
  ⟨fun h => hasLocalInvertibleDegree_of_hasInvertibleModuleDecomposition M h hloc,
    fun h => hasInvertibleModuleDecomposition_of_hasLocalInvertibleDegree M h hloc⟩

end Stacks.Cohomology.InvertibleDerived

end
