module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.HypercohomologyEdge.AcyclicObject
public import StacksFrontier.Topology.Sheaves.Functors.Module.RingedSpace
import StacksCore.Tactic.StacksAttribute

/-! # Hypercohomology over an acyclic open of a ringed space

Let `(X, O_X)` be a ringed space, `K` an object of the unbounded derived category of
`O_X`-modules and `B` a set of opens of `X` generating the topology. If every cohomology sheaf
of `K` has vanishing higher cohomology over the members of `B`, then over each member `U` of `B`
the hypercohomology `H^q(U, K)` is the module of sections of the cohomology sheaf `H^q(K)` over
`U`, in every degree. This is Tag 0BKT, the ringed-space form of Tag 0BKZ.

The content is entirely in the site form: the opens of `X` with their Grothendieck topology are
a site, sheaves of `O_X`-modules in the sense of ringed spaces are sheaves of modules over
`structureSheafRing X`, and a basis of opens is exactly a
class of objects covering that site. So this file converts the hypothesis -- which is the one
piece of work -- and applies Tag 0BKZ.

## Main results

* `Stacks.Cohomology.AcyclicOpen.hasEnoughObjects_of_isBasis`: a basis of opens of a topological
  space is a class of objects covering the site of its opens.
* `Stacks.Cohomology.AcyclicOpen.isIso_hypercohomologyEdge_app_of_isBasis`: **Tag 0BKT**, in the
  canonical form: the hypercohomology edge morphism over a member of the basis is invertible.
* `Stacks.Cohomology.AcyclicOpen.hypercohomologyIso`: the resulting identification of
  `H^q(U, K)` with `Γ(U, H^q(K))`.

## Implementation notes

The basis is taken as a `Set (Opens X)` satisfying `TopologicalSpace.Opens.IsBasis`, which is
the source's condition that every open has a covering by members of the collection: the sieve
generated by the members of the basis contained in an open `U` is a covering sieve of `U`
exactly because every point of `U` has a basic neighbourhood inside `U`.

The space, its structure ring and the modules share one universe, as the ringed-space module
API requires; the Grothendieck-abelian witness keeps its own universe, as in Tag 0BKZ.

## References

* [Stacks Project, Tag 0BKT](https://stacks.math.columbia.edu/tag/0BKT)
* [Stacks Project, Tag 0BKZ](https://stacks.math.columbia.edu/tag/0BKZ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry RingedSpaceModuleAdjunction
open Stacks.Cohomology.HypercohomologyEdge

namespace Stacks.Cohomology.AcyclicOpen

universe u g

attribute [local instance] HasDerivedCategory.standard

/-- A basis of opens of a topological space has enough objects for the Grothendieck topology on
its opens: the members of the basis contained in an open `U` generate a covering sieve of `U`,
because every point of `U` lies in such a member. -/
theorem hasEnoughObjects_of_isBasis {X : TopCat.{u}} {B : Set (Opens X)}
    (hB : Opens.IsBasis B) :
    (Opens.grothendieckTopology X).HasEnoughObjects (fun U ↦ U ∈ B) := by
  intro U
  refine ⟨{V : Opens X // V ∈ B ∧ V ≤ U}, fun i ↦ i.1, fun i ↦ homOfLE i.2.2, ?_,
    fun i ↦ i.2.1⟩
  refine (Opens.mem_grothendieckTopology X).2 fun x hx ↦ ?_
  obtain ⟨V, hV, hxV, hVU⟩ := (Opens.isBasis_iff_nbhd.mp hB) hx
  exact ⟨V, homOfLE hVU, (Sieve.mem_ofArrows_iff _ _ _).2 ⟨⟨V, hV, hVU⟩, 𝟙 V, by simp⟩, hxV⟩

variable (X : RingedSpace.{u, u})
  [HasSheafify (Opens.grothendieckTopology X.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [IsGrothendieckAbelian.{g} (SheafOfModules.{u} (structureSheafRing X))]
  [EnoughInjectives (SheafOfModules.{u} (structureSheafRing X))]

attribute [local instance] evaluation_additive

/-- **Stacks Project Tag 0BKT.** If every cohomology sheaf of `K` has vanishing higher cohomology
over the members of a basis of opens, then over each member of that basis the hypercohomology
edge morphism `H^q(U, K) ⟶ Γ(U, H^q(K))` is invertible, in every degree. -/
@[stacks 0BKT]
theorem isIso_hypercohomologyEdge_app_of_isBasis
    (K : DerivedCategory (SheafOfModules.{u} (structureSheafRing X)))
    (B : Set (Opens X.carrier)) (hB : Opens.IsBasis B)
    (hK : ∀ V ∈ B, ∀ p : ℕ, 0 < p → ∀ q : ℤ,
      IsZero (((SheafOfModules.evaluation (structureSheafRing X) (op V)).rightDerived p).obj
        ((DerivedCategory.homologyFunctor (SheafOfModules.{u} (structureSheafRing X)) q).obj K)))
    (U : Opens X.carrier) (hU : U ∈ B) (q : ℤ) :
    IsIso ((hypercohomologyEdge (structureSheafRing X) U q).app K) :=
  isIso_hypercohomologyEdge_app_of_acyclic_cover (structureSheafRing X) U K (fun V ↦ V ∈ B)
    (hasEnoughObjects_of_isBasis hB) (fun V hV p hp m ↦ hK V hV p hp m) hU q

/-- The identification `H^q(U, K) ≅ Γ(U, H^q(K))` of Tag 0BKT, given by the hypercohomology edge
morphism itself. -/
def hypercohomologyIso
    (K : DerivedCategory (SheafOfModules.{u} (structureSheafRing X)))
    (B : Set (Opens X.carrier)) (hB : Opens.IsBasis B)
    (hK : ∀ V ∈ B, ∀ p : ℕ, 0 < p → ∀ q : ℤ,
      IsZero (((SheafOfModules.evaluation (structureSheafRing X) (op V)).rightDerived p).obj
        ((DerivedCategory.homologyFunctor (SheafOfModules.{u} (structureSheafRing X)) q).obj K)))
    (U : Opens X.carrier) (hU : U ∈ B) (q : ℤ) :
    (DerivedCategory.homologyFunctor (ModuleCat.{u} ((structureSheafRing X).obj.obj (op U))) q).obj
        ((derivedSections (structureSheafRing X) U).obj K) ≅
      (SheafOfModules.evaluation (structureSheafRing X) (op U)).obj
        ((DerivedCategory.homologyFunctor (SheafOfModules.{u} (structureSheafRing X)) q).obj K) :=
  have := isIso_hypercohomologyEdge_app_of_isBasis X K B hB hK U hU q
  asIso ((hypercohomologyEdge (structureSheafRing X) U q).app K)

/-- Tag 0BKT in the form that only asserts the existence of the identification. The canonical
form is `isIso_hypercohomologyEdge_app_of_isBasis`, which exhibits the edge morphism as the
isomorphism; this weaker shape is kept because it is how the statement is consumed. -/
theorem nonempty_hypercohomologyIso
    (K : DerivedCategory (SheafOfModules.{u} (structureSheafRing X)))
    (B : Set (Opens X.carrier)) (hB : Opens.IsBasis B)
    (hK : ∀ V ∈ B, ∀ p : ℕ, 0 < p → ∀ q : ℤ,
      IsZero (((SheafOfModules.evaluation (structureSheafRing X) (op V)).rightDerived p).obj
        ((DerivedCategory.homologyFunctor (SheafOfModules.{u} (structureSheafRing X)) q).obj K)))
    (U : Opens X.carrier) (hU : U ∈ B) (q : ℤ) :
    Nonempty
      ((DerivedCategory.homologyFunctor
            (ModuleCat.{u} ((structureSheafRing X).obj.obj (op U))) q).obj
          ((derivedSections (structureSheafRing X) U).obj K) ≅
        (SheafOfModules.evaluation (structureSheafRing X) (op U)).obj
          ((DerivedCategory.homologyFunctor
            (SheafOfModules.{u} (structureSheafRing X)) q).obj K)) :=
  ⟨hypercohomologyIso X K B hB hK U hU q⟩

end Stacks.Cohomology.AcyclicOpen

end
