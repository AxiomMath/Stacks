module

public import
  StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.InternalHomPullbackDinaturality
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.InternalHomPullbackUnit
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.MixedInternalHomPullbackIso

/-!
# Dévissage of the invertibility of the derived pullback of a derived internal hom

Let `h : (X, 𝒪_X) ⟶ (Y, 𝒪_Y)` be a morphism of ringed spaces and let `K, M ∈ D(𝒪_Y)`. Tag 08I3
provides the canonical map

`Lh^* R𝓗om_{𝒪_Y}(K, M) ⟶ R𝓗om_{𝒪_X}(Lh^*K, Lh^*M)`,

`Stacks.Cohomology.DerivedInternalHomPullback.derivedPullbackSheafHomMap`, and Tag 0GM7 asserts
that it is an isomorphism when `K` is perfect. This file shows that it is an isomorphism at every
`K` of the strictly full saturated triangulated subcategory of `D(𝒪_Y)` generated by `𝒪_Y[0]`,
and at every direct summand of `𝒪_Y[0]`. Abstractly, the hom-comparison of a functor with
internal hom is natural in its first argument, and is invertible at every object of the thick
triangulated subcategory generated by a tensor unit whose image is a tensor unit.

## Main definitions

* `Stacks.Cohomology.DerivedInternalHomPullback.Transpose.comparisonSourceFunctor` and
  `Transpose.comparisonTargetFunctor`: the two sides of the comparison read as functors of its
  first argument, `E ↦ P 𝓗om₁(E, F)` and `E ↦ 𝓗om₂(P E, P F)` on `D₁ᵒᵖ`.

## Main results

* `Stacks.Cohomology.DerivedInternalHomPullback.Transpose.isIso_homComparison_of_generatedByOp`:
  the hom-comparison of a functor with internal hom is invertible at every object of the thick
  triangulated subcategory generated by a tensor unit whose image is a tensor unit.
* `Stacks.Cohomology.DerivedInternalHomPullback.isIso_derivedPullbackSheafHomMap_of_generatedByOp`
  : the canonical map of Tag 08I3 on a ringed space is invertible at every `K` of the thick
  triangulated subcategory of `D(𝒪_Y)` generated by `𝒪_Y[0]`.

## References

* [Stacks Project, Tag 0GM7](https://stacks.math.columbia.edu/tag/0GM7)
* [Stacks Project, Tag 08I3](https://stacks.math.columbia.edu/tag/08I3)
* [Stacks Project, Tag 08JP](https://stacks.math.columbia.edu/tag/08JP)
* [Stacks Project, Tag 08CM](https://stacks.math.columbia.edu/tag/08CM)
* [Stacks Project, Tag 0ATI](https://stacks.math.columbia.edu/tag/0ATI)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
  TopologicalSpace Opposite
open scoped CategoryTheory.Prod

namespace Stacks.Cohomology.DerivedInternalHomPullback

universe u

namespace Transpose

/-! ### The two sides of the comparison as functors of its first argument -/

section Functors

variable {D₁ D₂ : Type*} [Category D₁] [Category D₂]
  (P : D₁ ⥤ D₂) (H₁ : D₁ᵒᵖ ⥤ D₁ ⥤ D₁) (H₂ : D₂ᵒᵖ ⥤ D₂ ⥤ D₂)

/-- The left-hand side of the comparison as a functor of its first argument,
`E ↦ P 𝓗om₁(E, F)` on `D₁ᵒᵖ`. -/
def comparisonSourceFunctor (F : D₁) : D₁ᵒᵖ ⥤ D₂ := H₁.flip.obj F ⋙ P

/-- The right-hand side of the comparison as a functor of its first argument,
`E ↦ 𝓗om₂(P E, P F)` on `D₁ᵒᵖ`. -/
def comparisonTargetFunctor (F : D₁) : D₁ᵒᵖ ⥤ D₂ := P.op ⋙ H₂.flip.obj (P.obj F)

/-- The value of `comparisonSourceFunctor P H₁ F` at `E` is `P 𝓗om₁(E, F)`. -/
@[simp]
theorem comparisonSourceFunctor_obj (F : D₁) (E : D₁ᵒᵖ) :
    (comparisonSourceFunctor P H₁ F).obj E = P.obj ((H₁.obj E).obj F) :=
  rfl

/-- The value of `comparisonTargetFunctor P H₂ F` at `E` is `𝓗om₂(P E, P F)`. -/
@[simp]
theorem comparisonTargetFunctor_obj (F : D₁) (E : D₁ᵒᵖ) :
    (comparisonTargetFunctor P H₂ F).obj E = (H₂.obj (op (P.obj E.unop))).obj (P.obj F) :=
  rfl

end Functors

/-! ### The comparison is natural in its first argument -/

section OneCategoryNaturality

variable {D : Type*} [Category D] (H : Dᵒᵖ ⥤ D ⥤ D) (T : D × D ⥤ D)
  (e : ∀ A B C : D, (A ⟶ (H.obj (op B)).obj C) ≃ (T.obj (A, B) ⟶ C))

/-- The evaluation of an internal hom is dinatural in the variable it evaluates at: for
`φ : A ⟶ B` the two ways of getting from `hom(B, F) ⊗ A` to `F` — induce `hom(B, F) ⟶ hom(A, F)`
and evaluate at `A`, or push `A` to `B` and evaluate at `B` — agree. -/
theorem evaluation_dinatural (hnat : TensorHomEquivNaturalLeft H T e)
    (hdin : TensorHomEquivDinatural H T e) {A B : D} (φ : A ⟶ B) (F : D) :
    T.map ((H.map φ.op).app F ×ₘ 𝟙 A) ≫ evaluation H T e A F =
      T.map (𝟙 ((H.obj (op B)).obj F) ×ₘ φ) ≫ evaluation H T e B F := by
  have h₁ := hnat ((H.obj (op B)).obj F) ((H.obj (op A)).obj F) A F ((H.map φ.op).app F) (𝟙 _)
  have h₂ := hdin ((H.obj (op B)).obj F) B A F φ (𝟙 _)
  rw [Category.comp_id] at h₁
  rw [Category.id_comp] at h₂
  exact h₁.symm.trans h₂

end OneCategoryNaturality

section TwoCategoryNaturality

variable {D₁ D₂ : Type*} [Category D₁] [Category D₂]
  (P : D₁ ⥤ D₂) (H₁ : D₁ᵒᵖ ⥤ D₁ ⥤ D₁) (H₂ : D₂ᵒᵖ ⥤ D₂ ⥤ D₂)
  (T₁ : D₁ × D₁ ⥤ D₁) (T₂ : D₂ × D₂ ⥤ D₂)
  (e₁ : ∀ A B C : D₁, (A ⟶ (H₁.obj (op B)).obj C) ≃ (T₁.obj (A, B) ⟶ C))
  (e₂ : ∀ A B C : D₂, (A ⟶ (H₂.obj (op B)).obj C) ≃ (T₂.obj (A, B) ⟶ C))
  (m : T₁ ⋙ P ≅ P.prod P ⋙ T₂)

/-- The transpose datum of the comparison, the monoidality comparison followed by `P` of the
evaluation, is dinatural in the first argument. -/
theorem homComparisonDatum_dinatural
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁) (hdin₁ : TensorHomEquivDinatural H₁ T₁ e₁)
    {A B : D₁} (φ : A ⟶ B) (F : D₁) :
    T₂.map (P.map ((H₁.map φ.op).app F) ×ₘ 𝟙 (P.obj A)) ≫
        homComparisonDatum P H₁ T₁ T₂ e₁ m A F =
      T₂.map (𝟙 (P.obj ((H₁.obj (op B)).obj F)) ×ₘ P.map φ) ≫
        homComparisonDatum P H₁ T₁ T₂ e₁ m B F := by
  have key : ∀ {X₁ X₂ Y₁ Y₂ : D₁} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂),
      T₂.map (P.map f ×ₘ P.map g) ≫ m.inv.app (Y₁, Y₂) =
        m.inv.app (X₁, X₂) ≫ P.map (T₁.map (f ×ₘ g)) := fun f g => by
    simpa using m.inv.naturality (X := (_, _)) (Y := (_, _)) (f ×ₘ g)
  have hA := key ((H₁.map φ.op).app F) (𝟙 A)
  have hB := key (𝟙 ((H₁.obj (op B)).obj F)) φ
  simp only [CategoryTheory.Functor.map_id] at hA hB
  calc T₂.map (P.map ((H₁.map φ.op).app F) ×ₘ 𝟙 (P.obj A)) ≫
          homComparisonDatum P H₁ T₁ T₂ e₁ m A F
      = m.inv.app ((H₁.obj (op B)).obj F, A) ≫
          P.map (T₁.map ((H₁.map φ.op).app F ×ₘ 𝟙 A) ≫ evaluation H₁ T₁ e₁ A F) := by
        simp only [homComparisonDatum, Functor.map_comp, ← Category.assoc, hA]
    _ = m.inv.app ((H₁.obj (op B)).obj F, A) ≫
          P.map (T₁.map (𝟙 ((H₁.obj (op B)).obj F) ×ₘ φ) ≫ evaluation H₁ T₁ e₁ B F) := by
        rw [evaluation_dinatural H₁ T₁ e₁ hnat₁ hdin₁ φ F]
    _ = T₂.map (𝟙 (P.obj ((H₁.obj (op B)).obj F)) ×ₘ P.map φ) ≫
          homComparisonDatum P H₁ T₁ T₂ e₁ m B F := by
        simp only [homComparisonDatum, Functor.map_comp, ← Category.assoc, hB]

/-- The comparison of a functor with internal hom is natural in its first argument. -/
theorem homComparison_naturality_source
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁) (hdin₁ : TensorHomEquivDinatural H₁ T₁ e₁)
    (hnat₂ : TensorHomEquivNaturalLeft H₂ T₂ e₂) (hdin₂ : TensorHomEquivDinatural H₂ T₂ e₂)
    {A B : D₁} (φ : A ⟶ B) (F : D₁) :
    P.map ((H₁.map φ.op).app F) ≫ homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m A F =
      homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m B F ≫
        (H₂.map (P.map φ).op).app (P.obj F) := by
  refine (e₂ (P.obj ((H₁.obj (op B)).obj F)) (P.obj A) (P.obj F)).injective ?_
  rw [hnat₂ (P.obj ((H₁.obj (op B)).obj F)) (P.obj ((H₁.obj (op A)).obj F)) (P.obj A) (P.obj F)
      (P.map ((H₁.map φ.op).app F)) (homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m A F),
    hdin₂ (P.obj ((H₁.obj (op B)).obj F)) (P.obj B) (P.obj A) (P.obj F) (P.map φ)
      (homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m B F),
    homComparison_adjoint, homComparison_adjoint]
  exact homComparisonDatum_dinatural P H₁ T₁ T₂ e₁ m hnat₁ hdin₁ φ F

/-- The comparison as a natural transformation of its first argument, from
`E ↦ P 𝓗om₁(E, F)` to `E ↦ 𝓗om₂(P E, P F)` on `D₁ᵒᵖ`. -/
def homComparisonNatTrans
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁) (hdin₁ : TensorHomEquivDinatural H₁ T₁ e₁)
    (hnat₂ : TensorHomEquivNaturalLeft H₂ T₂ e₂) (hdin₂ : TensorHomEquivDinatural H₂ T₂ e₂)
    (F : D₁) :
    comparisonSourceFunctor P H₁ F ⟶ comparisonTargetFunctor P H₂ F where
  app E := homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m E.unop F
  naturality _ _ f :=
    homComparison_naturality_source P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hdin₁ hnat₂ hdin₂ f.unop F

/-- The component of `homComparisonNatTrans` at `op Z` is the comparison map
`homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m Z F`. -/
@[simp]
theorem homComparisonNatTrans_app
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁) (hdin₁ : TensorHomEquivDinatural H₁ T₁ e₁)
    (hnat₂ : TensorHomEquivNaturalLeft H₂ T₂ e₂) (hdin₂ : TensorHomEquivDinatural H₂ T₂ e₂)
    (F : D₁) (Z : D₁) :
    (homComparisonNatTrans P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hdin₁ hnat₂ hdin₂ F).app (op Z) =
      homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m Z F :=
  rfl

/-- Invertibility of the comparison passes to a retract of its first argument: if `A` is a
retract of `B` in `D₁` — so `A ⟶ B ⟶ A` is the identity — and the comparison at `B` is
invertible, then so is the comparison at `A`. -/
theorem isIso_homComparison_of_retract
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁) (hdin₁ : TensorHomEquivDinatural H₁ T₁ e₁)
    (hnat₂ : TensorHomEquivNaturalLeft H₂ T₂ e₂) (hdin₂ : TensorHomEquivDinatural H₂ T₂ e₂)
    (F : D₁) {A B : D₁} (i : A ⟶ B) (r : B ⟶ A) (hir : i ≫ r = 𝟙 A)
    (hB : IsIso (homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m B F)) :
    IsIso (homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m A F) :=
  Stacks.DerivedCategoryComparisons.isIso_app_of_retract
    (homComparisonNatTrans P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hdin₁ hnat₂ hdin₂ F)
    (X := op A) (Y := op B) ⟨r.op, i.op, by rw [← op_comp, hir, op_id]⟩ hB

end TwoCategoryNaturality

/-! ### The dévissage out of the unit case -/

section Generated

variable {D₁ D₂ : Type*} [Category D₁] [Category D₂]
  (P : D₁ ⥤ D₂) (H₁ : D₁ᵒᵖ ⥤ D₁ ⥤ D₁) (H₂ : D₂ᵒᵖ ⥤ D₂ ⥤ D₂)
  (T₁ : D₁ × D₁ ⥤ D₁) (T₂ : D₂ × D₂ ⥤ D₂)
  (e₁ : ∀ A B C : D₁, (A ⟶ (H₁.obj (op B)).obj C) ≃ (T₁.obj (A, B) ⟶ C))
  (e₂ : ∀ A B C : D₂, (A ⟶ (H₂.obj (op B)).obj C) ≃ (T₂.obj (A, B) ⟶ C))
  (m : T₁ ⋙ P ≅ P.prod P ⋙ T₂)
  (A : D₁) (u₁ : ∀ W : D₁, T₁.obj (W, A) ≅ W) (u₂ : ∀ W : D₂, T₂.obj (W, P.obj A) ≅ W)

variable [HasZeroObject D₁ᵒᵖ] [HasZeroObject D₂] [Preadditive D₁ᵒᵖ] [Preadditive D₂]
  [HasShift D₁ᵒᵖ ℤ] [HasShift D₂ ℤ]
  [∀ n : ℤ, (shiftFunctor D₁ᵒᵖ n).Additive] [∀ n : ℤ, (shiftFunctor D₂ n).Additive]
  [Pretriangulated D₁ᵒᵖ] [Pretriangulated D₂]

/-- The hom-comparison of a functor with internal hom is invertible at every object of the
thick triangulated subcategory generated by a tensor unit `A`, given the naturality of the two
tensor–internal-hom bijections in their source variable, two unitors at `A` and `P A` with their
naturality, the unitality of the monoidality comparison, and a shift-compatible natural
transformation `η` between triangulated functors whose components are the comparison. -/
theorem isIso_homComparison_of_generatedByOp
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁)
    (hnat₂ : TensorHomEquivNaturalLeft H₂ T₂ e₂)
    (hu₁ : ∀ (W W' : D₁) (g : W ⟶ W'),
      T₁.map (g ×ₘ 𝟙 A) ≫ (u₁ W').hom = (u₁ W).hom ≫ g)
    (hu₂ : ∀ (W W' : D₂) (g : W ⟶ W'),
      T₂.map (g ×ₘ 𝟙 (P.obj A)) ≫ (u₂ W').hom = (u₂ W).hom ≫ g)
    (hcoh : ∀ W : D₁, m.hom.app (W, A) ≫ (u₂ (P.obj W)).hom = P.map (u₁ W).hom)
    (F : D₁)
    [(comparisonSourceFunctor P H₁ F).CommShift ℤ]
    [(comparisonTargetFunctor P H₂ F).CommShift ℤ]
    [(comparisonSourceFunctor P H₁ F).IsTriangulated]
    [(comparisonTargetFunctor P H₂ F).IsTriangulated]
    (η : comparisonSourceFunctor P H₁ F ⟶ comparisonTargetFunctor P H₂ F)
    [NatTrans.CommShift η ℤ]
    (hη : ∀ Z : D₁, η.app (op Z) = homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m Z F)
    (E : D₁) (hE : MixedTranspose.GeneratedByOp A E) :
    IsIso (homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m E F) := by
  rw [← hη E]
  refine MixedTranspose.isIso_app_of_generator _ _ η ?_ (fun Pr h₁ h₂ h₃ => hE Pr h₁ h₂ h₃)
  rw [hη A]
  exact isIso_homComparison_of_tensorUnit P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hnat₂ A u₁ u₂ hu₁ hu₂
    hcoh F

/-- The hom-comparison of a functor with internal hom is invertible at every object of the
thick triangulated subcategory generated by a tensor unit, when the two sides are triangulated
functors and `Transpose.homComparisonNatTrans` is compatible with the shifts. -/
theorem isIso_homComparison_of_generatedByOp_natTrans
    (hnat₁ : TensorHomEquivNaturalLeft H₁ T₁ e₁) (hdin₁ : TensorHomEquivDinatural H₁ T₁ e₁)
    (hnat₂ : TensorHomEquivNaturalLeft H₂ T₂ e₂) (hdin₂ : TensorHomEquivDinatural H₂ T₂ e₂)
    (hu₁ : ∀ (W W' : D₁) (g : W ⟶ W'),
      T₁.map (g ×ₘ 𝟙 A) ≫ (u₁ W').hom = (u₁ W).hom ≫ g)
    (hu₂ : ∀ (W W' : D₂) (g : W ⟶ W'),
      T₂.map (g ×ₘ 𝟙 (P.obj A)) ≫ (u₂ W').hom = (u₂ W).hom ≫ g)
    (hcoh : ∀ W : D₁, m.hom.app (W, A) ≫ (u₂ (P.obj W)).hom = P.map (u₁ W).hom)
    (F : D₁)
    [(comparisonSourceFunctor P H₁ F).CommShift ℤ]
    [(comparisonTargetFunctor P H₂ F).CommShift ℤ]
    [(comparisonSourceFunctor P H₁ F).IsTriangulated]
    [(comparisonTargetFunctor P H₂ F).IsTriangulated]
    [NatTrans.CommShift
      (homComparisonNatTrans P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hdin₁ hnat₂ hdin₂ F) ℤ]
    (E : D₁) (hE : MixedTranspose.GeneratedByOp A E) :
    IsIso (homComparison P H₁ H₂ T₁ T₂ e₁ e₂ m E F) :=
  isIso_homComparison_of_generatedByOp P H₁ H₂ T₁ T₂ e₁ e₂ m A u₁ u₂ hnat₁ hnat₂ hu₁ hu₂ hcoh F
    (homComparisonNatTrans P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hdin₁ hnat₂ hdin₂ F)
    (homComparisonNatTrans_app P H₁ H₂ T₁ T₂ e₁ e₂ m hnat₁ hdin₁ hnat₂ hdin₂ F) E hE

end Generated

end Transpose

/-! ### Tag 08I3 on a ringed space, at every `K` generated by the structure sheaf -/

section RingedSpaces

attribute [local instance] HasDerivedCategory.standard

open Stacks.Cohomology.DerivedPullbackTensor in
attribute [local instance] abelianModulesSheafTensor

attribute [local implicit_reducible] structureSheafRing CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf

variable {X Y : RingedSpace.{u, u}} (h : X ⟶ Y)

/-- The canonical map of Tag 08I3 as a natural transformation of its first argument, from
`K ↦ Lh^*R𝓗om_{𝒪_Y}(K, M)` to `K ↦ R𝓗om_{𝒪_X}(Lh^*K, Lh^*M)` on `D(𝒪_Y)ᵒᵖ`. -/
abbrev derivedPullbackSheafHomNatTrans
    (M : DerivedCategory (AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.Modules Y)) :
    Transpose.comparisonSourceFunctor (derivedPullbackFunctor h)
        (Stacks.SheafOfModules.derivedSheafHom Y.sheaf) M ⟶
      Transpose.comparisonTargetFunctor (derivedPullbackFunctor h)
        (Stacks.SheafOfModules.derivedSheafHom X.sheaf) M :=
  Transpose.homComparisonNatTrans (derivedPullbackFunctor h)
    (Stacks.SheafOfModules.derivedSheafHom Y.sheaf)
    (Stacks.SheafOfModules.derivedSheafHom X.sheaf) (internalHomTensorUncurried Y)
    (internalHomTensorUncurried X)
    (fun A B C => (RingedSite.derivedCurryHomEquiv
      (Stacks.SheafOfModules.ringedSite Y.sheaf) A B C).toEquiv)
    (fun A B C => (RingedSite.derivedCurryHomEquiv
      (Stacks.SheafOfModules.ringedSite X.sheaf) A B C).toEquiv)
    (pullbackTensorIso h)
    (tensorHomEquivNaturalLeft_ringedSpace Y) (tensorHomEquivDinatural_ringedSpace Y)
    (tensorHomEquivNaturalLeft_ringedSpace X) (tensorHomEquivDinatural_ringedSpace X) M

/-- The canonical map of Tag 08I3 is invertible at every direct summand of `𝒪_Y[0]`: if
`K ⟶ 𝒪_Y[0] ⟶ K` is the identity in `D(𝒪_Y)` then the canonical map

`Lh^* R𝓗om_{𝒪_Y}(K, M) ⟶ R𝓗om_{𝒪_X}(Lh^*K, Lh^*M)`

is an isomorphism, for an arbitrary morphism of ringed spaces `h` and an arbitrary `M ∈ D(𝒪_Y)`.
-/
theorem isIso_derivedPullbackSheafHomMap_of_retract_singleUnit
    (M : DerivedCategory (AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.Modules Y))
    {K : DerivedCategory (AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.Modules Y)}
    (i : K ⟶ Stacks.Cohomology.DerivedProjectionFormula.singleUnit Y)
    (r : Stacks.Cohomology.DerivedProjectionFormula.singleUnit Y ⟶ K) (hir : i ≫ r = 𝟙 K) :
    IsIso (derivedPullbackSheafHomMap h K M) :=
  Transpose.isIso_homComparison_of_retract (derivedPullbackFunctor h) _ _ _ _ _ _ _
    (tensorHomEquivNaturalLeft_ringedSpace Y) (tensorHomEquivDinatural_ringedSpace Y)
    (tensorHomEquivNaturalLeft_ringedSpace X) (tensorHomEquivDinatural_ringedSpace X) M i r hir
    (isIso_derivedPullbackSheafHomMap_singleUnit h M)

/-- For a morphism of ringed spaces `h : (X, 𝒪_X) ⟶ (Y, 𝒪_Y)` and an arbitrary `M ∈ D(𝒪_Y)`, the
canonical map

`Lh^* R𝓗om_{𝒪_Y}(K, M) ⟶ R𝓗om_{𝒪_X}(Lh^*K, Lh^*M)`

is an isomorphism for every `K` in the strictly full saturated triangulated subcategory of
`D(𝒪_Y)` generated by the structure sheaf placed in degree zero, when the two sides are
triangulated functors of `K` and `derivedPullbackSheafHomNatTrans` is compatible with the
shifts. -/
theorem isIso_derivedPullbackSheafHomMap_of_generatedByOp
    (M : DerivedCategory (AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.Modules Y))
    [(Transpose.comparisonSourceFunctor (derivedPullbackFunctor h)
      (Stacks.SheafOfModules.derivedSheafHom Y.sheaf) M).CommShift ℤ]
    [(Transpose.comparisonTargetFunctor (derivedPullbackFunctor h)
      (Stacks.SheafOfModules.derivedSheafHom X.sheaf) M).CommShift ℤ]
    [(Transpose.comparisonSourceFunctor (derivedPullbackFunctor h)
      (Stacks.SheafOfModules.derivedSheafHom Y.sheaf) M).IsTriangulated]
