module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.ModulesOnACategory.CartesianObjectsTriangulatedSubcategory
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.MixedInternalHomPullbackMap

/-!
# When the mixed comparison `Λ P 𝓗om(A, B) ⟶ 𝓗om(P A, P B)` is an isomorphism

`Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.homComparison` is the canonical map
of Stacks 08I3/08JF in the mixed form, where the internal hom of the target lands one category
further on. Over the abstract data the map is built from, this file shows:

* the unit case, `isIso_homComparison_unit`: the comparison at `A = 𝟙` is an isomorphism, given
  the right unitors of the two tensor products, the naturality of the two tensor–hom bijections in
  their first variable, and the unitality of the monoidality comparison;
* the dévissage, `isIso_app_of_generator`: a shift-compatible natural transformation between
  triangulated functors which is invertible at one object is invertible at every object of the
  thick triangulated subcategory that object generates.

Together, `isIso_homComparison_of_generatedByOp`: the mixed comparison is an isomorphism at every
`E` in the strictly full saturated triangulated subcategory generated by the unit.

## Main definitions

* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.unitSourceHom` and
  `unitTargetHom`: the identifications `𝓗om₁(U, C) ⟶ C` and `𝓗om₂(P U, C) ⟶ Λ C`.
* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.TensorHomEquivNatural`,
  `MixedTensorHomEquivNatural`, `RightUnitorNatural`, `MixedRightUnitorNatural`,
  `MonoidalityUnital`: the naturality and unitality of the data, as properties of the data alone.
* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.GeneratedByOp`: membership in the
  thick triangulated subcategory generated by one object, read in the opposite category.

## Main results

* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.isIso_unitTranspose`: a
  representing object of `Z ↦ (𝜏 Z ⟶ V)` with `𝜏 ≅ id` is isomorphic to `V`.
* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.homComparison_unit_comp`: the
  comparison at `A = U` followed by the target identification is `Λ P` of the source
  identification.
* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.isIso_homComparison_unit`: the
  comparison at `A = U` is an isomorphism.
* `Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose.isIso_app_of_generator`: a
  shift-compatible natural transformation invertible at a generator is invertible on the thick
  triangulated subcategory it generates.
* `isIso_homComparison_of_generatedByOp`, in the same namespace: the comparison is an isomorphism
  at every object generated by the unit.

## References

* [Stacks Project, Tag 08JP](https://stacks.math.columbia.edu/tag/08JP)
* [Stacks Project, Tag 08I3](https://stacks.math.columbia.edu/tag/08I3)
* [Stacks Project, Tag 08JF](https://stacks.math.columbia.edu/tag/08JF)
* [Stacks Project, Tag 08DI](https://stacks.math.columbia.edu/tag/08DI)
* [Stacks Project, Tag 0ATI](https://stacks.math.columbia.edu/tag/0ATI)
* [Stacks Project, Tag 08EB](https://stacks.math.columbia.edu/tag/08EB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite

namespace Stacks.Cohomology.DerivedInternalHomPullback.MixedTranspose

/-! ### A representing object of `Z ↦ (𝜏 Z ⟶ V)` with `𝜏 ≅ id` -/

section UnitTranspose

variable {X : Type*} [Category X] {V W : X}
  (tn : X → X) (tnMap : ∀ Z Z' : X, (Z ⟶ Z') → (tn Z ⟶ tn Z'))
  (rn : ∀ Z : X, tn Z ≅ Z)
  (en : ∀ Z : X, (Z ⟶ W) ≃ (tn Z ⟶ V))

/-- If `W` represents `Z ↦ (𝜏 Z ⟶ V)` and `𝜏` is isomorphic to the identity, then
precomposing with the map `θ : W ⟶ V` obtained by transposing the identity of `W` computes the
bijection: `f ≫ θ` is the transpose of `f`, read through the unitor. -/
theorem comp_unitTranspose
    (hrn : ∀ (Z Z' : X) (f : Z ⟶ Z'), tnMap Z Z' f ≫ (rn Z').hom = (rn Z).hom ≫ f)
    (hen : ∀ (Z Z' : X) (f : Z ⟶ Z') (g : Z' ⟶ W),
      en Z (f ≫ g) = tnMap Z Z' f ≫ en Z' g)
    (Z : X) (f : Z ⟶ W) :
    f ≫ ((rn W).inv ≫ en W (𝟙 W)) = (rn Z).inv ≫ en Z f := by
  have h₂ : (rn Z).inv ≫ tnMap Z W f = f ≫ (rn W).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
    exact hrn Z W f
  rw [← Category.assoc, ← h₂, Category.assoc, ← hen Z W f (𝟙 W), Category.comp_id]

/-- A representing object `W` of `Z ↦ (𝜏 Z ⟶ V)` with `𝜏 ≅ id` is isomorphic to `V`, by the
transpose of the identity of `W`, read through the unitor. -/
theorem isIso_unitTranspose
    (hrn : ∀ (Z Z' : X) (f : Z ⟶ Z'), tnMap Z Z' f ≫ (rn Z').hom = (rn Z).hom ≫ f)
    (hen : ∀ (Z Z' : X) (f : Z ⟶ Z') (g : Z' ⟶ W),
      en Z (f ≫ g) = tnMap Z Z' f ≫ en Z' g) :
    IsIso ((rn W).inv ≫ en W (𝟙 W)) := by
  have key := comp_unitTranspose tn tnMap rn en hrn hen
  have hgθ : ((en V).symm (rn V).hom) ≫ ((rn W).inv ≫ en W (𝟙 W)) = 𝟙 V := by
    rw [key V ((en V).symm (rn V).hom), Equiv.apply_symm_apply, Iso.inv_hom_id]
  refine ⟨⟨(en V).symm (rn V).hom, ?_, hgθ⟩⟩
  have hinj : ∀ f₁ f₂ : W ⟶ W, f₁ ≫ ((rn W).inv ≫ en W (𝟙 W)) =
      f₂ ≫ ((rn W).inv ≫ en W (𝟙 W)) → f₁ = f₂ := by
    intro f₁ f₂ h
    rw [key W f₁, key W f₂] at h
    exact (en W).injective ((Iso.cancel_iso_inv_left (rn W) _ _).mp h)
  refine hinj _ _ ?_
  rw [Category.assoc, hgθ, Category.comp_id, Category.id_comp]

end UnitTranspose

/-! ### The naturality and unitality of the data -/

section Data

/-- The tensor–hom bijection `e₁` of the source is natural in its first variable. -/
def TensorHomEquivNatural {D₁ : Type*} [Category D₁] (H₁ : D₁ᵒᵖ ⥤ D₁ ⥤ D₁) (T₁ : D₁ × D₁ ⥤ D₁)
    (e₁ : ∀ A B C : D₁, (A ⟶ (H₁.obj (op B)).obj C) ≃ (T₁.obj (A, B) ⟶ C)) : Prop :=
  ∀ (B C Z Z' : D₁) (f : Z ⟶ Z') (g : Z' ⟶ (H₁.obj (op B)).obj C),
    e₁ Z B C (f ≫ g) = T₁.map (Prod.mkHom f (𝟙 B)) ≫ e₁ Z' B C g

/-- The mixed tensor–hom bijection `e₂` of the target is natural in its first variable, the
variable that lives in the further category `D₂'`. -/
def MixedTensorHomEquivNatural {D₂ D₂' : Type*} [Category D₂] [Category D₂'] (Λ : D₂ ⥤ D₂')
    (H₂ : D₂ᵒᵖ ⥤ D₂ ⥤ D₂') (T₂ : D₂' × D₂ ⥤ D₂')
    (e₂ : ∀ (A : D₂') (B C : D₂), (A ⟶ (H₂.obj (op B)).obj C) ≃ (T₂.obj (A, B) ⟶ Λ.obj C)) :
    Prop :=
  ∀ (B C : D₂) (Z Z' : D₂') (f : Z ⟶ Z') (g : Z' ⟶ (H₂.obj (op B)).obj C),
    e₂ Z B C (f ≫ g) = T₂.map (Prod.mkHom f (𝟙 B)) ≫ e₂ Z' B C g

/-- `U` is a right unit for the source tensor product, naturally: the isomorphisms `r₁` make
`T₁(·, U)` isomorphic to the identity functor. -/
def RightUnitorNatural {D₁ : Type*} [Category D₁] (T₁ : D₁ × D₁ ⥤ D₁) (U : D₁)
    (r₁ : ∀ Z : D₁, T₁.obj (Z, U) ≅ Z) : Prop :=
  ∀ (Z Z' : D₁) (f : Z ⟶ Z'),
    T₁.map (Prod.mkHom f (𝟙 U)) ≫ (r₁ Z').hom = (r₁ Z).hom ≫ f

/-- `P U` is a right unit for the target tensor product, naturally: the isomorphisms `r₂` make
`T₂(·, P U)` isomorphic to the identity functor. -/
def MixedRightUnitorNatural {D₁ D₂ D₂' : Type*} [Category D₁] [Category D₂] [Category D₂']
    (P : D₁ ⥤ D₂) (T₂ : D₂' × D₂ ⥤ D₂') (U : D₁)
    (r₂ : ∀ Z : D₂', T₂.obj (Z, P.obj U) ≅ Z) : Prop :=
  ∀ (Z Z' : D₂') (f : Z ⟶ Z'),
    T₂.map (Prod.mkHom f (𝟙 (P.obj U))) ≫ (r₂ Z').hom = (r₂ Z).hom ≫ f

/-- The monoidality comparison is unital: the comparison `Λ P T₁(Z, U) ≅ T₂(Λ P Z, P U)`
carries the right unitor of the source to the right unitor of the target. -/
def MonoidalityUnital {D₁ D₂ D₂' : Type*} [Category D₁] [Category D₂] [Category D₂']
    (P : D₁ ⥤ D₂) (Λ : D₂ ⥤ D₂') (T₁ : D₁ × D₁ ⥤ D₁) (T₂ : D₂' × D₂ ⥤ D₂')
    (m : T₁ ⋙ P ⋙ Λ ≅ (P ⋙ Λ).prod P ⋙ T₂) (U : D₁)
    (r₁ : ∀ Z : D₁, T₁.obj (Z, U) ≅ Z) (r₂ : ∀ Z : D₂', T₂.obj (Z, P.obj U) ≅ Z) : Prop :=
  ∀ Z : D₁, m.hom.app (Z, U) ≫ (r₂ (Λ.obj (P.obj Z))).hom = Λ.map (P.map (r₁ Z).hom)

end Data

/-! ### The two sides of the comparison at the unit -/

section Unit

variable {D₁ D₂ D₂' : Type*} [Category D₁] [Category D₂] [Category D₂']
  (P : D₁ ⥤ D₂) (Λ : D₂ ⥤ D₂')
  (H₁ : D₁ᵒᵖ ⥤ D₁ ⥤ D₁) (H₂ : D₂ᵒᵖ ⥤ D₂ ⥤ D₂')
  (T₁ : D₁ × D₁ ⥤ D₁) (T₂ : D₂' × D₂ ⥤ D₂')
  (e₁ : ∀ A B C : D₁, (A ⟶ (H₁.obj (op B)).obj C) ≃ (T₁.obj (A, B) ⟶ C))
  (e₂ : ∀ (A : D₂') (B C : D₂), (A ⟶ (H₂.obj (op B)).obj C) ≃ (T₂.obj (A, B) ⟶ Λ.obj C))
  (m : T₁ ⋙ P ⋙ Λ ≅ (P ⋙ Λ).prod P ⋙ T₂)
  (U : D₁) (r₁ : ∀ Z : D₁, T₁.obj (Z, U) ≅ Z) (r₂ : ∀ Z : D₂', T₂.obj (Z, P.obj U) ≅ Z)

/-- The identification `𝓗om₁(U, C) ⟶ C`: the evaluation of the source internal hom at the
unit, read through the right unitor. -/
def unitSourceHom (C : D₁) : (H₁.obj (op U)).obj C ⟶ C :=
  (r₁ ((H₁.obj (op U)).obj C)).inv ≫ Transpose.evaluation H₁ T₁ e₁ U C

/-- The identification `𝓗om₂(P U, C) ⟶ Λ C`: the evaluation of the target internal hom at the
image of the unit, read through the right unitor of the target. -/
def unitTargetHom (C : D₂) : (H₂.obj (op (P.obj U))).obj C ⟶ Λ.obj C :=
  (r₂ ((H₂.obj (op (P.obj U))).obj C)).inv ≫
    e₂ ((H₂.obj (op (P.obj U))).obj C) (P.obj U) C (𝟙 _)

/-- The identification `unitSourceHom : 𝓗om₁(U, C) ⟶ C` is an isomorphism. -/
theorem isIso_unitSourceHom (hn : TensorHomEquivNatural H₁ T₁ e₁)
    (hr : RightUnitorNatural T₁ U r₁) (C : D₁) :
    IsIso (unitSourceHom H₁ T₁ e₁ U r₁ C) :=
  isIso_unitTranspose (fun Z ↦ T₁.obj (Z, U))
    (fun _ _ f ↦ T₁.map (Prod.mkHom f (𝟙 U))) r₁ (fun Z ↦ e₁ Z U C) hr
    (fun Z Z' f g ↦ hn U C Z Z' f g)

/-- The identification `unitTargetHom : 𝓗om₂(P U, C) ⟶ Λ C` is an isomorphism. -/
theorem isIso_unitTargetHom (hn : MixedTensorHomEquivNatural Λ H₂ T₂ e₂)
    (hr : MixedRightUnitorNatural P T₂ U r₂) (C : D₂) :
    IsIso (unitTargetHom P Λ H₂ T₂ e₂ U r₂ C) :=
  isIso_unitTranspose (fun Z ↦ T₂.obj (Z, P.obj U))
    (fun _ _ f ↦ T₂.map (Prod.mkHom f (𝟙 (P.obj U)))) r₂
    (fun Z ↦ e₂ Z (P.obj U) C) hr (fun Z Z' f g ↦ hn (P.obj U) C Z Z' f g)

/-- The monoidality comparison at the unit, inverted: the inverse right unitor of the target
followed by the inverse comparison is `Λ P` of the inverse right unitor of the source. -/
theorem monoidality_unital_inv (hm : MonoidalityUnital P Λ T₁ T₂ m U r₁ r₂) (Z : D₁) :
    (r₂ (Λ.obj (P.obj Z))).inv ≫ m.inv.app (Z, U) = Λ.map (P.map (r₁ Z).inv) := by
  rw [← cancel_mono (Λ.map (P.map (r₁ Z).hom)), ← Λ.map_comp, ← P.map_comp, Iso.inv_hom_id,
    P.map_id, Λ.map_id, ← hm Z, Category.assoc, Iso.inv_hom_id_app_assoc, Iso.inv_hom_id]

/-- The comparison at the unit, followed by the target identification `unitTargetHom`, is `Λ P` of
the source identification `unitSourceHom`. -/
theorem homComparison_unit_comp (hn₂ : MixedTensorHomEquivNatural Λ H₂ T₂ e₂)
    (hr₂ : MixedRightUnitorNatural P T₂ U r₂) (hm : MonoidalityUnital P Λ T₁ T₂ m U r₁ r₂)
    (F : D₁) :
    homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F ≫
        unitTargetHom P Λ H₂ T₂ e₂ U r₂ (P.obj F) =
      Λ.map (P.map (unitSourceHom H₁ T₁ e₁ U r₁ F)) := by
  calc homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F ≫
        unitTargetHom P Λ H₂ T₂ e₂ U r₂ (P.obj F)
      = (r₂ (Λ.obj (P.obj ((H₁.obj (op U)).obj F)))).inv ≫
          e₂ (Λ.obj (P.obj ((H₁.obj (op U)).obj F))) (P.obj U) (P.obj F)
            (homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F) :=
        comp_unitTranspose (fun Z ↦ T₂.obj (Z, P.obj U))
          (fun _ _ f ↦ T₂.map (Prod.mkHom f (𝟙 (P.obj U)))) r₂
          (fun Z ↦ e₂ Z (P.obj U) (P.obj F)) hr₂
          (fun Z Z' f g ↦ hn₂ (P.obj U) (P.obj F) Z Z' f g) _
          (homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F)
    _ = (r₂ (Λ.obj (P.obj ((H₁.obj (op U)).obj F)))).inv ≫
          homComparisonDatum P Λ H₁ T₁ T₂ e₁ m U F := by
        rw [homComparison_adjoint P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F]
    _ = ((r₂ (Λ.obj (P.obj ((H₁.obj (op U)).obj F)))).inv ≫
          m.inv.app ((H₁.obj (op U)).obj F, U)) ≫
            Λ.map (P.map (Transpose.evaluation H₁ T₁ e₁ U F)) := by
        rw [homComparisonDatum, Category.assoc]
    _ = Λ.map (P.map (r₁ ((H₁.obj (op U)).obj F)).inv) ≫
          Λ.map (P.map (Transpose.evaluation H₁ T₁ e₁ U F)) := by
        rw [monoidality_unital_inv P Λ T₁ T₂ m U r₁ r₂ hm]
    _ = Λ.map (P.map (unitSourceHom H₁ T₁ e₁ U r₁ F)) := by
        rw [unitSourceHom, P.map_comp, Λ.map_comp]

/-- The mixed comparison at `A = U` is an isomorphism. -/
theorem isIso_homComparison_unit (hn₁ : TensorHomEquivNatural H₁ T₁ e₁)
    (hr₁ : RightUnitorNatural T₁ U r₁) (hn₂ : MixedTensorHomEquivNatural Λ H₂ T₂ e₂)
    (hr₂ : MixedRightUnitorNatural P T₂ U r₂) (hm : MonoidalityUnital P Λ T₁ T₂ m U r₁ r₂)
    (F : D₁) :
    IsIso (homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F) := by
  have := isIso_unitTargetHom P Λ H₂ T₂ e₂ U r₂ hn₂ hr₂ (P.obj F)
  have := isIso_unitSourceHom H₁ T₁ e₁ U r₁ hn₁ hr₁ F
  have : IsIso (homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U F ≫
      unitTargetHom P Λ H₂ T₂ e₂ U r₂ (P.obj F)) := by
    rw [homComparison_unit_comp P Λ H₁ H₂ T₁ T₂ e₁ e₂ m U r₁ r₂ hn₂ hr₂ hm F]
    infer_instance
  exact IsIso.of_isIso_comp_right _ (unitTargetHom P Λ H₂ T₂ e₂ U r₂ (P.obj F))

end Unit

/-! ### The dévissage -/

section Devissage

variable {A E : Type*} [Category A] [Category E]
  [HasZeroObject A] [HasZeroObject E] [Preadditive A] [Preadditive E]
  [HasShift A ℤ] [HasShift E ℤ]
  [∀ n : ℤ, (shiftFunctor A n).Additive] [∀ n : ℤ, (shiftFunctor E n).Additive]
  [Pretriangulated A] [Pretriangulated E]

/-- A shift-compatible natural transformation between triangulated functors which is invertible
at `X₀` is invertible at every object of the thick triangulated subcategory `X₀` generates. -/
theorem isIso_app_of_generator (F G : A ⥤ E) [F.CommShift ℤ] [G.CommShift ℤ]
    [F.IsTriangulated] [G.IsTriangulated] (η : F ⟶ G) [NatTrans.CommShift η ℤ]
    {X₀ X : A} (h₀ : IsIso (η.app X₀))
    (hX : ∀ Pr : ObjectProperty A, ObjectProperty.IsClosedUnderIsomorphisms Pr →
      ObjectProperty.IsStableUnderRetracts Pr → ObjectProperty.IsTriangulated Pr →
      Pr X₀ → Pr X) :
    IsIso (η.app X) :=
  hX (fun Y ↦ IsIso (η.app Y))
    (Stacks.DerivedCategoryComparisons.isIso_app_isClosedUnderIsomorphisms η)
    ⟨fun r h ↦ Stacks.DerivedCategoryComparisons.isIso_app_of_retract η r h⟩
    (Stacks.DerivedCategoryComparisons.isIso_app_isTriangulated F G η) h₀

end Devissage

/-! ### The comparison is an isomorphism at every object generated by the unit -/

section Generated

variable {D₁ D₂ D₂' : Type*} [Category D₁] [Category D₂] [Category D₂']
  (P : D₁ ⥤ D₂) (Λ : D₂ ⥤ D₂')
  (H₁ : D₁ᵒᵖ ⥤ D₁ ⥤ D₁) (H₂ : D₂ᵒᵖ ⥤ D₂ ⥤ D₂')
  (T₁ : D₁ × D₁ ⥤ D₁) (T₂ : D₂' × D₂ ⥤ D₂')
  (e₁ : ∀ A B C : D₁, (A ⟶ (H₁.obj (op B)).obj C) ≃ (T₁.obj (A, B) ⟶ C))
  (e₂ : ∀ (A : D₂') (B C : D₂), (A ⟶ (H₂.obj (op B)).obj C) ≃ (T₂.obj (A, B) ⟶ Λ.obj C))
  (m : T₁ ⋙ P ⋙ Λ ≅ (P ⋙ Λ).prod P ⋙ T₂)
  (U : D₁) (r₁ : ∀ Z : D₁, T₁.obj (Z, U) ≅ Z) (r₂ : ∀ Z : D₂', T₂.obj (Z, P.obj U) ≅ Z)

variable [HasZeroObject D₁ᵒᵖ] [HasZeroObject D₂'] [Preadditive D₁ᵒᵖ] [Preadditive D₂']
  [HasShift D₁ᵒᵖ ℤ] [HasShift D₂' ℤ]
  [∀ n : ℤ, (shiftFunctor D₁ᵒᵖ n).Additive] [∀ n : ℤ, (shiftFunctor D₂' n).Additive]
  [Pretriangulated D₁ᵒᵖ] [Pretriangulated D₂']

/-- `E` lies in the thick triangulated subcategory generated by `U`, read in `D₁ᵒᵖ`: every
property of the objects of `D₁ᵒᵖ` which is closed under isomorphisms and retracts, is
triangulated, and holds at `U` holds at `E`. -/
def GeneratedByOp (U E : D₁) : Prop :=
  ∀ Pr : ObjectProperty D₁ᵒᵖ, ObjectProperty.IsClosedUnderIsomorphisms Pr →
    ObjectProperty.IsStableUnderRetracts Pr → ObjectProperty.IsTriangulated Pr →
    Pr (op U) → Pr (op E)

/-- The left-hand side of the comparison as a functor of its first argument,
`E ↦ Λ P 𝓗om₁(E, F)` on `D₁ᵒᵖ`. -/
def comparisonSourceFunctor (F : D₁) : D₁ᵒᵖ ⥤ D₂' := H₁.flip.obj F ⋙ P ⋙ Λ

/-- The right-hand side of the comparison as a functor of its first argument,
`E ↦ 𝓗om₂(P E, P F)` on `D₁ᵒᵖ`. -/
def comparisonTargetFunctor (F : D₁) : D₁ᵒᵖ ⥤ D₂' := P.op ⋙ H₂.flip.obj (P.obj F)

/-- The mixed comparison of Stacks 08I3/08JF is an isomorphism at every object `E` generated by
the unit, given the naturality of the two tensor–hom bijections in their first variable, the two
right unitors with their naturality, the unitality of the monoidality comparison, and a
shift-compatible natural transformation `η` between triangulated functors whose components are
the comparison. -/
theorem isIso_homComparison_of_generatedByOp
    (hn₁ : TensorHomEquivNatural H₁ T₁ e₁) (hr₁ : RightUnitorNatural T₁ U r₁)
    (hn₂ : MixedTensorHomEquivNatural Λ H₂ T₂ e₂)
    (hr₂ : MixedRightUnitorNatural P T₂ U r₂) (hm : MonoidalityUnital P Λ T₁ T₂ m U r₁ r₂)
    (F : D₁) [(comparisonSourceFunctor P Λ H₁ F).CommShift ℤ]
    [(comparisonTargetFunctor P H₂ F).CommShift ℤ]
    [(comparisonSourceFunctor P Λ H₁ F).IsTriangulated]
    [(comparisonTargetFunctor P H₂ F).IsTriangulated]
    (η : comparisonSourceFunctor P Λ H₁ F ⟶ comparisonTargetFunctor P H₂ F)
    [NatTrans.CommShift η ℤ]
    (hη : ∀ Z : D₁, η.app (op Z) = homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m Z F)
    (E : D₁) (hE : GeneratedByOp U E) :
    IsIso (homComparison P Λ H₁ H₂ T₁ T₂ e₁ e₂ m E F) := by
  rw [← hη E]
  refine isIso_app_of_generator _ _ η ?_ hE
  rw [hη U]
