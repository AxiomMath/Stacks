module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.DerivedTensor.ProjectionFormulaPerfect
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.ProjectionFormulaShiftedUnit
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.ProjectionFormulaDevissage
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.ProjectionFormulaStrictlyPerfect
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.ProjectionFormulaDevissageSupplement
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPushforward.ProjectionFormulaShiftedUnitSupplement

/-!
# The projection formula from the shifted unitor coherence

Let `f : X ⟶ Y` be a morphism of ringed spaces and `E ∈ D(𝒪_X)`. This file shows that the
projection-formula morphism `Rf_*E ⊗^𝐋_{𝒪_Y} K ⟶ Rf_*(E ⊗^𝐋_{𝒪_X} Lf^*K)` of
[Stacks, Tag 0B53] is an isomorphism ([Stacks, Tag 08EU])

* when `K` is a strictly perfect complex of `𝒪_Y`-modules, and
* for every `K`, provided both sides preserve coproducts ([Stacks, Tag 08DZ]), `D(𝒪_Y)` is
  generated by the translates of its structure sheaf in the sense of [Stacks, Tag 09PB], and the
  comparison of [Stacks, Tag 079U] is coherent with the translated unitors in every degree.

The statement at strictly perfect complexes also takes the coherence hypothesis, which it does
not use.

## Main results

* `isIso_projectionFormulaMap_isStrictlyPerfect_of_coherence`: the projection-formula morphism is
  an isomorphism at every strictly perfect complex.
* `isIso_projectionFormulaMap_of_generation_of_coherence`: the projection-formula morphism is an
  isomorphism at every complex, given that both sides preserve coproducts, that `D(𝒪_Y)` is
  generated by the translates of its structure sheaf, and the shifted unitor coherence.

## References

* [Stacks Project, Tag 08EU](https://stacks.math.columbia.edu/tag/08EU)
* [Stacks Project, Tag 0B53](https://stacks.math.columbia.edu/tag/0B53)
* [Stacks Project, Tag 079U](https://stacks.math.columbia.edu/tag/079U)
* [Stacks Project, Tag 08DZ](https://stacks.math.columbia.edu/tag/08DZ)
* [Stacks Project, Tag 09PB](https://stacks.math.columbia.edu/tag/09PB)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open TopologicalSpace
open RingedSpaceModuleAdjunction StrictlyPerfect
open Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces
open Stacks.DerivedTensor.RingedSite

open scoped CategoryTheory.Prod

universe u

namespace Stacks.Cohomology.DerivedProjectionFormula

variable {X Y : RingedSpace.{u, u}} (f : X ⟶ Y)

attribute [local instance] HasDerivedCategory.standard

variable [HasSheafify (Opens.grothendieckTopology X.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasSheafify (Opens.grothendieckTopology Y.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology Y.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **[Stacks, Tag 08EU] at every strictly perfect target complex, carrying one equation.**  For
an arbitrary morphism of ringed spaces `f : X ⟶ Y`, an arbitrary `E` in `D(𝒪_X)` and a strictly
perfect complex `P` of `𝒪_Y`-modules, the projection-formula morphism

`Rf_*E ⊗^𝐋_{𝒪_Y} QP ⟶ Rf_*(E ⊗^𝐋_{𝒪_X} Lf^*QP)`

of [Stacks, Tag 0B53] is an isomorphism, provided the comparison of [Stacks, Tag 079U] is
coherent for the translated unitors
`Stacks.RingedSpace.derivedTensorShiftedUnitorNatIso` and the unit comparisons
`Stacks.RingedSpace.derivedPullbackShiftedUnitIso`, in every degree `a`. The coherence
hypothesis `_hcoh` is not needed for the conclusion. -/
theorem isIso_projectionFormulaMap_isStrictlyPerfect_of_coherence
    (E : DerivedCategory (SheafOfModules.{u} (structureSheafRing X)))
    (_hcoh : ∀ (a : ℤ) (Z : DerivedCategory (SheafOfModules.{u} (structureSheafRing Y))),
      (pullbackTensorComparison f).app (Z, Stacks.RingedSpace.shiftedUnitObject Y a) ≫
          (Functor.uncurry.obj (derivedTensorProductFunctor X.sheaf)).map
            ((𝟙 ((derivedPullback f).obj Z) ×ₘ
                (Stacks.RingedSpace.derivedPullbackShiftedUnitIso f a).hom) :
              (((derivedPullback f).obj Z,
                  (derivedPullback f).obj (Stacks.RingedSpace.shiftedUnitObject Y a)) : _ × _) ⟶
                ((derivedPullback f).obj Z, Stacks.RingedSpace.shiftedUnitObject X a)) ≫
            ((Stacks.RingedSpace.derivedTensorShiftedUnitorNatIso X a).app
              ((derivedPullback f).obj Z)).hom =
        (derivedPullback f).map
            ((Stacks.RingedSpace.derivedTensorShiftedUnitorNatIso Y a).app Z).hom ≫
          (((derivedPullback f).commShiftIso (-a)).hom.app Z))
    (P : CochainComplex (OXMod.{u, u} Y) ℤ) (hP : IsStrictlyPerfect P) :
    IsIso (projectionFormulaMap f E (DerivedCategory.Q.obj P)) :=
  ProjectionFormulaPerfect.isIso_projectionFormulaMap_of_isStrictlyPerfect f E P hP

/-- **[Stacks, Tag 08EU] at a general target complex.**  For a morphism of ringed spaces
`f : X ⟶ Y` and `E` in `D(𝒪_X)` such that both sides of the projection formula preserve
coproducts, if `D(𝒪_Y)` is generated by the translates of its structure sheaf in the sense of
`hgen` ([Stacks, Tag 09PB]) and the comparison of [Stacks, Tag 079U] is coherent for the
translated unitors in every degree, then the projection-formula morphism
`Rf_*E ⊗^𝐋_{𝒪_Y} K ⟶ Rf_*(E ⊗^𝐋_{𝒪_X} Lf^*K)` is an isomorphism at every `K` in `D(𝒪_Y)`. -/
theorem isIso_projectionFormulaMap_of_generation_of_coherence
    (E : DerivedCategory (SheafOfModules.{u} (structureSheafRing X)))
    [∀ J : Type u, PreservesColimitsOfShape (Discrete J)
      (ProjectionFormulaPerfect.projectionFormulaSource f E)]
    [∀ J : Type u, PreservesColimitsOfShape (Discrete J)
      (ProjectionFormulaPerfect.projectionFormulaTarget f E)]
    (hgen : ∀ T : DerivedCategory (SheafOfModules.{u} (structureSheafRing Y)) → Prop,
      (∀ {J : Type u} (Z : J → DerivedCategory (SheafOfModules.{u} (structureSheafRing Y)))
        [HasCoproduct Z], (∀ j, T (Z j)) → T (∐ Z)) →
      (∀ Δ : Triangle (DerivedCategory (SheafOfModules.{u} (structureSheafRing Y))),
        Δ ∈ distTriang (DerivedCategory (SheafOfModules.{u} (structureSheafRing Y))) →
        (T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃) ∧ (T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂) ∧
          (T Δ.obj₂ → T Δ.obj₃ → T Δ.obj₁)) →
      (∀ k : ℤ, T ((ProjectionFormulaPerfectDevissage.singleUnit Y.sheaf 0)⟦k⟧)) → ∀ K, T K)
    (hcoh : ∀ (a : ℤ) (Z : DerivedCategory (SheafOfModules.{u} (structureSheafRing Y))),
      (pullbackTensorComparison f).app (Z, Stacks.RingedSpace.shiftedUnitObject Y a) ≫
          (Functor.uncurry.obj (derivedTensorProductFunctor X.sheaf)).map
            ((𝟙 ((derivedPullback f).obj Z) ×ₘ
                (Stacks.RingedSpace.derivedPullbackShiftedUnitIso f a).hom) :
              (((derivedPullback f).obj Z,
                  (derivedPullback f).obj (Stacks.RingedSpace.shiftedUnitObject Y a)) : _ × _) ⟶
                ((derivedPullback f).obj Z, Stacks.RingedSpace.shiftedUnitObject X a)) ≫
            ((Stacks.RingedSpace.derivedTensorShiftedUnitorNatIso X a).app
              ((derivedPullback f).obj Z)).hom =
        (derivedPullback f).map
            ((Stacks.RingedSpace.derivedTensorShiftedUnitorNatIso Y a).app Z).hom ≫
          (((derivedPullback f).commShiftIso (-a)).hom.app Z))
    (K : DerivedCategory (SheafOfModules.{u} (structureSheafRing Y))) :
    IsIso (projectionFormulaMap f E K) :=
  DerivedProjectionFormulaDevissage.isIso_projectionFormulaMap_of_generation f E hgen
    (fun j => isIso_projectionFormulaMap_shiftedUnitObject f j (hcoh j) E) K

end Stacks.Cohomology.DerivedProjectionFormula

end
