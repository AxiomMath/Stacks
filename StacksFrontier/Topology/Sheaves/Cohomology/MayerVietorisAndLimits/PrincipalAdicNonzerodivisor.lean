module

public import Mathlib.RingTheory.Regular.IsSMulRegular
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Sheaves.Modules.PrincipalAdicInverseSystem

/-!
# A nonzerodivisor on the limit of a principal-adic inverse system

In the principal-adic inverse-system situation of Stacks 0BLB — a Noetherian ring `A`
complete for the ideal generated by an element `f`, together with an inverse system of
sheaves of modules satisfying condition (1) of Stacks 0H39 for multiplication by `f` — the
element `f` acts injectively on the inverse limit `M` of the modules of global sections.

## Main results

* `Stacks.Modules.PrincipalAdicInverseSystem.isSMulRegular_limit`: the distinguished element
  of a principal-adic inverse system is a nonzerodivisor on the limit of its global
  sections.

## References

* [Stacks Project, Tag 0BLB](https://stacks.math.columbia.edu/tag/0BLB)
* [Stacks Project, Tag 0H39](https://stacks.math.columbia.edu/tag/0H39)
-/

@[expose] public noncomputable section

open CategoryTheory Limits Opposite TopologicalSpace
open scoped IsMulCommutative

universe u w

namespace Stacks.Modules.PrincipalAdicInverseSystem

/-- The distinguished element of a principal-adic inverse system is a nonzerodivisor on the
limit of its global sections. -/
@[stacks 0BLB "nonzerodivisor"]
lemma isSMulRegular_limit (S : PrincipalAdicInverseSystem.{u, w}) :
    IsSMulRegular S.M S.f := by
  refine IsSMulRegular.of_right_eq_zero_of_smul fun x hx ↦ ?_
  let E := SheafOfModules.evaluation S.R (op (⊤ : Opens S.X))
  let Q := ModuleCat.restrictScalars.{u} S.scalarMap
  let F := S.globalSectionsSystem
  let q (n : ℕ) : S.M ⟶ F.obj (op n) := limit.π F (op n)
  have hobj (n : ℕ) : F.obj (op n) = Q.obj (E.obj (S.F n)) := rfl
  let qcoord (n : ℕ) : Q.obj (E.obj (S.F n)) := (q n).hom x
  have hcoord (n : ℕ) : (q n).hom x = 0 := by
    cases hobj n
    cases hobj (n + 1)
    let : ∀ U, IsMulCommutative (S.R.obj.obj U) := S.mulCommutative
    obtain ⟨ι, w, hfactor, hshort⟩ := S.condition n
    let ιA := Q.map (E.map ι)
    let tmap := Q.map (E.map (S.map n))
    have : Mono ι := hshort.mono_f
    have hιinj : Function.Injective ιA.hom :=
      (ModuleCat.mono_iff_injective ιA).mp (by dsimp [ιA, Q]; infer_instance)
    have hfactorEval : E.map (S.map n) ≫ E.map ι =
        ModuleCat.ofHom (LinearMap.lsmul (S.R.obj.obj (op (⊤ : Opens S.X)))
          (E.obj (S.F (n + 1))) (S.scalarMap S.f)) := by
      apply ModuleCat.hom_ext
      ext y
      change (S.F (n + 1)).val.obj (op (⊤ : Opens S.X)) at y
      show (E.map ι).hom ((E.map (S.map n)).hom y) = (S.scalarMap S.f) • y
      have heval := congrArg (fun g ↦ (E.map g).hom y) hfactor
      change (E.map ι).hom ((E.map (S.map n)).hom y) =
        ((Stacks.SheafOfModules.terminalSectionToEnd S.R (⊤ : Opens S.X)
          isTerminalTop (S.scalarMap S.f)).asHom.app (S.F (n + 1))).val.app
            (op (⊤ : Opens S.X)) y at heval
      have hfrom : isTerminalTop.from (⊤ : Opens S.X) = 𝟙 _ :=
        isTerminalTop.hom_ext _ _
      have hterm :
          ((Stacks.SheafOfModules.terminalSectionToEnd S.R (⊤ : Opens S.X)
            isTerminalTop (S.scalarMap S.f)).asHom.app (S.F (n + 1))).val.app
              (op (⊤ : Opens S.X)) y = S.scalarMap S.f • y := by
        rw [Stacks.SheafOfModules.terminalSectionToEnd_apply, hfrom]
        simp
      rwa [hterm] at heval
    have hfactorA : tmap ≫ ιA =
        ModuleCat.ofHom (LinearMap.lsmul S.A (Q.obj (E.obj (S.F (n + 1)))) S.f) := by
      calc
        tmap ≫ ιA = Q.map (E.map (S.map n) ≫ E.map ι) := by
          simp [tmap, ιA]
        _ = Q.map (ModuleCat.ofHom (LinearMap.lsmul
              (S.R.obj.obj (op (⊤ : Opens S.X))) (E.obj (S.F (n + 1)))
              (S.scalarMap S.f))) := congrArg Q.map hfactorEval
        _ = ModuleCat.ofHom (LinearMap.lsmul S.A
              (Q.obj (E.obj (S.F (n + 1)))) S.f) := by
          apply ModuleCat.hom_ext
          ext y
          rfl
    have hfactorCoord (y : Q.obj (E.obj (S.F (n + 1)))) :
        ιA.hom (tmap.hom y) = S.f • y := by
      have h := congrArg (fun g ↦ g.hom y) hfactorA
      rw [ModuleCat.hom_comp, LinearMap.comp_apply] at h
      simpa using h
    have htrans : tmap.hom ((q (n + 1)).hom x) = (q n).hom x := by
      have hw := limit.w F (homOfLE (Nat.le_succ n)).op
      dsimp [F, globalSectionsSystem] at hw
      rw [Functor.ofOpSequence_map_homOfLE_succ] at hw
      exact congrArg (fun g ↦ g.hom x) hw
    have hxcoord : S.f • (q (n + 1)).hom x = 0 := by
      rw [← (q (n + 1)).hom.map_smul, hx, map_zero]
    apply hιinj
    show ιA.hom (qcoord n) = ιA.hom 0
    dsimp only [qcoord]
    rw [← htrans]
    show ιA.hom (tmap.hom (qcoord (n + 1))) = ιA.hom 0
    rw [hfactorCoord]
    have hxcoordA : S.f • qcoord (n + 1) = 0 := hxcoord
    rw [hxcoordA, map_zero]
  let N : Submodule S.A S.M := Submodule.span S.A {x}
  let incl : ModuleCat.of S.A N ⟶ S.M := ModuleCat.ofHom N.subtype
  have hincl : incl = 0 := by
    refine limit.hom_ext fun n ↦ ?_
    have hker : N ≤ LinearMap.ker (limit.π S.globalSectionsSystem n).hom :=
      Submodule.span_le.2 fun y hy ↦ by
        rw [Set.mem_singleton_iff.mp hy]
        exact hcoord n.unop
    apply ModuleCat.hom_ext
    ext y
    rw [ModuleCat.hom_comp, LinearMap.comp_apply]
    show (limit.π S.globalSectionsSystem n).hom y.val =
      (limit.π S.globalSectionsSystem n).hom 0
    rw [map_zero]
    exact LinearMap.mem_ker.mp (hker y.property)
  have hx0 : incl.hom ⟨x, Submodule.subset_span rfl⟩ = 0 := by
    simpa using
      congrArg (fun g : ModuleCat.of S.A N ⟶ S.M ↦ g.hom ⟨x, Submodule.subset_span rfl⟩) hincl
  exact hx0

end Stacks.Modules.PrincipalAdicInverseSystem

end
