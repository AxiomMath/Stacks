module

public import StacksFrontier.RingTheory.LocalCohomology.ComplementCohomology
public import StacksFrontier.RingTheory.LocalCohomology.HigherDegree.CechModelComparison
public import StacksFrontier.RingTheory.LocalCohomology.HigherDegree.CechSheafCohomology
public import StacksFrontier.RingTheory.LocalCohomology.HigherDegree.ComplementSheafCohomology

/-!
# `Hⁿ` on the complement of a zero locus is Čech cohomology of the standard covering

Let `I` be an ideal of a commutative ring `A` generated by a finite family `f`, let
`U = Spec A \ V(I)` and let `M` be an `A`-module. The cohomology group of [Stacks, Tag 01E3] of
the restriction `M̃|U`, taken on the open subscheme `U`, is the degree-`n` cohomology of the Čech
complex of the covering of `U` by the basic opens `D(f i)`, read as an abelian group.

## Main definitions

* `hgroupComplementTildeIsoCechHomology`: `Hⁿ(U, M̃|U)` is the degree-`n` homology of the Čech
  complex of the covering of `U` by the `D(f i)`.
* `cechComplexHomologyForgetIso`: the two Čech models of a covering — module-valued in the
  slice, abelian-group-valued in the lattice — have the same cohomology.
* `hgroupComplementTildeIsoLocalCohomologyModule`: above degree zero,
  `Hⁿ(U, M̃|U) ≅ H^{n+1}_{V(I)}(M)` as abelian groups, for a chosen family `f` generating `I`.
* `hgroupComplementTildeIsoHomologyCechComplement`: above degree zero, `Hⁿ(U, M̃|U)` is the
  cohomology of the cone of the algebraic Čech augmentation, for a chosen family `f`
  generating `I`.

## Main results

* `nonempty_hgroupComplementTilde_iso_localCohomologyModule`: above degree zero,
  `Hⁿ(U, M̃|U) ≅ H^{n+1}_{V(I)}(M)` as abelian groups.
* `nonempty_hgroup_iso_localCohomologyModule_of_iso`: the same for any sheaf of modules on `U`
  isomorphic to `M̃|U`.
* `nonempty_hgroupComplementTilde_iso_homologyCechComplement`: above degree zero, `Hⁿ(U, M̃|U)`
  is the cohomology of the cone of the algebraic Čech augmentation, which is the third term of
  the localization triangle of [Stacks, Tag 0DWR].

## References

* [Stacks Project, Tag 01E3](https://stacks.math.columbia.edu/tag/01E3)
* [Stacks Project, Tag 01EP](https://stacks.math.columbia.edu/tag/01EP)
* [Stacks Project, Tag 01ET](https://stacks.math.columbia.edu/tag/01ET)
* [Stacks Project, Tag 0DWR](https://stacks.math.columbia.edu/tag/0DWR)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.Cohomology.CechSheaf Stacks.Cohomology.CechDerived
open Stacks.LocalCohomology

attribute [local instance] HasDerivedCategory.standard
attribute [local instance] ModuleCat.hasLimitsOfSize
attribute [local instance] AddCommGrpCat.hasLimitsOfSize

universe u

namespace Stacks.Cohomology.ModuleComparison

section Standard

variable {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (I : Ideal A)
  (hIf : Ideal.span (Set.range f) = I) (M : ModuleCat.{u} A)

/-- **Cohomology on the complement of a zero locus is Čech cohomology of the standard
covering.** For `U = Spec A \ V(I)` with `I` generated by `f`, the cohomology group
`Hⁿ(U, M̃|U)` of [Stacks, Tag 01E3] is the degree-`n` homology of the Čech complex of the
covering of `U` by the basic opens `D(f i)`, read as an abelian group. -/
def hgroupComplementTildeIsoCechHomology (p : ℕ) :
    Hgroup (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ p (complementTilde A I M) ≅
      (forget₂ (ModuleCat.{u} (SectionRing (Spec (CommRingCat.of A)).ringCatSheaf
            (complementZeroLocus A I))) AddCommGrpCat.{u}).obj
        ((cechComplex.{u, u, u, u} (complementZeroLocus A I) (cechStandardOpen f)
          (complementZeroLocus_eq_iSup_cechStandardOpen f I hIf)
          (associatedSheaf A M)).homology p) :=
  (hgroupRestrictIso (Spec (CommRingCat.of A)) (complementZeroLocus A I) p
        (associatedSheaf A M)).symm ≪≫
    ((rightDerivedEvaluationForgetIso (Spec (CommRingCat.of A)).ringCatSheaf
        (complementZeroLocus A I) p).app (associatedSheaf A M)).symm ≪≫
    (forget₂ (ModuleCat.{u} (SectionRing (Spec (CommRingCat.of A)).ringCatSheaf
        (complementZeroLocus A I))) AddCommGrpCat.{u}).mapIso
      ((derivedGlobalSectionsIsoRightDerived I (associatedSheaf A M) p).symm ≪≫
        (cechCohomologyIsoCohomology f I hIf M p).symm ≪≫
        cechPlusHomologyIso (complementZeroLocus A I) (cechStandardOpen f)
          (complementZeroLocus_eq_iSup_cechStandardOpen f I hIf) (associatedSheaf A M) p)

end Standard

/-! ### The two Čech models of a covering -/

section TwoModels

variable {X : Type u} [TopologicalSpace X]
  {R : Sheaf (Opens.grothendieckTopology X) RingCat.{u}} (V : Opens X)
  {ι : Type u} (Ui : ι → Opens X) (hV : V = ⨆ i, Ui i) (F : SheafOfModules.{u} R)

/-- **The two Čech models of a covering agree.** The underlying abelian group of the degree-`n`
homology of the module-valued Čech complex of [Stacks, Tag 01EP], formed in the slice over `V`,
is the degree-`n` homology of the Čech complex of the underlying abelian sheaf formed in the
lattice of opens. -/
def cechComplexHomologyForgetIso (n : ℕ) :
    (forget₂ (ModuleCat.{u} (SectionRing R V)) AddCommGrpCat.{u}).obj
        ((cechComplex.{u, u, u, u} V Ui hV F).homology n) ≅
      ((CategoryTheory.cechComplexFunctor Ui).obj
        ((SheafOfModules.toSheaf R).obj F).obj).homology n :=
  have hle : ∀ i, Ui i ≤ V := fun i ↦ hV ▸ le_iSup Ui i
  (ShortComplex.mapHomologyIso (S := (cechComplex.{u, u, u, u} V Ui hV F).sc n)
      (F := forget₂ (ModuleCat.{u} (SectionRing R V)) AddCommGrpCat.{u})).symm ≪≫
    HomologicalComplex.homologyMapIso
      (Stacks.CategoryTheory.CechComplex.mapCoeffIso
        (Stacks.CategoryTheory.CechComplex.overFamily Ui hle)
        (sectionsPresheaf.{u, u, u} V F)
        (forget₂ (ModuleCat.{u} (SectionRing R V)) AddCommGrpCat.{u})) n ≪≫
    HomologicalComplex.homologyMapIso
      (Stacks.CategoryTheory.CechComplex.sliceComplexIso Ui hle
        ((SheafOfModules.toSheaf R).obj F).obj) n

end TwoModels

/-! ### Local cohomology and the algebraic Čech cone -/

section Complement

variable {A : Type u} [CommRing A] (I : Ideal A) (M : ModuleCat.{u} A)

/-- **Cohomology on the complement of a zero locus is local cohomology, shifted.** For `n ≥ 1`
the cohomology group `Hⁿ(U, M̃|U)` on `U = Spec A \ V(I)` is `H^{n+1}_{V(I)}(M)` as an abelian
group, for a chosen finite family `f` generating `I`. -/
def hgroupComplementTildeIsoLocalCohomologyModule {r : ℕ} (f : Fin r → A)
    (hI : I.FG) (hIf : Ideal.span (Set.range f) = I) (q : ℕ) :
    Hgroup (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ (q + 1)
        (complementTilde A I M) ≅
      (forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u}).obj
        (localCohomologyModule A I hI M ((q : ℤ) + 2)) :=
  hgroupComplementTildeIsoCechHomology f I hIf M (q + 1) ≪≫
    cechComplexHomologyForgetIso (complementZeroLocus A I) (cechStandardOpen f)
      (complementZeroLocus_eq_iSup_cechStandardOpen f I hIf) (associatedSheaf A M) (q + 1) ≪≫
    cechStandardHomologyIsoLocalCohomologyModule f M I hI hIf q

/-- **Cohomology on the complement of a zero locus is local cohomology, shifted.** For `n ≥ 1`
the cohomology group `Hⁿ(U, M̃|U)` on `U = Spec A \ V(I)` is `H^{n+1}_{V(I)}(M)` as an abelian
group. -/
theorem nonempty_hgroupComplementTilde_iso_localCohomologyModule (hI : I.FG) (q : ℕ) :
    Nonempty (Hgroup (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ (q + 1)
        (complementTilde A I M) ≅
      (forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u}).obj
        (localCohomologyModule A I hI M ((q : ℤ) + 2))) := by
  obtain ⟨r, f, hIf⟩ := Submodule.fg_iff_exists_fin_generating_family.1 hI
  exact ⟨hgroupComplementTildeIsoLocalCohomologyModule I M f hI hIf q⟩

/-- **Cohomology on the complement of a zero locus is local cohomology, shifted, for an
arbitrary sheaf of modules abstractly identified with `M̃|U`.** For `n ≥ 1` the cohomology
group `Hⁿ(U, F)` of any sheaf of modules `F` on `U = Spec A \ V(I)` with `F ≅ M̃|U` is
`H^{n+1}_{V(I)}(M)` as an abelian group. -/
theorem nonempty_hgroup_iso_localCohomologyModule_of_iso
    (F : SheafOfModules.{u} (complementZeroLocus A I : Scheme).ringCatSheaf) (hI : I.FG)
    (e : Nonempty (F ≅ complementTilde A I M)) (q : ℕ) :
    Nonempty (Hgroup (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ (q + 1) F ≅
      (forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u}).obj
        (localCohomologyModule A I hI M ((q : ℤ) + 2))) := by
  obtain ⟨e⟩ := e
  obtain ⟨h⟩ := nonempty_hgroupComplementTilde_iso_localCohomologyModule I M hI q
  exact ⟨(Hfunctor (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ (q + 1)).mapIso e ≪≫ h⟩

/-- **Cohomology on the complement of a zero locus is the cohomology of the algebraic Čech
cone.** For `n ≥ 1` the cohomology group `Hⁿ(U, M̃|U)` on `U = Spec A \ V(I)` is the degree-`n`
cohomology of the third term of the localization triangle of [Stacks, Tag 0DWR], for a chosen
finite family `f` generating `I`. -/
def hgroupComplementTildeIsoHomologyCechComplement {r : ℕ} (f : Fin r → A)
    (hI : I.FG) (hIf : Ideal.span (Set.range f) = I) (q : ℕ) :
    Hgroup (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ (q + 1)
        (complementTilde A I M) ≅
      (forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u}).obj
        ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) ((q : ℤ) + 1)).obj
          ((localizationTriangleData A I hI).complement.obj M)) := by
  have hdeg : (q : ℤ) + 1 + 1 = (q : ℤ) + 2 := by ring
  have h := cechComplementHomologyIsoLocalCohomologyModule A I hI M ((q : ℤ) + 1) (by omega)
  rw [hdeg] at h
  exact hgroupComplementTildeIsoLocalCohomologyModule I M f hI hIf q ≪≫
    (forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u}).mapIso h.symm

/-- **Cohomology on the complement of a zero locus is the cohomology of the algebraic Čech
cone.** For `n ≥ 1` the cohomology group `Hⁿ(U, M̃|U)` on `U = Spec A \ V(I)` is the degree-`n`
cohomology of the third term of the localization triangle of [Stacks, Tag 0DWR], which is the
cone of the Čech augmentation of a family of generators of `I`. -/
theorem nonempty_hgroupComplementTilde_iso_homologyCechComplement (hI : I.FG) (q : ℕ) :
    Nonempty (Hgroup (complementZeroLocus A I : Scheme).ringCatSheaf ⊤ (q + 1)
        (complementTilde A I M) ≅
      (forget₂ (ModuleCat.{u} A) AddCommGrpCat.{u}).obj
        ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) ((q : ℤ) + 1)).obj
          ((localizationTriangleData A I hI).complement.obj M))) := by
  obtain ⟨r, f, hIf⟩ := Submodule.fg_iff_exists_fin_generating_family.1 hI
  exact ⟨hgroupComplementTildeIsoHomologyCechComplement I M f hI hIf q⟩

end Complement

end Stacks.Cohomology.ModuleComparison

end
