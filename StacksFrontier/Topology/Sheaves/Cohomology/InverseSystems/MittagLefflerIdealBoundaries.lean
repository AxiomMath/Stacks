/-!
# Mittag-Leffler from a boundary family indexed by the powers of an ideal

Let `B` be a commutative ring, `I ⊆ B` an ideal generated by a finite family `f : L → B`, and
`… → T₂ → T₁ → T₀` an inverse system in a preadditive category carried to `B`-modules by an
additive functor `P`. Suppose there are *up* maps `Tₙ ⟶ T_(n+1)`, one per generator, whose
composite with the transition is multiplication by that generator after applying `P`, and boundary
maps `d n : P(Tₙ) → N n` whose kernels are the images of the transitions, compatible with maps
`μ l n : N n ⟶ N (n+1)`. If from some degree on every boundary is a sum of boundaries from one step
down pushed along the `μ l n`, then `n ↦ P(Tₙ)` satisfies the Mittag-Leffler condition (Stacks
0GYK).

## Main results

* `Stacks.Cohomology.IdealBoundaries.antitone_stabilizes_of_smul`: a descending filtration whose
  successive quotients are generated by `I` stabilizes once `I` is nilpotent on the ambient module.
* `Stacks.Cohomology.IdealBoundaries.isMittagLefflerCategorical_of_idealBoundaries`: the
  Mittag-Leffler condition from such a boundary family.

## Implementation notes

The hypotheses are stated after applying `P`, as identities of `B`-linear maps: `hup` says that
`P(up l n)` followed by `P(map n)` is multiplication by `f l`, and `hboundary` says that the
boundary of `P(T_(n+1))` is a sum `∑ l, μ l n (d n (y l))`.

The annihilation hypothesis `hann` is `I ^ (i + 1) • ⊤ = ⊥` on `P(T_i)`. For an `I`-adic system it
holds because `I ^ (i + 1)` already annihilates `T_i` itself.

## References

* [Stacks Project, Tag 0GYK](https://stacks.math.columbia.edu/tag/0GYK)
* [Stacks Project, Tag 0BLC](https://stacks.math.columbia.edu/tag/0BLC)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace Stacks.Cohomology.IdealBoundaries

/-- Let `J` be a descending filtration of `M` with `I • J n ≤ J (n + 1)` for all `n` and
`J (n + 1) ≤ I • J n ⊔ J (n + 2)` for `n ≥ N`. If `I ^ k` annihilates `M`, then `J n = J (N + k)`
for every `n ≥ N + k`. -/
theorem antitone_stabilizes_of_smul {B : Type u} {M : Type v} [CommRing B] [AddCommGroup M]
    [Module B M] (I : Ideal B) (J : ℕ → Submodule B M) (hJ : Antitone J)
    (hsmul : ∀ n, I • J n ≤ J (n + 1))
    (N k : ℕ) (hk : I ^ k • (⊤ : Submodule B M) = ⊥)
    (hrec : ∀ n, N ≤ n → J (n + 1) ≤ I • J n ⊔ J (n + 2)) :
    ∀ n, N + k ≤ n → J n = J (N + k) := by
  have hpow : ∀ j : ℕ, I • (I ^ j • (⊤ : Submodule B M)) = I ^ (j + 1) • (⊤ : Submodule B M) :=
    fun j => by rw [← Submodule.mul_smul, ← pow_succ']
  have hbound (b : ℕ) (hb : N ≤ b) :
      ∀ j, J (b + j) ≤ I ^ j • (⊤ : Submodule B M) ⊔ J (b + j + 1) := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      calc
        J (b + (j + 1)) ≤ I • J (b + j) ⊔ J (b + j + 2) := by
          simpa only [Nat.add_assoc] using hrec (b + j) (by omega)
        _ ≤ I • (I ^ j • (⊤ : Submodule B M) ⊔ J (b + j + 1)) ⊔ J (b + j + 2) :=
          sup_le_sup_right (Submodule.smul_mono le_rfl ih) _
        _ ≤ I ^ (j + 1) • (⊤ : Submodule B M) ⊔ J (b + (j + 1) + 1) := by
          rw [Submodule.smul_sup, hpow]
          exact sup_le (sup_le le_sup_left ((hsmul (b + j + 1)).trans le_sup_right)) le_sup_right
  have hstep (n : ℕ) (hn : N + k ≤ n) : J n = J (n + 1) := by
    refine le_antisymm ?_ (hJ (Nat.le_succ n))
    have h := hbound (n - k) (by omega) k
    rw [hk, bot_sup_eq] at h
    simpa only [Nat.sub_add_cancel (show k ≤ n by omega)] using h
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => rfl
  | succ n hn ih => exact (hstep n hn).symm.trans ih

/-- **The Mittag-Leffler condition from a boundary family indexed by the generators of an ideal**
(Stacks 0GYK).

The data is: an inverse system `T` with transitions `map`, an additive functor `P` to `B`-modules,
a finite family `f : L → B` generating `I`, up maps `up l n : T n ⟶ T (n + 1)` whose composite with
`map n` becomes multiplication by `f l` after applying `P`, a family of boundary maps `d n` out of
`P (T n)` whose kernels are the images of the transitions, maps `μ l n : N n ⟶ N (n + 1)` through
which the up maps act on the boundaries, and a degree `c` beyond which every boundary is a sum of
boundaries from one step down pushed along the `μ l n`.

The conclusion holds with the explicit lag `c + (i + 1)` at the term of index `i`. -/
theorem isMittagLefflerCategorical_of_idealBoundaries
    {B : Type u} [CommRing B] {C : Type*} [Category C] [Preadditive C]
    (P : C ⥤ ModuleCat.{v} B) [P.Additive]
    (obj : ℕ → C) (map : ∀ n, obj (n + 1) ⟶ obj n)
    {L : Type*} [Fintype L] (f : L → B) (I : Ideal B) (hI : I = Ideal.span (Set.range f))
    (up : L → ∀ n, obj n ⟶ obj (n + 1))
    (hup : ∀ (l : L) (n : ℕ), (P.map (up l n) ≫ P.map (map n)).hom =
      f l • (LinearMap.id : P.obj (obj n) →ₗ[B] P.obj (obj n)))
    (hann : ∀ i : ℕ, I ^ (i + 1) • (⊤ : Submodule B (P.obj (obj i))) = ⊥)
    {N : ℕ → Type v} [∀ n, AddCommGroup (N n)] [∀ n, Module B (N n)]
    (d : ∀ n, P.obj (obj n) →ₗ[B] N n)
    (hd : ∀ n, LinearMap.range (P.map (map n)).hom = LinearMap.ker (d n))
    (μ : L → ∀ n, N n →ₗ[B] N (n + 1))
    (hdu : ∀ (l : L) (n : ℕ), (d (n + 1)).comp (P.map (up l n)).hom = (μ l n).comp (d n))
    (c : ℕ)
    (hboundary : ∀ n, c ≤ n → ∀ x : P.obj (obj (n + 1)),
      ∃ y : L → P.obj (obj n), d (n + 1) x = ∑ l, μ l n (d n (y l))) :
    IsMittagLefflerCategorical (Functor.ofOpSequence map ⋙ P) := by
  classical
  have hdecomp (n : ℕ) (hn : c ≤ n) (x : P.obj (obj (n + 1))) :
      ∃ (y : L → P.obj (obj n)) (z : P.obj (obj (n + 2))),
        x = (∑ l, P.map (up l n) (y l)) + P.map (map (n + 1)) z := by
    obtain ⟨y, hy⟩ := hboundary n hn x
    have hker : x - ∑ l, P.map (up l n) (y l) ∈
        LinearMap.range (P.map (map (n + 1))).hom := by
      rw [hd]
      have hsum : d (n + 1) (∑ l, P.map (up l n) (y l)) = ∑ l, μ l n (d n (y l)) := by
        rw [map_sum]
        exact Finset.sum_congr rfl fun l _ =>
          congrArg (fun g => g (y l)) (hdu l n)
      change d (n + 1) (x - ∑ l, P.map (up l n) (y l)) = 0
      rw [map_sub, hsum, hy, sub_self]
    obtain ⟨z, hz⟩ := hker
    exact ⟨y, z, by rw [hz]; abel⟩
  intro i
  set T := Functor.ofOpSequence map ⋙ P with hT
  let t (n : ℕ) : P.obj (obj (i + n)) ⟶ P.obj (obj i) :=
    T.map (homOfLE (Nat.le_add_right i n)).op
  let J (n : ℕ) : Submodule B (P.obj (obj i)) := LinearMap.range (t n).hom
  have ht (n : ℕ) (y : P.obj (obj (i + (n + 1)))) :
      t n (P.map (map (i + n)) y) = t (n + 1) y := by
    have h : P.map (map (i + n)) ≫ t n = t (n + 1) := by
      rw [← Functor.ofOpSequence_map_homOfLE_succ map (i + n)]
      change T.map (homOfLE (Nat.le_succ (i + n))).op ≫
        T.map (homOfLE (Nat.le_add_right i n)).op = _
      rw [← T.map_comp]
      rfl
    exact congrArg (fun g => g y) h
  have hta (l : L) (n : ℕ) (x : P.obj (obj (i + n))) :
      t (n + 1) (P.map (up l (i + n)) x) = f l • t n x := by
    have h := congrArg (fun g => g x) (hup l (i + n))
    simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply,
      LinearMap.smul_apply, LinearMap.id_coe, id_eq] at h
    rw [← ht, h, map_smul]
  have hgen (l : L) (n : ℕ) (w : P.obj (obj i)) (hw : w ∈ J n) : f l • w ∈ J (n + 1) := by
    obtain ⟨x, rfl⟩ := hw
    exact ⟨P.map (up l (i + n)) x, hta l n x⟩
  have hsmul (n : ℕ) : I • J n ≤ J (n + 1) := by
    refine Submodule.smul_le.mpr fun r hr w hw => ?_
    rw [hI] at hr
    have hsub : Ideal.span (Set.range f) ≤
        Submodule.comap (LinearMap.toSpanSingleton B (P.obj (obj i)) w) (J (n + 1)) := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨l, rfl⟩
      exact hgen l n w hw
    exact hsub hr
  have hJ : Antitone J := by
    refine antitone_nat_of_succ_le fun n x hx => ?_
    obtain ⟨y, rfl⟩ := hx
    exact ⟨P.map (map (i + n)) y, ht n y⟩
  have hfI (l : L) : f l ∈ I := hI ▸ Ideal.subset_span (Set.mem_range_self l)
  have hrec (n : ℕ) (hn : c ≤ n) : J (n + 1) ≤ I • J n ⊔ J (n + 2) := by
    rintro x ⟨w, rfl⟩
    obtain ⟨y, z, hz⟩ := hdecomp (i + n) (by omega) w
    rw [hz, map_add, map_sum]
    refine Submodule.add_mem_sup (Submodule.sum_mem _ fun l _ => ?_)
      ⟨z, (ht (n + 1) z).symm⟩
    rw [hta l n (y l)]
    exact Submodule.smul_mem_smul (hfI l) ⟨y l, rfl⟩
  have hstable := antitone_stabilizes_of_smul I J hJ hsmul c (i + 1) (hann i) hrec
  refine ⟨i + (c + (i + 1)), Nat.le_add_right _ _, ?_⟩
  intro m hm
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le ((Nat.le_add_right i (c + (i + 1))).trans hm)
  have heq := hstable n (by omega)
  change Subobject.mk (image.ι (t n)) = Subobject.mk (image.ι (t (c + (i + 1))))
  have hmk {V W : ModuleCat.{v} B} (g : V ⟶ W) :
      Subobject.mk (image.ι g) =
        Subobject.mk (ModuleCat.ofHom (LinearMap.range g.hom).subtype) :=
    Subobject.mk_eq_mk_of_comm _ _ (ModuleCat.imageIsoRange g)
      (ModuleCat.imageIsoRange_hom_subtype g)
  rw [hmk, hmk]
  change Subobject.mk (ModuleCat.ofHom (J n).subtype) =
    Subobject.mk (ModuleCat.ofHom (J (c + (i + 1))).subtype)
  rw [heq]

end Stacks.Cohomology.IdealBoundaries

end
