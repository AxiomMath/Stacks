/-- Applying both sides of an equation `a ≫ b = c` of module homomorphisms to an element. -/
private lemma hom_comp_apply_eq {A : Type a} [CommRing A] {X Y Z : ModuleCat.{m} A}
    {a : X ⟶ Y} {b : Y ⟶ Z} {c : X ⟶ Z} (h : a ≫ b = c) (x : X) : b.hom (a.hom x) = c.hom x :=
  ConcreteCategory.congr_hom h x

/-- In an inverse system of exact rows whose left-hand term does not vary, a compatible family
of elements of the middle terms which dies in the right-hand terms lifts to an element of the
limit, and the lift may be prescribed at a single index. -/
private lemma exists_compatible_lift
    {A : Type a} [CommRing A] {P Q : ModuleCat.{m} A}
    (X : ℕᵒᵖ ⥤ ModuleCat.{m} A) (Y : ℕ → ModuleCat.{m} A)
    (b : ∀ n, Y (n + 1) ⟶ Y n)
    (δ : ∀ n, P ⟶ X.obj (op n)) (u : ∀ n, X.obj (op n) ⟶ Y n) (v : ∀ n, Y n ⟶ Q)
    (hδ : ∀ n, δ (n + 1) ≫ X.map (homOfLE (Nat.le_succ n)).op = δ n)
    (hu : ∀ n, u (n + 1) ≫ b n = X.map (homOfLE (Nat.le_succ n)).op ≫ u n)
    (hex₁ : ∀ n, Function.Exact (δ n).hom (u n).hom)
    (hex₂ : ∀ n, Function.Exact (u n).hom (v n).hom)
    (x : ∀ n, Y n) (hcompat : ∀ n, (b n).hom (x (n + 1)) = x n)
    (hx : ∀ n, (v n).hom (x n) = 0)
    (k : ℕ) (z₀ : X.obj (op k)) (hz₀ : (u k).hom z₀ = x k) :
    ∃ y : (limit X : ModuleCat.{m} A),
      (∀ n, (u n).hom ((limit.π X (op n)).hom y) = x n) ∧
      (limit.π X (op k)).hom y = z₀ := by
  classical
  have hnat (n : ℕ) (z : X.obj (op (n + 1))) :
      (b n).hom ((u (n + 1)).hom z) =
        (u n).hom ((X.map (homOfLE (Nat.le_succ n)).op).hom z) :=
    hom_comp_apply_eq (hu n) z
  have hδnat (n : ℕ) (t : P) :
      (X.map (homOfLE (Nat.le_succ n)).op).hom ((δ (n + 1)).hom t) = (δ n).hom t :=
    hom_comp_apply_eq (hδ n) t
  let Fibre (n : ℕ) : Type m := {z : X.obj (op n) // (u n).hom z = x n}
  let liftFibre (n : ℕ) : Fibre (n + 1) ⟶ Fibre n := ↾fun z =>
    ⟨(X.map (homOfLE (Nat.le_succ n)).op).hom z.1, by rw [← hnat n z.1, z.2, hcompat n]⟩
  let Z : ℕᵒᵖ ⥤ Type m := Functor.ofOpSequence (X := Fibre) liftFibre
  have hZmap (n : ℕ) : Z.map (homOfLE (Nat.le_succ n)).op = liftFibre n :=
    Functor.ofOpSequence_map_homOfLE_succ liftFibre n
  have hsurj (n : ℕ) : Function.Surjective (Z.map (homOfLE (Nat.le_succ n)).op) := by
    rw [hZmap n]
    intro z
    obtain ⟨w, hw⟩ := Set.mem_range.mp ((hex₂ (n + 1) (x (n + 1))).mp (hx (n + 1)))
    have hdiff : (u n).hom ((X.map (homOfLE (Nat.le_succ n)).op).hom w - z.1) = 0 := by
      rw [map_sub, ← hnat n w, hw, hcompat n, z.2, sub_self]
    obtain ⟨t, ht⟩ := (hex₁ n ((X.map (homOfLE (Nat.le_succ n)).op).hom w - z.1)).mp hdiff
    refine ⟨⟨w - (δ (n + 1)).hom t, ?_⟩, Subtype.ext ?_⟩
    · rw [map_sub, (hex₁ (n + 1) _).2 ⟨t, rfl⟩, sub_zero, hw]
    · show (X.map (homOfLE (Nat.le_succ n)).op).hom (w - (δ (n + 1)).hom t) = z.1
      rw [map_sub, hδnat n t, ht]
      abel
  have hbase : Nonempty (Fibre 0) := by
    obtain ⟨w, hw⟩ := Set.mem_range.mp ((hex₂ 0 (x 0)).mp (hx 0))
    exact ⟨⟨w, hw⟩⟩
  obtain ⟨c, -⟩ := Types.surjective_π_app_zero_of_surjective_map (limit.isLimit Z) hsurj
    (Classical.choice hbase)
  let τ : Z ⟶ X ⋙ forget (ModuleCat.{m} A) :=
    NatTrans.ofOpSequence (fun n => ↾fun z : Fibre n => z.1) (by
      intro n
      ext z
      show (Z.map (homOfLE (Nat.le_succ n)).op z).1 =
        (X.map (homOfLE (Nat.le_succ n)).op).hom z.1
      rw [hZmap n]
      rfl)
  let cone : Cone (X ⋙ forget (ModuleCat.{m} A)) :=
    { pt := limit Z
      π := (limit.cone Z).π ≫ τ }
  let hc := isLimitOfPreserves (forget (ModuleCat.{m} A)) (limit.isLimit X)
  let w : (limit X : ModuleCat.{m} A) := hc.lift cone c
  have hw (n : ℕ) : (limit.π X (op n)).hom w = (limit.π Z (op n) c).1 :=
    congrArg (fun g => g c) (hc.fac cone (op n))
  have hw' (n : ℕ) : (u n).hom ((limit.π X (op n)).hom w) = x n := by
    rw [hw n]
    exact (limit.π Z (op n) c).2
  obtain ⟨t, ht⟩ := (hex₁ k ((limit.π X (op k)).hom w - z₀)).mp
    (by rw [map_sub, hw', hz₀, sub_self])
  let d : Cone X :=
    { pt := P
      π := NatTrans.ofOpSequence δ fun n => (Category.id_comp (δ n)).trans (hδ n).symm }
  have hq (n : ℕ) : (limit.π X (op n)).hom ((limit.lift X d).hom t) = (δ n).hom t :=
    hom_comp_apply_eq (limit.lift_π d (op n)) t
  refine ⟨w - (limit.lift X d).hom t, fun n => ?_, ?_⟩
  · rw [map_sub, map_sub, hw', hq, (hex₁ n _).mpr ⟨t, rfl⟩, sub_zero]
  · rw [map_sub, hq, ht]
    abel

/-- Let `F` be a tower of modules carrying the maps that condition (1) of Stacks 0H39 provides:
`ιm` splits multiplication by `f` through the transition maps, `pr` is the iterated transition to
the bottom term, and `δ` is a stationary left-hand term of the rows. Then the `f^(n+1)`-multiples
in the limit are exactly the elements vanishing at the index `n`. -/
private lemma range_pow_eq_ker_of_tower
    {A : Type a} [CommRing A] {P : ModuleCat.{m} A}
    (F : ℕᵒᵖ ⥤ ModuleCat.{m} A) (f : A)
    (tr : ∀ k, F.obj (op (k + 1)) ⟶ F.obj (op k))
    (htr : ∀ k, tr k = F.map (homOfLE (Nat.le_succ k)).op)
    (ιm : ∀ k, F.obj (op k) ⟶ F.obj (op (k + 1)))
    (pr : ∀ k, F.obj (op k) ⟶ F.obj (op 0))
    (δ : ∀ k, P ⟶ F.obj (op k))
    (hδ : ∀ k, δ (k + 1) ≫ tr k = δ k)
    (hιnat : ∀ k, ιm (k + 1) ≫ tr (k + 1) = tr k ≫ ιm k)
    (hdι : ∀ (k : ℕ) (z : F.obj (op (k + 1))), (ιm k).hom ((tr k).hom z) = f • z)
    (hιd : ∀ (k : ℕ) (z : F.obj (op k)), (tr k).hom ((ιm k).hom z) = f • z)
    (hf0 : ∀ z : F.obj (op 0), f • z = 0)
    (hpr0 : pr 0 = 𝟙 (F.obj (op 0)))
    (hprd : ∀ k, tr k ≫ pr k = pr (k + 1))
    (hex₁ : ∀ k, Function.Exact (δ k).hom (ιm k).hom)
    (hex₂ : ∀ k, Function.Exact (ιm k).hom (pr (k + 1)).hom)
    (n : ℕ) :
    LinearMap.range (LinearMap.lsmul A (limit F : ModuleCat.{m} A) (f ^ (n + 1))) =
      LinearMap.ker (limit.π F (op n)).hom := by
  classical
  have hstep (k : ℕ) (y : (limit F : ModuleCat.{m} A)) :
      (tr k).hom ((limit.π F (op (k + 1))).hom y) = (limit.π F (op k)).hom y := by
    rw [htr k]
    exact hom_comp_apply_eq (limit.w F (homOfLE (Nat.le_succ k)).op) y
  have hproj (k : ℕ) (y : (limit F : ModuleCat.{m} A)) :
      (pr k).hom ((limit.π F (op k)).hom y) = (limit.π F (op 0)).hom y := by
    induction k with
    | zero =>
      rw [hpr0]
      rfl
    | succ k ih =>
      rw [← hom_comp_apply_eq (hprd k), hstep k y, ih]
  have hlift (y : (limit F : ModuleCat.{m} A)) (hy : (limit.π F (op 0)).hom y = 0) (k : ℕ)
      (z : F.obj (op k)) (hz : (ιm k).hom z = (limit.π F (op (k + 1))).hom y) :
      ∃ y' : (limit F : ModuleCat.{m} A), f • y' = y ∧ (limit.π F (op k)).hom y' = z := by
    obtain ⟨y', hy', hy'k⟩ := exists_compatible_lift (P := P) (Q := F.obj (op 0)) F
      (fun k => F.obj (op (k + 1))) (fun k => tr (k + 1))
      δ ιm (fun k => pr (k + 1)) (fun k => by rw [← htr k]; exact hδ k)
      (fun k => by rw [← htr k]; exact hιnat k) hex₁ hex₂
      (fun k => (limit.π F (op (k + 1))).hom y) (fun k => hstep (k + 1) y)
      (fun k => (hproj (k + 1) y).trans hy) k z hz
    have key (i : ℕ) : (limit.π F (op i)).hom (f • y') = (limit.π F (op i)).hom y := by
      rw [map_smul, ← hιd i ((limit.π F (op i)).hom y'), hy' i, hstep i y]
    exact ⟨y', Concrete.limit_ext F _ _ fun j => key j.unop, hy'k⟩
  have hzero (y : (limit F : ModuleCat.{m} A)) : (limit.π F (op 0)).hom (f • y) = 0 :=
    (map_smul _ _ _).trans (hf0 _)
  have hsucc (k : ℕ) (y : (limit F : ModuleCat.{m} A)) :
      (limit.π F (op (k + 1))).hom (f • y) = (ιm k).hom ((limit.π F (op k)).hom y) := by
    rw [map_smul, ← hdι k ((limit.π F (op (k + 1))).hom y), hstep k y]
  have hpow : ∀ k (y : (limit F : ModuleCat.{m} A)),
      (limit.π F (op k)).hom y = 0 ↔ ∃ y' : (limit F : ModuleCat.{m} A), f ^ (k + 1) • y' = y := by
    intro k
    induction k with
    | zero =>
      intro y
      refine ⟨fun hy => ?_, ?_⟩
      · obtain ⟨z, hz⟩ := (hex₂ 0 _).mp ((hproj 1 y).trans hy)
        obtain ⟨y', hy', -⟩ := hlift y hy 0 z hz
        exact ⟨y', by simpa only [zero_add, pow_one] using hy'⟩
      · rintro ⟨y', rfl⟩
        simpa only [zero_add, pow_one] using hzero y'
    | succ k ih =>
      intro y
      refine ⟨fun hy => ?_, ?_⟩
      · have hy0 : (limit.π F (op 0)).hom y = 0 := by
          rw [← hproj (k + 1) y, hy, map_zero]
        obtain ⟨y', hy', hy'k⟩ := hlift y hy0 k 0 (by rw [map_zero]; exact hy.symm)
        obtain ⟨z, hz⟩ := (ih y').mp hy'k
        exact ⟨z, by rw [pow_succ', mul_smul, hz, hy']⟩
      · rintro ⟨y', rfl⟩
        rw [pow_succ', mul_smul, hsucc, (ih _).mpr ⟨y', rfl⟩, map_zero]
  ext y
  simp only [LinearMap.mem_range, LinearMap.mem_ker, LinearMap.lsmul_apply]
  exact (hpow n y).symm

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

/-- Condition (1) of Stacks 0H39 for an endomorphism acting as the scalar `f` in a cohomological
`δ`-functor forces the `f^(n+1)`-multiples in the limit of the degree-`p` values to be exactly
the classes vanishing at the index `n`. -/
private lemma range_pow_eq_ker_of_deltaFunctor {R : Sheaf J RingCat.{w}} {A : Type a} [CommRing A]
    (α : End (𝟭 (SheafOfModules.{max u v} R))) (f : A)
    (obj : ℕ → SheafOfModules.{max u v} R) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (h : Condition1 α obj map)
    (D : DeltaFunctor (SheafOfModules.{max u v} R) (ModuleCat.{m} A)) (p n : ℕ)
    (hscalar : ∀ (N : SheafOfModules.{max u v} R) (y : (D.functor p).obj N),
      ((D.functor p).map (α.asHom.app N)).hom y = f • y) :
    LinearMap.range (LinearMap.lsmul A
        (limit (Functor.ofOpSequence map ⋙ D.functor p) : ModuleCat.{m} A) (f ^ (n + 1))) =
      LinearMap.ker (limit.π (Functor.ofOpSequence map ⋙ D.functor p) (op n)).hom := by
  classical
  choose ι wι hfac hshort using h
  have hback (k : ℕ) : ι k ≫ map k = α.asHom.app (obj k) := by
    have := (hshort k).mono_f
    rw [← cancel_mono (ι k), Category.assoc, hfac]
    exact (mulF_naturality α (ι k)).symm
  have hkill : α.asHom.app (obj 0) = 0 := by
    rw [← hback 0]
    simpa [proj] using wι 0
  have hs (k : ℕ) :
      (ShortComplex.mk (ι k) (proj obj map (k + 1)) (wι k)).ShortExact := hshort k
  let t (k : ℕ) : ShortComplex.mk (ι (k + 1)) (proj obj map (k + 1 + 1)) (wι (k + 1)) ⟶
      ShortComplex.mk (ι k) (proj obj map (k + 1)) (wι k) :=
    { τ₁ := map k
      τ₂ := map (k + 1)
      τ₃ := 𝟙 _
      comm₁₂ := by
        show map k ≫ ι k = ι (k + 1) ≫ map (k + 1)
        rw [hback (k + 1), hfac k]
      comm₂₃ := by
        show map (k + 1) ≫ proj obj map (k + 1) = proj obj map (k + 1 + 1) ≫ 𝟙 _
        simp [proj] }
  obtain ⟨P, δ, hδ, hex₁⟩ : ∃ (P : ModuleCat.{m} A) (δ : ∀ k, P ⟶ (D.functor p).obj (obj k)),
      (∀ k, δ (k + 1) ≫ (D.functor p).map (map k) = δ k) ∧
      (∀ k, Function.Exact (δ k).hom ((D.functor p).map (ι k)).hom) := by
    cases p with
    | zero =>
      refine ⟨(D.functor 0).obj (obj 0), fun _ => 0, by simp, fun k y => ?_⟩
      have hinj := (ModuleCat.mono_iff_injective ((D.functor 0).map (ι k))).mp
        (D.mono_map_f (hs k))
      refine ⟨fun hy => ⟨0, ?_⟩, ?_⟩
      · rw [map_zero]
        exact (hinj (hy.trans (map_zero _).symm)).symm
      · rintro ⟨z, rfl⟩
        simp
    | succ q =>
      refine ⟨(D.functor q).obj (obj 0), fun k => D.δ (hs k) q, fun k => ?_, fun k =>
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mp (D.exact_δ₂ (hs k) q)⟩
      have hh := D.δ_naturality (hs (k + 1)) (hs k) (t k) q
      rw [CategoryTheory.Functor.map_id, Category.id_comp] at hh
      exact hh.symm
  have hFmap (k : ℕ) :
      (Functor.ofOpSequence map ⋙ D.functor p).map (homOfLE (Nat.le_succ k)).op =
        (D.functor p).map (map k) :=
    congrArg (D.functor p).map (Functor.ofOpSequence_map_homOfLE_succ map k)
  have hιnat (k : ℕ) : (D.functor p).map (ι (k + 1)) ≫ (D.functor p).map (map (k + 1)) =
      (D.functor p).map (map k) ≫ (D.functor p).map (ι k) := by
    rw [← Functor.map_comp, ← Functor.map_comp, hback (k + 1), hfac k]
  have hmul {X Y : SheafOfModules.{max u v} R} (a : X ⟶ Y) (b : Y ⟶ X) (hab : a ≫ b = α.asHom.app X)
      (z : (D.functor p).obj X) :
      ((D.functor p).map b).hom (((D.functor p).map a).hom z) = f • z :=
    (hom_comp_apply_eq (c := (D.functor p).map (α.asHom.app X))
      (by rw [← Functor.map_comp, hab]) z).trans (hscalar X z)
  have hdι (k : ℕ) (z : (D.functor p).obj (obj (k + 1))) :
      ((D.functor p).map (ι k)).hom (((D.functor p).map (map k)).hom z) = f • z :=
    hmul _ _ (hfac k) z
  have hιd (k : ℕ) (z : (D.functor p).obj (obj k)) :
      ((D.functor p).map (map k)).hom (((D.functor p).map (ι k)).hom z) = f • z :=
    hmul _ _ (hback k) z
  have hf0 (z : (D.functor p).obj (obj 0)) : f • z = 0 := by
    rw [← hscalar (obj 0) z, hkill, CategoryTheory.Functor.map_zero, ModuleCat.hom_zero]
    exact LinearMap.zero_apply z
  have hpr0 : (D.functor p).map (proj obj map 0) = 𝟙 ((D.functor p).obj (obj 0)) := by
    rw [proj, CategoryTheory.Functor.map_id]
  have hprd (k : ℕ) : (D.functor p).map (map k) ≫ (D.functor p).map (proj obj map k) =
      (D.functor p).map (proj obj map (k + 1)) := by
    rw [← Functor.map_comp, proj]
  have hex₂ (k : ℕ) : Function.Exact ((D.functor p).map (ι k)).hom
      ((D.functor p).map (proj obj map (k + 1))).hom :=
    (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mp (D.exact_map (hs k) p)
  exact range_pow_eq_ker_of_tower (P := P) (Functor.ofOpSequence map ⋙ D.functor p) f
    (fun k => (D.functor p).map (map k)) (fun k => (hFmap k).symm)
    (fun k => (D.functor p).map (ι k)) (fun k => (D.functor p).map (proj obj map k)) δ
    hδ hιnat hdι hιd hf0 hpr0 hprd hex₁ hex₂ n

/-- A filtration by the images of the powers of a single scalar presents the inverse-limit
topology of a tower as the adic topology of the principal ideal that scalar generates. -/
private lemma iInf_induced_eq_adic_of_range_pow
    {A : Type a} [CommRing A] {M : Type m} [AddCommGroup M] [Module A M]
    {N : ℕ → Type m} [∀ n, AddCommGroup (N n)] [∀ n, Module A (N n)]
    (f : A) (g : ∀ n, M →ₗ[A] N n)
    (hker : ∀ n, LinearMap.ker (g n) = LinearMap.range (LinearMap.lsmul A M (f ^ (n + 1)))) :
    (⨅ n : ℕ, TopologicalSpace.induced (fun y : M => g n y) ⊥) =
      (Ideal.span {f}).adicModuleTopology M := by
  classical
  have hmem (k : ℕ) : f ^ k ∈ (Ideal.span {f} : Ideal A) ^ k :=
    Ideal.pow_mem_pow (Ideal.mem_span_singleton_self f) k
  refine Stacks.AdicLimit.iInf_induced_eq_adicModuleTopology (Ideal.span {f}) g ?_ ?_ ?_
  · intro i j hij y hy
    rw [hker j, LinearMap.mem_range] at hy
    obtain ⟨z, rfl⟩ := hy
    rw [hker i, LinearMap.mem_range]
    refine ⟨f ^ (j - i) • z, ?_⟩
    rw [LinearMap.lsmul_apply, LinearMap.lsmul_apply, smul_smul, ← pow_add,
      show i + 1 + (j - i) = j + 1 by omega]
  · refine fun n => ⟨n + 1, ?_⟩
    rw [hker n]
    refine Submodule.smul_le.mpr fun r hr y _ => ?_
    rw [LinearMap.mem_range]
    obtain ⟨s, hs⟩ := Ideal.mem_span_singleton.mp
      (by simpa only [Ideal.span_singleton_pow] using hr)
    exact ⟨s • y, by rw [LinearMap.lsmul_apply, smul_smul, ← hs]⟩
  · refine fun k => ⟨k, ?_⟩
    rw [hker k]
    rintro y hy
    rw [LinearMap.mem_range] at hy
    obtain ⟨z, rfl⟩ := hy
    rw [LinearMap.lsmul_apply, pow_succ, mul_smul]
    exact Submodule.smul_mem_smul (hmem k) Submodule.mem_top

variable (O : Sheaf J RingCat.{max u v}) [∀ X : Cᵒᵖ, IsMulCommutative (O.obj.obj X)]

/-- Let `f` be a global section of `O` and let `… → 𝓕₂ → 𝓕₁` be an inverse system of `O`-modules
satisfying condition (1) of Stacks 0H39 for multiplication by `f`. For every `c = n + 1 ≥ 1` the
submodule `f^c · lim Hᵖ(C, 𝓕ₙ)` of `lim Hᵖ(C, 𝓕ₙ)` is the kernel of the projection to
`Hᵖ(C, 𝓕_c)`. -/
@[stacks 0EHA]
theorem range_pow_eq_ker_limitProjection (f : ↥(GlobalSectionRing O))
    (obj : ℕ → SheafOfModules.{max u v} O) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (h : Condition1 (Stacks.SheafOfModules.globalSectionToEnd O ⟨f.1, f.2⟩) obj map) (p n : ℕ) :
    LinearMap.range (LinearMap.lsmul ↥(GlobalSectionRing O)
        (limit (Functor.ofOpSequence map ⋙ globalModuleCohomology.{u, v, max u v, max u v} O p) :
          ModuleCat.{max u v} ↥(GlobalSectionRing O)) (f ^ (n + 1))) =
      LinearMap.ker (limit.π (Functor.ofOpSequence map ⋙
        globalModuleCohomology.{u, v, max u v, max u v} O p) (op n)).hom := by
  refine range_pow_eq_ker_of_deltaFunctor _ f obj map h
    (cohomologyDeltaFunctor.{u, v, max u v, max u v} O) p n fun N y => ?_
  show ((globalModuleCohomology.{u, v, max u v, max u v} O p).map
    (globalSmul O f N)).hom y = f • y
  rw [globalSmul_eq_smul_id, Functor.map_smul, CategoryTheory.Functor.map_id]
  rfl

/-- The inverse-limit topology on `lim Hᵖ(C, 𝓕ₙ)` is the topology defined by the principal ideal
generated by `f`. -/
theorem limitCohomologyTopology_eq_adic (f : ↥(GlobalSectionRing O))
    (obj : ℕ → SheafOfModules.{max u v} O) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (h : Condition1 (Stacks.SheafOfModules.globalSectionToEnd O ⟨f.1, f.2⟩) obj map) (p : ℕ) :
    (⨅ n : ℕ, TopologicalSpace.induced
        (fun y : (limit (Functor.ofOpSequence map ⋙
            globalModuleCohomology.{u, v, max u v, max u v} O p) :
          ModuleCat.{max u v} ↥(GlobalSectionRing O)) =>
          (limit.π (Functor.ofOpSequence map ⋙
            globalModuleCohomology.{u, v, max u v, max u v} O p) (op n)).hom y) ⊥) =
      (Ideal.span {f}).adicModuleTopology
        (limit (Functor.ofOpSequence map ⋙ globalModuleCohomology.{u, v, max u v, max u v} O p) :
          ModuleCat.{max u v} ↥(GlobalSectionRing O)) :=
  iInf_induced_eq_adic_of_range_pow f
    (fun n => (limit.π (Functor.ofOpSequence map ⋙
      globalModuleCohomology.{u, v, max u v, max u v} O p) (op n)).hom)
    fun n => (range_pow_eq_ker_limitProjection O f obj map h p n).symm

/-- Let `f` be a global section of `O` and let `… → 𝓕₂ → 𝓕₁` be an inverse system of `O`-modules
satisfying condition (1) of Stacks 0H39 for multiplication by `f`, and let `p ≥ 0`. Put
`Hᵖ = lim Hᵖ(C, 𝓕ₙ)`. Then for every `c = n + 1 ≥ 1` the submodule `f^c Hᵖ` is the kernel of
`Hᵖ → Hᵖ(C, 𝓕_c)`, and the limit topology on `Hᵖ` (the infimum of the topologies induced by the
projections to the discrete `Hᵖ(C, 𝓕_c)`) is the `f`-adic topology. -/
@[stacks 0EHA "both conclusions: `f^c Hᵖ` is the kernel of `Hᵖ → Hᵖ(X, 𝓕_c)` for all `c ≥ 1`, \
and the limit topology on `Hᵖ` is the `f`-adic topology"]
theorem range_pow_eq_ker_limitProjection_and_limitTopology_eq_adic
    (f : ↥(GlobalSectionRing O))
    (obj : ℕ → SheafOfModules.{max u v} O) (map : ∀ n, obj (n + 1) ⟶ obj n)
    (h : Condition1 (Stacks.SheafOfModules.globalSectionToEnd O ⟨f.1, f.2⟩) obj map) (p : ℕ) :
    (∀ n : ℕ, LinearMap.range (LinearMap.lsmul ↥(GlobalSectionRing O)
        (limit (Functor.ofOpSequence map ⋙ globalModuleCohomology.{u, v, max u v, max u v} O p) :
          ModuleCat.{max u v} ↥(GlobalSectionRing O)) (f ^ (n + 1))) =
      LinearMap.ker (limit.π (Functor.ofOpSequence map ⋙
        globalModuleCohomology.{u, v, max u v, max u v} O p) (op n)).hom) ∧
    (⨅ n : ℕ, TopologicalSpace.induced
        (fun y : (limit (Functor.ofOpSequence map ⋙
            globalModuleCohomology.{u, v, max u v, max u v} O p) :
          ModuleCat.{max u v} ↥(GlobalSectionRing O)) =>
          (limit.π (Functor.ofOpSequence map ⋙
            globalModuleCohomology.{u, v, max u v, max u v} O p) (op n)).hom y) ⊥) =
      (Ideal.span {f}).adicModuleTopology
        (limit (Functor.ofOpSequence map ⋙ globalModuleCohomology.{u, v, max u v, max u v} O p) :
          ModuleCat.{max u v} ↥(GlobalSectionRing O)) :=
  ⟨fun n => range_pow_eq_ker_limitProjection O f obj map h p n,
    limitCohomologyTopology_eq_adic O f obj map h p⟩

end Stacks.Cohomology.InverseSystems

end
