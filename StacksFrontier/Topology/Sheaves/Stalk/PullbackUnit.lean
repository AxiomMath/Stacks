module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Topology.Sheaves.Functors
public import Mathlib.Topology.Sheaves.Sheafify
public import Mathlib.Topology.Sheaves.Stalks
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The inverse image of a sheaf of rings is generated by the sections of the original sheaf

Let `f : X ⟶ Y` be a continuous map and let `F` be a sheaf of commutative rings on `Y`.  The
inverse image `f⁻¹F` is defined in Mathlib as an abstract left adjoint of the direct image
(`TopCat.Sheaf.pullback`), so it carries no description of its sections at all.  This file
supplies the one thing that is needed in order to compute with it locally:

**every germ of `f⁻¹F` at a point `x` is the germ of the image of a section of `F` over some
neighbourhood of `f x`** (`exists_germ_eq_unit`), and hence every section of `f⁻¹F` agrees, on a
small enough neighbourhood of `x`, with the image of a section of `F`
(`exists_restrict_eq_unit`).

The mechanism is the stalk comparison.  For *any* morphism `ψ : F ⟶ f_* G` of presheaves there
is a canonical map on stalks `stalkComparison f ψ x : F_{f x} ⟶ G_x`, obtained by applying the
stalk functor at `f x` and then `TopCat.Presheaf.stalkPushforward`; it takes the germ of a
section `s` over `U` to the germ of `ψ(s)` (`germ_stalkComparison`), and it is compatible with
postcomposition in `G` (`stalkComparison_comp`).  Taken at the unit of the *presheaf*
pullback-pushforward adjunction it is exactly `TopCat.Presheaf.stalkPullbackHom`, which Mathlib
proves to be an isomorphism (`TopCat.Presheaf.stalkPullbackIso`).

The sheaf-level statement is reduced to that presheaf-level one.  `TopCat.Sheaf.pullbackIso`
identifies the abstract left adjoint with the concrete construction "pull back as a presheaf,
then sheafify", and `CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app` says that this
identification carries the abstract unit to the concrete one.  The concrete unit *is* the
presheaf unit followed by `CategoryTheory.toSheafify` (this holds by `rfl`), sheafification does
not change stalks (`TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso`), and so the
sheaf-level comparison is an isomorphism as well (`isIso_stalkComparison`).

## Main definitions

* `Stacks.Sheaves.PullbackUnit.stalkComparison` — the map on stalks `F_{f x} ⟶ G_x` attached to
  a morphism of presheaves `F ⟶ f_* G`.

## Main results

* `Stacks.Sheaves.PullbackUnit.isIso_stalkComparison` — the stalk comparison attached to the
  unit of `TopCat.Sheaf.pullbackPushforwardAdjunction` is an isomorphism.
* `Stacks.Sheaves.PullbackUnit.exists_germ_eq_unit` — every germ of the inverse image is the
  germ of the image of a section of the original sheaf.
* `Stacks.Sheaves.PullbackUnit.exists_restrict_eq_unit` — the same statement on sections, after
  restricting to a small enough neighbourhood.

## Implementation notes

`isIso_of_comp_eq` is stated with all three objects as variables.  A goal mentioning the stalk
of a sheaf pullback is not type-correct under `implicit` transparency — `TopCat.Presheaf.stalk`
is not reducible, while `TopCat.Presheaf.stalkFunctor` applied to the same arguments is what the
composites unfold to — so `rw` cannot build a motive on it, and the transport has to happen
inside a lemma in which the objects are opaque.  For the same reason `germ_stalkComparison` and
`stalkComparison_comp` are proved in term mode.

The same three-step identification — `TopCat.Sheaf.pullbackIso`,
`CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app` against
`Functor.sheafPullbackConstruction.sheafAdjunctionContinuous`, and
`TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso` — occurs for the structure sheaf of a
locally ringed space in
`StacksFrontier.AlgebraicGeometry.ProEtale.WLocal.InverseImageStructureSheaf`, where it is
`private` and specialised to `X.𝒪`, and where it produces only the comparison isomorphism and
not the germ statement.  This file states it for an arbitrary sheaf of commutative rings and
carries it down to germs, which is what a computation with the inverse image needs.

`Mathlib.Algebra.Category.Ring.FilteredColimits` is imported for
`CategoryTheory.Limits.PreservesFilteredColimits (CategoryTheory.forget CommRingCat)`, which is
what makes `TopCat.Presheaf.exists_germ_eq` and `TopCat.Presheaf.germ_eq` available at
`CommRingCat`.

**No `@[stacks]` attribute is placed in this file.**  Nothing here is a tagged result of the
source;  it is infrastructure for the generation statement that the base-change clause of
[Stacks, Tag 0EY6] needs.

## References

* [Stacks Project, Tag 008O](https://stacks.math.columbia.edu/tag/008O)
* [Stacks Project, Tag 0EY6](https://stacks.math.columbia.edu/tag/0EY6)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopCat Opposite TopologicalSpace

universe u

namespace Stacks.Sheaves.PullbackUnit

/-! ### The stalk comparison of a morphism into a direct image -/

section Comparison

variable {X Y : TopCat.{u}} (f : X ⟶ Y) (C : Type (u + 1)) [Category.{u} C] [HasColimits C]

/-- **The comparison on stalks attached to a morphism into a direct image.**  A morphism of
presheaves `ψ : F ⟶ f_* G` induces `F_{f x} ⟶ G_x`:  apply the stalk functor at `f x`, then the
canonical map `(f_* G)_{f x} ⟶ G_x`. -/
public def stalkComparison {F : Y.Presheaf C} {G : X.Presheaf C}
    (ψ : F ⟶ (TopCat.Presheaf.pushforward C f).obj G) (x : X) :
    TopCat.Presheaf.stalk F (f x) ⟶ TopCat.Presheaf.stalk G x :=
  (TopCat.Presheaf.stalkFunctor C (f x)).map ψ ≫ TopCat.Presheaf.stalkPushforward C f G x

/-- The stalk comparison takes the germ of a section `s` of `F` over `U` to the germ of
`ψ(s)`. -/
public theorem germ_stalkComparison {F : Y.Presheaf C} {G : X.Presheaf C}
    (ψ : F ⟶ (TopCat.Presheaf.pushforward C f).obj G) (x : X) (U : Opens Y) (hU : f x ∈ U) :
    F.germ U (f x) hU ≫ stalkComparison f C ψ x =
      ψ.app (op U) ≫ G.germ ((Opens.map f).obj U) x hU :=
  (Category.assoc _ _ _).symm.trans
    (((congrArg (fun t => t ≫ TopCat.Presheaf.stalkPushforward C f G x)
        (TopCat.Presheaf.stalkFunctor_map_germ U (f x) hU ψ)).trans
      (Category.assoc _ _ _)).trans
      (congrArg (fun t => ψ.app (op U) ≫ t)
        (TopCat.Presheaf.stalkPushforward_germ C f G U x hU)))

/-- The stalk comparison is compatible with postcomposition in the target:  the comparison of
`ψ` followed by the direct image of `α` is the comparison of `ψ` followed by the stalk map of
`α`. -/
public theorem stalkComparison_comp {F : Y.Presheaf C} {G G' : X.Presheaf C}
    (ψ : F ⟶ (TopCat.Presheaf.pushforward C f).obj G) (α : G ⟶ G') (x : X) :
    stalkComparison f C (ψ ≫ (TopCat.Presheaf.pushforward C f).map α) x =
      stalkComparison f C ψ x ≫ (TopCat.Presheaf.stalkFunctor C x).map α := by
  refine TopCat.Presheaf.stalk_hom_ext _ (fun U hU => ?_)
  have h1 := germ_stalkComparison f C (ψ ≫ (TopCat.Presheaf.pushforward C f).map α) x U hU
  have h2 := germ_stalkComparison f C ψ x U hU
  have h3 := TopCat.Presheaf.stalkFunctor_map_germ ((Opens.map f).obj U) x hU α
  have e1 : (ψ ≫ (TopCat.Presheaf.pushforward C f).map α).app (op U) ≫
        G'.germ ((Opens.map f).obj U) x hU =
      (ψ.app (op U) ≫ G.germ ((Opens.map f).obj U) x hU) ≫
        (TopCat.Presheaf.stalkFunctor C x).map α :=
    (Category.assoc _ _ _).trans ((congrArg (fun t => ψ.app (op U) ≫ t) h3.symm).trans
      (Category.assoc _ _ _).symm)
  exact h1.trans (e1.trans ((congrArg (fun t => t ≫ (TopCat.Presheaf.stalkFunctor C x).map α)
    h2).symm.trans (Category.assoc _ _ _)))

/-- The stalk comparison of the unit of the pullback-pushforward adjunction for *presheaves* is
`TopCat.Presheaf.stalkPullbackHom`:  that is how the latter is defined. -/
public theorem stalkComparison_presheafUnit [HasLimits C] (F : Y.Presheaf C) (x : X) :
    stalkComparison f C ((TopCat.Presheaf.pullbackPushforwardAdjunction C f).unit.app F) x =
      TopCat.Presheaf.stalkPullbackHom C f F x := rfl

end Comparison

/-! ### Two transport lemmas with every object a variable -/

/-- If `a ≫ b` is an isomorphism and so is `b`, then so is `a`.  Stated with the three objects
as variables:  the goals it is applied to mention the stalk of a sheaf pullback, on which `rw`
cannot build a motive. -/
public theorem isIso_of_comp_eq {C : Type*} [Category C] {A B D : C} (a : A ⟶ B) (b : B ⟶ D)
    (c : A ⟶ D) (hb : IsIso b) (hc : IsIso c) (h : a ≫ b = c) : IsIso a := by
  have := hb
  have := hc
  have ha : a = c ≫ inv b := by
    rw [← h, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
  rw [ha]
  infer_instance

/-- The stalk functor carries an isomorphism of presheaves to an isomorphism. -/
public theorem isIso_stalkFunctor_map_of_iso {Z : TopCat.{u}} (z : Z) (C : Type (u + 1))
    [Category.{u} C] [HasColimits C] {P Q : Z.Presheaf C} (α : P ≅ Q) :
    IsIso ((TopCat.Presheaf.stalkFunctor C z).map α.hom) :=
  ((TopCat.Presheaf.stalkFunctor C z).mapIso α).isIso_hom

/-! ### The stalk comparison of the unit of the adjunction for sheaves of rings -/

section SheafUnit

variable {X Y : TopCat.{u}} (f : X ⟶ Y)

/-- **The stalk comparison of the unit of `TopCat.Sheaf.pullbackPushforwardAdjunction` is an
isomorphism.**  `TopCat.Sheaf.pullbackIso` identifies the abstract inverse image with the
sheafification of the presheaf inverse image and carries the one unit to the other
(`CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app`);  the concrete unit is the presheaf
unit followed by `CategoryTheory.toSheafify`, whose stalk comparison is
`TopCat.Presheaf.stalkPullbackHom` followed by the stalk map of `toSheafify`, and both of those
are isomorphisms. -/
@[ega "0 3.7.2" "special case"]
public theorem isIso_stalkComparison (F : Y.Sheaf CommRingCat.{u}) (x : X) :
    IsIso (stalkComparison f CommRingCat.{u}
      ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom x) := by
  have hunit :
      ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom ≫
        (TopCat.Presheaf.pushforward CommRingCat.{u} f).map
          ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom.app F).hom =
      ((TopCat.Presheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F.presheaf) ≫
        (TopCat.Presheaf.pushforward CommRingCat.{u} f).map
          (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
            ((TopCat.Presheaf.pullback CommRingCat.{u} f).obj F.presheaf)) :=
    congrArg (fun t => CategoryTheory.InducedCategory.Hom.hom t)
      (Adjunction.unit_leftAdjointUniq_hom_app
        (TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f)
        (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (Opens.map f)
          CommRingCat.{u} _ _) F)
  have happ : IsIso ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom.app F) :=
    NatIso.isIso_app_of_isIso (TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom F
  have hiso1 : IsIso ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        ((TopCat.Presheaf.pullback CommRingCat.{u} f).obj F.presheaf))) :=
    TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x CommRingCat.{u} _
  have hiso2 : IsIso (TopCat.Presheaf.stalkPullbackHom CommRingCat.{u} f F.presheaf x) :=
    (TopCat.Presheaf.stalkPullbackIso CommRingCat.{u} f F.presheaf x).isIso_hom
  have hiso3 : IsIso ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map
      ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom.app F).hom) :=
    isIso_stalkFunctor_map_of_iso x CommRingCat.{u}
      { hom := ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom.app F).hom
        inv := ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).inv.app F).hom
        hom_inv_id := congrArg (fun t => CategoryTheory.InducedCategory.Hom.hom t)
          ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom_inv_id_app F)
        inv_hom_id := congrArg (fun t => CategoryTheory.InducedCategory.Hom.hom t)
          ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).inv_hom_id_app F) }
  refine isIso_of_comp_eq _
    ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map
      ((TopCat.Sheaf.pullbackIso CommRingCat.{u} f).hom.app F).hom)
    (TopCat.Presheaf.stalkPullbackHom CommRingCat.{u} f F.presheaf x ≫
      (TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map
        (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
          ((TopCat.Presheaf.pullback CommRingCat.{u} f).obj F.presheaf))) hiso3
    (IsIso.comp_isIso' hiso2 hiso1) ?_
  exact (stalkComparison_comp f CommRingCat.{u} _ _ x).symm.trans
    ((congrArg (fun t => stalkComparison f CommRingCat.{u} t x) hunit).trans
      (stalkComparison_comp f CommRingCat.{u} _ _ x))

/-- **Every germ of the inverse image of a sheaf of commutative rings is the germ of the image
of a section.**  The stalk comparison of the unit is an isomorphism, so every germ of `f⁻¹F` at
`x` is its value on a germ of `F` at `f x`;  that germ is the germ of a section `a` over some
neighbourhood `U` of `f x`, and the comparison takes it to the germ of the unit applied to
`a`. -/
public theorem exists_germ_eq_unit (F : Y.Sheaf CommRingCat.{u}) (x : X)
    (b : ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.stalk x) :
    ∃ (U : Opens Y) (hU : f x ∈ U) (a : F.presheaf.obj (op U)),
      b = ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.germ
        ((Opens.map f).obj U) x hU
        ((((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom.app
          (op U)) a) := by
  have hiso := isIso_stalkComparison f F x
  have hsurj := @IsIso.inv_hom_id _ _ _ _ _ hiso
  obtain ⟨U, hU, a, ha⟩ := F.presheaf.exists_germ_eq
    ((@inv _ _ _ _ _ hiso) ((_root_.id b : _)))
  refine ⟨U, hU, a, ?_⟩
  have h0 : (stalkComparison f CommRingCat.{u}
        ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom x)
      ((@inv _ _ _ _ _ hiso) b) = b :=
    congrArg (fun t => (ConcreteCategory.hom t) b) hsurj
  have h1 := germ_stalkComparison f CommRingCat.{u}
    ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom x U hU
  have h2 : (stalkComparison f CommRingCat.{u}
        ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom x)
        (F.presheaf.germ U (f x) hU a) =
      ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.germ
        ((Opens.map f).obj U) x hU
        ((((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom.app
          (op U)) a) :=
    congrArg (fun t => (ConcreteCategory.hom t) a) h1
  exact (h0.symm.trans (congrArg (fun t => (stalkComparison f CommRingCat.{u}
    ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom x) t)
    ha.symm)).trans h2

/-- **Every section of the inverse image of a sheaf of commutative rings agrees locally with the
image of a section.**  This is `exists_germ_eq_unit` turned into a statement about sections by
`TopCat.Presheaf.germ_eq`. -/
public theorem exists_restrict_eq_unit (F : Y.Sheaf CommRingCat.{u}) (x : X) (V : Opens X)
    (hx : x ∈ V) (b : ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.obj (op V)) :
    ∃ (U : Opens Y) (W : Opens X) (_ : x ∈ W) (iV : W ⟶ V)
      (iU : W ⟶ (Opens.map f).obj U) (a : F.presheaf.obj (op U)),
      ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.map iV.op b =
        ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.map iU.op
          ((((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f).unit.app F).hom.app
            (op U)) a) := by
  obtain ⟨U, hU, a, ha⟩ := exists_germ_eq_unit f F x
    (((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.germ V x hx b)
  obtain ⟨W, hW, iV, iU, h⟩ :=
    ((TopCat.Sheaf.pullback CommRingCat.{u} f).obj F).presheaf.germ_eq x hx hU b _ ha
  exact ⟨U, W, hW, iV, iU, a, h⟩

end SheafUnit

end Stacks.Sheaves.PullbackUnit

end
