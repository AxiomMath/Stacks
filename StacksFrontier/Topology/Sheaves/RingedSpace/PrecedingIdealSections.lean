module

public import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise
public import Mathlib.Geometry.RingedSpace.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# Sections lying locally in the ideal generated by the preceding members of a sequence

Let `X` be a ringed space and let `f₀, …, f_{n-1}` be global sections of its structure sheaf.
A section of `O_X` over an open `U` lies *locally in the ideal preceding `f i`* when every point
of `U` has a neighbourhood on which the section is a linear combination of `f₀, …, f_{i-1}`.
This is the sectionwise membership condition for the ideal sheaf generated by the sections
preceding `f i`: it is the condition that cuts out the quotient `O_X/(f₀, …, f_{i-1})` whose
multiplication endomorphism is the datum of Stacks Tag 0639.

The condition mentions no stalk, so it is stated for a ringed space whose carrier and whose
rings of sections live in independent universes. Both the construction of the quotient sheaf
and the stalkwise computations at it are phrased in terms of this one predicate.

## Main definitions

* `AlgebraicGeometry.IsLocallyInPrecedingIdeal`: the sectionwise membership condition for the
  ideal sheaf generated by the global sections preceding `f i`.

## Main results

* `AlgebraicGeometry.isLocallyInPrecedingIdeal_self`: a global section strictly preceding `f i`
  satisfies the condition over the whole space, with the obvious coefficient vector.

## References

* [Stacks Project, Tag 0639](https://stacks.math.columbia.edu/tag/0639)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace

universe u v

namespace AlgebraicGeometry

/-- A section belongs locally to the ideal generated by the global sections
strictly preceding `f i`. This is the sectionwise membership condition for
the generated ideal sheaf. -/
public def IsLocallyInPrecedingIdeal (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n)
    (U : Opens X) (s : X.presheaf.obj (op U)) : Prop :=
  ∀ x : X, x ∈ U →
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U)
      (a : Fin i.val → X.presheaf.obj (op V)),
      X.presheaf.map (homOfLE hVU).op s =
        ∑ j, a j * X.presheaf.map (homOfLE le_top).op
          (f ⟨j.val, lt_trans j.isLt i.isLt⟩)

/-- A global section strictly preceding `f i` lies in the ideal generated by the sections
strictly preceding `f i`, over the whole space. -/
theorem isLocallyInPrecedingIdeal_self (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) (j : Fin i.val) :
    IsLocallyInPrecedingIdeal X f i ⊤ (f ⟨j.val, j.isLt.trans i.isLt⟩) := by
  intro y _
  refine ⟨⊤, trivial, le_rfl, fun k ↦ if k = j then 1 else 0, ?_⟩
  have key : ∀ k : Fin i.val,
      (if k = j then (1 : X.presheaf.obj (op (⊤ : Opens X))) else 0) *
          X.presheaf.map (homOfLE le_top).op (f ⟨k.val, k.isLt.trans i.isLt⟩) =
        if k = j then
          X.presheaf.map (homOfLE (le_top : (⊤ : Opens X) ≤ ⊤)).op
            (f ⟨j.val, j.isLt.trans i.isLt⟩)
        else 0 := by
    intro k
    by_cases hk : k = j
    · subst hk; simp
    · simp [hk]
  simp only [key, Finset.sum_ite_eq' Finset.univ j, Finset.mem_univ, ite_true]

end AlgebraicGeometry

end
