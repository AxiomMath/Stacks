/-!
# Quasi-components, and a space in which they differ from connected components

The *quasi-component* of a point `x` of a topological space is the intersection of all
open-and-closed subsets containing `x`. Mathlib has no name for this set, so it is introduced
here as `quasiComponent`. The connected component of `x` is always contained in the
quasi-component, because a preconnected set meeting a clopen set is contained in it.

The containment can be strict (Stacks 0FIY). Following Engelking's Example 6.1.24, the type
`Engelking` is the set `X = {x, y, z 0, z 1, z 2, …}` with the topology whose basis of opens
consists of the singletons `{z n}` together with the "tails" `{x, z n, z (n+1), …}` and
`{y, z n, z (n+1), …}`. There the connected component of `x` is `{x}`, while its
quasi-component is `{x, y}`. Stacks omits the details of this example; they are supplied here.

## Main definitions

* `quasiComponent`: the intersection of all clopen sets containing a point.
* `Engelking`: the space `{x, y, z 0, z 1, z 2, …}` of Engelking's Example 6.1.24.

## Main results

* `connectedComponent_subset_quasiComponent`: the connected component of a point is contained in
  its quasi-component.
* `Engelking.eq_generateFrom_basis`: the topology on `Engelking` is generated by the sets `{z n}`,
  `{x} ∪ tail n` and `{y} ∪ tail n`.
* `Engelking.quasiComponent_x`: in `Engelking` the quasi-component of `x` is `{x, y}`.
* `Engelking.connectedComponent_x`: in `Engelking` the connected component of `x` is `{x}`.
* `exists_connectedComponent_ne_quasiComponent` (Stacks 0FIY): in general the connected
  component and the quasi-component of a point differ.

## Implementation notes

The topology on `Engelking` is *not* defined as `TopologicalSpace.generateFrom` of that basis.
It is instead given by the explicit predicate `Engelking.IsOpenPred`: a set is open exactly
when it contains a tail of the `z`'s around whichever of the two points `x`, `y` it contains.
That the two descriptions agree is proved: `Engelking.isTopologicalBasis_basis` shows the
stated family is a topological basis, and `Engelking.eq_generateFrom_basis` deduces that the
topology is the one generated by it. Working with the predicate keeps every openness check a
one-liner, while the basis lemma certifies that the space really is Engelking's.
-/

@[expose] public section

open Set

variable {X : Type*} [TopologicalSpace X]

/-! ## Quasi-components -/

/-- The **quasi-component** of a point `x`: the intersection of all open-and-closed subsets of the
ambient space containing `x`. It is a closed set containing the connected component of `x`, and
the containment can be strict (Stacks 0FIY). -/
def quasiComponent (x : X) : Set X := ⋂₀ {s : Set X | IsClopen s ∧ x ∈ s}

/-- A point `p` lies in the quasi-component of `x` if and only if every clopen set containing `x`
contains `p`. -/
theorem mem_quasiComponent_iff {x p : X} :
    p ∈ quasiComponent x ↔ ∀ s : Set X, IsClopen s → x ∈ s → p ∈ s := by
  simp [quasiComponent, mem_sInter, mem_ofPred_eq, and_imp]

/-- Every point lies in its own quasi-component. -/
theorem mem_quasiComponent_self (x : X) : x ∈ quasiComponent x :=
  mem_quasiComponent_iff.2 fun _ _ hx => hx

/-- The connected component of a point is contained in its quasi-component: a preconnected set
meeting a clopen set is contained in that clopen set. This is the "it is clear that `Z ⊆ E`"
half of Stacks 0FIY. -/
theorem connectedComponent_subset_quasiComponent (x : X) :
    connectedComponent x ⊆ quasiComponent x :=
  subset_sInter fun _ hs => hs.1.connectedComponent_subset hs.2

/-! ## Engelking's example -/

/-- The underlying set `{x, y, z 0, z 1, z 2, …}` of Engelking's Example 6.1.24, a space in which
the connected component and the quasi-component of a point differ (Stacks 0FIY). Its topology is
the `TopologicalSpace` instance below. -/
inductive Engelking : Type
  /-- The point whose connected component is smaller than its quasi-component. -/
  | x : Engelking
  /-- The extra point of the quasi-component of `x`. -/
  | y : Engelking
  /-- The isolated points, indexed by `ℕ`. -/
  | z : ℕ → Engelking

namespace Engelking

/-- The tail `{z N, z (N + 1), …}` of the isolated points. -/
def tail (N : ℕ) : Set Engelking := {p | ∃ n, N ≤ n ∧ p = z n}

/-- Membership in `tail N`: being `z n` for some `n ≥ N`. -/
theorem mem_tail {N : ℕ} {p : Engelking} : p ∈ tail N ↔ ∃ n, N ≤ n ∧ p = z n := Iff.rfl

/-- The point `z n` lies in `tail N` whenever `N ≤ n`. -/
theorem z_mem_tail {N n : ℕ} (h : N ≤ n) : z n ∈ tail N := mem_tail.2 ⟨n, h, rfl⟩

/-- The tails decrease: `tail M ⊆ tail N` whenever `N ≤ M`. -/
theorem tail_subset_tail {N M : ℕ} (h : N ≤ M) : tail M ⊆ tail N := fun _ hp => by
  obtain ⟨n, hn, rfl⟩ := mem_tail.1 hp
  exact mem_tail.2 ⟨n, h.trans hn, rfl⟩

/-- The point `x` is none of the points `z n`. -/
theorem x_ne_z (n : ℕ) : x ≠ z n := fun h => Engelking.noConfusion h

/-- The point `y` is none of the points `z n`. -/
theorem y_ne_z (n : ℕ) : y ≠ z n := fun h => Engelking.noConfusion h

/-- The point `x` lies in no tail. -/
theorem x_notMem_tail (N : ℕ) : x ∉ tail N := fun hp =>
  (mem_tail.1 hp).elim fun n hn => x_ne_z n hn.2

/-- The point `y` lies in no tail. -/
theorem y_notMem_tail (N : ℕ) : y ∉ tail N := fun hp =>
  (mem_tail.1 hp).elim fun n hn => y_ne_z n hn.2

/-- The open sets of `Engelking`: a set is open exactly when it contains a tail of the isolated
points around each of `x` and `y` that it contains. -/
def IsOpenPred (s : Set Engelking) : Prop :=
  (x ∈ s → ∃ N, tail N ⊆ s) ∧ (y ∈ s → ∃ N, tail N ⊆ s)

/-- The topology on `Engelking` whose open sets are those satisfying `IsOpenPred`. -/
instance : TopologicalSpace Engelking where
  IsOpen := IsOpenPred
  isOpen_univ := ⟨fun _ => ⟨0, subset_univ _⟩, fun _ => ⟨0, subset_univ _⟩⟩
  isOpen_inter s t hs ht := by
    have key : ∀ (p : Engelking), (∀ u : Set Engelking, p ∈ u → IsOpenPred u →
        ∃ N, tail N ⊆ u) → p ∈ s ∩ t → ∃ N, tail N ⊆ s ∩ t := by
      intro p hp hmem
      obtain ⟨N, hN⟩ := hp s hmem.1 hs
      obtain ⟨M, hM⟩ := hp t hmem.2 ht
      exact ⟨max N M, fun q hq => ⟨hN (tail_subset_tail (le_max_left N M) hq),
        hM (tail_subset_tail (le_max_right N M) hq)⟩⟩
    exact ⟨key x (fun _ hu h => h.1 hu), key y (fun _ hu h => h.2 hu)⟩
  isOpen_sUnion S hS := by
    have key : ∀ (p : Engelking), (∀ u : Set Engelking, u ∈ S → p ∈ u →
        ∃ N, tail N ⊆ u) → p ∈ ⋃₀ S → ∃ N, tail N ⊆ ⋃₀ S := by
      intro _ hp hmem
      obtain ⟨u, huS, hpu⟩ := hmem
      obtain ⟨N, hN⟩ := hp u huS hpu
      exact ⟨N, hN.trans (subset_sUnion_of_mem huS)⟩
    exact ⟨key x (fun u huS hu => (hS u huS).1 hu), key y (fun u huS hu => (hS u huS).2 hu)⟩

/-- A set is open exactly when it contains a tail of the isolated points around each of `x` and `y`
that it contains. -/
theorem isOpen_iff {s : Set Engelking} :
    IsOpen s ↔ (x ∈ s → ∃ N, tail N ⊆ s) ∧ (y ∈ s → ∃ N, tail N ⊆ s) := Iff.rfl

/-- Anything containing a tail of the isolated points is open. -/
theorem isOpen_of_tail_subset {s : Set Engelking} {N : ℕ} (h : tail N ⊆ s) : IsOpen s :=
  isOpen_iff.2 ⟨fun _ => ⟨N, h⟩, fun _ => ⟨N, h⟩⟩

/-- Anything avoiding both `x` and `y` is open; in particular every set of isolated points is open,
so each `z n` is isolated. -/
theorem isOpen_of_notMem {s : Set Engelking} (hx : x ∉ s) (hy : y ∉ s) : IsOpen s :=
  isOpen_iff.2 ⟨fun h => absurd h hx, fun h => absurd h hy⟩

/-- The set `{p} ∪ tail N` is open. -/
theorem isOpen_insert_tail (p : Engelking) (N : ℕ) : IsOpen (insert p (tail N)) :=
  isOpen_of_tail_subset (subset_insert p (tail N))

/-- Each singleton `{z n}` is open. -/
theorem isOpen_singleton_z (n : ℕ) : IsOpen ({z n} : Set Engelking) :=
  isOpen_of_notMem (fun h => x_ne_z n (mem_singleton_iff.1 h))
    (fun h => y_ne_z n (mem_singleton_iff.1 h))

/-! ### The stated basis -/

/-- The basis of opens that Stacks 0FIY writes down: the singletons `{z n}`, the sets
`{x} ∪ tail n` and the sets `{y} ∪ tail n`. -/
def basis : Set (Set Engelking) :=
  {s | (∃ n, s = {z n}) ∨ (∃ n, s = insert x (tail n)) ∨ (∃ n, s = insert y (tail n))}

/-- Membership in `basis`: being `{z n}`, `{x} ∪ tail n` or `{y} ∪ tail n` for some `n`. -/
theorem mem_basis {s : Set Engelking} :
    s ∈ basis ↔
      (∃ n, s = {z n}) ∨ (∃ n, s = insert x (tail n)) ∨ (∃ n, s = insert y (tail n)) :=
  Iff.rfl

/-- The family `basis` is a basis of the topology on `Engelking`. -/
theorem isTopologicalBasis_basis : TopologicalSpace.IsTopologicalBasis basis := by
  refine TopologicalSpace.isTopologicalBasis_of_isOpen_of_nhds ?_ ?_
  · intro u hu
    obtain ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩ := mem_basis.1 hu
    · exact isOpen_singleton_z n
    · exact isOpen_insert_tail x n
    · exact isOpen_insert_tail y n
  · intro p u hpu hu
    cases p with
    | x =>
      obtain ⟨N, hN⟩ := (isOpen_iff.1 hu).1 hpu
      exact ⟨insert x (tail N), mem_basis.2 (Or.inr (Or.inl ⟨N, rfl⟩)),
        mem_insert _ _, insert_subset hpu hN⟩
    | y =>
      obtain ⟨N, hN⟩ := (isOpen_iff.1 hu).2 hpu
      exact ⟨insert y (tail N), mem_basis.2 (Or.inr (Or.inr ⟨N, rfl⟩)),
        mem_insert _ _, insert_subset hpu hN⟩
    | z n =>
      exact ⟨{z n}, mem_basis.2 (Or.inl ⟨n, rfl⟩), rfl, singleton_subset_iff.2 hpu⟩

/-- The topology on `Engelking` is the one generated by `basis`, the basis of Stacks 0FIY. -/
theorem eq_generateFrom_basis :
    (inferInstance : TopologicalSpace Engelking) = TopologicalSpace.generateFrom basis :=
  isTopologicalBasis_basis.eq_generateFrom

/-! ### The quasi-component of `x` is `{x, y}` -/

/-- `{x, y} ∪ tail N` is clopen: it is open because it contains a tail, and closed because its
complement is a set of isolated points. -/
theorem isClopen_insert_x_y_tail (N : ℕ) : IsClopen (insert x (insert y (tail N))) := by
  refine ⟨isOpen_compl_iff.1 (isOpen_of_notMem ?_ ?_), ?_⟩
  · exact fun h => h (mem_insert _ _)
  · exact fun h => h (mem_insert_of_mem _ (mem_insert _ _))
  · exact isOpen_of_tail_subset
      ((subset_insert y (tail N)).trans (subset_insert x (insert y (tail N))))

/-- The point `z n` does not lie in `{x, y} ∪ tail (n + 1)`. -/
theorem z_notMem_insert_x_y_tail (n : ℕ) : z n ∉ insert x (insert y (tail (n + 1))) := by
  intro h
  rcases mem_insert_iff.1 h with h | h
  · exact x_ne_z n h.symm
  rcases mem_insert_iff.1 h with h | h
  · exact y_ne_z n h.symm
  obtain ⟨m, hm, hnm⟩ := mem_tail.1 h
  injection hnm with hnm
  omega

/-- Every clopen set containing `x` also contains `y`: it contains a tail of the isolated
points, and so would its complement if `y` were missing, but two tails always meet. -/
theorem mem_of_isClopen_of_mem_x {s : Set Engelking} (hs : IsClopen s) (hx : x ∈ s) : y ∈ s := by
  obtain ⟨N, hN⟩ := (isOpen_iff.1 hs.2).1 hx
  by_contra hy
  obtain ⟨M, hM⟩ := (isOpen_iff.1 hs.1.isOpen_compl).2 hy
  exact hM (z_mem_tail (le_max_right N M)) (hN (z_mem_tail (le_max_left N M)))

/-- In Engelking's space the quasi-component of `x` is `{x, y}`. -/
theorem quasiComponent_x : quasiComponent x = {x, y} := by
  refine Subset.antisymm (fun p hp => ?_) (fun p hp => ?_)
  · cases p with
    | x => exact mem_insert _ _
    | y => exact mem_insert_of_mem _ rfl
    | z n =>
      exact absurd
        (mem_quasiComponent_iff.1 hp _ (isClopen_insert_x_y_tail (n + 1)) (mem_insert _ _))
        (z_notMem_insert_x_y_tail n)
  · rcases hp with rfl | rfl
    · exact mem_quasiComponent_self _
    · exact mem_quasiComponent_iff.2 fun _ hs hxs => mem_of_isClopen_of_mem_x hs hxs

/-! ### The connected component of `x` is `{x}` -/

/-- A point different from `q` and outside `tail N` is outside `{q} ∪ tail N`. -/
private theorem notMem_insert_tail_of_ne {p q : Engelking} {N : ℕ} (hne : p ≠ q)
    (hp : p ∉ tail N) : p ∉ insert q (tail N) := fun h => (mem_insert_iff.1 h).elim hne hp

/-- The point `x` does not lie in `{y} ∪ tail N`. -/
theorem x_notMem_insert_y_tail (N : ℕ) : x ∉ insert y (tail N) :=
  notMem_insert_tail_of_ne (fun h => Engelking.noConfusion h) (x_notMem_tail N)

/-- The point `y` does not lie in `{x} ∪ tail N`. -/
theorem y_notMem_insert_x_tail (N : ℕ) : y ∉ insert x (tail N) :=
  notMem_insert_tail_of_ne (fun h => Engelking.noConfusion h) (y_notMem_tail N)

/-- A subset of `{x, y}` containing both `x` and `y` is not preconnected: `{x} ∪ tail 0` and
`{y} ∪ tail 0` are open, cover it, meet it, and their intersection `tail 0` misses it. -/
theorem not_isPreconnected_of_subset_pair {s : Set Engelking} (hs : s ⊆ {x, y}) (hx : x ∈ s)
    (hy : y ∈ s) : ¬ IsPreconnected s := by
  intro hconn
  have hcover : s ⊆ insert x (tail 0) ∪ insert y (tail 0) := by
    intro q hq
    rcases hs hq with rfl | rfl
    · exact Or.inl (mem_insert _ _)
    · exact Or.inr (mem_insert _ _)
  obtain ⟨p, hps, hpu, hpv⟩ :=
    hconn (insert x (tail 0)) (insert y (tail 0)) (isOpen_insert_tail x 0)
      (isOpen_insert_tail y 0) hcover ⟨x, hx, mem_insert _ _⟩ ⟨y, hy, mem_insert _ _⟩
  rcases hs hps with rfl | rfl
  · exact x_notMem_insert_y_tail 0 hpv
  · exact y_notMem_insert_x_tail 0 hpu

/-- In Engelking's space the connected component of `x` is the singleton `{x}`. -/
theorem connectedComponent_x : connectedComponent x = {x} := by
  refine Subset.antisymm (fun p hp => ?_) (singleton_subset_iff.2 mem_connectedComponent)
  have hsub : connectedComponent x ⊆ ({x, y} : Set Engelking) := by
    rw [← quasiComponent_x]
    exact connectedComponent_subset_quasiComponent x
  rcases hsub hp with rfl | rfl
  · rfl
  · exact absurd isPreconnected_connectedComponent
      (not_isPreconnected_of_subset_pair hsub mem_connectedComponent hp)

/-- In Engelking's space the connected component of `x` is strictly smaller than its
quasi-component: `{x} ≠ {x, y}`. -/
theorem connectedComponent_ne_quasiComponent :
    connectedComponent x ≠ quasiComponent x := by
  rw [connectedComponent_x, quasiComponent_x]
  intro h
  have hy : (y : Engelking) ∈ ({x} : Set Engelking) := by
    rw [h]; exact mem_insert_of_mem _ rfl
  exact Engelking.noConfusion (mem_singleton_iff.1 hy)

end Engelking

/-- **Stacks 0FIY** (Engelking, Example 6.1.24). In general the connected component `Z` of a
point and its quasi-component `E` — the intersection of all clopen sets containing it — are
different, even though `Z ⊆ E` always holds (`connectedComponent_subset_quasiComponent`).

The witness is `Engelking`, the space `{x, y, z 0, z 1, …}` with basis of opens `{z n}`,
`{x} ∪ {z n, z (n+1), …}` and `{y} ∪ {z n, z (n+1), …}`, at the point `x`: there
`Z = {x}` while `E = {x, y}`. -/
@[stacks 0FIY]
theorem exists_connectedComponent_ne_quasiComponent :
    ∃ (X : Type) (_ : TopologicalSpace X) (x : X),
      connectedComponent x ≠ quasiComponent x :=
  ⟨Engelking, inferInstance, Engelking.x, Engelking.connectedComponent_ne_quasiComponent⟩

end
