module

public import Mathlib.Topology.Constructible
public import Mathlib.Topology.JacobsonSpace
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Constructible sets of a Jacobson space and of its closed points (Stacks 005Y)

Let `X` be a Jacobson topological space and let `X₀ = closedPoints X` carry the subspace
topology. Stacks 005Y asserts that `E ↦ E ∩ X₀` is a bijection from the constructible subsets of
`X` onto the constructible subsets of `X₀`, that it and its inverse preserve inclusions, and that
it matches the retrocompact opens of `X` with the retrocompact opens of `X₀` and likewise their
complements.

Constructibility is Mathlib's `Topology.IsConstructible`, the Boolean subalgebra of `Set X`
generated by the retrocompact opens; the source's description of a constructible set as a finite
union `⋃ i, Uᵢ ∩ Vᵢᶜ` of differences of retrocompact opens describes the same Boolean subalgebra,
since the retrocompact opens are closed under finite unions and intersections. Intersecting with
`X₀` is realized as `JacobsonSpace.restrictToClosedPoints`, the preimage along the inclusion
`X₀ ↪ X`; on the level of subsets of `X₀` this is literally `E ∩ X₀`, but as a subset of the
subtype it is the object whose constructibility in the subspace topology the statement is about.

Everything rests on two Jacobson inputs. First, a nonempty locally closed subset of `X` meets
`X₀` (Mathlib's `nonempty_inter_closedPoints`), which upgrades to nonempty constructible subsets
because a constructible set that contains a point contains a locally closed set containing that
point (`Topology.IsConstructible.exists_isLocallyClosed_subset`, proved by the Boolean induction
`Topology.IsConstructible.empty_union_induction`, whose complement step is what forces the
two-sided "inside `E` or inside `Eᶜ`" formulation). Second, compactness and hence retrocompactness
of an open set may be tested after restricting to the closed points, because the part of an open
set omitted by a lifted cover is locally closed and so would contain a closed point. Together
these give injectivity — the difference of two constructible sets is constructible, so a strict
inclusion is witnessed by a closed point — while surjectivity lifts a constructible subset of
`X₀` through the same Boolean induction, one retrocompact open at a time.
-/

@[expose] public section

open Set Topology

variable {X : Type*} [TopologicalSpace X]

namespace Topology.IsConstructible

/-- A constructible set is locally cut out by locally closed sets: given a locally closed `Z` and
a point `x ∈ Z`, the set `Z` can be shrunk to a locally closed `W` with `x ∈ W ⊆ Z` that lies
either inside `E` or inside its complement.

The two-sided conclusion is what makes the statement stable under complementation, and hence
provable by the Boolean induction `Topology.IsConstructible.empty_union_induction`; carrying the
point `x` along is what makes the union step work, since it records which of the two alternatives
holds. -/
lemma exists_isLocallyClosed_subset_or_subset_compl {E : Set X} (hE : IsConstructible E) :
    ∀ Z, IsLocallyClosed Z → ∀ x ∈ Z,
      ∃ W, IsLocallyClosed W ∧ x ∈ W ∧ W ⊆ Z ∧ (W ⊆ E ∨ W ⊆ Eᶜ) := by
  induction hE using IsConstructible.empty_union_induction with
  | open_retrocompact U hU _ =>
    intro Z hZ x hx
    by_cases hxU : x ∈ U
    · exact ⟨Z ∩ U, hZ.inter hU.isLocallyClosed, ⟨hx, hxU⟩, inter_subset_left,
        Or.inl inter_subset_right⟩
    · exact ⟨Z ∩ Uᶜ, hZ.inter hU.isClosed_compl.isLocallyClosed, ⟨hx, hxU⟩, inter_subset_left,
        Or.inr inter_subset_right⟩
  | union A _ B _ ihA ihB =>
    intro Z hZ x hx
    obtain ⟨W₁, hW₁lc, hxW₁, hW₁Z, hW₁⟩ := ihA Z hZ x hx
    obtain ⟨W₂, hW₂lc, hxW₂, hW₂W₁, hW₂⟩ := ihB W₁ hW₁lc x hxW₁
    refine ⟨W₂, hW₂lc, hxW₂, hW₂W₁.trans hW₁Z, ?_⟩
    rcases hW₁ with hA | hA
    · exact Or.inl ((hW₂W₁.trans hA).trans subset_union_left)
    · rcases hW₂ with hB | hB
      · exact Or.inl (hB.trans subset_union_right)
      · exact Or.inr ((subset_inter (hW₂W₁.trans hA) hB).trans (compl_union A B).superset)
  | compl A _ ihA =>
    intro Z hZ x hx
    obtain ⟨W, hWlc, hxW, hWZ, hW⟩ := ihA Z hZ x hx
    refine ⟨W, hWlc, hxW, hWZ, ?_⟩
    rcases hW with h | h
    · exact Or.inr (by rwa [compl_compl])
    · exact Or.inl h

/-- A nonempty constructible set contains a nonempty locally closed set. -/
lemma exists_isLocallyClosed_subset {E : Set X} (hE : IsConstructible E) (hne : E.Nonempty) :
    ∃ Z, IsLocallyClosed Z ∧ Z.Nonempty ∧ Z ⊆ E := by
  obtain ⟨x, hx⟩ := hne
  obtain ⟨W, hWlc, hxW, -, hW⟩ :=
    hE.exists_isLocallyClosed_subset_or_subset_compl univ isOpen_univ.isLocallyClosed x (mem_univ x)
  rcases hW with h | h
  · exact ⟨W, hWlc, ⟨x, hxW⟩, h⟩
  · exact absurd hx (h hxW)

end Topology.IsConstructible

namespace JacobsonSpace

/-- The map `E ↦ E ∩ X₀` of Stacks 005Y, realized as the preimage of `E` under the inclusion
`X₀ = closedPoints X ↪ X`. -/
def restrictToClosedPoints (E : Set X) : Set (closedPoints X) :=
  (Subtype.val : closedPoints X → X) ⁻¹' E

/-- Restriction to the closed points commutes with unions. -/
@[simp]
lemma restrictToClosedPoints_union (E F : Set X) :
    restrictToClosedPoints (E ∪ F) =
      restrictToClosedPoints E ∪ restrictToClosedPoints F := preimage_union

/-- Restriction to the closed points commutes with complements. -/
@[simp]
lemma restrictToClosedPoints_compl (E : Set X) :
    restrictToClosedPoints Eᶜ = (restrictToClosedPoints E)ᶜ := preimage_compl

/-- In a Jacobson space, compactness of an open set is detected on the closed points.

For the forward implication, a cover of `E ∩ X₀` by opens of `X₀` extends to a family of opens of
`X`, and the part of `E` it fails to cover is locally closed, hence would contain a closed point;
so the extended family covers `E` and a finite subcover of `E` restricts to one of `E ∩ X₀`. The
converse argument is the same with the roles of the two covers exchanged. -/
lemma isCompact_iff_isCompact_restrictToClosedPoints [JacobsonSpace X] {O : Set X}
    (hO : IsOpen O) : IsCompact O ↔ IsCompact (restrictToClosedPoints O) := by
  -- An open `V` containing the closed points of `O` contains `O`: what it misses of `O` is
  -- locally closed, so it would contain a closed point.
  have hsub : ∀ V : Set X, IsOpen V → O ∩ closedPoints X ⊆ V → O ⊆ V := fun V hV h => by
    by_contra hne
    obtain ⟨y, ⟨hyO, hyV⟩, hycp⟩ := nonempty_inter_closedPoints (nonempty_of_not_subset hne)
      (hO.isLocallyClosed.inter hV.isClosed_compl.isLocallyClosed)
    exact hyV (h ⟨hyO, hycp⟩)
  constructor
  · intro hK
    rw [isCompact_iff_finite_subcover] at hK ⊢
    intro ι W hWopen hWcover
    choose V hVopen hVeq using fun i => isOpen_induced_iff.mp (hWopen i)
    have hcover : O ∩ closedPoints X ⊆ ⋃ i, V i := fun x hx => by
      obtain ⟨i, hi⟩ := mem_iUnion.mp
        (hWcover (show (⟨x, hx.2⟩ : closedPoints X) ∈ restrictToClosedPoints O from hx.1))
      exact mem_iUnion.mpr ⟨i, by rwa [← hVeq i] at hi⟩
    obtain ⟨s, hs⟩ :=
      hK V hVopen (hsub _ (isOpen_iUnion hVopen) hcover)
    refine ⟨s, fun x hx => ?_⟩
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.mp (hs (show (x : X) ∈ O from hx))
    exact mem_iUnion₂.mpr ⟨i, hi, by rwa [← hVeq i]⟩
  · intro hK
    rw [isCompact_iff_finite_subcover] at hK ⊢
    intro ι U hUopen hUcover
    have hcover : restrictToClosedPoints O ⊆ ⋃ i, Subtype.val ⁻¹' (U i) := fun x hx =>
      mem_iUnion.mpr (mem_iUnion.mp (hUcover hx) : ∃ i, (x : X) ∈ U i)
    obtain ⟨s, hs⟩ := hK _ (fun i => (hUopen i).preimage continuous_subtype_val) hcover
    refine ⟨s, hsub _ (isOpen_biUnion fun i _ => hUopen i) fun y hy => ?_⟩
    obtain ⟨i, hi, hyi⟩ := mem_iUnion₂.mp
      (hs (show (⟨y, hy.2⟩ : closedPoints X) ∈ restrictToClosedPoints O from hy.1))
    exact mem_iUnion₂.mpr ⟨i, hi, hyi⟩

/-- In a Jacobson space, retrocompactness of an open set is detected on the closed points.

Both directions transport a compact open test set through
`JacobsonSpace.isCompact_iff_isCompact_restrictToClosedPoints`, using that restriction to the
closed points commutes with intersections and takes opens to opens. -/
lemma isRetrocompact_iff_isRetrocompact_restrictToClosedPoints [JacobsonSpace X] {U : Set X}
    (hU : IsOpen U) : IsRetrocompact U ↔ IsRetrocompact (restrictToClosedPoints U) := by
  have hinter : ∀ E F : Set X, restrictToClosedPoints (E ∩ F) =
      restrictToClosedPoints E ∩ restrictToClosedPoints F := fun _ _ => preimage_inter
  constructor
  · intro hRetro K₀ hK₀ hK₀open
    obtain ⟨K, hKopen, rfl⟩ := isOpen_induced_iff.mp hK₀open
    have hK : IsCompact K := (isCompact_iff_isCompact_restrictToClosedPoints hKopen).mpr hK₀
    have hUK := (isCompact_iff_isCompact_restrictToClosedPoints (hU.inter hKopen)).mp
      (hRetro hK hKopen)
    rwa [hinter] at hUK
  · intro hRetro K hK hKopen
    rw [isCompact_iff_isCompact_restrictToClosedPoints (hU.inter hKopen), hinter]
    exact hRetro ((isCompact_iff_isCompact_restrictToClosedPoints hKopen).mp hK)
      (hKopen.preimage continuous_subtype_val)

/-- In a Jacobson space, every nonempty constructible set contains a closed point. -/
@[ega "IV 10.3.1" "partial", ega "IV 8.1.3" "more general"]
lemma nonempty_inter_closedPoints_of_isConstructible [JacobsonSpace X] {E : Set X}
    (hE : IsConstructible E) (hne : E.Nonempty) : (E ∩ closedPoints X).Nonempty := by
  obtain ⟨Z, hZlc, hZne, hZE⟩ := hE.exists_isLocallyClosed_subset hne
  obtain ⟨y, hyZ, hycp⟩ := nonempty_inter_closedPoints hZne hZlc
  exact ⟨y, hZE hyZ, hycp⟩

/-- The correspondence of Stacks 005Y is well defined: for a constructible subset `E` of a
Jacobson space `X`, the subset `E ∩ X₀` of the space of closed points is constructible.

Restriction to the closed points is continuous and preserves retrocompactness of opens, so this
is Mathlib's `Topology.IsConstructible.preimage`. -/
@[stacks 005Y "well-defined", ega "IV 10.4.10" "partial"]
theorem isConstructible_restrictToClosedPoints [JacobsonSpace X] {E : Set X}
    (hE : IsConstructible E) : IsConstructible (restrictToClosedPoints E) := by
  rw [restrictToClosedPoints]
  exact hE.preimage continuous_subtype_val fun _ hUopen hUcomp =>
    (isRetrocompact_iff_isRetrocompact_restrictToClosedPoints hUopen).mp hUcomp

/-- The correspondence of Stacks 005Y reflects inclusions: constructible subsets `E, F` of a
Jacobson space satisfy `E ⊆ F` if and only if `E ∩ X₀ ⊆ F ∩ X₀`.

Only the backward direction has content: `E \ F` is constructible, so if it is nonempty it
contains a closed point, which then witnesses the failure of `E ∩ X₀ ⊆ F ∩ X₀`. -/
@[stacks 005Y "inclusion-preserving",
  ega "IV 10.2.7" "special case",
  ega "IV 10.4.10" "partial",
  ega "IV 8.1.3" "more general"]
theorem subset_iff_restrictToClosedPoints_subset [JacobsonSpace X] {E F : Set X}
    (hE : IsConstructible E) (hF : IsConstructible F) :
    E ⊆ F ↔ restrictToClosedPoints E ⊆ restrictToClosedPoints F := by
  refine ⟨preimage_mono, fun h => ?_⟩
  by_contra hne
  obtain ⟨x, hxD, hxcp⟩ :=
    nonempty_inter_closedPoints_of_isConstructible (hE.sdiff hF) (nonempty_of_not_subset hne)
  exact hxD.2 (h (show (⟨x, hxcp⟩ : closedPoints X) ∈ restrictToClosedPoints E from hxD.1))

/-- Constructible subsets of a Jacobson space with the same closed points are equal. -/
private lemma eq_of_restrictToClosedPoints_eq [JacobsonSpace X] {E F : Set X}
    (hE : IsConstructible E) (hF : IsConstructible F)
    (h : restrictToClosedPoints E = restrictToClosedPoints F) : E = F :=
  ((subset_iff_restrictToClosedPoints_subset hE hF).mpr h.subset).antisymm
    ((subset_iff_restrictToClosedPoints_subset hF hE).mpr h.superset)

/-- Stacks 005Y: on a Jacobson space `X`, restriction to the closed points is a bijection from
the constructible subsets of `X` onto the constructible subsets of `X₀ = closedPoints X`.

Injectivity is the inclusion-reflecting property applied twice. Surjectivity is proved by the
Boolean induction `Topology.IsConstructible.empty_union_induction`: a retrocompact open of `X₀` is
the restriction of an open of `X`, which is retrocompact by
`JacobsonSpace.isRetrocompact_iff_isRetrocompact_restrictToClosedPoints`, and restriction
commutes with unions and complements. -/
@[stacks 005Y "bijective correspondence", ega "IV 10.4.10" "special case"]
theorem restrictToClosedPoints_bijective [JacobsonSpace X] :
    Function.Bijective
      (fun E : {E : Set X // IsConstructible E} =>
        (⟨restrictToClosedPoints E.1, isConstructible_restrictToClosedPoints E.2⟩ :
          {F : Set (closedPoints X) // IsConstructible F})) := by
  constructor
  · rintro ⟨E, hE⟩ ⟨F, hF⟩ heq
    exact Subtype.ext (eq_of_restrictToClosedPoints_eq hE hF (congrArg Subtype.val heq))
  · rintro ⟨F₀, hF₀⟩
    obtain ⟨E, hE, hEeq⟩ : ∃ E : Set X, IsConstructible E ∧ restrictToClosedPoints E = F₀ := by
      induction hF₀ using Topology.IsConstructible.empty_union_induction with
      | open_retrocompact U₀ hU₀open hU₀comp =>
        obtain ⟨U, hUopen, hUeq⟩ := isOpen_induced_iff.mp hU₀open
        have hUretro : IsRetrocompact U := by
          refine (isRetrocompact_iff_isRetrocompact_restrictToClosedPoints hUopen).mpr ?_
          rw [restrictToClosedPoints, hUeq]
          exact hU₀comp
        exact ⟨U, hUretro.isConstructible hUopen, hUeq⟩
      | union A _ B _ ihA ihB =>
        obtain ⟨E₁, hE₁, h₁⟩ := ihA
        obtain ⟨E₂, hE₂, h₂⟩ := ihB
        exact ⟨E₁ ∪ E₂, hE₁.union hE₂, by rw [restrictToClosedPoints_union, h₁, h₂]⟩
      | compl A _ ihA =>
        obtain ⟨E₁, hE₁, h₁⟩ := ihA
        exact ⟨E₁ᶜ, hE₁.compl, by rw [restrictToClosedPoints_compl, h₁]⟩
    exact ⟨⟨E, hE⟩, Subtype.ext hEeq⟩

/-- Stacks 005Y: the correspondence matches the retrocompact opens of `X` with the retrocompact
opens of `X₀`. A constructible subset `E` of a Jacobson space is a retrocompact open if and only
if `E ∩ X₀` is a retrocompact open of the space of closed points.

The backward direction writes `E ∩ X₀` as the restriction of an open `U ⊆ X`, which is
retrocompact and hence constructible; both `U` and `E` are then constructible with the same
restriction, so `U = E` by `JacobsonSpace.subset_iff_restrictToClosedPoints_subset`. -/
@[stacks 005Y "preserves retrocompact opens"]
theorem isOpen_and_isRetrocompact_iff_on_closedPoints [JacobsonSpace X] {E : Set X}
    (hE : IsConstructible E) :
    (IsOpen E ∧ IsRetrocompact E) ↔
      (IsOpen (restrictToClosedPoints E) ∧ IsRetrocompact (restrictToClosedPoints E)) := by
  refine ⟨fun ⟨hEo, hEr⟩ => ⟨hEo.preimage continuous_subtype_val,
    (isRetrocompact_iff_isRetrocompact_restrictToClosedPoints hEo).mp hEr⟩, ?_⟩
  rintro ⟨hΦo, hΦr⟩
  obtain ⟨U, hUo, hUeq⟩ := isOpen_induced_iff.mp hΦo
  have hΦeq : restrictToClosedPoints U = restrictToClosedPoints E := hUeq
  have hUr : IsRetrocompact U :=
    (isRetrocompact_iff_isRetrocompact_restrictToClosedPoints hUo).mpr (hΦeq ▸ hΦr)
  have hUc : IsConstructible U := hUr.isConstructible hUo
  obtain rfl : U = E := eq_of_restrictToClosedPoints_eq hUc hE hΦeq
  exact ⟨hUo, hUr⟩

/-- Stacks 005Y: the correspondence matches the complements of retrocompact opens of `X` with the
complements of retrocompact opens of `X₀`. This is the previous statement applied to `Eᶜ`, which
is constructible, together with the fact that restriction to the closed points commutes with
complementation. -/
@[stacks 005Y "preserves complements of retrocompact opens"]
theorem isOpen_compl_and_isRetrocompact_compl_iff_on_closedPoints [JacobsonSpace X] {E : Set X}
    (hE : IsConstructible E) :
    (IsOpen Eᶜ ∧ IsRetrocompact Eᶜ) ↔
      (IsOpen (restrictToClosedPoints E)ᶜ ∧ IsRetrocompact (restrictToClosedPoints E)ᶜ) := by
  rw [← restrictToClosedPoints_compl]
  exact isOpen_and_isRetrocompact_iff_on_closedPoints hE.compl

end JacobsonSpace
