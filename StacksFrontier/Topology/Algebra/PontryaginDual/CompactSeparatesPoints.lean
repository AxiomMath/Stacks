module

public import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
public import Mathlib.Analysis.CStarAlgebra.GelfandDuality
public import Mathlib.MeasureTheory.Measure.Haar.Basic
public import Mathlib.Topology.Algebra.PontryaginDual
public import Mathlib.Topology.UrysohnsLemma
public import StacksFrontier.Topology.Algebra.PontryaginDual.TranslationOperator

/-!
# Characters of a compact abelian group separate points

Let `A` be a compact Hausdorff commutative topological group and `a ≠ 1` in `A`. We show that
some continuous character `χ : A →ₜ* Circle` has `χ a ≠ 1`.

The proof uses Gelfand duality instead of the spectral theorem for compact operators. Let `μ` be a
Haar measure on `A` and `T` the convolution operator on `L²(A, μ)` with kernel `conj ψ`, `ψ` a bump
function supported so close to `1` that `ψ (y) ψ (y / a) = 0` for all `y`. The translations
`R g` and the self-adjoint operator `P = T⋆ T` commute pairwise, so they generate a commutative
C⋆-algebra `B`. The element `R a P - P` of `B` is nonzero, so by Gelfand duality some character
`φ` of `B` does not vanish on it. Then `χ g = φ (R g)` is multiplicative, of modulus one (the
`R g` are unitary), and continuous because `χ g = φ (R g P) / φ P` and `g ↦ R g P = T⋆ (R g T)`
is norm-continuous (the operator `R g T` has the continuous kernel `ψ` translated by `g`).
Finally `χ a ≠ 1` as `φ (R a P - P) ≠ 0`.

## Main definitions

* `Stacks.Pontryagin.characterOf`: the continuous character `g ↦ φ (tr g)` attached to a
  homomorphism `tr` into a Banach algebra and a character `φ` of that algebra.
* `Stacks.Pontryagin.translationAlgebra μ P`: the closed star subalgebra of operators on
  `L²(A, μ)` generated by the translations and one operator `P`.

## Main results

* `Stacks.Pontryagin.exists_apply_ne_one`: characters of a compact Hausdorff abelian group
  separate points from `1`.
* `Stacks.Pontryagin.injective_eval`: the evaluation map from `A` to functions on its
  Pontryagin dual is injective.

## References

* [Stacks, Tag 03VI]
-/

@[expose] public noncomputable section

open MeasureTheory Filter Topology ComplexConjugate

namespace Stacks.Pontryagin

variable {A : Type*} [CommGroup A] [TopologicalSpace A]

section Character

variable {B : Type*} [NormedRing B] [NormedAlgebra ℂ B] [CompleteSpace B] [NormOneClass B]

/-- A homomorphism `tr : A →* B` into the contractions of a Banach algebra, composed with a
character `φ` of `B`, is a continuous character of `A` as soon as `g ↦ tr g * p` is continuous
for some `p` with `φ p ≠ 0`. -/
def characterOf (tr : A →* B) (htr : ∀ g, ‖tr g‖ ≤ 1) (φ : WeakDual.characterSpace ℂ B) {p : B}
    (hp : φ p ≠ 0) (hc : Continuous fun g => tr g * p) : A →ₜ* Circle where
  toFun g := ⟨φ (tr g), mem_sphere_zero_iff_norm.2 <| by
    have hle : ∀ g, ‖φ (tr g)‖ ≤ 1 := fun g =>
      (spectrum.norm_le_norm_of_mem (WeakDual.CharacterSpace.apply_mem_spectrum φ (tr g))).trans
        (htr g)
    have h1 : ‖φ (tr g)‖ * ‖φ (tr g⁻¹)‖ = 1 := by
      rw [← norm_mul, ← map_mul, ← map_mul, mul_inv_cancel, map_one, map_one, norm_one]
    refine le_antisymm (hle g) ?_
    calc (1 : ℝ) = ‖φ (tr g)‖ * ‖φ (tr g⁻¹)‖ := h1.symm
      _ ≤ ‖φ (tr g)‖ * 1 := mul_le_mul_of_nonneg_left (hle g⁻¹) (norm_nonneg _)
      _ = ‖φ (tr g)‖ := mul_one _⟩
  map_one' := Subtype.ext <| by simp only [map_one]; rfl
  map_mul' g h := Subtype.ext <| by simp only [map_mul]; rfl
  continuous_toFun := by
    refine Continuous.subtype_mk ?_ _
    have heq : (fun g => φ (tr g)) = fun g => φ (tr g * p) / φ p := funext fun g => by
      rw [map_mul, mul_div_cancel_right₀ _ hp]
    rw [heq]
    exact ((map_continuous φ).comp hc).div_const _

/-- The values of `characterOf` are those of `φ ∘ tr`. -/
theorem coe_characterOf_apply (tr : A →* B) (htr : ∀ g, ‖tr g‖ ≤ 1)
    (φ : WeakDual.characterSpace ℂ B) {p : B} (hp : φ p ≠ 0) (hc : Continuous fun g => tr g * p)
    (g : A) : (characterOf tr htr φ hp hc g : ℂ) = φ (tr g) :=
  rfl

/-- If `tr a * p - p ≠ 0` in a commutative C⋆-algebra, some continuous character of `A`
built from a character of `B` is not `1` at `a`. -/
theorem exists_character_of_mul_sub_ne_zero {C : Type*} [CommCStarAlgebra C] (tr : A →* C)
    (htr : ∀ g, ‖tr g‖ ≤ 1) {p : C} (hc : Continuous fun g => tr g * p) {a : A}
    (ha : tr a * p - p ≠ 0) : ∃ χ : PontryaginDual A, χ a ≠ 1 := by
  have : Nontrivial C := nontrivial_of_ne _ _ ha
  obtain ⟨φ, hφ⟩ : ∃ φ : WeakDual.characterSpace ℂ C, φ (tr a * p - p) ≠ 0 := by
    by_contra! h
    refine ha ((gelfandTransform_isometry C).injective ?_)
    rw [map_zero]
    ext φ
    exact h φ
  rw [map_sub, map_mul, ← sub_one_mul] at hφ
  refine ⟨characterOf tr htr φ (right_ne_zero_of_mul hφ) hc, fun h => ?_⟩
  have h' := congrArg (fun z : Circle => (z : ℂ)) h
  exact left_ne_zero_of_mul hφ (sub_eq_zero.2
    ((coe_characterOf_apply tr htr φ (right_ne_zero_of_mul hφ) hc a).symm.trans
      (h'.trans Circle.coe_one)))

end Character

section Gelfand

variable [IsTopologicalGroup A] [MeasurableSpace A] [BorelSpace A] (μ : Measure A)
  [μ.IsMulLeftInvariant]

/-- The closed star subalgebra of operators on `L²(A, μ)` generated by the translations and
one operator `P`. -/
def translationAlgebra (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :
    StarSubalgebra ℂ (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :=
  (StarAlgebra.adjoin ℂ (Set.range (translate μ) ∪ {P})).topologicalClosure

/-- `translationAlgebra μ P` is closed. -/
instance (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :
    IsClosed (translationAlgebra μ P : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- `translationAlgebra μ P` is a C⋆-algebra. -/
instance (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) : CStarAlgebra (translationAlgebra μ P) :=
  StarSubalgebra.cstarAlgebra _

/-- The generators lie in `translationAlgebra μ P`. -/
theorem mem_translationAlgebra {P x : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ}
    (hx : x ∈ Set.range (translate μ) ∪ {P}) : x ∈ translationAlgebra μ P :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ hx)

/-- If `P` is self-adjoint and commutes with the translations, the algebra
`translationAlgebra μ P` is commutative. -/
theorem isMulCommutative_translationAlgebra {P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ} (hP : IsSelfAdjoint P)
    (hcomm : ∀ g, translate μ g * P = P * translate μ g) :
    IsMulCommutative (translationAlgebra μ P) := by
  have hS : ∀ x ∈ Set.range (translate μ) ∪ {P}, ∀ y ∈ Set.range (translate μ) ∪ {P},
      x * y = y * x := by
    rintro x (⟨g, rfl⟩ | rfl) y (⟨h, rfl⟩ | rfl)
    · rw [translate_mul, translate_mul, mul_comm]
    · exact hcomm g
    · exact (hcomm h).symm
    · rfl
  have hSstar : ∀ x ∈ Set.range (translate μ) ∪ {P}, star x ∈ Set.range (translate μ) ∪ {P} := by
    rintro x (⟨g, rfl⟩ | rfl)
    · exact Or.inl ⟨g⁻¹, (star_translate μ g).symm⟩
    · exact Or.inr hP.star_eq
  have : IsMulCommutative (StarAlgebra.adjoin ℂ (Set.range (translate μ) ∪ {P})) :=
    StarAlgebra.isMulCommutative_adjoin ℂ (fun x hx => ⟨hS (star x) (hSstar x hx) x hx⟩)
      (fun x hx y hy _ => hS x hx y hy) fun x hx y hy _ => hS x hx _ (hSstar y hy)
  exact StarSubalgebra.isMulCommutative_topologicalClosure _

/-- The translations, as a homomorphism into `translationAlgebra μ P`. -/
def translateHom (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) : A →* translationAlgebra μ P where
  toFun g := ⟨translate μ g, mem_translationAlgebra μ (Or.inl ⟨g, rfl⟩)⟩
  map_one' := Subtype.ext (translate_one μ)
  map_mul' g h := Subtype.ext (translate_mul μ g h).symm

open scoped IsMulCommutative in
/-- If a self-adjoint operator `P` on `L²(A, μ)` commutes with all translations, depends
norm-continuously on translation, and is not fixed by the translation by `a`, then some
continuous character of `A` does not take the value `1` at `a`. -/
theorem exists_character_of_translate_mul_ne (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)
    (hP : IsSelfAdjoint P) (hcomm : ∀ g, translate μ g * P = P * translate μ g)
    (hcont : Continuous fun g => translate μ g * P) {a : A} (ha : translate μ a * P ≠ P) :
    ∃ χ : PontryaginDual A, χ a ≠ 1 := by
  have := isMulCommutative_translationAlgebra μ hP hcomm
  let p : translationAlgebra μ P := ⟨P, mem_translationAlgebra μ (Or.inr rfl)⟩
  refine exists_character_of_mul_sub_ne_zero (translateHom μ P) (fun g => norm_translate_le μ g)
    (p := p) ?_ (a := a) fun h => ha (sub_eq_zero.1 (congrArg Subtype.val h))
  exact hcont.subtype_mk fun g => (translationAlgebra μ P).mul_mem (translateHom μ P g).2 p.2

end Gelfand

variable [IsTopologicalGroup A] [CompactSpace A]

/-- For `a ≠ 1` there is a nonzero continuous function `ψ` with `ψ (y) ψ (y / a) = 0` for all
`y`. -/
theorem exists_continuousMap_mul_conj_div_eq_zero [T2Space A] {a : A} (ha : a ≠ 1) :
    ∃ ψ : C(A, ℂ), ψ ≠ 0 ∧ ∀ y, ψ y * conj (ψ (y / a)) = 0 := by
  have hs : ({a}ᶜ : Set A) ∈ 𝓝 1 :=
    isOpen_compl_singleton.mem_nhds (Set.mem_compl_singleton_iff.2 ha.symm)
  obtain ⟨V, hV, hVs⟩ := exists_nhds_split_inv hs
  obtain ⟨f, hf0, hf1, -⟩ := exists_continuous_zero_one_of_isClosed
    isOpen_interior.isClosed_compl (isClosed_singleton (x := (1 : A)))
    (Set.disjoint_singleton_right.2 (not_not.2 (mem_interior_iff_mem_nhds.2 hV)))
  have hfV : ∀ y, (f y : ℂ) ≠ 0 → y ∈ V := fun y hy => by
    by_contra h
    exact hy (by rw [hf0 fun h' => h (interior_subset h')]; simp)
  refine ⟨⟨fun x => (f x : ℂ), Complex.continuous_ofReal.comp f.continuous⟩, fun h => ?_,
    fun y => ?_⟩
  · have := congrArg (fun F : C(A, ℂ) => F 1) h
    simp [hf1 (Set.mem_singleton 1)] at this
  · by_contra hne
    have h1 := hfV y (left_ne_zero_of_mul hne)
    have h2 := hfV (y / a) (by simpa using right_ne_zero_of_mul hne)
    exact hVs y h1 (y / a) h2 (by rw [div_div_cancel]; rfl)

/-- Characters of a compact Hausdorff abelian group separate points from `1`: for `a ≠ 1` there is a
continuous character `χ` with `χ a ≠ 1`. -/
@[stacks 03VI "characters of a compact abelian group separate points (input to trivial duality)"]
theorem exists_apply_ne_one [T2Space A] {a : A} (ha : a ≠ 1) :
    ∃ χ : PontryaginDual A, χ a ≠ 1 := by
  borelize A
  let μ : Measure A := Measure.haar
  obtain ⟨ψ, hψ0, hψ⟩ := exists_continuousMap_mul_conj_div_eq_zero ha
  set T := kernelOp μ (kernel μ ψ)
  have hT : ∀ g, translate μ g * T = T * translate μ g := translate_mul_kernelOp_kernel μ ψ
  have hTs : ∀ g, translate μ g * star T = star T * translate μ g := fun g => by
    have := congrArg star (hT g⁻¹)
    rw [star_mul, star_mul, star_translate, inv_inv] at this
    exact this.symm
  have hcomm : ∀ g, translate μ g * (star T * T) = star T * T * translate μ g := fun g => by
    rw [← mul_assoc, hTs, mul_assoc, hT, mul_assoc]
  refine exists_character_of_translate_mul_ne μ (star T * T) (IsSelfAdjoint.star_mul_self T)
    hcomm ?_ (a := a) ?_
  · have : (fun g => translate μ g * (star T * T)) = fun g => star T * (translate μ g * T) :=
      funext fun g => by rw [← mul_assoc, hTs, mul_assoc]
    rw [this]
    exact continuous_const.mul (continuous_translate_mul_kernelOp μ _)
  · intro h
    apply translate_mul_kernelOp_kernel_ne μ ψ hψ0 hψ
    have hY : star (T * (translate μ a - 1)) * (T * (translate μ a - 1)) = 0 := by
      rw [star_mul, mul_assoc, ← mul_assoc (star T), mul_sub, mul_one, ← hcomm, h, sub_self,
        mul_zero]
    rw [CStarRing.star_mul_self_eq_zero_iff, mul_sub, mul_one, sub_eq_zero] at hY
    rw [hT, hY]

/-- The evaluation map `A → (PontryaginDual A → Circle)` of a compact Hausdorff abelian group is
injective. -/
theorem injective_eval [T2Space A] :
    Function.Injective fun (a : A) (χ : PontryaginDual A) => χ a := by
  intro a b h
  by_contra hab
  obtain ⟨χ, hχ⟩ := exists_apply_ne_one (div_ne_one.2 hab)
  have h' : χ a = χ b := congrFun h χ
  exact hχ (by rw [map_div, h', div_self'])

end Stacks.Pontryagin
