module

public import Mathlib.Topology.Algebra.IsUniformGroup.Constructions
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.FormalSpace.Restricted.FiniteTypeComposition
public import StacksFrontier.Topology.Algebra.AdicTopology.CompletionOver
public import StacksFrontier.Topology.Algebra.AdicTopology.FiniteTypeIsLocal
public import StacksFrontier.Topology.Algebra.AdicTopology.LocalProperties

/-!
# Adic morphisms topologically of finite type form a local property

On weakly admissible adic-star rings — linearly topologized rings having a finitely generated
ideal of definition — a continuous homomorphism which is adic and topologically of finite type
is exactly one which is taut and topologically of finite type, by Stacks 0GBS.  Transporting the
locality axioms of Stacks 0ANU along that equivalence shows that the property of Stacks 0GBW is
local in the sense of Situation 0CBA, and combining it with
`TopologicalRing.isAdic_and_isTopologicallyOfFiniteType_comp` shows it is stable under
composition in the sense of Remark 0GBJ.

## Main results

* `TopologicalRing.adicTopologicallyFiniteType_isLocal`: **Stacks 0GBW**, the property of being
  adic and topologically of finite type is a local property of morphisms of weakly admissible
  adic-star rings.
* `TopologicalRing.adicTopologicallyFiniteType_isStableUnderComposition`: **Stacks 0GBZ**, that
  property is stable under composition.

## Implementation notes

The ascent, descent and finite-product axioms of Situation 0CBA quantify over the subclass
`IsCountablyWeaklyAdmissible` for Stacks 0ANU, and over the adic-star subclass for Stacks 0GBW.
A ring with a finitely generated ideal of definition for which the adic topology is the given
one is weakly admissible with a countable fundamental system of open ideals; the completions
appearing in a localization diagram are weakly admissible and countably generated by Tags 0AN6
and 0ANB, so the conversion only has to be made at the four corners of the diagram.

The finite-product axiom needs the product `∀ i, A i` to be linearly topologized over itself,
which is not an instance in Mathlib: `isLinearTopology_pi` supplies it, the rectangular
neighbourhood basis of the product topology being cofinal among the products of the coordinate
submodule bases.

## References

* [Stacks Project, Tag 0GBW](https://stacks.math.columbia.edu/tag/0GBW)
* [Stacks Project, Tag 0GBZ](https://stacks.math.columbia.edu/tag/0GBZ)
* [Stacks Project, Tag 0GBS](https://stacks.math.columbia.edu/tag/0GBS)
* [Stacks Project, Tag 0ANU](https://stacks.math.columbia.edu/tag/0ANU)
-/

@[expose] public section

namespace TopologicalRing

section

universe u

/-- The submodule of a product of modules over the product of their rings cut out by requiring
the coordinates in a given set to lie in chosen coordinate submodules. -/
private def piProdSubmodule {ι : Type*} {R M : ι → Type*}
    [∀ i, Semiring (R i)] [∀ i, AddCommMonoid (M i)] [∀ i, Module (R i) (M i)]
    (S : Set ι) (J : ∀ i, Submodule (R i) (M i)) : Submodule (∀ i, R i) (∀ i, M i) where
  carrier := S.pi fun i ↦ (J i : Set (M i))
  zero_mem' := by simp
  add_mem' := fun {x y} hx hy i hi ↦ (J i).add_mem (hx i hi) (hy i hi)
  smul_mem' := fun r {x} hx i hi ↦ (J i).smul_mem (r i) (hx i hi)

/-- A product of linearly topologized modules is linearly topologized over the product of the
rings: the rectangular neighbourhoods of zero built from the coordinate submodule bases are
themselves submodules and form a basis. -/
private theorem isLinearTopology_pi {ι : Type*} {R M : ι → Type*}
    [∀ i, Ring (R i)] [∀ i, AddCommGroup (M i)] [∀ i, Module (R i) (M i)]
    [∀ i, TopologicalSpace (M i)] [∀ i, IsLinearTopology (R i) (M i)] :
    IsLinearTopology (∀ i, R i) (∀ i, M i) := by
  let hRect := Filter.hasBasis_pi fun i ↦
    (isLinearTopology_iff_hasBasis_submodule (R := R i) (M := M i)).mp inferInstance
  rw [isLinearTopology_iff_hasBasis_submodule, nhds_pi]
  exact hRect.to_hasBasis (fun idx hidx ↦ ⟨piProdSubmodule idx.1 idx.2,
    hRect.mem_of_mem hidx, fun _ hx ↦ hx⟩) fun _ hN ↦ hRect.mem_iff.mp hN

/-- On a morphism from a ring with a finitely generated ideal of definition to a complete
separated linearly topologized ring, adicness together with topological finite type is the same
condition as tautness together with topological finite type (Stacks 0GBS). -/
private theorem isAdic_and_isTopologicallyOfFiniteType_iff
    {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] (φ : B →+* A)
    (hB : ∃ I : Ideal B, I.FG ∧ _root_.IsAdic I)
    (hAcomplete : @CompleteSpace A (IsTopologicalAddGroup.rightUniformSpace A))
    (hAT2 : T2Space A) :
    (RingHom.IsAdic φ ∧ IsTopologicallyOfFiniteType φ) ↔
      (RingHom.IsTaut φ ∧ IsTopologicallyOfFiniteType φ) := by
  let : UniformSpace A := IsTopologicalAddGroup.rightUniformSpace A
  let : CompleteSpace A := hAcomplete
  let : T2Space A := hAT2
  exact and_congr (RingHom.isAdic_iff_isTaut φ hB) Iff.rfl

/-- The completion over a countably indexed weakly admissible ring is again one (Stacks 0ANB). -/
private theorem isCountablyWeaklyAdmissible_completionOver'
    {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] (f : B →+* A) (hB : IsWeaklyAdmissible B)
    (hBc : (nhds (0 : B)).IsCountablyGenerated) : IsCountablyWeaklyAdmissible (CompletionOver f) :=
  ⟨completionOver_isWeaklyAdmissible f hB, completionOver_isCountablyGenerated_nhds_zero f hB hBc⟩

/-- **Stacks 0GBW.** Being adic and topologically of finite type is a local property of
morphisms of weakly admissible adic-star rings: it ascends along completed étale localization
diagrams, descends along faithfully flat ones, and is preserved by finite products of
targets. -/
@[stacks 0GBW "local_property"]
public theorem adicTopologicallyFiniteType_isLocal :
    AdicStarPropertyIsLocal.{u}
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] (φ : B →+* A) ↦
        RingHom.IsAdic φ ∧ IsTopologicallyOfFiniteType φ) := by
  refine ⟨?_, ?_, ?_⟩
  · intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _ hB hA' hB' hMap
    have hA'weak :=
      isCountablyWeaklyAdmissible_completionOver' D.toA' D.weaklyAdmissibleA D.countableA
    have hB'weak :=
      isCountablyWeaklyAdmissible_completionOver' D.toB' D.weaklyAdmissibleB D.countableB
    refine (isAdic_and_isTopologicallyOfFiniteType_iff D.completedMap hB'
      hA'weak.1.2.1 hA'weak.1.2.2).mpr ?_
    exact topologicallyFiniteType_localizationPreserves D
      ⟨D.weaklyAdmissibleA, D.countableA⟩ ⟨D.weaklyAdmissibleB, D.countableB⟩ hA'weak hB'weak
      ((isAdic_and_isTopologicallyOfFiniteType_iff D.map hB
        D.weaklyAdmissibleA.2.1 D.weaklyAdmissibleA.2.2).mp hMap)
  · intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _ hB _ hB' hFF hCompleted
    have hA'weak :=
      isCountablyWeaklyAdmissible_completionOver' D.toA' D.weaklyAdmissibleA D.countableA
    have hB'weak :=
      isCountablyWeaklyAdmissible_completionOver' D.toB' D.weaklyAdmissibleB D.countableB
    refine (isAdic_and_isTopologicallyOfFiniteType_iff D.map hB
      D.weaklyAdmissibleA.2.1 D.weaklyAdmissibleA.2.2).mpr ?_
    exact topologicallyFiniteType_faithfullyFlatDescent D
      ⟨D.weaklyAdmissibleA, D.countableA⟩ ⟨D.weaklyAdmissibleB, D.countableB⟩ hA'weak hB'weak hFF
      ((isAdic_and_isTopologicallyOfFiniteType_iff D.completedMap hB'
        hA'weak.1.2.1 hA'weak.1.2.2).mp hCompleted)
  · intro B _ _ _ _ hB hBcount ι _ A _ _ _ _ hAweak hAcount f hf hBstar _ hfProp
    let : ∀ i, UniformSpace (A i) := fun i ↦ IsTopologicalAddGroup.rightUniformSpace (A i)
    let : ∀ i, CompleteSpace (A i) := fun i ↦ (hAweak i).2.1
    let : ∀ i, T2Space (A i) := fun i ↦ (hAweak i).2.2
    let : ∀ i, IsUniformAddGroup (A i) := fun _ ↦ isUniformAddGroup_of_addCommGroup
    let : IsLinearTopology (∀ i, A i) (∀ i, A i) := isLinearTopology_pi
    refine (isAdic_and_isTopologicallyOfFiniteType_iff (RingHom.pi f) hBstar
      (by rw [IsUniformAddGroup.rightUniformSpace_eq]; infer_instance) inferInstance).mpr ?_
    exact topologicallyFiniteType_finiteProductPreserves hB hBcount A hAweak hAcount f hf
      ⟨hB, hBcount⟩ (fun i ↦ ⟨hAweak i, hAcount i⟩)
      fun i ↦ (isAdic_and_isTopologicallyOfFiniteType_iff (f i) hBstar
        (hAweak i).2.1 (hAweak i).2.2).mp (hfProp i)

/-- **Stacks 0GBZ.** The local property of Stacks 0GBW — being adic and topologically of finite
type — is stable under composition on weakly admissible adic-star rings. -/
@[stacks 0GBZ]
public theorem adicTopologicallyFiniteType_isStableUnderComposition :
    AdicStarPropertyIsStableUnderComposition.{u}
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] (φ : B →+* A) ↦
        RingHom.IsAdic φ ∧ IsTopologicallyOfFiniteType φ) where
  isLocal := adicTopologicallyFiniteType_isLocal
  comp _ _ _ _ _ _ f g hf_cont _ hf hg :=
    isAdic_and_isTopologicallyOfFiniteType_comp f g hf_cont hf hg

end

end TopologicalRing

end
