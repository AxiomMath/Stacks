module

public import Mathlib.RingTheory.AdicCompletion.Topology
public import Mathlib.Topology.Algebra.Ring.Ideal
public import Mathlib.Topology.Algebra.UniformRing
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.AdicCompletion.TateModule.FiniteComplete
public import StacksFrontier.Topology.Algebra.AdicTopology.Completion

/-!
# The completion of a quotient ring

Let `S` be a linearly topologized commutative ring and `J ⊆ S` an ideal, and give `S ⧸ J` the
quotient topology.  The quotient map completes to a ring homomorphism `Ŝ → (S ⧸ J)^`, whose
kernel is the closure of the extension of `J` to `Ŝ` and which is surjective as soon as `S` has
a countable fundamental system of neighbourhoods of zero.  Together these present `(S ⧸ J)^` as
the quotient of `Ŝ` by the closure of `J · Ŝ`.

Both halves are already in the library in module form: the kernel is Tag 0ARZ, read through
`TopologicalRing.exact_completionSubtype_completionQuotient` and
`TopologicalRing.range_completionSubtype_eq_closure`, and surjectivity is Tag 0AS0, read
through `TopologicalRing.completionQuotient_surjective_of_isCountablyGenerated`.  What this
file adds is the ring-level packaging — the quotient map as a `RingHom` of completions, its
kernel as an *ideal* rather than as the closure of an image, and the resulting ring
isomorphism.

## Main definitions

* `TopologicalRing.completionQuotientRingHom`: the ring homomorphism `Ŝ →+* (S ⧸ J)^`.
* `TopologicalRing.completionQuotientRingEquiv`: the ring isomorphism
  `Ŝ ⧸ closure (J · Ŝ) ≃+* (S ⧸ J)^`.

## Main results

* `TopologicalRing.closure_coe_image_eq_closure_map`: in the completion, the closure of the
  image of `J` is the closure of the ideal `J · Ŝ` it generates.
* `TopologicalRing.ker_completionQuotientRingHom`: the kernel is
  `Ideal.closure (J.map coeRingHom)`.
* `TopologicalRing.completionQuotientRingHom_surjective`: surjectivity, for a countably
  generated neighbourhood filter at zero.

## Implementation notes

The uniformity is the one `TopologicalRing.TopologicalCompletion` uses, namely
`IsTopologicalAddGroup.rightUniformSpace`, so that the 0ARZ and 0AS0 statements apply verbatim;
it and `IsUniformAddGroup` are supplied by `letI` in every statement, as elsewhere in this
directory.

`UniformSpace.Completion.mapRingHom` is by definition `UniformSpace.Completion.map` of the same
function (`UniformSpace.Completion.coe_mapRingHom`), and `Ideal.Quotient.mk J` is by definition
the same function as `(J : Submodule S S).mkQ`, so the ring homomorphism defined here *is* the
library's `TopologicalRing.completionQuotient` and the two cited tags transfer without further
argument.

The kernel is stated with the closure of the extension `J.map coeRingHom` rather than with the
closure of the image of `J`, which is what 0ARZ part (2) produces.  The two agree because the
extension is generated by the image over a ring in which the image of `S` is dense; that is
`closure_coe_image_eq_closure_map`.

## References

* [Stacks Project, Tag 0ARZ](https://stacks.math.columbia.edu/tag/0ARZ)
* [Stacks Project, Tag 0AS0](https://stacks.math.columbia.edu/tag/0AS0)
-/

@[expose] public section

namespace TopologicalRing

section

open Set UniformSpace
open scoped Topology

variable {S : Type*} [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
  [IsLinearTopology S S]

omit [IsLinearTopology S S] in
/-- **The closure of the image of an ideal is the closure of its extension.**  In the completion
of a linearly topologized ring, the closure of the image of an ideal `J` coincides with the
closure of the ideal `J · Ŝ` that the image generates: the extension is no larger, because the
image of `S` is dense. -/
public theorem closure_coe_image_eq_closure_map (J : Ideal S) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    closure ((Completion.coeRingHom : S →+* Completion S) '' (J : Set S)) =
      (Ideal.closure (J.map (Completion.coeRingHom : S →+* Completion S)) :
        Set (Completion S)) := by
  let : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
  let : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
  set T : Set (Completion S) :=
    closure ((Completion.coeRingHom : S →+* Completion S) '' (J : Set S)) with hT
  rw [Ideal.coe_closure]
  refine Subset.antisymm (closure_mono ?_) (closure_minimal ?_ isClosed_closure)
  · rintro _ ⟨j, hj, rfl⟩
    exact Ideal.mem_map_of_mem _ hj
  -- the extension of `J` is contained in `T`: generators lie in `T`, and `T` is closed under
  -- addition (being the closure of an additive subgroup) and under multiplication by the
  -- completion (being closed and stable under the dense image of `S`)
  have hzero : (0 : Completion S) ∈ T := subset_closure ⟨0, J.zero_mem, map_zero _⟩
  have hadd : ∀ y ∈ T, ∀ z ∈ T, y + z ∈ T := by
    intro y hy z hz
    have := (AddSubgroup.topologicalClosure
      (J.toAddSubgroup.map (Completion.coeRingHom : S →+* Completion S).toAddMonoidHom)).add_mem
      (show y ∈ AddSubgroup.topologicalClosure _ from hy)
      (show z ∈ AddSubgroup.topologicalClosure _ from hz)
    exact this
  have hmul : ∀ (c : Completion S), ∀ y ∈ T, c * y ∈ T := by
    intro c y hy
    have hclosed : IsClosed {d : Completion S | d * y ∈ T} :=
      isClosed_closure.preimage (continuous_mul_const y)
    refine Completion.induction_on c hclosed ?_
    intro s
    change (s : Completion S) * y ∈ T
    refine map_mem_closure (mulLeft_continuous (s : Completion S)) hy ?_
    rintro _ ⟨j, hj, rfl⟩
    exact ⟨s * j, J.mul_mem_left s hj, by rw [map_mul]; rfl⟩
  intro x hx
  have hx' : x ∈ Ideal.span
      ((Completion.coeRingHom : S →+* Completion S) '' (J : Set S)) := hx
  refine Submodule.span_induction (p := fun z _ => z ∈ T)
    (fun z hz => subset_closure hz) hzero
    (fun y z _ _ hy hz => hadd y hy z hz)
    (fun c z _ hz => by simpa only [smul_eq_mul] using hmul c z hz) hx'

/-- **The completed quotient map, as a ring homomorphism.**  The quotient map `S → S ⧸ J` is
continuous for the quotient topology, so it completes to a ring homomorphism of completions. -/
public noncomputable def completionQuotientRingHom (J : Ideal S) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
    letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
    Completion S →+* Completion (S ⧸ J) :=
  letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
  letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
  letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
  letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
  Completion.mapRingHom (Ideal.Quotient.mk J) continuous_quot_mk

omit [IsLinearTopology S S] in
/-- The completed quotient map is the library's `TopologicalRing.completionQuotient` for the
ideal read as a submodule: `UniformSpace.Completion.mapRingHom` is `UniformSpace.Completion.map`
of the same function. -/
public theorem completionQuotientRingHom_eq (J : Ideal S) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
    letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
    (completionQuotientRingHom J : Completion S → Completion (S ⧸ J)) =
      completionQuotient (J : Submodule S S) :=
  rfl

omit [IsLinearTopology S S] in
/-- The completed quotient map on the image of `S`. -/
@[simp]
public theorem completionQuotientRingHom_coe (J : Ideal S) (s : S) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
    letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
    completionQuotientRingHom J (s : Completion S) =
      ((Ideal.Quotient.mk J s : S ⧸ J) : Completion (S ⧸ J)) := by
  let : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
  let : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
  let : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
  let : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
  exact Completion.mapRingHom_coe continuous_quot_mk s

/-- **The kernel of the completed quotient map is the closure of the extension of `J`.**  This
is Tag 0ARZ: the kernel is the image of the completion of `J`, which is the closure of the image
of `J`, which by `closure_coe_image_eq_closure_map` is the closure of `J · Ŝ`. -/
public theorem ker_completionQuotientRingHom (J : Ideal S) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
    letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
    RingHom.ker (completionQuotientRingHom J) =
      Ideal.closure (J.map (Completion.coeRingHom : S →+* Completion S)) := by
  let : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
  let : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
  let : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
  let : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
  refine SetLike.coe_injective ?_
  rw [← closure_coe_image_eq_closure_map]
  have hzero : ((0 : S ⧸ J) : Completion (S ⧸ J)) = 0 := Completion.coe_zero
  have hker : (RingHom.ker (completionQuotientRingHom J) : Set (Completion S)) =
      {x : Completion S | completionQuotient (J : Submodule S S) x = ((0 : S ⧸ J) :
        Completion (S ⧸ J))} := by
    ext x
    simp only [SetLike.mem_coe, RingHom.mem_ker, Set.mem_ofPred_eq, hzero]
    rw [completionQuotientRingHom_eq]
  rw [hker, ← exact_completionSubtype_completionQuotient,
    range_completionSubtype_eq_closure]
  congr 1
  exact (Set.image_eq_range (fun s : S => (s : Completion S)) (J : Set S)).symm

omit [IsLinearTopology S S] in
/-- **The completed quotient map is surjective** when `S` has a countable fundamental system of
neighbourhoods of zero.  This is Tag 0AS0, part (1). -/
public theorem completionQuotientRingHom_surjective (J : Ideal S)
    (hcount : (nhds (0 : S)).IsCountablyGenerated) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
    letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
    Function.Surjective (completionQuotientRingHom J) := by
  exact completionQuotient_surjective_of_isCountablyGenerated (J : Submodule S S) hcount

/-- **The completion of a quotient ring is the quotient of the completion.**  For a linearly
topologized ring `S` with a countable fundamental system of neighbourhoods of zero and an ideal
`J`, the completion of `S ⧸ J` is `Ŝ` modulo the closure of the extension `J · Ŝ`.

This is the right-exactness of completion that the identification
`B ⊗̂[A] (R ⧸ K) ≃ (B ⊗̂[A] R) ⧸ K · (B ⊗̂[A] R)` is built from; the closure is genuinely needed
at this generality and may be removed exactly when `J · Ŝ` is closed. -/
public noncomputable def completionQuotientRingEquiv (J : Ideal S)
    (hcount : (nhds (0 : S)).IsCountablyGenerated) :
    letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
    letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
    letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
    letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
    (Completion S ⧸ Ideal.closure (J.map (Completion.coeRingHom : S →+* Completion S)))
      ≃+* Completion (S ⧸ J) :=
  letI : UniformSpace S := IsTopologicalAddGroup.rightUniformSpace S
  letI : IsUniformAddGroup S := isUniformAddGroup_of_addCommGroup
  letI : UniformSpace (S ⧸ J) := IsTopologicalAddGroup.rightUniformSpace (S ⧸ J)
  letI : IsUniformAddGroup (S ⧸ J) := isUniformAddGroup_of_addCommGroup
  (Ideal.quotEquivOfEq (ker_completionQuotientRingHom J).symm).trans
    (RingHom.quotientKerEquivOfSurjective (completionQuotientRingHom_surjective J hcount))

end

section ClosedIdeal

open scoped Topology

/-- **The neighbourhood filter of zero in an adic ring is countably generated**, the powers of
the ideal being an `ℕ`-indexed basis.  This discharges the hypothesis of
`TopologicalRing.completionQuotientRingHom_surjective` at any adic ring. -/
public theorem isCountablyGenerated_nhds_zero_of_isAdic {S : Type*} [CommRing S]
    [TopologicalSpace S] [IsTopologicalRing S] {𝔦 : Ideal S} (h𝔦 : _root_.IsAdic 𝔦) :
    (nhds (0 : S)).IsCountablyGenerated :=
  h𝔦.hasBasis_nhds_zero.isCountablyGenerated

/-- **Every ideal is closed in a Noetherian ring which is adic, complete and separated.**

The quotient `S ⧸ 𝔞` is a cyclic, hence finite, module over the complete Noetherian ring `S`, so
it is adically complete and in particular adically separated; therefore `⋂ n, (𝔞 + 𝔦 ^ n) = 𝔞`,
and by Tag 0AMS that intersection is the closure of `𝔞`.

This is exactly the hypothesis under which the closure in
`TopologicalRing.completionQuotientRingEquiv` — and in the completed tensor product statements
built on it — may be dropped. -/
@[sga "3 VIIB 5.5.2" "partial"]
public theorem isClosed_ideal_of_isAdic_of_isNoetherianRing {S : Type*} [CommRing S]
    [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsLinearTopology S S]
    [IsNoetherianRing S] [CompleteSpace S] [T2Space S]
    {𝔦 : Ideal S} (h𝔦 : _root_.IsAdic 𝔦) (𝔞 : Ideal S) :
    IsClosed ((𝔞 : Set S)) := by
  have : IsAdicComplete 𝔦 S :=
    (h𝔦.isAdicComplete_iff).mpr ⟨‹CompleteSpace S›, ‹T2Space S›⟩
  have : IsAdicComplete 𝔦 (S ⧸ 𝔞) :=
    AdicCompletion.isAdicComplete_of_finite_of_isNoetherianRing 𝔦 (S ⧸ 𝔞)
  rw [← closure_eq_iff_isClosed]
  refine Set.Subset.antisymm ?_ subset_closure
  rw [closure_eq_iInter_sup_of_hasBasis (R := S) (M := S) (fun n : ℕ => (𝔦 ^ n : Ideal S))
    (fun n => (isAdic_iff.mp h𝔦).1 n) h𝔦.hasBasis_nhds_zero 𝔞]
  intro x hx
  have hmod : ∀ n : ℕ, (Ideal.Quotient.mk 𝔞 x) ≡ 0
      [SMOD (𝔦 ^ n • (⊤ : Submodule S (S ⧸ 𝔞)))] := by
    intro n
    rw [SModEq.zero, Ideal.smul_top_eq_map]
    obtain ⟨a, ha, y, hy, hxy⟩ := Submodule.mem_sup.mp (Set.mem_iInter.mp hx n)
    have hmk : Ideal.Quotient.mk 𝔞 x = Ideal.Quotient.mk 𝔞 y := by
      rw [← hxy, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add]
    rw [hmk, Ideal.Quotient.algebraMap_eq]
    exact Ideal.mem_map_of_mem _ hy
  exact (Submodule.Quotient.mk_eq_zero 𝔞).mp
    (IsHausdorff.haus (inferInstance : IsHausdorff 𝔦 (S ⧸ 𝔞)) _ hmod)

end ClosedIdeal

end TopologicalRing

end
