/-!
# Tautness is a local property

Tautness of a continuous homomorphism of countably indexed weakly admissible topological rings
satisfies the three locality axioms of Situation 0CBA: it ascends along a completed étale
localization diagram, it descends along such a diagram whose upper horizontal map is faithfully
flat, and it is preserved by finite products of targets.

## Main results

* `TopologicalRing.mem_closure_iff_forall_sup_open`: in a linearly topologized ring the closure
  of an ideal `N` is the intersection of the ideals `N + L` over the open ideals `L`.
* `TopologicalRing.comap_closure_map_canonicalMap`: for `A → A'` faithfully flat, the
  contraction to `A` of the closure of `K (A')^∧` is the closure of `K`.
* `TopologicalRing.isTaut_localizationPreserves`: tautness ascends along a completed étale
  localization diagram.
* `TopologicalRing.isTaut_faithfullyFlatDescent`: tautness descends along a completed étale
  localization diagram whose upper horizontal map is faithfully flat.
* `TopologicalRing.isTaut_finiteProductPreserves`: tautness is preserved by finite products of
  targets.
* `TopologicalRing.isTaut_propertyIsLocal`: the three axioms bundled, i.e. tautness is a local
  property.

## References

* [Stacks Project, Tag 0ANJ](https://stacks.math.columbia.edu/tag/0ANJ)
* [Stacks Project, Tag 0CBA](https://stacks.math.columbia.edu/tag/0CBA)
-/

@[expose] public section

namespace TopologicalRing

open Filter

universe u

/-! ### The closure of an ideal in a linearly topologized ring -/

section Closure

variable {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
  [IsLinearTopology R R]

/-- In a linearly topologized ring the closure of an ideal `N` is the intersection of the
ideals `N + L` over all open ideals `L`. -/
public theorem mem_closure_iff_forall_sup_open (N : Ideal R) (x : R) :
    x ∈ Ideal.closure N ↔ ∀ L : Ideal R, IsOpen (L : Set R) → x ∈ N ⊔ L := by
  constructor
  · intro hx L hL
    refine closure_minimal (show (N : Set R) ⊆ ((N ⊔ L : Ideal R) : Set R) from
      fun _ hy ↦ Ideal.mem_sup_left hy) ?_ hx
    exact (N ⊔ L).toAddSubgroup.isClosed_of_isOpen
      (Ideal.isOpen_of_isOpen_subideal le_sup_right hL)
  · intro h
    show x ∈ closure (N : Set R)
    refine mem_closure_iff_nhds.mpr fun t ht ↦ ?_
    obtain ⟨L, hL, hLt⟩ := (IsLinearTopology.hasBasis_open_ideal.nhds_of_zero' x).mem_iff.mp ht
    obtain ⟨j, hj, l, hl, hsum⟩ := Submodule.mem_sup.mp (h L hL)
    refine ⟨j, hLt ⟨-l, L.neg_mem hl, ?_⟩, hj⟩
    simpa only [vadd_eq_add, sub_eq_add_neg] using
      (show x + -l = j by rw [← hsum]; abel)

end Closure

/-! ### Contracting closures of extended ideals along a faithfully flat completion -/

section Contraction

variable {A A' : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsLinearTopology A A] [CommRing A']

/-- Let `A` be weakly pre-admissible and let `f : A →+* A'` be faithfully flat. The contraction
along the canonical map `A → (A')^∧` of the closure of the ideal generated by the image of an
ideal `K ⊆ A` is the closure of `K`. -/
@[ega "0 22.4.8" "more general"]
public theorem comap_closure_map_canonicalMap (f : A →+* A')
    (hA : IsWeaklyPreAdmissible A) (hf : f.FaithfullyFlat) (K : Ideal A) :
    (Ideal.closure (K.map (CompletionOver.canonicalMap f))).comap
        (CompletionOver.canonicalMap f) = Ideal.closure K := by
  obtain ⟨I₀, hI₀⟩ := hA
  apply le_antisymm
  · intro x hx
    have hx' : CompletionOver.canonicalMap f x ∈
        Ideal.closure (K.map (CompletionOver.canonicalMap f)) := hx
    rw [mem_closure_iff_forall_sup_open]
    intro L hL
    set J : WeakIdealOfDefinitionIndex A :=
      ⟨I₀ ⊓ L, ⟨hI₀.1.inter hL, fun y hy ↦ hI₀.2 y hy.1⟩⟩ with hJ
    obtain ⟨k, hk, m, hm, hsum⟩ := Submodule.mem_sup.mp
      ((mem_closure_iff_forall_sup_open (K.map (CompletionOver.canonicalMap f))
        (CompletionOver.canonicalMap f x)).mp hx' _
          (CompletionOver.isOpen_ker_projection f J))
    have hproj : CompletionOver.projection f J (CompletionOver.canonicalMap f x) =
        CompletionOver.projection f J k := by
      rw [← hsum, map_add, RingHom.mem_ker.mp hm, add_zero]
    have hk' : CompletionOver.projection f J k ∈
        Ideal.map ((CompletionOver.projection f J).comp (CompletionOver.canonicalMap f)) K := by
      rw [← Ideal.map_map]
      exact Ideal.mem_map_of_mem _ hk
    rw [show (CompletionOver.projection f J).comp (CompletionOver.canonicalMap f) =
        (Ideal.Quotient.mk (extendedIdeal f J)).comp f from rfl, ← Ideal.map_map,
      ← hproj, show CompletionOver.projection f J (CompletionOver.canonicalMap f x) =
        Ideal.Quotient.mk (extendedIdeal f J) (f x) from rfl,
      Ideal.mem_quotient_iff_mem_sup, ← Ideal.map_sup] at hk'
    have hmem : x ∈ K ⊔ J.1 := by
      rw [← faithfullyFlat_comap_map_eq f hf (K ⊔ J.1)]
      exact hk'
    exact sup_le_sup_left (show J.1 ≤ L from inf_le_right) K hmem
  · exact fun x hx ↦ map_mem_closure (continuous_canonicalMap f) hx
      fun _ hy ↦ Ideal.mem_map_of_mem _ hy

end Contraction

/-! ### Extending an ideal along a finite product of ring maps -/

section Pi

variable {ι : Type*} {B : Type*} [CommRing B] {A : ι → Type*} [∀ i, CommRing (A i)]

/-- The ideal generated by the image of `J` under a finite product of ring maps is the product
of the ideals generated by the images of `J`. -/
public theorem map_ringHom_pi [Finite ι] (f : ∀ i, B →+* A i) (J : Ideal B) :
    J.map (RingHom.pi f) = Ideal.pi fun i ↦ J.map (f i) := by
  classical
  cases nonempty_fintype ι
  apply le_antisymm
  · exact Ideal.map_le_iff_le_comap.mpr fun b hb i ↦ Ideal.mem_map_of_mem _ hb
  · intro x hx
    have hsingle : ∀ i : ι, Pi.single i (x i) ∈ J.map (RingHom.pi f) := by
      intro i
      let T : Ideal (A i) :=
        { carrier := {y | Pi.single i y ∈ J.map (RingHom.pi f)}
          zero_mem' := by
            show Pi.single i (0 : A i) ∈ J.map (RingHom.pi f)
            rw [Pi.single_zero]
            exact Submodule.zero_mem _
          add_mem' := fun {y z} hy hz ↦ by
            have hy' : Pi.single i y ∈ J.map (RingHom.pi f) := hy
            have hz' : Pi.single i z ∈ J.map (RingHom.pi f) := hz
            show Pi.single i (y + z) ∈ J.map (RingHom.pi f)
            rw [Pi.single_add]
            exact Submodule.add_mem _ hy' hz'
          smul_mem' := fun a {y} hy ↦ by
            have hy' : Pi.single i y ∈ J.map (RingHom.pi f) := hy
            show Pi.single i (a • y) ∈ J.map (RingHom.pi f)
            rw [smul_eq_mul, Pi.single_mul]
            exact Ideal.mul_mem_left _ _ hy' }
      have hT : J.map (f i) ≤ T := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        show Pi.single i (f i b) ∈ J.map (RingHom.pi f)
        have h1 : Pi.single i (f i b) =
            Pi.single i (1 : A i) * RingHom.pi f b := by
          ext j
          rcases eq_or_ne j i with rfl | hji
          · simp
          · simp [Pi.single_eq_of_ne hji]
        rw [h1]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hb)
      exact hT (hx i)
    rw [← Finset.univ_sum_single x]
    exact Submodule.sum_mem _ fun i _ ↦ hsingle i

/-- The underlying set of a product of ideals is the product of their underlying sets. -/
public theorem coe_idealPi (I : ∀ i, Ideal (A i)) :
    (Ideal.pi I : Set (∀ i, A i)) = Set.univ.pi fun i ↦ (I i : Set (A i)) := by
  ext x
  simpa using Ideal.mem_pi I x

/-- The closure of a product of ideals is the product of their closures. -/
public theorem closure_idealPi [∀ i, TopologicalSpace (A i)] [∀ i, IsTopologicalRing (A i)]
    (I : ∀ i, Ideal (A i)) :
    Ideal.closure (Ideal.pi I) = Ideal.pi fun i ↦ Ideal.closure (I i) := by
  apply SetLike.ext'
  rw [Ideal.coe_closure, coe_idealPi, coe_idealPi, closure_pi_set]
  simp only [Ideal.coe_closure]

end Pi

/-! ### The three locality axioms for tautness -/

section Local

/-- Tautness ascends along a completed étale localization diagram of countably indexed weakly
admissible rings. -/
@[stacks 0ANJ "taut_is_local_property"]
public theorem isTaut_localizationPreserves :
    LocalizationPreserves.{u} IsCountablyWeaklyAdmissible
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
        (f : B →+* A) ↦ RingHom.IsTaut f) := by
  intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _ _ _ _ htaut
  have h := RingHom.isTaut_comp D.map (CompletionOver.canonicalMap D.toA')
    D.continuousMap (continuous_canonicalMap D.toA') htaut
    (isTaut_canonicalMap D.toA' D.weaklyAdmissibleA.1)
  rw [D.commutes] at h
  exact RingHom.isTaut_of_comp (CompletionOver.canonicalMap D.toB') D.completedMap
    (continuous_canonicalMap D.toB') D.continuousCompletedMap h

/-- Tautness descends along a completed étale localization diagram whose upper horizontal ring
map is faithfully flat. -/
@[stacks 0ANJ "taut_is_local_property"]
public theorem isTaut_faithfullyFlatDescent :
    FaithfullyFlatDescent.{u} IsCountablyWeaklyAdmissible
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
        (f : B →+* A) ↦ RingHom.IsTaut f) := by
  intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _ _ _ _ hff htaut
  have hψ := RingHom.isTaut_comp (CompletionOver.canonicalMap D.toB') D.completedMap
    (continuous_canonicalMap D.toB') D.continuousCompletedMap
    (isTaut_canonicalMap D.toB' D.weaklyAdmissibleB.1) htaut
  rw [← D.commutes] at hψ
  have hkey := comap_closure_map_canonicalMap D.toA' D.weaklyAdmissibleA.1 hff
  have hopen : ∀ J : Ideal B, IsOpen (J : Set B) →
      IsOpen ((Ideal.closure (J.map D.map) : Ideal A) : Set A) := by
    intro J hJ
    rw [show Ideal.closure (J.map D.map) =
        (Ideal.closure (J.map ((CompletionOver.canonicalMap D.toA').comp D.map))).comap
          (CompletionOver.canonicalMap D.toA') by
      rw [← Ideal.map_map, hkey (J.map D.map)]]
    exact (hψ.1 J hJ).preimage (continuous_canonicalMap D.toA')
  refine ⟨hopen, (IsLinearTopology.hasBasis_open_ideal (R := A)).to_hasBasis ?_ ?_⟩
  · intro L hL
    obtain ⟨J, hJ, hJL⟩ := hψ.2.mem_iff.mp
      (((isTaut_canonicalMap D.toA' D.weaklyAdmissibleA.1).1 L hL).mem_nhds
        (Ideal.zero_mem _))
    refine ⟨J, hJ, ?_⟩
    have hle : Ideal.closure (J.map D.map) ≤ Ideal.closure L := by
      rw [← hkey (J.map D.map), ← hkey L, Ideal.map_map]
      exact Ideal.comap_mono (SetLike.coe_subset_coe.mp hJL)
    rw [Ideal.closure_eq_of_isClosed L (L.toAddSubgroup.isClosed_of_isOpen hL)] at hle
    exact SetLike.coe_subset_coe.mpr hle
  · intro J hJ
    exact ⟨Ideal.closure (J.map D.map), hopen J hJ, subset_rfl⟩

/-- Tautness is preserved by finite products of targets. -/
@[stacks 0ANJ "taut_is_local_property"]
public theorem isTaut_finiteProductPreserves :
    FiniteProductPreserves.{u} IsCountablyWeaklyAdmissible
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
        (f : B →+* A) ↦ RingHom.IsTaut f) := by
  intro B _ _ _ _ _ _ ι _ A _ _ _ _ _ _ f _ _ _ htaut
  classical
  have hmap : ∀ J : Ideal B, Ideal.closure (J.map (RingHom.pi f)) =
      Ideal.pi fun i ↦ Ideal.closure (J.map (f i)) := fun J ↦ by
    rw [map_ringHom_pi f J, closure_idealPi]
  have hopen : ∀ J : Ideal B, IsOpen (J : Set B) →
      IsOpen ((Ideal.closure (J.map (RingHom.pi f)) : Ideal (∀ i, A i)) : Set (∀ i, A i)) := by
    intro J hJ
    rw [hmap J, coe_idealPi]
    exact isOpen_set_pi Set.finite_univ fun i _ ↦ (htaut i).1 J hJ
  refine ⟨hopen, Filter.hasBasis_iff.mpr fun U ↦ ⟨?_, ?_⟩⟩
  · intro hU
    rw [nhds_pi] at hU
    obtain ⟨s, _, t, ht, hts⟩ := Filter.mem_pi.mp hU
    choose J hJopen hJsub using fun i ↦ (htaut i).2.mem_iff.mp (ht i)
    refine ⟨⨅ i, J i, ?_, ?_⟩
    · rw [Submodule.coe_iInf]
      exact isOpen_iInter_of_finite hJopen
    · rw [hmap, coe_idealPi]
      refine subset_trans ?_ hts
      intro x hx i _
      exact hJsub i (closure_mono (Ideal.map_mono (iInf_le J i)) (hx i (Set.mem_univ i)))
  · rintro ⟨J, hJ, hJU⟩
    exact Filter.mem_of_superset ((hopen J hJ).mem_nhds (Ideal.zero_mem _)) hJU

/-- Tautness is a local property of morphisms of countably indexed weakly admissible
topological rings. -/
public theorem isTaut_propertyIsLocal :
    PropertyIsLocal.{u}
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
        (f : B →+* A) ↦ RingHom.IsTaut f) :=
  ⟨isTaut_localizationPreserves, isTaut_faithfullyFlatDescent, isTaut_finiteProductPreserves⟩

end Local

end TopologicalRing

end
