/-!
# Tautness together with topological finite type is a local property

For a morphism of countably indexed weakly admissible topological rings, being taut and
topologically of finite type ascends along a completed étale localization diagram, descends
along one whose horizontal map is faithfully flat, and is stable under finite products of
targets.  These are the three axioms of the local-property situation, so the property is local.

Ascent is a cancellation argument: the canonical map to a relative completion is taut and
topologically of finite type, so the diagonal of the diagram is, and tautness and topological
finite type of a composite pass to the second factor.  Descent is genuine descent: a closed
ideal of the source is recovered from its extension to the completion because the horizontal
map is faithfully flat, which gives tautness, and then finite type of each discrete quotient
descends along the faithfully flat, finitely presented étale base change.

## Main results

* `TopologicalRing.tautAndFiniteType_localizationPreserves` is the localization axiom.
* `TopologicalRing.tautAndFiniteType_faithfullyFlatDescent` is the faithfully flat descent axiom.
* `TopologicalRing.tautAndFiniteType_propertyIsLocal` collects the three axioms.

## References

* [Stacks Project, Tag 0ANU](https://stacks.math.columbia.edu/tag/0ANU)
* [Stacks Project, Tag 0CBA](https://stacks.math.columbia.edu/tag/0CBA)
-/

@[expose] public section

namespace TopologicalRing

open TopologicalRing CompletionOver Filter

universe u

section

variable {B : Type u} {A : Type u} [CommRing B] [TopologicalSpace B] [CommRing A]

/-- The quotient of a relative completion by the closed extension of a weak ideal of definition
`J` of the base is the quotient of the ambient ring by the ideal generated by `J`. -/
private noncomputable def completionQuotientEquiv (f : B →+* A)
    (J : WeakIdealOfDefinitionIndex B) :
    (CompletionOver f ⧸ Ideal.closure (J.1.map (CompletionOver.canonicalMap f))) ≃+*
      (A ⧸ Ideal.map f J.1) :=
  (Ideal.quotEquivOfEq (ker_projection_eq_closure f J).symm).trans
    (RingHom.quotientKerEquivOfSurjective (projection_surjective f J))

/-- The identification of quotients is compatible with the canonical map from the base. -/
private lemma completionQuotientEquiv_mk (f : B →+* A) (J : WeakIdealOfDefinitionIndex B) (b : B) :
    completionQuotientEquiv f J
        (Ideal.Quotient.mk _ (CompletionOver.canonicalMap f b)) =
      Ideal.Quotient.mk _ (f b) := by
  simp only [completionQuotientEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]
  exact projection_canonicalMap f J b

/-- The inverse identification of quotients composed with the map induced by `f` is the map induced
by the canonical map from the base. -/
private lemma completionQuotientEquiv_symm_comp_quotientMap (f : B →+* A)
    (J : WeakIdealOfDefinitionIndex B) :
    (completionQuotientEquiv f J).symm.toRingHom.comp
        (Ideal.quotientMap (Ideal.map f J.1) f (Ideal.map_le_iff_le_comap.mp le_rfl)) =
      Ideal.quotientMap (Ideal.closure (J.1.map (CompletionOver.canonicalMap f)))
        (CompletionOver.canonicalMap f) (Ideal.map_le_iff_le_comap.mp subset_closure) := by
  refine RingHom.ext fun x => ?_
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact (completionQuotientEquiv f J).symm_apply_eq.2 (completionQuotientEquiv_mk f J b).symm

end

section

variable {A : Type u} {A' : Type u}

/-- An element of a weakly admissible ring lying in the closed extension of a closed ideal to
a relative completion along a faithfully flat map already lies in that ideal. -/
private theorem mem_of_canonicalMap_mem_closure
    [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing A'] (g : A →+* A') (hg : g.FaithfullyFlat)
    (hA : TopologicalRing.IsWeaklyAdmissible A)
    (K : Ideal A) (hK : IsClosed (K : Set A)) (a : A)
    (ha : CompletionOver.canonicalMap g a ∈
      Ideal.closure (K.map (CompletionOver.canonicalMap g))) :
    a ∈ K := by
  algebraize [g]
  have key : ∀ I : WeakIdealOfDefinitionIndex A, a ∈ K ⊔ I.1 := by
    intro I
    set S : Ideal (CompletionOver g) :=
      Ideal.comap (projection g I)
        (Ideal.map (projection g I) (Ideal.map (CompletionOver.canonicalMap g) K)) with hS
    have hker : RingHom.ker (projection g I) ≤ S := by
      intro x hx
      simp only [hS, Ideal.mem_comap]
      rw [show projection g I x = 0 from hx]
      exact Ideal.zero_mem _
    have hSclosed : IsClosed (S : Set (CompletionOver g)) :=
      S.toAddSubgroup.isClosed_of_isOpen
        (Ideal.isOpen_of_isOpen_subideal hker (isOpen_ker_projection g I))
    have hsub : Ideal.closure (Ideal.map (CompletionOver.canonicalMap g) K) ≤ S :=
      closure_minimal Ideal.le_comap_map hSclosed
    have hmem := hsub ha
    simp only [hS, Ideal.mem_comap] at hmem
    rw [projection_canonicalMap] at hmem
    rw [Ideal.map_map, show (projection g I).comp (CompletionOver.canonicalMap g)
        = (Ideal.Quotient.mk (extendedIdeal g I)).comp g from
      RingHom.ext (fun b => projection_canonicalMap g I b), ← Ideal.map_map] at hmem
    rw [← Ideal.mem_comap,
      Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker,
      show extendedIdeal g I = Ideal.map g I.1 from rfl, ← Ideal.map_sup,
      show g = algebraMap A A' from (RingHom.algebraMap_toAlgebra g).symm,
      ← Ideal.mem_comap, Ideal.comap_map_eq_self_of_faithfullyFlat] at hmem
    exact hmem
  rw [← SetLike.mem_coe, ← hK.closure_eq, mem_closure_iff]
  intro U hU haU
  have hU0 : (fun x : A => a + x) ⁻¹' U ∈ nhds (0 : A) := by
    have hc : ContinuousAt (fun x : A => a + x) 0 :=
      (continuous_const.add continuous_id).continuousAt
    simpa using hc.preimage_mem_nhds (by simpa using hU.mem_nhds haU)
  obtain ⟨I, hI, hIU⟩ :=
    (TopologicalRing.hasBasis_nhds_zero_isWeakIdealOfDefinition hA).mem_iff.mp hU0
  obtain ⟨k, hk, i, hi, hki⟩ := Submodule.mem_sup.mp (key ⟨I, hI⟩)
  refine ⟨k, ?_, hk⟩
  have hk' : k = a + -i := by rw [← hki]; ring
  rw [hk']
  exact hIU (I.neg_mem hi)

end

section

variable {A : Type u} {B : Type u} {A' : Type u}

/-- Tautness descends from the composite with the canonical map to a relative completion, when
the map along which one completes is faithfully flat. -/
private theorem isTaut_of_isTaut_canonicalMap_comp
    [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
    [CommRing A'] (g : A →+* A') (hg : g.FaithfullyFlat)
    (hA : TopologicalRing.IsWeaklyAdmissible A) (φ : B →+* A)
    (hcomp : RingHom.IsTaut ((CompletionOver.canonicalMap g).comp φ)) :
    RingHom.IsTaut φ := by
  have hcAcont : Continuous (CompletionOver.canonicalMap g) := continuous_canonicalMap g
  have hcA : RingHom.IsTaut (CompletionOver.canonicalMap g) := isTaut_canonicalMap g hA.1
  have hrw : ∀ J : Ideal B, Ideal.closure (J.map ((CompletionOver.canonicalMap g).comp φ))
      = Ideal.closure ((Ideal.closure (J.map φ)).map (CompletionOver.canonicalMap g)) := by
    intro J
    rw [RingHom.closure_map_closure _ hcAcont, Ideal.map_map]
  have hopen : ∀ J : Ideal B, IsOpen (J : Set B) →
      IsOpen ((Ideal.closure (J.map φ) : Ideal A) : Set A) := by
    intro J hJ
    have h1 := hcomp.1 J hJ
    rw [hrw J] at h1
    obtain ⟨I, hI, hIsub⟩ := hcA.2.mem_iff.mp
      (h1.mem_nhds (Ideal.closure _).zero_mem)
    refine Ideal.isOpen_of_isOpen_subideal (show I ≤ Ideal.closure (J.map φ) from
      fun a ha => ?_) hI
    have hcAa : CompletionOver.canonicalMap g a ∈
        Ideal.closure ((Ideal.closure (J.map φ)).map (CompletionOver.canonicalMap g)) :=
      hIsub (subset_closure (Ideal.mem_map_of_mem _ ha))
    exact mem_of_canonicalMap_mem_closure g hg hA _ isClosed_closure a hcAa
  refine ⟨hopen, Filter.hasBasis_iff.mpr fun U => ⟨?_, ?_⟩⟩
  · intro hU
    obtain ⟨I, hI, hIU⟩ := (IsLinearTopology.hasBasis_open_ideal (R := A)).mem_iff.mp hU
    have hIclosed : IsClosed (I : Set A) := I.toAddSubgroup.isClosed_of_isOpen hI
    obtain ⟨J, hJ, hJsub⟩ := hcomp.2.mem_iff.mp
      ((hcA.1 I hI).mem_nhds (Ideal.closure _).zero_mem)
    refine ⟨J, hJ, fun a ha => hIU ?_⟩
    have ha' : CompletionOver.canonicalMap g a ∈
        Ideal.closure (J.map ((CompletionOver.canonicalMap g).comp φ)) := by
      rw [hrw J]
      exact subset_closure (Ideal.mem_map_of_mem _ ha)
    exact mem_of_canonicalMap_mem_closure g hg hA I hIclosed a (hJsub ha')
  · rintro ⟨J, hJ, hJU⟩
    exact Filter.mem_of_superset ((hopen J hJ).mem_nhds (Ideal.closure _).zero_mem) hJU

end

section

variable {A B A' B' : Type u}
  [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
  [CommRing A'] [CommRing B']

/-- Finite type of each discrete quotient descends from the completed morphism of a localization
diagram to the original morphism, along the faithfully flat horizontal map. -/
private theorem finiteTypeModulo_descent (D : LocalizationDiagram A B A' B')
    (hFF : D.toA'.FaithfullyFlat)
    (hTaut : RingHom.IsTaut D.map)
    (hmod' : TopologicalRing.FiniteTypeModuloEveryWeakIdeal D.completedMap) :
    TopologicalRing.FiniteTypeModuloEveryWeakIdeal D.map := by
  refine ⟨hTaut, ?_⟩
  intro J hJ
  have hcAcont : Continuous (CompletionOver.canonicalMap D.toA') := continuous_canonicalMap _
  have hI : TopologicalRing.IsWeakIdealOfDefinition (Ideal.closure (J.map D.map)) :=
    ((RingHom.isTaut_iff_hasBasis_isWeakIdealOfDefinition D.map D.continuousMap
      D.weaklyAdmissibleB D.weaklyAdmissibleA).mp hTaut).1 J hJ
  have hL : TopologicalRing.IsWeakIdealOfDefinition
      (Ideal.closure (J.map (CompletionOver.canonicalMap D.toB'))) := by
    rw [← ker_projection_eq_closure D.toB' ⟨J, hJ⟩]
    exact projection_ker_isWeakIdealOfDefinition D.toB' ⟨J, hJ⟩
  have h1 := hmod'.2 _ hL
  have hIdeal : Ideal.closure ((Ideal.closure (J.map (CompletionOver.canonicalMap D.toB'))).map
        D.completedMap)
      = Ideal.closure ((Ideal.closure (J.map D.map)).map
        (CompletionOver.canonicalMap D.toA')) := by
    rw [RingHom.closure_map_closure _ D.continuousCompletedMap,
      RingHom.closure_map_closure _ hcAcont, Ideal.map_map, Ideal.map_map, ← D.commutes]
  set cA := CompletionOver.canonicalMap D.toA'
  set cB := CompletionOver.canonicalMap D.toB'
  set I : Ideal A := Ideal.closure (J.map D.map)
  set L : Ideal (CompletionOver D.toB') := Ideal.closure (J.map cB)
  set M : Ideal (CompletionOver D.toA') := Ideal.closure (L.map D.completedMap)
  set u : B ⧸ J →+* (CompletionOver D.toB') ⧸ L :=
    Ideal.quotientMap L cB (Ideal.map_le_iff_le_comap.mp subset_closure)
  set v : A ⧸ I →+* (CompletionOver D.toA') ⧸ Ideal.closure (I.map cA) :=
    Ideal.quotientMap _ cA (Ideal.map_le_iff_le_comap.mp subset_closure)
  set w : (CompletionOver D.toB') ⧸ L →+* (CompletionOver D.toA') ⧸ Ideal.closure (I.map cA) :=
    (Ideal.quotEquivOfEq hIdeal).toRingHom.comp
      (Ideal.quotientMap M D.completedMap (Ideal.map_le_iff_le_comap.mp subset_closure))
  have hw : w.FiniteType := RingHom.finiteType_respectsIso.1 _ (Ideal.quotEquivOfEq hIdeal) h1
  have hu : u.FiniteType := by
    have hq := RingHom.FiniteType.quotientMap D.toB'
      (RingHom.FiniteType.of_finitePresentation (RingHom.Etale.finitePresentation D.etaleB)) J
    have h2 := RingHom.finiteType_respectsIso.1 _
      (completionQuotientEquiv D.toB' ⟨J, hJ⟩).symm hq
    rw [completionQuotientEquiv_symm_comp_quotientMap] at h2
    exact h2
  have hveq : _ = v := completionQuotientEquiv_symm_comp_quotientMap D.toA' ⟨I, hI⟩
  have hvFF : v.FaithfullyFlat := hveq ▸ RingHom.FaithfullyFlat.respectsIso.1 _
    (completionQuotientEquiv D.toA' ⟨I, hI⟩).symm
    (RingHom.FaithfullyFlat.quotientMap D.toA' hFF I)
  have hvFP : v.FinitePresentation := hveq ▸ RingHom.finitePresentation_respectsIso.1 _
    (completionQuotientEquiv D.toA' ⟨I, hI⟩).symm
    (RingHom.FinitePresentation.quotientMap D.toA'
      (RingHom.Etale.finitePresentation D.etaleA) I)
  have hsquare : v.comp (Ideal.quotientMap I D.map
      (Ideal.map_le_iff_le_comap.mp subset_closure)) = w.comp u := by
    refine RingHom.ext fun x => ?_
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    show Ideal.Quotient.mk _ (cA (D.map b)) = _
    show _ = (Ideal.quotEquivOfEq hIdeal) (Ideal.Quotient.mk _ (D.completedMap (cB b)))
    rw [Ideal.quotEquivOfEq_mk]
    congr 1
    exact DFunLike.congr_fun D.commutes b
  exact RingHom.finiteType_of_comp_of_faithfullyFlat_of_finitePresentation
    (hsquare ▸ hw.comp hu) hvFF hvFP

end

section

/-- Taut, topologically finite-type morphisms ascend along completed étale localization
diagrams. -/
public theorem tautAndFiniteType_localizationPreserves :
    TopologicalRing.LocalizationPreserves.{u} TopologicalRing.IsCountablyWeaklyAdmissible
      (fun φ => RingHom.IsTaut φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ) := by
  intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _hA _hB _hA' _hB' hP
  obtain ⟨hTaut, hFT⟩ := hP
  have hcAcont : Continuous (CompletionOver.canonicalMap D.toA') := continuous_canonicalMap _
  have hcBcont : Continuous (CompletionOver.canonicalMap D.toB') := continuous_canonicalMap _
  have hcA : RingHom.IsTaut (CompletionOver.canonicalMap D.toA') :=
    isTaut_canonicalMap D.toA' D.weaklyAdmissibleA.1
  have hcomp : RingHom.IsTaut ((CompletionOver.canonicalMap D.toA').comp D.map) :=
    RingHom.isTaut_comp D.map _ D.continuousMap hcAcont hTaut hcA
  have hcompFT : TopologicalRing.IsTopologicallyOfFiniteType
      ((CompletionOver.canonicalMap D.toA').comp D.map) :=
    TopologicalRing.isTopologicallyOfFiniteType_comp _ D.map hcAcont
      (isTopologicallyOfFiniteType_canonicalMap D.toA' D.weaklyAdmissibleA.1
        (finiteType_of_etale D.etaleA)) hFT
  rw [D.commutes] at hcomp hcompFT
  exact ⟨RingHom.isTaut_of_comp _ D.completedMap hcBcont D.continuousCompletedMap hcomp,
    TopologicalRing.isTopologicallyOfFiniteType_of_comp _ D.completedMap hcompFT⟩

/-- Taut, topologically finite-type morphisms descend along completed étale localization diagrams
whose horizontal map is faithfully flat. -/
public theorem tautAndFiniteType_faithfullyFlatDescent :
    TopologicalRing.FaithfullyFlatDescent.{u} TopologicalRing.IsCountablyWeaklyAdmissible
      (fun φ => RingHom.IsTaut φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ) := by
  intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _hA _hB hA' hB' hFF hP
  obtain ⟨hTaut', hFT'⟩ := hP
  have hcBcont : Continuous (CompletionOver.canonicalMap D.toB') := continuous_canonicalMap _
  have hcB : RingHom.IsTaut (CompletionOver.canonicalMap D.toB') :=
    isTaut_canonicalMap D.toB' D.weaklyAdmissibleB.1
  have hcomp : RingHom.IsTaut (D.completedMap.comp (CompletionOver.canonicalMap D.toB')) :=
    RingHom.isTaut_comp _ D.completedMap hcBcont D.continuousCompletedMap hcB hTaut'
  rw [← D.commutes] at hcomp
  have hTaut : RingHom.IsTaut D.map :=
    isTaut_of_isTaut_canonicalMap_comp D.toA' hFF D.weaklyAdmissibleA D.map hcomp
  have hP' : RingHom.IsTaut D.completedMap ∧
      TopologicalRing.IsTopologicallyOfFiniteType D.completedMap := ⟨hTaut', hFT'⟩
  have hmod' : TopologicalRing.FiniteTypeModuloEveryWeakIdeal D.completedMap :=
    ((TopologicalRing.finiteType_tfae' D.completedMap D.continuousCompletedMap hB'.1 hA'.1
      hB'.2).out 3 1).mp hP'
  have hmod := finiteTypeModulo_descent D hFF hTaut hmod'
  exact ((TopologicalRing.finiteType_tfae' D.map D.continuousMap D.weaklyAdmissibleB
    D.weaklyAdmissibleA D.countableB).out 1 3).mp hmod

/-- Tautness together with topological finite type is a local property of morphisms of
countably indexed weakly admissible topological rings. -/
public theorem tautAndFiniteType_propertyIsLocal :
    TopologicalRing.PropertyIsLocal.{u}
      (fun φ => RingHom.IsTaut φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ)
      TopologicalRing.IsCountablyWeaklyAdmissible where
  localizationPreserves := tautAndFiniteType_localizationPreserves
  faithfullyFlatDescent := tautAndFiniteType_faithfullyFlatDescent
  finiteProduct := tautAndFiniteType_finiteProductPreserves

end

end TopologicalRing

