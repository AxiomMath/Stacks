@[expose] public noncomputable section

section LocallyNilpotent

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]

/-- Two ring maps out of an étale algebra which agree on the base and agree modulo a locally
nilpotent ideal of the target are equal. This is `AlgHom.ext_of_isLocallyNilpotent` phrased for
ring maps over a base ring map. -/
theorem RingHom.Etale.ringHom_ext_of_isLocallyNilpotent
    {T S W : Type*} [CommRing T] [CommRing S] [CommRing W]
    {bS : T →+* S} (hS : bS.Etale) (bW : T →+* W)
    {N : Ideal W} (hN : N.IsLocallyNilpotent)
    {f g : S →+* W} (hf : f.comp bS = bW) (hg : g.comp bS = bW)
    (h : (Ideal.Quotient.mk N).comp f = (Ideal.Quotient.mk N).comp g) : f = g := by
  let : Algebra T S := bS.toAlgebra
  let : Algebra T W := bW.toAlgebra
  have : Algebra.Etale T S := hS
  let fa : S →ₐ[T] W := { f with commutes' := RingHom.congr_fun hf }
  let ga : S →ₐ[T] W := { g with commutes' := RingHom.congr_fun hg }
  have hfg : fa = ga :=
    AlgHom.ext_of_isLocallyNilpotent hN (AlgHom.ext fun x => RingHom.congr_fun h x)
  exact RingHom.ext (AlgHom.congr_fun hfg)

/-- A surjection with kernel `I` induces an isomorphism `P ⧸ I ≃+* C` compatible with the
quotient map. -/
private theorem exists_quotEquiv_mk_eq {P C : Type*} [CommRing P] [CommRing C] {p : P →+* C}
    (hp : Function.Surjective p) {I : Ideal P} (hk : RingHom.ker p = I) :
    ∃ ρ : P ⧸ I ≃+* C, ∀ x, ρ (Ideal.Quotient.mk I x) = p x := by
  subst hk
  exact ⟨RingHom.quotientKerEquivOfSurjective hp, fun x => rfl⟩

/-- Over a locally nilpotent ideal `N`, an étale algebra `P` has a unique algebra map to `Q`
lying over a map `p : P → C`, when `q : Q → C` is a surjection with kernel `N Q` that agrees
with `p` on the base. -/
private theorem existsUnique_algHom_comp_eq_of_isLocallyNilpotent
    {T P Q C : Type*} [CommRing T] [CommRing P] [CommRing Q] [CommRing C]
    [Algebra T P] [Algebra T Q] [Algebra.Etale T P] {N : Ideal T} (hN : N.IsLocallyNilpotent)
    {p : P →+* C} {q : Q →+* C} (hq : Function.Surjective q)
    (hqk : RingHom.ker q = N.map (algebraMap T Q))
    (hpq : p.comp (algebraMap T P) = q.comp (algebraMap T Q)) :
    ∃! θ : P →ₐ[T] Q, q.comp (θ : P →+* Q) = p := by
  obtain ⟨ρ, hρ⟩ := exists_quotEquiv_mk_eq hq hqk
  let g : P →ₐ[T] Q ⧸ N.map (algebraMap T Q) :=
    { (ρ.symm : C →+* _).comp p with
      commutes' := fun t => by
        change ρ.symm (p (algebraMap T P t)) = Ideal.Quotient.mk _ (algebraMap T Q t)
        rw [show p (algebraMap T P t) = q (algebraMap T Q t) from RingHom.congr_fun hpq t, ← hρ,
          RingEquiv.symm_apply_apply] }
  have key : ∀ θ : P →ₐ[T] Q, (Ideal.Quotient.mkₐ T _).comp θ = g ↔ q.comp (θ : P →+* Q) = p :=
    fun θ => by
      simp only [AlgHom.ext_iff, RingHom.ext_iff, AlgHom.comp_apply, RingHom.comp_apply]
      refine forall_congr' fun x => ?_
      rw [← hρ]
      exact ρ.eq_symm_apply
  obtain ⟨θ, hθ, hθu⟩ := Algebra.Etale.existsUnique_lift_of_isLocallyNilpotent
    (Ideal.IsLocallyNilpotent0544.map (algebraMap T Q) N hN) g
  exact ⟨θ, (key θ).1 hθ, fun θ' h => hθu θ' ((key θ').2 h)⟩

/-- **Rigidity of étale algebras along a locally nilpotent ideal.** Let `N` be an ideal of a ring
`T` all of whose elements are nilpotent and let `P` and `Q` be two étale `T`-algebras, each given
a surjection onto one and the same ring `C` whose kernel is the ideal generated by `N` and whose
composites with the structure maps of `T` agree. Then exactly one isomorphism `P ≃+* Q` is
compatible with the structure maps and with the two surjections.

Both `P` and `Q` are therefore lifts of the `T ⧸ N`-algebra `C`, and the isomorphism is obtained
by lifting the identity of `C` in both directions; the uniqueness of lifts along a locally
nilpotent ideal forces both composites to be the identity. -/
theorem RingHom.Etale.existsUnique_ringEquiv_of_isLocallyNilpotent
    {T P Q C : Type*} [CommRing T] [CommRing P] [CommRing Q] [CommRing C]
    {bP : T →+* P} {bQ : T →+* Q} (hP : bP.Etale) (hQ : bQ.Etale)
    {N : Ideal T} (hN : N.IsLocallyNilpotent)
    {p : P →+* C} {q : Q →+* C}
    (hp : Function.Surjective p) (hq : Function.Surjective q)
    (hpk : RingHom.ker p = N.map bP) (hqk : RingHom.ker q = N.map bQ)
    (hpq : p.comp bP = q.comp bQ) :
    ∃! g : P ≃+* Q, (g : P →+* Q).comp bP = bQ ∧ q.comp (g : P →+* Q) = p := by
  let : Algebra T P := bP.toAlgebra
  let : Algebra T Q := bQ.toAlgebra
  have : Algebra.Etale T P := hP
  have : Algebra.Etale T Q := hQ
  obtain ⟨θ, hθ, -⟩ := existsUnique_algHom_comp_eq_of_isLocallyNilpotent hN hq hqk hpq
  obtain ⟨θ', hθ', -⟩ := existsUnique_algHom_comp_eq_of_isLocallyNilpotent hN hp hpk hpq.symm
  have hPid : θ'.comp θ = AlgHom.id T P :=
    (existsUnique_algHom_comp_eq_of_isLocallyNilpotent hN hp hpk rfl).unique
      (RingHom.ext fun x => (RingHom.congr_fun hθ' (θ x)).trans (RingHom.congr_fun hθ x))
      rfl
  have hQid : θ.comp θ' = AlgHom.id T Q :=
    (existsUnique_algHom_comp_eq_of_isLocallyNilpotent hN hq hqk rfl).unique
      (RingHom.ext fun y => (RingHom.congr_fun hθ (θ' y)).trans (RingHom.congr_fun hθ' y))
      rfl
  refine ⟨(AlgEquiv.ofAlgHom θ θ' hQid hPid).toRingEquiv, ⟨?_, hθ⟩, fun g hg => ?_⟩
  · exact RingHom.ext fun t => θ.commutes t
  · let ga : P →ₐ[T] Q := { (g : P →+* Q) with commutes' := RingHom.congr_fun hg.1 }
    have : ga = θ :=
      (existsUnique_algHom_comp_eq_of_isLocallyNilpotent hN hq hqk hpq).unique hg.2 hθ
    exact RingEquiv.ext fun x => congrArg (fun k : P →ₐ[T] Q => k x) this

end LocallyNilpotent

