/-!
# Adic and admissible properties of the completed tensor product

The completed tensor product of two adic rings over an adic base is again adic, with an
explicit ideal of definition; it is admissible, weakly admissible, has a countably generated
topology, and is Noetherian when the inputs are.

## References

* [Stacks Project, Tag 0GB4](https://stacks.math.columbia.edu/tag/0GB4)
-/

@[expose] public section

namespace TopologicalRing

section

open TopologicalRing
open scoped TensorProduct Topology

/-- If `I` is an ideal of definition and some ideal of definition `L` is adic, then the powers
of `I` form a basis of neighbourhoods of `0`. -/
theorem hasBasis_powers_of_idealDefinition
    {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    {I L : Ideal R} (hI : TopologicalRing.IsIdealOfDefinition I)
    (hL : TopologicalRing.IsIdealOfDefinition L) (hLadic : _root_.IsAdic L) :
    (nhds (0 : R)).HasBasis (fun _ : ℕ => True) (fun n => (I ^ n : Ideal R)) := by
  constructor
  intro U
  constructor
  · intro hU
    obtain ⟨n, hn⟩ := hI.2 U hU
    exact ⟨n, trivial, hn⟩
  · rintro ⟨n, -, hn⟩
    obtain ⟨k, hk⟩ := hL.2 (I : Set R) (hI.1.mem_nhds (zero_mem I))
    have hopen : IsOpen ((L ^ (k * n) : Ideal R) : Set R) := (isAdic_iff.mp hLadic).1 _
    have hle : L ^ (k * n) ≤ I ^ n := by
      rw [pow_mul]
      exact Ideal.pow_right_mono (SetLike.coe_subset_coe.mp hk) n
    exact Filter.mem_of_superset (hopen.mem_nhds (zero_mem _))
      (SetLike.coe_subset_coe.mpr hle |>.trans hn)

/-- The image of `I ⊗[B] C + A ⊗[B] J` in `A ⊗[B] C` is the ideal `I (A ⊗[B] C) + J (A ⊗[B] C)`,
viewed as a `B`-submodule. -/
theorem tensorProductSubmodule_eq_ideal_add
    {B A C : Type*} [CommRing B] [CommRing A] [CommRing C]
    [Algebra B A] [Algebra B C] (I : Ideal A) (J : Ideal C) :
    tensorProductSubmodule (I.restrictScalars B) (J.restrictScalars B) =
      ((Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C).toRingHom I +
        Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C).toRingHom J)
        ).restrictScalars B := by
  rw [tensorProductSubmodule, ← LinearMap.rTensor_def, ← LinearMap.lTensor_def]
  rw [show (LinearMap.rTensor C (Submodule.restrictScalars B I).subtype).range =
      (Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C).toRingHom I).restrictScalars
        B
      from (Ideal.map_includeLeft_eq (R := B) I).symm]
  rw [show (LinearMap.lTensor A (Submodule.restrictScalars B J).subtype).range =
      (Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C).toRingHom
        J).restrictScalars B
      from (Ideal.map_includeRight_eq (R := B) J).symm]
  simp

/-- The `n`-th power of a sum of mapped ideals contains the sum of the mapped `n`-th powers. -/
private theorem map_pow_sup_map_pow_le_pow
    {A C T : Type*} [CommRing A] [CommRing C] [CommRing T] (f : A →+* T) (g : C →+* T)
    (I : Ideal A) (J : Ideal C) (n : ℕ) :
    (I ^ n).map f ⊔ (J ^ n).map g ≤ (I.map f ⊔ J.map g) ^ n := by
  rw [Ideal.map_pow, Ideal.map_pow]
  exact sup_le (Ideal.pow_right_mono le_sup_left n) (Ideal.pow_right_mono le_sup_right n)

/-- The `(m + n)`-th power of a sum of mapped ideals lies in the sum of mapped `m`-th and `n`-th
powers. -/
private theorem map_sup_pow_add_le_map_pow_sup_map_pow
    {A C T : Type*} [CommRing A] [CommRing C] [CommRing T] (f : A →+* T) (g : C →+* T)
    (I : Ideal A) (J : Ideal C) (m n : ℕ) :
    (I.map f ⊔ J.map g) ^ (m + n) ≤ (I ^ m).map f ⊔ (J ^ n).map g := by
  rw [Ideal.map_pow, Ideal.map_pow]
  exact Ideal.sup_pow_add_le_pow_sup_pow

/-- If `I` and `J` are ideals of definition of `A` and `C`, each of which has an adic ideal of
definition, then the ideal generated by `I` and `J` in `A ⊗[B] C` is adic for the tensor product
topology. -/
theorem tensorProduct_basis_is_adic
    {B A C : Type*} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra B A] [Algebra B C]
    (I : Ideal A) (hI : TopologicalRing.IsIdealOfDefinition I)
    (I₀ : Ideal A) (hI₀ : TopologicalRing.IsIdealOfDefinition I₀) (hIₐ : _root_.IsAdic I₀)
    (J : Ideal C) (hJ : TopologicalRing.IsIdealOfDefinition J)
    (J₀ : Ideal C) (hJ₀ : TopologicalRing.IsIdealOfDefinition J₀) (hJₐ : _root_.IsAdic J₀) :
    letI : TopologicalSpace (A ⊗[B] C) := tensorProductTopology (R := B) (M := A) (N := C)
    letI : IsTopologicalRing (A ⊗[B] C) := inferInstance
    _root_.IsAdic (Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C).toRingHom I +
      Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C).toRingHom J) := by
  let K : Ideal (A ⊗[B] C) :=
    Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C).toRingHom I +
      Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C).toRingHom J
  let : TopologicalSpace (A ⊗[B] C) := tensorProductTopology (R := B) (M := A) (N := C)
  have hBI := hasBasis_powers_of_idealDefinition hI hI₀ hIₐ
  have hBJ := hasBasis_powers_of_idealDefinition hJ hJ₀ hJₐ
  rw [isAdic_iff]
  constructor
  · intro n
    let i : TensorProductSubmoduleIndex (R := B) (M := A) (N := C) :=
      (⟨(I ^ n).restrictScalars B, (I ^ n : Ideal A).restrictScalars B
          |>.toAddSubgroup.isOpen_of_mem_nhds (by simpa using hBI.mem_of_mem (i := n) trivial)⟩,
        ⟨(J ^ n).restrictScalars B, (J ^ n : Ideal C).restrictScalars B
          |>.toAddSubgroup.isOpen_of_mem_nhds (by simpa using hBJ.mem_of_mem (i := n) trivial)⟩)
    have hopen := (hasBasis_tensorProductTopology (R := B) (M := A) (N := C)).mem_of_mem
      (i := i) trivial
    have hsub : (tensorProductSubmoduleBasis i : Set (A ⊗[B] C)) ⊆
        ((K ^ n : Ideal (A ⊗[B] C)) : Set (A ⊗[B] C)) := by
      rw [tensorProductSubmoduleBasis, tensorProductSubmodule_eq_ideal_add]
      exact map_pow_sup_map_pow_le_pow _ _ I J n
    exact (K ^ n : Ideal (A ⊗[B] C)).toAddSubgroup.isOpen_of_mem_nhds
      (Filter.mem_of_superset hopen hsub)
  · intro U hU
    obtain ⟨i, -, hi⟩ :=
      (hasBasis_tensorProductTopology (R := B) (M := A) (N := C)).mem_iff.mp hU
    obtain ⟨m, -, hm⟩ := hBI.mem_iff.mp (i.1.2.mem_nhds (zero_mem i.1.1))
    obtain ⟨n, -, hn⟩ := hBJ.mem_iff.mp (i.2.2.mem_nhds (zero_mem i.2.1))
    refine ⟨m + n, ?_⟩
    have hpow : K ^ (m + n) ≤
        Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C).toRingHom (I ^ m) +
        Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C).toRingHom (J ^ n) := by
      exact map_sup_pow_add_le_map_pow_sup_map_pow _ _ I J m n
    intro x hx
    apply hi
    have hm' : (I ^ m).restrictScalars B ≤ i.1 := by
      change ((I ^ m).restrictScalars B : Set A) ⊆ (i.1 : Set A) at hm
      exact SetLike.coe_subset_coe.mp hm
    have hn' : (J ^ n).restrictScalars B ≤ i.2 := by
      change ((J ^ n).restrictScalars B : Set C) ⊆ (i.2 : Set C) at hn
      exact SetLike.coe_subset_coe.mp hn
    have hmono := tensorProductSubmodule_mono hm' hn'
    have hpow' : (K ^ (m + n)).restrictScalars B ≤
        tensorProductSubmodule ((I ^ m).restrictScalars B) ((J ^ n).restrictScalars B) := by
      rw [tensorProductSubmodule_eq_ideal_add]
      exact Submodule.restrictScalars_mono B hpow
    exact hmono (hpow' hx)

private theorem completion_map_pow_isClosed
    {R : Type*} [CommRing R] [UniformSpace R] [IsTopologicalRing R]
    [IsLinearTopology R R] [IsUniformAddGroup R]
    (I : Ideal R) (hI : I.FG) (hIadic : _root_.IsAdic I) (n : ℕ) :
    IsClosed ((Ideal.map (UniformSpace.Completion.coeRingHom :
      R →+* UniformSpace.Completion R) (I ^ n) : Ideal (UniformSpace.Completion R)) :
      Set (UniformSpace.Completion R)) := by
  let quotientTopologicalSpace (m : ℕ) :
      TopologicalSpace (R ⧸ (I ^ m • (⊤ : Submodule R R))) := ⊥
  let quotientUniformSpace (m : ℕ) :
      UniformSpace (R ⧸ (I ^ m • (⊤ : Submodule R R))) := ⊥
  let quotientDiscreteTopology (m : ℕ) :
      DiscreteTopology (R ⧸ (I ^ m • (⊤ : Submodule R R))) := ⟨rfl⟩
  let pkg := AdicCompletionBridge.adicAbstractCompletion I hIadic
  let pkg₀ := UniformSpace.Completion.cPkg (α := R)
  let : UniformSpace pkg.space := pkg.uniformStruct
  let : CompleteSpace pkg.space := pkg.complete
  let : T0Space pkg.space := pkg.separation
  let : UniformSpace pkg₀.space := pkg₀.uniformStruct
  let : CompleteSpace pkg₀.space := pkg₀.complete
  let : T0Space pkg₀.space := pkg₀.separation
  let : UniformSpace (AdicCompletion I R) := pkg.uniformStruct
  let : TopologicalSpace (AdicCompletion I R) := pkg.uniformStruct.toTopologicalSpace
  let : CompleteSpace (AdicCompletion I R) := pkg.complete
  let : T0Space (AdicCompletion I R) := pkg.separation
  let u := pkg₀.compareEquiv pkg
  let e := AdicCompletionBridge.adicCompletionRingEquiv I hIadic
  let homeo : UniformSpace.Completion R ≃ₜ AdicCompletion I R := {
    toEquiv := u.toEquiv
    continuous_toFun := u.uniformContinuous_toFun.continuous
    continuous_invFun := u.uniformContinuous_invFun.continuous }
  have hecomp : e.toRingHom.comp UniformSpace.Completion.coeRingHom =
      algebraMap R (AdicCompletion I R) := RingHom.ext fun r => by
    show AdicCompletionBridge.adicCompletionRingEquiv I hIadic
      (r : UniformSpace.Completion R) = algebraMap R (AdicCompletion I R) r
    rw [AdicCompletionBridge.adicCompletionRingEquiv_coe]
    exact (AdicCompletion.algebraMap_apply I r).symm
  have hmap :
      (Ideal.map (UniformSpace.Completion.coeRingHom :
        R →+* UniformSpace.Completion R) (I ^ n)).map e.toRingHom =
        Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n) := by
    rw [Ideal.map_map, hecomp]
  have hker :
      ((Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n) :
        Ideal (AdicCompletion I R)) : Set (AdicCompletion I R)) =
        (LinearMap.ker (AdicCompletion.eval I R n) : Set (AdicCompletion I R)) := by
    ext x
    show x ∈ Submodule.restrictScalars R
        (Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n)) ↔
      x ∈ LinearMap.ker (AdicCompletion.eval I R n)
    rw [← Ideal.smul_top_eq_map, ← AdicCompletion.pow_smul_top_eq_ker_eval hI]
  have heval : Continuous (AdicCompletion.eval I R n) := by
    show Continuous fun x : AdicCompletion I R => x.val n
    exact continuous_apply n |>.comp continuous_subtype_val
  have hclosedTarget : IsClosed
      ((Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n) :
        Ideal (AdicCompletion I R)) : Set (AdicCompletion I R)) := by
    rw [hker]
    exact isClosed_singleton.preimage heval
  have himage :
      (homeo '' (Ideal.map (UniformSpace.Completion.coeRingHom :
        R →+* UniformSpace.Completion R) (I ^ n) : Set (UniformSpace.Completion R))) =
        ((Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n) :
          Ideal (AdicCompletion I R)) : Set (AdicCompletion I R)) := by
    ext x
    have heq (y : UniformSpace.Completion R) : homeo y = e y := rfl
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [heq y, ← hmap]
      exact (Ideal.mem_map_of_equiv e _).mpr ⟨y, hy, rfl⟩
    · intro hx
      rw [← hmap] at hx
      have hx' : x ∈ Ideal.map e.toRingHom
          (Ideal.map UniformSpace.Completion.coeRingHom (I ^ n)) := hx
      obtain ⟨y, hy, hye⟩ := (Ideal.mem_map_of_equiv e _).mp hx'
      exact ⟨y, hy, by simpa [heq y] using hye⟩
  exact (homeo.isClosed_image (s := _)).mp (himage.symm ▸ hclosedTarget)

