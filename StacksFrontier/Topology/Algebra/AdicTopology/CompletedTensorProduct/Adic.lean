open Filter
open scoped TensorProduct Topology

/-- The `n`-th power of the closure of an ideal lies in the closure of its `n`-th power. -/
public theorem closure_pow_le_closure_pow {R : Type*} [CommRing R]
    [TopologicalSpace R] [IsTopologicalRing R] (I : Ideal R) (n : ℕ) :
    I.closure ^ n ≤ (I ^ n).closure := by
  have mul_le (J K : Ideal R) : J.closure * K.closure ≤ (J * K).closure := by
    rw [Ideal.mul_le]; intro x hx y hy
    exact map_mem_closure₂ continuous_mul hx hy
      (fun a ha b hb ↦ Ideal.mul_mem_mul ha hb)
  induction n with
  | zero => simpa using (Ideal.closure_eq_of_isClosed (⊤ : Ideal R) isClosed_univ)
  | succ n ih =>
    rw [pow_succ, pow_succ]
    exact (Ideal.mul_mono ih le_rfl).trans (mul_le _ _)

/-- The open ideals contained in an open ideal `I₀` form a basis of neighbourhoods of `0`. -/
private theorem hasBasis_open_ideal_le {R : Type*} [CommRing R] [TopologicalSpace R]
    [IsTopologicalRing R] [IsLinearTopology R R] (I₀ : Ideal R) (hI₀ : IsOpen (I₀ : Set R)) :
    (nhds (0 : R)).HasBasis (fun _ : {I : Ideal R // IsOpen (I : Set R) ∧ I ≤ I₀} => True)
      (fun i => (i.1 : Set R)) :=
  (IsLinearTopology.hasBasis_open_ideal (R := R)).to_hasBasis
    (fun L hL => ⟨⟨L ⊓ I₀, hL.inter hI₀, inf_le_right⟩, trivial, inf_le_left⟩)
    (fun i _ => ⟨i.1, i.2.1, le_rfl⟩)

set_option synthInstance.maxHeartbeats 200000 in
/-- The completed tensor product of pre-admissible linearly topologized
algebras is admissible. -/
@[stacks 0GB4 "admissible", ega "0 7.7.7" "admissibility"]
public theorem completedTensorProduct_isAdmissible
    {B A C : Type*} [CommRing B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C]
    [IsTopologicalRing C] [IsLinearTopology C C]
    [Algebra B A] [Algebra B C]
    (hA : TopologicalRing.IsPreAdmissible A)
    (hC : TopologicalRing.IsPreAdmissible C) :
    TopologicalRing.IsAdmissible
      (TopologicalRing.CompletedTensorProduct (R := B) (M := A) (N := C)) := by
  classical
  let := TopologicalRing.tensorProductTopology (R := B) (M := A) (N := C)
  let := TopologicalRing.tensorProductUniformSpace (R := B) (M := A) (N := C)
  rcases hA with ⟨IA, hIA⟩
  rcases hC with ⟨JC, hJC⟩
  let ιA := {I : Ideal A // IsOpen (I : Set A) ∧ I ≤ IA}
  let ιC := {J : Ideal C // IsOpen (J : Set C) ∧ J ≤ JC}
  let I : ιA → Ideal A := fun i => i.1
  let J : ιC → Ideal C := fun j => j.1
  have bI : (nhds (0 : A)).HasBasis (fun _ : ιA => True) (fun i => (I i : Set A)) :=
    hasBasis_open_ideal_le IA hIA.1
  have bJ : (nhds (0 : C)).HasBasis (fun _ : ιC => True) (fun j => (J j : Set C)) :=
    hasBasis_open_ideal_le JC hJC.1
  let T := TopologicalRing.CompletedTensorProduct (R := B) (M := A) (N := C)
  let φA : A →+* T := RingHom.comp UniformSpace.Completion.coeRingHom
    ((Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C).toRingHom)
  let φC : C →+* T := RingHom.comp UniformSpace.Completion.coeRingHom
    ((Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C).toRingHom)
  let i₀ : ιA := ⟨IA, hIA.1, le_rfl⟩
  let j₀ : ιC := ⟨JC, hJC.1, le_rfl⟩
  let K : Ideal T := TopologicalRing.projectionKernel I J bI bJ i₀ j₀
  have hKopen : IsOpen (K : Set T) :=
    TopologicalRing.isOpen_projectionKernel I J bI bJ i₀ j₀
  refine ⟨⟨K, hKopen, ?_⟩, ?_⟩
  · intro U hU
    obtain ⟨p, -, hp⟩ :=
      (TopologicalRing.hasBasis_projectionKernel I J bI bJ).mem_iff.mp hU
    let i : ιA := p.1
    let j : ιC := p.2
    obtain ⟨n, hn⟩ := hIA.2 (I i : Set A) (i.2.1.mem_nhds (by simp))
    obtain ⟨m, hm⟩ := hJC.2 (J j : Set C) (j.2.1.mem_nhds (by simp))
    let L : Ideal T := (IA.map φA)
    let M : Ideal T := (JC.map φC)
    let Q : Ideal T := TopologicalRing.projectionKernel I J bI bJ i j
    have hIimage : (I i).map φA ≤ Q := by
      intro x hx
      show x ∈ SetLike.coe (TopologicalRing.projectionKernel I J bI bJ i j)
      rw [TopologicalRing.projectionKernel_eq_closure I J bI bJ i j]
      exact subset_closure (by
        rw [Ideal.add_eq_sup]
        exact (le_sup_left : (I i).map φA ≤ (I i).map φA ⊔ (J j).map φC) hx)
    have hJimage : (J j).map φC ≤ Q := by
      intro x hx
      show x ∈ SetLike.coe (TopologicalRing.projectionKernel I J bI bJ i j)
      rw [TopologicalRing.projectionKernel_eq_closure I J bI bJ i j]
      exact subset_closure (by
        rw [Ideal.add_eq_sup]
        exact (le_sup_right : (J j).map φC ≤ (I i).map φA ⊔ (J j).map φC) hx)
    have hLpow : L ^ n ≤ Q := by
      rw [← Ideal.map_pow]
      exact (Ideal.map_mono (SetLike.coe_subset_coe.mp hn)).trans hIimage
    have hMpow : M ^ m ≤ Q := by
      rw [← Ideal.map_pow]
      exact (Ideal.map_mono (SetLike.coe_subset_coe.mp hm)).trans hJimage
    have hsumPow : (L + M) ^ (n + m) ≤ Q := by
      calc
        (L + M) ^ (n + m) ≤ L ^ n + M ^ m := by
          simpa [Ideal.add_eq_sup] using
            (Ideal.sup_pow_add_le_pow_sup_pow (I := L) (J := M) (n := n) (m := m))
        _ ≤ Q := sup_le hLpow hMpow
    have hQclosed : IsClosed (Q : Set T) :=
      AddSubgroup.isClosed_of_isOpen Q.toAddSubgroup
        (TopologicalRing.isOpen_projectionKernel I J bI bJ i j)
    have hclosure : (Ideal.closure ((L + M) ^ (n + m)) : Ideal T) ≤ Q := by
      intro x hx
      change x ∈ closure (((L + M) ^ (n + m) : Ideal T) : Set T) at hx
      exact closure_minimal hsumPow hQclosed hx
    have hKeq : K = Ideal.closure (L + M) := by
      apply Ideal.ext
      intro x
      show x ∈ SetLike.coe (TopologicalRing.projectionKernel I J bI bJ i₀ j₀) ↔
        x ∈ SetLike.coe (Ideal.closure (L + M))
      rw [TopologicalRing.projectionKernel_eq_closure (B := B) I J bI bJ i₀ j₀]
    refine ⟨n + m, fun x hx => hp ?_⟩
    have hKpow : K ^ (n + m) ≤ Q := by
      rw [hKeq]
      exact (closure_pow_le_closure_pow (L + M) (n + m)).trans hclosure
    simpa [Q, i, j] using hKpow hx
  · refine ⟨?_, ?_⟩
    · show T2Space T
      infer_instance
    · show @CompleteSpace T (IsTopologicalAddGroup.rightUniformSpace T)
      have hu : IsTopologicalAddGroup.rightUniformSpace T = (inferInstance : UniformSpace T) :=
        IsUniformAddGroup.rightUniformSpace_eq
      rw [hu]
      infer_instance

end

