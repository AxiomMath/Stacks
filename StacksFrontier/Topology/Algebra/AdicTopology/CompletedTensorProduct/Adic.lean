private theorem completedTensorProduct_adic_data
    {B A C : Type*} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra B A] [Algebra B C]
    (_hBA : Continuous (algebraMap B A)) (_hBC : Continuous (algebraMap B C))
    (_hA : TopologicalRing.IsPreAdic A)
    (_hAfg : ∃ I : Ideal A, TopologicalRing.IsIdealOfDefinition I ∧ I.FG)
    (_hC : TopologicalRing.IsPreAdic C)
    (_hCfg : ∃ J : Ideal C, TopologicalRing.IsIdealOfDefinition J ∧ J.FG) :
    ∃ K : Ideal (CompletedTensorProduct (R := B) (M := A) (N := C)),
      K.FG ∧ TopologicalRing.IsIdealOfDefinition K ∧ _root_.IsAdic K := by
  obtain ⟨I, hIdef, hIfg⟩ := _hAfg
  obtain ⟨J, hJdef, hJfg⟩ := _hCfg
  obtain ⟨I₀, hI₀def, hI₀adic⟩ := _hA
  obtain ⟨J₀, hJ₀def, hJ₀adic⟩ := _hC
  let R := A ⊗[B] C
  let : TopologicalSpace R := tensorProductTopology (R := B) (M := A) (N := C)
  let : UniformSpace R := tensorProductUniformSpace (R := B) (M := A) (N := C)
  let : IsTopologicalRing R := inferInstance
  let : IsLinearTopology R R := inferInstance
  let K : Ideal R :=
    Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] R).toRingHom I +
      Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] R).toRingHom J
  have hKfg : K.FG := by
    dsimp [K]
    exact Submodule.FG.sup (hIfg.map _) (hJfg.map _)
  have hKadic : _root_.IsAdic K := by
    simpa [K] using tensorProduct_basis_is_adic I hIdef I₀ hI₀def hI₀adic
      J hJdef J₀ hJ₀def hJ₀adic
  have hBI := hasBasis_powers_of_idealDefinition hIdef hI₀def hI₀adic
  have hBJ := hasBasis_powers_of_idealDefinition hJdef hJ₀def hJ₀adic
  let Iseq : ℕ → Ideal A := fun n => I ^ n
  let Jseq : ℕ → Ideal C := fun n => J ^ n
  let X := CompletedTensorProduct (R := B) (M := A) (N := C)
  let ι : R →+* X := UniformSpace.Completion.coeRingHom
  let Kseq : ℕ → ℕ → Ideal R := fun m n =>
    Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] R).toRingHom (I ^ m) +
      Ideal.map (Algebra.TensorProduct.includeRight : C →ₐ[B] R).toRingHom (J ^ n)
  let Q (m n : ℕ) : Ideal X :=
    TopologicalRing.projectionKernel (B := B) Iseq Jseq hBI hBJ m n
  have hmap_Kseq (m n : ℕ) :
      Ideal.map ι (Kseq m n) =
        Ideal.map (ι.comp (Algebra.TensorProduct.includeLeft : A →ₐ[B] R).toRingHom)
            (I ^ m) +
          Ideal.map (ι.comp (Algebra.TensorProduct.includeRight : C →ₐ[B] R).toRingHom)
            (J ^ n) := by
    simp only [Kseq, Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_map]
  have hQ_closure (m n : ℕ) : Q m n = Ideal.closure (Ideal.map ι (Kseq m n)) := by
    apply SetLike.coe_injective
    rw [TopologicalRing.projectionKernel_eq_closure (B := B)
      (I := Iseq) (J := Jseq) hBI hBJ m n]
    rw [hmap_Kseq m n]
  let P : Ideal X := Q 1 1
  have hP_eq : P = Ideal.map ι K := by
    have hcl : IsClosed (Ideal.map ι K : Set X) := by
      simpa only [pow_one] using completion_map_pow_isClosed K hKfg hKadic 1
    have h := hQ_closure 1 1
    have hKseq_one : Kseq 1 1 = K := by simp [Kseq, K]
    rw [hKseq_one, Ideal.closure_eq_of_isClosed _ hcl] at h
    simpa [P, Q, hKfg, K, Kseq, ι] using h
  have hPpow (n : ℕ) : P ^ n = Ideal.map ι (K ^ n) := by
    rw [hP_eq, Ideal.map_pow]
  have hKdiag_le (n : ℕ) : Kseq n n ≤ K ^ n := by
    exact map_pow_sup_map_pow_le_pow _ _ I J n
  have hQ_le_power (n : ℕ) : Q n n ≤ P ^ n := by
    rw [hQ_closure n n, hPpow n]
    apply SetLike.coe_subset_coe.mpr
    calc
      _ ⊆ closure (Ideal.map ι (K ^ n) : Set X) :=
        closure_mono (SetLike.coe_subset_coe.mpr (Ideal.map_mono (hKdiag_le n)))
      _ = (Ideal.map ι (K ^ n) : Set X) := by
        exact (completion_map_pow_isClosed K hKfg hKadic n).closure_eq
  have hpower_le_Q (n : ℕ) : P ^ (n + n) ≤ Q n n := by
    rw [hPpow, hQ_closure]
    have hKpow : K ^ (n + n) ≤ Kseq n n := by
      exact map_sup_pow_add_le_map_pow_sup_map_pow _ _ I J n n
    exact (Ideal.map_mono hKpow).trans (SetLike.coe_subset_coe.mpr subset_closure)
  have hQ_mono (m n p q : ℕ) (hmp : m ≤ p) (hnq : n ≤ q) :
      Q p q ≤ Q m n := by
    rw [hQ_closure p q, hQ_closure m n]
    apply SetLike.coe_subset_coe.mpr
    apply closure_mono
    apply SetLike.coe_subset_coe.mpr
    have hKseq : Kseq p q ≤ Kseq m n := by
      show Ideal.map (Algebra.TensorProduct.includeLeft.toRingHom) (I ^ p) ⊔
          Ideal.map (Algebra.TensorProduct.includeRight.toRingHom) (J ^ q) ≤
        Ideal.map (Algebra.TensorProduct.includeLeft.toRingHom) (I ^ m) ⊔
          Ideal.map (Algebra.TensorProduct.includeRight.toRingHom) (J ^ n)
      exact sup_le_sup (Ideal.map_mono (Ideal.pow_le_pow_right hmp))
        (Ideal.map_mono (Ideal.pow_le_pow_right hnq))
    exact Ideal.map_mono hKseq
  have hQbasis :
      (nhds (0 : X)).HasBasis (fun _ : ℕ × ℕ => True)
        (fun p => (Q p.1 p.2 : Set X)) := by
    exact TopologicalRing.hasBasis_projectionKernel (B := B) Iseq Jseq hBI hBJ
  have hQopen (m n : ℕ) : IsOpen (Q m n : Set X) := by
    exact TopologicalRing.isOpen_projectionKernel (B := B) Iseq Jseq hBI hBJ m n
  have hcofinal : ∀ U ∈ nhds (0 : X), ∃ n : ℕ,
      ((P ^ n : Ideal X) : Set X) ⊆ U := by
    intro U hU
    obtain ⟨p, -, hpU⟩ := hQbasis.mem_iff.mp hU
    let m := max p.1 p.2
    refine ⟨m + m, ?_⟩
    have hsubset : ((P ^ (m + m) : Ideal X) : Set X) ⊆ (Q p.1 p.2 : Set X) :=
      SetLike.coe_subset_coe.mpr ((hpower_le_Q m).trans
        (hQ_mono p.1 p.2 m m (Nat.le_max_left _ _) (Nat.le_max_right _ _)))
    exact hsubset.trans hpU
  have hPopen (n : ℕ) : IsOpen ((P ^ n : Ideal X) : Set X) := by
    have hsub : Q (n + n) (n + n) ≤ P ^ n :=
      (hQ_le_power (n + n)).trans (Ideal.pow_le_pow_right (by omega))
    exact (P ^ n).toAddSubgroup.isOpen_of_mem_nhds (Filter.mem_of_superset
      ((hQopen (n + n) (n + n)).mem_nhds (zero_mem _)) (SetLike.coe_subset_coe.mpr hsub))
  have hPadic : _root_.IsAdic P := isAdic_iff.mpr ⟨hPopen, hcofinal⟩
  have hPdef : TopologicalRing.IsIdealOfDefinition P :=
    ⟨hQopen 1 1, hcofinal⟩
  exact ⟨P, by simpa only [hP_eq] using hKfg.map ι, hPdef, hPadic⟩

set_option synthInstance.maxHeartbeats 200000 in
/-- The completed tensor product of two pre-adic, linearly topologized algebras with finitely
generated ideals of definition is adic. -/
@[stacks 0GB4 "adic_finite"]
public theorem completedTensorProduct_isAdic
    {B A C : Type*} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra B A] [Algebra B C]
    (_hBA : Continuous (algebraMap B A)) (_hBC : Continuous (algebraMap B C))
    (_hA : TopologicalRing.IsPreAdic A)
    (_hAfg : ∃ I : Ideal A, TopologicalRing.IsIdealOfDefinition I ∧ I.FG)
    (_hC : TopologicalRing.IsPreAdic C)
    (_hCfg : ∃ J : Ideal C, TopologicalRing.IsIdealOfDefinition J ∧ J.FG) :
    TopologicalRing.IsAdic (CompletedTensorProduct (R := B) (M := A) (N := C)) := by
  obtain ⟨K, hKfg, hKdef, hKadic⟩ :=
    completedTensorProduct_adic_data _hBA _hBC _hA _hAfg _hC _hCfg
  refine ⟨⟨K, hKdef, hKadic⟩, inferInstance, ?_⟩
  rw [IsUniformAddGroup.rightUniformSpace_eq]
  infer_instance

/-- The completed tensor product has a finitely generated ideal of definition. -/
@[stacks 0GB4 "adic_finite"]
public theorem exists_fg_ideal_of_definition
    {B A C : Type*} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra B A] [Algebra B C]
    (_hBA : Continuous (algebraMap B A)) (_hBC : Continuous (algebraMap B C))
    (_hA : TopologicalRing.IsPreAdic A)
    (_hAfg : ∃ I : Ideal A, TopologicalRing.IsIdealOfDefinition I ∧ I.FG)
    (_hC : TopologicalRing.IsPreAdic C)
    (_hCfg : ∃ J : Ideal C, TopologicalRing.IsIdealOfDefinition J ∧ J.FG) :
    ∃ K : Ideal (CompletedTensorProduct (R := B) (M := A) (N := C)),
      K.FG ∧ TopologicalRing.IsIdealOfDefinition K := by
  obtain ⟨K, hKfg, hKdef, hKadic⟩ :=
    completedTensorProduct_adic_data _hBA _hBC _hA _hAfg _hC _hCfg
  exact ⟨K, hKfg, hKdef⟩

end

section

open Filter
open scoped Topology TensorProduct
open TopologicalRing

private lemma topologicalNilradical_isIdealOfDefinition_of_noetherian
    {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsLinearTopology R R] [IsNoetherianRing R]
    (hR : TopologicalRing.IsPreAdic R) :
    TopologicalRing.IsIdealOfDefinition (topologicalNilradical R) ∧
      (topologicalNilradical R).FG ∧ _root_.IsAdic (topologicalNilradical R) := by
  classical
  obtain ⟨I, hIdef, _hIadic⟩ := hR
  let N := topologicalNilradical R
  have hIN : I ≤ N := by
    intro x hx
    exact IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mp
      (topologicallyNilpotent_of_mem_idealOfDefinition _ hIdef hx)
  have hNopen : IsOpen (N : Set R) :=
    Ideal.isOpen_of_isOpen_subideal hIN hIdef.1
  have hNfg : N.FG := Ideal.fg_of_isNoetherianRing N
  have hNcofinal : ∀ U ∈ 𝓝 (0 : R), ∃ n : ℕ, ((N ^ n : Ideal R) : Set R) ⊆ U := by
    intro U hU
    obtain ⟨J, hJnhds, hJU⟩ := IsLinearTopology.hasBasis_ideal.mem_iff.mp hU
    have hNrad : N ≤ J.radical := fun x hx =>
      IsTopologicallyNilpotent.exists_pow_mem_of_mem_nhds hx hJnhds
    obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hNrad hNfg
    exact ⟨n, Set.Subset.trans (show (N ^ n : Ideal R) ≤ J from hn) hJU⟩
  have hNpowopen (n : ℕ) : IsOpen ((N ^ n : Ideal R) : Set R) :=
    Ideal.isOpen_of_isOpen_subideal (Ideal.pow_right_mono hIN n) ((isAdic_iff.mp _hIadic).1 n)
  exact ⟨⟨hNopen, hNcofinal⟩, hNfg, isAdic_iff.mpr ⟨hNpowopen, hNcofinal⟩⟩

private lemma tensorProductSubmodule_eq_map_sup
    {B A C : Type*} [CommRing B] [CommRing A] [Algebra B A]
    [CommRing C] [Algebra B C] (I : Ideal A) (J : Ideal C) :
    TopologicalRing.tensorProductSubmodule (I.restrictScalars B) (J.restrictScalars B) =
      ((I.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C) ⊔
        J.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C)).restrictScalars B) := by
  exact tensorProductSubmodule_eq_ideal_add I J


private lemma closure_map_eq_closure_image_of_dense
    {R S : Type*} [CommRing R] [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    (f : R →+* S) (hdense : DenseRange f) (I : Ideal R) :
    Ideal.closure (I.map f) = closure (f '' (I : Set R)) := by
  let H := RingHom.closureImageIdeal f I hdense
  have hmap : I.map f ≤ H := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact subset_closure ⟨x, hx, rfl⟩
  have h₁ : Ideal.closure (I.map f) ≤ H :=
    closure_minimal (SetLike.coe_subset_coe.mpr hmap) isClosed_closure
  have h₂ : H ≤ Ideal.closure (I.map f) := by
    show closure (f '' (I : Set R)) ⊆ closure (I.map f : Set S)
    exact closure_mono (by rintro _ ⟨x, hx, rfl⟩; exact Ideal.mem_map_of_mem f hx)
  exact congrArg (fun K : Ideal S => (K : Set S)) (le_antisymm h₁ h₂)

private lemma completion_coe_isTaut
    {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsLinearTopology R R]
    :
    RingHom.IsTaut (UniformSpace.Completion.coeRingHom : R →+* UniformSpace.Completion R) := by
  let φ : R → UniformSpace.Completion R := UniformSpace.Completion.coeRingHom
  have hInd : Topology.IsInducing φ :=
    UniformSpace.Completion.isUniformInducing_coe R |>.isInducing
  have hdense : DenseRange φ := UniformSpace.Completion.denseRange_coe
  have hcont : Continuous φ := UniformSpace.Completion.continuous_coe R
  have hopen (I : Ideal R) (hI : IsOpen (I : Set R)) :
      IsOpen (Ideal.closure (I.map (UniformSpace.Completion.coeRingHom :
        R →+* UniformSpace.Completion R)) : Set (UniformSpace.Completion R)) := by
    have hclosureSet :
        (Ideal.closure (I.map (UniformSpace.Completion.coeRingHom :
          R →+* UniformSpace.Completion R)) : Set (UniformSpace.Completion R)) =
          closure (φ '' (I : Set R)) := by
      simpa only [Ideal.coe_closure] using
        closure_map_eq_closure_image_of_dense
          (UniformSpace.Completion.coeRingHom : R →+* UniformSpace.Completion R) hdense I
    obtain ⟨V, hV, hpre⟩ := hInd.isOpen_iff.mp hI
    have h0V : (0 : UniformSpace.Completion R) ∈ V := by
      have : (0 : R) ∈ φ ⁻¹' V := by rw [hpre]; exact I.zero_mem
      exact this
    have hVsub : V ⊆ closure (φ '' (I : Set R)) := by
      intro x hx
      rw [mem_closure_iff_nhds]
      intro U hU
      have hUV : U ∩ V ∈ 𝓝 x := inter_mem hU (hV.mem_nhds hx)
      have hxrange : x ∈ closure (Set.range φ) := hdense x
      rw [mem_closure_iff_nhds] at hxrange
      obtain ⟨y, hy⟩ := hxrange (U ∩ V) hUV
      rcases hy with ⟨⟨hyU, hyV⟩, hyRange⟩
      rcases hyRange with ⟨a, rfl⟩
      have haI : a ∈ I := by
        have : a ∈ φ ⁻¹' V := hyV
        rw [hpre] at this
        exact this
      exact ⟨φ a, ⟨hyU, ⟨a, haI, rfl⟩⟩⟩
    have hnhdsImg : closure (φ '' (I : Set R)) ∈ 𝓝 (0 : UniformSpace.Completion R) :=
      Filter.mem_of_superset (hV.mem_nhds h0V) hVsub
    let H : AddSubgroup (UniformSpace.Completion R) :=
      (Ideal.closure (I.map (UniformSpace.Completion.coeRingHom :
        R →+* UniformSpace.Completion R))).toAddSubgroup
    have hH : (H : Set (UniformSpace.Completion R)) ∈ 𝓝 (0 : UniformSpace.Completion R) := by
      simpa only [H, Submodule.coe_toAddSubgroup] using hclosureSet.symm ▸ hnhdsImg
    exact H.isOpen_of_mem_nhds hH
  refine ⟨hopen, ?_⟩
  refine Filter.HasBasis.mk fun U => ?_
  constructor
  · intro hU
    obtain ⟨V, ⟨hV, hVclosed⟩, hVU⟩ :=
      (closed_nhds_basis (0 : UniformSpace.Completion R)).mem_iff.mp hU
    have hpre : φ ⁻¹' V ∈ 𝓝 (0 : R) := hcont.continuousAt.preimage_mem_nhds hV
    obtain ⟨I, hIopen, hIV⟩ := IsLinearTopology.hasBasis_open_ideal.mem_iff.mp hpre
    refine ⟨I, hIopen, ?_⟩
    have hclosureSet :
        (Ideal.closure (I.map (UniformSpace.Completion.coeRingHom :
          R →+* UniformSpace.Completion R)) : Set (UniformSpace.Completion R)) =
          closure (φ '' (I : Set R)) := by
      simpa only [Ideal.coe_closure] using
        closure_map_eq_closure_image_of_dense
          (UniformSpace.Completion.coeRingHom : R →+* UniformSpace.Completion R) hdense I
    rw [hclosureSet]
    apply Set.Subset.trans (closure_minimal ?_ hVclosed) hVU
    rintro y ⟨x, hxI, rfl⟩
    exact hIV hxI
  · rintro ⟨I, hIopen, hIU⟩
    exact Filter.mem_of_superset ((hopen I hIopen).mem_nhds (Ideal.zero_mem _)) hIU

private lemma exists_pow_le_pow_of_isAdic {R : Type*} [CommRing R] [TopologicalSpace R]
    [IsTopologicalRing R] {I J : Ideal R} (hI : _root_.IsAdic I) (hJ : _root_.IsAdic J) (n : ℕ) :
    ∃ m, I ^ m ≤ J ^ n := by
  obtain ⟨m, -, hsub⟩ := hI.hasBasis_nhds_zero.mem_iff.mp
    (((isAdic_iff.mp hJ).1 n).mem_nhds (Ideal.zero_mem _))
  exact ⟨m, SetLike.coe_subset_coe.mp hsub⟩

private lemma isAdic_map_of_isAdic_of_isAdic
    {A B : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B]
    (f : A →+* B) (I J : Ideal A)
    (hI : _root_.IsAdic I) (hJ : _root_.IsAdic J)
    (hImap : _root_.IsAdic (I.map f)) :
    _root_.IsAdic (J.map f) := by
  have hmap {P Q : Ideal A} {m n : ℕ} (h : P ^ m ≤ Q ^ n) : (P.map f) ^ m ≤ (Q.map f) ^ n := by
    rw [← Ideal.map_pow, ← Ideal.map_pow]
    exact Ideal.map_mono h
  apply isAdic_iff.mpr
  constructor
  · intro n
    obtain ⟨m, hm⟩ := exists_pow_le_pow_of_isAdic hI hJ n
    exact ((J.map f) ^ n).toAddSubgroup.isOpen_of_mem_nhds
      (Filter.mem_of_superset (((isAdic_iff.mp hImap).1 m).mem_nhds (Ideal.zero_mem _))
        (SetLike.coe_subset_coe.mpr (hmap hm)))
  · intro U hU
    obtain ⟨n, -, hn⟩ := hImap.hasBasis_nhds_zero.mem_iff.mp hU
    obtain ⟨m, hm⟩ := exists_pow_le_pow_of_isAdic hJ hI n
    exact ⟨m, (SetLike.coe_subset_coe.mpr (hmap hm)).trans hn⟩

private lemma tensorProduct_adic_of_adic_factors
    {B A C : Type*} [CommRing B] [CommRing A] [Algebra B A]
    [CommRing C] [Algebra B C]
    [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [TopologicalSpace C] [IsTopologicalRing C] [IsLinearTopology C C]
    (I : Ideal A) (K : Ideal C) (hI : _root_.IsAdic I) (hK : _root_.IsAdic K)
    (hIFG : I.FG) (hKFG : K.FG) :
    letI : TopologicalSpace (A ⊗[B] C) :=
      TopologicalRing.tensorProductTopology (R := B) (M := A) (N := C)
    _root_.IsAdic
      (I.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] C) ⊔
        K.map (Algebra.TensorProduct.includeRight : C →ₐ[B] A ⊗[B] C)) := by
  let T := A ⊗[B] C
  let f : A →+* T := (Algebra.TensorProduct.includeLeft : A →ₐ[B] T).toRingHom
  let g : C →+* T := (Algebra.TensorProduct.includeRight : C →ₐ[B] T).toRingHom
  let L : Ideal T := I.map f ⊔ K.map g
  let : TopologicalSpace T := TopologicalRing.tensorProductTopology (R := B) (M := A) (N := C)
  have hBasis : (𝓝 (0 : T)).HasBasis (fun _ : ℕ × ℕ => True) fun mn =>
      TopologicalRing.tensorProductSubmodule
        ((I ^ mn.1).restrictScalars B) ((K ^ mn.2).restrictScalars B) := by
    refine (TopologicalRing.hasBasis_tensorProductTopology (R := B) (M := A) (N := C)).to_hasBasis
      ?_ ?_
    · intro i _
      obtain ⟨m, hm⟩ := (isAdic_iff.mp hI).2 (i.1.1 : Set A)
        (i.1.2.mem_nhds i.1.1.zero_mem)
      obtain ⟨n, hn⟩ := (isAdic_iff.mp hK).2 (i.2.1 : Set C)
        (i.2.2.mem_nhds i.2.1.zero_mem)
      refine ⟨(m, n), trivial, ?_⟩
      apply TopologicalRing.tensorProductSubmodule_mono
      · exact SetLike.coe_subset_coe.mp hm
      · exact SetLike.coe_subset_coe.mp hn
    · intro mn _
      refine ⟨(⟨(I ^ mn.1).restrictScalars B, (isAdic_iff.mp hI).1 mn.1⟩,
        ⟨(K ^ mn.2).restrictScalars B, (isAdic_iff.mp hK).1 mn.2⟩), trivial, ?_⟩
      rfl
  have hLfg : L.FG := Submodule.FG.sup (hIFG.map f) (hKFG.map g)
  have hP_eq (m n : ℕ) :
      TopologicalRing.tensorProductSubmodule ((I ^ m).restrictScalars B)
          ((K ^ n).restrictScalars B) =
        (((I ^ m).map f ⊔ (K ^ n).map g).restrictScalars B) :=
    tensorProductSubmodule_eq_map_sup (I ^ m) (K ^ n)
  have hP_le (m n : ℕ) :
      TopologicalRing.tensorProductSubmodule ((I ^ m).restrictScalars B)
          ((K ^ n).restrictScalars B) ≤ (L ^ min m n).restrictScalars B := by
    rw [hP_eq]
    apply Submodule.restrictScalars_mono
    rw [Ideal.map_pow, Ideal.map_pow]
    show (I.map f) ^ m ⊔ (K.map g) ^ n ≤ L ^ min m n
    apply sup_le
    · exact (Ideal.pow_right_mono (le_sup_left : I.map f ≤ L) m).trans
        (Ideal.pow_le_pow_right (min_le_left m n))
    · exact (Ideal.pow_right_mono (le_sup_right : K.map g ≤ L) n).trans
        (Ideal.pow_le_pow_right (min_le_right m n))
  have hLrad (m n : ℕ) : L ≤ ((I ^ m).map f ⊔ (K ^ n).map g).radical := by
    apply sup_le
    · intro x hx
      rw [Ideal.mem_radical_iff]
      refine ⟨m, ?_⟩
      have hxpow := Ideal.pow_mem_pow hx m
      rw [← Ideal.map_pow] at hxpow
      exact (le_sup_left : (I ^ m).map f ≤ (I ^ m).map f ⊔ (K ^ n).map g) hxpow
    · intro x hx
      rw [Ideal.mem_radical_iff]
      refine ⟨n, ?_⟩
      have hxpow := Ideal.pow_mem_pow hx n
      rw [← Ideal.map_pow] at hxpow
      exact (le_sup_right : (K ^ n).map g ≤ (I ^ m).map f ⊔ (K ^ n).map g) hxpow
  have hP_cofinal (m n : ℕ) : ∃ q : ℕ,
      (L ^ q : Ideal T) ≤ (I ^ m).map f ⊔ (K ^ n).map g :=
    Ideal.exists_pow_le_of_le_radical_of_fg (hLrad m n) hLfg
  apply isAdic_iff.mpr
  constructor
  · intro n
    have hPnhds :
        (TopologicalRing.tensorProductSubmodule ((I ^ n).restrictScalars B)
          ((K ^ n).restrictScalars B) : Set T) ∈ 𝓝 (0 : T) :=
      hBasis.mem_iff.mpr ⟨(n, n), trivial, Set.Subset.rfl⟩
    have hsub := hP_le n n
    exact (L ^ n).toAddSubgroup.isOpen_of_mem_nhds
      (Filter.mem_of_superset hPnhds
        (show (TopologicalRing.tensorProductSubmodule ((I ^ n).restrictScalars B)
          ((K ^ n).restrictScalars B) : Set T) ⊆ (L ^ n : Ideal T) from
          SetLike.coe_subset_coe.mpr (by simpa using hsub)))
  · intro U hU
    obtain ⟨mn, _, hsub⟩ := hBasis.mem_iff.mp hU
    obtain ⟨q, hq⟩ := hP_cofinal mn.1 mn.2
    exact ⟨q, Set.Subset.trans
      (show ((L ^ q : Ideal T) : Set T) ⊆
        (((I ^ mn.1).map f ⊔ (K ^ mn.2).map g : Ideal T) : Set T) from hq)
      (by simpa only [hP_eq, Submodule.coe_restrictScalars] using hsub)⟩

set_option synthInstance.maxHeartbeats 200000 in
/-- If the induced quotient map is of finite type, the completed tensor product
of pre-adic Noetherian algebras is Noetherian. -/
@[stacks 0GB4 "adic_noetherian"]
public theorem completedTensorProduct_isNoetherianRing
    {B A C : Type*} [CommRing B] [CommRing A] [CommRing C]
    [Algebra B A] [Algebra B C]
    [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [TopologicalSpace C] [IsTopologicalRing C] [IsLinearTopology C C]
    (hBA : Continuous (algebraMap B A)) (hBC : Continuous (algebraMap B C))
    [IsNoetherianRing A] [IsNoetherianRing C]
    (hA : TopologicalRing.IsPreAdic A) (hC : TopologicalRing.IsPreAdic C)
    (hFinite : ∃ h : topologicalNilradical B ≤
        (topologicalNilradical A).comap (algebraMap B A),
      (Ideal.quotientMap (topologicalNilradical A) (algebraMap B A) h).FiniteType) :
    IsNoetherianRing (CompletedTensorProduct (R := B) (M := A) (N := C)) := by
  classical
  let NA : Ideal A := topologicalNilradical A
  let NC : Ideal C := topologicalNilradical C
  obtain ⟨hNAdef, hNAfg, hNAadic⟩ :=
    topologicalNilradical_isIdealOfDefinition_of_noetherian hA
  obtain ⟨hNCdef, hNCfg, hNCadic⟩ :=
    topologicalNilradical_isIdealOfDefinition_of_noetherian hC
  let T := A ⊗[B] C
  let : TopologicalSpace T := TopologicalRing.tensorProductTopology (R := B) (M := A) (N := C)
  let : IsTopologicalRing T := inferInstance
  let : IsLinearTopology T T := inferInstance
  let : UniformSpace T := TopologicalRing.tensorProductUniformSpace (R := B) (M := A) (N := C)
  let : IsUniformAddGroup T := inferInstance
  let S := CompletedTensorProduct (R := B) (M := A) (N := C)
  have hCompleteS : @CompleteSpace S (IsTopologicalAddGroup.rightUniformSpace S) := by
    let uS : UniformSpace S := inferInstance
    have hUniform : IsTopologicalAddGroup.rightUniformSpace S = uS := by
      let : UniformSpace S := uS
      let : IsUniformAddGroup S := inferInstance
      exact IsUniformAddGroup.rightUniformSpace_eq
    rw [hUniform]
    exact UniformSpace.Completion.completeSpace T
  let : @CompleteSpace S (IsTopologicalAddGroup.rightUniformSpace S) := hCompleteS
  let φ : T →+* S := UniformSpace.Completion.coeRingHom
  have hφ : Continuous (φ : T → S) := UniformSpace.Completion.continuous_coe T
  let fA : A →+* T :=
    (Algebra.TensorProduct.includeLeft : A →ₐ[B] T).toRingHom
  let fC : C →+* T :=
    (Algebra.TensorProduct.includeRight : C →ₐ[B] T).toRingHom
  let L : Ideal T := NA.map fA ⊔ NC.map fC
  have hLfg : L.FG := Submodule.FG.sup (hNAfg.map fA) (hNCfg.map fC)
  have hLadic : _root_.IsAdic L :=
    tensorProduct_adic_of_adic_factors NA NC hNAadic hNCadic hNAfg hNCfg
  have hTaut : RingHom.IsTaut φ := completion_coe_isTaut
  obtain ⟨LI, hLIadic, hLImapAdic⟩ :=
    RingHom.isAdic_of_isTaut φ hφ hTaut ⟨L, hLfg, hLadic⟩
  have hJadic : _root_.IsAdic (L.map φ) :=
    isAdic_map_of_isAdic_of_isAdic φ LI L hLIadic hLadic hLImapAdic
  let J : Ideal S := L.map φ
  have hJfg : J.FG := hLfg.map φ
  have hJcomplete : IsAdicComplete J S :=
    (hJadic.isAdicComplete_iff).mpr ⟨inferInstance, inferInstance⟩

  obtain ⟨hNB_A, hFiniteBA⟩ := hFinite
  let qB : B →+* B ⧸ topologicalNilradical B :=
    Ideal.Quotient.mk (topologicalNilradical B)
  let gBA := Ideal.quotientMap NA (algebraMap B A) hNB_A
  have hqBFinite : qB.FiniteType :=
    RingHom.FiniteType.of_surjective qB Ideal.Quotient.mk_surjective
  have hBAfactor : (algebraMap B (A ⧸ NA)) = gBA.comp qB := by
    ext b
    simp [gBA, qB, Ideal.quotientMap]
  have hBAfinite : (algebraMap B (A ⧸ NA)).FiniteType := by
    rw [hBAfactor]
    exact hFiniteBA.comp hqBFinite
  have hNAone : NA ^ 1 = NA := Submodule.pow_one NA
  have hBAfinitePower : (algebraMap B (A ⧸ NA ^ 1)).FiniteType := by
    let eA := Ideal.quotientEquivAlgOfEq B hNAone.symm
    have hfactor : (algebraMap B (A ⧸ NA ^ 1)) =
        eA.toRingHom.comp (algebraMap B (A ⧸ NA)) := by
      ext b
      exact (eA.commutes b).symm
    rw [hfactor]
    exact (RingHom.FiniteType.of_surjective eA.toRingHom eA.surjective).comp hBAfinite
  let D := (A ⧸ NA ^ 1) ⊗[B] (C ⧸ NC ^ 1)
  let D' := (C ⧸ NC ^ 1) ⊗[B] (A ⧸ NA ^ 1)
  let P : S →+* D := by
    exact TopologicalRing.projectionRingHom
      (B := B) (fun n : ℕ => NA ^ n) (fun n : ℕ => NC ^ n)
      hNAadic.hasBasis_nhds_zero hNCadic.hasBasis_nhds_zero 1 1
  have hPsurj : Function.Surjective P :=
    TopologicalRing.projectionRingHom_surjective
      (B := B) (fun n : ℕ => NA ^ n) (fun n : ℕ => NC ^ n)
      hNAadic.hasBasis_nhds_zero hNCadic.hasBasis_nhds_zero 1 1
  have hPker : RingHom.ker P = J := by
    have hclosure := TopologicalRing.projectionKernel_eq_closure
      (B := B) (fun n : ℕ => NA ^ n) (fun n : ℕ => NC ^ n)
      hNAadic.hasBasis_nhds_zero hNCadic.hasBasis_nhds_zero 1 1
    have hJclosed : IsClosed (J : Set S) := by
      have hJadic' : _root_.IsAdic J := by simpa [J] using hJadic
      have hJopen : IsOpen (J : Set S) := by
        simpa only [Submodule.pow_one] using (isAdic_iff.mp hJadic' |>.1 1)
      exact J.toAddSubgroup.isClosed_of_isOpen
        (by simpa only [Submodule.coe_toAddSubgroup] using hJopen)
    have hJsum : J = NA.map (φ.comp fA) ⊔ NC.map (φ.comp fC) := by
      simp [J, L, fA, fC, Ideal.map_sup, Ideal.map_map]
    have hclosureSet : (RingHom.ker P : Set S) =
        (Ideal.closure (NA.map (φ.comp fA) ⊔ NC.map (φ.comp fC)) : Set S) := by
      rw [pow_one, pow_one, Ideal.add_eq_sup] at hclosure
      exact hclosure
    have hkerClosure : RingHom.ker P =
        Ideal.closure (NA.map (φ.comp fA) ⊔ NC.map (φ.comp fC)) :=
      SetLike.coe_injective hclosureSet
    rw [hkerClosure, ← hJsum]
    exact Ideal.closure_eq_of_isClosed J hJclosed

  let : Algebra.FiniteType B (A ⧸ NA ^ 1) :=
    (RingHom.finiteType_algebraMap.mp hBAfinitePower)
  let : Algebra (C ⧸ NC ^ 1) D' := Algebra.TensorProduct.leftAlgebra
  let : Algebra.FiniteType (C ⧸ NC ^ 1) D' := inferInstance
  let : IsNoetherianRing (C ⧸ NC ^ 1) := inferInstance
  let : IsNoetherianRing D' :=
    Algebra.FiniteType.isNoetherianRing (C ⧸ NC ^ 1) D'
  have hDnoeth : IsNoetherianRing D :=
    isNoetherianRing_of_ringEquiv D'
      ((Algebra.TensorProduct.comm B (A ⧸ NA ^ 1) (C ⧸ NC ^ 1)).symm).toRingEquiv
  have hSquot : IsNoetherianRing (S ⧸ J) := by
    rw [← hPker]
    exact isNoetherianRing_of_ringEquiv D
      (TopologicalRing.projectionKernelQuotientRingEquiv
        (B := B) (fun n : ℕ => NA ^ n) (fun n : ℕ => NC ^ n)
        hNAadic.hasBasis_nhds_zero hNCadic.hasBasis_nhds_zero 1 1).symm
  exact noetherian_of_isAdicComplete_fg S J hJfg hJcomplete hSquot

end

