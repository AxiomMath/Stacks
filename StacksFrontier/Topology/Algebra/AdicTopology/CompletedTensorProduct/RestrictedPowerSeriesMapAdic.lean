module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Algebra.AdicTopology.AdicRingMap
public import StacksFrontier.Topology.Algebra.AdicTopology.CompletedTensorProduct.RestrictedPowerSeriesMap
public import StacksFrontier.Topology.Algebra.AdicTopology.FiniteType

/-!
# The induced map on restricted power series rings is adic of topological finite type

Let `A → B` be a homomorphism of commutative rings, let `I` be a finitely generated ideal of
`A` and let `J = I · B` be its extension.  The induced map `A{σ} → B{σ}` on restricted power
series carries the extended coefficient ideal `I · A{σ}` onto `J · B{σ}`, so it is adic for the
inverse limit topologies.  If moreover the topology of `B` is the `J`-adic one and `B` is
topologically of finite type over `A`, say with dense image from `n` variables, then `B{σ}` is
topologically of finite type over `A{σ}` on the same `n` variables: at every level the subring
generated by the image of `A{σ}` and those `n` elements is all of `(B ⧸ J ^ n)[σ]`.

## Main results

* `TopologicalRing.map_coefficientIdeal_restrictedPowerSeriesMap`: the induced map carries
  `I · A{σ}` onto `J · B{σ}`.
* `TopologicalRing.isAdic_restrictedPowerSeriesMap`: the induced map is adic.
* `TopologicalRing.isTopologicallyOfFiniteType_restrictedPowerSeriesMap`: the induced map is
  topologically of finite type when `A → B` is.

## References

* [Stacks Project, Tag 0ANS](https://stacks.math.columbia.edu/tag/0ANS)
* [Stacks Project, Tag 0AJM](https://stacks.math.columbia.edu/tag/0AJM)
-/

@[expose] public section

namespace TopologicalRing

section Dense

universe u v

variable {R : Type u} [CommRing R]

/-- A family of restricted power series is dense as soon as it is surjective onto every
coefficient quotient, the powers of the extended coefficient ideal being a basis of
neighbourhoods of zero. -/
private theorem denseRange_of_coefficientProjection_surjective {X : Type*} (J : Ideal R)
    (hJ : J.FG) (σ : Type v) (f : X → _root_.RestrictedPowerSeries J σ)
    (h : ∀ (n : ℕ) (y : MvPolynomial σ (R ⧸ J ^ n)), ∃ x : X,
      _root_.RestrictedPowerSeries.coefficientProjection J σ n (f x) = y) :
    DenseRange f := by
  rw [DenseRange, dense_iff_inter_open]
  rintro U hU ⟨y, hy⟩
  obtain ⟨n, -, hn⟩ :=
    ((_root_.RestrictedPowerSeries.isAdic_coefficientIdeal J hJ σ).hasBasis_nhds y).mem_iff.mp
      (hU.mem_nhds hy)
  obtain ⟨x, hx⟩ := h n (_root_.RestrictedPowerSeries.coefficientProjection J σ n y)
  have hmem : f x - y ∈ (_root_.RestrictedPowerSeries.coefficientIdeal J σ) ^ n := by
    rw [_root_.RestrictedPowerSeries.mem_coefficientIdeal_pow_iff J hJ σ n, map_sub, hx,
      sub_self]
  exact ⟨f x, hn ⟨f x - y, hmem, by ring⟩, Set.mem_range_self x⟩

end Dense

section

universe u v

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- The induced map on restricted power series rings carries the extended coefficient ideal of
`A{σ}` onto the extended coefficient ideal of `B{σ}`. -/
public theorem map_coefficientIdeal_restrictedPowerSeriesMap (I : Ideal A) (σ : Type v) :
    (_root_.RestrictedPowerSeries.coefficientIdeal I σ).map
        (restrictedPowerSeriesMap (B := B) I σ) =
      _root_.RestrictedPowerSeries.coefficientIdeal (I.map (algebraMap A B)) σ := by
  have hcomp : (restrictedPowerSeriesMap (B := B) I σ).comp
        (_root_.RestrictedPowerSeries.coefficientRingHom I σ) =
      (_root_.RestrictedPowerSeries.coefficientRingHom (I.map (algebraMap A B)) σ).comp
        (algebraMap A B) :=
    RingHom.ext fun a => restrictedPowerSeriesMap_coefficientRingHom I σ a
  rw [show _root_.RestrictedPowerSeries.coefficientIdeal I σ =
      I.map (_root_.RestrictedPowerSeries.coefficientRingHom I σ) from rfl, Ideal.map_map, hcomp,
    ← Ideal.map_map]

/-- **The induced map `A{σ} → B{σ}` is adic.**  The extension of the coefficient ideal
`I · A{σ}`, which defines the inverse limit topology of `A{σ}`, is the coefficient ideal
`(I · B) · B{σ}` of the target. -/
public theorem isAdic_restrictedPowerSeriesMap (I : Ideal A) (hI : I.FG) (σ : Type v) :
    _root_.RingHom.IsAdic (restrictedPowerSeriesMap (B := B) I σ) :=
  ⟨_root_.RestrictedPowerSeries.coefficientIdeal I σ,
    _root_.RestrictedPowerSeries.isAdic_coefficientIdeal I hI σ, by
      rw [map_coefficientIdeal_restrictedPowerSeriesMap]
      exact _root_.RestrictedPowerSeries.isAdic_coefficientIdeal _ (hI.map _) σ⟩

variable [TopologicalSpace B]

/-- A ring homomorphism with dense image into a ring carrying the adic topology of an ideal is
surjective modulo every power of that ideal. -/
private theorem surjective_quotient_mk_comp_of_denseRange {C : Type u} [CommRing C]
    (J : Ideal B) (hJ : _root_.IsAdic J) (g : C →+* B) (hg : DenseRange g) (m : ℕ) :
    Function.Surjective ((Ideal.Quotient.mk (J ^ m)).comp g) := by
  intro b
  obtain ⟨b₀, hb₀⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨z, ⟨j, hj, hjz⟩, p, hp⟩ :=
    mem_closure_iff_nhds.mp (hg b₀) _ ((hJ.hasBasis_nhds b₀).mem_of_mem (i := m) trivial)
  have hgp : g p = b₀ + j := by rw [hp, ← hjz]
  refine ⟨p, ?_⟩
  rw [← hb₀]
  show Ideal.Quotient.mk (J ^ m) (g p) = Ideal.Quotient.mk (J ^ m) b₀
  rw [hgp, map_add, (Ideal.Quotient.eq_zero_iff_mem).mpr hj, add_zero]

/-- **The induced map `A{σ} → B{σ}` is topologically of finite type.**  If `B` carries the adic
topology of the extension of a finitely generated ideal `I` of `A` and is topologically of
finite type over `A`, then `B{σ}` is topologically of finite type over `A{σ}` on the same
variables. -/
public theorem isTopologicallyOfFiniteType_restrictedPowerSeriesMap (I : Ideal A) (hI : I.FG)
    (σ : Type v) (hJ : _root_.IsAdic (I.map (algebraMap A B)))
    (hft : TopologicalRing.IsTopologicallyOfFiniteType (algebraMap A B)) :
    TopologicalRing.IsTopologicallyOfFiniteType (restrictedPowerSeriesMap (B := B) I σ) := by
  classical
  obtain ⟨n, g, hgC, hgd⟩ := hft
  have hJfg : (I.map (algebraMap A B)).FG := hI.map _
  obtain ⟨h, hhC, hhX⟩ : ∃ h : MvPolynomial (Fin n) (_root_.RestrictedPowerSeries I σ) →+*
      _root_.RestrictedPowerSeries (I.map (algebraMap A B)) σ,
      (∀ x, h (MvPolynomial.C x) = restrictedPowerSeriesMap (B := B) I σ x) ∧
        ∀ i, h (MvPolynomial.X i) = _root_.RestrictedPowerSeries.coefficientRingHom
          (I.map (algebraMap A B)) σ (g (MvPolynomial.X i)) :=
    ⟨MvPolynomial.eval₂Hom _ _, fun x => MvPolynomial.eval₂Hom_C _ _ x,
      fun i => MvPolynomial.eval₂Hom_X' _ _ i⟩
  refine ⟨n, h, RingHom.ext hhC, ?_⟩
  have hhmap : ∀ p : MvPolynomial (Fin n) A,
      h (MvPolynomial.map (_root_.RestrictedPowerSeries.coefficientRingHom I σ) p) =
        _root_.RestrictedPowerSeries.coefficientRingHom (I.map (algebraMap A B)) σ (g p) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.map_C, hhC, restrictedPowerSeriesMap_coefficientRingHom,
        show g (MvPolynomial.C a) = algebraMap A B a from DFunLike.congr_fun hgC a]
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p i hp => simp only [map_mul, MvPolynomial.map_X, hp, hhX]
  refine denseRange_of_coefficientProjection_surjective _ hJfg σ _ fun m q => ?_
  have hconst : ∀ b : B ⧸ (I.map (algebraMap A B)) ^ m,
      ∃ p, _root_.RestrictedPowerSeries.coefficientProjection (I.map (algebraMap A B)) σ m
        (h p) = MvPolynomial.C b := by
    intro b
    obtain ⟨p, hp⟩ := surjective_quotient_mk_comp_of_denseRange _ hJ g hgd m b
    refine ⟨MvPolynomial.map (_root_.RestrictedPowerSeries.coefficientRingHom I σ) p, ?_⟩
    rw [hhmap]
    show _root_.RestrictedPowerSeries.coefficientProjection (I.map (algebraMap A B)) σ m
      (algebraMap B (_root_.RestrictedPowerSeries (I.map (algebraMap A B)) σ) (g p)) = _
    rw [_root_.RestrictedPowerSeries.coefficientProjection_algebraMap]
    exact congrArg MvPolynomial.C hp
  have hvar : ∀ i : σ,
      ∃ p, _root_.RestrictedPowerSeries.coefficientProjection (I.map (algebraMap A B)) σ m
        (h p) = MvPolynomial.X i := by
    intro i
    refine ⟨MvPolynomial.C
      (_root_.RestrictedPowerSeries.polynomialRingHom I σ (MvPolynomial.X i)), ?_⟩
    rw [hhC, restrictedPowerSeriesMap_polynomialRingHom,
      _root_.RestrictedPowerSeries.coefficientProjection_polynomialRingHom, MvPolynomial.map_X,
      MvPolynomial.map_X]
  induction q using MvPolynomial.induction_on with
  | C b => exact hconst b
  | add q₁ q₂ hq₁ hq₂ =>
    obtain ⟨p₁, hp₁⟩ := hq₁
    obtain ⟨p₂, hp₂⟩ := hq₂
    exact ⟨p₁ + p₂, by rw [map_add, map_add, hp₁, hp₂]⟩
  | mul_X q i hq =>
    obtain ⟨p, hp⟩ := hq
    obtain ⟨t, ht⟩ := hvar i
    exact ⟨p * t, by rw [map_mul, map_mul, hp, ht]⟩

end

end TopologicalRing

end
