module

public import StacksFrontier.Topology.Algebra.AdicTopology.CompletedTensorProduct.Adic
public import StacksFrontier.Topology.Algebra.AdicTopology.CompletionOver

/-!
# The weak quotient stages of a completed tensor product

Let `A` and `B` be weakly admissible linearly topologized algebras over a topological ring `C`.
This file describes the weak ideals of definition of the completed tensor product
`T = A ⊗̂_C B` through the quotients it has: for a weak ideal of definition `I ⊆ A` and a weak
ideal of definition `J ⊆ B` there is a surjection

`T ⟶ A ⧸ I ⊗_C B ⧸ J`

whose kernel is a weak ideal of definition of `T`, these kernels are cofinal among the open
ideals of `T`, and the surjections are compatible with shrinking `I` and `J`. So the quotients
of `T` by weak ideals of definition are, cofinally, exactly the rings `A ⧸ I ⊗_C B ⧸ J`.

This is the ring-theoretic content of clause (3) of **Stacks 0AN3**: the fibre product
`Spf A ×_{Spf C} Spf B` is the colimit of the spectra of these quotients, and `Spf (A ⊗̂_C B)`
is the colimit of the spectra of the quotients of `T` by all its weak ideals of definition.

## Main definitions

* `TopologicalRing.stageProjection`: the surjection `T ⟶ A ⧸ I ⊗_C B ⧸ J`.
* `TopologicalRing.stageIdeal`: its kernel.
* `TopologicalRing.stageQuotientEquiv`: the induced isomorphism
  `T ⧸ stageIdeal I J ≃+* A ⧸ I ⊗_C B ⧸ J`.

## Main results

* `TopologicalRing.isWeakIdealOfDefinition_stageIdeal`: a stage ideal is a weak ideal of
  definition of `T`.
* `TopologicalRing.exists_stageIdeal_le`: the stage ideals are cofinal among the open ideals
  of `T`, hence among its weak ideals of definition.
* `TopologicalRing.stageProjection_naturality`: the projections are compatible with shrinking
  the two ideals.
* `TopologicalRing.stageProjection_coe_left` and
  `TopologicalRing.stageProjection_coe_right`: the projection takes the canonical image of
  `a ∈ A` to `a ⊗ₜ 1` and the canonical image of `b ∈ B` to `1 ⊗ₜ b`.

## Implementation notes

Everything is read off the inverse-limit presentation
`TopologicalRing.exists_completedTensorProductRingEquivQuotientLimit` of
`StacksFrontier.Topology.Algebra.AdicTopology.CompletedTensorProduct.QuotientLimit`, instantiated
at the system of *all* weak ideals of definition of `A` and of `B`. That those form a
fundamental system of neighbourhoods of zero is
`TopologicalRing.hasBasis_nhds_zero_isWeakIdealOfDefinition`, restated here with the
subtype of weak ideals of definition as the index type, which is the shape the inverse-limit
presentation takes.

Openness of a stage ideal and cofinality of the stage ideals are
`TopologicalRing.isOpen_projectionKernel` and `TopologicalRing.hasBasis_projectionKernel`. That
a stage ideal consists of topologically nilpotent elements is
`TopologicalRing.projectionKernel_eq_closure` together with
`TopologicalRing.closure_map_le_topologicalNilradical`: the stage ideal is the closure of the
ideal generated by the images of `I` and `J`, both of which consist of topologically nilpotent
elements, and the topological nilradical is a closed ideal.

Naturality and surjectivity do not need a continuity argument: the projections are literally
the components of the inverse-limit equivalence, so compatibility is the defining condition on
a member of the inverse limit, and surjectivity holds already on the dense image of
`A ⊗_C B`.

## References

* [Stacks Project, Tag 0AN3](https://stacks.math.columbia.edu/tag/0AN3)
* [Stacks Project, Tag 0AMU](https://stacks.math.columbia.edu/tag/0AMU)
* [Stacks Project, Tag 0AMV](https://stacks.math.columbia.edu/tag/0AMV)
* [Stacks Project, Tag 0AMW](https://stacks.math.columbia.edu/tag/0AMW)
* [Stacks Project, Tag 0GB4](https://stacks.math.columbia.edu/tag/0GB4)
-/

@[expose] public noncomputable section

namespace TopologicalRing

open Filter
open scoped TensorProduct Topology

section

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsLinearTopology A A]

/-- The weak ideals of definition of a weakly admissible linearly topologized ring form a
fundamental system of neighbourhoods of zero, indexed by their own subtype. -/
public theorem hasBasis_nhds_zero_weakIdealOfDefinitionIndex
    (hA : TopologicalRing.IsWeaklyAdmissible A) :
    (nhds (0 : A)).HasBasis (fun _ : TopologicalRing.WeakIdealOfDefinitionIndex A => True)
      (fun i => (i.1 : Set A)) :=
  (TopologicalRing.hasBasis_nhds_zero_isWeakIdealOfDefinition hA).to_hasBasis
    (fun I hI => ⟨⟨I, hI⟩, trivial, subset_rfl⟩) (fun i _ => ⟨i.1, i.2, subset_rfl⟩)

end

section

variable {A B : Type*}
  [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
variable (C : Type*) [CommRing C] [Algebra C A] [Algebra C B]
variable (hA : TopologicalRing.IsWeaklyAdmissible A) (hB : TopologicalRing.IsWeaklyAdmissible B)

/-- The projection of the completed tensor product `A ⊗̂_C B` onto the quotient tensor product
`A ⧸ I ⊗_C B ⧸ J` attached to a pair of weak ideals of definition. -/
public def stageProjection (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B) →+*
      (A ⧸ i.1) ⊗[C] (B ⧸ j.1) :=
  TopologicalRing.projectionRingHom (B := C) (A := A) (C := B)
    (fun i : TopologicalRing.WeakIdealOfDefinitionIndex A => i.1)
    (fun j : TopologicalRing.WeakIdealOfDefinitionIndex B => j.1)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hA)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hB) i j

/-- The kernel of a stage projection. -/
public def stageIdeal (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    Ideal (TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)) :=
  RingHom.ker (stageProjection C hA hB i j)

/-- A stage ideal is one of the projection kernels of the inverse-limit presentation. -/
public theorem stageIdeal_eq_projectionKernel
    (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    stageIdeal C hA hB i j =
      TopologicalRing.projectionKernel (B := C) (A := A) (C := B)
        (fun i : TopologicalRing.WeakIdealOfDefinitionIndex A => i.1)
        (fun j : TopologicalRing.WeakIdealOfDefinitionIndex B => j.1)
        (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hA)
        (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hB) i j := rfl

/-- The stage projection on the image of `A ⊗_C B` is the evident map of tensor products. -/
public theorem stageProjection_coe (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) (z : A ⊗[C] B) :
    stageProjection C hA hB i j
        (z : TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)) =
      Algebra.TensorProduct.map (Ideal.Quotient.mkₐ C i.1) (Ideal.Quotient.mkₐ C j.1) z :=
  (Classical.choose_spec (TopologicalRing.exists_completedTensorProductRingEquivQuotientLimit
    (B := C) (A := A) (C := B)
    (fun i : TopologicalRing.WeakIdealOfDefinitionIndex A => i.1)
    (fun j : TopologicalRing.WeakIdealOfDefinitionIndex B => j.1)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hA)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hB))).2.2 z i j

/-- The stage projection takes the canonical image of `a ∈ A` to `a ⊗ₜ 1`. -/
public theorem stageProjection_coe_left (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) (a : A) :
    stageProjection C hA hB i j
        (((a ⊗ₜ[C] (1 : B) : A ⊗[C] B) :
          TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B))) =
      Ideal.Quotient.mk i.1 a ⊗ₜ[C] (1 : B ⧸ j.1) := by
  rw [stageProjection_coe]
  simp

/-- The stage projection takes the canonical image of `b ∈ B` to `1 ⊗ₜ b`. -/
public theorem stageProjection_coe_right (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) (b : B) :
    stageProjection C hA hB i j
        ((((1 : A) ⊗ₜ[C] b : A ⊗[C] B) :
          TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B))) =
      (1 : A ⧸ i.1) ⊗ₜ[C] Ideal.Quotient.mk j.1 b := by
  rw [stageProjection_coe]
  simp

/-- The stage projection is surjective: it is already surjective on the image of `A ⊗_C B`. -/
public theorem stageProjection_surjective (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    Function.Surjective (stageProjection C hA hB i j) := by
  intro y
  obtain ⟨z, hz⟩ := Algebra.TensorProduct.map_surjective (R := C) (S := C)
    (f := Ideal.Quotient.mkₐ C i.1) (g := Ideal.Quotient.mkₐ C j.1)
    (Ideal.Quotient.mkₐ_surjective C i.1) (Ideal.Quotient.mkₐ_surjective C j.1) y
  exact ⟨(z : TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)),
    (stageProjection_coe C hA hB i j z).trans hz⟩

/-- The induced isomorphism from the quotient of `A ⊗̂_C B` by a stage ideal. -/
public def stageQuotientEquiv (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    (TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B) ⧸
        stageIdeal C hA hB i j) ≃+* (A ⧸ i.1) ⊗[C] (B ⧸ j.1) :=
  RingHom.quotientKerEquivOfSurjective (stageProjection_surjective C hA hB i j)

/-- Shrinking the two ideals refines the stage projection along the evident map of quotient
tensor products. -/
public theorem stageProjection_naturality
    {i i' : TopologicalRing.WeakIdealOfDefinitionIndex A}
    {j j' : TopologicalRing.WeakIdealOfDefinitionIndex B}
    (hi : (i.1 : Ideal A) ≤ i'.1) (hj : (j.1 : Ideal B) ≤ j'.1)
    (z : TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)) :
    Algebra.TensorProduct.map (R := C) (S := C)
          (Ideal.Quotient.factorₐ C hi) (Ideal.Quotient.factorₐ C hj)
        (stageProjection C hA hB i j z) =
      stageProjection C hA hB i' j' z :=
  (TopologicalRing.completedTensorProductRingEquivQuotientLimit (B := C) (A := A) (C := B)
    (fun i : TopologicalRing.WeakIdealOfDefinitionIndex A => i.1)
    (fun j : TopologicalRing.WeakIdealOfDefinitionIndex B => j.1)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hA)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hB) z).2 (i, j) (i', j') hi hj

/-- Shrinking the two ideals shrinks the stage ideal. -/
public theorem stageIdeal_mono {i i' : TopologicalRing.WeakIdealOfDefinitionIndex A}
    {j j' : TopologicalRing.WeakIdealOfDefinitionIndex B}
    (hi : (i.1 : Ideal A) ≤ i'.1) (hj : (j.1 : Ideal B) ≤ j'.1) :
    stageIdeal C hA hB i j ≤ stageIdeal C hA hB i' j' := by
  intro z hz
  have h : stageProjection C hA hB i j z = 0 := hz
  have hn := stageProjection_naturality C hA hB hi hj z
  rw [h, map_zero] at hn
  exact hn.symm

/-- A stage ideal is open. -/
public theorem isOpen_stageIdeal (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    IsOpen (SetLike.coe (stageIdeal C hA hB i j) :
      Set (TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B))) :=
  TopologicalRing.isOpen_projectionKernel (B := C) (A := A) (C := B) _ _ _ _ i j

/-- The extension of a weak ideal of definition along a continuous ring homomorphism consists of
topologically nilpotent elements. -/
private theorem map_weakIdeal_le_topologicalNilradical {R S : Type*}
    [CommRing R] [TopologicalSpace R] [IsLinearTopology R R]
    [CommRing S] [TopologicalSpace S] [IsTopologicalRing S] [IsLinearTopology S S]
    (φ : R →+* S) (hφ : Continuous φ) (I : TopologicalRing.WeakIdealOfDefinitionIndex R) :
    (I.1.map φ : Ideal S) ≤ topologicalNilradical S := fun _ hz =>
  TopologicalRing.closure_map_le_topologicalNilradical φ hφ I.1
    (fun x hx => IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mpr (I.2.2 x hx))
    (subset_closure hz)

/-- A stage ideal consists of topologically nilpotent elements: it is the closure of the ideal
generated by the images of the two weak ideals of definition, and the topological nilradical is
a closed ideal containing both. -/
public theorem stageIdeal_le_topologicalNilradical
    (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    stageIdeal C hA hB i j ≤
      topologicalNilradical
        (TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)) := by
  classical
  let := TopologicalRing.tensorProductTopology (R := C) (M := A) (N := B)
  let := TopologicalRing.tensorProductUniformSpace (R := C) (M := A) (N := B)
  set T := TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B) with hT
  let φA : A →+* T :=
    (UniformSpace.Completion.coeRingHom : (A ⊗[C] B) →+* T).comp
      (Algebra.TensorProduct.includeLeft : A →ₐ[C] A ⊗[C] B).toRingHom
  let φB : B →+* T :=
    (UniformSpace.Completion.coeRingHom : (A ⊗[C] B) →+* T).comp
      (Algebra.TensorProduct.includeRight : B →ₐ[C] A ⊗[C] B).toRingHom
  have hφA : Continuous φA := by
    change Continuous (fun a : A => ((a ⊗ₜ[C] (1 : B) : A ⊗[C] B) : T))
    exact (UniformSpace.Completion.continuous_coe (A ⊗[C] B)).comp
      (TopologicalRing.continuous_tmul_const (R := C) (M := A) (N := B) (1 : B))
  have hφB : Continuous φB := by
    change Continuous (fun b : B => (((1 : A) ⊗ₜ[C] b : A ⊗[C] B) : T))
    exact (UniformSpace.Completion.continuous_coe (A ⊗[C] B)).comp
      (TopologicalRing.continuous_const_tmul (R := C) (M := A) (N := B) (1 : A))
  intro x hx
  change x ∈ (SetLike.coe (stageIdeal C hA hB i j) : Set T) at hx
  rw [stageIdeal_eq_projectionKernel, TopologicalRing.projectionKernel_eq_closure] at hx
  change x ∈ closure ((i.1.map φA + j.1.map φB : Ideal T) : Set T) at hx
  exact closure_minimal
    (show (i.1.map φA + j.1.map φB : Ideal T) ≤ topologicalNilradical T from
      sup_le (map_weakIdeal_le_topologicalNilradical φA hφA i)
        (map_weakIdeal_le_topologicalNilradical φB hφB j))
    (TopologicalRing.isClosed_topologicalNilradical (B := T)) hx

/-- A stage ideal is a weak ideal of definition of the completed tensor product. -/
public theorem isWeakIdealOfDefinition_stageIdeal
    (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
    (j : TopologicalRing.WeakIdealOfDefinitionIndex B) :
    TopologicalRing.IsWeakIdealOfDefinition (stageIdeal C hA hB i j) :=
  ⟨isOpen_stageIdeal C hA hB i j, fun _ hx =>
    IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mp
      (stageIdeal_le_topologicalNilradical C hA hB i j hx)⟩

/-- The stage ideals are cofinal among the open ideals of `A ⊗̂_C B`. -/
public theorem exists_stageIdeal_le
    (L : Ideal (TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)))
    (hL : IsOpen (SetLike.coe L :
      Set (TopologicalRing.CompletedTensorProduct (R := C) (M := A) (N := B)))) :
    ∃ (i : TopologicalRing.WeakIdealOfDefinitionIndex A)
      (j : TopologicalRing.WeakIdealOfDefinitionIndex B), stageIdeal C hA hB i j ≤ L := by
  obtain ⟨p, -, hp⟩ := (TopologicalRing.hasBasis_projectionKernel (B := C) (A := A) (C := B)
    (fun i : TopologicalRing.WeakIdealOfDefinitionIndex A => i.1)
    (fun j : TopologicalRing.WeakIdealOfDefinitionIndex B => j.1)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hA)
    (hasBasis_nhds_zero_weakIdealOfDefinitionIndex hB)).mem_iff.mp (hL.mem_nhds L.zero_mem)
  exact ⟨p.1, p.2, hp⟩

end

end TopologicalRing

end
