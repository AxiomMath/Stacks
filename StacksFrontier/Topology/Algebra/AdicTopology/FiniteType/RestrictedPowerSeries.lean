/-!
# Algebras topologically of finite type

A topological `A`-algebra `B` is *topologically of finite type* when it is a quotient of a ring
of restricted power series over `A`.  This file defines the notion, the ring of restricted power
series, and three of the four standard characterisations: a restricted-power-series
presentation, finite type modulo every weak ideal of definition, and finite type modulo a
cofinal family.  Their equivalence is proved in
`StacksFrontier.Topology.Algebra.AdicTopology.FiniteType.Equivalences`.

## References

* [Stacks Project, Tag 0ANS](https://stacks.math.columbia.edu/tag/0ANS)
* [Stacks Project, Tag 0ANU](https://stacks.math.columbia.edu/tag/0ANU)
-/

@[expose] public section

namespace TopologicalRing

section

/-- A ring homomorphism `φ : A →+* B` is *topologically of finite type* if there is an
`A`-algebra map from a polynomial algebra in finitely many variables to `B` with dense image. -/
@[stacks 0ANS]
public abbrev IsTopologicallyOfFiniteType {A B : Type*} [CommRing A] [CommRing B]
    [TopologicalSpace B] (φ : A →+* B) : Prop :=
  ∃ n : ℕ, ∃ f : MvPolynomial (Fin n) A →+* B,
    f.comp MvPolynomial.C = φ ∧ DenseRange f

/-- For a specified `A`-algebra structure on `B`, being topologically of finite type is equivalent
to the existence of an `A`-algebra homomorphism from a polynomial algebra in finitely many
variables with dense image. -/
public theorem isTopologicallyOfFiniteType_iff_exists_algHom
    {A B : Type*} [CommRing A] [CommRing B] [TopologicalSpace B] [Algebra A B] :
    IsTopologicallyOfFiniteType (algebraMap A B) ↔
      ∃ n : ℕ, ∃ f : MvPolynomial (Fin n) A →ₐ[A] B, DenseRange f :=
  ⟨fun ⟨n, f, h, d⟩ => ⟨n, { f with commutes' := fun a => DFunLike.congr_fun h a }, d⟩, fun
    ⟨n, f, d⟩ => ⟨n, f.toRingHom, by ext a; exact f.commutes a, d⟩⟩

end

section

open Filter


universe u v w

section RestrictedPowerSeries

variable (B : Type u) [CommRing B] [TopologicalSpace B] (σ : Type v)

theorem restrictedPolynomialRingSubgroupsBasis :
    RingSubgroupsBasis
      (fun I : { I : Ideal B // IsOpen (I : Set B) } ↦
        (I.1.map (MvPolynomial.C : B →+* MvPolynomial σ B)).toAddSubgroup) := by
  apply RingSubgroupsBasis.of_comm
  · intro I J
    refine ⟨⟨I.1 ⊓ J.1, I.2.inter J.2⟩, ?_⟩
    exact le_inf (Ideal.map_mono inf_le_left) (Ideal.map_mono inf_le_right)
  · intro I
    refine ⟨I, ?_⟩
    rintro _ ⟨x, hx, y, hy, rfl⟩
    exact Ideal.mul_mem_left
      (I := I.1.map (MvPolynomial.C : B →+* MvPolynomial σ B)) x hy
  · intro x I
    refine ⟨I, ?_⟩
    intro y hy
    exact (I.1.map (MvPolynomial.C : B →+* MvPolynomial σ B)).mul_mem_left x hy

/-- The ring filter basis on `B[σ]` consisting of ideals extended from open ideals of `B`. -/
@[instance_reducible]
public noncomputable def restrictedPolynomialRingFilterBasis :
    RingFilterBasis (MvPolynomial σ B) :=
  let h : RingSubgroupsBasis
      (fun I : { I : Ideal B // IsOpen (I : Set B) } ↦
        (I.1.map (MvPolynomial.C : B →+* MvPolynomial σ B)).toAddSubgroup) := by
    apply RingSubgroupsBasis.of_comm
    · intro I J
      refine ⟨⟨I.1 ⊓ J.1, I.2.inter J.2⟩, ?_⟩
      exact le_inf (Ideal.map_mono inf_le_left) (Ideal.map_mono inf_le_right)
    · intro I
      refine ⟨I, ?_⟩
      rintro _ ⟨x, hx, y, hy, rfl⟩
      exact Ideal.mul_mem_left
        (I := I.1.map (MvPolynomial.C : B →+* MvPolynomial σ B)) x hy
    · intro x I
      refine ⟨I, ?_⟩
      intro y hy
      exact (I.1.map (MvPolynomial.C : B →+* MvPolynomial σ B)).mul_mem_left x hy
  letI : Nonempty { I : Ideal B // IsOpen (I : Set B) } := ⟨⟨⊤, isOpen_univ⟩⟩
  h.toRingFilterBasis

/-- The linear topology on `B[σ]` generated by extensions of open ideals of `B`. -/
@[instance_reducible]
public noncomputable def restrictedPolynomialTopology :
    TopologicalSpace (MvPolynomial σ B) :=
  (restrictedPolynomialRingFilterBasis B σ).topology

/-- The polynomial topology makes the polynomial ring a topological ring. -/
public noncomputable instance restrictedPolynomialIsTopologicalRing :
    @IsTopologicalRing (MvPolynomial σ B) (restrictedPolynomialTopology B σ) _ :=
  (restrictedPolynomialRingFilterBasis B σ).isTopologicalRing

/-- The additive uniformity associated to the polynomial topology. -/
@[instance_reducible]
public noncomputable def restrictedPolynomialUniformSpace :
    UniformSpace (MvPolynomial σ B) :=
  letI : TopologicalSpace (MvPolynomial σ B) := restrictedPolynomialTopology B σ
  letI : IsTopologicalRing (MvPolynomial σ B) :=
    restrictedPolynomialIsTopologicalRing B σ
  IsTopologicalAddGroup.rightUniformSpace (MvPolynomial σ B)

/-- Restricted power series over a linearly topologized coefficient ring. -/
@[ega "0 7.5.1"]
public noncomputable def RestrictedPowerSeries : Type (max u v) :=
  @UniformSpace.Completion (MvPolynomial σ B) (restrictedPolynomialUniformSpace B σ)

/-- Restricted power series form a commutative ring, as the completion of the polynomial ring. -/
public noncomputable instance restrictedPowerSeriesCommRing :
    CommRing (RestrictedPowerSeries B σ) := by
  change CommRing (@UniformSpace.Completion (MvPolynomial σ B)
    (restrictedPolynomialUniformSpace B σ))
  exact @UniformSpace.Completion.commRing (MvPolynomial σ B) _
    (restrictedPolynomialUniformSpace B σ)
    (restrictedPolynomialRingFilterBasis B σ).toAddGroupFilterBasis.isUniformAddGroup
    (restrictedPolynomialRingFilterBasis B σ).isTopologicalRing

/-- The completion uniformity on restricted power series. -/
public noncomputable instance restrictedPowerSeriesUniformSpace :
    UniformSpace (RestrictedPowerSeries B σ) := by
  letI : UniformSpace (MvPolynomial σ B) := restrictedPolynomialUniformSpace B σ
  change UniformSpace (UniformSpace.Completion (MvPolynomial σ B))
  infer_instance

/-- Restricted power series are complete for their completion topology. -/
public noncomputable instance restrictedPowerSeriesCompleteSpace :
    CompleteSpace (RestrictedPowerSeries B σ) := by
  let : UniformSpace (MvPolynomial σ B) := restrictedPolynomialUniformSpace B σ
  change CompleteSpace (UniformSpace.Completion (MvPolynomial σ B))
  infer_instance

/-- Restricted power series carry a separated topology. -/
public noncomputable instance restrictedPowerSeriesT2Space :
    T2Space (RestrictedPowerSeries B σ) := by
  let : UniformSpace (MvPolynomial σ B) := restrictedPolynomialUniformSpace B σ
  change T2Space (UniformSpace.Completion (MvPolynomial σ B))
  infer_instance

/-- Restricted power series form a topological ring. -/
public noncomputable instance restrictedPowerSeriesIsTopologicalRing :
    IsTopologicalRing (RestrictedPowerSeries B σ) := by
  let : UniformSpace (MvPolynomial σ B) := restrictedPolynomialUniformSpace B σ
  let : IsUniformAddGroup (MvPolynomial σ B) :=
    (restrictedPolynomialRingFilterBasis B σ).toAddGroupFilterBasis.isUniformAddGroup
  let : IsTopologicalRing (MvPolynomial σ B) :=
    (restrictedPolynomialRingFilterBasis B σ).isTopologicalRing
  change IsTopologicalRing (UniformSpace.Completion (MvPolynomial σ B))
  infer_instance

/-- The canonical map from polynomials to restricted power series. -/
public noncomputable def polynomialToRestrictedPowerSeries :
    MvPolynomial σ B →+* RestrictedPowerSeries B σ := by
  exact @UniformSpace.Completion.coeRingHom (MvPolynomial σ B) _
    (restrictedPolynomialUniformSpace B σ)
    (restrictedPolynomialRingFilterBasis B σ).isTopologicalRing
    (restrictedPolynomialRingFilterBasis B σ).toAddGroupFilterBasis.isUniformAddGroup

/-- The canonical coefficient map into restricted power series. -/
public noncomputable def coeffToRestrictedPowerSeries : B →+* RestrictedPowerSeries B σ :=
  (polynomialToRestrictedPowerSeries B σ).comp MvPolynomial.C

end RestrictedPowerSeries

theorem restrictedPowerSeries_nhds_hasBasis
    (B : Type u) [CommRing B] [TopologicalSpace B] (σ : Type v) :
    let P := MvPolynomial σ B
    let R := RestrictedPowerSeries B σ
    letI : UniformSpace P := restrictedPolynomialUniformSpace B σ
    letI : TopologicalSpace P := restrictedPolynomialTopology B σ
    let p : P →+* R := polynomialToRestrictedPowerSeries B σ
    (nhds (0 : R)).HasBasis
      (Function.const { J : Ideal B // IsOpen (J : Set B) } True)
      (fun J => closure ((p : P → R) '' (J.1.map (MvPolynomial.C : B →+* P) : Set P))) := by
  dsimp
  let : UniformSpace (MvPolynomial σ B) := restrictedPolynomialUniformSpace B σ
  let : TopologicalSpace (MvPolynomial σ B) := restrictedPolynomialTopology B σ
  let : Nonempty { J : Ideal B // IsOpen (J : Set B) } := ⟨⟨⊤, isOpen_univ⟩⟩
  exact (restrictedPolynomialRingSubgroupsBasis B σ).hasBasis_nhds_zero.hasBasis_of_isDenseInducing
    UniformSpace.Completion.isDenseInducing_coe

theorem idealClosure_map_eq_closure_image_of_denseRange
    {P R : Type*} [CommRing P] [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    (f : P →+* R) (hf : DenseRange f) (I : Ideal P) :
    (Ideal.closure (Ideal.map f I) : Set R) = closure (f '' (I : Set P)) := by
  let H : AddSubgroup R := AddSubgroup.topologicalClosure (AddSubgroup.map f I.toAddSubgroup)
  have hHclosed : IsClosed (H : Set R) := isClosed_closure
  have hgen (r : R) {x : P} (hx : x ∈ I) : r * f x ∈ H := by
    have hrange : Set.range (fun y : R => y * f x) ⊆ (H : Set R) := by
      calc
        Set.range (fun y : R => y * f x) ⊆ closure ((fun y : R => y * f x) '' Set.range f) :=
          (continuous_mul_const (f x)).range_subset_closure_image_dense hf
        _ ⊆ closure (f '' (I : Set P)) := by
          apply closure_mono
          rintro z ⟨y, hy, rfl⟩
          rcases hy with ⟨w, rfl⟩
          exact ⟨w * x, I.mul_mem_left w hx, by simp [map_mul]⟩
        _ = (H : Set R) := rfl
    exact hrange ⟨r, rfl⟩
  let V : Ideal R :=
    { carrier := closure (f '' (I : Set P))
      zero_mem' := H.zero_mem
      add_mem' := H.add_mem
      smul_mem' := by
        intro r x hx
        change x ∈ closure (f '' (I : Set P)) at hx
        have hmap : Set.MapsTo (fun y : R => r * y) (f '' (I : Set P))
            (closure (f '' (I : Set P))) := by
          rintro y ⟨z, hz, rfl⟩
          exact hgen r hz
        change r * x ∈ closure (f '' (I : Set P))
        simpa only [closure_closure] using
          (map_mem_closure (continuous_const_mul r) hx hmap) }
  have hmap : Ideal.map f I ≤ V :=
    Ideal.map_le_iff_le_comap.mpr fun x hx => subset_closure ⟨x, hx, rfl⟩
  have hsubset₁ : closure (f '' (I : Set P)) ⊆ closure (Ideal.map f I : Set R) := by
    apply closure_mono
    rintro y ⟨x, hx, rfl⟩
    exact Ideal.mem_map_of_mem f hx
  exact (closure_minimal hmap hHclosed).antisymm hsubset₁

variable {B : Type u} {A : Type v}
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
  [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]

/-- Condition (a): tautness and finite type after quotienting by every weak ideal of
definition of the source and the closure of its extension in the target. -/
public abbrev FiniteTypeModuloEveryWeakIdeal (φ : B →+* A) : Prop :=
  RingHom.IsTaut φ ∧
    ∀ J : Ideal B, TopologicalRing.IsWeakIdealOfDefinition J →
      (Ideal.quotientMap (I := J) (Ideal.closure (J.map φ)) φ
        (Ideal.map_le_iff_le_comap.mp subset_closure)).FiniteType

/-- Condition (b): tautness and finite type after quotienting along a countable cofinal family
of weak ideals of definition. -/
public abbrev FiniteTypeModuloCofinalWeakIdeals (φ : B →+* A) : Prop :=
  RingHom.IsTaut φ ∧
    ∃ J : ℕ → Ideal B,
      (∀ m, TopologicalRing.IsWeakIdealOfDefinition (J m)) ∧
      (∀ K : Ideal B, TopologicalRing.IsWeakIdealOfDefinition K → ∃ m, J m ≤ K) ∧
      ∀ m, (Ideal.quotientMap (I := J m) (Ideal.closure ((J m).map φ)) φ
        (Ideal.map_le_iff_le_comap.mp subset_closure)).FiniteType

/-- Condition (d): the target has a topological algebra presentation as a quotient of a
restricted power series ring by a closed ideal. -/
@[ega "I 10.13.1" "(c)"]
public abbrev HasRestrictedPowerSeriesPresentation (φ : B →+* A) : Prop :=
  ∃ n : ℕ, ∃ K : Ideal (RestrictedPowerSeries B (Fin n)),
    IsClosed (K : Set (RestrictedPowerSeries B (Fin n))) ∧
      ∃ e : (RestrictedPowerSeries B (Fin n) ⧸ K) ≃+* A,
        Continuous e ∧ Continuous e.symm ∧
            e.toRingHom.comp
              ((Ideal.Quotient.mk K).comp (coeffToRestrictedPowerSeries B (Fin n))) = φ

end

end TopologicalRing

