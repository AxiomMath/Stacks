/-!
# Limits of spectral spaces: the generalizations of a constructible subset

Let `X` be a spectral space and `E ⊆ X` a constructible subset, and write `W = specGen E` for
the set of points of `X` that specialize to a point of `E`. Then `W \ E`, with the subspace
topology, is a spectral space, and it is the inverse limit of the cofiltered diagram of
subspaces `U i \ E`, where `(U i)` is a nonempty downward directed family of quasi-compact
open subsets of `X` with `W = ⋂ i, U i`.

## Main definitions

* `specGen`: the set of points specializing to a point of a given subset.
* `diffDiagram`: the diagram `i ↦ U i \ E` with the subspace inclusions as transition maps.
* `diffLimitCone`: the cone over `diffDiagram` with apex `specGen E \ E`.
* `iInterCone`: the cone over `diffDiagram` with apex `⋂ i, U i \ E`.

## Main results

* `isSpectral_specGen_diff_constructible`: `specGen E \ E` is a spectral space.
* `isLimit_diffLimitCone`: `diffLimitCone` is a limit cone, so the canonical continuous map
  `specGen E \ E ⟶ lim_i (U i \ E)` is a homeomorphism.
* `specGen_diff_eq_iInter`: `specGen E \ E = ⋂ i, (U i \ E)`.
* `mem_specGen_iff`: `w ∈ specGen E` exactly when `closure {w}` meets `E`.
* `exists_directed_qcOpen_iInter_specGen`: `specGen E` is the intersection of a nonempty
  downward directed family of quasi-compact open subsets.
* `IsConstructible.isClosed_constructibleTopology`: a constructible subset of a spectral
  space is closed in the constructible topology.
* `spectralSpace_of_isConstructible`: a constructible subset is a spectral space for the
  subspace topology. Spectrality of an arbitrary constructibly closed subset is Stacks 0902,
  `spectralSpace_of_isClosed_constructibleTopology`, which this specializes.
* `isLimit_iInterCone`, `spectralSpace_of_isLimit_diffDiagram`: `iInterCone` is a limit cone,
  and the apex of any limit cone over `diffDiagram` is a spectral space.
-/

@[expose] public section

open Topology CategoryTheory CategoryTheory.Limits

variable {X : Type*} [TopologicalSpace X]

/-- The set of points of `X` that specialize to some point of `E`, that is, the
generalizations of the points of `E`. -/
@[ega "I 2.4.2" "more general"]
def specGen (E : Set X) : Set X := {w : X | ∃ e ∈ E, w ⤳ e}

/-- A point `w` lies in `specGen E` exactly when the closure of `{w}` meets `E`. -/
@[ega "IV 21.13.15"]
theorem mem_specGen_iff (E : Set X) (w : X) :
    w ∈ specGen E ↔ (closure ({w} : Set X) ∩ E).Nonempty := by
  simp only [specGen, Set.mem_ofPred_eq, Set.inter_nonempty]
  exact ⟨fun ⟨e, he, hwe⟩ => ⟨e, hwe.mem_closure, he⟩,
    fun ⟨e, hclo, he⟩ => ⟨e, he, specializes_iff_mem_closure.2 hclo⟩⟩

/-- `specGen E` is stable under generalization: a generalization of a point that specializes
into `E` again specializes into `E`. -/
theorem stableUnderGeneralization_specGen (E : Set X) :
    StableUnderGeneralization (specGen E) :=
  fun _ _ hxy ⟨e, he, hye⟩ => ⟨e, he, hxy.trans hye⟩

/-- Every point of `E` specializes to itself, so `E ⊆ specGen E`. -/
theorem subset_specGen (E : Set X) : E ⊆ specGen E := fun e he => ⟨e, he, specializes_rfl⟩

/-- The generalizations of a quasi-compact set form a quasi-compact set: an open cover of
`specGen E` covers `E`, and the union of a finite subcover of `E` is open, hence stable under
generalization, hence contains all of `specGen E`. -/
theorem IsCompact.specGen {E : Set X} (hE : IsCompact E) : IsCompact (specGen E) := by
  rw [isCompact_iff_finite_subcover]
  intro ι O hOopen hcover
  obtain ⟨t, ht⟩ := hE.elim_finite_subcover O hOopen ((subset_specGen E).trans hcover)
  exact ⟨t, fun w ⟨e, he, hwe⟩ =>
    (isOpen_biUnion fun i _ => hOopen i).stableUnderGeneralization hwe (ht he)⟩

/-- In any topological space, every member of the Boolean subalgebra generated by a family of
clopen subsets is clopen. -/
private theorem isClopen_of_mem_boolean_closure {Y : Type*} [TopologicalSpace Y]
    (G : Set (Set Y)) (hG : ∀ U ∈ G, IsClopen U) :
    ∀ s ∈ BooleanSubalgebra.closure G, IsClopen s := by
  intro s hs
  induction hs using BooleanSubalgebra.closure_bot_sup_induction with
  | mem U hU => exact hG U hU
  | bot => exact isClopen_empty
  | sup x hx y hy hpx hpy => exact hpx.union hpy
  | compl x hx hpx => exact hpx.compl

/-- A constructible subset of a spectral space is closed in the constructible topology. -/
theorem IsConstructible.isClosed_constructibleTopology [SpectralSpace X]
    {S : Set X} (hS : Topology.IsConstructible S) :
    IsClosed[constructibleTopology X] S := by
  -- Each generator (open + retrocompact) is clopen in the constructible topology, and the
  -- clopens are closed under the finite Boolean operations.
  have hgen : ∀ U ∈ {U : Set X | IsOpen U ∧ IsRetrocompact U},
      @IsClopen X (constructibleTopology X) U := fun U ⟨hUopen, hUretro⟩ =>
    hUretro.isCompact.isClopen_constructibleTopology hUopen
  exact @IsClopen.isClosed X (constructibleTopology X) S
    (@isClopen_of_mem_boolean_closure X (constructibleTopology X) _ hgen S hS)

/-! ### Quasi-compact open neighbourhoods, and spectrality of constructible subsets -/

/-- In a spectral space `X`, the generalization set `specGen E` of a constructible subset `E`
is the intersection of a nonempty downward directed family of quasi-compact open subsets,
indexed by the quasi-compact open neighbourhoods of `specGen E` ordered by inclusion. -/
theorem exists_directed_qcOpen_iInter_specGen.{u} {X : Type u} [TopologicalSpace X]
    [SpectralSpace X] {E : Set X}
    (hE : Topology.IsConstructible E) :
    ∃ (I : Type u) (_ : Preorder I) (_ : Nonempty I) (_ : IsCodirectedOrder I)
      (U : I → Set X),
      (∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j) ∧ (∀ i, IsOpen (U i)) ∧
        (∀ i, IsCompact (U i)) ∧ specGen E = ⋂ i, U i := by
  classical
  -- `E` is constructibly closed, hence compact, and so is its set of generalizations.
  have hWcompact : IsCompact (specGen E) :=
    (IsConstructible.isClosed_constructibleTopology hE).isCompact_of_constructibleTopology.specGen
  -- Index by the quasi-compact open neighborhoods of `specGen E`, ordered by
  -- inclusion (so the order is codirected with lower bound `V ∩ W`).
  let I := {V : Set X // IsOpen V ∧ IsCompact V ∧ specGen E ⊆ V}
  refine ⟨I, Subtype.preorder _, ?_, ?_, fun i => i.1, ?_, ?_, ?_, ?_⟩
  · -- Nonempty: `Set.univ` is a quasi-compact open neighborhood (`X` is compact).
    exact ⟨⟨Set.univ, isOpen_univ, isCompact_univ, Set.subset_univ _⟩⟩
  · -- Codirected: lower bound `V ∩ W` is quasi-compact open (quasi-separatedness)
    -- and still contains `specGen E`.
    exact ⟨fun ⟨A, hAo, hAc, hAW⟩ ⟨B, hBo, hBc, hBW⟩ =>
      ⟨⟨A ∩ B, hAo.inter hBo,
        QuasiSeparatedSpace.inter_isCompact A B hAo hAc hBo hBc,
        Set.subset_inter hAW hBW⟩, Set.inter_subset_left, Set.inter_subset_right⟩⟩
  · -- Monotone (the order is inclusion).
    exact fun _ _ hij => hij
  · -- Open.
    exact fun ⟨_, hio, _, _⟩ => hio
  · -- Compact.
    exact fun ⟨_, _, hic, _⟩ => hic
  · -- `specGen E = ⋂ i, U i`. Every index contains `specGen E` by its defining property.
    -- Conversely, if `x ∉ specGen E` then `closure {x}` is disjoint from `specGen E`;
    -- separate the compact `specGen E` from the closed `closure {x}` by a quasi-compact
    -- open `V`, giving `x ∉ V`.
    refine Set.Subset.antisymm (Set.subset_iInter fun ⟨_, _, _, hiW⟩ => hiW) fun x hx => ?_
    by_contra hxnot
    have hsub : specGen E ⊆ (closure {x})ᶜ := fun y hyW hycl =>
      hxnot (stableUnderGeneralization_specGen E (specializes_iff_mem_closure.2 hycl) hyW)
    obtain ⟨V, hVc, hVo, hWV, hVcl⟩ :=
      PrespectralSpace.exists_isCompact_and_isOpen_between hWcompact
        isClosed_closure.isOpen_compl hsub
    exact hVcl (Set.mem_iInter.mp hx ⟨V, hVo, hVc, hWV⟩) (subset_closure (Set.mem_singleton x))

/-- A constructible subset of a spectral space is, with the subspace topology, a spectral
space. -/
@[sga "4 IV 9.1.11" "(i)⇒(ii), special case"]
theorem spectralSpace_of_isConstructible [SpectralSpace X] {S : Set X}
    (hS : Topology.IsConstructible S) : SpectralSpace ↥S :=
  spectralSpace_of_isClosed_constructibleTopology S
    (IsConstructible.isClosed_constructibleTopology hS)

/-! ### The diagram of the subspaces `U i \ E`

Throughout, `I` is a preorder and `U : I → Set X` a family of subsets. The diagram sends `i`
to the subspace `U i \ E`, with the subspace inclusions as transition maps. -/

variable {I : Type*} [Preorder I] (U : I → Set X) (E : Set X)

/-- The diagram `I ⥤ TopCat` of the subspaces `U i \ E` with the subspace inclusions as
transition maps, for a family `U` that is monotone for the order on `I`, so that `i ≤ j` gives
`U i \ E ⊆ U j \ E`. -/
noncomputable def diffDiagram (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j) :
    I ⥤ TopCat where
  obj i := TopCat.of ↥(U i \ E)
  map {i j} f := TopCat.ofHom ⟨Set.inclusion (fun _ ⟨hxU, hxE⟩ => ⟨hmono (leOfHom f) hxU, hxE⟩),
    continuous_inclusion _⟩
  map_id i := by apply TopCat.hom_ext; ext x; rfl
  map_comp f g := by apply TopCat.hom_ext; ext x; rfl

/-- The cone over `diffDiagram` with apex `specGen E \ E` whose projections are the subspace
inclusions `specGen E \ E ↪ U i \ E`, defined when `specGen E ⊆ U i` for every `i`. -/
noncomputable def diffLimitCone (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (hW : ∀ i, specGen E ⊆ U i) : Cone (diffDiagram U E hmono) where
  pt := TopCat.of ↥(specGen E \ E)
  π :=
  { app := fun i => TopCat.ofHom ⟨Set.inclusion (fun _ ⟨hxW, hxE⟩ => ⟨hW i hxW, hxE⟩),
      continuous_inclusion _⟩
    naturality := by intro i j f; apply TopCat.hom_ext; ext x; rfl }

/-- The cone over `diffDiagram` whose apex is the subspace `↥(⋂ i, U i \ E)` of `X`, with the
subspace inclusions `↥(⋂ i, U i \ E) ↪ ↥(U i \ E)` as projections. -/
noncomputable def iInterCone (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j) :
    Cone (diffDiagram U E hmono) where
  pt := TopCat.of ↥(⋂ i, U i \ E)
  π :=
  { app := fun i => TopCat.ofHom ⟨Set.inclusion (fun x hx => Set.mem_iInter.mp hx i),
      continuous_inclusion _⟩
    naturality := by intro i j f; apply TopCat.hom_ext; ext x; rfl }

/-- For a set `S` contained in every `U i \ E`, the subspace inclusions `↥S ↪ ↥(U i \ E)` form a
cone over `diffDiagram U E hmono` with apex `↥S`. Both `iInterCone` (with `S = ⋂ i, U i \ E`) and
`diffLimitCone` (with `S = specGen E \ E`) are of this shape. -/
@[implicit_reducible]
private noncomputable def inclusionCone (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    {S : Set X} (hS : ∀ i, S ⊆ U i \ E) : Cone (diffDiagram U E hmono) where
  pt := TopCat.of ↥S
  π :=
  { app := fun i => TopCat.ofHom ⟨Set.inclusion (hS i), continuous_inclusion _⟩
    naturality := by intro i j f; apply TopCat.hom_ext; ext x; rfl }

/-- The candidate mediating map from the apex of a cone `s` over `diffDiagram U E hmono` to the
subspace `↥S`, sending `p` to the underlying point `(s.π.app i₀ p : X)` of the projection at a
fixed index `i₀`. -/
private noncomputable def inclusionConeLift (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (s : Cone (diffDiagram U E hmono)) (i₀ : I) {S : Set X}
    (mem : ∀ p : s.pt, ((ConcreteCategory.hom (s.π.app i₀)) p).val ∈ S) :
    s.pt ⟶ TopCat.of ↥S :=
  TopCat.ofHom ⟨fun p => ⟨((ConcreteCategory.hom (s.π.app i₀)) p).val, mem p⟩,
    (continuous_subtype_val.comp (s.π.app i₀).hom.continuous).subtype_mk mem⟩

private lemma inclusionCone_π_app_apply_val (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    {S : Set X} (hS : ∀ i, S ⊆ U i \ E) (i : I) (x : (inclusionCone U E hmono hS).pt) :
    ((((inclusionCone U E hmono hS).π.app i).hom x).val : X) = x.val :=
  rfl

private lemma inclusionConeLift_apply_val (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (s : Cone (diffDiagram U E hmono)) (i₀ : I) {S : Set X}
    (mem : ∀ p : s.pt, ((ConcreteCategory.hom (s.π.app i₀)) p).val ∈ S) (p : s.pt) :
    ((inclusionConeLift U E hmono s i₀ mem).hom p).val =
      ((ConcreteCategory.hom (s.π.app i₀)) p).val :=
  rfl

/-- The `fac` field of the limit-cone structure on `inclusionCone U E hmono hS`: the projection
of `inclusionConeLift U E hmono s i₀ mem` at `j` is `s.π.app j`, because the `X`-coordinates of
`s.π.app i₀` and `s.π.app j` agree.

Shared by `isLimit_iInterCone` (`S = ⋂ i, U i \ E`) and `isLimit_diffLimitCone`
(`S = specGen E \ E`). -/
private lemma inclusionCone_fac (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (s : Cone (diffDiagram U E hmono)) (i₀ j : I)
    (compat : ∀ (i j : I) (p : s.pt),
      (((ConcreteCategory.hom (s.π.app i)) p).val : X)
        = (((ConcreteCategory.hom (s.π.app j)) p).val : X))
    {S : Set X} (hS : ∀ i, S ⊆ U i \ E)
    (mem : ∀ p : s.pt, ((ConcreteCategory.hom (s.π.app i₀)) p).val ∈ S) :
    inclusionConeLift U E hmono s i₀ mem ≫ (inclusionCone U E hmono hS).π.app j
      = s.π.app j := by
  apply TopCat.hom_ext
  ext p
  apply Subtype.ext
  rw [TopCat.hom_comp, ContinuousMap.comp_apply, inclusionCone_π_app_apply_val,
    inclusionConeLift_apply_val]
  exact compat i₀ j p

/-- The `uniq` field of the limit-cone structure on `inclusionCone U E hmono hS`: any mediating
map `m` for `s` is determined on `X`-coordinates by `s.π.app i₀`, hence equals
`inclusionConeLift U E hmono s i₀ mem`.

Shared by `isLimit_iInterCone` (`S = ⋂ i, U i \ E`) and `isLimit_diffLimitCone`
(`S = specGen E \ E`). -/
private lemma inclusionCone_uniq (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (s : Cone (diffDiagram U E hmono)) (i₀ : I)
    {S : Set X} (hS : ∀ i, S ⊆ U i \ E)
    (mem : ∀ p : s.pt, ((ConcreteCategory.hom (s.π.app i₀)) p).val ∈ S)
    (m : s.pt ⟶ (inclusionCone U E hmono hS).pt)
    (hm : ∀ i, m ≫ (inclusionCone U E hmono hS).π.app i = s.π.app i) :
    m = inclusionConeLift U E hmono s i₀ mem := by
  apply TopCat.hom_ext
  ext p
  apply Subtype.ext
  exact congrArg (fun (g : s.pt ⟶ (diffDiagram U E hmono).obj i₀) => (g.hom p).val) (hm i₀)

private lemma diffDiagram_cone_val_eq [IsCodirectedOrder I]
    (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j) (s : Cone (diffDiagram U E hmono))
    (i j : I) (p : s.pt) :
    (((ConcreteCategory.hom (s.π.app i)) p).val : X)
      = (((ConcreteCategory.hom (s.π.app j)) p).val : X) := by
  have key : ∀ {i j : I} (_ : i ⟶ j),
      (((ConcreteCategory.hom (s.π.app i)) p).val : X)
        = (((ConcreteCategory.hom (s.π.app j)) p).val : X) := by
    intro i j f
    exact congrArg (fun (g : s.pt ⟶ (diffDiagram U E hmono).obj j) =>
      ((ConcreteCategory.hom g) p).val) (s.w f)
  obtain ⟨k, hki, hkj⟩ := exists_le_le i j
  rw [← key (homOfLE hki), ← key (homOfLE hkj)]

/-- For a nonempty codirected index order, a set `S` contained in every `U i \ E` and containing
`⋂ i, U i \ E` makes `inclusionCone U E hmono hS` a limit cone. -/
private theorem isLimit_inclusionCone [Nonempty I] [IsCodirectedOrder I]
    (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j) {S : Set X} (hS : ∀ i, S ⊆ U i \ E)
    (hsub : ⋂ i, U i \ E ⊆ S) : Nonempty (IsLimit (inclusionCone U E hmono hS)) := by
  let i₀ : I := Classical.arbitrary I
  have mem : ∀ (s : Cone (diffDiagram U E hmono)) (p : s.pt),
      ((ConcreteCategory.hom (s.π.app i₀)) p).val ∈ S := fun s p =>
    hsub <| Set.mem_iInter.2 fun i =>
      diffDiagram_cone_val_eq U E hmono s i₀ i p ▸ ((ConcreteCategory.hom (s.π.app i)) p).property
  exact ⟨IsLimit.mk (fun s => inclusionConeLift U E hmono s i₀ (mem s))
    (fun s j =>
      inclusionCone_fac U E hmono s i₀ j (diffDiagram_cone_val_eq U E hmono s) hS (mem s))
    (fun s m hm => inclusionCone_uniq U E hmono s i₀ hS (mem s) m hm)⟩

/-- For a nonempty codirected index order and a monotone family `U`, the cone `iInterCone` is
a limit cone. -/
theorem isLimit_iInterCone [Nonempty I] [IsCodirectedOrder I]
    (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j) :
    Nonempty (IsLimit (iInterCone U E hmono)) :=
  isLimit_inclusionCone U E hmono (fun i => Set.iInter_subset (fun k => U k \ E) i) subset_rfl

/-- Let `X` be a spectral space, `E ⊆ X` constructible and `U` a monotone family of
quasi-compact open subsets indexed by a nonempty codirected order. Then the apex of any limit
cone over `diffDiagram U E` is a spectral space. -/
theorem spectralSpace_of_isLimit_diffDiagram [SpectralSpace X] [Nonempty I]
    [IsCodirectedOrder I] (hE : Topology.IsConstructible E)
    (hUopen : ∀ i, IsOpen (U i)) (hUcomp : ∀ i, IsCompact (U i))
    (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (c : Cone (diffDiagram U E hmono)) (hc : IsLimit c) :
    SpectralSpace c.pt := by
  -- Transport from the concrete limit cone `iInterCone` along the canonical iso.
  obtain ⟨hlim⟩ := isLimit_iInterCone U E hmono
  have hhomeo : c.pt ≃ₜ ↥(⋂ i, U i \ E) :=
    TopCat.homeoOfIso (hc.conePointUniqueUpToIso hlim)
  have hspecInter : SpectralSpace ↥(⋂ i, U i \ E) := by
    -- The core: `⋂ i, U i \ E` is closed in `constructibleTopology X`, hence
    -- spectral by `spectralSpace_of_isClosed_constructibleTopology` (Stacks 0902).
    rw [show (⋂ i, U i \ E) = (⋂ i, U i) ∩ Eᶜ by simp [Set.sdiff_eq, Set.iInter_inter]]
    exact spectralSpace_of_isClosed_constructibleTopology _
      (@IsClosed.inter X (⋂ i, U i) Eᶜ (constructibleTopology X)
        (@isClosed_iInter X I (constructibleTopology X) U fun i =>
          ((hUcomp i).isClopen_constructibleTopology (hUopen i)).1)
        (IsConstructible.isClosed_constructibleTopology hE.compl))
  have : CompactSpace c.pt := hhomeo.symm.compactSpace
  exact Topology.IsOpenEmbedding.spectralSpace (f := hhomeo) hhomeo.isOpenEmbedding

omit [Preorder I] in
/-- If `specGen E = ⋂ i, U i` for a nonempty index type `I`, then
`specGen E \ E = ⋂ i, (U i \ E)`. -/
theorem specGen_diff_eq_iInter [Nonempty I] (hWeq : specGen E = ⋂ i, U i) :
    (specGen E \ E) = ⋂ i, (U i \ E) := by
  simp [hWeq, Set.sdiff_eq, Set.iInter_inter]

/-- **Stacks 0AP0**.
For a spectral space `X`, a monotone family `U` indexed by a nonempty codirected order and
`specGen E = ⋂ i, U i`, the cone `diffLimitCone` with apex `specGen E \ E` is a limit cone of
the diagram `(U i \ E)_i`: the canonical map `specGen E \ E ⟶ lim_i (U i \ E)` is a
homeomorphism. -/
@[stacks 0AP0]
theorem isLimit_diffLimitCone [SpectralSpace X] [Nonempty I] [IsCodirectedOrder I]
    {E : Set X}
    (hmono : ∀ ⦃i j : I⦄, i ≤ j → U i ⊆ U j)
    (hWeq : specGen E = ⋂ i, U i) :
    Nonempty (IsLimit (diffLimitCone U E hmono (fun i => hWeq ▸ Set.iInter_subset U i))) :=
  isLimit_inclusionCone U E hmono
    (fun i => (specGen_diff_eq_iInter U E hWeq).subset.trans (Set.iInter_subset _ i))
    (specGen_diff_eq_iInter U E hWeq).superset

/-- **Stacks 0AP0**.
If `X` is a spectral space and `E ⊆ X` is a constructible subset, then the set
`specGen E \ E` of points specializing into `E` but not lying in `E`, equipped with the
subspace topology, is a spectral space. -/
@[stacks 0AP0]
theorem isSpectral_specGen_diff_constructible [SpectralSpace X] {E : Set X}
    (hE : Topology.IsConstructible E) : SpectralSpace ↥(specGen E \ E) := by
  -- Write `specGen E` as the intersection of a codirected family of quasi-compact opens `U i`.
  -- Each `U i \ E` is constructible, hence spectral, and `specGen E \ E` is the limit of the
  -- resulting diagram.
  obtain ⟨I, _, _, _, U, hmono, hUopen, hUcomp, hWeq⟩ :=
    exists_directed_qcOpen_iInter_specGen hE
  obtain ⟨hlim⟩ := isLimit_diffLimitCone U hmono hWeq
  exact spectralSpace_of_isLimit_diffDiagram U E hE hUopen hUcomp hmono _ hlim
