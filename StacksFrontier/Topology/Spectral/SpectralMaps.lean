/-!
# Spectral maps and the constructible topology

A spectral map `f : X → Y` between spectral spaces is continuous for the constructible topologies,
has quasi-compact fibres, and has closed image in the constructible topology on `Y`.

Everything is phrased through `WithConstructibleTopologyTypeSynonym X`, a copy of `X` carrying the
topology generated by the quasi-compact opens of `X` together with their complements. The two
inputs are that this topology is quasi-compact and Hausdorff. Quasi-compactness is proved directly
on subbasic covers: a subbasic family with no finite subcover has the finite intersection property,
so Zorn's lemma produces a maximal filter of quasi-compact opens avoiding the ideal generated by
the family; such a filter is prime, the closed set `zSet` attached to it is irreducible, and its
generic point is covered by no member of the family.

## Main definitions

* `WithConstructibleTopologyTypeSynonym`: `X` carrying the constructible topology.
* `idealOf`: the sets covered by a finite union of members of a given family.
* `goodFilter`: a filter of quasi-compact opens containing a family `B` and meeting `idealOf A`
  trivially.
* `extF`: the extension of a filter of quasi-compact opens by one further set.
* `zSet`: the closed set `⋂ {Uᶜ | U quasi-compact open, U ∉ F}` attached to a filter `F`.

## Main results

* `exists_prime_filter_isOpen_isCompact`: existence of a prime `goodFilter`, by Zorn's lemma.
* `exists_realizing_point_of_prime_filter_isOpen_isCompact`: a prime filter of quasi-compact opens
  is the set of quasi-compact opens containing some point.
* `compactSpace_withConstructibleTopology0A2S`: the constructible topology is quasi-compact.
* `t2Space_withConstructibleTopology0A2S`: the constructible topology is Hausdorff.
* `spectralMap_continuous_withConstructibleTopology`: a spectral map is continuous for the
  constructible topologies.
* `spectralMap_fibre_isCompact`: the fibres of a spectral map are quasi-compact.
* `spectralMap_range_isClosed_withConstructibleTopology`: the image of a spectral map is closed in
  the constructible topology.
-/

@[expose] public section

/-- Type synonym for `X` equipped with the *constructible topology*. -/
@[implicit_reducible]
def WithConstructibleTopologyTypeSynonym (X : Type*) : Type _ := X

namespace WithConstructibleTopologyTypeSynonym

/-- The canonical map `X → WithConstructibleTopologyTypeSynonym X`. -/
def of {X : Type*} (x : X) : WithConstructibleTopologyTypeSynonym X := x

/-- The canonical map `WithConstructibleTopologyTypeSynonym X → X`. -/
def out {X : Type*} (x : WithConstructibleTopologyTypeSynonym X) : X := x

/-- Preimage along `out` is the identity on sets. -/
lemma preimage_out {X : Type*} (s : Set X) :
    out ⁻¹' s = (s : Set (WithConstructibleTopologyTypeSynonym X)) :=
  rfl

end WithConstructibleTopologyTypeSynonym

/-- The constructible topology on `WithConstructibleTopologyTypeSynonym X`. -/
@[ega "IV 1.9.13"]
instance instTopologicalSpaceWithConstructibleTopology0A2S
    (X : Type*) [TopologicalSpace X] :
    TopologicalSpace (WithConstructibleTopologyTypeSynonym X) :=
  TopologicalSpace.generateFrom
    ({U : Set X | IsOpen U ∧ IsCompact U} ∪
      {V : Set X | ∃ U : Set X, IsOpen U ∧ IsCompact U ∧ V = Uᶜ})

/-- The constructible topology is by definition generated by the quasi-compact opens of `X`
together with their complements. -/
theorem withConstructibleTopology_eq_generateFrom
    (X : Type*) [TopologicalSpace X] :
    (instTopologicalSpaceWithConstructibleTopology0A2S X) =
      TopologicalSpace.generateFrom
        ({U : Set X | IsOpen U ∧ IsCompact U} ∪
          {V : Set X | ∃ U : Set X, IsOpen U ∧ IsCompact U ∧ V = Uᶜ}) :=
  rfl

/-! ## Subbasic opens of the constructible topology -/

/-- A quasi-compact open subset of `X` is open in the constructible topology. -/
lemma isOpen_constructible_of_isOpen_isCompact
    {X : Type*} [TopologicalSpace X] {U : Set X}
    (hU : IsOpen U) (hC : IsCompact U) :
    @IsOpen (WithConstructibleTopologyTypeSynonym X) _ U :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨hU, hC⟩)

/-- The complement of a quasi-compact open subset of `X` is open in the constructible topology. -/
lemma isOpen_constructible_compl_of_isOpen_isCompact
    {X : Type*} [TopologicalSpace X] {U : Set X}
    (hU : IsOpen U) (hC : IsCompact U) :
    @IsOpen (WithConstructibleTopologyTypeSynonym X) _ Uᶜ :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨U, hU, hC, rfl⟩)

/-- On a prespectral space the constructible topology refines the given one: the identity map
`WithConstructibleTopologyTypeSynonym X → X` is continuous. -/
@[ega "IV 1.9.14" "(i)"]
lemma continuous_out_of_prespectralSpace
    {X : Type*} [TopologicalSpace X] [PrespectralSpace X] :
    Continuous (WithConstructibleTopologyTypeSynonym.out : WithConstructibleTopologyTypeSynonym X →
        X) := by
  rw [PrespectralSpace.isTopologicalBasis.continuous_iff]
  rintro s ⟨hOpen, hCompact⟩
  rw [WithConstructibleTopologyTypeSynonym.preimage_out]
  exact isOpen_constructible_of_isOpen_isCompact hOpen hCompact

/-! ## Separation in spectral spaces -/

/-- In a T0 space, two distinct points can be separated by an open set. -/
@[ega "0 2.1.3" "partial"]
lemma exists_open_separating
    {X : Type*} [TopologicalSpace X] [T0Space X]
    {x y : X} (hxy : x ≠ y) :
    ∃ V : Set X, IsOpen V ∧ ((x ∈ V ∧ y ∉ V) ∨ (y ∈ V ∧ x ∉ V)) := by
  have hninsep : ¬ Inseparable x y := fun h => hxy (T0Space.t0 h)
  by_contra! hcontra
  refine hninsep (inseparable_iff_forall_isOpen.mpr fun U hU => ?_)
  by_cases hx : x ∈ U
  · by_cases hy : y ∈ U
    · simp_all
    · exact absurd (hcontra U hU) (by tauto)
  · by_cases hy : y ∈ U
    · exact absurd (hcontra U hU) (by tauto)
    · simp_all

/-- In a prespectral space every point of an open set has a quasi-compact open neighbourhood
contained in that set. -/
lemma exists_isCompact_isOpen_subset_of_mem
    {X : Type*} [TopologicalSpace X] [PrespectralSpace X]
    {V : Set X} (hV : IsOpen V) {a : X} (ha : a ∈ V) :
    ∃ U : Set X, IsOpen U ∧ IsCompact U ∧ a ∈ U ∧ U ⊆ V := by
  obtain ⟨U, ⟨hUo, hUc⟩, haU, hUV⟩ :=
    PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open ha hV
  exact ⟨U, hUo, hUc, haU, hUV⟩

/-- In a spectral space, two distinct points are separated by a quasi-compact open. -/
lemma exists_isCompact_isOpen_separating
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    {x y : X} (hxy : x ≠ y) :
    ∃ U : Set X, IsOpen U ∧ IsCompact U ∧
      ((x ∈ U ∧ y ∉ U) ∨ (y ∈ U ∧ x ∉ U)) := by
  obtain ⟨V, hVopen, hVsep⟩ := exists_open_separating hxy
  rcases hVsep with ⟨hxV, hyV⟩ | ⟨hyV, hxV⟩
  · obtain ⟨U, hUopen, hUcomp, hxU, hUV⟩ :=
      exists_isCompact_isOpen_subset_of_mem hVopen hxV
    exact ⟨U, hUopen, hUcomp, Or.inl ⟨hxU, fun hyU => hyV (hUV hyU)⟩⟩
  · obtain ⟨U, hUopen, hUcomp, hyU, hUV⟩ :=
      exists_isCompact_isOpen_subset_of_mem hVopen hyV
    exact ⟨U, hUopen, hUcomp, Or.inr ⟨hyU, fun hxU => hxV (hUV hxU)⟩⟩

/-! ## Ultrafilter construction by Zorn -/

/-- The order ideal generated by `A`: the sets contained in a finite union of members of `A`. -/
def idealOf {X : Type*} (A : Set (Set X)) : Set (Set X) :=
  { U | ∃ a ⊆ A, a.Finite ∧ U ⊆ ⋃₀ a }

/-- `G` is a *good filter* for `A` and `B` when it consists of quasi-compact opens, contains `B`
and `Set.univ`, is closed under intersections and under passage to larger quasi-compact opens, and
is disjoint from the ideal generated by `A`. -/
structure goodFilter {X : Type*} [TopologicalSpace X]
    (A B : Set (Set X)) (G : Set (Set X)) : Prop where
  /-- Every member of `G` is a quasi-compact open. -/
  isOpen_isCompact : ∀ U ∈ G, IsOpen U ∧ IsCompact U
  /-- `G` contains the family `B`. -/
  base_subset : B ⊆ G
  /-- `G` meets the ideal generated by `A` trivially. -/
  inter_idealOf_eq_empty : G ∩ idealOf A = ∅
  /-- `G` contains the whole space. -/
  univ_mem : (Set.univ : Set X) ∈ G
  /-- `G` is closed under intersections. -/
  inter_mem : ∀ U V, U ∈ G → V ∈ G → U ∩ V ∈ G
  /-- `G` is closed under passage to a larger quasi-compact open. -/
  mem_of_superset : ∀ U V, U ∈ G → U ⊆ V → IsOpen V → IsCompact V → V ∈ G

/-- If no finite intersection of members of `B` is covered by a finite union of members of `A`,
then the quasi-compact opens containing some finite intersection of members of `B` form a good
filter for `A` and `B`. -/
lemma exists_initial_goodFilter
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (A B : Set (Set X))
    (hB : B ⊆ {U : Set X | IsOpen U ∧ IsCompact U})
    (hFIP : ∀ a b : Set (Set X), a ⊆ A → b ⊆ B → a.Finite → b.Finite →
              (⋂₀ b \ ⋃₀ a).Nonempty) :
    ∃ G : Set (Set X), goodFilter A B G := by
  refine ⟨{ U | IsOpen U ∧ IsCompact U ∧ ∃ b ⊆ B, b.Finite ∧ ⋂₀ b ⊆ U }, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rintro U ⟨hUopen, hUcomp, _⟩
    exact ⟨hUopen, hUcomp⟩
  · intro U hU
    obtain ⟨hUo, hUc⟩ := hB hU
    refine ⟨hUo, hUc, {U}, ?_, Set.finite_singleton _, ?_⟩
    · rintro x rfl
      exact hU
    · simp [Set.sInter_singleton]
  · refine Set.eq_empty_iff_forall_notMem.mpr
      fun U ⟨⟨_, _, b, hbB, hb_fin, hb_sub⟩, a, haA, ha_fin, ha_sub⟩ => ?_
    obtain ⟨x, hxB, hxnA⟩ := hFIP a b haA hbB ha_fin hb_fin
    exact hxnA (ha_sub (hb_sub hxB))
  · exact ⟨isOpen_univ, CompactSpace.isCompact_univ, ∅, Set.empty_subset _,
      Set.finite_empty, by simp⟩
  · rintro U V ⟨hUopen, hUcomp, bU, hbU_B, hbU_fin, hbU_sub⟩
                ⟨hVopen, hVcomp, bV, hbV_B, hbV_fin, hbV_sub⟩
    refine ⟨hUopen.inter hVopen,
            hUcomp.inter_of_isOpen hVcomp hUopen hVopen,
            bU ∪ bV, Set.union_subset hbU_B hbV_B, hbU_fin.union hbV_fin, ?_⟩
    rw [Set.sInter_union]
    exact Set.inter_subset_inter hbU_sub hbV_sub
  · rintro U V ⟨_, _, b, hbB, hb_fin, hb_sub⟩ hUV hVopen hVcomp
    exact ⟨hVopen, hVcomp, b, hbB, hb_fin, hb_sub.trans hUV⟩

/-- The union of a nonempty chain of good filters for `A` and `B` is again a good filter for `A`
and `B`; this is the chain hypothesis of Zorn's lemma. -/
lemma chain_union_mem_goodFilter
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (A B : Set (Set X))
    (C : Set (Set (Set X)))
    (hC_sub : ∀ G ∈ C, goodFilter A B G)
    (hC_chain : IsChain (· ⊆ ·) C)
    (hC_nonempty : C.Nonempty) :
    goodFilter A B (⋃₀ C) := by
  obtain ⟨G₀, hG₀⟩ := hC_nonempty
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rintro U ⟨G, hGC, hUG⟩
    exact (hC_sub G hGC).isOpen_isCompact U hUG
  · intro V hV
    exact ⟨G₀, hG₀, (hC_sub G₀ hG₀).base_subset hV⟩
  · rw [Set.eq_empty_iff_forall_notMem]
    rintro U ⟨⟨G, hGC, hUG⟩, hUI⟩
    have hmem : U ∈ G ∩ idealOf A := ⟨hUG, hUI⟩
    rw [(hC_sub G hGC).inter_idealOf_eq_empty] at hmem
    exact hmem.elim
  · exact ⟨G₀, hG₀, (hC_sub G₀ hG₀).univ_mem⟩
  · rintro U V ⟨G₁, hG₁C, hUG₁⟩ ⟨G₂, hG₂C, hVG₂⟩
    by_cases hEq : G₁ = G₂
    · subst hEq
      exact ⟨G₁, hG₁C, (hC_sub G₁ hG₁C).inter_mem U V hUG₁ hVG₂⟩
    · rcases hC_chain hG₁C hG₂C hEq with h12 | h21
      · exact ⟨G₂, hG₂C, (hC_sub G₂ hG₂C).inter_mem U V (h12 hUG₁) hVG₂⟩
      · exact ⟨G₁, hG₁C, (hC_sub G₁ hG₁C).inter_mem U V hUG₁ (h21 hVG₂)⟩
  · rintro U V ⟨G, hGC, hUG⟩ hUV hVo hVc
    exact ⟨G, hGC, (hC_sub G hGC).mem_of_superset U V hUG hUV hVo hVc⟩

/-- The empty set never belongs to a good filter, since it lies in the ideal generated by `A`. -/
lemma empty_notMem_of_goodFilter
    {X : Type*} [TopologicalSpace X]
    (A B : Set (Set X)) (G : Set (Set X)) (hG : goodFilter A B G) :
    (∅ : Set X) ∉ G := fun h => by
  have h₂ : (∅ : Set X) ∈ G ∩ idealOf A :=
    ⟨h, ∅, by simp, Set.finite_empty, by simp⟩
  rw [hG.inter_idealOf_eq_empty] at h₂
  exact h₂.elim

/-- The extension of `F` by `U`: the quasi-compact opens containing `W₀ ∩ U` for some `W₀ ∈ F`. -/
def extF {X : Type*} [TopologicalSpace X] (F : Set (Set X)) (U : Set X) : Set (Set X) :=
  { W | ∃ W₀ ∈ F, W₀ ∩ U ⊆ W ∧ IsOpen W ∧ IsCompact W }

/-- A good filter `F` is contained in each of its extensions `extF F U`. -/
lemma subset_extF
    {X : Type*} [TopologicalSpace X]
    (A B F : Set (Set X)) (hF : goodFilter A B F) (U : Set X) :
    F ⊆ extF F U :=
  fun W hW => ⟨W, hW, Set.inter_subset_left, hF.isOpen_isCompact W hW⟩

/-- A quasi-compact open `U` belongs to the extension `extF F U`. -/
lemma mem_extF_self
    {X : Type*} [TopologicalSpace X]
    (A B F : Set (Set X)) (hF : goodFilter A B F)
    (U : Set X) (hUo : IsOpen U) (hUc : IsCompact U) :
    U ∈ extF F U :=
  ⟨Set.univ, hF.univ_mem, fun _ hx => hx.2, hUo, hUc⟩

/-- If the extension `extF F U` of a good filter still meets the ideal generated by `A` trivially,
then it is itself a good filter for `A` and `B`. -/
lemma extF_goodFilter_of_disjoint
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (A B F : Set (Set X))
    (hF : goodFilter A B F)
    (U : Set X) (h_disj : extF F U ∩ idealOf A = ∅) :
    goodFilter A B (extF F U) := by
  obtain ⟨hF_mem, hF_B, hF_disj, hF_univ, hF_inter, hF_up⟩ := hF
  refine ⟨?_, ?_, h_disj, ?_, ?_, ?_⟩
  · rintro W ⟨_, _, _, hWo, hWc⟩
    exact ⟨hWo, hWc⟩
  · exact fun V hV => ⟨V, hF_B hV, Set.inter_subset_left, hF_mem V (hF_B hV)⟩
  · exact ⟨Set.univ, hF_univ, Set.subset_univ _, isOpen_univ, (hF_mem Set.univ hF_univ).2⟩
  · rintro W₁ W₂ ⟨W₁₀, hW₁₀F, hW₁sub, hW₁o, hW₁c⟩ ⟨W₂₀, hW₂₀F, hW₂sub, hW₂o, hW₂c⟩
    refine ⟨W₁₀ ∩ W₂₀, hF_inter W₁₀ W₂₀ hW₁₀F hW₂₀F, ?_, hW₁o.inter hW₂o,
            hW₁c.inter_of_isOpen hW₂c hW₁o hW₂o⟩
    intro x ⟨⟨hx1, hx2⟩, hxU⟩
    exact ⟨hW₁sub ⟨hx1, hxU⟩, hW₂sub ⟨hx2, hxU⟩⟩
  · rintro W₁ W₂ ⟨W₁₀, hW₁₀F, hW₁sub, hW₁o, hW₁c⟩ hsub hW₂o hW₂c
    exact ⟨W₁₀, hW₁₀F, hW₁sub.trans hsub, hW₂o, hW₂c⟩

/-- A maximal good filter is prime: if the union of two quasi-compact opens lies in it, then so
does one of the two. Otherwise both extensions would meet the ideal generated by `A`, and
combining the two witnesses puts a member of the filter into that ideal. -/
lemma maximal_goodFilter_is_prime
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (A B : Set (Set X))
    (F : Set (Set X))
    (hF : goodFilter A B F)
    (hMax : ∀ G : Set (Set X), goodFilter A B G → F ⊆ G → G = F) :
    ∀ U V : Set X, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
      U ∪ V ∈ F → U ∈ F ∨ V ∈ F := by
  intro U V hUo hUc hVo hVc hUVin
  by_contra hcontr
  push Not at hcontr
  obtain ⟨hUF, hVF⟩ := hcontr
  have h_int : ∀ W : Set X, IsOpen W → IsCompact W → W ∉ F → (extF F W ∩ idealOf A).Nonempty :=
    fun W hWo hWc hWF => Set.nonempty_iff_ne_empty.mpr fun hempty => hWF <|
      hMax _ (extF_goodFilter_of_disjoint A B F hF W hempty)
        (subset_extF A B F hF W) ▸ mem_extF_self A B F hF W hWo hWc
  have h_int_U := h_int U hUo hUc hUF
  have h_int_V := h_int V hVo hVc hVF
  obtain ⟨W_U, ⟨W₀U, hW₀U_F, hW₀U_inter, _, _⟩, hW_U_id⟩ := h_int_U
  obtain ⟨W_V, ⟨W₀V, hW₀V_F, hW₀V_inter, _, _⟩, hW_V_id⟩ := h_int_V
  obtain ⟨_, _, hF_disj, _, hF_inter, _⟩ := hF
  have hW₁ : W₀U ∩ W₀V ∈ F := hF_inter _ _ hW₀U_F hW₀V_F
  have hW1UV : (W₀U ∩ W₀V) ∩ (U ∪ V) ∈ F := hF_inter _ _ hW₁ hUVin
  have hsub_to : (W₀U ∩ W₀V) ∩ (U ∪ V) ⊆ W_U ∪ W_V := by
    rintro x ⟨⟨hxU0, hxV0⟩, hxU | hxV⟩
    · exact Or.inl (hW₀U_inter ⟨hxU0, hxU⟩)
    · exact Or.inr (hW₀V_inter ⟨hxV0, hxV⟩)
  obtain ⟨aU, haUA, haUfin, hWU⟩ := hW_U_id
  obtain ⟨aV, haVA, haVfin, hWV⟩ := hW_V_id
  have hmem : (W₀U ∩ W₀V) ∩ (U ∪ V) ∈ F ∩ idealOf A :=
    ⟨hW1UV, aU ∪ aV, Set.union_subset haUA haVA, haUfin.union haVfin,
      hsub_to.trans <| by
        rw [Set.sUnion_union]
        exact Set.union_subset_union hWU hWV⟩
  rw [hF_disj] at hmem
  exact hmem.elim

/-- Suppose no finite intersection of members of `B` is covered by a finite union of members of
`A`. Then there is a prime filter `F` of quasi-compact opens containing `B`, disjoint from `A`,
containing `Set.univ` but not `∅`, closed under intersections and under passage to larger
quasi-compact opens. It is a maximal good filter, obtained from Zorn's lemma. -/
lemma exists_prime_filter_isOpen_isCompact
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (A B : Set (Set X))
    (hB : B ⊆ {U : Set X | IsOpen U ∧ IsCompact U})
    (hFIP : ∀ a b : Set (Set X), a ⊆ A → b ⊆ B → a.Finite → b.Finite →
              (⋂₀ b \ ⋃₀ a).Nonempty) :
    ∃ F : Set (Set X),
      (∀ U ∈ F, IsOpen U ∧ IsCompact U) ∧
      B ⊆ F ∧
      (∀ U ∈ A, U ∉ F) ∧
      (Set.univ : Set X) ∈ F ∧
      (∅ : Set X) ∉ F ∧
      (∀ U V, U ∈ F → V ∈ F → U ∩ V ∈ F) ∧
      (∀ U V, U ∈ F → U ⊆ V → IsOpen V → IsCompact V → V ∈ F) ∧
      (∀ U V, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
              U ∪ V ∈ F → U ∈ F ∨ V ∈ F) := by
  obtain ⟨G₀, hG₀⟩ := exists_initial_goodFilter A B hB hFIP
  have hZorn : ∃ m, G₀ ⊆ m ∧ Maximal (fun G => G ∈ {G : Set (Set X) | goodFilter A B G}) m :=
    zorn_subset_nonempty {G : Set (Set X) | goodFilter A B G}
      (fun C hCSub hCChain hCNonempty => ⟨⋃₀ C,
        chain_union_mem_goodFilter A B C (fun G hG => hCSub hG) hCChain hCNonempty,
        fun s hs U hU => ⟨s, hs, hU⟩⟩) G₀ hG₀
  obtain ⟨F, _, hFgood, hFle⟩ := hZorn
  have hFmem : goodFilter A B F := hFgood
  have hFmax : ∀ H : Set (Set X), goodFilter A B H → F ⊆ H → H = F :=
    fun H hH hFH => le_antisymm (hFle hH hFH) hFH
  refine ⟨F, hFmem.isOpen_isCompact, hFmem.base_subset, ?_, hFmem.univ_mem,
    empty_notMem_of_goodFilter A B F hFmem, hFmem.inter_mem, hFmem.mem_of_superset,
    maximal_goodFilter_is_prime A B F hFmem hFmax⟩
  intro U hU hUF
  have : U ∈ F ∩ idealOf A :=
    ⟨hUF, {U}, Set.singleton_subset_iff.mpr hU, Set.finite_singleton U, by simp⟩
  rw [hFmem.inter_idealOf_eq_empty] at this
  exact this

/-! ## Recovering a generic point from a prime filter -/

/-- The set `Z := ⋂ {Uᶜ | U is compact open, U ∉ F}`. -/
def zSet {X : Type*} [TopologicalSpace X] (F : Set (Set X)) : Set X :=
  ⋂₀ {V : Set X | ∃ U : Set X, IsOpen U ∧ IsCompact U ∧ U ∉ F ∧ V = Uᶜ}

/-- `zSet F` is closed, being an intersection of complements of open sets. -/
lemma zSet_isClosed {X : Type*} [TopologicalSpace X] (F : Set (Set X)) :
    IsClosed (zSet F) :=
  isClosed_sInter <| by
    rintro V ⟨U, hUo, _, _, rfl⟩
    exact hUo.isClosed_compl

/-- `zSet F` is disjoint from every quasi-compact open that does not belong to `F`. -/
lemma zSet_subset_compl_of_not_mem {X : Type*} [TopologicalSpace X]
    (F : Set (Set X)) {U : Set X}
    (hUo : IsOpen U) (hUc : IsCompact U) (hU : U ∉ F) :
    zSet F ⊆ Uᶜ :=
  fun _ hx => hx _ ⟨U, hUo, hUc, hU, rfl⟩

/-- A quasi-compact open containing a point of `zSet F` belongs to `F`. -/
private theorem mem_of_mem_zSet {X : Type*} [TopologicalSpace X] {F : Set (Set X)} {U : Set X}
    (hUo : IsOpen U) (hUc : IsCompact U) {x : X} (hxZ : x ∈ zSet F) (hxU : x ∈ U) : U ∈ F :=
  Classical.byContradiction fun h => zSet_subset_compl_of_not_mem F hUo hUc h hxZ hxU

/-- For a prime filter `F` not containing `∅`, a finite union of quasi-compact opens none of which
belongs to `F` again does not belong to `F`. -/
lemma finset_biUnion_notMem_of_notMem
    {X : Type*} [TopologicalSpace X]
    (F : Set (Set X))
    (hF_empty : (∅ : Set X) ∉ F)
    (hF_prime : ∀ U V, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
                U ∪ V ∈ F → U ∈ F ∨ V ∈ F)
    (s : Finset (Set X))
    (hs_open : ∀ W ∈ s, IsOpen W)
    (hs_compact : ∀ W ∈ s, IsCompact W)
    (hs_notMem : ∀ W ∈ s, W ∉ F) :
    (⋃ W ∈ s, W) ∉ F := by
  classical
  induction s using Finset.induction with
  | empty => simpa using hF_empty
  | insert a s _ ih =>
    have hs_open' : ∀ W ∈ s, IsOpen W := fun W hW => hs_open W (Finset.mem_insert_of_mem hW)
    have hs_compact' : ∀ W ∈ s, IsCompact W :=
      fun W hW => hs_compact W (Finset.mem_insert_of_mem hW)
    rw [show (⋃ W ∈ insert a s, W) = a ∪ (⋃ W ∈ s, W) by simp]
    intro hmem
    rcases hF_prime a _ (hs_open a (Finset.mem_insert_self a s))
        (hs_compact a (Finset.mem_insert_self a s)) (isOpen_biUnion hs_open')
        (s.finite_toSet.isCompact_biUnion hs_compact') hmem with h | h
    · exact hs_notMem a (Finset.mem_insert_self a s) h
    · exact ih hs_open' hs_compact'
        (fun W hW => hs_notMem W (Finset.mem_insert_of_mem hW)) h

/-- A set disjoint from `zSet F` is covered by the quasi-compact opens that do not belong
to `F`. -/
lemma cover_of_inter_zSet_empty
    {X : Type*} [TopologicalSpace X]
    (F : Set (Set X))
    {U : Set X} (hUcov : zSet F ∩ U = ∅) :
    U ⊆ ⋃ W ∈ {W : Set X | IsOpen W ∧ IsCompact W ∧ W ∉ F}, W := by
  intro x hxU
  have hxZ : x ∉ zSet F := fun hxZ => (hUcov ▸ Set.mem_inter hxZ hxU : x ∈ (∅ : Set X))
  simp only [zSet, Set.mem_sInter, not_forall] at hxZ
  obtain ⟨_, ⟨W, hWopen, hWcompact, hWnotF, rfl⟩, hxV⟩ := hxZ
  rw [Set.mem_compl_iff, not_not] at hxV
  exact Set.mem_iUnion₂.mpr ⟨W, ⟨hWopen, hWcompact, hWnotF⟩, hxV⟩

/-- A quasi-compact set belonging to a prime filter `F` meets `zSet F`: otherwise it would be
covered by finitely many quasi-compact opens outside `F`, whose union would then have to lie
in `F`. -/
lemma inter_zSet_nonempty_of_mem_compactOpen
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (F : Set (Set X))
    (hF_empty : (∅ : Set X) ∉ F)
    (hF_up : ∀ U V, U ∈ F → U ⊆ V → IsOpen V → IsCompact V → V ∈ F)
    (hF_prime : ∀ U V, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
                U ∪ V ∈ F → U ∈ F ∨ V ∈ F)
    {U : Set X} (hUc : IsCompact U) (hU : U ∈ F) :
    (zSet F ∩ U).Nonempty := by
  by_contra hc
  rw [Set.not_nonempty_iff_eq_empty] at hc
  obtain ⟨b', hb'sub, hb'fin, hb'cov⟩ :=
    hUc.elim_finite_subcover_image
      (b := {W : Set X | IsOpen W ∧ IsCompact W ∧ W ∉ F})
      (c := id) (fun W hW => hW.1) (cover_of_inter_zSet_empty F hc)
  set s : Finset (Set X) := hb'fin.toFinset
  have hmem_b' : ∀ {W}, W ∈ s → W ∈ b' := hb'fin.mem_toFinset.mp
  have hs_open : ∀ W ∈ s, IsOpen W := fun _ hW => (hb'sub (hmem_b' hW)).1
  have hs_compact : ∀ W ∈ s, IsCompact W := fun _ hW =>
    let ⟨_, hWc, _⟩ := hb'sub (hmem_b' hW)
    hWc
  have hs_notMem : ∀ W ∈ s, W ∉ F := fun _ hW =>
    let ⟨_, _, hWF⟩ := hb'sub (hmem_b' hW)
    hWF
  have hUsub : U ⊆ ⋃ W ∈ s, W := fun x hx => by
    obtain ⟨V, hVb', hxV⟩ := Set.mem_iUnion₂.mp (hb'cov hx)
    exact Set.mem_iUnion₂.mpr ⟨V, hb'fin.mem_toFinset.mpr hVb', hxV⟩
  exact finset_biUnion_notMem_of_notMem F hF_empty hF_prime s hs_open hs_compact hs_notMem
    (hF_up U _ hU hUsub (isOpen_biUnion hs_open)
      (s.finite_toSet.isCompact_biUnion hs_compact))

/-- For a prime filter `F` of quasi-compact opens, `zSet F` is irreducible: two open sets meeting
`zSet F` can be shrunk to quasi-compact opens belonging to `F`, and the intersection of the latter
again lies in `F` and hence meets `zSet F`. -/
lemma zSet_isIrreducible
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (F : Set (Set X))
    (hF_univ : (Set.univ : Set X) ∈ F)
    (hF_empty : (∅ : Set X) ∉ F)
    (hF_inter : ∀ U V, U ∈ F → V ∈ F → U ∩ V ∈ F)
    (hF_up : ∀ U V, U ∈ F → U ⊆ V → IsOpen V → IsCompact V → V ∈ F)
    (hF_prime : ∀ U V, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
                U ∪ V ∈ F → U ∈ F ∨ V ∈ F) :
    IsIrreducible (zSet F) := by
  refine ⟨(inter_zSet_nonempty_of_mem_compactOpen F hF_empty
    hF_up hF_prime isCompact_univ hF_univ).mono Set.inter_subset_left, ?_⟩
  intro u v hu hv ⟨xu, hxuZ, hxuU⟩ ⟨xv, hxvZ, hxvV⟩
  obtain ⟨u₁, hu₁o, hu₁c, hxu₁, hu₁u⟩ := exists_isCompact_isOpen_subset_of_mem hu hxuU
  obtain ⟨v₁, hv₁o, hv₁c, hxv₁, hv₁v⟩ := exists_isCompact_isOpen_subset_of_mem hv hxvV
  refine (inter_zSet_nonempty_of_mem_compactOpen F hF_empty hF_up hF_prime
    (hu₁c.inter_of_isOpen hv₁c hu₁o hv₁o)
    (hF_inter u₁ v₁ (mem_of_mem_zSet hu₁o hu₁c hxuZ hxu₁)
      (mem_of_mem_zSet hv₁o hv₁c hxvZ hxv₁))).mono ?_
  rintro w ⟨hwZ, hw₁, hw₂⟩
  exact ⟨hwZ, hu₁u hw₁, hv₁v hw₂⟩

/-- A prime filter `F` of quasi-compact opens is realized by a point: the generic point of the
irreducible closed set `zSet F` lies in exactly the quasi-compact opens belonging to `F`. -/
lemma exists_realizing_point_of_prime_filter_isOpen_isCompact
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (F : Set (Set X))
    (hF_univ : (Set.univ : Set X) ∈ F)
    (hF_empty : (∅ : Set X) ∉ F)
    (hF_inter : ∀ U V, U ∈ F → V ∈ F → U ∩ V ∈ F)
    (hF_up : ∀ U V, U ∈ F → U ⊆ V → IsOpen V → IsCompact V → V ∈ F)
    (hF_prime : ∀ U V, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
                U ∪ V ∈ F → U ∈ F ∨ V ∈ F) :
    ∃ x : X, ∀ U : Set X, IsOpen U → IsCompact U → (x ∈ U ↔ U ∈ F) := by
  obtain ⟨x, hx⟩ := QuasiSober.sober
    (zSet_isIrreducible F hF_univ hF_empty hF_inter hF_up hF_prime)
    (zSet_isClosed F)
  refine ⟨x, fun U hUo hUc => ?_⟩
  rw [hx.mem_open_set_iff hUo]
  exact ⟨fun ⟨_, hyZ, hyU⟩ => mem_of_mem_zSet hUo hUc hyZ hyU,
    fun hUF => inter_zSet_nonempty_of_mem_compactOpen F hF_empty hF_up hF_prime hUc hUF⟩

/-! ## Compactness of the constructible topology (Stacks 0901) -/

/-- Suppose no finite subfamily of `P` covers `X`. If `A ⊆ P` and every member of `B` has its
complement in `P`, then a finite intersection of members of `B` is never covered by a finite union
of members of `A`; this is the finite intersection property feeding
`exists_prime_filter_isOpen_isCompact`. -/
lemma fip_of_no_finite_subcover
    {X : Type*}
    (P : Set (Set X))
    (hnf : ∀ Q ⊆ P, Q.Finite → ¬ (Set.univ : Set X) ⊆ ⋃₀ Q)
    {A B : Set (Set X)}
    (hA : A ⊆ P) (hB : ∀ U ∈ B, (Uᶜ : Set X) ∈ P)
    (a b : Set (Set X)) (ha : a ⊆ A) (hb : b ⊆ B)
    (ha_fin : a.Finite) (hb_fin : b.Finite) :
    (⋂₀ b \ ⋃₀ a).Nonempty := by
  by_contra hempty
  rw [Set.not_nonempty_iff_eq_empty] at hempty
  set Q : Set (Set X) := a ∪ ((·ᶜ) '' b)
  refine hnf Q ?_ (ha_fin.union (hb_fin.image _)) ?_
  · rintro V (hV | ⟨U, hU, rfl⟩)
    · exact hA (ha hV)
    · exact hB U (hb hU)
  intro x _
  by_cases hx : x ∈ ⋂₀ b
  · have h_subset : (⋂₀ b : Set X) ⊆ ⋃₀ a := fun y hy => by
      by_contra hny
      exact (hempty ▸ (⟨hy, hny⟩ : y ∈ ⋂₀ b \ ⋃₀ a) : y ∈ (∅ : Set X)).elim
    obtain ⟨U, hU, hxU⟩ := h_subset hx
    exact ⟨U, Or.inl hU, hxU⟩
  · simp only [Set.mem_sInter, not_forall] at hx
    obtain ⟨U, hU, hxU⟩ := hx
    exact ⟨Uᶜ, Or.inr ⟨U, hU, rfl⟩, hxU⟩

/-- A family of quasi-compact opens and complements of quasi-compact opens that has no finite
subcover of a spectral space misses a point: the prime filter supplied by the finite intersection
property is realized by a point lying in none of its members. -/
lemma exists_uncovered_point_of_no_finite_subcover
    {X : Type*} [TopologicalSpace X] [SpectralSpace X]
    (P : Set (Set X))
    (hP : P ⊆ {U : Set X | IsOpen U ∧ IsCompact U} ∪
          {V : Set X | ∃ U : Set X, IsOpen U ∧ IsCompact U ∧ V = Uᶜ})
    (hnf : ∀ Q ⊆ P, Q.Finite → ¬ (Set.univ : Set X) ⊆ ⋃₀ Q) :
    ∃ x : X, ∀ V ∈ P, x ∉ V := by
  set A : Set (Set X) := {U | U ∈ P ∧ IsOpen U ∧ IsCompact U}
  set B : Set (Set X) := {U | IsOpen U ∧ IsCompact U ∧ Uᶜ ∈ P}
  have hB_sub : B ⊆ {U : Set X | IsOpen U ∧ IsCompact U} :=
    fun _ ⟨hUo, hUc, _⟩ => ⟨hUo, hUc⟩
  have hB_compl : ∀ U ∈ B, (Uᶜ : Set X) ∈ P := fun _ ⟨_, _, hUcP⟩ => hUcP
  obtain ⟨F, _, hB_F, hA_F, hF_univ, hF_empty, hF_inter, hF_up, hF_prime⟩ :=
    exists_prime_filter_isOpen_isCompact A B hB_sub
      (fun a b ha hb haf hbf =>
        fip_of_no_finite_subcover P hnf (fun _ hU => hU.1) hB_compl a b ha hb haf hbf)
  obtain ⟨x, hx⟩ := exists_realizing_point_of_prime_filter_isOpen_isCompact F
    hF_univ hF_empty hF_inter hF_up hF_prime
  refine ⟨x, fun V hVP => ?_⟩
  rcases hP hVP with ⟨hVopen, hVcompact⟩ | ⟨U, hUopen, hUcompact, rfl⟩
  · exact fun hxV => hA_F V ⟨hVP, hVopen, hVcompact⟩ ((hx V hVopen hVcompact).mp hxV)
  · exact fun hxVc => hxVc ((hx U hUopen hUcompact).mpr (hB_F ⟨hUopen, hUcompact, hVP⟩))

/-- Every cover of a spectral space by subbasic constructible sets — quasi-compact opens and
complements of quasi-compact opens — admits a finite subcover. -/
@[ega "IV 1.9.9" "special case"]
lemma constructible_subbase_finite_subcover
    (X : Type*) [TopologicalSpace X] [SpectralSpace X]
    (P : Set (Set X))
    (hP : P ⊆ {U : Set X | IsOpen U ∧ IsCompact U} ∪
          {V : Set X | ∃ U : Set X, IsOpen U ∧ IsCompact U ∧ V = Uᶜ})
    (hcov : (Set.univ : Set X) ⊆ ⋃₀ P) :
    ∃ Q ⊆ P, Q.Finite ∧ (Set.univ : Set X) ⊆ ⋃₀ Q := by
  by_contra hcontra
  obtain ⟨x, hx⟩ := exists_uncovered_point_of_no_finite_subcover P hP
    (fun Q hQP hQfin hQcov => hcontra ⟨Q, hQP, hQfin, hQcov⟩)
  obtain ⟨V, hV, hxV⟩ := hcov (Set.mem_univ x)
  exact hx V hV hxV

/-- The constructible topology on a spectral space is quasi-compact: it is enough to extract a
finite subcover from a cover by subbasic sets. -/
@[ega "IV 1.9.15" "(i), (iii)", sga "4 IV 9.1.11" "partial"]
lemma compactSpace_withConstructibleTopology0A2S
    {X : Type*} [TopologicalSpace X] [SpectralSpace X] :
    CompactSpace (WithConstructibleTopologyTypeSynonym X) :=
  ⟨@isCompact_generateFrom (WithConstructibleTopologyTypeSynonym X)
    (instTopologicalSpaceWithConstructibleTopology0A2S X) _ rfl Set.univ
    fun Pcov hPcov hcov => constructible_subbase_finite_subcover X Pcov hPcov hcov⟩

/-- The constructible topology on a spectral space is Hausdorff: two distinct points are separated
by a quasi-compact open `U`, and `U` and `Uᶜ` are both constructible-open. -/
@[ega "IV 1.9.15" "(ii), (iii)"]
lemma t2Space_withConstructibleTopology0A2S
    {X : Type*} [TopologicalSpace X] [SpectralSpace X] :
    T2Space (WithConstructibleTopologyTypeSynonym X) := by
  refine ⟨fun x y hxy => ?_⟩
  obtain ⟨U, hUopen, hUcomp, hsep⟩ :=
    exists_isCompact_isOpen_separating (X := X) (x := x) (y := y) hxy
  rcases hsep with ⟨hxU, hyU⟩ | ⟨hyU, hxU⟩
  · exact ⟨U, Uᶜ, isOpen_constructible_of_isOpen_isCompact hUopen hUcomp,
      isOpen_constructible_compl_of_isOpen_isCompact hUopen hUcomp,
      hxU, hyU, disjoint_compl_right⟩
  · exact ⟨Uᶜ, U, isOpen_constructible_compl_of_isOpen_isCompact hUopen hUcomp,
      isOpen_constructible_of_isOpen_isCompact hUopen hUcomp,
      hxU, hyU, disjoint_compl_left⟩

/-! ## Spectral maps -/

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
  [SpectralSpace X] [SpectralSpace Y]

omit [SpectralSpace X] [SpectralSpace Y] in
/-- **Stacks 0A2S** (continuity in the constructible topology).
A spectral map `f : X → Y` is continuous for the constructible topologies on `X` and `Y`. -/
@[stacks 0A2S "continuity in the constructible topology", ega "IV 1.9.14" "iii, special case"]
theorem spectralMap_continuous_withConstructibleTopology
    (f : X → Y) (hf : IsSpectralMap f) :
    Continuous
      (fun x : WithConstructibleTopologyTypeSynonym X =>
        WithConstructibleTopologyTypeSynonym.of (f (WithConstructibleTopologyTypeSynonym.out
            x))) := by
  rw [continuous_generateFrom_iff]
  rintro s (⟨hsOpen, hsCompact⟩ | ⟨U, hUOpen, hUCompact, rfl⟩)
  · exact TopologicalSpace.isOpen_generateFrom_of_mem <| Or.inl
      ⟨hf.continuous.isOpen_preimage _ hsOpen,
       hf.isCompact_preimage_of_isOpen hsOpen hsCompact⟩
  · exact TopologicalSpace.isOpen_generateFrom_of_mem <| Or.inr
      ⟨f ⁻¹' U, hf.continuous.isOpen_preimage _ hUOpen,
       hf.isCompact_preimage_of_isOpen hUOpen hUCompact, rfl⟩

/-- **Stacks 0A2S** (quasi-compact fibres).
The fibres of a spectral map between spectral spaces are quasi-compact. -/
@[stacks 0A2S "quasi-compact fibres"]
theorem spectralMap_fibre_isCompact
    (f : X → Y) (hf : IsSpectralMap f) (y : Y) :
    IsCompact (f ⁻¹' {y}) := by
  have : T2Space (WithConstructibleTopologyTypeSynonym Y) := t2Space_withConstructibleTopology0A2S
  have : CompactSpace (WithConstructibleTopologyTypeSynonym X) :=
      compactSpace_withConstructibleTopology0A2S
  have hfibre_closed : @IsClosed (WithConstructibleTopologyTypeSynonym X) _ (f ⁻¹' {y}) :=
    isClosed_singleton.preimage (spectralMap_continuous_withConstructibleTopology f hf)
  have h := hfibre_closed.isCompact.image continuous_out_of_prespectralSpace
  -- `WithConstructibleTopologyTypeSynonym.out` is the identity on the underlying set, so the
  -- image in `h` is `f ⁻¹' {y}` itself.
  rwa [show (WithConstructibleTopologyTypeSynonym.out '' (f ⁻¹' {y}) : Set X) = f ⁻¹' {y} from
    Set.image_id' _] at h

/-- **Stacks 0A2S** (closed image in the constructible topology).
The image of a spectral map between spectral spaces is closed in the constructible topology on the
target. -/
@[stacks 0A2S "closed image in the constructible topology", ega "IV 1.9.14" "iv, special case"]
theorem spectralMap_range_isClosed_withConstructibleTopology
    (f : X → Y) (hf : IsSpectralMap f) :
    IsClosed (Set.range (fun x => WithConstructibleTopologyTypeSynonym.of (f x))) := by
  have : T2Space (WithConstructibleTopologyTypeSynonym Y) := t2Space_withConstructibleTopology0A2S
  have : CompactSpace (WithConstructibleTopologyTypeSynonym X) :=
      compactSpace_withConstructibleTopology0A2S
  exact (isCompact_range
    (spectralMap_continuous_withConstructibleTopology f hf)).isClosed

