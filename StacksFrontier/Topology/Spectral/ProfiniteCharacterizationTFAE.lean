module

public import StacksFrontier.Topology.Spectral.ConstructiblyClosedStable
public import StacksFrontier.Topology.Spectral.ProfiniteCharacterization
public import StacksFrontier.Topology.Spectral.SpectralMapConstructible

/-!
# Profinite spectral spaces: the eight equivalent conditions

For a spectral space `X` the following are equivalent (Stacks 0905): `X` is profinite
(quasi-compact, Hausdorff and totally disconnected), `X` is Hausdorff, `X` is totally
disconnected, every quasi-compact open of `X` is closed, there are no nontrivial specializations,
every point of `X` is closed, every point of `X` is the generic point of an irreducible
component, and the constructible topology of `X` equals its given topology.

The implications among the first seven conditions not proved here are in
`StacksFrontier.Topology.Spectral.ProfiniteCharacterization`. If there are no nontrivial
specializations, every quasi-compact open is stable under specialization and constructibly
closed, hence closed (Stacks 0903). The constructible topology is always finer than the given
one and is generated by the quasi-compact opens and their complements, so it equals the given
topology exactly when the quasi-compact opens are closed.

## Main results

* `qcOpen_isClosed_of_trivial_specialization`: on a spectral space with no nontrivial
  specializations every quasi-compact open is closed.
* `constructibleTopology_eq_iff_qcOpen_isClosed`: the constructible topology of a spectral space
  is its given topology exactly when every quasi-compact open is closed.
* `spectralSpace_profinite_tfae`: the eight equivalent conditions of Stacks 0905.
-/

@[expose] public section

open Topology

variable {X : Type*} [TopologicalSpace X]

/-- On a spectral space with no nontrivial specializations, every quasi-compact open is closed:
such an open is closed in the constructible topology, its complement being a generator, and it
is trivially stable under specialization, so it is closed (Stacks 0903). -/
theorem qcOpen_isClosed_of_trivial_specialization [SpectralSpace X]
    (h : ∀ x y : X, x ⤳ y → x = y) :
    ∀ U : Set X, IsOpen U → IsCompact U → IsClosed U := by
  intro U hU hK
  refine isClosed_of_isClosed_constructibleTopology_of_stableUnderSpecialization
    (TopologicalSpace.isClosed_constructibleTopology_of_isOpen_of_isCompact hU hK) ?_
  intro x y hxy hx
  rwa [← h x y hxy]

/-- The constructible topology of a spectral space equals its given topology exactly when every
quasi-compact open is closed. The constructible topology is always finer, and it is generated by
the quasi-compact opens and their complements; the complements are open for the given topology
exactly when the quasi-compact opens are closed. -/
theorem constructibleTopology_eq_iff_qcOpen_isClosed [SpectralSpace X] :
    constructibleTopology X = ‹TopologicalSpace X› ↔
      ∀ U : Set X, IsOpen U → IsCompact U → IsClosed U := by
  constructor
  · intro h U hU hK
    have hc : IsOpen[constructibleTopology X] Uᶜ :=
      IsCompact.isOpen_constructibleTopology_of_isClosed (by rwa [compl_compl]) hU.isClosed_compl
    rw [h] at hc
    exact isOpen_compl_iff.mp hc
  · intro h
    refine le_antisymm (TopologicalSpace.constructibleTopology_le X) ?_
    refine le_generateFrom ?_
    rintro s (⟨hs, -⟩ | ⟨hs, hK⟩)
    · exact hs
    · simpa using (h sᶜ hs.isOpen_compl hK).isOpen_compl

/-- **Stacks 0905**.
For a spectral space `X` the following are equivalent:
1. `X` is profinite, i.e. quasi-compact, Hausdorff and totally disconnected;
2. `X` is Hausdorff;
3. `X` is totally disconnected;
4. every quasi-compact open of `X` is closed;
5. there are no nontrivial specializations between points of `X`;
6. every point of `X` is closed;
7. every point of `X` is the generic point of an irreducible component of `X`;
8. the constructible topology of `X` equals its given topology. -/
@[stacks 0905 "items (1)-(8); the source's item (9) is the placeholder 'add more here' and \
states nothing; profinite is read as quasi-compact, Hausdorff and totally disconnected"]
theorem spectralSpace_profinite_tfae [SpectralSpace X] :
    List.TFAE
      [CompactSpace X ∧ T2Space X ∧ TotallyDisconnectedSpace X,
        T2Space X,
        TotallyDisconnectedSpace X,
        ∀ U : Set X, IsOpen U → IsCompact U → IsClosed U,
        ∀ x y : X, x ⤳ y → x = y,
        ∀ x : X, IsClosed ({x} : Set X),
        ∀ x : X, ∃ Z ∈ irreducibleComponents X, IsGenericPoint x Z,
        constructibleTopology X = ‹TopologicalSpace X›] := by
  tfae_have 1 → 3 := fun h => h.2.2
  tfae_have 3 → 5 := fun h => @trivial_specialization_of_totallyDisconnected X _ h
  tfae_have 5 → 6 := fun h x =>
    have : T1Space X := trivial_specialization_iff_t1Space.mp h
    isClosed_singleton
  tfae_have 6 → 5 := fun h => trivial_specialization_iff_t1Space.mpr ⟨h⟩
  tfae_have 5 ↔ 7 := trivial_specialization_iff_isGenericPoint_irreducibleComponent
  tfae_have 5 → 4 := qcOpen_isClosed_of_trivial_specialization
  tfae_have 4 ↔ 8 := constructibleTopology_eq_iff_qcOpen_isClosed.symm
  tfae_have 4 → 2 := t2Space_of_qcOpen_isClosed
  tfae_have 2 → 1 := fun h => ⟨inferInstance, h, @totallyDisconnectedSpace_of_t2 X _ _ h⟩
  tfae_finish
