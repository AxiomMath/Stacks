module

public import Mathlib.Topology.Spectral.ConstructibleTopology
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Spectral maps are exactly the constructible-continuous maps (Stacks 0G1J)

Let `X` and `Y` be spectral spaces and `f : X → Y` continuous. The tag asserts that `f` is
a spectral map — continuous with quasi-compact preimages of quasi-compact opens — precisely
when `f` is continuous for the constructible topologies on source and target. Mathlib has
`constructibleTopology`, generated by the quasi-compact opens together with their
complements, and `IsSpectralMap`, so the statement is phrased directly about those; there is
no auxiliary predicate for "continuous in the constructible topology".

The forward implication is the easy one: the constructible topology is generated by a
subbasis, and a spectral map pulls each generator back to a generator — a quasi-compact open
to a quasi-compact open, and the complement of one to the complement of one.

The converse is where quasi-compactness of the constructible topology enters. Given a
quasi-compact open `s ⊆ Y`, it is *closed* constructibly, so `f ⁻¹' s` is constructibly
closed, hence constructibly quasi-compact because the whole space is
(`compactSpace_withConstructibleTopology`, Stacks 0901 — the Hochster ultrafilter argument,
which Mathlib already carries). Since the constructible topology refines the original one,
the identity map is continuous from it, and quasi-compactness transfers back.

The hypothesis `hf : Continuous f` is not redundant: it is what the converse needs in order
to produce `IsSpectralMap.toContinuous`, which constructible continuity alone does not give.
-/

@[expose] public section

open Set Topology

namespace TopologicalSpace

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

/-- On a spectral space the constructible topology refines the original one. The original
topology is generated by the quasi-compact opens (`PrespectralSpace.isTopologicalBasis`),
and those are among the generators of the constructible topology. -/
lemma constructibleTopology_le (X : Type*) [TopologicalSpace X] [SpectralSpace X] :
    constructibleTopology X ≤ ‹TopologicalSpace X› := by
  conv_rhs => rw [(PrespectralSpace.isTopologicalBasis (X := X)).eq_generateFrom]
  exact generateFrom_anti Set.subset_union_left

/-- A quasi-compact open subset of a spectral space is closed in the constructible topology,
its complement being one of the generators. -/
lemma isClosed_constructibleTopology_of_isOpen_of_isCompact {s : Set X}
    (hs_open : IsOpen s) (hs_compact : IsCompact s) :
    IsClosed[constructibleTopology X] s := by
  refine @IsClosed.mk X (constructibleTopology X) s ?_
  exact IsCompact.isOpen_constructibleTopology_of_isClosed (by rwa [compl_compl])
    hs_open.isClosed_compl

/-- A spectral space is quasi-compact in its constructible topology. This is Mathlib's
`compactSpace_withConstructibleTopology` (Stacks 0901), transported from the wrapper type
`WithConstructibleTopology X` — a one-field structure, so not the same type as `X` — along the
continuous surjection `WithTopology.ofTopology`. -/
@[ega "IV 1.9.15" "(i), special case"]
lemma isCompact_univ_constructibleTopology (X : Type*) [TopologicalSpace X] [SpectralSpace X] :
    @IsCompact X (constructibleTopology X) Set.univ :=
  @isCompact_univ X (constructibleTopology X)
    (@Function.Surjective.compactSpace (WithConstructibleTopology X) X _
      (constructibleTopology X) _ (WithTopology.continuous_ofTopology _) _
      (WithTopology.ofTopology_surjective _))

/-- A constructibly continuous continuous map is spectral: the preimage of a quasi-compact
open is constructibly closed, hence constructibly quasi-compact, hence quasi-compact. -/
private lemma isSpectralMap_of_continuous_constructibleTopology
    [SpectralSpace X] [SpectralSpace Y] (f : X → Y) (hf : Continuous f)
    (hcc : Continuous[constructibleTopology X, constructibleTopology Y] f) :
    IsSpectralMap f := by
  refine ⟨hf, fun {s} hs_open hs_compact => ?_⟩
  have hpreimage_closed : IsClosed[constructibleTopology X] (f ⁻¹' s) :=
    @IsClosed.preimage X Y (constructibleTopology X) (constructibleTopology Y) f hcc s
      (isClosed_constructibleTopology_of_isOpen_of_isCompact hs_open hs_compact)
  have hpreimage_compact : @IsCompact X (constructibleTopology X) (f ⁻¹' s) :=
    @IsCompact.of_isClosed_subset X (constructibleTopology X) Set.univ (f ⁻¹' s)
      (isCompact_univ_constructibleTopology X) hpreimage_closed (Set.subset_univ _)
  simpa only [Set.image_id] using @IsCompact.image X X (constructibleTopology X) _ (f ⁻¹' s) id
    hpreimage_compact (continuous_id_of_le (constructibleTopology_le X))

/-- A spectral map is constructibly continuous: it pulls each generator of the constructible
topology on `Y` back to a generator of the constructible topology on `X`. -/
@[ega "IV 1.9.14" "(iii)"]
private lemma continuous_constructibleTopology_of_isSpectralMap
    [SpectralSpace X] [SpectralSpace Y] (f : X → Y) (hspec : IsSpectralMap f) :
    Continuous[constructibleTopology X, constructibleTopology Y] f := by
  unfold constructibleTopology
  rw [continuous_generateFrom_iff]
  intro s hs
  apply isOpen_generateFrom_of_mem
  unfold constructibleTopologySubbasis at hs ⊢
  rcases hs with ⟨hs_open, hs_compact⟩ | ⟨hs_closed, hs_compl_compact⟩
  · exact Or.inl ⟨hspec.continuous.isOpen_preimage s hs_open,
      hspec.isCompact_preimage_of_isOpen hs_open hs_compact⟩
  · refine Or.inr ⟨hs_closed.preimage hspec.continuous, ?_⟩
    rw [← Set.preimage_compl]
    exact hspec.isCompact_preimage_of_isOpen hs_closed.isOpen_compl hs_compl_compact

/-- **Stacks 0G1J.** Let `X` and `Y` be spectral spaces and let `f : X → Y` be continuous.
Then `f` is a spectral map if and only if it is continuous for the constructible topologies
on `X` and `Y`. -/
@[stacks 0G1J, ega "IV 1.9.14" "(iii)"]
theorem isSpectralMap_iff_continuous_constructibleTopology
    [SpectralSpace X] [SpectralSpace Y] (f : X → Y) (hf : Continuous f) :
    IsSpectralMap f ↔ Continuous[constructibleTopology X, constructibleTopology Y] f :=
  ⟨continuous_constructibleTopology_of_isSpectralMap f,
   isSpectralMap_of_continuous_constructibleTopology f hf⟩

end TopologicalSpace
