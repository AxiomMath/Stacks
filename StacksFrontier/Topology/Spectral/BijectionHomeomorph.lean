module

public import StacksFrontier.Topology.Spectral.ConstructibleTopology
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A spectral bijection lifting specializations is a homeomorphism (Stacks 09XU)

Let `f : X → Y` be a spectral map between spectral topological spaces (Mathlib's
`IsSpectralMap` and `SpectralSpace`). Stacks 09XU says that if `f` is bijective and either
generalizations or specializations lift along `f` (`GeneralizingMap f`, `SpecializingMap f`),
then `f` is a homeomorphism. A spectral map is continuous and a bijective continuous map is a
homeomorphism as soon as it is open, so the entire content of the tag is the openness of `f`,
and that is what the proof below establishes.

The route is the one the Stacks project takes, through the constructible topology. On a
spectral space the constructible subsets are exactly the sets that are clopen for the
constructible topology; both directions are proved here
(`Topology.IsConstructible.isOpen_constructibleTopology`,
`Topology.IsConstructible.isClosed_constructibleTopology` and
`Topology.isConstructible_of_isClopen_constructibleTopology`), the first from the fact that the
constructible-clopen sets form a boolean subalgebra containing the retrocompact opens, the
second from a finite-subcover argument against the subbasis. Since the constructible topology
on a spectral space is compact and Hausdorff and a spectral map is continuous for it
(`compactSpace_constructibleTopology`, `t2Space_constructibleTopology`,
`IsSpectralMap.continuous_constructibleTopology`), a spectral bijection is a homeomorphism for
the constructible topologies, hence carries constructible sets to constructible sets
(`IsSpectralMap.isConstructible_image_of_bijective`).

The second ingredient is Stacks 0903(1), here
`Topology.IsConstructible.exists_mem_specializes_of_mem_closure`: a point of the closure of a
constructible set `E` is a specialization of a point of `E`. It is obtained by intersecting the
directed family `{V ∩ E | V quasi-compact open ∋ x}` of constructible-compact sets. It follows
that a constructible set stable under generalization is open
(`Topology.IsConstructible.isOpen_of_stableUnderGeneralization`), which is Stacks 0903(3). Now
for a quasi-compact open `U ⊆ X` the image `f '' U` is constructible, and lifting of
generalizations together with the openness of `U` makes `f '' U` stable under generalization,
hence open; as the quasi-compact opens form a basis of a spectral space, `f` is open.

Only the generalization-lifting case needs this geometry: along a bijection the two lifting
conditions are equivalent, which is `SpecializingMap.generalizingMap_of_bijective`. The tag is
carried by the combined statement `Topology.isHomeomorph_of_isSpectralMap_of_bijective`, whose
hypothesis is the disjunction appearing in the source; the two one-sided forms are stated
separately for use by callers that have only one of them.
-/

@[expose] public section

variable {X : Type*} [TopologicalSpace X] {Y : Type*} [TopologicalSpace Y]

namespace Topology.IsConstructible

/-- On a spectral space every constructible set is open for the constructible topology. The
sets that are clopen for the constructible topology form a boolean subalgebra of `Set X`, and it
contains every retrocompact open `U`: on a quasi-compact space a retrocompact set is
quasi-compact, so both `U` and its complement are subbasic constructible opens. Constructible
sets are by definition the boolean subalgebra generated by the retrocompact opens. -/
theorem isOpen_constructibleTopology [SpectralSpace X] {S : Set X}
    (hS : IsConstructible S) : IsOpen[constructibleTopology X] S := by
  let L : BooleanSubalgebra (Set X) :=
    { carrier := {s | @IsClopen X (constructibleTopology X) s}
      supClosed' := fun {a} ha {b} hb => @IsClopen.union X (constructibleTopology X) a b ha hb
      infClosed' := fun {a} ha {b} hb => @IsClopen.inter X (constructibleTopology X) a b ha hb
      compl_mem' := fun {a} ha => @IsClopen.compl X (constructibleTopology X) a ha
      bot_mem' := @isClopen_empty X (constructibleTopology X) }
  have hgen : {U : Set X | IsOpen U ∧ IsRetrocompact U} ⊆ ↑L := fun U ⟨hUopen, hUretro⟩ =>
    hUretro.isCompact.isClopen_constructibleTopology hUopen
  exact (BooleanSubalgebra.closure_le.mpr hgen hS).2

/-- On a spectral space every constructible set is closed for the constructible topology; apply
`Topology.IsConstructible.isOpen_constructibleTopology` to the complement. -/
theorem isClosed_constructibleTopology [SpectralSpace X] {S : Set X}
    (hS : IsConstructible S) : IsClosed[constructibleTopology X] S :=
  (@isOpen_compl_iff X S (constructibleTopology X)).mp hS.compl.isOpen_constructibleTopology

/-- Stacks 0903(1): on a spectral space, a point in the closure of a constructible set `E` is a
specialization of a point of `E`.

Consider the sets `V ∩ E` for `V` a quasi-compact open neighbourhood of `x`. Each is nonempty
because `x ∈ closure E`, and closed for the constructible topology because `V` is
constructible-clopen and `E` is constructible-closed; being closed in a compact space they are
constructible-compact. The family is directed under `⊇` because a spectral space is
quasi-separated, so the intersection of all of them is nonempty. A point `z` of the intersection
lies in `E` and in every quasi-compact open containing `x`, hence, the quasi-compact opens being
a basis, in every open containing `x`; that is exactly `z ⤳ x`. -/
theorem exists_mem_specializes_of_mem_closure [SpectralSpace X] {E : Set X}
    (hE : IsConstructible E) {x : X} (hx : x ∈ closure E) : ∃ z ∈ E, z ⤳ x := by
  let ι := {V : Set X // IsOpen V ∧ IsCompact V ∧ x ∈ V}
  let t : ι → Set X := fun V => V.1 ∩ E
  have hι : Nonempty ι := ⟨⟨Set.univ, isOpen_univ, CompactSpace.isCompact_univ, Set.mem_univ x⟩⟩
  have hne : ∀ i : ι, (t i).Nonempty := fun ⟨_, hVopen, _, hxV⟩ =>
    mem_closure_iff.mp hx _ hVopen hxV
  have hdir : Directed (· ⊇ ·) t := fun ⟨V₁, hV₁open, hV₁comp, hxV₁⟩ ⟨V₂, hV₂open, hV₂comp, hxV₂⟩ =>
    ⟨⟨V₁ ∩ V₂, hV₁open.inter hV₂open,
        QuasiSeparatedSpace.inter_isCompact V₁ V₂ hV₁open hV₁comp hV₂open hV₂comp, hxV₁, hxV₂⟩,
      Set.inter_subset_inter_left E Set.inter_subset_left,
      Set.inter_subset_inter_left E Set.inter_subset_right⟩
  have hclosed : ∀ i : ι, IsClosed[constructibleTopology X] (t i) := fun ⟨V, hVopen, hVcomp, _⟩ =>
    @IsClosed.inter X V E (constructibleTopology X)
      (hVcomp.isClopen_constructibleTopology hVopen).1 hE.isClosed_constructibleTopology
  obtain ⟨z, hz⟩ : (⋂ i : ι, t i).Nonempty :=
    @IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed
      X (constructibleTopology X) ι hι t hdir hne
      (fun i => (hclosed i).isCompact_constructibleTopology) hclosed
  rw [Set.mem_iInter] at hz
  refine ⟨z, (hz Classical.ofNonempty).2, specializes_iff_forall_open.mpr fun U hUopen hxU => ?_⟩
  obtain ⟨V, ⟨hVopen, hVcomp⟩, hxV, hVU⟩ :=
    PrespectralSpace.isTopologicalBasis.mem_nhds_iff.mp (hUopen.mem_nhds hxU)
  exact hVU (hz ⟨V, hVopen, hVcomp, hxV⟩).1

/-- Stacks 0903(3): on a spectral space, a constructible set that is stable under
generalization is open. Its complement is constructible and stable under specialization, so by
`Topology.IsConstructible.exists_mem_specializes_of_mem_closure` it contains its own closure. -/
@[ega "IV 12.0.2" "more general", ega "IV 7.9.10" "partial"]
theorem isOpen_of_stableUnderGeneralization [SpectralSpace X] {S : Set X}
    (hS : IsConstructible S) (hgen : StableUnderGeneralization S) : IsOpen S := by
  suffices h : IsClosed Sᶜ by rwa [← compl_compl S, isOpen_compl_iff]
  rw [← closure_eq_iff_isClosed]
  refine subset_antisymm (fun x hx => ?_) subset_closure
  obtain ⟨z, hz, hzx⟩ := hS.compl.exists_mem_specializes_of_mem_closure hx
  exact hgen.compl hzx hz

end Topology.IsConstructible

namespace Topology

/-- On a spectral space, a set that is clopen for the constructible topology is constructible.
It is open, hence a union of finite intersections of subbasic sets, each of which is
constructible; it is also closed in a compact space, hence constructible-compact, so finitely
many of those basic sets suffice and constructibility is preserved by the finite union. -/
theorem isConstructible_of_isClopen_constructibleTopology [SpectralSpace X] {T : Set X}
    (hT : @IsClopen X (constructibleTopology X) T) : IsConstructible T := by
  have hbasis : @TopologicalSpace.IsTopologicalBasis X (constructibleTopology X)
      ((fun f => ⋂₀ f) '' {f | f.Finite ∧ f ⊆ constructibleTopologySubbasis X}) :=
    @TopologicalSpace.isTopologicalBasis_of_subbasis X (constructibleTopology X)
      (constructibleTopologySubbasis X) rfl
  have hsubbasis_constr : ∀ s ∈ constructibleTopologySubbasis X, IsConstructible s := by
    rintro s (h | h)
    · exact h.2.isConstructible h.1
    · exact compl_compl s ▸ (h.2.isConstructible h.1.isOpen_compl).compl
  have hbasis_constr : ∀ B ∈ (fun f => ⋂₀ f) ''
      {f | f.Finite ∧ f ⊆ constructibleTopologySubbasis X}, IsConstructible B := by
    rintro B ⟨f, ⟨hfin, hfsub⟩, rfl⟩
    exact IsConstructible.sInter hfin fun s hs => hsubbasis_constr s (hfsub hs)
  obtain ⟨S, hSbasis, hSeq⟩ :=
    @TopologicalSpace.IsTopologicalBasis.open_eq_sUnion X (constructibleTopology X) _ hbasis T hT.2
  obtain ⟨S', hS'sub, hS'fin, hTS'⟩ :=
    @IsCompact.elim_finite_subcover_image X (Set X) (constructibleTopology X) T S (fun s => s)
      hT.1.isCompact_constructibleTopology
      (fun s hs => @TopologicalSpace.IsTopologicalBasis.isOpen X (constructibleTopology X) s _
        hbasis (hSbasis hs))
      (Set.sUnion_eq_biUnion ▸ hSeq ▸ Set.Subset.refl _)
  have hS'T : ⋃₀ S' ⊆ T := Set.sUnion_subset fun s hs =>
    Set.subset_sUnion_of_mem (hS'sub hs) |>.trans (hSeq ▸ le_refl _)
  rw [Set.Subset.antisymm (Set.sUnion_eq_biUnion ▸ hTS') hS'T]
  exact IsConstructible.sUnion hS'fin fun s hs => hbasis_constr s (hSbasis (hS'sub hs))

end Topology

/-- A bijective spectral map between spectral spaces carries constructible sets to constructible
sets. Indeed it is continuous for the constructible topologies, which are compact and Hausdorff,
so it is a closed map there; being bijective it therefore takes constructible-clopen sets to
constructible-clopen sets, and on a spectral space those are the constructible sets. -/
theorem IsSpectralMap.isConstructible_image_of_bijective [SpectralSpace X] [SpectralSpace Y]
    {f : X → Y} (hspec : IsSpectralMap f) (hbij : Function.Bijective f) {S : Set X}
    (hS : Topology.IsConstructible S) : Topology.IsConstructible (f '' S) := by
  have hS_clopen : @IsClopen X (constructibleTopology X) S :=
    ⟨hS.isClosed_constructibleTopology, hS.isOpen_constructibleTopology⟩
  have hclosed : @IsClosedMap X Y (constructibleTopology X) (constructibleTopology Y) f :=
    hspec.isClosedMap_constructibleTopology
  refine Topology.isConstructible_of_isClopen_constructibleTopology
    ⟨hclosed _ hS_clopen.1, ?_⟩
  have h : @IsClosed Y (constructibleTopology Y) (f '' S)ᶜ :=
    Set.image_compl_eq hbij ▸
      hclosed _ (@IsClopen.compl X (constructibleTopology X) S hS_clopen).1
  exact compl_compl (f '' S) ▸ h.isOpen_compl

/-- Along a bijection, lifting of specializations implies lifting of generalizations. Given
`y' ⤳ f x`, write `y' = f x'` by surjectivity; lifting the specialization `f x' ⤳ f x` gives
`z` with `x' ⤳ z` and `f z = f x`, and `z = x` by injectivity. -/
theorem SpecializingMap.generalizingMap_of_bijective {f : X → Y} (hsp : SpecializingMap f)
    (hbij : Function.Bijective f) : GeneralizingMap f := by
  intro x y' hy'
  obtain ⟨x', hfx'⟩ := hbij.2 y'
  rw [← hfx'] at hy'
  obtain ⟨z, hz_spec, hfz⟩ := hsp hy'
  exact hbij.1 hfz ▸ ⟨x', hz_spec, hfx'⟩

namespace Topology

/-- Stacks 09XU, the generalization-lifting case: a bijective spectral map between spectral
spaces along which generalizations lift is a homeomorphism.

It remains to see that `f` is open, and the quasi-compact opens form a basis, so let `U` be one.
Then `f '' U` is constructible, and it is stable under generalization: a generalization of
`f x` with `x ∈ U` lifts to a generalization `x'` of `x`, which lies in the open set `U`. A
constructible set stable under generalization is open. -/
theorem isHomeomorph_of_isSpectralMap_of_bijective_of_generalizingMap
    [SpectralSpace X] [SpectralSpace Y] {f : X → Y} (hspec : IsSpectralMap f)
    (hbij : Function.Bijective f) (hgen : GeneralizingMap f) : IsHomeomorph f := by
  refine IsHomeomorph.mk hspec.continuous ?_ hbij
  rw [PrespectralSpace.isTopologicalBasis.isOpenMap_iff]
  intro U ⟨hUopen, hUcomp⟩
  refine (hspec.isConstructible_image_of_bijective hbij
    (hUcomp.isConstructible hUopen)).isOpen_of_stableUnderGeneralization ?_
  rintro y y' hy' ⟨x, hxU, rfl⟩
  obtain ⟨x', hx'_spec, hfx'⟩ := hgen hy'
  exact ⟨x', hx'_spec.mem_open hUopen hxU, hfx'⟩

/-- Stacks 09XU, the specialization-lifting case: a bijective spectral map between spectral
spaces along which specializations lift is a homeomorphism. Along a bijection, lifting of
specializations gives lifting of generalizations. -/
theorem isHomeomorph_of_isSpectralMap_of_bijective_of_specializingMap
    [SpectralSpace X] [SpectralSpace Y] {f : X → Y} (hspec : IsSpectralMap f)
    (hbij : Function.Bijective f) (hsp : SpecializingMap f) : IsHomeomorph f :=
  isHomeomorph_of_isSpectralMap_of_bijective_of_generalizingMap hspec hbij
    (hsp.generalizingMap_of_bijective hbij)

/-- **Stacks 09XU.** Let `f : X → Y` be a spectral, bijective map of spectral topological
spaces. If generalizations or specializations lift along `f`, then `f` is a homeomorphism. -/
@[stacks 09XU]
theorem isHomeomorph_of_isSpectralMap_of_bijective [SpectralSpace X] [SpectralSpace Y]
    {f : X → Y} (hspec : IsSpectralMap f) (hbij : Function.Bijective f)
    (hlift : GeneralizingMap f ∨ SpecializingMap f) : IsHomeomorph f :=
  hlift.elim (isHomeomorph_of_isSpectralMap_of_bijective_of_generalizingMap hspec hbij)
    (isHomeomorph_of_isSpectralMap_of_bijective_of_specializingMap hspec hbij)

end Topology
