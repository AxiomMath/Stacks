/-!
# A Noetherian space with an irreducible closed subset of infinite codimension

The unit interval `[0, 1]`, equipped with the topology generated by the sets `(1 - 1/n, 1]` for
`n : ℕ`, is a Noetherian topological space in which the irreducible closed subset `{0}` has
infinite codimension. Every subset of this space is compact, and every open set is either the
whole space or one of the generating sets `(1 - 1/n, 1]`; the closed sets `[0, 1 - 1/n]` form a
strictly increasing chain of irreducible closed subsets starting at `{0}`.

## Main definitions

* `X`: the carrier, a wrapper around `[0, 1] ⊆ ℝ`.
* `X.stacksTopology`: the topology on `X` generated by the sets `X.basicOpen n`.
* `X.basicOpen`, `X.basicClosed`: the sets `(1 - 1/n, 1]` and `[0, 1 - 1/n]`.
* `X.zero`, `X.zeroAsIC`: the point `0`, and `{0}` as an irreducible closed subset.
* `X.chain`: the strictly increasing chain of irreducible closed subsets `X.basicClosed (k + 1)`.

## Main results

* `X.eq_univ_or_exists_eq_basicOpen`: every open set is `Set.univ` or some `X.basicOpen n`.
* `X.isCompact`: every subset of `X` is compact.
* `X.noetherianSpace_and_coheight_zeroAsIC_eq_top`: `X` is Noetherian and `{0}` is an irreducible
  closed subset of infinite codimension.
-/

@[expose] public section

open TopologicalSpace

/-- The left endpoints of the basic sets increase with the index:
`1 - 1/m ≤ 1 - 1/n` for `1 ≤ m ≤ n`. -/
lemma one_sub_one_div_le_one_sub_one_div {m n : ℕ} (hm : 1 ≤ m) (hmn : m ≤ n) :
    (1 : ℝ) - 1 / (m : ℝ) ≤ 1 - 1 / (n : ℝ) := by
  have hmR : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  have hmn_real : (m : ℝ) ≤ (n : ℝ) := by exact_mod_cast hmn
  linarith [one_div_le_one_div_of_le hmR hmn_real]

/-- Carrier of the example space: a wrapper around the unit interval `[0,1] ⊆ ℝ`.
We use a `structure` so that the `TopologicalSpace` instance we attach is the
Stacks topology, not the subspace topology inherited from `ℝ`. -/
structure X where
  /-- The underlying real point. -/
  val : ℝ
  /-- The underlying real point lies in `[0, 1]`. -/
  mem : 0 ≤ val ∧ val ≤ 1

namespace X

/-- A point of `X` is coerced to `ℝ` by its underlying real value. -/
instance : Coe X ℝ := ⟨fun x => x.val⟩

/-- The coercion to `ℝ` of `⟨v, h⟩` is `v`. -/
@[simp] lemma coe_mk (v : ℝ) (h : 0 ≤ v ∧ v ≤ 1) :
    ((⟨v, h⟩ : X) : ℝ) = v := rfl

/-- Every point of `X` is nonnegative as a real number. -/
lemma coe_nonneg (x : X) : (0 : ℝ) ≤ (x : ℝ) := x.mem.1

/-- Every point of `X` is at most `1` as a real number. -/
lemma coe_le_one (x : X) : (x : ℝ) ≤ 1 := x.mem.2

/-- Two points of `X` with the same underlying real value are equal. -/
@[ext] lemma ext {x y : X} (h : (x : ℝ) = (y : ℝ)) : x = y := by
  cases x; cases y; congr

/-- The basic open set `(1 - 1/n, 1] ⊆ [0, 1]` for `n ∈ ℕ`.
For `n = 0` we have `1/(0:ℝ) = 0`, so `basicOpen 0 = ∅`. -/
def basicOpen (n : ℕ) : Set X := {x : X | (1 - 1/(n:ℝ)) < (x : ℝ)}

/-- The Stacks 02I5 topology on `[0, 1]`, generated by the sets
`(1 - 1/n, 1]` for `n ∈ ℕ`. -/
instance stacksTopology : TopologicalSpace X :=
  TopologicalSpace.generateFrom (Set.range basicOpen)

/-- The point `0 ∈ [0, 1]`. -/
def zero : X := ⟨0, by simp⟩

/-- The underlying real value of `zero` is `0`. -/
@[simp] lemma zero_val : (zero : ℝ) = 0 := rfl

/-- The closed set `[0, 1 - 1/n] ⊆ [0, 1]` for `n ∈ ℕ`. -/
def basicClosed (n : ℕ) : Set X := {x : X | (x : ℝ) ≤ 1 - 1/(n:ℝ)}

/-- A point `x` lies in `basicOpen n` if and only if `1 - 1/n < x`. -/
@[simp] lemma mem_basicOpen {n : ℕ} {x : X} : x ∈ basicOpen n ↔ (1 - 1/(n:ℝ)) < (x : ℝ) := Iff.rfl

/-- A point `x` lies in `basicClosed n` if and only if `x ≤ 1 - 1/n`. -/
@[simp] lemma mem_basicClosed {n : ℕ} {x : X} : x ∈ basicClosed n ↔ (x : ℝ) ≤ 1 - 1/(n:ℝ) := Iff.rfl

/-! ### Elementary properties of `basicOpen` / `basicClosed` -/

/-- `basicOpen 0 = ∅`: the condition `1 < (x:ℝ)` is never satisfied for `x ∈ [0, 1]`. -/
@[simp] lemma basicOpen_zero : basicOpen 0 = ∅ := by
  ext x
  simp only [mem_basicOpen, Set.mem_empty_iff_false, iff_false, not_lt, Nat.cast_zero, div_zero,
    sub_zero]
  exact x.coe_le_one

/-- Since `basicOpen 0 = ∅`, a `basicOpen n` with a point in it has `1 ≤ n`. -/
lemma one_le_of_mem_basicOpen {n : ℕ} {x : X} (hx : x ∈ basicOpen n) : 1 ≤ n := by
  refine Nat.one_le_iff_ne_zero.mpr fun h => ?_
  rw [h, basicOpen_zero] at hx
  exact hx

/-- The complement of `basicClosed n` equals `basicOpen n`. -/
@[simp] lemma compl_basicClosed (n : ℕ) : (basicClosed n)ᶜ = basicOpen n := by
  ext x
  simp [mem_basicClosed, mem_basicOpen]

/-- Each `basicOpen n` is open in the Stacks topology. -/
lemma isOpen_basicOpen (n : ℕ) : IsOpen (basicOpen n) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Set.mem_range_self n)

/-- Each `basicClosed n` is closed in the Stacks topology. -/
lemma isClosed_basicClosed (n : ℕ) : IsClosed (basicClosed n) := by
  rw [← isOpen_compl_iff, compl_basicClosed]
  exact isOpen_basicOpen n

/-- For `1 ≤ m ≤ n`, `basicOpen n ⊆ basicOpen m`. -/
lemma basicOpen_subset_of_le {m n : ℕ} (hm : 1 ≤ m) (hmn : m ≤ n) :
    basicOpen n ⊆ basicOpen m := by
  intro x hx
  simp only [mem_basicOpen] at hx ⊢
  linarith [one_sub_one_div_le_one_sub_one_div hm hmn]

/-- For `1 ≤ m ≤ n`, `basicClosed m ⊆ basicClosed n`. -/
lemma basicClosed_subset_of_le {m n : ℕ} (hm : 1 ≤ m) (hmn : m ≤ n) :
    basicClosed m ⊆ basicClosed n := by
  rw [← Set.compl_subset_compl, compl_basicClosed, compl_basicClosed]
  exact basicOpen_subset_of_le hm hmn

/-- The singleton `{zero}` equals `basicClosed 1`. -/
lemma singleton_zero_eq_basicClosed_one : ({zero} : Set X) = basicClosed 1 := by
  ext x
  simp only [Set.mem_singleton_iff, mem_basicClosed]
  refine ⟨fun h => h ▸ by simp [zero_val], fun h => ?_⟩
  ext
  rw [zero_val]
  exact le_antisymm (by simpa using h) x.coe_nonneg

/-- The point `zero` lies in every `basicClosed n`. -/
lemma zero_mem_basicClosed (n : ℕ) : zero ∈ basicClosed n := by
  rw [mem_basicClosed, zero_val]
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · norm_num
  · have hn' : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have h_inv_le : 1 / (n : ℝ) ≤ 1 := by rw [div_le_one (by linarith)]; exact hn'
    linarith

/-- `basicClosed n` is nonempty. -/
lemma basicClosed_nonempty (n : ℕ) : (basicClosed n).Nonempty :=
  ⟨zero, zero_mem_basicClosed n⟩

/-! ### A strict chain of `basicClosed` -/

/-- The point `1 - 1/((n+2):ℝ) ∈ [0, 1]`. -/
noncomputable def chainPoint (n : ℕ) : X :=
  ⟨1 - 1/((n + 2 : ℕ):ℝ), by
    refine ⟨?_, ?_⟩
    · have hpos : (0:ℝ) < ((n + 2 : ℕ):ℝ) := by exact_mod_cast Nat.succ_pos _
      have h1 : 1/((n + 2 : ℕ):ℝ) ≤ 1 := by
        rw [div_le_one hpos]
        have : (1:ℕ) ≤ n + 2 := by omega
        exact_mod_cast this
      linarith
    · have : (0:ℝ) < 1/((n + 2 : ℕ):ℝ) := by positivity
      linarith⟩

/-- The underlying real value of `chainPoint n` is `1 - 1/(n + 2)`. -/
@[simp] lemma chainPoint_val (n : ℕ) : (chainPoint n : ℝ) = 1 - 1/((n + 2 : ℕ):ℝ) := rfl

/-- `chainPoint n` separates `basicClosed (n+1)` from `basicClosed (n+2)`. -/
lemma chainPoint_mem_sdiff (n : ℕ) :
    chainPoint n ∈ basicClosed (n + 2) \ basicClosed (n + 1) := by
  have hn1 : (0:ℝ) < ((n + 1 : ℕ):ℝ) := by exact_mod_cast Nat.succ_pos _
  have hlt : ((n + 1 : ℕ):ℝ) < ((n + 2 : ℕ):ℝ) := by exact_mod_cast Nat.lt_succ_self _
  have hrecip : 1 / ((n + 2 : ℕ):ℝ) < 1 / ((n + 1 : ℕ):ℝ) :=
    one_div_lt_one_div_of_lt hn1 hlt
  refine ⟨(chainPoint_val n).le, fun h => ?_⟩
  rw [mem_basicClosed, chainPoint_val] at h
  linarith

/-- `basicClosed (n+1) ⊊ basicClosed (n+2)` for all `n : ℕ`. -/
lemma basicClosed_succ_ssubset_succ (n : ℕ) :
    basicClosed (n + 1) ⊂ basicClosed (n + 2) := by
  refine ⟨basicClosed_subset_of_le (by omega) (by omega), fun hsub => ?_⟩
  exact (chainPoint_mem_sdiff n).2 (hsub (chainPoint_mem_sdiff n).1)

/-! ### Classification of open sets

Every open set in the Stacks topology is `Set.univ` or `basicOpen n` for some `n : ℕ`.
(`basicOpen 0 = ∅`, so this covers the empty set.) -/

/-- Intersection of two basic opens is again a basic open. -/
private lemma basicOpen_inter (m n : ℕ) :
    ∃ k, basicOpen m ∩ basicOpen n = basicOpen k := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · exact ⟨0, by simp⟩
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact ⟨0, by simp⟩
  rcases le_total m n with hmn | hnm
  · exact ⟨n, Set.inter_eq_right.mpr (basicOpen_subset_of_le hm hmn)⟩
  · exact ⟨m, Set.inter_eq_left.mpr (basicOpen_subset_of_le hn hnm)⟩

/-- Every open set in the Stacks topology is `Set.univ` or `basicOpen n`. -/
lemma eq_univ_or_exists_eq_basicOpen {U : Set X} (hU : IsOpen U) :
    U = Set.univ ∨ ∃ n : ℕ, U = basicOpen n := by
  induction hU with
  | basic V hV =>
    obtain ⟨n, rfl⟩ := hV
    exact Or.inr ⟨n, rfl⟩
  | univ => exact Or.inl rfl
  | inter U V _ _ ihU ihV =>
    rcases ihU with rfl | ⟨m, rfl⟩
    · rcases ihV with rfl | ⟨n, rfl⟩
      · left; simp
      · right; exact ⟨n, by simp⟩
    · rcases ihV with rfl | ⟨n, rfl⟩
      · right; exact ⟨m, by simp⟩
      · right; exact basicOpen_inter m n
  | sUnion S _ ihS =>
    by_cases hUniv : Set.univ ∈ S
    · exact Or.inl (Set.eq_univ_of_univ_subset (Set.subset_sUnion_of_mem hUniv))
    right
    classical
    -- Indices `≥ 1` whose `basicOpen` lies in `S`; the least one gives the largest member.
    set T : Set ℕ := {k | 1 ≤ k ∧ basicOpen k ∈ S} with hT
    have hmem : ∀ s ∈ S, ∀ {x : X}, x ∈ s → ∃ n ∈ T, x ∈ basicOpen n := by
      intro s hsS x hxs
      obtain ⟨n, rfl⟩ := (ihS s hsS).resolve_left fun h => hUniv (h ▸ hsS)
      exact ⟨n, ⟨one_le_of_mem_basicOpen hxs, hsS⟩, hxs⟩
    by_cases hTne : T.Nonempty
    · obtain ⟨hpos, hS⟩ : 1 ≤ sInf T ∧ basicOpen (sInf T) ∈ S := Nat.sInf_mem hTne
      refine ⟨sInf T, Set.ext fun x =>
        ⟨fun ⟨s, hsS, hxs⟩ => ?_, fun hx => ⟨basicOpen (sInf T), hS, hx⟩⟩⟩
      obtain ⟨n, hnT, hxn⟩ := hmem s hsS hxs
      exact basicOpen_subset_of_le hpos (Nat.sInf_le hnT) hxn
    · refine ⟨0, ?_⟩
      rw [basicOpen_zero, Set.eq_empty_iff_forall_notMem]
      rintro x ⟨s, hsS, hxs⟩
      obtain ⟨n, hnT, _⟩ := hmem s hsS hxs
      exact hTne ⟨n, hnT⟩

/-! ### Compactness, Noetherian property

In any open cover, either some member is `Set.univ`, which is a one-element subcover, or every
member is a `basicOpen k`, in which case the index `k` with smallest value provides one. -/

/-- Every subset of `X` is compact. -/
lemma isCompact (s : Set X) : IsCompact s := by
  apply isCompact_of_finite_subcover
  intro ι U hUopen hsU
  classical
  -- Case split: does any U i equal Set.univ?
  by_cases hUniv : ∃ i, U i = Set.univ
  · obtain ⟨i, hi⟩ := hUniv
    refine ⟨{i}, ?_⟩
    intro x _
    simp only [Finset.mem_singleton, Set.mem_iUnion, exists_prop, exists_eq_left]
    rw [hi]; trivial
  · -- Otherwise each `U i` is some `basicOpen (nIdx i)`.
    choose nIdx hNidx using fun i =>
      (eq_univ_or_exists_eq_basicOpen (hUopen i)).resolve_left fun h => hUniv ⟨i, h⟩
    rcases s.eq_empty_or_nonempty with rfl | ⟨x, hxs⟩
    · exact ⟨∅, by simp⟩
    -- The indices whose basic open meets `s`; the least one gives a one-element subcover.
    set T : Set ℕ := {k | ∃ i, nIdx i = k ∧ (basicOpen k ∩ s).Nonempty} with hT
    have hmem : ∀ {y : X}, y ∈ s → ∃ i, nIdx i ∈ T ∧ y ∈ basicOpen (nIdx i) := by
      intro y hy
      obtain ⟨i, hyi⟩ := Set.mem_iUnion.mp (hsU hy)
      rw [hNidx i] at hyi
      exact ⟨i, ⟨i, rfl, y, hyi, hy⟩, hyi⟩
    obtain ⟨i₀, hi₀T, _⟩ := hmem hxs
    obtain ⟨j, hj, z, hz, _⟩ :
        ∃ i, nIdx i = sInf T ∧ (basicOpen (sInf T) ∩ s).Nonempty := Nat.sInf_mem ⟨_, hi₀T⟩
    refine ⟨{j}, fun y hy => ?_⟩
    simp only [Finset.mem_singleton, Set.mem_iUnion, exists_prop, exists_eq_left]
    obtain ⟨i, hiT, hyi⟩ := hmem hy
    rw [hNidx j, hj]
    exact basicOpen_subset_of_le (one_le_of_mem_basicOpen hz) (Nat.sInf_le hiT) hyi

/-- The example space is Noetherian. -/
instance noetherianSpace : NoetherianSpace X :=
  ((TopologicalSpace.noetherianSpace_TFAE X).out 1 3).mpr isCompact

/-- The singleton `{zero}` is closed. -/
theorem isClosed_singleton_zero : IsClosed ({zero} : Set X) := by
  rw [singleton_zero_eq_basicClosed_one]
  exact isClosed_basicClosed 1

/-! ### Irreducibility of `basicClosed` -/

/-- `basicClosed n` is preirreducible. -/
private lemma isPreirreducible_basicClosed (n : ℕ) :
    IsPreirreducible (basicClosed n) := by
  intro U₁ U₂ hU₁ hU₂ h₁ h₂
  rcases eq_univ_or_exists_eq_basicOpen hU₁ with rfl | ⟨k₁, rfl⟩
  · rwa [Set.univ_inter]
  rcases eq_univ_or_exists_eq_basicOpen hU₂ with rfl | ⟨k₂, rfl⟩
  · rwa [Set.inter_univ]
  -- Both are basic opens, and each is nonempty, so both indices are `≥ 1`; the basic open
  -- with the larger index is contained in the other, and its witness serves for both.
  obtain ⟨x, hx_bc, hx₁⟩ := h₁
  obtain ⟨y, hy_bc, hy₂⟩ := h₂
  rcases le_total k₁ k₂ with h12 | h21
  · exact ⟨y, hy_bc, basicOpen_subset_of_le (one_le_of_mem_basicOpen hx₁) h12 hy₂, hy₂⟩
  · exact ⟨x, hx_bc, hx₁, basicOpen_subset_of_le (one_le_of_mem_basicOpen hy₂) h21 hx₁⟩

/-- `basicClosed n` is irreducible. -/
lemma isIrreducible_basicClosed (n : ℕ) : IsIrreducible (basicClosed n) :=
  ⟨basicClosed_nonempty n, isPreirreducible_basicClosed n⟩

/-- The irreducible closed subset `{0}` as an element of `IrreducibleCloseds X`. -/
def zeroAsIC : IrreducibleCloseds X where
  carrier := {zero}
  isIrreducible' := isIrreducible_singleton
  isClosed' := isClosed_singleton_zero

/-- The carrier of `zeroAsIC` is the singleton `{zero}`. -/
@[simp] lemma coe_zeroAsIC : (zeroAsIC : Set X) = {zero} := rfl

/-! ### Infinite codimension of `{0}` -/

/-- An infinite chain of irreducible closeds: `chain k` has carrier `basicClosed (k+1)`. -/
def chain (k : ℕ) : IrreducibleCloseds X where
  carrier := basicClosed (k + 1)
  isIrreducible' := isIrreducible_basicClosed (k + 1)
  isClosed' := isClosed_basicClosed (k + 1)

/-- The carrier of `chain k` is `basicClosed (k + 1)`. -/
@[simp] lemma coe_chain (k : ℕ) : (chain k : Set X) = basicClosed (k + 1) := rfl

/-- `chain 0 = zeroAsIC` (both have carrier `{zero}`). -/
lemma chain_zero : chain 0 = zeroAsIC :=
  SetLike.coe_injective singleton_zero_eq_basicClosed_one.symm

/-- The chain is strictly increasing. -/
lemma chain_strictMono : StrictMono chain :=
  strictMono_nat_of_lt_succ fun k =>
    SetLike.coe_ssubset_coe.mp (basicClosed_succ_ssubset_succ k)

/-- For each `n`, there is a strict chain of length `n` in `IrreducibleCloseds X`
starting at `zeroAsIC`. -/
lemma exists_ltSeries_head_eq_zeroAsIC (n : ℕ) :
    ∃ p : LTSeries (IrreducibleCloseds X), p.head = zeroAsIC ∧ p.length = n := by
  refine ⟨{
    length := n,
    toFun := fun i => chain i.val,
    step := fun i => chain_strictMono (Nat.lt_succ_self i.val) }, ?_, rfl⟩
  exact chain_zero

/-- The codimension of `Y = {0}` in `X` is infinite. -/
theorem coheight_zeroAsIC_eq_top :
    Order.coheight zeroAsIC = (⊤ : ℕ∞) := by
  rw [Order.coheight_eq_top_iff]
  exact exists_ltSeries_head_eq_zeroAsIC

/-- **Stacks 02I5**.
The space `X = [0, 1]` with the topology generated by the sets `(1 - 1/n, 1]` is a Noetherian
topological space containing an irreducible closed subset `Y = {0}` of infinite codimension. -/
@[stacks 02I5]
theorem noetherianSpace_and_coheight_zeroAsIC_eq_top :
    NoetherianSpace X ∧ IsIrreducible ({zero} : Set X) ∧
      IsClosed ({zero} : Set X) ∧ Order.coheight zeroAsIC = (⊤ : ℕ∞) :=
  ⟨noetherianSpace, isIrreducible_singleton, isClosed_singleton_zero, coheight_zeroAsIC_eq_top⟩

end X

end
