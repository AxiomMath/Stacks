module

public import Mathlib.Topology.Constructible
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Constructible neighbourhoods in a Noetherian space (Stacks 0540)

Let `X` be a Noetherian topological space, let `x ∈ X` and let `E ⊆ X` be constructible. Then `E`
is a neighbourhood of `x` if and only if for every irreducible closed subset `Y ⊆ X` containing
`x` the intersection `E ∩ Y` is dense in `Y`. Constructibility is Mathlib's
`Topology.IsConstructible`, the Boolean subalgebra of subsets generated by the retrocompact
opens, and density of `E ∩ Y` in `Y` is written `Y ⊆ closure (E ∩ Y)`, so the statement never has
to descend to the subspace topology of `Y`.

The forward implication needs neither constructibility nor the Noetherian hypothesis: an open `U`
with `x ∈ U ⊆ E` meets every irreducible `Y` through `x`, and an open set that meets an
irreducible set meets it densely.

The reverse implication is proved by contraposition, and rests on the key fact isolated here as
`Topology.IsConstructible.exists_isOpen_nonempty_subset_of_dense`: a dense constructible subset
of an irreducible Noetherian space contains a nonempty open subset. That fact follows from the
Boolean-subalgebra induction principle for constructible sets, since in a Noetherian space every
subset is retrocompact, so the generators are simply the open sets; a dense difference `U \ V` of
two opens forces `V = ∅`, and for a dense union irreducibility makes one of the two summands
dense on its own.

Given that, suppose `E` is not a neighbourhood of `x`, so `x ∈ closure Eᶜ`. The descending chain
condition on closed sets provides a closed `Y ∋ x` minimal among the closed sets `Y'` with
`x ∈ closure (Eᶜ ∩ Y')`. Minimality forces `Eᶜ ∩ Y` to be dense in `Y`, and forces `Y` to be
irreducible: in either case a failure would exhibit a strictly smaller closed set with the same
property. The subspace `Y` is irreducible and Noetherian and `Eᶜ ∩ Y` is a dense constructible
subset of it, so it contains a nonempty open of `Y`, that is, an open `U ⊆ X` with `U ∩ Y`
nonempty and `U ∩ Y ⊆ Eᶜ`. This contradicts the assumed density of `E ∩ Y` in `Y`.
-/

@[expose] public section

open Set Topology TopologicalSpace

namespace Topology

variable {X : Type*} [TopologicalSpace X]

/-- In an irreducible Noetherian space, a dense constructible subset contains a nonempty open
subset. In a Noetherian space every subset is retrocompact, so the constructible sets form the
Boolean subalgebra generated by the open sets; the induction principle for such a subalgebra
reduces the claim to a difference of two opens, where density forces the subtrahend to be empty,
and to a union, where irreducibility makes one summand dense by itself. -/
@[ega "0 9.2.2" "necessity", ega "IV 9.2.5" "partial", sga "1 IV 6.1" "necessity, special case"]
lemma IsConstructible.exists_isOpen_nonempty_subset_of_dense [NoetherianSpace X]
    [IrreducibleSpace X] {S : Set X} (hS : IsConstructible S) (hSd : Dense S) :
    ∃ V : Set X, IsOpen V ∧ V.Nonempty ∧ V ⊆ S := by
  have retro : ∀ U : Set X, IsRetrocompact U := fun _ _ _ _ => NoetherianSpace.isCompact _
  have hlat : IsSublattice {U : Set X | IsOpen U ∧ IsRetrocompact U} :=
    ⟨fun _ ha _ hb => ⟨ha.1.union hb.1, retro _⟩, fun _ ha _ hb => ⟨ha.1.inter hb.1, retro _⟩⟩
  refine BooleanSubalgebra.closure_sdiff_sup_induction hlat ⟨isOpen_empty, retro _⟩
    ⟨isOpen_univ, retro _⟩
    (p := fun (s : Set X) _ => Dense s → ∃ V : Set X, IsOpen V ∧ V.Nonempty ∧ V ⊆ s) ?_ ?_ S hS hSd
  · -- A dense difference of two opens: the subtrahend must be empty.
    intro u hu v hv hd
    have hsub : (univ : Set X) ⊆ vᶜ :=
      hd.closure_eq ▸ closure_minimal (sdiff_subset_compl u v) hv.1.isClosed_compl
    have hv0 : v = ∅ := eq_empty_of_subset_empty fun t ht => absurd ht (hsub (mem_univ t))
    rw [hv0, sdiff_empty] at hd ⊢
    exact ⟨u, hu.1, hd.nonempty, subset_rfl⟩
  · -- A dense union: by irreducibility one of the two summands is already dense.
    intro a _ b _ ha hb hd
    have hcov : (univ : Set X) ⊆ closure a ∪ closure b := by
      rw [← closure_union]
      exact hd.closure_eq.ge
    have hirr := (IrreducibleSpace.isIrreducible_univ X).isPreirreducible
    rw [isPreirreducible_iff_isClosed_union_isClosed] at hirr
    rcases hirr _ _ isClosed_closure isClosed_closure hcov with h | h
    · exact (ha fun t => h (mem_univ t)).imp fun V ⟨o, n, s⟩ => ⟨o, n, s.trans le_sup_left⟩
    · exact (hb fun t => h (mem_univ t)).imp fun V ⟨o, n, s⟩ => ⟨o, n, s.trans le_sup_right⟩

/-- An open set that meets an irreducible set meets it densely. -/
lemma subset_closure_inter_of_isIrreducible {U Y : Set X} (hY : IsIrreducible Y) (hU : IsOpen U)
    (hUY : (U ∩ Y).Nonempty) : Y ⊆ closure (U ∩ Y) := by
  intro y hyY
  rw [mem_closure_iff]
  intro W hW hyW
  obtain ⟨z, hzY, hzU, hzW⟩ := hY.2 U W hU hW (inter_comm U Y ▸ hUY) ⟨y, hyY, hyW⟩
  exact ⟨z, hzW, hzU, hzY⟩

/-- In a Noetherian space, a point of `closure F` already lies in `closure (F ∩ Y)` for some
closed `Y` containing it that is minimal with that property. This is the descending chain
condition on closed subsets. -/
lemma exists_minimal_isClosed_mem_closure_inter [NoetherianSpace X] {x : X} {F : Set X}
    (hxF : x ∈ closure F) :
    ∃ Y : Set X, IsClosed Y ∧ x ∈ Y ∧ x ∈ closure (F ∩ Y) ∧
      ∀ Y' : Set X, IsClosed Y' → x ∈ Y' → x ∈ closure (F ∩ Y') → Y' ⊆ Y → Y' = Y := by
  set C : Set (Closeds X) := {c | x ∈ (c : Set X) ∧ x ∈ closure (F ∩ (c : Set X))}
  have hCne : C.Nonempty := ⟨⊤, mem_univ x, by simpa only [Closeds.coe_top, inter_univ] using hxF⟩
  have wf : WellFounded ((· < ·) : Closeds X → Closeds X → Prop) := wellFounded_lt
  set Y := wf.min C hCne
  have hYmem : Y ∈ C := wf.min_mem C hCne
  refine ⟨Y, Y.2, hYmem.1, hYmem.2, fun Y' hY'c hxY' hxcl hY'sub => ?_⟩
  by_contra hne
  refine wf.not_lt_min C (show (⟨Y', hY'c⟩ : Closeds X) ∈ C from ⟨hxY', hxcl⟩) ?_
  exact lt_of_le_of_ne hY'sub fun heq => hne (congrArg Closeds.carrier heq)

/-- Minimality makes `F ∩ Y` dense in `Y`: a point of `Y` outside `closure (F ∩ Y)` has an open
neighbourhood `U` missing `F ∩ Y`, and then `Y ∩ Uᶜ` is a strictly smaller closed set with the
same property. -/
lemma subset_closure_inter_of_minimal {x : X} {F Y : Set X} (hY : IsClosed Y) (hxY : x ∈ Y)
    (hxcl : x ∈ closure (F ∩ Y))
    (hmin : ∀ Y' : Set X, IsClosed Y' → x ∈ Y' → x ∈ closure (F ∩ Y') → Y' ⊆ Y → Y' = Y) :
    Y ⊆ closure (F ∩ Y) := by
  intro y hyY
  by_contra hy
  rw [mem_closure_iff] at hy
  push Not at hy
  obtain ⟨U, hUo, hyU, hUdisj⟩ := hy
  have hxY' : x ∈ Y ∩ Uᶜ := by
    refine ⟨hxY, fun hxU => ?_⟩
    obtain ⟨z, hzU, hzFY⟩ := mem_closure_iff.mp hxcl U hUo hxU
    exact hUdisj.subset ⟨hzU, hzFY⟩
  have hFY : F ∩ Y ⊆ F ∩ (Y ∩ Uᶜ) := fun z hz => ⟨hz.1, hz.2, fun hzU => hUdisj.subset ⟨hzU, hz⟩⟩
  exact inter_eq_left.mp (hmin _ (hY.inter hUo.isClosed_compl) hxY' (closure_mono hFY hxcl)
    inter_subset_left) hyY hyU

/-- Minimality makes `Y` irreducible: if `Y` were covered by two proper closed subsets, then
`closure (F ∩ Y)` would split accordingly, and the piece containing `x` would be a strictly
smaller closed set with the same property. -/
lemma isIrreducible_of_minimal {x : X} {F Y : Set X} (hY : IsClosed Y) (hxY : x ∈ Y)
    (hxcl : x ∈ closure (F ∩ Y))
    (hmin : ∀ Y' : Set X, IsClosed Y' → x ∈ Y' → x ∈ closure (F ∩ Y') → Y' ⊆ Y → Y' = Y) :
    IsIrreducible Y := by
  refine ⟨⟨x, hxY⟩, ?_⟩
  rw [isPreirreducible_iff_isClosed_union_isClosed]
  intro A B hA hB hYAB
  -- The point `x` lies in the closure of one of the two halves; minimality makes that half `Y`.
  have hx : x ∈ closure (F ∩ (Y ∩ A)) ∪ closure (F ∩ (Y ∩ B)) := by
    rwa [← closure_union, ← inter_union_distrib_left, ← inter_union_distrib_left,
      inter_eq_left.mpr hYAB]
  have key : ∀ C : Set X, IsClosed C → x ∈ closure (F ∩ (Y ∩ C)) → Y ⊆ C := fun C hC hxC =>
    inter_eq_left.mp <| hmin _ (hY.inter hC)
      (closure_minimal inter_subset_right (hY.inter hC) hxC) hxC inter_subset_left
  exact hx.imp (key A hA) (key B hB)

/-- If `F` is constructible and dense in an irreducible subset `Y` of a Noetherian space, then
some open subset of the ambient space carves a nonempty open of `Y` out of `F`. This is the key
lemma applied inside the subspace `Y`, which is again irreducible and Noetherian. -/
@[ega "0 9.2.2" "necessity", ega "IV 9.2.5" "more general"]
lemma IsConstructible.exists_isOpen_inter_subset_of_subset_closure_inter [NoetherianSpace X]
    {F Y : Set X} (hF : IsConstructible F) (hY : IsIrreducible Y)
    (hFY : Y ⊆ closure (F ∩ Y)) :
    ∃ U : Set X, IsOpen U ∧ (U ∩ Y).Nonempty ∧ U ∩ Y ⊆ F := by
  have : IrreducibleSpace ↥Y := isIrreducible_iff_irreducibleSpace.mp hY
  have hFc : IsConstructible (Subtype.val ⁻¹' F : Set ↥Y) :=
    hF.preimage continuous_subtype_val fun _ _ _ _ _ _ => NoetherianSpace.isCompact _
  have hFd : Dense (Subtype.val ⁻¹' F : Set ↥Y) := by
    rw [dense_iff_closure_eq]
    ext ⟨z, hzY⟩
    simp only [mem_univ, iff_true, mem_closure_iff]
    intro W hW hzW
    rw [isOpen_induced_iff] at hW
    obtain ⟨V, hVo, rfl⟩ := hW
    obtain ⟨w, hwV, hwF, hwY⟩ := mem_closure_iff.mp (hFY hzY) V hVo hzW
    exact ⟨⟨w, hwY⟩, hwV, hwF⟩
  obtain ⟨V, hVo, hVne, hVF⟩ := hFc.exists_isOpen_nonempty_subset_of_dense hFd
  rw [isOpen_induced_iff] at hVo
  obtain ⟨U, hUo, rfl⟩ := hVo
  refine ⟨U, hUo, ?_, fun z hz => hVF (show (⟨z, hz.2⟩ : ↥Y) ∈ _ from hz.1)⟩
  obtain ⟨⟨w, hwY⟩, hwU⟩ := hVne
  exact ⟨w, hwU, hwY⟩

/-- **Stacks 0540.** In a Noetherian topological space, a constructible subset `E` is a
neighbourhood of a point `x` if and only if `E ∩ Y` is dense in `Y` for every irreducible closed
subset `Y` containing `x`. -/
@[stacks 0540, ega "0 9.2.5"]
theorem IsConstructible.mem_nhds_iff_forall_subset_closure_inter [NoetherianSpace X] {E : Set X}
    (hE : IsConstructible E) (x : X) :
    E ∈ 𝓝 x ↔ ∀ Y : Set X, IsClosed Y → IsIrreducible Y → x ∈ Y → Y ⊆ closure (E ∩ Y) := by
  refine ⟨fun hnhds Y _ hY hxY => ?_, fun hdense => ?_⟩
  · obtain ⟨U, hUE, hUo, hxU⟩ := mem_nhds_iff.mp hnhds
    exact (subset_closure_inter_of_isIrreducible hY hUo ⟨x, hxU, hxY⟩).trans
      (closure_mono (inter_subset_inter_left Y hUE))
  · by_contra hnot
    have hxF : x ∈ closure Eᶜ := by
      rwa [closure_compl, mem_compl_iff, mem_interior_iff_mem_nhds]
    obtain ⟨Y, hYc, hxY, hxcl, hYmin⟩ := exists_minimal_isClosed_mem_closure_inter hxF
    have hYirr : IsIrreducible Y := isIrreducible_of_minimal hYc hxY hxcl hYmin
    obtain ⟨U, hUo, ⟨y, hyU, hyY⟩, hUYF⟩ :=
      hE.compl.exists_isOpen_inter_subset_of_subset_closure_inter hYirr
        (subset_closure_inter_of_minimal hYc hxY hxcl hYmin)
    refine absurd (hdense Y hYc hYirr hxY hyY) fun hy => ?_
    obtain ⟨z, hzU, hzE, hzY⟩ := mem_closure_iff.mp hy U hUo hyU
    exact hUYF ⟨hzU, hzY⟩ hzE

end Topology
