/-!
# A projective ideal which is not locally free

An ideal of a commutative ring generated by a countable set of idempotents is projective, and
this produces a projective module that is not locally free: in the ring `R = ∏_{n} 𝔽₂` the ideal
generated by the idempotents `eₙ = (1, …, 1, 0, 0, …)` (with `n` ones) is projective but not
finitely generated, while a locally free module over `R` would be finitely generated because
freeness of a localization of an ideal of a ring forces that localization to be of rank at most
one, hence finite.

Projectivity is proved by Kaplansky's trick: from idempotents `f₀, f₁, …` one builds an
increasing family `cₙ` of idempotents with `cₙ fᵢ = fᵢ` for `i ≤ n`, whose differences give a
splitting `I → ⊕ₙ R` of the map `⊕ₙ R → I` sending the `n`-th basis vector to `cₙ`.

## Main results

* `Stacks.Examples.projective_of_eq_span_countable_idempotents`: an ideal generated by a
  countable set of idempotents is a projective module.
* `Stacks.Examples.exists_projective_ideal_not_locallyFree`: some projective ideal of a
  commutative ring is not locally free.

## Implementation notes

The countable collection of the source is a countable set, and generation of the ideal is
equality with its span. Projectivity is `Module.Projective` on the subtype underlying the ideal.
Local freeness is the affine-cover notion `Module.IsLocallyFree`, not finite local freeness.

## References

* [Stacks Project, Tag 05WH](https://stacks.math.columbia.edu/tag/05WH)
* [Stacks Project, Tag 05WJ](https://stacks.math.columbia.edu/tag/05WJ)
-/

@[expose] public section

namespace Stacks.Examples

universe u

/-! ### Ideals generated by countably many idempotents -/

private def combineIdempotents {R : Type u} [CommRing R] (a b : R) : R :=
  a + (1 - a) * b

private lemma combineIdempotents_idem {R : Type u} [CommRing R] {a b : R}
    (ha : IsIdempotentElem a) (hb : IsIdempotentElem b) :
    IsIdempotentElem (combineIdempotents a b) := by
  change combineIdempotents a b * combineIdempotents a b = combineIdempotents a b
  dsimp [combineIdempotents]
  ring_nf
  simp only [pow_two, ha.eq, hb.eq]
  ring

private lemma combineIdempotents_mul_left {R : Type u} [CommRing R] {a b : R}
    (ha : IsIdempotentElem a) : a * combineIdempotents a b = a := by
  dsimp [combineIdempotents]
  ring_nf
  simp only [pow_two, ha.eq]
  ring

private lemma combineIdempotents_mul_right {R : Type u} [CommRing R] {a b : R}
    (hb : IsIdempotentElem b) : combineIdempotents a b * b = b := by
  dsimp [combineIdempotents]
  ring_nf
  simp only [pow_two, hb.eq]
  ring

private def cumulativeIdempotent {R : Type u} [CommRing R] (f : ℕ → R) : ℕ → R
  | 0 => f 0
  | n + 1 => combineIdempotents (cumulativeIdempotent f n) (f (n + 1))

private lemma cumulativeIdempotent_idem {R : Type u} [CommRing R] (f : ℕ → R)
    (hf : ∀ n, IsIdempotentElem (f n)) (n : ℕ) :
    IsIdempotentElem (cumulativeIdempotent f n) := by
  induction n with
  | zero => simpa [cumulativeIdempotent] using hf 0
  | succ n ih =>
      simpa [cumulativeIdempotent] using combineIdempotents_idem ih (hf (n + 1))

/-- Combining with a further idempotent keeps fixed any element that is already fixed. -/
private lemma combineIdempotents_mul_of_mul_eq {R : Type u} [CommRing R] {a b y : R}
    (h : a * y = y) : combineIdempotents a b * y = y := by
  dsimp [combineIdempotents]
  linear_combination (1 - b) * h

private lemma cumulativeIdempotent_mul_fixed {R : Type u} [CommRing R] (f : ℕ → R)
    {x : R} {N n : ℕ} (hN : cumulativeIdempotent f N * x = x) (hNn : N ≤ n) :
    cumulativeIdempotent f n * x = x := by
  induction n, hNn using Nat.le_induction with
  | base => exact hN
  | succ n _ ih => exact combineIdempotents_mul_of_mul_eq ih

private lemma cumulativeIdempotent_mul_f {R : Type u} [CommRing R] (f : ℕ → R)
    (hf : ∀ n, IsIdempotentElem (f n)) {i n : ℕ} (hin : i ≤ n) :
    cumulativeIdempotent f n * f i = f i := by
  refine cumulativeIdempotent_mul_fixed f ?_ hin
  cases i with
  | zero => simpa [cumulativeIdempotent] using (hf 0).eq
  | succ i => simpa [cumulativeIdempotent] using combineIdempotents_mul_right (hf (i + 1))

private def idempotentPart {R : Type u} [CommRing R] (f : ℕ → R) : ℕ → R
  | 0 => cumulativeIdempotent f 0
  | n + 1 => cumulativeIdempotent f (n + 1) - cumulativeIdempotent f n

private lemma cumulativeIdempotent_mem {R : Type u} [CommRing R] (f : ℕ → R)
    {I : Ideal R} (hfI : ∀ n, f n ∈ I) (n : ℕ) : cumulativeIdempotent f n ∈ I := by
  induction n with
  | zero => simpa [cumulativeIdempotent] using hfI 0
  | succ n ih =>
      simp only [cumulativeIdempotent, combineIdempotents]
      exact I.add_mem ih (I.mul_mem_left _ (hfI (n + 1)))

private lemma idempotentPart_mul_zero_of_fixed {R : Type u} [CommRing R] (f : ℕ → R)
    {x : R} {N n : ℕ}
    (hN : cumulativeIdempotent f N * x = x) (hNn : N < n) :
    idempotentPart f n * x = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_zero_of_lt hNn)
  rw [idempotentPart, sub_mul,
    cumulativeIdempotent_mul_fixed f hN (by omega : N ≤ k + 1),
    cumulativeIdempotent_mul_fixed f hN (by omega : N ≤ k), sub_self]

private lemma idempotentPart_mul_cumulative {R : Type u} [CommRing R] (f : ℕ → R)
    (hf : ∀ n, IsIdempotentElem (f n)) (n : ℕ) :
    idempotentPart f n * cumulativeIdempotent f n = idempotentPart f n := by
  cases n with
  | zero =>
      simpa [idempotentPart, cumulativeIdempotent] using
        (cumulativeIdempotent_idem f hf 0).eq
  | succ n =>
      change (combineIdempotents (cumulativeIdempotent f n) (f (n + 1)) -
        cumulativeIdempotent f n) * combineIdempotents (cumulativeIdempotent f n) (f (n + 1)) =
        combineIdempotents (cumulativeIdempotent f n) (f (n + 1)) - cumulativeIdempotent f n
      rw [sub_mul, combineIdempotents_idem (cumulativeIdempotent_idem f hf n) (hf (n + 1)),
        combineIdempotents_mul_left (cumulativeIdempotent_idem f hf n)]

private lemma idempotentPart_sum_mul {R : Type u} [CommRing R] (f : ℕ → R) (N : ℕ) (x : R) :
    ∑ n ∈ Finset.range (N + 1), idempotentPart f n * x = cumulativeIdempotent f N * x := by
  induction N with
  | zero => simp [idempotentPart, cumulativeIdempotent]
  | succ N ih =>
      rw [Finset.sum_range_succ, ih]
      simp only [idempotentPart]
      ring

private lemma exists_cumulative_fixes_of_mem_span {R : Type u} [CommRing R]
    (f : ℕ → R) (hf : ∀ n, IsIdempotentElem (f n)) {x : R}
    (hx : x ∈ Ideal.span (Set.range f)) :
    ∃ N, cumulativeIdempotent f N * x = x := by
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hx
  refine ⟨c.support.sup (fun i : ℕ => i), ?_⟩
  rw [← hc, Finsupp.sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [smul_eq_mul]
  calc
    cumulativeIdempotent f (c.support.sup fun i : ℕ => i) * (c i * f i) =
        c i * (cumulativeIdempotent f (c.support.sup fun i : ℕ => i) * f i) := by ring
    _ = c i * f i := by rw [cumulativeIdempotent_mul_f f hf
      (Finset.le_sup (f := fun i : ℕ => i) hi)]

private lemma idempotentPart_support_finite {R : Type u} [CommRing R] (f : ℕ → R)
    {I : Ideal R}
    (hfix : ∀ x : I, ∃ N, cumulativeIdempotent f N * (x : R) = x) (x : I) :
    (Function.support fun n => idempotentPart f n * (x : R)).Finite := by
  obtain ⟨N, hN⟩ := hfix x
  apply (Set.finite_Iic N).subset
  intro n hn
  simp only [Function.mem_support] at hn
  by_contra hnot
  exact hn (idempotentPart_mul_zero_of_fixed f hN (Nat.lt_of_not_ge hnot))

private noncomputable def idempotentCoordinates {R : Type u} [CommRing R]
    (f : ℕ → R) (I : Ideal R)
    (hfix : ∀ x : I, ∃ N, cumulativeIdempotent f N * (x : R) = x) :
    I →ₗ[R] ℕ →₀ R := by
  classical
  refine
    { toFun := fun x => Finsupp.ofSupportFinite (fun n => idempotentPart f n * (x : R))
        (idempotentPart_support_finite f hfix x)
      map_add' := ?_
      map_smul' := ?_ }
  · intro x y
    ext n
    simp [Finsupp.ofSupportFinite_coe, mul_add]
  · intro r x
    ext n
    simp [Finsupp.ofSupportFinite_coe, mul_assoc, mul_comm]

private lemma idempotentCoordinates_apply {R : Type u} [CommRing R]
    (f : ℕ → R) (I : Ideal R)
    (hfix : ∀ x : I, ∃ N, cumulativeIdempotent f N * (x : R) = x) (x : I) (n : ℕ) :
    idempotentCoordinates f I hfix x n = idempotentPart f n * (x : R) := by
  simp [idempotentCoordinates, Finsupp.ofSupportFinite_coe]

private lemma idempotentCoordinates_support_subset {R : Type u} [CommRing R]
    (f : ℕ → R) (I : Ideal R)
    (hfix : ∀ x : I, ∃ N, cumulativeIdempotent f N * (x : R) = x) (x : I)
    {N : ℕ} (hN : cumulativeIdempotent f N * (x : R) = x) :
    (idempotentCoordinates f I hfix x).support ⊆ Finset.range (N + 1) := by
  intro n hn
  simp only [Finset.mem_range]
  by_contra hnot
  have hcoeff : idempotentPart f n * (x : R) ≠ 0 := by
    rw [← idempotentCoordinates_apply f I hfix x n]
    exact Finsupp.mem_support_iff.mp hn
  exact hcoeff (idempotentPart_mul_zero_of_fixed f hN (by omega : N < n))

private lemma idempotentPart_sum_eq_cumulative {R : Type u} [CommRing R] (f : ℕ → R)
    (hf : ∀ n, IsIdempotentElem (f n)) (N : ℕ) (x : R) :
    ∑ n ∈ Finset.range (N + 1), (idempotentPart f n * x) * cumulativeIdempotent f n =
      cumulativeIdempotent f N * x := by
  rw [← idempotentPart_sum_mul f N x]
  apply Finset.sum_congr rfl
  intro n _
  rw [mul_right_comm, idempotentPart_mul_cumulative f hf]

/-- **Stacks 05WH.** An ideal generated by a countable set of idempotent elements is projective
as a module. -/
@[stacks 05WH]
theorem projective_of_eq_span_countable_idempotents
    {R : Type u} [CommRing R] (I : Ideal R) (s : Set R)
    (hs : s.Countable) (hidem : ∀ e ∈ s, IsIdempotentElem e)
    (hI : I = Ideal.span s) : Module.Projective R I := by
  classical
  by_cases hsEmpty : s = ∅
  · rw [show I = ⊥ by simp [hI, hsEmpty]]
    exact Module.Projective.of_split (Submodule.subtype (⊥ : Ideal R)) 0 (by ext x)
  · obtain ⟨f, hfRange⟩ := hs.exists_eq_range (Set.nonempty_iff_ne_empty.mpr hsEmpty)
    have hfidem : ∀ n, IsIdempotentElem (f n) := fun n =>
      hidem _ (hfRange ▸ Set.mem_range_self n)
    have hfI : ∀ n, f n ∈ I := fun n => by
      rw [hI]
      exact Ideal.subset_span (hfRange ▸ Set.mem_range_self n)
    have hfix : ∀ x : I, ∃ N, cumulativeIdempotent f N * (x : R) = x := fun x =>
      exists_cumulative_fixes_of_mem_span f hfidem (by rw [← hfRange, ← hI]; exact x.property)
    let toFree : I →ₗ[R] ℕ →₀ R := idempotentCoordinates f I hfix
    let fromFree : (ℕ →₀ R) →ₗ[R] I :=
      Finsupp.linearCombination R fun n =>
        ⟨cumulativeIdempotent f n, cumulativeIdempotent_mem f hfI n⟩
    have hsplit : fromFree.comp toFree = LinearMap.id := by
      ext x
      obtain ⟨N, hN⟩ := hfix x
      change I.subtype ((toFree x).sum fun n a => a •
        (⟨cumulativeIdempotent f n, cumulativeIdempotent_mem f hfI n⟩ : I)) = (x : R)
      rw [map_finsuppSum]
      simp only [map_smul, Submodule.subtype_apply, smul_eq_mul]
      rw [Finsupp.sum_of_support_subset (toFree x)
        (idempotentCoordinates_support_subset f I hfix x hN)
        (fun n a => a * cumulativeIdempotent f n) (by simp)]
      simp_rw [show ∀ n : ℕ, (toFree x) n = idempotentPart f n * (x : R) from
        idempotentCoordinates_apply f I hfix x]
      exact (idempotentPart_sum_eq_cumulative f hfidem N (x : R)).trans hN
    exact Module.Projective.of_split toFree fromFree hsplit

/-! ### A projective ideal which is not locally free -/

private noncomputable def finsuppUnitEquiv (A : Type*) [Semiring A] : (Unit →₀ A) ≃ₗ[A] A where
  toFun x := x ()
  invFun a := Finsupp.single () a
  left_inv x := by ext; simp
  right_inv a := by simp
  map_add' x y := by simp
  map_smul' a x := by simp

private theorem finite_of_free_injective_to_ring
    {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M] [Module.Free A M]
    (f : M →ₗ[A] A) (hf : Function.Injective f) : Module.Finite A M := by
  classical
  rcases subsingleton_or_nontrivial A with hA | hA
  · have : Subsingleton M := Module.subsingleton A M
    exact Module.Finite.of_surjective (0 : A →ₗ[A] M) fun x => ⟨0, Subsingleton.elim _ _⟩
  · let b := Module.Free.chooseBasis A M
    have : Subsingleton (Module.Free.ChooseBasisIndex A M) := by
      refine ⟨fun i j ↦ ?_⟩
      by_contra hij
      have hrel : (f (b j)) • b i - (f (b i)) • b j = 0 := by
        apply hf
        rw [map_zero, map_sub, map_smul, map_smul]
        simp only [smul_eq_mul]
        ring
      have hfj : f (b j) = 0 := by
        simpa [b.repr_self, hij] using congrArg (fun z ↦ z i) (congrArg b.repr hrel)
      have hbne : b j ≠ 0 := fun hb => by simpa using congrArg (fun z ↦ z j) (congrArg b.repr hb)
      exact hbne (hf (by simp [hfj]))
    exact Module.Finite.of_basis b

private theorem localized_ideal_finite_of_free
    {R : Type*} [CommRing R] (I : Ideal R) (f : R)
    [Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) I)] :
    Module.Finite (Localization.Away f) (LocalizedModule (Submonoid.powers f) I) := by
  let A := Localization.Away f
  let S := Submonoid.powers f
  let bR : Module.Basis Unit R R := Module.Basis.singleton Unit R
  let bA : Module.Basis Unit A (LocalizedModule S R) :=
    bR.ofIsLocalizedModule A S (LocalizedModule.mkLinearMap S R)
  let e : LocalizedModule S R ≃ₗ[A] A := bA.repr.trans (finsuppUnitEquiv A)
  let j : LocalizedModule S I →ₗ[A] A :=
    e.toLinearMap.comp (LocalizedModule.map S I.subtype)
  exact finite_of_free_injective_to_ring j fun x y hxy =>
    (LocalizedModule.map_injective S I.subtype fun a b h ↦ Subtype.ext h) (e.injective hxy)

private theorem span_initial_idempotents_not_finite :
    let R : Type u := ℕ → ULift.{u} (ZMod 2)
    let e : ℕ → R := fun n k ↦ if k < n then 1 else 0
    let I : Ideal R := Ideal.span (Set.range e)
    ¬ Module.Finite R I := by
  classical
  intro R e I
  have htail (x : R) (hx : x ∈ I) : ∃ N, ∀ k, N ≤ k → x k = 0 := by
    change x ∈ Submodule.span R (Set.range e) at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
        rcases hy with ⟨n, rfl⟩
        exact ⟨n, fun k hk => by simp [e, not_lt_of_ge hk]⟩
    | zero => exact ⟨0, fun _ _ => rfl⟩
    | add x y hx hy ihx ihy =>
        obtain ⟨N, hN⟩ := ihx
        obtain ⟨M, hM⟩ := ihy
        exact ⟨max N M, fun k hk => by
          change x k + y k = 0
          rw [hN k (le_of_max_le_left hk), hM k (le_of_max_le_right hk), add_zero]⟩
    | smul a x hx ih =>
        obtain ⟨N, hN⟩ := ih
        exact ⟨N, fun k hk => by change a k * x k = 0; rw [hN k hk, mul_zero]⟩
  intro hfin
  have hfg : (⊤ : Submodule R I).FG := Module.Finite.fg_top
  obtain ⟨s, hsfin, hs⟩ := Submodule.fg_def.mp hfg
  let bound (x : I) : ℕ := (htail (x : R) x.property).choose
  have hbound (x : I) (k : ℕ) (hk : bound x ≤ k) : (x : R) k = 0 :=
    (htail (x : R) x.property).choose_spec k hk
  let N := hsfin.toFinset.sup bound
  have hN (x : I) (hx : x ∈ s) : (x : R) N = 0 :=
    hbound x N (Finset.le_sup (hsfin.mem_toFinset.mpr hx))
  have hvanish (x : I) (hx : x ∈ Submodule.span R (s : Set I)) : (x : R) N = 0 := by
    induction hx using Submodule.span_induction with
    | mem y hy => exact hN y hy
    | zero => rfl
    | add x y _ _ ihx ihy => change (x : R) N + (y : R) N = 0; rw [ihx, ihy, add_zero]
    | smul a x _ ih => change a N * (x : R) N = 0; rw [ih, mul_zero]
  simpa [e] using hvanish ⟨e (N + 1), Ideal.subset_span ⟨N + 1, rfl⟩⟩ (hs ▸ Submodule.mem_top)

/-- **Stacks 05WJ.** Some projective ideal of a commutative ring is not locally free as a
module. -/
@[stacks 05WJ]
theorem exists_projective_ideal_not_locallyFree :
    ∃ (R : Type u) (_ : CommRing R) (I : Ideal R),
      Module.Projective R I ∧ ¬ Module.IsLocallyFree R I := by
  let R : Type u := ℕ → ULift.{u} (ZMod 2)
  let e : ℕ → R := fun n k ↦ if k < n then 1 else 0
  let I : Ideal R := Ideal.span (Set.range e)
  refine ⟨R, inferInstance, I, ?_, ?_⟩
  · refine projective_of_eq_span_countable_idempotents I (Set.range e) (Set.countable_range e)
      ?_ rfl
    rintro a ⟨n, rfl⟩
    change e n * e n = e n
    ext k
    change ULift.ringEquiv (e n k * e n k) = ULift.ringEquiv (e n k)
    rw [map_mul]
    by_cases hk : k < n <;> simp [e, hk]
  · intro hloc
    have hfinite : Module.Finite R I := by
      rcases hloc with ⟨ι, f, hcover, hfree⟩
      exact Module.Finite.of_localizationSpan (Set.range f) hcover fun g ↦ by
        obtain ⟨i, hi⟩ := g.property
        have : Module.Free (Localization.Away (f i))
            (LocalizedModule (Submonoid.powers (f i)) I) := hfree i
        rw [← hi]
        exact localized_ideal_finite_of_free I (f i)
    exact span_initial_idempotents_not_finite hfinite

end Stacks.Examples

end
