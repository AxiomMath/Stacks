module

public import Mathlib.Algebra.Field.ULift
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import StacksCore.Tactic.StacksAttribute

/-!
# The infinite union of coordinate axes, and opens that do not exist on it

Over a field `k`, let `A k` be the quotient of `k[x₀, x₁, …]` by the ideal generated by the
products `xᵢxⱼ` for `i ≠ j`: the coordinate ring of the countable union of coordinate axes
through a common origin. Its spectrum is an affine scheme which, punctured at the origin, has
no quasi-compact dense open subset.

Consequently (Stacks 086H) the complement of a closed point of an affine scheme need not contain a
quasi-compact dense open, and an affine open of an affine scheme need not have a disjoint
quasi-compact open whose union with it is dense.

## Main definitions

* `Stacks.Examples.axisRelations`: the ideal generated by the products of distinct variables.
* `Stacks.Examples.puncturedAxisRing`: the coordinate ring of the union of the axes.
* `Stacks.Examples.axisQuotientMap`: the quotient map onto that ring.
* `Stacks.Examples.axisAugmentation`: evaluation of every coordinate at zero.
* `Stacks.Examples.axisOrigin`: the point at which every coordinate vanishes.
* `Stacks.Examples.axisEvalAt`: the map onto `k[t]` restricting a function to the `i`-th axis.
* `Stacks.Examples.axisPoint`: the generic point of the `i`-th axis.

## Main results

* `Stacks.Examples.puncturedAxisRing_has_no_quasiCompact_dense_open`: the punctured spectrum
  has no quasi-compact dense open subset.
* `Stacks.Examples.exists_affine_scheme_punctured_without_quasiCompact_dense_open`: there is an
  affine scheme with a closed point whose complement has no quasi-compact dense open.
* `Stacks.Examples.exists_affineOpen_without_disjoint_quasiCompact_dense_union`: there is an
  affine scheme with an affine open having no disjoint quasi-compact open with dense union.

## References

* [Stacks Project, Tag 086H](https://stacks.math.columbia.edu/tag/086H)
-/

@[expose] public section

open AlgebraicGeometry TopologicalSpace

universe u

namespace Stacks.Examples

/-- The ideal of `k[x₀, x₁, …]` generated by the products `xᵢxⱼ` of distinct variables. -/
noncomputable def axisRelations (k : Type u) [CommRing k] : Ideal (MvPolynomial ℕ k) :=
  Ideal.span {f | ∃ i j : ℕ, i ≠ j ∧ f = MvPolynomial.X i * MvPolynomial.X j}

/-- The coordinate ring of the countable union of coordinate axes over `k`. -/
abbrev puncturedAxisRing (k : Type u) [CommRing k] :=
  MvPolynomial ℕ k ⧸ axisRelations k

/-- The quotient map of `k[x₀, x₁, …]` onto the coordinate ring of the union of the axes. -/
noncomputable abbrev axisQuotientMap (k : Type u) [CommRing k] :
    MvPolynomial ℕ k →+* puncturedAxisRing k :=
  Ideal.Quotient.mk (axisRelations k)

/-- Evaluation at the common origin of all the coordinate axes. -/
noncomputable def axisAugmentation (k : Type u) [CommRing k] : puncturedAxisRing k →+* k :=
  Ideal.Quotient.lift (axisRelations k) (MvPolynomial.eval 0) fun _f hf =>
    RingHom.mem_ker.mp (Ideal.span_le.2 (by rintro _ ⟨i, j, hij, rfl⟩; simp) hf)

/-- The point of the union of the axes at which every coordinate vanishes. -/
noncomputable def axisOrigin (k : Type u) [Field k] : PrimeSpectrum (puncturedAxisRing k) :=
  ⟨RingHom.ker (axisAugmentation k), RingHom.ker_isPrime (axisAugmentation k)⟩

/-- Evaluating all coordinates but the `i`-th at zero kills the relations between the axes. -/
theorem axisRelations_le_ker_eval (k : Type u) [Field k] (i : ℕ) :
    axisRelations k ≤ RingHom.ker (MvPolynomial.eval₂Hom (Polynomial.C (R := k))
      (fun j => if j = i then Polynomial.X else 0)) := by
  apply Ideal.span_le.2
  rintro f ⟨j, l, hjl, rfl⟩
  by_cases hji : j = i
  · by_cases hli : l = i
    · exact (hjl (hji.trans hli.symm)).elim
    · simp [hji, hli]
  · by_cases hli : l = i <;> simp [hji, hli]

/-- Restriction of a function on the union of the axes to the `i`-th axis, viewed as a ring map
to `k[t]`. -/
noncomputable def axisEvalAt (k : Type u) [Field k] (i : ℕ) :
    puncturedAxisRing k →+* Polynomial k :=
  Ideal.Quotient.lift (axisRelations k)
    (MvPolynomial.eval₂Hom (Polynomial.C (R := k))
      (fun j => if j = i then Polynomial.X else 0))
    (fun _f hf => RingHom.mem_ker.mp (axisRelations_le_ker_eval k i hf))

/-- Restricting the class of `f` to the `i`-th axis substitutes `t` for `xᵢ` and `0` for every
other variable. -/
@[simp]
theorem axisEvalAt_mk (k : Type u) [Field k] (i : ℕ) (f : MvPolynomial ℕ k) :
    axisEvalAt k i (axisQuotientMap k f) =
      MvPolynomial.eval₂Hom (Polynomial.C (R := k))
        (fun j => if j = i then Polynomial.X else 0) f :=
  Ideal.Quotient.lift_mk _ _ _

/-- The `i`-th coordinate restricts to `t` on the `i`-th axis. -/
theorem axisEvalAt_X (k : Type u) [Field k] (i : ℕ) :
    axisEvalAt k i (axisQuotientMap k (MvPolynomial.X i)) = Polynomial.X := by
  simp

/-- The augmentation of the class of `f` is the value of `f` at the origin. -/
@[simp]
theorem axisAugmentation_mk (k : Type u) [CommRing k] (f : MvPolynomial ℕ k) :
    axisAugmentation k (axisQuotientMap k f) = MvPolynomial.eval 0 f :=
  Ideal.Quotient.lift_mk _ _ _

/-- The generic point of the `i`-th coordinate axis. -/
noncomputable def axisPoint (k : Type u) [Field k] (i : ℕ) :
    PrimeSpectrum (puncturedAxisRing k) :=
  ⟨RingHom.ker (axisEvalAt k i), RingHom.ker_isPrime (axisEvalAt k i)⟩

/-- The `i`-th coordinate does not vanish at the generic point of the `i`-th axis. -/
theorem axisQuotientMap_X_notMem_axisPoint (k : Type u) [Field k] (i : ℕ) :
    axisQuotientMap k (MvPolynomial.X i) ∉ (axisPoint k i).asIdeal := by
  show axisEvalAt k i (axisQuotientMap k (MvPolynomial.X i)) ≠ 0
  rw [axisEvalAt_X]
  exact Polynomial.X_ne_zero

/-- Every coordinate vanishes at the origin. -/
theorem axisQuotientMap_X_mem_axisOrigin (k : Type u) [Field k] (i : ℕ) :
    axisQuotientMap k (MvPolynomial.X i) ∈ (axisOrigin k).asIdeal := by
  show axisAugmentation k (axisQuotientMap k (MvPolynomial.X i)) = 0
  simp

/-- The generic point of the `i`-th axis specializes to the origin. -/
theorem axisPoint_le_axisOrigin (k : Type u) [Field k] (i : ℕ) :
    axisPoint k i ≤ axisOrigin k := by
  refine (PrimeSpectrum.asIdeal_le_asIdeal _ _).mp fun a ha => ?_
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hker : MvPolynomial.eval₂Hom (Polynomial.C (R := k))
      (fun j => if j = i then Polynomial.X else 0) f = 0 :=
    (axisEvalAt_mk k i f).symm.trans (ha : axisEvalAt k i (axisQuotientMap k f) = 0)
  have hcoeff : (Polynomial.evalRingHom (0 : k)).comp (Polynomial.C (R := k)) =
      RingHom.id k := by ext a; simp
  have hvars : (fun j => Polynomial.evalRingHom (0 : k)
      (if j = i then Polynomial.X else 0)) = (0 : ℕ → k) := by
    funext j
    by_cases hji : j = i <;> simp [hji]
  have hcomp : Polynomial.evalRingHom (0 : k) (MvPolynomial.eval₂Hom (Polynomial.C (R := k))
      (fun j => if j = i then Polynomial.X else 0) f) = MvPolynomial.eval 0 f := by
    rw [MvPolynomial.map_eval₂Hom, hcoeff, hvars]
    simp
  show axisAugmentation k (axisQuotientMap k f) = 0
  rw [axisAugmentation_mk, ← hcomp, hker, map_zero]

/-- The generic point of the `i`-th axis specializes to the origin, as a point of the spectrum. -/
theorem axisPoint_specializes_axisOrigin (k : Type u) [Field k] (i : ℕ) :
    axisPoint k i ⤳ axisOrigin k :=
  (PrimeSpectrum.le_iff_specializes _ _).mp (axisPoint_le_axisOrigin k i)

/-- The generic point of the `i`-th axis lies in the locus where the `i`-th coordinate does not
vanish. -/
private theorem axisPoint_mem_basicOpen (k : Type u) [Field k] (i : ℕ) :
    axisPoint k i ∈ (PrimeSpectrum.basicOpen (axisQuotientMap k (MvPolynomial.X i)) :
      Set (PrimeSpectrum (puncturedAxisRing k))) :=
  (PrimeSpectrum.mem_basicOpen _ _).2 (axisQuotientMap_X_notMem_axisPoint k i)

/-- The locus where the `i`-th coordinate does not vanish is nonempty. -/
theorem axisBasicOpen_nonempty (k : Type u) [Field k] (i : ℕ) :
    (PrimeSpectrum.basicOpen (axisQuotientMap k (MvPolynomial.X i)) :
      Set (PrimeSpectrum (puncturedAxisRing k))).Nonempty :=
  ⟨axisPoint k i, axisPoint_mem_basicOpen k i⟩

/-- The origin lies in the closure of the locus where the `i`-th coordinate does not vanish. -/
theorem axisOrigin_mem_basicOpen_closure (k : Type u) [Field k] (i : ℕ) :
    axisOrigin k ∈ closure
      (PrimeSpectrum.basicOpen (axisQuotientMap k (MvPolynomial.X i)) :
        Set (PrimeSpectrum (puncturedAxisRing k))) := by
  exact closure_mono (Set.singleton_subset_iff.mpr (axisPoint_mem_basicOpen k i))
    ((PrimeSpectrum.le_iff_mem_closure _ _).mp (axisPoint_le_axisOrigin k i))

/-- The origin does not lie in the locus where the `i`-th coordinate does not vanish. -/
theorem axisOrigin_notMem_basicOpen (k : Type u) [Field k] (i : ℕ) :
    axisOrigin k ∉ (PrimeSpectrum.basicOpen (axisQuotientMap k (MvPolynomial.X i)) :
      Set (PrimeSpectrum (puncturedAxisRing k))) := fun h =>
  (PrimeSpectrum.mem_basicOpen _ _).mp h (axisQuotientMap_X_mem_axisOrigin k i)

/-- The product of two distinct coordinates vanishes on the union of the axes. -/
theorem axisQuotientMap_X_mul_X (k : Type u) [CommRing k] {i j : ℕ} (hij : i ≠ j) :
    axisQuotientMap k (MvPolynomial.X i) * axisQuotientMap k (MvPolynomial.X j) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, j, hij, rfl⟩)

/-- The origin of the union of the axes is a closed point. -/
theorem axisAugmentation_ker_isMaximal (k : Type u) [Field k] :
    (RingHom.ker (axisAugmentation k)).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ fun a => ⟨axisQuotientMap k (MvPolynomial.C a), by simp⟩

/-- A prime of the union of the axes other than the origin does not contain some coordinate. -/
theorem exists_axis_notMem_of_ne_axisOrigin (k : Type u) [Field k]
    (p : PrimeSpectrum (puncturedAxisRing k)) (hp : p ≠ axisOrigin k) :
    ∃ i : ℕ, axisQuotientMap k (MvPolynomial.X i) ∉ p.asIdeal := by
  by_contra! h
  have hspan : MvPolynomial.idealOfVars ℕ k ≤ Ideal.comap (axisQuotientMap k) p.asIdeal := by
    rw [show MvPolynomial.idealOfVars ℕ k =
      Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) from rfl]
    exact Ideal.span_le.2 (Set.range_subset_iff.2 h)
  have hker_le : RingHom.ker (axisAugmentation k) ≤ p.asIdeal := by
    intro a ha
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    have hf0 : MvPolynomial.constantCoeff f = 0 := by
      simpa [MvPolynomial.eval_zero] using (ha : axisAugmentation k (axisQuotientMap k f) = 0)
    have hf : f ∈ MvPolynomial.idealOfVars ℕ k := by
      rw [← pow_one (MvPolynomial.idealOfVars ℕ k), MvPolynomial.mem_pow_idealOfVars_iff']
      intro m hm
      have hm0 : Finsupp.degree m = 0 := by omega
      rw [Finsupp.degree_eq_zero_iff] at hm0
      simpa [MvPolynomial.constantCoeff_eq, hm0] using hf0
    exact (Ideal.map_le_iff_le_comap).2 hspan
      (Ideal.mem_map_of_mem (axisQuotientMap k) hf)
  exact hp (PrimeSpectrum.ext_iff.mpr
    ((axisAugmentation_ker_isMaximal k).eq_of_le p.isPrime.ne_top hker_le).symm)

/-- A prime cannot avoid two distinct coordinates, since their product vanishes. -/
private theorem false_of_notMem_axisQuotientMap_X_pair (k : Type u) [Field k]
    (p : PrimeSpectrum (puncturedAxisRing k)) {i j : ℕ} (hij : i ≠ j)
    (hi : axisQuotientMap k (MvPolynomial.X i) ∉ p.asIdeal)
    (hj : axisQuotientMap k (MvPolynomial.X j) ∉ p.asIdeal) : False :=
  (p.isPrime.mem_or_mem (axisQuotientMap_X_mul_X k hij ▸ p.asIdeal.zero_mem)).elim hi hj

/-- The complement of the origin in the spectrum of the countable union of axes contains no
quasi-compact dense open subset. -/
theorem puncturedAxisRing_has_no_quasiCompact_dense_open (k : Type u) [Field k] :
    ¬ ∃ U : Set {x : PrimeSpectrum (puncturedAxisRing k) // x ≠ axisOrigin k},
      IsOpen U ∧ IsCompact U ∧ Dense U := by
  classical
  let A := puncturedAxisRing k
  let q : MvPolynomial ℕ k →+* A := axisQuotientMap k
  let X : Type u := {x : PrimeSpectrum A // x ≠ axisOrigin k}
  let V : ℕ → Set X := fun i =>
    Subtype.val ⁻¹' (PrimeSpectrum.basicOpen (q (MvPolynomial.X i)) : Set (PrimeSpectrum A))
  have hVopen (i : ℕ) : IsOpen (V i) :=
    PrimeSpectrum.isOpen_basicOpen.preimage continuous_subtype_val
  have hVcover : (Set.univ : Set X) ⊆ ⋃ i, V i := by
    intro x _
    obtain ⟨i, hi⟩ := exists_axis_notMem_of_ne_axisOrigin k x.1 x.2
    exact Set.mem_iUnion.mpr ⟨i, (PrimeSpectrum.mem_basicOpen _ x.1).2 hi⟩
  rintro ⟨U, hUopen, hUcompact, hUdense⟩
  obtain ⟨t, ht⟩ := hUcompact.elim_finite_subcover V hVopen fun x _ =>
    hVcover (Set.mem_univ x)
  obtain ⟨n, hn⟩ := Finset.exists_nat_subset_range t
  have hVnonempty (i : ℕ) : (V i).Nonempty :=
    ⟨⟨axisPoint k i, fun hp => axisQuotientMap_X_notMem_axisPoint k i
      (hp ▸ axisQuotientMap_X_mem_axisOrigin k i)⟩, axisQuotientMap_X_notMem_axisPoint k i⟩
  obtain ⟨x, hxV, hxU⟩ := hUdense.inter_open_nonempty (V n) (hVopen n) (hVnonempty n)
  obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.mp (ht hxU)
  have hin : i < n := Finset.mem_range.mp (hn hi)
  have hi_not : q (MvPolynomial.X i) ∉ x.1.asIdeal :=
    (PrimeSpectrum.mem_basicOpen _ _).mp (by simpa [V] using hxi)
  have hn_not : q (MvPolynomial.X n) ∉ x.1.asIdeal :=
    (PrimeSpectrum.mem_basicOpen _ _).mp (by simpa [V] using hxV)
  exact false_of_notMem_axisQuotientMap_X_pair k x.1 (ne_of_lt hin) hi_not hn_not

/-- There is an affine scheme with a closed point such that its punctured complement contains no
quasi-compact dense open subset. -/
@[stacks 086H "punctured_affine"]
theorem exists_affine_scheme_punctured_without_quasiCompact_dense_open :
    ∃ (S : Scheme.{u}) (_ : IsAffine S) (s : S),
      IsClosed ({s} : Set S) ∧
        ¬ ∃ U : Set {x : S // x ≠ s}, IsOpen U ∧ IsCompact U ∧ Dense U := by
  let k := ULift.{u} ℚ
  refine ⟨Spec (.of (puncturedAxisRing k)), inferInstance, axisOrigin k, ?_,
    puncturedAxisRing_has_no_quasiCompact_dense_open k⟩
  show IsClosed ({axisOrigin k} : Set (PrimeSpectrum _))
  rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
  exact axisAugmentation_ker_isMaximal k

/-- In some affine scheme, an affine open has no disjoint quasi-compact open whose union with it
is dense. -/
@[stacks 086H "disjoint_dense_union"]
theorem exists_affineOpen_without_disjoint_quasiCompact_dense_union :
    ∃ (S : Scheme.{u}) (_ : IsAffine S) (U : S.Opens),
      IsAffineOpen U ∧
        ¬ ∃ V : S.Opens, IsCompact V.1 ∧ (U ⊓ V = ⊥) ∧ Dense (U.1 ∪ V.1) := by
  classical
  let k := ULift.{u} ℚ
  let A := puncturedAxisRing k
  let q := axisQuotientMap k
  let S := Spec (.of A)
  let x := q (MvPolynomial.X 0)
  let U : S.Opens := (PrimeSpectrum.basicOpen x : S.Opens)
  refine ⟨S, inferInstance, U, IsAffineOpen.Spec_basicOpen (R := CommRingCat.of A) x, ?_⟩
  rintro ⟨V, hVcompact, hdisj, hdense⟩
  have hxV (p : PrimeSpectrum A) (hp : p ∈ V.1) : x ∈ p.asIdeal := by
    by_contra hnot
    have hbot : p ∈ (⊥ : S.Opens) :=
      hdisj ▸ (⟨(PrimeSpectrum.mem_basicOpen _ _).2 hnot, hp⟩ : p ∈ (U ⊓ V : S.Opens))
    change p ∈ (∅ : Set (PrimeSpectrum A)) at hbot
    exact hbot.elim
  have horigin_not_V : axisOrigin k ∉ V.1 := by
    intro horigin
    have hcl : axisOrigin k ∈ closure (V.1 ∩ U.1) :=
      V.2.inter_closure ⟨horigin, axisOrigin_mem_basicOpen_closure k 0⟩
    have hempty : (V.1 : Set (PrimeSpectrum A)) ∩ U.1 = ∅ := by
      ext p
      refine ⟨fun hp => ?_, fun h => h.elim⟩
      have hbot : p ∈ (⊥ : S.Opens) := hdisj ▸ ⟨hp.2, hp.1⟩
      simp at hbot
    rw [hempty, closure_empty] at hcl
    exact hcl.elim
  have hVcover : (V.1 : Set (PrimeSpectrum A)) ⊆ ⋃ i : ℕ,
      (PrimeSpectrum.basicOpen (q (MvPolynomial.X (i + 1))) : Set (PrimeSpectrum A)) := by
    intro p hp
    obtain ⟨i, hi⟩ := exists_axis_notMem_of_ne_axisOrigin k p
      (fun heq => horigin_not_V (heq ▸ hp))
    have hne : i ≠ 0 := fun hzero => hi (hzero ▸ hxV p hp)
    obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hne
    exact Set.mem_iUnion.mpr ⟨j, (PrimeSpectrum.mem_basicOpen _ _).2 hi⟩
  obtain ⟨t, ht⟩ := hVcompact.elim_finite_subcover
    (fun i : ℕ => (PrimeSpectrum.basicOpen (q (MvPolynomial.X (i + 1))) :
      Set (PrimeSpectrum A))) (fun _ => PrimeSpectrum.isOpen_basicOpen) hVcover
  obtain ⟨n, hn⟩ := Finset.exists_nat_subset_range t
  obtain ⟨p, hpD, hpDense⟩ := hdense.inter_open_nonempty
    ((PrimeSpectrum.basicOpen (q (MvPolynomial.X (n + 1))) : Set (PrimeSpectrum A)))
    PrimeSpectrum.isOpen_basicOpen (axisBasicOpen_nonempty k (n + 1))
  have hpnotj : q (MvPolynomial.X (n + 1)) ∉ p.asIdeal :=
    (PrimeSpectrum.mem_basicOpen _ _).mp hpD
  have hnot (i : ℕ) (hi : i ≠ n + 1) (hip : q (MvPolynomial.X i) ∉ p.asIdeal) : False :=
    false_of_notMem_axisQuotientMap_X_pair k p hi hip hpnotj
  rcases hpDense with hpU | hpV
  · exact hnot 0 (by omega) ((PrimeSpectrum.mem_basicOpen _ _).mp hpU)
  · obtain ⟨i, hi, hpi⟩ := Set.mem_iUnion₂.mp (ht hpV)
    have hin : i < n := Finset.mem_range.mp (hn hi)
    exact hnot (i + 1) (by omega) ((PrimeSpectrum.mem_basicOpen _ _).mp hpi)

end Stacks.Examples

end
