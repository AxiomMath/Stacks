module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Algebra.TrivSqZeroExt.Ideal
public import Mathlib.LinearAlgebra.ExteriorAlgebra.Basis
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.LocalRing.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Flat.DirectLimit
public import StacksFrontier.RingTheory.Flat.Lazard

/-!
# A zero-dimensional local ring with a nonzero proper flat ideal

Over `𝔽₂`, let `E` be the exterior algebra on a vector space with basis `y₀, y₁, …`. It is a
commutative ring because the characteristic is `2`, every `yᵢ` squares to zero, and the ideal
generated by the `yᵢ` is the kernel of the augmentation `E → 𝔽₂`, hence the unique prime of `E`.
Let `M = colim E` be the colimit of the system whose `i`-th term is `E` and whose transition map
`i → j` is multiplication by `yᵢ ⋯ y_{j-1}`, and let `R = E ⊕ M` be the trivial square-zero
extension of `E` by `M`. Then `R` is local with a unique prime ideal, and the ideal `0 ⊕ M` of
`R` is nonzero, proper, and flat.

Flatness holds because `M`, as an `R`-module, is the colimit of the system of free modules `R`
with the same transition maps: the comparison map from that colimit to `M` is bijective, since
an element killed in `M` is killed in the colimit after one further transition, the
square-zero part being annihilated by any later product of the `yᵢ`. A colimit of free modules
is flat.

## Main results

* `Stacks.Examples.exists_local_ring_unique_prime_nonzero_flat_ideal`: the counterexample.

## Implementation notes

That the ring has exactly one prime ideal is expressed by `∃! p : Ideal R, p.IsPrime`, and
`I ≠ ⊥`, `I ≠ ⊤` say that the ideal is nonzero and proper. The ideal carries its natural
`R`-module structure, so its flatness is `Module.Flat R I`. The ring is finally transported
through `ULift` so that it can be produced in a prescribed universe; the construction itself
lives in the namespace `Stacks.Examples.ZeroDimensionalFlatIdeal`.

## References

* [Stacks Project, Tag 05G0](https://stacks.math.columbia.edu/tag/05G0)
-/

@[expose] public section

universe u

namespace Stacks.Examples.ZeroDimensionalFlatIdeal


noncomputable section

private abbrev K := ZMod 2

private instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

private abbrev V := ℕ →₀ K

private abbrev E := ExteriorAlgebra K V

private def v (i : ℕ) : V := Finsupp.single i 1

private theorem neg_eq_self (a : E) : -a = a := by
  apply (eq_neg_of_add_eq_zero_left ?_).symm
  have h2 : (2 : E) = 0 := by
    calc
      (2 : E) = algebraMap K E (2 : K) := (map_natCast (algebraMap K E) 2).symm
      _ = 0 := by rw [show (2 : K) = 0 by decide, map_zero]
  rw [← two_mul, h2, zero_mul]

private instance : CommRing E where
  mul_comm := by
    intro a b
    induction a using CliffordAlgebra.induction with
    | algebraMap r => exact Algebra.commutes r b
    | ι z =>
      induction b using CliffordAlgebra.induction with
      | algebraMap r => exact (Algebra.commutes r (CliffordAlgebra.ι 0 z)).symm
      | ι w =>
        calc
          CliffordAlgebra.ι 0 z * CliffordAlgebra.ι 0 w =
              -(CliffordAlgebra.ι 0 w * CliffordAlgebra.ι 0 z) := by
                rw [CliffordAlgebra.ι_mul_ι_comm]
                simp [QuadraticMap.polar]
          _ = CliffordAlgebra.ι 0 w * CliffordAlgebra.ι 0 z := neg_eq_self _
      | mul b₁ b₂ hb₁ hb₂ =>
        calc
          CliffordAlgebra.ι 0 z * (b₁ * b₂) =
              (CliffordAlgebra.ι 0 z * b₁) * b₂ := by simp [mul_assoc]
          _ = (b₁ * CliffordAlgebra.ι 0 z) * b₂ := by rw [hb₁]
          _ = b₁ * (CliffordAlgebra.ι 0 z * b₂) := by simp [mul_assoc]
          _ = b₁ * (b₂ * CliffordAlgebra.ι 0 z) := by rw [hb₂]
          _ = (b₁ * b₂) * CliffordAlgebra.ι 0 z := by rw [mul_assoc]
      | add b₁ b₂ hb₁ hb₂ =>
        simp only [mul_add, add_mul, hb₁, hb₂]
    | mul a₁ a₂ ha₁ ha₂ =>
      calc
        (a₁ * a₂) * b = a₁ * (a₂ * b) := by simp [mul_assoc]
        _ = a₁ * (b * a₂) := by rw [ha₂]
        _ = (a₁ * b) * a₂ := by simp [mul_assoc]
        _ = (b * a₁) * a₂ := by rw [ha₁]
        _ = b * (a₁ * a₂) := by simp [mul_assoc]
    | add a₁ a₂ ha₁ ha₂ =>
      simp only [add_mul, mul_add, ha₁, ha₂]

private noncomputable def basisV : Module.Basis ℕ K V := Finsupp.basisSingleOne

private noncomputable def basisE : Module.Basis (Finset ℕ) K E := basisV.ExteriorAlgebra

private def y (i : ℕ) : E := basisE {i}

private theorem y_eq_ι (i : ℕ) : y i = ExteriorAlgebra.ι K (v i) := by
  change basisV.ExteriorAlgebra (Set.powersetCard.ofSingleton i).val =
    ExteriorAlgebra.ι K (v i)
  rw [ExteriorAlgebra.basis_apply_powersetCard]
  have hidx : (Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.ofSingleton i) 0) = i := by
    rw [Set.powersetCard.ofFinEmbEquiv_symm_apply]
    exact Finset.orderEmbOfFin_singleton i 0
  simp [basisV, v, Finsupp.basisSingleOne, ExteriorAlgebra.ιMulti_family,
    ExteriorAlgebra.ιMulti_succ_apply, ExteriorAlgebra.ιMulti_zero_apply,
    hidx]

private theorem prod_y_eq_basis (s : Finset ℕ) : (∏ i ∈ s, y i) = basisE s := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [basisE, Module.Basis.ExteriorAlgebra]
  | @insert a s ha ih =>
    rw [Finset.prod_insert ha, ih]
    change basisV.ExteriorAlgebra {a} * basisV.ExteriorAlgebra s =
      basisV.ExteriorAlgebra (insert a s)
    let ss : Set.powersetCard ℕ 1 := ⟨{a}, by simp⟩
    let tt : Set.powersetCard ℕ s.card := ⟨s, rfl⟩
    have hdisj' : Disjoint ss.val tt.val := Finset.disjoint_singleton_left.mpr ha
    have hmul' : basisV.ExteriorAlgebra {a} * basisV.ExteriorAlgebra s =
        (Equiv.Perm.sign (Set.powersetCard.permOfDisjoint hdisj')) •
          basisV.ExteriorAlgebra (insert a s) := by
      simpa [ss, tt] using ExteriorAlgebra.basis_mul_of_disjoint (b := basisV) (s := ss) (t := tt)
        hdisj'
    rcases Int.units_eq_one_or (Set.powersetCard.permOfDisjoint hdisj').sign with hs | hs
    · simpa [hs] using hmul'
    · simpa [hs, neg_eq_self] using hmul'

private def p (i j : ℕ) : E := ∏ k ∈ Finset.Ico i j, y k

private theorem p_eq_basis (i j : ℕ) : p i j = basisE (Finset.Ico i j) :=
  prod_y_eq_basis _

private theorem p_self (i : ℕ) : p i i = 1 := by
  simp [p]

private theorem p_consecutive {i j k : ℕ} (hij : i ≤ j) (hjk : j ≤ k) :
    p i j * p j k = p i k :=
  Finset.prod_Ico_consecutive y hij hjk

private theorem p_ne_zero (i j : ℕ) : p i j ≠ 0 := by
  rw [p_eq_basis]
  exact basisE.ne_zero _

private theorem p_overlap_zero {i t k : ℕ} (hik : i < k) (htk : t < k) :
    p i k * p t k = 0 := by
  rw [p_eq_basis, p_eq_basis]
  have hnd : ¬ Disjoint (Finset.Ico i k) (Finset.Ico t k) :=
    Finset.not_disjoint_iff.2 ⟨max i t, Finset.mem_Ico.2 ⟨le_max_left _ _, max_lt hik htk⟩,
      Finset.mem_Ico.2 ⟨le_max_right _ _, max_lt hik htk⟩⟩
  let si : Set.powersetCard ℕ (Finset.Ico i k).card := ⟨Finset.Ico i k, rfl⟩
  let st : Set.powersetCard ℕ (Finset.Ico t k).card := ⟨Finset.Ico t k, rfl⟩
  simpa [basisE] using ExteriorAlgebra.basis_mul_of_not_disjoint (b := basisV) (s := si) (t := st)
    hnd

private theorem y_sq (i : ℕ) : y i * y i = 0 := by
  simpa [p] using p_overlap_zero (Nat.lt_succ_self i) (Nat.lt_succ_self i)

private def emap (i j : ℕ) (_h : i ≤ j) : E →ₗ[E] E := LinearMap.mulLeft E (p i j)

private instance : DirectedSystem (fun _ : ℕ => E) (fun i j h => emap i j h) where
  map_self := by
    intro i x
    simp [emap, p_self]
  map_map := by
    intro k j i hij hjk x
    simp only [emap, LinearMap.mulLeft_apply]
    rw [← mul_assoc, mul_comm (p j k) (p i j), p_consecutive hij hjk]

private abbrev M := Module.DirectLimit (fun _ : ℕ => E) (fun i j h => emap i j h)

private def aug : E →ₐ[K] K :=
  ExteriorAlgebra.lift K ⟨0, by intro; simp⟩

private theorem aug_y (i : ℕ) : aug (y i) = 0 := by
  rw [y_eq_ι]
  simp [aug]

private def J : Ideal E := Ideal.span (Set.range y)

private theorem ι_mem_J (z : V) : ExteriorAlgebra.ι K z ∈ J := by
  have hmap : Submodule.map (ExteriorAlgebra.ι K)
      (Submodule.span K (Set.range basisV)) ≤ J.restrictScalars K := by
    rw [Submodule.map_span]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    change ExteriorAlgebra.ι K (v j) ∈ J
    rw [← y_eq_ι j]
    exact Ideal.subset_span ⟨j, rfl⟩
  exact hmap (Submodule.mem_map_of_mem (basisV.mem_span z))

private theorem sub_aug_mem_J (a : E) : a - algebraMap K E (aug a) ∈ J := by
  induction a using CliffordAlgebra.induction with
  | algebraMap r => simp [aug]
  | ι z => simpa [aug] using ι_mem_J z
  | mul a b ha hb =>
    have hid : a * b - algebraMap K E (aug (a * b)) =
        (a - algebraMap K E (aug a)) * b +
          algebraMap K E (aug a) * (b - algebraMap K E (aug b)) := by
      simp only [map_mul, Algebra.algebraMap_eq_smul_one]
      ring
    rw [hid]
    exact J.add_mem (J.mul_mem_right b ha) (J.mul_mem_left _ hb)
  | add a b ha hb =>
    rw [map_add, map_add, add_sub_add_comm]
    exact J.add_mem ha hb

private theorem ker_aug_eq_J : RingHom.ker aug = J :=
  le_antisymm (fun a ha => by simpa [RingHom.mem_ker.mp ha] using sub_aug_mem_J a)
    (Ideal.span_le.2 (Set.range_subset_iff.2 aug_y))

private abbrev R := TrivSqZeroExt E M

private instance : Module Eᵐᵒᵖ M :=
  Module.compHom M <| RingHom.fromOpposite (RingHom.id E)
    (fun _ _ => Commute.all _ _)

private instance : IsCentralScalar E M := ⟨by
  intro a m
  rfl⟩

private instance : Module R M :=
  Module.compHom M (TrivSqZeroExt.fstHom E E M).toRingHom

private def rho : R →+* K :=
  aug.toRingHom.comp (TrivSqZeroExt.fstHom E E M).toRingHom

private def mIdeal : Ideal R := RingHom.ker rho

private theorem rho_surjective : Function.Surjective rho := fun k =>
  ⟨TrivSqZeroExt.inl (algebraMap K E k), by simp [rho, aug]⟩

private theorem mIdeal_le_prime {P : Ideal R} (hP : P.IsPrime) : mIdeal ≤ P := by
  intro x hx
  have hbase : x.fst ∈ J := by
    rw [← ker_aug_eq_J]
    exact hx
  have hinl : TrivSqZeroExt.inl x.fst ∈ P := by
    have hmap : Ideal.map (TrivSqZeroExt.inlHom E M) J ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      apply Ideal.span_le.2
      rintro _ ⟨i, rfl⟩
      apply hP.mem_of_pow_mem 2
      simpa only [pow_two, ← map_mul, y_sq, map_zero] using P.zero_mem
    exact hmap (Ideal.mem_map_of_mem (TrivSqZeroExt.inlHom E M) hbase)
  have hinr : TrivSqZeroExt.inr x.snd ∈ P := by
    apply hP.mem_of_pow_mem 2
    simpa only [pow_two, TrivSqZeroExt.inr_mul_inr] using P.zero_mem
  rw [← TrivSqZeroExt.inl_fst_add_inr_snd_eq x]
  exact P.add_mem hinl hinr

/-- The kernel of `rho` is a maximal ideal of `R`. -/
private theorem mIdeal_isMaximal : mIdeal.IsMaximal :=
  RingHom.ker_isMaximal_of_surjective rho rho_surjective

private theorem mIdeal_unique_prime : ∃! P : Ideal R, P.IsPrime :=
  ⟨mIdeal, mIdeal_isMaximal.isPrime, fun _ hP =>
    (mIdeal_isMaximal.eq_of_le hP.ne_top (mIdeal_le_prime hP)).symm⟩

private theorem existsUnique_maximal_ideal : ∃! P : Ideal R, P.IsMaximal :=
  ⟨mIdeal, mIdeal_isMaximal, fun _ hP =>
    mIdeal_unique_prime.unique hP.isPrime mIdeal_isMaximal.isPrime⟩

private instance : IsLocalRing R := IsLocalRing.of_unique_max_ideal existsUnique_maximal_ideal

private def q (i j : ℕ) (_h : i ≤ j) : R →ₗ[R] R :=
  LinearMap.mulLeft R (TrivSqZeroExt.inl (p i j))

private instance : DirectedSystem (fun _ : ℕ => R) (fun i j h => q i j h) where
  map_self := by
    intro i x
    simp [q, p_self]
  map_map := by
    intro k j i hij hjk x
    simp only [q, LinearMap.mulLeft_apply]
    rw [← mul_assoc, ← TrivSqZeroExt.inl_mul, mul_comm (p j k) (p i j), p_consecutive hij hjk]

private abbrev N := Module.DirectLimit (fun _ : ℕ => R) (fun i j h => q i j h)

private def g (i : ℕ) : R →ₗ[R] M where
  toFun x := Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) i x.fst
  map_add' x y := by simp
  map_smul' r x := by
    change Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) i
        (TrivSqZeroExt.fst (r * x)) = TrivSqZeroExt.fst r •
          Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) i x.fst
    simp only [TrivSqZeroExt.fst_mul]
    rw [← (Module.DirectLimit.of E ℕ (fun _ : ℕ => E)
      (fun i j h => emap i j h) i).map_smul]
    rfl

private theorem g_compatible (i j : ℕ) (h : i ≤ j) (x : R) :
    g j (q i j h x) = g i x := by
  change Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) j
      (p i j * x.fst) = Module.DirectLimit.of E ℕ (fun _ : ℕ => E)
        (fun i j h => emap i j h) i x.fst
  rw [show p i j * x.fst = emap i j h x.fst by rfl]
  exact Module.DirectLimit.of_f

private def toM : N →ₗ[R] M :=
  Module.DirectLimit.lift R ℕ (fun _ : ℕ => R) (fun i j h => q i j h) g g_compatible

private theorem p_action_eventually_zero (j t : ℕ) (c : E) :
    p j (max j t + 1) • Module.DirectLimit.of E ℕ (fun _ : ℕ => E)
      (fun i j h => emap i j h) t c = 0 := by
  let k := max j t + 1
  have hjk' : j < k := Nat.lt_succ_of_le (le_max_left _ _)
  have htk' : t < k := Nat.lt_succ_of_le (le_max_right _ _)
  have htk : t ≤ k := htk'.le
  rw [← Module.DirectLimit.of_f (R := E) (ι := ℕ) (G := fun _ : ℕ => E)
    (f := fun i j h => emap i j h) (hij := htk) (x := c),
    ← (Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) k).map_smul]
  change Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) k
      (p j k * (p t k * c)) = 0
  rw [← mul_assoc, p_overlap_zero hjk' htk']
  simp

private theorem toM_surjective : Function.Surjective toM := by
  intro z
  obtain ⟨i, x, rfl⟩ := Module.DirectLimit.exists_of z
  refine ⟨Module.DirectLimit.of R ℕ (fun _ : ℕ => R) (fun i j h => q i j h) i
    (TrivSqZeroExt.inl x), ?_⟩
  simp [toM, g]

private theorem toM_zero (z : N) (hz : toM z = 0) : z = 0 := by
  obtain ⟨i, x, hx⟩ := Module.DirectLimit.exists_of z
  rw [← hx] at hz
  have hzero : Module.DirectLimit.of E ℕ (fun _ : ℕ => E)
      (fun i j h => emap i j h) i x.fst = 0 := by
    simpa [toM, g] using hz
  obtain ⟨j, hij, hfirst⟩ :=
    Module.DirectLimit.of.zero_exact (R := E) (ι := ℕ) (G := fun _ : ℕ => E)
      (f := fun i j h => emap i j h) hzero
  let b := (q i j hij x).snd
  have hq : q i j hij x = TrivSqZeroExt.inr b := TrivSqZeroExt.ext hfirst rfl
  obtain ⟨t, c, hbc⟩ := Module.DirectLimit.exists_of b
  let k := max j t + 1
  have hjk : j ≤ k := le_trans (le_max_left _ _) (Nat.le_succ _)
  have hkill' : p j k • b = 0 := by
    rw [← hbc]
    simpa [k] using p_action_eventually_zero j t c
  have hnext : q j k hjk (q i j hij x) = 0 := by
    rw [hq]
    simp [q, TrivSqZeroExt.inl_mul_inr, hkill']
  calc
    z = Module.DirectLimit.of R ℕ (fun _ : ℕ => R) (fun i j h => q i j h) i x := hx.symm
    _ = Module.DirectLimit.of R ℕ (fun _ : ℕ => R) (fun i j h => q i j h) j
          (q i j hij x) := (Module.DirectLimit.of_f).symm
    _ = Module.DirectLimit.of R ℕ (fun _ : ℕ => R) (fun i j h => q i j h) k
          (q j k hjk (q i j hij x)) := (Module.DirectLimit.of_f).symm
    _ = 0 := by rw [hnext, map_zero]

private theorem toM_injective : Function.Injective toM := fun z w hzw =>
  sub_eq_zero.mp (toM_zero (z - w) (by rw [map_sub, hzw, sub_self]))

private theorem flat_M : Module.Flat R M := by
  have : Module.Flat R N := Module.Flat.directLimit (R := R) (G := fun _ : ℕ => R) (f := q)
  exact Module.Flat.of_linearEquiv
    (LinearEquiv.ofBijective toM ⟨toM_injective, toM_surjective⟩).symm

private abbrev I := TrivSqZeroExt.kerIdeal E M

private def kerToM : I →ₗ[R] M where
  toFun x := x.val.snd
  map_add' x y := rfl
  map_smul' r x := by
    have hx : x.val.fst = 0 := by
      change TrivSqZeroExt.fstHom E E M x.val = 0
      exact x.property
    change (r * x.val).snd = TrivSqZeroExt.fst r • x.val.snd
    rw [TrivSqZeroExt.snd_mul]
    simp [hx]

private theorem kerToM_injective : Function.Injective kerToM := by
  intro x y hxy
  apply Subtype.ext
  apply TrivSqZeroExt.ext
  · have hx := (TrivSqZeroExt.mem_kerIdeal_iff_inr E M x.val).mp x.property
    have hy := (TrivSqZeroExt.mem_kerIdeal_iff_inr E M y.val).mp y.property
    rw [hx, hy]
    simp
  · exact hxy

private theorem kerToM_surjective : Function.Surjective kerToM := fun m =>
  ⟨⟨TrivSqZeroExt.inr m, by simp [I, TrivSqZeroExt.kerIdeal]⟩, rfl⟩

private noncomputable def kerEquivM : I ≃ₗ[R] M :=
  LinearEquiv.ofBijective kerToM ⟨kerToM_injective, kerToM_surjective⟩

private def m0 : M :=
  Module.DirectLimit.of E ℕ (fun _ : ℕ => E) (fun i j h => emap i j h) 0 1

private theorem m0_ne_zero : m0 ≠ 0 := by
  intro hm
  obtain ⟨j, h0j, hz⟩ := Module.DirectLimit.of.zero_exact
    (R := E) (ι := ℕ) (G := fun _ : ℕ => E) (f := fun i j h => emap i j h) hm
  have hp : p 0 j = 0 := by
    simpa [m0, emap, LinearMap.mulLeft_apply] using hz
  exact p_ne_zero 0 j hp

private theorem ideal_ne_bot : I ≠ ⊥ := by
  intro hI
  have hmem : (TrivSqZeroExt.inr m0 : R) ∈ I := by
    simp [I, TrivSqZeroExt.kerIdeal]
  have heq : (TrivSqZeroExt.inr m0 : R) = 0 := by
    simpa [hI] using hmem
  exact m0_ne_zero (TrivSqZeroExt.inr_injective heq)

private theorem ideal_ne_top : I ≠ ⊤ := by
  intro hI
  have hone : (1 : R) ∈ I := by simp [hI]
  change TrivSqZeroExt.fstHom E E M (1 : R) = 0 at hone
  simp at hone

private theorem ideal_flat : Module.Flat R I := by
  have : Module.Flat R M := flat_M
  exact Module.Flat.of_linearEquiv kerEquivM

private abbrev S := ULift.{u} R

private noncomputable def eS : S ≃+* R := ULift.ringEquiv

private def liftedI : Ideal S := I.comap eS

private theorem lifted_unique_prime : ∃! P : Ideal S, P.IsPrime := by
  have : mIdeal.IsPrime := mIdeal_isMaximal.isPrime
  refine ⟨mIdeal.comap eS, inferInstance, fun P hP => ?_⟩
  have hmap : (P.map eS).IsPrime := inferInstance
  have heq : P.map eS = mIdeal := mIdeal_unique_prime.unique hmap mIdeal_isMaximal.isPrime
  rw [← heq]
  exact (Ideal.comap_map_of_bijective eS.toRingHom eS.bijective).symm

private theorem lifted_unique_maximal : ∃! P : Ideal S, P.IsMaximal :=
  ⟨mIdeal.comap eS, mIdeal_isMaximal.comap_bijective eS.toRingHom eS.bijective, fun _ hP =>
    lifted_unique_prime.unique hP.isPrime (by have := mIdeal_isMaximal.isPrime; infer_instance)⟩

private instance : IsLocalRing S := IsLocalRing.of_unique_max_ideal lifted_unique_maximal

private def liftedIdealEquiv : liftedI ≃ₗ[S] ULift.{u} I where
  toFun x := ULift.up ⟨x.val.down, x.property⟩
  invFun x := ⟨ULift.up x.down.val, by
    change x.down.val ∈ I
    exact x.down.property⟩
  left_inv x := by apply Subtype.ext; rfl
  right_inv x := by apply ULift.ext; apply Subtype.ext; rfl
  map_add' x y := by apply ULift.ext; apply Subtype.ext; rfl
  map_smul' r x := by apply ULift.ext; apply Subtype.ext; rfl

private theorem lifted_ideal_ne_bot : liftedI ≠ ⊥ := fun hI =>
  ideal_ne_bot <| Ideal.comap_injective_of_surjective eS.toRingHom eS.surjective
    (hI.trans (Ideal.comap_bot_of_injective _ eS.injective).symm)

private theorem lifted_ideal_ne_top : liftedI ≠ ⊤ := fun hI =>
  ideal_ne_top <| Ideal.comap_injective_of_surjective eS.toRingHom eS.surjective
    (hI.trans Ideal.comap_top.symm)

end
end Stacks.Examples.ZeroDimensionalFlatIdeal

namespace Stacks.Examples

open ZeroDimensionalFlatIdeal

/-- **Stacks 05G0.** There is a local ring with a unique prime ideal and a nonzero proper
flat ideal. -/
@[stacks 05G0]
theorem exists_local_ring_unique_prime_nonzero_flat_ideal :
    ∃ (R : Type u) (_ : CommRing R) (_ : IsLocalRing R) (I : Ideal R),
      (∃! p : Ideal R, p.IsPrime) ∧ I ≠ ⊥ ∧ I ≠ ⊤ ∧ Module.Flat R I := by
  refine ⟨S, inferInstance, inferInstance, liftedI, lifted_unique_prime, lifted_ideal_ne_bot,
    lifted_ideal_ne_top, ?_⟩
  have : Module.Flat S (ULift.{u} I) :=
    (Module.Flat.ulift_left_iff (R := R) (M := ULift.{u} I)).mpr
      ((Module.Flat.ulift_right_iff (R := R) (M := I)).mpr ideal_flat)
  exact Module.Flat.of_linearEquiv (R := S) (M := ULift.{u} I) liftedIdealEquiv

end Stacks.Examples

