/-!
# A scheme with Noetherian underlying space whose ring is not Noetherian

Let `k` be a field and let `S k` be the polynomial algebra `k[x₀, x₁, …]` in countably many
variables modulo the ideal generated by the squares of the variables. Its spectrum is a single
point, hence a Noetherian topological space, while the ring itself is not Noetherian: the ideal
generated by the images of the variables is its unique prime ideal and is not finitely
generated.

The single point is produced by showing that the variable ideal is the kernel of the
augmentation `S k → k`, hence maximal, and that it is contained in every prime because each
variable squares to zero. Failure of finite generation is detected by the algebra maps
`S k → k ⊕ k·ε` that send one chosen variable to `ε` and all others to `0`: a finite generating
set involves only finitely many variables, so some variable escapes all of them and is detected
by a map killing the whole generating set.

## Main definitions

* `Stacks.Examples.infiniteSquareZeroVariable`: the image of a variable in `S k`.
* `Stacks.Examples.infiniteSquareZeroVariableIdeal`: the ideal generated by these images.

## Main results

* `Stacks.Examples.isPrime_iff_eq_infiniteSquareZeroVariableIdeal`: the variable ideal is the
  unique prime ideal of `S k`.
* `Stacks.Examples.uniquePrimeSpectrum`: the spectrum of `S k` is a single point.
* `Stacks.Examples.noetherianSpace_primeSpectrum`: that spectrum is a Noetherian space.
* `Stacks.Examples.infiniteSquareZeroVariableIdeal_not_fg`: the variable ideal is not finitely
  generated, so `S k` is not Noetherian.

## Implementation notes

The ring `S k`, its defining ideal `sqIdeal k` and the augmentation `aug k` are the ones
introduced for the associated-primes counterexample of Stacks 05BX; they are reused here rather
than redefined. The variables are indexed by `ℕ` starting at zero.

## References

* [Stacks Project, Tag 0G62](https://stacks.math.columbia.edu/tag/0G62)
-/

@[expose] public section

namespace Stacks.Examples

/-- The image of the `i`-th variable in `S k = k[x₀, x₁, …]/(x₀², x₁², …)`. -/
noncomputable abbrev infiniteSquareZeroVariable (k : Type*) [Field k] (i : ℕ) : S k :=
  Ideal.Quotient.mk (sqIdeal k) (MvPolynomial.X i)

/-- The ideal of `S k = k[x₀, x₁, …]/(x₀², x₁², …)` generated by all the variables. -/
noncomputable abbrev infiniteSquareZeroVariableIdeal (k : Type*) [Field k] : Ideal (S k) :=
  Ideal.span (Set.range (infiniteSquareZeroVariable k))

private theorem sub_constant_mem_span_X {k : Type*} [CommRing k] (f : MvPolynomial ℕ k) :
    f - MvPolynomial.C (MvPolynomial.constantCoeff f) ∈
      Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add f g hf hg =>
      convert Ideal.add_mem _ hf hg using 1
      simp only [map_add]
      ring
  | mul_X f i hf =>
      rw [show MvPolynomial.constantCoeff (f * MvPolynomial.X i) = 0 by simp]
      simpa only [map_zero, sub_zero, mul_comm] using
        Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self i))

private theorem variableIdeal_le_ker_aug (k : Type*) [Field k] :
    infiniteSquareZeroVariableIdeal k ≤ RingHom.ker (aug k).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  change aug k (Ideal.Quotient.mk (sqIdeal k) (MvPolynomial.X i)) = 0
  simp [aug]

private theorem infiniteSquareZeroVariableIdeal_eq_ker_aug (k : Type*) [Field k] :
    infiniteSquareZeroVariableIdeal k = RingHom.ker (aug k).toRingHom := by
  let q : MvPolynomial ℕ k →+* S k := Ideal.Quotient.mk (sqIdeal k)
  refine le_antisymm (variableIdeal_le_ker_aug k) fun s hs => ?_
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective s
  change aug k (q f) = 0 at hs
  change q f ∈ Ideal.span (Set.range fun i : ℕ => q (MvPolynomial.X i))
  have hconst : MvPolynomial.constantCoeff f = 0 := by
    simpa [q, aug] using hs
  have hmap := Ideal.mem_map_of_mem q (sub_constant_mem_span_X f)
  rw [Ideal.map_span] at hmap
  have hrange : (⇑q '' Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) =
      Set.range (fun i : ℕ => q (MvPolynomial.X i)) := by
    ext x
    simp
  rw [hrange] at hmap
  simpa [hconst] using hmap

private theorem infiniteSquareZeroVariableIdeal_isMaximal (k : Type*) [Field k] :
    (infiniteSquareZeroVariableIdeal k).IsMaximal := by
  rw [infiniteSquareZeroVariableIdeal_eq_ker_aug]
  exact RingHom.ker_isMaximal_of_surjective _ fun a => ⟨algebraMap k (S k) a, by simp [aug]⟩

/-- **Stacks 0G62.** The ideal generated by the square-zero variables is the unique prime ideal
of `S k = k[x₀, x₁, …]/(x₀², x₁², …)`. -/
@[stacks 0G62 "unique_prime"]
theorem isPrime_iff_eq_infiniteSquareZeroVariableIdeal (k : Type*) [Field k]
    (P : Ideal (S k)) : P.IsPrime ↔ P = infiniteSquareZeroVariableIdeal k := by
  refine ⟨fun hP => ((infiniteSquareZeroVariableIdeal_isMaximal k).eq_of_le hP.ne_top
    (Ideal.span_le.mpr ?_)).symm, ?_⟩
  · rintro x ⟨i, rfl⟩
    exact hP.mem_of_pow_mem 2 (by simp [Stacks.SquareZero.squareZero_generator k i])
  · rintro rfl
    exact (infiniteSquareZeroVariableIdeal_isMaximal k).isPrime

/-- **Stacks 0G62.** The spectrum of `S k = k[x₀, x₁, …]/(x₀², x₁², …)` has exactly one
point. -/
@[stacks 0G62 "singleton_spectrum"]
noncomputable instance uniquePrimeSpectrum (k : Type*) [Field k] :
    Unique (PrimeSpectrum (S k)) :=
  ⟨⟨_, (isPrime_iff_eq_infiniteSquareZeroVariableIdeal k _).2 rfl⟩, fun x =>
    PrimeSpectrum.ext
      ((isPrime_iff_eq_infiniteSquareZeroVariableIdeal k x.asIdeal).1 x.isPrime)⟩

/-- **Stacks 0G62.** The spectrum of `S k = k[x₀, x₁, …]/(x₀², x₁², …)` is a Noetherian
topological space. -/
@[stacks 0G62 "noetherian_underlying_space"]
noncomputable instance noetherianSpace_primeSpectrum (k : Type*) [Field k] :
    TopologicalSpace.NoetherianSpace (PrimeSpectrum (S k)) := inferInstance

private noncomputable def detectVariable (k : Type*) [Field k] (i : ℕ) :
    S k →+* TrivSqZeroExt k k := by
  let f : MvPolynomial ℕ k →ₐ[k] TrivSqZeroExt k k :=
    MvPolynomial.aeval (fun j => if j = i then TrivSqZeroExt.inr (1 : k) else 0)
  have hsq : sqIdeal k ≤ RingHom.ker f.toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change f ((MvPolynomial.X j : MvPolynomial ℕ k) ^ 2) = 0
    rw [map_pow]
    by_cases hj : j = i
    · subst j
      simp [f, pow_two, TrivSqZeroExt.inr_mul_inr]
    · simp [f, hj]
  exact Ideal.Quotient.lift (sqIdeal k) f.toRingHom (fun x hx => hsq hx)

/-- **Stacks 0G62.** The ideal generated by the variables of
`S k = k[x₀, x₁, …]/(x₀², x₁², …)` is not finitely generated; in particular `S k` is not a
Noetherian ring even though its spectrum is a Noetherian space. -/
@[stacks 0G62 "prime_not_finitely_generated"]
theorem infiniteSquareZeroVariableIdeal_not_fg (k : Type*) [Field k] :
    ¬ (infiniteSquareZeroVariableIdeal k).FG := by
  rintro ⟨s, hs⟩
  let rep : S k → MvPolynomial ℕ k := fun x =>
    Classical.choose (Ideal.Quotient.mk_surjective x)
  have hrep (x : S k) : Ideal.Quotient.mk (sqIdeal k) (rep x) = x :=
    Classical.choose_spec (Ideal.Quotient.mk_surjective x)
  let vars : Finset ℕ := s.biUnion fun x => (rep x).vars
  obtain ⟨i, hi⟩ := Infinite.exists_notMem_finset vars
  let ψ := detectVariable k i
  have hgenzero (x : S k) (hx : x ∈ s) : ψ x = 0 := by
    have hxI : x ∈ infiniteSquareZeroVariableIdeal k := hs ▸ Ideal.subset_span hx
    have haug := variableIdeal_le_ker_aug k hxI
    have hconst : MvPolynomial.constantCoeff (rep x) = 0 := by
      rw [← hrep x] at haug
      simpa [aug] using haug
    have hnot : i ∉ (rep x).vars := fun hit => hi (Finset.mem_biUnion.mpr ⟨x, hx, hit⟩)
    rw [← hrep x]
    change MvPolynomial.aeval (fun j => if j = i then TrivSqZeroExt.inr (1 : k) else 0) (rep x) = 0
    rw [MvPolynomial.aeval_eq_constantCoeff_of_vars]
    · simp [hconst]
    · intro j hj
      simp [ne_of_mem_of_not_mem hj hnot]
  have hle : Ideal.span (s : Set (S k)) ≤ RingHom.ker ψ := Ideal.span_le.mpr hgenzero
  have hzero : ψ (infiniteSquareZeroVariable k i) = 0 := hle (hs ▸ Ideal.subset_span ⟨i, rfl⟩)
  have hdetect : ψ (infiniteSquareZeroVariable k i) = TrivSqZeroExt.inr (1 : k) := by
    change detectVariable k i (Ideal.Quotient.mk (sqIdeal k) (MvPolynomial.X i)) = _
    simp [detectVariable]
  have hne : (TrivSqZeroExt.inr (1 : k) : TrivSqZeroExt k k) ≠ 0 := by
    simpa [← TrivSqZeroExt.inr_zero] using
      (TrivSqZeroExt.inr_injective.ne (one_ne_zero : (1 : k) ≠ 0))
  exact hne (hdetect.symm.trans hzero)

end Stacks.Examples

end
