module

public import Mathlib.RingTheory.Ideal.Int
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.PrincipalIdealDomain
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Algebra.Module.Projective.Invertible

/-!
# A locally principal ideal which is not invertible

Let `A ⊂ ℚ[x]` be the `ℤ`-subalgebra generated by the elements `x/p` for `p` running over the
prime numbers, and let `I ⊆ A` be the ideal they generate. Then `I` is nonzero and its extension
to every localization of `A` at a prime ideal is principal, yet `I` is not an invertible
`A`-module.

Principality after localization holds because `p · (x/p) = q · (x/q) = x` for all primes `p, q`:
a prime ideal of `A` contains at most one rational prime, so for any other prime `q` the integer
`q` becomes a unit in the localization and `x/q` becomes a multiple of the chosen generator.
Non-invertibility follows from the fact that an invertible module is finitely generated: the
coefficient of `x` of an element of `I` is a `ℤ`-linear combination of those of any generating
family, so the denominators appearing are bounded, while `x/p` has denominator `p` for every
prime `p`.

## Main results

* `Stacks.Examples.exists_locally_principal_ideal_not_invertible`: the counterexample.

## Implementation notes

The localization of the ideal at a prime is its image under the canonical map to
`Localization.AtPrime`. Invertibility is `Module.Invertible` over the original ring, not merely
principality at every prime. The ring is wrapped in `ULift` so that it can be produced in any
universe.

## References

* [Stacks Project, Tag 0CC0](https://stacks.math.columbia.edu/tag/0CC0)
-/

@[expose] public section

namespace Stacks.Examples

private abbrev PrimeIndex := {n : ℕ // Nat.Prime n}

private noncomputable def scaledVariable (p : PrimeIndex) : Polynomial ℚ :=
  Polynomial.C ((p.1 : ℚ)⁻¹) * Polynomial.X

private noncomputable def scaledVariableSubalgebra : Subalgebra ℤ (Polynomial ℚ) :=
  Algebra.adjoin ℤ (Set.range scaledVariable)

private noncomputable abbrev ScaledVariableRing.{u} := ULift.{u} (↥scaledVariableSubalgebra)

private instance scaledVariableRingDomain.{u} : IsDomain (ScaledVariableRing.{u}) := by
  let : NoZeroDivisors (ScaledVariableRing.{u}) :=
    Function.Injective.noZeroDivisors
      (fun x : ScaledVariableRing.{u} => (x.down : Polynomial ℚ))
      (fun x y h => ULift.ext x y (Subtype.ext h)) rfl fun _ _ => rfl
  exact NoZeroDivisors.to_isDomain _

private noncomputable def scaledGen.{u} (p : PrimeIndex) : ScaledVariableRing.{u} :=
  ULift.up ⟨scaledVariable p, Algebra.subset_adjoin ⟨p, rfl⟩⟩

private noncomputable def scaledIdeal.{u} : Ideal (ScaledVariableRing.{u}) :=
  Ideal.span (Set.range scaledGen)

private def primeTwo : PrimeIndex := ⟨2, Nat.prime_two⟩

private noncomputable def variableElement.{u} : ScaledVariableRing.{u} :=
  algebraMap ℤ (ScaledVariableRing.{u}) 2 * scaledGen primeTwo

private theorem scaledVariable_ne_zero (p : PrimeIndex) : scaledVariable p ≠ 0 := by
  have hp : (p.1 : ℚ) ≠ 0 := by exact_mod_cast p.2.ne_zero
  simp only [scaledVariable]
  exact mul_ne_zero (Polynomial.C_ne_zero.mpr (inv_ne_zero hp)) Polynomial.X_ne_zero

private theorem scaledGen_ne_zero.{u} (p : PrimeIndex) :
    scaledGen p ≠ (0 : ScaledVariableRing.{u}) := fun h =>
  scaledVariable_ne_zero p (congrArg (fun x : ScaledVariableRing.{u} => x.down.val) h)

private theorem int_mul_scaledGen.{u} (p : PrimeIndex) :
    algebraMap ℤ (ScaledVariableRing.{u}) (p.1 : ℤ) * scaledGen p = variableElement := by
  apply ULift.ext
  apply Subtype.ext
  have hp : (p.1 : ℚ) ≠ 0 := by exact_mod_cast p.2.ne_zero
  have hvar (a : ℚ) (ha : a ≠ 0) :
      Polynomial.C a * (Polynomial.C (a⁻¹) * Polynomial.X) = Polynomial.X := by
    rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha]
    simp
  change Polynomial.C (p.1 : ℚ) * (Polynomial.C ((p.1 : ℚ)⁻¹) * Polynomial.X) =
    Polynomial.C 2 * (Polynomial.C ((2 : ℚ)⁻¹) * Polynomial.X)
  exact (hvar _ hp).trans (hvar _ two_ne_zero).symm

private theorem map_scaledIdeal_principal_of_generators.{u}
    {S : Type*} [CommRing S] [Algebra (ScaledVariableRing.{u}) S] (p : PrimeIndex)
    (h : ∀ r : PrimeIndex,
      algebraMap (ScaledVariableRing.{u}) S (scaledGen r) ∈
        Ideal.span ({algebraMap (ScaledVariableRing.{u}) S (scaledGen p)} : Set S)) :
    (scaledIdeal.map (algebraMap (ScaledVariableRing.{u}) S)).IsPrincipal := by
  refine ⟨algebraMap (ScaledVariableRing.{u}) S (scaledGen p), ?_⟩
  rw [scaledIdeal, Ideal.map_span]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨a, ⟨r, rfl⟩, rfl⟩
    exact h r
  · rintro _ rfl
    exact Ideal.subset_span ⟨scaledGen p, ⟨p, rfl⟩, rfl⟩

private theorem no_other_prime_in_prime_ideal.{u}
    {q : Ideal (ScaledVariableRing.{u})} [q.IsPrime] {p r : PrimeIndex}
    (hp : algebraMap ℤ (ScaledVariableRing.{u}) (p.1 : ℤ) ∈ q) (hpr : p ≠ r) :
    algebraMap ℤ (ScaledVariableRing.{u}) (r.1 : ℤ) ∉ q := by
  intro hr
  have hcop : Nat.Coprime p.1 r.1 := p.2.coprime_iff_not_dvd.mpr fun hdiv =>
    hpr (Subtype.ext ((Nat.prime_dvd_prime_iff_eq p.2 r.2).mp hdiv))
  rcases (Nat.Coprime.isCoprime hcop : IsCoprime (p.1 : ℤ) (r.1 : ℤ)) with ⟨a, b, hab⟩
  have heq : algebraMap ℤ (ScaledVariableRing.{u}) a *
        algebraMap ℤ (ScaledVariableRing.{u}) (p.1 : ℤ) +
      algebraMap ℤ (ScaledVariableRing.{u}) b *
        algebraMap ℤ (ScaledVariableRing.{u}) (r.1 : ℤ) = 1 := by
    simpa only [map_add, map_mul, map_one] using
      congrArg (algebraMap ℤ (ScaledVariableRing.{u})) hab
  have hone : (1 : ScaledVariableRing.{u}) ∈ q := by
    rw [← heq]
    exact q.add_mem (q.mul_mem_left _ hp) (q.mul_mem_left _ hr)
  exact Ideal.IsPrime.ne_top ‹q.IsPrime› ((Ideal.eq_top_iff_one q).mpr hone)

private theorem localized_int_unit_iff.{u}
    {q : Ideal (ScaledVariableRing.{u})} [q.IsPrime] (n : ℤ) :
    IsUnit (algebraMap (ScaledVariableRing.{u}) (Localization.AtPrime q)
      (algebraMap ℤ (ScaledVariableRing.{u}) n)) ↔
      algebraMap ℤ (ScaledVariableRing.{u}) n ∉ q := by
  simpa only [Ideal.mem_primeCompl_iff] using
    (IsLocalization.AtPrime.isUnit_to_map_iff
      (S := Localization.AtPrime q) (I := q)
      (algebraMap ℤ (ScaledVariableRing.{u}) n))

private theorem localized_scaledGen_mem_span.{u}
    {q : Ideal (ScaledVariableRing.{u})} [q.IsPrime] (p r : PrimeIndex)
    (hr : algebraMap ℤ (ScaledVariableRing.{u}) (r.1 : ℤ) ∉ q) :
    algebraMap (ScaledVariableRing.{u}) (Localization.AtPrime q) (scaledGen r) ∈
      Ideal.span ({algebraMap (ScaledVariableRing.{u}) (Localization.AtPrime q)
        (scaledGen p)} : Set (Localization.AtPrime q)) := by
  apply (Ideal.unit_mul_mem_iff_mem _ ((localized_int_unit_iff r.1).2 hr)).mp
  have hrel := congrArg (algebraMap (ScaledVariableRing.{u}) (Localization.AtPrime q))
    ((int_mul_scaledGen r).trans (int_mul_scaledGen p).symm)
  simp only [map_mul] at hrel
  rw [hrel]
  exact (Ideal.span _).mul_mem_left _ (Ideal.mem_span_singleton_self _)

private def polynomialValue.{u} (x : ScaledVariableRing.{u}) : Polynomial ℚ := x.down.val

private theorem coeff_zero_is_integer.{u} (x : ScaledVariableRing.{u}) :
    ∃ z : ℤ, (polynomialValue x).coeff 0 = z := by
  refine Algebra.adjoin_induction (s := Set.range scaledVariable)
    (p := fun f _ => ∃ z : ℤ, f.coeff 0 = z) ?_ ?_ ?_ ?_ x.down.property
  · rintro _ ⟨p, rfl⟩
    exact ⟨0, by simp [scaledVariable]⟩
  · exact fun z => ⟨z, by simp⟩
  · intro f g hf hg ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨a + b, by simp [ha, hb]⟩
  · intro f g hf hg ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨a * b, by simp [Polynomial.coeff_mul, ha, hb]⟩

private theorem scaledIdeal_coeff_zero.{u} {x : ScaledVariableRing.{u}}
    (hx : x ∈ scaledIdeal) : (polynomialValue x).coeff 0 = 0 := by
  change x ∈ Submodule.span ScaledVariableRing (Set.range scaledGen) at hx
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨p, rfl⟩
    change (scaledVariable p).coeff 0 = 0
    simp [scaledVariable]
  · simp [polynomialValue]
  · intro y z hy hz ihy ihz
    change (polynomialValue y + polynomialValue z).coeff 0 = 0
    rw [Polynomial.coeff_add, ihy, ihz, add_zero]
  · intro a y hy ih
    change (polynomialValue a * polynomialValue y).coeff 0 = 0
    rw [Polynomial.mul_coeff_zero, ih, mul_zero]

private def idealCoeffOne.{u} (x : scaledIdeal.{u}) : ℚ :=
  (polynomialValue (x : ScaledVariableRing.{u})).coeff 1

private theorem idealCoeffOne_span_integral.{u} {n : ℕ}
    (s : Fin n → scaledIdeal.{u}) {x : scaledIdeal.{u}}
    (hx : x ∈ Submodule.span ScaledVariableRing (Set.range s)) :
    ∃ c : Fin n → ℤ, idealCoeffOne x = ∑ i, (c i : ℚ) * idealCoeffOne (s i) := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨i, rfl⟩
    refine ⟨fun j => if j = i then 1 else 0, ?_⟩
    simp [idealCoeffOne]
  · refine ⟨fun _ => 0, ?_⟩
    simp [idealCoeffOne, polynomialValue]
  · intro y z hy hz ⟨cy, hcy⟩ ⟨cz, hcz⟩
    refine ⟨fun i => cy i + cz i, ?_⟩
    change (polynomialValue (y : ScaledVariableRing.{u}) +
      polynomialValue (z : ScaledVariableRing.{u})).coeff 1 = _
    rw [Polynomial.coeff_add]
    change idealCoeffOne y + idealCoeffOne z = _
    rw [hcy, hcz]
    simp [Finset.sum_add_distrib, add_mul]
  · intro a y hy ⟨cy, hcy⟩
    obtain ⟨k, hk⟩ := coeff_zero_is_integer a
    have hmul : idealCoeffOne (a • y) = (polynomialValue a).coeff 0 * idealCoeffOne y := by
      change (polynomialValue a * polynomialValue (y : ScaledVariableRing.{u})).coeff 1 = _
      rw [Polynomial.mul_coeff_one, scaledIdeal_coeff_zero y.property]
      simp [idealCoeffOne]
    refine ⟨fun i => k * cy i, ?_⟩
    rw [hmul, hk, hcy]
    simp only [Int.cast_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring

/-- **Stacks 0CC0.** A nonzero ideal in a domain can be principal at every prime localization
without being invertible as a module. -/
@[stacks 0CC0]
theorem exists_locally_principal_ideal_not_invertible :
    ∃ (A : Type*) (_ : CommRing A) (_ : IsDomain A) (I : Ideal A),
      I ≠ ⊥ ∧
      (∀ (q : Ideal A) [q.IsPrime],
        Submodule.IsPrincipal
          (I.map (algebraMap A (Localization.AtPrime q)))) ∧
      ¬ Module.Invertible A I := by
  refine ⟨ScaledVariableRing, inferInstance, inferInstance, scaledIdeal, ?_, ?_, ?_⟩
  · intro h
    have hm : scaledGen primeTwo ∈ scaledIdeal := Ideal.subset_span ⟨primeTwo, rfl⟩
    rw [h] at hm
    exact scaledGen_ne_zero primeTwo (by simpa using hm)
  · intro q
    by_cases hq : ∃ p : PrimeIndex, algebraMap ℤ ScaledVariableRing (p.1 : ℤ) ∈ q
    · obtain ⟨p, hp⟩ := hq
      refine map_scaledIdeal_principal_of_generators p fun r => ?_
      by_cases hpr : p = r
      · subst r
        exact Ideal.subset_span (by simp)
      · exact localized_scaledGen_mem_span p r (no_other_prime_in_prime_ideal hp hpr)
    · exact map_scaledIdeal_principal_of_generators primeTwo fun r =>
        localized_scaledGen_mem_span primeTwo r fun hr => hq ⟨r, hr⟩
  · intro hinv
    let : Module.Invertible ScaledVariableRing scaledIdeal := hinv
    have hfinite : Module.Finite ScaledVariableRing scaledIdeal := inferInstance
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin
      (R := ScaledVariableRing) (M := scaledIdeal)
    let cval : Fin n → ℚ := fun i => idealCoeffOne (s i)
    let D : ℕ := ∏ i, (cval i).den
    have hDpos : 0 < D := Finset.prod_pos fun i _ => Rat.den_pos (cval i)
    obtain ⟨p, hpD, hprime⟩ := Nat.exists_infinite_primes (D + 1)
    have hDlt : D < p := by omega
    let pi : PrimeIndex := ⟨p, hprime⟩
    let gp : scaledIdeal := ⟨scaledGen pi, Ideal.subset_span ⟨pi, rfl⟩⟩
    have hgp : gp ∈ Submodule.span ScaledVariableRing (Set.range s) := hs ▸ Submodule.mem_top
    obtain ⟨c, hc⟩ := idealCoeffOne_span_integral s hgp
    have hgpCoeff : idealCoeffOne gp = (p : ℚ)⁻¹ := by
      have hcast : (pi.1 : ℚ) = (p : ℚ) := by exact_mod_cast (show pi.1 = p from rfl)
      simpa [gp, idealCoeffOne, polynomialValue, scaledGen, scaledVariable] using
        congrArg (fun x : ℚ => x⁻¹) hcast
    have hnum : (p : ℚ)⁻¹ = ∑ i, (c i : ℚ) * cval i :=
      hgpCoeff.symm.trans (by simpa [cval] using hc)
    have hsum : ∃ z : ℤ, (∑ i, (c i : ℚ) * cval i) * D = z := by
      have hdiv : ∀ i, (cval i).den ∣ D := fun i =>
        Finset.dvd_prod_of_mem (fun j => (cval j).den) (Finset.mem_univ i)
      choose k hk using hdiv
      refine ⟨∑ i, c i * ((cval i).num * k i), ?_⟩
      rw [Finset.sum_mul]
      push_cast
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [mul_assoc]
      congr 1
      conv_lhs => rw [← (cval i).num_div_den]
      rw [show (D : ℚ) = (cval i).den * (k i : ℚ) by exact_mod_cast hk i]
      field_simp [Rat.den_ne_zero]
    obtain ⟨z, hz⟩ := hsum
    have hmulQ : (D : ℚ) = p * z := by
      rw [← hz, ← hnum, ← mul_assoc, mul_inv_cancel₀ (by exact_mod_cast hprime.ne_zero),
        one_mul]
    have := Int.le_of_dvd (by omega) ⟨z, (by exact_mod_cast hmulQ : (D : ℤ) = p * z)⟩
    omega

end Stacks.Examples

end
