@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry Polynomial RingTheory.Sequence
open Stacks.AlgebraicGeometry
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.Examples

universe u

/-- The ideal `(x²) ⊆ k[x]` cutting out the double point `Y = Spec(k[x]/(x²))` inside the affine
line `X = 𝐀¹_k = Spec(k[x])`. -/
def doubleOriginIdeal (k : Type*) [Field k] : Ideal (Polynomial k) :=
  Ideal.span {(X : Polynomial k) ^ 2}

/-- The ideal `(x) ⊆ k[x]` cutting out the reduced origin `Z = Spec(k[x]/(x))` inside the affine
line `X = 𝐀¹_k = Spec(k[x])`. -/
def simpleOriginIdeal (k : Type*) [Field k] : Ideal (Polynomial k) :=
  Ideal.span {(X : Polynomial k)}

/-- The coordinate ring `k[x]/(x²)` of the double point `Y`. -/
abbrev DoubleOriginRing (k : Type*) [Field k] : Type _ :=
  Polynomial k ⧸ doubleOriginIdeal k

/-- The coordinate function `x̄` on the double point `Y`, the image of `x` in `k[x]/(x²)`. -/
def doubleOriginCoord (k : Type*) [Field k] : DoubleOriginRing k :=
  Ideal.Quotient.mk (doubleOriginIdeal k) X

/-- The ideal `(x̄) ⊆ k[x]/(x²)` cutting out the reduced origin `Z` inside the double point `Y`;
it is the ideal of the closed immersion `i : Z ⟶ Y`. -/
def doubleOriginPointIdeal (k : Type*) [Field k] : Ideal (DoubleOriginRing k) :=
  Ideal.span {doubleOriginCoord k}

/-- The coordinate function `x̄` on the double point is nonzero: `x` is not divisible by `x²` in
`k[x]`, by comparison of degrees. -/
theorem doubleOriginCoord_ne_zero (k : Type*) [Field k] : doubleOriginCoord k ≠ 0 := by
  rw [doubleOriginCoord, Ne, Ideal.Quotient.eq_zero_iff_mem, doubleOriginIdeal,
    Ideal.mem_span_singleton]
  intro h
  have := Polynomial.natDegree_le_of_dvd h (X_ne_zero (R := k))
  simp at this

/-- The coordinate function `x̄` on the double point squares to zero. -/
theorem doubleOriginCoord_mul_self (k : Type*) [Field k] :
    doubleOriginCoord k * doubleOriginCoord k = 0 := by
  rw [doubleOriginCoord, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, ← sq, doubleOriginIdeal]
  exact Ideal.mem_span_singleton_self _

/-- The one-term sequence `[a]` is weakly regular for a nonzero element `a` of a domain. -/
private theorem isWeaklyRegular_singleton_of_ne_zero {R : Type*} [CommRing R] [IsDomain R] {a : R}
    (ha : a ≠ 0) : IsWeaklyRegular R [a] := by
  rw [isWeaklyRegular_singleton_iff]
  exact fun _ _ h => mul_left_cancel₀ ha h

/-- The one-term sequence `[x²]` generating the ideal of `Y` in `X` is weakly regular: the ring
`k[x]` is a domain and `x² ≠ 0`. -/
theorem isWeaklyRegular_doubleOriginGenerator (k : Type*) [Field k] :
    IsWeaklyRegular (Polynomial k) [(X : Polynomial k) ^ 2] := by
  exact isWeaklyRegular_singleton_of_ne_zero (pow_ne_zero 2 (X_ne_zero (R := k)))

/-- The one-term sequence `[x]` generating the ideal of `Z` in `X` is weakly regular: the ring
`k[x]` is a domain and `x ≠ 0`. -/
theorem isWeaklyRegular_simpleOriginGenerator (k : Type*) [Field k] :
    IsWeaklyRegular (Polynomial k) [(X : Polynomial k)] := by
  exact isWeaklyRegular_singleton_of_ne_zero (X_ne_zero (R := k))

/-- **`j : Y ⟶ X` is a regular immersion.** The ideal `(x²)` of the double point `Y` in the
affine line `X` is generated by the weakly regular one-term sequence `[x²]`. -/
theorem exists_isWeaklyRegular_generators_doubleOriginIdeal (k : Type*) [Field k] :
    ∃ rs : List (Polynomial k),
      Ideal.ofList rs = doubleOriginIdeal k ∧ IsWeaklyRegular (Polynomial k) rs :=
  ⟨[(X : Polynomial k) ^ 2], Ideal.ofList_singleton _, isWeaklyRegular_doubleOriginGenerator k⟩

/-- **`j ∘ i : Z ⟶ X` is a regular immersion.** The ideal `(x)` of the reduced origin `Z` in the
affine line `X` is generated by the weakly regular one-term sequence `[x]`. -/
theorem exists_isWeaklyRegular_generators_simpleOriginIdeal (k : Type*) [Field k] :
    ∃ rs : List (Polynomial k),
      Ideal.ofList rs = simpleOriginIdeal k ∧ IsWeaklyRegular (Polynomial k) rs :=
  ⟨[(X : Polynomial k)], Ideal.ofList_singleton _, isWeaklyRegular_simpleOriginGenerator k⟩

/-- **`i : Z ⟶ Y` is not a regular immersion.** No finite family generating the ideal `(x̄)` of
the reduced origin `Z` in the double point `Y` is weakly regular: such a family is nonempty,
since `x̄ ≠ 0`, and its first member is a multiple of `x̄`, hence annihilates `x̄` and so is a
zerodivisor of `k[x]/(x²)`. -/
theorem not_exists_isWeaklyRegular_generators_doubleOriginPointIdeal (k : Type*) [Field k] :
    ¬ ∃ rs : List (DoubleOriginRing k),
        Ideal.ofList rs = doubleOriginPointIdeal k ∧ IsWeaklyRegular (DoubleOriginRing k) rs := by
  rintro ⟨rs, hrs, hreg⟩
  match rs with
  | [] =>
    refine doubleOriginCoord_ne_zero k ?_
    have hmem : doubleOriginCoord k ∈ (⊥ : Ideal (DoubleOriginRing k)) := by
      rw [← Ideal.ofList_nil, hrs, doubleOriginPointIdeal]
      exact Ideal.mem_span_singleton_self _
    simpa using hmem
  | a :: t =>
    have ha : IsSMulRegular (DoubleOriginRing k) a :=
      ((isWeaklyRegular_cons_iff _ _ _).mp hreg).1
    have hamem : a ∈ Ideal.ofList (a :: t) := Ideal.subset_span (by simp)
    rw [hrs, doubleOriginPointIdeal, Ideal.mem_span_singleton] at hamem
    obtain ⟨c, rfl⟩ := hamem
    refine doubleOriginCoord_ne_zero k (ha ?_)
    simp only [smul_eq_mul, mul_zero]
    rw [mul_right_comm, doubleOriginCoord_mul_self, zero_mul]

/-! ### The coordinate ring of `Z` and the quotient map `Γ(Y) → Γ(Z)` -/

/-- The coordinate ring `k[x]/(x)` of the reduced origin `Z`. -/
abbrev SimpleOriginRing (k : Type*) [Field k] : Type _ :=
  Polynomial k ⧸ simpleOriginIdeal k

/-- `Z` is a closed subscheme of `Y`: the ideal `(x²)` of `Y` in `X` is contained in the ideal
`(x)` of `Z` in `X`, since `x` divides `x²`. -/
theorem doubleOriginIdeal_le_simpleOriginIdeal (k : Type*) [Field k] :
    doubleOriginIdeal k ≤ simpleOriginIdeal k := by
  rw [doubleOriginIdeal, simpleOriginIdeal, Ideal.span_le]
  rintro _ rfl
  exact Ideal.mem_span_singleton.mpr (dvd_pow_self (X : Polynomial k) two_ne_zero)

/-- The origin is a closed point of the affine line: `(x)` is a maximal ideal of `k[x]`, because
`x` is irreducible and `k[x]` is a principal ideal ring. -/
theorem isMaximal_simpleOriginIdeal (k : Type*) [Field k] : (simpleOriginIdeal k).IsMaximal := by
  have h : simpleOriginIdeal k = Ideal.span ({(X : Polynomial k)} : Set (Polynomial k)) := rfl
  rw [h]
  exact PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X

/-- `Z` is nonempty: its coordinate ring `k[x]/(x) ≅ k` is not the zero ring. -/
theorem nontrivial_simpleOriginRing (k : Type*) [Field k] : Nontrivial (SimpleOriginRing k) :=
  Ideal.Quotient.nontrivial_iff.mpr (isMaximal_simpleOriginIdeal k).ne_top

/-- The ring map `k[x]/(x²) → k[x]/(x)` on coordinate rings induced by the closed immersion
`i : Z ⟶ Y`. -/
def doubleOriginQuotientHom (k : Type*) [Field k] : DoubleOriginRing k →+* SimpleOriginRing k :=
  Ideal.Quotient.factor (doubleOriginIdeal_le_simpleOriginIdeal k)

/-- The map `k[x]/(x²) → k[x]/(x)` is surjective, both sides being quotients of `k[x]`. -/
theorem doubleOriginQuotientHom_surjective (k : Type*) [Field k] :
    Function.Surjective (doubleOriginQuotientHom k) := by
  intro y
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective (I := simpleOriginIdeal k) y
  exact ⟨Ideal.Quotient.mk _ p, rfl⟩

/-- **The ideal of `Z` in `Y` is the kernel of `k[x]/(x²) → k[x]/(x)`.** -/
theorem ker_doubleOriginQuotientHom (k : Type*) [Field k] :
    RingHom.ker (doubleOriginQuotientHom k) = doubleOriginPointIdeal k := by
  rw [doubleOriginQuotientHom, Ideal.Quotient.factor_ker, simpleOriginIdeal, Ideal.map_span,
    doubleOriginPointIdeal, doubleOriginCoord]
  simp

/-- **`Y = Spec(k[x]/(x²))` is a one-point space.** A prime of `k[x]` containing `x²` contains
`x`, hence contains the maximal ideal `(x)` and equals it; so every prime of `k[x]/(x²)` has the
same contraction along the surjection `k[x] → k[x]/(x²)`, and contraction along a surjection is
injective on ideals. -/
theorem subsingleton_primeSpectrum_doubleOriginRing (k : Type*) [Field k] :
    Subsingleton (PrimeSpectrum (DoubleOriginRing k)) := by
  have key : ∀ T : PrimeSpectrum (DoubleOriginRing k),
      Ideal.comap (Ideal.Quotient.mk (doubleOriginIdeal k)) T.asIdeal = simpleOriginIdeal k := by
    intro T
    have hp : (Ideal.comap (Ideal.Quotient.mk (doubleOriginIdeal k)) T.asIdeal).IsPrime :=
      Ideal.comap_isPrime _ _
    refine ((isMaximal_simpleOriginIdeal k).eq_of_le hp.ne_top ?_).symm
    rw [simpleOriginIdeal, Ideal.span_le]
    rintro _ rfl
    have hsq : (X : Polynomial k) * (X : Polynomial k) ∈
        Ideal.comap (Ideal.Quotient.mk (doubleOriginIdeal k)) T.asIdeal := by
      refine Ideal.mem_comap.mpr ?_
      have h0 : (Ideal.Quotient.mk (doubleOriginIdeal k))
          ((X : Polynomial k) * (X : Polynomial k)) = 0 := by
        rw [map_mul]
        exact doubleOriginCoord_mul_self k
      rw [h0]
      exact T.asIdeal.zero_mem
    exact (hp.mem_or_mem hsq).elim id id
  exact ⟨fun P Q => PrimeSpectrum.ext (Ideal.comap_injective_of_surjective _
    Ideal.Quotient.mk_surjective ((key P).trans (key Q).symm))⟩

/-! ### General criteria -/

/-- **The kernel of `Spec φ` on global sections.** The map of global sections of `Spec φ` is `φ`
conjugated by the canonical identifications `Γ(Spec R, ⊤) ≅ R` and `Γ(Spec S, ⊤) ≅ S`, which is
the naturality square `AlgebraicGeometry.Scheme.ΓSpecIso_naturality`; so its kernel is the
preimage of `ker φ` along the first of them, the identification of the target being injective. -/
theorem ker_appTop_spec_map {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    RingHom.ker ((Spec.map φ).appTop).hom =
      Ideal.comap ((Scheme.ΓSpecIso R).hom).hom (RingHom.ker φ.hom) := by
  have hinjS : Function.Injective ((Scheme.ΓSpecIso S).hom).hom :=
    (ConcreteCategory.bijective_of_isIso ((Scheme.ΓSpecIso S).hom)).1
  ext a
  have hnat : ((Scheme.ΓSpecIso S).hom).hom (((Spec.map φ).appTop).hom a) =
      φ.hom (((Scheme.ΓSpecIso R).hom).hom a) := by
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.ΓSpecIso_naturality]
  simp only [RingHom.mem_ker, Ideal.mem_comap, ← hnat]
  exact ⟨fun hh => by rw [hh, map_zero], fun hh => hinjS (by rw [hh, map_zero])⟩

/-- **Regularity of a closed immersion, read on the target.** For a closed immersion the coborder
of the range is the whole target, so part (1) of Stacks tag 063J may be read off the defining
ideal sheaf on the target itself. This is the converse of
`Stacks.AlgebraicGeometry.isRegularImmersion_of_isRegularIdealSheaf`, and comes from the other
direction of the same iff. -/
@[ega "IV 16.9.2" "partial"]
theorem isRegularIdealSheaf_definingIdealOfHom_of_isRegularImmersion {Z X : Scheme.{u}}
    (i : Z ⟶ X) [IsClosedImmersion i] (h : IsRegularImmersion i) :
    RegularIdealSheaf.IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom i) := by
  have hfac : i.liftCoborder ≫ i.coborderRange.ι = i := i.liftCoborder_ι
  have hci : IsClosedImmersion (i.liftCoborder ≫ i.coborderRange.ι) := by
    rw [hfac]; infer_instance
  have h2 := (isRegularIdealSheaf_comp_open_iff i.liftCoborder i.coborderRange.ι).mpr h
  rwa [hfac] at h2

/-- **A one-point affine target refutes regularity from the kernel alone.** Let `φ : R ⟶ S` be a
surjection of rings with `Spec S` nonempty and `Spec R` a one-point space. If no finite list
generating `ker φ` is weakly regular, then the defining ideal sheaf of the closed immersion
`Spec φ` is not a regular ideal sheaf.

By Stacks tag 063G regularity would give, around the image of a point of `Spec S` — a point of
the support of the quotient, being in the range of a closed immersion — an affine open carrying a
weakly regular generating family. That open is `⊤` since `Spec R` has one point, and over `⊤` the
ideal such a family generates is `ker ((Spec φ).appTop)` by
`Stacks.AlgebraicGeometry.ker_app_eq_span_range`. Transporting along the ring isomorphism
`AlgebraicGeometry.Scheme.ΓSpecIso R`, which is flat because it is bijective, turns the family
into a weakly regular list generating `ker φ`. -/
theorem not_isRegularIdealSheaf_spec_map_of_subsingleton {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (hφ : Function.Surjective φ.hom) (hS : Nonempty (PrimeSpectrum S))
    (hR : Subsingleton (PrimeSpectrum R))
    (hker : ¬ ∃ rs : List R, Ideal.ofList rs = RingHom.ker φ.hom ∧ IsWeaklyRegular R rs) :
    ¬ RegularIdealSheaf.IsRegularIdealSheaf (Spec R).toRingedSpace
      (definingIdealOfHom (Spec.map φ)) := by
  have hci : IsClosedImmersion (Spec.map φ) := IsClosedImmersion.spec_of_surjective φ hφ
  rw [RegularIdealSheaf.isRegularIdealSheaf_iff_exists_affine_generators]
  intro h
  obtain ⟨z⟩ := hS
  have hy : (Spec.map φ).base z ∈
      RegularIdealSheaf.idealQuotientSupport (Spec R).toRingedSpace
        (definingIdealOfHom (Spec.map φ)) := by
    rw [definingIdealQuotient_support_eq_range]
    exact ⟨z, rfl⟩
  obtain ⟨⟨U, hUaff⟩, hyU, r, f, hgen, hwr⟩ := h _ hy
  have hUtop : U = ⊤ := by
    ext w
    simpa using (hR.elim w ((Spec.map φ).base z)) ▸ hyU
  subst hUtop
  have hspan : RingHom.ker ((Spec.map φ).appTop).hom = Ideal.span (Set.range f) :=
    ker_app_eq_span_range (Spec.map φ) (isAffineOpen_top (Spec R)) f hgen
  set ε : Γ(Spec R, ⊤) →+* R := ((Scheme.ΓSpecIso R).hom).hom with hε
  have hbijR : Function.Bijective ε :=
    ConcreteCategory.bijective_of_isIso ((Scheme.ΓSpecIso R).hom)
  have hkerε : Ideal.map ε (RingHom.ker ((Spec.map φ).appTop).hom) = RingHom.ker φ.hom := by
    have hkey : RingHom.ker ((Spec.map φ).appTop).hom = Ideal.comap ε (RingHom.ker φ.hom) :=
      ker_appTop_spec_map φ
    rw [hkey, Ideal.map_comap_of_surjective _ hbijR.2]
  have hofFn : Ideal.ofList (List.ofFn fun i => ε (f i))
      = Ideal.span (Set.range fun i => ε (f i)) := by
    unfold Ideal.ofList
    congr 1
    ext a
    simp
  refine hker ⟨List.ofFn fun i => ε (f i), ?_, ?_⟩
  · rw [hofFn, ← hkerε, hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  · exact isWeaklyRegular_ofFn_map_of_flat ε (RingHom.Flat.of_bijective hbijR) f hwr

/-- **A weakly regular generating family of the kernel makes `Spec φ` a regular immersion.** Let
`φ : R ⟶ S` be a surjection of rings whose kernel is generated by a family `f` which is weakly
regular in `R`. Then `Spec φ` is a regular immersion.

This is the positive counterpart of `not_isRegularIdealSheaf_spec_map_of_subsingleton` and runs
through the same affine criterion, Stacks tag 063G, in the other direction. One affine open, `⊤`,
serves for every point of the support of the quotient. The family is carried from `R` to
`Γ(Spec R, ⊤)` along the inverse of `AlgebraicGeometry.Scheme.ΓSpecIso R`: that map is bijective,
hence flat, so weak regularity survives it, and it turns the description of
`ker ((Spec φ).appTop)` supplied by `ker_appTop_spec_map` into the statement that the transported
family spans that kernel. Generation of the defining ideal sheaf over `⊤` is then
`Stacks.AlgebraicGeometry.isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span`. -/
theorem isRegularImmersion_spec_map_of_isWeaklyRegular {R S : CommRingCat.{u}} (φ : R ⟶ S)
    [IsClosedImmersion (Spec.map φ)] {r : ℕ} (f : Fin r → R)
    (hker : RingHom.ker φ.hom = Ideal.span (Set.range f))
    (hwr : IsWeaklyRegular R (List.ofFn f)) :
    RegularIdealSheaf.IsRegularImmersion (Spec.map φ) := by
  have hιε : ∀ a : Γ(Spec R, ⊤),
      ((Scheme.ΓSpecIso R).inv).hom (((Scheme.ΓSpecIso R).hom).hom a) = a :=
    ((Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv).symm_apply_apply
  have hει : ∀ b : R, ((Scheme.ΓSpecIso R).hom).hom (((Scheme.ΓSpecIso R).inv).hom b) = b :=
    ((Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv).apply_symm_apply
  refine isRegularImmersion_of_isRegularIdealSheaf _
    (RegularIdealSheaf.isRegularIdealSheaf_of_exists_affine_generators (Spec R) _
      fun x _ => ⟨⊤, isAffineOpen_top (Spec R), trivial, r,
        fun i => ((Scheme.ΓSpecIso R).inv).hom (f i), ?_, ?_⟩)
  · refine isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span (Spec.map φ)
      (isAffineOpen_top (Spec R)) _ ?_
    change RingHom.ker ((Spec.map φ).appTop).hom =
      Ideal.span (Set.range fun i => ((Scheme.ΓSpecIso R).inv).hom (f i))
    rw [ker_appTop_spec_map, hker]
    refine le_antisymm (fun a ha => ?_) (Ideal.span_le.mpr ?_)
    · have hmap : ((Scheme.ΓSpecIso R).inv).hom (((Scheme.ΓSpecIso R).hom).hom a) ∈
          Ideal.map ((Scheme.ΓSpecIso R).inv).hom (Ideal.span (Set.range f)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_comap.mp ha)
      rw [Ideal.map_span, ← Set.range_comp, hιε a] at hmap
      exact hmap
    · rintro _ ⟨i, rfl⟩
      simp only [SetLike.mem_coe, Ideal.mem_comap, hει]
      exact Ideal.subset_span ⟨i, rfl⟩
  · exact isWeaklyRegular_ofFn_map_of_flat ((Scheme.ΓSpecIso R).inv).hom
      (RingHom.Flat.of_bijective (Function.bijective_iff_has_inverse.mpr
        ⟨((Scheme.ΓSpecIso R).hom).hom, hει, hιε⟩)) f hwr

/-- **Regularity of an immersion is a property of the morphism.** Transport along an equality of
morphisms, which `rw` cannot perform because `IsRegularImmersion` carries an `IsImmersion`
instance for the morphism it is applied to. -/
theorem isRegularImmersion_congr {Z X : Scheme.{u}} {i i' : Z ⟶ X} [IsImmersion i]
    [IsImmersion i'] (h : i = i')
    (hi : RegularIdealSheaf.IsRegularImmersion i) :
    RegularIdealSheaf.IsRegularImmersion i' := by
  subst h
  exact hi

/-- **Regularity of an immersion is not lost by composing with an isomorphism of the source**,
the converse of `Stacks.AlgebraicGeometry.isRegularImmersion_comp_iso`, obtained from it by
composing with the inverse isomorphism. -/
theorem isRegularImmersion_of_comp_iso {Z Z' X : Scheme.{u}} (e : Z' ≅ Z) (i : Z ⟶ X)
    [IsImmersion i] (h : RegularIdealSheaf.IsRegularImmersion (e.hom ≫ i)) :
    RegularIdealSheaf.IsRegularImmersion i :=
  isRegularImmersion_congr (by simp) (isRegularImmersion_comp_iso e.symm (e.hom ≫ i) h)

/-! ### The closed immersion `i : Z ⟶ Y` and the refutation -/

/-- **The closed immersion `i : Z ⟶ Y`** of the reduced origin into the double point, the `Spec`
of the quotient map `k[x]/(x²) → k[x]/(x)`. -/
abbrev simpleOriginImmersion (k : Type*) [Field k] :
    Spec (CommRingCat.of (SimpleOriginRing k)) ⟶ Spec (CommRingCat.of (DoubleOriginRing k)) :=
  Spec.map (CommRingCat.ofHom (doubleOriginQuotientHom k))

/-- `i : Z ⟶ Y` is a closed immersion, being the `Spec` of a surjection. -/
instance isClosedImmersion_simpleOriginImmersion (k : Type*) [Field k] :
    IsClosedImmersion (simpleOriginImmersion k) :=
  IsClosedImmersion.spec_of_surjective _ (doubleOriginQuotientHom_surjective k)

/-- **The defining ideal sheaf of `i : Z ⟶ Y` is not a regular ideal sheaf.** `Y` is a one-point
space and `Z` is nonempty, so the affine-local criterion of Stacks tag 063G asks for a weakly
regular family generating `(x̄) = ker (k[x]/(x²) → k[x]/(x))` in `k[x]/(x²)`, and there is
none. -/
theorem not_isRegularIdealSheaf_definingIdealOfHom_simpleOriginImmersion (k : Type*) [Field k] :
    ¬ RegularIdealSheaf.IsRegularIdealSheaf
      (Spec (CommRingCat.of (DoubleOriginRing k))).toRingedSpace
      (RegularIdealSheaf.definingIdealOfHom (simpleOriginImmersion k)) := by
  have : Nontrivial (SimpleOriginRing k) := nontrivial_simpleOriginRing k
  refine not_isRegularIdealSheaf_spec_map_of_subsingleton _ (doubleOriginQuotientHom_surjective k)
    inferInstance (subsingleton_primeSpectrum_doubleOriginRing k) ?_
  rw [show RingHom.ker (CommRingCat.ofHom (doubleOriginQuotientHom k)).hom
      = doubleOriginPointIdeal k from ker_doubleOriginQuotientHom k]
  exact not_exists_isWeaklyRegular_generators_doubleOriginPointIdeal k

/-- **`i : Z ⟶ Y` is not a regular immersion.** The predicate is
`Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularImmersion`, part (1) of Stacks tag 063J and
the one whose three variants the statements carrying Stacks tag 0690 compare; for a closed
immersion it may be read on the target, where the defining ideal sheaf is not regular. -/
theorem not_isRegularImmersion_simpleOriginImmersion (k : Type*) [Field k] :
    ¬ RegularIdealSheaf.IsRegularImmersion (simpleOriginImmersion k) := fun h =>
  not_isRegularIdealSheaf_definingIdealOfHom_simpleOriginImmersion k
    (isRegularIdealSheaf_definingIdealOfHom_of_isRegularImmersion _ h)

/-! ### The affine line `X` and the two outer immersions -/

/-- **The affine line `X = 𝐀¹_k = Spec(k[x])`.** -/
abbrev affineLine (k : Type*) [Field k] : Scheme :=
  Spec (CommRingCat.of (Polynomial k))

/-- **The closed immersion `j : Y ⟶ X`** of the double point into the affine line, the `Spec` of
the quotient map `k[x] → k[x]/(x²)`. -/
abbrev doubleOriginLineImmersion (k : Type*) [Field k] :
    Spec (CommRingCat.of (DoubleOriginRing k)) ⟶ affineLine k :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (doubleOriginIdeal k)))

/-- **The closed immersion `j ∘ i : Z ⟶ X`** of the reduced origin into the affine line, the
`Spec` of the quotient map `k[x] → k[x]/(x)`. -/
abbrev simpleOriginLineImmersion (k : Type*) [Field k] :
    Spec (CommRingCat.of (SimpleOriginRing k)) ⟶ affineLine k :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (simpleOriginIdeal k)))

/-- `j : Y ⟶ X` is a closed immersion, being the `Spec` of a surjection. -/
instance isClosedImmersion_doubleOriginLineImmersion (k : Type*) [Field k] :
    IsClosedImmersion (doubleOriginLineImmersion k) :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- `j ∘ i : Z ⟶ X` is a closed immersion, being the `Spec` of a surjection. -/
instance isClosedImmersion_simpleOriginLineImmersion (k : Type*) [Field k] :
    IsClosedImmersion (simpleOriginLineImmersion k) :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- **The composite of `i` and `j` is the closed immersion of `Z` into the affine line.** On
coordinate rings this is the factorization of `k[x] → k[x]/(x)` through `k[x]/(x²)`. -/
theorem simpleOriginImmersion_comp_doubleOriginLineImmersion (k : Type*) [Field k] :
    simpleOriginImmersion k ≫ doubleOriginLineImmersion k = simpleOriginLineImmersion k := by
  have hring : CommRingCat.ofHom (Ideal.Quotient.mk (doubleOriginIdeal k)) ≫
      CommRingCat.ofHom (doubleOriginQuotientHom k) =
      CommRingCat.ofHom (Ideal.Quotient.mk (simpleOriginIdeal k)) :=
    CommRingCat.hom_ext (RingHom.ext fun p =>
      Ideal.Quotient.factor_mk (doubleOriginIdeal_le_simpleOriginIdeal k) p)
  rw [← Spec.map_comp, hring]

/-- The quotient map `k[x] → k[x]/I` for an ideal `I = (a)` with `a ≠ 0` is a regular immersion:
its kernel `I` is generated by the weakly regular one-term sequence `[a]`. -/
private theorem isRegularImmersion_spec_map_mk_of_eq_span {k : Type*} [Field k]
    {I : Ideal (Polynomial k)} {a : Polynomial k} (hI : I = Ideal.span {a}) (ha : a ≠ 0)
    [IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))] :
    RegularIdealSheaf.IsRegularImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
  refine isRegularImmersion_spec_map_of_isWeaklyRegular _ (fun _ : Fin 1 => a) ?_ ?_
  · rw [show RingHom.ker (CommRingCat.ofHom (Ideal.Quotient.mk I)).hom = I from Ideal.mk_ker, hI]
    simp [Set.range_const]
  · simpa using isWeaklyRegular_singleton_of_ne_zero ha

/-- **`j : Y ⟶ X` is a regular immersion.** The ideal of the double point in the affine line is
`(x²)`, generated by the weakly regular one-term sequence `[x²]`. -/
theorem isRegularImmersion_doubleOriginLineImmersion (k : Type*) [Field k] :
    RegularIdealSheaf.IsRegularImmersion (doubleOriginLineImmersion k) := by
  exact isRegularImmersion_spec_map_mk_of_eq_span (I := doubleOriginIdeal k) rfl
    (pow_ne_zero 2 (X_ne_zero (R := k)))

/-- **`j ∘ i : Z ⟶ X` is a regular immersion.** The ideal of the reduced origin in the affine
line is `(x)`, generated by the weakly regular one-term sequence `[x]`. -/
theorem isRegularImmersion_simpleOriginLineImmersion (k : Type*) [Field k] :
    RegularIdealSheaf.IsRegularImmersion (simpleOriginLineImmersion k) := by
  exact isRegularImmersion_spec_map_mk_of_eq_span (I := simpleOriginIdeal k) rfl
    (X_ne_zero (R := k))

/-- **`j ∘ i : Z ⟶ X` is a regular immersion**, stated for the composite itself. -/
theorem isRegularImmersion_simpleOriginImmersion_comp (k : Type*) [Field k] :
    RegularIdealSheaf.IsRegularImmersion
      (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) :=
  isRegularImmersion_congr (simpleOriginImmersion_comp_doubleOriginLineImmersion k).symm
    (isRegularImmersion_simpleOriginLineImmersion k)

/-! ### Regularity in a neighbourhood of a point -/

/-- **Regularity of an immersion in a neighbourhood of a point of its source**, the predicate
whose three combinations Stacks tag 0690 compares: the restriction of the immersion to some open
neighbourhood of the point is a regular immersion. -/
def IsRegularImmersionAt {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i] (z : Z) : Prop :=
  ∃ V : Z.Opens, z ∈ V ∧ RegularIdealSheaf.IsRegularImmersion (V.ι ≫ i)

/-- A regular immersion is a regular immersion in a neighbourhood of each point of its source:
take the neighbourhood to be everything, whose inclusion is an isomorphism. -/
theorem isRegularImmersionAt_of_isRegularImmersion {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (h : RegularIdealSheaf.IsRegularImmersion i) (z : Z) : IsRegularImmersionAt i z :=
  ⟨⊤, trivial, isRegularImmersion_comp_iso (Scheme.topIso Z) i h⟩

/-- **`Z = Spec(k[x]/(x))` is a one-point space.** The ring `k[x]/(x)` is a field, `(x)` being a
maximal ideal of `k[x]`, and the spectrum of a field is a single point. -/
theorem subsingleton_primeSpectrum_simpleOriginRing (k : Type*) [Field k] :
    Subsingleton (PrimeSpectrum (SimpleOriginRing k)) := by
  have : (simpleOriginIdeal k).IsMaximal := isMaximal_simpleOriginIdeal k
  let : Field (SimpleOriginRing k) := Ideal.Quotient.field (simpleOriginIdeal k)
  infer_instance

/-- **`i : Z ⟶ Y` is a regular immersion in no neighbourhood of any point of `Z`**, which is what
parts (1) and (2) of Stacks tag 0690 assert of `i`. The space `Z` has a single point, so the only
open neighbourhood of that point is `⊤`, whose inclusion is an isomorphism; and `i` itself is not
a regular immersion. -/
theorem not_isRegularImmersionAt_simpleOriginImmersion (k : Type*) [Field k]
    (z : Spec (CommRingCat.of (SimpleOriginRing k))) :
    ¬ IsRegularImmersionAt (simpleOriginImmersion k) z := by
  rintro ⟨V, hzV, hV⟩
  refine not_isRegularImmersion_simpleOriginImmersion k ?_
  have hVtop : V = ⊤ := by
    ext w
    simpa using ((subsingleton_primeSpectrum_simpleOriginRing k).elim w z) ▸ hzV
  subst hVtop
  exact isRegularImmersion_of_comp_iso (Scheme.topIso _) (simpleOriginImmersion k) hV

/-! ### The three parts of Stacks tag 0690, each refuted -/

/-- **The conormal sequence of `i : Z ⟶ Y` and `j : Y ⟶ X` is exact and split in no neighbourhood
of any point of `Z`**, which is the second half of part (3) of Stacks tag 0690.

The affine line `X = Spec(k[x])` is locally Noetherian, `k[x]` being Noetherian, and `j ∘ i` is a
regular immersion; so a neighbourhood of a point of `Z` on which the conormal sequence were exact
and split would make `i` a regular immersion in a neighbourhood of that point, by
`Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_opens_isRegularImmersion_of_split_near`, the
implication `(3) ⇒ (1)` of Stacks tag 0690. And `i` is a regular immersion in no neighbourhood of
any point of `Z`. -/
theorem not_isSplitExactConormalSequence_simpleOriginImmersion (k : Type*) [Field k]
    (z : Spec (CommRingCat.of (SimpleOriginRing k))) :
    ¬ ∃ W : (Spec (CommRingCat.of (SimpleOriginRing k))).Opens, z ∈ W ∧
      IsSplitExactConormalSequence (W.ι ≫ simpleOriginImmersion k)
        (doubleOriginLineImmersion k) := fun hS =>
  not_isRegularImmersionAt_simpleOriginImmersion k z
    (exists_opens_isRegularImmersion_of_split_near (simpleOriginImmersion k)
      (doubleOriginLineImmersion k) z
      (isRegularImmersionAt_of_isRegularImmersion _
        (isRegularImmersion_simpleOriginImmersion_comp k) z) hS).1

/-- **Part (1) of Stacks tag 0690 fails**: it is not the case that `i` is a regular immersion in a
neighbourhood of a point `z` of `Z` and `j` one in a neighbourhood of `i z`. Its first half
already fails. -/
theorem not_isRegularImmersionAt_both_factors (k : Type*) [Field k]
    (z : Spec (CommRingCat.of (SimpleOriginRing k))) :
    ¬ (IsRegularImmersionAt (simpleOriginImmersion k) z ∧
      IsRegularImmersionAt (doubleOriginLineImmersion k) ((simpleOriginImmersion k).base z)) :=
  fun h => not_isRegularImmersionAt_simpleOriginImmersion k z h.1

/-- **Part (2) of Stacks tag 0690 fails**: it is not the case that `i` and `j ∘ i` are both regular
immersions in a neighbourhood of a point `z` of `Z`. Its first half already fails. -/
theorem not_isRegularImmersionAt_factor_and_composite (k : Type*) [Field k]
    (z : Spec (CommRingCat.of (SimpleOriginRing k))) :
    ¬ (IsRegularImmersionAt (simpleOriginImmersion k) z ∧
      IsRegularImmersionAt (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) z) :=
  fun h => not_isRegularImmersionAt_simpleOriginImmersion k z h.1

/-- **Part (3) of Stacks tag 0690 fails**: it is not the case that `j ∘ i` is a regular immersion
in a neighbourhood of a point `z` of `Z` and the conormal sequence is exact and split in a
neighbourhood of `z`. Here it is the *second* half that fails, the first one being true; so this
is not a restatement of the failure of parts (1) and (2). -/
theorem not_isRegularImmersionAt_composite_and_isSplitExactConormalSequence (k : Type*) [Field k]
    (z : Spec (CommRingCat.of (SimpleOriginRing k))) :
    ¬ (IsRegularImmersionAt (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) z ∧
      ∃ W : (Spec (CommRingCat.of (SimpleOriginRing k))).Opens, z ∈ W ∧
        IsSplitExactConormalSequence (W.ι ≫ simpleOriginImmersion k)
          (doubleOriginLineImmersion k)) :=
  fun h => not_isSplitExactConormalSequence_simpleOriginImmersion k z h.2

/-- **Stacks tag 0691.** Regularity of an immersion is not inherited by the middle term of a
factorization. For `Z = Spec(k[x]/(x)) --i--→ Y = Spec(k[x]/(x²)) --j--→ X = 𝐀¹_k = Spec(k[x])`
the two outer immersions `j` and `j ∘ i` are regular immersions — at every point of their sources
and globally — while the middle one, `i`, is a regular immersion in no neighbourhood of any point
of `Z` and in particular not globally, and the conormal sequence of the pair is exact and split in
no neighbourhood of any point of `Z`; at the level of ideals, the ideals of `Y` in `X` and of `Z`
in `X` are each generated by a weakly regular sequence and the ideal of `Z` in `Y` is generated by
none. So each of the three parts of Stacks tag 0690 fails at every point of `Z` — parts (1) and
(2) through their common first half, regularity of `i` near the point, and part (3) through its
second half, the splitting, its first half being true — while "`j ∘ i` and `j` are regular
immersions at `z` and `y`" holds, which is the content of the remark. -/
@[stacks 0691 "The counterexample of the remark for `X = 𝐀¹_k`, `Y = Spec(k[x]/(x²))` and \
`Z = Spec(k[x]/(x))` over an arbitrary field `k`, at the level of schemes throughout. The three \
immersions are the `Spec` of the quotient maps `k[x] → k[x]/(x²)` (that is `j`), \
`k[x] → k[x]/(x)` (that is `j ∘ i`, identified with the composite by \
`Stacks.Examples.simpleOriginImmersion_comp_doubleOriginLineImmersion`) and \
`k[x]/(x²) → k[x]/(x)` (that is `i`). The predicate is \
`Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularImmersion`, part (1) of Stacks tag 063J and \
the one whose variants the statements carrying Stacks tag 0690 compare; the `in a neighbourhood \
of a point` form in which Stacks tag 0690 states its three parts is \
`Stacks.Examples.IsRegularImmersionAt`, and the splitting condition of its part (3) is \
`Stacks.AlgebraicGeometry.IsSplitExactConormalSequence` on a neighbourhood, the form in which \
the proved implications of Stacks tag 0690 state it. Both forms are delivered: regularity of `j` \
at every point of `Y`, of `i ≫ j` at every point of `Z` and of both globally, against the \
refutation of regularity of `i` at every point of `Z` and globally. All three parts of Stacks \
tag 0690 are refuted, each as a whole and at every point of `Z`: parts (1) and (2) through their \
common first half, part (3) through its second half, the splitting, since its first half holds \
here. That last refutation runs through the implication `(3) ⇒ (1)` of Stacks tag 0690, \
`Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_opens_isRegularImmersion_of_split_near`, \
which is proved; nothing here rests on an unproved result. The three ideal-level statements are \
retained as the affine half to which that predicate \
reduces by Stacks tag 063G. No hypothesis is carried beyond `k` being a field."]
theorem regular_immersion_not_permanent_in_middle (k : Type*) [Field k] :
    -- `j` is a regular immersion at every point of `Y`, and `j ∘ i` at every point of `Z`
    (∀ y, IsRegularImmersionAt (doubleOriginLineImmersion k) y) ∧
      (∀ z, IsRegularImmersionAt
        (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) z) ∧
      -- while `i` is a regular immersion in no neighbourhood of any point of `Z`
      (∀ z, ¬ IsRegularImmersionAt (simpleOriginImmersion k) z) ∧
      -- and the conormal sequence is exact and split in no neighbourhood of any point of `Z`
      (∀ z, ¬ ∃ W : (Spec (CommRingCat.of (SimpleOriginRing k))).Opens, z ∈ W ∧
        IsSplitExactConormalSequence (W.ι ≫ simpleOriginImmersion k)
          (doubleOriginLineImmersion k)) ∧
      -- so that each of the three parts of Stacks tag 0690 fails at every point of `Z`
      (∀ z, ¬ (IsRegularImmersionAt (simpleOriginImmersion k) z ∧
        IsRegularImmersionAt (doubleOriginLineImmersion k) ((simpleOriginImmersion k).base z))) ∧
      (∀ z, ¬ (IsRegularImmersionAt (simpleOriginImmersion k) z ∧
        IsRegularImmersionAt (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) z)) ∧
      (∀ z, ¬ (IsRegularImmersionAt (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) z ∧
        ∃ W : (Spec (CommRingCat.of (SimpleOriginRing k))).Opens, z ∈ W ∧
          IsSplitExactConormalSequence (W.ι ≫ simpleOriginImmersion k)
            (doubleOriginLineImmersion k))) ∧
      -- the same three facts globally
      RegularIdealSheaf.IsRegularImmersion (doubleOriginLineImmersion k) ∧
      RegularIdealSheaf.IsRegularImmersion
        (simpleOriginImmersion k ≫ doubleOriginLineImmersion k) ∧
      ¬ RegularIdealSheaf.IsRegularImmersion (simpleOriginImmersion k) ∧
      -- and at the level of ideals, to which Stacks tag 063G reduces them
      (∃ rs : List (Polynomial k),
        Ideal.ofList rs = doubleOriginIdeal k ∧ IsWeaklyRegular (Polynomial k) rs) ∧
      (∃ rs : List (Polynomial k),
        Ideal.ofList rs = simpleOriginIdeal k ∧ IsWeaklyRegular (Polynomial k) rs) ∧
      (¬ ∃ rs : List (DoubleOriginRing k),
        Ideal.ofList rs = doubleOriginPointIdeal k ∧
          IsWeaklyRegular (DoubleOriginRing k) rs) :=
  ⟨isRegularImmersionAt_of_isRegularImmersion _ (isRegularImmersion_doubleOriginLineImmersion k),
