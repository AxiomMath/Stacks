/-!
# A direct sum of derived complete modules need not be derived complete

For a prime `p`, the ring `ℤ_[p]` of `p`-adic integers is derived complete for the ideal `(p)`,
but the direct sum of copies of it indexed by the positive natural numbers is not.

Derived completeness for a principal ideal `(f)` says that the "recurrence operator"
`a ↦ (aₙ - f · aₙ₊₁)ₙ` on sequences in the module is bijective. For the direct sum, take the
sequence `y` whose `n`-th term is the `(n+1)`-st standard basis vector. If `a` solved the
recurrence `aₙ - p·aₙ₊₁ = yₙ`, then reading off the `i`-th coordinate for a fixed index `i`
gives the scalar recurrence `aₙ(i) - p·aₙ₊₁(i) = [n + 1 = i]`, whose solution satisfies
`a₀(i) = p^{i-1}(1 + p·aᵢ(i))`, which is nonzero because `p` is not a unit. So every coordinate
of `a₀` is nonzero — impossible in a direct sum, where `a₀` has finite support.

## Main definitions

* `Stacks.Examples.pAdicDirectSum`: the direct sum of countably many copies of `ℤ_[p]`.

## Main results

* `Stacks.Examples.pAdicInt_summand_isDerivedComplete`: each summand is derived complete for
  the ideal generated by `p`.
* `Stacks.Examples.pAdicDirectSum_not_isDerivedComplete`: the direct sum is not.

## Implementation notes

Derived completeness is `IsDerivedCompleteModule`, which views a module as an object of the
derived category concentrated in degree zero; its formalization takes the existence of countable
products in the derived category as an explicit hypothesis, which is why that appears as an
instance argument here.

## References

* [Stacks Project, Tag 0ARD](https://stacks.math.columbia.edu/tag/0ARD)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard
attribute [-instance] LinearAlgebra.FreeProduct.instModuleDirectSum

namespace Stacks.Examples

/-- Solving the impulse recurrence `xₙ - q·xₙ₊₁ = [n + 1 = m]` forces
`x₀ = q^{m-1}(1 + q·xₘ)`. -/
private lemma recurrence_impulse_formula {R : Type*} [CommRing R] (q : R) :
    ∀ (m : ℕ), 0 < m → ∀ x : ℕ → R,
      (∀ n, x n - q * x (n + 1) = if n + 1 = m then 1 else 0) →
        x 0 = q ^ (m - 1) * (1 + q * x m) := by
  intro m
  induction m with
  | zero => intro hm; omega
  | succ m ih =>
      intro hm x hx
      by_cases hm0 : m = 0
      · subst m
        have h0 := hx 0
        norm_num at h0
        calc
          x 0 = 1 + q * x 1 := by linear_combination h0
          _ = q ^ ((0 : ℕ) + 1 - 1) * (1 + q * x ((0 : ℕ) + 1)) := by norm_num
      · have hmpos : 0 < m := Nat.pos_of_ne_zero hm0
        have htail : ∀ n, x (n + 1) - q * x (n + 1 + 1) =
            if n + 1 = m then 1 else 0 := by
          intro n
          have heq : n + 1 + 1 = m + 1 ↔ n + 1 = m := by omega
          simpa [heq] using hx (n + 1)
        have hrec := ih hmpos (fun n => x (n + 1)) htail
        have h0 : x 0 = q * x 1 := by
          have h := hx 0
          simp [hm0] at h
          linear_combination h
        rw [h0, hrec, show m + 1 - 1 = m - 1 + 1 by omega]
        ring

private lemma p_mul_one_add_p_ne_zero (p : ℕ) [Fact p.Prime] (x : PadicInt p) (n : ℕ) :
    (p : PadicInt p) ^ n * (1 + (p : PadicInt p) * x) ≠ 0 :=
  mul_ne_zero (pow_ne_zero _ (NeZero.ne _)) fun h =>
    PadicInt.p_nonunit (p := p) (isUnit_iff_dvd_one.2 ⟨-x, by linear_combination h⟩)

private lemma directSum_basis_eval (p : ℕ) [Fact p.Prime] (j i : ℕ+) :
    (DirectSum.of (fun _ : ℕ+ => PadicInt p) j (1 : PadicInt p)) i =
      if j.val = i.val then 1 else 0 := by
  by_cases h : j = i
  · subst i
    simp
  · rw [DirectSum.of_eq_of_ne (β := fun _ : ℕ+ => PadicInt p) j i 1 (Ne.symm h)]
    simp [h]

/-- The direct sum of copies of `ℤ_[p]` indexed by the positive natural numbers. -/
abbrev pAdicDirectSum (p : ℕ) [Fact p.Prime] :=
  DirectSum ℕ+ (fun _ : ℕ+ => PadicInt p)

/-- The `p`-adic integers, hence each summand of `pAdicDirectSum p`, are derived complete with
respect to the ideal generated by `p`. -/
theorem pAdicInt_summand_isDerivedComplete (p : ℕ) [Fact p.Prime]
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat (PadicInt p)))] :
    IsDerivedCompleteModule (Ideal.span {(p : PadicInt p)})
      (ModuleCat.of (PadicInt p) (PadicInt p)) := by
  let I : Ideal (PadicInt p) := Ideal.span {(p : PadicInt p)}
  have hcomplete : IsAdicComplete I (PadicInt p) := by
    rw [show I = IsLocalRing.maximalIdeal (PadicInt p) from
      PadicInt.maximalIdeal_eq_span_p.symm]
    infer_instance
  exact (isDerivedCompleteModule_of_isAdicComplete_and_adicCompletion_surjective
    (PadicInt p) I (PadicInt p)).1 hcomplete

/-- The direct sum of the derived complete modules `ℤ_[p]` is not itself derived complete with
respect to the ideal generated by `p`. -/
theorem pAdicDirectSum_not_isDerivedComplete (p : ℕ) [Fact p.Prime]
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat (PadicInt p)))] :
    ¬ IsDerivedCompleteModule (Ideal.span {(p : PadicInt p)})
      (ModuleCat.of (PadicInt p) (pAdicDirectSum p)) := by
  classical
  intro hderived
  let D := pAdicDirectSum p
  let I : Ideal (PadicInt p) := Ideal.span {(p : PadicInt p)}
  have hrec : ∀ f ∈ I,
      Function.Bijective (DerivedCompleteRecurrence.recurrence (M := D) f) :=
    (DerivedCompleteRecurrence.isDerivedCompleteModule_iff_forall_bijective_recurrence
      I (ModuleCat.of (PadicInt p) D)).mp hderived
  have hp : (p : PadicInt p) ∈ I := Ideal.subset_span (Set.mem_singleton _)
  let y : ℕ → D := fun n => DirectSum.of (fun _ : ℕ+ => PadicInt p)
    ⟨n + 1, Nat.succ_pos n⟩ 1
  obtain ⟨a, ha⟩ := (hrec _ hp).2 y
  have hs : ((a 0).support.card : ENat) < ENat.card ℕ+ := by simp
  obtain ⟨i, hi⟩ := Finset.exists_not_mem_of_card_lt_enatCard hs
  have hcoord : ∀ n, a n i - (p : PadicInt p) * a (n + 1) i =
      if n + 1 = i.val then 1 else 0 := by
    intro n
    have hn := congrFun ha n
    change a n - (p : PadicInt p) • a (n + 1) = y n at hn
    have h := congrArg (fun z : D => z i) hn
    have hyi : y n i = if n + 1 = i.val then 1 else 0 := by
      show (DirectSum.of (fun _ : ℕ+ => PadicInt p)
        (⟨n + 1, Nat.succ_pos n⟩ : ℕ+) (1 : PadicInt p)) i = _
      exact directSum_basis_eval p ⟨n + 1, Nat.succ_pos n⟩ i
    change a n i - ((p : PadicInt p) • a (n + 1)) i = y n i at h
    rw [DirectSum.smul_apply, hyi] at h
    simpa only [smul_eq_mul] using h
  exact p_mul_one_add_p_ne_zero p (a i.val i) (i.val - 1)
    ((recurrence_impulse_formula (p : PadicInt p) i.val i.property
      (fun n => a n i) hcoord).symm.trans (DFinsupp.notMem_support_iff.mp hi))

end Stacks.Examples

end
