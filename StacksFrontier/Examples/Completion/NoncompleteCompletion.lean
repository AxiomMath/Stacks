module

public import StacksFrontier.Examples.Completion.CountableVarLocalization
public import StacksFrontier.RingTheory.AdicCompletion.Criteria

/-!
# The completion of a local ring need not be adically complete

Let `A` be the localization of the polynomial ring in countably many variables over a field at
its ideal of variables, `n ⊆ A` the maximal ideal and `S` the `n`-adic completion. Then `S` is
not `n`-adically complete as an `A`-module, and its maximal ideal is strictly larger than `nS`.

## Main results

* `Stacks.Examples.CountableVarLocalization.maximalIdeal_ne_map`: the maximal ideal of `S` is
  not the ideal generated by the image of `n`.
* `Stacks.Examples.CountableVarLocalization.completion_not_adically_complete`: `S` is not
  `n`-adically complete.

## Implementation notes

`IsAdicComplete T.n T.S` is completeness for the `n`-adic module topology on `S`, not for the
topology of the maximal ideal of `S` itself. The maximal ideal of `S` is `m'`, the kernel of the
constant-term homomorphism.

## References

* [Stacks Project, Tag 05JC](https://stacks.math.columbia.edu/tag/05JC)
-/

@[expose] public section

namespace Stacks.Examples

namespace CountableVarLocalization

private theorem coeff_series_mul_var_zero (T : CountableVarLocalization) (s : T.S)
    (j i : ℕ) (hij : i ≠ j) :
    MvPowerSeries.coeff (Finsupp.single j j)
      (T.series (s * AdicCompletion.of T.n T.A
        (algebraMap T.P T.A (MvPolynomial.X i))) ) = 0 := by
  rw [T.series_mul, T.series_of_mvPolynomial, MvPolynomial.coe_X, MvPowerSeries.X,
    MvPowerSeries.coeff_mul_monomial, ite_eq_right_iff]
  intro h
  simpa [hij] using h i

/-- The series which has coefficient `1` at each monomial `xⱼ^j` with `j ≥ 1` and `0`
elsewhere. -/
private noncomputable def witnessSeries (T : CountableVarLocalization) :
    MvPowerSeries ℕ T.k := by
  classical
  exact fun x => if ∃ n : ℕ, x = Finsupp.single (n + 1) (n + 1) then 1 else 0

private theorem witnessSeries_finite (T : CountableVarLocalization) (d : ℕ) :
    {x : ℕ →₀ ℕ | Finsupp.degree x = d ∧
      MvPowerSeries.coeff x (witnessSeries T) ≠ 0}.Finite := by
  classical
  apply Set.Finite.subset (Set.finite_singleton (Finsupp.single d d))
  intro x hx
  have hcoeff : (witnessSeries T) x ≠ 0 := hx.2
  obtain ⟨n, hn⟩ : ∃ n : ℕ, x = Finsupp.single (n + 1) (n + 1) := by
    simpa [witnessSeries] using hcoeff
  have hd : d = n + 1 := by simpa [hn] using hx.1.symm
  subst d
  exact hn

private theorem witnessSeries_coeff_zero (T : CountableVarLocalization) :
    MvPowerSeries.coeff (0 : ℕ →₀ ℕ) (witnessSeries T) = 0 := by
  classical
  simp only [witnessSeries, MvPowerSeries.coeff_apply, ite_eq_right_iff, one_ne_zero]
  rintro ⟨n, hn⟩
  exact (by simp : Finsupp.single (n + 1) (n + 1) ≠ (0 : ℕ →₀ ℕ)) hn.symm

private theorem witnessSeries_coeff_diag (T : CountableVarLocalization) {j : ℕ}
    (hj : 0 < j) :
    MvPowerSeries.coeff (Finsupp.single j j) (witnessSeries T) = 1 := by
  classical
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj.ne'
  change (if ∃ m : ℕ, Finsupp.single (n + 1) (n + 1) =
    Finsupp.single (m + 1) (m + 1) then (1 : T.k) else 0) = 1
  exact ite_eq_left_of_eq_true _ _ (eq_true ⟨n, rfl⟩)

private theorem n_map_completion_eq_span (T : CountableVarLocalization) :
    T.n.map (AdicCompletion.of T.n T.A) =
      Ideal.span (Set.range (fun i : ℕ => AdicCompletion.of T.n T.A
        (algebraMap T.P T.A (MvPolynomial.X i))) : Set T.S) := by
  change Ideal.map (algebraMap T.A T.S)
      (Ideal.map (algebraMap T.P T.A) (Ideal.span (Set.range MvPolynomial.X))) = _
  rw [Ideal.map_map (algebraMap T.P T.A) (algebraMap T.A T.S), Ideal.map_span,
    ← Set.range_comp' ((algebraMap T.A T.S).comp (algebraMap T.P T.A)) MvPolynomial.X]
  simp [AdicCompletion.algebraMap_apply]

/-- The maximal ideal of the completion of `A` is not extended from `A`. -/
theorem maximalIdeal_ne_map (T : CountableVarLocalization) :
    T.m' ≠ T.n.map (AdicCompletion.of T.n T.A) := by
  classical
  obtain ⟨s, hs⟩ :=
    T.existsUnique_series_of_degreewise_finite (witnessSeries T) (witnessSeries_finite T)
  have hs_mem : s ∈ T.m' := by
    change T.constantTerm.val s = 0
    rw [T.constantTerm_eq_coeff_zero, hs.1]
    exact witnessSeries_coeff_zero T
  intro heq
  have hs_ext : s ∈ T.n.map (AdicCompletion.of T.n T.A) := heq ▸ hs_mem
  rw [n_map_completion_eq_span T] at hs_ext
  obtain ⟨c, hc⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp hs_ext
  let j := c.support.sup id + 1
  have hj : 0 < j := Nat.succ_pos _
  have hjnot : j ∉ c.support := fun h => Nat.not_succ_le_self _ (Finset.le_sup (f := id) h)
  have hcoeff_s : MvPowerSeries.coeff (Finsupp.single j j) (T.series s) = 1 := by
    rw [hs.1]
    exact witnessSeries_coeff_diag T hj
  have hcoeff_zero : MvPowerSeries.coeff (Finsupp.single j j) (T.series s) = 0 := by
    rw [← hc, Finsupp.sum, ← T.seriesHom_apply, map_sum, map_sum]
    refine Finset.sum_eq_zero fun i hi => ?_
    exact coeff_series_mul_var_zero T (c i) j i fun h => hjnot (h ▸ hi)
  exact zero_ne_one (hcoeff_zero.symm.trans hcoeff_s)

private lemma evalₐ_one_ker_eq_maximalIdeal (T : CountableVarLocalization) :
    RingHom.ker (AdicCompletion.evalₐ T.n 1).toRingHom =
      IsLocalRing.maximalIdeal T.S := by
  let _ : IsLocalRing T.A := CountableVarLocalization.A_isLocal T
  let _ : IsLocalRing T.S := CountableVarLocalization.S_isLocal T
  have hnmax : T.n.IsMaximal := by
    simpa [T.n_eq_maximalIdeal] using IsLocalRing.maximalIdeal.isMaximal T.A
  let _ : (T.n ^ 1).IsMaximal := by simpa using hnmax
  let _ : Field (T.A ⧸ T.n ^ 1) := Ideal.Quotient.field (T.n ^ 1)
  exact @IsLocalRing.eq_maximalIdeal T.S _ (CountableVarLocalization.S_isLocal T)
    _ (RingHom.ker_isMaximal_of_surjective (AdicCompletion.evalₐ T.n 1).toRingHom
      (AdicCompletion.surjective_evalₐ T.n 1))

private lemma eval_one_eq_zero_iff_evalₐ_one_eq_zero
    (T : CountableVarLocalization) (x : T.S) :
    AdicCompletion.eval T.n T.A 1 x = 0 ↔ AdicCompletion.evalₐ T.n 1 x = 0 := by
  have hpow : T.n ^ 1 • (⊤ : Ideal T.A) = T.n ^ 1 := by simp
  have hinj : Function.Injective (Ideal.Quotient.factor (le_of_eq hpow)) := by
    simpa [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker]
      using Ideal.map_mk_eq_bot_of_le (le_of_eq hpow.symm)
  simpa [← AdicCompletion.factor_eval_eq_evalₐ] using (map_eq_zero_iff _ hinj).symm

/-- The completion of `A` at its maximal ideal is not complete for the `n`-adic topology induced
from `A`. -/
theorem completion_not_adically_complete (T : CountableVarLocalization) :
    ¬ IsAdicComplete T.n T.S := by
  let _ : IsScalarTower T.A T.S T.S :=
    IsScalarTower.of_algebraMap_eq' (R := T.A) (S := T.S) (A := T.S) (by simp)
  intro hcomplete
  have hpow := (AdicCompletion.isAdicComplete_iff_pow_smul_top_eq_ker_eval T.n T.A).mp
    hcomplete 1 (by omega)
  have heq : T.m' = T.n.map (AdicCompletion.of T.n T.A) := by
    ext x
    rw [← T.maximalIdeal_eq_ker_constantTerm, ← evalₐ_one_ker_eq_maximalIdeal T,
      RingHom.mem_ker]
    change AdicCompletion.evalₐ T.n 1 x = 0 ↔ _
    rw [← eval_one_eq_zero_iff_evalₐ_one_eq_zero T x]
    change AdicCompletion.eval T.n T.A 1 x = 0 ↔
      x ∈ (T.n.map (algebraMap T.A T.S)).restrictScalars T.A
    rw [← Ideal.smul_top_eq_map]
    simp only [pow_one] at hpow
    rw [hpow]
    simp [AdicCompletion.eval, LinearMap.mem_ker]
  exact T.maximalIdeal_ne_map heq

end CountableVarLocalization

end Stacks.Examples

end
