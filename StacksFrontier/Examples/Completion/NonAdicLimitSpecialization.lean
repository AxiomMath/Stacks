module

public import Mathlib.Algebra.Polynomial.Div
public import Mathlib.RingTheory.MvPowerSeries.Evaluation
public import Mathlib.Topology.UniformSpace.DiscreteUniformity
public import StacksFrontier.Examples.Completion.NonAdicLimitPlaneSections
public import StacksFrontier.Examples.Completion.NonAdicLimitTopology
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The specialization of `A = k[x,y][[s,t]]/(xs − yt)` onto a truncated plane

Stacks 0EH8's remaining clause is `gᵉ ∉ I·M`. This file builds the ring map that detects it:
for a fixed exponent `e`, a specialization

`ρ : A ⟶ R[x,y]`, `x ↦ x`, `y ↦ y`, `s ↦ y·z`, `t ↦ x·z`, where `R = k[T]/(Tᵉ⁺¹)`
and `z` is the image of `T`.

It is a ring map because `xs − yt ↦ x·(y z) − y·(x z) = 0`, and it is defined on *power*
series in `s` and `t` — not merely polynomials — because `z` is nilpotent, so the images of
`s` and `t` are nilpotent and every power series in them has only finitely many nonzero
terms. That is exactly what `MvPowerSeries.eval₂Hom` needs.

Under `ρ` the rational function `g = t/x = s/y` becomes `z`: `ρ(t) = x·z` and `ρ(x) = x`.
The exponent is chosen so that `zᵉ ≠ 0` while `zᵉ⁺¹ = 0`: the first makes `gᵉ` survive, the
second makes `I^(e+1)` die, which is what lets `ρ` be read on the `(e+1)`-st term of the
quotient tower.

## Main definitions

* `Stacks.Examples.NonAdicLimit.truncCoeff` — the ring `R = k[T]/(Tᵉ⁺¹)`.
* `Stacks.Examples.NonAdicLimit.truncParam` — the image `z` of `T` in it.

## Main results

* `Stacks.Examples.NonAdicLimit.exists_mvPowerSeries_eval` — a power series ring maps to any
  ring in which the chosen images of the variables are nilpotent.
* `Stacks.Examples.NonAdicLimit.truncParam_pow_succ`,
  `.truncParam_pow_ne_zero` — `zᵉ⁺¹ = 0` and `zᵉ ≠ 0`.
* `Stacks.Examples.NonAdicLimit.exists_specialization` — the specialization `ρ`, with its four
  values on the coordinates of `A`.
-/

@[expose] public noncomputable section

universe u

open AlgebraicGeometry CategoryTheory Opposite

namespace Stacks.Examples.NonAdicLimit

/-! ### Evaluating a power series ring at nilpotent elements -/

/-- **A power series ring maps to any ring in which the images of the variables are
nilpotent.** For finitely many variables, nilpotent images are topologically nilpotent for the
discrete uniformity, so `MvPowerSeries.eval₂Hom` applies: each power series has only finitely
many terms whose image is nonzero. -/
@[ega "0 19.3.4.1" "(ii)"]
theorem exists_mvPowerSeries_eval {σ : Type*} [Finite σ] {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (a : σ → S) (ha : ∀ i, IsNilpotent (a i)) :
    ∃ F : MvPowerSeries σ R →+* S,
      (∀ r, F (MvPowerSeries.C r) = φ r) ∧ (∀ i, F (MvPowerSeries.X i) = a i) := by
  let : UniformSpace R := ⊥
  let : UniformSpace S := ⊥
  have hφ : Continuous φ := continuous_of_discreteTopology
  have he : MvPowerSeries.HasEval a :=
    ⟨fun i => (ha i).isTopologicallyNilpotent, by simp⟩
  refine ⟨MvPowerSeries.eval₂Hom hφ he, fun r => ?_, fun i => ?_⟩
  · rw [MvPowerSeries.coe_eval₂Hom, MvPowerSeries.eval₂_C]
  · rw [MvPowerSeries.coe_eval₂Hom, MvPowerSeries.eval₂_X]

/-! ### The truncated coefficient ring `R = k[T]/(Tᵉ⁺¹)` -/

variable (k : Type u) [Field k]

/-- `R = k[T]/(Tᵉ⁺¹)`, the coefficient ring of the specialization. -/
abbrev truncCoeff (e : ℕ) : Type u :=
  Polynomial k ⧸ Ideal.span {(Polynomial.X : Polynomial k) ^ (e + 1)}

/-- `z`, the image of `T` in `R = k[T]/(Tᵉ⁺¹)`. It is nilpotent of order exactly `e + 1`. -/
def truncParam (e : ℕ) : truncCoeff k e :=
  Ideal.Quotient.mk _ Polynomial.X

/-- **`zᵉ⁺¹ = 0`.** -/
theorem truncParam_pow_succ (e : ℕ) : truncParam k e ^ (e + 1) = 0 := by
  rw [truncParam, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (by simp)

/-- **`zᵉ ≠ 0`.** The ideal is generated by `Tᵉ⁺¹`, and `Tᵉ⁺¹ ∤ Tᵉ`. -/
theorem truncParam_pow_ne_zero (e : ℕ) : truncParam k e ^ e ≠ 0 := by
  intro hzero
  rw [truncParam, ← map_pow, Ideal.Quotient.eq_zero_iff_mem,
    Ideal.mem_span_singleton] at hzero
  have hh := Polynomial.X_pow_dvd_iff.mp hzero e (Nat.lt_succ_self e)
  simp at hh

/-- `z` is nilpotent. -/
theorem isNilpotent_truncParam (e : ℕ) : IsNilpotent (truncParam k e) :=
  ⟨e + 1, truncParam_pow_succ k e⟩

/-! ### The specialization `ρ : A ⟶ R[x,y]` -/

/-- **The specialization of Stacks 0EH8's ring onto a truncated plane.** For any commutative
ring `R` with a nilpotent element `z` and a map `k ⟶ R`, there is a ring map

`ρ : A = k[x,y][[s,t]]/(xs − yt) ⟶ R[x,y]`

with `ρ(x) = x`, `ρ(y) = y`, `ρ(s) = y·z` and `ρ(t) = x·z`. It is well defined on the
*quotient* because `x·(y z) − y·(x z) = 0`, and on *power* series because `y z` and `x z` are
nilpotent.

Under `ρ` the ideal `I = (s,t)` lands inside `(z)`, so `I^(e+1)` dies as soon as
`z^(e+1) = 0`; and the rational function `g = t/x` becomes `z`, since `ρ(t) = x·ρ(z)` with
`ρ(x) = x` regular. -/
theorem exists_specialization {R : Type u} [CommRing R] (ι : k →+* R) (z : R)
    (hz : IsNilpotent z) :
    ∃ ρ : exampleRing k →+* Stacks.CoordinatePlane.planeRing R,
      ρ (coordX k) = MvPolynomial.X 0 ∧
      ρ (coordY k) = MvPolynomial.X 1 ∧
      ρ (coordS k) = MvPolynomial.X 1 * MvPolynomial.C z ∧
      ρ (coordT k) = MvPolynomial.X 0 * MvPolynomial.C z := by
  classical
  have hnil (w : Stacks.CoordinatePlane.planeRing R) : IsNilpotent (w * MvPolynomial.C z) := by
    obtain ⟨m, hm⟩ := hz
    exact ⟨m, by rw [mul_pow, ← map_pow, hm, map_zero, mul_zero]⟩
  obtain ⟨F, hFC, hFX⟩ := exists_mvPowerSeries_eval (MvPolynomial.map ι)
    (fun i : Fin 2 => if i = 0 then MvPolynomial.X 1 * MvPolynomial.C z
      else (MvPolynomial.X 0 * MvPolynomial.C z : Stacks.CoordinatePlane.planeRing R))
    (by intro i; split <;> exact hnil _)
  have h0 : F (MvPowerSeries.X 0) =
      (MvPolynomial.X 1 * MvPolynomial.C z : Stacks.CoordinatePlane.planeRing R) := by
    exact (hFX 0).trans (ite_eq_left rfl)
  have h1 : F (MvPowerSeries.X 1) =
      (MvPolynomial.X 0 * MvPolynomial.C z : Stacks.CoordinatePlane.planeRing R) := by
    exact (hFX 1).trans (ite_eq_right (by decide))
  have hrel : F (relation k) = 0 := by
    rw [relation, map_sub, map_mul, map_mul, ambientX, ambientY, ambientS, ambientT,
      hFC, hFC, h0, h1, MvPolynomial.map_X, MvPolynomial.map_X]
    ring
  refine ⟨Ideal.Quotient.lift _ F (fun w hw => ?_), ?_, ?_, ?_, ?_⟩
  · refine Submodule.span_induction (p := fun v _ => F v = 0) ?_ ?_ ?_ ?_ hw
    · intro v hv
      rw [Set.mem_singleton_iff] at hv
      rw [hv, hrel]
    · simp
    · intro p q _ _ hp hq
      rw [map_add, hp, hq, add_zero]
    · intro p q _ hq
      rw [smul_eq_mul, map_mul, hq, mul_zero]
  · simp [coordX, ambientX, hFC]
  · simp [coordY, ambientY, hFC]
  · simp [coordS, ambientS, h0]
  · simp [coordT, ambientT, h1]

end Stacks.Examples.NonAdicLimit

end
