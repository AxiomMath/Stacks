module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.MvPowerSeries.Equiv

/-!
# The localization of a polynomial ring in countably many variables at its variable ideal

Let `k` be a field, `P = k[x₀, x₁, …]` the polynomial ring in countably many variables, `m ⊆ P`
the ideal generated by the variables, `A = Pₘ` the localization of `P` at `m` and `n ⊆ A` the
maximal ideal of `A`. This file sets up the `n`-adic completion `S` of `A` and its arithmetic:
`S` is identified with the `m`-adic completion of `P`, so that an element of `S` has a formal
power series of coefficients, and `S` is a local ring whose maximal ideal is the kernel of the
constant-term homomorphism.

The identification of the two completions is the one specified by its effect on polynomials: on
each stage `A/nʲ ≅ P/mʲ`, because localizing at `m` does not change the quotients by powers of
`m`. The series attached to an element of `S` reads off, in each multidegree, the coefficient of
any polynomial representing a high enough stage; conversely a series whose nonzero coefficients
are finite in number in each total degree is the series of exactly one element of `S`, obtained
by truncating it. Finally an element of `S` with nonzero constant term is a unit, because it is
a unit at each stage and the inverses are compatible, so `S` is local with maximal ideal the
kernel of the constant term.

This is the common ground for the Stacks 110.7 counterexamples: the maximal ideal of `S` is
strictly larger than the ideal generated by `n`, so the completion of a local ring need not be
adically complete.

## Main definitions

* `Stacks.Examples.CountableVarLocalization`: the situation, whose only datum is the
  coefficient field `k`.
* `Stacks.Examples.CountableVarLocalization.P`, `.m`, `.A`, `.n`, `.S`, `.m'`: the polynomial
  ring, its variable ideal, the localization, its maximal ideal, the completion, and the ideal
  of elements of the completion with zero constant term.
* `Stacks.Examples.CountableVarLocalization.completionEquiv`: the identification of `S` with
  the `m`-adic completion of `P`, bundled with its characterization on polynomials.
* `Stacks.Examples.CountableVarLocalization.series`: the formal power series of coefficients of
  an element of the completion.
* `Stacks.Examples.CountableVarLocalization.constantTerm`: the constant-term homomorphism
  `S →+* k`, bundled with its compatibility with `MvPolynomial.constantCoeff`.

## Main results

* `Stacks.Examples.CountableVarLocalization.m_isMaximal` and `.n_eq_maximalIdeal`: the variable
  ideal is maximal and its extension is the maximal ideal of the localization.
* `Stacks.Examples.CountableVarLocalization.finite_coefficients_of_degree` and
  `.existsUnique_series_of_degreewise_finite`: elements of `S` correspond exactly to series
  with finitely many nonzero coefficients in each total degree.
* `Stacks.Examples.CountableVarLocalization.S_isLocal` and `.maximalIdeal_eq_ker_constantTerm`:
  the completion is a local ring whose maximal ideal is `m'`.

## Implementation notes

Mathlib's `AdicCompletion` is the inverse limit of the quotients by the powers of an ideal,
realized as compatible families. The equivalence `completionEquiv` and the homomorphism
`constantTerm` are packaged as subtypes bundling the characterizing property, so that the
counterexamples depend only on that property and not on the particular construction. A formal
power series is used only to name the coefficients of an element of `S`; finite support in each
total degree is what distinguishes these series from arbitrary multivariate power series.

## References

* [Stacks Project, Tag 05JC](https://stacks.math.columbia.edu/tag/05JC)
-/

@[expose] public noncomputable section

namespace Stacks.Examples

universe u

/-- The situation of Stacks 110.7: a polynomial ring in countably many variables over a field,
localized at its ideal of variables, and the completion of that localization. Its only datum is
the coefficient field. -/
structure CountableVarLocalization where
  /-- The field of coefficients. -/
  k : Type u
  [field : Field k]

attribute [instance] CountableVarLocalization.field

namespace CountableVarLocalization

/-- Polynomials in countably many variables over the chosen field. -/
abbrev P (T : CountableVarLocalization) := MvPolynomial ℕ T.k

/-- The ideal generated by all the variables. -/
abbrev m (T : CountableVarLocalization) : Ideal T.P :=
  MvPolynomial.idealOfVars ℕ T.k

private theorem ker_constantCoeff_eq_m (T : CountableVarLocalization) :
    RingHom.ker (MvPolynomial.constantCoeff : T.P →+* T.k) = T.m := by
  ext p
  rw [RingHom.mem_ker]
  show p.coeff 0 = 0 ↔ p ∈ MvPolynomial.idealOfVars ℕ T.k
  rw [← pow_one (MvPolynomial.idealOfVars ℕ T.k), MvPolynomial.mem_pow_idealOfVars_iff' 1 p]
  simp [Finsupp.degree_eq_zero_iff]

/-- The variable ideal is maximal. -/
theorem m_isMaximal (T : CountableVarLocalization) : T.m.IsMaximal := by
  rw [← ker_constantCoeff_eq_m T]
  exact RingHom.ker_isMaximal_of_surjective _ fun x =>
    ⟨MvPolynomial.C x, MvPolynomial.constantCoeff_C _ _⟩

/-- The variable ideal is prime. -/
instance m_isPrime (T : CountableVarLocalization) : T.m.IsPrime :=
  T.m_isMaximal.isPrime

/-- Localization of the polynomial ring at its variable ideal. -/
abbrev A (T : CountableVarLocalization) := Localization.AtPrime T.m

/-- The localization is a local ring. -/
instance A_isLocal (T : CountableVarLocalization) : IsLocalRing T.A := inferInstance

/-- The extended variable ideal in the localization. -/
abbrev n (T : CountableVarLocalization) : Ideal T.A :=
  T.m.map (algebraMap T.P T.A)

/-- The extended variable ideal is the maximal ideal of the localization. -/
theorem n_eq_maximalIdeal (T : CountableVarLocalization) :
    T.n = IsLocalRing.maximalIdeal T.A := by
  simpa [n, m, A] using
    (IsLocalization.AtPrime.map_eq_maximalIdeal (R := T.P) (Rₚ := T.A) T.m)

/-- The completion of the localization at its extended variable ideal. -/
abbrev S (T : CountableVarLocalization) := AdicCompletion T.n T.A

/-- Localizing at `m` does not change the quotient by the `j`-th power of `m`. -/
private def localStageEquiv (T : CountableVarLocalization) (j : ℕ) :
    (T.A ⧸ (T.n ^ j • ⊤ : Ideal T.A)) ≃+*
      (T.P ⧸ (T.m ^ j • ⊤ : Ideal T.P)) := by
  letI : T.m.IsMaximal := T.m_isMaximal
  let eA : T.A ⧸ (T.n ^ j • ⊤ : Ideal T.A) ≃+* T.A ⧸ IsLocalRing.maximalIdeal T.A ^ j :=
    Ideal.quotEquivOfEq (by rw [T.n_eq_maximalIdeal]; simp [smul_eq_mul, Ideal.mul_top])
  let eP : T.P ⧸ (T.m ^ j • ⊤ : Ideal T.P) ≃+* T.P ⧸ T.m ^ j :=
    Ideal.quotEquivOfEq (by simp [smul_eq_mul, Ideal.mul_top])
  exact eA.trans ((IsLocalization.AtPrime.equivQuotMaximalIdealPow T.m T.A j).toRingEquiv.symm)
    |>.trans eP.symm

private lemma localStageEquiv_symm_apply_mk (T : CountableVarLocalization) (j : ℕ)
    (p : T.P) :
    (localStageEquiv T j).symm (Ideal.Quotient.mk (T.m ^ j • ⊤) p) =
      Ideal.Quotient.mk (T.n ^ j • ⊤) (algebraMap T.P T.A p) := by
  have : T.m.IsMaximal := T.m_isMaximal
  show Ideal.quotEquivOfEq (show IsLocalRing.maximalIdeal T.A ^ j = T.n ^ j • ⊤ by
      rw [T.n_eq_maximalIdeal]
      simp only [smul_eq_mul, Ideal.mul_top])
      ((IsLocalization.AtPrime.equivQuotMaximalIdealPow T.m T.A j)
        (Ideal.Quotient.mk (T.m ^ j) p)) = _
  rw [IsLocalization.AtPrime.equivQuotMaximalIdealPow_apply_mk]
  simp only [smul_eq_mul, Ideal.Quotient.mk_algebraMap]
  rw [IsScalarTower.algebraMap_eq T.P T.A
      (T.A ⧸ IsLocalRing.maximalIdeal T.A ^ j),
    IsScalarTower.algebraMap_eq T.P T.A (T.A ⧸ (T.n ^ j * ⊤ : Ideal T.A))]
  simp only [RingHom.comp_apply, Ideal.Quotient.algebraMap_eq,
    Ideal.quotEquivOfEq_mk]

private lemma localStageEquiv_apply_mk (T : CountableVarLocalization) (j : ℕ)
    (p : T.P) :
    localStageEquiv T j (Ideal.Quotient.mk (T.n ^ j • ⊤) (algebraMap T.P T.A p)) =
      Ideal.Quotient.mk (T.m ^ j • ⊤) p := by
  rw [← localStageEquiv_symm_apply_mk T j p, RingEquiv.apply_symm_apply]

private lemma localStageEquiv_transition (T : CountableVarLocalization)
    {i j : ℕ} (hij : i ≤ j) (x : T.A ⧸ (T.n ^ j • ⊤ : Ideal T.A)) :
    localStageEquiv T i (AdicCompletion.transitionMap T.n T.A hij x) =
      AdicCompletion.transitionMap T.m T.P hij (localStageEquiv T j x) := by
  obtain ⟨y, rfl⟩ := (localStageEquiv T j).symm.surjective x
  refine Quotient.inductionOn' y fun p => ?_
  show localStageEquiv T i
      (AdicCompletion.transitionMap T.n T.A hij
        ((localStageEquiv T j).symm (Ideal.Quotient.mk (T.m ^ j • ⊤) p))) =
    AdicCompletion.transitionMap T.m T.P hij
      (localStageEquiv T j ((localStageEquiv T j).symm
        (Ideal.Quotient.mk (T.m ^ j • ⊤) p)))
  rw [localStageEquiv_symm_apply_mk]
  simp only [AdicCompletion.transitionMap_ideal_mk, localStageEquiv_apply_mk]

/-- Applying `localStageEquiv` stagewise sends a compatible family over `A` to one over `P`. -/
private def completionForward (T : CountableVarLocalization) (x : T.S) :
    AdicCompletion T.m T.P :=
  ⟨fun j => localStageEquiv T j (x.val j), by
    intro i j hij
    calc
      AdicCompletion.transitionMap T.m T.P hij (localStageEquiv T j (x.val j)) =
          localStageEquiv T i (AdicCompletion.transitionMap T.n T.A hij (x.val j)) :=
        (localStageEquiv_transition T hij (x.val j)).symm
      _ = localStageEquiv T i (x.val i) := congrArg _ (x.property hij)⟩

/-- The inverse of `completionForward`, again applied stagewise. -/
private def completionBackward (T : CountableVarLocalization)
    (y : AdicCompletion T.m T.P) : T.S :=
  ⟨fun j => (localStageEquiv T j).symm (y.val j), by
    intro i j hij
    apply (localStageEquiv T i).injective
    calc
      localStageEquiv T i
          (AdicCompletion.transitionMap T.n T.A hij
            ((localStageEquiv T j).symm (y.val j))) =
          AdicCompletion.transitionMap T.m T.P hij
            (localStageEquiv T j ((localStageEquiv T j).symm (y.val j))) :=
        localStageEquiv_transition T hij ((localStageEquiv T j).symm (y.val j))
      _ = AdicCompletion.transitionMap T.m T.P hij (y.val j) :=
        congrArg (fun z => AdicCompletion.transitionMap T.m T.P hij z)
          ((localStageEquiv T j).apply_symm_apply (y.val j))
      _ = y.val i := y.property hij
      _ = localStageEquiv T i ((localStageEquiv T i).symm (y.val i)) :=
        ((localStageEquiv T i).apply_symm_apply (y.val i)).symm⟩

private def completionRingEquiv (T : CountableVarLocalization) :
    T.S ≃+* AdicCompletion T.m T.P where
  toFun := completionForward T
  invFun := completionBackward T
  left_inv x := Subtype.ext <| funext fun j => (localStageEquiv T j).symm_apply_apply (x.val j)
  right_inv y := Subtype.ext <| funext fun j => (localStageEquiv T j).apply_symm_apply (y.val j)
  map_mul' _ _ := Subtype.ext <| funext fun j => (localStageEquiv T j).map_mul _ _
  map_add' _ _ := Subtype.ext <| funext fun j => (localStageEquiv T j).map_add _ _

/-- The localization and polynomial completions have a compatible equivalence. -/
theorem exists_completionEquiv (T : CountableVarLocalization) :
    Nonempty { e : T.S ≃+* AdicCompletion T.m T.P //
      ∀ p : T.P, e (AdicCompletion.of T.n T.A (algebraMap T.P T.A p)) =
        AdicCompletion.of T.m T.P p } := by
  refine ⟨⟨completionRingEquiv T, fun p => Subtype.ext <| funext fun j => ?_⟩⟩
  show localStageEquiv T j
      ((AdicCompletion.of T.n T.A (algebraMap T.P T.A p)).val j) =
    (AdicCompletion.of T.m T.P p).val j
  simp only [AdicCompletion.of_apply, Submodule.mkQ_apply]
  exact localStageEquiv_apply_mk T j p

/-- The canonical identification with compatible families of polynomial quotients,
characterized by the image of each polynomial. -/
def completionEquiv (T : CountableVarLocalization) :
    { e : T.S ≃+* AdicCompletion T.m T.P //
      ∀ p : T.P, e (AdicCompletion.of T.n T.A (algebraMap T.P T.A p)) =
        AdicCompletion.of T.m T.P p } :=
  Classical.choice (exists_completionEquiv T)

/-- The formal series associated to an element of the completion. -/
def series (T : CountableVarLocalization) (s : T.S) : MvPowerSeries ℕ T.k :=
  MvPowerSeries.toAdicCompletionInv ℕ T.k (T.completionEquiv.val s)

/-- Each homogeneous degree has only finitely many nonzero coefficients. -/
theorem finite_coefficients_of_degree (T : CountableVarLocalization)
    (s : T.S) (d : ℕ) :
    { I : ℕ →₀ ℕ | Finsupp.degree I = d ∧ MvPowerSeries.coeff I (T.series s) ≠ 0 }.Finite := by
  classical
  let q := Quotient.out ((T.completionEquiv.val s).val (d + 1))
  refine q.support.finite_toSet.subset fun I hI => MvPolynomial.mem_support_iff.2 ?_
  show (Quotient.out ((T.completionEquiv.val s).val (d + 1))).coeff I ≠ 0
  rw [← hI.1]
  simpa [series, MvPowerSeries.coeff_toAdicCompletionInv] using hI.2

private def seriesSupportBelow (T : CountableVarLocalization) (f : MvPowerSeries ℕ T.k)
    (n : ℕ) : Set (ℕ →₀ ℕ) :=
  {I | Finsupp.degree I < n ∧ MvPowerSeries.coeff I f ≠ 0}

private lemma seriesSupportBelow_finite (T : CountableVarLocalization)
    (f : MvPowerSeries ℕ T.k) (hf : ∀ d : ℕ,
      {I : ℕ →₀ ℕ | Finsupp.degree I = d ∧ MvPowerSeries.coeff I f ≠ 0}.Finite)
    (n : ℕ) : (seriesSupportBelow T f n).Finite := by
  classical
  apply Set.Finite.subset
    (Set.Finite.biUnion (Set.finite_Iio n)
      (t := fun d => {I | Finsupp.degree I = d ∧ MvPowerSeries.coeff I f ≠ 0})
      (fun d _ => hf d))
  exact fun I hI => Set.mem_biUnion (x := Finsupp.degree I) hI.1 ⟨rfl, hI.2⟩

private def seriesTruncation (T : CountableVarLocalization)
    (f : MvPowerSeries ℕ T.k) (n : ℕ)
    (hf : ∀ d : ℕ,
      {I : ℕ →₀ ℕ | Finsupp.degree I = d ∧ MvPowerSeries.coeff I f ≠ 0}.Finite) : T.P :=
  ∑ I ∈ (seriesSupportBelow_finite T f hf n).toFinset,
    MvPolynomial.monomial I (MvPowerSeries.coeff I f)

private lemma coeff_seriesTruncation (T : CountableVarLocalization)
    (f : MvPowerSeries ℕ T.k) (n : ℕ)
    (hf : ∀ d : ℕ,
      {I : ℕ →₀ ℕ | Finsupp.degree I = d ∧ MvPowerSeries.coeff I f ≠ 0}.Finite)
    (I : ℕ →₀ ℕ) :
    (seriesTruncation T f n hf).coeff I =
      if Finsupp.degree I < n then MvPowerSeries.coeff I f else 0 := by
  classical
  by_cases hd : Finsupp.degree I < n <;>
    by_cases hc : MvPowerSeries.coeff I f = 0 <;>
    simp [seriesTruncation, seriesSupportBelow, hd, hc, MvPolynomial.coeff_sum,
      MvPolynomial.coeff_monomial, Finset.sum_ite_eq']

private lemma seriesTruncation_sub_mem_pow (T : CountableVarLocalization)
    (f : MvPowerSeries ℕ T.k) (hf : ∀ d : ℕ,
      {I : ℕ →₀ ℕ | Finsupp.degree I = d ∧ MvPowerSeries.coeff I f ≠ 0}.Finite)
    {i j : ℕ} (hij : i ≤ j) :
    seriesTruncation T f j hf - seriesTruncation T f i hf ∈ T.m ^ i := by
  apply (MvPolynomial.mem_pow_idealOfVars_iff' i _).2
  intro I hI
  rw [MvPolynomial.coeff_sub, coeff_seriesTruncation, coeff_seriesTruncation]
  simp [hI, hI.trans_le hij]

private lemma coeff_eq_of_mk_eq (T : CountableVarLocalization) (N : ℕ) {a b : T.P}
    (h : Ideal.Quotient.mk (T.m ^ N • ⊤ : Ideal T.P) a =
      Ideal.Quotient.mk (T.m ^ N • ⊤ : Ideal T.P) b)
    (I : ℕ →₀ ℕ) (hI : Finsupp.degree I < N) :
    a.coeff I = b.coeff I := by
  have hdif : a - b ∈ T.m ^ N := by
    simpa [smul_eq_mul, Ideal.mul_top] using (Ideal.Quotient.eq (I := T.m ^ N • ⊤)).mp h
  have hz := (MvPolynomial.mem_pow_idealOfVars_iff' N _).mp hdif I hI
  rwa [MvPolynomial.coeff_sub, sub_eq_zero] at hz

private lemma coeff_out_mk (T : CountableVarLocalization) (n : ℕ) (p : T.P)
    (I : ℕ →₀ ℕ) (hI : Finsupp.degree I < n) :
    (Quotient.out
      (Ideal.Quotient.mk (T.m ^ n • ⊤) p)).coeff I = p.coeff I :=
  coeff_eq_of_mk_eq T n (Ideal.Quotient.mk_out _) I hI

private lemma coeff_out_transition (T : CountableVarLocalization)
    (x : AdicCompletion T.m T.P) {i j : ℕ} (hij : i ≤ j)
    (I : ℕ →₀ ℕ) (hI : Finsupp.degree I < i) :
    (Quotient.out (x.val j)).coeff I =
      (Quotient.out (x.val i)).coeff I := by
  refine coeff_eq_of_mk_eq T i ?_ I hI
  calc
    _ = AdicCompletion.transitionMap T.m T.P hij
        (Ideal.Quotient.mk (T.m ^ j • ⊤) (Quotient.out (x.val j))) := by
      rw [AdicCompletion.transitionMap_ideal_mk]
    _ = AdicCompletion.transitionMap T.m T.P hij (x.val j) := by
      rw [Ideal.Quotient.mk_out]
    _ = x.val i := x.property hij
    _ = Ideal.Quotient.mk (T.m ^ i • ⊤) (Quotient.out (x.val i)) := by
      rw [Ideal.Quotient.mk_out]

private lemma coeff_series_eq_coeff_out (T : CountableVarLocalization) (s : T.S) (N : ℕ)
    (I : ℕ →₀ ℕ) (hI : Finsupp.degree I < N) :
    MvPowerSeries.coeff I (T.series s) =
      (Quotient.out ((T.completionEquiv.val s).val N)).coeff I := by
  simp only [series, MvPowerSeries.coeff_toAdicCompletionInv]
  exact (@coeff_out_transition T (T.completionEquiv.val s) (Finsupp.degree I + 1) N
    (by omega) I (by omega)).symm

/-- Conversely, every series with finite support in each degree uniquely represents an element
of the completion. -/
theorem existsUnique_series_of_degreewise_finite (T : CountableVarLocalization)
    (f : MvPowerSeries ℕ T.k)
    (hf : ∀ d : ℕ,
      { I : ℕ →₀ ℕ | Finsupp.degree I = d ∧ MvPowerSeries.coeff I f ≠ 0 }.Finite) :
    ∃! s : T.S, T.series s = f := by
  classical
  let y : AdicCompletion T.m T.P := ⟨
    fun n => Ideal.Quotient.mk (T.m ^ n • ⊤)
      (seriesTruncation T f n hf),
    fun {i j} hij => by
      rw [AdicCompletion.transitionMap_ideal_mk]
      apply (Ideal.Quotient.eq (I := T.m ^ i • ⊤)).2
      simpa [smul_eq_mul, Ideal.mul_top] using seriesTruncation_sub_mem_pow T f hf hij⟩
  let s := (T.completionEquiv.val).symm y
  have hsf : T.series s = f := by
    ext I
    show (Quotient.out ((T.completionEquiv.val s).val (Finsupp.degree I + 1))).coeff I =
        MvPowerSeries.coeff I f
    rw [show T.completionEquiv.val s = y from RingEquiv.apply_symm_apply _ _]
    show (Quotient.out (Ideal.Quotient.mk (T.m ^ (Finsupp.degree I + 1) • ⊤)
        (seriesTruncation T f (Finsupp.degree I + 1) hf))).coeff I = _
    rw [coeff_out_mk T _ _ I (by omega), coeff_seriesTruncation]
    simp
  refine ⟨s, hsf, ?_⟩
  intro t ht
  have hseries : T.series s = T.series t := hsf.trans ht.symm
  apply (T.completionEquiv.val).injective
  apply Subtype.ext
  funext n
  show (T.completionEquiv.val t).val n = (T.completionEquiv.val s).val n
  symm
  rw [← Ideal.Quotient.mk_out ((T.completionEquiv.val s).val n),
    ← Ideal.Quotient.mk_out ((T.completionEquiv.val t).val n)]
  apply (Ideal.Quotient.eq (I := T.m ^ n • ⊤)).2
  have hmemPow : Quotient.out ((T.completionEquiv.val s).val n) -
      Quotient.out ((T.completionEquiv.val t).val n) ∈ T.m ^ n := by
    apply (MvPolynomial.mem_pow_idealOfVars_iff' n _).2
    intro J hJ
    rw [MvPolynomial.coeff_sub, ← coeff_series_eq_coeff_out T s n J hJ,
      ← coeff_series_eq_coeff_out T t n J hJ, hseries, sub_self]
  simpa [smul_eq_mul, Ideal.mul_top] using hmemPow

private def polynomialResidueEquiv (T : CountableVarLocalization) : T.P ⧸ T.m ≃+* T.k :=
  (Ideal.quotEquivOfEq (ker_constantCoeff_eq_m T).symm).trans
    (RingHom.quotientKerEquivOfSurjective (R := T.P) (S := T.k)
      (f := MvPolynomial.constantCoeff)
      (fun x =>
        ⟨MvPolynomial.C x, MvPolynomial.constantCoeff_C _ _⟩))

private lemma polynomialResidueEquiv_apply_mk (T : CountableVarLocalization) (p : T.P) :
    polynomialResidueEquiv T (Ideal.Quotient.mk T.m p) =
      MvPolynomial.constantCoeff p := by
  have hs : Function.Surjective (MvPolynomial.constantCoeff : T.P →+* T.k) := fun x =>
    ⟨MvPolynomial.C x, MvPolynomial.constantCoeff_C _ _⟩
  rw [polynomialResidueEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
  show RingHom.quotientKerEquivOfSurjective
      (f := (MvPolynomial.constantCoeff : T.P →+* T.k)) hs
      (Ideal.Quotient.mk (RingHom.ker (MvPolynomial.constantCoeff : T.P →+* T.k)) p) = _
  exact RingHom.quotientKerEquivOfSurjective_apply_mk
    (f := (MvPolynomial.constantCoeff : T.P →+* T.k)) hs p

private def completionConstantTerm (T : CountableVarLocalization) : T.S →+* T.k :=
  (polynomialResidueEquiv T).toRingHom.comp
    ((Ideal.quotEquivOfEq (pow_one T.m)).toRingHom.comp
      ((AdicCompletion.evalₐ T.m 1).toRingHom.comp T.completionEquiv.val.toRingHom))

private lemma completionConstantTerm_apply_of (T : CountableVarLocalization) (p : T.P) :
    completionConstantTerm T
      (AdicCompletion.of T.n T.A (algebraMap T.P T.A p)) =
        MvPolynomial.constantCoeff p := by
  simp only [completionConstantTerm, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
  rw [T.completionEquiv.property, AdicCompletion.evalₐ_of,
    Ideal.quotEquivOfEq_mk, polynomialResidueEquiv_apply_mk]

private lemma completionConstantTerm_eq_coeff_zero (T : CountableVarLocalization) (s : T.S) :
    completionConstantTerm T s = MvPowerSeries.coeff 0 (T.series s) := by
  dsimp [completionConstantTerm]
  let p := Quotient.out ((T.completionEquiv.val s).val 1)
  have hpow : T.m ^ 1 = T.m := by simp
  let e : T.P ⧸ T.m ^ 1 ≃+* T.P ⧸ T.m := Ideal.quotEquivOfEq hpow
  show polynomialResidueEquiv T
      (e (AdicCompletion.evalₐ T.m 1 (T.completionEquiv.val s))) =
    MvPowerSeries.coeff 0 (T.series s)
  have heval : AdicCompletion.evalₐ T.m 1 (T.completionEquiv.val s) =
      Ideal.Quotient.mk (T.m ^ 1) p := by
    dsimp [AdicCompletion.evalₐ, AdicCompletion.eval]
    have h : (T.m ^ 1 • ⊤ : Ideal T.P) = T.m ^ 1 := by
      simp [smul_eq_mul, Ideal.mul_top]
    show Ideal.quotientEquivAlgOfEq T.P h
        ((T.completionEquiv.val s).val 1) = _
    have hq : Ideal.Quotient.mk (T.m ^ 1 • ⊤ : Ideal T.P) p =
        (T.completionEquiv.val s).val 1 := Ideal.Quotient.mk_out _
    rw [← hq, Ideal.quotientEquivAlgOfEq_mk]
  rw [heval, Ideal.quotEquivOfEq_mk, polynomialResidueEquiv_apply_mk]
  exact (coeff_series_eq_coeff_out T s 1 0 (by simp)).symm

/-- A constant-term homomorphism exists which is compatible with `MvPolynomial.constantCoeff`
and computes the degree-zero coefficient of the series. -/
theorem exists_constantTerm_eq_coeff_zero (T : CountableVarLocalization) :
    ∃ f : { f : T.S →+* T.k //
      ∀ p : T.P,
        f (AdicCompletion.of T.n T.A (algebraMap T.P T.A p)) =
          MvPolynomial.constantCoeff p },
      ∀ s : T.S, f.val s = MvPowerSeries.coeff 0 (T.series s) :=
  ⟨⟨completionConstantTerm T, completionConstantTerm_apply_of T⟩,
    completionConstantTerm_eq_coeff_zero T⟩

/-- Taking the constant term of a completed polynomial, compatible with the constant
coefficient of every polynomial in the localization. -/
def constantTerm (T : CountableVarLocalization) :
    { f : T.S →+* T.k //
      ∀ p : T.P,
        f (AdicCompletion.of T.n T.A (algebraMap T.P T.A p)) =
          MvPolynomial.constantCoeff p } :=
  Classical.choose (exists_constantTerm_eq_coeff_zero T)

/-- Constant term agrees with the degree-zero coefficient of the series. -/
theorem constantTerm_eq_coeff_zero (T : CountableVarLocalization) (s : T.S) :
    T.constantTerm.val s = MvPowerSeries.coeff 0 (T.series s) :=
  Classical.choose_spec (exists_constantTerm_eq_coeff_zero T) s

/-- The ideal of series with zero constant term. -/
abbrev m' (T : CountableVarLocalization) : Ideal T.S :=
  RingHom.ker T.constantTerm.val

private lemma isUnit_adicCompletion_of_constantCoeff_ne_zero (T : CountableVarLocalization)
    (x : AdicCompletion T.m T.P)
    (hx : (Quotient.out (x.val 1)).coeff 0 ≠ 0) : IsUnit x := by
  classical
  have : T.m.IsMaximal := T.m_isMaximal
  have hstage (n : ℕ) : IsUnit (x.val n) := by
    cases n with
    | zero =>
        have : Subsingleton (T.P ⧸ (T.m ^ 0 • ⊤ : Ideal T.P)) := by
          simp
        exact isUnit_of_subsingleton _
    | succ n =>
        have hcoeff : (Quotient.out (x.val (n + 1))).coeff 0 ≠ 0 :=
          (@coeff_out_transition T x 1 (n + 1) (by omega) 0 (by simp)).symm ▸ hx
        have hnot : Quotient.out (x.val (n + 1)) ∉ T.m := by
          intro hm
          have hm' : Quotient.out (x.val (n + 1)) ∈
              RingHom.ker (MvPolynomial.constantCoeff : T.P →+* T.k) := by
            rwa [ker_constantCoeff_eq_m T]
          have hz := RingHom.mem_ker.mp hm'
          exact hcoeff hz
        have hq : IsUnit (Ideal.Quotient.mk (T.m ^ (n + 1))
            (Quotient.out (x.val (n + 1)))) :=
          Ideal.Quotient.isUnit_mk_pow_of_notMem (I := T.m) hnot
        have hpow : (T.m ^ (n + 1) • ⊤ : Ideal T.P) = T.m ^ (n + 1) := by
          simp [smul_eq_mul, Ideal.mul_top]
        let e := Ideal.quotEquivOfEq hpow.symm
        have hq' : IsUnit (e (Ideal.Quotient.mk (T.m ^ (n + 1))
            (Quotient.out (x.val (n + 1))))) := hq.map e.toRingHom
        have hq'' : IsUnit (Ideal.Quotient.mk (T.m ^ (n + 1) • ⊤)
            (Quotient.out (x.val (n + 1)))) := by
          simpa [e, hpow] using hq'
        exact (Ideal.Quotient.mk_out (x.val (n + 1))) ▸ hq''
  let z : AdicCompletion T.m T.P := ⟨fun n => ↑((hstage n).unit⁻¹), by
    intro i j hij
    let φ : (T.P ⧸ (T.m ^ j • ⊤ : Ideal T.P)) →+*
        (T.P ⧸ (T.m ^ i • ⊤ : Ideal T.P)) :=
      (AdicCompletion.transitionMapₐ (I := T.m) (R := T.P) hij).toRingHom
    have hxmap : φ (x.val j) = x.val i := x.property hij
    show φ ↑((hstage j).unit⁻¹) = ↑((hstage i).unit⁻¹)
    have hright : x.val i * φ ↑((hstage j).unit⁻¹) = 1 := by
      calc
        _ = φ (x.val j * ↑((hstage j).unit⁻¹)) := by
          rw [map_mul, hxmap]
        _ = φ 1 := congrArg φ (IsUnit.mul_val_inv (hstage j))
        _ = 1 := map_one φ
    exact IsUnit.mul_left_cancel (hstage i)
      (hright.trans (IsUnit.mul_val_inv (hstage i)).symm)⟩
  have hmul : x * z = 1 := Subtype.ext <| funext fun n => IsUnit.mul_val_inv (hstage n)
  exact ⟨⟨x, z, hmul, (mul_comm z x).trans hmul⟩, rfl⟩

private lemma isUnit_completion_of_constantTerm_ne_zero (T : CountableVarLocalization)
    (s : T.S) (hs : T.constantTerm.val s ≠ 0) : IsUnit s := by
  have hcoeff : (Quotient.out ((T.completionEquiv.val s).val 1)).coeff 0 ≠ 0 := by
    rwa [T.constantTerm_eq_coeff_zero, coeff_series_eq_coeff_out T s 1 0 (by simp)] at hs
  simpa using (isUnit_adicCompletion_of_constantCoeff_ne_zero T
    (T.completionEquiv.val s) hcoeff).map T.completionEquiv.val.symm

/-- The completion is a local ring. -/
theorem S_isLocal (T : CountableVarLocalization) : IsLocalRing T.S := by
  have : Nontrivial T.S :=
    nontrivial_of_ne 1 0 fun h => by simpa using congrArg T.constantTerm.val h
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun s => ?_
  by_cases hs : T.constantTerm.val s = 0
  · exact .inr <| isUnit_completion_of_constantTerm_ne_zero T (1 - s) (by simp [hs])
  · exact .inl <| isUnit_completion_of_constantTerm_ne_zero T s hs

attribute [instance] S_isLocal

/-- Its maximal ideal consists precisely of series with zero constant term. -/
theorem maximalIdeal_eq_ker_constantTerm (T : CountableVarLocalization) :
    IsLocalRing.maximalIdeal T.S = T.m' := by
  have hs : Function.Surjective T.constantTerm.val := by
    intro x
    refine ⟨AdicCompletion.of T.n T.A (algebraMap T.P T.A (MvPolynomial.C x)), ?_⟩
    simpa using T.constantTerm.property (MvPolynomial.C x)
  exact (IsLocalRing.eq_maximalIdeal
    (RingHom.ker_isMaximal_of_surjective T.constantTerm.val hs)).symm

/-- The coefficient of the series of `s` at `I` is that of any polynomial representing the stage
of `s` above the degree of `I`. -/
private lemma coeff_series_eq_coeff_of_mk_eq (T : CountableVarLocalization) (s : T.S) (p : T.P)
    (I : ℕ →₀ ℕ)
    (h : Ideal.Quotient.mk (T.m ^ (Finsupp.degree I + 1) • ⊤ : Ideal T.P) p =
      (T.completionEquiv.val s).val (Finsupp.degree I + 1)) :
    MvPowerSeries.coeff I (T.series s) = p.coeff I := by
  rw [coeff_series_eq_coeff_out T s (Finsupp.degree I + 1) I (by omega)]
  exact coeff_eq_of_mk_eq T _ (by rw [Ideal.Quotient.mk_out, h]) I (by omega)

/-- The series of a sum is the sum of the series. -/
theorem series_add (T : CountableVarLocalization) (s t : T.S) :
    T.series (s + t) = T.series s + T.series t := by
  ext I
  rw [map_add, coeff_series_eq_coeff_of_mk_eq T (s + t)
      (Quotient.out ((T.completionEquiv.val s).val (Finsupp.degree I + 1)) +
        Quotient.out ((T.completionEquiv.val t).val (Finsupp.degree I + 1))) I
      (by simp only [map_add, AdicCompletion.val_add_apply, Ideal.Quotient.mk_out]),
    MvPolynomial.coeff_add,
    ← coeff_series_eq_coeff_out T s (Finsupp.degree I + 1) I (by omega),
    ← coeff_series_eq_coeff_out T t (Finsupp.degree I + 1) I (by omega)]

/-- The series of a product is the product of the series. -/
theorem series_mul (T : CountableVarLocalization) (s t : T.S) :
    T.series (s * t) = T.series s * T.series t := by
  classical
  ext I
  rw [coeff_series_eq_coeff_of_mk_eq T (s * t)
      (Quotient.out ((T.completionEquiv.val s).val (Finsupp.degree I + 1)) *
        Quotient.out ((T.completionEquiv.val t).val (Finsupp.degree I + 1))) I
      (by simp only [map_mul, AdicCompletion.val_mul, Ideal.Quotient.mk_out]),
    MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
  refine Finset.sum_congr rfl ?_
  rintro ⟨ν, ρ⟩ hνρ
  have hsum : ν + ρ = I := Finset.mem_antidiagonal.mp hνρ
  have hdeg : Finsupp.degree ν + Finsupp.degree ρ = Finsupp.degree I := by
    rw [← hsum, map_add]
  rw [coeff_series_eq_coeff_out T s (Finsupp.degree I + 1) ν (by omega),
    coeff_series_eq_coeff_out T t (Finsupp.degree I + 1) ρ (by omega)]

/-- The series of `1` is `1`. -/
theorem series_one (T : CountableVarLocalization) : T.series (1 : T.S) = 1 := by
  ext I
  rw [coeff_series_eq_coeff_of_mk_eq T 1 1 I
      (by simp only [map_one, AdicCompletion.val_one]),
    MvPolynomial.coeff_one, MvPowerSeries.coeff_one]
  exact if_congr eq_comm rfl rfl

/-- The series of `0` is `0`. -/
theorem series_zero (T : CountableVarLocalization) : T.series (0 : T.S) = 0 := by
  ext I
  rw [coeff_series_eq_coeff_of_mk_eq T 0 0 I
      (by simp only [map_zero, AdicCompletion.val_zero_apply])]
  simp

/-- Reading off the coefficients is a ring homomorphism to formal power series. -/
def seriesHom (T : CountableVarLocalization) : T.S →+* MvPowerSeries ℕ T.k where
  toFun := T.series
  map_one' := T.series_one
  map_mul' := T.series_mul
  map_zero' := T.series_zero
  map_add' := T.series_add

/-- `seriesHom` sends an element of the completion to its series. -/
@[simp]
theorem seriesHom_apply (T : CountableVarLocalization) (s : T.S) :
    T.seriesHom s = T.series s := rfl

/-- The series of a polynomial of the localization is that polynomial. -/
theorem series_of_mvPolynomial (T : CountableVarLocalization) (p : T.P) :
    T.series (AdicCompletion.of T.n T.A (algebraMap T.P T.A p)) =
      (p : MvPowerSeries ℕ T.k) := by
  ext I
  rw [coeff_series_eq_coeff_out T _ (Finsupp.degree I + 1) I (by omega),
    T.completionEquiv.property p,
    MvPolynomial.coeff_coe]
  exact coeff_out_mk T _ p I (by omega)

/-- An element of the completion has zero constant term exactly when its series does. -/
theorem mem_m'_iff_coeff_zero (T : CountableVarLocalization) (s : T.S) :
    s ∈ T.m' ↔ MvPowerSeries.coeff 0 (T.series s) = 0 := by
  rw [m', RingHom.mem_ker, T.constantTerm_eq_coeff_zero]

end CountableVarLocalization

end Stacks.Examples

