module

public import Mathlib
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Flatness.Flattening.LimitPreservingNoetherian
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf

/-!
# The site of locally Noetherian schemes has no fibre products (Stacks 0GE2)

Let `S` be a scheme in a big fppf site. Its locally Noetherian objects form the site
`(Noetherian/S)_{fppf}`, a full subcategory of `(Sch/S)_{fppf}`. **Stacks 0GE2** warns that this
site does not have fibre products. This file proves that assertion for
`S = Spec k` with `k` any countable field, and hence that one has to be careful with sheaves on
it; the second assertion of the remark, the resulting failure of the inclusion functor to be a
morphism of sites, is
`AlgebraicGeometry.LocallyNoetherianOver.not_isMorphismOfSites_toBigFppfOver`.

## Main results

* `AlgebraicGeometry.LocallyNoetherianOver.not_hasPullbacks`: the first assertion of
  **Stacks 0GE2**, for `τ = fppf` and `S = Spec k` with `k` a countable field: the locally
  Noetherian objects of a big fppf site over `S` do not have fibre products.

## The counterexample

Take `K = k(u₀, u₁, u₂, …)`, the rational function field in countably many variables, and
consider the self-product of `Spec K` over the base `S = Spec k`, that is the fibre product of
the diagram `Spec K ⟶ S ⟵ Spec K` inside `(Noetherian/S)_{fppf}`. It does not exist.

The obstruction is the *embedding dimension* of a single local ring. For `n : ℕ` let
`Rₙ = K ⊕ Kⁿ` be the square-zero extension: a `K`-algebra of dimension `n + 1`, hence a
Noetherian local ring whose maximal ideal `mₙ = 0 ⊕ Kⁿ` has square zero and needs `n`
generators. It carries two ring maps from `K`: the canonical embedding `x ↦ (x, 0)`, and the
twisted one sending the variable `uᵢ` to `(uᵢ, εᵢ)` for `i < n` — well defined because a nonzero
polynomial is sent to a unit, as its image has invertible first component. Both are maps of
`k`-algebras, and their images generate `Rₙ`, since the difference of the two images of `uᵢ` is
`εᵢ`. Composed with the residue map `Rₙ ⟶ K` both become the identity.

Now suppose the fibre product existed, say `W` with projections `a b : W ⟶ Spec K`. Each
`Spec Rₙ` with its two maps to `Spec K` then factors through `W`, as does `Spec K` with the pair
of identities; and because the latter factorization is unique, every `Spec Rₙ ⟶ W` meets `W` in
the one point `w₀` that `Spec K ⟶ W` hits — the spectrum of `Rₙ` is a single point, its maximal
ideal being the only prime. So all of them factor through one affine open `V ∋ w₀`, whose ring
of sections `A` is Noetherian because `W` is locally Noetherian. The resulting ring map
`A ⟶ Rₙ` is surjective, its image containing both maps from `K`, and it carries the fixed ideal
`m ⊆ A` — the kernel of `A ⟶ K` coming from `Spec K ⟶ W` — onto `mₙ`. A Noetherian `A` has `m`
generated by finitely many elements, say `d` of them, so `mₙ` is generated by `d` elements for
every `n`. Taking `n = d + 1` contradicts the `n` generators that `mₙ` requires.

## Implementation notes

The base field is countable so that every ring appearing here has countably many elements,
which puts its spectrum in any big fppf site: membership is the size bound
`Scheme.size < B.cutoff` and the cutoff is uncountable.

The scheme-theoretic half of the argument is isolated in
`AlgebraicGeometry.LocallyNoetherianOver.no_representing_locallyNoetherian_scheme`, which takes
exactly the factorization data that the fibre product would provide.

## References

* [Stacks Project, Tag 0GE1](https://stacks.math.columbia.edu/tag/0GE1)
* [Stacks Project, Tag 0GE2](https://stacks.math.columbia.edu/tag/0GE2)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TrivSqZeroExt MvPolynomial

universe u

namespace AlgebraicGeometry

namespace LocallyNoetherianOver

variable (baseField : Type u) [Field baseField]

/-- The rational function field `k(u₀, u₁, u₂, …)` in countably many variables. Its module of
differentials over `k` is infinite dimensional, which is what makes the fibre product of
`Spec` of it with itself fail to exist among locally Noetherian schemes. -/
@[ega "0 21.9.7"]
private abbrev manyVariablesField := FractionRing (MvPolynomial ℕ baseField)

/-- The `i`-th variable of `k(u₀, u₁, u₂, …)`. -/
private noncomputable abbrev variableOf (i : ℕ) : manyVariablesField baseField :=
  algebraMap (MvPolynomial ℕ baseField) (manyVariablesField baseField) (X i)

/-- The structure map `k ⟶ k(u₀, u₁, u₂, …)`. -/
private noncomputable abbrev manyVariablesBase : baseField →+* manyVariablesField baseField :=
  (algebraMap (MvPolynomial ℕ baseField) (manyVariablesField baseField)).comp
    (MvPolynomial.C (σ := ℕ))

/-- The probe ring `K ⊕ Kⁿ`, the square-zero extension of `K = k(u₀, u₁, …)` by `Kⁿ`. It is a
Noetherian local ring with residue field `K` whose maximal ideal has square zero and
embedding dimension `n`. -/
private abbrev squareZeroProbe (dimension : ℕ) :=
  TrivSqZeroExt (manyVariablesField baseField) (Fin dimension → manyVariablesField baseField)

private instance (dimension : ℕ) : IsNoetherianRing (squareZeroProbe baseField dimension) := by
  have : Module.Finite (manyVariablesField baseField) (squareZeroProbe baseField dimension) :=
    inferInstanceAs (Module.Finite (manyVariablesField baseField)
      (manyVariablesField baseField × (Fin dimension → manyVariablesField baseField)))
  exact IsNoetherianRing.of_finite (manyVariablesField baseField) _

private instance [Countable baseField] : Countable (manyVariablesField baseField) := by
  have hsurjective : Function.Surjective
      (fun pair : MvPolynomial ℕ baseField × (nonZeroDivisors (MvPolynomial ℕ baseField)) =>
        Localization.mk pair.1 pair.2) := by
    intro element
    induction element using Localization.ind with
    | _ pair => exact ⟨pair, rfl⟩
  exact hsurjective.countable

private instance [Countable baseField] (dimension : ℕ) :
    Countable (squareZeroProbe baseField dimension) :=
  inferInstanceAs (Countable (manyVariablesField baseField ×
    (Fin dimension → manyVariablesField baseField)))

/-- The residue map `K ⊕ Kⁿ ⟶ K` of the probe ring. -/
private noncomputable def probeResidue (dimension : ℕ) :
    squareZeroProbe baseField dimension →+* manyVariablesField baseField where
  toFun := TrivSqZeroExt.fst
  map_one' := rfl
  map_mul' first second := TrivSqZeroExt.fst_mul first second
  map_zero' := rfl
  map_add' _ _ := rfl

@[simp] private lemma probeResidue_apply {dimension : ℕ}
    (element : squareZeroProbe baseField dimension) :
    probeResidue baseField dimension element = element.fst := rfl

/-- The canonical embedding `K ⟶ K ⊕ Kⁿ`, the first of the two maps from `K` to the probe
ring. -/
private noncomputable def probeEmbedding (dimension : ℕ) :
    manyVariablesField baseField →+* squareZeroProbe baseField dimension :=
  TrivSqZeroExt.inlHom _ _

private lemma probeEmbedding_apply {dimension : ℕ} (element : manyVariablesField baseField) :
    probeEmbedding baseField dimension element = inl element := rfl

/-- The twisted map on polynomials: `uᵢ ↦ uᵢ + εᵢ` for `i < n`, and `uᵢ ↦ uᵢ` otherwise. -/
private noncomputable def probeTwistOnPolynomials (dimension : ℕ) :
    MvPolynomial ℕ baseField →+* squareZeroProbe baseField dimension :=
  eval₂Hom ((probeEmbedding baseField dimension).comp (manyVariablesBase baseField))
    (fun i => inl (variableOf baseField i) +
      if h : i < dimension then inr (Pi.single ⟨i, h⟩ 1) else 0)

private lemma probeResidue_comp_probeTwistOnPolynomials (dimension : ℕ) :
    (probeResidue baseField dimension).comp (probeTwistOnPolynomials baseField dimension) =
      algebraMap (MvPolynomial ℕ baseField) (manyVariablesField baseField) := by
  apply MvPolynomial.ringHom_ext
  · intro element
    change probeResidue baseField dimension
      (probeTwistOnPolynomials baseField dimension (C element)) = _
    rw [probeTwistOnPolynomials]
    simp [probeEmbedding]
  · intro i
    change probeResidue baseField dimension
      (probeTwistOnPolynomials baseField dimension (X i)) = _
    rw [probeTwistOnPolynomials]
    by_cases h : i < dimension <;> simp [h]

/-- An element of the probe ring with invertible residue is a unit: a nilpotent correction of a
unit is a unit. -/
private lemma isUnit_of_probeResidue_ne_zero {dimension : ℕ}
    (element : squareZeroProbe baseField dimension) (h : element.fst ≠ 0) : IsUnit element := by
  have : Invertible element.fst := invertibleOfNonzero h
  have : Invertible element := invertibleOfInvertibleFst element
  exact isUnit_of_invertible element

private lemma isUnit_probeTwistOnPolynomials (dimension : ℕ)
    (denominator : nonZeroDivisors (MvPolynomial ℕ baseField)) :
    IsUnit (probeTwistOnPolynomials baseField dimension
      (denominator : MvPolynomial ℕ baseField)) := by
  apply isUnit_of_probeResidue_ne_zero
  have hresidue : (probeTwistOnPolynomials baseField dimension
        (denominator : MvPolynomial ℕ baseField)).fst =
      algebraMap (MvPolynomial ℕ baseField) (manyVariablesField baseField)
        (denominator : MvPolynomial ℕ baseField) :=
    RingHom.congr_fun (probeResidue_comp_probeTwistOnPolynomials baseField dimension) _
  rw [hresidue]
  exact fun hzero => nonZeroDivisors.coe_ne_zero denominator
    (IsFractionRing.to_map_eq_zero_iff.mp hzero)

/-- The twisted embedding `K ⟶ K ⊕ Kⁿ`, the second of the two maps from `K` to the probe ring.
It exists because a nonzero polynomial is sent to a unit. -/
private noncomputable def probeTwist (dimension : ℕ) :
    manyVariablesField baseField →+* squareZeroProbe baseField dimension :=
  IsLocalization.lift (isUnit_probeTwistOnPolynomials baseField dimension)

private lemma probeTwist_algebraMap (dimension : ℕ) (element : MvPolynomial ℕ baseField) :
    probeTwist baseField dimension
        (algebraMap (MvPolynomial ℕ baseField) (manyVariablesField baseField) element) =
      probeTwistOnPolynomials baseField dimension element :=
  IsLocalization.lift_eq _ _

private lemma probeResidue_comp_probeEmbedding (dimension : ℕ) :
    (probeResidue baseField dimension).comp (probeEmbedding baseField dimension) =
      RingHom.id (manyVariablesField baseField) := rfl

private lemma probeResidue_comp_probeTwist (dimension : ℕ) :
    (probeResidue baseField dimension).comp (probeTwist baseField dimension) =
      RingHom.id (manyVariablesField baseField) := by
  apply IsLocalization.ringHom_ext (nonZeroDivisors (MvPolynomial ℕ baseField))
  refine RingHom.ext fun element => ?_
  simp only [RingHom.comp_apply, RingHom.id_apply, probeTwist_algebraMap]
  exact RingHom.congr_fun (probeResidue_comp_probeTwistOnPolynomials baseField dimension) element

/-- The two maps from `K` differ on the `i`-th variable by the `i`-th generator of the maximal
ideal of the probe ring. -/
private lemma probeTwist_variableOf {dimension : ℕ} {i : ℕ} (h : i < dimension) :
    probeTwist baseField dimension (variableOf baseField i) =
      inl (variableOf baseField i) + inr (Pi.single ⟨i, h⟩ 1) := by
  rw [variableOf, probeTwist_algebraMap, probeTwistOnPolynomials]
  simp [h]

private lemma probeTwist_comp_manyVariablesBase (dimension : ℕ) :
    (probeTwist baseField dimension).comp (manyVariablesBase baseField) =
      (probeEmbedding baseField dimension).comp (manyVariablesBase baseField) := by
  refine RingHom.ext fun element => ?_
  change probeTwist baseField dimension
    (algebraMap (MvPolynomial ℕ baseField) (manyVariablesField baseField) (C element)) = _
  rw [probeTwist_algebraMap, probeTwistOnPolynomials]
  simp [probeEmbedding]

private lemma probeResidue_comp_probeEmbedding_comp_manyVariablesBase (dimension : ℕ) :
    (probeResidue baseField dimension).comp
        ((probeEmbedding baseField dimension).comp (manyVariablesBase baseField)) =
      manyVariablesBase baseField := rfl

private lemma inr_eq_sum_single {dimension : ℕ}
    (vector : Fin dimension → manyVariablesField baseField) :
    (inr vector : squareZeroProbe baseField dimension) =
      ∑ i : Fin dimension, inl (vector i) * inr (Pi.single i 1) := by
  have hterm : ∀ i : Fin dimension,
      (inl (vector i) * inr (Pi.single i 1) : squareZeroProbe baseField dimension) =
        inr (Pi.single i (vector i)) := by
    intro i
    rw [inl_mul_inr]
    congr 1
    ext j
    by_cases h : j = i <;> simp [h]
  have hsum : (inr (∑ i : Fin dimension, Pi.single i (vector i)) :
      squareZeroProbe baseField dimension) =
      ∑ i : Fin dimension, inr (Pi.single i (vector i)) :=
    map_sum (TrivSqZeroExt.inrHom (manyVariablesField baseField)
      (Fin dimension → manyVariablesField baseField)) _ _
  rw [Finset.sum_congr rfl (fun i _ => hterm i), ← hsum, Finset.univ_sum_single]

/-- A ring map onto the probe ring whose image contains both maps from `K` is surjective: the
two images of the `i`-th variable differ by the `i`-th generator of the maximal ideal, and
together with `K` these generate. -/
private lemma probe_surjective {dimension : ℕ} {source : Type u} [CommRing source]
    (map : source →+* squareZeroProbe baseField dimension)
    (hembedding : ∀ element : manyVariablesField baseField,
      probeEmbedding baseField dimension element ∈ map.range)
    (htwist : ∀ element : manyVariablesField baseField,
      probeTwist baseField dimension element ∈ map.range) :
    Function.Surjective map := by
  have hsingle : ∀ i : Fin dimension,
      (inr (Pi.single i 1) : squareZeroProbe baseField dimension) ∈ map.range := by
    intro i
    have hdifference := sub_mem (htwist (variableOf baseField i))
      (hembedding (variableOf baseField i))
    rwa [probeTwist_variableOf baseField i.isLt, probeEmbedding_apply,
      add_sub_cancel_left] at hdifference
  intro target
  refine RingHom.mem_range.mp ?_
  rw [← target.inl_fst_add_inr_snd_eq]
  refine add_mem (hembedding _) ?_
  rw [inr_eq_sum_single]
  exact sum_mem fun i _ => mul_mem (hembedding _) (hsingle i)

/-- The maximal ideal of the probe ring needs `n` generators: it has square zero, so an ideal
generating it spans it as an `n`-dimensional `K`-vector space. -/
private lemma probe_card_le {dimension : ℕ}
    (generators : Finset (squareZeroProbe baseField dimension))
    (hgenerators : RingHom.ker (probeResidue baseField dimension) =
      Ideal.span (generators : Set (squareZeroProbe baseField dimension))) :
    dimension ≤ generators.card := by
  classical
  have hzero : ∀ element ∈ generators,
      (element : squareZeroProbe baseField dimension).fst = 0 := by
    intro element hmember
    have : element ∈ RingHom.ker (probeResidue baseField dimension) := by
      rw [hgenerators]
      exact Ideal.subset_span hmember
    simpa [RingHom.mem_ker] using this
  have hspan : Submodule.span (manyVariablesField baseField)
      ((generators.image (fun element => (element : squareZeroProbe baseField dimension).snd) :
        Finset (Fin dimension → manyVariablesField baseField)) :
          Set (Fin dimension → manyVariablesField baseField)) = ⊤ := by
    refine top_unique fun vector _ => ?_
    have hmember : (inr vector : squareZeroProbe baseField dimension) ∈
        Ideal.span (generators : Set (squareZeroProbe baseField dimension)) := by
      rw [← hgenerators]
      simp [RingHom.mem_ker]
    rw [show Ideal.span (generators : Set (squareZeroProbe baseField dimension)) =
        Submodule.span (squareZeroProbe baseField dimension)
          (generators : Set (squareZeroProbe baseField dimension)) from rfl,
      Submodule.mem_span_finset] at hmember
    obtain ⟨coefficients, -, hcoefficients⟩ := hmember
    have hvector : vector = ∑ element ∈ generators, (coefficients element).fst •
        (element : squareZeroProbe baseField dimension).snd := by
      have hsnd : (∑ element ∈ generators, coefficients element • element :
          squareZeroProbe baseField dimension).snd = vector := by
        rw [hcoefficients]
        rfl
      rw [← hsnd, TrivSqZeroExt.snd_sum]
      refine Finset.sum_congr rfl fun element hmember => ?_
      rw [smul_eq_mul, TrivSqZeroExt.snd_mul, hzero element hmember]
      simp
    rw [hvector]
    refine Submodule.sum_mem _ fun element hmember => Submodule.smul_mem _ _ ?_
    exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hmember))
  have hrank : Module.finrank (manyVariablesField baseField)
      (Fin dimension → manyVariablesField baseField) ≤
      (generators.image
        (fun element => (element : squareZeroProbe baseField dimension).snd)).card := by
    have hbound := finrank_span_finset_le_card (R := manyVariablesField baseField)
      (generators.image (fun element => (element : squareZeroProbe baseField dimension).snd))
    rwa [Set.finrank, hspan, finrank_top] at hbound
  calc dimension = Module.finrank (manyVariablesField baseField)
        (Fin dimension → manyVariablesField baseField) := by simp
    _ ≤ (generators.image
        (fun element => (element : squareZeroProbe baseField dimension).snd)).card := hrank
    _ ≤ generators.card := Finset.card_image_le

private lemma probeResidue_surjective (dimension : ℕ) :
    Function.Surjective (probeResidue baseField dimension) :=
  fun element => ⟨probeEmbedding baseField dimension element, rfl⟩

/-- The probe ring has a unique prime ideal, namely the kernel of its residue map: that kernel
is maximal, and has square zero so is contained in every prime. -/
private lemma probe_prime_eq {dimension : ℕ}
    (prime : PrimeSpectrum (squareZeroProbe baseField dimension)) :
    prime.asIdeal = RingHom.ker (probeResidue baseField dimension) := by
  have hmaximal : (RingHom.ker (probeResidue baseField dimension)).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective (probeResidue baseField dimension)
      (probeResidue_surjective baseField dimension)
  have hle : RingHom.ker (probeResidue baseField dimension) ≤ prime.asIdeal := by
    intro element hmember
    have hfst : element.fst = 0 := by simpa [RingHom.mem_ker] using hmember
    have helement : element = inr element.snd := by
      rw [← element.inl_fst_add_inr_snd_eq, hfst]
      simp
    have hsquare : element * element = 0 := by
      rw [helement, TrivSqZeroExt.inr_mul_inr]
    exact prime.isPrime.mem_of_pow_mem 2 (by simp [pow_two, hsquare])
  exact (hmaximal.eq_of_le prime.isPrime.ne_top hle).symm

private lemma probe_prime_subsingleton (dimension : ℕ) :
    Subsingleton (PrimeSpectrum (squareZeroProbe baseField dimension)) :=
  ⟨fun first second => PrimeSpectrum.ext
    ((probe_prime_eq baseField first).trans (probe_prime_eq baseField second).symm)⟩

/-- Composition of `Spec` of ring maps: `Spec g ≫ Spec f = Spec (g ∘ f)`. -/
private lemma spec_map_ofHom_comp {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    (f : A →+* B) (g : B →+* C) (h : A →+* C) (hfg : g.comp f = h) :
    Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
      Spec.map (CommRingCat.ofHom h) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hfg]

private lemma contains_spec_of_countable (B : BigFppfSite.{u}) (ring : Type u) [CommRing ring]
    [Countable ring] : B.Contains (Spec (.of ring)) := by
  change (Spec (.of ring)).size < B.cutoff
  rw [Scheme.size_Spec]
  exact max_lt B.aleph0_lt_cutoff (Cardinal.mk_le_aleph0.trans_lt B.aleph0_lt_cutoff)

/-- **No locally Noetherian scheme represents the self-product of `Spec K` over `Spec k`**, for
`K = k(u₀, u₁, …)`. The hypotheses are the factorization data a fibre product would supply: two
maps `first`, `second` to `Spec K`, a map `diagonal` from `Spec K` carrying the pair of
identities, and for every `n` a map from the probe `Spec (K ⊕ Kⁿ)` carrying its two maps to
`Spec K` and compatible with `diagonal` along the residue map.

All the probes then meet the ambient scheme in the single point hit by `diagonal`, so they
factor through one affine open whose Noetherian ring of sections surjects onto every probe ring,
carrying one finitely generated ideal onto maximal ideals of unbounded embedding dimension. -/
private lemma no_representing_locallyNoetherian_scheme
    (ambient : Scheme.{u}) [IsLocallyNoetherian ambient]
    (first second : ambient ⟶ Spec (CommRingCat.of (manyVariablesField baseField)))
    (diagonal : Spec (CommRingCat.of (manyVariablesField baseField)) ⟶ ambient)
    (hprobes : ∀ dimension : ℕ,
      ∃ probe : Spec (CommRingCat.of (squareZeroProbe baseField dimension)) ⟶ ambient,
        probe ≫ first =
          Spec.map (CommRingCat.ofHom (probeEmbedding baseField dimension)) ∧
        probe ≫ second = Spec.map (CommRingCat.ofHom (probeTwist baseField dimension)) ∧
        Spec.map (CommRingCat.ofHom (probeResidue baseField dimension)) ≫ probe = diagonal) :
    False := by
  classical
  let point : PrimeSpectrum (manyVariablesField baseField) := default
  let index := ambient.affineCover.idx (diagonal.base point)
  let affinePiece := ambient.affineCover.X index
  let inclusion := ambient.affineCover.f index
  have hdiagonalRange : Set.range diagonal.base ⊆ Set.range inclusion.base := by
    rintro target ⟨source, rfl⟩
    rw [Subsingleton.elim source point]
    exact ambient.affineCover.covers (diagonal.base point)
  let diagonalPiece := IsOpenImmersion.lift inclusion diagonal hdiagonalRange
  have hdiagonalPiece : diagonalPiece ≫ inclusion = diagonal :=
    IsOpenImmersion.lift_fac _ _ _
  have hnoetherian : IsNoetherianRing Γ(affinePiece, ⊤) :=
    isLocallyNoetherian_Spec.mp (isLocallyNoetherian_of_isOpenImmersion affinePiece.isoSpec.inv)
  let diagonalRing : Γ(affinePiece, ⊤) ⟶ CommRingCat.of (manyVariablesField baseField) :=
    Spec.preimage (diagonalPiece ≫ affinePiece.isoSpec.hom)
  obtain ⟨generators, hgenerators⟩ := (isNoetherianRing_iff_ideal_fg Γ(affinePiece, ⊤)).mp
    hnoetherian (RingHom.ker diagonalRing.hom)
  obtain ⟨probe, hprobeFirst, hprobeSecond, hprobeDiagonal⟩ := hprobes (generators.card + 1)
  have hprobeRangeDiagonal : Set.range probe.base ⊆ Set.range diagonal.base := by
    rintro target ⟨source, rfl⟩
    refine ⟨point, ?_⟩
    rw [← hprobeDiagonal]
    change probe.base ((Spec.map (CommRingCat.ofHom
      (probeResidue baseField (generators.card + 1)))).base point) = probe.base source
    exact congrArg probe.base
      (@Subsingleton.elim _ (probe_prime_subsingleton baseField (generators.card + 1)) _ _)
  let probePiece :=
    IsOpenImmersion.lift inclusion probe (hprobeRangeDiagonal.trans hdiagonalRange)
  have hprobePiece : probePiece ≫ inclusion = probe := IsOpenImmersion.lift_fac _ _ _
  let probeRing : Γ(affinePiece, ⊤) ⟶
      CommRingCat.of (squareZeroProbe baseField (generators.card + 1)) :=
    Spec.preimage (probePiece ≫ affinePiece.isoSpec.hom)
  have hcompatible : ∀ (map : ambient ⟶ Spec (CommRingCat.of (manyVariablesField baseField)))
      (ring : CommRingCat.of (manyVariablesField baseField) ⟶
        CommRingCat.of (squareZeroProbe baseField (generators.card + 1))),
      probe ≫ map = Spec.map ring →
        Spec.preimage (affinePiece.isoSpec.inv ≫ inclusion ≫ map) ≫ probeRing = ring := by
    intro map ring hmap
    rw [show Spec.preimage (affinePiece.isoSpec.inv ≫ inclusion ≫ map) ≫ probeRing =
        Spec.preimage ((probePiece ≫ affinePiece.isoSpec.hom) ≫
          (affinePiece.isoSpec.inv ≫ inclusion ≫ map)) from (Spec.preimage_comp _ _).symm,
      Category.assoc, Iso.hom_inv_id_assoc, ← Category.assoc, hprobePiece, hmap,
      Spec.preimage_map]
  have hcompatibleDiagonal : probeRing ≫
      CommRingCat.ofHom (probeResidue baseField (generators.card + 1)) = diagonalRing := by
    have hscheme : Spec.map (CommRingCat.ofHom
        (probeResidue baseField (generators.card + 1))) ≫ probePiece = diagonalPiece := by
      rw [← cancel_mono inclusion, Category.assoc, hprobePiece, hdiagonalPiece, hprobeDiagonal]
    rw [show probeRing ≫ CommRingCat.ofHom (probeResidue baseField (generators.card + 1)) =
      Spec.preimage (Spec.map (CommRingCat.ofHom
        (probeResidue baseField (generators.card + 1))) ≫
          (probePiece ≫ affinePiece.isoSpec.hom)) by
            rw [Spec.preimage_comp, Spec.preimage_map],
      ← Category.assoc, hscheme]
  have hsurjectiveRing : Function.Surjective probeRing.hom := probe_surjective baseField _
    (fun element => ⟨(Spec.preimage (affinePiece.isoSpec.inv ≫ inclusion ≫ first)).hom element,
      RingHom.congr_fun (congrArg CommRingCat.Hom.hom (hcompatible first _ hprobeFirst)) element⟩)
    (fun element => ⟨(Spec.preimage (affinePiece.isoSpec.inv ≫ inclusion ≫ second)).hom element,
      RingHom.congr_fun (congrArg CommRingCat.Hom.hom (hcompatible second _ hprobeSecond)) element⟩)
  have hcomap : Ideal.comap probeRing.hom
      (RingHom.ker (probeResidue baseField (generators.card + 1))) =
      RingHom.ker diagonalRing.hom := by
    rw [← hcompatibleDiagonal]
    rfl
  have hmap : Ideal.map probeRing.hom (RingHom.ker diagonalRing.hom) =
      RingHom.ker (probeResidue baseField (generators.card + 1)) := by
    rw [← hcomap, Ideal.map_comap_of_surjective _ hsurjectiveRing]
  have hspan : RingHom.ker (probeResidue baseField (generators.card + 1)) =
      Ideal.span ((generators.image probeRing.hom :
        Finset (squareZeroProbe baseField (generators.card + 1))) :
          Set (squareZeroProbe baseField (generators.card + 1))) := by
    rw [← hmap, ← hgenerators, Ideal.map_span, Finset.coe_image]
  have := (probe_card_le baseField _ hspan).trans Finset.card_image_le
  omega

/-- **Stacks 0GE2, first assertion.** *The site `(Noetherian/S)_τ` does not have fibre
products*, here for `τ = fppf` and `S = Spec k` with `k` a countable field.

The diagram without a fibre product is `Spec K ⟶ S ⟵ Spec K` for `K = k(u₀, u₁, u₂, …)`. A
fibre product would be a locally Noetherian scheme receiving, compatibly, the square-zero
extensions `Spec (K ⊕ Kⁿ)` with their two maps to `Spec K`; all of these meet it in one point,
whose local ring would have to dominate maximal ideals of unbounded embedding dimension. -/
@[stacks 0GE2 "the first assertion, for tau = fppf and S the spectrum of a countable field"]
public theorem not_hasPullbacks (B : BigFppfSite.{u}) (baseField : Type u) [Field baseField]
    [Countable baseField] (hS : B.Contains (Spec (.of baseField))) :
    ¬ HasPullbacks (LocallyNoetherianOver B (Spec (.of baseField)) hS) := by
  intro hpullbacks
  have hbig : B.Contains (Spec (.of (manyVariablesField baseField))) :=
    contains_spec_of_countable B _
  have hprobe : ∀ dimension : ℕ,
      B.Contains (Spec (.of (squareZeroProbe baseField dimension))) :=
    fun dimension => contains_spec_of_countable B _
  let baseObject : LocallyNoetherianOver B (Spec (.of baseField)) hS :=
    ⟨Over.mk (Y := B.obj hS) (𝟙 _), by
      change IsLocallyNoetherian (Spec (.of baseField))
      infer_instance⟩
  let bigObject : LocallyNoetherianOver B (Spec (.of baseField)) hS :=
    ⟨Over.mk (Y := B.obj hbig) (ObjectProperty.homMk
      (Spec.map (CommRingCat.ofHom (manyVariablesBase baseField)))), by
      change IsLocallyNoetherian (Spec (.of (manyVariablesField baseField)))
      infer_instance⟩
  let probeObject : ℕ → LocallyNoetherianOver B (Spec (.of baseField)) hS := fun dimension =>
    ⟨Over.mk (Y := B.obj (hprobe dimension)) (ObjectProperty.homMk
      (Spec.map (CommRingCat.ofHom ((probeEmbedding baseField dimension).comp
        (manyVariablesBase baseField))))), by
      change IsLocallyNoetherian (Spec (.of (squareZeroProbe baseField dimension)))
      exact isLocallyNoetherian_Spec.mpr inferInstance⟩
  let structureMap : bigObject ⟶ baseObject := ObjectProperty.homMk
    (Over.homMk (ObjectProperty.homMk
      (Spec.map (CommRingCat.ofHom (manyVariablesBase baseField)))) (Category.comp_id _))
  let liftMap : ∀ (dimension : ℕ) (f : manyVariablesField baseField →+*
      squareZeroProbe baseField dimension),
      f.comp (manyVariablesBase baseField) =
        (probeEmbedding baseField dimension).comp (manyVariablesBase baseField) →
      (probeObject dimension ⟶ bigObject) := fun dimension f hf =>
    ObjectProperty.homMk (Over.homMk (ObjectProperty.homMk
      (Spec.map (CommRingCat.ofHom f))) (by
        apply ObjectProperty.hom_ext
        exact spec_map_ofHom_comp _ _ _ hf))
  let embeddingMap : ∀ dimension, probeObject dimension ⟶ bigObject := fun dimension =>
    liftMap dimension _ rfl
  let twistMap : ∀ dimension, probeObject dimension ⟶ bigObject := fun dimension =>
    liftMap dimension _ (probeTwist_comp_manyVariablesBase baseField dimension)
  let residueMap : ∀ dimension, bigObject ⟶ probeObject dimension := fun dimension =>
    ObjectProperty.homMk (Over.homMk (ObjectProperty.homMk
      (Spec.map (CommRingCat.ofHom (probeResidue baseField dimension)))) (by
        apply ObjectProperty.hom_ext
        exact spec_map_ofHom_comp _ _ _
          (probeResidue_comp_probeEmbedding_comp_manyVariablesBase baseField dimension)))
  have hbaseTerminal : ∀ {object : LocallyNoetherianOver B (Spec (.of baseField)) hS}
      (firstHom secondHom : object ⟶ baseObject), firstHom = secondHom := by
    intro object firstHom secondHom
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    calc firstHom.hom.left = firstHom.hom.left ≫ 𝟙 (B.obj hS) := (Category.comp_id _).symm
      _ = object.obj.hom := Over.w firstHom.hom
      _ = secondHom.hom.left ≫ 𝟙 (B.obj hS) := (Over.w secondHom.hom).symm
      _ = secondHom.hom.left := Category.comp_id _
  have hresidueLiftMap : ∀ dimension (f : manyVariablesField baseField →+*
      squareZeroProbe baseField dimension) hf,
      (probeResidue baseField dimension).comp f = RingHom.id _ →
      residueMap dimension ≫ liftMap dimension f hf = 𝟙 bigObject := by
    intro dimension f hf hid
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    change Spec.map (CommRingCat.ofHom (probeResidue baseField dimension)) ≫
      Spec.map (CommRingCat.ofHom f) = 𝟙 _
    rw [spec_map_ofHom_comp _ _ _ hid, CommRingCat.ofHom_id, Spec.map_id]
  let product := pullback structureMap structureMap
  let firstProjection := pullback.fst structureMap structureMap
  let secondProjection := pullback.snd structureMap structureMap
  let diagonal : bigObject ⟶ product := pullback.lift (𝟙 bigObject) (𝟙 bigObject) rfl
  let probeLift : ∀ dimension, probeObject dimension ⟶ product := fun dimension =>
    pullback.lift (embeddingMap dimension) (twistMap dimension) (hbaseTerminal _ _)
  have hresidueLift : ∀ dimension,
      residueMap dimension ≫ probeLift dimension = diagonal := by
    intro dimension
    apply pullback.hom_ext
    · rw [Category.assoc, pullback.lift_fst, pullback.lift_fst,
        hresidueLiftMap dimension _ rfl
          (probeResidue_comp_probeEmbedding baseField dimension)]
    · rw [Category.assoc, pullback.lift_snd, pullback.lift_snd,
        hresidueLiftMap dimension _
          (probeTwist_comp_manyVariablesBase baseField dimension)
          (probeResidue_comp_probeTwist baseField dimension)]
  let forget := LocallyNoetherianOver.toScheme B (Spec (.of baseField)) hS
  have : IsLocallyNoetherian (forget.obj product) := product.property
  refine no_representing_locallyNoetherian_scheme baseField (forget.obj product)
    (forget.map firstProjection) (forget.map secondProjection) (forget.map diagonal) ?_
  intro dimension
  refine ⟨forget.map (probeLift dimension), ?_, ?_, ?_⟩
  · rw [← forget.map_comp, pullback.lift_fst]
    rfl
  · rw [← forget.map_comp, pullback.lift_snd]
    rfl
  · rw [show Spec.map (CommRingCat.ofHom (probeResidue baseField dimension)) =
      forget.map (residueMap dimension) from rfl, ← forget.map_comp, hresidueLift dimension]

end LocallyNoetherianOver

end AlgebraicGeometry
