module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.StalkwiseExactness
public import StacksFrontier.AlgebraicGeometry.Modules.AffineGermSpan
public import StacksFrontier.AlgebraicGeometry.AmplePowers.ModuleStalk
public import StacksFrontier.AlgebraicGeometry.FinGenFromCover.Basic
public import StacksFrontier.AlgebraicGeometry.Modules.Stalk
public import StacksFrontier.AlgebraicGeometry.AmplePowers.ModuleStalk
public import StacksFrontier.AlgebraicGeometry.FinGenFromCover.Basic
public import StacksFrontier.AlgebraicGeometry.Modules.StalkSupport
public import StacksFrontier.Examples.Schemes.LocalQuotientDegreeM.Sheaf

/-!
# No quasi-coherent module surjects onto the glued module

Every global section of the module `F` of
`StacksFrontier/Examples/Schemes/LocalQuotientDegreeM/Sheaf.lean` vanishes at the point
`p1 = (0, 1)`: in the `U`-chart a global section is `g` times a function regular at
`p0 = (0, 0)`, and since the curve `g = 0` is irreducible and passes through both points,
cross-multiplying forces the section into the maximal ideal at `p1`. The germ at `p1` of the
section `1` of `F` over `D(y)` is therefore not in the span of the germs of the global sections,
whereas a quasi-coherent module on an affine scheme is generated by its global sections. Hence no
quasi-coherent module admits an epimorphism onto `F`.

## Main results

* `Stacks.Examples.LocalQuotientDegreeM.vanishesAt_p1_of_mem_Fgrp_top`: every global section of
  `F` vanishes at `p1`.
* `Stacks.Examples.LocalQuotientDegreeM.germOne_notMem_vanishingGerms`: the germ at `p1` of the
  local section `1` is not a germ of a section vanishing at `p1`.
* `Stacks.Examples.LocalQuotientDegreeM.not_epi_of_isQuasicoherent`: no morphism from a
  quasi-coherent module to `F` is an epimorphism.
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Stacks.FractionValue
open PrimeSpectrum (basicOpen)
open scoped Stacks.ModuleStalk Stacks.FinGenFromCover

namespace Stacks.Examples.LocalQuotientDegreeM

/-! ### The two distinguished opens and sections -/

/-- The point `p1` lies in `D(y)`. -/
public lemma pt1_mem_basicOpen_y : pt1 ∈ basicOpen yv := y_notMem_p1

/-- The generic point of the line lies in `D(y)`. -/
public lemma ptL_mem_basicOpen_y : ptL ∈ basicOpen yv := y_notMem_pL

/-- An open containing `p1` meets the line. -/
public lemma ptL_mem_of_pt1_mem {W : Opens (PrimeSpectrum.Top Poly)} (h : pt1 ∈ W) : ptL ∈ W :=
  ptL_mem_of_mem h pL_le_p1

/-- The section `1` of `F` over `D(y)`. -/
public def oneSec : Fgrp (basicOpen yv) :=
  ⟨1, fun _ hq _ => ⟨fun _ => one_mem _, fun hy => absurd hy hq⟩,
    fun h => absurd ptL_mem_basicOpen_y h⟩

/-- The section `oneSec` is the rational function `1`. -/
@[simp] public lemma oneSec_coe : (oneSec : Frac) = 1 := rfl

/-! ### Every global section vanishes at `p1` -/

/-- Every global section of `F` vanishes at `p1`. -/
public lemma vanishesAt_p1_of_mem_Fgrp_top (h : Fgrp (⊤ : Opens (PrimeSpectrum.Top Poly))) :
    VanishesAt p1 (h : Frac) := by
  refine vanishesAt_p1_of_mem_Op_of_g_mul ((h.2.1 pt1 trivial pL_le_p1).1 y_notMem_p1) ?_
  exact (h.2.1 pt0 trivial pL_le_p0).2 y_mem_p0

/-! ### The stalk at `p1` and the submodule of vanishing germs -/

/-- The stalk of `𝒪_X` at `p1`. -/
public abbrev stalkRing : RingCat :=
  TopCat.Presheaf.stalk (C := RingCat) Plane.ringCatSheaf.obj pt1

/-- The stalk of `F` at `p1`, as a module over the stalk of `𝒪_X`. -/
public abbrev stalkF : ModuleCat stalkRing :=
  AlgebraicGeometry.SheafOfModules.stalkObj Plane.ringCatSheaf pt1 Fsheaf

/-- The germ at `p1` of a section of `F`. -/
public def germF {W : Opens (PrimeSpectrum.Top Poly)} (hW : pt1 ∈ W) (h : Fgrp W) : stalkF :=
  (TopCat.Presheaf.germ Fsheaf.val.presheaf W pt1 hW).hom h

/-- Taking germs at `p1` is additive. -/
public lemma germF_add {W : Opens (PrimeSpectrum.Top Poly)} (hW : pt1 ∈ W) (h h' : Fgrp W) :
    germF hW (h + h') = germF hW h + germF hW h' :=
  map_add _ _ _

/-- The germ at `p1` of a restriction is the germ of the section. -/
public lemma germF_res {W W' : Opens (PrimeSpectrum.Top Poly)} (hle : W' ≤ W) (hW : pt1 ∈ W)
    (hW' : pt1 ∈ W') (h : Fgrp W) : germF hW' (Fres hle h) = germF hW h :=
  TopCat.Presheaf.germ_res_apply Fsheaf.val.presheaf (homOfLE hle) pt1 hW' h

/-- The germ at `p1` of a section of `𝒪_X`. -/
public abbrev germRing (W : Opens (PrimeSpectrum.Top Poly)) (hW : pt1 ∈ W) :
    Plane.ringCatSheaf.obj.obj (op W) ⟶ stalkRing :=
  TopCat.Presheaf.germ (C := RingCat) Plane.ringCatSheaf.obj W pt1 hW

/-- A section of the `RingCat`-valued structure sheaf, read as a section of `𝒪_X`. -/
public def toSect {W : Opens (PrimeSpectrum.Top Poly)}
    (c : Plane.ringCatSheaf.obj.obj (op W)) : Sect Poly W := c

/-- The germ at `p1` of a multiple of a section is the multiple of its germ by the germ of the
scalar. -/
public lemma germF_smul {W : Opens (PrimeSpectrum.Top Poly)} (hW : pt1 ∈ W)
    (c : Plane.ringCatSheaf.obj.obj (op W)) (h : Fgrp W) :
    germF hW (toSect c • h) = (germRing W hW).hom c • germF hW h :=
  AlgebraicGeometry.SheafOfModules.germ_hom_smul Plane.ringCatSheaf pt1 Fsheaf.val W hW c h

/-- The germ at `p1` of a restriction of a section of `𝒪_X` is the germ of the section. -/
public lemma germRing_res {W W' : Opens (PrimeSpectrum.Top Poly)} (hle : W' ≤ W) (hW : pt1 ∈ W)
    (hW' : pt1 ∈ W') (c : Plane.ringCatSheaf.obj.obj (op W)) :
    (germRing W' hW').hom ((Plane.ringCatSheaf.obj.map (homOfLE hle).op).hom c) =
      (germRing W hW).hom c :=
  TopCat.Presheaf.germ_res_apply Plane.ringCatSheaf.obj (homOfLE hle) pt1 hW' c

/-- A multiple of a section of `F` vanishing at `p1` vanishes at `p1`. -/
public lemma vanishesAt_smul {W : Opens (PrimeSpectrum.Top Poly)} (hW : pt1 ∈ W)
    (c : Sect Poly W) {h : Fgrp W} (hv : VanishesAt p1 (h : Frac)) :
    VanishesAt p1 ((c • h : Fgrp W) : Frac) := by
  have hc : genericValue c ∈ Op p1 := genericValue_mem_Op (q := pt1) c hW
  rw [smul_coe]
  exact vanishesAt_mul prime_p1 hc hv

/-- The restriction of a section of `F` vanishing at `p1`, to an open meeting the line, vanishes
at `p1`. -/
public lemma vanishesAt_res {W W' : Opens (PrimeSpectrum.Top Poly)} (hle : W' ≤ W)
    (hL' : ptL ∈ W') {h : Fgrp W} (hv : VanishesAt p1 (h : Frac)) :
    VanishesAt p1 ((Fres hle h : Fgrp W') : Frac) := by
  rw [Fres_coe _ hL']
  exact hv

/-- The germs at `p1` of those sections of `F` that vanish at `p1`. -/
public def vanishingGerms : Submodule stalkRing stalkF where
  carrier := {z | ∃ (W : Opens (PrimeSpectrum.Top Poly)) (hW : pt1 ∈ W) (h : Fgrp W),
    germF hW h = z ∧ VanishesAt p1 (h : Frac)}
  zero_mem' := ⟨⊤, trivial, 0, map_zero _, vanishesAt_zero p1 prime_p1⟩
  add_mem' := by
    rintro z z' hz hz'
    obtain ⟨W, hW, h, rfl, hv⟩ := hz
    obtain ⟨W', hW', h', rfl, hv'⟩ := hz'
    have hinf : pt1 ∈ W ⊓ W' := Opens.mem_inf.mpr ⟨hW, hW'⟩
    have hLinf : ptL ∈ W ⊓ W' := ptL_mem_of_pt1_mem hinf
    refine ⟨W ⊓ W', hinf, Fres inf_le_left h + Fres inf_le_right h', ?_, ?_⟩
    · rw [germF_add, germF_res inf_le_left hW hinf, germF_res inf_le_right hW' hinf]
    · rw [show ((Fres (inf_le_left : W ⊓ W' ≤ W) h + Fres (inf_le_right : W ⊓ W' ≤ W') h' :
          Fgrp (W ⊓ W')) : Frac) = ((Fres (inf_le_left : W ⊓ W' ≤ W) h : Fgrp (W ⊓ W')) : Frac) +
          ((Fres (inf_le_right : W ⊓ W' ≤ W') h' : Fgrp (W ⊓ W')) : Frac) from rfl,
        Fres_coe _ hLinf, Fres_coe _ hLinf]
      exact vanishesAt_add prime_p1 hv hv'
  smul_mem' := by
    rintro r z hz
    obtain ⟨W, hW, h, rfl, hv⟩ := hz
    obtain ⟨Wr, hWr, c, hc⟩ := TopCat.Presheaf.exists_germ_eq
      (X := PrimeSpectrum.Top Poly) (C := RingCat) Plane.ringCatSheaf.obj r
    have hinf : pt1 ∈ Wr ⊓ W := Opens.mem_inf.mpr ⟨hWr, hW⟩
    have hLinf : ptL ∈ Wr ⊓ W := ptL_mem_of_pt1_mem hinf
    refine ⟨Wr ⊓ W, hinf,
      toSect ((Plane.ringCatSheaf.obj.map (homOfLE (inf_le_left : Wr ⊓ W ≤ Wr)).op).hom c) •
        Fres (inf_le_right : Wr ⊓ W ≤ W) h, ?_, ?_⟩
    · calc germF hinf (toSect ((Plane.ringCatSheaf.obj.map
              (homOfLE (inf_le_left : Wr ⊓ W ≤ Wr)).op).hom c) •
              Fres (inf_le_right : Wr ⊓ W ≤ W) h)
          = (germRing (Wr ⊓ W) hinf).hom ((Plane.ringCatSheaf.obj.map
              (homOfLE (inf_le_left : Wr ⊓ W ≤ Wr)).op).hom c) •
              germF hinf (Fres (inf_le_right : Wr ⊓ W ≤ W) h) := germF_smul hinf _ _
        _ = (germRing Wr hWr).hom c • germF hW h :=
            congrArg₂ (fun (a : stalkRing) (z : stalkF) => a • z)
              (germRing_res (inf_le_left : Wr ⊓ W ≤ Wr) hWr hinf c)
              (germF_res (inf_le_right : Wr ⊓ W ≤ W) hW hinf h)
        _ = r • germF hW h := congrArg (fun a : stalkRing => a • germF hW h) hc
    · exact vanishesAt_smul hinf _ (vanishesAt_res _ hLinf hv)

/-- Membership in `vanishingGerms`. -/
public lemma mem_vanishingGerms {z : stalkF} : z ∈ vanishingGerms ↔
    ∃ (W : Opens (PrimeSpectrum.Top Poly)) (hW : pt1 ∈ W) (h : Fgrp W),
      germF hW h = z ∧ VanishesAt p1 (h : Frac) := Iff.rfl

/-- The germ at `p1` of the section `1` is not the germ of a section vanishing at `p1`. -/
public lemma germOne_notMem_vanishingGerms :
    germF pt1_mem_basicOpen_y oneSec ∉ vanishingGerms := by
  intro hmem
  obtain ⟨W, hW, h, hgerm, hv⟩ := mem_vanishingGerms.mp hmem
  obtain ⟨W₀, hW₀, iW, iD, heq⟩ :=
    TopCat.Presheaf.germ_eq Fsheaf.val.presheaf pt1 hW pt1_mem_basicOpen_y h oneSec hgerm
  have hL₀ : ptL ∈ W₀ := ptL_mem_of_pt1_mem hW₀
  have key : ∀ {W' : Opens (PrimeSpectrum.Top Poly)} (i : W₀ ⟶ W') (g : Fgrp W'),
      (Fsheaf.val.presheaf.map i.op g).1 = g.1 := fun i g => Fres_coe (leOfHom i) hL₀ g
  have hval : (h : Frac) = 1 := by
    have e := Subtype.ext_iff.mp heq
    rwa [key iW, key iD] at e
  rw [hval] at hv
  exact not_vanishesAt_one prime_p1 hv

/-! ### No quasi-coherent module surjects onto `F` -/

/-- `F` read as a module on the scheme `X`. -/
public abbrev Fmod : Plane.Modules := Fsheaf

/-- No quasi-coherent `𝒪_X`-module surjects onto `F`. -/
public lemma not_epi_of_isQuasicoherent (M : Plane.Modules)
    [SheafOfModules.IsQuasicoherent M] (f : M ⟶ Fmod) : ¬ Epi f := by
  intro hepi
  have hepi' : @Epi (SheafOfModules.{0} Plane.ringCatSheaf) (inferInstance) M Fmod f :=
    Scheme.Modules.epi_sheafOfModules f
  obtain ⟨w, hw⟩ := (AlgebraicGeometry.SheafOfModules.epi_iff_surjective_stalkMap
    (O := Plane.ringCatSheaf) f).1 hepi' pt1 (germF pt1_mem_basicOpen_y oneSec)
  have hspan := Stacks.AffineGermSpan.span_range_germ_sections_eq_top (X := Plane) M
    (isAffineOpen_top Plane) (x := pt1) trivial
  have hw' := hspan.ge (Submodule.mem_top (R := stalkRing) (x := w))
  have hmain : (AlgebraicGeometry.SheafOfModules.stalkMap Plane.ringCatSheaf pt1 f).hom w
      ∈ vanishingGerms := by
    clear hw
    induction hw' using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨m, rfl⟩ := hz
      refine mem_vanishingGerms.mpr ⟨⊤, trivial, f.val.app (op ⊤) m, ?_,
        vanishesAt_p1_of_mem_Fgrp_top _⟩
      exact (AlgebraicGeometry.SheafOfModules.stalkMap_germ Plane.ringCatSheaf pt1 f
        (⊤ : Opens (PrimeSpectrum.Top Poly)) trivial m).symm
    | zero => rw [map_zero]; exact vanishingGerms.zero_mem
    | add x y _ _ ihx ihy => rw [map_add]; exact vanishingGerms.add_mem ihx ihy
    | smul a x _ ih => rw [map_smul]; exact vanishingGerms.smul_mem a ih
  exact germOne_notMem_vanishingGerms (hw ▸ hmain)

end Stacks.Examples.LocalQuotientDegreeM

end
