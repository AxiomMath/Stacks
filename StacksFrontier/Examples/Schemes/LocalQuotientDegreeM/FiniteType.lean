module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FiniteTypeDegreeZero
public import StacksFrontier.Examples.Schemes.LocalQuotientDegreeM.NotGlobal

/-!
# The glued module is of finite type, and the global clause of Tag 08E5 fails

The `𝒪_X`-module `F` (`Stacks.Examples.LocalQuotientDegreeM.Fsheaf`) on `X = Spec ℚ[x, y]` is
locally cyclic: on the three basic opens `D(y)`, `D(y - 1)` and `D(x)`, which cover `X`, it is
generated by the single section `1`, by the single section `g = x - y(y - 1)`, and by `0`
respectively. Hence `F` is an `𝒪_X`-module of finite type, so `F[0]` is `0`-pseudo-coherent, while
no quasi-coherent `𝒪_X`-module surjects onto `F`. This refutes the global clause of Stacks Tag
08E5.

## Main definitions

* `Stacks.Examples.LocalQuotientDegreeM.LocallyGenerated`: a section of `F` over `W` generates `F`
  near every point of every open inside `W`.
* `Stacks.Examples.LocalQuotientDegreeM.chartGenerators`: the generating section of the
  restriction of `F` to the slice site over `W` given by a locally generating section.
* `Stacks.Examples.LocalQuotientDegreeM.chart` and
  `Stacks.Examples.LocalQuotientDegreeM.chartSection`: the cover of `X` by `D(y)`, `D(y - 1)` and
  `D(x)`, and the sections `1`, `g` and `0` over them.
* `Stacks.Examples.LocalQuotientDegreeM.localGenerators`: the
  `SheafOfModules.LocalGeneratorsData` of `F` given by these charts and sections.
* `Stacks.Examples.LocalQuotientDegreeM.FsingleZero`: the complex `F[0]` in the derived category
  of `𝒪_X`-modules.

## Main results

* `Stacks.Examples.LocalQuotientDegreeM.locallyGenerated_oneSec`,
  `Stacks.Examples.LocalQuotientDegreeM.locallyGenerated_gSec` and
  `Stacks.Examples.LocalQuotientDegreeM.locallyGenerated_zero`: the sections `1` on `D(y)`, `g` on
  `D(y - 1)` and `0` on `D(x)` locally generate `F`.
* `Stacks.Examples.LocalQuotientDegreeM.chart_coversTop`: `D(y)`, `D(y - 1)` and `D(x)` cover `X`.
* `Stacks.Examples.LocalQuotientDegreeM.isFiniteType_Fsheaf`: `F` is of finite type.
* `Stacks.Examples.LocalQuotientDegreeM.isPseudoCoherentFrom_zero_and_no_quasicoherent_epi`:
  `F[0]` is `0`-pseudo-coherent and no quasi-coherent module surjects onto `H^0(F[0])`.

## References

* [The Stacks Project, Lemma 36.10.1 (08E5)](https://stacks.math.columbia.edu/tag/08E5)
* [The Stacks Project, Lemma 36.60.11 (09V9)](https://stacks.math.columbia.edu/tag/09V9)
* [The Stacks Project, Definition 17.9.1 (01B4)](https://stacks.math.columbia.edu/tag/01B4)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Stacks.FractionValue
open PrimeSpectrum (basicOpen)

namespace Stacks.Examples.LocalQuotientDegreeM

/-- Restriction along a composite of inclusions is the composite of the restrictions. -/
public lemma Fres_trans {W W' W'' : Opens (PrimeSpectrum.Top Poly)} (h : W'' ≤ W') (h' : W' ≤ W)
    (x : Fgrp W) : Fres h (Fres h' x) = Fres (h.trans h') x := by
  refine Fgrp_ext ?_
  by_cases hL : ptL ∈ W''
  · rw [Fres_coe _ hL, Fres_coe _ hL, Fres_coe _ (h hL)]
  · rw [Fres_coe_of_notMem _ hL, Fres_coe_of_notMem _ hL]

/-- A section of `F` over `W` read as a global section of the restriction of `F` to the slice
site over `W`: the compatible family of its restrictions to the opens inside `W`. -/
public def overSection (W : Plane.Opens) (h₀ : Fgrp W) : (Fsheaf.over W).sections :=
  PresheafOfModules.sectionsMk (fun Z => Fres (leOfHom Z.unop.hom) h₀)
    (fun {_ _} f => Fres_trans (leOfHom f.unop.left) _ h₀)

/-- A section of the structure sheaf of `Spec ℚ[x, y]`, read as a section of the `RingCat`-valued
structure sheaf of the scheme; the inverse of `Stacks.Examples.LocalQuotientDegreeM.toSect`. -/
public def ofSect {V : Opens (PrimeSpectrum.Top Poly)} (c : Sect Poly V) :
    Plane.ringCatSheaf.obj.obj (op V) := c

/-- The two readings of a section of the structure sheaf are inverse to each other. -/
public lemma toSect_ofSect {V : Opens (PrimeSpectrum.Top Poly)} (c : Sect Poly V) :
    toSect (ofSect c) = c := rfl

/-- The section `h₀` of `F` over `W` generates `F` over `W`: every section of `F` over an open
`V` inside `W` agrees, near every point of `V`, with a multiple of `h₀` by a section of the
structure sheaf. -/
public def LocallyGenerated (W : Opens (PrimeSpectrum.Top Poly)) (h₀ : Fgrp W) : Prop :=
  ∀ (V : Opens (PrimeSpectrum.Top Poly)) (hVW : V ≤ W) (t : Fgrp V)
    (q : PrimeSpectrum Poly), q ∈ V →
    ∃ (V' : Opens (PrimeSpectrum.Top Poly)) (hV' : V' ≤ V), q ∈ V' ∧
      ∃ c : Plane.ringCatSheaf.obj.obj (op V'),
        Fres hV' t = toSect c • Fres (hV'.trans hVW) h₀

/-- A section satisfying `Stacks.Examples.LocalQuotientDegreeM.LocallyGenerated` gives an
epimorphism from the structure sheaf onto the restriction of `F` to the slice site over `W`. -/
public lemma epi_unitHom (W : Plane.Opens) (h₀ : Fgrp W) (hgen : LocallyGenerated W h₀) :
    Epi ((Fsheaf.over W).unitHomEquiv.symm (overSection W h₀)) := by
  refine Stacks.SheafOfModules.EpiMono.epi_of_isLocallySurjective _ ⟨fun {Z} t => ?_⟩
  refine (GrothendieckTopology.mem_over_iff (J := Opens.grothendieckTopology _) _).mpr
    fun q hq => ?_
  obtain ⟨V', hV', hqV', c, hc⟩ := hgen Z.left (leOfHom Z.hom) t q hq
  refine ⟨V', homOfLE hV', (Sieve.overEquiv_iff _ (homOfLE hV')).mpr ⟨c, ?_⟩, hqV'⟩
  exact hc.symm

/-! ### The local generators in the three charts -/

/-- A nonzero polynomial is nonzero in the function field. -/
public lemma algebraMap_ne_zero {s : Poly} (hs : s ≠ 0) : algebraMap Poly Frac s ≠ 0 :=
  fun h0 => hs (IsFractionRing.injective Poly Frac (h0.trans (map_zero _).symm))

/-- A section of `F` is a given multiple of another, after restriction to `V'`, as soon as the
two agree as rational functions when `V'` meets the line. -/
public lemma Fres_eq_smul_of_coe {V' V W : Opens (PrimeSpectrum.Top Poly)} (hV'V : V' ≤ V)
    (hV'W : V' ≤ W) (t : Fgrp V) (h₀ : Fgrp W) (c : Sect Poly V')
    (hcoe : ptL ∈ V' → (t : Frac) = genericValue c * (h₀ : Frac)) :
    Fres hV'V t = toSect (ofSect c) • Fres hV'W h₀ := by
  rw [toSect_ofSect]
  refine Fgrp_ext ?_
  by_cases hL : ptL ∈ V'
  · rw [smul_coe, Fres_coe _ hL, Fres_coe _ hL]
    exact hcoe hL
  · rw [smul_coe, Fres_coe_of_notMem _ hL, Fres_coe_of_notMem _ hL, mul_zero]

/-- On any open inside `D(s)`, the fraction `a / s` is a section of the structure sheaf. -/
public lemma exists_sect_genericValue {V' : Opens (PrimeSpectrum.Top Poly)} {a s : Poly}
    (hs : s ≠ 0) (hle : V' ≤ basicOpen s) :
    ∃ c : Sect Poly V', genericPt Poly ∈ V' →
      genericValue c * algebraMap Poly Frac s = algebraMap Poly Frac a := by
  obtain ⟨c₀, hc₀⟩ := exists_section_genericValue a s hs
  refine ⟨(Spec.structureSheaf Poly).presheaf.map (homOfLE hle).op c₀, fun hgen => ?_⟩
  rw [genericValue_res hle hgen c₀]
  exact hc₀

/-- Near a point off the line `L = V(x)`, every section of `F` is a multiple of any given
section. -/
public lemma locallyGenerated_off_line {V W : Opens (PrimeSpectrum.Top Poly)} (hVW : V ≤ W)
    (t : Fgrp V) (h₀ : Fgrp W) {q : PrimeSpectrum Poly} (hq : q ∈ V)
    (hne : ¬ pL ≤ q.asIdeal) :
    ∃ (V' : Opens (PrimeSpectrum.Top Poly)) (hV' : V' ≤ V), q ∈ V' ∧
      ∃ c : Plane.ringCatSheaf.obj.obj (op V'),
        Fres hV' t = toSect c • Fres (hV'.trans hVW) h₀ := by
  obtain ⟨u, hu, hu'⟩ := IsConcreteLE.not_le_iff_exists.mp hne
  exact ⟨V ⊓ basicOpen u, inf_le_left, Opens.mem_inf.mpr ⟨hq, hu'⟩, ofSect 0,
    Fres_eq_smul_of_coe _ _ t h₀ 0 fun hL => absurd hu (Opens.mem_inf.mp hL).2⟩

/-- Near a point `q` of `V` where `s ≠ 0`, a section of `F` is a multiple of another by a section
of the structure sheaf, as soon as this holds generically for any section `c` with
`c * s = a`. -/
private lemma exists_smul_of_mul_eq {V W : Opens (PrimeSpectrum.Top Poly)} (hVW : V ≤ W)
    (t : Fgrp V) (h₀ : Fgrp W) {q : PrimeSpectrum Poly} (hq : q ∈ V) {a s : Poly}
    (hs : s ∉ q.asIdeal)
    (key : s ≠ 0 → ∀ c : Sect Poly (V ⊓ basicOpen s),
      genericValue c * algebraMap Poly Frac s = algebraMap Poly Frac a →
      ptL ∈ V ⊓ basicOpen s → (t : Frac) = genericValue c * (h₀ : Frac)) :
    ∃ (V' : Opens (PrimeSpectrum.Top Poly)) (hV' : V' ≤ V), q ∈ V' ∧
      ∃ c : Plane.ringCatSheaf.obj.obj (op V'),
        Fres hV' t = toSect c • Fres (hV'.trans hVW) h₀ := by
  have hs0 : s ≠ 0 := fun h => hs (h ▸ q.asIdeal.zero_mem)
  obtain ⟨c, hc⟩ := exists_sect_genericValue (V' := V ⊓ basicOpen s) (a := a) hs0 inf_le_right
  exact ⟨V ⊓ basicOpen s, inf_le_left, Opens.mem_inf.mpr ⟨hq, hs⟩, ofSect c,
    Fres_eq_smul_of_coe _ _ t h₀ c fun hL =>
      key hs0 c (hc (genericPt_mem_of_ptL_mem hL)) hL⟩

/-- `F` is generated by the section `1` on `D(y)`. -/
public lemma locallyGenerated_oneSec : LocallyGenerated (basicOpen yv) oneSec := by
  intro V hVW t q hq
  by_cases hpl : pL ≤ q.asIdeal
  · have hy : yv ∉ q.asIdeal := hVW hq
    obtain ⟨a, s, hs, he⟩ := (mem_Op_iff q.isPrime).mp ((t.2.1 q hq hpl).1 hy)
    refine exists_smul_of_mul_eq hVW t oneSec hq (a := a) hs fun hs0 c hc _ => ?_
    rw [oneSec_coe, mul_one]
    exact mul_right_cancel₀ (algebraMap_ne_zero hs0) (he.trans hc.symm)
  · exact locallyGenerated_off_line hVW t oneSec hq hpl

/-- `y - 1` does not vanish identically on the line `L = V(x)`. -/
public lemma ysub1_notMem_pL : yv - 1 ∉ pL := by
  simp only [pL, yv, lineHom, RingHom.mem_ker, map_sub, map_one, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, MvPolynomial.aeval_X, ite_eq_right (one_ne_zero' (Fin 2))]
  intro h
  simpa using congrArg (Polynomial.eval (0 : ℚ)) h

/-- The generic point of the line lies in `D(y - 1)`. -/
public lemma ptL_mem_basicOpen_ysub1 : ptL ∈ basicOpen (yv - 1) := ysub1_notMem_pL

/-- The section `g` of `F` over `D(y - 1)`. -/
public def gSec : Fgrp (basicOpen (yv - 1)) :=
  ⟨algebraMap Poly Frac gpoly,
    fun _ _ _ => ⟨fun _ => algebraMap_mem_Op _ _, fun _ => ⟨1, one_mem _, (mul_one _).symm⟩⟩,
    fun h => absurd ptL_mem_basicOpen_ysub1 h⟩

/-- The section `g` is the rational function `g`. -/
@[simp] public lemma gSec_coe : (gSec : Frac) = algebraMap Poly Frac gpoly := rfl

/-- `F` is generated by the section `g` on `D(y - 1)`. -/
public lemma locallyGenerated_gSec : LocallyGenerated (basicOpen (yv - 1)) gSec := by
  intro V hVW t q hq
  by_cases hpl : pL ≤ q.asIdeal
  · have hy1 : yv - 1 ∉ q.asIdeal := hVW hq
    have hx : xv ∈ q.asIdeal := hpl x_mem_pL
    by_cases hy : yv ∈ q.asIdeal
    · obtain ⟨u, hu, hut⟩ := (t.2.1 q hq hpl).2 hy
      obtain ⟨b, s, hs, he⟩ := (mem_Op_iff q.isPrime).mp hu
      refine exists_smul_of_mul_eq hVW t gSec hq (a := b) hs fun hs0 c hc _ => ?_
      have hcu : genericValue c = u :=
        mul_right_cancel₀ (algebraMap_ne_zero hs0) (hc.trans he.symm)
      rw [gSec_coe, hcu, hut, mul_comm]
    · have hg : gpoly ∉ q.asIdeal := g_notMem q.isPrime hx hy hy1
      obtain ⟨a, s, hs, he⟩ := (mem_Op_iff q.isPrime).mp ((t.2.1 q hq hpl).1 hy)
      refine exists_smul_of_mul_eq hVW t gSec hq (a := a)
        (s := gpoly * s) (fun hm => (q.isPrime.mem_or_mem hm).elim hg hs) fun hgs0 c hc _ => ?_
      rw [map_mul] at hc
      rw [gSec_coe]
      refine mul_right_cancel₀ (algebraMap_ne_zero (right_ne_zero_of_mul hgs0)) ?_
      rw [he, ← hc]
      ring
  · exact locallyGenerated_off_line hVW t gSec hq hpl

/-- `F` is generated by the section `0` on `D(x)`: it vanishes there. -/
public lemma locallyGenerated_zero :
    LocallyGenerated (basicOpen xv) (0 : Fgrp (basicOpen xv)) := fun V hVW t _ hq =>
  ⟨V, le_rfl, hq, ofSect 0, Fres_eq_smul_of_coe _ _ t 0 0 fun hL => absurd x_mem_pL (hVW hL)⟩

/-- The one-element family of generating sections of the restriction of `F` to the slice site
over `W` determined by a section satisfying
`Stacks.Examples.LocalQuotientDegreeM.LocallyGenerated`. -/
public def chartGenerators (W : Plane.Opens) (h₀ : Fgrp W) (hgen : LocallyGenerated W h₀) :
    (Fsheaf.over W).GeneratingSections where
  I := PUnit.{1}
  s _ := overSection W h₀
  epi := by
    have key := SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply
      ((Fsheaf.over W).freeHomEquiv.symm (fun _ : PUnit.{1} => overSection W h₀)) PUnit.unit
    rw [Equiv.apply_symm_apply] at key
    have h := epi_unitHom W h₀ hgen
    rw [key] at h
    exact epi_of_epi
      (SheafOfModules.ιFree (R := Plane.ringCatSheaf.over W) (PUnit.unit : PUnit.{1})) _

/-- The generating family `Stacks.Examples.LocalQuotientDegreeM.chartGenerators` is finite. -/
public lemma chartGenerators_isFiniteType (W : Plane.Opens) (h₀ : Fgrp W)
    (hgen : LocallyGenerated W h₀) : (chartGenerators W h₀ hgen).IsFiniteType :=
  ⟨inferInstanceAs (Finite PUnit.{1})⟩

/-! ### The three-chart cover, and finite type -/

/-- The three charts: `D(y)`, `D(y - 1)` and `D(x)`. -/
public def chart : Fin 3 → Plane.Opens
  | 0 => basicOpen yv
  | 1 => basicOpen (yv - 1)
  | 2 => basicOpen xv

/-- The generator in each chart: `1` on `D(y)`, `g` on `D(y - 1)` and `0` on `D(x)`. -/
public def chartSection : ∀ i : Fin 3, Fgrp (chart i)
  | 0 => oneSec
  | 1 => gSec
  | 2 => 0

/-- Each chart's section generates `F` over that chart. -/
public lemma chartSection_locallyGenerated (i : Fin 3) :
    LocallyGenerated (chart i) (chartSection i) := by
  match i with
  | 0 => exact locallyGenerated_oneSec
  | 1 => exact locallyGenerated_gSec
  | 2 => exact locallyGenerated_zero

/-- The three charts `D(y)`, `D(y - 1)` and `D(x)` cover `X`. -/
public lemma chart_coversTop : (Opens.grothendieckTopology ↥Plane).CoversTop chart := by
  rw [Opens.coversTop_iff]
  refine IsOpenCover.mk ?_
  rw [eq_top_iff]
  intro q _
  rw [Opens.mem_iSup]
  by_cases hx : xv ∈ q.asIdeal
  · by_cases hy : yv ∈ q.asIdeal
    · refine ⟨1, fun hc => q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr ?_)⟩
      simpa using q.asIdeal.sub_mem hy hc
    · exact ⟨0, hy⟩
  · exact ⟨2, hx⟩

/-- The local generators of `F`: the three-chart cover, with one generating section over each
member. -/
public def localGenerators : Fsheaf.LocalGeneratorsData where
  I := Fin 3
  X := chart
  coversTop := chart_coversTop
  generators i := chartGenerators (chart i) (chartSection i) (chartSection_locallyGenerated i)

/-- `F` is an `𝒪_X`-module of finite type. -/
public instance isFiniteType_Fsheaf : SheafOfModules.IsFiniteType Fsheaf :=
  ⟨⟨localGenerators, ⟨fun i => chartGenerators_isFiniteType (chart i) (chartSection i)
      (chartSection_locallyGenerated i)⟩⟩⟩

/-! ### The refutation of the global clause of Tag 08E5 -/

section Refutation

attribute [local instance] HasDerivedCategory.standard

/-- The derived-category object `F[0]`: the module `F` placed in degree zero. -/
public abbrev FsingleZero :
    DerivedCategory (StrictlyPerfect.OXMod.{0, 0, 0} Plane.toRingedSpace) :=
  (DerivedCategory.singleFunctor
    (StrictlyPerfect.OXMod.{0, 0, 0} Plane.toRingedSpace) 0).obj Fsheaf

/-- The isomorphism `H^0(F[0]) ≅ F`. -/
public def homologyFsingleZeroIso :
    (DerivedCategory.homologyFunctor
      (StrictlyPerfect.OXMod.{0, 0, 0} Plane.toRingedSpace) 0).obj FsingleZero ≅ Fsheaf :=
  (DerivedCategory.singleFunctorCompHomologyFunctorIso
    (StrictlyPerfect.OXMod.{0, 0, 0} Plane.toRingedSpace) 0).app Fsheaf

/-- An epimorphism of sheaves of modules over the structure sheaf of `X` is an epimorphism in
`X.Modules`. -/
private lemma epi_planeModules {M N : Plane.Modules} (f : M ⟶ N)
    (h : @Epi (SheafOfModules.{0} Plane.ringCatSheaf) inferInstance M N f) : Epi f :=
  ⟨fun g k hgk => h.left_cancellation g k hgk⟩

/-- The global clause of Stacks Tag 08E5 fails: on `X = Spec ℚ[x, y]`, the complex `F[0]` is
`0`-pseudo-coherent, yet no quasi-coherent `𝒪_X`-module admits an epimorphism onto `H^0(F[0])`. -/
public theorem isPseudoCoherentFrom_zero_and_no_quasicoherent_epi :
    AlgebraicGeometry.RingedSpace.IsPseudoCoherentFrom (X := Plane.toRingedSpace)
        FsingleZero 0 ∧
      ∀ M : StrictlyPerfect.OXMod.{0, 0, 0} Plane.toRingedSpace,
        SheafOfModules.IsQuasicoherent M →
        ∀ f : M ⟶ (DerivedCategory.homologyFunctor
            (StrictlyPerfect.OXMod.{0, 0, 0} Plane.toRingedSpace) 0).obj FsingleZero, ¬ Epi f := by
  refine ⟨AlgebraicGeometry.RingedSpace.isPseudoCoherentFrom_singleFunctor_zero_of_isFiniteType
    Fsheaf isFiniteType_Fsheaf, fun M hM f hepi => ?_⟩
  have : Epi homologyFsingleZeroIso.hom := @IsIso.epi_of_iso _ _ _ _
    homologyFsingleZeroIso.hom homologyFsingleZeroIso.isIso_hom
  exact @not_epi_of_isQuasicoherent M hM (f ≫ homologyFsingleZeroIso.hom)
    (epi_planeModules _ (epi_comp f homologyFsingleZeroIso.hom))

end Refutation

end Stacks.Examples.LocalQuotientDegreeM

end
