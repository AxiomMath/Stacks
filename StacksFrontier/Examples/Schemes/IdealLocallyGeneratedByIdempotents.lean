module

public import Mathlib.Algebra.Field.ULift
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Order.Filter.Cofinite
public import Mathlib.Order.Filter.EventuallyConst
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# An ideal locally, but not globally, generated by idempotents

There is a closed subscheme of an affine scheme whose defining ideal is generated by
idempotents on a Zariski open neighbourhood of every point, but not on the whole scheme.

The ring is built from integer-indexed, eventually constant pairs of polynomials over `𝔽₃`:
a pair `(p, q)` sitting at the index `n` is required to satisfy `p(0) = q(0)`, and `p(1)` is
required to agree with the value at `1` of the second component of the pair sitting at `n + 1`.
The ideal is the set of sequences of finite support. The elements `X` and `X - 1`, constant in
the index, are complementary in the sense that `X - (X - 1) = 1`, so every prime misses one of
them; on the corresponding principal open the coordinate selectors multiplied by the missing
factor may be divided by it, and the resulting elements are idempotent and generate the ideal.
Globally no idempotent of finite support is nonzero, because the identification at `1`
propagates a nonzero coordinate to the next index.

## Main results

* `Stacks.Examples.exists_ideal_locally_span_idempotents_not_globally`: the counterexample.

## Implementation notes

A closed subscheme of `Spec R` is specified by its defining ideal `I`. Its restriction to a
principal open `D(f)` is the extension of `I` to `R[f⁻¹]`. The local condition uses one such
open neighbourhood at each prime of `R`; the global condition denies any set of idempotents
spanning `I`. The coefficient field is wrapped in `ULift` so that the ring can be produced in
any universe.

## References

* [Stacks Project, Tag 04QL](https://stacks.math.columbia.edu/tag/04QL)
-/

@[expose] public section

namespace Stacks.Examples

universe u

noncomputable section

/-- The field `𝔽₃`, in an arbitrary universe. -/
private abbrev TwistCoeff := ULift.{u} (ZMod 3)

/-- A pair of polynomials over `𝔽₃`, thought of as the two branches attached to one index. -/
private abbrev TwistBranch := Polynomial TwistCoeff.{u} × Polynomial TwistCoeff.{u}

/-- The subring of integer-indexed families of branches that are constant away from a finite
set of indices. -/
private def eventuallyConstantBranches : Subring (Int → TwistBranch) where
  carrier := {f | Filter.EventuallyConst f Filter.cofinite}
  zero_mem' := Filter.EventuallyConst.const 0
  one_mem' := Filter.EventuallyConst.const 1
  add_mem' := fun ha hb => ha.add hb
  neg_mem' := fun ha => ha.neg
  mul_mem' := fun ha hb => ha.mul hb

/-- An eventually constant, integer-indexed family of branches. -/
private abbrev BranchSeq := ↥eventuallyConstantBranches

/-- The subring of eventually constant families of branches whose two components agree at `0`
at every index, and whose first component at an index agrees at `1` with the second component
at the next index. -/
private def twistedBranches : Subring BranchSeq where
  carrier := {f | ∀ n : Int,
    Polynomial.eval 0 (f.1 n).1 = Polynomial.eval 0 (f.1 n).2 ∧
    Polynomial.eval 1 (f.1 n).1 = Polynomial.eval 1 (f.1 (n + 1)).2}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro a b ha hb n
    constructor
    · change Polynomial.eval 0 ((a.1 n).1 + (b.1 n).1) =
        Polynomial.eval 0 ((a.1 n).2 + (b.1 n).2)
      rw [Polynomial.eval_add, Polynomial.eval_add, (ha n).1, (hb n).1]
    · change Polynomial.eval 1 ((a.1 n).1 + (b.1 n).1) =
        Polynomial.eval 1 ((a.1 (n + 1)).2 + (b.1 (n + 1)).2)
      rw [Polynomial.eval_add, Polynomial.eval_add, (ha n).2, (hb n).2]
  neg_mem' := by
    intro a ha n
    constructor
    · change Polynomial.eval 0 (- (a.1 n).1) = Polynomial.eval 0 (- (a.1 n).2)
      rw [Polynomial.eval_neg, Polynomial.eval_neg, (ha n).1]
    · change Polynomial.eval 1 (- (a.1 n).1) = Polynomial.eval 1 (- (a.1 (n + 1)).2)
      rw [Polynomial.eval_neg, Polynomial.eval_neg, (ha n).2]
  mul_mem' := by
    intro a b ha hb n
    constructor
    · change Polynomial.eval 0 ((a.1 n).1 * (b.1 n).1) =
        Polynomial.eval 0 ((a.1 n).2 * (b.1 n).2)
      rw [Polynomial.eval_mul, Polynomial.eval_mul, (ha n).1, (hb n).1]
    · change Polynomial.eval 1 ((a.1 n).1 * (b.1 n).1) =
        Polynomial.eval 1 ((a.1 (n + 1)).2 * (b.1 (n + 1)).2)
      rw [Polynomial.eval_mul, Polynomial.eval_mul, (ha n).2, (hb n).2]

/-- The ring of eventually constant families of branches subject to the two endpoint
identifications. -/
private abbrev TwistRing := ↥twistedBranches

/-- The ideal of elements of `TwistRing` whose first component vanishes outside a finite set of
indices. -/
private def tailIdeal : Ideal TwistRing where
  carrier := {a | ∀ᶠ n : Int in Filter.cofinite, a.1.1 n = 0}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    change (∀ᶠ n : Int in Filter.cofinite, a.1.1 n = 0) at ha
    change (∀ᶠ n : Int in Filter.cofinite, b.1.1 n = 0) at hb
    change ∀ᶠ n : Int in Filter.cofinite, (a + b).1.1 n = 0
    filter_upwards [ha, hb] with n hn hm
    simp [hn, hm]
  smul_mem' := by
    intro a b hb
    change (∀ᶠ n : Int in Filter.cofinite, b.1.1 n = 0) at hb
    change ∀ᶠ n : Int in Filter.cofinite, (a • b).1.1 n = 0
    filter_upwards [hb] with n hn
    simp [hn]

/-- The polynomial `X (X - 1)`, which vanishes at both `0` and `1`. -/
private def vanishingPoly : Polynomial TwistCoeff := Polynomial.X * (Polynomial.X - 1)

/-- The element of `TwistRing` equal to the pair `(p, q)` at every index, for a pair that
satisfies the endpoint identifications. -/
private def branchConstant (p q : Polynomial TwistCoeff)
    (hp : Polynomial.eval 0 p = Polynomial.eval 0 q)
    (hq : Polynomial.eval 1 p = Polynomial.eval 1 q) : TwistRing :=
  ⟨⟨fun _ => (p, q), by
      change Filter.EventuallyConst (fun _ : Int => (p, q)) Filter.cofinite
      rw [Filter.eventuallyConst_iff_exists_eventuallyEq]
      exact ⟨(p, q), Filter.Eventually.of_forall fun _ => rfl⟩⟩,
    by intro n; exact ⟨hp, hq⟩⟩

/-- The element of `TwistRing` equal to `(X, X)` at every index. -/
private def branchX : TwistRing := branchConstant Polynomial.X Polynomial.X rfl rfl

/-- The element of `TwistRing` equal to `(X - 1, X - 1)` at every index. -/
private def branchXSubOne : TwistRing :=
  branchConstant (Polynomial.X - 1) (Polynomial.X - 1) rfl rfl

/-- The element of `TwistRing` supported at the index `i`, where it is `(X (X - 1), 0)`. -/
private def tailSpike (i : Int) : TwistRing := by
  refine ⟨⟨(fun j => if j = i then (vanishingPoly, 0) else 0), ?_⟩, ?_⟩
  · change Filter.EventuallyConst _ Filter.cofinite
    rw [Filter.eventuallyConst_iff_exists_eventuallyEq]
    refine ⟨0, ?_⟩
    filter_upwards [Filter.eventually_cofinite_ne i] with j hj
    simp [hj]
  · intro n
    constructor
    · by_cases hn : n = i <;> simp [hn, vanishingPoly]
    · by_cases hn : n = i <;> by_cases hsucc : n + 1 = i <;>
        simp [hn, hsucc, vanishingPoly]

/-- The coordinate selector at the index `i`, multiplied by `X - 1`: the element supported at
`i`, where it is `(X - 1, X - 1)`. -/
private def dPlus (i : Int) : TwistRing := by
  refine ⟨⟨(fun j => if j = i then (Polynomial.X - 1, Polynomial.X - 1) else 0), ?_⟩, ?_⟩
  · change Filter.EventuallyConst _ Filter.cofinite
    rw [Filter.eventuallyConst_iff_exists_eventuallyEq]
    refine ⟨0, ?_⟩
    filter_upwards [Filter.eventually_cofinite_ne i] with j hj
    simp [hj]
  · intro n
    constructor
    · by_cases hn : n = i <;> simp [hn]
    · by_cases hn : n = i <;> by_cases hsucc : n + 1 = i <;> simp [hn, hsucc]

/-- The shifted coordinate selector at the index `i`, multiplied by `X`: the element whose first
component is `X` at `i` and whose second component is `X` at `i + 1`. -/
private def dMinus (i : Int) : TwistRing := by
  refine ⟨⟨(fun j => (if j = i then Polynomial.X else 0,
      if j = i + 1 then Polynomial.X else 0)), ?_⟩, ?_⟩
  · change Filter.EventuallyConst _ Filter.cofinite
    rw [Filter.eventuallyConst_iff_exists_eventuallyEq]
    refine ⟨0, ?_⟩
    filter_upwards [Filter.eventually_cofinite_ne i,
      Filter.eventually_cofinite_ne (i + 1)] with j hji hjsucc
    simp [hji, hjsucc]
  · intro n
    constructor
    · by_cases hn : n = i <;> by_cases hsucc : n = i + 1 <;> simp [hn, hsucc]
    · by_cases hn : n = i <;> simp [hn]

/-- The selector `dPlus i` becomes idempotent after dividing by `X - 1`. -/
private lemma dPlus_mul_self (i : Int) :
    dPlus i * dPlus i = branchXSubOne * dPlus i := by
  apply Subtype.ext
  apply Subtype.ext
  funext n
  ext <;> by_cases hn : n = i <;> simp [dPlus, branchXSubOne, branchConstant, hn]

/-- The selector `dMinus i` becomes idempotent after dividing by `X`. -/
private lemma dMinus_mul_self (i : Int) :
    dMinus i * dMinus i = branchX * dMinus i := by
  apply Subtype.ext
  apply Subtype.ext
  funext n
  ext <;> by_cases hn : n = i <;> by_cases hn' : n = i + 1 <;>
    simp [dMinus, branchX, branchConstant, hn, hn']

/-- The finite set of indices at which an element of the ideal has nonzero first component. -/
private def rawSupportFinset (a : TwistRing) (ha : a ∈ tailIdeal) : Finset Int :=
  (Filter.eventually_cofinite.mp
    (show ∀ᶠ n : Int in Filter.cofinite, a.1.1 n = 0 from ha)).toFinset

/-- The support of an element of the ideal, enlarged by the predecessor of each of its
indices, so that it is stable under the endpoint identification. -/
private def supportFinset (a : TwistRing) (ha : a ∈ tailIdeal) : Finset Int :=
  let s := rawSupportFinset a ha
  s ∪ s.image (fun i : Int => i - 1)

/-- Membership in the raw support is nonvanishing of the first component. -/
private lemma mem_rawSupportFinset (a : TwistRing) (ha : a ∈ tailIdeal) (i : Int) :
    i ∈ rawSupportFinset a ha ↔ a.1.1 i ≠ 0 := by
  simp [rawSupportFinset, Set.Finite.mem_toFinset]

/-- Evaluation of an element of `TwistRing` at a fixed index, as a ring homomorphism. -/
private def branchAt (n : Int) : TwistRing →+* TwistBranch where
  toFun a := a.1.1 n
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

/-- Membership in the enlarged support is nonvanishing of the first component at the index or
at its successor. -/
private lemma mem_supportFinset (a : TwistRing) (ha : a ∈ tailIdeal) (i : Int) :
    i ∈ supportFinset a ha ↔ a.1.1 i ≠ 0 ∨ a.1.1 (i + 1) ≠ 0 := by
  change i ∈ rawSupportFinset a ha ∪
      (rawSupportFinset a ha).image (fun j : Int => j - 1) ↔ _
  simp only [Finset.mem_union, Finset.mem_image, mem_rawSupportFinset]
  constructor
  · rintro (hi | ⟨j, hj, hji⟩)
    · exact Or.inl hi
    · right
      have : j = i + 1 := by omega
      simpa [this] using hj
  · rintro (hi | hi)
    · exact Or.inl hi
    · right
      refine ⟨i + 1, hi, ?_⟩
      omega

/-- On the ideal, multiplication by `X - 1` is the finite sum of the selectors `dPlus`. -/
private lemma branchXSubOne_mul_eq_sum (a : TwistRing) (ha : a ∈ tailIdeal) :
    branchXSubOne * a = ∑ i ∈ supportFinset a ha, dPlus i * a := by
  apply Subtype.ext
  apply Subtype.ext
  funext n
  by_cases hn : a.1.1 n = 0
  · change branchXSubOne.1.1 n * a.1.1 n =
      (∑ i ∈ supportFinset a ha, dPlus i * a).1.1 n
    simp [hn]
  · have hmem : n ∈ supportFinset a ha := (mem_supportFinset a ha n).2 (Or.inl hn)
    change branchAt n (branchXSubOne * a) =
      branchAt n (∑ i ∈ supportFinset a ha, dPlus i * a)
    simp only [map_sum, map_mul, branchAt]
    rw [Finset.sum_eq_single n]
    · simp [dPlus, branchXSubOne, branchConstant]
    · intro b hb hbn
      have hnb : n ≠ b := Ne.symm hbn
      simp [dPlus, hnb]
    · intro h
      exact (h hmem).elim

/-- On the ideal, multiplication by `X` is the finite sum of the selectors `dMinus`. -/
private lemma branchX_mul_eq_sum (a : TwistRing) (ha : a ∈ tailIdeal) :
    branchX * a = ∑ i ∈ supportFinset a ha, dMinus i * a := by
  apply Subtype.ext
  apply Subtype.ext
  funext n
  by_cases hn : a.1.1 n = 0
  · change branchX.1.1 n * a.1.1 n =
      (∑ i ∈ supportFinset a ha, dMinus i * a).1.1 n
    simp [hn]
  · have hmem : n ∈ supportFinset a ha := (mem_supportFinset a ha n).2 (Or.inl hn)
    have hnmem : n - 1 ∈ supportFinset a ha := by
      rw [mem_supportFinset]
      exact Or.inr (by simpa using hn)
    change branchAt n (branchX * a) =
      branchAt n (∑ i ∈ supportFinset a ha, dMinus i * a)
    simp only [map_sum, map_mul, branchAt]
    let t : Finset Int := {n, n - 1}
    have hts : t ⊆ supportFinset a ha := by
      intro b hb
      simp only [t, Finset.mem_insert, Finset.mem_singleton] at hb
      rcases hb with rfl | rfl
      · exact hmem
      · exact hnmem
    have hout : ∀ b ∈ supportFinset a ha, b ∉ t →
        (dMinus b).1.1 n * a.1.1 n = 0 := by
      intro b hb hbt
      have hbn : b ≠ n := by
        intro h
        apply hbt
        simp [t, h]
      have hbs : b + 1 ≠ n := by
        intro h
        apply hbt
        simp only [t, Finset.mem_insert, Finset.mem_singleton]
        right
        omega
      have hnb : n ≠ b := Ne.symm hbn
      have hnb' : n ≠ b + 1 := Ne.symm hbs
      simp only [dMinus, hnb, hnb']
      change (0 : TwistBranch) * a.1.1 n = 0
      exact zero_mul _
    have hsum : (∑ b ∈ t, branchAt n (dMinus b) * branchAt n a) =
        ∑ b ∈ supportFinset a ha, branchAt n (dMinus b) * branchAt n a :=
      Finset.sum_subset hts hout
    trans ∑ b ∈ t, branchAt n (dMinus b) * branchAt n a
    · have hneEq : n ≠ n - 1 := by omega
      have hne : n ∉ ({n - 1} : Finset Int) := by simpa using hneEq
      have hprev : n - 1 + 1 = n := by omega
      rw [show t = insert n {n - 1} by rfl]
      rw [Finset.sum_insert hne, Finset.sum_singleton]
      ext <;> simp [dMinus, branchX, branchConstant, branchAt, hprev, hneEq]
    · exact hsum

/-- The spike at an index lies in the ideal. -/
private lemma tailSpike_mem (i : Int) : tailSpike i ∈ tailIdeal := by
  change ∀ᶠ n : Int in Filter.cofinite, (tailSpike i).1.1 n = 0
  filter_upwards [Filter.eventually_cofinite_ne i] with n hn
  simp [tailSpike, hn]

/-- The ideal is nonzero. -/
private lemma tailIdeal_ne_bot : tailIdeal ≠ ⊥ := by
  intro h
  have hmem : tailSpike 0 ∈ tailIdeal := tailSpike_mem 0
  rw [h] at hmem
  have hz : tailSpike 0 = 0 := hmem
  have heval := congrArg (fun a : TwistRing => Polynomial.eval 2 (a.1.1 0).1) hz
  change Polynomial.eval 2 vanishingPoly = Polynomial.eval 2 0 at heval
  have he : (2 : TwistCoeff) = 0 := by
    norm_num [vanishingPoly] at heval
    exact heval
  have hzero : (2 : ZMod 3) = 0 := congrArg ULift.down he
  exact (by decide : (2 : ZMod 3) ≠ 0) hzero

/-- An idempotent polynomial over a reduced ring is `0` or `1`. -/
private lemma polynomial_idempotent_eq_zero_or_one {p : Polynomial TwistCoeff}
    (hp : p * p = p) : p = 0 ∨ p = 1 := by
  apply eq_zero_or_one_of_sq_eq_self
  simpa [pow_two] using hp

/-- Two polynomials each equal to `0` or `1` and agreeing at one point are equal. -/
private lemma polynomial_idempotents_eq_of_eval {p q : Polynomial TwistCoeff}
    (hp : p = 0 ∨ p = 1) (hq : q = 0 ∨ q = 1) (x : TwistCoeff)
    (h : Polynomial.eval x p = Polynomial.eval x q) : p = q := by
  rcases hp with hp | hp <;> rcases hq with hq | hq <;>
    subst p <;> subst q <;> simp_all

/-- Both components of each coordinate of an idempotent are `0` or `1`. -/
private lemma idem_components_eq_zero_or_one (a : TwistRing) (ha : IsIdempotentElem a) (i : Int) :
    ((a.1.1 i).1 = 0 ∨ (a.1.1 i).1 = 1) ∧ ((a.1.1 i).2 = 0 ∨ (a.1.1 i).2 = 1) := by
  have h := congrArg (fun z : TwistRing => z.1.1 i) ha.eq
  exact ⟨polynomial_idempotent_eq_zero_or_one (by simpa using congrArg Prod.fst h),
    polynomial_idempotent_eq_zero_or_one (by simpa using congrArg Prod.snd h)⟩

/-- An idempotent of the ideal vanishes: a nonzero coordinate would be propagated to every
larger index by the identification at `1`. -/
private lemma idempotent_in_tailIdeal_eq_zero {a : TwistRing} (ha : a ∈ tailIdeal)
    (hid : IsIdempotentElem a) : a = 0 := by
  let s := rawSupportFinset a ha
  have hempty : ¬ s.Nonempty := by
    intro hne
    let m := s.max' hne
    have hm : m ∈ s := Finset.max'_mem _ _
    have hnext : m + 1 ∉ s := by
      intro hnext
      have hle := Finset.le_max' s _ hnext
      omega
    have hbranch : a.1.1 m ≠ 0 := (mem_rawSupportFinset a ha m).1 hm
    have hc := idem_components_eq_zero_or_one a hid
    have hp0 : (a.1.1 m).1 = (a.1.1 m).2 :=
      polynomial_idempotents_eq_of_eval (hc m).1 (hc m).2 0 ((a.2 m).1)
    have hstep : (a.1.1 m).1 = (a.1.1 (m + 1)).2 :=
      polynomial_idempotents_eq_of_eval (hc m).1 (hc (m + 1)).2 1 ((a.2 m).2)
    have hpnext : (a.1.1 (m + 1)).1 = (a.1.1 (m + 1)).2 :=
      polynomial_idempotents_eq_of_eval (hc (m + 1)).1 (hc (m + 1)).2 0 ((a.2 (m + 1)).1)
    have hpone : (a.1.1 m).1 = 1 := (hc m).1.resolve_left fun hp =>
      hbranch (by ext <;> simp [hp, hp0.symm.trans hp])
    have hnextbranch : a.1.1 (m + 1) ≠ 0 := by
      intro hz
      have : (a.1.1 (m + 1)).1 = 0 := by simp [hz]
      rw [hpnext, ← hstep, hpone] at this
      exact one_ne_zero this
    exact hnext (mem_rawSupportFinset a ha (m + 1) |>.2 hnextbranch)
  exact Subtype.ext (Subtype.ext (funext fun i =>
    not_not.mp fun hi => hempty ⟨i, (mem_rawSupportFinset a ha i).2 hi⟩))

/-- The selector `dPlus i` lies in the ideal. -/
private lemma dPlus_mem (i : Int) : dPlus i ∈ tailIdeal := by
  change ∀ᶠ n : Int in Filter.cofinite, (dPlus i).1.1 n = 0
  filter_upwards [Filter.eventually_cofinite_ne i] with n hn
  simp [dPlus, hn]

/-- The selector `dMinus i` lies in the ideal. -/
private lemma dMinus_mem (i : Int) : dMinus i ∈ tailIdeal := by
  change ∀ᶠ n : Int in Filter.cofinite, (dMinus i).1.1 n = 0
  filter_upwards [Filter.eventually_cofinite_ne i,
    Filter.eventually_cofinite_ne (i + 1)] with n hni hnnext
  simp [dMinus, hni, hnnext]

/-- The inverse of `f` in the localization away from `f`. -/
private def awayInv (f : TwistRing) : Localization.Away f :=
  let h : IsUnit (algebraMap TwistRing (Localization.Away f) f) :=
    IsLocalization.Away.algebraMap_isUnit f
  ((h.unit⁻¹ : (Localization.Away f)ˣ) : Localization.Away f)

/-- In the localization away from `f`, the image of `f` and `awayInv f` are inverse. -/
private lemma away_map_mul_inv (f : TwistRing) :
    algebraMap TwistRing (Localization.Away f) f * awayInv f = 1 := by
  let h : IsUnit (algebraMap TwistRing (Localization.Away f) f) :=
    IsLocalization.Away.algebraMap_isUnit f
  change (↑h.unit : Localization.Away f) *
      (↑(h.unit⁻¹ : (Localization.Away f)ˣ) : Localization.Away f) = 1
  exact Units.val_inv h.unit

/-- If `d * d = f * d` then `d / f` is idempotent in the localization away from `f`. -/
private lemma localizedIdem_isIdempotent (f d : TwistRing) (hd : d * d = f * d) :
    IsIdempotentElem (algebraMap TwistRing (Localization.Away f) d * awayInv f) := by
  let φ := algebraMap TwistRing (Localization.Away f)
  let u := φ f
  let v := awayInv f
  have huv : u * v = 1 := away_map_mul_inv f
  change (φ d * v) * (φ d * v) = φ d * v
  calc
    (φ d * v) * (φ d * v) = φ (d * d) * (v * v) := by rw [map_mul]; ring
    _ = φ (f * d) * (v * v) := by rw [hd]
    _ = (u * φ d) * (v * v) := by rw [map_mul]
    _ = φ d * v := by rw [show (u * φ d) * (v * v) =
        φ d * v * (u * v) by ring, huv, mul_one]

/-- If multiplication by `f` on the ideal is the finite sum of a family `d` of elements of the
ideal, then after localizing away from `f` the ideal is generated by the quotients `d i / f`. -/
private lemma localized_map_eq_span (f : TwistRing) (d : Int → TwistRing)
    (hd : ∀ i, d i ∈ tailIdeal)
    (hsum : ∀ (a : TwistRing) (ha : a ∈ tailIdeal),
      f * a = ∑ i ∈ supportFinset a ha, d i * a) :
    Ideal.map (algebraMap TwistRing (Localization.Away f)) tailIdeal =
      Ideal.span (Set.range fun i =>
        algebraMap TwistRing (Localization.Away f) (d i) * awayInv f) := by
  let φ := algebraMap TwistRing (Localization.Away f)
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    let s := supportFinset a ha
    have hmap : φ (f * a) = ∑ i ∈ s, φ (d i * a) := by
      simpa only [map_sum, map_mul] using congrArg φ (hsum a ha)
    let v := awayInv f
    have hrel : φ a = ∑ i ∈ s, (φ (d i) * v) * φ a := by
      calc
        φ a = 1 * φ a := by simp
        _ = (φ f * v) * φ a := by rw [← away_map_mul_inv]
        _ = v * (φ f * φ a) := by ring
        _ = v * φ (f * a) := by rw [map_mul]
        _ = v * (∑ i ∈ s, φ (d i * a)) := by rw [hmap]
        _ = ∑ i ∈ s, (φ (d i) * v) * φ a := by
          simp only [map_mul, Finset.mul_sum]
          exact Finset.sum_congr rfl fun _ _ => by ring
    change φ a ∈ Ideal.span (Set.range fun i => φ (d i) * v)
    rw [hrel]
    exact Submodule.sum_mem _ fun i _ => Ideal.mul_mem_right
      (I := Ideal.span (Set.range fun i => φ (d i) * v)) (b := φ a) (Ideal.subset_span ⟨i, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro e ⟨i, rfl⟩
    change (φ (d i) * awayInv f) ∈ Ideal.map φ tailIdeal
    exact Ideal.mul_mem_right (I := Ideal.map φ tailIdeal)
      (b := awayInv f) (Ideal.mem_map_of_mem φ (hd i))

/-- If `d i * d i = f * d i` and multiplication by `f` on the ideal is the finite sum of the
`d i`, then away from `f` the ideal is generated by the idempotents `d i / f`. -/
private lemma exists_idempotent_span_away (f : TwistRing) (d : Int → TwistRing)
    (hd : ∀ i, d i ∈ tailIdeal) (hmul : ∀ i, d i * d i = f * d i)
    (hsum : ∀ (a : TwistRing) (ha : a ∈ tailIdeal),
      f * a = ∑ i ∈ supportFinset a ha, d i * a) :
    ∃ s : Set (Localization.Away f), (∀ e ∈ s, IsIdempotentElem e) ∧
      Ideal.map (algebraMap TwistRing (Localization.Away f)) tailIdeal = Ideal.span s :=
  ⟨_, by
    rintro _ ⟨i, rfl⟩
    exact localizedIdem_isIdempotent f (d i) (hmul i), localized_map_eq_span f d hd hsum⟩

/-- The two constants `X` and `X - 1` differ by the unit `1`. -/
private lemma branchX_sub_branchXSubOne :
    branchX - branchXSubOne = (1 : TwistRing) := by
  apply Subtype.ext
  apply Subtype.ext
  funext n
  ext <;> simp [branchX, branchXSubOne, branchConstant]

/-- Every prime of the ring avoids `X` or avoids `X - 1`, so the two principal opens they
define cover the spectrum. -/
private lemma prime_misses_branchX_or_branchXSubOne (p : PrimeSpectrum TwistRing) :
    branchX ∉ p.asIdeal ∨ branchXSubOne ∉ p.asIdeal := by
  by_cases hx : branchX ∈ p.asIdeal
  · right
    intro hxsub
    have hone : (1 : TwistRing) ∈ p.asIdeal := by
      rw [← branchX_sub_branchXSubOne]
      exact Ideal.sub_mem _ hx hxsub
    have htop : p.asIdeal = ⊤ := (Ideal.eq_top_iff_one p.asIdeal).2 hone
    exact p.isPrime.ne_top htop
  · exact Or.inl hx

/-- **Stacks 04QL.** A closed subscheme of an affine scheme can be locally, but not globally,
cut out by ideals generated by idempotents. -/
@[stacks 04QL]
theorem exists_ideal_locally_span_idempotents_not_globally :
    ∃ (R : Type u) (_ : CommRing R) (I : Ideal R),
      (∀ p : PrimeSpectrum R,
        ∃ f : R, f ∉ p.asIdeal ∧
          ∃ s : Set (Localization.Away f),
            (∀ e ∈ s, IsIdempotentElem e) ∧
              Ideal.map (algebraMap R (Localization.Away f)) I = Ideal.span s) ∧
      ¬ ∃ s : Set R, (∀ e ∈ s, IsIdempotentElem e) ∧ I = Ideal.span s := by
  refine ⟨TwistRing, inferInstance, tailIdeal, ?_, ?_⟩
  · intro p
    rcases prime_misses_branchX_or_branchXSubOne p with hx | hx
    · exact ⟨branchX, hx, exists_idempotent_span_away branchX dMinus dMinus_mem
        dMinus_mul_self branchX_mul_eq_sum⟩
    · exact ⟨branchXSubOne, hx, exists_idempotent_span_away branchXSubOne dPlus dPlus_mem
        dPlus_mul_self branchXSubOne_mul_eq_sum⟩
  · rintro ⟨s, hs, hI⟩
    have hspan : Ideal.span s = ⊥ := by
      apply le_antisymm
      · apply Ideal.span_le.mpr
        intro e he
        have heI : e ∈ tailIdeal := by
          rw [hI]
          exact Ideal.subset_span he
        exact idempotent_in_tailIdeal_eq_zero heI (hs e he)
      · exact bot_le
    apply tailIdeal_ne_bot
    calc
      tailIdeal = Ideal.span s := hI
      _ = ⊥ := hspan

end

end Stacks.Examples
