/-!
# A local-ring-preserving map that is not ind-étale

There is a map of commutative rings that identifies every local ring of its target with the
corresponding local ring of its source, but is neither ind-étale nor ind-Zariski.

The counterexample is the diagonal map `R → R ×_{R/I} R` for an ideal `I ⊆ R` that is locally
but not globally generated by idempotents. Local generation forces every `x ∈ I` to satisfy
`x = x y` for some `y ∈ I`, which makes the two projections of the pullback behave like
localizations at each prime and hence makes the diagonal identify local rings. Conversely, a
retraction of an ind-étale algebra has kernel generated by idempotents; pushing that kernel
forward along a projection of the pullback would exhibit `I` as generated by idempotents.

## Main results

* `Stacks.Examples.exists_identifiesLocalRings_not_indEtale`: the counterexample.

## Implementation notes

The three properties are stated for the same map. Ind-étaleness is the universe-polymorphic
predicate `StacksDraft.IndEtale`, so that the base and the algebra may live in independent
universes; ind-Zariskiness carries in addition an independent indexing universe. The source and
target are wrapped in `ULift` so that they can be produced in any pair of universes.

## References

* [Stacks Project, Tag 09AP](https://stacks.math.columbia.edu/tag/09AP)
-/

@[expose] public section


namespace Stacks.Examples

open CategoryTheory

universe u v w

/-- If an `A`-algebra `B` with a retraction `p` to `A` is a filtered union of étale
subalgebras, then the kernel of `p` is generated by idempotents. Each element of the kernel
comes from an étale `A`-algebra `E`; the induced retraction `E → A` is étale and surjective,
so its kernel is generated by a single idempotent, whose image in `B` divides the element. -/
private theorem idempotents_generate_kernel_of_etale_retraction
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (p : B →+* A) (hp : p.comp (algebraMap A B) = RingHom.id A)
    (h : ∀ b : B, ∃ (E : Type w) (_ : CommRing E) (_ : Algebra A E),
      Algebra.Etale A E ∧ ∃ (k : E →ₐ[A] B) (c : E), k c = b) :
    ∃ s : Set B, (∀ z ∈ s, IsIdempotentElem z ∧ p z = 0) ∧
      RingHom.ker p = Ideal.span s := by
  classical
  let s : Set B := {z | IsIdempotentElem z ∧ p z = 0}
  refine ⟨s, fun _ hz => hz, ?_⟩
  refine le_antisymm (fun b hb => ?_) (Ideal.span_le.mpr fun z hz => RingHom.mem_ker.mpr hz.2)
  obtain ⟨E, _, _, hEt, k, c, hkc⟩ := h b
  let pE : E →+* A := p.comp k.toRingHom
  have hpE : (pE.comp (algebraMap A E)) = RingHom.id A := by
    ext a
    change p (k (algebraMap A E a)) = a
    rw [k.commutes]
    exact RingHom.congr_fun hp a
  have hEtpE : pE.Etale :=
    RingHom.Etale.of_comp
      (RingHom.Etale.formallyUnramified _ (RingHom.etale_algebraMap.mpr hEt))
      (RingHom.FiniteType.of_finitePresentation
        (RingHom.finitePresentation_algebraMap.mpr hEt.finitePresentation))
      (hpE ▸ RingHom.Etale.of_bijective Function.bijective_id)
  let : Algebra E A := pE.toAlgebra
  have : Algebra.Etale E A := RingHom.etale_algebraMap.mp hEtpE
  have hsurj : Function.Surjective (algebraMap E A) := fun a =>
    ⟨algebraMap A E a, RingHom.congr_fun hpE a⟩
  obtain ⟨e, he, hker, _⟩ :=
    Algebra.exists_isIdempotentElem_isLocalizationAway_of_surjective E A hsurj
  let z : B := k (1 - e)
  have hzid : IsIdempotentElem z := he.one_sub.map k.toRingHom
  have hzp : p z = 0 := by
    have hmem : 1 - e ∈ RingHom.ker pE := by
      rw [show RingHom.ker pE = Ideal.span ({1 - e} : Set E) from hker]
      exact Ideal.mem_span_singleton_self _
    exact RingHom.mem_ker.mp hmem
  have hgker : c ∈ RingHom.ker pE :=
    RingHom.mem_ker.mpr (show p (k c) = 0 from hkc ▸ RingHom.mem_ker.mp hb)
  obtain ⟨d, hc⟩ := Ideal.mem_span_singleton.mp (hker ▸ hgker)
  rw [← hkc, hc, map_mul]
  change z * k d ∈ Ideal.span s
  exact Ideal.mul_mem_right (k d) (Ideal.span s) (Ideal.subset_span ⟨hzid, hzp⟩)

/-- If the ideal `I ⊆ R` is not generated by idempotents, then the pullback `R ×_{R/I} R` is
not a filtered union of étale `R`-subalgebras: the kernel of one projection would be generated
by idempotents, and the other projection would carry those idempotents to generators of `I`. -/
private theorem not_forall_exists_etale_factorization_pullback
    {R : Type u} [CommRing R] (I : Ideal R)
    (q : R →ₐ[R] R ⧸ I)
    (hnot : ¬ ∃ s : Set R, (∀ e ∈ s, IsIdempotentElem e) ∧ I = Ideal.span s) :
    ¬ (∀ b : AlgHom.pullback q q,
      ∃ (E : Type w) (_ : CommRing E) (_ : Algebra R E),
        Algebra.Etale R E ∧ ∃ (k : E →ₐ[R] AlgHom.pullback q q) (c : E), k c = b) := by
  intro hi
  let B := AlgHom.pullback q q
  let p₁ : B →+* R := (AlgHom.pullbackSnd q q).toRingHom
  let p₂ : B →+* R := (AlgHom.pullbackFst q q).toRingHom
  have hp : p₂.comp (algebraMap R B) = RingHom.id R := by
    ext r
    rfl
  obtain ⟨s, hs, hker⟩ := idempotents_generate_kernel_of_etale_retraction p₂ hp hi
  have hmapker : Ideal.map p₁ (RingHom.ker p₂) = RingHom.ker q.toRingHom :=
    RingHom.map_pullbackSnd_ker_pullbackFst_eq q.toRingHom q.toRingHom
  have hspan : RingHom.ker q.toRingHom = Ideal.span (p₁ '' s) := by
    rw [← hmapker, hker, Ideal.map_span]
  refine hnot ⟨p₁ '' s, ?_, ?_⟩
  · rintro e ⟨z, hz, rfl⟩
    exact (hs z hz).1.map p₁
  · have hkerq : RingHom.ker q.toRingHom = I := by
      ext r
      rw [RingHom.mem_ker, show q.toRingHom r = Ideal.Quotient.mk I r from q.commutes r]
      exact Ideal.Quotient.eq_zero_iff_mem
    rwa [← hkerq]

/-- An element of an ideal generated by idempotents is a multiple of itself by an element of
that ideal. -/
private lemma exists_eq_mul_of_mem_span_idempotents {R : Type*} [CommRing R]
    {s : Set R} (hs : ∀ e ∈ s, IsIdempotentElem e) {x : R} (hx : x ∈ Ideal.span s) :
    ∃ y ∈ Ideal.span s, x = x * y := by
  induction hx using Submodule.span_induction with
  | mem e he => exact ⟨e, Ideal.subset_span he, (hs e he).symm⟩
  | zero => exact ⟨0, Ideal.zero_mem _, by simp⟩
  | add x z hx hz ihx ihz =>
    obtain ⟨a, ha, hxa⟩ := ihx
    obtain ⟨b, hb, hzb⟩ := ihz
    refine ⟨a + b - a * b, Ideal.sub_mem _ (Ideal.add_mem _ ha hb)
      (Ideal.mul_mem_left _ a hb), ?_⟩
    linear_combination (1 - b) * hxa + (1 - a) * hzb
  | smul a x hx ih =>
    obtain ⟨b, hb, hxb⟩ := ih
    exact ⟨b, hb, by simpa [smul_eq_mul, mul_assoc] using congrArg (a * ·) hxb⟩

/-- An ideal that is generated by idempotents on a Zariski open neighbourhood of every point is
pure: each of its elements is a multiple of itself by an element of the ideal. -/
private lemma exists_eq_mul_of_locally_span_idempotents {R : Type*} [CommRing R]
    (I : Ideal R)
    (hloc : ∀ p : PrimeSpectrum R, ∃ f : R, f ∉ p.asIdeal ∧
      ∃ s : Set (Localization.Away f), (∀ e ∈ s, IsIdempotentElem e) ∧
        Ideal.map (algebraMap R (Localization.Away f)) I = Ideal.span s)
    {x : R} (hx : x ∈ I) : ∃ y ∈ I, x = x * y := by
  suffices hx' : x ∈ I * Ideal.span {x} by
    obtain ⟨y, hy, hxy⟩ := Ideal.mem_mul_span_singleton.mp hx'
    exact ⟨y, hy, by simpa [mul_comm] using hxy.symm⟩
  apply Ideal.mem_of_localization_maximal
  intro p hp
  obtain ⟨f, hfp, s, hs, hI⟩ := hloc ⟨p, hp.isPrime⟩
  let φ : Localization.Away f →+* Localization.AtPrime p :=
    IsLocalization.Away.lift f
      (IsLocalization.map_units (M := p.primeCompl) (Localization.AtPrime p) ⟨f, hfp⟩)
  have hφ : φ.comp (algebraMap R (Localization.Away f)) =
      algebraMap R (Localization.AtPrime p) := by
    ext r
    simp [φ]
  have hxloc : algebraMap R (Localization.Away f) x ∈ Ideal.span s :=
    hI ▸ Ideal.mem_map_of_mem _ hx
  obtain ⟨y, hy, hxy⟩ := exists_eq_mul_of_mem_span_idempotents hs hxloc
  have hxmul : algebraMap R (Localization.Away f) x ∈
      Ideal.map (algebraMap R (Localization.Away f)) (I * Ideal.span {x}) := by
    rw [Ideal.map_mul, Ideal.map_span, Set.image_singleton]
    exact Ideal.mem_mul_span_singleton.mpr ⟨y, hI.symm ▸ hy, by simpa [mul_comm] using hxy.symm⟩
  simpa only [Ideal.map_map, hφ, ← RingHom.comp_apply] using Ideal.mem_map_of_mem φ hxmul

/-- A ring map with a retraction whose kernel is pure induces an isomorphism on the local ring
at every prime containing that kernel. -/
private lemma localRingHom_bijective_of_pure_retraction
    {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (g : S →+* R)
    (hgf : g.comp f = RingHom.id R)
    (hpure : ∀ x ∈ RingHom.ker g, ∃ y ∈ RingHom.ker g, x = x * y)
    (q : Ideal S) [q.IsPrime] (hker : RingHom.ker g ≤ q) :
    Function.Bijective (Localization.localRingHom (q.comap f) q f rfl) := by
  let p := q.comap f
  have hd (x : S) : x - f (g x) ∈ RingHom.ker g := by
    simp only [RingHom.mem_ker, map_sub]
    simpa using sub_eq_zero.mpr (RingHom.congr_fun hgf (g x)).symm
  have hqp : q = p.comap g := by
    ext x
    change x ∈ q ↔ f (g x) ∈ q
    exact ⟨fun hx => by simpa using q.sub_mem hx (hker (hd x)),
      fun hx => by simpa using q.add_mem (hker (hd x)) hx⟩
  let F := Localization.localRingHom p q f rfl
  let G := Localization.localRingHom q p g hqp
  have hGF : G.comp F = RingHom.id _ := by
    apply IsLocalization.ringHom_ext p.primeCompl
    ext r
    change G (F (algebraMap R (Localization.AtPrime p) r)) = _
    simp only [F, G, Localization.localRingHom_to_map]
    exact congrArg (algebraMap R (Localization.AtPrime p)) (RingHom.congr_fun hgf r)
  have hFG : F.comp G = RingHom.id _ := by
    apply IsLocalization.ringHom_ext q.primeCompl
    ext x
    change F (G (algebraMap S (Localization.AtPrime q) x)) = _
    simp only [F, G, Localization.localRingHom_to_map]
    obtain ⟨y, hy, hxy⟩ := hpure _ (hd x)
    have hyq : 1 - y ∉ q := fun H => q.one_notMem (by simpa using q.add_mem H (hker hy))
    have hz' : algebraMap S (Localization.AtPrime q) (x - f (g x)) = 0 :=
      (IsLocalization.map_eq_zero_iff q.primeCompl _ _).mpr
        ⟨⟨1 - y, hyq⟩, by linear_combination hxy⟩
    exact (sub_eq_zero.mp (by
      simpa only [map_sub, RingHom.comp_apply, RingHom.id_apply] using hz')).symm
  exact ⟨Function.LeftInverse.injective (g := G) (RingHom.congr_fun hGF),
    Function.RightInverse.surjective (g := G) (RingHom.congr_fun hFG)⟩

/-- For a pure ideal `I ⊆ R`, the diagonal `R → R ×_{R/I} R` identifies local rings: every
prime of the pullback contains the kernel of one of the two projections, and that projection is
a retraction with pure kernel. -/
private lemma identifiesLocalRings_pullback {R : Type*} [CommRing R] (I : Ideal R)
    (hpure : ∀ x ∈ I, ∃ y ∈ I, x = x * y) :
    Algebra.IdentifiesLocalRings R
      (AlgHom.pullback (Ideal.Quotient.mkₐ R I) (Ideal.Quotient.mkₐ R I)) := by
  let q := Ideal.Quotient.mkₐ R I
  let B := AlgHom.pullback q q
  let f := algebraMap R B
  let g₁ : B →+* R := (AlgHom.pullbackFst q q).toRingHom
  let g₂ : B →+* R := (AlgHom.pullbackSnd q q).toRingHom
  have key : ∀ a b : R, q a = q b → a = 0 → ∃ y, q 0 = q y ∧ b = b * y := by
    rintro a b h rfl
    obtain ⟨y, hy, hby⟩ := hpure b (Ideal.Quotient.eq_zero_iff_mem.mp (h.symm.trans (map_zero q)))
    exact ⟨y, (map_zero q).trans (Ideal.Quotient.eq_zero_iff_mem.mpr hy).symm, hby⟩
  have hp₁ : ∀ x ∈ RingHom.ker g₁, ∃ y ∈ RingHom.ker g₁, x = x * y := by
    intro x hx
    have hx₁ : x.val.1 = 0 := hx
    obtain ⟨y, hy, hxy⟩ := key _ _ x.property hx₁
    exact ⟨⟨(0, y), hy⟩, rfl, Subtype.ext (Prod.ext (by simp [hx₁]) hxy)⟩
  have hp₂ : ∀ x ∈ RingHom.ker g₂, ∃ y ∈ RingHom.ker g₂, x = x * y := by
    intro x hx
    have hx₂ : x.val.2 = 0 := hx
    obtain ⟨y, hy, hxy⟩ := key _ _ x.property.symm hx₂
    exact ⟨⟨(y, 0), hy.symm⟩, rfl, Subtype.ext (Prod.ext hxy (by simp [hx₂]))⟩
  intro Q hQ
  by_cases h₁ : RingHom.ker g₁ ≤ Q
  · exact localRingHom_bijective_of_pure_retraction f g₁ (by ext; rfl) hp₁ Q h₁
  · have h₂ : RingHom.ker g₂ ≤ Q := by
      obtain ⟨x, hx, hxQ⟩ := IsConcreteLE.not_le_iff_exists.mp h₁
      intro y hy
      have hxy : x * y = 0 := Subtype.ext <| Prod.ext
        (mul_eq_zero_of_left (show x.val.1 = 0 from hx) _)
        (mul_eq_zero_of_right _ (show y.val.2 = 0 from hy))
      exact (hQ.mem_or_mem (hxy ▸ Q.zero_mem)).resolve_left hxQ
    exact localRingHom_bijective_of_pure_retraction f g₂ (by ext; rfl) hp₂ Q h₂

/-- Identifying local rings transports along a commuting square of ring equivalences. -/
private lemma identifiesLocalRings_of_equiv
    {A B A' B' : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [CommRing A'] [CommRing B'] [Algebra A' B']
    (eA : A ≃+* A') (eB : B ≃+* B')
    (he : ∀ a, eB (algebraMap A B a) = algebraMap A' B' (eA a))
    (h : Algebra.IdentifiesLocalRings A B) :
    Algebra.IdentifiesLocalRings A' B' := by
  intro q' hq'
  let q := q'.comap eB.toRingHom
  let p := q.comap (algebraMap A B)
  let p' := q'.comap (algebraMap A' B')
  have hp : p = p'.comap eA.toRingHom := by
    ext a
    change eB (algebraMap A B a) ∈ q' ↔ algebraMap A' B' (eA a) ∈ q'
    rw [he]
  let lA := Localization.localRingEquiv p p' eA hp
  let lB := Localization.localRingEquiv q q' eB rfl
  let F := Localization.localRingHom p q (algebraMap A B) rfl
  let F' := Localization.localRingHom p' q' (algebraMap A' B') rfl
  have H : lB.toRingHom.comp F = F'.comp lA.toRingHom := by
    apply IsLocalization.ringHom_ext p.primeCompl
    ext a
    change Localization.localRingHom q q' eB.toRingHom rfl
      (F (algebraMap A (Localization.AtPrime p) a)) =
      F' (Localization.localRingHom p p' eA.toRingHom hp
        (algebraMap A (Localization.AtPrime p) a))
    simp only [F, F', Localization.localRingHom_to_map]
    exact congrArg (algebraMap B' (Localization.AtPrime q')) (he a)
  have hb : Function.Bijective F := h q
  refine ⟨fun x y hxy => ?_, fun y => ?_⟩
  · obtain ⟨x, rfl⟩ := lA.surjective x
    obtain ⟨y, rfl⟩ := lA.surjective y
    exact congrArg lA (hb.1 (lB.injective
      ((RingHom.congr_fun H x).trans (hxy.trans (RingHom.congr_fun H y).symm))))
  · obtain ⟨z, hz⟩ := hb.2 (lB.symm y)
    exact ⟨lA z, (RingHom.congr_fun H z).symm.trans
      (show lB (F z) = y by rw [hz, lB.apply_symm_apply])⟩

/-- Every element of the colimit of a filtered diagram of algebras comes from one of its
terms. -/
private theorem exists_eq_app_of_colimitPresentation
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [Algebra A B] {J : Type*} [Category* J] [IsFiltered J]
    (pres : Limits.ColimitPresentation J (CommAlgCat.of A B)) (b : B) :
    ∃ i x, (pres.ι.app i).hom x = b := by
  classical
  let φ (i : J) : pres.diag.obj i →ₐ[A] B := (pres.ι.app i).hom
  let D : Subalgebra A B := {
    carrier := {y | ∃ i : J, ∃ x : pres.diag.obj i, φ i x = y}
    add_mem' := by
      intro x y hx hy
      obtain ⟨i, xi, rfl⟩ := hx
      obtain ⟨j, yj, rfl⟩ := hy
      obtain ⟨k, f, g, _⟩ := IsFilteredOrEmpty.cocone_objs i j
      refine ⟨k, (pres.diag.map f).hom xi + (pres.diag.map g).hom yj, ?_⟩
      simp [φ]
    mul_mem' := by
      intro x y hx hy
      obtain ⟨i, xi, rfl⟩ := hx
      obtain ⟨j, yj, rfl⟩ := hy
      obtain ⟨k, f, g, _⟩ := IsFilteredOrEmpty.cocone_objs i j
      refine ⟨k, (pres.diag.map f).hom xi * (pres.diag.map g).hom yj, ?_⟩
      simp [φ]
    algebraMap_mem' := by
      intro a
      let i : J := Classical.choice (IsFiltered.nonempty (C := J))
      change ∃ i : J, ∃ x : pres.diag.obj i, φ i x = algebraMap A B a
      exact ⟨i, algebraMap A (pres.diag.obj i) a, (φ i).commutes a⟩ }
  let coc : CategoryTheory.Limits.Cocone pres.diag := {
    pt := CommAlgCat.of A D
    ι := {
      app := fun i => CommAlgCat.ofHom ((φ i).codRestrict D (fun x => ⟨i, x, rfl⟩))
      naturality := by
        intro i j f
        apply CommAlgCat.hom_ext
        ext x
        exact Subtype.ext (congrArg (fun h => h x) (pres.ι.naturality f))
    }
  }
  let desc := pres.isColimit.desc coc
  have hcat : CommAlgCat.ofHom (D.val.comp desc.hom) =
      CommAlgCat.ofHom (AlgHom.id A B) := by
    apply pres.isColimit.hom_ext
    intro i
    apply CommAlgCat.hom_ext
    ext x
    change D.val (desc.hom (φ i x)) = φ i x
    have hfac' : desc.hom (φ i x) = (φ i).codRestrict D (fun x => ⟨i, x, rfl⟩) x := by
      simpa [desc, coc] using congrArg (fun h => h x) (pres.isColimit.fac coc i)
    rw [hfac']
    exact AlgHom.coe_codRestrict (φ i) D (fun x => ⟨i, x, rfl⟩) x
  have hdesc : D.val.comp desc.hom = AlgHom.id A B :=
    AlgHom.ext fun x => congrArg (fun h => h x) (congrArg CommAlgCat.Hom.hom hcat)
  have hb : (desc b).val = b := by
    simpa [AlgHom.comp_apply] using congrArg (fun f : B →ₐ[A] B => f b) hdesc
  obtain ⟨i, x, hx⟩ := (desc b).property
  exact ⟨i, x, hx.trans hb⟩

/-- A local isomorphism of algebras in one universe is étale, since it is étale on a standard
open cover of the target. -/
private theorem etale_of_isLocalIso_sameUniverse
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (h : Algebra.IsLocalIso R S) : Algebra.Etale R S := by
  apply RingHom.etale_algebraMap.mp
  apply RingHom.Etale.ofLocalizationSpanTarget (algebraMap R S)
    {g : S | Algebra.IsStandardOpenImmersion R (Localization.Away g)}
    (Algebra.IsLocalIso.span_isStandardOpenImmersion_eq_top R S)
  rintro ⟨g, hg⟩
  have : Algebra.IsStandardOpenImmersion R (Localization.Away g) := hg
  obtain ⟨r, hr⟩ := Algebra.IsStandardOpenImmersion.exists_away R (Localization.Away g)
  have : IsLocalization.Away r (Localization.Away g) := hr
  have hEt : Algebra.Etale R (Localization.Away g) := Algebra.Etale.of_isLocalizationAway r
  simpa only [← IsScalarTower.algebraMap_eq R S (Localization.Away g)] using
    RingHom.etale_algebraMap.mpr hEt

/-- A local isomorphism of algebras is étale, with the base and the algebra in independent
universes. -/
private lemma etale_of_isLocalIso {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsLocalIso R S] :
    Algebra.Etale R S := by
  let R' := ULift.{v} R
  let S' := ULift.{u} S
  let eR : R' ≃+* R := ULift.ringEquiv
  let eS : S' ≃+* S := ULift.ringEquiv
  let : Algebra R' R := ULift.algebra' R R
  let : Algebra R' S' := ULift.algebra' R S'
  have : IsScalarTower R' R S' :=
    ⟨fun r a s => ULift.ext (smul_assoc r.down a s.down)⟩
  have : Algebra.IsStandardOpenImmersion R' R :=
    Algebra.IsStandardOpenImmersion.of_bijective eR.bijective
  have : Algebra.IsLocalIso R S' := Algebra.IsLocalIso.of_algEquiv ULift.algEquiv.symm
  have : Algebra.IsLocalIso R' S' := Algebra.IsLocalIso.trans R' R S'
  exact RingHom.etale_algebraMap.mp (StacksDraft.etale_comp _ eS.toRingHom
    (StacksDraft.etale_comp eR.symm.toRingHom (algebraMap R' S')
      (RingHom.Etale.of_bijective eR.symm.bijective)
      (RingHom.etale_algebraMap.mpr (etale_of_isLocalIso_sameUniverse R' S' inferInstance)))
    (RingHom.Etale.of_bijective eS.bijective))

/-- Every element of an ind-Zariski algebra lies in the image of an étale subalgebra. -/
private lemma etale_elements_of_isIndZariski
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (h : AlgebraicGeometry.ProEtale.IsIndZariski.{u, v, w} A B) (b : B) :
    ∃ (E : Type (max u v)) (_ : CommRing E) (_ : Algebra A E),
      Algebra.Etale A E ∧ ∃ (k : E →ₐ[A] B) (c : E), k c = b := by
  obtain ⟨J, _, _, pres, hp⟩ := h
  obtain ⟨j, c, hc⟩ := exists_eq_app_of_colimitPresentation pres (ULift.up b)
  have := hp j
  exact ⟨pres.diag.obj j, inferInstance, inferInstance, etale_of_isLocalIso,
    ULift.algEquiv.toAlgHom.comp (pres.ι.app j).hom, c, congrArg ULift.down hc⟩

/-- Factoring every element through an étale subalgebra transports along a commuting square of
ring equivalences. -/
private lemma etale_elements_of_equiv
    {A B A' B' : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [CommRing A'] [CommRing B'] [Algebra A' B']
    (eA : A ≃+* A') (eB : B ≃+* B')
    (he : ∀ a, eB (algebraMap A B a) = algebraMap A' B' (eA a))
    (h : ∀ b : B, ∃ (E : Type w) (_ : CommRing E) (_ : Algebra A E),
      Algebra.Etale A E ∧ ∃ (k : E →ₐ[A] B) (c : E), k c = b) :
    ∀ b : B', ∃ (E : Type w) (_ : CommRing E) (_ : Algebra A' E),
      Algebra.Etale A' E ∧ ∃ (k : E →ₐ[A'] B') (c : E), k c = b := by
  intro b
  obtain ⟨E, _, _, hE, k, c, hc⟩ := h (eB.symm b)
  let : Algebra A' E := ((algebraMap A E).comp eA.symm.toRingHom).toAlgebra
  have hE' : Algebra.Etale A' E := RingHom.etale_algebraMap.mp
    (StacksDraft.etale_comp eA.symm.toRingHom (algebraMap A E)
      (RingHom.Etale.of_bijective eA.symm.bijective) (RingHom.etale_algebraMap.mpr hE))
  refine ⟨E, inferInstance, inferInstance, hE',
    { toRingHom := eB.toRingHom.comp k.toRingHom
      commutes' := ?_ }, c, ?_⟩
  · intro a
    change eB (k (algebraMap A E (eA.symm a))) = _
    rw [k.commutes, he, eA.apply_symm_apply]
  · change eB (k c) = b
    rw [hc, eB.apply_symm_apply]

/-- **Stacks 09AP.** A ring map can identify local rings without being ind-étale or
ind-Zariski. -/
@[stacks 09AP]
theorem exists_identifiesLocalRings_not_indEtale :
    ∃ (A : Type u) (_ : CommRing A) (B : Type v) (_ : CommRing B) (_ : Algebra A B),
      Algebra.IdentifiesLocalRings A B ∧
        ¬ StacksDraft.IndEtale A B ∧
        ¬ AlgebraicGeometry.ProEtale.IsIndZariski.{u, v, w} A B := by
  obtain ⟨R, hR, I, hloc, hnot⟩ :=
    exists_ideal_locally_span_idempotents_not_globally.{0}
  let : CommRing R := hR
  let q : R →ₐ[R] R ⧸ I := Ideal.Quotient.mkₐ R I
  let B₀ := AlgHom.pullback q q
  let A := ULift.{u} R
  let B := ULift.{v} B₀
  let eA : R ≃+* A := (ULift.ringEquiv (R := R)).symm
  let eB : B₀ ≃+* B := (ULift.ringEquiv (R := B₀)).symm
  let : Algebra A B :=
    (eB.toRingHom.comp ((algebraMap R B₀).comp eA.symm.toRingHom)).toAlgebra
  refine ⟨A, inferInstance, B, inferInstance, inferInstance,
    identifiesLocalRings_of_equiv eA eB (fun _ => rfl)
      (identifiesLocalRings_pullback I (fun _ => exists_eq_mul_of_locally_span_idempotents I hloc)),
    fun h => ?_,
    fun h => not_forall_exists_etale_factorization_pullback I q hnot
      (etale_elements_of_equiv eA.symm eB.symm (fun _ => rfl) (etale_elements_of_isIndZariski h))⟩
  refine not_forall_exists_etale_factorization_pullback.{0, 0} I q hnot fun b => ?_
  obtain ⟨J, _, _, pres, hp⟩ :=
    StacksDraft.indEtale_iff.mp (StacksDraft.indEtale_of_equiv eA.symm eB.symm (fun _ => rfl) h)
  obtain ⟨j, c, hc⟩ := exists_eq_app_of_colimitPresentation pres b
  exact ⟨pres.diag.obj j, inferInstance, inferInstance, hp j, (pres.ι.app j).hom, c, hc⟩

end Stacks.Examples
