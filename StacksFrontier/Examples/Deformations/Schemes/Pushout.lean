module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.Algebra.Category.Ring.Topology
public import Mathlib.RingTheory.Localization.BaseChange
public import Mathlib.RingTheory.Smooth.Quotient
public import StacksCore.RingTheory.Nakayama
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Pushouts of commutative rings along surjections with nilpotent kernel

A deformation of an object over an Artinian local base is pinned down by its restriction to the
closed point, and the formal content of that statement is the following recognition criterion
for pushout squares of commutative rings. Suppose a commuting square has a flat right-hand
leg, and suppose that after pushing out along a surjection with nilpotent kernel it becomes a
pushout square; then it was already a pushout square. The proof compares the given square with
the pushout it maps to: the comparison map is surjective by Nakayama and injective because
flatness identifies the kernel with the kernel of its reduction, which vanishes.

The file also records the two facts that criterion runs on: a pushout square one leg of which
is surjective has its opposite leg surjective with the expected kernel, and a pushout square
stays a pushout after localizing at a pair of corresponding primes.

## Main results

* `Deformation.Examples.isPushout_localization_prime`: a pushout square of commutative rings
  remains a pushout after localizing the two right-hand corners at corresponding primes.
* `Deformation.Examples.pushout_surjective_ker`: in a pushout square with one leg surjective,
  the opposite leg is surjective and its kernel is the ideal generated by the image of the
  kernel.
* `Deformation.Examples.bijective_of_flat_of_reduction`: a map of algebras over a ring with a
  nilpotent ideal that becomes an isomorphism modulo that ideal, the target being flat, is
  bijective.
* `Deformation.Examples.isPushout_of_flat_of_residue`: the recognition criterion for pushout
  squares described above.

## Implementation notes

The localization statement is phrased with `Localization.localRingHom`, so no choice of
localization isomorphism enters; the hypothesis `hcomap` is exactly the data that map needs.

In `isPushout_of_flat_of_residue` the comparison map is the canonical map out of
`CategoryTheory.Limits.pushout`, so the conclusion is obtained from
`CategoryTheory.IsPushout.of_iso` applied to that map once it is known bijective.

## References

* [Stacks Project, Tag 0DZM](https://stacks.math.columbia.edu/tag/0DZM)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace Deformation.Examples

/-- A pushout square of commutative rings stays a pushout after localizing the two right-hand
corners at a pair of corresponding primes, provided the leg joining them is surjective. -/
theorem isPushout_localization_prime
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (i : T →+* U)
    (H : IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
      (CommRingCat.ofHom h) (CommRingCat.ofHom i))
    (p : PrimeSpectrum S) (q : PrimeSpectrum U)
    (hsurj : Function.Surjective h)
    (hcomap : p.asIdeal = q.asIdeal.comap h) :
    IsPushout
      (CommRingCat.ofHom f ≫ CommRingCat.ofHom
        (algebraMap S (Localization.AtPrime p.asIdeal)))
      (CommRingCat.ofHom g)
      (CommRingCat.ofHom
        (Localization.localRingHom p.asIdeal q.asIdeal h hcomap))
      (CommRingCat.ofHom
        ((algebraMap U (Localization.AtPrime q.asIdeal)).comp i)) := by
  let M := p.asIdeal.primeCompl
  let : p.asIdeal.IsPrime := p.isPrime
  let : q.asIdeal.IsPrime := q.isPrime
  have hM : M.map h = q.asIdeal.primeCompl := by
    ext z
    show (∃ s, s ∈ M ∧ h s = z) ↔ z ∉ q.asIdeal
    constructor
    · rintro ⟨s, hs, rfl⟩
      change s ∉ p.asIdeal at hs
      simpa [hcomap] using hs
    · intro hz
      obtain ⟨s, rfl⟩ := hsurj z
      refine ⟨s, ?_, rfl⟩
      show s ∉ p.asIdeal
      simpa [hcomap] using hz
  let Sₚ := Localization.AtPrime p.asIdeal
  let Uq := Localization.AtPrime q.asIdeal
  have : IsLocalization M Sₚ := inferInstance
  have : IsLocalization (M.map h) Uq := by
    rw [hM]
    infer_instance
  have hloc : IsPushout (CommRingCat.ofHom (algebraMap S Sₚ))
      (CommRingCat.ofHom h)
      (CommRingCat.ofHom (Localization.localRingHom p.asIdeal q.asIdeal h hcomap))
      (CommRingCat.ofHom (algebraMap U Uq)) := by
    algebraize [h]
    let : q.asIdeal.LiesOver p.asIdeal := ⟨hcomap⟩
    let : Algebra Sₚ Uq := Localization.AtPrime.algebraOfLiesOver p.asIdeal q.asIdeal
    have : IsLocalization (Algebra.algebraMapSubmonoid U M) Uq := by
      show IsLocalization (M.map h) Uq
      infer_instance
    have : IsScalarTower S U Uq := .of_algebraMap_eq' <| RingHom.ext fun _ => rfl
    convert (CommRingCat.isPushout_iff_isPushout (R := S) (S := U) (R' := Sₚ) (S' := Uq)).mpr
      ((Algebra.IsPushout.comm S U Sₚ Uq).mp
        ((Algebra.isLocalization_iff_isPushout M Sₚ (T := U) (B := Uq)).mp inferInstance)) using 1
  exact H.paste_horiz hloc

/-- In a pushout square of commutative rings with `g` surjective, the opposite leg `h` is
surjective and its kernel is the ideal generated by the image of the kernel of `g`. -/
theorem pushout_surjective_ker {R S T U : CommRingCat.{u}}
    {f : R ⟶ S} {g : R ⟶ T} {h : S ⟶ U} {i : T ⟶ U}
    (H : IsPushout f g h i) (hg : Function.Surjective g.hom) :
    Function.Surjective h.hom ∧ RingHom.ker h.hom = (RingHom.ker g.hom).map f.hom := by
  have hw (a : R) : h.hom (f.hom a) = i.hom (g.hom a) :=
    congrArg (fun k : R ⟶ U => k.hom a) H.w
  have hs : Function.Surjective h.hom := by
    have hr : (⊤ : Subring U) ≤ h.hom.range := by
      rw [← CommRingCat.closure_range_union_range_eq_top_of_isPushout H]
      apply Subring.closure_le.mpr
      rintro y (⟨s, rfl⟩ | ⟨t, rfl⟩)
      · exact ⟨s, rfl⟩
      · obtain ⟨a, rfl⟩ := hg t
        exact ⟨f.hom a, hw a⟩
    exact fun y => hr (Subring.mem_top y)
  refine ⟨hs, le_antisymm ?_ ?_⟩
  · let J := (RingHom.ker g.hom).map f.hom
    let q := Ideal.Quotient.mk J
    have hkill : RingHom.ker g.hom ≤ RingHom.ker (q.comp f.hom) := fun a ha =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem f.hom ha)
    let l := RingHom.liftOfSurjective g.hom hg ⟨q.comp f.hom, hkill⟩
    have hl : (CommRingCat.ofHom g.hom) ≫ CommRingCat.ofHom l =
        f ≫ CommRingCat.ofHom q :=
      CommRingCat.hom_ext (RingHom.liftOfSurjective_comp _ _ _)
    let d := H.desc (CommRingCat.ofHom q) (CommRingCat.ofHom l) hl.symm
    have hd : h ≫ d = CommRingCat.ofHom q := H.inl_desc _ _ _
    intro a ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    show q a = 0
    rw [← show d.hom (h.hom a) = q a from congrArg (fun k : S ⟶ _ => k.hom a) hd]
    simp only [RingHom.mem_ker.mp ha, map_zero]
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    show h.hom (f.hom a) = 0
    rw [hw, RingHom.mem_ker.mp ha, map_zero]

/-- If the kernel of `φ : X →+* T` is `I.map (algebraMap R X)`, then `x ∈ I • ⊤` iff `φ x = 0`. -/
private theorem mem_smul_top_iff_of_ker_eq {R X T : Type*} [CommRing R] [CommRing X] [CommRing T]
    [Algebra R X] (I : Ideal R) (φ : X →+* T) (hk : RingHom.ker φ = I.map (algebraMap R X))
    (x : X) : x ∈ I • (⊤ : Submodule R X) ↔ φ x = 0 := by
  rw [Ideal.smul_top_eq_map, ← hk, Submodule.restrictScalars_mem, RingHom.mem_ker]

/-- A map `f : M →ₐ[R] N` of algebras over a ring carrying a nilpotent ideal `I` is bijective as
soon as the target is `R`-flat and `f` becomes an isomorphism after reducing modulo `I`, the
latter being expressed by two maps to a common ring whose kernels are the ideals generated by
`I`. Surjectivity is Nakayama; injectivity uses flatness to compute the kernel's intersection
with `I · N`. -/
@[sga "3 III 3.3"]
theorem bijective_of_flat_of_reduction
    {R M N T : Type*} [CommRing R] [CommRing M] [CommRing N] [CommRing T]
    [Algebra R M] [Algebra R N] [Module.Flat R N]
    (I : Ideal R) (hI : IsNilpotent I) (f : M →ₐ[R] N)
    (a : M →+* T) (b : N →+* T) (ha : Function.Surjective a)
    (hka : RingHom.ker a = I.map (algebraMap R M))
    (hkb : RingHom.ker b = I.map (algebraMap R N))
    (hw : b.comp f.toRingHom = a) : Function.Bijective f := by
  have hs : Function.Surjective f := by
    apply LinearMap.surjective_of_surjective_comp_mkQ_of_isNilpotent I f.toLinearMap hI
    intro y
    obtain ⟨n, rfl⟩ := (I • (⊤ : Submodule R N)).mkQ_surjective y
    obtain ⟨m, hm⟩ := ha (b n)
    refine ⟨m, ?_⟩
    show (I • (⊤ : Submodule R N)).mkQ (f m) = (I • (⊤ : Submodule R N)).mkQ n
    rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq,
      mem_smul_top_iff_of_ker_eq I b hkb]
    rw [map_sub]
    exact sub_eq_zero.mpr ((RingHom.congr_fun hw m).trans hm)
  refine ⟨?_, hs⟩
  show Function.Injective f.toLinearMap
  apply LinearMap.ker_eq_bot.mp
  apply Submodule.eq_bot_of_le_smul_of_isNilpotent I _ hI
  rw [← LinearMap.ker_inf_smul_top_eq_smul_of_flat I f.toLinearMap hs]
  apply le_inf le_rfl
  intro m hm
  rw [mem_smul_top_iff_of_ker_eq I a hka, ← hw, RingHom.comp_apply]
  show b (f m) = 0
  rw [show f m = 0 from hm, map_zero]

/-- **Recognition of pushout squares after a nilpotent reduction.** A commuting square
`f ≫ h = g ≫ i` of commutative rings with `i` flat is a pushout square as soon as pushing it
out along a surjection `r` with nilpotent kernel gives a pushout square: that is, as soon as
the outer square on `f` and `g ≫ r` and the square on `i` and `r` are both pushouts. -/
theorem isPushout_of_flat_of_residue
    {A B C D K F : CommRingCat.{u}}
    (f : A ⟶ C) (g : A ⟶ B) (h : C ⟶ D) (i : B ⟶ D)
    (r : B ⟶ K) (s : K ⟶ F) (p : C ⟶ F) (q : D ⟶ F)
    (hw : f ≫ h = g ≫ i) (hq : h ≫ q = p)
    (HP : IsPushout f (g ≫ r) p s)
    (HQ : IsPushout i r q s) (hr : Function.Surjective r.hom)
    (hnil : IsNilpotent (RingHom.ker r.hom)) (hflat : i.hom.Flat) :
    IsPushout f g h i := by
  let E := Limits.pushout f g
  let j : C ⟶ E := Limits.pushout.inl f g
  let l : B ⟶ E := Limits.pushout.inr f g
  have HE : IsPushout f g j l := IsPushout.of_hasPushout f g
  let d : E ⟶ D := HE.desc h i hw
  have hj : j ≫ d = h := HE.inl_desc _ _ _
  have hl : l ≫ d = i := HE.inr_desc _ _ _
  let a : E ⟶ F := d ≫ q
  have HA : IsPushout l r a s := by
    apply (show IsPushout f (g ≫ r) (j ≫ a) s by
      simpa only [a, ← Category.assoc, hj, hq] using HP).of_top _ HE
    simp only [a, ← Category.assoc, hl, HQ.w]
  obtain ⟨ha, hka⟩ := pushout_surjective_ker HA hr
  obtain ⟨_, hkq⟩ := pushout_surjective_ker HQ hr
  let : Algebra B E := l.hom.toAlgebra
  let : Algebra B D := i.hom.toAlgebra
  have : Module.Flat B D := hflat
  let da : E →ₐ[B] D :=
    { __ := d.hom
      commutes' := fun b => congrArg (fun t : B ⟶ D => t.hom b) hl }
  have hd : Function.Bijective d.hom :=
    bijective_of_flat_of_reduction (RingHom.ker r.hom) hnil da a.hom q.hom
      ha hka hkq rfl
  let e : E ≅ D := (RingEquiv.ofBijective d.hom hd).toCommRingCatIso
  exact HE.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) e
    (by simp) (by simp) (hj.trans (Category.id_comp h).symm)
    (hl.trans (Category.id_comp i).symm)

end Deformation.Examples

end
