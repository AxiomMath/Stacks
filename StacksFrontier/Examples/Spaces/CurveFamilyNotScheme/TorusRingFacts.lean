module

public import Mathlib.GroupTheory.MonoidLocalization.UniqueFactorization
public import Mathlib.RingTheory.Ideal.UFD
public import Mathlib.RingTheory.KrullDimension.Polynomial
public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.KrullDimension.Field
public import StacksFrontier.Examples.Spaces.CurveFamilyNotScheme.TorusRing

/-!
# The torus ring `k[x, y][1 / (x y)]` is a factorial ring of dimension at most two

The coordinate ring `torusRing k = k[x, y][1 / (x y)]` of the torus chart of the cubic surface
of Stacks 0D5E is a localization of the polynomial ring in two variables, so it is a unique
factorization domain of Krull dimension at most two. Consequently every nonzero prime ideal
which is not maximal has height one and is generated by a prime element: an irreducible curve on
the torus is cut out by a single equation.

## Main results

* `Stacks.Examples.CurveFamilyNotScheme.height_le_two_torusRing`: every prime of the torus ring
  has height at most two.
* `Stacks.Examples.CurveFamilyNotScheme.exists_prime_eq_span_of_isPrime`: a nonzero prime of
  the torus ring which is not maximal is principal, generated by a prime element.
* `Stacks.Examples.CurveFamilyNotScheme.span_torusParameter`: the function `t` and the affine
  Fermat equation generate the same ideal.

## References

* [Stacks Project, Tag 0D5E](https://stacks.math.columbia.edu/tag/0D5E)
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks.Examples.CurveFamilyNotScheme

variable (k : Type u) [Field k]

/-- The torus ring is a domain, as a localization of `k[x, y]` at a nonzero element. -/
instance isDomain_torusRing : IsDomain (torusRing k) :=
  Localization.Away.isDomain (mul_ne_zero (X_ne_zero 0) (X_ne_zero 1))

/-- The torus ring is a unique factorization domain, as a localization of one. -/
instance uniqueFactorizationMonoid_torusRing : UniqueFactorizationMonoid (torusRing k) :=
  inferInstance

/-- Every prime of the torus ring has height at most two: its contraction to `k[x, y]` has the
same height, and `k[x, y]` has Krull dimension two. -/
theorem height_le_two_torusRing (P : Ideal (torusRing k)) [P.IsPrime] : P.height ≤ 2 := by
  rw [← IsLocalization.height_under (Submonoid.powers (X 0 * X 1 : MvPolynomial (Fin 2) k)) P]
  have h := Ideal.height_le_ringKrullDim_of_isPrime (I := P.under (MvPolynomial (Fin 2) k))
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field] at h
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin, Nat.cast_ofNat, zero_add] at h
  have h2 : (2 : WithBot ℕ∞) = ((2 : ℕ∞) : WithBot ℕ∞) := rfl
  rw [h2] at h
  exact WithBot.coe_le_coe.mp h

/-- **An irreducible curve on the torus is cut out by one equation.** A nonzero prime of the
torus ring which is not maximal has height one, because a maximal ideal above it has height at
most two; in a unique factorization domain a prime of height one is generated by a prime
element. -/
theorem exists_prime_eq_span_of_isPrime (Q : Ideal (torusRing k)) [Q.IsPrime] (h0 : Q ≠ ⊥)
    (hm : ¬ Q.IsMaximal) : ∃ g : torusRing k, Prime g ∧ Q = Ideal.span {g} := by
  obtain ⟨M, hM, hQM⟩ := Ideal.exists_le_maximal Q (Ideal.IsPrime.ne_top ‹_›)
  have hlt : Q < M := lt_of_le_of_ne hQM fun h => hm (h ▸ hM)
  have h1 : Q.height + 1 ≤ M.height := Ideal.height_add_one_le_of_lt_of_isPrime hlt
  have h2 : M.height ≤ 2 := height_le_two_torusRing k M
  have hbot : (⊥ : Ideal (torusRing k)) < Q := bot_lt_iff_ne_bot.mpr h0
  have h3 : (⊥ : Ideal (torusRing k)).height + 1 ≤ Q.height :=
    Ideal.height_add_one_le_of_lt_of_isPrime hbot
  have hQ : Q.height = 1 := by
    have hle : Q.height ≤ 1 := by
      have := h1.trans h2
      have hfin : Q.height ≠ ⊤ := fun h => by simp [h] at this
      lift Q.height to ℕ using hfin with q
      norm_cast at this ⊢
      omega
    exact le_antisymm hle (le_trans (by simp) h3)
  obtain ⟨g, hgQ, hg⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹_› h0
  exact ⟨g, hg, Q.eq_span_singleton_of_height_eq_one hQ hgQ hg⟩

/-- The function `t = (1 + x ^ 3 + y ^ 3) / (x y)` and the affine Fermat equation
`1 + x ^ 3 + y ^ 3` generate the same ideal of the torus ring, as `x y` is a unit there. -/
theorem span_torusParameter :
    Ideal.span {torusParameter k} = Ideal.span {torusFermat k} := by
  have hu : IsUnit (IsLocalization.Away.invSelf (X 0 * X 1 : MvPolynomial (Fin 2) k) :
      torusRing k) :=
    IsUnit.of_mul_eq_one_right _ (IsLocalization.Away.mul_invSelf _)
  exact Ideal.span_singleton_eq_span_singleton.mpr (Associated.symm ⟨hu.unit, rfl⟩)

end Stacks.Examples.CurveFamilyNotScheme

end
