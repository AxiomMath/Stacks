module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper
public import StacksFrontier.AlgebraicGeometry.HomogeneousQuotient.Basic
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Away
public import StacksFrontier.Examples.Spaces.CurveFamilyNotScheme

/-!
# The cubic surface of the family of curves whose total space is not a scheme

The construction of Stacks 0D5E starts from the surface

```
  Y : T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3 - t * T₀ * T₁ * T₂ = 0
```

in the projective plane over `k[t]`, fibred over the affine line `A¹_k = Spec k[t]`. This file
defines `Y` as `Proj` of the quotient of `k[t][T₀, T₁, T₂]` by the homogeneous ideal of the
cubic, its structure morphism to the affine line, and the origin of the affine line.

## Main definitions

* `Stacks.Examples.CurveFamilyNotScheme.cubicIdeal`: the homogeneous ideal of the cubic.
* `Stacks.Examples.CurveFamilyNotScheme.cubicSurface`: the surface `Y`.
* `Stacks.Examples.CurveFamilyNotScheme.affineLine`: the affine line `Spec k[t]`.
* `Stacks.Examples.CurveFamilyNotScheme.cubicSurfaceToLine`: the structure morphism `Y ⟶ A¹_k`.
* `Stacks.Examples.CurveFamilyNotScheme.originPoint`: the point `t = 0` of the affine line.

## References

* [Stacks Project, Tag 0D5E](https://stacks.math.columbia.edu/tag/0D5E)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry MvPolynomial Stacks.AlgebraicGeometry.ProjPolyChart
  Stacks.RingTheory.HomogeneousQuotient

universe u

namespace Stacks.Examples.CurveFamilyNotScheme

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k : Type u) [Field k]

/-- The cubic is homogeneous of degree three. -/
theorem cubicEquation_mem : cubicEquation k ∈ polyGrading (Polynomial k) 2 3 := by
  rw [MvPolynomial.mem_homogeneousSubmodule, cubicEquation]
  refine ((((isHomogeneous_X_pow _ _).add (isHomogeneous_X_pow _ _)).add
    (isHomogeneous_X_pow _ _)).sub ?_)
  have h : (X 0 * X 1 * X 2 : MvPolynomial (Fin 3) (Polynomial k)).IsHomogeneous 3 :=
    ((isHomogeneous_X _ _).mul (isHomogeneous_X _ _)).mul (isHomogeneous_X _ _)
  simpa using (isHomogeneous_C _ Polynomial.X).mul h

/-- The homogeneous ideal of `k[t][T₀, T₁, T₂]` generated by the cubic. -/
def cubicIdeal : HomogeneousIdeal (polyGrading (Polynomial k) 2) :=
  ⟨Ideal.span {cubicEquation k},
    Ideal.homogeneous_span _ _ fun x hx => by
      rw [Set.mem_singleton_iff.mp hx]
      exact ⟨3, cubicEquation_mem k⟩⟩

/-- The surface `Y : T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3 - t * T₀ * T₁ * T₂ = 0` in the projective plane over
`k[t]`, as `Proj` of the quotient of `k[t][T₀, T₁, T₂]` by `cubicIdeal k`. -/
abbrev cubicSurface : Scheme.{u} :=
  projQuotient (polyGrading (Polynomial k) 2) (cubicIdeal k)

/-- The affine line `A¹_k = Spec k[t]`. -/
abbrev affineLine : Scheme.{u} :=
  Spec (CommRingCat.of (Polynomial k))

/-- The structure morphism `Y ⟶ A¹_k`: the morphism `Proj ⟶ Spec` of the degree-zero part,
followed by the morphism induced by `k[t] ⟶ (k[t][T₀, T₁, T₂] ⧸ (F))₀`. -/
def cubicSurfaceToLine : cubicSurface k ⟶ affineLine k :=
  Proj.toSpecZero (quotientGrading (polyGrading (Polynomial k) 2) (cubicIdeal k)) ≫
    Spec.map (CommRingCat.ofHom
      ((GradedRing.projZeroRingHom' (quotientGrading (polyGrading (Polynomial k) 2)
        (cubicIdeal k))).comp
        (algebraMap (Polynomial k)
          (MvPolynomial (Fin 3) (Polynomial k) ⧸ (cubicIdeal k).toIdeal))))

/-- The point `t = 0` of the affine line, the prime ideal `(t)` of `k[t]`. -/
def originPoint : affineLine k :=
  ⟨Ideal.span {Polynomial.X}, (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr
    Polynomial.prime_X⟩

end Stacks.Examples.CurveFamilyNotScheme

end
