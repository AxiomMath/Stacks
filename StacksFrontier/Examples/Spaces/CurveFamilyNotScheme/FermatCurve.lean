module

public import StacksFrontier.AlgebraicGeometry.Curves.InseparableGenusChangeCurve
public import StacksFrontier.Examples.Spaces.CurveFamilyNotScheme

/-!
# The central fibre of the cubic surface: the Fermat cubic curve

The fibre over `t = 0` of the cubic surface `Y : T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3 - t T₀ T₁ T₂ = 0` of
Stacks 0D5E is the plane Fermat cubic `Y₀ : T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3 = 0`. This file defines it
as `Proj` of the graded quotient `k[T₀, T₁, T₂] ⧸ (T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3)`, with its closed
embedding into the projective plane and its structure morphism to `Spec k`.

## Main definitions

* `Stacks.Examples.CurveFamilyNotScheme.fermatCubic`: the homogeneous cubic
  `T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3`.
* `Stacks.Examples.CurveFamilyNotScheme.fermatIdeal`: the homogeneous ideal it generates.
* `Stacks.Examples.CurveFamilyNotScheme.fermatCurve`: the plane curve `Y₀`.
* `Stacks.Examples.CurveFamilyNotScheme.fermatEmbedding`: its closed embedding into `𝐏²_k`.
* `Stacks.Examples.CurveFamilyNotScheme.fermatCurveToSpec`: its structure morphism to `Spec k`.

## References

* [Stacks Project, Tag 0D5E](https://stacks.math.columbia.edu/tag/0D5E)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial

open Stacks.RingTheory.HomogeneousQuotient (quotientGrading)

universe u

namespace Stacks.Examples.CurveFamilyNotScheme

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k : Type u) [Field k]

/-- The Fermat cubic `T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3`, the equation of the central fibre of the cubic
surface of Stacks 0D5E. -/
def fermatCubic : MvPolynomial (Fin 3) k :=
  X 0 ^ 3 + X 1 ^ 3 + X 2 ^ 3

/-- The Fermat cubic is homogeneous of degree three. -/
theorem fermatCubic_isHomogeneous : (fermatCubic k).IsHomogeneous 3 :=
  ((isHomogeneous_X_pow _ _).add (isHomogeneous_X_pow _ _)).add (isHomogeneous_X_pow _ _)

/-- The homogeneous ideal of `k[T₀, T₁, T₂]` generated by the Fermat cubic. -/
def fermatIdeal : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
  ⟨Ideal.span {fermatCubic k},
    Ideal.homogeneous_span _ _ fun _ hx => ⟨3, (Set.mem_singleton_iff.mp hx) ▸
      (MvPolynomial.mem_homogeneousSubmodule 3 _).2 (fermatCubic_isHomogeneous k)⟩⟩

/-- The underlying ideal of `fermatIdeal k` is the principal ideal of the Fermat cubic. -/
@[simp] theorem toIdeal_fermatIdeal :
    (fermatIdeal k).toIdeal = Ideal.span {fermatCubic k} := rfl

/-- **The Fermat cubic curve** `Y₀ = Proj (k[T₀, T₁, T₂] ⧸ (T₀ ^ 3 + T₁ ^ 3 + T₂ ^ 3))`, the
central fibre of the cubic surface of Stacks 0D5E. -/
abbrev fermatCurve : Scheme.{u} :=
  AlgebraicGeometry.Proj
    (quotientGrading (MvPolynomial.homogeneousSubmodule (Fin 3) k) (fermatIdeal k))

/-- The closed embedding of the Fermat cubic curve into the projective plane `𝐏²_k`. -/
abbrev fermatEmbedding :
    fermatCurve k ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
  Stacks.ProjQuotientChartIdeal.projQuotientHom
    (MvPolynomial.homogeneousSubmodule (Fin 3) k) (fermatIdeal k)

/-- The structure morphism of the Fermat cubic curve to `Spec k`. -/
abbrev fermatCurveToSpec : fermatCurve k ⟶ Spec (CommRingCat.of k) :=
  fermatEmbedding k ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 2

end Stacks.Examples.CurveFamilyNotScheme

end
