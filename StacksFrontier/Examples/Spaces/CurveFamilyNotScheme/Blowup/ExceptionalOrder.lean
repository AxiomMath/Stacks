module

public import StacksFrontier.Examples.Spaces.CurveFamilyNotScheme.Blowup.Basic
public import StacksFrontier.AlgebraicGeometry.Blowup.CentreNormalizeChart
public import StacksFrontier.AlgebraicGeometry.Blowup.RegularSurfaceBlowupExceptionalChart
public import StacksFrontier.AlgebraicGeometry.F6Rank89.IdealSheafStalk

/-!
# A parameter vanishes to order one along the exceptional divisor

Let `y` be a closed point of a scheme `Y` whose local ring `A = 𝒪_{Y,y}` is regular of dimension
two, let `π : Z ⟶ Y` be the blowup of `Y` at `y` and `E` its exceptional divisor. If `t` is a
global function with `t ∈ 𝔪_y \ 𝔪_y²`, then `π^* t` does **not** vanish to order two along `E`:
the inverse image of the ideal generated by `t` is not contained in `E²`.

This is the input that makes the total transform `π⁻¹ V(t)` equal to `E + C` with `C` the strict
transform, in the construction of [Stacks, Tag 0D5E].

## The argument

Extend `t` to a regular system of parameters `s, t` of `A`, choose `s` on an affine open
`V = Spec R ∋ y`, and look at the standard chart `R[𝔪/s]` of the blowup, on which `E` is cut out
by `s` (`Stacks.BlowUpChartCover.map_chartΓIso_ideal_exceptionalIdeal_pow`). If `t ∈ s² R[𝔪/s]`,
then pushing to `A[𝔪_A/s]` the fraction `t/s` would lie in `s A[𝔪_A/s]`, which
`Stacks.Blowup.notMem_span_algebraMap_of_algebraMap_mul_eq` forbids.

## Main results

* `Stacks.Examples.CurveFamilyNotScheme.exists_span_pair_eq_maximalIdeal`: in a regular local
  ring of dimension two an element of `𝔪 \ 𝔪²` is part of a generating pair of `𝔪`.
* `Stacks.Examples.CurveFamilyNotScheme.algebraMap_notMem_span_sq`: the ring-level statement on
  an affine blowup chart.
* `Stacks.Examples.CurveFamilyNotScheme.not_comap_le_exceptionalIdeal_sq`: the scheme-level
  statement.

## References

* [Stacks Project, Tag 0D5E](https://stacks.math.columbia.edu/tag/0D5E)
* [Stacks Project, Tag 0AGR](https://stacks.math.columbia.edu/tag/0AGR)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing Opposite

universe u

namespace Stacks.Examples.CurveFamilyNotScheme

/-! ### Ring-level statements -/

/-- In a regular local ring of dimension two, an element of `𝔪 \ 𝔪²` is one member of a pair
generating `𝔪`. -/
theorem exists_span_pair_eq_maximalIdeal {A : Type u} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) {t : A} (ht : t ∈ maximalIdeal A)
    (ht2 : t ∉ maximalIdeal A ^ 2) :
    ∃ s ∈ maximalIdeal A, Ideal.span {s, t} = maximalIdeal A := by
  set V := CotangentSpace A
  have hrank : Module.finrank (ResidueField A) V = 2 := by
    have h := (IsRegularLocalRing.iff_finrank_cotangentSpace (R := A)).mp inferInstance
    rw [hdim] at h
    exact_mod_cast h
  have : FiniteDimensional (ResidueField A) V :=
    Module.finite_of_finrank_pos (by omega)
  set v : V := (maximalIdeal A).toCotangent ⟨t, ht⟩ with hv
  have hv0 : v ≠ 0 := by
    rw [hv, Ne, Ideal.toCotangent_eq_zero]
    exact ht2
  have hspan_ne : Submodule.span (ResidueField A) {v} ≠ ⊤ := by
    intro h
    have h1 := finrank_span_singleton (K := ResidueField A) hv0
    rw [h, finrank_top, hrank] at h1
    omega
  obtain ⟨w, -, hw⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hspan_ne)
  obtain ⟨s', rfl⟩ := (maximalIdeal A).toCotangent_surjective w
  have hlt : Submodule.span (ResidueField A) {v} <
      Submodule.span (ResidueField A) ((maximalIdeal A).toCotangent '' {s', ⟨t, ht⟩}) := by
    refine lt_of_le_of_ne (Submodule.span_mono ?_) fun h => hw ?_
    · rw [Set.image_pair]
      exact Set.subset_insert _ _
    · rw [h]
      exact Submodule.subset_span ⟨s', by simp, rfl⟩
  have htop : Submodule.span (ResidueField A)
      ((maximalIdeal A).toCotangent '' {s', ⟨t, ht⟩}) = ⊤ := by
    refine Submodule.eq_top_of_finrank_eq (le_antisymm (Submodule.finrank_le _) ?_)
    have h1 := Submodule.finrank_lt_finrank_of_lt hlt
    rw [finrank_span_singleton hv0] at h1
    have h3 : Module.finrank (ResidueField A) (maximalIdeal A).Cotangent = 2 := hrank
    rw [h3]
    exact h1
  rw [CotangentSpace.span_image_eq_top_iff] at htop
  refine ⟨s', s'.2, ?_⟩
  have hmap := congrArg (Submodule.map (maximalIdeal A).subtype) htop
  rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, Set.image_pair] at hmap
  exact hmap

/-- An element of the affine blowup algebra `R[J/a]` is carried by `R_a ⟶ A_a` into the affine
blowup algebra `A[𝔪_A/a]`, for a ring map `R ⟶ A` to a local ring sending `J` into `𝔪_A`. -/
private theorem map_mem_affineBlowupAlgebraAway {R A : Type u} [CommRing R] [CommRing A]
    [IsLocalRing A] [Algebra R A] (J : Ideal R)
    (hJ : ∀ y ∈ J, algebraMap R A y ∈ maximalIdeal A) (a : R) {z : Localization.Away a}
    (hz : z ∈ affineBlowupAlgebra J a (Localization.Away a)) :
    IsLocalization.Away.map (Localization.Away a)
        (Localization.Away (algebraMap R A a)) (algebraMap R A) a z ∈
      affineBlowupAlgebraAway (maximalIdeal A) (algebraMap R A a) := by
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨y, hy, rfl⟩ := hx
    refine Algebra.subset_adjoin ⟨algebraMap R A y, hJ y hy, ?_⟩
    rw [IsLocalization.Away.map, IsLocalization.map_mk', IsLocalization.mk'_eq_mul_mk'_one,
      mul_comm]
    rfl
  | algebraMap r =>
    rw [IsLocalization.Away.map, IsLocalization.map_eq]
    exact Subalgebra.algebraMap_mem _ _
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact mul_mem hx hy

/-- **On an affine blowup chart a parameter does not vanish to order two along the exceptional
divisor.** Let `R ⟶ A` be a ring map to a regular local ring of dimension two, `J ⊆ R` an ideal
mapping into `𝔪_A`, and `a, t ∈ R` with images generating `𝔪_A`. Then the image of `t` in the
affine blowup algebra `R[J/a]` is not divisible by `a²`. -/
theorem algebraMap_notMem_span_sq {R A : Type u} [CommRing R] [CommRing A]
    [IsRegularLocalRing A] [Algebra R A] (hdim : ringKrullDim A = 2) (J : Ideal R)
    (hJ : ∀ y ∈ J, algebraMap R A y ∈ maximalIdeal A) {a t : R}
    (hspan : Ideal.span {algebraMap R A a, algebraMap R A t} = maximalIdeal A) :
    algebraMap R (affineBlowupAlgebra J a (Localization.Away a)) t ∉
      Ideal.span {algebraMap R (affineBlowupAlgebra J a (Localization.Away a)) a ^ 2} := by
  intro hmem
  set a' := algebraMap R A a with ha'
  set t' := algebraMap R A t with ht'
  set φ := IsLocalization.Away.map (Localization.Away a) (Localization.Away a') (algebraMap R A) a
    with hφ
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hmem
  have hb' : (b : Localization.Away a) * (algebraMap R (Localization.Away a) a) ^ 2 =
      algebraMap R (Localization.Away a) t := congrArg Subtype.val hb
  have hφb : φ b * (algebraMap A (Localization.Away a') a') ^ 2 =
      algebraMap A (Localization.Away a') t' := by
    have h := congrArg φ hb'
    rwa [map_mul, map_pow, hφ, IsLocalization.Away.map, IsLocalization.map_eq,
      IsLocalization.map_eq] at h
  have hbB : φ b ∈ affineBlowupAlgebraAway (maximalIdeal A) a' :=
    map_mem_affineBlowupAlgebraAway J hJ a b.2
  have ht'm : t' ∈ maximalIdeal A := hspan ▸ Ideal.subset_span (by simp)
  set u : affineBlowupAlgebraAway (maximalIdeal A) a' :=
    ⟨IsLocalization.Away.invSelf a' * algebraMap A (Localization.Away a') t',
      Algebra.subset_adjoin ⟨t', ht'm, rfl⟩⟩ with hu
  have hinv : algebraMap A (Localization.Away a') a' * IsLocalization.Away.invSelf a' = 1 :=
    IsLocalization.Away.mul_invSelf a'
  have hmul : algebraMap A (affineBlowupAlgebraAway (maximalIdeal A) a') a' * u =
      algebraMap A (affineBlowupAlgebraAway (maximalIdeal A) a') t' := by
    apply Subtype.ext
    change algebraMap A (Localization.Away a') a' *
        (IsLocalization.Away.invSelf a' * algebraMap A (Localization.Away a') t') =
      algebraMap A (Localization.Away a') t'
    rw [← mul_assoc, hinv, one_mul]
  refine Stacks.Blowup.notMem_span_algebraMap_of_algebraMap_mul_eq a' t' hdim hspan u hmul ?_
  refine Ideal.mem_span_singleton'.mpr ⟨⟨φ b, hbB⟩, Subtype.ext ?_⟩
  change φ b * algebraMap A (Localization.Away a') a' =
    IsLocalization.Away.invSelf a' * algebraMap A (Localization.Away a') t'
  rw [← hφb]
  linear_combination (-(φ b * algebraMap A (Localization.Away a') a')) * hinv

/-! ### The scheme-level statement -/

variable {Y : Scheme.{u}} (y : Y) (hy : IsClosed ({y} : Set Y))

/-- **A parameter at `y` does not vanish to order two along the exceptional divisor.** Let the
local ring at the closed point `y` be regular of dimension two and let `t` be a global function
with germ in `𝔪_y \ 𝔪_y²`. For any ideal sheaf `Y₀` containing `t`, the inverse image of `Y₀` on
the blowup at `y` is not contained in the square of the exceptional divisor. -/
theorem not_comap_le_exceptionalIdeal_sq [IsRegularLocalRing (Y.presheaf.stalk y)]
    (hydim : ringKrullDim (Y.presheaf.stalk y) = 2) (Y₀ : Y.IdealSheafData) (t : Γ(Y, ⊤))
    (htY₀ : Scheme.IdealSheafData.ofIdealTop (Ideal.span {t}) ≤ Y₀)
    (hty : Y.presheaf.Γgerm y t ∈ maximalIdeal (Y.presheaf.stalk y))
    (ht : Y.presheaf.Γgerm y t ∉ maximalIdeal (Y.presheaf.stalk y) ^ 2) :
    ¬ Y₀.comap (pointBlowupToBase y hy) ≤ exceptionalIdeal (pointIdeal y hy) ^ 2 := by
  intro hle
  obtain ⟨V, hyV⟩ := Stacks.Divisors.exists_affineOpens_mem y
  let : Algebra Γ(Y, V.1) (Y.presheaf.stalk y) := Y.presheaf.algebra_section_stalk ⟨y, hyV⟩
  have hloc : IsLocalization.AtPrime (Y.presheaf.stalk y)
      (V.2.primeIdealOf ⟨y, hyV⟩).asIdeal := V.2.isLocalization_stalk ⟨y, hyV⟩
  set P := (V.2.primeIdealOf ⟨y, hyV⟩).asIdeal with hP
  have hIV : (pointIdeal y hy).ideal V = P := vanishingIdeal_singleton_ideal y hy V hyV
  set tV : Γ(Y, V.1) := (Y.presheaf.map (homOfLE le_top).op).hom t with htV
  have hgerm : algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) tV = Y.presheaf.Γgerm y t := by
    change (Y.presheaf.germ V.1 y hyV).hom ((Y.presheaf.map (homOfLE le_top).op).hom t) = _
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  obtain ⟨s, hs, hspan⟩ := exists_span_pair_eq_maximalIdeal hydim hty ht
  obtain ⟨⟨s₁, f⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl s
  have hf : IsUnit (algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) f) :=
    IsLocalization.map_units _ f
  have hs₁ : algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) s₁ =
      IsLocalization.mk' (Y.presheaf.stalk y) s₁ f *
        algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) f :=
    (IsLocalization.mk'_spec _ s₁ f).symm
  have hspan₁ : Ideal.span {algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) s₁,
      algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) tV} = maximalIdeal (Y.presheaf.stalk y) := by
    rw [hs₁, hgerm, Ideal.span_insert, Ideal.span_singleton_mul_right_unit hf,
      ← Ideal.span_insert, hspan]
  have hJ : ∀ z ∈ (pointIdeal y hy).ideal V,
      algebraMap Γ(Y, V.1) (Y.presheaf.stalk y) z ∈ maximalIdeal (Y.presheaf.stalk y) := by
    intro z hz
    rw [hIV] at hz
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Y.presheaf.stalk y) P z).mpr hz
  have hs₁P : s₁ ∈ (pointIdeal y hy).ideal V := by
    rw [hIV]
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (Y.presheaf.stalk y) P s₁).mp ?_
    rw [← hspan₁]
    exact Ideal.subset_span (by simp)
  set a : (pointIdeal y hy).ideal V := ⟨s₁, hs₁P⟩
  have h1 := Ideal.map_mono (f := (Stacks.BlowUpChartCover.chartΓIso (pointIdeal y hy) V a).hom.hom)
    (hle (Stacks.BlowUpChartCover.chartOpen (pointIdeal y hy) V a))
  rw [Stacks.BlowUpChartCover.map_chartΓIso_ideal_comap,
    Stacks.BlowUpChartCover.map_chartΓIso_ideal_exceptionalIdeal_pow] at h1
  have htmem : tV ∈ Y₀.ideal V := by
    refine htY₀ V ?_
    rw [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton]
    exact Ideal.subset_span rfl
  exact algebraMap_notMem_span_sq hydim ((pointIdeal y hy).ideal V) hJ hspan₁
    (h1 (Ideal.mem_map_of_mem _ htmem))

end Stacks.Examples.CurveFamilyNotScheme

end
