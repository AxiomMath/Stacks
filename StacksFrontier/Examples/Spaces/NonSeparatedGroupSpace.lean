/-! ### The presheaf of sections modulo the integers -/

/-- The additive group of a commutative ring modulo the subgroup generated by its unit,
functorially in the ring. -/
def sectionsModZ : CommRingCat.{u} ⥤ AddCommGrpCat.{u} where
  obj R := AddCommGrpCat.of (R ⧸ AddSubgroup.zmultiples (1 : R))
  map {R S} f := AddCommGrpCat.ofHom
    (QuotientAddGroup.map _ _ f.hom.toAddMonoidHom (by
      intro x hx
      rcases AddSubgroup.mem_zmultiples_iff.mp hx with ⟨n, rfl⟩
      change f.hom (n • (1 : R)) ∈ AddSubgroup.zmultiples (1 : S)
      simpa only [map_zsmul, map_one] using AddSubgroup.zsmul_mem_zmultiples (1 : S) n))
  map_id R := by ext x; rfl
  map_comp f g := by ext x; rfl

/-- The quotient map of `Stacks.Examples.NonSeparatedGroupSpace.sectionsModZ`, as a natural
transformation from the additive group of a commutative ring. -/
def sectionsModZProjection :
    (forget₂ CommRingCat.{u} RingCat.{u} ⋙ forget₂ RingCat.{u} AddCommGrpCat.{u}) ⟶
      sectionsModZ where
  app R := AddCommGrpCat.ofHom (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : R)))
  naturality R S f := by ext; rfl

/-- Translating a ring element by an integer does not change its class modulo the
integers. -/
theorem sectionsModZ_mk_add_intCast (R : CommRingCat.{u}) (x : R) (n : ℤ) :
    (sectionsModZProjection.app R).hom (x + (n : R)) =
      (sectionsModZProjection.app R).hom x := by
  show (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : R))) (x + (n : R)) =
    (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : R))) x
  have hz : (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : R))) (n : R) = 0 :=
    (QuotientAddGroup.eq_zero_iff _).mpr ⟨n, by simp⟩
  rw [map_add, hz, add_zero]

/-- A function on a commutative ring invariant under translation by the integers factors
through the sections modulo the integers. -/
def sectionsModZLift {R : CommRingCat.{u}} {X : Type v}
    (f : R → X) (hf : ∀ (x : R) (n : ℤ), f (x + (n : R)) = f x) :
    (sectionsModZ.obj R) → X :=
  Quotient.lift f (by
    intro x y hxy
    obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp
      (QuotientAddGroup.leftRel_apply.mp hxy)
    have h : y = x + (n : R) := by
      have hn' : (n : R) = -x + y := by simpa only [zsmul_one] using hn
      simp only [hn', ← add_assoc, add_neg_cancel, zero_add]
    rw [h, hf])

/-- The factorization of an integer-invariant function restricts to that function. -/
theorem sectionsModZLift_mk {R : CommRingCat.{u}} {X : Type v}
    (f : R → X) (hf : ∀ (x : R) (n : ℤ), f (x + (n : R)) = f x) (x : R) :
    sectionsModZLift f hf ((sectionsModZProjection.app R).hom x) = f x := rfl

/-- The projection of a presheaf of commutative rings onto its sections modulo the
integers. -/
abbrev presheafModZProjection {C : Type v} [Category.{v'} C] (R : C ⥤ CommRingCat.{u}) :
    R ⋙ forget CommRingCat ⟶ R ⋙ sectionsModZ ⋙ forget AddCommGrpCat :=
  Functor.whiskerLeft R
    (Functor.whiskerRight sectionsModZProjection (forget AddCommGrpCat))

/-- A map out of a presheaf of commutative rings invariant under translation by the integers
factors through the sections modulo the integers. -/
def presheafModZLift {C : Type v} [Category.{v'} C] (R : C ⥤ CommRingCat.{u})
    {X : C ⥤ Type u} (f : R ⋙ forget CommRingCat ⟶ X)
    (hf : ∀ (T : C) (x : R.obj T) (n : ℤ), f.app T (x + (n : R.obj T)) = f.app T x) :
    R ⋙ sectionsModZ ⋙ forget AddCommGrpCat ⟶ X where
  app T := ↾sectionsModZLift (f.app T) (hf T)
  naturality T T' g := by
    ext x
    induction x using Quotient.inductionOn with
    | _ x => exact ConcreteCategory.congr_hom (f.naturality g) x

/-- The factorization of an integer-invariant map restricts to that map. -/
theorem presheafModZProjection_lift {C : Type v} [Category.{v'} C] (R : C ⥤ CommRingCat.{u})
    {X : C ⥤ Type u} (f : R ⋙ forget CommRingCat ⟶ X)
    (hf : ∀ (T : C) (x : R.obj T) (n : ℤ), f.app T (x + (n : R.obj T)) = f.app T x) :
    presheafModZProjection R ≫ presheafModZLift R f hf = f := rfl

/-- The projection of a presheaf of commutative rings onto its sections modulo the integers is an
epimorphism. -/
instance presheafModZProjection_epi {C : Type v} [Category.{v'} C]
    (R : C ⥤ CommRingCat.{u}) : Epi (presheafModZProjection R) := by
  have (T : C) : Epi ((presheafModZProjection R).app T) :=
    (epi_iff_surjective _).mpr Quotient.mk_surjective
  exact NatTrans.epi_of_epi_app _

/-! ### The group structure -/

/-- An additive-group-valued presheaf is a group object in presheaves of sets. -/
noncomputable abbrev presheafGroupObject {C : Type v} [Category.{v'} C]
    (R : C ⥤ AddCommGrpCat.{u}) : GrpObj (R ⋙ forget AddCommGrpCat.{u}) where
  one := { app X := ↾fun _ => (0 : R.obj X)
           naturality X Y f := by ext; exact (map_zero (R.map f).hom).symm }
  mul := { app X := ↾fun p : R.obj X × R.obj X => p.1 + p.2
           naturality X Y f := by ext; exact (map_add (R.map f).hom _ _).symm }
  inv := { app X := ↾fun a : R.obj X => -a
           naturality X Y f := by ext; exact (map_neg (R.map f).hom _).symm }
  one_mul := by ext X x; exact @zero_add (R.obj X) inferInstance x.2
  mul_one := by ext X x; exact @add_zero (R.obj X) inferInstance x.1
  mul_assoc := by ext X x; exact @add_assoc (R.obj X) inferInstance x.1.1 x.1.2 x.2
  left_inv := by ext X x; exact @neg_add_cancel (R.obj X) inferInstance x
  right_inv := by ext X x; exact @add_neg_cancel (R.obj X) inferInstance x

/-- The sheafification of an additive-group-valued presheaf is a group object: sheafification
preserves finite products, hence group objects. -/
noncomputable abbrev sheafifiedGroupObject {C : Type v} [Category.{v'} C]
    (J : GrothendieckTopology C) [HasSheafify J (Type u)]
    (R : Cᵒᵖ ⥤ AddCommGrpCat.{u}) : GrpObj (sheafify J (R ⋙ forget _)) := by
  letI := presheafGroupObject R
  let F := presheafToSheaf J (Type u) ⋙ sheafToPresheaf J (Type u)
  letI : F.Monoidal := Functor.Monoidal.ofChosenFiniteProducts F
  exact (F.mapGrp.obj ⟨R ⋙ forget _⟩).grp

/-- A group object of a category with a terminal object is a group object over that terminal
object. -/
noncomputable abbrev groupObjectOverTerminal
    {C : Type v} [Category.{v'} C] [CartesianMonoidalCategory C] [HasPullbacks C]
    {T : C} (hT : IsTerminal T) (G : C) [GrpObj G] :
    letI := Over.cartesianMonoidalCategory T
    GrpObj (Over.mk (hT.from G)) := by
  letI := Over.cartesianMonoidalCategory T
  let F := (Over.equivalenceOfIsTerminal hT).inverse
  letI : F.Monoidal := Functor.Monoidal.ofChosenFiniteProducts F
  exact (F.mapGrp.obj ⟨G⟩).grp

/-! ### The affine line as the presheaf of sections -/

/-- Translating the coordinate of a morphism to the affine line by an integer is the same as
composing with the translation by that integer. -/
theorem affineLine_homOfVector_add_intCast
    (k : Type u) [Field k] (T : Over (Spec (.of k)))
    (x : Γ(T.left, ⊤)) (n : ℤ) :
    (Over.homMk (AffineSpace.homOfVector T.hom (fun _ : PUnit.{u + 1} => x + n))
        (AffineSpace.homOfVector_over _ _) :
      T ⟶ AffineLineInvolution.affineLine k) =
      Over.homMk (AffineSpace.homOfVector T.hom (fun _ : PUnit.{u + 1} => x))
        (AffineSpace.homOfVector_over _ _) ≫
        (AffineLineTranslation.translationAction k (Multiplicative.ofAdd n)).hom := by
  apply Over.OverMorphism.ext
  apply AffineSpace.hom_ext
  · exact (Over.w _).trans (Over.w _).symm
  · intro i
    cases i
    simp only [Over.comp_left, Over.homMk_left, Scheme.Hom.comp_appTop,
      CommRingCat.comp_apply, AffineSpace.homOfVector_appTop_coord]
    show x + (n : Γ(T.left, ⊤)) =
      (AffineSpace.homOfVector T.hom (fun _ : PUnit.{u + 1} => x)).appTop
        (((AffineLineTranslation.translationAction k
          (Multiplicative.ofAdd n)).hom.left).appTop
          (AffineSpace.coord (Spec (.of k)) PUnit.unit))
    have h := congrArg
      (fun z => (AffineSpace.homOfVector T.hom (fun _ : PUnit.{u + 1} => x)).appTop z)
      (AffineLineTranslation.translationAction_apply k n)
    simpa only [map_add, map_intCast, AffineSpace.homOfVector_appTop_coord] using h.symm

/-! ### Covering sieves out of the relation scheme of a group action -/

/-- The source map of the graph relation of a group action is the identity on each copy. -/
theorem actionRelation_ι_source {S : Scheme.{u}} (U : Over S) (G : Type w) [Group G]
    [Small.{u} G] (a : G →* Aut U) (g : G) :
    Sigma.ι (fun _ : G => U) g ≫ (Space.actionRelation U G a).source = 𝟙 U := by
  dsimp only [Space.actionRelation, Stacks.Groupoids.PreRelation.source]
  rw [prod.lift_snd]
  exact Sigma.ι_desc _ _

/-- The target map of the graph relation of a group action is `a g` on the copy of `g`. -/
theorem actionRelation_ι_target {S : Scheme.{u}} (U : Over S) (G : Type w) [Group G]
    [Small.{u} G] (a : G →* Aut U) (g : G) :
    Sigma.ι (fun _ : G => U) g ≫ (Space.actionRelation U G a).target = (a g).hom := by
  dsimp only [Space.actionRelation, Stacks.Groupoids.PreRelation.target]
  rw [prod.lift_fst]
  exact Sigma.ι_desc _ _

/-- The quotient sheaf of the graph relation of a group action identifies a point of the
acted-on object with its translate by any group element. -/
theorem quotientSheaf_translate
    {C : Type v} [Category.{v'} C] {S : Scheme.{u}}
    (J : GrothendieckTopology C) [HasSheafify J (Type u)]
    (F : C ⥤ Over S) (U : Over S) (G : Type w) [Group G] [Small.{u} G]
    (a : G →* Aut U) (T : Cᵒᵖ) (f : F.obj T.unop ⟶ U) (g : G) :
    (Stacks.Groupoids.toQuotientSheaf J F (Space.actionRelation U G a)).app T
        (f ≫ (a g).hom) =
      (Stacks.Groupoids.toQuotientSheaf J F (Space.actionRelation U G a)).app T f := by
  let j := Space.actionRelation U G a
  let q := Stacks.Groupoids.toQuotientSheaf J F j
  let ι := Sigma.ι (fun _ : G => U) g
  have h := congrArg (fun α => α.app T (f ≫ ι))
    (Stacks.Groupoids.sourceMap_toQuotientSheaf J F j)
  change q.app T ((f ≫ ι) ≫ j.source) = q.app T ((f ≫ ι) ≫ j.target) at h
  have ht : ι ≫ j.target = (a g).hom := actionRelation_ι_target U G a g
  have hs : ι ≫ j.source = 𝟙 U := actionRelation_ι_source U G a g
  simpa only [Category.assoc, ht, hs, Category.comp_id] using h.symm

/-- A family of morphisms of the big fppf site of `S` which is an fppf covering of the
underlying schemes generates a covering sieve. -/
theorem sieve_mem_of_fppf
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {V : BigFppfOver B S hS} (E : PreZeroHypercover.{u + 1} V)
    (hE : (E.map (BigFppfOver.toScheme B S hS)).presieve₀ ∈
      Scheme.fppfPrecoverage ((BigFppfOver.toScheme B S hS).obj V)) :
    E.sieve₀ ∈ BigFppfOver.topology B S hS V := by
  have hD : IsFppfCovering ⟨V.left, E.map (Over.forget (B.obj hS))⟩ := by
    rwa [IsFppfCovering, Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map]
  apply (B.topology.mem_over_iff E.sieve₀).mpr
  show Sieve.overEquiv V (Sieve.ofArrows E.X E.f) ∈ _
  rw [Sieve.overEquiv_ofArrows]
  exact B.generate_mem_topology_of_isFppfCovering _ hD

/-- A family of morphisms of the big fppf site of `S` exhibiting its target as the coproduct
of its sources generates a covering sieve. -/
theorem coproduct_sieve_mem
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {I : Type v} [Small.{u} I] (X : I → BigFppfOver B S hS)
    (V : BigFppfOver B S hS) (j : ∀ i, X i ⟶ V)
    (e : (∐ (fun i => (BigFppfOver.toScheme B S hS).obj (X i))) ≅
      (BigFppfOver.toScheme B S hS).obj V)
    (he : ∀ i, Sigma.ι _ i ≫ e.hom = (BigFppfOver.toScheme B S hS).map (j i)) :
    Sieve.ofArrows X j ∈ BigFppfOver.topology B S hS V := by
  classical
  let T := BigFppfOver.toScheme B S hS
  let A := fun i => T.obj (X i)
  let E : PreZeroHypercover.{u + 1} V :=
    { I₀ := ULift.{u + 1} (Shrink.{u} I)
      X := fun i => X ((equivShrink I).symm i.down)
      f := fun i => j ((equivShrink I).symm i.down) }
  have hE : (E.map T).presieve₀ ∈ Scheme.fppfPrecoverage (T.obj V) := by
    rw [PreZeroHypercover.presieve₀, Scheme.fppfPrecoverage,
      Scheme.ofArrows_mem_precoverage_iff]
    constructor
    · intro t
      obtain ⟨t, rfl⟩ := e.hom.homeomorph.surjective t
      obtain ⟨i, x, hx⟩ := (sigmaOpenCover A).exists_eq t
      have key : ∀ i₀ : I, i₀ = i → ∃ y, T.map (j i₀) y = e.hom t := by
        intro i₀ hi₀
        subst hi₀
        refine ⟨x, ?_⟩
        calc T.map (j i₀) x = (Sigma.ι (fun i => T.obj (X i)) i₀ ≫ e.hom) x := by
              rw [he i₀]
          _ = e.hom (Sigma.ι (fun i => T.obj (X i)) i₀ x) := Scheme.Hom.comp_apply _ _ _
          _ = e.hom t := congrArg e.hom hx
      refine ⟨ULift.up (equivShrink I i), ?_⟩
      show ∃ y, T.map (j ((equivShrink I).symm (equivShrink I i))) y = _
      exact key _ (Equiv.symm_apply_apply _ _)
    · intro i
      show Flat (T.map (j _)) ∧ LocallyOfFinitePresentation (T.map (j _))
      rw [← he]
      constructor <;> infer_instance
  have hEq : E.sieve₀ = Sieve.ofArrows X j := by
    apply le_antisymm <;> rw [Sieve.generate_le_iff]
    · rintro Z f ⟨i⟩
      exact Sieve.ofArrows_mk X j _
    · rintro Z f ⟨i⟩
      have hh := E.sieve₀_f (ULift.up (equivShrink I i))
      change E.sieve₀ (j ((equivShrink I).symm (equivShrink I i))) at hh
      rwa [Equiv.symm_apply_apply] at hh
  rw [← hEq]
  exact sieve_mem_of_fppf B S hS E hE

/-- Two maps out of the functor of points of an object along a full functor agree as soon as
they agree on the identity. -/
theorem restrictedYoneda_hom_ext
    {C : Type v} [Category.{u} C] {D : Type v'} [Category.{u} D]
    (F : C ⥤ D) [F.Full] (V : C) {P : Cᵒᵖ ⥤ Type u}
    (a b : F.op ⋙ yoneda.obj (F.obj V) ⟶ P)
    (h : a.app (Opposite.op V) (𝟙 _) = b.app (Opposite.op V) (𝟙 _)) : a = b := by
  ext T f
  obtain ⟨g, rfl⟩ := F.map_surjective f
  have ha := ConcreteCategory.congr_hom (a.naturality g.op) (𝟙 (F.obj V))
  have hb := ConcreteCategory.congr_hom (b.naturality g.op) (𝟙 (F.obj V))
  simpa using ha.trans ((congrArg (fun x => P.map g.op x) h).trans hb.symm)

/-- Two sections of a sheaf agreeing on a covering family are equal. -/
theorem sheaf_sections_ext_of_cover
    {C : Type v} [Category.{u} C] (J : GrothendieckTopology C)
    {P : Cᵒᵖ ⥤ Type u} (hP : Presheaf.IsSheaf J P)
    {I : Type v'} {V : C} (X : I → C) (j : ∀ i, X i ⟶ V)
    (hj : Sieve.ofArrows X j ∈ J V) {a b : P.obj (Opposite.op V)}
    (h : ∀ i, P.map (j i).op a = P.map (j i).op b) : a = b := by
  apply ((Presieve.isSheafFor_iff_generate _).mpr (hP.isSheafFor _ hj)).isSeparatedFor.ext
  rintro Y f ⟨i⟩
  exact h i

/-- A map from the functor of points of an object of the site into a sheaf which is invariant
under a group action identifies the source and the target of the graph relation. -/
theorem actionRelation_coequalizes_of_invariant
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (V : BigFppfOver B S hS) (G : Type v) [Group G] [Small.{u} G]
    (a : G →* Aut ((Over.post B.inclusion).obj V))
    (hR : B.Contains (Space.actionRelationScheme
      ((Over.post B.inclusion).obj V) G).left)
    {P : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hP : Presheaf.IsSheaf (BigFppfOver.topology B S hS) P)
    (f : Stacks.Groupoids.points (Over.post B.inclusion)
      ((Over.post B.inclusion).obj V) ⟶ P)
    (hf : ∀ (T : (BigFppfOver B S hS)ᵒᵖ)
      (x : (Over.post B.inclusion).obj T.unop ⟶
      (Over.post B.inclusion).obj V) g, f.app T (x ≫ (a g).hom) = f.app T x) :
    Stacks.Groupoids.sourceMap (Over.post B.inclusion)
        (Space.actionRelation ((Over.post B.inclusion).obj V) G a) ≫ f =
      Stacks.Groupoids.targetMap (Over.post B.inclusion)
        (Space.actionRelation ((Over.post B.inclusion).obj V) G a) ≫ f := by
  classical
  let F := Over.post (X := B.obj hS) B.inclusion
  let U := F.obj V
  let W := Space.siteActionRelationScheme G B hS V hR
  let ι (g : G) : V ⟶ W := F.preimage (Sigma.ι (fun _ : G => U) g)
  have hι (g : G) : F.map (ι g) = Sigma.ι (fun _ : G => U) g := F.map_preimage _
  have hc : Sieve.ofArrows (fun _ : G => V) ι ∈ BigFppfOver.topology B S hS W := by
    apply coproduct_sieve_mem B S hS _ _ ι
      (PreservesCoproduct.iso (Over.forget S) (fun _ : G => U)).symm
    intro g
    show Sigma.ι (fun _ : G => U.left) g ≫
      (PreservesCoproduct.iso (Over.forget S) (fun _ : G => U)).inv = (F.map (ι g)).left
    rw [hι, PreservesCoproduct.inv_hom]
    exact ι_comp_sigmaComparison (Over.forget S) (fun _ : G => U) g
  let j := Space.actionRelation U G a
  let s := Stacks.Groupoids.sourceMap F j ≫ f
  let t := Stacks.Groupoids.targetMap F j ≫ f
  apply restrictedYoneda_hom_ext F W s t
  apply sheaf_sections_ext_of_cover _ hP _ ι hc
  intro g
  have hs := ConcreteCategory.congr_hom (s.naturality (ι g).op) (𝟙 (F.obj W))
  have ht := ConcreteCategory.congr_hom (t.naturality (ι g).op) (𝟙 (F.obj W))
  apply hs.symm.trans
  apply Eq.trans _ ht
  show f.app (Opposite.op V) ((F.map (ι g) ≫ 𝟙 _) ≫ j.source) =
    f.app (Opposite.op V) ((F.map (ι g) ≫ 𝟙 _) ≫ j.target)
  rw [Category.comp_id, hι]
  exact (congrArg (f.app (Opposite.op V)) (actionRelation_ι_source U G a g)).trans
    (((hf (Opposite.op V) (𝟙 U) g).symm).trans
      (congrArg (f.app (Opposite.op V))
        ((Category.id_comp (a g).hom).trans (actionRelation_ι_target U G a g).symm)))

/-! ### `𝔸¹_k/ℤ` as the sheafification of the sections modulo the integers -/

section TranslationQuotient

open AffineLineInvolution AffineLineTranslation

variable (k : Type u) [Field k] [CharZero k] (B : BigFppfSite.{u})
  (hS : B.Contains (Spec (.of k)))
  [HasSheafify (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)]

/-- The presheaf of global sections on the big fppf site over `Spec k`. -/
noncomputable abbrev sectionsPresheaf :
    (BigFppfOver B (Spec (.of k)) hS)ᵒᵖ ⥤ CommRingCat.{u} :=
  (BigFppfOver.toScheme B (Spec (.of k)) hS).op ⋙ Scheme.Γ

/-- The fppf sheafification of the presheaf of global sections modulo the integers. -/
noncomputable abbrev sectionsModZSheaf : (BigFppfOver B (Spec (.of k)) hS)ᵒᵖ ⥤ Type u :=
  sheafify (BigFppfOver.topology B (Spec (.of k)) hS)
    (sectionsPresheaf k B hS ⋙ sectionsModZ ⋙ forget AddCommGrpCat)

/-- A morphism to the affine line over `Spec k` from an object of the big fppf site is a
global section of its underlying scheme, naturally in the object. -/
noncomputable def lineSectionsIso :
    Stacks.Groupoids.points (Over.post (X := B.obj hS) B.inclusion) (affineLine k) ≅
      sectionsPresheaf k B hS ⋙ forget CommRingCat := by
  refine NatIso.ofComponents (fun T => Equiv.toIso {
    toFun := fun f => f.left.appTop (AffineSpace.coord (Spec (.of k)) PUnit.unit)
    invFun := fun s => Over.homMk
      (AffineSpace.homOfVector
        ((Over.post (X := B.obj hS) B.inclusion).obj T.unop).hom (fun _ => s))
      (AffineSpace.homOfVector_over _ _)
    left_inv := ?_
    right_inv := ?_ }) ?_
  · intro f
    apply Over.OverMorphism.ext
    apply AffineSpace.hom_ext
    · exact (AffineSpace.homOfVector_over _ _).trans f.w.symm
    · intro i
      cases i
      simp [AffineSpace.homOfVector_appTop_coord]
  · intro s
    exact AffineSpace.homOfVector_appTop_coord _ _ _
  · intro T T' f
    ext g
    change (((Over.post (X := B.obj hS) B.inclusion).map f.unop ≫ g).left).appTop _ =
      ((Over.post (X := B.obj hS) B.inclusion).map f.unop).left.appTop (g.left.appTop _)
    simp only [Over.comp_left, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]

/-- The graph relation of the integer translation action on the affine line over `k`. -/
noncomputable abbrev lineRelation :
    Stacks.Groupoids.PreRelation
      (Space.actionRelationScheme (affineLine k) (Multiplicative ℤ)) (affineLine k) :=
  Space.actionRelation (affineLine k) (Multiplicative ℤ) (translationAction k)

/-- The projection of the functor of points of the affine line onto `𝔸¹_k/ℤ`. -/
noncomputable abbrev lineToTranslationQuotient :
    Stacks.Groupoids.points (Over.post (X := B.obj hS) B.inclusion) (affineLine k) ⟶
      translationQuotient k B hS (contains_affineLine k B hS) :=
  Stacks.Groupoids.toQuotientSheaf (BigFppfOver.topology B (Spec (.of k)) hS)
    (Over.post (X := B.obj hS) B.inclusion) (lineRelation k)

/-- The projection of the functor of points of the affine line onto the sheafified sections
modulo the integers. -/
noncomputable abbrev lineToSectionsModZSheaf :
    Stacks.Groupoids.points (Over.post (X := B.obj hS) B.inclusion) (affineLine k) ⟶
      sectionsModZSheaf k B hS :=
  ((lineSectionsIso k B hS).hom ≫ presheafModZProjection (sectionsPresheaf k B hS)) ≫
    toSheafify (BigFppfOver.topology B (Spec (.of k)) hS) _

/-- The projection of the functor of points of the affine line onto the sections modulo the
integers is an epimorphism of presheaves. -/
instance : Epi ((lineSectionsIso k B hS).hom ≫
    presheafModZProjection (sectionsPresheaf k B hS)) := epi_comp _ _

omit [CharZero k] in
/-- Reading a global section as a morphism to the affine line and projecting to `𝔸¹_k/ℤ` is
invariant under translation by the integers. -/
theorem lineSectionsIso_inv_lineToTranslationQuotient_add_intCast
    (T : (BigFppfOver B (Spec (.of k)) hS)ᵒᵖ) (x : (sectionsPresheaf k B hS).obj T) (n : ℤ) :
    ((lineSectionsIso k B hS).inv ≫ lineToTranslationQuotient k B hS).app T
        (x + (n : (sectionsPresheaf k B hS).obj T)) =
      ((lineSectionsIso k B hS).inv ≫ lineToTranslationQuotient k B hS).app T x := by
  let F := Over.post (X := B.obj hS) B.inclusion
  let q := lineToTranslationQuotient k B hS
  let x' : Γ((F.obj T.unop).left, ⊤) := x
  show q.app T (Over.homMk (AffineSpace.homOfVector (F.obj T.unop).hom
      (fun _ : PUnit.{u + 1} => x' + (n : Γ((F.obj T.unop).left, ⊤))))
        (AffineSpace.homOfVector_over _ _)) =
    q.app T (Over.homMk (AffineSpace.homOfVector (F.obj T.unop).hom
      (fun _ : PUnit.{u + 1} => x')) (AffineSpace.homOfVector_over _ _))
  exact (congrArg (fun y => q.app T y)
    (affineLine_homOfVector_add_intCast k (F.obj T.unop) x' n)).trans
    (quotientSheaf_translate (BigFppfOver.topology B (Spec (.of k)) hS) F _
      (Multiplicative ℤ) (translationAction k) T _ (Multiplicative.ofAdd n))

/-- The map from the sheafified sections modulo the integers to `𝔸¹_k/ℤ`. -/
noncomputable def sectionsModZSheafToTranslationQuotient :
    sectionsModZSheaf k B hS ⟶
      translationQuotient k B hS (contains_affineLine k B hS) :=
  sheafifyLift (BigFppfOver.topology B (Spec (.of k)) hS)
    (presheafModZLift (sectionsPresheaf k B hS)
      ((lineSectionsIso k B hS).inv ≫ lineToTranslationQuotient k B hS)
      (lineSectionsIso_inv_lineToTranslationQuotient_add_intCast k B hS))
    (Stacks.Groupoids.quotientSheaf (BigFppfOver.topology B (Spec (.of k)) hS)
      (Over.post (X := B.obj hS) B.inclusion) (lineRelation k)).property

omit [CharZero k] in
/-- The comparison map into `𝔸¹_k/ℤ` restricts on the affine line to the quotient
projection. -/
theorem lineToSectionsModZSheaf_comp_sectionsModZSheafToTranslationQuotient :
    lineToSectionsModZSheaf k B hS ≫ sectionsModZSheafToTranslationQuotient k B hS =
      lineToTranslationQuotient k B hS := by
  have h := toSheafify_sheafifyLift (BigFppfOver.topology B (Spec (.of k)) hS)
    (presheafModZLift (sectionsPresheaf k B hS)
      ((lineSectionsIso k B hS).inv ≫ lineToTranslationQuotient k B hS)
      (lineSectionsIso_inv_lineToTranslationQuotient_add_intCast k B hS))
    (Stacks.Groupoids.quotientSheaf (BigFppfOver.topology B (Spec (.of k)) hS)
      (Over.post (X := B.obj hS) B.inclusion) (lineRelation k)).property
  refine (congrArg (fun m => ((lineSectionsIso k B hS).hom ≫
    presheafModZProjection (sectionsPresheaf k B hS)) ≫ m) h).trans ?_
  show (lineSectionsIso k B hS).hom ≫ (lineSectionsIso k B hS).inv ≫
    lineToTranslationQuotient k B hS = lineToTranslationQuotient k B hS
  rw [Iso.hom_inv_id_assoc]

omit [CharZero k] in
/-- The class modulo the integers of the coordinate of a morphism to the affine line is
invariant under the translation action. -/
theorem lineToSectionsModZSheaf_translate
    (T : (BigFppfOver B (Spec (.of k)) hS)ᵒᵖ)
    (x : (Over.post (X := B.obj hS) B.inclusion).obj T.unop ⟶
      (Over.post (X := B.obj hS) B.inclusion).obj
        (siteAffineLine k B hS (contains_affineLine k B hS)))
    (g : Multiplicative ℤ) :
    (lineToSectionsModZSheaf k B hS).app T (x ≫ (translationAction k g).hom) =
      (lineToSectionsModZSheaf k B hS).app T x := by
  let R := sectionsPresheaf k B hS
  let P := R ⋙ sectionsModZ ⋙ forget AddCommGrpCat
  let J := BigFppfOver.topology B (Spec (.of k)) hS
  have hact : (((translationAction k g).hom).left).appTop
      (AffineSpace.coord (Spec (.of k)) PUnit.unit) =
      AffineSpace.coord (Spec (.of k)) PUnit.unit +
        ((g.toAdd : ℤ) : Γ(AffineSpace PUnit.{u + 1} (Spec (.of k)), ⊤)) :=
    translationAction_apply k g.toAdd
  show (toSheafify J P).app T
      ((sectionsModZProjection.app (R.obj T)).hom
        ((x ≫ (translationAction k g).hom).left.appTop
          (AffineSpace.coord (Spec (.of k)) PUnit.unit))) =
    (toSheafify J P).app T
      ((sectionsModZProjection.app (R.obj T)).hom
        (x.left.appTop (AffineSpace.coord (Spec (.of k)) PUnit.unit)))
  refine congrArg ((toSheafify J P).app T) ?_
  have h1 : (x ≫ (translationAction k g).hom).left.appTop
        (AffineSpace.coord (Spec (.of k)) PUnit.unit) =
      x.left.appTop ((((translationAction k g).hom).left).appTop
        (AffineSpace.coord (Spec (.of k)) PUnit.unit)) := rfl
  have h2 : x.left.appTop (AffineSpace.coord (Spec (.of k)) PUnit.unit +
        ((g.toAdd : ℤ) : Γ(AffineSpace PUnit.{u + 1} (Spec (.of k)), ⊤))) =
      x.left.appTop (AffineSpace.coord (Spec (.of k)) PUnit.unit) +
        x.left.appTop ((g.toAdd : ℤ) :
          Γ(AffineSpace PUnit.{u + 1} (Spec (.of k)), ⊤)) := map_add _ _ _
  have h3 : x.left.appTop ((g.toAdd : ℤ) :
        Γ(AffineSpace PUnit.{u + 1} (Spec (.of k)), ⊤)) =
      ((g.toAdd : ℤ) :
        Γ(((Over.post (X := B.obj hS) B.inclusion).obj T.unop).left, ⊤)) :=
    map_intCast _ _
  rw [h1, hact, h2, h3]
  exact sectionsModZ_mk_add_intCast (R.obj T) _ g.toAdd

/-- The map from `𝔸¹_k/ℤ` to the sheafified sections modulo the integers. -/
noncomputable def translationQuotientToSectionsModZSheaf :
    translationQuotient k B hS (contains_affineLine k B hS) ⟶ sectionsModZSheaf k B hS :=
  (Stacks.Groupoids.quotientSheafDesc (BigFppfOver.topology B (Spec (.of k)) hS)
    (Over.post (X := B.obj hS) B.inclusion) (lineRelation k)
    ((presheafToSheaf (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)).obj
      (sectionsPresheaf k B hS ⋙ sectionsModZ ⋙ forget AddCommGrpCat))
    (lineToSectionsModZSheaf k B hS)
    (actionRelation_coequalizes_of_invariant B (Spec (.of k)) hS
      (siteAffineLine k B hS (contains_affineLine k B hS)) (Multiplicative ℤ)
      (translationAction k)
      (Space.contains_actionRelationScheme (Multiplicative ℤ) B hS
        (siteAffineLine k B hS (contains_affineLine k B hS)) (translationAction k)
        (translationAction_residueFieldFaithful k))
      ((presheafToSheaf (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)).obj
        (sectionsPresheaf k B hS ⋙ sectionsModZ ⋙ forget AddCommGrpCat)).property
      (lineToSectionsModZSheaf k B hS)
      (lineToSectionsModZSheaf_translate k B hS))).hom

/-- The comparison map out of `𝔸¹_k/ℤ` restricts on the affine line to the sheafified
projection onto the sections modulo the integers. -/
theorem lineToTranslationQuotient_comp_translationQuotientToSectionsModZSheaf :
    lineToTranslationQuotient k B hS ≫ translationQuotientToSectionsModZSheaf k B hS =
      lineToSectionsModZSheaf k B hS :=
  Stacks.Groupoids.toQuotientSheaf_quotientSheafDesc _ _ _ _ _ _

/-- **Stacks 02Z7.** `𝔸¹_k/ℤ` is the fppf sheafification of the presheaf of global sections
modulo the integers. -/
noncomputable def translationQuotientIsoSectionsModZSheaf :
    translationQuotient k B hS (contains_affineLine k B hS) ≅ sectionsModZSheaf k B hS := by
  refine ⟨translationQuotientToSectionsModZSheaf k B hS,
    sectionsModZSheafToTranslationQuotient k B hS, ?_, ?_⟩
  · apply sheafify_hom_ext
      (hQ := (Stacks.Groupoids.quotientSheaf (BigFppfOver.topology B (Spec (.of k)) hS)
        (Over.post (X := B.obj hS) B.inclusion) (lineRelation k)).property)
    apply coequalizer.hom_ext
    have h : lineToTranslationQuotient k B hS ≫ (translationQuotientToSectionsModZSheaf k B hS ≫
        sectionsModZSheafToTranslationQuotient k B hS) =
        lineToTranslationQuotient k B hS ≫ 𝟙 _ := by
      rw [← Category.assoc,
        lineToTranslationQuotient_comp_translationQuotientToSectionsModZSheaf,
        lineToSectionsModZSheaf_comp_sectionsModZSheafToTranslationQuotient, Category.comp_id]
    exact h
  · apply sheafify_hom_ext
      (hQ := ((presheafToSheaf (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)).obj
        (sectionsPresheaf k B hS ⋙ sectionsModZ ⋙ forget AddCommGrpCat)).property)
    apply (cancel_epi ((lineSectionsIso k B hS).hom ≫
      presheafModZProjection (sectionsPresheaf k B hS))).mp
    have h : lineToSectionsModZSheaf k B hS ≫ (sectionsModZSheafToTranslationQuotient k B hS ≫
        translationQuotientToSectionsModZSheaf k B hS) =
        lineToSectionsModZSheaf k B hS ≫ 𝟙 _ := by
      rw [← Category.assoc,
        lineToSectionsModZSheaf_comp_sectionsModZSheafToTranslationQuotient,
        lineToTranslationQuotient_comp_translationQuotientToSectionsModZSheaf,
        Category.comp_id]
    exact h

end TranslationQuotient

/-! ### The counterexample -/

section Counterexample

open AffineLineInvolution AffineLineTranslation

/-- A property of morphisms of presheaves stable under isomorphism holds on the diagonal of a
presheaf exactly when it holds on the diagonal of any isomorphic presheaf. -/
theorem diagonal_property_iff_of_iso
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (P : MorphismProperty ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u)) [P.RespectsIso]
    {F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (e : F ≅ G) : P (diag F) ↔ P (diag G) :=
  P.arrow_mk_iso_iff (Arrow.isoMk e (prod.mapIso e e) (by simp [diag]))

variable (k : Type u) [Field k] [CharZero k] (B : BigFppfSite.{u})
  (hS : B.Contains (Spec (.of k)))
  [HasSheafify (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)]

/-- The affine line over `k` as an object of the big fppf site over `Spec k`. -/
noncomputable abbrev lineObj : BigFppfOver B (Spec (.of k)) hS :=
  siteAffineLine k B hS (contains_affineLine k B hS)

omit [HasSheafify (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)] in
/-- The relation scheme of the integer translation action lies in the site. -/
theorem contains_lineRelationScheme :
    B.Contains (Space.actionRelationScheme
      (Space.underlyingOver B hS (lineObj k B hS)) (Multiplicative ℤ)).left :=
  Space.contains_actionRelationScheme (Multiplicative ℤ) B hS (lineObj k B hS)
    (translationAction k) (translationAction_residueFieldFaithful k)

/-- The source map of the graph relation of the translation action, inside the site. -/
noncomputable abbrev lineRelationSource :
    Space.siteActionRelationScheme (Multiplicative ℤ) B hS (lineObj k B hS)
      (contains_lineRelationScheme k B hS) ⟶ lineObj k B hS :=
  Space.siteActionRelationSource (Multiplicative ℤ) B hS (lineObj k B hS)
    (contains_lineRelationScheme k B hS)

/-- The target map of the graph relation of the translation action, inside the site. -/
noncomputable abbrev lineRelationTarget :
    Space.siteActionRelationScheme (Multiplicative ℤ) B hS (lineObj k B hS)
      (contains_lineRelationScheme k B hS) ⟶ lineObj k B hS :=
  Space.siteActionRelationTarget (Multiplicative ℤ) B hS (lineObj k B hS)
    (contains_lineRelationScheme k B hS) (translationAction k)

private instance isEtaleEquivalenceRelation_lineRelation :
    Stacks.Groupoids.IsEtaleEquivalenceRelation
      (Space.relation B (Spec (.of k)) hS (lineRelationSource k B hS)
        (lineRelationTarget k B hS)) :=
  isEtaleEquivalenceRelation_translationActionRelation k

omit [CharZero k] [HasSheafify (BigFppfOver.topology B (Spec (.of k)) hS) (Type u)] in
/-- The base `Spec k`, read as a presheaf, is a quasi-separated algebraic space. -/
theorem isAbsolutelyQuasiSeparated_base :
    Space.IsAbsolutelyQuasiSeparated B (Spec (.of k)) hS B.contains_terminal
      (yoneda.obj (Over.mk (𝟙 (B.obj hS)) : BigFppfOver B (Spec (.of k)) hS)) :=
  Space.isAbsolutelyQuasiSeparated_of_isQuasiSeparatedScheme B (Spec (.of k)) hS _
    B.contains_terminal
    ⟨Over.mk (𝟙 (B.obj hS)), (by change QuasiSeparatedSpace (Spec (.of k)); infer_instance),
      ⟨Functor.RepresentableBy.yoneda _⟩⟩

/-- **Stacks 02Z7.** `𝔸¹_k/ℤ` is an algebraic space over `Spec k`. -/
theorem isAlgebraicSpace_translationQuotient :
    IsAlgebraicSpace B (Spec (.of k)) hS
      (translationQuotient k B hS (contains_affineLine k B hS)) :=
  Space.isAlgebraicSpace_actionQuotient (Multiplicative ℤ) B hS (lineObj k B hS)
    (translationAction k) (translationAction_residueFieldFaithful k)
    (Space.isEffectiveDescentAlongCoveringSieve_monomorphisms_inf_lft B (Spec (.of k)) hS)

/-- The affine line as a chart of `𝔸¹_k/ℤ`. -/
noncomputable abbrev lineChart :
    yoneda.obj (lineObj k B hS) ⟶ translationQuotient k B hS (contains_affineLine k B hS) :=
  Space.quotientMap B (Spec (.of k)) hS (lineRelationSource k B hS)
    (lineRelationTarget k B hS)

/-- The chart of `𝔸¹_k/ℤ` is surjective. -/
theorem surjective_lineChart :
    (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of k)) hS))) (lineChart k B hS) :=
  Space.quotientMap_surjective B (Spec (.of k)) hS (lineRelationSource k B hS)
    (lineRelationTarget k B hS)
    (Space.relativelyRepresentable_quotientMap_of_isAlgebraicSpace B (Spec (.of k)) hS
      (lineRelationSource k B hS) (lineRelationTarget k B hS)
      (isAlgebraicSpace_translationQuotient k B hS))

/-- The chart of `𝔸¹_k/ℤ` is étale. -/
theorem etale_lineChart :
    (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B (Spec (.of k)) hS))) (lineChart k B hS) :=
  Space.quotientMap_etale B (Spec (.of k)) hS (lineRelationSource k B hS)
    (lineRelationTarget k B hS)
    (Space.relativelyRepresentable_quotientMap_of_isAlgebraicSpace B (Spec (.of k)) hS
      (lineRelationSource k B hS) (lineRelationTarget k B hS)
      (isAlgebraicSpace_translationQuotient k B hS))

/-- **Stacks 03E3.** `𝔸¹_k/ℤ` is a quasi-compact algebraic space: the affine line is a
surjective étale chart with quasi-compact underlying scheme. -/
theorem isQuasiCompactSpace_translationQuotient :
    Space.IsQuasiCompactSpace B (Spec (.of k)) hS
      (translationQuotient k B hS (contains_affineLine k B hS)) :=
  ⟨lineObj k B hS, lineChart k B hS,
    (by change CompactSpace (AffineSpace PUnit.{u + 1} (Spec (.of k))); infer_instance),
    surjective_lineChart k B hS,
    Space.isEtale_of_presheaf_etale B (Spec (.of k)) hS (etale_lineChart k B hS)⟩

/-- Any presheaf isomorphic to `𝔸¹_k/ℤ` is locally of finite type over `Spec k`: the affine line
is a surjective étale chart and is locally of finite type over `Spec k`. -/
private theorem isLocallyOfFiniteType_of_iso_translationQuotient
    {Q : (BigFppfOver B (Spec (.of k)) hS)ᵒᵖ ⥤ Type u}
    (e : translationQuotient k B hS (contains_affineLine k B hS) ≅ Q) :
    Space.IsLocallyOfFiniteType B (Spec (.of k)) hS
      ((Space.yonedaMkIdTerminal B (Spec (.of k)) hS).from Q) := by
  refine Space.holdsOnEveryEtaleChart_of_surjectiveChart B (Spec (.of k)) hS _
    isEtaleLocalOnSourceAndTarget_locallyOfFiniteType ?_
  refine ⟨lineObj k B hS, Over.mk (𝟙 (B.obj hS)), lineChart k B hS ≫ e.hom,
    yoneda.map (𝟙 (Over.mk (𝟙 (B.obj hS)))), Over.homMk (lineObj k B hS).hom (by simp),
    MorphismProperty.RespectsIso.postcomp _ e.hom _ (etale_lineChart k B hS), ?_,
    MorphismProperty.RespectsIso.postcomp _ e.hom _ (surjective_lineChart k B hS),
    (Space.yonedaMkIdTerminal B (Spec (.of k)) hS).hom_ext _ _, ?_⟩
  · exact (Space.presheaf_yoneda_map_iff B (Spec (.of k)) hS inferInstance _).mpr
      (by change Etale (𝟙 _); infer_instance)
  · show LocallyOfFiniteType ((affineLine k).hom)
    exact (inferInstance : LocallyOfFiniteType
      ((AffineSpace PUnit.{u + 1} (Spec (.of k))) ↘ Spec (.of k)))

/-- **Stacks 03XF.** `𝔸¹_k/ℤ` is locally of finite type over `Spec k`: the affine line is a
surjective étale chart and is locally of finite type over `Spec k`. -/
theorem isLocallyOfFiniteType_translationQuotient :
    Space.IsLocallyOfFiniteType B (Spec (.of k)) hS
      ((Space.yonedaMkIdTerminal B (Spec (.of k)) hS).from
        (translationQuotient k B hS (contains_affineLine k B hS))) :=
  isLocallyOfFiniteType_of_iso_translationQuotient k B hS (Iso.refl _)

/-- **Stacks 03XF.** `𝔸¹_k/ℤ` is of finite type over `Spec k`. -/
theorem isFiniteType_translationQuotient :
    Space.IsFiniteType B (Spec (.of k)) hS
      ((Space.yonedaMkIdTerminal B (Spec (.of k)) hS).from
        (translationQuotient k B hS (contains_affineLine k B hS))) :=
  ⟨isLocallyOfFiniteType_translationQuotient k B hS,
    Space.isQuasiCompact_of_isQuasiCompactSpace B (Spec (.of k)) hS B.contains_terminal
      (isAlgebraicSpace_yoneda B (Spec (.of k)) hS (Over.mk (𝟙 (B.obj hS))))
      (isAbsolutelyQuasiSeparated_base k B hS)
      (isQuasiCompactSpace_translationQuotient k B hS) _⟩

variable (hG : B.Contains (Spec (.of (RatFunc k))))

include hG

/-- **Stacks 06EA.** `𝔸¹_k/ℤ` is not locally separated over `Spec k`: a locally separated
algebraic space is decent, and `𝔸¹_k/ℤ` is not. -/
theorem not_isLocallySeparatedOver_translationQuotient :
    ¬ Space.IsLocallySeparatedOver B (Spec (.of k)) hS
      (translationQuotient k B hS (contains_affineLine k B hS)) := fun hsep =>
  not_isDecentSpace_translationQuotient k B hS hG
    (Space.isDecentSpace_of_isLocallySeparatedOver B (Spec (.of k)) hS
      (isAlgebraicSpace_translationQuotient k B hS) hsep)

/-- **Stacks 06EA.** `𝔸¹_k/ℤ` is not quasi-separated over `Spec k`: a quasi-separated
algebraic space is decent, and `𝔸¹_k/ℤ` is not. -/
theorem not_isQuasiSeparatedOver_translationQuotient :
    ¬ Space.IsQuasiSeparatedOver B (Spec (.of k)) hS
      (translationQuotient k B hS (contains_affineLine k B hS)) := by
  intro hqs
  refine not_isDecentSpace_translationQuotient k B hS hG ?_
  refine Space.isDecentSpace_of_isAbsolutelyQuasiSeparated B (Spec (.of k)) hS _
    (isAlgebraicSpace_translationQuotient k B hS) ?_
  exact Space.isAbsolutelyQuasiSeparated_of_isQuasiSeparated B (Spec (.of k)) hS
    B.contains_terminal (isAlgebraicSpace_translationQuotient k B hS)
    (isAbsolutelyQuasiSeparated_base k B hS)
    (Space.isQuasiSeparated_of_isQuasiSeparatedOver B (Spec (.of k)) hS hqs
      ((Space.yonedaMkIdTerminal B (Spec (.of k)) hS).from _))

/-- **Stacks 06EA.** `𝔸¹_k/ℤ` is not separated over `Spec k`: a separated algebraic space is
locally separated. -/
theorem not_isSeparatedOver_translationQuotient :
    ¬ Space.IsSeparatedOver B (Spec (.of k)) hS
      (translationQuotient k B hS (contains_affineLine k B hS)) := fun hsep =>
  not_isLocallySeparatedOver_translationQuotient k B hS hG
    (Space.isImmersion_of_isClosedImmersion B (Spec (.of k)) hS hsep)

end Counterexample

/-! ### Stacks 06EA -/

open AffineLineInvolution AffineLineTranslation in
/-- **Stacks Project, Tag 06EA.** Over a field of characteristic zero there is a group
algebraic space of finite type over the field which is neither separated, nor quasi-separated,
nor locally separated.

The witness is the quotient `𝔸¹_k/ℤ` of the affine line by the integer translations, realized
as the fppf sheafification of the presheaf of global sections modulo the integers: addition of
sections makes that sheafification a group object, while the quotient fails to be decent, and a
quasi-separated or locally separated algebraic space is decent. -/
@[stacks 06EA]
theorem exists_isFiniteType_groupAlgebraicSpace_not_isSeparatedOver
    (k : Type u) [Field k] [CharZero k] (B : BigFppfSite.{u})
    (hS : B.Contains (Spec (.of k))) (hG : B.Contains (Spec (.of (RatFunc k)))) :
    ∃ G : Space.GroupAlgebraicSpace B (Spec (.of k)) hS
        (yoneda.obj (Over.mk (𝟙 (B.obj hS))))
        (isAlgebraicSpace_yoneda B (Spec (.of k)) hS (Over.mk (𝟙 (B.obj hS)))),
      Space.IsFiniteType B (Spec (.of k)) hS G.obj.X.hom ∧
      ¬ Space.IsSeparatedOver B (Spec (.of k)) hS G.obj.X.left ∧
      ¬ Space.IsQuasiSeparatedOver B (Spec (.of k)) hS G.obj.X.left ∧
      ¬ Space.IsLocallySeparatedOver B (Spec (.of k)) hS G.obj.X.left := by
  have : HasSheafify (BigFppfOver.topology B (Spec (.of k)) hS) (Type u) :=
    BigFppfOver.hasSheafify_type B (Spec (.of k)) hS
  let hT := Space.yonedaMkIdTerminal B (Spec (.of k)) hS
  have e := translationQuotientIsoSectionsModZSheaf k B hS
  have hXalg : IsAlgebraicSpace B (Spec (.of k)) hS (sectionsModZSheaf k B hS) :=
    isAlgebraicSpace_of_iso B (Spec (.of k)) hS e.symm
      (isAlgebraicSpace_translationQuotient k B hS)
  let : GrpObj (sectionsModZSheaf k B hS) :=
    sheafifiedGroupObject (BigFppfOver.topology B (Spec (.of k)) hS)
      (sectionsPresheaf k B hS ⋙ sectionsModZ)
  let : GrpObj (Over.mk (hT.from (sectionsModZSheaf k B hS))) :=
    groupObjectOverTerminal hT (sectionsModZSheaf k B hS)
  refine ⟨⟨⟨Over.mk (hT.from (sectionsModZSheaf k B hS))⟩, hXalg⟩, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · exact isLocallyOfFiniteType_of_iso_translationQuotient k B hS e
  · exact Space.isQuasiCompact_of_isQuasiCompactSpace B (Spec (.of k)) hS
      B.contains_terminal
      (isAlgebraicSpace_yoneda B (Spec (.of k)) hS (Over.mk (𝟙 (B.obj hS))))
      (isAbsolutelyQuasiSeparated_base k B hS)
      (Space.IsQuasiCompactSpace.of_iso B (Spec (.of k)) hS
        (isQuasiCompactSpace_translationQuotient k B hS) e) _
  · exact fun hsep => not_isSeparatedOver_translationQuotient k B hS hG
      ((diagonal_property_iff_of_iso B (Spec (.of k)) hS
        ((MorphismProperty.inverseImage
          (@AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
          (BigFppfOver.toScheme B (Spec (.of k)) hS)).presheaf) e).2 hsep)
  · exact fun hqs => not_isQuasiSeparatedOver_translationQuotient k B hS hG
      ((diagonal_property_iff_of_iso B (Spec (.of k)) hS
        ((MorphismProperty.inverseImage
          (@QuasiCompact.{u} : MorphismProperty Scheme.{u})
          (BigFppfOver.toScheme B (Spec (.of k)) hS)).presheaf) e).2 hqs)
  · exact fun hloc => not_isLocallySeparatedOver_translationQuotient k B hS hG
      ((diagonal_property_iff_of_iso B (Spec (.of k)) hS
        ((MorphismProperty.inverseImage
          (@AlgebraicGeometry.IsImmersion.{u} : MorphismProperty Scheme.{u})
          (BigFppfOver.toScheme B (Spec (.of k)) hS)).presheaf) e).2 hloc)

end Stacks.Examples.NonSeparatedGroupSpace

