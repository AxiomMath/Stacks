/-!
# Complete normality from flatness of the power series ring

If the ring of formal power series of a domain `R` is flat over `R[x]`, then `R` is normal
(`IsIntegrallyClosed`) if and only if it is completely normal (`IsCompletelyNormal`).

Only the forward implication uses the hypothesis; the converse holds for every domain, since an
integral element over `R` in the fraction field is in particular almost integral. For the
forward implication one shows that an almost integral element `α = a/b` of the fraction field
lies in every localization of `R` at a maximal ideal, hence in `R` itself. Fix a maximal ideal
`m`. Almost integrality supplies an `r ≠ 0` with `r αⁿ ∈ R` for all `n`, and the power series
`∑ r αⁿ xⁿ` makes `(a x - b)` divide `-r b` in `R⟦x⟧`. Flatness of `R⟦x⟧` over `R[x]` is
inherited by the local homomorphism of the localizations at the prime of power series with
constant coefficient in `m` and its contraction, where a flat local homomorphism is faithfully
flat; faithful flatness contracts the ideal generated by `a x - b` back, which produces a
polynomial `s` with `s(0) ∉ m` and `r b s = (a X - b) g` in `R[x]`. Over the localization of `R`
at `m` the polynomial `s` has `α⁻¹` as a root, so its reverse has `α` as a root, and dividing by
the unit `s(0)` makes it monic. Thus `α` is integral over the localization, which is normal
because `R` is, and therefore `α` lies in it.

## Main results

* `Stacks.Examples.normal_iff_isCompletelyNormal_of_powerSeries_flat`: for a domain whose power
  series ring is flat over its polynomial ring, normality and complete normality agree.

## References

* [Stacks Project, Tag 0F1Y](https://stacks.math.columbia.edu/tag/0F1Y)
-/

@[expose] public section

namespace Stacks.Examples

/-- If `α = a / b` in the fraction field of `R` and `r αⁿ` lies in `R` for every `n`, then the
power series with coefficients `r αⁿ` witnesses the divisibility of `-r b` by `a x - b` in
`R⟦x⟧`. -/
private lemma powerSeries_telescope
    {R : Type*} [CommRing R] {K : Type*} [Field K] [Algebra R K]
    [IsFractionRing R K] (a b r : R) (α : K) (hb : algebraMap R K b ≠ 0)
    (hα : (algebraMap R K a) / (algebraMap R K b) = α)
    (hcoeff : ∀ n : ℕ, ∃ c : R, algebraMap R K c = algebraMap R K r * α ^ n) :
    ∃ f : PowerSeries R,
      (PowerSeries.C a * PowerSeries.X - PowerSeries.C b) * f =
        -PowerSeries.C (r * b) := by
  classical
  let c : ℕ → R := fun n => Classical.choose (hcoeff n)
  have hc (n : ℕ) : algebraMap R K (c n) = algebraMap R K r * α ^ n :=
    Classical.choose_spec (hcoeff n)
  refine ⟨PowerSeries.mk c, ?_⟩
  apply (PowerSeries.map_injective (algebraMap R K) (IsFractionRing.injective R K))
  have hmap : PowerSeries.map (algebraMap R K) (PowerSeries.mk c) =
      PowerSeries.mk fun n => algebraMap R K r * α ^ n := by
    ext n
    simp [PowerSeries.coeff_map, PowerSeries.coeff_mk, hc]
  simp only [map_mul, map_sub, PowerSeries.map_C, PowerSeries.map_X, map_neg, hmap,
    map_mul, PowerSeries.map_C]
  have hring :
      (PowerSeries.C (algebraMap R K a) * PowerSeries.X -
          PowerSeries.C (algebraMap R K b)) *
          PowerSeries.mk (fun n => algebraMap R K r * α ^ n) =
        PowerSeries.C (algebraMap R K a) *
            (PowerSeries.X * PowerSeries.mk (fun n => algebraMap R K r * α ^ n)) -
          PowerSeries.C (algebraMap R K b) *
            PowerSeries.mk (fun n => algebraMap R K r * α ^ n) := by ring
  rw [hring]
  ext n
  cases n with
  | zero =>
      simp [map_mul]
      ring
  | succ n =>
      simp only [map_sub, PowerSeries.coeff_C_mul, PowerSeries.coeff_succ_X_mul,
        PowerSeries.coeff_mk, map_neg, PowerSeries.coeff_mul_C, PowerSeries.coeff_succ_C,
        zero_mul, neg_zero]
      rw [pow_succ, ← hα]
      field_simp [hb]
      ring

/-- An almost integral element of the fraction field of a normal domain whose power series ring
is flat over its polynomial ring lies in the localization at every maximal ideal. -/
private lemma almostIntegral_mem_maxLocalization
    (R : Type*) [CommRing R] [IsDomain R]
    (hflat : Module.Flat (Polynomial R) (PowerSeries R))
    (hnormal : IsIntegrallyClosed R) {α : FractionRing R}
    (hα : IsAlmostIntegral R α) (m : Ideal R) (hm : m.IsMaximal) :
    α ∈ Localization.subalgebra.ofField (FractionRing R) m.primeCompl
      m.primeCompl_le_nonZeroDivisors := by
  classical
  let K := FractionRing R
  obtain ⟨a, b, hb, hαeq⟩ := IsFractionRing.div_surjective R α
  obtain ⟨r, hr, hpow⟩ := (isAlmostIntegral_iff α).mp hα
  have hcoeff : ∀ n : ℕ, ∃ c : R, algebraMap R K c = algebraMap R K r * α ^ n := by
    intro n
    obtain ⟨c, hc⟩ := hpow n
    refine ⟨c, ?_⟩
    simpa [Algebra.smul_def] using hc
  have hbne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
  have hne (x : R) (hx : x ≠ 0) : algebraMap R K x ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R K)).2 hx
  have hbK := hne b hbne
  obtain ⟨f, hf⟩ := powerSeries_telescope a b r α hbK hαeq hcoeff
  let A := Polynomial R
  let B := PowerSeries R
  let f₀ : A →+* B := algebraMap A B
  let q : Ideal B := Ideal.comap PowerSeries.constantCoeff m
  have hqprime : q.IsPrime := hm.isPrime.comap PowerSeries.constantCoeff
  let p : Ideal A := Ideal.comap f₀ q
  have hpprime : p.IsPrime := hqprime.comap f₀
  let φ : Localization.AtPrime p →+* Localization.AtPrime q :=
    Localization.localRingHom p q f₀ rfl
  have hf₀flat : f₀.Flat := RingHom.flat_algebraMap_iff.mpr hflat
  have hφflat : φ.Flat := RingHom.Flat.localRingHom hf₀flat q p rfl
  let : IsLocalHom φ := Localization.isLocalHom_localRingHom p q f₀ rfl
  have hφff : φ.FaithfullyFlat := faithfullyFlat_of_flat_of_isLocalHom φ hφflat
  let P : A := Polynomial.C a * Polynomial.X - Polynomial.C b
  let J : Ideal A := Ideal.span {P}
  let I : Ideal (Localization.AtPrime p) :=
    Ideal.span {algebraMap A (Localization.AtPrime p) P}
  have hPco : ((P : Polynomial R) : PowerSeries R) =
      PowerSeries.C a * PowerSeries.X - PowerSeries.C b := by
    change (((Polynomial.C a * Polynomial.X - Polynomial.C b : Polynomial R) : PowerSeries R)) = _
    simp
  have hseries : f₀ P * f = -PowerSeries.C (r * b) := by
    change ((P : Polynomial R) : PowerSeries R) * f = -PowerSeries.C (r * b)
    rw [hPco]
    exact hf
  have hgen : φ (algebraMap A (Localization.AtPrime p) P) ∈ Ideal.map φ I :=
    Ideal.mem_map_of_mem φ (Ideal.subset_span (by simp))
  have htarget : algebraMap B (Localization.AtPrime q) (PowerSeries.C (r * b)) ∈
      Ideal.map φ I := by
    have hloc := congrArg (algebraMap B (Localization.AtPrime q)) hseries
    have hmapP : φ (algebraMap A (Localization.AtPrime p) P) =
        algebraMap B (Localization.AtPrime q) (f₀ P) :=
      Localization.localRingHom_to_map p q f₀ rfl P
    have hmul : φ (algebraMap A (Localization.AtPrime p) P) *
        algebraMap B (Localization.AtPrime q) f ∈ Ideal.map φ I :=
      Ideal.mul_mem_right _ _ hgen
    have heq : algebraMap B (Localization.AtPrime q) (PowerSeries.C (r * b)) =
        -(φ (algebraMap A (Localization.AtPrime p) P) *
          algebraMap B (Localization.AtPrime q) f) := by
      simpa [map_mul, map_neg, hmapP] using (congrArg Neg.neg hloc).symm
    rw [heq]
    exact (Ideal.map φ I).neg_mem hmul
  have hmapC (x : R) : f₀ (Polynomial.C x) = PowerSeries.C x := by
    change ((Polynomial.C x : Polynomial R) : PowerSeries R) = _
    exact Polynomial.coe_C x
  have hconst : φ (algebraMap A (Localization.AtPrime p) (Polynomial.C (r * b))) =
      algebraMap B (Localization.AtPrime q) (PowerSeries.C (r * b)) := by
    rw [Localization.localRingHom_to_map p q f₀ rfl, hmapC]
  have hsource : algebraMap A (Localization.AtPrime p) (Polynomial.C (r * b)) ∈ I := by
    rw [← faithfullyFlat_comap_map_eq φ hφff I]
    exact Ideal.mem_comap.mpr (by simpa only [hconst] using htarget)
  obtain ⟨s, hsP, hs⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff p.primeCompl
      (Localization.AtPrime p) J (Polynomial.C (r * b))).mp (by
        simpa [I, J, Ideal.map_span] using hsource)
  rw [Ideal.mem_span_singleton] at hs
  obtain ⟨g, hg⟩ := hs
  have hs0 : s.coeff 0 ∉ m := by
    intro hs0m
    apply hsP
    apply Ideal.mem_comap.mpr
    apply Ideal.mem_comap.mpr
    change PowerSeries.constantCoeff (f₀ s) ∈ m
    have hcoeff0 : PowerSeries.constantCoeff (f₀ s) = s.coeff 0 := by
      change PowerSeries.constantCoeff ((s : Polynomial R) : PowerSeries R) = _
      exact Polynomial.constantCoeff_coe s
    rw [hcoeff0]
    exact hs0m
  by_cases hα0 : α = 0
  · rw [hα0]
    exact Subalgebra.zero_mem _
  · let Rm := Localization.AtPrime m
    let : m.IsPrime := hm.isPrime
    let ψm : R →+* Rm := algebraMap R Rm
    let sm : Polynomial Rm := Polynomial.map ψm s
    let gm : Polynomial Rm := Polynomial.map ψm g
    have hs0unit : IsUnit (algebraMap R Rm (s.coeff 0)) :=
      IsLocalization.map_units (R := R) (M := m.primeCompl) Rm ⟨s.coeff 0, hs0⟩
    let u : Rmˣ := hs0unit.unit
    have hαmult : algebraMap R K a = α * algebraMap R K b :=
      (div_eq_iff hbK).mp hαeq
    have hpolyM : Polynomial.C (algebraMap R Rm (r * b)) * sm =
        (Polynomial.C (algebraMap R Rm a) * Polynomial.X -
          Polynomial.C (algebraMap R Rm b)) * gm := by
      have h := congrArg (Polynomial.map ψm) hg
      dsimp [P] at h
      rw [Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_sub,
        Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
        Polynomial.map_C, Polynomial.map_C] at h
      calc
        Polynomial.C (algebraMap R Rm (r * b)) * sm =
            sm * Polynomial.C (algebraMap R Rm (r * b)) := mul_comm _ _
        _ = (Polynomial.C (algebraMap R Rm a) * Polynomial.X -
            Polynomial.C (algebraMap R Rm b)) * gm := by
          simpa [sm, gm, map_mul] using h
    have hfactor : algebraMap Rm K (algebraMap R Rm a) * α⁻¹ -
        algebraMap Rm K (algebraMap R Rm b) = 0 := by
      rw [← IsScalarTower.algebraMap_apply R Rm K a,
        ← IsScalarTower.algebraMap_apply R Rm K b, hαmult]
      calc
        α * algebraMap R K b * α⁻¹ - algebraMap R K b =
            algebraMap R K b * (α * α⁻¹) - algebraMap R K b := by ring
        _ = 0 := by rw [mul_inv_cancel₀ hα0, mul_one, sub_self]
    have hrootSm : Polynomial.eval₂ (algebraMap Rm K) α⁻¹ sm = 0 := by
      have heval := congrArg (Polynomial.eval₂ (algebraMap Rm K) α⁻¹) hpolyM
      simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_sub,
        Polynomial.eval₂_X] at heval
      rw [hfactor] at heval
      have hcoefne : algebraMap Rm K (algebraMap R Rm (r * b)) ≠ 0 := by
        rw [← IsScalarTower.algebraMap_apply, map_mul]
        exact mul_ne_zero (hne r hr) hbK
      simp only [zero_mul] at heval
      exact (mul_eq_zero.mp heval).resolve_left hcoefne
    let : Invertible (α⁻¹) := invertibleOfNonzero (inv_ne_zero hα0)
    have hrootRev : Polynomial.eval₂ (algebraMap Rm K) α sm.reverse = 0 := by
      have h := (Polynomial.eval₂_reverse_eq_zero_iff (algebraMap Rm K) (α⁻¹) sm).mpr hrootSm
      rwa [invOf_eq_inv, inv_inv] at h
    let qpoly : Polynomial Rm := Polynomial.C ((u⁻¹ : Rmˣ) : Rm) * sm.reverse
    have hcoeffVal : sm.coeff 0 = (u : Rm) := by
      dsimp [sm, u]
      rw [Polynomial.coeff_map]
    have hcoeff0 : sm.coeff 0 ≠ 0 := by
      simpa only [sm, Polynomial.coeff_map] using hs0unit.ne_zero
    have hmonic : qpoly.Monic := by
      change (Polynomial.C ((u⁻¹ : Rmˣ) : Rm) * sm.reverse).Monic
      rw [Polynomial.Monic.def,
        Polynomial.leadingCoeff_C_mul_of_isUnit (Units.isUnit (u⁻¹ : Rmˣ)),
        Polynomial.reverse_leadingCoeff, Polynomial.trailingCoeff_eq_coeff_zero hcoeff0]
      rw [hcoeffVal]
      simp
    have hrootQ : Polynomial.eval₂ (algebraMap Rm K) α qpoly = 0 := by
      simp [qpoly, Polynomial.eval₂_mul, Polynomial.eval₂_C, hrootRev]
    have hαint : IsIntegral Rm α := ⟨qpoly, hmonic, hrootQ⟩
    let : IsIntegrallyClosed R := id hnormal
    let : IsIntegrallyClosed Rm :=
      isIntegrallyClosed_of_isLocalization Rm m.primeCompl m.primeCompl_le_nonZeroDivisors
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hαint
    obtain ⟨c, d, hy'⟩ := IsLocalization.exists_mk'_eq m.primeCompl y
    refine ⟨c, d.1, d.2, ?_⟩
    rw [← hy, ← hy']
    have hspec := congrArg (algebraMap Rm K)
      (IsLocalization.mk'_spec Rm c d)
    rw [map_mul, ← IsScalarTower.algebraMap_apply R Rm K d.1,
      ← IsScalarTower.algebraMap_apply R Rm K c] at hspec
    have hdK : algebraMap R K d.1 ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
        (m.primeCompl_le_nonZeroDivisors d.2)
    rw [← div_eq_mul_inv]
    exact (eq_div_iff hdK).2 hspec

/-- A domain whose power series ring is flat over its polynomial ring is normal
if and only if it is completely normal. -/
@[stacks 0F1Y]
theorem normal_iff_isCompletelyNormal_of_powerSeries_flat
    (R : Type*) [CommRing R] [IsDomain R]
    (hflat : Module.Flat (Polynomial R) (PowerSeries R)) :
    IsIntegrallyClosed R ↔ IsCompletelyNormal R := by
  refine ⟨fun hnormal α hα => ?_, fun hcomplete => ?_⟩
  · have hmem : α ∈ (⊥ : Subalgebra R (FractionRing R)) := by
      rw [← MaximalSpectrum.iInf_localization_eq_bot R (FractionRing R)]
      exact Algebra.mem_iInf.mpr fun v =>
        almostIntegral_mem_maxLocalization R hflat hnormal hα v.asIdeal v.isMaximal
    simpa [Algebra.mem_bot] using hmem
  · exact (isIntegrallyClosed_iff (FractionRing R)).mpr fun hα => hcomplete _ hα.isAlmostIntegral

