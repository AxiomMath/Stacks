/-!
# A module whose flat locus is not open

Let `A = ℚ[t, u_i : i ∈ ℤ] / ((t - i) u_i : i ∈ ℤ)` and, for `m : ℤ`, let
`p_m = (t - m) + (u_i : i ∈ ℤ)`, a maximal ideal with residue field `ℚ`. Let
`I = (u_i : i ≥ 1)` be the ideal generated by the variables of *positive* index only and
`F = A ⧸ I`. Then `F` localized at `p_m` is flat over `A_{p_m}` exactly when `m ≤ 0`,
while `p_0` lies in the closure of `{p_m : m ≥ 1}`. So the flat locus of `F` is not open in
the subspace `{p_m : m : ℤ}` of `Spec A`.

## Main definitions

* `Stacks.Examples.NonOpenFlatLocus.A`: the ring, the quotient of the polynomial ring on the
  index type `Option ℤ` (with `none ↦ t` and `some i ↦ u_i`) by the relations `(t - i) u_i`.
* `Stacks.Examples.NonOpenFlatLocus.ev`: the evaluation `ℚ`-algebra map `A → ℚ` sending `t` to
  `m` and every `u_i` to `0`.
* `Stacks.Examples.NonOpenFlatLocus.pIdeal`: the ideal `p_m = (t - m) + (u_i : i ∈ ℤ)`.
* `Stacks.Examples.NonOpenFlatLocus.posIdeal` and `Stacks.Examples.NonOpenFlatLocus.F`: the
  ideal `I = (u_i : i ≥ 1)` and the quotient `F = A ⧸ I`.
* `Stacks.Examples.NonOpenFlatLocus.nfSubalgebra` and
  `Stacks.Examples.NonOpenFlatLocus.nfHom`: the normal-form model of `A` inside
  `ℚ[X] × ∏_{i : ℤ} ℚ[X]`, and the comparison map.
* `Stacks.Examples.NonOpenFlatLocus.IsFlatAt`: flatness of `F` localized at a prime of `A`.

## Main results

Statement 1, the normal form:

* `Stacks.Examples.NonOpenFlatLocus.t_sub_mul_u`: `(t - i) u_i = 0`.
* `Stacks.Examples.NonOpenFlatLocus.intCast_sub_mul_u_mul_u` and
  `Stacks.Examples.NonOpenFlatLocus.u_mul_u`: `(i - j) u_i u_j = 0`, hence `u_i u_j = 0`,
  for `i ≠ j`.
* `Stacks.Examples.NonOpenFlatLocus.t_sub_mul_u_pow`: `(t - i) u_i^a = 0` for `a ≥ 1`.
* `Stacks.Examples.NonOpenFlatLocus.u_pow_ne_zero`: `u_i^a ≠ 0`.
* `Stacks.Examples.NonOpenFlatLocus.t_pow_mul_u_pow` and
  `Stacks.Examples.NonOpenFlatLocus.u_pow_mul_u_pow`: the multiplication table,
  `t^n u_i^a = i^n u_i^a` and `u_i^a u_j^b = 0` for `i ≠ j`.
* `Stacks.Examples.NonOpenFlatLocus.span_nfMonomial`: **existence** of the normal form —
  the `ℚ`-span of `{t^n} ∪ {u_i^a : a ≥ 1}` is all of `A`, i.e. every element of `A` is of
  the form `c(t) + Σ c_{i,a} u_i^a`.
* `Stacks.Examples.NonOpenFlatLocus.coeff_zero_cmp`: the `i`-th component of the normal form
  of `a` has constant term `ev i a`.

Statement 2, the maximal ideals:

* `Stacks.Examples.NonOpenFlatLocus.pIdeal_eq_ker`: `p_m` is the kernel of `ev m`.
* `Stacks.Examples.NonOpenFlatLocus.pIdeal_isMaximal`: `p_m` is maximal.
* `Stacks.Examples.NonOpenFlatLocus.residueEquiv` and
  `Stacks.Examples.NonOpenFlatLocus.residueEquiv_mk`: the residue field is `ℚ` and the
  quotient map is the evaluation.

Statement 3, flatness of the localized fibre:

* `Stacks.Examples.NonOpenFlatLocus.J_eq_bot`: for `m ≤ 0` the ideal `I A_{p_m}` vanishes.
* `Stacks.Examples.NonOpenFlatLocus.J_eq_span_singleton`: for `m ≥ 1` it is `u_m A_{p_m}`.
* `Stacks.Examples.NonOpenFlatLocus.u_notMem_sq`: for `m ≥ 1` the generator `u_m` is not a
  multiple of `u_m^2` in `A_{p_m}`, which is the failure of `J = J^2`.
* `Stacks.Examples.NonOpenFlatLocus.isFlatAt_pt_of_nonpos` and
  `Stacks.Examples.NonOpenFlatLocus.not_isFlatAt_pt_of_pos`: `F` localized at `p_m` is flat
  over `A_{p_m}` for `m ≤ 0` and is not flat for `m ≥ 1`.

Statement 4, the specialization:

* `Stacks.Examples.NonOpenFlatLocus.pt_zero_mem_closure`: `p_0` lies in the closure of
  `{p_m : m ≥ 1}` in `Spec A`.

Statement 5, the conclusion:

* `Stacks.Examples.NonOpenFlatLocus.setOf_isFlatAt_pt`: the flat locus is exactly
  `{m : m ≤ 0}`.
* `Stacks.Examples.NonOpenFlatLocus.not_isOpen_flatLocus`: the flat locus is **not open** in
  the subspace `{p_m : m : ℤ}` of `Spec A`.

The integer shift:

* `Stacks.Examples.NonOpenFlatLocus.shift` and
  `Stacks.Examples.NonOpenFlatLocus.shiftEquiv`: the automorphism `t ↦ t - n`,
  `u_i ↦ u_{i + n}` of `A`, with `shift_zero` and `shift_comp` making `n ↦ shift n` an action
  of `ℤ`.
* `Stacks.Examples.NonOpenFlatLocus.comap_shift_pt`: the shift by `n` carries `p_m` to
  `p_{m - n}`, so the `p_m` form one orbit.
* `Stacks.Examples.NonOpenFlatLocus.comap_shift_pt_ne`: the action is free on `{p_m}`: no
  nonzero shift fixes any `p_m`.

## References

* [Stacks Project, Tag 0CWK](https://stacks.math.columbia.edu/tag/0CWK)
* [Stacks Project, Tag 04PS](https://stacks.math.columbia.edu/tag/04PS)
-/

@[expose] public noncomputable section

namespace Stacks.Examples.NonOpenFlatLocus

open Polynomial TensorProduct

/-! ### The ring -/

/-- The polynomial ring `ℚ[t, u_i : i ∈ ℤ]`, on the index type `Option ℤ`: the variable
indexed by `none` is `t` and the variable indexed by `some i` is `u_i`. -/
public abbrev Pre : Type := MvPolynomial (Option ℤ) ℚ

/-- The relations `(t - i) u_i`, one for each `i : ℤ`. -/
public def relSet : Set Pre :=
  Set.range fun i : ℤ ↦ (MvPolynomial.X none - (i : Pre)) * MvPolynomial.X (some i)

/-- The ideal generated by the relations `(t - i) u_i`. -/
public def rel : Ideal Pre := Ideal.span relSet

/-- The ring `A = ℚ[t, u_i : i ∈ ℤ] / ((t - i) u_i : i ∈ ℤ)`. -/
public abbrev A : Type := Pre ⧸ rel

/-- The element `t` of `A`. -/
public def t : A := Ideal.Quotient.mk rel (MvPolynomial.X none)

/-- The element `u_i` of `A`. -/
public def u (i : ℤ) : A := Ideal.Quotient.mk rel (MvPolynomial.X (some i))

/-- Two `ℚ`-algebra maps out of `A` agreeing on `t` and on every `u_i` are equal: `t` and the
`u_i` generate `A`. -/
public theorem algHom_ext' {B : Type*} [CommRing B] [Algebra ℚ B] {φ ψ : A →ₐ[ℚ] B}
    (ht : φ t = ψ t) (hu : ∀ i, φ (u i) = ψ (u i)) : φ = ψ := by
  have h : φ.comp (Ideal.Quotient.mkₐ ℚ rel) = ψ.comp (Ideal.Quotient.mkₐ ℚ rel) := by
    refine MvPolynomial.algHom_ext fun i ↦ ?_
    cases i with
    | none => exact ht
    | some j => exact hu j
  refine AlgHom.ext fun a ↦ ?_
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
  exact congrArg (fun χ : Pre →ₐ[ℚ] B ↦ χ f) h

/-- The defining relation of `A`. -/
public theorem t_sub_mul_u (i : ℤ) : (t - (i : A)) * u i = 0 := by
  rw [t, u, ← map_intCast (Ideal.Quotient.mk rel) i, ← map_sub, ← map_mul,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- `t` acts on `u_i` by the scalar `i`. -/
public theorem t_mul_u (i : ℤ) : t * u i = (i : A) * u i := by
  have := t_sub_mul_u i
  linear_combination (norm := ring_nf) this

/-! ### Evaluation and the maximal ideals `p_m` -/

/-- A `ℚ`-algebra map out of `ℚ[t, u_i]` killing each `(t - i) u_i` kills the ideal `rel`. -/
private theorem rel_le_ker_of_relations {B : Type*} [CommRing B] [Algebra ℚ B] {φ : Pre →ₐ[ℚ] B}
    (h : ∀ i : ℤ, (φ (MvPolynomial.X none) - (i : B)) * φ (MvPolynomial.X (some i)) = 0) :
    rel ≤ RingHom.ker φ.toRingHom := by
  rw [rel, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  simpa using h i

/-- The `ℚ`-algebra map `ℚ[t, u_i] → ℚ` sending `t` to `m` and every `u_i` to `0`. -/
public def preEv (m : ℤ) : Pre →ₐ[ℚ] ℚ :=
  MvPolynomial.aeval fun i ↦ match i with
    | none => (m : ℚ)
    | some _ => 0

/-- `preEv m` sends `t` to `m`. -/
@[simp]
public theorem preEv_X_none (m : ℤ) : preEv m (MvPolynomial.X none) = (m : ℚ) := by
  simp [preEv]

/-- `preEv m` sends every `u_i` to `0`. -/
@[simp]
public theorem preEv_X_some (m i : ℤ) : preEv m (MvPolynomial.X (some i)) = 0 := by
  simp [preEv]

/-- The relations `(t - i) u_i` lie in the kernel of `preEv m`. -/
public theorem rel_le_ker_preEv (m : ℤ) : rel ≤ RingHom.ker (preEv m).toRingHom := by
  exact rel_le_ker_of_relations fun i ↦ by simp

/-- Evaluation at `m`: the `ℚ`-algebra map `A → ℚ` sending `t` to `m` and every `u_i` to
`0`. -/
public def ev (m : ℤ) : A →ₐ[ℚ] ℚ :=
  Ideal.Quotient.liftₐ rel (preEv m) fun _a ha ↦ rel_le_ker_preEv m ha

/-- `ev m` on the class of a polynomial `f` is `preEv m f`. -/
@[simp]
public theorem ev_mk (m : ℤ) (f : Pre) : ev m (Ideal.Quotient.mk rel f) = preEv m f := rfl

/-- `ev m` sends `t` to `m`. -/
@[simp]
public theorem ev_t (m : ℤ) : ev m t = (m : ℚ) := by simp [t]

/-- `ev m` sends every `u_i` to `0`. -/
@[simp]
public theorem ev_u (m i : ℤ) : ev m (u i) = 0 := by simp [u]

/-- The generators of `p_m`, pulled back to the polynomial ring. -/
public def preGens (m : ℤ) : Set Pre :=
  insert (MvPolynomial.X none - (m : Pre)) (Set.range fun i : ℤ ↦ MvPolynomial.X (some i))

/-- The kernel of evaluation at a point of `ℚ^{Option ℤ}` with `t`-coordinate `m` and all
other coordinates `0` is generated by `t - m` and the `u_i`. -/
public theorem ker_preEv (m : ℤ) :
    RingHom.ker (preEv m).toRingHom = Ideal.span (preGens m) := by
  have hC : ((m : ℤ) : Pre) = MvPolynomial.C ((m : ℤ) : ℚ) :=
    (map_intCast (MvPolynomial.C : ℚ →+* Pre) m).symm
  have key : ∀ g : Pre, g - MvPolynomial.C (preEv m g) ∈ Ideal.span (preGens m) := by
    intro g
    induction g using MvPolynomial.induction_on with
    | C a => simp [preEv]
    | add p q hp hq =>
        have h := Ideal.add_mem _ hp hq
        have e : p + q - MvPolynomial.C (preEv m (p + q)) =
            (p - MvPolynomial.C (preEv m p)) + (q - MvPolynomial.C (preEv m q)) := by
          rw [map_add, MvPolynomial.C_add]; ring
        rwa [e]
    | mul_X p i hp =>
        cases i with
        | none =>
            have h1 : (p - MvPolynomial.C (preEv m p)) * MvPolynomial.X none ∈
                Ideal.span (preGens m) := Ideal.mul_mem_right _ _ hp
            have h2 : MvPolynomial.C (preEv m p) *
                (MvPolynomial.X none - ((m : ℤ) : Pre)) ∈ Ideal.span (preGens m) :=
              Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl rfl))
            have h := Ideal.add_mem _ h1 h2
            have e : p * MvPolynomial.X none -
                MvPolynomial.C (preEv m (p * MvPolynomial.X none)) =
                (p - MvPolynomial.C (preEv m p)) * MvPolynomial.X none +
                  MvPolynomial.C (preEv m p) *
                    (MvPolynomial.X none - ((m : ℤ) : Pre)) := by
              rw [map_mul, preEv_X_none, MvPolynomial.C_mul, hC]
              ring
            rwa [e]
        | some j =>
            have h : p * MvPolynomial.X (some j) ∈ Ideal.span (preGens m) :=
              Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inr ⟨j, rfl⟩))
            have e : p * MvPolynomial.X (some j) -
                MvPolynomial.C (preEv m (p * MvPolynomial.X (some j))) =
                p * MvPolynomial.X (some j) := by
              rw [map_mul, preEv_X_some, mul_zero, map_zero, sub_zero]
            rwa [e]
  refine le_antisymm (fun f hf ↦ ?_) (Ideal.span_le.2 ?_)
  · have h := key f
    rw [RingHom.mem_ker] at hf
    simpa [show preEv m f = 0 from hf] using h
  · rintro x (rfl | ⟨i, rfl⟩) <;> simp [RingHom.mem_ker]

/-- The ideal `p_m = (t - m) + (u_i : i ∈ ℤ)` of `A`. -/
public def pIdeal (m : ℤ) : Ideal A := Ideal.span (insert (t - (m : A)) (Set.range u))

/-- `p_m` is the image in `A` of the ideal of `ℚ[t, u_i]` generated by `t - m` and the `u_i`. -/
public theorem pIdeal_eq_map (m : ℤ) :
    pIdeal m = (Ideal.span (preGens m)).map (Ideal.Quotient.mk rel) := by
  have h1 : Ideal.Quotient.mk rel (MvPolynomial.X none - ((m : ℤ) : Pre)) = t - (m : A) := by
    rw [map_sub, map_intCast]; rfl
  have h2 : (Ideal.Quotient.mk rel ∘ fun i : ℤ ↦ MvPolynomial.X (some i)) = u := rfl
  rw [Ideal.map_span, pIdeal, preGens, Set.image_insert_eq, ← Set.range_comp, h1, h2]

/-- **Statement 2.** `p_m` is the kernel of evaluation at `m`; in particular the quotient map
`A → A ⧸ p_m` is the evaluation `c(t) + Σ c_{i,a} u_i^a ↦ c(m)`. -/
public theorem pIdeal_eq_ker (m : ℤ) : pIdeal m = RingHom.ker (ev m).toRingHom := by
  refine le_antisymm (Ideal.span_le.2 ?_) fun a ha ↦ ?_
  · rintro x (rfl | ⟨i, rfl⟩) <;> simp [RingHom.mem_ker]
  · obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [RingHom.mem_ker] at ha
    rw [pIdeal_eq_map]
    exact Ideal.mem_map_of_mem _ (by rw [← ker_preEv m, RingHom.mem_ker]; exact ha)

/-- Evaluation at `m` is surjective. -/
public theorem ev_surjective (m : ℤ) : Function.Surjective (ev m) := fun q ↦
  ⟨algebraMap ℚ A q, by simp⟩

/-- **Statement 2.** `p_m` is a maximal ideal. -/
instance pIdeal_isMaximal (m : ℤ) : (pIdeal m).IsMaximal := by
  rw [pIdeal_eq_ker]
  exact RingHom.ker_isMaximal_of_surjective (ev m).toRingHom (ev_surjective m)

/-- **Statement 2.** The residue field of `p_m` is `ℚ`. -/
public def residueEquiv (m : ℤ) : (A ⧸ pIdeal m) ≃ₐ[ℚ] ℚ :=
  (Ideal.quotientEquivAlgOfEq ℚ (pIdeal_eq_ker m)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (ev_surjective m))

/-- **Statement 2.** The quotient map `A → A ⧸ p_m ≅ ℚ` is evaluation at `m`. -/
@[simp]
public theorem residueEquiv_mk (m : ℤ) (a : A) :
    residueEquiv m (Ideal.Quotient.mk (pIdeal m) a) = ev m a := rfl

/-- An element lies in `p_m` exactly when its evaluation at `m` vanishes. -/
public theorem mem_pIdeal_iff {m : ℤ} {a : A} : a ∈ pIdeal m ↔ ev m a = 0 := by
  rw [pIdeal_eq_ker, RingHom.mem_ker]; rfl

/-- `p_m ≠ p_n` for `m ≠ n`: the `p_m` are pairwise distinct. -/
public theorem pIdeal_injective : Function.Injective pIdeal := by
  intro m n h
  have h1 : t - (n : A) ∈ pIdeal n := Ideal.subset_span (Or.inl rfl)
  rw [← h, mem_pIdeal_iff] at h1
  simpa [sub_eq_zero] using h1

/-! ### The normal-form model -/

/-- The ambient ring `ℚ[X] × ∏_{i : ℤ} ℚ[X]` of the normal-form model. -/
public abbrev Amb : Type := ℚ[X] × (ℤ → ℚ[X])

/-- The normal forms: pairs `(c, h)` whose `i`-th coordinate agrees with `c(i)` modulo `X`
for every `i`, and equals `c(i)` for all but finitely many `i`. -/
public def nfSet : Set Amb :=
  {x | (∀ i : ℤ, (x.2 i).coeff 0 = x.1.eval (i : ℚ)) ∧
    {i : ℤ | x.2 i ≠ C (x.1.eval (i : ℚ))}.Finite}

/-- Membership in `nfSet`, unfolded. -/
public theorem mem_nfSet {x : Amb} :
    x ∈ nfSet ↔ (∀ i : ℤ, (x.2 i).coeff 0 = x.1.eval (i : ℚ)) ∧
      {i : ℤ | x.2 i ≠ C (x.1.eval (i : ℚ))}.Finite := Iff.rfl

/-- A set of indices at which a normal-form condition can fail is finite as soon as it is
contained in the union of two such sets. -/
public theorem nf_finite {x y z : Amb}
    (hx : {i : ℤ | x.2 i ≠ C (x.1.eval (i : ℚ))}.Finite)
    (hy : {i : ℤ | y.2 i ≠ C (y.1.eval (i : ℚ))}.Finite)
    (hz : ∀ i : ℤ, x.2 i = C (x.1.eval (i : ℚ)) → y.2 i = C (y.1.eval (i : ℚ)) →
      z.2 i = C (z.1.eval (i : ℚ))) :
    {i : ℤ | z.2 i ≠ C (z.1.eval (i : ℚ))}.Finite := by
  refine (hx.union hy).subset fun i hi ↦ ?_
  by_contra hc
  simp only [Set.mem_union, not_or, Set.mem_ofPred_eq, not_not] at hc
  exact hi (hz i hc.1 hc.2)

/-- The normal-form model: the `ℚ`-subalgebra of `ℚ[X] × ∏_{i : ℤ} ℚ[X]` of normal forms.
As a `ℚ[X]`-module it is `ℚ[X] ⊕ ⨁_{i : ℤ} X ℚ[X]`, by `(c, h) ↦ (c, (h i - c(i))_i)`. -/
public def nfSubalgebra : Subalgebra ℚ Amb where
  carrier := nfSet
  zero_mem' := ⟨by simp, by simp⟩
  one_mem' := ⟨by simp, by simp⟩
  add_mem' := fun {x y} hx hy =>
    ⟨fun i ↦ by simp [hx.1 i, hy.1 i], nf_finite hx.2 hy.2 fun i h1 h2 ↦ by
      simp only [Prod.snd_add, Pi.add_apply, Prod.fst_add, Polynomial.eval_add, h1, h2, C_add]⟩
  mul_mem' := fun {x y} hx hy =>
    ⟨fun i ↦ by simp [hx.1 i, hy.1 i], nf_finite hx.2 hy.2 fun i h1 h2 ↦ by
      simp only [Prod.snd_mul, Pi.mul_apply, Prod.fst_mul, Polynomial.eval_mul, h1, h2, C_mul]⟩
  algebraMap_mem' := fun q ↦ ⟨fun i ↦ by simp [Prod.algebraMap_apply], by
    simp [Prod.algebraMap_apply]⟩

/-- Membership in `nfSubalgebra`, unfolded. -/
public theorem mem_nfSubalgebra {x : Amb} :
    x ∈ nfSubalgebra ↔ (∀ i : ℤ, (x.2 i).coeff 0 = x.1.eval (i : ℚ)) ∧
      {i : ℤ | x.2 i ≠ C (x.1.eval (i : ℚ))}.Finite := Iff.rfl

/-- The carrier of the normal-form model. -/
public abbrev Nf : Type := nfSubalgebra

/-- The pair of `ℚ[X] × ∏_{i : ℤ} ℚ[X]` representing `t`. -/
public def ambT : Amb := (X, fun i ↦ C (i : ℚ))

/-- The pair of `ℚ[X] × ∏_{i : ℤ} ℚ[X]` representing `u_i`. -/
public def ambU (i : ℤ) : Amb := (0, Pi.single i X)

/-- The defining relation holds in `ℚ[X] × ∏_{i : ℤ} ℚ[X]`. -/
public theorem ambT_sub_mul_ambU (i : ℤ) : (ambT - (i : Amb)) * ambU i = 0 := by
  have hC : ((i : ℤ) : ℚ[X]) = C ((i : ℤ) : ℚ) := (map_intCast (C : ℚ →+* ℚ[X]) i).symm
  refine Prod.ext (by simp [ambT, ambU]) (funext fun j ↦ ?_)
  rcases eq_or_ne j i with rfl | h
  · simp only [ambT, ambU, Prod.snd_mul, Prod.snd_sub, Pi.mul_apply, Pi.sub_apply,
      Prod.snd_intCast, Pi.intCast_apply, Pi.single_eq_same, Prod.snd_zero, Pi.zero_apply, hC]
    ring
  · simp [ambT, ambU, Pi.single_eq_of_ne h]

/-- The normal form of `t`. -/
public def nfT : Nf := ⟨ambT, mem_nfSubalgebra.mpr ⟨fun i ↦ by simp [ambT], by simp [ambT]⟩⟩

/-- The normal form of `u_i`. -/
public def nfU (i : ℤ) : Nf :=
  ⟨ambU i, mem_nfSubalgebra.mpr ⟨by
    intro j
    rcases eq_or_ne j i with rfl | h
    · simp [ambU]
    · simp [ambU, Pi.single_eq_of_ne h], by
    refine (Set.finite_singleton i).subset fun j hj ↦ ?_
    simp only [Set.mem_ofPred_eq] at hj
    by_contra hji
    exact hj (by simp [ambU, Pi.single_eq_of_ne (by simpa using hji)])⟩⟩

/-- The underlying pair of `nfT` is `ambT`. -/
@[simp]
public theorem coe_nfT : (nfT : Amb) = ambT := rfl

/-- The underlying pair of `nfU i` is `ambU i`. -/
@[simp]
public theorem coe_nfU (i : ℤ) : (nfU i : Amb) = ambU i := rfl

/-- The defining relation holds in the normal-form model. -/
public theorem nfT_sub_mul_nfU (i : ℤ) : (nfT - (i : Nf)) * nfU i = 0 := by
  refine Subtype.ext ?_
  have hi : ((i : Nf) : Amb) = (i : Amb) := by push_cast; rfl
  rw [Subalgebra.coe_mul, Subalgebra.coe_sub, hi, Subalgebra.coe_zero, coe_nfT, coe_nfU]
  exact ambT_sub_mul_ambU i

/-- The images of the variables in the normal-form model: `t ↦ nfT` and `u_i ↦ nfU i`. -/
public def nfVar : Option ℤ → Nf
  | none => nfT
  | some j => nfU j

/-- The relations `(t - i) u_i` lie in the kernel of the evaluation at `nfVar`. -/
public theorem rel_le_ker_nfVar :
    rel ≤ RingHom.ker (MvPolynomial.aeval nfVar : Pre →ₐ[ℚ] Nf).toRingHom := by
  exact rel_le_ker_of_relations fun i ↦ by simpa [nfVar] using nfT_sub_mul_nfU i

/-- The normal-form model map `A → nfSubalgebra`, `t ↦ (X, i ↦ i)`, `u_i ↦ (0, δ_i X)`. -/
public def nfHom : A →ₐ[ℚ] Nf :=
  Ideal.Quotient.liftₐ rel (MvPolynomial.aeval nfVar) fun _ ha ↦ rel_le_ker_nfVar ha

/-- `nfHom` on the class of a polynomial `f` is its evaluation at `nfVar`. -/
public theorem nfHom_mk (f : Pre) :
    nfHom (Ideal.Quotient.mk rel f) = MvPolynomial.aeval nfVar f := rfl

/-- `nfHom` sends `t` to `nfT`. -/
@[simp]
public theorem nfHom_t : nfHom t = nfT := by rw [t, nfHom_mk]; simp [nfVar]

/-- `nfHom` sends `u_i` to `nfU i`. -/
@[simp]
public theorem nfHom_u (i : ℤ) : nfHom (u i) = nfU i := by rw [u, nfHom_mk]; simp [nfVar]

/-- The `i`-th coordinate of the normal form, as a ring homomorphism `A → ℚ[X]`. -/
public def cmp (i : ℤ) : A →+* ℚ[X] :=
  (((Pi.evalRingHom (fun _ : ℤ ↦ ℚ[X]) i).comp
    (RingHom.snd ℚ[X] (ℤ → ℚ[X]))).comp nfSubalgebra.val.toRingHom).comp nfHom.toRingHom

/-- `cmp i a` is the `i`-th coordinate of the normal form of `a`. -/
public theorem cmp_apply (i : ℤ) (a : A) : cmp i a = (nfHom a : Amb).2 i := rfl

/-- The `i`-th coordinate of the normal form of `u_i` is `X`. -/
@[simp]
public theorem cmp_u_self (i : ℤ) : cmp i (u i) = X := by
  simp [cmp_apply, ambU]

/-- For `j ≠ i` the `j`-th coordinate of the normal form of `u_i` is `0`. -/
@[simp]
public theorem cmp_u_of_ne {i j : ℤ} (h : j ≠ i) : cmp j (u i) = 0 := by
  simp [cmp_apply, ambU, Pi.single_eq_of_ne h]

/-- The `i`-th coordinate of the normal form of `t` is the constant `i`. -/
@[simp]
public theorem cmp_t (i : ℤ) : cmp i t = C (i : ℚ) := by
  simp [cmp_apply, ambT]

/-- The polynomial coordinate of the normal form, evaluated at `i`, as a `ℚ`-algebra map. -/
public def fstEv (i : ℤ) : A →ₐ[ℚ] ℚ :=
  (Polynomial.aeval (i : ℚ)).comp
    ((AlgHom.fst ℚ ℚ[X] (ℤ → ℚ[X])).comp (nfSubalgebra.val.comp nfHom))

/-- The polynomial coordinate of the normal form, evaluated at `i`, is evaluation at `i`. -/
public theorem fstEv_eq (i : ℤ) : fstEv i = ev i := by
  refine algHom_ext' ?_ fun j ↦ ?_
  · simp [fstEv, ambT]
  · simp [fstEv, ambU]

/-- **Statement 1.** The `i`-th coordinate of the normal form of `a` has constant term
`ev i a`: writing `a = c(t) + Σ c_{j,b} u_j^b`, the `i`-th coordinate is
`c(i) + Σ_b c_{i,b} X^b`. -/
public theorem coeff_zero_cmp (i : ℤ) (a : A) : (cmp i a).coeff 0 = ev i a := by
  have h := (nfHom a).2.1 i
  rw [cmp_apply, h, ← fstEv_eq i]
  simp [fstEv]

/-! ### Statement 1: the relations and the non-vanishing -/

/-- **Statement 1.** `(i - j) u_i u_j = 0`. -/
public theorem intCast_sub_mul_u_mul_u (i j : ℤ) :
    ((i : A) - (j : A)) * (u i * u j) = 0 := by
  have h1 : t * u i * u j = (i : A) * (u i * u j) := by
    rw [t_mul_u i]; ring
  have h2 : t * u j * u i = (j : A) * (u i * u j) := by
    rw [t_mul_u j]; ring
  have h3 : t * u i * u j = t * u j * u i := by ring
  rw [h1, h2] at h3
  linear_combination (norm := ring_nf) h3

/-- **Statement 1.** Mixed monomials vanish: `u_i u_j = 0` for `i ≠ j`. -/
public theorem u_mul_u {i j : ℤ} (h : i ≠ j) : u i * u j = 0 := by
  have hq : ((i : ℚ) - (j : ℚ)) ≠ 0 := by
    simpa [sub_eq_zero, Int.cast_injective.eq_iff] using h
  have hunit : IsUnit ((i : A) - (j : A)) := by
    have : ((i : A) - (j : A)) = algebraMap ℚ A ((i : ℚ) - (j : ℚ)) := by
      rw [map_sub, map_intCast, map_intCast]
    rw [this]
    exact (IsUnit.mk0 _ hq).map (algebraMap ℚ A)
  exact hunit.mul_left_cancel (by simpa using intCast_sub_mul_u_mul_u i j)

/-- **Statement 1.** `u_i^a` is killed by `t - i` for `a ≥ 1`. -/
public theorem t_sub_mul_u_pow (i : ℤ) {a : ℕ} (ha : 1 ≤ a) :
    (t - (i : A)) * u i ^ a = 0 := by
  obtain ⟨b, rfl⟩ : ∃ b, a = b + 1 := ⟨a - 1, by omega⟩
  rw [pow_succ, ← mul_assoc, mul_comm (t - (i : A)) (u i ^ b), mul_assoc, t_sub_mul_u i,
    mul_zero]

/-- **Statement 1.** `u_i^a ≠ 0`. -/
public theorem u_pow_ne_zero (i : ℤ) (a : ℕ) : u i ^ a ≠ 0 := by
  intro h
  have : cmp i (u i ^ a) = 0 := by rw [h, map_zero]
  rw [map_pow, cmp_u_self] at this
  exact pow_ne_zero a (Polynomial.X_ne_zero (R := ℚ)) this

/-! ### Statement 1: existence of the normal form -/

/-- The monomials of the normal form: `t^n` for `n : ℕ`, and `u_i^a` for `i : ℤ` and
`a ≥ 1`. -/
public def nfMonomial : ℕ ⊕ ℤ × ℕ → A
  | .inl n => t ^ n
  | .inr (i, a) => u i ^ (a + 1)

/-- `t` acts on `u_i^a` by the scalar `i` for `a ≥ 1`, so `t^n` does so by `i^n`. -/
public theorem t_pow_mul_u_pow (n : ℕ) (i : ℤ) (b : ℕ) :
    t ^ n * u i ^ (b + 1) = (i : A) ^ n * u i ^ (b + 1) := by
  have h1 : t * u i ^ (b + 1) = (i : A) * u i ^ (b + 1) := by
    have h := t_sub_mul_u_pow i (a := b + 1) (by omega)
    linear_combination (norm := ring_nf) h
  induction n with
  | zero => simp
  | succ k ih =>
      rw [pow_succ', mul_assoc, ih, mul_left_comm, h1]
      ring

/-- `u_i^a u_j^b = 0` for `i ≠ j` and `a, b ≥ 1`. -/
public theorem u_pow_mul_u_pow {i j : ℤ} (h : i ≠ j) (a b : ℕ) :
    u i ^ (a + 1) * u j ^ (b + 1) = 0 := by
  have e : u i ^ (a + 1) * u j ^ (b + 1) = u i ^ a * u j ^ b * (u i * u j) := by ring
  rw [e, u_mul_u h, mul_zero]

/-- The `ℚ`-span of the normal-form monomials is closed under multiplication by each
variable. -/
public theorem span_nfMonomial_mul_mem (v : Option ℤ) {x : A}
    (hx : x ∈ Submodule.span ℚ (Set.range nfMonomial)) :
    x * Ideal.Quotient.mk rel (MvPolynomial.X v) ∈
      Submodule.span ℚ (Set.range nfMonomial) := by
  induction hx using Submodule.span_induction with
  | zero => simp
  | add c d _ _ hc hd => rw [add_mul]; exact Submodule.add_mem _ hc hd
  | smul q c _ hc => rw [smul_mul_assoc]; exact Submodule.smul_mem _ q hc
  | mem y hy =>
      obtain ⟨k, rfl⟩ := hy
      have hsmul : ∀ (q : ℚ) (y : A), algebraMap ℚ A q * y = q • y := fun q y ↦
        (Algebra.smul_def q y).symm
      cases k with
      | inl n =>
          cases v with
          | none =>
              refine Submodule.subset_span ⟨Sum.inl (n + 1), ?_⟩
              change t ^ (n + 1) = t ^ n * t
              ring
          | some j =>
              have e : nfMonomial (Sum.inl n) *
                  Ideal.Quotient.mk rel (MvPolynomial.X (some j)) =
                  ((j : ℚ) ^ n) • nfMonomial (Sum.inr (j, 0)) := by
                change t ^ n * u j = _
                rw [show u j = u j ^ (0 + 1) by ring, t_pow_mul_u_pow n j 0,
                  show nfMonomial (Sum.inr (j, 0)) = u j ^ (0 + 1) from rfl, ← hsmul,
                  map_pow, map_intCast]
              rw [e]
              exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inr (j, 0), rfl⟩)
      | inr ia =>
          obtain ⟨i, a⟩ := ia
          cases v with
          | none =>
              have e : nfMonomial (Sum.inr (i, a)) *
                  Ideal.Quotient.mk rel (MvPolynomial.X (none : Option ℤ)) =
                  (i : ℚ) • nfMonomial (Sum.inr (i, a)) := by
                change u i ^ (a + 1) * t = _
                rw [show u i ^ (a + 1) * t = t ^ 1 * u i ^ (a + 1) by ring,
                  t_pow_mul_u_pow 1 i a,
                  show nfMonomial (Sum.inr (i, a)) = u i ^ (a + 1) from rfl, ← hsmul,
                  map_intCast, pow_one]
              rw [e]
              exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inr (i, a), rfl⟩)
          | some j =>
              rcases eq_or_ne i j with rfl | hij
              · refine Submodule.subset_span ⟨Sum.inr (i, a + 1), ?_⟩
                change u i ^ (a + 1 + 1) = u i ^ (a + 1) * u i
                ring
              · have e : nfMonomial (Sum.inr (i, a)) *
                    Ideal.Quotient.mk rel (MvPolynomial.X (some j)) = 0 := by
                  change u i ^ (a + 1) * u j = _
                  rw [show u j = u j ^ (0 + 1) by ring]
                  exact u_pow_mul_u_pow hij a 0
                rw [e]
                exact Submodule.zero_mem _

/-- **Statement 1.** Existence of the normal form: every element of `A` is a `ℚ`-linear
combination of the monomials `t^n` and `u_i^a` with `a ≥ 1`. -/
public theorem span_nfMonomial : Submodule.span ℚ (Set.range nfMonomial) = ⊤ := by
  rw [eq_top_iff]
  rintro a -
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
  induction f using MvPolynomial.induction_on with
  | C q =>
      have h1 : Ideal.Quotient.mk rel (MvPolynomial.C q) = q • (1 : A) := by
        rw [Algebra.smul_def, mul_one]; rfl
      rw [h1]
      refine Submodule.smul_mem _ q (Submodule.subset_span ⟨Sum.inl 0, ?_⟩)
      change t ^ 0 = (1 : A)
      exact pow_zero t
  | add p q hp hq => rw [map_add]; exact Submodule.add_mem _ hp hq
  | mul_X p i hp => rw [map_mul]; exact span_nfMonomial_mul_mem i hp

/-! ### Statement 3: the ideal `I` and the localizations -/

/-- The ideal `I = (u_i : i ≥ 1)`, generated by the variables of positive index only. -/
public def posIdeal : Ideal A := Ideal.span (u '' {i : ℤ | 1 ≤ i})

/-- The module `F = A ⧸ I`. -/
public abbrev F : Type := A ⧸ posIdeal

/-- The local ring `A_{p_m}`. -/
public abbrev Aloc (m : ℤ) : Type := Localization.AtPrime (pIdeal m)

/-- The ideal `I A_{p_m}`. -/
public def J (m : ℤ) : Ideal (Aloc m) := posIdeal.map (algebraMap A (Aloc m))

/-- For `i ≠ m` the element `t - i` lies outside `p_m`. -/
public theorem notMem_pIdeal_t_sub {m i : ℤ} (h : i ≠ m) :
    t - (i : A) ∈ (pIdeal m).primeCompl := by
  simp only [Ideal.primeCompl, Submonoid.mem_mk, Subsemigroup.mem_mk, Set.mem_compl_iff,
    SetLike.mem_coe]
  rw [mem_pIdeal_iff]
  simp only [map_sub, ev_t, map_intCast, sub_eq_zero]
  exact fun hc ↦ h (by exact_mod_cast hc.symm)

/-- For `i ≠ m` the element `u_i` vanishes in `A_{p_m}`. -/
public theorem algebraMap_u_eq_zero {m i : ℤ} (h : i ≠ m) :
    algebraMap A (Aloc m) (u i) = 0 := by
  have hunit : IsUnit (algebraMap A (Aloc m) (t - (i : A))) :=
    IsLocalization.map_units (Aloc m) ⟨_, notMem_pIdeal_t_sub h⟩
  have h0 : algebraMap A (Aloc m) (t - (i : A)) * algebraMap A (Aloc m) (u i) = 0 := by
    rw [← map_mul, t_sub_mul_u i, map_zero]
  exact (hunit.mul_right_eq_zero).mp h0

/-- **Statement 3(a).** For `m ≤ 0` the ideal `I` localizes to zero at `p_m`. -/
public theorem J_eq_bot {m : ℤ} (hm : m ≤ 0) : J m = ⊥ := by
  rw [J, posIdeal, Ideal.map_span, Ideal.span_eq_bot]
  rintro x ⟨y, ⟨i, hi, rfl⟩, rfl⟩
  simp only [Set.mem_ofPred_eq] at hi
  exact algebraMap_u_eq_zero (by omega)

/-- **Statement 3(b).** For `m ≥ 1` the ideal `I` localizes to the principal ideal generated
by `u_m` at `p_m`. -/
public theorem J_eq_span_singleton {m : ℤ} (hm : 1 ≤ m) :
    J m = Ideal.span {algebraMap A (Aloc m) (u m)} := by
  rw [J, posIdeal, Ideal.map_span]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro x ⟨y, ⟨i, hi, rfl⟩, rfl⟩
    rcases eq_or_ne i m with rfl | h
    · exact Ideal.subset_span rfl
    · rw [algebraMap_u_eq_zero h]
      exact Submodule.zero_mem _
  · rintro x rfl
    exact Ideal.subset_span ⟨u m, ⟨m, hm, rfl⟩, rfl⟩

/-- If `s` and `s'` are not in `p_m`, then `s' (u_m s - u_m^2 a) ≠ 0` for every `a : A`. -/
public theorem key {m : ℤ} {a s s' : A} (hs : ev m s ≠ 0) (hs' : ev m s' ≠ 0) :
    s' * (u m * s - u m * u m * a) ≠ 0 := by
  intro h
  have h0 : cmp m (s' * (u m * s - u m * u m * a)) = 0 := by rw [h, map_zero]
  rw [map_mul, map_sub, map_mul, map_mul, map_mul, cmp_u_self] at h0
  have hs'0 : cmp m s' ≠ 0 := fun hc ↦ hs' (by
    rw [← coeff_zero_cmp m s', hc, Polynomial.coeff_zero])
  have h1 : X * cmp m s - X * X * cmp m a = 0 := (mul_eq_zero.mp h0).resolve_left hs'0
  have h2 : X * (cmp m s - X * cmp m a) = 0 := by linear_combination (norm := ring_nf) h1
  have h3 : cmp m s - X * cmp m a = 0 :=
    (mul_eq_zero.mp h2).resolve_left (Polynomial.X_ne_zero (R := ℚ))
  have h4 : cmp m s = X * cmp m a := by linear_combination (norm := ring_nf) h3
  rw [← coeff_zero_cmp m s, h4] at hs
  exact hs (by simp [Polynomial.mul_coeff_zero])

/-- **Statement 3(b).** For `m ≥ 1` the generator `u_m` of `I A_{p_m}` is not a multiple of
`u_m^2`: this is the failure of `J = J^2`. -/
public theorem u_notMem_sq (m : ℤ) :
    algebraMap A (Aloc m) (u m) ∉
      Ideal.span {algebraMap A (Aloc m) (u m) * algebraMap A (Aloc m) (u m)} := by
  intro hmem
  obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hmem
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (pIdeal m).primeCompl z
  have hz' : IsLocalization.mk' (Aloc m) a s *
      (algebraMap A (Aloc m) (u m) * algebraMap A (Aloc m) (u m)) =
      algebraMap A (Aloc m) (u m) := hz
  have hspec : IsLocalization.mk' (Aloc m) a s * algebraMap A (Aloc m) (s : A) =
      algebraMap A (Aloc m) a := IsLocalization.mk'_spec _ a s
  have hzero : algebraMap A (Aloc m) (u m * (s : A) - u m * u m * a) = 0 := by
    rw [map_sub, map_mul, map_mul, map_mul]
    linear_combination (algebraMap A (Aloc m) (u m) * algebraMap A (Aloc m) (u m)) * hspec -
      algebraMap A (Aloc m) (s : A) * hz'
  obtain ⟨s', hs'⟩ := (IsLocalization.map_eq_zero_iff (pIdeal m).primeCompl (Aloc m) _).mp hzero
  exact key (fun hc ↦ s.2 (mem_pIdeal_iff.mpr hc)) (fun hc ↦ s'.2 (mem_pIdeal_iff.mpr hc)) hs'

/-! ### Flatness of the localized fibre -/

/-- Localizing `R ⧸ I` at a prime `p` gives `R_p ⧸ I R_p`, so flatness of the localized
quotient is purity of the extended ideal. -/
public theorem flat_localizedModule_quotient_iff {R : Type*} [CommRing R] (p : Ideal R)
    [p.IsPrime] (I : Ideal R) :
    Module.Flat (Localization.AtPrime p) (LocalizedModule p.primeCompl (R ⧸ I)) ↔
      (I.map (algebraMap R (Localization.AtPrime p))).Pure :=
  Module.Flat.equiv_iff
    ((LocalizedModule.equivTensorProduct p.primeCompl (R ⧸ I)).trans
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot
        (Localization.AtPrime p) I).toLinearEquiv.symm)

/-- Flatness of `F` localized at a prime of `A`. -/
public def IsFlatAt (x : PrimeSpectrum A) : Prop :=
  Module.Flat (Localization.AtPrime x.asIdeal) (LocalizedModule x.asIdeal.primeCompl F)

/-- The point `p_m` of `Spec A`. -/
public def pt (m : ℤ) : PrimeSpectrum A := ⟨pIdeal m, inferInstance⟩

/-- The points `p_m` of `Spec A` are pairwise distinct. -/
public theorem pt_injective : Function.Injective pt := fun _ _ h ↦
  pIdeal_injective congr(($h).asIdeal)

/-- `F` localized at `p_m` is flat over `A_{p_m}` exactly when the ideal `I A_{p_m}` is pure. -/
public theorem isFlatAt_pt_iff (m : ℤ) : IsFlatAt (pt m) ↔ (J m).Pure :=
  flat_localizedModule_quotient_iff (pIdeal m) posIdeal

/-- **Statement 3(a).** For `m ≤ 0`, `F` localized at `p_m` is flat over `A_{p_m}`. -/
public theorem isFlatAt_pt_of_nonpos {m : ℤ} (hm : m ≤ 0) : IsFlatAt (pt m) := by
  rw [isFlatAt_pt_iff, Ideal.Pure]
  exact Module.Flat.of_linearEquiv (Submodule.quotEquivOfEqBot _ (J_eq_bot hm))

/-- **Statement 3(c).** For `m ≥ 1`, `F` localized at `p_m` is **not** flat over `A_{p_m}`. -/
public theorem not_isFlatAt_pt_of_pos {m : ℤ} (hm : 1 ≤ m) : ¬ IsFlatAt (pt m) := by
  rw [isFlatAt_pt_iff]
  intro hpure
  have hJ : J m = Ideal.span {algebraMap A (Aloc m) (u m)} := J_eq_span_singleton hm
  have hvJ : algebraMap A (Aloc m) (u m) ∈ J m := by rw [hJ]; exact Ideal.subset_span rfl
  obtain ⟨y, hyJ, hy⟩ := Ideal.exists_eq_mul_of_pure (I := J m) hvJ
  rw [hJ] at hyJ
  obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hyJ
  refine u_notMem_sq m (Ideal.mem_span_singleton'.mpr ⟨z, ?_⟩)
  rw [← hz] at hy
  linear_combination (norm := ring_nf) -hy

/-! ### Statement 4: the specialization -/

/-- **Statement 4.** `p_0` lies in the closure of `{p_m : m ≥ 1}`. -/
public theorem pt_zero_mem_closure : pt 0 ∈ closure (pt '' {m : ℤ | 1 ≤ m}) := by
  rw [← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, PrimeSpectrum.mem_zeroLocus]
  intro a ha
  rw [SetLike.mem_coe, PrimeSpectrum.mem_vanishingIdeal] at ha
  have hev : ∀ m : ℤ, 1 ≤ m → ev m a = 0 := fun m hm ↦
    mem_pIdeal_iff.mp (ha (pt m) ⟨m, hm, rfl⟩)
  have hcroot : ∀ m : ℤ, 1 ≤ m → ((nfHom a : Amb).1).IsRoot ((m : ℤ) : ℚ) := by
    intro m hm
    have h1 : (cmp m a).coeff 0 = ev m a := coeff_zero_cmp m a
    have h2 : (cmp m a).coeff 0 = ((nfHom a : Amb).1).eval ((m : ℤ) : ℚ) := (nfHom a).2.1 m
    rw [Polynomial.IsRoot, ← h2, h1, hev m hm]
  have hinf : {x : ℚ | ((nfHom a : Amb).1).IsRoot x}.Infinite :=
    Set.Infinite.mono (s := (fun m : ℤ ↦ ((m : ℤ) : ℚ)) '' {m : ℤ | 1 ≤ m})
      (by rintro x ⟨m, hm, rfl⟩; exact hcroot m hm)
      (Set.Infinite.image (fun x _ y _ h ↦ by exact_mod_cast h) (Set.Ici_infinite (1 : ℤ)))
  have hc0 : (nfHom a : Amb).1 = 0 :=
    Polynomial.eq_zero_of_infinite_isRoot _ hinf
  have h2 : (cmp 0 a).coeff 0 = ((nfHom a : Amb).1).eval ((0 : ℤ) : ℚ) := (nfHom a).2.1 0
  exact mem_pIdeal_iff.mpr (by rw [← coeff_zero_cmp 0 a, h2, hc0, Polynomial.eval_zero])

/-! ### Statement 5: the flat locus is not open -/

/-- **Statement 5.** The set of `m : ℤ` at which `F` localized at `p_m` is flat over
`A_{p_m}` is exactly `{m : m ≤ 0}`. -/
public theorem setOf_isFlatAt_pt : {m : ℤ | IsFlatAt (pt m)} = {m : ℤ | m ≤ 0} := by
  ext m
  simp only [Set.mem_ofPred_eq]
  refine ⟨fun h ↦ ?_, isFlatAt_pt_of_nonpos⟩
  by_contra hc
  exact not_isFlatAt_pt_of_pos (by omega) h

/-- The subspace `{p_m : m : ℤ}` of `Spec A`. -/
public def ptSet : Set (PrimeSpectrum A) := Set.range pt

/-- **Statement 5.** The flat locus of `F` is **not open** in the subspace
`{p_m : m : ℤ}` of `Spec A`. -/
public theorem not_isOpen_flatLocus : ¬ IsOpen {x : ptSet | IsFlatAt x.1} := by
  intro hopen
  obtain ⟨V, hV, hVW⟩ := isOpen_induced_iff.mp hopen
  have h0 : (⟨pt 0, ⟨0, rfl⟩⟩ : ptSet) ∈ {x : ptSet | IsFlatAt x.1} :=
    isFlatAt_pt_of_nonpos le_rfl
  have h0V : pt 0 ∈ V := by
    rw [← hVW] at h0
    exact h0
  obtain ⟨x, hxV, m, hm, hxm⟩ := mem_closure_iff.mp pt_zero_mem_closure V hV h0V
  have hmV : pt m ∈ V := by rw [hxm]; exact hxV
  have hmem : (⟨pt m, ⟨m, rfl⟩⟩ : ptSet) ∈ {x : ptSet | IsFlatAt x.1} := by
    rw [← hVW]
    exact hmV
  exact not_isFlatAt_pt_of_pos hm hmem

/-! ### The integer shift

The `ℤ`-action on `A` for which `{p_m : m : ℤ}` is a single free orbit: `σ_n` sends `t` to
`t - n` and `u_i` to `u_{i + n}`, hence `p_m` to `p_{m - n}`. It translates `t` and reindexes the
`u_i` in opposite directions, since `σ_n((t - i) u_i) = (t - n - i) u_{i + n}` is the relation at
index `i + n`. -/

/-- The images of the variables under the shift by `n`: `t ↦ t - n` and `u_i ↦ u_{i + n}`. -/
public def shiftVar (n : ℤ) : Option ℤ → A
  | none => t - (n : A)
  | some j => u (j + n)

/-- The relations `(t - i) u_i` lie in the kernel of the evaluation at `shiftVar n`. -/
public theorem rel_le_ker_shiftVar (n : ℤ) :
    rel ≤ RingHom.ker (MvPolynomial.aeval (shiftVar n) : Pre →ₐ[ℚ] A).toRingHom := by
  refine rel_le_ker_of_relations fun i ↦ ?_
  have h : shiftVar n none - (i : A) = t - ((i + n : ℤ) : A) := by
    change t - (n : A) - (i : A) = _
    push_cast
    ring
  simp only [MvPolynomial.aeval_X]
  rw [h, show shiftVar n (some i) = u (i + n) from rfl]
  exact t_sub_mul_u (i + n)

/-- The shift by `n` on `A`: `t ↦ t - n` and `u_i ↦ u_{i + n}`. -/
public def shift (n : ℤ) : A →ₐ[ℚ] A :=
  Ideal.Quotient.liftₐ rel (MvPolynomial.aeval (shiftVar n))
    fun _ ha ↦ rel_le_ker_shiftVar n ha

/-- `shift n` on the class of a polynomial `f` is its evaluation at `shiftVar n`. -/
public theorem shift_mk (n : ℤ) (f : Pre) :
    shift n (Ideal.Quotient.mk rel f) = MvPolynomial.aeval (shiftVar n) f := rfl

/-- The shift by `n` sends `t` to `t - n`. -/
@[simp]
public theorem shift_t (n : ℤ) : shift n t = t - (n : A) := by
  change MvPolynomial.aeval (shiftVar n) (MvPolynomial.X (none : Option ℤ)) = t - (n : A)
  simp [shiftVar]

/-- The shift by `n` sends `u_i` to `u_{i + n}`. -/
@[simp]
public theorem shift_u (n i : ℤ) : shift n (u i) = u (i + n) := by
  change MvPolynomial.aeval (shiftVar n) (MvPolynomial.X (some i)) = u (i + n)
  simp [shiftVar]

/-- The shift by `0` is the identity. -/
public theorem shift_zero : shift 0 = AlgHom.id ℚ A := by
  refine algHom_ext' ?_ fun i ↦ ?_ <;> simp

/-- The shifts compose: `shift m ∘ shift n = shift (m + n)`. -/
public theorem shift_comp (m n : ℤ) : (shift m).comp (shift n) = shift (m + n) := by
  refine algHom_ext' ?_ fun i ↦ ?_
  · simp only [AlgHom.coe_comp, Function.comp_apply, shift_t, map_sub, map_intCast]
    push_cast
    ring
  · simp only [AlgHom.coe_comp, Function.comp_apply, shift_u]
    congr 1
    ring

/-- The shift by `n` is an automorphism of `A`. -/
public def shiftEquiv (n : ℤ) : A ≃ₐ[ℚ] A :=
  AlgEquiv.ofAlgHom (shift n) (shift (-n))
    (by rw [shift_comp]; simpa using shift_zero)
    (by rw [shift_comp]; simpa using shift_zero)

/-- `shiftEquiv n` applies the shift by `n`. -/
@[simp]
public theorem shiftEquiv_apply (n : ℤ) (a : A) : shiftEquiv n a = shift n a := rfl

/-- Evaluation at `m` precomposed with the shift by `n` is evaluation at `m - n`. -/
public theorem ev_comp_shift (m n : ℤ) : (ev m).comp (shift n) = ev (m - n) := by
  refine algHom_ext' ?_ fun i ↦ ?_
  · simp only [AlgHom.coe_comp, Function.comp_apply, shift_t, map_sub, map_intCast, ev_t]
    push_cast
    ring
  · simp

/-- The shift by `n` carries `p_{m - n}` back to `p_m`: the `p_m` form a single orbit of the
integer action. -/
public theorem comap_shift_pIdeal (m n : ℤ) :
    Ideal.comap (shift n).toRingHom (pIdeal m) = pIdeal (m - n) := by
  ext a
  simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, mem_pIdeal_iff]
  rw [show ev m (shift n a) = (ev (m - n)) a from congrArg (fun φ : A →ₐ[ℚ] ℚ ↦ φ a)
    (ev_comp_shift m n)]

/-- In the prime spectrum: the shift by `n` carries `p_m` to `p_{m - n}`. -/
public theorem comap_shift_pt (m n : ℤ) :
    PrimeSpectrum.comap (shift n).toRingHom (pt m) = pt (m - n) :=
  PrimeSpectrum.ext (comap_shift_pIdeal m n)

/-- The integer action is **free** on `{p_m : m : ℤ}`: no nonzero shift fixes any `p_m`. -/
public theorem comap_shift_pt_ne {n : ℤ} (hn : n ≠ 0) (m : ℤ) :
    PrimeSpectrum.comap (shift n).toRingHom (pt m) ≠ pt m := by
  rw [comap_shift_pt]
  intro h
  have := pt_injective h
  omega

end Stacks.Examples.NonOpenFlatLocus

