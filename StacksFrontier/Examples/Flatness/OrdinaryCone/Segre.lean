module

public import Mathlib.Algebra.Algebra.Subalgebra.Pointwise
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.Tactic.ComputeDegree
public import StacksFrontier.Algebra.DirectSum.GradedSubmodule
public import StacksFrontier.Examples.Flatness.OrdinaryCone.Cone

/-!
# The Segre product of the ordinary cone with the affine plane

Let `G = k[x, y, z]/(z³ + (y² + xy) z + x³)` be the cone of
`Stacks.Examples.OrdinaryCone.Cone`. The Segre product of `G` with the polynomial ring
`k[s, t]` is the subalgebra `Γ = ⊕_d G_d ⊗ k[s, t]_d` of `G[s, t]` generated by the six
products `xs, xt, ys, yt, zs, zt`. Over a field of characteristic two it is the homogeneous
coordinate ring of the product of an ordinary elliptic curve with the projective line in its
Segre embedding.

We grade `Γ` by `Γ_d = V ^ d`, where `V` is the `k`-span of the six generators; these pieces lie
in the polynomials of degree `d` in `s, t`, which makes the grading a direct sum. Its degree zero
part is `k`.

The map `k[X₀, X₁, X₂] → Γ` sending `X₀ ↦ xs`, `X₁ ↦ yt`, `X₂ ↦ xt + ys` is finite: `xt` and
`ys` are the roots of `T² - X₂ T + X₀ X₁`, and `zs`, `zt` are integral over what `xs, ys`, resp.
`xt, yt`, generate because of the equation of the cone multiplied by `s³`, resp. `t³`. The
elements `xs, xt, ys, yt` and the images of `X₀, X₁, X₂` generate the same ideal up to radical.

## Main definitions

* `Stacks.Examples.OrdinaryCone.segre`: the Segre product `Γ`, a subalgebra of `G[s, t]`.
* `Stacks.Examples.OrdinaryCone.segreElem`: the generators `u v` of `Γ`, for
  `u ∈ {x, y, z}` and `v ∈ {s, t}`.
* `Stacks.Examples.OrdinaryCone.segreGrading`: the grading of `Γ` by total degree.
* `Stacks.Examples.OrdinaryCone.segreBase`: the map `k[X₀, X₁, X₂] → Γ`.
* `Stacks.Examples.OrdinaryCone.segreCover`: the elements `xs, xt, ys, yt`.

## Main results

* `Stacks.Examples.OrdinaryCone.segreGrading.gradedAlgebra`: `Γ` is graded by total degree.
* `Stacks.Examples.OrdinaryCone.segreGrading_zero`: the degree zero part of `Γ` is `k`.
* Over a field `Γ` is a domain, as a subring of the domain `G[s, t]`.
* `Stacks.Examples.OrdinaryCone.segre.finite_base`: `Γ` is finite over `k[X₀, X₁, X₂]`, with
  the algebra structure `segre.algebraBase` given by `segreBase`; the images of the variables
  have degree one by `algebraMap_X_mem_segreGrading`.
* `Stacks.Examples.OrdinaryCone.segreBase_X_mem_span_segreCover` and
  `Stacks.Examples.OrdinaryCone.segreElem_mem_radical`: the cover elements and the images of the
  variables generate the same ideal up to radical.
-/

@[expose] public section

namespace Stacks.Examples.OrdinaryCone

open MvPolynomial

variable (k : Type*) [CommRing k]

/-- The product `u v ∈ G[s, t]` of the coordinate `u = X i` of the cone (`x, y, z` for
`i = 0, 1, 2`) with the variable `v = X j` (`s, t` for `j = 0, 1`). -/
noncomputable def segreGen (i : Fin 3) (j : Fin 2) : MvPolynomial (Fin 2) (Cone k) :=
  C (Ideal.Quotient.mk _ (X i)) * X j

/-- The `k`-span of the six products `xs, xt, ys, yt, zs, zt` in `G[s, t]`. -/
noncomputable def segreSpan : Submodule k (MvPolynomial (Fin 2) (Cone k)) :=
  Submodule.span k (Set.range fun ij : Fin 3 × Fin 2 ↦ segreGen k ij.1 ij.2)

/-- The degree `d` part `G_d ⊗ k[s, t]_d` of the Segre product, the `d`-th power of the span of
the generators. -/
noncomputable def segreComponent (d : ℕ) : Submodule k (MvPolynomial (Fin 2) (Cone k)) :=
  segreSpan k ^ d

/-- The Segre product `Γ = ⊕_d G_d ⊗ k[s, t]_d` of the cone `G` with `k[s, t]`: the subalgebra
of `G[s, t]` generated by `xs, xt, ys, yt, zs, zt`. -/
noncomputable def segre : Subalgebra k (MvPolynomial (Fin 2) (Cone k)) :=
  Algebra.adjoin k (Set.range fun ij : Fin 3 × Fin 2 ↦ segreGen k ij.1 ij.2)

/-- The generator `u v` of the Segre product, for `u ∈ {x, y, z}` and `v ∈ {s, t}`. -/
noncomputable def segreElem (i : Fin 3) (j : Fin 2) : segre k :=
  ⟨segreGen k i j, Algebra.subset_adjoin ⟨(i, j), rfl⟩⟩

/-- The generator `segreElem k i j` is the product `segreGen k i j` in `G[s, t]`. -/
@[simp]
theorem coe_segreElem (i : Fin 3) (j : Fin 2) : (segreElem k i j : MvPolynomial _ _) =
    segreGen k i j :=
  rfl

/-- Each product `segreGen k i j` lies in the span `segreSpan k`. -/
theorem segreGen_mem_segreSpan (i : Fin 3) (j : Fin 2) : segreGen k i j ∈ segreSpan k :=
  Submodule.subset_span ⟨(i, j), rfl⟩

/-- The Segre product is the sum of its components. -/
theorem toSubmodule_segre : Subalgebra.toSubmodule (segre k) = ⨆ d, segreComponent k d := by
  refine le_antisymm ?_ (iSup_le fun d ↦ ?_)
  · let S : Subalgebra k (MvPolynomial (Fin 2) (Cone k)) :=
      (⨆ d, segreComponent k d).toSubalgebra
        (Submodule.mem_iSup_of_mem 0 (by
          rw [segreComponent, pow_zero]; exact Submodule.mem_one.mpr ⟨1, map_one _⟩))
        (fun a b ha hb ↦ by
          induction ha using Submodule.iSup_induction' with
          | mem i a ha =>
            induction hb using Submodule.iSup_induction' with
            | mem j b hb =>
              exact Submodule.mem_iSup_of_mem (i + j)
                (by rw [segreComponent, pow_add]; exact Submodule.mul_mem_mul ha hb)
            | zero => simp
            | add b c _ _ hb hc => rw [mul_add]; exact add_mem hb hc
          | zero => simp
          | add a c _ _ ha hc => rw [add_mul]; exact add_mem ha hc)
    intro x hx
    refine (Algebra.adjoin_le ?_ : segre k ≤ S) hx
    rintro _ ⟨ij, rfl⟩
    exact Submodule.mem_iSup_of_mem 1
      (by rw [segreComponent, pow_one]; exact segreGen_mem_segreSpan k _ _)
  · induction d with
    | zero =>
      rw [segreComponent, pow_zero, ← Algebra.toSubmodule_bot]
      exact fun x hx ↦ (bot_le : (⊥ : Subalgebra k _) ≤ segre k) hx
    | succ d ih =>
      rw [segreComponent, pow_succ]
      refine (mul_le_mul' ih ?_).trans
        ((Subalgebra.mul_toSubmodule_le _ _).trans_eq (by rw [sup_idem]))
      exact Submodule.span_le.mpr fun _ ⟨ij, hij⟩ ↦ hij ▸ Algebra.subset_adjoin ⟨ij, rfl⟩

/-- The components of the Segre product consist of polynomials homogeneous of degree `d` in
`s, t`. -/
theorem segreComponent_le_homogeneous (d : ℕ) :
    segreComponent k d ≤ (homogeneousSubmodule (Fin 2) (Cone k) d).restrictScalars k := by
  induction d with
  | zero =>
    rw [segreComponent, pow_zero, Submodule.one_le]
    exact isHomogeneous_one _ _
  | succ d ih =>
    rw [segreComponent, pow_succ, Submodule.mul_le]
    intro a ha b hb
    have hb : b ∈ (homogeneousSubmodule (Fin 2) (Cone k) 1).restrictScalars k := by
      refine (Submodule.span_le.mpr ?_ : segreSpan k ≤ _) hb
      rintro _ ⟨ij, rfl⟩
      exact isHomogeneous_C_mul_X _ _
    exact (mem_homogeneousSubmodule _ _).mpr
      (((mem_homogeneousSubmodule _ _).mp (ih ha)).mul ((mem_homogeneousSubmodule _ _).mp hb))

/-- The components of the Segre product are independent. -/
theorem iSupIndep_segreComponent : iSupIndep (segreComponent k) := by
  classical
  let := MvPolynomial.gradedAlgebra (σ := Fin 2) (R := Cone k)
  have h := (DirectSum.Decomposition.isInternal
    (homogeneousSubmodule (Fin 2) (Cone k))).submodule_iSupIndep
  rw [iSupIndep_def] at h ⊢
  intro i
  rw [Submodule.disjoint_def]
  intro x hx hx'
  refine Submodule.disjoint_def.mp (h i) x (segreComponent_le_homogeneous k i hx) ?_
  have : (⨆ j, ⨆ (_ : j ≠ i), segreComponent k j) ≤
      (⨆ j, ⨆ (_ : j ≠ i), homogeneousSubmodule (Fin 2) (Cone k) j).restrictScalars k :=
    iSup₂_le fun j hj ↦ (segreComponent_le_homogeneous k j).trans
      (Submodule.restrictScalars_mono _ (le_iSup₂ (f := fun j (_ : j ≠ i) ↦
        homogeneousSubmodule (Fin 2) (Cone k) j) j hj))
  exact this hx'

/-- The grading of the Segre product by total degree. -/
noncomputable def segreGrading (d : ℕ) : Submodule k (segre k) :=
  (segreComponent k d).comap (segre k).val.toLinearMap

/-- An element of the Segre product has degree `d` if and only if it lies in
`segreComponent k d`. -/
theorem mem_segreGrading {d : ℕ} {a : segre k} :
    a ∈ segreGrading k d ↔ (a : MvPolynomial (Fin 2) (Cone k)) ∈ segreComponent k d :=
  Iff.rfl

/-- The generators of the Segre product have degree one. -/
theorem segreElem_mem_segreGrading (i : Fin 3) (j : Fin 2) :
    segreElem k i j ∈ segreGrading k 1 := by
  rw [mem_segreGrading, segreComponent, pow_one]
  exact segreGen_mem_segreSpan k i j

/-- The grading of the Segre product by total degree is multiplicative. -/
instance segreGrading.gradedMonoid : SetLike.GradedMonoid (segreGrading k) where
  one_mem := by
    rw [mem_segreGrading, segreComponent, pow_zero]
    exact Submodule.mem_one.mpr ⟨1, map_one _⟩
  mul_mem i j a b ha hb := by
    rw [mem_segreGrading, Subalgebra.coe_mul, segreComponent, pow_add]
    exact Submodule.mul_mem_mul ha hb

/-- The Segre product is the internal direct sum of its graded pieces. -/
theorem isInternal_segreGrading : DirectSum.IsInternal (segreGrading k) :=
  DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    (Submodule.inducedGrading_iSupIndep (iSupIndep_segreComponent k)
      (Subalgebra.toSubmodule (segre k)))
    (Submodule.inducedGrading_iSup_eq_top_of_eq_iSup _ (toSubmodule_segre k))

/-- The Segre product is graded by total degree. -/
noncomputable instance segreGrading.gradedAlgebra : GradedAlgebra (segreGrading k) :=
  { (isInternal_segreGrading k).chooseDecomposition with }

/-- The degree zero part of the Segre product is `k`. -/
theorem segreGrading_zero : segreGrading k 0 = 1 := by
  ext a
  simp only [mem_segreGrading, segreComponent, pow_zero, Submodule.mem_one]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨c, Subtype.ext hc⟩
  · rintro ⟨c, rfl⟩
    exact ⟨c, rfl⟩

/-- Over a field `k` the structure map identifies `k` with the degree zero part. -/
theorem algebraMap_segre_injective (k : Type*) [Field k] :
    Function.Injective (algebraMap k (segre k)) :=
  (algebraMap k (segre k)).injective

/-- The generators generate the Segre product. -/
theorem adjoin_segreElem :
    Algebra.adjoin k (Set.range fun ij : Fin 3 × Fin 2 ↦ segreElem k ij.1 ij.2) = ⊤ := by
  apply Subalgebra.map_injective (f := (segre k).val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val, ← Set.range_comp]
  rfl

/-- The Segre product is a finitely generated `k`-algebra. -/
instance segre.finiteType : Algebra.FiniteType k (segre k) :=
  ⟨Subalgebra.fg_def.mpr ⟨_, Set.finite_range _, adjoin_segreElem k⟩⟩

/-- The quadratic relation `(xt)² - (xt + ys) xt + xs yt = 0`. -/
theorem segreElem_zero_one_sq :
    segreElem k 0 1 ^ 2 - (segreElem k 0 1 + segreElem k 1 0) * segreElem k 0 1 +
      segreElem k 0 0 * segreElem k 1 1 = 0 := by
  apply Subtype.ext
  simp only [Subalgebra.coe_add, Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_pow,
    coe_segreElem, segreGen, Subalgebra.coe_zero]
  ring

/-- The quadratic relation `(ys)² - (xt + ys) ys + xs yt = 0`. -/
theorem segreElem_one_zero_sq :
    segreElem k 1 0 ^ 2 - (segreElem k 0 1 + segreElem k 1 0) * segreElem k 1 0 +
      segreElem k 0 0 * segreElem k 1 1 = 0 := by
  apply Subtype.ext
  simp only [Subalgebra.coe_add, Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_pow,
    coe_segreElem, segreGen, Subalgebra.coe_zero]
  ring

/-- The cubic relation `(zv)³ + ((yv)² + (xv)(yv)) zv + (xv)³ = 0` for `v ∈ {s, t}`, the
equation of the cone multiplied by `v³`. -/
theorem segreElem_cubic (j : Fin 2) :
    segreElem k 2 j ^ 3 + (segreElem k 1 j ^ 2 + segreElem k 0 j * segreElem k 1 j) *
      segreElem k 2 j + segreElem k 0 j ^ 3 = 0 := by
  apply Subtype.ext
  have h := congrArg (C (σ := Fin 2)) (Cone.equation_eq_zero k)
  simp only [map_add, map_mul, map_pow, map_zero, Cone.x, Cone.y, Cone.z] at h
  simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow, coe_segreElem,
    segreGen, Subalgebra.coe_zero]
  linear_combination (X j : MvPolynomial (Fin 2) (Cone k)) ^ 3 * h

/-- The map `k[X₀, X₁, X₂] → Γ` sending `X₀ ↦ xs`, `X₁ ↦ yt` and `X₂ ↦ xt + ys`. -/
noncomputable def segreBase : MvPolynomial (Fin 3) k →ₐ[k] segre k :=
  aeval ![segreElem k 0 0, segreElem k 1 1, segreElem k 0 1 + segreElem k 1 0]

/-- The map `segreBase` sends `X₀` to `xs`. -/
@[simp]
theorem segreBase_X_zero : segreBase k (X 0) = segreElem k 0 0 := by
  simp [segreBase]

/-- The map `segreBase` sends `X₁` to `yt`. -/
@[simp]
theorem segreBase_X_one : segreBase k (X 1) = segreElem k 1 1 := by
  simp [segreBase]

/-- The map `segreBase` sends `X₂` to `xt + ys`. -/
@[simp]
theorem segreBase_X_two : segreBase k (X 2) = segreElem k 0 1 + segreElem k 1 0 := by
  simp [segreBase]

/-- A root of a monic polynomial `X ^ n + a X + b` with integral coefficients is integral. -/
private theorem isIntegral_of_pow_add_mul_add {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] {x a b : S} {n : ℕ} (hn : 1 < n) (ha : IsIntegral R a) (hb : IsIntegral R b)
    (h : x ^ n + a * x + b = 0) : IsIntegral R x := by
  refine isIntegral_trans (A := integralClosure R S) x ⟨Polynomial.X ^ n +
    Polynomial.C (⟨a, ha⟩ : integralClosure R S) * Polynomial.X + Polynomial.C ⟨b, hb⟩,
    by monicity!; simp [hn.le, hn.not_ge], ?_⟩
  simpa using h

private theorem isIntegral_of_sq_add_mul_add {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] {x a b : S} (ha : IsIntegral R a) (hb : IsIntegral R b)
    (h : x ^ 2 + a * x + b = 0) : IsIntegral R x :=
  isIntegral_of_pow_add_mul_add one_lt_two ha hb h

private theorem isIntegral_of_cube_add_mul_add {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] {x a b : S} (ha : IsIntegral R a) (hb : IsIntegral R b)
    (h : x ^ 3 + a * x + b = 0) : IsIntegral R x :=
  isIntegral_of_pow_add_mul_add (by norm_num) ha hb h

/-- The Segre product as an algebra over `k[X₀, X₁, X₂]` through `segreBase`. -/
noncomputable instance segre.algebraBase : Algebra (MvPolynomial (Fin 3) k) (segre k) :=
  (segreBase k).toAlgebra

/-- The structure map `k[X₀, X₁, X₂] → Γ` is `segreBase`. -/
theorem algebraMap_segre_apply (p : MvPolynomial (Fin 3) k) :
    algebraMap (MvPolynomial (Fin 3) k) (segre k) p = segreBase k p :=
  rfl

/-- The algebra structures of the Segre product over `k` and over `k[X₀, X₁, X₂]` are
compatible. -/
instance segre.isScalarTower_base : IsScalarTower k (MvPolynomial (Fin 3) k) (segre k) :=
  IsScalarTower.of_algebraMap_eq fun c ↦ ((segreBase k).commutes c).symm

/-- The images of the variables have degree one. -/
theorem algebraMap_X_mem_segreGrading (i : Fin 3) :
    algebraMap (MvPolynomial (Fin 3) k) (segre k) (X i) ∈ segreGrading k 1 := by
  rw [algebraMap_segre_apply]
  fin_cases i
  · exact (segreBase_X_zero k).symm ▸ segreElem_mem_segreGrading k 0 0
  · exact (segreBase_X_one k).symm ▸ segreElem_mem_segreGrading k 1 1
  · exact (segreBase_X_two k).symm ▸
      add_mem (segreElem_mem_segreGrading k 0 1) (segreElem_mem_segreGrading k 1 0)

/-- The Segre product is finite over `k[X₀, X₁, X₂]`. -/
instance segre.finite_base : Module.Finite (MvPolynomial (Fin 3) k) (segre k) := by
  have hbase (p : MvPolynomial (Fin 3) k) :
      IsIntegral (MvPolynomial (Fin 3) k) (segreBase k p) :=
    isIntegral_algebraMap (A := segre k) (x := p)
  have hxs := segreBase_X_zero k ▸ hbase (X 0)
  have hyt := segreBase_X_one k ▸ hbase (X 1)
  have hX2 := ((segreBase_X_two k) ▸ hbase (X 2)).neg
  have hxt : IsIntegral (MvPolynomial (Fin 3) k) (segreElem k 0 1) :=
    isIntegral_of_sq_add_mul_add hX2 (hxs.mul hyt)
      (by rw [← segreElem_zero_one_sq k]; ring)
  have hys : IsIntegral (MvPolynomial (Fin 3) k) (segreElem k 1 0) :=
    isIntegral_of_sq_add_mul_add hX2 (hxs.mul hyt)
      (by rw [← segreElem_one_zero_sq k]; ring)
  have hgen (i : Fin 3) (j : Fin 2) : IsIntegral (MvPolynomial (Fin 3) k) (segreElem k i j) := by
    have hx (j : Fin 2) : IsIntegral (MvPolynomial (Fin 3) k) (segreElem k 0 j) := by
      fin_cases j
      exacts [hxs, hxt]
    have hy (j : Fin 2) : IsIntegral (MvPolynomial (Fin 3) k) (segreElem k 1 j) := by
      fin_cases j
      exacts [hys, hyt]
    fin_cases i
    · exact hx j
    · exact hy j
    · exact isIntegral_of_cube_add_mul_add (((hy j).pow 2).add ((hx j).mul (hy j)))
        ((hx j).pow 3) (segreElem_cubic k j)
  have hint : Algebra.IsIntegral (MvPolynomial (Fin 3) k) (segre k) := by
    have hle : (⊤ : Subalgebra k (segre k)) ≤
        (integralClosure (MvPolynomial (Fin 3) k) (segre k)).restrictScalars k := by
      rw [← adjoin_segreElem k, Algebra.adjoin_le_iff]
      rintro _ ⟨ij, rfl⟩
      exact hgen ij.1 ij.2
    exact ⟨fun x ↦ hle (Algebra.mem_top (x := x))⟩
  have : Algebra.FiniteType (MvPolynomial (Fin 3) k) (segre k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k _ _
  exact Algebra.IsIntegral.finite

/-- The Segre product is finite over `k[X₀, X₁, X₂]` through `segreBase`. -/
theorem segreBase_finite : (segreBase k).Finite :=
  segre.finite_base k

/-- The elements `xs, xt, ys, yt` of the Segre product. -/
noncomputable def segreCover : Fin 4 → segre k :=
  ![segreElem k 0 0, segreElem k 0 1, segreElem k 1 0, segreElem k 1 1]

/-- The images of the variables lie in the ideal generated by `xs, xt, ys, yt`. -/
theorem segreBase_X_mem_span_segreCover (i : Fin 3) :
    segreBase k (X i) ∈ Ideal.span (Set.range (segreCover k)) := by
  have h (j : Fin 4) : segreCover k j ∈ Ideal.span (Set.range (segreCover k)) :=
    Ideal.subset_span ⟨j, rfl⟩
  fin_cases i
  · exact (segreBase_X_zero k).symm ▸ h 0
  · exact (segreBase_X_one k).symm ▸ h 3
  · exact (segreBase_X_two k).symm ▸ add_mem (h 1) (h 2)

/-- Each generator of the Segre product lies in the radical of the ideal generated by the
images of the variables. -/
theorem segreElem_mem_radical (i : Fin 3) (j : Fin 2) :
    segreElem k i j ∈ (Ideal.span (Set.range fun l ↦ segreBase k (X l))).radical := by
  set I := Ideal.span (Set.range fun l ↦ segreBase k (X l))
  have hX (l : Fin 3) : segreBase k (X l) ∈ I := Ideal.subset_span ⟨l, rfl⟩
  have hquad {a : segre k} (ha : a ^ 2 - (segreElem k 0 1 + segreElem k 1 0) * a +
      segreElem k 0 0 * segreElem k 1 1 = 0) : a ∈ I.radical := by
    refine ⟨2, ?_⟩
    have : a ^ 2 = segreBase k (X 2) * a - segreBase k (X 0) * segreBase k (X 1) := by
      rw [segreBase_X_zero, segreBase_X_one, segreBase_X_two]
      linear_combination ha
    rw [this]
    exact sub_mem (I.mul_mem_right _ (hX 2)) (I.mul_mem_right _ (hX 0))
  have hx (j : Fin 2) : segreElem k 0 j ∈ I.radical := by
    fin_cases j
    · exact I.le_radical (segreBase_X_zero k ▸ hX 0)
    · exact hquad (segreElem_zero_one_sq k)
  have hy (j : Fin 2) : segreElem k 1 j ∈ I.radical := by
    fin_cases j
    · exact hquad (segreElem_one_zero_sq k)
    · exact I.le_radical (segreBase_X_one k ▸ hX 1)
  fin_cases i
  · exact hx j
  · exact hy j
  · refine Ideal.mem_radical_of_pow_mem (m := 3) ?_
    show segreElem k 2 j ^ 3 ∈ I.radical
    rw [show segreElem k 2 j ^ 3 = -((segreElem k 1 j ^ 2 + segreElem k 0 j * segreElem k 1 j) *
      segreElem k 2 j + segreElem k 0 j ^ 3) by linear_combination segreElem_cubic k j]
    exact neg_mem (add_mem (Ideal.mul_mem_right _ _ (add_mem (Ideal.pow_mem_of_mem _ (hy j) 2
      two_pos) (Ideal.mul_mem_right _ _ (hx j)))) (Ideal.pow_mem_of_mem _ (hx j) 3 three_pos))

/-- Each of `xs, xt, ys, yt` lies in the radical of the ideal generated by the images of the
variables. -/
theorem segreCover_mem_radical (j : Fin 4) :
    segreCover k j ∈ (Ideal.span (Set.range fun l ↦ segreBase k (X l))).radical := by
  fin_cases j
  exacts [segreElem_mem_radical k 0 0, segreElem_mem_radical k 0 1, segreElem_mem_radical k 1 0,
