/-!
# A nonflat coefficientwise localization of power series

Let `k` be a field and let `R = k[y, z, a₀, a₁, …]/(y aᵢ, aᵢ aⱼ)`, with `f` the image of `z`.
The coefficientwise localization map `R⟦X⟧ → R_f⟦X⟧` is not flat.

The obstruction is the series `b = ∑ aₙ f⁻ⁿ Xⁿ` in `R_f⟦X⟧`, which is killed by `y` because
`y aₙ = 0`. Were the map flat, the kernel of multiplication by `y` on `R_f⟦X⟧` would be
generated by the image of the kernel on `R⟦X⟧`, so `b` would be a finite sum `∑ hᵢ ⋅ gᵢ` with
`y gᵢ = 0`. Mapping that identity to trivial square-zero extensions of `k[y, z]` and of its
localization at `z`, whose module coordinates record the coefficients of the `aᵢ`, turns it into
the statement that every power of the series `X / z` lies in the finitely generated submodule
spanned by the images of the `hᵢ`. A nonzero finitely generated submodule stable under
multiplication by an element makes that element integral, and `X / z` is not integral over
`k[z]⟦X⟧`, since the coefficients of its powers have unbounded pole order at `z`.

## Main definitions

* `Stacks.Examples.nonflatPowerSeriesRelations`: the ideal `(y aᵢ, aᵢ aⱼ)`.
* `Stacks.Examples.nonflatPowerSeriesRing`: the quotient ring `R`.
* `Stacks.Examples.nonflatPowerSeriesElement`: the image of `z` in `R`.

## Main results

* `Stacks.Examples.not_flat_powerSeries_map_localizationAway`: the coefficientwise localization
  map `R⟦X⟧ → R_f⟦X⟧` is not flat.

## References

* [Stacks Project, Tag 0ALD](https://stacks.math.columbia.edu/tag/0ALD)
-/

@[expose] public noncomputable section

namespace Stacks.Examples

universe u

/-- The relations `y aᵢ = 0` and `aᵢ aⱼ = 0` in the polynomial ring
`k[y, z, a₀, a₁, …]`. -/
def nonflatPowerSeriesRelations (k : Type u) [CommRing k] :
    Ideal (MvPolynomial (Fin 2 ⊕ ℕ) k) :=
  Ideal.span
    (Set.range (fun i : ℕ =>
        MvPolynomial.X (Sum.inl (0 : Fin 2)) * MvPolynomial.X (Sum.inr i)) ∪
      Set.range (fun ij : ℕ × ℕ =>
        MvPolynomial.X (Sum.inr ij.1) * MvPolynomial.X (Sum.inr ij.2)))

/-- The ring `k[y, z, a₀, a₁, …]/(y aᵢ, aᵢ aⱼ)`. -/
abbrev nonflatPowerSeriesRing (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 2 ⊕ ℕ) k ⧸ nonflatPowerSeriesRelations k

/-- The image of `z` in `k[y, z, a₀, a₁, …]/(y aᵢ, aᵢ aⱼ)`. -/
def nonflatPowerSeriesElement (k : Type u) [CommRing k] :
    nonflatPowerSeriesRing k :=
  Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
    (MvPolynomial.X (Sum.inl (1 : Fin 2)))

private theorem tensorRid_mulLeft_comm (A B : Type*) [CommRing A] [CommRing B]
    [Algebra A B] (y : A) :
    (TensorProduct.AlgebraTensorModule.rid A B B).toLinearMap.comp
        (TensorProduct.AlgebraTensorModule.lTensor B B (LinearMap.mulLeft A y)) =
      (LinearMap.mulLeft B (algebraMap A B y)).comp
        (TensorProduct.AlgebraTensorModule.rid A B B).toLinearMap := by
  apply LinearMap.ext
  intro z
  induction z using TensorProduct.inductionOn with
  | tmul b a =>
      simp [TensorProduct.AlgebraTensorModule.rid_tmul, LinearMap.mulLeft_apply,
        Algebra.smul_def, map_mul, mul_assoc]
  | add x z hx hz => simp only [LinearMap.comp_apply, LinearMap.map_add, hx, hz]

private theorem flat_mul_kernel_mem_range (A B : Type*) [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B] (y : A) (b : B)
    (hb : algebraMap A B y * b = 0) :
    ∃ t : TensorProduct A B (LinearMap.ker (LinearMap.mulLeft A y)),
      (TensorProduct.AlgebraTensorModule.rid A B B)
        ((TensorProduct.AlgebraTensorModule.lTensor B B
          (LinearMap.ker (LinearMap.mulLeft A y)).subtype) t) = b := by
  let f : A →ₗ[A] A := LinearMap.mulLeft A y
  let ρ := TensorProduct.AlgebraTensorModule.rid A B B
  let τ := TensorProduct.AlgebraTensorModule.lTensor B B f
  have hcomm : ρ.toLinearMap.comp τ =
      (LinearMap.mulLeft B (algebraMap A B y)).comp ρ.toLinearMap := by
    simpa [f, τ, ρ] using tensorRid_mulLeft_comm A B y
  have hx : ρ.symm b ∈ LinearMap.ker τ := by
    rw [LinearMap.mem_ker]
    apply ρ.injective
    simpa [LinearMap.mulLeft_apply, hb] using LinearMap.congr_fun hcomm (ρ.symm b)
  rw [Module.Flat.ker_lTensor_eq B B f] at hx
  obtain ⟨t, ht⟩ := LinearMap.mem_range.mp hx
  exact ⟨t, by simpa [ρ, τ, f] using congrArg ρ.toLinearMap ht⟩

private theorem flat_mul_kernel_finite_sum (A B : Type*) [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B] (y : A) (b : B)
    (hb : algebraMap A B y * b = 0) :
    ∃ n : ℕ, ∃ h : Fin n → B, ∃ g : Fin n → A,
      (∀ i, y * g i = 0) ∧
        b = ∑ i, h i * algebraMap A B (g i) := by
  obtain ⟨t, ht⟩ := flat_mul_kernel_mem_range A B y b hb
  obtain ⟨n, h, g, rfl⟩ := TensorProduct.exists_sum_tmul_eq t
  refine ⟨n, h, fun i => (g i).val, fun i ↦ ?_, ?_⟩
  · simpa only [LinearMap.mulLeft_apply] using LinearMap.mem_ker.mp (g i).property
  · simp [← ht, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_comm]

private abbrev coordinateBase (k : Type u) [CommRing k] :=
  MvPolynomial (Fin 2) k

private abbrev coordinateModule (k : Type u) [CommRing k] := Polynomial k

private def coordinateAction (k : Type u) [CommRing k] :
    coordinateBase k →+* coordinateModule k :=
  MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = 0 then 0 else Polynomial.X)

private local instance coordinateAlgebra (k : Type u) [CommRing k] :
    Algebra (coordinateBase k) (coordinateModule k) :=
  RingHom.toAlgebra (coordinateAction k)

private abbrev localizedBase (k : Type u) [CommRing k] :=
  Localization.Away (MvPolynomial.X (1 : Fin 2) : coordinateBase k)

private abbrev localizedModule (k : Type u) [CommRing k] :=
  Localization.Away (Polynomial.X : Polynomial k)

/-- The image of `z` in `k[z]_z` is a unit. -/
private theorem isUnit_algebraMap_coordinateAction_X (k : Type u) [CommRing k] :
    IsUnit (((algebraMap (Polynomial k) (localizedModule k)).comp (coordinateAction k))
      (MvPolynomial.X (1 : Fin 2))) := by
  simpa [coordinateAction] using
    IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial k)

private def localizedAction (k : Type u) [CommRing k] :
    localizedBase k →+* localizedModule k :=
  IsLocalization.Away.lift (MvPolynomial.X (1 : Fin 2) : coordinateBase k)
    (isUnit_algebraMap_coordinateAction_X k)

private local instance localizedAlgebra (k : Type u) [CommRing k] :
    Algebra (localizedBase k) (localizedModule k) :=
  RingHom.toAlgebra (localizedAction k)

private theorem localizedAction_algebraMap (k : Type u) [CommRing k]
    (r : coordinateBase k) :
    localizedAction k
      (algebraMap (coordinateBase k) (localizedBase k) r) =
      (algebraMap (coordinateModule k) (localizedModule k))
        (coordinateAction k r) := by
  rw [localizedAction, IsLocalization.Away.lift_eq _ (isUnit_algebraMap_coordinateAction_X k)]
  rfl

private theorem localizedAction_y (k : Type u) [CommRing k] :
    localizedAction k
      (algebraMap (coordinateBase k) (localizedBase k)
        (MvPolynomial.X (0 : Fin 2))) = 0 := by
  rw [localizedAction_algebraMap]
  simp [coordinateAction]

/-! The simultaneous coordinate extension remembers every square-zero generator in one module.
Its base is `k[y, z]`, and the `i`th coordinate of the module records the coefficient of `aᵢ`. -/

private abbrev simultaneousCoordinateModule (k : Type u) [CommRing k] :=
  ℕ → Polynomial k

private local instance simultaneousCoordinateModuleAction (k : Type u)
    [CommRing k] : Module (coordinateBase k) (simultaneousCoordinateModule k) :=
  Module.compHom (simultaneousCoordinateModule k) (coordinateAction k)

private local instance simultaneousCoordinateOppModule (k : Type u)
    [CommRing k] :
    Module (coordinateBase k)ᵐᵒᵖ (simultaneousCoordinateModule k) :=
  Module.compHom (simultaneousCoordinateModule k)
    ((coordinateAction k).comp
      (RingEquiv.toOpposite (coordinateBase k)).symm.toRingHom)

private local instance simultaneousCoordinateCentral (k : Type u)
    [CommRing k] :
    IsCentralScalar (coordinateBase k) (simultaneousCoordinateModule k) where
  op_smul_eq_smul _ _ := rfl

private abbrev simultaneousCoordinateExtension (k : Type u) [CommRing k] :=
  TrivSqZeroExt (coordinateBase k) (simultaneousCoordinateModule k)

private def simultaneousPolynomialCoordinateMap (k : Type u)
    [CommRing k] :
    MvPolynomial (Fin 2 ⊕ ℕ) k →+* simultaneousCoordinateExtension k :=
  MvPolynomial.eval₂Hom
    ((TrivSqZeroExt.inlHom (coordinateBase k)
      (simultaneousCoordinateModule k)).comp
      (MvPolynomial.C : k →+* coordinateBase k))
    (fun v => match v with
      | Sum.inl i => TrivSqZeroExt.inl (MvPolynomial.X i)
      | Sum.inr i => TrivSqZeroExt.inr (Pi.single i (1 : Polynomial k)))

private theorem simultaneousPolynomialCoordinateMap_relations (k : Type u)
    [CommRing k] :
    nonflatPowerSeriesRelations k ≤
      RingHom.ker (simultaneousPolynomialCoordinateMap k) := by
  apply Ideal.span_le.mpr
  rintro p (⟨i, rfl⟩ | ⟨ij, rfl⟩)
  · change simultaneousPolynomialCoordinateMap k
      (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inr i)) = 0
    rw [simultaneousPolynomialCoordinateMap, map_mul,
      MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', TrivSqZeroExt.inl_mul_inr]
    change TrivSqZeroExt.inr (R := coordinateBase k)
        ((coordinateAction k (MvPolynomial.X 0)) •
          Pi.single i (1 : Polynomial k)) = TrivSqZeroExt.inr 0
    simp [coordinateAction]
  · change simultaneousPolynomialCoordinateMap k
      (MvPolynomial.X (Sum.inr ij.1) * MvPolynomial.X (Sum.inr ij.2)) = 0
    rw [simultaneousPolynomialCoordinateMap, map_mul,
      MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
    exact TrivSqZeroExt.inr_mul_inr _ _ _

private def simultaneousCoordinateMap (k : Type u) [CommRing k] :
    nonflatPowerSeriesRing k →+* simultaneousCoordinateExtension k :=
  Ideal.Quotient.lift (nonflatPowerSeriesRelations k)
    (simultaneousPolynomialCoordinateMap k)
    (simultaneousPolynomialCoordinateMap_relations k)

private def simultaneousCoordinateBaseMap (k : Type u)
    [CommRing k] : nonflatPowerSeriesRing k →+* coordinateBase k :=
  (TrivSqZeroExt.fstHom (coordinateBase k) (coordinateBase k)
    (simultaneousCoordinateModule k)).toRingHom.comp (simultaneousCoordinateMap k)

private theorem simultaneousCoordinateBaseMap_y (k : Type u) [CommRing k] :
    simultaneousCoordinateBaseMap k
      (Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
        (MvPolynomial.X (Sum.inl (0 : Fin 2)))) = MvPolynomial.X 0 := by
  simp [simultaneousCoordinateBaseMap, simultaneousCoordinateMap,
    simultaneousPolynomialCoordinateMap, MvPolynomial.eval₂Hom_X']

private theorem simultaneousCoordinateBaseMap_mul_y_eq_zero (k : Type u) [CommRing k] [IsDomain k]
    (s : PowerSeries (nonflatPowerSeriesRing k))
    (hs : PowerSeries.C (Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
      (MvPolynomial.X (Sum.inl (0 : Fin 2)))) * s = 0) :
    PowerSeries.map (simultaneousCoordinateBaseMap k) s = 0 := by
  have hy := congrArg (PowerSeries.map (simultaneousCoordinateBaseMap k)) hs
  rw [map_mul, PowerSeries.map_C, simultaneousCoordinateBaseMap_y] at hy
  refine PowerSeries.ext fun d ↦ ?_
  have hd := congrArg (PowerSeries.coeff d) hy
  rw [PowerSeries.coeff_C_mul] at hd
  exact (mul_eq_zero.mp hd).resolve_left (MvPolynomial.X_ne_zero _)

private abbrev simultaneousLocalizedModule (k : Type u) [CommRing k] :=
  ℕ → localizedModule k

private local instance simultaneousLocalizedModuleAction (k : Type u)
    [CommRing k] :
    Module (localizedBase k) (simultaneousLocalizedModule k) :=
  Module.compHom (simultaneousLocalizedModule k) (localizedAction k)

private local instance simultaneousLocalizedOppModule (k : Type u)
    [CommRing k] :
    Module (localizedBase k)ᵐᵒᵖ (simultaneousLocalizedModule k) :=
  Module.compHom (simultaneousLocalizedModule k)
    ((localizedAction k).comp
      (RingEquiv.toOpposite (localizedBase k)).symm.toRingHom)

private local instance simultaneousLocalizedCentral (k : Type u)
    [CommRing k] :
    IsCentralScalar (localizedBase k) (simultaneousLocalizedModule k) where
  op_smul_eq_smul _ _ := rfl

private abbrev simultaneousLocalizedExtension (k : Type u) [CommRing k] :=
  TrivSqZeroExt (localizedBase k) (simultaneousLocalizedModule k)

private def simultaneousLocalizeModule (k : Type u) [CommRing k] :
    simultaneousCoordinateModule k →+* simultaneousLocalizedModule k where
  toFun x i := algebraMap (Polynomial k) (localizedModule k) (x i)
  map_one' := by ext i; simp
  map_mul' x y := by ext i; simp [map_mul]
  map_zero' := by ext i; simp
  map_add' x y := by ext i; simp

private def simultaneousLocalizeExtension (k : Type u) [CommRing k] :
    simultaneousCoordinateExtension k →+* simultaneousLocalizedExtension k := by
  let : Algebra (coordinateBase k) (simultaneousLocalizedExtension k) :=
    RingHom.toAlgebra ((TrivSqZeroExt.inlHom (localizedBase k)
      (simultaneousLocalizedModule k)).comp
        (algebraMap (coordinateBase k) (localizedBase k)))
  let : Module (coordinateBase k) (simultaneousLocalizedExtension k) :=
    Algebra.toModule
  let f : coordinateBase k →ₐ[coordinateBase k]
      (simultaneousLocalizedExtension k) :=
    Algebra.ofId (coordinateBase k) _
  let hcompat (r : coordinateBase k) (x : simultaneousCoordinateModule k) :
      TrivSqZeroExt.inr
          (simultaneousLocalizeModule k ((coordinateAction k r) • x)) =
        TrivSqZeroExt.inl (algebraMap (coordinateBase k)
          (localizedBase k) r) *
          TrivSqZeroExt.inr (simultaneousLocalizeModule k x) := by
    rw [TrivSqZeroExt.inl_mul_inr]
    apply congrArg (TrivSqZeroExt.inr (R := localizedBase k))
    ext i
    change algebraMap (Polynomial k) (localizedModule k)
        ((coordinateAction k r) * x i) =
      localizedAction k (algebraMap (coordinateBase k)
        (localizedBase k) r) *
        algebraMap (Polynomial k) (localizedModule k) (x i)
    rw [map_mul, ← localizedAction_algebraMap]
  let g : simultaneousCoordinateModule k →ₗ[coordinateBase k]
      (simultaneousLocalizedExtension k) :=
    { toFun := fun x => TrivSqZeroExt.inr (simultaneousLocalizeModule k x)
      map_add' := by
        intro x y
        rw [← TrivSqZeroExt.inr_add]
        apply congrArg (TrivSqZeroExt.inr (R := localizedBase k))
        ext i
        simp [simultaneousLocalizeModule]
      map_smul' := by
        intro r x
        change TrivSqZeroExt.inr
            (simultaneousLocalizeModule k ((coordinateAction k r) • x)) =
          TrivSqZeroExt.inl (algebraMap (coordinateBase k)
            (localizedBase k) r) *
            TrivSqZeroExt.inr (simultaneousLocalizeModule k x)
        exact hcompat r x }
  exact (TrivSqZeroExt.lift (R := coordinateBase k)
    (M := simultaneousCoordinateModule k) (S := coordinateBase k)
    (A := simultaneousLocalizedExtension k) f g
    (fun x y => TrivSqZeroExt.inr_mul_inr _ _ _)
    (fun r x => by
      change TrivSqZeroExt.inr
          (simultaneousLocalizeModule k ((coordinateAction k r) • x)) =
        TrivSqZeroExt.inl (algebraMap (coordinateBase k)
          (localizedBase k) r) *
          TrivSqZeroExt.inr (simultaneousLocalizeModule k x)
      exact hcompat r x)
    (fun r x => by
      change TrivSqZeroExt.inr
          (simultaneousLocalizeModule k ((coordinateAction k r) • x)) =
        TrivSqZeroExt.inr (simultaneousLocalizeModule k x) *
          TrivSqZeroExt.inl (algebraMap (coordinateBase k)
            (localizedBase k) r)
      rw [mul_comm]
      exact hcompat r x)).toRingHom

private def simultaneousLocalizedPolynomialCoordinateMap (k : Type u)
    [CommRing k] :
    MvPolynomial (Fin 2 ⊕ ℕ) k →+* simultaneousLocalizedExtension k :=
  MvPolynomial.eval₂Hom
    ((TrivSqZeroExt.inlHom (localizedBase k)
      (simultaneousLocalizedModule k)).comp
      ((algebraMap (coordinateBase k) (localizedBase k)).comp
        (MvPolynomial.C : k →+* coordinateBase k)))
    (fun v => match v with
      | Sum.inl i => TrivSqZeroExt.inl
          (algebraMap (coordinateBase k) (localizedBase k)
            (MvPolynomial.X i))
      | Sum.inr i => TrivSqZeroExt.inr (Pi.single i (1 : localizedModule k)))

private theorem simultaneousLocalizedPolynomialCoordinateMap_relations (k : Type u)
    [CommRing k] :
    nonflatPowerSeriesRelations k ≤
      RingHom.ker (simultaneousLocalizedPolynomialCoordinateMap k) := by
  apply Ideal.span_le.mpr
  rintro p (⟨i, rfl⟩ | ⟨ij, rfl⟩)
  · change simultaneousLocalizedPolynomialCoordinateMap k
      (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inr i)) = 0
    rw [simultaneousLocalizedPolynomialCoordinateMap, map_mul,
      MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
      TrivSqZeroExt.inl_mul_inr]
    change TrivSqZeroExt.inr (R := localizedBase k)
        ((localizedAction k
          (algebraMap (coordinateBase k) (localizedBase k)
            (MvPolynomial.X 0))) • Pi.single i (1 : localizedModule k)) =
      TrivSqZeroExt.inr 0
    rw [localizedAction_y]
    simp
  · change simultaneousLocalizedPolynomialCoordinateMap k
      (MvPolynomial.X (Sum.inr ij.1) * MvPolynomial.X (Sum.inr ij.2)) = 0
    rw [simultaneousLocalizedPolynomialCoordinateMap, map_mul,
      MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
    exact TrivSqZeroExt.inr_mul_inr _ _ _

private def simultaneousLocalizedCoordinateRingMap (k : Type u)
    [CommRing k] : nonflatPowerSeriesRing k →+* simultaneousLocalizedExtension k :=
  Ideal.Quotient.lift (nonflatPowerSeriesRelations k)
    (simultaneousLocalizedPolynomialCoordinateMap k)
    (simultaneousLocalizedPolynomialCoordinateMap_relations k)

private theorem simultaneousLocalizedCoordinateRingMap_localizationElement
    (k : Type u) [CommRing k] :
    simultaneousLocalizedCoordinateRingMap k (nonflatPowerSeriesElement k) =
      TrivSqZeroExt.inl (R := localizedBase k)
        (M := simultaneousLocalizedModule k)
        (algebraMap (coordinateBase k) (localizedBase k)
          (MvPolynomial.X (1 : Fin 2))) := by
  simp [simultaneousLocalizedCoordinateRingMap, nonflatPowerSeriesElement,
    simultaneousLocalizedPolynomialCoordinateMap, MvPolynomial.eval₂Hom_X']

/-- The image of `f` in the localized square-zero extension is a unit. -/
private theorem isUnit_simultaneousLocalizedCoordinateRingMap_element (k : Type u)
    [CommRing k] :
    IsUnit (simultaneousLocalizedCoordinateRingMap k (nonflatPowerSeriesElement k)) := by
  rw [simultaneousLocalizedCoordinateRingMap_localizationElement]
  exact (IsLocalization.Away.algebraMap_isUnit
    (MvPolynomial.X (1 : Fin 2) : coordinateBase k)).map
      (TrivSqZeroExt.inlHom (localizedBase k) (simultaneousLocalizedModule k))

private def simultaneousLocalizedCoordinateMap (k : Type u)
    [CommRing k] :
    Localization.Away (nonflatPowerSeriesElement k) →+* simultaneousLocalizedExtension k :=
  IsLocalization.Away.lift (nonflatPowerSeriesElement k)
    (isUnit_simultaneousLocalizedCoordinateRingMap_element k)

private theorem simultaneousLocalizedCoordinateMap_algebraMap (k : Type u)
    [CommRing k] (r : nonflatPowerSeriesRing k) :
    simultaneousLocalizedCoordinateMap k
        (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k)) r) =
      simultaneousLocalizedCoordinateRingMap k r := by
  exact IsLocalization.Away.lift_eq (nonflatPowerSeriesElement k)
    (isUnit_simultaneousLocalizedCoordinateRingMap_element k) r

private theorem simultaneousLocalizeExtension_inr (k : Type u) [CommRing k]
    (x : simultaneousCoordinateModule k) :
    simultaneousLocalizeExtension k (TrivSqZeroExt.inr x) =
      TrivSqZeroExt.inr (simultaneousLocalizeModule k x) := by
  simp [simultaneousLocalizeExtension, TrivSqZeroExt.lift_apply_inr]

private theorem simultaneousLocalizeExtension_inl (k : Type u) [CommRing k]
    (x : coordinateBase k) :
    simultaneousLocalizeExtension k (TrivSqZeroExt.inl x) =
      TrivSqZeroExt.inl (algebraMap (coordinateBase k)
        (localizedBase k) x) := by
  let : Algebra (coordinateBase k) (simultaneousLocalizedExtension k) :=
    RingHom.toAlgebra ((TrivSqZeroExt.inlHom (localizedBase k)
      (simultaneousLocalizedModule k)).comp
        (algebraMap (coordinateBase k) (localizedBase k)))
  dsimp only [simultaneousLocalizeExtension]
  change TrivSqZeroExt.lift _ _ _ _ _ (TrivSqZeroExt.inl x) = _
  rw [TrivSqZeroExt.lift_apply_inl]
  rfl

private theorem simultaneousLocalizedCoordinateRingMap_factor (k : Type u)
    [CommRing k] :
    simultaneousLocalizedCoordinateRingMap k =
      (simultaneousLocalizeExtension k).comp (simultaneousCoordinateMap k) := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro a
    simp only [RingHom.comp_apply, simultaneousLocalizedCoordinateRingMap,
      simultaneousCoordinateMap, Ideal.Quotient.lift_mk,
      simultaneousLocalizedPolynomialCoordinateMap,
      simultaneousPolynomialCoordinateMap, MvPolynomial.eval₂Hom_C]
    change TrivSqZeroExt.inl
        (algebraMap (coordinateBase k) (localizedBase k)
          (MvPolynomial.C a)) =
      simultaneousLocalizeExtension k (TrivSqZeroExt.inl (MvPolynomial.C a))
    rw [simultaneousLocalizeExtension_inl]
  · intro v
    cases v with
    | inl i =>
      simp only [RingHom.comp_apply, simultaneousLocalizedCoordinateRingMap,
        simultaneousCoordinateMap, Ideal.Quotient.lift_mk,
        simultaneousLocalizedPolynomialCoordinateMap,
        simultaneousPolynomialCoordinateMap, MvPolynomial.eval₂Hom_X']
      change TrivSqZeroExt.inl
          (algebraMap (coordinateBase k) (localizedBase k)
            (MvPolynomial.X i)) =
        simultaneousLocalizeExtension k (TrivSqZeroExt.inl (MvPolynomial.X i))
      rw [simultaneousLocalizeExtension_inl]
    | inr i =>
      simp only [RingHom.comp_apply, simultaneousLocalizedCoordinateRingMap,
        simultaneousCoordinateMap, Ideal.Quotient.lift_mk,
        simultaneousLocalizedPolynomialCoordinateMap,
        simultaneousPolynomialCoordinateMap, MvPolynomial.eval₂Hom_X']
      change TrivSqZeroExt.inr (Pi.single i (1 : localizedModule k)) =
        simultaneousLocalizeExtension k
          (TrivSqZeroExt.inr (Pi.single i (1 : Polynomial k)))
      rw [simultaneousLocalizeExtension_inr]
      apply congrArg (TrivSqZeroExt.inr (R := localizedBase k)
        (M := simultaneousLocalizedModule k))
      funext j
      simp [simultaneousLocalizeModule, Pi.single_apply]

private def simultaneousCoordinatePowerSeriesMap (k : Type u)
    [CommRing k] :
    PowerSeries (nonflatPowerSeriesRing k) →+*
      PowerSeries (simultaneousCoordinateExtension k) :=
  PowerSeries.map (simultaneousCoordinateMap k)

private def simultaneousLocalizedCoordinatePowerSeriesMap (k : Type u)
    [CommRing k] :
    PowerSeries (Localization.Away (nonflatPowerSeriesElement k)) →+*
      PowerSeries (simultaneousLocalizedExtension k) :=
  PowerSeries.map (simultaneousLocalizedCoordinateMap k)

private theorem simultaneousLocalizedCoordinatePowerSeriesMap_algebraMap (k : Type u)
    [CommRing k] (s : PowerSeries (nonflatPowerSeriesRing k)) :
    simultaneousLocalizedCoordinatePowerSeriesMap k
        (PowerSeries.map (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k))) s) =
      PowerSeries.map (simultaneousLocalizedCoordinateRingMap k) s :=
  PowerSeries.ext fun d ↦ simultaneousLocalizedCoordinateMap_algebraMap k (PowerSeries.coeff d s)

private theorem simultaneousLocalizedCoordinatePowerSeriesMap_source (k : Type u)
    [CommRing k] (s : PowerSeries (nonflatPowerSeriesRing k)) :
    simultaneousLocalizedCoordinatePowerSeriesMap k
      (PowerSeries.map (algebraMap (nonflatPowerSeriesRing k)
        (Localization.Away (nonflatPowerSeriesElement k))) s) =
      PowerSeries.map (simultaneousLocalizeExtension k)
        (simultaneousCoordinatePowerSeriesMap k s) := by
  apply PowerSeries.ext
  intro d
  simp [simultaneousLocalizedCoordinatePowerSeriesMap_algebraMap,
    simultaneousLocalizedCoordinateRingMap_factor, simultaneousCoordinatePowerSeriesMap,
    PowerSeries.coeff_map]

private def simultaneousExtensionBaseSeries (k : Type u)
    [CommRing k] (s : PowerSeries (simultaneousLocalizedExtension k)) :
    PowerSeries (localizedBase k) :=
  PowerSeries.map (TrivSqZeroExt.fstHom (localizedBase k)
    (localizedBase k) (simultaneousLocalizedModule k)).toRingHom s

private def simultaneousExtensionModuleSeries (k : Type u)
    [CommRing k] (n : ℕ) (s : PowerSeries (simultaneousLocalizedExtension k)) :
    PowerSeries (localizedModule k) :=
  PowerSeries.mk (fun d => (PowerSeries.coeff d s).snd n)

private def simultaneousCoordinateModuleSeries (k : Type u)
    [CommRing k] (n : ℕ) (s : PowerSeries (simultaneousCoordinateExtension k)) :
    PowerSeries (Polynomial k) :=
  PowerSeries.mk (fun d => (PowerSeries.coeff d s).snd n)

private def simultaneousCoordinateExtensionBaseSeries (k : Type u)
    [CommRing k] (s : PowerSeries (simultaneousCoordinateExtension k)) :
    PowerSeries (coordinateBase k) :=
  PowerSeries.map (TrivSqZeroExt.fstHom (coordinateBase k)
    (coordinateBase k) (simultaneousCoordinateModule k)).toRingHom s

private theorem simultaneousLocalizeExtension_fst (k : Type u) [CommRing k]
    (x : simultaneousCoordinateExtension k) :
    (simultaneousLocalizeExtension k x).fst =
      algebraMap (coordinateBase k) (localizedBase k) x.fst := by
  induction x using TrivSqZeroExt.ind with
  | inl_add_inr r m =>
      simp [simultaneousLocalizeExtension_inl, simultaneousLocalizeExtension_inr,
        simultaneousLocalizeModule, TrivSqZeroExt.fst_add]

private theorem simultaneousLocalizeExtension_snd (k : Type u) [CommRing k]
    (x : simultaneousCoordinateExtension k) :
    (simultaneousLocalizeExtension k x).snd =
      simultaneousLocalizeModule k x.snd := by
  induction x using TrivSqZeroExt.ind with
  | inl_add_inr r m =>
      simp [simultaneousLocalizeExtension_inl, simultaneousLocalizeExtension_inr,
        simultaneousLocalizeModule, TrivSqZeroExt.snd_add]

private theorem simultaneousExtensionModuleSeries_localize (k : Type u)
    [CommRing k] (n : ℕ) (s : PowerSeries (simultaneousCoordinateExtension k)) :
    simultaneousExtensionModuleSeries k n
      (PowerSeries.map (simultaneousLocalizeExtension k) s) =
        PowerSeries.map (algebraMap (Polynomial k) (localizedModule k))
          (simultaneousCoordinateModuleSeries k n s) := by
  apply PowerSeries.ext
  intro d
  simpa [simultaneousExtensionModuleSeries, simultaneousCoordinateModuleSeries,
    PowerSeries.coeff_map, simultaneousLocalizeModule] using congrArg (fun v => v n)
      (simultaneousLocalizeExtension_snd k (PowerSeries.coeff d s))

private theorem simultaneousExtensionBaseSeries_localize (k : Type u)
    [CommRing k] (s : PowerSeries (simultaneousCoordinateExtension k)) :
    simultaneousExtensionBaseSeries k (PowerSeries.map (simultaneousLocalizeExtension k) s) =
      PowerSeries.map (algebraMap (coordinateBase k) (localizedBase k))
        (simultaneousCoordinateExtensionBaseSeries k s) := by
  apply PowerSeries.ext
  intro d
  simpa [simultaneousExtensionBaseSeries, simultaneousCoordinateExtensionBaseSeries,
    PowerSeries.coeff_map] using simultaneousLocalizeExtension_fst k (PowerSeries.coeff d s)

private theorem simultaneousExtensionBaseSeries_source (k : Type u) [CommRing k]
    (s : PowerSeries (nonflatPowerSeriesRing k)) :
    simultaneousExtensionBaseSeries k
      (simultaneousLocalizedCoordinatePowerSeriesMap k
        (PowerSeries.map (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k))) s)) =
      PowerSeries.map (algebraMap (coordinateBase k) (localizedBase k))
        (PowerSeries.map (simultaneousCoordinateBaseMap k) s) := by
  rw [simultaneousLocalizedCoordinatePowerSeriesMap_source,
    simultaneousExtensionBaseSeries_localize]
  apply PowerSeries.ext
  intro d
  simp [simultaneousCoordinateExtensionBaseSeries, simultaneousCoordinateBaseMap,
    simultaneousCoordinatePowerSeriesMap, PowerSeries.coeff_map]

private theorem simultaneousLocalizedCoordinateModuleSeries_source (k : Type u)
    [CommRing k] (n : ℕ) (s : PowerSeries (nonflatPowerSeriesRing k)) :
    simultaneousExtensionModuleSeries k n
      (simultaneousLocalizedCoordinatePowerSeriesMap k
        (PowerSeries.map (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k))) s)) =
      PowerSeries.map (algebraMap (Polynomial k) (localizedModule k))
        (simultaneousCoordinateModuleSeries k n
          (simultaneousCoordinatePowerSeriesMap k s)) := by
  rw [simultaneousLocalizedCoordinatePowerSeriesMap_source,
    simultaneousExtensionModuleSeries_localize]

private theorem simultaneousExtensionModuleSeries_mul_of_right_base_zero
    (k : Type u) [CommRing k] (n : ℕ)
    (s t : PowerSeries (simultaneousLocalizedExtension k))
    (ht : simultaneousExtensionBaseSeries k t = 0) :
    simultaneousExtensionModuleSeries k n (s * t) =
      PowerSeries.map (localizedAction k)
        (simultaneousExtensionBaseSeries k s) *
          simultaneousExtensionModuleSeries k n t := by
  apply PowerSeries.ext
  intro d
  simp only [simultaneousExtensionModuleSeries, PowerSeries.coeff_mk,
    PowerSeries.coeff_mul]
  change ((TrivSqZeroExt.sndHom (localizedBase k)
      (simultaneousLocalizedModule k)).toAddMonoidHom
      (∑ p ∈ Finset.antidiagonal d,
        PowerSeries.coeff p.1 s * PowerSeries.coeff p.2 t)) n = _
  rw [map_sum]
  simp only [Finset.sum_apply]
  change (∑ p ∈ Finset.antidiagonal d,
      (PowerSeries.coeff p.1 s * PowerSeries.coeff p.2 t).snd n) = _
  simp_rw [TrivSqZeroExt.snd_mul]
  have ht' (j : ℕ) : (PowerSeries.coeff j t).fst = 0 := by
    simpa [simultaneousExtensionBaseSeries] using congrArg (PowerSeries.coeff j) ht
  simp_rw [ht']
  have hact :
      (algebraMap (localizedBase k) (localizedModule k)) =
        localizedAction k := rfl
  simp [Algebra.smul_def, simultaneousExtensionBaseSeries,
    PowerSeries.coeff_map, hact]

private theorem simultaneousExtensionModuleSeries_sum (k : Type u) [CommRing k]
    (n m : ℕ) (s : Fin m → PowerSeries (simultaneousLocalizedExtension k)) :
    simultaneousExtensionModuleSeries k n (∑ i, s i) =
      ∑ i, simultaneousExtensionModuleSeries k n (s i) := by
  apply PowerSeries.ext
  intro d
  simp [simultaneousExtensionModuleSeries, TrivSqZeroExt.snd_sum]

private def squareZeroGenerator (k : Type u) [CommRing k] (n : ℕ) :
    nonflatPowerSeriesRing k :=
  Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
    (MvPolynomial.X (Sum.inr n))

private theorem y_mul_squareZeroGenerator (k : Type u) [CommRing k] (n : ℕ) :
    Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
        (MvPolynomial.X (Sum.inl (0 : Fin 2))) * squareZeroGenerator k n = 0 := by
  change Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
    (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inr n)) = 0
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (Or.inl ⟨n, rfl⟩))

private def localizedElementInverse (k : Type u) [CommRing k] :
    Localization.Away (nonflatPowerSeriesElement k) := by
  let : CommSemiring (nonflatPowerSeriesRing k) := inferInstance
  let : CommSemiring (Localization.Away (nonflatPowerSeriesElement k)) := inferInstance
  let u : (Localization.Away (nonflatPowerSeriesElement k))ˣ :=
    (IsLocalization.Away.algebraMap_isUnit (nonflatPowerSeriesElement k)).unit
  exact (u⁻¹).val

private def localizedBaseXInverse (k : Type u) [CommRing k] :
    localizedBase k := by
  let : CommSemiring (coordinateBase k) := inferInstance
  let : CommSemiring (localizedBase k) := inferInstance
  let u : (localizedBase k)ˣ :=
    (IsLocalization.Away.algebraMap_isUnit
      (MvPolynomial.X (1 : Fin 2) : coordinateBase k)).unit
  exact (u⁻¹).val

private def localizedPolynomialXInverse (k : Type u)
    [CommRing k] : localizedModule k := by
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  let u : (localizedModule k)ˣ :=
    (IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial k)).unit
  exact (u⁻¹).val

private theorem localizedElementInverse_mul (k : Type u) [CommRing k] :
    algebraMap (nonflatPowerSeriesRing k) (Localization.Away (nonflatPowerSeriesElement k))
        (nonflatPowerSeriesElement k) * localizedElementInverse k = 1 := by
  let : CommSemiring (nonflatPowerSeriesRing k) := inferInstance
  let : CommSemiring (Localization.Away (nonflatPowerSeriesElement k)) := inferInstance
  simp [localizedElementInverse]

private theorem localizedBaseXInverse_mul (k : Type u) [CommRing k] :
    algebraMap (coordinateBase k) (localizedBase k)
        (MvPolynomial.X (1 : Fin 2)) * localizedBaseXInverse k = 1 := by
  let : CommSemiring (coordinateBase k) := inferInstance
  let : CommSemiring (localizedBase k) := inferInstance
  simp [localizedBaseXInverse]

private theorem localizedPolynomialXInverse_mul (k : Type u) [CommRing k] :
    algebraMap (Polynomial k) (localizedModule k) Polynomial.X *
      localizedPolynomialXInverse k = 1 := by
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  simp [localizedPolynomialXInverse]

private theorem localizedAction_baseXInverse (k : Type u) [CommRing k] :
    localizedAction k (localizedBaseXInverse k) =
      localizedPolynomialXInverse k := by
  let : CommSemiring (coordinateBase k) := inferInstance
  let : CommSemiring (localizedBase k) := inferInstance
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  have hz : IsUnit (localizedAction k
      (algebraMap (coordinateBase k) (localizedBase k)
        (MvPolynomial.X (1 : Fin 2)))) := by
    rw [localizedAction_algebraMap]
    exact isUnit_algebraMap_coordinateAction_X k
  apply hz.mul_left_cancel
  calc
    _ = localizedAction k
        (algebraMap (coordinateBase k) (localizedBase k)
          (MvPolynomial.X (1 : Fin 2)) * localizedBaseXInverse k) := by rw [map_mul]
    _ = 1 := by rw [localizedBaseXInverse_mul]; simp
    _ = localizedAction k
        (algebraMap (coordinateBase k) (localizedBase k)
          (MvPolynomial.X (1 : Fin 2))) * localizedPolynomialXInverse k := by
          rw [localizedAction_algebraMap]
          simpa [coordinateAction] using
            (localizedPolynomialXInverse_mul k).symm

private def kernelSeries (k : Type u) [CommRing k] :
    PowerSeries (Localization.Away (nonflatPowerSeriesElement k)) := by
  let : CommSemiring (nonflatPowerSeriesRing k) := inferInstance
  let : CommSemiring (Localization.Away (nonflatPowerSeriesElement k)) := inferInstance
  exact PowerSeries.mk (fun n =>
      algebraMap (nonflatPowerSeriesRing k) (Localization.Away (nonflatPowerSeriesElement k))
        (squareZeroGenerator k n) *
        localizedElementInverse k ^ n)

private theorem kernelSeries_mul_y_eq_zero (k : Type u) [CommRing k] :
    PowerSeries.C (algebraMap (nonflatPowerSeriesRing k)
      (Localization.Away (nonflatPowerSeriesElement k))
      (Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
        (MvPolynomial.X (Sum.inl (0 : Fin 2))))) * kernelSeries k = 0 := by
  apply PowerSeries.ext
  intro n
  simp only [PowerSeries.coeff_C_mul, kernelSeries, PowerSeries.coeff_mk]
  rw [← mul_assoc, ← map_mul, y_mul_squareZeroGenerator, map_zero, zero_mul]
  simp

private theorem simultaneousLocalizedCoordinateMap_generator (k : Type u)
    [CommRing k] (n : ℕ) :
    simultaneousLocalizedCoordinateMap k
        (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k)) (squareZeroGenerator k n)) =
      TrivSqZeroExt.inr (Pi.single n (1 : localizedModule k)) := by
  rw [simultaneousLocalizedCoordinateMap_algebraMap]
  simp [simultaneousLocalizedCoordinateRingMap, squareZeroGenerator,
    simultaneousLocalizedPolynomialCoordinateMap, MvPolynomial.eval₂Hom_X']

private theorem simultaneousLocalizedCoordinateMap_localizationElement_algebraMap
    (k : Type u) [CommRing k] :
    simultaneousLocalizedCoordinateMap k
        (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k)) (nonflatPowerSeriesElement k)) =
      TrivSqZeroExt.inl (R := localizedBase k)
        (M := simultaneousLocalizedModule k)
        (algebraMap (coordinateBase k) (localizedBase k)
          (MvPolynomial.X (1 : Fin 2))) := by
  rw [simultaneousLocalizedCoordinateMap_algebraMap,
    simultaneousLocalizedCoordinateRingMap_localizationElement]

private theorem simultaneousLocalizedCoordinateMap_localizedElementInverse
    (k : Type u) [CommRing k] :
    simultaneousLocalizedCoordinateMap k (localizedElementInverse k) =
      TrivSqZeroExt.inl (R := localizedBase k)
        (M := simultaneousLocalizedModule k)
        (localizedBaseXInverse k) := by
  let : CommSemiring (nonflatPowerSeriesRing k) := inferInstance
  let : CommSemiring (Localization.Away (nonflatPowerSeriesElement k)) := inferInstance
  let : CommSemiring (coordinateBase k) := inferInstance
  let : CommSemiring (localizedBase k) := inferInstance
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  let : CommSemiring (simultaneousLocalizedModule k) := inferInstance
  let : CommSemiring (simultaneousLocalizedExtension k) := TrivSqZeroExt.commSemiring
  have hz : IsUnit (simultaneousLocalizedCoordinateMap k
      (algebraMap (nonflatPowerSeriesRing k)
        (Localization.Away (nonflatPowerSeriesElement k)) (nonflatPowerSeriesElement k))) :=
    (IsLocalization.Away.algebraMap_isUnit (nonflatPowerSeriesElement k)).map _
  apply hz.mul_left_cancel
  calc
    _ = simultaneousLocalizedCoordinateMap k
        (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k)) (nonflatPowerSeriesElement k) *
          localizedElementInverse k) := by rw [map_mul]
    _ = 1 := by rw [localizedElementInverse_mul]; simp
    _ = simultaneousLocalizedCoordinateMap k
        (algebraMap (nonflatPowerSeriesRing k)
          (Localization.Away (nonflatPowerSeriesElement k)) (nonflatPowerSeriesElement k)) *
        TrivSqZeroExt.inl (localizedBaseXInverse k) := by
          rw [simultaneousLocalizedCoordinateMap_localizationElement_algebraMap]
          have h := congrArg (TrivSqZeroExt.inl (R := localizedBase k)
            (M := simultaneousLocalizedModule k)) (localizedBaseXInverse_mul k)
          simpa using h.symm

private def seriesRatio (k : Type u) [CommRing k] :
    PowerSeries (localizedModule k) := by
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  exact PowerSeries.X * PowerSeries.C
    (localizedPolynomialXInverse k)

private theorem seriesRatio_pow_coeff (k : Type u) [CommRing k] (n d : ℕ) :
    PowerSeries.coeff d (seriesRatio k ^ n) =
      if d = n then
        localizedPolynomialXInverse k ^ n
      else 0 := by
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  rw [seriesRatio, mul_pow, ← map_pow, PowerSeries.coeff_mul_C,
    PowerSeries.coeff_X_pow]
  split_ifs <;> simp_all

private theorem not_isIntegral_seriesRatio (k : Type u) [CommRing k] [IsDomain k] :
    ¬ IsIntegral (PowerSeries (Polynomial k)) (seriesRatio k) := by
  let R₀ := PowerSeries (Polynomial k)
  let S₀ := PowerSeries (localizedModule k)
  let ψ : R₀ →+* S₀ := PowerSeries.map
    (algebraMap (Polynomial k) (localizedModule k))
  have hcoeffInj : Function.Injective
      (algebraMap (Polynomial k) (localizedModule k)) :=
    IsLocalization.injective (localizedModule k)
      (powers_le_nonZeroDivisors_of_noZeroDivisors Polynomial.X_ne_zero)
  have hψInj : Function.Injective ψ := PowerSeries.map_injective _ hcoeffInj
  rintro ⟨p, hp, hroot⟩
  let d := p.natDegree
  let z : localizedModule k :=
    algebraMap (Polynomial k) (localizedModule k) Polynomial.X
  let zi := localizedPolynomialXInverse k
  have hzinv : z * zi = 1 := localizedPolynomialXInverse_mul k
  have hpow (i : ℕ) : seriesRatio k ^ i =
      PowerSeries.X ^ i * PowerSeries.C (zi ^ i) := by
    simp [seriesRatio, zi, mul_pow, map_pow]
  have hψX : ψ PowerSeries.X = PowerSeries.X := PowerSeries.map_X _
  have hψC (a : Polynomial k) : ψ (PowerSeries.C a) =
      PowerSeries.C (algebraMap (Polynomial k) (localizedModule k) a) :=
    PowerSeries.map_C _ _
  rw [Polynomial.eval₂_eq_sum_range] at hroot
  let Q : R₀ := ∑ i ∈ Finset.range (d + 1),
    p.coeff i * PowerSeries.X ^ i *
      PowerSeries.C (Polynomial.X ^ (d - i))
  have hterm (i : ℕ) (hi : i ≤ d) :
      ψ (p.coeff i * PowerSeries.X ^ i *
          PowerSeries.C (Polynomial.X ^ (d - i))) =
        PowerSeries.C (z ^ d) *
          (ψ (p.coeff i) * (PowerSeries.X ^ i * PowerSeries.C (zi ^ i))) := by
    have hzi : z ^ d * zi ^ i = z ^ (d - i) := by
      calc
        z ^ d * zi ^ i = (z ^ (d - i) * z ^ i) * zi ^ i := by
          rw [← pow_add, Nat.sub_add_cancel hi]
        _ = z ^ (d - i) * (z ^ i * zi ^ i) := by ac_rfl
        _ = z ^ (d - i) := by rw [← mul_pow, hzinv, one_pow, mul_one]
    calc
      _ = (ψ (p.coeff i) * PowerSeries.X ^ i) *
          PowerSeries.C (z ^ (d - i)) := by
            simp only [map_mul, map_pow, hψX, hψC]
            rfl
      _ = (ψ (p.coeff i) * PowerSeries.X ^ i) *
          (PowerSeries.C (z ^ d) * PowerSeries.C (zi ^ i)) := by
            rw [← map_mul, hzi]
      _ = PowerSeries.C (z ^ d) *
          (ψ (p.coeff i) * (PowerSeries.X ^ i * PowerSeries.C (zi ^ i))) := by ring
  have hQ : Q = 0 := by
    apply hψInj
    simpa using (calc
      ψ Q = ∑ i ∈ Finset.range (d + 1),
          ψ (p.coeff i * PowerSeries.X ^ i *
            PowerSeries.C (Polynomial.X ^ (d - i))) := by
              simp [Q, map_sum]
      _ = PowerSeries.C (z ^ d) *
          (∑ i ∈ Finset.range (d + 1),
            ψ (p.coeff i) *
              (PowerSeries.X ^ i * PowerSeries.C (zi ^ i))) := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro i hi
              rw [hterm i (Nat.le_of_lt_succ (Finset.mem_range.mp hi))]
      _ = 0 := by
        have hroot' : (∑ i ∈ Finset.range (d + 1),
            ψ (p.coeff i) * (PowerSeries.X ^ i * PowerSeries.C (zi ^ i))) = 0 := by
          simpa only [PowerSeries.algebraMap_apply'', hpow] using hroot
        rw [hroot', mul_zero])
  have hcoeff' :
      (∑ i ∈ Finset.range (d + 1),
        PowerSeries.coeff (d - i) (p.coeff i) * Polynomial.X ^ (d - i)) = 0 := by
    have hcoeff := congrArg (PowerSeries.coeff d) hQ
    simp only [Q, map_sum, map_zero] at hcoeff
    convert hcoeff using 1
    apply Finset.sum_congr rfl
    intro i hi
    rw [PowerSeries.coeff_mul_C, PowerSeries.coeff_mul_X_pow']
    simp [Nat.le_of_lt_succ (Finset.mem_range.mp hi)]
  have hqeval := congrArg (Polynomial.eval (0 : k)) hcoeff'
  rw [Polynomial.eval_finsetSum, Finset.sum_range_succ] at hqeval
  have hlower :
      (∑ i ∈ Finset.range d,
        Polynomial.eval (0 : k)
          (PowerSeries.coeff (d - i) (p.coeff i) * Polynomial.X ^ (d - i))) = 0 := by
    apply Finset.sum_eq_zero
    intro i hi
    have hpos : d - i ≠ 0 := Nat.sub_ne_zero_of_lt (Finset.mem_range.mp hi)
    simp [hpos]
  rw [hlower] at hqeval
  have hlead : p.coeff d = 1 := hp.coeff_natDegree
  simp [hlead] at hqeval

private theorem simultaneousExtensionModuleSeries_kernelSeries (k : Type u) [CommRing k]
    (n : ℕ) :
    simultaneousExtensionModuleSeries k n
      (simultaneousLocalizedCoordinatePowerSeriesMap k (kernelSeries k)) =
        seriesRatio k ^ n := by
  apply PowerSeries.ext
  intro d
  simp only [simultaneousExtensionModuleSeries, PowerSeries.coeff_mk,
    simultaneousLocalizedCoordinatePowerSeriesMap, PowerSeries.coeff_map,
    kernelSeries, PowerSeries.coeff_mk]
  rw [map_mul, simultaneousLocalizedCoordinateMap_generator,
    map_pow, simultaneousLocalizedCoordinateMap_localizedElementInverse]
  have hpow : TrivSqZeroExt.inl (R := localizedBase k)
      (M := simultaneousLocalizedModule k)
      (localizedBaseXInverse k ^ d) =
    TrivSqZeroExt.inl (localizedBaseXInverse k) ^ d :=
    map_pow (TrivSqZeroExt.inlHom (localizedBase k) (simultaneousLocalizedModule k)) _ _
  rw [← hpow, TrivSqZeroExt.inr_mul_inl]
  simp only [IsCentralScalar.op_smul_eq_smul]
  let : CommSemiring (Polynomial k) := Polynomial.commSemiring
  let : CommSemiring (localizedModule k) := inferInstance
  let : CommSemiring (coordinateBase k) := inferInstance
  let : CommSemiring (localizedBase k) := inferInstance
  let : CommSemiring (simultaneousLocalizedModule k) := inferInstance
  change (localizedAction k (localizedBaseXInverse k ^ d) •
      Pi.single d (1 : localizedModule k)) n = _
  rw [map_pow, localizedAction_baseXInverse k, seriesRatio_pow_coeff k n d]
  by_cases h : d = n
  · subst d
    simp [Pi.smul_apply, smul_eq_mul]
  · simp [Pi.smul_apply, smul_eq_mul, h, Ne.symm h]

/-- The coefficientwise localization map from the power series ring of
`k[y, z, aᵢ]/(y aᵢ, aᵢ aⱼ)` to the power series ring of its localization at `z`
is not flat. -/
@[stacks 0ALD]
theorem not_flat_powerSeries_map_localizationAway
    (k : Type u) [Field k] :
    ¬ (PowerSeries.map
      (algebraMap (nonflatPowerSeriesRing k)
        (Localization.Away (nonflatPowerSeriesElement k)))).Flat := by
  intro hflat
  let f : PowerSeries (nonflatPowerSeriesRing k) →+*
      PowerSeries (Localization.Away (nonflatPowerSeriesElement k)) :=
    PowerSeries.map (algebraMap (nonflatPowerSeriesRing k)
      (Localization.Away (nonflatPowerSeriesElement k)))
  let : Algebra (PowerSeries (nonflatPowerSeriesRing k))
      (PowerSeries (Localization.Away (nonflatPowerSeriesElement k))) := RingHom.toAlgebra f
  have hflatModule : Module.Flat (PowerSeries (nonflatPowerSeriesRing k))
      (PowerSeries (Localization.Away (nonflatPowerSeriesElement k))) := hflat
  let y : PowerSeries (nonflatPowerSeriesRing k) := PowerSeries.C
    (Ideal.Quotient.mk (nonflatPowerSeriesRelations k)
      (MvPolynomial.X (Sum.inl (0 : Fin 2))))
  let b : PowerSeries (Localization.Away (nonflatPowerSeriesElement k)) :=
    kernelSeries k
  obtain ⟨m, h, g, hg, hsum⟩ :=
    flat_mul_kernel_finite_sum (PowerSeries (nonflatPowerSeriesRing k))
      (PowerSeries (Localization.Away (nonflatPowerSeriesElement k))) y b
      (by simpa only [y, b, RingHom.algebraMap_toAlgebra, f, PowerSeries.map_C] using
        kernelSeries_mul_y_eq_zero k)
  simp only [RingHom.algebraMap_toAlgebra] at hsum
  let barh : Fin m → PowerSeries (localizedModule k) := fun i =>
    PowerSeries.map (localizedAction k)
      (simultaneousExtensionBaseSeries k
        (simultaneousLocalizedCoordinatePowerSeriesMap k (h i)))
  let q : Fin m → ℕ → PowerSeries (Polynomial k) := fun i n =>
    simultaneousCoordinateModuleSeries k n
      (simultaneousCoordinatePowerSeriesMap k (g i))
  let R₀ := PowerSeries (Polynomial k)
  let S₀ := PowerSeries (localizedModule k)
  let ψ : R₀ →+* S₀ := PowerSeries.map
    (algebraMap (Polynomial k) (localizedModule k))
  let : Algebra R₀ S₀ := RingHom.toAlgebra ψ
  have : IsNoetherianRing R₀ := inferInstance
  have : IsDomain (localizedModule k) :=
    IsLocalization.Away.isDomain (R := Polynomial k) _
      (Polynomial.X_ne_zero (R := k))
  let N : Submodule R₀ S₀ := Submodule.span R₀ (Set.range barh)
  have hNfg : N.FG := Submodule.fg_def.mpr ⟨Set.range barh, Set.finite_range _, rfl⟩
  have hkernelBase (i : Fin m) :
      simultaneousExtensionBaseSeries k
        (simultaneousLocalizedCoordinatePowerSeriesMap k (f (g i))) = 0 := by
    rw [simultaneousExtensionBaseSeries_source,
      simultaneousCoordinateBaseMap_mul_y_eq_zero k (g i) (hg i)]
    simp
  have hpow_mem (n : ℕ) : seriesRatio k ^ n ∈ N := by
    have hcoord := congrArg (simultaneousLocalizedCoordinatePowerSeriesMap k) hsum
    simp only [map_sum, map_mul] at hcoord
    have hcoord_n := congrArg (simultaneousExtensionModuleSeries k n) hcoord
    change simultaneousExtensionModuleSeries k n
      (simultaneousLocalizedCoordinatePowerSeriesMap k (kernelSeries k)) = _
      at hcoord_n
    rw [simultaneousExtensionModuleSeries_kernelSeries,
      simultaneousExtensionModuleSeries_sum] at hcoord_n
    rw [hcoord_n]
    apply Submodule.sum_mem
    intro i hi
    rw [simultaneousExtensionModuleSeries_mul_of_right_base_zero k n _ _ (hkernelBase i),
      simultaneousLocalizedCoordinateModuleSeries_source]
    change barh i * ψ (q i n) ∈ N
    rw [mul_comm]
    exact N.smul_mem (q i n) (Submodule.subset_span ⟨i, rfl⟩)
  let P : Submodule R₀ S₀ := Submodule.span R₀ (Set.range (seriesRatio k ^ ·))
  have hPfg : P.FG :=
    Submodule.FG.of_le hNfg (Submodule.span_le.mpr (Set.range_subset_iff.2 hpow_mem))
  have hPne : P ≠ ⊥ := fun hbot ↦ by
    have hmem : (1 : S₀) ∈ P := Submodule.subset_span ⟨0, by simp⟩
    rw [hbot] at hmem
    simp at hmem
  have hstable : ∀ x ∈ P, seriesRatio k • x ∈ P := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨n, rfl⟩ := hx
      rw [smul_eq_mul, ← pow_succ']
      exact Submodule.subset_span ⟨n + 1, rfl⟩
    | zero => simp
    | add x y hx hy ihx ihy => simpa only [smul_add] using P.add_mem ihx ihy
    | smul a x hx ih =>
      simpa only [smul_comm (seriesRatio k) a x] using P.smul_mem a ih
  exact not_isIntegral_seriesRatio k
    (isIntegral_of_smul_mem_submodule P hPne hPfg (seriesRatio k) hstable)

end Stacks.Examples

