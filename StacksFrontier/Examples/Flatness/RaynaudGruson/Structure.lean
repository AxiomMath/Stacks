module

public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.Order.SupIndep
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Localization.Away.AdjoinRoot
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Nilpotent.Basic
public import Mathlib.RingTheory.RingHom.Etale
public import Mathlib.RingTheory.Smooth.StandardSmoothOfFree
public import StacksFrontier.Examples.Flatness.RaynaudGruson.Construction
public import StacksFrontier.RingTheory.Ideal.Annihilator.FlatBaseChange

/-!
# Structure of the Raynaud--Gruson construction

The properties of the rings `A`, `C` and `B` of the Raynaud--Gruson construction: `A` is local,
`A → C` is étale, `A → B` is of finite type, `q_B` is a prime of `B` contracting to the maximal
ideal of `A`, and the localizations of `B` at `q_B` and of `C` at `q_C` agree.

The kernel of `C → B` is described twice. It is the ideal generated by the elements
`ξₙ = (z - xⁿ) zₙ`, and the cyclic ideals they generate are independent, so the kernel is their
direct sum; the same holds after inverting an element `g ∉ q_C`, where the sum runs over the
`n` with `g ∉ qₙ`. The annihilator of `ξₙ` is `qₙ`, the annihilator of `zₙ` in `C` is `pₙ C`,
and the three quotients of `C` by `pₙ C`, by `rₙ` and by `qₙ` are respectively
`k[X]_(X) × k(X)`, `k[X]_(X)` and `k(X)`.

## Main results

* `Stacks.Examples.RaynaudGruson.ringA_isLocalRing`, `aToC_etale`, `aToB_finiteType`,
  `idealQB_isPrime`, `idealQB_comap_eq_maximalIdeal`, `bAtQB_equiv_cAtQC`: the local, étale and
  finite type properties and the identification of the two localizations.
* `Stacks.Examples.RaynaudGruson.annihilator_zCIndex`,
  `Stacks.Examples.RaynaudGruson.annihilator_xi`: the two annihilators.
* `Stacks.Examples.RaynaudGruson.quotient_idealP_equiv_prod`,
  `quotient_idealR_equiv_lineAtOrigin`, `quotient_idealQ_equiv_fractionRing`: the three
  quotients.
* `Stacks.Examples.RaynaudGruson.ker_cToB_eq_span_xi`,
  `Stacks.Examples.RaynaudGruson.iSupIndep_span_xi`,
  `Stacks.Examples.RaynaudGruson.ker_cToB_le_idealI`,
  `Stacks.Examples.RaynaudGruson.ker_awayMap_eq_span_xi`,
  `Stacks.Examples.RaynaudGruson.iSupIndep_span_xi_away`: the kernel of `C → B`, before and
  after inverting an element outside `q_C`.

## References

* [Stacks Project, Tag 05G2](https://stacks.math.columbia.edu/tag/05G2)
-/

@[expose] public section

noncomputable section

namespace Stacks.Examples.RaynaudGruson

universe u

variable (k : Type u) [Field k]

/-- The local ring `k[X]_(X)` occurring in the product decomposition. -/
abbrev lineAtOrigin :=
  Localization (Submonoid.comap (Polynomial.evalRingHom (0 : k)) (nonZeroDivisors k))

/-- The localization of `B` at its distinguished prime. -/
abbrev bAtQB :=
  Localization (Submonoid.closure {b : ringB k | b ∉ idealQB k})

section

/-- The commutative ring structure on `k[x,y]_(x,y)` as an Ore localization of `k[x,y]` at the
polynomials not vanishing at the origin. -/
noncomputable local instance baseRingCommRingAux : CommRing (baseRing k) :=
  @OreLocalization.instCommRing (PlanePolynomial k) inferInstance
    (originSubmonoid k) inferInstance

private structure Results where
  localRing : IsLocalRing (ringA k)
  etale : (aToC k).Etale
  finiteType : (aToB k).FiniteType
  qbPrime : (idealQB k).IsPrime
  qbComap :
    letI := localRing
    (idealQB k).comap (aToB k) = IsLocalRing.maximalIdeal (ringA k)
  localEquiv :
    ∃ e : bAtQB k ≃+* cAtQC k,
      ∀ c : ringC k,
        e (algebraMap (ringB k) (bAtQB k) ((cToB k) c)) =
          algebraMap (ringC k) (cAtQC k) c
  annihilatorZ (n : PNat) :
    (Ideal.span ({zCIndex k n} : Set (ringC k))).annihilator =
      (idealP k n).map (aToC k)
  quotientP (n : PNat) :
    Nonempty ((ringC k ⧸ (idealP k n).map (aToC k)) ≃+*
      (lineAtOrigin k × FractionRing (Polynomial k)))
  quotientR (n : PNat) :
    Nonempty ((ringC k ⧸ idealR k n) ≃+* lineAtOrigin k)
  quotientQ (n : PNat) :
    Nonempty ((ringC k ⧸ idealQ k n) ≃+* FractionRing (Polynomial k))
  annihilatorXi (n : PNat) :
    (Ideal.span ({xi k n} : Set (ringC k))).annihilator = idealQ k n
  kernel : RingHom.ker (cToB k) = Ideal.span (Set.range (xi k))
  independent :
    iSupIndep (fun n : PNat => Ideal.span ({xi k n} : Set (ringC k)))
  kernelLe : RingHom.ker (cToB k) ≤ (idealI k).map (aToC k)
  awayKernel (g : ringC k) (hg : g ∉ idealQC k) :
    RingHom.ker (Localization.awayMap (cToB k) g) =
      Ideal.span ((fun n : {n : PNat // g ∉ idealQ k n} =>
        algebraMap (ringC k) (Localization.Away g) (xi k n.1)) '' Set.univ)
  awayIndependent (g : ringC k) (hg : g ∉ idealQC k) :
    iSupIndep (fun n : {n : PNat // g ∉ idealQ k n} =>
      Ideal.span ({algebraMap (ringC k) (Localization.Away g) (xi k n.1)} :
        Set (Localization.Away g)))

private lemma zA_mul_zA (i j : PNat) : zA k i * zA k j = 0 := by
  rw [zA, zA, ← map_mul]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inl ⟨(i, j), rfl⟩))

private lemma zA_mul_fA (n : PNat) : zA k n * fA k n = 0 := by
  have hmem : MvPolynomial.X n * MvPolynomial.C (f k n) ∈ relationIdeal k :=
    Ideal.subset_span (Or.inr ⟨n, rfl⟩)
  simpa [zA, fA, baseToA, RingHom.comp_apply] using Ideal.Quotient.eq_zero_iff_mem.mpr hmem

private lemma cRelation_eq_zero :
    xC k * zC k ^ 2 + zC k + yC k = 0 := by
  have hc : (Ideal.Quotient.mk (cRelationIdeal k)) (cRelation k) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp [cRelation]))
  simpa [cRelation, xC, xA, yC, yA, aToC, zC] using
    congrArg (algebraMap (cQuotient k) (ringC k)) hc

private lemma fA_eq (n : PNat) :
    fA k n = yA k + xA k ^ (n : ℕ) + xA k ^ (2 * (n : ℕ) + 1) := by
  simp [fA, f, xA, yA]

private lemma aToC_fA (n : PNat) :
    aToC k (fA k n) = yC k + xC k ^ (n : ℕ) + xC k ^ (2 * (n : ℕ) + 1) := by
  rw [fA_eq]
  simp [xC, yC]

private lemma fA_mem_idealP (n : PNat) : fA k n ∈ idealP k n :=
  Ideal.mem_sup_right (Ideal.subset_span rfl)

private lemma factor_mem_idealQ (n : PNat) :
    xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1 ∈ idealQ k n :=
  Ideal.mem_sup_right (Ideal.subset_span rfl)

private lemma zC_sub_pow_mem_idealR (n : PNat) : zC k - xC k ^ (n : ℕ) ∈ idealR k n :=
  Ideal.mem_sup_right (Ideal.subset_span rfl)

private lemma factor_relation (n : PNat) :
    (zC k - xC k ^ (n : ℕ)) *
        (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) =
      -aToC k (fA k n) := by
  calc
    (zC k - xC k ^ (n : ℕ)) *
        (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) =
        xC k * zC k ^ 2 + zC k - xC k ^ (2 * (n : ℕ) + 1) -
          xC k ^ (n : ℕ) := by ring
    _ = -(yC k + xC k ^ (n : ℕ) + xC k ^ (2 * (n : ℕ) + 1)) := by
      linear_combination cRelation_eq_zero k
    _ = -aToC k (fA k n) := by rw [aToC_fA]

private lemma xi_mul_factor_eq_zero (n : PNat) :
    xi k n * (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) = 0 := by
  have hz : zCIndex k n * aToC k (fA k n) = 0 := by
    simpa [zCIndex, map_mul] using congrArg (aToC k) (zA_mul_fA k n)
  rw [xi]
  calc
    (zC k - xC k ^ (n : ℕ)) * zCIndex k n *
        (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) =
        zCIndex k n * ((zC k - xC k ^ (n : ℕ)) *
          (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1)) := by ring
    _ = zCIndex k n * (-aToC k (fA k n)) := by rw [factor_relation]
    _ = 0 := by simpa using congrArg Neg.neg hz

private lemma idealQ_le_annihilator_xi (n : PNat) :
    idealQ k n ≤ (Ideal.span ({xi k n} : Set (ringC k))).annihilator := by
  have key : ∀ a : ringC k, a * zCIndex k n = 0 →
      a ∈ (Ideal.span ({xi k n} : Set (ringC k))).annihilator := fun a ha => by
    rw [Submodule.mem_annihilator_span_singleton]
    show a * xi k n = 0
    rw [xi, mul_left_comm, ha, mul_zero]
  rw [idealQ]
  apply sup_le
  · rw [idealP, Ideal.map_sup]
    apply sup_le
    · apply Ideal.map_le_iff_le_comap.mpr
      rw [idealI]
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact key (aToC k (zA k i)) (by rw [zCIndex, ← map_mul, zA_mul_zA, map_zero])
    · rw [Ideal.map_span]
      apply Ideal.span_le.mpr
      rintro _ ⟨a, ha, rfl⟩
      rcases Set.mem_singleton_iff.mp ha with rfl
      exact key (aToC k (fA k n)) (by rw [zCIndex, ← map_mul, mul_comm, zA_mul_fA, map_zero])
  · apply Ideal.span_le.mpr
    rintro _ ha
    rcases Set.mem_singleton_iff.mp ha with rfl
    rw [SetLike.mem_coe, Submodule.mem_annihilator_span_singleton, smul_eq_mul, mul_comm]
    exact xi_mul_factor_eq_zero k n

/-- The ideal `I = (z₁, z₂, …)` of `A` has square zero. -/
lemma idealI_sq : idealI k * idealI k = ⊥ := by
  rw [idealI, Ideal.span_mul_span]
  refine le_bot_iff.mp (Ideal.span_le.mpr fun x hx => ?_)
  obtain ⟨_, ⟨i, rfl⟩, _, ⟨j, rfl⟩, rfl⟩ := Set.mem_mul.mp hx
  rw [zA_mul_zA]
  exact Ideal.zero_mem _

private def evalZero : MvPolynomial PNat (baseRing k) →+* baseRing k :=
  MvPolynomial.eval₂Hom (RingHom.id _) fun _ => 0

/-- Every polynomial differs from the constant `p(0)` by an element of the ideal `(Xᵢ)`. -/
private lemma sub_const_eval_mem_span_X {σ R : Type*} [CommRing R] (p : MvPolynomial σ R) :
    p - MvPolynomial.C (MvPolynomial.eval₂Hom (RingHom.id R) (fun _ => 0) p) ∈
      Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) := by
  classical
  let J := Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))
  let E := MvPolynomial.eval₂Hom (RingHom.id R) (fun _ : σ => 0)
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
      have heq : p + q - MvPolynomial.C (E (p + q)) =
          (p - MvPolynomial.C (E p)) + (q - MvPolynomial.C (E q)) := by
        simp only [map_add]
        ring
      rw [heq]
      exact J.add_mem hp hq
  | mul_X p i hp =>
      have hi : MvPolynomial.X i ∈ J := Ideal.subset_span ⟨i, rfl⟩
      simpa [J, mul_comm] using Ideal.mul_mem_right p J hi

private lemma sub_const_eval_mem (p : MvPolynomial PNat (baseRing k)) :
    p - MvPolynomial.C (evalZero k p) ∈
      Ideal.span (Set.range (MvPolynomial.X : PNat → MvPolynomial PNat (baseRing k))) :=
  sub_const_eval_mem_span_X p

private lemma evalZero_relation (p : MvPolynomial PNat (baseRing k))
    (hp : p ∈ relationIdeal k) : evalZero k p = 0 := by
  have hrel : relationIdeal k ≤ RingHom.ker (evalZero k) := by
    apply Ideal.span_le.mpr
    intro x hx
    rcases hx with hx | hx
    · rcases hx with ⟨⟨i, j⟩, rfl⟩
      simp [evalZero]
    · rcases hx with ⟨i, rfl⟩
      simp [evalZero]
  exact RingHom.mem_ker.mp (hrel hp)

private noncomputable def evalA0 : ringA k →+* baseRing k :=
  Ideal.Quotient.lift (I := relationIdeal k) (evalZero k) fun p hp =>
    evalZero_relation k p hp

private lemma evalA0_base (a : baseRing k) : evalA0 k (baseToA k a) = a := by
  simp [evalA0, baseToA, evalZero]

private lemma evalA0_surjective : Function.Surjective (evalA0 k) := by
  intro a
  exact ⟨baseToA k a, evalA0_base k a⟩

private lemma ker_evalA0_eq_idealI : RingHom.ker (evalA0 k) = idealI k := by
  apply le_antisymm
  · intro a ha
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    have hp : evalZero k p = 0 := by
      apply RingHom.mem_ker.mp at ha
      simpa [evalA0] using ha
    have hIeq : idealI k = Ideal.map (Ideal.Quotient.mk (relationIdeal k))
        (Ideal.span (Set.range (MvPolynomial.X : PNat →
          MvPolynomial PNat (baseRing k)))) := by
      rw [idealI, Ideal.map_span]
      congr 1
      ext q
      simp [zA]
    rw [hIeq]
    have hd := sub_const_eval_mem k p
    have heq : Ideal.Quotient.mk (relationIdeal k) p =
        Ideal.Quotient.mk (relationIdeal k)
          (p - MvPolynomial.C (evalZero k p)) := by
      rw [hp]
      simp
    rw [heq]
    exact Ideal.mem_map_of_mem _ hd
  · rw [idealI]
    apply Ideal.span_le.mpr
    rintro _ ⟨n, rfl⟩
    show evalZero k (MvPolynomial.X n) = 0
    simp [evalZero]

private noncomputable def ringA_quotient_idealI_equiv_base :
    (ringA k ⧸ idealI k) ≃+* baseRing k :=
  (Ideal.quotEquivOfEq (ker_evalA0_eq_idealI k).symm).trans
    ((evalA0 k).quotientKerEquivOfSurjective (evalA0_surjective k))

private lemma idealP_map_quotientI (n : PNat) :
    (idealP k n).map (Ideal.Quotient.mk (idealI k)) =
      Ideal.span ({Ideal.Quotient.mk (idealI k) (fA k n)} :
        Set (ringA k ⧸ idealI k)) := by
  rw [idealP, Ideal.map_sup, Ideal.map_span, Ideal.map_quotient_self, bot_sup_eq]
  simp

private lemma ringA_quotient_idealI_equiv_base_mk (a : ringA k) :
    ringA_quotient_idealI_equiv_base k (Ideal.Quotient.mk (idealI k) a) = evalA0 k a :=
  rfl

private lemma ringA_quotient_idealI_equiv_base_mk_f (n : PNat) :
    ringA_quotient_idealI_equiv_base k
      (Ideal.Quotient.mk (idealI k) (fA k n)) = f k n := by
  rw [ringA_quotient_idealI_equiv_base_mk]
  exact evalA0_base k (f k n)

private noncomputable def ringA_quotient_idealP_equiv_base : (n : PNat) →
    (ringA k ⧸ idealP k n) ≃+* (baseRing k ⧸ Ideal.span ({f k n} : Set (baseRing k))) := by
  intro n
  let e := ringA_quotient_idealI_equiv_base k
  have hspan : Ideal.span ({f k n} : Set (baseRing k)) =
      (Ideal.span ({Ideal.Quotient.mk (idealI k) (fA k n)} :
        Set (ringA k ⧸ idealI k))).map (e : (ringA k ⧸ idealI k) →+* baseRing k) := by
    calc
      Ideal.span ({f k n} : Set (baseRing k)) =
          Ideal.span ({ringA_quotient_idealI_equiv_base k
            (Ideal.Quotient.mk (idealI k) (fA k n))} : Set (baseRing k)) := by
              rw [ringA_quotient_idealI_equiv_base_mk_f]
      _ = (Ideal.span ({Ideal.Quotient.mk (idealI k) (fA k n)} :
          Set (ringA k ⧸ idealI k))).map (e : (ringA k ⧸ idealI k) →+* baseRing k) := by
            rw [Ideal.map_span]
            simp [e]
  exact
    (DoubleQuot.quotQuotEquivQuotOfLE (I := idealI k) (J := idealP k n)
      le_sup_left).symm.trans
      ((Ideal.quotEquivOfEq (idealP_map_quotientI k n)).trans
        (Ideal.quotientEquiv
          (Ideal.span ({Ideal.Quotient.mk (idealI k) (fA k n)} :
            Set (ringA k ⧸ idealI k)))
          (Ideal.span ({f k n} : Set (baseRing k))) e hspan))

private lemma idealI_eq_map_span_X :
    idealI k = Ideal.map (Ideal.Quotient.mk (relationIdeal k))
      (Ideal.span (Set.range (MvPolynomial.X : PNat → MvPolynomial PNat (baseRing k)))) := by
  rw [idealI, Ideal.map_span]
  congr 1
  ext p
  simp [zA]

private lemma sub_residue_mem_idealI (p : MvPolynomial PNat (baseRing k)) :
    Ideal.Quotient.mk (relationIdeal k) p - baseToA k (evalZero k p) ∈ idealI k := by
  rw [idealI_eq_map_span_X]
  simpa [baseToA, map_sub] using
    Ideal.mem_map_of_mem (Ideal.Quotient.mk (relationIdeal k)) (sub_const_eval_mem k p)

private lemma baseRing_isLocal : IsLocalRing (baseRing k) := by
  classical
  let ev : PlanePolynomial k →+* k := MvPolynomial.eval 0
  let p : Ideal (PlanePolynomial k) := RingHom.ker ev
  have hev : Function.Surjective ev := fun a => ⟨MvPolynomial.C a, by simp [ev]⟩
  let : p.IsPrime := (RingHom.ker_isMaximal_of_surjective ev hev).isPrime
  have hsub : originSubmonoid k = p.primeCompl := by
    ext f
    show ev f ∈ nonZeroDivisors k ↔ f ∉ p
    rw [mem_nonZeroDivisors_iff, RingHom.mem_ker]
    constructor
    · rintro ⟨_, hright⟩ hzero
      exact one_ne_zero (hright 1 (by simp [hzero]))
    · intro hf
      have hne : ev f ≠ 0 := by simpa [p] using hf
      exact ⟨fun x hx => (mul_eq_zero.mp hx).resolve_left hne,
        fun x hx => (mul_eq_zero.mp hx).resolve_right hne⟩
  show IsLocalRing (Localization (originSubmonoid k))
  rw [hsub]
  exact Localization.AtPrime.isLocalRing p

private def residueEval : PlanePolynomial k →+* k := MvPolynomial.eval 0

private lemma residueEval_unit (s : originSubmonoid k) :
    IsUnit (residueEval k (s : PlanePolynomial k)) := by
  apply isUnit_iff_ne_zero.mpr
  intro hz
  have hs : residueEval k (s : PlanePolynomial k) ∈ nonZeroDivisors k := s.property
  rcases (mem_nonZeroDivisors_iff.mp hs) with ⟨_, hr⟩
  exact one_ne_zero (hr 1 (by rw [hz, mul_zero]))

private noncomputable def residueBase : baseRing k →+* k :=
  IsLocalization.lift (M := originSubmonoid k) (S := baseRing k)
    (g := residueEval k) (fun s => residueEval_unit k s)

private lemma residueBase_comp :
    (residueBase k).comp (algebraMap (PlanePolynomial k) (baseRing k)) =
      residueEval k :=
  IsLocalization.lift_comp (M := originSubmonoid k) (S := baseRing k)
    (g := residueEval k) (fun s => residueEval_unit k s)

private def originIdeal : Ideal (PlanePolynomial k) :=
  Ideal.span (Set.range (MvPolynomial.X : Fin 2 → PlanePolynomial k))

private lemma sub_const_eval_mem_plane (p : PlanePolynomial k) :
    p - MvPolynomial.C (residueEval k p) ∈ originIdeal k :=
  sub_const_eval_mem_span_X p

private lemma residueEval_zero_iff_mem_originIdeal (p : PlanePolynomial k) :
    residueEval k p = 0 ↔ p ∈ originIdeal k := by
  constructor
  · intro hp
    have h := sub_const_eval_mem_plane k p
    simpa [hp] using h
  · intro hp
    have hgen : originIdeal k ≤ RingHom.ker (residueEval k) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      simp [residueEval]
    exact RingHom.mem_ker.mp (hgen hp)

private lemma residueBase_ker_eq_map_originIdeal :
    RingHom.ker (residueBase k) =
      (originIdeal k).map (algebraMap (PlanePolynomial k) (baseRing k)) := by
  apply le_antisymm
  · intro b hb
    obtain ⟨⟨p, s⟩, heq⟩ :=
      IsLocalization.surj (M := originSubmonoid k) (S := baseRing k) b
    have heval : residueEval k p = 0 := by
      have h := congrArg (residueBase k) heq
      have h' : residueBase k b * residueEval k (s : PlanePolynomial k) =
          residueEval k p := by
        simpa only [map_mul, ← RingHom.comp_apply, residueBase_comp] using h
      simpa [RingHom.mem_ker.mp hb] using h'.symm
    have hp : p ∈ originIdeal k := (residueEval_zero_iff_mem_originIdeal k p).mp heval
    have hmul : b * algebraMap (PlanePolynomial k) (baseRing k) s ∈
        (originIdeal k).map (algebraMap (PlanePolynomial k) (baseRing k)) := by
      rw [heq]
      exact Ideal.mem_map_of_mem (algebraMap (PlanePolynomial k) (baseRing k)) hp
    have hu : IsUnit (algebraMap (PlanePolynomial k) (baseRing k) s) :=
      IsLocalization.map_units (M := originSubmonoid k) (S := baseRing k) s
    exact (Ideal.mul_unit_mem_iff_mem _ hu).mp hmul
  · apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    show (residueBase k).comp
      (algebraMap (PlanePolynomial k) (baseRing k)) (MvPolynomial.X i) = 0
    rw [residueBase_comp]
    simp [residueEval]

private def evalA : MvPolynomial PNat (baseRing k) →+* k :=
  MvPolynomial.eval₂Hom (residueBase k) fun _ => 0

private lemma relationIdeal_le_ker_evalA :
    relationIdeal k ≤ RingHom.ker (evalA k) := by
  apply Ideal.span_le.mpr
  rintro p (hp | hp)
  · rcases hp with ⟨⟨i, j⟩, rfl⟩
    simp [evalA]
  · rcases hp with ⟨i, rfl⟩
    simp [evalA]

private lemma evalA_zero_of_mem (x : MvPolynomial PNat (baseRing k))
    (hx : x ∈ relationIdeal k) : evalA k x = 0 :=
  RingHom.mem_ker.mp ((relationIdeal_le_ker_evalA k) hx)

private noncomputable def residueA :
    (MvPolynomial PNat (baseRing k) ⧸ relationIdeal k) →+* k :=
  Ideal.Quotient.lift (I := relationIdeal k) (evalA k) (evalA_zero_of_mem k)

private lemma residueA_base (a : baseRing k) :
    residueA k (baseToA k a) = residueBase k a := by
  simp [residueA, baseToA, evalA]

private lemma residueA_baseToA_algebraMap (p : PlanePolynomial k) :
    residueA k (baseToA k (algebraMap (PlanePolynomial k) (baseRing k) p)) = residueEval k p := by
  rw [residueA_base]
  exact RingHom.congr_fun (residueBase_comp k) p

private lemma residueA_xA : residueA k (xA k) = 0 :=
  (residueA_baseToA_algebraMap k (MvPolynomial.X 0)).trans (by simp [residueEval])

private lemma residueA_yA : residueA k (yA k) = 0 :=
  (residueA_baseToA_algebraMap k (MvPolynomial.X 1)).trans (by simp [residueEval])

private lemma residueA_zA (n : PNat) : residueA k (zA k n) = 0 := by
  simp [residueA, zA, evalA]

private lemma originIdeal_map_le_span_xy :
    (originIdeal k).map (algebraMap (PlanePolynomial k) (baseRing k)) ≤
      Ideal.span ({x0 k, y0 k} : Set (baseRing k)) := by
  apply Ideal.map_le_iff_le_comap.mpr
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  fin_cases i <;> exact Ideal.subset_span (by simp [x0, y0])

private lemma span_xy_map_baseToA :
    (Ideal.span ({x0 k, y0 k} : Set (baseRing k))).map (baseToA k) =
      Ideal.span ({xA k, yA k} : Set (ringA k)) := by
  rw [Ideal.map_span]
  simp [xA, yA]

private lemma xC_mem_idealQC : xC k ∈ idealQC k :=
  Ideal.subset_span (Set.mem_insert _ _)

private lemma yC_mem_idealQC : yC k ∈ idealQC k :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

private lemma zC_mem_idealQC : zC k ∈ idealQC k :=
  Ideal.subset_span (Set.mem_insert_of_mem _
    (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))

private lemma zCIndex_mem_idealQC (n : PNat) : zCIndex k n ∈ idealQC k :=
  Ideal.subset_span (Set.mem_insert_of_mem _
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨n, rfl⟩)))

private lemma idealMaxA_le_ker_residueA :
    idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) ≤
      RingHom.ker (residueA k) := by
  refine sup_le (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro a ⟨n, rfl⟩
    exact RingHom.mem_ker.mpr (residueA_zA k n)
  · rintro a (rfl | rfl)
    exacts [RingHom.mem_ker.mpr (residueA_xA k), RingHom.mem_ker.mpr (residueA_yA k)]

private lemma ker_residueA_le_idealMaxA :
    RingHom.ker (residueA k) ≤
      idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) := by
  intro a ha
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hp : evalA k p = 0 := by
    simpa [residueA] using ha
  have heval : residueBase k (evalZero k p) = 0 := by
    simpa [evalA, evalZero] using hp
  have hbase : evalZero k p ∈ RingHom.ker (residueBase k) :=
    RingHom.mem_ker.mpr heval
  have hbase' : evalZero k p ∈
      (originIdeal k).map (algebraMap (PlanePolynomial k) (baseRing k)) := by
    rw [← residueBase_ker_eq_map_originIdeal k]
    exact hbase
  have hxy : evalZero k p ∈ Ideal.span ({x0 k, y0 k} : Set (baseRing k)) :=
    originIdeal_map_le_span_xy k hbase'
  have hmap : baseToA k (evalZero k p) ∈
      Ideal.span ({xA k, yA k} : Set (ringA k)) := by
    rw [← span_xy_map_baseToA k]
    exact Ideal.mem_map_of_mem (baseToA k) hxy
  have hdiff := sub_residue_mem_idealI k p
  have hleft : Ideal.Quotient.mk (relationIdeal k) p - baseToA k (evalZero k p) ∈
      idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) := Ideal.mem_sup_left hdiff
  have hright : baseToA k (evalZero k p) ∈
      idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) := Ideal.mem_sup_right hmap
  have hsum := (idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k))).add_mem hleft hright
  convert hsum using 1
  ring

private lemma ker_residueA_eq_idealMaxA :
    RingHom.ker (residueA k) =
      idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) :=
  le_antisymm (ker_residueA_le_idealMaxA k) (idealMaxA_le_ker_residueA k)

private def evalCQuotZero : MvPolynomial Unit (ringA k) →+* ringA k :=
  MvPolynomial.eval₂Hom (RingHom.id _) fun _ => 0

private lemma sub_const_eval_mem_cPolynomial (p : MvPolynomial Unit (ringA k)) :
    p - MvPolynomial.C (evalCQuotZero k p) ∈
      Ideal.span (Set.range (MvPolynomial.X : Unit → MvPolynomial Unit (ringA k))) :=
  sub_const_eval_mem_span_X p

private lemma idealMaxA_map_aToC_le_idealQC :
    (idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k))).map (aToC k) ≤
      idealQC k := by
  refine Ideal.map_le_iff_le_comap.mpr (sup_le (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_))
  · rintro a ⟨n, rfl⟩
    exact zCIndex_mem_idealQC k n
  · rintro a (rfl | rfl)
    exacts [xC_mem_idealQC k, yC_mem_idealQC k]

private def cQuotToC : cQuotient k →+* ringC k :=
  algebraMap (cQuotient k) (ringC k)

private def evalCQuot : MvPolynomial Unit (ringA k) →+* k :=
  MvPolynomial.eval₂Hom (residueA k) fun _ => 0

private lemma cRelationIdeal_le_ker_evalCQuot :
    cRelationIdeal k ≤ RingHom.ker (evalCQuot k) := by
  apply Ideal.span_le.mpr
  rintro p hp
  rcases Set.mem_singleton_iff.mp hp with rfl
  simp [evalCQuot, cRelation, residueA_yA]

private lemma evalCQuot_zero_of_mem (x : MvPolynomial Unit (ringA k))
    (hx : x ∈ cRelationIdeal k) : evalCQuot k x = 0 :=
  RingHom.mem_ker.mp ((cRelationIdeal_le_ker_evalCQuot k) hx)

private noncomputable def residueCQuot :
    (MvPolynomial Unit (ringA k) ⧸ cRelationIdeal k) →+* k :=
  Ideal.Quotient.lift (I := cRelationIdeal k) (evalCQuot k)
    (evalCQuot_zero_of_mem k)

private lemma residueCQuot_zero_image_mem_idealQC (c : cQuotient k)
    (hc : residueCQuot k c = 0) : cQuotToC k c ∈ idealQC k := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective c
  have hp : evalCQuot k p = 0 := by
    simpa [residueCQuot] using hc
  have hcoeff : residueA k (evalCQuotZero k p) = 0 := by
    simpa [evalCQuot, evalCQuotZero] using hp
  have hcoeff' : evalCQuotZero k p ∈
      idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) := by
    rw [← ker_residueA_eq_idealMaxA k]
    exact RingHom.mem_ker.mpr hcoeff
  let φ : MvPolynomial Unit (ringA k) →+* ringC k :=
    (cQuotToC k).comp (Ideal.Quotient.mk (cRelationIdeal k))
  have hpoly : (Ideal.span (Set.range (MvPolynomial.X : Unit →
      MvPolynomial Unit (ringA k)))).map φ ≤ idealQC k := by
    apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact zC_mem_idealQC k
  have hdiff := sub_const_eval_mem_cPolynomial k p
  have hdiff' : φ (p - MvPolynomial.C (evalCQuotZero k p)) ∈ idealQC k := hpoly
    (Ideal.mem_map_of_mem φ hdiff)
  have hconst : φ (MvPolynomial.C (evalCQuotZero k p)) ∈ idealQC k := by
    show aToC k (evalCQuotZero k p) ∈ idealQC k
    apply idealMaxA_map_aToC_le_idealQC k
    exact Ideal.mem_map_of_mem (aToC k) hcoeff'
  have hsum := (idealQC k).add_mem hdiff' hconst
  have heq : φ p = φ (p - MvPolynomial.C (evalCQuotZero k p)) +
      φ (MvPolynomial.C (evalCQuotZero k p)) := by simp
  show φ p ∈ idealQC k
  rw [heq]
  exact hsum

private lemma residueCQuot_denominator :
    residueCQuot k (cDenominator k) = 1 := by
  simp [residueCQuot, cDenominator, evalCQuot, residueA_xA]

private noncomputable def residueC : ringC k →+* k :=
  IsLocalization.Away.lift (cDenominator k)
    (show IsUnit (residueCQuot k (cDenominator k)) by
      rw [residueCQuot_denominator]
      exact isUnit_one)

private lemma residueC_algebraMap (c : cQuotient k) :
    residueC k (algebraMap (cQuotient k) (ringC k) c) = residueCQuot k c :=
  IsLocalization.Away.lift_eq _ _ _

private lemma residueC_aToC (a : ringA k) :
    residueC k (aToC k a) = residueA k a := by
  show residueC k (algebraMap (cQuotient k) (ringC k)
    (Ideal.Quotient.mk (cRelationIdeal k) (MvPolynomial.C a))) = residueA k a
  rw [residueC_algebraMap, residueCQuot, Ideal.Quotient.lift_mk]
  simp [evalCQuot]

private lemma cDenominator_sub_one_mem_idealQC :
    algebraMap (cQuotient k) (ringC k) (cDenominator k) - 1 ∈ idealQC k := by
  let φ : MvPolynomial Unit (ringA k) →+* ringC k :=
    (algebraMap (cQuotient k) (ringC k)).comp (Ideal.Quotient.mk (cRelationIdeal k))
  have heq : algebraMap (cQuotient k) (ringC k) (cDenominator k) =
      2 * xC k * zC k + 1 := by
    show φ (2 * MvPolynomial.C (xA k) * MvPolynomial.X () + 1) =
      2 * φ (MvPolynomial.C (xA k)) * φ (MvPolynomial.X ()) + 1
    simp only [map_add, map_mul, map_one]
    have htwo : φ (2 : MvPolynomial Unit (ringA k)) = (2 : ringC k) := map_ofNat φ 2
    rw [htwo]
  rw [heq]
  have h := Ideal.mul_mem_right (2 * zC k) (idealQC k) (xC_mem_idealQC k)
  convert h using 1; ring

private lemma cDenominator_pow_sub_one_mem_idealQC (n : ℕ) :
    algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ n - 1 ∈ idealQC k := by
  induction n with
  | zero => simp
  | succ n ih =>
      have hd := cDenominator_sub_one_mem_idealQC k
      have heq : algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ (n + 1) - 1 =
          (algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ n - 1) *
            algebraMap (cQuotient k) (ringC k) (cDenominator k) +
              (algebraMap (cQuotient k) (ringC k) (cDenominator k) - 1) := by ring
      rw [heq]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ih) hd

private lemma residueC_ker_le_idealQC :
    RingHom.ker (residueC k) ≤ idealQC k := by
  intro c hc
  obtain ⟨n, a, heq⟩ := IsLocalization.Away.surj (cDenominator k) c
  have hres := congrArg (residueC k) heq
  rw [map_mul, residueC_algebraMap] at hres
  have ha : residueCQuot k a = 0 := by
    simpa [RingHom.mem_ker.mp hc] using hres.symm
  have hnum : algebraMap (cQuotient k) (ringC k) a ∈ idealQC k :=
    residueCQuot_zero_image_mem_idealQC k a ha
  have hden' := cDenominator_pow_sub_one_mem_idealQC k n
  have hmul : c * algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ n ∈
      idealQC k := by simpa using heq ▸ hnum
  have hmul' : c * (algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ n - 1) ∈
      idealQC k := Ideal.mul_mem_left (idealQC k) c hden'
  have hc' : c = c * algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ n -
      c * (algebraMap (cQuotient k) (ringC k) (cDenominator k) ^ n - 1) := by ring
  rw [hc']
  exact Ideal.sub_mem _ hmul hmul'

private lemma residueC_xC : residueC k (xC k) = 0 :=
  (residueC_aToC k _).trans (residueA_xA k)

private lemma residueC_yC : residueC k (yC k) = 0 :=
  (residueC_aToC k _).trans (residueA_yA k)

private lemma residueC_zC : residueC k (zC k) = 0 := by
  rw [zC, residueC_algebraMap, residueCQuot, Ideal.Quotient.lift_mk]
  simp [evalCQuot]

private lemma residueC_zCIndex (n : PNat) : residueC k (zCIndex k n) = 0 :=
  (residueC_aToC k _).trans (residueA_zA k n)

private lemma idealQC_le_ker_residueC :
    idealQC k ≤ RingHom.ker (residueC k) := by
  refine Ideal.span_le.mpr ?_
  rintro x (rfl | rfl | rfl | ⟨n, rfl⟩)
  exacts [residueC_xC k, residueC_yC k, residueC_zC k, residueC_zCIndex k n]

private lemma ker_residueC_eq_idealQC :
    RingHom.ker (residueC k) = idealQC k :=
  le_antisymm (residueC_ker_le_idealQC k) (idealQC_le_ker_residueC k)

private lemma idealQC_isPrime : (idealQC k).IsPrime := by
  rw [← ker_residueC_eq_idealQC k]
  exact RingHom.ker_isPrime (residueC k)

private lemma awayFromQC_subset_compl_idealQC :
    (awayFromQC k : Set (ringC k)) ⊆ {x : ringC k | x ∉ idealQC k} := by
  intro x hx
  induction hx using Submonoid.closure_induction with
  | mem x hx => exact hx
  | one =>
      intro h
      rw [← ker_residueC_eq_idealQC k] at h
      have hz : residueC k (1 : ringC k) = 0 := RingHom.mem_ker.mp h
      exact (one_ne_zero (show (1 : k) = 0 by simp at hz))
  | mul a b _ _ ha hb =>
      intro h
      rcases (idealQC_isPrime k).mem_or_mem h with h | h
      · exact ha h
      · exact hb h

private lemma ker_localizationMap_le_idealQC :
    RingHom.ker (localizationMap k) ≤ idealQC k := by
  intro c hc
  have hzero : localizationMap k c = localizationMap k 0 := by
    simpa using RingHom.mem_ker.mp hc
  obtain ⟨s, hs⟩ :=
    (IsLocalization.eq_iff_exists (awayFromQC k) (cAtQC k)).mp hzero
  have hprod : (s : ringC k) * c ∈ idealQC k := by
    rw [hs]
    simp
  rcases (idealQC_isPrime k).mem_or_mem hprod with hsQ | hcQ
  · exact (awayFromQC_subset_compl_idealQC k s.property hsQ).elim
  · exact hcQ

private lemma ker_cToB_le_idealQC :
    RingHom.ker (cToB k) ≤ idealQC k := by
  rw [cToB, RingHom.ker_rangeRestrict]
  exact ker_localizationMap_le_idealQC k

private lemma prove_idealQB_isPrime : (idealQB k).IsPrime := by
  let : (idealQC k).IsPrime := idealQC_isPrime k
  exact Ideal.map_isPrime_of_surjective (RingHom.rangeRestrict_surjective _)
    (ker_cToB_le_idealQC k)

private lemma factor_not_mem_idealQC (n : PNat) :
    xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1 ∉ idealQC k := by
  intro h
  have heval := RingHom.mem_ker.mp ((idealQC_le_ker_residueC k) h)
  have hzero : residueC k
      (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) = 0 := heval
  have hone : residueC k
      (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) = 1 := by
    simp [map_add, map_mul, residueC_xC, residueC_zC]
  exact one_ne_zero (hone.symm.trans hzero)

private lemma xi_mem_ker_cToB (n : PNat) : xi k n ∈ RingHom.ker (cToB k) := by
  let h : ringC k := xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1
  have hS : h ∈ awayFromQC k := Submonoid.subset_closure (factor_not_mem_idealQC k n)
  have hu : IsUnit (algebraMap (ringC k) (cAtQC k) h) :=
    IsLocalization.map_units (cAtQC k) ⟨h, hS⟩
  have hz : localizationMap k (xi k n) * localizationMap k h = 0 := by
    simpa [localizationMap, h, map_mul] using
      congrArg (localizationMap k) (xi_mul_factor_eq_zero k n)
  have hz' : localizationMap k (xi k n) * localizationMap k h =
      0 * localizationMap k h := by simpa using hz
  have hloc : localizationMap k (xi k n) = 0 := hu.mul_right_cancel hz'
  show xi k n ∈ RingHom.ker ((localizationMap k).rangeRestrict)
  rw [RingHom.ker_rangeRestrict]
  exact RingHom.mem_ker.mpr hloc

private lemma span_xi_le_ker_cToB :
    Ideal.span (Set.range (xi k)) ≤ RingHom.ker (cToB k) := by
  apply Ideal.span_le.mpr
  rintro x ⟨n, rfl⟩
  exact xi_mem_ker_cToB k n

private lemma unit_of_close_unit {a c : ringA k} (hc : IsUnit c)
    (hd : a - c ∈ idealI k) : IsUnit a := by
  let t : ringA k := (↑(hc.unit⁻¹) : ringA k) * (a - c)
  have ht : t ∈ idealI k := Ideal.mul_mem_left (idealI k) _ hd
  have ht2 : t * t = 0 := by
    have hmem : t * t ∈ idealI k * idealI k := Ideal.mul_mem_mul ht ht
    rw [idealI_sq k] at hmem
    exact Ideal.mem_bot.mp hmem
  have hnil : IsNilpotent t := ⟨2, by simpa [pow_two] using ht2⟩
  have hct : c * t = a - c := by
    dsimp only [t]
    rw [← mul_assoc, hc.mul_val_inv, one_mul]
  rw [show a = c * (1 + t) by rw [mul_add, hct]; ring]
  exact hc.mul hnil.isUnit_one_add

private lemma ringA_local : IsLocalRing (ringA k) := by
  let : IsLocalRing (baseRing k) := baseRing_isLocal k
  let : Nontrivial (ringA k) := nontrivial_of_ne (0 : ringA k) 1 (by
    intro h
    have h1 : Ideal.Quotient.mk (relationIdeal k)
        (1 : MvPolynomial PNat (baseRing k)) = 0 := by simpa using h.symm
    have hmem : (1 : MvPolynomial PNat (baseRing k)) ∈ relationIdeal k :=
      Ideal.Quotient.eq_zero_iff_mem.mp h1
    have hz := evalZero_relation k 1 hmem
    have hz' : (1 : baseRing k) = 0 := by simp [evalZero] at hz
    exact zero_ne_one hz'.symm)
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self ?_
  intro a
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  let c : ringA k := baseToA k (evalZero k p)
  have hd : Ideal.Quotient.mk (relationIdeal k) p - c ∈ idealI k := by
    simpa [c] using sub_residue_mem_idealI k p
  rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (evalZero k p) with h | h
  · exact Or.inl (unit_of_close_unit k (RingHom.isUnit_map (baseToA k) h) hd)
  · apply Or.inr
    let q : MvPolynomial PNat (baseRing k) := 1 - p
    have hq := sub_residue_mem_idealI k q
    have hqmem : (1 - Ideal.Quotient.mk (relationIdeal k) p) -
        baseToA k (1 - evalZero k p) ∈ idealI k := by
      simpa [q, evalZero, map_sub] using hq
    exact unit_of_close_unit k (RingHom.isUnit_map (baseToA k) h) hqmem

private lemma residueA_surjective : Function.Surjective (residueA k) := by
  intro b
  refine ⟨baseToA k (algebraMap (PlanePolynomial k) (baseRing k) (MvPolynomial.C b)), ?_⟩
  rw [residueA_baseToA_algebraMap]
  simp [residueEval]

private lemma idealMaxA_eq_maximalIdeal :
    letI := ringA_local k
    idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k)) =
      IsLocalRing.maximalIdeal (ringA k) := by
  let : IsLocalRing (ringA k) := ringA_local k
  have hmax : (idealI k ⊔ Ideal.span ({xA k, yA k} : Set (ringA k))).IsMaximal := by
    rw [← ker_residueA_eq_idealMaxA k]
    exact RingHom.ker_isMaximal_of_surjective (residueA k) (residueA_surjective k)
  exact IsLocalRing.eq_maximalIdeal hmax

private lemma idealQC_comap_aToC_eq_ker_residueA :
    (idealQC k).comap (aToC k) = RingHom.ker (residueA k) := by
  ext a
  show aToC k a ∈ idealQC k ↔ residueA k a = 0
  rw [← ker_residueC_eq_idealQC k, RingHom.mem_ker, residueC_aToC]

private lemma idealQB_comap_cToB :
    (idealQB k).comap (cToB k) = idealQC k := by
  rw [idealQB, Ideal.comap_map_of_surjective (cToB k)
      (RingHom.rangeRestrict_surjective _) (idealQC k),
    ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr (ker_cToB_le_idealQC k)]

private lemma prove_idealQB_comap_eq_maximalIdeal :
    letI := ringA_local k
    (idealQB k).comap (aToB k) = IsLocalRing.maximalIdeal (ringA k) := by
  let : IsLocalRing (ringA k) := ringA_local k
  rw [aToB, ← Ideal.comap_comap (aToC k) (cToB k), idealQB_comap_cToB,
    idealQC_comap_aToC_eq_ker_residueA, ker_residueA_eq_idealMaxA, idealMaxA_eq_maximalIdeal]

private abbrev awayFromQB : Submonoid (ringB k) :=
  Submonoid.closure {b : ringB k | b ∉ idealQB k}

private def bToCAtQC : ringB k →+* cAtQC k := (ringB k).subtype

private lemma bToCAtQC_units (s : awayFromQB k) : IsUnit (bToCAtQC k s) := by
  refine Submonoid.closure_induction ?_ ?_ ?_ s.property
  · intro b hb
    obtain ⟨c, rfl⟩ := RingHom.rangeRestrict_surjective (localizationMap k) b
    have hc : c ∉ idealQC k := by
      intro hc
      apply hb
      rw [idealQB]
      exact Ideal.mem_map_of_mem (cToB k) hc
    show IsUnit (localizationMap k c)
    exact IsLocalization.map_units (M := awayFromQC k) (S := cAtQC k)
      ⟨c, Submonoid.subset_closure hc⟩
  · simp [bToCAtQC]
  · intro a b _ _ ha hb
    simpa only [Submonoid.coe_mul, map_mul] using ha.mul hb

private noncomputable def mapBAtQBToCAtQC : bAtQB k →+* cAtQC k :=
  IsLocalization.lift (M := awayFromQB k) (S := bAtQB k) (g := bToCAtQC k)
    (bToCAtQC_units k)

private lemma cToB_mem_awayFromQB_of_not_mem_QC (c : ringC k)
    (hc : c ∉ idealQC k) : cToB k c ∈ awayFromQB k := by
  apply Submonoid.subset_closure
  intro h
  have h' : c ∈ (idealQB k).comap (cToB k) := h
  rw [idealQB_comap_cToB k] at h'
  exact hc h'

private lemma mapCAtQC_unit_of_awayFromQC (s : awayFromQC k) :
    IsUnit (algebraMap (ringB k) (bAtQB k) (cToB k s)) := by
  refine Submonoid.closure_induction ?_ ?_ ?_ s.property
  · intro c hc
    exact IsLocalization.map_units (M := awayFromQB k) (S := bAtQB k)
      ⟨cToB k c, cToB_mem_awayFromQB_of_not_mem_QC k c hc⟩
  · simp
  · intro a b _ _ ha hb
    simpa only [Submonoid.coe_mul, map_mul] using ha.mul hb

private noncomputable def mapCAtQCToBAtQB : cAtQC k →+* bAtQB k :=
  IsLocalization.lift (M := awayFromQC k) (S := cAtQC k)
    (g := (algebraMap (ringB k) (bAtQB k)).comp (cToB k))
    (mapCAtQC_unit_of_awayFromQC k)

@[simp] private lemma mapBAtQBToCAtQC_algebraMap (b : ringB k) :
    mapBAtQBToCAtQC k (algebraMap (ringB k) (bAtQB k) b) = bToCAtQC k b :=
  IsLocalization.lift_eq _ _

@[simp] private lemma mapCAtQCToBAtQB_algebraMap (c : ringC k) :
    mapCAtQCToBAtQB k (algebraMap (ringC k) (cAtQC k) c) =
      algebraMap (ringB k) (bAtQB k) (cToB k c) :=
  IsLocalization.lift_eq _ _

private lemma mapBAtQBToCAtQC_comp_mapCAtQCToBAtQB :
    (mapBAtQBToCAtQC k).comp (mapCAtQCToBAtQB k) = RingHom.id (cAtQC k) := by
  apply IsLocalization.ringHom_ext (M := awayFromQC k) (S := cAtQC k)
  ext c
  simp only [RingHom.comp_apply, RingHom.id_apply,
    mapCAtQCToBAtQB_algebraMap, mapBAtQBToCAtQC_algebraMap,
    bToCAtQC]
  show (ringB k).subtype ((cToB k) c) = algebraMap (ringC k) (cAtQC k) c
  rfl

private lemma mapCAtQCToBAtQB_comp_mapBAtQBToCAtQC :
    (mapCAtQCToBAtQB k).comp (mapBAtQBToCAtQC k) = RingHom.id (bAtQB k) := by
  apply IsLocalization.ringHom_ext (M := awayFromQB k) (S := bAtQB k)
  ext b
  obtain ⟨c, rfl⟩ := RingHom.rangeRestrict_surjective (localizationMap k) b
  simp only [RingHom.comp_apply, RingHom.id_apply,
    mapBAtQBToCAtQC_algebraMap, bToCAtQC]
  show mapCAtQCToBAtQB k (algebraMap (ringC k) (cAtQC k) c) =
    algebraMap (ringB k) (bAtQB k) (cToB k c)
  exact mapCAtQCToBAtQB_algebraMap k c

private noncomputable def construct_bAtQB_equiv_cAtQC : bAtQB k ≃+* cAtQC k :=
  RingEquiv.ofBijective (mapBAtQBToCAtQC k) ⟨by
    intro x y hxy
    have hx : mapCAtQCToBAtQB k (mapBAtQBToCAtQC k x) = x := by
      change ((mapCAtQCToBAtQB k).comp (mapBAtQBToCAtQC k)) x = x
      rw [mapCAtQCToBAtQB_comp_mapBAtQBToCAtQC]
      rfl
    have hy : mapCAtQCToBAtQB k (mapBAtQBToCAtQC k y) = y := by
      change ((mapCAtQCToBAtQB k).comp (mapBAtQBToCAtQC k)) y = y
      rw [mapCAtQCToBAtQB_comp_mapBAtQBToCAtQC]
      rfl
    calc
      x = mapCAtQCToBAtQB k (mapBAtQBToCAtQC k x) := hx.symm
      _ = mapCAtQCToBAtQB k (mapBAtQBToCAtQC k y) := congrArg _ hxy
      _ = y := hy,
    fun y => ⟨mapCAtQCToBAtQB k y, by
      change ((mapBAtQBToCAtQC k).comp (mapCAtQCToBAtQB k)) y = y
      rw [mapBAtQBToCAtQC_comp_mapCAtQCToBAtQB]
      rfl⟩⟩

private lemma prove_aToB_finiteType : (aToB k).FiniteType := by
  let : Algebra.FiniteType (ringA k) (ringA k) :=
    Module.Finite.finiteType (A := ringA k)
  have hpoly :
      RingHom.FiniteType (MvPolynomial.C : ringA k →+* MvPolynomial Unit (ringA k)) := by
    have h : RingHom.FiniteType
        (algebraMap (ringA k) (MvPolynomial Unit (ringA k))) :=
      RingHom.finiteType_algebraMap.mpr (by infer_instance)
    simpa using h
  have hquot :
      RingHom.FiniteType (Ideal.Quotient.mk (cRelationIdeal k) :
        MvPolynomial Unit (ringA k) →+* cQuotient k) :=
    RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective
  have hpre : RingHom.FiniteType
      ((Ideal.Quotient.mk (cRelationIdeal k)).comp (MvPolynomial.C :
        ringA k →+* MvPolynomial Unit (ringA k))) := hquot.comp hpoly
  let : Algebra.FiniteType (cQuotient k) (cQuotient k) :=
    Module.Finite.finiteType (A := cQuotient k)
  have haway : RingHom.FiniteType (algebraMap (cQuotient k) (ringC k)) :=
    RingHom.finiteType_algebraMap.mpr (by infer_instance)
  have htoC : (aToC k).FiniteType := by
    show RingHom.FiniteType ((algebraMap (cQuotient k) (ringC k)).comp
      ((Ideal.Quotient.mk (cRelationIdeal k)).comp (MvPolynomial.C :
        ringA k →+* MvPolynomial Unit (ringA k))))
    exact haway.comp hpre
  have htoB : (cToB k).FiniteType :=
    RingHom.FiniteType.of_surjective _ (RingHom.rangeRestrict_surjective _)
  exact htoB.comp htoC

private lemma prove_aToC_etale : (aToC k).Etale := by
  classical
  let f : Unit → MvPolynomial Unit (ringA k) := fun _ => cRelation k
  have hI : cRelationIdeal k = Ideal.span (Set.range f) := by
    simp [cRelationIdeal, f, Set.range]
  let D := MvPolynomial Unit (ringA k) ⧸ Ideal.span (Set.range f)
  let e : D ≃ₐ[ringA k] cQuotient k :=
    (Ideal.quotientEquivAlgOfEq (ringA k) hI).symm
  let : Module (ringA k) (ringC k) := inferInstance
  let : Algebra (ringA k) (ringC k) :=
    Algebra.ofModule (fun r x y => smul_mul_assoc r x y)
      (fun r x y => mul_smul_comm r x y)
  let P0 : Algebra.PreSubmersivePresentation (ringA k) D Unit Unit :=
    Algebra.PreSubmersivePresentation.naive (R := ringA k) (v := f) id
      Function.injective_id
  let P : Algebra.PreSubmersivePresentation (ringA k) (cQuotient k) Unit Unit :=
    P0.ofAlgEquiv e
  let Q : Algebra.SubmersivePresentation (cQuotient k) (ringC k) Unit Unit :=
    Algebra.SubmersivePresentation.localizationAway (ringC k) (cDenominator k)
  have hPjac : P.jacobian = cDenominator k := by
    show (P0.ofAlgEquiv e).jacobian = cDenominator k
    rw [Algebra.PreSubmersivePresentation.jacobian_ofAlgEquiv]
    have h0 : P0.jacobian =
        Ideal.Quotient.mk (Ideal.span (Set.range f))
          (2 * MvPolynomial.C (xA k) * MvPolynomial.X () + 1) := by
      unfold P0
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      have hm : (Algebra.PreSubmersivePresentation.naive
          (R := ringA k) (v := f) id Function.injective_id).jacobiMatrix =
          fun _ _ => (f ()).pderiv () := by
        ext i j
        simp [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
      rw [hm]
      have hdet : Matrix.det (fun _ _ : Unit => (f ()).pderiv ()) =
          (f ()).pderiv () := Matrix.det_unique _
      rw [hdet]
      show Ideal.Quotient.mk (Ideal.span (Set.range f)) ((f ()).pderiv ()) =
        Ideal.Quotient.mk (Ideal.span (Set.range f))
          (2 * MvPolynomial.C (xA k) * MvPolynomial.X () + 1)
      simp [f, cRelation]
      congr 1
      ring
    rw [h0]
    show (Ideal.quotientEquivAlgOfEq (ringA k) hI).symm
        (Ideal.Quotient.mk (Ideal.span (Set.range f))
          (2 * MvPolynomial.C (xA k) * MvPolynomial.X () + 1)) = cDenominator k
    rw [Ideal.quotientEquivAlgOfEq_symm, Ideal.quotientEquivAlgOfEq_mk]
    rfl
  let Pcomp := Q.toPreSubmersivePresentation.comp P
  have hdim : Pcomp.dimension = 0 := by
    simp [Algebra.Presentation.dimension]
  have hstd : Algebra.IsStandardSmoothOfRelativeDimension 0 (ringA k) (ringC k) := by
    let SP : Algebra.SubmersivePresentation (ringA k) (ringC k)
        (Unit ⊕ Unit) (Unit ⊕ Unit) := {
      toPreSubmersivePresentation := Pcomp
      jacobian_isUnit := by
        show IsUnit (Q.toPreSubmersivePresentation.comp P).jacobian
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.smul_def]
        have hPunit : IsUnit (algebraMap (cQuotient k) (ringC k) P.jacobian) := by
          rw [hPjac]
          have hQjac : Q.jacobian =
              algebraMap (cQuotient k) (ringC k) (cDenominator k) := by
            show (Algebra.PreSubmersivePresentation.localizationAway
              (ringC k) (cDenominator k)).jacobian = _
            rw [Algebra.PreSubmersivePresentation.localizationAway_jacobian]
          rw [← hQjac]
          exact Q.jacobian_isUnit
        exact hPunit.mul Q.jacobian_isUnit
    }
    exact SP.isStandardSmoothOfRelativeDimension hdim
  have hEtale : (algebraMap (ringA k) (ringC k)).Etale :=
    RingHom.etale_algebraMap.mpr
      (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hstd)
  have hmap : algebraMap (ringA k) (ringC k) = aToC k := by
    have hq : algebraMap (ringA k) (cQuotient k) =
        (Ideal.Quotient.mk (cRelationIdeal k)).comp MvPolynomial.C := rfl
    rw [IsScalarTower.algebraMap_eq (R := ringA k) (S := cQuotient k)
      (A := ringC k)]
    simp [aToC, hq]
  rw [hmap] at hEtale
  exact hEtale

private lemma sub_base_evalA0_mem (a : ringA k) :
    a - baseToA k (evalA0 k a) ∈ idealI k := by
  rw [← ker_evalA0_eq_idealI, RingHom.mem_ker, map_sub, evalA0_base, sub_self]

private lemma mem_idealP_iff (n : PNat) (a : ringA k) :
    a ∈ idealP k n ↔ evalA0 k a ∈ Ideal.span ({f k n} : Set (baseRing k)) := by
  constructor
  · intro ha
    have h : idealP k n ≤
        (Ideal.span ({f k n} : Set (baseRing k))).comap (evalA0 k) := by
      apply sup_le
      · rw [← ker_evalA0_eq_idealI]
        exact Ideal.comap_mono bot_le
      · rw [Ideal.span_le]
        rintro _ rfl
        show evalA0 k (baseToA k (f k n)) ∈ Ideal.span ({f k n} : Set (baseRing k))
        rw [evalA0_base]
        exact Ideal.subset_span (Set.mem_singleton _)
    exact h ha
  · intro ha
    have hb : baseToA k (evalA0 k a) ∈ idealP k n := by
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp ha
      rw [hb, map_mul, mul_comm]
      exact Ideal.mul_mem_left _ _ (fA_mem_idealP k n)
    simpa only [sub_add_cancel] using
      (idealP k n).add_mem
        ((show idealI k ≤ idealP k n from le_sup_left) (sub_base_evalA0_mem k a)) hb

private abbrev coefficientQuotient (n : PNat) :=
  baseRing k ⧸ Ideal.span ({f k n} : Set (baseRing k))

private def coefficientPolynomial (n : PNat) :
    MvPolynomial PNat (baseRing k) →+*
      TrivSqZeroExt (coefficientQuotient k n) (coefficientQuotient k n) := by
  classical
  exact MvPolynomial.eval₂Hom (R := baseRing k)
    (S₁ := TrivSqZeroExt (coefficientQuotient k n) (coefficientQuotient k n))
    ((TrivSqZeroExt.inlHom (coefficientQuotient k n) (coefficientQuotient k n)).comp
      (Ideal.Quotient.mk (Ideal.span ({f k n} : Set (baseRing k)))))
    (fun i => if i = n then TrivSqZeroExt.inr (1 : coefficientQuotient k n) else 0)

private lemma coefficientPolynomial_relation (n : PNat) :
    relationIdeal k ≤ RingHom.ker (coefficientPolynomial k n) := by
  classical
  apply Ideal.span_le.mpr
  rintro _ (⟨⟨i, j⟩, rfl⟩ | ⟨i, rfl⟩)
  · show coefficientPolynomial k n (MvPolynomial.X i * MvPolynomial.X j) = 0
    by_cases hi : i = n <;> by_cases hj : j = n <;>
      simp [coefficientPolynomial, hi, hj]
  · simp only [coefficientPolynomial]
    by_cases hi : i = n
    · subst i
      have hf : (Ideal.Quotient.mk
          (Ideal.span ({f k n} : Set (baseRing k)))) (f k n) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      simp [hf]
    · simp [hi]

private def coefficientA (n : PNat) :
    ringA k →+* TrivSqZeroExt (coefficientQuotient k n) (coefficientQuotient k n) :=
  Ideal.Quotient.lift (relationIdeal k) (coefficientPolynomial k n)
    (fun _ h => coefficientPolynomial_relation k n h)

private lemma coefficientA_zA (n i : PNat) :
    coefficientA k n (zA k i) =
      if i = n then TrivSqZeroExt.inr 1 else 0 := by
  classical
  simp [coefficientA, zA, coefficientPolynomial]

private lemma coefficientA_fst (n : PNat) (a : ringA k) :
    (coefficientA k n a).fst =
      Ideal.Quotient.mk (Ideal.span ({f k n} : Set (baseRing k))) (evalA0 k a) := by
  classical
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  show (coefficientPolynomial k n p).fst = Ideal.Quotient.mk _ (evalZero k p)
  have h : ((TrivSqZeroExt.fstHom (coefficientQuotient k n) (coefficientQuotient k n)
        (coefficientQuotient k n)).toRingHom).comp (coefficientPolynomial k n) =
      (Ideal.Quotient.mk (Ideal.span ({f k n} : Set (baseRing k)))).comp (evalZero k) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [coefficientPolynomial, evalZero]
    · intro i
      by_cases hi : i = n <;> simp [coefficientPolynomial, evalZero, hi]
  exact RingHom.congr_fun h p

private lemma annihilator_zA (n : PNat) :
    (Ideal.span ({zA k n} : Set (ringA k))).annihilator = idealP k n := by
  ext a
  rw [Submodule.mem_annihilator_span_singleton]
  show a * zA k n = 0 ↔ _
  constructor
  · intro h
    have he := congrArg (fun b => (coefficientA k n b).snd) h
    rw [map_mul, coefficientA_zA, ite_eq_left rfl] at he
    have he' : Ideal.Quotient.mk (Ideal.span ({f k n} : Set (baseRing k))) (evalA0 k a) = 0 := by
      simpa [TrivSqZeroExt.snd_mul, coefficientA_fst] using he
    exact (mem_idealP_iff k n a).mpr (Ideal.Quotient.eq_zero_iff_mem.mp he')
  · intro ha
    have hI : idealP k n ≤
        (Ideal.span ({zA k n} : Set (ringA k))).annihilator := by
      apply sup_le
      · apply Ideal.span_le.mpr
        rintro _ ⟨i, rfl⟩
        exact (Submodule.mem_annihilator_span_singleton _ _).mpr (zA_mul_zA k i n)
      · apply Ideal.span_le.mpr
        rintro _ rfl
        exact (Submodule.mem_annihilator_span_singleton _ _).mpr
          (by change fA k n * zA k n = 0; simpa only [mul_comm] using zA_mul_fA k n)
    exact (Submodule.mem_annihilator_span_singleton _ _).mp (hI ha)

private lemma annihilator_span_map_of_flat {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] (a : R) :
    (Ideal.span ({algebraMap R S a} : Set S)).annihilator =
      ((Ideal.span ({a} : Set R)).annihilator).map (algebraMap R S) := by
  rw [Ideal.annihilator_span_singleton_eq_torsionOf,
    Ideal.annihilator_span_singleton_eq_torsionOf, ann_extension_eq_ann_baseChange_elem]
  ext b
  rw [Ideal.mem_torsionOf_iff, Ideal.mem_torsionOf_iff]
  let e := TensorProduct.AlgebraTensorModule.rid R S S
  rw [← e.injective.eq_iff]
  simp [e, Algebra.smul_def, mul_comm]

private lemma iSupIndep_map_of_flat {R S ι : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] {I : ι → Ideal R} (h : iSupIndep I) :
    iSupIndep (fun i => (I i).map (algebraMap R S)) := by
  intro i
  rw [disjoint_iff]
  show (I i).map (algebraMap R S) ⊓
    (⨆ j, ⨆ (_ : j ≠ i), (I j).map (algebraMap R S)) = ⊥
  simp_rw [← Ideal.map_iSup]
  rw [← map_inf_of_flat, (h i).eq_bot, Ideal.map_bot]

/-- Extension along `aToC` preserves annihilators of elements and independence of ideals. -/
private lemma map_aToC_of_flat :
    (∀ a : ringA k, (Ideal.span ({aToC k a} : Set (ringC k))).annihilator =
      ((Ideal.span ({a} : Set (ringA k))).annihilator).map (aToC k)) ∧
    ∀ I : PNat → Ideal (ringA k), iSupIndep I → iSupIndep (fun n => (I n).map (aToC k)) := by
  have hf := (RingHom.Etale.iff_flat_and_formallyUnramified.mp (prove_aToC_etale k)).1
  let : Algebra (ringA k) (ringC k) :=
    Algebra.ofModule (fun r x y => smul_mul_assoc r x y)
      (fun r x y => mul_smul_comm r x y)
  have hmap : algebraMap (ringA k) (ringC k) = aToC k := by
    rw [IsScalarTower.algebraMap_eq (ringA k) (cQuotient k) (ringC k)]
    rfl
  have hf' : (algebraMap (ringA k) (ringC k)).Flat := hmap.symm ▸ hf
  let : Module.Flat (ringA k) (ringC k) := RingHom.flat_algebraMap_iff.mp hf'
  exact ⟨fun a => by simpa only [hmap] using annihilator_span_map_of_flat (S := ringC k) a,
    fun I h => by simpa only [hmap] using iSupIndep_map_of_flat (S := ringC k) h⟩

private lemma prove_annihilator_zCIndex (n : PNat) :
    (Ideal.span ({zCIndex k n} : Set (ringC k))).annihilator =
      (idealP k n).map (aToC k) := by
  rw [← annihilator_zA, zCIndex]
  exact (map_aToC_of_flat k).1 (zA k n)

private lemma iSupIndep_span_zA :
    iSupIndep (fun n : PNat => Ideal.span ({zA k n} : Set (ringA k))) := by
  classical
  intro n
  apply Submodule.disjoint_def.mpr
  intro a ha hb
  have hker : (⨆ (j : PNat) (_ : j ≠ n),
      Ideal.span ({zA k j} : Set (ringA k))) ≤ RingHom.ker (coefficientA k n) := by
    refine iSup_le fun j => iSup_le fun hj => Ideal.span_le.mpr ?_
    rintro _ rfl
    show coefficientA k n (zA k j) = 0
    rw [coefficientA_zA, ite_eq_right hj]
  have ha0 : coefficientA k n a = 0 := hker hb
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp ha
  have hb0 := congrArg TrivSqZeroExt.snd ha0
  rw [map_mul, coefficientA_zA, ite_eq_left rfl] at hb0
  have hbm : b ∈ idealP k n := (mem_idealP_iff k n b).mpr
    (Ideal.Quotient.eq_zero_iff_mem.mp (by
      simpa [TrivSqZeroExt.snd_mul, coefficientA_fst] using hb0))
  rw [← annihilator_zA] at hbm
  simpa only [smul_eq_mul, mul_comm] using (Submodule.mem_annihilator_span_singleton _ _).mp hbm

private lemma iSupIndep_span_zCIndex :
    iSupIndep (fun n : PNat => Ideal.span ({zCIndex k n} : Set (ringC k))) := by
  simpa only [Ideal.map_span, Set.image_singleton, zCIndex] using
    (map_aToC_of_flat k).2 _ (iSupIndep_span_zA k)

private lemma prove_iSupIndep_span_xi :
    iSupIndep (fun n : PNat => Ideal.span ({xi k n} : Set (ringC k))) := by
  refine (iSupIndep_span_zCIndex k).mono fun n => Ideal.span_le.mpr ?_
  rintro _ rfl
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))

private lemma prove_awayIndependent (g : ringC k) :
    iSupIndep (fun n : {n : PNat // g ∉ idealQ k n} =>
      Ideal.span ({algebraMap (ringC k) (Localization.Away g) (xi k n.1)} :
        Set (Localization.Away g))) := by
  have h := (prove_iSupIndep_span_xi k).comp
    (Subtype.coe_injective (p := fun n => g ∉ idealQ k n))
  simpa only [Function.comp_apply, Ideal.map_span, Set.image_singleton] using
    iSupIndep_map_of_flat (S := Localization.Away g) h

private lemma ker_awayMap_eq_span_of_ker_eq_span {R S ι : Type*}
    [CommRing R] [CommRing S] (f : R →+* S) (v : ι → R) (Q : ι → Ideal R)
    (hQ : ∀ i, Q i ≤ (Ideal.span ({v i} : Set R)).annihilator)
    (hker : RingHom.ker f = Ideal.span (Set.range v)) (g : R) :
    RingHom.ker (Localization.awayMap f g) =
      Ideal.span ((fun i : {i : ι // g ∉ Q i} =>
        algebraMap R (Localization.Away g) (v i.1)) '' Set.univ) := by
  have hmap : RingHom.ker (Localization.awayMap f g) =
      (RingHom.ker f).map (algebraMap R (Localization.Away g)) :=
    IsLocalization.ker_map (Localization.Away (f g)) f (Submonoid.map_powers f g)
  rw [hmap, hker, Ideal.map_span]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    by_cases hi : g ∈ Q i
    · have hzero : algebraMap R (Localization.Away g) (v i) = 0 := by
        have hmul : g * v i = 0 :=
          (Submodule.mem_annihilator_span_singleton _ _).mp (hQ i hi)
        have he := congrArg (algebraMap R (Localization.Away g)) hmul
        rw [map_mul, map_zero] at he
        exact (IsLocalization.Away.algebraMap_isUnit g).mul_right_eq_zero.mp he
      rw [hzero]
      exact Ideal.zero_mem _
    · exact Ideal.subset_span ⟨⟨i, hi⟩, Set.mem_univ _, rfl⟩
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, _, rfl⟩
    exact Ideal.subset_span ⟨v i.1, ⟨i.1, rfl⟩, rfl⟩

private lemma cDerivative_isUnit : IsUnit (2 * xC k * zC k + 1) := by
  let : CommSemiring (ringC k) := (inferInstance : CommRing (ringC k)).toCommSemiring
  let : CommSemiring (cQuotient k) := (inferInstance : CommRing (cQuotient k)).toCommSemiring
  have h := IsLocalization.Away.algebraMap_isUnit (S := ringC k) (cDenominator k)
  have ht : (Ideal.Quotient.mk (cRelationIdeal k))
      (2 : MvPolynomial Unit (ringA k)) = 2 := map_ofNat _ 2
  have ht' : algebraMap (cQuotient k) (ringC k) (2 : cQuotient k) = 2 := map_ofNat _ 2
  simpa [cDenominator, xC, zC, aToC, ht, ht'] using h

private lemma idealR_sup_idealQ (n : PNat) : idealR k n ⊔ idealQ k n = ⊤ := by
  have hr : zC k - xC k ^ (n : ℕ) ∈ idealR k n ⊔ idealQ k n :=
    Ideal.mem_sup_left (zC_sub_pow_mem_idealR k n)
  have hq : xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1 ∈ idealR k n ⊔ idealQ k n :=
    Ideal.mem_sup_right (factor_mem_idealQ k n)
  apply Ideal.eq_top_of_isUnit_mem _ (x := 2 * xC k * zC k + 1) _
    (cDerivative_isUnit k)
  convert (idealR k n ⊔ idealQ k n).add_mem
    ((idealR k n ⊔ idealQ k n).mul_mem_left (xC k) hr) hq using 1; ring

private lemma idealR_inf_idealQ (n : PNat) :
    idealR k n ⊓ idealQ k n = (idealP k n).map (aToC k) := by
  apply le_antisymm
  · rw [← Ideal.mul_eq_inf_of_coprime (idealR_sup_idealQ k n)]
    rw [idealR, idealQ, Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup]
    apply sup_le
    · exact sup_le Ideal.mul_le_left Ideal.mul_le_left
    · apply sup_le Ideal.mul_le_right
      rw [Ideal.span_singleton_mul_span_singleton, Ideal.span_le]
      rintro _ rfl
      rw [factor_relation]
      exact Submodule.neg_mem _ (Ideal.mem_map_of_mem _ (fA_mem_idealP k n))
  · exact le_inf le_sup_left le_sup_left

private lemma quotient_idealP_equiv_quotientR_prod_quotientQ (n : PNat) :
    Nonempty ((ringC k ⧸ (idealP k n).map (aToC k)) ≃+*
      ((ringC k ⧸ idealR k n) × (ringC k ⧸ idealQ k n))) :=
  ⟨(Ideal.quotEquivOfEq (idealR_inf_idealQ k n).symm).trans
    (Ideal.quotientInfEquivQuotientProd (idealR k n) (idealQ k n)
      (Ideal.isCoprime_iff_sup_eq.mpr (idealR_sup_idealQ k n)))⟩

private lemma prove_annihilator_xi (n : PNat) :
    (Ideal.span ({xi k n} : Set (ringC k))).annihilator = idealQ k n := by
  apply le_antisymm _ (idealQ_le_annihilator_xi k n)
  intro a ha
  rw [Submodule.mem_annihilator_span_singleton] at ha
  change a * xi k n = 0 at ha
  have haz : (a * (zC k - xC k ^ (n : ℕ))) * zCIndex k n = 0 := by
    simpa only [xi, mul_assoc] using ha
  have hap : a * (zC k - xC k ^ (n : ℕ)) ∈ (idealP k n).map (aToC k) := by
    rw [← prove_annihilator_zCIndex]
    exact (Submodule.mem_annihilator_span_singleton _ _).mpr haz
  have haq : a * (zC k - xC k ^ (n : ℕ)) ∈ idealQ k n :=
    (show (idealP k n).map (aToC k) ≤ idealQ k n from le_sup_left) hap
  have hmul : a * (2 * xC k * zC k + 1) ∈ idealQ k n := by
    convert (idealQ k n).add_mem ((idealQ k n).mul_mem_left (xC k) haq)
      ((idealQ k n).mul_mem_left a (factor_mem_idealQ k n)) using 1; ring
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have he := Ideal.Quotient.eq_zero_iff_mem.mpr hmul
  rw [map_mul] at he
  exact ((cDerivative_isUnit k).map (Ideal.Quotient.mk (idealQ k n))).mul_left_eq_zero.mp he

private def liftCQuotient {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0) : cQuotient k →+* T :=
  Ideal.Quotient.lift (cRelationIdeal k) (MvPolynomial.eval₂Hom φ (fun _ => t)) (by
    intro p hp
    have h : cRelationIdeal k ≤ RingHom.ker (MvPolynomial.eval₂Hom φ (fun _ : Unit => t)) := by
      apply Ideal.span_le.mpr
      rintro _ rfl
      change MvPolynomial.eval₂Hom φ (fun _ : Unit => t) (cRelation k) = 0
      simpa [cRelation] using ht
    exact h hp)

private lemma liftCQuotient_mk {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0) (p : MvPolynomial Unit (ringA k)) :
    liftCQuotient k φ t ht (Ideal.Quotient.mk (cRelationIdeal k) p) =
      MvPolynomial.eval₂Hom φ (fun _ => t) p :=
  rfl

private lemma liftCQuotient_cDenominator {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0) :
    liftCQuotient k φ t ht (cDenominator k) = 2 * φ (xA k) * t + 1 := by
  show liftCQuotient k φ t ht (Ideal.Quotient.mk (cRelationIdeal k)
    (2 * MvPolynomial.C (xA k) * MvPolynomial.X () + 1)) = _
  rw [liftCQuotient_mk]
  simp

private def liftC {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0)
    (hd : IsUnit (2 * φ (xA k) * t + 1)) : ringC k →+* T :=
  IsLocalization.Away.lift (cDenominator k)
    (g := liftCQuotient k φ t ht) (by rw [liftCQuotient_cDenominator]; exact hd)

private lemma liftC_mk {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0)
    (hd : IsUnit (2 * φ (xA k) * t + 1)) (p : MvPolynomial Unit (ringA k)) :
    liftC k φ t ht hd (algebraMap (cQuotient k) (ringC k)
        (Ideal.Quotient.mk (cRelationIdeal k) p)) =
      MvPolynomial.eval₂Hom φ (fun _ => t) p := by
  rw [liftC, IsLocalization.Away.lift_eq, liftCQuotient_mk]

private lemma liftC_aToC {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0)
    (hd : IsUnit (2 * φ (xA k) * t + 1)) (a : ringA k) :
    liftC k φ t ht hd (aToC k a) = φ a := by
  rw [show aToC k a = algebraMap (cQuotient k) (ringC k)
      (Ideal.Quotient.mk (cRelationIdeal k) (MvPolynomial.C a)) from rfl, liftC_mk]
  simp

private lemma liftC_zC {T : Type*} [CommRing T] (φ : ringA k →+* T) (t : T)
    (ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0)
    (hd : IsUnit (2 * φ (xA k) * t + 1)) :
    liftC k φ t ht hd (zC k) = t := by
  rw [show zC k = algebraMap (cQuotient k) (ringC k)
      (Ideal.Quotient.mk (cRelationIdeal k) (MvPolynomial.X ())) from rfl, liftC_mk]
  simp

/-- Two ring maps out of `C` agree once they agree on `A` and on `z`. -/
lemma ringC_hom_ext {T : Type*} [CommRing T] {φ ψ : ringC k →+* T}
    (ha : φ.comp (aToC k) = ψ.comp (aToC k)) (hz : φ (zC k) = ψ (zC k)) : φ = ψ := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (cDenominator k))
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · exact RingHom.congr_fun ha
  · rintro ⟨⟩
    exact hz

private lemma isUnit_one_add_two_pow (n : PNat) :
    IsUnit (2 * xA k ^ ((n : ℕ) + 1) + 1) := by
  let p : PlanePolynomial k := 2 * MvPolynomial.X 0 ^ ((n : ℕ) + 1) + 1
  have hp : p ∈ originSubmonoid k := by
    show MvPolynomial.eval (0 : Fin 2 → k) p ∈ nonZeroDivisors k
    simp [p]
  have hu := (IsLocalization.map_units (baseRing k) ⟨p, hp⟩).map (baseToA k)
  have ht : algebraMap (PlanePolynomial k) (baseRing k) (2 : PlanePolynomial k) = 2 :=
    map_ofNat _ 2
  have ht' : baseToA k (2 : baseRing k) = 2 := map_ofNat _ 2
  simpa [p, xA, x0, ht, ht'] using hu

private lemma quotient_idealR_equiv_quotientP_A (n : PNat) :
    Nonempty ((ringC k ⧸ idealR k n) ≃+* (ringA k ⧸ idealP k n)) := by
  let q := Ideal.Quotient.mk (idealP k n)
  have hf : q (fA k n) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (fA_mem_idealP k n)
  have ht : q (xA k) * (q (xA k) ^ (n : ℕ)) ^ 2 + q (xA k) ^ (n : ℕ) +
      q (yA k) = 0 := by
    rw [fA_eq, map_add, map_add, map_pow, map_pow] at hf
    convert hf using 1; ring
  have hd : IsUnit (2 * q (xA k) * q (xA k) ^ (n : ℕ) + 1) := by
    have hu := (isUnit_one_add_two_pow k n).map q
    have he : q (2 * xA k ^ ((n : ℕ) + 1) + 1) =
        2 * q (xA k) * q (xA k) ^ (n : ℕ) + 1 := by
      simp only [map_add, map_mul, map_pow, map_one, map_ofNat]
      ring
    rwa [he] at hu
  let F := liftC k q (q (xA k) ^ (n : ℕ)) ht hd
  have hF : idealR k n ≤ RingHom.ker F := by
    apply sup_le
    · apply Ideal.map_le_iff_le_comap.mpr
      intro a ha
      show F (aToC k a) = 0
      rw [liftC_aToC]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    · apply Ideal.span_le.mpr
      rintro _ rfl
      show F (zC k - xC k ^ (n : ℕ)) = 0
      simp only [map_sub, map_pow, F, liftC_zC, xC, liftC_aToC, sub_self]
  let F' := Ideal.Quotient.lift (idealR k n) F (fun _ h => hF h)
  let qR := Ideal.Quotient.mk (idealR k n)
  have hG : idealP k n ≤ RingHom.ker (qR.comp (aToC k)) := fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr
      ((show (idealP k n).map (aToC k) ≤ idealR k n from le_sup_left) (Ideal.mem_map_of_mem _ ha))
  let G := Ideal.Quotient.lift (idealP k n) (qR.comp (aToC k)) (fun _ h => hG h)
  have hFG : F'.comp G = RingHom.id _ :=
    Ideal.Quotient.ringHom_ext (RingHom.ext fun a => liftC_aToC k q _ ht hd a)
  have hGF : G.comp F' = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply ringC_hom_ext k
    · apply RingHom.ext
      intro a
      show G (F (aToC k a)) = qR (aToC k a)
      rw [liftC_aToC]
      rfl
    · show G (F (zC k)) = qR (zC k)
      rw [liftC_zC, map_pow]
      show qR (xC k) ^ (n : ℕ) = qR (zC k)
      have hz : qR (zC k - xC k ^ (n : ℕ)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (zC_sub_pow_mem_idealR k n)
      exact (sub_eq_zero.mp (by simpa only [map_sub, map_pow] using hz)).symm
  exact ⟨.ofRingHom F' G hFG hGF⟩

private def lineToPlane : Polynomial k →+* PlanePolynomial k :=
  Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)

/-- The map `k[x,y] → k[X]` restricting the plane to the curve `y = -xⁿ - x^{2n+1}`, i.e.
`x ↦ X`, `y ↦ -Xⁿ - X^{2n+1}`. -/
def curveEval (n : PNat) : PlanePolynomial k →+* Polynomial k :=
  MvPolynomial.eval₂Hom Polynomial.C
    ![Polynomial.X, -Polynomial.X ^ (n : ℕ) - Polynomial.X ^ (2 * (n : ℕ) + 1)]

private lemma lineToPlane_eval_zero (p : Polynomial k) :
    MvPolynomial.eval (0 : Fin 2 → k) (lineToPlane k p) = p.eval 0 := by
  have h : (MvPolynomial.eval (0 : Fin 2 → k)).comp (lineToPlane k) =
      Polynomial.evalRingHom (0 : k) := by
    ext <;> simp [lineToPlane]
  exact RingHom.congr_fun h p

/-- Restriction to the curve commutes with evaluation at the origin. -/
lemma curveEval_eval_zero (n : PNat) (p : PlanePolynomial k) :
    (curveEval k n p).eval 0 = MvPolynomial.eval (0 : Fin 2 → k) p := by
  have h : (Polynomial.evalRingHom (0 : k)).comp (curveEval k n) =
      MvPolynomial.eval (0 : Fin 2 → k) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [curveEval]
    · intro i
      fin_cases i <;> simp [curveEval, n.ne_zero]
  exact RingHom.congr_fun h p

private def lineLocalBase : lineAtOrigin k →+* baseRing k :=
  IsLocalization.lift (M := Submonoid.comap
      (Polynomial.evalRingHom (0 : k)) (nonZeroDivisors k)) (S := lineAtOrigin k)
    (g := (algebraMap (PlanePolynomial k) (baseRing k)).comp
    (lineToPlane k)) (fun s => IsLocalization.map_units (M := originSubmonoid k) (baseRing k)
      ⟨lineToPlane k s, by
        change MvPolynomial.eval (0 : Fin 2 → k) (lineToPlane k s) ∈ nonZeroDivisors k
        rw [lineToPlane_eval_zero]
        exact s.property⟩)

private lemma lineLocalBase_algebraMap (p : Polynomial k) :
    lineLocalBase k (algebraMap (Polynomial k) (lineAtOrigin k) p) =
      algebraMap (PlanePolynomial k) (baseRing k) (lineToPlane k p) :=
  IsLocalization.lift_eq _ _

private def curveBase (n : PNat) : baseRing k →+* lineAtOrigin k :=
  IsLocalization.lift (M := originSubmonoid k) (S := baseRing k)
    (g := (algebraMap (Polynomial k) (lineAtOrigin k)).comp
    (curveEval k n)) (fun s => IsLocalization.map_units (M := Submonoid.comap
        (Polynomial.evalRingHom (0 : k)) (nonZeroDivisors k)) (lineAtOrigin k)
      ⟨curveEval k n s, by
        change (curveEval k n s).eval 0 ∈ nonZeroDivisors k
        rw [curveEval_eval_zero]
        exact s.property⟩)

private lemma curveBase_algebraMap (n : PNat) (p : PlanePolynomial k) :
    curveBase k n (algebraMap (PlanePolynomial k) (baseRing k) p) =
      algebraMap (Polynomial k) (lineAtOrigin k) (curveEval k n p) :=
  IsLocalization.lift_eq _ _

private lemma curveBase_f (n : PNat) : curveBase k n (f k n) = 0 := by
  simp [f, x0, y0, map_add, map_pow, curveBase_algebraMap, curveEval]
  ring

private lemma coefficientQuotient_equiv_lineAtOrigin (n : PNat) :
    Nonempty (coefficientQuotient k n ≃+* lineAtOrigin k) := by
  let I : Ideal (baseRing k) := Ideal.span {f k n}
  let q := Ideal.Quotient.mk I
  have hI : I ≤ RingHom.ker (curveBase k n) := by
    apply Ideal.span_le.mpr
    rintro _ rfl
    exact curveBase_f k n
  let F := Ideal.Quotient.lift I (curveBase k n) (fun _ h => hI h)
  let G := q.comp (lineLocalBase k)
  have hFG : F.comp G = RingHom.id _ := by
    apply IsLocalization.ringHom_ext
      (Submonoid.comap (Polynomial.evalRingHom (0 : k)) (nonZeroDivisors k))
    ext c
    · show curveBase k n (lineLocalBase k
        (algebraMap (Polynomial k) (lineAtOrigin k) (Polynomial.C c))) = _
      rw [lineLocalBase_algebraMap, curveBase_algebraMap]
      simp [lineToPlane, curveEval]
    · show curveBase k n (lineLocalBase k
        (algebraMap (Polynomial k) (lineAtOrigin k) Polynomial.X)) = _
      rw [lineLocalBase_algebraMap, curveBase_algebraMap]
      simp [lineToPlane, curveEval]
  have hGF : G.comp F = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply IsLocalization.ringHom_ext (originSubmonoid k)
    apply MvPolynomial.ringHom_ext
    · intro c
      show q (lineLocalBase k (curveBase k n
        (algebraMap (PlanePolynomial k) (baseRing k) (MvPolynomial.C c)))) = _
      rw [curveBase_algebraMap, lineLocalBase_algebraMap]
      simp [lineToPlane, curveEval, q]
    · intro i
      fin_cases i
      · show q (lineLocalBase k (curveBase k n
          (algebraMap (PlanePolynomial k) (baseRing k) (MvPolynomial.X 0)))) = _
        rw [curveBase_algebraMap, lineLocalBase_algebraMap]
        simp [lineToPlane, curveEval, q]
      · have hf : q (f k n) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        simp only [f, map_add, map_pow] at hf
        show q (lineLocalBase k (curveBase k n
          (algebraMap (PlanePolynomial k) (baseRing k) (MvPolynomial.X 1)))) = _
        rw [curveBase_algebraMap, lineLocalBase_algebraMap]
        simp only [curveEval, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X,
          Matrix.cons_val_one, Matrix.cons_val_zero, lineToPlane,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, map_sub, map_neg, map_pow]
        show -q (x0 k) ^ (n : ℕ) - q (x0 k) ^ (2 * (n : ℕ) + 1) = q (y0 k)
        linear_combination -hf
  exact ⟨.ofRingHom F G hFG hGF⟩

private lemma prove_quotientR (n : PNat) :
    Nonempty ((ringC k ⧸ idealR k n) ≃+* lineAtOrigin k) := by
  obtain ⟨e⟩ := quotient_idealR_equiv_quotientP_A k n
  obtain ⟨e'⟩ := coefficientQuotient_equiv_lineAtOrigin k n
  exact ⟨e.trans ((ringA_quotient_idealP_equiv_base k n).trans e')⟩

private lemma lineAtOrigin_isDomain : IsDomain (lineAtOrigin k) := by
  apply IsLocalization.isDomain_of_le_nonZeroDivisors
    (M := Submonoid.comap (Polynomial.evalRingHom (0 : k)) (nonZeroDivisors k))
  intro p hp
  apply mem_nonZeroDivisors_iff_ne_zero.mpr
  intro he
  subst p
  simp at hp

private lemma idealR_isPrime (n : PNat) : (idealR k n).IsPrime := by
  let := lineAtOrigin_isDomain k
  obtain ⟨e⟩ := prove_quotientR k n
  have he : RingHom.ker (e.toRingHom.comp (Ideal.Quotient.mk (idealR k n))) =
      idealR k n := by
    rw [RingHom.ker_comp_of_injective _ e.injective, Ideal.mk_ker]
  rw [← he]
  exact RingHom.ker_isPrime _

private lemma idealR_le_idealQC (n : PNat) : idealR k n ≤ idealQC k := by
  have hx : xC k ^ (n : ℕ) ∈ idealQC k :=
    (idealQC k).pow_mem_of_mem (xC_mem_idealQC k) _ n.pos
  apply sup_le
  · rw [idealP, Ideal.map_sup]
    apply sup_le
    · rw [idealI, Ideal.map_span]
      apply Ideal.span_le.mpr
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      exact zCIndex_mem_idealQC k i
    · rw [Ideal.map_span]
      apply Ideal.span_le.mpr
      rintro _ ⟨_, rfl, rfl⟩
      rw [aToC_fA]
      exact (idealQC k).add_mem ((idealQC k).add_mem (yC_mem_idealQC k) hx)
        ((idealQC k).pow_mem_of_mem (xC_mem_idealQC k) _ (by omega))
  · apply Ideal.span_le.mpr
    rintro _ rfl
    exact (idealQC k).sub_mem (zC_mem_idealQC k) hx

private lemma mul_zCIndex_mem_span_xi (n : PNat) (c : ringC k)
    (hc : c ∈ idealR k n) : c * zCIndex k n ∈ Ideal.span (Set.range (xi k)) := by
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hc
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp hb
  have haz : a * zCIndex k n = 0 := by
    rw [← prove_annihilator_zCIndex] at ha
    exact (Submodule.mem_annihilator_span_singleton _ _).mp ha
  rw [← hab, add_mul, haz, zero_add, hd]
  convert (Ideal.span (Set.range (xi k))).mul_mem_left d
    (Ideal.subset_span (Set.mem_range_self n)) using 1; simp [xi]; ring

private lemma ker_cToB_eq_span_xi_of_le_idealI
    (hker : RingHom.ker (cToB k) ≤ (idealI k).map (aToC k)) :
    RingHom.ker (cToB k) = Ideal.span (Set.range (xi k)) := by
  classical
  apply le_antisymm _ (span_xi_le_ker_cToB k)
  intro a ha
  have haI := hker ha
  have hspan : (idealI k).map (aToC k) = Ideal.span (Set.range (zCIndex k)) := by
    rw [idealI, Ideal.map_span, ← Set.range_comp]
    rfl
  rw [hspan] at haI
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp haI
  have ha0 : localizationMap k a = 0 :=
    congrArg Subtype.val (show cToB k a = 0 from ha)
  obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff (awayFromQC k) (cAtQC k) a).mp ha0
  have hsum : ∑ i ∈ c.support, (s : ringC k) * (c i * zCIndex k i) = 0 := by
    rw [← Finset.mul_sum]
    have hc' : ∑ i ∈ c.support, c i * zCIndex k i = a := by
      simpa only [Finsupp.sum, smul_eq_mul] using hc
    rw [hc']
    exact hs
  have hind := (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero _).mp
    (iSupIndep_span_zCIndex k) c.support
      (fun i => (s : ringC k) * (c i * zCIndex k i))
      (fun i _ => Ideal.mul_mem_left _ _
        (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))) hsum
  rw [← hc]
  apply Submodule.sum_mem
  intro i hi
  show c i * zCIndex k i ∈ _
  apply mul_zCIndex_mem_span_xi k i (c i)
  have hprod : (s : ringC k) * c i ∈ (idealP k i).map (aToC k) := by
    rw [← prove_annihilator_zCIndex]
    rw [Submodule.mem_annihilator_span_singleton]
    show ((s : ringC k) * c i) * zCIndex k i = 0
    simpa only [mul_assoc] using hind i hi
  have hR : (s : ringC k) * c i ∈ idealR k i :=
    (show (idealP k i).map (aToC k) ≤ idealR k i from le_sup_left) hprod
  exact (idealR_isPrime k i).mem_or_mem hR |>.resolve_left
    (fun h => awayFromQC_subset_compl_idealQC k s.property (idealR_le_idealQC k i h))

private lemma ker_cToB_le_idealI_of_isPrime
    (hI : ((idealI k).map (aToC k)).IsPrime) :
    RingHom.ker (cToB k) ≤ (idealI k).map (aToC k) := by
  have hle : (idealI k).map (aToC k) ≤ idealQC k := by
    rw [idealI, Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    exact zCIndex_mem_idealQC k i
  intro a ha
  have ha0 : localizationMap k a = 0 :=
    congrArg Subtype.val (show cToB k a = 0 from ha)
  obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff (awayFromQC k) (cAtQC k) a).mp ha0
  have hprod : (s : ringC k) * a ∈ (idealI k).map (aToC k) := by
    rw [hs]
    exact Ideal.zero_mem _
  exact (hI.mem_or_mem hprod).resolve_left
    (fun h => awayFromQC_subset_compl_idealQC k s.property (hle h))

private def polynomialToQuotientQ (n : PNat) : Polynomial k →+* (ringC k ⧸ idealQ k n) :=
  (Ideal.Quotient.mk (idealQ k n)).comp ((aToC k).comp
    ((baseToA k).comp ((algebraMap (PlanePolynomial k) (baseRing k)).comp (lineToPlane k))))

private lemma polynomialToQuotientQ_X (n : PNat) :
    polynomialToQuotientQ k n Polynomial.X = Ideal.Quotient.mk (idealQ k n) (xC k) := by
  simp [polynomialToQuotientQ, lineToPlane, xC, xA, x0]

private lemma quotientQ_x_isUnit (n : PNat) :
    IsUnit (Ideal.Quotient.mk (idealQ k n) (xC k)) := by
  let q := Ideal.Quotient.mk (idealQ k n)
  have h : q (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (factor_mem_idealQ k n)
  apply isUnit_iff_exists_inv.mpr
  refine ⟨-(q (zC k) + q (xC k) ^ (n : ℕ)), ?_⟩
  simp only [map_add, map_mul, map_pow, map_one] at h
  linear_combination -h

private lemma polynomialToQuotientQ_isUnit (n : PNat) (p : Polynomial k) (hp : p ≠ 0) :
    IsUnit (polynomialToQuotientQ k n p) := by
  classical
  obtain ⟨g, hg, hng⟩ := p.exists_eq_pow_rootMultiplicity_mul_and_not_dvd hp (0 : k)
  have hg0 : g.eval 0 ≠ 0 := by
    simpa only [Polynomial.C_0, sub_zero, Polynomial.X_dvd_iff,
      Polynomial.coeff_zero_eq_eval_zero] using hng
  have hmem : lineToPlane k g ∈ originSubmonoid k := by
    show MvPolynomial.eval (0 : Fin 2 → k) (lineToPlane k g) ∈ nonZeroDivisors k
    rw [lineToPlane_eval_zero, mem_nonZeroDivisors_iff_ne_zero]
    exact hg0
  have hgu : IsUnit (polynomialToQuotientQ k n g) :=
    ((IsLocalization.map_units (M := originSubmonoid k) (baseRing k)
      ⟨lineToPlane k g, hmem⟩).map (baseToA k)).map
        ((Ideal.Quotient.mk (idealQ k n)).comp (aToC k))
  rw [hg, map_mul, map_pow]
  have hxu : IsUnit (polynomialToQuotientQ k n (Polynomial.X - Polynomial.C 0)) := by
    simpa only [Polynomial.C_0, sub_zero, polynomialToQuotientQ_X] using
      quotientQ_x_isUnit k n
  exact (hxu.pow _).mul hgu

private def fractionRingToQuotientQ (n : PNat) :
    FractionRing (Polynomial k) →+* (ringC k ⧸ idealQ k n) :=
  IsLocalization.lift (M := nonZeroDivisors (Polynomial k))
    (g := polynomialToQuotientQ k n) (fun p =>
      polynomialToQuotientQ_isUnit k n p (mem_nonZeroDivisors_iff_ne_zero.mp p.property))

private lemma fractionRingToQuotientQ_algebraMap (n : PNat) (p : Polynomial k) :
    fractionRingToQuotientQ k n (algebraMap (Polynomial k) (FractionRing (Polynomial k)) p) =
      polynomialToQuotientQ k n p :=
  IsLocalization.lift_eq _ _

private def lineToFractionRing : lineAtOrigin k →+* FractionRing (Polynomial k) :=
  IsLocalization.lift (M := Submonoid.comap (Polynomial.evalRingHom (0 : k))
    (nonZeroDivisors k)) (g := algebraMap (Polynomial k) (FractionRing (Polynomial k))) (by
      intro p
      apply isUnit_iff_ne_zero.mpr
      rw [← map_zero (algebraMap (Polynomial k) (FractionRing (Polynomial k)))]
      apply (IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k))).ne
      intro hp
      have hp0 := p.property
      change (p : Polynomial k).eval 0 ∈ nonZeroDivisors k at hp0
      simp [hp] at hp0)

private lemma lineToFractionRing_algebraMap (p : Polynomial k) :
    lineToFractionRing k (algebraMap (Polynomial k) (lineAtOrigin k) p) =
      algebraMap (Polynomial k) (FractionRing (Polynomial k)) p :=
  IsLocalization.lift_eq _ _

private def rationalCurveA (n : PNat) : ringA k →+* FractionRing (Polynomial k) :=
  (lineToFractionRing k).comp ((curveBase k n).comp (evalA0 k))

private lemma rationalCurveA_x (n : PNat) : rationalCurveA k n (xA k) =
    algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X := by
  simp [rationalCurveA, xA, evalA0_base, x0, curveBase_algebraMap, curveEval,
    lineToFractionRing_algebraMap]

private lemma rationalCurveA_f (n : PNat) : rationalCurveA k n (fA k n) = 0 := by
  simp [rationalCurveA, fA, evalA0_base, curveBase_f]

private lemma rationalCurveA_x_ne_zero (n : PNat) : rationalCurveA k n (xA k) ≠ 0 := by
  rw [rationalCurveA_x]
  simpa only [map_zero] using
    (IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k))).ne
      Polynomial.X_ne_zero

/-- The map `C → k(X)` restricting `C` to the `n`-th curve point: `x ↦ X` and
`z ↦ -X⁻¹ - Xⁿ`, and every `zₘ ↦ 0`. -/
@[no_expose] def rationalCurveC (n : PNat) : ringC k →+* FractionRing (Polynomial k) := by
  let φ := rationalCurveA k n
  let x := φ (xA k)
  let t := -(x⁻¹ + x ^ (n : ℕ))
  have hx : x ≠ 0 := rationalCurveA_x_ne_zero k n
  have hv : x * x⁻¹ = 1 := mul_inv_cancel₀ hx
  have hf : φ (yA k) + x ^ (n : ℕ) + x ^ (2 * (n : ℕ) + 1) = 0 := by
    have he : fA k n = yA k + xA k ^ (n : ℕ) + xA k ^ (2 * (n : ℕ) + 1) := by
      simp [fA, f, xA, yA]
    have h := rationalCurveA_f k n
    rw [he, map_add, map_add, map_pow, map_pow] at h
    exact h
  have ht : φ (xA k) * t ^ 2 + t + φ (yA k) = 0 := by
    change x * (-(x⁻¹ + x ^ (n : ℕ))) ^ 2 + -(x⁻¹ + x ^ (n : ℕ)) + φ (yA k) = 0
    linear_combination (x⁻¹ + 2 * x ^ (n : ℕ)) * hv + hf
  have hd : IsUnit (2 * φ (xA k) * t + 1) := by
    have hu := ((isUnit_one_add_two_pow k n).map φ).neg
    have he : 2 * φ (xA k) * t + 1 = -(φ (2 * xA k ^ ((n : ℕ) + 1) + 1)) := by
      simp only [map_add, map_mul, map_pow, map_one, map_ofNat]
      change 2 * x * (-(x⁻¹ + x ^ (n : ℕ))) + 1 = -(2 * x ^ ((n : ℕ) + 1) + 1)
      linear_combination -2 * hv
    exact he.symm ▸ hu
  exact liftC k φ t ht hd

private lemma rationalCurveC_aToC (n : PNat) (a : ringA k) :
    rationalCurveC k n (aToC k a) = rationalCurveA k n a := by
  simp [rationalCurveC, liftC_aToC]

private lemma rationalCurveC_zC (n : PNat) :
    rationalCurveC k n (zC k) =
      -((rationalCurveA k n (xA k))⁻¹ + rationalCurveA k n (xA k) ^ (n : ℕ)) := by
  simp [rationalCurveC, liftC_zC]

/-- On `A₀`, the restriction of `C` to the `n`-th curve point is restriction of the plane to
the curve. -/
lemma rationalCurveC_aToC_baseToA_algebraMap (n : PNat) (p : PlanePolynomial k) :
    rationalCurveC k n (aToC k (baseToA k (algebraMap (PlanePolynomial k) (baseRing k) p))) =
      algebraMap (Polynomial k) (FractionRing (Polynomial k)) (curveEval k n p) := by
  rw [rationalCurveC_aToC]
  simp [rationalCurveA, evalA0_base, curveBase_algebraMap, lineToFractionRing_algebraMap]

/-- The restriction of `C` to the `n`-th curve point kills every `zₘ`. -/
lemma rationalCurveC_zCIndex (n m : PNat) : rationalCurveC k n (zCIndex k m) = 0 := by
  rw [zCIndex, rationalCurveC_aToC]
  simp [rationalCurveA, evalA0, zA, evalZero]

/-- The restriction of `C` to the `n`-th curve point sends `z` to `-X⁻¹ - Xⁿ`. -/
lemma rationalCurveC_zC_eq (n : PNat) :
    rationalCurveC k n (zC k) =
      -((algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X)⁻¹ +
        algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X ^ (n : ℕ)) := by
  rw [rationalCurveC_zC, rationalCurveA_x]

/-- The ideal `qₙ` lies in the kernel of the restriction to the `n`-th curve point. -/
lemma idealQ_le_ker_rationalCurveC (n : PNat) :
    idealQ k n ≤ RingHom.ker (rationalCurveC k n) := by
  apply sup_le
  · apply Ideal.map_le_iff_le_comap.mpr
    apply sup_le
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      show rationalCurveC k n (aToC k (zA k i)) = 0
      rw [rationalCurveC_aToC]
      simp [rationalCurveA, evalA0, zA, evalZero]
    · apply Ideal.span_le.mpr
      rintro _ rfl
      show rationalCurveC k n (aToC k (fA k n)) = 0
      rw [rationalCurveC_aToC, rationalCurveA_f]
  · apply Ideal.span_le.mpr
    rintro _ rfl
    show rationalCurveC k n (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) = 0
    simp only [map_add, map_mul, map_pow, map_one, xC, rationalCurveC_aToC,
      rationalCurveC_zC]
    linear_combination -(mul_inv_cancel₀ (rationalCurveA_x_ne_zero k n))

private lemma quotientQ_nontrivial (n : PNat) : Nontrivial (ringC k ⧸ idealQ k n) := by
  let φ := Ideal.Quotient.lift (idealQ k n) (rationalCurveC k n)
    (fun _ h => idealQ_le_ker_rationalCurveC k n h)
  refine ⟨⟨0, 1, ?_⟩⟩
  intro h
  have h' := congrArg φ h
  exact zero_ne_one (by simpa only [map_zero, map_one] using h')

private lemma quotientQ_equiv_fractionRing_of_surjective (n : PNat)
    (h : Function.Surjective (fractionRingToQuotientQ k n)) :
    Nonempty ((ringC k ⧸ idealQ k n) ≃+* FractionRing (Polynomial k)) := by
  let := quotientQ_nontrivial k n
  exact ⟨(RingEquiv.ofBijective (fractionRingToQuotientQ k n)
    ⟨(fractionRingToQuotientQ k n).injective, h⟩).symm⟩

private lemma prove_quotientQ (n : PNat) :
    Nonempty ((ringC k ⧸ idealQ k n) ≃+* FractionRing (Polynomial k)) := by
  let q := Ideal.Quotient.mk (idealQ k n)
  let F := fractionRingToQuotientQ k n
  have hf : q (aToC k (fA k n)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ (fA_mem_idealP k n)))
  have hf' : q (yC k) + q (xC k) ^ (n : ℕ) +
      q (xC k) ^ (2 * (n : ℕ) + 1) = 0 := by
    rwa [aToC_fA, map_add, map_add, map_pow, map_pow] at hf
  have ha : (F.comp (rationalCurveA k n)) = q.comp (aToC k) := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      have hb : (F.comp ((lineToFractionRing k).comp (curveBase k n))) =
          q.comp ((aToC k).comp (baseToA k)) := by
        apply IsLocalization.ringHom_ext (originSubmonoid k)
        apply MvPolynomial.ringHom_ext
        · intro c
          simp [RingHom.comp_apply, curveBase_algebraMap, curveEval,
            lineToFractionRing_algebraMap, F, fractionRingToQuotientQ_algebraMap,
            polynomialToQuotientQ, lineToPlane, q]
        · intro i
          fin_cases i
          · simp [RingHom.comp_apply, curveBase_algebraMap, curveEval,
              lineToFractionRing_algebraMap, F, fractionRingToQuotientQ_algebraMap,
              polynomialToQuotientQ, lineToPlane, q]
          · simp only [RingHom.comp_apply, curveBase_algebraMap,
              lineToFractionRing_algebraMap, F, fractionRingToQuotientQ_algebraMap]
            show polynomialToQuotientQ k n (curveEval k n (MvPolynomial.X 1)) = q (yC k)
            simp only [curveEval, Fin.isValue, MvPolynomial.eval₂Hom_X',
              Matrix.cons_val_one, Matrix.cons_val_fin_one, map_sub, map_neg, map_pow,
              polynomialToQuotientQ_X]
            show -q (xC k) ^ (n : ℕ) - q (xC k) ^ (2 * (n : ℕ) + 1) = q (yC k)
            linear_combination -hf'
      show F (rationalCurveA k n (baseToA k a)) = q (aToC k (baseToA k a))
      simpa only [rationalCurveA, RingHom.comp_apply, evalA0_base] using
        RingHom.congr_fun hb a
    · intro i
      show F (rationalCurveA k n (zA k i)) = q (zCIndex k i)
      have hi : q (zCIndex k i) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
        ((show (idealP k n).map (aToC k) ≤ idealQ k n from le_sup_left)
          (Ideal.mem_map_of_mem _ ((show idealI k ≤ idealP k n from le_sup_left)
            (Ideal.subset_span (Set.mem_range_self i)))))
      simp [rationalCurveA, evalA0, zA, evalZero, hi]
  have hz : F (rationalCurveC k n (zC k)) = q (zC k) := by
    have hx := RingHom.congr_fun ha (xA k)
    change F (rationalCurveA k n (xA k)) = q (xC k) at hx
    have hi : q (xC k) * F ((rationalCurveA k n (xA k))⁻¹) = 1 := by
      rw [← hx, ← map_mul, mul_inv_cancel₀ (rationalCurveA_x_ne_zero k n), map_one]
    have hq : q (xC k) * q (zC k) + q (xC k) ^ ((n : ℕ) + 1) + 1 = 0 := by
      have he : q (xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (factor_mem_idealQ k n)
      simpa only [map_add, map_mul, map_pow, map_one] using he
    rw [rationalCurveC_zC, map_neg, map_add, map_pow, hx]
    apply (quotientQ_x_isUnit k n).mul_left_cancel
    linear_combination -hi - hq
  have hcomp : F.comp (rationalCurveC k n) = q := by
    apply ringC_hom_ext k
    · apply RingHom.ext
      intro a
      show F (rationalCurveC k n (aToC k a)) = q (aToC k a)
      rw [rationalCurveC_aToC]
      exact RingHom.congr_fun ha a
    · exact hz
  apply quotientQ_equiv_fractionRing_of_surjective k n
  intro a
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective a
  exact ⟨rationalCurveC k n c, RingHom.congr_fun hcomp c⟩

private lemma idealI_map_isPrime : ((idealI k).map (aToC k)).IsPrime := by
  let I := (idealI k).map (aToC k)
  let Q := ringC k ⧸ I
  let q : ringC k →+* Q := Ideal.Quotient.mk I
  have hI : I ≤ RingHom.ker (residueC k) := by
    dsimp [I]
    rw [idealI, Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨n, rfl⟩, rfl⟩
    exact residueC_zCIndex k n
  let ρ : Q →+* k := Ideal.Quotient.lift I (residueC k) (fun _ h => hI h)
  have : Nontrivial Q := by
    refine ⟨⟨0, 1, ?_⟩⟩
    intro h
    exact zero_ne_one (by simpa only [map_zero, map_one] using congrArg ρ h)
  let b : baseRing k →+* Q := q.comp ((aToC k).comp (baseToA k))
  let b₀ : PlanePolynomial k →+* Q := b.comp (algebraMap (PlanePolynomial k) (baseRing k))
  let π : PlanePolynomial k →+* Q :=
    MvPolynomial.eval₂Hom (b₀.comp MvPolynomial.C) ![q (xC k), q (zC k)]
  let ψ : PlanePolynomial k →+* PlanePolynomial k :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      ![MvPolynomial.X 0, -MvPolynomial.X 0 * MvPolynomial.X 1 ^ 2 - MvPolynomial.X 1]
  have hψ : π.comp ψ = b₀ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [π, ψ, b₀, b]
    · intro i
      fin_cases i
      · simp [π, ψ, b₀, b, xC, xA, x0]
      · have hr := congrArg q (cRelation_eq_zero k)
        simp only [map_add, map_mul, map_pow, map_zero] at hr
        simp only [MvPolynomial.eval₂Hom_C_eq_bind₁, Fin.isValue, neg_mul, Fin.mk_one,
          RingHom.coe_comp, MvPolynomial.coe_eval₂Hom, RingHom.coe_coe, Function.comp_apply,
          MvPolynomial.bind₁_X_right, Matrix.cons_val_one, Matrix.cons_val_fin_one,
          MvPolynomial.eval₂_sub, MvPolynomial.eval₂_neg, MvPolynomial.eval₂_mul,
          MvPolynomial.eval₂_X, Matrix.cons_val_zero, MvPolynomial.eval₂_pow, π, ψ]
        show -(q (xC k) * q (zC k) ^ 2) - q (zC k) = q (yC k)
        linear_combination -hr
  let S : Submonoid (PlanePolynomial k) := (IsUnit.submonoid Q).comap π
  let D := Localization S
  have hS : S ≤ nonZeroDivisors (PlanePolynomial k) := by
    intro p hp
    apply mem_nonZeroDivisors_iff_ne_zero.mpr
    intro he
    have hu : IsUnit (π p) := hp
    exact hu.ne_zero (by rw [he, map_zero])
  have : IsDomain D := IsLocalization.isDomain_of_le_nonZeroDivisors D hS
  let d : PlanePolynomial k →+* D := algebraMap (PlanePolynomial k) D
  have hψunit (s : originSubmonoid k) : IsUnit (d (ψ s)) :=
    IsLocalization.map_units (M := S) D ⟨ψ s, by
      show IsUnit (π (ψ s))
      rw [← RingHom.comp_apply, hψ]
      exact (IsLocalization.map_units (baseRing k) s).map b⟩
  let B : baseRing k →+* D := IsLocalization.lift (M := originSubmonoid k)
    (g := d.comp ψ) hψunit
  have hB (p : PlanePolynomial k) :
      B (algebraMap (PlanePolynomial k) (baseRing k) p) = d (ψ p) :=
    IsLocalization.lift_eq _ _
  let A : ringA k →+* D := B.comp (evalA0 k)
  have hx : A (xA k) = d (MvPolynomial.X 0) := by
    simp [A, xA, evalA0_base, x0, hB, ψ]
  have hy : A (yA k) = -d (MvPolynomial.X 0) * d (MvPolynomial.X 1) ^ 2 -
      d (MvPolynomial.X 1) := by
    simp [A, yA, evalA0_base, y0, hB, ψ]
    ring
  have ht : A (xA k) * d (MvPolynomial.X 1) ^ 2 + d (MvPolynomial.X 1) + A (yA k) = 0 := by
    rw [hx, hy]
    ring
  have hd : IsUnit (2 * A (xA k) * d (MvPolynomial.X 1) + 1) := by
    rw [hx]
    have hu : IsUnit (d (2 * MvPolynomial.X 0 * MvPolynomial.X 1 + 1)) :=
      IsLocalization.map_units (M := S) D ⟨_, by
        show IsUnit (π (2 * MvPolynomial.X 0 * MvPolynomial.X 1 + 1))
        simpa [π, map_ofNat] using (cDerivative_isUnit k).map q⟩
    simpa only [map_add, map_mul, map_ofNat, map_one] using hu
  let F := liftC k A (d (MvPolynomial.X 1)) ht hd
  have hF : I ≤ RingHom.ker F := by
    apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro _ ⟨n, rfl⟩
    show F (aToC k (zA k n)) = 0
    rw [liftC_aToC]
    simp [A, evalA0, zA, evalZero]
  let F' : Q →+* D := Ideal.Quotient.lift I F (fun _ h => hF h)
  let G : D →+* Q := IsLocalization.lift (M := S) (g := π) (fun s => s.property)
  have hG (p : PlanePolynomial k) : G (d p) = π p := IsLocalization.lift_eq _ _
  have hGB : G.comp B = b := by
    apply IsLocalization.ringHom_ext (originSubmonoid k)
    apply RingHom.ext
    intro p
    show G (B (algebraMap (PlanePolynomial k) (baseRing k) p)) = b₀ p
    rw [hB, hG]
    exact RingHom.congr_fun hψ p
  have hGF : G.comp F' = RingHom.id Q := by
    apply Ideal.Quotient.ringHom_ext
    apply ringC_hom_ext k
    · apply RingHom.ext
      intro a
      show G (F (aToC k a)) = q (aToC k a)
      rw [liftC_aToC]
      show G (B (evalA0 k a)) = q (aToC k a)
      rw [show G (B (evalA0 k a)) = b (evalA0 k a) from RingHom.congr_fun hGB _]
      have he : q (aToC k (a - baseToA k (evalA0 k a))) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.mem_map_of_mem _ (sub_base_evalA0_mem k a))
      show q (aToC k (baseToA k (evalA0 k a))) = q (aToC k a)
      exact (sub_eq_zero.mp (by simpa only [map_sub] using he)).symm
    · show G (F (zC k)) = q (zC k)
      rw [liftC_zC, hG]
      simp [π]
  have hinj : Function.Injective F' := by
    intro a b hab
    simpa only [← RingHom.comp_apply, hGF, RingHom.id_apply] using congrArg G hab
  have hker : RingHom.ker F = I := by
    have he : F = F'.comp q := rfl
    rw [he, RingHom.ker_comp_of_injective _ hinj, Ideal.mk_ker]
  show I.IsPrime
  rw [← hker]
  exact RingHom.ker_isPrime F

private theorem results : Results k := by
  have hle := ker_cToB_le_idealI_of_isPrime k (idealI_map_isPrime k)
  have hkernel := ker_cToB_eq_span_xi_of_le_idealI k hle
  refine {
    localRing := ringA_local k
    etale := prove_aToC_etale k
    finiteType := prove_aToB_finiteType k
    qbPrime := prove_idealQB_isPrime k
    qbComap := prove_idealQB_comap_eq_maximalIdeal k
    localEquiv := ⟨construct_bAtQB_equiv_cAtQC k, ?_⟩
    annihilatorZ := prove_annihilator_zCIndex k
    quotientP := ?_
    quotientR := prove_quotientR k
    quotientQ := prove_quotientQ k
    annihilatorXi := prove_annihilator_xi k
    kernel := hkernel
    independent := prove_iSupIndep_span_xi k
    kernelLe := hle
    awayKernel := ?_
    awayIndependent := fun g _ => prove_awayIndependent k g }
  · intro c
    show mapBAtQBToCAtQC k
      (algebraMap (ringB k) (bAtQB k) (cToB k c)) = _
    rw [mapBAtQBToCAtQC_algebraMap]
    rfl
  · intro n
    obtain ⟨e⟩ := quotient_idealP_equiv_quotientR_prod_quotientQ k n
    obtain ⟨eR⟩ := prove_quotientR k n
    obtain ⟨eQ⟩ := prove_quotientQ k n
    exact ⟨e.trans (eR.prodCongr eQ)⟩
  · intro g _
    exact ker_awayMap_eq_span_of_ker_eq_span (cToB k) (xi k) (idealQ k)
      (idealQ_le_annihilator_xi k) hkernel g

end

/-- The base ring of the construction is local. -/
instance ringA_isLocalRing : IsLocalRing (ringA k) := (results k).localRing

/-- The distinguished ideal `q_C` of `C` is maximal, with residue field `k`. -/
instance idealQC_isMaximal : (idealQC k).IsMaximal := by
  rw [← ker_residueC_eq_idealQC k]
  refine RingHom.ker_isMaximal_of_surjective (residueC k) fun b => ?_
  obtain ⟨a, ha⟩ := residueA_surjective k b
  exact ⟨aToC k a, by rw [residueC_aToC, ha]⟩

/-- The intermediate algebra is étale over the base. -/
alias aToC_etale := prove_aToC_etale

/-- The quotient algebra is of finite type over the base. -/
alias aToB_finiteType := prove_aToB_finiteType

/-- The distinguished ideal of `B` is prime. -/
instance idealQB_isPrime : (idealQB k).IsPrime := (results k).qbPrime

/-- The distinguished prime of `B` contracts to the maximal ideal of `A`. -/
theorem idealQB_comap_eq_maximalIdeal :
    letI := ringA_isLocalRing k
    (idealQB k).comap (aToB k) = IsLocalRing.maximalIdeal (ringA k) :=
  (results k).qbComap

/-- The distinguished local rings of `B` and `C` are canonically isomorphic
under the map from `C`. -/
theorem bAtQB_equiv_cAtQC :
    ∃ e : bAtQB k ≃+* cAtQC k,
      ∀ c : ringC k,
        e (algebraMap (ringB k) (bAtQB k) ((cToB k) c)) =
          algebraMap (ringC k) (cAtQC k) c := (results k).localEquiv

/-- The annihilator of `z_n` after extension to `C`. -/
alias annihilator_zCIndex := prove_annihilator_zCIndex

/-- The quotient by `p_n C` splits into its two factors. -/
theorem quotient_idealP_equiv_prod (n : PNat) :
    Nonempty ((ringC k ⧸ (idealP k n).map (aToC k)) ≃+*
      (lineAtOrigin k × FractionRing (Polynomial k))) := (results k).quotientP n

/-- The first factor is the localization of the affine line at the origin. -/
alias quotient_idealR_equiv_lineAtOrigin := prove_quotientR

/-- The second factor is the rational function field. -/
alias quotient_idealQ_equiv_fractionRing := prove_quotientQ

/-- The annihilator of the distinguished kernel generator. -/
alias annihilator_xi := prove_annihilator_xi

/-- The kernel is generated by the distinguished elements `ξ_n`. -/
theorem ker_cToB_eq_span_xi :
    RingHom.ker (cToB k) = Ideal.span (Set.range (xi k)) := (results k).kernel

/-- The cyclic summands of the kernel form a direct sum. -/
alias iSupIndep_span_xi := prove_iSupIndep_span_xi

/-- The kernel lies in the extended square-zero ideal. -/
theorem ker_cToB_le_idealI :
    RingHom.ker (cToB k) ≤ (idealI k).map (aToC k) := (results k).kernelLe

/-- After inverting `g`, precisely the summands on which `g` is invertible remain. -/
theorem ker_awayMap_eq_span_xi (g : ringC k) (hg : g ∉ idealQC k) :
    RingHom.ker (Localization.awayMap (cToB k) g) =
      Ideal.span ((fun n : {n : PNat // g ∉ idealQ k n} =>
        algebraMap (ringC k) (Localization.Away g) (xi k n.1)) '' Set.univ) :=
  (results k).awayKernel g hg

/-- These surviving cyclic summands remain independent after inverting `g`. -/
theorem iSupIndep_span_xi_away (g : ringC k) (hg : g ∉ idealQC k) :
    iSupIndep (fun n : {n : PNat // g ∉ idealQ k n} =>
      Ideal.span ({algebraMap (ringC k) (Localization.Away g) (xi k n.1)} :
        Set (Localization.Away g))) := (results k).awayIndependent g hg

end Stacks.Examples.RaynaudGruson

end
