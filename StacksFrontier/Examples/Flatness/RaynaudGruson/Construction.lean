module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# The Raynaud--Gruson construction

The rings, ideals and distinguished elements of the Raynaud--Gruson example of an algebra of
finite type over a local ring which is flat at a point of its spectrum but flat on no
neighbourhood of that point.

Starting from the local ring `A₀ = k[x, y]_(x,y)` and the elements `fₙ = y + xⁿ + x^(2n+1)`, the
first ring is `A = A₀[z₁, z₂, …]/(zₙ zₘ, zₙ fₙ)`, with distinguished ideal `I = (z₁, z₂, …)`.
The second is `C = A[z]/(x z² + z + y)[1/(2 x z + 1)]`, an étale `A`-algebra, with the prime
`q_C = (x, y, z, z₁, z₂, …)`. The third, `B`, is the image of `C` in its localization at `q_C`,
with `q_B` the image of `q_C`; the map `A → B` is the example. The construction also names the
ideals `pₙ = (I, fₙ)` of `A`, the ideals `rₙ = pₙ C + (z - xⁿ) C` and
`qₙ = pₙ C + (x z + x^(n+1) + 1) C` of `C`, and the elements `ξₙ = (z - xⁿ) zₙ` of `C`, which
generate the kernel of `C → B`.

## Main definitions

* `Stacks.Examples.RaynaudGruson.baseRing`: the local ring `k[x, y]_(x,y)`.
* `Stacks.Examples.RaynaudGruson.ringA`, `Stacks.Examples.RaynaudGruson.ringC` and
  `Stacks.Examples.RaynaudGruson.ringB`: the three rings of the construction.
* `Stacks.Examples.RaynaudGruson.idealI`, `Stacks.Examples.RaynaudGruson.idealQC` and
  `Stacks.Examples.RaynaudGruson.idealQB`: its distinguished ideals.
* `Stacks.Examples.RaynaudGruson.idealP`, `Stacks.Examples.RaynaudGruson.idealR`,
  `Stacks.Examples.RaynaudGruson.idealQ` and `Stacks.Examples.RaynaudGruson.xi`: the families
  indexed by the positive integers.

## Implementation notes

The variables `zₙ` are indexed by `PNat`, so their indices are exactly the positive integers.
Localization at `q_C` is set up without requiring a primality instance at definition time: what
is inverted is the submonoid generated by the complement of `q_C`, which once `q_C` is known to
be prime is the usual localization at that prime.

## References

* [Stacks Project, Tag 05G2](https://stacks.math.columbia.edu/tag/05G2)
-/

@[expose] public section

noncomputable section

namespace Stacks.Examples.RaynaudGruson

universe u

variable (k : Type u) [Field k]

/-- Polynomials in the two variables `x` and `y`. -/
abbrev PlanePolynomial := MvPolynomial (Fin 2) k

/-- The polynomials which do not vanish at the origin. -/
def originSubmonoid : Submonoid (PlanePolynomial k) :=
  Submonoid.comap (MvPolynomial.eval 0) (nonZeroDivisors k)

/-- The local ring `k[x,y]_(x,y)`. -/
abbrev baseRing := Localization (originSubmonoid k)

/-- The image of `x` in `k[x,y]_(x,y)`. -/
def x0 : baseRing k :=
  algebraMap (PlanePolynomial k) (baseRing k) (MvPolynomial.X 0)

/-- The image of `y` in `k[x,y]_(x,y)`. -/
def y0 : baseRing k :=
  algebraMap (PlanePolynomial k) (baseRing k) (MvPolynomial.X 1)

/-- The element `f_n = y + x^n + x^(2n+1)` of `k[x,y]_(x,y)`. -/
def f (n : PNat) : baseRing k :=
  y0 k + x0 k ^ (n : ℕ) + x0 k ^ (2 * (n : ℕ) + 1)

/-- The commutative ring structure on `k[x,y]_(x,y)`. -/
noncomputable local instance baseRingCommRing : CommRing (baseRing k) :=
  @OreLocalization.instCommRing (PlanePolynomial k) inferInstance (originSubmonoid k) inferInstance

/-- The ideal of `A₀[z₁,z₂,…]` generated by `z_n z_m` and `z_n f_n`. -/
def relationIdeal : Ideal (MvPolynomial PNat (baseRing k)) :=
  Ideal.span
    (Set.range (fun nm : PNat × PNat => MvPolynomial.X nm.1 * MvPolynomial.X nm.2) ∪
      Set.range (fun n : PNat => MvPolynomial.X n * MvPolynomial.C (f k n)))

/-- The ring `A = A₀[z₁,z₂,…]/(z_n z_m, z_n f_n)`. -/
abbrev ringA := MvPolynomial PNat (baseRing k) ⧸ relationIdeal k

/-- The commutative ring structure on `A = A₀[z₁,z₂,…]/(z_n z_m, z_n f_n)`. -/
noncomputable instance ringACommRing : CommRing (ringA k) :=
  @Ideal.Quotient.commRing (MvPolynomial PNat (baseRing k)) inferInstance (relationIdeal k)

/-- The structural map `A₀ → A`. -/
def baseToA : baseRing k →+* ringA k :=
  (Ideal.Quotient.mk (relationIdeal k)).comp MvPolynomial.C

/-- The element `x` of `A`. -/
def xA : ringA k := baseToA k (x0 k)

/-- The element `y` of `A`. -/
def yA : ringA k := baseToA k (y0 k)

/-- The element `f_n` of `A`. -/
def fA (n : PNat) : ringA k := baseToA k (f k n)

/-- The image of the polynomial variable `z_n` in `A`. -/
def zA (n : PNat) : ringA k :=
  Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X n)

/-- The ideal `I = (z₁,z₂,…)` of `A`. -/
def idealI : Ideal (ringA k) := Ideal.span (Set.range (zA k))

/-- The relation `xz² + z + y` defining the first stage of `C`. -/
def cRelation : MvPolynomial Unit (ringA k) :=
  MvPolynomial.C (xA k) * MvPolynomial.X () ^ 2 + MvPolynomial.X () +
    MvPolynomial.C (yA k)

/-- The principal ideal generated by the relation defining `C`. -/
def cRelationIdeal : Ideal (MvPolynomial Unit (ringA k)) :=
  Ideal.span ({cRelation k} : Set (MvPolynomial Unit (ringA k)))

/-- The quotient `A[z]/(xz²+z+y)`. -/
abbrev cQuotient :=
  MvPolynomial Unit (ringA k) ⧸ cRelationIdeal k

/-- The commutative ring structure on `A[z]/(xz²+z+y)`. -/
noncomputable instance cQuotientCommRing : CommRing (cQuotient k) :=
  @Ideal.Quotient.commRing (MvPolynomial Unit (ringA k)) inferInstance (cRelationIdeal k)

/-- The image of `2xz+1` in `A[z]/(xz²+z+y)`. -/
def cDenominator : cQuotient k :=
  Ideal.Quotient.mk (cRelationIdeal k)
    (2 * MvPolynomial.C (xA k) * MvPolynomial.X () + 1)

/-- The ring `C = A[z]/(xz²+z+y)[1/(2xz+1)]`. -/
abbrev ringC := Localization.Away (cDenominator k)

/-- The structural map `A → C`. -/
def aToC : ringA k →+* ringC k :=
  (algebraMap (cQuotient k) (ringC k)).comp
    ((Ideal.Quotient.mk
      (cRelationIdeal k)).comp MvPolynomial.C)

/-- The element `x` of `C`. -/
def xC : ringC k := aToC k (xA k)

/-- The element `y` of `C`. -/
def yC : ringC k := aToC k (yA k)

/-- The polynomial variable `z`, viewed in `C`. -/
def zC : ringC k :=
  algebraMap (cQuotient k) (ringC k)
    (Ideal.Quotient.mk
      (cRelationIdeal k) (MvPolynomial.X ()))

/-- The element `z_n` of `C`. -/
def zCIndex (n : PNat) : ringC k := aToC k (zA k n)

/-- The ideal `q_C = (x,y,z,z₁,z₂,…)` of `C`. -/
def idealQC : Ideal (ringC k) :=
  Ideal.span (Set.insert (xC k) (Set.insert (yC k)
    (Set.insert (zC k) (Set.range (zCIndex k)))))

/-- The multiplicative set used to localize `C` at `q_C`. It is the
multiplicative closure of the complement of `q_C`. -/
def awayFromQC : Submonoid (ringC k) :=
  Submonoid.closure {c | c ∉ idealQC k}

/-- The localization of `C` at `q_C`. -/
abbrev cAtQC := Localization (awayFromQC k)

/-- The localization map `C → C_{q_C}`. -/
def localizationMap : ringC k →+* cAtQC k :=
  algebraMap (ringC k) (cAtQC k)

/-- The image `B` of `C → C_{q_C}`. -/
abbrev ringB := (localizationMap k).range

/-- The canonical surjection `C → B`. -/
def cToB : ringC k →+* ringB k := (localizationMap k).rangeRestrict

/-- The structural map `A → B` occurring in the construction. -/
def aToB : ringA k →+* ringB k := (cToB k).comp (aToC k)

/-- The image `q_B` of `q_C` in `B`. -/
def idealQB : Ideal (ringB k) := (idealQC k).map (cToB k)

/-- The ideal `p_n = (I,f_n)` of `A`. -/
def idealP (n : PNat) : Ideal (ringA k) :=
  idealI k ⊔ Ideal.span ({fA k n} : Set (ringA k))

/-- The ideal `r_n = p_n C + (z-x^n)C`. -/
def idealR (n : PNat) : Ideal (ringC k) :=
  (idealP k n).map (aToC k) ⊔
    Ideal.span ({zC k - xC k ^ (n : ℕ)} : Set (ringC k))

/-- The ideal `q_n = p_n C + (xz+x^(n+1)+1)C`. -/
def idealQ (n : PNat) : Ideal (ringC k) :=
  (idealP k n).map (aToC k) ⊔
    Ideal.span ({xC k * zC k + xC k ^ ((n : ℕ) + 1) + 1} : Set (ringC k))

/-- The element `ξ_n = (z-x^n)z_n` of `C`. -/
def xi (n : PNat) : ringC k :=
  (zC k - xC k ^ (n : ℕ)) * zCIndex k n

end Stacks.Examples.RaynaudGruson

end
