/-!
# A flat finite type ring map which is not finitely presented

There is a flat ring homomorphism of finite type whose fibre rings are geometrically
irreducible complete intersections but which is not of finite presentation.

The example is the trivial square-zero extension `S = R ⋉ (R ⧸ I)` of a ring `R` by the
quotient by an ideal `I` for which `R ⧸ I` is finite and flat but not projective. Flatness
and finiteness of `S` over `R` are inherited from `R ⧸ I` summandwise. Finite presentation
would fail: it would make `S`, hence its direct summand `R ⧸ I`, a finitely presented
module, and the kernel of a finite presentation of `R ⧸ I` is `I`, which is not finitely
generated. Every fibre of `S` is generated over the residue field by a single square-zero
element, so it is a quotient of a one-variable polynomial algebra by a principal ideal and
is zero-dimensional — a global complete intersection — and its spectrum stays a single point
after any field extension, which is geometric irreducibility.

## Main results

* `Stacks.Examples.exists_flat_finiteType_not_finitePresentation_with_completeIntersection_fibers`:
  such a ring map exists.

## References

* [Stacks Project, Tag 05LC](https://stacks.math.columbia.edu/tag/05LC)
-/

@[expose] public section

namespace Stacks.Examples

open scoped TensorProduct

universe u

/-- A product of two flat modules is flat, seen as a direct sum indexed by `Bool`. -/
private lemma flat_prod {R : Type u} {M N : Type u} [CommRing R] [AddCommGroup M]
    [AddCommGroup N] [Module R M] [Module R N] [Module.Flat R M] [Module.Flat R N] :
    Module.Flat R (M × N) := by
  let F : Bool → Type _ := fun b => match b with | false => M | true => N
  let : ∀ b, AddCommGroup (F b) := fun b => by cases b <;> dsimp [F] <;> infer_instance
  let : ∀ b, Module R (F b) := fun b => by cases b <;> dsimp [F] <;> infer_instance
  have : ∀ b, Module.Flat R (F b) := fun b => by cases b <;> dsimp [F] <;> infer_instance
  let e : ((b : Bool) → F b) ≃ₗ[R] M × N :=
    { toFun := fun z => (z false, z true)
      invFun := fun z b => Bool.rec z.1 z.2 b
      left_inv := fun z => funext fun b => by cases b <;> rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  exact Module.Flat.of_linearEquiv
    ((DirectSum.linearEquivFunOnFintype R Bool F).trans e).symm

/-- An algebra generated by one square-zero element has every element of the form
`a + b x`. -/
private lemma linear_form_of_square_zero {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] (x : A) (hx : x ^ 2 = 0) (hgen : Algebra.adjoin R {x} = ⊤)
    (y : A) : ∃ a b : R, y = algebraMap R A a + algebraMap R A b * x := by
  have hy : y ∈ Algebra.adjoin R {x} := by simp [hgen]
  induction hy using Algebra.adjoin_induction with
  | mem z hz =>
    obtain rfl := Set.mem_singleton_iff.mp hz
    exact ⟨0, 1, by simp⟩
  | algebraMap r => exact ⟨r, 0, by simp⟩
  | add a b _ _ ha hb =>
    obtain ⟨a₀, a₁, rfl⟩ := ha
    obtain ⟨b₀, b₁, rfl⟩ := hb
    exact ⟨a₀ + b₀, a₁ + b₁, by simp only [map_add]; ring⟩
  | mul a b _ _ ha hb =>
    obtain ⟨a₀, a₁, rfl⟩ := ha
    obtain ⟨b₀, b₁, rfl⟩ := hb
    refine ⟨a₀ * b₀, a₀ * b₁ + a₁ * b₀, ?_⟩
    simp only [map_add, map_mul]
    linear_combination algebraMap R A a₁ * algebraMap R A b₁ * hx

/-- An algebra over a field generated by one square-zero element has a one-point
spectrum. -/
private lemma subsingleton_spectrum_of_square_zero {K A : Type*} [Field K] [CommRing A]
    [Algebra K A] (x : A) (hx : x ^ 2 = 0) (hgen : Algebra.adjoin K {x} = ⊤) :
    Subsingleton (PrimeSpectrum A) := by
  refine ⟨fun p q => ?_⟩
  have mem (p : PrimeSpectrum A) (a b : K) :
      algebraMap K A a + algebraMap K A b * x ∈ p.asIdeal ↔ a = 0 := by
    have hxp : x ∈ p.asIdeal := p.isPrime.mem_of_pow_mem 2 (hx ▸ p.asIdeal.zero_mem)
    have hbx : algebraMap K A b * x ∈ p.asIdeal := p.asIdeal.mul_mem_left _ hxp
    rw [Ideal.add_mem_iff_left _ hbx]
    refine ⟨fun ha => ?_, by rintro rfl; simp⟩
    by_contra hne
    exact p.isPrime.ne_top (p.asIdeal.eq_top_of_isUnit_mem ha
      ((isUnit_iff_ne_zero.mpr hne).map (algebraMap K A)))
  apply PrimeSpectrum.ext
  ext y
  obtain ⟨a, b, rfl⟩ := linear_form_of_square_zero x hx hgen y
  rw [mem, mem]

/-- A finite algebra over a field generated by a single element is a global complete
intersection: it is a one-variable polynomial algebra modulo a principal ideal, and it is
zero-dimensional. -/
private lemma completeIntersection_of_monogenic {K A : Type*} [Field K] [CommRing A]
    [Algebra K A] [Nontrivial A] [Module.Finite K A]
    (x : A) (hgen : Algebra.adjoin K {x} = ⊤) : IsGlobalCompleteIntersection K A := by
  classical
  let e := MvPolynomial.uniqueAlgEquiv K (Fin 1)
  let : IsPrincipalIdealRing (MvPolynomial (Fin 1) K) :=
    IsPrincipalIdealRing.of_surjective e.symm e.symm.surjective
  let f := (Polynomial.aeval x).comp e.toAlgHom
  have hf : Function.Surjective f :=
    ((AlgHom.range_eq_top _).mp
      ((Algebra.adjoin_singleton_eq_range_aeval K x).symm.trans hgen)).comp e.surjective
  let g := Submodule.IsPrincipal.generator (RingHom.ker f)
  have hg : Ideal.span (Set.range (fun _ : Fin 1 => g)) = RingHom.ker f := by
    simpa only [Set.range_const] using Ideal.span_singleton_generator (RingHom.ker f)
  have : IsArtinianRing A := IsArtinianRing.of_finite K A
  refine Or.inr ⟨1, 1, (fun _ => g), ?_, le_rfl, ?_⟩
  · exact (Ideal.quotientKerAlgEquivOfSurjective hf).symm.trans
      (Ideal.quotientEquivAlgOfEq K hg.symm)
  · simpa using (ringKrullDimZero_iff_ringKrullDim_eq_zero (R := A)).mp inferInstance

/-- A square-zero algebra generator stays one after base change. -/
private lemma square_zero_generator_baseChange {R A B : Type*} [CommRing R]
    [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
    (x : B) (hx : x ^ 2 = 0) (hgen : Algebra.adjoin R {x} = ⊤) :
    (1 ⊗ₜ[R] x : A ⊗[R] B) ^ 2 = 0 ∧
      Algebra.adjoin A {(1 ⊗ₜ[R] x : A ⊗[R] B)} = ⊤ := by
  constructor
  · simp [hx]
  · simpa only [Set.image_singleton] using Algebra.TensorProduct.adjoin_one_tmul_image_eq_top
      (A := A) {x} hgen

/-- A square-zero algebra generator stays one along an algebra equivalence. -/
private lemma square_zero_generator_equiv {R A B : Type*} [CommRing R]
    [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
    (e : A ≃ₐ[R] B) (x : A) (hx : x ^ 2 = 0) (hgen : Algebra.adjoin R {x} = ⊤) :
    e x ^ 2 = 0 ∧ Algebra.adjoin R {e x} = ⊤ := by
  refine ⟨by rw [← map_pow, hx, map_zero], ?_⟩
  have H := e.toAlgHom.map_adjoin {x}
  rw [hgen, Algebra.map_top] at H
  simpa only [Set.image_singleton, AlgEquiv.coe_toAlgHom] using
    H.symm.trans ((AlgHom.range_eq_top _).mpr e.surjective)

/-- An algebra over a field generated by one square-zero element is geometrically
irreducible, since its spectrum stays a single point after any field extension. -/
private lemma geometricallyIrreducible_of_square_zero {K A : Type u} [Field K]
    [CommRing A] [Algebra K A] [Nontrivial A]
    (x : A) (hx : x ^ 2 = 0) (hgen : Algebra.adjoin K {x} = ⊤) :
    Algebra.IsGeometricallyIrreducible K A := by
  rw [Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_tensorProduct]
  intro L _ _
  have h := square_zero_generator_baseChange (A := L) x hx hgen
  have := subsingleton_spectrum_of_square_zero _ h.1 h.2
  have : Nonempty (PrimeSpectrum (L ⊗[K] A)) :=
    PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance
  have : IrreducibleSpace (PrimeSpectrum (L ⊗[K] A)) :=
    { toNonempty := inferInstance }
  let φ := (PrimeSpectrum.homeomorphOfRingEquiv
    (Algebra.TensorProduct.comm K A L).toRingEquiv).symm
  exact φ.surjective.irreducibleSpace φ.continuous

/-- The image of `1` in the square-zero summand generates the trivial square-zero extension
`R ⋉ (R ⧸ I)` as an `R`-algebra. -/
private lemma adjoin_inr_quotient (R : Type*) [CommRing R] (I : Ideal R) :
    Algebra.adjoin R {(TrivSqZeroExt.inr (1 : R ⧸ I) : TrivSqZeroExt R (R ⧸ I))} = ⊤ := by
  apply top_unique
  rintro y _
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective y.snd
  have hy : y = algebraMap R _ y.fst + algebraMap R _ b *
      (TrivSqZeroExt.inr (1 : R ⧸ I) : TrivSqZeroExt R (R ⧸ I)) := by
    ext <;> simp [TrivSqZeroExt.algebraMap_eq_inl, hb, Algebra.smul_def]
  rw [hy]
  exact add_mem (algebraMap_mem _ _) (mul_mem (algebraMap_mem _ _)
    (Algebra.subset_adjoin (Set.mem_singleton _)))

/-- Each fibre of `R ⋉ (R ⧸ I)` is geometrically irreducible and a global complete
intersection. -/
private lemma quotient_square_zero_fiber_properties (R K : Type u) [CommRing R]
    [Field K] [Algebra R K] (I : Ideal R) :
    letI : Algebra K (TrivSqZeroExt R (R ⧸ I) ⊗[R] K) :=
      Algebra.TensorProduct.rightAlgebra
    Algebra.IsGeometricallyIrreducible K (TrivSqZeroExt R (R ⧸ I) ⊗[R] K) ∧
      IsGlobalCompleteIntersection K (TrivSqZeroExt R (R ⧸ I) ⊗[R] K) := by
  let S := TrivSqZeroExt R (R ⧸ I)
  let : Algebra K (S ⊗[R] K) := Algebra.TensorProduct.rightAlgebra
  let : Module K (S ⊗[R] K) :=
    @Algebra.toModule K (S ⊗[R] K) inferInstance inferInstance inferInstance
  let e := Algebra.TensorProduct.commRight R K S
  let aug : K ⊗[R] S →ₐ[K] K := Algebra.TensorProduct.lift (AlgHom.id K K)
    ((Algebra.ofId R K).comp (TrivSqZeroExt.fstHom R R (R ⧸ I)))
    (fun _ _ => Commute.all _ _)
  have : Nontrivial (S ⊗[R] K) := (aug.toRingHom.comp e.symm.toRingHom).domain_nontrivial
  have : Module.Finite R S := inferInstanceAs (Module.Finite R (R × (R ⧸ I)))
  have : Module.Finite K (S ⊗[R] K) := Module.Finite.equiv e.toLinearEquiv
  let x : S := TrivSqZeroExt.inr 1
  have hx : x ^ 2 = 0 := by
    simpa only [x, sq] using TrivSqZeroExt.inr_mul_inr R (1 : R ⧸ I) 1
  have h := square_zero_generator_baseChange (A := K) x hx (adjoin_inr_quotient R I)
  have he := square_zero_generator_equiv (B := S ⊗[R] K) e _ h.1 h.2
  exact ⟨geometricallyIrreducible_of_square_zero _ he.1 he.2,
    completeIntersection_of_monogenic _ he.2⟩

/-- A flat ring map of finite type can have geometrically irreducible complete-intersection
fibres without being of finite presentation. -/
@[stacks 05LC "(1)"]
theorem exists_flat_finiteType_not_finitePresentation_with_completeIntersection_fibers :
    ∃ (R S : Type u) (_ : CommRing R) (_ : CommRing S) (f : R →+* S),
      f.Flat ∧ f.FiniteType ∧ ¬ f.FinitePresentation ∧
        (letI := f.toAlgebra
         ∀ (p : Ideal R) [p.IsPrime],
           letI : Algebra p.ResidueField (S ⊗[R] p.ResidueField) :=
             Algebra.TensorProduct.rightAlgebra
           Algebra.IsGeometricallyIrreducible p.ResidueField
               (S ⊗[R] p.ResidueField) ∧
             IsGlobalCompleteIntersection p.ResidueField
               (S ⊗[R] p.ResidueField)) := by
  classical
  obtain ⟨D⟩ := nonempty_finiteFlatNonprojectiveQuotient.{u}
  let M := D.R ⧸ D.I
  let S := TrivSqZeroExt D.R M
  have : Module.Flat D.R M := D.flat
  have : Module.Finite D.R M := D.finite
  have : Module.Flat D.R S := flat_prod (R := D.R) (M := D.R) (N := M)
  have : Module.Finite D.R S := inferInstanceAs (Module.Finite D.R (D.R × M))
  refine ⟨D.R, S, inferInstance, inferInstance, algebraMap D.R S,
    RingHom.flat_algebraMap_iff.mpr inferInstance, ?_, ?_, ?_⟩
  · exact RingHom.FiniteType.of_finite (RingHom.finite_algebraMap.mpr inferInstance)
  · intro hfp
    have : Algebra.FinitePresentation D.R S := RingHom.finitePresentation_algebraMap.mp hfp
    have : Module.FinitePresentation D.R S :=
      Module.FinitePresentation.of_finite_of_finitePresentation D.R S
    have : Module.FinitePresentation D.R (D.R × M) :=
      inferInstanceAs (Module.FinitePresentation D.R S)
    have : Module.FinitePresentation D.R M := by
      apply Module.finitePresentation_of_split_exact
        (LinearMap.inr D.R D.R M) (LinearMap.fst D.R D.R M) (LinearMap.inl D.R D.R M)
      · ext; rfl
      · exact LinearMap.inr_injective
      · rw [LinearMap.exact_iff]
        ext x
        simp [LinearMap.mem_range, LinearMap.mem_ker, Prod.ext_iff, eq_comm]
    apply D.not_fg
    have hker := Module.FinitePresentation.fg_ker D.I.mkQ D.I.mkQ_surjective
    rwa [Submodule.ker_mkQ] at hker
  · rw [toAlgebra_algebraMap]
    intro p hp
    exact quotient_square_zero_fiber_properties D.R p.ResidueField D.I

end Stacks.Examples
