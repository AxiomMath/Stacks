/-!
# Nonvanishing cohomology of the associated sheaf of an injective module

Let `A = ℚ[x, y, u₀, w₀, u₁, w₁, …]/(xⁿ⁺¹wₙ, yⁿ⁺¹uₙ, uₙ², wₙ²)`. The spectrum of `A` is a
Noetherian topological space, since `A` modulo its nilradical is a quotient of `ℚ[x, y]`. The
character module `A^∨` is an injective `A`-module, yet the associated sheaf `(A^∨)~` has nonzero
first cohomology on the quasi-compact open `D(x) ∪ D(y)`.

The obstruction is the section of `(A^∨)~` over `D(xy)` coming from a character `χ` with
`χ(xⁿyⁿuₙwₙ) ≠ 0` for every `n`. If first cohomology vanished on `D(x) ∪ D(y)`, that section
would be a difference of sections over `D(x)` and over `D(y)`; clearing denominators and using
`xⁿ⁺¹wₙ = yⁿ⁺¹uₙ = 0` kills the resulting identity in a single coordinate, contradicting the
choice of `χ`.

## Main results

* `Stacks.Examples.InjectiveTilde.exists_injective_tilde_nonzero_firstCohomology`: an affine
  scheme with Noetherian underlying space, an injective module on it, and a quasi-compact open
  on which the associated sheaf has nonzero first cohomology.

## Implementation notes

Cohomology is the right derived functor of sections, as set up for Stacks tag 01E3, so the
nonvanishing statement is the negation of `CategoryTheory.Limits.IsZero` for the derived-functor
object. The Mayer–Vietoris square of two opens turns the vanishing hypothesis into the
surjectivity of the Čech difference map used to produce the contradiction. The ring is wrapped
in `ULift` so that it lives in the universe the `tilde` construction requires.

## References

* [Stacks Project, Tag 0CRZ](https://stacks.math.columbia.edu/tag/0CRZ)
-/

@[expose] public section

open CategoryTheory Limits AlgebraicGeometry TopologicalSpace

universe u

namespace Stacks.Examples.InjectiveTilde

/-- The variables of the obstruction ring: two left indices for `x` and `y`, and for each
natural number `n` a pair `uₙ`, `wₙ` indexed by a boolean. -/
private abbrev witnessIndex := Fin 2 ⊕ ℕ × Bool

/-- The variable `x`. -/
private noncomputable def witnessX : witnessIndex := Sum.inl 0

/-- The variable `y`. -/
private noncomputable def witnessY : witnessIndex := Sum.inl 1

/-- The variable `uₙ`. -/
private noncomputable def witnessU (n : ℕ) : witnessIndex := Sum.inr (n, false)

/-- The variable `wₙ`. -/
private noncomputable def witnessW (n : ℕ) : witnessIndex := Sum.inr (n, true)

/-- The exponent vector of the relation `xⁿ⁺¹wₙ`. -/
private noncomputable def xwExponent (n : ℕ) : witnessIndex →₀ ℕ :=
  Finsupp.single (witnessX) (n + 1) + Finsupp.single (witnessW n) 1

/-- The exponent vector of the relation `yⁿ⁺¹uₙ`. -/
private noncomputable def yuExponent (n : ℕ) : witnessIndex →₀ ℕ :=
  Finsupp.single (witnessY) (n + 1) + Finsupp.single (witnessU n) 1

/-- The exponent vector of the relation `uₙ²`. -/
private noncomputable def uSquareExponent (n : ℕ) : witnessIndex →₀ ℕ :=
  Finsupp.single (witnessU n) 2

/-- The exponent vector of the relation `wₙ²`. -/
private noncomputable def wSquareExponent (n : ℕ) : witnessIndex →₀ ℕ :=
  Finsupp.single (witnessW n) 2

/-- The exponent vectors of all the relations of the obstruction ring. -/
private noncomputable def witnessRelations : Set (witnessIndex →₀ ℕ) :=
  Set.range xwExponent ∪ Set.range yuExponent ∪ Set.range uSquareExponent ∪
    Set.range wSquareExponent

/-- The exponent vector of the monomial `xⁿyⁿuₙwₙ`, on which the obstruction character does
not vanish. -/
private noncomputable def obstructionExponent (n : ℕ) : witnessIndex →₀ ℕ :=
  Finsupp.single witnessX n + Finsupp.single witnessY n +
    Finsupp.single (witnessU n) 1 + Finsupp.single (witnessW n) 1

/-- The monomial ideal generated by `xⁿ⁺¹wₙ`, `yⁿ⁺¹uₙ`, `uₙ²` and `wₙ²`. -/
private noncomputable def obstructionIdeal : Ideal (MvPolynomial witnessIndex ℚ) :=
  Ideal.span ((fun e => MvPolynomial.monomial e (1 : ℚ)) '' witnessRelations)

/-- The ring `ℚ[x, y, u₀, w₀, u₁, w₁, …]/(xⁿ⁺¹wₙ, yⁿ⁺¹uₙ, uₙ², wₙ²)`. -/
private noncomputable abbrev obstructionRing :=
  MvPolynomial witnessIndex ℚ ⧸ obstructionIdeal

/-- The image of a variable in the obstruction ring. -/
private noncomputable def obstructionVariable (i : witnessIndex) : obstructionRing :=
  Ideal.Quotient.mk obstructionIdeal (MvPolynomial.X i)

/-- No relation monomial divides `xⁿyⁿuₙwₙ`: the `n`-th relations need one more factor of `x`
or of `y`, and the others involve a variable of index other than `n`. -/
private lemma no_relation_divides_obstruction (n : ℕ) :
    ∀ s ∈ witnessRelations, ¬ s ≤ obstructionExponent n := by
  intro s hs hle
  simp only [witnessRelations, Set.mem_union, Set.mem_range] at hs
  rcases hs with ((⟨m, rfl⟩ | ⟨m, rfl⟩) | ⟨m, rfl⟩) | ⟨m, rfl⟩
  · have hindex := (Finsupp.le_def.mp hle) (witnessW m)
    by_cases hmn : m = n
    · subst m
      have hpow := (Finsupp.le_def.mp hle) witnessX
      simp [xwExponent, obstructionExponent, witnessX, witnessY, witnessU,
        witnessW] at hpow
    · simp [xwExponent, obstructionExponent, witnessX,
        witnessY, witnessU, witnessW, hmn] at hindex
  · have hindex := (Finsupp.le_def.mp hle) (witnessU m)
    by_cases hmn : m = n
    · subst m
      have hpow := (Finsupp.le_def.mp hle) witnessY
      simp [yuExponent, obstructionExponent, witnessX, witnessY, witnessU,
        witnessW] at hpow
    · simp [yuExponent, obstructionExponent, witnessX,
        witnessY, witnessU, witnessW, hmn] at hindex
  · have hcoord := (Finsupp.le_def.mp hle) (witnessU m)
    by_cases hmn : m = n <;>
      simp [uSquareExponent, obstructionExponent,
        witnessX, witnessY, witnessU, witnessW, hmn] at hcoord
  · have hcoord := (Finsupp.le_def.mp hle) (witnessW m)
    by_cases hmn : m = n <;>
      simp [wSquareExponent, obstructionExponent,
        witnessX, witnessY, witnessU, witnessW, hmn] at hcoord

/-- The product `xⁿyⁿuₙwₙ` of images of variables is the image of the corresponding
monomial. -/
private lemma obstructionVariable_product (n : ℕ) :
    obstructionVariable witnessX ^ n * obstructionVariable witnessY ^ n *
        obstructionVariable (witnessU n) * obstructionVariable (witnessW n) =
      Ideal.Quotient.mk obstructionIdeal
        (MvPolynomial.monomial (obstructionExponent n) (1 : ℚ)) := by
  have hpoly :
      MvPolynomial.X witnessX ^ n * MvPolynomial.X witnessY ^ n *
        MvPolynomial.X (witnessU n) * MvPolynomial.X (witnessW n) =
      MvPolynomial.monomial (obstructionExponent n) (1 : ℚ) := by
    rw [show MvPolynomial.X (witnessU n) = MvPolynomial.X (witnessU n) ^ 1 by simp,
      show MvPolynomial.X (witnessW n) = MvPolynomial.X (witnessW n) ^ 1 by simp,
      MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
      MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
      MvPolynomial.monomial_mul_monomial, MvPolynomial.monomial_mul_monomial,
      MvPolynomial.monomial_mul_monomial]
    simp [obstructionExponent]
  simpa [obstructionVariable] using congrArg (Ideal.Quotient.mk obstructionIdeal) hpoly

/-- The linear functional on polynomials summing the coefficients of the monomials
`xⁿyⁿuₙwₙ`. -/
private noncomputable def obstructionPolynomialFunctional :
    MvPolynomial witnessIndex ℚ →ₗ[ℚ] ℚ := by
  classical
  exact (Finsupp.linearCombination ℚ (fun e : witnessIndex →₀ ℕ =>
      if ∃ n, e = obstructionExponent n then (1 : ℚ) else 0)) ∘ₗ
    (AddMonoidAlgebra.coeffLinearEquiv ℚ (S := ℚ) (M := witnessIndex →₀ ℕ))

/-- The functional takes the value one on each monomial `xⁿyⁿuₙwₙ`. -/
private lemma obstructionPolynomialFunctional_monomial (n : ℕ) :
    obstructionPolynomialFunctional
      (MvPolynomial.monomial (obstructionExponent n) (1 : ℚ)) = 1 := by
  classical
  show (Finsupp.linearCombination ℚ _)
    (Finsupp.single (obstructionExponent n) (1 : ℚ)) = 1
  rw [Finsupp.linearCombination_single]
  simp

/-- The functional vanishes on the relation ideal, because an element of a monomial ideal is
supported on multiples of its generators and no generator divides `xⁿyⁿuₙwₙ`. -/
private lemma obstructionPolynomialFunctional_eq_zero_of_mem_ideal
    (p : MvPolynomial witnessIndex ℚ) (hp : p ∈ obstructionIdeal) :
    obstructionPolynomialFunctional p = 0 := by
  classical
  rw [obstructionIdeal, MvPolynomial.mem_ideal_span_monomial_image] at hp
  show (Finsupp.linearCombination ℚ _)
    (AddMonoidAlgebra.coeff p) = 0
  rw [Finsupp.linearCombination_apply, Finsupp.sum]
  refine Finset.sum_eq_zero fun e he => ?_
  by_cases heObs : ∃ n, e = obstructionExponent n
  · obtain ⟨n, rfl⟩ := heObs
    have hsupport : obstructionExponent n ∈ p.support := by
      rw [MvPolynomial.mem_support_iff]
      simpa using he
    obtain ⟨s, hs, hle⟩ := hp (obstructionExponent n) hsupport
    exact (no_relation_divides_obstruction n s hs hle).elim
  · simp [heObs]

/-- The relation ideal viewed as a `ℚ`-submodule. -/
private noncomputable abbrev obstructionIdealQ :
    Submodule ℚ (MvPolynomial witnessIndex ℚ) :=
  obstructionIdeal.restrictScalars ℚ

/-- The relation ideal is contained in the kernel of the functional. -/
private lemma obstructionPolynomialFunctional_ker :
    obstructionIdealQ ≤ LinearMap.ker obstructionPolynomialFunctional := by
  intro p hp
  rw [LinearMap.mem_ker]
  exact obstructionPolynomialFunctional_eq_zero_of_mem_ideal p
    (by simpa [obstructionIdealQ, Submodule.restrictScalars_mem] using hp)

/-- The induced functional on the obstruction ring. -/
private noncomputable def obstructionQuotientFunctional : obstructionRing →ₗ[ℚ] ℚ :=
  Submodule.liftQ obstructionIdealQ obstructionPolynomialFunctional
    obstructionPolynomialFunctional_ker

/-- Halving, as an additive map on the rationals. -/
private noncomputable def halfRational : ℚ →+ ℚ where
  toFun q := q / 2
  map_zero' := by simp
  map_add' q r := by ring

/-- The character of the obstruction ring taking the value `1/2` on each `xⁿyⁿuₙwₙ`. -/
private noncomputable def obstructionCharacter : CharacterModule obstructionRing :=
  (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℚ))).comp
    (halfRational.comp obstructionQuotientFunctional.toAddMonoidHom)

/-- The obstruction character takes the value `1/2` on the image of `xⁿyⁿuₙwₙ`. -/
private lemma obstructionCharacter_apply (n : ℕ) :
    obstructionCharacter
      (Ideal.Quotient.mk obstructionIdeal
        (MvPolynomial.monomial (obstructionExponent n) (1 : ℚ))) =
      (1 / 2 : ℚ) := by
  show (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℚ)))
    (halfRational
      ((Submodule.liftQ obstructionIdealQ obstructionPolynomialFunctional
          obstructionPolynomialFunctional_ker)
        (Submodule.Quotient.mk
          (MvPolynomial.monomial (obstructionExponent n) (1 : ℚ))))) = _
  rw [Submodule.liftQ_apply, obstructionPolynomialFunctional_monomial]
  simp [halfRational]

/-- The obstruction character does not vanish on the image of `xⁿyⁿuₙwₙ`, since `1/2` is not an
integer. -/
private lemma obstructionCharacter_apply_ne_zero (n : ℕ) :
    obstructionCharacter
      (Ideal.Quotient.mk obstructionIdeal
        (MvPolynomial.monomial (obstructionExponent n) (1 : ℚ))) ≠ 0 := by
  rw [obstructionCharacter_apply]
  intro h
  have hmem : (1 / 2 : ℚ) ∈ Set.Ico (0 : ℚ) 1 := by norm_num
  rw [AddCircle.coe_eq_zero_iff_of_mem_Ico hmem] at h
  norm_num at h

/-- A relation monomial `iⁿ⁺¹ j` becomes zero in the obstruction ring. -/
private lemma obstructionVariable_pow_mul_eq_zero (i j : witnessIndex) (n : ℕ)
    (h : Finsupp.single i (n + 1) + Finsupp.single j 1 ∈ witnessRelations) :
    obstructionVariable i ^ (n + 1) * obstructionVariable j = 0 := by
  rw [obstructionVariable, obstructionVariable, ← map_pow, ← map_mul,
    Ideal.Quotient.eq_zero_iff_mem, ← pow_one (MvPolynomial.X j), MvPolynomial.X_pow_eq_monomial,
    MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul_monomial]
  exact Ideal.subset_span ⟨_, h, by rw [mul_one]⟩

/-- Each of the variables `uₙ`, `wₙ` squares to zero in the obstruction ring. -/
private lemma obstructionVariable_square (n : ℕ) (b : Bool) :
    obstructionVariable (Sum.inr (n, b)) ^ 2 = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  show MvPolynomial.X (Sum.inr (n, b)) ^ 2 ∈ obstructionIdeal
  rw [MvPolynomial.X_pow_eq_monomial]
  apply Ideal.subset_span
  cases b
  · exact ⟨uSquareExponent n, Or.inl (Or.inr ⟨n, rfl⟩), rfl⟩
  · exact ⟨wSquareExponent n, Or.inr ⟨n, rfl⟩, rfl⟩

/-- The map from `ℚ[x, y]` onto the reduction of the obstruction ring, which is surjective
because all the other variables are nilpotent. -/
private noncomputable def reducedPolynomialMap :
    MvPolynomial (Fin 2) ℚ →+* obstructionRing ⧸ nilradical obstructionRing :=
  MvPolynomial.eval₂Hom
    ((Ideal.Quotient.mk (nilradical obstructionRing)).comp
      ((Ideal.Quotient.mk obstructionIdeal).comp MvPolynomial.C))
    (fun i => Ideal.Quotient.mk (nilradical obstructionRing)
      (obstructionVariable (Sum.inl i)))

/-- The map from `ℚ[x, y]` onto the reduction of the obstruction ring is surjective. -/
private lemma reducedPolynomialMap_surjective :
    Function.Surjective reducedPolynomialMap := by
  intro z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  show (Ideal.Quotient.mk (nilradical obstructionRing))
    (Ideal.Quotient.mk obstructionIdeal p) ∈ reducedPolynomialMap.range
  induction p using MvPolynomial.induction_on with
  | C a => exact ⟨MvPolynomial.C a, by simp [reducedPolynomialMap]⟩
  | add p q hp hq => simpa only [map_add] using reducedPolynomialMap.range.add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul]
    apply reducedPolynomialMap.range.mul_mem hp
    cases i with
    | inl i => exact ⟨MvPolynomial.X i, by simp [reducedPolynomialMap, obstructionVariable]⟩
    | inr j =>
      have hz : Ideal.Quotient.mk (nilradical obstructionRing)
          (obstructionVariable (Sum.inr j)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (mem_nilradical.mpr
          ⟨2, obstructionVariable_square j.1 j.2⟩)
      rw [show Ideal.Quotient.mk obstructionIdeal (MvPolynomial.X (Sum.inr j)) =
        obstructionVariable (Sum.inr j) from rfl, hz]
      exact reducedPolynomialMap.range.zero_mem

/-- The spectrum of the obstruction ring is a Noetherian topological space: it is homeomorphic
to the spectrum of the reduction, which is a quotient of `ℚ[x, y]`. -/
private lemma obstructionRing_noetherianSpace :
    NoetherianSpace (PrimeSpectrum obstructionRing) := by
  have : IsNoetherianRing (obstructionRing ⧸ nilradical obstructionRing) :=
    isNoetherianRing_of_surjective _ _ reducedPolynomialMap reducedPolynomialMap_surjective
  apply TopologicalSpace.noetherianSpace_of_surjective (α := PrimeSpectrum
    (obstructionRing ⧸ nilradical obstructionRing))
    (PrimeSpectrum.comap (Ideal.Quotient.mk (nilradical obstructionRing)))
  · exact PrimeSpectrum.continuous_comap _
  · exact (PrimeSpectrum.comap_quotientMk_bijective_of_le_nilradical
      (R := obstructionRing) (I := nilradical obstructionRing) le_rfl).surjective

universe v₁ v₂ v₃ v₄

/-- The algebraic heart of the obstruction. Given a module `M` with two localization maps at
`x` and at `y` and one at `xy`, together with elements `aₙ`, `bₙ` killed by `yⁿ⁺¹`, by `xⁿ⁺¹`,
and a `c` with `(aₙbₙ(xy)ⁿ) • c ≠ 0` for all `n`, no element of the localization at `xy` is a
sum of an element from the localization at `x` and one from the localization at `y`. -/
private lemma localization_pair_not_surjective
    {R : Type u} [CommRing R]
    {M : Type v₁} {N₁ : Type v₂} {N₂ : Type v₃} {N₃ : Type v₄}
    [AddCommGroup M] [AddCommGroup N₁]
    [AddCommGroup N₂] [AddCommGroup N₃]
    [Module R M] [Module R N₁] [Module R N₂] [Module R N₃]
    (x y : R) (f₁ : M →ₗ[R] N₁) (f₂ : M →ₗ[R] N₂) (f₃ : M →ₗ[R] N₃)
    [IsLocalizedModule.Away x f₁] [IsLocalizedModule.Away y f₂]
    [IsLocalizedModule.Away (x * y) f₃]
    (r₁ : N₁ →ₗ[R] N₃) (r₂ : N₂ →ₗ[R] N₃)
    (h₁ : r₁.comp f₁ = f₃) (h₂ : r₂.comp f₂ = f₃)
    (c : M) (a b : ℕ → R)
    (ha : ∀ n, y ^ (n + 1) * a n = 0)
    (hb : ∀ n, x ^ (n + 1) * b n = 0)
    (hc : ∀ n, (a n * b n * (x * y) ^ n) • c ≠ 0) :
    ∃ s : N₃, ∀ i : N₁, ∀ j : N₂, r₁ i + r₂ j ≠ s := by
  obtain ⟨s, hs⟩ := ((Module.End.isUnit_iff _).mp
    (IsLocalizedModule.Away.isUnit_algebraMap f₃ (x * y))).surjective (f₃ c)
  change (x * y) • s = f₃ c at hs
  refine ⟨s, ?_⟩
  intro i j hij
  obtain ⟨n₁, i₀, hi₀⟩ := IsLocalizedModule.Away.surj f₁ x i
  obtain ⟨n₂, j₀, hj₀⟩ := IsLocalizedModule.Away.surj f₂ y j
  let n := n₁ + n₂
  let i' := x ^ n₂ • i₀
  let j' := y ^ n₁ • j₀
  have hi : x ^ n • i = f₁ i' := by
    simp only [n, i', pow_add, mul_smul, map_smul]
    rw [smul_comm, hi₀]
  have hj : y ^ n • j = f₂ j' := by
    simp only [n, j', pow_add, mul_smul, map_smul, hj₀]
  have hri : x ^ n • r₁ i = f₃ i' := by
    rw [← map_smul, hi]
    exact congrArg (fun f : M →ₗ[R] N₃ => f i') h₁
  have hrj : y ^ n • r₂ j = f₃ j' := by
    rw [← map_smul, hj]
    exact congrArg (fun f : M →ₗ[R] N₃ => f j') h₂
  have heq : f₃ ((x * y) ^ n • c) =
      f₃ ((x * y ^ (n + 1)) • i' + (x ^ (n + 1) * y) • j') := by
    calc
      f₃ ((x * y) ^ n • c) = (x * y) ^ (n + 1) • s := by
        simp only [map_smul, ← hs, pow_succ, mul_smul]
      _ = (x * y) ^ (n + 1) • (r₁ i + r₂ j) := by rw [hij]
      _ = (x * y ^ (n + 1)) • (x ^ n • r₁ i) +
          (x ^ (n + 1) * y) • (y ^ n • r₂ j) := by
        rw [smul_add, ← mul_smul, ← mul_smul]
        congr 2 <;> ring
      _ = _ := by simp only [hri, hrj, map_add, map_smul]
  obtain ⟨t, ht⟩ := IsLocalizedModule.Away.exists_of_eq (x * y) heq
  have hz₁ : a (n + t) * b (n + t) * (x * y) ^ t * x * y ^ (n + 1) = 0 := by
    calc
      _ = (y ^ (n + t + 1) * a (n + t)) * (b (n + t) * x ^ (t + 1)) := by ring
      _ = 0 := by rw [ha, zero_mul]
  have hz₂ : a (n + t) * b (n + t) * (x * y) ^ t * x ^ (n + 1) * y = 0 := by
    calc
      _ = (x ^ (n + t + 1) * b (n + t)) * (a (n + t) * y ^ (t + 1)) := by ring
      _ = 0 := by rw [hb, zero_mul]
  apply hc (n + t)
  simpa only [smul_add, ← mul_smul, ← mul_assoc, ← pow_add, Nat.add_comm t n,
    hz₁, hz₂, zero_smul, add_zero] using congrArg (fun z : M => (a (n + t) * b (n + t)) • z) ht

/-- The obstruction in difference form: no element of the localization at `xy` is a difference
of an element from the localization at `x` and one from the localization at `y`. -/
private lemma localization_pair_not_surjective_sub
    {R : Type u} [CommRing R]
    {M : Type v₁} {N₁ : Type v₂} {N₂ : Type v₃} {N₃ : Type v₄}
    [AddCommGroup M] [AddCommGroup N₁]
    [AddCommGroup N₂] [AddCommGroup N₃]
    [Module R M] [Module R N₁] [Module R N₂] [Module R N₃]
    (x y : R) (f₁ : M →ₗ[R] N₁) (f₂ : M →ₗ[R] N₂) (f₃ : M →ₗ[R] N₃)
    [IsLocalizedModule.Away x f₁] [IsLocalizedModule.Away y f₂]
    [IsLocalizedModule.Away (x * y) f₃]
    (r₁ : N₁ →ₗ[R] N₃) (r₂ : N₂ →ₗ[R] N₃)
    (h₁ : r₁.comp f₁ = f₃) (h₂ : r₂.comp f₂ = f₃)
    (c : M) (a b : ℕ → R)
    (ha : ∀ n, y ^ (n + 1) * a n = 0)
    (hb : ∀ n, x ^ (n + 1) * b n = 0)
    (hc : ∀ n, (a n * b n * (x * y) ^ n) • c ≠ 0) :
    ∃ s : N₃, ∀ i : N₁, ∀ j : N₂, r₁ i - r₂ j ≠ s := by
  obtain ⟨s, hs⟩ := localization_pair_not_surjective x y f₁ f₂ f₃ r₁ r₂ h₁ h₂ c a b ha hb hc
  exact ⟨s, fun i j h => hs i (-j) (by rwa [map_neg, ← sub_eq_add_neg])⟩

/-- The obstruction, transported to the associated sheaf: a section of `M~` over `D(xy)` that
is not a difference of the restrictions of a section over `D(x)` and a section over `D(y)`. -/
private lemma tilde_sections_obstruction {R : CommRingCat.{u}}
    (M : ModuleCat.{u} R) (x y : R) (c : M) (a b : ℕ → R)
    (ha : ∀ n, y ^ (n + 1) * a n = 0)
    (hb : ∀ n, x ^ (n + 1) * b n = 0)
    (hc : ∀ n, (a n * b n * (x * y) ^ n) • c ≠ 0) :
    ∃ s : (tilde M).val.obj (Opposite.op (PrimeSpectrum.basicOpen (x * y))),
      ∀ i : (tilde M).val.obj (Opposite.op (PrimeSpectrum.basicOpen x)),
      ∀ j : (tilde M).val.obj (Opposite.op (PrimeSpectrum.basicOpen y)),
      (tilde M).val.presheaf.map (homOfLE
        (show PrimeSpectrum.basicOpen (x * y) ≤ PrimeSpectrum.basicOpen x from
          by rw [PrimeSpectrum.basicOpen_mul]; exact inf_le_left)).op i -
      (tilde M).val.presheaf.map (homOfLE
        (show PrimeSpectrum.basicOpen (x * y) ≤ PrimeSpectrum.basicOpen y from
          by rw [PrimeSpectrum.basicOpen_mul]; exact inf_le_right)).op j ≠ s := by
  let P := (modulesSpecToSheaf.obj (tilde M)).presheaf
  have hx : PrimeSpectrum.basicOpen (x * y) ≤ PrimeSpectrum.basicOpen x :=
    (PrimeSpectrum.basicOpen_mul x y).le.trans inf_le_left
  have hy : PrimeSpectrum.basicOpen (x * y) ≤ PrimeSpectrum.basicOpen y :=
    (PrimeSpectrum.basicOpen_mul x y).le.trans inf_le_right
  exact localization_pair_not_surjective_sub x y
    (tilde.toOpen M (PrimeSpectrum.basicOpen x)).hom
    (tilde.toOpen M (PrimeSpectrum.basicOpen y)).hom
    (tilde.toOpen M (PrimeSpectrum.basicOpen (x * y))).hom
    (P.map (homOfLE hx).op).hom (P.map (homOfLE hy).op).hom
    (congrArg ModuleCat.Hom.hom (tilde.toOpen_res M _ _ (homOfLE hx)))
    (congrArg ModuleCat.Hom.hom (tilde.toOpen_res M _ _ (homOfLE hy)))
    c a b ha hb hc

section

open Opposite

/-- Two sections of an abelian sheaf agreeing on the intersection of two opens glue to a
section on their union. -/
private lemma sheaf_sup_glue {X : Type u} [TopologicalSpace X]
    (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    (U V : Opens X) (a : F.obj.obj (op U)) (b : F.obj.obj (op V))
    (h : F.obj.map (homOfLE (show U ⊓ V ≤ U from inf_le_left)).op a =
      F.obj.map (homOfLE (show U ⊓ V ≤ V from inf_le_right)).op b) :
    ∃ s : F.obj.obj (op (U ⊔ V)),
      F.obj.map (homOfLE le_sup_left).op s = a ∧
      F.obj.map (homOfLE le_sup_right).op s = b := by
  have hF := (Opens.mayerVietorisSquare U V).sheafCondition_of_sheaf
    ((sheafCompose _ (forget AddCommGrpCat.{u})).obj F)
  exact ⟨hF.glue a b h, hF.map_f₂₄_op_glue a b h, hF.map_f₃₄_op_glue a b h⟩

/-- A section of an abelian sheaf on a union of two opens is determined by its restrictions to
the two opens. -/
private lemma sheaf_sup_ext {X : Type u} [TopologicalSpace X]
    (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
    (U V : Opens X) (a b : F.obj.obj (op (U ⊔ V)))
    (hU : F.obj.map (homOfLE (show U ≤ U ⊔ V from le_sup_left)).op a =
      F.obj.map (homOfLE le_sup_left).op b)
    (hV : F.obj.map (homOfLE (show V ≤ U ⊔ V from le_sup_right)).op a =
      F.obj.map (homOfLE le_sup_right).op b) : a = b :=
  ((Opens.mayerVietorisSquare U V).sheafCondition_of_sheaf
    ((sheafCompose _ (forget AddCommGrpCat.{u})).obj F)).ext hU hV

/-- Taking sections over an open of a sheaf of modules preserves finite limits. -/
private lemma preservesFiniteLimits_secF {X : Type u} [TopologicalSpace X]
    (R : Sheaf (Opens.grothendieckTopology X) RingCat.{u}) (W : Opens X) :
    PreservesFiniteLimits (secF R W) :=
  inferInstanceAs (PreservesFiniteLimits (SheafOfModules.toSheaf R ⋙
    sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (op W)))

/-- Sections over a fixed open of the start of an injective resolution form a short exact
pair, since taking sections over an open preserves finite limits. -/
private lemma resolution_sections_exact {X : Type u} [TopologicalSpace X]
    (R : Sheaf (Opens.grothendieckTopology X) RingCat.{u})
    (F : SheafOfModules.{u} R) (P : InjectiveResolution F) (W : Opens X) :
    (ShortComplex.mk ((secF R W).map (P.ι.f 0))
      ((secF R W).map (P.cocomplex.d 0 1))
      (by rw [← Functor.map_comp, P.ι_f_zero_comp_complex_d, Functor.map_zero])).Exact := by
  have := preservesFiniteLimits_secF R W
  apply ShortComplex.exact_of_f_is_kernel
  exact KernelFork.mapIsLimit P.kernelFork P.isLimitKernelFork (secF R W)

/-- If the first cohomology of a sheaf of modules vanishes on `U ⊔ V`, then every section over
`U ⊓ V` is a difference of a section over `U` and a section over `V`. -/
private lemma cech_surjective_of_isZero_firstCohomology
    {X : Type u} [TopologicalSpace X]
    (R : Sheaf (Opens.grothendieckTopology X) RingCat.{u})
    (F : SheafOfModules.{u} R) (U V : Opens X)
    (hz : IsZero (Hgroup R (U ⊔ V) 1 F))
    (s : F.val.obj (op (U ⊓ V))) :
    ∃ a : F.val.obj (op U), ∃ b : F.val.obj (op V),
      F.val.presheaf.map (homOfLE inf_le_left).op a -
        F.val.presheaf.map (homOfLE inf_le_right).op b = s := by
  have := preservesFiniteLimits_secF R
  let P := injectiveResolution F
  let G := SheafOfModules.toSheaf R
  change (G.obj F).obj.obj (op (U ⊓ V)) at s
  let η : G.obj F ⟶ G.obj (P.cocomplex.X 0) := G.map (P.ι.f 0)
  let d := G.map (P.cocomplex.d 0 1)
  let e := G.map (P.cocomplex.d 1 2)
  have hηd : η ≫ d = 0 := by
    show G.map (P.ι.f 0) ≫ G.map (P.cocomplex.d 0 1) = 0
    rw [← G.map_comp, P.ι_f_zero_comp_complex_d, G.map_zero]
  have hde : d ≫ e = 0 := by
    show G.map (P.cocomplex.d 0 1) ≫ G.map (P.cocomplex.d 1 2) = 0
    rw [← G.map_comp, P.cocomplex.d_comp_d, G.map_zero]
  obtain ⟨a, ha⟩ := Stacks.Cohomology.InjectiveRestriction.injective_restriction_surjective
    R (P.cocomplex.X 0) (show U ⊓ V ≤ U from inf_le_left) (η.hom.app (op (U ⊓ V)) s)
  change (G.obj (P.cocomplex.X 0)).obj.obj (op U) at a
  change (G.obj (P.cocomplex.X 0)).obj.map (homOfLE inf_le_left).op a =
    η.hom.app (op (U ⊓ V)) s at ha
  have hglue : (G.obj (P.cocomplex.X 1)).obj.map
      (homOfLE (show U ⊓ V ≤ U from inf_le_left)).op (d.hom.app (op U) a) =
      (G.obj (P.cocomplex.X 1)).obj.map
      (homOfLE (show U ⊓ V ≤ V from inf_le_right)).op 0 := by
    rw [← d.hom.naturality_apply, ha, map_zero]
    exact ConcreteCategory.congr_hom (congrArg (fun f => f.hom.app (op (U ⊓ V))) hηd) s
  obtain ⟨z, hzU, hzV⟩ := sheaf_sup_glue (G.obj (P.cocomplex.X 1)) U V
    (d.hom.app (op U) a) 0 hglue
  have hez : e.hom.app (op (U ⊔ V)) z = 0 := by
    apply sheaf_sup_ext (G.obj (P.cocomplex.X 2)) U V
    · rw [← e.hom.naturality_apply, hzU, map_zero]
      exact ConcreteCategory.congr_hom (congrArg (fun f => f.hom.app (op U)) hde) a
    · rw [← e.hom.naturality_apply, hzV, map_zero, map_zero]
  have hzero : IsZero ((secCx R P (U ⊔ V)).homology 1) :=
    hz.of_iso (P.isoRightDerivedObj (secF R (U ⊔ V)) 1).symm
  have hex := (HomologicalComplex.exactAt_iff' (secCx R P (U ⊔ V)) 0 1 2 (by simp) (by simp)).mp
    ((HomologicalComplex.exactAt_iff_isZero_homology _ _).mpr hzero)
  obtain ⟨t, ht⟩ := (ShortComplex.ab_exact_iff _).mp hex z hez
  change (G.obj (P.cocomplex.X 0)).obj.obj (op (U ⊔ V)) at t
  change d.hom.app (op (U ⊔ V)) t = z at ht
  let tU := (G.obj (P.cocomplex.X 0)).obj.map (homOfLE
    (show U ≤ U ⊔ V from le_sup_left)).op t
  let tV := (G.obj (P.cocomplex.X 0)).obj.map (homOfLE
    (show V ≤ U ⊔ V from le_sup_right)).op t
  have hU : d.hom.app (op U) (a - tU) = 0 := by
    rw [map_sub, sub_eq_zero]
    dsimp [tU]
    rw [d.hom.naturality_apply, ht, hzU]
  have hV : d.hom.app (op V) (-tV) = 0 := by
    rw [map_neg, neg_eq_zero]
    dsimp [tV]
    rw [d.hom.naturality_apply, ht, hzV]
  obtain ⟨a', ha'⟩ := (ShortComplex.ab_exact_iff _).mp
    (resolution_sections_exact R F P U) (a - tU) hU
  obtain ⟨b', hb'⟩ := (ShortComplex.ab_exact_iff _).mp
    (resolution_sections_exact R F P V) (-tV) hV
  change (G.obj F).obj.obj (op U) at a'
  change (G.obj F).obj.obj (op V) at b'
  change η.hom.app (op U) a' = a - tU at ha'
  change η.hom.app (op V) b' = -tV at hb'
  refine ⟨a', b', ?_⟩
  have hinj : Function.Injective (η.hom.app (op (U ⊓ V))) := by
    show Function.Injective ((secF R (U ⊓ V)).map (P.ι.f 0))
    exact (AddCommGrpCat.mono_iff_injective _).mp inferInstance
  have hres : (G.obj (P.cocomplex.X 0)).obj.map (homOfLE
      (show U ⊓ V ≤ U from inf_le_left)).op tU =
    (G.obj (P.cocomplex.X 0)).obj.map (homOfLE
      (show U ⊓ V ≤ V from inf_le_right)).op tV := by
    dsimp [tU, tV]
    simp only [← Functor.map_comp_apply]
    rfl
  have key : η.hom.app (op (U ⊓ V))
      ((G.obj F).obj.map (homOfLE (show U ⊓ V ≤ U from inf_le_left)).op a' -
        (G.obj F).obj.map (homOfLE (show U ⊓ V ≤ V from inf_le_right)).op b') =
      η.hom.app (op (U ⊓ V)) s := by
    rw [map_sub, η.hom.naturality_apply, η.hom.naturality_apply, ha', hb', map_sub,
      map_neg, ha, hres]
    abel
  exact hinj key

end

/-- First cohomology of `M~` on `D(x) ⊔ D(y)` is nonzero as soon as the algebraic obstruction
is present in `M`. -/
private lemma tilde_firstCohomology_nonzero_of_obstruction {R : CommRingCat.{u}}
    (M : ModuleCat.{u} R) (x y : R) (c : M) (a b : ℕ → R)
    (ha : ∀ n, y ^ (n + 1) * a n = 0)
    (hb : ∀ n, x ^ (n + 1) * b n = 0)
    (hc : ∀ n, (a n * b n * (x * y) ^ n) • c ≠ 0) :
    ¬ IsZero (Hgroup (Spec R).ringCatSheaf
      (PrimeSpectrum.basicOpen x ⊔ PrimeSpectrum.basicOpen y) 1 (tilde M)) := by
  intro hz
  obtain ⟨s, hs⟩ := tilde_sections_obstruction M x y c a b ha hb hc
  have hcech (W : (Spec R).Opens)
      (hWx : W ≤ PrimeSpectrum.basicOpen x) (hWy : W ≤ PrimeSpectrum.basicOpen y)
      (hW : W = PrimeSpectrum.basicOpen x ⊓ PrimeSpectrum.basicOpen y)
      (z : (tilde M).val.obj (Opposite.op W)) :
      ∃ i : (tilde M).val.obj (Opposite.op (PrimeSpectrum.basicOpen x)),
      ∃ j : (tilde M).val.obj (Opposite.op (PrimeSpectrum.basicOpen y)),
        (tilde M).val.presheaf.map (homOfLE hWx).op i -
          (tilde M).val.presheaf.map (homOfLE hWy).op j = z := by
    subst W
    exact cech_surjective_of_isZero_firstCohomology (Spec R).ringCatSheaf (tilde M)
      (PrimeSpectrum.basicOpen x) (PrimeSpectrum.basicOpen y) hz z
  obtain ⟨i, j, hij⟩ := hcech (PrimeSpectrum.basicOpen (x * y))
    ((PrimeSpectrum.basicOpen_mul x y).le.trans inf_le_left)
    ((PrimeSpectrum.basicOpen_mul x y).le.trans inf_le_right)
    (PrimeSpectrum.basicOpen_mul x y) s
  exact hs i j hij

/-- The relation `xⁿ⁺¹wₙ = 0` in the obstruction ring. -/
private lemma obstructionVariable_xw (n : ℕ) :
    obstructionVariable witnessX ^ (n + 1) * obstructionVariable (witnessW n) = 0 :=
  obstructionVariable_pow_mul_eq_zero _ _ n (Or.inl (Or.inl (Or.inl ⟨n, rfl⟩)))

/-- The relation `yⁿ⁺¹uₙ = 0` in the obstruction ring. -/
private lemma obstructionVariable_yu (n : ℕ) :
    obstructionVariable witnessY ^ (n + 1) * obstructionVariable (witnessU n) = 0 :=
  obstructionVariable_pow_mul_eq_zero _ _ n (Or.inl (Or.inl (Or.inr ⟨n, rfl⟩)))

/-- The obstruction character does not vanish on `uₙwₙ(xy)ⁿ`, which is the hypothesis the
algebraic obstruction needs. -/
private lemma obstructionCharacter_coefficient_ne_zero (n : ℕ) :
    obstructionCharacter (obstructionVariable (witnessU n) *
      obstructionVariable (witnessW n) *
      (obstructionVariable witnessX * obstructionVariable witnessY) ^ n) ≠ 0 := by
  have he : obstructionVariable (witnessU n) * obstructionVariable (witnessW n) *
      (obstructionVariable witnessX * obstructionVariable witnessY) ^ n =
      obstructionVariable witnessX ^ n * obstructionVariable witnessY ^ n *
        obstructionVariable (witnessU n) * obstructionVariable (witnessW n) := by
    ring
  rw [he, obstructionVariable_product]
  exact obstructionCharacter_apply_ne_zero n

/-- **Stacks Project, Tag 0CRZ.** An injective module on an affine scheme with Noetherian
underlying space can have nonzero first cohomology on a quasi-compact open. -/
@[stacks 0CRZ, sga "6 II AppI.0.1" "noetherian space case", sga "6 II AppI.1.2" "H¹(U,Ĩ)≠0"]
theorem exists_injective_tilde_nonzero_firstCohomology :
    ∃ (A : CommRingCat.{u}) (I : ModuleCat.{u} A) (U : (Spec A).Opens),
      NoetherianSpace (Spec A) ∧ Injective I ∧
        IsCompact (U : Set (Spec A)) ∧
          ¬ IsZero (Hgroup (Spec A).ringCatSheaf U 1 (tilde I)) := by
  let R := ULift.{u} obstructionRing
  let A := CommRingCat.of R
  let I := ModuleCat.of A (CharacterModule R)
  let x : A := ULift.up (obstructionVariable witnessX)
  let y : A := ULift.up (obstructionVariable witnessY)
  let a : ℕ → A := fun n => ULift.up (obstructionVariable (witnessU n))
  let b : ℕ → A := fun n => ULift.up (obstructionVariable (witnessW n))
  let c : I := obstructionCharacter.comp ULift.ringEquiv.toAddMonoidHom
  have htop : NoetherianSpace (Spec A) := by
    show NoetherianSpace (PrimeSpectrum R)
    exact (TopologicalSpace.noetherianSpace_iff_of_homeomorph
      (PrimeSpectrum.homeomorphOfRingEquiv
        (ULift.ringEquiv : R ≃+* obstructionRing)).symm).mp obstructionRing_noetherianSpace
  refine ⟨A, I, PrimeSpectrum.basicOpen x ⊔ PrimeSpectrum.basicOpen y,
    htop, injective_characterModule R, NoetherianSpace.isCompact _, ?_⟩
  apply tilde_firstCohomology_nonzero_of_obstruction I x y c a b
  · exact fun n => ULift.down_injective (obstructionVariable_yu n)
  · exact fun n => ULift.down_injective (obstructionVariable_xw n)
  · intro n h
    have he := congrArg (fun f : CharacterModule R => f 1) h
    apply obstructionCharacter_coefficient_ne_zero n
    change obstructionCharacter ((obstructionVariable (witnessU n) *
      obstructionVariable (witnessW n) *
      (obstructionVariable witnessX * obstructionVariable witnessY) ^ n) * 1) = 0 at he
    simpa only [mul_one] using he

end Stacks.Examples.InjectiveTilde
