/-!
# An infinite descent family with no finite descent subfamily

There is an infinite family of flat algebras over a commutative ring for which the module-valued
Čech equalizer condition holds for every module, although it fails for every finite subfamily.
Consequently the V topology (and a fortiori the fpqc topology) is not generated by its
quasi-compact coverings.

The witness is the ring `ℕ → ℤ` of integer-valued sequences. Fix a nonprincipal ultrafilter
refining the cofinite filter. The indexing family consists of the members of that ultrafilter;
for a member `T` one inverts the idempotents that vanish on a finite subset of `T` and equal one
elsewhere. Every element of a localized module has a representative in the original module;
compatibility of a family of sections forces the differences of representatives to have finite
coordinate support, and the ultrafilter forces the coordinatewise gluing correction to have finite
support as well, so the correction lies in the original module. On the other hand, a coordinate
lying in the intersection of any finite subfamily supplies a nonzero idempotent killed by every
localization in that subfamily, so descent fails there.

## Main definitions

* `Stacks.Examples.IsModuleDescentEqualizer`: the elementwise equalizer condition for a subfamily
  of algebra maps and all modules over the base ring.

## Main results

* `Stacks.Examples.exists_infinite_flat_family_moduleDescentEqualizer`: there is an infinite flat
  family satisfying module descent for which no finite subfamily does.

## Implementation notes

The equalizer is expressed by unique gluing of compatible tensor-product sections. Compatibility
compares the images of two sections in `M ⊗[A] (Bᵢ ⊗[A] Bⱼ)` under the two canonical algebra maps;
this is the elementwise universal property of the displayed equalizer diagram.

## References

* [Stacks Project, Tag 0EUF](https://stacks.math.columbia.edu/tag/0EUF)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u v

namespace Stacks.Examples

private abbrev SequenceRing := ℕ → ULift.{u} ℤ

private noncomputable def complementIdempotent (supportFinset : Finset ℕ) :
    SequenceRing.{u} := fun coordinate => if coordinate ∈ supportFinset then 0 else 1

private noncomputable def coordinateIdempotent (coordinate : ℕ) : SequenceRing.{u} :=
  fun otherCoordinate => if otherCoordinate = coordinate then 1 else 0

private theorem complementIdempotent_union (supportFinset otherSupportFinset : Finset ℕ) :
    complementIdempotent (supportFinset ∪ otherSupportFinset) =
      complementIdempotent supportFinset * complementIdempotent otherSupportFinset := by
  classical
  ext coordinate
  simp only [complementIdempotent, Finset.mem_union, Pi.mul_apply]
  split_ifs <;> simp_all

private theorem complementIdempotent_mul_self (supportFinset : Finset ℕ) :
    complementIdempotent supportFinset * complementIdempotent supportFinset =
      complementIdempotent supportFinset := by
  rw [← complementIdempotent_union, Finset.union_self]

private theorem complementIdempotent_empty : complementIdempotent ∅ = (1 : SequenceRing.{u}) := by
  ext coordinate
  simp [complementIdempotent]

private noncomputable def maskDenominators (subset : Set ℕ) : Submonoid SequenceRing.{u} where
  carrier := {denominator | ∃ supportFinset : Finset ℕ,
    (↑supportFinset : Set ℕ) ⊆ subset ∧ denominator = complementIdempotent supportFinset}
  one_mem' := ⟨∅, by simp, complementIdempotent_empty.symm⟩
  mul_mem' := by
    rintro denominator otherSubset ⟨supportFinset, hF, rfl⟩ ⟨otherSupportFinset, hG, rfl⟩
    exact ⟨supportFinset ∪ otherSupportFinset, by simpa using Set.union_subset hF hG,
      (complementIdempotent_union supportFinset otherSupportFinset).symm⟩

private theorem maskDenominators_mono {subset otherSubset : Set ℕ} (hst : subset ⊆ otherSubset) :
    maskDenominators subset ≤ maskDenominators.{u} otherSubset := by
  rintro denominator ⟨supportFinset, hF, rfl⟩
  exact ⟨supportFinset, hF.trans hst, rfl⟩

private theorem maskDenominators_mul_self {subset : Set ℕ}
    (denominator : maskDenominators.{u} subset) :
    (denominator : SequenceRing) * denominator = denominator := by
  obtain ⟨_, _, equality⟩ := denominator.2
  rw [equality, complementIdempotent_mul_self]

private abbrev MaskLocalization (subset : Set ℕ) := Localization (maskDenominators.{u} subset)

private noncomputable def localizationTensorMap {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType] (subset : Set ℕ) :
    moduleType →ₗ[SequenceRing] moduleType ⊗[SequenceRing] MaskLocalization subset :=
  (TensorProduct.comm SequenceRing (MaskLocalization subset) moduleType).toLinearMap.comp
    (TensorProduct.mk SequenceRing (MaskLocalization subset) moduleType 1)

private theorem localizationTensorMap_apply {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (subset : Set ℕ) (element : moduleType) :
    localizationTensorMap subset element =
      element ⊗ₜ[SequenceRing] (1 : MaskLocalization subset) := by
  simp [localizationTensorMap]

private theorem localizationTensorMap_isLocalizedModule {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType] (subset : Set ℕ) :
    IsLocalizedModule (maskDenominators subset)
      (localizationTensorMap (moduleType := moduleType) subset) :=
  IsLocalizedModule.of_linearEquiv _ _
    (TensorProduct.comm SequenceRing (MaskLocalization subset) moduleType)

attribute [local instance] localizationTensorMap_isLocalizedModule

private theorem localizationTensorMap_surjective {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType] (subset : Set ℕ) :
    Function.Surjective (localizationTensorMap (moduleType := moduleType) subset) := by
  intro sectionValue
  obtain ⟨⟨element, denominator⟩, hr⟩ :=
    IsLocalizedModule.surj (maskDenominators subset) (localizationTensorMap subset) sectionValue
  have hid : (denominator : SequenceRing) • sectionValue = sectionValue := by
    apply (IsLocalizedModule.smul_inj
      (localizationTensorMap (moduleType := moduleType) subset) denominator _ _).mp
    change (denominator : SequenceRing) • ((denominator : SequenceRing) • sectionValue) =
      (denominator : SequenceRing) • sectionValue
    rw [smul_smul, maskDenominators_mul_self]
  exact ⟨element, hr.symm.trans hid⟩

private theorem localizationTensorMap_eq_iff {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (subset : Set ℕ) (element coordinate : moduleType) :
    localizationTensorMap subset element = localizationTensorMap subset coordinate ↔
      ∃ supportFinset : Finset ℕ, (↑supportFinset : Set ℕ) ⊆ subset ∧
        complementIdempotent supportFinset • (element - coordinate) = 0 := by
  rw [IsLocalizedModule.eq_iff_exists (maskDenominators subset) (localizationTensorMap subset)]
  constructor
  · rintro ⟨denominator, hr⟩
    obtain ⟨supportFinset, hF, equality⟩ := denominator.2
    exact ⟨supportFinset, hF, by
      simpa [Submonoid.smul_def, equality, smul_sub] using sub_eq_zero.mpr hr⟩
  · rintro ⟨supportFinset, hF, equality⟩
    exact ⟨⟨complementIdempotent supportFinset, ⟨supportFinset, hF, rfl⟩⟩, by
      simpa [Submonoid.smul_def] using sub_eq_zero.mp
        (smul_sub (complementIdempotent supportFinset) element coordinate ▸ equality)⟩

private noncomputable def localizationMap {subset otherSubset : Set ℕ}
    (hst : subset ⊆ otherSubset) :
    MaskLocalization.{u} subset →ₐ[SequenceRing] MaskLocalization otherSubset :=
  IsLocalization.liftAlgHom (f := Algebra.ofId SequenceRing (MaskLocalization otherSubset))
    (fun denominator => IsLocalization.map_units (MaskLocalization otherSubset)
      ⟨denominator.1, maskDenominators_mono hst denominator.2⟩)

private noncomputable def pairLocalizationMap (subset otherSubset : Set ℕ) :
    MaskLocalization.{u} subset ⊗[SequenceRing] MaskLocalization otherSubset →ₐ[SequenceRing]
      MaskLocalization (subset ∪ otherSubset) :=
  Algebra.TensorProduct.lift (localizationMap Set.subset_union_left)
    (localizationMap Set.subset_union_right) (fun _ _ => Commute.all _ _)

private theorem localizationTensorMap_union_eq {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (subset otherSubset : Set ℕ) (element coordinate : moduleType)
    (equality : TensorProduct.map (LinearMap.id : moduleType →ₗ[SequenceRing] moduleType)
        (Algebra.TensorProduct.includeLeft (R := SequenceRing) (A := MaskLocalization subset)
          (B := MaskLocalization otherSubset)).toLinearMap
        (localizationTensorMap subset element) =
      TensorProduct.map (LinearMap.id : moduleType →ₗ[SequenceRing] moduleType)
        (Algebra.TensorProduct.includeRight (R := SequenceRing) (A := MaskLocalization subset)
          (B := MaskLocalization otherSubset)).toLinearMap
        (localizationTensorMap otherSubset coordinate)) :
    localizationTensorMap (subset ∪ otherSubset) element =
      localizationTensorMap (subset ∪ otherSubset) coordinate := by
  simpa [localizationTensorMap_apply, TensorProduct.map_tmul, pairLocalizationMap] using
    congrArg (TensorProduct.map (LinearMap.id : moduleType →ₗ[SequenceRing] moduleType)
      (pairLocalizationMap subset otherSubset).toLinearMap) equality

private theorem coordinateIdempotent_mul (coordinate otherCoordinate : ℕ) :
    coordinateIdempotent.{u} coordinate * coordinateIdempotent otherCoordinate =
    if coordinate = otherCoordinate then coordinateIdempotent coordinate else 0 := by
  classical
  ext otherIndex
  simp only [coordinateIdempotent, Pi.mul_apply, Pi.zero_apply, ite_apply]
  split_ifs <;> simp_all

private theorem coordinateIdempotent_mul_complementIdempotent (coordinate : ℕ)
    (supportFinset : Finset ℕ) :
    coordinateIdempotent.{u} coordinate * complementIdempotent supportFinset =
    if coordinate ∈ supportFinset then 0 else coordinateIdempotent coordinate := by
  classical
  funext otherCoordinate
  simp only [coordinateIdempotent, complementIdempotent, Pi.mul_apply, Pi.zero_apply, ite_apply]
  split_ifs <;> simp_all

private theorem complementIdempotent_add_sum_coordinateIdempotent (supportFinset : Finset ℕ) :
    complementIdempotent supportFinset + ∑ coordinate ∈ supportFinset,
      coordinateIdempotent coordinate = (1 : SequenceRing.{u}) := by
  classical
  ext otherCoordinate
  simp only [Pi.add_apply, Finset.sum_apply, Pi.one_apply, coordinateIdempotent]
  simp_rw [eq_comm (a := otherCoordinate)]
  rw [Finset.sum_ite_eq']
  simp only [complementIdempotent]
  split_ifs <;> simp_all

private theorem coordinateIdempotent_smul_eq_zero_of_complementIdempotent {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    {supportFinset : Finset ℕ} {element : moduleType}
    (hm : complementIdempotent supportFinset • element = 0) {coordinate : ℕ}
    (hn : coordinate ∉ supportFinset) :
    coordinateIdempotent coordinate • element = 0 := by
  simpa [smul_smul, coordinateIdempotent_mul_complementIdempotent, hn] using
    congrArg (fun sectionValue : moduleType => coordinateIdempotent coordinate • sectionValue) hm

private theorem eq_sum_coordinateIdempotent_smul {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    {supportFinset : Finset ℕ} {element : moduleType}
    (hm : complementIdempotent supportFinset • element = 0) :
    element = ∑ coordinate ∈ supportFinset, coordinateIdempotent coordinate • element := by
  simpa [add_smul, Finset.sum_smul, hm] using
    (congrArg (fun denominator : SequenceRing => denominator • element)
      (complementIdempotent_add_sum_coordinateIdempotent supportFinset)).symm

private theorem complementIdempotent_smul_sum_coordinateIdempotent_smul {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (supportFinset : Finset ℕ) (element : ℕ → moduleType) :
    complementIdempotent supportFinset •
      ∑ coordinate ∈ supportFinset, coordinateIdempotent coordinate • element coordinate = 0 := by
  classical
  rw [Finset.smul_sum]
  refine Finset.sum_eq_zero fun coordinate hn => ?_
  rw [smul_smul, mul_comm, coordinateIdempotent_mul_complementIdempotent, ite_eq_left hn, zero_smul]

private theorem coordinateIdempotent_smul_sum_coordinateIdempotent_smul {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (supportFinset : Finset ℕ) (element : ℕ → moduleType) (otherCoordinate : ℕ) :
    coordinateIdempotent otherCoordinate •
        ∑ coordinate ∈ supportFinset, coordinateIdempotent coordinate • element coordinate =
      if otherCoordinate ∈ supportFinset then
        coordinateIdempotent otherCoordinate • element otherCoordinate else 0 := by
  classical
  simp only [Finset.smul_sum, smul_smul, coordinateIdempotent_mul, ite_smul, zero_smul]
  simp_rw [eq_comm (a := otherCoordinate)]
  rw [Finset.sum_ite_eq']

private theorem complementIdempotent_smul_eq_zero_of_eq_sum {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    {supportFinset : Finset ℕ} {element : moduleType}
    (hm : element = ∑ coordinate ∈ supportFinset, coordinateIdempotent coordinate • element) :
    complementIdempotent supportFinset • element = 0 := by
  rw [hm]
  exact complementIdempotent_smul_sum_coordinateIdempotent_smul supportFinset fun _ => element

private theorem complementIdempotent_filter_smul_eq_zero {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    {supportFinset : Finset ℕ} {element : moduleType}
    (hm : complementIdempotent supportFinset • element = 0)
    (subset : Set ℕ) [DecidablePred (fun coordinate => coordinate ∈ subset)]
    (hs : ∀ coordinate, coordinate ∉ subset → coordinateIdempotent coordinate • element = 0) :
    complementIdempotent (supportFinset.filter (fun coordinate => coordinate ∈ subset)) •
      element = 0 := by
  classical
  refine complementIdempotent_smul_eq_zero_of_eq_sum
    ((eq_sum_coordinateIdempotent_smul hm).trans ?_)
  exact (Finset.sum_subset (Finset.filter_subset _ _) fun coordinate hn hnfilter =>
    hs coordinate (by simpa [hn] using hnfilter)).symm

private theorem complementIdempotent_union_smul_sub_eq_zero {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    {supportFinset otherSupportFinset : Finset ℕ} {element coordinate : moduleType}
    (hm : complementIdempotent supportFinset • element = 0)
    (hn : complementIdempotent otherSupportFinset • coordinate = 0) :
    complementIdempotent (supportFinset ∪ otherSupportFinset) • (element - coordinate) = 0 := by
  rw [smul_sub, complementIdempotent_union, mul_smul, mul_smul, hn, smul_zero,
    smul_comm, hm, smul_zero, sub_zero]

private noncomputable def cofiniteUltrafilter : Ultrafilter ℕ := Ultrafilter.of Filter.cofinite

private abbrev DescentIndex := ULift.{v} {subset : Set ℕ // subset ∈ cofiniteUltrafilter}

private noncomputable def complementSingletonIndex (coordinate : ℕ) : DescentIndex.{v} :=
  ⟨⟨{coordinate}ᶜ, (Ultrafilter.of_le Filter.cofinite) (by simp)⟩⟩

private noncomputable def universalIndex : DescentIndex.{v} := ⟨⟨Set.univ, Filter.univ_mem⟩⟩

private theorem finite_of_finite_inter_compl_mem_ultrafilter {supportSet : Set ℕ}
    (hT : ∀ subset : Set ℕ, subset ∈ cofiniteUltrafilter →
      (supportSet ∩ subsetᶜ).Finite) : supportSet.Finite := by
  obtain hTfin | hTinf := Set.finite_or_infinite supportSet
  · exact hTfin
  obtain ⟨leftSupport, rightSupport, hUnion, hDisjoint, hCard⟩ :=
    Set.Infinite.exists_union_disjoint_cardinal_eq_of_infinite hTinf
  have hiff : leftSupport.Finite ↔ rightSupport.Finite := by
    rw [← Cardinal.lt_aleph0_iff_set_finite, ← Cardinal.lt_aleph0_iff_set_finite, hCard]
  have hT₁inf : leftSupport.Infinite := by
    by_contra h
    exact hTinf (hUnion ▸ (Set.not_infinite.mp h).union (hiff.mp (Set.not_infinite.mp h)))
  have hT₂inf : rightSupport.Infinite := Set.not_finite.mp (fun h => hT₁inf (hiff.mpr h))
  have hT₁sub : leftSupport ⊆ supportSet := hUnion ▸ Set.subset_union_left
  have hT₂sub : rightSupport ⊆ supportSet := hUnion ▸ Set.subset_union_right
  have key : ∀ part : Set ℕ, part ⊆ supportSet → part.Infinite → partᶜ ∈ cofiniteUltrafilter →
      False := fun part hsub hinf hc =>
    hinf ((hT partᶜ hc).subset fun coordinate hn => ⟨hsub hn, by simpa using hn⟩)
  rcases cofiniteUltrafilter.mem_or_compl_mem leftSupport with hT₁U | hT₁cU
  · exact (key rightSupport hT₂sub hT₂inf (by
    filter_upwards [hT₁U] with coordinate hcoordinate
    exact Set.disjoint_left.mp hDisjoint hcoordinate)).elim
  · exact (key leftSupport hT₁sub hT₁inf hT₁cU).elim

private theorem coordinateIdempotent_smul_eq_of_compatible {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (element : DescentIndex.{v} → moduleType)
    (hm : ∀ index otherIndex,
      localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element index) =
        localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element otherIndex))
    (index otherIndex : DescentIndex.{v}) (coordinate : ℕ)
    (hi : coordinate ∉ index.down.1) (hj : coordinate ∉ otherIndex.down.1) :
    coordinateIdempotent coordinate • element index =
      coordinateIdempotent coordinate • element otherIndex := by
  obtain ⟨supportFinset, hF, equality⟩ :=
    (localizationTensorMap_eq_iff _ _ _).mp (hm index otherIndex)
  have hn : coordinate ∉ supportFinset := fun hn => (hF hn).elim hi hj
  apply sub_eq_zero.mp
  simpa [smul_sub] using coordinateIdempotent_smul_eq_zero_of_complementIdempotent equality hn

private theorem coordinateIdempotent_smul_sub_universalIndex_eq {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (element : DescentIndex.{v} → moduleType)
    (hm : ∀ index otherIndex,
      localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element index) =
        localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element otherIndex))
    (index : DescentIndex.{v}) (coordinate : ℕ) (hn : coordinate ∉ index.down.1) :
    coordinateIdempotent coordinate •
        (element (complementSingletonIndex coordinate) - element universalIndex) =
      coordinateIdempotent coordinate • (element index - element universalIndex) := by
  simp only [smul_sub]
  rw [coordinateIdempotent_smul_eq_of_compatible element hm
    (complementSingletonIndex coordinate) index coordinate
    (by simp [complementSingletonIndex]) hn]

private theorem finite_setOf_coordinateIdempotent_smul_sub_ne_zero {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (element : DescentIndex.{v} → moduleType)
    (hm : ∀ index otherIndex,
      localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element index) =
        localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element otherIndex)) :
    {coordinate | coordinateIdempotent coordinate •
      (element (complementSingletonIndex coordinate) - element universalIndex) ≠ 0}.Finite := by
  apply finite_of_finite_inter_compl_mem_ultrafilter
  intro subset hs
  obtain ⟨supportFinset, -, hF⟩ :=
    (localizationTensorMap_eq_iff _ _ _).mp (hm ⟨⟨subset, hs⟩⟩ universalIndex)
  refine supportFinset.finite_toSet.subset fun coordinate ⟨hn, hns⟩ =>
    Classical.byContradiction fun hnF => hn ?_
  rw [coordinateIdempotent_smul_sub_universalIndex_eq element hm ⟨⟨subset, hs⟩⟩ coordinate hns]
  exact coordinateIdempotent_smul_eq_zero_of_complementIdempotent hF hnF

private theorem exists_gluing_of_compatible_representatives {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    (element : DescentIndex.{v} → moduleType)
    (hm : ∀ index otherIndex,
      localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element index) =
        localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element otherIndex)) :
    ∃ sectionValue : moduleType, ∀ index,
      localizationTensorMap index.down.1 sectionValue =
        localizationTensorMap index.down.1 (element index) := by
  classical
  let gap : ℕ → moduleType := fun coordinate =>
    element (complementSingletonIndex coordinate) - element universalIndex
  let difference : ℕ → moduleType := fun coordinate =>
    coordinateIdempotent coordinate • gap coordinate
  have hd : ∀ index coordinate, coordinate ∉ index.down.1 →
      difference coordinate =
        coordinateIdempotent coordinate • (element index - element universalIndex) :=
    coordinateIdempotent_smul_sub_universalIndex_eq element hm
  have hT : {coordinate | difference coordinate ≠ 0}.Finite :=
    finite_setOf_coordinateIdempotent_smul_sub_ne_zero element hm
  let supportSet := hT.toFinset
  let correction : moduleType := ∑ coordinate ∈ supportSet, difference coordinate
  have hpoint : ∀ otherCoordinate,
      coordinateIdempotent otherCoordinate • correction = difference otherCoordinate := by
    intro otherCoordinate
    refine (coordinateIdempotent_smul_sum_coordinateIdempotent_smul supportSet gap
      otherCoordinate).trans ?_
    split_ifs with hk
    · rfl
    · exact (not_not.mp fun h => hk (hT.mem_toFinset.mpr h)).symm
  have hcorrection : complementIdempotent supportSet • correction = 0 :=
    complementIdempotent_smul_sum_coordinateIdempotent_smul supportSet gap
  refine ⟨element universalIndex + correction, fun index => ?_⟩
  obtain ⟨supportFinset, -, hF⟩ :=
    (localizationTensorMap_eq_iff _ _ _).mp (hm index universalIndex)
  have hfinite : complementIdempotent (supportSet ∪ supportFinset) •
      ((element universalIndex + correction) - element index) = 0 := by
    convert complementIdempotent_union_smul_sub_eq_zero hcorrection hF using 1
    abel_nf
  refine (localizationTensorMap_eq_iff _ _ _).mpr
    ⟨(supportSet ∪ supportFinset).filter (fun coordinate => coordinate ∈ index.down.1),
      fun coordinate hn => (Finset.mem_filter.mp hn).2, ?_⟩
  apply complementIdempotent_filter_smul_eq_zero hfinite
  intro coordinate hn
  simp only [smul_sub, smul_add]
  rw [hpoint, hd index coordinate hn, smul_sub]
  abel

private theorem eq_of_localizationTensorMap_eq {moduleType : Type*}
    [AddCommGroup moduleType] [Module SequenceRing.{u} moduleType]
    {element coordinate : moduleType} (equality : ∀ index : DescentIndex.{v},
      localizationTensorMap index.down.1 element = localizationTensorMap index.down.1 coordinate) :
    element = coordinate := by
  obtain ⟨supportFinset, -, hf⟩ :=
    (localizationTensorMap_eq_iff _ _ _).mp (equality universalIndex)
  have hz : ∀ otherCoordinate,
      coordinateIdempotent otherCoordinate • (element - coordinate) = 0 := by
    intro otherCoordinate
    obtain ⟨otherSupportFinset, hG, hg⟩ := (localizationTensorMap_eq_iff _ _ _).mp
      (equality (complementSingletonIndex otherCoordinate))
    exact coordinateIdempotent_smul_eq_zero_of_complementIdempotent hg fun hk => hG hk (by simp)
  apply sub_eq_zero.mp
  rw [eq_sum_coordinateIdempotent_smul hf]
  simp [hz]

private theorem descentIndex_infinite : Infinite DescentIndex.{v} := by
  apply Infinite.of_injective complementSingletonIndex.{v}
  intro element coordinate equality
  have hs : ({element}ᶜ : Set ℕ) = {coordinate}ᶜ :=
    congrArg (fun index : DescentIndex.{v} => index.down.1) equality
  exact Set.singleton_injective (compl_injective hs)

private theorem exists_mem_of_finite_subfamily (J : Set DescentIndex.{v}) (hJ : J.Finite) :
    ∃ coordinate : ℕ, ∀ index ∈ J, coordinate ∈ index.down.1 := by
  classical
  have hinter : {coordinate : ℕ | ∀ index ∈ hJ.toFinset, coordinate ∈ index.down.1} ∈
      cofiniteUltrafilter := by
    change ∀ᶠ coordinate in cofiniteUltrafilter, ∀ index ∈ hJ.toFinset, coordinate ∈ index.down.1
    induction hJ.toFinset using Finset.induction_on with
    | empty => simp
    | @insert index J hi ih =>
      filter_upwards [index.down.2, ih] with coordinate hn hJ
      intro otherIndex hj
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact hn
      · exact hJ otherIndex hj
  obtain ⟨coordinate, hn⟩ := Filter.nonempty_of_mem hinter
  exact ⟨coordinate, fun index hi => hn index (hJ.mem_toFinset.mpr hi)⟩

private noncomputable def descentAlgebras :
    DescentIndex.{v} → CommAlgCat.{u} (CommRingCat.of SequenceRing.{u}) :=
  fun index => CommAlgCat.of SequenceRing (MaskLocalization index.down.1)

private theorem descentAlgebras_flat (index : DescentIndex.{v}) :
    Module.Flat (CommRingCat.of SequenceRing.{u}) (descentAlgebras index) := by
  change Module.Flat SequenceRing (MaskLocalization index.down.1)
  exact IsLocalization.flat _ (maskDenominators index.down.1)

/-- The canonical map from each module to the compatible families of its base changes along a
subfamily of algebras is bijective. -/
public def IsModuleDescentEqualizer {I : Type v} (A : CommRingCat.{u})
    (B : I → CommAlgCat.{u} A) (J : Set I) : Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module A M],
    ∀ (s : ∀ i : J, M ⊗[A] (B i.1)),
      (∀ i j : J,
        (TensorProduct.map (LinearMap.id : M →ₗ[A] M)
          (Algebra.TensorProduct.includeLeft (R := A) (A := B i.1)
            (B := B j.1)).toLinearMap (s i) :
              M ⊗[A] (B i.1 ⊗[A] B j.1)) =
        (TensorProduct.map (LinearMap.id : M →ₗ[A] M)
          (Algebra.TensorProduct.includeRight (R := A) (A := B i.1)
            (B := B j.1)).toLinearMap (s j) :
              M ⊗[A] (B i.1 ⊗[A] B j.1))) →
      ∃! m : M, ∀ i : J, TensorProduct.tmul A m (1 : B i.1) = s i

private theorem descentAlgebras_moduleDescentEqualizer :
    IsModuleDescentEqualizer (CommRingCat.of SequenceRing.{u})
      descentAlgebras.{u, v} Set.univ := by
  classical
  intro moduleType _ _ subset hs
  have hrep : ∀ index : DescentIndex.{v}, ∃ element : moduleType,
      localizationTensorMap index.down.1 element = subset ⟨index, Set.mem_univ index⟩ :=
    fun index => localizationTensorMap_surjective index.down.1 _
  choose element hm using hrep
  have hcompat : ∀ index otherIndex,
      localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element index) =
        localizationTensorMap (index.down.1 ∪ otherIndex.down.1) (element otherIndex) := by
    intro index otherIndex
    apply localizationTensorMap_union_eq
    rw [hm index, hm otherIndex]
    exact hs ⟨index, Set.mem_univ index⟩ ⟨otherIndex, Set.mem_univ otherIndex⟩
  obtain ⟨sectionValue, hx⟩ := exists_gluing_of_compatible_representatives element hcompat
  refine ⟨sectionValue, fun index =>
    (localizationTensorMap_apply _ _).symm.trans ((hx index.1).trans (hm index.1)), ?_⟩
  intro otherSectionValue hy
  apply eq_of_localizationTensorMap_eq
  intro index
  have hyi : localizationTensorMap index.down.1 otherSectionValue =
      subset ⟨index, Set.mem_univ index⟩ := hy ⟨index, Set.mem_univ index⟩
  exact hyi.trans ((hx index).trans (hm index)).symm

private theorem not_moduleDescentEqualizer_of_finite (J : Set DescentIndex.{v}) (hJ : J.Finite) :
    ¬ IsModuleDescentEqualizer (CommRingCat.of SequenceRing.{u}) descentAlgebras J := by
  classical
  obtain ⟨coordinate, hn⟩ := exists_mem_of_finite_subfamily J hJ
  intro hdescent
  let subset : ∀ index : J,
    SequenceRing ⊗[SequenceRing] MaskLocalization index.1.down.1 := fun _ => 0
  have hs : ∀ index otherIndex : J,
      TensorProduct.map (LinearMap.id : SequenceRing →ₗ[SequenceRing] SequenceRing)
        (Algebra.TensorProduct.includeLeft (R := SequenceRing)
          (A := MaskLocalization index.1.down.1)
          (B := MaskLocalization otherIndex.1.down.1)).toLinearMap (subset index) =
      TensorProduct.map (LinearMap.id : SequenceRing →ₗ[SequenceRing] SequenceRing)
        (Algebra.TensorProduct.includeRight (R := SequenceRing)
          (A := MaskLocalization index.1.down.1)
          (B := MaskLocalization otherIndex.1.down.1)).toLinearMap (subset otherIndex) :=
    fun _ _ => (TensorProduct.map _ _).map_zero.trans (TensorProduct.map _ _).map_zero.symm
  obtain ⟨element, hm, hu⟩ := hdescent SequenceRing subset hs
  have hp : ∀ index : J,
      coordinateIdempotent coordinate ⊗ₜ[SequenceRing]
        (1 : MaskLocalization index.1.down.1) = subset index := by
    intro index
    change coordinateIdempotent coordinate ⊗ₜ[SequenceRing]
      (1 : MaskLocalization index.1.down.1) = 0
    rw [← localizationTensorMap_apply,
      ← (localizationTensorMap (moduleType := SequenceRing) index.1.down.1).map_zero]
    apply (localizationTensorMap_eq_iff _ _ _).mpr
    refine ⟨{coordinate}, ?_, ?_⟩
    · simpa using hn index.1 index.2
    · rw [sub_zero, smul_eq_mul, mul_comm, coordinateIdempotent_mul_complementIdempotent]
      simp
  have hzero : ∀ index : J,
      (0 : SequenceRing) ⊗ₜ[SequenceRing]
        (1 : MaskLocalization index.1.down.1) = subset index :=
    fun _ => by simp [subset]
  have equality : coordinateIdempotent coordinate = (0 : SequenceRing) :=
    (hu _ hp).trans (hu _ hzero).symm
  simpa [coordinateIdempotent] using congrFun equality coordinate

/-- An infinite family of flat algebra maps satisfies module descent, but no finite subfamily
satisfies it. -/
@[stacks 0EUF]
public theorem exists_infinite_flat_family_moduleDescentEqualizer :
    ∃ (A : CommRingCat.{u}) (I : Type v) (_ : Infinite I)
      (B : I → CommAlgCat.{u} A),
      (∀ i, Module.Flat A (B i)) ∧
        IsModuleDescentEqualizer A B Set.univ ∧
          (∀ J : Set I, J.Finite → ¬ IsModuleDescentEqualizer A B J) :=
  ⟨CommRingCat.of SequenceRing, DescentIndex, descentIndex_infinite, descentAlgebras,
    descentAlgebras_flat, descentAlgebras_moduleDescentEqualizer,
    not_moduleDescentEqualizer_of_finite⟩

end Stacks.Examples

end
