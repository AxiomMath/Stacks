module

public import Mathlib
public import StacksFrontier.Algebra.Category.ModuleCat.ExtendScalarsBaseRing
public import StacksFrontier.Algebra.Homology.Embedding.ExtendMap
public import StacksFrontier.Algebra.Homology.PseudoCoherent
public import StacksFrontier.Homology.Tor.DerivedExtensionScalars

/-!
# The staircase complex

Let `R` be a commutative ring and `c : ℕ → R` a sequence. The *staircase complex* is the cochain
complex of `R`-modules with `R` in every degree `j ≤ 0` and `0` in every degree `j > 0`, whose
differential `X (-2 * i - 1) ⟶ X (-2 * i)` is multiplication by `c i` and whose other
differentials vanish. It is the direct sum over `i` of the two-term complexes `R --c i--> R` placed
in degrees `-2 * i - 1` and `-2 * i`, so its cohomology is `R ⧸ (c i)` in degree `-2 * i` and the
annihilator of `c i` in degree `-2 * i - 1`.

The file also proves a bound on the annihilators of the cohomology of a derived base change along a
surjection `f : R →+* R'` whose kernel is generated by a nonzerodivisor `w`: if `a` kills `H^k(M)`
and `H^(k+1)(M)` for a pseudo-coherent `M`, then `f (a ^ 2)` kills `H^k(M ⊗ᴸ_R R')`. This rests on
the short exact sequence `0 ⟶ G --w--> G ⟶ R' ⊗_R G ⟶ 0` of complexes, valid for a complex `G`
of free modules.

## Main definitions

* `Stacks.Examples.StaircaseComplex.staircaseChain`: the staircase as a chain complex indexed by
  `ℕ`.
* `Stacks.Examples.StaircaseComplex.staircase`: the staircase complex, its extension to a cochain
  complex indexed by `ℤ`.
* `Stacks.Examples.StaircaseComplex.mapStaircaseIso`: termwise extension of scalars along
  `f : R →+* R'` carries the staircase complex for `c` to the one for `f ∘ c`.
* `Stacks.Examples.StaircaseComplex.extendScalarsQStaircaseIso`: the same for any total derived
  extension of scalars.

## Main results

* `Stacks.Examples.StaircaseComplex.isPseudoCoherent_Q_staircase`: the staircase complex is
  pseudo-coherent.
* `Stacks.Examples.StaircaseComplex.smul_eq_zero_homologyFunctor_Q_staircase`: an element of every
  ideal `(c i)` kills all of its cohomology.
* `Stacks.Examples.StaircaseComplex.exists_homologyFunctor_Q_staircase`: `H^{-2i}` contains an
  element whose annihilator is contained in `(c i)`.
* `Stacks.Examples.StaircaseComplex.smul_sq_homologyFunctor_eq_zero`: the annihilator bound for a
  derived base change along a surjection with principal kernel generated by a nonzerodivisor.
* `Stacks.Examples.StaircaseComplex.eq_zero_of_eval_pow_succ_eq_zero`: a polynomial over a domain
  vanishing at infinitely many distinct powers of an element is zero.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u w wR wA

namespace Stacks.Examples.StaircaseComplex

open StacksDraft.PseudoCoherence CochainComplex.DerivedExtensionScalars
open scoped ChangeOfRings TensorProduct

section Construction

variable (R : Type u) [CommRing R] (c : ℕ → R)

/-- The coefficient of the differential `X (n + 1) ⟶ X n` of the `ℕ`-indexed staircase: `c i` when
`n = 2 * i`, and `0` when `n` is odd. -/
def coeff (n : ℕ) : R := if Even n then c (n / 2) else 0

@[simp]
lemma coeff_two_mul (i : ℕ) : coeff R c (2 * i) = c i := by
  simp [coeff]

@[simp]
lemma coeff_two_mul_add_one (i : ℕ) : coeff R c (2 * i + 1) = 0 := by
  simp [coeff]

@[simp]
lemma coeff_zero : coeff R c 0 = c 0 := by
  simp [coeff]

lemma coeff_succ_mul_coeff (n : ℕ) : coeff R c (n + 1) * coeff R c n = 0 := by
  obtain ⟨i, rfl | rfl⟩ := Nat.even_or_odd' n
  · simp
  · simp [show 2 * i + 1 + 1 = 2 * (i + 1) by ring]

/-- The differential `X (n + 1) ⟶ X n` of the `ℕ`-indexed staircase, multiplication by
`coeff R c n`. -/
def chainDiff (n : ℕ) : ModuleCat.of R R ⟶ ModuleCat.of R R :=
  ModuleCat.ofHom (LinearMap.mulLeft R (coeff R c n))

/-- The staircase as a chain complex indexed by `ℕ`: `R` in every degree, with differential
`X (2 * i + 1) ⟶ X (2 * i)` multiplication by `c i` and all other differentials zero. -/
abbrev staircaseChain : ChainComplex (ModuleCat.{u} R) ℕ where
  X _ := ModuleCat.of R R
  d i j := if i = j + 1 then chainDiff R c j else 0
  shape i j h := ite_eq_right (by simpa [eq_comm] using h)
  d_comp_d' i j k hij hjk := by
    obtain rfl : i = j + 1 := hij.symm
    obtain rfl : j = k + 1 := hjk.symm
    rw [ite_eq_left rfl, ite_eq_left rfl]
    ext
    simp [chainDiff, mul_comm (coeff R c k), coeff_succ_mul_coeff]

/-- **The staircase complex.** The cochain complex with `R` in every degree `j ≤ 0` and `0` in
every degree `j > 0`, whose differential `X (-2 * i - 1) ⟶ X (-2 * i)` is multiplication by `c i`
and whose other differentials vanish. It is the direct sum over `i` of the two-term complexes
`R --c i--> R` placed in degrees `-2 * i - 1` and `-2 * i`. -/
def staircase : CochainComplex (ModuleCat.{u} R) ℤ :=
  (staircaseChain R c).extend ComplexShape.embeddingDownNat

lemma chainDiff_apply (n : ℕ) (x : R) : (chainDiff R c n).hom x = coeff R c n * x := rfl

lemma staircaseChain_d_succ (n : ℕ) : (staircaseChain R c).d (n + 1) n = chainDiff R c n :=
  ite_eq_left rfl

instance (n : ℕ) : Projective ((staircaseChain R c).X n) :=
  inferInstanceAs (Projective (ModuleCat.of R R))

instance (n : ℕ) : Module.Finite R ((staircaseChain R c).X n) :=
  inferInstanceAs (Module.Finite R R)

instance (n : ℕ) : Module.Free R ((staircaseChain R c).X n) :=
  inferInstanceAs (Module.Free R R)

instance : (staircase R c).IsStrictlyLE 0 :=
  inferInstanceAs
    (CochainComplex.IsStrictlyLE ((staircaseChain R c).extend ComplexShape.embeddingDownNat) 0)

instance (j : ℤ) : Projective ((staircase R c).X j) :=
  inferInstanceAs (Projective (((staircaseChain R c).extend ComplexShape.embeddingDownNat).X j))

/-- Every term of the staircase complex is a finite free `R`-module. -/
theorem finite_free_staircase_X (j : ℤ) :
    Module.Finite R ((staircase R c).X j) ∧ Module.Free R ((staircase R c).X j) := by
  by_cases h : ∃ n, ComplexShape.embeddingDownNat.f n = j
  · obtain ⟨n, hn⟩ := h
    let e := ((staircaseChain R c).extendXIso ComplexShape.embeddingDownNat hn).toLinearEquiv
    exact ⟨Module.Finite.equiv e.symm, Module.Free.of_equiv e.symm⟩
  · have : Subsingleton ((staircase R c).X j) := ModuleCat.isZero_iff_subsingleton.mp
      ((staircaseChain R c).isZero_extend_X ComplexShape.embeddingDownNat j
        (fun n hn => h ⟨n, hn⟩))
    exact ⟨Module.Finite.of_finite, Module.Free.of_subsingleton R _⟩

instance (j : ℤ) : Module.Finite R ((staircase R c).X j) := (finite_free_staircase_X R c j).1

instance (j : ℤ) : Module.Free R ((staircase R c).X j) := (finite_free_staircase_X R c j).2

/-- The staircase complex is a bounded-above complex of finite free `R`-modules. -/
theorem isBoundedAboveFiniteFree_staircase : IsBoundedAboveFiniteFree (staircase R c) :=
  ⟨⟨0, inferInstance⟩, fun _ => ⟨inferInstance, inferInstance⟩⟩

/-- The staircase complex is pseudo-coherent in `D(R)`. -/
theorem isPseudoCoherent_Q_staircase [HasDerivedCategory.{w} (ModuleCat.{u} R)] :
    IsPseudoCoherent (DerivedCategory.Q.obj (staircase R c)) :=
  ⟨_, isBoundedAboveFiniteFree_staircase R c, ⟨Iso.refl _⟩⟩

end Construction

section BaseChange

variable {R R' : Type u} [CommRing R] [CommRing R'] (c : ℕ → R) (f : R →+* R')

lemma coeff_map (n : ℕ) : coeff R' (fun i => f (c i)) n = f (coeff R c n) := by
  unfold coeff
  split_ifs <;> simp

lemma objSelfIso_hom_comp_ofHom_mulLeft (a : R) :
    (ModuleCat.ExtendScalars.objSelfIso f).hom ≫ ModuleCat.ofHom (LinearMap.mulLeft R' (f a)) =
      (ModuleCat.extendScalars.{u, u, u} f).map (ModuleCat.ofHom (LinearMap.mulLeft R a)) ≫
        (ModuleCat.ExtendScalars.objSelfIso f).hom := by
  apply ModuleCat.ExtendScalars.hom_ext_one_tmul
  intro m
  change f a * (ModuleCat.ExtendScalars.objSelfIso f).hom ((1 : R') ⊗ₜ[R,f] m) =
    (ModuleCat.ExtendScalars.objSelfIso f).hom
      ((ModuleCat.extendScalars f).map (ModuleCat.ofHom (LinearMap.mulLeft R a))
        ((1 : R') ⊗ₜ[R,f] m))
  rw [ModuleCat.ExtendScalars.map_tmul, ModuleCat.ExtendScalars.objSelfIso_hom_tmul]
  refine Eq.trans ?_ (ModuleCat.ExtendScalars.objSelfIso_hom_tmul f 1 (a * m)).symm
  rw [map_mul]
  ring

/-- Termwise extension of scalars carries the `ℕ`-indexed staircase over `R` to the one over `R'`
with the image coefficients. -/
def mapStaircaseChainIso :
    ((ModuleCat.extendScalars.{u, u, u} f).mapHomologicalComplex _).obj (staircaseChain R c) ≅
      staircaseChain R' (fun i => f (c i)) :=
  HomologicalComplex.Hom.isoOfComponents (fun _ => ModuleCat.ExtendScalars.objSelfIso f) (by
    rintro i j (rfl : j + 1 = i)
    rw [Functor.mapHomologicalComplex_obj_d, staircaseChain_d_succ, staircaseChain_d_succ]
    simp only [chainDiff, coeff_map]
    exact objSelfIso_hom_comp_ofHom_mulLeft f _)

/-- Termwise extension of scalars carries the staircase complex over `R` to the staircase complex
over `R'` with the image coefficients. -/
def mapStaircaseIso :
    ((ModuleCat.extendScalars.{u, u, u} f).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (staircase R c) ≅ staircase R' (fun i => f (c i)) :=
  (HomologicalComplex.mapHomologicalComplexExtendIso _ _ _).symm ≪≫
    (ComplexShape.embeddingDownNat.extendFunctor _).mapIso (mapStaircaseChainIso c f)

/-- **Derived base change of the staircase complex.** Any total derived extension of scalars along
`f` carries the staircase complex over `R` to the staircase complex over `R'` with the image
coefficients. -/
def extendScalarsQStaircaseIso [HasDerivedCategory.{wR} (ModuleCat.{u} R)]
    [HasDerivedCategory.{wA} (ModuleCat.{u} R')]
    (L : TotalDerivedExtensionScalars.{u, u, u, wR, wA} f) :
    L.functor.obj (DerivedCategory.Q.obj (staircase R c)) ≅
      DerivedCategory.Q.obj (staircase R' (fun i => f (c i))) :=
  haveI := L.comparison_isIso_of_projective (staircase R c) 0
  asIso (L.comparison.app (staircase R c)) ≪≫ DerivedCategory.Q.mapIso (mapStaircaseIso c f)

end BaseChange

section Annihilator

/-- An element killing every element of a module kills every element of an isomorphic module. -/
theorem smul_eq_zero_of_iso {S : Type*} [Ring S] {M N : ModuleCat.{u} S} (e : M ≅ N) {r : S}
    (h : ∀ y : N, r • y = 0) (x : M) : r • x = 0 :=
  e.toLinearEquiv.injective (by rw [map_smul, map_zero]; exact h _)

end Annihilator

section Homology

variable (R : Type u) [CommRing R] (c : ℕ → R)

/-- The differential of the `ℕ`-indexed staircase leaving an even degree vanishes. -/
lemma staircaseChain_d_two_mul (k j : ℕ) : (staircaseChain R c).d (2 * k) j = 0 := by
  by_cases h : j + 1 = 2 * k
  · obtain ⟨m, rfl⟩ : ∃ m, j = 2 * m + 1 := ⟨k - 1, by omega⟩
    rw [← h, staircaseChain_d_succ]
    change ModuleCat.ofHom (LinearMap.mulLeft R (coeff R c (2 * m + 1))) = 0
    rw [coeff_two_mul_add_one]
    ext
    simp
  · exact (staircaseChain R c).shape _ _ (by simpa using h)

/-- If `a = r i * c i` for every `i`, multiplication by `a` on the `ℕ`-indexed staircase is
null-homotopic, by the homotopy `X (2 * i) ⟶ X (2 * i + 1)` given by multiplication by `r i`. -/
def smulHomotopy (a : R) (r : ℕ → R) (hr : ∀ i, r i * c i = a) :
    Homotopy (a • 𝟙 (staircaseChain R c)) 0 where
  hom i j := ModuleCat.ofHom (LinearMap.mulLeft R (if i + 1 = j then coeff R r i else 0))
  zero i j h := by
    rw [ite_eq_right (by simpa using h)]
    ext
    simp
  comm i := by
    have key : ∀ n, coeff R r n * coeff R c n + coeff R c (n + 1) * coeff R r (n + 1) = a := by
      intro n
      obtain ⟨k, rfl | rfl⟩ := Nat.even_or_odd' n
      · simp [hr]
      · rw [show 2 * k + 1 + 1 = 2 * (k + 1) by ring]
        simp [hr, mul_comm (c (k + 1))]
    rw [Homotopy.prevD_chainComplex]
    cases i with
    | zero =>
      rw [Homotopy.dNext_zero_chainComplex, staircaseChain_d_succ]
      refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
      change a • x = 0 + coeff R c 0 * ((if 0 + 1 = 0 + 1 then coeff R r 0 else 0) * x) + 0
      rw [ite_eq_left rfl, coeff_zero, coeff_zero, ← hr 0, smul_eq_mul]
      ring
    | succ n =>
      rw [Homotopy.dNext_succ_chainComplex, staircaseChain_d_succ, staircaseChain_d_succ]
      refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
      change a • x = (if n + 1 = n + 1 then coeff R r n else 0) * (coeff R c n * x) +
        coeff R c (n + 1) * ((if n + 1 + 1 = n + 1 + 1 then coeff R r (n + 1) else 0) * x) + 0
      rw [ite_eq_left rfl, ite_eq_left rfl, smul_eq_mul, ← key n]
      ring

/-- Multiplication by an element of every ideal `(c i)` kills the homology of the `ℕ`-indexed
staircase. -/
theorem smul_eq_zero_homology_staircaseChain (a : R) (ha : ∀ i, a ∈ Ideal.span {c i}) (n : ℕ)
    (x : (staircaseChain R c).homology n) : a • x = 0 := by
  choose r hr using fun i => Ideal.mem_span_singleton'.mp (ha i)
  have h := (smulHomotopy R c a r hr).homologyMap_eq n
  rw [HomologicalComplex.homologyMap_zero] at h
  have h2 : HomologicalComplex.homologyMap (a • 𝟙 (staircaseChain R c)) n = a • 𝟙 _ := by
    change ShortComplex.homologyMap _ = _
    rw [show (HomologicalComplex.shortComplexFunctor _ _ n).map (a • 𝟙 (staircaseChain R c)) =
      a • 𝟙 _ by rfl, ShortComplex.homologyMap_smul, ShortComplex.homologyMap_id]
    rfl
  exact congrArg (fun φ => φ.hom x) (h2.symm.trans h)

/-- Multiplication by an element of every ideal `(c i)` kills the homology of the staircase
complex. -/
theorem smul_eq_zero_homology_staircase (a : R) (ha : ∀ i, a ∈ Ideal.span {c i}) (j : ℤ)
    (x : (staircase R c).homology j) : a • x = 0 := by
  by_cases hj : ∃ n, ComplexShape.embeddingDownNat.f n = j
  · obtain ⟨n, hn⟩ := hj
    exact smul_eq_zero_of_iso
      ((staircaseChain R c).extendHomologyIso ComplexShape.embeddingDownNat hn)
      (smul_eq_zero_homology_staircaseChain R c a ha n) x
  · have : IsZero ((staircase R c).homology j) :=
      ShortComplex.isZero_homology_of_isZero_X₂ _
        ((staircaseChain R c).isZero_extend_X _ j (fun n hn => hj ⟨n, hn⟩))
    exact (ModuleCat.isZero_iff_subsingleton.mp this).elim _ _

/-- **Killing.** An element of every ideal `(c i)` kills every cohomology module of the staircase
complex in `D(R)`. -/
theorem smul_eq_zero_homologyFunctor_Q_staircase [HasDerivedCategory.{w} (ModuleCat.{u} R)]
    (a : R) (ha : ∀ i, a ∈ Ideal.span {c i}) (j : ℤ)
    (s : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) j).obj
      (DerivedCategory.Q.obj (staircase R c))) : a • s = 0 :=
  smul_eq_zero_of_iso ((DerivedCategory.homologyFunctorFactors (ModuleCat.{u} R) j).app _)
    (smul_eq_zero_homology_staircase R c a ha j) s

/-- The quotient map `X (2 * i) = R ⟶ R ⧸ (c i)`. -/
def quotientMap (i : ℕ) : ModuleCat.of R R ⟶ ModuleCat.of R (R ⧸ Ideal.span {c i}) :=
  ModuleCat.ofHom (Ideal.span {c i}).mkQ

lemma d_comp_quotientMap (j i : ℕ) : (staircaseChain R c).d j (2 * i) ≫ quotientMap R c i = 0 := by
  by_cases h : 2 * i + 1 = j
  · subst h
    rw [staircaseChain_d_succ]
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    change Submodule.Quotient.mk (coeff R c (2 * i) * x) = 0
    rw [coeff_two_mul, Submodule.Quotient.mk_eq_zero]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rw [(staircaseChain R c).shape _ _ (by simpa using h), zero_comp]

/-- The class of `1` in `H_{2 i}` of the `ℕ`-indexed staircase has annihilator inside `(c i)`. -/
theorem exists_homology_staircaseChain (i : ℕ) :
    ∃ t : (staircaseChain R c).homology (2 * i), ∀ r : R, r • t = 0 → r ∈ Ideal.span {c i} := by
  let K := staircaseChain R c
  let z := K.liftCycles (𝟙 (K.X (2 * i))) _ rfl (by rw [staircaseChain_d_two_mul, comp_zero])
  let ψ := K.homologyι (2 * i) ≫
    K.descOpcycles (quotientMap R c i) _ rfl (d_comp_quotientMap R c _ i)
  have key : z ≫ K.homologyπ (2 * i) ≫ ψ = quotientMap R c i := by simp [z, ψ]
  refine ⟨(K.homologyπ (2 * i)).hom (z.hom (1 : R)), fun r hr => ?_⟩
  have h1 : ψ.hom (r • (K.homologyπ (2 * i)).hom (z.hom (1 : R))) = 0 := by rw [hr, map_zero]
  have h2 : ψ.hom ((K.homologyπ (2 * i)).hom (z.hom (1 : R))) = Submodule.Quotient.mk 1 :=
    congrArg (fun φ => φ.hom (1 : R)) key
  rw [map_smul, h2, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one,
    Submodule.Quotient.mk_eq_zero] at h1
  exact h1

/-- **Detection.** The cohomology `H^{-2i}` of the staircase complex in `D(R)` contains an element,
the class of `1`, whose annihilator is contained in `(c i)`. -/
theorem exists_homologyFunctor_Q_staircase [HasDerivedCategory.{w} (ModuleCat.{u} R)] (i : ℕ) :
    ∃ s : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) (-(2 * (i : ℤ)))).obj
      (DerivedCategory.Q.obj (staircase R c)), ∀ r : R, r • s = 0 → r ∈ Ideal.span {c i} := by
  obtain ⟨t, ht⟩ := exists_homology_staircaseChain R c i
  have hn : ComplexShape.embeddingDownNat.f (2 * i) = -(2 * (i : ℤ)) := by
    change -(((2 * i : ℕ)) : ℤ) = _
    push_cast
    rfl
  let e := ((DerivedCategory.homologyFunctorFactors (ModuleCat.{u} R) _).app (staircase R c) ≪≫
    (staircaseChain R c).extendHomologyIso ComplexShape.embeddingDownNat hn).toLinearEquiv
  refine ⟨e.symm t, fun r hr => ht r ?_⟩
  have := congrArg e hr
  rwa [map_smul, LinearEquiv.apply_symm_apply, map_zero] at this

end Homology

section Tor

variable {R R' : Type u} [CommRing R] [CommRing R'] (f : R →+* R')



/-- The ring map `f`, read as an `R`-linear map from `R` to `R'` with its restricted structure. -/
def ringHomLinear : R →ₗ[R] (ModuleCat.restrictScalars.{u} f).obj (ModuleCat.of R' R') where
  toFun r := f r
  map_add' := map_add f
  map_smul' r x := map_mul f r x

lemma ringHomLinear_apply (r : R) : ringHomLinear f r = f r := rfl

/-- The adjunction between extension and restriction of scalars along `f`. -/
abbrev extendRestrictAdj : ModuleCat.extendScalars.{u, u, u} f ⊣ ModuleCat.restrictScalars.{u} f :=
  ModuleCat.extendRestrictScalarsAdj f

/-- The unit `M ⟶ R' ⊗_R M` is `m ↦ 1 ⊗ m`, written as `f ⊗ M` after `M ≅ R ⊗_R M`. -/
lemma extendRestrictAdj_unit_apply (M : ModuleCat.{u} R) (m : M) :
    ((extendRestrictAdj f).unit.app M).hom m =
      LinearMap.rTensor M (ringHomLinear f) ((TensorProduct.lid R M).symm m) := by
  rw [ModuleCat.extendRestrictScalarsAdj_unit_app_apply, TensorProduct.lid_symm_apply,
    LinearMap.rTensor_tmul, ringHomLinear_apply, map_one]
  rfl

/-- For a surjective `f`, the unit `M ⟶ R' ⊗_R M` is surjective. -/
lemma extendRestrictAdj_unit_surjective (hf : Function.Surjective f) (M : ModuleCat.{u} R) :
    Function.Surjective ((extendRestrictAdj f).unit.app M).hom := by
  intro y
  obtain ⟨z, hz⟩ := LinearMap.rTensor_surjective M (g := ringHomLinear f) hf y
  refine ⟨TensorProduct.lid R M z, ?_⟩
  rw [extendRestrictAdj_unit_apply, LinearEquiv.symm_apply_apply, hz]

/-- Under `R ⊗_R M ≅ M`, multiplication by `w` on the left factor is multiplication by `w`. -/
lemma lid_rTensor_mulLeft (M : Type*) [AddCommGroup M] [Module R M] (w : R) (z : R ⊗[R] M) :
    TensorProduct.lid R M (LinearMap.rTensor M (LinearMap.mulLeft R w) z) =
      w • TensorProduct.lid R M z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul r m => simp [mul_smul]
  | add x y hx hy => simp only [map_add, hx, hy, smul_add]

/-- If `f` is surjective with kernel `(w)`, the kernel of the unit `M ⟶ R' ⊗_R M` is `w M`. -/
lemma exists_smul_eq_of_extendRestrictAdj_unit_eq_zero (hf : Function.Surjective f) (w : R)
    (hw : RingHom.ker f = Ideal.span {w}) (M : ModuleCat.{u} R) (x : M)
    (hx : ((extendRestrictAdj f).unit.app M).hom x = 0) : ∃ y : M, w • y = x := by
  have hex : Function.Exact (LinearMap.mulLeft R w) (ringHomLinear f) := by
    intro y
    change f y = 0 ↔ _
    rw [← RingHom.mem_ker, hw, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨a, by simp [mul_comm]⟩
    · rintro ⟨a, rfl⟩
      exact ⟨a, by simp [mul_comm]⟩
  rw [extendRestrictAdj_unit_apply] at hx
  obtain ⟨z, hz⟩ := ((rTensor_exact M hex hf) _).mp hx
  refine ⟨TensorProduct.lid R M z, ?_⟩
  rw [← lid_rTensor_mulLeft, hz, LinearEquiv.apply_symm_apply]

/-- The unit `G ⟶ (restrictScalars f) ((extendScalars f) G)`, degreewise on a complex. -/
def unitMap (G : CochainComplex (ModuleCat.{u} R) ℤ) :
    G ⟶ ((ModuleCat.restrictScalars.{u} f).mapHomologicalComplex _).obj
      (((ModuleCat.extendScalars.{u, u, u} f).mapHomologicalComplex _).obj G) where
  f i := (extendRestrictAdj f).unit.app (G.X i)
  comm' i j _ := ((extendRestrictAdj f).unit.naturality (G.d i j)).symm

/-- The short complex `0 ⟶ G ⟶ G ⟶ (restrictScalars f) ((extendScalars f) G) ⟶ 0` whose first
map is multiplication by an element `w` of the kernel of `f` and whose second map is the unit. -/
def smulUnitShortComplex (w : R) (hw : f w = 0) (G : CochainComplex (ModuleCat.{u} R) ℤ) :
    ShortComplex (CochainComplex (ModuleCat.{u} R) ℤ) :=
  ShortComplex.mk (w • 𝟙 G) (unitMap f G) (by
    ext i m
    change ((extendRestrictAdj f).unit.app (G.X i)).hom (w • m) = 0
    rw [map_smul, ModuleCat.restrictScalars.smul_def, hw, zero_smul]
    rfl)

/-- If `f` is surjective with kernel generated by a nonzerodivisor `w` and `G` has free terms,
`0 ⟶ G ⟶ G ⟶ (restrictScalars f) ((extendScalars f) G) ⟶ 0` is short exact. -/
theorem shortExact_smulUnitShortComplex (hf : Function.Surjective f) (w : R)
    (hw : RingHom.ker f = Ideal.span {w}) (hw' : w ∈ nonZeroDivisors R) (hw0 : f w = 0)
    (G : CochainComplex (ModuleCat.{u} R) ℤ) [∀ i, Module.Free R (G.X i)] :
    (smulUnitShortComplex f w hw0 G).ShortExact := by
  apply HomologicalComplex.shortExact_of_degreewise_shortExact
  intro i
  refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
  · rw [ShortComplex.moduleCat_exact_iff]
    intro x hx
    exact exists_smul_eq_of_extendRestrictAdj_unit_eq_zero f hf w hw (G.X i) x hx
  · rw [ModuleCat.mono_iff_injective]
    exact Module.Flat.isSMulRegular_of_nonZeroDivisors (M := G.X i) hw'
  · rw [ModuleCat.epi_iff_surjective]
    exact extendRestrictAdj_unit_surjective f hf (G.X i)

/-- **The square of an element killing two adjacent cohomology modules kills the derived base
change.** Let `f : R →+* R'` be surjective with kernel generated by a nonzerodivisor `w`, and let
`M` be pseudo-coherent in `D(R)`. If `a` kills `H^k(M)` and `H^{k+1}(M)`, then `f (a ^ 2)` kills
`H^k(M ⊗ᴸ_R R')`. -/
theorem smul_sq_homologyFunctor_eq_zero (hf : Function.Surjective f) (w : R)
    (hw : RingHom.ker f = Ideal.span {w}) (hw' : w ∈ nonZeroDivisors R)
    [HasDerivedCategory.{wR} (ModuleCat.{u} R)] [HasDerivedCategory.{wA} (ModuleCat.{u} R')]
    (L : TotalDerivedExtensionScalars.{u, u, u, wR, wA} f)
    {M : DerivedCategory (ModuleCat.{u} R)} (hM : IsPseudoCoherent M) (k : ℤ) (a : R)
    (hk : ∀ s : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) k).obj M, a • s = 0)
    (hk' : ∀ s : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) (k + 1)).obj M, a • s = 0)
    (s : (DerivedCategory.homologyFunctor (ModuleCat.{u} R') k).obj (L.functor.obj M)) :
    f (a ^ 2) • s = 0 := by
  obtain ⟨G, hG, ⟨e⟩⟩ := hM
  obtain ⟨b, hb⟩ := hG.upperBound
  have : ∀ i, Module.Free R (G.X i) := fun i => (hG.finiteFree i).2
  have : ∀ i, Projective (G.X i) := fun i =>
    ModuleCat.projective_of_free (Module.Free.chooseBasis R (G.X i))
  have := L.comparison_isIso_of_projective G b
  have hw0 : f w = 0 := by
    rw [← RingHom.mem_ker, hw]
    exact Ideal.mem_span_singleton_self w
  have hGk : ∀ j : ℤ, (∀ s : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) j).obj M,
      a • s = 0) → ∀ x : G.homology j, a • x = 0 := fun j h x =>
    smul_eq_zero_of_iso (((DerivedCategory.homologyFunctorFactors _ j).app G).symm ≪≫
      (DerivedCategory.homologyFunctor _ j).mapIso e) h x
  let G' := ((ModuleCat.extendScalars.{u, u, u} f).mapHomologicalComplex (ComplexShape.up ℤ)).obj G
  let E : (DerivedCategory.homologyFunctor (ModuleCat.{u} R') k).obj (L.functor.obj M) ≅
      G'.homology k :=
    (DerivedCategory.homologyFunctor _ k).mapIso
      (L.functor.mapIso e.symm ≪≫ asIso (L.comparison.app G)) ≪≫
      (DerivedCategory.homologyFunctorFactors _ k).app G'
  refine smul_eq_zero_of_iso E (fun x => ?_) s
  let S := smulUnitShortComplex f w hw0 G
  have hS : S.ShortExact := shortExact_smulUnitShortComplex f hf w hw hw' hw0 G
  let ψ : S.X₃.homology k ≅ (ModuleCat.restrictScalars.{u} f).obj (G'.homology k) :=
    (G'.sc k).mapHomologyIso (ModuleCat.restrictScalars.{u} f)
  have key : ∀ y : S.X₃.homology k, (a ^ 2) • y = 0 := by
    intro y
    have h1 : (hS.δ k (k + 1) rfl).hom (a • y) = 0 := by
      rw [map_smul]
      exact hGk _ hk' _
    obtain ⟨t, ht⟩ := (ShortComplex.moduleCat_exact_iff _).mp (hS.homology_exact₃ k (k + 1) rfl)
      (a • y) h1
    change (HomologicalComplex.homologyMap S.g k).hom t = a • y at ht
    have ht0 : (a • t : S.X₂.homology k) = 0 := hGk _ hk t
    rw [pow_two, mul_smul, ← ht, ← map_smul, ht0, map_zero]
  have h := congrArg ψ.hom.hom (key (ψ.inv.hom x))
  have hx : ψ.hom.hom (ψ.inv.hom x) = x := congrArg (fun φ => φ.hom x) ψ.inv_hom_id
  rw [map_smul, map_zero, hx] at h
  exact h

end Tor

section Polynomial

/-- A polynomial over a domain vanishing at all the distinct powers `ϖ ^ (i + 1)` is zero. -/
theorem eq_zero_of_eval_pow_succ_eq_zero {A : Type*} [CommRing A] [IsDomain A] (ϖ : A)
    (hϖ : Function.Injective (fun i : ℕ => ϖ ^ (i + 1))) (p : Polynomial A)
    (hp : ∀ i : ℕ, p.eval (ϖ ^ (i + 1)) = 0) : p = 0 :=
  Polynomial.eq_zero_of_infinite_isRoot p ((Set.infinite_range_of_injective hϖ).mono (by
    rintro _ ⟨i, rfl⟩
    exact hp i))

end Polynomial

