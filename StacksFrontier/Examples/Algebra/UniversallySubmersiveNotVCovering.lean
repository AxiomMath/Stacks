/-!
# A universally submersive morphism which is not a V covering

There is a morphism of affine schemes which remains submersive after every base change, but whose
singleton family is not a V covering. In particular the V topology is strictly finer than the
topology generated by universally submersive morphisms.

The source is the ring of integers of a rank-two valuation `ℚ((t₀))((t₁))`-style Hahn series field,
written here as the Hahn series field over `ℚ` with value group `ℤ ×ₗ ℤ`. Its spectrum is a chain
of three points; the map is the disjoint union of the localization at the middle prime and the
quotient by it, so it misses no point after any base change but splits the chain in two. That the
base changes are submersive is proved valuatively: a specialization in a base change is realized by
a valuation ring, and the comparison of the pulled-back prime with the middle prime decides which
of the two factors lifts it. That the singleton family is not a V covering follows from the
valuative criterion: a map from the rank-two valuation ring itself cannot be lifted, because the
idempotent splitting the two factors would force either a nonzero element to die or a nonunit to
become a unit.

## Main results

* `Stacks.Examples.exists_universallySubmersive_not_isVCovering`: such a morphism exists.

## Implementation notes

Submersiveness is the quotient-map property of the underlying topological map, and universal
submersiveness is its universal closure as a morphism property of schemes. The singleton family is
indexed by `Unit`. The construction is transported along `ULift` so that it lives in an arbitrary
universe.

## References

* [Stacks Project, Tag 0EU9](https://stacks.math.columbia.edu/tag/0EU9)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.MorphismProperty

universe u

namespace Stacks.Examples

private abbrev Gamma := ℤ ×ₗ ℤ
private abbrev HahnField := HahnSeries Gamma ℚ

private instance rankTwoGammaOrdered : IsOrderedAddMonoid Gamma where
  add_le_add_left a b hab c := by
    rcases Prod.Lex.le_iff.mp hab with h | ⟨h, h'⟩
    · apply Prod.Lex.le_iff.mpr
      left
      simpa using add_lt_add_left h (ofLex c).1
    · apply Prod.Lex.le_iff.mpr
      right
      constructor
      · simpa using congrArg (fun z : ℤ => (ofLex c).1 + z) h
      · simpa using add_le_add_left h' (ofLex c).2

private instance rankTwoGammaOrderedCancel : IsOrderedCancelAddMonoid Gamma where
  __ := rankTwoGammaOrdered
  le_of_add_le_add_left a b c h := by
    rcases Prod.Lex.le_iff.mp h with h | ⟨h, h'⟩
    · exact Prod.Lex.le_iff.mpr (Or.inl ((add_lt_add_iff_left _).mp h))
    · exact Prod.Lex.le_iff.mpr (Or.inr ⟨add_left_cancel h, (add_le_add_iff_left _).mp h'⟩)

private noncomputable def rankTwoValuation : StacksValuation HahnField Gamma where
  toFun x := x.val.order
  map_mul' a b := HahnSeries.order_mul a.ne_zero b.ne_zero
  map_add' a b h := by
    change min a.val.order b.val.order ≤ (a.val + b.val).order
    exact HahnSeries.min_order_le_order_add h

private noncomputable abbrev rankTwoRing := rankTwoValuation.integerSubring

private noncomputable def rankTwoOrder (x : rankTwoRing) : Gamma := by
  classical
  exact if hx : (x : HahnField) = 0 then 0
    else rankTwoValuation.toFun (Units.mk0 (x : HahnField) hx)

private theorem rankTwoOrder_eq (x : rankTwoRing) (hx : (x : HahnField) ≠ 0) :
    rankTwoOrder x = rankTwoValuation.toFun (Units.mk0 (x : HahnField) hx) := by
  simp [rankTwoOrder, hx]

private theorem rankTwoOrder_one : rankTwoOrder (1 : rankTwoRing) = 0 := by
  have hne : ((1 : rankTwoRing) : HahnField) ≠ 0 := one_ne_zero
  rw [rankTwoOrder_eq _ hne]
  simp [rankTwoValuation]

private theorem rankTwoOrder_nonneg (x : rankTwoRing) : 0 ≤ rankTwoOrder x := by
  classical
  by_cases hx : (x : HahnField) = 0
  · simp [rankTwoOrder, hx]
  · have hv := (rankTwoValuation.mem_integerSubring_iff (x : HahnField)).mp x.property
    rcases hv with hzero | ⟨h, hval⟩
    · exact (hx hzero).elim
    · simpa [rankTwoOrder, hx] using hval

private theorem rankTwoOrder_mul {x y : rankTwoRing}
    (hx : (x : HahnField) ≠ 0) (hy : (y : HahnField) ≠ 0) :
    rankTwoOrder (x * y) = rankTwoOrder x + rankTwoOrder y := by
  rw [rankTwoOrder_eq _ (mul_ne_zero hx hy), rankTwoOrder_eq _ hx,
    rankTwoOrder_eq _ hy]
  exact HahnSeries.order_mul hx hy

private theorem rankTwoOrder_pow (x : rankTwoRing) (hx : (x : HahnField) ≠ 0) (n : ℕ) :
    rankTwoOrder (x ^ n) = n • rankTwoOrder x := by
  induction n with
  | zero => simp [rankTwoOrder_one]
  | succ n ih =>
    rw [pow_succ, rankTwoOrder_mul (pow_ne_zero _ hx) hx, ih]
    simp [add_smul]

private theorem rankTwo_dvd_of_order_lt {x y : rankTwoRing}
    (hx : (x : HahnField) ≠ 0) (hy : (y : HahnField) ≠ 0)
    (hxy : rankTwoOrder x < rankTwoOrder y) : x ∣ y := by
  rcases ValuationRing.cond x y with ⟨c, h | h⟩
  · exact ⟨c, h.symm⟩
  · have hcx : (c : HahnField) ≠ 0 := by
      intro hc
      have : (c : HahnField) * (y : HahnField) = (x : HahnField) := by
        simpa [mul_comm] using congrArg Subtype.val h
      rw [hc, zero_mul] at this
      exact hx this.symm
    have hle : rankTwoOrder y ≤ rankTwoOrder x := by
      have h' : c * y = x := by simpa [mul_comm] using h
      rw [← h', rankTwoOrder_mul hcx hy]
      exact le_add_of_nonneg_left (rankTwoOrder_nonneg c)
    exact (not_lt_of_ge hle hxy).elim

private def middlePrime : Ideal rankTwoRing where
  carrier := {x | (x : HahnField) = 0 ∨ 0 < (ofLex (rankTwoOrder x)).1}
  zero_mem' := Or.inl rfl
  add_mem' := by
    classical
    have key : ∀ a b : rankTwoRing, 0 < (ofLex (rankTwoOrder a)).1 → (a : HahnField) + b ≠ 0 →
        HahnSeries.order (a : HahnField) ≤ HahnSeries.order (b : HahnField) →
        0 < (ofLex (rankTwoOrder (a + b))).1 := by
      intro a b hapos hab hle
      have ha : (a : HahnField) ≠ 0 := by
        intro h
        obtain rfl : a = 0 := Subtype.ext h
        simp [rankTwoOrder] at hapos
      have hle' : HahnSeries.order (a : HahnField) ≤
          HahnSeries.order ((a + b : rankTwoRing) : HahnField) := by
        simpa [min_eq_left hle] using HahnSeries.min_order_le_order_add hab
      have hv : rankTwoOrder a ≤ rankTwoOrder (a + b) := by
        rw [rankTwoOrder_eq a ha, rankTwoOrder_eq (a + b) (by simpa using hab)]
        exact hle'
      exact lt_of_lt_of_le hapos (Prod.Lex.monotone_fst _ _ hv)
    intro x y hx hy
    rcases hx with hx0 | hxpos
    · obtain rfl : x = 0 := Subtype.ext hx0
      simpa using hy
    rcases hy with hy0 | hypos
    · obtain rfl : y = 0 := Subtype.ext hy0
      exact Or.inr (by simpa using hxpos)
    by_cases hxy : ((x : HahnField) + (y : HahnField)) = 0
    · exact Or.inl (by simpa using hxy)
    right
    rcases le_total (HahnSeries.order (x : HahnField)) (HahnSeries.order (y : HahnField)) with h | h
    · exact key x y hxpos hxy h
    · rw [add_comm]
      exact key y x hypos (by rwa [add_comm]) h
  smul_mem' := by
    classical
    intro r x hx
    rcases hx with hx0 | hxpos
    · exact Or.inl (by simp [hx0])
    · by_cases hrx : ((r * x : rankTwoRing) : HahnField) = 0
      · exact Or.inl hrx
      · right
        obtain ⟨hrne, hxne⟩ := mul_ne_zero_iff.mp hrx
        have hr : 0 ≤ (ofLex (rankTwoOrder r)).1 := by
          have hnonneg := rankTwoOrder_nonneg r
          have hfst := Prod.Lex.monotone_fst _ _ hnonneg
          simpa using hfst
        have hmul := rankTwoOrder_mul (x := r) (y := x) hrne hxne
        change 0 < (ofLex (rankTwoOrder (r * x))).1
        rw [hmul]
        change 0 < (ofLex (rankTwoOrder r)).1 + (ofLex (rankTwoOrder x)).1
        omega

private theorem middlePrime_isPrime : middlePrime.IsPrime := by
  rw [Ideal.isPrime_iff]
  constructor
  · rw [Ne, Ideal.eq_top_iff_one]
    rintro (h | h)
    · exact one_ne_zero h
    · rw [rankTwoOrder_one] at h
      exact lt_irrefl 0 h
  · intro a b hab
    change ((a * b : rankTwoRing) : HahnField) = 0 ∨
      0 < (ofLex (rankTwoOrder (a * b))).1 at hab
    rcases hab with hab0 | habpos
    · exact (mul_eq_zero.mp (hab0 : (a : HahnField) * b = 0)).imp Or.inl Or.inl
    · have hprod : (a * b : rankTwoRing) ≠ 0 := by
        intro hzero
        have hzero' : ((a * b : rankTwoRing) : HahnField) = 0 := congrArg Subtype.val hzero
        simp [rankTwoOrder, hzero'] at habpos
      obtain ⟨ha, hb⟩ := mul_ne_zero_iff.mp (show (a : HahnField) * (b : HahnField) ≠ 0 from
        fun h => hprod (Subtype.ext h))
      rw [rankTwoOrder_mul ha hb] at habpos
      have hfst : (ofLex (rankTwoOrder a + rankTwoOrder b)).1 =
          (ofLex (rankTwoOrder a)).1 + (ofLex (rankTwoOrder b)).1 := rfl
      rw [hfst] at habpos
      by_cases ha_pos : 0 < (ofLex (rankTwoOrder a)).1
      · exact Or.inl (Or.inr ha_pos)
      · exact Or.inr (Or.inr (by omega))

private noncomputable def rankTwoMonomial (g : Gamma) (hg : 0 ≤ g) : rankTwoRing :=
  ⟨HahnSeries.single g (1 : ℚ), by
    apply (rankTwoValuation.mem_integerSubring_iff _).2
    right
    refine ⟨HahnSeries.single_ne_zero one_ne_zero, ?_⟩
    simp [rankTwoValuation, HahnSeries.order_single, hg]⟩

private noncomputable def t₀ : rankTwoRing :=
  rankTwoMonomial (toLex (1, 0)) (by
    apply Prod.Lex.le_iff.mpr
    exact Or.inl (by norm_num))

private noncomputable def t₁ : rankTwoRing :=
  rankTwoMonomial (toLex (0, 1)) (by
    apply Prod.Lex.le_iff.mpr
    exact Or.inr ⟨by norm_num, by norm_num⟩)

private theorem t₀_ne_zero : (t₀ : HahnField) ≠ 0 := by
  change HahnSeries.single _ (1 : ℚ) ≠ 0
  exact HahnSeries.single_ne_zero one_ne_zero

private theorem t₁_ne_zero : (t₁ : HahnField) ≠ 0 := by
  change HahnSeries.single _ (1 : ℚ) ≠ 0
  exact HahnSeries.single_ne_zero one_ne_zero

private theorem rankTwoOrder_t₀ : rankTwoOrder t₀ = toLex (1, 0) := by
  rw [rankTwoOrder_eq t₀ t₀_ne_zero]
  simp [rankTwoValuation, t₀, rankTwoMonomial, HahnSeries.order_single]

private theorem rankTwoOrder_t₁ : rankTwoOrder t₁ = toLex (0, 1) := by
  rw [rankTwoOrder_eq t₁ t₁_ne_zero]
  simp [rankTwoValuation, t₁, rankTwoMonomial, HahnSeries.order_single]

private theorem t₀_mem_middlePrime : t₀ ∈ middlePrime := by
  right
  rw [rankTwoOrder_t₀]
  norm_num

private theorem t₁_not_mem_middlePrime : t₁ ∉ middlePrime := by
  intro h
  change (t₁ : HahnField) = 0 ∨ 0 < (ofLex (rankTwoOrder t₁)).1 at h
  rcases h with h | h
  · exact t₁_ne_zero h
  · rw [rankTwoOrder_t₁] at h
    norm_num at h

private theorem rankTwoAddVal_t₁ :
    rankTwoValuation.addVal (t₁ : HahnField) =
      ((toLex (0, 1) : Gamma) : WithTop Gamma) := by
  rw [StacksValuation.addVal_apply, StacksValuation.rawVal_of_ne_zero
    rankTwoValuation t₁_ne_zero]
  simp [rankTwoValuation, t₁, rankTwoMonomial, HahnSeries.order_single]

private theorem t₁_mem_maximalIdeal :
    t₁ ∈ IsLocalRing.maximalIdeal rankTwoRing := by
  have hval : 0 < rankTwoValuation.addVal (t₁ : HahnField) := by
    rw [rankTwoAddVal_t₁]
    apply WithTop.coe_lt_coe.mpr
    apply Prod.Lex.toLex_lt_toLex.mpr
    exact Or.inr ⟨by norm_num, by norm_num⟩
  exact ((rankTwoValuation.isValuationRing).2.2.1 t₁).mpr hval

attribute [local instance] middlePrime_isPrime

private theorem rankTwoOrder_t₀_pow (n : ℕ) : rankTwoOrder (t₀ ^ n) = toLex ((n : ℤ), 0) := by
  rw [rankTwoOrder_pow t₀ t₀_ne_zero, rankTwoOrder_t₀]
  exact (map_nsmul (toLexAddEquiv (ℤ × ℤ)) n ((1 : ℤ), (0 : ℤ))).symm.trans
    (congrArg toLex (by ext <;> simp))

private theorem rankTwoOrder_t₁_pow (n : ℕ) : rankTwoOrder (t₁ ^ n) = toLex (0, (n : ℤ)) := by
  rw [rankTwoOrder_pow t₁ t₁_ne_zero, rankTwoOrder_t₁]
  exact (map_nsmul (toLexAddEquiv (ℤ × ℤ)) n ((0 : ℤ), (1 : ℤ))).symm.trans
    (congrArg toLex (by ext <;> simp))

/-- A prime containing `a` contains `b` once the order of `b ^ n` exceeds the order of `a`. -/
private theorem mem_of_order_lt_order_pow (P : Ideal rankTwoRing) [P.IsPrime] {a b : rankTwoRing}
    (ha : (a : HahnField) ≠ 0) (hb : (b : HahnField) ≠ 0) (n : ℕ)
    (hlt : rankTwoOrder a < rankTwoOrder (b ^ n)) (haP : a ∈ P) : b ∈ P :=
  (‹P.IsPrime›).mem_of_pow_mem n
    (Ideal.mem_of_dvd P (rankTwo_dvd_of_order_lt ha (pow_ne_zero n hb) hlt) haP)

/-- The coordinates of twice an element of `ℤ ×ₗ ℤ`. -/
private theorem ofLex_two_nsmul (g : Gamma) :
    ofLex (2 • g) = (2 • (ofLex g).1, 2 • (ofLex g).2) :=
  map_nsmul (ofLexAddEquiv (ℤ × ℤ)) 2 g

private theorem middlePrime_le_of_t₀_mem (P : Ideal rankTwoRing) [P.IsPrime] (ht₀ : t₀ ∈ P) :
    middlePrime ≤ P := by
  intro y hymid
  by_cases hy0 : (y : HahnField) = 0
  · have hy : y = 0 := Subtype.ext hy0
    simp [hy]
  have hym : 0 < (ofLex (rankTwoOrder y)).1 := by
    change (y : HahnField) = 0 ∨ 0 < (ofLex (rankTwoOrder y)).1 at hymid
    exact hymid.resolve_left hy0
  refine mem_of_order_lt_order_pow P t₀_ne_zero hy0 2 ?_ ht₀
  rw [rankTwoOrder_t₀, rankTwoOrder_pow y (by simpa using hy0)]
  apply Prod.Lex.lt_iff.mpr
  apply Or.inl
  rw [ofLex_two_nsmul]
  simp only [ofLex_toLex]
  rw [two_nsmul]
  omega

private theorem middlePrime_eq_bot_or_self (P : Ideal rankTwoRing) [P.IsPrime]
    (hP : P ≤ middlePrime) : P = ⊥ ∨ P = middlePrime := by
  by_cases hzero : P = ⊥
  · exact Or.inl hzero
  · right
    obtain ⟨x, hxP, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hzero
    have hxne : (x : HahnField) ≠ 0 := fun h => hx0 (Subtype.ext h)
    have hxmid : 0 < (ofLex (rankTwoOrder x)).1 := by
      have hxmem := hP hxP
      change (x : HahnField) = 0 ∨ 0 < (ofLex (rankTwoOrder x)).1 at hxmem
      exact hxmem.resolve_left hxne
    let n : ℕ := ((ofLex (rankTwoOrder x)).1).toNat + 1
    have hlt : rankTwoOrder x < rankTwoOrder (t₀ ^ n) := by
      rw [rankTwoOrder_t₀_pow]
      apply Prod.Lex.toLex_lt_toLex.mpr
      apply Or.inl
      have hfst : (ofLex (rankTwoOrder x)).1 < (n : ℤ) := by
        rw [show (n : ℤ) = (ofLex (rankTwoOrder x)).1 + 1 by
          simp [n, Int.toNat_of_nonneg (le_of_lt hxmid)]]
        omega
      exact hfst
    exact le_antisymm hP
      (middlePrime_le_of_t₀_mem P (mem_of_order_lt_order_pow P hxne t₀_ne_zero n hlt hxP))

private theorem rankTwoOrder_fst_eq_zero_and_snd_pos {x : rankTwoRing}
    (hmax : x ∈ IsLocalRing.maximalIdeal rankTwoRing) (hmid : x ∉ middlePrime) :
    (ofLex (rankTwoOrder x)).1 = 0 ∧ 0 < (ofLex (rankTwoOrder x)).2 := by
  have hxne : (x : HahnField) ≠ 0 := fun hx => hmid (Or.inl hx)
  have hxval : 0 < rankTwoOrder x := by
    have hchar := (rankTwoValuation.isValuationRing).2.2.1 x
    rw [StacksValuation.addVal_apply, StacksValuation.rawVal_of_ne_zero
      rankTwoValuation hxne] at hchar
    simpa [rankTwoOrder_eq x hxne] using hchar.mp hmax
  have hz : ofLex (0 : Gamma) = (0, 0) := rfl
  have hxfirst : (ofLex (rankTwoOrder x)).1 = 0 := by
    have hnot : ¬ 0 < (ofLex (rankTwoOrder x)).1 := fun h => hmid (Or.inr h)
    have hfst := Prod.Lex.le_iff.mp (rankTwoOrder_nonneg x)
    rw [hz] at hfst
    rcases hfst with hfst | ⟨hfst, _⟩ <;> omega
  refine ⟨hxfirst, ?_⟩
  rcases Prod.Lex.lt_iff.mp hxval with h | ⟨h, h₂⟩
  · rw [hz, hxfirst] at h
    omega
  · rw [hz] at h₂
    exact h₂

private theorem maximalIdeal_le_of_t₁_mem (P : Ideal rankTwoRing) [P.IsPrime]
    (hP : middlePrime ≤ P) (ht₁ : t₁ ∈ P) : IsLocalRing.maximalIdeal rankTwoRing ≤ P := by
  intro y hymax
  by_cases hymid : y ∈ middlePrime
  · exact hP hymid
  have hyne : (y : HahnField) ≠ 0 := fun hy => hymid (Or.inl hy)
  obtain ⟨hyfirst, hysecond⟩ := rankTwoOrder_fst_eq_zero_and_snd_pos hymax hymid
  refine mem_of_order_lt_order_pow P t₁_ne_zero hyne 2 ?_ ht₁
  rw [rankTwoOrder_t₁, rankTwoOrder_pow y (by simpa using hyne)]
  apply Prod.Lex.lt_iff.mpr
  rw [ofLex_two_nsmul]
  simp only [ofLex_toLex]
  refine Or.inr ⟨?_, ?_⟩
  · rw [hyfirst]
    norm_num
  · rw [two_nsmul]
    linarith [hysecond]

private theorem middlePrime_le_prime_eq_self_or_maximal
    (P : Ideal rankTwoRing) [P.IsPrime] (hP : middlePrime ≤ P) :
    P = middlePrime ∨ P = IsLocalRing.maximalIdeal rankTwoRing := by
  by_cases hEq : P = middlePrime
  · exact Or.inl hEq
  · right
    have hPmax : P ≤ IsLocalRing.maximalIdeal rankTwoRing :=
      IsLocalRing.le_maximalIdeal_of_isPrime P
    have hnotle : ¬ P ≤ middlePrime := fun hle => hEq (le_antisymm hle hP)
    obtain ⟨x, hxP, hxnot⟩ := SetLike.not_le_iff_exists.mp hnotle
    have hxne : (x : HahnField) ≠ 0 := fun hx => hxnot (Or.inl hx)
    obtain ⟨hxfirst, hxsecond⟩ := rankTwoOrder_fst_eq_zero_and_snd_pos (hPmax hxP) hxnot
    let n : ℕ := ((ofLex (rankTwoOrder x)).2).toNat + 1
    have hlt : rankTwoOrder x < rankTwoOrder (t₁ ^ n) := by
      rw [← toLex_ofLex (rankTwoOrder x), rankTwoOrder_t₁_pow]
      change toLex ((ofLex (rankTwoOrder x)).1, (ofLex (rankTwoOrder x)).2) <
        toLex ((0 : ℤ), (n : ℤ))
      rw [hxfirst]
      apply Prod.Lex.toLex_lt_toLex.mpr
      refine Or.inr ⟨rfl, ?_⟩
      have hnval : (n : ℤ) = (ofLex (rankTwoOrder x)).2 + 1 := by
        dsimp [n]
        rw [Int.toNat_of_nonneg (le_of_lt hxsecond)]
      rw [hnval]
      omega
    exact le_antisymm hPmax
      (maximalIdeal_le_of_t₁_mem P hP (mem_of_order_lt_order_pow P hxne t₁_ne_zero n hlt hxP))

private abbrev ExampleRing := Localization.AtPrime middlePrime ×
  (rankTwoRing ⧸ middlePrime)

private noncomputable def exampleRingHom : rankTwoRing →+* ExampleRing :=
  (algebraMap rankTwoRing (Localization.AtPrime middlePrime)).prod
    (Ideal.Quotient.mk middlePrime)

private abbrev LiftedRankTwoRing := ULift.{u} rankTwoRing
private abbrev LiftedExampleRing := ULift.{u} ExampleRing

private noncomputable def liftedExampleMorphism :
    Spec (.of LiftedExampleRing) ⟶ Spec (.of LiftedRankTwoRing) :=
  Spec.map (CommRingCat.ofHom exampleRingHom.ulift)

private theorem liftedExampleMorphism_factorization {W : Type u} [CommRing W]
    (φ : LiftedExampleRing →+* W) (ρ : LiftedRankTwoRing →+* W)
    (h : φ.comp exampleRingHom.ulift = ρ) :
    Spec.map (CommRingCat.ofHom φ) ≫ liftedExampleMorphism =
      Spec.map (CommRingCat.ofHom ρ) := by
  change Spec.map (CommRingCat.ofHom φ) ≫
    Spec.map (CommRingCat.ofHom exampleRingHom.ulift) = _
  rw [← Spec.map_comp]
  congr 1
  exact congrArg CommRingCat.ofHom h

private theorem exists_lift_of_comp_exampleRingHom {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism)
    {W : Type u} [CommRing W] (g : Spec (.of W) ⟶ Y') (ρ : rankTwoRing →+* W)
    (hρ : Spec.map (CommRingCat.ofHom (ρ.comp ULift.ringEquiv.toRingHom)) = g ≫ i₂)
    (φ : ExampleRing →+* W) (hφ : φ.comp exampleRingHom = ρ) :
    ∃ l : Spec (.of W) ⟶ X', l ≫ f' = g := by
  let φlift : LiftedExampleRing →+* W := φ.comp ULift.ringEquiv.toRingHom
  have hcomp : φlift.comp exampleRingHom.ulift = ρ.comp ULift.ringEquiv.toRingHom := by
    ext element
    exact congrArg (fun hom : rankTwoRing →+* W => hom element.down) hφ
  have hcompat : g ≫ i₂ = Spec.map (CommRingCat.ofHom φlift) ≫ liftedExampleMorphism :=
    hρ.symm.trans (liftedExampleMorphism_factorization _ _ hcomp).symm
  exact ⟨H.lift g (Spec.map (CommRingCat.ofHom φlift)) hcompat, H.lift_fst _ _ _⟩

private theorem exists_comp_exampleRingHom_of_units {W : Type*} [CommRing W]
    (ρ : rankTwoRing →+* W) (hunit : ∀ a : middlePrime.primeCompl, IsUnit (ρ a)) :
    ∃ φ : ExampleRing →+* W, φ.comp exampleRingHom = ρ :=
  ⟨(IsLocalization.lift hunit : Localization.AtPrime middlePrime →+* W).comp (RingHom.fst _ _),
    RingHom.ext fun a => by simp [exampleRingHom]⟩

private theorem exists_comp_exampleRingHom_of_zero {W : Type*} [CommRing W]
    (ρ : rankTwoRing →+* W) (hzero : ∀ a ∈ middlePrime, ρ a = 0) :
    ∃ φ : ExampleRing →+* W, φ.comp exampleRingHom = ρ :=
  ⟨(Ideal.Quotient.lift middlePrime ρ hzero).comp (RingHom.snd _ _),
    RingHom.ext fun _ => Ideal.Quotient.lift_mk middlePrime ρ hzero⟩

private theorem exists_comp_exampleRingHom_of_field {K : Type*} [Field K]
    (ρ : rankTwoRing →+* K) : ∃ φ : ExampleRing →+* K, φ.comp exampleRingHom = ρ := by
  classical
  rcases le_total (RingHom.ker ρ) middlePrime with hQp | hpQ
  · exact exists_comp_exampleRingHom_of_units ρ fun a =>
      isUnit_iff_ne_zero.mpr fun h => a.2 (hQp (RingHom.mem_ker.mpr h))
  · exact exists_comp_exampleRingHom_of_zero ρ fun a ha => RingHom.mem_ker.mp (hpQ ha)

/-- Every map to `Y'` from an affine scheme induces a ring map from the rank-two ring. -/
private theorem exists_ringHom_of_comp {Y' : Scheme.{u}}
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing)) {W : Type u} [CommRing W]
    (g : Spec (.of W) ⟶ Y') :
    ∃ ρ : rankTwoRing →+* W,
      Spec.map (CommRingCat.ofHom (ρ.comp ULift.ringEquiv.toRingHom)) = g ≫ i₂ := by
  let ρlift : LiftedRankTwoRing →+* W := (Spec.preimage (g ≫ i₂)).hom
  refine ⟨ρlift.comp ULift.ringEquiv.symm.toRingHom, ?_⟩
  have hhom : (ρlift.comp ULift.ringEquiv.symm.toRingHom).comp ULift.ringEquiv.toRingHom =
      ρlift := by
    ext element
    rfl
  rw [hhom]
  exact Spec.map_preimage _

private theorem example_baseChange_surjective {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism) :
    Function.Surjective f' := by
  intro y
  obtain ⟨ρ, hρ⟩ := exists_ringHom_of_comp i₂ (Y'.fromSpecResidueField y)
  obtain ⟨φ, hφ⟩ := exists_comp_exampleRingHom_of_field ρ
  obtain ⟨l, hl⟩ := exists_lift_of_comp_exampleRingHom i₁ i₂ f' H _ ρ hρ φ hφ
  refine ⟨l (genericPoint (Spec (.of (Y'.residueField y)))), ?_⟩
  calc
    f' (l (genericPoint (Spec (.of (Y'.residueField y))))) =
        Y'.fromSpecResidueField y (genericPoint (Spec (.of (Y'.residueField y)))) :=
      congrArg (fun g => g (genericPoint (Spec (.of (Y'.residueField y))))) hl
    _ = y := Y'.fromSpecResidueField_apply y _

private theorem prime_liesOver_of_local_domain_extension
    {A V : Type*} [CommRing A] [IsDomain A] [ValuationRing A]
    [CommRing V] [IsDomain V] [IsLocalRing V]
    (f : A →+* V) (hinj : Function.Injective f) (hloc : IsLocalHom f)
    (P : Ideal A) [P.IsPrime] :
    ∃ Q : Ideal V, Q.IsPrime ∧ Q.comap f = P := by
  let : Algebra A V := f.toAlgebra
  have hflat : Module.Flat A V := Module.Flat.flat_iff_torsion_eq_bot_of_isBezout.mpr
    (Submodule.isTorsionFree_iff_torsion_eq_bot.mp
      (Module.isTorsionFree_iff_algebraMap_injective.mpr hinj))
  have hloc' : IsLocalHom (algebraMap A V) := hloc
  have : Module.FaithfullyFlat A V :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom (A := A) (B := V)
  obtain ⟨Q, hQ⟩ := (PrimeSpectrum.comap_surjective_of_faithfullyFlat
    (A := A) (B := V))
    (⟨P, ‹P.IsPrime›⟩ : PrimeSpectrum A)
  refine ⟨Q.asIdeal, Q.isPrime, ?_⟩
  change PrimeSpectrum.comap f Q = ⟨P, ‹P.IsPrime›⟩ at hQ
  simpa using congrArg PrimeSpectrum.asIdeal hQ

private theorem closed_preimage_of_factorization {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism)
    (s : Set Y') (hs : IsClosed (f' ⁻¹' s))
    {W : Type u} [CommRing W] (g : Spec (.of W) ⟶ Y')
    (ρ : rankTwoRing →+* W)
    (hρ : Spec.map (CommRingCat.ofHom (ρ.comp ULift.ringEquiv.toRingHom)) = g ≫ i₂)
    (φ : ExampleRing →+* W) (hφ : φ.comp exampleRingHom = ρ) :
    IsClosed (g ⁻¹' s) := by
  obtain ⟨l, hl⟩ := exists_lift_of_comp_exampleRingHom i₁ i₂ f' H g ρ hρ φ hφ
  have hclosed := hs.preimage l.continuous
  change IsClosed ((l ≫ f') ⁻¹' s) at hclosed
  rwa [hl] at hclosed

/-- Specializations lift along a map onto an order-isomorphic copy of a set of primes. -/
private theorem mem_of_specialization_of_orderIso {Y' : Scheme.{u}} {A V : Type u}
    [CommRing A] [CommRing V] {s : Set Y'} {g : Spec (.of V) ⟶ Y'}
    (m : Spec (.of A) ⟶ Spec (.of V)) {S : Set (PrimeSpectrum V)} (e : PrimeSpectrum A ≃o S)
    (hm : ∀ x : Spec (.of A), m x = (e x : PrimeSpectrum V)) (hc : IsClosed ((m ≫ g) ⁻¹' s))
    {initial final : PrimeSpectrum V} (hi : initial ∈ S) (hf : final ∈ S) (hsp : initial ⤳ final)
    (hmem : g initial ∈ s) : g final ∈ s := by
  have hspecializes : e.symm ⟨initial, hi⟩ ⤳ e.symm ⟨final, hf⟩ :=
    (PrimeSpectrum.le_iff_specializes _ _).mp
      (e.symm.monotone ((PrimeSpectrum.le_iff_specializes _ _).mpr hsp))
  have hmemLift : e.symm ⟨initial, hi⟩ ∈ (m ≫ g) ⁻¹' s := by
    change g (m _) ∈ s
    rwa [hm (e.symm ⟨initial, hi⟩), e.apply_symm_apply]
  have hfinal := hc.stableUnderSpecialization hspecializes hmemLift
  change g (m _) ∈ s at hfinal
  rwa [hm (e.symm ⟨final, hf⟩), e.apply_symm_apply] at hfinal

private theorem mem_of_specialization_of_comap_le {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism)
    (s : Set Y') (hs : IsClosed (f' ⁻¹' s))
    {V : Type u} [CommRing V] (g : Spec (.of V) ⟶ Y')
    (ρ : rankTwoRing →+* V)
    (hρ : Spec.map (CommRingCat.ofHom (ρ.comp ULift.ringEquiv.toRingHom)) = g ≫ i₂)
    (initial final : PrimeSpectrum V) (hsp : initial ⤳ final)
    (hcenter : final.asIdeal.comap ρ ≤ middlePrime) (hmem : g initial ∈ s) :
    g final ∈ s := by
  let localRing := Localization.AtPrime final.asIdeal
  let localization : V →+* localRing := algebraMap V localRing
  let localMap := Spec.map (CommRingCat.ofHom localization)
  let localHom := localization.comp ρ
  have hlocal : Spec.map (CommRingCat.ofHom
      (localHom.comp ULift.ringEquiv.toRingHom)) = (localMap ≫ g) ≫ i₂ := by
    rw [Category.assoc, ← hρ, ← Spec.map_comp]
    rfl
  have hunit : ∀ element : middlePrime.primeCompl, IsUnit (localHom element) := fun element =>
    IsLocalization.map_units localRing
      (⟨ρ element, fun hmem => element.2 (hcenter hmem)⟩ : final.asIdeal.primeCompl)
  obtain ⟨φ, hφ⟩ := exists_comp_exampleRingHom_of_units localHom hunit
  exact mem_of_specialization_of_orderIso localMap
    (IsLocalization.AtPrime.primeSpectrumOrderIso localRing final.asIdeal) (fun _ => rfl)
    (closed_preimage_of_factorization i₁ i₂ f' H s hs _ localHom hlocal φ hφ)
    ((PrimeSpectrum.le_iff_specializes _ _).mpr hsp) (le_rfl : final.asIdeal ≤ final.asIdeal) hsp
    hmem

private theorem mem_of_specialization_of_le_comap {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism)
    (s : Set Y') (hs : IsClosed (f' ⁻¹' s))
    {V : Type u} [CommRing V] (g : Spec (.of V) ⟶ Y')
    (ρ : rankTwoRing →+* V)
    (hρ : Spec.map (CommRingCat.ofHom (ρ.comp ULift.ringEquiv.toRingHom)) = g ≫ i₂)
    (initial final : PrimeSpectrum V) (hsp : initial ⤳ final)
    (hcenter : middlePrime ≤ initial.asIdeal.comap ρ) (hmem : g initial ∈ s) :
    g final ∈ s := by
  let quotient : V →+* V ⧸ initial.asIdeal := Ideal.Quotient.mk initial.asIdeal
  let quotientMap := Spec.map (CommRingCat.ofHom quotient)
  let quotientHom := quotient.comp ρ
  have hquotient : Spec.map (CommRingCat.ofHom
      (quotientHom.comp ULift.ringEquiv.toRingHom)) = (quotientMap ≫ g) ≫ i₂ := by
    rw [Category.assoc, ← hρ, ← Spec.map_comp]
    rfl
  have hzero : ∀ element ∈ middlePrime, quotientHom element = 0 := fun _ helement =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (hcenter helement)
  obtain ⟨φ, hφ⟩ := exists_comp_exampleRingHom_of_zero quotientHom hzero
  exact mem_of_specialization_of_orderIso quotientMap
    initial.asIdeal.primeSpectrumQuotientOrderIsoZeroLocus (fun _ => rfl)
    (closed_preimage_of_factorization i₁ i₂ f' H s hs _ quotientHom hquotient φ hφ)
    (le_rfl : initial.asIdeal ≤ initial.asIdeal) ((PrimeSpectrum.le_iff_specializes _ _).mpr hsp)
    hsp hmem

private theorem mem_closedPoint_of_mem_genericPoint {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism)
    (s : Set Y') (hs : IsClosed (f' ⁻¹' s))
    {V : Type u} [CommRing V] [IsDomain V] [ValuationRing V] (g : Spec (.of V) ⟶ Y')
    (ρ : rankTwoRing →+* V)
    (hρ : Spec.map (CommRingCat.ofHom (ρ.comp ULift.ringEquiv.toRingHom)) = g ≫ i₂)
    (hgmem : g (genericPoint (Spec (.of V))) ∈ s) :
    g (IsLocalRing.closedPoint V) ∈ s := by
  classical
  let generic : PrimeSpectrum V := genericPoint (Spec (.of V))
  let closed : PrimeSpectrum V := IsLocalRing.closedPoint V
  have hspecializes : generic ⤳ closed := genericPoint_specializes _
  by_cases hfinal : closed.asIdeal.comap ρ ≤ middlePrime
  · exact mem_of_specialization_of_comap_le i₁ i₂ f' H s hs g ρ hρ
      generic closed hspecializes hfinal hgmem
  by_cases hinitial : middlePrime ≤ generic.asIdeal.comap ρ
  · exact mem_of_specialization_of_le_comap i₁ i₂ f' H s hs g ρ hρ
      generic closed hspecializes hinitial hgmem
  have hgenericCenter : generic.asIdeal.comap ρ = ⊥ :=
    (middlePrime_eq_bot_or_self (generic.asIdeal.comap ρ)
      ((le_total _ middlePrime).resolve_right hinitial)).resolve_right
      fun heq => hinitial (le_of_eq heq.symm)
  have hclosedCenter : closed.asIdeal.comap ρ = IsLocalRing.maximalIdeal rankTwoRing :=
    (middlePrime_le_prime_eq_self_or_maximal (closed.asIdeal.comap ρ)
      ((le_total _ middlePrime).resolve_left hfinal)).resolve_left
      fun heq => hfinal (le_of_eq heq)
  have hinjective : Function.Injective ρ := by
    rw [RingHom.injective_iff_ker_eq_bot]
    have hbot : generic.asIdeal = ⊥ :=
      congrArg PrimeSpectrum.asIdeal (genericPoint_eq_bot_of_affine (.of V))
    rw [hbot] at hgenericCenter
    rwa [RingHom.ker_eq_comap_bot]
  have hlocal : IsLocalHom ρ :=
    ((IsLocalRing.local_hom_TFAE ρ).out 5 1).mp hclosedCenter
  obtain ⟨middle, hprime, hmiddle⟩ := prime_liesOver_of_local_domain_extension
    ρ hinjective hlocal middlePrime
  let middlePoint : PrimeSpectrum V := ⟨middle, hprime⟩
  have hmiddleMem : g middlePoint ∈ s :=
    mem_of_specialization_of_comap_le i₁ i₂ f' H s hs g ρ hρ
      generic middlePoint (genericPoint_specializes _) (le_of_eq hmiddle) hgmem
  exact mem_of_specialization_of_le_comap i₁ i₂ f' H s hs g ρ hρ
    middlePoint closed (IsLocalRing.specializes_closedPoint _) (le_of_eq hmiddle.symm)
    hmiddleMem

private theorem example_baseChange_stableUnderSpecialization {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism)
    (s : Set Y') (hs : IsClosed (f' ⁻¹' s)) : StableUnderSpecialization s := by
  intro initial final hsp hmem
  obtain ⟨V, _, _, _, g, _, hgeneric, hclosed, _⟩ :=
    AlgebraicGeometry.exists_valuation_ring_of_specializes Y' hsp (Y'.residueField initial) (𝟙 _)
  obtain ⟨ρ, hρ⟩ := exists_ringHom_of_comp i₂ g
  have hgmem : g (genericPoint (Spec (.of V))) ∈ s := by rwa [hgeneric]
  have hresult := mem_closedPoint_of_mem_genericPoint i₁ i₂ f' H s hs g ρ hρ hgmem
  rwa [hclosed] at hresult

private theorem example_baseChange_isQuotientMap {X' Y' : Scheme.{u}}
    (i₁ : X' ⟶ Spec (.of LiftedExampleRing))
    (i₂ : Y' ⟶ Spec (.of LiftedRankTwoRing))
    (f' : X' ⟶ Y') (H : IsPullback f' i₁ i₂ liftedExampleMorphism) :
    Topology.IsQuotientMap f' := by
  have : QuasiCompact f' := MorphismProperty.IsStableUnderBaseChange.of_isPullback
    H.flip (inferInstance : QuasiCompact liftedExampleMorphism)
  have hsurj := example_baseChange_surjective i₁ i₂ f' H
  rw [Topology.isQuotientMap_iff_isClosed]
  refine ⟨hsurj, fun s => ⟨fun hs => hs.preimage f'.continuous, fun hs => ?_⟩⟩
  let ideal := Scheme.IdealSheafData.vanishingIdeal (⟨f' ⁻¹' s, hs⟩ : TopologicalSpace.Closeds X')
  have hrange : Set.range (ideal.subschemeι ≫ f') = s := by
    rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      Scheme.IdealSheafData.range_subschemeι,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    exact Set.image_preimage_eq _ hsurj
  have hstable := example_baseChange_stableUnderSpecialization i₁ i₂ f' H s hs
  rw [← hrange] at hstable ⊢
  exact (AlgebraicGeometry.isClosed_range_iff_stableUnderSpecialization
    (ideal.subschemeι ≫ f')).mpr hstable

private theorem map_zero_mk_t₁_eq_zero {W : Type*} [CommRing W] (φ : ExampleRing →+* W)
    (hφ : φ (1, 0) = 1) : φ (0, Ideal.Quotient.mk middlePrime t₁) = 0 := by
  have h : ((0, Ideal.Quotient.mk middlePrime t₁) : ExampleRing) =
      (1 - (1, 0)) * (0, Ideal.Quotient.mk middlePrime t₁) := by
    ext <;> simp
  rw [h, map_mul, map_sub, map_one, hφ, sub_self, zero_mul]

private theorem no_example_valuation_extension {W : Type*} [CommRing W] [IsDomain W]
    [IsLocalRing W] (e : rankTwoRing →+* W) (he : Function.Injective e)
    (hle : IsLocalHom e) (φ : ExampleRing →+* W)
    (hcomp : φ.comp exampleRingHom = e) : False := by
  let e₀ : ExampleRing := (1, 0)
  have he₀ : e₀ * e₀ = e₀ := by ext <;> simp [e₀]
  have hidem : φ e₀ * (φ e₀ - 1) = 0 := by
    rw [mul_sub, mul_one, ← map_mul, he₀, sub_self]
  rcases mul_eq_zero.mp hidem with hz | hone
  · have ht₀ : φ (exampleRingHom t₀) = 0 := by
      have hmul : e₀ * exampleRingHom t₀ = exampleRingHom t₀ := by
        ext
        · simp [e₀, exampleRingHom]
        · simp [e₀, exampleRingHom, Ideal.Quotient.eq_zero_iff_mem.mpr t₀_mem_middlePrime]
      rw [← hmul, map_mul, hz, zero_mul]
    have hcomp₀ : φ (exampleRingHom t₀) = e t₀ := RingHom.congr_fun hcomp t₀
    exact t₀_ne_zero (congrArg Subtype.val (he ((hcomp₀.symm.trans ht₀).trans (map_zero e).symm)))
  · have ht₁unit : IsUnit (e t₁) := by
      have hφe₁ : φ e₀ = 1 := sub_eq_zero.mp hone
      have hlocunit : IsUnit (algebraMap rankTwoRing (Localization.AtPrime middlePrime) t₁) :=
        IsLocalization.map_units (M := middlePrime.primeCompl) _ ⟨t₁, t₁_not_mem_middlePrime⟩
      obtain ⟨v, hv⟩ := hlocunit
      let a : ExampleRing := (algebraMap rankTwoRing (Localization.AtPrime middlePrime) t₁, 0)
      let b : ExampleRing := (↑v⁻¹, 0)
      have hleft : a * b = e₀ := by
        ext
        · simp [a, b, e₀, hv]
        · simp [a, b, e₀]
      have hdecomp : exampleRingHom t₁ = a + (0, Ideal.Quotient.mk middlePrime t₁) := by
        ext <;> simp [exampleRingHom, a]
      have hφleft : φ (exampleRingHom t₁) * φ b = 1 := by
        rw [hdecomp, map_add, map_zero_mk_t₁_eq_zero φ hφe₁, add_zero, ← map_mul, hleft, hφe₁]
      have hcomp₁ : φ (exampleRingHom t₁) = e t₁ := RingHom.congr_fun hcomp t₁
      exact IsUnit.of_mul_eq_one (φ b) (by rwa [← hcomp₁])
    exact (IsLocalRing.maximalIdeal.isMaximal (R := W)).ne_top
      (Ideal.eq_top_of_isUnit_mem (I := IsLocalRing.maximalIdeal W)
        (map_nonunit e t₁ t₁_mem_maximalIdeal) ht₁unit)

private theorem no_lifted_valuation_extension {W : Type u} [CommRing W] [IsDomain W]
    [ValuationRing W] (e : LiftedRankTwoRing →+* W) (he : Function.Injective e)
    (hle : IsLocalHom e) (h : Spec (.of W) ⟶ Spec (.of LiftedExampleRing))
    (hfactor : Spec.map (CommRingCat.ofHom e) = h ≫ liftedExampleMorphism) : False := by
  let e₀ : rankTwoRing →+* W := e.comp ULift.ringEquiv.symm.toRingHom
  let φ₀ : LiftedExampleRing →+* W := (Spec.preimage h).hom
  let φ : ExampleRing →+* W := φ₀.comp ULift.ringEquiv.symm.toRingHom
  have hcompU : φ₀.comp exampleRingHom.ulift = e := by
    have key := liftedExampleMorphism_factorization φ₀ _ rfl
    rw [show Spec.map (CommRingCat.ofHom φ₀) = h from Spec.map_preimage h, ← hfactor] at key
    exact (congrArg CommRingCat.Hom.hom (Spec.map_injective key)).symm
  have hcomp : φ.comp exampleRingHom = e₀ := by
    ext x
    exact RingHom.congr_fun hcompU (ULift.up x)
  have he₀ : Function.Injective e₀ := he.comp ULift.ringEquiv.symm.injective
  have hle₀ : IsLocalHom e₀ := by
    have : IsLocalHom (ULift.ringEquiv.symm.toRingHom : rankTwoRing →+* LiftedRankTwoRing) :=
      IsLocalHom.of_surjective _ ULift.ringEquiv.symm.surjective
    exact RingHom.isLocalHom_comp e (ULift.ringEquiv.symm.toRingHom)
  exact no_example_valuation_extension e₀ he₀ hle₀ φ hcomp

/-- An affine, universally submersive morphism whose singleton family is not a
V covering. -/
@[stacks 0EU9]
public theorem exists_universallySubmersive_not_isVCovering :
    ∃ (X Y : Scheme.{u}) (_ : IsAffine X) (_ : IsAffine Y) (f : X ⟶ Y),
      (topologically @Topology.IsQuotientMap : MorphismProperty Scheme.{u}).universally f ∧
        ¬ AlgebraicGeometry.IsVCovering (fun _ : Unit => X) (fun _ => f) := by
  refine ⟨Spec (.of LiftedExampleRing), Spec (.of LiftedRankTwoRing), inferInstance,
    inferInstance, liftedExampleMorphism, ?_, ?_⟩
  · intro X' Y' i₁ i₂ f' H
    exact example_baseChange_isQuotientMap i₁ i₂ f' H
  · intro hVC
    have hval := (AlgebraicGeometry.isVCovering_iff_valuation_lifting
      (f := liftedExampleMorphism)).mp hVC
    have : IsDomain LiftedRankTwoRing := ULift.ringEquiv.isDomain
    let : PreValuationRing LiftedRankTwoRing := {
      cond' := by
        intro a b
        obtain ⟨c, h⟩ := ValuationRing.cond a.down b.down
        exact ⟨ULift.up c, h.imp (congrArg ULift.up) (congrArg ULift.up)⟩ }
    let : ValuationRing LiftedRankTwoRing := ValuationRing.mk
    obtain ⟨W, _, _, _, e, ⟨he, hle⟩, h, hfac⟩ :=
      hval LiftedRankTwoRing (𝟙 (Spec (.of LiftedRankTwoRing)))
    exact no_lifted_valuation_extension e he hle h (by simpa using hfac)

end Stacks.Examples

