module

public import Mathlib
public import StacksFrontier.RingTheory.Nilpotent.Ideal

/-!
# The tower `ZMod (2 ^ (n + 1))` and its limit `ℤ_[2]`

For `n : ℕ` let `A_n = ZMod (2 ^ (n + 1))`, and let `A_{n+1} → A_n` be the canonical reduction
map. Every transition map is surjective with locally nilpotent kernel (its kernel has square
zero), and every `A_n` is finite, hence Noetherian. The limit `A` of the tower is the ring
`ℤ_[2]` of `2`-adic integers, the leg `A → A_n` corresponding to `PadicInt.toZModPow (n + 1)`.
In particular `A` is a Noetherian local domain, the element `uniformizer` corresponding to `2`
is a nonzero nonunit whose powers are pairwise distinct, the kernel of the leg `A → A_n` is the
ideal generated by `uniformizer ^ (n + 1)`, and an element of `A` with a power that vanishes in
every `A_n` is zero.

## Main definitions

* `tower`: the tower `(A_n)` as a functor `ℕᵒᵖ ⥤ CommRingCat`.
* `padicCone`, `padicConeIsLimit`: `ℤ_[2]` with the legs `PadicInt.toZModPow (n + 1)` is a limit
  cone over `tower`.
* `limitEquiv`: the ring isomorphism `limit tower ≃+* ℤ_[2]`.
* `uniformizer`: the element of `limit tower` corresponding to `2`.

## Main results

* `surjective_tower_map_succ`, `locallyNilpotent_ker_tower_map_succ`: the transition maps are
  surjective with locally nilpotent kernel.
* `toZModPow_limitEquiv`: `limitEquiv` is compatible with the legs.
* `ker_limit_π`: the kernel of the leg at `A_n` is generated by `uniformizer ^ (n + 1)`.
* `eq_zero_of_forall_limit_π_pow_eq_zero`: an element of the limit with a power vanishing in
  every `A_n` is zero.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace Stacks.Examples.TwoAdicTower

/-! ### The tower -/

/-- The reduction map `ZMod (2 ^ (n + 2)) → ZMod (2 ^ (n + 1))`. -/
def towerTransition (n : ℕ) : ZMod (2 ^ (n + 1 + 1)) →+* ZMod (2 ^ (n + 1)) :=
  ZMod.castHom (pow_dvd_pow 2 (Nat.le_succ (n + 1))) (ZMod (2 ^ (n + 1)))

/-- The tower `⋯ → ZMod 8 → ZMod 4 → ZMod 2` as a functor `ℕᵒᵖ ⥤ CommRingCat`, whose map
`ZMod (2 ^ (m + 1)) → ZMod (2 ^ (n + 1))` for `n ≤ m` is the canonical reduction map. -/
abbrev tower : ℕᵒᵖ ⥤ CommRingCat.{0} where
  obj n := CommRingCat.of (ZMod (2 ^ (n.unop + 1)))
  map f := CommRingCat.ofHom
    (ZMod.castHom (pow_dvd_pow 2 (Nat.succ_le_succ (leOfHom f.unop))) (ZMod (2 ^ (_ + 1))))
  map_id _ := CommRingCat.hom_ext (Subsingleton.elim _ _)
  map_comp _ _ := CommRingCat.hom_ext (Subsingleton.elim _ _)

theorem tower_obj (n : ℕ) : tower.obj (op n) = CommRingCat.of (ZMod (2 ^ (n + 1))) :=
  rfl

/-- Every map of the tower is the canonical reduction map. -/
theorem tower_map_eq {m n : ℕ} (h : n ≤ m) :
    tower.map (homOfLE h).op = CommRingCat.ofHom
      (ZMod.castHom (pow_dvd_pow 2 (Nat.succ_le_succ h)) (ZMod (2 ^ (n + 1)))) :=
  rfl

/-- The transition maps of the tower are surjective. -/
theorem surjective_tower_map_succ :
    ∀ n : ℕ, Function.Surjective (tower.map (homOfLE (Nat.le_succ n)).op).hom := by
  intro n
  exact ZMod.ringHom_surjective _

private theorem isNilpotent_of_mem_ker_towerTransition (n : ℕ) (x : ZMod (2 ^ (n + 1 + 1)))
    (hx : x ∈ RingHom.ker (towerTransition n)) : IsNilpotent x := by
  refine ⟨2, ?_⟩
  rw [RingHom.mem_ker, towerTransition, ZMod.castHom_apply, ZMod.cast_eq_val,
    ZMod.natCast_eq_zero_iff] at hx
  rw [← ZMod.natCast_zmod_val x, ← Nat.cast_pow, ZMod.natCast_eq_zero_iff]
  exact (pow_dvd_pow 2 (by lia : n + 1 + 1 ≤ (n + 1) * 2)).trans
    (by rw [pow_mul]; exact pow_dvd_pow_of_dvd hx 2)

/-- The kernels of the transition maps of the tower are locally nilpotent; they are even of
square zero. -/
theorem locallyNilpotent_ker_tower_map_succ :
    ∀ n : ℕ, (RingHom.ker (tower.map (homOfLE (Nat.le_succ n)).op).hom).LocallyNilpotent := by
  exact isNilpotent_of_mem_ker_towerTransition

/-- Each ring of the tower is Noetherian, being finite. -/
instance isNoetherianRing_tower_obj (n : ℕ) : IsNoetherianRing (tower.obj (op n)) :=
  inferInstanceAs (IsNoetherianRing (ZMod (2 ^ (n + 1))))

/-! ### The limit is `ℤ_[2]` -/

/-- The cone over `tower` with vertex `ℤ_[2]` and legs `PadicInt.toZModPow (n + 1)`. -/
def padicCone : Cone tower where
  pt := CommRingCat.of ℤ_[2]
  π := NatTrans.ofOpSequence (fun n => CommRingCat.ofHom (PadicInt.toZModPow (n + 1))) fun n => by
    exact (Category.id_comp _).trans <| CommRingCat.hom_ext
      (PadicInt.zmod_cast_comp_toZModPow (n + 1) (n + 1 + 1) (Nat.le_succ _)).symm

theorem padicCone_π_app (n : ℕ) :
    padicCone.π.app (op n) = CommRingCat.ofHom (PadicInt.toZModPow (n + 1)) :=
  rfl

/-- The compatible family `s.pt → ZMod (2 ^ k)`, `k : ℕ`, given by a cone `s` over `tower`. -/
def coneFamily (s : Cone tower) (k : ℕ) : s.pt →+* ZMod (2 ^ k) :=
  (ZMod.castHom (pow_dvd_pow 2 (Nat.le_succ k)) (ZMod (2 ^ k))).comp (s.π.app (op k)).hom

/-- Two ring maps into `ZMod b` agree after composing with a map to `ZMod a`. -/
private theorem comp_eq_comp_of_zmod {R : Type*} [NonAssocSemiring R] {a b : ℕ}
    (f g : ZMod a →+* ZMod b) (φ : R →+* ZMod a) : f.comp φ = g.comp φ := by
  rw [Subsingleton.elim f g]

/-- The family `coneFamily s` is compatible with the reduction maps. -/
theorem coneFamily_compat (s : Cone tower) (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂) :
    (ZMod.castHom (pow_dvd_pow 2 hk) (ZMod (2 ^ k₁))).comp (coneFamily s k₂) =
      coneFamily s k₁ := by
  have hw : (tower.map (homOfLE hk).op).hom.comp (s.π.app (op k₂)).hom =
      (s.π.app (op k₁)).hom :=
    congrArg CommRingCat.Hom.hom (s.w (homOfLE hk).op)
  rw [coneFamily, coneFamily, ← hw]
  exact comp_eq_comp_of_zmod ((ZMod.castHom (pow_dvd_pow 2 hk) (ZMod (2 ^ k₁))).comp
    (ZMod.castHom (pow_dvd_pow 2 (Nat.le_succ k₂)) (ZMod (2 ^ k₂))))
    ((ZMod.castHom (pow_dvd_pow 2 (Nat.le_succ k₁)) (ZMod (2 ^ k₁))).comp
      (tower.map (homOfLE hk).op).hom) (s.π.app (op k₂)).hom

/-- The member of `coneFamily s` at `ZMod (2 ^ (n + 1))` is the leg of `s` at `n`. -/
theorem coneFamily_succ (s : Cone tower) (n : ℕ) :
    coneFamily s (n + 1) = (s.π.app (op n)).hom :=
  congrArg CommRingCat.Hom.hom (s.w (homOfLE (Nat.le_succ n)).op)

/-- `ℤ_[2]` is the limit of the tower. -/
def padicConeIsLimit : IsLimit padicCone where
  lift s := CommRingCat.ofHom (PadicInt.lift (coneFamily_compat s))
  fac s j := CommRingCat.hom_ext <| by
    induction j with | op n => ?_
    exact (PadicInt.lift_spec (coneFamily_compat s) (n + 1)).trans (coneFamily_succ s n)
  uniq s m hm := CommRingCat.hom_ext <| by
    refine (PadicInt.lift_unique (coneFamily_compat s) m.hom fun k => ?_).symm
    rw [← PadicInt.zmod_cast_comp_toZModPow k (k + 1) (Nat.le_succ k)]
    exact congrArg (fun φ => (ZMod.castHom (pow_dvd_pow 2 (Nat.le_succ k)) (ZMod (2 ^ k))).comp φ)
      (congrArg CommRingCat.Hom.hom (hm (op k)))

/-- The limit of the tower is `ℤ_[2]`. -/
def limitIso : limit tower ≅ CommRingCat.of ℤ_[2] :=
  (limit.isLimit tower).conePointUniqueUpToIso padicConeIsLimit

@[simp]
theorem limitIso_hom_comp_ofHom_toZModPow (n : ℕ) :
    limitIso.hom ≫ CommRingCat.ofHom (PadicInt.toZModPow (n + 1)) = limit.π tower (op n) :=
  (limit.isLimit tower).conePointUniqueUpToIso_hom_comp padicConeIsLimit (op n)

/-- The ring isomorphism between the limit of the tower and `ℤ_[2]`. -/
def limitEquiv : (limit tower : CommRingCat.{0}) ≃+* ℤ_[2] :=
  limitIso.commRingCatIsoToRingEquiv

/-- `limitEquiv` is compatible with the legs of the limit and `PadicInt.toZModPow`. -/
theorem toZModPow_limitEquiv (n : ℕ) (a : (limit tower : CommRingCat.{0})) :
    PadicInt.toZModPow (n + 1) (limitEquiv a) = (limit.π tower (op n)).hom a :=
  congrArg (fun f => CommRingCat.Hom.hom f a) (limitIso_hom_comp_ofHom_toZModPow n)

theorem limit_π_hom_eq (n : ℕ) :
    (limit.π tower (op n)).hom =
      (PadicInt.toZModPow (n + 1)).comp (limitEquiv : (limit tower : CommRingCat.{0}) →+* ℤ_[2]) :=
  RingHom.ext fun a => (toZModPow_limitEquiv n a).symm

/-! ### Properties of the limit -/

/-- The limit of the tower is a domain, being isomorphic to `ℤ_[2]`. -/
instance isDomain_limit : IsDomain (limit tower : CommRingCat.{0}) :=
  MulEquiv.isDomain ℤ_[2] limitEquiv.toMulEquiv

/-- The limit of the tower is Noetherian, being isomorphic to `ℤ_[2]`. -/
instance isNoetherianRing_limit : IsNoetherianRing (limit tower : CommRingCat.{0}) :=
  isNoetherianRing_of_ringEquiv ℤ_[2] limitEquiv.symm

/-- The limit of the tower is local, being isomorphic to `ℤ_[2]`. -/
instance isLocalRing_limit : IsLocalRing (limit tower : CommRingCat.{0}) :=
  limitEquiv.symm.isLocalRing

/-- The element of the limit corresponding to `2 ∈ ℤ_[2]`. -/
def uniformizer : (limit tower : CommRingCat.{0}) :=
  limitEquiv.symm 2

theorem limitEquiv_uniformizer : limitEquiv uniformizer = 2 :=
  limitEquiv.apply_symm_apply 2

theorem uniformizer_ne_zero : uniformizer ≠ 0 :=
  (map_ne_zero_iff _ limitEquiv.symm.injective).mpr two_ne_zero

theorem not_isUnit_uniformizer : ¬ IsUnit uniformizer := fun h =>
  (PadicInt.prime_p (p := 2)).not_isUnit (by
    simpa [limitEquiv_uniformizer] using h.map limitEquiv)

theorem injective_uniformizer_pow : Function.Injective (fun i : ℕ => uniformizer ^ (i + 1)) := by
  intro i j hij
  have h := congrArg limitEquiv hij
  simp only [map_pow, limitEquiv_uniformizer] at h
  exact Nat.succ_injective (Nat.pow_right_injective (le_refl 2) (by exact_mod_cast h))

/-- The kernel of the leg of the limit at `ZMod (2 ^ (n + 1))` is generated by
`uniformizer ^ (n + 1)`. -/
theorem ker_limit_π (n : ℕ) :
    RingHom.ker (limit.π tower (op n)).hom = Ideal.span {uniformizer ^ (n + 1)} := by
  rw [limit_π_hom_eq, ← RingHom.comap_ker, PadicInt.ker_toZModPow]
  ext x
  simp only [Ideal.mem_comap, Ideal.mem_span_singleton, RingHom.coe_coe]
  rw [uniformizer, ← map_pow, ← map_dvd_iff limitEquiv, RingEquiv.apply_symm_apply,
    Nat.cast_ofNat]

/-- An element of the limit with a positive power vanishing in every ring of the tower is zero. -/
theorem eq_zero_of_forall_limit_π_pow_eq_zero (a : (limit tower : CommRingCat.{0})) {N : ℕ}
    (hN : 0 < N) (h : ∀ n, (limit.π tower (op n)).hom a ^ N = 0) : a = 0 := by
  have h0 : limitEquiv a ^ N = 0 := by
    refine PadicInt.ext_of_toZModPow.mp fun k => ?_
    cases k with
    | zero => exact Subsingleton.elim (α := ZMod 1) _ _
    | succ n => rw [map_pow, map_zero, toZModPow_limitEquiv, h n]
  exact (map_eq_zero_iff _ limitEquiv.injective).mp ((pow_eq_zero_iff hN.ne').mp h0)

end Stacks.Examples.TwoAdicTower

end
