module

public import Mathlib.Algebra.Field.ULift
public import Mathlib.RingTheory.QuasiFinite.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.EssentialFiniteness.Defs

/-!
# An essentially finite type local map with no quasi-finite quotients

The topology of a finite type ring map is not arbitrary: there is a local homomorphism of local
domains, with finite residue field extension and essentially of finite type, whose target has a
nonmaximal prime although no quotient of the target by a nonmaximal prime is a localization of a
quasi-finite algebra over the source.

The witness is the localization of `K[X]` at the ideal generated by `X`, over the field `K = ℚ`.
Its only nonmaximal prime is `(0)`, whose quotient is the fraction field `K(X)`; a localization of
a quasi-finite `K`-algebra is finite over `K`, hence integral, and an integral domain integral over
a field is a field whose spectrum is a point, which forces the prime to be the maximal ideal.

## Main results

* `Stacks.Examples.exists_localHom_no_quasiFinite_quotient`: such a local homomorphism exists.

## Implementation notes

As in the definition of essential finite type, a localization of a quasi-finite ring map is
expressed by an intermediate finite-type algebra, a submonoid, and an `IsLocalization` instance.
The separate finite-type condition is necessary because Mathlib's `Algebra.QuasiFinite` only
requires finite fibres. The existence of a nonmaximal prime in the target is recorded explicitly,
to rule out the vacuous case of a field target.

## References

* [Stacks Project, Tag 05JI](https://stacks.math.columbia.edu/tag/05JI)
-/

@[expose] public section

universe u

namespace Stacks.Examples

noncomputable section

private abbrev rationalBase : Type u := ULift.{u} ℚ

private instance instRationalBaseField : Field rationalBase := ULift.field

private instance (priority := 10000) instRationalBaseLocalRing : IsLocalRing rationalBase :=
  Field.instIsLocalRing rationalBase

private abbrev univariatePolynomial : Type u := Polynomial rationalBase

private def originIdeal : Ideal univariatePolynomial :=
  RingHom.ker (Polynomial.evalRingHom (0 : rationalBase))

private lemma originIdeal_isMaximal : (originIdeal).IsMaximal := by
  apply RingHom.ker_isMaximal_of_surjective
  intro x
  exact ⟨Polynomial.C x, by simp⟩

private instance : (originIdeal).IsPrime :=
  RingHom.ker_isPrime (Polynomial.evalRingHom (0 : rationalBase))

private abbrev localizedAtOrigin : Type u := Localization.AtPrime originIdeal

private lemma localizedAtOrigin_maximalIdeal_ne_bot :
    IsLocalRing.maximalIdeal localizedAtOrigin.{u} ≠ (⊥ : Ideal localizedAtOrigin.{u}) := by
  intro h
  have hx : (algebraMap univariatePolynomial.{u} localizedAtOrigin.{u} :
      univariatePolynomial.{u} →+* localizedAtOrigin.{u})
      (Polynomial.X.{u} : univariatePolynomial.{u}) ∈
      IsLocalRing.maximalIdeal localizedAtOrigin.{u} :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff localizedAtOrigin.{u} originIdeal.{u}
      Polynomial.X).2 (by simp [originIdeal])
  rw [h, Ideal.mem_bot] at hx
  exact Polynomial.X_ne_zero
    ((FaithfulSMul.algebraMap_injective univariatePolynomial.{u} localizedAtOrigin.{u})
      (by rw [map_zero]; exact hx))

private lemma residue_algebraMap_surjective :
    Function.Surjective
      (algebraMap rationalBase (IsLocalRing.ResidueField localizedAtOrigin)) := by
  intro z
  let : originIdeal.IsMaximal := originIdeal_isMaximal
  obtain ⟨r, rfl⟩ := originIdeal.algebraMap_residueField_surjective z
  refine ⟨Polynomial.eval 0 r, ?_⟩
  have hzero := (Ideal.algebraMap_residueField_eq_zero (I := originIdeal)).2
    (show r - Polynomial.C (Polynomial.eval 0 r) ∈ originIdeal by
      change Polynomial.evalRingHom 0 (r - Polynomial.C (Polynomial.eval 0 r)) = 0
      simp)
  rw [map_sub, sub_eq_zero] at hzero
  exact (IsScalarTower.algebraMap_apply rationalBase univariatePolynomial
    (IsLocalRing.ResidueField localizedAtOrigin) _).trans hzero.symm

/-- A local map of local domains, essentially of finite type with finite residue extension,
whose target has a nonmaximal prime but no quotient by such a prime is a localization of a
quasi-finite algebra. -/
@[stacks 05JI]
public theorem exists_localHom_no_quasiFinite_quotient :
    ∃ (A B : Type u) (_ : CommRing A) (_ : CommRing B)
      (_ : IsDomain A) (_ : IsDomain B) (_ : IsLocalRing A) (_ : IsLocalRing B)
      (f : A →+* B) (hf : IsLocalHom f),
      IsEssentiallyOfFiniteType A B f ∧
      (letI : IsLocalHom f := hf
       letI := (IsLocalRing.ResidueField.map f).toAlgebra
       Module.Finite (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)) ∧
      (∃ q : PrimeSpectrum B, q.asIdeal ≠ IsLocalRing.maximalIdeal B) ∧
      (∀ q : PrimeSpectrum B, q.asIdeal ≠ IsLocalRing.maximalIdeal B →
        ¬ (letI := f.toAlgebra
           ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C)
             (_ : Algebra.FiniteType A C) (_ : Algebra.QuasiFinite A C)
             (M : Submonoid C) (_ : Algebra C (B ⧸ q.asIdeal)),
             IsScalarTower A C (B ⧸ q.asIdeal) ∧ IsLocalization M (B ⧸ q.asIdeal))) := by
  let f : rationalBase →+* localizedAtOrigin := algebraMap rationalBase localizedAtOrigin
  have hlocal : IsLocalHom f :=
    ⟨fun a ha => isUnit_iff_ne_zero.mpr fun h => by simp [h] at ha⟩
  refine ⟨rationalBase, localizedAtOrigin, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, f, hlocal, ?_, ?_, ?_, ?_⟩
  · change IsEssentiallyOfFiniteType rationalBase localizedAtOrigin f
    unfold IsEssentiallyOfFiniteType
    let := f.toAlgebra
    let : Algebra rationalBase univariatePolynomial := inferInstance
    let : Algebra univariatePolynomial localizedAtOrigin := inferInstance
    let : Algebra rationalBase localizedAtOrigin := f.toAlgebra
    let : SMul rationalBase univariatePolynomial :=
      (inferInstance : Algebra rationalBase univariatePolynomial).toSMul
    let : SMul rationalBase localizedAtOrigin :=
      (inferInstance : Algebra rationalBase localizedAtOrigin).toSMul
    have htr : IsScalarTower rationalBase univariatePolynomial localizedAtOrigin :=
      IsScalarTower.of_algebraMap_eq
      (R := rationalBase) (S := univariatePolynomial) (A := localizedAtOrigin) (by
        intro x
        cases x with
        | up x => rfl)
    exact ⟨univariatePolynomial, inferInstance, inferInstance, inferInstance,
      originIdeal.primeCompl, inferInstance, ⟨htr, inferInstance⟩⟩
  · let : IsLocalHom f := hlocal
    let := (IsLocalRing.ResidueField.map f).toAlgebra
    have hsurj : Function.Surjective (IsLocalRing.ResidueField.map f) := by
      intro z
      obtain ⟨k, hk⟩ := residue_algebraMap_surjective z
      refine ⟨IsLocalRing.residue rationalBase k, ?_⟩
      rw [IsLocalRing.ResidueField.map_residue]
      let := f.toAlgebra
      calc
        IsLocalRing.residue localizedAtOrigin (f k) =
            algebraMap localizedAtOrigin (IsLocalRing.ResidueField localizedAtOrigin) (f k) := rfl
        _ = algebraMap rationalBase (IsLocalRing.ResidueField localizedAtOrigin) k := by
          symm
          exact IsScalarTower.algebraMap_apply rationalBase localizedAtOrigin
            (IsLocalRing.ResidueField localizedAtOrigin) k
        _ = z := hk
    exact RingHom.Finite.of_surjective _ hsurj
  · refine ⟨⟨⊥, inferInstance⟩, ?_⟩
    exact Ne.symm localizedAtOrigin_maximalIdeal_ne_bot
  · intro q hq
    let := f.toAlgebra
    rintro ⟨C, hC, hAC, hft, hqf, M, hCB, htower, hloc⟩
    let : CommRing C := hC
    let : Algebra rationalBase C := hAC
    let : Algebra.FiniteType rationalBase C := hft
    let : Algebra.QuasiFinite rationalBase C := hqf
    let : Algebra C (localizedAtOrigin ⧸ q.asIdeal) := hCB
    let : IsLocalization M (localizedAtOrigin ⧸ q.asIdeal) := hloc
    let := htower
    let : Module rationalBase (localizedAtOrigin ⧸ q.asIdeal) := Algebra.toModule
    let : Algebra.QuasiFinite rationalBase (localizedAtOrigin ⧸ q.asIdeal) :=
      Algebra.QuasiFinite.of_isLocalization M
    let : Module.Finite rationalBase (localizedAtOrigin ⧸ q.asIdeal) :=
      Module.Finite.of_quasiFinite
    let : Algebra.IsIntegral rationalBase (localizedAtOrigin ⧸ q.asIdeal) :=
      Algebra.IsIntegral.of_finite rationalBase _
    exact hq (IsLocalRing.eq_maximalIdeal
      ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mpr
        (isField_of_isIntegral_of_isField' (R := rationalBase)
          (S := localizedAtOrigin ⧸ q.asIdeal)
          (Field.toIsField rationalBase))))

end

end Stacks.Examples

end
