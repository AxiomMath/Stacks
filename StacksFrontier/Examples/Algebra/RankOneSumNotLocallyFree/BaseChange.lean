/-!
# Base change of the ideals of the point, and finite pieces of a direct sum

Let `B` be an algebra over `torus σ`. For `k ∈ σ`, the base change `B ⊗ pointIdeal k` is computed
in two situations.

* If `u_k ↦ 1` and `v_k ↦ 0` in `B`, then `B ⊗ pointIdeal k` is free of rank one, generated by
  `1 ⊗ v_k`. Indeed `u_k - 1 = -½ ((u_k - 1)² + v_k²)` lies in `(pointIdeal k)²`, so that
  `b ⊗ (u_k - 1) = 0`, and the surjection `B → B ⊗ pointIdeal k`, `b ↦ b ⊗ v_k`, between
  invertible modules is bijective.
* If `B = torus τ` with `u_k ↦ u_j` and `v_k ↦ v_j`, then multiplication
  `B ⊗ pointIdeal k → pointIdeal j` is a surjection between invertible modules, hence bijective.

We also introduce, for the direct sum `⨁ k, L k` of a sequence of modules, the projection onto
the product `∏_{i < N} L i` of the first `N` summands and the inclusion back, which fix every
element of the base change `A ⊗ ⨁ k, L k` for `N` large. Consequently, given a basis of
`A ⊗ ⨁ k, L k` and finitely many of its vectors, `A ⊗ ∏_{i < N} L i` has a free direct summand
of the same rank for `N` large.

Finally, `windowMap n r : torus ℕ → torus (Fin r)` sends the coordinates `n, …, n + r - 1` to the
coordinates of `torus (Fin r)` and evaluates all the others at the point `(1, 0)`. Every element
of `torus ℕ` depends on finitely many coordinates, so `windowMap n r x` is the value of `x` at the
point `((1, 0), (1, 0), …)` for `n` large.

## Main definitions

* `Stacks.Examples.CircleTorus.tensorPointEquivSelf`: `B ⊗ pointIdeal k ≃ B` when `u_k ↦ 1`,
  `v_k ↦ 0`.
* `Stacks.Examples.CircleTorus.tensorPointEquiv`: `torus τ ⊗ pointIdeal k ≃ pointIdeal j` when
  `u_k ↦ u_j`, `v_k ↦ v_j`.
* `Stacks.Examples.CircleTorus.truncate`, `Stacks.Examples.CircleTorus.extend`: the projection of
  `⨁ k, L k` onto its first `N` summands and the inclusion back.
* `Stacks.Examples.CircleTorus.windowMap`: the map `torus ℕ → torus (Fin r)`.

## Main results

* `Stacks.Examples.CircleTorus.exists_linearEquiv_pi_prod`: a free direct summand of rank `c`
  of `A ⊗ ∏_{i < N} L i` coming from `c` vectors of a basis of `A ⊗ ⨁ k, L k`.
* `Stacks.Examples.CircleTorus.exists_windowMap_eq`: `windowMap n r x` is the value of `x` at the
  point, for `n` large.

## References

* [Stacks Project, Tag 05WL](https://stacks.math.columbia.edu/tag/05WL)
-/

@[expose] public section

open scoped TensorProduct

namespace Stacks.Examples.CircleTorus

/-! ### The point ideal over an algebra where the point is evaluated -/

section Evaluated

variable {σ : Type} {B : Type*} [CommRing B] [Algebra (torus σ) B]

/-- The map `B → B ⊗ pointIdeal k`, `b ↦ b ⊗ v_k`. -/
noncomputable def tensorPointGen (k : σ) : B →ₗ[B] B ⊗[torus σ] ↥(pointIdeal k) :=
  LinearMap.toSpanSingleton B _ ((1 : B) ⊗ₜ (⟨v k, v_mem_pointIdeal k⟩ : ↥(pointIdeal k)))

/-- If `u_k ↦ 1` and `v_k ↦ 0` in `B`, then `B ⊗ pointIdeal k` is generated by `1 ⊗ v_k`. -/
theorem surjective_tensorPointGen {k : σ} (hu : algebraMap (torus σ) B (u k) = 1)
    (hv : algebraMap (torus σ) B (v k) = 0) : Function.Surjective (tensorPointGen (B := B) k) := by
  intro z
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | tmul b x =>
    obtain ⟨a, c, hac⟩ := Ideal.mem_span_pair.mp
      (show (x : torus σ) ∈ Ideal.span {u k - 1, v k} from x.2)
    obtain ⟨h, hh⟩ : ∃ h : torus σ, h + h = 1 :=
      ⟨algebraMap ℚ (torus σ) (1 / 2), by rw [← map_add, add_halves, map_one]⟩
    have hx : (-(h * a * (u k - 1))) • (⟨u k - 1, u_sub_one_mem_pointIdeal k⟩ : ↥(pointIdeal k)) +
        (c - h * a * v k) • (⟨v k, v_mem_pointIdeal k⟩ : ↥(pointIdeal k)) = x := by
      apply Subtype.ext
      simp only [Submodule.coe_add, Submodule.coe_smul, smul_eq_mul]
      rw [← hac]
      linear_combination (-(h * a)) * u_sq_add_v_sq k + (a * (u k - 1)) * hh
    have h0 : algebraMap (torus σ) B (-(h * a * (u k - 1))) = 0 := by
      rw [map_neg, map_mul, map_sub, hu, map_one, sub_self, mul_zero, neg_zero]
    have h1 : algebraMap (torus σ) B (c - h * a * v k) = algebraMap (torus σ) B c := by
      rw [map_sub, map_mul, hv, mul_zero, sub_zero]
    refine ⟨algebraMap (torus σ) B c * b, ?_⟩
    rw [← hx, TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul,
      Algebra.smul_def, Algebra.smul_def, h0, h1, zero_mul, TensorProduct.zero_tmul, zero_add,
      tensorPointGen, LinearMap.toSpanSingleton_apply, TensorProduct.smul_tmul', smul_eq_mul,
      mul_one]
  | add z₁ z₂ h₁ h₂ =>
    obtain ⟨y₁, rfl⟩ := h₁
    obtain ⟨y₂, rfl⟩ := h₂
    exact ⟨y₁ + y₂, map_add _ _ _⟩

/-- **The ideal of the point becomes free where the point is evaluated.** If `u_k ↦ 1` and
`v_k ↦ 0` in `B`, then `B ⊗ pointIdeal k ≃ B`, the inverse sending `b` to `b ⊗ v_k`. -/
noncomputable def tensorPointEquivSelf (k : σ) (hu : algebraMap (torus σ) B (u k) = 1)
    (hv : algebraMap (torus σ) B (v k) = 0) : B ⊗[torus σ] ↥(pointIdeal k) ≃ₗ[B] B :=
  (LinearEquiv.ofBijective (tensorPointGen k)
    (Module.Invertible.bijective_of_surjective (surjective_tensorPointGen hu hv))).symm

end Evaluated

/-! ### The point ideal over a torus where the coordinate is kept -/

section Kept

variable {σ τ : Type} [Algebra (torus σ) (torus τ)]

/-- If `u_k ↦ u_j` and `v_k ↦ v_j`, then `pointIdeal k` maps into `pointIdeal j`. -/
theorem algebraMap_mem_pointIdeal {k : σ} {j : τ}
    (hu : algebraMap (torus σ) (torus τ) (u k) = u j)
    (hv : algebraMap (torus σ) (torus τ) (v k) = v j) (x : ↥(pointIdeal k)) :
    algebraMap (torus σ) (torus τ) x ∈ pointIdeal j := by
  obtain ⟨a, c, hac⟩ := Ideal.mem_span_pair.mp
    (show (x : torus σ) ∈ Ideal.span {u k - 1, v k} from x.2)
  rw [← hac, map_add, map_mul, map_mul, map_sub, map_one, hu, hv]
  exact Ideal.mem_span_pair.mpr ⟨_, _, rfl⟩

/-- The multiplication map `torus τ ⊗ pointIdeal k → pointIdeal j`, `b ⊗ x ↦ b x`, when
`u_k ↦ u_j` and `v_k ↦ v_j`. -/
noncomputable def tensorPointMap {k : σ} {j : τ}
    (hu : algebraMap (torus σ) (torus τ) (u k) = u j)
    (hv : algebraMap (torus σ) (torus τ) (v k) = v j) :
    torus τ ⊗[torus σ] ↥(pointIdeal k) →ₗ[torus τ] ↥(pointIdeal j) :=
  LinearMap.codRestrict (pointIdeal j)
    (((Algebra.linearMap (torus σ) (torus τ)).comp (pointIdeal k).subtype).liftBaseChange
      (torus τ))
    (fun z => by
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | tmul b x =>
        rw [LinearMap.liftBaseChange_tmul]
        exact Submodule.smul_mem _ b (algebraMap_mem_pointIdeal hu hv x)
      | add z₁ z₂ h₁ h₂ => rw [map_add]; exact Submodule.add_mem _ h₁ h₂)

/-- `tensorPointMap` sends `b ⊗ x` to `b x`. -/
theorem coe_tensorPointMap_tmul {k : σ} {j : τ}
    (hu : algebraMap (torus σ) (torus τ) (u k) = u j)
    (hv : algebraMap (torus σ) (torus τ) (v k) = v j) (b : torus τ) (x : ↥(pointIdeal k)) :
    (tensorPointMap hu hv (b ⊗ₜ x) : torus τ) = b * algebraMap (torus σ) (torus τ) x :=
  rfl

/-- The multiplication map `torus τ ⊗ pointIdeal k → pointIdeal j` is surjective: its image
contains the generators `u_j - 1` and `v_j`. -/
theorem surjective_tensorPointMap {k : σ} {j : τ}
    (hu : algebraMap (torus σ) (torus τ) (u k) = u j)
    (hv : algebraMap (torus σ) (torus τ) (v k) = v j) :
    Function.Surjective (tensorPointMap hu hv) := by
  intro y
  obtain ⟨a, c, hac⟩ := Ideal.mem_span_pair.mp
    (show (y : torus τ) ∈ Ideal.span {u j - 1, v j} from y.2)
  refine ⟨a ⊗ₜ (⟨u k - 1, u_sub_one_mem_pointIdeal k⟩ : ↥(pointIdeal k)) +
    c ⊗ₜ (⟨v k, v_mem_pointIdeal k⟩ : ↥(pointIdeal k)), Subtype.ext ?_⟩
  rw [map_add, Submodule.coe_add, coe_tensorPointMap_tmul, coe_tensorPointMap_tmul, ← hac]
  change a * algebraMap (torus σ) (torus τ) (u k - 1) + c * algebraMap (torus σ) (torus τ) (v k) =
    a * (u j - 1) + c * v j
  rw [map_sub, map_one, hu, hv]

/-- **The ideal of the point is preserved where the coordinate is kept.** If `u_k ↦ u_j` and
`v_k ↦ v_j`, then `torus τ ⊗ pointIdeal k ≃ pointIdeal j` by multiplication. -/
noncomputable def tensorPointEquiv {k : σ} {j : τ}
    (hu : algebraMap (torus σ) (torus τ) (u k) = u j)
    (hv : algebraMap (torus σ) (torus τ) (v k) = v j) :
    torus τ ⊗[torus σ] ↥(pointIdeal k) ≃ₗ[torus τ] ↥(pointIdeal j) :=
  LinearEquiv.ofBijective (tensorPointMap hu hv)
    (Module.Invertible.bijective_of_surjective (surjective_tensorPointMap hu hv))

end Kept

/-! ### Finite pieces of a direct sum -/

section Truncation

variable (R : Type*) [CommRing R] (L : ℕ → Type*) [∀ k, AddCommGroup (L k)] [∀ k, Module R (L k)]

/-- The projection of `⨁ k, L k` onto the product of its first `N` summands. -/
noncomputable def truncate (N : ℕ) : DirectSum ℕ L →ₗ[R] ((i : Fin N) → L i) :=
  LinearMap.pi fun i => DirectSum.component R ℕ L i

/-- The inclusion of the product of the first `N` summands into `⨁ k, L k`. -/
noncomputable def extend (N : ℕ) : ((i : Fin N) → L i) →ₗ[R] DirectSum ℕ L :=
  ∑ i : Fin N, (DirectSum.lof R ℕ L i).comp (LinearMap.proj i)

/-- The `k`-th component of `extend R L N y` is `y k` for `k < N` and `0` otherwise. -/
theorem component_extend (N k : ℕ) (y : (i : Fin N) → L i) :
    DirectSum.component R ℕ L k (extend R L N y) = if h : k < N then y ⟨k, h⟩ else 0 := by
  rw [extend, LinearMap.sum_apply, map_sum]
  simp only [LinearMap.comp_apply, LinearMap.proj_apply]
  split_ifs with h
  · rw [Finset.sum_eq_single (⟨k, h⟩ : Fin N)]
    · exact DirectSum.component.lof_self R _ _
    · intro i _ hi
      rw [DirectSum.component.of, dite_eq_right]
      intro hik
      exact hi (Fin.ext hik)
    · intro hk
      exact absurd (Finset.mem_univ _) hk
  · refine Finset.sum_eq_zero fun i _ => ?_
    rw [DirectSum.component.of, dite_eq_right]
    intro hik
    exact h (lt_of_eq_of_lt hik.symm i.2)

/-- An element of `⨁ k, L k` whose components vanish from `N` on is fixed by
`extend ∘ truncate`. -/
theorem extend_truncate (N : ℕ) (x : DirectSum ℕ L)
    (hx : ∀ k, N ≤ k → DirectSum.component R ℕ L k x = 0) :
    extend R L N (truncate R L N x) = x := by
  refine DirectSum.ext_component R fun k => ?_
  rw [component_extend]
  split_ifs with h
  · rw [truncate, LinearMap.pi_apply]
  · exact (hx k (not_lt.mp h)).symm

/-- Every element of `⨁ k, L k` is fixed by `extend ∘ truncate` in all large degrees. -/
theorem exists_extend_truncate (x : DirectSum ℕ L) :
    ∃ N₀, ∀ N, N₀ ≤ N → extend R L N (truncate R L N x) = x := by
  classical
  obtain ⟨N₀, hN₀⟩ := Finset.exists_nat_subset_range (DFinsupp.support (x : Π₀ k, L k))
  refine ⟨N₀, fun N hN => extend_truncate R L N x fun k hk => ?_⟩
  have hk' : k ∉ DFinsupp.support (x : Π₀ k, L k) := fun hmem => by
    have := Finset.mem_range.mp (hN₀ hmem)
    omega
  exact DFinsupp.notMem_support_iff.mp hk'

/-- The projection onto the first `N` summands kills the summands of index at least `N`. -/
theorem truncate_lof_of_le (N k : ℕ) (hk : N ≤ k) (y : L k) :
    truncate R L N (DirectSum.lof R ℕ L k y) = 0 := by
  funext i
  rw [truncate, LinearMap.pi_apply, DirectSum.component.of, dite_eq_right, Pi.zero_apply]
  intro h
  have := i.2
  omega

/-- Every element of `A ⊗ ⨁ k, L k` is fixed by the base change of `extend ∘ truncate` in all
large degrees. -/
theorem exists_baseChange_extend_truncate (A : Type*) [CommRing A] [Algebra R A]
    (z : A ⊗[R] DirectSum ℕ L) :
    ∃ N₀, ∀ N, N₀ ≤ N → (extend R L N).baseChange A ((truncate R L N).baseChange A z) = z := by
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, fun N _ => by rw [map_zero, map_zero]⟩
  | tmul a x =>
    obtain ⟨N₀, h⟩ := exists_extend_truncate R L x
    exact ⟨N₀, fun N hN => by
      rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul, h N hN]⟩
  | add z₁ z₂ h₁ h₂ =>
    obtain ⟨N₁, h₁⟩ := h₁
    obtain ⟨N₂, h₂⟩ := h₂
    exact ⟨max N₁ N₂, fun N hN => by
      rw [map_add, map_add, h₁ N (le_of_max_le_left hN), h₂ N (le_of_max_le_right hN)]⟩

/-- **A free summand in a finite piece.** Let `b` be a basis of `A ⊗ ⨁ k, L k` and `e` an
injective family of `c` of its indices. For `N` large, `A ⊗ ∏_{i < N} L i` is isomorphic to
`A ^ c × P` for a finite `A`-module `P`. -/
theorem exists_linearEquiv_pi_prod {A κ : Type*} [CommRing A] [Algebra R A]
    [∀ k, Module.Finite R (L k)] (b : Module.Basis κ A (A ⊗[R] DirectSum ℕ L))
    {c : ℕ}
    (e : Fin c → κ) (he : Function.Injective e) :
    ∃ N₀, ∀ N, N₀ ≤ N → ∃ P : Submodule A (A ⊗[R] ((i : Fin N) → L i)),
      Module.Finite A P ∧ Nonempty ((A ⊗[R] ((i : Fin N) → L i)) ≃ₗ[A] (Fin c → A) × P) := by
  classical
  choose N' hN' using fun j : Fin c => exists_baseChange_extend_truncate R L A (b (e j))
  refine ⟨Finset.univ.sup N', fun N hN => ?_⟩
  have hfix : ∀ j, (extend R L N).baseChange A ((truncate R L N).baseChange A (b (e j))) =
      b (e j) := fun j => hN' j N ((Finset.le_sup (Finset.mem_univ j)).trans hN)
  let s : (Fin c → A) →ₗ[A] A ⊗[R] ((i : Fin N) → L i) :=
    ∑ j : Fin c, (LinearMap.proj j : (Fin c → A) →ₗ[A] A).smulRight
      ((truncate R L N).baseChange A (b (e j)))
  let t : (A ⊗[R] ((i : Fin N) → L i)) →ₗ[A] (Fin c → A) :=
    LinearMap.pi fun j => (b.coord (e j)).comp ((extend R L N).baseChange A)
  have hts : t ∘ₗ s = LinearMap.id := by
    refine LinearMap.ext fun a => funext fun j => ?_
    simp only [t, s, LinearMap.comp_apply, LinearMap.pi_apply, LinearMap.sum_apply,
      LinearMap.smulRight_apply, LinearMap.proj_apply, map_sum, map_smul, hfix,
      Module.Basis.coord_apply, Module.Basis.repr_self, LinearMap.id_apply]
    rw [Finset.sum_eq_single j]
    · rw [Finsupp.single_apply, ite_eq_left rfl, smul_eq_mul, mul_one]
    · intro i _ hij
      rw [Finsupp.single_apply, ite_eq_right (fun h => hij (he h)), smul_zero]
    · intro hj
      exact absurd (Finset.mem_univ j) hj
  let ex := (LinearMap.exact_subtype_ker_map t).splitSurjectiveEquiv
    (Submodule.injective_subtype _) ⟨s, hts⟩
  refine ⟨LinearMap.ker t, ?_, ⟨ex.1 ≪≫ₗ LinearEquiv.prodComm A _ _⟩⟩
  refine Module.Finite.of_surjective ((LinearMap.fst A _ _).comp ex.1.toLinearMap)
    fun p => ⟨ex.1.symm (p, 0), ?_⟩
  rw [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply, LinearMap.fst_apply]

end Truncation

/-! ### The sum of the ideals of the point over `torus ℕ` -/

/-- The ideal of the point in the `k`-th coordinate of `torus ℕ`, as a module. -/
abbrev pointFam (k : ℕ) : Type := ↥(pointIdeal (σ := ℕ) k)

/-- The direct sum `⨁ k, pointIdeal k` over `torus ℕ`. -/
abbrev pointSum : Type := DirectSum ℕ pointFam

/-- The product of the first `N` ideals of the point, over `torus ℕ`. -/
abbrev pointPi (N : ℕ) : Type := (i : Fin N) → pointFam (i : ℕ)

/-! ### Evaluation outside a window of coordinates -/

section Window

/-- Evaluation at the point sends `u_k` to `1`. -/
theorem evalAll_u {σ : Type} (k : σ) : evalAll σ (u k) = 1 := by
  rw [evalAll, AlgHom.comp_apply, evalAt_u_of_mem (Set.mem_univ k), map_one]

/-- Evaluation at the point sends `v_k` to `0`. -/
theorem evalAll_v {σ : Type} (k : σ) : evalAll σ (v k) = 0 := by
  rw [evalAll, AlgHom.comp_apply, evalAt_v_of_mem (Set.mem_univ k), map_zero]

/-- The torus is a nonzero ring: it has a ring map to `ℚ`. -/
theorem nontrivial_torus (τ : Type) : Nontrivial (torus τ) :=
  (evalAll τ).toRingHom.domain_nontrivial

/-- The map `torus ℕ → torus (Fin r)` sending the coordinates `n + t`, `t < r`, to the coordinates
`t` and evaluating all other coordinates at the point `(1, 0)`. -/
noncomputable def windowMap (n r : ℕ) : torus ℕ →ₐ[ℚ] torus (Fin r) :=
  lift (fun k => if h : n ≤ k ∧ k < n + r then u ⟨k - n, Nat.sub_lt_left_of_lt_add h.1 h.2⟩
      else 1)
    (fun k => if h : n ≤ k ∧ k < n + r then v ⟨k - n, Nat.sub_lt_left_of_lt_add h.1 h.2⟩
      else 0)
    (fun k => by
      by_cases h : n ≤ k ∧ k < n + r
      · simp only [dite_eq_left h]
        exact u_sq_add_v_sq _
      · simp only [dite_eq_right h]
        ring)

/-- Outside the window, `windowMap` sends `u_k` to `1`. -/
theorem windowMap_u_of_notMem (n r k : ℕ) (h : ¬(n ≤ k ∧ k < n + r)) :
    windowMap n r (u k) = 1 := by
  simp only [windowMap, lift_u, dite_eq_right h]

/-- Outside the window, `windowMap` sends `v_k` to `0`. -/
theorem windowMap_v_of_notMem (n r k : ℕ) (h : ¬(n ≤ k ∧ k < n + r)) :
    windowMap n r (v k) = 0 := by
  simp only [windowMap, lift_v, dite_eq_right h]

/-- Inside the window, `windowMap` sends `u_k` to `u_{k - n}`. -/
theorem windowMap_u_of_mem (n r k : ℕ) (h : n ≤ k ∧ k < n + r) :
    windowMap n r (u k) = u ⟨k - n, Nat.sub_lt_left_of_lt_add h.1 h.2⟩ := by
  simp only [windowMap, lift_u, dite_eq_left h]

/-- Inside the window, `windowMap` sends `v_k` to `v_{k - n}`. -/
theorem windowMap_v_of_mem (n r k : ℕ) (h : n ≤ k ∧ k < n + r) :
    windowMap n r (v k) = v ⟨k - n, Nat.sub_lt_left_of_lt_add h.1 h.2⟩ := by
  simp only [windowMap, lift_v, dite_eq_left h]

/-- `windowMap n r` sends `u_{n + t}` to `u_t`. -/
theorem windowMap_u_add (n r : ℕ) (t : Fin r) : windowMap n r (u (n + (t : ℕ))) = u t := by
  rw [windowMap_u_of_mem n r (n + t) ⟨Nat.le_add_right n t, Nat.add_lt_add_left t.2 n⟩]
  exact congrArg u (Fin.ext (Nat.add_sub_cancel_left n (t : ℕ)))

/-- `windowMap n r` sends `v_{n + t}` to `v_t`. -/
theorem windowMap_v_add (n r : ℕ) (t : Fin r) : windowMap n r (v (n + (t : ℕ))) = v t := by
  rw [windowMap_v_of_mem n r (n + t) ⟨Nat.le_add_right n t, Nat.add_lt_add_left t.2 n⟩]
  exact congrArg v (Fin.ext (Nat.add_sub_cancel_left n (t : ℕ)))

/-- The value at the point `((1, 0), (1, 0), …)`, as an element of `torus (Fin r)`. -/
noncomputable def evalComparison (r : ℕ) : torus ℕ →ₐ[ℚ] torus (Fin r) :=
  (Algebra.ofId ℚ (torus (Fin r))).comp (evalAll ℕ)

/-- `evalComparison r` sends `u_k` to `1`. -/
theorem evalComparison_u (r k : ℕ) : evalComparison r (u k) = 1 := by
  rw [evalComparison, AlgHom.comp_apply, evalAll_u, map_one]

/-- `evalComparison r` sends `v_k` to `0`. -/
theorem evalComparison_v (r k : ℕ) : evalComparison r (v k) = 0 := by
  rw [evalComparison, AlgHom.comp_apply, evalAll_v, map_zero]

/-- **Every element of `torus ℕ` depends on finitely many coordinates**: for `n` large,
`windowMap n r x` is the value of `x` at the point `((1, 0), (1, 0), …)`. -/
theorem exists_windowMap_eq (x : torus ℕ) :
    ∃ n, ∀ n' r, n ≤ n' → windowMap n' r x = evalComparison r x := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective ℚ (relIdeal ℕ) x
  induction p using MvPolynomial.induction_on with
  | C a =>
    refine ⟨0, fun n' r _ => ?_⟩
    change ((windowMap n' r).comp (Ideal.Quotient.mkₐ ℚ (relIdeal ℕ))) (MvPolynomial.C a) =
      ((evalComparison r).comp (Ideal.Quotient.mkₐ ℚ (relIdeal ℕ))) (MvPolynomial.C a)
    rw [MvPolynomial.algHom_C, MvPolynomial.algHom_C]
  | add p q hp hq =>
    obtain ⟨n₁, h₁⟩ := hp
    obtain ⟨n₂, h₂⟩ := hq
    refine ⟨max n₁ n₂, fun n' r hn' => ?_⟩
    rw [map_add, map_add, map_add, h₁ n' r (le_of_max_le_left hn'),
      h₂ n' r (le_of_max_le_right hn')]
  | mul_X p kj hp =>
    obtain ⟨n₁, h₁⟩ := hp
    obtain ⟨k, j⟩ := kj
    refine ⟨max n₁ (k + 1), fun n' r hn' => ?_⟩
    have hk : ¬(n' ≤ k ∧ k < n' + r) := fun h => by
      have := le_of_max_le_right hn'
      have := h.1
      omega
    rw [map_mul, map_mul, map_mul, h₁ n' r (le_of_max_le_left hn')]
    congr 1
    fin_cases j
    · change windowMap n' r (u k) = evalComparison r (u k)
      rw [windowMap_u_of_notMem n' r k hk, evalComparison_u]
    · change windowMap n' r (v k) = evalComparison r (v k)
      rw [windowMap_v_of_notMem n' r k hk, evalComparison_v]

end Window

end Stacks.Examples.CircleTorus
