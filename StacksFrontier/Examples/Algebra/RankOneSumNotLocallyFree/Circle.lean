/-!
# Products of circles and the ideal of a rational point

Let `A = ℚ[u, v]/(u² + v² - 1)` be the coordinate ring of the circle over `ℚ`. For a type `σ`
the ring `torus σ` is the coordinate ring of the product of copies of the circle indexed by `σ`,
that is `ℚ[u_i, v_i : i ∈ σ]/(u_i² + v_i² - 1 : i ∈ σ)`. For `i ∈ σ` the ideal
`pointIdeal i = (u_i - 1, v_i)` cuts out the rational point `(1, 0)` in the `i`-th factor. Since
`v_i² = -(u_i - 1)(u_i + 1)` and `(u_i + 1) - (u_i - 1) = 2` is a unit, its square is the principal
ideal `(u_i - 1)`, and `u_i - 1` is a nonzerodivisor; hence `pointIdeal i` is an invertible
module, that is, finite locally free of rank one.

Evaluating the coordinates indexed by a subset `S ⊆ σ` at the point `(1, 0)` is a surjection
`torus σ → torus (σ ∖ S)` whose kernel is `∑_{j ∈ S} pointIdeal j`. Consequently, for `i ∉ S`,
the multiplication map `pointIdeal i ⊗ torus σ / (∑_{j ∈ S} pointIdeal j) → torus σ / (…)` is
injective.

## Main definitions

* `Stacks.Examples.CircleTorus.torus`: the ring `ℚ[u_i, v_i]/(u_i² + v_i² - 1)`.
* `Stacks.Examples.CircleTorus.u`, `Stacks.Examples.CircleTorus.v`: its coordinates.
* `Stacks.Examples.CircleTorus.lift`: the universal property of `torus σ`.
* `Stacks.Examples.CircleTorus.torusMap`: the map induced by a map of index types.
* `Stacks.Examples.CircleTorus.pointIdeal`: the ideal `(u_i - 1, v_i)`.
* `Stacks.Examples.CircleTorus.evalAt`: evaluation of the coordinates in `S` at `(1, 0)`.
* `Stacks.Examples.CircleTorus.torusEquivOfIsEmpty`, `Stacks.Examples.CircleTorus.evalAll`: the
  torus over an empty index type is `ℚ`, and evaluation of all coordinates at `(1, 0)`.

## Main results

* `Stacks.Examples.CircleTorus.u_sub_one_mem_nonZeroDivisors`: `u_i - 1` is a nonzerodivisor.
* `Stacks.Examples.CircleTorus.pointIdeal_mul_self`: `pointIdeal i * pointIdeal i = (u_i - 1)`.
* `Stacks.Examples.CircleTorus.invertible_pointIdeal`,
  `Stacks.Examples.CircleTorus.isFiniteLocallyFreeOfRank_pointIdeal`: `pointIdeal i` is
  invertible, i.e. finite locally free of rank one.
* `Stacks.Examples.CircleTorus.evalAt_surjective`, `Stacks.Examples.CircleTorus.ker_evalAt`:
  `evalAt S` is surjective with kernel `⨆ j ∈ S, pointIdeal j`.
* `Stacks.Examples.CircleTorus.injective_pointIdeal_tensor_quotient`: for `i ∉ S` the
  multiplication map `pointIdeal i ⊗ (torus σ ⧸ ⨆ j ∈ S, pointIdeal j) → torus σ ⧸ …` is
  injective.

## Implementation notes

That `u_i - 1` is a nonzerodivisor is proved by writing `torus σ` as a retract of
`T[x][y]/(y² + x² - 1)`, where `T` is the torus on the remaining coordinates: the latter is free
over `T[x]` with basis `1, y`, and `x - 1` is monic, hence a nonzerodivisor in `T[x]`.

Invertibility of an ideal `I` with `I * J = (a)` for a nonzerodivisor `a` is obtained by
realizing `I` as a unit of the monoid of `R`-submodules of `R[1/a]`.

## References

* [Stacks Project, Tag 05WL](https://stacks.math.columbia.edu/tag/05WL)
-/

@[expose] public section

open scoped TensorProduct

namespace Stacks.Examples.CircleTorus

section General

/-- **An ideal dividing a principal ideal generated by a nonzerodivisor is invertible.** If
`I * J = (a)` with `a` a nonzerodivisor, then `I` is an invertible `R`-module: in `R[1/a]` the
submodule `I` has inverse `a⁻¹ J`. -/
theorem invertible_of_mul_eq_span_singleton {R : Type*} [CommRing R] (I J : Ideal R) {a : R}
    (ha : a ∈ nonZeroDivisors R) (h : I * J = Ideal.span {a}) : Module.Invertible R I := by
  have hinj : Function.Injective (algebraMap R (Localization.Away a)) :=
    IsLocalization.injective (Localization.Away a) (Submonoid.powers_le.mpr ha)
  have : FaithfulSMul R (Localization.Away a) :=
    (faithfulSMul_iff_algebraMap_injective R (Localization.Away a)).mpr hinj
  let f : R →ₐ[R] Localization.Away a := Algebra.ofId R (Localization.Away a)
  let b : Localization.Away a := IsLocalization.Away.invSelf (S := Localization.Away a) a
  have hab : algebraMap R (Localization.Away a) a * b = 1 := IsLocalization.Away.mul_invSelf a
  let I' : Submodule R (Localization.Away a) := Submodule.map f.toLinearMap I
  let J' : Submodule R (Localization.Away a) :=
    Submodule.span R {b} * Submodule.map f.toLinearMap J
  have h1 : I' * Submodule.map f.toLinearMap J =
      Submodule.span R {algebraMap R (Localization.Away a) a} := by
    rw [show I' * Submodule.map f.toLinearMap J = Submodule.map f.toLinearMap (I * J) from
      (Submodule.map_mul I J f).symm, h, ← Ideal.submodule_span_eq, Submodule.map_span,
      Set.image_singleton]
    rfl
  have hIJ : I' * J' = 1 := by
    calc I' * J' = Submodule.span R {b} * (I' * Submodule.map f.toLinearMap J) :=
          mul_left_comm _ _ _
      _ = 1 := by
          rw [h1, Submodule.span_mul_span, Set.singleton_mul_singleton, mul_comm b, hab,
            ← Submodule.one_eq_span]
  let U : (Submodule R (Localization.Away a))ˣ := ⟨I', J', hIJ, by rw [mul_comm]; exact hIJ⟩
  let e : I ≃ₗ[R] (U : Submodule R (Localization.Away a)) :=
    Submodule.equivMapOfInjective f.toLinearMap (fun x y hxy => hinj hxy) I
  have : Module.Invertible R (U : Submodule R (Localization.Away a)) :=
    Module.Invertible.left (Submodule.tensorInvEquiv U)
  exact Module.Invertible.congr e.symm

/-- **Tensoring with an ideal whose square is principal.** Let `I` be a flat ideal of `R` with
`I * I = (a)`, and let `Q` be an `R`-module on which `a` acts injectively. Then the
multiplication map `I ⊗[R] Q → Q` is injective. -/
theorem injective_lid_comp_rTensor_subtype {R Q : Type*} [CommRing R] [AddCommGroup Q]
    [Module R Q] (I : Ideal R) [Module.Flat R I] {a : R} (hI : I * I = Ideal.span {a})
    (ha : ∀ q : Q, a • q = 0 → q = 0) :
    Function.Injective
      ((TensorProduct.lid R Q).toLinearMap ∘ₗ (Submodule.subtype I).rTensor Q) := by
  let m : I ⊗[R] Q →ₗ[R] Q :=
    (TensorProduct.lid R Q).toLinearMap ∘ₗ (Submodule.subtype I).rTensor Q
  have hm : ∀ (y : I) (q : Q), m (y ⊗ₜ[R] q) = (y : R) • q := fun y q => by simp [m]
  have haI : a ∈ I :=
    Ideal.mul_le_right (show a ∈ I * I by rw [hI]; exact Ideal.mem_span_singleton_self a)
  have key : ∀ x : I ⊗[R] Q, ∀ b ∈ I,
      ∃ z : Q, b • x = (⟨a, haI⟩ : I) ⊗ₜ[R] z ∧ a • z = b • m x := by
    intro x b hb
    induction x using TensorProduct.induction_on with
    | zero =>
      exact ⟨0, by rw [smul_zero, TensorProduct.tmul_zero], by
        rw [smul_zero, map_zero, smul_zero]⟩
    | tmul y q =>
      have hby : b * (y : R) ∈ Ideal.span {a} := by
        rw [← hI]; exact Ideal.mul_mem_mul hb y.2
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hby
      refine ⟨c • q, ?_, ?_⟩
      · have hy : b • y = c • (⟨a, haI⟩ : I) :=
          Subtype.ext (by simp only [Submodule.coe_smul, smul_eq_mul]; exact hc.symm)
        rw [TensorProduct.smul_tmul', hy, TensorProduct.smul_tmul]
      · rw [hm, smul_smul, smul_smul, mul_comm a c, hc]
    | add x x' hx hx' =>
      obtain ⟨z, hz1, hz2⟩ := hx
      obtain ⟨z', hz1', hz2'⟩ := hx'
      exact ⟨z + z', by rw [smul_add, hz1, hz1', TensorProduct.tmul_add], by
        rw [smul_add, hz2, hz2', map_add, smul_add]⟩
  have hreg : Function.Injective ((LinearMap.lsmul R Q a).lTensor I) :=
    Module.Flat.lTensor_preserves_injective_linearMap _ (fun q q' hqq' =>
      sub_eq_zero.mp (ha _ (by rw [smul_sub, sub_eq_zero]; exact hqq')))
  have hg : ∀ x : I ⊗[R] Q, (LinearMap.lsmul R Q a).lTensor I x = a • x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, smul_zero]
    | tmul y q => rw [LinearMap.lTensor_tmul, LinearMap.lsmul_apply, TensorProduct.tmul_smul]
    | add x x' hx hx' => rw [map_add, hx, hx', smul_add]
  refine (injective_iff_map_eq_zero m).mpr fun x hx => ?_
  obtain ⟨z, hz1, hz2⟩ := key x a haI
  rw [hx, smul_zero] at hz2
  rw [ha z hz2, TensorProduct.tmul_zero, ← hg] at hz1
  exact hreg (hz1.trans (map_zero _).symm)

end General

/-- The ideal of relations `u_i² + v_i² - 1` of the torus indexed by `σ`, where `u_i` and `v_i`
are the variables `(i, 0)` and `(i, 1)`. -/
noncomputable def relIdeal (σ : Type) : Ideal (MvPolynomial (σ × Fin 2) ℚ) :=
  Ideal.span (Set.range fun i : σ =>
    MvPolynomial.X (i, 0) ^ 2 + MvPolynomial.X (i, 1) ^ 2 - 1)

/-- The coordinate ring `ℚ[u_i, v_i : i ∈ σ]/(u_i² + v_i² - 1)` of a product of circles. -/
abbrev torus (σ : Type) : Type := MvPolynomial (σ × Fin 2) ℚ ⧸ relIdeal σ

variable {σ : Type}

instance [Countable σ] : Countable (torus σ) :=
  Function.Surjective.countable Ideal.Quotient.mk_surjective

/-- The first coordinate `u_i` of the `i`-th circle. -/
noncomputable def u (i : σ) : torus σ := Ideal.Quotient.mk (relIdeal σ) (MvPolynomial.X (i, 0))

/-- The second coordinate `v_i` of the `i`-th circle. -/
noncomputable def v (i : σ) : torus σ := Ideal.Quotient.mk (relIdeal σ) (MvPolynomial.X (i, 1))

theorem u_sq_add_v_sq (i : σ) : u i ^ 2 + v i ^ 2 = 1 := by
  have h : Ideal.Quotient.mk (relIdeal σ)
      (MvPolynomial.X (i, 0) ^ 2 + MvPolynomial.X (i, 1) ^ 2 - 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  rw [map_sub, map_add, map_pow, map_pow, map_one, sub_eq_zero] at h
  exact h

/-- Two `ℚ`-algebra maps out of `torus σ` agreeing on all coordinates are equal. -/
theorem algHom_ext {A : Type*} [Semiring A] [Algebra ℚ A] {f g : torus σ →ₐ[ℚ] A}
    (hu : ∀ i, f (u i) = g (u i)) (hv : ∀ i, f (v i) = g (v i)) : f = g := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  rintro ⟨i, k⟩
  fin_cases k
  · exact hu i
  · exact hv i

/-- **Universal property of the torus.** Points `(a i, b i)` on the circle in a `ℚ`-algebra `A`
define a `ℚ`-algebra map `torus σ → A` sending `u i ↦ a i` and `v i ↦ b i`. -/
noncomputable def lift {A : Type*} [CommRing A] [Algebra ℚ A] (a b : σ → A)
    (h : ∀ i, a i ^ 2 + b i ^ 2 = 1) : torus σ →ₐ[ℚ] A :=
  Ideal.Quotient.liftₐ (relIdeal σ)
    (MvPolynomial.aeval fun p : σ × Fin 2 => if p.2 = 0 then a p.1 else b p.1) (fun x hx => by
      have hle : relIdeal σ ≤ RingHom.ker
          (MvPolynomial.aeval (R := ℚ) fun p : σ × Fin 2 => if p.2 = 0 then a p.1 else b p.1) := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨i, rfl⟩
        simp [h i]
      exact RingHom.mem_ker.mp (hle hx))

section Lift

variable {A : Type*} [CommRing A] [Algebra ℚ A] (a b : σ → A) (h : ∀ i, a i ^ 2 + b i ^ 2 = 1)

@[simp]
theorem lift_u (i : σ) : lift a b h (u i) = a i := by
  change MvPolynomial.aeval (fun p : σ × Fin 2 => if p.2 = 0 then a p.1 else b p.1)
    (MvPolynomial.X (i, 0)) = a i
  simp

@[simp]
theorem lift_v (i : σ) : lift a b h (v i) = b i := by
  change MvPolynomial.aeval (fun p : σ × Fin 2 => if p.2 = 0 then a p.1 else b p.1)
    (MvPolynomial.X (i, 1)) = b i
  simp

end Lift

/-- The map of tori induced by a map of index types, `u j ↦ u (e j)`, `v j ↦ v (e j)`. -/
noncomputable def torusMap {τ : Type} (e : τ → σ) : torus τ →ₐ[ℚ] torus σ :=
  lift (fun j => u (e j)) (fun j => v (e j)) fun j => u_sq_add_v_sq (e j)

@[simp]
theorem torusMap_u {τ : Type} (e : τ → σ) (j : τ) : torusMap e (u j) = u (e j) :=
  lift_u _ _ _ j

@[simp]
theorem torusMap_v {τ : Type} (e : τ → σ) (j : τ) : torusMap e (v j) = v (e j) :=
  lift_v _ _ _ j

/-! ### `u i - 1` is a nonzerodivisor -/

section NonZeroDivisor

/-- The polynomial `y² + (x² - 1)` over `T[x]`, `T` the torus on the coordinates other than
`i`; its quotient is a presentation of `torus σ`. -/
noncomputable def splitPoly (i : σ) : Polynomial (Polynomial (torus {j : σ // j ≠ i})) :=
  Polynomial.X ^ 2 + Polynomial.C (Polynomial.X ^ 2 - 1)

theorem splitPoly_monic (i : σ) : (splitPoly i).Monic :=
  Polynomial.monic_X_pow_add_C _ two_ne_zero

/-- The map `T[x] → torus σ` sending `x ↦ u i`, `T` the torus on the coordinates other than
`i`. -/
noncomputable def splitBaseMap (i : σ) : Polynomial (torus {j : σ // j ≠ i}) →ₐ[ℚ] torus σ :=
  Polynomial.aevalTower (torusMap Subtype.val) (u i)

theorem splitBaseMap_X (i : σ) : splitBaseMap i Polynomial.X = u i :=
  Polynomial.aevalTower_X _ _

theorem splitBaseMap_C (i : σ) (c : torus {j : σ // j ≠ i}) :
    splitBaseMap i (Polynomial.C c) = torusMap Subtype.val c :=
  Polynomial.aevalTower_C _ _ c

/-- The map `torus σ → T[x][y]/(y² + x² - 1)` sending `u i ↦ x`, `v i ↦ y`. -/
noncomputable def toAdjoinRoot [DecidableEq σ] (i : σ) :
    torus σ →ₐ[ℚ] AdjoinRoot (splitPoly i) :=
  lift (fun j => if h : j = i then AdjoinRoot.of (splitPoly i) Polynomial.X
      else AdjoinRoot.of (splitPoly i) (Polynomial.C (u ⟨j, h⟩)))
    (fun j => if h : j = i then AdjoinRoot.root (splitPoly i)
      else AdjoinRoot.of (splitPoly i) (Polynomial.C (v ⟨j, h⟩)))
    (fun j => by
      by_cases h : j = i
      · simp only [dite_eq_left h]
        have h0 : AdjoinRoot.mk (splitPoly i)
            (Polynomial.X ^ 2 + Polynomial.C (Polynomial.X ^ 2 - 1)) = 0 := AdjoinRoot.mk_self
        rw [map_add, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, map_sub, map_pow, map_one] at h0
        linear_combination h0
      · simp only [dite_eq_right h]
        have h1 := congrArg (fun x => AdjoinRoot.of (splitPoly i) (Polynomial.C x))
          (u_sq_add_v_sq (⟨j, h⟩ : {j : σ // j ≠ i}))
        simpa only [map_add, map_pow, map_one] using h1)

theorem toAdjoinRoot_u [DecidableEq σ] (i j : σ) :
    toAdjoinRoot i (u j) = if h : j = i then AdjoinRoot.of (splitPoly i) Polynomial.X
      else AdjoinRoot.of (splitPoly i) (Polynomial.C (u ⟨j, h⟩)) :=
  lift_u _ _ _ j

theorem toAdjoinRoot_v [DecidableEq σ] (i j : σ) :
    toAdjoinRoot i (v j) = if h : j = i then AdjoinRoot.root (splitPoly i)
      else AdjoinRoot.of (splitPoly i) (Polynomial.C (v ⟨j, h⟩)) :=
  lift_v _ _ _ j

/-- The map `T[x][y]/(y² + x² - 1) → torus σ` sending `x ↦ u i`, `y ↦ v i`. -/
noncomputable def fromAdjoinRoot (i : σ) : AdjoinRoot (splitPoly i) →ₐ[ℚ] torus σ :=
  AdjoinRoot.liftAlgHom (splitPoly i) (splitBaseMap i) (v i) (by
    change Polynomial.eval₂ (splitBaseMap i : Polynomial (torus {j : σ // j ≠ i}) →+* torus σ)
      (v i) (Polynomial.X ^ 2 + Polynomial.C (Polynomial.X ^ 2 - 1)) = 0
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, AlgHom.coe_toRingHom,
      map_sub, map_pow, map_one, splitBaseMap_X]
    linear_combination u_sq_add_v_sq i)

theorem fromAdjoinRoot_of (i : σ) (r : Polynomial (torus {j : σ // j ≠ i})) :
    fromAdjoinRoot i (AdjoinRoot.of (splitPoly i) r) = splitBaseMap i r :=
  AdjoinRoot.liftAlgHom_of ..

theorem fromAdjoinRoot_root (i : σ) : fromAdjoinRoot i (AdjoinRoot.root (splitPoly i)) = v i :=
  AdjoinRoot.liftAlgHom_root ..

theorem fromAdjoinRoot_comp_toAdjoinRoot [DecidableEq σ] (i : σ) :
    (fromAdjoinRoot i).comp (toAdjoinRoot i) = AlgHom.id ℚ (torus σ) := by
  refine algHom_ext (fun j => ?_) (fun j => ?_)
  · rw [AlgHom.comp_apply, toAdjoinRoot_u, AlgHom.id_apply]
    by_cases h : j = i
    · rw [dite_eq_left h, fromAdjoinRoot_of, splitBaseMap_X, h]
    · rw [dite_eq_right h, fromAdjoinRoot_of, splitBaseMap_C, torusMap_u]
  · rw [AlgHom.comp_apply, toAdjoinRoot_v, AlgHom.id_apply]
    by_cases h : j = i
    · rw [dite_eq_left h, fromAdjoinRoot_root, h]
    · rw [dite_eq_right h, fromAdjoinRoot_of, splitBaseMap_C, torusMap_v]

/-- A nonzerodivisor of `T[x]` stays a nonzerodivisor in `T[x][y]/(y² + x² - 1)`, which is free
over `T[x]`. -/
theorem eq_zero_of_of_mul_eq_zero (i : σ) {r : Polynomial (torus {j : σ // j ≠ i})}
    (hr : r ∈ nonZeroDivisors _) {y : AdjoinRoot (splitPoly i)}
    (hy : AdjoinRoot.of (splitPoly i) r * y = 0) : y = 0 := by
  let b := (AdjoinRoot.powerBasis' (splitPoly_monic i)).basis
  have hy' : r • y = 0 := (Algebra.smul_def r y).trans hy
  have hrepr : b.repr y = 0 := by
    refine Finsupp.ext fun k => ?_
    have h1 : b.repr (r • y) k = r * b.repr y k := by
      rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
    rw [hy', map_zero, Finsupp.zero_apply] at h1
    rw [Finsupp.zero_apply]
    exact mem_nonZeroDivisors_iff_left.mp hr _ h1.symm
  exact b.repr.injective (hrepr.trans (map_zero b.repr).symm)

/-- **`u i - 1` is a nonzerodivisor of `torus σ`.** -/
theorem u_sub_one_mem_nonZeroDivisors (i : σ) : u i - 1 ∈ nonZeroDivisors (torus σ) := by
  classical
  refine mem_nonZeroDivisors_iff_left.mpr fun x hx => ?_
  have h2 : toAdjoinRoot i (u i - 1) =
      AdjoinRoot.of (splitPoly i) (Polynomial.X - Polynomial.C 1) := by
    rw [map_sub (toAdjoinRoot i), map_one (toAdjoinRoot i), toAdjoinRoot_u,
      dite_eq_left (rfl : i = i), map_sub (AdjoinRoot.of (splitPoly i)), Polynomial.C_1,
      map_one (AdjoinRoot.of (splitPoly i))]
  have h1 : AdjoinRoot.of (splitPoly i) (Polynomial.X - Polynomial.C 1) * toAdjoinRoot i x = 0 := by
    rw [← h2, ← map_mul, hx, map_zero]
  have h3 := eq_zero_of_of_mul_eq_zero i
    (Polynomial.monic_X_sub_C (1 : torus {j : σ // j ≠ i})).mem_nonZeroDivisors h1
  have h4 := congrArg (fromAdjoinRoot i) h3
  rwa [← AlgHom.comp_apply, fromAdjoinRoot_comp_toAdjoinRoot, AlgHom.id_apply, map_zero] at h4

end NonZeroDivisor

/-! ### The ideal of the point `(1, 0)` -/

/-- The ideal `(u_i - 1, v_i)` of the rational point `(1, 0)` on the `i`-th circle. -/
noncomputable def pointIdeal (i : σ) : Ideal (torus σ) := Ideal.span {u i - 1, v i}

theorem u_sub_one_mem_pointIdeal (i : σ) : u i - 1 ∈ pointIdeal i :=
  Ideal.subset_span (Set.mem_insert _ _)

theorem v_mem_pointIdeal (i : σ) : v i ∈ pointIdeal i :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- **The square of the ideal of the point is principal**: `(u_i - 1, v_i)² = (u_i - 1)`. -/
theorem pointIdeal_mul_self (i : σ) : pointIdeal i * pointIdeal i = Ideal.span {u i - 1} := by
  have h := u_sq_add_v_sq i
  apply le_antisymm
  · rw [Ideal.mul_le]
    intro r hr s hs
    rw [pointIdeal] at hr hs
    obtain ⟨c, d, rfl⟩ := Ideal.mem_span_pair.mp hr
    obtain ⟨e, f, rfl⟩ := Ideal.mem_span_pair.mp hs
    refine Ideal.mem_span_singleton'.mpr
      ⟨c * e * (u i - 1) + (c * f + d * e) * v i - d * f * (u i + 1), ?_⟩
    linear_combination (-(d * f)) * h
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    obtain ⟨c, hc⟩ : ∃ c : torus σ, c + c = 1 :=
      ⟨algebraMap ℚ (torus σ) (1 / 2), by rw [← map_add, add_halves, map_one]⟩
    have key : u i - 1 = -c * ((u i - 1) * (u i - 1)) + -c * (v i * v i) := by
      linear_combination c * h + (1 - u i) * hc
    rw [key]
    exact Ideal.add_mem _
      (Ideal.mul_mem_left _ _
        (Ideal.mul_mem_mul (u_sub_one_mem_pointIdeal i) (u_sub_one_mem_pointIdeal i)))
      (Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul (v_mem_pointIdeal i) (v_mem_pointIdeal i)))

/-- **The ideal of the point is invertible.** -/
instance invertible_pointIdeal (i : σ) : Module.Invertible (torus σ) (pointIdeal i) :=
  invertible_of_mul_eq_span_singleton _ _ (u_sub_one_mem_nonZeroDivisors i)
    (pointIdeal_mul_self i)

/-- **The ideal of the point is finite locally free of rank one.** -/
theorem isFiniteLocallyFreeOfRank_pointIdeal (i : σ) :
    Module.IsFiniteLocallyFreeOfRank (torus σ) (pointIdeal i) 1 :=
  Module.isFiniteLocallyFreeOfRank_one_iff_invertible.mpr inferInstance

/-! ### Evaluation at the point -/

section EvalAt

variable (S : Set σ) [DecidablePred (· ∈ S)]

/-- Evaluation of the coordinates indexed by `S` at the point `(1, 0)`: the map
`torus σ → torus (σ ∖ S)` with `u j ↦ 1`, `v j ↦ 0` for `j ∈ S` and `u j ↦ u j`, `v j ↦ v j`
otherwise. -/
noncomputable def evalAt : torus σ →ₐ[ℚ] torus {j : σ // j ∉ S} :=
  lift (fun j => if h : j ∈ S then 1 else u ⟨j, h⟩) (fun j => if h : j ∈ S then 0 else v ⟨j, h⟩)
    (fun j => by
      by_cases h : j ∈ S
      · simp only [dite_eq_left h]; ring
      · simp only [dite_eq_right h]; exact u_sq_add_v_sq _)

variable {S}

theorem evalAt_u_of_mem {j : σ} (h : j ∈ S) : evalAt S (u j) = 1 := by
  simp only [evalAt, lift_u, dite_eq_left h]

theorem evalAt_v_of_mem {j : σ} (h : j ∈ S) : evalAt S (v j) = 0 := by
  simp only [evalAt, lift_v, dite_eq_left h]

theorem evalAt_u_of_not_mem {j : σ} (h : j ∉ S) : evalAt S (u j) = u ⟨j, h⟩ := by
  simp only [evalAt, lift_u, dite_eq_right h]

theorem evalAt_v_of_not_mem {j : σ} (h : j ∉ S) : evalAt S (v j) = v ⟨j, h⟩ := by
  simp only [evalAt, lift_v, dite_eq_right h]

variable (S)

/-- The inclusion of the remaining coordinates is a section of `evalAt S`. -/
theorem evalAt_comp_torusMap_val :
    (evalAt S).comp (torusMap (Subtype.val : {j : σ // j ∉ S} → σ)) = AlgHom.id ℚ _ := by
  refine algHom_ext (fun j => ?_) (fun j => ?_)
  · rw [AlgHom.comp_apply, torusMap_u, evalAt_u_of_not_mem j.2, AlgHom.id_apply]
  · rw [AlgHom.comp_apply, torusMap_v, evalAt_v_of_not_mem j.2, AlgHom.id_apply]

theorem evalAt_surjective : Function.Surjective (evalAt S) := fun y =>
  ⟨torusMap Subtype.val y, by
    rw [← AlgHom.comp_apply, evalAt_comp_torusMap_val, AlgHom.id_apply]⟩

/-- **The kernel of evaluation at the point** is the sum of the ideals of the point in the
coordinates indexed by `S`. -/
theorem ker_evalAt : RingHom.ker (evalAt S) = ⨆ j ∈ S, pointIdeal j := by
  have hu : ∀ j ∈ S, u j - 1 ∈ ⨆ j ∈ S, pointIdeal j := fun j hj =>
    le_iSup₂ (f := fun j (_ : j ∈ S) => pointIdeal j) j hj (u_sub_one_mem_pointIdeal j)
  have hv : ∀ j ∈ S, v j ∈ ⨆ j ∈ S, pointIdeal j := fun j hj =>
    le_iSup₂ (f := fun j (_ : j ∈ S) => pointIdeal j) j hj (v_mem_pointIdeal j)
  apply le_antisymm
  · intro x hx
    have key : (Ideal.Quotient.mkₐ ℚ (⨆ j ∈ S, pointIdeal j)).comp
        ((torusMap (Subtype.val : {j : σ // j ∉ S} → σ)).comp (evalAt S)) =
          Ideal.Quotient.mkₐ ℚ (⨆ j ∈ S, pointIdeal j) := by
      refine algHom_ext (fun j => ?_) (fun j => ?_)
      · by_cases hj : j ∈ S
        · rw [AlgHom.comp_apply, AlgHom.comp_apply, evalAt_u_of_mem hj, map_one, map_one,
            Ideal.Quotient.mkₐ_eq_mk]
          exact ((Ideal.Quotient.eq.mpr (hu j hj)).trans (map_one _)).symm
        · rw [AlgHom.comp_apply, AlgHom.comp_apply, evalAt_u_of_not_mem hj, torusMap_u]
      · by_cases hj : j ∈ S
        · rw [AlgHom.comp_apply, AlgHom.comp_apply, evalAt_v_of_mem hj, map_zero, map_zero,
            Ideal.Quotient.mkₐ_eq_mk]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr (hv j hj)).symm
        · rw [AlgHom.comp_apply, AlgHom.comp_apply, evalAt_v_of_not_mem hj, torusMap_v]
    have h := AlgHom.congr_fun key x
    rw [AlgHom.comp_apply, AlgHom.comp_apply, RingHom.mem_ker.mp hx, map_zero, map_zero,
      Ideal.Quotient.mkₐ_eq_mk] at h
    exact Ideal.Quotient.eq_zero_iff_mem.mp h.symm
  · refine iSup₂_le fun j hj => ?_
    rw [pointIdeal, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨RingHom.mem_ker.mpr (by rw [map_sub, map_one, evalAt_u_of_mem hj, sub_self]),
      RingHom.mem_ker.mpr (evalAt_v_of_mem hj)⟩

end EvalAt

/-! ### Evaluation of all coordinates -/

/-- The torus over an empty index type is `ℚ`. -/
noncomputable def torusEquivOfIsEmpty (τ : Type) [IsEmpty τ] : torus τ ≃ₐ[ℚ] ℚ :=
  AlgEquiv.ofAlgHom (lift (fun j => isEmptyElim j) (fun j => isEmptyElim j) fun j => isEmptyElim j)
    (Algebra.ofId ℚ (torus τ)) (Subsingleton.elim _ _)
    (algHom_ext (fun j => isEmptyElim j) (fun j => isEmptyElim j))

instance : IsEmpty {j : σ // j ∉ (Set.univ : Set σ)} := ⟨fun j => j.2 (Set.mem_univ _)⟩

variable (σ) in
/-- Evaluation of all coordinates at the point `(1, 0)`, as a map `torus σ → ℚ`. -/
noncomputable def evalAll : torus σ →ₐ[ℚ] ℚ :=
  (torusEquivOfIsEmpty {j : σ // j ∉ (Set.univ : Set σ)}).toAlgHom.comp (evalAt Set.univ)

theorem ker_evalAll : RingHom.ker (evalAll σ) = ⨆ j ∈ (Set.univ : Set σ), pointIdeal j := by
  rw [← ker_evalAt]
  ext x
  rw [RingHom.mem_ker, RingHom.mem_ker]
  refine ⟨fun h => (torusEquivOfIsEmpty {j : σ // j ∉ (Set.univ : Set σ)}).injective
    (by rw [map_zero]; exact h), fun h => ?_⟩
  change (torusEquivOfIsEmpty {j : σ // j ∉ (Set.univ : Set σ)}) (evalAt Set.univ x) = 0
  rw [h, map_zero]

/-! ### Tensoring the ideal of a point with the quotient by the other points -/

/-- **The multiplication map `pointIdeal i ⊗ (torus σ ⧸ ⨆ j ∈ S, pointIdeal j) → …` is injective**
for `i ∉ S`, i.e. `Tor₁(torus σ ⧸ pointIdeal i, torus σ ⧸ ⨆ j ∈ S, pointIdeal j) = 0`. -/
theorem injective_pointIdeal_tensor_quotient (S : Set σ) {i : σ} (hi : i ∉ S) :
    Function.Injective
      ((TensorProduct.lid (torus σ) (torus σ ⧸ ⨆ j ∈ S, pointIdeal j)).toLinearMap ∘ₗ
        (Submodule.subtype (pointIdeal i)).rTensor (torus σ ⧸ ⨆ j ∈ S, pointIdeal j)) := by
  classical
  refine injective_lid_comp_rTensor_subtype (pointIdeal i) (pointIdeal_mul_self i) ?_
  intro q hq
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  have hmem : (u i - 1) * x ∈ ⨆ j ∈ S, pointIdeal j := by
    have h0 : Submodule.Quotient.mk (p := ⨆ j ∈ S, pointIdeal j) ((u i - 1) * x) = 0 := by
      rw [← smul_eq_mul, Submodule.Quotient.mk_smul]
      exact hq
    exact (Submodule.Quotient.mk_eq_zero _).mp h0
  rw [← ker_evalAt, RingHom.mem_ker, map_mul, map_sub, map_one, evalAt_u_of_not_mem hi] at hmem
  have hx : evalAt S x = 0 :=
    mem_nonZeroDivisors_iff_left.mp (u_sub_one_mem_nonZeroDivisors _) _ hmem
  refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
  rw [← ker_evalAt S]
  exact RingHom.mem_ker.mpr hx

end Stacks.Examples.CircleTorus
