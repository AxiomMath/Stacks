/-!
# The mod-two Euler characteristic of modules over a product of circles

Let `k` be a field in which `-1` is not a square and `B` a `k`-algebra generated by `1` and pairs
`(u_i, v_i)` with `u_i^2 + v_i^2 = 1` (`CircleData`). For a finite `B`-module `X` choose a finite
generating set `s` and let `F_n = (span_k {1, u_i, v_i})^n · span_k s` be the induced
filtration of `X`. By Hilbert–Serre, applied to the Rees module `⊕ F_n`, the function
`n ↦ dim_k F_n` is eventually a numerical polynomial `∑_i C(n, i) a_i`. We put

  `φ(X) = a_0 mod 2`,

computed as the eventual value of `dim_k F_{2^K}` modulo two (`evenLimit`).

`φ(X)` does not depend on `s`: by the comparison lemma (built on the evenness lemma for graded
modules killed by `w` and by `u_i^2 + v_i^2`), the dimensions of two such filtrations agree
modulo two in all large degrees. It is invariant under isomorphism and additive on short exact
sequences `0 → X → Y → Z → 0`: filtering `Y` by a generating set containing the image of one of
`X`, the induced filtrations of `Z` and of `X` are, respectively, generated and comparable with a
generated one. On `B ⧸ I` with `B ⧸ I ≅ k` the filtration is `k` in every degree, so `φ = 1`.

For `B = torus (Fin r)`, the coordinate ring of `r` circles over `ℚ`, this gives
`eulerCharModTwo r` with `φ(torus (Fin r) ⧸ (I_0 + ⋯ + I_{r-1})) = 1`, `I_i` the ideal of the
rational point `(1, 0)` of the `i`-th circle.

## Main definitions

* `Stacks.Examples.CircleTorus.eulerCharModTwoOf`: the invariant for a `CircleData`.
* `Stacks.Examples.CircleTorus.torusData`: the generators `1, u_i, v_i` of `torus (Fin r)`.
* `Stacks.Examples.CircleTorus.eulerCharModTwo`: the invariant on `torus (Fin r)`-modules.

## Main results

* `Stacks.Examples.CircleTorus.eulerCharAux_eq`: the value is computed by any finite generating
  set.
* `Stacks.Examples.CircleTorus.eulerCharAux_eq_finrank`: on a finite dimensional module the
  value is the dimension modulo two.
* `Stacks.Examples.CircleTorus.eulerCharAux_shortExact`: additivity on short exact sequences.
* `Stacks.Examples.CircleTorus.partialSup_pointIdeal_eq_ker`: `I_0 + ⋯ + I_{r-1}` is the kernel
  of evaluation at the point `((1, 0), …, (1, 0))`.
* `Stacks.Examples.CircleTorus.eulerCharModTwo_point`: `φ(torus (Fin r) ⧸ (I_0 + ⋯ + I_{r-1}))
  = 1`.

## References

* [Stacks Project, Tag 05WL](https://stacks.math.columbia.edu/tag/05WL)
-/

@[expose] public section

open Module Filter

namespace Stacks.Examples.CircleTorus

open Stacks.HilbertFunction.PolynomialQuotient

universe u

/-- **Rank–nullity for a subspace**: `dim p = dim φ(p) + dim (p ∩ ker φ)`. -/
theorem finrank_eq_finrank_map_add_finrank_inf_ker {k : Type u} [Field k] {V W : Type u}
    [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W] (φ : V →ₗ[k] W)
    (p : Submodule k V) [FiniteDimensional k p] :
    finrank k p = finrank k (p.map φ) + finrank k (p ⊓ LinearMap.ker φ : Submodule k V) := by
  have h := LinearMap.finrank_range_add_finrank_ker (φ.domRestrict p)
  rw [LinearMap.range_domRestrict, LinearMap.ker_domRestrict] at h
  have h2 : finrank k (Submodule.comap p.subtype (LinearMap.ker φ)) =
      finrank k (p ⊓ LinearMap.ker φ : Submodule k V) := by
    have hc : Submodule.comap p.subtype (LinearMap.ker φ) =
        Submodule.comap p.subtype (p ⊓ LinearMap.ker φ) := by
      rw [Submodule.comap_inf, Submodule.comap_subtype_self, top_inf_eq]
    rw [hc]
    exact (Submodule.comapSubtypeEquivOfLe inf_le_left).finrank_eq
  rw [← h2]
  exact h.symm

section Invariant

variable {k : Type u} [Field k] {B : Type u} [CommRing B] [Algebra k B]

open Classical in
/-- A finite generating set of a finite `B`-module, and `∅` if the module is not finite. -/
noncomputable def finGenSet (B : Type u) [CommRing B] (X : Type u) [AddCommGroup X]
    [Module B X] : Set X :=
  if h : Module.Finite B X then ↑(Classical.choose h.fg_top) else ∅

theorem finGenSet_finite (X : Type u) [AddCommGroup X] [Module B X] [h : Module.Finite B X] :
    (finGenSet B X).Finite := by
  rw [finGenSet, dite_eq_left h]
  exact Finset.finite_toSet _

theorem span_finGenSet (X : Type u) [AddCommGroup X] [Module B X] [h : Module.Finite B X] :
    Submodule.span B (finGenSet B X) = ⊤ := by
  rw [finGenSet, dite_eq_left h]
  exact Classical.choose_spec h.fg_top

open Classical in
/-- The mod-two Euler characteristic of a finite `B`-module: the eventual parity of
`dim_k F_{2^K}` for the filtration generated by `finGenSet B X`, which is the constant
coefficient modulo two of its Hilbert polynomial; and `0` on modules which are not finite. -/
noncomputable def eulerCharAux (D : CircleData k B) (X : Type u) [AddCommGroup X] [Module B X] :
    ZMod 2 :=
  if Module.Finite B X then
    letI : Module k X := Module.compHom X (algebraMap k B)
    haveI : IsScalarTower k B X := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    evenLimit fun n => finrank k (genFiltration k D.b (finGenSet B X) n)
  else 0

variable (D : CircleData k B) (hk : ¬ IsSquare (-1 : k))
include hk

/-- **The invariant is computed by any finite generating set**, for any `k`-module structure
compatible with the `B`-module structure. -/
theorem eulerCharAux_eq (X : Type u) [AddCommGroup X] [Module B X] [instK : Module k X]
    [IsScalarTower k B X] [hX : Module.Finite B X] {s : Set X} (hs : s.Finite)
    (hspan : Submodule.span B s = ⊤) :
    eulerCharAux D X = evenLimit fun n => finrank k (genFiltration k D.b s n) := by
  have hinst : instK = Module.compHom X (algebraMap k B) :=
    Module.ext' _ _ fun c x => (algebraMap_smul B c x).symm
  subst hinst
  rw [eulerCharAux, ite_eq_left hX]
  let : Module k X := Module.compHom X (algebraMap k B)
  have : IsScalarTower k B X := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  exact evenLimit_eq_of_eventually
    (f := fun n => finrank k (genFiltration k D.b (finGenSet B X) n))
    (g := fun n => finrank k (genFiltration k D.b s n))
    (exists_eventually_finrank_genFiltration_pow_two (k := k) D.b hs)
    (eventually_natCast_finrank_genFiltration_eq D hk (finGenSet_finite (B := B) X) hs
      (span_finGenSet (B := B) X) hspan)

/-- On a finite dimensional module the invariant is the dimension modulo two. -/
theorem eulerCharAux_eq_finrank (X : Type u) [AddCommGroup X] [Module B X] [Module k X]
    [IsScalarTower k B X] [Module.Finite k X] : eulerCharAux D X = (finrank k X : ZMod 2) := by
  have : Module.Finite B X := Module.Finite.of_restrictScalars_finite k B X
  rw [eulerCharAux_eq D hk X (finGenSet_finite (B := B) X)
    (span_finGenSet (B := B) X)]
  apply evenLimit_eq
  filter_upwards [eventually_pow_two
    (eventually_genFiltration_eq_top D.b_w D.surj (span_finGenSet (B := B) X))] with K hK
  show (finrank k (genFiltration k D.b (finGenSet B X) (2 ^ K)) : ZMod 2) = (finrank k X : ZMod 2)
  rw [hK, finrank_top]

/-- **Invariance under isomorphism.** -/
theorem eulerCharAux_congr {X Y : Type u} [AddCommGroup X] [Module B X] [AddCommGroup Y]
    [Module B Y] (e : X ≃ₗ[B] Y) : eulerCharAux D X = eulerCharAux D Y := by
  by_cases hX : Module.Finite B X
  · have := hX
    have : Module.Finite B Y := Module.Finite.equiv e
    let : Module k X := Module.compHom X (algebraMap k B)
    let : Module k Y := Module.compHom Y (algebraMap k B)
    have : IsScalarTower k B X := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    have : IsScalarTower k B Y := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    let g : X →ₗ[B] Y := e
    have hs := finGenSet_finite (B := B) X
    have hspan := span_finGenSet (B := B) X
    have hsY : (g '' finGenSet B X).Finite := hs.image g
    have hspanY : Submodule.span B (g '' finGenSet B X) = ⊤ := by
      rw [← Submodule.map_span, hspan, Submodule.map_top,
        LinearMap.range_eq_top_of_surjective g e.surjective]
    rw [eulerCharAux_eq D hk X hs hspan, eulerCharAux_eq D hk Y hsY hspanY]
    congr 1
    funext n
    rw [← map_genFiltration g (finGenSet B X) n]
    exact (Submodule.equivMapOfInjective (g.restrictScalars k) e.injective _).finrank_eq
  · have hY : ¬ Module.Finite B Y := fun h => hX (haveI := h; Module.Finite.equiv e.symm)
    rw [eulerCharAux, eulerCharAux, ite_eq_right hX, ite_eq_right hY]

/-- **Additivity on short exact sequences** `0 → X → Y → Z → 0` of finite modules. -/
theorem eulerCharAux_shortExact {X Y Z : Type u} [AddCommGroup X] [Module B X] [Module k X]
    [IsScalarTower k B X] [AddCommGroup Y] [Module B Y] [Module k Y] [IsScalarTower k B Y]
    [AddCommGroup Z] [Module B Z] [Module k Z] [IsScalarTower k B Z] [Module.Finite B X]
    [Module.Finite B Y] [Module.Finite B Z] (f : X →ₗ[B] Y) (g : Y →ₗ[B] Z)
    (hf : Function.Injective f) (hfg : Function.Exact f g) (hg : Function.Surjective g) :
    eulerCharAux D Y = eulerCharAux D X + eulerCharAux D Z := by
  classical
  have hsX := finGenSet_finite (B := B) X
  have hspanX := span_finGenSet (B := B) X
  let s : Set Y := f '' finGenSet B X ∪ finGenSet B Y
  have hsub : f '' finGenSet B X ⊆ s := fun y hy => Or.inl hy
  have hs : s.Finite := (hsX.image f).union (finGenSet_finite (B := B) Y)
  have hspan : Submodule.span B s = ⊤ :=
    eq_top_iff.mpr ((span_finGenSet (B := B) Y).symm.le.trans
      (Submodule.span_mono fun y hy => Or.inr hy))
  have hsZ : (g '' s).Finite := hs.image g
  have hspanZ : Submodule.span B (g '' s) = ⊤ := by
    rw [← Submodule.map_span, hspan, Submodule.map_top, LinearMap.range_eq_top.mpr hg]
  have hfk : Function.Injective (f.restrictScalars k) := hf
  -- the union of the image filtration is the kernel of `g`
  have hrange : (⨆ m, genFiltration k D.b (f '' finGenSet B X) m) =
      LinearMap.ker (g.restrictScalars k) := by
    have h1 : ∀ m, genFiltration k D.b (f '' finGenSet B X) m =
        (genFiltration k D.b (finGenSet B X) m).map (f.restrictScalars k) := fun m =>
      (map_genFiltration f _ m).symm
    rw [iSup_congr h1, ← Submodule.map_iSup, iSup_genFiltration D.b_w D.surj hspanX,
      Submodule.map_top]
    exact ((LinearMap.exact_iff (f := f.restrictScalars k) (g := g.restrictScalars k)).mp
      hfg).symm
  have hcmp := eventually_even_finrank_inf_iff D hk hs
    (genFiltration k D.b (f '' finGenSet B X)) (genFiltration_mono D.b_w _)
    (fun j n x hx => smul_mem_genFiltration j hx)
  rw [hrange] at hcmp
  have eX := exists_eventually_finrank_genFiltration_pow_two (k := k) D.b hsX
  have eZ := exists_eventually_finrank_genFiltration_pow_two (k := k) D.b hsZ
  rw [eulerCharAux_eq D hk Y hs hspan, eulerCharAux_eq D hk X hsX hspanX,
    eulerCharAux_eq D hk Z hsZ hspanZ,
    ← evenLimit_add (f := fun n => finrank k (genFiltration k D.b (finGenSet B X) n))
      (g := fun n => finrank k (genFiltration k D.b (g '' s) n)) eX eZ]
  refine (evenLimit_eq_of_eventually
    (f := fun n => finrank k (genFiltration k D.b (finGenSet B X) n) +
      finrank k (genFiltration k D.b (g '' s) n))
    (g := fun n => finrank k (genFiltration k D.b s n))
    (exists_eventually_finrank_genFiltration_pow_two (k := k) D.b hs) ?_).symm
  filter_upwards [hcmp] with n hn
  have := finiteDimensional_genFiltration (k := k) (b := D.b) hs n
  rw [inf_eq_right.mpr (genFiltration_mono_set hsub n)] at hn
  have h1 : finrank k (genFiltration k D.b (f '' finGenSet B X) n) =
      finrank k (genFiltration k D.b (finGenSet B X) n) := by
    rw [← map_genFiltration f _ n]
    exact (Submodule.equivMapOfInjective _ hfk _).finrank_eq.symm
  rw [h1] at hn
  have h2 := finrank_eq_finrank_map_add_finrank_inf_ker (g.restrictScalars k)
    (genFiltration k D.b s n)
  rw [map_genFiltration g s n] at h2
  change ((finrank k (genFiltration k D.b (finGenSet B X) n) +
      finrank k (genFiltration k D.b (g '' s) n) : ℕ) : ZMod 2) =
    (finrank k (genFiltration k D.b s n) : ZMod 2)
  rw [h2, Nat.cast_add, Nat.cast_add, natCast_eq_of_even_iff hn, add_comm]

/-- **The mod-two Euler characteristic** on modules over a `k`-algebra with `CircleData`. -/
noncomputable def eulerCharModTwoOf : ModTwoInvariant B where
  toFun X _ _ := eulerCharAux D X
  congr' e := eulerCharAux_congr D hk e
  prod' X Y _ _ _ _ hX hY := by
    have := hX
    have := hY
    let : Module k X := Module.compHom X (algebraMap k B)
    let : Module k Y := Module.compHom Y (algebraMap k B)
    have : IsScalarTower k B X := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    have : IsScalarTower k B Y := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    exact eulerCharAux_shortExact D hk (LinearMap.inl B X Y) (LinearMap.snd B X Y)
      LinearMap.inl_injective Function.Exact.inl_snd LinearMap.snd_surjective
  shortExact' X Y Z _ _ _ _ _ _ hX hY hZ f g hf hfg hg := by
    have := hX
    have := hY
    have := hZ
    let : Module k X := Module.compHom X (algebraMap k B)
    let : Module k Y := Module.compHom Y (algebraMap k B)
    let : Module k Z := Module.compHom Z (algebraMap k B)
    have : IsScalarTower k B X := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    have : IsScalarTower k B Y := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    have : IsScalarTower k B Z := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    exact eulerCharAux_shortExact D hk f g hf hfg hg

theorem eulerCharModTwoOf_apply (X : Type u) [AddCommGroup X] [Module B X] :
    (eulerCharModTwoOf D hk).toFun X = eulerCharAux D X :=
  rfl

end Invariant

/-! ### The torus -/

/-- The index of `u_i` among the generators `u_0, v_0, …, u_{r-1}, v_{r-1}, 1`. -/
def torusU (r : ℕ) (i : Fin r) : Fin (r * 2 + 1) :=
  (finProdFinEquiv (i, 0)).castSucc

/-- The index of `v_i` among the generators `u_0, v_0, …, u_{r-1}, v_{r-1}, 1`. -/
def torusV (r : ℕ) (i : Fin r) : Fin (r * 2 + 1) :=
  (finProdFinEquiv (i, 1)).castSucc

/-- The generators `u_0, v_0, …, u_{r-1}, v_{r-1}, 1` of `torus (Fin r)`. -/
noncomputable def torusGen (r : ℕ) (j : Fin (r * 2 + 1)) : torus (Fin r) :=
  Fin.lastCases (motive := fun _ => torus (Fin r)) 1
    (fun i => Ideal.Quotient.mk (relIdeal (Fin r)) (MvPolynomial.X (finProdFinEquiv.symm i))) j

theorem torusGen_last (r : ℕ) : torusGen r (Fin.last (r * 2)) = 1 := by
  simp only [torusGen, Fin.lastCases_last]

theorem torusGen_castSucc (r : ℕ) (p : Fin r × Fin 2) :
    torusGen r (finProdFinEquiv p).castSucc =
      Ideal.Quotient.mk (relIdeal (Fin r)) (MvPolynomial.X p) := by
  simp only [torusGen, Fin.lastCases_castSucc, Equiv.symm_apply_apply]

theorem torusGen_torusU (r : ℕ) (i : Fin r) : torusGen r (torusU r i) = u i :=
  torusGen_castSucc r (i, 0)

theorem torusGen_torusV (r : ℕ) (i : Fin r) : torusGen r (torusV r i) = v i :=
  torusGen_castSucc r (i, 1)

/-- The generators `1, u_i, v_i` of `torus (Fin r)` as a `CircleData`. -/
noncomputable def torusData (r : ℕ) : CircleData ℚ (torus (Fin r)) where
  d := r * 2 + 1
  b := torusGen r
  r := r
  u := torusU r
  v := torusV r
  w := Fin.last (r * 2)
  b_w := torusGen_last r
  b_other j hj := by
    induction j using Fin.lastCases with
    | last => exact torusGen_last r
    | cast j =>
      exfalso
      have hj' : j = finProdFinEquiv (finProdFinEquiv.symm j) :=
        (Equiv.apply_symm_apply _ _).symm
      rcases hc : finProdFinEquiv.symm j with ⟨i, c⟩
      rw [hc] at hj'
      have hc2 : c = 0 ∨ c = 1 := by
        rcases c with ⟨c, hc'⟩
        interval_cases c
        · left
          rfl
        · right
          rfl
      rcases hc2 with rfl | rfl
      · exact (hj i).1 (congrArg Fin.castSucc hj')
      · exact (hj i).2 (congrArg Fin.castSucc hj')
  b_sq i := by
    change torusGen r (torusU r i) * torusGen r (torusU r i) +
      torusGen r (torusV r i) * torusGen r (torusV r i) = 1
    rw [torusGen_torusU, torusGen_torusV, ← pow_two, ← pow_two]
    exact u_sq_add_v_sq i
  surj := by
    intro t
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
    refine ⟨MvPolynomial.rename (fun q : Fin r × Fin 2 => (finProdFinEquiv q).castSucc) p, ?_⟩
    change MvPolynomial.aeval (torusGen r)
      (MvPolynomial.rename (fun q : Fin r × Fin 2 => (finProdFinEquiv q).castSucc) p) =
        Ideal.Quotient.mk (relIdeal (Fin r)) p
    rw [MvPolynomial.aeval_rename]
    have hfun : torusGen r ∘ (fun q : Fin r × Fin 2 => (finProdFinEquiv q).castSucc) =
        (Ideal.Quotient.mkₐ ℚ (relIdeal (Fin r))) ∘ MvPolynomial.X := by
      funext q
      simp only [Function.comp_apply, torusGen_castSucc, Ideal.Quotient.mkₐ_eq_mk]
    rw [hfun, ← MvPolynomial.aeval_unique, Ideal.Quotient.mkₐ_eq_mk]

/-- **The mod-two Euler characteristic** of modules over `torus (Fin r)`: for a finite module
`M` with a good filtration `M_d` (by total degree in the `u_i, v_i`), the constant coefficient
modulo two of the Hilbert polynomial of `d ↦ dim_ℚ M_d`. -/
noncomputable def eulerCharModTwo (r : ℕ) : ModTwoInvariant (torus (Fin r)) :=
  eulerCharModTwoOf (torusData r) not_isSquare_neg_one_rat

/-- `I_0 + ⋯ + I_{m-1}` for the ideals `I_i` of the point `(1, 0)` of the circles. -/
theorem partialSup_pointIdeal (r : ℕ) : ∀ m, m ≤ r →
    ModTwoInvariant.partialSup
        (fun i => if h : i < r then pointIdeal (⟨i, h⟩ : Fin r) else ⊤) m =
      ⨆ (j : Fin r) (_ : (j : ℕ) < m), pointIdeal j
  | 0, _ => (le_antisymm (iSup₂_le fun j hj => absurd hj (Nat.not_lt_zero _)) bot_le).symm
  | m + 1, hm => by
    have ih := partialSup_pointIdeal r m (by omega)
    have hmr : m < r := by omega
    change ModTwoInvariant.partialSup
        (fun i => if h : i < r then pointIdeal (⟨i, h⟩ : Fin r) else ⊤) m ⊔
      (if h : m < r then pointIdeal (⟨m, h⟩ : Fin r) else ⊤) = _
    rw [dite_eq_left hmr, ih]
    apply le_antisymm
    · refine sup_le (iSup₂_le fun j hj => le_iSup₂_of_le j (by omega) le_rfl) ?_
      exact le_iSup₂_of_le (⟨m, hmr⟩ : Fin r) (Nat.lt_succ_self m) le_rfl
    · refine iSup₂_le fun j hj => ?_
      by_cases hjm : (j : ℕ) < m
      · exact le_sup_of_le_left (le_iSup₂_of_le j hjm le_rfl)
      · have hj' : j = ⟨m, hmr⟩ := Fin.ext (show (j : ℕ) = m by omega)
        rw [hj']
        exact le_sup_right

/-- `I_0 + ⋯ + I_{r-1}` is the kernel of evaluation at the point `((1, 0), …, (1, 0))`. -/
theorem partialSup_pointIdeal_eq_ker (r : ℕ) :
    ModTwoInvariant.partialSup
        (fun i => if h : i < r then pointIdeal (⟨i, h⟩ : Fin r) else ⊤) r =
      RingHom.ker (evalAll (Fin r)) := by
  rw [partialSup_pointIdeal r r le_rfl, ker_evalAll]
  refine iSup_congr fun j => ?_
  rw [iSup_pos j.2, iSup_pos (Set.mem_univ j)]

/-- **The value at the point**: `φ(torus (Fin r) ⧸ (I_0 + ⋯ + I_{r-1})) = 1`, since the quotient
is `ℚ`. -/
theorem eulerCharModTwo_point (r : ℕ) :
    (eulerCharModTwo r).toFun (torus (Fin r) ⧸ ModTwoInvariant.partialSup
      (fun i => if h : i < r then pointIdeal (⟨i, h⟩ : Fin r) else ⊤) r) = 1 := by
  rw [partialSup_pointIdeal_eq_ker]
  have hsurj : Function.Surjective (evalAll (Fin r)) := fun c =>
    ⟨algebraMap ℚ (torus (Fin r)) c,
      (AlgHom.commutes (evalAll (Fin r)) c).trans (Algebra.algebraMap_self_apply c)⟩
  let e := (Ideal.quotientKerAlgEquivOfSurjective hsurj).toLinearEquiv
  have : Module.Finite ℚ (torus (Fin r) ⧸ RingHom.ker (evalAll (Fin r))) :=
    Module.Finite.equiv e.symm
  have h1 : finrank ℚ (torus (Fin r) ⧸ RingHom.ker (evalAll (Fin r))) = 1 :=
    e.finrank_eq.trans (Module.finrank_self ℚ)
  change eulerCharAux (torusData r) (torus (Fin r) ⧸ RingHom.ker (evalAll (Fin r))) = 1
  rw [eulerCharAux_eq_finrank (torusData r) not_isSquare_neg_one_rat
    (torus (Fin r) ⧸ RingHom.ker (evalAll (Fin r))), h1, Nat.cast_one]

/-- The value at the point, with the ideal written as `⨆ i, pointIdeal i`. -/
theorem eulerCharModTwo_point_iSup (r : ℕ) :
    (eulerCharModTwo r).toFun (torus (Fin r) ⧸ ⨆ j ∈ (Set.univ : Set (Fin r)), pointIdeal j) =
      1 := by
  rw [← ker_evalAll, ← partialSup_pointIdeal_eq_ker]
  exact eulerCharModTwo_point r

end Stacks.Examples.CircleTorus
