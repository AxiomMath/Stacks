module

public import Mathlib.Algebra.Polynomial.Module.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.RingTheory.Finiteness.Basic
public import StacksFrontier.RingTheory.HilbertFunction.BoundaryParity

/-!
# Generated filtrations and their Rees modules

Let `k` be a field, `B` a commutative `k`-algebra and `b_0, …, b_{d-1} ∈ B`. For a `B`-module `X`
and a set `s ⊆ X` we consider the filtration of `X` by the `k`-subspaces

  `F_0 = span_k s`,  `F_{n+1} = ∑_j b_j F_n`.

When `s` is finite every `F_n` is finite dimensional. When some `b_w = 1`, the `b_j` generate `B`
as a `k`-algebra and `s` generates `X` as a `B`-module, the filtration is increasing and
exhaustive.

The *Rees module* of the filtration is `⊕_n F_n T^n ⊆ X[T]`, a module over the polynomial ring
`S = k[X_0, …, X_{d-1}]` in which `X_j` acts as `b_j T`. It is generated by the finitely many
elements `x T^0` (`x ∈ s`), and the degree `n` piece is a copy of `F_n`. Hence it is an
admissible graded `S`-module, whose Hilbert function is `n ↦ dim_k F_n`. Families `G_n ≤ F_n`
stable under the `b_j` give graded families of the Rees module.

## Main definitions

* `Stacks.Examples.CircleTorus.genFiltration`: the filtration `F_n` generated by `s`.
* `Stacks.Examples.CircleTorus.ReesAmb`: the polynomial module `X[T]` as an `S`-module.
* `Stacks.Examples.CircleTorus.reesAdmissible`: the Rees module, an admissible graded module.
* `Stacks.Examples.CircleTorus.reesFamily`: the graded family of the Rees module attached to a
  family `G_n ≤ F_n`.

## Main results

* `Stacks.Examples.CircleTorus.exists_mem_genFiltration`: the filtration is exhaustive.
* `Stacks.Examples.CircleTorus.map_genFiltration`: the image of the filtration generated by `s`
  under a `B`-linear map `g` is the filtration generated by `g '' s`.
* `Stacks.Examples.CircleTorus.finrank_reesGrading`: the Hilbert function of the Rees module.
* `Stacks.Examples.CircleTorus.isGradedFamily_reesFamily`,
  `Stacks.Examples.CircleTorus.smulMapsTo_reesFamily_X`,
  `Stacks.Examples.CircleTorus.smulMapsTo_reesFamily_sq`: transport of families.
-/

@[expose] public section

open Module

namespace Stacks.Examples.CircleTorus

open Stacks.HilbertFunction.PolynomialQuotient

universe u

section Filtration

variable (k : Type u) [Field k] {B : Type u} [CommRing B] [Algebra k B]
  {X : Type u} [AddCommGroup X] [Module B X] [Module k X] [IsScalarTower k B X]
  {d : ℕ} (b : Fin d → B)

/-- Multiplication by `b j`, as a `k`-linear endomorphism. -/
noncomputable def smulK (j : Fin d) : X →ₗ[k] X :=
  (LinearMap.lsmul B X (b j)).restrictScalars k

theorem smulK_apply (j : Fin d) (x : X) : smulK k b j x = b j • x :=
  rfl

/-- The filtration generated by `s`: `F_0 = span_k s` and `F_{n+1} = ∑_j b_j F_n`. -/
noncomputable def genFiltration (s : Set X) : ℕ → Submodule k X
  | 0 => Submodule.span k s
  | n + 1 => ⨆ j : Fin d, (genFiltration s n).map (smulK k b j)

theorem genFiltration_zero (s : Set X) : genFiltration k b s 0 = Submodule.span k s :=
  rfl

theorem genFiltration_succ (s : Set X) (n : ℕ) :
    genFiltration k b s (n + 1) = ⨆ j : Fin d, (genFiltration k b s n).map (smulK k b j) :=
  rfl

variable {k b}

theorem smul_mem_genFiltration {s : Set X} (j : Fin d) {n : ℕ} {x : X}
    (hx : x ∈ genFiltration k b s n) : b j • x ∈ genFiltration k b s (n + 1) := by
  rw [genFiltration_succ]
  exact Submodule.mem_iSup_of_mem j (Submodule.mem_map_of_mem (f := smulK k b j) hx)

theorem genFiltration_le_succ {w : Fin d} (hw : b w = 1) (s : Set X) (n : ℕ) :
    genFiltration k b s n ≤ genFiltration k b s (n + 1) := fun x hx => by
  have h := smul_mem_genFiltration (k := k) (b := b) w hx
  rwa [hw, one_smul] at h

theorem genFiltration_mono {w : Fin d} (hw : b w = 1) (s : Set X) :
    Monotone (genFiltration k b s) :=
  monotone_nat_of_le_succ (genFiltration_le_succ hw s)

theorem genFiltration_mono_set {s t : Set X} (h : s ⊆ t) :
    ∀ n, genFiltration k b s n ≤ genFiltration k b t n
  | 0 => by
    rw [genFiltration_zero, genFiltration_zero]
    exact Submodule.span_mono h
  | n + 1 => by
    rw [genFiltration_succ, genFiltration_succ]
    exact iSup_mono fun j => Submodule.map_mono (genFiltration_mono_set h n)

theorem finiteDimensional_genFiltration {s : Set X} (hs : s.Finite) :
    ∀ n, FiniteDimensional k (genFiltration k b s n)
  | 0 => by
    rw [genFiltration_zero]
    exact Module.Finite.span_of_finite k hs
  | n + 1 => by
    have := finiteDimensional_genFiltration hs n
    rw [genFiltration_succ]
    infer_instance

/-- The image of the filtration generated by `s` under a `B`-linear map `g` is the filtration
generated by `g '' s`. -/
theorem map_genFiltration {Y : Type u} [AddCommGroup Y] [Module B Y] [Module k Y]
    [IsScalarTower k B Y] (g : X →ₗ[B] Y) (s : Set X) :
    ∀ n, (genFiltration k b s n).map (g.restrictScalars k) = genFiltration k b (g '' s) n
  | 0 => by
    rw [genFiltration_zero, genFiltration_zero, Submodule.map_span]
    rfl
  | n + 1 => by
    rw [genFiltration_succ, genFiltration_succ, Submodule.map_iSup]
    refine iSup_congr fun j => ?_
    rw [← map_genFiltration g s n, ← Submodule.map_comp, ← Submodule.map_comp]
    have hcomm : (g.restrictScalars k).comp (smulK k b j) =
        (smulK k b j).comp (g.restrictScalars k) :=
      LinearMap.ext fun x => map_smul g (b j) x
    rw [hcomm]

theorem exists_mem_genFiltration_add {w : Fin d} (hw : b w = 1) (s : Set X) {x y : X}
    (hx : ∃ n, x ∈ genFiltration k b s n) (hy : ∃ n, y ∈ genFiltration k b s n) :
    ∃ n, x + y ∈ genFiltration k b s n := by
  obtain ⟨n, hn⟩ := hx
  obtain ⟨m, hm⟩ := hy
  exact ⟨max n m, Submodule.add_mem _ (genFiltration_mono hw s (le_max_left n m) hn)
    (genFiltration_mono hw s (le_max_right n m) hm)⟩

theorem exists_mem_genFiltration_smul {w : Fin d} (hw : b w = 1)
    (hb : Function.Surjective (MvPolynomial.aeval (R := k) b)) (s : Set X) (c : B) (x : X)
    (hx : ∃ n, x ∈ genFiltration k b s n) : ∃ n, c • x ∈ genFiltration k b s n := by
  obtain ⟨p, rfl⟩ := hb c
  induction p using MvPolynomial.induction_on generalizing x with
  | C a =>
    obtain ⟨n, hn⟩ := hx
    refine ⟨n, ?_⟩
    rw [MvPolynomial.aeval_C, algebraMap_smul]
    exact Submodule.smul_mem _ a hn
  | add p q hp hq =>
    rw [map_add, add_smul]
    exact exists_mem_genFiltration_add hw s (hp x hx) (hq x hx)
  | mul_X p j hp =>
    obtain ⟨n, hn⟩ := hx
    rw [map_mul, MvPolynomial.aeval_X, mul_smul]
    exact hp (b j • x) ⟨n + 1, smul_mem_genFiltration j hn⟩

/-- **The generated filtration is exhaustive** if some `b w = 1`, the `b_j` generate `B` as a
`k`-algebra and `s` generates `X` as a `B`-module. -/
theorem exists_mem_genFiltration {w : Fin d} (hw : b w = 1)
    (hb : Function.Surjective (MvPolynomial.aeval (R := k) b)) {s : Set X}
    (hs : Submodule.span B s = ⊤) (x : X) : ∃ n, x ∈ genFiltration k b s n := by
  let P : Submodule B X :=
    { carrier := {x | ∃ n, x ∈ genFiltration k b s n}
      add_mem' := fun hx hy => exists_mem_genFiltration_add hw s hx hy
      zero_mem' := (⟨0, Submodule.zero_mem _⟩ : ∃ n, (0 : X) ∈ genFiltration k b s n)
      smul_mem' := by
        intro c x hx
        exact exists_mem_genFiltration_smul hw hb s c x hx }
  have hsP : s ⊆ P := fun y hy =>
    (⟨0, Submodule.subset_span hy⟩ : ∃ n, y ∈ genFiltration k b s n)
  have hP : (⊤ : Submodule B X) ≤ P := by
    rw [← hs]
    exact Submodule.span_le.mpr hsP
  exact hP Submodule.mem_top

/-- The supremum of the generated filtration is everything. -/
theorem iSup_genFiltration {w : Fin d} (hw : b w = 1)
    (hb : Function.Surjective (MvPolynomial.aeval (R := k) b)) {s : Set X}
    (hs : Submodule.span B s = ⊤) : ⨆ n, genFiltration k b s n = ⊤ := by
  refine eq_top_iff.mpr fun x _ => ?_
  obtain ⟨n, hn⟩ := exists_mem_genFiltration hw hb hs x
  exact Submodule.mem_iSup_of_mem n hn

/-- On a finite dimensional module the generated filtration is eventually everything. -/
theorem eventually_genFiltration_eq_top [Module.Finite k X] {w : Fin d} (hw : b w = 1)
    (hb : Function.Surjective (MvPolynomial.aeval (R := k) b)) {s : Set X}
    (hs : Submodule.span B s = ⊤) : ∀ᶠ n in Filter.atTop, genFiltration k b s n = ⊤ := by
  classical
  obtain ⟨t, ht⟩ := (Module.Finite.fg_top : (⊤ : Submodule k X).FG)
  choose nx hnx using exists_mem_genFiltration (k := k) hw hb hs
  rw [Filter.eventually_atTop]
  refine ⟨t.sup nx, fun n hn => eq_top_iff.mpr ?_⟩
  rw [← ht, Submodule.span_le]
  intro x hx
  exact genFiltration_mono hw s (le_trans (Finset.le_sup hx) hn) (hnx x)

end Filtration

/-! ### The Rees module -/

section Rees

variable (k : Type u) [Field k] {B : Type u} [CommRing B] [Algebra k B]
  (X : Type u) [AddCommGroup X] [Module B X] [Module k X] [IsScalarTower k B X]
  {d : ℕ} (b : Fin d → B)

/-- The `k`-algebra map `k[X_0, …, X_{d-1}] → B[T]`, `X_j ↦ b_j T`. -/
noncomputable def reesHom : MvPolynomial (Fin d) k →ₐ[k] Polynomial B :=
  MvPolynomial.aeval fun j => Polynomial.monomial 1 (b j)

/-- The polynomial module `X[T]`, regarded as a module over `k[X_0, …, X_{d-1}]` through
`X_j ↦ b_j T`. -/
def ReesAmb (_b : Fin d → B) : Type u :=
  PolynomialModule B X

noncomputable instance : AddCommGroup (ReesAmb X b) :=
  inferInstanceAs (AddCommGroup (PolynomialModule B X))

noncomputable instance : Module k (ReesAmb X b) :=
  inferInstanceAs (Module k (PolynomialModule B X))

noncomputable instance : Module (Polynomial B) (ReesAmb X b) :=
  inferInstanceAs (Module (Polynomial B) (PolynomialModule B X))

instance : IsScalarTower k (Polynomial B) (ReesAmb X b) :=
  inferInstanceAs (IsScalarTower k (Polynomial B) (PolynomialModule B X))

noncomputable instance : Module (MvPolynomial (Fin d) k) (ReesAmb X b) :=
  Module.compHom _ (reesHom k b).toRingHom

instance : IsScalarTower k (MvPolynomial (Fin d) k) (ReesAmb X b) where
  smul_assoc c p z := by
    change (reesHom k b (c • p)) • z = c • ((reesHom k b p) • z)
    rw [map_smul, smul_assoc]

variable {X}

/-- The element `x T^n` of `X[T]`. -/
noncomputable def reesSingle (n : ℕ) : X →ₗ[k] ReesAmb X b :=
  (PolynomialModule.coeffLinearEquiv B k).symm.toLinearMap.comp (Finsupp.lsingle n)

/-- The coefficient of `T^n`. -/
noncomputable def reesCoeff (n : ℕ) : ReesAmb X b →ₗ[k] X :=
  (Finsupp.lapply n).comp (PolynomialModule.coeffLinearEquiv B k).toLinearMap

omit [Algebra k B] [IsScalarTower k B X] in
theorem reesSingle_apply (n : ℕ) (x : X) :
    reesSingle k b n x = (PolynomialModule.single B n x : PolynomialModule B X) :=
  rfl

omit [Algebra k B] [IsScalarTower k B X] in
theorem reesCoeff_apply (n : ℕ) (z : ReesAmb X b) :
    reesCoeff k b n z = (z : PolynomialModule B X).coeff n :=
  rfl

omit [Module k X] [IsScalarTower k B X] in
theorem mvPolynomial_smul_reesAmb (p : MvPolynomial (Fin d) k) (z : ReesAmb X b) :
    p • z = reesHom k b p • z :=
  rfl

omit [Algebra k B] [IsScalarTower k B X] in
theorem reesCoeff_reesSingle (n m : ℕ) (x : X) :
    reesCoeff k b n (reesSingle k b m x) = if m = n then x else 0 := by
  rw [reesCoeff_apply, reesSingle_apply, PolynomialModule.coeff_single]
  exact Finsupp.single_apply

omit [IsScalarTower k B X] in
/-- `X_j` acts as `b_j T`. -/
theorem X_smul_reesSingle (j : Fin d) (n : ℕ) (x : X) :
    (MvPolynomial.X j : MvPolynomial (Fin d) k) • reesSingle k b n x =
      reesSingle k b (n + 1) (b j • x) := by
  have h : reesHom k b (MvPolynomial.X j) = Polynomial.monomial 1 (b j) :=
    MvPolynomial.aeval_X _ _
  rw [mvPolynomial_smul_reesAmb, h, reesSingle_apply, reesSingle_apply]
  exact (PolynomialModule.monomial_smul_single 1 (b j) n x).trans (by rw [Nat.add_comm])

variable (s : Set X)

/-- The Rees module of the filtration generated by `s`: the `k[X]`-span of `x T^0`, `x ∈ s`. -/
noncomputable def reesSubmodule : Submodule (MvPolynomial (Fin d) k) (ReesAmb X b) :=
  Submodule.span (MvPolynomial (Fin d) k) (reesSingle k b 0 '' s)

theorem reesSingle_mem : ∀ (n : ℕ) (x : X), x ∈ genFiltration k b s n →
    reesSingle k b n x ∈ reesSubmodule k b s
  | 0, x, hx => by
    have h : Submodule.span k s ≤
        ((reesSubmodule k b s).restrictScalars k).comap (reesSingle k b 0) :=
      Submodule.span_le.mpr fun y hy =>
        (Submodule.subset_span (Set.mem_image_of_mem (reesSingle k b 0) hy) :
          reesSingle k b 0 y ∈
            Submodule.span (MvPolynomial (Fin d) k) (reesSingle k b 0 '' s))
    exact h hx
  | n + 1, x, hx => by
    rw [genFiltration_succ] at hx
    refine Submodule.iSup_induction (fun j => (genFiltration k b s n).map (smulK k b j))
      (motive := fun y => reesSingle k b (n + 1) y ∈ reesSubmodule k b s) hx ?_ ?_ ?_
    · intro j y hy
      obtain ⟨y', hy', rfl⟩ := Submodule.mem_map.mp hy
      change reesSingle k b (n + 1) (b j • y') ∈ reesSubmodule k b s
      rw [← X_smul_reesSingle]
      exact Submodule.smul_mem _ _ (reesSingle_mem n y' hy')
    · show reesSingle k b (n + 1) 0 ∈ reesSubmodule k b s
      rw [map_zero]
      exact Submodule.zero_mem _
    · intro y y' h h'
      show reesSingle k b (n + 1) (y + y') ∈ reesSubmodule k b s
      rw [map_add]
      exact Submodule.add_mem _ h h'

/-- The inclusion of `F_n` as the degree `n` piece of the Rees module. -/
noncomputable def reesIncl (n : ℕ) : genFiltration k b s n →ₗ[k] reesSubmodule k b s where
  toFun y := ⟨reesSingle k b n (y : X), reesSingle_mem k b s n (y : X) y.2⟩
  map_add' y y' := Subtype.ext (map_add (reesSingle k b n) (y : X) y')
  map_smul' c y := Subtype.ext (map_smul (reesSingle k b n) c (y : X))

theorem coe_reesIncl (n : ℕ) (y : genFiltration k b s n) :
    ((reesIncl k b s n y : reesSubmodule k b s) : ReesAmb X b) = reesSingle k b n (y : X) :=
  rfl

theorem reesIncl_injective (n : ℕ) : Function.Injective (reesIncl k b s n) := by
  intro y y' h
  have h1 : reesCoeff k b n (reesSingle k b n (y : X)) =
      reesCoeff k b n (reesSingle k b n (y' : X)) :=
    congrArg (fun a : reesSubmodule k b s => reesCoeff k b n (a : ReesAmb X b)) h
  rw [reesCoeff_reesSingle, reesCoeff_reesSingle, ite_eq_left rfl, ite_eq_left rfl] at h1
  exact Subtype.ext h1

theorem X_smul_reesIncl (j : Fin d) (n : ℕ) (y : genFiltration k b s n) :
    (MvPolynomial.X j : MvPolynomial (Fin d) k) • reesIncl k b s n y =
      reesIncl k b s (n + 1) ⟨b j • (y : X), smul_mem_genFiltration j y.2⟩ := by
  apply Subtype.ext
  rw [Submodule.coe_smul, coe_reesIncl, coe_reesIncl]
  exact X_smul_reesSingle k b j n (y : X)

/-- The degree `n` piece of the Rees module. -/
noncomputable def reesGrading (n : ℕ) : Submodule k (reesSubmodule k b s) :=
  LinearMap.range (reesIncl k b s n)

theorem finrank_reesGrading (n : ℕ) :
    finrank k (reesGrading k b s n) = finrank k (genFiltration k b s n) :=
  LinearMap.finrank_range_of_inj (reesIncl_injective k b s n)

theorem reesGrading_iSupIndep : iSupIndep (reesGrading k b s) := by
  classical
  rw [iSupIndep_def]
  intro n
  let K : Submodule k (reesSubmodule k b s) :=
    LinearMap.ker ((reesCoeff k b n).comp ((reesSubmodule k b s).subtype.restrictScalars k))
  have hK : (⨆ (j) (_ : j ≠ n), reesGrading k b s j) ≤ K := by
    refine iSup₂_le fun j hj => ?_
    intro a ha
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp ha
    rw [LinearMap.mem_ker]
    change reesCoeff k b n (reesSingle k b j (y : X)) = 0
    rw [reesCoeff_reesSingle, ite_eq_right hj]
  rw [Submodule.disjoint_def]
  intro a ha ha'
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp ha
  have h0 := hK ha'
  rw [LinearMap.mem_ker] at h0
  have h1 : reesCoeff k b n (reesSingle k b n (y : X)) = 0 := h0
  rw [reesCoeff_reesSingle, ite_eq_left rfl] at h1
  have hy0 : y = 0 := Subtype.ext h1
  rw [hy0, map_zero]

theorem X_smul_mem_iSup_reesGrading (j : Fin d) {a : reesSubmodule k b s}
    (ha : a ∈ ⨆ n, reesGrading k b s n) :
    (MvPolynomial.X j : MvPolynomial (Fin d) k) • a ∈ ⨆ n, reesGrading k b s n := by
  refine Submodule.iSup_induction (reesGrading k b s)
    (motive := fun a => (MvPolynomial.X j : MvPolynomial (Fin d) k) • a ∈
      ⨆ n, reesGrading k b s n) ha ?_ ?_ ?_
  · intro n a ha
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp ha
    show (MvPolynomial.X j : MvPolynomial (Fin d) k) • reesIncl k b s n y ∈
      ⨆ n, reesGrading k b s n
    rw [X_smul_reesIncl]
    exact Submodule.mem_iSup_of_mem (n + 1) (LinearMap.mem_range_self (reesIncl k b s (n + 1)) _)
  · change (MvPolynomial.X j : MvPolynomial (Fin d) k) • (0 : reesSubmodule k b s) ∈
      ⨆ n, reesGrading k b s n
    rw [smul_zero]
    exact Submodule.zero_mem _
  · intro a a' h h'
    change (MvPolynomial.X j : MvPolynomial (Fin d) k) • (a + a') ∈ ⨆ n, reesGrading k b s n
    rw [smul_add]
    exact Submodule.add_mem _ h h'

theorem smul_mem_iSup_reesGrading (p : MvPolynomial (Fin d) k) (a : reesSubmodule k b s)
    (ha : a ∈ ⨆ n, reesGrading k b s n) : p • a ∈ ⨆ n, reesGrading k b s n := by
  induction p using MvPolynomial.induction_on generalizing a with
  | C c =>
    rw [MvPolynomial.C_eq_smul_one, smul_assoc, one_smul]
    exact Submodule.smul_mem _ c ha
  | add p q hp hq =>
    rw [add_smul]
    exact Submodule.add_mem _ (hp _ ha) (hq _ ha)
  | mul_X p j hp =>
    rw [mul_smul]
    exact hp _ (X_smul_mem_iSup_reesGrading k b s j ha)

theorem mem_iSup_reesGrading {z : ReesAmb X b}
    (hz : z ∈ Submodule.span (MvPolynomial (Fin d) k) (reesSingle k b 0 '' s)) :
    (⟨z, hz⟩ : reesSubmodule k b s) ∈ ⨆ n, reesGrading k b s n := by
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨y, hy, rfl⟩ := hx
    exact Submodule.mem_iSup_of_mem 0
      (LinearMap.mem_range.mpr ⟨⟨y, Submodule.subset_span hy⟩, rfl⟩)
  | zero => exact Submodule.zero_mem _
  | add x y hx hy ihx ihy => exact Submodule.add_mem _ ihx ihy
  | smul p x hx ih => exact smul_mem_iSup_reesGrading k b s p _ ih

theorem reesGrading_iSup_eq : iSup (reesGrading k b s) = ⊤ := by
  refine eq_top_iff.mpr fun a _ => ?_
  obtain ⟨z, hz⟩ := a
  exact mem_iSup_reesGrading k b s hz

/-- **The Rees module** of the filtration generated by a finite set `s`, an admissible graded
module over `k[X_0, …, X_{d-1}]`. -/
noncomputable def reesAdmissible (hs : s.Finite) : AdmissibleGradedModule k d where
  M := ↥(reesSubmodule k b s)
  tower := Submodule.isScalarTower _
  Mgr := reesGrading k b s
  iSupIndep := reesGrading_iSupIndep k b s
  iSup_eq := reesGrading_iSup_eq k b s
  finite n := by
    have := finiteDimensional_genFiltration (k := k) (b := b) hs n
    change Module.Finite k (LinearMap.range (reesIncl k b s n))
    infer_instance
  smul_mem i n x hx := by
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
    change (MvPolynomial.X i : MvPolynomial (Fin d) k) • reesIncl k b s n y ∈
      LinearMap.range (reesIncl k b s (n + 1))
    rw [X_smul_reesIncl]
    exact LinearMap.mem_range_self (reesIncl k b s (n + 1)) _
  fg := Module.Finite.span_of_finite _ (hs.image _)

theorem finrank_reesAdmissible_mgr (hs : s.Finite) (n : ℕ) :
    finrank k ((reesAdmissible k b s hs).Mgr n) = finrank k (genFiltration k b s n) :=
  finrank_reesGrading k b s n

/-! ### Families of subspaces of the filtration -/

/-- The graded family of the Rees module attached to a family `G n ≤ F_n`. -/
noncomputable def reesFamily (G : ℕ → Submodule k X) (n : ℕ) :
    Submodule k (reesSubmodule k b s) :=
  (Submodule.comap (genFiltration k b s n).subtype (G n)).map (reesIncl k b s n)

variable {k b s}

theorem mem_reesFamily {G : ℕ → Submodule k X} {n : ℕ} {a : reesSubmodule k b s} :
    a ∈ reesFamily k b s G n ↔
      ∃ y : genFiltration k b s n, (y : X) ∈ G n ∧ reesIncl k b s n y = a := by
  rw [reesFamily, Submodule.mem_map]
  exact Iff.rfl

theorem reesFamily_le {G G' : ℕ → Submodule k X} (h : ∀ n, G n ≤ G' n) (n : ℕ) :
    reesFamily k b s G n ≤ reesFamily k b s G' n :=
  Submodule.map_mono (Submodule.comap_mono (h n))

theorem le_of_reesFamily_le {G G' : ℕ → Submodule k X} {n : ℕ}
    (hG : G n ≤ genFiltration k b s n) (h : reesFamily k b s G n ≤ reesFamily k b s G' n) :
    G n ≤ G' n := by
  intro x hx
  obtain ⟨y', hy', heq⟩ := mem_reesFamily.mp (h (mem_reesFamily.mpr ⟨⟨x, hG hx⟩, hx, rfl⟩))
  have hy : y' = ⟨x, hG hx⟩ := reesIncl_injective k b s n heq
  rw [hy] at hy'
  exact hy'

theorem finrank_reesFamily {G : ℕ → Submodule k X} {n : ℕ}
    (hG : G n ≤ genFiltration k b s n) :
    finrank k (reesFamily k b s G n) = finrank k (G n) := by
  have e1 := (Submodule.equivMapOfInjective (reesIncl k b s n) (reesIncl_injective k b s n)
    (Submodule.comap (genFiltration k b s n).subtype (G n))).finrank_eq
  have e2 := (Submodule.comapSubtypeEquivOfLe hG).finrank_eq
  rw [reesFamily, ← e1, e2]

theorem isGradedFamily_reesFamily (hs : s.Finite) {G : ℕ → Submodule k X}
    (hG : ∀ (j : Fin d) (n : ℕ) (x : X), x ∈ G n → b j • x ∈ G (n + 1)) :
    (reesAdmissible k b s hs).IsGradedFamily (reesFamily k b s G) where
  le_mgr n := by
    change reesFamily k b s G n ≤ reesGrading k b s n
    rw [reesFamily]
    exact LinearMap.map_le_range
  smul_mem i n a ha := by
    obtain ⟨y, hy, rfl⟩ := mem_reesFamily.mp ha
    exact mem_reesFamily.mpr ⟨⟨b i • (y : X), smul_mem_genFiltration i y.2⟩, hG i n y hy,
      (X_smul_reesIncl k b s i n y).symm⟩

theorem smulMapsTo_reesFamily_X (hs : s.Finite) {P Q : ℕ → Submodule k X} (j : Fin d)
    (hPQ : ∀ (n : ℕ) (x : X), x ∈ Q n → b j • x ∈ P (n + 1)) :
    (reesAdmissible k b s hs).SMulMapsTo (reesFamily k b s P) (reesFamily k b s Q)
      (MvPolynomial.X j) 1 := by
  intro n a ha
  obtain ⟨y, hy, rfl⟩ := mem_reesFamily.mp ha
  exact mem_reesFamily.mpr ⟨⟨b j • (y : X), smul_mem_genFiltration j y.2⟩, hPQ n y hy,
    (X_smul_reesIncl k b s j n y).symm⟩

theorem smulMapsTo_reesFamily_sq (hs : s.Finite) {P Q : ℕ → Submodule k X} (i₁ i₂ : Fin d)
    (hPQ : ∀ (n : ℕ) (x : X), x ∈ Q n → b i₁ • b i₁ • x + b i₂ • b i₂ • x ∈ P (n + 2)) :
    (reesAdmissible k b s hs).SMulMapsTo (reesFamily k b s P) (reesFamily k b s Q)
      ((MvPolynomial.X i₁ : MvPolynomial (Fin d) k) ^ 2 + MvPolynomial.X i₂ ^ 2) 2 := by
  intro n a ha
  obtain ⟨y, hy, rfl⟩ := mem_reesFamily.mp ha
  have m₁ : b i₁ • b i₁ • (y : X) ∈ genFiltration k b s (n + 1 + 1) :=
    smul_mem_genFiltration i₁ (smul_mem_genFiltration i₁ y.2)
  have m₂ : b i₂ • b i₂ • (y : X) ∈ genFiltration k b s (n + 1 + 1) :=
    smul_mem_genFiltration i₂ (smul_mem_genFiltration i₂ y.2)
  let z : genFiltration k b s (n + 1 + 1) :=
    ⟨b i₁ • b i₁ • (y : X) + b i₂ • b i₂ • (y : X), Submodule.add_mem _ m₁ m₂⟩
  have key : ((MvPolynomial.X i₁ : MvPolynomial (Fin d) k) ^ 2 + MvPolynomial.X i₂ ^ 2) •
      reesIncl k b s n y = reesIncl k b s (n + 1 + 1) z := by
    rw [add_smul, pow_two, pow_two, mul_smul, mul_smul, X_smul_reesIncl, X_smul_reesIncl,
      X_smul_reesIncl, X_smul_reesIncl, ← map_add]
    rfl
  exact mem_reesFamily.mpr ⟨z, hPQ n y hy, key.symm⟩

end Rees

