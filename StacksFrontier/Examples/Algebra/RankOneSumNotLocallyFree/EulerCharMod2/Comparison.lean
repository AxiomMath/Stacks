module

public import Mathlib.Data.Nat.Multiplicity
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Tactic.Linarith
public import StacksFrontier.Examples.Algebra.RankOneSumNotLocallyFree.EulerCharMod2.Rees
public import StacksFrontier.RingTheory.HilbertFunction.DegreeBound

/-!
# Comparison of filtrations modulo two

Let `k` be a field in which `-1` is not a square, and let `B` be a commutative `k`-algebra
generated by elements `b_0, …, b_{d-1}` which are of three kinds: `b_w = 1`, pairs
`(b_{u i}, b_{v i})` with `b_{u i}^2 + b_{v i}^2 = 1`, and further elements equal to `1`
(`Stacks.Examples.CircleTorus.CircleData`). For a `B`-module `X` let `F_n` be the filtration
generated by a finite set and let `Z_n` be any increasing family of subspaces stable under the
`b_j`. Then `dim (F_n ∩ Z_n)` and `dim (F_n ∩ ⋃ Z)` have the same parity for all large `n`.

The proof works in the Rees module of `F`. The families `G_j = (F_n ∩ Z_{n+j})_n` increase with
`j` and stabilize by noetherianity at `F ∩ ⋃ Z`; between `G_j` and `G_{j+1}` the variable `w`
maps `G_{j+1}` into `G_j`, and `u_i^2 + v_i^2` acts as `w^2`, so the evenness lemma
`AdmissibleGradedModule.eventually_even_finrank_iff_of_pairs` applies.

Two consequences are that the parity of `dim F_n` does not depend, for large `n`, on the
finite generating set, and that it is additive on short exact sequences up to the comparison of
the induced filtration on a submodule with a generated one.

We also record the value modulo two along `n = 2 ^ K` of a numerical polynomial: if
`f n = ∑_i C(n, i) a_i` for large `n`, then `f (2 ^ K) ≡ a_0 (mod 2)` for large `K`, since
`C(2 ^ K, i)` is even for `0 < i < 2 ^ K`. This defines the invariant `evenLimit`.

## Main definitions

* `Stacks.Examples.CircleTorus.CircleData`: the generators of `B`.
* `Stacks.Examples.CircleTorus.evenLimit`: the eventual value of `f (2 ^ K)` modulo two.

## Main results

* `Stacks.Examples.CircleTorus.eventually_even_finrank_inf_iff`: the comparison lemma.
* `Stacks.Examples.CircleTorus.eventually_natCast_finrank_genFiltration_eq`: independence of
  the generating set modulo two.
* `Stacks.Examples.CircleTorus.evenLimit_eq_of_numerical`: `evenLimit` of a numerical polynomial
  is its constant coefficient modulo two.
* `Stacks.Examples.CircleTorus.exists_eventually_finrank_genFiltration_pow_two`: the eventual
  value exists for a generated filtration (Hilbert–Serre).
* `Stacks.Examples.CircleTorus.not_isSquare_neg_one_rat`: `-1` is not a square in `ℚ`.
-/

@[expose] public section

open Module Filter

namespace Stacks.Examples.CircleTorus

open Stacks.HilbertFunction.PolynomialQuotient

universe u

/-- `-1` is not a square in `ℚ`. -/
theorem not_isSquare_neg_one_rat : ¬ IsSquare (-1 : ℚ) := by
  rintro ⟨r, hr⟩
  have h := mul_self_nonneg r
  linarith

/-- Generators `b_0, …, b_{d-1}` of a `k`-algebra `B`: `b_w = 1`, pairs `(b_{u i}, b_{v i})`
on the circle `x^2 + y^2 = 1`, and every other generator equal to `1`. -/
structure CircleData (k : Type u) [Field k] (B : Type u) [CommRing B] [Algebra k B] where
  /-- the number of generators -/
  d : ℕ
  /-- the generators -/
  b : Fin d → B
  /-- the number of pairs -/
  r : ℕ
  /-- the first coordinate of each pair -/
  u : Fin r → Fin d
  /-- the second coordinate of each pair -/
  v : Fin r → Fin d
  /-- the index of the generator `1` -/
  w : Fin d
  /-- the generator `b w` is `1` -/
  b_w : b w = 1
  /-- the generators outside the pairs are `1` -/
  b_other : ∀ j : Fin d, (∀ i, j ≠ u i ∧ j ≠ v i) → b j = 1
  /-- each pair lies on the circle -/
  b_sq : ∀ i, b (u i) * b (u i) + b (v i) * b (v i) = 1
  /-- the generators generate `B` as a `k`-algebra -/
  surj : Function.Surjective (MvPolynomial.aeval (R := k) b)

/-! ### The comparison lemma -/

section Comparison

variable {k : Type u} [Field k] {B : Type u} [CommRing B] [Algebra k B]
  {X : Type u} [AddCommGroup X] [Module B X] [Module k X] [IsScalarTower k B X]

/-- The family `n ↦ Y n ⊓ Z (j + n)`. -/
def shiftInf (Y Z : ℕ → Submodule k X) (j n : ℕ) : Submodule k X :=
  Y n ⊓ Z (j + n)

theorem mem_shiftInf {Y Z : ℕ → Submodule k X} {j n : ℕ} {x : X} :
    x ∈ shiftInf Y Z j n ↔ x ∈ Y n ∧ x ∈ Z (j + n) :=
  Submodule.mem_inf

theorem shiftInf_zero (Y Z : ℕ → Submodule k X) (n : ℕ) : shiftInf Y Z 0 n = Y n ⊓ Z n := by
  rw [shiftInf, Nat.zero_add]

theorem shiftInf_le_left (Y Z : ℕ → Submodule k X) (j n : ℕ) : shiftInf Y Z j n ≤ Y n :=
  inf_le_left

theorem shiftInf_mono_left {Y Z : ℕ → Submodule k X} (hZ : Monotone Z) {j j' : ℕ} (h : j ≤ j')
    (n : ℕ) : shiftInf Y Z j n ≤ shiftInf Y Z j' n :=
  inf_le_inf_left _ (hZ (Nat.add_le_add_right h n))

theorem shiftInf_succ_le {Y Z : ℕ → Submodule k X} (hY : Monotone Y) (j n : ℕ) :
    shiftInf Y Z (j + 1) n ≤ shiftInf Y Z j (n + 1) := by
  intro x hx
  rw [mem_shiftInf] at hx ⊢
  have h : j + 1 + n = j + (n + 1) := by omega
  rw [h] at hx
  exact ⟨hY (Nat.le_succ n) hx.1, hx.2⟩

theorem shiftInf_le_succ {Y Z : ℕ → Submodule k X} (hY : Monotone Y) (hZ : Monotone Z)
    (j n : ℕ) : shiftInf Y Z j n ≤ shiftInf Y Z j (n + 1) :=
  inf_le_inf (hY (Nat.le_succ n)) (hZ (Nat.le_succ (j + n)))

variable (D : CircleData k B)

/-- **Comparison lemma.** Let `F` be the filtration generated by a finite set `s` and `Z` an
increasing family of subspaces with `b_j Z_n ⊆ Z_{n+1}`. Then `dim (F_n ∩ Z_n)` and
`dim (F_n ∩ ⋃ Z)` have the same parity for all large `n`. -/
theorem eventually_even_finrank_inf_iff (hk : ¬ IsSquare (-1 : k)) {s : Set X}
    (hs : s.Finite) (Z : ℕ → Submodule k X) (hZmono : Monotone Z)
    (hZ : ∀ (j : Fin D.d) (n : ℕ) (x : X), x ∈ Z n → D.b j • x ∈ Z (n + 1)) :
    ∀ᶠ n in atTop, (Even (finrank k ↥(genFiltration k D.b s n ⊓ Z n)) ↔
      Even (finrank k ↥(genFiltration k D.b s n ⊓ ⨆ m, Z m))) := by
  classical
  have hYmono : Monotone (genFiltration k D.b s) := genFiltration_mono D.b_w s
  let A := reesAdmissible k D.b s hs
  let G : ℕ → ℕ → Submodule k X := shiftInf (genFiltration k D.b s) Z
  have hGle : ∀ j n, G j n ≤ genFiltration k D.b s n := fun j n =>
    shiftInf_le_left (genFiltration k D.b s) Z j n
  have hGgr : ∀ j (i : Fin D.d) (n : ℕ) (x : X), x ∈ G j n → D.b i • x ∈ G j (n + 1) := by
    intro j i n x hx
    have hx' := mem_shiftInf.mp hx
    exact mem_shiftInf.mpr ⟨smul_mem_genFiltration i hx'.1, hZ i (j + n) x hx'.2⟩
  have hmonoG : ∀ j n, G j n ≤ G (j + 1) n := fun j n =>
    shiftInf_mono_left hZmono (Nat.le_succ j) n
  have hfam : ∀ j, A.IsGradedFamily (reesFamily k D.b s (G j)) := fun j =>
    isGradedFamily_reesFamily hs (hGgr j)
  -- one step of the chain
  have step : ∀ j, ∀ᶠ n in atTop,
      (Even (finrank k (G j n)) ↔ Even (finrank k (G (j + 1) n))) := by
    intro j
    have h := AdmissibleGradedModule.eventually_even_finrank_iff_of_pairs A hk D.u D.v
      Finset.univ (reesFamily k D.b s (G j)) (reesFamily k D.b s (G (j + 1))) (hfam j)
      (hfam (j + 1)) (reesFamily_le (hmonoG j))
      (fun i hi => smulMapsTo_reesFamily_X hs i fun n x hx => by
        have hb : D.b i = 1 := D.b_other i fun i' => hi i' (Finset.mem_univ i')
        rw [hb, one_smul]
        exact shiftInf_succ_le hYmono j n hx)
      (fun i _ => smulMapsTo_reesFamily_sq hs (D.u i) (D.v i) fun n x hx => by
        rw [← mul_smul, ← mul_smul, ← add_smul, D.b_sq i, one_smul]
        exact shiftInf_le_succ hYmono hZmono j (n + 1) (shiftInf_succ_le hYmono j n hx))
    filter_upwards [h] with n hn
    have e1 : finrank k (reesFamily k D.b s (G j) n) = finrank k (G j n) :=
      finrank_reesFamily (hGle j n)
    have e2 : finrank k (reesFamily k D.b s (G (j + 1)) n) = finrank k (G (j + 1) n) :=
      finrank_reesFamily (hGle (j + 1) n)
    rw [← e1, ← e2]
    exact hn
  -- the chain from `G 0` to `G j`
  have chain : ∀ j, ∀ᶠ n in atTop, (Even (finrank k (G 0 n)) ↔ Even (finrank k (G j n))) := by
    intro j
    induction j with
    | zero => exact Eventually.of_forall fun n => Iff.rfl
    | succ j ih =>
      filter_upwards [ih, step j] with n h1 h2
      exact h1.trans h2
  -- stabilization
  obtain ⟨J, hJ⟩ := AdmissibleGradedModule.exists_stable_of_monotone (A := A)
    (fun j => reesFamily k D.b s (G j)) hfam (fun j => reesFamily_le (hmonoG j))
  have hGJ : ∀ n, G J n = genFiltration k D.b s n ⊓ ⨆ m, Z m := by
    intro n
    apply le_antisymm
    · intro x hx
      have hx' := mem_shiftInf.mp hx
      exact Submodule.mem_inf.mpr ⟨hx'.1, Submodule.mem_iSup_of_mem (J + n) hx'.2⟩
    · intro x hx
      have hx' := Submodule.mem_inf.mp hx
      obtain ⟨m, hm⟩ := (Submodule.mem_iSup_of_directed Z hZmono.directed_le).mp hx'.2
      have h1 : x ∈ G m n := mem_shiftInf.mpr ⟨hx'.1, hZmono (Nat.le_add_right m n) hm⟩
      have h2 : x ∈ G (max J m) n := shiftInf_mono_left hZmono (le_max_right J m) n h1
      exact le_of_reesFamily_le (hGle (max J m) n) (hJ (max J m) (le_max_left J m) n) h2
  have h0 : ∀ n, G 0 n = genFiltration k D.b s n ⊓ Z n := fun n =>
    shiftInf_zero (genFiltration k D.b s) Z n
  filter_upwards [chain J] with n hn
  rw [hGJ n, h0 n] at hn
  exact hn

/-! ### Independence of the generating set -/

/-- A parity equivalence gives an equality in `ZMod 2`. -/
theorem natCast_eq_of_even_iff {a c : ℕ} (h : Even a ↔ Even c) : (a : ZMod 2) = (c : ZMod 2) := by
  rw [ZMod.natCast_eq_natCast_iff']
  rw [Nat.even_iff, Nat.even_iff] at h
  rcases Nat.mod_two_eq_zero_or_one a with ha | ha <;>
    rcases Nat.mod_two_eq_zero_or_one c with hc | hc
  · rw [ha, hc]
  · exact absurd (h.mp ha) (by omega)
  · exact absurd (h.mpr hc) (by omega)
  · rw [ha, hc]

/-- For a finite generating set `s` and any finite set `t`, the filtrations generated by `s` and
by `s ∪ t` have dimensions of the same parity in all large degrees. -/
theorem eventually_natCast_finrank_genFiltration_union (hk : ¬ IsSquare (-1 : k)) {s t : Set X}
    (hs : s.Finite) (ht : t.Finite) (hspan : Submodule.span B s = ⊤) :
    ∀ᶠ n in atTop, (finrank k (genFiltration k D.b s n) : ZMod 2) =
      finrank k (genFiltration k D.b (s ∪ t) n) := by
  have h := eventually_even_finrank_inf_iff D hk (hs.union ht) (genFiltration k D.b s)
    (genFiltration_mono D.b_w s) (fun j n x hx => smul_mem_genFiltration j hx)
  rw [iSup_genFiltration D.b_w D.surj hspan] at h
  filter_upwards [h] with n hn
  rw [inf_top_eq, inf_eq_right.mpr (genFiltration_mono_set Set.subset_union_left n)] at hn
  exact natCast_eq_of_even_iff hn

/-- **Independence of the generating set**: two finite generating sets give filtrations whose
dimensions agree modulo two in all large degrees. -/
theorem eventually_natCast_finrank_genFiltration_eq (hk : ¬ IsSquare (-1 : k)) {s t : Set X}
    (hs : s.Finite) (ht : t.Finite) (hspans : Submodule.span B s = ⊤)
    (hspant : Submodule.span B t = ⊤) :
    ∀ᶠ n in atTop, (finrank k (genFiltration k D.b s n) : ZMod 2) =
      finrank k (genFiltration k D.b t n) := by
  filter_upwards [eventually_natCast_finrank_genFiltration_union D hk hs ht hspans,
    eventually_natCast_finrank_genFiltration_union D hk ht hs hspant] with n h1 h2
  rw [Set.union_comm t s] at h2
  rw [h1, h2]

end Comparison

/-! ### The value modulo two along powers of two -/

open Classical in
/-- The eventual value of `f (2 ^ K)` modulo two, and `0` if there is none. For a numerical
polynomial `f n = ∑_i C(n, i) a_i` it is `a_0` modulo two (`evenLimit_eq_of_numerical`). -/
noncomputable def evenLimit (f : ℕ → ℕ) : ZMod 2 :=
  if h : ∃ e : ZMod 2, ∀ᶠ K in atTop, (f (2 ^ K) : ZMod 2) = e then h.choose else 0

theorem evenLimit_eq {f : ℕ → ℕ} {e : ZMod 2} (h : ∀ᶠ K in atTop, (f (2 ^ K) : ZMod 2) = e) :
    evenLimit f = e := by
  have hex : ∃ e : ZMod 2, ∀ᶠ K in atTop, (f (2 ^ K) : ZMod 2) = e := ⟨e, h⟩
  rw [evenLimit, dite_eq_left hex]
  obtain ⟨K, hK⟩ := (hex.choose_spec.and h).exists
  exact hK.1.symm.trans hK.2

theorem eventually_pow_two {p : ℕ → Prop} (h : ∀ᶠ n in atTop, p n) :
    ∀ᶠ K in atTop, p (2 ^ K) := by
  rw [eventually_atTop] at h ⊢
  obtain ⟨N, hN⟩ := h
  exact ⟨N, fun K hK => hN _ (hK.trans (Nat.lt_two_pow_self (n := K)).le)⟩

/-- Eventually congruent functions have the same `evenLimit`, provided one of them has an
eventual value. -/
theorem evenLimit_eq_of_eventually {f g : ℕ → ℕ}
    (hg : ∃ e : ZMod 2, ∀ᶠ K in atTop, (g (2 ^ K) : ZMod 2) = e)
    (h : ∀ᶠ n in atTop, (f n : ZMod 2) = g n) : evenLimit f = evenLimit g := by
  obtain ⟨e, he⟩ := hg
  rw [evenLimit_eq he]
  apply evenLimit_eq
  filter_upwards [eventually_pow_two h, he] with K h1 h2
  rw [h1, h2]

theorem evenLimit_add {f g : ℕ → ℕ}
    (hf : ∃ e : ZMod 2, ∀ᶠ K in atTop, (f (2 ^ K) : ZMod 2) = e)
    (hg : ∃ e : ZMod 2, ∀ᶠ K in atTop, (g (2 ^ K) : ZMod 2) = e) :
    evenLimit (fun n => f n + g n) = evenLimit f + evenLimit g := by
  obtain ⟨e₁, h₁⟩ := hf
  obtain ⟨e₂, h₂⟩ := hg
  rw [evenLimit_eq h₁, evenLimit_eq h₂]
  apply evenLimit_eq
  filter_upwards [h₁, h₂] with K hK₁ hK₂
  show ((f (2 ^ K) + g (2 ^ K) : ℕ) : ZMod 2) = e₁ + e₂
  rw [Nat.cast_add, hK₁, hK₂]

/-- Modulo two, a numerical polynomial `∑_i C(n, i) a_i` takes the value `a_0` at `n = 2 ^ K`
for all large `K`. -/
theorem eventually_natCast_pow_two_eq {f : ℕ → ℕ} {t : ℕ} {a : Fin (t + 1) → ℤ}
    (ha : ∀ᶠ n in atTop, (f n : ℤ) = ∑ i : Fin (t + 1), (n.choose (i : ℕ)) • a i) :
    ∀ᶠ K in atTop, (f (2 ^ K) : ZMod 2) = (a 0 : ZMod 2) := by
  have hK : ∀ᶠ K in atTop, t < 2 ^ K :=
    eventually_atTop.mpr ⟨t, fun K hK => lt_of_le_of_lt hK (Nat.lt_two_pow_self (n := K))⟩
  filter_upwards [eventually_pow_two ha, hK] with K hK1 hK2
  have h1 : (f (2 ^ K) : ZMod 2) = (((f (2 ^ K) : ℕ) : ℤ) : ZMod 2) := (Int.cast_natCast _).symm
  rw [h1, hK1, Int.cast_sum, Fin.sum_univ_succ, Finset.sum_eq_zero, add_zero]
  · simp only [Fin.val_zero, Nat.choose_zero_right, one_smul]
  · intro i _
    have hne0 : ((i.succ : Fin (t + 1)) : ℕ) ≠ 0 := by
      rw [Fin.val_succ]
      omega
    have hne : ((i.succ : Fin (t + 1)) : ℕ) ≠ 2 ^ K := by
      rw [Fin.val_succ]
      have := i.isLt
      omega
    have hdvd : 2 ∣ (2 ^ K).choose ((i.succ : Fin (t + 1)) : ℕ) :=
      Nat.Prime.dvd_choose_pow Nat.prime_two hne0 hne
    rw [nsmul_eq_mul, Int.cast_mul, Int.cast_natCast, (ZMod.natCast_eq_zero_iff _ _).mpr hdvd,
      zero_mul]

/-- **`evenLimit` of a numerical polynomial** is its constant coefficient modulo two. -/
theorem evenLimit_eq_of_numerical {f : ℕ → ℕ} {t : ℕ} {a : Fin (t + 1) → ℤ}
    (ha : ∀ᶠ n in atTop, (f n : ℤ) = ∑ i : Fin (t + 1), (n.choose (i : ℕ)) • a i) :
    evenLimit f = (a 0 : ZMod 2) :=
  evenLimit_eq (eventually_natCast_pow_two_eq ha)

section Existence

variable {k : Type u} [Field k] {B : Type u} [CommRing B] [Algebra k B]
  {X : Type u} [AddCommGroup X] [Module B X] [Module k X] [IsScalarTower k B X]
  {d : ℕ} (b : Fin d → B)

/-- **Hilbert–Serre**: for the filtration generated by a finite set, `dim F_n` is a numerical
polynomial, so its value modulo two along `n = 2 ^ K` is eventually constant. -/
theorem exists_eventually_finrank_genFiltration_pow_two {s : Set X} (hs : s.Finite) :
    ∃ e : ZMod 2, ∀ᶠ K in atTop, (finrank k (genFiltration k b s (2 ^ K)) : ZMod 2) = e := by
  obtain ⟨t, a, ha⟩ := isNumericalPolynomialByNaturalArgs_hilb d (reesAdmissible k b s hs)
  refine ⟨(a 0 : ZMod 2), eventually_natCast_pow_two_eq (t := t) (a := a) (f := fun n =>
    finrank k (genFiltration k b s n)) ?_⟩
  filter_upwards [ha] with n hn
  rw [← hn]
  change (finrank k (genFiltration k b s n) : ℤ) =
    (finrank k ((reesAdmissible k b s hs).Mgr n) : ℤ)
  rw [finrank_reesAdmissible_mgr]

end Existence

end Stacks.Examples.CircleTorus
