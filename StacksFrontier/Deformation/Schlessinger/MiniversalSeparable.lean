module

public import Mathlib.FieldTheory.Separable
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Deformation.FormalObject.DerivationOrbits
public import StacksFrontier.Deformation.MinimalVersal
public import StacksFrontier.Deformation.PredeformationTangent.DerivationAction
public import StacksFrontier.Deformation.Schlessinger.VersalBijectiveDifferential
public import StacksFrontier.Deformation.TangentSpace.BijectiveDifferential

/-!
# Orbitwise bijectivity is bijectivity over a separable residue field (Stacks 06IX)

Stacks 06IX is the theorem that for a predeformation category the following are
equivalent: (1) it has a minimal versal formal object with bijective differential;
(2) it has one whose differential is bijective only after passing to
`Der_Λ(k, k)`-orbits; (3) it satisfies (S1), (S2) and has a finite-dimensional
tangent space.

This file proves the implications from (1) to (3b) and (3c), and that (2) implies (1) when
`k` is separable over the image field `k'` of `Λ`. The implications from (1) to the parts of
(3) are special cases of Tags 06SY and 06IV, which ask for a versal formal object rather than a
minimal one; (3a) is Tag 06SY. When `k` is separable over `k'`, `Der_Λ(k, k) = 0`, so the
orbits are singletons and orbitwise bijectivity is bijectivity.

`Der_Λ(k, k)` vanishes because a `Λ`-derivation of `k` kills the subfield generated by the
image of `Λ`, so it is a `k'`-derivation, and a `k'`-derivation of a separable extension
kills the minimal polynomial of every element while the derivative of that polynomial does
not vanish there.

## Main results

* `Deformation.exists_minimalVersal_hasBijectiveDifferential_of_separable`:
  **Stacks 06IX**, (2) implies (1) under separability.
* `Deformation.schlessingerConditionS2_of_minimalVersal_hasBijectiveDifferential` and
  `Deformation.finiteDimensional_tangentSpace_of_minimalVersal_hasBijectiveDifferential`:
  **Stacks 06IX**, (1) implies the parts (3b) and (3c) of (3).
* `Deformation.derivation_eq_zero_of_residueImageField_separable`: the residue field carries
  no nonzero `Λ`-derivation when it is separable over the image field of `Λ`.
* `Deformation.existsUnique_derivationDifferentialGraph`: the differential of an arbitrary
  formal object relates every derivation of its underlying algebra to a unique tangent
  vector. This is the well-definedness clause of Tag 06T6's
  `Deformation.HasBijectiveDifferentialOnDerivationOrbits`.

## Implementation notes

The translation between the two spellings of a derivation of `ξ.base` — `Derivations ξ.base k`,
whose module structures are restricted along the residue map, and the ordinary
`Derivation Λ ξ.base k` for the induced algebra structure — is carried by
`Deformation.derivationToStandard` and `Deformation.standardToDerivation`. Together with
`Deformation.derivationDifferentialGraph_eq_derivationToTangent` and
`Deformation.derivationToTangent_graph` these identify the relational form of the differential
used by Tag 06T6 with the functional form `Deformation.derivationToTangent`.
-/

@[expose] public section

open CategoryTheory IsLocalRing

namespace Deformation

universe u v w uF vF

open Polynomial

/-- A `Λ`-derivation of `k` vanishes when `k` is separable over the image field of `Λ`. -/
public theorem derivation_eq_zero_of_residueImageField_separable
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    [Algebra.IsSeparable (Deformation.residueImageField Λ k) k]
    (D : Derivation Λ k k) : D = 0 := by
  let K := Deformation.residueImageField Λ k
  have hsep : ∀ x : k, IsSeparable K x := Algebra.IsSeparable.isSeparable K
  let ker : Subfield k :=
    { carrier := {x | D x = 0}
      zero_mem' := by simp
      one_mem' := D.map_one_eq_zero
      add_mem' := by
        intro x y hx hy
        show D (x + y) = 0
        rw [D.map_add, hx, hy]
        simp
      neg_mem' := by
        intro x hx
        show D (-x) = 0
        rw [D.map_neg, hx]
        simp
      mul_mem' := by
        intro x y hx hy
        show D (x * y) = 0
        rw [D.leibniz, hx, hy]
        simp
      inv_mem' := by
        intro x hx
        by_cases hxn : x = 0
        · simp [hxn]
        · have h := D.leibniz x x⁻¹
          rw [mul_inv_cancel₀ hxn, D.map_one_eq_zero] at h
          have hx' : D x = 0 := hx
          have hmul : x * D x⁻¹ = 0 := by
            simpa [Algebra.smul_def, hx'] using h.symm
          exact (mul_eq_zero.mp hmul).resolve_left hxn }
  have hK : ∀ x : K, D (x : k) = 0 := by
    have hle : Subfield.closure (Set.range (algebraMap Λ k)) ≤ ker :=
      Subfield.closure_le.2 (by
        rintro x ⟨a, rfl⟩
        exact D.map_algebraMap a)
    intro x
    exact hle x.2
  let : Algebra Λ K :=
    RingHom.toAlgebra ((algebraMap Λ k).codRestrict K
      (fun x => Subfield.subset_closure ⟨x, rfl⟩))
  let : Algebra K k := K.subtype.toAlgebra
  let : IsScalarTower Λ K k := IsScalarTower.of_algebraMap_eq' (by
    ext x
    rfl)
  let DK : Derivation K k k :=
    { toLinearMap :=
        { toFun := D
          map_add' := by
            intro s t
            show D (s + t) = D s + D t
            exact D.map_add s t
          map_smul' := by
            intro a x
            show D ((a : k) * x) = (a : k) * D x
            rw [D.leibniz, hK a]
            simp }
      map_one_eq_zero' := D.map_one_eq_zero
      leibniz' := D.leibniz }
  apply Derivation.ext
  intro x
  have hroot : aeval x (minpoly K x) = 0 := minpoly.aeval K x
  have hDroot : DK (aeval x (minpoly K x)) = 0 := by rw [hroot]; simp
  rw [DK.map_aeval] at hDroot
  have hderiv : aeval x (derivative (minpoly K x)) ≠ 0 :=
    Separable.aeval_derivative_ne_zero (hsep x) hroot
  have hmul : aeval x (derivative (minpoly K x)) * D x = 0 := by
    change (aeval x (derivative (minpoly K x))) * DK x = 0 at hDroot
    simpa [DK] using hDroot
  exact (mul_eq_zero.mp hmul).resolve_left hderiv

/-- **Stacks Project, Tag 06IX,** the implication (1) implies (3b). A predeformation category
with a minimal versal formal object whose differential is bijective — that is, one satisfying
the condition of Stacks 06IM — satisfies Schlessinger's condition (S2).

This is part (2) of Stacks 06IV, which asks only for versality, restated under the hypothesis
(1) of Stacks 06IX. -/
@[stacks 06IX "(1) implies (3b)"]
public theorem schlessingerConditionS2_of_minimalVersal_hasBijectiveDifferential
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    (𝓕 : BasedCategory.{vF, uF} (Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k))
    (hpre : Deformation.IsPredeformationCategory 𝓕.p)
    (hξ : ∃ ξ : Deformation.FormalObject 𝓕.p,
      Deformation.IsMinimalVersal hpre.cofibered ξ ∧
        Deformation.HasBijectiveDifferential hpre.cofibered ξ) :
    Deformation.SchlessingerConditionS2 𝓕.p :=
  hξ.elim fun ξ h ↦
    Deformation.schlessingerConditionS2_of_versal_bijectiveDifferential 𝓕.p hpre ξ h.1.1 h.2

/-- **Stacks Project, Tag 06IX,** the implication (1) implies (3c). The tangent space of a
predeformation category with a minimal versal formal object whose differential is bijective —
that is, one satisfying the condition of Stacks 06IM — is finite dimensional.

This is part (3) of Stacks 06IV, which asks only for versality, restated under the hypothesis
(1) of Stacks 06IX. The canonical `k`-vector-space structure of Stacks 06IH on the tangent
space needs the predeformation property of `𝓕` and condition (S2) for its functor of
isomorphism classes; the first is `hpre` and the second comes from
`Deformation.schlessingerConditionS2_of_minimalVersal_hasBijectiveDifferential`, the
implication (1) implies (3b), so both are installed by the `letI` prefix of the conclusion and
neither is assumed. -/
@[stacks 06IX "(1) implies (3c)", sga "7 VI 1.11" "(ii)"]
public theorem finiteDimensional_tangentSpace_of_minimalVersal_hasBijectiveDifferential
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k]
    (𝓕 : BasedCategory.{vF, uF} (Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k))
    (hpre : Deformation.IsPredeformationCategory 𝓕.p)
    (hξ : ∃ ξ : Deformation.FormalObject 𝓕.p,
      Deformation.IsMinimalVersal hpre.cofibered ξ ∧
        Deformation.HasBijectiveDifferential hpre.cofibered ξ) :
    letI : Fact (Deformation.IsPredeformationCategory 𝓕.p) := ⟨hpre⟩
    letI : Fact (Deformation.SchlessingerConditionS2 (CategoryOfElements.π
        (Deformation.isomorphismClasses 𝓕 hpre.cofibered))) :=
      ⟨Deformation.schlessingerConditionS2_of_isIsomorphismClasses 𝓕 hpre.cofibered
        (schlessingerConditionS2_of_minimalVersal_hasBijectiveDifferential 𝓕 hpre hξ)
        (Or.inl hpre)⟩
    FiniteDimensional k
      (Deformation.tangentSpaceArtinian Λ k
        (Deformation.isomorphismClasses 𝓕 hpre.cofibered)) :=
  hξ.elim fun ξ h ↦
    Deformation.finiteDimensional_tangentSpace_of_versal_bijectiveDifferential
      𝓕 hpre ξ h.1.1 h.2

add_to_stacks 06IX "(1) implies (3b)"
  Deformation.schlessingerConditionS2_of_versal_bijectiveDifferential
add_to_stacks 06IX "(1) implies (3c)"
  Deformation.finiteDimensional_tangentSpace_of_versal_bijectiveDifferential

/-- The two module structures on `k` that the two spellings of a derivation of `ξ.base` use
agree: the one restricted along the residue map `ξ.base → k` is the one coming from the
algebra structure, and likewise for the `Λ`-action. -/
public theorem derivationModuleStructs_eq
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (ξ : Deformation.FormalObject p) :
    letI : Algebra ξ.base k :=
      (Deformation.residueHom ξ.base).toRingHom.toAlgebra
    (Module.compHom k (Deformation.residueHom ξ.base).toRingHom,
      Module.compHom k (algebraMap Λ k)) =
    (Algebra.toModule, Algebra.toModule) := by
  let : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  apply Prod.ext
  · apply Module.ext'
    intro s x
    show (Deformation.residueHom ξ.base s) * x =
      (algebraMap ξ.base k s) * x
    rfl
  · apply Module.ext'
    intro a x
    show (algebraMap Λ k a) * x = a • x
    rw [Algebra.smul_def]

/-- Equal module structures give an equal type of derivations. -/
public theorem derivation_type_eq
    {R A M : Type*} [CommSemiring R] [CommSemiring A] [AddCommMonoid M]
    [Algebra R A] {mA nA : Module A M} {mR nR : Module R M}
    (hA : mA = nA) (hR : mR = nR)
    : @Derivation R A M _ _ _ _ mA mR =
      @Derivation R A M _ _ _ _ nA nR := by
  cases hA
  cases hR
  rfl

/-- Transporting a derivation along an equality of module structures does not change the
underlying function. -/
public theorem derivation_cast_apply
    {R A M : Type*} [CommSemiring R] [CommSemiring A] [AddCommMonoid M]
    [Algebra R A] {mA nA : Module A M} {mR nR : Module R M}
    (hA : mA = nA) (hR : mR = nR)
    (D : @Derivation R A M _ _ _ _ mA mR) (a : A) :
    (cast (derivation_type_eq hA hR) D) a = D a := by
  cases hA
  cases hR
  rfl

/-- Reinterpret a `Deformation.Derivations ξ.base k` as an ordinary `Derivation Λ ξ.base k`
for the algebra structure on `k` induced by the residue map of `ξ.base`. -/
public noncomputable def derivationToStandard
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
  (ξ : Deformation.FormalObject p)
    (D : Deformation.Derivations ξ.base k) :
    letI : Algebra ξ.base k :=
      (Deformation.residueHom ξ.base).toRingHom.toAlgebra
    Derivation Λ ξ.base k := by
  letI : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  have hmods := derivationModuleStructs_eq ξ
  exact cast (derivation_type_eq (congrArg Prod.fst hmods)
    (congrArg Prod.snd hmods)) D

/-- Reinterpret an ordinary `Derivation Λ ξ.base k` as a `Deformation.Derivations ξ.base k`.
This is the inverse of `Deformation.derivationToStandard`. -/
public noncomputable def standardToDerivation
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (ξ : Deformation.FormalObject p)
    (D : (letI : Algebra ξ.base k :=
      (Deformation.residueHom ξ.base).toRingHom.toAlgebra
      Derivation Λ ξ.base k)) :
    Deformation.Derivations ξ.base k := by
  letI : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  have hmods := derivationModuleStructs_eq ξ
  exact cast (derivation_type_eq (congrArg Prod.fst hmods).symm
    (congrArg Prod.snd hmods).symm) D

/-- `Deformation.derivationToStandard` does not change the underlying function. -/
public theorem derivationToStandard_apply
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (ξ : Deformation.FormalObject p)
    (D : Deformation.Derivations ξ.base k)
    (s : ξ.base) : derivationToStandard ξ D s = D s := by
  let : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  have hmods := derivationModuleStructs_eq ξ
  exact derivation_cast_apply (congrArg Prod.fst hmods) (congrArg Prod.snd hmods) D s

/-- `Deformation.standardToDerivation` does not change the underlying function. -/
public theorem standardToDerivation_apply
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (ξ : Deformation.FormalObject p)
    (D : (letI : Algebra ξ.base k :=
      (Deformation.residueHom ξ.base).toRingHom.toAlgebra
      Derivation Λ ξ.base k))
    (s : ξ.base) : standardToDerivation ξ D s = D s := by
  let : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  have hmods := derivationModuleStructs_eq ξ
  exact derivation_cast_apply (congrArg Prod.fst hmods).symm
    (congrArg Prod.snd hmods).symm D s

/-- The graph of the differential of `ξ` computes `Deformation.derivationToTangent`: any
tangent vector related to `D` by `Deformation.derivationDifferentialGraph` is the value of
`Deformation.derivationToTangent` at `D`, for every choice of pushforwards. -/
public theorem derivationDifferentialGraph_eq_derivationToTangent
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (hp : Deformation.IsPredeformationCategory p)
    (ξ : Deformation.FormalObject p)
    (P : Deformation.ChosenPushforwards p)
    (D : Deformation.Derivations ξ.base k)
    (y : Deformation.predeformationTangentSpace p hp)
    (hy : Deformation.derivationDifferentialGraph p hp ξ D y) :
    y = Deformation.derivationToTangent hp.cofibered ξ P
      (derivationToStandard ξ D) := by
  let : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  let e := Deformation.tangentSpaceDerivationsLinearEquiv ξ.base
  let D' := derivationToStandard ξ D
  dsimp only [Deformation.derivationDifferentialGraph] at hy
  rcases hy with ⟨Q, α, hα, hmap⟩
  have he' : e α = D' := by
    apply Derivation.ext
    intro s
    calc
      e α s = (α.hom s).snd.down :=
        Deformation.tangentSpaceDerivationsLinearEquiv_apply
          ξ.base α s
      _ = D s := hα s
      _ = D' s := (derivationToStandard_apply ξ D s).symm
  have hαeq : α = e.symm D' := e.injective (by simpa using he')
  have hmap' : Deformation.derivationToTangent hp.cofibered ξ Q D' = y := by
    dsimp [Deformation.derivationToTangent]
    rwa [hαeq] at hmap
  exact hmap'.symm.trans
    (congrFun (Deformation.derivationToTangent_independent hp.cofibered ξ Q P) D')

/-- The value of `Deformation.derivationToTangent` at `D` is related to `D` by the graph of
the differential of `ξ`. -/
public theorem derivationToTangent_graph
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (hp : Deformation.IsPredeformationCategory p)
    (ξ : Deformation.FormalObject p)
    (P : Deformation.ChosenPushforwards p)
    (D : (letI : Algebra ξ.base k :=
      (Deformation.residueHom ξ.base).toRingHom.toAlgebra
      Derivation Λ ξ.base k)) :
    Deformation.derivationDifferentialGraph p hp ξ (standardToDerivation ξ D)
      (Deformation.derivationToTangent hp.cofibered ξ P D) := by
  let : Algebra ξ.base k :=
    (Deformation.residueHom ξ.base).toRingHom.toAlgebra
  let e := Deformation.tangentSpaceDerivationsLinearEquiv ξ.base
  let α := e.symm D
  let D' := standardToDerivation ξ D
  dsimp only [Deformation.derivationDifferentialGraph]
  refine ⟨P, α, ?_, ?_⟩
  · intro s
    calc
      (α.hom s).snd.down = e α s :=
        (Deformation.tangentSpaceDerivationsLinearEquiv_apply
          ξ.base α s).symm
      _ = D s := congrArg (fun d => d s) (e.apply_symm_apply D)
      _ = D' s := (standardToDerivation_apply ξ D s).symm
  · rfl

/-- If `k` is separable over the image field of `Λ`, orbitwise bijectivity
of a minimal versal formal object's differential is ordinary bijectivity. -/
@[stacks 06IX "(2) implies (1) under separability"]
public theorem exists_minimalVersal_hasBijectiveDifferential_of_separable
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    [Algebra.IsSeparable (Deformation.residueImageField Λ k) k]
    (𝓕 : BasedCategory.{vF, uF} (Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k))
    (hpre : Deformation.IsPredeformationCategory 𝓕.p)
    (hξ : ∃ ξ : Deformation.FormalObject 𝓕.p,
      Deformation.IsMinimalVersal hpre.cofibered ξ ∧
        Deformation.HasBijectiveDifferentialOnDerivationOrbits 𝓕.p hpre ξ) :
    ∃ ξ : Deformation.FormalObject 𝓕.p,
      Deformation.IsMinimalVersal hpre.cofibered ξ ∧
        Deformation.HasBijectiveDifferential hpre.cofibered ξ := by
  obtain ⟨ξ, hminimal, hOrbit⟩ := hξ
  refine ⟨ξ, hminimal, ?_⟩
  rcases hOrbit with ⟨hgraphFun, hgraphSurj, _, horbits⟩
  obtain ⟨y₀, hy₀, _⟩ := hgraphFun (0 : Deformation.Derivations ξ.base k)
  change ∃ (P : Deformation.ChosenPushforwards 𝓕.p),
      Function.Bijective (Deformation.derivationToTangent hpre.cofibered ξ P) at ⊢
  dsimp only [Deformation.derivationDifferentialGraph] at hy₀
  rcases hy₀ with ⟨P, -⟩
  refine ⟨P, ?_⟩
  let f := Deformation.derivationToTangent hpre.cofibered ξ P
  refine ⟨fun D E hDE => ?_, fun y => ?_⟩
  · have hD := derivationToTangent_graph hpre ξ P D
    have hE := derivationToTangent_graph hpre ξ P E
    let D₀ := standardToDerivation ξ D
    let E₀ := standardToDerivation ξ E
    obtain ⟨δ, hδ⟩ := (horbits D₀ E₀ (f D) (f E) hD hE).mp
      ⟨0, hDE.symm.trans
        ((Deformation.derivationAction 𝓕.p hpre).zero_action (f D)).symm⟩
    obtain rfl : δ = 0 := derivation_eq_zero_of_residueImageField_separable δ
    have hED : E = D := by
      let : Algebra ξ.base k :=
        (Deformation.residueHom ξ.base).toRingHom.toAlgebra
      apply Derivation.ext
      intro r
      calc
        E r = standardToDerivation ξ E r :=
          (standardToDerivation_apply ξ E r).symm
        _ = standardToDerivation ξ D r := by
          simpa [D₀, E₀] using hδ r
        _ = D r := standardToDerivation_apply ξ D r
    exact hED.symm
  · obtain ⟨D, hD⟩ := hgraphSurj y
    exact ⟨derivationToStandard ξ D,
      (derivationDifferentialGraph_eq_derivationToTangent hpre ξ P D y hD).symm⟩

/-- `Deformation.standardToDerivation` and `Deformation.derivationToStandard` are mutually
inverse. -/
public theorem standardToDerivation_derivationToStandard
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (ξ : Deformation.FormalObject p) (D : Deformation.Derivations ξ.base k) :
    standardToDerivation ξ (derivationToStandard ξ D) = D := by
  let : Module Λ k := Module.compHom k (algebraMap Λ k)
  let : Module ξ.base k :=
    Module.compHom k (Deformation.residueHom ξ.base).toRingHom
  apply Derivation.ext
  intro r
  calc
    standardToDerivation ξ (derivationToStandard ξ D) r =
        derivationToStandard ξ D r :=
      standardToDerivation_apply ξ (derivationToStandard ξ D) r
    _ = D r := derivationToStandard_apply ξ D r

/-- Every derivation of `ξ.base` is related to a *unique* tangent vector by the graph of the
differential of `ξ`. This is the well-definedness clause of Tag 06T6's
`Deformation.HasBijectiveDifferentialOnDerivationOrbits`, and it holds for an arbitrary
formal object of a predeformation category — neither versality nor minimality is needed. -/
public theorem existsUnique_derivationDifferentialGraph
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {F : Type uF} [Category.{vF} F]
    {p : F ⥤ Deformation.ArtinianLocalAlgCat.{u, max v w, w} Λ k}
    (hp : Deformation.IsPredeformationCategory p)
    (ξ : Deformation.FormalObject p)
    (D : Deformation.Derivations ξ.base k) :
    ∃! y, Deformation.derivationDifferentialGraph p hp ξ D y := by
  let P : Deformation.ChosenPushforwards p :=
    Deformation.chosenPushforwardsOfCofibered p hp.cofibered
  refine ⟨Deformation.derivationToTangent hp.cofibered ξ P (derivationToStandard ξ D), ?_, ?_⟩
  · have h := derivationToTangent_graph hp ξ P (derivationToStandard ξ D)
    rwa [standardToDerivation_derivationToStandard] at h
  · exact fun y hy => derivationDifferentialGraph_eq_derivationToTangent hp ξ P D y hy

end Deformation

end
