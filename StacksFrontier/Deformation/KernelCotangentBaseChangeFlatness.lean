module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.RingTheory.Flat.Basic
public import StacksFrontier.Deformation.KernelCotangentBaseChange

/-!
# Which flatness makes the kernel comparison injective

`Deformation.Obstruction.kernelCotangentBaseChange_injective` assumes that `S'` is flat over
`R'`, i.e. flatness of the *left* vertical map `g'` of the square. This file shows that the
other reading — flatness of `S` over `R`, the induced map on the quotients — does not suffice,
even for a square-zero kernel and even when the square is cartesian on kernels.

The square is
`R' = ZMod 4 → R = ZMod 2` with kernel `I = {0, 2}` and `I² = 0`, left vertical map
`g' : ZMod 4 → ZMod 2` the same surjection, and `S' = S = ZMod 2` with `g = id`, so `J = 0`.
Here `J` is the ideal generated by the image of `I`, and `S = R` is flat over `R`, yet
`S ⊗[R] I/I²` is nonzero while `J/J²` is zero.

## Main results

* `Deformation.Obstruction.BaseFlatNotEnough.not_injective`: the base-changed comparison map of
  this square is not injective.
-/

@[expose] public section

open scoped TensorProduct

namespace Deformation.Obstruction.BaseFlatNotEnough

/-- The surjection `ZMod 4 → ZMod 2`. Its kernel `{0, 2}` is square-zero and nonzero, so the
conormal module of the kernel is nonzero. -/
abbrev castHom : ZMod 4 →+* ZMod 2 := ZMod.castHom (by norm_num) (ZMod 2)

/-- The reduction map `ZMod 4 → ZMod 2` is surjective. -/
theorem castHom_surjective : Function.Surjective castHom := ZMod.castHom_surjective _

/-- Any two elements of the kernel of `ZMod 4 → ZMod 2` multiply to zero. -/
theorem mul_eq_zero_of_mem_ker :
    ∀ r s : ZMod 4, castHom r = 0 → castHom s = 0 → r * s = 0 := by decide

/-- The kernel of `ZMod 4 → ZMod 2` is square-zero. -/
theorem ker_sq_eq_bot : RingHom.ker castHom ^ 2 = ⊥ := by
  rw [pow_two]
  refine le_antisymm (Ideal.mul_le.mpr fun r hr s hs => ?_) bot_le
  simpa using mul_eq_zero_of_mem_ker r s (RingHom.mem_ker.mp hr) (RingHom.mem_ker.mp hs)

/-- The element `2` of `ZMod 4` lies in the kernel of `ZMod 4 → ZMod 2`. -/
theorem two_mem_ker : (2 : ZMod 4) ∈ RingHom.ker castHom := RingHom.mem_ker.mpr (by decide)

/-- The image of the kernel of `ZMod 4 → ZMod 2` generates the zero ideal of `ZMod 2`. -/
theorem map_ker_eq_bot : Ideal.map castHom (RingHom.ker castHom) = ⊥ := by
  rw [eq_bot_iff, Ideal.map_le_iff_le_comap]
  intro x hx
  simpa [Ideal.mem_comap] using RingHom.mem_ker.mp hx

/-- The kernel of the identity of `ZMod 2` is the zero ideal. -/
theorem ker_id_eq_bot : RingHom.ker (RingHom.id (ZMod 2)) = ⊥ := by
  ext x; simp [RingHom.mem_ker]

/-- The square is cartesian on kernels: `ker g` is the ideal generated by the image of
`ker f`. -/
theorem ker_eq_map_ker :
    RingHom.ker (RingHom.id (ZMod 2)) = Ideal.map castHom (RingHom.ker castHom) := by
  rw [ker_id_eq_bot, map_ker_eq_bot]

/-- The flatness the induced map on quotients enjoys here: `S = R`. -/
theorem flat_quotient : Module.Flat (ZMod 2) (ZMod 2) := Module.Flat.self

/-- Flatness of `S` over `R` does not make the base-changed kernel comparison injective: in this
square it is a map from a nonzero module to the zero module. -/
theorem not_injective :
    letI := kernelCotangentModule castHom castHom_surjective
    letI := kernelCotangentModule (RingHom.id (ZMod 2)) Function.surjective_id
    ¬ Function.Injective (kernelCotangentBaseChange castHom castHom_surjective
      (RingHom.id (ZMod 2)) Function.surjective_id castHom rfl) := by
  let := kernelCotangentModule castHom castHom_surjective
  let := kernelCotangentModule (RingHom.id (ZMod 2)) Function.surjective_id
  intro hinj
  have hx0 : kernelCotangentBaseChange castHom castHom_surjective (RingHom.id (ZMod 2))
      Function.surjective_id castHom rfl
      ((1 : ZMod 2) ⊗ₜ[ZMod 2] (RingHom.ker castHom).toCotangent ⟨2, two_mem_ker⟩) = 0 := by
    rw [kernelCotangentBaseChange_one_tmul, kernelCotangentMap_toCotangent]
    rw [show (⟨castHom (2 : ZMod 4), map_ker_le_ker castHom (RingHom.id (ZMod 2)) castHom
        (algebraMap (ZMod 2) (ZMod 2)) rfl (Ideal.mem_map_of_mem _ two_mem_ker)⟩ :
          RingHom.ker (RingHom.id (ZMod 2))) = 0 from Subtype.ext (by decide)]
    exact map_zero _
  have h0 : (1 : ZMod 2) ⊗ₜ[ZMod 2] (RingHom.ker castHom).toCotangent ⟨2, two_mem_ker⟩ = 0 :=
    hinj (hx0.trans (map_zero _).symm)
  have hz : (RingHom.ker castHom).toCotangent ⟨2, two_mem_ker⟩ = 0 := by
    have := congrArg (TensorProduct.lid (ZMod 2) (RingHom.ker castHom).Cotangent) h0
    simpa using this
  have h4 : (2 : ZMod 4) ∈ RingHom.ker castHom ^ 2 := (Ideal.toCotangent_eq_zero _ _).mp hz
  rw [ker_sq_eq_bot] at h4
  exact absurd (Ideal.mem_bot.mp h4) (by decide)

end Deformation.Obstruction.BaseFlatNotEnough
