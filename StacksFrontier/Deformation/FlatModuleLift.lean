/-!
# Flat lifts of a module along a nilpotent thickening

Let `a : A' →+* P'` and `p : P' →+* P` be ring maps and let `M` be a `P`-module. A *flat module
lift* of `M` is a `P'`-module `N`, flat over `A'`, whose base change along `p` is `M`. This is
the lifting problem of **Stacks 0DZ1** and **Stacks 0DZ2** (Examples of Deformation Problems,
Section 12), written for modules rather than algebras.

The file proves the *base-change half* of Stacks 0DZ2: in a commutative square

```
P' → Q'
↓     ↓
P  → Q
```

whose vertical maps are surjective with nilpotent kernel and whose top map is flat, a flat
module lift of a `P`-module `M` pushes forward to a flat module lift of `Q ⊗[P] M`.

The implication in the other direction — the one Stacks 0DZ2 actually spends its proof on — is
**not** in this file: it needs the obstruction class `ω(M) ∈ Ext²_P(M, M ⊗_P IP)` of Stacks
0DYR together with Stacks 0DZ1. Both of those are in this repository, and that implication is
`StacksFrontier.Deformation.FlatModuleLiftLocalization`. See the `Implementation notes`.

## Main definitions

* `Deformation.HasFlatModuleLift`: `M` is the base change along `p` of an `A'`-flat
  `P'`-module. This is the flat-module-lift predicate of Stacks 0DZ2.

## Main results

* `Deformation.HasFlatModuleLift.baseChange`: a flat module lift base-changes along a flat map
  of the two thickenings. This is the forward implication of **Stacks 0DZ2**.
* `Deformation.algebraMap_comp_eq_of_commSq`: the commuting square of ring maps underlying a
  `CategoryTheory.CommSq` of `ULift`ed rings in `CommRingCat`, which is how Stacks 0DZ2's
  cartesian-square hypotheses are stated.
* `Module.Flat.tensorProduct_of_flat_base`: if `N` is a flat `A'`-module through `A' → P'` and
  `Q'` is a flat `P'`-algebra, then `Q' ⊗[P'] N` is a flat `A'`-module.
* `Submodule.exists_span_range_eq_top_of_tensorEquiv`: Nakayama for a nilpotent ideal — a module
  whose base change along a surjection with nilpotent kernel is in bijection with `M` is
  generated by a family indexed by `M`.

## Implementation notes

The witness module in `HasFlatModuleLift` is constrained to the universe `max u₃ v` of the base
ring and the module. That is the right bound — a lift of `M` is, by Nakayama, generated by as
many elements as `M` has — but it means that base change of a lift along `P' → Q'` must be
*reduced* to the universe of `Q'`, not merely tensored up. The proof therefore exhibits the lift
`N` as generated over `P'` by a family indexed by `M`
(`Submodule.exists_span_range_eq_top_of_tensorEquiv`), so that `Q' ⊗[P'] N` is a quotient of
`M →₀ Q'`, which lives in the universe `max u₅ v`. No finiteness hypothesis on `M` is needed for
this: Nakayama's lemma only has to produce a generating family of `N` of the same cardinality as
`M`, not a finite one. That matches the source, whose statement of this implication assumes
nothing beyond `A`-flatness of `M`.

What the converse (Stacks 0DZ2 (2) ⇒ (1)) is built from, in
`StacksFrontier.Deformation.FlatModuleLiftLocalization`:

* **Stacks 0DZ1** — liftability of `M` to an `A'`-flat `P'`-module is equivalent to the
  existence of `K' ∈ D⁻(P')` with `K' ⊗^L_{P'} P = M`.
* **Stacks 0DYR** (Deformation Theory) — the canonical obstruction map
  `ω(K) : K → K ⊗^L_R I[2]` for a square-zero extension `R' → R`, its functoriality, and its
  compatibility with base change.

With those, Stacks 0DZ2 reduces to: `ω(M)` is `J'`-power torsion, which follows from the
localized liftability hypothesis, and `E → E ⊗_P Q` is bijective on `J'`-power torsion
(Stacks 05EC). That is carried out there, for a `P'`-module `M` finite over `P` and under the
hypothesis that the thickening `P' → P` is square-zero rather than merely nilpotent. Those two
deviations from the source, and why the dévissage to the nilpotent case is not available from
0DZ2's own hypotheses, are recorded at the tag there and in that file's implementation notes.
This file's direction needs none of it and carries the source's nilpotence.

## References

* [Stacks Project, Tag 0DZ2](https://stacks.math.columbia.edu/tag/0DZ2)
* [Stacks Project, Tag 0DZ1](https://stacks.math.columbia.edu/tag/0DZ1)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u₁ u₃ u₄ u₅ u₆ v w

/-- Nakayama for a nilpotent ideal: a submodule that spans modulo `I • ⊤` is everything. -/
@[sga "3 III 3.3" "Footnote (67)",
  sga "3 III 4.6.4" "more general",
  sga "3 VIB 6.2.2" "cokernel vanishing"]
public theorem Submodule.eq_top_of_sup_ideal_smul_top_eq_top {R : Type u₁} [CommRing R]
    {I : Ideal R} (hI : IsNilpotent I) {N : Type w} [AddCommGroup N] [Module R N]
    {N₀ : Submodule R N} (h : N₀ ⊔ I • (⊤ : Submodule R N) = ⊤) : N₀ = ⊤ := by
  obtain ⟨n, hn⟩ := hI
  have key : ∀ k : ℕ, N₀ ⊔ (I ^ k) • (⊤ : Submodule R N) = ⊤ := by
    intro k
    induction k with
    | zero => simp [Ideal.one_eq_top]
    | succ k ih =>
      refine le_antisymm le_top ?_
      calc (⊤ : Submodule R N) = N₀ ⊔ I • (⊤ : Submodule R N) := h.symm
        _ = N₀ ⊔ I • (N₀ ⊔ (I ^ k) • (⊤ : Submodule R N)) := by rw [ih]
        _ = N₀ ⊔ (I • N₀ ⊔ I • ((I ^ k) • (⊤ : Submodule R N))) := by rw [Submodule.smul_sup]
        _ ≤ N₀ ⊔ (I ^ (k + 1)) • (⊤ : Submodule R N) := by
            rw [pow_succ', Submodule.mul_smul]
            refine sup_le le_sup_left (sup_le ?_ le_sup_right)
            exact le_trans Submodule.smul_le_right le_sup_left
  simpa [hn] using key n

/-- Base change along a surjection `P' → P` is surjective on the elements `1 ⊗ n`. -/
public theorem TensorProduct.surjective_mk_one {P' : Type u₃} {P : Type u₄}
    [CommRing P'] [CommRing P] [Algebra P' P] (hp : Function.Surjective (algebraMap P' P))
    (N : Type w) [AddCommGroup N] [Module P' N] :
    Function.Surjective (TensorProduct.mk P' P N 1) := by
  intro x
  induction x with
  | zero => exact ⟨0, map_zero _⟩
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, map_add _ _ _⟩
  | tmul c n =>
    obtain ⟨c', rfl⟩ := hp c
    refine ⟨c' • n, ?_⟩
    rw [TensorProduct.mk_apply, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]

/-- The kernel of `n ↦ 1 ⊗ n : N → P ⊗[P'] N` along a surjection `P' → P` is `ker(P' → P) • N`:
base change of a module along a surjective ring map is the quotient by the kernel. -/
public theorem TensorProduct.ker_mk_one {P' : Type u₃} {P : Type u₄}
    [CommRing P'] [CommRing P] [Algebra P' P] (hp : Function.Surjective (algebraMap P' P))
    (N : Type w) [AddCommGroup N] [Module P' N] :
    LinearMap.ker (TensorProduct.mk P' P N 1) =
      (RingHom.ker (algebraMap P' P)) • (⊤ : Submodule P' N) := by
  classical
  set I : Ideal P' := RingHom.ker (algebraMap P' P)
  obtain ⟨e, he1⟩ : ∃ e : (P' ⧸ I) ≃ₗ[P'] P, e 1 = 1 :=
    ⟨(Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId P' P) hp).toLinearEquiv,
      map_one (algebraMap P' P)⟩
  have hcomp : TensorProduct.mk P' P N 1 =
      (TensorProduct.congr e (LinearEquiv.refl P' N)).toLinearMap ∘ₗ
        TensorProduct.mk P' (P' ⧸ I) N 1 := by
    ext n
    simp [he1]
  rw [hcomp, LinearEquiv.ker_comp,
    ← LinearEquiv.ker_comp (TensorProduct.quotTensorEquivQuotSMul N I),
    TensorProduct.quotTensorEquivQuotSMul_comp_mk, Submodule.ker_mkQ]

/-- **Nakayama along a nilpotent thickening.** If `P' → P` is surjective with nilpotent kernel
and the base change `P ⊗[P'] N` is in bijection with `M`, then `N` is generated over `P'` by a
family indexed by `M`: lifting every element of `M` to `N` gives a family which generates `N`
modulo `ker(P' → P) • N`, hence generates `N`.

This is the cardinality form of Nakayama's lemma. It needs no finiteness hypothesis on `M`, and
it is what bounds the universe a base change of a flat module lift has to live in. -/
public theorem Submodule.exists_span_range_eq_top_of_tensorEquiv {P' : Type u₃} {P : Type u₄}
    [CommRing P'] [CommRing P] [Algebra P' P] (hp : Function.Surjective (algebraMap P' P))
    (hnp : IsNilpotent (RingHom.ker (algebraMap P' P)))
    (N : Type w) [AddCommGroup N] [Module P' N] {M : Type v} (e : (P ⊗[P'] N) ≃ M) :
    ∃ σ : M → N, Submodule.span P' (Set.range σ) = ⊤ := by
  classical
  set ψ : N →ₗ[P'] P ⊗[P'] N := TensorProduct.mk P' P N 1 with hψ
  have hπ : Function.Surjective (fun n : N => e (ψ n)) :=
    e.surjective.comp (TensorProduct.surjective_mk_one hp N)
  set σ : M → N := Function.surjInv hπ
  refine ⟨σ, Submodule.eq_top_of_sup_ideal_smul_top_eq_top hnp
    (le_antisymm le_top fun n _ => ?_)⟩
  have hdiff : n - σ (e (ψ n)) ∈ (RingHom.ker (algebraMap P' P)) • (⊤ : Submodule P' N) := by
    rw [← TensorProduct.ker_mk_one hp N, ← hψ, LinearMap.mem_ker, map_sub, sub_eq_zero]
    exact (e.injective (Function.surjInv_eq hπ _)).symm
  have hn : n = σ (e (ψ n)) + (n - σ (e (ψ n))) := by abel
  rw [hn]
  exact Submodule.add_mem _
    (Submodule.mem_sup_left (Submodule.subset_span ⟨e (ψ n), rfl⟩))
    (Submodule.mem_sup_right hdiff)

/-- If `N` is a flat `A'`-module through `A' → P'` and `Q'` is a flat `P'`-algebra, then
`Q' ⊗[P'] N` is a flat `A'`-module: tensoring with `N` over `A'` is exact into `P'`-modules,
and `Q' ⊗[P'] -` is exact. -/
public theorem Module.Flat.tensorProduct_of_flat_base {A' : Type u₁} {P' : Type u₃}
    {Q' : Type u₅} [CommRing A'] [CommRing P'] [CommRing Q'] [Algebra A' P'] [Algebra P' Q']
    [Algebra A' Q'] [IsScalarTower A' P' Q'] (N : Type w) [AddCommGroup N] [Module P' N]
    [Module A' N] [IsScalarTower A' P' N] [Module.Flat A' N] [Module.Flat P' Q'] :
    Module.Flat A' (Q' ⊗[P'] N) := by
  rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
  intro T₁ T₂ _ _ _ _ f hf
  set e₁ := TensorProduct.AlgebraTensorModule.assoc A' P' Q' Q' N T₁
  set e₂ := TensorProduct.AlgebraTensorModule.assoc A' P' Q' Q' N T₂
  set g : (N ⊗[A'] T₁) →ₗ[P'] (N ⊗[A'] T₂) :=
    TensorProduct.AlgebraTensorModule.lTensor P' N f
  have hQginj : Function.Injective (LinearMap.lTensor Q' g) :=
    Module.Flat.lTensor_preserves_injective_linearMap (M := Q') g
      (Module.Flat.lTensor_preserves_injective_linearMap (M := N) f hf)
  have hmaps : ∀ x : (Q' ⊗[P'] N) ⊗[A'] T₁,
      e₂ ((LinearMap.lTensor (Q' ⊗[P'] N) f) x) = (LinearMap.lTensor Q' g) (e₁ x) := by
    intro x
    induction x with
    | zero => simp
    | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
    | tmul z t =>
      induction z with
      | zero => simp
      | add z w hz hw => rw [TensorProduct.add_tmul, map_add, map_add, map_add, map_add, hz, hw]
      | tmul q n => rfl
  exact fun x y hxy => e₁.injective (hQginj (by rw [← hmaps, ← hmaps, hxy]))

namespace Deformation

/-- A module `M` over `P` has a flat lift across `p : P' → P`, relative to
`a : A' → P'`, if it is the base change of an `A'`-flat `P'`-module. -/
public def HasFlatModuleLift
    {A' : Type u₁} {P' : Type u₃} {P : Type u₄}
    [CommRing A'] [CommRing P'] [CommRing P]
    (a : A' →+* P') (p : P' →+* P)
    (M : Type v) [AddCommGroup M] [Module P M] : Prop :=
  letI : Algebra P' P := p.toAlgebra
  ∃ N : ModuleCat.{max u₃ v} P',
    @Module.Flat A' N _ _ (Module.compHom N a) ∧
      Nonempty ((P ⊗[P'] N) ≃ₗ[P] M)

/-- The square of ring maps underlying a commuting square of `ULift`ed rings in `CommRingCat`.
Stacks 0DZ2 states its cartesian squares in this shape. -/
public theorem algebraMap_comp_eq_of_commSq {P' : Type u₃} {P : Type u₄} {Q' : Type u₅}
    {Q : Type u₆} [CommRing P'] [CommRing P] [CommRing Q'] [CommRing Q]
    [Algebra P' Q'] [Algebra P Q] (p : P' →+* P) (q : Q' →+* Q)
    (hsq : CommSq
      (CommRingCat.ofHom p.ulift.{max u₃ u₄ u₅ u₆, max u₃ u₄ u₅ u₆})
      (CommRingCat.ofHom (algebraMap P' Q').ulift.{max u₃ u₄ u₅ u₆, max u₃ u₄ u₅ u₆})
      (CommRingCat.ofHom (algebraMap P Q).ulift.{max u₃ u₄ u₅ u₆, max u₃ u₄ u₅ u₆})
      (CommRingCat.ofHom q.ulift.{max u₃ u₄ u₅ u₆, max u₃ u₄ u₅ u₆})) :
    (algebraMap P Q).comp p = q.comp (algebraMap P' Q') := by
  ext x
  simpa [RingHom.ulift_apply] using
    congrArg ULift.down (RingHom.congr_fun (congrArg CommRingCat.Hom.hom hsq.w) (ULift.up x))

/-- **Stacks 0DZ2, forward implication.** In a commuting square of ring maps `P' → Q'`,
`P' → P`, `Q' → Q`, `P → Q` whose left vertical map `p` is surjective with nilpotent kernel and
whose top map `P' → Q'` is flat, a flat module lift of a `P`-module `M` base-changes to a flat
module lift of `Q ⊗[P] M`.

By Nakayama the lift `N` is generated over `P'` by a family indexed by `M`, so `Q' ⊗[P'] N` is a
quotient of `M →₀ Q'` and can be presented in the universe of `Q'` and `M`, which is what
`HasFlatModuleLift` demands of the witness.

This direction of Stacks 0DZ2 carries the source's own hypothesis on the kernel of `P' → P` —
nilpotent, not square-zero — and uses none of the obstruction calculus, so it is faithful and in
fact more general than the source: neither the Noetherian hypotheses, nor finiteness of `M`, nor
the ideal `J'`, nor the local liftability hypothesis is needed. The converse is the
obstruction-theoretic half, and is
`exists_flat_lift_iff_exists_flat_lift_baseChange_of_localizationLift_of_isNilpotent_ker` in
`StacksFrontier.Deformation.FlatModuleLiftLocalization`. -/
@[stacks 0DZ2 "the implication (1) => (2) of 0DZ2, in full, at the source's hypotheses and with \
no hypothesis added. This is what the tag asserts in this library: the converse is FALSE at the \
source's hypotheses, a Stacks ERRATUM. The biconditional \
is refuted, at every universe, by \
`Deformation.Examples.ArtinSchreier.not_flatModuleLiftBaseChangeStatement`, and in the form \
that writes out every one of the source's hypotheses by \
`Deformation.Examples.ArtinSchreier.not_flatModuleLiftBaseChangeStatementFaithful`. Inside the \
forward implication nothing is restricted: it carries the source's own nilpotence hypothesis on \
the kernel of `P' → P` and is more general than the source in needing neither the Noetherian \
hypotheses, nor finiteness of `M`, nor the ideal `J'`, nor the local liftability hypothesis, \
and every binder it does carry is used. A restricted converse — a finite `M` under a \
square-zero thickening `P' → P` — is proved in \
`StacksFrontier.Deformation.FlatModuleLiftLocalization`, whose clause records why the dévissage to \
the source's nilpotent thickening is not merely unavailable from 0DZ2's hypotheses but closed: \
the step it needs is `Deformation.ObstructionIndependentOfLift` and that statement is \
unsatisfiable, by `Deformation.not_obstructionIndependentOfLift`"]
public theorem HasFlatModuleLift.baseChange
    {A' : Type u₁} {P' : Type u₃} {P : Type u₄} {Q' : Type u₅} {Q : Type u₆}
    [CommRing A'] [CommRing P'] [CommRing P] [CommRing Q'] [CommRing Q]
    [Algebra A' P'] [Algebra P' Q'] [Algebra P Q]
    {p : P' →+* P} {q : Q' →+* Q}
    (hcomm : (algebraMap P Q).comp p = q.comp (algebraMap P' Q'))
    (hflat : Module.Flat P' Q')
    (hp : Function.Surjective p) (hnp : IsNilpotent (RingHom.ker p))
    (M : Type v) [AddCommGroup M] [Module P M]
    (h : HasFlatModuleLift (algebraMap A' P') p M) :
    HasFlatModuleLift ((algebraMap P' Q').comp (algebraMap A' P')) q (Q ⊗[P] M) := by
  classical
  let _ : Algebra P' P := p.toAlgebra
  let _ : Algebra Q' Q := q.toAlgebra
  let _ : Algebra P' Q := ((algebraMap P Q).comp p).toAlgebra
  let _ : Algebra A' Q' := ((algebraMap P' Q').comp (algebraMap A' P')).toAlgebra
  have : IsScalarTower P' P Q := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower P' Q' Q := IsScalarTower.of_algebraMap_eq fun x =>
    RingHom.congr_fun hcomm x
  have : IsScalarTower A' P' Q' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  obtain ⟨N, hNflat, ⟨eM⟩⟩ := h
  let _ : Module A' (N : Type (max u₃ v)) :=
    Module.compHom (N : Type (max u₃ v)) (algebraMap A' P')
  have : IsScalarTower A' P' (N : Type (max u₃ v)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hflatX : Module.Flat A' (Q' ⊗[P'] (N : Type (max u₃ v))) :=
    Module.Flat.tensorProduct_of_flat_base _
  obtain ⟨σ, hspan⟩ := Submodule.exists_span_range_eq_top_of_tensorEquiv (P := P) hp hnp
    (N : Type (max u₃ v)) eM.toEquiv
  set s : M → (Q' ⊗[P'] (N : Type (max u₃ v))) :=
    (TensorProduct.mk P' Q' (N : Type (max u₃ v)) 1) ∘ σ
  have hstop : Submodule.span Q' (Set.range s) = ⊤ := by
    have h1 := Submodule.baseChange_span (R := P') (A := Q')
      (M := (N : Type (max u₃ v))) (Set.range σ)
    rw [hspan, Submodule.baseChange_top, ← Set.range_comp] at h1
    exact h1.symm
  set φ : (M →₀ Q') →ₗ[Q'] (Q' ⊗[P'] (N : Type (max u₃ v))) :=
    Finsupp.linearCombination Q' s with hφ
  have hφsurj : Function.Surjective φ := by
    rw [← LinearMap.range_eq_top, hφ, Finsupp.range_linearCombination, hstop]
  let X : Type (max u₅ u₆ v) := ULift.{u₆, max v u₅} ((M →₀ Q') ⧸ LinearMap.ker φ)
  let eFin : X ≃ₗ[Q'] (Q' ⊗[P'] (N : Type (max u₃ v))) :=
    ULift.moduleEquiv ≪≫ₗ LinearMap.quotKerEquivOfSurjective φ hφsurj
  refine ⟨ModuleCat.of Q' X, ?_, ⟨?_⟩⟩
  · let _ : Module A' X := Module.compHom X ((algebraMap P' Q').comp (algebraMap A' P'))
    have : IsScalarTower A' Q' X :=
      IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    exact Module.Flat.of_linearEquiv (eFin.restrictScalars A')
  · exact (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl Q Q) eFin) ≪≫ₗ
      (TensorProduct.AlgebraTensorModule.cancelBaseChange P' Q' Q Q (N : Type (max u₃ v))) ≪≫ₗ
      (TensorProduct.AlgebraTensorModule.cancelBaseChange P' P Q Q
        (N : Type (max u₃ v))).symm ≪≫ₗ
      (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl Q Q) eM)

end Deformation

end
