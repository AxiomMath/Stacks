module

public import StacksFrontier.Deformation.ToposThickening.KernelComplexFlatBaseChange
public import StacksFrontier.Homology.Tor.DerivedTensorFlatBaseChange

/-!
# The obstruction target of a module flat over the base is a module in degree zero

In the situation of Stacks 0DZ2 — a surjection `A' → A`, a flat `A'`-algebra `P'`, and
`P = P' ⊗_{A'} A`, so that `ker(P' → P)` is generated by the image of `I = ker(A' → A)` — the
derived tensor product `M ⊗^𝐋_P I·P` of an `A`-flat `P`-module `M` with the kernel module is
the ordinary tensor product, placed in cohomological degree zero. This is the footnote of the
source, which is what lets the obstruction class of Stacks 0DYR be read as a class in
`Ext²_P(M, M ⊗_P I·P)`.

## Main results

* `Deformation.Obstruction.derivedTensorSquareZeroKernelObjectIso`: the obstruction target of
  an `A`-flat `P`-module is a single complex.

## Implementation notes

The comparison of the two kernel modules is `squareZeroKernelBaseChangeMap`, an isomorphism by
`isIso_squareZeroKernelBaseChangeMap`; the rest is
`CochainComplex.DerivedTensor.derivedTensorSingleExtendScalarsIso` at the kernel module of
`fA`. Both K-flat resolutions are arguments, so the isomorphism has a real body.

## References

* [Stacks Project, Tag 0DZ2](https://stacks.math.columbia.edu/tag/0DZ2)
* [Stacks Project, Tag 0DYR](https://stacks.math.columbia.edu/tag/0DYR)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CochainComplex.DerivedTensor

universe u

namespace Deformation.Obstruction

attribute [local instance 10000] HasDerivedCategory.standard

/-- **The obstruction target of a module flat over the base is a module in degree zero.** For a
commuting square of surjections `fA : A' → A` and `fP : P' → P` with `ker fP` generated by the
image of `ker fA`, both horizontal maps flat, and `M` a `P`-module flat over `A`, the derived
tensor product of `M` with the kernel module of `fP` has no higher cohomology: it is
`M ⊗_P ker fP / (ker fP)²` placed in cohomological degree zero. The two resolutions are
arguments, so the isomorphism is the canonical comparison read through them composed with the
base-change comparison of the two kernel modules. -/
noncomputable def derivedTensorSquareZeroKernelObjectIso
    {A' A P' P : Type u} [CommRing A'] [CommRing A] [CommRing P'] [CommRing P]
    (fA : A' →+* A) (hfA : Function.Surjective fA)
    (fP : P' →+* P) (hfP : Function.Surjective fP)
    (a : A' →+* P') (b : A →+* P) (hcomm : b.comp fA = fP.comp a)
    (hker : RingHom.ker fP = Ideal.map a (RingHom.ker fA))
    (ha : a.Flat) (hb : b.Flat) (M : ModuleCat.{u} P)
    [Module.Flat A ((ModuleCat.restrictScalars.{u} b).obj M)]
    (L : CochainComplex (ModuleCat.{u} A) ℤ) (hL : CochainComplex.KFlat.{u, u} L)
    (f : L ⟶ (CochainComplex.singleFunctor (ModuleCat.{u} A) 0).obj
      (squareZeroKernelModule.{u, u} fA hfA)) (hf : QuasiIso f)
    (N : CochainComplex (ModuleCat.{u} P) ℤ) (hN : CochainComplex.KFlat.{u, u} N)
    (p : N ⟶ (CochainComplex.singleFunctor (ModuleCat.{u} P) 0).obj M) (hp : QuasiIso p) :
    ((canonicalDerivedTensorProductFunctor P).obj
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor (ModuleCat.{u} P) 0).obj M))).obj
        (squareZeroKernelObject.{u, u} fP hfP) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} P) 0).obj
        (((curriedTensor (ModuleCat.{u} P)).obj M).obj
          (squareZeroKernelModule.{u, u} fP hfP)) := by
  haveI hbc := isIso_squareZeroKernelBaseChangeMap fA hfA fP hfP a b hcomm hker ha
  let eK : (ModuleCat.extendScalars.{u, u, u} b).obj (squareZeroKernelModule.{u, u} fA hfA) ≅
      squareZeroKernelModule.{u, u} fP hfP :=
    @asIso _ _ _ _ _ hbc
  exact ((canonicalDerivedTensorProductFunctor P).obj
      (DerivedCategory.Q.obj ((CochainComplex.singleFunctor (ModuleCat.{u} P) 0).obj M))).mapIso
      (DerivedCategory.Q.mapIso
        ((CochainComplex.singleFunctor (ModuleCat.{u} P) 0).mapIso eK)).symm ≪≫
    derivedTensorSingleExtendScalarsIso b hb M (squareZeroKernelModule.{u, u} fA hfA)
      L hL f hf N hN p hp ≪≫
    DerivedCategory.Q.mapIso ((CochainComplex.singleFunctor (ModuleCat.{u} P) 0).mapIso
      (((curriedTensor (ModuleCat.{u} P)).obj M).mapIso eK))

/-- **Stacks 0DZ2, the footnote, at the obstruction target.** The resolutions of
`derivedTensorSquareZeroKernelObjectIso` discharged by existence of free K-flat
resolutions. -/
theorem nonempty_derivedTensor_squareZeroKernelObject_iso_single
    {A' A P' P : Type u} [CommRing A'] [CommRing A] [CommRing P'] [CommRing P]
    (fA : A' →+* A) (hfA : Function.Surjective fA)
    (fP : P' →+* P) (hfP : Function.Surjective fP)
    (a : A' →+* P') (b : A →+* P) (hcomm : b.comp fA = fP.comp a)
    (hker : RingHom.ker fP = Ideal.map a (RingHom.ker fA))
    (ha : a.Flat) (hb : b.Flat) (M : ModuleCat.{u} P)
    [Module.Flat A ((ModuleCat.restrictScalars.{u} b).obj M)] :
    Nonempty (((canonicalDerivedTensorProductFunctor P).obj
          (DerivedCategory.Q.obj ((CochainComplex.singleFunctor (ModuleCat.{u} P) 0).obj M))).obj
        (squareZeroKernelObject.{u, u} fP hfP) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} P) 0).obj
        (((curriedTensor (ModuleCat.{u} P)).obj M).obj
          (squareZeroKernelModule.{u, u} fP hfP))) := by
  obtain ⟨L, f, hL, -, -, hf⟩ := CochainComplex.KFlat.exists_free_kFlat_resolution
    (squareZeroKernelModule.{u, u} fA hfA)
  obtain ⟨N, p, hN, -, -, hp⟩ := CochainComplex.KFlat.exists_free_kFlat_resolution M
  exact ⟨derivedTensorSquareZeroKernelObjectIso fA hfA fP hfP a b hcomm hker ha hb M
    L hL f hf N hN p hp⟩

end Deformation.Obstruction

end
