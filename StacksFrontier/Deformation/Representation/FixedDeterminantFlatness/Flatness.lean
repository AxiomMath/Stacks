module

public import StacksFrontier.Deformation.Representation.FixedDeterminantFlatness.Obstruction
public import StacksFrontier.Deformation.Representation.FixedDeterminantFlatness.MinimalPresentation
public import StacksFrontier.RingTheory.CompleteLocalRing.PowerSeriesQuotientRegularElement

/-!
# Flatness of a fixed-determinant universal deformation ring

Let `π` be a profinite group, `N` a closed normal subgroup on which the residual representation
`ρ₀ : π → GLₙ(𝐅_ℓ)` is absolutely irreducible, `ℓ ∤ n`, and assume that `π / N` is topologically
generated by one element and that `H ²(N, ad⁰) = 0` (locally constant cochains). If the universal
deformation ring `R` with determinant fixed to `δ` is finite over `ℤ_[ℓ]` with finite special
fibre, then it is flat over `ℤ_[ℓ]`.

The proof is de Jong's (Theorem 3.5 of [dJ-conjecture]): present `R = ℤ_[ℓ][[x₁, …, x_d]]/J` with
`d` the dimension of the cotangent space of `R/ℓR`; by Mazur's obstruction theory the minimal
number `r` of generators of `J` is at most the number of independent locally constant
`2`-cocycles, which is at most `dim H ¹(π, ad⁰)` by the inequality `h ² ≤ h ¹` for an extension by
a procyclic group, which is at most `d` by the tangent space computation. A quotient of
`ℤ_[ℓ][[x₁, …, x_d]]` by at most `d` relations with finite nonzero special fibre has `ℓ` regular.

## Main results

* `Deformation.IsUniversalFixedDeterminantDeformation.flat_of_vanishesTwo`.
-/

@[expose] public noncomputable section

open IsLocalRing Stacks.GroupCohomology groupCohomology

universe u v

namespace Deformation.IsUniversalFixedDeterminantDeformation

variable {ℓ n : ℕ} [Fact ℓ.Prime] {π : Type u} [Group π] [TopologicalSpace π]
  [IsTopologicalGroup π] [CompactSpace π] [TotallyDisconnectedSpace π]
  {ρ₀ : π →ₜ* Matrix.GeneralLinearGroup (Fin n) (ZMod ℓ)} {δ : π →ₜ* ℤ_[ℓ]ˣ}
  {R : Type v} [CommRing R] [IsLocalRing R] [TopologicalSpace R] [Algebra ℤ_[ℓ] R]
  {reduce : R →+* ZMod ℓ} {ρuniv : π →ₜ* Matrix.GeneralLinearGroup (Fin n) R}

local notation "AD" => AdZero (ρ₀.toMonoidHom)

/-- The ideal generated by the list `List.ofFn f` is the span of the range of `f`. -/
lemma ofList_ofFn {P : Type*} [CommRing P] {r : ℕ} (f : Fin r → P) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  rw [Ideal.ofList]
  congr 1
  ext x
  simp [List.mem_ofFn]

/-- **Artin–Rees**: there is `k` such that an element of `J` lying in `I * J ⊔ I ^ (k + 1)`
already lies in `I * J`. -/
private theorem _root_.Ideal.exists_mem_mul_of_mem_mul_sup_pow {P : Type*} [CommRing P]
    [IsNoetherianRing P] (I J : Ideal P) :
    ∃ k, ∀ z ∈ J, z ∈ I * J ⊔ I ^ (k + 1) → z ∈ I * J := by
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul I (J : Submodule P P)
  refine ⟨k, fun z hzJ hzQ => ?_⟩
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hzQ
  have hbJ : b ∈ J := by
    have hb' : (a + b) - a ∈ J := J.sub_mem hzJ
      ((Submodule.mul_le.mpr fun q _ j hj => J.mul_mem_left q hj) ha)
    rwa [add_sub_cancel_left] at hb'
  have h1 : b ∈ I ^ (k + 1) • (⊤ : Submodule P P) ⊓ (J : Submodule P P) :=
    ⟨by rwa [smul_eq_mul, Ideal.mul_top], hbJ⟩
  rw [hk (k + 1) (by lia), show k + 1 - k = 1 by lia, pow_one] at h1
  exact add_mem ha ((Submodule.smul_mono le_rfl inf_le_right : _ ≤ I • (J : Submodule P P)) h1)

/-- The number of generators of a minimal presentation of the kernel of `F : P → R` is at most
the dimension of the locally constant `H ¹(π, ad⁰)`. -/
private theorem card_le_finrank_lcH1
    (h : IsUniversalFixedDeterminantDeformation ℓ n π ρ₀ δ R reduce ρuniv)
    (hred : ∀ g, Matrix.GeneralLinearGroup.map reduce (ρuniv g) = ρ₀ g)
    {P : Type} [CommRing P] [IsLocalRing P] [IsNoetherianRing P]
    [IsAdicComplete (maximalIdeal P) P] [Algebra ℤ_[ℓ] P]
    (F : P →+* R) (hF : Function.Surjective F)
    (hFalg : ∀ c, F (algebraMap ℤ_[ℓ] P c) = algebraMap ℤ_[ℓ] R c)
    (hJ : RingHom.ker F ≤ maximalIdeal P ^ 2 ⊔ Ideal.span {algebraMap ℤ_[ℓ] P ℓ})
    {r : ℕ} (f : Fin r → P) (hf : Ideal.span (Set.range f) = RingHom.ker F)
    (hmin : ∀ p : Fin r → P, ∑ i, p i * f i = 0 → ∀ i, p i ∈ maximalIdeal P)
    [FiniteDimensional (ZMod ℓ) (LcH1 (ZMod ℓ) π AD)]
    (N : Subgroup π) [N.Normal] (hNc : IsClosed (N : Set π))
    (hirr : IsAbsolutelyIrreducible fun g : N => ρ₀ g) (hn : ¬ ℓ ∣ n)
    (hvan : VanishesTwo N AD) {σ : π} (hσ : ∀ H : OpenSubgroup π, N ≤ H → σ ∈ H → H = ⊤) :
    r ≤ Module.finrank (ZMod ℓ) (LcH1 (ZMod ℓ) π AD) := by
  classical
  obtain ⟨k, hJQ⟩ := Ideal.exists_mem_mul_of_mem_mul_sup_pow (maximalIdeal P) (RingHom.ker F)
  obtain ⟨ρt, hρtF, hρtdet, hρtlc⟩ := h.exists_lift
    (Nat.pos_of_ne_zero fun h0 => hn (h0 ▸ dvd_zero ℓ)) F hF hFalg
    (maximalIdeal P * RingHom.ker F ⊔ maximalIdeal P ^ (k + 1)) (k + 1) le_sup_right
  have htr := fun b : Fin r → ZMod ℓ => trace_liftDefect h F hF f hf hmin ρt hρtF hρtdet b
  let c : Fin r → π × π → AD := fun i =>
    obstruction (ρ₀ := ρ₀) F f ρt (Pi.single i 1) (htr _)
  refine card_le_finrank_of_linearIndependent_cocycles₂ (ZMod ℓ) hNc AdZero.hasOpenStabilizers
    (fun X hX => AdZero.eq_zero_of_forall_smul_eq N hirr hn X hX) hvan hσ c
    (fun i => isLocallyConstant_obstruction h F hF f hf hmin ρt hρtF _ (htr _) _ hρtlc hJQ)
    (fun i => isCocycle₂_obstruction h hred F hF f hf hmin ρt hρtF hρtdet _) ?_
  rintro a ⟨x, hxl, hx⟩
  rw [sum_smul_obstruction F f ρt a htr] at hx
  exact eq_zero_of_obstruction_eq_dOne h hred F hF f hf hmin ρt hρtF hρtdet hFalg hJ _ (k + 1)
    le_sup_right hρtlc hJQ a x hxl hx

/-- **Flatness of the universal fixed-determinant deformation ring** under the vanishing of
`H ²(N, ad⁰)` for a closed normal subgroup `N` with procyclic quotient. -/
theorem flat_of_vanishesTwo
    (h : IsUniversalFixedDeterminantDeformation ℓ n π ρ₀ δ R reduce ρuniv)
    [Module.Finite ℤ_[ℓ] R] (hfin : Finite (R ⧸ Ideal.span {algebraMap ℤ_[ℓ] R ℓ}))
    (N : Subgroup π) [N.Normal] (hNc : IsClosed (N : Set π))
    (hirr : IsAbsolutelyIrreducible fun g : N => ρ₀ g) (hn : ¬ ℓ ∣ n)
    (hvan : VanishesTwo N AD) (σ : π) (hσ : ∀ H : OpenSubgroup π, N ≤ H → σ ∈ H → H = ⊤) :
    Module.Flat ℤ_[ℓ] R := by
  classical
  obtain ⟨ρu, h', hred⟩ := h.exists_reduce_eq
  have := h.isAdicComplete
  have : IsNoetherianRing R :=
    isNoetherian_of_tower ℤ_[ℓ] (isNoetherian_of_isNoetherianRing_of_finite ℤ_[ℓ] R)
  have hirrπ : IsAbsolutelyIrreducible fun g : π => ρ₀ g := by
    unfold IsAbsolutelyIrreducible at hirr ⊢
    refine eq_top_iff.mpr (hirr ▸ Submodule.span_mono ?_)
    rintro _ ⟨g, rfl⟩
    exact ⟨g, rfl⟩
  -- a minimal cotangent family and the presentation
  have hex := IsLocalRing.exists_isCotangentFamily (ℓ := ℓ) (R := R)
  set d := Nat.find hex
  obtain ⟨y, hy⟩ := Nat.find_spec hex
  obtain ⟨F, hFX, hFC⟩ := Stacks.CompleteLocalRing.RegularSubring.exists_eval₂Hom
    (maximalIdeal R) y hy.1 (algebraMap ℤ_[ℓ] R)
  have hF := IsLocalRing.surjective_of_cotangentFamily
    h.surjective_mk_maximalIdeal_comp_algebraMap hfin y hy F hFX hFC
  have hFalg : ∀ c, F (algebraMap ℤ_[ℓ] (MvPowerSeries (Fin d) ℤ_[ℓ]) c) = algebraMap ℤ_[ℓ] R c :=
    fun c => by rw [← MvPowerSeries.c_eq_algebraMap]; exact hFC c
  have hJ : RingHom.ker F ≤ maximalIdeal (MvPowerSeries (Fin d) ℤ_[ℓ]) ^ 2 ⊔
      Ideal.span {algebraMap ℤ_[ℓ] (MvPowerSeries (Fin d) ℤ_[ℓ]) ℓ} := by
    rw [← MvPowerSeries.c_eq_algebraMap]
    exact IsLocalRing.ker_le_of_minimal y hy (fun d' y' hy' => Nat.find_min' hex ⟨y', hy'⟩)
      F hF hFX hFC
  have : IsNoetherianRing (MvPowerSeries (Fin d) ℤ_[ℓ]) :=
    mvPowerSeries_fin_isNoetherianRing ℤ_[ℓ] d
  have : IsAdicComplete (maximalIdeal (MvPowerSeries (Fin d) ℤ_[ℓ]))
      (MvPowerSeries (Fin d) ℤ_[ℓ]) :=
    Stacks.CompleteLocalRing.RegularSubring.isAdicComplete_maximalIdeal_mvPowerSeries ℤ_[ℓ] d
  -- minimal generators of the kernel
  obtain ⟨r, fs, hfs, hminf⟩ := IsLocalRing.exists_minimal_generators (RingHom.ker F)
    ((isNoetherianRing_iff_ideal_fg _).1 inferInstance _)
  -- the counts
  obtain ⟨hfd, hle⟩ := h'.finiteDimensional_lcH1_and_finrank_le hirrπ hn y hy.1 hy.2
  have hr := card_le_finrank_lcH1 h' hred F hF hFalg hJ fs hfs hminf N hNc hirr hn hvan hσ
  -- regularity of `ℓ`
  have hnt : Nontrivial (R ⧸ Ideal.span {algebraMap ℤ_[ℓ] R ℓ}) :=
    Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
      ((Ideal.span_singleton_le_iff_mem _).mpr h.algebraMap_mem_maximalIdeal))
  have hreg := mem_nonZeroDivisors_of_surjective_mvPowerSeries_padicInt F hF hFC
    (List.ofFn fs) (by rw [ofList_ofFn, hfs]) (by rw [List.length_ofFn]; lia) hfin hnt
  exact h.flat hreg

end Deformation.IsUniversalFixedDeterminantDeformation
