module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.RingTheory.PowerSeries.Inverse
public import Mathlib.Algebra.CharP.Lemmas
public import Mathlib.NumberTheory.Padics.RingHoms
public import Mathlib.Topology.Instances.Matrix
public import Mathlib.Topology.Instances.ZMod
public import StacksFrontier.Deformation.Representation.FixedDeterminantFiniteness.SquareZero
public import StacksFrontier.Deformation.Representation.FixedDeterminantUniversal

/-!
# Without fixing the determinant, the universal deformation ring is not finite over `ℤ_ℓ`

[Stacks, Tag 03W1] asserts that the universal deformation ring of `ρ₀ : π₁(X) → GLₙ(𝐅_ℓ)` **with
determinant fixed to `δ`** is finite flat over `ℤ_ℓ`. The determinant condition cannot be dropped:
twisting a deformation by characters of `π₁(X)` with values in `1 + 𝔪` produces deformations whose
determinants take infinitely many values, which a ring finite over `ℤ_ℓ` cannot accommodate.

This file proves that statement for any topological group `π` that has continuous quotients
`ℤ/ℓ^j` for every `j`, as `π₁(X)` of a variety over a finite field has (through
`π₁(X) → Gal(k̄/k) ≅ ℤ̂`). For `j ≥ 1` the test ring is `A_j = 𝐅_ℓ[[T]]/(T^{ℓ^j})`, in which
`u = 1 + T` has order exactly `ℓ^j`. Twisting `ρ₀` by `g ↦ u^{φ(g)}` for a surjection
`φ : π → ℤ/ℓ^j` gives a deformation of `ρ₀` over `A_j`, so the universal property yields a
`ℤ_ℓ`-algebra map `ψ : R → A_j`. The values `ψ(det ρ_univ(g)) = det ρ₀(g) · u^{n φ(g)}` are
`ℓ^j` distinct elements of `ψ(R)` because `ℓ ∤ n`, while `ψ(R)` has at most `ℓ^d` elements if
`R` is generated by `d` elements over `ℤ_ℓ`.

## Main definitions

* `Deformation.IsUniversalDeformation`: the universal property of the deformation ring of `ρ₀`
  without a condition on the determinant.
* `Deformation.TruncatedPowerSeries ℓ N`: the ring `𝐅_ℓ[[T]]/(T^N)`.

## Main results

* `Deformation.IsUniversalDeformation.not_moduleFinite`: **the universal deformation ring without
  fixed determinant is not finite over `ℤ_ℓ`**, when `ℓ ∤ n` and `π` has continuous quotients
  `ℤ/ℓ^j` for all `j`.
-/

@[expose] public noncomputable section

open IsLocalRing PowerSeries

universe u v

namespace Deformation

/-- The universal property of the deformation ring of a residual representation `ρ₀` of a
topological group `π`, with no condition on the determinant: the ring `R` is local and complete
for the topology defined by the powers of its maximal ideal, with residue field `ZMod ℓ` cut out
by the surjective continuous reduction map `reduce` lying over `ℤ_[ℓ] → ZMod ℓ`; the continuous
representation `ρuniv` over `R` reduces to `ρ₀`; and every continuous deformation of `ρ₀` over
such an algebra is the pushforward of `ρuniv` along a unique continuous `ℤ_[ℓ]`-algebra map. -/
structure IsUniversalDeformation (ℓ n : ℕ) [Fact ℓ.Prime] (π : Type u) [Group π]
    [TopologicalSpace π] (ρ₀ : π →ₜ* Matrix.GeneralLinearGroup (Fin n) (ZMod ℓ))
    (R : Type v) [CommRing R] [IsLocalRing R] [tR : TopologicalSpace R] [Algebra ℤ_[ℓ] R]
    (reduce : R →+* ZMod ℓ)
    (ρuniv : π →ₜ* Matrix.GeneralLinearGroup (Fin n) R) : Prop where
  /-- The topology of `R` is the one defined by the powers of its maximal ideal. -/
  isAdicTopology : tR = (IsLocalRing.maximalIdeal R).adicTopology
  /-- `R` is complete for the topology defined by the powers of its maximal ideal. -/
  isAdicComplete : IsAdicComplete (IsLocalRing.maximalIdeal R) R
  /-- The reduction map is surjective. -/
  reduce_surjective : Function.Surjective reduce
  /-- The reduction map is continuous. -/
  reduce_continuous : Continuous reduce
  /-- The reduction map lies over the reduction `ℤ_[ℓ] → ZMod ℓ`. -/
  reduce_algebraMap : ∀ a : ℤ_[ℓ], reduce (algebraMap ℤ_[ℓ] R a) = PadicInt.toZMod a
  /-- The universal representation is a deformation of `ρ₀`. -/
  reduce_rep : IsConjugate (fun g => Matrix.GeneralLinearGroup.map reduce (ρuniv g))
    (fun g => ρ₀ g)
  /-- Every continuous deformation of `ρ₀` over a local algebra complete for its maximal-adic
  topology and with residue field `ZMod ℓ` is the pushforward of `ρuniv` along a unique continuous
  `ℤ_[ℓ]`-algebra homomorphism. -/
  universal : ∀ (S : Type v) [CommRing S] [IsLocalRing S] [tS : TopologicalSpace S]
      [Algebra ℤ_[ℓ] S], tS = (IsLocalRing.maximalIdeal S).adicTopology →
      IsAdicComplete (IsLocalRing.maximalIdeal S) S →
      ∀ red : S →+* ZMod ℓ, Function.Surjective red → Continuous red →
      (∀ a : ℤ_[ℓ], red (algebraMap ℤ_[ℓ] S a) = PadicInt.toZMod a) →
      ∀ ρ : π →ₜ* Matrix.GeneralLinearGroup (Fin n) S,
        IsConjugate (fun g => Matrix.GeneralLinearGroup.map red (ρ g)) (fun g => ρ₀ g) →
        ∃! ψ : R →ₐ[ℤ_[ℓ]] S, Continuous (ψ : R → S) ∧
          IsConjugate (fun g => Matrix.GeneralLinearGroup.map ψ.toRingHom (ρuniv g))
            (fun g => ρ g)

/-! ### Twisting by a scalar character -/

section ScalarTwist

variable {G A : Type*} [Group G] [CommRing A] {n : ℕ}

/-- An invertible scalar matrix commutes with every invertible matrix. -/
private lemma scalar_mul_comm (a : Aˣ) (B : Matrix.GeneralLinearGroup (Fin n) A) :
    Units.map (Matrix.scalar (Fin n) : A →+* Matrix (Fin n) (Fin n) A).toMonoidHom a * B =
      B * Units.map (Matrix.scalar (Fin n) : A →+* Matrix (Fin n) (Fin n) A).toMonoidHom a :=
  Units.ext ((Matrix.scalar_commute _ (fun _ => Commute.all _ _) _).eq)

/-- The twist `g ↦ χ(g) ρ(g)` of a matrix representation `ρ` by a character `χ` of scalars. -/
private def scalarTwist (χ : G →* Aˣ) (ρ : G →* Matrix.GeneralLinearGroup (Fin n) A) :
    G →* Matrix.GeneralLinearGroup (Fin n) A where
  toFun g :=
    Units.map (Matrix.scalar (Fin n) : A →+* Matrix (Fin n) (Fin n) A).toMonoidHom (χ g) * ρ g
  map_one' := by simp
  map_mul' g h := by
    simp only [map_mul]
    rw [mul_assoc, mul_assoc, ← mul_assoc (ρ g), ← scalar_mul_comm, mul_assoc]

/-- The value of the twist `scalarTwist χ ρ` at `g` is the scalar matrix `χ(g)` times `ρ(g)`. -/
private lemma scalarTwist_apply (χ : G →* Aˣ) (ρ : G →* Matrix.GeneralLinearGroup (Fin n) A)
    (g : G) :
    scalarTwist χ ρ g =
      Units.map (Matrix.scalar (Fin n) : A →+* Matrix (Fin n) (Fin n) A).toMonoidHom (χ g) * ρ g :=
  rfl

end ScalarTwist

/-- Conjugate matrix representations have the same determinant. -/
private lemma IsConjugate.det_eq {G R : Type*} {n : ℕ} [CommRing R]
    {ρ σ : G → Matrix.GeneralLinearGroup (Fin n) R} (h : IsConjugate ρ σ) (g : G) :
    Matrix.GeneralLinearGroup.det (σ g) = Matrix.GeneralLinearGroup.det (ρ g) := by
  obtain ⟨P, hP⟩ := h
  rw [hP, map_mul, map_mul, map_inv, mul_inv_cancel_comm]

/-! ### The truncated power series ring `𝐅_ℓ[[T]]/(T^N)` -/

/-- The ring `𝐅_ℓ[[T]]/(T^N)`. -/
abbrev TruncatedPowerSeries (ℓ N : ℕ) : Type :=
  PowerSeries (ZMod ℓ) ⧸ Ideal.span {(X : PowerSeries (ZMod ℓ)) ^ N}

namespace TruncatedPowerSeries

variable {ℓ : ℕ} [Fact ℓ.Prime] {N : ℕ}

/-- The class of `T`. -/
abbrev T : TruncatedPowerSeries ℓ N := Ideal.Quotient.mk _ X

/-- In `𝐅_ℓ[[T]]/(T^N)`, the power `T^m` vanishes if and only if `N ≤ m`. -/
lemma T_pow_eq_zero_iff (m : ℕ) : (T : TruncatedPowerSeries ℓ N) ^ m = 0 ↔ N ≤ m := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
  exact pow_dvd_pow_iff X_ne_zero (by
    rw [PowerSeries.isUnit_iff_constantCoeff, constantCoeff_X]
    exact not_isUnit_zero)

section

variable (hN : N ≠ 0)
include hN

/-- For `N ≠ 0`, the ring `𝐅_ℓ[[T]]/(T^N)` is nontrivial. -/
lemma nontrivial : Nontrivial (TruncatedPowerSeries ℓ N) := by
  refine ⟨⟨0, 1, fun h => ?_⟩⟩
  have := (T_pow_eq_zero_iff (ℓ := ℓ) (N := N) 0).1 ((pow_zero _).trans h.symm)
  omega

/-- For `N ≠ 0`, the ring `𝐅_ℓ[[T]]/(T^N)` is local. -/
lemma isLocalRing : IsLocalRing (TruncatedPowerSeries ℓ N) :=
  have := nontrivial (ℓ := ℓ) hN
  IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- For `N ≠ 0`, the `N`-th power of the maximal ideal of `𝐅_ℓ[[T]]/(T^N)` is zero. -/
lemma maximalIdeal_pow_eq_bot :
    letI := isLocalRing (ℓ := ℓ) hN
    maximalIdeal (TruncatedPowerSeries ℓ N) ^ N = ⊥ := by
  let := isLocalRing (ℓ := ℓ) hN
  have hle : maximalIdeal (TruncatedPowerSeries ℓ N) ≤ Ideal.span {T} := by
    intro a ha
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    have hf : constantCoeff f = 0 := by
      by_contra hne
      refine (mem_maximalIdeal _).1 ha (IsUnit.map _ ?_)
      rw [PowerSeries.isUnit_iff_constantCoeff]
      exact isUnit_iff_ne_zero.2 hne
    obtain ⟨g, rfl⟩ := X_dvd_iff.2 hf
    rw [map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  refine le_bot_iff.1 ((Ideal.pow_right_mono hle N).trans ?_)
  rw [Ideal.span_singleton_pow, (T_pow_eq_zero_iff N).2 le_rfl, Ideal.span_singleton_eq_bot.2 rfl]

/-- For `N ≠ 0`, the ring `𝐅_ℓ[[T]]/(T^N)` has characteristic `ℓ`. -/
lemma charP : CharP (TruncatedPowerSeries ℓ N) ℓ :=
  have := nontrivial (ℓ := ℓ) hN
  charP_of_injective_algebraMap (algebraMap (ZMod ℓ) _).injective ℓ

/-- For `N ≠ 0`, the residue map `𝐅_ℓ[[T]]/(T^N) → 𝐅_ℓ`, induced by the constant coefficient. -/
private def residue : TruncatedPowerSeries ℓ N →+* ZMod ℓ :=
  Ideal.Quotient.lift _ constantCoeff fun _ ha => by
    have hker : Ideal.span {(X : PowerSeries (ZMod ℓ)) ^ N} ≤ RingHom.ker constantCoeff := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_pow,
        constantCoeff_X, zero_pow hN]
    exact hker ha

/-- The residue map sends the class of a constant `c ∈ 𝐅_ℓ` to `c`. -/
private lemma residue_algebraMap (c : ZMod ℓ) :
    residue hN (algebraMap (ZMod ℓ) (TruncatedPowerSeries ℓ N) c) = c := by
  change constantCoeff (algebraMap (ZMod ℓ) (PowerSeries (ZMod ℓ)) c) = c
  simp

/-- The residue map sends the class of `T` to `0`. -/
private lemma residue_T : residue hN (T : TruncatedPowerSeries ℓ N) = 0 := by
  change constantCoeff (X : PowerSeries (ZMod ℓ)) = 0
  exact constantCoeff_X

/-- For `N ≠ 0`, in `𝐅_ℓ[[T]]/(T^N)` one has `(1 + T)^{ℓ^k} = 1 + T^{ℓ^k}`. -/
private lemma one_add_T_pow_char_pow (k : ℕ) :
    (1 + T : TruncatedPowerSeries ℓ N) ^ ℓ ^ k = 1 + T ^ ℓ ^ k := by
  have := charP (ℓ := ℓ) hN
  rw [add_pow_char_pow, one_pow]

end

variable (k : ℕ)

/-- In `𝐅_ℓ[[T]]/(T^{ℓ^k})` one has `(1 + T)^{ℓ^k} = 1`. -/
private lemma one_add_T_pow_eq_one : (1 + T : TruncatedPowerSeries ℓ (ℓ ^ k)) ^ ℓ ^ k = 1 := by
  rw [one_add_T_pow_char_pow (NeZero.ne (ℓ ^ k)),
    (T_pow_eq_zero_iff (ℓ ^ k)).2 le_rfl, add_zero]

/-- The unit `1 + T` of `𝐅_ℓ[[T]]/(T^{ℓ^k})`. -/
private def oneAddT : (TruncatedPowerSeries ℓ (ℓ ^ k))ˣ :=
  Units.ofPowEqOne _ (ℓ ^ k) (one_add_T_pow_eq_one k) (NeZero.ne _)

/-- The underlying element of the unit `oneAddT k` is `1 + T`. -/
private lemma val_oneAddT : (oneAddT (ℓ := ℓ) k : TruncatedPowerSeries ℓ (ℓ ^ k)) = 1 + T :=
  rfl

/-- The residue map sends the unit `1 + T` to `1`. -/
private lemma residue_oneAddT (hN : ℓ ^ k ≠ 0) :
    residue hN (oneAddT (ℓ := ℓ) k : TruncatedPowerSeries ℓ (ℓ ^ k)) = 1 := by
  rw [val_oneAddT, map_add, map_one, residue_T, add_zero]

/-- The unit `1 + T` of `𝐅_ℓ[[T]]/(T^{ℓ^{k+1}})` has order exactly `ℓ^{k+1}`. -/
private lemma orderOf_oneAddT : orderOf (oneAddT (ℓ := ℓ) (k + 1)) = ℓ ^ (k + 1) := by
  have hN : ℓ ^ (k + 1) ≠ 0 := NeZero.ne _
  refine orderOf_eq_prime_pow (fun h => ?_) ?_
  · have h' := congrArg Units.val h
    rw [Units.val_pow_eq_pow_val, val_oneAddT, Units.val_one, one_add_T_pow_char_pow hN,
      add_eq_left, T_pow_eq_zero_iff] at h'
    exact absurd h' (not_le.2 (Nat.pow_lt_pow_succ (Fact.out : ℓ.Prime).one_lt))
  · exact Units.ext (by
      rw [Units.val_pow_eq_pow_val, val_oneAddT, Units.val_one, one_add_T_pow_eq_one])

/-- The character `a ↦ (1 + T)^a` of `ℤ/ℓ^{k+1}` with values in `𝐅_ℓ[[T]]/(T^{ℓ^{k+1}})`. -/
private def character :
    Multiplicative (ZMod (ℓ ^ (k + 1))) →* (TruncatedPowerSeries ℓ (ℓ ^ (k + 1)))ˣ where
  toFun a := oneAddT (k + 1) ^ (Multiplicative.toAdd a).val
  map_one' := by simp
  map_mul' a b := by
    have h := pow_mod_orderOf (oneAddT (ℓ := ℓ) (k + 1))
      ((Multiplicative.toAdd a).val + (Multiplicative.toAdd b).val)
    rw [orderOf_oneAddT] at h
    rw [← pow_add, toAdd_mul, ZMod.val_add, h]

/-- The character `character k` sends `a` to `(1 + T)^a`, with `a` represented in
`[0, ℓ^{k+1})`. -/
private lemma character_apply (a : Multiplicative (ZMod (ℓ ^ (k + 1)))) :
    character k a = oneAddT (k + 1) ^ (Multiplicative.toAdd a).val :=
  rfl

/-- Twisting the base change of `ρ₀` to `𝐅_ℓ[[T]]/(T^{ℓ^{k+1}})` by `character k ∘ φ` gives a
lift of `ρ₀`. -/
private lemma isConjugate_map_residue_scalarTwist {G : Type*} [Group G] {n : ℕ}
    (hN : ℓ ^ (k + 1) ≠ 0) (φ : G →* Multiplicative (ZMod (ℓ ^ (k + 1))))
    (ρ₀ : G →* Matrix.GeneralLinearGroup (Fin n) (ZMod ℓ)) :
    IsConjugate (fun g => Matrix.GeneralLinearGroup.map (residue hN)
      (scalarTwist ((character k).comp φ) ((Matrix.GeneralLinearGroup.map
        (algebraMap (ZMod ℓ) (TruncatedPowerSeries ℓ (ℓ ^ (k + 1))))).comp ρ₀) g))
      (fun g => ρ₀ g) := by
  refine ⟨1, fun g => ?_⟩
  beta_reduce
  rw [one_mul, inv_one, mul_one, scalarTwist_apply, map_mul]
  ext i j
  simp only [Matrix.GeneralLinearGroup.map_apply, Units.coe_map, RingHom.toMonoidHom_eq_coe,
    MonoidHom.coe_ofClass, MonoidHom.comp_apply, Matrix.scalar_apply, character_apply,
    Units.val_mul, Units.val_pow_eq_pow_val, Matrix.mul_apply, Matrix.diagonal_apply]
  simp [residue_oneAddT (k + 1) hN, residue_algebraMap hN,
    apply_ite (residue hN : TruncatedPowerSeries ℓ (ℓ ^ (k + 1)) → ZMod ℓ), ite_mul]

end TruncatedPowerSeries

/-! ### Counting in the image of a finite `ℤ_ℓ`-algebra -/

section Counting

variable {ℓ : ℕ} [Fact ℓ.Prime] {R A : Type*} [CommRing R] [Algebra ℤ_[ℓ] R] [CommRing A]
  [Algebra (ZMod ℓ) A] [Algebra ℤ_[ℓ] A]

/-- If `ℤ_[ℓ]` acts on the `𝐅_ℓ`-algebra `A` through `𝐅_ℓ` and `s` spans `R` over `ℤ_[ℓ]`, then
every element of the image of a `ℤ_[ℓ]`-algebra map `ψ : R → A` is an `𝐅_ℓ`-linear combination of
the images of `s`. -/
private lemma exists_sum_eq_of_span_eq_top
    (halg : ∀ a : ℤ_[ℓ], algebraMap ℤ_[ℓ] A a = algebraMap (ZMod ℓ) A (PadicInt.toZMod a))
    {s : Finset R} (hs : Submodule.span ℤ_[ℓ] (s : Set R) = ⊤) (ψ : R →ₐ[ℤ_[ℓ]] A) (r : R) :
    ∃ c : s → ZMod ℓ, ∑ a : s, algebraMap (ZMod ℓ) A (c a) * ψ a = ψ r := by
  have hr : r ∈ Submodule.span ℤ_[ℓ] (s : Set R) := hs ▸ Submodule.mem_top
  obtain ⟨f, hf⟩ := Submodule.mem_span_finset'.1 hr
  refine ⟨fun a => PadicInt.toZMod (f a), ?_⟩
  rw [← hf, map_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [map_smul, Algebra.smul_def, halg]

/-- Let `ψ : R → A` be as in `exists_sum_eq_of_span_eq_top`, with `R` spanned by `s`, and let
`red : A → 𝐅_ℓ` be a retraction. If a unit `U` of order `N` coprime to `n` reduces to `1`, and
every `U^{n a} c_a` with `a ∈ ℤ/N` and `c_a ∈ 𝐅_ℓˣ` lies in the image of `ψ`, then
`N ≤ ℓ^{|s|}`. -/
private lemma le_pow_card_of_forall_exists
    (halg : ∀ a : ℤ_[ℓ], algebraMap ℤ_[ℓ] A a = algebraMap (ZMod ℓ) A (PadicInt.toZMod a))
    {s : Finset R} (hs : Submodule.span ℤ_[ℓ] (s : Set R) = ⊤) (ψ : R →ₐ[ℤ_[ℓ]] A)
    (red : A →+* ZMod ℓ) (hred : ∀ c, red (algebraMap (ZMod ℓ) A c) = c) {U : Aˣ}
    (hU : red U = 1) {N n : ℕ} [NeZero N] (horder : orderOf U = N) (hn : N.Coprime n)
    (hc : ∀ a : ZMod N, ∃ (r : R) (c : (ZMod ℓ)ˣ),
      ψ r = (U : A) ^ (n * a.val) * algebraMap (ZMod ℓ) A c) :
    N ≤ ℓ ^ s.card := by
  classical
  have hw : ∀ a : ZMod N, ∃ (w : s → ZMod ℓ) (c : (ZMod ℓ)ˣ),
      ∑ b : s, algebraMap (ZMod ℓ) A (w b) * ψ b =
        (U : A) ^ (n * a.val) * algebraMap (ZMod ℓ) A c := fun a => by
    obtain ⟨r, c, hr⟩ := hc a
    obtain ⟨w, hw⟩ := exists_sum_eq_of_span_eq_top halg hs ψ r
    exact ⟨w, c, hw.trans hr⟩
  choose w c hw using hw
  have hinj : Function.Injective w := by
    intro a b hab
    have h := (hw a).symm.trans
      ((congrArg (fun x => ∑ b : s, algebraMap (ZMod ℓ) A (x b) * ψ b) hab).trans (hw b))
    have hcab : (c a : ZMod ℓ) = c b := by simpa [hU, hred] using congrArg red h
    rw [hcab] at h
    have h2 : (U : A) ^ (n * a.val) = (U : A) ^ (n * b.val) :=
      ((c b).isUnit.map (algebraMap (ZMod ℓ) A)).mul_left_injective h
    have h3 : U ^ (n * a.val) = U ^ (n * b.val) := Units.ext (by simpa using h2)
    rw [pow_eq_pow_iff_modEq, horder] at h3
    exact ZMod.val_injective N (Nat.ModEq.eq_of_lt_of_lt
      (Nat.ModEq.cancel_left_of_coprime hn h3) (ZMod.val_lt a) (ZMod.val_lt b))
  have hcard := Fintype.card_le_of_injective w hinj
  rwa [ZMod.card, Fintype.card_fun, Fintype.card_coe, ZMod.card] at hcard

end Counting

/-! ### The universal deformation ring is not finite -/

namespace IsUniversalDeformation

open TruncatedPowerSeries

variable {ℓ n : ℕ} [Fact ℓ.Prime] {π : Type u} [Group π] [TopologicalSpace π]
  {ρ₀ : π →ₜ* Matrix.GeneralLinearGroup (Fin n) (ZMod ℓ)}
  {R : Type} [CommRing R] [IsLocalRing R] [TopologicalSpace R] [Algebra ℤ_[ℓ] R]
  {reduce : R →+* ZMod ℓ} {ρuniv : π →ₜ* Matrix.GeneralLinearGroup (Fin n) R}

/-- **Without fixing the determinant, the universal deformation ring is not finite over `ℤ_ℓ`**:
if `ℓ ∤ n` and `π` has, for every `j`, a surjection onto `ℤ/ℓ^j` with open fibres, the
universal deformation ring of `ρ₀ : π → GLₙ(𝐅_ℓ)` is not a finite `ℤ_ℓ`-module. Hence the
determinant condition in [Stacks, Tag 03W1] cannot be dropped. -/
theorem not_moduleFinite (hR : IsUniversalDeformation ℓ n π ρ₀ R reduce ρuniv) (hn : ¬ ℓ ∣ n)
    (hquot : ∀ j : ℕ, ∃ φ : π →* Multiplicative (ZMod (ℓ ^ j)), Function.Surjective φ ∧
      ∀ a, IsOpen (φ ⁻¹' {a})) :
    ¬ Module.Finite ℤ_[ℓ] R := by
  classical
  intro hfin
  -- a finite set of generators
  obtain ⟨s, hs⟩ := hfin.fg_top
  set N := ℓ ^ (s.card + 1)
  have hN : N ≠ 0 := NeZero.ne _
  have : NeZero N := ⟨hN⟩
  let A := TruncatedPowerSeries ℓ N
  let : IsLocalRing A := isLocalRing hN
  let tA : TopologicalSpace A := (maximalIdeal A).adicTopology
  have : DiscreteTopology A :=
    discreteTopology_adicTopology_of_pow_eq_bot _ (maximalIdeal_pow_eq_bot hN)
  let : Algebra ℤ_[ℓ] A := ((algebraMap (ZMod ℓ) A).comp PadicInt.toZMod).toAlgebra
  have halg : ∀ a : ℤ_[ℓ], algebraMap ℤ_[ℓ] A a = algebraMap (ZMod ℓ) A (PadicInt.toZMod a) :=
    fun _ => rfl
  -- the reduction map
  let red : A →+* ZMod ℓ := residue hN
  have hred_alg : ∀ c : ZMod ℓ, red (algebraMap (ZMod ℓ) A c) = c := residue_algebraMap hN
  -- the twisting character
  obtain ⟨φ, hφs, hφo⟩ := hquot (s.card + 1)
  let sc : Aˣ →* Matrix.GeneralLinearGroup (Fin n) A :=
    Units.map (Matrix.scalar (Fin n) : A →+* Matrix (Fin n) (Fin n) A).toMonoidHom
  let M := Matrix.GeneralLinearGroup.map (n := Fin n) (algebraMap (ZMod ℓ) A)
  let ρ : π →ₜ* Matrix.GeneralLinearGroup (Fin n) A :=
    ⟨scalarTwist ((character s.card).comp φ) (M.comp ρ₀.toMonoidHom),
      (((IsLocallyConstant.iff_isOpen_fiber.2 hφo).comp fun a =>
        sc (character s.card a)).continuous.mul
          (continuous_of_discreteTopology.comp ρ₀.continuous) :
          Continuous fun g => sc (character s.card (φ g)) * M (ρ₀ g))⟩
  have hρ : ∀ g, ρ g = sc (character s.card (φ g)) * M (ρ₀ g) := fun _ => rfl
  -- `ρ` is a deformation of `ρ₀`
  obtain ⟨ψ, ⟨-, hψ⟩, -⟩ := hR.universal A rfl
    (isAdicComplete_of_pow_eq_bot _ (maximalIdeal_pow_eq_bot hN)) red
    (fun c => ⟨algebraMap (ZMod ℓ) A c, hred_alg c⟩) continuous_of_discreteTopology
    (fun a => by rw [halg, hred_alg]) ρ
    (isConjugate_map_residue_scalarTwist s.card hN φ ρ₀.toMonoidHom)
  -- `ψ(R)` has at most `ℓ ^ #s` elements, but contains `N` distinct values
  refine absurd (le_pow_card_of_forall_exists halg hs ψ red hred_alg (residue_oneAddT _ hN)
    (orderOf_oneAddT s.card : orderOf _ = N)
    (Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd Fact.out).2 hn)) fun a => ?_)
    (not_le.2 (Nat.pow_lt_pow_succ (Fact.out : ℓ.Prime).one_lt))
  obtain ⟨g, hg⟩ := hφs (Multiplicative.ofAdd a)
  obtain rfl : a = Multiplicative.toAdd (φ g) := by rw [hg, toAdd_ofAdd]
  -- determinants
  refine ⟨Matrix.GeneralLinearGroup.det (ρuniv g), Matrix.GeneralLinearGroup.det (ρ₀ g), ?_⟩
  rw [show ψ ((Matrix.GeneralLinearGroup.det (ρuniv g) : Rˣ) : R) =
    ((Matrix.GeneralLinearGroup.det
      (Matrix.GeneralLinearGroup.map ψ.toRingHom (ρuniv g)) : Aˣ) : A) from
    ψ.toRingHom.map_det _, ← hψ.det_eq g, hρ]
  simp [Matrix.GeneralLinearGroup.det, sc, M, character_apply, Matrix.det_mul,
    Matrix.scalar_apply, Matrix.det_diagonal, RingHom.map_det, pow_mul]

end IsUniversalDeformation

end Deformation

