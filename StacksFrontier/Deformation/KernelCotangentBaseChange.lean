module

public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Base change of the kernel of a surjection of rings

Let `f : R' → R` and `g : S' → S` be surjections of commutative rings sitting in a commuting
square with a map `g' : R' → S'` and the induced map `σ : R → S`, and write `I = ker f`,
`J = ker g`. Pushing `I` forward along `g'` lands inside `J`, so `g'` induces a comparison map
`I/I² → J/J²` between the conormal modules of the two kernels. The conormal modules carry
`R`- resp. `S`-module structures, because `I/I²` is annihilated by `I` and therefore the
`R'`-action descends along `R' ⧸ I ≃ R`; the comparison map is semilinear over `σ` for those
structures, and its base change is an `S`-linear map `S ⊗[R] I/I² → J/J²`.

This is the kernel comparison needed for base change of the canonical obstruction map of a
square-zero extension (Stacks 0DYR(3), used by Stacks 0DZ2).

## Main definitions

* `Deformation.Obstruction.kernelCotangentModule`: the `R`-module structure on `(ker f).Cotangent`
  transported from `R' ⧸ ker f` along `RingHom.quotientKerEquivOfSurjective`.
* `Deformation.Obstruction.kernelCotangentMap`: the `σ`-semilinear comparison map
  `(ker f).Cotangent → (ker g).Cotangent`.
* `Deformation.Obstruction.kernelCotangentBaseChange`: its base change, an `S`-linear map
  `S ⊗[R] (ker f).Cotangent → (ker g).Cotangent`.
* `Deformation.Obstruction.kernelCotangentBaseChangeEquiv`: that map as a linear equivalence,
  when `S'` is flat over `R'` and `ker g` is generated by the image of `ker f`.

## Main results

* `Deformation.Obstruction.map_ker_le_ker`: `g'` carries `ker f` into `ker g`.
* `Deformation.Obstruction.kernelCotangentModule_smul`: an element of `R` acts on
  `(ker f).Cotangent` through any of its `f`-preimages.
* `Deformation.Obstruction.kernelCotangentMap_comp`: the comparison map composes along two stacked
  squares.
* `Deformation.Obstruction.ker_sq_eq_bot_of_ker_eq_map`: if `(ker f)² = 0` and `ker g` is generated
  by the image of `ker f`, then `(ker g)² = 0`.
* `Deformation.Obstruction.kernelCotangentBaseChange_surjective`: if `ker g` is generated by the
  image of `ker f`, the base-changed comparison map is surjective.
* `Deformation.Obstruction.kernelCotangentBaseChange_injective`: if moreover `S'` is flat over
  `R'`, it is injective.

## Implementation notes

`Ideal.Cotangent` already carries a `Module (R' ⧸ I)` instance and an
`IsScalarTower R' (R' ⧸ I)` instance, so the transported structure is literally
`Module.compHom _ (RingHom.quotientKerEquivOfSurjective hf).symm.toRingHom`; it is written
that way so that it is definitionally the structure used elsewhere in the obstruction files.

No square-zero hypothesis is needed for the comparison map: quotienting by `I²` is already
built into `Ideal.Cotangent`. Square-zeroness enters only through
`ker_sq_eq_bot_of_ker_eq_map`, which propagates it across the square.

The flatness that makes the base-changed comparison map injective is flatness of `S'` over
`R'`, not of `S` over `R`: injectivity is the statement that `Tor₁^{R'}(R, S')` already lies
in the image of `I² ⊗_{R'} S'`, and flatness of `S` over `R` says nothing about that. For
instance with `R' = k[x] ⧸ (x²) → R = k` and `S' = S = k`, the square commutes, `ker g` is the
image of `ker f`, and `S = R` is flat over `R`, yet `S ⊗[R] I/I² ≅ k` maps to `0`.
-/

@[expose] public section

open scoped TensorProduct

universe u₁ u₂ u₃ u₄ u₅ u₆

namespace Deformation.Obstruction

variable {R' : Type u₁} {R : Type u₂} {S' : Type u₃} {S : Type u₄}
  [CommRing R'] [CommRing R] [CommRing S'] [CommRing S]

/-- In a commuting square `σ ∘ f = g ∘ g'`, the map `g'` carries the kernel of `f` into the
kernel of `g`. -/
theorem map_ker_le_ker (f : R' →+* R) (g : S' →+* S) (g' : R' →+* S') (σ : R →+* S)
    (hcomm : σ.comp f = g.comp g') :
    Ideal.map g' (RingHom.ker f) ≤ RingHom.ker g := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  have h : σ (f a) = g (g' a) := RingHom.congr_fun hcomm a
  simp only [Ideal.mem_comap, RingHom.mem_ker, ← h, RingHom.mem_ker.mp ha, map_zero]

/-- The `R`-module structure on the conormal module `I/I²` of the kernel `I` of a surjection
`f : R' → R`: the ideal `I` annihilates `I/I²`, so the `R'`-action descends along the
isomorphism `R' ⧸ I ≃ R`. -/
@[instance_reducible]
noncomputable def kernelCotangentModule (f : R' →+* R) (hf : Function.Surjective f) :
    Module R (RingHom.ker f).Cotangent :=
  Module.compHom _ (RingHom.quotientKerEquivOfSurjective hf).symm.toRingHom

/-- An element of `R` acts on `I/I²` through any of its preimages under `f`. -/
theorem kernelCotangentModule_smul (f : R' →+* R) (hf : Function.Surjective f) (s : R')
    (x : (RingHom.ker f).Cotangent) :
    letI := kernelCotangentModule f hf
    f s • x = s • x := by
  let := kernelCotangentModule f hf
  show (RingHom.quotientKerEquivOfSurjective hf).symm (f s) • x = s • x
  rw [RingHom.quotientKerEquivOfSurjective_symm_apply hf s, ← Ideal.Quotient.algebraMap_eq]
  exact IsScalarTower.algebraMap_smul (R' ⧸ RingHom.ker f) s x

/-- The comparison map `I/I² → J/J²` on conormal modules of the kernels `I = ker f` and
`J = ker g`, induced by `g'` in a commuting square `σ ∘ f = g ∘ g'`. It is semilinear over the
induced map `σ : R → S`. -/
noncomputable def kernelCotangentMap (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S') (σ : R →+* S)
    (hcomm : σ.comp f = g.comp g') :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    (RingHom.ker f).Cotangent →ₛₗ[σ] (RingHom.ker g).Cotangent := by
  letI := kernelCotangentModule f hf
  letI := kernelCotangentModule g hg
  letI : Module R' (RingHom.ker g).Cotangent := Module.compHom _ g'
  let φ : (RingHom.ker f) →ₗ[R'] (RingHom.ker g).Cotangent :=
    { toFun := fun a => (RingHom.ker g).toCotangent
        ⟨g' (a : R'), map_ker_le_ker f g g' σ hcomm (Ideal.mem_map_of_mem _ a.2)⟩
      map_add' := fun a b => by
        refine Eq.trans (congrArg _ (Subtype.ext ?_)) ((RingHom.ker g).toCotangent.map_add _ _)
        exact map_add g' (a : R') (b : R')
      map_smul' := fun s a => by
        refine Eq.trans (congrArg _ (Subtype.ext ?_))
          ((RingHom.ker g).toCotangent.map_smul (g' s) _)
        exact map_mul g' s (a : R') }
  let ψ : (RingHom.ker f).Cotangent →ₗ[R'] (RingHom.ker g).Cotangent :=
    Ideal.Cotangent.lift φ fun a b => by
      refine (Ideal.toCotangent_eq_zero _ _).mpr ?_
      rw [pow_two]
      change g' ((a * b : RingHom.ker f) : R') ∈ _
      rw [show ((a * b : RingHom.ker f) : R') = (a : R') * (b : R') from rfl, map_mul]
      exact Ideal.mul_mem_mul
        (map_ker_le_ker f g g' σ hcomm (Ideal.mem_map_of_mem _ a.2))
        (map_ker_le_ker f g g' σ hcomm (Ideal.mem_map_of_mem _ b.2))
  refine { toFun := ψ, map_add' := ψ.map_add, map_smul' := fun r x => ?_ }
  obtain ⟨s, rfl⟩ := hf r
  rw [kernelCotangentModule_smul f hf s x, ψ.map_smul s x]
  have hσ : σ (f s) = g (g' s) := by
    have h := RingHom.congr_fun hcomm s
    simpa only [RingHom.coe_comp, Function.comp_apply] using h
  rw [hσ, kernelCotangentModule_smul g hg (g' s) (ψ x)]
  rfl

/-- The comparison map sends the class of `a ∈ I` in `I/I²` to the class of `g' a ∈ J` in
`J/J²`. -/
@[simp]
theorem kernelCotangentMap_toCotangent (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S') (σ : R →+* S)
    (hcomm : σ.comp f = g.comp g') (a : RingHom.ker f) :
    kernelCotangentMap f hf g hg g' σ hcomm ((RingHom.ker f).toCotangent a) =
      (RingHom.ker g).toCotangent
        ⟨g' (a : R'), map_ker_le_ker f g g' σ hcomm (Ideal.mem_map_of_mem _ a.2)⟩ :=
  rfl

/-- The comparison map is additive. -/
theorem kernelCotangentMap_add (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S') (σ : R →+* S)
    (hcomm : σ.comp f = g.comp g') (x y : (RingHom.ker f).Cotangent) :
    kernelCotangentMap f hf g hg g' σ hcomm (x + y) =
      kernelCotangentMap f hf g hg g' σ hcomm x + kernelCotangentMap f hf g hg g' σ hcomm y :=
  map_add _ x y

/-- The comparison map carries the `R'`-action on `I/I²` to the `g'`-twisted `S'`-action on
`J/J²`. This is its semilinearity read upstairs, before the two actions are pushed down to
`R` and `S`. -/
theorem kernelCotangentMap_smul (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S') (σ : R →+* S)
    (hcomm : σ.comp f = g.comp g') (s : R') (x : (RingHom.ker f).Cotangent) :
    kernelCotangentMap f hf g hg g' σ hcomm (s • x) =
      g' s • kernelCotangentMap f hf g hg g' σ hcomm x := by
  obtain ⟨a, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker f) x
  rw [← (RingHom.ker f).toCotangent.map_smul s a, kernelCotangentMap_toCotangent,
    kernelCotangentMap_toCotangent, ← (RingHom.ker g).toCotangent.map_smul (g' s)]
  exact congrArg _ (Subtype.ext (map_mul g' s a))

section Comp

variable {T' : Type u₅} {T : Type u₆} [CommRing T'] [CommRing T]

/-- The comparison maps of two stacked commuting squares compose to the comparison map of the
outer square. -/
theorem kernelCotangentMap_comp (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (h : T' →+* T) (hh : Function.Surjective h)
    (g' : R' →+* S') (h' : S' →+* T') (σ : R →+* S) (τ : S →+* T)
    (hcomm₁ : σ.comp f = g.comp g') (hcomm₂ : τ.comp g = h.comp h')
    (hcomm : (τ.comp σ).comp f = h.comp (h'.comp g'))
    (x : (RingHom.ker f).Cotangent) :
    kernelCotangentMap f hf h hh (h'.comp g') (τ.comp σ) hcomm x =
      kernelCotangentMap g hg h hh h' τ hcomm₂
        (kernelCotangentMap f hf g hg g' σ hcomm₁ x) := by
  obtain ⟨a, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker f) x
  rw [kernelCotangentMap_toCotangent, kernelCotangentMap_toCotangent,
    kernelCotangentMap_toCotangent]
  rfl

end Comp

/-- If the kernel of `f` is square-zero and the kernel of `g` is generated by its image under
`g'` — which is the case when `S = S' ⊗[R'] R` — then the kernel of `g` is square-zero too. -/
theorem ker_sq_eq_bot_of_ker_eq_map (f : R' →+* R) (g : S' →+* S) (g' : R' →+* S')
    (hI : RingHom.ker f ^ 2 = ⊥) (hJ : RingHom.ker g = Ideal.map g' (RingHom.ker f)) :
    RingHom.ker g ^ 2 = ⊥ := by
  rw [hJ, ← Ideal.map_pow, hI, Ideal.map_bot]

section BaseChange

variable [Algebra R S]

/-- The `R`-module structure on `J/J²` obtained by restricting its `S`-module structure along
`R → S`. -/
@[instance_reducible]
noncomputable def kernelCotangentRestrictModule (g : S' →+* S) (hg : Function.Surjective g) :
    Module R (RingHom.ker g).Cotangent :=
  letI := kernelCotangentModule g hg
  Module.compHom _ (algebraMap R S)

/-- The `R`-linear comparison map `I/I² → J/J²`, the semilinear
`Deformation.Obstruction.kernelCotangentMap` read as an `R`-linear map into the restriction of
scalars of `J/J²`. -/
noncomputable def kernelCotangentMapRestrict (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g') :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentRestrictModule (R := R) g hg
    (RingHom.ker f).Cotangent →ₗ[R] (RingHom.ker g).Cotangent :=
  letI := kernelCotangentModule f hf
  letI := kernelCotangentModule g hg
  letI := kernelCotangentRestrictModule (R := R) g hg
  { toFun := kernelCotangentMap f hf g hg g' (algebraMap R S) hcomm
    map_add' := (kernelCotangentMap f hf g hg g' (algebraMap R S) hcomm).map_add
    map_smul' := fun r x =>
      (kernelCotangentMap f hf g hg g' (algebraMap R S) hcomm).map_smulₛₗ r x }

/-- The base change of the kernel comparison map: the `S`-linear map
`S ⊗[R] I/I² → J/J²` sending `s ⊗ x` to `s • (I/I² → J/J²) x`. -/
noncomputable def kernelCotangentBaseChange (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g') :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    S ⊗[R] (RingHom.ker f).Cotangent →ₗ[S] (RingHom.ker g).Cotangent :=
  letI := kernelCotangentModule f hf
  letI := kernelCotangentModule g hg
  letI := kernelCotangentRestrictModule (R := R) g hg
  haveI : IsScalarTower R S (RingHom.ker g).Cotangent :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  LinearMap.liftBaseChange S (kernelCotangentMapRestrict f hf g hg g' hcomm)

/-- The base-changed comparison map sends `s ⊗ x` to `s` times the image of `x` under the
comparison map `I/I² → J/J²`. -/
@[simp]
theorem kernelCotangentBaseChange_tmul (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g') (s : S) (x : (RingHom.ker f).Cotangent) :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    kernelCotangentBaseChange f hf g hg g' hcomm (s ⊗ₜ[R] x) =
      s • kernelCotangentMap f hf g hg g' (algebraMap R S) hcomm x :=
  rfl

/-- The base-changed comparison map sends `1 ⊗ x` to the image of `x` under the comparison map
`I/I² → J/J²`. -/
theorem kernelCotangentBaseChange_one_tmul (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g') (x : (RingHom.ker f).Cotangent) :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    kernelCotangentBaseChange f hf g hg g' hcomm (1 ⊗ₜ[R] x) =
      kernelCotangentMap f hf g hg g' (algebraMap R S) hcomm x := by
  let := kernelCotangentModule f hf
  let := kernelCotangentModule g hg
  rw [kernelCotangentBaseChange_tmul]
  exact one_smul S _

/-- When the kernel of `g` is generated by the image under `g'` of the kernel of `f` — the
ideal-theoretic form of `S = S' ⊗[R'] R` — the base-changed comparison map
`S ⊗[R] I/I² → J/J²` is surjective. -/
theorem kernelCotangentBaseChange_surjective (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g')
    (hJ : RingHom.ker g = Ideal.map g' (RingHom.ker f)) :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    Function.Surjective (kernelCotangentBaseChange f hf g hg g' hcomm) := by
  let := kernelCotangentModule f hf
  let := kernelCotangentModule g hg
  let := kernelCotangentRestrictModule (R := R) g hg
  have : IsScalarTower R S (RingHom.ker g).Cotangent :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hdef : kernelCotangentBaseChange f hf g hg g' hcomm =
      LinearMap.liftBaseChange S (kernelCotangentMapRestrict f hf g hg g' hcomm) := rfl
  rw [← LinearMap.range_eq_top, hdef, LinearMap.range_liftBaseChange, eq_top_iff]
  have key : ∀ x ∈ Ideal.map g' (RingHom.ker f), ∀ hx : x ∈ RingHom.ker g,
      (RingHom.ker g).toCotangent ⟨x, hx⟩ ∈
        Submodule.span S
          (LinearMap.range (kernelCotangentMapRestrict f hf g hg g' hcomm) :
            Set (RingHom.ker g).Cotangent) := by
    intro x hx
    have hx' : x ∈ Submodule.span S' ((g' : R' → S') '' (RingHom.ker f : Set R')) := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨a, ha, rfl⟩ := hz
        exact fun _ => Submodule.subset_span ⟨(RingHom.ker f).toCotangent ⟨a, ha⟩, rfl⟩
    | zero =>
        intro h0
        rw [show (⟨0, h0⟩ : RingHom.ker g) = 0 from rfl, map_zero]
        exact Submodule.zero_mem _
    | add u v hu hv ihu ihv =>
        intro _
        have hu' : u ∈ RingHom.ker g := hJ.ge hu
        have hv' : v ∈ RingHom.ker g := hJ.ge hv
        rw [show (⟨u + v, _⟩ : RingHom.ker g) = ⟨u, hu'⟩ + ⟨v, hv'⟩ from rfl, map_add]
        exact Submodule.add_mem _ (ihu hu') (ihv hv')
    | smul a u hu ihu =>
        intro _
        have hu' : u ∈ RingHom.ker g := hJ.ge hu
        rw [show (⟨a • u, _⟩ : RingHom.ker g) = a • (⟨u, hu'⟩ : RingHom.ker g) from rfl,
          map_smul, ← kernelCotangentModule_smul g hg a]
        exact Submodule.smul_mem _ (g a) (ihu hu')
  rintro y -
  obtain ⟨b, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker g) y
  exact key (b : S') (hJ.le b.2) b.2

end BaseChange

section Flat

variable [Algebra R S]

/-- Under flatness of `S'` over `R'` the base-changed comparison map `S ⊗[R] I/I² → J/J²` is
injective: the multiplication map `S' ⊗[R'] I → S'` is then injective with image `J`, which
identifies the relations defining `J/J²` with those defining `S ⊗[R] I/I²`. -/
theorem kernelCotangentBaseChange_injective (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g')
    (hJ : RingHom.ker g = Ideal.map g' (RingHom.ker f))
    (hflat : letI := g'.toAlgebra; Module.Flat R' S') :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    Function.Injective (kernelCotangentBaseChange f hf g hg g' hcomm) := by
  let := kernelCotangentModule f hf
  let := kernelCotangentModule g hg
  let _ : Algebra R' S' := g'.toAlgebra
  have : Module.Flat R' S' := hflat
  let _ : Module S' (S ⊗[R] (RingHom.ker f).Cotangent) := Module.compHom _ g
  let _ : Module R' (S ⊗[R] (RingHom.ker f).Cotangent) := Module.compHom _ (g.comp g')
  have : IsScalarTower R' S' (S ⊗[R] (RingHom.ker f).Cotangent) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hσ : ∀ r : R', algebraMap R S (f r) = g (g' r) := RingHom.congr_fun hcomm
  -- `ψ` lifts `g'` to a map of kernels, `q` is its base change to `S'`.
  let ψ : (RingHom.ker f) →ₗ[R'] (RingHom.ker g) :=
    { toFun := fun a => ⟨g' (a : R'),
        map_ker_le_ker f g g' (algebraMap R S) hcomm (Ideal.mem_map_of_mem _ a.2)⟩
      map_add' := fun a b => Subtype.ext (map_add g' (a : R') (b : R'))
      map_smul' := fun r a => Subtype.ext (map_mul g' r (a : R')) }
  let q : S' ⊗[R'] (RingHom.ker f) →ₗ[S'] (RingHom.ker g) := LinearMap.liftBaseChange S' ψ
  -- `p` is the other quotient of `S' ⊗[R'] I`, onto the base-changed conormal module.
  let χ : (RingHom.ker f) →ₗ[R'] S ⊗[R] (RingHom.ker f).Cotangent :=
    { toFun := fun a => 1 ⊗ₜ[R] (RingHom.ker f).toCotangent a
      map_add' := fun a b => by rw [map_add, TensorProduct.tmul_add]
      map_smul' := fun r a => by
        show (1 : S) ⊗ₜ[R] (RingHom.ker f).toCotangent (r • a)
          = g (g' r) • ((1 : S) ⊗ₜ[R] (RingHom.ker f).toCotangent a)
        rw [map_smul, ← kernelCotangentModule_smul f hf r, ← hσ r,
          ← TensorProduct.smul_tmul, TensorProduct.smul_tmul',
          Algebra.algebraMap_eq_smul_one, smul_eq_mul, mul_one] }
  let p : S' ⊗[R'] (RingHom.ker f) →ₗ[S'] S ⊗[R] (RingHom.ker f).Cotangent :=
    LinearMap.liftBaseChange S' χ
  -- `q` is injective, because `S'` is `R'`-flat.
  have hqval : ∀ w : S' ⊗[R'] (RingHom.ker f),
      ((q w : S') : S') =
        TensorProduct.rid R' S' (LinearMap.lTensor S' (Submodule.subtype _) w) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp [q]
    | tmul s a => simp [q, ψ, Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm]
    | add u v hu hv => simp only [map_add, Submodule.coe_add, hu, hv]
  have hqinj : Function.Injective q := by
    intro u v huv
    have h0 : Function.Injective
        (LinearMap.lTensor S' (Submodule.subtype (RingHom.ker f))) :=
      Module.Flat.lTensor_preserves_injective_linearMap _ (Submodule.injective_subtype _)
    refine h0 ((TensorProduct.rid R' S').injective ?_)
    rw [← hqval, ← hqval, huv]
  -- `p` is surjective.
  have hpsurj : Function.Surjective p := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul s m =>
        obtain ⟨s', rfl⟩ := hg s
        obtain ⟨a, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker f) m
        refine ⟨s' ⊗ₜ[R'] a, ?_⟩
        show g s' • ((1 : S) ⊗ₜ[R] (RingHom.ker f).toCotangent a) = _
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add u v hu hv =>
        obtain ⟨yu, rfl⟩ := hu
        obtain ⟨yv, rfl⟩ := hv
        exact ⟨yu + yv, map_add _ _ _⟩
  -- the two quotient maps are intertwined by the base-changed comparison map.
  have hcompat : ∀ w : S' ⊗[R'] (RingHom.ker f),
      kernelCotangentBaseChange f hf g hg g' hcomm (p w) =
        (RingHom.ker g).toCotangent (q w) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp [p, q]
    | tmul s a =>
        show kernelCotangentBaseChange f hf g hg g' hcomm
            (g s • ((1 : S) ⊗ₜ[R] (RingHom.ker f).toCotangent a)) = _
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, kernelCotangentBaseChange_tmul,
          kernelCotangentMap_toCotangent]
        show _ = (RingHom.ker g).toCotangent (s • ψ a)
        rw [map_smul, ← kernelCotangentModule_smul g hg s]
        rfl
    | add u v hu hv => simp only [map_add, hu, hv]
  -- the key step: an element of `S' ⊗[R'] I` landing in `J²` already dies in `S ⊗[R] I/I²`.
  have key : ∀ x ∈ Ideal.map g' (RingHom.ker f ^ 2),
      ∃ w : S' ⊗[R'] (RingHom.ker f), ((q w : S') : S') = x ∧ p w = 0 := by
    intro x hx
    have hx' : x ∈ Submodule.span S' ((g' : R' → S') '' ((RingHom.ker f ^ 2 : Ideal R') : Set R'))
        := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem z hz =>
        obtain ⟨a, ha, rfl⟩ := hz
        have haI : a ∈ RingHom.ker f := (Ideal.pow_le_self two_ne_zero) ha
        refine ⟨1 ⊗ₜ[R'] ⟨a, haI⟩, by simp [q, ψ], ?_⟩
        show (1 : S') • ((1 : S) ⊗ₜ[R] (RingHom.ker f).toCotangent ⟨a, haI⟩) = 0
        rw [(Ideal.toCotangent_eq_zero _ _).mpr ha, TensorProduct.tmul_zero, smul_zero]
    | zero => exact ⟨0, by simp [q], map_zero _⟩
    | add u v _ _ ihu ihv =>
        obtain ⟨wu, h1u, h2u⟩ := ihu
        obtain ⟨wv, h1v, h2v⟩ := ihv
        exact ⟨wu + wv, by simp [h1u, h1v], by simp [h2u, h2v]⟩
    | smul a u _ ihu =>
        obtain ⟨wu, h1u, h2u⟩ := ihu
        refine ⟨a • wu, ?_, by rw [map_smul, h2u, smul_zero]⟩
        rw [map_smul, Submodule.coe_smul, h1u, smul_eq_mul]
  -- assembling
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨w, rfl⟩ := hpsurj x
  have h1 : (RingHom.ker g).toCotangent (q w) = 0 := (hcompat w).symm.trans hx
  have hJ2 : RingHom.ker g ^ 2 = Ideal.map g' (RingHom.ker f ^ 2) := by
    rw [hJ, Ideal.map_pow]
  have h2 : ((q w : S') : S') ∈ Ideal.map g' (RingHom.ker f ^ 2) := by
    rw [← hJ2]; exact (Ideal.toCotangent_eq_zero _ _).mp h1
  obtain ⟨w₀, h1₀, h2₀⟩ := key _ h2
  have : w = w₀ := hqinj (Subtype.ext h1₀.symm)
  rw [this, h2₀]

/-- Under flatness of `S'` over `R'` and with `J` generated by the image of `I`, the comparison
map identifies `S ⊗[R] I/I²` with `J/J²`. -/
noncomputable def kernelCotangentBaseChangeEquiv (f : R' →+* R) (hf : Function.Surjective f)
    (g : S' →+* S) (hg : Function.Surjective g) (g' : R' →+* S')
    (hcomm : (algebraMap R S).comp f = g.comp g')
    (hJ : RingHom.ker g = Ideal.map g' (RingHom.ker f))
    (hflat : letI := g'.toAlgebra; Module.Flat R' S') :
    letI := kernelCotangentModule f hf
    letI := kernelCotangentModule g hg
    S ⊗[R] (RingHom.ker f).Cotangent ≃ₗ[S] (RingHom.ker g).Cotangent :=
  letI := kernelCotangentModule f hf
  letI := kernelCotangentModule g hg
  LinearEquiv.ofBijective (kernelCotangentBaseChange f hf g hg g' hcomm)
    ⟨kernelCotangentBaseChange_injective f hf g hg g' hcomm hJ hflat,
      kernelCotangentBaseChange_surjective f hf g hg g' hcomm hJ⟩

end Flat

end Deformation.Obstruction
